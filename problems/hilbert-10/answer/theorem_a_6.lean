        Finset.single_le_sum (f := fun k => |u.2 k - v.2 k|) (fun k _ => abs_nonneg _)
          (Finset.mem_univ k₀)
      have h3 : 0 ≤ ∑ i, |u.1 i - v.1 i| := Finset.sum_nonneg fun i _ => abs_nonneg _
      nlinarith [mul_nonneg (sub_nonneg.2 hQ) hS]
    · push_neg at hfar
      rw [hF'J u, hF'J v, ← mul_sub, norm_mul, hκn]
      have hL := hlipcore u v hu1 hv1 hfar
      exact (mul_le_mul hκ1 hL (norm_nonneg _) zero_le_one).trans (le_of_eq (one_mul _))
  · 
    intro z
    subst hF'
    rfl

theorem nil2_decomp_param_bounds (D Q δ : ℝ) (hD : 1 ≤ D) (hQ : 2 ≤ Q) (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (b : ℕ) (hb : (b : ℝ) ≤ D) : 1 ≤ ⌈(Q * D / δ) ^ 2⌉₊ ∧ ((⌈(Q * D / δ) ^ 2⌉₊ ^ b * ⌈(Q * D / δ) ^ 2⌉₊ ^ b : ℕ) : ℝ) ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ 8) ∧ (⌈(Q * D / δ) ^ 2⌉₊ : ℝ) ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ 8) ∧ Q ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ 8) ∧ 1 ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ 8) ∧ Q * b / Real.sqrt (⌈(Q * D / δ) ^ 2⌉₊ : ℝ) ≤ δ :=
by
  set X := D + Real.log Q + Real.log (1 / δ) with hX
  set a := Q * D / δ with ha_def
  set M := ⌈a ^ 2⌉₊ with hM_def
  have hQpos : 0 < Q := by linarith
  have hlog2 : (0.6931471803 : ℝ) < Real.log 2 := Real.log_two_gt_d9
  have hlogQ : Real.log 2 ≤ Real.log Q := Real.log_le_log (by norm_num) hQ
  have hinvδ : 1 ≤ 1 / δ := by rw [le_div_iff₀ hδ0]; linarith
  have hlogδ : 0 ≤ Real.log (1 / δ) := Real.log_nonneg hinvδ
  have hX16 : (8 : ℝ) / 5 ≤ X := by norm_num at hlog2; linarith
  have hDX : D ≤ X := by linarith
  have hlogQX : Real.log Q ≤ X := by linarith
  have hX0 : 0 < X := by linarith
  have hexpX : Real.exp X = Real.exp D * Q * (1 / δ) := by
    rw [hX, Real.exp_add, Real.exp_add, Real.exp_log hQpos, Real.exp_log (by positivity)]
  have hDexp : D ≤ Real.exp D := by have := Real.add_one_le_exp D; linarith
  have ha_le : a ≤ Real.exp X := by
    rw [hexpX, ha_def, div_eq_mul_one_div]
    have h1 : Q * D ≤ Real.exp D * Q := by nlinarith
    exact mul_le_mul_of_nonneg_right h1 (by positivity)
  have ha2 : 2 ≤ a := by
    rw [ha_def, le_div_iff₀ hδ0]; nlinarith
  have ha0 : 0 ≤ a := by linarith
  have hapos : 0 < a ^ 2 := by positivity
  have hM1 : 1 ≤ M := Nat.ceil_pos.mpr hapos
  have hMle : (M : ℝ) < a ^ 2 + 1 := Nat.ceil_lt_add_one hapos.le
  have hMge : a ^ 2 ≤ (M : ℝ) := Nat.le_ceil _
  have hexp2 : 2 ≤ Real.exp X := by have := Real.add_one_le_exp X; linarith
  have hM3 : (M : ℝ) ≤ Real.exp X ^ 3 := by
    have h1 : a ^ 2 ≤ Real.exp X ^ 2 := pow_le_pow_left₀ ha0 ha_le 2
    have h2 : (1 : ℝ) ≤ a ^ 2 := by nlinarith
    have h3 : 2 * Real.exp X ^ 2 ≤ Real.exp X ^ 3 := by
      have h := mul_le_mul_of_nonneg_right hexp2 (sq_nonneg (Real.exp X))
      calc 2 * Real.exp X ^ 2 ≤ Real.exp X * Real.exp X ^ 2 := h
        _ = Real.exp X ^ 3 := by ring
    linarith
  have hX6 : 6 ≤ X ^ 6 := by
    have h := pow_le_pow_left₀ (by norm_num) hX16 6
    norm_num at h
    linarith
  have hX8 : 6 * X ^ 2 ≤ X ^ 8 := by
    have h := mul_le_mul_of_nonneg_right hX6 (sq_nonneg X)
    calc 6 * X ^ 2 ≤ X ^ 6 * X ^ 2 := h
      _ = X ^ 8 := by ring
  have hXX : X ≤ X ^ 2 := by nlinarith
  have h3X : 3 * X ≤ X ^ 8 := by nlinarith
  have hXX8 : X ≤ X ^ 8 := by nlinarith
  have hM3' : (M : ℝ) ≤ Real.exp (((3 : ℕ) : ℝ) * X) := by
    rw [Real.exp_nat_mul]; exact hM3
  refine ⟨hM1, ?_, ?_, ?_, ?_, ?_⟩
  · have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg _
    calc ((M ^ b * M ^ b : ℕ) : ℝ) = (M : ℝ) ^ b * (M : ℝ) ^ b := by push_cast; ring
      _ ≤ (Real.exp X ^ 3) ^ b * (Real.exp X ^ 3) ^ b := by
          have h := pow_le_pow_left₀ hM0 hM3 b
          exact mul_le_mul h h (by positivity) (by positivity)
      _ = Real.exp (((3 * b + 3 * b : ℕ) : ℝ) * X) := by
          rw [Real.exp_nat_mul, ← pow_mul, ← pow_add]
      _ ≤ Real.exp (X ^ 8) := by
          apply Real.exp_le_exp.mpr
          have hbX : (b : ℝ) * X ≤ X * X :=
            mul_le_mul_of_nonneg_right (hb.trans hDX) hX0.le
          push_cast
          nlinarith
  · calc (M : ℝ) ≤ Real.exp (((3 : ℕ) : ℝ) * X) := hM3'
      _ ≤ Real.exp (X ^ 8) := by
          apply Real.exp_le_exp.mpr
          push_cast
          linarith
  · calc Q = Real.exp (Real.log Q) := (Real.exp_log hQpos).symm
      _ ≤ Real.exp (X ^ 8) := Real.exp_le_exp.mpr (by linarith)
  · exact Real.one_le_exp (by positivity)
  · have hsq : a ≤ Real.sqrt (M : ℝ) := by
      have h := Real.sqrt_le_sqrt hMge
      rwa [Real.sqrt_sq ha0] at h
    have hsqpos : 0 < Real.sqrt (M : ℝ) := by linarith
    rw [div_le_iff₀ hsqpos]
    have hδa : δ * a = Q * D := by rw [ha_def]; field_simp
    have h1 := mul_le_mul_of_nonneg_left hsq hδ0.le
    have h2 := mul_le_mul_of_nonneg_left hb hQpos.le
    linarith

theorem kai_nil2_vertical_decomposition (ν : ℕ) :
    ∃ A : ℕ, 1 ≤ A ∧
      ∀ (D Q δ : ℝ), 1 ≤ D → 2 ≤ Q → 0 < δ → δ ≤ 1 →
      ∀ φ : (Fin ν → ℤ) → ℝ, IsNil2Seq ν D Q φ →
        ∃ (k₁ k₂ : ℕ) (φT : Fin k₁ → (Fin ν → ℤ) → ℝ) (cT : Fin k₁ → ℝ)
          (φV : Fin k₂ → (Fin ν → ℤ) → ℂ),
          ((k₁ + k₂ : ℕ) : ℝ) ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ A) ∧
          (∀ j, |cT j| ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ A)) ∧
          (∀ j, IsTorusQuadSeq ν D
            (Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ A)) (φT j)) ∧
          (∀ j, IsNil2VertSeq ν D
            (Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ A)) (φV j)) ∧
          ∀ z, |φ z - ∑ j, cT j * φT j z - (∑ j, φV j z).re| ≤ δ :=
by
  classical
  refine ⟨8, by norm_num, ?_⟩
  intro D Q δ hD hQ hδ0 hδ1 φ hφ
