  have hstrip : ∃ A : ℝ, 1 ≤ A ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam →
        ∀ (E : ℕ) (G : ℂ → ℂ), E ≤ 1 → (E = 1 ↔ KaiHeckePrincipal K q lam) →
          Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) →
          ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
            ‖G s‖ ≤ A * ((Ideal.absNorm q : ℝ) * 2 * (2 + |s.im|)) ^ A := by
    obtain ⟨A₀, hA₀, H⟩ := hcont
    refine ⟨max A₀ 1, le_max_right _ _, ?_⟩
    intro q hq ξ η lam hext E G hE hEiff hG hGeq s hs1 hs2
    obtain ⟨E', G', hE', hE'iff, hG', -, hG'eq, hG'bd⟩ := H q hq 0 0 ξ η lam hext (by simp)
    have hEE : E = E' := by
      by_cases hp : KaiHeckePrincipal K q lam
      · rw [hEiff.2 hp, hE'iff.2 hp]
      · have h1 : E ≠ 1 := fun h => hp (hEiff.1 h)
        have h2 : E' ≠ 1 := fun h => hp (hE'iff.1 h)
