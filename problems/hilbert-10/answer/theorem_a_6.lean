              (kaiHZDualTwist K ρ) : ℝ) : ℂ)))
    rw [hchar]
    ring

theorem kai_mf_small_coset_elt (K : Type u) [Field K] [NumberField K] :
    ∃ C : ℝ, 1 ≤ C ∧
      ∀ N : ℕ, 0 < N → ∀ ρ : NumberField.RingOfIntegers K,
        ∃ μ : NumberField.RingOfIntegers K, μ ≠ 0 ∧
          μ - ρ ∈ Ideal.span {(N : NumberField.RingOfIntegers K)} ∧
          (Ideal.absNorm (Ideal.span {μ}) : ℝ) ≤ C * (N : ℝ) ^ (Module.finrank ℚ K) :=
by
  classical
  set b := NumberField.RingOfIntegers.basis K with hbdef
  have hcast : ∀ (w : NumberField.InfinitePlace K) (m : ℤ), w ((m : K)) = |(m : ℝ)| := by
    intro w m
    rw [← w.mk_embedding, NumberField.InfinitePlace.apply, map_intCast, Complex.norm_intCast]
  obtain ⟨A, hA⟩ : ∃ A : NumberField.InfinitePlace K → ℝ,
      ∀ w, A w = ∑ i, w (((b i : NumberField.RingOfIntegers K) : K)) := ⟨_, fun _ => rfl⟩
  have hA0 : ∀ w, 0 ≤ A w := by
    intro w
    rw [hA]
    exact Finset.sum_nonneg (fun i _ => apply_nonneg _ _)
  obtain ⟨P, hPdef⟩ : ∃ P : ℝ,
      P = ∏ w : NumberField.InfinitePlace K, A w ^ w.mult := ⟨_, rfl⟩
  have hcard : 0 < Fintype.card
      (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) := by
    rw [← Module.finrank_eq_card_basis b, NumberField.RingOfIntegers.rank K]
    exact Module.finrank_pos
  obtain ⟨i₀⟩ := Fintype.card_pos_iff.mp hcard
  refine ⟨max 1 P, le_max_left _ _, ?_⟩
  intro N hN ρ
  have hMpos : (0 : ℤ) < (N : ℤ) := by exact_mod_cast hN
  have hstep : ∀ i, ∃ y : ℤ, 1 ≤ y ∧ y ≤ (N : ℤ) ∧ (N : ℤ) ∣ (y - b.repr ρ i) := by
    intro i
    refine ⟨(b.repr ρ i - 1) % (N : ℤ) + 1, ?_, ?_, ?_⟩
    · have h := Int.emod_nonneg (b.repr ρ i - 1) hMpos.ne'
      linarith
    · have h := Int.emod_lt_of_pos (b.repr ρ i - 1) hMpos
      linarith
    · refine ⟨-((b.repr ρ i - 1) / (N : ℤ)), ?_⟩
      have h := Int.ediv_add_emod (b.repr ρ i - 1) (N : ℤ)
      rw [mul_neg]
      linarith
  choose xx hx1 hx2 hx3 using hstep
  have hxabs : ∀ i, |((xx i : ℤ) : ℝ)| ≤ (N : ℝ) := by
    intro i
    have h1 := hx1 i
    have h2 := hx2 i
    have h0 : (0 : ℝ) ≤ ((xx i : ℤ) : ℝ) := by exact_mod_cast (by linarith : (0 : ℤ) ≤ xx i)
    rw [abs_of_nonneg h0]
    exact_mod_cast h2
  refine ⟨∑ i, xx i • b i, ?_, ?_, ?_⟩
  · intro h
    have h0 := (Fintype.linearIndependent_iff.mp b.linearIndependent) xx h i₀
    have h1 := hx1 i₀
    omega
  · choose kk hkk using hx3
    have hdiff : (∑ i, xx i • b i) - ρ = ∑ i, (xx i - b.repr ρ i) • b i := by
      simp only [sub_smul, Finset.sum_sub_distrib, Module.Basis.sum_repr]
    have hsum : ∀ i ∈ Finset.univ,
        (xx i - b.repr ρ i) • b i = ((N : ℤ)) • (kk i • b i) := by
      intro i _
      rw [hkk i, mul_smul]
    have h2 : ∑ i, (xx i - b.repr ρ i) • b i
        = ((N : ℕ) : NumberField.RingOfIntegers K) * (∑ i, kk i • b i) := by
      rw [Finset.sum_congr rfl hsum, ← Finset.smul_sum, zsmul_eq_mul]
      push_cast
      ring
    rw [hdiff, h2, Ideal.mem_span_singleton']
    exact ⟨∑ i, kk i • b i, mul_comm _ _⟩
  · have hmuK : ((∑ i, xx i • b i : NumberField.RingOfIntegers K) : K)
        = ∑ i, ((xx i : ℤ) : K) * ((b i : NumberField.RingOfIntegers K) : K) := by
      push_cast [zsmul_eq_mul]
      exact Finset.sum_congr rfl (fun i _ => by simp)
    have key : ∀ w : NumberField.InfinitePlace K,
        w (((∑ i, xx i • b i : NumberField.RingOfIntegers K) : K)) ≤ (N : ℝ) * A w := by
      intro w
      rw [hmuK]
      have h1 : w (∑ i, ((xx i : ℤ) : K) * ((b i : NumberField.RingOfIntegers K) : K))
          ≤ ∑ i, w (((xx i : ℤ) : K) * ((b i : NumberField.RingOfIntegers K) : K)) :=
        w.1.sum_le Finset.univ _
      have h2 : ∀ i ∈ Finset.univ,
          w (((xx i : ℤ) : K) * ((b i : NumberField.RingOfIntegers K) : K))
            ≤ (N : ℝ) * w (((b i : NumberField.RingOfIntegers K) : K)) := by
        intro i _
        rw [map_mul, hcast w (xx i)]
        exact mul_le_mul_of_nonneg_right (hxabs i) (apply_nonneg _ _)
      have h3 := Finset.sum_le_sum h2
      rw [← Finset.mul_sum, ← hA w] at h3
      linarith
    have hprod : ∏ w : NumberField.InfinitePlace K,
          (w (((∑ i, xx i • b i : NumberField.RingOfIntegers K) : K))) ^ w.mult
        ≤ ∏ w : NumberField.InfinitePlace K, ((N : ℝ) * A w) ^ w.mult := by
      refine Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg _ _) _) ?_
      intro w _
      exact pow_le_pow_left₀ (apply_nonneg _ _) (key w) _
    have hRHS : (∏ w : NumberField.InfinitePlace K, ((N : ℝ) * A w) ^ w.mult)
        = (N : ℝ) ^ (Module.finrank ℚ K) * P := by
      rw [hPdef]
      simp only [mul_pow]
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum,
        NumberField.InfinitePlace.sum_mult_eq]
    have habs : (Ideal.absNorm
          (Ideal.span {(∑ i, xx i • b i : NumberField.RingOfIntegers K)}) : ℝ)
        = ∏ w : NumberField.InfinitePlace K,
            (w (((∑ i, xx i • b i : NumberField.RingOfIntegers K) : K))) ^ w.mult := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm, Ideal.absNorm_span_singleton,
        Nat.cast_natAbs, Int.cast_abs, Rat.cast_abs]
      congr 1
      rw [← Algebra.coe_norm_int]
      norm_cast
    rw [habs]
    calc (∏ w : NumberField.InfinitePlace K,
            (w (((∑ i, xx i • b i : NumberField.RingOfIntegers K) : K))) ^ w.mult)
        ≤ ∏ w : NumberField.InfinitePlace K, ((N : ℝ) * A w) ^ w.mult := hprod
      _ = (N : ℝ) ^ (Module.finrank ℚ K) * P := hRHS
      _ ≤ (N : ℝ) ^ (Module.finrank ℚ K) * max 1 P :=
          mul_le_mul_of_nonneg_left (le_max_right _ _) (pow_nonneg (Nat.cast_nonneg _) _)
      _ = max 1 P * (N : ℝ) ^ (Module.finrank ℚ K) := mul_comm _ _

theorem kai_mf_ray_small_rep (K : Type u) [Field K] [NumberField K]
    (hsc : ∃ C : ℝ, 1 ≤ C ∧
      ∀ N : ℕ, 0 < N → ∀ ρ : NumberField.RingOfIntegers K,
        ∃ μ : NumberField.RingOfIntegers K, μ ≠ 0 ∧
          μ - ρ ∈ Ideal.span {(N : NumberField.RingOfIntegers K)} ∧
          (Ideal.absNorm (Ideal.span {μ}) : ℝ) ≤ C * (N : ℝ) ^ (Module.finrank ℚ K)) :
    ∃ C : ℝ, 1 ≤ C ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
          ∃ J : Ideal (NumberField.RingOfIntegers K), J ≠ 0 ∧ J ⊔ q = ⊤ ∧
            (Ideal.absNorm J : ℝ) ≤ C * (Ideal.absNorm q : ℝ) ^ C ∧
            ∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
              γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * I = Ideal.span {δ} * J :=
by
  classical
  have hA2 : ∀ A Bb qq : Ideal (NumberField.RingOfIntegers K),
      A ⊔ qq = ⊤ → Bb ⊔ qq = ⊤ → A * Bb ⊔ qq = ⊤ := by
    intro A Bb qq hA hB
    rw [Ideal.eq_top_iff_one] at hA hB ⊢
    rw [Submodule.mem_sup] at hA hB
    obtain ⟨a, ha, x, hx, hax⟩ := hA
    obtain ⟨b, hb, y, hy, hby⟩ := hB
    have h1 : a * b + (a * y + (x * b + x * y)) = 1 := by
      have h2 : (a + x) * (b + y) = 1 := by rw [hax, hby]; ring
      linear_combination h2
    rw [← h1]
    refine Submodule.add_mem _ (Ideal.mem_sup_left (Ideal.mul_mem_mul ha hb))
      (Ideal.mem_sup_right ?_)
    refine Submodule.add_mem _ (Ideal.mul_mem_left qq a hy) (Submodule.add_mem _ ?_ ?_)
    · rw [mul_comm]; exact Ideal.mul_mem_left qq b hx
    · exact Ideal.mul_mem_left qq x hy
  have hA3 : ∀ d I J : Ideal (NumberField.RingOfIntegers K), d ≠ 0 →
      ∀ g h a b : NumberField.RingOfIntegers K,
        Ideal.span {g} = I * d → Ideal.span {h} = d * J → g * b = a * h →
        Ideal.span {b} * I = Ideal.span {a} * J := by
    intro d I J hd g h a b hg hh heq
    refine mul_left_cancel₀ hd ?_
    calc d * (Ideal.span {b} * I) = (I * d) * Ideal.span {b} := by ring
      _ = Ideal.span {g} * Ideal.span {b} := by rw [hg]
      _ = Ideal.span {g * b} := Ideal.span_singleton_mul_span_singleton g b
      _ = Ideal.span {a * h} := by rw [heq]
      _ = Ideal.span {a} * Ideal.span {h} :=
          (Ideal.span_singleton_mul_span_singleton a h).symm
      _ = Ideal.span {a} * (d * J) := by rw [hh]
      _ = d * (Ideal.span {a} * J) := by ring
  have hA1 : ∃ B : ℕ, 0 < B ∧
      ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        ∃ (d : Ideal (NumberField.RingOfIntegers K))
          (m : NumberField.RingOfIntegers K),
          d ≠ 0 ∧ Ideal.absNorm d ≤ B ∧ m ≠ 0 ∧
            Ideal.span {m} = I * d := by
    choose E hE using fun c : ClassGroup (NumberField.RingOfIntegers K) =>
      ClassGroup.mk0_surjective c
    have hEne : ∀ c, (E c : Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
      fun c => nonZeroDivisors.ne_zero (E c).2
    have hnormpos : ∀ c, 0 < Ideal.absNorm ((E c : Ideal (NumberField.RingOfIntegers K))) := by
      intro c
      refine Nat.pos_of_ne_zero fun h0 => hEne c ?_
      rw [Submodule.zero_eq_bot]
      exact Ideal.absNorm_eq_zero_iff.mp h0
    have hBpos : 0 < ∏ c : ClassGroup (NumberField.RingOfIntegers K),
        Ideal.absNorm ((E c : Ideal (NumberField.RingOfIntegers K))) :=
      Finset.prod_pos fun c _ => hnormpos c
    refine ⟨_, hBpos, ?_⟩
    intro I hI0
    have hI : I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      mem_nonZeroDivisors_iff_ne_zero.mpr hI0
    obtain ⟨d, hdmem, hdcl, hdL⟩ :
        ∃ (d : Ideal (NumberField.RingOfIntegers K))
          (hd : d ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))),
          ClassGroup.mk0 ⟨d, hd⟩ = (ClassGroup.mk0 ⟨I, hI⟩)⁻¹ ∧
          Ideal.absNorm d ≤ ∏ c : ClassGroup (NumberField.RingOfIntegers K),
            Ideal.absNorm ((E c : Ideal (NumberField.RingOfIntegers K))) :=
      ⟨_, (E _).2, hE _,
        Nat.le_of_dvd hBpos (Finset.dvd_prod_of_mem _ (Finset.mem_univ _))⟩
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hdmem
    have hId : I * d ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      mem_nonZeroDivisors_iff_ne_zero.mpr (mul_ne_zero hI0 hd0)
    have hone : ClassGroup.mk0 ⟨I * d, hId⟩ = 1 := by
      have h1 : (⟨I * d, hId⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))))
          = ⟨I, hI⟩ * ⟨d, hdmem⟩ := Subtype.ext rfl
      rw [h1, map_mul, hdcl, mul_inv_cancel]
    haveI hprin : Submodule.IsPrincipal (I * d) := (ClassGroup.mk0_eq_one_iff hId).mp hone
    refine ⟨d, Submodule.IsPrincipal.generator (I * d), hd0, hdL, ?_,
      Ideal.span_singleton_generator (I * d)⟩
    intro h0
    apply mul_ne_zero hI0 hd0
    have hg := Ideal.span_singleton_generator (I * d)
    rw [h0] at hg
    rw [Submodule.zero_eq_bot, ← hg]
    exact Ideal.span_singleton_eq_bot.mpr rfl
  obtain ⟨C₀, hC₀1, hsc'⟩ := hsc
  obtain ⟨B, hB0, hBI⟩ := hA1
  have hB1 : (1 : ℝ) ≤ (B : ℝ) := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hB0.ne'
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ,
      C = max (C₀ * (B : ℝ) ^ (Module.finrank ℚ K)) ((Module.finrank ℚ K : ℕ) : ℝ) := ⟨_, rfl⟩
  have hCmax1 : C₀ * (B : ℝ) ^ (Module.finrank ℚ K) ≤ C := by rw [hCdef]; exact le_max_left _ _
  have hCmax2 : ((Module.finrank ℚ K : ℕ) : ℝ) ≤ C := by rw [hCdef]; exact le_max_right _ _
  have hpowB : (1 : ℝ) ≤ (B : ℝ) ^ (Module.finrank ℚ K) := one_le_pow₀ hB1
  have hC1 : (1 : ℝ) ≤ C := by nlinarith
  refine ⟨C, hC1, ?_⟩
  intro q hq I hI0 hIq
  obtain ⟨d, μ₀, hd0, hdB, hμ₀0, hμ₀⟩ := hBI I hI0
  have hμ₀d : μ₀ ∈ d := by
    have h1 : Ideal.span ({μ₀} : Set (NumberField.RingOfIntegers K)) ≤ d := by
      rw [hμ₀]; exact Ideal.mul_le_left
    exact h1 (Ideal.mem_span_singleton_self μ₀)
  have hqd0 : q * d ≠ 0 := mul_ne_zero hq hd0
  have hNnpos : 0 < Ideal.absNorm (q * d) := by
    refine Nat.pos_of_ne_zero fun h0 => hqd0 ?_
    rw [Submodule.zero_eq_bot]; exact Ideal.absNorm_eq_zero_iff.mp h0
  have hNnle : Ideal.absNorm (q * d) ≤ Ideal.absNorm q * B := by
    rw [map_mul]
    exact Nat.mul_le_mul (le_refl _) hdB
  obtain ⟨μ, hμ0, hμcong, hμnorm⟩ := hsc' (Ideal.absNorm (q * d)) hNnpos μ₀
  have hmem : μ - μ₀ ∈ q * d := by
    have h2 : Ideal.span
        ({((Ideal.absNorm (q * d) : ℕ) : NumberField.RingOfIntegers K)} :
          Set (NumberField.RingOfIntegers K)) ≤ q * d :=
      (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.absNorm_mem (q * d))
    exact h2 hμcong
  have hμd : μ ∈ d := by
    have h1 : μ - μ₀ ∈ d := Ideal.mul_le_left hmem
    have h2 : μ = (μ - μ₀) + μ₀ := by ring
    rw [h2]; exact Submodule.add_mem _ h1 hμ₀d
  obtain ⟨J, hJ⟩ : ∃ J, Ideal.span ({μ} : Set (NumberField.RingOfIntegers K)) = d * J :=
    Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem _).mpr hμd)
  have hJ0 : J ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hJ
    refine hμ0 (Ideal.span_singleton_eq_bot.mp ?_)
    rw [hJ, Submodule.zero_eq_bot]
  obtain ⟨γ, hγ0, hγI, hγq⟩ :
      ∃ r : NumberField.RingOfIntegers K, r ≠ 0 ∧ r ∈ I ∧ r - 1 ∈ q := by
    have h1 : (1 : NumberField.RingOfIntegers K) ∈ I ⊔ q := by
      rw [hIq]; exact Submodule.mem_top
    rw [Submodule.mem_sup] at h1
    obtain ⟨x, hxI, y, hyq, hxy⟩ := h1
    by_cases hx : x = 0
    · have hy1 : y = 1 := by rw [hx] at hxy; simpa using hxy
      have hqtop : q = ⊤ := by rw [Ideal.eq_top_iff_one, ← hy1]; exact hyq
      refine ⟨((Ideal.absNorm I : ℕ) : NumberField.RingOfIntegers K), ?_,
        Ideal.absNorm_mem I, ?_⟩
      · have hne : Ideal.absNorm I ≠ 0 := by
          intro h0
          exact hI0 (by rw [Submodule.zero_eq_bot]; exact Ideal.absNorm_eq_zero_iff.mp h0)
        exact_mod_cast Nat.cast_ne_zero.mpr hne
      · rw [hqtop]; exact Submodule.mem_top
    · refine ⟨x, hx, hxI, ?_⟩
      have hxy' : x - 1 = -y := by linear_combination hxy
      rw [hxy']; exact Submodule.neg_mem _ hyq
  have hγμ : γ * μ ∈ Ideal.span ({μ₀} : Set (NumberField.RingOfIntegers K)) := by
    rw [hμ₀]; exact Ideal.mul_mem_mul hγI hμd
  obtain ⟨δ, hδ⟩ : ∃ δ, γ * μ = μ₀ * δ := Ideal.mem_span_singleton.mp hγμ
  have hδ0 : δ ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hδ
    exact (mul_ne_zero hγ0 hμ0) hδ
  have hkey : μ₀ * (δ - γ) = γ * (μ - μ₀) := by linear_combination -hδ
  have hmemq : μ₀ * (δ - γ) ∈ Ideal.span ({μ₀} : Set (NumberField.RingOfIntegers K)) * q := by
    rw [hkey]
    have h1 : γ * (μ - μ₀) ∈ I * (q * d) := Ideal.mul_mem_mul hγI hmem
    have h2 : I * (q * d)
        = Ideal.span ({μ₀} : Set (NumberField.RingOfIntegers K)) * q := by
      rw [hμ₀]; ring
    rw [← h2]; exact h1
  obtain ⟨z, hzq, hz⟩ := Ideal.mem_span_singleton_mul.mp hmemq
  have hδγ : δ - γ ∈ q := by
    have hzeq : z = δ - γ := mul_left_cancel₀ hμ₀0 hz
    rw [← hzeq]; exact hzq
  have hδ1 : δ - 1 ∈ q := by
    have h : δ - 1 = (δ - γ) + (γ - 1) := by ring
    rw [h]; exact Submodule.add_mem _ hδγ hγq
  have hray : Ideal.span ({δ} : Set (NumberField.RingOfIntegers K)) * I
      = Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)) * J :=
    hA3 d I J hd0 μ₀ μ γ δ hμ₀ hJ hδ.symm
  have hδtop : Ideal.span ({δ} : Set (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : NumberField.RingOfIntegers K) = δ - (δ - 1) := by ring
    rw [h1]
    exact Submodule.sub_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self δ))
      (Ideal.mem_sup_right hδ1)
  have hprodtop : Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)) * J ⊔ q = ⊤ := by
    rw [← hray]; exact hA2 _ _ _ hδtop hIq
  have hJq : J ⊔ q = ⊤ := by
    have hle : Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)) * J ⊔ q ≤ J ⊔ q :=
      sup_le_sup_right Ideal.mul_le_left q
    rw [hprodtop] at hle
    exact top_le_iff.mp hle
  have hdn1 : 0 < Ideal.absNorm d := by
    refine Nat.pos_of_ne_zero fun h0 => hd0 ?_
    rw [Submodule.zero_eq_bot]; exact Ideal.absNorm_eq_zero_iff.mp h0
  have hJle : Ideal.absNorm J
      ≤ Ideal.absNorm (Ideal.span ({μ} : Set (NumberField.RingOfIntegers K))) := by
    rw [hJ, map_mul]
    exact Nat.le_mul_of_pos_left _ hdn1
  have hJleR : (Ideal.absNorm J : ℝ)
      ≤ (Ideal.absNorm (Ideal.span ({μ} : Set (NumberField.RingOfIntegers K))) : ℝ) := by
    exact_mod_cast hJle
  have hcast : ((Ideal.absNorm (q * d) : ℕ) : ℝ) ≤ (Ideal.absNorm q : ℝ) * (B : ℝ) := by
    exact_mod_cast hNnle
  have hC₀0 : (0 : ℝ) ≤ C₀ := by linarith
  have hstep3 : (Ideal.absNorm J : ℝ)
      ≤ (C₀ * (B : ℝ) ^ (Module.finrank ℚ K)) *
          (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K) := by
    calc (Ideal.absNorm J : ℝ)
        ≤ (Ideal.absNorm (Ideal.span ({μ} : Set (NumberField.RingOfIntegers K))) : ℝ) := hJleR
      _ ≤ C₀ * ((Ideal.absNorm (q * d) : ℕ) : ℝ) ^ (Module.finrank ℚ K) := hμnorm
      _ ≤ C₀ * ((Ideal.absNorm q : ℝ) * (B : ℝ)) ^ (Module.finrank ℚ K) := by
          refine mul_le_mul_of_nonneg_left ?_ hC₀0
          exact pow_le_pow_left₀ (by positivity) hcast _
      _ = (C₀ * (B : ℝ) ^ (Module.finrank ℚ K)) *
            (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K) := by rw [mul_pow]; ring
  have hNq1 : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    have hne : Ideal.absNorm q ≠ 0 := by
      intro h0
      exact hq (by rw [Submodule.zero_eq_bot]; exact Ideal.absNorm_eq_zero_iff.mp h0)
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
  have hrpow : (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K) ≤ (Ideal.absNorm q : ℝ) ^ C := by
    rw [← Real.rpow_natCast ((Ideal.absNorm q : ℝ)) (Module.finrank ℚ K)]
    exact Real.rpow_le_rpow_of_exponent_le hNq1 hCmax2
  have hfinal : (Ideal.absNorm J : ℝ) ≤ C * (Ideal.absNorm q : ℝ) ^ C := by
    have hpn : (0 : ℝ) ≤ (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K) := by positivity
    calc (Ideal.absNorm J : ℝ)
        ≤ (C₀ * (B : ℝ) ^ (Module.finrank ℚ K)) *
            (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K) := hstep3
      _ ≤ C * (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K) :=
          mul_le_mul_of_nonneg_right hCmax1 hpn
      _ ≤ C * (Ideal.absNorm q : ℝ) ^ C := by
          refine mul_le_mul_of_nonneg_left hrpow (by linarith)
  exact ⟨J, hJ0, hJq, hfinal, δ, γ, hδ0, hγ0, hδ1, hγq, hray⟩

theorem kai_mf_ray_class_cover (K : Type u) [Field K] [NumberField K]
    (hClass : KaiHZClassCoprimeProp K) :
    ∃ C : ℝ, 1 ≤ C ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∃ (m : ℕ) (a : Fin m → Ideal (NumberField.RingOfIntegers K)),
          (m : ℝ) ≤ C * (Ideal.absNorm q : ℝ) ^ C ∧
          (∀ j, a j ≠ 0 ∧ a j ⊔ q = ⊤) ∧
          ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
