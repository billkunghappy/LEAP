    intro ε m m'
    exact (by fun_prop : Continuous _).integrableOn_Icc
  constructor
  · 
    have G0 : ∀ m m' : Fin b → ℕ,
        Complex.exp (2 * Real.pi * Complex.I * ((∑ k, ((m k : ℝ) - (m' k : ℝ)) * x k : ℝ) : ℂ)) *
