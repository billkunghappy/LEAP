    have hmm : (1:ℝ) ≤ (mlt1 ρ₁ : ℝ) := by exact_mod_cast (hZ1a ρ₁ hρZ).2.2
    have hsingle : ((mlt1 ρ₁ : ℂ)/(((((σ:ℝ):ℂ)) + ((ρ₁.im : ℝ) : ℂ) * Complex.I) - ρ₁)).re
        ≤ ∑ ρ ∈ Z1, ((mlt1 ρ : ℂ)/(((((σ:ℝ):ℂ)) + ((ρ₁.im : ℝ) : ℂ) * Complex.I) - ρ)).re :=
      Finset.single_le_sum
        (f := fun ρ => ((mlt1 ρ : ℂ)/(((((σ:ℝ):ℂ)) + ((ρ₁.im : ℝ) : ℂ) * Complex.I) - ρ)).re)
