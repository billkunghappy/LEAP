    intro x hx; simpa using hx
  have hmulK : ∀ x y : NumberField.RingOfIntegers K,
      (((x * y : NumberField.RingOfIntegers K)) : K) = (x : K) * (y : K) := by
    intro x y; push_cast; ring
  have honeK : (((1 : NumberField.RingOfIntegers K)) : K) = 1 := by push_cast; ring
  have hre : ∀ (x y : NumberField.RingOfIntegers K)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K (((x * y : NumberField.RingOfIntegers K)) : K)).1 w
        = (NumberField.mixedEmbedding K ((x : K))).1 w
          * (NumberField.mixedEmbedding K ((y : K))).1 w := by
    intro x y w
    rw [hmulK x y, map_mul (NumberField.mixedEmbedding K)]
    rfl
  have hcx : ∀ (x y : NumberField.RingOfIntegers K)
      (p : {w : NumberField.InfinitePlace K // w.IsComplex}),
      (NumberField.mixedEmbedding K (((x * y : NumberField.RingOfIntegers K)) : K)).2 p
        = (NumberField.mixedEmbedding K ((x : K))).2 p
          * (NumberField.mixedEmbedding K ((y : K))).2 p := by
    intro x y p
    rw [hmulK x y, map_mul (NumberField.mixedEmbedding K)]
    rfl
  have hpl : ∀ (x y : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
      w ((((x * y : NumberField.RingOfIntegers K)) : K)) = w ((x : K)) * w ((y : K)) := by
    intro x y w
    rw [hmulK x y]
    exact map_mul w _ _
  have hone1 : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (NumberField.mixedEmbedding K (((1 : NumberField.RingOfIntegers K)) : K)).1 w = 1 := by
    intro w
    rw [honeK, map_one (NumberField.mixedEmbedding K)]
    rfl
  have hone2 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      (NumberField.mixedEmbedding K (((1 : NumberField.RingOfIntegers K)) : K)).2 p = 1 := by
    intro p
    rw [honeK, map_one (NumberField.mixedEmbedding K)]
    rfl
  have hone3 : ∀ w : NumberField.InfinitePlace K,
      w ((((1 : NumberField.RingOfIntegers K)) : K)) = 1 := by
    intro w
    rw [honeK]
    exact map_one w
  have hrene : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (NumberField.mixedEmbedding K ((x : K))).1 w ≠ 0 := by
    intro x hx w
    exact (map_ne_zero (NumberField.InfinitePlace.embedding_of_isReal w.prop)).mpr (hcoeK x hx)
  have hcxne : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      (NumberField.mixedEmbedding K ((x : K))).2 p ≠ 0 := by
    intro x hx p
    exact (map_ne_zero (p : NumberField.InfinitePlace K).embedding).mpr (hcoeK x hx)
  have hplne : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ w : NumberField.InfinitePlace K, w ((x : K)) ≠ 0 := by
    intro x hx w
    exact ne_of_gt (NumberField.InfinitePlace.pos_iff.mpr (hcoeK x hx))
  have hunfold : ∀ (z : NumberField.RingOfIntegers K) (hz : IsUnit (Ideal.Quotient.mk q z)),
      kaiHeckeTwist K q t l ξ η z
        = (ξ hz.unit : ℂ)
          * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              if η w then
                ((Real.sign ((NumberField.mixedEmbedding K ((z : K))).1 w) : ℝ) : ℂ)
              else 1)
          * Complex.exp (Complex.I *
              (∑ w : NumberField.InfinitePlace K,
                (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((z : K))) : ℝ) : ℂ)))
          * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
              Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                ((((NumberField.mixedEmbedding K ((z : K))).2 w).arg : ℝ) : ℂ))) := by
    intro z hz
    simp only [kaiHeckeTwist, dif_pos hz]
  have hnotunit : ∀ (z : NumberField.RingOfIntegers K),
      ¬ IsUnit (Ideal.Quotient.mk q z) → kaiHeckeTwist K q t l ξ η z = 0 := by
    intro z hz
    simp only [kaiHeckeTwist, dif_neg hz]
  have hmuliff : ∀ x y : NumberField.RingOfIntegers K,
      IsUnit (Ideal.Quotient.mk q (x * y)) ↔
        (IsUnit (Ideal.Quotient.mk q x) ∧ IsUnit (Ideal.Quotient.mk q y)) := by
    intro x y; rw [map_mul, IsUnit.mul_iff]
  have hunitmul : ∀ (x y : NumberField.RingOfIntegers K)
      (hxy : IsUnit (Ideal.Quotient.mk q (x * y)))
      (hx : IsUnit (Ideal.Quotient.mk q x)) (hy : IsUnit (Ideal.Quotient.mk q y)),
      hxy.unit = hx.unit * hy.unit := by
    intro x y hxy hx hy
    apply Units.ext
    rw [IsUnit.unit_spec, Units.val_mul, IsUnit.unit_spec, IsUnit.unit_spec, map_mul]
  have h1u : IsUnit (Ideal.Quotient.mk q (1 : NumberField.RingOfIntegers K)) := by
    rw [map_one]; exact isUnit_one
  have hA : kaiHeckeTwist K q t l ξ η 1 = 1 := by
    rw [hunfold 1 h1u]
    have hU : (ξ h1u.unit : ℂ) = 1 := by
      have hu : h1u.unit = 1 := by
        apply Units.ext
        rw [IsUnit.unit_spec, Units.val_one, map_one]
      rw [hu, map_one, Circle.coe_one]
    have hS : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
        if η w then
          ((Real.sign ((NumberField.mixedEmbedding K
            (((1 : NumberField.RingOfIntegers K)) : K)).1 w) : ℝ) : ℂ)
        else 1) = 1 := by
      refine Finset.prod_eq_one (fun w _ => ?_)
      rw [hone1 w, Real.sign_one, Complex.ofReal_one, ite_self]
    have hL : Complex.exp (Complex.I *
        (∑ w : NumberField.InfinitePlace K,
          (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
            ((Real.log (w ((((1 : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ))) = 1 := by
      have hz : (∑ w : NumberField.InfinitePlace K,
          (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
            ((Real.log (w ((((1 : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ)) = 0 := by
        refine Finset.sum_eq_zero (fun w _ => ?_)
        rw [hone3 w, Real.log_one, Complex.ofReal_zero, mul_zero]
      rw [hz, mul_zero, Complex.exp_zero]
    have hAng : (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
          ((((NumberField.mixedEmbedding K
            (((1 : NumberField.RingOfIntegers K)) : K)).2 w).arg : ℝ) : ℂ))) = 1 := by
      refine Finset.prod_eq_one (fun p _ => ?_)
      rw [hone2 p, Complex.arg_one, Complex.ofReal_zero, mul_zero, Complex.exp_zero]
    rw [hU, hS, hL, hAng]
    ring
  have hB : ∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 →
      kaiHeckeTwist K q t l ξ η (x * y)
        = kaiHeckeTwist K q t l ξ η x * kaiHeckeTwist K q t l ξ η y := by
    intro x y hx0 hy0
    by_cases hxy : IsUnit (Ideal.Quotient.mk q (x * y))
    · obtain ⟨hx, hy⟩ := (hmuliff x y).mp hxy
      rw [hunfold (x * y) hxy, hunfold x hx, hunfold y hy]
      have e1 : (ξ hxy.unit : ℂ) = (ξ hx.unit : ℂ) * (ξ hy.unit : ℂ) := by
        rw [hunitmul x y hxy hx hy, map_mul, Circle.coe_mul]
      have e2 : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then
              ((Real.sign ((NumberField.mixedEmbedding K
                (((x * y : NumberField.RingOfIntegers K)) : K)).1 w) : ℝ) : ℂ)
            else 1)
          = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              if η w then
                ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
              else 1)
            * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              if η w then
                ((Real.sign ((NumberField.mixedEmbedding K ((y : K))).1 w) : ℝ) : ℂ)
              else 1) := by
        rw [← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl (fun w _ => ?_)
        by_cases hw : η w = true
        · simp only [if_pos hw]
          rw [hre x y w, hsign, Complex.ofReal_mul]
        · simp only [if_neg hw, one_mul]
      have e3 : Complex.exp (Complex.I *
            (∑ w : NumberField.InfinitePlace K,
              (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
                ((Real.log (w ((((x * y : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ)))
          = Complex.exp (Complex.I *
              (∑ w : NumberField.InfinitePlace K,
                (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ)))
            * Complex.exp (Complex.I *
              (∑ w : NumberField.InfinitePlace K,
                (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((y : K))) : ℝ) : ℂ))) := by
        have hsum : (∑ w : NumberField.InfinitePlace K,
              (t w : ℂ) * ((w.mult : ℝ) : ℂ) *
                ((Real.log (w ((((x * y : NumberField.RingOfIntegers K)) : K))) : ℝ) : ℂ))
            = (∑ w : NumberField.InfinitePlace K,
                (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ))
              + (∑ w : NumberField.InfinitePlace K,
                (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((y : K))) : ℝ) : ℂ)) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun w _ => ?_)
          rw [hpl x y w, Real.log_mul (hplne x hx0 w) (hplne y hy0 w)]
          push_cast
          ring
        rw [hsum, mul_add, Complex.exp_add]
      have e4 : (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
            Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
              ((((NumberField.mixedEmbedding K
                (((x * y : NumberField.RingOfIntegers K)) : K)).2 w).arg : ℝ) : ℂ)))
          = (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
              Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                ((((NumberField.mixedEmbedding K ((x : K))).2 w).arg : ℝ) : ℂ)))
            * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
              Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                ((((NumberField.mixedEmbedding K ((y : K))).2 w).arg : ℝ) : ℂ))) := by
        rw [← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl (fun p _ => ?_)
        rw [hcx x y p]
        exact hargmul (l p) _ _ (hcxne x hx0 p) (hcxne y hy0 p)
      rw [e1, e2, e3, e4]
      ring
    · rw [hnotunit (x * y) hxy]
      by_cases hx : IsUnit (Ideal.Quotient.mk q x)
      · by_cases hy : IsUnit (Ideal.Quotient.mk q y)
        · exact absurd ((hmuliff x y).mpr ⟨hx, hy⟩) hxy
        · rw [hnotunit y hy, mul_zero]
      · rw [hnotunit x hx, zero_mul]
  have hC : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 →
      IsUnit (Ideal.Quotient.mk q x) → ‖kaiHeckeTwist K q t l ξ η x‖ = 1 := by
    intro x hx0 hx
    rw [hunfold x hx, norm_mul, norm_mul, norm_mul]
    have n1 : ‖(ξ hx.unit : ℂ)‖ = 1 := Circle.norm_coe _
    have n2 : ‖(∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
        if η w then
          ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
        else 1)‖ = 1 := by
      rw [norm_prod]
      refine Finset.prod_eq_one (fun w _ => ?_)
      by_cases hw : η w = true
      · rw [if_pos hw]
        exact hsignnorm _ (hrene x hx0 w)
      · rw [if_neg hw, norm_one]
    have n3 : ‖Complex.exp (Complex.I *
        (∑ w : NumberField.InfinitePlace K,
          (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ)))‖ = 1 := by
      have hs : (∑ w : NumberField.InfinitePlace K,
            (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ))
          = (((∑ w : NumberField.InfinitePlace K,
              t w * (w.mult : ℝ) * Real.log (w ((x : K))) : ℝ)) : ℂ) := by
        push_cast; ring
      rw [hs, mul_comm, Complex.norm_exp_ofReal_mul_I]
    have n4 : ‖(∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
          ((((NumberField.mixedEmbedding K ((x : K))).2 w).arg : ℝ) : ℂ)))‖ = 1 := by
      rw [norm_prod]
      exact Finset.prod_eq_one (fun p _ => hexpnorm (l p) _)
    rw [n1, n2, n3, n4]
    norm_num
  exact ⟨hA, hB, hC⟩

theorem kai_lp_prod_fourier_expansion {ι : Type*} [Fintype ι] {r : ℕ}
    (T : Fin r → ℝ → ℝ) (S : ι → ℝ → ℝ)
    (cT : Fin r → ℤ → ℂ) (cS : ι → ℤ → ℂ)
    (hcT : ∀ j, Summable (fun m : ℤ => ‖cT j m‖))
    (hcS : ∀ p, Summable (fun l : ℤ => ‖cS p l‖))
    (hTexp : ∀ j (y : ℝ), ((T j y : ℝ) : ℂ)
        = ∑' m : ℤ, cT j m * Complex.exp (2 * Real.pi * Complex.I * (m : ℂ) * (y : ℂ)))
    (hSexp : ∀ p (y : ℝ), ((S p y : ℝ) : ℂ)
        = ∑' l : ℤ, cS p l * Complex.exp (2 * Real.pi * Complex.I * (l : ℂ) * (y : ℂ)))
    (Ω : Fin r → ℝ) (Θ : ι → ℝ) :
    Summable (fun ml : (Fin r → ℤ) × (ι → ℤ) =>
        ‖(∏ j, cT j (ml.1 j)) * (∏ p, cS p (ml.2 p))‖) ∧
    (((∏ j, T j (Ω j)) * (∏ p, S p (Θ p)) : ℝ) : ℂ)
      = ∑' ml : (Fin r → ℤ) × (ι → ℤ),
          (∏ j, cT j (ml.1 j)) * (∏ p, cS p (ml.2 p))
            * Complex.exp (2 * Real.pi * Complex.I *
                ((((∑ j, (ml.1 j : ℝ) * Ω j) + ∑ p, (ml.2 p : ℝ) * Θ p) : ℝ) : ℂ)) :=
by
  classical
  
  have Pfin : ∀ (n : ℕ) (g : Fin n → ℤ → ℂ),
      (∀ i, Summable (fun b : ℤ => ‖g i b‖)) →
      Summable (fun ν : Fin n → ℤ => ‖∏ i : Fin n, g i (ν i)‖) ∧
      (∏ i : Fin n, ∑' b : ℤ, g i b)
        = ∑' ν : Fin n → ℤ, ∏ i : Fin n, g i (ν i) := by
    intro n
    induction n with
    | zero =>
        intro g _
        constructor
        · exact Summable.of_finite
        · simp
    | succ n ih =>
        intro g hg
        obtain ⟨ih1, ih2⟩ := ih (fun i : Fin n => g i.succ) (fun i => hg i.succ)
        set E : ℤ × (Fin n → ℤ) ≃ (Fin (n + 1) → ℤ) :=
          Fin.consEquiv (fun _ : Fin (n + 1) => ℤ) with hE
        have hK : ∀ z : ℤ × (Fin n → ℤ),
            (∏ i : Fin (n + 1), g i (E z i))
              = g 0 z.1 * ∏ i : Fin n, g i.succ (z.2 i) := by
          intro z
          simp only [hE, Fin.prod_univ_succ, Fin.consEquiv_apply, Fin.cons_zero, Fin.cons_succ]
        constructor
        · have h1 : Summable (fun z : ℤ × (Fin n → ℤ) =>
              ‖(fun b : ℤ => g 0 b) z.1
                * (fun ν : Fin n → ℤ => ∏ i : Fin n, g i.succ (ν i)) z.2‖) :=
            Summable.mul_norm (f := fun b : ℤ => g 0 b)
              (g := fun ν : Fin n → ℤ => ∏ i : Fin n, g i.succ (ν i)) (hg 0) ih1
          have h2 : Summable
              ((fun w : Fin (n + 1) → ℤ => ‖∏ i : Fin (n + 1), g i (w i)‖) ∘ ⇑E) := by
            refine h1.congr ?_
            intro z
            simp only [Function.comp_apply]
            exact congrArg norm (hK z).symm
          exact (Equiv.summable_iff E).mp h2
        · have hstep : (∑' b : ℤ, g 0 b)
                * (∑' ν : Fin n → ℤ, ∏ i : Fin n, g i.succ (ν i))
              = ∑' z : ℤ × (Fin n → ℤ),
                  (fun b : ℤ => g 0 b) z.1
                    * (fun ν : Fin n → ℤ => ∏ i : Fin n, g i.succ (ν i)) z.2 :=
            tsum_mul_tsum_of_summable_norm (f := fun b : ℤ => g 0 b)
              (g := fun ν : Fin n → ℤ => ∏ i : Fin n, g i.succ (ν i)) (hg 0) ih1
          have hlast : (∑' z : ℤ × (Fin n → ℤ), ∏ i : Fin (n + 1), g i (E z i))
              = ∑' w : Fin (n + 1) → ℤ, ∏ i : Fin (n + 1), g i (w i) :=
            Equiv.tsum_eq E (fun w : Fin (n + 1) → ℤ => ∏ i : Fin (n + 1), g i (w i))
          calc (∏ i : Fin (n + 1), ∑' b : ℤ, g i b)
              = (∑' b : ℤ, g 0 b) * ∏ i : Fin n, ∑' b : ℤ, g i.succ b :=
                Fin.prod_univ_succ (fun i : Fin (n + 1) => ∑' b : ℤ, g i b)
            _ = (∑' b : ℤ, g 0 b) * (∑' ν : Fin n → ℤ, ∏ i : Fin n, g i.succ (ν i)) := by
                rw [ih2]
            _ = ∑' z : ℤ × (Fin n → ℤ), g 0 z.1 * ∏ i : Fin n, g i.succ (z.2 i) := hstep
            _ = ∑' z : ℤ × (Fin n → ℤ), ∏ i : Fin (n + 1), g i (E z i) :=
                tsum_congr (fun z => (hK z).symm)
            _ = ∑' w : Fin (n + 1) → ℤ, ∏ i : Fin (n + 1), g i (w i) := hlast
  
  have Pι : ∀ (f : ι → ℤ → ℂ), (∀ i, Summable (fun b : ℤ => ‖f i b‖)) →
      Summable (fun ν : ι → ℤ => ‖∏ i, f i (ν i)‖) ∧
      (∏ i, ∑' b : ℤ, f i b) = ∑' ν : ι → ℤ, ∏ i, f i (ν i) := by
    intro f hf
    set N : ℕ := Fintype.card ι with hN
    set ee : ι ≃ Fin N := Fintype.equivFin ι with hee
    obtain ⟨h1, h2⟩ := Pfin N (fun k : Fin N => f (ee.symm k)) (fun k => hf (ee.symm k))
    set Fa : (ι → ℤ) ≃ (Fin N → ℤ) := Equiv.arrowCongr ee (Equiv.refl ℤ) with hFa
    have hK' : ∀ ω : ι → ℤ,
        (∏ k : Fin N, f (ee.symm k) (Fa ω k)) = ∏ i : ι, f i (ω i) := by
      intro ω
      have hstep : ∀ k : Fin N,
          f (ee.symm k) (Fa ω k) = (fun i : ι => f i (ω i)) (ee.symm k) := by
        intro k
        simp only [hFa, Equiv.arrowCongr_apply, Equiv.coe_refl,
          Function.comp_apply, id_eq]
      rw [Finset.prod_congr rfl (fun k _ => hstep k)]
      exact Equiv.prod_comp ee.symm (fun i : ι => f i (ω i))
    constructor
    · have hs : Summable
          ((fun ν : Fin N → ℤ => ‖∏ k : Fin N, f (ee.symm k) (ν k)‖) ∘ ⇑Fa) :=
        (Equiv.summable_iff Fa).mpr h1
      refine hs.congr ?_
      intro ω
      simp only [Function.comp_apply]
      exact congrArg norm (hK' ω)
    · have hp : (∏ i : ι, ∑' b : ℤ, f i b) = ∏ k : Fin N, ∑' b : ℤ, f (ee.symm k) b :=
        (Equiv.prod_comp ee.symm (fun i : ι => ∑' b : ℤ, f i b)).symm
      have hlast : (∑' ω : ι → ℤ, ∏ k : Fin N, f (ee.symm k) (Fa ω k))
          = ∑' ν : Fin N → ℤ, ∏ k : Fin N, f (ee.symm k) (ν k) :=
        Equiv.tsum_eq Fa (fun ν : Fin N → ℤ => ∏ k : Fin N, f (ee.symm k) (ν k))
      calc (∏ i : ι, ∑' b : ℤ, f i b)
          = ∏ k : Fin N, ∑' b : ℤ, f (ee.symm k) b := hp
        _ = ∑' ν : Fin N → ℤ, ∏ k : Fin N, f (ee.symm k) (ν k) := h2
        _ = ∑' ω : ι → ℤ, ∏ k : Fin N, f (ee.symm k) (Fa ω k) := hlast.symm
        _ = ∑' ω : ι → ℤ, ∏ i : ι, f i (ω i) := tsum_congr hK'
  
  set F : Fin r → ℤ → ℂ := fun j n =>
    cT j n * Complex.exp (2 * Real.pi * Complex.I * (n : ℂ) * ((Ω j : ℝ) : ℂ)) with hFdef
  set G : ι → ℤ → ℂ := fun p n =>
    cS p n * Complex.exp (2 * Real.pi * Complex.I * (n : ℂ) * ((Θ p : ℝ) : ℂ)) with hGdef
  have hnormF : ∀ (j : Fin r) (n : ℤ), ‖F j n‖ = ‖cT j n‖ := by
    intro j n
    have h1 : (2 : ℂ) * (Real.pi : ℂ) * Complex.I * (n : ℂ) * ((Ω j : ℝ) : ℂ)
        = ((2 * Real.pi * (n : ℝ) * Ω j : ℝ) : ℂ) * Complex.I := by
      push_cast
      ring
    simp only [hFdef]
    rw [h1, norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
  have hnormG : ∀ (p : ι) (n : ℤ), ‖G p n‖ = ‖cS p n‖ := by
    intro p n
    have h1 : (2 : ℂ) * (Real.pi : ℂ) * Complex.I * (n : ℂ) * ((Θ p : ℝ) : ℂ)
        = ((2 * Real.pi * (n : ℝ) * Θ p : ℝ) : ℂ) * Complex.I := by
      push_cast
      ring
    simp only [hGdef]
    rw [h1, norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
  
  have hF : ∀ j : Fin r, Summable (fun n : ℤ => ‖F j n‖) :=
    fun j => (hcT j).congr (fun n => (hnormF j n).symm)
  have hG : ∀ p : ι, Summable (fun n : ℤ => ‖G p n‖) :=
    fun p => (hcS p).congr (fun n => (hnormG p n).symm)
  
  obtain ⟨hSumTe, hTe⟩ := Pfin r F hF
  obtain ⟨hSumSe, hSe⟩ := Pι G hG
  obtain ⟨hSumT0, -⟩ := Pfin r cT hcT
  obtain ⟨hSumS0, -⟩ := Pι cS hcS
  
  have hstarT : ∀ ν : Fin r → ℤ, (∏ j, F j (ν j))
      = (∏ j, cT j (ν j)) * Complex.exp (2 * Real.pi * Complex.I *
          (((∑ j, ((ν j : ℤ) : ℝ) * Ω j) : ℝ) : ℂ)) := by
    intro ν
    have hexp : (∑ j : Fin r, 2 * (Real.pi : ℂ) * Complex.I * ((ν j : ℤ) : ℂ)
          * ((Ω j : ℝ) : ℂ))
        = 2 * (Real.pi : ℂ) * Complex.I * (((∑ j, ((ν j : ℤ) : ℝ) * Ω j) : ℝ) : ℂ) := by
      push_cast
      simp only [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    simp only [hFdef]
    rw [Finset.prod_mul_distrib, ← Complex.exp_sum, hexp]
  have hstarS : ∀ μ : ι → ℤ, (∏ p, G p (μ p))
      = (∏ p, cS p (μ p)) * Complex.exp (2 * Real.pi * Complex.I *
          (((∑ p, ((μ p : ℤ) : ℝ) * Θ p) : ℝ) : ℂ)) := by
    intro μ
    have hexp : (∑ p : ι, 2 * (Real.pi : ℂ) * Complex.I * ((μ p : ℤ) : ℂ)
          * ((Θ p : ℝ) : ℂ))
        = 2 * (Real.pi : ℂ) * Complex.I * (((∑ p, ((μ p : ℤ) : ℝ) * Θ p) : ℝ) : ℂ) := by
      push_cast
      simp only [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun p _ => by ring)
    simp only [hGdef]
    rw [Finset.prod_mul_distrib, ← Complex.exp_sum, hexp]
  
  have hLHS : (((∏ j, T j (Ω j)) * (∏ p, S p (Θ p)) : ℝ) : ℂ)
      = (∏ j, ∑' n : ℤ, F j n) * (∏ p, ∑' n : ℤ, G p n) := by
    rw [Complex.ofReal_mul, Complex.ofReal_prod, Complex.ofReal_prod]
    congr 1
    · exact Finset.prod_congr rfl (fun j _ => hTexp j (Ω j))
    · exact Finset.prod_congr rfl (fun p _ => hSexp p (Θ p))
  have hMain : (((∏ j, T j (Ω j)) * (∏ p, S p (Θ p)) : ℝ) : ℂ)
      = ∑' ml : (Fin r → ℤ) × (ι → ℤ), (∏ j, F j (ml.1 j)) * (∏ p, G p (ml.2 p)) := by
    rw [hLHS, hTe, hSe]
    exact tsum_mul_tsum_of_summable_norm
      (f := fun ν : Fin r → ℤ => ∏ j, F j (ν j))
      (g := fun μ : ι → ℤ => ∏ p, G p (μ p)) hSumTe hSumSe
  
  have hexpadd : ∀ a b : ℝ,
      Complex.exp (2 * Real.pi * Complex.I * ((a : ℝ) : ℂ))
        * Complex.exp (2 * Real.pi * Complex.I * ((b : ℝ) : ℂ))
      = Complex.exp (2 * Real.pi * Complex.I * (((a + b : ℝ)) : ℂ)) := by
    intro a b
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  refine ⟨Summable.mul_norm
      (f := fun ν : Fin r → ℤ => ∏ j, cT j (ν j))
      (g := fun μ : ι → ℤ => ∏ p, cS p (μ p)) hSumT0 hSumS0, ?_⟩
  rw [hMain]
  refine tsum_congr (fun ml => ?_)
  rw [hstarT ml.1, hstarS ml.2, ← hexpadd]
  ring

theorem kai_lp_transversal_char_sum {G : Type*} [CommGroup G] {r M : ℕ}
    (H : Fin r → G) (v : Fin M → G)
    (hv : ∀ y : G, ∃! p : Fin M × (Fin r → ℤ), y = v p.1 * ∏ j, (H j) ^ (p.2 j))
    (χ : G → ℂ) (h1 : χ 1 = 1)
    (hmul : ∀ a b : G, χ (a * b) = χ a * χ b)
    (hH : ∀ j, χ (H j) = 1) :
    ((∀ y : G, χ y = 1) → (∑ i : Fin M, χ (v i)) = (M : ℂ)) ∧
    ((∃ y : G, χ y ≠ 1) → (∑ i : Fin M, χ (v i)) = 0) :=
by
  classical
  let χ' : G →* ℂ := { toFun := χ, map_one' := h1, map_mul' := hmul }
  have hinv : ∀ g : G, χ g = 1 → χ g⁻¹ = 1 := by
    intro g hg
    have h := hmul g⁻¹ g
    rw [inv_mul_cancel, h1, hg, mul_one] at h
    exact h.symm
  have hzpow : ∀ j (m : ℤ), χ ((H j) ^ m) = 1 := by
    intro j m
    induction m using Int.induction_on with
    | zero => rw [zpow_zero, h1]
    | succ i ih => rw [zpow_add_one, hmul, ih, hH, mul_one]
    | pred i ih => rw [zpow_sub_one, hmul, ih, hinv _ (hH j), mul_one]
  have hlat : ∀ n : Fin r → ℤ, χ (∏ j, (H j) ^ (n j)) = 1 := by
    intro n
    have h : χ (∏ j, (H j) ^ (n j)) = ∏ j, χ ((H j) ^ (n j)) :=
      map_prod χ' (fun j => (H j) ^ (n j)) Finset.univ
    rw [h]
    exact Finset.prod_eq_one (fun j _ => hzpow j (n j))
  refine ⟨fun hall => ?_, fun ⟨y₀, hy₀⟩ => ?_⟩
  · simp [hall]
  · have hex : ∀ i, ∃ p : Fin M × (Fin r → ℤ), y₀ * v i = v p.1 * ∏ j, (H j) ^ (p.2 j) :=
      fun i => (hv (y₀ * v i)).exists
    choose p hp using hex
    have hinj : Function.Injective (fun i => (p i).1) := by
      intro i i' hii'
      simp only at hii'
      have e1 := hp i
      have e2 := hp i'
      rw [hii'] at e1
      have hvi : v i = y₀⁻¹ * (v (p i').1 * ∏ j, (H j) ^ ((p i).2 j)) := by
        rw [← e1, inv_mul_cancel_left]
      have hvi' : v i' = y₀⁻¹ * (v (p i').1 * ∏ j, (H j) ^ ((p i').2 j)) := by
        rw [← e2, inv_mul_cancel_left]
      have hprod : ∏ j, (H j) ^ (((p i).2 - (p i').2) j)
          = (∏ j, (H j) ^ ((p i).2 j)) * (∏ j, (H j) ^ ((p i').2 j))⁻¹ := by
        simp only [Pi.sub_apply, zpow_sub]
        rw [Finset.prod_mul_distrib, Finset.prod_inv_distrib]
      have key : v i = v ((i', (p i).2 - (p i').2) : Fin M × (Fin r → ℤ)).1
          * ∏ j, (H j) ^ (((i', (p i).2 - (p i').2) : Fin M × (Fin r → ℤ)).2 j) := by
        show v i = v i' * ∏ j, (H j) ^ (((p i).2 - (p i').2) j)
        rw [hprod, hvi, hvi']
        set a := ∏ j, (H j) ^ ((p i).2 j)
        set b := ∏ j, (H j) ^ ((p i').2 j)
        calc y₀⁻¹ * (v (p i').1 * a) = y₀⁻¹ * (v (p i').1 * a) * (b * b⁻¹) := by
              rw [mul_inv_cancel, mul_one]
          _ = y₀⁻¹ * (v (p i').1 * b) * (a * b⁻¹) := by ac_rfl
      have key0 : v i = v ((i, 0) : Fin M × (Fin r → ℤ)).1
          * ∏ j, (H j) ^ (((i, 0) : Fin M × (Fin r → ℤ)).2 j) := by
        simp
      have huniq := (hv (v i)).unique key key0
      exact (congrArg Prod.fst huniq).symm
    have hbij : Function.Bijective (fun i => (p i).1) := Finite.injective_iff_bijective.mp hinj
    have hS : χ y₀ * (∑ i : Fin M, χ (v i)) = ∑ i : Fin M, χ (v i) := by
      rw [Finset.mul_sum]
      calc ∑ i : Fin M, χ y₀ * χ (v i) = ∑ i : Fin M, χ (v (p i).1) :=
            Finset.sum_congr rfl (fun i _ => by rw [← hmul, hp i, hmul, hlat, mul_one])
        _ = ∑ i : Fin M, χ (v i) := hbij.sum_comp (fun k => χ (v k))
    have h0 : (χ y₀ - 1) * (∑ i : Fin M, χ (v i)) = 0 := by
      rw [sub_mul, hS, one_mul, sub_self]
    exact (mul_eq_zero.mp h0).resolve_left (sub_ne_zero.mpr hy₀)

theorem kai_lp_twist_at_basis_unit (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hH : ∀ j, KaiTBCongUnit K q (H j))
    (horth : ∀ i j, ∑ w : NumberField.InfinitePlace K,
        kaiTBUnitLog K (H i) w * e j w = if i = j then 1 else 0)
    (m : Fin (NumberField.Units.rank K) → ℤ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (k : Fin (NumberField.Units.rank K)) :
    kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η
        ((H k : NumberField.RingOfIntegers K)) = 1 :=
by
  have hmk : Ideal.Quotient.mk q ((H k : NumberField.RingOfIntegers K)) = 1 := by
    have h : Ideal.Quotient.mk q ((H k : NumberField.RingOfIntegers K))
        = Ideal.Quotient.mk q 1 := Ideal.Quotient.eq.mpr (hH k).1
    simpa using h
  have hx : IsUnit (Ideal.Quotient.mk q ((H k : NumberField.RingOfIntegers K))) := by
    rw [hmk]
    exact isUnit_one
  have hu : hx.unit = 1 := Units.ext (by simpa using hmk)
  have hsign : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      ((Real.sign ((NumberField.mixedEmbedding K
          (((H k : NumberField.RingOfIntegers K)) : K)).1 w) : ℝ) : ℂ) = 1 := by
    intro w
    rw [Real.sign_of_pos ((hH k).2 w), Complex.ofReal_one]
  have horth' : ∀ j, (∑ w : NumberField.InfinitePlace K,
      ((w.mult : ℝ) *
          Real.log (w (((H k : NumberField.RingOfIntegers K)) : K))) * e j w)
        = if k = j then 1 else 0 := by
    intro j
    have h := horth k j
    simp only [kaiTBUnitLog] at h
    exact h
  have general : ∀ (cc : Fin (NumberField.Units.rank K) → ℝ)
      (L : NumberField.InfinitePlace K → ℝ),
      (∀ j, (∑ w : NumberField.InfinitePlace K, L w * e j w) = if k = j then 1 else 0) →
      (∑ w : NumberField.InfinitePlace K,
          (2 * Real.pi * ∑ j, cc j * e j w) * L w) = 2 * Real.pi * cc k := by
    intro cc L hL
    have e1 : ∀ w : NumberField.InfinitePlace K,
        (2 * Real.pi * ∑ j, cc j * e j w) * L w
          = ∑ j, (2 * Real.pi * cc j) * (L w * e j w) := by
      intro w
      rw [Finset.mul_sum, Finset.sum_mul]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    have e2 : ∀ j : Fin (NumberField.Units.rank K),
        (∑ w : NumberField.InfinitePlace K, (2 * Real.pi * cc j) * (L w * e j w))
          = (2 * Real.pi * cc j) * (if k = j then 1 else 0) := by
      intro j
      rw [← Finset.mul_sum, hL j]
    calc (∑ w : NumberField.InfinitePlace K,
            (2 * Real.pi * ∑ j, cc j * e j w) * L w)
        = ∑ w : NumberField.InfinitePlace K,
            ∑ j, (2 * Real.pi * cc j) * (L w * e j w) :=
          Finset.sum_congr rfl (fun w _ => e1 w)
      _ = ∑ j, ∑ w : NumberField.InfinitePlace K,
            (2 * Real.pi * cc j) * (L w * e j w) := Finset.sum_comm
      _ = ∑ j, (2 * Real.pi * cc j) * (if k = j then (1 : ℝ) else 0) :=
          Finset.sum_congr rfl (fun j _ => e2 j)
      _ = 2 * Real.pi * cc k := by simp
  have hcrux : (∑ w : NumberField.InfinitePlace K,
        kaiLPFreqType K H e m l w * ((w.mult : ℝ) *
          Real.log (w (((H k : NumberField.RingOfIntegers K)) : K))))
      = 2 * Real.pi * ((m k : ℝ) - (2 * Real.pi)⁻¹ *
          ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
            ((NumberField.mixedEmbedding K
              (((H k : NumberField.RingOfIntegers K)) : K)).2 p).arg) :=
    general (fun j => (m j : ℝ) - (2 * Real.pi)⁻¹ *
        ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
          ((NumberField.mixedEmbedding K
            (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg)
      (fun w => (w.mult : ℝ) *
        Real.log (w (((H k : NumberField.RingOfIntegers K)) : K))) horth'
  have harith : ∀ a b : ℝ,
      2 * Real.pi * (a - (2 * Real.pi)⁻¹ * b) = 2 * Real.pi * a - b := by
    intro a b
    have h2pi : (2 : ℝ) * Real.pi ≠ 0 := mul_ne_zero (by norm_num) Real.pi_ne_zero
    rw [mul_sub, ← mul_assoc, mul_inv_cancel₀ h2pi, one_mul]
  have hcrux2 : (∑ w : NumberField.InfinitePlace K,
        kaiLPFreqType K H e m l w * ((w.mult : ℝ) *
          Real.log (w (((H k : NumberField.RingOfIntegers K)) : K))))
      = 2 * Real.pi * (m k : ℝ)
        - ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
            ((NumberField.mixedEmbedding K
              (((H k : NumberField.RingOfIntegers K)) : K)).2 p).arg := by
    rw [hcrux, harith]
  have hsum : (∑ w : NumberField.InfinitePlace K,
        ((kaiLPFreqType K H e m l w : ℝ) : ℂ) * ((w.mult : ℝ) : ℂ)
          * ((Real.log (w (((H k : NumberField.RingOfIntegers K)) : K)) : ℝ) : ℂ))
      = ((2 * Real.pi * (m k : ℝ)
          - ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
              ((NumberField.mixedEmbedding K
                (((H k : NumberField.RingOfIntegers K)) : K)).2 p).arg : ℝ) : ℂ) := by
    rw [← hcrux2, Complex.ofReal_sum]
    exact Finset.sum_congr rfl (fun w _ => by push_cast; ring)
  have hprod : (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        Complex.exp (Complex.I * ((l p : ℤ) : ℂ) *
          ((((NumberField.mixedEmbedding K
            (((H k : NumberField.RingOfIntegers K)) : K)).2 p).arg : ℝ) : ℂ)))
      = Complex.exp (Complex.I *
          ((∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
            ((NumberField.mixedEmbedding K
              (((H k : NumberField.RingOfIntegers K)) : K)).2 p).arg : ℝ) : ℂ)) := by
    rw [← Complex.exp_sum]
    congr 1
    rw [Complex.ofReal_sum, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun p _ => by push_cast; ring)
  simp only [kaiHeckeTwist, dif_pos hx, hu, map_one, Circle.coe_one, hsign,
    ite_self, Finset.prod_const_one, one_mul]
  rw [hsum, hprod, ← Complex.exp_add]
  have hexp : Complex.I * ((2 * Real.pi * (m k : ℝ)
        - ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
            ((NumberField.mixedEmbedding K
              (((H k : NumberField.RingOfIntegers K)) : K)).2 p).arg : ℝ) : ℂ)
      + Complex.I * ((∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (l p : ℝ) * ((NumberField.mixedEmbedding K
            (((H k : NumberField.RingOfIntegers K)) : K)).2 p).arg : ℝ) : ℂ)
      = ((m k : ℤ) : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
    push_cast
    ring
  rw [hexp, Complex.exp_int_mul_two_pi_mul_I]

theorem kai_lp_ressgn_freq_expansion (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [DecidableEq {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (Ξ : Finset (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle))
    (hΞ1 : (1 : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) ∈ Ξ)
    (hΞcard : Ξ.card = Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ))
    (hΞ0 : ∀ z : ((NumberField.RingOfIntegers K ⧸ q)ˣ), z ≠ 1 →
      (∑ ξ ∈ Ξ, (ξ z : ℂ)) = 0)
    (α : NumberField.RingOfIntegers K) (hα : IsUnit (Ideal.Quotient.mk q α))
    (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (m : Fin (NumberField.Units.rank K) → ℤ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (z : NumberField.RingOfIntegers K) (hz : z ≠ 0) :
    ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)
        * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
      * (((kaiLPResSgn K q α sgn z : ℝ) : ℂ)
          * Complex.exp (2 * Real.pi * Complex.I *
              ((((∑ j, (m j : ℝ)
                    * kaiTBPair K (e j) ((z : NumberField.RingOfIntegers K) : K))
                  + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                      (l p : ℝ)
                        * kaiTBTheta K H e p
                            ((z : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ)))
      = ∑ ξ ∈ Ξ, ∑ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
          (starRingEnd ℂ) ((ξ hα.unit : ℂ))
            * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                if η w then (if sgn w then (1 : ℂ) else -1) else 1)
            * kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η z :=
by
  classical
  
  have phaseId : ∀ y : K,
      (∑ w : NumberField.InfinitePlace K,
            kaiLPFreqType K H e m l w * (w.mult : ℝ) * Real.log (w y))
          + (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                (l p : ℝ) * ((NumberField.mixedEmbedding K y).2 p).arg)
        = 2 * Real.pi *
            ((∑ j, (m j : ℝ) * kaiTBPair K (e j) y)
              + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                  (l p : ℝ) * kaiTBTheta K H e p y) := by
    intro y
    have hT : (2 * Real.pi) ≠ 0 := mul_ne_zero two_ne_zero Real.pi_ne_zero
    have hTinv : (2 * Real.pi) * (2 * Real.pi)⁻¹ = 1 := mul_inv_cancel₀ hT
    have hassoc : (∑ w : NumberField.InfinitePlace K,
          kaiLPFreqType K H e m l w * (w.mult : ℝ) * Real.log (w y))
        = ∑ w : NumberField.InfinitePlace K,
            kaiLPFreqType K H e m l w * ((w.mult : ℝ) * Real.log (w y)) :=
      Finset.sum_congr rfl (fun w _ => mul_assoc _ _ _)
    have key : ∀ (cc : Fin (NumberField.Units.rank K) → ℝ)
        (Lg : NumberField.InfinitePlace K → ℝ),
        (∑ w : NumberField.InfinitePlace K, (2 * Real.pi * ∑ j, cc j * e j w) * Lg w)
          = 2 * Real.pi *
              ∑ j, cc j * (∑ w : NumberField.InfinitePlace K, e j w * Lg w) := by
      intro cc Lg
      have step1 : ∀ w : NumberField.InfinitePlace K,
          (2 * Real.pi * ∑ j, cc j * e j w) * Lg w
            = ∑ j, 2 * Real.pi * (cc j * (e j w * Lg w)) := by
        intro w
        rw [Finset.mul_sum, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      calc (∑ w : NumberField.InfinitePlace K, (2 * Real.pi * ∑ j, cc j * e j w) * Lg w)
          = ∑ w : NumberField.InfinitePlace K,
              ∑ j, 2 * Real.pi * (cc j * (e j w * Lg w)) :=
            Finset.sum_congr rfl (fun w _ => step1 w)
        _ = ∑ j, ∑ w : NumberField.InfinitePlace K,
              2 * Real.pi * (cc j * (e j w * Lg w)) := Finset.sum_comm
        _ = ∑ j, 2 * Real.pi *
              (cc j * (∑ w : NumberField.InfinitePlace K, e j w * Lg w)) := by
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Finset.mul_sum, Finset.mul_sum]
        _ = 2 * Real.pi *
              ∑ j, cc j * (∑ w : NumberField.InfinitePlace K, e j w * Lg w) :=
            (Finset.mul_sum _ _ _).symm
    have E1 : (∑ w : NumberField.InfinitePlace K,
          kaiLPFreqType K H e m l w * ((w.mult : ℝ) * Real.log (w y)))
        = 2 * Real.pi * ∑ j,
            ((m j : ℝ) - (2 * Real.pi)⁻¹ *
                (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
                  ((NumberField.mixedEmbedding K
                      ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg))
              * kaiTBPair K (e j) y :=
      key (fun j => (m j : ℝ) - (2 * Real.pi)⁻¹ *
              (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg))
        (fun w => (w.mult : ℝ) * Real.log (w y))
    have E2gen : ∀ Sf Om : Fin (NumberField.Units.rank K) → ℝ,
        (2 * Real.pi * ∑ j, ((m j : ℝ) - (2 * Real.pi)⁻¹ * Sf j) * Om j)
          = 2 * Real.pi * (∑ j, (m j : ℝ) * Om j) - ∑ j, Sf j * Om j := by
      intro Sf Om
      have hpt : ∀ j : Fin (NumberField.Units.rank K),
          2 * Real.pi * (((m j : ℝ) - (2 * Real.pi)⁻¹ * Sf j) * Om j)
            = 2 * Real.pi * ((m j : ℝ) * Om j) - Sf j * Om j := by
        intro j
        have h : 2 * Real.pi * ((2 * Real.pi)⁻¹ * (Sf j * Om j)) = Sf j * Om j := by
          rw [← mul_assoc, hTinv, one_mul]
        calc 2 * Real.pi * (((m j : ℝ) - (2 * Real.pi)⁻¹ * Sf j) * Om j)
            = 2 * Real.pi * ((m j : ℝ) * Om j)
                - 2 * Real.pi * ((2 * Real.pi)⁻¹ * (Sf j * Om j)) := by ring
          _ = 2 * Real.pi * ((m j : ℝ) * Om j) - Sf j * Om j := by rw [h]
      calc (2 * Real.pi * ∑ j, ((m j : ℝ) - (2 * Real.pi)⁻¹ * Sf j) * Om j)
          = ∑ j, 2 * Real.pi * (((m j : ℝ) - (2 * Real.pi)⁻¹ * Sf j) * Om j) :=
            Finset.mul_sum _ _ _
        _ = ∑ j, (2 * Real.pi * ((m j : ℝ) * Om j) - Sf j * Om j) :=
            Finset.sum_congr rfl (fun j _ => hpt j)
        _ = (∑ j, 2 * Real.pi * ((m j : ℝ) * Om j)) - ∑ j, Sf j * Om j := by
            rw [Finset.sum_sub_distrib]
        _ = 2 * Real.pi * (∑ j, (m j : ℝ) * Om j) - ∑ j, Sf j * Om j := by
            rw [Finset.mul_sum]
    have E2 : (2 * Real.pi * ∑ j,
          ((m j : ℝ) - (2 * Real.pi)⁻¹ *
              (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg))
            * kaiTBPair K (e j) y)
        = 2 * Real.pi * (∑ j, (m j : ℝ) * kaiTBPair K (e j) y)
          - ∑ j, (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg)
              * kaiTBPair K (e j) y :=
      E2gen
        (fun j => ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
            ((NumberField.mixedEmbedding K
                ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg)
        (fun j => kaiTBPair K (e j) y)
    have swap : (∑ j,
          (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
              ((NumberField.mixedEmbedding K
                  ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg)
            * kaiTBPair K (e j) y)
        = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
            (∑ j, kaiTBPair K (e j) y *
              ((NumberField.mixedEmbedding K
                  ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg) := by
      calc (∑ j,
            (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg)
              * kaiTBPair K (e j) y)
          = ∑ j, ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              (l p : ℝ) *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg
                * kaiTBPair K (e j) y :=
            Finset.sum_congr rfl (fun j _ => Finset.sum_mul _ _ _)
        _ = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ∑ j,
              (l p : ℝ) *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg
                * kaiTBPair K (e j) y := Finset.sum_comm
        _ = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
              (∑ j, kaiTBPair K (e j) y *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg) := by
            refine Finset.sum_congr rfl (fun p _ => ?_)
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl (fun j _ => by ring)
    have E3 : (2 * Real.pi * ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (l p : ℝ) * kaiTBTheta K H e p y)
        = (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              (l p : ℝ) * ((NumberField.mixedEmbedding K y).2 p).arg)
          - ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
              (∑ j, kaiTBPair K (e j) y *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg) := by
      have hpt : ∀ a b c : ℝ,
          2 * Real.pi * (a * ((2 * Real.pi)⁻¹ * (b - c))) = a * b - a * c := by
        intro a b c
        have h : 2 * Real.pi * (a * ((2 * Real.pi)⁻¹ * (b - c)))
            = 2 * Real.pi * (2 * Real.pi)⁻¹ * (a * (b - c)) := by ring
        rw [h, hTinv, one_mul, mul_sub]
      calc (2 * Real.pi * ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            (l p : ℝ) * kaiTBTheta K H e p y)
          = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              2 * Real.pi * ((l p : ℝ) * kaiTBTheta K H e p y) := Finset.mul_sum _ _ _
        _ = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ((l p : ℝ) * ((NumberField.mixedEmbedding K y).2 p).arg
                - (l p : ℝ) *
                    (∑ j, kaiTBPair K (e j) y *
                      ((NumberField.mixedEmbedding K
                          ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg)) :=
            Finset.sum_congr rfl (fun p _ => hpt ((l p : ℝ))
              (((NumberField.mixedEmbedding K y).2 p).arg)
              (∑ j, kaiTBPair K (e j) y *
                ((NumberField.mixedEmbedding K
                    ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg))
        _ = (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                (l p : ℝ) * ((NumberField.mixedEmbedding K y).2 p).arg)
              - ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p : ℝ) *
                  (∑ j, kaiTBPair K (e j) y *
                    ((NumberField.mixedEmbedding K
                        ((H j : NumberField.RingOfIntegers K) : K)).2 p).arg) := by
            rw [Finset.sum_sub_distrib]
    rw [hassoc, E1, E2, swap, mul_add, E3]
    ring
  
  have signDual : ∀ c : {w : NumberField.InfinitePlace K // w.IsReal} → ℂ,
      ((∀ i, c i = 1) →
          (∑ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
              ∏ i, (if η i then c i else 1))
            = (2 : ℂ) ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}) ∧
      (∀ i₀, c i₀ = -1 →
          (∑ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
              ∏ i, (if η i then c i else 1)) = 0) := by
    intro c
    have hcol : ∀ i, (∑ b : Bool, (if b then c i else 1 : ℂ)) = 1 + c i := by
      intro i
      rw [Fintype.sum_bool]
      simp [add_comm]
    have hps :
        (∏ i, ∑ b : Bool, (if b then c i else 1 : ℂ))
          = ∑ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
              ∏ i, (if η i then c i else 1) := by
      have h := Finset.prod_univ_sum
        (fun _ : {w : NumberField.InfinitePlace K // w.IsReal} => (Finset.univ : Finset Bool))
        (fun i (b : Bool) => (if b then c i else 1 : ℂ))
      rw [Fintype.piFinset_univ] at h
      exact h
    have h1 : (∑ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
        ∏ i, (if η i then c i else 1)) = ∏ i, (1 + c i) := by
      rw [← hps]
      exact Finset.prod_congr rfl (fun i _ => hcol i)
    refine ⟨?_, ?_⟩
    · intro hc
      rw [h1]
      calc (∏ i, (1 + c i))
          = ∏ _i : {w : NumberField.InfinitePlace K // w.IsReal}, (2 : ℂ) :=
            Finset.prod_congr rfl (fun i _ => by rw [hc i]; norm_num)
        _ = (2 : ℂ) ^ (Finset.univ :
              Finset {w : NumberField.InfinitePlace K // w.IsReal}).card :=
            Finset.prod_const _
        _ = (2 : ℂ) ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} := by
            rw [Finset.card_univ]
    · intro i₀ h
      rw [h1]
      refine Finset.prod_eq_zero (Finset.mem_univ i₀) ?_
      rw [h]
      ring
  
  have conjOrth : ∀ a b : ((NumberField.RingOfIntegers K ⧸ q)ˣ),
      (a = b → (∑ ξ ∈ Ξ, (starRingEnd ℂ) ((ξ a : ℂ)) * (ξ b : ℂ))
          = (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℂ)) ∧
      (a ≠ b → (∑ ξ ∈ Ξ, (starRingEnd ℂ) ((ξ a : ℂ)) * (ξ b : ℂ)) = 0) := by
    intro a b
    have key : ∀ ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle,
        (starRingEnd ℂ) ((ξ a : ℂ)) * (ξ b : ℂ) = ((ξ (a⁻¹ * b) : Circle) : ℂ) := by
      intro ξ
      rw [map_mul, Circle.coe_mul, map_inv, ← Circle.coe_inv_eq_conj]
    have hS : (∑ ξ ∈ Ξ, (starRingEnd ℂ) ((ξ a : ℂ)) * (ξ b : ℂ))
        = ∑ ξ ∈ Ξ, ((ξ (a⁻¹ * b) : Circle) : ℂ) :=
      Finset.sum_congr rfl (fun ξ _ => key ξ)
    constructor
    · intro hab
      rw [hS, hab, inv_mul_cancel b]
      simp only [map_one, Circle.coe_one, Finset.sum_const, Nat.smul_one_eq_cast, hΞcard]
    · intro hab
      rw [hS]
      exact hΞ0 (a⁻¹ * b) (fun h => hab (inv_mul_eq_one.mp h))
  
  by_cases hu : IsUnit (Ideal.Quotient.mk q z)
  · obtain ⟨hD1, hD2⟩ := conjOrth hα.unit hu.unit
    have hy0 : ((z : NumberField.RingOfIntegers K) : K) ≠ 0 :=
      NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hz
    have hane : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (NumberField.mixedEmbedding K
            ((z : NumberField.RingOfIntegers K) : K)).1 w ≠ 0 := by
      intro w hw0
      have h1 : NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K)
            (NumberField.mixedEmbedding K ((z : NumberField.RingOfIntegers K) : K))
          = (w : NumberField.InfinitePlace K)
              ((z : NumberField.RingOfIntegers K) : K) :=
        NumberField.mixedEmbedding.normAtPlace_apply _ _
      have h2 : NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K)
            (NumberField.mixedEmbedding K ((z : NumberField.RingOfIntegers K) : K))
          = ‖(NumberField.mixedEmbedding K
                ((z : NumberField.RingOfIntegers K) : K)).1 w‖ :=
        NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.prop _
      have h3 : (0 : ℝ) < (w : NumberField.InfinitePlace K)
            ((z : NumberField.RingOfIntegers K) : K) :=
        NumberField.InfinitePlace.pos_iff.mpr hy0
      rw [h1, hw0, norm_zero] at h2
      exact absurd h2 (ne_of_gt h3)
    have hsign : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (if sgn w then (1 : ℂ) else -1)
            * ((Real.sign ((NumberField.mixedEmbedding K
                  ((z : NumberField.RingOfIntegers K) : K)).1 w) : ℝ) : ℂ)
          = (if (if sgn w then
                    0 < (NumberField.mixedEmbedding K
                          ((z : NumberField.RingOfIntegers K) : K)).1 w
                  else (NumberField.mixedEmbedding K
                          ((z : NumberField.RingOfIntegers K) : K)).1 w < 0)
              then (1 : ℂ) else -1) := by
      intro w
      have key : ∀ a : ℝ, a ≠ 0 →
          (if sgn w then (1 : ℂ) else -1) * ((Real.sign a : ℝ) : ℂ)
            = (if (if sgn w then 0 < a else a < 0) then (1 : ℂ) else -1) := by
        intro a ha
        rcases lt_or_gt_of_ne ha with hlt | hgt
        · rw [Real.sign_of_neg hlt]
          by_cases hs : sgn w = true
          · norm_num [hs, not_lt.mpr hlt.le]
          · norm_num [hs, hlt]
        · rw [Real.sign_of_pos hgt]
          by_cases hs : sgn w = true
          · norm_num [hs, hgt]
          · norm_num [hs, not_lt.mpr hgt.le]
      exact key _ (hane w)
    obtain ⟨hS1, hS2⟩ := signDual
      (fun w => if (if sgn w then
              0 < (NumberField.mixedEmbedding K
                    ((z : NumberField.RingOfIntegers K) : K)).1 w
            else (NumberField.mixedEmbedding K
                    ((z : NumberField.RingOfIntegers K) : K)).1 w < 0)
          then (1 : ℂ) else -1)
    have hphase :
        Complex.exp (Complex.I *
            (∑ w : NumberField.InfinitePlace K,
              ((kaiLPFreqType K H e m l w : ℝ) : ℂ) * ((w.mult : ℝ) : ℂ) *
                ((Real.log (w ((z : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ)))
          * (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
              Complex.exp (Complex.I * ((l w : ℤ) : ℂ) *
                ((((NumberField.mixedEmbedding K
                    ((z : NumberField.RingOfIntegers K) : K)).2 w).arg : ℝ) : ℂ)))
          = Complex.exp (2 * Real.pi * Complex.I *
              ((((∑ j, (m j : ℝ)
                    * kaiTBPair K (e j) ((z : NumberField.RingOfIntegers K) : K))
                  + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                      (l p : ℝ)
                        * kaiTBTheta K H e p
                            ((z : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ)) := by
      rw [← Complex.exp_sum, ← Complex.exp_add]
      congr 1
      have hpull : (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            Complex.I * ((l p : ℤ) : ℂ) *
              ((((NumberField.mixedEmbedding K
                  ((z : NumberField.RingOfIntegers K) : K)).2 p).arg : ℝ) : ℂ))
          = Complex.I * ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              (((l p : ℤ) : ℂ) *
                ((((NumberField.mixedEmbedding K
                    ((z : NumberField.RingOfIntegers K) : K)).2 p).arg : ℝ) : ℂ)) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun p _ => (mul_assoc _ _ _))
      rw [hpull]
      have h1c : (((∑ w : NumberField.InfinitePlace K,
              kaiLPFreqType K H e m l w * (w.mult : ℝ)
                * Real.log (w ((z : NumberField.RingOfIntegers K) : K)))
            + (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                (l p : ℝ) * ((NumberField.mixedEmbedding K
                  ((z : NumberField.RingOfIntegers K) : K)).2 p).arg) : ℝ) : ℂ)
          = ((2 * Real.pi *
              ((∑ j, (m j : ℝ)
                  * kaiTBPair K (e j) ((z : NumberField.RingOfIntegers K) : K))
                + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                    (l p : ℝ)
                      * kaiTBTheta K H e p
                          ((z : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ) :=
        congrArg (fun r : ℝ => (r : ℂ))
          (phaseId ((z : NumberField.RingOfIntegers K) : K))
      push_cast at h1c ⊢
      linear_combination Complex.I * h1c
    have htw : ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η z
          = (ξ hu.unit : ℂ)
            * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                if η w then
                  ((Real.sign ((NumberField.mixedEmbedding K
                      ((z : NumberField.RingOfIntegers K) : K)).1 w) : ℝ) : ℂ)
                else 1)
            * Complex.exp (2 * Real.pi * Complex.I *
                ((((∑ j, (m j : ℝ)
                      * kaiTBPair K (e j) ((z : NumberField.RingOfIntegers K) : K))
                    + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                        (l p : ℝ)
                          * kaiTBTheta K H e p
                              ((z : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ)) := by
      intro ξ η
      simp only [kaiHeckeTwist, dif_pos hu]
      rw [← hphase]
      ring
    have hmerge : ∀ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
        (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then (if sgn w then (1 : ℂ) else -1) else 1)
          * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              if η w then
                ((Real.sign ((NumberField.mixedEmbedding K
                    ((z : NumberField.RingOfIntegers K) : K)).1 w) : ℝ) : ℂ)
              else 1)
          = ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              (if η w then
                  (if (if sgn w then
                          0 < (NumberField.mixedEmbedding K
                                ((z : NumberField.RingOfIntegers K) : K)).1 w
                        else (NumberField.mixedEmbedding K
                                ((z : NumberField.RingOfIntegers K) : K)).1 w < 0)
                    then (1 : ℂ) else -1)
                else 1) := by
      intro η
      rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      by_cases hη : η w
      · rw [if_pos hη, if_pos hη, if_pos hη]
        exact hsign w
      · rw [if_neg hη, if_neg hη, if_neg hη, one_mul]
    have hRHS :
        (∑ ξ ∈ Ξ, ∑ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
            (starRingEnd ℂ) ((ξ hα.unit : ℂ))
              * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                  if η w then (if sgn w then (1 : ℂ) else -1) else 1)
              * kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η z)
          = Complex.exp (2 * Real.pi * Complex.I *
                ((((∑ j, (m j : ℝ)
                      * kaiTBPair K (e j) ((z : NumberField.RingOfIntegers K) : K))
                    + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                        (l p : ℝ)
                          * kaiTBTheta K H e p
                              ((z : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ))
            * ((∑ ξ ∈ Ξ, (starRingEnd ℂ) ((ξ hα.unit : ℂ)) * (ξ hu.unit : ℂ))
              * (∑ η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
                  ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                    (if η w then
                        (if (if sgn w then
                                0 < (NumberField.mixedEmbedding K
                                      ((z : NumberField.RingOfIntegers K) : K)).1 w
                              else (NumberField.mixedEmbedding K
                                      ((z : NumberField.RingOfIntegers K) : K)).1 w < 0)
                          then (1 : ℂ) else -1)
                      else 1))) := by
      rw [Finset.sum_mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun ξ _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun η _ => ?_)
      rw [htw ξ η, ← hmerge η]
      ring
    have hunit : (hα.unit = hu.unit) ↔ (z - α ∈ q) := by
      rw [Units.ext_iff, IsUnit.unit_spec, IsUnit.unit_spec, eq_comm,
        Ideal.Quotient.eq]
    rw [hRHS]
    by_cases hres : z - α ∈ q
    · by_cases hsig : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (if sgn w then
              0 < (NumberField.mixedEmbedding K
                    ((z : NumberField.RingOfIntegers K) : K)).1 w
            else (NumberField.mixedEmbedding K
                    ((z : NumberField.RingOfIntegers K) : K)).1 w < 0)
      · have hR : kaiLPResSgn K q α sgn z = 1 := by
          simp only [kaiLPResSgn]
          exact if_pos ⟨hres, hsig⟩
        rw [hD1 (hunit.mpr hres), hS1 (fun w => if_pos (hsig w)), hR]
        push_cast
        ring
      · rw [not_forall] at hsig
        obtain ⟨w₀, hw₀⟩ := hsig
        have hR : kaiLPResSgn K q α sgn z = 0 := by
          simp only [kaiLPResSgn]
          exact if_neg (fun h => hw₀ (h.2 w₀))
        rw [hS2 w₀ (if_neg hw₀), hR]
        simp
    · have hne : hα.unit ≠ hu.unit := fun h => hres (hunit.mp h)
      have hR : kaiLPResSgn K q α sgn z = 0 := by
        simp only [kaiLPResSgn]
        exact if_neg (fun h => hres h.1)
      rw [hD2 hne, hR]
      simp
  · have hzero : ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η z = 0 := by
      intro ξ η
      simp only [kaiHeckeTwist, dif_neg hu]
    have hR : kaiLPResSgn K q α sgn z = 0 := by
      simp only [kaiLPResSgn]
      refine if_neg ?_
      rintro ⟨h1, -⟩
      exact hu (by rw [Ideal.Quotient.eq.mpr h1]; exact hα)
    simp [hR, hzero]

theorem kai_lp_tb_fourier_expansion (K : Type u) [Field K] [NumberField K]
