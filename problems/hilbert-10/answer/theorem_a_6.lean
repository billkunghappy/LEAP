            * (Real.exp (Real.log M ^ ((1:ℝ)/2)) * M ^ (-(3:ℝ)/4)
              + Real.exp (-(c * Real.log M ^ ((2:ℝ)/3))))
          ≤ Cs * κ * (Real.exp (2 * Real.log M ^ ((1:ℝ)/3)) * S) := by
        rw [mul_assoc (Cs * κ)]
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul hNq'E hYS (by positivity) (Real.exp_pos _).le) (mul_nonneg hCs hκ0)
      have i2 : 2 * κ * Real.exp (-(Real.log M ^ ((1:ℝ)/2)) / 2)
          ≤ 2 * κ * (Real.exp (2 * Real.log M ^ ((1:ℝ)/3)) * S) :=
        mul_le_mul_of_nonneg_left (hYqS.trans hSES) (by linarith)
      have i3 := mul_le_mul_of_nonneg_left (add_le_add i1 i2) (mul_nonneg hC' hXn0)
      rw [hSBdef, hFdef]
      refine hB.trans ?_
      linarith [i3]
  
  have hKc : κ * Real.exp (2 * Real.log M ^ ((1:ℝ)/3)) * S
      ≤ K₀ * Real.exp (-(Real.log M ^ ((1:ℝ)/200))) := by
    have h := hNum M hM
    rw [← hSdef] at h
    refine le_trans ?_ h
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hκle (Real.exp_pos _).le) hS0
  rw [hsplit, hBcard]
  have habs : |ρ * SA - ρ * SB| ≤ ρ * |SA| + ρ * |SB| := by
    refine (abs_sub _ _).trans ?_
    rw [abs_mul, abs_mul, abs_of_nonneg hρ]
  have f1 := mul_le_mul_of_nonneg_left hSA hρ
  have f2 := mul_le_mul_of_nonneg_left hSB hρ
  have f3 := mul_le_mul_of_nonneg_left hKc (mul_nonneg (mul_nonneg hρ hD0) hXn0)
  linarith [habs, f1, f2, f3]

theorem kai_siegel_datum_step0 (K : Type u) [Field K] [NumberField K] :
    ∃ ρ : ℝ, 0 < ρ ∧
    ∃ D : ℝ → ℕ → Ideal (NumberField.RingOfIntegers K) ×
        (NumberField.RingOfIntegers K → ℤ) × ℝ,
      (∀ (M : ℝ) (m : ℕ), IsSiegelDatum m (D M m)) ∧
      (∀ A : ℕ, ∃ cA : ℝ, 0 < cA ∧
        ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
          Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
          (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
          (D M m).2.1 ≠ 0 →
          cA * Real.log M ^ A ≤ (Ideal.absNorm (D M m).1 : ℝ)) ∧
      (∀ (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ
            (NumberField.RingOfIntegers K)),
        IsNormLengthCompatible C ω →
        ∃ c₁ C₁ : ℝ, 0 < c₁ ∧ 0 ≤ C₁ ∧
          ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
            Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
            (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
            ∀ (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet Ω → Convex ℝ Ω →
            ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
              (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₁) →
            ∀ a : NumberField.RingOfIntegers K,
              |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                    (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧ x - a ∈ 𝔮)
                    (fun _ => Classical.propDecidable _) (omegaBox ω M),
                  (vonMangoldtO x
                    - siegelModel K ρ (primorial m) (D M m).2.1 (D M m).2.2 x)|
                ≤ C₁ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ c₁))) :=
by
  letI : Fintype {w : NumberField.InfinitePlace K // w.IsReal} := Fintype.ofFinite _
  letI : Fintype {w : NumberField.InfinitePlace K // w.IsComplex} := Fintype.ofFinite _
  obtain ⟨B₀, hB₀, hB₀h, 𝔮F, ψF, βF, lamF, hprop, hsieg⟩ := kai_exceptional_datum K
  obtain ⟨ρ, hρ, hPrime⟩ := kai_prime_side_siegel_pnt K B₀ hB₀ hB₀h
  
  have hrange : ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
      Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
      1 ≤ Real.log M ∧ (3 : ℝ) ≤ (m : ℝ) ∧ Real.log M ^ ((1:ℝ)/100) ≤ Real.log (m : ℝ) := by
    intro M m hM h1
    have hMpos : (0:ℝ) < M := by linarith
    have hl : 1 ≤ Real.log M := by
      rw [Real.le_log_iff_exp_le hMpos]
      have := Real.exp_one_lt_d9
      linarith
    have hr1 : 1 ≤ Real.log M ^ ((1:ℝ)/100) := Real.one_le_rpow hl (by norm_num)
    have he : Real.exp 1 ≤ (m : ℝ) := (Real.exp_le_exp.2 hr1).trans h1
    have he2 : (2:ℝ) < m := by have := Real.exp_one_gt_d9; linarith
    have hm2 : 2 < m := by exact_mod_cast he2
    have hm3 : (3:ℝ) ≤ m := by exact_mod_cast (show 3 ≤ m by omega)
    refine ⟨hl, hm3, ?_⟩
    have := Real.log_le_log (Real.exp_pos _) h1
    rwa [Real.log_exp] at this
  
  have hprimes : ∀ (m : ℕ) (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
      (Ideal.absNorm 𝔮 : ℝ) ≤ (m : ℝ) →
      ∀ 𝔭 : Ideal (NumberField.RingOfIntegers K), 𝔭.IsPrime → 𝔮 ≤ 𝔭 →
        ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 := by
    intro m 𝔮 h𝔮 hN 𝔭 h𝔭 hle
    have hdvd : Ideal.absNorm 𝔭 ∣ Ideal.absNorm 𝔮 := Ideal.absNorm_dvd_absNorm_of_le hle
    have hq0 : Ideal.absNorm 𝔮 ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact h𝔮
    have hkm : Ideal.absNorm 𝔭 ≤ m := by
      have h1 : Ideal.absNorm 𝔭 ≤ Ideal.absNorm 𝔮 :=
        Nat.le_of_dvd (Nat.pos_of_ne_zero hq0) hdvd
      have h2 : Ideal.absNorm 𝔮 ≤ m := by exact_mod_cast hN
      omega
    have hk1 : Ideal.absNorm 𝔭 ≠ 1 := by
      rw [Ne, Ideal.absNorm_eq_one_iff]; exact h𝔭.ne_top
    have hk0 : Ideal.absNorm 𝔭 ≠ 0 := by
      intro h0
      rw [h0] at hdvd
      exact hq0 (zero_dvd_iff.1 hdvd)
    have hkmem : ((Ideal.absNorm 𝔭 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 :=
      Ideal.absNorm_mem 𝔭
    have claim : ∀ j : ℕ, j ≠ 1 → ((j : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 → j ≠ 0 →
        ∃ p : ℕ, p.Prime ∧ p ≤ j ∧ ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 := by
      intro j
      induction j using Nat.strong_induction_on with
      | _ j ih =>
        intro hj1 hjmem hj0
        have hp := Nat.minFac_prime hj1
        obtain ⟨c, hc⟩ := Nat.minFac_dvd j
        have hmul : ((j.minFac : ℕ) : NumberField.RingOfIntegers K)
            * ((c : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭 := by
          rw [← Nat.cast_mul, ← hc]; exact hjmem
        rcases h𝔭.mem_or_mem hmul with h | h
        · exact ⟨j.minFac, hp, Nat.minFac_le (Nat.pos_of_ne_zero hj0), h⟩
        · have hc0 : c ≠ 0 := by
            rintro rfl
            rw [mul_zero] at hc
            exact hj0 hc
          have hc1 : c ≠ 1 := by
            rintro rfl
            rw [Nat.cast_one] at h
            exact h𝔭.ne_top ((Ideal.eq_top_iff_one _).2 h)
          have hclt : c < j := by
            have h2 := hp.two_le
            have hcpos := Nat.pos_of_ne_zero hc0
            nlinarith
          obtain ⟨p, hp', hpc, hpmem⟩ := ih c hclt hc1 h hc0
          exact ⟨p, hp', hpc.trans hclt.le, hpmem⟩
    obtain ⟨p, hp, hpk, hpmem⟩ := claim _ hk1 hkmem hk0
    have hdv : p ∣ primorial m := by
      unfold primorial
      exact Finset.dvd_prod_of_mem _
        (Finset.mem_filter.2 ⟨Finset.mem_range.2 (by omega), hp⟩)
    obtain ⟨c, hc⟩ := hdv
    rw [hc, Nat.cast_mul]
    exact Ideal.mul_mem_right _ _ hpmem
  
  obtain ⟨D, hD⟩ : ∃ D : ℝ → ℕ → Ideal (NumberField.RingOfIntegers K) ×
        (NumberField.RingOfIntegers K → ℤ) × ℝ,
      D = fun (_ : ℝ) (m : ℕ) =>
        if (3 : ℝ) ≤ (m : ℝ) then (𝔮F (m : ℝ), ψF (m : ℝ), βF (m : ℝ)) else (⊤, 0, 1 / 2) :=
    ⟨_, rfl⟩
  have hD3 : ∀ (M : ℝ) (m : ℕ), (3 : ℝ) ≤ (m : ℝ) →
      D M m = (𝔮F (m : ℝ), ψF (m : ℝ), βF (m : ℝ)) := by
    intro M m h
    rw [hD]
    exact if_pos h
  have hDi : ∀ (M : ℝ) (m : ℕ), IsSiegelDatum m (D M m) := by
    intro M m
    by_cases h : (3 : ℝ) ≤ (m : ℝ)
    · rw [hD3 M m h]
      obtain ⟨h𝔮, hψ, -⟩ := hprop (m : ℝ) h
      unfold IsSiegelDatum
      refine ⟨h𝔮, ?_⟩
      rcases hψ with h0 | ⟨hR, hN, hβ1, hβ2, -⟩
      · exact Or.inl h0
      · refine Or.inr ⟨hR, ?_, hβ2, hN, hprimes m (𝔮F (m : ℝ)) h𝔮 hN⟩
        have hlog3 : 1 < Real.log (3:ℝ) := by
          rw [Real.lt_log_iff_exp_lt (by norm_num)]
          have := Real.exp_one_lt_d9
          linarith
        have hlogm : Real.log 3 ≤ Real.log (m : ℝ) := Real.log_le_log (by norm_num) h
        have hdiv : B₀ / Real.log (m : ℝ) ≤ B₀ := div_le_self hB₀.le (by linarith)
        show (1 / 2 : ℝ) ≤ βF (m : ℝ)
        linarith
    · have h' : D M m = (⊤, 0, 1 / 2) := by
        rw [hD]
        exact if_neg h
      rw [h']
      exact ⟨top_ne_bot, Or.inl rfl⟩
  
  have hDii : ∀ A : ℕ, ∃ cA : ℝ, 0 < cA ∧
      ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
        Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
        (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
        (D M m).2.1 ≠ 0 →
        cA * Real.log M ^ A ≤ (Ideal.absNorm (D M m).1 : ℝ) := by
    intro A
    obtain ⟨cA, hcA, h⟩ := hsieg (100 * A)
    refine ⟨cA, hcA, ?_⟩
    intro M m hM h1 _ hψ
    obtain ⟨hl, hm3, hlm⟩ := hrange M m hM h1
    rw [hD3 M m hm3] at hψ ⊢
    have hb := h (m : ℝ) hm3 hψ
    have hl0 : (0:ℝ) ≤ Real.log M := by linarith
    have hpow : Real.log M ^ A ≤ Real.log (m : ℝ) ^ (100 * A) := by
      have heq : Real.log M ^ A = (Real.log M ^ ((1:ℝ)/100)) ^ (100 * A) := by
        rw [← Real.rpow_natCast (Real.log M ^ ((1:ℝ)/100)), ← Real.rpow_mul hl0,
          ← Real.rpow_natCast]
        congr 1
        push_cast
        ring
      rw [heq]
      exact pow_le_pow_left₀ (Real.rpow_nonneg hl0 _) hlm _
    calc cA * Real.log M ^ A ≤ cA * Real.log (m : ℝ) ^ (100 * A) :=
          mul_le_mul_of_nonneg_left hpow hcA.le
      _ ≤ _ := hb
  
  refine ⟨ρ, hρ, D, hDi, hDii, ?_⟩
  intro C ω hω
  obtain ⟨c₃, C₃, hc₃, hC₃, hP⟩ := hPrime C ω hω
  obtain ⟨c₂, C₂, hc₂, hC₂, hS⟩ := kai_qmodel_sieve_comparison K ρ hρ.le C ω hω
  refine ⟨min c₃ c₂, C₃ + C₂, lt_min hc₃ hc₂, add_nonneg hC₃ hC₂, ?_⟩
  intro M m hM h1 h2 Ω hΩm hΩc 𝔮 h𝔮 hN a
  obtain ⟨hl, hm3, -⟩ := hrange M m hM h1
  have hle3 : Real.log M ^ (min c₃ c₂) ≤ Real.log M ^ c₃ :=
    Real.rpow_le_rpow_of_exponent_le hl (min_le_left _ _)
  have hle2 : Real.log M ^ (min c₃ c₂) ≤ Real.log M ^ c₂ :=
    Real.rpow_le_rpow_of_exponent_le hl (min_le_right _ _)
  have hN3 : (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₃) :=
    hN.trans (Real.exp_le_exp.2 hle3)
  have hN2 : (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₂) :=
    hN.trans (Real.exp_le_exp.2 hle2)
  have hDi' : IsSiegelDatum m (𝔮F (m : ℝ), ψF (m : ℝ), βF (m : ℝ)) := by
    have := hDi M m
    rwa [hD3 M m hm3] at this
  have hPb := hP M m hM h1 h2 (𝔮F (m : ℝ)) (ψF (m : ℝ)) (βF (m : ℝ)) (lamF (m : ℝ))
    (hprop (m : ℝ) hm3) Ω hΩm hΩc 𝔮 h𝔮 hN3 a
  have hSb := hS M m hM h1 h2 (𝔮F (m : ℝ), ψF (m : ℝ), βF (m : ℝ)) hDi' Ω hΩm hΩc 𝔮 h𝔮 hN2 a
  have key : ∀ (S : Finset (NumberField.RingOfIntegers K))
      (f g q : NumberField.RingOfIntegers K → ℝ) (E₁ E₂ : ℝ),
      |∑ x ∈ S, (f x - q x)| ≤ E₁ → |∑ x ∈ S, (g x - q x)| ≤ E₂ →
      |∑ x ∈ S, (f x - g x)| ≤ E₁ + E₂ := by
    intro S f g q E₁ E₂ h₁ h₂
    have hs : ∑ x ∈ S, (f x - g x) = ∑ x ∈ S, (f x - q x) - ∑ x ∈ S, (g x - q x) := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun x _ => by ring)
    rw [hs]
    exact (abs_sub _ _).trans (add_le_add h₁ h₂)
  rw [hD3 M m hm3]
  refine (key _ vonMangoldtO (siegelModel K ρ (primorial m) (ψF (m : ℝ)) (βF (m : ℝ)))
    (qSiegelModel K ρ 𝔮 (𝔮F (m : ℝ)) (ψF (m : ℝ)) (βF (m : ℝ))) _ _ hPb hSb).trans ?_
  have he3 : Real.exp (-(Real.log M ^ c₃)) ≤ Real.exp (-(Real.log M ^ min c₃ c₂)) :=
    Real.exp_le_exp.2 (neg_le_neg hle3)
  have he2 : Real.exp (-(Real.log M ^ c₂)) ≤ Real.exp (-(Real.log M ^ min c₃ c₂)) :=
    Real.exp_le_exp.2 (neg_le_neg hle2)
  have hB0 : (0:ℝ) ≤ ((omegaBox ω M).card : ℝ) := Nat.cast_nonneg _
  have t3 := mul_le_mul_of_nonneg_left he3 (mul_nonneg hC₃ hB0)
  have t2 := mul_le_mul_of_nonneg_left he2 (mul_nonneg hC₂ hB0)
  have hring : (C₃ + C₂) * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ min c₃ c₂))
      = C₃ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ min c₃ c₂))
        + C₂ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ min c₃ c₂)) := by ring
  rw [hring]
  linarith

theorem gowersU3Pow_finset_sum_le {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) {ι : Type*}
    (I : Finset ι) (g : ι → NumberField.RingOfIntegers K → ℝ) (k : ℕ) (hI : I.card ≤ 2 ^ k)
    (B : ℝ) (hB : 0 ≤ B) (hg : ∀ i ∈ I, gowersU3Pow ω (g i) M ≤ B) :
    gowersU3Pow ω (fun x => ∑ i ∈ I, g i x) M ≤ 256 ^ k * B :=
by
  classical
  induction k generalizing I with
  | zero =>
    rw [pow_zero] at hI
    rw [pow_zero, one_mul]
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hI with h0 | h1
    · rw [Finset.card_eq_zero] at h0
      subst h0
      have hz : (fun x => ∑ i ∈ (∅ : Finset ι), g i x) = fun _ => (0 : ℝ) := by
        funext x; simp
      rw [hz]
      have h := (gowersU3Pow_smul_sup ω (fun _ => (0 : ℝ)) M).2 0 le_rfl
        (fun x _ => by simp)
      have h8 : (27 : ℝ) ^ ν * (0 : ℝ) ^ 8 = 0 := by norm_num
      rw [h8] at h
      linarith
    · obtain ⟨a, rfl⟩ := Finset.card_eq_one.mp h1
      have hz : (fun x => ∑ i ∈ ({a} : Finset ι), g i x) = g a := by
        funext x; simp
      rw [hz]
      exact hg a (Finset.mem_singleton_self a)
  | succ k ih =>
    obtain ⟨s, hsJ, hscard⟩ := Finset.exists_subset_card_eq (min_le_left I.card (2 ^ k))
    have hcard := Finset.card_sdiff_add_card_eq_card hsJ
    have hpow : 2 ^ (k + 1) = 2 * 2 ^ k := by rw [pow_succ]; ring
    have hs_le : s.card ≤ 2 ^ k := by rw [hscard]; exact min_le_right _ _
    have ht_le : (I \ s).card ≤ 2 ^ k := by
      rw [hpow] at hI
      rcases le_total I.card (2 ^ k) with h | h
      · rw [min_eq_left h] at hscard; omega
      · rw [min_eq_right h] at hscard; omega
    have hs := ih s hs_le (fun i hi => hg i (hsJ hi))
    have ht := ih (I \ s) ht_le (fun i hi => hg i (Finset.sdiff_subset hi))
    have hsplit : (fun x => ∑ i ∈ I, g i x)
        = fun x => (fun y => ∑ i ∈ s, g i y) x + (fun y => ∑ i ∈ I \ s, g i y) x := by
      funext x
      simp only
      rw [← Finset.sum_sdiff hsJ, add_comm]
    rw [hsplit]
    have htri := (gowersU3Pow_nonneg_add_le ω (fun y => ∑ i ∈ s, g i y)
      (fun y => ∑ i ∈ I \ s, g i y) M).2
    calc _ ≤ 128 * (gowersU3Pow ω (fun y => ∑ i ∈ s, g i y) M
          + gowersU3Pow ω (fun y => ∑ i ∈ I \ s, g i y) M) := htri
      _ ≤ 128 * (256 ^ k * B + 256 ^ k * B) := by linarith
      _ = 256 ^ (k + 1) * B := by rw [pow_succ]; ring

theorem kai_norm_cutoff_line_intervals (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M Y : ℝ) (o : KaiPattern K) :
    KaiLineProp ω (kaiCutoffSet ω M Y o) (2 * Module.finrank ℚ K + 1) :=
by
  classical
  
  have s4 : ∀ (Q : Polynomial ℝ) (D : Finset ℤ),
      (∀ t ∈ D, Q.eval (t : ℝ) ≤ 0 ∧ 0 < Q.eval ((t : ℝ) - 1)) → D.card ≤ Q.natDegree := by
    intro Q D hD
    have hroot : ∀ t ∈ D, ∃ r : ℝ, (t:ℝ) - 1 < r ∧ r ≤ t ∧ Q.eval r = 0 := by
      intro t ht
      obtain ⟨h1, h2⟩ := hD t ht
      have hcont : ContinuousOn (fun s => Q.eval s) (Set.Icc ((t:ℝ)-1) t) := Q.continuousOn
      obtain ⟨r, ⟨hr1, hr2⟩, hr⟩ :=
        intermediate_value_Icc' (by linarith : (t:ℝ) - 1 ≤ t) hcont ⟨h1, h2.le⟩
      refine ⟨r, ?_, hr2, hr⟩
      rcases eq_or_lt_of_le hr1 with h | h
      · rw [← h] at hr; linarith
      · exact h
    choose! f hf using hroot
    by_cases hne : D = ∅
    · simp [hne]
    obtain ⟨t₀, ht₀⟩ := Finset.nonempty_iff_ne_empty.mpr hne
    have hQ : Q ≠ 0 := by
      intro h; have := (hD t₀ ht₀).2; rw [h] at this; simp at this
    calc D.card ≤ Q.roots.toFinset.card := by
          apply Finset.card_le_card_of_injOn f
          · intro t ht
            have : f t ∈ Q.roots := (Polynomial.mem_roots hQ).2 (hf t ht).2.2
            exact Multiset.mem_toFinset.2 this
          · intro t₁ ht₁ t₂ ht₂ h
            have a := hf t₁ ht₁
            have b := hf t₂ ht₂
            have h1 : (t₁:ℝ) < t₂ + 1 := by linarith [a.1, b.2.1, h]
            have h2 : (t₂:ℝ) < t₁ + 1 := by linarith [a.2.1, b.1, h]
            have h1' : t₁ < t₂ + 1 := by exact_mod_cast h1
            have h2' : t₂ < t₁ + 1 := by exact_mod_cast h2
            omega
      _ ≤ Q.roots.card := Multiset.toFinset_card_le _
      _ ≤ Q.natDegree := Polynomial.card_roots' Q
  
  have s5 : ∀ T : Finset ℤ, ∃ I : Finset (ℤ × ℤ),
      I.card ≤ (T.filter (fun t => t - 1 ∉ T)).card ∧
      ∀ t : ℤ, t ∈ T ↔ ∃ p ∈ I, p.1 ≤ t ∧ t ≤ p.2 := by
    intro T
    let R : ℤ → Finset ℤ := fun a => T.filter (fun s => a ≤ s ∧ ∀ u ∈ Finset.Icc a s, u ∈ T)
    let b : ℤ → ℤ := fun a => if h : (R a).Nonempty then (R a).max' h else a
    refine ⟨(T.filter (fun t => t - 1 ∉ T)).image (fun a => (a, b a)), Finset.card_image_le, ?_⟩
    intro t
    constructor
    · intro ht
      let G := T.filter (fun u => u ≤ t ∧ ∀ v ∈ Finset.Icc u t, v ∈ T)
      have htG : t ∈ G := by
        simp only [G, Finset.mem_filter]
        refine ⟨ht, le_rfl, ?_⟩
        intro v hv
        rw [Finset.mem_Icc] at hv
        rw [le_antisymm hv.2 hv.1]; exact ht
      have hGne : G.Nonempty := ⟨t, htG⟩
      obtain ⟨a, ha_def⟩ : ∃ a, a = G.min' hGne := ⟨_, rfl⟩
      have haG : a ∈ G := by rw [ha_def]; exact Finset.min'_mem G hGne
      simp only [G, Finset.mem_filter] at haG
      obtain ⟨haT, hat, haIcc⟩ := haG
      have ha1 : a - 1 ∉ T := by
        intro h
        have hmem : a - 1 ∈ G := by
          simp only [G, Finset.mem_filter]
          refine ⟨h, by omega, ?_⟩
          intro v hv
          rw [Finset.mem_Icc] at hv
          by_cases hva : v = a - 1
          · rw [hva]; exact h
          · exact haIcc v (Finset.mem_Icc.2 ⟨by omega, hv.2⟩)
        have := Finset.min'_le G (a - 1) hmem
        rw [← ha_def] at this
        omega
      have htR : t ∈ R a := by
        simp only [R, Finset.mem_filter]
        exact ⟨ht, hat, haIcc⟩
      have hRne : (R a).Nonempty := ⟨t, htR⟩
      refine ⟨(a, b a), Finset.mem_image.2 ⟨a, Finset.mem_filter.2 ⟨haT, ha1⟩, rfl⟩, hat, ?_⟩
      show t ≤ b a
      simp only [b, dif_pos hRne]
      exact Finset.le_max' _ t htR
    · rintro ⟨p, hp, h1, h2⟩
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 hp
      obtain ⟨haT, -⟩ := Finset.mem_filter.1 ha
      have haR : a ∈ R a := by
        simp only [R, Finset.mem_filter]
        refine ⟨haT, le_rfl, ?_⟩
        intro u hu; rw [Finset.mem_Icc] at hu
        rw [le_antisymm hu.2 hu.1]; exact haT
      have hRne : (R a).Nonempty := ⟨a, haR⟩
      have hb : b a ∈ R a := by
        simp only [b, dif_pos hRne]; exact Finset.max'_mem _ _
      simp only [R, Finset.mem_filter] at hb
      exact hb.2.2 t (Finset.mem_Icc.2 ⟨h1, h2⟩)
  
  have s7 : ∀ (T : Finset ℤ) (C R : ℤ → Prop) [DecidablePred R] [DecidablePred C],
      (∀ t, t ∈ T ↔ C t ∧ R t) → (∀ a t b : ℤ, a ≤ t → t ≤ b → C a → C b → C t) →
      (T.filter (fun t => t - 1 ∉ T)).card ≤ 1 + (T.filter (fun t => ¬ R (t - 1))).card := by
    intro T C R _ _ h1 h2
    have hsub : T.filter (fun t => t - 1 ∉ T) ⊆
        T.filter (fun t => ¬ C (t - 1)) ∪ T.filter (fun t => ¬ R (t - 1)) := by
      intro t ht
      rw [Finset.mem_filter] at ht
      rw [Finset.mem_union, Finset.mem_filter, Finset.mem_filter]
      by_cases hC : C (t - 1)
      · right; exact ⟨ht.1, fun hR => ht.2 ((h1 _).2 ⟨hC, hR⟩)⟩
      · left; exact ⟨ht.1, hC⟩
    have hA : (T.filter (fun t => ¬ C (t - 1))).card ≤ 1 := by
      rw [Finset.card_le_one]
      intro t₁ ht₁ t₂ ht₂
      rw [Finset.mem_filter] at ht₁ ht₂
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · exact ht₂.2 (h2 t₁ (t₂ - 1) t₂ (by omega) (by omega) ((h1 _).1 ht₁.1).1
          ((h1 _).1 ht₂.1).1)
      · exact ht₁.2 (h2 t₂ (t₁ - 1) t₁ (by omega) (by omega) ((h1 _).1 ht₂.1).1
          ((h1 _).1 ht₁.1).1)
    calc _ ≤ (T.filter (fun t => ¬ C (t - 1)) ∪ T.filter (fun t => ¬ R (t - 1))).card :=
          Finset.card_le_card hsub
      _ ≤ _ := Finset.card_union_le _ _
      _ ≤ _ := by omega
  
  have s3 : ∀ x y : NumberField.RingOfIntegers K, ∃ p : Polynomial ℤ,
      p.natDegree ≤ Module.finrank ℚ K ∧ ∀ t : ℤ, p.eval t = Algebra.norm ℤ (x + t • y) := by
    intro x y
    refine ⟨((Polynomial.X : Polynomial ℤ) • (Algebra.leftMulMatrix ω y).map Polynomial.C
      + (Algebra.leftMulMatrix ω x).map Polynomial.C).det, ?_, ?_⟩
    · have := Polynomial.natDegree_det_X_add_C_le (Algebra.leftMulMatrix ω y)
        (Algebra.leftMulMatrix ω x)
      simpa using this
    · intro t
      rw [Algebra.norm_eq_matrix_det ω, map_add, map_zsmul]
      rw [← Polynomial.coe_evalRingHom, RingHom.map_det]
      congr 1
      ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply,
        smul_eq_mul, Polynomial.coe_evalRingHom, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_X, Polynomial.eval_C]
      ring
  
  have s1 : ∀ y : NumberField.RingOfIntegers K,
      y ∈ omegaBox ω M ↔ ∀ j, -(⌊M⌋₊ : ℤ) ≤ ω.repr y j ∧ ω.repr y j ≤ (⌊M⌋₊ : ℤ) := by
    intro y
    simp only [omegaBox, intBox, Finset.mem_image, Finset.mem_Icc]
    constructor
    · rintro ⟨v, ⟨hv1, hv2⟩, rfl⟩ j
      have := congrFun (ω.equivFun.apply_symm_apply v) j
      rw [Module.Basis.equivFun_apply] at this
      rw [this]
      exact ⟨hv1 j, hv2 j⟩
    · intro h
      refine ⟨ω.equivFun y, ⟨fun j => ?_, fun j => ?_⟩, ω.equivFun.symm_apply_apply y⟩
      · simp only [Module.Basis.equivFun_apply]; exact (h j).1
      · simp only [Module.Basis.equivFun_apply]; exact (h j).2
  have s1b : ∀ (x : NumberField.RingOfIntegers K) (k j : Fin (Module.finrank ℚ K)) (t : ℤ),
      ω.repr (x + t • ω k) j = ω.repr x j + if j = k then t else 0 := by
    intro x k j t
    rw [map_add, map_zsmul, Module.Basis.repr_self]
    by_cases hjk : j = k
    · subst hjk; simp
    · simp [hjk]
  
  have s2 : ∀ (x v : NumberField.RingOfIntegers K) (a t b : ℤ), a ≤ t → t ≤ b →
      kaiPatt o (x + a • v) → kaiPatt o (x + b • v) → kaiPatt o (x + t • v) := by
    intro x v a t b hat htb ha hb w
    have hg : ∀ s : ℤ, NumberField.InfinitePlace.embedding_of_isReal w.2
        ((x + s • v : NumberField.RingOfIntegers K) : K)
        = NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K)
          + (s : ℝ) * NumberField.InfinitePlace.embedding_of_isReal w.2 (v : K) := by
      intro s
      simp
    have hwa := ha w
    have hwb := hb w
    rw [hg] at hwa hwb ⊢
    have hat' : (a : ℝ) ≤ t := by exact_mod_cast hat
    have htb' : (t : ℝ) ≤ b := by exact_mod_cast htb
    set α := NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K)
    set β := NumberField.InfinitePlace.embedding_of_isReal w.2 (v : K)
    cases hw : o w
    · rw [hw] at hwa hwb
      simp only [Bool.false_eq_true, iff_false, not_lt] at hwa hwb ⊢
      rcases eq_or_lt_of_le hat' with h | h
      · rw [← h]; exact hwa
      · nlinarith
    · rw [hw] at hwa hwb
      simp only [iff_true] at hwa hwb ⊢
      rcases eq_or_lt_of_le hat' with h | h
      · rw [← h]; exact hwa
      · nlinarith
  
  intro x k
  let C : ℤ → Prop := fun s => x + s • ω k ∈ omegaBox ω M ∧ kaiPatt o (x + s • ω k)
  let R : ℤ → Prop := fun s => ((Algebra.norm ℤ (x + s • ω k)).natAbs : ℝ) ≤ Y
  have hS : ∀ s : ℤ, x + s • ω k ∈ kaiCutoffSet ω M Y o ↔ C s ∧ R s := by
    intro s
    simp only [kaiCutoffSet, Set.mem_setOf_eq, C, R]
    tauto
  let T : Finset ℤ := (Finset.Icc (-(⌊M⌋₊ : ℤ) - ω.repr x k) ((⌊M⌋₊ : ℤ) - ω.repr x k)).filter
    (fun s => x + s • ω k ∈ kaiCutoffSet ω M Y o)
  have h1 : ∀ s, s ∈ T ↔ C s ∧ R s := by
    intro s
    rw [← hS]
    simp only [T, Finset.mem_filter, Finset.mem_Icc]
    constructor
    · exact fun h => h.2
    · intro h
      refine ⟨?_, h⟩
      have hb := (s1 (x + s • ω k)).1 ((hS s).1 h).1.1 k
      rw [s1b, if_pos rfl] at hb
      omega
  have h2 : ∀ a t b : ℤ, a ≤ t → t ≤ b → C a → C b → C t := by
    intro a t b hat htb ha hb
    refine ⟨?_, s2 x (ω k) a t b hat htb ha.2 hb.2⟩
    rw [s1]
    intro j
    have ha' := (s1 _).1 ha.1 j
    have hb' := (s1 _).1 hb.1 j
    rw [s1b] at ha' hb' ⊢
    by_cases hjk : j = k
    · simp only [if_pos hjk] at ha' hb' ⊢; omega
    · simp only [if_neg hjk] at ha' hb' ⊢; exact ha'
  obtain ⟨I, hIcard, hI⟩ := s5 T
  refine ⟨I, ?_, fun t => by rw [hS, ← h1]; exact hI t⟩
  have hL := s7 T C R h1 h2
  obtain ⟨p, hpdeg, hpeval⟩ := s3 x (ω k)
  let pR : Polynomial ℝ := p.map (Int.castRingHom ℝ)
  let Q : Polynomial ℝ := pR ^ 2 - Polynomial.C (Y ^ 2)
  have hQeval : ∀ s : ℤ, Q.eval (s : ℝ)
      = ((Algebra.norm ℤ (x + s • ω k) : ℤ) : ℝ) ^ 2 - Y ^ 2 := by
    intro s
    simp only [Q, pR, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_C,
      Polynomial.eval_intCast_map, eq_intCast, Int.cast_id, hpeval]
  have hQdeg : Q.natDegree ≤ 2 * Module.finrank ℚ K := by
    calc Q.natDegree ≤ max (pR ^ 2).natDegree (Polynomial.C (Y ^ 2)).natDegree :=
          Polynomial.natDegree_sub_le _ _
      _ ≤ 2 * Module.finrank ℚ K := by
          rw [Polynomial.natDegree_C]
          apply max_le _ (Nat.zero_le _)
          exact Polynomial.natDegree_pow_le_of_le 2 (Polynomial.natDegree_map_le.trans hpdeg)
  have hB := s4 Q (T.filter (fun t => ¬ R (t - 1))) (by
    intro t ht
    rw [Finset.mem_filter] at ht
    obtain ⟨htT, hR1⟩ := ht
    have hRt := ((h1 t).1 htT).2
    simp only [R] at hRt hR1
    rw [Nat.cast_natAbs, Int.cast_abs] at hRt hR1
    push_neg at hR1
    have hY : 0 ≤ Y := le_trans (abs_nonneg _) hRt
    constructor
    · rw [hQeval]
      set u : ℝ := ((Algebra.norm ℤ (x + t • ω k) : ℤ) : ℝ)
      nlinarith [abs_nonneg u, sq_abs u, mul_nonneg (sub_nonneg.2 hRt)
        (by linarith [abs_nonneg u] : 0 ≤ Y + |u|)]
    · have e : ((t - 1 : ℤ) : ℝ) = (t : ℝ) - 1 := by push_cast; ring
      rw [← e, hQeval]
      set u : ℝ := ((Algebra.norm ℤ (x + (t - 1) • ω k) : ℤ) : ℝ)
      nlinarith [abs_nonneg u, sq_abs u, mul_pos (sub_pos.2 hR1)
        (by linarith [abs_nonneg u] : 0 < |u| + Y)])
  calc I.card ≤ _ := hIcard
    _ ≤ 1 + _ := hL
    _ ≤ 1 + 2 * Module.finrank ℚ K := Nat.add_le_add_left (hB.trans hQdeg) 1
    _ = 2 * Module.finrank ℚ K + 1 := by ring

theorem finU3Avg_comp_surj {A B : Type*} [AddCommGroup A] [AddCommGroup B] [Finite A]
    (π : A →+ B) (hπ : Function.Surjective π) (f : B → ℝ) :
    finU3Avg (fun x => f (π x)) = finU3Avg f :=
by
  classical
  haveI : Fintype A := Fintype.ofFinite A
  haveI : Finite B := Finite.of_surjective π hπ
  haveI : Fintype B := Fintype.ofFinite B
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : A × A × A × A →+ B × B × B × B,
      ∀ p, Φ p = (π p.1, π p.2.1, π p.2.2.1, π p.2.2.2) :=
    ⟨π.prodMap (π.prodMap (π.prodMap π)), fun p => rfl⟩
  have hΦs : Function.Surjective Φ := by
    intro q
    obtain ⟨a, ha⟩ := hπ q.1
    obtain ⟨b, hb⟩ := hπ q.2.1
    obtain ⟨c, hc⟩ := hπ q.2.2.1
    obtain ⟨d, hd⟩ := hπ q.2.2.2
    refine ⟨(a, b, c, d), ?_⟩
    rw [hΦ]
    simp only [ha, hb, hc, hd]
  
  have hfib : ∀ q, (Finset.univ.filter (fun p => Φ p = q)).card = Nat.card Φ.ker := by
    intro q
    rw [← Nat.card_congr (AddMonoidHom.fiberEquivKerOfSurjective hΦs q),
      Nat.card_eq_fintype_card, Fintype.card_subtype]
    congr 1
    ext p
    simp
  have key : ∀ G : B × B × B × B → ℝ,
      ∑ p, G (Φ p) = (Nat.card Φ.ker : ℝ) * ∑ q, G q := by
    intro G
    rw [← Finset.sum_fiberwise Finset.univ Φ (fun p => G (Φ p)), Finset.mul_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    have hq : ∀ p ∈ Finset.univ.filter (fun p => Φ p = q), G (Φ p) = G q :=
      fun p hp => by rw [(Finset.mem_filter.mp hp).2]
    rw [Finset.sum_congr rfl hq, Finset.sum_const, hfib, nsmul_eq_mul]
  have hc0 : (Nat.card Φ.ker : ℝ) ≠ 0 := by
    have : 0 < Nat.card Φ.ker := Nat.card_pos
    exact_mod_cast this.ne'
  have hnum : (∑ᶠ p : A × A × A × A,
        ∏ ε, (fun x => f (π x)) (cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε))
      = (Nat.card Φ.ker : ℝ) *
        ∑ᶠ q : B × B × B × B, ∏ ε, f (cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε) := by
    rw [finsum_eq_sum_of_fintype, finsum_eq_sum_of_fintype,
      ← key (fun q => ∏ ε, f (cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε))]
    refine Finset.sum_congr rfl (fun p _ => Finset.prod_congr rfl (fun ε _ => ?_))
    rw [hΦ]
    simp only [cubeVertex, map_add, map_nsmul]
  have hden : (Nat.card A : ℝ) ^ 4 = (Nat.card Φ.ker : ℝ) * (Nat.card B : ℝ) ^ 4 := by
    have h := key (fun _ => (1 : ℝ))
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one] at h
    rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card] at h
    simp only [Nat.card_prod] at h
    push_cast at h
    linear_combination h
  unfold finU3Avg
  rw [hnum, hden, mul_div_mul_left _ _ hc0]

theorem finU3Avg_abs_le_one {A : Type*} [AddCommGroup A] [Finite A] (f : A → ℝ)
    (hf : ∀ x, |f x| ≤ 1) : |finU3Avg f| ≤ 1 :=
by
  classical
  cases nonempty_fintype A
  have hn : 0 < (Nat.card A : ℝ) := by exact_mod_cast (Nat.card_pos (α := A))
  have h4 : 0 < (Nat.card A : ℝ) ^ 4 := pow_pos hn 4
  have hT : ∀ p : A × A × A × A,
      |∏ ε : Fin 3 → Fin 2, f (cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε)| ≤ 1 := by
    intro p
    rw [Finset.abs_prod]
    exact Finset.prod_le_one (fun _ _ => abs_nonneg _) (fun _ _ => hf _)
  have hsum : |∑ p : A × A × A × A,
      ∏ ε : Fin 3 → Fin 2, f (cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε)|
      ≤ (Nat.card A : ℝ) ^ 4 := by
    calc _ ≤ ∑ p : A × A × A × A,
          |∏ ε : Fin 3 → Fin 2, f (cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _p : A × A × A × A, (1 : ℝ) := Finset.sum_le_sum (fun p _ => hT p)
      _ = (Nat.card A : ℝ) ^ 4 := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_prod, smul_eq_mul,
            mul_one, Nat.card_eq_fintype_card, nsmul_eq_mul]
          push_cast
          ring
  unfold finU3Avg
  rw [finsum_eq_sum_of_fintype, abs_div, abs_of_pos h4, div_le_one h4]
  exact hsum

theorem finU3Avg_quadratic_char_le {F : Type*} [Field F] [Finite F] (hF : ringChar F ≠ 2)
    (η : F → ℝ) (hmul : ∀ x y, η (x * y) = η x * η y) (h0 : η 0 = 0)
    (hval : ∀ x, x ≠ 0 → η x = 1 ∨ η x = -1) (hnt : ∃ x, η x = -1) :
    |finU3Avg η| ≤ 8 / (Nat.card F : ℝ) :=
by
  classical
  haveI : Fintype F := Fintype.ofFinite F
  obtain ⟨q, hqdef⟩ : ∃ q : ℕ, q = Fintype.card F := ⟨_, rfl⟩
  have hq : (Nat.card F : ℝ) = q := by rw [Nat.card_eq_fintype_card, hqdef]
  have hq1 : (1 : ℝ) ≤ q := by
    rw [hqdef]; exact_mod_cast Fintype.card_pos
  
  obtain ⟨x₀, hx₀⟩ := hnt
  have hx₀0 : x₀ ≠ 0 := by
    rintro rfl; rw [h0] at hx₀; norm_num at hx₀
  have hsum : ∑ x, η x = 0 := by
    have h1 : ∑ x, η (x₀ * x) = ∑ x, η x :=
      Fintype.sum_equiv (Equiv.mulLeft₀ x₀ hx₀0) _ _ (fun x => rfl)
    simp_rw [hmul, hx₀, neg_one_mul, Finset.sum_neg_distrib] at h1
    linarith
  have hη1 : η 1 = 1 := by
    have h := hmul 1 1
    rw [one_mul] at h
    rcases hval 1 one_ne_zero with h' | h'
    · exact h'
    · rw [h'] at h; norm_num at h
  have hsqone : ∀ t, t ≠ 0 → η t * η t = 1 := by
    intro t ht
    rcases hval t ht with h | h <;> rw [h] <;> norm_num
  have hw0 : ∀ u, 0 ≤ 1 + η u := by
    intro u
    by_cases hu : u = 0
    · rw [hu, h0]; norm_num
    · rcases hval u hu with h | h <;> rw [h] <;> norm_num
  have hw2 : ∀ u, 1 + η u ≤ 2 := by
    intro u
    by_cases hu : u = 0
    · rw [hu, h0]; norm_num
    · rcases hval u hu with h | h <;> rw [h] <;> norm_num
  have hwsum : ∑ u, (1 + η u) = (q : ℝ) := by
    rw [Finset.sum_add_distrib, hsum, Finset.sum_const, Finset.card_univ, hqdef]
    simp
  
  have hge : ∀ z, ((quadraticChar F z : ℤ) : ℝ) ≤ η z := by
    intro z
    by_cases hz : z = 0
    · rw [hz, h0, quadraticChar_zero]; simp
    · rcases quadraticChar_dichotomy hz with h | h
      · obtain ⟨r, hr⟩ := (quadraticChar_one_iff_isSquare hz).mp h
        have hr0 : r ≠ 0 := by
          rintro rfl; rw [mul_zero] at hr; exact hz hr
        rw [h, hr, hmul, hsqone r hr0]; simp
      · rw [h]; rcases hval z hz with h' | h' <;> rw [h'] <;> norm_num
  have hsumchi : ∑ z, ((quadraticChar F z : ℤ) : ℝ) = 0 := by
    rw [← Int.cast_sum, quadraticChar_sum_zero hF]; simp
  have hchi : ∀ z, η z = ((quadraticChar F z : ℤ) : ℝ) := by
    have hnn : ∀ z ∈ (Finset.univ : Finset F), 0 ≤ η z - ((quadraticChar F z : ℤ) : ℝ) :=
      fun z _ => sub_nonneg.mpr (hge z)
    have hs0 : ∑ z, (η z - ((quadraticChar F z : ℤ) : ℝ)) = 0 := by
      rw [Finset.sum_sub_distrib, hsum, hsumchi]; simp
    intro z
    have := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp hs0 z (Finset.mem_univ z)
    linarith
  
  have hsq : ∀ G : F → ℝ, ∑ y, G (y ^ 2) = ∑ u, (1 + η u) * G u := by
    intro G
    rw [← Finset.sum_fiberwise Finset.univ (fun y => y ^ 2) (fun y => G (y ^ 2))]
    refine Finset.sum_congr rfl (fun u _ => ?_)
    rw [Finset.sum_congr rfl (fun y hy => by rw [(Finset.mem_filter.mp hy).2])]
    rw [Finset.sum_const, nsmul_eq_mul]
    congr 1
    have h := quadraticChar_card_sqrts hF u
    rw [hchi u]
    have hset : ({x : F | x ^ 2 = u} : Set F).toFinset
        = Finset.univ.filter (fun y : F => y ^ 2 = u) := by
      ext y; simp
    rw [hset] at h
    have h' : (((Finset.univ.filter (fun y : F => y ^ 2 = u)).card : ℤ) : ℝ)
        = ((quadraticChar F u + 1 : ℤ) : ℝ) := by rw [h]
    push_cast at h'
    rw [h']; ring
  
  have hJd : ∀ u : F, ∑ Y, η ((u - Y) * (u - Y)) = (q : ℝ) - 1 := by
    intro u
    have hpt : ∀ Y, η ((u - Y) * (u - Y)) = 1 - if Y = u then 1 else 0 := by
      intro Y
      by_cases h : Y = u
      · rw [if_pos h, h, sub_self, mul_zero, h0]; ring
      · rw [if_neg h, hmul, hsqone _ (sub_ne_zero.mpr (Ne.symm h))]; ring
    rw [Finset.sum_congr rfl (fun Y _ => hpt Y), Finset.sum_sub_distrib]
    simp [hqdef]
  have hJo : ∀ u v : F, u ≠ v → ∑ Y, η ((u - Y) * (v - Y)) = -1 := by
    intro u v huv
    have hc0 : v - u ≠ 0 := sub_ne_zero.mpr (Ne.symm huv)
    have hpt : ∀ Y, η ((u - Y) * (v - Y))
        = η (1 + (v - u) * (u - Y)⁻¹) - if u - Y = 0 then 1 else 0 := by
      intro Y
      by_cases ht : u - Y = 0
      · rw [if_pos ht, ht, zero_mul, h0, inv_zero, mul_zero, add_zero, hη1]; ring
      · rw [if_neg ht, sub_zero]
        have hinv : (u - Y) * (u - Y)⁻¹ = 1 := mul_inv_cancel₀ ht
        have : (u - Y) * (v - Y) = (u - Y) * (u - Y) * (1 + (v - u) * (u - Y)⁻¹) := by
          linear_combination (-(u - Y) * (v - u)) * hinv
        rw [this, hmul, hmul, hsqone _ ht, one_mul]
    rw [Finset.sum_congr rfl (fun Y _ => hpt Y), Finset.sum_sub_distrib]
    have hinj : Function.Injective (fun Y : F => 1 + (v - u) * (u - Y)⁻¹) := by
      intro a b hab
      simp only at hab
      have h1 := inv_inj.mp (mul_left_cancel₀ hc0 (add_left_cancel hab))
      linear_combination -h1
    have hbij : ∑ Y, η (1 + (v - u) * (u - Y)⁻¹) = 0 := by
      rw [Fintype.sum_bijective _ (Finite.injective_iff_bijective.mp hinj) _ η (fun _ => rfl)]
      exact hsum
    rw [hbij]
    have hone : ∑ Y : F, (if u - Y = 0 then (1 : ℝ) else 0) = 1 := by
      simp [sub_eq_zero]
    rw [hone]; ring
  
  have swap4 : ∀ G : F → F → F → F → ℝ,
      ∑ a, ∑ b, ∑ c, ∑ d, G a b c d = ∑ c, ∑ d, ∑ a, ∑ b, G a b c d := by
    intro G
    calc ∑ a, ∑ b, ∑ c, ∑ d, G a b c d = ∑ a, ∑ c, ∑ b, ∑ d, G a b c d :=
          Finset.sum_congr rfl fun a _ => Finset.sum_comm
      _ = ∑ a, ∑ c, ∑ d, ∑ b, G a b c d :=
          Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun c _ => Finset.sum_comm
      _ = ∑ c, ∑ a, ∑ d, ∑ b, G a b c d := Finset.sum_comm
      _ = ∑ c, ∑ d, ∑ a, ∑ b, G a b c d := Finset.sum_congr rfl fun c _ => Finset.sum_comm
  
  have hprod : ∀ x h₁ h₂ h₃ : F, ∏ ε : Fin 3 → Fin 2, η (cubeVertex x h₁ h₂ h₃ ε) =
      (η x * η (x + h₂) * η (x + h₃) * η (x + h₂ + h₃)) *
      (η (x + h₁) * η (x + h₁ + h₂) * η (x + h₁ + h₃) * η (x + h₁ + h₂ + h₃)) := by
    intro x h₁ h₂ h₃
    let e : (Fin 3 → Fin 2) ≃ Fin 2 × Fin 2 × Fin 2 :=
      { toFun := fun ε => (ε 0, ε 1, ε 2)
        invFun := fun p => ![p.1, p.2.1, p.2.2]
        left_inv := fun ε => by funext i; fin_cases i <;> rfl
        right_inv := fun p => rfl }
    rw [← e.symm.prod_comp]
    simp only [Fintype.prod_prod_type, Fin.prod_univ_two]
    simp [e, cubeVertex]
    ring
  have hT : finU3Avg η * (q : ℝ) ^ 4 =
      ∑ a, ∑ b, (∑ x, η x * η (x + a) * η (x + b) * η (x + a + b)) ^ 2 := by
    have hq0 : (q : ℝ) ^ 4 ≠ 0 := by positivity
    unfold finU3Avg
    rw [hq, div_mul_cancel₀ _ hq0, finsum_eq_sum_of_fintype]
    simp only [Fintype.sum_prod_type, hprod]
    rw [swap4]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    rw [sq, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    exact Fintype.sum_equiv (Equiv.addLeft x) _ _ (fun h₁ => by simp [add_assoc])
  
  obtain ⟨H, hH⟩ : ∃ H : F → F → ℝ,
      H = fun a b => (∑ x, η x * η (x + a) * η (x + b) * η (x + a + b)) ^ 2 := ⟨_, rfl⟩
  have h2 : (2 : F) ≠ 0 := Ring.two_ne_zero hF
  have hinj2 : Function.Injective (fun p : F × F => (p.1 + p.2, p.1 - p.2)) := by
    rintro ⟨m, d⟩ ⟨m', d'⟩ h
    simp only [Prod.mk.injEq] at h
    obtain ⟨e1, e2⟩ := h
    have hm : (2 : F) * m = 2 * m' := by linear_combination e1 + e2
    have hd : (2 : F) * d = 2 * d' := by linear_combination e1 - e2
    exact Prod.ext (mul_left_cancel₀ h2 hm) (mul_left_cancel₀ h2 hd)
  have hreparam : ∑ a, ∑ b, H a b =
      ∑ m, ∑ d, (∑ y, η ((y ^ 2 - m ^ 2) * (y ^ 2 - d ^ 2))) ^ 2 := by
    calc ∑ a, ∑ b, H a b = ∑ p : F × F, H p.1 p.2 := (Fintype.sum_prod_type' _).symm
      _ = ∑ p : F × F, H (p.1 + p.2) (p.1 - p.2) :=
          (Fintype.sum_bijective _ (Finite.injective_iff_bijective.mp hinj2) _ _
            (fun p => rfl)).symm
      _ = ∑ m, ∑ d, H (m + d) (m - d) := Fintype.sum_prod_type' (fun m d => H (m + d) (m - d))
      _ = _ := by
          refine Finset.sum_congr rfl (fun m _ => Finset.sum_congr rfl (fun d _ => ?_))
          rw [hH]
          dsimp only
          congr 1
          have hpt : ∀ y, η ((y ^ 2 - m ^ 2) * (y ^ 2 - d ^ 2)) =
              η (y - m) * η (y - m + (m + d)) * η (y - m + (m - d)) *
                η (y - m + (m + d) + (m - d)) := by
            intro y
            rw [← hmul, ← hmul, ← hmul]; congr 1; ring
          exact (Fintype.sum_equiv (Equiv.subRight m) _ _ hpt).symm
  
  obtain ⟨D, hD⟩ : ∃ D : F → F → ℝ,
      D = fun Y Z => ∑ u, (1 + η u) * η ((u - Y) * (u - Z)) := ⟨_, rfl⟩
  have hweighted : ∑ m, ∑ d, (∑ y, η ((y ^ 2 - m ^ 2) * (y ^ 2 - d ^ 2))) ^ 2 =
      ∑ Y, (1 + η Y) * ∑ Z, (1 + η Z) * D Y Z ^ 2 := by
    have e1 : ∀ m d : F, ∑ y, η ((y ^ 2 - m ^ 2) * (y ^ 2 - d ^ 2)) = D (m ^ 2) (d ^ 2) := by
      intro m d
      rw [hD]
      exact hsq (fun u => η ((u - m ^ 2) * (u - d ^ 2)))
    simp_rw [e1]
    have e2 : ∀ m : F, ∑ d, D (m ^ 2) (d ^ 2) ^ 2 = ∑ Z, (1 + η Z) * D (m ^ 2) Z ^ 2 :=
      fun m => hsq (fun Z => D (m ^ 2) Z ^ 2)
    simp_rw [e2]
    exact hsq (fun Y => ∑ Z, (1 + η Z) * D Y Z ^ 2)
  
  have hmom : ∑ Y, ∑ Z, D Y Z ^ 2 ≤ 2 * (q : ℝ) * ((q : ℝ) - 1) ^ 2 + (q : ℝ) ^ 2 := by
    obtain ⟨J, hJ⟩ : ∃ J : F → F → ℝ, J = fun u v => ∑ Y, η ((u - Y) * (v - Y)) := ⟨_, rfl⟩
    have hexp : ∀ Y Z, D Y Z ^ 2 = ∑ u, ∑ v, (1 + η u) * (1 + η v) *
        (η ((u - Y) * (v - Y)) * η ((u - Z) * (v - Z))) := by
      intro Y Z
      rw [hD]; dsimp only
      rw [sq, Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun u _ => Finset.sum_congr rfl (fun v _ => ?_))
      have : η ((u - Y) * (u - Z)) * η ((v - Y) * (v - Z)) =
          η ((u - Y) * (v - Y)) * η ((u - Z) * (v - Z)) := by
        rw [← hmul, ← hmul]; congr 1; ring
      calc (1 + η u) * η ((u - Y) * (u - Z)) * ((1 + η v) * η ((v - Y) * (v - Z)))
          = (1 + η u) * (1 + η v) * (η ((u - Y) * (u - Z)) * η ((v - Y) * (v - Z))) := by ring
        _ = _ := by rw [this]
    have hsumJ : ∑ Y, ∑ Z, D Y Z ^ 2 = ∑ u, ∑ v, (1 + η u) * (1 + η v) * J u v ^ 2 := by
      simp_rw [hexp]
      rw [swap4]
      refine Finset.sum_congr rfl (fun u _ => Finset.sum_congr rfl (fun v _ => ?_))
      rw [hJ]; dsimp only
      rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun Y _ => ?_)
      rw [Finset.mul_sum]
    rw [hsumJ]
    have hbd : ∀ u v, (1 + η u) * (1 + η v) * J u v ^ 2 ≤
        (if u = v then (1 + η u) * (1 + η u) * ((q : ℝ) - 1) ^ 2 else 0) +
          (1 + η u) * (1 + η v) := by
      intro u v
      have hwuv : 0 ≤ (1 + η u) * (1 + η v) := mul_nonneg (hw0 u) (hw0 v)
      by_cases huv : u = v
      · rw [if_pos huv, ← huv, hJ]; dsimp only
        rw [hJd u]
        nlinarith [mul_nonneg (hw0 u) (hw0 u)]
      · rw [if_neg huv, hJ]; dsimp only
        rw [hJo u v huv]
        nlinarith
    calc ∑ u, ∑ v, (1 + η u) * (1 + η v) * J u v ^ 2
        ≤ ∑ u, ∑ v, ((if u = v then (1 + η u) * (1 + η u) * ((q : ℝ) - 1) ^ 2 else 0) +
          (1 + η u) * (1 + η v)) :=
          Finset.sum_le_sum fun u _ => Finset.sum_le_sum fun v _ => hbd u v
      _ = ∑ u, (1 + η u) * (1 + η u) * ((q : ℝ) - 1) ^ 2 +
            (∑ u, (1 + η u)) * (∑ v, (1 + η v)) := by
          rw [Finset.sum_mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun u _ => ?_)
          rw [Finset.sum_add_distrib, Finset.sum_ite_eq]
          simp
      _ ≤ ∑ u, 2 * (1 + η u) * ((q : ℝ) - 1) ^ 2 + (q : ℝ) * (q : ℝ) := by
          rw [hwsum]
          have := Finset.sum_le_sum (fun u (_ : u ∈ (Finset.univ : Finset F)) =>
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hw2 u) (hw0 u))
              (sq_nonneg ((q : ℝ) - 1)))
          linarith
      _ = 2 * (q : ℝ) * ((q : ℝ) - 1) ^ 2 + (q : ℝ) ^ 2 := by
          rw [← Finset.sum_mul, ← Finset.mul_sum, hwsum]; ring
  
  have hTeq : finU3Avg η * (q : ℝ) ^ 4 = ∑ Y, (1 + η Y) * ∑ Z, (1 + η Z) * D Y Z ^ 2 := by
    rw [hT, ← hweighted, ← hreparam, hH]
  have hTnn : 0 ≤ finU3Avg η * (q : ℝ) ^ 4 := by
    rw [hT]; positivity
  have hTle : finU3Avg η * (q : ℝ) ^ 4 ≤ 8 * (q : ℝ) ^ 3 := by
    rw [hTeq]
    have h1 : ∑ Y, (1 + η Y) * ∑ Z, (1 + η Z) * D Y Z ^ 2 ≤ ∑ Y, 2 * ∑ Z, 2 * D Y Z ^ 2 := by
      apply Finset.sum_le_sum
      intro Y _
      have hin : ∑ Z, (1 + η Z) * D Y Z ^ 2 ≤ ∑ Z, 2 * D Y Z ^ 2 :=
        Finset.sum_le_sum fun Z _ => mul_le_mul_of_nonneg_right (hw2 Z) (sq_nonneg _)
      have hin0 : 0 ≤ ∑ Z, (1 + η Z) * D Y Z ^ 2 :=
        Finset.sum_nonneg fun Z _ => mul_nonneg (hw0 Z) (sq_nonneg _)
      calc (1 + η Y) * ∑ Z, (1 + η Z) * D Y Z ^ 2 ≤ 2 * ∑ Z, (1 + η Z) * D Y Z ^ 2 :=
            mul_le_mul_of_nonneg_right (hw2 Y) hin0
        _ ≤ 2 * ∑ Z, 2 * D Y Z ^ 2 := by linarith
    have h2 : ∑ Y, 2 * ∑ Z, 2 * D Y Z ^ 2 = 4 * ∑ Y, ∑ Z, D Y Z ^ 2 := by
      simp_rw [← Finset.mul_sum]; ring
    rw [h2] at h1
    nlinarith
  have hq4 : 0 < (q : ℝ) ^ 4 := by positivity
  have hnn : 0 ≤ finU3Avg η := by
    by_contra hneg
    push_neg at hneg
    have := mul_neg_of_neg_of_pos hneg hq4
    linarith
  rw [abs_of_nonneg hnn, hq, le_div_iff₀ (by positivity)]
  have : finU3Avg η * (q : ℝ) ^ 4 = (finU3Avg η * q) * (q : ℝ) ^ 3 := by ring
  rw [this] at hTle
  have hq3 : 0 < (q : ℝ) ^ 3 := by positivity
  nlinarith

theorem kaiFplus_isPrimRealCharMod {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (h𝔮 : 𝔮 ≠ ⊥)
    (ψ : NumberField.RingOfIntegers K → ℤ) (hψ : IsRealRayChar 𝔮 ψ) :
    IsPrimRealCharMod 𝔮 (kaiFplus 𝔮 ψ) :=
by
  classical
  obtain ⟨h1, h2, h3, -, h5, h6⟩ := hψ
  have hQ0 : Ideal.absNorm 𝔮 ≠ 0 := fun h => h𝔮 (Ideal.absNorm_eq_zero_iff.mp h)
  have hQ1 : 1 ≤ Ideal.absNorm 𝔮 := Nat.one_le_iff_ne_zero.mpr hQ0
  have hQmem : ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔮 :=
    Ideal.absNorm_mem 𝔮
  have hcm : ∀ a b : NumberField.RingOfIntegers K,
      ((a * b : NumberField.RingOfIntegers K) : K) = (a : K) * (b : K) := by
    intro a b
    first
      | norm_cast
      | exact map_mul (algebraMap (NumberField.RingOfIntegers K) K) a b
      | simp
  
  have htp : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K)
      (hw : w.IsReal),
      0 < NumberField.InfinitePlace.embedding_of_isReal hw
        (((x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K) :
          NumberField.RingOfIntegers K)) : K) := by
    intro x w hw
    have hcoe : (((x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K) :
          NumberField.RingOfIntegers K)) : K)
        = (x : K) + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : K) := by
      first
        | norm_cast
        | (push_cast; ring)
        | simp
    rw [hcoe, map_add, map_natCast]
    have habs : |NumberField.InfinitePlace.embedding_of_isReal hw (x : K)| = w (x : K) := by
      rw [← Real.norm_eq_abs]
      exact NumberField.InfinitePlace.norm_embedding_of_isReal hw (x : K)
    have hle : w (x : K) ≤ ∑ v : NumberField.InfinitePlace K, v (x : K) :=
      Finset.single_le_sum (f := fun v : NumberField.InfinitePlace K => v (x : K))
        (fun v _ => apply_nonneg v _) (Finset.mem_univ w)
    have hceil : ∑ v : NumberField.InfinitePlace K, v (x : K)
        ≤ (⌈∑ v : NumberField.InfinitePlace K, v (x : K)⌉₊ : ℝ) := Nat.le_ceil _
    have hs : (kaiShift x : ℝ) = (⌈∑ v : NumberField.InfinitePlace K, v (x : K)⌉₊ : ℝ) + 1 := by
      unfold kaiShift; push_cast; ring
    have hn : (1 : ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) := by exact_mod_cast hQ1
    have hs0 : (0 : ℝ) ≤ (kaiShift x : ℝ) := Nat.cast_nonneg _
    have hns : (kaiShift x : ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) * (kaiShift x : ℝ) :=
      le_mul_of_one_le_left hs0 hn
    have hna := neg_abs_le (NumberField.InfinitePlace.embedding_of_isReal hw (x : K))
    push_cast
    linarith
  
  have hshift : ∀ x : NumberField.RingOfIntegers K,
      (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) - x ∈ 𝔮 := by
    intro x
    rw [add_sub_cancel_left, Nat.cast_mul]
    exact Ideal.mul_mem_right _ _ hQmem
  
  have hR : ∀ x z : NumberField.RingOfIntegers K, z - x ∈ 𝔮 →
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (z : K)) →
      kaiFplus 𝔮 ψ x = ψ z := by
    intro x z hzx hz
    unfold kaiFplus
    apply h5
    · have e : (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) - z
          = ((x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) - x)
            - (z - x) := by ring
      rw [e]
      exact Ideal.sub_mem _ (hshift x) hzx
    · intro w hw
      exact mul_pos (htp x w hw) (hz w hw)
  
  have hcopsub : ∀ x y : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {x}) 𝔮 →
      x - y ∈ 𝔮 → IsCoprime (Ideal.span {y}) 𝔮 := by
    intro x y hx hxy
    obtain ⟨i, hi, j, hj, hij⟩ := Ideal.isCoprime_iff_exists.mp hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hi
    refine Ideal.isCoprime_iff_exists.mpr ⟨c * y, Ideal.mem_span_singleton'.mpr ⟨c, rfl⟩,
      c * (x - y) + j, Ideal.add_mem _ (Ideal.mul_mem_left _ c hxy) hj, ?_⟩
    linear_combination hij
  have hval : ∀ z, IsCoprime (Ideal.span {z}) 𝔮 → ψ z = 1 ∨ ψ z = -1 := by
    intro z hz
    rcases h1 z with h | h | h
    · exact Or.inl h
    · exact Or.inr h
    · exact absurd hz ((h2 z).mp h)
  
  have hcop1 : IsCoprime (Ideal.span {(1 : NumberField.RingOfIntegers K)}) 𝔮 := by
    rw [Ideal.span_singleton_one, ← Ideal.one_eq_top]
    exact isCoprime_one_left
  have hψ1 : ψ 1 = 1 := by
    have hm := h3 1 1
    rw [mul_one] at hm
    rcases hval 1 hcop1 with h | h
    · exact h
    · rw [h] at hm; norm_num at hm
  have P1 : kaiFplus 𝔮 ψ 1 = 1 := by
    have hpos : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw
          ((1 : NumberField.RingOfIntegers K) : K) := by
      intro w hw
      simp
    rw [hR 1 1 (by rw [sub_self]; exact Ideal.zero_mem _) hpos]
    exact hψ1
  
  have P2 : ∀ x y, x - y ∈ 𝔮 → kaiFplus 𝔮 ψ x = kaiFplus 𝔮 ψ y := by
    intro x y hxy
    rw [hR x (y + ((Ideal.absNorm 𝔮 * kaiShift y : ℕ) : NumberField.RingOfIntegers K)) ?_
      (htp y)]
    · rfl
    · have e : (y + ((Ideal.absNorm 𝔮 * kaiShift y : ℕ) : NumberField.RingOfIntegers K)) - x
          = ((y + ((Ideal.absNorm 𝔮 * kaiShift y : ℕ) : NumberField.RingOfIntegers K)) - y)
            - (x - y) := by ring
      rw [e]
      exact Ideal.sub_mem _ (hshift y) hxy
  
  have P3 : ∀ x y, kaiFplus 𝔮 ψ (x * y) = kaiFplus 𝔮 ψ x * kaiFplus 𝔮 ψ y := by
    intro x y
    obtain ⟨a, ha⟩ : ∃ a : NumberField.RingOfIntegers K,
        a = x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K) := ⟨_, rfl⟩
    obtain ⟨b, hb⟩ : ∃ b : NumberField.RingOfIntegers K,
        b = y + ((Ideal.absNorm 𝔮 * kaiShift y : ℕ) : NumberField.RingOfIntegers K) := ⟨_, rfl⟩
    have hfx : kaiFplus 𝔮 ψ x = ψ a := by rw [ha]; rfl
    have hfy : kaiFplus 𝔮 ψ y = ψ b := by rw [hb]; rfl
    have hax : a - x ∈ 𝔮 := by rw [ha]; exact hshift x
    have hby : b - y ∈ 𝔮 := by rw [hb]; exact hshift y
    have hapos : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (a : K) := by
      rw [ha]; exact htp x
    have hbpos : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (b : K) := by
      rw [hb]; exact htp y
    rw [hfx, hfy, ← h3]
    apply hR
    · have e : a * b - x * y = (a - x) * b + x * (b - y) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hax) (Ideal.mul_mem_left _ _ hby)
    · intro w hw
      rw [hcm, map_mul]
      exact mul_pos (hapos w hw) (hbpos w hw)
  
  have P4 : ∀ x, IsCoprime (Ideal.span {x}) 𝔮 →
      kaiFplus 𝔮 ψ x = 1 ∨ kaiFplus 𝔮 ψ x = -1 := by
    intro x hx
    have hmem : x - (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K))
        ∈ 𝔮 := by
      have h' := neg_mem (hshift x)
      rw [neg_sub] at h'
      exact h'
    unfold kaiFplus
    exact hval _ (hcopsub x _ hx hmem)
  
  have P5 : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔮 < 𝔡 →
      ∃ r, r - 1 ∈ 𝔡 ∧ IsCoprime (Ideal.span {r}) 𝔮 ∧ kaiFplus 𝔮 ψ r = -1 := by
    intro 𝔡 h𝔡
    obtain ⟨x, y, hx, hy, hxy, hsg, hne⟩ := h6 𝔡 h𝔡
    have hxy1 : ψ x * ψ y = -1 := by
      rcases hval x hx with h | h <;> rcases hval y hy with h' | h' <;>
        rw [h, h'] at hne ⊢ <;> omega
    have hxyTP : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw
          ((x * y : NumberField.RingOfIntegers K) : K) := by
      intro w hw
      rw [hcm, map_mul]
      exact hsg w hw
    have hFxy : kaiFplus 𝔮 ψ (x * y) = -1 := by
      rw [hR (x * y) (x * y) (by rw [sub_self]; exact Ideal.zero_mem _) hxyTP, h3]
      exact hxy1
    obtain ⟨i, hi, j, hj, hij⟩ := Ideal.isCoprime_iff_exists.mp hy
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hi
    have hw1 : y * c - 1 ∈ 𝔮 := by
      have e : y * c - 1 = -j := by linear_combination hij
      rw [e]
      exact neg_mem hj
    have hwc : IsCoprime (Ideal.span {c}) 𝔮 :=
      Ideal.isCoprime_iff_exists.mpr ⟨y * c, Ideal.mem_span_singleton'.mpr ⟨y, rfl⟩, j, hj,
        by linear_combination hij⟩
    refine ⟨(x * y) * (c * c), ?_, ?_, ?_⟩
    · have e : (x * y) * (c * c) - 1 = (x - y) * (y * c * c) + (y * c - 1) * (y * c + 1) := by
        ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hxy) (h𝔡.le (Ideal.mul_mem_right _ _ hw1))
    · have hxyc : IsCoprime (Ideal.span {x * y}) 𝔮 := by
        rw [← Ideal.span_singleton_mul_span_singleton]
        exact hx.mul_left hy
      have hcc : IsCoprime (Ideal.span {c * c}) 𝔮 := by
        rw [← Ideal.span_singleton_mul_span_singleton]
        exact hwc.mul_left hwc
      rw [← Ideal.span_singleton_mul_span_singleton]
      exact hxyc.mul_left hcc
    · rw [P3 (x * y) (c * c), P3 c c, hFxy]
      rcases P4 c hwc with h | h <;> rw [h] <;> norm_num
  exact ⟨P1, P2, P3, P4, P5⟩

theorem primRealChar_conductor_bound {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (h𝔮 : 𝔮 ≠ ⊥)
    (F : NumberField.RingOfIntegers K → ℤ) (hF : IsPrimRealCharMod 𝔮 F)
    (P : Ideal (NumberField.RingOfIntegers K)) (hP : P.IsMaximal) (e : ℕ)
    (h2 : (2 : NumberField.RingOfIntegers K) ∉ P ^ (e + 1)) :
    ¬ 𝔮 ≤ P ^ (2 * e + 2) :=
by
  classical
  intro hq
  obtain ⟨hF1, hFper, hFmul, hFval, hFprim⟩ := hF
  have hP0 : P ≠ ⊥ := by
    rintro rfl
    apply h𝔮
    exact le_bot_iff.mp (hq.trans (Ideal.pow_le_self (by omega)))
  
  have hH : P ^ e ≤ Ideal.span {(2 : NumberField.RingOfIntegers K)} ⊔ P ^ (e + 1) := by
    have hdvd : Ideal.span {(2 : NumberField.RingOfIntegers K)} ⊔ P ^ (e + 1) ∣ P ^ (e + 1) :=
      Ideal.dvd_iff_le.mpr le_sup_right
    have hprime : Prime P := Ideal.prime_of_isPrime hP0 hP.isPrime
    obtain ⟨i, hi, hassoc⟩ := (dvd_prime_pow hprime (e + 1)).mp hdvd
    have hJ : Ideal.span {(2 : NumberField.RingOfIntegers K)} ⊔ P ^ (e + 1) = P ^ i :=
      associated_iff_eq.mp hassoc
    rcases Nat.lt_or_ge i (e + 1) with h | h
    · rw [hJ]; exact Ideal.pow_le_pow_right (by omega)
    · exfalso
      have hi' : i = e + 1 := by omega
      apply h2
      rw [← hi', ← hJ]
      exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  
  have hensel : ∀ r : NumberField.RingOfIntegers K, r - 1 ∈ P ^ (2 * e + 1) →
      ∀ k : ℕ, 2 * e + 1 ≤ k → ∃ z : NumberField.RingOfIntegers K, z ∉ P ∧ z * z - r ∈ P ^ k := by
    intro r hr k hk
    induction k, hk using Nat.le_induction with
    | base =>
      refine ⟨1, fun h => hP.ne_top ((Ideal.eq_top_iff_one P).mpr h), ?_⟩
      have : (1 : NumberField.RingOfIntegers K) * 1 - r = -(r - 1) := by ring
      rw [this]; exact neg_mem hr
    | succ k hk ih =>
      obtain ⟨z, hzP, hz⟩ := ih
      have hd : r - z * z ∈ P ^ k := by
        have := neg_mem hz; rwa [neg_sub] at this
      have hincl : P ^ k ≤ Ideal.span {(2 : NumberField.RingOfIntegers K)} * P ^ (k - e)
          ⊔ P ^ (k + 1) := by
        have h1 : P ^ k = P ^ e * P ^ (k - e) := by rw [← pow_add]; congr 1; omega
        have h2' : P ^ (e + 1) * P ^ (k - e) = P ^ (k + 1) := by rw [← pow_add]; congr 1; omega
        calc P ^ k = P ^ e * P ^ (k - e) := h1
          _ ≤ (Ideal.span {(2 : NumberField.RingOfIntegers K)} ⊔ P ^ (e + 1)) * P ^ (k - e) :=
              Ideal.mul_mono_left hH
          _ = Ideal.span {(2 : NumberField.RingOfIntegers K)} * P ^ (k - e)
                ⊔ P ^ (e + 1) * P ^ (k - e) := Ideal.sup_mul _ _ _
          _ = _ := by rw [h2']
      obtain ⟨a, ha, d', hd', hsum⟩ := Submodule.mem_sup.mp (hincl hd)
      obtain ⟨t₁, ht₁, ht₁a⟩ := Ideal.mem_span_singleton_mul.mp ha
      have haP : a ∈ P ^ k := by
        have : a = (r - z * z) - d' := by rw [← hsum]; ring
        rw [this]
        exact sub_mem hd (Ideal.pow_le_pow_right (by omega) hd')
      obtain ⟨v, i, hi, hv⟩ := Ideal.IsMaximal.exists_inv hP hzP
      refine ⟨z + v * t₁, ?_, ?_⟩
      · intro h
        have htP : v * t₁ ∈ P := Ideal.mul_mem_left _ v (Ideal.pow_le_self (by omega) ht₁)
        apply hzP
        have := sub_mem h htP
        simpa using this
      · have key : (z + v * t₁) * (z + v * t₁) - r
            = -(a * i) - d' + (v * t₁) * (v * t₁) := by
          linear_combination hsum + (z * v) * ht₁a + a * hv
        rw [key]
        have h1 : a * i ∈ P ^ (k + 1) := by rw [pow_succ]; exact Ideal.mul_mem_mul haP hi
        have h3 : (v * t₁) * (v * t₁) ∈ P ^ (k + 1) := by
          have hm : (v * t₁) * (v * t₁) ∈ P ^ (k - e) * P ^ (k - e) :=
            Ideal.mul_mem_mul (Ideal.mul_mem_left _ v ht₁) (Ideal.mul_mem_left _ v ht₁)
          rw [← pow_add] at hm
          exact Ideal.pow_le_pow_right (by omega) hm
        exact add_mem (sub_mem (neg_mem h1) hd') h3
  
  obtain ⟨g, 𝔟, 𝔡, hmg, h𝔮eq, hcop, hlt, h𝔡P, h𝔡𝔟⟩ :
      ∃ (g : ℕ) (𝔟 𝔡 : Ideal (NumberField.RingOfIntegers K)), 2 * e + 2 ≤ g + 1 ∧
        𝔮 = P ^ (g + 1) * 𝔟 ∧ P ^ (g + 1) ⊔ 𝔟 = ⊤ ∧ 𝔮 < 𝔡 ∧ 𝔡 ≤ P ^ g ∧ 𝔡 ≤ 𝔟 := by
    have hex : ∃ k, ¬ 𝔮 ≤ P ^ k := by
      by_contra hcon
      push_neg at hcon
      apply h𝔮
      have : 𝔮 ≤ ⨅ k, P ^ k := le_iInf hcon
      rw [Ideal.iInf_pow_eq_bot_of_isDomain P hP.ne_top] at this
      exact le_bot_iff.mp this
    have hnspec : ¬ 𝔮 ≤ P ^ (Nat.find hex) := Nat.find_spec hex
    have hmn : 2 * e + 2 < Nat.find hex := by
      by_contra h
      push_neg at h
      exact hnspec (hq.trans (Ideal.pow_le_pow_right h))
    obtain ⟨g, hg⟩ : ∃ g, Nat.find hex = g + 2 := ⟨Nat.find hex - 2, by omega⟩
    have hq1 : 𝔮 ≤ P ^ (g + 1) := by
      have := Nat.find_min hex (show g + 1 < Nat.find hex by omega)
      push_neg at this; exact this
    have hq2 : ¬ 𝔮 ≤ P ^ (g + 2) := hg ▸ hnspec
    obtain ⟨𝔟, h𝔟⟩ := Ideal.dvd_iff_le.mpr hq1
    have h𝔟P : ¬ 𝔟 ≤ P := by
      intro h
      apply hq2
      rw [h𝔟, pow_succ P (g + 1)]
      exact Ideal.mul_mono_right h
    have hPb : P ⊔ 𝔟 = ⊤ := by
      refine (Ideal.isMaximal_def.mp hP).2 (P ⊔ 𝔟) (lt_of_le_of_ne le_sup_left ?_)
      intro h
      exact h𝔟P (le_sup_right.trans h.ge)
    have hcop : P ^ (g + 1) ⊔ 𝔟 = ⊤ := Ideal.pow_sup_eq_top hPb
    have hq𝔡 : 𝔮 = P * (P ^ g * 𝔟) := by rw [h𝔟, pow_succ', mul_assoc]
    refine ⟨g, 𝔟, P ^ g * 𝔟, by omega, h𝔟, hcop, ?_, Ideal.mul_le_right, Ideal.mul_le_left⟩
    refine lt_of_le_of_ne (hq𝔡 ▸ Ideal.mul_le_left) ?_
    intro heq
    have h0 : P ^ g * 𝔟 ≠ 0 := by
      rw [← heq]; exact h𝔮
    have h1 : P * (P ^ g * 𝔟) = 1 * (P ^ g * 𝔟) := by rw [one_mul, ← hq𝔡, heq]
    have hP1 : P = 1 := mul_right_cancel₀ h0 h1
    exact hP.ne_top (by rw [hP1, Ideal.one_eq_top])
  
  have crt : ∀ (I J : Ideal (NumberField.RingOfIntegers K)), I ⊔ J = ⊤ →
      ∀ (r z₀ : NumberField.RingOfIntegers K), z₀ * z₀ - r ∈ I → r - 1 ∈ J →
        ∃ z : NumberField.RingOfIntegers K, z * z - r ∈ I * J := by
    intro I J hIJ r z₀ hz₀ hr
    have h1 : (1 : NumberField.RingOfIntegers K) ∈ I ⊔ J := hIJ ▸ Submodule.mem_top
    obtain ⟨p, hp, b, hb, hpb⟩ := Submodule.mem_sup.mp h1
    refine ⟨z₀ * b + p, ?_⟩
    have hxI : (z₀ * b + p) * (z₀ * b + p) - r ∈ I := by
      have e1 : (z₀ * b + p) * (z₀ * b + p) - r
          = (p * (1 - z₀)) * ((z₀ * b + p) + z₀) + (z₀ * z₀ - r) := by
        linear_combination (z₀ * b + p + z₀) * z₀ * hpb
      rw [e1]
      exact add_mem (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ hp)) hz₀
    have hxJ : (z₀ * b + p) * (z₀ * b + p) - r ∈ J := by
      have e2 : (z₀ * b + p) * (z₀ * b + p) - r
          = (b * (z₀ - 1)) * ((z₀ * b + p) + 1) - (r - 1) := by
        linear_combination (z₀ * b + p + 1) * hpb
      rw [e2]
      exact sub_mem (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right _ _ hb)) hr
    have e3 : (z₀ * b + p) * (z₀ * b + p) - r
        = p * ((z₀ * b + p) * (z₀ * b + p) - r)
          + ((z₀ * b + p) * (z₀ * b + p) - r) * b := by
      linear_combination (-((z₀ * b + p) * (z₀ * b + p) - r)) * hpb
    rw [e3]
    exact add_mem (Ideal.mul_mem_mul hp hxJ) (Ideal.mul_mem_mul hxI hb)
  
  obtain ⟨r, hr1, hrcop, hFr⟩ := hFprim 𝔡 hlt
  have hrP : r - 1 ∈ P ^ (2 * e + 1) := Ideal.pow_le_pow_right (by omega) (h𝔡P hr1)
  obtain ⟨z₀, -, hz₀⟩ := hensel r hrP (g + 1) (by omega)
  obtain ⟨z, hz⟩ := crt (P ^ (g + 1)) 𝔟 hcop r z₀ hz₀ (h𝔡𝔟 hr1)
  rw [← h𝔮eq] at hz
  have hFr' : F r = F z * F z := by rw [← hFmul, hFper (z * z) r hz]
  have hzcop : IsCoprime (Ideal.span {z}) 𝔮 := by
    rw [Ideal.isCoprime_iff_sup_eq] at hrcop ⊢
    rw [eq_top_iff, ← hrcop]
    refine sup_le ?_ le_sup_right
    rw [Ideal.span_singleton_le_iff_mem]
    have hmem : z * z - (z * z - r) ∈ Ideal.span {z} ⊔ 𝔮 :=
      sub_mem (Ideal.mem_sup_left (Ideal.mul_mem_left _ z (Ideal.mem_span_singleton_self z)))
        (Ideal.mem_sup_right hz)
    rwa [sub_sub_cancel] at hmem
  have hsq : F z * F z = 1 := by
    rcases hFval z hzcop with h | h <;> rw [h] <;> norm_num
  linarith

theorem finU3Avg_crt_factor {R : Type*} [CommRing R] [IsDedekindDomain R]
    (I : Ideal R) (hI : I ≠ ⊥) [Finite (R ⧸ I)]
    (G : R → ℝ) (hG1 : G 1 = 1) (hGmul : ∀ x y, G (x * y) = G x * G y)
    (hGper : ∀ x y, x - y ∈ I → G x = G y)
    (Gbar : R ⧸ I → ℝ) (hGbar : ∀ x, Gbar (Ideal.Quotient.mk I x) = G x) :
    ∃ (S : Finset (Ideal R)) (a : Ideal R → ℕ) (g : (P : Ideal R) → R ⧸ P ^ a P → ℝ),
      (∀ P, P ∈ S ↔ (P.IsPrime ∧ P ≠ ⊥ ∧ I ≤ P)) ∧
      (∀ P ∈ S, 1 ≤ a P) ∧
      I = ∏ P ∈ S, P ^ a P ∧
      (∀ P ∈ S, ∀ x : R, ∃ ℓ : R, ℓ - x ∈ P ^ a P ∧ ∀ P' ∈ S, P' ≠ P → ℓ - 1 ∈ P' ^ a P') ∧
      (∀ P ∈ S, ∀ x ℓ : R, ℓ - x ∈ P ^ a P → (∀ P' ∈ S, P' ≠ P → ℓ - 1 ∈ P' ^ a P') →
          g P (Ideal.Quotient.mk (P ^ a P) x) = G ℓ) ∧
      finU3Avg Gbar = ∏ P ∈ S, finU3Avg (g P) :=
by
  classical
  
  have hiso : ∀ {B C : Type u_1} [AddCommGroup B] [AddCommGroup C] [Finite B] (e : B ≃+ C)
      (f : C → ℝ), finU3Avg (fun x => f (e x)) = finU3Avg f := by
    intro B C _ _ _ e f
    haveI : Finite C := Finite.of_equiv B e.toEquiv
    haveI := Fintype.ofFinite B
    haveI := Fintype.ofFinite C
    unfold finU3Avg
    rw [Nat.card_congr e.toEquiv]
    congr 1
    simp only [finsum_eq_sum_of_fintype]
    refine Fintype.sum_equiv
      (e.toEquiv.prodCongr (e.toEquiv.prodCongr (e.toEquiv.prodCongr e.toEquiv))) _ _
      (fun p => ?_)
    refine Finset.prod_congr rfl (fun ε _ => ?_)
    show f (e (cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε))
      = f (cubeVertex (e p.1) (e p.2.1) (e p.2.2.1) (e p.2.2.2) ε)
    simp only [cubeVertex, map_add, map_nsmul]
  
  have hgen : ∀ {ι : Type u_1} [Fintype ι] [DecidableEq ι] {A : ι → Type u_1}
      [∀ j, CommRing (A j)], (∀ j, Finite (A j)) → ∀ (H : (∀ j, A j) → ℝ), H 1 = 1 →
      (∀ u v, H (u * v) = H u * H v) →
      finU3Avg H = ∏ j, finU3Avg (fun y : A j => H (Pi.mulSingle j y)) := by
    intro ι _ _ A _ hfin H hH1 hHmul
    haveI : ∀ j, Fintype (A j) := fun j => @Fintype.ofFinite (A j) (hfin j)
    have hdecomp : ∀ u, H u = ∏ j, H (Pi.mulSingle j (u j)) := by
      intro u
      conv_lhs => rw [← Finset.univ_prod_mulSingle u]
      exact Finset.prod_hom_rel (r := fun m n => H m = n) hH1
        (fun j m n h => (hHmul _ _).trans (by rw [h]))
    have hT : ∀ f : (j : ι) → A j → ℝ,
        finU3Avg (fun u : (∀ j, A j) => ∏ j, f j (u j)) = ∏ j, finU3Avg (f j) := by
      intro f
      unfold finU3Avg
      simp only [finsum_eq_sum_of_fintype]
      rw [Nat.card_pi, Nat.cast_prod, Finset.prod_div_distrib, Finset.prod_pow]
      congr 1
      rw [Fintype.prod_sum]
      refine Fintype.sum_equiv
        { toFun := fun p j => (p.1 j, p.2.1 j, p.2.2.1 j, p.2.2.2 j)
          invFun := fun q => (fun j => (q j).1, fun j => (q j).2.1, fun j => (q j).2.2.1,
            fun j => (q j).2.2.2)
          left_inv := fun p => rfl
          right_inv := fun q => rfl } _ _ (fun p => ?_)
      refine Finset.prod_comm.trans
        (Finset.prod_congr rfl (fun j _ => Finset.prod_congr rfl (fun ε _ => ?_)))
      simp only [cubeVertex, Pi.add_apply, Pi.smul_apply, Equiv.coe_fn_mk]
    refine Eq.trans ?_ (hT (fun j y => H (Pi.mulSingle j y)))
    congr 1
    exact funext hdecomp
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : R ⧸ I ≃+* ((P : ↥(UniqueFactorizationMonoid.factors I).toFinset) →
      R ⧸ (P : Ideal R) ^ Multiset.count (P : Ideal R) (UniqueFactorizationMonoid.factors I)),
      ∀ ℓ : R, Φ (Ideal.Quotient.mk I ℓ) = fun P : ↥(UniqueFactorizationMonoid.factors I).toFinset =>
        Ideal.Quotient.mk ((P : Ideal R) ^
          Multiset.count (P : Ideal R) (UniqueFactorizationMonoid.factors I)) ℓ :=
    ⟨IsDedekindDomain.quotientEquivPiFactors hI, IsDedekindDomain.quotientEquivPiFactors_mk hI⟩
  
  have hC : ∀ (P : Ideal R) (hP : P ∈ (UniqueFactorizationMonoid.factors I).toFinset) (x ℓ : R),
      Φ (Ideal.Quotient.mk I ℓ) =
        Pi.mulSingle (⟨P, hP⟩ : ↥(UniqueFactorizationMonoid.factors I).toFinset)
          (Ideal.Quotient.mk (P ^ Multiset.count P (UniqueFactorizationMonoid.factors I)) x) ↔
      (ℓ - x ∈ P ^ Multiset.count P (UniqueFactorizationMonoid.factors I) ∧
        ∀ P' ∈ (UniqueFactorizationMonoid.factors I).toFinset, P' ≠ P →
          ℓ - 1 ∈ P' ^ Multiset.count P' (UniqueFactorizationMonoid.factors I)) := by
    intro P hP x ℓ
    rw [hΦ ℓ]
    constructor
    · intro h
      refine ⟨?_, fun P' hP' hne => ?_⟩
      · have h' := congrFun h ⟨P, hP⟩
        rw [Pi.mulSingle_eq_same] at h'
        exact Ideal.Quotient.eq.mp h'
      · have h' := congrFun h ⟨P', hP'⟩
        rw [Pi.mulSingle_eq_of_ne (fun hh => hne (congrArg Subtype.val hh))] at h'
        exact Ideal.Quotient.eq.mp (h'.trans (map_one (Ideal.Quotient.mk _)).symm)
    · rintro ⟨h1, h2⟩
      funext j
      by_cases hj : j = ⟨P, hP⟩
      · subst hj
        rw [Pi.mulSingle_eq_same]
        exact Ideal.Quotient.eq.mpr h1
      · rw [Pi.mulSingle_eq_of_ne hj]
        exact (Ideal.Quotient.eq.mpr (h2 j.1 j.2 (fun hh => hj (Subtype.ext hh)))).trans
          (map_one (Ideal.Quotient.mk _))
  have hfin : ∀ j : ↥(UniqueFactorizationMonoid.factors I).toFinset,
      Finite (R ⧸ (j : Ideal R) ^ Multiset.count (j : Ideal R) (UniqueFactorizationMonoid.factors I)) := by
    intro j
    refine Finite.of_surjective (fun z : R ⧸ I => Φ z j)
      (fun y => ⟨Φ.symm (Pi.mulSingle j y), ?_⟩)
    show Φ (Φ.symm (Pi.mulSingle j y)) j = y
    rw [RingEquiv.apply_symm_apply, Pi.mulSingle_eq_same]
  have hH1 : Gbar (Φ.symm 1) = 1 := by
    rw [map_one, ← map_one (Ideal.Quotient.mk I), hGbar, hG1]
  have hHmul : ∀ u v, Gbar (Φ.symm (u * v)) = Gbar (Φ.symm u) * Gbar (Φ.symm v) := by
    intro u v
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (Φ.symm u)
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (Φ.symm v)
    rw [map_mul, ← hx, ← hy, ← map_mul, hGbar, hGbar, hGbar, hGmul]
  have hGiso : finU3Avg Gbar = finU3Avg (fun u => Gbar (Φ.symm u)) := by
    have h1 : finU3Avg (fun x => Gbar (Φ.symm (Φ.toAddEquiv x)))
        = finU3Avg (fun u => Gbar (Φ.symm u)) :=
      hiso Φ.toAddEquiv (fun u => Gbar (Φ.symm u))
    have h2 : (fun x => Gbar (Φ.symm (Φ.toAddEquiv x))) = Gbar := by
      funext x
      show Gbar (Φ.symm (Φ x)) = Gbar x
      rw [RingEquiv.symm_apply_apply]
    rw [← h1, h2]
  refine ⟨(UniqueFactorizationMonoid.factors I).toFinset,
    fun P => Multiset.count P (UniqueFactorizationMonoid.factors I),
    fun P y => if hP : P ∈ (UniqueFactorizationMonoid.factors I).toFinset then
      Gbar (Φ.symm (Pi.mulSingle (⟨P, hP⟩ : ↥(UniqueFactorizationMonoid.factors I).toFinset) y))
      else 0, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro P
    rw [Multiset.mem_toFinset, UniqueFactorizationMonoid.factors_eq_normalizedFactors,
      Ideal.mem_normalizedFactors_iff hI]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨h1, fun h => hI (le_bot_iff.mp (by rw [← h]; exact h2)), h2⟩
    · rintro ⟨h1, -, h2⟩
      exact ⟨h1, h2⟩
  · intro P hP
    exact Multiset.count_pos.mpr (Multiset.mem_toFinset.mp hP)
  · beta_reduce
    rw [← Finset.prod_multiset_count, UniqueFactorizationMonoid.factors_eq_normalizedFactors,
      prod_normalizedFactors_eq_self hI]
  · intro P hP x
    obtain ⟨ℓ, hℓ⟩ := Ideal.Quotient.mk_surjective
      (Φ.symm (Pi.mulSingle (⟨P, hP⟩ : ↥(UniqueFactorizationMonoid.factors I).toFinset)
        (Ideal.Quotient.mk (P ^ Multiset.count P (UniqueFactorizationMonoid.factors I)) x)))
    exact ⟨ℓ, (hC P hP x ℓ).mp (by rw [hℓ, RingEquiv.apply_symm_apply])⟩
  · intro P hP x ℓ h1 h2
    have h := (hC P hP x ℓ).mpr ⟨h1, h2⟩
    have h' : Φ.symm (Pi.mulSingle (⟨P, hP⟩ : ↥(UniqueFactorizationMonoid.factors I).toFinset)
        (Ideal.Quotient.mk (P ^ Multiset.count P (UniqueFactorizationMonoid.factors I)) x))
        = Ideal.Quotient.mk I ℓ := by
      rw [← h, RingEquiv.symm_apply_apply]
    dsimp only
    rw [dif_pos hP, h', hGbar]
  · refine hGiso.trans ((hgen hfin (fun u => Gbar (Φ.symm u)) hH1 hHmul).trans ?_)
    rw [← Finset.prod_coe_sort (UniqueFactorizationMonoid.factors I).toFinset]
    refine Fintype.prod_congr _ _ (fun j => ?_)
    congr 1
    funext y
    dsimp only
    rw [dif_pos j.2]

theorem primRealChar_local_factor {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (h𝔮 : 𝔮 ≠ ⊥)
    (F : NumberField.RingOfIntegers K → ℤ) (hF : IsPrimRealCharMod 𝔮 F)
    (G : NumberField.RingOfIntegers K → ℝ)
    (hGc : ∀ ℓ, CoprimeToNat (Ideal.absNorm 𝔮) ℓ → G ℓ = (F ℓ : ℝ))
    (hGn : ∀ ℓ, ¬ CoprimeToNat (Ideal.absNorm 𝔮) ℓ → G ℓ = 0)
    (S : Finset (Ideal (NumberField.RingOfIntegers K)))
    (a : Ideal (NumberField.RingOfIntegers K) → ℕ)
    (hS : ∀ P, P ∈ S ↔ (P.IsPrime ∧ P ≠ ⊥ ∧
        Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)} ≤ P))
    (ha : ∀ P ∈ S, 1 ≤ a P)
    (hprod : Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)}
        = ∏ P ∈ S, P ^ a P)
    (P : Ideal (NumberField.RingOfIntegers K)) (hP : P ∈ S)
    (g : NumberField.RingOfIntegers K ⧸ P ^ a P → ℝ)
    (hex : ∀ x, ∃ ℓ, ℓ - x ∈ P ^ a P ∧ ∀ P' ∈ S, P' ≠ P → ℓ - 1 ∈ P' ^ a P')
    (hlift : ∀ x ℓ, ℓ - x ∈ P ^ a P → (∀ P' ∈ S, P' ≠ P → ℓ - 1 ∈ P' ^ a P') →
        g (Ideal.Quotient.mk (P ^ a P) x) = G ℓ) :
    (∀ y, |g y| ≤ 1) ∧
    (𝔮 ≤ P → ¬ 𝔮 ≤ P ^ 2 →
      ∃ η : NumberField.RingOfIntegers K ⧸ P → ℝ,
        (∀ x, g (Ideal.Quotient.mk (P ^ a P) x) = η (Ideal.Quotient.mk P x)) ∧
        (∀ u v, η (u * v) = η u * η v) ∧ η 0 = 0 ∧
        (∀ u, u ≠ 0 → η u = 1 ∨ η u = -1) ∧ ∃ u, η u = -1) :=
by
  classical
  obtain ⟨hF1, hFper, hFmul, hFval, hFprim⟩ := hF
  obtain ⟨hpr, hne, hIP⟩ := (hS P).mp hP
  have haP := ha P hP
  have hPa : P ^ a P ≤ P := Ideal.pow_le_self (by omega)
  
  have hcop : ∀ ℓ, CoprimeToNat (Ideal.absNorm 𝔮) ℓ ↔ ∀ P' ∈ S, ℓ ∉ P' := by
    intro ℓ
    constructor
    · intro h P' hP'
      obtain ⟨hpr', hne', hle'⟩ := (hS P').mp hP'
      exact h ⟨P', hpr', hne'⟩ ((Ideal.span_singleton_le_iff_mem P').mp hle')
    · intro h 𝔭 h𝔭
      exact h 𝔭.asIdeal ((hS _).mpr ⟨𝔭.isPrime, 𝔭.ne_bot,
        (Ideal.span_singleton_le_iff_mem _).mpr h𝔭⟩)
  
  have hcopI : ∀ ℓ, CoprimeToNat (Ideal.absNorm 𝔮) ℓ → IsCoprime (Ideal.span {ℓ}) 𝔮 := by
    intro ℓ hℓ
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h
    obtain ⟨𝔪, h𝔪max, h𝔪⟩ := Ideal.exists_le_maximal _ h
    have hq𝔪 : 𝔮 ≤ 𝔪 := le_sup_right.trans h𝔪
    have hℓ𝔪 : ℓ ∈ 𝔪 := (le_sup_left.trans h𝔪) (Ideal.mem_span_singleton_self ℓ)
    have h𝔪ne : 𝔪 ≠ ⊥ := by
      rintro rfl
      exact h𝔮 (le_bot_iff.mp hq𝔪)
    exact hℓ ⟨𝔪, h𝔪max.isPrime, h𝔪ne⟩ (hq𝔪 (Ideal.absNorm_mem 𝔮)) hℓ𝔪
  
  have hL1 : ∀ ℓ : NumberField.RingOfIntegers K,
      (∀ P' ∈ S, P' ≠ P → ℓ - 1 ∈ P' ^ a P') → ∀ P' ∈ S, P' ≠ P → ℓ ∉ P' := by
    intro ℓ h2 P' hP' hne' hℓ
    have h1 : ℓ - 1 ∈ P' :=
      Ideal.pow_le_self (by have := ha P' hP'; omega) (h2 P' hP' hne')
    have h1' : (1 : NumberField.RingOfIntegers K) ∈ P' := by
      have := P'.sub_mem hℓ h1
      simpa using this
    exact ((hS P').mp hP').1.ne_top ((Ideal.eq_top_iff_one _).mpr h1')
  have hL2 : ∀ x ℓ, ℓ - x ∈ P ^ a P → (∀ P' ∈ S, P' ≠ P → ℓ - 1 ∈ P' ^ a P') →
      (CoprimeToNat (Ideal.absNorm 𝔮) ℓ ↔ x ∉ P) := by
    intro x ℓ h1 h2
    rw [hcop ℓ]
    have h1' : ℓ - x ∈ P := hPa h1
    constructor
    · intro h hx
      apply h P hP
      have := P.add_mem h1' hx
      simpa using this
    · intro hx P' hP' hℓ
      by_cases hPP : P' = P
      · rw [hPP] at hℓ
        apply hx
        have := P.sub_mem hℓ h1'
        simpa using this
      · exact hL1 ℓ h2 P' hP' hPP hℓ
  have hL3 : ∀ ℓ, CoprimeToNat (Ideal.absNorm 𝔮) ℓ → G ℓ = 1 ∨ G ℓ = -1 := by
    intro ℓ h
    rw [hGc ℓ h]
    rcases hFval ℓ (hcopI ℓ h) with h' | h'
    · left; rw [h']; norm_num
    · right; rw [h']; norm_num
  
  have part1 : ∀ y, |g y| ≤ 1 := by
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨ℓ, h1, h2⟩ := hex x
    rw [hlift x ℓ h1 h2]
    by_cases hc : CoprimeToNat (Ideal.absNorm 𝔮) ℓ
    · rcases hL3 ℓ hc with h | h <;> rw [h] <;> simp
    · rw [hGn ℓ hc]; simp
  refine ⟨part1, fun hqP hqP2 => ?_⟩
  
  have hI𝔮 : Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)} ≤ 𝔮 :=
    (Ideal.span_singleton_le_iff_mem 𝔮).mpr (Ideal.absNorm_mem 𝔮)
  obtain ⟨𝔟, hb⟩ := Ideal.dvd_iff_le.mpr hqP
  have hbP : ¬ 𝔟 ≤ P := by
    intro h
    apply hqP2
    rw [hb, sq]
    exact Ideal.mul_mono_right h
  haveI hmax : P.IsMaximal := hpr.isMaximal hne
  have hsup : P ⊔ 𝔟 = ⊤ := by
    by_contra h
    apply hbP
    have := hmax.eq_of_le h le_sup_left
    rw [this]
    exact le_sup_right
  have hlt : 𝔮 < 𝔟 := by
    refine lt_of_le_of_ne ?_ ?_
    · rw [hb]; exact Ideal.mul_le_left
    · intro h; apply hbP; rw [← h]; exact hqP
  have hPb : ∀ y, y ∈ P → y ∈ 𝔟 → y ∈ 𝔮 := by
    intro y h1 h2
    rw [hb, Ideal.mul_eq_inf_of_coprime hsup]
    exact ⟨h1, h2⟩
  have hJ : ∀ y, (∀ P' ∈ S, P' ≠ P → y ∈ P' ^ a P') → y ∈ 𝔟 := by
    intro y hy
    have hJ'le : (∏ P' ∈ S.erase P, P' ^ a P') ≤ 𝔟 := by
      have hk : P ^ a P = P * P ^ (a P - 1) := by
        rw [mul_comm, pow_sub_one_mul (by omega : a P ≠ 0)]
      have hdiv : 𝔮 ∣ Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)} :=
        Ideal.dvd_iff_le.mpr hI𝔮
      rw [hprod, ← Finset.mul_prod_erase S (fun P' => P' ^ a P') hP, hk, hb, mul_assoc] at hdiv
      have hP0 : P ≠ 0 := by rwa [Ne, Ideal.zero_eq_bot]
      have h2 := (mul_dvd_mul_iff_left hP0).mp hdiv
      have hcp : IsCoprime 𝔟 (P ^ (a P - 1)) :=
        ((Ideal.isCoprime_iff_sup_eq.mpr hsup).symm).pow_right
      exact Ideal.le_of_dvd (hcp.dvd_of_dvd_mul_left h2)
    apply hJ'le
    have hprime : ∀ i ∈ S.erase P, Prime (id i) := by
      intro i hi
      obtain ⟨hpr', hne', -⟩ := (hS i).mp (Finset.mem_of_mem_erase hi)
      exact Ideal.prime_of_isPrime hne' hpr'
    have hmem : y ∈ (S.erase P).inf (fun i => id i ^ a i) := by
      rw [Submodule.mem_finsetInf]
      intro i hi
      exact hy i (Finset.mem_of_mem_erase hi) (Finset.ne_of_mem_erase hi)
    rw [IsDedekindDomain.inf_prime_pow_eq_prod (S.erase P) id a hprime
      (fun _ _ _ _ h => h)] at hmem
    simpa using hmem
  
  have hD : ∀ x x' ℓ ℓ', ℓ - x ∈ P ^ a P → (∀ P' ∈ S, P' ≠ P → ℓ - 1 ∈ P' ^ a P') →
      ℓ' - x' ∈ P ^ a P → (∀ P' ∈ S, P' ≠ P → ℓ' - 1 ∈ P' ^ a P') →
      x - x' ∈ P → ℓ - ℓ' ∈ 𝔮 := by
    intro x x' ℓ ℓ' h1 h2 h1' h2' hxx
    apply hPb
    · have e : ℓ - ℓ' = (ℓ - x) - (ℓ' - x') + (x - x') := by ring
      rw [e]
      exact P.add_mem (P.sub_mem (hPa h1) (hPa h1')) hxx
    · apply hJ
      intro P' hP' hne'
      have e : ℓ - ℓ' = (ℓ - 1) - (ℓ' - 1) := by ring
      rw [e]
      exact Ideal.sub_mem _ (h2 P' hP' hne') (h2' P' hP' hne')
  
  have hW : ∀ x x', x - x' ∈ P →
      g (Ideal.Quotient.mk (P ^ a P) x) = g (Ideal.Quotient.mk (P ^ a P) x') := by
    intro x x' hxx
    obtain ⟨ℓ, h1, h2⟩ := hex x
    obtain ⟨ℓ', h1', h2'⟩ := hex x'
    rw [hlift x ℓ h1 h2, hlift x' ℓ' h1' h2']
    have hiff : x ∈ P ↔ x' ∈ P := by
      constructor
      · intro hx; have := P.sub_mem hx hxx; simpa using this
      · intro hx; have := P.add_mem hx hxx; simpa using this
    by_cases hx : x ∈ P
    · rw [hGn ℓ (fun h => (hL2 x ℓ h1 h2).mp h hx),
        hGn ℓ' (fun h => (hL2 x' ℓ' h1' h2').mp h (hiff.mp hx))]
    · rw [hGc ℓ ((hL2 x ℓ h1 h2).mpr hx),
        hGc ℓ' ((hL2 x' ℓ' h1' h2').mpr (fun h => hx (hiff.mpr h))),
        hFper ℓ ℓ' (hD x x' ℓ ℓ' h1 h2 h1' h2' hxx)]
  
  obtain ⟨η, hη⟩ : ∃ η : NumberField.RingOfIntegers K ⧸ P → ℝ,
      ∀ x, g (Ideal.Quotient.mk (P ^ a P) x) = η (Ideal.Quotient.mk P x) := by
    refine ⟨fun z => g (Ideal.Quotient.mk (P ^ a P)
      (Function.surjInv (Ideal.Quotient.mk_surjective (I := P)) z)), ?_⟩
    intro x
    apply hW
    rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact (Function.surjInv_eq (Ideal.Quotient.mk_surjective (I := P)) _).symm
  refine ⟨η, hη, ?_, ?_, ?_, ?_⟩
  
  · intro u v
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨x', rfl⟩ := Ideal.Quotient.mk_surjective v
    rw [show (Ideal.Quotient.mk P) x * (Ideal.Quotient.mk P) x'
        = Ideal.Quotient.mk P (x * x') from (map_mul _ _ _).symm, ← hη, ← hη, ← hη]
    obtain ⟨ℓ, h1, h2⟩ := hex x
    obtain ⟨ℓ', h1', h2'⟩ := hex x'
    have hm1 : ℓ * ℓ' - x * x' ∈ P ^ a P := by
      have e : ℓ * ℓ' - x * x' = (ℓ - x) * ℓ' + x * (ℓ' - x') := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ h1) (Ideal.mul_mem_left _ _ h1')
    have hm2 : ∀ P' ∈ S, P' ≠ P → ℓ * ℓ' - 1 ∈ P' ^ a P' := by
      intro P' hP' hne'
      have e : ℓ * ℓ' - 1 = (ℓ - 1) * ℓ' + (ℓ' - 1) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (h2 P' hP' hne')) (h2' P' hP' hne')
    rw [hlift _ _ hm1 hm2, hlift x ℓ h1 h2, hlift x' ℓ' h1' h2']
    by_cases hc : CoprimeToNat (Ideal.absNorm 𝔮) ℓ
    · by_cases hc' : CoprimeToNat (Ideal.absNorm 𝔮) ℓ'
      · have hcc : CoprimeToNat (Ideal.absNorm 𝔮) (ℓ * ℓ') := by
          intro 𝔭 h𝔭 hmem
          rcases 𝔭.isPrime.mem_or_mem hmem with h | h
          · exact hc 𝔭 h𝔭 h
          · exact hc' 𝔭 h𝔭 h
        rw [hGc _ hcc, hGc _ hc, hGc _ hc', hFmul, Int.cast_mul]
      · have hcc : ¬ CoprimeToNat (Ideal.absNorm 𝔮) (ℓ * ℓ') := fun h =>
          hc' (fun 𝔭 h𝔭 hmem => h 𝔭 h𝔭 (Ideal.mul_mem_left _ _ hmem))
        rw [hGn _ hcc, hGn _ hc', mul_zero]
    · have hcc : ¬ CoprimeToNat (Ideal.absNorm 𝔮) (ℓ * ℓ') := fun h =>
        hc (fun 𝔭 h𝔭 hmem => h 𝔭 h𝔭 (Ideal.mul_mem_right _ _ hmem))
      rw [hGn _ hcc, hGn _ hc, zero_mul]
  
  · have h0 := hη 0
    obtain ⟨ℓ, h1, h2⟩ := hex 0
    rw [hlift 0 ℓ h1 h2, map_zero] at h0
    rw [← h0]
    exact hGn ℓ (fun h => (hL2 0 ℓ h1 h2).mp h P.zero_mem)
  
  · intro u hu
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective u
    have hx : x ∉ P := fun h => hu (Ideal.Quotient.eq_zero_iff_mem.mpr h)
    obtain ⟨ℓ, h1, h2⟩ := hex x
    rw [← hη, hlift x ℓ h1 h2]
    exact hL3 ℓ ((hL2 x ℓ h1 h2).mpr hx)
  
  · obtain ⟨r, hr1, hrc, hFr⟩ := hFprim 𝔟 hlt
    refine ⟨Ideal.Quotient.mk P r, ?_⟩
    obtain ⟨ℓ, h1, h2⟩ := hex r
    rw [← hη, hlift r ℓ h1 h2]
    have hℓr : ℓ - r ∈ 𝔮 := by
      apply hPb _ (hPa h1)
      have e : ℓ - r = (ℓ - 1) - (r - 1) := by ring
      rw [e]
      exact Ideal.sub_mem _ (hJ _ h2) hr1
    have hrP : r ∉ P := by
      intro hrP
      have h := Ideal.isCoprime_iff_sup_eq.mp hrc
      apply hpr.ne_top
      rw [eq_top_iff, ← h]
      exact sup_le ((Ideal.span_singleton_le_iff_mem P).mpr hrP) hqP
    rw [hGc ℓ ((hL2 r ℓ h1 h2).mpr hrP), hFper ℓ r hℓr, hFr]
    norm_num

theorem kai_prime_power_numeric (K : Type u) [Field K] [NumberField K] :
    ∃ C₃ : ℝ, 1 ≤ C₃ ∧
      ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
      (∀ P : Ideal (NumberField.RingOfIntegers K), P.IsMaximal → ∀ e : ℕ,
          (2 : NumberField.RingOfIntegers K) ∉ P ^ (e + 1) → ¬ 𝔮 ≤ P ^ (2 * e + 2)) →
      ∀ (S : Finset (Ideal (NumberField.RingOfIntegers K))),
        (∀ P ∈ S, P.IsMaximal) →
        (∀ P : Ideal (NumberField.RingOfIntegers K), P.IsMaximal → 𝔮 ≤ P → P ∈ S) →
        ∀ b : Ideal (NumberField.RingOfIntegers K) → ℝ,
          (∀ P ∈ S, 0 ≤ b P ∧ b P ≤ 1) →
          (∀ P ∈ S, 𝔮 ≤ P → (2 : NumberField.RingOfIntegers K) ∉ P →
              b P ≤ 8 / (Ideal.absNorm P : ℝ)) →
          ∏ P ∈ S, b P ≤ C₃ / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4) :=
by
  classical
  
  have s1 : ∀ (P I : Ideal (NumberField.RingOfIntegers K)), P.IsPrime → P ≠ ⊥ → I ≠ ⊥ →
      ∀ m : ℕ, I ≤ P ^ m ↔
        m ≤ Multiset.count P (UniqueFactorizationMonoid.normalizedFactors I) := by
    intro P I hP hP0 hI m
    have hPp : Prime P := Ideal.prime_of_isPrime hP0 hP
    rw [← Ideal.dvd_iff_le, pow_dvd_iff_le_emultiplicity,
      UniqueFactorizationMonoid.emultiplicity_eq_count_normalizedFactors hPp.irreducible hI,
      normalize_eq, Nat.cast_le]
  
  obtain ⟨M, hM⟩ : ∃ M : ℕ, ∀ T : Finset (Ideal (NumberField.RingOfIntegers K)),
      (T.filter (fun P => (Ideal.absNorm P : ℝ) < 16)).card ≤ M := by
    have hfin := Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) 15
    refine ⟨hfin.toFinset.card, fun T => Finset.card_le_card ?_⟩
    intro P hP
    rw [Finset.mem_filter] at hP
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq]
    have : Ideal.absNorm P < 16 := by exact_mod_cast hP.2
    omega
  obtain ⟨D, hD_def⟩ : ∃ D : ℕ,
      D = Ideal.absNorm (Ideal.span {(8 : NumberField.RingOfIntegers K)}) := ⟨_, rfl⟩
  have h8ne : (8 : NumberField.RingOfIntegers K) ≠ 0 := by
    have : ((8 : ℕ) : NumberField.RingOfIntegers K) ≠ 0 := by
      exact_mod_cast (by norm_num : (8:ℕ) ≠ 0)
    simpa using this
  have hD1 : 1 ≤ D := by
    rw [hD_def, Nat.one_le_iff_ne_zero, Ne, Ideal.absNorm_eq_zero_iff,
      Ideal.span_singleton_eq_bot]
    exact h8ne
  have hC1 : (1 : ℝ) ≤ (D : ℝ) * 16 ^ M := by
    have h1 : (1 : ℝ) ≤ D := by exact_mod_cast hD1
    have h2 : (1 : ℝ) ≤ 16 ^ M := one_le_pow₀ (by norm_num)
    nlinarith
  refine ⟨(D : ℝ) * 16 ^ M, hC1, ?_⟩
  intro 𝔮 h𝔮 hcond S hSmax hcover b hb01 hb8
  
  set T := S.filter (fun P => 𝔮 ≤ P ∧ (2 : NumberField.RingOfIntegers K) ∉ P) with hT_def
  have hT : ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsMaximal → 𝔮 ≤ P →
      (2 : NumberField.RingOfIntegers K) ∉ P → P ∈ T := by
    intro P hP h1 h2
    rw [hT_def, Finset.mem_filter]
    exact ⟨hcover P hP h1, h1, h2⟩
  have s2 : (∏ P ∈ T, P) * Ideal.span {(8 : NumberField.RingOfIntegers K)} ≤ 𝔮 := by
    set 𝔞 := ∏ P ∈ T, P with h𝔞_def
    set W := Ideal.span {(2 : NumberField.RingOfIntegers K)} with hW_def
    have h2ne : (2 : NumberField.RingOfIntegers K) ≠ 0 := two_ne_zero
    have hW : W ≠ ⊥ := by rw [hW_def, Ne, Ideal.span_singleton_eq_bot]; exact h2ne
    have hE : Ideal.span {(8 : NumberField.RingOfIntegers K)} = W ^ 3 := by
      rw [hW_def, Ideal.span_singleton_pow]; norm_num
    rw [hE]
    by_cases ha : 𝔞 = ⊥
    · rw [ha]; simp
    have hW3 : W ^ 3 ≠ ⊥ := pow_ne_zero _ hW
    have hJ : 𝔞 * W ^ 3 ≠ ⊥ := by
      intro h
      rcases Ideal.mul_eq_bot.mp h with h' | h'
      · exact ha h'
      · exact hW3 h'
    have hcount : ∀ P, Multiset.count P (UniqueFactorizationMonoid.normalizedFactors (𝔞 * W ^ 3))
        = Multiset.count P (UniqueFactorizationMonoid.normalizedFactors 𝔞)
          + 3 * Multiset.count P (UniqueFactorizationMonoid.normalizedFactors W) := by
      intro P
      rw [UniqueFactorizationMonoid.normalizedFactors_mul ha hW3,
        UniqueFactorizationMonoid.normalizedFactors_pow, Multiset.count_add,
        Multiset.count_nsmul]
    apply Ideal.le_of_dvd
    rw [UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors h𝔮 hJ,
      Multiset.le_iff_count]
    intro P
    rw [hcount]
    by_cases hk : Multiset.count P (UniqueFactorizationMonoid.normalizedFactors 𝔮) = 0
    · omega
    have hmem : P ∈ UniqueFactorizationMonoid.normalizedFactors 𝔮 :=
      Multiset.count_pos.mp (Nat.pos_of_ne_zero hk)
    obtain ⟨hPp, h𝔮P⟩ := (Ideal.mem_normalizedFactors_iff h𝔮).mp hmem
    have hP0 : P ≠ ⊥ := by
      rintro rfl
      exact h𝔮 (le_bot_iff.mp h𝔮P)
    have hPmax : P.IsMaximal := hPp.isMaximal hP0
    by_cases h2P : (2 : NumberField.RingOfIntegers K) ∈ P
    · set e := Multiset.count P (UniqueFactorizationMonoid.normalizedFactors W) with he_def
      have he1 : 1 ≤ e := by
        rw [he_def, ← s1 P W hPp hP0 hW 1, pow_one, hW_def, Ideal.span_le,
          Set.singleton_subset_iff]
        exact h2P
      have h2e : (2 : NumberField.RingOfIntegers K) ∉ P ^ (e + 1) := by
        intro h
        have hle : W ≤ P ^ (e + 1) := by
          rw [hW_def, Ideal.span_le, Set.singleton_subset_iff]; exact h
        have := (s1 P W hPp hP0 hW (e + 1)).mp hle
        omega
      have hnot := hcond P hPmax e h2e
      have hk2 : Multiset.count P (UniqueFactorizationMonoid.normalizedFactors 𝔮) < 2 * e + 2 := by
        by_contra hc
        push_neg at hc
        exact hnot ((s1 P 𝔮 hPp hP0 h𝔮 (2 * e + 2)).mpr hc)
      omega
    · have hnot := hcond P hPmax 0 (by rw [zero_add, pow_one]; exact h2P)
      have hk2 : Multiset.count P (UniqueFactorizationMonoid.normalizedFactors 𝔮) < 2 := by
        by_contra hc
        push_neg at hc
        exact hnot ((s1 P 𝔮 hPp hP0 h𝔮 (2 * 0 + 2)).mpr (by simpa using hc))
      have hPT : P ∈ T := hT P hPmax h𝔮P h2P
      have ha1 : 1 ≤ Multiset.count P (UniqueFactorizationMonoid.normalizedFactors 𝔞) := by
        rw [← s1 P 𝔞 hPp hP0 ha 1, pow_one]
        exact Ideal.le_of_dvd (Finset.dvd_prod_of_mem (fun P => P) hPT)
      omega
  
  have hQ0 : Ideal.absNorm 𝔮 ≠ 0 := fun h => h𝔮 (Ideal.absNorm_eq_zero_iff.mp h)
  have hTmem : ∀ P ∈ T, P ∈ S ∧ 𝔮 ≤ P ∧ (2 : NumberField.RingOfIntegers K) ∉ P := by
    intro P hP
    rw [hT_def, Finset.mem_filter] at hP
    exact ⟨hP.1, hP.2.1, hP.2.2⟩
  have hTne : ∀ P ∈ T, 1 ≤ Ideal.absNorm P := by
    intro P hP
    rw [Nat.one_le_iff_ne_zero]
    intro h
    have h' := Ideal.absNorm_eq_zero_iff.mp h
    have := (hTmem P hP).2.1
    rw [h'] at this
    exact h𝔮 (le_bot_iff.mp this)
  have hdiv : Ideal.absNorm 𝔮 ∣ (∏ P ∈ T, Ideal.absNorm P) * D := by
    have := Ideal.absNorm_dvd_absNorm_of_le s2
    rwa [map_mul, map_prod, ← hD_def] at this
  have hprodpos : 0 < ∏ P ∈ T, Ideal.absNorm P := Finset.prod_pos (fun P hP => hTne P hP)
  have hQle : Ideal.absNorm 𝔮 ≤ (∏ P ∈ T, Ideal.absNorm P) * D :=
    Nat.le_of_dvd (Nat.mul_pos hprodpos (by omega)) hdiv
  have hQleR : (Ideal.absNorm 𝔮 : ℝ) ≤ (∏ P ∈ T, (Ideal.absNorm P : ℝ)) * D := by
    have := (Nat.cast_le (α := ℝ)).mpr hQle
    rwa [Nat.cast_mul, Nat.cast_prod] at this
  
  have hfac : ∀ P ∈ T, b P ^ 4 * (Ideal.absNorm P : ℝ)
      ≤ if (Ideal.absNorm P : ℝ) < 16 then (16 : ℝ) else 1 := by
    intro P hP
    obtain ⟨hPS, h𝔮P, h2P⟩ := hTmem P hP
    have hx1 : (1:ℝ) ≤ Ideal.absNorm P := by exact_mod_cast hTne P hP
    obtain ⟨hb0, hb1⟩ := hb01 P hPS
    split_ifs with hx
    · have : b P ^ 4 ≤ 1 := pow_le_one₀ hb0 hb1
      nlinarith
    · push_neg at hx
      have hb8' := hb8 P hPS h𝔮P h2P
      have hxpos : (0 : ℝ) < Ideal.absNorm P := by linarith
      have hbx : b P * (Ideal.absNorm P : ℝ) ≤ 8 := by rwa [le_div_iff₀ hxpos] at hb8'
      have h1 : (b P * (Ideal.absNorm P : ℝ)) ^ 4 ≤ 8 ^ 4 :=
        pow_le_pow_left₀ (mul_nonneg hb0 hxpos.le) hbx 4
      have h2 : (16:ℝ) ^ 3 ≤ (Ideal.absNorm P : ℝ) ^ 3 := pow_le_pow_left₀ (by norm_num) hx 3
      have h3 : (b P ^ 4 * (Ideal.absNorm P : ℝ)) * (Ideal.absNorm P : ℝ) ^ 3
          ≤ 1 * (Ideal.absNorm P : ℝ) ^ 3 := by
        calc (b P ^ 4 * (Ideal.absNorm P : ℝ)) * (Ideal.absNorm P : ℝ) ^ 3
            = (b P * (Ideal.absNorm P : ℝ)) ^ 4 := by ring
          _ ≤ 8 ^ 4 := h1
          _ = 16 ^ 3 := by norm_num
          _ ≤ (Ideal.absNorm P : ℝ) ^ 3 := h2
          _ = 1 * (Ideal.absNorm P : ℝ) ^ 3 := by ring
      exact le_of_mul_le_mul_right h3 (by positivity)
  have hprodT : ∏ P ∈ T, (b P ^ 4 * (Ideal.absNorm P : ℝ)) ≤ 16 ^ M := by
    calc ∏ P ∈ T, (b P ^ 4 * (Ideal.absNorm P : ℝ))
        ≤ ∏ P ∈ T, (if (Ideal.absNorm P : ℝ) < 16 then (16:ℝ) else 1) :=
          Finset.prod_le_prod (fun P _ => by positivity) hfac
      _ = 16 ^ (T.filter (fun P => (Ideal.absNorm P : ℝ) < 16)).card := by
          rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const_one, mul_one]
      _ ≤ 16 ^ M := pow_le_pow_right₀ (by norm_num) (hM T)
  
  have hβ0 : 0 ≤ ∏ P ∈ T, b P :=
    Finset.prod_nonneg (fun P hP => (hb01 P (hTmem P hP).1).1)
  have hB0 : 0 ≤ ∏ P ∈ S, b P := Finset.prod_nonneg (fun P hP => (hb01 P hP).1)
  have hBβ : ∏ P ∈ S, b P ≤ ∏ P ∈ T, b P := by
    have hsplit := Finset.prod_filter_mul_prod_filter_not S
      (fun P => 𝔮 ≤ P ∧ (2 : NumberField.RingOfIntegers K) ∉ P) b
    rw [← hT_def] at hsplit
    rw [← hsplit]
    apply mul_le_of_le_one_right hβ0
    apply Finset.prod_le_one
    · intro P hP; exact (hb01 P (Finset.mem_filter.mp hP).1).1
    · intro P hP; exact (hb01 P (Finset.mem_filter.mp hP).1).2
  
  have hQpos : (0 : ℝ) < Ideal.absNorm 𝔮 := by exact_mod_cast Nat.pos_of_ne_zero hQ0
  have hprodsplit : ∏ P ∈ T, (b P ^ 4 * (Ideal.absNorm P : ℝ))
      = (∏ P ∈ T, b P) ^ 4 * ∏ P ∈ T, (Ideal.absNorm P : ℝ) := by
    rw [Finset.prod_mul_distrib, Finset.prod_pow]
  have hkey : (∏ P ∈ S, b P) ^ 4 * (Ideal.absNorm 𝔮 : ℝ) ≤ (D : ℝ) * 16 ^ M := by
    have hB4 : (∏ P ∈ S, b P) ^ 4 ≤ (∏ P ∈ T, b P) ^ 4 := pow_le_pow_left₀ hB0 hBβ 4
    have hprodx : 0 ≤ ∏ P ∈ T, (Ideal.absNorm P : ℝ) :=
      Finset.prod_nonneg (fun P _ => Nat.cast_nonneg _)
    calc (∏ P ∈ S, b P) ^ 4 * (Ideal.absNorm 𝔮 : ℝ)
        ≤ (∏ P ∈ T, b P) ^ 4 * ((∏ P ∈ T, (Ideal.absNorm P : ℝ)) * D) :=
          mul_le_mul hB4 hQleR hQpos.le (pow_nonneg hβ0 4)
      _ = (D : ℝ) * ((∏ P ∈ T, b P) ^ 4 * ∏ P ∈ T, (Ideal.absNorm P : ℝ)) := by ring
      _ ≤ (D : ℝ) * 16 ^ M := by
          rw [← hprodsplit]; exact mul_le_mul_of_nonneg_left hprodT (Nat.cast_nonneg _)
  have hrpos : 0 < (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4) := Real.rpow_pos_of_pos hQpos _
  have hr4 : ((Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4)) ^ 4 = (Ideal.absNorm 𝔮 : ℝ) := by
    rw [show ((1:ℝ)/4) = ((4:ℕ):ℝ)⁻¹ by norm_num]
    exact Real.rpow_inv_natCast_pow hQpos.le (by norm_num)
  rw [le_div_iff₀ hrpos]
  by_contra hcon
  push_neg at hcon
  have h1 : ((D : ℝ) * 16 ^ M) ^ 4
      < ((∏ P ∈ S, b P) * (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4)) ^ 4 :=
    pow_lt_pow_left₀ hcon (by linarith) (by norm_num)
  have h2 : (D : ℝ) * 16 ^ M ≤ ((D : ℝ) * 16 ^ M) ^ 4 := le_self_pow₀ hC1 (by norm_num)
  have h3 : ((∏ P ∈ S, b P) * (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4)) ^ 4
      = (∏ P ∈ S, b P) ^ 4 * (Ideal.absNorm 𝔮 : ℝ) := by rw [mul_pow, hr4]
  linarith

theorem kaiResSum_eq_finU3Avg {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (Q : ℕ) (hQ : 1 ≤ Q)
    (G : NumberField.RingOfIntegers K → ℝ)
    (hG : ∀ x y, G (x + (Q : NumberField.RingOfIntegers K) * y) = G x)
    (Gbar : NumberField.RingOfIntegers K ⧸ Ideal.span {(Q : NumberField.RingOfIntegers K)} → ℝ)
    (hGbar : ∀ x, Gbar (Ideal.Quotient.mk _ x) = G x) :
    kaiResSum ω Q (fun a h₁ h₂ h₃ => ∏ ε : Fin 3 → Fin 2, G (cubeVertex a h₁ h₂ h₃ ε))
        / (Q : ℝ) ^ (4 * ν) = finU3Avg Gbar :=
by
  classical
  revert Gbar
  set I : Ideal (NumberField.RingOfIntegers K) :=
    Ideal.span {(Q : NumberField.RingOfIntegers K)} with hI_def
  intro Gbar hGbar
  set π := Ideal.Quotient.mk I with hπ
  have hQ0 : (Q : NumberField.RingOfIntegers K) ≠ 0 := by
    exact_mod_cast (show Q ≠ 0 by omega)
  have hIne : I ≠ ⊥ := by
    rw [hI_def, Ne, Ideal.span_singleton_eq_bot]; exact hQ0
  haveI : Finite (NumberField.RingOfIntegers K ⧸ I) := Ideal.finiteQuotientOfFreeOfNeBot I hIne
  letI : Fintype (NumberField.RingOfIntegers K ⧸ I) := Fintype.ofFinite _
  have hmulQ : ∀ t : NumberField.RingOfIntegers K,
      ω.equivFun (t * (Q : NumberField.RingOfIntegers K)) = (Q : ℤ) • ω.equivFun t := by
    intro t
    rw [show t * (Q : NumberField.RingOfIntegers K) = (Q : ℤ) • t by
      rw [zsmul_eq_mul]; push_cast; ring, map_zsmul]
  
  have hinj : Set.InjOn π (↑(kaiResSys ω Q) : Set (NumberField.RingOfIntegers K)) := by
    intro a ha a' ha' h
    simp only [kaiResSys, Finset.coe_image, Set.mem_image, Finset.mem_coe] at ha ha'
    obtain ⟨v, hv, rfl⟩ := ha
    obtain ⟨v', hv', rfl⟩ := ha'
    rw [hπ, Ideal.Quotient.eq, hI_def, Ideal.mem_span_singleton'] at h
    obtain ⟨t, ht⟩ := h
    have hcoord : ∀ j, v j - v' j = (Q : ℤ) * ω.equivFun t j := by
      intro j
      have h1 := congrArg (fun z => ω.equivFun z j) ht
      simp only [map_sub, LinearEquiv.apply_symm_apply, Pi.sub_apply] at h1
      rw [← h1, hmulQ, Pi.smul_apply, smul_eq_mul]
    congr 1
    funext j
    simp only [resBox, Finset.mem_Icc, Pi.le_def] at hv hv'
    have h1 := hv.1 j
    have h2 := hv.2 j
    have h3 := hv'.1 j
    have h4 := hv'.2 j
    have hd : (Q : ℤ) ∣ v j - v' j := ⟨_, hcoord j⟩
    have h0 : v j - v' j = 0 :=
      Int.eq_zero_of_abs_lt_dvd hd (by rw [abs_lt]; constructor <;> omega)
    omega
  
  have hsurj : Set.SurjOn π (↑(kaiResSys ω Q) : Set (NumberField.RingOfIntegers K))
      (↑(Finset.univ : Finset (NumberField.RingOfIntegers K ⧸ I))) := by
    intro y _
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hQpos : (0 : ℤ) < (Q : ℤ) := by exact_mod_cast hQ
    refine ⟨ω.equivFun.symm (fun j => ω.equivFun x j % (Q : ℤ)), ?_, ?_⟩
    · simp only [kaiResSys, Finset.coe_image, Set.mem_image, Finset.mem_coe]
      refine ⟨_, ?_, rfl⟩
      simp only [resBox, Finset.mem_Icc, Pi.le_def]
      constructor
      · intro j
        exact Int.emod_nonneg _ hQpos.ne'
      · intro j
        have := Int.emod_lt_of_pos (ω.equivFun x j) hQpos
        omega
    · show π _ = π x
      rw [hπ, Ideal.Quotient.eq, hI_def, Ideal.mem_span_singleton']
      refine ⟨ω.equivFun.symm (fun j => -(ω.equivFun x j / (Q : ℤ))), ?_⟩
      apply ω.equivFun.injective
      rw [hmulQ, map_sub, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
      funext j
      simp only [Pi.smul_apply, smul_eq_mul, Pi.sub_apply]
      have := Int.emod_add_mul_ediv (ω.equivFun x j) (Q : ℤ)
      linarith
  
  have hreidx : ∀ F : (NumberField.RingOfIntegers K ⧸ I) → ℝ,
      ∑ a ∈ kaiResSys ω Q, F (π a) = ∑ y, F y := by
    intro F
    exact Finset.sum_nbij π (fun a _ => Finset.mem_univ _) hinj hsurj (fun a _ => rfl)
  have hcardR : (kaiResSys ω Q).card = Q ^ ν := by
    unfold kaiResSys
    rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective]
    simp [resBox, Pi.card_Icc, Int.card_Icc]
  have hcardA : Fintype.card (NumberField.RingOfIntegers K ⧸ I) = Q ^ ν := by
    rw [← Finset.card_univ, ← hcardR]
    exact (Finset.card_nbij π (fun a _ => Finset.mem_coe.2 (Finset.mem_univ _)) hinj hsurj).symm
  
  have hcv : ∀ (a h₁ h₂ h₃ : NumberField.RingOfIntegers K) (ε : Fin 3 → Fin 2),
      G (cubeVertex a h₁ h₂ h₃ ε) = Gbar (cubeVertex (π a) (π h₁) (π h₂) (π h₃) ε) := by
    intro a h₁ h₂ h₃ ε
    rw [← hGbar]
    congr 1
  
  have hL : kaiResSum ω Q (fun a h₁ h₂ h₃ => ∏ ε : Fin 3 → Fin 2, G (cubeVertex a h₁ h₂ h₃ ε))
      = ∑ y₀, ∑ y₁, ∑ y₂, ∑ y₃, ∏ ε : Fin 3 → Fin 2, Gbar (cubeVertex y₀ y₁ y₂ y₃ ε) := by
    unfold kaiResSum
    simp only [hcv]
    rw [← hreidx (fun y₀ => ∑ y₁, ∑ y₂, ∑ y₃,
      ∏ ε : Fin 3 → Fin 2, Gbar (cubeVertex y₀ y₁ y₂ y₃ ε))]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [← hreidx (fun y₁ => ∑ y₂, ∑ y₃,
      ∏ ε : Fin 3 → Fin 2, Gbar (cubeVertex (π a) y₁ y₂ y₃ ε))]
    refine Finset.sum_congr rfl (fun h₁ _ => ?_)
    rw [← hreidx (fun y₂ => ∑ y₃,
      ∏ ε : Fin 3 → Fin 2, Gbar (cubeVertex (π a) (π h₁) y₂ y₃ ε))]
    refine Finset.sum_congr rfl (fun h₂ _ => ?_)
    rw [← hreidx (fun y₃ =>
      ∏ ε : Fin 3 → Fin 2, Gbar (cubeVertex (π a) (π h₁) (π h₂) y₃ ε))]
  
  have hR : finU3Avg Gbar
      = (∑ y₀, ∑ y₁, ∑ y₂, ∑ y₃, ∏ ε : Fin 3 → Fin 2, Gbar (cubeVertex y₀ y₁ y₂ y₃ ε))
        / (Fintype.card (NumberField.RingOfIntegers K ⧸ I) : ℝ) ^ 4 := by
    unfold finU3Avg
    rw [finsum_eq_sum_of_fintype, Nat.card_eq_fintype_card]
    simp only [Fintype.sum_prod_type]
  
  rw [hL, hR, hcardA]
  push_cast
  ring

theorem kai_real_char_finite_U3_bound (K : Type u) [Field K] [NumberField K] :
    ∃ C₃ : ℝ, 1 ≤ C₃ ∧
      ∀ (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
        (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
        ∀ ψ : NumberField.RingOfIntegers K → ℤ, IsRealRayChar 𝔮 ψ →
          KaiCharU3Bound ω 𝔮 ψ C₃ :=
by
  classical
  obtain ⟨C₃, hC₃, hnum⟩ := kai_prime_power_numeric K
  refine ⟨C₃, hC₃, ?_⟩
  intro ω 𝔮 h𝔮 ψ hψ
  unfold KaiCharU3Bound
  
  have hQ0 : Ideal.absNorm 𝔮 ≠ 0 := fun h => h𝔮 (Ideal.absNorm_eq_zero_iff.mp h)
  have hQ1 : 1 ≤ Ideal.absNorm 𝔮 := Nat.one_le_iff_ne_zero.mpr hQ0
  have hQmem : ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔮 :=
    Ideal.absNorm_mem 𝔮
  
  have hF := kaiFplus_isPrimRealCharMod 𝔮 h𝔮 ψ hψ
  have hF' := hF
  obtain ⟨hF1, hFper, hFmul, -, -⟩ := hF'
  
  have hcop1 : CoprimeToNat (Ideal.absNorm 𝔮) (1 : NumberField.RingOfIntegers K) := by
    intro 𝔭 _ h1
    exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hcopmul : ∀ x y : NumberField.RingOfIntegers K,
      CoprimeToNat (Ideal.absNorm 𝔮) (x * y) ↔
        (CoprimeToNat (Ideal.absNorm 𝔮) x ∧ CoprimeToNat (Ideal.absNorm 𝔮) y) := by
    intro x y
    constructor
    · intro h
      exact ⟨fun 𝔭 hW hx => h 𝔭 hW (Ideal.mul_mem_right _ _ hx),
        fun 𝔭 hW hy => h 𝔭 hW (Ideal.mul_mem_left _ _ hy)⟩
    · rintro ⟨hx, hy⟩ 𝔭 hW hxy
      rcases 𝔭.isPrime.mem_or_mem hxy with h | h
      · exact hx 𝔭 hW h
      · exact hy 𝔭 hW h
  have hcopper : ∀ x y : NumberField.RingOfIntegers K,
      CoprimeToNat (Ideal.absNorm 𝔮)
          (x + ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) * y) ↔
        CoprimeToNat (Ideal.absNorm 𝔮) x := by
    intro x y
    constructor
    · intro h 𝔭 hW hx
      exact h 𝔭 hW (Ideal.add_mem _ hx (Ideal.mul_mem_right _ _ hW))
    · intro h 𝔭 hW hx
      apply h 𝔭 hW
      have h' := Ideal.sub_mem _ hx (Ideal.mul_mem_right y _ hW)
      simpa using h'
  
  have hGc : ∀ ℓ, CoprimeToNat (Ideal.absNorm 𝔮) ℓ →
      kaiGplus 𝔮 ψ ℓ = (kaiFplus 𝔮 ψ ℓ : ℝ) := by
    intro ℓ h
    unfold kaiGplus
    rw [if_pos h]
  have hGn : ∀ ℓ, ¬ CoprimeToNat (Ideal.absNorm 𝔮) ℓ → kaiGplus 𝔮 ψ ℓ = 0 := by
    intro ℓ h
    unfold kaiGplus
    rw [if_neg h]
  have hG1 : kaiGplus 𝔮 ψ 1 = 1 := by
    rw [hGc 1 hcop1, hF1, Int.cast_one]
  have hGmul : ∀ x y, kaiGplus 𝔮 ψ (x * y) = kaiGplus 𝔮 ψ x * kaiGplus 𝔮 ψ y := by
    intro x y
    by_cases hx : CoprimeToNat (Ideal.absNorm 𝔮) x
    · by_cases hy : CoprimeToNat (Ideal.absNorm 𝔮) y
      · rw [hGc _ ((hcopmul x y).mpr ⟨hx, hy⟩), hGc x hx, hGc y hy, hFmul, Int.cast_mul]
      · rw [hGn _ (fun h => hy ((hcopmul x y).mp h).2), hGn y hy, mul_zero]
    · rw [hGn _ (fun h => hx ((hcopmul x y).mp h).1), hGn x hx, zero_mul]
  have hGper : ∀ x y, kaiGplus 𝔮 ψ
      (x + ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) * y) = kaiGplus 𝔮 ψ x := by
    intro x y
    have hFxy : kaiFplus 𝔮 ψ (x + ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) * y)
        = kaiFplus 𝔮 ψ x :=
      hFper _ _ (by rw [add_sub_cancel_left]; exact Ideal.mul_mem_right _ _ hQmem)
    by_cases hx : CoprimeToNat (Ideal.absNorm 𝔮) x
    · rw [hGc _ ((hcopper x y).mpr hx), hGc x hx, hFxy]
    · rw [hGn _ (fun h => hx ((hcopper x y).mp h)), hGn x hx]
  
  have hIne : Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)} ≠ ⊥ := by
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact_mod_cast hQ0
  haveI hIfin : Finite (NumberField.RingOfIntegers K ⧸
      Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)}) :=
    Ideal.finiteQuotientOfFreeOfNeBot _ hIne
  have hGI : ∀ x y, x - y ∈ Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)} →
      kaiGplus 𝔮 ψ x = kaiGplus 𝔮 ψ y := by
    intro x y hxy
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hxy
    have hx : x = y + ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) * t := by
      rw [mul_comm, ht]; ring
    rw [hx, hGper]
  obtain ⟨Gbar, hGbar⟩ : ∃ Gbar : NumberField.RingOfIntegers K ⧸
      Ideal.span {((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K)} → ℝ,
      ∀ x, Gbar (Ideal.Quotient.mk _ x) = kaiGplus 𝔮 ψ x := by
    refine ⟨fun z => kaiGplus 𝔮 ψ (Function.surjInv Ideal.Quotient.mk_surjective z), ?_⟩
    intro x
    apply hGI
    rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact Function.surjInv_eq Ideal.Quotient.mk_surjective _
  
  rw [kaiResSum_eq_finU3Avg ω (Ideal.absNorm 𝔮) hQ1 (kaiGplus 𝔮 ψ) hGper Gbar hGbar]
  
  obtain ⟨S, a, g, hS, ha, hprod, hex, hlift, hU⟩ :=
    finU3Avg_crt_factor _ hIne (kaiGplus 𝔮 ψ) hG1 hGmul hGI Gbar hGbar
  rw [hU, Finset.abs_prod]
  
  refine hnum 𝔮 h𝔮 (fun P hP e h2 => primRealChar_conductor_bound 𝔮 h𝔮 _ hF P hP e h2) S
    ?_ ?_ (fun P => |finU3Avg (g P)|) ?_ ?_
  · intro P hP
    obtain ⟨hpr, hne, -⟩ := (hS P).mp hP
    exact hpr.isMaximal hne
  · intro P hPm hqP
    refine (hS P).mpr ⟨hPm.isPrime, ?_, ?_⟩
    · rintro rfl
      exact h𝔮 (le_bot_iff.mp hqP)
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hqP hQmem
  · intro P hP
    obtain ⟨-, hne, -⟩ := (hS P).mp hP
    haveI : Finite (NumberField.RingOfIntegers K ⧸ P ^ a P) :=
      Ideal.finiteQuotientOfFreeOfNeBot _ (pow_ne_zero _ hne)
    have hloc := primRealChar_local_factor 𝔮 h𝔮 _ hF (kaiGplus 𝔮 ψ) hGc hGn S a hS ha hprod
      P hP (g P) (hex P hP) (hlift P hP)
    exact ⟨abs_nonneg _, finU3Avg_abs_le_one (g P) hloc.1⟩
  · intro P hP hqP h2P
    obtain ⟨hpr, hne, -⟩ := (hS P).mp hP
    haveI hPmax : P.IsMaximal := hpr.isMaximal hne
    haveI : Finite (NumberField.RingOfIntegers K ⧸ P ^ a P) :=
      Ideal.finiteQuotientOfFreeOfNeBot _ (pow_ne_zero _ hne)
    haveI : Finite (NumberField.RingOfIntegers K ⧸ P) :=
      Ideal.finiteQuotientOfFreeOfNeBot _ hne
    have hloc := primRealChar_local_factor 𝔮 h𝔮 _ hF (kaiGplus 𝔮 ψ) hGc hGn S a hS ha hprod
      P hP (g P) (hex P hP) (hlift P hP)
    have hsq : ¬ 𝔮 ≤ P ^ 2 := by
      have h2P' : (2 : NumberField.RingOfIntegers K) ∉ P ^ (0 + 1) := by
        rw [zero_add, pow_one]; exact h2P
      have h := primRealChar_conductor_bound 𝔮 h𝔮 _ hF P hPmax 0 h2P'
      simpa using h
    obtain ⟨η, hgη, hηmul, hη0, hηval, hηnt⟩ := hloc.2 hqP hsq
    have hle : P ^ a P ≤ P := Ideal.pow_le_self (by have := ha P hP; omega)
    have hπs : Function.Surjective (Ideal.Quotient.factor hle).toAddMonoidHom := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨Ideal.Quotient.mk _ x, Ideal.Quotient.factor_mk hle x⟩
    have hcomp : g P = fun y => η ((Ideal.Quotient.factor hle).toAddMonoidHom y) := by
      funext y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hgη x]
      show η (Ideal.Quotient.mk P x) = η ((Ideal.Quotient.factor hle) (Ideal.Quotient.mk _ x))
      rw [Ideal.Quotient.factor_mk]
    have h1 : finU3Avg (g P) = finU3Avg η := by
      rw [hcomp]
      exact finU3Avg_comp_surj _ hπs η
    letI : Field (NumberField.RingOfIntegers K ⧸ P) := Ideal.Quotient.field P
    have hchar : ringChar (NumberField.RingOfIntegers K ⧸ P) ≠ 2 := by
      intro h
      apply h2P
      have h2 : ((ringChar (NumberField.RingOfIntegers K ⧸ P) : ℕ) :
          NumberField.RingOfIntegers K ⧸ P) = 0 := ringChar.Nat.cast_ringChar
      rw [h] at h2
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      simpa using h2
    have h3 := finU3Avg_quadratic_char_le hchar η hηmul hη0 hηval hηnt
    show |finU3Avg (g P)| ≤ 8 / (Ideal.absNorm P : ℝ)
    rw [h1, Ideal.absNorm_apply, Submodule.cardQuot_apply]
    exact h3

theorem kai_sieve_bonferroni_count {α β : Type*} [DecidableEq β]
    (Z : Finset α) (U : Finset β) (Bad : β → α → Prop) [∀ p z, Decidable (Bad p z)] (r : ℕ) :
    |((Z.filter (fun z => ∀ p ∈ U, ¬ Bad p z)).card : ℝ)
      - ∑ T ∈ U.powerset.filter (fun T => T.card ≤ r),
          (-1 : ℝ) ^ T.card * ((Z.filter (fun z => ∀ p ∈ T, Bad p z)).card : ℝ)|
    ≤ ∑ T ∈ U.powerset.filter (fun T => T.card = r + 1),
          ((Z.filter (fun z => ∀ p ∈ T, Bad p z)).card : ℝ) :=
by
  
  have hpt : ∀ b : ℕ, |(if b = 0 then (1:ℝ) else 0)
      - ∑ k ∈ Finset.range (r + 1), (-1:ℝ) ^ k * (b.choose k : ℝ)| ≤ (b.choose (r + 1) : ℝ) := by
    intro b
    rcases b with _ | s
    · simp [Finset.sum_range_succ']
    · have h := Int.alternating_sum_range_choose_eq_choose (n := s) (m := r)
      have h' : ∑ k ∈ Finset.range (r + 1), (-1:ℝ) ^ k * ((s + 1).choose k : ℝ)
          = (-1) ^ r * (s.choose r : ℝ) := by
        have := congrArg (Int.cast : ℤ → ℝ) h
        push_cast at this
        exact this
      rw [if_neg (Nat.succ_ne_zero s), h', zero_sub, abs_neg, abs_mul, abs_pow, abs_neg, abs_one,
        one_pow, one_mul, Nat.abs_cast, Nat.choose_succ_succ', Nat.cast_add]
      have : (0:ℝ) ≤ (s.choose (r + 1) : ℝ) := Nat.cast_nonneg _
      linarith
  
  have swap : ∀ (P : Finset β → Prop) [DecidablePred P] (w : Finset β → ℝ),
      ∑ T ∈ U.powerset.filter P, w T * ((Z.filter (fun z => ∀ p ∈ T, Bad p z)).card : ℝ)
        = ∑ z ∈ Z, ∑ T ∈ (U.filter (fun p => Bad p z)).powerset.filter P, w T := by
    intro P _ w
    simp_rw [Finset.natCast_card_filter, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun z _ => ?_)
    simp_rw [mul_ite, mul_one, mul_zero]
    rw [← Finset.sum_filter]
    apply Finset.sum_congr _ (fun _ _ => rfl)
    ext T
    simp only [Finset.mem_filter, Finset.mem_powerset, Finset.subset_iff]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3⟩
      exact ⟨fun p hp => ⟨h1 hp, h3 p hp⟩, h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨⟨fun p hp => (h1 hp).1, h2⟩, fun p hp => (h1 hp).2⟩
  
  have trunc : ∀ S : Finset β, ∑ T ∈ S.powerset.filter (fun T => T.card ≤ r), (-1:ℝ) ^ T.card
      = ∑ k ∈ Finset.range (r + 1), (-1:ℝ) ^ k * (S.card.choose k : ℝ) := by
    intro S
    rw [Finset.sum_filter]
    have hp := Finset.sum_powerset_apply_card (fun k => if k ≤ r then (-1:ℝ) ^ k else 0) (x := S)
    beta_reduce at hp
    rw [hp]
    have hN1 : Finset.range (S.card + 1) ⊆ Finset.range (S.card + r + 1) :=
      Finset.range_mono (by omega)
    have hN2 : Finset.range (r + 1) ⊆ Finset.range (S.card + r + 1) :=
      Finset.range_mono (by omega)
    have e1 : ∑ k ∈ Finset.range (S.card + 1), S.card.choose k • (if k ≤ r then (-1:ℝ) ^ k else 0)
        = ∑ k ∈ Finset.range (S.card + r + 1),
            S.card.choose k • (if k ≤ r then (-1:ℝ) ^ k else 0) := by
      apply Finset.sum_subset hN1
      intro k hk hk'
      simp only [Finset.mem_range] at hk hk'
      rw [Nat.choose_eq_zero_of_lt (show S.card < k by omega), zero_smul]
    have e2 : ∑ k ∈ Finset.range (r + 1), S.card.choose k • (if k ≤ r then (-1:ℝ) ^ k else 0)
        = ∑ k ∈ Finset.range (S.card + r + 1),
            S.card.choose k • (if k ≤ r then (-1:ℝ) ^ k else 0) := by
      apply Finset.sum_subset hN2
      intro k hk hk'
      simp only [Finset.mem_range] at hk hk'
      rw [if_neg (show ¬ k ≤ r by omega), smul_zero]
    rw [e1, ← e2]
    apply Finset.sum_congr rfl
    intro k hk
    simp only [Finset.mem_range] at hk
    rw [if_pos (show k ≤ r by omega), nsmul_eq_mul, mul_comm]
  have hgood : ((Z.filter (fun z => ∀ p ∈ U, ¬ Bad p z)).card : ℝ)
      = ∑ z ∈ Z, (if (U.filter (fun p => Bad p z)).card = 0 then (1:ℝ) else 0) := by
    rw [Finset.natCast_card_filter]
    apply Finset.sum_congr rfl
    intro z _
    exact if_congr (by simp only [Finset.card_eq_zero, Finset.filter_eq_empty_iff]) rfl rfl
  have hmid : ∑ T ∈ U.powerset.filter (fun T => T.card ≤ r),
          (-1 : ℝ) ^ T.card * ((Z.filter (fun z => ∀ p ∈ T, Bad p z)).card : ℝ)
      = ∑ z ∈ Z, ∑ k ∈ Finset.range (r + 1),
          (-1:ℝ) ^ k * ((U.filter (fun p => Bad p z)).card.choose k : ℝ) := by
    have hs := swap (fun T => T.card ≤ r) (fun T => (-1:ℝ) ^ T.card)
    beta_reduce at hs
    rw [hs]
    exact Finset.sum_congr rfl (fun z _ => trunc _)
  have hright : ∑ T ∈ U.powerset.filter (fun T => T.card = r + 1),
          ((Z.filter (fun z => ∀ p ∈ T, Bad p z)).card : ℝ)
      = ∑ z ∈ Z, (((U.filter (fun p => Bad p z)).card.choose (r + 1) : ℕ) : ℝ) := by
    have hs := swap (fun T => T.card = r + 1) (fun _ => (1:ℝ))
    beta_reduce at hs
    simp only [one_mul] at hs
    rw [hs]
    refine Finset.sum_congr rfl (fun z _ => ?_)
    rw [Finset.sum_const, nsmul_eq_mul, mul_one, ← Finset.powersetCard_eq_filter,
      Finset.card_powersetCard]
  rw [hgood, hmid, hright, ← Finset.sum_sub_distrib]
  exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun z _ => hpt _)

theorem kai_sieve_run_residue_1d (A : Finset ℤ) (m : ℕ) (hm : 1 ≤ m) (β : ℤ) :
    |((A.filter (fun t => (m : ℤ) ∣ t - β)).card : ℝ) - (A.card : ℝ) / m|
      ≤ ((A.filter (fun t => t - 1 ∉ A)).card : ℝ) :=
by
  classical
  have hM : (0:ℤ) < (m:ℤ) := by exact_mod_cast hm
  have hμ : (0:ℝ) < (m:ℝ) := by exact_mod_cast hm
  
  have step : ∀ n : ℤ, n % (m:ℤ) - (n - 1) % (m:ℤ)
      = 1 - (if (m:ℤ) ∣ n then (m:ℤ) else 0) := by
    intro n
    have h1 := Int.emod_add_mul_ediv n (m:ℤ)
    have h2 := Int.emod_nonneg n hM.ne'
    have h3 := Int.emod_lt_of_pos n hM
    split_ifs with hd
    · have hr : n % (m:ℤ) = 0 := Int.emod_eq_zero_of_dvd hd
      have e : n - 1 = ((m:ℤ) - 1) + (m:ℤ) * (n / (m:ℤ) - 1) := by
        linear_combination -h1 + hr
      have h4 : (n - 1) % (m:ℤ) = (m:ℤ) - 1 := by
        rw [e, Int.add_mul_emod_self_left]
        exact Int.emod_eq_of_lt (by omega) (by omega)
      rw [h4, hr]
      ring
    · have hr : n % (m:ℤ) ≠ 0 := fun h => hd (Int.dvd_of_emod_eq_zero h)
      have e : n - 1 = (n % (m:ℤ) - 1) + (m:ℤ) * (n / (m:ℤ)) := by
        linear_combination -h1
      have h4 : (n - 1) % (m:ℤ) = n % (m:ℤ) - 1 := by
        rw [e, Int.add_mul_emod_self_left]
        exact Int.emod_eq_of_lt (by omega) (by omega)
      rw [h4]
      ring
  
  set g : ℤ → ℝ := fun t => -(((t - β) % (m:ℤ) : ℤ) : ℝ) / (m:ℝ) with hg_def
  have hga : ∀ t, -1 ≤ g t ∧ g t ≤ 0 := by
    intro t
    have h2 := Int.emod_nonneg (t - β) hM.ne'
    have h3 := Int.emod_lt_of_pos (t - β) hM
    have h2' : (0:ℝ) ≤ (((t - β) % (m:ℤ) : ℤ) : ℝ) := by exact_mod_cast h2
    have h3' : (((t - β) % (m:ℤ) : ℤ) : ℝ) ≤ (m:ℝ) := by exact_mod_cast h3.le
    simp only [hg_def]
    constructor
    · rw [le_div_iff₀ hμ]; linarith
    · rw [div_le_iff₀ hμ]; linarith
  have hg : ∀ t, g t - g (t - 1) = (if (m:ℤ) ∣ t - β then (1:ℝ) else 0) - 1 / (m:ℝ) := by
    intro t
    have hs := step (t - β)
    have e : t - 1 - β = t - β - 1 := by ring
    simp only [hg_def, e]
    have key : -(((t - β) % (m:ℤ) : ℤ) : ℝ) / (m:ℝ) - -(((t - β - 1) % (m:ℤ) : ℤ) : ℝ) / (m:ℝ)
        = -((((t - β) % (m:ℤ) - (t - β - 1) % (m:ℤ) : ℤ)) : ℝ) / (m:ℝ) := by
      push_cast; ring
    rw [key, hs]
    split_ifs with hd
    · push_cast; field_simp; ring
    · push_cast; field_simp; ring
  
  have hsum : ∑ t ∈ A, (g t - g (t - 1))
      = ((A.filter (fun t => (m : ℤ) ∣ t - β)).card : ℝ) - (A.card : ℝ) / m := by
    rw [Finset.sum_congr rfl (fun t _ => hg t), Finset.sum_sub_distrib, Finset.sum_boole,
      Finset.sum_const, nsmul_eq_mul]
    ring
  
  have h4a := Finset.sum_filter_add_sum_filter_not A (fun t => t + 1 ∈ A) g
  have h4b := Finset.sum_filter_add_sum_filter_not A (fun t => t - 1 ∈ A) (fun t => g (t - 1))
  have h5 : ∑ t ∈ A.filter (fun t => t - 1 ∈ A), g (t - 1)
      = ∑ u ∈ A.filter (fun t => t + 1 ∈ A), g u := by
    apply Finset.sum_nbij' (fun t => t - 1) (fun u => u + 1)
    · intro t ht
      simp only [Finset.mem_filter] at ht ⊢
      refine ⟨ht.2, ?_⟩
      rw [sub_add_cancel]; exact ht.1
    · intro u hu
      simp only [Finset.mem_filter] at hu ⊢
      refine ⟨hu.2, ?_⟩
      rw [add_sub_cancel_right]; exact hu.1
    · intro t _; simp
    · intro u _; simp
    · intro t _; rfl
  have h5c : (A.filter (fun t => t - 1 ∈ A)).card = (A.filter (fun t => t + 1 ∈ A)).card := by
    apply Finset.card_nbij' (fun t => t - 1) (fun u => u + 1)
    · intro t ht
      simp only [Finset.mem_coe, Finset.mem_filter] at ht ⊢
      refine ⟨ht.2, ?_⟩
      rw [sub_add_cancel]; exact ht.1
    · intro u hu
      simp only [Finset.mem_coe, Finset.mem_filter] at hu ⊢
      refine ⟨hu.2, ?_⟩
      rw [add_sub_cancel_right]; exact hu.1
    · intro t _; simp
    · intro u _; simp
  have hcQ := Finset.card_filter_add_card_filter_not (s := A) (fun t => t + 1 ∈ A)
  have hcP := Finset.card_filter_add_card_filter_not (s := A) (fun t => t - 1 ∈ A)
  have hES : (A.filter (fun t => ¬ (t + 1 ∈ A))).card
      = (A.filter (fun t => ¬ (t - 1 ∈ A))).card := by
    omega
  have hESr : ((A.filter (fun t => ¬ (t + 1 ∈ A))).card : ℝ)
      = ((A.filter (fun t => ¬ (t - 1 ∈ A))).card : ℝ) := by exact_mod_cast hES
  
  have b1 : ∑ t ∈ A.filter (fun t => ¬ (t + 1 ∈ A)), g t ≤ 0 :=
    Finset.sum_nonpos (fun t _ => (hga t).2)
  have b2 : -((A.filter (fun t => ¬ (t + 1 ∈ A))).card : ℝ)
      ≤ ∑ t ∈ A.filter (fun t => ¬ (t + 1 ∈ A)), g t := by
    have := Finset.card_nsmul_le_sum (A.filter (fun t => ¬ (t + 1 ∈ A))) g (-1)
      (fun t _ => (hga t).1)
    simpa using this
  have b3 : ∑ t ∈ A.filter (fun t => ¬ (t - 1 ∈ A)), g (t - 1) ≤ 0 :=
    Finset.sum_nonpos (fun t _ => (hga (t - 1)).2)
  have b4 : -((A.filter (fun t => ¬ (t - 1 ∈ A))).card : ℝ)
      ≤ ∑ t ∈ A.filter (fun t => ¬ (t - 1 ∈ A)), g (t - 1) := by
    have := Finset.card_nsmul_le_sum (A.filter (fun t => ¬ (t - 1 ∈ A)))
      (fun t => g (t - 1)) (-1) (fun t _ => (hga (t - 1)).1)
    simpa using this
  rw [← hsum, Finset.sum_sub_distrib]
  rw [abs_le]
  constructor <;> linarith

theorem kai_sieve_line_step {ι : Type*} [Fintype ι] [DecidableEq ι]
    (R : Finset (ι → ℤ)) (L J : ℕ) (k : ι) (m : ℕ) (hm : 1 ≤ m) (β : ℤ)
    (hbox : ∀ z ∈ R, ∀ k', |z k'| ≤ (L : ℤ))
    (hlinek : ∀ z : ι → ℤ,
      (R.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
        Function.update y k (y k - 1) ∉ R)).card ≤ J)
    (h1d : ∀ A : Finset ℤ,
      |((A.filter (fun t => (m : ℤ) ∣ t - β)).card : ℝ) - (A.card : ℝ) / m|
        ≤ ((A.filter (fun t => t - 1 ∉ A)).card : ℝ)) :
    |((R.filter (fun z => (m : ℤ) ∣ z k - β)).card : ℝ) - (R.card : ℝ) / m|
      ≤ (J : ℝ) * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) :=
by
  
  have hfib : ∀ w : ι → ℤ,
      |(((R.filter (fun z => Function.update z k 0 = w)).filter
          (fun z => (m : ℤ) ∣ z k - β)).card : ℝ)
        - ((R.filter (fun z => Function.update z k 0 = w)).card : ℝ) / m| ≤ (J : ℝ) := by
    intro w
    obtain ⟨F, hF⟩ : ∃ F, F = R.filter (fun z => Function.update z k 0 = w) := ⟨_, rfl⟩
    rw [← hF]
    have hinj : Set.InjOn (fun z : ι → ℤ => z k) (F : Set (ι → ℤ)) := by
      intro y hy z hz hyz
      rw [hF, Finset.coe_filter] at hy hz
      funext i
      by_cases hi : i = k
      · subst hi; exact hyz
      · have h1 := congrFun hy.2 i
        have h2 := congrFun hz.2 i
        rw [Function.update_of_ne hi] at h1 h2
        rw [h1, h2]
    have hinjS : ∀ S : Finset (ι → ℤ), S ⊆ F → Set.InjOn (fun z : ι → ℤ => z k) (S : Set (ι → ℤ)) :=
      fun S hS => hinj.mono (Finset.coe_subset.2 hS)
    obtain ⟨A, hA⟩ : ∃ A, A = F.image (fun z => z k) := ⟨_, rfl⟩
    have hcardA : A.card = F.card := by rw [hA]; exact Finset.card_image_of_injOn hinj
    have hD : (A.filter (fun t => (m : ℤ) ∣ t - β)).card
        = (F.filter (fun z => (m : ℤ) ∣ z k - β)).card := by
      rw [hA, Finset.filter_image]
      exact Finset.card_image_of_injOn (hinjS _ (Finset.filter_subset _ _))
    have e : A.filter (fun t => t - 1 ∉ A)
        = (F.filter (fun y => y k - 1 ∉ A)).image (fun z => z k) := by
      have := Finset.filter_image (s := F) (f := fun z : ι → ℤ => z k) (p := fun t => t - 1 ∉ A)
      rw [← hA] at this
      exact this
    have hrun : (A.filter (fun t => t - 1 ∉ A)).card = (F.filter (fun y => y k - 1 ∉ A)).card := by
      rw [e]
      exact Finset.card_image_of_injOn (hinjS _ (Finset.filter_subset _ _))
    have hsub : F.filter (fun y => y k - 1 ∉ A) ⊆ R.filter (fun y => (∀ k', k' ≠ k → y k' = w k') ∧
        Function.update y k (y k - 1) ∉ R) := by
      intro y hy
      rw [Finset.mem_filter, hF, Finset.mem_filter] at hy
      obtain ⟨⟨hyR, hyw⟩, hyA⟩ := hy
      refine Finset.mem_filter.2 ⟨hyR, ?_, ?_⟩
      · intro k' hk'
        rw [← hyw, Function.update_of_ne hk']
      · intro hmem
        apply hyA
        rw [hA]
        refine Finset.mem_image.2 ⟨Function.update y k (y k - 1), ?_, by simp⟩
        rw [hF]
        refine Finset.mem_filter.2 ⟨hmem, ?_⟩
        rw [← hyw, Function.update_idem]
    rw [← hD, ← hcardA]
    refine (h1d A).trans ?_
    rw [hrun]
    exact_mod_cast (Finset.card_le_card hsub).trans (hlinek w)
  
  have hproj : ((R.image (fun z => Function.update z k 0)).card : ℝ)
      ≤ (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) := by
    let t : ι → Finset ℤ := fun i => if i = k then {0} else Finset.Icc (-(L:ℤ)) L
    have hsub : R.image (fun z => Function.update z k 0) ⊆ Fintype.piFinset t := by
      intro x hx
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hx
      rw [Fintype.mem_piFinset]
      intro i
      by_cases hi : i = k
      · subst hi; simp [t]
      · simp only [t, if_neg hi, Function.update_of_ne hi, Finset.mem_Icc]
        exact abs_le.1 (hbox z hz i)
    have htc : ∀ i, (t i).card = if i = k then 1 else 2 * L + 1 := by
      intro i
      by_cases hi : i = k
      · simp [t, hi]
      · simp only [t, if_neg hi, Int.card_Icc]
        omega
    have hcard : (Fintype.piFinset t).card = (2 * L + 1) ^ (Fintype.card ι - 1) := by
      rw [Fintype.card_piFinset, ← Finset.mul_prod_erase _ _ (Finset.mem_univ k), htc k,
        if_pos rfl, one_mul,
        Finset.prod_congr rfl (fun i hi => by rw [htc i, if_neg (Finset.ne_of_mem_erase hi)]),
        Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ k), Finset.card_univ]
    have h := Finset.card_le_card hsub
    rw [hcard] at h
    exact_mod_cast h
  
  have hsplit : |((R.filter (fun z => (m : ℤ) ∣ z k - β)).card : ℝ) - (R.card : ℝ) / m|
      ≤ ∑ w ∈ R.image (fun z => Function.update z k 0),
          |(((R.filter (fun z => Function.update z k 0 = w)).filter
              (fun z => (m : ℤ) ∣ z k - β)).card : ℝ)
            - ((R.filter (fun z => Function.update z k 0 = w)).card : ℝ) / m| := by
    have h1 : (R.card : ℝ) = ∑ w ∈ R.image (fun z => Function.update z k 0),
        ((R.filter (fun z => Function.update z k 0 = w)).card : ℝ) := by
      rw [Finset.card_eq_sum_card_image (fun z => Function.update z k 0) R]
      push_cast
      rfl
    have h2 : ((R.filter (fun z => (m : ℤ) ∣ z k - β)).card : ℝ)
        = ∑ w ∈ R.image (fun z => Function.update z k 0),
          (((R.filter (fun z => Function.update z k 0 = w)).filter
              (fun z => (m : ℤ) ∣ z k - β)).card : ℝ) := by
      rw [Finset.card_eq_sum_card_fiberwise (f := fun z => Function.update z k 0)
        (t := R.image (fun z => Function.update z k 0))
        (s := R.filter (fun z => (m : ℤ) ∣ z k - β))
        (fun z hz => Finset.mem_coe.2 (Finset.mem_image_of_mem (fun z => Function.update z k 0)
          (Finset.mem_filter.1 (Finset.mem_coe.1 hz)).1))]
      push_cast
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [Finset.filter_comm]
    rw [h1, h2, Finset.sum_div, ← Finset.sum_sub_distrib]
    exact Finset.abs_sum_le_sum_abs _ _
  
  calc |((R.filter (fun z => (m : ℤ) ∣ z k - β)).card : ℝ) - (R.card : ℝ) / m|
      ≤ ∑ w ∈ R.image (fun z => Function.update z k 0),
          |(((R.filter (fun z => Function.update z k 0 = w)).filter
              (fun z => (m : ℤ) ∣ z k - β)).card : ℝ)
            - ((R.filter (fun z => Function.update z k 0 = w)).card : ℝ) / m| := hsplit
    _ ≤ ∑ w ∈ R.image (fun z => Function.update z k 0), (J : ℝ) :=
        Finset.sum_le_sum (fun w _ => hfib w)
    _ = ((R.image (fun z => Function.update z k 0)).card : ℝ) * (J : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) * (J : ℝ) :=
        mul_le_mul_of_nonneg_right hproj (Nat.cast_nonneg _)
    _ = (J : ℝ) * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) := mul_comm _ _

theorem kai_sieve_box_equidist {ι : Type*} [Fintype ι] [DecidableEq ι]
    (R : Finset (ι → ℤ)) (L J : ℕ) (m : ℕ) (hm : 1 ≤ m)
    (hbox : ∀ z ∈ R, ∀ k, |z k| ≤ (L : ℤ))
    (hline : ∀ (z : ι → ℤ) (k : ι),
      (R.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
        Function.update y k (y k - 1) ∉ R)).card ≤ J)
    (hstep : ∀ (R' : Finset (ι → ℤ)) (k : ι) (β : ℤ),
      (∀ z ∈ R', ∀ k', |z k'| ≤ (L : ℤ)) →
      (∀ z : ι → ℤ, (R'.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
        Function.update y k (y k - 1) ∉ R')).card ≤ J) →
      |((R'.filter (fun z => (m : ℤ) ∣ z k - β)).card : ℝ) - (R'.card : ℝ) / m|
        ≤ (J : ℝ) * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1))
    (b : ι → ℤ) :
    |((R.filter (fun z => ∀ k, (m : ℤ) ∣ z k - b k)).card : ℝ)
        - (R.card : ℝ) / (m : ℝ) ^ Fintype.card ι|
      ≤ (Fintype.card ι : ℝ) * J * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) :=
by
  set W : ℝ := (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) with hW
  have hW0 : 0 ≤ W := by positivity
  have hM : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hMpos : (0 : ℝ) < m := by linarith
  have hm0 : (m : ℝ) ≠ 0 := hMpos.ne'
  have key : ∀ S : Finset ι,
      |((R.filter (fun z => ∀ j ∈ S, (m : ℤ) ∣ z j - b j)).card : ℝ)
        - (R.card : ℝ) / (m : ℝ) ^ S.card| ≤ (S.card : ℝ) * ((J : ℝ) * W) := by
    intro S
    induction S using Finset.induction_on with
    | empty => simp
    | insert k S hk ih =>
      set RS := R.filter (fun z => ∀ j ∈ S, (m : ℤ) ∣ z j - b j) with hRS
      have hfilt : R.filter (fun z => ∀ j ∈ insert k S, (m : ℤ) ∣ z j - b j)
          = RS.filter (fun z => (m : ℤ) ∣ z k - b k) := by
        rw [hRS, Finset.filter_filter]
        apply Finset.filter_congr
        intro z _
        rw [Finset.forall_mem_insert, and_comm]
      have hboxS : ∀ z ∈ RS, ∀ k', |z k'| ≤ (L : ℤ) :=
        fun z hz => hbox z (Finset.mem_filter.1 hz).1
      have hlineS : ∀ z : ι → ℤ, (RS.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
          Function.update y k (y k - 1) ∉ RS)).card ≤ J := by
        intro z
        refine le_trans (Finset.card_le_card ?_) (hline z k)
        intro y hy
        rw [Finset.mem_filter] at hy ⊢
        obtain ⟨hyRS, hyl, hyn⟩ := hy
        have hyR := (Finset.mem_filter.1 hyRS).1
        have hyP := (Finset.mem_filter.1 hyRS).2
        refine ⟨hyR, hyl, fun h => hyn ?_⟩
        rw [hRS, Finset.mem_filter]
        refine ⟨h, fun j hj => ?_⟩
        have hjk : j ≠ k := fun e => hk (e ▸ hj)
        rw [Function.update_of_ne hjk]
        exact hyP j hj
      have h1 := hstep RS k (b k) hboxS hlineS
      rw [← hfilt] at h1
      rw [Finset.card_insert_of_notMem hk]
      set a' := ((R.filter (fun z => ∀ j ∈ insert k S, (m : ℤ) ∣ z j - b j)).card : ℝ)
      set a := (RS.card : ℝ)
      set x := (R.card : ℝ)
      have hid : a' - x / (m : ℝ) ^ (S.card + 1)
          = (a' - a / m) + (a - x / (m : ℝ) ^ S.card) / m := by
        field_simp
        ring
      rw [hid]
      have h2 : |(a - x / (m : ℝ) ^ S.card) / m| ≤ |a - x / (m : ℝ) ^ S.card| := by
        rw [abs_div, abs_of_pos hMpos]
        exact div_le_self (abs_nonneg _) hM
      calc _ ≤ |a' - a / m| + |(a - x / (m : ℝ) ^ S.card) / m| := abs_add_le _ _
        _ ≤ (J : ℝ) * W + (S.card : ℝ) * ((J : ℝ) * W) := add_le_add h1 (h2.trans ih)
        _ = ((S.card + 1 : ℕ) : ℝ) * ((J : ℝ) * W) := by push_cast; ring
  have hfin := key Finset.univ
  rw [Finset.card_univ] at hfin
  have hf : R.filter (fun z => ∀ j ∈ (Finset.univ : Finset ι), (m : ℤ) ∣ z j - b j)
      = R.filter (fun z => ∀ k, (m : ℤ) ∣ z k - b k) := by
    apply Finset.filter_congr
    intro z _
    simp
  rw [hf] at hfin
  rw [mul_assoc]
  exact hfin

theorem kai_sieve_T_class_count {ι : Type*} [Fintype ι] [DecidableEq ι]
    (R : Finset (ι → ℤ)) (E : ℝ)
    (heq : ∀ (m : ℕ), 1 ≤ m → ∀ b : ι → ℤ,
      |((R.filter (fun z => ∀ k, (m : ℤ) ∣ z k - b k)).card : ℝ)
        - (R.card : ℝ) / (m : ℝ) ^ Fintype.card ι| ≤ E)
    (T : Finset ℕ) (hT : ∀ p ∈ T, p.Prime) (Q : ℕ) (hQ : 1 ≤ Q) (hQT : ∀ p ∈ T, ¬ p ∣ Q)
    (Bad : ℕ → (ι → ℤ) → Prop) [∀ p z, Decidable (Bad p z)]
    (hper : ∀ p ∈ T, ∀ z z' : ι → ℤ, (∀ k, (p : ℤ) ∣ z k - z' k) → (Bad p z ↔ Bad p z'))
    (c : ι → ℤ) :
    |((R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ T, Bad p z)).card : ℝ)
      - (R.card : ℝ) *
          (((Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
              (fun a => ∀ p ∈ T, Bad p a)).card : ℝ)
          / ((Q : ℝ) * ((∏ p ∈ T, p : ℕ) : ℝ)) ^ Fintype.card ι|
    ≤ (((Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
              (fun a => ∀ p ∈ T, Bad p a)).card : ℝ) * E :=
by
  set P : ℕ := ∏ p ∈ T, p with hPdef
  have hPpos : 0 < P := Finset.prod_pos (fun p hp => (hT p hp).pos)
  have hcop : Nat.Coprime Q P := Nat.Coprime.prod_right (fun p hp =>
    Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd (hT p hp)).2 (hQT p hp)))
  have hQP : 1 ≤ Q * P := Nat.mul_pos hQ hPpos
  have hcopZ : IsCoprime (Q:ℤ) (P:ℤ) := Nat.isCoprime_iff_coprime.2 hcop
  obtain ⟨u, v, huv⟩ := hcopZ
  have hPZ : (0:ℤ) < (P:ℤ) := by exact_mod_cast hPpos
  have hpP : ∀ p ∈ T, (p:ℤ) ∣ (P:ℤ) := fun p hp =>
    Int.natCast_dvd_natCast.2 (Finset.dvd_prod_of_mem _ hp)
  have hperP : ∀ p ∈ T, ∀ z w : ι → ℤ, (∀ k, (P:ℤ) ∣ z k - w k) → (Bad p z ↔ Bad p w) :=
    fun p hp z w h => hper p hp z w (fun k => dvd_trans (hpP p hp) (h k))
  set G := (Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => (P : ℤ) - 1)).filter
    (fun a => ∀ p ∈ T, Bad p a) with hG
  set A := R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ T, Bad p z) with hA
  let ρ : (ι → ℤ) → (ι → ℤ) := fun z k => z k % (P:ℤ)
  have hρdvd : ∀ z k, (P:ℤ) ∣ z k - ρ z k := fun z k =>
    ⟨z k / (P:ℤ), by have := Int.emod_add_mul_ediv (z k) (P:ℤ); simp only [ρ]; linarith⟩
  have hmaps : Set.MapsTo ρ (A : Set (ι → ℤ)) (G : Set (ι → ℤ)) := by
    intro z hz
    rw [Finset.mem_coe, hA, Finset.mem_filter] at hz
    rw [Finset.mem_coe, hG, Finset.mem_filter, Finset.mem_Icc]
    refine ⟨⟨fun k => Int.emod_nonneg _ hPZ.ne', fun k => ?_⟩, fun p hp => ?_⟩
    · have := Int.emod_lt_of_pos (z k) hPZ
      show z k % (P:ℤ) ≤ (P:ℤ) - 1
      omega
    · refine (hperP p hp (ρ z) z (fun k => ?_)).2 (hz.2.2 p hp)
      have := hρdvd z k
      have h2 : ρ z k - z k = -(z k - ρ z k) := by ring
      rw [h2]
      exact (dvd_neg).2 this
  let b : (ι → ℤ) → (ι → ℤ) := fun a k => c k * (v * P) + a k * (u * Q)
  have hfib : ∀ a ∈ G, (A.filter (fun z => ρ z = a)).card
      = (R.filter (fun z => ∀ k, ((Q * P : ℕ) : ℤ) ∣ z k - b a k)).card := by
    intro a ha
    rw [hG, Finset.mem_filter, Finset.mem_Icc] at ha
    obtain ⟨⟨ha0, haP⟩, haBad⟩ := ha
    congr 1
    ext z
    simp only [hA, Finset.mem_filter]
    have I1 : ∀ k, z k - b a k = (z k - c k) + (u * Q) * (c k - a k) := by
      intro k; simp only [b]; linear_combination (-(c k)) * huv
    have I2 : ∀ k, z k - b a k = (z k - a k) + (v * P) * (a k - c k) := by
      intro k; simp only [b]; linear_combination (-(a k)) * huv
    have hcast : ((Q * P : ℕ) : ℤ) = (Q:ℤ) * (P:ℤ) := by push_cast; ring
    rw [hcast]
    constructor
    · rintro ⟨⟨hzR, hzQ, _⟩, hρa⟩
      refine ⟨hzR, fun k => ?_⟩
      have hPa : (P:ℤ) ∣ z k - a k := by
        have := hρdvd z k
        rw [← hρa]
        exact this
      apply IsCoprime.mul_dvd ⟨u, v, huv⟩
      · rw [I1 k]
        exact dvd_add (hzQ k) (dvd_mul_of_dvd_left (dvd_mul_left _ _) _)
      · rw [I2 k]
        exact dvd_add hPa (dvd_mul_of_dvd_left (dvd_mul_left _ _) _)
    · rintro ⟨hzR, hzb⟩
      have hQb : ∀ k, (Q:ℤ) ∣ z k - b a k := fun k => dvd_of_mul_right_dvd (hzb k)
      have hPb : ∀ k, (P:ℤ) ∣ z k - b a k := fun k => dvd_of_mul_left_dvd (hzb k)
      have hQc : ∀ k, (Q:ℤ) ∣ z k - c k := by
        intro k
        have h : z k - c k = (z k - b a k) - (u * Q) * (c k - a k) := by rw [I1 k]; ring
        rw [h]
        exact dvd_sub (hQb k) (dvd_mul_of_dvd_left (dvd_mul_left _ _) _)
      have hPa : ∀ k, (P:ℤ) ∣ z k - a k := by
        intro k
        have h : z k - a k = (z k - b a k) - (v * P) * (a k - c k) := by rw [I2 k]; ring
        rw [h]
        exact dvd_sub (hPb k) (dvd_mul_of_dvd_left (dvd_mul_left _ _) _)
      refine ⟨⟨hzR, hQc, fun p hp => (hperP p hp z a hPa).2 (haBad p hp)⟩, ?_⟩
      funext k
      show z k % (P:ℤ) = a k
      have hak : a k % (P:ℤ) = a k :=
        Int.emod_eq_of_lt (ha0 k) (by have := haP k; simp at this; omega)
      rw [← hak]
      exact Int.emod_eq_emod_iff_emod_sub_eq_zero.2 (Int.emod_eq_zero_of_dvd (hPa k))
  have hcardA : A.card = ∑ a ∈ G,
      (R.filter (fun z => ∀ k, ((Q * P : ℕ) : ℤ) ∣ z k - b a k)).card :=
    (Finset.card_eq_sum_card_fiberwise hmaps).trans (Finset.sum_congr rfl hfib)
  have hD : ((Q:ℝ) * (P:ℝ)) ^ Fintype.card ι = (((Q * P : ℕ) : ℝ)) ^ Fintype.card ι := by
    push_cast; ring
  rw [hcardA, hD, Nat.cast_sum]
  have hsplit : (R.card : ℝ) * (G.card : ℝ) / (((Q * P : ℕ) : ℝ)) ^ Fintype.card ι
      = ∑ a ∈ G, (R.card : ℝ) / (((Q * P : ℕ) : ℝ)) ^ Fintype.card ι := by
    rw [Finset.sum_const, nsmul_eq_mul]; ring
  rw [hsplit, ← Finset.sum_sub_distrib]
  calc _ ≤ ∑ a ∈ G, |((R.filter (fun z => ∀ k, ((Q * P : ℕ) : ℤ) ∣ z k - b a k)).card : ℝ)
          - (R.card : ℝ) / (((Q * P : ℕ) : ℝ)) ^ Fintype.card ι| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ G.card • E := Finset.sum_le_card_nsmul _ _ _ (fun a _ => heq (Q * P) hQP (b a))
    _ = (G.card : ℝ) * E := nsmul_eq_mul _ _

theorem kai_sieve_assembly_real {γ : Type*} (C : Finset γ) (𝒯 : Finset (Finset ℕ))
    (N : γ → ℝ) (A : γ → Finset ℕ → ℝ) (f P : Finset ℕ → ℝ) (X E q : ℝ) (n r : ℕ)
    (hq : 0 < q) (hC : (C.card : ℝ) = q ^ n)
    (hbonf : ∀ c ∈ C, |N c - ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), (-1 : ℝ) ^ T.card * A c T|
        ≤ ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), A c T)
    (hA : ∀ c ∈ C, ∀ T ∈ 𝒯, |A c T - X * f T / (q * P T) ^ n| ≤ f T * E) :
    ∑ c ∈ C, |N c - X * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r),
        (-1 : ℝ) ^ T.card * f T / (q * P T) ^ n|
      ≤ X * ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), f T / P T ^ n
        + q ^ n * E * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r + 1), f T :=
by
  classical
  have hqn : q ^ n ≠ 0 := pow_ne_zero n hq.ne'
  
  have hsplit : ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r + 1), f T
      = ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), f T
        + ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), f T := by
    simp only [Finset.sum_filter, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun T _ => ?_)
    by_cases h1 : T.card ≤ r
    · have h2 : T.card ≠ r + 1 := by omega
      have h3 : T.card ≤ r + 1 := by omega
      simp [h1, h2, h3]
    · by_cases h2 : T.card = r + 1
      · have h3 : T.card ≤ r + 1 := by omega
        simp [h1, h2]
      · have h3 : ¬ T.card ≤ r + 1 := by omega
        simp [h1, h2, h3]
  
  have hpt : ∀ c ∈ C, |N c - X * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r),
        (-1 : ℝ) ^ T.card * f T / (q * P T) ^ n|
      ≤ ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), X * f T / (q * P T) ^ n
        + E * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r + 1), f T := by
    intro c hc
    have h1 := hbonf c hc
    have h2 : |∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), (-1 : ℝ) ^ T.card * A c T
        - X * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), (-1 : ℝ) ^ T.card * f T / (q * P T) ^ n|
        ≤ ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), f T * E := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun T hT => ?_)
      have hT' : T ∈ 𝒯 := (Finset.mem_filter.1 hT).1
      have hb := hA c hc T hT'
      have e : (-1 : ℝ) ^ T.card * A c T - X * ((-1 : ℝ) ^ T.card * f T / (q * P T) ^ n)
          = (-1 : ℝ) ^ T.card * (A c T - X * f T / (q * P T) ^ n) := by ring
      rw [e, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
      exact hb
    have h3 : ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), A c T
        ≤ ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), (X * f T / (q * P T) ^ n + f T * E) := by
      refine Finset.sum_le_sum fun T hT => ?_
      have hb := hA c hc T (Finset.mem_filter.1 hT).1
      have := (abs_le.1 hb).2
      linarith
    have h4 := abs_sub_le (N c)
      (∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), (-1 : ℝ) ^ T.card * A c T)
      (X * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), (-1 : ℝ) ^ T.card * f T / (q * P T) ^ n)
    rw [Finset.sum_add_distrib] at h3
    have h5 : E * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r + 1), f T
        = ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r), f T * E
          + ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), f T * E := by
      rw [hsplit, ← Finset.sum_mul, ← Finset.sum_mul]; ring
    linarith
  
  have hres : q ^ n * ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), X * f T / (q * P T) ^ n
      = X * ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), f T / P T ^ n := by
    rw [Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun T _ => ?_)
    calc q ^ n * (X * f T / (q * P T) ^ n)
        = X * f T * (q ^ n * ((q ^ n)⁻¹ * (P T ^ n)⁻¹)) := by
          rw [mul_pow, div_eq_mul_inv, mul_inv]; ring
      _ = X * (f T / P T ^ n) := by
          rw [mul_inv_cancel_left₀ hqn, div_eq_mul_inv]; ring
  calc ∑ c ∈ C, |N c - X * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r),
        (-1 : ℝ) ^ T.card * f T / (q * P T) ^ n|
      ≤ ∑ c ∈ C, (∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), X * f T / (q * P T) ^ n
        + E * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r + 1), f T) := Finset.sum_le_sum hpt
    _ = q ^ n * (∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), X * f T / (q * P T) ^ n
        + E * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r + 1), f T) := by
          rw [Finset.sum_const, nsmul_eq_mul, hC]
    _ = X * ∑ T ∈ 𝒯.filter (fun T => T.card = r + 1), f T / P T ^ n
        + q ^ n * E * ∑ T ∈ 𝒯.filter (fun T => T.card ≤ r + 1), f T := by
          rw [mul_add, hres]; ring

theorem kai_cube_abstract_sieve {ι : Type*} [Fintype ι] [DecidableEq ι]
    (R : Finset (ι → ℤ)) (L J : ℕ)
    (hbox : ∀ z ∈ R, ∀ k, |z k| ≤ (L : ℤ))
    (hline : ∀ (z : ι → ℤ) (k : ι),
      (R.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
        Function.update y k (y k - 1) ∉ R)).card ≤ J)
    (U : Finset ℕ) (hU : ∀ p ∈ U, p.Prime) (Q : ℕ) (hQ : 1 ≤ Q) (hQU : ∀ p ∈ U, ¬ p ∣ Q)
    (Bad : ℕ → (ι → ℤ) → Prop) [∀ p z, Decidable (Bad p z)]
    (hper : ∀ p ∈ U, ∀ z z' : ι → ℤ, (∀ k, (p : ℤ) ∣ z k - z' k) → (Bad p z ↔ Bad p z'))
    (r : ℕ) :
    ∑ c ∈ Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => (Q:ℤ) - 1),
      |((R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ U, ¬ Bad p z)).card : ℝ)
        - (R.card : ℝ) * ∑ T ∈ U.powerset.filter (fun T => T.card ≤ r),
            (-1 : ℝ) ^ T.card *
              (((Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
                  (fun a => ∀ p ∈ T, Bad p a)).card : ℝ)
              / ((Q : ℝ) * ((∏ p ∈ T, p : ℕ) : ℝ)) ^ Fintype.card ι|
    ≤ (R.card : ℝ) * ∑ T ∈ U.powerset.filter (fun T => T.card = r + 1),
          (((Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
              (fun a => ∀ p ∈ T, Bad p a)).card : ℝ) / ((∏ p ∈ T, p : ℕ) : ℝ) ^ Fintype.card ι
      + (Q : ℝ) ^ Fintype.card ι *
          ((Fintype.card ι : ℝ) * J * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1)) *
          ∑ T ∈ U.powerset.filter (fun T => T.card ≤ r + 1),
            (((Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
              (fun a => ∀ p ∈ T, Bad p a)).card : ℝ) :=
by
  have hstep : ∀ (m : ℕ), 1 ≤ m → ∀ (R' : Finset (ι → ℤ)) (k : ι) (β : ℤ),
      (∀ z ∈ R', ∀ k', |z k'| ≤ (L : ℤ)) →
      (∀ z : ι → ℤ, (R'.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
        Function.update y k (y k - 1) ∉ R')).card ≤ J) →
      |((R'.filter (fun z => (m : ℤ) ∣ z k - β)).card : ℝ) - (R'.card : ℝ) / m|
        ≤ (J : ℝ) * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) :=
    fun m hm R' k β hb hl =>
      kai_sieve_line_step R' L J k m hm β hb hl (fun A => kai_sieve_run_residue_1d A m hm β)
  have heq : ∀ (m : ℕ), 1 ≤ m → ∀ b : ι → ℤ,
      |((R.filter (fun z => ∀ k, (m : ℤ) ∣ z k - b k)).card : ℝ)
        - (R.card : ℝ) / (m : ℝ) ^ Fintype.card ι|
        ≤ (Fintype.card ι : ℝ) * J * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1) :=
    fun m hm b => kai_sieve_box_equidist R L J m hm hbox hline (hstep m hm) b
  have hQpos : (0:ℝ) < Q := by exact_mod_cast hQ
  have hC : ((Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => (Q:ℤ) - 1)).card : ℝ)
      = (Q:ℝ) ^ Fintype.card ι := by
    rw [Pi.card_Icc]
    simp [Int.card_Icc]
  refine kai_sieve_assembly_real (Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => (Q:ℤ) - 1))
    U.powerset
    (fun c => ((R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ U, ¬ Bad p z)).card : ℝ))
    (fun c T => ((R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ T, Bad p z)).card : ℝ))
    (fun T => (((Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
                  (fun a => ∀ p ∈ T, Bad p a)).card : ℝ))
    (fun T => ((∏ p ∈ T, p : ℕ) : ℝ)) (R.card : ℝ)
    ((Fintype.card ι : ℝ) * J * (2 * (L : ℝ) + 1) ^ (Fintype.card ι - 1)) (Q : ℝ)
    (Fintype.card ι) r hQpos hC ?_ ?_
  · intro c _
    have h := kai_sieve_bonferroni_count (R.filter (fun z => ∀ k, (Q:ℤ) ∣ z k - c k)) U Bad r
    simp only [Finset.filter_filter] at h
    exact h
  · intro c _ T hT
    have hTU := Finset.mem_powerset.1 hT
    exact kai_sieve_T_class_count R _ heq T (fun p hp => hU p (hTU hp)) Q hQ
      (fun p hp => hQU p (hTU hp)) Bad (fun p hp => hper p (hTU hp)) c

theorem kai_cube_region_lines (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (S : Set (NumberField.RingOfIntegers K)) (J₀ : ℕ) :
    (KaiLineProp ω S J₀ →
      ∀ R : Finset (Fin 4 × Fin (Module.finrank ℚ K) → ℤ),
        (∀ z, z ∈ R ↔ ∀ ε : Fin 3 → Fin 2, kaiCubeVtx ω z ε ∈ S) →
        ∀ (z : Fin 4 × Fin (Module.finrank ℚ K) → ℤ) (k : Fin 4 × Fin (Module.finrank ℚ K)),
          (R.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
            Function.update y k (y k - 1) ∉ R)).card ≤ 8 * J₀) ∧
    (∀ M : ℝ, S ⊆ ↑(omegaBox ω M) →
      ∀ z : Fin 4 × Fin (Module.finrank ℚ K) → ℤ,
        (∀ ε : Fin 3 → Fin 2, kaiCubeVtx ω z ε ∈ S) →
        ∀ k, |z k| ≤ 2 * (⌊M⌋₊ : ℤ)) :=
by
  
  have hcoords : ∀ (z : Fin 4 × Fin (Module.finrank ℚ K) → ℤ) (ε : Fin 3 → Fin 2),
      kaiCubeVtx ω z ε = ω.equivFun.symm (fun j => z (0, j) + ((ε 0 : ℕ) : ℤ) * z (1, j)
        + ((ε 1 : ℕ) : ℤ) * z (2, j) + ((ε 2 : ℕ) : ℤ) * z (3, j)) := by
    intro z ε
    have e : (fun j => z (0, j) + ((ε 0 : ℕ) : ℤ) * z (1, j)
        + ((ε 1 : ℕ) : ℤ) * z (2, j) + ((ε 2 : ℕ) : ℤ) * z (3, j))
        = (fun j => z (0, j)) + (ε 0 : ℕ) • (fun j => z (1, j)) + (ε 1 : ℕ) • (fun j => z (2, j))
          + (ε 2 : ℕ) • (fun j => z (3, j)) := by
      funext j
      simp [nsmul_eq_mul]
    rw [e, map_add, map_add, map_add, map_nsmul, map_nsmul, map_nsmul]
    rfl
  
  have hline : ∀ (z : Fin 4 × Fin (Module.finrank ℚ K) → ℤ)
      (k : Fin 4 × Fin (Module.finrank ℚ K)) (ε : Fin 3 → Fin 2),
      ∃ a : ℤ, (a = 0 ∨ a = 1) ∧ ∀ t : ℤ,
        kaiCubeVtx ω (Function.update z k t) ε
          = kaiCubeVtx ω (Function.update z k 0) ε + (a * t) • ω k.2 := by
    intro z k ε
    obtain ⟨i₀, j₀⟩ := k
    have main : ∀ a : ℤ, a = (if i₀ = 0 then 1 else 0) + (if i₀ = 1 then ((ε 0 : ℕ) : ℤ) else 0)
        + (if i₀ = 2 then ((ε 1 : ℕ) : ℤ) else 0) + (if i₀ = 3 then ((ε 2 : ℕ) : ℤ) else 0) →
        ∀ t : ℤ, kaiCubeVtx ω (Function.update z (i₀, j₀) t) ε
          = kaiCubeVtx ω (Function.update z (i₀, j₀) 0) ε + (a * t) • ω j₀ := by
      intro a ha t
      rw [hcoords, hcoords, ← sub_eq_iff_eq_add', ← map_sub,
        Module.Basis.equivFun_symm_apply, Finset.sum_eq_single j₀]
      · congr 1
        rw [ha]
        fin_cases i₀ <;> simp [Function.update_apply] <;> ring
      · intro j _ hj
        simp [Function.update_apply, hj]
      · intro h
        exact absurd (Finset.mem_univ j₀) h
    refine ⟨_, ?_, main _ rfl⟩
    have h0 := (ε 0).isLt
    have h1 := (ε 1).isLt
    have h2 := (ε 2).isLt
    fin_cases i₀ <;> simp <;> omega
  refine ⟨fun hL R hR z k => ?_, fun M hS z hz k => ?_⟩
  · 
    set G := R.filter (fun y => (∀ k', k' ≠ k → y k' = z k') ∧
      Function.update y k (y k - 1) ∉ R) with hG
    have hupd : ∀ y ∈ G, y = Function.update z k (y k) := by
      intro y hy
      have hy' := (Finset.mem_filter.1 hy).2.1
      funext k'
      by_cases hk : k' = k
      · subst hk
        simp
      · rw [Function.update_of_ne hk]
        exact hy' k' hk
    have hinj : Set.InjOn (fun y => y k) (G : Set (Fin 4 × Fin (Module.finrank ℚ K) → ℤ)) := by
      intro y hy y' hy' h
      rw [hupd y hy, hupd y' hy']
      simp only at h
      rw [h]
    rw [← Finset.card_image_of_injOn hinj]
    have hFprop : ∀ t ∈ G.image (fun y => y k),
        (∀ ε, kaiCubeVtx ω (Function.update z k t) ε ∈ S) ∧
        ¬ ∀ ε, kaiCubeVtx ω (Function.update z k (t - 1)) ε ∈ S := by
      intro t ht
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 ht
      have hyR := (Finset.mem_filter.1 hy).1
      have hyP := (Finset.mem_filter.1 hy).2.2
      have e := hupd y hy
      refine ⟨?_, fun h => hyP ?_⟩
      · rw [← e]
        exact (hR y).1 hyR
      · have hyy : Function.update y k (y k - 1) = Function.update z k (y k - 1) := by
          conv_lhs => rw [e]
          simp
        rw [hyy]
        exact (hR _).2 h
    have hstart : ∀ ε : Fin 3 → Fin 2, ∃ I : Finset (ℤ × ℤ), I.card ≤ J₀ ∧
        ∀ t : ℤ, kaiCubeVtx ω (Function.update z k t) ε ∈ S →
          kaiCubeVtx ω (Function.update z k (t - 1)) ε ∉ S → t ∈ I.image Prod.fst := by
      intro ε
      obtain ⟨a, ha, hfor⟩ := hline z k ε
      rcases ha with rfl | rfl
      · refine ⟨∅, by simp, fun t h1 h2 => absurd ?_ h2⟩
        rw [hfor] at h1 ⊢
        simpa using h1
      · obtain ⟨I, hI, hIt⟩ := hL (kaiCubeVtx ω (Function.update z k 0) ε) k.2
        refine ⟨I, hI, fun t h1 h2 => ?_⟩
        rw [hfor, one_mul] at h1 h2
        obtain ⟨p, hp, hp1, hp2⟩ := (hIt t).1 h1
        have hnot : ¬ (p.1 ≤ t - 1) := fun h => h2 ((hIt (t - 1)).2 ⟨p, hp, h, by omega⟩)
        exact Finset.mem_image.2 ⟨p, hp, by omega⟩
    choose I hIcard hIstart using hstart
    have hsub : G.image (fun y => y k) ⊆
        Finset.univ.biUnion (fun ε => (I ε).image Prod.fst) := by
      intro t ht
      obtain ⟨h1, h2⟩ := hFprop t ht
      push_neg at h2
      obtain ⟨ε, hε⟩ := h2
      exact Finset.mem_biUnion.2 ⟨ε, Finset.mem_univ _, hIstart ε t (h1 ε) hε⟩
    calc (G.image (fun y => y k)).card
        ≤ (Finset.univ.biUnion (fun ε => (I ε).image Prod.fst)).card :=
          Finset.card_le_card hsub
      _ ≤ ∑ ε, ((I ε).image Prod.fst).card := Finset.card_biUnion_le
      _ ≤ ∑ _ε : Fin 3 → Fin 2, J₀ :=
          Finset.sum_le_sum (fun ε _ => Finset.card_image_le.trans (hIcard ε))
      _ = 8 * J₀ := by simp
  · 
    have hbox : ∀ v : Fin (Module.finrank ℚ K) → ℤ, ω.equivFun.symm v ∈ S →
        ∀ j, |v j| ≤ (⌊M⌋₊ : ℤ) := by
      intro v hv j
      classical
      have hv' := hS hv
      rw [Finset.mem_coe] at hv'
      unfold omegaBox at hv'
      obtain ⟨w, hw, hwv⟩ := Finset.mem_image.1 hv'
      have hwv' : w = v := ω.equivFun.symm.injective hwv
      subst hwv'
      unfold intBox at hw
      rw [Finset.mem_Icc] at hw
      exact abs_le.2 ⟨hw.1 j, hw.2 j⟩
    have hv : ∀ ε : Fin 3 → Fin 2, ∀ j, |z (0, j) + ((ε 0 : ℕ) : ℤ) * z (1, j)
        + ((ε 1 : ℕ) : ℤ) * z (2, j) + ((ε 2 : ℕ) : ℤ) * z (3, j)| ≤ (⌊M⌋₊ : ℤ) := by
      intro ε
      have hzε := hz ε
      rw [hcoords] at hzε
      exact hbox _ hzε
    obtain ⟨i, j⟩ := k
    have e0 : |z (0, j)| ≤ (⌊M⌋₊ : ℤ) := by simpa using hv ![0, 0, 0] j
    have e1 : |z (0, j) + z (1, j)| ≤ (⌊M⌋₊ : ℤ) := by simpa using hv ![1, 0, 0] j
    have e2 : |z (0, j) + z (2, j)| ≤ (⌊M⌋₊ : ℤ) := by simpa using hv ![0, 1, 0] j
    have e3 : |z (0, j) + z (3, j)| ≤ (⌊M⌋₊ : ℤ) := by simpa using hv ![0, 0, 1] j
    rw [abs_le] at e0 e1 e2 e3
    rw [abs_le]
    fin_cases i
    · show -(2 * (⌊M⌋₊ : ℤ)) ≤ z (0, j) ∧ z (0, j) ≤ 2 * (⌊M⌋₊ : ℤ)
      constructor <;> linarith [e0.1, e0.2]
    · show -(2 * (⌊M⌋₊ : ℤ)) ≤ z (1, j) ∧ z (1, j) ≤ 2 * (⌊M⌋₊ : ℤ)
      constructor <;> linarith [e0.1, e0.2, e1.1, e1.2]
    · show -(2 * (⌊M⌋₊ : ℤ)) ≤ z (2, j) ∧ z (2, j) ≤ 2 * (⌊M⌋₊ : ℤ)
      constructor <;> linarith [e0.1, e0.2, e2.1, e2.2]
    · show -(2 * (⌊M⌋₊ : ℤ)) ≤ z (3, j) ∧ z (3, j) ≤ 2 * (⌊M⌋₊ : ℤ)
      constructor <;> linarith [e0.1, e0.2, e3.1, e3.2]

theorem kai_cube_bad_local (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    [∀ p z, Decidable (kaiCubeBad ω p z)] :
    (∀ (p : ℕ) (z z' : Fin 4 × Fin (Module.finrank ℚ K) → ℤ), (∀ k, (p : ℤ) ∣ z k - z' k) →
      (kaiCubeBad ω p z ↔ kaiCubeBad ω p z')) ∧
    (∀ T : Finset ℕ, (∀ p ∈ T, p.Prime) →
      ((Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
          (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
            (fun a => ∀ p ∈ T, kaiCubeBad ω p a)).card
        ≤ ∏ p ∈ T, 8 * Module.finrank ℚ K * p ^ (4 * Module.finrank ℚ K - 1)) :=
by
  classical
  
  have hlin : ∀ (ε : Fin 3 → Fin 2) (z w : Fin 4 × Fin (Module.finrank ℚ K) → ℤ) (c : ℤ),
      kaiCubeVtx ω (z + c • w) ε
        = kaiCubeVtx ω z ε + (c : NumberField.RingOfIntegers K) * kaiCubeVtx ω w ε := by
    intro ε z w c
    have e : ∀ i : Fin 4, (fun j => (z + c • w) (i, j))
        = (fun j => z (i, j)) + c • (fun j => w (i, j)) := by
      intro i; funext j; simp
    unfold kaiCubeVtx cubeVertex
    rw [e 0, e 1, e 2, e 3]
    simp only [map_add, map_zsmul, LinearEquiv.map_smul]
    simp only [zsmul_eq_mul, nsmul_eq_mul]
    ring
  have hsingle : ∀ (ε : Fin 3 → Fin 2) (j : Fin (Module.finrank ℚ K)) (t : ℤ),
      kaiCubeVtx ω (Pi.single ((0 : Fin 4), j) t) ε
        = (t : NumberField.RingOfIntegers K) * ω j := by
    intro ε j t
    have e0 : (fun j' => (Pi.single ((0 : Fin 4), j) t : Fin 4 × Fin (Module.finrank ℚ K) → ℤ)
        ((0 : Fin 4), j')) = Pi.single j t := by
      funext j'
      by_cases h : j' = j
      · subst h; simp
      · simp [Pi.single_apply, h]
    have ei : ∀ i : Fin 4, i ≠ 0 →
        (fun j' => (Pi.single ((0 : Fin 4), j) t : Fin 4 × Fin (Module.finrank ℚ K) → ℤ)
          (i, j')) = 0 := by
      intro i hi; funext j'; simp [Pi.single_apply, hi]
    unfold kaiCubeVtx cubeVertex
    rw [e0, ei 1 (by decide), ei 2 (by decide), ei 3 (by decide)]
    simp [Module.Basis.equivFun_symm_apply, Pi.single_apply, zsmul_eq_mul]
  
  have hper : ∀ (p : ℕ) (z z' : Fin 4 × Fin (Module.finrank ℚ K) → ℤ),
      (∀ k, (p : ℤ) ∣ z k - z' k) → (kaiCubeBad ω p z ↔ kaiCubeBad ω p z') := by
    intro p z z' hd
    have hd' : ∀ k, ∃ c, z k - z' k = (p : ℤ) * c := fun k => hd k
    choose w hw using hd'
    have hz : z = z' + (p : ℤ) • w := by
      funext k
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      linarith [hw k]
    have hv : ∀ ε, kaiCubeVtx ω z ε
        = kaiCubeVtx ω z' ε + ((p : ℤ) : NumberField.RingOfIntegers K) * kaiCubeVtx ω w ε := by
      intro ε; rw [hz, hlin]
    unfold kaiCubeBad CoprimeToNat
    refine exists_congr (fun ε => not_congr (forall_congr' (fun 𝔭 =>
      imp_congr_right (fun hp => not_congr ?_))))
    rw [hv ε, Int.cast_natCast]
    exact Ideal.add_mem_iff_left _ (Ideal.mul_mem_right _ _ hp)
  
  have hunder : ∀ (p : ℕ), p.Prime → ∀ (P : Ideal (NumberField.RingOfIntegers K)), P.IsPrime →
      ((p : ℕ) : NumberField.RingOfIntegers K) ∈ P →
      Ideal.span {(p : ℤ)} = P.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) := by
    intro p hp P hP hpP
    haveI : Fact p.Prime := ⟨hp⟩
    haveI := hP
    have hmax : (Ideal.span {(p : ℤ)}).IsMaximal := Int.ideal_span_isMaximal_of_prime p
    refine hmax.eq_of_le (Ideal.IsPrime.comap (algebraMap ℤ (NumberField.RingOfIntegers K))).ne_top ?_
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, map_natCast]
    exact hpP
  
  have hF : ∀ p : ℕ, p.Prime → ∃ F : Finset (Ideal (NumberField.RingOfIntegers K)),
      F.card ≤ Module.finrank ℚ K ∧
      ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal → 𝔭.asIdeal ∈ F := by
    intro p hp
    haveI : Fact p.Prime := ⟨hp⟩
    haveI hmax : (Ideal.span {(p : ℤ)}).IsMaximal := Int.ideal_span_isMaximal_of_prime p
    have h0 : Ideal.span {(p : ℤ)} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact_mod_cast hp.ne_zero
    refine ⟨primesOverFinset (Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers K),
      Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers K) ℚ K h0, ?_⟩
    intro 𝔭 hp𝔭
    rw [mem_primesOverFinset_iff h0]
    exact ⟨𝔭.isPrime, ⟨hunder p hp 𝔭.asIdeal 𝔭.isPrime hp𝔭⟩⟩
  
  have hS3 : ∀ (p : ℕ), p.Prime → ∀ (P : Ideal (NumberField.RingOfIntegers K)), P.IsPrime →
      ((p : ℕ) : NumberField.RingOfIntegers K) ∈ P → ∀ ε : Fin 3 → Fin 2,
      ((Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ)) (fun _ => (p:ℤ) - 1)).filter
        (fun a => kaiCubeVtx ω a ε ∈ P)).card ≤ p ^ (4 * Module.finrank ℚ K - 1) := by
    intro p hp P hP hpP ε
    obtain ⟨j₀, hj₀⟩ : ∃ j, ω j ∉ P := by
      by_contra h
      push_neg at h
      apply hP.ne_top
      rw [Ideal.eq_top_iff_one, ← ω.sum_repr 1]
      exact Ideal.sum_mem _ (fun j _ => by rw [zsmul_eq_mul]; exact Ideal.mul_mem_left _ _ (h j))
    obtain ⟨k₀, hk₀⟩ : ∃ k₀ : Fin 4 × Fin (Module.finrank ℚ K), k₀ = ((0 : Fin 4), j₀) :=
      ⟨_, rfl⟩
    have hsk : ∀ t : ℤ, kaiCubeVtx ω (Pi.single k₀ t) ε
        = (t : NumberField.RingOfIntegers K) * ω j₀ := by
      intro t; rw [hk₀]; exact hsingle ε j₀ t
    refine (Finset.card_le_card_of_injOn (fun a => Function.update a k₀ 0)
      (t := Fintype.piFinset (fun k => if k = k₀ then ({0} : Finset ℤ)
        else Finset.Icc 0 ((p:ℤ) - 1))) ?_ ?_).trans ?_
    · intro a ha
      rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc] at ha
      rw [Finset.mem_coe, Fintype.mem_piFinset]
      intro k
      by_cases hk : k = k₀
      · rw [hk]; simp
      · show Function.update a k₀ 0 k ∈ _
        rw [if_neg hk, Function.update_of_ne hk, Finset.mem_Icc]
        exact ⟨ha.1.1 k, ha.1.2 k⟩
    · intro a ha a' ha' heq
      rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc] at ha ha'
      have heq' : Function.update a k₀ 0 = Function.update a' k₀ 0 := heq
      have hdecomp : a = a' + Pi.single k₀ (a k₀ - a' k₀) := by
        funext k
        by_cases hk : k = k₀
        · rw [hk, Pi.add_apply, Pi.single_eq_same]; ring
        · have := congrFun heq' k
          rw [Function.update_of_ne hk, Function.update_of_ne hk] at this
          rw [Pi.add_apply, Pi.single_eq_of_ne hk, add_zero]
          exact this
      have hv := hlin ε a' (Pi.single k₀ (a k₀ - a' k₀)) 1
      rw [one_smul, ← hdecomp, Int.cast_one, one_mul, hsk] at hv
      have hmem : ((a k₀ - a' k₀ : ℤ) : NumberField.RingOfIntegers K) * ω j₀ ∈ P := by
        have : ((a k₀ - a' k₀ : ℤ) : NumberField.RingOfIntegers K) * ω j₀
            = kaiCubeVtx ω a ε - kaiCubeVtx ω a' ε := by
          rw [hv]; ring
        rw [this]; exact Ideal.sub_mem _ ha.2 ha'.2
      have ht : ((a k₀ - a' k₀ : ℤ) : NumberField.RingOfIntegers K) ∈ P :=
        (hP.mem_or_mem hmem).resolve_right hj₀
      have hdvd : (p : ℤ) ∣ a k₀ - a' k₀ := by
        have h1 : (a k₀ - a' k₀) ∈ P.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) := by
          rw [Ideal.mem_comap, eq_intCast]; exact ht
        rw [← hunder p hp P hP hpP, Ideal.mem_span_singleton] at h1
        exact h1
      have h0 : a k₀ - a' k₀ = 0 := by
        apply Int.eq_zero_of_abs_lt_dvd hdvd
        have b1 : (0:ℤ) ≤ a k₀ := ha.1.1 k₀
        have b2 : a k₀ ≤ (p:ℤ) - 1 := ha.1.2 k₀
        have b3 : (0:ℤ) ≤ a' k₀ := ha'.1.1 k₀
        have b4 : a' k₀ ≤ (p:ℤ) - 1 := ha'.1.2 k₀
        rw [abs_lt]
        constructor <;> linarith
      rw [hdecomp, h0, Pi.single_zero, add_zero]
    · rw [Fintype.card_piFinset]
      have hc : ∀ k, (if k = k₀ then ({0} : Finset ℤ) else Finset.Icc 0 ((p:ℤ) - 1)).card
          = if k = k₀ then 1 else p := by
        intro k; split_ifs <;> simp
      rw [Finset.prod_congr rfl (fun k _ => hc k)]
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ k₀), if_pos rfl, one_mul,
        Finset.prod_congr rfl (fun k hk => if_neg (Finset.ne_of_mem_erase hk)), Finset.prod_const,
        Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_prod,
        Fintype.card_fin, Fintype.card_fin]
  
  have hS5 : ∀ p : ℕ, p.Prime →
      ((Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ)) (fun _ => (p:ℤ) - 1)).filter
        (fun a => kaiCubeBad ω p a)).card
        ≤ 8 * Module.finrank ℚ K * p ^ (4 * Module.finrank ℚ K - 1) := by
    intro p hp
    obtain ⟨F, hFcard, hFmem⟩ := hF p hp
    calc _ ≤ ((Finset.univ : Finset (Fin 3 → Fin 2)).biUnion (fun ε => F.biUnion (fun P =>
          (Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
            (fun _ => (p:ℤ) - 1)).filter
            (fun a => kaiCubeVtx ω a ε ∈ P ∧ P.IsPrime ∧
              ((p : ℕ) : NumberField.RingOfIntegers K) ∈ P)))).card := by
          apply Finset.card_le_card
          intro a ha
          rw [Finset.mem_filter] at ha
          obtain ⟨hbox, hbad⟩ := ha
          unfold kaiCubeBad CoprimeToNat at hbad
          obtain ⟨ε, hε⟩ := hbad
          push_neg at hε
          obtain ⟨𝔭, hp𝔭, hv𝔭⟩ := hε
          rw [Finset.mem_biUnion]
          refine ⟨ε, Finset.mem_univ _, ?_⟩
          rw [Finset.mem_biUnion]
          exact ⟨𝔭.asIdeal, hFmem 𝔭 hp𝔭, Finset.mem_filter.2 ⟨hbox, hv𝔭, 𝔭.isPrime, hp𝔭⟩⟩
      _ ≤ ∑ ε : Fin 3 → Fin 2, ∑ P ∈ F, p ^ (4 * Module.finrank ℚ K - 1) := by
          refine Finset.card_biUnion_le.trans (Finset.sum_le_sum (fun ε _ => ?_))
          refine Finset.card_biUnion_le.trans (Finset.sum_le_sum (fun P _ => ?_))
          by_cases h : P.IsPrime ∧ ((p : ℕ) : NumberField.RingOfIntegers K) ∈ P
          · refine le_trans (Finset.card_le_card ?_) (hS3 p hp P h.1 h.2 ε)
            intro a ha
            rw [Finset.mem_filter] at ha ⊢
            exact ⟨ha.1, ha.2.1⟩
          · rw [Finset.filter_false_of_mem (fun a _ hA => h hA.2)]
            simp
      _ = 8 * F.card * p ^ (4 * Module.finrank ℚ K - 1) := by
          rw [Finset.sum_const, Finset.sum_const, Finset.card_univ, Fintype.card_fun,
            Fintype.card_fin, Fintype.card_fin, smul_eq_mul, smul_eq_mul]
          ring
      _ ≤ _ := by gcongr
  
  have hCRT : ∀ T : Finset ℕ, (∀ p ∈ T, p.Prime) →
      ((Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
          (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
            (fun a => ∀ p ∈ T, kaiCubeBad ω p a)).card
        ≤ ∏ p ∈ T, ((Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
            (fun _ => (p:ℤ) - 1)).filter (fun a => kaiCubeBad ω p a)).card := by
    intro T hT
    refine (Finset.card_le_card_of_injOn (fun a p _ => fun k => a k % (p:ℤ))
      (t := T.pi (fun p => (Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
            (fun _ => (p:ℤ) - 1)).filter (fun a => kaiCubeBad ω p a))) ?_ ?_).trans
      (le_of_eq (Finset.card_pi _ _))
    · intro a ha
      rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc] at ha
      rw [Finset.mem_coe, Finset.mem_pi]
      intro p hp
      have hpos : (0:ℤ) < p := by exact_mod_cast (hT p hp).pos
      rw [Finset.mem_filter, Finset.mem_Icc]
      refine ⟨⟨fun k => Int.emod_nonneg _ hpos.ne', fun k => ?_⟩, ?_⟩
      · have := Int.emod_lt_of_pos (a k) hpos
        show a k % (p:ℤ) ≤ (p:ℤ) - 1
        omega
      · refine (hper p (fun k => a k % (p:ℤ)) a (fun k => ⟨-(a k / (p:ℤ)), ?_⟩)).2 (ha.2 p hp)
        show a k % (p:ℤ) - a k = (p:ℤ) * -(a k / (p:ℤ))
        rw [Int.emod_def]; ring
    · intro a ha a' ha' heq
      rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc] at ha ha'
      funext k
      have hdvd : ∀ p ∈ T, (p : ℤ) ∣ a' k - a k := by
        intro p hp
        have h1 : a k % (p:ℤ) = a' k % (p:ℤ) := congrFun (congrFun (congrFun heq p) hp) k
        exact Int.ModEq.dvd h1
      have hprod := Finset.prod_dvd_of_coprime (s := fun p : ℕ => (p : ℤ))
        (fun p hp q hq hpq =>
          Nat.isCoprime_iff_coprime.2 ((Nat.coprime_primes (hT p hp) (hT q hq)).2 hpq)) hdvd
      have hprod' : ((∏ p ∈ T, p : ℕ) : ℤ) ∣ a' k - a k := by
        rw [Nat.cast_prod]; exact hprod
      have h0 : a' k - a k = 0 := by
        apply Int.eq_zero_of_abs_lt_dvd hprod'
        have b1 : (0:ℤ) ≤ a k := ha.1.1 k
        have b2 : a k ≤ ((∏ p ∈ T, p : ℕ) : ℤ) - 1 := ha.1.2 k
        have b3 : (0:ℤ) ≤ a' k := ha'.1.1 k
        have b4 : a' k ≤ ((∏ p ∈ T, p : ℕ) : ℤ) - 1 := ha'.1.2 k
        rw [abs_lt]
        constructor <;> linarith
      linarith
  refine ⟨hper, fun T hT => (hCRT T hT).trans ?_⟩
  exact Finset.prod_le_prod (fun _ _ => Nat.zero_le _) (fun p hp => hS5 p (hT p hp))

theorem kai_cube_tail_bound (n D m R : ℕ) (hD : 1 ≤ D) (hm : 1 ≤ m) (U : Finset ℕ)
    (hU : U ⊆ (Finset.range (m + 1)).filter Nat.Prime) (f : Finset ℕ → ℕ)
    (hf : ∀ T ∈ U.powerset, f T ≤ ∏ p ∈ T, 8 * n * p ^ (D - 1)) :
    ∑ T ∈ U.powerset.filter (fun T => T.card = R),
        (f T : ℝ) / ((∏ p ∈ T, p : ℕ) : ℝ) ^ D
      ≤ Real.exp (-(R : ℝ)) * Real.exp (Real.exp 1 * (8 * (n : ℝ) * (1 + Real.log (m : ℝ)))) :=
by
  obtain ⟨k, rfl⟩ : ∃ k, D = k + 1 := ⟨D - 1, by omega⟩
  simp only [Nat.add_sub_cancel] at hf
  set x : ℕ → ℝ := fun p => 8 * (n : ℝ) / (p : ℝ) with hx_def
  have hx0 : ∀ p, 0 ≤ x p := fun p => by simp only [hx_def]; positivity
  have hpos : ∀ p ∈ U, (0 : ℝ) < p := by
    intro p hp
    have := (Finset.mem_filter.mp (hU hp)).2
    exact_mod_cast this.pos
  
  have hterm : ∀ T ∈ U.powerset,
      (f T : ℝ) / ((∏ p ∈ T, p : ℕ) : ℝ) ^ (k + 1) ≤ ∏ p ∈ T, x p := by
    intro T hT
    have hTU : T ⊆ U := Finset.mem_powerset.mp hT
    have hTpos : ∀ p ∈ T, (0 : ℝ) < p := fun p hp => hpos p (hTU hp)
    have hden : ((∏ p ∈ T, p : ℕ) : ℝ) ^ (k + 1) = ∏ p ∈ T, ((p : ℝ) ^ k * p) := by
      rw [Nat.cast_prod, ← Finset.prod_pow]
      exact Finset.prod_congr rfl (fun p _ => pow_succ _ _)
    have hnum : (f T : ℝ) ≤ ∏ p ∈ T, (8 * (n : ℝ) * (p : ℝ) ^ k) := by
      have := hf T hT
      exact_mod_cast this
    rw [hden, div_le_iff₀ (Finset.prod_pos (fun p hp => by have := hTpos p hp; positivity)),
      ← Finset.prod_mul_distrib]
    refine hnum.trans (le_of_eq (Finset.prod_congr rfl ?_))
    intro p hp
    have hne := (hTpos p hp).ne'
    simp only [hx_def]
    rw [div_mul_eq_mul_div, eq_div_iff hne]
    ring
  have hS1 : ∑ T ∈ U.powerset.filter (fun T => T.card = R),
        (f T : ℝ) / ((∏ p ∈ T, p : ℕ) : ℝ) ^ (k + 1)
      ≤ ∑ T ∈ U.powerset.filter (fun T => T.card = R), ∏ p ∈ T, x p :=
    Finset.sum_le_sum (fun T hT => hterm T (Finset.mem_filter.mp hT).1)
  have hS2 : ∑ T ∈ U.powerset.filter (fun T => T.card = R), ∏ p ∈ T, x p
      = Real.exp (-(R : ℝ)) *
          ∑ T ∈ U.powerset.filter (fun T => T.card = R), ∏ p ∈ T, (Real.exp 1 * x p) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun T hT => ?_)
    have hc : T.card = R := (Finset.mem_filter.mp hT).2
    rw [Finset.prod_mul_distrib, Finset.prod_const, hc, Real.exp_one_pow, ← mul_assoc,
      ← Real.exp_add, neg_add_cancel, Real.exp_zero, one_mul]
  have hS3 : ∑ T ∈ U.powerset.filter (fun T => T.card = R), ∏ p ∈ T, (Real.exp 1 * x p)
      ≤ ∑ T ∈ U.powerset, ∏ p ∈ T, (Real.exp 1 * x p) :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
      (fun T _ _ => Finset.prod_nonneg (fun p _ => mul_nonneg (Real.exp_pos 1).le (hx0 p)))
  have hS4 : ∑ T ∈ U.powerset, ∏ p ∈ T, (Real.exp 1 * x p)
      ≤ Real.exp (Real.exp 1 * ∑ p ∈ U, x p) := by
    rw [← Finset.prod_one_add, Finset.mul_sum, Real.exp_sum]
    refine Finset.prod_le_prod (fun p _ => ?_) (fun p _ => ?_)
    · have := mul_nonneg (Real.exp_pos 1).le (hx0 p); linarith
    · rw [add_comm]; exact Real.add_one_le_exp _
  have hS5 : ∑ p ∈ U, x p ≤ 8 * (n : ℝ) * (1 + Real.log (m : ℝ)) := by
    have hsub : U ⊆ Finset.Icc 1 m := by
      intro p hp
      have h := Finset.mem_filter.mp (hU hp)
      have h1 := Finset.mem_range.mp h.1
      have h2 := h.2.two_le
      exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    have hsum : ∑ p ∈ U, x p = 8 * (n : ℝ) * ∑ p ∈ U, (1 : ℝ) / p := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      simp only [hx_def]
      ring
    have hH : ∑ p ∈ U, (1 : ℝ) / p ≤ 1 + Real.log m := by
      calc ∑ p ∈ U, (1 : ℝ) / p ≤ ∑ p ∈ Finset.Icc 1 m, (1 : ℝ) / p :=
            Finset.sum_le_sum_of_subset_of_nonneg hsub (fun p _ _ => by positivity)
        _ = ((harmonic m : ℚ) : ℝ) := by
            rw [harmonic_eq_sum_Icc]
            push_cast
            simp [one_div]
        _ ≤ 1 + Real.log m := harmonic_le_one_add_log m
    rw [hsum]
    exact mul_le_mul_of_nonneg_left hH (by positivity)
  calc _ ≤ _ := hS1
    _ = _ := hS2
    _ ≤ Real.exp (-(R : ℝ)) * Real.exp (Real.exp 1 * ∑ p ∈ U, x p) :=
        mul_le_mul_of_nonneg_left (hS3.trans hS4) (Real.exp_pos _).le
    _ ≤ _ :=
        mul_le_mul_of_nonneg_left
          (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hS5 (Real.exp_pos 1).le))
          (Real.exp_pos _).le

theorem kai_cube_lattice_bound (D m R : ℕ) (U : Finset ℕ)
    (hU : U ⊆ (Finset.range (m + 1)).filter Nat.Prime) (f : Finset ℕ → ℕ)
    (hf : ∀ T ∈ U.powerset, f T ≤ (∏ p ∈ T, p) ^ D) :
    ∑ T ∈ U.powerset.filter (fun T => T.card ≤ R), (f T : ℝ)
      ≤ Real.exp 1 * (((m : ℝ) + 1) ^ (D + 1)) ^ R :=
by
  classical
  set S := U.powerset.filter (fun T => T.card ≤ R) with hS
  have hn : U.card ≤ m := by
    have h1 : U ⊆ (Finset.range (m + 1)).erase 0 := by
      intro p hp
      have := hU hp
      rw [Finset.mem_filter, Finset.mem_range] at this
      rw [Finset.mem_erase, Finset.mem_range]
      exact ⟨this.2.ne_zero, this.1⟩
    have h2 := Finset.card_le_card h1
    rwa [Finset.card_erase_of_mem (by simp), Finset.card_range, Nat.add_sub_cancel] at h2
  have hterm : ∀ T ∈ S, f T ≤ (m + 1) ^ (R * D) := by
    intro T hT
    rw [hS, Finset.mem_filter] at hT
    have hTU : T ⊆ U := Finset.mem_powerset.mp hT.1
    have hprod : ∏ p ∈ T, p ≤ (m + 1) ^ T.card :=
      Finset.prod_le_pow_card T (fun p => p) (m + 1) (fun p hp => by
        have := hU (hTU hp)
        rw [Finset.mem_filter, Finset.mem_range] at this
        exact this.1.le)
    have hprod' : ∏ p ∈ T, p ≤ (m + 1) ^ R :=
      hprod.trans (Nat.pow_le_pow_right (Nat.succ_pos m) hT.2)
    calc f T ≤ (∏ p ∈ T, p) ^ D := hf T hT.1
      _ ≤ ((m + 1) ^ R) ^ D := Nat.pow_le_pow_left hprod' D
      _ = (m + 1) ^ (R * D) := (pow_mul _ _ _).symm
  have hcount : S.card ≤ (m + 1) ^ R := by
    have hsub : S ⊆ (Finset.range (R + 1)).biUnion (fun k => U.powersetCard k) := by
      intro T hT
      rw [hS, Finset.mem_filter] at hT
      rw [Finset.mem_biUnion]
      exact ⟨T.card, Finset.mem_range.mpr (Nat.lt_succ_of_le hT.2),
        Finset.mem_powersetCard.mpr ⟨Finset.mem_powerset.mp hT.1, rfl⟩⟩
    calc S.card ≤ ((Finset.range (R + 1)).biUnion (fun k => U.powersetCard k)).card :=
          Finset.card_le_card hsub
      _ ≤ ∑ k ∈ Finset.range (R + 1), (U.powersetCard k).card := Finset.card_biUnion_le
      _ = ∑ k ∈ Finset.range (R + 1), U.card.choose k := by
          simp only [Finset.card_powersetCard]
      _ ≤ ∑ k ∈ Finset.range (R + 1), U.card ^ k * 1 ^ (R - k) * R.choose k := by
          apply Finset.sum_le_sum
          intro k hk
          have hkR : k ≤ R := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          rw [one_pow, mul_one]
          exact (Nat.choose_le_pow U.card k).trans
            (Nat.le_mul_of_pos_right _ (Nat.choose_pos hkR))
      _ = (U.card + 1) ^ R := by rw [add_pow] <;> simp
      _ ≤ (m + 1) ^ R := Nat.pow_le_pow_left (by omega) R
  have hnat : ∑ T ∈ S, f T ≤ ((m + 1) ^ (D + 1)) ^ R := by
    calc ∑ T ∈ S, f T ≤ S.card • (m + 1) ^ (R * D) := Finset.sum_le_card_nsmul _ _ _ hterm
      _ = S.card * (m + 1) ^ (R * D) := smul_eq_mul _ _
      _ ≤ (m + 1) ^ R * (m + 1) ^ (R * D) := Nat.mul_le_mul_right _ hcount
      _ = ((m + 1) ^ (D + 1)) ^ R := by rw [← pow_add, ← pow_mul]; ring_nf
  have hreal : ∑ T ∈ S, (f T : ℝ) ≤ (((m : ℝ) + 1) ^ (D + 1)) ^ R := by
    have h := (Nat.cast_le (α := ℝ)).mpr hnat
    push_cast at h
    exact h
  have he : (1 : ℝ) ≤ Real.exp 1 := Real.one_le_exp (by norm_num)
  have hpos : (0 : ℝ) ≤ (((m : ℝ) + 1) ^ (D + 1)) ^ R := by positivity
  calc ∑ T ∈ S, (f T : ℝ) ≤ (((m : ℝ) + 1) ^ (D + 1)) ^ R := hreal
    _ = 1 * (((m : ℝ) + 1) ^ (D + 1)) ^ R := (one_mul _).symm
    _ ≤ Real.exp 1 * (((m : ℝ) + 1) ^ (D + 1)) ^ R := mul_le_mul_of_nonneg_right he hpos

theorem kai_cube_numeric (n : ℕ) (hn : 1 ≤ n) (M : ℝ) (m : ℕ) (hM : 3 ≤ M) (hm1 : 1 ≤ m)
    (hm : (m : ℝ) ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)))
    (u κ₀ A : ℝ) (R : ℕ)
    (hu : u = Real.log M ^ ((1:ℝ)/3))
    (hκ₀ : κ₀ = 8 * Real.exp 1 * n)
    (hA : A = 2 * ((4 * n : ℝ) + (4 * n + 1) * (2 * κ₀ + 2)) + 1)
    (hR : R = ⌈κ₀ + (κ₀ + 1) * u⌉₊) :
    1 ≤ u ∧ Real.log m ≤ u ∧ 1 ≤ R ∧ 0 < A ∧
    Real.exp (-(R : ℝ)) * Real.exp (Real.exp 1 * (8 * n * (1 + u))) ≤ Real.exp (-u) ∧
    (A ≤ u → ((m : ℝ) + 1) ^ (4 * n + (4 * n + 1) * R) * Real.exp u ≤ M) ∧
    (u < A → 1 ≤ Real.exp A * Real.exp (-u)) :=
by
  have hMpos : (0:ℝ) < M := by linarith
  have he3 : Real.exp 1 < 3 := by
    have := Real.exp_one_lt_d9
    linarith
  have he2 : (2:ℝ) ≤ Real.exp 1 := by
    have := Real.add_one_le_exp (1:ℝ)
    linarith
  have hL1 : 1 < Real.log M := by
    rw [Real.lt_log_iff_exp_lt hMpos]; linarith
  have hL0 : 0 ≤ Real.log M := by linarith
  have hnR : (1:ℝ) ≤ n := by exact_mod_cast hn
  have hκ0 : 0 ≤ κ₀ := by rw [hκ₀]; positivity
  have hu3 : u ^ 3 = Real.log M := by
    rw [hu, show ((1:ℝ)/3) = ((3:ℕ):ℝ)⁻¹ by norm_num]
    exact Real.rpow_inv_natCast_pow hL0 (by norm_num)
  have s1 : 1 ≤ u := by rw [hu]; exact Real.one_le_rpow hL1.le (by norm_num)
  have hmpos : (0:ℝ) < m := by exact_mod_cast hm1
  have hmu : (m:ℝ) ≤ Real.exp u := by rw [hu]; exact hm
  have s2 : Real.log m ≤ u := (Real.log_le_iff_le_exp hmpos).2 hmu
  have harg : 1 ≤ κ₀ + (κ₀ + 1) * u := by nlinarith
  have hRge : κ₀ + (κ₀ + 1) * u ≤ (R:ℝ) := by rw [hR]; exact Nat.le_ceil _
  have hRlt : (R:ℝ) < κ₀ + (κ₀ + 1) * u + 1 := by
    rw [hR]; exact Nat.ceil_lt_add_one (by linarith)
  have s3 : 1 ≤ R := by
    have : (1:ℝ) ≤ R := by linarith
    exact_mod_cast this
  have s4 : 0 < A := by rw [hA]; positivity
  have s5 : Real.exp (-(R : ℝ)) * Real.exp (Real.exp 1 * (8 * n * (1 + u)))
      ≤ Real.exp (-u) := by
    rw [← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have : Real.exp 1 * (8 * n * (1 + u)) = κ₀ + κ₀ * u := by rw [hκ₀]; ring
    rw [this]; linarith
  refine ⟨s1, s2, s3, s4, s5, ?_, ?_⟩
  · intro hAu
    obtain ⟨N, hN⟩ : ∃ N : ℕ, N = 4 * n + (4 * n + 1) * R := ⟨_, rfl⟩
    rw [← hN]
    have hNcast : (N:ℝ) = 4 * (n:ℝ) + (4 * (n:ℝ) + 1) * (R:ℝ) := by
      rw [hN]; push_cast; ring
    obtain ⟨c, hc⟩ : ∃ c : ℝ, c = 4 * (n:ℝ) + 2 * (4 * (n:ℝ) + 1) * (κ₀ + 1) := ⟨_, rfl⟩
    have hc0 : 0 ≤ c := by rw [hc]; positivity
    have hNle : (N:ℝ) ≤ c * u := by
      rw [hNcast, hc]
      have h1 : (4 * (n:ℝ) + 1) * (R:ℝ) ≤ (4 * (n:ℝ) + 1) * ((κ₀ + 1) * (1 + u)) :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      nlinarith [mul_nonneg (by positivity : (0:ℝ) ≤ 4 * (n:ℝ)) (by linarith : (0:ℝ) ≤ u - 1),
        mul_nonneg (by positivity : (0:ℝ) ≤ (4 * (n:ℝ) + 1) * (κ₀ + 1))
          (by linarith : (0:ℝ) ≤ u - 1)]
    have h1 : (N:ℝ) * (u + 1) ≤ c * u * (2 * u) :=
      mul_le_mul hNle (by linarith) (by positivity) (by positivity)
    have hAc : A = 2 * c + 1 := by rw [hA, hc]; ring
    have hkey : (N:ℝ) * (u + 1) + u ≤ u ^ 3 := by
      have hu2 : u ≤ u ^ 2 := by nlinarith
      have h3 : A * u ^ 2 ≤ u * u ^ 2 := mul_le_mul_of_nonneg_right hAu (by positivity)
      rw [hAc] at h3
      nlinarith
    have hbase : (m:ℝ) + 1 ≤ Real.exp (u + 1) := by
      rw [Real.exp_add]
      have : 1 ≤ Real.exp u := Real.one_le_exp (by linarith)
      nlinarith
    have hpow : ((m:ℝ) + 1) ^ N ≤ Real.exp ((N:ℝ) * (u + 1)) := by
      rw [Real.exp_nat_mul]
      exact pow_le_pow_left₀ (by positivity) hbase N
    calc ((m:ℝ) + 1) ^ N * Real.exp u ≤ Real.exp ((N:ℝ) * (u + 1)) * Real.exp u :=
          mul_le_mul_of_nonneg_right hpow (Real.exp_pos u).le
      _ = Real.exp ((N:ℝ) * (u + 1) + u) := (Real.exp_add _ _).symm
      _ ≤ Real.exp (u ^ 3) := Real.exp_le_exp.mpr hkey
      _ = M := by rw [hu3, Real.exp_log hMpos]
  · intro h
    rw [← Real.exp_add]
    exact Real.one_le_exp (by linarith)

theorem kai_cube_sieve_sum_reindex (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M : ℝ) (Q W : ℕ) [∀ x : NumberField.RingOfIntegers K, Decidable (CoprimeToNat W x)]
    (hQ : 1 ≤ Q) (S : Set (NumberField.RingOfIntegers K))
    (hS : S ⊆ ↑(omegaBox ω M))
    (R : Finset (Fin 4 × Fin (Module.finrank ℚ K) → ℤ))
    (hR : ∀ z, z ∈ R ↔ ∀ ε : Fin 3 → Fin 2, kaiCubeVtx ω z ε ∈ S)
    (hbox : ∀ z ∈ R, ∀ k, |z k| ≤ 2 * (⌊M⌋₊ : ℤ))
    (Φ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
      NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℝ)
    (hΦ : ∀ x h₁ h₂ h₃ y₀ y₁ y₂ y₃ : NumberField.RingOfIntegers K,
      Φ (x + (Q : NumberField.RingOfIntegers K) * y₀) (h₁ + (Q : NumberField.RingOfIntegers K) * y₁)
        (h₂ + (Q : NumberField.RingOfIntegers K) * y₂) (h₃ + (Q : NumberField.RingOfIntegers K) * y₃)
        = Φ x h₁ h₂ h₃) :
    kaiCubeSieveSum ω M W S Φ =
      ∑ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ)) (fun _ => (Q:ℤ) - 1),
        Φ (ω.equivFun.symm (fun j => c (0, j))) (ω.equivFun.symm (fun j => c (1, j)))
          (ω.equivFun.symm (fun j => c (2, j))) (ω.equivFun.symm (fun j => c (3, j))) *
        ((R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧
          ∀ ε : Fin 3 → Fin 2, CoprimeToNat W (kaiCubeVtx ω z ε))).card : ℝ) :=
by
  classical
  have hQ0 : (0 : ℤ) < (Q : ℤ) := by exact_mod_cast hQ
  
  have hfloor : 2 * (⌊M⌋₊ : ℤ) ≤ ((⌊2 * M⌋₊ : ℕ) : ℤ) := by
    rcases le_or_gt M 0 with hM | hM
    · rw [Nat.floor_of_nonpos hM]; simp
    · have : 2 * ⌊M⌋₊ ≤ ⌊2 * M⌋₊ := by
        apply Nat.le_floor
        push_cast
        linarith [Nat.floor_le hM.le]
      exact_mod_cast this
  have hvtx0 : ∀ z : Fin 4 × Fin (Module.finrank ℚ K) → ℤ,
      kaiCubeVtx ω z (fun _ => 0) = ω.equivFun.symm (fun j => z (0, j)) := by
    intro z; simp [kaiCubeVtx, cubeVertex]
  have hB : ∀ z ∈ R, ∀ i : Fin 4,
      ω.equivFun.symm (fun j => z (i, j)) ∈ omegaBox ω (2 * M) := by
    intro z hz i
    unfold omegaBox intBox
    refine Finset.mem_image.2 ⟨fun j => z (i, j), Finset.mem_Icc.2 ⟨fun j => ?_, fun j => ?_⟩, rfl⟩
    · have := (abs_le.mp (hbox z hz (i, j))).1
      show -((⌊2 * M⌋₊ : ℕ) : ℤ) ≤ z (i, j)
      linarith
    · have := (abs_le.mp (hbox z hz (i, j))).2
      show z (i, j) ≤ ((⌊2 * M⌋₊ : ℕ) : ℤ)
      linarith
  obtain ⟨jm, hjm⟩ : ∃ jm : NumberField.RingOfIntegers K × NumberField.RingOfIntegers K ×
      NumberField.RingOfIntegers K × NumberField.RingOfIntegers K →
      (Fin 4 × Fin (Module.finrank ℚ K) → ℤ), ∀ p k,
      jm p k = ω.equivFun (![p.1, p.2.1, p.2.2.1, p.2.2.2] k.1) k.2 := ⟨_, fun _ _ => rfl⟩
  have hJ : ∀ p : NumberField.RingOfIntegers K × NumberField.RingOfIntegers K ×
      NumberField.RingOfIntegers K × NumberField.RingOfIntegers K,
      ω.equivFun.symm (fun j => jm p (0, j)) = p.1 ∧
      ω.equivFun.symm (fun j => jm p (1, j)) = p.2.1 ∧
      ω.equivFun.symm (fun j => jm p (2, j)) = p.2.2.1 ∧
      ω.equivFun.symm (fun j => jm p (3, j)) = p.2.2.2 := by
    intro p
    have e0 : (fun j => jm p (0, j)) = ω.equivFun p.1 := funext fun j => by rw [hjm]; rfl
    have e1 : (fun j => jm p (1, j)) = ω.equivFun p.2.1 := funext fun j => by rw [hjm]; rfl
    have e2 : (fun j => jm p (2, j)) = ω.equivFun p.2.2.1 := funext fun j => by rw [hjm]; rfl
    have e3 : (fun j => jm p (3, j)) = ω.equivFun p.2.2.2 := funext fun j => by rw [hjm]; rfl
    rw [e0, e1, e2, e3]
    exact ⟨ω.equivFun.symm_apply_apply _, ω.equivFun.symm_apply_apply _,
      ω.equivFun.symm_apply_apply _, ω.equivFun.symm_apply_apply _⟩
  
  have step1 : kaiCubeSieveSum ω M W S Φ =
      ∑ z ∈ R.filter (fun z => ∀ ε : Fin 3 → Fin 2, CoprimeToNat W (kaiCubeVtx ω z ε)),
        Φ (ω.equivFun.symm (fun j => z (0, j))) (ω.equivFun.symm (fun j => z (1, j)))
          (ω.equivFun.symm (fun j => z (2, j))) (ω.equivFun.symm (fun j => z (3, j))) := by
    have e1 : kaiCubeSieveSum ω M W S Φ =
        ∑ p ∈ (omegaBox ω M ×ˢ (omegaBox ω (2 * M) ×ˢ
          (omegaBox ω (2 * M) ×ˢ omegaBox ω (2 * M)))).filter
          (fun p => ∀ ε : Fin 3 → Fin 2, cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε ∈ S ∧
            CoprimeToNat W (cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε)),
          Φ p.1 p.2.1 p.2.2.1 p.2.2.2 := by
      unfold kaiCubeSieveSum
      rw [Finset.sum_filter]
      simp only [Finset.sum_product]
      refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun a _ =>
        Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun c _ => ?_
      congr
    rw [e1]
    symm
    apply Finset.sum_nbij' (fun z => (ω.equivFun.symm (fun j => z (0, j)),
      ω.equivFun.symm (fun j => z (1, j)), ω.equivFun.symm (fun j => z (2, j)),
      ω.equivFun.symm (fun j => z (3, j)))) jm
    · intro z hz
      rw [Finset.mem_filter] at hz
      obtain ⟨hzR, hcop⟩ := hz
      have hA : ω.equivFun.symm (fun j => z (0, j)) ∈ omegaBox ω M := by
        have h0 := (hR z).1 hzR (fun _ => 0)
        rw [hvtx0 z] at h0
        exact Finset.mem_coe.1 (hS h0)
      exact Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨hA, Finset.mem_product.2
        ⟨hB z hzR 1, Finset.mem_product.2 ⟨hB z hzR 2, hB z hzR 3⟩⟩⟩,
        fun ε => ⟨(hR z).1 hzR ε, hcop ε⟩⟩
    · intro p hp
      rw [Finset.mem_filter] at hp
      obtain ⟨-, hP⟩ := hp
      obtain ⟨h0, h1, h2, h3⟩ := hJ p
      have hv : ∀ ε, kaiCubeVtx ω (jm p) ε = cubeVertex p.1 p.2.1 p.2.2.1 p.2.2.2 ε := by
        intro ε
        simp only [kaiCubeVtx]
        rw [h0, h1, h2, h3]
      refine Finset.mem_filter.2 ⟨(hR (jm p)).2 (fun ε => ?_), fun ε => ?_⟩
      · rw [hv]; exact (hP ε).1
      · rw [hv]; exact (hP ε).2
    · intro z _
      funext k
      obtain ⟨a, b⟩ := k
      rw [hjm]
      fin_cases a
      · exact congrFun (ω.equivFun.apply_symm_apply (fun j => z (0, j))) b
      · exact congrFun (ω.equivFun.apply_symm_apply (fun j => z (1, j))) b
      · exact congrFun (ω.equivFun.apply_symm_apply (fun j => z (2, j))) b
      · exact congrFun (ω.equivFun.apply_symm_apply (fun j => z (3, j))) b
    · intro p _
      obtain ⟨h0, h1, h2, h3⟩ := hJ p
      simp only [h0, h1, h2, h3]
    · intro z _
      rfl
  
  have hper : ∀ z c : Fin 4 × Fin (Module.finrank ℚ K) → ℤ, (∀ k, (Q : ℤ) ∣ z k - c k) →
      Φ (ω.equivFun.symm (fun j => z (0, j))) (ω.equivFun.symm (fun j => z (1, j)))
          (ω.equivFun.symm (fun j => z (2, j))) (ω.equivFun.symm (fun j => z (3, j))) =
      Φ (ω.equivFun.symm (fun j => c (0, j))) (ω.equivFun.symm (fun j => c (1, j)))
          (ω.equivFun.symm (fun j => c (2, j))) (ω.equivFun.symm (fun j => c (3, j))) := by
    intro z c hzc
    choose y hy using hzc
    have hlin : ∀ i : Fin 4, ω.equivFun.symm (fun j => z (i, j)) =
        ω.equivFun.symm (fun j => c (i, j)) +
          (Q : NumberField.RingOfIntegers K) * ω.equivFun.symm (fun j => y (i, j)) := by
      intro i
      have : (fun j => z (i, j)) = (fun j => c (i, j)) + (Q : ℤ) • (fun j => y (i, j)) := by
        funext j
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        linarith [hy (i, j)]
      rw [this, map_add, map_zsmul, zsmul_eq_mul]
      push_cast
      ring
    rw [hlin 0, hlin 1, hlin 2, hlin 3]
    exact hΦ _ _ _ _ _ _ _ _
  
  have hfib : ∀ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
      (fun _ => (Q:ℤ) - 1), ∀ z : Fin 4 × Fin (Module.finrank ℚ K) → ℤ,
      ((fun k => z k % (Q : ℤ)) = c ↔ ∀ k, (Q : ℤ) ∣ z k - c k) := by
    intro c hc z
    rw [Finset.mem_Icc] at hc
    obtain ⟨hc1, hc2⟩ := hc
    rw [funext_iff]
    apply forall_congr'
    intro k
    have h1 : 0 ≤ c k := hc1 k
    have h2 : c k ≤ (Q : ℤ) - 1 := hc2 k
    have hck : c k % (Q : ℤ) = c k := Int.emod_eq_of_lt h1 (by omega)
    rw [Int.dvd_iff_emod_eq_zero, ← Int.emod_eq_emod_iff_emod_sub_eq_zero, hck]
  have hmaps : ∀ z ∈ R.filter (fun z => ∀ ε : Fin 3 → Fin 2, CoprimeToNat W (kaiCubeVtx ω z ε)),
      (fun k => z k % (Q : ℤ)) ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
        (fun _ => (Q:ℤ) - 1) := by
    intro z _
    refine Finset.mem_Icc.2 ⟨fun k => ?_, fun k => ?_⟩
    · show (0 : ℤ) ≤ z k % (Q : ℤ)
      exact Int.emod_nonneg _ hQ0.ne'
    · show z k % (Q : ℤ) ≤ (Q : ℤ) - 1
      have := Int.emod_lt_of_pos (z k) hQ0
      omega
  rw [step1, ← Finset.sum_fiberwise_of_maps_to hmaps]
  refine Finset.sum_congr rfl (fun c hc => ?_)
  rw [Finset.sum_congr rfl (fun z hz => hper z c ((hfib c hc z).1 (Finset.mem_filter.1 hz).2)),
    Finset.sum_const, nsmul_eq_mul, mul_comm]
  refine congrArg (fun s : Finset (Fin 4 × Fin (Module.finrank ℚ K) → ℤ) =>
    Φ (ω.equivFun.symm (fun j => c (0, j))) (ω.equivFun.symm (fun j => c (1, j)))
          (ω.equivFun.symm (fun j => c (2, j))) (ω.equivFun.symm (fun j => c (3, j))) *
      (s.card : ℝ)) ?_
  ext z
  simp only [Finset.mem_filter]
  rw [hfib c hc z]
  tauto

theorem kai_cube_res_sum_reindex (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (Q : ℕ) (hQ : 1 ≤ Q)
    (Φ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
      NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℝ) :
    kaiResSum ω Q Φ =
      ∑ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ)) (fun _ => (Q:ℤ) - 1),
        Φ (ω.equivFun.symm (fun j => c (0, j))) (ω.equivFun.symm (fun j => c (1, j)))
          (ω.equivFun.symm (fun j => c (2, j))) (ω.equivFun.symm (fun j => c (3, j))) :=
by
  classical
  have hinj : Set.InjOn (fun v => ω.equivFun.symm v) ↑(resBox (Module.finrank ℚ K) Q) :=
    fun x _ y _ h => ω.equivFun.symm.injective h
  have hmemB : ∀ v : Fin (Module.finrank ℚ K) → ℤ,
      v ∈ resBox (Module.finrank ℚ K) Q ↔ ∀ j, 0 ≤ v j ∧ v j ≤ (Q:ℤ) - 1 := by
    intro v
    simp only [resBox, Finset.mem_Icc, Pi.le_def, forall_and]
  have hmemC : ∀ c : Fin 4 × Fin (Module.finrank ℚ K) → ℤ,
      c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ)) (fun _ => (Q:ℤ) - 1) ↔
        ∀ k, 0 ≤ c k ∧ c k ≤ (Q:ℤ) - 1 := by
    intro c
    simp only [Finset.mem_Icc, Pi.le_def, forall_and]
  have h1 : kaiResSum ω Q Φ =
      ∑ v₀ ∈ resBox (Module.finrank ℚ K) Q, ∑ v₁ ∈ resBox (Module.finrank ℚ K) Q,
        ∑ v₂ ∈ resBox (Module.finrank ℚ K) Q, ∑ v₃ ∈ resBox (Module.finrank ℚ K) Q,
          Φ (ω.equivFun.symm v₀) (ω.equivFun.symm v₁) (ω.equivFun.symm v₂)
            (ω.equivFun.symm v₃) := by
    unfold kaiResSum kaiResSys
    rw [Finset.sum_image hinj]
    refine Finset.sum_congr rfl fun v₀ _ => ?_
    rw [Finset.sum_image hinj]
    refine Finset.sum_congr rfl fun v₁ _ => ?_
    rw [Finset.sum_image hinj]
    refine Finset.sum_congr rfl fun v₂ _ => ?_
    rw [Finset.sum_image hinj]
  have h2 : (∑ v₀ ∈ resBox (Module.finrank ℚ K) Q, ∑ v₁ ∈ resBox (Module.finrank ℚ K) Q,
        ∑ v₂ ∈ resBox (Module.finrank ℚ K) Q, ∑ v₃ ∈ resBox (Module.finrank ℚ K) Q,
          Φ (ω.equivFun.symm v₀) (ω.equivFun.symm v₁) (ω.equivFun.symm v₂)
            (ω.equivFun.symm v₃)) =
      ∑ p ∈ resBox (Module.finrank ℚ K) Q ×ˢ (resBox (Module.finrank ℚ K) Q ×ˢ
          (resBox (Module.finrank ℚ K) Q ×ˢ resBox (Module.finrank ℚ K) Q)),
        Φ (ω.equivFun.symm p.1) (ω.equivFun.symm p.2.1) (ω.equivFun.symm p.2.2.1)
          (ω.equivFun.symm p.2.2.2) := by
    simp only [Finset.sum_product]
  rw [h1, h2]
  symm
  refine Finset.sum_nbij'
    (fun c => ((fun j => c (0, j)), ((fun j => c (1, j)), ((fun j => c (2, j)),
      (fun j => c (3, j))))))
    (fun p k => (![p.1, p.2.1, p.2.2.1, p.2.2.2] : Fin 4 → Fin (Module.finrank ℚ K) → ℤ) k.1 k.2)
    ?_ ?_ ?_ ?_ ?_
  · intro c hc
    rw [hmemC] at hc
    simp only [Finset.mem_product, hmemB]
    exact ⟨fun j => hc (0, j), fun j => hc (1, j), fun j => hc (2, j), fun j => hc (3, j)⟩
  · rintro ⟨v₀, v₁, v₂, v₃⟩ hp
    simp only [Finset.mem_product, hmemB] at hp
    obtain ⟨h₀, h₁, h₂, h₃⟩ := hp
    rw [hmemC]
    rintro ⟨a, j⟩
    fin_cases a
    · exact h₀ j
    · exact h₁ j
    · exact h₂ j
    · exact h₃ j
  · intro c _
    funext ⟨a, j⟩
    fin_cases a <;> rfl
  · rintro ⟨v₀, v₁, v₂, v₃⟩ _
    rfl
  · intro c _
    rfl

theorem kai_box_class_partition {ι : Type*} [Fintype ι] [DecidableEq ι] (q : ℕ) (hq : 1 ≤ q)
    (F : Finset (ι → ℤ)) :
    ∑ c ∈ Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => (q:ℤ) - 1),
      (F.filter (fun z => ∀ k, (q:ℤ) ∣ z k - c k)).card = F.card :=
by
  classical
  have hq0 : (0:ℤ) < (q:ℤ) := by exact_mod_cast hq
  have hmaps : ∀ z ∈ F, (fun k => z k % (q:ℤ)) ∈
      Finset.Icc (fun _ : ι => (0:ℤ)) (fun _ => (q:ℤ) - 1) := by
    intro z _
    rw [Finset.mem_Icc]
    refine ⟨fun k => Int.emod_nonneg _ hq0.ne', fun k => ?_⟩
    have := Int.emod_lt_of_pos (z k) hq0
    show z k % (q:ℤ) ≤ (q:ℤ) - 1
    omega
  rw [Finset.card_eq_sum_card_fiberwise hmaps]
  refine Finset.sum_congr rfl (fun c hc => ?_)
  rw [Finset.mem_Icc] at hc
  obtain ⟨hc1, hc2⟩ := hc
  congr 1
  refine Finset.filter_congr (fun z _ => ?_)
  constructor
  · intro h
    funext k
    have h1 : 0 ≤ c k := hc1 k
    have h2 : c k ≤ (q:ℤ) - 1 := hc2 k
    have hmod : c k % (q:ℤ) = z k % (q:ℤ) := Int.modEq_iff_dvd.mpr (h k)
    have hc : c k % (q:ℤ) = c k := Int.emod_eq_of_lt h1 (by omega)
    show z k % (q:ℤ) = c k
    rw [← hmod, hc]
  · intro h k
    have hk : (q:ℤ) ∣ z k - z k % (q:ℤ) := ⟨z k / (q:ℤ), by rw [Int.emod_def]; ring⟩
    have hck : z k % (q:ℤ) = c k := congrFun h k
    rw [← hck]
    exact hk

theorem kai_cube_count_equidistribution (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C₄ : ℝ, 0 ≤ C₄ ∧
      ∀ (M : ℝ) (m Q : ℕ), 3 ≤ M → 1 ≤ Q → Q ≤ m →
        (m : ℝ) ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
        ∀ S : Set (NumberField.RingOfIntegers K), S ⊆ ↑(omegaBox ω M) →
          KaiLineProp ω S (2 * Module.finrank ℚ K + 1) →
          KaiCubeEquidist ω M m Q S C₄ :=
by
  classical
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  obtain ⟨κ₀, hκ₀⟩ : ∃ κ₀ : ℝ, κ₀ = 8 * Real.exp 1 * (Module.finrank ℚ K : ℝ) := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = 2 * ((4 * (Module.finrank ℚ K : ℝ)) +
      (4 * (Module.finrank ℚ K : ℝ) + 1) * (2 * κ₀ + 2)) + 1 := ⟨_, rfl⟩
  obtain ⟨Dl, hDl⟩ : ∃ Dl : ℝ, Dl = (4 * (Module.finrank ℚ K : ℝ)) *
      (8 * (2 * (Module.finrank ℚ K : ℝ) + 1)) * Real.exp 1 := ⟨_, rfl⟩
  have hDl0 : 0 ≤ Dl := by rw [hDl]; positivity
  refine ⟨2 * 16 ^ Module.finrank ℚ K * Real.exp A + 2 * 16 ^ Module.finrank ℚ K * (1 + Dl),
    by positivity, ?_⟩
  intro M m Q hM hQ1 hQm hmexp S hS hlineS
  have hm1 : 1 ≤ m := le_trans hQ1 hQm
  
  obtain ⟨u, hu⟩ : ∃ u : ℝ, u = Real.log M ^ ((1:ℝ)/3) := ⟨_, rfl⟩
  obtain ⟨Rp, hRp⟩ : ∃ Rp : ℕ, Rp = ⌈κ₀ + (κ₀ + 1) * u⌉₊ := ⟨_, rfl⟩
  obtain ⟨hu1, hlogm, hRp1, hA0, htail, hlarge, hsmall⟩ :=
    kai_cube_numeric (Module.finrank ℚ K) hn1 M m hM hm1 hmexp u κ₀ A Rp hu hκ₀ hA hRp
  have hEu : Real.exp (-(Real.log M ^ ((1:ℝ)/3))) = Real.exp (-u) := by rw [hu]
  have hE0 : 0 < Real.exp (-u) := Real.exp_pos _
  
  have hIcc : ∀ a c : ℤ, (Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => a)
      (fun _ => c)).card = (c + 1 - a).toNat ^ (4 * Module.finrank ℚ K) := by
    intro a c
    rw [Pi.card_Icc]
    simp [Int.card_Icc]
  have hboxq : ∀ q : ℕ, (Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
      (fun _ => (q:ℤ) - 1)).card = q ^ (4 * Module.finrank ℚ K) := by
    intro q
    rw [hIcc]
    simp
  obtain ⟨b, hb⟩ : ∃ b : ℕ, b = 2 * ⌊M⌋₊ + 1 := ⟨_, rfl⟩
  have hBcard : ((omegaBox ω M).card : ℝ) = (b : ℝ) ^ Module.finrank ℚ K := by
    have h1 : (omegaBox ω M).card = b ^ Module.finrank ℚ K := by
      unfold omegaBox intBox
      rw [Finset.card_image_of_injective _ (fun x y h => ω.equivFun.symm.injective h), Pi.card_Icc]
      simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      congr 1
      omega
    rw [h1]
    push_cast
    ring
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = (2 * (b : ℝ)) ^ (4 * Module.finrank ℚ K) := ⟨_, rfl⟩
  have hG16 : G = 16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4 := by
    rw [hG, hBcard, mul_pow, pow_mul (2:ℝ) 4, pow_mul' (b:ℝ) 4]
    norm_num
  have hMb : M ≤ (b : ℝ) := by
    have h1 := Nat.lt_floor_add_one M
    rw [hb]
    push_cast
    linarith [(Nat.cast_nonneg ⌊M⌋₊ : (0:ℝ) ≤ ⌊M⌋₊)]
  
  obtain ⟨L, hL⟩ : ∃ L : ℕ, L = 2 * ⌊M⌋₊ := ⟨_, rfl⟩
  obtain ⟨hreg1, hreg2⟩ := kai_cube_region_lines K ω S (2 * Module.finrank ℚ K + 1)
  have hbox' : ∀ z : Fin 4 × Fin (Module.finrank ℚ K) → ℤ,
      (∀ ε, kaiCubeVtx ω z ε ∈ S) → ∀ k, |z k| ≤ (L : ℤ) := by
    intro z hz k
    have := hreg2 M hS z hz k
    rw [hL]
    push_cast
    exact this
  obtain ⟨R, hRdef⟩ : ∃ R : Finset (Fin 4 × Fin (Module.finrank ℚ K) → ℤ),
      R = (Finset.Icc (fun _ => -(L:ℤ)) (fun _ => (L:ℤ))).filter
        (fun z => ∀ ε, kaiCubeVtx ω z ε ∈ S) := ⟨_, rfl⟩
  have hRiff : ∀ z, z ∈ R ↔ ∀ ε : Fin 3 → Fin 2, kaiCubeVtx ω z ε ∈ S := by
    intro z
    rw [hRdef, Finset.mem_filter, Finset.mem_Icc]
    refine ⟨fun h => h.2, fun h => ⟨⟨?_, ?_⟩, h⟩⟩
    · intro k
      exact (abs_le.mp (hbox' z h k)).1
    · intro k
      exact (abs_le.mp (hbox' z h k)).2
  have hboxR : ∀ z ∈ R, ∀ k, |z k| ≤ (L : ℤ) := fun z hz => hbox' z ((hRiff z).1 hz)
  have hboxR2 : ∀ z ∈ R, ∀ k, |z k| ≤ 2 * (⌊M⌋₊ : ℤ) :=
    fun z hz k => hreg2 M hS z ((hRiff z).1 hz) k
  have hlineR := hreg1 hlineS R hRiff
  have hRcard : (R.card : ℝ) ≤ G := by
    have h1 : R.card ≤ (2 * L + 1) ^ (4 * Module.finrank ℚ K) := by
      calc R.card ≤ (Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => -(L:ℤ))
            (fun _ => (L:ℤ))).card := by rw [hRdef]; exact Finset.card_filter_le _ _
        _ = (2 * L + 1) ^ (4 * Module.finrank ℚ K) := by rw [hIcc]; congr 1; omega
    have h2 : ((2 * L + 1 : ℕ) : ℝ) ≤ 2 * (b : ℝ) := by
      rw [hL, hb]; push_cast; linarith
    calc (R.card : ℝ) ≤ (((2 * L + 1) ^ (4 * Module.finrank ℚ K) : ℕ) : ℝ) := by
          exact_mod_cast h1
      _ = ((2 * L + 1 : ℕ) : ℝ) ^ (4 * Module.finrank ℚ K) := by push_cast; ring
      _ ≤ G := by rw [hG]; exact pow_le_pow_left₀ (by positivity) h2 _
  
  obtain ⟨U₂, hU₂⟩ : ∃ U₂ : Finset ℕ,
      U₂ = (Finset.range (m + 1)).filter (fun p => p.Prime ∧ ¬ p ∣ Q) := ⟨_, rfl⟩
  have hW : kaiW2 m Q = ∏ p ∈ U₂, p := by rw [hU₂, kaiW2]
  have hU₂prime : ∀ p ∈ U₂, p.Prime := by
    intro p hp; rw [hU₂, Finset.mem_filter] at hp; exact hp.2.1
  have hU₂Q : ∀ p ∈ U₂, ¬ p ∣ Q := by
    intro p hp; rw [hU₂, Finset.mem_filter] at hp; exact hp.2.2
  have hU₂sub : U₂ ⊆ (Finset.range (m + 1)).filter Nat.Prime := by
    intro p hp
    rw [hU₂, Finset.mem_filter] at hp
    rw [Finset.mem_filter]
    exact ⟨hp.1, hp.2.1⟩
  
  have hcp : ∀ (U : Finset ℕ) (x : NumberField.RingOfIntegers K),
      CoprimeToNat (∏ p ∈ U, p) x ↔ ∀ p ∈ U, CoprimeToNat p x := by
    intro U x
    unfold CoprimeToNat
    constructor
    · intro h p hp 𝔭 hp𝔭
      apply h 𝔭
      obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem (fun q : ℕ => q) hp
      rw [hk, Nat.cast_mul]
      exact Ideal.mul_mem_right _ _ hp𝔭
    · intro h 𝔭 hW'
      rw [Nat.cast_prod] at hW'
      haveI := 𝔭.isPrime
      obtain ⟨p, hp, hp𝔭⟩ := (Ideal.IsPrime.prod_mem_iff).1 hW'
      exact h p hp 𝔭 hp𝔭
  have hcopiff : ∀ z, (∀ ε : Fin 3 → Fin 2, CoprimeToNat (kaiW2 m Q) (kaiCubeVtx ω z ε)) ↔
      ∀ p ∈ U₂, ¬ kaiCubeBad ω p z := by
    intro z
    rw [hW]
    simp only [hcp, kaiCubeBad, not_exists, not_not]
    exact ⟨fun h p hp ε => h ε p hp, fun h ε p hp => h p hp ε⟩
  
  obtain ⟨Nf, hNf⟩ : ∃ Nf : (Fin 4 × Fin (Module.finrank ℚ K) → ℤ) → ℝ, Nf = fun c =>
      ((R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ U₂, ¬ kaiCubeBad ω p z)).card : ℝ) :=
    ⟨_, rfl⟩
  obtain ⟨Tc, hTc⟩ : ∃ Tc : ℝ,
      Tc = ((R.filter (fun z => ∀ p ∈ U₂, ¬ kaiCubeBad ω p z)).card : ℝ) := ⟨_, rfl⟩
  have hTsum : ∑ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
      (fun _ => (Q:ℤ) - 1), Nf c = Tc := by
    have h := kai_box_class_partition Q hQ1 (R.filter (fun z => ∀ p ∈ U₂, ¬ kaiCubeBad ω p z))
    rw [hTc, ← h, Nat.cast_sum]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    have e : (R.filter (fun z => ∀ p ∈ U₂, ¬ kaiCubeBad ω p z)).filter
          (fun z => ∀ k, (Q:ℤ) ∣ z k - c k) =
        R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ U₂, ¬ kaiCubeBad ω p z) := by
      rw [Finset.filter_filter]
      exact Finset.filter_congr (fun z _ => and_comm)
    rw [e, hNf]
  have hNf0 : ∀ c, 0 ≤ Nf c := by intro c; rw [hNf]; positivity
  have hsieve : ∀ Φ : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
      NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℝ,
      (∀ x h₁ h₂ h₃ y₀ y₁ y₂ y₃ : NumberField.RingOfIntegers K,
        Φ (x + (Q : NumberField.RingOfIntegers K) * y₀)
          (h₁ + (Q : NumberField.RingOfIntegers K) * y₁)
          (h₂ + (Q : NumberField.RingOfIntegers K) * y₂)
          (h₃ + (Q : NumberField.RingOfIntegers K) * y₃) = Φ x h₁ h₂ h₃) →
      kaiCubeSieveSum ω M (kaiW2 m Q) S Φ =
        ∑ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ)) (fun _ => (Q:ℤ) - 1),
          Φ (ω.equivFun.symm (fun j => c (0, j))) (ω.equivFun.symm (fun j => c (1, j)))
            (ω.equivFun.symm (fun j => c (2, j))) (ω.equivFun.symm (fun j => c (3, j))) * Nf c := by
    intro Φ hΦ
    rw [kai_cube_sieve_sum_reindex K ω M Q (kaiW2 m Q) hQ1 S hS R hRiff hboxR2 Φ hΦ]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    have e : R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧
          ∀ ε : Fin 3 → Fin 2, CoprimeToNat (kaiW2 m Q) (kaiCubeVtx ω z ε)) =
        R.filter (fun z => (∀ k, (Q:ℤ) ∣ z k - c k) ∧ ∀ p ∈ U₂, ¬ kaiCubeBad ω p z) :=
      Finset.filter_congr (fun z _ => and_congr_right (fun _ => hcopiff z))
    rw [e, hNf]
  
  have habs : ∀ (s : Finset (Fin 4 × Fin (Module.finrank ℚ K) → ℤ))
      (φ N : (Fin 4 × Fin (Module.finrank ℚ K) → ℤ) → ℝ) (P T X : ℝ),
      0 < P → (s.card : ℝ) = P → ∑ c ∈ s, N c = T → (∀ c, |φ c| ≤ 1) →
      |∑ c ∈ s, φ c * N c - T * (∑ c ∈ s, φ c) / P| ≤ 2 * ∑ c ∈ s, |N c - X| := by
    intro s φ N P T X hP hcard hsum hφ
    have h2 : ∑ c ∈ s, (N c - X) = T - P * X := by
      rw [Finset.sum_sub_distrib, hsum, Finset.sum_const, nsmul_eq_mul, hcard]
    have h3 : ∑ c ∈ s, φ c * (N c - X) = ∑ c ∈ s, φ c * N c - X * ∑ c ∈ s, φ c := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun c _ => by ring)
    have e1 : ∑ c ∈ s, φ c * N c - T * (∑ c ∈ s, φ c) / P =
        ∑ c ∈ s, φ c * (N c - X) - ((∑ c ∈ s, φ c) / P) * ∑ c ∈ s, (N c - X) := by
      rw [h2, h3]
      field_simp
      ring
    rw [e1]
    have h4 : |∑ c ∈ s, φ c * (N c - X)| ≤ ∑ c ∈ s, |N c - X| := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun c _ => ?_))
      rw [abs_mul]
      exact mul_le_of_le_one_left (abs_nonneg _) (hφ c)
    have h5 : |(∑ c ∈ s, φ c) / P| ≤ 1 := by
      rw [abs_div, abs_of_pos hP, div_le_one hP]
      calc |∑ c ∈ s, φ c| ≤ ∑ c ∈ s, |φ c| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ c ∈ s, (1:ℝ) := Finset.sum_le_sum (fun c _ => hφ c)
        _ = P := by rw [Finset.sum_const, nsmul_eq_mul, mul_one, hcard]
    have h6 : |∑ c ∈ s, (N c - X)| ≤ ∑ c ∈ s, |N c - X| := Finset.abs_sum_le_sum_abs _ _
    have h7 := abs_sub (∑ c ∈ s, φ c * (N c - X)) (((∑ c ∈ s, φ c) / P) * ∑ c ∈ s, (N c - X))
    rw [abs_mul] at h7
    have h8 : |(∑ c ∈ s, φ c) / P| * |∑ c ∈ s, (N c - X)| ≤ 1 * ∑ c ∈ s, |N c - X| :=
      mul_le_mul h5 h6 (abs_nonneg _) zero_le_one
    linarith
  
  unfold KaiCubeEquidist
  have hB0 : 0 ≤ ((omegaBox ω M).card : ℝ) ^ 4 := by positivity
  have hP0 : 0 ≤ 16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4 := by positivity
  have hexpA : 1 ≤ Real.exp A := Real.one_le_exp hA0.le
  have hTc0 : 0 ≤ Tc := by rw [hTc]; positivity
  have hTcG : Tc ≤ G := by
    refine le_trans ?_ hRcard
    rw [hTc]
    exact_mod_cast Finset.card_filter_le _ _
  refine ⟨Tc, ?_, ?_⟩
  · rw [abs_of_nonneg hTc0]
    have h1 := mul_le_mul_of_nonneg_left hexpA hP0
    have h2 := mul_nonneg hP0 hDl0
    calc Tc ≤ 16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4 := hG16 ▸ hTcG
      _ ≤ (2 * 16 ^ Module.finrank ℚ K * Real.exp A + 2 * 16 ^ Module.finrank ℚ K * (1 + Dl))
            * ((omegaBox ω M).card : ℝ) ^ 4 := by nlinarith
  · intro Φ hΦ1 hΦp
    rw [hEu]
    have hkey : ∀ X : ℝ, |kaiCubeSieveSum ω M (kaiW2 m Q) S Φ
        - Tc * kaiResSum ω Q Φ / (Q : ℝ) ^ (4 * Module.finrank ℚ K)|
        ≤ 2 * ∑ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
            (fun _ => (Q:ℤ) - 1), |Nf c - X| := by
      intro X
      rw [hsieve Φ hΦp, kai_cube_res_sum_reindex K ω Q hQ1 Φ]
      exact habs _ (fun c => Φ (ω.equivFun.symm (fun j => c (0, j)))
          (ω.equivFun.symm (fun j => c (1, j)))
          (ω.equivFun.symm (fun j => c (2, j))) (ω.equivFun.symm (fun j => c (3, j))))
        Nf _ Tc X (by positivity) (by rw [hboxq]; push_cast; ring) hTsum
        (fun c => hΦ1 _ _ _ _)
    rcases lt_or_ge u A with hsm | hlg
    · 
      have h1 := hkey 0
      have h2 : ∑ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
          (fun _ => (Q:ℤ) - 1), |Nf c - 0| = Tc := by
        rw [← hTsum]
        refine Finset.sum_congr rfl (fun c _ => ?_)
        rw [sub_zero, abs_of_nonneg (hNf0 c)]
      rw [h2] at h1
      have h3 := hsmall hsm
      have h4 : 0 ≤ 2 * (16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4) * (1 + Dl)
          * Real.exp (-u) := by positivity
      have h5 : 2 * (16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4)
          ≤ 2 * (16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4)
            * (Real.exp A * Real.exp (-u)) :=
        le_mul_of_one_le_right (by positivity) h3
      calc _ ≤ 2 * Tc := h1
        _ ≤ 2 * (16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4) := by
            rw [← hG16]; linarith
        _ ≤ _ := by nlinarith
    · 
      obtain ⟨r, hr⟩ : ∃ r : ℕ, Rp = r + 1 := ⟨Rp - 1, by omega⟩
      obtain ⟨fT, hfT⟩ : ∃ fT : Finset ℕ → ℕ, fT = fun T =>
          ((Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
            (fun _ => ((∏ p ∈ T, p : ℕ) : ℤ) - 1)).filter
              (fun a => ∀ p ∈ T, kaiCubeBad ω p a)).card := ⟨_, rfl⟩
      have hs1 := kai_cube_abstract_sieve R L (8 * (2 * Module.finrank ℚ K + 1)) hboxR hlineR
        U₂ hU₂prime Q hQ1 hU₂Q (kaiCubeBad ω)
        (fun p _ z z' h => (kai_cube_bad_local K ω).1 p z z' h) r
      obtain ⟨X, hX⟩ : ∃ X : ℝ, ∑ c ∈ Finset.Icc
          (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ)) (fun _ => (Q:ℤ) - 1), |Nf c - X|
          ≤ (R.card : ℝ) * ∑ T ∈ U₂.powerset.filter (fun T => T.card = r + 1),
                (fT T : ℝ) / ((∏ p ∈ T, p : ℕ) : ℝ) ^ Fintype.card (Fin 4 × Fin (Module.finrank ℚ K))
            + (Q : ℝ) ^ Fintype.card (Fin 4 × Fin (Module.finrank ℚ K)) *
                ((Fintype.card (Fin 4 × Fin (Module.finrank ℚ K)) : ℝ)
                  * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
                  * (2 * (L : ℝ) + 1) ^ (Fintype.card (Fin 4 × Fin (Module.finrank ℚ K)) - 1)) *
                ∑ T ∈ U₂.powerset.filter (fun T => T.card ≤ r + 1), (fT T : ℝ) :=
        ⟨_, by subst hNf hfT; exact hs1⟩
      have hcardι : Fintype.card (Fin 4 × Fin (Module.finrank ℚ K)) = 4 * Module.finrank ℚ K := by
        simp
      rw [hcardι] at hX
      
      have hf1 : ∀ T ∈ U₂.powerset,
          fT T ≤ ∏ p ∈ T, 8 * Module.finrank ℚ K * p ^ (4 * Module.finrank ℚ K - 1) := by
        intro T hT'
        simp only [hfT]
        exact (kai_cube_bad_local K ω).2 T (fun p hp => hU₂prime p (Finset.mem_powerset.1 hT' hp))
      have htl := kai_cube_tail_bound (Module.finrank ℚ K) (4 * Module.finrank ℚ K) m (r + 1)
        (by omega) hm1 U₂ hU₂sub fT hf1
      have haux : Real.exp (-((r + 1 : ℕ) : ℝ)) * Real.exp (Real.exp 1 *
          (8 * (Module.finrank ℚ K : ℝ) * (1 + Real.log (m : ℝ)))) ≤ Real.exp (-u) := by
        rw [← hr]
        refine le_trans ?_ htail
        gcongr
      have hTail := htl.trans haux
      have hRT : (R.card : ℝ) * ∑ T ∈ U₂.powerset.filter (fun T => T.card = r + 1),
            (fT T : ℝ) / ((∏ p ∈ T, p : ℕ) : ℝ) ^ (4 * Module.finrank ℚ K)
          ≤ G * Real.exp (-u) :=
        (mul_le_mul_of_nonneg_left hTail (Nat.cast_nonneg _)).trans
          (mul_le_mul_of_nonneg_right hRcard hE0.le)
      
      have hf2 : ∀ T ∈ U₂.powerset, fT T ≤ (∏ p ∈ T, p) ^ (4 * Module.finrank ℚ K) := by
        intro T _
        simp only [hfT]
        exact (Finset.card_filter_le _ _).trans (le_of_eq (hboxq _))
      have hlat := kai_cube_lattice_bound (4 * Module.finrank ℚ K) m (r + 1) U₂ hU₂sub fT hf2
      have hQm' : (Q : ℝ) ≤ (m : ℝ) + 1 := by
        have : (Q : ℝ) ≤ m := by exact_mod_cast hQm
        linarith
      have hQD : (Q : ℝ) ^ (4 * Module.finrank ℚ K) ≤ ((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K) :=
        pow_le_pow_left₀ (by positivity) hQm' _
      have hpow : ((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K) *
          (((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K + 1)) ^ (r + 1)
          = ((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K + (4 * Module.finrank ℚ K + 1) * Rp) := by
        rw [hr, ← pow_mul, ← pow_add]
      have hY : ((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K + (4 * Module.finrank ℚ K + 1) * Rp)
          ≤ M * Real.exp (-u) := by
        have h1 := mul_le_mul_of_nonneg_right (hlarge hlg) hE0.le
        rwa [mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, mul_one] at h1
      have hWM : (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1) * M ≤ G := by
        have hLb : 2 * (L : ℝ) + 1 ≤ 2 * (b : ℝ) := by
          rw [hL, hb]; push_cast; linarith
        have hMb2 : M ≤ 2 * (b : ℝ) := by
          have : (0:ℝ) ≤ b := Nat.cast_nonneg _
          linarith
        calc (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1) * M
            ≤ (2 * (b : ℝ)) ^ (4 * Module.finrank ℚ K - 1) * (2 * (b : ℝ)) :=
              mul_le_mul (pow_le_pow_left₀ (by positivity) hLb _) hMb2 (by linarith)
                (by positivity)
          _ = G := by rw [hG, pow_sub_one_mul (by omega)]
      have hJ : ((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
          * Real.exp 1 = Dl := by
        rw [hDl]; push_cast; ring
      have hLat : (Q : ℝ) ^ (4 * Module.finrank ℚ K) *
            (((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
              * (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1)) *
            ∑ T ∈ U₂.powerset.filter (fun T => T.card ≤ r + 1), (fT T : ℝ)
          ≤ Dl * G * Real.exp (-u) := by
        have hc0 : 0 ≤ (Q : ℝ) ^ (4 * Module.finrank ℚ K) *
            (((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
              * (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1)) := by positivity
        have hW0 : 0 ≤ (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1) := by positivity
        have hDJ0 : 0 ≤ ((4 * Module.finrank ℚ K : ℕ) : ℝ) *
            ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ) * Real.exp 1 := by positivity
        have hlam0 : 0 ≤ (((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K + 1)) ^ (r + 1) := by positivity
        calc _ ≤ (Q : ℝ) ^ (4 * Module.finrank ℚ K) *
              (((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
                * (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1)) *
              (Real.exp 1 * (((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K + 1)) ^ (r + 1)) :=
              mul_le_mul_of_nonneg_left hlat hc0
          _ = (((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
                * Real.exp 1) * (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1) *
              ((Q : ℝ) ^ (4 * Module.finrank ℚ K) *
                (((m : ℝ) + 1) ^ (4 * Module.finrank ℚ K + 1)) ^ (r + 1)) := by ring
          _ ≤ (((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
                * Real.exp 1) * (2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1) *
              (M * Real.exp (-u)) := by
              apply mul_le_mul_of_nonneg_left _ (mul_nonneg hDJ0 hW0)
              rw [← hpow] at hY
              exact (mul_le_mul_of_nonneg_right hQD hlam0).trans hY
          _ = (((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
                * Real.exp 1) * ((2 * (L : ℝ) + 1) ^ (4 * Module.finrank ℚ K - 1) * M)
                * Real.exp (-u) := by ring
          _ ≤ (((4 * Module.finrank ℚ K : ℕ) : ℝ) * ((8 * (2 * Module.finrank ℚ K + 1) : ℕ) : ℝ)
                * Real.exp 1) * G * Real.exp (-u) := by
              apply mul_le_mul_of_nonneg_right _ hE0.le
              exact mul_le_mul_of_nonneg_left hWM hDJ0
          _ = Dl * G * Real.exp (-u) := by rw [hJ]
      have hfin : 2 * (G * Real.exp (-u) + Dl * G * Real.exp (-u))
          = 2 * (16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4) * (1 + Dl)
            * Real.exp (-u) := by
        rw [hG16]; ring
      have h4 : 0 ≤ 2 * (16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4)
          * Real.exp A * Real.exp (-u) := by positivity
      calc _ ≤ 2 * ∑ c ∈ Finset.Icc (fun _ : Fin 4 × Fin (Module.finrank ℚ K) => (0:ℤ))
            (fun _ => (Q:ℤ) - 1), |Nf c - X| := hkey X
        _ ≤ 2 * (G * Real.exp (-u) + Dl * G * Real.exp (-u)) := by linarith
        _ = 2 * (16 ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ) ^ 4) * (1 + Dl)
            * Real.exp (-u) := hfin
        _ ≤ _ := by nlinarith

theorem kai_orthant_char_lift {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (h𝔮 : 𝔮 ≠ ⊥)
    (ψ : NumberField.RingOfIntegers K → ℤ) (hψ : IsRealRayChar 𝔮 ψ) (o : KaiPattern K) :
    KaiCharLift 𝔮 ψ o :=
by
  classical
  obtain ⟨h1, h2, h3, -, h5, -⟩ := hψ
  have hQ0 : Ideal.absNorm 𝔮 ≠ 0 := fun h => h𝔮 (Ideal.absNorm_eq_zero_iff.mp h)
  have hQ1 : 1 ≤ Ideal.absNorm 𝔮 := Nat.one_le_iff_ne_zero.mpr hQ0
  have hQmem : ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔮 :=
    Ideal.absNorm_mem 𝔮
  have hcm : ∀ a b : NumberField.RingOfIntegers K,
      ((a * b : NumberField.RingOfIntegers K) : K) = (a : K) * (b : K) := by
    intro a b
    first
      | norm_cast
      | exact map_mul (algebraMap (NumberField.RingOfIntegers K) K) a b
      | simp
  
  have htp : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K)
      (hw : w.IsReal),
      0 < NumberField.InfinitePlace.embedding_of_isReal hw
        (((x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K) :
          NumberField.RingOfIntegers K)) : K) := by
    intro x w hw
    have hcoe : (((x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K) :
          NumberField.RingOfIntegers K)) : K)
        = (x : K) + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : K) := by
      first
        | norm_cast
        | (push_cast; ring)
        | simp
    rw [hcoe, map_add, map_natCast]
    have habs : |NumberField.InfinitePlace.embedding_of_isReal hw (x : K)| = w (x : K) := by
      rw [← Real.norm_eq_abs]
      exact NumberField.InfinitePlace.norm_embedding_of_isReal hw (x : K)
    have hle : w (x : K) ≤ ∑ v : NumberField.InfinitePlace K, v (x : K) :=
      Finset.single_le_sum (f := fun v : NumberField.InfinitePlace K => v (x : K))
        (fun v _ => apply_nonneg v _) (Finset.mem_univ w)
    have hceil : ∑ v : NumberField.InfinitePlace K, v (x : K)
        ≤ (⌈∑ v : NumberField.InfinitePlace K, v (x : K)⌉₊ : ℝ) := Nat.le_ceil _
    have hs : (kaiShift x : ℝ) = (⌈∑ v : NumberField.InfinitePlace K, v (x : K)⌉₊ : ℝ) + 1 := by
      unfold kaiShift; push_cast; ring
    have hn : (1 : ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) := by exact_mod_cast hQ1
    have hs0 : (0 : ℝ) ≤ (kaiShift x : ℝ) := Nat.cast_nonneg _
    have hns : (kaiShift x : ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) * (kaiShift x : ℝ) :=
      le_mul_of_one_le_left hs0 hn
    have hna := neg_abs_le (NumberField.InfinitePlace.embedding_of_isReal hw (x : K))
    push_cast
    linarith
  
  have hshift : ∀ x : NumberField.RingOfIntegers K,
      (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) - x ∈ 𝔮 := by
    intro x
    rw [add_sub_cancel_left, Nat.cast_mul]
    exact Ideal.mul_mem_right _ _ hQmem
  
  have hR : ∀ x z : NumberField.RingOfIntegers K, z - x ∈ 𝔮 →
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (z : K)) →
      kaiFplus 𝔮 ψ x = ψ z := by
    intro x z hzx hz
    unfold kaiFplus
    apply h5
    · have e : (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) - z
          = ((x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) - x)
            - (z - x) := by ring
      rw [e]
      exact Ideal.sub_mem _ (hshift x) hzx
    · intro w hw
      exact mul_pos (htp x w hw) (hz w hw)
  
  have hcopsub : ∀ x y : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {x}) 𝔮 →
      x - y ∈ 𝔮 → IsCoprime (Ideal.span {y}) 𝔮 := by
    intro x y hx hxy
    obtain ⟨i, hi, j, hj, hij⟩ := Ideal.isCoprime_iff_exists.mp hx
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hi
    refine Ideal.isCoprime_iff_exists.mpr ⟨c * y, Ideal.mem_span_singleton'.mpr ⟨c, rfl⟩,
      c * (x - y) + j, Ideal.add_mem _ (Ideal.mul_mem_left _ c hxy) hj, ?_⟩
    linear_combination hij
  have hval : ∀ z, IsCoprime (Ideal.span {z}) 𝔮 → ψ z = 1 ∨ ψ z = -1 := by
    intro z hz
    rcases h1 z with h | h | h
    · exact Or.inl h
    · exact Or.inr h
    · exact absurd hz ((h2 z).mp h)
  
  have PA : ∀ x y : NumberField.RingOfIntegers K,
      kaiFplus 𝔮 ψ (x + ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) * y)
        = kaiFplus 𝔮 ψ x := by
    intro x y
    rw [hR _ (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) ?_
      (htp x)]
    · rfl
    · have e : (x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K))
            - (x + ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) * y)
          = ((x + ((Ideal.absNorm 𝔮 * kaiShift x : ℕ) : NumberField.RingOfIntegers K)) - x)
            - ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) * y := by ring
      rw [e]
      exact Ideal.sub_mem _ (hshift x) (Ideal.mul_mem_right y 𝔮 hQmem)
  
  have PB : ∀ x : NumberField.RingOfIntegers K,
      kaiFplus 𝔮 ψ x = 1 ∨ kaiFplus 𝔮 ψ x = -1 ∨ kaiFplus 𝔮 ψ x = 0 := by
    intro x
    exact h1 _
  
  have hsign : ∀ v v₀ : NumberField.RingOfIntegers K, v ≠ 0 → v₀ ≠ 0 → kaiPatt o v →
      kaiPatt o v₀ → ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      0 < NumberField.InfinitePlace.embedding_of_isReal hw (v : K) *
        NumberField.InfinitePlace.embedding_of_isReal hw (v₀ : K) := by
    intro v v₀ hv0 hv₀0 hvo hv₀o w hw
    have hvK : (v : K) ≠ 0 := fun h => hv0 (NumberField.RingOfIntegers.coe_eq_zero_iff.mp h)
    have hv₀K : (v₀ : K) ≠ 0 := fun h => hv₀0 (NumberField.RingOfIntegers.coe_eq_zero_iff.mp h)
    have hσv : NumberField.InfinitePlace.embedding_of_isReal hw (v : K) ≠ 0 :=
      (map_ne_zero _).mpr hvK
    have hσv₀ : NumberField.InfinitePlace.embedding_of_isReal hw (v₀ : K) ≠ 0 :=
      (map_ne_zero _).mpr hv₀K
    have e1 : 0 < NumberField.InfinitePlace.embedding_of_isReal hw (v : K) ↔ o ⟨w, hw⟩ = true :=
      hvo ⟨w, hw⟩
    have e2 : 0 < NumberField.InfinitePlace.embedding_of_isReal hw (v₀ : K) ↔ o ⟨w, hw⟩ = true :=
      hv₀o ⟨w, hw⟩
    by_cases ho : o ⟨w, hw⟩ = true
    · exact mul_pos (e1.mpr ho) (e2.mpr ho)
    · have a1 : ¬ 0 < NumberField.InfinitePlace.embedding_of_isReal hw (v : K) :=
        fun h => ho (e1.mp h)
      have a2 : ¬ 0 < NumberField.InfinitePlace.embedding_of_isReal hw (v₀ : K) :=
        fun h => ho (e2.mp h)
      push_neg at a1 a2
      exact mul_pos_of_neg_of_neg (lt_of_le_of_ne a1 hσv) (lt_of_le_of_ne a2 hσv₀)
  
  have PC : ∃ ζ : ℤ, (ζ = 1 ∨ ζ = -1) ∧ ∀ v : NumberField.RingOfIntegers K, v ≠ 0 →
      kaiPatt o v → ψ v = ζ * kaiFplus 𝔮 ψ v := by
    by_cases hex : ∃ v₀ : NumberField.RingOfIntegers K, v₀ ≠ 0 ∧ kaiPatt o v₀ ∧
        IsCoprime (Ideal.span {v₀}) 𝔮
    · obtain ⟨v₀, hv₀0, hv₀o, hv₀c⟩ := hex
      obtain ⟨z₀, hz₀⟩ : ∃ z₀ : NumberField.RingOfIntegers K,
          z₀ = v₀ + ((Ideal.absNorm 𝔮 * kaiShift v₀ : ℕ) : NumberField.RingOfIntegers K) :=
        ⟨_, rfl⟩
      have hz₀m : z₀ - v₀ ∈ 𝔮 := by rw [hz₀]; exact hshift v₀
      have hz₀p : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
          0 < NumberField.InfinitePlace.embedding_of_isReal hw (z₀ : K) := by
        rw [hz₀]; exact htp v₀
      have hv₀z₀ : v₀ - z₀ ∈ 𝔮 := by
        have h' := neg_mem hz₀m
        rw [neg_sub] at h'
        exact h'
      have hz₀c : IsCoprime (Ideal.span {z₀}) 𝔮 := hcopsub v₀ z₀ hv₀c hv₀z₀
      have hψv₀ := hval v₀ hv₀c
      have hψz₀ := hval z₀ hz₀c
      refine ⟨ψ v₀ * ψ z₀, ?_, ?_⟩
      · rcases hψv₀ with h | h <;> rcases hψz₀ with h' | h' <;> rw [h, h'] <;> norm_num
      · intro v hv0 hvo
        obtain ⟨z, hz⟩ : ∃ z : NumberField.RingOfIntegers K,
            z = v + ((Ideal.absNorm 𝔮 * kaiShift v : ℕ) : NumberField.RingOfIntegers K) :=
          ⟨_, rfl⟩
        have hFv : kaiFplus 𝔮 ψ v = ψ z := by rw [hz]; rfl
        have hzm : z - v ∈ 𝔮 := by rw [hz]; exact hshift v
        have hzp : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
            0 < NumberField.InfinitePlace.embedding_of_isReal hw (z : K) := by
          rw [hz]; exact htp v
        have key : ψ (v * z₀) = ψ (v₀ * z) := by
          apply h5
          · have e : v * z₀ - v₀ * z = v * (z₀ - v₀) - v₀ * (z - v) := by ring
            rw [e]
            exact Ideal.sub_mem _ (Ideal.mul_mem_left _ v hz₀m) (Ideal.mul_mem_left _ v₀ hzm)
          · intro w hw
            rw [hcm, hcm, map_mul, map_mul]
            have hA := hsign v v₀ hv0 hv₀0 hvo hv₀o w hw
            have hB := mul_pos (hz₀p w hw) (hzp w hw)
            have e : NumberField.InfinitePlace.embedding_of_isReal hw (v : K) *
                  NumberField.InfinitePlace.embedding_of_isReal hw (z₀ : K) *
                (NumberField.InfinitePlace.embedding_of_isReal hw (v₀ : K) *
                  NumberField.InfinitePlace.embedding_of_isReal hw (z : K))
                = (NumberField.InfinitePlace.embedding_of_isReal hw (v : K) *
                    NumberField.InfinitePlace.embedding_of_isReal hw (v₀ : K)) *
                  (NumberField.InfinitePlace.embedding_of_isReal hw (z₀ : K) *
                    NumberField.InfinitePlace.embedding_of_isReal hw (z : K)) := by ring
            rw [e]
            exact mul_pos hA hB
        rw [h3, h3] at key
        rw [hFv]
        rcases hψz₀ with h | h
        · rw [h] at key ⊢; linarith
        · rw [h] at key ⊢; linarith
    · refine ⟨1, Or.inl rfl, ?_⟩
      intro v hv0 hvo
      have hnc : ¬ IsCoprime (Ideal.span {v}) 𝔮 := fun hc => hex ⟨v, hv0, hvo, hc⟩
      have hψv : ψ v = 0 := (h2 v).mpr hnc
      have hnc' : ¬ IsCoprime (Ideal.span
          {v + ((Ideal.absNorm 𝔮 * kaiShift v : ℕ) : NumberField.RingOfIntegers K)}) 𝔮 :=
        fun hc => hnc (hcopsub _ v hc (hshift v))
      have hF : kaiFplus 𝔮 ψ v = 0 := (h2 _).mpr hnc'
      rw [hψv, hF]
      norm_num
  exact ⟨PA, PB, PC⟩

theorem kai_cutoff_piece_U3 (K : Type u) [Field K] [NumberField K] (ρ : ℝ) (hρ : 0 ≤ ρ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M : ℝ) (m : ℕ)
    (Dt : Ideal (NumberField.RingOfIntegers K) × (NumberField.RingOfIntegers K → ℤ) × ℝ)
    (hM : 3 ≤ M) (hm₁ : Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ))
    (hm₂ : (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)))
    (hDt : IsSiegelDatum m Dt) (hψ : Dt.2.1 ≠ 0)
    (Y : ℝ) (o : KaiPattern K) (C₃ C₄ : ℝ) (hC₃ : 0 ≤ C₃) (hC₄ : 0 ≤ C₄)
    (H3 : KaiCharU3Bound ω Dt.1 Dt.2.1 C₃)
    (H4 : KaiCubeEquidist ω M m (Ideal.absNorm Dt.1) (kaiCutoffSet ω M Y o) C₄)
    (H5 : KaiCharLift Dt.1 Dt.2.1 o) :
    gowersU3Pow ω (kaiCutoffPiece ω M ρ (primorial m) Dt.2.1 Y o) M
      ≤ (ρ * ((primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ))) ^ 8
          * (C₄ * (C₃ + 1)) / (Ideal.absNorm Dt.1 : ℝ) ^ ((1:ℝ)/4) :=
by
  classical
  obtain ⟨𝔮, ψ, β⟩ := Dt
  dsimp only at hψ hDt H3 H4 H5 ⊢
  obtain ⟨h𝔮, hcases⟩ := hDt
  rcases hcases with h0 | ⟨hR, hβ1, hβ2, hQm, hprime⟩
  · exact absurd h0 hψ
