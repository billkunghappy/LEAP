  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 (hE.and (hgne.and (hgan.and hGg2)))
  
  have hkey : ∀ t : ℝ, 0 < t → t < ε → t < δ → ‖((n : ℂ) - 1) / (t : ℂ)‖ ≤ M + K := by
    intro t ht htε htδ
    obtain ⟨hEt, hgt, hant, hGt⟩ := hball (by rw [hdist _ ht.le]; exact htε)
    have hloc' := hloc (β + t) (by linarith) (by linarith)
