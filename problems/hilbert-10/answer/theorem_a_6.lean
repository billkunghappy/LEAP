noncomputable def kaiHZDualTwist (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    NumberField.mixedEmbedding.mixedSpace K →ₗ[ℝ]
      NumberField.mixedEmbedding.mixedSpace K where
  toFun x := (x.1, fun p => 2 * (starRingEnd ℂ) (x.2 p))
  map_add' x z := by
    refine Prod.ext rfl (funext fun p => ?_)
    show (2 : ℂ) * (starRingEnd ℂ) (x.2 p + z.2 p)
        = 2 * (starRingEnd ℂ) (x.2 p) + 2 * (starRingEnd ℂ) (z.2 p)
    rw [map_add]; ring
  map_smul' c x := by
    refine Prod.ext rfl (funext fun p => ?_)
    show (2 : ℂ) * (starRingEnd ℂ) (c • x.2 p) = c • (2 * (starRingEnd ℂ) (x.2 p))
    rw [Complex.real_smul, Complex.real_smul, map_mul, Complex.conj_ofReal]; ring

def KaiHZTestFourierUnifProp : Prop :=
  (∀ ε : ℕ, ε ≤ 1 → ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ y : ℝ, 0 < y → ∀ ξ : ℝ,
      FourierTransform.fourier
          (fun x : ℝ => (x : ℂ) ^ ε * Complex.exp (((-(Real.pi * y * x ^ 2) : ℝ) : ℂ))) ξ
        = c * ((y ^ (-((1 : ℝ) / 2 + (ε : ℝ))) : ℝ) : ℂ) * (ξ : ℂ) ^ ε *
            Complex.exp (((-(Real.pi * ξ ^ 2 / y) : ℝ) : ℂ))) ∧
  (∀ l : ℤ, ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ y : ℝ, 0 < y → ∀ w : ℂ,
      FourierTransform.fourier (fun z : ℂ => kaiHZCplxWeight l z *
          Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ))) w
        = c * ((y ^ (-(1 + |(l : ℝ)|)) : ℝ) : ℂ) * kaiHZCplxWeight l w *
            Complex.exp (((-(Real.pi * ‖w‖ ^ 2 / y) : ℝ) : ℂ)))
noncomputable def kaiHZPartialFourier {d : ℕ}
    (f : SchwartzMap (EuclideanSpace ℝ (Fin (d + 1))) ℂ)
    (ξ : EuclideanSpace ℝ (Fin d)) (t : ℝ) : ℂ :=
  ∫ x : EuclideanSpace ℝ (Fin d),
    Complex.exp (-(2 * Real.pi * Complex.I * ((inner ℝ x ξ : ℝ) : ℂ)))
      * f (WithLp.toLp 2 (Fin.snoc (WithLp.ofLp x) t))

def KaiHZLatticeSummableProp : Prop :=
  (∀ (d : ℕ) (N : ℝ), (d : ℝ) < N →
      Summable (fun m : Fin d → ℤ =>
        (1 + ‖(WithLp.toLp 2 (fun i => (m i : ℝ)) : EuclideanSpace ℝ (Fin d))‖) ^ (-N))) ∧
  (∀ (d : ℕ) (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ),
      Summable (fun m : Fin d → ℤ =>
        ‖f (WithLp.toLp 2 (fun i => (m i : ℝ)))‖)) ∧
  (∀ u : SchwartzMap ℝ ℂ, Summable (fun j : ℤ => ‖u (j : ℝ)‖))

def KaiHZPartialFourierProp : Prop :=
  ∀ (d : ℕ) (f : SchwartzMap (EuclideanSpace ℝ (Fin (d + 1))) ℂ),
    (∀ ξ : EuclideanSpace ℝ (Fin d), Continuous (kaiHZPartialFourier f ξ)) ∧
    (∃ C : ℝ, 0 ≤ C ∧ ∀ (ξ : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        ‖kaiHZPartialFourier f ξ t‖ ≤ C / (1 + |t|) ^ 2) ∧
    (∀ (ξ : EuclideanSpace ℝ (Fin d)) (τ : ℝ),
        FourierTransform.fourier (kaiHZPartialFourier f ξ) τ
          = FourierTransform.fourier (fun x => f x)
              (WithLp.toLp 2 (Fin.snoc (WithLp.ofLp ξ) τ))) ∧
    Summable (fun p : (Fin d → ℤ) × ℤ =>
        ‖kaiHZPartialFourier f
            (WithLp.toLp 2 (fun i => (p.1 i : ℝ))) ((p.2 : ℤ) : ℝ)‖)

def KaiHZStdPoissonProp : Prop :=
  ∀ (d : ℕ) (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ),
    (∑' m : Fin d → ℤ, f (WithLp.toLp 2 (fun i => (m i : ℝ))))
      = ∑' n : Fin d → ℤ,
          FourierTransform.fourier (fun x => f x)
            (WithLp.toLp 2 (fun i => (n i : ℝ)))
open scoped Classical in

noncomputable def kaiGen {K : Type u} [Field K] [NumberField K]
    (I : Ideal (NumberField.RingOfIntegers K)) : NumberField.RingOfIntegers K :=
  if h : ∃ a : NumberField.RingOfIntegers K, I = Ideal.span {a} then h.choose else 0


noncomputable def kaiInfSize (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) : ℝ :=
  1 + (∑ w : NumberField.InfinitePlace K, |t w|)
    + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)|


noncomputable def kaiPrimePsi (K : Type u) [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (α : NumberField.RingOfIntegers K)
    (S : Set (NumberField.mixedEmbedding.mixedSpace K)) : ℝ :=
  ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)


def kaiCell (K : Type u) [Field K] [NumberField K]
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ ψ χ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ) :
    Set (NumberField.mixedEmbedding.mixedSpace K) :=
  {z | (∀ w, a w < z.1 w ∧ z.1 w ≤ b w) ∧
       (∀ w, ρ w < ‖z.2 w‖ ∧ ‖z.2 w‖ ≤ σ w ∧ ψ w < (z.2 w).arg ∧ (z.2 w).arg ≤ χ w)}


noncomputable def kaiKappa0 (K : Type u) [Field K] [NumberField K] : ℝ :=
  ((NumberField.Units.torsionOrder K : ℕ) : ℝ) /
    (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
      Real.pi ^ NumberField.InfinitePlace.nrComplexPlaces K *
      (NumberField.classNumber K : ℝ) * NumberField.Units.regulator K)


noncomputable def kaiOmegaEmb {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (v : Fin ν → ℝ) :
    NumberField.mixedEmbedding.mixedSpace K :=
  ∑ j, v j • NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)
def KaiMFCongUnit (K : Type u) [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K))
    (u : (NumberField.RingOfIntegers K)ˣ) : Prop :=
  ((u : NumberField.RingOfIntegers K) - 1 ∈ q) ∧
    ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      0 < (NumberField.mixedEmbedding K (((u : NumberField.RingOfIntegers K)) : K)).1 w

noncomputable def kaiMFLogNorm (K : Type u) [Field K] [NumberField K]
    (u : NumberField.InfinitePlace K → ℝ) : ℝ :=
  ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * u w

noncomputable def kaiMFConeWeight (K : Type u) [Field K] [NumberField K]
    (z : NumberField.InfinitePlace K → ℂ) (u : NumberField.InfinitePlace K → ℝ) : ℂ :=
  Complex.exp (∑ w : NumberField.InfinitePlace K, z w * ((u w : ℝ) : ℂ))

noncomputable def kaiMFUnitShift (K : Type u) [Field K] [NumberField K]
    (v : (NumberField.RingOfIntegers K)ˣ) : NumberField.InfinitePlace K → ℝ :=
  fun w => 2 * Real.log (w (((v : NumberField.RingOfIntegers K) : K)))

noncomputable def kaiMFConeAlpha (K : Type u) [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K) : ℝ := (w.mult : ℝ) / 2

noncomputable def kaiMFConeBeta (K : Type u) [Field K] [NumberField K]
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (w : NumberField.InfinitePlace K) : ℂ :=
  ((kaiHZDeg K η l w / 2 - (⌊kaiHZDeg K η l w / 2 - 1⌋ : ℤ) : ℝ) : ℂ)
    - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)

def KaiMFHeckeContProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ A₃ : ℝ, 1 ≤ A₃ ∧
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (t : NumberField.InfinitePlace K → ℝ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q t l ξ η lam →
        (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
        ∃ (E : ℕ) (G : ℂ → ℂ) (α : NumberField.InfinitePlace K → ℝ)
          (β : NumberField.InfinitePlace K → ℂ) (Ca : ℝ),
          E ≤ 1 ∧ (E = 1 ↔ KaiHeckePrincipal K q lam) ∧
          Differentiable ℂ G ∧
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) ∧
          (∀ w : NumberField.InfinitePlace K,
              α w = (w.mult : ℝ) / 2 ∧ (1 : ℝ) / 2 ≤ α w ∧ α w ≤ 1) ∧
          (∀ w : NumberField.InfinitePlace K,
              1 ≤ (β w).re ∧ (β w).re ≤ 2 ∧
              ‖β w‖ ≤ A₃ * (1 + kaiHZInfSize K t l)) ∧
          0 < Ca ∧
          (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
              ‖G s * ∏ w : NumberField.InfinitePlace K,
                  Complex.Gamma ((α w : ℂ) * s + β w)‖
                ≤ Ca * Real.exp (Ca * (1 + |s.im|))) ∧
          (∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
              ‖G s‖ ≤ A₃ * ((Ideal.absNorm q : ℝ) * (1 + kaiHZInfSize K t l) *
                  (2 + |s.im|)) ^ A₃ *
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                  ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                    (-((3 : ℝ) / 2)))

def KaiMFConeGammaProp : Prop :=
  ∀ (d : ℕ) (a : Fin d → ℝ), (∀ i, 0 < a i) →
    ∀ z : Fin d → ℂ, (∀ i, 0 < (z i).re) →
      MeasureTheory.Integrable
          (fun u : Fin d → ℝ => ∏ i, Complex.exp (z i * ((u i : ℝ) : ℂ)
              - ((a i * Real.exp (u i) : ℝ) : ℂ)))
          (MeasureTheory.Measure.pi fun _ => MeasureTheory.volume) ∧
      (∫ u : Fin d → ℝ, ∏ i, Complex.exp (z i * ((u i : ℝ) : ℂ)
            - ((a i * Real.exp (u i) : ℝ) : ℂ))
          ∂(MeasureTheory.Measure.pi fun _ => MeasureTheory.volume))
        = ∏ i, (Complex.Gamma (z i) * ((a i : ℝ) : ℂ) ^ (-(z i)))

def KaiMFConeFundDomProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
    ∃ (Λ : AddSubgroup (NumberField.InfinitePlace K → ℝ))
      (F : Set (NumberField.InfinitePlace K → ℝ)) (c : ℝ) (wq : ℕ),
      0 < wq ∧ 1 ≤ c ∧ Countable ↥Λ ∧ MeasurableSet F ∧
      MeasureTheory.IsAddFundamentalDomain (↥Λ) F MeasureTheory.volume ∧
      (∀ γ ∈ Λ, kaiMFLogNorm K γ = 0) ∧
      (∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v →
          kaiMFUnitShift K v ∈ Λ) ∧
      (∀ γ : NumberField.InfinitePlace K → ℝ, γ ∈ Λ →
          Nat.card {v : (NumberField.RingOfIntegers K)ˣ //
            KaiMFCongUnit K q v ∧ kaiMFUnitShift K v = γ} = wq) ∧
      (∀ u ∈ F, ∀ w : NumberField.InfinitePlace K,
          |u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)| ≤ c) ∧
      (∀ (u : NumberField.InfinitePlace K → ℝ) (r : ℝ),
          u ∈ F ↔ (fun w => u w + r) ∈ F)

def KaiMFRayClassProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ Cq : ℝ, 1 ≤ Cq ∧
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∃ (M hh : ℕ) (b : Fin M → Ideal (NumberField.RingOfIntegers K))
        (ρ : Fin M → NumberField.RingOfIntegers K)
        (Gen : Fin M → Set (NumberField.RingOfIntegers K)),
        0 < M ∧ 0 < hh ∧
        (M : ℝ) ≤ Cq * (Ideal.absNorm q : ℝ) ^ Cq ∧
        (∀ k, b k ≠ 0 ∧ b k ⊔ q = ⊤ ∧ ρ k ≠ 0 ∧ ρ k ∈ b k ∧ ρ k - 1 ∈ q ∧
            (Ideal.absNorm (b k) : ℝ) ≤ Cq * (Ideal.absNorm q : ℝ) ^ Cq) ∧
        (∀ k, ∀ μ ∈ Gen k, μ ≠ 0 ∧ μ - ρ k ∈ q * b k) ∧
        (∀ k, ∀ μ : NumberField.RingOfIntegers K, μ ≠ 0 → μ - ρ k ∈ q * b k →
            ∃! p : {ν // ν ∈ Gen k} ×
                   {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
              μ = ((p.2 : (NumberField.RingOfIntegers K)ˣ) :
                    NumberField.RingOfIntegers K) * (p.1 : NumberField.RingOfIntegers K)) ∧
        (∀ k, ∀ μ ∈ Gen k, ∃ I : Ideal (NumberField.RingOfIntegers K),
            I ≠ 0 ∧ I ⊔ q = ⊤ ∧ Ideal.span {μ} = I * b k) ∧
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
            Nat.card {p : (k : Fin M) × {μ // μ ∈ Gen k} //
              Ideal.span {(p.2 : NumberField.RingOfIntegers K)} = I * b p.1} = hh) ∧
        (∀ f : Ideal (NumberField.RingOfIntegers K) → ℂ,
            (∀ I J, f (I * J) = f I * f J) →
            (∀ I, I ≠ 0 → I ⊔ q = ⊤ → ‖f I‖ = 1) →
            (∀ I, I ⊔ q ≠ ⊤ → f I = 0) →
            (∀ γ : NumberField.RingOfIntegers K, γ ≠ 0 → γ - 1 ∈ q →
                f (Ideal.span {γ}) = 1) →
            (¬ ∀ I, I ≠ 0 → I ⊔ q = ⊤ → f I = 1) →
            (∑ k : Fin M, f (b k)) = 0)

def KaiMFConeTailProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∀ (Θ : (NumberField.InfinitePlace K → ℝ) → ℂ) (δ : ℂ)
    (F : Set (NumberField.InfinitePlace K → ℝ)) (θ₀ c e₀ : ℝ),
    MeasurableSet F → 1 ≤ c → 0 < e₀ → Measurable Θ →
    (∀ u ∈ F, ∀ w : NumberField.InfinitePlace K,
        |u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)| ≤ c) →
    (∀ u ∈ F, θ₀ ≤ kaiMFLogNorm K u →
        ‖Θ u - δ‖ ≤ e₀⁻¹ * Real.exp (-(e₀ *
          Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ))))) →
    ∃ Ct : ℝ, 0 < Ct ∧
      Differentiable ℂ (fun s : ℂ =>
        ∫ u in F ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
          (Θ u - δ) * kaiMFConeWeight K (fun w => (kaiMFConeAlpha K w : ℂ) * s) u) ∧
      (∀ s : ℂ, -4 ≤ s.re → s.re ≤ 5 →
        ‖∫ u in F ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
          (Θ u - δ) * kaiMFConeWeight K
            (fun w => (kaiMFConeAlpha K w : ℂ) * s) u‖ ≤ Ct)

def KaiMFIdealThetaSharpProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ B : ℝ, 1 ≤ B ∧
    ∀ a : Ideal (NumberField.RingOfIntegers K), a ≠ 0 →
      ∀ (ρ : NumberField.mixedEmbedding.mixedSpace K)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
        (∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
            Summable (fun μ : ↥a =>
              ‖kaiHZArchWeight K η l (ρ +
                  NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K))‖ *
                kaiHZGaussian K y (ρ +
                  NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K)))) ∧
        ∃ (b : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
          (v : NumberField.mixedEmbedding.mixedSpace K) (κ : ℂ)
          (r : NumberField.InfinitePlace K → ℝ),
          (∀ w, 0 < r w) ∧ (∀ w, 1 / B ≤ r w ∧ r w ≤ B) ∧
          ((FractionalIdeal.absNorm
              (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℚ) : ℝ)
            ≤ B * (Ideal.absNorm a : ℝ) ^ B ∧
          (1 : ℝ) / (B * (Ideal.absNorm a : ℝ) ^ B)
            ≤ ((FractionalIdeal.absNorm
