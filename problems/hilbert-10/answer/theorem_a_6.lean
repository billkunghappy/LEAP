  have hfibapp : ∀ ζ, fib ζ = (S ×ˢ S).filter (fun p => δ p = ζ) := by intro ζ; rw [hfib]
  have hmemfib : ∀ ζ p, p ∈ fib ζ ↔ p ∈ S ×ˢ S ∧ δ p = ζ := by
    intro ζ p; rw [hfibapp, Finset.mem_filter]
  have hmemS : ∀ m, m ∈ S ↔ ∀ k, m k < R := by
    intro m; simp [hS, Fintype.mem_piFinset]
  have hmaps : ∀ p ∈ S ×ˢ S, δ p ∈ T := by
    intro p hp
    rw [Finset.mem_product, hmemS, hmemS] at hp
    rw [hT, Fintype.mem_piFinset]; intro k; rw [Finset.mem_Icc, hδapp]
