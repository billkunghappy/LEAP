      _ = (Module.finrank ℚ K : ℝ) * Real.log (C * M) := Real.log_pow _ _
      _ ≤ (Module.finrank ℚ K : ℝ) * (2 * ℓ) :=
          mul_le_mul_of_nonneg_left hlogCM (by linarith)
      _ = 2 * (Module.finrank ℚ K : ℝ) * ℓ := by ring
  have hlogN0 : 0 ≤ Real.log (Nmax : ℝ) := Real.log_nonneg hNmaxR
  obtain ⟨U, hU_def⟩ : ∃ U : ℝ, U = M ^ ((Module.finrank ℚ K : ℝ) / 4) := ⟨_, rfl⟩
  have hUexp : U = Real.exp (ℓ * ((Module.finrank ℚ K : ℝ) / 4)) := by
    rw [hU_def, Real.rpow_def_of_pos hMpos, ← hℓ]
  have hU1 : 1 < U := by
    rw [hUexp]
    have h1 := Real.add_one_le_exp (ℓ * ((Module.finrank ℚ K : ℝ) / 4))
    have h2 : 0 < ℓ * ((Module.finrank ℚ K : ℝ) / 4) := mul_pos (by linarith) (by linarith)
    linarith
  have hUU1 : 1 ≤ U * U := one_le_mul_of_one_le_of_one_le hU1.le hU1.le
  have hlogU : Real.log U = ℓ * ((Module.finrank ℚ K : ℝ) / 4) := by rw [hUexp, Real.log_exp]
  have hUU : U * U = Real.exp (ℓ * ((Module.finrank ℚ K : ℝ) / 2)) := by
    rw [hUexp, ← Real.exp_add]; congr 1; ring
  have hlogUU : Real.log (U * U) = ℓ * ((Module.finrank ℚ K : ℝ) / 2) := by
    rw [hUU, Real.log_exp]
  have hUU34 : U * U ≤ M ^ ((3 * (Module.finrank ℚ K : ℝ)) / 4) := by
    rw [hUU, Real.rpow_def_of_pos hMpos, ← hℓ]
    apply Real.exp_le_exp.mpr
    apply mul_le_mul_of_nonneg_left _ hℓ0
    linarith
  have hnl : 0 ≤ ((Module.finrank ℚ K : ℝ) - 1) * ℓ := mul_nonneg (by linarith) hℓ0
  have hUB : U ≤ Bc * Real.exp (-(ℓ / 2)) := by
    rw [hUexp]
    have hsp : ℓ * ((Module.finrank ℚ K : ℝ) / 4)
        = (Module.finrank ℚ K : ℝ) * ℓ
          + (ℓ * ((Module.finrank ℚ K : ℝ) / 4) - (Module.finrank ℚ K : ℝ) * ℓ) := by ring
    rw [hsp, Real.exp_add]
    apply mul_le_mul hBexp _ (Real.exp_pos _).le hB0
    apply Real.exp_le_exp.mpr
    linarith
  have hUUB : U * U ≤ Bc * Real.exp (-(ℓ / 2)) := by
    rw [hUU]
    have hsp : ℓ * ((Module.finrank ℚ K : ℝ) / 2)
        = (Module.finrank ℚ K : ℝ) * ℓ
          + (ℓ * ((Module.finrank ℚ K : ℝ) / 2) - (Module.finrank ℚ K : ℝ) * ℓ) := by ring
    rw [hsp, Real.exp_add]
    apply mul_le_mul hBexp _ (Real.exp_pos _).le hB0
    apply Real.exp_le_exp.mpr
    linarith
  
  obtain ⟨D, hD_def⟩ : ∃ D : Finset (Ideal (NumberField.RingOfIntegers K)),
      D = (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Nmax).toFinset.filter
        (fun 𝔡 => 𝔡 ≠ ⊥) := ⟨_, rfl⟩
  have hmemD : ∀ 𝔡, 𝔡 ∈ D ↔ Ideal.absNorm 𝔡 ≤ Nmax ∧ 𝔡 ≠ ⊥ := by
    intro 𝔡; rw [hD_def, Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  have hDne : ∀ 𝔡 ∈ D, 𝔡 ≠ ⊥ := fun 𝔡 h => ((hmemD 𝔡).1 h).2
  have hDN1 : ∀ 𝔡 ∈ D, (1 : ℝ) ≤ (Ideal.absNorm 𝔡 : ℝ) := by
    intro 𝔡 h
    have h0 : Ideal.absNorm 𝔡 ≠ 0 := fun h0 => hDne 𝔡 h (Ideal.absNorm_eq_zero_iff.mp h0)
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr h0
