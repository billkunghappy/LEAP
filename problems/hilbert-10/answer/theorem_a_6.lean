    obtain ⟨Z, mult, h1, h2, h3, -, h5⟩ :=
      hLan G s₁ 1 (Real.exp (A₂ * L)) hG one_pos hM3 hG1 hball
    refine ⟨Z, mult, h1, h2, h3, ?_⟩
    intro s hs hGs
