      have s4 : |F (max (Ep * v) (max (Em * u) T)) - F (max (Em * u) T)
          - max (F (max Ep T) - F (max Em T)) 0| ≤ 16 * Δ * Xn := by
        have hua : max (Em * u) T ≤ u * max Em T := by
          refine max_le ?_ ?_
          · have := mul_le_mul_of_nonneg_left hEma (by linarith : (0 : ℝ) ≤ u)
