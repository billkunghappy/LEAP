        _ = CW / cA ^ cW / Real.log M ^ B := by
            field_simp

theorem kai_gowers_uniformity (K : Type u) [Field K] [NumberField K] :
    ∃ ρ : ℝ, 0 < ρ ∧
      ∀ (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ
            (NumberField.RingOfIntegers K)),
        IsNormLengthCompatible C ω → ∀ B : ℕ, ∃ C_B : ℝ, 0 ≤ C_B ∧
          ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
            Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
            (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
            gowersU3Pow ω (fun x => vonMangoldtO x - cramerModel K ρ (primorial m) x) M
              ≤ C_B / Real.log M ^ B :=
by
  classical
  
  have hmono : ∀ (ν : ℕ) (D D' Q Q' : ℝ) (φ : (Fin ν → ℤ) → ℝ), D ≤ D' → Q ≤ Q' →
      IsNil2Seq ν D Q φ → IsNil2Seq ν D' Q' φ := by
    intro ν D D' Q Q' φ hD hQ h
    obtain ⟨a, b, Bc, p₀, p₁, r₀, r₁, r₂, F, h1, h2, h3, h4, h5, h6⟩ := h
    refine ⟨a, b, Bc, p₀, p₁, r₀, r₁, r₂, F, h1.trans hD, fun i j k => (h2 i j k).trans hQ,
      h3, h4, ?_, h6⟩
    intro u v hu1 hu2 hv1 hv2
    refine (h5 u v hu1 hu2 hv1 hv2).trans ?_
    apply mul_le_mul_of_nonneg_right hQ
    exact add_nonneg (Finset.sum_nonneg (fun i _ => abs_nonneg _))
      (Finset.sum_nonneg (fun i _ => abs_nonneg _))
  obtain ⟨ρ, hρ, hs4⟩ := kai_siegel_model_package K
  refine ⟨ρ, hρ, ?_⟩
  intro C ω hω B
  obtain ⟨c, C₀, C'B, k, hc, hC₀, hC'B, hS⟩ := hs4 C ω hω B
  obtain ⟨Cinv, -, hInv⟩ := gowers_U3_inverse_quasipoly K ω
  obtain ⟨A, hA_def⟩ : ∃ A : ℝ, A = (B : ℝ) + 8 * ((k : ℝ) + 1) := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hA_def]; positivity
  obtain ⟨M₀, hM₀3, hM₀⟩ := eventual_loglog_power_le c A (Real.log C₀ + 1) Cinv hc hA0
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hlogC : 0 < Real.log C := Real.log_pos hC1
  have hlog3 : 1 < Real.log 3 := by
    rw [Real.lt_log_iff_exp_lt (by norm_num)]
    have := Real.exp_one_lt_d9
    linarith
  have hlogC₀ : 0 ≤ Real.log C₀ := Real.log_nonneg hC₀
  obtain ⟨n, hn_def⟩ : ∃ n : ℕ, n = Module.finrank ℚ K := ⟨_, rfl⟩
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = (n : ℝ) * (Real.log C / Real.log 3 + 1) := ⟨_, rfl⟩
  have ha0 : 0 ≤ a := by
    rw [ha_def]
    exact mul_nonneg (Nat.cast_nonneg _)
      (by have := div_nonneg hlogC.le (by linarith : (0:ℝ) ≤ Real.log 3); linarith)
  obtain ⟨CT, hCT_def⟩ : ∃ CT : ℝ, CT = C₀ + a := ⟨_, rfl⟩
  have hCT1 : 1 ≤ CT := by rw [hCT_def]; linarith
  have hCT0 : 0 ≤ CT := by linarith
  have hM₀pos : 0 < M₀ := by linarith
  obtain ⟨L₀, hL₀_def⟩ : ∃ L₀ : ℝ, L₀ = Real.log M₀ ^ (8 * (k + 1) + B) := ⟨_, rfl⟩
  have hlogM₀ : 0 ≤ Real.log M₀ := Real.log_nonneg (by linarith)
  have hL₀ : 0 ≤ L₀ := by rw [hL₀_def]; exact pow_nonneg hlogM₀ _
  obtain ⟨KD, hKD_def⟩ : ∃ KD : ℝ, KD = CT ^ 8 * (1 + 27 ^ n * L₀) := ⟨_, rfl⟩
  have hKD : 0 ≤ KD := by rw [hKD_def]; positivity
  refine ⟨128 * (KD + C'B), by positivity, ?_⟩
  intro M m hM hm₁ hm₂
  obtain ⟨g, hga, hgb, hgc⟩ := hS M m hM hm₁ hm₂
  
  have hMpos : 0 < M := by linarith
  obtain ⟨ℓ, hℓ_def⟩ : ∃ ℓ : ℝ, ℓ = Real.log M := ⟨_, rfl⟩
  have hℓ3 : Real.log 3 ≤ ℓ := by rw [hℓ_def]; exact Real.log_le_log (by norm_num) hM
  have hℓ1 : 1 ≤ ℓ := by linarith
  have hℓpos : 0 < ℓ := by linarith
  rw [← hℓ_def] at hga hgb hgc ⊢
  have hℓB : 0 < ℓ ^ B := pow_pos hℓpos B
  have hℓk1 : 1 ≤ ℓ ^ (k + 1) := one_le_pow₀ hℓ1
  obtain ⟨T, hT_def⟩ : ∃ T : ℝ, T = CT * ℓ ^ (k + 1) := ⟨_, rfl⟩
  have hT1 : 1 ≤ T := by rw [hT_def]; exact one_le_mul_of_one_le_of_one_le hCT1 hℓk1
  have hTpos : 0 < T := by linarith
  obtain ⟨D, hD_def⟩ : ∃ D : NumberField.RingOfIntegers K → ℝ,
      D = fun x => vonMangoldtO x - g x := ⟨_, rfl⟩
  obtain ⟨E, hE_def⟩ : ∃ E : NumberField.RingOfIntegers K → ℝ,
      E = fun x => g x - cramerModel K ρ (primorial m) x := ⟨_, rfl⟩
  have hsplit : (fun x => vonMangoldtO x - cramerModel K ρ (primorial m) x)
      = fun x => D x + E x := by
    funext x; rw [hD_def, hE_def]; ring
  
  have hP : ∀ x ∈ omegaBox ω M, |D x| ≤ T := by
    intro x hx
    obtain ⟨h0, h1⟩ := kai_vonMangoldt_omegaBox_bound K C ω hω M (by linarith) x hx
    have hn' : ((Module.finrank ℚ K : ℕ) : ℝ) = (n : ℝ) := by rw [hn_def]
    rw [hn', Real.log_mul hCpos.ne' hMpos.ne', ← hℓ_def] at h1
    have hlc : Real.log C ≤ Real.log C / Real.log 3 * ℓ := by
      have h3 : Real.log C / Real.log 3 * Real.log 3 = Real.log C :=
        div_mul_cancel₀ _ (by linarith)
      have h4 : Real.log C / Real.log 3 * Real.log 3 ≤ Real.log C / Real.log 3 * ℓ :=
        mul_le_mul_of_nonneg_left hℓ3 (div_nonneg hlogC.le (by linarith))
      linarith
    have hΛ1 : vonMangoldtO x ≤ a * ℓ := by
      calc vonMangoldtO x ≤ (n : ℝ) * (Real.log C + ℓ) := h1
        _ ≤ (n : ℝ) * (Real.log C / Real.log 3 * ℓ + ℓ) :=
            mul_le_mul_of_nonneg_left (by linarith) (Nat.cast_nonneg _)
        _ = a * ℓ := by rw [ha_def]; ring
    have hℓle : ℓ ≤ ℓ ^ (k + 1) := le_self_pow₀ hℓ1 (by omega)
    have hΛ2 : vonMangoldtO x ≤ a * ℓ ^ (k + 1) :=
      hΛ1.trans (mul_le_mul_of_nonneg_left hℓle ha0)
    have hg1 : |g x| ≤ C₀ * ℓ ^ (k + 1) :=
      (hga x hx).trans (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hℓ1 (by omega))
        (by linarith))
    have hg2 := abs_le.mp hg1
    have hTe : T = C₀ * ℓ ^ (k + 1) + a * ℓ ^ (k + 1) := by rw [hT_def, hCT_def]; ring
    rw [hD_def]
    show |vonMangoldtO x - g x| ≤ T
    rw [abs_le]
    constructor <;> linarith [hg2.1, hg2.2]
  obtain ⟨hscale, hsup⟩ := gowersU3Pow_smul_sup ω D M
  
  have hDbd : gowersU3Pow ω D M ≤ KD / ℓ ^ B := by
    by_cases hbig : M₀ ≤ M
    · 
      obtain ⟨Eexp, hEexp_def⟩ : ∃ Eexp : ℕ, Eexp = B + 8 * (k + 1) := ⟨_, rfl⟩
      obtain ⟨δ, hδ_def⟩ : ∃ δ : ℝ, δ = 1 / ℓ ^ Eexp := ⟨_, rfl⟩
      have hℓE : 1 ≤ ℓ ^ Eexp := one_le_pow₀ hℓ1
      have hδpos : 0 < δ := by rw [hδ_def]; positivity
      have hδ1 : δ ≤ 1 := by rw [hδ_def]; exact div_le_one_of_le₀ hℓE (by linarith)
      obtain ⟨Λδ, hΛδ_def⟩ : ∃ Λδ : ℝ, Λδ = 1 + A * Real.log ℓ := ⟨_, rfl⟩
      have hlogδ : 1 + Real.log (1 / δ) = Λδ := by
        rw [hΛδ_def, hδ_def, one_div_one_div, Real.log_pow, hEexp_def, hA_def]
        push_cast; ring
      have hs5 := hM₀ M hbig
      rw [← hℓ_def, ← hΛδ_def] at hs5
      obtain ⟨f', hf'_def⟩ : ∃ f' : NumberField.RingOfIntegers K → ℝ,
          f' = fun x => T⁻¹ * D x := ⟨_, rfl⟩
      have hf'bd : ∀ x ∈ omegaBox ω M, |f' x| ≤ 1 := by
        intro x hx
        rw [hf'_def]
        show |T⁻¹ * D x| ≤ 1
        rw [abs_mul, abs_of_pos (inv_pos.mpr hTpos)]
        calc T⁻¹ * |D x| ≤ T⁻¹ * T := mul_le_mul_of_nonneg_left (hP x hx) (by positivity)
          _ = 1 := inv_mul_cancel₀ hTpos.ne'
      have hcardpos : (0 : ℝ) < ((omegaBox ω M).card : ℝ) := by
        have hne : (intBox (Module.finrank ℚ K) ⌊M⌋₊).Nonempty := by
          unfold intBox
          apply Finset.nonempty_Icc.mpr
          intro i
          simp only
          omega
        have : (omegaBox ω M).Nonempty := by
          unfold omegaBox
          exact hne.image _
        exact_mod_cast this.card_pos
      have hlt : gowersU3Pow ω f' M < δ := by
        by_contra hcon
        push_neg at hcon
        obtain ⟨φ, hφnil, hφcor⟩ := hInv M δ f' (by linarith) hδpos hδ1 hf'bd hcon
        rw [hlogδ] at hφnil hφcor
        have hΛδc : Λδ ^ Cinv ≤ ℓ ^ c := by linarith
        have hφnil' : IsNil2Seq (Module.finrank ℚ K) (ℓ ^ c) (Real.exp (ℓ ^ c)) φ :=
          hmono _ _ _ _ _ φ hΛδc (Real.exp_le_exp.mpr hΛδc) hφnil
        have hc' := hgc φ hφnil'
        have hsum : ∑ x ∈ omegaBox ω M, f' x * φ (ω.equivFun x)
            = T⁻¹ * ∑ x ∈ omegaBox ω M, (vonMangoldtO x - g x) * φ (ω.equivFun x) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun x _ => ?_)
          rw [hf'_def, hD_def]
          ring
        rw [hsum, abs_mul, abs_of_pos (inv_pos.mpr hTpos)] at hφcor
        have hTinv : T⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hT1
        have hS0 : 0 ≤ |∑ x ∈ omegaBox ω M, (vonMangoldtO x - g x) * φ (ω.equivFun x)| :=
          abs_nonneg _
        have h1 : Real.exp (-(Λδ ^ Cinv)) * ((omegaBox ω M).card : ℝ)
            ≤ C₀ * ((omegaBox ω M).card : ℝ) * Real.exp (-(ℓ ^ c)) := by
          refine hφcor.trans ?_
          refine le_trans ?_ hc'
          calc T⁻¹ * |∑ x ∈ omegaBox ω M, (vonMangoldtO x - g x) * φ (ω.equivFun x)|
              ≤ 1 * |∑ x ∈ omegaBox ω M, (vonMangoldtO x - g x) * φ (ω.equivFun x)| :=
                mul_le_mul_of_nonneg_right hTinv hS0
            _ = _ := one_mul _
        have h2 : Real.exp (-(Λδ ^ Cinv)) ≤ C₀ * Real.exp (-(ℓ ^ c)) := by
          have h3 : Real.exp (-(Λδ ^ Cinv)) * ((omegaBox ω M).card : ℝ)
              ≤ (C₀ * Real.exp (-(ℓ ^ c))) * ((omegaBox ω M).card : ℝ) := by
            calc _ ≤ _ := h1
              _ = _ := by ring
          exact le_of_mul_le_mul_right h3 hcardpos
        have h4 : C₀ * Real.exp (-(ℓ ^ c)) = Real.exp (Real.log C₀ - ℓ ^ c) := by
          rw [Real.exp_sub, Real.exp_log (by linarith), Real.exp_neg, div_eq_mul_inv]
        rw [h4, Real.exp_le_exp] at h2
        linarith
      have hsc := hscale T⁻¹
      rw [← hf'_def] at hsc
      have hDeq : gowersU3Pow ω D M = T ^ 8 * gowersU3Pow ω f' M := by
        rw [hsc, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ hTpos.ne', one_pow, one_mul]
      have hT8 : 0 < T ^ 8 := pow_pos hTpos 8
      have hTδ : T ^ 8 * δ = CT ^ 8 / ℓ ^ B := by
        have hX : 0 < (ℓ ^ (k + 1)) ^ 8 := by positivity
        have hpw : ℓ ^ (B + 8 * (k + 1)) = ℓ ^ B * (ℓ ^ (k + 1)) ^ 8 := by
          rw [pow_add ℓ B, ← pow_mul, mul_comm (k + 1) 8]
        rw [hT_def, hδ_def, hEexp_def, hpw, mul_pow]
        field_simp
        try ring
      calc gowersU3Pow ω D M = T ^ 8 * gowersU3Pow ω f' M := hDeq
        _ ≤ T ^ 8 * δ := mul_le_mul_of_nonneg_left hlt.le hT8.le
        _ = CT ^ 8 / ℓ ^ B := hTδ
        _ ≤ KD / ℓ ^ B := by
            apply div_le_div_of_nonneg_right _ hℓB.le
            rw [hKD_def]
            have : 0 ≤ CT ^ 8 * (27 ^ n * L₀) := by positivity
            nlinarith
    · 
      push_neg at hbig
      have h1 := hsup T hTpos.le hP
      have h27n : (27 : ℝ) ^ Module.finrank ℚ K = 27 ^ n := by rw [hn_def]
      rw [h27n] at h1
      have hℓM₀ : ℓ ≤ Real.log M₀ := by rw [hℓ_def]; exact Real.log_le_log hMpos hbig.le
      have hpow : ℓ ^ (8 * (k + 1) + B) ≤ L₀ := by
        rw [hL₀_def]; exact pow_le_pow_left₀ hℓpos.le hℓM₀ _
      have hT8 : T ^ 8 = CT ^ 8 * ℓ ^ (8 * (k + 1)) := by
        rw [hT_def, mul_pow, ← pow_mul]; ring_nf
      rw [le_div_iff₀ hℓB]
      calc gowersU3Pow ω D M * ℓ ^ B ≤ (27 ^ n * T ^ 8) * ℓ ^ B :=
            mul_le_mul_of_nonneg_right h1 hℓB.le
        _ = 27 ^ n * CT ^ 8 * ℓ ^ (8 * (k + 1) + B) := by rw [hT8, pow_add]; ring
        _ ≤ 27 ^ n * CT ^ 8 * L₀ :=
            mul_le_mul_of_nonneg_left hpow (by positivity)
        _ ≤ KD := by
            rw [hKD_def]
            have : 0 ≤ CT ^ 8 := by positivity
            nlinarith
  
  have hEbd : gowersU3Pow ω E M ≤ C'B / ℓ ^ B := by rw [hE_def]; exact hgb
  rw [hsplit]
  have htri := (gowersU3Pow_nonneg_add_le ω D E M).2
  calc gowersU3Pow ω (fun x => D x + E x) M
      ≤ 128 * (gowersU3Pow ω D M + gowersU3Pow ω E M) := htri
    _ ≤ 128 * (KD / ℓ ^ B + C'B / ℓ ^ B) := by linarith
    _ = 128 * (KD + C'B) / ℓ ^ B := by ring

theorem box_cs_three {α β γ : Type*} (X : Finset α) (Y : Finset β) (Z : Finset γ)
    (f : α → β → γ → ℝ) (A : β → γ → ℂ) (B : α → γ → ℂ) (C : α → β → ℂ)
    (hA : ∀ y z, ‖A y z‖ ≤ 1) (hB : ∀ x z, ‖B x z‖ ≤ 1) (hC : ∀ x y, ‖C x y‖ ≤ 1) :
    ‖∑ x ∈ X, ∑ y ∈ Y, ∑ z ∈ Z, (f x y z : ℂ) * A y z * B x z * C x y‖ ^ 8 ≤
      ((X.card : ℝ) * Y.card * Z.card) ^ 6 *
        ∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ y' ∈ Y, ∑ z ∈ Z, ∑ z' ∈ Z,
          f x y z * f x' y z * f x y' z * f x' y' z *
            f x y z' * f x' y z' * f x y' z' * f x' y' z' :=
by
  classical
  
  have cs2 : ∀ t : β → γ → ℝ, (∑ y ∈ Y, ∑ z ∈ Z, t y z) ^ 2 ≤
      ((Y.card : ℝ) * Z.card) * ∑ y ∈ Y, ∑ z ∈ Z, t y z ^ 2 := by
    intro t
    have h := sq_sum_le_card_mul_sum_sq (s := Y ×ˢ Z) (f := fun p => t p.1 p.2)
    simp only [Finset.sum_product, Finset.card_product, Nat.cast_mul] at h
    exact h
  have cs3 : ∀ t : α → α → γ → ℝ, (∑ x ∈ X, ∑ x' ∈ X, ∑ z ∈ Z, t x x' z) ^ 2 ≤
      ((X.card : ℝ) * X.card * Z.card) * ∑ x ∈ X, ∑ x' ∈ X, ∑ z ∈ Z, t x x' z ^ 2 := by
    intro t
    have h := sq_sum_le_card_mul_sum_sq (s := (X ×ˢ X) ×ˢ Z)
      (f := fun p => t p.1.1 p.1.2 p.2)
    simp only [Finset.sum_product, Finset.card_product, Nat.cast_mul] at h
    exact h
  have cs4 : ∀ t : α → α → β → β → ℝ,
      (∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ y' ∈ Y, t x x' y y') ^ 2 ≤
      ((X.card : ℝ) * X.card * Y.card * Y.card) *
        ∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ y' ∈ Y, t x x' y y' ^ 2 := by
    intro t
    have h := sq_sum_le_card_mul_sum_sq (s := ((X ×ˢ X) ×ˢ Y) ×ˢ Y)
      (f := fun p => t p.1.1.1 p.1.1.2 p.1.2 p.2)
    simp only [Finset.sum_product, Finset.card_product, Nat.cast_mul] at h
    exact h
  
  have nsq : ∀ w : ℂ, (((‖w‖ ^ 2 : ℝ)) : ℂ) = w * (starRingEnd ℂ) w := by
    intro w; rw [Complex.mul_conj']; push_cast; ring
  
  set S := ∑ x ∈ X, ∑ y ∈ Y, ∑ z ∈ Z, (f x y z : ℂ) * A y z * B x z * C x y with hS
  obtain ⟨v, hv⟩ : ∃ v : β → γ → ℂ, v = fun y z => ∑ x ∈ X, (f x y z : ℂ) * B x z * C x y :=
    ⟨_, rfl⟩
  have eS : S = ∑ y ∈ Y, ∑ z ∈ Z, A y z * v y z := by
    rw [hS, Finset.sum_comm]
    refine Finset.sum_congr rfl fun y _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun z _ => ?_
    simp only [hv]
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun x _ => by ring
  obtain ⟨Q1, hQ1⟩ : ∃ Q1 : ℝ, Q1 = ∑ y ∈ Y, ∑ z ∈ Z, ‖v y z‖ ^ 2 := ⟨_, rfl⟩
  have h1 : ‖S‖ ^ 2 ≤ ((Y.card : ℝ) * Z.card) * Q1 := by
    have n1 : ‖S‖ ≤ ∑ y ∈ Y, ∑ z ∈ Z, ‖v y z‖ := by
      rw [eS]
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun y _ => ?_)
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun z _ => ?_)
      rw [norm_mul]
      exact mul_le_of_le_one_left (norm_nonneg _) (hA y z)
    rw [hQ1]
    exact (pow_le_pow_left₀ (norm_nonneg _) n1 2).trans (cs2 (fun y z => ‖v y z‖))
  
  obtain ⟨u, hu⟩ : ∃ u : α → α → γ → ℂ, u = fun x x' z =>
      ∑ y ∈ Y, (f x y z : ℂ) * f x' y z * C x y * starRingEnd ℂ (C x' y) := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : α → α → β → γ → ℂ, P = fun x x' y z =>
      (f x y z : ℂ) * B x z * C x y * ((f x' y z : ℂ) * starRingEnd ℂ (B x' z) *
        starRingEnd ℂ (C x' y)) := ⟨_, rfl⟩
  have eQ1 : (Q1 : ℂ) = ∑ x ∈ X, ∑ x' ∈ X, ∑ z ∈ Z,
      B x z * starRingEnd ℂ (B x' z) * u x x' z := by
    have hL : ∀ y z, (((‖v y z‖ ^ 2 : ℝ)) : ℂ) = ∑ x ∈ X, ∑ x' ∈ X, P x x' y z := by
      intro y z
      rw [nsq]
      simp only [hv]
      rw [map_sum, Finset.sum_mul_sum]
      refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun x' _ => ?_
      simp only [hP, map_mul, Complex.conj_ofReal]
    have hR : ∀ x x' z, B x z * starRingEnd ℂ (B x' z) * u x x' z = ∑ y ∈ Y, P x x' y z := by
      intro x x' z
      simp only [hu]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun y _ => ?_
      simp only [hP]; ring
    rw [hQ1]
    simp only [Complex.ofReal_sum, hL, hR]
    calc ∑ y ∈ Y, ∑ z ∈ Z, ∑ x ∈ X, ∑ x' ∈ X, P x x' y z
        = ∑ y ∈ Y, ∑ x ∈ X, ∑ z ∈ Z, ∑ x' ∈ X, P x x' y z :=
          Finset.sum_congr rfl fun y _ => Finset.sum_comm
      _ = ∑ y ∈ Y, ∑ x ∈ X, ∑ x' ∈ X, ∑ z ∈ Z, P x x' y z :=
          Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x _ => Finset.sum_comm
      _ = ∑ x ∈ X, ∑ y ∈ Y, ∑ x' ∈ X, ∑ z ∈ Z, P x x' y z := Finset.sum_comm
      _ = ∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ z ∈ Z, P x x' y z :=
          Finset.sum_congr rfl fun x _ => Finset.sum_comm
      _ = ∑ x ∈ X, ∑ x' ∈ X, ∑ z ∈ Z, ∑ y ∈ Y, P x x' y z :=
          Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun x' _ => Finset.sum_comm
  have hQ1nn : 0 ≤ Q1 := by
    rw [hQ1]; exact Finset.sum_nonneg fun y _ => Finset.sum_nonneg fun z _ => by positivity
  obtain ⟨Q2, hQ2⟩ : ∃ Q2 : ℝ, Q2 = ∑ x ∈ X, ∑ x' ∈ X, ∑ z ∈ Z, ‖u x x' z‖ ^ 2 := ⟨_, rfl⟩
  have h2 : Q1 ^ 2 ≤ ((X.card : ℝ) ^ 2 * Z.card) * Q2 := by
    have n2 : Q1 ≤ ∑ x ∈ X, ∑ x' ∈ X, ∑ z ∈ Z, ‖u x x' z‖ := by
      have e : Q1 = ‖(Q1 : ℂ)‖ := by
        rw [Complex.norm_real, Real.norm_of_nonneg hQ1nn]
      rw [e, eQ1]
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => ?_)
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun x' _ => ?_)
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun z _ => ?_)
      rw [norm_mul, norm_mul, Complex.norm_conj]
      have hb : ‖B x z‖ * ‖B x' z‖ ≤ 1 := mul_le_one₀ (hB x z) (norm_nonneg _) (hB x' z)
      exact mul_le_of_le_one_left (norm_nonneg _) hb
    have h := (pow_le_pow_left₀ hQ1nn n2 2).trans (cs3 (fun x x' z => ‖u x x' z‖))
    rw [hQ2]
    calc Q1 ^ 2 ≤ _ := h
      _ = _ := by ring
  
  obtain ⟨g, hg⟩ : ∃ g : α → α → β → β → γ → ℝ, g = fun x x' y y' z =>
      f x y z * f x' y z * f x y' z * f x' y' z := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : α → α → β → β → ℂ, W = fun x x' y y' =>
      C x y * starRingEnd ℂ (C x' y) * starRingEnd ℂ (C x y') * C x' y' := ⟨_, rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : α → α → β → β → ℝ, G = fun x x' y y' => ∑ z ∈ Z, g x x' y y' z :=
    ⟨_, rfl⟩
  have eQ2 : (Q2 : ℂ) = ∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ y' ∈ Y,
      W x x' y y' * ((G x x' y y' : ℝ) : ℂ) := by
    have hL : ∀ x x' z, (((‖u x x' z‖ ^ 2 : ℝ)) : ℂ) =
        ∑ y ∈ Y, ∑ y' ∈ Y, W x x' y y' * ((g x x' y y' z : ℝ) : ℂ) := by
      intro x x' z
      rw [nsq]
      simp only [hu]
      rw [map_sum, Finset.sum_mul_sum]
      refine Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun y' _ => ?_
      simp only [hW, hg, map_mul, Complex.conj_ofReal, Complex.conj_conj]
      push_cast; ring
    rw [hQ2]
    simp only [Complex.ofReal_sum, hL]
    refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun x' _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun y _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun y' _ => ?_
    simp only [hG, Complex.ofReal_sum, Finset.mul_sum]
  have hQ2nn : 0 ≤ Q2 := by
    rw [hQ2]; exact Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ =>
      Finset.sum_nonneg fun _ _ => by positivity
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = ∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ y' ∈ Y, ∑ z ∈ Z, ∑ z' ∈ Z,
          f x y z * f x' y z * f x y' z * f x' y' z *
            f x y z' * f x' y z' * f x y' z' * f x' y' z' := ⟨_, rfl⟩
  have eT : ∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ y' ∈ Y, |G x x' y y'| ^ 2 = T := by
    rw [hT]
    refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun x' _ =>
      Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun y' _ => ?_
    rw [sq_abs, sq]
    simp only [hG]
    rw [Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun z _ => Finset.sum_congr rfl fun z' _ => ?_
    simp only [hg]; ring
  have h3 : Q2 ^ 2 ≤ ((X.card : ℝ) ^ 2 * Y.card ^ 2) * T := by
    have n3 : Q2 ≤ ∑ x ∈ X, ∑ x' ∈ X, ∑ y ∈ Y, ∑ y' ∈ Y, |G x x' y y'| := by
      have e : Q2 = ‖(Q2 : ℂ)‖ := by rw [Complex.norm_real, Real.norm_of_nonneg hQ2nn]
      rw [e, eQ2]
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun x _ => ?_)
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun x' _ => ?_)
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun y _ => ?_)
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun y' _ => ?_)
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have hw : ‖W x x' y y'‖ ≤ 1 := by
        simp only [hW, norm_mul, Complex.norm_conj]
        exact mul_le_one₀ (mul_le_one₀ (mul_le_one₀ (hC x y) (norm_nonneg _) (hC x' y))
          (norm_nonneg _) (hC x y')) (norm_nonneg _) (hC x' y')
      exact mul_le_of_le_one_left (abs_nonneg _) hw
    have h := (pow_le_pow_left₀ hQ2nn n3 2).trans (cs4 (fun x x' y y' => |G x x' y y'|))
    rw [eT] at h
    calc Q2 ^ 2 ≤ _ := h
      _ = _ := by ring
  
  rw [← hT]
  calc ‖S‖ ^ 8 = (‖S‖ ^ 2) ^ 4 := by ring
    _ ≤ (((Y.card : ℝ) * Z.card) * Q1) ^ 4 := pow_le_pow_left₀ (sq_nonneg _) h1 4
    _ = ((Y.card : ℝ) * Z.card) ^ 4 * (Q1 ^ 2) ^ 2 := by ring
    _ ≤ ((Y.card : ℝ) * Z.card) ^ 4 * (((X.card : ℝ) ^ 2 * Z.card) * Q2) ^ 2 :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (sq_nonneg _) h2 2) (by positivity)
    _ = ((Y.card : ℝ) * Z.card) ^ 4 * ((X.card : ℝ) ^ 2 * Z.card) ^ 2 * Q2 ^ 2 := by ring
    _ ≤ ((Y.card : ℝ) * Z.card) ^ 4 * ((X.card : ℝ) ^ 2 * Z.card) ^ 2 *
          (((X.card : ℝ) ^ 2 * Y.card ^ 2) * T) :=
        mul_le_mul_of_nonneg_left h3 (by positivity)
    _ = ((X.card : ℝ) * Y.card * Z.card) ^ 6 * T := by ring

theorem kernel_pushforward_six {G H : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]
    [AddCommGroup H] [Fintype H] [DecidableEq H]
    (ℓ₀ ℓ₁ ℓ₂ ℓ₃ : G → H)
    (h₀ : ∀ x y, ℓ₀ (x + y) = ℓ₀ x + ℓ₀ y) (h₁ : ∀ x y, ℓ₁ (x + y) = ℓ₁ x + ℓ₁ y)
    (h₂ : ∀ x y, ℓ₂ (x + y) = ℓ₂ x + ℓ₂ y) (h₃ : ∀ x y, ℓ₃ (x + y) = ℓ₃ x + ℓ₃ y)
    (s₁ : ∀ u : H, ∃ x : G, ℓ₀ x = u ∧ ℓ₁ x = 0)
    (s₂ : ∀ u : H, ∃ x : G, ℓ₀ x = u ∧ ℓ₂ x = 0)
    (s₃ : ∀ u : H, ∃ x : G, ℓ₀ x = u ∧ ℓ₃ x = 0)
    (Φ : H → H → H → H → H → H → ℝ) :
    (Fintype.card H : ℝ) ^ 6 *
      ∑ x₁ ∈ Finset.univ.filter (fun x => ℓ₁ x = 0),
        ∑ x₁' ∈ Finset.univ.filter (fun x => ℓ₁ x = 0),
          ∑ x₂ ∈ Finset.univ.filter (fun x => ℓ₂ x = 0),
            ∑ x₂' ∈ Finset.univ.filter (fun x => ℓ₂ x = 0),
              ∑ x₃ ∈ Finset.univ.filter (fun x => ℓ₃ x = 0),
                ∑ x₃' ∈ Finset.univ.filter (fun x => ℓ₃ x = 0),
                  Φ (ℓ₀ x₁) (ℓ₀ x₁') (ℓ₀ x₂) (ℓ₀ x₂') (ℓ₀ x₃) (ℓ₀ x₃') =
    (((Finset.univ.filter (fun x => ℓ₁ x = 0)).card : ℝ) *
        (Finset.univ.filter (fun x => ℓ₂ x = 0)).card *
        (Finset.univ.filter (fun x => ℓ₃ x = 0)).card) ^ 2 *
      ∑ u₁ : H, ∑ u₁' : H, ∑ u₂ : H, ∑ u₂' : H, ∑ u₃ : H, ∑ u₃' : H,
        Φ u₁ u₁' u₂ u₂' u₃ u₃' :=
by
  have key : ∀ (ℓ : G → H), (∀ x y, ℓ (x + y) = ℓ x + ℓ y) →
      (∀ u : H, ∃ x : G, ℓ₀ x = u ∧ ℓ x = 0) →
      ∃ m : ℝ, (Fintype.card H : ℝ) * m
          = ((Finset.univ.filter (fun x => ℓ x = 0)).card : ℝ) ∧
        ∀ g : H → ℝ, ∑ x ∈ Finset.univ.filter (fun x => ℓ x = 0), g (ℓ₀ x)
          = m * ∑ u, g u := by
    intro ℓ hℓ s
    have hsub : ∀ a b, ℓ (a - b) = ℓ a - ℓ b := fun a b => by
      rw [eq_sub_iff_add_eq, ← hℓ, sub_add_cancel]
    have hsub₀ : ∀ a b, ℓ₀ (a - b) = ℓ₀ a - ℓ₀ b := fun a b => by
      rw [eq_sub_iff_add_eq, ← h₀, sub_add_cancel]
    have hfib : ∀ v : H,
        ((Finset.univ.filter (fun x => ℓ x = 0)).filter (fun x => ℓ₀ x = v)).card
          = ((Finset.univ.filter (fun x => ℓ x = 0)).filter (fun x => ℓ₀ x = 0)).card := by
      intro v
      obtain ⟨xv, hxv0, hxv⟩ := s v
      symm
      apply Finset.card_nbij' (fun y => y + xv) (fun z => z - xv)
      · intro y hy
        simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_univ, true_and] at hy ⊢
        exact ⟨by rw [hℓ, hy.1, hxv, add_zero], by rw [h₀, hy.2, hxv0, zero_add]⟩
      · intro z hz
        simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_univ, true_and] at hz ⊢
        exact ⟨by rw [hsub, hz.1, hxv, sub_zero], by rw [hsub₀, hz.2, hxv0, sub_self]⟩
      · intro y _
        simp
      · intro z _
        simp
    have hcard : (Finset.univ.filter (fun x => ℓ x = 0)).card = Fintype.card H *
        ((Finset.univ.filter (fun x => ℓ x = 0)).filter (fun x => ℓ₀ x = 0)).card := by
      rw [Finset.card_eq_sum_card_fiberwise (f := ℓ₀)
        (s := Finset.univ.filter (fun x => ℓ x = 0)) (t := Finset.univ) (by intro x _; simp)]
      rw [Finset.sum_congr rfl (fun v _ => hfib v), Finset.sum_const, Finset.card_univ,
        smul_eq_mul]
    refine ⟨(((Finset.univ.filter (fun x => ℓ x = 0)).filter (fun x => ℓ₀ x = 0)).card : ℝ),
      ?_, ?_⟩
    · rw [hcard]; push_cast; ring
    · intro g
      calc ∑ x ∈ Finset.univ.filter (fun x => ℓ x = 0), g (ℓ₀ x)
          = ∑ u, ∑ x ∈ (Finset.univ.filter (fun x => ℓ x = 0)).filter (fun x => ℓ₀ x = u),
              g (ℓ₀ x) := (Finset.sum_fiberwise _ _ _).symm
        _ = ∑ u, (((Finset.univ.filter (fun x => ℓ x = 0)).filter
              (fun x => ℓ₀ x = 0)).card : ℝ) * g u := by
          refine Finset.sum_congr rfl (fun u _ => ?_)
          have hu : ∀ x ∈ (Finset.univ.filter (fun x => ℓ x = 0)).filter (fun x => ℓ₀ x = u),
              g (ℓ₀ x) = g u := fun x hx => by rw [(Finset.mem_filter.1 hx).2]
          rw [Finset.sum_congr rfl hu, Finset.sum_const, hfib u, nsmul_eq_mul]
        _ = _ := by rw [Finset.mul_sum]
  have step : ∀ (m c : ℝ) (K : Finset G),
      (∀ g : H → ℝ, ∑ x ∈ K, g (ℓ₀ x) = m * ∑ u, g u) →
      ∀ (A B : H → ℝ), (∀ v, A v = c * B v) → ∑ x ∈ K, A (ℓ₀ x) = (m * c) * ∑ u, B u := by
    intro m c K hg A B hAB
    rw [hg A, mul_assoc]
    congr 1
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun u _ => hAB u)
  obtain ⟨m₁, hm₁, hg₁⟩ := key ℓ₁ h₁ s₁
  obtain ⟨m₂, hm₂, hg₂⟩ := key ℓ₂ h₂ s₂
  obtain ⟨m₃, hm₃, hg₃⟩ := key ℓ₃ h₃ s₃
  set K₁ := Finset.univ.filter (fun x => ℓ₁ x = 0) with hK₁
  set K₂ := Finset.univ.filter (fun x => ℓ₂ x = 0) with hK₂
  set K₃ := Finset.univ.filter (fun x => ℓ₃ x = 0) with hK₃
  have L6 : ∀ a b c d e : H, ∑ x ∈ K₃, Φ a b c d e (ℓ₀ x) = m₃ * ∑ u, Φ a b c d e u :=
    fun a b c d e => hg₃ (fun w => Φ a b c d e w)
  have L5 : ∀ a b c d : H, ∑ x ∈ K₃, ∑ x' ∈ K₃, Φ a b c d (ℓ₀ x) (ℓ₀ x')
      = (m₃ * m₃) * ∑ u, ∑ u', Φ a b c d u u' :=
    fun a b c d => step m₃ m₃ K₃ hg₃ (fun v => ∑ x' ∈ K₃, Φ a b c d v (ℓ₀ x'))
      (fun v => ∑ u', Φ a b c d v u') (fun v => L6 a b c d v)
  have L4 : ∀ a b c : H, ∑ x ∈ K₂, ∑ y ∈ K₃, ∑ y' ∈ K₃, Φ a b c (ℓ₀ x) (ℓ₀ y) (ℓ₀ y')
      = (m₂ * (m₃ * m₃)) * ∑ u, ∑ v, ∑ v', Φ a b c u v v' :=
    fun a b c => step m₂ (m₃ * m₃) K₂ hg₂
      (fun w => ∑ y ∈ K₃, ∑ y' ∈ K₃, Φ a b c w (ℓ₀ y) (ℓ₀ y'))
      (fun w => ∑ v, ∑ v', Φ a b c w v v') (fun w => L5 a b c w)
  have L3 : ∀ a b : H, ∑ x ∈ K₂, ∑ x' ∈ K₂, ∑ y ∈ K₃, ∑ y' ∈ K₃,
      Φ a b (ℓ₀ x) (ℓ₀ x') (ℓ₀ y) (ℓ₀ y')
      = (m₂ * (m₂ * (m₃ * m₃))) * ∑ u, ∑ u', ∑ v, ∑ v', Φ a b u u' v v' :=
    fun a b => step m₂ (m₂ * (m₃ * m₃)) K₂ hg₂
      (fun w => ∑ x' ∈ K₂, ∑ y ∈ K₃, ∑ y' ∈ K₃, Φ a b w (ℓ₀ x') (ℓ₀ y) (ℓ₀ y'))
      (fun w => ∑ u', ∑ v, ∑ v', Φ a b w u' v v') (fun w => L4 a b w)
  have L2 : ∀ a : H, ∑ z' ∈ K₁, ∑ x ∈ K₂, ∑ x' ∈ K₂, ∑ y ∈ K₃, ∑ y' ∈ K₃,
      Φ a (ℓ₀ z') (ℓ₀ x) (ℓ₀ x') (ℓ₀ y) (ℓ₀ y')
      = (m₁ * (m₂ * (m₂ * (m₃ * m₃)))) * ∑ t', ∑ u, ∑ u', ∑ v, ∑ v', Φ a t' u u' v v' :=
    fun a => step m₁ (m₂ * (m₂ * (m₃ * m₃))) K₁ hg₁
      (fun w => ∑ x ∈ K₂, ∑ x' ∈ K₂, ∑ y ∈ K₃, ∑ y' ∈ K₃,
        Φ a w (ℓ₀ x) (ℓ₀ x') (ℓ₀ y) (ℓ₀ y'))
      (fun w => ∑ u, ∑ u', ∑ v, ∑ v', Φ a w u u' v v') (fun w => L3 a w)
  have L1 : ∑ z ∈ K₁, ∑ z' ∈ K₁, ∑ x ∈ K₂, ∑ x' ∈ K₂, ∑ y ∈ K₃, ∑ y' ∈ K₃,
      Φ (ℓ₀ z) (ℓ₀ z') (ℓ₀ x) (ℓ₀ x') (ℓ₀ y) (ℓ₀ y')
      = (m₁ * (m₁ * (m₂ * (m₂ * (m₃ * m₃))))) *
        ∑ t, ∑ t', ∑ u, ∑ u', ∑ v, ∑ v', Φ t t' u u' v v' :=
    step m₁ (m₁ * (m₂ * (m₂ * (m₃ * m₃)))) K₁ hg₁
      (fun w => ∑ z' ∈ K₁, ∑ x ∈ K₂, ∑ x' ∈ K₂, ∑ y ∈ K₃, ∑ y' ∈ K₃,
        Φ w (ℓ₀ z') (ℓ₀ x) (ℓ₀ x') (ℓ₀ y) (ℓ₀ y'))
      (fun w => ∑ t', ∑ u, ∑ u', ∑ v, ∑ v', Φ w t' u u' v v') (fun w => L2 w)
  rw [L1, ← hm₁, ← hm₂, ← hm₃]
  ring

theorem zmod_cube_sum_eq_U3 (p n : ℕ) [Fact p.Prime] (F : (Fin n → ZMod p) → ℝ)
    (c : Fin n → ZMod p) :
    ∑ u₁ : Fin n → ZMod p, ∑ u₁' : Fin n → ZMod p, ∑ u₂ : Fin n → ZMod p,
      ∑ u₂' : Fin n → ZMod p, ∑ u₃ : Fin n → ZMod p, ∑ u₃' : Fin n → ZMod p,
        F (c + u₁ + u₂ + u₃) * F (c + u₁' + u₂ + u₃) * F (c + u₁ + u₂' + u₃) *
          F (c + u₁' + u₂' + u₃) * F (c + u₁ + u₂ + u₃') * F (c + u₁' + u₂ + u₃') *
          F (c + u₁ + u₂' + u₃') * F (c + u₁' + u₂' + u₃') =
      (p : ℝ) ^ (2 * n) * zmodU3Sum F :=
by
  classical
  have hexp : ∀ y h₁ h₂ h₃ : Fin n → ZMod p,
      ∏ ε : Fin 3 → Fin 2, F (cubeVertex y h₁ h₂ h₃ ε) =
        F y * F (y + h₁) * F (y + h₂) * F (y + h₁ + h₂) * F (y + h₃) * F (y + h₁ + h₃) *
          F (y + h₂ + h₃) * F (y + h₁ + h₂ + h₃) := by
    intro y h₁ h₂ h₃
    let e : Fin 2 × Fin 2 × Fin 2 ≃ (Fin 3 → Fin 2) :=
      { toFun := fun t => ![t.1, t.2.1, t.2.2]
        invFun := fun ε => (ε 0, ε 1, ε 2)
        left_inv := fun t => by rcases t with ⟨a, b, c⟩; rfl
        right_inv := fun ε => by funext i; fin_cases i <;> rfl }
    rw [← Fintype.prod_equiv e (fun t => F (cubeVertex y h₁ h₂ h₃ (e t))) _ (fun _ => rfl)]
    simp only [Fintype.prod_prod_type, Fin.prod_univ_two]
    simp [e, cubeVertex]
    ring
  have hshift : ∀ (a : Fin n → ZMod p) (f : (Fin n → ZMod p) → ℝ),
      ∑ x, f x = ∑ h, f (a + h) := fun a f => (Equiv.sum_comp (Equiv.addLeft a) f).symm
  have hcard : (Fintype.card (Fin n → ZMod p) : ℝ) = (p : ℝ) ^ n := by
    rw [Fintype.card_fun, ZMod.card, Fintype.card_fin]; push_cast; ring
  calc _ = ∑ u₁ : Fin n → ZMod p, ∑ h₁ : Fin n → ZMod p, ∑ u₂ : Fin n → ZMod p,
        ∑ h₂ : Fin n → ZMod p, ∑ u₃ : Fin n → ZMod p, ∑ h₃ : Fin n → ZMod p,
          ∏ ε : Fin 3 → Fin 2, F (cubeVertex (c + u₁ + u₂ + u₃) h₁ h₂ h₃ ε) := by
        refine Finset.sum_congr rfl fun u₁ _ => ?_
        rw [hshift u₁]
        refine Finset.sum_congr rfl fun h₁ _ => ?_
        refine Finset.sum_congr rfl fun u₂ _ => ?_
        rw [hshift u₂]
        refine Finset.sum_congr rfl fun h₂ _ => ?_
        refine Finset.sum_congr rfl fun u₃ _ => ?_
        rw [hshift u₃]
        refine Finset.sum_congr rfl fun h₃ _ => ?_
        rw [hexp]
        have e1 : c + (u₁ + h₁) + u₂ + u₃ = c + u₁ + u₂ + u₃ + h₁ := by abel
        have e2 : c + u₁ + (u₂ + h₂) + u₃ = c + u₁ + u₂ + u₃ + h₂ := by abel
        have e3 : c + (u₁ + h₁) + (u₂ + h₂) + u₃ = c + u₁ + u₂ + u₃ + h₁ + h₂ := by abel
        have e4 : c + u₁ + u₂ + (u₃ + h₃) = c + u₁ + u₂ + u₃ + h₃ := by abel
        have e5 : c + (u₁ + h₁) + u₂ + (u₃ + h₃) = c + u₁ + u₂ + u₃ + h₁ + h₃ := by abel
        have e6 : c + u₁ + (u₂ + h₂) + (u₃ + h₃) = c + u₁ + u₂ + u₃ + h₂ + h₃ := by abel
        have e7 : c + (u₁ + h₁) + (u₂ + h₂) + (u₃ + h₃) =
            c + u₁ + u₂ + u₃ + h₁ + h₂ + h₃ := by abel
        rw [e1, e2, e3, e4, e5, e6, e7]
    _ = ∑ u₁ : Fin n → ZMod p, ∑ h₁ : Fin n → ZMod p, ∑ u₂ : Fin n → ZMod p,
        ∑ h₂ : Fin n → ZMod p, ∑ y : Fin n → ZMod p, ∑ h₃ : Fin n → ZMod p,
          ∏ ε : Fin 3 → Fin 2, F (cubeVertex y h₁ h₂ h₃ ε) := by
        refine Finset.sum_congr rfl fun u₁ _ => ?_
        refine Finset.sum_congr rfl fun h₁ _ => ?_
        refine Finset.sum_congr rfl fun u₂ _ => ?_
        refine Finset.sum_congr rfl fun h₂ _ => ?_
        exact Equiv.sum_comp (Equiv.addLeft (c + u₁ + u₂))
          (fun y => ∑ h₃ : Fin n → ZMod p, ∏ ε : Fin 3 → Fin 2, F (cubeVertex y h₁ h₂ h₃ ε))
    _ = ∑ u₁ : Fin n → ZMod p, ∑ u₂ : Fin n → ZMod p, ∑ y : Fin n → ZMod p,
        ∑ h₁ : Fin n → ZMod p, ∑ h₂ : Fin n → ZMod p, ∑ h₃ : Fin n → ZMod p,
          ∏ ε : Fin 3 → Fin 2, F (cubeVertex y h₁ h₂ h₃ ε) := by
        refine Finset.sum_congr rfl fun u₁ _ => ?_
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun u₂ _ => ?_
        exact (Finset.sum_congr rfl fun h₁ _ => Finset.sum_comm).trans Finset.sum_comm
    _ = (Fintype.card (Fin n → ZMod p) : ℝ) ^ 2 * zmodU3Sum F := by
        simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        unfold zmodU3Sum
        ring
    _ = (p : ℝ) ^ (2 * n) * zmodU3Sum F := by
        rw [hcard, ← pow_mul, mul_comm n 2]

theorem zmod_twisted_von_neumann (p n d : ℕ) [Fact p.Prime]
    (a : Fin 4 → (Fin n → ZMod p)) (v : Fin 4 → Fin d → (Fin n → ZMod p)) (i₀ : Fin 4)
    (hpair : ∀ j : Fin 4, j ≠ i₀ → ∀ u w : Fin n → ZMod p, ∃ x : Fin d → ZMod p,
      (∑ k, x k • v i₀ k = u) ∧ (∑ k, x k • v j k = w))
    (F : Fin 4 → (Fin n → ZMod p) → ℝ) (hF : ∀ i : Fin 4, i ≠ i₀ → ∀ y, |F i y| ≤ 1)
    (χ : (Fin d → ZMod p) → ℂ) (hχmul : ∀ x y, χ (x + y) = χ x * χ y)
    (hχ : ∀ x, ‖χ x‖ ≤ 1) :
    ‖∑ x : Fin d → ZMod p, χ x * ∏ i : Fin 4, ((F i (a i + ∑ k, x k • v i k) : ℝ) : ℂ)‖ ^ 8
      ≤ (p : ℝ) ^ (8 * d) / (p : ℝ) ^ (4 * n) * zmodU3Sum (F i₀) :=
by
  
  have core : ∀ (a : Fin 4 → (Fin n → ZMod p)) (v : Fin 4 → Fin d → (Fin n → ZMod p))
      (F : Fin 4 → (Fin n → ZMod p) → ℝ),
      (∀ j : Fin 4, j ≠ 0 → ∀ u w : Fin n → ZMod p, ∃ x : Fin d → ZMod p,
        (∑ k, x k • v 0 k = u) ∧ (∑ k, x k • v j k = w)) →
      (∀ i : Fin 4, i ≠ 0 → ∀ y, |F i y| ≤ 1) →
      ‖∑ x : Fin d → ZMod p, χ x * ∏ i : Fin 4, ((F i (a i + ∑ k, x k • v i k) : ℝ) : ℂ)‖ ^ 8
        ≤ (p : ℝ) ^ (8 * d) / (p : ℝ) ^ (4 * n) * zmodU3Sum (F 0) := by
    intro a v F hpair hF
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : Fin 4 → (Fin d → ZMod p) → (Fin n → ZMod p),
        ∀ i x, ℓ i x = ∑ k, x k • v i k :=
      ⟨fun i x => ∑ k, x k • v i k, fun _ _ => rfl⟩
    simp only [← hℓ] at hpair ⊢
    have hadd : ∀ i x y, ℓ i (x + y) = ℓ i x + ℓ i y := by
      intro i x y
      simp only [hℓ, Pi.add_apply, add_smul, Finset.sum_add_distrib]
    have hzero : ∀ i, ℓ i 0 = 0 := by
      intro i
      simp only [hℓ, Pi.zero_apply, zero_smul, Finset.sum_const_zero]
    have hp0 : (0 : ℝ) < p := by exact_mod_cast (Fact.out : p.Prime).pos
    have hcardH : ((Fintype.card (Fin n → ZMod p) : ℕ) : ℝ) = (p : ℝ) ^ n := by
      rw [Fintype.card_fun, ZMod.card, Fintype.card_fin, Nat.cast_pow]
    have hcardG : ((Fintype.card (Fin d → ZMod p) : ℕ) : ℝ) = (p : ℝ) ^ d := by
      rw [Fintype.card_fun, ZMod.card, Fintype.card_fin, Nat.cast_pow]
    
    obtain ⟨K1, hK1⟩ : ∃ K : Finset (Fin d → ZMod p),
        K = Finset.univ.filter (fun x => ℓ 1 x = 0) := ⟨_, rfl⟩
    obtain ⟨K2, hK2⟩ : ∃ K : Finset (Fin d → ZMod p),
        K = Finset.univ.filter (fun x => ℓ 2 x = 0) := ⟨_, rfl⟩
    obtain ⟨K3, hK3⟩ : ∃ K : Finset (Fin d → ZMod p),
        K = Finset.univ.filter (fun x => ℓ 3 x = 0) := ⟨_, rfl⟩
    have hm1 : ∀ x ∈ K1, ℓ 1 x = 0 := by
      intro x hx; rw [hK1] at hx; exact (Finset.mem_filter.1 hx).2
    have hm2 : ∀ x ∈ K2, ℓ 2 x = 0 := by
      intro x hx; rw [hK2] at hx; exact (Finset.mem_filter.1 hx).2
    have hm3 : ∀ x ∈ K3, ℓ 3 x = 0 := by
      intro x hx; rw [hK3] at hx; exact (Finset.mem_filter.1 hx).2
    have hc1 : (0 : ℝ) < K1.card := by
      exact_mod_cast Finset.card_pos.2 ⟨0, by rw [hK1]; simp [hzero]⟩
    have hc2 : (0 : ℝ) < K2.card := by
      exact_mod_cast Finset.card_pos.2 ⟨0, by rw [hK2]; simp [hzero]⟩
    have hc3 : (0 : ℝ) < K3.card := by
      exact_mod_cast Finset.card_pos.2 ⟨0, by rw [hK3]; simp [hzero]⟩
    obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = (K1.card : ℝ) * K2.card * K3.card := ⟨_, rfl⟩
    have hκpos : 0 < κ := by rw [hκ]; exact mul_pos (mul_pos hc1 hc2) hc3
    
    obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : (Fin d → ZMod p) → ℂ,
        ∀ z, Ψ z = χ z * ∏ i : Fin 4, ((F i (a i + ℓ i z) : ℝ) : ℂ) :=
      ⟨fun z => χ z * ∏ i : Fin 4, ((F i (a i + ℓ i z) : ℝ) : ℂ), fun _ => rfl⟩
    have hS : (∑ x : Fin d → ZMod p, χ x * ∏ i : Fin 4, ((F i (a i + ℓ i x) : ℝ) : ℂ))
        = ∑ z, Ψ z := by
      simp only [hΨ]
    rw [hS]
    
    have htrans : ∀ x₁ x₂ x₃ : Fin d → ZMod p, ∑ w, Ψ (w + x₁ + x₂ + x₃) = ∑ z, Ψ z := by
      intro x₁ x₂ x₃
      calc ∑ w, Ψ (w + x₁ + x₂ + x₃) = ∑ w, Ψ (w + (x₁ + x₂ + x₃)) := by
            simp only [add_assoc]
        _ = ∑ z, Ψ z := Equiv.sum_comp (Equiv.addRight (x₁ + x₂ + x₃)) Ψ
    have hnf : (κ : ℂ) * ∑ z, Ψ z
        = ∑ w, ∑ x₁ ∈ K1, ∑ x₂ ∈ K2, ∑ x₃ ∈ K3, Ψ (w + x₁ + x₂ + x₃) := by
      symm
      calc ∑ w, ∑ x₁ ∈ K1, ∑ x₂ ∈ K2, ∑ x₃ ∈ K3, Ψ (w + x₁ + x₂ + x₃)
          = ∑ x₁ ∈ K1, ∑ x₂ ∈ K2, ∑ x₃ ∈ K3, ∑ w, Ψ (w + x₁ + x₂ + x₃) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun x₁ _ => ?_)
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun x₂ _ => ?_)
            rw [Finset.sum_comm]
        _ = ∑ x₁ ∈ K1, ∑ x₂ ∈ K2, ∑ x₃ ∈ K3, ∑ z, Ψ z := by simp only [htrans]
        _ = (κ : ℂ) * ∑ z, Ψ z := by
            simp only [Finset.sum_const, nsmul_eq_mul, hκ]; push_cast; ring
    
    obtain ⟨fv, hfv⟩ : ∃ fv : (Fin d → ZMod p) → (Fin d → ZMod p) → (Fin d → ZMod p) →
        (Fin d → ZMod p) → ℝ,
        ∀ w x y z, fv w x y z = F 0 (a 0 + ℓ 0 w + ℓ 0 x + ℓ 0 y + ℓ 0 z) :=
      ⟨fun w x y z => F 0 (a 0 + ℓ 0 w + ℓ 0 x + ℓ 0 y + ℓ 0 z), fun _ _ _ _ => rfl⟩
    obtain ⟨Av, hAv⟩ : ∃ Av : (Fin d → ZMod p) → (Fin d → ZMod p) → (Fin d → ZMod p) → ℂ,
        ∀ w y z, Av w y z = ((F 1 (a 1 + ℓ 1 w + ℓ 1 y + ℓ 1 z) : ℝ) : ℂ) * χ y * χ z :=
      ⟨fun w y z => ((F 1 (a 1 + ℓ 1 w + ℓ 1 y + ℓ 1 z) : ℝ) : ℂ) * χ y * χ z,
        fun _ _ _ => rfl⟩
    obtain ⟨Bv, hBv⟩ : ∃ Bv : (Fin d → ZMod p) → (Fin d → ZMod p) → (Fin d → ZMod p) → ℂ,
        ∀ w x z, Bv w x z = ((F 2 (a 2 + ℓ 2 w + ℓ 2 x + ℓ 2 z) : ℝ) : ℂ) * χ x :=
      ⟨fun w x z => ((F 2 (a 2 + ℓ 2 w + ℓ 2 x + ℓ 2 z) : ℝ) : ℂ) * χ x, fun _ _ _ => rfl⟩
    obtain ⟨Cv, hCv⟩ : ∃ Cv : (Fin d → ZMod p) → (Fin d → ZMod p) → (Fin d → ZMod p) → ℂ,
        ∀ w x y, Cv w x y = ((F 3 (a 3 + ℓ 3 w + ℓ 3 x + ℓ 3 y) : ℝ) : ℂ) :=
      ⟨fun w x y => ((F 3 (a 3 + ℓ 3 w + ℓ 3 x + ℓ 3 y) : ℝ) : ℂ), fun _ _ _ => rfl⟩
    obtain ⟨Iv, hIv⟩ : ∃ Iv : (Fin d → ZMod p) → ℂ, ∀ w, Iv w =
        ∑ x ∈ K1, ∑ y ∈ K2, ∑ z ∈ K3, (fv w x y z : ℂ) * Av w y z * Bv w x z * Cv w x y :=
      ⟨fun w => ∑ x ∈ K1, ∑ y ∈ K2, ∑ z ∈ K3,
        (fv w x y z : ℂ) * Av w y z * Bv w x z * Cv w x y, fun _ => rfl⟩
    have hpt : ∀ w x₁ x₂ x₃ : Fin d → ZMod p, ℓ 1 x₁ = 0 → ℓ 2 x₂ = 0 → ℓ 3 x₃ = 0 →
        Ψ (w + x₁ + x₂ + x₃)
          = χ w * ((fv w x₁ x₂ x₃ : ℂ) * Av w x₂ x₃ * Bv w x₁ x₃ * Cv w x₁ x₂) := by
      intro w x₁ x₂ x₃ h1 h2 h3
      have e0 : a 0 + ℓ 0 (w + x₁ + x₂ + x₃) = a 0 + ℓ 0 w + ℓ 0 x₁ + ℓ 0 x₂ + ℓ 0 x₃ := by
        rw [hadd, hadd, hadd]; abel
      have e1 : a 1 + ℓ 1 (w + x₁ + x₂ + x₃) = a 1 + ℓ 1 w + ℓ 1 x₂ + ℓ 1 x₃ := by
        rw [hadd, hadd, hadd, h1]; abel
      have e2 : a 2 + ℓ 2 (w + x₁ + x₂ + x₃) = a 2 + ℓ 2 w + ℓ 2 x₁ + ℓ 2 x₃ := by
        rw [hadd, hadd, hadd, h2]; abel
      have e3 : a 3 + ℓ 3 (w + x₁ + x₂ + x₃) = a 3 + ℓ 3 w + ℓ 3 x₁ + ℓ 3 x₂ := by
        rw [hadd, hadd, hadd, h3]; abel
      have eχ : χ (w + x₁ + x₂ + x₃) = χ w * χ x₁ * χ x₂ * χ x₃ := by
        rw [hχmul, hχmul, hχmul]
      rw [hΨ, Fin.prod_univ_four, e0, e1, e2, e3, eχ, hfv, hAv, hBv, hCv]
      ring
    have hsplit : ∀ w, ∑ x₁ ∈ K1, ∑ x₂ ∈ K2, ∑ x₃ ∈ K3, Ψ (w + x₁ + x₂ + x₃) = χ w * Iv w := by
      intro w
      rw [hIv, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun x₁ hx₁ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun x₂ hx₂ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun x₃ hx₃ => ?_)
      exact hpt w x₁ x₂ x₃ (hm1 x₁ hx₁) (hm2 x₂ hx₂) (hm3 x₃ hx₃)
    
    have hFn : ∀ i : Fin 4, i ≠ 0 → ∀ y, ‖((F i y : ℝ) : ℂ)‖ ≤ 1 := by
      intro i hi y; rw [Complex.norm_real, Real.norm_eq_abs]; exact hF i hi y
    have hAn : ∀ w y z, ‖Av w y z‖ ≤ 1 := by
      intro w y z; rw [hAv, norm_mul, norm_mul]
      exact mul_le_one₀ (mul_le_one₀ (hFn 1 (by decide) _) (norm_nonneg _) (hχ y))
        (norm_nonneg _) (hχ z)
    have hBn : ∀ w x z, ‖Bv w x z‖ ≤ 1 := by
      intro w x z; rw [hBv, norm_mul]
      exact mul_le_one₀ (hFn 2 (by decide) _) (norm_nonneg _) (hχ x)
    have hCn : ∀ w x y, ‖Cv w x y‖ ≤ 1 := by
      intro w x y; rw [hCv]; exact hFn 3 (by decide) _
    
    have hU : ∀ w, ‖Iv w‖ ^ 8 ≤ κ ^ 8 * zmodU3Sum (F 0) / (p : ℝ) ^ (4 * n) := by
      intro w
      have hbox := box_cs_three K1 K2 K3 (fv w) (Av w) (Bv w) (Cv w) (hAn w) (hBn w) (hCn w)
      rw [← hIv w, ← hκ] at hbox
      simp only [hfv] at hbox
      have h6 := kernel_pushforward_six (ℓ 0) (ℓ 1) (ℓ 2) (ℓ 3) (hadd 0) (hadd 1) (hadd 2)
        (hadd 3) (fun u => hpair 1 (by decide) u 0) (fun u => hpair 2 (by decide) u 0)
        (fun u => hpair 3 (by decide) u 0)
        (fun u₁ u₁' u₂ u₂' u₃ u₃' =>
          F 0 (a 0 + ℓ 0 w + u₁ + u₂ + u₃) * F 0 (a 0 + ℓ 0 w + u₁' + u₂ + u₃) *
          F 0 (a 0 + ℓ 0 w + u₁ + u₂' + u₃) * F 0 (a 0 + ℓ 0 w + u₁' + u₂' + u₃) *
          F 0 (a 0 + ℓ 0 w + u₁ + u₂ + u₃') * F 0 (a 0 + ℓ 0 w + u₁' + u₂ + u₃') *
          F 0 (a 0 + ℓ 0 w + u₁ + u₂' + u₃') * F 0 (a 0 + ℓ 0 w + u₁' + u₂' + u₃'))
      rw [← hK1, ← hK2, ← hK3, ← hκ, hcardH, zmod_cube_sum_eq_U3 p n (F 0) (a 0 + ℓ 0 w)]
        at h6
      have e2n : (p : ℝ) ^ (2 * n) = ((p : ℝ) ^ n) ^ 2 := by ring
      have e4n : (p : ℝ) ^ (4 * n) = ((p : ℝ) ^ n) ^ 4 := by ring
      rw [e2n] at h6
      obtain ⟨Bx, hb1, hb2⟩ : ∃ Bx : ℝ, ‖Iv w‖ ^ 8 ≤ κ ^ 6 * Bx ∧
          ((p : ℝ) ^ n) ^ 6 * Bx = κ ^ 2 * (((p : ℝ) ^ n) ^ 2 * zmodU3Sum (F 0)) :=
        ⟨_, hbox, h6⟩
      have hP : (0 : ℝ) < (p : ℝ) ^ n := pow_pos hp0 n
      have hkey : ((p : ℝ) ^ n) ^ 4 * Bx = κ ^ 2 * zmodU3Sum (F 0) := by
        have hP2 : ((p : ℝ) ^ n) ^ 2 ≠ 0 := by positivity
        apply mul_left_cancel₀ hP2
        linear_combination hb2
      rw [e4n, le_div_iff₀ (by positivity)]
      calc ‖Iv w‖ ^ 8 * ((p : ℝ) ^ n) ^ 4 ≤ κ ^ 6 * Bx * ((p : ℝ) ^ n) ^ 4 :=
            mul_le_mul_of_nonneg_right hb1 (by positivity)
        _ = κ ^ 6 * (((p : ℝ) ^ n) ^ 4 * Bx) := by ring
        _ = κ ^ 8 * zmodU3Sum (F 0) := by rw [hkey]; ring
    
    have hnorm : κ * ‖∑ z, Ψ z‖ ≤ ∑ w, ‖Iv w‖ := by
      have h1 : ‖(κ : ℂ) * ∑ z, Ψ z‖ = κ * ‖∑ z, Ψ z‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hκpos]
      rw [← h1, hnf]
      calc ‖∑ w, ∑ x₁ ∈ K1, ∑ x₂ ∈ K2, ∑ x₃ ∈ K3, Ψ (w + x₁ + x₂ + x₃)‖
          = ‖∑ w, χ w * Iv w‖ := by simp only [hsplit]
        _ ≤ ∑ w, ‖χ w * Iv w‖ := norm_sum_le _ _
        _ ≤ ∑ w, ‖Iv w‖ := by
            refine Finset.sum_le_sum (fun w _ => ?_)
            rw [norm_mul]
            exact mul_le_of_le_one_left (norm_nonneg _) (hχ w)
    
    have hHol : (∑ w, ‖Iv w‖) ^ 8 ≤ ((p : ℝ) ^ d) ^ 7 * ∑ w, ‖Iv w‖ ^ 8 := by
      have h := pow_sum_div_card_le_sum_pow (s := (Finset.univ : Finset (Fin d → ZMod p)))
        (f := fun w => ‖Iv w‖) (fun w _ => norm_nonneg _) 7
      rw [Finset.card_univ, hcardG, div_le_iff₀ (by positivity)] at h
      have e8 : (7 : ℕ) + 1 = 8 := rfl
      rw [e8] at h
      linarith
    have hsum : ∑ w, ‖Iv w‖ ^ 8
        ≤ (p : ℝ) ^ d * (κ ^ 8 * zmodU3Sum (F 0) / (p : ℝ) ^ (4 * n)) := by
      calc ∑ w, ‖Iv w‖ ^ 8
          ≤ ∑ _w : Fin d → ZMod p, κ ^ 8 * zmodU3Sum (F 0) / (p : ℝ) ^ (4 * n) :=
            Finset.sum_le_sum (fun w _ => hU w)
        _ = (p : ℝ) ^ d * (κ ^ 8 * zmodU3Sum (F 0) / (p : ℝ) ^ (4 * n)) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, hcardG]
    have hfin : κ ^ 8 * ‖∑ z, Ψ z‖ ^ 8
        ≤ κ ^ 8 * ((p : ℝ) ^ (8 * d) / (p : ℝ) ^ (4 * n) * zmodU3Sum (F 0)) := by
      calc κ ^ 8 * ‖∑ z, Ψ z‖ ^ 8 = (κ * ‖∑ z, Ψ z‖) ^ 8 := by ring
        _ ≤ (∑ w, ‖Iv w‖) ^ 8 :=
            pow_le_pow_left₀ (mul_nonneg hκpos.le (norm_nonneg _)) hnorm 8
        _ ≤ ((p : ℝ) ^ d) ^ 7 * ∑ w, ‖Iv w‖ ^ 8 := hHol
        _ ≤ ((p : ℝ) ^ d) ^ 7 * ((p : ℝ) ^ d * (κ ^ 8 * zmodU3Sum (F 0) / (p : ℝ) ^ (4 * n))) :=
            mul_le_mul_of_nonneg_left hsum (by positivity)
        _ = κ ^ 8 * ((p : ℝ) ^ (8 * d) / (p : ℝ) ^ (4 * n) * zmodU3Sum (F 0)) := by
            have e8 : (p : ℝ) ^ (8 * d) = ((p : ℝ) ^ d) ^ 8 := by ring
            rw [e8]; ring
    exact le_of_mul_le_mul_left hfin (pow_pos hκpos 8)
  
  obtain ⟨σ, hσ⟩ : ∃ σ : Equiv.Perm (Fin 4), σ = Equiv.swap 0 i₀ := ⟨_, rfl⟩
  have hσ0 : σ 0 = i₀ := by rw [hσ]; exact Equiv.swap_apply_left _ _
  have hσne : ∀ j : Fin 4, j ≠ 0 → σ j ≠ i₀ := by
    intro j hj h
    exact hj (σ.injective (h.trans hσ0.symm))
  have h := core (fun i => a (σ i)) (fun i => v (σ i)) (fun i => F (σ i))
    (by
      intro j hj u w
      obtain ⟨x, h1, h2⟩ := hpair (σ j) (hσne j hj) u w
      refine ⟨x, ?_, h2⟩
      show ∑ k, x k • v (σ 0) k = u
      rw [hσ0]; exact h1)
    (fun i hi y => hF (σ i) (hσne i hi) y)
  have hprod : ∀ x : Fin d → ZMod p,
      ∏ i : Fin 4, ((F (σ i) (a (σ i) + ∑ k, x k • v (σ i) k) : ℝ) : ℂ)
        = ∏ i : Fin 4, ((F i (a i + ∑ k, x k • v i k) : ℝ) : ℂ) :=
    fun x => Equiv.prod_comp σ (fun i => ((F i (a i + ∑ k, x k • v i k) : ℝ) : ℂ))
  simp only [hprod, hσ0] at h
  exact h

theorem zmod_fourier_smoothing (p d r : ℕ) [Fact p.Prime] (hr1 : 1 ≤ r) (hrp : r ≤ p)
    (G Φ : (Fin d → ZMod p) → ℝ) (W2 : ℝ)
    (hW : ∀ ξ : Fin d → ZMod p,
      ‖∑ x, (ZMod.stdAddChar (∑ k, ξ k * x k) : ℂ) * ((Φ x : ℝ) : ℂ)‖ ^ 2 ≤ W2) :
    (∑ x, zmodBoxSmooth r G x * Φ x) ^ 2 ≤ (∑ x, G x ^ 2) / (r : ℝ) ^ d * W2 :=
by
  classical
  
  have hadd : ∀ ξ u v : Fin d → ZMod p, (ZMod.stdAddChar (∑ k, ξ k * (u + v) k) : ℂ)
      = ZMod.stdAddChar (∑ k, ξ k * u k) * ZMod.stdAddChar (∑ k, ξ k * v k) := by
    intro ξ u v
    rw [← AddChar.map_add_eq_mul]
    congr 1
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  have hneg : ∀ ξ u : Fin d → ZMod p, (ZMod.stdAddChar (∑ k, ξ k * (-u) k) : ℂ)
      = starRingEnd ℂ (ZMod.stdAddChar (∑ k, ξ k * u k)) := by
    intro ξ u
    rw [← AddChar.map_neg_eq_conj]
    congr 1
    simp only [Pi.neg_apply, mul_neg, Finset.sum_neg_distrib]
  
  have horth : ∀ x : Fin d → ZMod p, ∑ ξ : Fin d → ZMod p, (ZMod.stdAddChar (∑ k, ξ k * x k) : ℂ)
      = if x = 0 then (p : ℂ) ^ d else 0 := by
    intro x
    have hmap : ∀ (s : Finset (Fin d)) (f : Fin d → ZMod p),
        (ZMod.stdAddChar (∑ k ∈ s, f k) : ℂ) = ∏ k ∈ s, (ZMod.stdAddChar (f k) : ℂ) := by
      intro s f
      induction s using Finset.induction_on with
      | empty => simp
      | insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.prod_insert ha, AddChar.map_add_eq_mul, ih]
    simp_rw [hmap]
    rw [← Fintype.prod_sum (fun k t => (ZMod.stdAddChar (t * x k) : ℂ))]
    simp_rw [AddChar.sum_mulShift _ (ZMod.isPrimitive_stdAddChar p), ZMod.card]
    split_ifs with hx
    · subst hx; simp
    · obtain ⟨k, hk⟩ := Function.ne_iff.mp hx
      simp only [Pi.zero_apply] at hk
      apply Finset.prod_eq_zero (Finset.mem_univ k)
      simp [hk]
  
  have hplan : ∀ {β : Type} [Fintype β] (g : β → Fin d → ZMod p), Function.Injective g →
      ∀ a : β → ℝ, ∑ ξ : Fin d → ZMod p,
        ‖∑ b, (ZMod.stdAddChar (∑ k, ξ k * g b k) : ℂ) * ((a b : ℝ) : ℂ)‖ ^ 2
        = (p : ℝ) ^ d * ∑ b, a b ^ 2 := by
    intro β _ g hg a
    apply Complex.ofReal_injective
    push_cast
    have h1 : ∀ ξ : Fin d → ZMod p,
        ((‖∑ b, (ZMod.stdAddChar (∑ k, ξ k * g b k) : ℂ) * ((a b : ℝ) : ℂ)‖ : ℝ) : ℂ) ^ 2
        = ∑ b, ∑ b', (ZMod.stdAddChar (∑ k, ξ k * (g b + -g b') k) : ℂ)
            * (((a b : ℝ) : ℂ) * ((a b' : ℝ) : ℂ)) := by
      intro ξ
      rw [← Complex.mul_conj', map_sum, Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl (fun b' _ => ?_))
      rw [map_mul, Complex.conj_ofReal, ← hneg, hadd]
      ring
    simp_rw [h1]
    rw [Finset.sum_comm]
    refine (Finset.sum_congr rfl (fun b _ => Finset.sum_comm)).trans ?_
    simp_rw [← Finset.sum_mul, horth, add_neg_eq_zero, hg.eq_iff]
    simp only [ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    ring
  
  have hp2 : (2:ℝ) ≤ p := by exact_mod_cast (Fact.out : p.Prime).two_le
  have hP : (0:ℝ) < (p:ℝ) ^ d := pow_pos (by linarith) d
  have hR : (0:ℝ) < (r:ℝ) ^ d := pow_pos (by exact_mod_cast hr1) d
  
  obtain ⟨ι, hιdef⟩ : ∃ ι : (Fin d → Fin r) → Fin d → ZMod p,
      ι = fun b k => (((b k : ℕ)) : ZMod p) := ⟨_, rfl⟩
  have hι : Function.Injective ι := by
    intro b b' h
    funext k
    have hk := congrFun h k
    rw [hιdef] at hk
    simp only at hk
    rw [ZMod.natCast_eq_natCast_iff' _ _ p, Nat.mod_eq_of_lt (lt_of_lt_of_le (b k).isLt hrp),
      Nat.mod_eq_of_lt (lt_of_lt_of_le (b' k).isLt hrp)] at hk
    exact Fin.ext hk
  have hιneg : Function.Injective (fun b => -ι b) := neg_injective.comp hι
  
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : (Fin d → ZMod p) → ℝ, Ψ = fun y =>
      (∑ b : Fin d → Fin r, Φ (y + ι b)) / (r : ℝ) ^ d := ⟨_, rfl⟩
  
  have hs1 : ∑ x, zmodBoxSmooth r G x * Φ x = ∑ y, G y * Ψ y := by
    calc ∑ x, zmodBoxSmooth r G x * Φ x
        = ∑ x, ∑ b : Fin d → Fin r, G (x - ι b) * Φ x / (r:ℝ) ^ d := by
          refine Finset.sum_congr rfl (fun x _ => ?_)
          simp only [zmodBoxSmooth, hιdef]
          rw [div_mul_eq_mul_div, Finset.sum_mul, Finset.sum_div]
      _ = ∑ b : Fin d → Fin r, ∑ x, G (x - ι b) * Φ x / (r:ℝ) ^ d := Finset.sum_comm
      _ = ∑ b : Fin d → Fin r, ∑ y, G y * Φ (y + ι b) / (r:ℝ) ^ d := by
          refine Finset.sum_congr rfl (fun b _ => ?_)
          exact Fintype.sum_equiv (Equiv.subRight (ι b)) _ _
            (fun x => by simp only [Equiv.subRight_apply, sub_add_cancel])
      _ = ∑ y, ∑ b : Fin d → Fin r, G y * Φ (y + ι b) / (r:ℝ) ^ d := Finset.sum_comm
      _ = ∑ y, G y * Ψ y := by
          refine Finset.sum_congr rfl (fun y _ => ?_)
          simp only [hΨ]
          rw [mul_div_assoc', Finset.mul_sum, Finset.sum_div]
  
  obtain ⟨bet, hbet⟩ : ∃ bet : (Fin d → ZMod p) → ℂ, bet = fun ξ =>
      ∑ b : Fin d → Fin r, (ZMod.stdAddChar (∑ k, ξ k * (-ι b) k) : ℂ) * (((1:ℝ)) : ℂ) :=
    ⟨_, rfl⟩
  have hβ : ∑ ξ : Fin d → ZMod p, ‖bet ξ‖ ^ 2 = (p:ℝ) ^ d * (r:ℝ) ^ d := by
    have h := hplan (fun b => -ι b) hιneg (fun _ => (1:ℝ))
    beta_reduce at h
    rw [hbet]
    beta_reduce
    rw [h]
    simp [Fintype.card_fun]
  
  have hΨhat : ∀ ξ : Fin d → ZMod p,
      ∑ y, (ZMod.stdAddChar (∑ k, ξ k * y k) : ℂ) * ((Ψ y : ℝ) : ℂ)
        = ((r:ℂ) ^ d)⁻¹ * (bet ξ *
          ∑ x, (ZMod.stdAddChar (∑ k, ξ k * x k) : ℂ) * ((Φ x : ℝ) : ℂ)) := by
    intro ξ
    simp only [hΨ, hbet]
    push_cast
    simp only [mul_one]
    calc ∑ y, (ZMod.stdAddChar (∑ k, ξ k * y k) : ℂ)
            * ((∑ b : Fin d → Fin r, ((Φ (y + ι b) : ℝ) : ℂ)) / (r:ℂ) ^ d)
        = ∑ y, ∑ b : Fin d → Fin r, ((r:ℂ) ^ d)⁻¹
            * ((ZMod.stdAddChar (∑ k, ξ k * y k) : ℂ) * ((Φ (y + ι b) : ℝ) : ℂ)) := by
          refine Finset.sum_congr rfl (fun y _ => ?_)
          rw [div_eq_inv_mul, Finset.mul_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun b _ => ?_)
          ring
      _ = ∑ b : Fin d → Fin r, ∑ y, ((r:ℂ) ^ d)⁻¹
            * ((ZMod.stdAddChar (∑ k, ξ k * y k) : ℂ) * ((Φ (y + ι b) : ℝ) : ℂ)) :=
          Finset.sum_comm
      _ = ∑ b : Fin d → Fin r, ∑ x, ((r:ℂ) ^ d)⁻¹
            * ((ZMod.stdAddChar (∑ k, ξ k * (-ι b) k) : ℂ)
              * ((ZMod.stdAddChar (∑ k, ξ k * x k) : ℂ) * ((Φ x : ℝ) : ℂ))) := by
          refine Finset.sum_congr rfl (fun b _ => ?_)
          refine Fintype.sum_equiv (Equiv.addRight (ι b)) _ _ (fun y => ?_)
          simp only [Equiv.coe_addRight]
          have h := hadd ξ (y + ι b) (-ι b)
          rw [add_neg_cancel_right] at h
          rw [h]
          ring
      _ = ((r:ℂ) ^ d)⁻¹ * ((∑ b : Fin d → Fin r, (ZMod.stdAddChar (∑ k, ξ k * (-ι b) k) : ℂ))
            * ∑ x, (ZMod.stdAddChar (∑ k, ξ k * x k) : ℂ) * ((Φ x : ℝ) : ℂ)) := by
          rw [Finset.sum_mul, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun b _ => ?_)
          rw [Finset.mul_sum, Finset.mul_sum]
  
  have hbound : ∀ ξ : Fin d → ZMod p,
      ‖∑ y, (ZMod.stdAddChar (∑ k, ξ k * y k) : ℂ) * ((Ψ y : ℝ) : ℂ)‖ ^ 2
        ≤ ((r:ℝ) ^ d)⁻¹ ^ 2 * (‖bet ξ‖ ^ 2 * W2) := by
    intro ξ
    rw [hΨhat ξ, norm_mul, norm_mul, norm_inv, norm_pow, Complex.norm_natCast, mul_pow, mul_pow]
    gcongr
    exact hW ξ
  have hΨp := hplan (fun y => y) Function.injective_id Ψ
  beta_reduce at hΨp
  have hsumβ : ∑ ξ : Fin d → ZMod p, ((r:ℝ) ^ d)⁻¹ ^ 2 * (‖bet ξ‖ ^ 2 * W2)
      = (p:ℝ) ^ d * (W2 / (r:ℝ) ^ d) := by
    rw [← Finset.mul_sum, ← Finset.sum_mul, hβ]
    field_simp
  have hΨ2 : ∑ y, Ψ y ^ 2 ≤ W2 / (r:ℝ) ^ d := by
    have h := Finset.sum_le_sum (fun ξ (_ : ξ ∈ (Finset.univ : Finset (Fin d → ZMod p))) =>
      hbound ξ)
    rw [hΨp, hsumβ] at h
    exact le_of_mul_le_mul_left h hP
  rw [hs1]
  calc (∑ y, G y * Ψ y) ^ 2 ≤ (∑ y, G y ^ 2) * ∑ y, Ψ y ^ 2 :=
        Finset.sum_mul_sq_le_sq_mul_sq _ _ _
    _ ≤ (∑ y, G y ^ 2) * (W2 / (r:ℝ) ^ d) :=
        mul_le_mul_of_nonneg_left hΨ2 (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
    _ = (∑ x, G x ^ 2) / (r : ℝ) ^ d * W2 := by ring

theorem zmod_smoothing_error (p d N r : ℕ) [Fact p.Prime] (hp : 2 * N + 1 < p) (hr : 1 ≤ r)
    (Ω : Set (Fin d → ℝ)) (hΩ : Convex ℝ Ω) :
    ∑ x : Fin d → ZMod p,
        |zmodRegionInd p d N Ω x - zmodBoxSmooth r (zmodRegionInd p d N Ω) x|
      ≤ 2 * (d : ℝ) * ((r : ℝ) - 1) * (2 * (N : ℝ) + 1) ^ (d - 1) :=
by
  classical
  
  have s5 : ∀ (G : (Fin d → ZMod p) → ℝ) (B : ℝ),
      (∀ b : Fin d → Fin r,
        ∑ x : Fin d → ZMod p, |G x - G (x - fun k => (((b k : ℕ)) : ZMod p))| ≤ B) →
      ∑ x : Fin d → ZMod p, |G x - zmodBoxSmooth r G x| ≤ B := by
    intro G B hB
    have hr0 : (0:ℝ) < r := by exact_mod_cast hr
    have hc : (0:ℝ) < (r:ℝ)^d := by positivity
    have hcard : ((Finset.univ : Finset (Fin d → Fin r)).card : ℝ) = (r:ℝ)^d := by
      simp [Finset.card_univ]
    have key : ∀ x, |G x - zmodBoxSmooth r G x| ≤
        (∑ b : Fin d → Fin r, |G x - G (x - fun k => (((b k : ℕ)) : ZMod p))|) / (r:ℝ)^d := by
      intro x
      have h : G x - zmodBoxSmooth r G x =
          (∑ b : Fin d → Fin r, (G x - G (x - fun k => (((b k : ℕ)) : ZMod p)))) / (r:ℝ)^d := by
        unfold zmodBoxSmooth
        rw [Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul, hcard]
        field_simp
      rw [h, abs_div, abs_of_pos hc]
      exact div_le_div_of_nonneg_right (Finset.abs_sum_le_sum_abs _ _) hc.le
    calc ∑ x, |G x - zmodBoxSmooth r G x|
        ≤ ∑ x, (∑ b : Fin d → Fin r, |G x - G (x - fun k => (((b k : ℕ)) : ZMod p))|)
            / (r:ℝ)^d :=
          Finset.sum_le_sum (fun x _ => key x)
      _ = (∑ b : Fin d → Fin r, ∑ x, |G x - G (x - fun k => (((b k : ℕ)) : ZMod p))|)
            / (r:ℝ)^d := by
          rw [← Finset.sum_div, Finset.sum_comm]
      _ ≤ (∑ _b : Fin d → Fin r, B) / (r:ℝ)^d :=
          div_le_div_of_nonneg_right (Finset.sum_le_sum (fun b _ => hB b)) hc.le
      _ = B := by
          rw [Finset.sum_const, nsmul_eq_mul, hcard]
          field_simp
  
  have s1 : ∀ (G : (Fin d → ZMod p) → ℝ) (n : Fin d → ℕ),
      ∑ x : Fin d → ZMod p, |G x - G (x - fun k => ((n k : ℕ) : ZMod p))|
        ≤ ∑ k : Fin d, (n k : ℝ) *
            ∑ x : Fin d → ZMod p, |G x - G (x - Pi.single k (1 : ZMod p))| := by
    intro G n
    obtain ⟨D, hD⟩ : ∃ D : (Fin d → ZMod p) → ℝ, ∀ v, D v = ∑ x, |G x - G (x - v)| :=
      ⟨_, fun v => rfl⟩
    have D0 : D 0 = 0 := by rw [hD]; simp
    have Dadd : ∀ u w, D (u + w) ≤ D u + D w := by
      intro u w
      have h1 : ∀ x, |G x - G (x - (u + w))|
          ≤ |G x - G (x - u)| + |G (x - u) - G (x - u - w)| := by
        intro x; rw [sub_add_eq_sub_sub]; exact abs_sub_le _ _ _
      have h2 : ∑ x, |G (x - u) - G (x - u - w)| = ∑ x, |G x - G (x - w)| :=
        Fintype.sum_equiv (Equiv.subRight u) _ _ (fun x => rfl)
      rw [hD, hD, hD]
      calc ∑ x, |G x - G (x - (u + w))|
          ≤ ∑ x, (|G x - G (x - u)| + |G (x - u) - G (x - u - w)|) :=
            Finset.sum_le_sum (fun x _ => h1 x)
        _ = _ := by rw [Finset.sum_add_distrib, h2]
    have Dsmul : ∀ (m : ℕ) u, D (m • u) ≤ m * D u := by
      intro m u
      induction m with
      | zero => simp [D0]
      | succ m ih =>
        rw [succ_nsmul]; push_cast
        linarith [Dadd (m • u) u]
    have Dsum : ∀ (s : Finset (Fin d)) (v : Fin d → Fin d → ZMod p),
        D (∑ k ∈ s, v k) ≤ ∑ k ∈ s, D (v k) := by
      intro s v
      induction s using Finset.induction_on with
      | empty => simp [D0]
      | insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha]
        linarith [Dadd (v a) (∑ k ∈ s, v k)]
    have hid : (fun k => ((n k : ℕ) : ZMod p)) = ∑ k, (n k) • Pi.single k (1 : ZMod p) := by
      funext j
      simp [Finset.sum_apply, Pi.single_apply]
    have := Dsum Finset.univ (fun k => (n k) • Pi.single k (1 : ZMod p))
    rw [← hid] at this
    rw [← hD]
    refine this.trans (Finset.sum_le_sum (fun k _ => ?_))
    rw [← hD]
    exact Dsmul _ _
  
  have s3 : ∀ (k : Fin d) (a b c : Fin d → ℤ), (∀ j, j ≠ k → a j = b j) →
      (∀ j, j ≠ k → c j = a j) → a k < b k → a k ≤ c k → c k ≤ b k →
      (fun j => ((a j : ℤ) : ℝ)) ∈ Ω → (fun j => ((b j : ℤ) : ℝ)) ∈ Ω →
      (fun j => ((c j : ℤ) : ℝ)) ∈ Ω := by
    intro k a b c hab hc hlt hac hcb ha hb
    have hlt' : ((a k : ℤ) : ℝ) < ((b k : ℤ) : ℝ) := by exact_mod_cast hlt
    have hac' : ((a k : ℤ) : ℝ) ≤ ((c k : ℤ) : ℝ) := by exact_mod_cast hac
    have hcb' : ((c k : ℤ) : ℝ) ≤ ((b k : ℤ) : ℝ) := by exact_mod_cast hcb
    have hne : ((b k : ℤ) : ℝ) - ((a k : ℤ) : ℝ) ≠ 0 := (sub_pos.2 hlt').ne'
    obtain ⟨t, ht⟩ : ∃ t : ℝ,
        t = (((c k : ℤ) : ℝ) - ((a k : ℤ) : ℝ)) / (((b k : ℤ) : ℝ) - ((a k : ℤ) : ℝ)) :=
      ⟨_, rfl⟩
    have ht0 : 0 ≤ t := by rw [ht]; exact div_nonneg (by linarith) (by linarith)
    have ht1 : t ≤ 1 := by rw [ht, div_le_one (by linarith)]; linarith
    have hmem := hΩ ha hb (sub_nonneg.2 ht1) ht0 (by ring : (1 - t) + t = 1)
    convert hmem using 1
    funext j
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    by_cases hj : j = k
    · subst hj; rw [ht]; field_simp; ring
    · rw [hc j hj, hab j hj]; ring
  
  obtain ⟨P, hP⟩ : ∃ P : (Fin d → ZMod p) → Prop, ∀ x, P x ↔
      ∃ z ∈ intBox d N, (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (fun j => ((z j : ℤ) : ZMod p)) = x :=
    ⟨_, fun x => Iff.rfl⟩
  have hGP : ∀ x, (P x → zmodRegionInd p d N Ω x = 1) ∧
      (¬ P x → zmodRegionInd p d N Ω x = 0) := by
    intro x
    unfold zmodRegionInd
    split_ifs with h
    · simp only [Finset.mem_image, Finset.mem_filter] at h
      refine ⟨fun _ => rfl, fun hPx => absurd ?_ hPx⟩
      obtain ⟨z, ⟨hz1, hz2⟩, hz3⟩ := h
      exact (hP x).2 ⟨z, hz1, hz2, hz3⟩
    · simp only [Finset.mem_image, Finset.mem_filter, not_exists, not_and] at h
      refine ⟨fun hPx => ?_, fun _ => rfl⟩
      obtain ⟨z, hz1, hz2, hz3⟩ := (hP x).1 hPx
      exact absurd hz3 (h z ⟨hz1, hz2⟩)
  
  have endpt : ∀ (k : Fin d) (s : ℤ), (s = 1 ∨ s = -1) →
      ((Finset.univ.filter (fun x => P x ∧
          ¬ P (x + fun j => (((Pi.single k s : Fin d → ℤ) j : ℤ) : ZMod p)))).card : ℝ)
        ≤ (2 * (N : ℝ) + 1) ^ (d - 1) := by
    intro k s hs
    obtain ⟨ε, hε⟩ : ∃ ε : Fin d → ZMod p,
        ε = fun j => (((Pi.single k s : Fin d → ℤ) j : ℤ) : ZMod p) := ⟨_, rfl⟩
    rw [← hε]
    obtain ⟨T, hT⟩ : ∃ T : Finset (Fin d → ℤ), T = (intBox d N).filter (fun z =>
        (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ ¬ P ((fun j => ((z j : ℤ) : ZMod p)) + ε)) :=
      ⟨_, rfl⟩
    have hsub : Finset.univ.filter (fun x => P x ∧ ¬ P (x + ε))
        ⊆ T.image (fun z j => ((z j : ℤ) : ZMod p)) := by
      intro x hx
      rw [Finset.mem_filter] at hx
      obtain ⟨z, hz1, hz2, hz3⟩ := (hP x).1 hx.2.1
      rw [Finset.mem_image]
      refine ⟨z, ?_, hz3⟩
      rw [hT, Finset.mem_filter]
      exact ⟨hz1, hz2, by rw [hz3]; exact hx.2.2⟩
    obtain ⟨Bx, hBx⟩ : ∃ Bx : Finset ({j // j ≠ k} → ℤ),
        Bx = Fintype.piFinset (fun _ : {j // j ≠ k} => Finset.Icc (-(N : ℤ)) N) := ⟨_, rfl⟩
    have hBcard : (Bx.card : ℝ) = (2 * (N : ℝ) + 1) ^ (d - 1) := by
      rw [hBx, Fintype.card_piFinset]
      have h1 : (Finset.Icc (-(N : ℤ)) N).card = 2 * N + 1 := by simp; omega
      have h2 : Fintype.card {j // j ≠ k} = d - 1 := by simp
      simp only [h1, Finset.prod_const, Finset.card_univ, h2]
      push_cast; ring
    have hmaps : Set.MapsTo (fun z : Fin d → ℤ => fun j : {j // j ≠ k} => z j) T Bx := by
      intro z hz
      rw [Finset.mem_coe, hT, Finset.mem_filter] at hz
      rw [Finset.mem_coe, hBx, Fintype.mem_piFinset]
      intro j
      have h := hz.1
      unfold intBox at h
      rw [Finset.mem_Icc] at h
      exact Finset.mem_Icc.2 ⟨by simpa using h.1 j.1, by simpa using h.2 j.1⟩
    have hredadd : ∀ z w : Fin d → ℤ, (fun j => (((z + w) j : ℤ) : ZMod p))
        = (fun j => ((z j : ℤ) : ZMod p)) + (fun j => ((w j : ℤ) : ZMod p)) := by
      intro z w; funext j; simp
    have key : ∀ a ∈ T, ∀ b ∈ T, (∀ j, j ≠ k → a j = b j) → a k < b k → False := by
      intro a ha b hb hab hlt
      rw [hT, Finset.mem_filter] at ha hb
      obtain ⟨haB, haΩ, haP⟩ := ha
      obtain ⟨hbB, hbΩ, hbP⟩ := hb
      have haB' := haB
      have hbB' := hbB
      unfold intBox at haB' hbB'
      rw [Finset.mem_Icc] at haB' hbB'
      rcases hs with rfl | rfl
      · apply haP
        rw [hP]
        refine ⟨a + Pi.single k 1, ?_, ?_, ?_⟩
        · unfold intBox
          rw [Finset.mem_Icc]
          constructor
          · intro j
            have h1 := haB'.1 j
            simp only [Pi.add_apply, Pi.single_apply] at h1 ⊢
            split_ifs <;> omega
          · intro j
            have h1 := haB'.2 j
            have h2 := hbB'.2 j
            simp only [Pi.add_apply, Pi.single_apply] at h1 h2 ⊢
            split_ifs with hj
            · subst hj; omega
            · omega
        · refine s3 k a b _ hab ?_ hlt ?_ ?_ haΩ hbΩ
          · intro j hj; simp [hj]
          · simp
          · simp; omega
        · rw [hredadd, hε]
      · apply hbP
        rw [hP]
        refine ⟨b + Pi.single k (-1), ?_, ?_, ?_⟩
        · unfold intBox
          rw [Finset.mem_Icc]
          constructor
          · intro j
            have h1 := haB'.1 j
            have h2 := hbB'.1 j
            simp only [Pi.add_apply, Pi.single_apply] at h1 h2 ⊢
            split_ifs with hj
            · subst hj; omega
            · omega
          · intro j
            have h1 := hbB'.2 j
            simp only [Pi.add_apply, Pi.single_apply] at h1 ⊢
            split_ifs <;> omega
        · refine s3 k a b _ hab ?_ hlt ?_ ?_ haΩ hbΩ
          · intro j hj; simp [hj, hab j hj]
          · simp; omega
          · simp
        · rw [hredadd, hε]
    have hinj : Set.InjOn (fun z : Fin d → ℤ => fun j : {j // j ≠ k} => z j) T := by
      intro a ha b hb hab
      have hoff : ∀ j, j ≠ k → a j = b j := fun j hj => congrFun hab ⟨j, hj⟩
      rcases lt_trichotomy (a k) (b k) with h | h | h
      · exact (key a ha b hb hoff h).elim
      · funext j
        by_cases hj : j = k
        · subst hj; exact h
        · exact hoff j hj
      · exact (key b hb a ha (fun j hj => (hoff j hj).symm) h).elim
    calc ((Finset.univ.filter (fun x => P x ∧ ¬ P (x + ε))).card : ℝ)
        ≤ (T.image (fun z j => ((z j : ℤ) : ZMod p))).card := by
          exact_mod_cast Finset.card_le_card hsub
      _ ≤ T.card := by exact_mod_cast Finset.card_image_le
      _ ≤ Bx.card := by exact_mod_cast Finset.card_le_card_of_injOn _ hmaps hinj
      _ = _ := hBcard
  
  have s4 : ∀ k : Fin d, ∑ x : Fin d → ZMod p,
      |zmodRegionInd p d N Ω x - zmodRegionInd p d N Ω (x - Pi.single k (1 : ZMod p))|
        ≤ 2 * (2 * (N : ℝ) + 1) ^ (d - 1) := by
    intro k
    obtain ⟨e, he⟩ : ∃ e : Fin d → ZMod p, e = Pi.single k (1 : ZMod p) := ⟨_, rfl⟩
    rw [← he]
    have hpt : ∀ x, |zmodRegionInd p d N Ω x - zmodRegionInd p d N Ω (x - e)|
        ≤ (if P x ∧ ¬ P (x - e) then (1:ℝ) else 0)
          + (if P (x - e) ∧ ¬ P x then (1:ℝ) else 0) := by
      intro x
      by_cases h1 : P x <;> by_cases h2 : P (x - e)
      · rw [(hGP x).1 h1, (hGP (x - e)).1 h2]; simp [h1, h2]
      · rw [(hGP x).1 h1, (hGP (x - e)).2 h2]; simp [h1, h2]
      · rw [(hGP x).2 h1, (hGP (x - e)).1 h2]; simp [h1, h2]
      · rw [(hGP x).2 h1, (hGP (x - e)).2 h2]; simp [h1, h2]
    have hneg : (fun j => (((Pi.single k (-1) : Fin d → ℤ) j : ℤ) : ZMod p)) = -e := by
      rw [he]; funext j; by_cases hj : j = k
      · subst hj; simp
      · simp [hj]
    have hpos : (fun j => (((Pi.single k 1 : Fin d → ℤ) j : ℤ) : ZMod p)) = e := by
      rw [he]; funext j; by_cases hj : j = k
      · subst hj; simp
      · simp [hj]
    have hA := endpt k (-1) (Or.inr rfl)
    have hB := endpt k 1 (Or.inl rfl)
    rw [hneg] at hA
    rw [hpos] at hB
    have hsum1 : ∑ x : Fin d → ZMod p, (if P x ∧ ¬ P (x - e) then (1:ℝ) else 0)
        = ((Finset.univ.filter (fun x => P x ∧ ¬ P (x + -e))).card : ℝ) := by
      rw [Finset.sum_boole]
      simp only [sub_eq_add_neg]
    have hsum2 : ∑ x : Fin d → ZMod p, (if P (x - e) ∧ ¬ P x then (1:ℝ) else 0)
        = ((Finset.univ.filter (fun x => P x ∧ ¬ P (x + e))).card : ℝ) := by
      rw [Fintype.sum_equiv (Equiv.subRight e)
        (fun x => if P (x - e) ∧ ¬ P x then (1:ℝ) else 0)
        (fun y => if P y ∧ ¬ P (y + e) then (1:ℝ) else 0) (fun x => by simp)]
      rw [Finset.sum_boole]
    calc ∑ x, |zmodRegionInd p d N Ω x - zmodRegionInd p d N Ω (x - e)|
        ≤ ∑ x : Fin d → ZMod p, ((if P x ∧ ¬ P (x - e) then (1:ℝ) else 0)
            + (if P (x - e) ∧ ¬ P x then (1:ℝ) else 0)) :=
          Finset.sum_le_sum (fun x _ => hpt x)
      _ = ((Finset.univ.filter (fun x => P x ∧ ¬ P (x + -e))).card : ℝ)
            + ((Finset.univ.filter (fun x => P x ∧ ¬ P (x + e))).card : ℝ) := by
          rw [Finset.sum_add_distrib, hsum1, hsum2]
      _ ≤ (2 * (N : ℝ) + 1) ^ (d - 1) + (2 * (N : ℝ) + 1) ^ (d - 1) := add_le_add hA hB
      _ = 2 * (2 * (N : ℝ) + 1) ^ (d - 1) := by ring
  
  apply s5 _ (2 * (d : ℝ) * ((r : ℝ) - 1) * (2 * (N : ℝ) + 1) ^ (d - 1))
  intro b
  refine (s1 _ (fun k => (b k : ℕ))).trans ?_
  have hD0 : ∀ k : Fin d, 0 ≤ ∑ x : Fin d → ZMod p,
      |zmodRegionInd p d N Ω x - zmodRegionInd p d N Ω (x - Pi.single k (1 : ZMod p))| :=
    fun k => Finset.sum_nonneg (fun x _ => abs_nonneg _)
  have hr1 : (0:ℝ) ≤ (r:ℝ) - 1 := by
    have : (1:ℝ) ≤ r := by exact_mod_cast hr
    linarith
  calc ∑ k : Fin d, (((b k : ℕ) : ℕ) : ℝ) * ∑ x : Fin d → ZMod p,
        |zmodRegionInd p d N Ω x - zmodRegionInd p d N Ω (x - Pi.single k (1 : ZMod p))|
      ≤ ∑ _k : Fin d, ((r:ℝ) - 1) * (2 * (2 * (N : ℝ) + 1) ^ (d - 1)) := by
        apply Finset.sum_le_sum
        intro k _
        have hbk : ((b k : ℕ) : ℝ) ≤ (r:ℝ) - 1 := by
          have h := (b k).isLt
          have : ((b k : ℕ) : ℝ) + 1 ≤ r := by exact_mod_cast h
          linarith
        exact mul_le_mul hbk (s4 k) (hD0 k) hr1
    _ = 2 * (d : ℝ) * ((r : ℝ) - 1) * (2 * (N : ℝ) + 1) ^ (d - 1) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

theorem gowersU3Pow_zmod_transfer {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (R : ℝ) (hR : 0 ≤ R)
    (p : ℕ) [Fact p.Prime] (hp : 4 * ⌊R⌋₊ + 2 < p) (F : NumberField.RingOfIntegers K → ℝ) :
    zmodU3Sum (zmodLift ω p R F) = gowersU3Pow ω F R * ((omegaBox ω R).card : ℝ) ^ 4 :=
by
  classical
  
  have hmem : ∀ (M : ℝ) (x : NumberField.RingOfIntegers K),
      x ∈ omegaBox ω M ↔ ∀ j : Fin ν, |ω.repr x j| ≤ (⌊M⌋₊ : ℤ) := by
    intro M x
    unfold omegaBox intBox
    rw [Finset.mem_image]
    constructor
    · rintro ⟨v, hv, rfl⟩ j
      rw [Finset.mem_Icc] at hv
      have hvj : ω.repr (ω.equivFun.symm v) j = v j := by
        rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
      rw [hvj, abs_le]
      exact ⟨hv.1 j, hv.2 j⟩
    · intro h
      refine ⟨ω.equivFun x, ?_, ω.equivFun.symm_apply_apply x⟩
      rw [Finset.mem_Icc]
      refine ⟨fun j => ?_, fun j => ?_⟩
      · rw [Module.Basis.equivFun_apply]; exact (abs_le.mp (h j)).1
      · rw [Module.Basis.equivFun_apply]; exact (abs_le.mp (h j)).2
  have hbd : ∀ u ∈ omegaBox ω R, ∀ j : Fin ν, |ω.repr u j| ≤ (⌊R⌋₊ : ℤ) :=
    fun u hu => (hmem R u).1 hu
  
  have hred_add : ∀ a b : NumberField.RingOfIntegers K,
      omegaRed ω p (a + b) = omegaRed ω p a + omegaRed ω p b := by
    intro a b; funext j; simp [omegaRed]
  have hred_sub : ∀ a b : NumberField.RingOfIntegers K,
      omegaRed ω p (a - b) = omegaRed ω p a - omegaRed ω p b := by
    intro a b; funext j; simp [omegaRed]
  have hred_nsmul : ∀ (n : ℕ) (a : NumberField.RingOfIntegers K),
      omegaRed ω p (n • a) = n • omegaRed ω p a := by
    intro n a; funext j
    simp only [omegaRed, Pi.smul_apply, map_nsmul, Finsupp.smul_apply]
    simp only [nsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
  have hred_cube : ∀ (x h₁ h₂ h₃ : NumberField.RingOfIntegers K) (ε : Fin 3 → Fin 2),
      omegaRed ω p (cubeVertex x h₁ h₂ h₃ ε) =
        cubeVertex (omegaRed ω p x) (omegaRed ω p h₁) (omegaRed ω p h₂) (omegaRed ω p h₃) ε := by
    intro x h₁ h₂ h₃ ε
    simp only [cubeVertex, hred_add, hred_nsmul]
  
  have hrigid : ∀ a b : ℕ, a + b < p → ∀ w u : NumberField.RingOfIntegers K,
      (∀ j : Fin ν, |ω.repr w j| ≤ (a : ℤ)) → (∀ j : Fin ν, |ω.repr u j| ≤ (b : ℤ)) →
      omegaRed ω p w = omegaRed ω p u → w = u := by
    intro a b hab w u hw hu h
    apply ω.repr.injective
    ext j
    have hj := congrFun h j
    simp only [omegaRed] at hj
    rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at hj
    have hlt : |ω.repr u j - ω.repr w j| < (p : ℤ) := by
      have e1 := abs_sub (ω.repr u j) (ω.repr w j)
      have e2 := hw j
      have e3 := hu j
      have e4 : ((a : ℤ) + b) < p := by exact_mod_cast hab
      linarith
    have := Int.eq_zero_of_abs_lt_dvd hj hlt
    linarith
  
  have hL1 : ∀ z ∈ omegaBox ω R, zmodLift ω p R F (omegaRed ω p z) = F z := by
    intro z hz
    unfold zmodLift
    refine Finset.sum_eq_single_of_mem z ?_ ?_
    · exact Finset.mem_filter.2 ⟨hz, rfl⟩
    intro x hx hxz
    rw [Finset.mem_filter] at hx
    exact absurd (hrigid ⌊R⌋₊ ⌊R⌋₊ (by omega) x z (hbd x hx.1) (hbd z hz) hx.2) hxz
  have hL0 : ∀ y : Fin ν → ZMod p, (∀ x ∈ omegaBox ω R, omegaRed ω p x ≠ y) →
      zmodLift ω p R F y = 0 := by
    intro y hy
    unfold zmodLift
    apply Finset.sum_eq_zero
    intro x hx
    rw [Finset.mem_filter] at hx
    exact absurd hx.2 (hy x hx.1)
  
  have h2floor : 2 * (⌊R⌋₊ : ℤ) ≤ (⌊2 * R⌋₊ : ℤ) := by
    have : 2 * ⌊R⌋₊ ≤ ⌊2 * R⌋₊ := by
      apply Nat.le_floor
      push_cast
      have := Nat.floor_le hR
      linarith
    exact_mod_cast this
  have hdiff : ∀ u ∈ omegaBox ω R, ∀ v ∈ omegaBox ω R, ∀ j : Fin ν,
      |ω.repr (u - v) j| ≤ 2 * (⌊R⌋₊ : ℤ) := by
    intro u hu v hv j
    rw [map_sub, Finsupp.sub_apply]
    have e1 := abs_sub (ω.repr u j) (ω.repr v j)
    have e2 := hbd u hu j
    have e3 := hbd v hv j
    linarith
  
  have hlift : ∀ y k₁ k₂ k₃ : Fin ν → ZMod p,
      (∀ ε : Fin 3 → Fin 2, ∃ u ∈ omegaBox ω R, omegaRed ω p u = cubeVertex y k₁ k₂ k₃ ε) →
      ∃ x ∈ omegaBox ω R, ∃ g₁ ∈ omegaBox ω (2 * R), ∃ g₂ ∈ omegaBox ω (2 * R),
        ∃ g₃ ∈ omegaBox ω (2 * R),
          omegaRed ω p x = y ∧ omegaRed ω p g₁ = k₁ ∧ omegaRed ω p g₂ = k₂ ∧
          omegaRed ω p g₃ = k₃ ∧ ∀ ε : Fin 3 → Fin 2, cubeVertex x g₁ g₂ g₃ ε ∈ omegaBox ω R := by
    intro y k₁ k₂ k₃ hy
    have hyV : ∀ a b c : ℕ, a < 2 → b < 2 → c < 2 →
        ∃ u ∈ omegaBox ω R, omegaRed ω p u = y + a • k₁ + b • k₂ + c • k₃ := by
      intro a b c ha hb hc
      exact hy ![⟨a, ha⟩, ⟨b, hb⟩, ⟨c, hc⟩]
    obtain ⟨u₀, hu₀, r₀⟩ := hyV 0 0 0 (by norm_num) (by norm_num) (by norm_num)
    obtain ⟨u₁, hu₁, r₁⟩ := hyV 1 0 0 (by norm_num) (by norm_num) (by norm_num)
    obtain ⟨u₂, hu₂, r₂⟩ := hyV 0 1 0 (by norm_num) (by norm_num) (by norm_num)
    obtain ⟨u₃, hu₃, r₃⟩ := hyV 0 0 1 (by norm_num) (by norm_num) (by norm_num)
    simp only [zero_smul, one_smul, add_zero] at r₀ r₁ r₂ r₃
    obtain ⟨g₁, hg₁⟩ : ∃ g, g = u₁ - u₀ := ⟨_, rfl⟩
    obtain ⟨g₂, hg₂⟩ : ∃ g, g = u₂ - u₀ := ⟨_, rfl⟩
    obtain ⟨g₃, hg₃⟩ : ∃ g, g = u₃ - u₀ := ⟨_, rfl⟩
    have rg₁ : omegaRed ω p g₁ = k₁ := by rw [hg₁, hred_sub, r₁, r₀]; abel
    have rg₂ : omegaRed ω p g₂ = k₂ := by rw [hg₂, hred_sub, r₂, r₀]; abel
    have rg₃ : omegaRed ω p g₃ = k₃ := by rw [hg₃, hred_sub, r₃, r₀]; abel
    have bg₁ : ∀ j, |ω.repr g₁ j| ≤ 2 * (⌊R⌋₊ : ℤ) := by rw [hg₁]; exact hdiff u₁ hu₁ u₀ hu₀
    have bg₂ : ∀ j, |ω.repr g₂ j| ≤ 2 * (⌊R⌋₊ : ℤ) := by rw [hg₂]; exact hdiff u₂ hu₂ u₀ hu₀
    have bg₃ : ∀ j, |ω.repr g₃ j| ≤ 2 * (⌊R⌋₊ : ℤ) := by rw [hg₃]; exact hdiff u₃ hu₃ u₀ hu₀
    have mg₁ : g₁ ∈ omegaBox ω (2 * R) := (hmem (2 * R) g₁).2 (fun j => (bg₁ j).trans h2floor)
    have mg₂ : g₂ ∈ omegaBox ω (2 * R) := (hmem (2 * R) g₂).2 (fun j => (bg₂ j).trans h2floor)
    have mg₃ : g₃ ∈ omegaBox ω (2 * R) := (hmem (2 * R) g₃).2 (fun j => (bg₃ j).trans h2floor)
    have hext : ∀ a b c : ℕ, a < 2 → b < 2 → c < 2 → ∀ v ∈ omegaBox ω R,
        ∀ g : NumberField.RingOfIntegers K, (∀ j, |ω.repr g j| ≤ 2 * (⌊R⌋₊ : ℤ)) →
        u₀ + a • g₁ + b • g₂ + c • g₃ = v + g →
        u₀ + a • g₁ + b • g₂ + c • g₃ ∈ omegaBox ω R := by
      intro a b c ha hb hc v hv g hg heq
      obtain ⟨u, hu, hru⟩ := hyV a b c ha hb hc
      have hredV : omegaRed ω p (u₀ + a • g₁ + b • g₂ + c • g₃) = omegaRed ω p u := by
        rw [hru]; simp only [hred_add, hred_nsmul, r₀, rg₁, rg₂, rg₃]
      have hcoord : ∀ j, |ω.repr (u₀ + a • g₁ + b • g₂ + c • g₃) j| ≤ ((3 * ⌊R⌋₊ : ℕ) : ℤ) := by
        intro j
        rw [heq, map_add, Finsupp.add_apply]
        have e1 := hbd v hv j
        have e2 := hg j
        have e3 := abs_add_le (ω.repr v j) (ω.repr g j)
        push_cast
        linarith
      have := hrigid (3 * ⌊R⌋₊) ⌊R⌋₊ (by omega) _ u hcoord (hbd u hu) hredV
      rw [this]; exact hu
    have w000 : u₀ + (0 : ℕ) • g₁ + (0 : ℕ) • g₂ + (0 : ℕ) • g₃ ∈ omegaBox ω R := by
      simpa using hu₀
    have w100 := hext 1 0 0 (by norm_num) (by norm_num) (by norm_num) u₀ hu₀ g₁ bg₁ (by simp)
    have w010 := hext 0 1 0 (by norm_num) (by norm_num) (by norm_num) u₀ hu₀ g₂ bg₂ (by simp)
    have w001 := hext 0 0 1 (by norm_num) (by norm_num) (by norm_num) u₀ hu₀ g₃ bg₃ (by simp)
    have w110 := hext 1 1 0 (by norm_num) (by norm_num) (by norm_num) _ w100 g₂ bg₂ (by simp)
    have w101 := hext 1 0 1 (by norm_num) (by norm_num) (by norm_num) _ w100 g₃ bg₃ (by simp)
    have w011 := hext 0 1 1 (by norm_num) (by norm_num) (by norm_num) _ w010 g₃ bg₃ (by simp)
    have w111 := hext 1 1 1 (by norm_num) (by norm_num) (by norm_num) _ w110 g₃ bg₃ (by simp)
    refine ⟨u₀, hu₀, g₁, mg₁, g₂, mg₂, g₃, mg₃, r₀, rg₁, rg₂, rg₃, ?_⟩
    intro ε
    have h01 : ∀ i : Fin 2, (i : ℕ) = 0 ∨ (i : ℕ) = 1 := fun i => by have := i.isLt; omega
    show u₀ + ((ε 0 : ℕ)) • g₁ + ((ε 1 : ℕ)) • g₂ + ((ε 2 : ℕ)) • g₃ ∈ omegaBox ω R
    rcases h01 (ε 0) with h0 | h0 <;> rcases h01 (ε 1) with h1 | h1 <;>
      rcases h01 (ε 2) with h2 | h2 <;> rw [h0, h1, h2] <;> assumption
  
  have hcv0 : ∀ x h₁ h₂ h₃ : NumberField.RingOfIntegers K,
      cubeVertex x h₁ h₂ h₃ ![⟨0, by norm_num⟩, ⟨0, by norm_num⟩, ⟨0, by norm_num⟩] = x := by
    intro x h₁ h₂ h₃
    show x + (0 : ℕ) • h₁ + (0 : ℕ) • h₂ + (0 : ℕ) • h₃ = x
    simp
  have hcv1 : ∀ x h₁ h₂ h₃ : NumberField.RingOfIntegers K,
      cubeVertex x h₁ h₂ h₃ ![⟨1, by norm_num⟩, ⟨0, by norm_num⟩, ⟨0, by norm_num⟩] = x + h₁ := by
    intro x h₁ h₂ h₃
    show x + (1 : ℕ) • h₁ + (0 : ℕ) • h₂ + (0 : ℕ) • h₃ = x + h₁
    simp
  have hcv2 : ∀ x h₁ h₂ h₃ : NumberField.RingOfIntegers K,
      cubeVertex x h₁ h₂ h₃ ![⟨0, by norm_num⟩, ⟨1, by norm_num⟩, ⟨0, by norm_num⟩] = x + h₂ := by
    intro x h₁ h₂ h₃
    show x + (0 : ℕ) • h₁ + (1 : ℕ) • h₂ + (0 : ℕ) • h₃ = x + h₂
    simp
  have hcv3 : ∀ x h₁ h₂ h₃ : NumberField.RingOfIntegers K,
      cubeVertex x h₁ h₂ h₃ ![⟨0, by norm_num⟩, ⟨0, by norm_num⟩, ⟨1, by norm_num⟩] = x + h₃ := by
    intro x h₁ h₂ h₃
    show x + (0 : ℕ) • h₁ + (0 : ℕ) • h₂ + (1 : ℕ) • h₃ = x + h₃
    simp
  
  obtain ⟨tf, htf⟩ : ∃ tf : NumberField.RingOfIntegers K × NumberField.RingOfIntegers K ×
      NumberField.RingOfIntegers K × NumberField.RingOfIntegers K → ℝ,
      tf = fun q => ∏ ε : Fin 3 → Fin 2,
        (if cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε ∈ omegaBox ω R then
          F (cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε) else 0) := ⟨_, rfl⟩
  obtain ⟨sf, hsf⟩ : ∃ sf : (Fin ν → ZMod p) × (Fin ν → ZMod p) × (Fin ν → ZMod p) ×
      (Fin ν → ZMod p) → ℝ,
      sf = fun q => ∏ ε : Fin 3 → Fin 2,
        zmodLift ω p R F (cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε) := ⟨_, rfl⟩
  have hN1 : ∀ q, tf q ≠ 0 → ∀ ε : Fin 3 → Fin 2,
      cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε ∈ omegaBox ω R := by
    intro q hq ε
    by_contra hc
    apply hq
    rw [htf]
    exact Finset.prod_eq_zero (Finset.mem_univ ε) (if_neg hc)
  have hN2 : ∀ q, sf q ≠ 0 → ∀ ε : Fin 3 → Fin 2,
      ∃ u ∈ omegaBox ω R, omegaRed ω p u = cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε := by
    intro q hq ε
    by_contra hc
    push_neg at hc
    apply hq
    rw [hsf]
    exact Finset.prod_eq_zero (Finset.mem_univ ε) (hL0 _ hc)
  have hV : ∀ q, (∀ ε : Fin 3 → Fin 2, cubeVertex q.1 q.2.1 q.2.2.1 q.2.2.2 ε ∈ omegaBox ω R) →
      tf q = sf (omegaRed ω p q.1, omegaRed ω p q.2.1, omegaRed ω p q.2.2.1,
        omegaRed ω p q.2.2.2) := by
    intro q hq
    rw [htf, hsf]
    apply Finset.prod_congr rfl
    intro ε _
    rw [if_pos (hq ε), ← hred_cube, hL1 _ (hq ε)]
  have hS : ∑ q ∈ (Finset.univ : Finset (Fin ν → ZMod p)) ×ˢ ((Finset.univ : Finset (Fin ν → ZMod p))
      ×ˢ ((Finset.univ : Finset (Fin ν → ZMod p)) ×ˢ (Finset.univ : Finset (Fin ν → ZMod p)))), sf q
      = ∑ q ∈ omegaBox ω R ×ˢ (omegaBox ω (2 * R) ×ˢ (omegaBox ω (2 * R) ×ˢ omegaBox ω (2 * R))),
          tf q := by
    symm
    refine Finset.sum_bij_ne_zero
      (fun q _ _ => (omegaRed ω p q.1, omegaRed ω p q.2.1, omegaRed ω p q.2.2.1,
        omegaRed ω p q.2.2.2)) ?_ ?_ ?_ ?_
    · intro q _ _
      simp
    · rintro ⟨x, h₁, h₂, h₃⟩ _ hq0 ⟨x', h₁', h₂', h₃'⟩ _ hq0' heq
      simp only [Prod.mk.injEq] at heq
      obtain ⟨e0, e1, e2, e3⟩ := heq
      have A := hN1 _ hq0
      have A' := hN1 _ hq0'
      simp only at A A'
      have hx := A ![⟨0, by norm_num⟩, ⟨0, by norm_num⟩, ⟨0, by norm_num⟩]
      have hx1 := A ![⟨1, by norm_num⟩, ⟨0, by norm_num⟩, ⟨0, by norm_num⟩]
      have hx2 := A ![⟨0, by norm_num⟩, ⟨1, by norm_num⟩, ⟨0, by norm_num⟩]
      have hx3 := A ![⟨0, by norm_num⟩, ⟨0, by norm_num⟩, ⟨1, by norm_num⟩]
      have hx' := A' ![⟨0, by norm_num⟩, ⟨0, by norm_num⟩, ⟨0, by norm_num⟩]
      have hx1' := A' ![⟨1, by norm_num⟩, ⟨0, by norm_num⟩, ⟨0, by norm_num⟩]
      have hx2' := A' ![⟨0, by norm_num⟩, ⟨1, by norm_num⟩, ⟨0, by norm_num⟩]
      have hx3' := A' ![⟨0, by norm_num⟩, ⟨0, by norm_num⟩, ⟨1, by norm_num⟩]
      rw [hcv0] at hx hx'
      rw [hcv1] at hx1 hx1'
      rw [hcv2] at hx2 hx2'
      rw [hcv3] at hx3 hx3'
      have h2p : ⌊R⌋₊ + ⌊R⌋₊ < p := by omega
      have exx : x = x' := hrigid _ _ h2p x x' (hbd x hx) (hbd x' hx') e0
      subst exx
      have E1 : x + h₁ = x + h₁' :=
        hrigid _ _ h2p _ _ (hbd _ hx1) (hbd _ hx1') (by rw [hred_add, hred_add, e1])
      have E2 : x + h₂ = x + h₂' :=
        hrigid _ _ h2p _ _ (hbd _ hx2) (hbd _ hx2') (by rw [hred_add, hred_add, e2])
      have E3 : x + h₃ = x + h₃' :=
        hrigid _ _ h2p _ _ (hbd _ hx3) (hbd _ hx3') (by rw [hred_add, hred_add, e3])
      rw [add_left_cancel E1, add_left_cancel E2, add_left_cancel E3]
    · rintro ⟨y, k₁, k₂, k₃⟩ _ hne
      have hy := hN2 _ hne
      simp only at hy
      obtain ⟨x, hx, g₁, hg₁, g₂, hg₂, g₃, hg₃, r0, r1, r2, r3, hall⟩ := hlift y k₁ k₂ k₃ hy
      have hVq := hV (x, g₁, g₂, g₃) hall
      simp only at hVq
      rw [r0, r1, r2, r3] at hVq
      refine ⟨(x, g₁, g₂, g₃), ?_, ?_, ?_⟩
      · simp [hx, hg₁, hg₂, hg₃]
      · rw [hVq]; exact hne
      · simp only [r0, r1, r2, r3]
    · intro q _ hq0
      exact hV q (hN1 q hq0)
  rw [htf, hsf] at hS
  simp only [Finset.sum_product] at hS
  have h0 : (0 : NumberField.RingOfIntegers K) ∈ omegaBox ω R :=
    (hmem R 0).2 (fun j => by simp)
  have hcard : ((omegaBox ω R).card : ℝ) ^ 4 ≠ 0 :=
    pow_ne_zero 4 (Nat.cast_ne_zero.2 (Finset.card_pos.2 ⟨0, h0⟩).ne')
  unfold gowersU3Pow zmodU3Sum
  rw [div_mul_cancel₀ _ hcard]
  exact hS

theorem pair_surjective_mod_prime (K : Type u) [Field K] [NumberField K] (d : ℕ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (hCOK : ∀ i j : Fin 4, i ≠ j → Finite (NumberField.RingOfIntegers K ⧸
        Submodule.map (homMap (c i)) (LinearMap.ker (homMap (c j)))))
    (L : ℝ) (hL : 1 ≤ L) (hc : ∀ i k, basisSupNorm ω (c i k) ≤ L)
    (p : ℕ) [Fact p.Prime]
    (hp : ((2 * Module.finrank ℚ K).factorial : ℝ) * L ^ (2 * Module.finrank ℚ K) < p)
    (i j : Fin 4) (hij : i ≠ j) :
    ∀ u w : Fin (Module.finrank ℚ K) → ZMod p, ∃ x : Fin d → ZMod p,
      (∑ k, x k • omegaRed ω p (c i k) = u) ∧ (∑ k, x k • omegaRed ω p (c j k) = w) :=
by
  classical
  intro u w
  obtain ⟨hpos, hbd⟩ := kai_pair_index_bound K d ω c hCOK i j hij
  have hle := hbd L hL hc
  obtain ⟨I, hI_def⟩ : ∃ I : ℕ, I = Nat.card
      ((NumberField.RingOfIntegers K × NumberField.RingOfIntegers K) ⧸
        LinearMap.range ((homMap (c i)).prod (homMap (c j)))) := ⟨_, rfl⟩
  rw [← hI_def] at hpos hle
  have hIp : I < p := by
    have h : (I : ℝ) < p := lt_of_le_of_lt hle hp
    exact_mod_cast h
  have hpp : p.Prime := Fact.out
  have hndvd : ¬ p ∣ I := fun h => absurd (Nat.le_of_dvd hpos h) (not_le.2 hIp)
  have hcop : Nat.Coprime p I := (Nat.Prime.coprime_iff_not_dvd hpp).2 hndvd
  have hbez : (p : ℤ) * Nat.gcdA p I + (I : ℤ) * Nat.gcdB p I = 1 := by
    rw [← Nat.gcd_eq_gcd_ab, hcop.gcd_eq_one, Nat.cast_one]
  
  have hmem : ∀ v : NumberField.RingOfIntegers K × NumberField.RingOfIntegers K,
      I • v ∈ LinearMap.range ((homMap (c i)).prod (homMap (c j))) := by
    intro v
    rw [← Submodule.Quotient.mk_eq_zero, hI_def]
    have h1 := map_nsmul (LinearMap.range ((homMap (c i)).prod (homMap (c j)))).mkQ
      (Nat.card ((NumberField.RingOfIntegers K × NumberField.RingOfIntegers K) ⧸
        LinearMap.range ((homMap (c i)).prod (homMap (c j))))) v
    rw [card_nsmul_eq_zero'] at h1
    exact h1
  
  have hlift : ∀ u' : Fin (Module.finrank ℚ K) → ZMod p, ∃ a : NumberField.RingOfIntegers K,
      omegaRed ω p a = u' := by
    intro u'
    refine ⟨ω.equivFun.symm (fun t => (((u' t).val : ℕ) : ℤ)), ?_⟩
    funext t
    have h : ω.repr (ω.equivFun.symm (fun t => (((u' t).val : ℕ) : ℤ))) t
        = (((u' t).val : ℕ) : ℤ) := by
      rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    simp only [omegaRed, h, Int.cast_natCast, ZMod.natCast_zmod_val]
  obtain ⟨a, ha⟩ := hlift u
  obtain ⟨b, hb⟩ := hlift w
  
  set m : ℤ := (p : ℤ) * Nat.gcdA p I with hm_def
  have hy : ((a, b) : NumberField.RingOfIntegers K × NumberField.RingOfIntegers K)
      - m • (a, b) ∈ LinearMap.range ((homMap (c i)).prod (homMap (c j))) := by
    have e : ((a, b) : NumberField.RingOfIntegers K × NumberField.RingOfIntegers K)
        - m • (a, b) = Nat.gcdB p I • (I • (a, b)) := by
      have hc : (1 : ℤ) - m = (I : ℤ) * Nat.gcdB p I := by linear_combination -hbez
      calc ((a, b) : NumberField.RingOfIntegers K × NumberField.RingOfIntegers K) - m • (a, b)
          = ((1 : ℤ) - m) • ((a, b) : NumberField.RingOfIntegers K ×
              NumberField.RingOfIntegers K) := by rw [sub_smul, one_smul]
        _ = ((I : ℤ) * Nat.gcdB p I) • ((a, b) : NumberField.RingOfIntegers K ×
              NumberField.RingOfIntegers K) := by rw [hc]
        _ = Nat.gcdB p I • (I • (a, b)) := by
          rw [mul_comm (I : ℤ) (Nat.gcdB p I), mul_smul, natCast_zsmul]
    rw [e]
    exact Submodule.smul_mem _ _ (hmem _)
  obtain ⟨z, hz⟩ := LinearMap.mem_range.1 hy
  have hzi : homMap (c i) z = a - m • a := by
    have := congrArg Prod.fst hz
    simpa using this
  have hzj : homMap (c j) z = b - m • b := by
    have := congrArg Prod.snd hz
    simpa using this
  
  have hred : ∀ c' : Fin d → NumberField.RingOfIntegers K,
      ∑ k, ((z k : ℤ) : ZMod p) • omegaRed ω p (c' k) = omegaRed ω p (homMap c' z) := by
    intro c'
    funext t
    simp only [omegaRed, homMap, LinearMap.coe_mk, AddHom.coe_mk, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul, map_sum, map_zsmul, Finsupp.coe_finset_sum,
      Finsupp.coe_smul, Int.cast_sum, Int.cast_mul]
  have hkill : ∀ e : NumberField.RingOfIntegers K, omegaRed ω p (e - m • e) = omegaRed ω p e := by
    intro e
    funext t
    simp only [omegaRed, map_sub, map_zsmul, Finsupp.coe_sub, Finsupp.coe_smul, Pi.sub_apply,
      Pi.smul_apply, smul_eq_mul, Int.cast_sub, Int.cast_mul, hm_def, Int.cast_natCast,
      ZMod.natCast_self, zero_mul, sub_zero]
  refine ⟨fun k => ((z k : ℤ) : ZMod p), ?_, ?_⟩
  · rw [hred, hzi, hkill, ha]
  · rw [hred, hzj, hkill, hb]

theorem kaiFormSum_eq_zmod_sum (K : Type u) [Field K] [NumberField K] (d : ℕ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (L : ℝ) (N : ℕ) (Ω : Set (Fin d → ℝ)) (hL : 0 ≤ L)
    (hc : ∀ i k, basisSupNorm ω (c i k) ≤ L) (hc₀ : ∀ i, basisSupNorm ω (c₀ i) ≤ L * (N : ℝ))
    (hΩ : Ω ⊆ realBox d (N : ℝ)) (p : ℕ) [Fact p.Prime] (hpN : 2 * N < p)
    (hpR : 2 * ⌊((d : ℝ) + 1) * L * (N : ℝ)⌋₊ < p)
    (H : Fin 4 → NumberField.RingOfIntegers K → ℝ) :
    kaiFormSum H c₀ c Ω N = ∑ x : Fin d → ZMod p, zmodRegionInd p d N Ω x *
      ∏ i : Fin 4, zmodLift ω p (((d : ℝ) + 1) * L * (N : ℝ)) (H i)
        (omegaRed ω p (c₀ i) + ∑ k, x k • omegaRed ω p (c i k)) :=
by
  classical
  
  have hinj : ∀ (m : ℕ) (a b : ℤ), 2 * m < p → |a| ≤ (m : ℤ) → |b| ≤ (m : ℤ) →
      ((a : ZMod p) = (b : ZMod p)) → a = b := by
    intro m a b hm ha hb hab
    rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at hab
    have hm' : 2 * (m : ℤ) < (p : ℤ) := by exact_mod_cast hm
    have h1 : |b - a| < (p : ℤ) := by
      rw [abs_le] at ha hb
      rw [abs_lt]
      constructor <;> omega
    have := Int.eq_zero_of_abs_lt_dvd hab h1
    omega
  
  have hcoord : ∀ (M : ℝ) (x : NumberField.RingOfIntegers K), x ∈ omegaBox ω M →
      ∀ j, |ω.repr x j| ≤ ((⌊M⌋₊ : ℕ) : ℤ) := by
    intro M x hx j
    unfold omegaBox at hx
    rw [Finset.mem_image] at hx
    obtain ⟨v, hv, rfl⟩ := hx
    unfold intBox at hv
    rw [Finset.mem_Icc] at hv
    have hrep : ω.repr (ω.equivFun.symm v) j = v j := by
      have h := congrFun (ω.equivFun.apply_symm_apply v) j
      simpa only [Module.Basis.equivFun_apply] using h
    rw [hrep, abs_le]
    exact ⟨by simpa using hv.1 j, by simpa using hv.2 j⟩
  
  have hlift : ∀ (F : NumberField.RingOfIntegers K → ℝ) (a : NumberField.RingOfIntegers K),
      a ∈ omegaBox ω (((d : ℝ) + 1) * L * (N : ℝ)) →
      zmodLift ω p (((d : ℝ) + 1) * L * (N : ℝ)) F (omegaRed ω p a) = F a := by
    intro F a ha
    unfold zmodLift
    rw [Finset.sum_filter, Finset.sum_eq_single_of_mem a ha]
    · simp
    · intro b hb hba
      rw [if_neg]
      intro hred
      apply hba
      apply ω.ext_elem
      intro j
      have hj := congrFun hred j
      simp only [omegaRed] at hj
      exact hinj _ _ _ hpR (hcoord _ b hb j) (hcoord _ a ha j) hj
  
  have hformula : ∀ (i : Fin 4) (z : Fin d → ℤ) (j : Fin (Module.finrank ℚ K)),
      ω.repr (affEval (c₀ i) (c i) z) j = ω.repr (c₀ i) j + ∑ k, z k * ω.repr (c i k) j := by
    intro i z j
    unfold affEval
    rw [map_add, map_sum, Finsupp.add_apply, Finsupp.coe_finset_sum, Finset.sum_apply]
    congr 1
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_zsmul, Finsupp.smul_apply, smul_eq_mul]
  have hred : ∀ (i : Fin 4) (z : Fin d → ℤ),
      omegaRed ω p (c₀ i) + ∑ k, ((z k : ℤ) : ZMod p) • omegaRed ω p (c i k)
        = omegaRed ω p (affEval (c₀ i) (c i) z) := by
    intro i z
    funext j
    simp only [omegaRed, hformula, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Int.cast_add, Int.cast_sum, Int.cast_mul]
  
  have hsup : ∀ (y : NumberField.RingOfIntegers K) (j : Fin (Module.finrank ℚ K)),
      |((ω.repr y j : ℤ) : ℝ)| ≤ basisSupNorm ω y := by
    intro y j
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr y j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  have hmemBox : ∀ (i : Fin 4) (z : Fin d → ℤ), (∀ k, |((z k : ℤ) : ℝ)| ≤ (N : ℝ)) →
      affEval (c₀ i) (c i) z ∈ omegaBox ω (((d : ℝ) + 1) * L * (N : ℝ)) := by
    intro i z hz
    have hN : (0 : ℝ) ≤ N := Nat.cast_nonneg N
    have hbound : ∀ j, |((ω.repr (affEval (c₀ i) (c i) z) j : ℤ) : ℝ)|
        ≤ ((d : ℝ) + 1) * L * N := by
      intro j
      rw [hformula i z j]
      push_cast
      have hsum : |∑ k, ((z k : ℤ) : ℝ) * ((ω.repr (c i k) j : ℤ) : ℝ)|
          ≤ ∑ _k : Fin d, (N : ℝ) * L := by
        refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
        apply Finset.sum_le_sum
        intro k _
        rw [abs_mul]
        exact mul_le_mul (hz k) ((hsup (c i k) j).trans (hc i k)) (abs_nonneg _) hN
      have h0 : |((ω.repr (c₀ i) j : ℤ) : ℝ)| ≤ L * N := (hsup (c₀ i) j).trans (hc₀ i)
      have hcs : ∑ _k : Fin d, (N : ℝ) * L = (d : ℝ) * ((N : ℝ) * L) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      calc |((ω.repr (c₀ i) j : ℤ) : ℝ) + ∑ k, ((z k : ℤ) : ℝ) * ((ω.repr (c i k) j : ℤ) : ℝ)|
          ≤ |((ω.repr (c₀ i) j : ℤ) : ℝ)|
              + |∑ k, ((z k : ℤ) : ℝ) * ((ω.repr (c i k) j : ℤ) : ℝ)| := abs_add_le _ _
        _ ≤ L * N + (d : ℝ) * ((N : ℝ) * L) := by rw [← hcs]; exact add_le_add h0 hsum
        _ = ((d : ℝ) + 1) * L * N := by ring
    have hint : ∀ j, -((⌊((d : ℝ) + 1) * L * N⌋₊ : ℕ) : ℤ) ≤ ω.repr (affEval (c₀ i) (c i) z) j ∧
        ω.repr (affEval (c₀ i) (c i) z) j ≤ ((⌊((d : ℝ) + 1) * L * N⌋₊ : ℕ) : ℤ) := by
      intro j
      have h1 : (((ω.repr (affEval (c₀ i) (c i) z) j).natAbs : ℕ) : ℝ)
          ≤ ((d : ℝ) + 1) * L * N := by
        rw [Nat.cast_natAbs, Int.cast_abs]; exact hbound j
      have h2 := Nat.le_floor h1
      omega
    unfold omegaBox
    rw [Finset.mem_image]
    refine ⟨ω.equivFun (affEval (c₀ i) (c i) z), ?_, LinearEquiv.symm_apply_apply _ _⟩
    unfold intBox
    rw [Finset.mem_Icc]
    constructor
    · intro j
      rw [Module.Basis.equivFun_apply]
      exact (hint j).1
    · intro j
      rw [Module.Basis.equivFun_apply]
      exact (hint j).2
  
  have hS : ∀ Φ : (Fin d → ZMod p) → ℝ, ∑ x, zmodRegionInd p d N Ω x * Φ x =
      ∑ z ∈ intBox d N, if (fun k => ((z k : ℤ) : ℝ)) ∈ Ω
        then Φ (fun k => ((z k : ℤ) : ZMod p)) else 0 := by
    intro Φ
    unfold zmodRegionInd
    simp only [ite_mul, one_mul, zero_mul]
    rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_image, Finset.sum_filter]
    intro z hz z' hz' hzz
    have hzB := (Finset.mem_filter.mp hz).1
    have hzB' := (Finset.mem_filter.mp hz').1
    unfold intBox at hzB hzB'
    rw [Finset.mem_Icc] at hzB hzB'
    funext k
    have hk := congrFun hzz k
    simp only at hk
    refine hinj N _ _ hpN ?_ ?_ hk
    · rw [abs_le]; exact ⟨by simpa using hzB.1 k, by simpa using hzB.2 k⟩
    · rw [abs_le]; exact ⟨by simpa using hzB'.1 k, by simpa using hzB'.2 k⟩
  
  rw [hS (fun x => ∏ i : Fin 4, zmodLift ω p (((d : ℝ) + 1) * L * (N : ℝ)) (H i)
      (omegaRed ω p (c₀ i) + ∑ k, x k • omegaRed ω p (c i k)))]
  unfold kaiFormSum
  refine Finset.sum_congr rfl (fun z hz => ?_)
  have hzB := hz
  unfold intBox at hzB
  rw [Finset.mem_Icc] at hzB
  have hzN : ∀ k, |((z k : ℤ) : ℝ)| ≤ (N : ℝ) := by
    intro k
    have h1 : -(N : ℤ) ≤ z k := by simpa using hzB.1 k
    have h2 : z k ≤ (N : ℤ) := by simpa using hzB.2 k
    rw [abs_le]
    constructor
    · have := (Int.cast_le (R := ℝ)).mpr h1
      push_cast at this
      linarith
    · have := (Int.cast_le (R := ℝ)).mpr h2
      push_cast at this
      linarith
  split_ifs with hzΩ
  · refine Finset.prod_congr rfl (fun i _ => ?_)
    have hmem := hmemBox i z hzN
    show H i (affEval (c₀ i) (c i) z) = zmodLift ω p (((d : ℝ) + 1) * L * (N : ℝ)) (H i)
      (omegaRed ω p (c₀ i) + ∑ k, ((z k : ℤ) : ZMod p) • omegaRed ω p (c i k))
    rw [hred i z, hlift _ _ hmem]
  · rfl

theorem zmodLift_basic {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) (p : ℕ) [Fact p.Prime]
    (hp : 2 * ⌊M⌋₊ < p) :
    ((omegaBox ω M).card : ℝ) ≤ (p : ℝ) ^ ν ∧
    (∀ (F : NumberField.RingOfIntegers K → ℝ) (T : ℝ), (∀ x ∈ omegaBox ω M, |F x| ≤ T) →
      0 ≤ T → ∀ y, |zmodLift ω p M F y| ≤ T) :=
by
  classical
  have hcoord : ∀ v : Fin ν → ℤ, ∀ j, ω.repr (ω.equivFun.symm v) j = v j := by
    intro v j
    have h := congrFun (ω.equivFun_apply (ω.equivFun.symm v)) j
    rw [LinearEquiv.apply_symm_apply] at h
    exact h.symm
  have hp' : 2 * ((⌊M⌋₊ : ℕ) : ℤ) < (p : ℤ) := by exact_mod_cast hp
  have hsep : ∀ a b : ℤ, -((⌊M⌋₊ : ℕ) : ℤ) ≤ a → a ≤ ((⌊M⌋₊ : ℕ) : ℤ) →
      -((⌊M⌋₊ : ℕ) : ℤ) ≤ b → b ≤ ((⌊M⌋₊ : ℕ) : ℤ) →
      ((a : ZMod p) = (b : ZMod p)) → a = b := by
    intro a b ha1 ha2 hb1 hb2 hab
    rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at hab
    have h0 := Int.eq_zero_of_abs_lt_dvd hab (by rw [abs_lt]; constructor <;> omega)
    omega
  have hmem : ∀ x ∈ omegaBox ω M, ∃ v : Fin ν → ℤ,
      (∀ j, -((⌊M⌋₊ : ℕ) : ℤ) ≤ v j ∧ v j ≤ ((⌊M⌋₊ : ℕ) : ℤ)) ∧ ω.equivFun.symm v = x := by
    intro x hx
    unfold omegaBox at hx
    rw [Finset.mem_image] at hx
    obtain ⟨v, hv, rfl⟩ := hx
    refine ⟨v, fun j => ?_, rfl⟩
    unfold intBox at hv
    rw [Finset.mem_Icc] at hv
    exact ⟨hv.1 j, hv.2 j⟩
  have hinj : ∀ x ∈ omegaBox ω M, ∀ x' ∈ omegaBox ω M,
      omegaRed ω p x = omegaRed ω p x' → x = x' := by
    intro x hx x' hx' h
    obtain ⟨v, hv, rfl⟩ := hmem x hx
    obtain ⟨w, hw, rfl⟩ := hmem x' hx'
    have hvw : v = w := by
      funext j
      have hj := congrFun h j
      simp only [omegaRed, hcoord] at hj
      exact hsep _ _ (hv j).1 (hv j).2 (hw j).1 (hw j).2 hj
    rw [hvw]
  refine ⟨?_, ?_⟩
  · have h1 : (omegaBox ω M).card ≤ (intBox ν ⌊M⌋₊).card := by
      unfold omegaBox
      exact Finset.card_image_le
    have h2 : (intBox ν ⌊M⌋₊).card = (2 * ⌊M⌋₊ + 1) ^ ν := by
      unfold intBox
      rw [Pi.card_Icc]
      simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      congr 1
      omega
    have h3 : (2 * ⌊M⌋₊ + 1) ^ ν ≤ p ^ ν := Nat.pow_le_pow_left (by omega) ν
    have h4 : (omegaBox ω M).card ≤ p ^ ν := h1.trans (h2.le.trans h3)
    exact_mod_cast h4
  · intro F T hF hT y
    unfold zmodLift
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_card_nsmul _ _ T ?_).trans ?_
    · intro x hx
      exact hF x (Finset.mem_filter.1 hx).1
    · rw [nsmul_eq_mul]
      have hcard : ((omegaBox ω M).filter (fun x => omegaRed ω p x = y)).card ≤ 1 := by
        rw [Finset.card_le_one]
        intro a ha b hb
        rw [Finset.mem_filter] at ha hb
        exact hinj a ha.1 b hb.1 (ha.2.trans hb.2.symm)
      have hcard' : (((omegaBox ω M).filter (fun x => omegaRed ω p x = y)).card : ℝ) ≤ 1 := by
        exact_mod_cast hcard
      calc (((omegaBox ω M).filter (fun x => omegaRed ω p x = y)).card : ℝ) * T
          ≤ 1 * T := mul_le_mul_of_nonneg_right hcard' hT
        _ = T := one_mul T

theorem kaiFormSum_telescope (K : Type u) [Field K] [NumberField K] (d : ℕ)
    (f g : Fin 4 → NumberField.RingOfIntegers K → ℝ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (Ω : Set (Fin d → ℝ)) (N : ℕ) :
    kaiFormSum f c₀ c Ω N - kaiFormSum g c₀ c Ω N = ∑ j : Fin 4, kaiFormSum
      (fun i x => if i < j then g i x else if i = j then f i x - g i x else f i x)
      c₀ c Ω N :=
by
  unfold kaiFormSum
  rw [← Finset.sum_sub_distrib, Finset.sum_comm]
  refine Finset.sum_congr rfl (fun z _ => ?_)
  by_cases hz : (fun k => ((z k : ℤ) : ℝ)) ∈ Ω
  · simp only [if_pos hz, Fin.sum_univ_four, Fin.prod_univ_four]
    simp (config := {decide := true})
    ring
  · simp only [if_neg hz, sub_self, Finset.sum_const_zero]

theorem smoothing_radius_choice (N d : ℕ) (hd : 1 ≤ d) (δ : ℝ) (hδ0 : 0 ≤ δ) (hδ1 : δ < 1) :
    ∃ r : ℕ, 1 ≤ r ∧ r ≤ 2 * N + 1 ∧
      ((r : ℝ) - 1) * (2 * (N : ℝ) + 1) ^ (d - 1) ≤ (2 * (N : ℝ) + 1) ^ d * δ ∧
      (2 * (N : ℝ) + 1) ^ d * δ ^ (d + 2) ≤ 2 ^ d * δ ^ 2 * (r : ℝ) ^ d :=
by
  set M : ℝ := 2 * (N : ℝ) + 1 with hM_def
  have hM1 : (1 : ℝ) ≤ M := by
    have : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
    linarith
  have hMpos : (0 : ℝ) < M := by linarith
  have hx0 : 0 ≤ M * δ := mul_nonneg hMpos.le hδ0
  have hxM : M * δ < M := by
    calc M * δ < M * 1 := mul_lt_mul_of_pos_left hδ1 hMpos
      _ = M := mul_one M
  refine ⟨⌊M * δ⌋₊ + 1, by omega, ?_, ?_, ?_⟩
  · have hMnat : M = ((2 * N + 1 : ℕ) : ℝ) := by rw [hM_def]; push_cast; ring
    have h1 : ⌊M * δ⌋₊ < 2 * N + 1 := by
      rw [Nat.floor_lt hx0]
      rw [← hMnat]
      exact hxM
    omega
  · have hfl : ((⌊M * δ⌋₊ : ℕ) : ℝ) ≤ M * δ := Nat.floor_le hx0
    have hcast : (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ) - 1) = ((⌊M * δ⌋₊ : ℕ) : ℝ) := by
      push_cast; ring
    rw [hcast]
    have hMd : M ^ d = M * M ^ (d - 1) := by
      rw [← pow_succ', Nat.sub_add_cancel hd]
    calc ((⌊M * δ⌋₊ : ℕ) : ℝ) * M ^ (d - 1) ≤ (M * δ) * M ^ (d - 1) :=
          mul_le_mul_of_nonneg_right hfl (pow_nonneg hMpos.le _)
      _ = M ^ d * δ := by rw [hMd]; ring
  · have hlt : M * δ < (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ)) := by
      push_cast
      exact Nat.lt_floor_add_one _
    have hpow : (M * δ) ^ d ≤ (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ)) ^ d :=
      pow_le_pow_left₀ hx0 hlt.le d
    have h2d : (1 : ℝ) ≤ 2 ^ d := one_le_pow₀ (by norm_num)
    have hnn : 0 ≤ δ ^ 2 * (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ)) ^ d := by positivity
    calc M ^ d * δ ^ (d + 2) = δ ^ 2 * (M * δ) ^ d := by rw [mul_pow, pow_add]; ring
      _ ≤ δ ^ 2 * (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ)) ^ d :=
          mul_le_mul_of_nonneg_left hpow (by positivity)
      _ = 1 * (δ ^ 2 * (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ)) ^ d) := by ring
      _ ≤ 2 ^ d * (δ ^ 2 * (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ)) ^ d) :=
          mul_le_mul_of_nonneg_right h2d hnn
      _ = 2 ^ d * δ ^ 2 * (((⌊M * δ⌋₊ + 1 : ℕ) : ℝ)) ^ d := by ring

theorem kai_von_neumann_U3 (K : Type u) [Field K] [NumberField K] (d : ℕ) (hd : 1 ≤ d)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C_vN : ℝ, 0 ≤ C_vN ∧ ∃ K₀ J : ℕ,
      ∀ (c₀ : Fin 4 → NumberField.RingOfIntegers K)
        (c : Fin 4 → Fin d → NumberField.RingOfIntegers K),
        (∀ i j : Fin 4, i ≠ j →
            Finite (NumberField.RingOfIntegers K ⧸
              Submodule.map (homMap (c i)) (LinearMap.ker (homMap (c j))))) →
        ∀ (L : ℝ) (N : ℕ) (Ω : Set (Fin d → ℝ)), 1 ≤ L →
          (∀ i k, basisSupNorm ω (c i k) ≤ L) →
          (∀ i, basisSupNorm ω (c₀ i) ≤ L * (N : ℝ)) →
          C_vN * L ^ K₀ ≤ (N : ℝ) →
          MeasurableSet Ω → Convex ℝ Ω → Ω ⊆ realBox d (N : ℝ) →
          ∀ (f g : Fin 4 → NumberField.RingOfIntegers K → ℝ) (T δ : ℝ), 1 ≤ T → 0 ≤ δ →
            (∀ i x, x ∈ omegaBox ω (((d : ℝ) + 1) * L * (N : ℝ)) →
                |f i x| ≤ T ∧ |g i x| ≤ T) →
            (∀ i, gowersU3Pow ω (fun x => f i x - g i x) (((d : ℝ) + 1) * L * (N : ℝ))
                ≤ δ ^ (J + 1)) →
            |kaiFormSum f c₀ c Ω N - kaiFormSum g c₀ c Ω N|
              ≤ C_vN * T ^ 4 * L ^ K₀ * ((N : ℝ) + 1) ^ d * δ :=
by
  classical
  obtain ⟨C₂, hC₂_def⟩ : ∃ C₂ : ℝ,
      C₂ = 2 ^ d * (4 * (d : ℝ) + 2 + (8 * (d : ℝ) + 16) ^ d) := ⟨_, rfl⟩
  have hC₂0 : 0 ≤ C₂ := by rw [hC₂_def]; positivity
  have hC₂2 : 2 * 2 ^ d ≤ C₂ := by
    rw [hC₂_def]
    have h1 : (0:ℝ) ≤ 4 * (d:ℝ) + (8 * (d : ℝ) + 16) ^ d := by positivity
    have h2 : (0:ℝ) ≤ 2 ^ d := by positivity
    nlinarith
  have hfac0 : (0:ℝ) ≤ ((2 * Module.finrank ℚ K).factorial : ℝ) := Nat.cast_nonneg _
  refine ⟨4 * C₂ + ((2 * Module.finrank ℚ K).factorial : ℝ), by positivity,
    d + 2 * Module.finrank ℚ K, 4 * d + 7, ?_⟩
  intro c₀ c hCOK L N Ω hL hc hc₀ hCN hΩm hΩc hΩbox f g T δ hT hδ hfg hgow
