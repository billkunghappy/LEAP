noncomputable def giBohr (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ρ : ℝ) : Finset (ZMod P) :=
  Finset.univ.filter (fun x => ∀ ξ ∈ S, giCircNorm P (ξ * x) < ρ)


def GiRegularBohr (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ρ : ℝ) : Prop :=
  ∀ κ : ℝ, 100 * (S.card : ℝ) * |κ| ≤ 1 →
    (1 - 100 * (S.card : ℝ) * |κ|) * ((giBohr P S ρ).card : ℝ)
        ≤ ((giBohr P S ((1 + κ) * ρ)).card : ℝ) ∧
    ((giBohr P S ((1 + κ) * ρ)).card : ℝ)
        ≤ (1 + 100 * (S.card : ℝ) * |κ|) * ((giBohr P S ρ).card : ℝ)


def GiLocQuadOn (P : ℕ) (A : Finset (ZMod P)) (φ : ZMod P → ℝ) : Prop :=
  ∀ x h₁ h₂ h₃ : ZMod P, (∀ ε : Fin 3 → Fin 2, cubeVertex x h₁ h₂ h₃ ε ∈ A) →
    ∃ k : ℤ, ∑ ε : Fin 3 → Fin 2,
      (-1 : ℝ) ^ ((ε 0 : ℕ) + (ε 1 : ℕ) + (ε 2 : ℕ)) * φ (cubeVertex x h₁ h₂ h₃ ε) = k


def GiSandersBR (C : ℕ) : Prop :=
  ∀ (P : ℕ) [NeZero P] (S : Finset (ZMod P)) (ρ α : ℝ) (A : Finset (ZMod P)),
    0 < ρ → ρ ≤ 1 / 4 → GiRegularBohr P S ρ → 0 < α → α ≤ 1 →
    A ⊆ giBohr P S ρ → α * ((giBohr P S ρ).card : ℝ) ≤ (A.card : ℝ) →
    ∃ (S' : Finset (ZMod P)) (ρ' : ℝ), S ⊆ S' ∧
      (S'.card : ℝ) ≤ S.card + C * (1 + Real.log (((S.card : ℝ) + 1) / α)) ^ C ∧
      ρ * Real.exp (-(C * (1 + Real.log (((S.card : ℝ) + 1) / α)) ^ C)) ≤ ρ' ∧ ρ' ≤ ρ ∧
      ∀ x ∈ giBohr P S' ρ', ∃ a₁ ∈ A, ∃ a₂ ∈ A, ∃ a₃ ∈ A, ∃ a₄ ∈ A, x = a₁ + a₂ - a₃ - a₄


def giGraph (P : ℕ) (H : Finset (ZMod P)) (ξ : ZMod P → ZMod P) : Finset (ZMod P × ZMod P) :=
  H.image (fun h => (h, ξ h))

