                have h1 : y ^ β₀ / β₀ ^ 2 ≤ 4 * y ^ β₀ := by
                  rw [div_le_iff₀ (pow_pos hβ0pos 2)]
                  linarith [mul_le_mul_of_nonneg_left h4b hyβ0]
                have h2 : y ^ β₀ ≤ y ^ σ₁ := Real.rpow_le_rpow_of_exponent_le (by linarith) hβσ
                have h3 := heB y hy3 hyx
                have h5 : 1 * (x * Real.exp (-(B * X) / (40 * Λ)))
                    ≤ (C₂ * Λ) * (x * Real.exp (-(B * X) / (40 * Λ))) :=
                  mul_le_mul_of_nonneg_right hN1 hxe0
                linarith
            apply hcmp
            have htri := norm_add_le
              ((∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ y},
                ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
                  lam (I : Ideal (NumberField.RingOfIntegers K)) *
                  ((Real.log (y / (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ))
                    : ℝ) : ℂ)) - (E : ℂ) * (y : ℂ))
              ((m : ℂ) * (((y ^ β₀ / β₀ ^ 2 : ℝ)) : ℂ))
            have h7 := mul_nonneg hN0 hxe0
            linarith [h9, hextra, htri, h7]
        have hEnorm : ‖(E : ℂ)‖ ≤ 1 := by
          rw [Complex.norm_natCast]; exact_mod_cast hE1
        have hdec := kai_lp_theta_deconv K
          (fun I => ((kaiZFVonMangoldt K I : ℝ) : ℂ) * lam I) θx (E : ℂ) m hm
          x X R CK β₀ hxbig hXdef hRnn hRsmall hCK1 hEnorm hβh hβ1.le
          (hChebA x hx).2.2 hmain (by rw [hθx]; exact (hChebA x hx).2.1)
        have hp1 : 0 ≤ Real.sqrt x * X ^ 2 := mul_nonneg (Real.sqrt_nonneg _) (sq_nonneg _)
        have hp2 : 0 ≤ X * (x * Real.sqrt R) :=
          mul_nonneg hXpos.le (mul_nonneg hx0.le (Real.sqrt_nonneg _))
        rcases hdec with h | h
        · refine le_trans h ?_
          linarith [habsII2, hp1, hp2]
        · refine le_trans h ?_
          linarith [habsII3, hp1, hXpos]
  
  by_cases hP : m₀ = 1 ∧ 1 - B / 4 / Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ β₀₀
  · obtain ⟨hinf, hnp, hreal⟩ := hcl1 hP.1
    obtain ⟨ht0, hl0⟩ := hinf_tl hinf
    have hβh : 1 / 2 ≤ β₀₀ := by
      have h1 : B / 4 / Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) ≤ B / 4 :=
        div_le_self (by linarith) hL4
      linarith [hP.2]
    have hGβ : G (β₀₀ : ℂ) = 0 := by
      have hloc : ∀ σ : ℝ, β₀₀ < σ → σ < β₀₀ + (1 - β₀₀) →
          G (σ : ℂ) ≠ 0 ∧ ‖deriv G (σ : ℂ) / G (σ : ℂ) - 1 / ((σ : ℂ) - (β₀₀ : ℂ))‖
            ≤ C * Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) := by
        intro σ hσ1 hσ2
        have hre : (σ : ℂ).re ≤ 2 := by rw [Complex.ofReal_re]; linarith
        constructor
        · intro h0
          have hle : 1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
              * (2 + |(σ : ℂ).im|)) ≤ (σ : ℂ).re := by
            rw [hexpr hinf σ, Complex.ofReal_re]; linarith [hP.2, hBL]
          obtain ⟨-, h2⟩ := hZ (σ : ℂ) hre hle h0
          have h3 := Complex.ofReal_inj.mp h2
          linarith
        · have hle : 1 - B / (4 * Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
              * (2 + |(σ : ℂ).im|))) ≤ (σ : ℂ).re := by
            rw [hexpr hinf σ, Complex.ofReal_re, ← div_div]; linarith [hP.2]
          have h := hD (σ : ℂ) hre hle
          rw [hexpr hinf σ, hP.1, Nat.cast_one] at h
          exact h
      obtain ⟨H, -, -, hfac⟩ := kai_lp_simple_zero G hGd β₀₀ 2 hG2 (1 - β₀₀)
        (C * Real.log (3 + 4 * (Ideal.absNorm q : ℝ))) (by linarith) hloc
      rw [hfac, sub_self, zero_mul]
    refine ⟨1, β₀₀, le_refl 1, hβh, hβ01, ?_, ?_,
      key 1 β₀₀ (le_refl 1) hβh hβ01 (fun _ => ⟨hP.1, rfl⟩) (fun _ => rfl)⟩
    · intro _
      refine ⟨ht0, hl0, hnp, hreal, hP.2, ?_⟩
      intro G' hG' heq
      rw [hident hnp G' hG' heq]
