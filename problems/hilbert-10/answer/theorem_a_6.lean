            ((Ideal.absNorm (q₁ * q₂) : ℝ)) ^ (-(a * (1 - β)))) * M₁ ^ (-(1 / L)) := by
          ring
      _ ≤ ((1 - β) / (2 * Real.exp 1) *
            ((Ideal.absNorm (q₁ * q₂) : ℝ)) ^ (-(a * (1 - β)))) * M₁ ^ (-((1 - β) / L)) :=
          mul_le_mul_of_nonneg_left hM₁le hpos
      _ = (1 - β) / (2 * Real.exp 1) * (M₁ ^ (-((1 - β) / L)) *
            ((Ideal.absNorm (q₁ * q₂) : ℝ)) ^ (-(a * (1 - β)))) := by ring
  have hG₀1 : ‖G₀ (1:ℂ)‖ ≤ (1 + A₀) * (4:ℝ) ^ A₀ := by
    have h := hgb ⊤ G₀ hG₀bd 1 2 (by norm_num) (by norm_num) (by norm_num)
    have e : ((1:ℝ) * 2 * 2) = 4 := by norm_num
    rw [hNtop, e] at h
    have h2 : A₀ * (4:ℝ) ^ A₀ ≤ (1 + A₀) * (4:ℝ) ^ A₀ :=
      mul_le_mul_of_nonneg_right (by linarith) (Real.rpow_nonneg (by norm_num) _)
    linarith
  have hPhi1 : ‖Phi 1‖ = ‖G₀ 1‖ * ‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖ := by
    rw [hPhiap, hFG₁, hFG₂]; simp
  have hfinal : c₀ * (1 - β) * ((Ideal.absNorm (q₁ * q₂) : ℝ)) ^ (-(a * (1 - β)))
      ≤ ((1 + A₀) * (4:ℝ) ^ A₀) * (‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖) := by
    refine hchain.trans ((Complex.re_le_norm (Phi 1)).trans ?_)
    rw [hPhi1]
    calc ‖G₀ (1:ℂ)‖ * ‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖
        = ‖G₀ (1:ℂ)‖ * (‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖) := by ring
      _ ≤ ((1 + A₀) * (4:ℝ) ^ A₀) * (‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖) :=
          mul_le_mul_of_nonneg_right hG₀1 (by positivity)
  have hrewrite : c * (1 - β) * ((Ideal.absNorm (q₁ * q₂) : ℝ)) ^ (-(a * (1 - β)))
      = (c₀ * (1 - β) * ((Ideal.absNorm (q₁ * q₂) : ℝ)) ^ (-(a * (1 - β))))
          / ((1 + A₀) * (4:ℝ) ^ A₀) := by
    rw [hcdef]; ring
  rw [hrewrite, div_le_iff₀ hDpos]
  calc c₀ * (1 - β) * ((Ideal.absNorm (q₁ * q₂) : ℝ)) ^ (-(a * (1 - β)))
      ≤ ((1 + A₀) * (4:ℝ) ^ A₀) * (‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖) := hfinal
    _ = ‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖ * ((1 + A₀) * (4:ℝ) ^ A₀) := by ring

theorem kai_hecke_near_one_bounds (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ C D : ℝ, 0 < C ∧ 1 ≤ D ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam →
        ¬ KaiHeckePrincipal K q lam →
      ∀ G : ℂ → ℂ, Differentiable ℂ G →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s) →
      ∀ σ : ℝ,
        1 - 1 / (D * Real.log (3 + (Ideal.absNorm q : ℝ))) ≤ σ → σ ≤ 1 →
          ‖G (σ : ℂ)‖ ≤ C * Real.log (3 + (Ideal.absNorm q : ℝ)) ∧
          ‖deriv G (σ : ℂ)‖
            ≤ C * (Real.log (3 + (Ideal.absNorm q : ℝ))) ^ 2 :=
by
  classical
  
  have hzeta : ∃ c : ℝ, 0 < c ∧
      ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
        (Summable fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-(1 + δ))) ∧
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-(1 + δ)))
          ≤ c / δ := by
    have hg : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        1 ≤ Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) := by
      intro I
      refine Nat.one_le_iff_ne_zero.mpr ?_
      intro h
      exact I.2 ((Ideal.absNorm_eq_zero_iff.mp h).trans Submodule.zero_eq_bot.symm)
    
    obtain ⟨C, hC, hcov⟩ :
        ∃ C : ℝ, 0 < C ∧
          ∀ n : ℕ, ∃ s : Finset {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            (∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) ≤ n → I ∈ s) ∧
            (s.card : ℝ) ≤ C * (n : ℝ) := by
      have hfin : ∀ n : ℕ,
          {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ n}.Finite :=
        fun n => Ideal.finite_setOf_absNorm_le n
      have hmem : ∀ (n : ℕ) (I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}),
          I ∈ Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
                (hfin n).toFinset
            ↔ Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) ≤ n := by
        intro n I
        simp only [Finset.mem_subtype, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
      have hcardle : ∀ n : ℕ,
          (Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
              (hfin n).toFinset).card ≤ (hfin n).toFinset.card := by
        intro n
        refine Finset.card_le_card_of_injOn
          (fun I => (I : Ideal (NumberField.RingOfIntegers K))) ?_ ?_
        · intro I hI
          have hI' : I ∈ Finset.subtype
              (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0) (hfin n).toFinset := hI
          have h2 := (hmem n I).mp hI'
          show (I : Ideal (NumberField.RingOfIntegers K)) ∈ (hfin n).toFinset
          rw [Set.Finite.mem_toFinset]
          exact h2
        · intro I _ J _ h
          exact Subtype.ext h
      obtain ⟨M, hM⟩ : ∃ M : ℝ, ∀ᶠ x : ℝ in Filter.atTop,
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
            ((Ideal.absNorm I : ℕ) : ℝ) ≤ x} : ℝ) / x ≤ M :=
        ⟨_, (NumberField.Ideal.tendsto_norm_le_div_atTop K).eventually_le_const (lt_add_one _)⟩
      obtain ⟨x₀, hx₀⟩ := Filter.eventually_atTop.mp hM
      obtain ⟨x₁, hx₁1, hx₁0⟩ : ∃ x₁ : ℝ, 1 ≤ x₁ ∧ x₀ ≤ x₁ :=
        ⟨max x₀ 1, le_max_right _ _, le_max_left _ _⟩
      have hcardeq : ∀ n : ℕ, ((hfin n).toFinset.card : ℕ)
          = Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (n : ℝ)} := by
        intro n
        have e : {I : Ideal (NumberField.RingOfIntegers K) //
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (n : ℝ)}
            ≃ {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I ≤ n} :=
          Equiv.subtypeEquivRight (fun _ => Nat.cast_le)
        rw [Nat.card_congr e]
        symm
        show ({I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ n}).ncard = _
        exact Set.ncard_eq_toFinset_card _ (hfin n)
      have hbig : ∀ n : ℕ, x₁ ≤ (n : ℝ) → ((hfin n).toFinset.card : ℝ) ≤ M * (n : ℝ) := by
        intro n hn
        have hnpos : (0 : ℝ) < (n : ℝ) := lt_of_lt_of_le zero_lt_one (le_trans hx₁1 hn)
        have h := hx₀ (n : ℝ) (le_trans hx₁0 hn)
        rw [div_le_iff₀ hnpos] at h
        rw [hcardeq n]
        exact h
      obtain ⟨m₀, hm₀⟩ := exists_nat_ge x₁
      obtain ⟨C, hCpos, hCM, hCD⟩ : ∃ C : ℝ, 0 < C ∧ M ≤ C ∧
          ((Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
              (hfin m₀).toFinset).card : ℝ) ≤ C := by
        refine ⟨max M (max ((Finset.subtype
            (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
            (hfin m₀).toFinset).card : ℝ) 1), ?_, le_max_left _ _,
          le_trans (le_max_left _ 1) (le_max_right M _)⟩
        have h1 : (1 : ℝ) ≤ max M (max ((Finset.subtype
            (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
            (hfin m₀).toFinset).card : ℝ) 1) :=
          le_trans (le_max_right _ 1) (le_max_right M _)
        linarith
      refine ⟨C, hCpos, ?_⟩
      intro n
      rcases Nat.eq_zero_or_pos n with hn0 | hn1
      · subst hn0
        refine ⟨∅, ?_, ?_⟩
        · intro I hI
          exfalso
          have hz : Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) = 0 :=
            Nat.le_zero.mp hI
          exact I.2 ((Ideal.absNorm_eq_zero_iff.mp hz).trans Submodule.zero_eq_bot.symm)
        · simp
      · refine ⟨Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
          (hfin n).toFinset, fun I hI => (hmem n I).mpr hI, ?_⟩
        have hn1R : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn1
        have hsn : ((Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
            (hfin n).toFinset).card : ℝ) ≤ ((hfin n).toFinset.card : ℝ) := by
          exact_mod_cast hcardle n
        by_cases hcase : x₁ ≤ (n : ℝ)
        · have h2 := hbig n hcase
          have h3 : M * (n : ℝ) ≤ C * (n : ℝ) :=
            mul_le_mul_of_nonneg_right hCM (by linarith)
          linarith
        · push_neg at hcase
          have hnm : n ≤ m₀ := by
            have h : (n : ℝ) < (m₀ : ℝ) := lt_of_lt_of_le hcase hm₀
            have h' : n < m₀ := by exact_mod_cast h
            omega
          have hsub : Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
                (hfin n).toFinset
              ⊆ Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
                (hfin m₀).toFinset := by
            intro I hI
            exact (hmem m₀ I).mpr (le_trans ((hmem n I).mp hI) hnm)
          have h1 : ((Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
                (hfin n).toFinset).card : ℝ)
              ≤ ((Finset.subtype (fun I : Ideal (NumberField.RingOfIntegers K) => I ≠ 0)
                (hfin m₀).toFinset).card : ℝ) := by
            exact_mod_cast Finset.card_le_card hsub
          have h2 : C * 1 ≤ C * (n : ℝ) := mul_le_mul_of_nonneg_left hn1R hCpos.le
          linarith
    refine ⟨6 * C, by linarith, ?_⟩
    intro δ hδ0 hδ1
    
    have key : ∀ (α : Type u) (g : α → ℕ) (Cc : ℝ), 0 < Cc → (∀ a : α, 1 ≤ g a) →
        (∀ n : ℕ, ∃ s : Finset α,
          (∀ a : α, g a ≤ n → a ∈ s) ∧ (s.card : ℝ) ≤ Cc * (n : ℝ)) →
        (Summable fun a : α => ((g a : ℝ)) ^ (-(1 + δ))) ∧
          (∑' a : α, ((g a : ℝ)) ^ (-(1 + δ))) ≤ 2 * Cc / (1 - (2 : ℝ) ^ (-δ)) := by
      intro α g Cc hCc hg1 hcovα
      have h2pos : (0 : ℝ) < 2 := by norm_num
      have hρpos : (0 : ℝ) < (2 : ℝ) ^ (-(1 + δ)) := Real.rpow_pos_of_pos h2pos _
      have hrpos : (0 : ℝ) < (2 : ℝ) ^ (-δ) := Real.rpow_pos_of_pos h2pos _
      have hr1 : (2 : ℝ) ^ (-δ) < 1 :=
        Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (neg_lt_zero.mpr hδ0)
      have h1r : (0 : ℝ) < 1 - (2 : ℝ) ^ (-δ) := by linarith
      have h2ρ : 2 * (2 : ℝ) ^ (-(1 + δ)) = (2 : ℝ) ^ (-δ) := by
        rw [show -(1 + δ) = (-1 : ℝ) + (-δ) by ring,
            Real.rpow_add h2pos,
            show ((2 : ℝ) ^ (-1 : ℝ)) = 2⁻¹ by
              rw [Real.rpow_neg (by norm_num : (0:ℝ) ≤ 2), Real.rpow_one]]
        ring
      have hnn : ∀ a : α, (0 : ℝ) ≤ ((g a : ℝ)) ^ (-(1 + δ)) :=
        fun a => Real.rpow_nonneg (Nat.cast_nonneg _) _
      have hB : ∀ a : α, ((g a : ℝ)) ^ (-(1 + δ))
          ≤ ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a)) := by
        intro a
        have hga : g a ≠ 0 := by have := hg1 a; omega
        have h1 : 2 ^ (Nat.log 2 (g a)) ≤ g a := Nat.pow_log_le_self 2 hga
        have h2 : ((2 : ℝ)) ^ (Nat.log 2 (g a)) ≤ (g a : ℝ) := by exact_mod_cast h1
        have h3 : (0 : ℝ) < ((2 : ℝ)) ^ (Nat.log 2 (g a)) := pow_pos h2pos _
        have h4 := Real.rpow_le_rpow_of_nonpos h3 h2 (by linarith : -(1 + δ) ≤ (0:ℝ))
        refine h4.trans_eq ?_
        rw [← Real.rpow_natCast (2 : ℝ) (Nat.log 2 (g a)),
            ← Real.rpow_natCast ((2 : ℝ) ^ (-(1 + δ))) (Nat.log 2 (g a)),
            ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2),
            ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]
        congr 1
        ring
      have hpart : ∀ T : Finset α, ∑ a ∈ T, ((g a : ℝ)) ^ (-(1 + δ))
          ≤ 2 * Cc / (1 - (2 : ℝ) ^ (-δ)) := by
        intro T
        have hmaps : ∀ a ∈ T, Nat.log 2 (g a)
            ∈ Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1) := by
          intro a ha
          exact Finset.mem_range.mpr
            (Nat.lt_succ_of_le (Finset.le_sup (f := fun a => Nat.log 2 (g a)) ha))
        have step1 : ∑ a ∈ T, ((g a : ℝ)) ^ (-(1 + δ))
            ≤ ∑ a ∈ T, ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a)) :=
          Finset.sum_le_sum (fun a _ => hB a)
        have step2 : ∑ a ∈ T, ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a))
            = ∑ j ∈ Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1),
                ∑ a ∈ T.filter (fun a => Nat.log 2 (g a) = j),
                  ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a)) :=
          (Finset.sum_fiberwise_of_maps_to hmaps _).symm
        have step3 : ∀ j ∈ Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1),
            ∑ a ∈ T.filter (fun a => Nat.log 2 (g a) = j),
                ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a))
              ≤ 2 * Cc * ((2 : ℝ) ^ (-δ)) ^ j := by
          intro j _
          have heq1 : ∑ a ∈ T.filter (fun a => Nat.log 2 (g a) = j),
                  ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a))
              = ∑ _a ∈ T.filter (fun a => Nat.log 2 (g a) = j),
                  ((2 : ℝ) ^ (-(1 + δ))) ^ j :=
            Finset.sum_congr rfl (fun a ha => by rw [(Finset.mem_filter.mp ha).2])
          have heq : ∑ a ∈ T.filter (fun a => Nat.log 2 (g a) = j),
                  ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a))
              = ((T.filter (fun a => Nat.log 2 (g a) = j)).card : ℝ)
                  * ((2 : ℝ) ^ (-(1 + δ))) ^ j := by
            rw [heq1, Finset.sum_const, nsmul_eq_mul]
          rw [heq]
          obtain ⟨sj, hcovj, hcardj⟩ := hcovα (2 ^ (j + 1))
          have hsub : T.filter (fun a => Nat.log 2 (g a) = j) ⊆ sj := by
            intro a ha
            rw [Finset.mem_filter] at ha
            refine hcovj a ?_
            have h := Nat.lt_pow_succ_log_self (by norm_num : 1 < 2) (g a)
            rw [ha.2] at h
            exact le_of_lt h
          have hc1 : ((T.filter (fun a => Nat.log 2 (g a) = j)).card : ℝ) ≤ (sj.card : ℝ) := by
            exact_mod_cast Finset.card_le_card hsub
          have hc2 : ((T.filter (fun a => Nat.log 2 (g a) = j)).card : ℝ)
              ≤ Cc * ((2 : ℝ) ^ (j + 1)) := by
            refine hc1.trans (hcardj.trans_eq ?_)
            push_cast
            try ring
          calc ((T.filter (fun a => Nat.log 2 (g a) = j)).card : ℝ)
                  * ((2 : ℝ) ^ (-(1 + δ))) ^ j
              ≤ (Cc * ((2 : ℝ) ^ (j + 1))) * ((2 : ℝ) ^ (-(1 + δ))) ^ j :=
                mul_le_mul_of_nonneg_right hc2 (pow_nonneg hρpos.le j)
            _ = 2 * Cc * ((2 : ℝ) ^ (-δ)) ^ j := by rw [← h2ρ]; ring
        have step4 := Finset.sum_le_sum step3
        have hgeo : Summable (fun n : ℕ => ((2 : ℝ) ^ (-δ)) ^ n) :=
          (hasSum_geometric_of_lt_one hrpos.le hr1).summable
        have step5 : ∑ j ∈ Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1),
              ((2 : ℝ) ^ (-δ)) ^ j ≤ (1 - (2 : ℝ) ^ (-δ))⁻¹ := by
          have h := hgeo.sum_le_tsum
            (Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1))
            (fun i _ => pow_nonneg hrpos.le i)
          rwa [tsum_geometric_of_lt_one hrpos.le hr1] at h
        calc ∑ a ∈ T, ((g a : ℝ)) ^ (-(1 + δ))
            ≤ ∑ a ∈ T, ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a)) := step1
          _ = ∑ j ∈ Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1),
                ∑ a ∈ T.filter (fun a => Nat.log 2 (g a) = j),
                  ((2 : ℝ) ^ (-(1 + δ))) ^ (Nat.log 2 (g a)) := step2
          _ ≤ ∑ j ∈ Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1),
                2 * Cc * ((2 : ℝ) ^ (-δ)) ^ j := step4
          _ = 2 * Cc * ∑ j ∈ Finset.range ((T.sup (fun a => Nat.log 2 (g a))) + 1),
                ((2 : ℝ) ^ (-δ)) ^ j := by rw [Finset.mul_sum]
          _ ≤ 2 * Cc * (1 - (2 : ℝ) ^ (-δ))⁻¹ :=
                mul_le_mul_of_nonneg_left step5 (by linarith)
          _ = 2 * Cc / (1 - (2 : ℝ) ^ (-δ)) := by rw [div_eq_mul_inv]
      exact ⟨summable_of_sum_le (fun a => hnn a) hpart,
        tsum_le_of_sum_le' (le_of_lt (div_pos (by linarith) h1r)) hpart⟩
    obtain ⟨hsum, hbd⟩ := key {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}
        (fun I => Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) C hC hg hcov
    refine ⟨hsum, ?_⟩
    have hs3 : δ / 3 ≤ 1 - (2 : ℝ) ^ (-δ) := by
      have hL : (1 : ℝ) / 2 < Real.log 2 := by
        have := Real.log_two_gt_d9
        linarith
      have hL0 : (0 : ℝ) < Real.log 2 := by linarith
      have hLd : Real.log 2 * δ ≤ Real.log 2 := mul_le_of_le_one_right hL0.le hδ1
      have hLδ : (0 : ℝ) < Real.log 2 * δ := mul_pos hL0 hδ0
      have hpos : (0 : ℝ) < 1 + Real.log 2 * δ := by linarith
      have h1 : 1 + Real.log 2 * δ ≤ (2 : ℝ) ^ δ := by
        rw [Real.rpow_def_of_pos (by norm_num : (0:ℝ) < 2) δ]
        have := Real.add_one_le_exp (Real.log 2 * δ)
        linarith
      have hA : 0 ≤ Real.log 2 - 1 / 3 - Real.log 2 * δ / 3 := by linarith
      have hprod : 0 ≤ δ * (Real.log 2 - 1 / 3 - Real.log 2 * δ / 3) := mul_nonneg hδ0.le hA
      have hring : (1 - δ / 3) * (1 + Real.log 2 * δ)
          = 1 + δ * (Real.log 2 - 1 / 3 - Real.log 2 * δ / 3) := by ring
      have h5 : 1 / (1 + Real.log 2 * δ) ≤ 1 - δ / 3 := by
        rw [div_le_iff₀ hpos, hring]
        linarith
      have h6 : (2 : ℝ) ^ (-δ) ≤ 1 - δ / 3 := by
        rw [Real.rpow_neg (by norm_num : (0:ℝ) ≤ 2) δ, ← one_div]
        exact (one_div_le_one_div_of_le hpos h1).trans h5
      linarith
    have hd3p : (0 : ℝ) < δ / 3 := by linarith
    have hstep : 2 * C / (1 - (2 : ℝ) ^ (-δ)) ≤ 2 * C / (δ / 3) :=
      div_le_div_of_nonneg_left (by linarith) hd3p hs3
    have harith : 2 * C / (δ / 3) = 6 * C / δ := by
      field_simp
      try ring
    calc (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-(1 + δ)))
