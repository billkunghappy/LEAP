          - ((a l l' : ℤ) : ℝ) * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ) / ((2 * q₀ : ℕ) : ℝ) := by
      intro l l'
      rw [hθdef]
      push_cast
      field_simp
    simp only [hθz, Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.sum_div]
    rw [hsym]
    ring
  
  set Q : ℝ := ((2 * q₀ : ℕ) : ℝ) with hQdef
