          have h1 : y ^ σ₁ ≤ x ^ σ₁ := Real.rpow_le_rpow (by linarith) hyx hσ0
          have hm' := mul_le_mul_of_nonneg_left hgap' hXpos.le
          have h4 : -(B * X) / (40 * Λ) = -(X * (B / (40 * Λ))) := by ring
