      exact Finset.univ_sum_single h
    have hspan : ∀ y : NumberField.mixedEmbedding.mixedSpace K,
        y = ∑ i, cc y i • f i := by
      intro y
      rw [Fintype.sum_sum_type, Fintype.sum_sum_type]
      simp only [hfR, hfC, hfD, hcR, hcC, hcD]
      refine Prod.ext_iff.mpr ⟨?_, ?_⟩
      · simp only [Prod.fst_add, Prod.fst_sum, Prod.smul_fst, smul_zero,
          Finset.sum_const_zero, add_zero]
        exact (key1 y.1).symm
      · simp only [Prod.snd_add, Prod.snd_sum, Prod.smul_snd, smul_zero,
          Finset.sum_const_zero, zero_add]
        exact (key2 y.2).symm
    have hcoef : ∀ (y : NumberField.mixedEmbedding.mixedSpace K) i, |cc y i| ≤ ‖y‖ := by
      intro y i
      rcases i with w | (w | w)
      · rw [hcR, Prod.norm_def]
        refine le_trans ?_ (le_max_left _ _)
        rw [← Real.norm_eq_abs]
        exact norm_le_pi_norm y.1 w
      · rw [hcC, Prod.norm_def]
        exact le_trans (Complex.abs_re_le_norm _)
