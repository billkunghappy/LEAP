            · rintro ⟨⟨h1, h2⟩, h3⟩
              exact ⟨⟨h1, by omega⟩, h3⟩
          rw [heq]
          have ihl := ih (h' - lo) (by omega) h' rfl (by omega)
            (fun j h1 h2 => hmono j h1 (by omega))
          have := hmono h' (by omega) (by omega)
