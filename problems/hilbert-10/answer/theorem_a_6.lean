      rw [hD_def]
      apply mul_le_mul_of_nonneg_right _ (by linarith)
      exact mul_le_mul_of_nonneg_left P3 (by linarith)
    have hXle : (2 * (M + 1)) ^ (Module.finrank ℚ K - 1) ≤ (4 * M) ^ (Module.finrank ℚ K - 1) :=
      pow_le_pow_left₀ (by linarith) (by linarith) _
    have hnn : 0 ≤ 8 * (c * (2 * M ^ ((3 : ℝ) / 4)) * μ) :=
      mul_nonneg (by norm_num) (mul_nonneg (mul_nonneg (by linarith) (by linarith)) (by linarith))
    calc 2 * VB = 8 * D * (2 * (M + 1)) ^ (Module.finrank ℚ K - 1) * A_sl := by
          rw [hVB_def]; ring
      _ ≤ 8 * (c * (2 * M ^ ((3 : ℝ) / 4)) * μ) * (4 * M) ^ (Module.finrank ℚ K - 1) * A_sl := by
          apply mul_le_mul_of_nonneg_right _ hA0
          exact mul_le_mul (mul_le_mul_of_nonneg_left hDle (by norm_num)) hXle
            (pow_nonneg (by linarith) _) hnn
      _ = 16 * c * 4 ^ (Module.finrank ℚ K - 1) * A_sl
            * (M ^ ((3 : ℝ) / 4) * μ * M ^ (Module.finrank ℚ K - 1)) := by
          rw [mul_pow]; ring
      _ = 16 * c * 4 ^ (Module.finrank ℚ K - 1) * A_sl * P := by rw [hkey]
  have hT4 : C_W * (M + 1) ^ ((Module.finrank ℚ K : ℝ) / 2)
      ≤ (2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2) * C_W * P := by
    have hn2 : (0:ℝ) ≤ (Module.finrank ℚ K : ℝ) / 2 := by positivity
    have h1 : (M + 1) ^ ((Module.finrank ℚ K : ℝ) / 2)
        ≤ (2 * M) ^ ((Module.finrank ℚ K : ℝ) / 2) :=
      Real.rpow_le_rpow (by linarith) (by linarith) hn2
    have h2 : (2 * M) ^ ((Module.finrank ℚ K : ℝ) / 2)
        = (2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2) * M ^ ((Module.finrank ℚ K : ℝ) / 2) :=
      Real.mul_rpow (by norm_num) hMpos.le
    have h3 : M ^ ((Module.finrank ℚ K : ℝ) / 2) ≤ P := by
      rw [hP_def]; apply Real.rpow_le_rpow_of_exponent_le hM1
      have : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn
      linarith
    calc C_W * (M + 1) ^ ((Module.finrank ℚ K : ℝ) / 2)
        ≤ C_W * (2 * M) ^ ((Module.finrank ℚ K : ℝ) / 2) := mul_le_mul_of_nonneg_left h1 hC_W
      _ = C_W * ((2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2)
            * M ^ ((Module.finrank ℚ K : ℝ) / 2)) := by rw [h2]
      _ ≤ C_W * ((2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2) * P) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left h3 (Real.rpow_nonneg (by norm_num) _)) hC_W
      _ = (2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2) * C_W * P := by ring
  have hPfin : P ≤ M ^ ((Module.finrank ℚ K : ℝ) - 1 / 24) := by
    rw [hP_def]; exact Real.rpow_le_rpow_of_exponent_le hM1 (by linarith)
  have hC₅P : C₅ * P = (Module.finrank ℚ K : ℝ) * 6 ^ (Module.finrank ℚ K) * P
      + 14 ^ (Module.finrank ℚ K) * C_cc * P
      + 16 * c * 4 ^ (Module.finrank ℚ K - 1) * A_sl * P
      + (2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2) * C_W * P := by
    rw [hC₅_def]; ring
  calc η * ((F.card : ℝ) + (MeasureTheory.volume S).toReal / (Ideal.absNorm 𝔟 : ℝ))
        + ((intBox (Module.finrank ℚ K) K₀).card : ℝ)
          * (C_cc * (ℓ : ℝ) ^ (Module.finrank ℚ K - 1))
        + 2 * VB + C_W * (M + 1) ^ ((Module.finrank ℚ K : ℝ) / 2)
      ≤ C₅ * P := by rw [hC₅P]; linarith [hT1, hT2, hT3, hT4]
    _ ≤ C₅ * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 24) := mul_le_mul_of_nonneg_left hPfin hC₅0

theorem kai_siegel_fiber_cancellation (K : Type u) [Field K] [NumberField K]
    (𝔮 𝔮D : Ideal (NumberField.RingOfIntegers K)) (h𝔮 : 𝔮 ≠ ⊥) (h𝔮D : 𝔮D ≠ ⊥)
    [Fintype (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D))]
    (ψ : NumberField.RingOfIntegers K → ℤ) (hψ : IsRealRayChar 𝔮D ψ) (hnd : ¬ 𝔮 ≤ 𝔮D)
    (a z₀ : NumberField.RingOfIntegers K)
    (hz₀ : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      NumberField.InfinitePlace.embedding_of_isReal hw (z₀ : K) ≠ 0) :
    ∃ f : NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D) → NumberField.RingOfIntegers K,
      (∀ c, Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) (f c) = c) ∧
      (∀ c (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw
              ((f c : NumberField.RingOfIntegers K) : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (z₀ : K)) ∧
      ∑ c ∈ @Finset.filter (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) (fun c => f c - a ∈ 𝔮)
          (fun _ => Classical.propDecidable _) Finset.univ, ((ψ (f c) : ℤ) : ℝ) = 0 :=
by
  classical
  obtain ⟨hC1, hC2, hC3, -, hC5, hC6⟩ := hψ
  
  have hlt : 𝔮D < 𝔮 ⊔ 𝔮D :=
    lt_of_le_of_ne le_sup_right (fun h => hnd (le_sup_left.trans h.symm.le))
  clear hnd
  have hN₀pos : 0 < Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D := by
    apply Nat.pos_of_ne_zero
    exact mul_ne_zero (fun h => h𝔮 (Ideal.absNorm_eq_zero_iff.mp h))
      (fun h => h𝔮D (Ideal.absNorm_eq_zero_iff.mp h))
  have hN₀mem : ∀ m : ℕ, ((m * (Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D) : ℕ) :
      NumberField.RingOfIntegers K) ∈ 𝔮 ⊓ 𝔮D := by
    intro m
    have h1 : ((Ideal.absNorm 𝔮 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔮 := Ideal.absNorm_mem 𝔮
    have h2 : ((Ideal.absNorm 𝔮D : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔮D :=
      Ideal.absNorm_mem 𝔮D
    rw [Submodule.mem_inf]
    push_cast
    constructor
    · exact 𝔮.mul_mem_left _ (𝔮.mul_mem_right _ h1)
    · exact 𝔮D.mul_mem_left _ (𝔮D.mul_mem_left _ h2)
  
  have hshift : ∀ (u v : NumberField.RingOfIntegers K),
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        NumberField.InfinitePlace.embedding_of_isReal hw (v : K) ≠ 0) →
      ∃ m : ℕ, ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw
              ((u + ((m * (Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D) : ℕ) :
                NumberField.RingOfIntegers K) * v : NumberField.RingOfIntegers K) : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (v : K) := by
    intro u v hv
    have hev : ∀ᶠ m : ℕ in Filter.atTop,
        ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          0 < NumberField.InfinitePlace.embedding_of_isReal w.2 (u : K) *
              NumberField.InfinitePlace.embedding_of_isReal w.2 (v : K) +
            (m : ℝ) * (((Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D : ℕ) : ℝ) *
              (NumberField.InfinitePlace.embedding_of_isReal w.2 (v : K)) ^ 2) := by
      rw [Filter.eventually_all]
      intro w
      have hD : 0 < ((Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D : ℕ) : ℝ) *
          (NumberField.InfinitePlace.embedding_of_isReal w.2 (v : K)) ^ 2 :=
        mul_pos (by exact_mod_cast hN₀pos)
          (lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 (hv w.1 w.2))))
      set A := NumberField.InfinitePlace.embedding_of_isReal w.2 (u : K) *
          NumberField.InfinitePlace.embedding_of_isReal w.2 (v : K)
      set D := ((Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D : ℕ) : ℝ) *
          (NumberField.InfinitePlace.embedding_of_isReal w.2 (v : K)) ^ 2
      rw [Filter.eventually_atTop]
      refine ⟨⌈|A| / D⌉₊ + 1, fun m hm => ?_⟩
      have h1 : |A| / D < (m : ℝ) := by
        have := Nat.le_ceil (|A| / D)
        have hm' : ((⌈|A| / D⌉₊ + 1 : ℕ) : ℝ) ≤ m := by exact_mod_cast hm
        push_cast at hm'
        linarith
      rw [div_lt_iff₀ hD] at h1
      have := neg_abs_le A
      linarith
    obtain ⟨m, hm⟩ := hev.exists
    refine ⟨m, fun w hw => ?_⟩
    have hmw := hm ⟨w, hw⟩
    have e1 : NumberField.InfinitePlace.embedding_of_isReal hw
              ((u + ((m * (Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D) : ℕ) :
                NumberField.RingOfIntegers K) * v : NumberField.RingOfIntegers K) : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (v : K) =
          NumberField.InfinitePlace.embedding_of_isReal hw (u : K) *
              NumberField.InfinitePlace.embedding_of_isReal hw (v : K) +
            (m : ℝ) * (((Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D : ℕ) : ℝ) *
              (NumberField.InfinitePlace.embedding_of_isReal hw (v : K)) ^ 2) := by
      push_cast
      simp only [map_add, map_mul, map_natCast]
      ring
    rw [e1]
    exact hmw
  
  obtain ⟨x, y, hxc, hyc, hxy, hsgn, hne⟩ := hC6 _ hlt
  have hx0 : ψ x ≠ 0 := fun h => ((hC2 x).1 h) hxc
  have hy0 : ψ y ≠ 0 := fun h => ((hC2 y).1 h) hyc
  have hflip : ψ x = - ψ y := by
    rcases hC1 x with h | h | h <;> rcases hC1 y with h' | h' | h' <;> omega
  have hy1 : ψ y = 1 ∨ ψ y = -1 := by
    rcases hC1 y with h | h | h
    · exact Or.inl h
    · exact Or.inr h
    · exact absurd h hy0
  obtain ⟨i', hi', j', hj', hij'⟩ := Ideal.isCoprime_iff_exists.mp hyc
  obtain ⟨y', rfl⟩ := Ideal.mem_span_singleton'.mp hi'
  obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.mp hxy
  have hk₀1 : (1 + i * y') - 1 ∈ 𝔮 := by
    have : (1 + i * y') - 1 = i * y' := by ring
    rw [this]; exact 𝔮.mul_mem_right _ hi
  have hk₀y : (1 + i * y') * y - x ∈ 𝔮D := by
    have : (1 + i * y') * y - x = -(i * j') - j := by linear_combination i * hij' + hij
    rw [this]
    exact 𝔮D.sub_mem (𝔮D.neg_mem (𝔮D.mul_mem_left _ hj')) hj
  
  have hone : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      NumberField.InfinitePlace.embedding_of_isReal hw
        ((1 : NumberField.RingOfIntegers K) : K) = 1 := by
    intro w hw; simp
  obtain ⟨m, hm⟩ := hshift (1 + i * y') 1 (fun w hw => by rw [hone w hw]; exact one_ne_zero)
  set δ : NumberField.RingOfIntegers K :=
    ((m * (Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D) : ℕ) : NumberField.RingOfIntegers K) with hδ_def
  have hδ := hN₀mem m
  rw [← hδ_def] at hδ
  set k : NumberField.RingOfIntegers K := 1 + i * y' + δ * 1 with hk_def
  have hkpos : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      0 < NumberField.InfinitePlace.embedding_of_isReal hw (k : K) := by
    intro w hw
    have := hm w hw
    rwa [hone w hw, mul_one] at this
  have hk₁ : k - 1 ∈ 𝔮 := by
    have : k - 1 = ((1 + i * y') - 1) + δ * 1 := by rw [hk_def]; ring
    rw [this]; exact 𝔮.add_mem hk₀1 (𝔮.mul_mem_right _ (Submodule.mem_inf.mp hδ).1)
  have hky : k * y - x ∈ 𝔮D := by
    have : k * y - x = ((1 + i * y') * y - x) + δ * 1 * y := by rw [hk_def]; ring
    rw [this]
    exact 𝔮D.add_mem hk₀y (𝔮D.mul_mem_right _ (𝔮D.mul_mem_right _ (Submodule.mem_inf.mp hδ).2))
  have hψk : ψ k = -1 := by
    have hs : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw ((k * y : NumberField.RingOfIntegers K) : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw (x : K) := by
      intro w hw
      have h1 := hkpos w hw
      have h2 := hsgn w hw
      have e : NumberField.InfinitePlace.embedding_of_isReal hw
            ((k * y : NumberField.RingOfIntegers K) : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw (x : K) =
          NumberField.InfinitePlace.embedding_of_isReal hw (k : K) *
            (NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
              NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) := by
        push_cast; simp only [map_mul]; ring
      rw [e]; exact mul_pos h1 h2
    have h := hC5 _ _ hky hs
    rw [hC3, hflip] at h
    rcases hy1 with h' | h' <;> rw [h'] at h <;> omega
  have hkc : IsCoprime (Ideal.span {k}) 𝔮D := by
    by_contra h
    have := (hC2 k).2 h
    rw [hψk] at this
    exact absurd this (by norm_num)
  obtain ⟨i'', hi'', j'', hj'', hij''⟩ := Ideal.isCoprime_iff_exists.mp hkc
  obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton'.mp hi''
  have hkr : k * (u + 1 - k * u) - 1 ∈ 𝔮 ⊓ 𝔮D := by
    have e : k * (u + 1 - k * u) - 1 = (k - 1) * j'' := by linear_combination (1 - k) * hij''
    rw [e, Submodule.mem_inf]
    exact ⟨𝔮.mul_mem_right _ hk₁, 𝔮D.mul_mem_left _ hj''⟩
  set r := u + 1 - k * u with hr_def
  
  have hlift : ∀ c : NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D), ∃ t : NumberField.RingOfIntegers K,
      Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) t = c ∧
      ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (t : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw (z₀ : K) := by
    intro c
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective c
    obtain ⟨n, hn⟩ := hshift t z₀ hz₀
    refine ⟨t + ((n * (Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D) : ℕ) :
      NumberField.RingOfIntegers K) * z₀, ?_, hn⟩
    rw [Ideal.Quotient.eq]
    have : t + ((n * (Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D) : ℕ) :
        NumberField.RingOfIntegers K) * z₀ - t =
        ((n * (Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D) : ℕ) : NumberField.RingOfIntegers K) * z₀ := by
      ring
    rw [this]
    exact (𝔮 ⊓ 𝔮D).mul_mem_right _ (hN₀mem n)
  choose f hf₁ hf₂ using hlift
  refine ⟨f, hf₁, hf₂, ?_⟩
  
  have hmkkr : Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) r = 1 := by
    rw [← map_mul, ← map_one (Ideal.Quotient.mk (𝔮 ⊓ 𝔮D)), Ideal.Quotient.eq]
    exact hkr
  have hmrk : Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) r * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k = 1 := by
    rw [mul_comm]; exact hmkkr
  have hb : ∀ c, f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) - f c * k ∈ 𝔮 ⊓ 𝔮D := by
    intro c
    rw [← Ideal.Quotient.eq, map_mul, hf₁, hf₁]
  have hfib : ∀ c, (f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) - a ∈ 𝔮 ↔ f c - a ∈ 𝔮) := by
    intro c
    have h1 : f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) - f c ∈ 𝔮 := by
      have : f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) - f c =
          (f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) - f c * k) + f c * (k - 1) := by ring
      rw [this]
      exact 𝔮.add_mem (Submodule.mem_inf.mp (hb c)).1 (𝔮.mul_mem_left _ hk₁)
    constructor
    · intro h
      have := 𝔮.sub_mem h h1
      convert this using 1; ring
    · intro h
      have := 𝔮.add_mem h h1
      convert this using 1; ring
  have hψflip : ∀ c, ψ (f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k)) = - ψ (f c) := by
    intro c
    have hs : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw
              ((f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) : NumberField.RingOfIntegers K) : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw
              ((f c * k : NumberField.RingOfIntegers K) : K) := by
      intro w hw
      have hA := hf₂ (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) w hw
      have hB := hf₂ c w hw
      have hk := hkpos w hw
      set A := NumberField.InfinitePlace.embedding_of_isReal hw
              ((f (c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) : NumberField.RingOfIntegers K) : K)
      set B := NumberField.InfinitePlace.embedding_of_isReal hw
              ((f c : NumberField.RingOfIntegers K) : K)
      set Z := NumberField.InfinitePlace.embedding_of_isReal hw (z₀ : K)
      have hAB : 0 < A * B := by
        by_contra hneg
        push_neg at hneg
        nlinarith [mul_pos hA hB, sq_nonneg Z, mul_nonpos_of_nonpos_of_nonneg hneg (sq_nonneg Z)]
      have e : NumberField.InfinitePlace.embedding_of_isReal hw
              ((f c * k : NumberField.RingOfIntegers K) : K) =
          B * NumberField.InfinitePlace.embedding_of_isReal hw (k : K) := by
        simp only [B]; push_cast; simp only [map_mul]
      rw [e, ← mul_assoc]
      exact mul_pos hAB hk
    have := hC5 _ _ (Submodule.mem_inf.mp (hb c)).2 hs
    rw [this, hC3, hψk]; ring
  have key : ∀ s : Finset (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)),
      (∀ c, c ∈ s ↔ f c - a ∈ 𝔮) → ∑ c ∈ s, ((ψ (f c) : ℤ) : ℝ) = 0 := by
    intro s hs
    have hneg : ∑ c ∈ s, -((ψ (f c) : ℤ) : ℝ) = ∑ c ∈ s, ((ψ (f c) : ℤ) : ℝ) := by
      apply Finset.sum_nbij' (fun c => c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k)
        (fun c => c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) r)
      · intro c hc
        have hc' : c ∈ s := by simpa using hc
        have : c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k ∈ s := (hs _).2 ((hfib c).2 ((hs c).1 hc'))
        simpa using this
      · intro c hc
        have hc' : c ∈ s := by simpa using hc
        have h2 : f ((c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) r) * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) k) - a ∈ 𝔮 := by
          rw [mul_assoc, hmrk, mul_one]; exact (hs c).1 hc'
        have : c * Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) r ∈ s := (hs _).2 ((hfib _).1 h2)
        simpa using this
      · intro c _
        simp only [mul_assoc, hmkkr, mul_one]
      · intro c _
        simp only [mul_assoc, hmrk, mul_one]
      · intro c _
        simp only [hψflip c, Int.cast_neg]
    rw [Finset.sum_neg_distrib] at hneg
    linarith
  apply key
  intro c
  rw [Finset.mem_filter]
  simp

theorem kai_fiber_regroup_bound (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) (M : ℝ)
    (𝔮 𝔮D : Ideal (NumberField.RingOfIntegers K))
    [Fintype (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D))]
    (ψ : NumberField.RingOfIntegers K → ℤ) (hψ : IsRealRayChar 𝔮D ψ) (β : ℝ)
    (a x₀ : NumberField.RingOfIntegers K) (P : Set (Fin (Module.finrank ℚ K) → ℝ))
    (hsgn : ∀ x ∈ omegaBox ω M, (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P →
      ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (x₀ : K))
    (f : NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D) → NumberField.RingOfIntegers K)
    (hf₁ : ∀ c, Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) (f c) = c)
    (hf₂ : ∀ c (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      0 < NumberField.InfinitePlace.embedding_of_isReal hw
            ((f c : NumberField.RingOfIntegers K) : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw (x₀ : K))
    (hf₃ : ∑ c ∈ @Finset.filter (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) (fun c => f c - a ∈ 𝔮)
        (fun _ => Classical.propDecidable _) Finset.univ, ((ψ (f c) : ℤ) : ℝ) = 0)
    (I E : ℝ)
    (hcnt : ∀ b : NumberField.RingOfIntegers K,
      |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
            (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - b ∈ 𝔮 ⊓ 𝔮D)
            (fun _ => Classical.propDecidable _) (omegaBox ω M),
          ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) - I| ≤ E) :
    |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - a ∈ 𝔮)
          (fun _ => Classical.propDecidable _) (omegaBox ω M),
        ((ψ x : ℤ) : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1)|
      ≤ (Fintype.card (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) : ℝ) * E :=
by
  classical
  have h𝔮'𝔮 : 𝔮 ⊓ 𝔮D ≤ 𝔮 := inf_le_left
  have h𝔮'D : 𝔮 ⊓ 𝔮D ≤ 𝔮D := inf_le_right
  have hE : 0 ≤ E := (abs_nonneg _).trans (hcnt a)
  have hψ1 : ∀ y, |((ψ y : ℤ) : ℝ)| ≤ 1 := by
    intro y
    rcases hψ.1 y with h | h | h <;> simp [h]
  have sign : ∀ A B C : ℝ, 0 < A * C → 0 < B * C → 0 < A * B := by
    intro A B C h1 h2
    have h3 := mul_pos h1 h2
    have h4 : A * C * (B * C) = A * B * (C * C) := by ring
    rw [h4] at h3
    rcases mul_pos_iff.1 h3 with ⟨h5, _⟩ | ⟨_, h6⟩
    · exact h5
    · exact absurd h6 (not_lt.2 (mul_self_nonneg C))
  obtain ⟨F, hF⟩ : ∃ F : Finset (NumberField.RingOfIntegers K),
      F = @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - a ∈ 𝔮)
          (fun _ => Classical.propDecidable _) (omegaBox ω M) := ⟨_, rfl⟩
  obtain ⟨Fib, hFib⟩ : ∃ Fib : Finset (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)),
      Fib = @Finset.filter (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) (fun c => f c - a ∈ 𝔮)
        (fun _ => Classical.propDecidable _) Finset.univ := ⟨_, rfl⟩
  obtain ⟨Fb, hFb⟩ : ∃ Fb : NumberField.RingOfIntegers K → Finset (NumberField.RingOfIntegers K),
      ∀ b, Fb b = @Finset.filter (NumberField.RingOfIntegers K)
            (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - b ∈ 𝔮 ⊓ 𝔮D)
            (fun _ => Classical.propDecidable _) (omegaBox ω M) := ⟨_, fun _ => rfl⟩
  rw [← hF]
  rw [← hFib] at hf₃
  have hcnt' : ∀ b, |∑ x ∈ Fb b, ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) - I| ≤ E := by
    intro b; rw [hFb]; exact hcnt b
  have memF : ∀ x, x ∈ F ↔ x ∈ omegaBox ω M ∧
      (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - a ∈ 𝔮 := by
    intro x; rw [hF]; exact @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _
  have memFib : ∀ c, c ∈ Fib ↔ f c - a ∈ 𝔮 := by
    intro c; rw [hFib, @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _]
    simp
  have memFb : ∀ b x, x ∈ Fb b ↔ x ∈ omegaBox ω M ∧
      (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - b ∈ 𝔮 ⊓ 𝔮D := by
    intro b x; rw [hFb]; exact @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _
  have hmaps : ∀ x ∈ F, Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) x ∈ Fib := by
    intro x hx
    rw [memF] at hx
    rw [memFib]
    have h1 : f (Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) x) - x ∈ 𝔮 ⊓ 𝔮D := by
      rw [← Ideal.Quotient.eq, hf₁]
    have h2 : f (Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) x) - a
        = (f (Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) x) - x) + (x - a) := by ring
    rw [h2]
    exact Ideal.add_mem _ (h𝔮'𝔮 h1) hx.2.2
  have hconst : ∀ c, ∀ x ∈ Fb (f c), ψ x = ψ (f c) := by
    intro c x hx
    rw [memFb] at hx
    obtain ⟨hxB, hxP, hxd⟩ := hx
    apply hψ.2.2.2.2.1 x (f c) (h𝔮'D hxd)
    intro w hw
    exact sign _ _ _ (hsgn x hxB hxP w hw) (hf₂ c w hw)
  have hfib : ∀ c ∈ Fib,
      ∑ x ∈ F with Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) x = c,
          ((ψ x : ℤ) : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1)
        = ((ψ (f c) : ℤ) : ℝ) * I + ((ψ (f c) : ℤ) : ℝ) *
            (∑ x ∈ Fb (f c), ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) - I) := by
    intro c hc
    have hfc : f c - a ∈ 𝔮 := (memFib c).1 hc
    have hset : F.filter (fun x => Ideal.Quotient.mk (𝔮 ⊓ 𝔮D) x = c) = Fb (f c) := by
      ext x
      rw [Finset.mem_filter, memF, memFb]
      constructor
      · rintro ⟨⟨hxB, hxP, _⟩, hxc⟩
        refine ⟨hxB, hxP, ?_⟩
        rw [← Ideal.Quotient.eq, hf₁, hxc]
      · rintro ⟨hxB, hxP, hxd⟩
        refine ⟨⟨hxB, hxP, ?_⟩, ?_⟩
        · have h2 : x - a = (x - f c) + (f c - a) := by ring
          rw [h2]
          exact Ideal.add_mem _ (h𝔮'𝔮 hxd) hfc
        · rw [Ideal.Quotient.eq.2 hxd, hf₁]
    rw [hset]
    calc ∑ x ∈ Fb (f c), ((ψ x : ℤ) : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1)
        = ∑ x ∈ Fb (f c), ((ψ (f c) : ℤ) : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) :=
          Finset.sum_congr rfl (fun x hx => by rw [hconst c x hx])
      _ = ((ψ (f c) : ℤ) : ℝ) *
            ∑ x ∈ Fb (f c), ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) := by
          rw [Finset.mul_sum]
      _ = _ := by ring
  rw [← Finset.sum_fiberwise_of_maps_to hmaps, Finset.sum_congr rfl hfib,
    Finset.sum_add_distrib, ← Finset.sum_mul, hf₃, zero_mul, zero_add]
  calc |∑ c ∈ Fib, ((ψ (f c) : ℤ) : ℝ) *
          (∑ x ∈ Fb (f c), ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) - I)|
      ≤ ∑ c ∈ Fib, |((ψ (f c) : ℤ) : ℝ) *
          (∑ x ∈ Fb (f c), ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) - I)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ c ∈ Fib, E := by
        apply Finset.sum_le_sum
        intro c _
        rw [abs_mul]
        calc |((ψ (f c) : ℤ) : ℝ)| *
              |∑ x ∈ Fb (f c), ((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1) - I|
            ≤ 1 * E := mul_le_mul (hψ1 _) (hcnt' _) (abs_nonneg _) zero_le_one
          _ = E := one_mul E
    _ = (Fib.card : ℝ) * E := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (Fintype.card (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) : ℝ) * E :=
        mul_le_mul_of_nonneg_right (by exact_mod_cast Finset.card_le_univ Fib) hE

theorem kai_qmodel_piece_estimate (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C₆ : ℝ, 0 ≤ C₆ ∧
      ∀ (M : ℝ), 3 ≤ M → ∀ (ρ Y : ℝ), 0 ≤ ρ → 1 ≤ Y → Y ^ 2 ≤ M ^ ((1:ℝ)/2) →
      ∀ (𝔮 𝔮D : Ideal (NumberField.RingOfIntegers K))
        (ψD : NumberField.RingOfIntegers K → ℤ) (βD : ℝ),
        𝔮 ≠ ⊥ → 𝔮D ≠ ⊥ → (Ideal.absNorm 𝔮 : ℝ) ≤ Y →
        (ψD = 0 ∨ (IsRealRayChar 𝔮D ψD ∧ (Ideal.absNorm 𝔮D : ℝ) ≤ Y ∧ 1 / 2 ≤ βD ∧ βD < 1)) →
      ∀ (a x₀ : NumberField.RingOfIntegers K), IsCoprime (Ideal.span {a}) 𝔮 → x₀ - a ∈ 𝔮 →
      ∀ (P : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet P → Convex ℝ P →
        P ⊆ realBox (Module.finrank ℚ K) ((⌊M⌋₊ : ℝ) + 1 / 2) →
        (∀ v ∈ P, ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          0 < (kaiOmegaEmb ω v).1 w * (NumberField.mixedEmbedding K (x₀ : K)).1 w) →
        |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K) (fun x =>
              (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - a ∈ 𝔮)
              (fun _ => Classical.propDecidable _) (omegaBox ω M),
            qSiegelModel K ρ 𝔮 𝔮D ψD βD x
          - ρ / (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔮)ˣ) : ℝ) *
              ((MeasureTheory.volume P).toReal
                - (@ite ℝ (ψD ≠ 0 ∧ 𝔮 ≤ 𝔮D) (Classical.propDecidable _) ((ψD x₀ : ℤ) : ℝ) 0) *
                    ∫ v in P, (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ (βD - 1))|
          ≤ C₆ * ρ * Y ^ 4 * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 24) :=
by
  classical
  obtain ⟨C₅, hC₅, h5⟩ := kai_weighted_coset_count K ω
  refine ⟨2 * C₅, by linarith, ?_⟩
  intro M hM ρ Y hρ hY hYM 𝔮 𝔮D ψD βD h𝔮 h𝔮D hN𝔮 hψ a x₀ hcop hx₀ P hPm hPc hPbox hPor
  have hMpos : 0 < M := by linarith
  obtain ⟨E, hE_def⟩ : ∃ E : ℝ, E = C₅ * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 24) := ⟨_, rfl⟩
  have hE0 : 0 ≤ E := by rw [hE_def]; exact mul_nonneg hC₅ (Real.rpow_nonneg hMpos.le _)
  have hgoalR : 2 * C₅ * ρ * Y ^ 4 * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 24)
      = ρ * Y ^ 4 * E + ρ * Y ^ 4 * E := by rw [hE_def]; ring
  rw [hgoalR]
  
  have hN𝔮ne : Ideal.absNorm 𝔮 ≠ 0 := fun h => h𝔮 (Ideal.absNorm_eq_zero_iff.1 h)
  have hN𝔮1 : (1:ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.2 hN𝔮ne
  have hN𝔮pos : (0:ℝ) < (Ideal.absNorm 𝔮 : ℝ) := by linarith
  have hY2 : 1 ≤ Y ^ 2 := one_le_pow₀ hY
  have hYY2 : Y ≤ Y ^ 2 := by
    calc Y = Y * 1 := by ring
      _ ≤ Y * Y := mul_le_mul_of_nonneg_left hY (by linarith)
      _ = Y ^ 2 := by ring
  have hY2Y4 : Y ^ 2 ≤ Y ^ 4 := by
    calc Y ^ 2 = Y ^ 2 * 1 := by ring
      _ ≤ Y ^ 2 * Y ^ 2 := mul_le_mul_of_nonneg_left hY2 (by positivity)
      _ = Y ^ 4 := by ring
  have hN𝔮M : (Ideal.absNorm 𝔮 : ℝ) ≤ M ^ ((1:ℝ)/2) := by linarith
  have hN𝔮Y4 : (Ideal.absNorm 𝔮 : ℝ) ≤ Y ^ 4 := by linarith
  have hY4 : 0 ≤ ρ * Y ^ 4 := mul_nonneg hρ (by positivity)
  have hdivle : ∀ (A : ℝ) (k : ℕ), 0 ≤ A → A / (k : ℝ) ≤ A := by
    intro A k hA
    rcases Nat.eq_zero_or_pos k with h0 | hpos
    · rw [h0, Nat.cast_zero, div_zero]; exact hA
    · exact div_le_self hA (by exact_mod_cast hpos)
  have hcopT : ∀ x y : NumberField.RingOfIntegers K, x - y ∈ 𝔮 →
      IsCoprime (Ideal.span {y}) 𝔮 → IsCoprime (Ideal.span {x}) 𝔮 := by
    intro x y hxy hy
    rw [Ideal.isCoprime_iff_exists] at hy ⊢
    obtain ⟨i, hi, j, hj, hij⟩ := hy
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.1 hi
    refine ⟨r * x, Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self x), j - r * (x - y),
      Ideal.sub_mem _ hj (Ideal.mul_mem_left _ _ hxy), ?_⟩
    rw [← hij]; ring
  
  have hemb : ∀ x : NumberField.RingOfIntegers K,
      kaiOmegaEmb ω (fun j => ((ω.equivFun x j : ℤ) : ℝ))
        = NumberField.mixedEmbedding K (x : K) := by
    intro x
    unfold kaiOmegaEmb
    have h1 : (x : K) = algebraMap (NumberField.RingOfIntegers K) K x := rfl
    rw [h1]
    conv_rhs => rw [← ω.sum_equivFun x]
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_zsmul, map_zsmul, Int.cast_smul_eq_zsmul]
  have hsgnF : ∀ x ∈ omegaBox ω M, (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P →
      ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (x₀ : K) := by
    intro x _ hxP w hw
    have h := hPor _ hxP ⟨w, hw⟩
    rw [hemb x, NumberField.mixedEmbedding.mixedEmbedding_apply_isReal,
      NumberField.mixedEmbedding.mixedEmbedding_apply_isReal] at h
    exact h
  
  obtain ⟨F, hF⟩ : ∃ F : Finset (NumberField.RingOfIntegers K),
      F = @Finset.filter (NumberField.RingOfIntegers K) (fun x =>
              (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - a ∈ 𝔮)
              (fun _ => Classical.propDecidable _) (omegaBox ω M) := ⟨_, rfl⟩
  rw [← hF]
  have hmemF : ∀ x, x ∈ F ↔ x ∈ omegaBox ω M ∧
      ((fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - a ∈ 𝔮) := by
    intro x; rw [hF]; exact @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _
  obtain ⟨φ, hφ⟩ : ∃ φ : ℝ, φ = (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔮)ˣ) : ℝ) :=
    ⟨_, rfl⟩
  obtain ⟨φ', hφ'⟩ : ∃ φ' : ℝ,
      φ' = (Nat.card ((NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D))ˣ) : ℝ) := ⟨_, rfl⟩
  obtain ⟨N', hN'⟩ : ∃ N' : ℝ, N' = (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) := ⟨_, rfl⟩
  obtain ⟨V, hV⟩ : ∃ V : ℝ, V = (MeasureTheory.volume P).toReal := ⟨_, rfl⟩
  obtain ⟨I, hI⟩ : ∃ I : ℝ,
      I = ∫ v in P, (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ (βD - 1) := ⟨_, rfl⟩
  obtain ⟨ε, hε⟩ : ∃ ε : ℝ,
      ε = (@ite ℝ (ψD ≠ 0 ∧ 𝔮 ≤ 𝔮D) (Classical.propDecidable _) ((ψD x₀ : ℤ) : ℝ) 0) :=
    ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : ℝ,
      T = ∑ x ∈ F, ((ψD x : ℤ) : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ (βD - 1) := ⟨_, rfl⟩
  rw [← hφ, ← hV, ← hI, ← hε]
  have hφ0 : 0 ≤ φ := by rw [hφ]; exact Nat.cast_nonneg _
  have hφ'0 : 0 ≤ φ' := by rw [hφ']; exact Nat.cast_nonneg _
  have hρφ : ρ / φ ≤ ρ := by rw [hφ]; exact hdivle ρ _ hρ
  have hρφ0 : 0 ≤ ρ / φ := div_nonneg hρ hφ0
  have hqF : ∀ x ∈ F, qSiegelModel K ρ 𝔮 𝔮D ψD βD x
      = ρ * ((Ideal.absNorm 𝔮 : ℝ) / φ)
        - ρ * (N' / φ') * (((ψD x : ℤ) : ℝ) * ((Algebra.norm ℤ x).natAbs : ℝ) ^ (βD - 1)) := by
    intro x hx
    have hxa := ((hmemF x).1 hx).2.2
    unfold qSiegelModel
    rw [if_pos (hcopT x a hxa hcop), hφ, hφ', hN']
    ring
  have hsum : ∑ x ∈ F, qSiegelModel K ρ 𝔮 𝔮D ψD βD x
      = ρ * ((Ideal.absNorm 𝔮 : ℝ) / φ) * (F.card : ℝ) - ρ * (N' / φ') * T := by
    rw [Finset.sum_congr rfl hqF, Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul, hT,
      Finset.mul_sum]
    ring
  rw [hsum]
  
  have hA : |ρ * ((Ideal.absNorm 𝔮 : ℝ) / φ) * (F.card : ℝ) - ρ / φ * V|
      ≤ ρ * Y ^ 4 * E := by
    have h := h5 M hM 𝔮 h𝔮 hN𝔮M a 1 (by norm_num) le_rfl P hPm hPc hPbox
    rw [← hF, ← hE_def] at h
    simp only [sub_self, Real.rpow_zero, Finset.sum_const, nsmul_eq_mul, mul_one,
      MeasureTheory.setIntegral_const, smul_eq_mul, MeasureTheory.measureReal_def] at h
    rw [← hV] at h
    have key : ρ * ((Ideal.absNorm 𝔮 : ℝ) / φ) * (F.card : ℝ) - ρ / φ * V
        = (ρ / φ * (Ideal.absNorm 𝔮 : ℝ))
          * ((F.card : ℝ) - 1 / (Ideal.absNorm 𝔮 : ℝ) * V) := by
      have h1 : (Ideal.absNorm 𝔮 : ℝ) * (1 / (Ideal.absNorm 𝔮 : ℝ)) = 1 := by
        field_simp
      calc _ = ρ / φ * (Ideal.absNorm 𝔮 : ℝ) * (F.card : ℝ)
            - ρ / φ * ((Ideal.absNorm 𝔮 : ℝ) * (1 / (Ideal.absNorm 𝔮 : ℝ))) * V := by
              rw [h1]; ring
        _ = _ := by ring
    have hc0 : 0 ≤ ρ / φ * (Ideal.absNorm 𝔮 : ℝ) := mul_nonneg hρφ0 hN𝔮pos.le
    have hc : ρ / φ * (Ideal.absNorm 𝔮 : ℝ) ≤ ρ * Y ^ 4 := mul_le_mul hρφ hN𝔮Y4 hN𝔮pos.le hρ
    rw [key, abs_mul, abs_of_nonneg hc0]
    exact mul_le_mul hc h (abs_nonneg _) hY4
  
  have hB : |ρ * (N' / φ') * T - ρ / φ * ε * I| ≤ ρ * Y ^ 4 * E := by
    by_cases h0 : ψD = 0
    · 
      have hT0 : T = 0 := by
        rw [hT, h0]; simp only [Pi.zero_apply, Int.cast_zero, zero_mul, Finset.sum_const_zero]
      have hε0 : ε = 0 := by rw [hε, if_neg (fun h => h.1 h0)]
      rw [hT0, hε0]
      simp only [mul_zero, zero_mul, sub_zero, abs_zero]
      exact mul_nonneg hY4 hE0
    obtain ⟨hR, hND, hβ1, hβ2⟩ := hψ.resolve_left h0
    by_cases hle : 𝔮 ≤ 𝔮D
    · 
      have hinf : 𝔮 ⊓ 𝔮D = 𝔮 := inf_eq_left.2 hle
      rw [hinf] at hN' hφ'
      rw [hN', hφ', ← hφ]
      have hε1 : ε = ((ψD x₀ : ℤ) : ℝ) := by rw [hε, if_pos ⟨h0, hle⟩]
      have hψc : ∀ x ∈ F, ψD x = ψD x₀ := by
        intro x hx
        obtain ⟨hxob, hxP, hxa⟩ := (hmemF x).1 hx
        apply hR.2.2.2.2.1 x x₀ _ (hsgnF x hxob hxP)
        have : x - x₀ = (x - a) - (x₀ - a) := by ring
        rw [this]; exact hle (Ideal.sub_mem _ hxa hx₀)
      obtain ⟨S, hS⟩ : ∃ S : ℝ,
          S = ∑ x ∈ F, ((Algebra.norm ℤ x).natAbs : ℝ) ^ (βD - 1) := ⟨_, rfl⟩
      have hTS : T = ((ψD x₀ : ℤ) : ℝ) * S := by
        rw [hT, hS, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun x hx => ?_)
        rw [hψc x hx]
      have h := h5 M hM 𝔮 h𝔮 hN𝔮M a βD hβ1 hβ2.le P hPm hPc hPbox
      rw [← hF, ← hE_def, ← hS, ← hI] at h
      have hψ1 : |((ψD x₀ : ℤ) : ℝ)| ≤ 1 := by
        rcases hR.1 x₀ with h' | h' | h' <;> simp [h']
      have key : ρ * ((Ideal.absNorm 𝔮 : ℝ) / φ) * T - ρ / φ * ε * I
          = (ρ / φ * (Ideal.absNorm 𝔮 : ℝ) * ((ψD x₀ : ℤ) : ℝ))
            * (S - 1 / (Ideal.absNorm 𝔮 : ℝ) * I) := by
        have h1 : (Ideal.absNorm 𝔮 : ℝ) * (1 / (Ideal.absNorm 𝔮 : ℝ)) = 1 := by
          field_simp
        rw [hTS, hε1]
        calc _ = ρ / φ * (Ideal.absNorm 𝔮 : ℝ) * ((ψD x₀ : ℤ) : ℝ) * S
              - ρ / φ * ((Ideal.absNorm 𝔮 : ℝ) * (1 / (Ideal.absNorm 𝔮 : ℝ)))
                * ((ψD x₀ : ℤ) : ℝ) * I := by
                rw [h1]; ring
          _ = _ := by ring
      have hc0 : 0 ≤ ρ / φ * (Ideal.absNorm 𝔮 : ℝ) := mul_nonneg hρφ0 hN𝔮pos.le
      have hc : |ρ / φ * (Ideal.absNorm 𝔮 : ℝ) * ((ψD x₀ : ℤ) : ℝ)| ≤ ρ * Y ^ 4 := by
        rw [abs_mul, abs_of_nonneg hc0]
        calc ρ / φ * (Ideal.absNorm 𝔮 : ℝ) * |((ψD x₀ : ℤ) : ℝ)|
            ≤ ρ / φ * (Ideal.absNorm 𝔮 : ℝ) * 1 := mul_le_mul_of_nonneg_left hψ1 hc0
          _ ≤ ρ * Y ^ 4 := by rw [mul_one]; exact mul_le_mul hρφ hN𝔮Y4 hN𝔮pos.le hρ
      rw [key, abs_mul]
      exact mul_le_mul hc h (abs_nonneg _) hY4
    · 
      have hε0 : ε = 0 := by rw [hε, if_neg (fun h => hle h.2)]
      rw [hε0, mul_zero, zero_mul, sub_zero]
      have hne : Ideal.absNorm (𝔮 * 𝔮D) ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]
        intro h
        rcases Ideal.mul_eq_bot.1 h with h | h
        · exact h𝔮 h
        · exact h𝔮D h
      have hdvd : Ideal.absNorm (𝔮 ⊓ 𝔮D) ∣ Ideal.absNorm (𝔮 * 𝔮D) :=
        Ideal.absNorm_dvd_absNorm_of_le Ideal.mul_le_inf
      have hN'ne : Ideal.absNorm (𝔮 ⊓ 𝔮D) ≠ 0 := by
        intro h; rw [h, zero_dvd_iff] at hdvd; exact hne hdvd
      have h𝔮'ne : 𝔮 ⊓ 𝔮D ≠ ⊥ := fun h => hN'ne (Ideal.absNorm_eq_zero_iff.2 h)
      have hle' : Ideal.absNorm (𝔮 ⊓ 𝔮D) ≤ Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D := by
        rw [← map_mul]; exact Nat.le_of_dvd (Nat.pos_of_ne_zero hne) hdvd
      have hN'0 : 0 ≤ N' := by rw [hN']; exact Nat.cast_nonneg _
      have hN'Y2 : N' ≤ Y ^ 2 := by
        rw [hN']
        calc (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) * Ideal.absNorm 𝔮D := by
              exact_mod_cast hle'
          _ ≤ Y * Y := mul_le_mul hN𝔮 hND (Nat.cast_nonneg _) (zero_le_one.trans hY)
          _ = Y ^ 2 := by ring
      have hN'M : (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) ≤ M ^ ((1:ℝ)/2) := by
        rw [← hN']; exact hN'Y2.trans hYM
      have hfin : Finite (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) := by
        apply Nat.finite_of_card_ne_zero
        rw [← Submodule.cardQuot_apply, ← Ideal.absNorm_apply]; exact hN'ne
      letI : Fintype (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) := Fintype.ofFinite _
      have hcard : (Fintype.card (NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D)) : ℝ) = N' := by
        rw [hN', ← Nat.card_eq_fintype_card, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply]
      have hTb : |T| ≤ N' * E := by
        by_cases hFe : F = ∅
        · rw [hT, hFe, Finset.sum_empty, abs_zero]; exact mul_nonneg hN'0 hE0
        obtain ⟨x₁, hx₁⟩ := Finset.nonempty_iff_ne_empty.2 hFe
        obtain ⟨hx₁ob, hx₁P, -⟩ := (hmemF x₁).1 hx₁
        have hz₀ : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
            NumberField.InfinitePlace.embedding_of_isReal hw (x₀ : K) ≠ 0 := by
          intro w hw h
          have := hsgnF x₁ hx₁ob hx₁P w hw
          rw [h, mul_zero] at this
          exact lt_irrefl 0 this
        obtain ⟨f, hf₁, hf₂, hf₃⟩ :=
          kai_siegel_fiber_cancellation K 𝔮 𝔮D h𝔮 h𝔮D ψD hR hle a x₀ hz₀
        have hcnt : ∀ b : NumberField.RingOfIntegers K,
            |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                  (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ P ∧ x - b ∈ 𝔮 ⊓ 𝔮D)
                  (fun _ => Classical.propDecidable _) (omegaBox ω M),
                ((Algebra.norm ℤ x).natAbs : ℝ) ^ (βD - 1) - (1 / N') * I| ≤ E := by
          intro b
          have h := h5 M hM (𝔮 ⊓ 𝔮D) h𝔮'ne hN'M b βD hβ1 hβ2.le P hPm hPc hPbox
          rw [← hN', ← hI, ← hE_def] at h
          exact h
        have h := kai_fiber_regroup_bound K ω M 𝔮 𝔮D ψD hR βD a x₀ P hsgnF f hf₁ hf₂ hf₃
          ((1 / N') * I) E hcnt
        rw [← hF, ← hT, hcard] at h
        exact h
      have hφ'le : N' / φ' ≤ N' := by rw [hφ']; exact hdivle N' _ hN'0
      have hc0 : 0 ≤ ρ * (N' / φ') := mul_nonneg hρ (div_nonneg hN'0 hφ'0)
      rw [abs_mul, abs_of_nonneg hc0]
      calc ρ * (N' / φ') * |T| ≤ ρ * N' * (N' * E) :=
            mul_le_mul (mul_le_mul_of_nonneg_left hφ'le hρ) hTb (abs_nonneg _)
              (mul_nonneg hρ hN'0)
        _ = ρ * (N' * N') * E := by ring
        _ ≤ ρ * Y ^ 4 * E := by
            apply mul_le_mul_of_nonneg_right _ hE0
            apply mul_le_mul_of_nonneg_left _ hρ
            calc N' * N' ≤ Y ^ 2 * Y ^ 2 := mul_le_mul hN'Y2 hN'Y2 hN'0 (by positivity)
              _ = Y ^ 4 := by ring
  
  have hsplit : ρ * ((Ideal.absNorm 𝔮 : ℝ) / φ) * (F.card : ℝ) - ρ * (N' / φ') * T
        - ρ / φ * (V - ε * I)
      = (ρ * ((Ideal.absNorm 𝔮 : ℝ) / φ) * (F.card : ℝ) - ρ / φ * V)
        - (ρ * (N' / φ') * T - ρ / φ * ε * I) := by ring
  rw [hsplit]
  exact (abs_sub _ _).trans (add_le_add hA hB)

theorem kai_prime_side_siegel_pnt (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B₀ : ℝ) (hB₀ : 0 < B₀) (hB₀h : B₀ ≤ 1 / 2) :
    ∃ ρ : ℝ, 0 < ρ ∧
      ∀ (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ
            (NumberField.RingOfIntegers K)),
        IsNormLengthCompatible C ω →
        ∃ c₃ C₃ : ℝ, 0 < c₃ ∧ 0 ≤ C₃ ∧
          ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
            Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
            (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
          ∀ (𝔮D : Ideal (NumberField.RingOfIntegers K))
            (ψD : NumberField.RingOfIntegers K → ℤ) (βD : ℝ)
            (lamD : Ideal (NumberField.RingOfIntegers K) → ℂ),
            IsLPExceptional K B₀ (m : ℝ) 𝔮D ψD βD lamD →
          ∀ (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet Ω → Convex ℝ Ω →
          ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
            (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₃) →
          ∀ a : NumberField.RingOfIntegers K,
            |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                  (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧ x - a ∈ 𝔮)
                  (fun _ => Classical.propDecidable _) (omegaBox ω M),
                (vonMangoldtO x - qSiegelModel K ρ 𝔮 𝔮D ψD βD x)|
              ≤ C₃ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ c₃)) :=
by
  classical
  obtain ⟨cP, hcP, hPS⟩ := kai_lp_principal_prime_sum K B₀ hB₀ hB₀h
  obtain ⟨c₀, C₀, hc₀, hC₀, hCell⟩ := kai_lp_cell_estimate K cP hcP
  have hκ₀ : 0 < kaiKappa0 K := by
    unfold kaiKappa0
    have h1 : (0:ℝ) < ((NumberField.Units.torsionOrder K : ℕ) : ℝ) := by
      exact_mod_cast NumberField.Units.torsionOrder_pos K
    have h2 : (0:ℝ) < (NumberField.classNumber K : ℝ) := by
      exact_mod_cast NumberField.classNumber_pos K
    have h3 := NumberField.Units.regulator_pos K
    have h4 := Real.pi_pos
    positivity
  obtain ⟨c₄, C₄, hc₄, hC₄, hConv⟩ :=
    kai_lp_convex_of_cell K c₀ C₀ (kaiKappa0 K) hc₀ hC₀ hκ₀.le
  obtain ⟨covol, hcov, hL⟩ := kai_omega_mixed_change K
  obtain ⟨ρ, hρ_def⟩ : ∃ ρ : ℝ, ρ = kaiKappa0 K * covol := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρ_def]; exact mul_pos hκ₀ hcov
  refine ⟨ρ, hρ, ?_⟩
  intro C ω hω
  obtain ⟨hL1, -, hLopen, hLconv, hLorth, hLvol, hLint, hLnorm⟩ := hL ω
  obtain ⟨C₆, hC₆, hModel⟩ := kai_qmodel_piece_estimate K ω
  obtain ⟨C₇, hC₇, hΛprime, hNeg⟩ := kai_vonMangoldt_negligible K C ω hω
  obtain ⟨C₉, hC₉, hBd⟩ := kai_convex_boundary_lattice K ω
  have hC1 : 1 < C := hω.1
  have hlogC : 0 < Real.log C := Real.log_pos hC1
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hn1r : (1:ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn1
  obtain ⟨c₃, hc₃_def⟩ : ∃ c₃ : ℝ, c₃ = min (min c₀ c₄) (1 / 100) := ⟨_, rfl⟩
  have hc₃pos : 0 < c₃ := by rw [hc₃_def]; exact lt_min (lt_min hc₀ hc₄) (by norm_num)
  have hc₃c₀ : c₃ ≤ c₀ := by rw [hc₃_def]; exact (min_le_left _ _).trans (min_le_left _ _)
  have hc₃c₄ : c₃ ≤ c₄ := by rw [hc₃_def]; exact (min_le_left _ _).trans (min_le_right _ _)
  have hc₃100 : c₃ ≤ 1 / 100 := by rw [hc₃_def]; exact min_le_right _ _
  obtain ⟨NP, hNP⟩ : ∃ NP : ℕ, NP = Fintype.card (KaiPattern K) := ⟨_, rfl⟩
  obtain ⟨KX, hKX⟩ : ∃ KX : ℝ, KX = 2 * (Module.finrank ℚ K : ℝ) * C + 1 := ⟨_, rfl⟩
  have hKX0 : 0 ≤ KX := by rw [hKX]; nlinarith
  obtain ⟨T₀, hT₀⟩ : ∃ T₀ : ℝ, T₀ = (Module.finrank ℚ K : ℝ) * (Real.log C + 8000)
      + ρ * (Real.exp 20 + Real.exp 40) := ⟨_, rfl⟩
  have hT₀0 : 0 ≤ T₀ := by
    rw [hT₀]
    exact add_nonneg (mul_nonneg (by linarith) (by linarith)) (mul_nonneg hρ.le (by positivity))
  obtain ⟨Knc, hKnc⟩ : ∃ K' : ℝ, K' = C₇ * (1 + 2 * 2 ^ (Module.finrank ℚ K + 2)
      * ((Module.finrank ℚ K + 2).factorial : ℝ)) := ⟨_, rfl⟩
  have hKnc0 : 0 ≤ Knc := by rw [hKnc]; exact mul_nonneg hC₇ (by positivity)
  obtain ⟨Kbd, hKbd⟩ : ∃ K' : ℝ, K' = (C₉ + 1) * 2 ^ (Module.finrank ℚ K - 1)
      * ((Module.finrank ℚ K : ℝ) * Real.log C + 2 * (Module.finrank ℚ K : ℝ) + 2 * ρ) :=
    ⟨_, rfl⟩
  have hKbd0 : 0 ≤ Kbd := by
    rw [hKbd]
    exact mul_nonneg (mul_nonneg (by linarith) (by positivity))
      (by have := mul_nonneg (by linarith : (0:ℝ) ≤ (Module.finrank ℚ K : ℝ)) hlogC.le
          linarith)
  obtain ⟨Kmain, hKmain⟩ : ∃ K' : ℝ,
      K' = (NP : ℝ) * (C₄ * KX ^ Module.finrank ℚ K + C₆ * ρ) := ⟨_, rfl⟩
  have hKmain0 : 0 ≤ Kmain := by
    rw [hKmain]
    exact mul_nonneg (Nat.cast_nonneg _)
      (add_nonneg (mul_nonneg hC₄ (pow_nonneg hKX0 _)) (mul_nonneg hC₆ hρ.le))
  refine ⟨c₃, T₀ * Real.exp 20 + Knc + Kbd + C₇ + Kmain, hc₃pos,
    add_nonneg (add_nonneg (add_nonneg (add_nonneg (mul_nonneg hT₀0 (Real.exp_pos _).le) hKnc0)
      hKbd0) hC₇) hKmain0, ?_⟩
  intro M m hM hm1 hm2 𝔮D ψD βD lamD hLP Ω hΩm hΩc 𝔮 h𝔮 hN𝔮 a
  rw [Finset.filter_congr_decidable]
  
  have hMpos : 0 < M := by linarith
  have hM1 : 1 ≤ M := by linarith
  obtain ⟨t, ht_def⟩ : ∃ t, t = Real.log M := ⟨_, rfl⟩
  have hexpt : Real.exp t = M := by rw [ht_def]; exact Real.exp_log hMpos
  have ht1 : 1 ≤ t := by
    rw [ht_def, Real.le_log_iff_exp_le hMpos]; have := Real.exp_one_lt_d9; linarith
  have ht0 : 0 ≤ t := by linarith
  rw [← ht_def] at hm1 hm2 hN𝔮 ⊢
  obtain ⟨u, hu_def⟩ : ∃ u, u = t ^ ((1:ℝ)/3) := ⟨_, rfl⟩
  rw [← hu_def] at hm2
  have hu3 : u ^ 3 = t := by
    rw [hu_def, ← Real.rpow_natCast, ← Real.rpow_mul ht0]; norm_num
  have hu1 : 1 ≤ u := by rw [hu_def]; exact Real.one_le_rpow ht1 (by norm_num)
  have htc₃ : t ^ c₃ ≤ u := by
    rw [hu_def]; exact Real.rpow_le_rpow_of_exponent_le ht1 (by linarith)
  have htc₃0 : 0 ≤ t ^ c₃ := Real.rpow_nonneg ht0 _
  
  have hm0 : (0:ℝ) < m := lt_of_lt_of_le (Real.exp_pos _) hm1
  have hmu : (m:ℝ) ≤ Real.exp u := by linarith
  have hlogm : Real.log m ≤ u := by
    calc Real.log m ≤ Real.log (Real.exp u) := Real.log_le_log hm0 hmu
      _ = u := Real.log_exp u
  have hm3 : (3:ℝ) ≤ m := by
    have h1 : 1 ≤ t ^ ((1:ℝ)/100) := Real.one_le_rpow ht1 (by norm_num)
    have he : Real.exp 1 ≤ (m : ℝ) := (Real.exp_le_exp.2 h1).trans hm1
    have he2 : (2:ℝ) < m := by have := Real.exp_one_gt_d9; linarith
    have hm2' : 2 < m := by exact_mod_cast he2
    exact_mod_cast (show 3 ≤ m by omega)
  have hlogm1 : 1 ≤ Real.log m := by
    rw [Real.le_log_iff_exp_le hm0]; have := Real.exp_one_lt_d9; linarith
  have hN𝔮u : (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp u := hN𝔮.trans (Real.exp_le_exp.2 htc₃)
  have hN𝔮m : (Ideal.absNorm 𝔮 : ℝ) ≤ m :=
    hN𝔮.trans ((Real.exp_le_exp.2 (Real.rpow_le_rpow_of_exponent_le ht1 hc₃100)).trans hm1)
  
  have h𝔮D : 𝔮D ≠ ⊥ := hLP.1
  have hψ' : ψD = 0 ∨ (IsRealRayChar 𝔮D ψD ∧ (Ideal.absNorm 𝔮D : ℝ) ≤ Real.exp u ∧
      1 / 2 ≤ βD ∧ βD < 1) := by
    rcases hLP.2.1 with h | ⟨hR, hN, hβ1, hβ2, -⟩
    · exact Or.inl h
    · refine Or.inr ⟨hR, hN.trans hmu, ?_, hβ2⟩
      have : B₀ / Real.log m ≤ B₀ := div_le_self hB₀.le hlogm1
      linarith
  have hinf : ψD ≠ 0 → (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) ≤ Real.exp (2 * u) := by
    intro hψ0
    obtain ⟨-, hND, -, -⟩ := hψ'.resolve_left hψ0
    have hdvd : Ideal.absNorm (𝔮 ⊓ 𝔮D) ∣ Ideal.absNorm (𝔮 * 𝔮D) :=
      Ideal.absNorm_dvd_absNorm_of_le Ideal.mul_le_inf
    have hne : Ideal.absNorm (𝔮 * 𝔮D) ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]
      intro h
      rcases Ideal.mul_eq_bot.1 h with h | h
      · exact h𝔮 h
      · exact h𝔮D h
    have hle : Ideal.absNorm (𝔮 ⊓ 𝔮D) ≤ Ideal.absNorm 𝔮 * Ideal.absNorm 𝔮D := by
      rw [← map_mul]; exact Nat.le_of_dvd (Nat.pos_of_ne_zero hne) hdvd
    calc (Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) * Ideal.absNorm 𝔮D := by
          exact_mod_cast hle
      _ ≤ Real.exp u * Real.exp u :=
          mul_le_mul hN𝔮u hND (Nat.cast_nonneg _) (Real.exp_pos _).le
      _ = Real.exp (2 * u) := by rw [← Real.exp_add]; ring_nf
  have hdivle : ∀ (A : ℝ) (k : ℕ), 0 ≤ A → A / (k : ℝ) ≤ A := by
    intro A k hA
    rcases Nat.eq_zero_or_pos k with h0 | hpos
    · rw [h0, Nat.cast_zero, div_zero]; exact hA
    · exact div_le_self hA (by exact_mod_cast hpos)
  
  have hqM : ∀ x : NumberField.RingOfIntegers K,
      |qSiegelModel K ρ 𝔮 𝔮D ψD βD x| ≤ ρ * (Real.exp u + Real.exp (2 * u)) := by
    intro x
    have hA : |ρ * ((Ideal.absNorm 𝔮 : ℝ) /
        (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔮)ˣ) : ℝ))| ≤ ρ * Real.exp u := by
      rw [abs_of_nonneg (mul_nonneg hρ.le (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)))]
      exact mul_le_mul_of_nonneg_left ((hdivle _ _ (Nat.cast_nonneg _)).trans hN𝔮u) hρ.le
    have hB : |ρ * ((Ideal.absNorm (𝔮 ⊓ 𝔮D) : ℝ) /
          (Nat.card ((NumberField.RingOfIntegers K ⧸ (𝔮 ⊓ 𝔮D))ˣ) : ℝ))
          * (ψD x : ℝ) * (((Algebra.norm ℤ x).natAbs : ℝ) ^ (βD - 1))|
        ≤ ρ * Real.exp (2 * u) := by
      by_cases hψ0 : ψD = 0
      · rw [hψ0]; simp only [Pi.zero_apply, Int.cast_zero, mul_zero, zero_mul, abs_zero]
        exact mul_nonneg hρ.le (Real.exp_pos _).le
      · obtain ⟨hR, -, -, hβ2⟩ := hψ'.resolve_left hψ0
        have hψx : |(ψD x : ℝ)| ≤ 1 := by
          rcases hR.1 x with h | h | h <;> simp [h]
        have hnt : 0 ≤ ((Algebra.norm ℤ x).natAbs : ℝ) ^ (βD - 1) ∧
            ((Algebra.norm ℤ x).natAbs : ℝ) ^ (βD - 1) ≤ 1 := by
