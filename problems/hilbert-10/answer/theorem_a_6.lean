        have hS0 : 0 ≤ S := by rw [hS_def]; exact norm_nonneg _
        have h8 : S ^ 8 ≤ ((p:ℝ) ^ (2 * d) * δ ^ (d + 2)) ^ 4 := by
          have e1 : ((p:ℝ) ^ (2 * d) * δ ^ (d + 2)) ^ 4 = (p:ℝ) ^ (8 * d) * δ ^ (4 * d + 8) := by
            ring
          rw [e1]
          refine le_trans (le_of_eq ?_) (h3.trans hGow)
          rw [hS_def, hΦ_def]
          simp only [Complex.ofReal_prod]
        have h8' : (S ^ 2) ^ 4 ≤ ((p:ℝ) ^ (2 * d) * δ ^ (d + 2)) ^ 4 := by
          calc (S ^ 2) ^ 4 = S ^ 8 := by ring
            _ ≤ _ := h8
        exact (pow_le_pow_iff_left₀ (by positivity) hW0 (by norm_num : (4:ℕ) ≠ 0)).1 h8'
      
      have h4 := zmod_fourier_smoothing p d r hr1 hrp G Φ _ hW
      have hG2 : ∑ x, G x ^ 2 = ∑ x, G x :=
        Finset.sum_congr rfl (fun x _ => by rcases hG01 x with h | h <;> rw [h] <;> norm_num)
      have hrpos : (0:ℝ) < (r:ℝ) ^ d := by
        have : (0:ℝ) < r := by exact_mod_cast hr1
        positivity
      have hrne : (r:ℝ) ^ d ≠ 0 := hrpos.ne'
      have hp0 : (0:ℝ) ≤ p := Nat.cast_nonneg p
      have hmain : |∑ x, zmodBoxSmooth r G x * Φ x| ≤ 2 ^ d * (p:ℝ) ^ d * δ := by
        have h2d : (2:ℝ) ^ d ≤ (2 ^ d) ^ 2 := by
          have : (1:ℝ) ≤ 2 ^ d := one_le_pow₀ (by norm_num)
          nlinarith
        have hsq : (∑ x, zmodBoxSmooth r G x * Φ x) ^ 2 ≤ (2 ^ d * (p:ℝ) ^ d * δ) ^ 2 := by
          calc (∑ x, zmodBoxSmooth r G x * Φ x) ^ 2
              ≤ (∑ x, G x ^ 2) / (r:ℝ) ^ d * ((p:ℝ) ^ (2 * d) * δ ^ (d + 2)) := h4
            _ ≤ (2 * (N:ℝ) + 1) ^ d / (r:ℝ) ^ d * ((p:ℝ) ^ (2 * d) * δ ^ (d + 2)) := by
                rw [hG2]
                exact mul_le_mul_of_nonneg_right
                  (div_le_div_of_nonneg_right hGsum hrpos.le) hW0
            _ = (p:ℝ) ^ (2 * d) * ((2 * (N:ℝ) + 1) ^ d * δ ^ (d + 2)) / (r:ℝ) ^ d := by ring
            _ ≤ (p:ℝ) ^ (2 * d) * (2 ^ d * δ ^ 2 * (r:ℝ) ^ d) / (r:ℝ) ^ d := by
                apply div_le_div_of_nonneg_right _ hrpos.le
                exact mul_le_mul_of_nonneg_left hr4 (by positivity)
            _ = 2 ^ d * (p:ℝ) ^ (2 * d) * δ ^ 2 := by field_simp
            _ ≤ (2 ^ d) ^ 2 * (p:ℝ) ^ (2 * d) * δ ^ 2 := by
                apply mul_le_mul_of_nonneg_right _ (by positivity)
                exact mul_le_mul_of_nonneg_right h2d (by positivity)
            _ = (2 ^ d * (p:ℝ) ^ d * δ) ^ 2 := by ring
        exact abs_le_of_sq_le_sq hsq (by positivity)
      
      have h5 := zmod_smoothing_error p d N r hpN hr1 Ω hΩc
      rw [← hG_def] at h5
      have herr : |∑ x, (G x - zmodBoxSmooth r G x) * Φ x|
          ≤ 4 * (d:ℝ) * (2 * (N:ℝ) + 1) ^ d * δ := by
        calc |∑ x, (G x - zmodBoxSmooth r G x) * Φ x|
            ≤ ∑ x, |(G x - zmodBoxSmooth r G x) * Φ x| := Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ x, 2 * |G x - zmodBoxSmooth r G x| := by
              refine Finset.sum_le_sum (fun x _ => ?_)
              rw [abs_mul, mul_comm 2]
              exact mul_le_mul_of_nonneg_left (hΦb x) (abs_nonneg _)
          _ = 2 * ∑ x, |G x - zmodBoxSmooth r G x| := by rw [Finset.mul_sum]
          _ ≤ 2 * (2 * (d:ℝ) * ((r:ℝ) - 1) * (2 * (N:ℝ) + 1) ^ (d - 1)) := by linarith [h5]
          _ = (4 * (d:ℝ)) * (((r:ℝ) - 1) * (2 * (N:ℝ) + 1) ^ (d - 1)) := by ring
          _ ≤ (4 * (d:ℝ)) * ((2 * (N:ℝ) + 1) ^ d * δ) :=
              mul_le_mul_of_nonneg_left hr3 (by positivity)
          _ = 4 * (d:ℝ) * (2 * (N:ℝ) + 1) ^ d * δ := by ring
      have hsplit : ∑ x, G x * Φ x = ∑ x, (G x - zmodBoxSmooth r G x) * Φ x
          + ∑ x, zmodBoxSmooth r G x * Φ x := by
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun x _ => by ring)
      rw [hsplit]
      have hE0 : (0:ℝ) ≤ (8 * (d : ℝ) + 16) ^ d := by positivity
      calc |∑ x, (G x - zmodBoxSmooth r G x) * Φ x + ∑ x, zmodBoxSmooth r G x * Φ x|
          ≤ |∑ x, (G x - zmodBoxSmooth r G x) * Φ x| + |∑ x, zmodBoxSmooth r G x * Φ x| :=
            abs_add_le _ _
        _ ≤ 4 * (d:ℝ) * (2 * (N:ℝ) + 1) ^ d * δ + 2 ^ d * (p:ℝ) ^ d * δ := add_le_add herr hmain
        _ ≤ 4 * (d:ℝ) * (2 ^ d * ((N:ℝ) + 1) ^ d) * δ
              + 2 ^ d * ((8 * (d : ℝ) + 16) ^ d * L ^ d * ((N : ℝ) + 1) ^ d) * δ := by
            apply add_le_add
            · apply mul_le_mul_of_nonneg_right _ hδ
              exact mul_le_mul_of_nonneg_left h2N (by positivity)
            · apply mul_le_mul_of_nonneg_right _ hδ
              exact mul_le_mul_of_nonneg_left hpd (by positivity)
        _ = 2 ^ d * ((N:ℝ) + 1) ^ d * δ * (4 * (d:ℝ) + (8 * (d : ℝ) + 16) ^ d * L ^ d) := by
            ring
        _ ≤ 2 ^ d * ((N:ℝ) + 1) ^ d * δ * ((4 * (d:ℝ) + 2 + (8 * (d : ℝ) + 16) ^ d) * L ^ d) := by
            apply mul_le_mul_of_nonneg_left _ (by positivity)
            nlinarith [mul_nonneg hd0 (sub_nonneg.2 hLd1)]
        _ = C₂ * L ^ d * ((N : ℝ) + 1) ^ d * δ := by rw [hC₂_def]; ring
  
  rw [htel]
  calc |∑ j, kaiFormSum (Hj j) c₀ c Ω N| ≤ ∑ j, |kaiFormSum (Hj j) c₀ c Ω N| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j : Fin 4, T ^ 4 * (C₂ * L ^ d * ((N : ℝ) + 1) ^ d * δ) :=
        Finset.sum_le_sum (fun j _ => hclaim j)
    _ = (4 * C₂ * L ^ d) * (T ^ 4 * ((N : ℝ) + 1) ^ d * δ) := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        push_cast; ring
    _ ≤ ((4 * C₂ + ((2 * Module.finrank ℚ K).factorial : ℝ))
          * L ^ (d + 2 * Module.finrank ℚ K)) * (T ^ 4 * ((N : ℝ) + 1) ^ d * δ) := by
        apply mul_le_mul_of_nonneg_right _ (by positivity)
        calc 4 * C₂ * L ^ d ≤ 4 * C₂ * L ^ (d + 2 * Module.finrank ℚ K) :=
              mul_le_mul_of_nonneg_left hLK (by positivity)
          _ ≤ (4 * C₂ + ((2 * Module.finrank ℚ K).factorial : ℝ))
                * L ^ (d + 2 * Module.finrank ℚ K) :=
              mul_le_mul_of_nonneg_right (by linarith) hLK0
    _ = (4 * C₂ + ((2 * Module.finrank ℚ K).factorial : ℝ)) * T ^ 4
          * L ^ (d + 2 * Module.finrank ℚ K) * ((N : ℝ) + 1) ^ d * δ := by ring

theorem kai_sieve_bonferroni_bound (K : Type u) [Field K] [NumberField K] (d : ℕ) (hd : 1 ≤ d) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ (c₀ : Fin 4 → NumberField.RingOfIntegers K)
        (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) (m r N : ℕ) (Ω : Set (Fin d → ℝ)),
        1 ≤ N → MeasurableSet Ω → Convex ℝ Ω → Ω ⊆ realBox d (N : ℝ) →
        |coprimeCount (primorial m) c₀ c Ω N
            - (MeasureTheory.volume Ω).toReal * localDensity (primorial m) c₀ c|
          ≤ (∑ S ∈ ((Finset.range (m + 1)).filter Nat.Prime).powerset.filter
                (fun S => S.card ≤ r + 1),
              C * ((∏ p ∈ S, p : ℕ) : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1))
            + 2 * (MeasureTheory.volume Ω).toReal *
              ∑ S ∈ ((Finset.range (m + 1)).filter Nat.Prime).powerset.filter
                (fun S => S.card = r + 1),
                (kaiBadResidueCount S c₀ c : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) ^ d :=
by
  classical
  obtain ⟨C, hC0, hcnt⟩ := convex_lattice_count d hd
  
  have hs1 : ∀ (p : ℕ) (e₀ : NumberField.RingOfIntegers K)
      (e : Fin d → NumberField.RingOfIntegers K) (z z' : Fin d → ℤ),
      (∀ k, (p : ℤ) ∣ z k - z' k) →
      (CoprimeToNat p (affEval e₀ e z) ↔ CoprimeToNat p (affEval e₀ e z')) := by
    intro p e₀ e z z' hz
    have key : ∀ I : Ideal (NumberField.RingOfIntegers K),
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ I →
        affEval e₀ e z - affEval e₀ e z' ∈ I := by
      intro I hI
      have hdiff : affEval e₀ e z - affEval e₀ e z' = ∑ k, (z k - z' k) • e k := by
        unfold affEval
        rw [add_sub_add_left_eq_sub, ← Finset.sum_sub_distrib]
        simp [sub_smul]
      rw [hdiff]
      refine Ideal.sum_mem _ (fun k _ => ?_)
      obtain ⟨t, ht⟩ := hz k
      rw [ht, zsmul_eq_mul]
      push_cast
      rw [mul_assoc]
      exact Ideal.mul_mem_right _ _ hI
    unfold CoprimeToNat
    constructor
    · intro h q hq hx'
      apply h q hq
      have := Ideal.add_mem _ hx' (key _ hq)
      simpa using this
    · intro h q hq hx
      apply h q hq
      have := Ideal.sub_mem _ hx (key _ hq)
      simpa using this
  
  have hcount : ∀ (q : ℕ), 1 ≤ q → ∀ (P : (Fin d → ℤ) → Prop) [DecidablePred P],
      (∀ z z' : Fin d → ℤ, (∀ k, (q : ℤ) ∣ z k - z' k) → (P z ↔ P z')) →
      ∀ (N : ℕ) (Ω : Set (Fin d → ℝ)) (Z : Finset (Fin d → ℤ)),
        MeasurableSet Ω → Convex ℝ Ω → Ω ⊆ realBox d (N : ℝ) →
        (∀ z, z ∈ Z ↔ z ∈ intBox d N ∧ (fun k => ((z k : ℤ) : ℝ)) ∈ Ω) →
        |((Z.filter P).card : ℝ)
            - (MeasureTheory.volume Ω).toReal * (((resBox d q).filter P).card : ℝ) / (q : ℝ) ^ d|
          ≤ C * (q : ℝ) ^ d * ((N : ℝ) + 2) ^ (d - 1) := by
    intro q hq P _ hP N Ω Z hΩm hΩc hΩ hZ
    have hw : (0 : ℤ) < (q : ℤ) := by exact_mod_cast hq
    have hWpos : (0 : ℝ) < q := by exact_mod_cast hq
    have hW1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
    have hWd : (0 : ℝ) < (q : ℝ) ^ d := pow_pos hWpos d
    have memInt : ∀ (M : ℕ) (z : Fin d → ℤ),
        z ∈ intBox d M ↔ ∀ k, -(M : ℤ) ≤ z k ∧ z k ≤ (M : ℤ) := by
      intro M z
      simp only [intBox, Finset.mem_Icc, Pi.le_def]
      exact ⟨fun h k => ⟨h.1 k, h.2 k⟩, fun h => ⟨fun k => (h k).1, fun k => (h k).2⟩⟩
    have memRes : ∀ z : Fin d → ℤ, z ∈ resBox d q ↔ ∀ k, 0 ≤ z k ∧ z k ≤ (q : ℤ) - 1 := by
      intro z
      simp only [resBox, Finset.mem_Icc, Pi.le_def]
      exact ⟨fun h k => ⟨h.1 k, h.2 k⟩, fun h => ⟨fun k => (h k).1, fun k => (h k).2⟩⟩
    have dvdMod : ∀ x : ℤ, (q : ℤ) ∣ x - x % (q : ℤ) := by
      intro x
      exact ⟨x / q, by rw [Int.emod_def]; ring⟩
    
    have hsplit : ((Z.filter P).card : ℝ) = ∑ a ∈ (resBox d q).filter P,
        (kaiLatticeCount d (N + 1)
          {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ Ω} : ℝ) := by
      have hmaps : ∀ z ∈ Z.filter P, (fun k => z k % (q : ℤ)) ∈ (resBox d q).filter P := by
        intro z hz
        rw [Finset.mem_filter] at hz
        rw [Finset.mem_filter, memRes]
        refine ⟨fun k => ⟨Int.emod_nonneg _ hw.ne', ?_⟩, (hP z _ (fun k => dvdMod (z k))).1 hz.2⟩
        have := Int.emod_lt_of_pos (z k) hw
        omega
      rw [Finset.card_eq_sum_card_fiberwise hmaps]
      push_cast
      refine Finset.sum_congr rfl (fun a ha => ?_)
      rw [Finset.mem_filter, memRes] at ha
      obtain ⟨haBox, haG⟩ := ha
      congr 1
      unfold kaiLatticeCount
      refine Finset.card_nbij' (fun z k => z k / (q : ℤ)) (fun y k => a k + (q : ℤ) * y k)
        ?_ ?_ ?_ ?_
      · 
        intro z hz
        simp only [Finset.mem_coe, Finset.mem_filter] at hz ⊢
        obtain ⟨⟨hzZ, _⟩, hr⟩ := hz
        obtain ⟨hzN, hzP⟩ := (hZ z).1 hzZ
        have hz' : ∀ k, a k + (q : ℤ) * (z k / (q : ℤ)) = z k := by
          intro k
          have := congrFun hr k
          simp only at this
          rw [← this]
          exact Int.emod_add_mul_ediv _ _
        rw [memInt] at hzN
        refine ⟨?_, ?_⟩
        · rw [memInt]
          intro k
          have e := hz' k
          obtain ⟨b1, b2⟩ := hzN k
          obtain ⟨a1, a2⟩ := haBox k
          push_cast
          constructor
          · by_contra hlt
            push_neg at hlt
            have h1 : 0 ≤ (q : ℤ) * (-((N : ℤ) + 2) - z k / (q : ℤ)) :=
              mul_nonneg hw.le (by omega)
            have h2 : 0 ≤ ((q : ℤ) - 1) * ((N : ℤ) + 1) := mul_nonneg (by omega) (by omega)
            nlinarith
          · by_contra hlt
            push_neg at hlt
            have h1 : 0 ≤ ((q : ℤ) - 1) * (z k / (q : ℤ)) := mul_nonneg (by omega) (by omega)
            nlinarith
        · show (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * (((z k / (q : ℤ) : ℤ)) : ℝ)) ∈ Ω
          have hfun : (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * (((z k / (q : ℤ) : ℤ)) : ℝ))
              = fun k => ((z k : ℤ) : ℝ) := by
            funext k
            have e := hz' k
            exact_mod_cast e
          rw [hfun]
          exact hzP
      · 
        intro y hy
        simp only [Finset.mem_coe, Finset.mem_filter, Set.mem_setOf_eq] at hy ⊢
        obtain ⟨_, hyΩ⟩ := hy
        have hfun : (fun k => (((a k + (q : ℤ) * y k : ℤ)) : ℝ))
            = fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * ((y k : ℤ) : ℝ) := by
          funext k
          push_cast
          ring
        have hres : (fun k => (a k + (q : ℤ) * y k) % (q : ℤ)) = a := by
          funext k
          rw [Int.add_mul_emod_self_left]
          exact Int.emod_eq_of_lt (haBox k).1 (by linarith [(haBox k).2])
        have hPΩ : (fun k => (((a k + (q : ℤ) * y k : ℤ)) : ℝ)) ∈ Ω := by
          rw [hfun]; exact hyΩ
        refine ⟨⟨(hZ _).2 ⟨?_, hPΩ⟩, ?_⟩, hres⟩
        · rw [memInt]
          intro k
          have hb := hΩ hPΩ k
          have hb' : |a k + (q : ℤ) * y k| ≤ (N : ℤ) := by
            have : ((|a k + (q : ℤ) * y k| : ℤ) : ℝ) ≤ ((N : ℤ) : ℝ) := by
              push_cast
              simpa using hb
            exact_mod_cast this
          exact abs_le.mp hb'
        · exact (hP (fun k => a k + (q : ℤ) * y k) a (fun k => ⟨y k, by ring⟩)).2 haG
      · 
        intro z hz
        simp only [Finset.mem_coe, Finset.mem_filter] at hz
        obtain ⟨_, hr⟩ := hz
        funext k
        have := congrFun hr k
        simp only at this
        show a k + (q : ℤ) * (z k / (q : ℤ)) = z k
        rw [← this]
        exact Int.emod_add_mul_ediv _ _
      · 
        intro y _
        funext k
        simp only
        rw [Int.add_mul_ediv_left _ _ hw.ne', Int.ediv_eq_zero_of_lt (haBox k).1
          (by linarith [(haBox k).2]), zero_add]
    
    have hvol : ∀ a : Fin d → ℤ,
        (MeasureTheory.volume
            {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ Ω}).toReal
          = (MeasureTheory.volume Ω).toReal / (q : ℝ) ^ d := by
      intro a
      have hset : {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ Ω}
          = (fun x : Fin d → ℝ => (q : ℝ) • x) ⁻¹'
              ((fun v : Fin d → ℝ => (fun k => ((a k : ℤ) : ℝ)) + v) ⁻¹' Ω) := by
        ext x
        simp only [Set.mem_setOf_eq, Set.mem_preimage]
        rfl
      rw [hset, MeasureTheory.Measure.addHaar_preimage_smul MeasureTheory.volume
        (ne_of_gt hWpos), MeasureTheory.measure_preimage_add]
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (abs_nonneg _), Module.finrank_fin_fun,
        abs_of_pos (inv_pos.2 hWd), div_eq_inv_mul]
    
    have hgeom : ∀ a : Fin d → ℤ, (∀ k, 0 ≤ a k ∧ a k ≤ (q : ℤ) - 1) →
        MeasurableSet {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ Ω} ∧
        Convex ℝ {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ Ω} ∧
        {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ Ω}
          ⊆ realBox d ((N + 1 : ℕ) : ℝ) := by
      intro a ha
      refine ⟨?_, ?_, ?_⟩
      · have hmeas : Measurable
            (fun x : Fin d → ℝ => fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) := by
          fun_prop
        exact hmeas hΩm
      · intro x hx y hy s t hs ht hst
        have h := hΩc hx hy hs ht hst
        show (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * (s • x + t • y) k) ∈ Ω
        convert h using 1
        funext k
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        linear_combination (-((a k : ℤ) : ℝ)) * hst
      · intro x hx k
        have hb := hΩ hx k
        rw [abs_le] at hb
        obtain ⟨ha0, ha1⟩ := ha k
        have ha0' : (0 : ℝ) ≤ ((a k : ℤ) : ℝ) := by exact_mod_cast ha0
        have ha1' : ((a k : ℤ) : ℝ) ≤ (q : ℝ) - 1 := by
          have : ((a k : ℤ) : ℝ) ≤ (((q : ℤ) - 1 : ℤ) : ℝ) := by exact_mod_cast ha1
          simpa using this
        have hN0 : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
        obtain ⟨hb1, hb2⟩ := hb
        rw [abs_le]
        push_cast
        constructor
        · by_contra hlt
          push_neg at hlt
          nlinarith [mul_nonneg (sub_nonneg.2 hW1) hN0]
        · by_contra hlt
          push_neg at hlt
          nlinarith [mul_nonneg (sub_nonneg.2 hW1) (show (0:ℝ) ≤ x k by linarith)]
    
    rw [hsplit]
    set Good := (resBox d q).filter P with hGood
    set V := (MeasureTheory.volume Ω).toReal with hV
    have hsplit2 : V * (Good.card : ℝ) / (q : ℝ) ^ d = ∑ a ∈ Good, V / (q : ℝ) ^ d := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ring
    have hres : (resBox d q).card = q ^ d := by
      simp [resBox, Pi.card_Icc, Int.card_Icc]
    have hcard : (Good.card : ℝ) ≤ (q : ℝ) ^ d := by
      have h1 : Good.card ≤ (resBox d q).card := Finset.card_filter_le _ _
      rw [hres] at h1
      exact_mod_cast h1
    have hNN : ((N + 1 : ℕ) : ℝ) + 1 = (N : ℝ) + 2 := by push_cast; ring
    have hper : ∀ a ∈ Good,
        |(kaiLatticeCount d (N + 1)
            {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ Ω} : ℝ)
            - V / (q : ℝ) ^ d| ≤ C * ((N : ℝ) + 2) ^ (d - 1) := by
      intro a ha
      have ha' : a ∈ resBox d q := (Finset.mem_filter.1 ha).1
      have hak : ∀ k, 0 ≤ a k ∧ a k ≤ (q : ℤ) - 1 := (memRes a).1 ha'
      obtain ⟨hm, hc, hb⟩ := hgeom a hak
      have h := hcnt (N + 1) _ hm hc hb
      rw [hvol a, hNN] at h
      exact h
