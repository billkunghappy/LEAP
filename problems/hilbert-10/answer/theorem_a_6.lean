        exact congrArg Subtype.val
          ((t m).equivFin.injective (Fin.castLE_injective (htcard m) hab))
      choose e he using key
      refine ⟨fun a => e (rchar a) a, ?_⟩
      intro a b hSa hSb hr hc
      have hc' : e (rchar a) a = e (rchar b) b := hc
      rw [← hr] at hc'
      exact he (rchar a) a b (htmem (rchar a) a hSa rfl) (htmem (rchar a) b hSb hr.symm) hc'
    refine ⟨col, rchar, rdeg, ?_, ?_⟩
    · intro P hP hP0
      exact ⟨(hrc P hP hP0).1, (hrc P hP hP0).2.1, (hrc P hP hP0).2.2.1⟩
    · intro P Q hP hP0 hQ hQ0 hr hc
      exact hcol P Q ⟨hP, hP0⟩ ⟨hQ, hQ0⟩ hr hc
  obtain ⟨col, rchar, rdeg, hcol1, hcol2⟩ := hcolour
  have hrep : ∀ I : Ideal (NumberField.RingOfIntegers K), kaiZFVonMangoldt K I ≠ 0 →
      ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
        P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ I = P ^ k ∧
        kaiZFVonMangoldt K I = Real.log (Ideal.absNorm P) := by
    intro I hI
    unfold kaiZFVonMangoldt at hI ⊢
    split_ifs at hI ⊢ with h
    · obtain ⟨k, hP, hP0, hk, hIk⟩ := h.choose_spec
      exact ⟨h.choose, k, hP, hP0, hk, hIk, rfl⟩
    · exact absurd rfl hI
  choose! Pf kf hPf using hrep
  have hq2 : ∀ I, kaiZFVonMangoldt K I ≠ 0 → 2 ≤ Ideal.absNorm (Pf I) := by
    intro I hI
    obtain ⟨hP, hP0, -, -, -⟩ := hPf I hI
    obtain ⟨hpr, hdeg, hNP⟩ := hcol1 (Pf I) hP hP0
    rw [hNP]
    exact le_trans hpr.two_le (Nat.le_self_pow (by omega) _)
  have hNpow : ∀ I, kaiZFVonMangoldt K I ≠ 0 →
      Ideal.absNorm I = Ideal.absNorm (Pf I) ^ kf I := by
    intro I hI
    obtain ⟨-, -, -, hIk, -⟩ := hPf I hI
    exact (congrArg Ideal.absNorm hIk).trans (map_pow _ _ _)
  have hx0 : (0 : ℝ) ≤ x := by linarith
  have hLnn : (0 : ℝ) ≤ Real.log x := Real.log_nonneg hx
  have hfinB : {I : Ideal (NumberField.RingOfIntegers K) |
      I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x ∧ ¬ ((Ideal.absNorm I : ℝ) ≤ y)}.Finite := by
    refine Set.Finite.subset (Ideal.finite_setOf_absNorm_le ⌊x⌋₊) ?_
    rintro I ⟨-, h, -⟩
    exact Nat.le_floor h
  haveI : Fintype {I : Ideal (NumberField.RingOfIntegers K) //
      I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x ∧ ¬ ((Ideal.absNorm I : ℝ) ≤ y)} := hfinB.fintype
  have hconv : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
        I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x ∧ ¬ ((Ideal.absNorm I : ℝ) ≤ y)},
        kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)))
      = ∑ I ∈ hfinB.toFinset, kaiZFVonMangoldt K I := by
    rw [tsum_fintype]
    exact (Finset.sum_subtype _ (fun I => hfinB.mem_toFinset) _).symm
  rw [hconv]
  obtain ⟨B, hBsum, hBmem⟩ :
      ∃ B : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∑ I ∈ B, kaiZFVonMangoldt K I = ∑ I ∈ hfinB.toFinset, kaiZFVonMangoldt K I) ∧
        (∀ I ∈ B, kaiZFVonMangoldt K I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x ∧
          ¬ ((Ideal.absNorm I : ℝ) ≤ y)) := by
    refine ⟨hfinB.toFinset.filter (fun I => kaiZFVonMangoldt K I ≠ 0), ?_, ?_⟩
    · refine Finset.sum_subset (Finset.filter_subset _ _) ?_
      intro I hI2 hI'
      simp only [Finset.mem_filter, not_and, not_not] at hI'
      exact hI' hI2
    · intro I hI
      simp only [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq] at hI
      obtain ⟨⟨_, hb, hc⟩, hd⟩ := hI
      exact ⟨hd, hb, hc⟩
  rw [← hBsum]
  have hwt : ∀ I ∈ B, kaiZFVonMangoldt K I ≤ Real.log x := by
    intro I hI
    obtain ⟨hI0, hIx, -⟩ := hBmem I hI
    obtain ⟨-, -, hk, -, hLI⟩ := hPf I hI0
    have h2q := hq2 I hI0
    have hNI := hNpow I hI0
    have hqle : Ideal.absNorm (Pf I) ≤ Ideal.absNorm I := by
      rw [hNI]
      exact Nat.le_self_pow (by omega) _
    have hqpos : (0 : ℝ) < (Ideal.absNorm (Pf I) : ℝ) := by
      have h : (2 : ℝ) ≤ (Ideal.absNorm (Pf I) : ℝ) := by exact_mod_cast h2q
      linarith
    have hqleR : (Ideal.absNorm (Pf I) : ℝ) ≤ (Ideal.absNorm I : ℝ) := by
      exact_mod_cast hqle
    rw [hLI]
    calc Real.log (Ideal.absNorm (Pf I)) ≤ Real.log (Ideal.absNorm I) :=
          Real.log_le_log hqpos hqleR
      _ ≤ Real.log x := Real.log_le_log (by linarith) hIx
  have hminFac : ∀ I ∈ B, rchar (Pf I) = (Ideal.absNorm I).minFac := by
    intro I hI
    obtain ⟨hI0, -, -⟩ := hBmem I hI
    obtain ⟨hP, hP0, hk, -, -⟩ := hPf I hI0
    obtain ⟨hpr, hdeg, hNP⟩ := hcol1 (Pf I) hP hP0
    have hNI := hNpow I hI0
    have hm : Ideal.absNorm I = rchar (Pf I) ^ (rdeg (Pf I) * kf I) := by
      rw [hNI, hNP, pow_mul]
    have hfk : rdeg (Pf I) * kf I ≠ 0 := Nat.mul_ne_zero (by omega) (by omega)
    rw [hm, Nat.Prime.pow_minFac hpr hfk]
  have hinj : Set.InjOn (fun I => (col (Pf I), Ideal.absNorm I))
      (↑B : Set (Ideal (NumberField.RingOfIntegers K))) := by
    intro I hI J hJ hIJ
    simp only [Finset.mem_coe] at hI hJ
    simp only [Prod.mk.injEq] at hIJ
    obtain ⟨h1, h2⟩ := hIJ
    obtain ⟨hI0, -, -⟩ := hBmem I hI
    obtain ⟨hJ0, -, -⟩ := hBmem J hJ
    obtain ⟨hPI, hPI0, -, hIeq, -⟩ := hPf I hI0
    obtain ⟨hPJ, hPJ0, -, hJeq, -⟩ := hPf J hJ0
    have hr : rchar (Pf I) = rchar (Pf J) := by
      rw [hminFac I hI, hminFac J hJ, h2]
    have hPeq : Pf I = Pf J := hcol2 (Pf I) (Pf J) hPI hPI0 hPJ hPJ0 hr h1
    have hNI := hNpow I hI0
    have hNJ := hNpow J hJ0
    have hpow : Ideal.absNorm (Pf J) ^ kf I = Ideal.absNorm (Pf J) ^ kf J := by
      calc Ideal.absNorm (Pf J) ^ kf I = Ideal.absNorm (Pf I) ^ kf I := by rw [hPeq]
        _ = Ideal.absNorm I := hNI.symm
        _ = Ideal.absNorm J := h2
        _ = Ideal.absNorm (Pf J) ^ kf J := hNJ
    have hkeq : kf I = kf J := Nat.pow_right_injective (hq2 J hJ0) hpow
    calc I = Pf I ^ kf I := hIeq
      _ = Pf J ^ kf J := by rw [hPeq, hkeq]
      _ = J := hJeq.symm
  have hmaps : Set.MapsTo (fun I => (col (Pf I), Ideal.absNorm I))
      (↑B : Set (Ideal (NumberField.RingOfIntegers K)))
      (↑((Finset.univ : Finset (Fin (Module.finrank ℚ K))) ×ˢ
          Finset.Ioc ⌊y⌋₊ ⌊x⌋₊) : Set (Fin (Module.finrank ℚ K) × ℕ)) := by
    intro I hI
    simp only [Finset.mem_coe] at hI ⊢
    obtain ⟨-, hIx, hIy⟩ := hBmem I hI
    refine Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_Ioc.mpr ⟨?_, ?_⟩⟩
    · have hylt : y < (Ideal.absNorm I : ℝ) := not_le.mp hIy
      have hfl : ((⌊y⌋₊ : ℕ) : ℝ) ≤ y := Nat.floor_le hy
      have hlt : ((⌊y⌋₊ : ℕ) : ℝ) < ((Ideal.absNorm I : ℕ) : ℝ) := by linarith
      exact_mod_cast hlt
    · exact Nat.le_floor hIx
  have hfm : ⌊y⌋₊ ≤ ⌊x⌋₊ := Nat.floor_mono hyx
  have hcard : B.card ≤ Module.finrank ℚ K * (⌊x⌋₊ - ⌊y⌋₊) := by
    have h := Finset.card_le_card_of_injOn
      (fun I => (col (Pf I), Ideal.absNorm I)) hmaps hinj
    calc B.card ≤ _ := h
      _ = Module.finrank ℚ K * (⌊x⌋₊ - ⌊y⌋₊) := by
          rw [Finset.card_product, Finset.card_fin, Nat.card_Ioc]
  have hn0 : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.cast_nonneg _
  have hcardR : (B.card : ℝ) ≤ (Module.finrank ℚ K : ℝ) * (x - y + 1) := by
    have h : ((B.card : ℕ) : ℝ) ≤ ((Module.finrank ℚ K * (⌊x⌋₊ - ⌊y⌋₊) : ℕ) : ℝ) :=
      Nat.cast_le.mpr hcard
    rw [Nat.cast_mul, Nat.cast_sub hfm] at h
    have h2 : ((⌊x⌋₊ : ℕ) : ℝ) ≤ x := Nat.floor_le hx0
    have h3 : y < ((⌊y⌋₊ : ℕ) : ℝ) + 1 := Nat.lt_floor_add_one y
    have h4 : ((⌊x⌋₊ : ℕ) : ℝ) - ((⌊y⌋₊ : ℕ) : ℝ) ≤ x - y + 1 := by linarith
    have h5 := mul_le_mul_of_nonneg_left h4 hn0
