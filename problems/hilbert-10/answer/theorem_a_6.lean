        KaiHeckeExt K q 0 0 ξ η mu →
        ∀ (E : ℕ) (f : ℂ → ℂ), E ≤ 1 → (E = 1 ↔ KaiHeckePrincipal K q mu) →
          Differentiable ℂ f →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K mu s * (s - 1) ^ E = f s) →
          ∀ (τ x : ℝ) (z : ℂ), c ≤ x → x ≤ 1 / 4 →
            z.re = 1 + x / Real.log (3 + (Ideal.absNorm q : ℝ) * 2 * (2 + |τ|)) →
            |z.im| ≤ 2 * |τ| →
            ∃ (Z : Finset ℂ) (mlt : ℂ → ℕ),
              (∀ ρ ∈ Z, ρ ∈ Metric.closedBall z (1 / 2) ∧ f ρ = 0 ∧ 1 ≤ mlt ρ) ∧
