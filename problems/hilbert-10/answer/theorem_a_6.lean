def KaiQuadMajor (ν N q : ℕ) (T : ℝ) (P : (Fin ν → ℤ) → ℝ) : Prop :=
  1 ≤ q ∧ ∃ (γ : ℝ) (b : Fin ν → ℤ) (a : Fin ν → Fin ν → ℤ) (η : Fin ν → ℝ)
      (θ : Fin ν → Fin ν → ℝ),
    (∀ l, |η l| ≤ T / ((q : ℝ) * (N : ℝ))) ∧
    (∀ l l', |θ l l'| ≤ T / ((q : ℝ) * (N : ℝ) ^ 2)) ∧
    ∀ z : Fin ν → ℤ, P z = γ
      + (∑ l, (b l : ℝ) * (z l : ℝ) + ∑ l, ∑ l', (a l l' : ℝ) * (z l : ℝ) * (z l' : ℝ)) / (q : ℝ)
      + ∑ l, η l * (z l : ℝ) + ∑ l, ∑ l', θ l l' * (z l : ℝ) * (z l' : ℝ)
def Nil2VertData {a b : ℕ} (D Q : ℝ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) : Prop :=
  ((a + b : ℕ) : ℝ) ≤ D ∧ (∀ i j k, |(Bc i j k : ℝ)| ≤ Q) ∧ (∀ k, |(ξ k : ℝ)| ≤ Q) ∧ ξ ≠ 0 ∧
  (∀ u, ‖F u‖ ≤ Q) ∧
  (∀ u (γ₁ : Fin a → ℤ) (γ₂ : Fin b → ℤ),
      F (nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))) = F u) ∧
  (∀ u (t : Fin b → ℝ), F (u.1, fun k => u.2 k + t k)
      = Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ξ k : ℝ) * t k : ℝ) : ℂ)) * F u) ∧
  (∀ u v : (Fin a → ℝ) × (Fin b → ℝ),
      (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ k, -1 ≤ u.2 k ∧ u.2 k ≤ 2) →
      (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, -1 ≤ v.2 k ∧ v.2 k ≤ 2) →
      ‖F u - F v‖ ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|))


def nil2Eval {ν a b : ℕ} (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ) (r₀ : Fin b → ℝ)
