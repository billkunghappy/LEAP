  refine hmaster s₀ hs₀2 (by rw [hLf]; exact hs₀B) hGs₀ ?_
  obtain ⟨Z2, mlt2, h2a, h2b, h2c, h2d⟩ :=
    hLandau (fun I => lam I * lam I) 0 G₂ (Lf s₀.im) c
