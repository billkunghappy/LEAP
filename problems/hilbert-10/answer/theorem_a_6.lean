    intro p
    obtain ⟨h1, h2, h3, -⟩ := hρσ p
    exact ⟨h1, h2, h3⟩
  have hρσ6 : ∀ p, 0 ≤ ρ p ∧ ρ p < σ p ∧ σ p ≤ X ∧
