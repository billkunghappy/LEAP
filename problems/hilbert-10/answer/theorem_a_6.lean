      simp only [q, Finset.sum_add_distrib]
      congr 1
      simp only [Finset.mul_sum]
      symm
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.sum_comm]
    have P3 : ∑ i, ∑ j, β i j * θ i * (p₀ j + ∑ l, (w l : ℝ) * p₁ l j)
        = ∑ i, ∑ j, β i j * θ i * p₀ j + ∑ l, (w l : ℝ) * ∑ i, ∑ j, β i j * θ i * p₁ l j := by
      simp only [mul_add, Finset.mul_sum, Finset.sum_add_distrib]
      congr 1
      symm
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l _ => by ring))
    have P4 : ∀ l, ∑ l', (∑ t, (ξ t : ℝ) * (r₂ l l' t + r₂ l' l t)) * (h l' : ℝ)
          - ∑ i, ∑ j, p₁ l i * β i j * (g j : ℝ) - ∑ i, ∑ j, β i j * θ i * p₁ l j
        = ∑ l', (∑ t, (ξ t : ℝ) * (r₂ l l' t + r₂ l' l t)
            - ∑ i, ∑ j, p₁ l i * β i j * p₁ l' j) * (h l' : ℝ)
          + ∑ i, ∑ j, p₁ l i * (β i j - β j i) * θ j := by
      intro l
      have a1 : ∑ i, ∑ j, p₁ l i * β i j * (g j : ℝ)
          = ∑ l', (∑ i, ∑ j, p₁ l i * β i j * p₁ l' j) * (h l' : ℝ)
            - ∑ i, ∑ j, p₁ l i * β i j * θ j := by
        simp only [hG, mul_sub, Finset.sum_sub_distrib]
        congr 1
        simp only [Finset.mul_sum, Finset.sum_mul]
        symm
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l' _ => by ring))
      have a2 : ∑ i, ∑ j, β i j * θ i * p₁ l j = ∑ i, ∑ j, β j i * θ j * p₁ l i :=
        Finset.sum_comm
      have a3 : ∑ l', (∑ t, (ξ t : ℝ) * (r₂ l l' t + r₂ l' l t)
            - ∑ i, ∑ j, p₁ l i * β i j * p₁ l' j) * (h l' : ℝ)
          = ∑ l', (∑ t, (ξ t : ℝ) * (r₂ l l' t + r₂ l' l t)) * (h l' : ℝ)
            - ∑ l', (∑ i, ∑ j, p₁ l i * β i j * p₁ l' j) * (h l' : ℝ) := by
        rw [← Finset.sum_sub_distrib]; exact Finset.sum_congr rfl (fun l' _ => by ring)
      have a4 : ∑ i, ∑ j, p₁ l i * (β i j - β j i) * θ j
          = ∑ i, ∑ j, p₁ l i * β i j * θ j - ∑ i, ∑ j, β j i * θ j * p₁ l i := by
        rw [← Finset.sum_sub_distrib]; refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← Finset.sum_sub_distrib]; exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [a1, a2, a3, a4]; ring
    have hsumL : ∑ l, (w l : ℝ) * (∑ l', (∑ t, (ξ t : ℝ) * (r₂ l l' t + r₂ l' l t)
                  - ∑ i, ∑ j, p₁ l i * β i j * p₁ l' j) * (h l' : ℝ)
                + ∑ i, ∑ j, p₁ l i * (β i j - β j i) * θ j)
        = ∑ l, (w l : ℝ) * ∑ l', (∑ t, (ξ t : ℝ) * (r₂ l l' t + r₂ l' l t)) * (h l' : ℝ)
          - ∑ l, (w l : ℝ) * ∑ i, ∑ j, p₁ l i * β i j * (g j : ℝ)
          - ∑ l, (w l : ℝ) * ∑ i, ∑ j, β i j * θ i * p₁ l j := by
      rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun l _ => by rw [← P4 l]; ring)
    linarith [P1, P2, P3, hsumL]
  have alg : ∀ (s0 s1 s2 s3 s4 : ℝ) (P C : ℂ), s0 = s1 + -s2 + -s3 + -s4 →
      giE s1 * (giE (-s2) * P) * (giE (-s3) * C) = giE s0 * (giE s4 * P * C) := by
    intro s0 s1 s2 s3 s4 P C hs
    subst hs
    rw [gadd, gadd, gadd]
    linear_combination (-(giE s1 * giE (-s2) * giE (-s3) * P * C)) * ginv s4
  refine ⟨Ψ, (∑ k, (ξ k : ℝ) * (∑ l, (h l : ℝ) * r₁ l k
        + ∑ l, ∑ l', (h l : ℝ) * (h l' : ℝ) * r₂ l l' k)
        - ∑ i, ∑ j, β i j * (p₀ i + θ i) * (g j : ℝ) - ∑ i, ∑ j, β i j * θ i * p₀ j),
      hper, hbound, fun x y hxy => (hlipΨ x y hxy).trans
        (mul_le_mul_of_nonneg_right hconst (hSum0 x y)), ?_⟩
  intro w
  have e1a : nil2Eval p₀ p₁ r₀ r₁ r₂ F (w + h)
      = F ((fun i => (p₀ i + ∑ l, (w l : ℝ) * p₁ l i + θ i) + (g i : ℝ)),
          fun k => r₀ k + ∑ l, ((w l : ℝ) + (h l : ℝ)) * r₁ l k
            + ∑ l, ∑ l', ((w l : ℝ) + (h l : ℝ)) * ((w l' : ℝ) + (h l' : ℝ)) * r₂ l l' k) := by
    unfold nil2Eval
    congr 2
    · funext i
      simp only [Pi.add_apply, Int.cast_add, add_mul, Finset.sum_add_distrib, hdec i]; ring
    · funext k
      simp only [Pi.add_apply, Int.cast_add]
  have e2 : nil2Eval p₀ p₁ r₀ r₁ r₂ F w
      = giE (∑ k, (ξ k : ℝ) * (r₀ k + ∑ l, (w l : ℝ) * r₁ l k
          + ∑ l, ∑ l', (w l : ℝ) * (w l' : ℝ) * r₂ l l' k))
        * f (fun i => p₀ i + ∑ l, (w l : ℝ) * p₁ l i) := by
    unfold nil2Eval; rw [nf1]
  rw [e1a, nf1, nf2 (fun i => p₀ i + ∑ l, (w l : ℝ) * p₁ l i + θ i) g, e2, hΨ, map_mul, gconj]
  exact alg _ _ _ _ _ _ _ (phase w)

theorem kai_v_bracket_relation (ν : ℕ) (hν : 1 ≤ ν) (D Q δ : ℝ) (L : ℕ)
    (hD : 1 ≤ D) (hQ : 2 ≤ Q) (hδ : 0 < δ) (hδ1 : δ ≤ 1) (hL : 1 ≤ L)
    (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) (hF : Nil2VertData D Q Bc ξ F)
    (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ) (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ)
    (r₂ : Fin ν → Fin ν → Fin b → ℝ) (z₀ : Fin ν → ℤ)
    (hbig : δ * (L : ℝ) ^ ν ≤ ‖∑ z ∈ Finset.Icc z₀ (z₀ + fun _ => ((L : ℤ) - 1)),
        nil2Eval p₀ p₁ r₀ r₁ r₂ F z‖) :
    ∃ (q : Fin ν → Fin a → ℝ) (S : Fin ν → Fin ν → ℝ) (c : Fin ν → ℝ)
      (E : Finset (Fin ν → ℤ)),
      (∀ l i, |q l i| ≤ 1) ∧ (∀ l i, ∃ n : ℤ, p₁ l i = q l i + n) ∧
      (∀ h ∈ E, ∀ l, |h l| < (L : ℤ)) ∧
      (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) * (2 * (L : ℝ)) ^ ν ≤ (E.card : ℝ) ∧
      ∀ h ∈ E, ∀ l,
        |(c l + ∑ l', S l l' * (h l' : ℝ)
            + ∑ i, ∑ j, q l i * ((∑ t, ξ t * (Bc i j t - Bc j i t) : ℤ) : ℝ) *
                ((∑ l', (h l' : ℝ) * q l' j) - round (∑ l', (h l' : ℝ) * q l' j)))
          - round (c l + ∑ l', S l l' * (h l' : ℝ)
            + ∑ i, ∑ j, q l i * ((∑ t, ξ t * (Bc i j t - Bc j i t) : ℤ) : ℝ) *
                ((∑ l', (h l' : ℝ) * q l' j) - round (∑ l', (h l' : ℝ) * q l' j)))|
          ≤ 1 / ((δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) * (L : ℝ)) :=
by
  classical
  have hQpos : (0 : ℝ) < Q := by linarith
  have hDpos : (0 : ℝ) < D := by linarith
  have hLpos : (0 : ℝ) < (L : ℝ) := by exact_mod_cast hL
  
  obtain ⟨E₀, hE₀box, hE₀card, hE₀big⟩ := kai_vbr_autocorr_large ν L hL δ Q hδ hQpos
    (nil2Eval p₀ p₁ r₀ r₁ r₂ F) (fun z => hF.2.2.2.2.1 _) z₀ hbig
  
  obtain ⟨q, hq⟩ : ∃ q : Fin ν → Fin a → ℝ, q = fun l i => Int.fract (p₁ l i) := ⟨_, rfl⟩
  obtain ⟨n, hn⟩ : ∃ n : Fin ν → Fin a → ℤ, n = fun l i => ⌊p₁ l i⌋ := ⟨_, rfl⟩
  have hpn : ∀ l i, p₁ l i = q l i + (n l i : ℝ) := by
    intro l i; rw [hq, hn]; exact (Int.fract_add_floor _).symm
  
  have hab : ((a + b : ℕ) : ℝ) ≤ D := hF.1
  have haD : (a : ℝ) ≤ D := by
    push_cast at hab; have : (0 : ℝ) ≤ b := Nat.cast_nonneg b; linarith
  
  have h5 : ((a : ℝ) * (4 * D ^ 2 * Q ^ 4) / (δ ^ 2 / 2 ^ (ν + 2))) ^ 2
        ≤ ((⌈(2 ^ (ν + 4) * D ^ 3 * Q ^ 4 / δ ^ 2) ^ 2⌉₊ : ℕ) : ℝ) + 1 ∧
      (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1))
        ≤ δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 *
            ((2 * ⌈(2 ^ (ν + 4) * D ^ 3 * Q ^ 4 / δ ^ 2) ^ 2⌉₊ + 1 : ℕ) : ℝ) ^ a) := by
    clear hbig hE₀card hE₀big hE₀box hab
    obtain ⟨X, hX⟩ : ∃ X : ℝ, X = 2 ^ (ν + 4) * D ^ 3 * Q ^ 4 / δ ^ 2 := ⟨_, rfl⟩
    rw [← hX]
    have hδ2pos : 0 < δ ^ 2 := by positivity
    have hδ2 : δ ^ 2 ≤ 1 := by nlinarith
    have h2pow : (16 : ℝ) ≤ 2 ^ (ν + 4) := by
      calc (16 : ℝ) = 2 ^ 4 := by norm_num
        _ ≤ 2 ^ (ν + 4) := pow_le_pow_right₀ (by norm_num) (by omega)
    have hD3 : 1 ≤ D ^ 3 := one_le_pow₀ hD
    have hQ2 : 4 ≤ Q ^ 2 := by nlinarith
    have hQ4 : 16 ≤ Q ^ 4 := by nlinarith
    have hX1 : 1 ≤ X := by
      rw [hX, le_div_iff₀ hδ2pos]
      have h1 : (16 : ℝ) * 1 ≤ 2 ^ (ν + 4) * D ^ 3 :=
        mul_le_mul h2pow hD3 (by norm_num) (by positivity)
      have h2 : (16 : ℝ) * 1 * 16 ≤ 2 ^ (ν + 4) * D ^ 3 * Q ^ 4 :=
        mul_le_mul h1 hQ4 (by norm_num) (by positivity)
      linarith
    have hXpos : 0 < X := by linarith
    constructor
    · have hbase : (a : ℝ) * (4 * D ^ 2 * Q ^ 4) / (δ ^ 2 / 2 ^ (ν + 2)) ≤ X := by
        have e : (a : ℝ) * (4 * D ^ 2 * Q ^ 4) / (δ ^ 2 / 2 ^ (ν + 2))
            = (a : ℝ) * (2 ^ (ν + 4) * D ^ 2 * Q ^ 4 / δ ^ 2) := by
          rw [show ν + 4 = (ν + 2) + 2 by ring, pow_add]
          field_simp
          ring
        have e2 : X = D * (2 ^ (ν + 4) * D ^ 2 * Q ^ 4 / δ ^ 2) := by rw [hX]; ring
        rw [e, e2]
        exact mul_le_mul_of_nonneg_right haD (by positivity)
      have h0 : 0 ≤ (a : ℝ) * (4 * D ^ 2 * Q ^ 4) / (δ ^ 2 / 2 ^ (ν + 2)) := by positivity
      calc ((a : ℝ) * (4 * D ^ 2 * Q ^ 4) / (δ ^ 2 / 2 ^ (ν + 2))) ^ 2 ≤ X ^ 2 :=
            pow_le_pow_left₀ h0 hbase 2
        _ ≤ (⌈X ^ 2⌉₊ : ℝ) := Nat.le_ceil _
        _ ≤ _ := by linarith
    · obtain ⟨K, hK⟩ : ∃ K : ℕ, K = ⌈X ^ 2⌉₊ := ⟨_, rfl⟩
      rw [← hK]
      have hKlt : (K : ℝ) < X ^ 2 + 1 := by rw [hK]; exact Nat.ceil_lt_add_one (by positivity)
      have hX2 : 1 ≤ X ^ 2 := one_le_pow₀ hX1
      have h2K : ((2 * K + 1 : ℕ) : ℝ) ≤ (4 * X) ^ 2 := by push_cast; nlinarith
      have h2Kpos : (0 : ℝ) < ((2 * K + 1 : ℕ) : ℝ) := by positivity
      have hpowK : ((2 * K + 1 : ℕ) : ℝ) ^ a ≤ ((4 * X) ^ 2) ^ a :=
        pow_le_pow_left₀ h2Kpos.le h2K a
      obtain ⟨x, hx⟩ : ∃ x : ℝ, x = δ / (4 ^ (ν + 4) * D * Q) := ⟨_, rfl⟩
      rw [← hx]
      have h4 : (1 : ℝ) ≤ 4 ^ (ν + 4) := one_le_pow₀ (by norm_num)
      have hxpos : 0 < x := by rw [hx]; positivity
      have hx1 : x ≤ 1 := by
        rw [hx, div_le_one (by positivity)]
        have h1 : (1 : ℝ) * 1 ≤ 4 ^ (ν + 4) * D := mul_le_mul h4 hD (by norm_num) (by positivity)
        have h2 : (1 : ℝ) * 1 * 1 ≤ 4 ^ (ν + 4) * D * Q :=
          mul_le_mul h1 (by linarith) (by norm_num) (by positivity)
        linarith
      have hx2 : x ^ 2 ≤ δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2) := by
        rw [hx, div_pow, div_le_div_iff₀ (by positivity) (by positivity)]
        apply mul_le_mul_of_nonneg_left _ hδ2pos.le
        have h42 : (2 : ℝ) ^ (ν + 2) ≤ 4 ^ (ν + 4) := by
          calc (2 : ℝ) ^ (ν + 2) ≤ 4 ^ (ν + 2) := pow_le_pow_left₀ (by norm_num) (by norm_num) _
            _ ≤ 4 ^ (ν + 4) := pow_le_pow_right₀ (by norm_num) (by omega)
        have hD2 : 1 ≤ D ^ 2 := one_le_pow₀ hD
        have e : (4 ^ (ν + 4) * D * Q) ^ 2 = (4 ^ (ν + 4) * Q ^ 2) * (4 ^ (ν + 4) * D ^ 2) := by
          ring
        rw [e]
        calc 2 ^ (ν + 2) * Q ^ 2 ≤ 4 ^ (ν + 4) * Q ^ 2 :=
              mul_le_mul_of_nonneg_right h42 (by positivity)
          _ = (4 ^ (ν + 4) * Q ^ 2) * 1 := by ring
          _ ≤ (4 ^ (ν + 4) * Q ^ 2) * (4 ^ (ν + 4) * D ^ 2) := by
              apply mul_le_mul_of_nonneg_left _ (by positivity)
              have := mul_le_mul h4 hD2 (by norm_num) (by positivity)
              linarith
      have hx4 : x ^ 4 ≤ 1 / (4 * X) := by
        have e4X : 4 * X = 2 ^ (ν + 6) * D ^ 3 * Q ^ 4 / δ ^ 2 := by
          rw [hX, show ν + 6 = (ν + 4) + 2 by ring, pow_add]; ring
        rw [e4X, hx, div_pow, one_div_div, div_le_div_iff₀ (by positivity) (by positivity)]
        have hin : δ ^ 2 * 2 ^ (ν + 6) ≤ (4 ^ (ν + 4)) ^ 4 * D := by
          have h1 : (2 : ℝ) ^ (ν + 6) ≤ (4 ^ (ν + 4)) ^ 4 := by
            rw [← pow_mul]
            calc (2 : ℝ) ^ (ν + 6) ≤ 4 ^ (ν + 6) :=
                  pow_le_pow_left₀ (by norm_num) (by norm_num) _
              _ ≤ 4 ^ ((ν + 4) * 4) := pow_le_pow_right₀ (by norm_num) (by omega)
          have h2 : δ ^ 2 * 2 ^ (ν + 6) ≤ 1 * 2 ^ (ν + 6) :=
            mul_le_mul_of_nonneg_right hδ2 (by positivity)
          have h3 : (4 ^ (ν + 4)) ^ 4 * 1 ≤ (4 ^ (ν + 4)) ^ 4 * D :=
            mul_le_mul_of_nonneg_left hD (by positivity)
          linarith
        have eL : δ ^ 4 * (2 ^ (ν + 6) * D ^ 3 * Q ^ 4)
            = (δ ^ 2 * D ^ 3 * Q ^ 4) * (δ ^ 2 * 2 ^ (ν + 6)) := by ring
        have eR : δ ^ 2 * (4 ^ (ν + 4) * D * Q) ^ 4
            = (δ ^ 2 * D ^ 3 * Q ^ 4) * ((4 ^ (ν + 4)) ^ 4 * D) := by ring
        rw [eL, eR]
        exact mul_le_mul_of_nonneg_left hin (by positivity)
      have hc0 : (0 : ℝ) < 2 ^ (ν + 2) * Q ^ 2 := by positivity
      calc x ^ (16 * (a + 1)) ≤ x ^ (8 * a + 2) :=
            pow_le_pow_of_le_one hxpos.le hx1 (by omega)
        _ = x ^ 2 * (x ^ 4) ^ (2 * a) := by
            rw [← pow_mul, ← pow_add]; congr 1; ring
        _ ≤ δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2) * (1 / (4 * X)) ^ (2 * a) :=
            mul_le_mul hx2 (pow_le_pow_left₀ (by positivity) hx4 _) (by positivity)
              (by positivity)
        _ = δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 * ((4 * X) ^ 2) ^ a) := by
            rw [one_div_pow, ← pow_mul, div_mul_div_comm, mul_one]
        _ ≤ δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 * ((2 * K + 1 : ℕ) : ℝ) ^ a) := by
            apply div_le_div_of_nonneg_left hδ2pos.le (by positivity)
            exact mul_le_mul_of_nonneg_left hpowK hc0.le
  obtain ⟨h5i, h5ii⟩ := h5
  obtain ⟨K, hKdef⟩ : ∃ K : ℕ, K = ⌈(2 ^ (ν + 4) * D ^ 3 * Q ^ 4 / δ ^ 2) ^ 2⌉₊ := ⟨_, rfl⟩
  rw [← hKdef] at h5i h5ii
  obtain ⟨M, hMdef⟩ : ∃ M : Finset (Fin a → ℤ),
      M = Finset.Icc (fun _ => -(K : ℤ)) (fun _ => (K : ℤ)) := ⟨_, rfl⟩
  have hMcard : M.card = (2 * K + 1) ^ a := by
    rw [hMdef, Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  have hκ : ((M.card : ℕ) : ℝ) = ((2 * K + 1 : ℕ) : ℝ) ^ a := by
    rw [hMcard, Nat.cast_pow]
  have hκpos : (0 : ℝ) < (M.card : ℝ) := by rw [hκ]; positivity
  have h0M : (0 : Fin a → ℤ) ∈ M := by
    rw [hMdef, Finset.mem_Icc]
    constructor <;> intro i <;> simp
  rw [← hκ] at h5ii
  have hη₂ : (0 : ℝ) < δ ^ 2 / 2 ^ (ν + 1) := by positivity
  have hτ : (0 : ℝ) < δ ^ 2 / 2 ^ (ν + 2) := by positivity
  have hτ2 : 2 * (δ ^ 2 / 2 ^ (ν + 2)) ≤ δ ^ 2 / 2 ^ (ν + 1) := by
    apply le_of_eq
    rw [pow_succ 2 (ν + 1)]
    field_simp
    try ring
  have hΛ : (0 : ℝ) ≤ 4 * D ^ 2 * Q ^ 4 := by positivity
  have hB₀ : (0 : ℝ) < Q ^ 2 := by positivity
  have hc : (0 : ℝ) < 2 * Q ^ 2 * (M.card : ℝ) := by positivity
  have hη : (0 : ℝ) < δ ^ 2 / 2 ^ (ν + 1) / (2 * Q ^ 2 * (M.card : ℝ)) := by positivity
  
  have hP : (0 : ℝ) < (2 * (L : ℝ)) ^ ν := by positivity
  have hηs : 0 < (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) := by positivity
  have hpos1 : 0 ≤ δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 * (M.card : ℝ)) := by positivity
  have hpos3 : 0 < (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) * (L : ℝ) := by positivity
  have e1 : 2 * (δ ^ 2 / 2 ^ (ν + 1) / (2 * Q ^ 2 * (M.card : ℝ)))
      = 2 * (δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 * (M.card : ℝ))) := by
    rw [pow_succ 2 (ν + 1)]
    field_simp
    try ring
  have hle : (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) * (L : ℝ)
      ≤ 2 * (δ ^ 2 / 2 ^ (ν + 1) / (2 * Q ^ 2 * (M.card : ℝ))) * (L : ℝ) := by
    apply mul_le_mul_of_nonneg_right _ hLpos.le
    rw [e1]
    linarith
  have e2 : δ ^ 2 / (2 ^ (ν + 1) * Q ^ 2) * (2 * (L : ℝ)) ^ ν / (M.card : ℝ)
      = 2 * (δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 * (M.card : ℝ)) * (2 * (L : ℝ)) ^ ν) := by
    rw [pow_succ 2 (ν + 1)]
    field_simp
    try ring
  have hpos2 : 0 ≤ δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 * (M.card : ℝ)) * (2 * (L : ℝ)) ^ ν := by
    positivity
  have hcardbd : (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) * (2 * (L : ℝ)) ^ ν
      ≤ (E₀.card : ℝ) / (M.card : ℝ) := by
    calc (δ / (4 ^ (ν + 4) * D * Q)) ^ (16 * (a + 1)) * (2 * (L : ℝ)) ^ ν
        ≤ δ ^ 2 / (2 ^ (ν + 2) * Q ^ 2 * (M.card : ℝ)) * (2 * (L : ℝ)) ^ ν :=
          mul_le_mul_of_nonneg_right h5ii hP.le
      _ ≤ δ ^ 2 / (2 ^ (ν + 1) * Q ^ 2) * (2 * (L : ℝ)) ^ ν / (M.card : ℝ) := by
          rw [e2]; linarith
      _ ≤ (E₀.card : ℝ) / (M.card : ℝ) := div_le_div_of_nonneg_right hE₀card hκpos.le
  have hns : M.card • ((E₀.card : ℝ) / (M.card : ℝ)) ≤ (E₀.card : ℝ) := by
    rw [nsmul_eq_mul]
    exact le_of_eq (by field_simp)
  
