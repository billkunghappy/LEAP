      fun l => (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ _).2 (hzr l)
    simp only [Int.cast_add, Int.cast_sum, Int.cast_mul, h]
  
  obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = T / ((q : ℝ) * N) := ⟨_, rfl⟩
  have ht0 : 0 ≤ t := by rw [ht_def]; positivity
  have hη' : ∀ l, |η l| ≤ t := fun l => by rw [ht_def]; exact hη l
  have hθ' : ∀ l l', |θ l l'| ≤ t / N := fun l l' => by
    rw [ht_def, div_div, mul_assoc, ← sq]; exact hθ l l'
  have hosc : ∀ z z' : Fin ν → ℤ, (∀ l, |((z l : ℤ) : ℝ)| ≤ N) →
      (∀ l, |((z' l : ℤ) : ℝ)| ≤ N) →
      (∀ l, |((z l : ℤ) : ℝ) - ((z' l : ℤ) : ℝ)| ≤ κ) →
      |σ z - σ z'| ≤ (ν : ℝ) * (t * κ) + (ν : ℝ) * ((ν : ℝ) * (2 * t * κ)) := by
    intro z z' hz hz' hzz
    have e : σ z - σ z' = ∑ l, (η l * (z l : ℝ) - η l * (z' l : ℝ))
        + ∑ l, ∑ l', (θ l l' * (z l : ℝ) * (z l' : ℝ) - θ l l' * (z' l : ℝ) * (z' l' : ℝ)) := by
      rw [hσ, hσ]
      simp only [Finset.sum_sub_distrib]
      ring
    have h1 : ∀ l, |η l * (z l : ℝ) - η l * (z' l : ℝ)| ≤ t * κ := by
      intro l
      rw [← mul_sub, abs_mul]
      exact mul_le_mul (hη' l) (hzz l) (abs_nonneg _) ht0
    have h2 : ∀ l l', |θ l l' * (z l : ℝ) * (z l' : ℝ) - θ l l' * (z' l : ℝ) * (z' l' : ℝ)|
        ≤ 2 * t * κ := by
      intro l l'
      have e2 : θ l l' * (z l : ℝ) * (z l' : ℝ) - θ l l' * (z' l : ℝ) * (z' l' : ℝ)
          = θ l l' * ((z l : ℝ) * ((z l' : ℝ) - z' l') + ((z l : ℝ) - z' l) * (z' l' : ℝ)) := by
        ring
      rw [e2, abs_mul]
      have h3 : |(z l : ℝ) * ((z l' : ℝ) - z' l') + ((z l : ℝ) - z' l) * (z' l' : ℝ)|
          ≤ N * κ + κ * N := by
        refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
        · rw [abs_mul]; exact mul_le_mul (hz l) (hzz l') (abs_nonneg _) (Nat.cast_nonneg _)
        · rw [abs_mul]; exact mul_le_mul (hzz l) (hz' l') (abs_nonneg _) hκpos.le
      calc |θ l l'| * |(z l : ℝ) * ((z l' : ℝ) - z' l') + ((z l : ℝ) - z' l) * (z' l' : ℝ)|
          ≤ (t / N) * (N * κ + κ * N) :=
            mul_le_mul (hθ' l l') h3 (abs_nonneg _) (by positivity)
        _ = 2 * t * κ := by field_simp; ring
    rw [e]
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      refine (Finset.sum_le_sum (fun l _ => h1 l)).trans ?_
      simp
    · refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      refine (Finset.sum_le_sum (fun l _ => (Finset.abs_sum_le_sum_abs _ _).trans
        (Finset.sum_le_sum (fun l' _ => h2 l l')))).trans ?_
      simp
  
  have htκ : t * κ ≤ 3 * (T / H) := by
    have e : t * κ = (T / H) * ((2 * (N : ℝ) + 1) / ((q : ℝ) * N)) := by
      rw [ht_def, hκ_def]; field_simp
    rw [e, mul_comm 3]
    apply mul_le_mul_of_nonneg_left _ (div_nonneg hT hHpos.le)
    rw [div_le_iff₀ (by positivity)]
    have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
    have hN1' : (1 : ℝ) ≤ N := by exact_mod_cast hN1
    nlinarith
  have hνν : (ν : ℝ) ≤ (ν : ℝ) ^ 2 := by
    rcases Nat.eq_zero_or_pos ν with h | h
    · simp [h]
    · have : (1 : ℝ) ≤ ν := by exact_mod_cast h
      nlinarith
  have htκ0 : 0 ≤ t * κ := mul_nonneg ht0 hκpos.le
  have hTH : 0 ≤ T / H := div_nonneg hT hHpos.le
  have hnum : 2 * Real.pi * ((ν : ℝ) * (t * κ) + (ν : ℝ) * ((ν : ℝ) * (2 * t * κ)))
      ≤ 24 * Real.pi * (ν : ℝ) ^ 2 * (T / H) := by
    have e1 : (ν : ℝ) * (t * κ) + (ν : ℝ) * ((ν : ℝ) * (2 * t * κ))
        = ((ν : ℝ) + 2 * (ν : ℝ) ^ 2) * (t * κ) := by ring
    rw [e1]
    have e2 : ((ν : ℝ) + 2 * (ν : ℝ) ^ 2) * (t * κ) ≤ (3 * (ν : ℝ) ^ 2) * (3 * (T / H)) :=
      mul_le_mul (by linarith) htκ htκ0 (by positivity)
    calc 2 * Real.pi * (((ν : ℝ) + 2 * (ν : ℝ) ^ 2) * (t * κ))
        ≤ 2 * Real.pi * ((3 * (ν : ℝ) ^ 2) * (3 * (T / H))) :=
          mul_le_mul_of_nonneg_left e2 (by positivity)
      _ = 18 * Real.pi * ((ν : ℝ) ^ 2 * (T / H)) := by ring
      _ ≤ 24 * Real.pi * ((ν : ℝ) ^ 2 * (T / H)) :=
          mul_le_mul_of_nonneg_right (by nlinarith [Real.pi_pos]) (by positivity)
      _ = 24 * Real.pi * (ν : ℝ) ^ 2 * (T / H) := by ring
  
  obtain ⟨jf, hjf⟩ : ∃ jf : NumberField.RingOfIntegers K → Fin ν → ℤ,
      ∀ x l, jf x l = ⌊(((ω.equivFun x l : ℤ) : ℝ) + N) / κ⌋ := ⟨_, fun _ _ => rfl⟩
  obtain ⟨rf, hrf⟩ : ∃ rf : NumberField.RingOfIntegers K → Fin ν → ℤ,
      ∀ x l, rf x l = ω.equivFun x l % (q : ℤ) := ⟨_, fun _ _ => rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : Finset ((Fin ν → ℤ) × (Fin ν → ℤ)),
      J = Fintype.piFinset (fun _ : Fin ν => Finset.Ico (0 : ℤ) H)
        ×ˢ Fintype.piFinset (fun _ : Fin ν => Finset.Ico (0 : ℤ) q) := ⟨_, rfl⟩
  have hJcard : (J.card : ℝ) = ((q : ℝ) * (H : ℝ)) ^ ν := by
    rw [hJ, Finset.card_product, Fintype.card_piFinset, Fintype.card_piFinset]
    simp only [Int.card_Ico, sub_zero, Int.toNat_natCast, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
    push_cast; ring
  have hπ : ∀ x ∈ omegaBox ω M, (fun x => (jf x, rf x)) x ∈ J := by
    intro x hx
    rw [hJ]
    simp only [Finset.mem_product, Fintype.mem_piFinset, Finset.mem_Ico, hjf, hrf]
    refine ⟨fun l => hrange _ (hbox x hx l), fun l => ?_⟩
    exact ⟨Int.emod_nonneg _ hqz.ne', Int.emod_lt_of_pos _ hqz⟩
  have hg1 : ∀ x ∈ omegaBox ω M, ‖giE (P (ω.equivFun x))‖ ≤ 1 :=
    fun x _ => (hE1 _).le
  have hgδ : ∀ x ∈ omegaBox ω M, ∀ y ∈ omegaBox ω M,
      (fun x => (jf x, rf x)) x = (fun x => (jf x, rf x)) y →
      ‖giE (P (ω.equivFun x)) - giE (P (ω.equivFun y))‖
        ≤ 24 * Real.pi * (ν : ℝ) ^ 2 * (T / H) := by
    intro x hx y hy hxy
    simp only [Prod.mk.injEq] at hxy
    obtain ⟨hj, hr⟩ := hxy
    have hdv : ∀ l, (q : ℤ) ∣ ω.equivFun x l - ω.equivFun y l := by
      intro l
      have h := congrFun hr l
      rw [hrf, hrf] at h
      exact Int.ModEq.dvd (h.symm : Int.ModEq (q : ℤ) _ _)
    obtain ⟨m, hm⟩ := hRdvd _ _ hdv
    have hPeq : P (ω.equivFun x)
        = (P (ω.equivFun y) + (σ (ω.equivFun x) - σ (ω.equivFun y))) + (m : ℝ) := by
      rw [hPR, hPR]
      have hm' : ((R (ω.equivFun x) : ℤ) : ℝ) = ((R (ω.equivFun y) : ℤ) : ℝ) + (q : ℝ) * m := by
        have := congrArg (fun z : ℤ => (z : ℝ)) hm
        push_cast at this; linarith
      rw [hm', add_div, mul_div_cancel_left₀ _ hqpos.ne']
      ring
    rw [hPeq, hE2]
    refine (hE3 _ _).trans ?_
    have hsm := hosc _ _ (hbox x hx) (hbox y hy) (fun l => hdiam _ _ (by
      have := congrFun hj l
      rw [hjf, hjf] at this
      exact this))
    calc 2 * Real.pi * |σ (ω.equivFun x) - σ (ω.equivFun y)|
        ≤ 2 * Real.pi * ((ν : ℝ) * (t * κ) + (ν : ℝ) * ((ν : ℝ) * (2 * t * κ))) :=
          mul_le_mul_of_nonneg_left hsm (by positivity)
      _ ≤ _ := hnum
  have hε : ∀ i ∈ J,
      |∑ x ∈ (omegaBox ω M).filter (fun x => (fun x => (jf x, rf x)) x = i), f x| ≤ ε := by
    rintro ⟨j, r⟩ hi
    rw [hJ] at hi
    simp only [Finset.mem_product, Fintype.mem_piFinset, Finset.mem_Ico] at hi
    obtain ⟨hjr, hrr⟩ := hi
    obtain ⟨Ωj, hΩj⟩ : ∃ Ωj : Set (Fin ν → ℝ),
        Ωj = Set.univ.pi (fun l => Set.Ico ((j l : ℝ) * κ - N) ((j l : ℝ) * κ + κ - N)) :=
      ⟨_, rfl⟩
    have hmeas : MeasurableSet Ωj := by
      rw [hΩj]; exact MeasurableSet.univ_pi (fun l => measurableSet_Ico)
    have hconv : Convex ℝ Ωj := by
      rw [hΩj]; exact convex_pi (fun l _ => convex_Ico _ _)
    have hfilt : (omegaBox ω M).filter (fun x => (fun x => (jf x, rf x)) x = (j, r))
        = @Finset.filter (NumberField.RingOfIntegers K)
            (fun x => (fun l => ((ω.equivFun x l : ℤ) : ℝ)) ∈ Ωj ∧
              x - ω.equivFun.symm r ∈ Ideal.span {((q : ℕ) : NumberField.RingOfIntegers K)})
            (fun _ => Classical.propDecidable _) (omegaBox ω M) := by
      ext x
      simp only [Finset.mem_filter]
      apply and_congr_right
      intro _
      rw [Prod.mk.injEq, hspan, LinearEquiv.apply_symm_apply]
      apply and_congr
      · rw [funext_iff, hΩj, Set.mem_univ_pi]
        apply forall_congr'
        intro l
        rw [hjf, hfloor, Set.mem_Ico]
      · rw [funext_iff]
        apply forall_congr'
        intro l
        rw [hrf]
        exact key _ _ (hrr l).1 (hrr l).2
    rw [hfilt]
    exact hclass Ωj hmeas hconv _
  
  have hδ0 : 0 ≤ 24 * Real.pi * (ν : ℝ) ^ 2 * (T / H) := by positivity
  have main := s1 (omegaBox ω M) J (fun x => (jf x, rf x)) (fun x => giE (P (ω.equivFun x)))
    (24 * Real.pi * (ν : ℝ) ^ 2 * (T / H)) hπ hg1 hgδ hε
  rw [hJcard] at main
  have := mul_le_mul_of_nonneg_left hBf hδ0
  linarith

theorem ideal_moebius_exists (K : Type u) [Field K] [NumberField K] :
    ∃ μ : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ I, |μ I| ≤ 1) ∧
      ∀ k : Ideal (NumberField.RingOfIntegers K), k ≠ ⊥ →
        ∑ d ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ k)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm k)).toFinset), μ d
          = @ite ℝ (k = ⊤) (Classical.propDecidable _) 1 0 :=
by
  classical
  obtain ⟨μ, hμdef⟩ : ∃ μ : Ideal (NumberField.RingOfIntegers K) → ℝ, μ = fun I =>
      @ite ℝ (UniqueFactorizationMonoid.normalizedFactors I).Nodup (Classical.propDecidable _)
        ((-1 : ℝ) ^ Multiset.card (UniqueFactorizationMonoid.normalizedFactors I)) 0 := ⟨_, rfl⟩
  refine ⟨μ, ?_, ?_⟩
  · intro I
    rw [hμdef]
    dsimp only
    split_ifs
    · rw [abs_pow, abs_neg, abs_one, one_pow]
    · simp
  intro k hk
  have hk0 : k ≠ 0 := by rwa [Ideal.zero_eq_bot]
  
  have G1 : ∀ Z, Z ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ k)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm k)).toFinset) ↔ Z ∣ k := by
    intro Z
    rw [Finset.mem_filter, Set.Finite.mem_toFinset]
    constructor
    · exact fun h => h.2
    · intro h
      refine ⟨?_, h⟩
      show Ideal.absNorm Z ≤ Ideal.absNorm k
      have hne : Ideal.absNorm k ≠ 0 := fun h0 => hk (Ideal.absNorm_eq_zero_iff.mp h0)
      exact Nat.le_of_dvd (Nat.pos_of_ne_zero hne)
        (Ideal.absNorm_dvd_absNorm_of_le (Ideal.dvd_iff_le.mp h))
  
  have s3 : ∀ S : Finset (Ideal (NumberField.RingOfIntegers K)),
      S ⊆ (UniqueFactorizationMonoid.normalizedFactors k).toFinset →
      (∏ p ∈ S, p) ∣ k ∧ UniqueFactorizationMonoid.normalizedFactors (∏ p ∈ S, p) = S.val := by
    intro S hS
    have hmem : ∀ p ∈ S.val, p ∈ UniqueFactorizationMonoid.normalizedFactors k := fun p hp =>
      Multiset.mem_toFinset.mp (hS (Finset.mem_val.mp hp))
    have hprod : (∏ p ∈ S, p) = S.val.prod := (Finset.prod_val S).symm
    rw [hprod]
    constructor
    · have hle : S.val ≤ UniqueFactorizationMonoid.normalizedFactors k :=
        (Multiset.le_iff_subset S.nodup).mpr hmem
      have h1 := Multiset.prod_dvd_prod_of_le hle
      rwa [associated_iff_eq.mp (UniqueFactorizationMonoid.prod_normalizedFactors hk0)] at h1
    · exact UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
        (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p (hmem p hp))
  
  have s4 : ∀ d, d ∣ k → (UniqueFactorizationMonoid.normalizedFactors d).Nodup →
      (UniqueFactorizationMonoid.normalizedFactors d).toFinset
          ⊆ (UniqueFactorizationMonoid.normalizedFactors k).toFinset ∧
        ∏ p ∈ (UniqueFactorizationMonoid.normalizedFactors d).toFinset, p = d := by
    intro d hd hnd
    have hd0 : d ≠ 0 := by
      rintro rfl
      exact hk0 (zero_dvd_iff.mp hd)
    have hle :=
      (UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hd0 hk0).mp hd
    constructor
    · intro p hp
      exact Multiset.mem_toFinset.mpr (Multiset.mem_of_le hle (Multiset.mem_toFinset.mp hp))
    · have hprod : (∏ p ∈ (UniqueFactorizationMonoid.normalizedFactors d).toFinset, p)
          = (UniqueFactorizationMonoid.normalizedFactors d).toFinset.val.prod :=
        (Finset.prod_val _).symm
      rw [hprod, Multiset.toFinset_val, hnd.dedup]
      exact associated_iff_eq.mp (UniqueFactorizationMonoid.prod_normalizedFactors hd0)
  
  have s5 : ∑ S ∈ (UniqueFactorizationMonoid.normalizedFactors k).toFinset.powerset,
        (-1 : ℝ) ^ S.card
      = ∑ d ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ k)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm k)).toFinset), μ d := by
    apply Finset.sum_bij_ne_zero (fun S _ _ => ∏ p ∈ S, p)
    · intro S hS _
      exact (G1 _).mpr (s3 S (Finset.mem_powerset.mp hS)).1
    · intro S hS _ T hT _ hST
      have h1 := (s3 S (Finset.mem_powerset.mp hS)).2
      have h2 := (s3 T (Finset.mem_powerset.mp hT)).2
      apply Finset.val_inj.mp
      rw [← h1, ← h2]
      exact congrArg _ hST
    · intro d hd hμ
      have hnd : (UniqueFactorizationMonoid.normalizedFactors d).Nodup := by
        by_contra hc
        apply hμ
        rw [hμdef]
        exact if_neg hc
      obtain ⟨hsub, hpr⟩ := s4 d ((G1 d).mp hd) hnd
      exact ⟨_, Finset.mem_powerset.mpr hsub, pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero), hpr⟩
    · intro S hS _
      have h1 := (s3 S (Finset.mem_powerset.mp hS)).2
      rw [hμdef]
      dsimp only
      rw [h1, if_pos S.nodup, Finset.card_val]
  
  have s6 : ∑ S ∈ (UniqueFactorizationMonoid.normalizedFactors k).toFinset.powerset,
        (-1 : ℝ) ^ S.card
      = if (UniqueFactorizationMonoid.normalizedFactors k).toFinset = ∅ then 1 else 0 := by
    have h := Finset.sum_powerset_neg_one_pow_card
      (x := (UniqueFactorizationMonoid.normalizedFactors k).toFinset)
    have hc : ((∑ S ∈ (UniqueFactorizationMonoid.normalizedFactors k).toFinset.powerset,
        (-1 : ℤ) ^ S.card : ℤ) : ℝ)
        = ∑ S ∈ (UniqueFactorizationMonoid.normalizedFactors k).toFinset.powerset,
          (-1 : ℝ) ^ S.card := by
      push_cast
      rfl
    rw [← hc, h]
    split_ifs <;> simp
  
  have s7 : (UniqueFactorizationMonoid.normalizedFactors k).toFinset = ∅ ↔ k = ⊤ := by
    rw [Multiset.toFinset_eq_empty, UniqueFactorizationMonoid.normalizedFactors_eq_zero_iff hk0,
      Ideal.isUnit_iff]
  rw [← s5, s6]
  by_cases h : k = ⊤
  · rw [if_pos (s7.mpr h), if_pos h]
  · rw [if_neg (fun h' => h (s7.mp h')), if_neg h]

theorem ideal_vonMangoldt_divisor_sum (K : Type u) [Field K] [NumberField K] :
    ∃ Λ' : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ x : NumberField.RingOfIntegers K, vonMangoldtO x = Λ' (Ideal.span {x})) ∧
      (∀ I, 0 ≤ Λ' I ∧ Λ' I ≤ Real.log (Ideal.absNorm I : ℝ)) ∧
      ∀ n : Ideal (NumberField.RingOfIntegers K), n ≠ ⊥ →
        ∑ m ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset), Λ' m
          = Real.log (Ideal.absNorm n : ℝ) :=
by
  classical
  
  have s2 : ∀ (P Q : Ideal (NumberField.RingOfIntegers K)), P.IsPrime → P ≠ ⊥ →
      Q.IsPrime → Q ≠ ⊥ → ∀ k j : ℕ, 0 < k → 0 < j → P ^ k = Q ^ j → P = Q ∧ k = j := by
    intro P Q hP hP0 hQ hQ0 k j hk hj h
    have hQjP : Q ^ j ≤ P := by
      rw [← h]; exact Ideal.pow_le_self (by omega)
    have hQP : Q ≤ P := @Ideal.IsPrime.le_of_pow_le _ _ Q P hP j hQjP
    have hQmax : Q.IsMaximal := Ideal.IsPrime.isMaximal hQ hQ0
    have hEq : Q = P := hQmax.eq_of_le hP.ne_top hQP
    subst hEq
    exact ⟨rfl, (Ideal.pow_right_strictAnti Q hP0 hP.ne_top).injective h⟩
  
  have s3 : ∀ (P n : Ideal (NumberField.RingOfIntegers K)), Prime P → n ≠ ⊥ → ∀ k : ℕ,
      (P ^ k ∣ n ↔ k ≤ Multiset.count P (UniqueFactorizationMonoid.normalizedFactors n)) := by
    intro P n hP hn k
    have hn0 : n ≠ 0 := by rwa [Ideal.zero_eq_bot]
    have hPk : P ^ k ≠ 0 := pow_ne_zero _ hP.ne_zero
    rw [UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hPk hn0,
      UniqueFactorizationMonoid.normalizedFactors_pow,
      UniqueFactorizationMonoid.normalizedFactors_irreducible hP.irreducible, normalize_eq,
      Multiset.nsmul_singleton, Multiset.le_count_iff_replicate_le]
  
  have s4 : ∀ n : Ideal (NumberField.RingOfIntegers K), n ≠ ⊥ →
      Real.log (Ideal.absNorm n : ℝ) =
        ∑ P ∈ (UniqueFactorizationMonoid.normalizedFactors n).toFinset,
          ((Multiset.count P (UniqueFactorizationMonoid.normalizedFactors n) : ℕ) : ℝ)
            * Real.log (Ideal.absNorm P : ℝ) := by
    intro n hn
    have hn0 : n ≠ 0 := by rwa [Ideal.zero_eq_bot]
    have hprod : (UniqueFactorizationMonoid.normalizedFactors n).prod = n := by
      rw [UniqueFactorizationMonoid.prod_normalizedFactors_eq hn0, normalize_eq]
    have hN : Ideal.absNorm n =
        ∏ P ∈ (UniqueFactorizationMonoid.normalizedFactors n).toFinset,
          Ideal.absNorm P ^ Multiset.count P (UniqueFactorizationMonoid.normalizedFactors n) := by
      conv_lhs => rw [← hprod]
      rw [map_multiset_prod, Finset.prod_multiset_map_count]
    rw [hN, Nat.cast_prod, Real.log_prod]
    · refine Finset.sum_congr rfl (fun P _ => ?_)
      rw [Nat.cast_pow, Real.log_pow]
    · intro P hP
      have hP0 : P ≠ 0 :=
        UniqueFactorizationMonoid.ne_zero_of_mem_normalizedFactors (Multiset.mem_toFinset.mp hP)
      have hNP : Ideal.absNorm P ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]
        intro h
        exact hP0 (h.trans Ideal.zero_eq_bot.symm)
      exact Nat.cast_ne_zero.mpr (pow_ne_zero _ hNP)
  
  have s5 : ∀ n Z : Ideal (NumberField.RingOfIntegers K), n ≠ ⊥ → Z ∣ n →
      Z ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset) := by
    intro n Z hn hZ
    rw [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
    refine ⟨?_, hZ⟩
    have hle : n ≤ Z := Ideal.le_of_dvd hZ
    have hd := Ideal.absNorm_dvd_absNorm_of_le hle
    have hpos : 0 < Ideal.absNorm n :=
      Nat.pos_of_ne_zero (by rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hn)
    exact Nat.le_of_dvd hpos hd
  
  obtain ⟨Λ', hΛ'⟩ : ∃ Λ' : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ I, Λ' I =
      if h : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 0 < m ∧ I = p.asIdeal ^ m
      then Real.log (Ideal.absNorm h.choose.asIdeal) else 0 := ⟨_, fun _ => rfl⟩
  refine ⟨Λ', ?_, ?_, ?_⟩
  
  · intro x
    rw [hΛ']
    rfl
  
  · intro I
    rw [hΛ']
    split_ifs with h
    · have hspec := h.choose_spec
      generalize h.choose = q at hspec ⊢
      obtain ⟨j, hj, hIq⟩ := hspec
      have hq0 : Ideal.absNorm q.asIdeal ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact q.ne_bot
      refine ⟨Real.log_natCast_nonneg _, ?_⟩
      apply Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hq0)
      have hN := congrArg Ideal.absNorm hIq
      rw [map_pow] at hN
      rw [hN]
      exact_mod_cast Nat.le_self_pow (by omega) _
    · exact ⟨le_rfl, Real.log_natCast_nonneg _⟩
  
  · intro n hn
    have memF : ∀ P ∈ UniqueFactorizationMonoid.normalizedFactors n, Prime P ∧ P ≠ ⊥ :=
      fun P hP => ⟨UniqueFactorizationMonoid.prime_of_normalized_factor P hP,
        fun h => UniqueFactorizationMonoid.ne_zero_of_mem_normalizedFactors hP
          (h.trans Ideal.zero_eq_bot.symm)⟩
    
    have hexp : ∀ m : Ideal (NumberField.RingOfIntegers K), m ∣ n → Λ' m =
        ∑ P ∈ (UniqueFactorizationMonoid.normalizedFactors n).toFinset,
          ∑ k ∈ Finset.Icc 1 (Multiset.count P (UniqueFactorizationMonoid.normalizedFactors n)),
            if m = P ^ k then Real.log (Ideal.absNorm P : ℝ) else 0 := by
      intro m hmn
      rw [hΛ']
      split_ifs with h
      · have hspec := h.choose_spec
        generalize h.choose = q at hspec ⊢
        obtain ⟨j, hj, hmq⟩ := hspec
        subst hmq
        have hQprime : Prime q.asIdeal := Ideal.prime_of_isPrime q.ne_bot q.isPrime
        have hjc : j ≤ Multiset.count q.asIdeal (UniqueFactorizationMonoid.normalizedFactors n) :=
          (s3 _ _ hQprime hn j).mp hmn
        have hQT : q.asIdeal ∈ (UniqueFactorizationMonoid.normalizedFactors n).toFinset :=
          Multiset.mem_toFinset.mpr (Multiset.count_pos.mp (by omega))
        rw [Finset.sum_eq_single q.asIdeal]
        · rw [Finset.sum_eq_single j]
          · rw [if_pos rfl]
          · intro k hk hkj
            rw [if_neg]
            intro he
            exact hkj ((s2 _ _ q.isPrime q.ne_bot q.isPrime q.ne_bot j k hj
              (Finset.mem_Icc.mp hk).1 he).2).symm
          · intro hj'
            exact absurd (Finset.mem_Icc.mpr ⟨hj, hjc⟩) hj'
        · intro P hP hPq
          apply Finset.sum_eq_zero
          intro k hk
          rw [if_neg]
          intro he
          obtain ⟨hPp, hP0⟩ := memF P (Multiset.mem_toFinset.mp hP)
          exact hPq (s2 _ _ (Ideal.isPrime_of_prime hPp) hP0 q.isPrime q.ne_bot k j
            (Finset.mem_Icc.mp hk).1 hj he.symm).1
        · intro h'
          exact absurd hQT h'
      · symm
        apply Finset.sum_eq_zero
        intro P hP
        apply Finset.sum_eq_zero
        intro k hk
        rw [if_neg]
        intro he
        obtain ⟨hPp, hP0⟩ := memF P (Multiset.mem_toFinset.mp hP)
        exact h ⟨⟨P, Ideal.isPrime_of_prime hPp, hP0⟩, k, (Finset.mem_Icc.mp hk).1, he⟩
    
    rw [Finset.sum_congr rfl (fun m hm => hexp m (Finset.mem_filter.mp hm).2)]
    rw [Finset.sum_comm, s4 n hn]
    refine Finset.sum_congr rfl (fun P hP => ?_)
    obtain ⟨hPp, _⟩ := memF P (Multiset.mem_toFinset.mp hP)
    rw [Finset.sum_comm]
    have hcol : ∀ k ∈ Finset.Icc 1
        (Multiset.count P (UniqueFactorizationMonoid.normalizedFactors n)),
        (∑ m ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          if m = P ^ k then Real.log (Ideal.absNorm P : ℝ) else 0)
          = Real.log (Ideal.absNorm P : ℝ) := by
      intro k hk
      rw [Finset.sum_ite_eq']
      rw [if_pos (s5 n _ hn ((s3 P n hPp hn k).mpr (Finset.mem_Icc.mp hk).2))]
    rw [Finset.sum_congr rfl hcol, Finset.sum_const, Nat.card_Icc, Nat.add_sub_cancel,
      nsmul_eq_mul]

theorem ideal_divisor_pair_sum (K : Type u) [Field K] [NumberField K] :
    (∀ n Z : Ideal (NumberField.RingOfIntegers K), n ≠ ⊥ →
      (Z ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z' => Z' ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset) ↔ Z ∣ n)) ∧
    (∀ (n : Ideal (NumberField.RingOfIntegers K))
        (F : Ideal (NumberField.RingOfIntegers K) → ℝ), n ≠ ⊥ →
      ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
        ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          @ite ℝ (I * J = n) (Classical.propDecidable _) (F I) 0
        = ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset), F I) ∧
    (∀ (n : Ideal (NumberField.RingOfIntegers K))
        (F : Ideal (NumberField.RingOfIntegers K) → ℝ), n ≠ ⊥ →
      ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
        ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          @ite ℝ (I * J = n) (Classical.propDecidable _) (F J) 0
        = ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset), F J) :=
by
  have mem : ∀ n Z : Ideal (NumberField.RingOfIntegers K), n ≠ ⊥ →
      (Z ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z' => Z' ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset) ↔ Z ∣ n) := by
    intro n Z hn
    simp only [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
    constructor
    · exact fun h => h.2
    · intro h
      refine ⟨?_, h⟩
      have h1 : Ideal.absNorm Z ∣ Ideal.absNorm n :=
        Ideal.absNorm_dvd_absNorm_of_le (Ideal.dvd_iff_le.mp h)
      have h2 : Ideal.absNorm n ≠ 0 := fun h0 => hn (Ideal.absNorm_eq_zero_iff.mp h0)
      exact Nat.le_of_dvd (Nat.pos_of_ne_zero h2) h1
  have ne0 : ∀ n Z : Ideal (NumberField.RingOfIntegers K), n ≠ ⊥ → Z ∣ n → Z ≠ 0 := by
    intro n Z hn h hZ
    apply hn
    rw [hZ] at h
    rw [← Ideal.zero_eq_bot]
    exact zero_dvd_iff.mp h
  refine ⟨mem, ?_, ?_⟩
  · intro n F hn
    refine Finset.sum_congr rfl (fun I hI => ?_)
    have hIn : I ∣ n := (mem n I hn).mp hI
    have hI0 : I ≠ 0 := ne0 n I hn hIn
    obtain ⟨c, hc⟩ := hIn
    rw [Finset.sum_eq_single c]
    · exact if_pos hc.symm
    · intro J _ hJc
      apply if_neg
      intro hIJ
      exact hJc (mul_left_cancel₀ hI0 (hIJ.trans hc))
    · intro hcn
      exact absurd ((mem n c hn).mpr (Dvd.intro_left I hc.symm)) hcn
  · intro n F hn
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun J hJ => ?_)
    have hJn : J ∣ n := (mem n J hn).mp hJ
    have hJ0 : J ≠ 0 := ne0 n J hn hJn
    obtain ⟨c, hc⟩ := hJn
    have hc' : n = c * J := by rw [hc, mul_comm]
    rw [Finset.sum_eq_single c]
    · exact if_pos hc'.symm
    · intro I _ hIc
      apply if_neg
      intro hIJ
      exact hIc (mul_right_cancel₀ hJ0 (hIJ.trans hc'))
    · intro hcn
      exact absurd ((mem n c hn).mpr (Dvd.intro J hc'.symm)) hcn

theorem ideal_divisor_assoc (K : Type u) [Field K] [NumberField K] :
    ∀ (n : Ideal (NumberField.RingOfIntegers K))
      (G : Ideal (NumberField.RingOfIntegers K) → Ideal (NumberField.RingOfIntegers K) →
        Ideal (NumberField.RingOfIntegers K) → ℝ), n ≠ ⊥ →
      ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
        ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          @ite ℝ (I * J = n) (Classical.propDecidable _)
            (∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
                  (fun _ => Classical.propDecidable _)
                  (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
              ∑ M ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
                  (fun _ => Classical.propDecidable _)
                  (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
                @ite ℝ (D * M = I) (Classical.propDecidable _) (G D M J) 0) 0
        = ∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          ∑ L ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
            @ite ℝ (D * L = n) (Classical.propDecidable _)
              (∑ M ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ L)
                    (fun _ => Classical.propDecidable _)
                    (Ideal.finite_setOf_absNorm_le (Ideal.absNorm L)).toFinset),
                ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ L)
                    (fun _ => Classical.propDecidable _)
                    (Ideal.finite_setOf_absNorm_le (Ideal.absNorm L)).toFinset),
                  @ite ℝ (M * J = L) (Classical.propDecidable _) (G D M J) 0) 0 :=
by
  classical
  have key : ∀ {α : Type u} [CommMonoid α] (n : α) (S : α → Finset α)
      (_hS : ∀ X, X ∣ n → ∀ Z, Z ∈ S X ↔ Z ∣ X) (G : α → α → α → ℝ),
      ∑ I ∈ S n, ∑ J ∈ S n, @ite ℝ (I * J = n) (Classical.propDecidable _)
          (∑ D ∈ S I, ∑ M ∈ S I, @ite ℝ (D * M = I) (Classical.propDecidable _) (G D M J) 0) 0
        = ∑ D ∈ S n, ∑ L ∈ S n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (∑ M ∈ S L, ∑ J ∈ S L, @ite ℝ (M * J = L) (Classical.propDecidable _) (G D M J) 0) 0 := by
    intro α _ n S hS G
    have hnS : ∀ Z, Z ∈ S n ↔ Z ∣ n := hS n dvd_rfl
    
    have ext : ∀ I, I ∣ n → ∀ H : α → α → ℝ,
        ∑ D ∈ S I, ∑ M ∈ S I, @ite ℝ (D * M = I) (Classical.propDecidable _) (H D M) 0
          = ∑ D ∈ S n, ∑ M ∈ S n, @ite ℝ (D * M = I) (Classical.propDecidable _) (H D M) 0 := by
      intro I hI H
      have hIS := hS I hI
      have sub : S I ⊆ S n := fun Z hZ => (hnS Z).2 (dvd_trans ((hIS Z).1 hZ) hI)
      calc ∑ D ∈ S I, ∑ M ∈ S I, @ite ℝ (D * M = I) (Classical.propDecidable _) (H D M) 0
          = ∑ D ∈ S I, ∑ M ∈ S n, @ite ℝ (D * M = I) (Classical.propDecidable _) (H D M) 0 := by
            refine Finset.sum_congr rfl (fun D _ => ?_)
            refine Finset.sum_subset sub (fun M _ hM => ?_)
            rw [if_neg]
            intro h
            exact hM ((hIS M).2 (Dvd.intro_left D h))
        _ = ∑ D ∈ S n, ∑ M ∈ S n, @ite ℝ (D * M = I) (Classical.propDecidable _) (H D M) 0 := by
            refine Finset.sum_subset sub (fun D _ hD => ?_)
            refine Finset.sum_eq_zero (fun M _ => ?_)
            rw [if_neg]
            intro h
            exact hD ((hIS D).2 (Dvd.intro M h))
    
    have push : ∀ (p : Prop) (s t : Finset α) (f : α → α → ℝ),
        @ite ℝ p (Classical.propDecidable p) (∑ a ∈ s, ∑ b ∈ t, f a b) 0
          = ∑ a ∈ s, ∑ b ∈ t, @ite ℝ p (Classical.propDecidable p) (f a b) 0 := by
      intro p s t f
      by_cases hp : p
      · simp only [if_pos hp]
      · simp only [if_neg hp, Finset.sum_const_zero]
    
    have reorder : ∀ F : α → α → α → α → ℝ,
        ∑ I ∈ S n, ∑ J ∈ S n, ∑ D ∈ S n, ∑ M ∈ S n, F I J D M
          = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, ∑ I ∈ S n, F I J D M := by
      intro F
      calc ∑ I ∈ S n, ∑ J ∈ S n, ∑ D ∈ S n, ∑ M ∈ S n, F I J D M
          = ∑ J ∈ S n, ∑ I ∈ S n, ∑ D ∈ S n, ∑ M ∈ S n, F I J D M := Finset.sum_comm
        _ = ∑ J ∈ S n, ∑ D ∈ S n, ∑ I ∈ S n, ∑ M ∈ S n, F I J D M :=
            Finset.sum_congr rfl fun _ _ => Finset.sum_comm
        _ = ∑ J ∈ S n, ∑ D ∈ S n, ∑ M ∈ S n, ∑ I ∈ S n, F I J D M :=
            Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_comm
        _ = ∑ D ∈ S n, ∑ J ∈ S n, ∑ M ∈ S n, ∑ I ∈ S n, F I J D M := Finset.sum_comm
        _ = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, ∑ I ∈ S n, F I J D M :=
            Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    have reorder2 : ∀ F : α → α → α → α → ℝ,
        ∑ D ∈ S n, ∑ L ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, F D L M J
          = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, ∑ L ∈ S n, F D L M J := by
      intro F
      calc ∑ D ∈ S n, ∑ L ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, F D L M J
          = ∑ D ∈ S n, ∑ M ∈ S n, ∑ L ∈ S n, ∑ J ∈ S n, F D L M J :=
            Finset.sum_congr rfl fun _ _ => Finset.sum_comm
        _ = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, ∑ L ∈ S n, F D L M J :=
            Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    
    have colA : ∀ (A B : α) (g : ℝ),
        ∑ I ∈ S n, @ite ℝ (I * B = n) (Classical.propDecidable _)
            (@ite ℝ (A = I) (Classical.propDecidable _) g 0) 0
          = @ite ℝ (A * B = n) (Classical.propDecidable _) g 0 := by
      intro A B g
      rw [Finset.sum_eq_single A]
      · rw [if_pos (rfl : A = A)]
      · intro I _ hIA
        rw [if_neg (Ne.symm hIA), ite_self]
      · intro hA
        rw [if_neg]
        intro h
        exact hA ((hnS A).2 (Dvd.intro B h))
    have colB : ∀ (A B : α) (g : ℝ),
        ∑ L ∈ S n, @ite ℝ (B * L = n) (Classical.propDecidable _)
            (@ite ℝ (A = L) (Classical.propDecidable _) g 0) 0
          = @ite ℝ (B * A = n) (Classical.propDecidable _) g 0 := by
      intro A B g
      rw [Finset.sum_eq_single A]
      · rw [if_pos (rfl : A = A)]
      · intro L _ hLA
        rw [if_neg (Ne.symm hLA), ite_self]
      · intro hA
        rw [if_neg]
        intro h
        exact hA ((hnS A).2 (Dvd.intro_left B h))
    
    calc ∑ I ∈ S n, ∑ J ∈ S n, @ite ℝ (I * J = n) (Classical.propDecidable _)
          (∑ D ∈ S I, ∑ M ∈ S I, @ite ℝ (D * M = I) (Classical.propDecidable _) (G D M J) 0) 0
        = ∑ I ∈ S n, ∑ J ∈ S n, ∑ D ∈ S n, ∑ M ∈ S n,
            @ite ℝ (I * J = n) (Classical.propDecidable _)
              (@ite ℝ (D * M = I) (Classical.propDecidable _) (G D M J) 0) 0 := by
          refine Finset.sum_congr rfl (fun I hI => Finset.sum_congr rfl (fun J _ => ?_))
          rw [ext I ((hnS I).1 hI) (fun D M => G D M J), push]
      _ = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, ∑ I ∈ S n,
            @ite ℝ (I * J = n) (Classical.propDecidable _)
              (@ite ℝ (D * M = I) (Classical.propDecidable _) (G D M J) 0) 0 := reorder _
      _ = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n,
            @ite ℝ (D * M * J = n) (Classical.propDecidable _) (G D M J) 0 :=
          Finset.sum_congr rfl fun D _ => Finset.sum_congr rfl fun M _ =>
            Finset.sum_congr rfl fun J _ => colA (D * M) J (G D M J)
      _ = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n,
            @ite ℝ (D * (M * J) = n) (Classical.propDecidable _) (G D M J) 0 := by
          refine Finset.sum_congr rfl fun D _ => Finset.sum_congr rfl fun M _ =>
            Finset.sum_congr rfl fun J _ => ?_
          rw [mul_assoc]
      _ = ∑ D ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n, ∑ L ∈ S n,
            @ite ℝ (D * L = n) (Classical.propDecidable _)
              (@ite ℝ (M * J = L) (Classical.propDecidable _) (G D M J) 0) 0 :=
          Finset.sum_congr rfl fun D _ => Finset.sum_congr rfl fun M _ =>
            Finset.sum_congr rfl fun J _ => (colB (M * J) D (G D M J)).symm
      _ = ∑ D ∈ S n, ∑ L ∈ S n, ∑ M ∈ S n, ∑ J ∈ S n,
            @ite ℝ (D * L = n) (Classical.propDecidable _)
              (@ite ℝ (M * J = L) (Classical.propDecidable _) (G D M J) 0) 0 := (reorder2 _).symm
      _ = ∑ D ∈ S n, ∑ L ∈ S n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (∑ M ∈ S L, ∑ J ∈ S L, @ite ℝ (M * J = L) (Classical.propDecidable _) (G D M J) 0) 0 := by
          refine Finset.sum_congr rfl (fun D _ => Finset.sum_congr rfl (fun L hL => ?_))
          rw [ext L ((hnS L).1 hL) (fun M J => G D M J), push]
  intro n G hn
  refine key n (fun X => @Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ X)
      (fun _ => Classical.propDecidable _)
      (Ideal.finite_setOf_absNorm_le (Ideal.absNorm X)).toFinset) ?_ G
  intro X hX Z
  have hX0 : X ≠ ⊥ := by
    rintro rfl
    exact hn (le_bot_iff.mp (Ideal.dvd_iff_le.mp hX))
  simp only [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  constructor
  · exact fun h => h.2
  · intro hZ
    refine ⟨Nat.le_of_dvd ?_ (Ideal.absNorm_dvd_absNorm_of_le (Ideal.dvd_iff_le.mp hZ)), hZ⟩
    exact Nat.pos_of_ne_zero (fun h0 => hX0 (Ideal.absNorm_eq_zero_iff.mp h0))

theorem ideal_sum_transfer (K : Type u) [Field K] [NumberField K]
    (x : NumberField.RingOfIntegers K) (hx : x ≠ 0) :
    (∀ (Y : ℕ) (f : Ideal (NumberField.RingOfIntegers K) → ℝ),
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset,
          @ite ℝ (x ∈ I) (Classical.propDecidable _) (f I) 0
        = ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
            @ite ℝ (Ideal.absNorm I ≤ Y) (Classical.propDecidable _) (f I) 0) ∧
    (∀ (X : ℕ) (F : Ideal (NumberField.RingOfIntegers K) →
          Ideal (NumberField.RingOfIntegers K) → ℝ),
      (Algebra.norm ℤ x).natAbs ≤ X →
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
        ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
          @ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (F I J) 0
        = ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
          ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
            @ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (F I J) 0) :=
by
  classical
  have hn : Ideal.span {x} ≠ (⊥ : Ideal (NumberField.RingOfIntegers K)) := by
    rw [Ne, Ideal.span_singleton_eq_bot]; exact hx
  have hNpos : 0 < Ideal.absNorm (Ideal.span {x}) :=
    Nat.pos_of_ne_zero (fun h => hn (Ideal.absNorm_eq_zero_iff.mp h))
  have hmemD : ∀ Z : Ideal (NumberField.RingOfIntegers K),
      Z ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset)
        ↔ Z ∣ Ideal.span {x} := by
    intro Z
    rw [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
    constructor
    · exact fun h => h.2
    · intro h
      exact ⟨Nat.le_of_dvd hNpos (Ideal.absNorm_dvd_absNorm_of_le (Ideal.dvd_iff_le.mp h)), h⟩
  have hmemS : ∀ (Y : ℕ) (Z : Ideal (NumberField.RingOfIntegers K)),
      Z ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset
        ↔ Ideal.absNorm Z ≤ Y := by
    intro Y Z
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  refine ⟨fun Y f => ?_, fun X F hxX => ?_⟩
  · have h1 : ∀ (s : Finset (Ideal (NumberField.RingOfIntegers K)))
        (p : Ideal (NumberField.RingOfIntegers K) → Prop),
        (∑ I ∈ s, @ite ℝ (p I) (Classical.propDecidable _) (f I) 0)
          = ∑ I ∈ @Finset.filter _ p (fun _ => Classical.propDecidable _) s, f I := by
      intro s p
      rw [Finset.sum_filter]
    refine (h1 _ (fun I => x ∈ I)).trans
      (Eq.trans ?_ (h1 _ (fun I => Ideal.absNorm I ≤ Y)).symm)
    have hmf : ∀ (s : Finset (Ideal (NumberField.RingOfIntegers K)))
        (p : Ideal (NumberField.RingOfIntegers K) → Prop) (a : Ideal (NumberField.RingOfIntegers K)),
        a ∈ @Finset.filter _ p (fun _ => Classical.propDecidable _) s ↔ a ∈ s ∧ p a :=
      fun s p a => Finset.mem_filter
    apply Finset.sum_congr _ (fun _ _ => rfl)
    ext I
    rw [hmf, hmf, hmemS, hmemD, Ideal.dvd_span_singleton]
    tauto
  · have hsub : (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset)
        ⊆ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset := by
      intro I hI
      rw [hmemS]
      rw [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq,
        Ideal.absNorm_span_singleton] at hI
      exact hI.1.trans hxX
    symm
    have hout := Finset.sum_subset hsub (f := fun I =>
      ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
            @ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (F I J) 0) (by
      intro I _ hI
      apply Finset.sum_eq_zero
      intro J _
      rw [if_neg]
      intro hIJ
      exact hI ((hmemD I).mpr (Dvd.intro J hIJ)))
    rw [hout]
    apply Finset.sum_congr rfl
    intro I _
    apply Finset.sum_subset hsub
    intro J _ hJ
    rw [if_neg]
    intro hIJ
    exact hJ ((hmemD J).mpr (Dvd.intro_left I hIJ))

theorem ideal_vaughan_algebra (K : Type u) [Field K] [NumberField K]
    (μ Λ' β a b : Ideal (NumberField.RingOfIntegers K) → ℝ) (U V : ℕ) (hU : 1 ≤ U)
    (hμ : ∀ k : Ideal (NumberField.RingOfIntegers K), k ≠ ⊥ →
        ∑ d ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ k)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm k)).toFinset), μ d
          = @ite ℝ (k = ⊤) (Classical.propDecidable _) 1 0)
    (hΛ : ∀ k : Ideal (NumberField.RingOfIntegers K), k ≠ ⊥ →
        ∑ m ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ k)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm k)).toFinset), Λ' m
          = Real.log (Ideal.absNorm k : ℝ))
    (hdiv :
      (∀ n Z : Ideal (NumberField.RingOfIntegers K), n ≠ ⊥ →
        (Z ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z' => Z' ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset) ↔ Z ∣ n)) ∧
      (∀ (n : Ideal (NumberField.RingOfIntegers K))
          (F : Ideal (NumberField.RingOfIntegers K) → ℝ), n ≠ ⊥ →
        ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
            @ite ℝ (I * J = n) (Classical.propDecidable _) (F I) 0
          = ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset), F I) ∧
      (∀ (n : Ideal (NumberField.RingOfIntegers K))
          (F : Ideal (NumberField.RingOfIntegers K) → ℝ), n ≠ ⊥ →
        ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
            @ite ℝ (I * J = n) (Classical.propDecidable _) (F J) 0
          = ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset), F J))
    (hassoc :
      ∀ (n : Ideal (NumberField.RingOfIntegers K))
        (G : Ideal (NumberField.RingOfIntegers K) → Ideal (NumberField.RingOfIntegers K) →
          Ideal (NumberField.RingOfIntegers K) → ℝ), n ≠ ⊥ →
        ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
            @ite ℝ (I * J = n) (Classical.propDecidable _)
              (∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
                    (fun _ => Classical.propDecidable _)
                    (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
                ∑ M ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
                    (fun _ => Classical.propDecidable _)
                    (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
                  @ite ℝ (D * M = I) (Classical.propDecidable _) (G D M J) 0) 0
          = ∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
            ∑ L ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
                (fun _ => Classical.propDecidable _)
                (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
              @ite ℝ (D * L = n) (Classical.propDecidable _)
                (∑ M ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ L)
                      (fun _ => Classical.propDecidable _)
                      (Ideal.finite_setOf_absNorm_le (Ideal.absNorm L)).toFinset),
                  ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ L)
                      (fun _ => Classical.propDecidable _)
                      (Ideal.finite_setOf_absNorm_le (Ideal.absNorm L)).toFinset),
                    @ite ℝ (M * J = L) (Classical.propDecidable _) (G D M J) 0) 0)
    (hβ : ∀ I : Ideal (NumberField.RingOfIntegers K), β I =
        ∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
          ∑ M ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
            @ite ℝ (D * M = I) (Classical.propDecidable _)
              (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
                * @ite ℝ (Ideal.absNorm M ≤ V) (Classical.propDecidable _) (Λ' M) 0) 0)
    (ha : ∀ I : Ideal (NumberField.RingOfIntegers K),
        a I = @ite ℝ (Ideal.absNorm I ≤ V) (Classical.propDecidable _) 0 (Λ' I))
    (hb : ∀ J : Ideal (NumberField.RingOfIntegers K),
        b J = @ite ℝ (Ideal.absNorm J ≤ U) (Classical.propDecidable _) 0
          (-∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ J)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm J)).toFinset),
             @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0))
    (n : Ideal (NumberField.RingOfIntegers K)) (hn : n ≠ ⊥) :
    @ite ℝ (V < Ideal.absNorm n) (Classical.propDecidable _) (Λ' n) 0
      = ∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _)
            (μ D * (Real.log (Ideal.absNorm n : ℝ) - Real.log (Ideal.absNorm D : ℝ))) 0
        - ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          @ite ℝ (Ideal.absNorm I ≤ U * V) (Classical.propDecidable _) (β I) 0
        + ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
          ∑ J ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ n)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm n)).toFinset),
            @ite ℝ (I * J = n) (Classical.propDecidable _) (a I * b J) 0 :=
by
  obtain ⟨DV, hDV⟩ : ∃ DV : Ideal (NumberField.RingOfIntegers K) →
      Finset (Ideal (NumberField.RingOfIntegers K)),
      ∀ X, DV X = (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ X)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm X)).toFinset) := ⟨_, fun _ => rfl⟩
  simp only [← hDV] at hμ hΛ hdiv hassoc hβ hb ⊢
  have hmem : ∀ X Z, Z ∈ DV X ↔ Ideal.absNorm Z ≤ Ideal.absNorm X ∧ Z ∣ X := by
    intro X Z
    rw [hDV]
    simp only [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  have hne : ∀ D L : Ideal (NumberField.RingOfIntegers K), D * L = n → L ≠ ⊥ := by
    intro D L h hL
    apply hn
    rw [← h, hL, Ideal.mul_bot]
  have hnorm_ne : Ideal.absNorm n ≠ 0 := by
    rw [Ne, Ideal.absNorm_eq_zero_iff]
    exact hn
  
  have hs1 : ∀ f g : Ideal (NumberField.RingOfIntegers K) → ℝ,
      ∑ I ∈ DV n, ∑ D ∈ DV I, ∑ M ∈ DV I,
          @ite ℝ (D * M = I) (Classical.propDecidable _) (f D * g M) 0
        = ∑ D ∈ DV n, ∑ L ∈ DV n,
          @ite ℝ (D * L = n) (Classical.propDecidable _) (f D * ∑ M ∈ DV L, g M) 0 := by
    intro f g
    have h1 := hassoc n (fun D M _ => f D * g M) hn
    have h2 := hdiv.2.1 n (fun I => ∑ D ∈ DV I, ∑ M ∈ DV I,
      @ite ℝ (D * M = I) (Classical.propDecidable _) (f D * g M) 0) hn
    beta_reduce at h1 h2
    rw [← h2, h1]
    refine Finset.sum_congr rfl (fun D _ => Finset.sum_congr rfl (fun L _ => ?_))
    by_cases hDL : D * L = n
    · rw [if_pos hDL, if_pos hDL, Finset.mul_sum]
      have h3 := hdiv.2.1 L (fun M => f D * g M) (hne D L hDL)
      beta_reduce at h3
      exact h3
    · rw [if_neg hDL, if_neg hDL]
  
  have hA : ∑ D ∈ DV n, @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _)
            (μ D * (Real.log (Ideal.absNorm n : ℝ) - Real.log (Ideal.absNorm D : ℝ))) 0
      = ∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
            * ∑ M ∈ DV L, Λ' M) 0 := by
    have h2 := hdiv.2.1 n (fun D => @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _)
            (μ D * (Real.log (Ideal.absNorm n : ℝ) - Real.log (Ideal.absNorm D : ℝ))) 0) hn
    beta_reduce at h2
    rw [← h2]
    refine Finset.sum_congr rfl (fun D _ => Finset.sum_congr rfl (fun L _ => ?_))
    by_cases hDL : D * L = n
    · rw [if_pos hDL, if_pos hDL, hΛ L (hne D L hDL)]
      have hN : Ideal.absNorm n = Ideal.absNorm D * Ideal.absNorm L := by
        rw [← hDL, map_mul]
      have hD0 : (Ideal.absNorm D : ℝ) ≠ 0 := by
        have : Ideal.absNorm D ≠ 0 := fun h => hnorm_ne (by rw [hN, h, zero_mul])
        exact_mod_cast this
      have hL0 : (Ideal.absNorm L : ℝ) ≠ 0 := by
        have : Ideal.absNorm L ≠ 0 := fun h => hnorm_ne (by rw [hN, h, mul_zero])
        exact_mod_cast this
      have hlog : Real.log (Ideal.absNorm n : ℝ) - Real.log (Ideal.absNorm D : ℝ)
          = Real.log (Ideal.absNorm L : ℝ) := by
        rw [hN, Nat.cast_mul, Real.log_mul hD0 hL0]
        ring
      rw [hlog]
      by_cases hDU : Ideal.absNorm D ≤ U
      · rw [if_pos hDU, if_pos hDU]
      · rw [if_neg hDU, if_neg hDU, zero_mul]
    · rw [if_neg hDL, if_neg hDL]
  
  have hB : ∑ I ∈ DV n, @ite ℝ (Ideal.absNorm I ≤ U * V) (Classical.propDecidable _) (β I) 0
      = ∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0 *
            ∑ M ∈ DV L, @ite ℝ (Ideal.absNorm M ≤ V) (Classical.propDecidable _) (Λ' M) 0) 0 := by
    have h := hs1 (fun D => @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0)
      (fun M => @ite ℝ (Ideal.absNorm M ≤ V) (Classical.propDecidable _) (Λ' M) 0)
    beta_reduce at h
    rw [← h]
    refine Finset.sum_congr rfl (fun I _ => ?_)
    rw [hβ I]
    by_cases hI : Ideal.absNorm I ≤ U * V
    · rw [if_pos hI]
    · rw [if_neg hI]
      symm
      refine Finset.sum_eq_zero (fun D _ => Finset.sum_eq_zero (fun M _ => ?_))
      by_cases hDM : D * M = I
      · rw [if_pos hDM]
        by_cases hDU : Ideal.absNorm D ≤ U
        · by_cases hMV : Ideal.absNorm M ≤ V
          · exfalso
            apply hI
            rw [← hDM, map_mul]
            exact Nat.mul_le_mul hDU hMV
          · rw [if_neg hMV, mul_zero]
        · rw [if_neg hDU, zero_mul]
      · rw [if_neg hDM]
  
  have hC : (∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
            * ∑ M ∈ DV L, Λ' M) 0)
      - (∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0 *
            ∑ M ∈ DV L, @ite ℝ (Ideal.absNorm M ≤ V) (Classical.propDecidable _) (Λ' M) 0) 0)
      = ∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
            * ∑ M ∈ DV L, a M) 0 := by
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun D _ => ?_)
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun L _ => ?_)
    by_cases hDL : D * L = n
    · simp only [if_pos hDL]
      rw [← mul_sub, ← Finset.sum_sub_distrib]
      congr 1
      refine Finset.sum_congr rfl (fun M _ => ?_)
      rw [ha M]
      by_cases hMV : Ideal.absNorm M ≤ V
      · rw [if_pos hMV, if_pos hMV, sub_self]
      · rw [if_neg hMV, if_neg hMV, sub_zero]
    · simp only [if_neg hDL, sub_self]
  
  have hD : ∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
            * ∑ M ∈ DV L, a M) 0
      = ∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (a D * ∑ M ∈ DV L, @ite ℝ (Ideal.absNorm M ≤ U) (Classical.propDecidable _) (μ M) 0)
            0 := by
    have h1 := hs1 (fun D => @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0) a
    have h2 := hs1 a (fun D => @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0)
    beta_reduce at h1 h2
    rw [← h1, ← h2]
    refine Finset.sum_congr rfl (fun I _ => ?_)
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun D _ => Finset.sum_congr rfl (fun M _ => ?_))
    rw [mul_comm M D, mul_comm (a D)]
  
  have hE : ∑ I ∈ DV n, ∑ J ∈ DV n, @ite ℝ (I * J = n) (Classical.propDecidable _) (a I * b J) 0
      = a n - ∑ D ∈ DV n, ∑ L ∈ DV n, @ite ℝ (D * L = n) (Classical.propDecidable _)
          (a D * ∑ M ∈ DV L, @ite ℝ (Ideal.absNorm M ≤ U) (Classical.propDecidable _) (μ M) 0)
            0 := by
    have hdelta : ∑ I ∈ DV n, ∑ J ∈ DV n, @ite ℝ (I * J = n) (Classical.propDecidable _)
        (a I * @ite ℝ (J = ⊤) (Classical.propDecidable _) 1 0) 0 = a n := by
      have htop : (⊤ : Ideal (NumberField.RingOfIntegers K)) ∈ DV n := by
        rw [hmem]
        refine ⟨?_, ?_⟩
        · rw [Ideal.absNorm_top]
          exact Nat.one_le_iff_ne_zero.mpr hnorm_ne
        · exact Ideal.dvd_iff_le.mpr le_top
      have hnn : n ∈ DV n := (hmem n n).mpr ⟨le_refl _, dvd_refl n⟩
      rw [Finset.sum_eq_single_of_mem n hnn]
      · rw [Finset.sum_eq_single_of_mem ⊤ htop]
        · rw [Ideal.mul_top, if_pos rfl, if_pos rfl, mul_one]
        · intro J _ hJ
          rw [if_neg hJ, mul_zero, ite_self]
      · intro I _ hI
        refine Finset.sum_eq_zero (fun J _ => ?_)
        by_cases hJ : J = ⊤
        · rw [hJ, Ideal.mul_top, if_neg hI]
        · rw [if_neg hJ, mul_zero, ite_self]
    rw [← hdelta, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun I _ => ?_)
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun J hJ => ?_)
    have hJ0 : J ≠ ⊥ := by
      intro h0
      have hdvd := ((hmem n J).mp hJ).2
      rw [h0] at hdvd
      exact hn (le_bot_iff.mp (Ideal.dvd_iff_le.mp hdvd))
    have hbJ : b J = @ite ℝ (J = ⊤) (Classical.propDecidable _) 1 0
        - ∑ D ∈ DV J, @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0 := by
      rw [hb J]
      by_cases hJU : Ideal.absNorm J ≤ U
      · rw [if_pos hJU]
        have hsum : ∑ D ∈ DV J, @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
            = ∑ D ∈ DV J, μ D := by
          refine Finset.sum_congr rfl (fun D hD => ?_)
          rw [if_pos (le_trans ((hmem J D).mp hD).1 hJU)]
        rw [hsum, hμ J hJ0, sub_self]
      · rw [if_neg hJU]
        have hJT : J ≠ ⊤ := by
          intro hT
          apply hJU
          rw [hT, Ideal.absNorm_top]
          exact hU
        rw [if_neg hJT, zero_sub]
    rw [hbJ]
    by_cases hIJ : I * J = n
    · simp only [if_pos hIJ]
      ring
    · simp only [if_neg hIJ, sub_self]
  have hL : @ite ℝ (V < Ideal.absNorm n) (Classical.propDecidable _) (Λ' n) 0 = a n := by
    rw [ha n]
    by_cases h : Ideal.absNorm n ≤ V
    · rw [if_neg (not_lt.2 h), if_pos h]
    · rw [if_pos (not_le.1 h), if_neg h]
  rw [hL, hA, hB, hE]
  linarith [hC, hD]

theorem kai_vonMangoldt_vaughan_decomp (K : Type u) [Field K] [NumberField K]
    (U V X : ℕ) (hU : 1 ≤ U) (hV : 1 ≤ V) :
    ∃ (α β a b : Ideal (NumberField.RingOfIntegers K) → ℝ),
      (∀ I, |α I| ≤ 1) ∧ (∀ I, U < Ideal.absNorm I → α I = 0) ∧
      (∀ I, |β I| ≤ Real.log ((U : ℝ) * (V : ℝ))) ∧
      (∀ I, 0 ≤ a I ∧ a I ≤ Real.log (Ideal.absNorm I : ℝ)) ∧
      (∀ I, Ideal.absNorm I ≤ V → a I = 0) ∧
      (∀ I, Ideal.absNorm I ≤ U → b I = 0) ∧
      (∀ I, |b I| ≤ ((@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun J => J ∣ I)
          (fun _ => Classical.propDecidable _)
          (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset).card : ℝ)) ∧
      ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → (Algebra.norm ℤ x).natAbs ≤ X →
        vonMangoldtO x =
          @ite ℝ ((Algebra.norm ℤ x).natAbs ≤ V) (Classical.propDecidable _) (vonMangoldtO x) 0
          + ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) U).toFinset,
              @ite ℝ (x ∈ I) (Classical.propDecidable _)
                (α I * (Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
                  - Real.log (Ideal.absNorm I : ℝ))) 0
          - ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) (U * V)).toFinset,
              @ite ℝ (x ∈ I) (Classical.propDecidable _) (β I) 0
          + ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
              ∑ J ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X).toFinset,
                @ite ℝ (I * J = Ideal.span {x}) (Classical.propDecidable _) (a I * b J) 0 :=
by
  obtain ⟨μ, hμ1, hμ⟩ := ideal_moebius_exists K
  obtain ⟨Λ', hΛx, hΛb, hΛ⟩ := ideal_vonMangoldt_divisor_sum K
  have hdiv := ideal_divisor_pair_sum K
  have hassoc := ideal_divisor_assoc K
  obtain ⟨α, hα⟩ : ∃ f : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ I, f I =
      @ite ℝ (Ideal.absNorm I ≤ U) (Classical.propDecidable _) (μ I) 0 := ⟨_, fun _ => rfl⟩
  obtain ⟨β₀, hβ₀⟩ : ∃ f : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ I, f I =
      ∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
          ∑ M ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ I)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset),
            @ite ℝ (D * M = I) (Classical.propDecidable _)
              (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
                * @ite ℝ (Ideal.absNorm M ≤ V) (Classical.propDecidable _) (Λ' M) 0) 0 :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨β, hβ⟩ : ∃ f : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ I, f I =
      @ite ℝ (I ≠ ⊥ ∧ Ideal.absNorm I ≤ U * V) (Classical.propDecidable _) (β₀ I) 0 :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨a, ha⟩ : ∃ f : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ I, f I =
      @ite ℝ (Ideal.absNorm I ≤ V) (Classical.propDecidable _) 0 (Λ' I) := ⟨_, fun _ => rfl⟩
  obtain ⟨b, hb⟩ : ∃ f : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ J, f J =
      @ite ℝ (Ideal.absNorm J ≤ U) (Classical.propDecidable _) 0
        (-∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun Z => Z ∣ J)
            (fun _ => Classical.propDecidable _)
            (Ideal.finite_setOf_absNorm_le (Ideal.absNorm J)).toFinset),
           @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0) :=
    ⟨_, fun _ => rfl⟩
  have hμU : ∀ D : Ideal (NumberField.RingOfIntegers K),
      |@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0| ≤ 1 := by
    intro D
    split_ifs
    · exact hμ1 D
    · simp
  refine ⟨α, β, a, b, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro I
    rw [hα I]
    exact hμU I
  · intro I hI
    rw [hα I, if_neg (not_le.2 hI)]
  · intro I
    have hUV1 : (1:ℝ) ≤ (U:ℝ) * (V:ℝ) := by
      have h1 : (1:ℝ) ≤ U := by exact_mod_cast hU
      have h2 : (1:ℝ) ≤ V := by exact_mod_cast hV
      nlinarith
    rw [hβ I]
    split_ifs with h
    · obtain ⟨hI0, hIUV⟩ := h
      have hNpos : (0:ℝ) < (Ideal.absNorm I : ℝ) := by
        have : Ideal.absNorm I ≠ 0 := fun h0 => hI0 (Ideal.absNorm_eq_zero_iff.mp h0)
        exact_mod_cast Nat.pos_of_ne_zero this
      have hNle : (Ideal.absNorm I : ℝ) ≤ (U:ℝ) * (V:ℝ) := by exact_mod_cast hIUV
      have hterm : ∀ D M : Ideal (NumberField.RingOfIntegers K),
          |@ite ℝ (D * M = I) (Classical.propDecidable _)
              (@ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _) (μ D) 0
                * @ite ℝ (Ideal.absNorm M ≤ V) (Classical.propDecidable _) (Λ' M) 0) 0|
            ≤ @ite ℝ (D * M = I) (Classical.propDecidable _) (Λ' M) 0 := by
        intro D M
        have h2 : |@ite ℝ (Ideal.absNorm M ≤ V) (Classical.propDecidable _) (Λ' M) 0|
            ≤ Λ' M := by
          split_ifs
          · rw [abs_of_nonneg (hΛb M).1]
          · simp [(hΛb M).1]
        by_cases hDM : D * M = I
        · rw [if_pos hDM, if_pos hDM, abs_mul]
          calc _ ≤ 1 * Λ' M := mul_le_mul (hμU D) h2 (abs_nonneg _) zero_le_one
            _ = Λ' M := one_mul _
        · rw [if_neg hDM, if_neg hDM, abs_zero]
      rw [hβ₀ I]
      refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
      refine le_trans (Finset.sum_le_sum (fun D _ => le_trans (Finset.abs_sum_le_sum_abs _ _)
        (Finset.sum_le_sum (fun M _ => hterm D M)))) ?_
      rw [hdiv.2.2 I Λ' hI0, hΛ I hI0]
      exact Real.log_le_log hNpos hNle
    · rw [abs_zero]
      exact Real.log_nonneg hUV1
  · intro I
    rw [ha I]
    split_ifs
    · exact ⟨le_rfl, Real.log_natCast_nonneg _⟩
    · exact hΛb I
  · intro I hI
    rw [ha I, if_pos hI]
  · intro I hI
    rw [hb I, if_pos hI]
  · intro I
    rw [hb I]
    split_ifs with h
    · rw [abs_zero]
      exact Nat.cast_nonneg _
    · rw [abs_neg]
      refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
      refine le_trans (Finset.sum_le_sum (fun D _ => hμU D)) ?_
      simp
  · intro x hx hxX
    have hn : Ideal.span {x} ≠ (⊥ : Ideal (NumberField.RingOfIntegers K)) := by
      rw [Ne, Ideal.span_singleton_eq_bot]
      exact hx
    have hNn : Ideal.absNorm (Ideal.span {x}) = (Algebra.norm ℤ x).natAbs :=
      Ideal.absNorm_span_singleton x
    have tr := ideal_sum_transfer K x hx
    rw [tr.1 U (fun I => α I * (Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
                  - Real.log (Ideal.absNorm I : ℝ))),
      tr.1 (U * V) β, tr.2 X (fun I J => a I * b J) hxX]
    rw [← hNn, hΛx x]
    have h6 := ideal_vaughan_algebra K μ Λ' β₀ a b U V hU hμ hΛ hdiv hassoc hβ₀ ha hb
      (Ideal.span {x}) hn
    have hT2 : ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
            @ite ℝ (Ideal.absNorm I ≤ U) (Classical.propDecidable _)
              (α I * (Real.log (Ideal.absNorm (Ideal.span {x}) : ℝ)
                - Real.log (Ideal.absNorm I : ℝ))) 0
        = ∑ D ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
            @ite ℝ (Ideal.absNorm D ≤ U) (Classical.propDecidable _)
              (μ D * (Real.log (Ideal.absNorm (Ideal.span {x}) : ℝ)
                - Real.log (Ideal.absNorm D : ℝ))) 0 := by
      refine Finset.sum_congr rfl (fun I _ => ?_)
      by_cases h : Ideal.absNorm I ≤ U
      · rw [if_pos h, if_pos h, hα I, if_pos h]
      · rw [if_neg h, if_neg h]
    have hT3 : ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
            @ite ℝ (Ideal.absNorm I ≤ U * V) (Classical.propDecidable _) (β I) 0
        = ∑ I ∈ (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
              (fun Z => Z ∣ Ideal.span {x}) (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm (Ideal.span {x}))).toFinset),
            @ite ℝ (Ideal.absNorm I ≤ U * V) (Classical.propDecidable _) (β₀ I) 0 := by
      refine Finset.sum_congr rfl (fun I hI => ?_)
      have hI0 : I ≠ ⊥ := by
        intro hI0
        have hdvd := (hdiv.1 _ I hn).mp hI
        rw [hI0] at hdvd
        exact hn (le_bot_iff.mp (Ideal.dvd_iff_le.mp hdvd))
      by_cases h : Ideal.absNorm I ≤ U * V
      · rw [if_pos h, if_pos h, hβ I, if_pos ⟨hI0, h⟩]
      · rw [if_neg h, if_neg h]
    rw [hT2, hT3]
    by_cases hv : Ideal.absNorm (Ideal.span {x}) ≤ V
    · rw [if_neg (not_lt.2 hv)] at h6
      rw [if_pos hv]
      linarith
    · rw [if_pos (not_le.1 hv)] at h6
      rw [if_neg hv]
      linarith

theorem kai_ideal_count_divisor_moment (K : Type u) [Field K] [NumberField K] :
    ∃ Cd : ℝ, 1 ≤ Cd ∧ ∀ Y : ℕ, 1 ≤ Y →
      (((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset.card : ℝ)
          ≤ Cd * (Y : ℝ)) ∧
      ∑ I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset,
          (((@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun J => J ∣ I)
              (fun _ => Classical.propDecidable _)
              (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset).card : ℝ)) ^ 2
        ≤ Cd * (Y : ℝ) * (1 + Real.log (Y : ℝ)) ^ 3 :=
by
  classical
  have memF : ∀ (n : ℕ) (I : Ideal (NumberField.RingOfIntegers K)),
      I ∈ (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset ↔
        Ideal.absNorm I ≤ n := by
    intro n I
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  have normpos : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ ⊥ → 0 < Ideal.absNorm I := by
    intro I hI
    exact Nat.pos_of_ne_zero (fun h => hI (Ideal.absNorm_eq_zero_iff.mp h))
  
  obtain ⟨C₁, hC₁1, hC⟩ : ∃ C₁ : ℝ, 1 ≤ C₁ ∧ ∀ Y : ℕ, 1 ≤ Y →
      ((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset.card : ℝ)
        ≤ C₁ * (Y : ℝ) := by
    obtain ⟨ρ, ht⟩ : ∃ ρ : ℝ, Filter.Tendsto (fun s : ℝ =>
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm I : ℝ) ≤ s} : ℝ) / s)
        Filter.atTop (nhds ρ) := ⟨_, NumberField.Ideal.tendsto_norm_le_div_atTop K⟩
    obtain ⟨s₀, hs₀⟩ := Filter.eventually_atTop.mp (ht.eventually (gt_mem_nhds (lt_add_one ρ)))
    have hcard : ∀ n : ℕ,
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm I : ℝ) ≤ (n : ℝ)})
          = (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset.card := by
      intro n
      rw [← Nat.card_eq_card_finite_toFinset]
      exact Nat.card_congr (Equiv.subtypeEquivRight (fun I => by
        simp only [Set.mem_setOf_eq, Nat.cast_le]))
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M =
        ((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) ⌈s₀⌉₊).toFinset.card : ℝ) :=
      ⟨_, rfl⟩
    refine ⟨max (max (ρ + 1) M) 1, le_max_right _ _, ?_⟩
    intro Y hY
    have hYpos : (0 : ℝ) < Y := by exact_mod_cast hY
    have hY1 : (1 : ℝ) ≤ Y := by exact_mod_cast hY
    have hmax0 : 0 ≤ max (max (ρ + 1) M) 1 := le_trans zero_le_one (le_max_right _ _)
    by_cases hYs : s₀ ≤ (Y : ℝ)
    · have h1 : (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm I : ℝ) ≤ (Y : ℝ)} : ℝ) / Y < ρ + 1 := hs₀ Y hYs
      rw [hcard Y, div_lt_iff₀ hYpos] at h1
      have h2 : ρ + 1 ≤ max (max (ρ + 1) M) 1 := le_trans (le_max_left _ _) (le_max_left _ _)
      nlinarith
    · push_neg at hYs
      have hYn : Y ≤ ⌈s₀⌉₊ := by
        have := Nat.le_ceil s₀
        exact_mod_cast (le_of_lt (lt_of_lt_of_le hYs this))
      have hsub : (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset ⊆
          (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) ⌈s₀⌉₊).toFinset := by
        intro I hI
        rw [memF] at hI ⊢
        exact le_trans hI hYn
      have h1 : ((Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) Y).toFinset.card : ℝ)
          ≤ M := by
        rw [hM]; exact_mod_cast Finset.card_le_card hsub
      have h2 : M ≤ max (max (ρ + 1) M) 1 := le_trans (le_max_right _ _) (le_max_left _ _)
      nlinarith
  have hC0 : 0 ≤ C₁ := by linarith
  
  obtain ⟨P, memP⟩ : ∃ P : ℕ → Finset (Ideal (NumberField.RingOfIntegers K)),
      ∀ n I, I ∈ P n ↔ I ≠ ⊥ ∧ Ideal.absNorm I ≤ n :=
    ⟨fun n => (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset.filter
      (fun I => I ≠ ⊥), fun n I => by rw [Finset.mem_filter, memF]; exact And.comm⟩
  have hFP : ∀ n : ℕ, (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) n).toFinset
      = insert ⊥ (P n) := by
    intro n; ext I
    rw [Finset.mem_insert, memF, memP]
    constructor
    · intro h
      by_cases hI : I = ⊥
      · exact Or.inl hI
      · exact Or.inr ⟨hI, h⟩
    · rintro (h | h)
      · rw [h, Ideal.absNorm_bot]; exact Nat.zero_le _
      · exact h.2
  have botP : ∀ n, (⊥ : Ideal (NumberField.RingOfIntegers K)) ∉ P n :=
    fun n h => ((memP n ⊥).mp h).1 rfl
  have hP0 : P 0 = ∅ := by
    by_contra hne
    obtain ⟨I, hI⟩ := Finset.nonempty_iff_ne_empty.mpr hne
    obtain ⟨h1, h2⟩ := (memP 0 I).mp hI
    have := normpos I h1
    omega
  have hA : ∀ n : ℕ, ((P n).card : ℝ) ≤ C₁ * n := by
    intro n
    rcases Nat.eq_zero_or_pos n with h0 | hn
    · subst h0
      rw [hP0]; simp
    · have h1 := hC n hn
      rw [hFP, Finset.card_insert_of_notMem (botP n)] at h1
      push_cast at h1
      linarith
  
  have hS : ∀ n : ℕ, (∑ I ∈ P n, 1 / (Ideal.absNorm I : ℝ)) - ((P n).card : ℝ) / ((n : ℝ) + 1)
      ≤ C₁ * (((harmonic (n + 1) : ℚ) : ℝ) - 1) := by
    intro n
    induction n with
    | zero =>
      rw [hP0]; norm_num [harmonic]
    | succ n ih =>
      have hsplit := Finset.sum_filter_add_sum_filter_not (P (n + 1))
        (fun I => Ideal.absNorm I ≤ n) (fun I => 1 / (Ideal.absNorm I : ℝ))
      have hcsplit := Finset.card_filter_add_card_filter_not (s := P (n + 1))
        (fun I => Ideal.absNorm I ≤ n)
      beta_reduce at hsplit hcsplit
      have hlow : (P (n + 1)).filter (fun I => Ideal.absNorm I ≤ n) = P n := by
        ext I
        rw [Finset.mem_filter, memP, memP]
        constructor
        · rintro ⟨⟨h0, _⟩, h⟩; exact ⟨h0, h⟩
        · rintro ⟨h0, h⟩; exact ⟨⟨h0, by omega⟩, h⟩
      have hhigh : ∀ I ∈ (P (n + 1)).filter (fun I => ¬ Ideal.absNorm I ≤ n),
          1 / (Ideal.absNorm I : ℝ) = 1 / ((n : ℝ) + 1) := by
        intro I hI
        rw [Finset.mem_filter, memP] at hI
        have : Ideal.absNorm I = n + 1 := by omega
        rw [this]; push_cast; ring
      rw [hlow, Finset.sum_congr rfl hhigh, Finset.sum_const, nsmul_eq_mul] at hsplit
      rw [hlow] at hcsplit
      have hA' := hA (n + 1)
      rw [← hcsplit] at hA'
      push_cast at hA'
      rw [← hsplit, ← hcsplit, harmonic_succ]
      push_cast
      generalize (((P (n + 1)).filter (fun I => ¬ Ideal.absNorm I ≤ n)).card : ℝ) = e at *
      generalize ((P n).card : ℝ) = a at *
      generalize (∑ I ∈ P n, 1 / (Ideal.absNorm I : ℝ)) = s at *
      generalize (((harmonic (n + 1) : ℚ) : ℝ)) = H at *
      have hx : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      have key : e * (1 / ((n : ℝ) + 1)) + a / ((n : ℝ) + 1) - (a + e) / ((n : ℝ) + 1 + 1)
          ≤ C₁ * ((n : ℝ) + 1 + 1)⁻¹ := by
        have h1 : e * (1 / ((n : ℝ) + 1)) + a / ((n : ℝ) + 1) - (a + e) / ((n : ℝ) + 1 + 1)
            = (a + e) / (((n : ℝ) + 1) * ((n : ℝ) + 1 + 1)) := by
          field_simp
          ring
        rw [h1, div_le_iff₀ (by positivity)]
        have h2 : C₁ * ((n : ℝ) + 1 + 1)⁻¹ * (((n : ℝ) + 1) * ((n : ℝ) + 1 + 1))
            = C₁ * ((n : ℝ) + 1) := by
          field_simp
        rw [h2]; linarith
      linarith
  have hSb : ∀ Y : ℕ, 1 ≤ Y →
      ∑ I ∈ P Y, 1 / (Ideal.absNorm I : ℝ) ≤ 2 * C₁ * (1 + Real.log (Y : ℝ)) := by
    intro Y hY
    have h1 := hS Y
    have h2 := hA Y
    have hY1 : (1 : ℝ) ≤ Y := by exact_mod_cast hY
    have h3 : (((harmonic (Y + 1) : ℚ) : ℝ)) ≤ 1 + Real.log ((Y : ℝ) + 1) := by
      have := harmonic_le_one_add_log (Y + 1)
      exact_mod_cast this
    have h4 : ((P Y).card : ℝ) / ((Y : ℝ) + 1) ≤ C₁ := by
      rw [div_le_iff₀ (by positivity)]; nlinarith
    have h5 : Real.log ((Y : ℝ) + 1) ≤ Real.log (Y : ℝ) + 1 := by
      have h6 : Real.log ((Y : ℝ) + 1) ≤ Real.log (2 * (Y : ℝ)) :=
        Real.log_le_log (by positivity) (by linarith)
      rw [Real.log_mul (by norm_num) (by positivity)] at h6
      have := Real.log_two_lt_d9
      linarith
    have h6 : 0 ≤ Real.log (Y : ℝ) := Real.log_nonneg hY1
    have h7 : C₁ * (((harmonic (Y + 1) : ℚ) : ℝ)) ≤ C₁ * (1 + Real.log ((Y : ℝ) + 1)) :=
      mul_le_mul_of_nonneg_left h3 hC0
    have h8 : C₁ * Real.log ((Y : ℝ) + 1) ≤ C₁ * (Real.log (Y : ℝ) + 1) :=
      mul_le_mul_of_nonneg_left h5 hC0
    have h9 : 0 ≤ C₁ * Real.log (Y : ℝ) := mul_nonneg hC0 h6
    nlinarith
  
  have hmult : ∀ (L : Ideal (NumberField.RingOfIntegers K)), L ≠ ⊥ → ∀ Y : ℕ,
      (((P Y).filter (fun I => L ∣ I)).card : ℝ) ≤ C₁ * Y / (Ideal.absNorm L : ℝ) := by
    intro L hL Y
    have hm := normpos L hL
    have hsurj : Set.SurjOn (fun I' => L * I') ↑(P (Y / Ideal.absNorm L))
        ↑((P Y).filter (fun I => L ∣ I)) := by
      intro I hI
      rw [Finset.mem_coe, Finset.mem_filter, memP] at hI
      obtain ⟨⟨hI0, hIY⟩, ⟨I', rfl⟩⟩ := hI
      refine ⟨I', ?_, rfl⟩
      rw [Finset.mem_coe, memP]
      have hI'0 : I' ≠ ⊥ := by
        rintro rfl
        exact hI0 (Ideal.mul_bot L)
      refine ⟨hI'0, ?_⟩
      rw [Nat.le_div_iff_mul_le hm]
      rw [map_mul] at hIY
      rw [mul_comm]; exact hIY
    have h1 := Finset.card_le_card_of_surjOn _ hsurj
    have h2 := hA (Y / Ideal.absNorm L)
    have h3 : ((Y / Ideal.absNorm L : ℕ) : ℝ) ≤ (Y : ℝ) / (Ideal.absNorm L : ℝ) := Nat.cast_div_le
    rw [mul_div_assoc]
    calc (((P Y).filter (fun I => L ∣ I)).card : ℝ) ≤ (P (Y / Ideal.absNorm L)).card := by
          exact_mod_cast h1
      _ ≤ C₁ * ((Y / Ideal.absNorm L : ℕ) : ℝ) := h2
      _ ≤ C₁ * ((Y : ℝ) / Ideal.absNorm L) := mul_le_mul_of_nonneg_left h3 hC0
  
  have hlcm : ∀ Y : ℕ, ∑ J₁ ∈ P Y, ∑ J₂ ∈ P Y, 1 / (Ideal.absNorm (J₁ ⊓ J₂) : ℝ)
      ≤ (∑ J ∈ P Y, 1 / (Ideal.absNorm J : ℝ)) ^ 3 := by
    intro Y
    have hd1 : ∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K), ∃ A, J₁ = (J₁ ⊔ J₂) * A :=
      fun J₁ J₂ => Ideal.dvd_iff_le.mpr le_sup_left
    have hd2 : ∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K), ∃ B, J₂ = (J₁ ⊔ J₂) * B :=
      fun J₁ J₂ => Ideal.dvd_iff_le.mpr le_sup_right
    choose fA hfA using hd1
    choose fB hfB using hd2
    have hprop : ∀ J₁ ∈ P Y, ∀ J₂ ∈ P Y, (J₁ ⊔ J₂) ∈ P Y ∧ fA J₁ J₂ ∈ P Y ∧ fB J₁ J₂ ∈ P Y ∧
        Ideal.absNorm (J₁ ⊓ J₂) = Ideal.absNorm (J₁ ⊔ J₂) * Ideal.absNorm (fA J₁ J₂)
          * Ideal.absNorm (fB J₁ J₂) := by
      intro J₁ h₁ J₂ h₂
      rw [memP] at h₁ h₂
      have eA := hfA J₁ J₂
      have eB := hfB J₁ J₂
      have nA : Ideal.absNorm J₁ = Ideal.absNorm (J₁ ⊔ J₂) * Ideal.absNorm (fA J₁ J₂) := by
        rw [← map_mul Ideal.absNorm, ← eA]
      have nB : Ideal.absNorm J₂ = Ideal.absNorm (J₁ ⊔ J₂) * Ideal.absNorm (fB J₁ J₂) := by
        rw [← map_mul Ideal.absNorm, ← eB]
      have hG0 : J₁ ⊔ J₂ ≠ ⊥ := fun h =>
        h₁.1 (eq_bot_iff.mpr ((le_sup_left : J₁ ≤ J₁ ⊔ J₂).trans h.le))
      have hA0 : fA J₁ J₂ ≠ ⊥ := fun h => h₁.1 (by rw [eA, h, Ideal.mul_bot])
      have hB0 : fB J₁ J₂ ≠ ⊥ := fun h => h₂.1 (by rw [eB, h, Ideal.mul_bot])
      have pG := normpos _ hG0
      have pA := normpos _ hA0
      have pB := normpos _ hB0
      have hGle : Ideal.absNorm (J₁ ⊔ J₂) ≤ Ideal.absNorm J₁ := by
        rw [nA]; exact Nat.le_mul_of_pos_right _ pA
      have hAle : Ideal.absNorm (fA J₁ J₂) ≤ Ideal.absNorm J₁ := by
        rw [nA]; exact Nat.le_mul_of_pos_left _ pG
      have hBle : Ideal.absNorm (fB J₁ J₂) ≤ Ideal.absNorm J₂ := by
        rw [nB]; exact Nat.le_mul_of_pos_left _ pG
      refine ⟨(memP _ _).mpr ⟨hG0, hGle.trans h₁.2⟩, (memP _ _).mpr ⟨hA0, hAle.trans h₁.2⟩,
        (memP _ _).mpr ⟨hB0, hBle.trans h₂.2⟩, ?_⟩
      have key : Ideal.absNorm (J₁ ⊔ J₂) * Ideal.absNorm (J₁ ⊓ J₂)
          = Ideal.absNorm J₁ * Ideal.absNorm J₂ := by
        rw [← map_mul Ideal.absNorm, ← map_mul Ideal.absNorm, Ideal.sup_mul_inf]
      rw [nA, nB] at key
      apply Nat.eq_of_mul_eq_mul_left pG
      rw [key]; ring
    calc ∑ J₁ ∈ P Y, ∑ J₂ ∈ P Y, 1 / (Ideal.absNorm (J₁ ⊓ J₂) : ℝ)
        = ∑ p ∈ P Y ×ˢ P Y, (fun t : Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) =>
            1 / ((Ideal.absNorm t.1 : ℝ) * Ideal.absNorm t.2.1 * Ideal.absNorm t.2.2))
            ((fun p : Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) =>
              (p.1 ⊔ p.2, fA p.1 p.2, fB p.1 p.2)) p) := by
          rw [← Finset.sum_product']
          refine Finset.sum_congr rfl (fun p hp => ?_)
          rw [Finset.mem_product] at hp
          obtain ⟨-, -, -, h⟩ := hprop p.1 hp.1 p.2 hp.2
          simp only [h]
          push_cast
          ring
      _ = ∑ t ∈ (P Y ×ˢ P Y).image (fun p : Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) => (p.1 ⊔ p.2, fA p.1 p.2, fB p.1 p.2)),
            (fun t : Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) =>
            1 / ((Ideal.absNorm t.1 : ℝ) * Ideal.absNorm t.2.1 * Ideal.absNorm t.2.2)) t := by
          rw [Finset.sum_image]
          intro p _ q _ hpq
          simp only [Prod.mk.injEq] at hpq
          obtain ⟨hG, hA', hB'⟩ := hpq
          have e1 : p.1 = q.1 := by rw [hfA p.1 p.2, hfA q.1 q.2, hG, hA']
          have e2 : p.2 = q.2 := by rw [hfB p.1 p.2, hfB q.1 q.2, hG, hB']
          exact Prod.ext e1 e2
      _ ≤ ∑ t ∈ P Y ×ˢ (P Y ×ˢ P Y),
            (fun t : Ideal (NumberField.RingOfIntegers K) ×
              Ideal (NumberField.RingOfIntegers K) × Ideal (NumberField.RingOfIntegers K) =>
            1 / ((Ideal.absNorm t.1 : ℝ) * Ideal.absNorm t.2.1 * Ideal.absNorm t.2.2)) t := by
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro t ht
            rw [Finset.mem_image] at ht
            obtain ⟨p, hp, rfl⟩ := ht
            rw [Finset.mem_product] at hp
            obtain ⟨h1, h2, h3, -⟩ := hprop p.1 hp.1 p.2 hp.2
            simp only [Finset.mem_product]
            exact ⟨h1, h2, h3⟩
          · intro t _ _
            positivity
      _ = (∑ J ∈ P Y, 1 / (Ideal.absNorm J : ℝ)) ^ 3 := by
          rw [Finset.sum_product, pow_three, Finset.sum_mul_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl (fun a _ => ?_)
          rw [Finset.sum_product, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun b _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun c _ => ?_)
          ring
  
  have hD : ∀ (Y : ℕ) (I : Ideal (NumberField.RingOfIntegers K)), I ∈ P Y →
      (@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun J => J ∣ I)
        (fun _ => Classical.propDecidable _)
        (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset)
        = (P Y).filter (fun J => J ∣ I) := by
    intro Y I hI
    rw [memP] at hI
    ext J
    rw [Finset.mem_filter, Finset.mem_filter, memF, memP]
    constructor
    · rintro ⟨hJn, hJ⟩
      refine ⟨⟨?_, hJn.trans hI.2⟩, hJ⟩
      rintro rfl
      exact hI.1 (eq_bot_iff.mpr (Ideal.dvd_iff_le.mp hJ))
    · rintro ⟨⟨_, _⟩, hJ⟩
      exact ⟨Nat.le_of_dvd (normpos I hI.1)
        (Ideal.absNorm_dvd_absNorm_of_le (Ideal.dvd_iff_le.mp hJ)), hJ⟩
  have hsq : ∀ (Y : ℕ) (I : Ideal (NumberField.RingOfIntegers K)), I ∈ P Y →
      (((@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun J => J ∣ I)
        (fun _ => Classical.propDecidable _)
        (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset).card : ℝ)) ^ 2
      = ∑ J₁ ∈ P Y, ∑ J₂ ∈ P Y, if J₁ ⊓ J₂ ∣ I then (1 : ℝ) else 0 := by
    intro Y I hI
    rw [hD Y I hI, ← Finset.sum_boole, sq, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl (fun J₁ _ => Finset.sum_congr rfl (fun J₂ _ => ?_))
    have hiff : (J₁ ∣ I ∧ J₂ ∣ I) ↔ J₁ ⊓ J₂ ∣ I := by
      rw [Ideal.dvd_iff_le, Ideal.dvd_iff_le, Ideal.dvd_iff_le, le_inf_iff]
    rw [ite_zero_mul_ite_zero, mul_one]
    by_cases h : J₁ ⊓ J₂ ∣ I
    · rw [if_pos (hiff.mpr h), if_pos h]
    · rw [if_neg (mt hiff.mp h), if_neg h]
  have hdc : ∀ Y : ℕ, ∑ I ∈ P Y,
      (((@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun J => J ∣ I)
        (fun _ => Classical.propDecidable _)
        (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset).card : ℝ)) ^ 2
      = ∑ J₁ ∈ P Y, ∑ J₂ ∈ P Y, (((P Y).filter (fun I => J₁ ⊓ J₂ ∣ I)).card : ℝ) := by
    intro Y
    rw [Finset.sum_congr rfl (hsq Y), Finset.sum_comm]
    refine Finset.sum_congr rfl (fun J₁ _ => ?_)
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun J₂ _ => ?_)
    rw [Finset.sum_boole]
  
  have hC4 : C₁ ≤ C₁ ^ 4 := by
    calc C₁ = C₁ ^ 1 := (pow_one _).symm
      _ ≤ C₁ ^ 4 := pow_le_pow_right₀ hC₁1 (by norm_num)
  refine ⟨1 + 8 * C₁ ^ 4, by nlinarith [pow_nonneg hC0 4], ?_⟩
  intro Y hY
  have hY1 : (1 : ℝ) ≤ Y := by exact_mod_cast hY
  constructor
  · have := hC Y hY
    nlinarith
  · have hℓ1 : 1 ≤ 1 + Real.log (Y : ℝ) := by have := Real.log_nonneg hY1; linarith
    have hS0 : 0 ≤ ∑ J ∈ P Y, 1 / (Ideal.absNorm J : ℝ) :=
      Finset.sum_nonneg (fun J _ => by positivity)
    have hSb' := hSb Y hY
    have hbot : (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
        (fun J => J ∣ (⊥ : Ideal (NumberField.RingOfIntegers K)))
        (fun _ => Classical.propDecidable _)
        (Ideal.finite_setOf_absNorm_le
          (Ideal.absNorm (⊥ : Ideal (NumberField.RingOfIntegers K)))).toFinset).card ≤ 1 := by
      apply Finset.card_le_one.mpr
      intro a ha b hb
      rw [Finset.mem_filter, memF, Ideal.absNorm_bot] at ha hb
      rw [Ideal.absNorm_eq_zero_iff.mp (Nat.le_zero.mp ha.1),
        Ideal.absNorm_eq_zero_iff.mp (Nat.le_zero.mp hb.1)]
    have hbot' : (((@Finset.filter (Ideal (NumberField.RingOfIntegers K))
        (fun J => J ∣ (⊥ : Ideal (NumberField.RingOfIntegers K)))
        (fun _ => Classical.propDecidable _)
        (Ideal.finite_setOf_absNorm_le
          (Ideal.absNorm (⊥ : Ideal (NumberField.RingOfIntegers K)))).toFinset).card : ℝ)) ^ 2 ≤ 1 := by
      have h : (((@Finset.filter (Ideal (NumberField.RingOfIntegers K))
        (fun J => J ∣ (⊥ : Ideal (NumberField.RingOfIntegers K)))
        (fun _ => Classical.propDecidable _)
        (Ideal.finite_setOf_absNorm_le
          (Ideal.absNorm (⊥ : Ideal (NumberField.RingOfIntegers K)))).toFinset).card : ℝ)) ≤ 1 := by
        exact_mod_cast hbot
      have h0 := Nat.cast_nonneg (α := ℝ) (@Finset.filter (Ideal (NumberField.RingOfIntegers K))
        (fun J => J ∣ (⊥ : Ideal (NumberField.RingOfIntegers K)))
        (fun _ => Classical.propDecidable _)
        (Ideal.finite_setOf_absNorm_le
          (Ideal.absNorm (⊥ : Ideal (NumberField.RingOfIntegers K)))).toFinset).card
      nlinarith
    have hmain : ∑ J₁ ∈ P Y, ∑ J₂ ∈ P Y, (((P Y).filter (fun I => J₁ ⊓ J₂ ∣ I)).card : ℝ)
        ≤ C₁ * Y * ∑ J₁ ∈ P Y, ∑ J₂ ∈ P Y, 1 / (Ideal.absNorm (J₁ ⊓ J₂) : ℝ) := by
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun J₁ h₁ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun J₂ h₂ => ?_)
      have hL : J₁ ⊓ J₂ ≠ ⊥ := by
        intro h
        have h12 : J₁ * J₂ ≤ J₁ ⊓ J₂ := Ideal.mul_le_inf
        rw [h, le_bot_iff, Ideal.mul_eq_bot] at h12
        rcases h12 with h | h
        · exact ((memP Y J₁).mp h₁).1 h
        · exact ((memP Y J₂).mp h₂).1 h
      rw [mul_one_div]
      exact hmult (J₁ ⊓ J₂) hL Y
    have hCY : 0 ≤ C₁ * Y := by positivity
    have h1 : ∑ I ∈ P Y,
        (((@Finset.filter (Ideal (NumberField.RingOfIntegers K)) (fun J => J ∣ I)
          (fun _ => Classical.propDecidable _)
          (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)).toFinset).card : ℝ)) ^ 2
        ≤ C₁ * Y * (∑ J ∈ P Y, 1 / (Ideal.absNorm J : ℝ)) ^ 3 := by
      rw [hdc Y]
      exact hmain.trans (mul_le_mul_of_nonneg_left (hlcm Y) hCY)
    have h2 : C₁ * Y * (∑ J ∈ P Y, 1 / (Ideal.absNorm J : ℝ)) ^ 3
        ≤ C₁ * Y * (2 * C₁ * (1 + Real.log (Y : ℝ))) ^ 3 :=
      mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hS0 hSb' 3) hCY
    have hYℓ : 1 ≤ (Y : ℝ) * (1 + Real.log (Y : ℝ)) ^ 3 :=
      one_le_mul_of_one_le_of_one_le hY1 (one_le_pow₀ hℓ1)
    have e1 : C₁ * Y * (2 * C₁ * (1 + Real.log (Y : ℝ))) ^ 3
        = 8 * C₁ ^ 4 * ((Y : ℝ) * (1 + Real.log (Y : ℝ)) ^ 3) := by ring
    have e2 : (1 + 8 * C₁ ^ 4) * (Y : ℝ) * (1 + Real.log (Y : ℝ)) ^ 3
        = (Y : ℝ) * (1 + Real.log (Y : ℝ)) ^ 3
          + 8 * C₁ ^ 4 * ((Y : ℝ) * (1 + Real.log (Y : ℝ)) ^ 3) := by ring
    rw [hFP Y, Finset.sum_insert (botP Y)]
    beta_reduce
    linarith

theorem kai_log_weight_removal (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ (CL : ℝ) (AL : ℕ), 1 ≤ CL ∧ 1 ≤ AL ∧
      ∀ (M θ κ : ℝ) (f : NumberField.RingOfIntegers K → ℝ)
        (P : (Fin (Module.finrank ℚ K) → ℤ) → ℝ),
        3 ≤ M → 0 < θ → θ ≤ 1 → 1 ≤ κ →
        (∀ x ∈ omegaBox ω M, |f x| ≤ κ) →
        CL * (κ * Real.log M / θ) ^ AL ≤ (⌊M⌋₊ : ℝ) →
        θ * ((omegaBox ω M).card : ℝ) ≤
          ‖∑ x ∈ omegaBox ω M,
              ((f x * Real.log ((Algebra.norm ℤ x).natAbs : ℝ) : ℝ) : ℂ)
                * giE (P (ω.equivFun x))‖ →
        ∃ Ω : Set (Fin (Module.finrank ℚ K) → ℝ), Convex ℝ Ω ∧
          θ * ((omegaBox ω M).card : ℝ) ≤
            CL * (κ * Real.log M / θ) ^ AL *
              ‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                    (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω)
                    (fun _ => Classical.propDecidable _) (omegaBox ω M),
                  ((f x : ℝ) : ℂ) * giE (P (ω.equivFun x))‖ :=
by
  classical
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hC1 : 1 < C := hω.1
  have hlogC : 0 < Real.log C := Real.log_pos hC1
  obtain ⟨n, hn⟩ : ∃ n : ℝ, n = (Module.finrank ℚ K : ℝ) := ⟨_, rfl⟩
  have hn1' : (1 : ℝ) ≤ n := by rw [hn]; exact_mod_cast hn1
  have hn0 : (0 : ℝ) ≤ n := by linarith
  
  have hplace : ∀ M : ℝ, 1 ≤ M → ∀ x : NumberField.RingOfIntegers K, x ∈ omegaBox ω M →
      (∀ w : NumberField.InfinitePlace K, w (x : K) ≤ C * M) ∧
      (x ≠ 0 → ∀ w : NumberField.InfinitePlace K,
        ((C * M) ^ Module.finrank ℚ K)⁻¹ ≤ w (x : K)) := by
    intro M hM1 x hx
    have hB1 : 1 ≤ C * M := one_le_mul_of_one_le_of_one_le hC1.le hM1
    have hBn1 : 1 ≤ (C * M) ^ Module.finrank ℚ K := one_le_pow₀ hB1
    have hBnpos : 0 < (C * M) ^ Module.finrank ℚ K := by linarith
    have hs1 : basisSupNorm ω x ≤ M := by
      simp only [omegaBox, Finset.mem_image] at hx
      obtain ⟨v, hv, rfl⟩ := hx
      unfold basisSupNorm
      refine Real.iSup_le (fun j => ?_) (by linarith)
      have hrepr : ω.repr (ω.equivFun.symm v) j = v j := by
        rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
      rw [hrepr]
      unfold intBox at hv
      rw [Finset.mem_Icc] at hv
      have h1 : -(⌊M⌋₊ : ℤ) ≤ v j := hv.1 j
      have h2 : v j ≤ (⌊M⌋₊ : ℤ) := hv.2 j
      have habs : |v j| ≤ (⌊M⌋₊ : ℤ) := abs_le.mpr ⟨h1, h2⟩
      have h3 : |((v j : ℤ) : ℝ)| ≤ ((⌊M⌋₊ : ℕ) : ℝ) := by
        rw [← Int.cast_abs]; exact_mod_cast habs
      exact h3.trans (Nat.floor_le (by linarith))
    have hs2 : ∀ w : NumberField.InfinitePlace K,
        w (algebraMap (NumberField.RingOfIntegers K) K x) ≤ C * M := by
      intro w
      have ha : w (algebraMap (NumberField.RingOfIntegers K) K x)
          ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) :=
        le_ciSup (f := fun w : NumberField.InfinitePlace K =>
          w (algebraMap (NumberField.RingOfIntegers K) K x)) (Set.finite_range _).bddAbove w
      have hb := (hω.2 x).2
      have hc : C * basisSupNorm ω x ≤ C * M := mul_le_mul_of_nonneg_left hs1 (by linarith)
      exact ha.trans (hb.trans hc)
    have hcast : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) = ∏ w : NumberField.InfinitePlace K,
        w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs, Rat.cast_abs]
      congr 1
      have hn := Algebra.coe_norm_int x
      rw [show algebraMap (NumberField.RingOfIntegers K) K x = (x : K) from rfl, ← hn]
      simp
    refine ⟨hs2, ?_⟩
    intro hx0 w₀
    have hs5 : (1 : ℝ) ≤ ∏ w : NumberField.InfinitePlace K,
