  have hgaussJ : ∀ (y' : NumberField.InfinitePlace K → ℝ)
      (x : NumberField.mixedEmbedding.mixedSpace K),
      kaiHZGaussian K y' (kaiHZDualTwist K x)
        = kaiHZGaussian K (fun w => rr w * y' w) x := by
    intro y' x
    have hs : (∑ w : NumberField.InfinitePlace K,
          y' w * NumberField.mixedEmbedding.normAtPlace w (kaiHZDualTwist K x) ^ 2)
        = ∑ w : NumberField.InfinitePlace K,
          (rr w * y' w) * NumberField.mixedEmbedding.normAtPlace w x ^ 2 := by
      refine Finset.sum_congr rfl fun w _ => ?_
      rw [hnorm2J x w]; ring
    simp only [kaiHZGaussian, hs]
  have hinnerJ : ∀ x v : NumberField.mixedEmbedding.mixedSpace K,
      kaiHZMixedInner K (kaiHZDualTwist K x) v
        = kaiHZMixedInner K x (kaiHZDualTwist K v) := by
    intro x v
    have hsnd : (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          ((kaiHZDualTwist K x).2 p * (starRingEnd ℂ) (v.2 p)).re)
        = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (x.2 p * (starRingEnd ℂ) ((kaiHZDualTwist K v).2 p)).re := by
      refine Finset.sum_congr rfl fun p _ => ?_
      show ((2 : ℂ) * (starRingEnd ℂ) (x.2 p) * (starRingEnd ℂ) (v.2 p)).re
          = (x.2 p * (starRingEnd ℂ) (2 * (starRingEnd ℂ) (v.2 p))).re
      have e1 : (2 : ℂ) * (starRingEnd ℂ) (x.2 p) * (starRingEnd ℂ) (v.2 p)
          = (starRingEnd ℂ) (2 * x.2 p * v.2 p) := by
        rw [map_mul, map_mul, hc2]
      have e2 : x.2 p * (starRingEnd ℂ) (2 * (starRingEnd ℂ) (v.2 p))
