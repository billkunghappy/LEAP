theorem kai_hecke_logderiv_bound_00 (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hL : KaiZFLandauExpProp) (hcont : KaiZFZetaContProp K)
    (hser : KaiZFSeriesBasicsProp K) :
    ∀ B : ℝ, 0 < B → B ≤ 1 → ∃ C : ℝ, 0 < C ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam →
        ∀ (E : ℕ) (G : ℂ → ℂ), E ≤ 1 → (E = 1 ↔ KaiHeckePrincipal K q lam) →
          Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) →
          ∀ (m : ℕ) (β₀ : ℝ), m ≤ 1 → 0 ≤ β₀ → β₀ < 1 →
            (m = 1 → G (β₀ : ℂ) = 0 ∧ deriv G (β₀ : ℂ) ≠ 0) →
            (∀ s : ℂ, s.re ≤ 2 →
                1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * 2 * (2 + |s.im|)) ≤ s.re →
                G s = 0 → m = 1 ∧ s = (β₀ : ℂ)) →
            ∀ σ : ℝ, 1 < σ → σ ≤ 2 →
              ‖deriv G (σ : ℂ) / G (σ : ℂ) - (m : ℂ) / ((σ : ℂ) - (β₀ : ℂ))‖
                ≤ C * Real.log (3 + 4 * (Ideal.absNorm q : ℝ)) :=
by
  
  have kai_lb_shift_at_scale : ∀ (Zs : Finset ℂ) (mult : ℂ → ℕ) (L B σ W : ℝ),
      1 ≤ L → 0 < B → B ≤ 1 → 0 ≤ W → 1 < σ → σ ≤ 1 + 1 / (8 * L) →
      (∀ ρ ∈ Zs, ρ.re ≤ 1 - 8 * B / (9 * L)) →
      ‖∑ ρ ∈ Zs, (mult ρ : ℂ) / (((1 + 1 / (8 * L) : ℝ) : ℂ) - ρ)‖ ≤ W →
      ‖∑ ρ ∈ Zs, (mult ρ : ℂ) / ((σ : ℂ) - ρ)‖ ≤ W * (3 + 1 / B) := by
    clear hL hcont hser
    intro Zs mult L B σ W hL hB0 hB1 hW hσ1 hσ2 hre hcen
    have hLpos : 0 < L := by linarith
    obtain ⟨d, hd_def⟩ : ∃ d : ℝ, d = 1 / (8 * L) := ⟨_, rfl⟩
    obtain ⟨σ₁, hσ₁_def⟩ : ∃ σ₁ : ℝ, σ₁ = 1 + 1 / (8 * L) := ⟨_, rfl⟩
    rw [← hσ₁_def] at hcen
    have hd0 : 0 < d := by rw [hd_def]; positivity
    have hσ₁d : σ₁ = 1 + d := by rw [hσ₁_def, hd_def]
    obtain ⟨h, hh_def⟩ : ∃ h : ℝ, h = σ₁ - σ := ⟨_, rfl⟩
    have hh0 : 0 ≤ h := by rw [hh_def, hσ₁_def]; linarith
    have hhd : h ≤ d := by rw [hh_def, hσ₁d]; linarith
    have hBinv : 0 < 1 / B := by positivity
    obtain ⟨k, hk_def⟩ : ∃ k : ℝ, k = 2 + 1 / B := ⟨_, rfl⟩
    have hk0 : 0 ≤ k := by rw [hk_def]; positivity
    have hBL : 0 ≤ 8 * B / (9 * L) := by positivity
    have he : B / (2 * L) ≤ 8 * B / (9 * L) := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]; nlinarith
    have hb_re : ∀ ρ ∈ Zs, d ≤ ((σ₁ : ℂ) - ρ).re := by
      intro ρ hρ
      have := hre ρ hρ
      simp only [Complex.sub_re, Complex.ofReal_re]
      rw [hσ₁d]; linarith
    have ha_re : ∀ ρ ∈ Zs, B / (2 * L) ≤ ((σ : ℂ) - ρ).re := by
      intro ρ hρ
      have := hre ρ hρ
      simp only [Complex.sub_re, Complex.ofReal_re]
      linarith
    have hb_norm : ∀ ρ ∈ Zs, d ≤ ‖(σ₁ : ℂ) - ρ‖ :=
      fun ρ hρ => (hb_re ρ hρ).trans (Complex.re_le_norm _)
    have ha_norm : ∀ ρ ∈ Zs, B / (2 * L) ≤ ‖(σ : ℂ) - ρ‖ :=
      fun ρ hρ => (ha_re ρ hρ).trans (Complex.re_le_norm _)
    have hBL2 : 0 < B / (2 * L) := by positivity
    have hdiff : ∀ ρ : ℂ, (σ₁ : ℂ) - ρ = ((σ : ℂ) - ρ) + (h : ℂ) := by
      intro ρ; rw [hh_def]; push_cast; ring
    have hratio : ∀ ρ ∈ Zs, ‖(σ₁ : ℂ) - ρ‖ ≤ k * ‖(σ : ℂ) - ρ‖ := by
      intro ρ hρ
      have htri : ‖(σ₁ : ℂ) - ρ‖ ≤ ‖(σ : ℂ) - ρ‖ + h := by
        rw [hdiff ρ]
        refine (norm_add_le _ _).trans ?_
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hh0]
      have ha := ha_norm ρ hρ
      by_cases hc : 2 * d < ‖(σ₁ : ℂ) - ρ‖
      · have h1 : ‖(σ₁ : ℂ) - ρ‖ ≤ 2 * ‖(σ : ℂ) - ρ‖ := by linarith
        have h2 : 2 * ‖(σ : ℂ) - ρ‖ ≤ k * ‖(σ : ℂ) - ρ‖ :=
