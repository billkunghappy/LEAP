theorem kai_t2_pairs_to_struct : ∀ (ν A : ℕ), 1 ≤ ν → Nil2VertEquidist ν A → ∃ A₈ : ℕ, 1 ≤ A₈ ∧
      ∀ (D Q η C₁ Mh Kb X : ℝ) (Lc Tb : ℕ) (c lam : Fin ν → Fin ν → Fin ν → ℤ)
        (S : Finset ((Fin ν → ℤ) × (Fin ν → ℤ))) (z₀ : Fin ν → ℤ) (φ : (Fin ν → ℤ) → ℂ),
        1 ≤ D → 2 ≤ Q → 0 < η → η ≤ 1 → 1 ≤ C₁ → 0 < Mh → 1 ≤ Kb →
        IsNil2VertSeq ν D Q φ →
        (∀ k i l, |(c k i l : ℝ)| ≤ C₁) → (∀ l k i, |(lam l k i : ℝ)| ≤ C₁) →
        (∀ l l', ∑ k, ∑ i, lam l k i * c k i l' = if l = l' then 1 else 0) →
        (∀ s ∈ S, ∀ k, |s.1 k| ≤ (Tb : ℤ) ∧ |s.2 k| ≤ (Tb : ℤ)) →
        η * (2 * (Tb : ℝ) + 1) ^ (2 * ν) ≤ (S.card : ℝ) →
        (∀ s ∈ S, η * (Lc : ℝ) ^ ν ≤
           ‖∑ w ∈ Finset.Icc z₀ (z₀ + fun _ => (Lc : ℤ) - 1),
               φ (kaiBil c s.1 w) * (starRingEnd ℂ) (φ (kaiBil c s.2 w))‖) →
        Real.exp (((A₈ : ℝ) * (D + Real.log Q + Real.log (1 / η) + Real.log C₁)) ^ A₈)
          ≤ (Lc : ℝ) →
        Real.exp (((A₈ : ℝ) * (D + Real.log Q + Real.log (1 / η) + Real.log C₁)) ^ A₈)
          ≤ (Tb : ℝ) →
        Mh ≤ Kb * Lc * Tb →
        Kb * Real.exp (((A₈ : ℝ) * (D + Real.log Q + Real.log (1 / η) + Real.log C₁)) ^ A₈)
          ≤ X →
        IsNil2VertStructSeq ν D Q Mh X φ :=
by
  intro ν A hν hE
  obtain ⟨C₄, hC₄, hvin⟩ := kai_t2_simul_vinogradov ν hν
  obtain ⟨A₈, hA₈, hnum⟩ := kai_t2_A8_numeric ν A C₄ hν hC₄
  refine ⟨A₈, hA₈, ?_⟩
  intro D Q η C₁ Mh Kb X Lc Tb c lam S z₀ φ hD hQ hη hη1 hC₁ hMh hKb hφ hc hlam hid hbox hdens
    hcor hLc hTb hMLT hX
  obtain ⟨a, b, Bc, ξ, p₀, p₁, r₀, r₁, r₂, F, h1, h2, h3, h4, h5, h6, h7, h8, hφz⟩ := hφ
  have hdata : Nil2VertData D Q Bc ξ F := by
    unfold Nil2VertData; exact ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩
  have hφe : ∀ z, φ z = nil2Eval p₀ p₁ r₀ r₁ r₂ F z := fun z => hφz z
  have ha : (a : ℝ) ≤ D := by
    have hb0 : (0 : ℝ) ≤ (b : ℝ) := Nat.cast_nonneg b
    push_cast at h1; linarith
  
  have hW := hnum D Q η C₁ a hD hQ hη hη1 hC₁ ha
  obtain ⟨X₁, hX₁⟩ : ∃ X₁ : ℝ,
      X₁ = Real.exp ((2 * D + Real.log (Q ^ 2) + Real.log (1 / η)) ^ A) := ⟨_, rfl⟩
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℝ,
      Λ = Real.exp (((A₈ : ℝ) * (D + Real.log Q + Real.log (1 / η) + Real.log C₁)) ^ A₈) :=
    ⟨_, rfl⟩
  rw [← hX₁, ← hΛ] at hW
  rw [← hΛ] at hLc hTb hX
  have hQ1 : (1 : ℝ) ≤ Q := by linarith
  have hlogQ : 0 ≤ Real.log Q := Real.log_nonneg hQ1
  have hlogQ2 : 0 ≤ Real.log (Q ^ 2) := Real.log_nonneg (one_le_pow₀ hQ1)
  have hinvη : (1 : ℝ) ≤ 1 / η := by rw [le_div_iff₀ hη]; linarith
  have hlogη : 0 ≤ Real.log (1 / η) := Real.log_nonneg hinvη
  have hlogC₁ : 0 ≤ Real.log C₁ := Real.log_nonneg hC₁
  have hΛ1 : 1 ≤ Λ := by
    rw [hΛ]; apply Real.one_le_exp
    apply pow_nonneg; apply mul_nonneg (Nat.cast_nonneg _); linarith
  have hX₁1 : 1 ≤ X₁ := by
    rw [hX₁]; apply Real.one_le_exp; apply pow_nonneg; linarith
  have hX₁0 : 0 ≤ X₁ := by linarith
  have hLc1 : (1 : ℝ) ≤ (Lc : ℝ) := le_trans hΛ1 hLc
  have hTb1 : (1 : ℝ) ≤ (Tb : ℝ) := le_trans hΛ1 hTb
  have hLcpos : (0 : ℝ) < Lc := by linarith
  have hTbpos : (0 : ℝ) < Tb := by linarith
  have hLc1n : 1 ≤ Lc := by exact_mod_cast hLc1
  obtain ⟨E, hEdef⟩ : ∃ E : ℝ, E = (2 * X₁ + 1) ^ (2 * (a + a) * a) := ⟨_, rfl⟩
  have hE1 : 1 ≤ E := by rw [hEdef]; exact one_le_pow₀ (by linarith)
  have hE0 : 0 < E := by linarith
  obtain ⟨ηs, hηs⟩ : ∃ ηs : ℝ, ηs = η / E := ⟨_, rfl⟩
  have hηs0 : 0 < ηs := by rw [hηs]; exact div_pos hη hE0
  have hηs1 : ηs ≤ 1 := by rw [hηs, div_le_one hE0]; linarith
  have hC₄1 : (1 : ℝ) ≤ C₄ := by exact_mod_cast hC₄
  obtain ⟨P, hP⟩ : ∃ P : ℝ, P = ((C₄ : ℝ) / ηs) ^ C₄ := ⟨_, rfl⟩
  have hP1 : 1 ≤ P := by
    rw [hP]; apply one_le_pow₀; rw [le_div_iff₀ hηs0]; linarith
  rw [← hEdef, ← hηs, ← hP] at hW
  
  obtain ⟨At, hAt⟩ : ∃ At : (Fin ν → ℤ) → Fin ν → Fin ν → ℤ,
      ∀ t l i, At t l i = ∑ k, t k * c k i l :=
    ⟨fun t l i => ∑ k, t k * c k i l, fun _ _ _ => rfl⟩
  have hbil : ∀ t w : Fin ν → ℤ, kaiBil c t w = fun l => ∑ i, At t l i * w i := by
    intro t w; funext l
    simp only [kaiBil, hAt, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
  have hlin : ∀ (t : Fin ν → ℤ) (i : Fin ν) (θ : Fin ν → ℝ),
      ∑ l, ((At t l i : ℤ) : ℝ) * θ l = ∑ k, (t k : ℝ) * ∑ l, (c k i l : ℝ) * θ l := by
    intro t i θ
    simp only [hAt]
    push_cast
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
  have hpair : ∀ s ∈ S, ∃ (k1 k2 : Fin (a + a) → Fin a → ℤ),
      (∀ m j, |(k1 m j : ℝ)| ≤ X₁ ∧ |(k2 m j : ℝ)| ≤ X₁) ∧
      Nil2Isotropic Bc ξ (Fin.append k1 k2) ∧
      ∀ (m : Fin (a + a)) (i : Fin ν), ∃ e : ℤ,
        |∑ l, ((At s.1 l i : ℤ) : ℝ) * ∑ j, (k1 m j : ℝ) * p₁ l j
          + ∑ l, ((At s.2 l i : ℤ) : ℝ) * ∑ j, (k2 m j : ℝ) * p₁ l j - (e : ℝ)|
          ≤ X₁ / (Lc : ℝ) := by
    intro s hs
    have hc' : η * (Lc : ℝ) ^ ν ≤
        ‖∑ w ∈ Finset.Icc z₀ (z₀ + fun _ => (Lc : ℤ) - 1),
          nil2Eval p₀ p₁ r₀ r₁ r₂ F (fun l => ∑ i, At s.1 l i * w i) *
            (starRingEnd ℂ) (nil2Eval p₀ p₁ r₀ r₁ r₂ F (fun l => ∑ i, At s.2 l i * w i))‖ := by
      have h0 := hcor s hs
      simp only [hφe, hbil] at h0
      exact h0
    have h := kai_t2_pair_chars ν A hE D Q η Lc a b Bc ξ F p₀ p₁ r₀ r₁ r₂ (At s.1) (At s.2) z₀
      hD hQ hη hη1 hLc1n hdata hc'
    rw [← hX₁] at h
    exact h
  choose! f1 f2 hf using hpair
  
  obtain ⟨g, hg, hcard⟩ := kai_t2_pigeon_family S (a + a) a X₁ (fun s => (f1 s, f2 s)) hX₁0
    (fun s hs m j => (hf s hs).1 m j)
  rw [← hEdef] at hcard
  obtain ⟨Ss, hSs⟩ : ∃ Ss : Finset ((Fin ν → ℤ) × (Fin ν → ℤ)),
      Ss = S.filter (fun s => (f1 s, f2 s) = g) := ⟨_, rfl⟩
  have hmemSs : ∀ s ∈ Ss, s ∈ S ∧ f1 s = g.1 ∧ f2 s = g.2 := by
    intro s hs
    rw [hSs, Finset.mem_filter] at hs
    exact ⟨hs.1, congrArg Prod.fst hs.2, congrArg Prod.snd hs.2⟩
  have hcard' : (S.card : ℝ) ≤ E * (Ss.card : ℝ) := by rw [hSs]; exact hcard
  have hT0 : (0 : ℝ) < (2 * (Tb : ℝ) + 1) ^ (2 * ν) := by positivity
  have hSsdens : ηs * (2 * (Tb : ℝ) + 1) ^ (2 * ν) ≤ (Ss.card : ℝ) := by
    rw [hηs, div_mul_eq_mul_div, div_le_iff₀ hE0]
    linarith
  have hSsne : Ss.Nonempty := by
    apply Finset.card_pos.mp
    have : (0 : ℝ) < (Ss.card : ℝ) := lt_of_lt_of_le (mul_pos hηs0 hT0) hSsdens
    exact_mod_cast this
  obtain ⟨s₀, hs₀⟩ := hSsne
  obtain ⟨hs₀S, hs₀1, hs₀2⟩ := hmemSs s₀ hs₀
  have hiso_g : Nil2Isotropic Bc ξ (Fin.append g.1 g.2) := by
    have := (hf s₀ hs₀S).2.1
    rw [hs₀1, hs₀2] at this
    exact this
  
  obtain ⟨θ1, hθ1⟩ : ∃ θ1 : Fin (a + a) → Fin ν → ℝ,
      ∀ m l, θ1 m l = ∑ j, (g.1 m j : ℝ) * p₁ l j :=
    ⟨fun m l => ∑ j, (g.1 m j : ℝ) * p₁ l j, fun _ _ => rfl⟩
  obtain ⟨θ2, hθ2⟩ : ∃ θ2 : Fin (a + a) → Fin ν → ℝ,
      ∀ m l, θ2 m l = ∑ j, (g.2 m j : ℝ) * p₁ l j :=
    ⟨fun m l => ∑ j, (g.2 m j : ℝ) * p₁ l j, fun _ _ => rfl⟩
  obtain ⟨G1, hG1⟩ : ∃ G1 : Fin (a + a) × Fin ν → Fin ν → ℝ,
      ∀ m i k, G1 (m, i) k = ∑ l, (c k i l : ℝ) * θ1 m l :=
    ⟨fun j k => ∑ l, (c k j.2 l : ℝ) * θ1 j.1 l, fun _ _ _ => rfl⟩
  obtain ⟨G2, hG2⟩ : ∃ G2 : Fin (a + a) × Fin ν → Fin ν → ℝ,
      ∀ m i k, G2 (m, i) k = ∑ l, (c k i l : ℝ) * θ2 m l :=
    ⟨fun j k => ∑ l, (c k j.2 l : ℝ) * θ2 j.1 l, fun _ _ _ => rfl⟩
  have hSssm : ∀ s ∈ Ss, ∀ j : Fin (a + a) × Fin ν, ∃ e : ℤ,
      |∑ k, (s.1 k : ℝ) * G1 j k + ∑ k, (s.2 k : ℝ) * G2 j k - (e : ℝ)| ≤ X₁ / (Lc : ℝ) := by
    intro s hs j
    obtain ⟨m, i⟩ := j
    obtain ⟨hsS, hs1, hs2⟩ := hmemSs s hs
    obtain ⟨e, he⟩ := (hf s hsS).2.2 m i
    refine ⟨e, ?_⟩
    have e1 : ∑ k, (s.1 k : ℝ) * G1 (m, i) k
        = ∑ l, ((At s.1 l i : ℤ) : ℝ) * ∑ j, (f1 s m j : ℝ) * p₁ l j := by
      rw [hs1]; simp only [hG1, hθ1]
      exact (hlin s.1 i (fun l => ∑ j, (g.1 m j : ℝ) * p₁ l j)).symm
    have e2 : ∑ k, (s.2 k : ℝ) * G2 (m, i) k
        = ∑ l, ((At s.2 l i : ℤ) : ℝ) * ∑ j, (f2 s m j : ℝ) * p₁ l j := by
      rw [hs2]; simp only [hG2, hθ2]
      exact (hlin s.2 i (fun l => ∑ j, (g.2 m j : ℝ) * p₁ l j)).symm
    rw [e1, e2]; exact he
  have hε0 : 0 ≤ X₁ / (Lc : ℝ) := div_nonneg hX₁0 hLcpos.le
  have hν1 : (1 : ℝ) ≤ (ν : ℝ) := by exact_mod_cast hν
  have hνC : 1 ≤ (ν : ℝ) ^ 2 * C₁ := one_le_mul_of_one_le_of_one_le (one_le_pow₀ hν1) hC₁
  have hP0 : 0 ≤ P := by linarith
  have hPpow : P ≤ P ^ ((a + a) * ν + 1) := le_self_pow₀ hP1 (by omega)
  have hPn : P ^ ((a + a) * ν) ≤ P ^ ((a + a) * ν + 1) := pow_le_pow_right₀ hP1 (Nat.le_succ _)
  have hPn0 : 0 ≤ P ^ ((a + a) * ν) := pow_nonneg hP0 _
  have hPn1 : 0 ≤ P ^ ((a + a) * ν + 1) := pow_nonneg hP0 _
  have hW1 : P ^ ((a + a) * ν + 1) * X₁ ≤ Λ := by
    have := mul_le_mul_of_nonneg_right hνC (mul_nonneg hPn1 hX₁0)
    linarith
  have hPT : P ≤ (Tb : ℝ) := by
    have := mul_le_mul hPpow hX₁1 zero_le_one hPn1
    linarith
  have hεP : X₁ / (Lc : ℝ) * P ≤ 1 := by
    rw [div_mul_eq_mul_div, div_le_one hLcpos]
    have := mul_le_mul_of_nonneg_left hPpow hX₁0
    linarith
  obtain ⟨q, hq1, hqP, hqG⟩ := hvin (Fin (a + a) × Fin ν) G1 G2 Ss Tb ηs (X₁ / (Lc : ℝ))
    hηs0 hηs1 hε0 (fun s hs k => hbox s (hmemSs s hs).1 k) hSsdens hSssm
    (by rw [← hP]; exact hPT) (by rw [← hP]; exact hεP)
  have hcardι : Fintype.card (Fin (a + a) × Fin ν) = (a + a) * ν := by simp
  rw [← hP, hcardι] at hqP hqG
  obtain ⟨β, hβ⟩ : ∃ β : ℝ, β = P ^ ((a + a) * ν) * (X₁ / (Lc : ℝ)) / (Tb : ℝ) := ⟨_, rfl⟩
  rw [← hβ] at hqG
  have hβ0 : 0 ≤ β := by rw [hβ]; exact div_nonneg (mul_nonneg hPn0 hε0) hTbpos.le
  have hrec1 : ∀ m l, ∃ e : ℤ, |(q : ℝ) * θ1 m l - (e : ℝ)| ≤ (ν : ℝ) ^ 2 * C₁ * β := by
    intro m
    apply kai_t2_coef_recover ν c lam C₁ β q (θ1 m) hβ0 hlam hid
    intro k i
    obtain ⟨e, he⟩ := (hqG (m, i) k).1
    rw [hG1] at he
    exact ⟨e, he⟩
  have hrec2 : ∀ m l, ∃ e : ℤ, |(q : ℝ) * θ2 m l - (e : ℝ)| ≤ (ν : ℝ) ^ 2 * C₁ * β := by
    intro m
    apply kai_t2_coef_recover ν c lam C₁ β q (θ2 m) hβ0 hlam hid
    intro k i
    obtain ⟨e, he⟩ := (hqG (m, i) k).2
    rw [hG2] at he
    exact ⟨e, he⟩
  
  have hνC0 : (0 : ℝ) ≤ (ν : ℝ) ^ 2 * C₁ := by linarith
  have hW2 : (ν : ℝ) ^ 2 * C₁ * P ^ ((a + a) * ν) * X₁ ≤ Λ := by
    have := mul_le_mul_of_nonneg_left hPn (mul_nonneg hνC0 hX₁0)
    linarith
  have hfin : (ν : ℝ) ^ 2 * C₁ * β ≤ X / Mh := by
    rw [le_div_iff₀ hMh]
    have hkey : (ν : ℝ) ^ 2 * C₁ * β * ((Lc : ℝ) * Tb)
        = (ν : ℝ) ^ 2 * C₁ * P ^ ((a + a) * ν) * X₁ := by
      rw [hβ]; field_simp
    have hA0 : 0 ≤ (ν : ℝ) ^ 2 * C₁ * β := mul_nonneg hνC0 hβ0
    have k1 : (ν : ℝ) ^ 2 * C₁ * β * Mh ≤ (ν : ℝ) ^ 2 * C₁ * β * (Kb * Lc * Tb) :=
      mul_le_mul_of_nonneg_left hMLT hA0
    have k2 : (ν : ℝ) ^ 2 * C₁ * β * (Kb * Lc * Tb)
        = Kb * ((ν : ℝ) ^ 2 * C₁ * P ^ ((a + a) * ν) * X₁) := by
      rw [← hkey]; ring
    have k3 : Kb * ((ν : ℝ) ^ 2 * C₁ * P ^ ((a + a) * ν) * X₁) ≤ Kb * Λ :=
      mul_le_mul_of_nonneg_left hW2 (by linarith)
    linarith
  have hqX : (q : ℝ) * X₁ ≤ X := by
    have k1 : (q : ℝ) * X₁ ≤ P ^ ((a + a) * ν) * X₁ := mul_le_mul_of_nonneg_right hqP hX₁0
    have k2 : P ^ ((a + a) * ν) * X₁ ≤ P ^ ((a + a) * ν + 1) * X₁ :=
      mul_le_mul_of_nonneg_right hPn hX₁0
    have k3 : Λ ≤ Kb * Λ := le_mul_of_one_le_left (by linarith) hKb
    linarith
  
  obtain ⟨kk, hkk⟩ : ∃ kk : Fin (a + a + (a + a)) → Fin a → ℤ,
      ∀ M j, kk M j = (q : ℤ) * Fin.append g.1 g.2 M j :=
    ⟨fun M j => (q : ℤ) * Fin.append g.1 g.2 M j, fun _ _ => rfl⟩
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq1
  have hkill : ∀ v : Fin a → ℝ, (∀ M, ∑ i, (kk M i : ℝ) * v i = 0) →
      ∀ M, ∑ i, (Fin.append g.1 g.2 M i : ℝ) * v i = 0 := by
    intro v hv M
    have h := hv M
    simp only [hkk] at h
    push_cast at h
    have h' : (q : ℝ) * ∑ i, (Fin.append g.1 g.2 M i : ℝ) * v i = 0 := by
      rw [Finset.mul_sum, ← h]
      exact Finset.sum_congr rfl (fun _ _ => by ring)
    exact (mul_eq_zero.mp h').resolve_left hq0.ne'
  unfold IsNil2VertStructSeq
  refine ⟨a, b, Bc, ξ, p₀, p₁, r₀, r₁, r₂, F, a + a + (a + a), kk, hdata, hφe, ?_, ?_, ?_⟩
  · intro M j
    rw [hkk]; push_cast
    rw [abs_mul, abs_of_pos hq0]
    have hgb : |(Fin.append g.1 g.2 M j : ℝ)| ≤ X₁ := by
      induction M using Fin.addCases with
      | left m => rw [Fin.append_left]; exact (hg m j).1
      | right m => rw [Fin.append_right]; exact (hg m j).2
    calc (q : ℝ) * |(Fin.append g.1 g.2 M j : ℝ)| ≤ q * X₁ :=
          mul_le_mul_of_nonneg_left hgb hq0.le
      _ ≤ X := hqX
  · intro v w hv hw
    exact hiso_g v w (hkill v hv) (hkill w hw)
  · intro M l
    induction M using Fin.addCases with
    | left m =>
      obtain ⟨e, he⟩ := hrec1 m l
      refine ⟨e, ?_⟩
      have hsum : ∑ i, ((kk (Fin.castAdd (a + a) m) i : ℤ) : ℝ) * p₁ l i
          = (q : ℝ) * θ1 m l := by
        simp only [hkk, Fin.append_left, hθ1]
        push_cast
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun _ _ => by ring)
      rw [hsum]; exact he.trans hfin
    | right m =>
      obtain ⟨e, he⟩ := hrec2 m l
      refine ⟨e, ?_⟩
      have hsum : ∑ i, ((kk (Fin.natAdd (a + a) m) i : ℤ) : ℝ) * p₁ l i
          = (q : ℝ) * θ2 m l := by
        simp only [hkk, Fin.append_right, hθ2]
        push_cast
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun _ _ => by ring)
      rw [hsum]; exact he.trans hfin

theorem kai_ip_ideal_family (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (𝔢 : Ideal (NumberField.RingOfIntegers K)) (h𝔢 : 𝔢 ≠ ⊥) :
    ∃ g : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K,
      (∀ k, g k ∈ 𝔢) ∧
      (∀ x ∈ 𝔢, ∃ t : Fin (Module.finrank ℚ K) → ℤ, x = ∑ k, t k • g k) ∧
      (∀ t : Fin (Module.finrank ℚ K) → ℤ, ∑ k, t k • g k = 0 → t = 0) :=
by
  classical
  let b := Ideal.selfBasis ω 𝔢 h𝔢
  have hcoe : ∀ t : Fin (Module.finrank ℚ K) → ℤ,
      ((∑ k, t k • b k : 𝔢) : NumberField.RingOfIntegers K)
        = ∑ k, t k • (b k : NumberField.RingOfIntegers K) := by
    intro t
    rw [Submodule.coe_sum]
    rfl
  refine ⟨fun k => (b k : NumberField.RingOfIntegers K), fun k => (b k).2, ?_, ?_⟩
  · intro x hx
    refine ⟨b.repr ⟨x, hx⟩, ?_⟩
    rw [← hcoe, b.sum_repr]
  · intro t ht
    have h0 : (∑ k, t k • b k : 𝔢) = 0 := by
      apply Subtype.ext
      rw [hcoe]
      exact ht
    funext k
    exact Fintype.linearIndependent_iff.mp b.linearIndependent t h0 k

theorem kai_ip_minkowski (K : Type u) [Field K] [NumberField K] :
    ∃ c₀ : ℝ, 1 ≤ c₀ ∧ ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ →
      ∃ a : NumberField.RingOfIntegers K, a ∈ 𝔡 ∧ a ≠ 0 ∧
        ∀ w : NumberField.InfinitePlace K,
          w (algebraMap (NumberField.RingOfIntegers K) K a) ≤
            c₀ * (Ideal.absNorm 𝔡 : ℝ) ^ ((1:ℝ) / (Module.finrank ℚ K : ℝ)) :=
by
  classical
  let b := NumberField.RingOfIntegers.basis K
  have hcard : Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K))
      = Module.finrank ℚ K :=
    (Module.finrank_eq_card_basis b).symm.trans (NumberField.RingOfIntegers.rank K)
  have hn : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  let Sw : NumberField.InfinitePlace K → ℝ :=
    fun w => ∑ i, w (algebraMap (NumberField.RingOfIntegers K) K (b i))
  have hSw0 : ∀ w, 0 ≤ Sw w := fun w => Finset.sum_nonneg (fun i _ => apply_nonneg _ _)
  have hS0 : 0 ≤ ∑ w, Sw w := Finset.sum_nonneg (fun w _ => hSw0 w)
  refine ⟨1 + ∑ w, Sw w, by linarith, ?_⟩
  intro 𝔡 h𝔡
  obtain ⟨r, hr_def⟩ : ∃ r : ℝ,
      r = (Ideal.absNorm 𝔡 : ℝ) ^ ((1:ℝ) / (Module.finrank ℚ K : ℝ)) := ⟨_, rfl⟩
  rw [← hr_def]
  have hr0 : 0 ≤ r := by rw [hr_def]; exact Real.rpow_nonneg (Nat.cast_nonneg _) _
  obtain ⟨m, hm_def⟩ : ∃ m : ℕ, m = ⌊r⌋₊ := ⟨_, rfl⟩
  have hm_le : (m : ℝ) ≤ r := by rw [hm_def]; exact Nat.floor_le hr0
  have hlt : Ideal.absNorm 𝔡 < (m + 1) ^ Module.finrank ℚ K := by
    have h1 : r < (m : ℝ) + 1 := by rw [hm_def]; exact Nat.lt_floor_add_one r
    have h2 : r ^ Module.finrank ℚ K < ((m : ℝ) + 1) ^ Module.finrank ℚ K :=
      pow_lt_pow_left₀ h1 hr0 (by omega)
    have h3 : r ^ Module.finrank ℚ K = (Ideal.absNorm 𝔡 : ℝ) := by
      rw [hr_def, one_div, Real.rpow_inv_natCast_pow (Nat.cast_nonneg _) (by omega)]
    rw [h3] at h2
    exact_mod_cast h2
  haveI : Finite (NumberField.RingOfIntegers K ⧸ 𝔡) := Ideal.finiteQuotientOfFreeOfNeBot 𝔡 h𝔡
  letI : Fintype (NumberField.RingOfIntegers K ⧸ 𝔡) := Fintype.ofFinite _
  have hQ : Fintype.card (NumberField.RingOfIntegers K ⧸ 𝔡) = Ideal.absNorm 𝔡 := by
    rw [Fintype.card_eq_nat_card, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply]
  have hcardlt : Fintype.card (NumberField.RingOfIntegers K ⧸ 𝔡) <
      Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K) → Fin (m + 1)) := by
    rw [hQ, Fintype.card_fun, Fintype.card_fin, hcard]; exact hlt
  let F : (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K) → Fin (m + 1)) →
      NumberField.RingOfIntegers K ⧸ 𝔡 :=
    fun s => Ideal.Quotient.mk 𝔡 (∑ i, ((s i : ℕ) : ℤ) • b i)
  obtain ⟨s, s', hss', hF⟩ := Fintype.exists_ne_map_eq_of_card_lt F hcardlt
  let t : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K) → ℤ :=
    fun i => ((s i : ℕ) : ℤ) - ((s' i : ℕ) : ℤ)
  have hmem : (∑ i, t i • b i) ∈ 𝔡 := by
    have h := Ideal.Quotient.eq.mp hF
    have he : (∑ i, t i • b i) = (∑ i, ((s i : ℕ) : ℤ) • b i) - ∑ i, ((s' i : ℕ) : ℤ) • b i := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [t, sub_smul]
    rw [he]; exact h
  have ht0 : t ≠ 0 := by
    intro h
    apply hss'
    funext i
    have h' := congrFun h i
    simp only [t, Pi.zero_apply, sub_eq_zero] at h'
    exact Fin.ext (by exact_mod_cast h')
  have htb : ∀ i, |(t i : ℝ)| ≤ (m : ℝ) := by
    intro i
    have h1 := (s i).is_lt
    have h2 := (s' i).is_lt
    have h3 : |t i| ≤ (m : ℤ) := by
      rw [abs_le]; simp only [t]; constructor <;> omega
    have h4 := (Int.cast_le (R := ℝ)).mpr h3
    rwa [Int.cast_abs, Int.cast_natCast] at h4
  refine ⟨∑ i, t i • b i, hmem, ?_, ?_⟩
  · intro h0
    apply ht0
    have h1 : b.equivFun.symm t = 0 := by rw [Module.Basis.equivFun_symm_apply]; exact h0
    exact (LinearEquiv.map_eq_zero_iff b.equivFun.symm).mp h1
  · intro w
    have hplace : w (algebraMap (NumberField.RingOfIntegers K) K (∑ i, t i • b i))
        ≤ (m : ℝ) * Sw w := by
      rw [map_sum]
      calc w (∑ i, algebraMap (NumberField.RingOfIntegers K) K (t i • b i))
          ≤ ∑ i, w (algebraMap (NumberField.RingOfIntegers K) K (t i • b i)) :=
            AbsoluteValue.sum_le w.1 Finset.univ _
        _ ≤ ∑ i, (m : ℝ) * w (algebraMap (NumberField.RingOfIntegers K) K (b i)) := by
            apply Finset.sum_le_sum
            intro i _
            rw [map_zsmul, zsmul_eq_mul]
            change w.1 ((t i : K) * algebraMap (NumberField.RingOfIntegers K) K (b i)) ≤ _
            rw [AbsoluteValue.map_mul]
            change w (t i : K) * w (algebraMap (NumberField.RingOfIntegers K) K (b i)) ≤ _
            rw [NumberField.InfinitePlace.map_intCast, Int.norm_eq_abs]
            exact mul_le_mul_of_nonneg_right (htb i) (apply_nonneg _ _)
        _ = (m : ℝ) * Sw w := (Finset.mul_sum _ _ _).symm
    have hSwle : Sw w ≤ 1 + ∑ w, Sw w := by
      have := Finset.single_le_sum (f := Sw) (fun w _ => hSw0 w) (Finset.mem_univ w)
      linarith
    calc _ ≤ (m : ℝ) * Sw w := hplace
      _ ≤ r * (1 + ∑ w, Sw w) := mul_le_mul hm_le hSwle (hSw0 w) hr0
      _ = _ := mul_comm _ _

theorem kai_ip_norm_le_place (K : Type u) [Field K] [NumberField K]
    (a : NumberField.RingOfIntegers K) (B : ℝ) (hB : 0 ≤ B)
    (ha : ∀ w : NumberField.InfinitePlace K,
      w (algebraMap (NumberField.RingOfIntegers K) K a) ≤ B)
    (w₀ : NumberField.InfinitePlace K) :
    ((Algebra.norm ℤ a).natAbs : ℝ) ≤
      w₀ (algebraMap (NumberField.RingOfIntegers K) K a) * B ^ (Module.finrank ℚ K - 1) :=
by
  classical
  set x : K := algebraMap (NumberField.RingOfIntegers K) K a with hx
  have hF1 : ∀ w : NumberField.InfinitePlace K, 0 ≤ w x := fun w => apply_nonneg w x
  
  have hs1 : ((Algebra.norm ℤ a).natAbs : ℝ)
      = ∏ w : NumberField.InfinitePlace K, w x ^ w.mult := by
    rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs,
      Rat.cast_abs]
    congr 1
    rw [hx, ← Algebra.coe_norm_int]
    push_cast
    rfl
  
  rw [hs1, Fintype.prod_eq_mul_prod_compl w₀]
  
  have hm0 : 0 < w₀.mult := NumberField.InfinitePlace.mult_pos
  have hsum : ∑ w : NumberField.InfinitePlace K, w.mult = Module.finrank ℚ K :=
    NumberField.InfinitePlace.sum_mult_eq
  rw [Fintype.sum_eq_add_sum_compl w₀] at hsum
  
  have hs3 : w₀ x ^ w₀.mult ≤ w₀ x * B ^ (w₀.mult - 1) := by
    rw [← mul_pow_sub_one hm0.ne' (w₀ x)]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (hF1 w₀) (ha w₀) _) (hF1 w₀)
  
  have hs4 : ∏ w ∈ ({w₀}ᶜ : Finset _), w x ^ w.mult
      ≤ B ^ (∑ w ∈ ({w₀}ᶜ : Finset _), w.mult) := by
    rw [← Finset.prod_pow_eq_pow_sum]
    exact Finset.prod_le_prod (fun w _ => pow_nonneg (hF1 w) _)
      (fun w _ => pow_le_pow_left₀ (hF1 w) (ha w) _)
  have hP0 : 0 ≤ ∏ w ∈ ({w₀}ᶜ : Finset _), w x ^ w.mult :=
    Finset.prod_nonneg (fun w _ => pow_nonneg (hF1 w) _)
  have hexp : (w₀.mult - 1) + ∑ w ∈ ({w₀}ᶜ : Finset _), w.mult
      = Module.finrank ℚ K - 1 := by omega
  calc w₀ x ^ w₀.mult * ∏ w ∈ ({w₀}ᶜ : Finset _), w x ^ w.mult
      ≤ (w₀ x * B ^ (w₀.mult - 1)) * B ^ (∑ w ∈ ({w₀}ᶜ : Finset _), w.mult) :=
        mul_le_mul hs3 hs4 hP0 (mul_nonneg (hF1 w₀) (pow_nonneg hB _))
    _ = w₀ x * B ^ (Module.finrank ℚ K - 1) := by
        rw [mul_assoc, ← pow_add, hexp]

theorem kai_ip_coord_bound (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (g : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K) (m : ℕ) (hm : 0 < m)
    (hind : ∀ t : Fin (Module.finrank ℚ K) → ℤ, ∑ k, t k • g k = 0 → t = 0)
    (hspan : ∀ l, ∃ β : Fin (Module.finrank ℚ K) → ℤ,
      (m : NumberField.RingOfIntegers K) * ω l = ∑ k, β k • g k) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ (t : Fin (Module.finrank ℚ K) → ℤ) (k : Fin (Module.finrank ℚ K)),
      |(t k : ℝ)| ≤ D * basisSupNorm ω (∑ j, t j • g j) :=
by
  classical
  choose β hβ using hspan
  refine ⟨∑ l, ∑ k, |(β l k : ℝ)|,
    Finset.sum_nonneg (fun l _ => Finset.sum_nonneg (fun k _ => abs_nonneg _)), ?_⟩
  intro t k
  obtain ⟨x, hx⟩ : ∃ x : NumberField.RingOfIntegers K, x = ∑ j, t j • g j := ⟨_, rfl⟩
  rw [← hx]
  have hxr : ∑ l, ((ω.repr x l : ℤ) : NumberField.RingOfIntegers K) * ω l = x := by
    conv_rhs => rw [← ω.sum_repr x]
    simp only [zsmul_eq_mul]
  have hid : ∀ k, (m : ℤ) * t k = ∑ l, ω.repr x l * β l k := by
    have h1 : ∑ k, ((m : ℤ) * t k) • g k = (m : NumberField.RingOfIntegers K) * x := by
      rw [hx, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp only [zsmul_eq_mul]
      push_cast
      ring
    have h2 : ∑ k, (∑ l, ω.repr x l * β l k) • g k
        = (m : NumberField.RingOfIntegers K) * x := by
      conv_rhs => rw [← hxr]
      rw [Finset.mul_sum]
      simp only [zsmul_eq_mul] at hβ ⊢
      have e : ∀ l, (m : NumberField.RingOfIntegers K) *
          (((ω.repr x l : ℤ) : NumberField.RingOfIntegers K) * ω l)
          = ∑ k, ((ω.repr x l : ℤ) : NumberField.RingOfIntegers K) *
              ((β l k : NumberField.RingOfIntegers K) * g k) := by
        intro l
        rw [← Finset.mul_sum, ← hβ l]
        ring
      rw [Finset.sum_congr rfl (fun l _ => e l), Finset.sum_comm]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      push_cast
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      ring
    have hzero : ∑ k, ((m : ℤ) * t k - ∑ l, ω.repr x l * β l k) • g k = 0 := by
      simp only [sub_smul, Finset.sum_sub_distrib, h1, h2, sub_self]
    intro k
    have := congrFun (hind _ hzero) k
    simpa [sub_eq_zero] using this
  have hS : ∀ l, |((ω.repr x l : ℤ) : ℝ)| ≤ basisSupNorm ω x := by
    intro l
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr x j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove l
  have hS0 : 0 ≤ basisSupNorm ω x := by
    unfold basisSupNorm
    exact Real.iSup_nonneg (fun j => abs_nonneg _)
  have hrow : ∑ l, |(β l k : ℝ)| ≤ ∑ l, ∑ k', |(β l k' : ℝ)| :=
    Finset.sum_le_sum (fun l _ => Finset.single_le_sum (f := fun k' => |(β l k' : ℝ)|)
      (fun _ _ => abs_nonneg _) (Finset.mem_univ k))
  have hR : (m : ℝ) * (t k : ℝ) = ∑ l, ((ω.repr x l : ℤ) : ℝ) * (β l k : ℝ) := by
    have := congrArg (Int.cast : ℤ → ℝ) (hid k)
    push_cast at this
    exact this
  have h1m : (1 : ℝ) ≤ m := Nat.one_le_cast.mpr hm
  calc |(t k : ℝ)| ≤ (m : ℝ) * |(t k : ℝ)| := le_mul_of_one_le_left (abs_nonneg _) h1m
    _ = |(m : ℝ) * (t k : ℝ)| := by rw [abs_mul, Nat.abs_cast]
    _ = |∑ l, ((ω.repr x l : ℤ) : ℝ) * (β l k : ℝ)| := by rw [hR]
    _ ≤ ∑ l, |((ω.repr x l : ℤ) : ℝ) * (β l k : ℝ)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ l, basisSupNorm ω x * |(β l k : ℝ)| := by
        refine Finset.sum_le_sum (fun l _ => ?_)
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_right (hS l) (abs_nonneg _)
    _ = basisSupNorm ω x * ∑ l, |(β l k : ℝ)| := by rw [Finset.mul_sum]
    _ ≤ basisSupNorm ω x * ∑ l, ∑ k', |(β l k' : ℝ)| := mul_le_mul_of_nonneg_left hrow hS0
    _ = (∑ l, ∑ k', |(β l k' : ℝ)|) * basisSupNorm ω x := mul_comm _ _

theorem kai_ip_lam_exists (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (𝔢 𝔣 : Ideal (NumberField.RingOfIntegers K)) (m : ℕ) (hm : 0 < m)
    (hm𝔢𝔣 : Ideal.span {(m : NumberField.RingOfIntegers K)} = 𝔢 * 𝔣)
    (g f : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K)
    (hgspan : ∀ x ∈ 𝔢, ∃ t : Fin (Module.finrank ℚ K) → ℤ, x = ∑ k, t k • g k)
    (hfspan : ∀ y ∈ 𝔣, ∃ s : Fin (Module.finrank ℚ K) → ℤ, y = ∑ i, s i • f i)
    (hh : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K)
    (hhh : ∀ k i, (m : NumberField.RingOfIntegers K) * hh k i = g k * f i) :
    ∃ lam : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℤ,
      ∀ l l', ∑ k, ∑ i, lam l k i * ω.repr (hh k i) l' = if l = l' then 1 else 0 :=
by
  have hmul : ∀ z ∈ 𝔢 * 𝔣, ∃ u : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℤ,
      z = ∑ k, ∑ i, u k i • (g k * f i) := by
    intro z hz
    refine Submodule.mul_induction_on hz ?_ ?_
    · intro e he y hy
      obtain ⟨t, rfl⟩ := hgspan e he
      obtain ⟨s, rfl⟩ := hfspan y hy
      refine ⟨fun k i => t k * s i, ?_⟩
      rw [Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun i _ => ?_))
      rw [smul_mul_smul_comm]
    · rintro x y ⟨u, rfl⟩ ⟨u', rfl⟩
      refine ⟨fun k i => u k i + u' k i, ?_⟩
      simp only [add_smul, Finset.sum_add_distrib]
  have hm0 : (m : NumberField.RingOfIntegers K) ≠ 0 := Nat.cast_ne_zero.mpr hm.ne'
  have hcomb : ∀ l, ∃ u : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℤ,
      ω l = ∑ k, ∑ i, u k i • hh k i := by
    intro l
    have hmem : (m : NumberField.RingOfIntegers K) * ω l ∈ 𝔢 * 𝔣 := by
      rw [← hm𝔢𝔣]; exact Ideal.mem_span_singleton.mpr (dvd_mul_right _ _)
    obtain ⟨u, hu⟩ := hmul _ hmem
    refine ⟨u, ?_⟩
    apply mul_left_cancel₀ hm0
    rw [hu, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [mul_smul_comm, hhh]
  choose lam hlam using hcomb
  refine ⟨lam, fun l l' => ?_⟩
  have h := congrArg (fun x => ω.repr x l') (hlam l)
  simp only [Module.Basis.repr_self, Finsupp.single_apply, map_sum, map_zsmul,
    Finsupp.coe_finset_sum, Finset.sum_apply, Finsupp.smul_apply, smul_eq_mul] at h
  exact h.symm

theorem kai_ip_label_param (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (𝔢 𝔣 : Ideal (NumberField.RingOfIntegers K)) (m : ℕ) (hm : 0 < m)
    (hm𝔢𝔣 : Ideal.span {(m : NumberField.RingOfIntegers K)} = 𝔢 * 𝔣)
    (g f : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K)
    (hfmem : ∀ i, f i ∈ 𝔣)
    (hfspan : ∀ y ∈ 𝔣, ∃ s : Fin (Module.finrank ℚ K) → ℤ, y = ∑ i, s i • f i)
    (hh : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K)
    (hhh : ∀ k i, (m : NumberField.RingOfIntegers K) * hh k i = g k * f i) :
    (∀ t w : Fin (Module.finrank ℚ K) → ℤ,
      (m : NumberField.RingOfIntegers K) *
          ω.equivFun.symm (kaiBil (fun k i l => ω.repr (hh k i) l) t w)
        = (∑ k, t k • g k) * (∑ i, w i • f i)) ∧
    (∀ (𝔡 : Ideal (NumberField.RingOfIntegers K)) (a : NumberField.RingOfIntegers K),
      Ideal.span {a} = 𝔡 * 𝔢 → ∀ x : NumberField.RingOfIntegers K,
        (x ∈ 𝔡 ↔ ∃ w : Fin (Module.finrank ℚ K) → ℤ,
          (m : NumberField.RingOfIntegers K) * x = a * ∑ i, w i • f i)) :=
by
  classical
  refine ⟨fun t w => ?_, fun 𝔡 a ha x => ?_⟩
  · have hX : ω.equivFun.symm (kaiBil (fun k i l => ω.repr (hh k i) l) t w)
        = ∑ k, ∑ i, (t k * w i) • hh k i := by
      rw [LinearEquiv.symm_apply_eq]
      funext l
      rw [Module.Basis.equivFun_apply]
      simp only [map_sum, map_zsmul, Finsupp.coe_finset_sum, Finset.sum_apply,
        Finsupp.smul_apply, smul_eq_mul, kaiBil]
    rw [hX, Finset.mul_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have h := hhh k i
    simp only [zsmul_eq_mul, Int.cast_mul]
    linear_combination ((t k : NumberField.RingOfIntegers K) * (w i : NumberField.RingOfIntegers K)) * h
  · have hid : 𝔡 * Ideal.span {(m : NumberField.RingOfIntegers K)} = Ideal.span {a} * 𝔣 := by
      rw [hm𝔢𝔣, ha, mul_assoc]
    have hm0 : (m : NumberField.RingOfIntegers K) ≠ 0 := Nat.cast_ne_zero.mpr hm.ne'
    constructor
    · intro hx
      have h1 : x * (m : NumberField.RingOfIntegers K) ∈ Ideal.span {a} * 𝔣 := by
        rw [← hid]; exact Ideal.mul_mem_mul hx (Ideal.mem_span_singleton_self _)
      obtain ⟨y, hy, hay⟩ := Ideal.mem_span_singleton_mul.mp h1
      obtain ⟨s, rfl⟩ := hfspan y hy
      exact ⟨s, by rw [hay, mul_comm]⟩
    · rintro ⟨w, hw⟩
      have hY : (∑ i, w i • f i) ∈ 𝔣 :=
        Ideal.sum_mem 𝔣 (fun i _ => zsmul_mem (hfmem i) (w i))
      have h1 : a * ∑ i, w i • f i ∈ 𝔡 * Ideal.span {(m : NumberField.RingOfIntegers K)} := by
        rw [hid]; exact Ideal.mem_span_singleton_mul.mpr ⟨_, hY, rfl⟩
      obtain ⟨d, hd, hdm⟩ := Ideal.mem_mul_span_singleton.mp h1
      have hdx : d = x := by
        apply mul_left_cancel₀ hm0
        rw [mul_comm, hdm, hw]
      rw [← hdx]; exact hd

theorem kai_ip_quot_small (K : Type u) [Field K] [NumberField K]
    (a x y : NumberField.RingOfIntegers K) (m : ℕ) (c₀ s X : ℝ)
    (hc₀ : 1 ≤ c₀) (hs : 0 < s)
    (hlow : ∀ v : NumberField.InfinitePlace K,
      s ^ Module.finrank ℚ K ≤
        v (algebraMap (NumberField.RingOfIntegers K) K a) * (c₀ * s) ^ (Module.finrank ℚ K - 1))
    (hxy : (m : NumberField.RingOfIntegers K) * x = a * y)
    (hx : ∀ v : NumberField.InfinitePlace K,
      v (algebraMap (NumberField.RingOfIntegers K) K x) ≤ X) :
    ∀ v : NumberField.InfinitePlace K,
      v (algebraMap (NumberField.RingOfIntegers K) K y) ≤
        (m : ℝ) * c₀ ^ (Module.finrank ℚ K - 1) * X / s :=
by
  intro v
  have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
  obtain ⟨k, hk⟩ : ∃ k, Module.finrank ℚ K = k + 1 := ⟨Module.finrank ℚ K - 1, by omega⟩
  have hl := hlow v
  rw [hk, Nat.add_sub_cancel] at hl
  rw [hk, Nat.add_sub_cancel]
  set A := v (algebraMap (NumberField.RingOfIntegers K) K a) with hA
  set X' := v (algebraMap (NumberField.RingOfIntegers K) K x) with hX'
  set Y' := v (algebraMap (NumberField.RingOfIntegers K) K y) with hY'
  have hA0 : 0 ≤ A := apply_nonneg v _
  have hY0 : 0 ≤ Y' := apply_nonneg v _
  have hxX : X' ≤ X := hx v
  have hc0 : 0 ≤ c₀ ^ k := pow_nonneg (by linarith) k
  have hsk : 0 < s ^ k := pow_pos hs k
  have hm0 : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
  have h2 : s ≤ A * c₀ ^ k := by
    have h' : s * s ^ k ≤ (A * c₀ ^ k) * s ^ k := by
      have e1 : s ^ (k + 1) = s * s ^ k := by ring
      have e2 : A * (c₀ * s) ^ k = (A * c₀ ^ k) * s ^ k := by rw [mul_pow]; ring
      rw [← e1, ← e2]; exact hl
    exact le_of_mul_le_mul_right h' hsk
  have h3 : (m : ℝ) * X' = A * Y' := by
    have := congrArg (fun z => v (algebraMap (NumberField.RingOfIntegers K) K z)) hxy
    simp only [map_mul, map_natCast] at this
    rw [NumberField.InfinitePlace.map_natCast] at this
    exact this
  rw [le_div_iff₀ hs]
  calc Y' * s ≤ Y' * (A * c₀ ^ k) := mul_le_mul_of_nonneg_left h2 hY0
    _ = ((m : ℝ) * X') * c₀ ^ k := by rw [h3]; ring
    _ ≤ ((m : ℝ) * X) * c₀ ^ k :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hxX hm0) hc0
    _ = (m : ℝ) * c₀ ^ k * X := by ring

theorem kai_t2_ideal_param (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ (C₁ : ℝ) (h : ℕ)
      (c lam : Fin h → Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) →
        Fin (Module.finrank ℚ K) → ℤ)
      (G : Ideal (NumberField.RingOfIntegers K) → Fin h)
      (tt : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K) → ℤ),
      1 ≤ C₁ ∧
      (∀ g k i l, |(c g k i l : ℝ)| ≤ C₁) ∧ (∀ g l k i, |(lam g l k i : ℝ)| ≤ C₁) ∧
      (∀ g l l', ∑ k, ∑ i, lam g l k i * c g k i l' = if l = l' then 1 else 0) ∧
      (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ → ∀ k,
        |(tt 𝔡 k : ℝ)| ≤ C₁ * (Ideal.absNorm 𝔡 : ℝ) ^ ((1:ℝ) / (Module.finrank ℚ K : ℝ))) ∧
      (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ →
        ∀ x : NumberField.RingOfIntegers K,
          x ∈ 𝔡 ↔ ∃ w, ω.equivFun x = kaiBil (c (G 𝔡)) (tt 𝔡) w) ∧
      (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ →
        Function.Injective (kaiBil (c (G 𝔡)) (tt 𝔡))) ∧
      (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ →
        ∀ (Mb : ℝ) (w : Fin (Module.finrank ℚ K) → ℤ), 0 ≤ Mb →
          (∀ l, |(kaiBil (c (G 𝔡)) (tt 𝔡) w l : ℝ)| ≤ Mb) →
          ∀ i, |(w i : ℝ)| ≤
            C₁ * Mb / (Ideal.absNorm 𝔡 : ℝ) ^ ((1:ℝ) / (Module.finrank ℚ K : ℝ))) ∧
      (∀ 𝔡 𝔡' : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ → 𝔡' ≠ ⊥ → G 𝔡 = G 𝔡' →
        ∀ (w : Fin (Module.finrank ℚ K) → ℤ) (𝔡₁ : Ideal (NumberField.RingOfIntegers K)),
          (Ideal.span {ω.equivFun.symm (kaiBil (c (G 𝔡)) (tt 𝔡) w)} = 𝔡₁ * 𝔡 ↔
           Ideal.span {ω.equivFun.symm (kaiBil (c (G 𝔡')) (tt 𝔡') w)} = 𝔡₁ * 𝔡')) ∧
      (∀ 𝔡 𝔡' : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ → 𝔡' ≠ ⊥ → G 𝔡 = G 𝔡' →
        tt 𝔡 = tt 𝔡' → 𝔡 = 𝔡') :=
by
  classical
  
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hn0 : Module.finrank ℚ K ≠ 0 := by omega
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hbSN_le_can : ∀ x : NumberField.RingOfIntegers K,
      basisSupNorm ω x ≤ C * canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) := by
    intro x
    have h1 := (hω.2 x).1
    have h2 : C * (C⁻¹ * basisSupNorm ω x) = basisSupNorm ω x := by field_simp
    calc basisSupNorm ω x = C * (C⁻¹ * basisSupNorm ω x) := h2.symm
      _ ≤ C * canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) :=
          mul_le_mul_of_nonneg_left h1 hCpos.le
  have hplace_le_can : ∀ (y : K) (v : NumberField.InfinitePlace K), v y ≤ canNorm K y := by
    intro y v
    unfold canNorm
    exact le_ciSup (f := fun w : NumberField.InfinitePlace K => w y)
      (Set.finite_range _).bddAbove v
  have hcan_le : ∀ (y : K) (B : ℝ), (∀ v : NumberField.InfinitePlace K, v y ≤ B) →
      canNorm K y ≤ B := by
    intro y B hB
    unfold canNorm
    exact ciSup_le hB
  have hrepr_le_bSN : ∀ (x : NumberField.RingOfIntegers K) (j : Fin (Module.finrank ℚ K)),
      |((ω.repr x j : ℤ) : ℝ)| ≤ basisSupNorm ω x := by
    intro x j
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr x j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  have hbSN0 : ∀ x : NumberField.RingOfIntegers K, 0 ≤ basisSupNorm ω x :=
    fun x => (abs_nonneg _).trans (hrepr_le_bSN x ⟨0, by omega⟩)
  haveI : Nonempty (Fin (Module.finrank ℚ K)) := ⟨⟨0, by omega⟩⟩
  have hbSN_le : ∀ (x : NumberField.RingOfIntegers K) (B : ℝ),
      (∀ j, |((ω.repr x j : ℤ) : ℝ)| ≤ B) → basisSupNorm ω x ≤ B := by
    intro x B hB
    unfold basisSupNorm
    exact ciSup_le hB
  
  obtain ⟨c₀, hc₀, hmink⟩ := kai_ip_minkowski K
  have hc₀pos : 0 < c₀ := by linarith
  have hc₀n : 1 ≤ c₀ ^ Module.finrank ℚ K := one_le_pow₀ hc₀
  obtain ⟨X₀, hX₀⟩ : ∃ X₀ : ℕ, X₀ = ⌊c₀ ^ Module.finrank ℚ K⌋₊ := ⟨_, rfl⟩
  have hX₀1 : 1 ≤ X₀ := by
    rw [hX₀]; exact Nat.le_floor (by rw [Nat.cast_one]; exact hc₀n)
  
  have hlab : ∀ 𝔢 : Ideal (NumberField.RingOfIntegers K),
      ∃ (gg ff : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K)
        (𝔣 : Ideal (NumberField.RingOfIntegers K))
        (hh : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K)
        (lamv : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) →
          Fin (Module.finrank ℚ K) → ℤ)
        (D1 D2 : ℝ), 𝔢 ≠ ⊥ →
        (∀ x ∈ 𝔢, ∃ t : Fin (Module.finrank ℚ K) → ℤ, x = ∑ k, t k • gg k) ∧
        (∀ i, ff i ∈ 𝔣) ∧
        (∀ y ∈ 𝔣, ∃ s : Fin (Module.finrank ℚ K) → ℤ, y = ∑ i, s i • ff i) ∧
        (∀ s : Fin (Module.finrank ℚ K) → ℤ, ∑ i, s i • ff i = 0 → s = 0) ∧
        Ideal.span {((Ideal.absNorm 𝔢 : ℕ) : NumberField.RingOfIntegers K)} = 𝔢 * 𝔣 ∧
        (∀ k i, ((Ideal.absNorm 𝔢 : ℕ) : NumberField.RingOfIntegers K) * hh k i
          = gg k * ff i) ∧
        (∀ l l', ∑ k, ∑ i, lamv l k i * ω.repr (hh k i) l' = if l = l' then 1 else 0) ∧
        (∀ (t : Fin (Module.finrank ℚ K) → ℤ) (k : Fin (Module.finrank ℚ K)),
          |(t k : ℝ)| ≤ D1 * basisSupNorm ω (∑ j, t j • gg j)) ∧
        (∀ (t : Fin (Module.finrank ℚ K) → ℤ) (k : Fin (Module.finrank ℚ K)),
          |(t k : ℝ)| ≤ D2 * basisSupNorm ω (∑ j, t j • ff j)) := by
    intro 𝔢
    by_cases h𝔢 : 𝔢 = ⊥
    · exact ⟨0, 0, ⊥, 0, 0, 0, 0, fun h => absurd h𝔢 h⟩
    obtain ⟨gg, hgmem, hgspan, hgind⟩ := kai_ip_ideal_family K ω 𝔢 h𝔢
    have hm0 : 0 < Ideal.absNorm 𝔢 :=
      Nat.pos_of_ne_zero (fun h => h𝔢 (Ideal.absNorm_eq_zero_iff.mp h))
    have hmmem : ((Ideal.absNorm 𝔢 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔢 :=
      Ideal.absNorm_mem 𝔢
    obtain ⟨𝔣, hm𝔢𝔣⟩ : 𝔢 ∣ Ideal.span {((Ideal.absNorm 𝔢 : ℕ) : NumberField.RingOfIntegers K)} :=
      Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem _).mpr hmmem)
    have hmne : ((Ideal.absNorm 𝔢 : ℕ) : NumberField.RingOfIntegers K) ≠ 0 :=
      Nat.cast_ne_zero.mpr hm0.ne'
    have h𝔣 : 𝔣 ≠ ⊥ := by
      intro h
      rw [h, Ideal.mul_bot] at hm𝔢𝔣
      exact hmne (Ideal.span_singleton_eq_bot.mp hm𝔢𝔣)
    obtain ⟨ff, hfmem, hfspan, hfind⟩ := kai_ip_ideal_family K ω 𝔣 h𝔣
    have hhh : ∀ k i, ∃ z : NumberField.RingOfIntegers K,
        ((Ideal.absNorm 𝔢 : ℕ) : NumberField.RingOfIntegers K) * z = gg k * ff i := by
      intro k i
      have hmem : gg k * ff i ∈
          Ideal.span {((Ideal.absNorm 𝔢 : ℕ) : NumberField.RingOfIntegers K)} := by
        rw [hm𝔢𝔣]; exact Ideal.mul_mem_mul (hgmem k) (hfmem i)
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hmem
      exact ⟨z, by rw [mul_comm]; exact hz⟩
    choose hh hhh using hhh
    obtain ⟨lamv, hlamv⟩ :=
      kai_ip_lam_exists K ω 𝔢 𝔣 (Ideal.absNorm 𝔢) hm0 hm𝔢𝔣 gg ff hgspan hfspan hh hhh
    obtain ⟨D1, -, hD1b⟩ := kai_ip_coord_bound K ω gg (Ideal.absNorm 𝔢) hm0 hgind
      (fun l => hgspan _ (Ideal.mul_mem_right (ω l) 𝔢 hmmem))
    have hm'0 : 0 < Ideal.absNorm 𝔣 :=
      Nat.pos_of_ne_zero (fun h => h𝔣 (Ideal.absNorm_eq_zero_iff.mp h))
    obtain ⟨D2, -, hD2b⟩ := kai_ip_coord_bound K ω ff (Ideal.absNorm 𝔣) hm'0 hfind
      (fun l => hfspan _ (Ideal.mul_mem_right (ω l) 𝔣 (Ideal.absNorm_mem 𝔣)))
    exact ⟨gg, ff, 𝔣, hh, lamv, D1, D2,
      fun _ => ⟨hgspan, hfmem, hfspan, hfind, hm𝔢𝔣, hhh, hlamv, hD1b, hD2b⟩⟩
  choose GG FF FI HH LAM D1 D2 hlab using hlab
  
  have hEfin : {𝔢 : Ideal (NumberField.RingOfIntegers K) |
      Ideal.absNorm 𝔢 ≤ X₀ ∧ 𝔢 ≠ ⊥}.Finite :=
    (Ideal.finite_setOf_absNorm_le (S := NumberField.RingOfIntegers K) X₀).subset
      (fun _ h => h.1)
  obtain ⟨Es, hEs⟩ : ∃ Es : Finset (Ideal (NumberField.RingOfIntegers K)),
      ∀ 𝔢, 𝔢 ∈ Es ↔ (Ideal.absNorm 𝔢 ≤ X₀ ∧ 𝔢 ≠ ⊥) :=
    ⟨hEfin.toFinset, fun 𝔢 => Set.Finite.mem_toFinset hEfin⟩
  have htopEs : (⊤ : Ideal (NumberField.RingOfIntegers K)) ∈ Es :=
    (hEs ⊤).mpr ⟨by rw [Ideal.absNorm_top]; exact hX₀1, top_ne_bot⟩
  have hEsne : ∀ 𝔢 ∈ Es, 𝔢 ≠ ⊥ := fun 𝔢 h => ((hEs 𝔢).mp h).2
  
  obtain ⟨sf, hsf⟩ : ∃ sf : Ideal (NumberField.RingOfIntegers K) → ℝ, ∀ 𝔡,
      sf 𝔡 = (Ideal.absNorm 𝔡 : ℝ) ^ ((1:ℝ) / (Module.finrank ℚ K : ℝ)) := ⟨_, fun _ => rfl⟩
  have hdat : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K),
      ∃ (𝔢 : Ideal (NumberField.RingOfIntegers K)) (a : NumberField.RingOfIntegers K)
        (t : Fin (Module.finrank ℚ K) → ℤ), 𝔢 ∈ Es ∧
      (𝔡 ≠ ⊥ → a ∈ 𝔡 ∧ a ≠ 0 ∧ Ideal.span {a} = 𝔡 * 𝔢 ∧ a = ∑ k, t k • GG 𝔢 k ∧
        (∀ v : NumberField.InfinitePlace K,
          v (algebraMap (NumberField.RingOfIntegers K) K a) ≤ c₀ * sf 𝔡) ∧
        (∀ v : NumberField.InfinitePlace K, sf 𝔡 ^ Module.finrank ℚ K ≤
          v (algebraMap (NumberField.RingOfIntegers K) K a) *
            (c₀ * sf 𝔡) ^ (Module.finrank ℚ K - 1)) ∧
        0 < sf 𝔡) := by
    intro 𝔡
    by_cases h𝔡 : 𝔡 = ⊥
    · exact ⟨⊤, 0, 0, htopEs, fun h => absurd h𝔡 h⟩
    obtain ⟨a, ha𝔡, ha0, habd⟩ := hmink 𝔡 h𝔡
    rw [← hsf] at habd
    obtain ⟨𝔢, h𝔢⟩ : 𝔡 ∣ Ideal.span {a} :=
      Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem _).mpr ha𝔡)
    have h𝔢0 : 𝔢 ≠ ⊥ := by
      intro h
      rw [h, Ideal.mul_bot] at h𝔢
      exact ha0 (Ideal.span_singleton_eq_bot.mp h𝔢)
    have hN𝔡pos : 0 < Ideal.absNorm 𝔡 :=
      Nat.pos_of_ne_zero (fun h => h𝔡 (Ideal.absNorm_eq_zero_iff.mp h))
    have hN𝔢pos : 0 < Ideal.absNorm 𝔢 :=
      Nat.pos_of_ne_zero (fun h => h𝔢0 (Ideal.absNorm_eq_zero_iff.mp h))
    have hN𝔡R : (0:ℝ) < Ideal.absNorm 𝔡 := by exact_mod_cast hN𝔡pos
    have hN𝔢R : (1:ℝ) ≤ Ideal.absNorm 𝔢 := by exact_mod_cast hN𝔢pos
    have hspos : 0 < sf 𝔡 := by rw [hsf]; exact Real.rpow_pos_of_pos hN𝔡R _
    have hsn : sf 𝔡 ^ Module.finrank ℚ K = (Ideal.absNorm 𝔡 : ℝ) := by
      rw [hsf, one_div]; exact Real.rpow_inv_natCast_pow hN𝔡R.le hn0
    have hnorm : ((Algebra.norm ℤ a).natAbs : ℝ)
        = (Ideal.absNorm 𝔡 : ℝ) * (Ideal.absNorm 𝔢 : ℝ) := by
      have := congrArg Ideal.absNorm h𝔢
      rw [Ideal.absNorm_span_singleton, map_mul] at this
      exact_mod_cast this
    have hB : 0 ≤ c₀ * sf 𝔡 := by positivity
    have hlow : ∀ v : NumberField.InfinitePlace K, sf 𝔡 ^ Module.finrank ℚ K ≤
        v (algebraMap (NumberField.RingOfIntegers K) K a) *
          (c₀ * sf 𝔡) ^ (Module.finrank ℚ K - 1) := by
      intro v
      have h2 := kai_ip_norm_le_place K a (c₀ * sf 𝔡) hB habd v
      rw [hnorm] at h2
      rw [hsn]
      calc (Ideal.absNorm 𝔡 : ℝ) = (Ideal.absNorm 𝔡 : ℝ) * 1 := (mul_one _).symm
        _ ≤ (Ideal.absNorm 𝔡 : ℝ) * (Ideal.absNorm 𝔢 : ℝ) :=
            mul_le_mul_of_nonneg_left hN𝔢R hN𝔡R.le
        _ ≤ _ := h2
    have hN𝔢le : Ideal.absNorm 𝔢 ≤ X₀ := by
      obtain ⟨v₀⟩ := (inferInstance : Nonempty (NumberField.InfinitePlace K))
      have h2 := kai_ip_norm_le_place K a (c₀ * sf 𝔡) hB habd v₀
      rw [hnorm] at h2
      have h3 : (Ideal.absNorm 𝔡 : ℝ) * (Ideal.absNorm 𝔢 : ℝ)
          ≤ (Ideal.absNorm 𝔡 : ℝ) * c₀ ^ Module.finrank ℚ K := by
        calc (Ideal.absNorm 𝔡 : ℝ) * (Ideal.absNorm 𝔢 : ℝ)
            ≤ v₀ (algebraMap (NumberField.RingOfIntegers K) K a) *
                (c₀ * sf 𝔡) ^ (Module.finrank ℚ K - 1) := h2
          _ ≤ (c₀ * sf 𝔡) * (c₀ * sf 𝔡) ^ (Module.finrank ℚ K - 1) :=
              mul_le_mul_of_nonneg_right (habd v₀) (pow_nonneg hB _)
          _ = (c₀ * sf 𝔡) ^ Module.finrank ℚ K := mul_pow_sub_one hn0 _
          _ = (Ideal.absNorm 𝔡 : ℝ) * c₀ ^ Module.finrank ℚ K := by
              rw [mul_pow, hsn, mul_comm]
      have h4 : (Ideal.absNorm 𝔢 : ℝ) ≤ c₀ ^ Module.finrank ℚ K :=
        le_of_mul_le_mul_left h3 hN𝔡R
      rw [hX₀]; exact Nat.le_floor h4
    have h𝔢Es : 𝔢 ∈ Es := (hEs 𝔢).mpr ⟨hN𝔢le, h𝔢0⟩
    have ha𝔢 : a ∈ 𝔢 := by
      have hle : Ideal.span {a} ≤ 𝔢 := by rw [h𝔢]; exact Ideal.mul_le_left
      exact hle (Ideal.mem_span_singleton_self a)
    obtain ⟨hgspan, -⟩ := hlab 𝔢 h𝔢0
    obtain ⟨t, ht⟩ := hgspan a ha𝔢
    exact ⟨𝔢, a, t, h𝔢Es, fun _ => ⟨ha𝔡, ha0, h𝔢, ht, habd, hlow, hspos⟩⟩
  choose EC AA TT hEC hdat using hdat
  
  obtain ⟨e, -⟩ : ∃ e : {x // x ∈ Es} ≃ Fin Es.card, True := ⟨Es.equivFin, trivial⟩
  obtain ⟨cc, hcc⟩ : ∃ cc : Fin Es.card → Fin (Module.finrank ℚ K) →
      Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℤ,
      ∀ g, cc g = fun k i l => ω.repr (HH (e.symm g).1 k i) l := ⟨_, fun _ => rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : Ideal (NumberField.RingOfIntegers K) → Fin Es.card,
      ∀ 𝔡, G 𝔡 = e ⟨EC 𝔡, hEC 𝔡⟩ := ⟨_, fun _ => rfl⟩
  have hsymmG : ∀ 𝔡, (e.symm (G 𝔡)).1 = EC 𝔡 := by
    intro 𝔡; rw [hG, Equiv.symm_apply_apply]
  have hccG : ∀ 𝔡, cc (G 𝔡) = fun k i l => ω.repr (HH (EC 𝔡) k i) l := by
    intro 𝔡; rw [hcc, hsymmG]
  have hGEC : ∀ 𝔡 𝔡', G 𝔡 = G 𝔡' → EC 𝔡 = EC 𝔡' := by
    intro 𝔡 𝔡' h
    rw [hG, hG] at h
    exact congrArg Subtype.val (e.injective h)
  
  obtain ⟨T, hT⟩ : ∃ T : Fin Es.card → ℝ, ∀ g, T g =
      (∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K),
          |(cc g x.1 x.2.1 x.2.2 : ℝ)|) +
      (∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K),
          |(LAM (e.symm g).1 x.1 x.2.1 x.2.2 : ℝ)|) +
      |D1 (e.symm g).1| * C * c₀ +
      |D2 (e.symm g).1| * C * C * (Ideal.absNorm (e.symm g).1 : ℝ) *
        c₀ ^ (Module.finrank ℚ K - 1) := ⟨_, fun _ => rfl⟩
  obtain ⟨C₁, hC₁def⟩ : ∃ C₁ : ℝ, C₁ = 1 + ∑ g, T g := ⟨_, rfl⟩
  have hT0 : ∀ g, 0 ≤ T g := by
    intro g; rw [hT]
    have h1 : 0 ≤ ∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K), |(cc g x.1 x.2.1 x.2.2 : ℝ)| :=
      Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have h2 : 0 ≤ ∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K), |(LAM (e.symm g).1 x.1 x.2.1 x.2.2 : ℝ)| :=
      Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have h3 : 0 ≤ |D1 (e.symm g).1| * C * c₀ := by positivity
    have h4 : 0 ≤ |D2 (e.symm g).1| * C * C * (Ideal.absNorm (e.symm g).1 : ℝ) *
        c₀ ^ (Module.finrank ℚ K - 1) := by positivity
    linarith
  have hTC : ∀ g, T g ≤ C₁ := by
    intro g; rw [hC₁def]
    have := Finset.single_le_sum (fun g' _ => hT0 g') (Finset.mem_univ g)
    linarith
  have hC₁1 : 1 ≤ C₁ := by
    rw [hC₁def]
    have := Finset.sum_nonneg (fun g (_ : g ∈ Finset.univ) => hT0 g)
    linarith
  have hcC : ∀ g k i l, |(cc g k i l : ℝ)| ≤ C₁ := by
    intro g k i l
    have h1 := Finset.single_le_sum (f := fun x : Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) => |(cc g x.1 x.2.1 x.2.2 : ℝ)|)
      (fun _ _ => abs_nonneg _) (Finset.mem_univ (k, i, l))
    have h2 := hTC g
    rw [hT] at h2
    have h3 : 0 ≤ ∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K), |(LAM (e.symm g).1 x.1 x.2.1 x.2.2 : ℝ)| :=
      Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have h4 : 0 ≤ |D1 (e.symm g).1| * C * c₀ := by positivity
    have h5 : 0 ≤ |D2 (e.symm g).1| * C * C * (Ideal.absNorm (e.symm g).1 : ℝ) *
        c₀ ^ (Module.finrank ℚ K - 1) := by positivity
    simp only at h1
    linarith
  have hlamC : ∀ g l k i, |(LAM (e.symm g).1 l k i : ℝ)| ≤ C₁ := by
    intro g l k i
    have h1 := Finset.single_le_sum (f := fun x : Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) =>
          |(LAM (e.symm g).1 x.1 x.2.1 x.2.2 : ℝ)|)
      (fun _ _ => abs_nonneg _) (Finset.mem_univ (l, k, i))
    have h2 := hTC g
    rw [hT] at h2
    have h3 : 0 ≤ ∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K), |(cc g x.1 x.2.1 x.2.2 : ℝ)| :=
      Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have h4 : 0 ≤ |D1 (e.symm g).1| * C * c₀ := by positivity
    have h5 : 0 ≤ |D2 (e.symm g).1| * C * C * (Ideal.absNorm (e.symm g).1 : ℝ) *
        c₀ ^ (Module.finrank ℚ K - 1) := by positivity
    simp only at h1
    linarith
  have hDC : ∀ 𝔡, |D1 (EC 𝔡)| * C * c₀ ≤ C₁ ∧
      |D2 (EC 𝔡)| * C * C * (Ideal.absNorm (EC 𝔡) : ℝ) * c₀ ^ (Module.finrank ℚ K - 1)
        ≤ C₁ := by
    intro 𝔡
    have h2 := hTC (G 𝔡)
    rw [hT, hsymmG] at h2
    have h1 : 0 ≤ ∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K), |(cc (G 𝔡) x.1 x.2.1 x.2.2 : ℝ)| :=
      Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have h3 : 0 ≤ ∑ x : Fin (Module.finrank ℚ K) × Fin (Module.finrank ℚ K) ×
        Fin (Module.finrank ℚ K), |(LAM (EC 𝔡) x.1 x.2.1 x.2.2 : ℝ)| :=
      Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have h4 : 0 ≤ |D1 (EC 𝔡)| * C * c₀ := by positivity
    have h5 : 0 ≤ |D2 (EC 𝔡)| * C * C * (Ideal.absNorm (EC 𝔡) : ℝ) *
        c₀ ^ (Module.finrank ℚ K - 1) := by positivity
    constructor <;> linarith
  
  have hP2 : ∀ g l l', ∑ k, ∑ i, LAM (e.symm g).1 l k i * cc g k i l'
      = if l = l' then 1 else 0 := by
    intro g l l'
    obtain ⟨-, -, -, -, -, -, hlamv, -, -⟩ := hlab _ (hEsne _ (e.symm g).2)
    rw [hcc]
    exact hlamv l l'
  
  have hstar : ∀ 𝔡, 𝔡 ≠ ⊥ → ∀ w : Fin (Module.finrank ℚ K) → ℤ,
      ((Ideal.absNorm (EC 𝔡) : ℕ) : NumberField.RingOfIntegers K) *
          ω.equivFun.symm (kaiBil (cc (G 𝔡)) (TT 𝔡) w)
        = AA 𝔡 * ∑ i, w i • FF (EC 𝔡) i := by
    intro 𝔡 h𝔡 w
    have hne := hEsne _ (hEC 𝔡)
    obtain ⟨-, -, -, hat, -, -, -⟩ := hdat 𝔡 h𝔡
    obtain ⟨-, hfmem, hfspan, -, hm𝔢𝔣, hhh, -, -, -⟩ := hlab _ hne
    have hm0 : 0 < Ideal.absNorm (EC 𝔡) :=
      Nat.pos_of_ne_zero (fun h => hne (Ideal.absNorm_eq_zero_iff.mp h))
    have hp := (kai_ip_label_param K ω (EC 𝔡) (FI (EC 𝔡)) (Ideal.absNorm (EC 𝔡)) hm0 hm𝔢𝔣
      (GG (EC 𝔡)) (FF (EC 𝔡)) hfmem hfspan (HH (EC 𝔡)) hhh).1 (TT 𝔡) w
    rw [hccG, hp, ← hat]
  have hmemb : ∀ 𝔡, 𝔡 ≠ ⊥ → ∀ x : NumberField.RingOfIntegers K,
      (x ∈ 𝔡 ↔ ∃ w : Fin (Module.finrank ℚ K) → ℤ,
        ((Ideal.absNorm (EC 𝔡) : ℕ) : NumberField.RingOfIntegers K) * x
          = AA 𝔡 * ∑ i, w i • FF (EC 𝔡) i) := by
    intro 𝔡 h𝔡 x
    have hne := hEsne _ (hEC 𝔡)
    obtain ⟨-, -, hsp, -, -, -, -⟩ := hdat 𝔡 h𝔡
    obtain ⟨-, hfmem, hfspan, -, hm𝔢𝔣, hhh, -, -, -⟩ := hlab _ hne
    have hm0 : 0 < Ideal.absNorm (EC 𝔡) :=
      Nat.pos_of_ne_zero (fun h => hne (Ideal.absNorm_eq_zero_iff.mp h))
    exact (kai_ip_label_param K ω (EC 𝔡) (FI (EC 𝔡)) (Ideal.absNorm (EC 𝔡)) hm0 hm𝔢𝔣
      (GG (EC 𝔡)) (FF (EC 𝔡)) hfmem hfspan (HH (EC 𝔡)) hhh).2 𝔡 (AA 𝔡) hsp x
  have hmne : ∀ 𝔡, ((Ideal.absNorm (EC 𝔡) : ℕ) : NumberField.RingOfIntegers K) ≠ 0 := by
    intro 𝔡
    have hne := hEsne _ (hEC 𝔡)
    have hm0 : 0 < Ideal.absNorm (EC 𝔡) :=
      Nat.pos_of_ne_zero (fun h => hne (Ideal.absNorm_eq_zero_iff.mp h))
    exact Nat.cast_ne_zero.mpr hm0.ne'
  
  have hP4 : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ →
      ∀ x : NumberField.RingOfIntegers K,
        x ∈ 𝔡 ↔ ∃ w, ω.equivFun x = kaiBil (cc (G 𝔡)) (TT 𝔡) w := by
    intro 𝔡 h𝔡 x
    rw [hmemb 𝔡 h𝔡 x]
    constructor
    · rintro ⟨w, hw⟩
      refine ⟨w, ?_⟩
      rw [← LinearEquiv.eq_symm_apply]
      exact mul_left_cancel₀ (hmne 𝔡) (hw.trans (hstar 𝔡 h𝔡 w).symm)
    · rintro ⟨w, hw⟩
      refine ⟨w, ?_⟩
      rw [← LinearEquiv.eq_symm_apply] at hw
      rw [hw]
      exact hstar 𝔡 h𝔡 w
  
  have hP5 : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ →
      Function.Injective (kaiBil (cc (G 𝔡)) (TT 𝔡)) := by
    intro 𝔡 h𝔡 w w' hww'
    have hne := hEsne _ (hEC 𝔡)
    obtain ⟨-, ha0, -, -, -, -, -⟩ := hdat 𝔡 h𝔡
    obtain ⟨-, -, -, hfind, -, -, -, -, -⟩ := hlab _ hne
    have h1 : AA 𝔡 * ∑ i, w i • FF (EC 𝔡) i = AA 𝔡 * ∑ i, w' i • FF (EC 𝔡) i := by
      rw [← hstar 𝔡 h𝔡 w, ← hstar 𝔡 h𝔡 w', hww']
    have h2 := mul_left_cancel₀ ha0 h1
    have h3 : ∑ i, (fun i => w i - w' i) i • FF (EC 𝔡) i = 0 := by
      simp only [sub_smul, Finset.sum_sub_distrib, h2, sub_self]
    have h4 := hfind _ h3
    funext i
    have := congrFun h4 i
    simp only [Pi.zero_apply] at this
    linarith
  
  have hP3 : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ → ∀ k,
      |(TT 𝔡 k : ℝ)| ≤ C₁ * sf 𝔡 := by
    intro 𝔡 h𝔡 k
    have hne := hEsne _ (hEC 𝔡)
    obtain ⟨-, -, -, hat, habd, -, hspos⟩ := hdat 𝔡 h𝔡
    obtain ⟨-, -, -, -, -, -, -, hD1b, -⟩ := hlab _ hne
    have h1 := hD1b (TT 𝔡) k
    rw [← hat] at h1
    have h2 : basisSupNorm ω (AA 𝔡) ≤ C * (c₀ * sf 𝔡) :=
      (hbSN_le_can _).trans (mul_le_mul_of_nonneg_left (hcan_le _ _ habd) hCpos.le)
    have h3 := (hDC 𝔡).1
    calc |(TT 𝔡 k : ℝ)| ≤ D1 (EC 𝔡) * basisSupNorm ω (AA 𝔡) := h1
      _ ≤ |D1 (EC 𝔡)| * basisSupNorm ω (AA 𝔡) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (hbSN0 _)
      _ ≤ |D1 (EC 𝔡)| * (C * (c₀ * sf 𝔡)) := mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
      _ = (|D1 (EC 𝔡)| * C * c₀) * sf 𝔡 := by ring
      _ ≤ C₁ * sf 𝔡 := mul_le_mul_of_nonneg_right h3 hspos.le
  
  have hP6 : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ →
      ∀ (Mb : ℝ) (w : Fin (Module.finrank ℚ K) → ℤ), 0 ≤ Mb →
        (∀ l, |(kaiBil (cc (G 𝔡)) (TT 𝔡) w l : ℝ)| ≤ Mb) →
        ∀ i, |(w i : ℝ)| ≤ C₁ * Mb / sf 𝔡 := by
    intro 𝔡 h𝔡 Mb w hMb hkb i
    have hne := hEsne _ (hEC 𝔡)
    obtain ⟨-, -, -, -, -, hlow, hspos⟩ := hdat 𝔡 h𝔡
    obtain ⟨-, -, -, -, -, -, -, -, hD2b⟩ := hlab _ hne
    have hxb : basisSupNorm ω (ω.equivFun.symm (kaiBil (cc (G 𝔡)) (TT 𝔡) w)) ≤ Mb := by
      apply hbSN_le
      intro j
      have h := congrFun (ω.equivFun.apply_symm_apply (kaiBil (cc (G 𝔡)) (TT 𝔡) w)) j
      rw [Module.Basis.equivFun_apply] at h
      rw [h]
      exact hkb j
    have hxv : ∀ v : NumberField.InfinitePlace K,
        v (algebraMap (NumberField.RingOfIntegers K) K
          (ω.equivFun.symm (kaiBil (cc (G 𝔡)) (TT 𝔡) w))) ≤ C * Mb := fun v =>
      (hplace_le_can _ v).trans (((hω.2 _).2).trans (mul_le_mul_of_nonneg_left hxb hCpos.le))
    have hY := kai_ip_quot_small K (AA 𝔡) (ω.equivFun.symm (kaiBil (cc (G 𝔡)) (TT 𝔡) w))
      (∑ i, w i • FF (EC 𝔡) i) (Ideal.absNorm (EC 𝔡)) c₀ (sf 𝔡) (C * Mb) hc₀ hspos hlow
      (hstar 𝔡 h𝔡 w) hxv
    have hYcan := hcan_le _ _ hY
    have hYb := hbSN_le_can (∑ i, w i • FF (EC 𝔡) i)
    have h1 := hD2b w i
    have h3 := (hDC 𝔡).2
    calc |(w i : ℝ)| ≤ D2 (EC 𝔡) * basisSupNorm ω (∑ i, w i • FF (EC 𝔡) i) := h1
      _ ≤ |D2 (EC 𝔡)| * basisSupNorm ω (∑ i, w i • FF (EC 𝔡) i) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (hbSN0 _)
      _ ≤ |D2 (EC 𝔡)| * (C * ((Ideal.absNorm (EC 𝔡) : ℝ) * c₀ ^ (Module.finrank ℚ K - 1)
            * (C * Mb) / sf 𝔡)) :=
          mul_le_mul_of_nonneg_left (hYb.trans (mul_le_mul_of_nonneg_left hYcan hCpos.le))
            (abs_nonneg _)
      _ = (|D2 (EC 𝔡)| * C * C * (Ideal.absNorm (EC 𝔡) : ℝ) *
            c₀ ^ (Module.finrank ℚ K - 1)) * (Mb / sf 𝔡) := by ring
      _ ≤ C₁ * (Mb / sf 𝔡) := mul_le_mul_of_nonneg_right h3 (div_nonneg hMb hspos.le)
      _ = C₁ * Mb / sf 𝔡 := by ring
  
  have hP7 : ∀ 𝔡 𝔡' : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ → 𝔡' ≠ ⊥ → G 𝔡 = G 𝔡' →
      ∀ (w : Fin (Module.finrank ℚ K) → ℤ) (𝔡₁ : Ideal (NumberField.RingOfIntegers K)),
        (Ideal.span {ω.equivFun.symm (kaiBil (cc (G 𝔡)) (TT 𝔡) w)} = 𝔡₁ * 𝔡 ↔
         Ideal.span {ω.equivFun.symm (kaiBil (cc (G 𝔡')) (TT 𝔡') w)} = 𝔡₁ * 𝔡') := by
    intro 𝔡 𝔡' h𝔡 h𝔡' hGG w 𝔡₁
    have hEE := hGEC 𝔡 𝔡' hGG
    have hne := hEsne _ (hEC 𝔡)
    obtain ⟨-, -, hsp, -, -, -, -⟩ := hdat 𝔡 h𝔡
    obtain ⟨-, -, hsp', -, -, -, -⟩ := hdat 𝔡' h𝔡'
    rw [← hEE] at hsp'
    have h1 := hstar 𝔡 h𝔡 w
    have h2 := hstar 𝔡' h𝔡' w
    rw [← hEE] at h2
    obtain ⟨x, hx⟩ : ∃ x, x = ω.equivFun.symm (kaiBil (cc (G 𝔡)) (TT 𝔡) w) := ⟨_, rfl⟩
    obtain ⟨x', hx'⟩ : ∃ x', x' = ω.equivFun.symm (kaiBil (cc (G 𝔡')) (TT 𝔡') w) :=
      ⟨_, rfl⟩
    rw [← hx] at h1 ⊢
    rw [← hx'] at h2 ⊢
    have hxa : x * AA 𝔡' = x' * AA 𝔡 := by
      apply mul_left_cancel₀ (hmne 𝔡)
      calc ((Ideal.absNorm (EC 𝔡) : ℕ) : NumberField.RingOfIntegers K) * (x * AA 𝔡')
          = (((Ideal.absNorm (EC 𝔡) : ℕ) : NumberField.RingOfIntegers K) * x) * AA 𝔡' := by
            ring
        _ = (AA 𝔡 * ∑ i, w i • FF (EC 𝔡) i) * AA 𝔡' := by rw [h1]
        _ = (AA 𝔡' * ∑ i, w i • FF (EC 𝔡) i) * AA 𝔡 := by ring
        _ = (((Ideal.absNorm (EC 𝔡) : ℕ) : NumberField.RingOfIntegers K) * x') * AA 𝔡 := by
            rw [h2]
        _ = ((Ideal.absNorm (EC 𝔡) : ℕ) : NumberField.RingOfIntegers K) * (x' * AA 𝔡) := by
            ring
    have hspan_eq : Ideal.span {x} * (𝔡' * EC 𝔡) = Ideal.span {x'} * (𝔡 * EC 𝔡) := by
      rw [← hsp, ← hsp', Ideal.span_singleton_mul_span_singleton,
        Ideal.span_singleton_mul_span_singleton, hxa]
    have hb0 : 𝔡 * EC 𝔡 ≠ 0 := by
      rw [Ideal.zero_eq_bot]
      exact fun h => (Ideal.mul_eq_bot.mp h).elim h𝔡 hne
    have hb0' : 𝔡' * EC 𝔡 ≠ 0 := by
      rw [Ideal.zero_eq_bot]
      exact fun h => (Ideal.mul_eq_bot.mp h).elim h𝔡' hne
    constructor
    · intro h
      apply mul_right_cancel₀ hb0
      rw [← hspan_eq, h]
      ring
    · intro h
      apply mul_right_cancel₀ hb0'
      rw [hspan_eq, h]
      ring
  
  have hP8 : ∀ 𝔡 𝔡' : Ideal (NumberField.RingOfIntegers K), 𝔡 ≠ ⊥ → 𝔡' ≠ ⊥ → G 𝔡 = G 𝔡' →
      TT 𝔡 = TT 𝔡' → 𝔡 = 𝔡' := by
    intro 𝔡 𝔡' h𝔡 h𝔡' hGG hTT
    have hEE := hGEC 𝔡 𝔡' hGG
    have hne := hEsne _ (hEC 𝔡)
    obtain ⟨-, -, hsp, hat, -, -, -⟩ := hdat 𝔡 h𝔡
    obtain ⟨-, -, hsp', hat', -, -, -⟩ := hdat 𝔡' h𝔡'
    have haa : AA 𝔡 = AA 𝔡' := by rw [hat, hat', hTT, hEE]
    have h0 : EC 𝔡 ≠ 0 := by rw [Ideal.zero_eq_bot]; exact hne
    apply mul_right_cancel₀ h0
    rw [← hsp, hEE, ← hsp', haa]
  
  refine ⟨C₁, Es.card, cc, fun g => LAM (e.symm g).1, G, TT, hC₁1, hcC, hlamC, hP2,
    ?_, hP4, hP5, ?_, hP7, hP8⟩
  · intro 𝔡 h𝔡 k
    rw [← hsf]
    exact hP3 𝔡 h𝔡 k
  · intro 𝔡 h𝔡 Mb w hMb hkb i
    rw [← hsf]
    exact hP6 𝔡 h𝔡 Mb w hMb hkb i

theorem kai_t2_grid_boundary (ν : ℕ) (c : Fin ν → Fin ν → Fin ν → ℤ) (t : Fin ν → ℤ)
    (Mb : ℝ) (Lc G : ℕ) (z₀ : Fin ν → ℤ) (hLc : 1 ≤ Lc) :
    ((Fintype.piFinset (fun _ : Fin ν => Finset.range G)).filter (fun m : Fin ν → ℕ =>
        (∃ w ∈ kaiT2Cube z₀ Lc m, ∀ l, |(kaiBil c t w l : ℝ)| ≤ Mb) ∧
        (∃ w ∈ kaiT2Cube z₀ Lc m, ¬ ∀ l, |(kaiBil c t w l : ℝ)| ≤ Mb))).card
      ≤ 2 * ν * (ν + 1) * G ^ (ν - 1) :=
by
  
  have hcube : ∀ (m : Fin ν → ℕ) (w : Fin ν → ℤ), w ∈ kaiT2Cube z₀ Lc m → ∀ i,
      z₀ i + (Lc : ℤ) * (m i : ℤ) ≤ w i ∧
        w i ≤ z₀ i + (Lc : ℤ) * (m i : ℤ) + ((Lc : ℤ) - 1) := by
    intro m w hw i
    simp only [kaiT2Cube, Finset.mem_Icc, Pi.le_def, Pi.add_apply] at hw
    exact ⟨hw.1 i, hw.2 i⟩
  have hL1 : (1 : ℤ) ≤ (Lc : ℤ) := by exact_mod_cast hLc
  
  have hgap : ∀ (ρ : Fin ν → ℤ) (i₀ : Fin ν), (∀ j, |ρ j| ≤ |ρ i₀|) → ρ i₀ ≠ 0 →
      ∀ (m m' : Fin ν → ℕ), (∀ j, j ≠ i₀ → m j = m' j) → m i₀ + ν ≤ m' i₀ →
      ∀ (w w' : Fin ν → ℤ), w ∈ kaiT2Cube z₀ Lc m → w' ∈ kaiT2Cube z₀ Lc m' →
      0 < ρ i₀ * (∑ j, ρ j * w' j - ∑ j, ρ j * w j) := by
    intro ρ i₀ hmax hne m m' hoff hg w w' hw hw'
    have hrr : 0 < ρ i₀ * ρ i₀ := mul_self_pos.mpr hne
    have hν : (1 : ℤ) ≤ (ν : ℤ) := by
      have := Fin.pos i₀
      exact_mod_cast this
    have hterm : ∀ j, -(ρ i₀ * ρ i₀ * ((Lc : ℤ) - 1))
          + (if j = i₀ then ρ i₀ * ρ i₀ * ((Lc : ℤ) * (ν : ℤ)) else 0)
        ≤ ρ i₀ * (ρ j * (w' j - w j)) := by
      intro j
      have h1 := hcube m w hw j
      have h2 := hcube m' w' hw' j
      by_cases hj : j = i₀
      · rw [if_pos hj]
        rw [hj] at h1 h2 ⊢
        have hgz : (m i₀ : ℤ) + (ν : ℤ) ≤ (m' i₀ : ℤ) := by exact_mod_cast hg
        have hLm : (Lc : ℤ) * ((m i₀ : ℤ) + ν) ≤ (Lc : ℤ) * (m' i₀ : ℤ) :=
          mul_le_mul_of_nonneg_left hgz (by positivity)
        have hD : (Lc : ℤ) * ν - ((Lc : ℤ) - 1) ≤ w' i₀ - w i₀ := by
          linarith [h1.2, h2.1]
        have key := mul_le_mul_of_nonneg_left hD hrr.le
        nlinarith [key]
      · rw [if_neg hj, add_zero]
        have hmj : (m j : ℤ) = (m' j : ℤ) := by rw [hoff j hj]
        rw [hmj] at h1
        have hD : |w' j - w j| ≤ (Lc : ℤ) - 1 := by
          rw [abs_le]; constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
        have hab : |ρ i₀ * (ρ j * (w' j - w j))| ≤ ρ i₀ * ρ i₀ * ((Lc : ℤ) - 1) := by
          rw [abs_mul, abs_mul, ← abs_mul_abs_self (ρ i₀), mul_assoc]
          apply mul_le_mul_of_nonneg_left _ (abs_nonneg (ρ i₀))
          exact mul_le_mul (hmax j) hD (abs_nonneg _) (abs_nonneg _)
        have := neg_abs_le (ρ i₀ * (ρ j * (w' j - w j)))
        linarith
    have hsum : ρ i₀ * (∑ j, ρ j * w' j - ∑ j, ρ j * w j)
        = ∑ j, ρ i₀ * (ρ j * (w' j - w j)) := by
      rw [← Finset.sum_sub_distrib, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    have hlow := Finset.sum_le_sum (fun j (_ : j ∈ (Finset.univ : Finset (Fin ν))) => hterm j)
    simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      Finset.sum_ite_eq', Finset.mem_univ, if_true, nsmul_eq_mul] at hlow
    rw [hsum]
    have hpos : 0 < ρ i₀ * ρ i₀ * (ν : ℤ) := mul_pos hrr (by omega)
    nlinarith [hlow, hpos]
  
  obtain ⟨Sp, hSp⟩ : ∃ Sp : (Fin ν → ℤ) → ℝ → Finset (Fin ν → ℕ), ∀ ρ b, Sp ρ b =
      (Fintype.piFinset (fun _ : Fin ν => Finset.range G)).filter (fun m : Fin ν → ℕ =>
        (∃ w ∈ kaiT2Cube z₀ Lc m, ((∑ i, ρ i * w i : ℤ) : ℝ) ≤ b) ∧
        (∃ w ∈ kaiT2Cube z₀ Lc m, b < ((∑ i, ρ i * w i : ℤ) : ℝ))) :=
    ⟨_, fun _ _ => rfl⟩
  have hsplit : ∀ (ρ : Fin ν → ℤ) (b : ℝ), (Sp ρ b).card ≤ ν * G ^ (ν - 1) := by
    intro ρ b
    rw [hSp]
    by_cases hz : ∀ i, ρ i = 0
    · have h0 : ∀ w : Fin ν → ℤ, (∑ i, ρ i * w i) = 0 := fun w =>
        Finset.sum_eq_zero (fun i _ => by rw [hz i, zero_mul])
      rw [Finset.card_eq_zero.mpr]
      · exact Nat.zero_le _
      · rw [Finset.filter_eq_empty_iff]
        rintro m - ⟨⟨w, -, hw⟩, ⟨w', -, hw'⟩⟩
        rw [h0] at hw hw'
        push_cast at hw hw'
        linarith
    push_neg at hz
    obtain ⟨i₁, hi₁⟩ := hz
    have hνpos : 0 < ν := Fin.pos i₁
    obtain ⟨i₀, -, hmax⟩ := Finset.exists_max_image Finset.univ (fun i => |ρ i|)
      ⟨i₁, Finset.mem_univ _⟩
    have hmax' : ∀ j, |ρ j| ≤ |ρ i₀| := fun j => hmax j (Finset.mem_univ _)
    have hne : ρ i₀ ≠ 0 := by
      intro h0
      apply hi₁
      have := hmax' i₁
      rw [h0, abs_zero] at this
      exact abs_nonpos_iff.mp this
    have hK : ∀ m m' : Fin ν → ℕ,
        ((∃ w ∈ kaiT2Cube z₀ Lc m, ((∑ i, ρ i * w i : ℤ) : ℝ) ≤ b) ∧
          (∃ w ∈ kaiT2Cube z₀ Lc m, b < ((∑ i, ρ i * w i : ℤ) : ℝ))) →
        ((∃ w ∈ kaiT2Cube z₀ Lc m', ((∑ i, ρ i * w i : ℤ) : ℝ) ≤ b) ∧
          (∃ w ∈ kaiT2Cube z₀ Lc m', b < ((∑ i, ρ i * w i : ℤ) : ℝ))) →
        (∀ j, j ≠ i₀ → m j = m' j) → m i₀ + ν ≤ m' i₀ → False := by
      rintro m m' ⟨⟨wg, hwg, hg⟩, ⟨wb, hwb, hb⟩⟩ ⟨⟨wg', hwg', hg'⟩, ⟨wb', hwb', hb'⟩⟩ hoff hgap'
      rcases lt_or_gt_of_ne hne with hneg | hpos
      · have h := hgap ρ i₀ hmax' hne m m' hoff hgap' wg wb' hwg hwb'
        have h2 : ∑ j, ρ j * wb' j < ∑ j, ρ j * wg j := by nlinarith
        have h3 : ((∑ j, ρ j * wb' j : ℤ) : ℝ) < ((∑ j, ρ j * wg j : ℤ) : ℝ) := by
          exact_mod_cast h2
        linarith
      · have h := hgap ρ i₀ hmax' hne m m' hoff hgap' wb wg' hwb hwg'
        have h2 : ∑ j, ρ j * wb j < ∑ j, ρ j * wg' j := by nlinarith
        have h3 : ((∑ j, ρ j * wb j : ℤ) : ℝ) < ((∑ j, ρ j * wg' j : ℤ) : ℝ) := by
          exact_mod_cast h2
        linarith
    have hres : ∀ a a' : ℕ, a < a' → a % ν = a' % ν → a + ν ≤ a' := by
      intro a a' hlt hmod
      have h1 : (a' - a) % ν = 0 := Nat.sub_mod_eq_zero_of_mod_eq hmod.symm
      have h2 : ν ∣ a' - a := Nat.dvd_of_mod_eq_zero h1
      have h3 : ν ≤ a' - a := Nat.le_of_dvd (by omega) h2
      omega
    calc _ ≤ (Fintype.piFinset (fun i : Fin ν =>
            if i = i₀ then Finset.range ν else Finset.range G)).card := by
          apply Finset.card_le_card_of_injOn (fun m i => if i = i₀ then m i % ν else m i)
          · intro m hm
            have hm1 := (Finset.mem_filter.mp (Finset.mem_coe.mp hm)).1
            rw [Fintype.mem_piFinset] at hm1
            rw [Finset.mem_coe, Fintype.mem_piFinset]
            intro i
            by_cases hi : i = i₀
            · simp only [if_pos hi, Finset.mem_range]
              exact Nat.mod_lt _ hνpos
            · simp only [if_neg hi]
              exact hm1 i
          · intro m hm m' hm' hmm'
            have hS := (Finset.mem_filter.mp (Finset.mem_coe.mp hm)).2
            have hS' := (Finset.mem_filter.mp (Finset.mem_coe.mp hm')).2
            have hoff : ∀ j, j ≠ i₀ → m j = m' j := by
              intro j hj
              have := congrFun hmm' j
              simp only [if_neg hj] at this
              exact this
            have hmod : m i₀ % ν = m' i₀ % ν := by
              have := congrFun hmm' i₀
              simp only [if_true] at this
              exact this
            rcases lt_trichotomy (m i₀) (m' i₀) with hlt | heq | hgt
            · exact (hK m m' hS hS' hoff (hres _ _ hlt hmod)).elim
            · funext j
              by_cases hj : j = i₀
              · rw [hj]; exact heq
              · exact hoff j hj
            · exact (hK m' m hS' hS (fun j hj => (hoff j hj).symm)
                (hres _ _ hgt hmod.symm)).elim
      _ = ν * G ^ (ν - 1) := by
          rw [Fintype.card_piFinset, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i₀)]
          rw [if_pos rfl, Finset.card_range]
          congr 1
          rw [Finset.prod_congr rfl (fun j hj => by
              rw [if_neg (Finset.ne_of_mem_erase hj), Finset.card_range]),
            Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ,
            Fintype.card_fin]
  
  have hlin : ∀ (w : Fin ν → ℤ) (l : Fin ν),
      kaiBil c t w l = ∑ i, (∑ k, t k * c k i l) * w i := by
    intro w l
    simp only [kaiBil]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl (fun k _ => by ring)
  have hneg : ∀ (w : Fin ν → ℤ) (l : Fin ν),
      ((∑ i, (-(∑ k, t k * c k i l)) * w i : ℤ) : ℝ) = -((kaiBil c t w l : ℤ) : ℝ) := by
    intro w l
    rw [← Int.cast_neg, hlin, ← Finset.sum_neg_distrib]
    congr 1
    exact Finset.sum_congr rfl (fun i _ => by ring)
  
  calc _ ≤ (Finset.univ.biUnion (fun l : Fin ν =>
          Sp (fun i => ∑ k, t k * c k i l) Mb ∪ Sp (fun i => -(∑ k, t k * c k i l)) Mb)).card := by
        apply Finset.card_le_card
        intro m hm
        rw [Finset.mem_filter] at hm
        obtain ⟨hmG, ⟨w, hw, hgood⟩, ⟨w', hw', hbad⟩⟩ := hm
        push_neg at hbad
        obtain ⟨l, hl⟩ := hbad
        rw [Finset.mem_biUnion]
        refine ⟨l, Finset.mem_univ _, ?_⟩
        rw [Finset.mem_union, hSp, hSp, Finset.mem_filter, Finset.mem_filter]
        have hgl := hgood l
        have e1 : ((kaiBil c t w l : ℤ) : ℝ) = ((∑ i, (∑ k, t k * c k i l) * w i : ℤ) : ℝ) := by
          rw [hlin]
        have e2 : ((kaiBil c t w' l : ℤ) : ℝ)
            = ((∑ i, (∑ k, t k * c k i l) * w' i : ℤ) : ℝ) := by
          rw [hlin]
        rcases lt_abs.mp hl with h | h
        · left
          refine ⟨hmG, ⟨w, hw, ?_⟩, ⟨w', hw', ?_⟩⟩
          · rw [e1] at hgl
            exact (le_abs_self _).trans hgl
          · exact h.trans_le e2.le
        · right
          refine ⟨hmG, ⟨w, hw, ?_⟩, ⟨w', hw', ?_⟩⟩
          · exact (le_of_eq (hneg w l)).trans ((neg_le_abs _).trans hgl)
          · exact h.trans_le (hneg w' l).symm.le
    _ ≤ ∑ l : Fin ν, (Sp (fun i => ∑ k, t k * c k i l) Mb
          ∪ Sp (fun i => -(∑ k, t k * c k i l)) Mb).card := Finset.card_biUnion_le
    _ ≤ ∑ _l : Fin ν, (ν * G ^ (ν - 1) + ν * G ^ (ν - 1)) := by
        apply Finset.sum_le_sum
        intro l _
        exact (Finset.card_union_le _ _).trans (add_le_add (hsplit _ _) (hsplit _ _))
    _ = 2 * ν * ν * G ^ (ν - 1) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
        ring
    _ ≤ 2 * ν * (ν + 1) * G ^ (ν - 1) := by
        gcongr
        omega

theorem kai_t2_bilinear_cs {ι κ : Type*} (J : Finset ι) (P : Finset κ) (f : ι → κ → ℂ)
    (lam : κ → ℂ) (hlam : ∀ w ∈ P, ‖lam w‖ ≤ 1) :
    ∑ j ∈ J, ‖∑ w ∈ P, lam w * f j w‖ ^ 2
      ≤ (P.card : ℝ) * Real.sqrt (∑ j ∈ J, ∑ j' ∈ J,
          ‖∑ w ∈ P, f j w * (starRingEnd ℂ) (f j' w)‖ ^ 2) :=
by
  classical
  have key : ∀ z : ℂ, (((‖z‖ ^ 2 : ℝ)) : ℂ) = z * (starRingEnd ℂ) z := by
    intro z
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  
  have s1 : ∑ j ∈ J, ‖∑ w ∈ P, lam w * f j w‖ ^ 2
      ≤ ∑ w ∈ P, ∑ x ∈ P, ‖∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x)‖ := by
    have hS : ((∑ j ∈ J, ‖∑ w ∈ P, lam w * f j w‖ ^ 2 : ℝ) : ℂ)
        = ∑ w ∈ P, ∑ x ∈ P, (lam w * (starRingEnd ℂ) (lam x))
            * ∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x) := by
      rw [Complex.ofReal_sum]
      simp only [key, map_sum, map_mul, Finset.sum_mul_sum]
      refine Finset.sum_comm.trans (Finset.sum_congr rfl fun w _ => ?_)
      refine Finset.sum_comm.trans (Finset.sum_congr rfl fun x _ => ?_)
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    have hS0 : 0 ≤ ∑ j ∈ J, ‖∑ w ∈ P, lam w * f j w‖ ^ 2 :=
      Finset.sum_nonneg fun j _ => by positivity
    calc ∑ j ∈ J, ‖∑ w ∈ P, lam w * f j w‖ ^ 2
        = ‖((∑ j ∈ J, ‖∑ w ∈ P, lam w * f j w‖ ^ 2 : ℝ) : ℂ)‖ :=
          (Complex.norm_of_nonneg hS0).symm
      _ = ‖∑ w ∈ P, ∑ x ∈ P, (lam w * (starRingEnd ℂ) (lam x))
            * ∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x)‖ := by rw [hS]
      _ ≤ ∑ w ∈ P, ∑ x ∈ P, ‖(lam w * (starRingEnd ℂ) (lam x))
            * ∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x)‖ :=
          (norm_sum_le _ _).trans (Finset.sum_le_sum fun w _ => norm_sum_le _ _)
      _ ≤ ∑ w ∈ P, ∑ x ∈ P, ‖∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x)‖ := by
          refine Finset.sum_le_sum fun w hw => Finset.sum_le_sum fun x hx => ?_
          rw [norm_mul, norm_mul, Complex.norm_conj]
          have h1 : ‖lam w‖ * ‖lam x‖ ≤ 1 :=
            mul_le_one₀ (hlam w hw) (norm_nonneg _) (hlam x hx)
          exact mul_le_of_le_one_left (norm_nonneg _) h1
  
  have s2 : ∀ g : κ → κ → ℂ, ∑ w ∈ P, ∑ x ∈ P, ‖g w x‖
      ≤ (P.card : ℝ) * Real.sqrt (∑ w ∈ P, ∑ x ∈ P, ‖g w x‖ ^ 2) := by
    intro g
    have h := Real.sum_mul_le_sqrt_mul_sqrt (P ×ˢ P) (fun p => ‖g p.1 p.2‖) (fun _ => 1)
    simp only [mul_one, one_pow, Finset.sum_const, Finset.card_product, nsmul_eq_mul,
      Nat.cast_mul] at h
    rw [Finset.sum_product' (f := fun w x => ‖g w x‖),
      Finset.sum_product' (f := fun w x => ‖g w x‖ ^ 2),
      Real.sqrt_mul_self (Nat.cast_nonneg _)] at h
    linarith
  
  have s3 : ∑ w ∈ P, ∑ x ∈ P, ‖∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x)‖ ^ 2
      = ∑ j ∈ J, ∑ k ∈ J, ‖∑ w ∈ P, f j w * (starRingEnd ℂ) (f k w)‖ ^ 2 := by
    apply Complex.ofReal_injective
    simp only [Complex.ofReal_sum, key, map_sum, map_mul, Complex.conj_conj, Finset.sum_mul_sum]
    refine (Finset.sum_congr rfl fun w _ => Finset.sum_comm).trans ?_
    refine (Finset.sum_congr rfl fun w _ => Finset.sum_congr rfl fun j _ =>
      Finset.sum_comm).trans ?_
    refine Finset.sum_comm.trans (Finset.sum_congr rfl fun j _ => ?_)
    refine Finset.sum_comm.trans (Finset.sum_congr rfl fun k _ => ?_)
    refine Finset.sum_congr rfl fun w _ => Finset.sum_congr rfl fun x _ => ?_
    ring
  calc ∑ j ∈ J, ‖∑ w ∈ P, lam w * f j w‖ ^ 2
      ≤ ∑ w ∈ P, ∑ x ∈ P, ‖∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x)‖ := s1
    _ ≤ (P.card : ℝ) * Real.sqrt (∑ w ∈ P, ∑ x ∈ P,
          ‖∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x)‖ ^ 2) :=
        s2 (fun w x => ∑ j ∈ J, f j w * (starRingEnd ℂ) (f j x))
    _ = (P.card : ℝ) * Real.sqrt (∑ j ∈ J, ∑ j' ∈ J,
          ‖∑ w ∈ P, f j w * (starRingEnd ℂ) (f j' w)‖ ^ 2) := by rw [s3]

theorem kai_t2_cs_dyadic (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (h : ℕ)
    (G : Ideal (NumberField.RingOfIntegers K) → Fin h) (M δ : ℝ)
    (Φ : NumberField.RingOfIntegers K → ℂ)
    (I₁ I₂ : Finset (Ideal (NumberField.RingOfIntegers K)))
    (L T : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hM : 16 ≤ M) (hδ : 0 < δ)
    (hI₁ : ∀ 𝔡 ∈ I₁, 𝔡 ≠ ⊥ ∧ M ^ ((Module.finrank ℚ K : ℝ) / 4) ≤ (Ideal.absNorm 𝔡 : ℝ))
    (hI₂ : ∀ 𝔡 ∈ I₂, 𝔡 ≠ ⊥ ∧ M ^ ((Module.finrank ℚ K : ℝ) / 4) ≤ (Ideal.absNorm 𝔡 : ℝ))
    (hT : ∑ 𝔡 ∈ I₂, ‖T 𝔡‖ ^ 2 / (Ideal.absNorm 𝔡 : ℝ) ≤ Real.log M ^ 8)
    (hbig : δ * ((omegaBox ω M).card : ℝ) < ‖kaiTypeIIForm ω M Φ I₁ I₂ L T‖) :
    ∃ (g : Fin h) (D₁ : ℝ) (J : Finset (Ideal (NumberField.RingOfIntegers K))),
      J ⊆ I₂ ∧ J.Nonempty ∧
      M ^ ((1:ℝ) / 4) ≤ D₁ ∧ D₁ ≤ C * M ^ ((3:ℝ) / 4) ∧
      (∀ 𝔡 ∈ J, G 𝔡 = g ∧
        D₁ ≤ (Ideal.absNorm 𝔡 : ℝ) ^ ((1:ℝ) / (Module.finrank ℚ K : ℝ)) ∧
        (Ideal.absNorm 𝔡 : ℝ) ^ ((1:ℝ) / (Module.finrank ℚ K : ℝ)) ≤ 2 * D₁) ∧
      δ ^ 2 * M ^ (2 * Module.finrank ℚ K) ≤
        2 * D₁ ^ Module.finrank ℚ K * ((h : ℝ) + 1) *
          (2 * ((Module.finrank ℚ K : ℝ) * Real.log C + (Module.finrank ℚ K : ℝ) + 1)) *
          Real.log M ^ 9 *
          ∑ 𝔡 ∈ J, ‖∑ 𝔡₁ ∈ I₁, L 𝔡₁ *
            ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
              (fun x => Ideal.span {x} = 𝔡₁ * 𝔡) (fun _ => Classical.propDecidable _)
              (omegaBox ω M), Φ x‖ ^ 2 :=
by
  classical
  
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hn0 : Module.finrank ℚ K ≠ 0 := by omega
  have hnR : (1:ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn1
  have hnpos : (0:ℝ) < (Module.finrank ℚ K : ℝ) := by linarith
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hlogC : 0 < Real.log C := Real.log_pos hC1
  have hMpos : 0 < M := by linarith
  have hM1 : 1 ≤ M := by linarith
  have hℓ1 : 1 ≤ Real.log M := by
    rw [Real.le_log_iff_exp_le hMpos]
    have := Real.exp_one_lt_d9
    norm_num at this
    linarith
  have hCMpos : 0 < C * M := mul_pos hCpos hMpos
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = M ^ ((Module.finrank ℚ K : ℝ) / 4) := ⟨_, rfl⟩
  have hApos : 0 < A := by rw [hA]; exact Real.rpow_pos_of_pos hMpos _
  have hA1 : 1 ≤ A := by rw [hA]; exact Real.one_le_rpow hM1 (by positivity)
  rw [← hA] at hI₁ hI₂
  have hNpos : ∀ 𝔡 ∈ I₂, (0:ℝ) < (Ideal.absNorm 𝔡 : ℝ) := fun 𝔡 h𝔡 =>
    lt_of_lt_of_le hApos (hI₂ 𝔡 h𝔡).2
  
  have hnormle : ∀ x ∈ omegaBox ω M,
      ((Algebra.norm ℤ x).natAbs : ℝ) ≤ (C * M) ^ Module.finrank ℚ K := by
    intro x hx
    have hs3 : basisSupNorm ω x ≤ M := by
      simp only [omegaBox, Finset.mem_image] at hx
      obtain ⟨v, hv, rfl⟩ := hx
      unfold basisSupNorm
      refine Real.iSup_le (fun j => ?_) (by linarith)
      have hrepr : ω.repr (ω.equivFun.symm v) j = v j := by
        rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
      rw [hrepr]
      unfold intBox at hv
      rw [Finset.mem_Icc] at hv
      have h1 : -(⌊M⌋₊ : ℤ) ≤ v j := hv.1 j
      have h2 : v j ≤ (⌊M⌋₊ : ℤ) := hv.2 j
      have habs : |v j| ≤ (⌊M⌋₊ : ℤ) := abs_le.mpr ⟨h1, h2⟩
      have h3 : |((v j : ℤ) : ℝ)| ≤ ((⌊M⌋₊ : ℕ) : ℝ) := by
        rw [← Int.cast_abs]; exact_mod_cast habs
      exact h3.trans (Nat.floor_le (by linarith))
    have hbs0 : 0 ≤ basisSupNorm ω x := Real.iSup_nonneg (fun j => abs_nonneg _)
    have hcan0 : 0 ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) :=
      Real.iSup_nonneg (fun w => apply_nonneg w _)
    have hs1 : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) ≤
        canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ Module.finrank ℚ K := by
      have hle : ∀ w : NumberField.InfinitePlace K,
          w (algebraMap (NumberField.RingOfIntegers K) K x)
            ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) := fun w =>
        le_ciSup (f := fun w : NumberField.InfinitePlace K =>
          w (algebraMap (NumberField.RingOfIntegers K) K x)) (Set.finite_range _).bddAbove w
      have h1 : ∏ w : NumberField.InfinitePlace K,
            w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult
          ≤ ∏ w : NumberField.InfinitePlace K,
            canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult :=
        Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w _) _)
          (fun w _ => pow_le_pow_left₀ (apply_nonneg w _) (hle w) _)
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
      have hcast : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) = ∏ w : NumberField.InfinitePlace K,
          w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult := by
        rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs,
          Rat.cast_abs]
        congr 1
        have hn := Algebra.coe_norm_int x
        rw [show algebraMap (NumberField.RingOfIntegers K) K x = (x : K) from rfl, ← hn]
        simp
      rw [hcast]; exact h1
    calc (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ)
        ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ Module.finrank ℚ K := hs1
      _ ≤ (C * basisSupNorm ω x) ^ Module.finrank ℚ K :=
          pow_le_pow_left₀ hcan0 ((hω.2 x).2) _
      _ ≤ (C * M) ^ Module.finrank ℚ K :=
          pow_le_pow_left₀ (mul_nonneg (by linarith) hbs0)
            (mul_le_mul_of_nonneg_left hs3 (by linarith)) _
  
  have hBcard : M ^ Module.finrank ℚ K ≤ ((omegaBox ω M).card : ℝ) := by
    have hc : (omegaBox ω M).card = (2 * ⌊M⌋₊ + 1) ^ Module.finrank ℚ K := by
      unfold omegaBox
      rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective]
      rw [intBox, Pi.card_Icc]
      simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      congr 1
      omega
    rw [hc]
    push_cast
    apply pow_le_pow_left₀ hMpos.le
    have := Nat.lt_floor_add_one M
    have h0 : (0:ℝ) ≤ (⌊M⌋₊ : ℝ) := Nat.cast_nonneg _
    linarith
  
  obtain ⟨V, hV⟩ : ∃ V : Ideal (NumberField.RingOfIntegers K) → ℂ, ∀ 𝔡, V 𝔡 =
      ∑ 𝔡₁ ∈ I₁, L 𝔡₁ *
        ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => Ideal.span {x} = 𝔡₁ * 𝔡) (fun _ => Classical.propDecidable _)
          (omegaBox ω M), Φ x := ⟨_, fun _ => rfl⟩
  have hform : kaiTypeIIForm ω M Φ I₁ I₂ L T = ∑ 𝔡 ∈ I₂, T 𝔡 * V 𝔡 := by
    unfold kaiTypeIIForm
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
    rw [hV 𝔡, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun 𝔡₁ _ => ?_)
    rw [← mul_assoc, mul_comm (T 𝔡) (L 𝔡₁)]
  
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = ∑ 𝔡 ∈ I₂, (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2 := ⟨_, rfl⟩
  have hCS : ‖∑ 𝔡 ∈ I₂, T 𝔡 * V 𝔡‖ ^ 2
      ≤ (∑ 𝔡 ∈ I₂, ‖T 𝔡‖ ^ 2 / (Ideal.absNorm 𝔡 : ℝ)) * W := by
    have h1 : ‖∑ 𝔡 ∈ I₂, T 𝔡 * V 𝔡‖ ≤ ∑ 𝔡 ∈ I₂, ‖T 𝔡‖ * ‖V 𝔡‖ := by
      refine (norm_sum_le _ _).trans (le_of_eq ?_)
      exact Finset.sum_congr rfl (fun 𝔡 _ => norm_mul _ _)
    have h2 := Finset.sum_mul_sq_le_sq_mul_sq I₂
      (fun 𝔡 => ‖T 𝔡‖ / Real.sqrt (Ideal.absNorm 𝔡 : ℝ))
      (fun 𝔡 => Real.sqrt (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖)
    have e1 : ∑ 𝔡 ∈ I₂, ‖T 𝔡‖ / Real.sqrt (Ideal.absNorm 𝔡 : ℝ) *
        (Real.sqrt (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖) = ∑ 𝔡 ∈ I₂, ‖T 𝔡‖ * ‖V 𝔡‖ := by
      refine Finset.sum_congr rfl (fun 𝔡 h𝔡 => ?_)
      have hs : 0 < Real.sqrt (Ideal.absNorm 𝔡 : ℝ) := Real.sqrt_pos.mpr (hNpos 𝔡 h𝔡)
      field_simp
    have e2 : ∑ 𝔡 ∈ I₂, (‖T 𝔡‖ / Real.sqrt (Ideal.absNorm 𝔡 : ℝ)) ^ 2
        = ∑ 𝔡 ∈ I₂, ‖T 𝔡‖ ^ 2 / (Ideal.absNorm 𝔡 : ℝ) := by
      refine Finset.sum_congr rfl (fun 𝔡 h𝔡 => ?_)
      rw [div_pow, Real.sq_sqrt (hNpos 𝔡 h𝔡).le]
    have e3 : ∑ 𝔡 ∈ I₂, (Real.sqrt (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖) ^ 2 = W := by
      rw [hW]
      refine Finset.sum_congr rfl (fun 𝔡 _ => ?_)
      rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg _)]
    beta_reduce at h2
    rw [e1, e2, e3] at h2
    calc ‖∑ 𝔡 ∈ I₂, T 𝔡 * V 𝔡‖ ^ 2 ≤ (∑ 𝔡 ∈ I₂, ‖T 𝔡‖ * ‖V 𝔡‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h1 2
      _ ≤ _ := h2
  have hWnn : 0 ≤ W := by
    rw [hW]; exact Finset.sum_nonneg (fun 𝔡 _ => by positivity)
  have hB0 : 0 ≤ δ * ((omegaBox ω M).card : ℝ) := by positivity
  rw [hform] at hbig
  have hsq : (δ * ((omegaBox ω M).card : ℝ)) ^ 2 < ‖∑ 𝔡 ∈ I₂, T 𝔡 * V 𝔡‖ ^ 2 := by
    nlinarith [hbig, hB0]
  have hmain : (δ * ((omegaBox ω M).card : ℝ)) ^ 2 < Real.log M ^ 8 * W :=
    lt_of_lt_of_le hsq (hCS.trans (mul_le_mul_of_nonneg_right hT hWnn))
  have hWpos : 0 < W := by
    by_contra hcon
    push_neg at hcon
    have : Real.log M ^ 8 * W ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (by positivity) hcon
    nlinarith [sq_nonneg (δ * ((omegaBox ω M).card : ℝ))]
  
  have hsupp : ∀ 𝔡, V 𝔡 ≠ 0 →
      (Ideal.absNorm 𝔡 : ℝ) * A ≤ (C * M) ^ Module.finrank ℚ K := by
    intro 𝔡 hV0
    have hex : ∃ 𝔡₁ ∈ I₁, ∃ x ∈ omegaBox ω M, Ideal.span {x} = 𝔡₁ * 𝔡 := by
      by_contra hcon
      push_neg at hcon
      apply hV0
      rw [hV 𝔡]
      refine Finset.sum_eq_zero (fun 𝔡₁ h𝔡₁ => ?_)
      rw [Finset.sum_eq_zero, mul_zero]
      intro x hx
      rw [Finset.mem_filter] at hx
      exact absurd hx.2 (hcon 𝔡₁ h𝔡₁ x hx.1)
    obtain ⟨𝔡₁, h𝔡₁, x, hx, hspan⟩ := hex
    have hnorm := hnormle x hx
    have heq : ((Algebra.norm ℤ x).natAbs : ℝ)
        = (Ideal.absNorm 𝔡₁ : ℝ) * (Ideal.absNorm 𝔡 : ℝ) := by
      rw [← Ideal.absNorm_span_singleton, hspan, map_mul, Nat.cast_mul]
    have h1 := (hI₁ 𝔡₁ h𝔡₁).2
    calc (Ideal.absNorm 𝔡 : ℝ) * A ≤ (Ideal.absNorm 𝔡 : ℝ) * (Ideal.absNorm 𝔡₁ : ℝ) :=
          mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)
      _ = ((Algebra.norm ℤ x).natAbs : ℝ) := by rw [heq, mul_comm]
      _ ≤ _ := hnorm
  
  have bracket : ∀ r X : ℝ, 1 ≤ r → r ≤ X →
      (2:ℝ) ^ (Nat.log 2 ⌊r⌋₊) ≤ r ∧ r < (2:ℝ) ^ (Nat.log 2 ⌊r⌋₊ + 1) ∧
        (Nat.log 2 ⌊r⌋₊ : ℝ) ≤ 2 * Real.log X := by
    intro r X hr hrX
    have hx1 : 1 ≤ ⌊r⌋₊ := Nat.le_floor (by exact_mod_cast hr)
    have hx0 : ⌊r⌋₊ ≠ 0 := by omega
    have ha : 2 ^ (Nat.log 2 ⌊r⌋₊) ≤ ⌊r⌋₊ := Nat.pow_log_le_self 2 hx0
    have hb : ⌊r⌋₊ < 2 ^ (Nat.log 2 ⌊r⌋₊).succ := Nat.lt_pow_succ_log_self (by norm_num) _
    have ha' : (2:ℝ) ^ (Nat.log 2 ⌊r⌋₊) ≤ r := by
      calc (2:ℝ) ^ (Nat.log 2 ⌊r⌋₊) = ((2 ^ (Nat.log 2 ⌊r⌋₊) : ℕ) : ℝ) := by push_cast; ring
        _ ≤ (⌊r⌋₊ : ℝ) := by exact_mod_cast ha
        _ ≤ r := Nat.floor_le (by linarith)
    refine ⟨ha', ?_, ?_⟩
    · have hb' : ⌊r⌋₊ + 1 ≤ 2 ^ (Nat.log 2 ⌊r⌋₊ + 1) := hb
      have hb'' : (⌊r⌋₊ : ℝ) + 1 ≤ (2:ℝ) ^ (Nat.log 2 ⌊r⌋₊ + 1) := by exact_mod_cast hb'
      have := Nat.lt_floor_add_one r
      linarith
    · have h2pos : (0:ℝ) < (2:ℝ) ^ (Nat.log 2 ⌊r⌋₊) := by positivity
      have hlog := Real.log_le_log h2pos (ha'.trans hrX)
      rw [Real.log_pow] at hlog
      have hl2 := Real.log_two_gt_d9
      have hj0 : (0:ℝ) ≤ (Nat.log 2 ⌊r⌋₊ : ℝ) := Nat.cast_nonneg _
      nlinarith
  
  obtain ⟨Cp, hCp⟩ : ∃ Cp : ℝ, Cp = 2 * ((Module.finrank ℚ K : ℝ) * Real.log C
      + (Module.finrank ℚ K : ℝ) + 1) := ⟨_, rfl⟩
  have hCppos : 0 < Cp := by rw [hCp]; positivity
  obtain ⟨Jn, hJn⟩ : ∃ Jn : ℕ, Jn = ⌊Cp * Real.log M⌋₊ := ⟨_, rfl⟩
  have hJnle : (Jn : ℝ) ≤ Cp * Real.log M := by
    rw [hJn]; exact Nat.floor_le (mul_nonneg hCppos.le (by linarith))
  obtain ⟨jf, hjf⟩ : ∃ jf : Ideal (NumberField.RingOfIntegers K) → ℕ,
      ∀ 𝔡, jf 𝔡 = Nat.log 2 ⌊(Ideal.absNorm 𝔡 : ℝ) / A⌋₊ := ⟨_, fun _ => rfl⟩
  obtain ⟨I₂', hI₂'⟩ : ∃ I₂' : Finset (Ideal (NumberField.RingOfIntegers K)),
      I₂' = I₂.filter (fun 𝔡 => V 𝔡 ≠ 0) := ⟨_, rfl⟩
  have hI₂'mem : ∀ 𝔡 ∈ I₂', 𝔡 ∈ I₂ ∧ V 𝔡 ≠ 0 := by
    intro 𝔡 h; rw [hI₂', Finset.mem_filter] at h; exact h
  have hr1 : ∀ 𝔡 ∈ I₂', 1 ≤ (Ideal.absNorm 𝔡 : ℝ) / A ∧
      (Ideal.absNorm 𝔡 : ℝ) / A ≤ (C * M) ^ Module.finrank ℚ K := by
    intro 𝔡 h𝔡
    obtain ⟨h1, h2⟩ := hI₂'mem 𝔡 h𝔡
    have hs := hsupp 𝔡 h2
    have hN0 : (0:ℝ) ≤ (Ideal.absNorm 𝔡 : ℝ) := Nat.cast_nonneg _
    constructor
    · rw [le_div_iff₀ hApos, one_mul]; exact (hI₂ 𝔡 h1).2
    · calc (Ideal.absNorm 𝔡 : ℝ) / A ≤ (Ideal.absNorm 𝔡 : ℝ) := div_le_self hN0 hA1
        _ ≤ (Ideal.absNorm 𝔡 : ℝ) * A := le_mul_of_one_le_right hN0 hA1
        _ ≤ _ := hs
  have hjlt : ∀ 𝔡 ∈ I₂', jf 𝔡 < Jn := by
    intro 𝔡 h𝔡
    obtain ⟨h1, h2⟩ := hr1 𝔡 h𝔡
    obtain ⟨-, -, h3⟩ := bracket _ _ h1 h2
    rw [← hjf 𝔡, Real.log_pow, Real.log_mul hCpos.ne' hMpos.ne'] at h3
    have hk : ((jf 𝔡 + 1 : ℕ) : ℝ) ≤ Cp * Real.log M := by
      push_cast
      rw [hCp]
      have := mul_nonneg (mul_nonneg hnpos.le hlogC.le) (sub_nonneg.mpr hℓ1)
      nlinarith
    have := Nat.le_floor hk
    rw [← hJn] at this
    omega
  
  have hWeq : ∑ 𝔡 ∈ I₂', (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2 = W := by
    rw [hI₂', hW]
    apply Finset.sum_filter_of_ne
    intro 𝔡 _ hne hV0
    apply hne
    rw [hV0, norm_zero]; ring
  obtain ⟨t, ht⟩ : ∃ t : Finset (Fin h × ℕ),
      t = (Finset.univ : Finset (Fin h)) ×ˢ Finset.range Jn := ⟨_, rfl⟩
  have hmaps : ∀ 𝔡 ∈ I₂', (G 𝔡, jf 𝔡) ∈ t := by
    intro 𝔡 h𝔡
    rw [ht, Finset.mem_product]
    exact ⟨Finset.mem_univ _, Finset.mem_range.mpr (hjlt 𝔡 h𝔡)⟩
  have hI₂'ne : I₂'.Nonempty := by
    apply Finset.nonempty_of_sum_ne_zero (f := fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2)
    rw [hWeq]; exact hWpos.ne'
  obtain ⟨𝔡₀, h𝔡₀⟩ := hI₂'ne
  have htne : t.Nonempty := ⟨_, hmaps 𝔡₀ h𝔡₀⟩
  have htcard : (t.card : ℝ) = (h : ℝ) * (Jn : ℝ) := by
    rw [ht, Finset.card_product, Finset.card_univ, Fintype.card_fin, Finset.card_range]
    push_cast; ring
  have htpos : (0:ℝ) < t.card := by exact_mod_cast htne.card_pos
  have htW : (t.card : ℝ) * (W / t.card) = W := by field_simp
  obtain ⟨y, hyt, hy⟩ := Finset.exists_le_sum_fiber_of_maps_to_of_nsmul_le_sum
    (f := fun 𝔡 => (G 𝔡, jf 𝔡)) (b := W / t.card)
    (w := fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2) hmaps htne
    (le_of_eq (by rw [nsmul_eq_mul, htW]; exact hWeq.symm))
  obtain ⟨J, hJsub, hJprop, hJsum⟩ : ∃ J : Finset (Ideal (NumberField.RingOfIntegers K)),
      J ⊆ I₂' ∧ (∀ 𝔡 ∈ J, (G 𝔡, jf 𝔡) = y) ∧
      W / t.card ≤ ∑ 𝔡 ∈ J, (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2 :=
    ⟨I₂'.filter (fun 𝔡 => (G 𝔡, jf 𝔡) = y), Finset.filter_subset _ _,
      fun 𝔡 h𝔡 => (Finset.mem_filter.mp h𝔡).2, hy⟩
  have hJne : J.Nonempty := by
    apply Finset.nonempty_of_sum_ne_zero (f := fun 𝔡 => (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2)
    have : 0 < W / t.card := div_pos hWpos htpos
    exact (lt_of_lt_of_le this hJsum).ne'
  
  obtain ⟨D₀, hD₀⟩ : ∃ D₀ : ℝ, D₀ = 2 ^ y.2 * A := ⟨_, rfl⟩
  have hAD₀ : A ≤ D₀ := by
    rw [hD₀]; exact le_mul_of_one_le_left hApos.le (one_le_pow₀ (by norm_num))
  have hD₀pos : 0 < D₀ := by linarith
  have hJbr : ∀ 𝔡 ∈ J, D₀ ≤ (Ideal.absNorm 𝔡 : ℝ) ∧ (Ideal.absNorm 𝔡 : ℝ) < 2 * D₀ := by
    intro 𝔡 h𝔡
    obtain ⟨h1, h2⟩ := hr1 𝔡 (hJsub h𝔡)
    obtain ⟨b1, b2, -⟩ := bracket _ _ h1 h2
    have hj : jf 𝔡 = y.2 := congrArg Prod.snd (hJprop 𝔡 h𝔡)
    rw [← hjf 𝔡, hj] at b1 b2
    have hre : (Ideal.absNorm 𝔡 : ℝ) / A * A = (Ideal.absNorm 𝔡 : ℝ) := by field_simp
    constructor
    · rw [hD₀]
      calc 2 ^ y.2 * A ≤ (Ideal.absNorm 𝔡 : ℝ) / A * A :=
            mul_le_mul_of_nonneg_right b1 hApos.le
        _ = _ := hre
    · rw [hD₀]
      calc (Ideal.absNorm 𝔡 : ℝ) = (Ideal.absNorm 𝔡 : ℝ) / A * A := hre.symm
        _ < 2 ^ (y.2 + 1) * A := mul_lt_mul_of_pos_right b2 hApos
        _ = 2 * (2 ^ y.2 * A) := by rw [pow_succ]; ring
  
  obtain ⟨e, he⟩ : ∃ e : ℝ, e = (1:ℝ) / (Module.finrank ℚ K : ℝ) := ⟨_, rfl⟩
  have he0 : 0 ≤ e := by rw [he]; positivity
  have he1 : e ≤ 1 := by rw [he, div_le_one hnpos]; exact hnR
  have heinv : e = ((Module.finrank ℚ K : ℕ) : ℝ)⁻¹ := by rw [he, one_div]
  obtain ⟨D₁, hD₁⟩ : ∃ D₁ : ℝ, D₁ = D₀ ^ e := ⟨_, rfl⟩
  have hD₁n : D₁ ^ Module.finrank ℚ K = D₀ := by
    rw [hD₁, heinv]; exact Real.rpow_inv_natCast_pow hD₀pos.le hn0
  have hAe : A ^ e = M ^ ((1:ℝ) / 4) := by
    rw [hA, ← Real.rpow_mul hMpos.le, he]
    congr 1
    field_simp
  have hM14 : M ^ ((1:ℝ) / 4) * M ^ ((3:ℝ) / 4) = M := by
    rw [← Real.rpow_add hMpos]; norm_num
  have hM14pos : 0 < M ^ ((1:ℝ) / 4) := Real.rpow_pos_of_pos hMpos _
  have hD₁lo : M ^ ((1:ℝ) / 4) ≤ D₁ := by
    rw [← hAe, hD₁]; exact Real.rpow_le_rpow hApos.le hAD₀ he0
  have hD₁hi : D₁ ≤ C * M ^ ((3:ℝ) / 4) := by
    obtain ⟨𝔡s, h𝔡s⟩ := hJne
    have h1 : D₀ * A ≤ (C * M) ^ Module.finrank ℚ K :=
      (mul_le_mul_of_nonneg_right (hJbr 𝔡s h𝔡s).1 hApos.le).trans
        (hsupp 𝔡s (hI₂'mem 𝔡s (hJsub h𝔡s)).2)
    have h2 := Real.rpow_le_rpow (mul_pos hD₀pos hApos).le h1 he0
    rw [Real.mul_rpow hD₀pos.le hApos.le, hAe, ← hD₁, heinv,
      Real.pow_rpow_inv_natCast hCMpos.le hn0] at h2
    refine le_of_mul_le_mul_right ?_ hM14pos
    calc D₁ * M ^ ((1:ℝ) / 4) ≤ C * M := h2
      _ = C * M ^ ((3:ℝ) / 4) * M ^ ((1:ℝ) / 4) := by
          rw [mul_assoc, mul_comm (M ^ ((3:ℝ) / 4)), hM14]
  have hJfacts : ∀ 𝔡 ∈ J, G 𝔡 = y.1 ∧
      D₁ ≤ (Ideal.absNorm 𝔡 : ℝ) ^ e ∧ (Ideal.absNorm 𝔡 : ℝ) ^ e ≤ 2 * D₁ := by
    intro 𝔡 h𝔡
    obtain ⟨b1, b2⟩ := hJbr 𝔡 h𝔡
    refine ⟨congrArg Prod.fst (hJprop 𝔡 h𝔡), ?_, ?_⟩
    · rw [hD₁]; exact Real.rpow_le_rpow hD₀pos.le b1 he0
    · have h2e : (2:ℝ) ^ e ≤ 2 := by
        calc (2:ℝ) ^ e ≤ (2:ℝ) ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) he1
          _ = 2 := Real.rpow_one 2
      calc (Ideal.absNorm 𝔡 : ℝ) ^ e ≤ (2 * D₀) ^ e :=
            Real.rpow_le_rpow (Nat.cast_nonneg _) b2.le he0
        _ = (2:ℝ) ^ e * D₀ ^ e := Real.mul_rpow (by norm_num) hD₀pos.le
        _ ≤ 2 * D₀ ^ e := mul_le_mul_of_nonneg_right h2e (Real.rpow_nonneg hD₀pos.le _)
        _ = 2 * D₁ := by rw [hD₁]
  
  have hSJ : ∑ 𝔡 ∈ J, (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2
      ≤ 2 * D₀ * ∑ 𝔡 ∈ J, ‖V 𝔡‖ ^ 2 := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum (fun 𝔡 h𝔡 =>
      mul_le_mul_of_nonneg_right (hJbr 𝔡 h𝔡).2.le (by positivity))
  have hWle : W ≤ (t.card : ℝ) * ∑ 𝔡 ∈ J, (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2 := by
    rw [div_le_iff₀ htpos] at hJsum; linarith
  have hh1 : (0:ℝ) ≤ (h : ℝ) + 1 := by positivity
  have hCℓ : 0 ≤ Cp * Real.log M := mul_nonneg hCppos.le (by linarith)
  have htle : (t.card : ℝ) ≤ ((h:ℝ) + 1) * (Cp * Real.log M) := by
    rw [htcard]; exact mul_le_mul (by linarith) hJnle (Nat.cast_nonneg _) hh1
  have hδB : δ ^ 2 * M ^ (2 * Module.finrank ℚ K)
      ≤ (δ * ((omegaBox ω M).card : ℝ)) ^ 2 := by
    rw [mul_pow, pow_mul']
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hBcard 2) (by positivity)
  have hSJw : 0 ≤ ∑ 𝔡 ∈ J, (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2 :=
    Finset.sum_nonneg (fun _ _ => by positivity)
  have hfinal : δ ^ 2 * M ^ (2 * Module.finrank ℚ K) ≤
      2 * D₁ ^ Module.finrank ℚ K * ((h : ℝ) + 1) * Cp * Real.log M ^ 9 *
        ∑ 𝔡 ∈ J, ‖V 𝔡‖ ^ 2 := by
    calc δ ^ 2 * M ^ (2 * Module.finrank ℚ K)
        ≤ (δ * ((omegaBox ω M).card : ℝ)) ^ 2 := hδB
      _ ≤ Real.log M ^ 8 * W := hmain.le
      _ ≤ Real.log M ^ 8 * ((t.card : ℝ) * ∑ 𝔡 ∈ J, (Ideal.absNorm 𝔡 : ℝ) * ‖V 𝔡‖ ^ 2) :=
          mul_le_mul_of_nonneg_left hWle (by positivity)
      _ ≤ Real.log M ^ 8 * ((((h:ℝ) + 1) * (Cp * Real.log M)) *
            (2 * D₀ * ∑ 𝔡 ∈ J, ‖V 𝔡‖ ^ 2)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul htle hSJ hSJw (mul_nonneg hh1 hCℓ))
            (by positivity)
      _ = 2 * D₁ ^ Module.finrank ℚ K * ((h : ℝ) + 1) * Cp * Real.log M ^ 9 *
            ∑ 𝔡 ∈ J, ‖V 𝔡‖ ^ 2 := by
          rw [hD₁n]; ring
  rw [he] at hJfacts
  rw [hCp] at hfinal
  refine ⟨y.1, D₁, J, fun 𝔡 h𝔡 => (hI₂'mem 𝔡 (hJsub h𝔡)).1, hJne, hD₁lo, hD₁hi,
    hJfacts, ?_⟩
  simpa only [hV] using hfinal

theorem kai_t2_param_rewrite (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) (M : ℝ)
    (φ : (Fin (Module.finrank ℚ K) → ℤ) → ℂ)
    (c : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℤ)
    (t t' : Fin (Module.finrank ℚ K) → ℤ) (𝔡 𝔡' : Ideal (NumberField.RingOfIntegers K))
    (I₁ : Finset (Ideal (NumberField.RingOfIntegers K)))
    (L : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (Bx : Finset (Fin (Module.finrank ℚ K) → ℤ))
    (hP4 : ∀ x : NumberField.RingOfIntegers K, x ∈ 𝔡 ↔ ∃ w, ω.equivFun x = kaiBil c t w)
    (hP5 : Function.Injective (kaiBil c t))
    (hP7 : ∀ (w : Fin (Module.finrank ℚ K) → ℤ) (𝔡₁ : Ideal (NumberField.RingOfIntegers K)),
      Ideal.span {ω.equivFun.symm (kaiBil c t w)} = 𝔡₁ * 𝔡 ↔
        Ideal.span {ω.equivFun.symm (kaiBil c t' w)} = 𝔡₁ * 𝔡')
    (hBx : ∀ w, (∀ l, |(kaiBil c t w l : ℝ)| ≤ (⌊M⌋₊ : ℝ)) → w ∈ Bx) :
    ∑ 𝔡₁ ∈ I₁, L 𝔡₁ *
        ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
            (fun x => Ideal.span {x} = 𝔡₁ * 𝔡) (fun _ => Classical.propDecidable _)
            (omegaBox ω M), φ (ω.equivFun x)
      = ∑ w ∈ Bx.filter (fun w => ∀ l, |(kaiBil c t w l : ℝ)| ≤ (⌊M⌋₊ : ℝ)),
          (∑ 𝔡₁ ∈ I₁, L 𝔡₁ *
            @ite ℂ (Ideal.span {ω.equivFun.symm (kaiBil c t' w)} = 𝔡₁ * 𝔡')
              (Classical.propDecidable _) 1 0)
          * φ (kaiBil c t w) :=
by
  
  have hB : ∀ x : NumberField.RingOfIntegers K,
      x ∈ omegaBox ω M ↔ ∀ l, |((ω.equivFun x l : ℤ) : ℝ)| ≤ (⌊M⌋₊ : ℝ) := by
    intro x
    unfold omegaBox intBox
    simp only [Finset.mem_image]
    constructor
    · rintro ⟨v, hv, rfl⟩ l
      rw [Finset.mem_Icc] at hv
      have h1 : -((⌊M⌋₊ : ℕ) : ℤ) ≤ v l := hv.1 l
      have h2 : v l ≤ ((⌊M⌋₊ : ℕ) : ℤ) := hv.2 l
      rw [LinearEquiv.apply_symm_apply, abs_le]
      constructor
      · exact_mod_cast h1
      · exact_mod_cast h2
    · intro h
      refine ⟨ω.equivFun x, ?_, LinearEquiv.symm_apply_apply _ _⟩
      rw [Finset.mem_Icc]
      constructor
      · intro l
        have := (abs_le.mp (h l)).1
        show -((⌊M⌋₊ : ℕ) : ℤ) ≤ ω.equivFun x l
        exact_mod_cast this
      · intro l
        have := (abs_le.mp (h l)).2
        show ω.equivFun x l ≤ ((⌊M⌋₊ : ℕ) : ℤ)
        exact_mod_cast this
  
  have hinner : ∀ 𝔡₁ : Ideal (NumberField.RingOfIntegers K),
      ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
          (fun x => Ideal.span {x} = 𝔡₁ * 𝔡) (fun _ => Classical.propDecidable _)
          (omegaBox ω M), φ (ω.equivFun x)
        = ∑ w ∈ Bx.filter (fun w => ∀ l, |(kaiBil c t w l : ℝ)| ≤ (⌊M⌋₊ : ℝ)),
            @ite ℂ (Ideal.span {ω.equivFun.symm (kaiBil c t' w)} = 𝔡₁ * 𝔡')
              (Classical.propDecidable _) 1 0 * φ (kaiBil c t w) := by
    intro 𝔡₁
    classical
    have hR : ∀ w : Fin (Module.finrank ℚ K) → ℤ,
        @ite ℂ (Ideal.span {ω.equivFun.symm (kaiBil c t' w)} = 𝔡₁ * 𝔡')
            (Classical.propDecidable _) 1 0 * φ (kaiBil c t w)
          = @ite ℂ (Ideal.span {ω.equivFun.symm (kaiBil c t w)} = 𝔡₁ * 𝔡)
            (Classical.propDecidable _) (φ (kaiBil c t w)) 0 := by
      intro w
      rw [ite_mul, one_mul, zero_mul]
      exact if_congr (hP7 w 𝔡₁).symm rfl rfl
    rw [Finset.sum_congr rfl (fun w _ => hR w), ← Finset.sum_filter]
    symm
    apply Finset.sum_nbij (fun w => ω.equivFun.symm (kaiBil c t w))
    · intro w hw
      rw [Finset.mem_filter, Finset.mem_filter] at hw
      rw [Finset.mem_filter]
      refine ⟨(hB _).2 ?_, hw.2⟩
      rw [LinearEquiv.apply_symm_apply]
      exact hw.1.2
    · intro a _ b _ hab
      exact hP5 (ω.equivFun.symm.injective hab)
    · intro x hx
      rw [Finset.mem_coe, Finset.mem_filter] at hx
      obtain ⟨hxB, hxs⟩ := hx
      have hxd : x ∈ 𝔡 := by
        have hx1 : x ∈ Ideal.span {x} := Ideal.mem_span_singleton_self x
        rw [hxs] at hx1
        exact Ideal.mul_le_left hx1
      obtain ⟨w, hw⟩ := (hP4 x).1 hxd
      have hIn : ∀ l, |((kaiBil c t w l : ℤ) : ℝ)| ≤ (⌊M⌋₊ : ℝ) := by
        rw [← hw]
        exact (hB x).1 hxB
      have hy : ω.equivFun.symm (kaiBil c t w) = x := by
        rw [← hw, LinearEquiv.symm_apply_apply]
      refine ⟨w, ?_, hy⟩
      rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_filter]
      refine ⟨⟨hBx w hIn, hIn⟩, ?_⟩
      show Ideal.span {ω.equivFun.symm (kaiBil c t w)} = 𝔡₁ * 𝔡
      rw [hy]
      exact hxs
    · intro w _
      show φ (kaiBil c t w) = φ (ω.equivFun (ω.equivFun.symm (kaiBil c t w)))
      rw [LinearEquiv.apply_symm_apply]
  
  simp only [hinner]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun w _ => ?_)
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl (fun _ _ => ?_)
  ring

theorem kai_t2_cube_grid (ν G Lc RZ : ℕ) (hLc : 1 ≤ Lc) (hcov : 2 * RZ + 1 ≤ G * Lc) :
    ((Fintype.piFinset (fun _ : Fin ν => Finset.range G) : Set (Fin ν → ℕ)).PairwiseDisjoint
      (kaiT2Cube (fun _ : Fin ν => -(RZ : ℤ)) Lc)) ∧
    (∀ w : Fin ν → ℤ, (∀ i, |w i| ≤ (RZ : ℤ)) →
      ∃ m ∈ Fintype.piFinset (fun _ : Fin ν => Finset.range G),
        w ∈ kaiT2Cube (fun _ : Fin ν => -(RZ : ℤ)) Lc m) ∧
    (∀ (z₀ : Fin ν → ℤ) (m : Fin ν → ℕ), (kaiT2Cube z₀ Lc m).card = Lc ^ ν) ∧
    (Fintype.piFinset (fun _ : Fin ν => Finset.range G)).card = G ^ ν :=
by
  have hL : (0 : ℤ) < (Lc : ℤ) := by exact_mod_cast hLc
  have hcovZ : 2 * (RZ : ℤ) + 1 ≤ (G : ℤ) * (Lc : ℤ) := by exact_mod_cast hcov
  have hmem : ∀ (z₀ w : Fin ν → ℤ) (m : Fin ν → ℕ), w ∈ kaiT2Cube z₀ Lc m ↔
      ∀ i, z₀ i + (Lc : ℤ) * (m i : ℤ) ≤ w i ∧
        w i ≤ z₀ i + (Lc : ℤ) * (m i : ℤ) + ((Lc : ℤ) - 1) := by
    intro z₀ w m
    unfold kaiT2Cube
    rw [Finset.mem_Icc, Pi.le_def, Pi.le_def]
    simp only [Pi.add_apply]
    exact ⟨fun h i => ⟨h.1 i, h.2 i⟩, fun h => ⟨fun i => (h i).1, fun i => (h i).2⟩⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro m _ m' _ hne
    show Disjoint (kaiT2Cube (fun _ : Fin ν => -(RZ : ℤ)) Lc m)
      (kaiT2Cube (fun _ : Fin ν => -(RZ : ℤ)) Lc m')
    rw [Finset.disjoint_left]
    intro w hw hw'
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hne
    obtain ⟨hA, hB⟩ := (hmem _ w m).1 hw i
    obtain ⟨hC, hD⟩ := (hmem _ w m').1 hw' i
    have h1 : (Lc : ℤ) * (m i : ℤ) < (Lc : ℤ) * ((m' i : ℤ) + 1) := by
      have : (Lc : ℤ) * ((m' i : ℤ) + 1) = (Lc : ℤ) * (m' i : ℤ) + Lc := by ring
      rw [this]; linarith
    have h2 : (Lc : ℤ) * (m' i : ℤ) < (Lc : ℤ) * ((m i : ℤ) + 1) := by
      have : (Lc : ℤ) * ((m i : ℤ) + 1) = (Lc : ℤ) * (m i : ℤ) + Lc := by ring
      rw [this]; linarith
    have h1' := Int.lt_of_mul_lt_mul_left h1 hL.le
    have h2' := Int.lt_of_mul_lt_mul_left h2 hL.le
    have : (m i : ℤ) = (m' i : ℤ) := by omega
    exact hi (by exact_mod_cast this)
  · intro w hw
    have hbd : ∀ i, -(RZ : ℤ) ≤ w i ∧ w i ≤ (RZ : ℤ) := fun i => abs_le.mp (hw i)
    have hq0 : ∀ i, 0 ≤ (w i + RZ) / (Lc : ℤ) := fun i =>
      Int.ediv_nonneg (by linarith [(hbd i).1]) hL.le
    refine ⟨fun i => ((w i + RZ) / (Lc : ℤ)).toNat, ?_, ?_⟩
    · rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_range]
      have hlt : (w i + RZ) / (Lc : ℤ) < (G : ℤ) :=
        Int.ediv_lt_of_lt_mul hL (by linarith [(hbd i).2])
      have := hq0 i
      omega
    · rw [hmem]
      intro i
      have hcast : ((((w i + RZ) / (Lc : ℤ)).toNat : ℕ) : ℤ) = (w i + RZ) / (Lc : ℤ) :=
        Int.toNat_of_nonneg (hq0 i)
      simp only [hcast]
      have hlo := Int.mul_ediv_self_le (x := w i + RZ) (k := (Lc : ℤ)) hL.ne'
      have hhi := Int.lt_ediv_add_one_mul_self (w i + RZ) hL
      have : ((w i + RZ) / (Lc : ℤ) + 1) * (Lc : ℤ)
          = (Lc : ℤ) * ((w i + RZ) / (Lc : ℤ)) + Lc := by ring
      rw [this] at hhi
      constructor <;> linarith
  · intro z₀ m
    unfold kaiT2Cube
    rw [Pi.card_Icc]
    simp only [Pi.add_apply]
    have hf : ∀ i, (Finset.Icc (z₀ i + (Lc : ℤ) * (m i : ℤ))
        (z₀ i + (Lc : ℤ) * (m i : ℤ) + ((Lc : ℤ) - 1))).card = Lc := by
      intro i
      rw [Int.card_Icc]
      have : z₀ i + (Lc : ℤ) * (m i : ℤ) + ((Lc : ℤ) - 1) + 1 - (z₀ i + (Lc : ℤ) * (m i : ℤ))
          = (Lc : ℤ) := by ring
      rw [this, Int.toNat_natCast]
    rw [Finset.prod_congr rfl (fun i _ => hf i), Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
  · rw [Fintype.card_piFinset]
    simp only [Finset.card_range, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

theorem kai_t2_grid_decomp {ι κ μ : Type*} [DecidableEq κ] (J : Finset ι) (Mset : Finset μ)
    (P : μ → Finset κ) (Ω : ι → Finset κ) (F : ι → κ → ℂ) (Q' p mix : ℝ)
    (hQ' : 0 ≤ Q') (hp : 0 ≤ p) (hmix0 : 0 ≤ mix)
    (hdisj : (Mset : Set μ).PairwiseDisjoint P)
    (hcover : ∀ j ∈ J, Ω j ⊆ Mset.biUnion P)
    (hF : ∀ j ∈ J, ∀ w, ‖F j w‖ ≤ Q')
    (hcard : ∀ m ∈ Mset, ((P m).card : ℝ) ≤ p)
    (hmix : ∀ j ∈ J, ((Mset.filter (fun m => (∃ w ∈ P m, w ∈ Ω j) ∧
        (∃ w ∈ P m, w ∉ Ω j))).card : ℝ) ≤ mix) :
    ∑ j ∈ J, ‖∑ w ∈ Ω j, F j w‖ ^ 2
      ≤ 2 * (Mset.card : ℝ) * ∑ m ∈ Mset, ∑ j ∈ J, ‖∑ w ∈ P m, F j w‖ ^ 2
        + 2 * (J.card : ℝ) * (mix * p * Q') ^ 2 :=
by
  have hj : ∀ j ∈ J, ‖∑ w ∈ Ω j, F j w‖ ^ 2 ≤
      2 * (Mset.card : ℝ) * ∑ m ∈ Mset, ‖∑ w ∈ P m, F j w‖ ^ 2
        + 2 * (mix * p * Q') ^ 2 := by
    intro j hjJ
    
    have hsplit : ∑ w ∈ Ω j, F j w
        = ∑ m ∈ Mset, ∑ w ∈ P m, (if w ∈ Ω j then F j w else 0) := by
      calc ∑ w ∈ Ω j, F j w = ∑ w ∈ Ω j, (if w ∈ Ω j then F j w else 0) :=
            Finset.sum_congr rfl (fun w hw => (if_pos hw).symm)
        _ = ∑ w ∈ Mset.biUnion P, (if w ∈ Ω j then F j w else 0) :=
            Finset.sum_subset (hcover j hjJ) (fun w _ hw => if_neg hw)
        _ = ∑ m ∈ Mset, ∑ w ∈ P m, (if w ∈ Ω j then F j w else 0) :=
            Finset.sum_biUnion hdisj
    
    have hite : ∀ w, ‖(if w ∈ Ω j then F j w else 0)‖ ≤ Q' := by
      intro w
      split_ifs
      · exact hF j hjJ w
      · simpa using hQ'
    have hpiece1 : ∀ m ∈ Mset,
        ‖∑ w ∈ P m, (if w ∈ Ω j then F j w else 0)‖ ≤ p * Q' := by
      intro m hm
      calc ‖∑ w ∈ P m, (if w ∈ Ω j then F j w else 0)‖
          ≤ ∑ w ∈ P m, ‖(if w ∈ Ω j then F j w else 0)‖ := norm_sum_le _ _
        _ ≤ ∑ w ∈ P m, Q' := Finset.sum_le_sum (fun w _ => hite w)
        _ = ((P m).card : ℝ) * Q' := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ p * Q' := mul_le_mul_of_nonneg_right (hcard m hm) hQ'
    have hpiece2 : ∀ m ∈ Mset,
        ¬((∃ w ∈ P m, w ∈ Ω j) ∧ (∃ w ∈ P m, w ∉ Ω j)) →
        ‖∑ w ∈ P m, (if w ∈ Ω j then F j w else 0)‖ ≤ ‖∑ w ∈ P m, F j w‖ := by
      intro m _ hnm
      by_cases h1 : ∃ w ∈ P m, w ∈ Ω j
      · have hall : ∀ w ∈ P m, w ∈ Ω j := by
          intro w hw
          by_contra hw'
          exact hnm ⟨h1, ⟨w, hw, hw'⟩⟩
        rw [Finset.sum_congr rfl (fun w hw => if_pos (hall w hw))]
      · have hall : ∀ w ∈ P m, w ∉ Ω j := by
          intro w hw hw'
          exact h1 ⟨w, hw, hw'⟩
        rw [Finset.sum_eq_zero (fun w hw => if_neg (hall w hw)), norm_zero]
        exact norm_nonneg _
    
    set a : μ → ℂ := fun m => ∑ w ∈ P m, (if w ∈ Ω j then F j w else 0) with ha
    set b : μ → ℂ := fun m => ∑ w ∈ P m, F j w with hb
    set B := Mset.filter (fun m => (∃ w ∈ P m, w ∈ Ω j) ∧ (∃ w ∈ P m, w ∉ Ω j)) with hB
    set G := Mset.filter (fun m => ¬((∃ w ∈ P m, w ∈ Ω j) ∧ (∃ w ∈ P m, w ∉ Ω j))) with hG
    have hBcard : (B.card : ℝ) ≤ mix := hmix j hjJ
    have hsum2 : ∑ m ∈ Mset, a m = ∑ m ∈ B, a m + ∑ m ∈ G, a m :=
      (Finset.sum_filter_add_sum_filter_not Mset _ a).symm
    have hpQ : 0 ≤ p * Q' := mul_nonneg hp hQ'
    have hv : ‖∑ m ∈ B, a m‖ ≤ mix * (p * Q') := by
      calc ‖∑ m ∈ B, a m‖ ≤ ∑ m ∈ B, ‖a m‖ := norm_sum_le _ _
        _ ≤ ∑ m ∈ B, p * Q' := Finset.sum_le_sum (fun m hm =>
            hpiece1 m (Finset.mem_filter.1 hm).1)
        _ = (B.card : ℝ) * (p * Q') := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ mix * (p * Q') := mul_le_mul_of_nonneg_right hBcard hpQ
    have hu : ‖∑ m ∈ G, a m‖ ≤ ∑ m ∈ Mset, ‖b m‖ := by
      calc ‖∑ m ∈ G, a m‖ ≤ ∑ m ∈ G, ‖a m‖ := norm_sum_le _ _
        _ ≤ ∑ m ∈ G, ‖b m‖ := Finset.sum_le_sum (fun m hm =>
            hpiece2 m (Finset.mem_filter.1 hm).1 (Finset.mem_filter.1 hm).2)
        _ ≤ ∑ m ∈ Mset, ‖b m‖ := Finset.sum_le_sum_of_subset_of_nonneg
            (Finset.filter_subset _ _) (fun m _ _ => norm_nonneg _)
    have hcs : (∑ m ∈ Mset, ‖b m‖) ^ 2 ≤ (Mset.card : ℝ) * ∑ m ∈ Mset, ‖b m‖ ^ 2 :=
      sq_sum_le_card_mul_sum_sq
    have htot : ‖∑ w ∈ Ω j, F j w‖ ≤ ‖∑ m ∈ G, a m‖ + ‖∑ m ∈ B, a m‖ := by
      rw [hsplit]
      change ‖∑ m ∈ Mset, a m‖ ≤ _
      rw [hsum2, add_comm]
      exact norm_add_le _ _
    have hn0 := norm_nonneg (∑ w ∈ Ω j, F j w)
    have hu0 := norm_nonneg (∑ m ∈ G, a m)
    have hv0 := norm_nonneg (∑ m ∈ B, a m)
    have hU0 : 0 ≤ ∑ m ∈ Mset, ‖b m‖ := Finset.sum_nonneg (fun m _ => norm_nonneg _)
    have hsq1 : ‖∑ w ∈ Ω j, F j w‖ ^ 2 ≤ (‖∑ m ∈ G, a m‖ + ‖∑ m ∈ B, a m‖) ^ 2 :=
      pow_le_pow_left₀ hn0 htot 2
    have hsq2 : ‖∑ m ∈ G, a m‖ ^ 2 ≤ (∑ m ∈ Mset, ‖b m‖) ^ 2 := pow_le_pow_left₀ hu0 hu 2
    have hsq3 : ‖∑ m ∈ B, a m‖ ^ 2 ≤ (mix * (p * Q')) ^ 2 := pow_le_pow_left₀ hv0 hv 2
    have hmixeq : (mix * (p * Q')) ^ 2 = (mix * p * Q') ^ 2 := by ring
    nlinarith [sq_nonneg (‖∑ m ∈ G, a m‖ - ‖∑ m ∈ B, a m‖)]
  have hswap : ∑ j ∈ J, ∑ m ∈ Mset, ‖∑ w ∈ P m, F j w‖ ^ 2
      = ∑ m ∈ Mset, ∑ j ∈ J, ‖∑ w ∈ P m, F j w‖ ^ 2 := Finset.sum_comm
  calc ∑ j ∈ J, ‖∑ w ∈ Ω j, F j w‖ ^ 2
      ≤ ∑ j ∈ J, (2 * (Mset.card : ℝ) * ∑ m ∈ Mset, ‖∑ w ∈ P m, F j w‖ ^ 2
          + 2 * (mix * p * Q') ^ 2) := Finset.sum_le_sum hj
    _ = 2 * (Mset.card : ℝ) * ∑ j ∈ J, ∑ m ∈ Mset, ‖∑ w ∈ P m, F j w‖ ^ 2
          + (J.card : ℝ) * (2 * (mix * p * Q') ^ 2) := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, nsmul_eq_mul]
    _ = 2 * (Mset.card : ℝ) * ∑ m ∈ Mset, ∑ j ∈ J, ‖∑ w ∈ P m, F j w‖ ^ 2
          + 2 * (J.card : ℝ) * (mix * p * Q') ^ 2 := by
        rw [hswap]; ring

theorem kai_t2_typeII_to_pairs (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ (C₉ : ℝ) (A₉ : ℕ), 16 ≤ C₉ ∧ 1 ≤ A₉ ∧
      ∀ (M Q δ : ℝ) (φ : (Fin (Module.finrank ℚ K) → ℤ) → ℂ),
        C₉ ≤ M → 2 ≤ Q → 0 < δ → δ ≤ 1 →
        (∀ z, ‖φ z‖ ≤ Q) →
        (C₉ * Q * Real.log M / δ) ^ A₉ ≤ M ^ ((1:ℝ) / 8) →
        ∀ (I₁ I₂ : Finset (Ideal (NumberField.RingOfIntegers K)))
          (L T : Ideal (NumberField.RingOfIntegers K) → ℂ),
        (∀ 𝔡 ∈ I₁, 𝔡 ≠ ⊥ ∧ M ^ ((Module.finrank ℚ K : ℝ) / 4) ≤ (Ideal.absNorm 𝔡 : ℝ)) →
        (∀ 𝔡 ∈ I₂, 𝔡 ≠ ⊥ ∧ M ^ ((Module.finrank ℚ K : ℝ) / 4) ≤ (Ideal.absNorm 𝔡 : ℝ)) →
        (∀ 𝔡, ‖L 𝔡‖ ≤ 1) →
        ∑ 𝔡 ∈ I₂, ‖T 𝔡‖ ^ 2 / (Ideal.absNorm 𝔡 : ℝ) ≤ Real.log M ^ 8 →
        δ * ((omegaBox ω M).card : ℝ)
          < ‖kaiTypeIIForm ω M (fun x => φ (ω.equivFun x)) I₁ I₂ L T‖ →
        ∃ (c lam : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) →
              Fin (Module.finrank ℚ K) → ℤ)
          (S : Finset ((Fin (Module.finrank ℚ K) → ℤ) × (Fin (Module.finrank ℚ K) → ℤ)))
          (z₀ : Fin (Module.finrank ℚ K) → ℤ) (Lc Tb : ℕ),
          (∀ k i l, |(c k i l : ℝ)| ≤ C₉) ∧ (∀ l k i, |(lam l k i : ℝ)| ≤ C₉) ∧
          (∀ l l', ∑ k, ∑ i, lam l k i * c k i l' = if l = l' then 1 else 0) ∧
          1 ≤ Lc ∧ 1 ≤ Tb ∧
          (∀ s ∈ S, ∀ k, |s.1 k| ≤ (Tb : ℤ) ∧ |s.2 k| ≤ (Tb : ℤ)) ∧
          (2 * (Tb : ℝ) + 1) ^ (2 * Module.finrank ℚ K)
            ≤ (C₉ * Q * Real.log M / δ) ^ A₉ * (S.card : ℝ) ∧
          (∀ s ∈ S, (Lc : ℝ) ^ Module.finrank ℚ K ≤ (C₉ * Q * Real.log M / δ) ^ A₉ *
             ‖∑ w ∈ Finset.Icc z₀ (z₀ + fun _ => (Lc : ℤ) - 1),
                 φ (kaiBil c s.1 w) * (starRingEnd ℂ) (φ (kaiBil c s.2 w))‖) ∧
          M ≤ (C₉ * Q * Real.log M / δ) ^ A₉ * Lc * Tb ∧
          M ^ ((1:ℝ) / 4) ≤ (C₉ * Q * Real.log M / δ) ^ A₉ * Lc ∧
          M ^ ((1:ℝ) / 4) ≤ 2 * Tb :=
by
  classical
  obtain ⟨C₁, h, c, lam, G, tt, hC₁, hc, hlam, hid, hP3, hP4, hP5, hP6, hP7, hP8⟩ :=
    kai_t2_ideal_param K C ω hω
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hn0 : Module.finrank ℚ K ≠ 0 := by omega
  have hnR : (1:ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn1
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hlogC : 0 < Real.log C := Real.log_pos hC1
  have hC₁pos : 0 < C₁ := by linarith
  
  have intabs : ∀ (z : ℤ) (y : ℝ), |(z : ℝ)| ≤ y → |z| ≤ (⌊y⌋₊ : ℤ) := by
    intro z y hzy
    have h0 : 0 ≤ y := le_trans (abs_nonneg _) hzy
    rw [Int.natCast_floor_eq_floor h0, Int.le_floor]
    push_cast
    exact hzy
  have mono4 : ∀ a b e f a' b' e' f' : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ e → 0 ≤ f → a ≤ a' → b ≤ b' →
      e ≤ e' → f ≤ f' → a * b * e * f ≤ a' * b' * e' * f' := by
    intro a b e f a' b' e' f' ha hb he hf h1 h2 h3 h4
    have ha' : 0 ≤ a' := ha.trans h1
    have hb' : 0 ≤ b' := hb.trans h2
    have he' : 0 ≤ e' := he.trans h3
    exact mul_le_mul (mul_le_mul (mul_le_mul h1 h2 hb ha') h3 he (mul_nonneg ha' hb')) h4 hf
      (mul_nonneg (mul_nonneg ha' hb') he')
  
  obtain ⟨Cp, hCp⟩ : ∃ Cp : ℝ, Cp = 2 * ((Module.finrank ℚ K : ℝ) * Real.log C
      + (Module.finrank ℚ K : ℝ) + 1) := ⟨_, rfl⟩
  have hCp2 : 2 ≤ Cp := by
    rw [hCp]; have := mul_nonneg (le_trans zero_le_one hnR) hlogC.le; linarith
  have hCppos : 0 < Cp := by linarith
  obtain ⟨h₁, hh₁⟩ : ∃ h₁ : ℝ, h₁ = (h : ℝ) + 1 := ⟨_, rfl⟩
  have hh₁1 : 1 ≤ h₁ := by rw [hh₁]; have : (0:ℝ) ≤ h := Nat.cast_nonneg _; linarith
  have hh₁pos : 0 < h₁ := by linarith
  have h6C : 1 ≤ 6 * C₁ := by linarith
  have h4C : 1 ≤ 4 * C₁ := by linarith
  obtain ⟨K₁, hK₁⟩ : ∃ K₁ : ℝ, K₁ = 2 * (6 * C₁) ^ Module.finrank ℚ K
      * (4 * C₁) ^ (2 * Module.finrank ℚ K)
      * (2 * (Module.finrank ℚ K : ℝ) * ((Module.finrank ℚ K : ℝ) + 1)) ^ 2 := ⟨_, rfl⟩
  have hK₁1 : 1 ≤ K₁ := by
    rw [hK₁]
    have a3 : 1 ≤ (2 * (Module.finrank ℚ K : ℝ) * ((Module.finrank ℚ K : ℝ) + 1)) ^ 2 := by
      have hh := mul_le_mul hnR (show (2:ℝ) ≤ (Module.finrank ℚ K : ℝ) + 1 by linarith)
        (by norm_num) (by linarith)
      exact one_le_pow₀ (by linarith)
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
      (one_le_mul_of_one_le_of_one_le (by norm_num) (one_le_pow₀ h6C)) (one_le_pow₀ h4C)) a3
  have hK₁pos : 0 < K₁ := by linarith
  obtain ⟨KG, hKG⟩ : ∃ KG : ℝ, KG = 4 * K₁ * h₁ * Cp := ⟨_, rfl⟩
  have hKG1 : 1 ≤ KG := by
    rw [hKG]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
      (one_le_mul_of_one_le_of_one_le (by norm_num) hK₁1) hh₁1) (by linarith)
  have hKGpos : 0 < KG := by linarith
  obtain ⟨Kη, hKη⟩ : ∃ Kη : ℝ, Kη = 128 * (6 * C₁) ^ (2 * Module.finrank ℚ K)
      * (4 * C₁) ^ (4 * Module.finrank ℚ K) * h₁ ^ 2 * Cp ^ 2 := ⟨_, rfl⟩
  have hKη1 : 1 ≤ Kη := by
    rw [hKη]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
      (one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le (by norm_num)
        (one_le_pow₀ h6C)) (one_le_pow₀ h4C)) (one_le_pow₀ hh₁1)) (one_le_pow₀ (by linarith))
  refine ⟨max (max 16 C₁) (max Kη (4 * C * KG)), 22,
    le_trans (le_max_left _ _) (le_max_left _ _), by norm_num, ?_⟩
  intro M Q δ φ hM hQ hδ hδ1 hφ hK I₁ I₂ L T hI₁ hI₂ hL hT hbig
  obtain ⟨C₉, hC₉⟩ : ∃ C₉ : ℝ, C₉ = max (max 16 C₁) (max Kη (4 * C * KG)) := ⟨_, rfl⟩
  rw [← hC₉] at hM hK ⊢
  have hC₉16 : 16 ≤ C₉ := by rw [hC₉]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hC₉C₁ : C₁ ≤ C₉ := by rw [hC₉]; exact le_trans (le_max_right _ _) (le_max_left _ _)
