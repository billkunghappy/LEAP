noncomputable def kaiFormSum {K : Type u} [Field K] [NumberField K] {d : ℕ}
    (f : Fin 4 → NumberField.RingOfIntegers K → ℝ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (Ω : Set (Fin d → ℝ)) (M : ℕ) : ℝ :=
  ∑ z ∈ intBox d M,
    if (fun k => ((z k : ℤ) : ℝ)) ∈ Ω then ∏ i : Fin 4, f i (affEval (c₀ i) (c i) z) else 0
def nil2Mul {a b : ℕ} (Bc : Fin a → Fin a → Fin b → ℤ)
    (u v : (Fin a → ℝ) × (Fin b → ℝ)) : (Fin a → ℝ) × (Fin b → ℝ) :=
  ((fun i => u.1 i + v.1 i),
   (fun k => u.2 k + v.2 k + ∑ i, ∑ j, (Bc i j k : ℝ) * u.1 i * v.1 j))


def IsNil2Seq (ν : ℕ) (D Q : ℝ) (φ : (Fin ν → ℤ) → ℝ) : Prop :=
  ∃ (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ)
    (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ)
    (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℝ),
    ((a + b : ℕ) : ℝ) ≤ D ∧
    (∀ i j k, |(Bc i j k : ℝ)| ≤ Q) ∧
    (∀ u, |F u| ≤ 1) ∧
    (∀ u (γ₁ : Fin a → ℤ) (γ₂ : Fin b → ℤ),
        F (nil2Mul Bc u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))) = F u) ∧
    (∀ u v : (Fin a → ℝ) × (Fin b → ℝ),
        (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ k, -1 ≤ u.2 k ∧ u.2 k ≤ 2) →
        (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, -1 ≤ v.2 k ∧ v.2 k ≤ 2) →
        |F u - F v| ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|)) ∧
    ∀ z : Fin ν → ℤ, φ z =
      F ((fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i),
         (fun k => r₀ k + ∑ l, (z l : ℝ) * r₁ l k
                    + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * r₂ l l' k))
def omegaRed {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (p : ℕ)
    (x : NumberField.RingOfIntegers K) : Fin ν → ZMod p :=
  fun j => ((ω.repr x j : ℤ) : ZMod p)

open scoped Classical in

noncomputable def zmodLift {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (p : ℕ) (M : ℝ)
    (F : NumberField.RingOfIntegers K → ℝ) (y : Fin ν → ZMod p) : ℝ :=
  ∑ x ∈ (omegaBox ω M).filter (fun x => omegaRed ω p x = y), F x


noncomputable def zmodU3Sum {ν p : ℕ} [NeZero p] (F : (Fin ν → ZMod p) → ℝ) : ℝ :=
  ∑ y : Fin ν → ZMod p, ∑ h₁ : Fin ν → ZMod p, ∑ h₂ : Fin ν → ZMod p, ∑ h₃ : Fin ν → ZMod p,
    ∏ ε : Fin 3 → Fin 2, F (cubeVertex y h₁ h₂ h₃ ε)

open scoped Classical in

noncomputable def zmodRegionInd (p d N : ℕ) (Ω : Set (Fin d → ℝ)) (x : Fin d → ZMod p) : ℝ :=
  if x ∈ ((intBox d N).filter (fun z => (fun k => ((z k : ℤ) : ℝ)) ∈ Ω)).image
      (fun z k => ((z k : ℤ) : ZMod p)) then 1 else 0


noncomputable def zmodBoxSmooth {d p : ℕ} (r : ℕ) (G : (Fin d → ZMod p) → ℝ)
    (x : Fin d → ZMod p) : ℝ :=
  (∑ b : Fin d → Fin r, G (x - fun k => (((b k : ℕ)) : ZMod p))) / (r : ℝ) ^ d
