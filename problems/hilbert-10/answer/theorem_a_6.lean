            have hm1' : m = 1 := hPm hP
            have hβeq : β₀ = β₀₀ := (hm1 hm1').2
            have hldR' : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 2 → |s.im| ≤ Real.exp (Real.sqrt X) →
                ‖deriv G s / G s - 1 / (s - (β₀₀ : ℂ))‖ ≤ M := by
              intro s h1 h2 h3
              have h := hldR s h1 h2 h3
              rw [he2.1, Nat.cast_one] at h
