    simpa using h
  
  have hκn : ‖(κ : ℂ)‖ = κ := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hκ0]
  obtain ⟨F', hF'⟩ : ∃ F' : (Fin a → ℝ) × (Fin b → ℝ) → ℂ, F' = fun u =>
      (κ : ℂ) * Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * u.2 k : ℝ) : ℂ)) *
        ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F (u.1, w) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ))) :=
    ⟨_, rfl⟩
  have hF'u : ∀ u, F' u =
      (κ : ℂ) * Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * u.2 k : ℝ) : ℂ)) *
        ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F (u.1, w) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ))) :=
    fun u => by rw [hF']
  have hF'J : ∀ u : (Fin a → ℝ) × (Fin b → ℝ), F' u =
      (κ : ℂ) * ∫ t in Set.Icc (0 : Fin b → ℝ) 1, (F (u.1, fun k => u.2 k + t k) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * t k : ℝ) : ℂ))) := by
    intro u
    rw [hF'u, ← hsf u.1 u.2]
