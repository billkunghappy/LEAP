      have hCD : D ≤ max (L + 1) (max D 1) := le_trans (le_max_left D 1) (le_max_right _ _)
      have hC1' : (1:ℝ) ≤ max (L + 1) (max D 1) := le_trans (le_max_right D 1) (le_max_right _ _)
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        have hempty : {I : Ideal (NumberField.RingOfIntegers K) |
            I ≠ 0 ∧ Ideal.absNorm I ≤ 0} = ∅ := by
          ext I
          simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_and]
          intro hI0 hIn
          exact absurd (le_trans (hone I hI0) hIn) (by omega)
        rw [hempty, Set.ncard_empty]
        simp
      · have hm1 : (1:ℝ) ≤ (m:ℝ) := by exact_mod_cast hm
        by_cases hbig : x₀ ≤ (m:ℝ)
        · have hmpos : (0:ℝ) < (m:ℝ) := by linarith
          have hlt := hx₀ (m:ℝ) hbig
          have hFm : (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} : ℝ) < (L + 1) * (m:ℝ) :=
            (div_lt_iff₀ hmpos).mp hlt
          have hsub : {I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m}
              ⊆ {I : Ideal (NumberField.RingOfIntegers K) |
                ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} := by
            rintro I ⟨-, hIn⟩
            exact_mod_cast hIn
          have hUfin : {I : Ideal (NumberField.RingOfIntegers K) |
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)}.Finite := by
            refine (hfin m).subset ?_
            intro I hI
            exact_mod_cast hI
          have hcoe : (({I : Ideal (NumberField.RingOfIntegers K) |
              ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)}).ncard)
              = Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
                ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} := rfl
          have hnc : (({I : Ideal (NumberField.RingOfIntegers K) |
                I ≠ 0 ∧ Ideal.absNorm I ≤ m}).ncard : ℝ)
              ≤ (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
                ((Ideal.absNorm I : ℕ) : ℝ) ≤ (m:ℝ)} : ℝ) := by
            have h := Set.ncard_le_ncard hsub hUfin
            rw [hcoe] at h
            exact_mod_cast h
          have hfinal : (L + 1) * (m:ℝ) ≤ max (L + 1) (max D 1) * (m:ℝ) :=
            mul_le_mul_of_nonneg_right hCL (by linarith)
          linarith
        · push_neg at hbig
          have hmle : m ≤ m₀ := by
            have h : (m:ℝ) ≤ (m₀:ℝ) := le_trans hbig.le hm₀
            exact_mod_cast h
          have hsub : {I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m}
              ⊆ {I : Ideal (NumberField.RingOfIntegers K) | I ≠ 0 ∧ Ideal.absNorm I ≤ m₀} := by
            rintro I ⟨h1, h2⟩
            exact ⟨h1, le_trans h2 hmle⟩
          have hnc : (({I : Ideal (NumberField.RingOfIntegers K) |
                I ≠ 0 ∧ Ideal.absNorm I ≤ m}).ncard : ℝ) ≤ D := by
            rw [hDdef]
            exact_mod_cast Set.ncard_le_ncard hsub (hfin' m₀)
          have hfinal : max (L + 1) (max D 1) * 1 ≤ max (L + 1) (max D 1) * (m:ℝ) :=
            mul_le_mul_of_nonneg_left hm1 (by linarith)
          rw [mul_one] at hfinal
          linarith
    have dyadic : ∀ (α : Type u) (g : α → ℕ) (Cc σ : ℝ), 1 < σ → 0 ≤ Cc →
        (∀ a : α, 1 ≤ g a) →
        (∀ n : ℕ, ∃ s : Finset α, (∀ a : α, g a ≤ n → a ∈ s) ∧ (s.card : ℝ) ≤ Cc * (n:ℝ)) →
        Summable (fun a : α => ((g a : ℝ)) ^ (-σ)) := by
      intro α g Cc σ hσ hCc0 hg1 hcnt
      have hρ0 : (0:ℝ) < (2:ℝ) ^ (-σ) := Real.rpow_pos_of_pos (by norm_num) _
      have hρhalf : (2:ℝ) ^ (-σ) < 1/2 := by
        have h2 : (2:ℝ) ^ (-σ) < (2:ℝ) ^ (-1 : ℝ) :=
          (Real.rpow_lt_rpow_left_iff (by norm_num : (1:ℝ) < 2)).mpr (by linarith)
        rw [Real.rpow_neg_one] at h2
        norm_num at h2
        linarith
      have hr0 : (0:ℝ) ≤ 2 * (2:ℝ) ^ (-σ) := by linarith
      have hr1 : 2 * (2:ℝ) ^ (-σ) < 1 := by linarith
      have hpow : ∀ k : ℕ, ((2:ℝ) ^ k) ^ (-σ) = ((2:ℝ) ^ (-σ)) ^ k := by
        intro k
        rw [← Real.rpow_natCast (2:ℝ) k, ← Real.rpow_natCast ((2:ℝ) ^ (-σ)) k,
          ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2), ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]
        ring_nf
      have hpt : ∀ a : α, ((g a : ℝ)) ^ (-σ) ≤ ((2:ℝ) ^ (-σ)) ^ (Nat.log 2 (g a)) := by
        intro a
        have hne : g a ≠ 0 := by have := hg1 a; omega
        have hle : (2:ℝ) ^ (Nat.log 2 (g a)) ≤ (g a : ℝ) := by
          exact_mod_cast Nat.pow_log_le_self 2 hne
        have hpos : (0:ℝ) < (2:ℝ) ^ (Nat.log 2 (g a)) := by positivity
        have h := Real.rpow_le_rpow_of_nonpos hpos hle (by linarith : -σ ≤ 0)
        rwa [hpow] at h
      refine summable_of_sum_le (c := 2 * Cc * (1 - 2 * (2:ℝ) ^ (-σ))⁻¹)
        (fun a => Real.rpow_nonneg (Nat.cast_nonneg _) _) ?_
      intro u
      have hsplit := Finset.sum_fiberwise_of_maps_to
        (s := u) (t := u.image (fun a => Nat.log 2 (g a)))
        (g := fun a : α => Nat.log 2 (g a))
        (fun a ha => Finset.mem_image_of_mem _ ha) (fun a : α => ((g a : ℝ)) ^ (-σ))
      rw [← hsplit]
      have hblock : ∀ k ∈ u.image (fun a : α => Nat.log 2 (g a)),
          (∑ a ∈ u.filter (fun a : α => Nat.log 2 (g a) = k), ((g a : ℝ)) ^ (-σ))
            ≤ 2 * Cc * (2 * (2:ℝ) ^ (-σ)) ^ k := by
        intro k _
        obtain ⟨s, hs1, hs2⟩ := hcnt (2 ^ (k + 1))
        have hsubF : u.filter (fun a : α => Nat.log 2 (g a) = k) ⊆ s := by
          intro a ha
          rw [Finset.mem_filter] at ha
          refine hs1 a ?_
          have hlt : g a < 2 ^ (Nat.log 2 (g a) + 1) := Nat.lt_pow_succ_log_self (by norm_num) _
          rw [ha.2] at hlt
          omega
        have hcard : ((u.filter (fun a : α => Nat.log 2 (g a) = k)).card : ℝ)
            ≤ Cc * (2:ℝ) ^ (k + 1) := by
          have h1 : ((u.filter (fun a : α => Nat.log 2 (g a) = k)).card : ℝ) ≤ (s.card : ℝ) := by
            exact_mod_cast Finset.card_le_card hsubF
          have h2 : (((2 ^ (k + 1) : ℕ)) : ℝ) = (2:ℝ) ^ (k + 1) := by push_cast; ring
          rw [h2] at hs2
          linarith
        have hsum1 : (∑ a ∈ u.filter (fun a : α => Nat.log 2 (g a) = k), ((g a : ℝ)) ^ (-σ))
            ≤ (u.filter (fun a : α => Nat.log 2 (g a) = k)).card • (((2:ℝ) ^ (-σ)) ^ k) := by
          refine Finset.sum_le_card_nsmul _ _ _ ?_
          intro a ha
          rw [Finset.mem_filter] at ha
          have h := hpt a
          rw [ha.2] at h
          exact h
        rw [nsmul_eq_mul] at hsum1
        refine hsum1.trans ?_
        have hρk : (0:ℝ) ≤ ((2:ℝ) ^ (-σ)) ^ k := pow_nonneg hρ0.le k
        calc ((u.filter (fun a : α => Nat.log 2 (g a) = k)).card : ℝ) * ((2:ℝ) ^ (-σ)) ^ k
            ≤ (Cc * (2:ℝ) ^ (k + 1)) * ((2:ℝ) ^ (-σ)) ^ k :=
              mul_le_mul_of_nonneg_right hcard hρk
          _ = 2 * Cc * (2 * (2:ℝ) ^ (-σ)) ^ k := by rw [mul_pow]; ring
      calc (∑ k ∈ u.image (fun a : α => Nat.log 2 (g a)),
              ∑ a ∈ u.filter (fun a : α => Nat.log 2 (g a) = k), ((g a : ℝ)) ^ (-σ))
          ≤ ∑ _k ∈ u.image (fun a : α => Nat.log 2 (g a)),
              2 * Cc * (2 * (2:ℝ) ^ (-σ)) ^ _k := Finset.sum_le_sum hblock
        _ = 2 * Cc * ∑ _k ∈ u.image (fun a : α => Nat.log 2 (g a)),
              (2 * (2:ℝ) ^ (-σ)) ^ _k := by rw [Finset.mul_sum]
        _ ≤ 2 * Cc * ∑' k : ℕ, (2 * (2:ℝ) ^ (-σ)) ^ k := by
              refine mul_le_mul_of_nonneg_left ?_ (by linarith)
              exact Summable.sum_le_tsum _ (fun k _ => pow_nonneg hr0 k)
                (summable_geometric_of_lt_one hr0 hr1)
        _ = 2 * Cc * (1 - 2 * (2:ℝ) ^ (-σ))⁻¹ := by rw [tsum_geometric_of_lt_one hr0 hr1]
    intro σ hσ
    refine dyadic {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}
      (fun a => Ideal.absNorm (a : Ideal (NumberField.RingOfIntegers K))) C σ hσ (by linarith)
      (fun a => hone _ a.2) ?_
    intro n
    refine ⟨Finset.subtype (fun I => I ≠ 0) ((hfin' n).toFinset), ?_, ?_⟩
    · intro a ha
      rw [Finset.mem_subtype, Set.Finite.mem_toFinset]
      exact ⟨a.2, ha⟩
    · have hle : (Finset.subtype (fun I => I ≠ 0) ((hfin' n).toFinset)).card
          ≤ ((hfin' n).toFinset).card := by
        refine Finset.card_le_card_of_injOn Subtype.val ?_ ?_
        · intro a ha
          simp only [Finset.mem_coe, Finset.mem_subtype] at ha ⊢
          exact ha
        · intro a _ b _ h
          exact Subtype.val_injective h
      have h2 : (((hfin' n).toFinset).card : ℝ)
          = (({I : Ideal (NumberField.RingOfIntegers K) |
            I ≠ 0 ∧ Ideal.absNorm I ≤ n}).ncard : ℝ) := by
        rw [Set.ncard_eq_toFinset_card _ (hfin' n)]
      have h3 := hCle n
      have h4 : ((Finset.subtype (fun I => I ≠ 0) ((hfin' n).toFinset)).card : ℝ)
          ≤ (((hfin' n).toFinset).card : ℝ) := by exact_mod_cast hle
      linarith
  have hN1 : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      (1 : ℝ) ≤ (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) := by
    intro I
    have hne : Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
      intro h
      rw [Ideal.absNorm_eq_zero_iff] at h
      exact I.2 (by rw [h]; rfl)
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
  have hS0 : 0 ≤ ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2)) :=
    tsum_nonneg (fun I => Real.rpow_nonneg (Nat.cast_nonneg _) _)
  unfold KaiHZZetaConvProp
  refine ⟨1 + ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2)),
    by linarith, hsum, ?_⟩
  intro σ hσ
  have hle : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))
      ≤ ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2)) :=
    Summable.tsum_le_tsum
      (fun I => Real.rpow_le_rpow_of_exponent_le (hN1 I) (by linarith))
      (hsum σ (by linarith)) (hsum ((3 : ℝ) / 2) (by norm_num))
  linarith

theorem kai_zf_prime_norm_colouring (K : Type u) [Field K] [NumberField K] :
    ∃ (col : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K))
      (rchar rdeg : Ideal (NumberField.RingOfIntegers K) → ℕ),
      (∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
          Nat.Prime (rchar P) ∧ 1 ≤ rdeg P ∧
            Ideal.absNorm P = rchar P ^ rdeg P) ∧
      (∀ P Q : Ideal (NumberField.RingOfIntegers K),
          P.IsPrime → P ≠ ⊥ → Q.IsPrime → Q ≠ ⊥ →
          rchar P = rchar Q → col P = col Q → P = Q) :=
by
  classical
  have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
  have sA : ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
      ∃ p f : ℕ, Nat.Prime p ∧ 1 ≤ f ∧ Ideal.absNorm P = p ^ f ∧
        (p : NumberField.RingOfIntegers K) ∈ P := by
    intro P hP hP0
    haveI := hP
    have hqdef : Ideal.under ℤ P
        = Ideal.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) P := Ideal.under_def ℤ P
    haveI hqp : (Ideal.under ℤ P).IsPrime := by
      rw [hqdef]; exact Ideal.comap_isPrime _ P
    have hNmem : ((Ideal.absNorm P : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
      rw [hqdef, Ideal.mem_comap]
      simpa using Ideal.absNorm_mem P
    have hN0 : (Ideal.absNorm P : ℕ) ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hP0
    have hqne : Ideal.under ℤ P ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hNmem
      exact hN0 (by exact_mod_cast hNmem)
    obtain ⟨g, hgq⟩ : ∃ g : ℤ, Ideal.span {g} = Ideal.under ℤ P :=
      ⟨Submodule.IsPrincipal.generator (Ideal.under ℤ P), Ideal.span_singleton_generator _⟩
    have hg0 : g ≠ 0 := by
      intro h
      exact hqne (hgq ▸ (Ideal.span_singleton_eq_bot.mpr h))
    have hspanne : Ideal.span {g} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact hg0
    haveI hspanp : (Ideal.span {g}).IsPrime := hgq ▸ hqp
    have hgp : Prime g := (Ideal.span_singleton_prime hg0).mp hspanp
    haveI hlo : P.LiesOver (Ideal.span {g}) := ⟨hgq⟩
    haveI hspanmax : (Ideal.span {g}).IsMaximal := hspanp.isMaximal hspanne
    refine ⟨g.natAbs, (Ideal.span {g}).inertiaDeg P, Int.prime_iff_natAbs_prime.mp hgp,
      Ideal.inertiaDeg_pos (Ideal.span {g}) P, Ideal.absNorm_eq_pow_inertiaDeg P hgp, ?_⟩
    have hmem : ((g.natAbs : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
      rw [← hgq]
      exact Ideal.mem_span_singleton.mpr (Int.dvd_natAbs.mpr dvd_rfl)
    rw [hqdef, Ideal.mem_comap] at hmem
    simpa using hmem
  have sB : ∀ p : ℕ, Nat.Prime p →
      ∃ t : Finset (Ideal (NumberField.RingOfIntegers K)),
        t.card ≤ Module.finrank ℚ K ∧
        ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
          (p : NumberField.RingOfIntegers K) ∈ P → P ∈ t := by
    intro p hp
    have hp0 : ((p : ℤ)) ≠ 0 := Int.natCast_ne_zero.mpr hp.ne_zero
    have hpp : Prime ((p : ℤ)) := Nat.prime_iff_prime_int.mp hp
    haveI hPp : (Ideal.span {(p : ℤ)}).IsPrime := (Ideal.span_singleton_prime hp0).mpr hpp
    have hne : Ideal.span {(p : ℤ)} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact hp0
    haveI hmax : (Ideal.span {(p : ℤ)}).IsMaximal := hPp.isMaximal hne
    refine ⟨primesOverFinset (Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers K), ?_, ?_⟩
    · have hsum := Ideal.sum_ramification_inertia (NumberField.RingOfIntegers K) ℚ K hne
      rw [Finset.card_eq_sum_ones, ← hsum]
      refine Finset.sum_le_sum ?_
      intro P hPmem
      have hco : P ∈ (Ideal.span {(p : ℤ)}).primesOver (NumberField.RingOfIntegers K) := by
        rw [← coe_primesOverFinset hne (NumberField.RingOfIntegers K)]
        exact Finset.mem_coe.mpr hPmem
      rw [Ideal.primesOver.eq_def, Set.mem_setOf_eq] at hco
      obtain ⟨hPprime, hPlo⟩ := hco
      haveI := hPprime
      haveI := hPlo
      have hf : 0 < (Ideal.span {(p : ℤ)}).inertiaDeg P := Ideal.inertiaDeg_pos _ P
      have hmapne : Ideal.map (algebraMap ℤ (NumberField.RingOfIntegers K))
          (Ideal.span {(p : ℤ)}) ≠ ⊥ := by
        rw [Ideal.map_span, Set.image_singleton, Ne, Ideal.span_singleton_eq_bot]
        have hc : ((p : ℕ) : NumberField.RingOfIntegers K) ≠ 0 :=
          Nat.cast_ne_zero.mpr hp.ne_zero
        simpa using hc
      have hmaple : Ideal.map (algebraMap ℤ (NumberField.RingOfIntegers K))
          (Ideal.span {(p : ℤ)}) ≤ P := by
        rw [Ideal.map_le_iff_le_comap, ← Ideal.under_def ℤ P]
        exact le_of_eq (Ideal.over_def P (Ideal.span {(p : ℤ)}))
      have he : Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers K))
          (Ideal.span {(p : ℤ)}) P ≠ 0 :=
        Ideal.IsDedekindDomain.ramificationIdx_ne_zero hmapne hPprime hmaple
      exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero he hf.ne')
    · intro P hP hP0 hmemP
      haveI := hP
      have h1 : ((p : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [Ideal.under_def, Ideal.mem_comap]
        simpa using hmemP
      have h2 : Ideal.span {(p : ℤ)} ≤ Ideal.under ℤ P := by
        rw [Ideal.span_le, Set.singleton_subset_iff]
        exact h1
      have h3 : Ideal.under ℤ P ≠ ⊤ := by
        intro h
        have h1' : (1 : ℤ) ∈ Ideal.under ℤ P := by rw [h]; exact Submodule.mem_top
        rw [Ideal.under_def, Ideal.mem_comap, map_one] at h1'
        exact hP.ne_top ((Ideal.eq_top_iff_one P).mpr h1')
      have h4 : Ideal.span {(p : ℤ)} = Ideal.under ℤ P := Ideal.IsMaximal.eq_of_le hmax h3 h2
      haveI hlo : P.LiesOver (Ideal.span {(p : ℤ)}) := ⟨h4⟩
      have h5 : P ∈ (Ideal.span {(p : ℤ)}).primesOver (NumberField.RingOfIntegers K) := by
        rw [Ideal.primesOver.eq_def, Set.mem_setOf_eq]
        exact ⟨hP, hlo⟩
      rw [← coe_primesOverFinset hne (NumberField.RingOfIntegers K)] at h5
      exact Finset.mem_coe.mp h5
  choose! rchar rdeg hrc using sA
  have hfib : ∀ m : ℕ, ∃ t : Finset (Ideal (NumberField.RingOfIntegers K)),
      t.card ≤ Module.finrank ℚ K ∧
      ∀ P : Ideal (NumberField.RingOfIntegers K),
        (P.IsPrime ∧ P ≠ ⊥) → rchar P = m → P ∈ t := by
    intro m
    by_cases hm : Nat.Prime m
    · obtain ⟨t, htc, hmem⟩ := sB m hm
      refine ⟨t, htc, ?_⟩
      intro P hS hrm
      refine hmem P hS.1 hS.2 ?_
      rw [← hrm]
      exact (hrc P hS.1 hS.2).2.2.2
    · refine ⟨∅, by simp, ?_⟩
      intro P hS hrm
      have hpr := (hrc P hS.1 hS.2).1
      rw [hrm] at hpr
      exact absurd hpr hm
  obtain ⟨col, hcol⟩ :
      ∃ c : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K),
        ∀ a b : Ideal (NumberField.RingOfIntegers K),
          (a.IsPrime ∧ a ≠ ⊥) → (b.IsPrime ∧ b ≠ ⊥) →
          rchar a = rchar b → c a = c b → a = b := by
    choose t htcard htmem using hfib
    have key : ∀ m : ℕ,
        ∃ e : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K),
          ∀ a b : Ideal (NumberField.RingOfIntegers K),
            a ∈ t m → b ∈ t m → e a = e b → a = b := by
      intro m
      refine ⟨fun a => if h : a ∈ t m then Fin.castLE (htcard m) ((t m).equivFin ⟨a, h⟩)
        else ⟨0, hn⟩, ?_⟩
      intro a b ha hb hab
      simp only [dif_pos ha, dif_pos hb] at hab
      exact congrArg Subtype.val
        ((t m).equivFin.injective (Fin.castLE_injective (htcard m) hab))
    choose e he using key
    refine ⟨fun a => e (rchar a) a, ?_⟩
    intro a b hSa hSb hr hc
    have hc' : e (rchar a) a = e (rchar b) b := hc
    rw [← hr] at hc'
    exact he (rchar a) a b (htmem (rchar a) a hSa rfl) (htmem (rchar a) b hSb hr.symm) hc'
  refine ⟨col, rchar, rdeg, ?_, ?_⟩
  · intro P hP hP0
    exact ⟨(hrc P hP hP0).1, (hrc P hP hP0).2.1, (hrc P hP hP0).2.2.1⟩
  · intro P Q hP hP0 hQ hQ0 hr hc
    exact hcol P Q ⟨hP, hP0⟩ ⟨hQ, hQ0⟩ hr hc

theorem kai_zf_ideal_norm_tuple_inj (K : Type u) [Field K] [NumberField K]
    (col : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K))
    (rchar rdeg : Ideal (NumberField.RingOfIntegers K) → ℕ)
    (hnorm : ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
        Nat.Prime (rchar P) ∧ 1 ≤ rdeg P ∧ Ideal.absNorm P = rchar P ^ rdeg P)
    (hcol : ∀ P Q : Ideal (NumberField.RingOfIntegers K),
        P.IsPrime → P ≠ ⊥ → Q.IsPrime → Q ≠ ⊥ →
        rchar P = rchar Q → col P = col Q → P = Q) :
    ∃ Φ : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} →
        (Fin (Module.finrank ℚ K) → ℕ),
      Function.Injective Φ ∧
      ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ∏ j, Φ I j = Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) :=
by
  have hfact : ∀ (s : Finset (Ideal (NumberField.RingOfIntegers K)))
      (q g a : Ideal (NumberField.RingOfIntegers K) → ℕ),
      (∀ i ∈ s, Nat.Prime (q i)) → ∀ p : ℕ,
      (∏ i ∈ s, (q i ^ g i) ^ a i).factorization p
        = ∑ i ∈ s, (if q i = p then a i * g i else 0) := by
    intro s q g a hq p
    classical
    have hne : ∀ i ∈ s, (q i ^ g i) ^ a i ≠ 0 := fun i hi =>
      pow_ne_zero _ (pow_ne_zero _ (hq i hi).ne_zero)
    rw [Nat.factorization_prod hne, Finset.sum_apply']
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [Nat.factorization_pow, Nat.factorization_pow, Finsupp.smul_apply,
      Finsupp.smul_apply, (hq i hi).factorization, Finsupp.single_apply]
    simp only [smul_eq_mul]
    split_ifs <;> ring
  have hcollapse : ∀ (s : Finset (Ideal (NumberField.RingOfIntegers K)))
      (q g a : Ideal (NumberField.RingOfIntegers K) → ℕ)
      (i₀ : Ideal (NumberField.RingOfIntegers K)),
      (∀ i ∈ s, q i = q i₀ → col i = col i₀ → i = i₀) →
      (i₀ ∉ s → a i₀ = 0) →
      (∑ i ∈ Finset.filter (fun i => col i = col i₀) s,
          (if q i = q i₀ then a i * g i else 0)) = a i₀ * g i₀ := by
    intro s q g a i₀ huniq hzero
    by_cases h : i₀ ∈ s
    · have hmem : i₀ ∈ Finset.filter (fun i => col i = col i₀) s :=
        Finset.mem_filter.mpr ⟨h, rfl⟩
      rw [Finset.sum_eq_single_of_mem i₀ hmem]
      · exact if_pos rfl
      · intro b hb hbne
        rw [Finset.mem_filter] at hb
        by_cases hqb : q b = q i₀
        · exact absurd (huniq b hb.1 hqb hb.2) hbne
        · exact if_neg hqb
    · rw [hzero h, zero_mul]
      refine Finset.sum_eq_zero (fun b hb => ?_)
      rw [Finset.mem_filter] at hb
      by_cases hqb : q b = q i₀
      · have hbe : b = i₀ := huniq b hb.1 hqb hb.2
        exact absurd (hbe ▸ hb.1) h
      · exact if_neg hqb
  obtain ⟨S, e, hSprime, hSzero, hSprod⟩ :
      ∃ (S : Ideal (NumberField.RingOfIntegers K) →
            Finset (Ideal (NumberField.RingOfIntegers K)))
        (e : Ideal (NumberField.RingOfIntegers K) →
            Ideal (NumberField.RingOfIntegers K) → ℕ),
        (∀ I P : Ideal (NumberField.RingOfIntegers K),
            P ∈ S I → P.IsPrime ∧ P ≠ ⊥ ∧ 1 ≤ e I P) ∧
        (∀ I P : Ideal (NumberField.RingOfIntegers K),
            P ∉ S I → e I P = 0) ∧
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
            ∏ P ∈ S I, P ^ e I P = I) := by
    classical
    obtain ⟨S, hS0, hSne⟩ :
        ∃ S : Ideal (NumberField.RingOfIntegers K) →
            Finset (Ideal (NumberField.RingOfIntegers K)),
          (∀ I : Ideal (NumberField.RingOfIntegers K), I = 0 → S I = ∅) ∧
          (∀ (I : Ideal (NumberField.RingOfIntegers K)) (hI : I ≠ 0),
              S I = Finset.image
                (fun v : IsDedekindDomain.HeightOneSpectrum
                    (NumberField.RingOfIntegers K) => v.asIdeal)
                (Ideal.finite_mulSupport hI).toFinset) := by
      refine ⟨fun I => if hI : I = 0 then ∅ else
        Finset.image
          (fun v : IsDedekindDomain.HeightOneSpectrum
              (NumberField.RingOfIntegers K) => v.asIdeal)
          (Ideal.finite_mulSupport hI).toFinset, ?_, ?_⟩
      · intro I hI
        exact dif_pos hI
      · intro I hI
        exact dif_neg hI
    refine ⟨S, fun I P => if P ∈ S I then
        (Associates.mk P).count (Associates.mk I).factors else 0, ?_, ?_, ?_⟩
    · intro I P hP
      have hPS : P ∈ S I := hP
      have hI : I ≠ 0 := by
        intro h
        rw [hS0 I h] at hP
        simp at hP
      rw [hSne I hI] at hP
      obtain ⟨v, hv, hvP⟩ := Finset.mem_image.mp hP
      rw [Set.Finite.mem_toFinset] at hv
      refine ⟨hvP ▸ v.isPrime, hvP ▸ v.ne_bot, ?_⟩
      have hcount : (Associates.mk P).count (Associates.mk I).factors ≠ 0 := by
        intro h0
        apply hv
        show IsDedekindDomain.HeightOneSpectrum.maxPowDividing v I = 1
        simp only [IsDedekindDomain.HeightOneSpectrum.maxPowDividing, hvP, h0,
          pow_zero]
      show 1 ≤ (if P ∈ S I then
        (Associates.mk P).count (Associates.mk I).factors else 0)
      rw [if_pos hPS]
      omega
    · intro I P hP
      exact if_neg hP
    · intro I hI
      have hSI := hSne I hI
      calc (∏ P ∈ S I, P ^ (if P ∈ S I then
                (Associates.mk P).count (Associates.mk I).factors else 0))
          = ∏ P ∈ S I, P ^ ((Associates.mk P).count (Associates.mk I).factors) := by
            refine Finset.prod_congr rfl (fun P hP => ?_)
            rw [if_pos hP]
        _ = ∏ v ∈ (Ideal.finite_mulSupport hI).toFinset,
              v.asIdeal ^ ((Associates.mk v.asIdeal).count (Associates.mk I).factors) := by
            rw [hSI]
            exact Finset.prod_image
              (fun x _ y _ h => IsDedekindDomain.HeightOneSpectrum.ext h)
        _ = ∏ v ∈ (Ideal.finite_mulSupport hI).toFinset,
              IsDedekindDomain.HeightOneSpectrum.maxPowDividing v I := by
            refine Finset.prod_congr rfl (fun v _ => ?_)
            simp only [IsDedekindDomain.HeightOneSpectrum.maxPowDividing]
        _ = ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum
              (NumberField.RingOfIntegers K),
              IsDedekindDomain.HeightOneSpectrum.maxPowDividing v I := by
            refine (finprod_eq_prod_of_mulSupport_subset _ ?_).symm
            intro x hx
            rw [Set.Finite.coe_toFinset]
            exact hx
        _ = I := Ideal.finprod_heightOneSpectrum_factorization hI
  have hdag : ∀ (I P₀ : Ideal (NumberField.RingOfIntegers K)),
      P₀.IsPrime → P₀ ≠ ⊥ →
      (∏ P ∈ Finset.filter (fun P => col P = col P₀) (S I),
          Ideal.absNorm P ^ e I P).factorization (rchar P₀)
        = e I P₀ * rdeg P₀ := by
    intro I P₀ hP₀p hP₀b
    have hstep1 : (∏ P ∈ Finset.filter (fun P => col P = col P₀) (S I),
          Ideal.absNorm P ^ e I P)
        = ∏ P ∈ Finset.filter (fun P => col P = col P₀) (S I),
            (rchar P ^ rdeg P) ^ e I P := by
      refine Finset.prod_congr rfl (fun P hP => ?_)
      obtain ⟨hp1, hp2, _⟩ := hSprime I P (Finset.mem_filter.mp hP).1
      rw [(hnorm P hp1 hp2).2.2]
    have hq : ∀ P ∈ Finset.filter (fun P => col P = col P₀) (S I),
        Nat.Prime (rchar P) := by
      intro P hP
      obtain ⟨hp1, hp2, _⟩ := hSprime I P (Finset.mem_filter.mp hP).1
      exact (hnorm P hp1 hp2).1
    have h5 := hfact (Finset.filter (fun P => col P = col P₀) (S I))
      rchar rdeg (e I) hq (rchar P₀)
    have huniq : ∀ P ∈ S I, rchar P = rchar P₀ → col P = col P₀ → P = P₀ := by
      intro P hPS hrc hcl
      obtain ⟨hp1, hp2, _⟩ := hSprime I P hPS
      exact hcol P P₀ hp1 hp2 hP₀p hP₀b hrc hcl
    have h6 := hcollapse (S I) rchar rdeg (e I) P₀ huniq (hSzero I P₀)
    rw [hstep1, h5, h6]
  refine ⟨fun I j => ∏ P ∈ Finset.filter (fun P => col P = j)
      (S (I : Ideal (NumberField.RingOfIntegers K))),
      Ideal.absNorm P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P, ?_, ?_⟩
  · intro I J hIJ
    have hE : e (I : Ideal (NumberField.RingOfIntegers K))
        = e (J : Ideal (NumberField.RingOfIntegers K)) := by
      funext P₀
      by_cases hp : P₀.IsPrime ∧ P₀ ≠ ⊥
      · have h1 := hdag (I : Ideal (NumberField.RingOfIntegers K)) P₀ hp.1 hp.2
        have h2 := hdag (J : Ideal (NumberField.RingOfIntegers K)) P₀ hp.1 hp.2
        have h3 : (∏ P ∈ Finset.filter (fun P => col P = col P₀)
              (S (I : Ideal (NumberField.RingOfIntegers K))),
              Ideal.absNorm P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P)
            = ∏ P ∈ Finset.filter (fun P => col P = col P₀)
              (S (J : Ideal (NumberField.RingOfIntegers K))),
              Ideal.absNorm P ^ e (J : Ideal (NumberField.RingOfIntegers K)) P :=
          congrFun hIJ (col P₀)
        have h4 : e (I : Ideal (NumberField.RingOfIntegers K)) P₀ * rdeg P₀
            = e (J : Ideal (NumberField.RingOfIntegers K)) P₀ * rdeg P₀ := by
          rw [← h1, ← h2, h3]
        have hrd1 : 1 ≤ rdeg P₀ := (hnorm P₀ hp.1 hp.2).2.1
        have hrd : 0 < rdeg P₀ := by omega
        exact Nat.eq_of_mul_eq_mul_right hrd h4
      · have hI0 : P₀ ∉ S (I : Ideal (NumberField.RingOfIntegers K)) := by
          intro hmem
          exact hp ⟨(hSprime _ _ hmem).1, (hSprime _ _ hmem).2.1⟩
        have hJ0 : P₀ ∉ S (J : Ideal (NumberField.RingOfIntegers K)) := by
          intro hmem
          exact hp ⟨(hSprime _ _ hmem).1, (hSprime _ _ hmem).2.1⟩
        rw [hSzero _ _ hI0, hSzero _ _ hJ0]
    have hS : S (I : Ideal (NumberField.RingOfIntegers K))
        = S (J : Ideal (NumberField.RingOfIntegers K)) := by
      ext P
      constructor
      · intro hmem
        by_contra hnot
        have hle : 1 ≤ e (I : Ideal (NumberField.RingOfIntegers K)) P :=
          (hSprime _ _ hmem).2.2
        have hz : e (J : Ideal (NumberField.RingOfIntegers K)) P = 0 :=
          hSzero _ _ hnot
        rw [congrFun hE P] at hle
        omega
      · intro hmem
        by_contra hnot
        have hle : 1 ≤ e (J : Ideal (NumberField.RingOfIntegers K)) P :=
          (hSprime _ _ hmem).2.2
        have hz : e (I : Ideal (NumberField.RingOfIntegers K)) P = 0 :=
          hSzero _ _ hnot
        rw [← congrFun hE P] at hle
        omega
    refine Subtype.ext ?_
    calc (I : Ideal (NumberField.RingOfIntegers K))
        = ∏ P ∈ S (I : Ideal (NumberField.RingOfIntegers K)),
            P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P :=
          (hSprod _ I.2).symm
      _ = ∏ P ∈ S (J : Ideal (NumberField.RingOfIntegers K)),
            P ^ e (J : Ideal (NumberField.RingOfIntegers K)) P :=
          Finset.prod_congr hS (fun P _ => by rw [congrFun hE P])
      _ = (J : Ideal (NumberField.RingOfIntegers K)) := hSprod _ J.2
  · intro I
    calc (∏ j, ∏ P ∈ Finset.filter (fun P => col P = j)
            (S (I : Ideal (NumberField.RingOfIntegers K))),
            Ideal.absNorm P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P)
        = ∏ P ∈ S (I : Ideal (NumberField.RingOfIntegers K)),
            Ideal.absNorm P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P :=
          Finset.prod_fiberwise _ _ _
      _ = ∏ P ∈ S (I : Ideal (NumberField.RingOfIntegers K)),
            Ideal.absNorm (P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P) :=
          Finset.prod_congr rfl (fun P _ => (map_pow Ideal.absNorm P _).symm)
      _ = Ideal.absNorm (∏ P ∈ S (I : Ideal (NumberField.RingOfIntegers K)),
            P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P) :=
          (map_prod Ideal.absNorm
            (fun P => P ^ e (I : Ideal (NumberField.RingOfIntegers K)) P)
            (S (I : Ideal (NumberField.RingOfIntegers K)))).symm
      _ = Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) :=
          congrArg Ideal.absNorm (hSprod _ I.2)

theorem kai_zf_dedekind_zeta_le_pow (K : Type u) [Field K] [NumberField K]
    (Φ : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} →
        (Fin (Module.finrank ℚ K) → ℕ))
    (hinj : Function.Injective Φ)
    (hΦ : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ∏ j, Φ I j = Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)))
    (σ : ℝ) (hσ : 1 < σ)
    (hsum : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))) :
    (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))
      ≤ (1 + 1 / (σ - 1)) ^ (Module.finrank ℚ K) :=
by
  classical
  have hσ0 : (0:ℝ) < σ := by linarith
  have hd : (0:ℝ) < σ - 1 := by linarith
  have hnn : ∀ m : ℕ, (0:ℝ) ≤ (m : ℝ) ^ (-σ) :=
    fun m => Real.rpow_nonneg (Nat.cast_nonneg m) _
  have hzeta : Summable (fun m : ℕ => (m : ℝ) ^ (-σ)) ∧
      (∑' m : ℕ, (m : ℝ) ^ (-σ)) ≤ 1 + 1 / (σ - 1) := by
    have hsum1 : Summable (fun m : ℕ => (m : ℝ) ^ (-σ)) :=
      Real.summable_nat_rpow.mpr (by linarith)
    refine ⟨hsum1, ?_⟩
    have hz : ((0:ℕ) : ℝ) ^ (-σ) = 0 := by
      rw [Nat.cast_zero]
      exact Real.zero_rpow (neg_ne_zero.mpr (ne_of_gt hσ0))
    have ho : ((1:ℕ) : ℝ) ^ (-σ) = 1 := by
      rw [Nat.cast_one]; exact Real.one_rpow _
    have hsplit : ∀ f : ℕ → ℝ, ∀ N : ℕ,
        ∑ m ∈ Finset.range (N + 2), f m
          = (∑ k ∈ Finset.range N, f (k + 2)) + f 1 + f 0 := by
      intro f N
      rw [Finset.sum_range_succ' f (N + 1), Finset.sum_range_succ' (fun k => f (k + 1)) N]
    have main : ∀ N : ℕ,
        (∑ m ∈ Finset.range (N + 2), ((m : ℝ) ^ (-σ))) ≤ 1 + 1 / (σ - 1) := by
      intro N
      have hanti : AntitoneOn (fun x : ℝ => x ^ (-σ)) (Set.Icc (1:ℝ) (1 + (N:ℝ))) := by
        intro x hx y _ hxy
        exact Real.rpow_le_rpow_of_nonpos (by linarith [hx.1]) hxy (by linarith)
      have hsi := hanti.sum_le_integral
      have hI : (∫ x in (1:ℝ)..(1 + (N:ℝ)), x ^ (-σ))
          = ((1 + (N:ℝ)) ^ (-σ + 1) - (1:ℝ) ^ (-σ + 1)) / (-σ + 1) := by
        apply integral_rpow
        refine Or.inr ⟨by intro h; apply absurd h; intro h'; linarith [neg_inj.mp h'], ?_⟩
        intro hmem
        rw [Set.mem_uIcc] at hmem
        have hN0 : (0:ℝ) ≤ (N:ℝ) := Nat.cast_nonneg N
        rcases hmem with ⟨h1, _⟩ | ⟨h1, _⟩
        · linarith
        · linarith
      have hA : (0:ℝ) ≤ (1 + (N:ℝ)) ^ (-σ + 1) :=
        Real.rpow_nonneg (by positivity) _
      have hne1 : (-σ + 1) ≠ 0 := by intro h; linarith
      have hne2 : σ - 1 ≠ 0 := ne_of_gt hd
      have heq : ((1 + (N:ℝ)) ^ (-σ + 1) - (1:ℝ) ^ (-σ + 1)) / (-σ + 1)
          = 1 / (σ - 1) - (1 + (N:ℝ)) ^ (-σ + 1) / (σ - 1) := by
        rw [Real.one_rpow]
        field_simp
        ring
      have hIle : (∫ x in (1:ℝ)..(1 + (N:ℝ)), x ^ (-σ)) ≤ 1 / (σ - 1) := by
        rw [hI, heq]
        have hq : 0 ≤ (1 + (N:ℝ)) ^ (-σ + 1) / (σ - 1) := div_nonneg hA hd.le
        linarith only [hq]
      have hconv : (∑ i ∈ Finset.range N, ((1:ℝ) + ((i + 1 : ℕ) : ℝ)) ^ (-σ))
          = ∑ k ∈ Finset.range N, (((k + 2 : ℕ) : ℝ)) ^ (-σ) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        congr 1
        push_cast
        ring
      have hsum2 : (∑ k ∈ Finset.range N, (((k + 2 : ℕ) : ℝ)) ^ (-σ)) ≤ 1 / (σ - 1) := by
        rw [← hconv]
        exact le_trans hsi hIle
      rw [hsplit (fun m : ℕ => ((m : ℝ) ^ (-σ))) N]
      simp only [hz, ho]
      linarith only [hsum2]
    refine hsum1.tsum_le_of_sum_le ?_
    intro s
    obtain ⟨N, hN⟩ := Finset.exists_nat_subset_range s
    have hrs : Finset.range N ⊆ Finset.range (N + 2) := by
      intro x hx
      simp only [Finset.mem_range] at hx ⊢
      omega
    have hsub : s ⊆ Finset.range (N + 2) := hN.trans hrs
    refine le_trans ?_ (main N)
    exact Finset.sum_le_sum_of_subset_of_nonneg hsub (fun i _ _ => hnn i)
  obtain ⟨hasum, hale⟩ := hzeta
  have hgen : ∀ (n : ℕ) (a : ℕ → ℝ), (∀ m : ℕ, 0 ≤ a m) → Summable a →
      Summable (fun v : Fin n → ℕ => ∏ j : Fin n, a (v j)) ∧
        (∑' v : Fin n → ℕ, ∏ j : Fin n, a (v j)) = (∑' m : ℕ, a m) ^ n := by
    intro n a ha hsa
    have hnA : Summable (fun m : ℕ => ‖a m‖) :=
      hsa.congr (fun m => (Real.norm_of_nonneg (ha m)).symm)
    induction n with
    | zero =>
        refine ⟨Summable.of_finite, ?_⟩
        have h1 : ∀ v : Fin 0 → ℕ, (∏ j : Fin 0, a (v j)) = 1 := by intro v; simp
        rw [tsum_congr h1, pow_zero]
        exact tsum_eq_single (fun _ => 0) (fun b hb => absurd (Subsingleton.elim b _) hb)
    | succ n ih =>
        obtain ⟨ihs, ihv⟩ := ih
        have hFnn : ∀ w : Fin n → ℕ, 0 ≤ ∏ j : Fin n, a (w j) :=
          fun w => Finset.prod_nonneg (fun j _ => ha _)
        have key : ∀ z : ℕ × (Fin n → ℕ),
            (fun v : Fin (n + 1) → ℕ => ∏ j : Fin (n + 1), a (v j))
                ((Fin.consEquiv (fun _ : Fin (n + 1) => ℕ)) z)
              = a z.1 * ∏ j : Fin n, a (z.2 j) := by
          intro z
          simp [Fin.consEquiv_apply, Fin.prod_univ_succ]
        have ha' : (0 : ℕ → ℝ) ≤ a := fun m => ha m
        have hF' : (0 : (Fin n → ℕ) → ℝ) ≤ (fun w : Fin n → ℕ => ∏ j : Fin n, a (w j)) :=
          fun w => hFnn w
        have hs2 := Summable.mul_of_nonneg (f := a)
          (g := fun w : Fin n → ℕ => ∏ j : Fin n, a (w j)) hsa ihs ha' hF'
        have hs3 : Summable ((fun v : Fin (n + 1) → ℕ => ∏ j : Fin (n + 1), a (v j))
              ∘ (Fin.consEquiv (fun _ : Fin (n + 1) => ℕ))) :=
          hs2.congr (fun z => (key z).symm)
        have hs4 : Summable (fun v : Fin (n + 1) → ℕ => ∏ j : Fin (n + 1), a (v j)) :=
          (Equiv.summable_iff _).mp hs3
        refine ⟨hs4, ?_⟩
        have hnF : Summable (fun w : Fin n → ℕ => ‖∏ j : Fin n, a (w j)‖) :=
          ihs.congr (fun w => (Real.norm_of_nonneg (hFnn w)).symm)
        have hmul := tsum_mul_tsum_of_summable_norm hnA hnF
        have he : (∑' v : Fin (n + 1) → ℕ, ∏ j : Fin (n + 1), a (v j))
            = ∑' z : ℕ × (Fin n → ℕ), a z.1 * ∏ j : Fin n, a (z.2 j) := by
          rw [← Equiv.tsum_eq (Fin.consEquiv (fun _ : Fin (n + 1) => ℕ))
                (fun v : Fin (n + 1) → ℕ => ∏ j : Fin (n + 1), a (v j))]
          exact tsum_congr key
        rw [he, ← hmul, ihv]
        ring
  obtain ⟨hgsum, hgval⟩ :=
    hgen (Module.finrank ℚ K) (fun m : ℕ => (m : ℝ) ^ (-σ)) hnn hasum
  have hs6 : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)
        = ∏ j : Fin (Module.finrank ℚ K), ((Φ I j : ℕ) : ℝ) ^ (-σ) := by
    intro I
    rw [Real.finset_prod_rpow Finset.univ (fun j => ((Φ I j : ℕ) : ℝ))
      (fun j _ => Nat.cast_nonneg _) (-σ), ← Nat.cast_prod, hΦ I]
  have hcmp := Summable.tsum_le_tsum_of_inj Φ hinj
    (fun c _ => Finset.prod_nonneg (fun j _ => hnn (c j)))
    (fun I => le_of_eq (hs6 I)) hsum hgsum
  refine le_trans hcmp ?_
  rw [hgval]
  exact pow_le_pow_left₀ (tsum_nonneg hnn) hale _

theorem kai_zf_prime_log_series_bound : ∀ σ : ℝ, 1 < σ → σ ≤ 2 →
      Summable (fun m : ℕ =>
        if Nat.Prime m then Real.log (m : ℝ) * (m : ℝ) ^ (-σ) else 0) ∧
