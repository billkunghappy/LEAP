      Finset.sum_congr rfl fun w _ => rfl
    simp only [kaiHZMixedInner]
    rw [hsnd, hfst]
  refine ⟨hsum1, b, kaiHZDualTwist K ρ, (D : ℂ)⁻¹ * κ₀ * TC, rr, ?_, ?_, ?_, ?_, ?_,
    hsum2, ?_⟩
  · intro w
    rcases w.isReal_or_isComplex with hw | hw
    · rw [hrrR w hw]; norm_num
    · rw [hrrC w (by rw [NumberField.InfinitePlace.not_isReal_iff_isComplex]; exact hw)]
      norm_num
  · intro w
    have hone : 1 / B ≤ (1 : ℝ) := by rw [div_le_one hB0]; linarith
    rcases w.isReal_or_isComplex with hw | hw
    · rw [hrrR w hw]; exact ⟨hone, hB1⟩
    · rw [hrrC w (by rw [NumberField.InfinitePlace.not_isReal_iff_isComplex]; exact hw)]
      exact ⟨by linarith, hB4⟩
  · rw [hbn]
    calc cK / (Ideal.absNorm a : ℝ) ≤ cK := div_le_self hcK.le hN1
      _ ≤ B := hBcK
      _ ≤ B * (Ideal.absNorm a : ℝ) ^ B := le_mul_of_one_le_right (by linarith) hNB1
  · rw [hbn, div_le_div_iff₀ (by positivity) hN0]
    have h1 : (1 : ℝ) ≤ cK * B := by
      have h2 : 1 / cK ≤ B := hBcK'
      rw [div_le_iff₀ hcK] at h2
      linarith
    calc (1 : ℝ) * (Ideal.absNorm a : ℝ) = (Ideal.absNorm a : ℝ) := one_mul _
      _ ≤ (Ideal.absNorm a : ℝ) ^ B := hNBN
      _ = 1 * (Ideal.absNorm a : ℝ) ^ B := (one_mul _).symm
      _ ≤ (cK * B) * (Ideal.absNorm a : ℝ) ^ B :=
          mul_le_mul_of_nonneg_right h1 (by linarith)
      _ = cK * (B * (Ideal.absNorm a : ℝ) ^ B) := by ring
  · have hTCnorm : ‖TC‖ = TR := by
      rw [hTCdef, hTRdef, norm_prod]
      refine Finset.prod_congr rfl fun p _ => ?_
      rw [norm_pow]
      norm_num
    have hnormκ : ‖(D : ℂ)⁻¹ * κ₀ * TC‖ = D⁻¹ * TR := by
      rw [norm_mul, norm_mul, hκ₀norm, hTCnorm, norm_inv, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hD0]
      ring
    have hreal : ∏ w ∈ Finset.univ.filter
          (fun w : NumberField.InfinitePlace K => w.IsReal),
          rr w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)) = 1 := by
      refine Finset.prod_eq_one fun w hw => ?_
      rw [hrrR w (Finset.mem_filter.mp hw).2, Real.one_rpow]
    have hsub : ∏ w ∈ Finset.univ.filter
          (fun w : NumberField.InfinitePlace K => ¬ w.IsReal),
          rr w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))
        = ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            rr (p : NumberField.InfinitePlace K) ^
              (-(((p : NumberField.InfinitePlace K).mult : ℝ) / 2 +
                  kaiHZDeg K η l (p : NumberField.InfinitePlace K))) := by
      refine Finset.prod_subtype _ (fun w => ?_) _
      simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]
    have hsplit : (∏ w : NumberField.InfinitePlace K,
          rr w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)))
        = ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            rr (p : NumberField.InfinitePlace K) ^
              (-(((p : NumberField.InfinitePlace K).mult : ℝ) / 2 +
                  kaiHZDeg K η l (p : NumberField.InfinitePlace K))) := by
      rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
          (fun w : NumberField.InfinitePlace K => w.IsReal)
          (fun w => rr w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))), hreal, one_mul, hsub]
    have hkill : (∏ w : NumberField.InfinitePlace K,
          rr w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) * TR ≤ 1 := by
      have hnrp : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          ¬ (p : NumberField.InfinitePlace K).IsReal := by
        intro p
        rw [NumberField.InfinitePlace.not_isReal_iff_isComplex]; exact p.2
      rw [hsplit, hTRdef, ← Finset.prod_mul_distrib]
      refine Finset.prod_le_one ?_ ?_
      · intro p _
        rw [hrrC _ (hnrp p)]
        positivity
      · intro p _
        have hnr : ¬ (p : NumberField.InfinitePlace K).IsReal := hnrp p
        have hrp : rr (p : NumberField.InfinitePlace K) = 4 := hrrC _ hnr
        have hdeg : kaiHZDeg K η l (p : NumberField.InfinitePlace K)
            = ((l p).natAbs : ℝ) := by
          simp only [kaiHZDeg, dif_neg hnr, Subtype.coe_eta]
          rw [Int.cast_natAbs, Int.cast_abs]
        have ht0 : (0 : ℝ) ≤ ((l p).natAbs : ℝ) := Nat.cast_nonneg _
        have hm0 : (0 : ℝ) ≤ ((p : NumberField.InfinitePlace K).mult : ℝ) :=
          Nat.cast_nonneg _
        have hpow : (2 : ℝ) ^ ((l p).natAbs)
            = (2 : ℝ) ^ (((l p).natAbs : ℕ) : ℝ) := (Real.rpow_natCast _ _).symm
        have h2pos : (0 : ℝ) < (2 : ℝ) ^ (((l p).natAbs : ℕ) : ℝ) :=
          Real.rpow_pos_of_pos (by norm_num) _
        have hstep1 : (4 : ℝ) ^ (-(((p : NumberField.InfinitePlace K).mult : ℝ) / 2
              + ((l p).natAbs : ℝ)))
            ≤ (4 : ℝ) ^ (-((l p).natAbs : ℝ)) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        have hstep2 : (4 : ℝ) ^ (-((l p).natAbs : ℝ))
            ≤ ((2 : ℝ) ^ (((l p).natAbs : ℕ) : ℝ))⁻¹ := by
          rw [Real.rpow_neg (by norm_num), ← one_div, ← one_div]
          exact one_div_le_one_div_of_le h2pos
            (Real.rpow_le_rpow (by norm_num) (by norm_num) ht0)
        rw [hrp, hdeg, hpow]
        calc (4 : ℝ) ^ (-(((p : NumberField.InfinitePlace K).mult : ℝ) / 2
              + ((l p).natAbs : ℝ))) * (2 : ℝ) ^ (((l p).natAbs : ℕ) : ℝ)
            ≤ ((2 : ℝ) ^ (((l p).natAbs : ℕ) : ℝ))⁻¹
                * (2 : ℝ) ^ (((l p).natAbs : ℕ) : ℝ) :=
              mul_le_mul_of_nonneg_right (le_trans hstep1 hstep2) h2pos.le
          _ = 1 := inv_mul_cancel₀ (ne_of_gt h2pos)
    have hinvD : D⁻¹ ≤ 1 / c₀ := by
      rw [← one_div]
      exact one_div_le_one_div_of_le hc₀ hDc₀
    calc ‖(D : ℂ)⁻¹ * κ₀ * TC‖ * (∏ w : NumberField.InfinitePlace K,
            rr w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)))
        = D⁻¹ * ((∏ w : NumberField.InfinitePlace K,
            rr w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) * TR) := by
          rw [hnormκ]; ring
      _ ≤ D⁻¹ * 1 := by
          refine mul_le_mul_of_nonneg_left hkill ?_
          positivity
      _ = D⁻¹ := mul_one _
      _ ≤ 1 / c₀ := hinvD
      _ ≤ B := hBc₀
      _ ≤ B * (Ideal.absNorm a : ℝ) ^ B := le_mul_of_one_le_right (by linarith) hNB1
  · intro y hy
    obtain ⟨F, hFΦ⟩ :=
      kai_hz_mixed_test_schwartz K (Module.finrank ℚ K) Φ hinner η l y hy
    have hFfun : (fun z : EuclideanSpace ℝ (Fin (Module.finrank ℚ K)) => F z)
