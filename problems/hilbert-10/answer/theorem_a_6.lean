    have hL : ∀ x : X, (0 : ℝ) ≤ Real.log ((nn x : ℝ)) := fun x => Real.log_nonneg (hN x)
    have hexpR : ∀ t d : ℝ, 0 < t →
        HasSum (fun m : ℕ => (d * Real.log t) ^ m / (Nat.factorial m : ℝ)) (t ^ d) := by
      intro t d ht
