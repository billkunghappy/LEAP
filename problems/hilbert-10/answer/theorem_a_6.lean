  have hlogCM0 : 0 ≤ Real.log (C * M) := Real.log_nonneg hCM
  have hlogN : Real.log (Nmax : ℝ) ≤ 2 * (Module.finrank ℚ K : ℝ) * ℓ := by
    calc Real.log (Nmax : ℝ) ≤ Real.log ((C * M) ^ Module.finrank ℚ K) :=
