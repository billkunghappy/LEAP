      exact mul_nonneg (mul_nonneg (ha x) (pow_nonneg (hL x) m))
        (Real.rpow_nonneg (hNpos x).le _)
    obtain ⟨A, hA⟩ : ∃ A : ℕ → ℝ, ∀ m : ℕ,
        A m = ∑' x : X, a x * Real.log ((nn x : ℝ)) ^ m * ((nn x : ℝ)) ^ (-(2 : ℝ)) :=
      ⟨_, fun _ => rfl⟩
    have hAval : ∀ m : ℕ, HasSum (fun x : X =>
