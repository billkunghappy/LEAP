theorem kai_hz_hecke_mellin_fe (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hP : KaiHZPoissonProp) (hF : KaiHZTestFourierProp) (hΓ : KaiHZGammaBoundProp)
    (hTheta : KaiHZIdealThetaProp K) (hClass : KaiHZClassCoprimeProp K)
    (hConv : KaiHZZetaConvProp K) : KaiHZHeckeFEProp K :=
by
  classical
  
  have hPL : ∀ (f : ℂ → ℂ) (A : ℕ) (C Ca : ℝ), 0 ≤ C → 0 < Ca →
      (∀ s : ℂ, -1 < s.re → s.re < 5 → DifferentiableAt ℂ f s) →
      (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
        ‖f s‖ ≤ Ca * Real.exp (Ca * (1 + |s.im|))) →
      (∀ s : ℂ, s.re = -(1 : ℝ) / 2 ∨ s.re = 4 →
        ‖f s‖ ≤ C * (2 + |s.im|) ^ A) →
      ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
        ‖f s‖ ≤ (9 : ℝ) ^ A * C * (2 + |s.im|) ^ A := by
    intro f A C Ca hC hCa hdiff hgrow hedge
    have hcmp : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
        1 ≤ ‖s - 5‖ ∧ 2 + |s.im| ≤ 3 * ‖s - 5‖ ∧ ‖s - 5‖ ≤ 3 * (2 + |s.im|) := by
      intro s h1 h2
      have hre : (s - (5 : ℂ)).re = s.re - 5 := by simp
      have him : (s - (5 : ℂ)).im = s.im := by simp
      have e1 : |(s - (5 : ℂ)).re| ≤ ‖s - (5 : ℂ)‖ := Complex.abs_re_le_norm _
      have e2 : |(s - (5 : ℂ)).im| ≤ ‖s - (5 : ℂ)‖ := Complex.abs_im_le_norm _
      have e3 : ‖s - (5 : ℂ)‖ ≤ |(s - (5 : ℂ)).re| + |(s - (5 : ℂ)).im| :=
        Complex.norm_le_abs_re_add_abs_im _
      rw [hre] at e1
      rw [him] at e2
      rw [hre, him] at e3
      have habs : |s.re - 5| = 5 - s.re := by
        rw [abs_of_nonpos (by linarith)]; ring
      rw [habs] at e1 e3
      have hi : (0 : ℝ) ≤ |s.im| := abs_nonneg _
      refine ⟨by linarith, by linarith, by linarith⟩
    have hne : ∀ s : ℂ, s.re < 5 → (s - (5 : ℂ)) ≠ 0 := by
      intro s hs h
      rw [sub_eq_zero] at h
      rw [h] at hs
      norm_num at hs
    have hgdiff : ∀ s : ℂ, -1 < s.re → s.re < 5 →
        DifferentiableAt ℂ (fun z : ℂ => f z / (z - 5) ^ A) s := by
      intro s h1 h2
      have hd2 : DifferentiableAt ℂ (fun z : ℂ => (z - 5 : ℂ) ^ A) s :=
        (differentiableAt_id.sub_const (5 : ℂ)).pow A
      exact (hdiff s h1 h2).div hd2 (pow_ne_zero A (hne s h2))
    have hdc : DiffContOnCl ℂ (fun z : ℂ => f z / (z - 5) ^ A)
        (Complex.re ⁻¹' Set.Ioo (-(1 : ℝ) / 2) 4) := by
      apply DifferentiableOn.diffContOnCl
      have hcl : closure (Complex.re ⁻¹' Set.Ioo (-(1 : ℝ) / 2) 4)
          ⊆ Complex.re ⁻¹' Set.Icc (-(1 : ℝ) / 2) 4 :=
        closure_minimal (Set.preimage_mono Set.Ioo_subset_Icc_self)
          (IsClosed.preimage Complex.continuous_re isClosed_Icc)
      intro x hx
      have hx' := hcl hx
      simp only [Set.mem_preimage, Set.mem_Icc] at hx'
      exact (hgdiff x (by linarith [hx'.1]) (by linarith [hx'.2])).differentiableWithinAt
    have hgle : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
        ‖f s / (s - 5) ^ A‖ ≤ ‖f s‖ := by
      intro s h1 h2
      obtain ⟨hn1, -, -⟩ := hcmp s h1 h2
      rw [norm_div, norm_pow]
      exact div_le_self (norm_nonneg _) (one_le_pow₀ hn1)
    have hedgeg : ∀ s : ℂ, s.re = -(1 : ℝ) / 2 ∨ s.re = 4 →
        ‖f s / (s - 5) ^ A‖ ≤ (3 : ℝ) ^ A * C := by
      intro s hs
      have h1 : -(1 : ℝ) / 2 ≤ s.re := by rcases hs with h | h <;> rw [h] <;> norm_num
      have h2 : s.re ≤ 4 := by rcases hs with h | h <;> rw [h] <;> norm_num
      obtain ⟨hn1, hn2, -⟩ := hcmp s h1 h2
      have hP1 : (1 : ℝ) ≤ ‖s - (5 : ℂ)‖ ^ A := one_le_pow₀ hn1
      have hP0 : (0 : ℝ) < ‖s - (5 : ℂ)‖ ^ A := by linarith
      rw [norm_div, norm_pow, div_le_iff₀ hP0]
      have hstep : (2 + |s.im|) ^ A ≤ (3 * ‖s - (5 : ℂ)‖) ^ A :=
        pow_le_pow_left₀ (by positivity) hn2 A
      rw [mul_pow] at hstep
      calc ‖f s‖ ≤ C * (2 + |s.im|) ^ A := hedge s hs
        _ ≤ C * ((3 : ℝ) ^ A * ‖s - (5 : ℂ)‖ ^ A) := mul_le_mul_of_nonneg_left hstep hC
        _ = (3 : ℝ) ^ A * C * ‖s - (5 : ℂ)‖ ^ A := by ring
    have hPLg : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
        ‖f s / (s - 5) ^ A‖ ≤ (3 : ℝ) ^ A * C := by
      intro s h1 h2
      refine PhragmenLindelof.vertical_strip (E := ℂ) (a := -(1 : ℝ) / 2) (b := 4)
        (C := (3 : ℝ) ^ A * C) (f := fun z : ℂ => f z / (z - 5) ^ A) (z := s)
        hdc ?_ (fun z hz => hedgeg z (Or.inl hz)) (fun z hz => hedgeg z (Or.inr hz)) h1 h2
      refine ⟨1 / 2, ?_, 4 * Ca, ?_⟩
      · rw [lt_div_iff₀ (by norm_num : (0 : ℝ) < 4 - -(1 : ℝ) / 2)]
        linarith [Real.pi_gt_three]
      · apply Asymptotics.IsBigO.of_bound'
        rw [Filter.eventually_inf_principal]
        refine Filter.Eventually.of_forall (fun z hz => ?_)
        simp only [Set.mem_preimage, Set.mem_Ioo] at hz
        have hz1 : -(1 : ℝ) / 2 ≤ z.re := hz.1.le
        have hz2 : z.re ≤ 4 := hz.2.le
        have hT : (0 : ℝ) ≤ |z.im| := abs_nonneg _
        have hCae : Ca ≤ Real.exp Ca := by linarith [Real.add_one_le_exp Ca]
        have hexpT : 1 + |z.im| / 2 ≤ Real.exp (1 / 2 * |z.im|) := by
          have h := Real.add_one_le_exp (1 / 2 * |z.im|)
          linarith
        have step1 : Ca * Real.exp (Ca * (1 + |z.im|))
            ≤ Real.exp (Ca + Ca * (1 + |z.im|)) := by
          rw [Real.exp_add]
          exact mul_le_mul_of_nonneg_right hCae (Real.exp_pos _).le
        have h4 : 4 * Ca * (1 + |z.im| / 2) ≤ 4 * Ca * Real.exp (1 / 2 * |z.im|) :=
          mul_le_mul_of_nonneg_left hexpT (by positivity)
        have step2 : Ca + Ca * (1 + |z.im|) ≤ 4 * Ca * Real.exp (1 / 2 * |z.im|) := by
          nlinarith [mul_nonneg hCa.le hT]
        calc ‖f z / (z - 5) ^ A‖ ≤ ‖f z‖ := hgle z hz1 hz2
          _ ≤ Ca * Real.exp (Ca * (1 + |z.im|)) := hgrow z hz1 hz2
          _ ≤ Real.exp (Ca + Ca * (1 + |z.im|)) := step1
          _ ≤ Real.exp (4 * Ca * Real.exp (1 / 2 * |z.im|)) := Real.exp_le_exp.mpr step2
          _ = ‖Real.exp (4 * Ca * Real.exp (1 / 2 * |z.im|))‖ :=
              (Real.norm_of_nonneg (Real.exp_pos _).le).symm
    intro s h1 h2
    obtain ⟨hn1, -, hn3⟩ := hcmp s h1 h2
    have hfe : f s = (f s / (s - 5) ^ A) * (s - 5) ^ A :=
      (div_mul_cancel₀ _ (pow_ne_zero A (hne s (by linarith)))).symm
    have hnormeq : ‖f s‖ = ‖f s / (s - 5) ^ A‖ * ‖s - (5 : ℂ)‖ ^ A := by
      conv_lhs => rw [hfe]
      rw [norm_mul, norm_pow]
    have hpow : ‖s - (5 : ℂ)‖ ^ A ≤ (3 : ℝ) ^ A * (2 + |s.im|) ^ A := by
      have h := pow_le_pow_left₀ (norm_nonneg (s - (5 : ℂ))) hn3 A
      rwa [mul_pow] at h
    rw [hnormeq]
    calc ‖f s / (s - 5) ^ A‖ * ‖s - (5 : ℂ)‖ ^ A
        ≤ ((3 : ℝ) ^ A * C) * ((3 : ℝ) ^ A * (2 + |s.im|) ^ A) :=
          mul_le_mul (hPLg s h1 h2) hpow (by positivity) (by positivity)
      _ = (9 : ℝ) ^ A * C * (2 + |s.im|) ^ A := by
          rw [show (9 : ℝ) = 3 * 3 by norm_num, mul_pow]; ring
  
  have hGam : KaiMFConeGammaProp := by
    have key : ∀ a : ℝ, 0 < a → ∀ z : ℂ, 0 < z.re →
        MeasureTheory.Integrable
            (fun u : ℝ => Complex.exp (z * (u : ℂ) - ((a * Real.exp u : ℝ) : ℂ)))
            MeasureTheory.volume ∧
          (∫ u : ℝ, Complex.exp (z * (u : ℂ) - ((a * Real.exp u : ℝ) : ℂ)))
            = Complex.Gamma z * ((a : ℝ) : ℂ) ^ (-z) := by
      intro a ha z hz
      have hane : a ≠ 0 := ne_of_gt ha
      have hac : ((a : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hane
      have hacz : ((a : ℝ) : ℂ) ^ z ≠ 0 := by
        intro h
        exact hac ((Complex.cpow_eq_zero_iff _ _).mp h).1
      have hrange : Set.range (fun u : ℝ => a * Real.exp u) = Set.Ioi (0 : ℝ) := by
        ext t
        simp only [Set.mem_range, Set.mem_Ioi]
        constructor
        · rintro ⟨u, rfl⟩
          exact mul_pos ha (Real.exp_pos u)
        · intro ht
          refine ⟨Real.log (t / a), ?_⟩
          rw [Real.exp_log (div_pos ht ha)]
          field_simp
      have himg : (fun u : ℝ => a * Real.exp u) '' Set.univ = Set.Ioi (0 : ℝ) := by
        rw [Set.image_univ, hrange]
      have hderiv : ∀ x ∈ (Set.univ : Set ℝ),
          HasDerivWithinAt (fun u : ℝ => a * Real.exp u) (a * Real.exp x) Set.univ x := by
        intro x _
        exact (HasDerivAt.const_mul a (Real.hasDerivAt_exp x)).hasDerivWithinAt
      have hinj : Set.InjOn (fun u : ℝ => a * Real.exp u) Set.univ := by
        intro u _ v _ huv
        have huv' : a * Real.exp u = a * Real.exp v := huv
        exact Real.exp_eq_exp.mp (mul_left_cancel₀ hane huv')
      have hstar : ∀ u : ℝ,
          |a * Real.exp u| • (((Real.exp (-(a * Real.exp u)) : ℝ) : ℂ) *
