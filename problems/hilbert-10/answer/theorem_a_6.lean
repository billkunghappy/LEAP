    linarith
  
  have htel : ∀ (α : ℝ) (a b : ℤ),
      ‖giE α - 1‖ * ‖∑ t ∈ Finset.Icc a b, giE (α * (t : ℝ))‖ ≤ 2 := by
    intro α a b
    have hstep : ∀ t : ℤ, giE (α * ((t + 1 : ℤ) : ℝ)) = giE (α * (t : ℝ)) * giE α := by
      intro t; rw [← hgadd]; congr 1; push_cast; ring
    rcases lt_or_ge b a with hba | hab
    · rw [Finset.Icc_eq_empty (by omega), Finset.sum_empty, norm_zero, mul_zero]; norm_num
    · have hid : ∀ n : ℤ, a ≤ n → (giE α - 1) * ∑ t ∈ Finset.Icc a n, giE (α * (t : ℝ))
