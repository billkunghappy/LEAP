        exact (hGeq w hw).symm
      rw [hev.deriv_eq, hGz, ← hld]
      rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hE with h | h
      · subst h; simp
      · subst h
        simp only [pow_one, Nat.cast_one]
        have hd : HasDerivAt (fun w => kaiHeckeSeries K lam w * (w - 1))
