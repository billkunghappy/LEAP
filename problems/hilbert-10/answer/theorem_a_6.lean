  obtain ⟨z, hz⟩ : ∃ z : (Fin r → ℤ) → (ι ⊕ Fin r) → ℝ,
      z = fun h => Sum.elim (x' h) (fun i => (h i : ℝ) / (N : ℝ)) := ⟨_, rfl⟩
  obtain ⟨y, hy⟩ : ∃ y : (Fin r → ℤ) → Fin r → ℝ,
      y = fun h j => c j + ∑ k, A j k * (P h k - round (P h k)) := ⟨_, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u : (Fin r → ℤ) → ι → ℤ,
      u = fun h k => round (p h k) - round (P h k) := ⟨_, rfl⟩
  
  obtain ⟨Γ, hZ, hgΓ, R, hRc, hR⟩ := kai_vb_lattice_cosets (ι ⊕ Fin r) r N hN1 a
  have hαΓ : ∀ i, α'' i ∈ Γ := by
    intro i
    rw [hα'']
    exact hgΓ i
  have hzinr : ∀ h i, z h (Sum.inr i) = (h i : ℝ) / (N : ℝ) := by
    intro h i; simp only [hz, Sum.elim_inr]
  have hzinl : ∀ h k, z h (Sum.inl k) = x' h k := by
    intro h k; simp only [hz, Sum.elim_inl]
  
  have hzΓ : ∀ h : Fin r → ℤ, z h ∈ Γ := by
    intro h
    have hdecomp : z h = (fun x => ((Sum.elim (fun k => -round (p h k)) (fun _ => (0 : ℤ)) x : ℤ) : ℝ))
        + ∑ i, (h i) • α'' i := by
      funext x
      simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, zsmul_eq_mul, Pi.mul_apply,
        Pi.intCast_apply]
      rcases x with k | i'
      · have e : ∑ i, (h i : ℝ) * α'' i (Sum.inl k) = p h k := by
          simp only [hα'', ha, hp, Sum.elim_inl]
        simp only [Sum.elim_inl]
        rw [e, hzinl, hx']
        push_cast
        ring
      · have e : ∑ i, (h i : ℝ) * α'' i (Sum.inr i') = (h i' : ℝ) / N := by
          simp only [hα'', ha, Sum.elim_inr]
          rw [Finset.sum_eq_single i']
          · simp [div_eq_mul_inv]
          · intro b _ hb
            simp [Ne.symm hb]
          · intro hcon
            exact absurd (Finset.mem_univ _) hcon
        simp only [Sum.elim_inr]
        rw [e, hzinr]
        simp
    rw [hdecomp]
    exact add_mem (hZ _) (AddSubgroup.sum_mem _ fun i _ => zsmul_mem (hαΓ i) (h i))
  
  have hid : ∀ h ∈ E, ∀ j, ∑ x, A'' j x * z h x
      = (y h j - c j) - ∑ k, A j k * (u h k : ℝ) := by
    intro h hh j
    have h5 := (kai_vb_round_identity ι r N H hN1 hNH α A h (hE h hh)).2 j
    rw [Fintype.sum_sum_type]
    simp only [hA'', hz, Sum.elim_inl, Sum.elim_inr]
    simp only [hx', hp]
    rw [h5]
    simp only [hy, hu, hP, hp, mul_sub, Finset.sum_sub_distrib]
    ring
  have hu1 : ∀ h ∈ E, ∀ k, |u h k| ≤ 1 := by
    intro h hh k
    have h5 := (kai_vb_round_identity ι r N H hN1 hNH α A h (hE h hh)).1 k
    simpa only [hu, hp, hP] using h5
  have hyc : ∀ h ∈ E, ∀ j, |y h j - c j| ≤ (Fintype.card ι : ℝ) * M / 2 := by
    intro h _ j
    have e1 : y h j - c j = ∑ k, A j k * (P h k - round (P h k)) := by
      simp only [hy]; ring
    rw [e1]
    calc |∑ k, A j k * (P h k - round (P h k))|
        ≤ ∑ k, |A j k * (P h k - round (P h k))| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _k : ι, M * (1 / 2) := by
          apply Finset.sum_le_sum
          intro k _
          rw [abs_mul]
          exact mul_le_mul (hA j k) (abs_sub_round _) (abs_nonneg _) (by linarith)
      _ = (Fintype.card ι : ℝ) * M / 2 := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; ring
  obtain ⟨E₁, hE₁E, hcard₁, hfib⟩ :=
    kai_vb_fiber_pigeonhole ι r M δ H hr hM hδ hH E hEcard c u y x' hu1 hyc
  rw [← hNdef] at hcard₁
  
  have hσ : 0 < vbSigma (Fintype.card ι) r M δ := by
    unfold vbSigma
    have h1 : 0 < (Fintype.card ι : ℝ) * M + 3 := by
      have := mul_nonneg (Nat.cast_nonneg (Fintype.card ι) : (0 : ℝ) ≤ Fintype.card ι)
        (by linarith : (0 : ℝ) ≤ M)
      linarith
    have h2 : (0 : ℝ) < 4 * (r : ℝ) := by
      have : (1 : ℝ) ≤ r := by exact_mod_cast hr
      linarith
    exact div_pos hδ (mul_pos (mul_pos (by positivity) (pow_pos h1 r)) (pow_pos h2 r))
  have hE₁ne : E₁.Nonempty := by
    rw [← Finset.card_pos]
    have : (0 : ℝ) < (E₁.card : ℝ) :=
      lt_of_lt_of_le (mul_pos hσ (pow_pos hNpos r)) hcard₁
    exact_mod_cast this
  obtain ⟨h₀, hh₀⟩ := hE₁ne
  have hh₀E : h₀ ∈ E := hE₁E hh₀
  have hinj : Set.InjOn (fun h => z h - z h₀) (E₁ : Set (Fin r → ℤ)) := by
    intro h _ h' _ heq
    have heq' : z h = z h' := sub_left_injective heq
    funext i
    have := congrFun heq' (Sum.inr i)
    rw [hzinr, hzinr] at this
    have h2 : (h i : ℝ) = (h' i : ℝ) := by
      field_simp at this
      exact this
    exact_mod_cast h2
  
  refine ⟨α'', A'', Γ, ?_, ?_, ?_, hZ, hαΓ, ⟨R, hRc, hR⟩,
    E₁.image (fun h => z h - z h₀), ?_, ?_⟩
  · 
    intro i k
    simp only [hα'', ha, Sum.elim_inl]
    have key : (round ((N : ℝ) * α i k) : ℝ) / N - α i k
        = -(((N : ℝ) * α i k - round ((N : ℝ) * α i k)) / N) := by
      field_simp; ring
    rw [key, abs_neg, abs_div, abs_of_pos hNpos, div_le_div_iff₀ hNpos (by positivity)]
    have := abs_sub_round ((N : ℝ) * α i k)
    nlinarith
  · 
    intro i i'
    simp only [hα'', ha, Sum.elim_inr]
    split_ifs <;> simp
  · 
    intro j k
    simp only [hA'', Sum.elim_inl]
  · 
    rw [Finset.card_image_of_injOn hinj]
    exact hcard₁
  · 
    intro w hw
    rw [Finset.mem_image] at hw
    obtain ⟨h, hh, rfl⟩ := hw
    have hhE : h ∈ E := hE₁E hh
    obtain ⟨hfu, hfy, hfs⟩ := hfib h hh h₀ hh₀
    refine ⟨sub_mem (hzΓ h) (hzΓ h₀), ?_, ?_⟩
    · intro x
      rcases x with k | i
      · simp only [Pi.sub_apply, hzinl]
        have b1 : |x' h k| ≤ 1 / 2 := by simp only [hx']; exact abs_sub_round _
        have b2 : |x' h₀ k| ≤ 1 / 2 := by simp only [hx']; exact abs_sub_round _
        rw [abs_le] at b1 b2 ⊢
        by_cases hs : 0 ≤ x' h k
        · have hs0 := (hfs k).1 hs
          constructor <;> linarith
        · have hs0 : ¬ 0 ≤ x' h₀ k := fun h' => hs ((hfs k).2 h')
          push_neg at hs hs0
          constructor <;> linarith
      · simp only [Pi.sub_apply, hzinr]
        have b1 : |(h i : ℝ)| ≤ H := by
          have := hE h hhE i
          have : |(h i : ℝ)| < H := by exact_mod_cast this
          linarith
        have b2 : |(h₀ i : ℝ)| ≤ H := by
          have := hE h₀ hh₀E i
          have : |(h₀ i : ℝ)| < H := by exact_mod_cast this
          linarith
        rw [← sub_div, abs_div, abs_of_pos hNpos, div_le_iff₀ hNpos]
        have := abs_sub (h i : ℝ) (h₀ i : ℝ)
        linarith
    · intro j
      have e1 : ∑ x, A'' j x * (z h - z h₀) x
          = ∑ x, A'' j x * z h x - ∑ x, A'' j x * z h₀ x := by
        simp only [Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
      rw [e1, hid h hhE j, hid h₀ hh₀E j, hfu]
      have g1 := hEhyp h hhE j
      have g2 := hEhyp h₀ hh₀E j
      have ey : ∀ h', y h' j = c j + ∑ k, A j k * ((∑ i, (h' i : ℝ) * α i k)
          - round (∑ i, (h' i : ℝ) * α i k)) := by
        intro h'; simp only [hy, hP]
      rw [← ey h] at g1
      rw [← ey h₀] at g2
      rw [hfy j] at g1
      have : y h j - c j - ∑ k, A j k * (u h₀ k : ℝ) - (y h₀ j - c j - ∑ k, A j k * (u h₀ k : ℝ))
          = (y h j - round (y h₀ j)) - (y h₀ j - round (y h₀ j)) := by ring
      rw [this]
      have := abs_sub (y h j - round (y h₀ j)) (y h₀ j - round (y h₀ j))
      linarith

theorem vb_minima_exist (D : Type) [Fintype D] [DecidableEq D] (Γ : AddSubgroup (D → ℝ))
    (B : Set (D → ℝ)) (hBc : Convex ℝ B) (hBs : ∀ x ∈ B, -x ∈ B) (hB0 : (0 : D → ℝ) ∈ B)
    (hfin : Set.Finite {x | x ∈ Γ ∧ x ∈ B}) :
    ∃ (k : ℕ) (b : Fin k → D → ℝ) (lam : Fin k → ℝ), vbMinSys Γ B k b lam ∧
      ∀ γ ∈ Γ, γ ∈ B → γ ∈ Submodule.span ℝ (Set.range b) :=
by
  classical
  
  have C1 : ∀ (s : ℝ) (y : D → ℝ), 0 ≤ s → s ≤ 1 → y ∈ B → s • y ∈ B :=
    fun s y hs0 hs1 hy => hBc.smul_mem_of_zero_mem hB0 hy ⟨hs0, hs1⟩
  
  have s1 : ∀ x ∈ B, ∀ μ : ℝ, gauge B x < μ → x ∈ (fun y => μ • y) '' B := by
    intro x hx μ hμ
    rw [gauge_def] at hμ
    obtain ⟨r, ⟨hr0, hrx⟩, hrμ⟩ := exists_lt_of_csInf_lt
      (by exact ⟨1, Set.mem_Ioi.mpr one_pos, Set.mem_smul_set.mpr ⟨x, hx, one_smul ℝ x⟩⟩) hμ
    obtain ⟨y, hy, rfl⟩ := Set.mem_smul_set.mp hrx
    have hr0' : (0:ℝ) < r := hr0
    have hμ0 : 0 < μ := lt_trans hr0' hrμ
    refine ⟨(r / μ) • y, C1 _ _ (div_nonneg hr0'.le hμ0.le) ((div_le_one hμ0).2 hrμ.le) hy, ?_⟩
    simp only [smul_smul]
    congr 1
    field_simp
  
  have s2 : ∀ x, x ∈ Γ → x ∈ B → x ≠ 0 → 0 < gauge B x := by
    intro x hxΓ hxB hx0
    by_contra hneg
    have hg0 : gauge B x = 0 := le_antisymm (not_lt.mp hneg) (gauge_nonneg x)
    have hmem : ∀ n : ℕ, ((n:ℝ)+1) • x ∈ B := by
      intro n
      have hpos : (0:ℝ) < 1 / ((n:ℝ)+1) := by positivity
      obtain ⟨y, hy, hyx⟩ := s1 x hxB _ (by rw [hg0]; exact hpos)
      rw [← hyx, smul_smul]
      have : ((n:ℝ)+1) * (1 / ((n:ℝ)+1)) = 1 := by field_simp
      rw [this, one_smul]; exact hy
    have hΓ : ∀ n : ℕ, ((n:ℝ)+1) • x ∈ Γ := by
      intro n
      have : ((n:ℝ)+1) • x = (n+1) • x := by
        rw [← Nat.cast_succ, Nat.cast_smul_eq_nsmul]
      rw [this]; exact AddSubgroup.nsmul_mem Γ hxΓ (n+1)
    have hinj : Function.Injective (fun n : ℕ => ((n:ℝ)+1) • x) := by
      intro n m h
      have h1 : (n:ℝ)+1 = (m:ℝ)+1 := smul_left_injective ℝ hx0 h
      have h2 : (n:ℝ) = m := by linarith
      exact_mod_cast h2
    exact (Set.infinite_of_injective_forall_mem (s := {x | x ∈ Γ ∧ x ∈ B}) hinj
      (fun n => ⟨hΓ n, hmem n⟩)) hfin
  
  have s3 : ∀ W : Submodule ℝ (D → ℝ), (∃ γ ∈ Γ, γ ∈ B ∧ γ ∉ W) →
      ∃ (v : D → ℝ) (t : ℝ), v ∈ Γ ∧ v ∉ W ∧ 0 < t ∧ t ≤ 1 ∧
        (∀ μ : ℝ, t < μ → v ∈ (fun y => μ • y) '' B) ∧
        (∀ (γ : D → ℝ) (μ : ℝ), γ ∈ Γ → 0 ≤ μ → μ < t → γ ∈ (fun y => μ • y) '' B →
          γ ∈ W) := by
    intro W hex
    obtain ⟨Fs, hmemFs⟩ : ∃ Fs : Finset (D → ℝ), ∀ x, x ∈ Fs ↔ (x ∈ Γ ∧ x ∈ B) ∧ x ∉ W :=
      ⟨hfin.toFinset.filter (fun x => x ∉ W), by intro x; simp⟩
    obtain ⟨γ, hγΓ, hγB, hγW⟩ := hex
    have hne : Fs.Nonempty := ⟨γ, (hmemFs γ).2 ⟨⟨hγΓ, hγB⟩, hγW⟩⟩
    obtain ⟨v, hvFs, hvmin⟩ := Fs.exists_min_image (gauge B) hne
    obtain ⟨⟨hvΓ, hvB⟩, hvW⟩ := (hmemFs v).1 hvFs
    have hv0 : v ≠ 0 := fun h => hvW (h ▸ W.zero_mem)
    have ht1 : gauge B v ≤ 1 :=
      gauge_le_of_mem zero_le_one (Set.mem_smul_set.mpr ⟨v, hvB, one_smul ℝ v⟩)
    refine ⟨v, gauge B v, hvΓ, hvW, s2 v hvΓ hvB hv0, ht1, s1 v hvB, ?_⟩
    intro γ' μ hγ'Γ hμ0 hμt hγ'
    obtain ⟨y, hy, rfl⟩ := hγ'
    have hγB' : μ • y ∈ B := C1 μ y hμ0 (by linarith) hy
    have hg : gauge B (μ • y) ≤ μ := gauge_le_of_mem hμ0 (Set.smul_mem_smul_set hy)
    by_contra hW
    have := hvmin _ ((hmemFs _).2 ⟨⟨hγ'Γ, hγB'⟩, hW⟩)
    linarith
  
  have s4 : ∀ (n : ℕ) (b : Fin n → D → ℝ) (lam : Fin n → ℝ), vbMinSys Γ B n b lam →
      ∀ (v : D → ℝ) (t : ℝ), v ∈ Γ → v ∉ Submodule.span ℝ (Set.range b) → 0 < t → t ≤ 1 →
      (∀ μ : ℝ, t < μ → v ∈ (fun y => μ • y) '' B) →
      (∀ (γ : D → ℝ) (μ : ℝ), γ ∈ Γ → 0 ≤ μ → μ < t → γ ∈ (fun y => μ • y) '' B →
          γ ∈ Submodule.span ℝ (Set.range b)) →
      vbMinSys Γ B (n + 1) (Fin.snoc b v) (Fin.snoc lam t) := by
    intro n b lam hsys v t hvΓ hvW ht0 ht1 hvmem hmin
    obtain ⟨hli, hΓb, hlam, hmono, he, hf⟩ := hsys
    have K : ∀ i : Fin n, lam i ≤ t := by
      intro i
      by_contra hlt
      push_neg at hlt
      have h1 := hf i v ((t + lam i) / 2) hvΓ (by linarith) (by linarith)
        (hvmem _ (by linarith))
      exact hvW (Submodule.span_mono (Set.image_subset_range _ _) h1)
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact linearIndependent_fin_snoc.mpr ⟨hli, hvW⟩
    · intro i
      induction i using Fin.lastCases with
      | last => simpa using hvΓ
      | cast i => simpa using hΓb i
    · intro i
      induction i using Fin.lastCases with
      | last => simp only [Fin.snoc_last]; exact ⟨ht0, ht1⟩
      | cast i => simp only [Fin.snoc_castSucc]; exact hlam i
    · intro i j hij
      induction j using Fin.lastCases with
      | last =>
        induction i using Fin.lastCases with
        | last => exact le_refl _
        | cast i => simp only [Fin.snoc_last, Fin.snoc_castSucc]; exact K i
      | cast j =>
        induction i using Fin.lastCases with
        | last => exact absurd hij (not_le.mpr (Fin.castSucc_lt_last j))
        | cast i =>
          simp only [Fin.snoc_castSucc]
          exact hmono (Fin.castSucc_le_castSucc_iff.mp hij)
    · intro i μ hμ
      induction i using Fin.lastCases with
      | last => simp only [Fin.snoc_last] at hμ ⊢; exact hvmem μ hμ
      | cast i => simp only [Fin.snoc_castSucc] at hμ ⊢; exact he i μ hμ
    · intro i γ μ hγΓ hμ0 hμi hγ
      induction i using Fin.lastCases with
      | last =>
        simp only [Fin.snoc_last] at hμi
        refine Submodule.span_mono ?_ (hmin γ μ hγΓ hμ0 hμi hγ)
        rintro _ ⟨j, rfl⟩
        exact ⟨Fin.castSucc j, Fin.castSucc_lt_last j, by simp⟩
      | cast i =>
        simp only [Fin.snoc_castSucc] at hμi
        refine Submodule.span_mono ?_ (hf i γ μ hγΓ hμ0 hμi hγ)
        rintro _ ⟨j, hj, rfl⟩
        exact ⟨Fin.castSucc j, Fin.castSucc_lt_castSucc_iff.mpr hj, by simp⟩
  
  have base : vbMinSys Γ B 0 (fun i => Fin.elim0 i) (fun i => Fin.elim0 i) :=
    ⟨linearIndependent_empty_type, fun i => Fin.elim0 i, fun i => Fin.elim0 i,
      fun i => Fin.elim0 i, fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
  
  have claim : ∀ n : ℕ, (∃ (k : ℕ) (b : Fin k → D → ℝ) (lam : Fin k → ℝ),
      vbMinSys Γ B k b lam ∧ ∀ γ ∈ Γ, γ ∈ B → γ ∈ Submodule.span ℝ (Set.range b)) ∨
      ∃ (b : Fin n → D → ℝ) (lam : Fin n → ℝ), vbMinSys Γ B n b lam := by
    intro n
    induction n with
    | zero => exact Or.inr ⟨_, _, base⟩
    | succ n ih =>
      rcases ih with hdone | ⟨b, lam, hs⟩
      · exact Or.inl hdone
      · by_cases hc : ∀ γ ∈ Γ, γ ∈ B → γ ∈ Submodule.span ℝ (Set.range b)
        · exact Or.inl ⟨n, b, lam, hs, hc⟩
        · push_neg at hc
          obtain ⟨v, t, hvΓ, hvW, ht0, ht1, hvmem, hmin⟩ := s3 _ hc
          exact Or.inr ⟨_, _, s4 n b lam hs v t hvΓ hvW ht0 ht1 hvmem hmin⟩
  rcases claim (Fintype.card D + 1) with hdone | ⟨b, lam, hs⟩
  · exact hdone
  · exfalso
    have h := hs.1.fintype_card_le_finrank
    rw [Fintype.card_fin, Module.finrank_fintype_fun_eq_card] at h
    omega

theorem vb_proj_lift (D : Type) [Fintype D] [DecidableEq D] (Γ : AddSubgroup (D → ℝ))
    (B : Set (D → ℝ)) (hBc : Convex ℝ B) (hBs : ∀ x ∈ B, -x ∈ B) (hB0 : (0 : D → ℝ) ∈ B)
    (b₀ : D → ℝ) (hb₀ : b₀ ∈ Γ) (π : (D → ℝ) →ₗ[ℝ] (D → ℝ))
    (hker : ∀ x, π x = 0 ↔ ∃ t : ℝ, x = t • b₀)
    (ν ν' : ℝ) (hν : 0 ≤ ν) (hν' : 0 ≤ ν') (hb₀B : b₀ ∈ (fun x => ν' • x) '' B)
    (γ β : D → ℝ) (hγ : γ ∈ Γ) (hβ : β ∈ (fun x => ν • x) '' B) (hπ : π γ = π β) :
    ∃ w : D → ℝ, w ∈ Γ ∧ π w = π γ ∧ w ∈ (fun x => (ν + ν' / 2) • x) '' B :=
by
  obtain ⟨x, hx, rfl⟩ := hβ
  obtain ⟨y, hy, rfl⟩ := hb₀B
  have hπb : π (ν' • y) = 0 := (hker _).2 ⟨1, (one_smul ℝ _).symm⟩
  obtain ⟨t, ht⟩ := (hker (γ - ν • x)).1 (by rw [map_sub, hπ, sub_self])
  obtain ⟨n, hn⟩ : ∃ n : ℤ, n = round t := ⟨_, rfl⟩
  have hs : |t - (n : ℝ)| ≤ 1 / 2 := by rw [hn]; exact abs_sub_round t
  refine ⟨γ - (n : ℝ) • (ν' • y), ?_, ?_, ?_⟩
  · have hcast : (n : ℝ) • (ν' • y) = n • (ν' • y) := Int.cast_smul_eq_zsmul ℝ n _
    rw [hcast]
    exact Γ.sub_mem hγ (Γ.zsmul_mem hb₀ n)
  · rw [map_sub, map_smul, hπb, smul_zero, sub_zero]
  · have hw : γ - (n : ℝ) • (ν' • y) = ν • x + ((t - (n : ℝ)) * ν') • y := by
      have hγ' : γ = ν • x + t • (ν' • y) := by rw [← ht]; abel
      rw [hγ', smul_smul, smul_smul, sub_mul, sub_smul]; abel
    rw [hw]
    obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = t - (n : ℝ) := ⟨_, rfl⟩
    rw [← hs_def]
    rw [← hs_def] at hs
    have h2s : (2 * s) • y ∈ B := by
      rcases le_total 0 (2 * s) with h | h
      · exact hBc.smul_mem_of_zero_mem hB0 hy ⟨h, by linarith [(abs_le.1 hs).2]⟩
      · have := hBc.smul_mem_of_zero_mem hB0 (hBs y hy)
          (t := -(2 * s)) ⟨by linarith, by linarith [(abs_le.1 hs).1]⟩
        rwa [smul_neg, ← neg_smul, neg_neg] at this
    rcases eq_or_lt_of_le (show 0 ≤ ν + ν' / 2 by positivity) with hc | hc
    · have h1 : ν = 0 := by linarith
      have h2 : ν' = 0 := by linarith
      refine ⟨0, hB0, ?_⟩
      simp [h1, h2]
    · refine ⟨(ν / (ν + ν' / 2)) • x + ((ν' / 2) / (ν + ν' / 2)) • ((2 * s) • y), ?_, ?_⟩
      · exact hBc hx h2s (div_nonneg hν hc.le) (div_nonneg (by positivity) hc.le)
          (by rw [← add_div]; exact div_self hc.ne')
      · dsimp only
        have hc2 : ν * 2 + ν' ≠ 0 := by intro h; linarith
        have hc3 : ν' + ν * 2 ≠ 0 := by intro h; linarith
        simp only [smul_add, smul_smul]
        congr 1
        · congr 1; field_simp
        · congr 1; field_simp

theorem vb_proj_compare (D : Type) [Fintype D] [DecidableEq D] (Γ : AddSubgroup (D → ℝ))
    (B : Set (D → ℝ)) (hBc : Convex ℝ B) (hBs : ∀ x ∈ B, -x ∈ B) (hB0 : (0 : D → ℝ) ∈ B)
    (m : ℕ) (b : Fin (m + 1) → D → ℝ) (lam : Fin (m + 1) → ℝ)
    (hsys : vbMinSys Γ B (m + 1) b lam)
    (hspan : ∀ γ ∈ Γ, γ ∈ Submodule.span ℝ (Set.range b))
    (π : (D → ℝ) →ₗ[ℝ] (D → ℝ)) (hker : ∀ x, π x = 0 ↔ ∃ t : ℝ, x = t • b 0)
    (k' : ℕ) (b' : Fin k' → D → ℝ) (μ : Fin k' → ℝ) (hb' : LinearIndependent ℝ b')
    (hb'Γ : ∀ i, b' i ∈ Γ.map π.toAddMonoidHom) (hμ : Monotone μ)
    (hb'B : ∀ i (ν : ℝ), μ i < ν → b' i ∈ (fun x => ν • x) '' (π '' B)) :
    k' ≤ m ∧ ∀ (i : Fin k') (hi : i.val + 1 < m + 1), lam ⟨i.val + 1, hi⟩ ≤ 2 * μ i :=
by
  obtain ⟨ha, hb, hc, hd, he, hf⟩ := hsys
  have P0 : π (b 0) = 0 := (hker (b 0)).2 ⟨1, (one_smul ℝ _).symm⟩
  
  have s2 : ∀ (n p : ℕ) (f : Fin n → D → ℝ) (c : Fin p → D → ℝ), LinearIndependent ℝ c →
      (∀ l, c l ∈ Submodule.span ℝ (Set.range f)) → p ≤ n := by
    intro n p f c hc' hcf
    have h1 : Submodule.span ℝ (Set.range c) ≤ Submodule.span ℝ (Set.range f) :=
      Submodule.span_le.2 (by rintro _ ⟨l, rfl⟩; exact hcf l)
    have h2 := Submodule.finrank_mono h1
    rw [finrank_span_eq_card hc', Fintype.card_fin] at h2
    have h3 : Module.finrank ℝ (Submodule.span ℝ (Set.range f)) ≤ n := by
      have := finrank_range_le_card (R := ℝ) f
      rw [Fintype.card_fin] at this
      exact this
    omega
  
  have s3 : ∀ (r : ℕ) (hr : r ≤ m) (x : D → ℝ),
      x ∈ Submodule.span ℝ (b '' {j : Fin (m + 1) | j.val ≤ r}) →
      π x ∈ Submodule.span ℝ (Set.range (fun j : Fin r => π (b (Fin.castLE hr j).succ))) := by
    intro r hr x hx
    have hmap : π x ∈ (Submodule.span ℝ (b '' {j : Fin (m + 1) | j.val ≤ r})).map π :=
      Submodule.mem_map_of_mem hx
    rw [Submodule.map_span] at hmap
    refine (Submodule.span_le.2 ?_) hmap
    rintro _ ⟨_, ⟨j, hj, rfl⟩, rfl⟩
    rcases Fin.eq_zero_or_eq_succ j with h0 | ⟨k, rfl⟩
    · subst h0
      rw [SetLike.mem_coe, P0]
      exact Submodule.zero_mem _
    · have hj' : (k.succ).val ≤ r := hj
      rw [Fin.val_succ] at hj'
      have hk : k.val < r := by omega
      apply Submodule.subset_span
      refine ⟨⟨k.val, hk⟩, ?_⟩
      show π (b (Fin.castLE hr ⟨k.val, hk⟩).succ) = π (b k.succ)
      rw [show Fin.castLE hr ⟨k.val, hk⟩ = k from Fin.ext rfl]
  
  have lift : ∀ (ν ν' : ℝ), 0 ≤ ν → 0 ≤ ν' → b 0 ∈ (fun x => ν' • x) '' B →
      ∀ (γ β : D → ℝ), γ ∈ Γ → β ∈ (fun x => ν • x) '' B → π γ = π β →
      ∃ w : D → ℝ, w ∈ Γ ∧ π w = π γ ∧ w ∈ (fun x => (ν + ν' / 2) • x) '' B := by
    intro ν ν' hν hν' hb0B γ β hγ hβ hπ
    obtain ⟨x2, hx2, hx2e⟩ := hb0B
    obtain ⟨x1, hx1, hx1e⟩ := hβ
    dsimp only at hx1e hx2e
    have hk : π (γ - β) = 0 := by rw [map_sub, hπ, sub_self]
    obtain ⟨t, ht⟩ := (hker _).1 hk
    refine ⟨γ - ((round t : ℤ) : ℝ) • b 0, ?_, ?_, ?_⟩
    · refine Γ.sub_mem hγ ?_
      rw [Int.cast_smul_eq_zsmul]
      exact Γ.zsmul_mem (hb 0) _
    · rw [map_sub, map_smul, P0, smul_zero, sub_zero]
    · have hs : |t - ((round t : ℤ) : ℝ)| ≤ 1 / 2 := abs_sub_round t
      have hs' := abs_le.1 hs
      have hy : (2 * (t - ((round t : ℤ) : ℝ))) • x2 ∈ B := by
        rcases le_total 0 (2 * (t - ((round t : ℤ) : ℝ))) with h | h
        · exact hBc.smul_mem_of_zero_mem hB0 hx2 ⟨h, by linarith⟩
        · have := hBc.smul_mem_of_zero_mem hB0 (hBs x2 hx2)
            (t := -(2 * (t - ((round t : ℤ) : ℝ)))) ⟨by linarith, by linarith⟩
          rwa [smul_neg, neg_smul, neg_neg] at this
      have hw : γ - ((round t : ℤ) : ℝ) • b 0
          = ν • x1 + (ν' / 2) • ((2 * (t - ((round t : ℤ) : ℝ))) • x2) := by
        have hγe : γ = β + t • b 0 := by rw [← ht]; abel
        rw [hγe, ← hx1e, ← hx2e]
        funext d
        simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
        ring
      have hmem : ν • x1 + (ν' / 2) • ((2 * (t - ((round t : ℤ) : ℝ))) • x2)
          ∈ (fun x => (ν + ν' / 2) • x) '' B := by
        open Pointwise in
        (rw [Set.image_smul, hBc.add_smul hν (by linarith)]
         exact Set.add_mem_add (Set.smul_mem_smul_set hx1) (Set.smul_mem_smul_set hy))
      rw [hw]
      exact hmem
  
  have hA : k' ≤ m := by
    refine s2 m k' (fun j : Fin m => π (b (Fin.castLE (le_refl m) j).succ)) b' hb' ?_
    intro l
    obtain ⟨γ, hγ, hγl⟩ := AddSubgroup.mem_map.1 (hb'Γ l)
    have hγl' : π γ = b' l := hγl
    have hγs : γ ∈ Submodule.span ℝ (b '' {j : Fin (m + 1) | j.val ≤ m}) := by
      refine Submodule.span_mono ?_ (hspan γ hγ)
      rintro _ ⟨j, rfl⟩
      exact ⟨j, by show j.val ≤ m; omega, rfl⟩
    rw [← hγl']
    exact s3 m (le_refl m) γ hγs
  refine ⟨hA, ?_⟩
  
  intro i hi
  by_contra hcon
  push_neg at hcon
  have hL0 : 0 < lam ⟨i.val + 1, hi⟩ := (hc _).1
  have hl00 : 0 < lam 0 := (hc 0).1
  have hLL : lam 0 ≤ lam ⟨i.val + 1, hi⟩ :=
    hd (Fin.le_iff_val_le_val.2 (by simp))
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = max (μ i) 0 := ⟨_, rfl⟩
  have hM1 : μ i ≤ M := hM ▸ le_max_left _ _
  have hM2 : 0 ≤ M := hM ▸ le_max_right _ _
  have hM3 : M < lam ⟨i.val + 1, hi⟩ / 2 := by
    rw [hM]; exact max_lt (by linarith) (by linarith)
  obtain ⟨ν, hν⟩ : ∃ ν : ℝ, ν = (M + lam ⟨i.val + 1, hi⟩ / 2) / 2 := ⟨_, rfl⟩
  obtain ⟨ν', hν'⟩ : ∃ ν' : ℝ, ν' = lam 0 + (lam ⟨i.val + 1, hi⟩ / 2 - ν) := ⟨_, rfl⟩
  have hν0 : 0 < ν := by rw [hν]; linarith
  have hμν : μ i < ν := by rw [hν]; linarith
  have hν'0 : 0 ≤ ν' := by rw [hν', hν]; linarith
  have hν'l : lam 0 < ν' := by rw [hν', hν]; linarith
  have hsum : ν + ν' / 2 < lam ⟨i.val + 1, hi⟩ := by rw [hν', hν]; linarith
  have hb0B : b 0 ∈ (fun x => ν' • x) '' B := he 0 ν' hν'l
  have hri : i.val ≤ m := by omega
  have hW : ∀ l : Fin k', l ≤ i →
      b' l ∈ Submodule.span ℝ (Set.range (fun j : Fin i.val => π (b (Fin.castLE hri j).succ))) := by
    intro l hl
    obtain ⟨y, ⟨β₀, hβ₀, rfl⟩, hy⟩ := hb'B l ν (lt_of_le_of_lt (hμ hl) hμν)
    dsimp only at hy
    obtain ⟨γ, hγ, hγl⟩ := AddSubgroup.mem_map.1 (hb'Γ l)
    have hγl' : π γ = b' l := hγl
    have hπ : π γ = π (ν • β₀) := by rw [map_smul, hγl', hy]
    obtain ⟨w, hwΓ, hwπ, hwB⟩ :=
      lift ν ν' hν0.le hν'0 hb0B γ (ν • β₀) hγ ⟨β₀, hβ₀, rfl⟩ hπ
    have hwspan := hf ⟨i.val + 1, hi⟩ w (ν + ν' / 2) hwΓ (by linarith) hsum hwB
    have hset : {j : Fin (m + 1) | j < ⟨i.val + 1, hi⟩} = {j | j.val ≤ i.val} := by
      ext j
      simp only [Set.mem_setOf_eq, Fin.lt_def]
      omega
    rw [hset] at hwspan
    have := s3 i.val hri w hwspan
    rw [hwπ, hγl'] at this
    exact this
  have hik : i.val + 1 ≤ k' := i.isLt
  have hcount := s2 i.val (i.val + 1) (fun j : Fin i.val => π (b (Fin.castLE hri j).succ))
    (fun l => b' (Fin.castLE hik l)) (hb'.comp _ (Fin.castLE_injective hik))
    (fun l => hW _ (Fin.le_iff_val_le_val.2 (by simp; omega)))
  omega

theorem vb_fibre_count (D : Type) [Fintype D] [DecidableEq D] (Γ : AddSubgroup (D → ℝ))
    (B : Set (D → ℝ)) (hBc : Convex ℝ B) (hBs : ∀ x ∈ B, -x ∈ B) (hB0 : (0 : D → ℝ) ∈ B)
    (m : ℕ) (b : Fin (m + 1) → D → ℝ) (lam : Fin (m + 1) → ℝ)
    (hsys : vbMinSys Γ B (m + 1) b lam)
    (π : (D → ℝ) →ₗ[ℝ] (D → ℝ)) (hker : ∀ x, π x = 0 ↔ ∃ t : ℝ, x = t • b 0)
    (S : Finset (D → ℝ)) (hS : ∀ z ∈ S, z ∈ Γ ∧ z ∈ B) :
    (S.card : ℝ) * lam 0 ≤ 3 * ((S.image π).card : ℝ) :=
by
  obtain ⟨ha, hb, hc, -, he, hf⟩ := hsys
  obtain ⟨lm, hlm⟩ : ∃ lm : ℝ, lm = lam 0 := ⟨_, rfl⟩
  rw [← hlm]
  have hlm0 : 0 < lm := by rw [hlm]; exact (hc 0).1
  have hlm1 : lm ≤ 1 := by rw [hlm]; exact (hc 0).2
  have hb₀ : b 0 ≠ 0 := ha.ne_zero 0
  have hb₀Γ : b 0 ∈ Γ := hb 0
  have hb₀B : ∀ μ : ℝ, lm < μ → b 0 ∈ (fun x => μ • x) '' B := by rw [hlm]; exact he 0
  have hmin : ∀ (γ : D → ℝ) (μ : ℝ), γ ∈ Γ → 0 ≤ μ → μ < lm →
      γ ∈ (fun x => μ • x) '' B → γ = 0 := by
    intro γ μ hγ hμ hμl hγB
    rw [hlm] at hμl
    have h := hf 0 γ μ hγ hμ hμl hγB
    have hempty : {j : Fin (m + 1) | j < 0} = ∅ := by
      ext j
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      exact Fin.not_lt_zero j
    rw [hempty, Set.image_empty, Submodule.span_empty, Submodule.mem_bot] at h
    exact h
  
  have hint : ∀ t : ℝ, t • b 0 ∈ Γ → t = ((round t : ℤ) : ℝ) := by
    intro t ht
    obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = t - ((round t : ℤ) : ℝ) := ⟨_, rfl⟩
    have hs_abs : |s| ≤ 1 / 2 := by rw [hs_def]; exact abs_sub_round t
    have hsΓ : s • b 0 ∈ Γ := by
      have h1 : ((round t : ℤ) : ℝ) • b 0 ∈ Γ := by
        rw [Int.cast_smul_eq_zsmul]; exact Γ.zsmul_mem hb₀Γ _
      have h2 : s • b 0 = t • b 0 - ((round t : ℤ) : ℝ) • b 0 := by rw [hs_def, sub_smul]
      rw [h2]; exact Γ.sub_mem ht h1
    obtain ⟨β, hβB, hβ⟩ := hb₀B (3 * lm / 2) (by linarith)
    simp only at hβ
    have hs0 : s = 0 := by
      by_contra hne
      have hzero : s • b 0 = 0 := by
        rcases lt_or_gt_of_ne hne with hneg | hpos
        · apply hmin _ ((-s) * (3 * lm / 2)) hsΓ (by nlinarith)
            (by nlinarith [neg_le_abs s])
          refine ⟨-β, hBs β hβB, ?_⟩
          simp only
          rw [← hβ, smul_neg, smul_smul, ← neg_smul]
          congr 1; ring
        · apply hmin _ (s * (3 * lm / 2)) hsΓ (by positivity)
            (by nlinarith [le_abs_self s])
          refine ⟨β, hβB, ?_⟩
          simp only
          rw [← hβ, smul_smul]
      rcases smul_eq_zero.mp hzero with h | h
      · exact hne h
      · exact hb₀ h
    linarith
  
  have hbd : ∀ z ∈ B, ∀ z' ∈ B, ∀ t : ℝ, z - z' = t • b 0 → |t| * lm ≤ 2 := by
    intro z hz z' hz' t ht
    by_contra hcon
    push_neg at hcon
    have ht0 : t ≠ 0 := by
      rintro rfl
      simp at hcon
      linarith
    obtain ⟨w, hw_def⟩ : ∃ w : D → ℝ, w = (1 / 2 : ℝ) • z + (1 / 2 : ℝ) • (-z') := ⟨_, rfl⟩
    have hwB : w ∈ B := by
      rw [hw_def]
      exact hBc hz (hBs z' hz') (by norm_num) (by norm_num) (by norm_num)
    have h2w : (2 : ℝ) • w = t • b 0 := by
      rw [← ht, hw_def, smul_add, smul_smul, smul_smul, smul_neg]
      norm_num
      rw [sub_eq_add_neg]
    have hbw : b 0 = (2 / t) • w := by
      have h1 : b 0 = t⁻¹ • (t • b 0) := (inv_smul_smul₀ ht0 _).symm
      rw [h1, ← h2w, smul_smul, div_eq_inv_mul]
    have hcontra : b 0 = 0 := by
      rcases lt_or_gt_of_ne ht0 with hneg | hpos
      · rw [abs_of_neg hneg] at hcon
        apply hmin (b 0) (2 / (-t)) hb₀Γ (div_nonneg (by norm_num) (by linarith))
        · rw [div_lt_iff₀ (by linarith)]; linarith
        · refine ⟨-w, hBs w hwB, ?_⟩
          simp only
          rw [div_neg, neg_smul, smul_neg, neg_neg]
          exact hbw.symm
      · rw [abs_of_pos hpos] at hcon
        apply hmin (b 0) (2 / t) hb₀Γ (div_nonneg (by norm_num) hpos.le)
        · rw [div_lt_iff₀ hpos]; linarith
        · exact ⟨w, hwB, hbw.symm⟩
    exact hb₀ hcontra
  
  have hcount : ∀ (T : Finset ℝ) (L : ℝ), 0 ≤ L →
      (∀ x ∈ T, ∀ y ∈ T, ∃ n : ℤ, x - y = (n : ℝ)) →
      (∀ x ∈ T, ∀ y ∈ T, x - y ≤ L) → (T.card : ℝ) ≤ L + 1 := by
    intro T L hL hTi hTb
    rcases T.eq_empty_or_nonempty with hT | hT
    · rw [hT, Finset.card_empty, Nat.cast_zero]; linarith
    obtain ⟨x₀, hx₀T, hx₀min⟩ := T.exists_min_image id hT
    have hG : ∀ x ∈ T, ((⌊x - x₀⌋₊ : ℕ) : ℝ) = x - x₀ := by
      intro x hx
      obtain ⟨n, hn⟩ := hTi x hx x₀ hx₀T
      have hn0 : (0 : ℝ) ≤ n := by rw [← hn]; have := hx₀min x hx; simp only [id] at this; linarith
      have hn0' : 0 ≤ n := by exact_mod_cast hn0
      rw [hn]
      lift n to ℕ using hn0'
      simp
    have hcard : T.card ≤ (Finset.range (⌊L⌋₊ + 1)).card := by
      apply Finset.card_le_card_of_injOn (fun x => ⌊x - x₀⌋₊)
      · intro x hx
        simp only [Finset.coe_range, Set.mem_Iio, Finset.mem_coe] at hx ⊢
        exact Nat.lt_succ_of_le (Nat.floor_mono (hTb x hx x₀ hx₀T))
      · intro x hx y hy hxy
        simp only at hxy
        have h3 := congrArg (Nat.cast : ℕ → ℝ) hxy
        rw [hG x hx, hG y hy] at h3
        linarith
    rw [Finset.card_range] at hcard
    have h1 : (T.card : ℝ) ≤ ((⌊L⌋₊ + 1 : ℕ) : ℝ) := by exact_mod_cast hcard
    push_cast at h1
    linarith [Nat.floor_le hL]
  
  obtain ⟨c₀, hc₀⟩ : ∃ c₀, b 0 c₀ ≠ 0 := by
    by_contra h
    push_neg at h
    exact hb₀ (funext h)
  obtain ⟨φ, hφ⟩ : ∃ φ : (D → ℝ) → ℝ, ∀ x, φ x = x c₀ / b 0 c₀ := ⟨_, fun _ => rfl⟩
  have hK : ∀ z z', π z = π z' → z - z' = (φ z - φ z') • b 0 := by
    intro z z' hzz
    obtain ⟨t, ht⟩ := (hker (z - z')).mp (by rw [map_sub, hzz, sub_self])
    have hcc := congrFun ht c₀
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at hcc
    have h1 : t = φ z - φ z' := by
      rw [hφ, hφ, ← sub_div, hcc, mul_div_cancel_right₀ _ hc₀]
    rw [ht, h1]
  
  have hfib : ∀ y, ((S.filter (fun z => π z = y)).card : ℝ) * lm ≤ 3 := by
    intro y
    have hFmem : ∀ z ∈ S.filter (fun z => π z = y), z ∈ Γ ∧ z ∈ B ∧ π z = y := by
      intro z hz
      rw [Finset.mem_filter] at hz
      exact ⟨(hS z hz.1).1, (hS z hz.1).2, hz.2⟩
    have hpp : ∀ z ∈ S.filter (fun z => π z = y), ∀ z' ∈ S.filter (fun z => π z = y),
        π z = π z' := by
      intro z hz z' hz'
      rw [(hFmem z hz).2.2, (hFmem z' hz').2.2]
    have hinj : Set.InjOn φ (S.filter (fun z => π z = y) : Set (D → ℝ)) := by
      intro z hz z' hz' hφe
      have h1 := hK z z' (hpp z hz z' hz')
      rw [hφe, sub_self, zero_smul] at h1
      exact sub_eq_zero.mp h1
    have hcardeq : ((S.filter (fun z => π z = y)).image φ).card
        = (S.filter (fun z => π z = y)).card := Finset.card_image_of_injOn hinj
    have hT := hcount ((S.filter (fun z => π z = y)).image φ) (2 / lm) (by positivity) ?_ ?_
    · rw [hcardeq] at hT
      have h2 := mul_le_mul_of_nonneg_right hT hlm0.le
      rw [add_mul, div_mul_cancel₀ _ hlm0.ne', one_mul] at h2
      linarith
    · intro x hx x' hx'
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨z', hz', rfl⟩ := Finset.mem_image.mp hx'
      refine ⟨round (φ z - φ z'), hint _ ?_⟩
      rw [← hK z z' (hpp z hz z' hz')]
      exact Γ.sub_mem (hFmem z hz).1 (hFmem z' hz').1
    · intro x hx x' hx'
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨z', hz', rfl⟩ := Finset.mem_image.mp hx'
      have h1 := hbd z (hFmem z hz).2.1 z' (hFmem z' hz').2.1 _ (hK z z' (hpp z hz z' hz'))
      rw [le_div_iff₀ hlm0]
      calc (φ z - φ z') * lm ≤ |φ z - φ z'| * lm :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hlm0.le
        _ ≤ 2 := h1
  
  have hsum := Finset.card_eq_sum_card_image π S
  have hS' : (S.card : ℝ) * lm
      = ∑ y ∈ S.image π, ((S.filter (fun z => π z = y)).card : ℝ) * lm := by
    rw [hsum]
    push_cast
    rw [Finset.sum_mul]
  rw [hS']
  calc _ ≤ ∑ y ∈ S.image π, (3 : ℝ) := Finset.sum_le_sum (fun y _ => hfib y)
    _ = 3 * ((S.image π).card : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_comm]

theorem vb_counting_bound (D : Type) [Fintype D] [DecidableEq D] :
    ∀ (k : ℕ) (Γ : AddSubgroup (D → ℝ)) (B : Set (D → ℝ)), Convex ℝ B → (∀ x ∈ B, -x ∈ B) →
      (0 : D → ℝ) ∈ B →
      (∀ c : ℝ, 0 ≤ c → Set.Finite {x | x ∈ Γ ∧ x ∈ (fun y => c • y) '' B}) →
      ∀ (b : Fin k → D → ℝ) (lam : Fin k → ℝ), vbMinSys Γ B k b lam →
      (∀ γ ∈ Γ, γ ∈ Submodule.span ℝ (Set.range b)) →
      ∀ S : Finset (D → ℝ), (∀ z ∈ S, z ∈ Γ ∧ z ∈ B) →
        (S.card : ℝ) * ∏ i, lam i ≤ 3 ^ k * 2 ^ (k * (k - 1)) :=
by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k IH =>
  rcases k with _ | m
  · 
    intro Γ B _ _ _ _ b lam _ hspan S hS
    have hS0 : ∀ z ∈ S, z = 0 := by
      intro z hz
      have h := hspan z (hS z hz).1
      rw [Set.range_eq_empty, Submodule.span_empty, Submodule.mem_bot] at h
      exact h
    have hcard : S.card ≤ 1 :=
      Finset.card_le_one.2 (fun a ha c hc => by rw [hS0 a ha, hS0 c hc])
    have hcard' : (S.card : ℝ) ≤ 1 := by exact_mod_cast hcard
    simpa using hcard'
  · 
    intro Γ B hBc hBs hB0 hfin b lam hsys hspan S hS
    have hsys0 := hsys
    obtain ⟨ha, hb, hc, hd, he, hf⟩ := hsys0
    have hb0 : b 0 ≠ 0 := ha.ne_zero 0
    
    obtain ⟨π, hker⟩ : ∃ π : (D → ℝ) →ₗ[ℝ] (D → ℝ), ∀ x, π x = 0 ↔ ∃ t : ℝ, x = t • b 0 := by
      obtain ⟨c₀, hc₀⟩ := Function.ne_iff.1 hb0
      have hc₀' : b 0 c₀ ≠ 0 := by simpa using hc₀
      refine ⟨LinearMap.id - LinearMap.smulRight
        ((b 0 c₀)⁻¹ • (LinearMap.proj c₀ : (D → ℝ) →ₗ[ℝ] ℝ)) (b 0), ?_⟩
      intro x
      simp only [LinearMap.sub_apply, LinearMap.id_apply, LinearMap.smulRight_apply,
        LinearMap.smul_apply, LinearMap.proj_apply, smul_eq_mul]
      constructor
      · intro h; exact ⟨_, sub_eq_zero.1 h⟩
      · rintro ⟨t, rfl⟩
        have e : (b 0 c₀)⁻¹ * (t • b 0) c₀ = t := by
          simp only [Pi.smul_apply, smul_eq_mul]; field_simp
        rw [e, sub_self]
    
    have hBc' : Convex ℝ (⇑π '' B) := hBc.linear_image π
    have hBs' : ∀ x ∈ ⇑π '' B, -x ∈ ⇑π '' B := by
      rintro x ⟨β, hβ, rfl⟩
      exact ⟨-β, hBs β hβ, map_neg π β⟩
    have hB0' : (0 : D → ℝ) ∈ ⇑π '' B := ⟨0, hB0, map_zero π⟩
    
    have hb0B2 : b 0 ∈ (fun x => (2 : ℝ) • x) '' B := he 0 2 (by linarith [(hc 0).2])
    have hfin' : ∀ c : ℝ, 0 ≤ c →
        Set.Finite {y | y ∈ Γ.map π.toAddMonoidHom ∧ y ∈ (fun x => c • x) '' (⇑π '' B)} := by
      intro c hc0
      refine ((hfin (c + 1) (by linarith)).image π).subset ?_
      rintro y ⟨hyΓ, y', ⟨β₀, hβ₀, rfl⟩, rfl⟩
      obtain ⟨γ, hγ, hγy⟩ := AddSubgroup.mem_map.1 hyΓ
      have hγy' : π γ = π (c • β₀) := by rw [map_smul]; exact hγy
      obtain ⟨w, hwΓ, hwπ, hwB⟩ := vb_proj_lift D Γ B hBc hBs hB0 (b 0) (hb 0) π hker c 2 hc0
        (by norm_num) hb0B2 γ (c • β₀) hγ ⟨β₀, hβ₀, rfl⟩ hγy'
      have e2 : c + (2 : ℝ) / 2 = c + 1 := by norm_num
      rw [e2] at hwB
      refine ⟨w, ⟨hwΓ, hwB⟩, ?_⟩
      rw [hwπ, hγy', map_smul]
    have hfin1' : Set.Finite {y | y ∈ Γ.map π.toAddMonoidHom ∧ y ∈ ⇑π '' B} := by
      refine (hfin' 1 zero_le_one).subset ?_
      rintro y ⟨h1, h2⟩
      exact ⟨h1, y, h2, one_smul ℝ y⟩
    
    obtain ⟨k', b', μ, hsys', hcov⟩ := vb_minima_exist D (Γ.map π.toAddMonoidHom) (⇑π '' B)
      hBc' hBs' hB0' hfin1'
    
    obtain ⟨hk', hcmp⟩ := vb_proj_compare D Γ B hBc hBs hB0 m b lam hsys hspan π hker k' b' μ
      hsys'.1 hsys'.2.1 hsys'.2.2.2.1 hsys'.2.2.2.2.1
    
    obtain ⟨Γ'', hΓ''⟩ : ∃ Γ'' : AddSubgroup (D → ℝ),
        Γ'' = Γ.map π.toAddMonoidHom ⊓ (Submodule.span ℝ (Set.range b')).toAddSubgroup :=
      ⟨_, rfl⟩
    have hmemΓ'' : ∀ y, y ∈ Γ'' ↔
        y ∈ Γ.map π.toAddMonoidHom ∧ y ∈ Submodule.span ℝ (Set.range b') := by
      intro y; rw [hΓ'', AddSubgroup.mem_inf, Submodule.mem_toAddSubgroup]
    obtain ⟨hli', hbΓ', hμ', hmono', hmem', hmin'⟩ := hsys'
    have hsys'' : vbMinSys Γ'' (⇑π '' B) k' b' μ := by
      refine ⟨hli', fun i => (hmemΓ'' _).2 ⟨hbΓ' i, Submodule.subset_span ⟨i, rfl⟩⟩, hμ',
        hmono', hmem', ?_⟩
      intro i γ ν hγ hν hνl hγB
      exact hmin' i γ ν ((hmemΓ'' γ).1 hγ).1 hν hνl hγB
    have hfin'' : ∀ c : ℝ, 0 ≤ c →
        Set.Finite {y | y ∈ Γ'' ∧ y ∈ (fun x => c • x) '' (⇑π '' B)} := by
      intro c hc0
      refine (hfin' c hc0).subset ?_
      rintro y ⟨hy, hy'⟩
      exact ⟨((hmemΓ'' y).1 hy).1, hy'⟩
    have hspan'' : ∀ y ∈ Γ'', y ∈ Submodule.span ℝ (Set.range b') :=
      fun y hy => ((hmemΓ'' y).1 hy).2
    have hS' : ∀ y ∈ S.image π, y ∈ Γ'' ∧ y ∈ ⇑π '' B := by
      intro y hy
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hy
      have h1 : π z ∈ Γ.map π.toAddMonoidHom := AddSubgroup.mem_map_of_mem _ (hS z hz).1
      have h2 : π z ∈ ⇑π '' B := Set.mem_image_of_mem _ (hS z hz).2
      exact ⟨(hmemΓ'' _).2 ⟨h1, hcov _ h1 h2⟩, h2⟩
    
    have hIH := IH k' (by omega) Γ'' (⇑π '' B) hBc' hBs' hB0' hfin'' b' μ hsys'' hspan''
      (S.image π) hS'
    
    have hF := vb_fibre_count D Γ B hBc hBs hB0 m b lam hsys π hker S hS
    
    have hP : ∏ i : Fin m, lam i.succ ≤ 2 ^ m * ∏ i, μ i := by
      let f : ℕ → ℝ := fun n => if h : n + 1 < m + 1 then lam ⟨n + 1, h⟩ else 1
      let g : ℕ → ℝ := fun n => if h : n < k' then 2 * μ ⟨n, h⟩ else 1
      have hf01 : ∀ n, 0 ≤ f n ∧ f n ≤ 1 := by
        intro n
        simp only [f]
        split_ifs with h
        · exact ⟨(hc _).1.le, (hc _).2⟩
        · exact ⟨zero_le_one, le_rfl⟩
      have h1 : ∏ i : Fin m, lam i.succ = ∏ n ∈ Finset.range m, f n := by
        rw [← Fin.prod_univ_eq_prod_range]
        refine Finset.prod_congr rfl (fun i _ => ?_)
        simp only [f, dif_pos (show (i : ℕ) + 1 < m + 1 by omega)]
        rfl
      have h2 : ∏ n ∈ Finset.range m, f n ≤ ∏ n ∈ Finset.range k', f n := by
        rw [← Finset.prod_range_mul_prod_Ico f hk']
        have hA : 0 ≤ ∏ n ∈ Finset.range k', f n :=
          Finset.prod_nonneg (fun n _ => (hf01 n).1)
        have hB : ∏ n ∈ Finset.Ico k' m, f n ≤ 1 :=
          Finset.prod_le_one (fun n _ => (hf01 n).1) (fun n _ => (hf01 n).2)
        calc (∏ n ∈ Finset.range k', f n) * ∏ n ∈ Finset.Ico k' m, f n
            ≤ (∏ n ∈ Finset.range k', f n) * 1 := mul_le_mul_of_nonneg_left hB hA
          _ = ∏ n ∈ Finset.range k', f n := mul_one _
      have h3 : ∏ n ∈ Finset.range k', f n ≤ ∏ n ∈ Finset.range k', g n := by
        apply Finset.prod_le_prod (fun n _ => (hf01 n).1)
        intro n hn
        have hn' : n < k' := Finset.mem_range.1 hn
        have hn2 : n + 1 < m + 1 := by omega
        simp only [f, g, dif_pos hn', dif_pos hn2]
        exact hcmp ⟨n, hn'⟩ hn2
      have h4 : ∏ n ∈ Finset.range k', g n = 2 ^ k' * ∏ i, μ i := by
        rw [← Fin.prod_univ_eq_prod_range]
        have e : ∀ i : Fin k', g i = 2 * μ i := fun i => by
          simp only [g, dif_pos i.isLt, Fin.eta]
        simp only [e]
        rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      have h5 : (2 : ℝ) ^ k' ≤ 2 ^ m := pow_le_pow_right₀ (by norm_num) hk'
      have hQ0 : 0 ≤ ∏ i, μ i := Finset.prod_nonneg (fun i _ => (hμ' i).1.le)
      calc ∏ i : Fin m, lam i.succ = ∏ n ∈ Finset.range m, f n := h1
        _ ≤ ∏ n ∈ Finset.range k', g n := h2.trans h3
        _ = 2 ^ k' * ∏ i, μ i := h4
        _ ≤ 2 ^ m * ∏ i, μ i := mul_le_mul_of_nonneg_right h5 hQ0
    
    have hP0 : 0 ≤ ∏ i : Fin m, lam i.succ := Finset.prod_nonneg (fun i _ => (hc _).1.le)
    have hQ0 : 0 ≤ ∏ i, μ i := Finset.prod_nonneg (fun i _ => (hμ' i).1.le)
    have h3k : (3 : ℝ) ^ k' ≤ 3 ^ m := pow_le_pow_right₀ (by norm_num) hk'
    have h2k : (2 : ℝ) ^ (k' * (k' - 1)) ≤ 2 ^ (m * (m - 1)) :=
      pow_le_pow_right₀ (by norm_num) (Nat.mul_le_mul hk' (Nat.sub_le_sub_right hk' 1))
    have hexp : m + m * (m - 1) ≤ (m + 1) * (m + 1 - 1) := by
      have h := Nat.mul_le_mul_left m (Nat.sub_le m 1)
      have e : (m + 1) * (m + 1 - 1) = m + m * m := by
        rw [Nat.add_sub_cancel]; ring
      rw [e]; omega
    have h2e : (2 : ℝ) ^ (m + m * (m - 1)) ≤ 2 ^ ((m + 1) * (m + 1 - 1)) :=
      pow_le_pow_right₀ (by norm_num) hexp
    rw [Fin.prod_univ_succ]
    calc (S.card : ℝ) * (lam 0 * ∏ i : Fin m, lam i.succ)
        = ((S.card : ℝ) * lam 0) * ∏ i : Fin m, lam i.succ := by ring
      _ ≤ (3 * ((S.image π).card : ℝ)) * ∏ i : Fin m, lam i.succ :=
          mul_le_mul_of_nonneg_right hF hP0
      _ ≤ (3 * ((S.image π).card : ℝ)) * (2 ^ m * ∏ i, μ i) :=
          mul_le_mul_of_nonneg_left hP (by positivity)
      _ = 3 * 2 ^ m * (((S.image π).card : ℝ) * ∏ i, μ i) := by ring
      _ ≤ 3 * 2 ^ m * (3 ^ k' * 2 ^ (k' * (k' - 1))) :=
          mul_le_mul_of_nonneg_left hIH (by positivity)
      _ ≤ 3 * 2 ^ m * (3 ^ m * 2 ^ (m * (m - 1))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul h3k h2k (by positivity) (by positivity))
            (by positivity)
      _ = 3 ^ (m + 1) * 2 ^ (m + m * (m - 1)) := by rw [pow_succ, pow_add]; ring
      _ ≤ 3 ^ (m + 1) * 2 ^ ((m + 1) * (m + 1 - 1)) :=
          mul_le_mul_of_nonneg_left h2e (by positivity)

theorem vb_gap_from_minima (D : Type) [Fintype D] [DecidableEq D] (B : Set (D → ℝ))
    (hBc : Convex ℝ B) (hBs : ∀ x ∈ B, -x ∈ B) (hB0 : (0 : D → ℝ) ∈ B)
    (k : ℕ) (b : Fin k → D → ℝ) (lam : Fin k → ℝ) (hb : LinearIndependent ℝ b)
    (hlam : ∀ i, 0 < lam i) (hmem : ∀ i (μ : ℝ), lam i < μ → b i ∈ (fun x => μ • x) '' B) :
    ∃ (d' : ℕ) (v : Fin d' → D → ℝ) (L : Fin d' → ℕ),
      LinearIndependent ℝ v ∧ (∀ i, ∃ j, v i = b j) ∧ (∀ i, 1 ≤ L i) ∧
      (∀ ℓ : Fin d' → ℤ, (∀ i, |ℓ i| ≤ (L i : ℤ)) → ∑ i, (ℓ i : ℝ) • v i ∈ B) ∧
      1 ≤ (2 * (k : ℝ)) ^ k * (∏ j, lam j) * ∏ i, (2 * (L i : ℝ) + 1) :=
by
  classical
  
  have hcomb : ∀ (n : ℕ) (w : Fin n → D → ℝ) (c : Fin n → ℝ), (∀ i, w i ∈ B) →
      ∑ i, |c i| ≤ 1 → ∑ i, c i • w i ∈ B := by
    intro n w c hw hc
    obtain ⟨u, hu_def⟩ : ∃ u : Fin n → D → ℝ,
        u = fun i => if 0 ≤ c i then w i else -w i := ⟨_, rfl⟩
    have hu : ∀ i, u i ∈ B := by
      intro i
      rw [hu_def]
      dsimp only
      split_ifs
      · exact hw i
      · exact hBs _ (hw i)
    have hcu : ∀ i, c i • w i = |c i| • u i := by
      intro i
      rw [hu_def]
      dsimp only
      split_ifs with h
      · rw [abs_of_nonneg h]
      · rw [abs_of_neg (not_le.mp h), neg_smul_neg]
    have hsum : ∑ i, c i • w i = ∑ i, |c i| • u i :=
      Finset.sum_congr rfl (fun i _ => hcu i)
    rw [hsum]
    have hs0 : 0 ≤ ∑ i, |c i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
    rcases hs0.lt_or_eq with hspos | hszero
    · have hy : ∑ i, (|c i| / ∑ i, |c i|) • u i ∈ B := by
        apply hBc.sum_mem
        · intro i _; exact div_nonneg (abs_nonneg _) hs0
        · rw [← Finset.sum_div]; exact div_self hspos.ne'
        · intro i _; exact hu i
      have h2 := hBc.smul_mem_of_zero_mem hB0 hy ⟨hs0, hc⟩
      rw [Finset.smul_sum] at h2
      convert h2 using 2 with i
      rw [smul_smul, mul_div_cancel₀ _ hspos.ne']
    · have hall : ∀ i ∈ (Finset.univ : Finset (Fin n)), |c i| = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => abs_nonneg (c i))).1 hszero.symm
      rw [Finset.sum_eq_zero (fun i hi => by rw [hall i hi, zero_smul])]
      exact hB0
  rcases Nat.eq_zero_or_pos k with hk0 | hkpos
  · subst hk0
    refine ⟨0, fun i => i.elim0, fun i => i.elim0, linearIndependent_empty_type,
      fun i => i.elim0, fun i => i.elim0, ?_, ?_⟩
    · intro ℓ _
      simpa using hB0
    · simp
  have hkR : (0 : ℝ) < k := by exact_mod_cast hkpos
  obtain ⟨L', hL'⟩ : ∃ L' : Fin k → ℕ, ∀ j, L' j = ⌊1 / (2 * (k : ℝ) * lam j)⌋₊ :=
    ⟨fun j => ⌊1 / (2 * (k : ℝ) * lam j)⌋₊, fun _ => rfl⟩
  have hfl : ∀ j, 2 * lam j * (L' j : ℝ) ≤ 1 / (k : ℝ) ∧
      1 ≤ 2 * (k : ℝ) * lam j * (2 * (L' j : ℝ) + 1) := by
    intro j
    have hl := hlam j
    have ha : 0 < 2 * (k : ℝ) * lam j := by positivity
    have hx0 : 0 ≤ 1 / (2 * (k : ℝ) * lam j) := by positivity
    have h1 := Nat.floor_le hx0
    have h2 := Nat.lt_floor_add_one (1 / (2 * (k : ℝ) * lam j))
    rw [← hL' j] at h1 h2
    have hax : 2 * (k : ℝ) * lam j * (1 / (2 * (k : ℝ) * lam j)) = 1 :=
      mul_one_div_cancel ha.ne'
    have hf0 : (0 : ℝ) ≤ (L' j : ℝ) := Nat.cast_nonneg _
    constructor
    · have heq : 2 * lam j * (1 / (2 * (k : ℝ) * lam j)) = 1 / k := by
        field_simp
      calc 2 * lam j * (L' j : ℝ) ≤ 2 * lam j * (1 / (2 * (k : ℝ) * lam j)) :=
            mul_le_mul_of_nonneg_left h1 (by linarith)
        _ = 1 / k := heq
    · calc (1 : ℝ) = 2 * (k : ℝ) * lam j * (1 / (2 * (k : ℝ) * lam j)) := hax.symm
        _ ≤ 2 * (k : ℝ) * lam j * (2 * (L' j : ℝ) + 1) :=
            mul_le_mul_of_nonneg_left (by linarith) ha.le
  obtain ⟨J, hJ⟩ : ∃ J : Finset (Fin k), J = Finset.univ.filter (fun j => 1 ≤ L' j) :=
    ⟨_, rfl⟩
  have hJmem : ∀ j, j ∈ J ↔ 1 ≤ L' j := by
    intro j; rw [hJ]; simp
  have hJcard : J.card ≤ k := by simpa using Finset.card_le_univ J
  refine ⟨J.card, fun i => b (J.orderEmbOfFin rfl i), fun i => L' (J.orderEmbOfFin rfl i),
    ?_, ?_, ?_, ?_, ?_⟩
  · exact hb.comp _ (J.orderEmbOfFin rfl).injective
  · exact fun i => ⟨_, rfl⟩
  · intro i
    exact (hJmem _).1 (J.orderEmbOfFin_mem rfl i)
  · intro ℓ hℓ
    have hw : ∀ i : Fin J.card, ∃ y, y ∈ B ∧
        (2 * lam (J.orderEmbOfFin rfl i)) • y = b (J.orderEmbOfFin rfl i) := by
      intro i
      have hl := hlam (J.orderEmbOfFin rfl i)
      exact hmem _ _ (by linarith)
    choose w hwB hwe using hw
    have heq : ∑ i, (ℓ i : ℝ) • b (J.orderEmbOfFin rfl i)
        = ∑ i, ((ℓ i : ℝ) * (2 * lam (J.orderEmbOfFin rfl i))) • w i :=
      Finset.sum_congr rfl (fun i _ => by rw [← hwe i, smul_smul])
    show ∑ i, (ℓ i : ℝ) • b (J.orderEmbOfFin rfl i) ∈ B
    rw [heq]
    apply hcomb _ w _ hwB
    calc ∑ i, |(ℓ i : ℝ) * (2 * lam (J.orderEmbOfFin rfl i))|
        ≤ ∑ _i : Fin J.card, 1 / (k : ℝ) := by
          apply Finset.sum_le_sum
          intro i _
          have hl := hlam (J.orderEmbOfFin rfl i)
          have hli : |(ℓ i : ℝ)| ≤ (L' (J.orderEmbOfFin rfl i) : ℝ) := by
            have := hℓ i
            exact_mod_cast this
          rw [abs_mul, abs_of_pos (by linarith : (0 : ℝ) < 2 * lam (J.orderEmbOfFin rfl i))]
          calc |(ℓ i : ℝ)| * (2 * lam (J.orderEmbOfFin rfl i))
              ≤ (L' (J.orderEmbOfFin rfl i) : ℝ) * (2 * lam (J.orderEmbOfFin rfl i)) :=
                mul_le_mul_of_nonneg_right hli (by linarith)
            _ = 2 * lam (J.orderEmbOfFin rfl i) * (L' (J.orderEmbOfFin rfl i) : ℝ) := by ring
            _ ≤ 1 / k := (hfl _).1
      _ = (J.card : ℝ) * (1 / k) := by simp
      _ ≤ (k : ℝ) * (1 / k) :=
          mul_le_mul_of_nonneg_right (by exact_mod_cast hJcard) (by positivity)
      _ = 1 := by field_simp
  · have hprod1 : (1 : ℝ) ≤ ∏ j, (2 * (k : ℝ) * lam j * (2 * (L' j : ℝ) + 1)) := by
      calc (1 : ℝ) = ∏ _j : Fin k, (1 : ℝ) := by simp
        _ ≤ _ := Finset.prod_le_prod (fun _ _ => zero_le_one) (fun j _ => (hfl j).2)
    have hsplit : ∏ j, (2 * (k : ℝ) * lam j * (2 * (L' j : ℝ) + 1))
        = (2 * (k : ℝ)) ^ k * (∏ j, lam j) * ∏ j, (2 * (L' j : ℝ) + 1) := by
      rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const,
        Finset.card_univ, Fintype.card_fin]
    have h1 : ∏ j ∈ J, (2 * (L' j : ℝ) + 1) = ∏ j, (2 * (L' j : ℝ) + 1) := by
      apply Finset.prod_subset (Finset.subset_univ J)
      intro x _ hx
      have : L' x = 0 := by
        rw [hJmem] at hx
        omega
      simp [this]
    have hre : ∏ j, (2 * (L' j : ℝ) + 1)
        = ∏ i : Fin J.card, (2 * (L' (J.orderEmbOfFin rfl i) : ℝ) + 1) := by
      calc ∏ j, (2 * (L' j : ℝ) + 1) = ∏ j ∈ J, (2 * (L' j : ℝ) + 1) := h1.symm
        _ = ∏ x ∈ Finset.univ.map (J.orderEmbOfFin rfl).toEmbedding,
              (2 * (L' x : ℝ) + 1) := by rw [Finset.map_orderEmbOfFin_univ]
        _ = _ := Finset.prod_map _ _ _
    rw [hsplit, hre] at hprod1
    exact hprod1

theorem kai_vb_gap_lemma (D : Type) [Fintype D] [DecidableEq D] (d : ℕ) (hd : Fintype.card D = d)
    (Γ : AddSubgroup (D → ℝ)) (R : Finset (D → ℝ))
    (hR : ∀ γ ∈ Γ, ∃ ρ ∈ R, ∃ m : D → ℤ, γ = ρ + fun x => (m x : ℝ))
    (r : ℕ) (a : Fin r → D → ℝ) (κ : ℝ) (hκ : 0 ≤ κ) :
    ∃ (d' : ℕ) (v : Fin d' → D → ℝ) (L : Fin d' → ℕ),
      LinearIndependent ℝ v ∧ (∀ i, v i ∈ Γ) ∧ (∀ i, 1 ≤ L i) ∧
      (∀ ℓ : Fin d' → ℤ, (∀ i, |ℓ i| ≤ (L i : ℤ)) →
        (∀ x, |∑ i, (ℓ i : ℝ) * v i x| ≤ 1 / 2) ∧
