theorem kai_tb_box_finite (K : Type u) [Field K] [NumberField K]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e)
    (α : NumberField.RingOfIntegers K)
    (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (u γ : Fin (NumberField.Units.rank K) → ℝ)
    (vv ϑ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ) (x : ℝ) :
    {π : NumberField.RingOfIntegers K | KaiTBMem K q H e α sgn u γ vv ϑ x π}.Finite :=
by
  classical
  
  have hident : ∀ y : K, y ≠ 0 → ∀ w : NumberField.InfinitePlace K,
      Real.log (w y)
