    have e2 : Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (((t.val : ℝ) / P : ℝ) : ℂ))
        = Complex.exp (Complex.I * ((2 * Real.pi * ((t.val : ℝ) / P - 1) : ℝ) : ℂ)) := by
