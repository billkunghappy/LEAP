  obtain ⟨k', hk'rows, hk'ker⟩ := kai_v_si_rows a r k
  refine ⟨e, he𝔡, he0, heX, k', ?_, ?_, ?_⟩
  · intro m i
    rcases hk'rows m with ⟨m₀, hm₀⟩ | h0
    · rw [hm₀]; exact (hkX m₀ i).trans hc2
    · rw [h0]; simp only [Pi.zero_apply, Int.cast_zero, abs_zero]; exact hX₇pos.le
