      have hinf : kaiInfSize K t l = 1 := hinf_zero ht hl
      have hzG : G (β' : ℂ) = 0 := by rw [← hident hnp' G' hG' heq]; exact hz
      have hre : (β' : ℂ).re ≤ 2 := by rw [Complex.ofReal_re]; linarith
      have hle : 1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
          * (2 + |(β' : ℂ).im|)) ≤ (β' : ℂ).re := by
        rw [hexpr hinf β', Complex.ofReal_re]; linarith [hBL]
      obtain ⟨hm0, h2⟩ := hZ (β' : ℂ) hre hle hzG
