      exact him
    linarith
  refine ⟨funext fun w => ?_, funext fun p => ?_⟩
  · show t w = 0
    by_contra htw
    refine main ?_
    have hm : (0:ℝ) < (w.mult : ℝ) := by
      exact_mod_cast NumberField.InfinitePlace.mult_pos
    have hne : ((w.mult : ℝ) * t w) ≠ 0 := mul_ne_zero (ne_of_gt hm) htw
    have hsq : (0:ℝ) < ((w.mult : ℝ) * t w) ^ 2 := pow_two_pos_of_ne_zero hne
    have hle : ((w.mult : ℝ) * t w) ^ 2 ≤ A := by
      rw [hAdef]
      exact Finset.single_le_sum
        (f := fun w : NumberField.InfinitePlace K => ((w.mult : ℝ) * t w) ^ 2)
        (fun i _ => sq_nonneg _) (Finset.mem_univ w)
    linarith
  · show l p = 0
    by_contra hlp
    refine main ?_
    have hne : ((l p : ℝ)) ≠ 0 := by exact_mod_cast hlp
    have hsq : (0:ℝ) < ((l p : ℝ)) ^ 2 := pow_two_pos_of_ne_zero hne
    have hle : ((l p : ℝ)) ^ 2 ≤ Bq := by
      rw [hBdef]
      exact Finset.single_le_sum
        (f := fun p : {w : NumberField.InfinitePlace K // w.IsComplex} => ((l p : ℝ)) ^ 2)
        (fun i _ => sq_nonneg _) (Finset.mem_univ p)
