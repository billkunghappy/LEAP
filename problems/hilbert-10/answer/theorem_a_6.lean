  have hdeg : ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
      rdeg P ≤ Module.finrank ℚ K := by
    intro P hP hP0
    obtain ⟨hp, hf1, hNP⟩ := hcol1 P hP hP0
    have hmem : ((Ideal.absNorm P : ℕ) : NumberField.RingOfIntegers K) ∈ P :=
