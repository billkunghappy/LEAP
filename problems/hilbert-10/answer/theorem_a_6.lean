        (3 * (Kq * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) + c₂) * T := by ring
    _ ≤ c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) := hfin2

theorem kai_tb_cell_cube_decomp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e)
    (α : NumberField.RingOfIntegers K) (X : ℝ) (hX : 1 ≤ X)
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hab : ∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X)
    (hρσ : ∀ p, 0 ≤ ρ p ∧ ρ p < σ p ∧ σ p ≤ X)
    (l : ℕ) (hl : 1 ≤ l) (T : ℝ) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
            π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ)},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      = ∑ i ∈ Finset.Icc
            (fun _ => -(⌈(l : ℝ) * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
                * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X) + (l : ℝ)⌉₊ : ℤ))
            (fun _ => (⌈(l : ℝ) * (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
                * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X) + (l : ℝ)⌉₊ : ℤ)),
          ∑' π : {π : NumberField.RingOfIntegers K //
              (Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
                π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ)) ∧
              ∀ j, kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
                ∈ Set.Ioc ((i j : ℝ) / (l : ℝ)) ((i j : ℝ) / (l : ℝ) + 1 / (l : ℝ))},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) :=
by
  classical
  have hL : (0 : ℝ) < (l : ℝ) := by exact_mod_cast (show 0 < l by omega)
  have hl1 : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
  
  have key : ∀ (P : NumberField.RingOfIntegers K → Prop)
      (Q : (Fin (NumberField.Units.rank K) → ℤ) → NumberField.RingOfIntegers K → Prop)
      (f : NumberField.RingOfIntegers K → ℝ)
      (I : Finset (Fin (NumberField.Units.rank K) → ℤ)),
      {x | P x}.Finite → (∀ x, P x → ∃! i, i ∈ I ∧ Q i x) →
      (∑' x : {x // P x}, f x) = ∑ i ∈ I, ∑' x : {x // P x ∧ Q i x}, f x := by
    intro P Q f I hfin hpart
    have hconv : ∀ (R : NumberField.RingOfIntegers K → Prop) [DecidablePred R],
        (∀ x, R x → P x) →
        (∑' x : {x // R x}, f x) = ∑ x ∈ hfin.toFinset, if R x then f x else 0 := by
      intro R _ hR
      have e : ∀ x, x ∈ hfin.toFinset.filter R ↔ R x := fun x => by
        rw [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
        exact ⟨fun h => h.2, fun h => ⟨hR x h, h⟩⟩
      rw [← Finset.sum_filter, ← Finset.tsum_subtype]
      exact (Equiv.tsum_eq (Equiv.subtypeEquivRight e) (fun b : {x // R x} => f b)).symm
    calc (∑' x : {x // P x}, f x)
        = ∑ x ∈ hfin.toFinset, if P x then f x else 0 := hconv P (fun _ h => h)
      _ = ∑ x ∈ hfin.toFinset, ∑ i ∈ I, if P x ∧ Q i x then f x else 0 := by
          refine Finset.sum_congr rfl (fun x hx => ?_)
          have hPx : P x := (Set.Finite.mem_toFinset hfin).1 hx
          obtain ⟨i₀, ⟨hi₀, hQ₀⟩, huniq⟩ := hpart x hPx
          rw [if_pos hPx, Finset.sum_eq_single_of_mem i₀ hi₀
            (fun i hi hne => if_neg (fun h => hne (huniq i ⟨hi, h.2⟩))), if_pos ⟨hPx, hQ₀⟩]
      _ = ∑ i ∈ I, ∑ x ∈ hfin.toFinset, if P x ∧ Q i x then f x else 0 := Finset.sum_comm
      _ = ∑ i ∈ I, ∑' x : {x // P x ∧ Q i x}, f x :=
          Finset.sum_congr rfl (fun i _ => (hconv (fun x => P x ∧ Q i x) (fun _ h => h.1)).symm)
  
  have hiff : ∀ (z : ℤ) (t : ℝ),
      t ∈ Set.Ioc ((z : ℝ) / (l : ℝ)) ((z : ℝ) / (l : ℝ) + 1 / (l : ℝ)) ↔
        ⌈(l : ℝ) * t⌉ = z + 1 := by
    intro z t
    rw [Int.ceil_eq_iff, Set.mem_Ioc, div_add_div_same, div_lt_iff₀ hL, le_div_iff₀ hL]
    push_cast
    constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith [mul_comm t (l : ℝ)]
  have hcube : ∀ (W : ℝ) (y : Fin (NumberField.Units.rank K) → ℝ), (∀ j, |y j| ≤ W) →
      ∃! i : Fin (NumberField.Units.rank K) → ℤ,
        i ∈ Finset.Icc (fun _ => -(⌈(l : ℝ) * W + (l : ℝ)⌉₊ : ℤ))
          (fun _ => (⌈(l : ℝ) * W + (l : ℝ)⌉₊ : ℤ)) ∧
        ∀ j, y j ∈ Set.Ioc ((i j : ℝ) / (l : ℝ)) ((i j : ℝ) / (l : ℝ) + 1 / (l : ℝ)) := by
    intro W y hy
    have hM : (l : ℝ) * W + l ≤ ((⌈(l : ℝ) * W + (l : ℝ)⌉₊ : ℕ) : ℝ) := Nat.le_ceil _
    refine ⟨fun j => ⌈(l : ℝ) * y j⌉ - 1,
      ⟨?_, fun j => (hiff _ _).2 (sub_add_cancel _ _).symm⟩, ?_⟩
    · refine Finset.mem_Icc.2 ⟨Pi.le_def.2 (fun j => ?_), Pi.le_def.2 (fun j => ?_)⟩
      · have h2 := Int.le_ceil ((l : ℝ) * y j)
        have h4 : -((l : ℝ) * W) ≤ (l : ℝ) * y j := by
          nlinarith [(abs_le.1 (hy j)).1, hL.le]
        have h5 : -((⌈(l : ℝ) * W + (l : ℝ)⌉₊ : ℕ) : ℝ)
            ≤ ((⌈(l : ℝ) * y j⌉ : ℤ) : ℝ) - 1 := by linarith
        show -((⌈(l : ℝ) * W + (l : ℝ)⌉₊ : ℕ) : ℤ) ≤ ⌈(l : ℝ) * y j⌉ - 1
        exact_mod_cast h5
      · have h1 := Int.ceil_lt_add_one ((l : ℝ) * y j)
        have h3 : (l : ℝ) * y j ≤ (l : ℝ) * W :=
          mul_le_mul_of_nonneg_left (abs_le.1 (hy j)).2 hL.le
        have h5 : ((⌈(l : ℝ) * y j⌉ : ℤ) : ℝ) - 1
            ≤ ((⌈(l : ℝ) * W + (l : ℝ)⌉₊ : ℕ) : ℝ) := by linarith
        show ⌈(l : ℝ) * y j⌉ - 1 ≤ ((⌈(l : ℝ) * W + (l : ℝ)⌉₊ : ℕ) : ℤ)
        exact_mod_cast h5
    · rintro i' ⟨-, hi'⟩
      funext j
      have h := (hiff _ _).1 (hi' j)
      show i' j = ⌈(l : ℝ) * y j⌉ - 1
      omega
  
  have hplace : ∀ x : K, NumberField.mixedEmbedding K x ∈ kaiCell K a b ρ σ θ₁ θ₂ →
      ∀ w : NumberField.InfinitePlace K, w x ≤ X := by
    intro x hmem w
    simp only [kaiCell, Set.mem_setOf_eq] at hmem
    obtain ⟨hR, hC⟩ := hmem
    rcases w.isReal_or_isComplex with hw | hw
    · rw [← NumberField.mixedEmbedding.normAtPlace_apply w x,
        NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw, Real.norm_eq_abs]
      obtain ⟨hX1, -, hX2⟩ := hab ⟨w, hw⟩
      obtain ⟨hr1, hr2⟩ := hR ⟨w, hw⟩
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    · rw [← NumberField.mixedEmbedding.normAtPlace_apply w x,
        NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw]
      exact ((hC ⟨w, hw⟩).2.1).trans (hρσ ⟨w, hw⟩).2.2
  have hbpf : {y : NumberField.RingOfIntegers K |
      ∀ w : NumberField.InfinitePlace K,
        w ((y : NumberField.RingOfIntegers K) : K) ≤ X}.Finite := by
    have hT : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}.Finite :=
      NumberField.Embeddings.finite_of_norm_le K ℂ X
    have hinj : Function.Injective (fun y : NumberField.RingOfIntegers K => (y : K)) := by
      intro a b h
      exact NumberField.RingOfIntegers.ext h
    have hpre : ((fun y : NumberField.RingOfIntegers K => (y : K)) ⁻¹'
        {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}).Finite :=
      Set.Finite.preimage hinj.injOn hT
    refine hpre.subset ?_
    intro y hy
    refine ⟨y.isIntegral_coe, fun φ => ?_⟩
    have h := hy (NumberField.InfinitePlace.mk φ)
    rw [NumberField.InfinitePlace.apply] at h
    exact h
  
  
  have hpair : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      (∀ w : NumberField.InfinitePlace K, w ((x : NumberField.RingOfIntegers K) : K) ≤ X) →
      ∀ j : Fin (NumberField.Units.rank K),
      |kaiTBPair K (e j) ((x : NumberField.RingOfIntegers K) : K)|
        ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
            * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X := by
    intro x hx hxX j
    obtain ⟨-, -, -, -, -, -, -, he, -⟩ := hdata
    have hM : 0 ≤ Real.log X := Real.log_nonneg hX
    have hx' : ((x : NumberField.RingOfIntegers K) : K) ≠ 0 := by exact_mod_cast hx
    have hpos : ∀ w : NumberField.InfinitePlace K,
        0 < w ((x : NumberField.RingOfIntegers K) : K) := fun w => w.pos_iff.2 hx'
    have hm1 : ∀ w : NumberField.InfinitePlace K, (1 : ℝ) ≤ (w.mult : ℝ) := fun w => by
      exact_mod_cast w.mult_pos
    have hn : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ))
        = (Module.finrank ℚ K : ℝ) := by
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
    have hn1 : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) :=
      Nat.one_le_cast.mpr Module.finrank_pos
    have hup : ∀ w : NumberField.InfinitePlace K,
        Real.log (w ((x : NumberField.RingOfIntegers K) : K)) ≤ Real.log X :=
      fun w => Real.log_le_log (hpos w) (hxX w)
    have hsumlog : 0 ≤ ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * Real.log (w ((x : NumberField.RingOfIntegers K) : K)) := by
      have h1 : ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * Real.log (w ((x : NumberField.RingOfIntegers K) : K))
          = Real.log (∏ w : NumberField.InfinitePlace K,
              w ((x : NumberField.RingOfIntegers K) : K) ^ w.mult) := by
        rw [Real.log_prod (fun w _ => pow_ne_zero _ (hpos w).ne')]
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [Real.log_pow]
      rw [h1, NumberField.InfinitePlace.prod_eq_abs_norm, ← Algebra.coe_norm_int]
      push_cast
      rw [Real.log_abs]
      exact Real.log_intCast_nonneg _
    have hcore : ∀ w₀ : NumberField.InfinitePlace K,
        |Real.log (w₀ ((x : NumberField.RingOfIntegers K) : K))|
          ≤ (Module.finrank ℚ K : ℝ) * Real.log X := by
      intro w₀
      have hf : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
          0 ≤ (w.mult : ℝ) * (Real.log X
            - Real.log (w ((x : NumberField.RingOfIntegers K) : K))) :=
        fun w _ => mul_nonneg (by linarith [hm1 w]) (by linarith [hup w])
      have hsingle := Finset.single_le_sum hf (Finset.mem_univ w₀)
      have hsum : ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (Real.log X - Real.log (w ((x : NumberField.RingOfIntegers K) : K)))
          = (Module.finrank ℚ K : ℝ) * Real.log X - ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * Real.log (w ((x : NumberField.RingOfIntegers K) : K)) := by
        rw [← hn, Finset.sum_mul, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun w _ => ?_)
        ring
      rw [hsum] at hsingle
      have h2 : Real.log X - Real.log (w₀ ((x : NumberField.RingOfIntegers K) : K))
          ≤ (w₀.mult : ℝ) * (Real.log X
            - Real.log (w₀ ((x : NumberField.RingOfIntegers K) : K))) :=
        le_mul_of_one_le_left (by linarith [hup w₀]) (hm1 w₀)
      have h3 : Real.log X ≤ (Module.finrank ℚ K : ℝ) * Real.log X :=
        le_mul_of_one_le_left hM hn1
      rw [abs_le]
      constructor
      · linarith
      · linarith [hup w₀]
    unfold kaiTBPair
    calc |∑ w : NumberField.InfinitePlace K, e j w * ((w.mult : ℝ)
            * Real.log (w ((x : NumberField.RingOfIntegers K) : K)))|
        ≤ ∑ w : NumberField.InfinitePlace K, |e j w * ((w.mult : ℝ)
            * Real.log (w ((x : NumberField.RingOfIntegers K) : K)))| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ w : NumberField.InfinitePlace K,
            B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
              * (Module.finrank ℚ K : ℝ) * Real.log X * (w.mult : ℝ) := by
          apply Finset.sum_le_sum
          intro w _
          have hmw : (0 : ℝ) < (w.mult : ℝ) := by linarith [hm1 w]
          rw [abs_mul, abs_mul, abs_of_pos hmw]
          have hD0 : 0 ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K :=
            (abs_nonneg _).trans (he j w)
          calc |e j w| * ((w.mult : ℝ)
                * |Real.log (w ((x : NumberField.RingOfIntegers K) : K))|)
              ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
                  * ((w.mult : ℝ) * ((Module.finrank ℚ K : ℝ) * Real.log X)) :=
                mul_le_mul (he j w) (mul_le_mul_of_nonneg_left (hcore w) hmw.le)
                  (by positivity) hD0
            _ = B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
                  * (Module.finrank ℚ K : ℝ) * Real.log X * (w.mult : ℝ) := by ring
      _ = B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
            * (Module.finrank ℚ K : ℝ) * Real.log X * (Module.finrank ℚ K : ℝ) := by
          rw [← Finset.mul_sum, hn]
      _ = B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
            * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X := by ring
  
  refine key
    (fun π => Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
      π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ))
    (fun i π => ∀ j, kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
      ∈ Set.Ioc ((i j : ℝ) / (l : ℝ)) ((i j : ℝ) / (l : ℝ) + 1 / (l : ℝ)))
    (fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)) _ ?_ ?_
  · exact hbpf.subset (fun π hπ => hplace _ hπ.2.1)
  · intro π hπ
    exact hcube (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
        * (Module.finrank ℚ K : ℝ) ^ 2 * Real.log X)
      (fun j => kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K))
      (fun j => hpair π hπ.1.ne_zero (hplace _ hπ.2.1) j)

theorem kai_tb_log_coord_identity (K : Type u) [Field K] [NumberField K]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K))
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e)
    (π : NumberField.RingOfIntegers K) (hπ : π ≠ 0) (w : NumberField.InfinitePlace K) :
    Real.log (w ((π : NumberField.RingOfIntegers K) : K))
      = (1 / (Module.finrank ℚ K : ℝ)) * Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
        + kaiTBShapeLog K H
            (fun j => kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)) w :=
by
  classical
  obtain ⟨-, -, -, hD4, -, hD6, hD7, -, -, -⟩ := hdata
  set x : K := ((π : NumberField.RingOfIntegers K) : K) with hxdef
  have hx : x ≠ 0 := by
    intro h
    apply hπ
    exact (NumberField.RingOfIntegers.coe_eq_zero_iff).mp h
  have hnpos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast (Module.finrank_pos : 0 < Module.finrank ℚ K)
  have hn : (Module.finrank ℚ K : ℝ) ≠ 0 := ne_of_gt hnpos
  have hm : ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)
      = (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast (NumberField.InfinitePlace.sum_mult_eq (K := K))
  have hcard : Fintype.card (NumberField.InfinitePlace K)
      = NumberField.Units.rank K + 1 := by
    have h1 : NumberField.Units.rank K
        = Fintype.card (NumberField.InfinitePlace K) - 1 := rfl
    have h2 : 0 < Fintype.card (NumberField.InfinitePlace K) := Fintype.card_pos
    omega
  have hbridge : ((Algebra.norm ℤ π).natAbs : ℝ) = |(((Algebra.norm ℚ) x : ℚ) : ℝ)| := by
    rw [hxdef, ← Algebra.coe_norm_int π, Rat.cast_intCast, Nat.cast_natAbs, Int.cast_abs]
  have hnorm : Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
      = ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v x) := by
    have hne : ∀ v ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
        (v x) ^ (v.mult) ≠ 0 := by
      intro v _
      exact pow_ne_zero _ (ne_of_gt (NumberField.InfinitePlace.pos_iff.mpr hx))
    have h1 : Real.log (∏ v : NumberField.InfinitePlace K, (v x) ^ (v.mult))
        = ∑ v : NumberField.InfinitePlace K, Real.log ((v x) ^ (v.mult)) :=
      Real.log_prod hne
    rw [NumberField.InfinitePlace.prod_eq_abs_norm x, Rat.cast_abs] at h1
    rw [hbridge, h1]
    exact Finset.sum_congr rfl (fun v _ => Real.log_pow _ _)
  have hkey : ∀ (a : ℝ) (c : Fin (NumberField.Units.rank K) → ℝ)
      (u : NumberField.InfinitePlace K → ℝ),
      (∀ v : NumberField.InfinitePlace K,
        u v = a * (v.mult : ℝ) + ∑ j, c j * kaiTBUnitLog K (H j) v) →
      a * (Module.finrank ℚ K : ℝ) = (∑ v : NumberField.InfinitePlace K, u v) ∧
        ∀ i, c i = ∑ v : NumberField.InfinitePlace K, e i v * u v := by
    intro a c u hu
    constructor
    · have h1 : (∑ v : NumberField.InfinitePlace K, u v)
          = ∑ v : NumberField.InfinitePlace K,
              (a * (v.mult : ℝ) + ∑ j, c j * kaiTBUnitLog K (H j) v) :=
        Finset.sum_congr rfl (fun v _ => hu v)
      have h2 : (∑ v : NumberField.InfinitePlace K,
          ∑ j, c j * kaiTBUnitLog K (H j) v) = 0 := by
        rw [Finset.sum_comm]
        refine Finset.sum_eq_zero (fun j _ => ?_)
        rw [← Finset.mul_sum, hD4 j, mul_zero]
      rw [h1, Finset.sum_add_distrib, h2, add_zero, ← Finset.mul_sum, hm]
    · intro i
      have e1 : ∀ v : NumberField.InfinitePlace K,
          e i v * (a * (v.mult : ℝ)) = a * ((v.mult : ℝ) * e i v) := fun v => by ring
      have e2 : ∀ (v : NumberField.InfinitePlace K) (j : Fin (NumberField.Units.rank K)),
          e i v * (c j * kaiTBUnitLog K (H j) v)
            = c j * (kaiTBUnitLog K (H j) v * e i v) := fun v j => by ring
      have h1 : (∑ v : NumberField.InfinitePlace K, e i v * u v)
          = ∑ v : NumberField.InfinitePlace K,
              (a * ((v.mult : ℝ) * e i v)
                + ∑ j, c j * (kaiTBUnitLog K (H j) v * e i v)) := by
        refine Finset.sum_congr rfl (fun v _ => ?_)
        rw [hu v, mul_add, Finset.mul_sum, e1 v,
          Finset.sum_congr rfl (fun j (_ : j ∈ Finset.univ) => e2 v j)]
      have h2 : (∑ v : NumberField.InfinitePlace K, a * ((v.mult : ℝ) * e i v)) = 0 := by
        rw [← Finset.mul_sum, hD7 i, mul_zero]
      have h3 : (∑ v : NumberField.InfinitePlace K,
          ∑ j, c j * (kaiTBUnitLog K (H j) v * e i v)) = c i := by
        rw [Finset.sum_comm]
        have h4 : ∀ j : Fin (NumberField.Units.rank K),
            (∑ v : NumberField.InfinitePlace K,
              c j * (kaiTBUnitLog K (H j) v * e i v))
              = if j = i then c j else 0 := by
          intro j
          rw [← Finset.mul_sum, hD6 j i]
          by_cases hji : j = i
          · simp [hji]
          · simp [hji]
        rw [Finset.sum_congr rfl (fun j (_ : j ∈ Finset.univ) => h4 j)]
        simp
      rw [h1, Finset.sum_add_distrib, h2, h3, zero_add]
  obtain ⟨F, hFdef⟩ :
      ∃ F : Fin (NumberField.Units.rank K + 1) → (NumberField.InfinitePlace K → ℝ),
        F = Fin.cons (fun v : NumberField.InfinitePlace K => (v.mult : ℝ))
              (fun j => kaiTBUnitLog K (H j)) := ⟨_, rfl⟩
  have hF0 : ∀ v : NumberField.InfinitePlace K, F 0 v = (v.mult : ℝ) := by
    intro v; rw [hFdef, Fin.cons_zero]
  have hFs : ∀ (j : Fin (NumberField.Units.rank K)) (v : NumberField.InfinitePlace K),
      F j.succ v = kaiTBUnitLog K (H j) v := by
    intro j v; rw [hFdef, Fin.cons_succ]
  have hsplit : ∀ (g : Fin (NumberField.Units.rank K + 1) → ℝ)
      (v : NumberField.InfinitePlace K),
      (∑ k, g k • F k) v
        = g 0 * (v.mult : ℝ) + ∑ j, g j.succ * kaiTBUnitLog K (H j) v := by
    intro g v
    rw [Finset.sum_apply, Fin.sum_univ_succ]
    simp only [Pi.smul_apply, smul_eq_mul, hF0, hFs]
  have hli : LinearIndependent ℝ F := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    have hpt : ∀ v : NumberField.InfinitePlace K,
        (0 : ℝ) = g 0 * (v.mult : ℝ) + ∑ j, g j.succ * kaiTBUnitLog K (H j) v := by
      intro v
      have h := hsplit g v
      rw [hg] at h
      exact h
    obtain ⟨h1, h2⟩ := hkey (g 0) (fun j => g j.succ)
      (fun _ : NumberField.InfinitePlace K => (0 : ℝ)) hpt
    have hg0 : g 0 = 0 := by
      have h3 : g 0 * (Module.finrank ℚ K : ℝ) = 0 := by rw [h1]; simp
      exact (mul_eq_zero.mp h3).resolve_right hn
    intro k
    refine Fin.cases ?_ ?_ k
    · exact hg0
    · intro i
      have h4 := h2 i
      simpa using h4
  have hspan : Submodule.span ℝ (Set.range F) = ⊤ := by
    refine hli.span_eq_top_of_card_eq_finrank ?_
    rw [Fintype.card_fin, Module.finrank_fintype_fun_eq_card, hcard]
  have hymem : (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * Real.log (v x))
      ∈ Submodule.span ℝ (Set.range F) := by
    rw [hspan]; exact Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hymem
  have hcpt : ∀ v : NumberField.InfinitePlace K,
      (v.mult : ℝ) * Real.log (v x)
        = c 0 * (v.mult : ℝ) + ∑ j, c j.succ * kaiTBUnitLog K (H j) v := by
    intro v
    have h := hsplit c v
    rw [hc] at h
    exact h
  obtain ⟨hA, hB⟩ := hkey (c 0) (fun j => c j.succ)
    (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * Real.log (v x)) hcpt
  have hc0 : c 0
      = (1 / (Module.finrank ℚ K : ℝ)) * Real.log ((Algebra.norm ℤ π).natAbs : ℝ) := by
    rw [hnorm, ← hA]
    field_simp
  have hpair : ∀ j : Fin (NumberField.Units.rank K),
      c j.succ = kaiTBPair K (e j) x := by
    intro j
    rw [hB j]
    rfl
  have hmultne : (w.mult : ℝ) ≠ 0 := by
    have h5 : (0 : ℝ) < (w.mult : ℝ) := by
      exact_mod_cast (NumberField.InfinitePlace.mult_pos : 0 < w.mult)
    exact ne_of_gt h5
  have hshape : kaiTBShapeLog K H (fun j => kaiTBPair K (e j) x) w
      = ∑ j, kaiTBPair K (e j) x
          * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) := rfl
  have hunit : ∀ j : Fin (NumberField.Units.rank K),
      kaiTBUnitLog K (H j) w
        = (w.mult : ℝ)
            * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) := fun j => rfl
  have p2 : (∑ j, c j.succ * kaiTBUnitLog K (H j) w)
      = (w.mult : ℝ) * kaiTBShapeLog K H (fun j => kaiTBPair K (e j) x) w := by
    rw [hshape, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hpair j, hunit j]
    ring
  refine mul_left_cancel₀ hmultne ?_
  rw [hcpt w, hc0, p2]
  ring

theorem kai_tb_cell_mem_dictionary (K : Type u) [Field K] [NumberField K]
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ ψ χ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hab : ∀ w, a w < b w ∧ (0 ≤ a w ∨ b w ≤ 0))
    (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (hsgn : ∀ w, sgn w = true ↔ 0 ≤ a w)
    (x : K) (hx : x ≠ 0) :
    (NumberField.mixedEmbedding K x ∈ kaiCell K a b ρ σ ψ χ →
       (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
           if sgn w then 0 < (NumberField.mixedEmbedding K x).1 w
           else (NumberField.mixedEmbedding K x).1 w < 0) ∧
       (∀ w : NumberField.InfinitePlace K,
           kaiTBCellLo K a b ρ σ w ≤ w x ∧ w x ≤ kaiTBCellHi K a b ρ σ w) ∧
       (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
           ψ p < ((NumberField.mixedEmbedding K x).2 p).arg ∧
           ((NumberField.mixedEmbedding K x).2 p).arg ≤ χ p))
    ∧
    ((∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
           if sgn w then 0 < (NumberField.mixedEmbedding K x).1 w
           else (NumberField.mixedEmbedding K x).1 w < 0) →
     (∀ w : NumberField.InfinitePlace K,
           kaiTBCellLo K a b ρ σ w < w x ∧ w x < kaiTBCellHi K a b ρ σ w) →
     (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
           ψ p < ((NumberField.mixedEmbedding K x).2 p).arg ∧
           ((NumberField.mixedEmbedding K x).2 p).arg ≤ χ p) →
     NumberField.mixedEmbedding K x ∈ kaiCell K a b ρ σ ψ χ) :=
by
  classical
  have B1 : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (w : NumberField.InfinitePlace K) x
        = |(NumberField.mixedEmbedding K x).1 w| := by
    intro w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply
          (w : NumberField.InfinitePlace K) x,
        NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2,
        Real.norm_eq_abs]
  have B2 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      (p : NumberField.InfinitePlace K) x
        = ‖(NumberField.mixedEmbedding K x).2 p‖ := by
    intro p
    rw [← NumberField.mixedEmbedding.normAtPlace_apply
          (p : NumberField.InfinitePlace K) x,
        NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex p.2]
  have B3 : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (NumberField.mixedEmbedding K x).1 w ≠ 0 := by
    intro w
    have h : (0 : ℝ) < (w : NumberField.InfinitePlace K) x :=
      NumberField.InfinitePlace.pos_iff.mpr hx
    rw [B1 w] at h
    exact abs_pos.mp h
  have B4a : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      ¬ (0 ≤ a w) → b w ≤ 0 := fun w h => (hab w).2.resolve_left h
  have B4b : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      ¬ (sgn w = true) → ¬ (0 ≤ a w) := fun w hs h => hs ((hsgn w).mpr h)
  have B4c : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      ¬ (0 ≤ a w) → ¬ (sgn w = true) := fun w ha hs => ha ((hsgn w).mp hs)
  have ULo : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, 0 ≤ a w →
      kaiTBCellLo K a b ρ σ (w : NumberField.InfinitePlace K) = a w := by
    intro w ha
    simp only [kaiTBCellLo]
    split_ifs with h1
    · rfl
    · exact absurd w.2 h1
  have UHi : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, 0 ≤ a w →
      kaiTBCellHi K a b ρ σ (w : NumberField.InfinitePlace K) = b w := by
    intro w ha
    simp only [kaiTBCellHi]
    split_ifs with h1
    · rfl
    · exact absurd w.2 h1
  have ULo' : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, ¬ (0 ≤ a w) →
      kaiTBCellLo K a b ρ σ (w : NumberField.InfinitePlace K) = -b w := by
    intro w ha
    simp only [kaiTBCellLo]
    split_ifs with h1
    · rfl
    · exact absurd w.2 h1
  have UHi' : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, ¬ (0 ≤ a w) →
      kaiTBCellHi K a b ρ σ (w : NumberField.InfinitePlace K) = -a w := by
    intro w ha
    simp only [kaiTBCellHi]
    split_ifs with h1
    · rfl
    · exact absurd w.2 h1
  have hnr : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      ¬ ((p : NumberField.InfinitePlace K).IsReal) :=
    fun p => NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr p.2
  have VLo : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      kaiTBCellLo K a b ρ σ (p : NumberField.InfinitePlace K) = ρ p := by
    intro p
    simp only [kaiTBCellLo]
    split_ifs with h1 h2
    · exact absurd h1 (hnr p)
    · exact absurd h1 (hnr p)
    · rfl
  have VHi : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      kaiTBCellHi K a b ρ σ (p : NumberField.InfinitePlace K) = σ p := by
    intro p
    simp only [kaiTBCellHi]
    split_ifs with h1 h2
    · exact absurd h1 (hnr p)
    · exact absurd h1 (hnr p)
    · rfl
  constructor
  · intro hmem
    simp only [kaiCell, Set.mem_setOf_eq] at hmem
    obtain ⟨hR, hC⟩ := hmem
    refine ⟨?_, ?_, ?_⟩
    · intro w
      by_cases hs : sgn w = true
      · rw [if_pos hs]
        have ha : 0 ≤ a w := (hsgn w).mp hs
        have h1 := (hR w).1
        linarith
      · rw [if_neg hs]
        have hb : b w ≤ 0 := B4a w (B4b w hs)
        have h2 := (hR w).2
        exact lt_of_le_of_ne (by linarith) (B3 w)
    · intro w
      rcases w.isReal_or_isComplex with hw | hw
      · by_cases ha : 0 ≤ a (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal})
        · have hlo : kaiTBCellLo K a b ρ σ w
              = a (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) :=
            ULo ⟨w, hw⟩ ha
          have hhi : kaiTBCellHi K a b ρ σ w
              = b (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) :=
            UHi ⟨w, hw⟩ ha
          have hwx : w x = |(NumberField.mixedEmbedding K x).1
              (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal})| :=
            B1 ⟨w, hw⟩
          have h1 := (hR (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal})).1
          have h2 := (hR (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal})).2
          have hpos : 0 < (NumberField.mixedEmbedding K x).1
              (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) := by linarith
          rw [hlo, hhi, hwx, abs_of_pos hpos]
          constructor <;> linarith
        · have hlo : kaiTBCellLo K a b ρ σ w
              = -b (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) :=
            ULo' ⟨w, hw⟩ ha
          have hhi : kaiTBCellHi K a b ρ σ w
              = -a (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) :=
            UHi' ⟨w, hw⟩ ha
          have hwx : w x = |(NumberField.mixedEmbedding K x).1
              (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal})| :=
            B1 ⟨w, hw⟩
          have hb : b (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) ≤ 0 :=
            B4a ⟨w, hw⟩ ha
          have h1 := (hR (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal})).1
          have h2 := (hR (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal})).2
          have hneg : (NumberField.mixedEmbedding K x).1
              (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) < 0 :=
            lt_of_le_of_ne (by linarith) (B3 ⟨w, hw⟩)
          rw [hlo, hhi, hwx, abs_of_neg hneg]
          constructor <;> linarith
      · have hlo : kaiTBCellLo K a b ρ σ w
            = ρ (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsComplex}) :=
          VLo ⟨w, hw⟩
        have hhi : kaiTBCellHi K a b ρ σ w
            = σ (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsComplex}) :=
          VHi ⟨w, hw⟩
        have hwx : w x = ‖(NumberField.mixedEmbedding K x).2
            (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsComplex})‖ :=
          B2 ⟨w, hw⟩
        rw [hlo, hhi, hwx]
        exact ⟨le_of_lt (hC (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsComplex})).1,
          (hC (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsComplex})).2.1⟩
    · intro p
      exact ⟨(hC p).2.2.1, (hC p).2.2.2⟩
  · intro hsign hplace hang
    simp only [kaiCell, Set.mem_setOf_eq]
    constructor
    · intro w
      obtain ⟨hlo, hhi⟩ := hplace (w : NumberField.InfinitePlace K)
      by_cases ha : 0 ≤ a w
      · rw [ULo w ha] at hlo
        rw [UHi w ha] at hhi
        have hs : sgn w = true := (hsgn w).mpr ha
        have ht := hsign w
        rw [if_pos hs] at ht
        rw [B1 w, abs_of_pos ht] at hlo hhi
        exact ⟨hlo, le_of_lt hhi⟩
      · rw [ULo' w ha] at hlo
        rw [UHi' w ha] at hhi
        have hs : ¬ (sgn w = true) := B4c w ha
        have ht := hsign w
        rw [if_neg hs] at ht
        rw [B1 w, abs_of_neg ht] at hlo hhi
        constructor <;> linarith
    · intro p
      obtain ⟨hlo, hhi⟩ := hplace (p : NumberField.InfinitePlace K)
      rw [VLo p] at hlo
      rw [VHi p] at hhi
      rw [B2 p] at hlo hhi
      exact ⟨hlo, le_of_lt hhi, (hang p).1, (hang p).2⟩

theorem kai_tb_shape_env_lipschitz (K : Type u) [Field K] [NumberField K]
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (Λ₀ D : ℝ)
    (hLo : ∀ w : NumberField.InfinitePlace K, 0 ≤ kaiTBCellLo K a b ρ σ w)
    (hHi : ∀ w : NumberField.InfinitePlace K, 0 < kaiTBCellHi K a b ρ σ w)
    (hΛ₀ : ∀ (j : Fin (NumberField.Units.rank K)) (w : NumberField.InfinitePlace K),
        |Real.log (w (((H j : NumberField.RingOfIntegers K)) : K))| ≤ Λ₀)
    (W W' : Fin (NumberField.Units.rank K) → ℝ)
    (hWW : ∀ j, |W j - W' j| ≤ D) :
    kaiTBEplus K H a b ρ σ W
        ≤ Real.exp ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ) * Λ₀ * D)
            * kaiTBEplus K H a b ρ σ W' ∧
      kaiTBEminus K H a b ρ σ W
        ≤ Real.exp ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ) * Λ₀ * D)
            * kaiTBEminus K H a b ρ σ W' :=
by
  have hn0 : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.cast_nonneg _
  have hc0 : 0 ≤ Real.exp ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ) * Λ₀ * D) :=
    Real.exp_nonneg _
  have hlip : ∀ w : NumberField.InfinitePlace K,
      |kaiTBShapeLog K H W w - kaiTBShapeLog K H W' w|
        ≤ (NumberField.Units.rank K : ℝ) * Λ₀ * D := by
    intro w
    have hdiff : kaiTBShapeLog K H W w - kaiTBShapeLog K H W' w
        = ∑ j, (W j - W' j) * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) := by
      simp only [kaiTBShapeLog, sub_mul, Finset.sum_sub_distrib]
    rw [hdiff]
    calc |∑ j, (W j - W' j) * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K))|
        ≤ ∑ j, |(W j - W' j) * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K))| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _j : Fin (NumberField.Units.rank K), D * Λ₀ := by
          apply Finset.sum_le_sum
          intro j _
          rw [abs_mul]
          exact mul_le_mul (hWW j) (hΛ₀ j w) (abs_nonneg _) (le_trans (abs_nonneg _) (hWW j))
      _ = (NumberField.Units.rank K : ℝ) * Λ₀ * D := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
  have hexp : ∀ w : NumberField.InfinitePlace K,
      Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w)
        ≤ Real.exp ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ) * Λ₀ * D)
          * Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W' w) := by
    intro w
    rw [← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have h1 : kaiTBShapeLog K H W' w - kaiTBShapeLog K H W w
        ≤ (NumberField.Units.rank K : ℝ) * Λ₀ * D := by
      have := hlip w
      rw [abs_sub_comm] at this
      exact (le_abs_self _).trans this
    have h2 := mul_le_mul_of_nonneg_left h1 hn0
    have h3 : (Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ) * Λ₀ * D
        = (Module.finrank ℚ K : ℝ) * ((NumberField.Units.rank K : ℝ) * Λ₀ * D) := by ring
    rw [h3]
    linarith
  have hpt : ∀ F : NumberField.InfinitePlace K → ℝ, (∀ w, 0 ≤ F w) →
      ∀ w, F w ^ (Module.finrank ℚ K) *
          Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w)
        ≤ Real.exp ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ) * Λ₀ * D)
          * (F w ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W' w)) := by
    intro F hF w
    have hpow : 0 ≤ F w ^ (Module.finrank ℚ K) := pow_nonneg (hF w) _
    calc F w ^ (Module.finrank ℚ K) *
          Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w)
        ≤ F w ^ (Module.finrank ℚ K) *
          (Real.exp ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ) * Λ₀ * D)
            * Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W' w)) :=
          mul_le_mul_of_nonneg_left (hexp w) hpow
      _ = _ := by ring
  constructor
  · unfold kaiTBEplus
    rw [Real.mul_iInf_of_nonneg hc0]
    exact ciInf_mono (Finite.bddBelow_range _) (hpt (kaiTBCellHi K a b ρ σ) (fun w => (hHi w).le))
  · unfold kaiTBEminus
    rw [Real.mul_iSup_of_nonneg hc0]
    exact ciSup_mono (Finite.bddAbove_range _) (hpt (kaiTBCellLo K a b ρ σ) hLo)

theorem kai_tb_norm_place_env (K : Type u) [Field K] [NumberField K]
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hLo : ∀ w : NumberField.InfinitePlace K, 0 ≤ kaiTBCellLo K a b ρ σ w)
    (hHi : ∀ w : NumberField.InfinitePlace K, 0 < kaiTBCellHi K a b ρ σ w)
    (W : Fin (NumberField.Units.rank K) → ℝ)
    (x : K) (hx : x ≠ 0) (N : ℝ) (hN : 0 < N)
    (hid : ∀ w : NumberField.InfinitePlace K,
        Real.log (w x)
          = (1 / (Module.finrank ℚ K : ℝ)) * Real.log N + kaiTBShapeLog K H W w) :
    (∀ V : Fin (NumberField.Units.rank K) → ℝ, 0 ≤ kaiTBEminus K H a b ρ σ V)
    ∧ ((∀ w : NumberField.InfinitePlace K,
          kaiTBCellLo K a b ρ σ w ≤ w x ∧ w x ≤ kaiTBCellHi K a b ρ σ w) →
        kaiTBEminus K H a b ρ σ W ≤ N ∧ N ≤ kaiTBEplus K H a b ρ σ W)
    ∧ (kaiTBEminus K H a b ρ σ W < N → N < kaiTBEplus K H a b ρ σ W →
       ∀ w : NumberField.InfinitePlace K,
          kaiTBCellLo K a b ρ σ w < w x ∧ w x < kaiTBCellHi K a b ρ σ w) :=
by
  have hm : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hmne : (Module.finrank ℚ K : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hwx : ∀ w : NumberField.InfinitePlace K, 0 < w x := fun w =>
    NumberField.InfinitePlace.pos_iff.mpr hx
  have hexp : ∀ (V : Fin (NumberField.Units.rank K) → ℝ) (w : NumberField.InfinitePlace K),
      0 < Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H V w) :=
    fun _ _ => Real.exp_pos _
  have hkey : ∀ w : NumberField.InfinitePlace K,
      (w x) ^ (Module.finrank ℚ K) *
        Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w) = N := by
    intro w
    have h1 : Real.log ((w x) ^ (Module.finrank ℚ K))
        = Real.log N + (Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w := by
      rw [Real.log_pow, hid w, mul_add, ← mul_assoc, mul_one_div_cancel hmne, one_mul]
    have hpos : 0 < (w x) ^ (Module.finrank ℚ K) := pow_pos (hwx w) _
    calc (w x) ^ (Module.finrank ℚ K) *
          Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w)
        = Real.exp (Real.log ((w x) ^ (Module.finrank ℚ K))) *
          Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w) := by
          rw [Real.exp_log hpos]
      _ = Real.exp (Real.log ((w x) ^ (Module.finrank ℚ K)) +
          -(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w) := by rw [Real.exp_add]
      _ = Real.exp (Real.log N) := by congr 1; rw [h1]; ring
      _ = N := Real.exp_log hN
  have hbddA : ∀ V : Fin (NumberField.Units.rank K) → ℝ, BddAbove (Set.range fun w :
      NumberField.InfinitePlace K => kaiTBCellLo K a b ρ σ w ^ (Module.finrank ℚ K) *
        Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H V w)) :=
    fun _ => (Set.finite_range _).bddAbove
  have hbddB : ∀ V : Fin (NumberField.Units.rank K) → ℝ, BddBelow (Set.range fun w :
      NumberField.InfinitePlace K => kaiTBCellHi K a b ρ σ w ^ (Module.finrank ℚ K) *
        Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H V w)) :=
    fun _ => (Set.finite_range _).bddBelow
  refine ⟨?_, ?_, ?_⟩
  · intro V
    unfold kaiTBEminus
    exact Real.iSup_nonneg fun w => mul_nonneg (pow_nonneg (hLo w) _) (hexp V w).le
  · intro hbox
    constructor
    · unfold kaiTBEminus
      refine ciSup_le fun w => ?_
      rw [← hkey w]
      exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (hLo w) (hbox w).1 _) (hexp W w).le
    · unfold kaiTBEplus
      refine le_ciInf fun w => ?_
      rw [← hkey w]
      exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (hwx w).le (hbox w).2 _) (hexp W w).le
  · intro hlt₁ hlt₂ w
    constructor
    · have h1 : kaiTBCellLo K a b ρ σ w ^ (Module.finrank ℚ K) *
          Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w)
            ≤ kaiTBEminus K H a b ρ σ W := by
        unfold kaiTBEminus
        exact le_ciSup (hbddA W) w
      have h2 := lt_of_le_of_lt h1 hlt₁
      rw [← hkey w] at h2
      have h3 := lt_of_mul_lt_mul_right h2 (hexp W w).le
      exact lt_of_pow_lt_pow_left₀ _ (hwx w).le h3
    · have h1 : kaiTBEplus K H a b ρ σ W ≤ kaiTBCellHi K a b ρ σ w ^ (Module.finrank ℚ K) *
          Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w) := by
        unfold kaiTBEplus
        exact ciInf_le (hbddB W) w
      have h2 := lt_of_lt_of_le hlt₂ h1
      rw [← hkey w] at h2
      have h3 := lt_of_mul_lt_mul_right h2 (hexp W w).le
      exact lt_of_pow_lt_pow_left₀ _ (hHi w).le h3

theorem kai_tb_theta_window_transfer (K : Type u) [Field K] [NumberField K]
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (l : ℕ) (hl : 1 ≤ l)
    (u : Fin (NumberField.Units.rank K) → ℝ)
    (ψ χ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (p : {w : NumberField.InfinitePlace K // w.IsComplex})
    (hψ : -Real.pi ≤ ψ p) (hψχ : ψ p ≤ χ p) (hχ : χ p ≤ Real.pi)
    (x : K)
    (hcube : ∀ j, kaiTBPair K (e j) x ∈ Set.Ioc (u j) (u j + 1 / (l : ℝ)))
    (Δθ dd t : ℝ)
    (hΔθ : Δθ = (NumberField.Units.rank K : ℝ) / (2 * (l : ℝ)))
    (hdd : dd = ∑ j, u j * ((NumberField.mixedEmbedding K
              (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg)
    (ht : t = kaiTBTheta K H e p x) :
    ((ψ p < ((NumberField.mixedEmbedding K x).2 p).arg →
      ((NumberField.mixedEmbedding K x).2 p).arg ≤ χ p →
      0 < t - ((ψ p - dd) / (2 * Real.pi) - Δθ) ∧
        t - ((ψ p - dd) / (2 * Real.pi) - Δθ)
          ≤ (χ p - ψ p) / (2 * Real.pi) + 2 * Δθ))
    ∧
    (∀ k : ℤ,
       0 < t - ((ψ p - dd) / (2 * Real.pi) + Δθ) - (k : ℝ) →
       t - ((ψ p - dd) / (2 * Real.pi) + Δθ) - (k : ℝ)
         ≤ (χ p - ψ p) / (2 * Real.pi) - 2 * Δθ →
       ψ p < ((NumberField.mixedEmbedding K x).2 p).arg ∧
         ((NumberField.mixedEmbedding K x).2 p).arg ≤ χ p) :=
by
  have hpi : (0:ℝ) < Real.pi := Real.pi_pos
  have hP : (0:ℝ) < 2 * Real.pi := by linarith only [hpi]
  have hL1 : (1:ℝ) ≤ (l:ℝ) := Nat.one_le_cast.mpr hl
  have hL0 : (0:ℝ) < (l:ℝ) := by linarith only [hL1]
  have hterm : ∀ j : Fin (NumberField.Units.rank K),
      |(kaiTBPair K (e j) x - u j) *
          ((NumberField.mixedEmbedding K
            (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg|
        ≤ 1 / (l:ℝ) * Real.pi := by
    intro j
    have hj := Set.mem_Ioc.mp (hcube j)
    have hd1 : (0:ℝ) < kaiTBPair K (e j) x - u j := by linarith only [hj.1]
    have hd2 : kaiTBPair K (e j) x - u j ≤ 1 / (l:ℝ) := by linarith only [hj.2]
    rw [abs_mul, abs_of_pos hd1]
    exact mul_le_mul hd2 (Complex.abs_arg_le_pi _) (abs_nonneg _)
      (le_of_lt (one_div_pos.mpr hL0))
  have hbound : |∑ j, (kaiTBPair K (e j) x - u j) *
        ((NumberField.mixedEmbedding K
          (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg|
      ≤ (NumberField.Units.rank K : ℝ) * (1 / (l:ℝ) * Real.pi) := by
    calc |∑ j, (kaiTBPair K (e j) x - u j) *
            ((NumberField.mixedEmbedding K
              (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg|
        ≤ ∑ j, |(kaiTBPair K (e j) x - u j) *
            ((NumberField.mixedEmbedding K
              (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _j : Fin (NumberField.Units.rank K), 1 / (l:ℝ) * Real.pi :=
          Finset.sum_le_sum (fun j _ => hterm j)
      _ = (NumberField.Units.rank K : ℝ) * (1 / (l:ℝ) * Real.pi) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hDl : |∑ j, (kaiTBPair K (e j) x - u j) *
        ((NumberField.mixedEmbedding K
          (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg| * (l:ℝ)
      ≤ (NumberField.Units.rank K : ℝ) * Real.pi := by
    have h1 := mul_le_mul_of_nonneg_right hbound (le_of_lt hL0)
    have h2 : (NumberField.Units.rank K : ℝ) * (1 / (l:ℝ) * Real.pi) * (l:ℝ)
        = (NumberField.Units.rank K : ℝ) * Real.pi := by
      field_simp
    linarith only [h1, h2]
  have hsabs : |(∑ j, (kaiTBPair K (e j) x - u j) *
        ((NumberField.mixedEmbedding K
          (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg) / (2 * Real.pi)|
      ≤ Δθ := by
    rw [abs_div, abs_of_pos hP, hΔθ]
    have hnum : (0:ℝ) ≤ (NumberField.Units.rank K : ℝ) * Real.pi
        - |∑ j, (kaiTBPair K (e j) x - u j) *
            ((NumberField.mixedEmbedding K
              (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg| * (l:ℝ) := by
      linarith only [hDl]
    have hq : (0:ℝ) ≤ ((NumberField.Units.rank K : ℝ) * Real.pi
        - |∑ j, (kaiTBPair K (e j) x - u j) *
            ((NumberField.mixedEmbedding K
              (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg| * (l:ℝ))
        / (2 * (l:ℝ) * Real.pi) := div_nonneg hnum (by positivity)
    have he : (NumberField.Units.rank K : ℝ) / (2 * (l:ℝ))
          - |∑ j, (kaiTBPair K (e j) x - u j) *
              ((NumberField.mixedEmbedding K
                (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg| / (2 * Real.pi)
        = ((NumberField.Units.rank K : ℝ) * Real.pi
            - |∑ j, (kaiTBPair K (e j) x - u j) *
                ((NumberField.mixedEmbedding K
                  (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg| * (l:ℝ))
          / (2 * (l:ℝ) * Real.pi) := by
      field_simp
    linarith only [hq, he]
  obtain ⟨hsL, hsU⟩ := abs_le.mp hsabs
  have hsplit : (∑ j, (kaiTBPair K (e j) x - u j) *
        ((NumberField.mixedEmbedding K
          (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg)
      = (∑ j, kaiTBPair K (e j) x *
          ((NumberField.mixedEmbedding K
            (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg)
        - ∑ j, u j * ((NumberField.mixedEmbedding K
            (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg := by
    simp only [sub_mul]
    exact Finset.sum_sub_distrib _ _
  have hid : t - (ψ p - dd) / (2 * Real.pi)
      = (((NumberField.mixedEmbedding K x).2 p).arg - ψ p) / (2 * Real.pi)
        - (∑ j, (kaiTBPair K (e j) x - u j) *
            ((NumberField.mixedEmbedding K
              (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg)
          / (2 * Real.pi) := by
    rw [hsplit, ht, hdd]
    simp only [kaiTBTheta]
    ring
  constructor
  · intro hlt hle
    have hXpos : 0 < (((NumberField.mixedEmbedding K x).2 p).arg - ψ p) / (2 * Real.pi) :=
      div_pos (by linarith only [hlt]) hP
    have hXle : (((NumberField.mixedEmbedding K x).2 p).arg - ψ p) / (2 * Real.pi)
        ≤ (χ p - ψ p) / (2 * Real.pi) := by
      have hd : (0:ℝ) ≤ (χ p - ((NumberField.mixedEmbedding K x).2 p).arg) / (2 * Real.pi) :=
        div_nonneg (by linarith only [hle]) (le_of_lt hP)
      have he2 : (χ p - ψ p) / (2 * Real.pi)
            - (((NumberField.mixedEmbedding K x).2 p).arg - ψ p) / (2 * Real.pi)
          = (χ p - ((NumberField.mixedEmbedding K x).2 p).arg) / (2 * Real.pi) := by ring
      linarith only [hd, he2]
    exact ⟨by linarith only [hid, hXpos, hsU], by linarith only [hid, hXle, hsL]⟩
  · intro k hk1 hk2
    have hA : (k:ℝ) < (((NumberField.mixedEmbedding K x).2 p).arg - ψ p) / (2 * Real.pi) := by
      linarith only [hk1, hid, hsL]
    have hB : (((NumberField.mixedEmbedding K x).2 p).arg - ψ p) / (2 * Real.pi)
        ≤ (χ p - ψ p) / (2 * Real.pi) + (k:ℝ) := by
      linarith only [hk2, hid, hsU]
    have hA' : (k:ℝ) * (2 * Real.pi)
        < ((NumberField.mixedEmbedding K x).2 p).arg - ψ p := (lt_div_iff₀ hP).mp hA
    have hBB : (((NumberField.mixedEmbedding K x).2 p).arg - χ p) / (2 * Real.pi)
        ≤ (k:ℝ) := by
      have he3 : (((NumberField.mixedEmbedding K x).2 p).arg - ψ p) / (2 * Real.pi)
            - (χ p - ψ p) / (2 * Real.pi)
          = (((NumberField.mixedEmbedding K x).2 p).arg - χ p) / (2 * Real.pi) := by ring
      linarith only [hB, he3]
    have hB' : ((NumberField.mixedEmbedding K x).2 p).arg - χ p
        ≤ (k:ℝ) * (2 * Real.pi) := (div_le_iff₀ hP).mp hBB
    rcases lt_trichotomy k 0 with hk | hk | hk
    · exfalso
      have hkZ : k ≤ -1 := by omega
      have hkR : ((k:ℤ):ℝ) ≤ -1 := by exact_mod_cast hkZ
      have hmul : (k:ℝ) * (2 * Real.pi) ≤ (-1:ℝ) * (2 * Real.pi) :=
        mul_le_mul_of_nonneg_right hkR (le_of_lt hP)
      linarith only [hB', hmul, hχ,
        Complex.neg_pi_lt_arg ((NumberField.mixedEmbedding K x).2 p)]
    · subst hk
      simp only [Int.cast_zero, zero_mul] at hA' hB'
      exact ⟨by linarith only [hA'], by linarith only [hB']⟩
    · exfalso
      have hkZ : (1:ℤ) ≤ k := by omega
      have hkR : (1:ℝ) ≤ ((k:ℤ):ℝ) := by exact_mod_cast hkZ
      have hmul : (1:ℝ) * (2 * Real.pi) ≤ (k:ℝ) * (2 * Real.pi) :=
        mul_le_mul_of_nonneg_right hkR (le_of_lt hP)
      linarith only [hA', hmul, hψ,
        Complex.arg_le_pi ((NumberField.mixedEmbedding K x).2 p)]

theorem kai_tb_env_cutoff_arith (EpW EmW Ep Em N Λ Δ T : ℝ)
    (hΛ0 : 0 ≤ Λ) (hΛΔ : Λ ≤ Δ) (hΔ0 : 0 < Δ)
    (hEm0 : 0 ≤ Em) (hN0 : 0 < N)
    (hEpWu : EpW ≤ Real.exp Λ * Ep)
    (hEpuW : Ep ≤ Real.exp Λ * EpW)
    (hEmWu : EmW ≤ Real.exp Λ * Em)
    (hEmuW : Em ≤ Real.exp Λ * EmW) :
    (EmW ≤ N → N ≤ EpW → Em * Real.exp (-Δ) ≤ N ∧ N ≤ Ep * Real.exp Δ)
    ∧ (EmW ≤ N → T < N → max (Em * Real.exp (-(2 * Δ))) T < N)
    ∧ (Em * Real.exp Δ < N → EmW < N)
    ∧ (N ≤ Ep * Real.exp (-(2 * Δ)) → N < EpW) :=
by
  have hEΛ : 0 < Real.exp Λ := Real.exp_pos _
  have hEΛΔ : Real.exp Λ ≤ Real.exp Δ := Real.exp_le_exp.2 hΛΔ
  have hinv : Real.exp Λ * Real.exp (-Λ) = 1 := by
    rw [← Real.exp_add]; simp
  have hm1 : Real.exp (-Δ) ≤ Real.exp (-Λ) := Real.exp_le_exp.2 (by linarith)
  have hm2 : Real.exp (-(2 * Δ)) < Real.exp (-Λ) := Real.exp_lt_exp.2 (by linarith)
  have hm2p : 0 < Real.exp (-(2 * Δ)) := Real.exp_pos _
  have hmΛp : 0 < Real.exp (-Λ) := Real.exp_pos _
  have hEmW : Em * Real.exp (-Λ) ≤ EmW := by
    have h := mul_le_mul_of_nonneg_right hEmuW hmΛp.le
    calc Em * Real.exp (-Λ) ≤ Real.exp Λ * EmW * Real.exp (-Λ) := h
      _ = EmW * (Real.exp Λ * Real.exp (-Λ)) := by ring
      _ = EmW := by rw [hinv, mul_one]
  have hEpW : Ep * Real.exp (-Λ) ≤ EpW := by
    have h := mul_le_mul_of_nonneg_right hEpuW hmΛp.le
    calc Ep * Real.exp (-Λ) ≤ Real.exp Λ * EpW * Real.exp (-Λ) := h
      _ = EpW * (Real.exp Λ * Real.exp (-Λ)) := by ring
      _ = EpW := by rw [hinv, mul_one]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro h1 h2
    have hEp : 0 < Ep := by
      by_contra hc
      push_neg at hc
      have : Real.exp Λ * Ep ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hEΛ.le hc
      linarith
    constructor
    · have := mul_le_mul_of_nonneg_left hm1 hEm0
      linarith
    · have := mul_le_mul_of_nonneg_right hEΛΔ hEp.le
      linarith
  · intro h1 h2
    refine max_lt ?_ h2
    rcases hEm0.eq_or_lt with h | h
    · rw [← h, zero_mul]; exact hN0
    · have := mul_lt_mul_of_pos_left hm2 h
      linarith
  · intro h
    have := mul_le_mul_of_nonneg_right hEΛΔ hEm0
    linarith
  · intro h
    have hEp : 0 < Ep := by
      by_contra hc
      push_neg at hc
      have : Ep * Real.exp (-(2 * Δ)) ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hc hm2p.le
      linarith
    have := mul_lt_mul_of_pos_left hm2 hEp
    linarith

theorem kai_log_absnorm_sum_facts (K : Type u) [Field K] [NumberField K]
    (S : Set (NumberField.RingOfIntegers K)) (hS : S.Finite) :
    (∀ P Q : NumberField.RingOfIntegers K → Prop, (∀ π, Q π → π ∈ S) →
        (∀ π, P π → Q π) →
        (∑' π : {π : NumberField.RingOfIntegers K // P π},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
          ≤ ∑' π : {π : NumberField.RingOfIntegers K // Q π},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) ∧
    (∀ (P : NumberField.RingOfIntegers K → Prop) (c : ℝ), (∀ π, P π → π ∈ S) →
        (∑' π : {π : NumberField.RingOfIntegers K // P π},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
          = (∑' π : {π : NumberField.RingOfIntegers K //
                P π ∧ ((Algebra.norm ℤ π).natAbs : ℝ) ≤ c},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            + ∑' π : {π : NumberField.RingOfIntegers K //
                P π ∧ c < ((Algebra.norm ℤ π).natAbs : ℝ)},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) ∧
    (∀ P Q : NumberField.RingOfIntegers K → Prop, (∀ π, P π ↔ Q π) →
        (∑' π : {π : NumberField.RingOfIntegers K // P π},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
          = ∑' π : {π : NumberField.RingOfIntegers K // Q π},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) :=
by
  classical
  obtain ⟨f, hf⟩ : ∃ f : NumberField.RingOfIntegers K → ℝ,
      f = fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ) := ⟨_, rfl⟩
  have hnn : ∀ π, 0 ≤ f π := fun π => by rw [hf]; exact Real.log_natCast_nonneg _
  have hrw : ∀ P : NumberField.RingOfIntegers K → Prop,
      (∑' π : {π : NumberField.RingOfIntegers K // P π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        = ∑' π, ({π | P π} : Set (NumberField.RingOfIntegers K)).indicator f π := by
    intro P
    subst hf
    exact tsum_subtype ({π | P π} : Set (NumberField.RingOfIntegers K))
      (fun π : NumberField.RingOfIntegers K => Real.log ((Algebra.norm ℤ π).natAbs : ℝ))
  have hsum : ∀ P : NumberField.RingOfIntegers K → Prop, (∀ π, P π → π ∈ S) →
      Summable (({π | P π} : Set (NumberField.RingOfIntegers K)).indicator f) := by
    intro P hP
    have hfin : ({π | P π} : Set (NumberField.RingOfIntegers K)).Finite :=
      hS.subset (fun π h => hP π h)
    haveI := hfin.to_subtype
    exact summable_subtype_iff_indicator.1 (Summable.of_finite)
  refine ⟨?_, ?_, ?_⟩
  · intro P Q hQ hPQ
    rw [hrw P, hrw Q]
    refine Summable.tsum_le_tsum (fun π => ?_) (hsum P (fun π h => hQ π (hPQ π h))) (hsum Q hQ)
    exact Set.indicator_le_indicator_of_subset (fun π h => hPQ π h) hnn π
  · intro P c hP
    rw [hrw P, hrw (fun π => P π ∧ ((Algebra.norm ℤ π).natAbs : ℝ) ≤ c),
      hrw (fun π => P π ∧ c < ((Algebra.norm ℤ π).natAbs : ℝ)),
      ← Summable.tsum_add (hsum _ (fun π h => hP π h.1)) (hsum _ (fun π h => hP π h.1))]
    congr 1
    funext π
    simp only [Set.indicator, Set.mem_setOf_eq]
    by_cases h1 : P π
    · by_cases h2 : ((Algebra.norm ℤ π).natAbs : ℝ) ≤ c
      · have h3 : ¬ c < ((Algebra.norm ℤ π).natAbs : ℝ) := not_lt.2 h2
        rw [if_pos h1, if_pos ⟨h1, h2⟩, if_neg (fun h => h3 h.2), add_zero]
      · have h3 : c < ((Algebra.norm ℤ π).natAbs : ℝ) := not_le.1 h2
        rw [if_pos h1, if_neg (fun h => h2 h.2), if_pos ⟨h1, h3⟩, zero_add]
    · rw [if_neg h1, if_neg (fun h => h1 h.1), if_neg (fun h => h1 h.1), add_zero]
  · intro P Q h
    have hPQ : P = Q := funext fun π => propext (h π)
    subst hPQ
    rfl

theorem kai_tb_cube_count_sandwich (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (wq : ℕ) (Rq : ℝ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
    (hdata : KaiTBUnitData K B q H wq Rq e)
    (α : NumberField.RingOfIntegers K)
    (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
    (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hab : ∀ w, a w < b w ∧ (0 ≤ a w ∨ b w ≤ 0))
    (hρσ : ∀ p, 0 ≤ ρ p ∧ ρ p < σ p ∧ -Real.pi ≤ θ₁ p ∧ θ₁ p ≤ θ₂ p ∧ θ₂ p ≤ Real.pi)
    (sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (hsgn : ∀ w, sgn w = true ↔ 0 ≤ a w)
    (l : ℕ) (hl : 1 ≤ l) (u : Fin (NumberField.Units.rank K) → ℝ) (T : ℝ) (hT : 0 < T)
    (Δ Δθ x0p x1p x0m x1m : ℝ)
    (vvp thp vvm thm : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
    (hΔ : Δ = ((Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ)
        * (B * (Ideal.absNorm q : ℝ)) + 1) / (l : ℝ))
    (hΔθ : Δθ = (NumberField.Units.rank K : ℝ) / (2 * (l : ℝ)))
    (hvvp : ∀ p, vvp p = (θ₁ p - ∑ j, u j * ((NumberField.mixedEmbedding K
        (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg) / (2 * Real.pi) - Δθ)
    (hthp : ∀ p, thp p = min ((θ₂ p - θ₁ p) / (2 * Real.pi) + 2 * Δθ) 1)
    (hvvm : ∀ p, vvm p = (θ₁ p - ∑ j, u j * ((NumberField.mixedEmbedding K
        (((H j : NumberField.RingOfIntegers K)) : K)).2 p).arg) / (2 * Real.pi) + Δθ)
    (hthm : ∀ p, thm p = (θ₂ p - θ₁ p) / (2 * Real.pi) - 2 * Δθ)
    (hx0p : x0p = max (kaiTBEminus K H a b ρ σ u * Real.exp (-(2 * Δ))) T)
    (hx1p : x1p = max (kaiTBEplus K H a b ρ σ u * Real.exp Δ) x0p)
    (hx0m : x0m = max (kaiTBEminus K H a b ρ σ u * Real.exp Δ) T)
    (hx1m : x1m = max (kaiTBEplus K H a b ρ σ u * Real.exp (-(2 * Δ))) x0m) :
    (0 ≤ ∑' π : {π : NumberField.RingOfIntegers K //
          (Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
            π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ)) ∧
          ∀ j, kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
            ∈ Set.Ioc (u j) (u j + 1 / (l : ℝ))},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) ∧
    ((∑' π : {π : NumberField.RingOfIntegers K //
          (Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
            π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ)) ∧
          ∀ j, kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
            ∈ Set.Ioc (u j) (u j + 1 / (l : ℝ))},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      ≤ (∑' π : {π : NumberField.RingOfIntegers K //
            KaiTBMem K q H e α sgn u (fun _ => 1 / (l : ℝ)) vvp thp x1p π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        - (∑' π : {π : NumberField.RingOfIntegers K //
            KaiTBMem K q H e α sgn u (fun _ => 1 / (l : ℝ)) vvp thp x0p π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))) ∧
    ((∀ p, 0 < thm p) →
      (∑' π : {π : NumberField.RingOfIntegers K //
            KaiTBMem K q H e α sgn u (fun _ => 1 / (l : ℝ)) vvm thm x1m π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        - (∑' π : {π : NumberField.RingOfIntegers K //
            KaiTBMem K q H e α sgn u (fun _ => 1 / (l : ℝ)) vvm thm x0m π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      ≤ ∑' π : {π : NumberField.RingOfIntegers K //
          (Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
            π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ)) ∧
          ∀ j, kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
            ∈ Set.Ioc (u j) (u j + 1 / (l : ℝ))},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) ∧
    (kaiTBEplus K H a b ρ σ u * Real.exp (3 * Δ) < kaiTBEminus K H a b ρ σ u →
      (∑' π : {π : NumberField.RingOfIntegers K //
          (Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
            π - α ∈ q ∧ T < ((Algebra.norm ℤ π).natAbs : ℝ)) ∧
          ∀ j, kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
            ∈ Set.Ioc (u j) (u j + 1 / (l : ℝ))},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) = 0) :=
by
  classical
  
  have hn0 : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hn1 : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn0
  have hL1 : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
  have hL0 : (0 : ℝ) < (l : ℝ) := by linarith only [hL1]
  have hr0 : (0 : ℝ) ≤ (NumberField.Units.rank K : ℝ) := Nat.cast_nonneg _
  have hinvL : (0 : ℝ) < 1 / (l : ℝ) := one_div_pos.mpr hL0
  have hΛ₀ : ∀ (j : Fin (NumberField.Units.rank K)) (w : NumberField.InfinitePlace K),
      |Real.log (w (((H j : NumberField.RingOfIntegers K)) : K))|
        ≤ B * (Ideal.absNorm q : ℝ) := by
    intro j w
    have h5 := hdata.2.2.2.2.1 j w
    simp only [kaiTBUnitLog] at h5
    rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)] at h5
    have hm : (1 : ℝ) ≤ (w.mult : ℝ) := Nat.one_le_cast.mpr NumberField.InfinitePlace.mult_pos
    exact le_trans (le_mul_of_one_le_left (abs_nonneg _) hm) h5
  have hnrΛ : 0 ≤ (Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ)
      * (B * (Ideal.absNorm q : ℝ)) := by
    by_cases hr : NumberField.Units.rank K = 0
    · rw [hr]; simp
    · have hrpos : 0 < NumberField.Units.rank K := Nat.pos_of_ne_zero hr
      obtain ⟨j₀⟩ : Nonempty (Fin (NumberField.Units.rank K)) := Fin.pos_iff_nonempty.mp hrpos
      obtain ⟨w₀⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
      have hΛ₀0 : 0 ≤ B * (Ideal.absNorm q : ℝ) := le_trans (abs_nonneg _) (hΛ₀ j₀ w₀)
      exact mul_nonneg (mul_nonneg (by linarith only [hn1]) hr0) hΛ₀0
  obtain ⟨Λ, hΛdef⟩ : ∃ Λ : ℝ, Λ = (Module.finrank ℚ K : ℝ) * (NumberField.Units.rank K : ℝ)
      * (B * (Ideal.absNorm q : ℝ)) * (1 / (l : ℝ)) := ⟨_, rfl⟩
