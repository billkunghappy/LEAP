    rw [Finset.sum_const, hG, nsmul_eq_mul]
    push_cast
    have hpow : (Ideal.absNorm 𝔟 : ℝ) ^ Module.finrank ℚ K
        = (Ideal.absNorm 𝔟 : ℝ) ^ (Module.finrank ℚ K - 1) * (Ideal.absNorm 𝔟 : ℝ) := by
      rw [← pow_succ, Nat.sub_add_cancel hn]
    rw [hpow]
    have : (Ideal.absNorm 𝔟 : ℝ) ^ (Module.finrank ℚ K - 1) ≠ 0 := by positivity
    field_simp
  rw [hvol, ← Finset.sum_sub_distrib]
  calc _ ≤ _ := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ r ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
            (fun r => ω.equivFun.symm r - b ∈ 𝔟)
            (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔟)),
          Cd * 4 ^ (Module.finrank ℚ K - 1)
            * ((R : ℝ) / (Ideal.absNorm 𝔟 : ℝ)) ^ (Module.finrank ℚ K - 1) :=
        Finset.sum_le_sum (fun r _ => hper r)
    _ = (Ideal.absNorm 𝔟 : ℝ) ^ (Module.finrank ℚ K - 1) * (Cd * 4 ^ (Module.finrank ℚ K - 1)
            * ((R : ℝ) / (Ideal.absNorm 𝔟 : ℝ)) ^ (Module.finrank ℚ K - 1)) := by
        rw [Finset.sum_const, hG, nsmul_eq_mul]; push_cast; ring
    _ = Cd * 4 ^ (Module.finrank ℚ K - 1) * (R : ℝ) ^ (Module.finrank ℚ K - 1) := by
        have : (Ideal.absNorm 𝔟 : ℝ) ^ (Module.finrank ℚ K - 1) ≠ 0 := by positivity
        rw [div_pow]; field_simp

theorem kai_slab_volume (n : ℕ) (a : Fin n → ℝ) (j₀ : Fin n) (ha : a j₀ ≠ 0) (A h : ℝ)
    (hA : 0 ≤ A) (hh : 0 ≤ h) :
    MeasureTheory.volume {v : Fin n → ℝ | (∀ j, |v j| ≤ A) ∧ |∑ j, a j * v j| < h}
      ≤ ENNReal.ofReal (2 * h * (2 * A) ^ (n - 1) / |a j₀|) :=
by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Fin.pos j₀).ne'
  rw [Nat.succ_sub_one]
  set S : Set (Fin (m+1) → ℝ) := {v | (∀ j, |v j| ≤ A) ∧ |∑ j, a j * v j| < h} with hS_def
  have hSm : MeasurableSet S := by
    rw [hS_def, Set.setOf_and]
    apply MeasurableSet.inter
    · have : {v : Fin (m+1) → ℝ | ∀ j, |v j| ≤ A} = ⋂ j, {v | |v j| ≤ A} := by
        ext v; simp
      rw [this]
      exact MeasurableSet.iInter fun j => measurableSet_le (by fun_prop) measurable_const
    · exact measurableSet_lt (by fun_prop) measurable_const
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (m+1) => ℝ) j₀
  have hmp : MeasureTheory.MeasurePreserving e.symm MeasureTheory.volume MeasureTheory.volume :=
    (MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin (m+1) => ℝ) j₀).symm
  set T := e.symm ⁻¹' S with hT_def
  have hTS : MeasureTheory.volume T = MeasureTheory.volume S := hmp.measure_preimage_equiv S
  have hTm : MeasurableSet T := e.symm.measurable hSm
  have he : ∀ t (y : Fin m → ℝ), e.symm (t, y) = j₀.insertNth t y := by
    intro t y
    simp only [e, MeasurableEquiv.piFinSuccAbove_symm_apply]
    rfl
  set κ := ENNReal.ofReal (2 * h / |a j₀|) with hκ
  set Q : Set (Fin m → ℝ) := {y | ∀ k, |y k| ≤ A} with hQ
  have hsum : ∀ t (y : Fin m → ℝ), ∑ j, a j * j₀.insertNth t y j
      = a j₀ * t + ∑ k, a (j₀.succAbove k) * y k := by
    intro t y
    rw [Fin.sum_univ_succAbove _ j₀]
    simp
  have hslice : ∀ y : Fin m → ℝ,
      MeasureTheory.volume ((fun t => (t, y)) ⁻¹' T) ≤ Q.indicator (fun _ => κ) y := by
    intro y
    by_cases hy : y ∈ Q
    · rw [Set.indicator_of_mem hy]
      set c := ∑ k, a (j₀.succAbove k) * y k with hc
      have hsub : (fun t => (t, y)) ⁻¹' T ⊆ Metric.ball (-c / a j₀) (h / |a j₀|) := by
        intro t ht
        simp only [Set.mem_preimage, hT_def, he, hS_def, Set.mem_setOf_eq] at ht
        have h1 := ht.2
        rw [hsum] at h1
        rw [Metric.mem_ball, Real.dist_eq]
        have hapos : 0 < |a j₀| := abs_pos.mpr ha
        rw [lt_div_iff₀ hapos]
        have hx : (t - -c / a j₀) * a j₀ = a j₀ * t + c := by field_simp; ring
        calc |t - -c / a j₀| * |a j₀| = |(t - -c / a j₀) * a j₀| := (abs_mul _ _).symm
          _ = |a j₀ * t + c| := by rw [hx]
          _ < h := h1
      calc MeasureTheory.volume ((fun t => (t, y)) ⁻¹' T)
          ≤ MeasureTheory.volume (Metric.ball (-c / a j₀) (h / |a j₀|)) :=
            MeasureTheory.measure_mono hsub
        _ = κ := by rw [Real.volume_ball, hκ]; congr 1; ring
    · rw [Set.indicator_of_notMem hy]
      have hempty : (fun t => (t, y)) ⁻¹' T = ∅ := by
        ext t
        simp only [Set.mem_preimage, hT_def, he, hS_def, Set.mem_setOf_eq,
          Set.mem_empty_iff_false, iff_false]
        intro ht
        apply hy
        intro k
        have := ht.1 (j₀.succAbove k)
        simpa using this
      rw [hempty, MeasureTheory.measure_empty]
  have hQvol : MeasureTheory.volume Q = ENNReal.ofReal ((2 * A) ^ m) := by
    have hQI : Q = Set.Icc (fun _ => -A) (fun _ => A) := by
      ext y; simp [hQ, Set.mem_Icc, Pi.le_def, abs_le, forall_and]
    rw [hQI, Real.volume_Icc_pi]
    simp only [sub_neg_eq_add, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    rw [← ENNReal.ofReal_pow (by linarith : (0:ℝ) ≤ A + A)]
    congr 1; ring
  calc MeasureTheory.volume S = MeasureTheory.volume T := hTS.symm
    _ = ∫⁻ y, MeasureTheory.volume ((fun t => (t, y)) ⁻¹' T) := by
        rw [MeasureTheory.Measure.volume_eq_prod]
        exact MeasureTheory.Measure.prod_apply_symm hTm
    _ ≤ ∫⁻ y, Q.indicator (fun _ => κ) y := MeasureTheory.lintegral_mono hslice
    _ ≤ κ * MeasureTheory.volume Q := MeasureTheory.lintegral_indicator_const_le Q κ
    _ = ENNReal.ofReal (2 * h * (2 * A) ^ m / |a j₀|) := by
        rw [hQvol, hκ, ← ENNReal.ofReal_mul (by positivity)]
        congr 1; ring

theorem kai_weight_integral_bounds (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ CW : ℝ, 0 ≤ CW ∧
      ∀ (R : ℝ), 1 ≤ R → ∀ (γ : ℝ), 1 / 2 ≤ γ → γ ≤ 1 →
        MeasureTheory.IntegrableOn
            (fun v => (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ (γ - 1))
            (realBox (Module.finrank ℚ K) R) ∧
        ∀ (A : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet A →
          A ⊆ realBox (Module.finrank ℚ K) R →
          ∫ v in A, (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ (γ - 1)
            ≤ (MeasureTheory.volume A).toReal + CW * R ^ ((Module.finrank ℚ K : ℝ) / 2) :=
by
  classical
  letI : Fintype {w : NumberField.InfinitePlace K // w.IsReal} := Fintype.ofFinite _
  letI : Fintype {w : NumberField.InfinitePlace K // w.IsComplex} := Fintype.ofFinite _
  obtain ⟨covol, hcov, hmix⟩ := kai_omega_mixed_change K
  obtain ⟨-, hLinj, -, -, -, hLvol, hLint, -⟩ := hmix ω
  obtain ⟨CW₀, hCW₀, hbox⟩ := kai_norm_rpow_box_bound K
  
  obtain ⟨c₀, hc₀_def⟩ : ∃ c₀ : ℝ, c₀ = ∑ w : NumberField.InfinitePlace K,
      ∑ j, NumberField.mixedEmbedding.normAtPlace w
        (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) := ⟨_, rfl⟩
  have hc₀ : 0 ≤ c₀ := by
    rw [hc₀_def]
    exact Finset.sum_nonneg (fun w _ => Finset.sum_nonneg
      (fun j _ => NumberField.mixedEmbedding.normAtPlace_nonneg _ _))
  have hplace : ∀ (R : ℝ), 0 ≤ R → ∀ v : Fin (Module.finrank ℚ K) → ℝ, (∀ j, |v j| ≤ R) →
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v) ≤ c₀ * R := by
    intro R hR v hv w
    have h1 : NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v)
        ≤ ∑ j, NumberField.mixedEmbedding.normAtPlace w
          (v j • NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) := by
      unfold kaiOmegaEmb
      exact Finset.le_sum_of_subadditive _ (le_of_eq (map_zero _))
        (NumberField.mixedEmbedding.normAtPlace_add_le w) _ _
    have h2 : ∑ j, NumberField.mixedEmbedding.normAtPlace w
          (v j • NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K))
        ≤ ∑ j, R * NumberField.mixedEmbedding.normAtPlace w
          (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) := by
      apply Finset.sum_le_sum
      intro j _
      rw [NumberField.mixedEmbedding.normAtPlace_smul]
      exact mul_le_mul_of_nonneg_right (hv j) (NumberField.mixedEmbedding.normAtPlace_nonneg _ _)
    have h3 : ∑ j, NumberField.mixedEmbedding.normAtPlace w
          (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) ≤ c₀ := by
      rw [hc₀_def]
      exact Finset.single_le_sum (f := fun w => ∑ j, NumberField.mixedEmbedding.normAtPlace w
          (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)))
        (fun w _ => Finset.sum_nonneg
          (fun j _ => NumberField.mixedEmbedding.normAtPlace_nonneg _ _))
        (Finset.mem_univ w)
    rw [← Finset.mul_sum] at h2
    calc _ ≤ _ := h1
      _ ≤ _ := h2
      _ ≤ R * c₀ := mul_le_mul_of_nonneg_left h3 hR
      _ = c₀ * R := mul_comm _ _
  
  have hLcont : Continuous (fun v : Fin (Module.finrank ℚ K) → ℝ => kaiOmegaEmb ω v) := by
    have hfun : (fun v : Fin (Module.finrank ℚ K) → ℝ => kaiOmegaEmb ω v)
        = fun v => ∑ j, v j • NumberField.mixedEmbedding K
            ((ω j : NumberField.RingOfIntegers K) : K) := by
      funext v; rfl
    rw [hfun]
    exact continuous_finset_sum _ (fun j _ => (continuous_apply j).smul continuous_const)
  have hmeasIm : ∀ A : Set (Fin (Module.finrank ℚ K) → ℝ), MeasurableSet A →
      MeasurableSet (kaiOmegaEmb ω '' A) :=
    fun A hA => hA.image_of_continuousOn_injOn hLcont.continuousOn hLinj.injOn
  have hmeasF : ∀ γ : ℝ, Measurable (fun v : Fin (Module.finrank ℚ K) → ℝ =>
      (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ γ) := fun γ =>
    (((NumberField.mixedEmbedding.continuous_norm K).comp hLcont).measurable).pow_const γ
  
  have s5 : ∀ (f : (Fin (Module.finrank ℚ K) → ℝ) → ℝ), Measurable f → (∀ x, 0 ≤ f x) →
      ∀ (B : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet B →
      MeasureTheory.volume B ≠ ⊤ →
      ∀ C : ℝ, (∀ A : Set (Fin (Module.finrank ℚ K) → ℝ), MeasurableSet A → A ⊆ B →
        ∫ x in A, f x ≤ C) →
      MeasureTheory.IntegrableOn f B := by
    intro f hf hf0 B hB hμB C hC
    refine ⟨hf.aestronglyMeasurable, ?_⟩
    rw [MeasureTheory.hasFiniteIntegral_iff_ofReal (MeasureTheory.ae_of_all _ hf0)]
    have hAm : ∀ k : ℕ, MeasurableSet (B ∩ {x | f x ≤ (k : ℝ)}) := fun k =>
      hB.inter (measurableSet_le hf measurable_const)
    have hbd : ∀ k : ℕ, ∫⁻ x in B ∩ {x | f x ≤ (k : ℝ)}, ENNReal.ofReal (f x)
        ≤ ENNReal.ofReal C := by
      intro k
      have hint : MeasureTheory.IntegrableOn f (B ∩ {x | f x ≤ (k : ℝ)}) := by
        refine MeasureTheory.Measure.integrableOn_of_bounded (M := (k : ℝ))
          (ne_top_of_le_ne_top hμB (MeasureTheory.measure_mono Set.inter_subset_left))
          hf.aestronglyMeasurable ?_
        rw [MeasureTheory.ae_restrict_iff' (hAm k)]
        refine MeasureTheory.ae_of_all _ (fun x hx => ?_)
        rw [Real.norm_eq_abs, abs_of_nonneg (hf0 x)]
        exact hx.2
      rw [← MeasureTheory.ofReal_integral_eq_lintegral_ofReal hint
        (MeasureTheory.ae_of_all _ hf0)]
      exact ENNReal.ofReal_le_ofReal (hC _ (hAm k) Set.inter_subset_left)
    have hU : B = ⋃ k : ℕ, (B ∩ {x | f x ≤ (k : ℝ)}) := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_inter_iff, Set.mem_setOf_eq]
      constructor
      · intro hx
        obtain ⟨k, hk⟩ := exists_nat_ge (f x)
        exact ⟨k, hx, hk⟩
      · rintro ⟨k, hx, -⟩
        exact hx
    have hmono : Monotone (fun k : ℕ => B ∩ {x | f x ≤ (k : ℝ)}) := by
      intro i j hij x hx
      refine ⟨hx.1, ?_⟩
      have hij' : (i : ℝ) ≤ (j : ℝ) := by exact_mod_cast hij
      have hx2 : f x ≤ (i : ℝ) := hx.2
      show f x ≤ (j : ℝ)
      exact le_trans hx2 hij'
    rw [hU, MeasureTheory.setLIntegral_iUnion_of_directed _ hmono.directed_le]
    exact lt_of_le_of_lt (iSup_le hbd) ENNReal.ofReal_lt_top
  
  obtain ⟨CW, hCW_def⟩ : ∃ CW : ℝ,
      CW = CW₀ * (c₀ + 1) ^ ((Module.finrank ℚ K : ℝ) / 2) / covol := ⟨_, rfl⟩
  have hP0 : 0 ≤ (c₀ + 1) ^ ((Module.finrank ℚ K : ℝ) / 2) := Real.rpow_nonneg (by linarith) _
  have hCW : 0 ≤ CW := by rw [hCW_def]; exact div_nonneg (mul_nonneg hCW₀ hP0) hcov.le
  have hcovCW : covol * CW = CW₀ * (c₀ + 1) ^ ((Module.finrank ℚ K : ℝ) / 2) := by
    rw [hCW_def]; field_simp
  refine ⟨CW, hCW, ?_⟩
  intro R hR γ hγ1 hγ2
  have hR0 : 0 ≤ R := by linarith
  have hh : (0:ℝ) ≤ (Module.finrank ℚ K : ℝ) / 2 := by positivity
  
  obtain ⟨X, hX_def⟩ : ∃ X : ℝ, X = c₀ * R + 1 := ⟨_, rfl⟩
  have hc₀R : 0 ≤ c₀ * R := mul_nonneg hc₀ hR0
  have hX1 : 1 ≤ X := by rw [hX_def]; linarith
  have hXle : X ≤ (c₀ + 1) * R := by rw [hX_def]; nlinarith
  have hXpow : X ^ ((Module.finrank ℚ K : ℝ) / 2)
      ≤ (c₀ + 1) ^ ((Module.finrank ℚ K : ℝ) / 2) * R ^ ((Module.finrank ℚ K : ℝ) / 2) := by
    rw [← Real.mul_rpow (by linarith) hR0]
    exact Real.rpow_le_rpow (by linarith) hXle hh
  have himg : ∀ A : Set (Fin (Module.finrank ℚ K) → ℝ), A ⊆ realBox (Module.finrank ℚ K) R →
      kaiOmegaEmb ω '' A ⊆ {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X} := by
    intro A hA z hz
    obtain ⟨v, hv, rfl⟩ := hz
    rw [Set.mem_setOf_eq]
    intro w
    have hv' := hA hv
    simp only [realBox, Set.mem_setOf_eq] at hv'
    have := hplace R hR0 v hv' w
    rw [hX_def]
    linarith
  
  have hb : ∀ A : Set (Fin (Module.finrank ℚ K) → ℝ), MeasurableSet A →
      A ⊆ realBox (Module.finrank ℚ K) R →
      ∫ v in A, (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ (γ - 1)
        ≤ (MeasureTheory.volume A).toReal + CW * R ^ ((Module.finrank ℚ K : ℝ) / 2) := by
    intro A hA hAsub
    have h1 := (hbox X (γ - 1) hX1 (by linarith) (by linarith)).2 (kaiOmegaEmb ω '' A)
      (hmeasIm A hA) (himg A hAsub)
    rw [hLint A (γ - 1) hA, hLvol A] at h1
    have h2 : CW₀ * X ^ ((Module.finrank ℚ K : ℝ) / 2)
        ≤ covol * (CW * R ^ ((Module.finrank ℚ K : ℝ) / 2)) := by
      have he : covol * (CW * R ^ ((Module.finrank ℚ K : ℝ) / 2))
          = CW₀ * ((c₀ + 1) ^ ((Module.finrank ℚ K : ℝ) / 2)
              * R ^ ((Module.finrank ℚ K : ℝ) / 2)) := by
        rw [← mul_assoc, hcovCW, mul_assoc]
      rw [he]
      exact mul_le_mul_of_nonneg_left hXpow hCW₀
    have h3 : covol * ∫ v in A, (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ (γ - 1)
        ≤ covol * ((MeasureTheory.volume A).toReal
            + CW * R ^ ((Module.finrank ℚ K : ℝ) / 2)) := by
      rw [mul_add]; linarith
    exact le_of_mul_le_mul_left h3 hcov
  
  have hboxeq : realBox (Module.finrank ℚ K) R
      = Set.Icc (fun _ : Fin (Module.finrank ℚ K) => -R) (fun _ => R) := by
    ext v
    simp only [realBox, Set.mem_setOf_eq, Set.mem_Icc, Pi.le_def, abs_le, forall_and]
  have hBm : MeasurableSet (realBox (Module.finrank ℚ K) R) := by
    rw [hboxeq]; exact measurableSet_Icc
  have hBfin : MeasureTheory.volume (realBox (Module.finrank ℚ K) R) ≠ ⊤ := by
    rw [hboxeq, Real.volume_Icc_pi]
    exact ENNReal.prod_ne_top (fun _ _ => ENNReal.ofReal_ne_top)
  refine ⟨?_, hb⟩
  refine s5 _ (hmeasF (γ - 1))
    (fun v => Real.rpow_nonneg (NumberField.mixedEmbedding.norm_nonneg _) _) _ hBm hBfin
    ((MeasureTheory.volume (realBox (Module.finrank ℚ K) R)).toReal
      + CW * R ^ ((Module.finrank ℚ K : ℝ) / 2)) ?_
  intro A hA hAsub
  have hle : (MeasureTheory.volume A).toReal
      ≤ (MeasureTheory.volume (realBox (Module.finrank ℚ K) R)).toReal :=
    ENNReal.toReal_mono hBfin (MeasureTheory.measure_mono hAsub)
  refine le_trans (hb A hA hAsub) ?_
  linarith

theorem kai_omega_place_facts (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ cL : ℝ, 0 < cL ∧
      (∀ (w : NumberField.InfinitePlace K) (v v' : Fin (Module.finrank ℚ K) → ℝ) (R : ℝ),
        (∀ j, |v j - v' j| ≤ R) →
        |NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v)
          - NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v')| ≤ cL * R) ∧
      (∀ w : NumberField.InfinitePlace K, ∃ (a : Fin (Module.finrank ℚ K) → ℝ)
          (j₀ : Fin (Module.finrank ℚ K)), a j₀ ≠ 0 ∧
        ∀ v : Fin (Module.finrank ℚ K) → ℝ,
          |∑ j, a j * v j| ≤ NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v)) ∧
      (∀ x : NumberField.RingOfIntegers K,
        NumberField.mixedEmbedding.norm (kaiOmegaEmb ω (fun j => ((ω.equivFun x j : ℤ) : ℝ)))
          = ((Algebra.norm ℤ x).natAbs : ℝ)) :=
by
  classical
  
  have hL : ∀ x : NumberField.RingOfIntegers K,
      kaiOmegaEmb ω (fun j => ((ω.equivFun x j : ℤ) : ℝ))
        = NumberField.mixedEmbedding K (x : K) := by
    intro x
    have h1 : ((x : NumberField.RingOfIntegers K) : K)
        = ∑ j, (ω.equivFun x j) • ((ω j : NumberField.RingOfIntegers K) : K) := by
      conv_lhs => rw [← ω.sum_equivFun x]
      rw [NumberField.RingOfIntegers.coe_eq_algebraMap, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_zsmul, NumberField.RingOfIntegers.coe_eq_algebraMap]
    rw [h1, map_sum]
    unfold kaiOmegaEmb
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_zsmul, Int.cast_smul_eq_zsmul]
  have hnn : ∀ (w : NumberField.InfinitePlace K) (j : Fin (Module.finrank ℚ K)),
      0 ≤ NumberField.mixedEmbedding.normAtPlace w
        (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) :=
    fun w j => NumberField.mixedEmbedding.normAtPlace_nonneg _ _
  have hS : 0 ≤ ∑ w : NumberField.InfinitePlace K, ∑ j, NumberField.mixedEmbedding.normAtPlace w
        (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) :=
    Finset.sum_nonneg (fun w _ => Finset.sum_nonneg (fun j _ => hnn w j))
  refine ⟨1 + ∑ w : NumberField.InfinitePlace K, ∑ j, NumberField.mixedEmbedding.normAtPlace w
        (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)),
    by linarith, ?_, ?_, ?_⟩
  · 
    intro w v v' R h
    have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
    have hR : 0 ≤ R := le_trans (abs_nonneg _) (h ⟨0, hn⟩)
    have hsub : kaiOmegaEmb ω v - kaiOmegaEmb ω v'
        = ∑ j, (v j - v' j) •
            NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K) := by
      unfold kaiOmegaEmb
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [sub_smul]
    have hrev : |NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v)
          - NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v')|
        ≤ NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v - kaiOmegaEmb ω v') := by
      have h1 := NumberField.mixedEmbedding.normAtPlace_add_le w
        (kaiOmegaEmb ω v - kaiOmegaEmb ω v') (kaiOmegaEmb ω v')
      have h2 := NumberField.mixedEmbedding.normAtPlace_add_le w
        (kaiOmegaEmb ω v' - kaiOmegaEmb ω v) (kaiOmegaEmb ω v)
      rw [sub_add_cancel] at h1 h2
      rw [← neg_sub, NumberField.mixedEmbedding.normAtPlace_neg] at h2
      rw [abs_sub_le_iff]; constructor <;> linarith
    have hsum : NumberField.mixedEmbedding.normAtPlace w (∑ j, (v j - v' j) •
            NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K))
        ≤ ∑ j, NumberField.mixedEmbedding.normAtPlace w ((v j - v' j) •
            NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) :=
      Finset.le_sum_of_subadditive (⇑(NumberField.mixedEmbedding.normAtPlace w))
        (by rw [map_zero]) (NumberField.mixedEmbedding.normAtPlace_add_le w) _ _
    have hterm : ∑ j, NumberField.mixedEmbedding.normAtPlace w ((v j - v' j) •
            NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K))
        ≤ R * ∑ j, NumberField.mixedEmbedding.normAtPlace w
            (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun j _ => ?_)
      rw [NumberField.mixedEmbedding.normAtPlace_smul]
      exact mul_le_mul_of_nonneg_right (h j) (hnn w j)
    have hsw : ∑ j, NumberField.mixedEmbedding.normAtPlace w
            (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K))
        ≤ ∑ w' : NumberField.InfinitePlace K, ∑ j, NumberField.mixedEmbedding.normAtPlace w'
            (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) :=
      Finset.single_le_sum
        (f := fun w' : NumberField.InfinitePlace K => ∑ j, NumberField.mixedEmbedding.normAtPlace w'
            (NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)))
        (fun w' _ => Finset.sum_nonneg (fun j _ => hnn w' j)) (Finset.mem_univ w)
    rw [hsub] at hrev
    have hfin := mul_le_mul_of_nonneg_left hsw hR
    nlinarith
  · 
    intro w
    have hone : kaiOmegaEmb ω (fun j => ((ω.equivFun 1 j : ℤ) : ℝ)) = 1 := by
      rw [hL 1]; simp
    by_cases hw : w.IsReal
    · have hcoord : ∀ v : Fin (Module.finrank ℚ K) → ℝ, (kaiOmegaEmb ω v).1 ⟨w, hw⟩
          = ∑ j, (NumberField.mixedEmbedding K
              ((ω j : NumberField.RingOfIntegers K) : K)).1 ⟨w, hw⟩ * v j := by
        intro v
        unfold kaiOmegaEmb
        rw [Prod.fst_sum, Finset.sum_apply]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Prod.smul_fst, Pi.smul_apply, smul_eq_mul, mul_comm]
      have hval := hcoord (fun j => ((ω.equivFun 1 j : ℤ) : ℝ))
      rw [hone, Prod.fst_one, Pi.one_apply] at hval
      obtain ⟨j₀, -, hj₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero (s := Finset.univ)
        (show ∑ j, (NumberField.mixedEmbedding K
              ((ω j : NumberField.RingOfIntegers K) : K)).1 ⟨w, hw⟩
              * ((ω.equivFun 1 j : ℤ) : ℝ) ≠ 0 by rw [← hval]; exact one_ne_zero)
      refine ⟨fun j => (NumberField.mixedEmbedding K
          ((ω j : NumberField.RingOfIntegers K) : K)).1 ⟨w, hw⟩, j₀,
        left_ne_zero_of_mul hj₀, fun v => ?_⟩
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw, Real.norm_eq_abs, hcoord]
    · have hw' : w.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.1 hw
      have hcoord : ∀ v : Fin (Module.finrank ℚ K) → ℝ, ((kaiOmegaEmb ω v).2 ⟨w, hw'⟩).re
          = ∑ j, ((NumberField.mixedEmbedding K
              ((ω j : NumberField.RingOfIntegers K) : K)).2 ⟨w, hw'⟩).re * v j := by
        intro v
        unfold kaiOmegaEmb
        rw [Prod.snd_sum, Finset.sum_apply, Complex.re_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Prod.smul_snd, Pi.smul_apply, Complex.smul_re, smul_eq_mul, mul_comm]
      have hval := hcoord (fun j => ((ω.equivFun 1 j : ℤ) : ℝ))
      rw [hone, Prod.snd_one, Pi.one_apply, Complex.one_re] at hval
      obtain ⟨j₀, -, hj₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero (s := Finset.univ)
        (show ∑ j, ((NumberField.mixedEmbedding K
              ((ω j : NumberField.RingOfIntegers K) : K)).2 ⟨w, hw'⟩).re
              * ((ω.equivFun 1 j : ℤ) : ℝ) ≠ 0 by rw [← hval]; exact one_ne_zero)
      refine ⟨fun j => ((NumberField.mixedEmbedding K
          ((ω j : NumberField.RingOfIntegers K) : K)).2 ⟨w, hw'⟩).re, j₀,
        left_ne_zero_of_mul hj₀, fun v => ?_⟩
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw', ← hcoord]
      exact Complex.abs_re_le_norm _
  · 
    intro x
    rw [hL x, NumberField.mixedEmbedding.norm_eq_norm, ← Algebra.coe_norm_int,
      Nat.cast_natAbs]
    push_cast
    rfl

theorem kai_norm_oscillation (K : Type u) [Field K] [NumberField K]
    (z z' : NumberField.mixedEmbedding.mixedSpace K) (D δ γ : ℝ)
    (hD : 1 ≤ D) (hδ : 0 ≤ δ) (hγ1 : 1 / 2 ≤ γ) (hγ2 : γ ≤ 1)
    (hz : ∀ w : NumberField.InfinitePlace K, D ≤ NumberField.mixedEmbedding.normAtPlace w z)
    (hz' : ∀ w : NumberField.InfinitePlace K, D ≤ NumberField.mixedEmbedding.normAtPlace w z')
    (hzz : ∀ w : NumberField.InfinitePlace K,
      |NumberField.mixedEmbedding.normAtPlace w z - NumberField.mixedEmbedding.normAtPlace w z'|
        ≤ δ * D) :
    0 ≤ (NumberField.mixedEmbedding.norm z) ^ (γ - 1) ∧
    (NumberField.mixedEmbedding.norm z) ^ (γ - 1) ≤ 1 ∧
    |(NumberField.mixedEmbedding.norm z) ^ (γ - 1) - (NumberField.mixedEmbedding.norm z') ^ (γ - 1)|
      ≤ (1 + δ) ^ (Module.finrank ℚ K) - 1 :=
by
  classical
  have hδ1 : (1:ℝ) ≤ 1 + δ := by linarith
  
  have ratio : ∀ u u' : NumberField.mixedEmbedding.mixedSpace K,
      (∀ w : NumberField.InfinitePlace K, D ≤ NumberField.mixedEmbedding.normAtPlace w u) →
      (∀ w : NumberField.InfinitePlace K,
        |NumberField.mixedEmbedding.normAtPlace w u - NumberField.mixedEmbedding.normAtPlace w u'|
          ≤ δ * D) →
      1 ≤ NumberField.mixedEmbedding.norm u ∧
      NumberField.mixedEmbedding.norm u'
        ≤ (1 + δ) ^ (Module.finrank ℚ K) * NumberField.mixedEmbedding.norm u := by
    intro u u' hu huu
    rw [NumberField.mixedEmbedding.norm_apply, NumberField.mixedEmbedding.norm_apply]
    constructor
    · calc (1:ℝ) = ∏ w : NumberField.InfinitePlace K, (1:ℝ) := by simp
        _ ≤ ∏ w, NumberField.mixedEmbedding.normAtPlace w u ^ w.mult := by
          apply Finset.prod_le_prod
          · intro w _; norm_num
          · intro w _; exact one_le_pow₀ (hD.trans (hu w))
    · have hfac : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
          NumberField.mixedEmbedding.normAtPlace w u' ^ w.mult ≤
            (1 + δ) ^ w.mult * NumberField.mixedEmbedding.normAtPlace w u ^ w.mult := by
        intro w _
        rw [← mul_pow]
        apply pow_le_pow_left₀ (NumberField.mixedEmbedding.normAtPlace_nonneg w u')
        have h1 := (abs_le.mp (huu w)).1
        have h2 : δ * D ≤ δ * NumberField.mixedEmbedding.normAtPlace w u :=
          mul_le_mul_of_nonneg_left (hu w) hδ
        nlinarith
      calc ∏ w, NumberField.mixedEmbedding.normAtPlace w u' ^ w.mult
          ≤ ∏ w, (1 + δ) ^ w.mult * NumberField.mixedEmbedding.normAtPlace w u ^ w.mult :=
            Finset.prod_le_prod
              (fun w _ => pow_nonneg (NumberField.mixedEmbedding.normAtPlace_nonneg w u') _) hfac
        _ = (∏ w : NumberField.InfinitePlace K, (1 + δ) ^ w.mult) *
              ∏ w, NumberField.mixedEmbedding.normAtPlace w u ^ w.mult :=
            Finset.prod_mul_distrib
        _ = (1 + δ) ^ (Module.finrank ℚ K) *
              ∏ w, NumberField.mixedEmbedding.normAtPlace w u ^ w.mult := by
            rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
  obtain ⟨hN1, hN'le⟩ := ratio z z' hz hzz
  obtain ⟨hN'1, hNle⟩ := ratio z' z hz' (fun w => by rw [abs_sub_comm]; exact hzz w)
  have ha : (1:ℝ) ≤ (1 + δ) ^ (Module.finrank ℚ K) := one_le_pow₀ hδ1
  have hs0 : γ - 1 ≤ 0 := by linarith
  have hs1 : -1 ≤ γ - 1 := by linarith
  
  have star : ∀ u v a : ℝ, 1 ≤ u → 1 ≤ v → 1 ≤ a → v ≤ a * u →
      u ^ (γ - 1) - v ^ (γ - 1) ≤ a - 1 := by
    intro u v a hu hv ha hvu
    have hu0 : 0 < u := by linarith
    have hv0 : 0 < v := by linarith
    have ha0 : 0 < a := by linarith
    have e1 : (a * u) ^ (γ - 1) ≤ v ^ (γ - 1) := Real.rpow_le_rpow_of_nonpos hv0 hvu hs0
    rw [Real.mul_rpow ha0.le hu0.le] at e1
    have e2 : a ^ (-1:ℝ) ≤ a ^ (γ - 1) := Real.rpow_le_rpow_of_exponent_le ha hs1
    rw [Real.rpow_neg_one] at e2
    have e3 : 0 ≤ u ^ (γ - 1) := Real.rpow_nonneg hu0.le _
    have e4 : u ^ (γ - 1) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hu hs0
    have e5 : a⁻¹ * u ^ (γ - 1) ≤ a ^ (γ - 1) * u ^ (γ - 1) := mul_le_mul_of_nonneg_right e2 e3
    have hinv : a⁻¹ ≤ 1 := inv_le_one_of_one_le₀ ha
    have e6 : 0 ≤ 1 - a⁻¹ := by linarith
    have e7 : 1 - a⁻¹ ≤ a - 1 := by
      have heq : (a - 1) * a⁻¹ = 1 - a⁻¹ := by
        rw [sub_mul, mul_inv_cancel₀ ha0.ne', one_mul]
      rw [← heq]
      exact mul_le_of_le_one_right (by linarith) hinv
    have e8 : u ^ (γ - 1) * (1 - a⁻¹) ≤ 1 - a⁻¹ := by
      have := mul_le_mul_of_nonneg_right e4 e6
      linarith
    nlinarith
  refine ⟨Real.rpow_nonneg (NumberField.mixedEmbedding.norm_nonneg z) _,
    Real.rpow_le_one_of_one_le_of_nonpos hN1 hs0, ?_⟩
  rw [abs_sub_le_iff]
  exact ⟨star _ _ _ hN1 hN'1 ha hN'le, star _ _ _ hN'1 hN1 ha hNle⟩

theorem kai_cube_lipschitz_assembly {ι : Type*} (n : ℕ) (coords : ι → (Fin n → ℝ)) (F : Finset ι)
    (S : Set (Fin n → ℝ)) (hSm : MeasurableSet S)
    (f : (Fin n → ℝ) → ℝ) (hfi : MeasureTheory.IntegrableOn f S) (hf0 : ∀ v ∈ S, 0 ≤ f v)
    (ℓ K₀ : ℕ) (hℓ : 1 ≤ ℓ) (hcov : ∀ v ∈ S, ∀ j, |v j| < (ℓ : ℝ) * (K₀ : ℝ))
    (hFS : ∀ x ∈ F, coords x ∈ S) (hF1 : ∀ x ∈ F, f (coords x) ≤ 1)
    (q E₁ η VB E₂ : ℝ) (hq : 1 ≤ q) (hE₁ : 0 ≤ E₁) (hη : 0 ≤ η) (hE₂ : 0 ≤ E₂)
    (good : (Fin n → ℤ) → Prop)
    (hcnt : ∀ k ∈ intBox n K₀,
      |((@Finset.filter ι (fun x => coords x ∈ {v : Fin n → ℝ | ∀ j,
            (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)})
            (fun _ => Classical.propDecidable _) F).card : ℝ)
        - (MeasureTheory.volume (S ∩ {v : Fin n → ℝ | ∀ j,
            (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)})).toReal / q| ≤ E₁)
    (hgood : ∀ k ∈ intBox n K₀, good k → ∃ c : ℝ, 0 ≤ c ∧ c ≤ 1 ∧
      ∀ v ∈ {v : Fin n → ℝ | ∀ j, (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)},
        |f v - c| ≤ η)
    (hbadvol : (MeasureTheory.volume (S ∩ {v : Fin n → ℝ | ∃ k ∈ intBox n K₀, ¬ good k ∧
        ∀ j, (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)})).toReal ≤ VB)
    (hbadint : ∫ v in S ∩ {v : Fin n → ℝ | ∃ k ∈ intBox n K₀, ¬ good k ∧
        ∀ j, (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)}, f v
      ≤ (MeasureTheory.volume (S ∩ {v : Fin n → ℝ | ∃ k ∈ intBox n K₀, ¬ good k ∧
        ∀ j, (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)})).toReal + E₂) :
    |∑ x ∈ F, f (coords x) - (1 / q) * ∫ v in S, f v|
      ≤ η * ((F.card : ℝ) + (MeasureTheory.volume S).toReal / q)
        + ((intBox n K₀).card : ℝ) * E₁ + 2 * VB + E₂ :=
by
  classical
  have hLpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hℓ
  have hq0 : (0 : ℝ) < q := by linarith
  obtain ⟨Q, hQ⟩ : ∃ Q : (Fin n → ℤ) → Set (Fin n → ℝ), Q = fun k => {v : Fin n → ℝ | ∀ j,
      (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)} := ⟨_, rfl⟩
  obtain ⟨Fk, hFk⟩ : ∃ Fk : (Fin n → ℤ) → Finset ι, Fk = fun k =>
      @Finset.filter ι (fun x => coords x ∈ Q k) (fun _ => Classical.propDecidable _) F :=
    ⟨_, rfl⟩
  have memFk : ∀ k x, x ∈ Fk k ↔ x ∈ F ∧ coords x ∈ Q k := by
    intro k x; rw [hFk]; exact Finset.mem_filter
  have hFkF : ∀ k, Fk k ⊆ F := fun k x hx => ((memFk k x).1 hx).1
  have hcnt' : ∀ k ∈ intBox n K₀,
      |((Fk k).card : ℝ) - (MeasureTheory.volume (S ∩ Q k)).toReal / q| ≤ E₁ := by
    intro k hk
    subst hFk hQ
    exact hcnt k hk
  have hgood' : ∀ k ∈ intBox n K₀, good k → ∃ c : ℝ, 0 ≤ c ∧ c ≤ 1 ∧
      ∀ v ∈ Q k, |f v - c| ≤ η := by
    intro k hk hg
    subst hQ
    exact hgood k hk hg
  
  have hiff : ∀ (k : Fin n → ℤ) (v : Fin n → ℝ),
      v ∈ Q k ↔ (fun j => ⌊v j / (ℓ : ℝ)⌋) = k := by
    intro k v
    simp only [hQ, Set.mem_setOf_eq, funext_iff]
    refine forall_congr' (fun j => ?_)
    rw [Int.floor_eq_iff, le_div_iff₀ hLpos, div_lt_iff₀ hLpos]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
    · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
  have hbox : ∀ v : Fin n → ℝ, (∀ j, |v j| < (ℓ : ℝ) * (K₀ : ℝ)) →
      (fun j => ⌊v j / (ℓ : ℝ)⌋) ∈ intBox n K₀ := by
    intro v hv
    unfold intBox
    rw [Finset.mem_Icc]
    constructor
    · intro j
      have h := (abs_lt.mp (hv j)).1
      have h2 : -(K₀ : ℤ) ≤ ⌊v j / (ℓ : ℝ)⌋ := by
        rw [Int.le_floor, le_div_iff₀ hLpos]; push_cast; linarith
      simpa using h2
    · intro j
      have h := (abs_lt.mp (hv j)).2
      have h2 : ⌊v j / (ℓ : ℝ)⌋ < (K₀ : ℤ) := by
        rw [Int.floor_lt, div_lt_iff₀ hLpos]; push_cast; linarith
      simpa using h2.le
  have hQm : ∀ k, MeasurableSet (Q k) := by
    intro k
    have : Q k = Set.univ.pi (fun j => Set.Ico ((ℓ : ℝ) * (k j : ℝ)) ((ℓ : ℝ) * ((k j : ℝ) + 1))) := by
      ext v; simp [hQ, Set.mem_univ_pi, Set.mem_Ico]
    rw [this]; exact MeasurableSet.univ_pi (fun j => measurableSet_Ico)
  have hdisj : ∀ (k k' : Fin n → ℤ) (v : Fin n → ℝ), v ∈ Q k → v ∈ Q k' → k = k' := by
    intro k k' v h1 h2
    exact ((hiff k v).1 h1).symm.trans ((hiff k' v).1 h2)
  have hcovI : ∀ v ∈ S, ∃ k ∈ intBox n K₀, v ∈ Q k := by
    intro v hv
    exact ⟨_, hbox v (hcov v hv), (hiff _ v).2 rfl⟩
  have hSfin : MeasureTheory.volume S ≠ ⊤ := by
    have hsub : S ⊆ Set.Icc (fun _ : Fin n => -((ℓ : ℝ) * K₀)) (fun _ => (ℓ : ℝ) * K₀) := by
      intro v hv
      exact ⟨fun j => (abs_lt.mp (hcov v hv j)).1.le, fun j => (abs_lt.mp (hcov v hv j)).2.le⟩
    exact ne_top_of_le_ne_top measure_Icc_lt_top.ne (MeasureTheory.measure_mono hsub)
  
  have hQdisj : ∀ k k', k ≠ k' → Disjoint (Q k) (Q k') := by
    intro k k' hne
    rw [Set.disjoint_left]
    intro v h1 h2; exact hne (hdisj k k' v h1 h2)
  have hSQdisj : ∀ J : Finset (Fin n → ℤ),
      (↑J : Set (Fin n → ℤ)).PairwiseDisjoint (fun k => S ∩ Q k) := by
    intro J k _ k' _ hne
    exact (hQdisj k k' hne).mono Set.inter_subset_right Set.inter_subset_right
  have hFkdisj : ∀ J : Finset (Fin n → ℤ), (↑J : Set (Fin n → ℤ)).PairwiseDisjoint Fk := by
    intro J k _ k' _ hne
    show Disjoint (Fk k) (Fk k')
    rw [Finset.disjoint_left]
    intro x h1 h2
    exact hne (hdisj k k' (coords x) ((memFk k x).1 h1).2 ((memFk k' x).1 h2).2)
  have hSQm : ∀ k, MeasurableSet (S ∩ Q k) := fun k => hSm.inter (hQm k)
  have hSQfin : ∀ k, MeasureTheory.volume (S ∩ Q k) ≠ ⊤ := fun k =>
    ne_top_of_le_ne_top hSfin (MeasureTheory.measure_mono Set.inter_subset_left)
  have hSQi : ∀ k, MeasureTheory.IntegrableOn f (S ∩ Q k) := fun k =>
    hfi.mono_set Set.inter_subset_left
  have hU : ∀ J : Finset (Fin n → ℤ), S ∩ ⋃ k ∈ J, Q k = ⋃ k ∈ J, (S ∩ Q k) := fun J =>
    Set.inter_iUnion₂ _ _
  have P2 : ∀ J : Finset (Fin n → ℤ),
      ∫ v in S ∩ ⋃ k ∈ J, Q k, f v = ∑ k ∈ J, ∫ v in S ∩ Q k, f v := by
    intro J; rw [hU J]
    exact MeasureTheory.integral_biUnion_finset J (fun k _ => hSQm k) (hSQdisj J)
      (fun k _ => hSQi k)
  have P3 : ∀ J : Finset (Fin n → ℤ),
      (MeasureTheory.volume (S ∩ ⋃ k ∈ J, Q k)).toReal
        = ∑ k ∈ J, (MeasureTheory.volume (S ∩ Q k)).toReal := by
    intro J
    rw [hU J, MeasureTheory.measure_biUnion_finset (hSQdisj J) (fun k _ => hSQm k),
      ENNReal.toReal_sum (fun k _ => hSQfin k)]
  have P4 : ∀ J : Finset (Fin n → ℤ), ∑ k ∈ J, ((Fk k).card : ℝ) ≤ (F.card : ℝ) := by
    intro J
    rw [← Nat.cast_sum, ← Finset.card_biUnion (hFkdisj J)]
    exact_mod_cast Finset.card_le_card (Finset.biUnion_subset.mpr (fun k _ => hFkF k))
  have hbU : (intBox n K₀).biUnion Fk = F := by
    ext x; rw [Finset.mem_biUnion]; constructor
    · rintro ⟨k, -, hx⟩; exact hFkF k hx
    · intro hx
      obtain ⟨k, hk, hv⟩ := hcovI (coords x) (hFS x hx)
      exact ⟨k, hk, (memFk k x).2 ⟨hx, hv⟩⟩
  have P1 : ∀ g : ι → ℝ, ∑ x ∈ F, g x = ∑ k ∈ intBox n K₀, ∑ x ∈ Fk k, g x := by
    intro g; rw [← Finset.sum_biUnion (hFkdisj _), hbU]
  have hVnn : ∀ k, 0 ≤ (MeasureTheory.volume (S ∩ Q k)).toReal := fun k => ENNReal.toReal_nonneg
  
  obtain ⟨Ig, hIg⟩ : ∃ s : Finset (Fin n → ℤ), s = (intBox n K₀).filter good := ⟨_, rfl⟩
  obtain ⟨Ib, hIb⟩ : ∃ s : Finset (Fin n → ℤ), s = (intBox n K₀).filter (fun k => ¬ good k) :=
    ⟨_, rfl⟩
  have memIg : ∀ k, k ∈ Ig ↔ k ∈ intBox n K₀ ∧ good k := by
    intro k; rw [hIg, Finset.mem_filter]
  have memIb : ∀ k, k ∈ Ib ↔ k ∈ intBox n K₀ ∧ ¬ good k := by
    intro k; rw [hIb, Finset.mem_filter]
  have hsplit : ∀ g : (Fin n → ℤ) → ℝ,
      ∑ k ∈ intBox n K₀, g k = ∑ k ∈ Ig, g k + ∑ k ∈ Ib, g k := by
    intro g; rw [hIg, hIb, Finset.sum_filter_add_sum_filter_not]
  have hcardI : ((intBox n K₀).card : ℝ) = (Ig.card : ℝ) + (Ib.card : ℝ) := by
    rw [hIg, hIb]
    exact_mod_cast (Finset.card_filter_add_card_filter_not good).symm
  have hUI : S ∩ ⋃ k ∈ intBox n K₀, Q k = S := by
    apply Set.inter_eq_left.mpr
    intro v hv
    obtain ⟨k, hk, hvk⟩ := hcovI v hv
    exact Set.mem_iUnion₂.mpr ⟨k, hk, hvk⟩
  have hUb : S ∩ {v : Fin n → ℝ | ∃ k ∈ intBox n K₀, ¬ good k ∧
        ∀ j, (ℓ : ℝ) * (k j : ℝ) ≤ v j ∧ v j < (ℓ : ℝ) * ((k j : ℝ) + 1)}
      = S ∩ ⋃ k ∈ Ib, Q k := by
    ext v
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_iUnion, memIb, exists_prop, hQ]
    constructor
    · rintro ⟨hv, k, hk, hg, hq⟩; exact ⟨hv, k, ⟨hk, hg⟩, hq⟩
    · rintro ⟨hv, k, ⟨hk, hg⟩, hq⟩; exact ⟨hv, k, hk, hg, hq⟩
  rw [hUb] at hbadvol hbadint
  
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = (MeasureTheory.volume (S ∩ ⋃ k ∈ Ib, Q k)).toReal := ⟨_, rfl⟩
  rw [← hW] at hbadvol hbadint
  have hW0 : 0 ≤ W := by rw [hW]; exact ENNReal.toReal_nonneg
  
  have hgoodk : ∀ k ∈ Ig, |∑ x ∈ Fk k, f (coords x) - (1 / q) * ∫ v in S ∩ Q k, f v|
      ≤ η * (((Fk k).card : ℝ) + (MeasureTheory.volume (S ∩ Q k)).toReal / q) + E₁ := by
    intro k hk
    obtain ⟨hkI, hgk⟩ := (memIg k).1 hk
    obtain ⟨c, hc0, hc1, hcf⟩ := hgood' k hkI hgk
    have hconst : MeasureTheory.IntegrableOn (fun _ => c) (S ∩ Q k) :=
      MeasureTheory.integrableOn_const (hSQfin k)
    have hJ : ∫ v in S ∩ Q k, (f v - c)
        = (∫ v in S ∩ Q k, f v) - (MeasureTheory.volume (S ∩ Q k)).toReal * c := by
      rw [MeasureTheory.integral_sub (hSQi k) hconst, MeasureTheory.setIntegral_const,
        MeasureTheory.measureReal_def, smul_eq_mul]
    have hJb : |∫ v in S ∩ Q k, (f v - c)| ≤ η * (MeasureTheory.volume (S ∩ Q k)).toReal := by
      have h := MeasureTheory.norm_setIntegral_le_of_norm_le_const (hSQfin k).lt_top
        (f := fun v => f v - c) (C := η) (fun v hv => by
          rw [Real.norm_eq_abs]; exact hcf v hv.2)
      rw [Real.norm_eq_abs, MeasureTheory.measureReal_def] at h
      exact h
    have ha : ∑ x ∈ Fk k, (f (coords x) - c)
        = ∑ x ∈ Fk k, f (coords x) - ((Fk k).card : ℝ) * c := by
      rw [Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul]
    have hab : |∑ x ∈ Fk k, (f (coords x) - c)| ≤ ((Fk k).card : ℝ) * η := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      refine (Finset.sum_le_sum (fun x hx => hcf (coords x) ((memFk k x).1 hx).2)).trans ?_
      rw [Finset.sum_const, nsmul_eq_mul]
    have hcb : |c * (((Fk k).card : ℝ) - (MeasureTheory.volume (S ∩ Q k)).toReal / q)| ≤ E₁ := by
      rw [abs_mul, abs_of_nonneg hc0]
      have h := hcnt' k hkI
      have h0 : 0 ≤ |((Fk k).card : ℝ) - (MeasureTheory.volume (S ∩ Q k)).toReal / q| :=
        abs_nonneg _
      nlinarith
    have hJq : |(1 / q) * ∫ v in S ∩ Q k, (f v - c)|
        ≤ η * (MeasureTheory.volume (S ∩ Q k)).toReal / q := by
      rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 1 / q)]
      calc 1 / q * |∫ v in S ∩ Q k, (f v - c)| = |∫ v in S ∩ Q k, (f v - c)| / q := by ring
        _ ≤ η * (MeasureTheory.volume (S ∩ Q k)).toReal / q :=
          div_le_div_of_nonneg_right hJb hq0.le
    have hid : ∑ x ∈ Fk k, f (coords x) - (1 / q) * ∫ v in S ∩ Q k, f v
        = ∑ x ∈ Fk k, (f (coords x) - c)
          + c * (((Fk k).card : ℝ) - (MeasureTheory.volume (S ∩ Q k)).toReal / q)
          - (1 / q) * ∫ v in S ∩ Q k, (f v - c) := by
      rw [ha, hJ]; ring
    rw [hid]
    have e1 := abs_le.mp hab
    have e2 := abs_le.mp hcb
    have e3 := abs_le.mp hJq
    have e4 : η * (((Fk k).card : ℝ) + (MeasureTheory.volume (S ∩ Q k)).toReal / q)
        = ((Fk k).card : ℝ) * η + η * (MeasureTheory.volume (S ∩ Q k)).toReal / q := by ring
    rw [abs_le, e4]
    constructor <;> linarith [e1.1, e1.2, e2.1, e2.2, e3.1, e3.2]
  
  have hGsum : |∑ k ∈ Ig, (∑ x ∈ Fk k, f (coords x) - (1 / q) * ∫ v in S ∩ Q k, f v)|
      ≤ η * ((F.card : ℝ) + (MeasureTheory.volume S).toReal / q) + (Ig.card : ℝ) * E₁ := by
    refine ((Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum hgoodk)).trans ?_
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.sum_div,
      Finset.sum_const, nsmul_eq_mul]
    have h1 := P4 Ig
    have h2 : ∑ k ∈ Ig, (MeasureTheory.volume (S ∩ Q k)).toReal
        ≤ (MeasureTheory.volume S).toReal := by
      rw [← P3 Ig]
      exact ENNReal.toReal_mono hSfin (MeasureTheory.measure_mono Set.inter_subset_left)
    have h3 : (∑ k ∈ Ig, (MeasureTheory.volume (S ∩ Q k)).toReal) / q
        ≤ (MeasureTheory.volume S).toReal / q := div_le_div_of_nonneg_right h2 hq0.le
    have h4 : η * (∑ k ∈ Ig, ((Fk k).card : ℝ)
          + (∑ k ∈ Ig, (MeasureTheory.volume (S ∩ Q k)).toReal) / q)
        ≤ η * ((F.card : ℝ) + (MeasureTheory.volume S).toReal / q) :=
      mul_le_mul_of_nonneg_left (add_le_add h1 h3) hη
    linarith
  
  have hA0 : 0 ≤ ∑ k ∈ Ib, ∑ x ∈ Fk k, f (coords x) :=
    Finset.sum_nonneg (fun k _ => Finset.sum_nonneg (fun x hx => hf0 _ (hFS x (hFkF k hx))))
  have hA1 : ∑ k ∈ Ib, ∑ x ∈ Fk k, f (coords x) ≤ ∑ k ∈ Ib, ((Fk k).card : ℝ) := by
    apply Finset.sum_le_sum
    intro k _
    refine (Finset.sum_le_sum (fun x hx => hF1 x (hFkF k hx))).trans ?_
    rw [Finset.sum_const, nsmul_eq_mul, mul_one]
  have hA2 : ∑ k ∈ Ib, ((Fk k).card : ℝ)
      ≤ ∑ k ∈ Ib, ((MeasureTheory.volume (S ∩ Q k)).toReal / q + E₁) := by
    apply Finset.sum_le_sum
    intro k hk
    have h := hcnt' k ((memIb k).1 hk).1
    have := (abs_le.mp h).2
    linarith
  have hA3 : ∑ k ∈ Ib, ((MeasureTheory.volume (S ∩ Q k)).toReal / q + E₁)
      = W / q + (Ib.card : ℝ) * E₁ := by
    rw [Finset.sum_add_distrib, ← Finset.sum_div, ← P3 Ib, ← hW, Finset.sum_const, nsmul_eq_mul]
  have hWq : W / q ≤ W := div_le_self hW0 hq
  have hBm : MeasurableSet (S ∩ ⋃ k ∈ Ib, Q k) :=
    hSm.inter (Finset.measurableSet_biUnion _ (fun k _ => hQm k))
  have hB0 : 0 ≤ ∫ v in S ∩ ⋃ k ∈ Ib, Q k, f v :=
    MeasureTheory.setIntegral_nonneg hBm (fun v hv => hf0 v hv.1)
  have hq1 : 1 / q ≤ 1 := by rw [div_le_one hq0]; exact hq
  have hBq0 : 0 ≤ (1 / q) * ∫ v in S ∩ ⋃ k ∈ Ib, Q k, f v :=
    mul_nonneg (by positivity) hB0
  have hBq1 : (1 / q) * ∫ v in S ∩ ⋃ k ∈ Ib, Q k, f v ≤ ∫ v in S ∩ ⋃ k ∈ Ib, Q k, f v :=
    mul_le_of_le_one_left hB0 hq1
  
  have hint : ∫ v in S, f v
      = (∑ k ∈ Ig, ∫ v in S ∩ Q k, f v) + (∫ v in S ∩ ⋃ k ∈ Ib, Q k, f v) := by
    have h1 := P2 (intBox n K₀)
    rw [hUI] at h1
    rw [h1, hsplit, P2 Ib]
  have hsumF : ∑ x ∈ F, f (coords x)
      = ∑ k ∈ Ig, ∑ x ∈ Fk k, f (coords x) + ∑ k ∈ Ib, ∑ x ∈ Fk k, f (coords x) := by
    rw [P1 (fun x => f (coords x)), hsplit]
  have hGid : ∑ k ∈ Ig, (∑ x ∈ Fk k, f (coords x) - (1 / q) * ∫ v in S ∩ Q k, f v)
      = ∑ k ∈ Ig, ∑ x ∈ Fk k, f (coords x) - (1 / q) * ∑ k ∈ Ig, ∫ v in S ∩ Q k, f v := by
    rw [Finset.sum_sub_distrib, Finset.mul_sum]
  have hD : ∑ x ∈ F, f (coords x) - (1 / q) * ∫ v in S, f v
      = ∑ k ∈ Ig, (∑ x ∈ Fk k, f (coords x) - (1 / q) * ∫ v in S ∩ Q k, f v)
        + (∑ k ∈ Ib, ∑ x ∈ Fk k, f (coords x) - (1 / q) * ∫ v in S ∩ ⋃ k ∈ Ib, Q k, f v) := by
    rw [hGid, hsumF, hint]; ring
  have hcE : ((intBox n K₀).card : ℝ) * E₁ = (Ig.card : ℝ) * E₁ + (Ib.card : ℝ) * E₁ := by
    rw [hcardI]; ring
  rw [hD, hcE]
  have g1 := abs_le.mp hGsum
  rw [abs_le]
  constructor <;> linarith [g1.1, g1.2]

theorem kai_cube_parameter_bounds (n : ℕ) (hn : 1 ≤ n) (M : ℝ) (hM : 1 ≤ M) (ℓ K₀ : ℕ)
    (hℓ : ℓ = ⌈M ^ ((3 : ℝ) / 4)⌉₊) (hK₀ : K₀ = ⌈M / (ℓ : ℝ)⌉₊ + 1) :
    1 ≤ ℓ ∧ M ^ ((1 : ℝ) / 2) ≤ (ℓ : ℝ) ∧ (ℓ : ℝ) ≤ 2 * M ^ ((3 : ℝ) / 4) ∧
    M + 1 ≤ (ℓ : ℝ) * (K₀ : ℝ) ∧
    ((intBox n K₀).card : ℝ) * (ℓ : ℝ) ^ (n - 1) ≤ 14 ^ n * M ^ ((n : ℝ) - 3 / 4) ∧
    (∀ m : ℕ, (intBox n m).card = (2 * m + 1) ^ n) ∧
    (∀ t : ℝ, 0 ≤ t → t ≤ 1 → (1 + t) ^ n - 1 ≤ (n : ℝ) * 2 ^ (n - 1) * t) ∧
    (∀ r : ℝ, 0 ≤ r → MeasureTheory.volume (realBox n r) = ENNReal.ofReal ((2 * r) ^ n)) :=
by
  have hM0 : (0:ℝ) < M := by linarith
  obtain ⟨x, hx_def⟩ : ∃ x : ℝ, x = M ^ ((3 : ℝ) / 4) := ⟨_, rfl⟩
  rw [← hx_def] at hℓ ⊢
  have hx1 : 1 ≤ x := by rw [hx_def]; exact Real.one_le_rpow hM (by norm_num)
  have hxpos : 0 < x := by linarith
  have hlx : x ≤ (ℓ : ℝ) := by rw [hℓ]; exact Nat.le_ceil _
  have hlx2 : (ℓ : ℝ) < x + 1 := by rw [hℓ]; exact Nat.ceil_lt_add_one hxpos.le
  have hl1 : (1:ℝ) ≤ ℓ := le_trans hx1 hlx
  have P1 : 1 ≤ ℓ := by exact_mod_cast hl1
  have P2 : M ^ ((1 : ℝ) / 2) ≤ (ℓ : ℝ) := by
    refine le_trans ?_ hlx
    rw [hx_def]
    exact Real.rpow_le_rpow_of_exponent_le hM (by norm_num)
  have P3 : (ℓ : ℝ) ≤ 2 * x := by linarith
  have hlpos : (0:ℝ) < ℓ := by linarith
  obtain ⟨y, hy_def⟩ : ∃ y : ℝ, y = M / (ℓ : ℝ) := ⟨_, rfl⟩
  rw [← hy_def] at hK₀
  have hy0 : 0 ≤ y := by rw [hy_def]; exact div_nonneg hM0.le hlpos.le
  have hly : (ℓ:ℝ) * y = M := by rw [hy_def]; exact mul_div_cancel₀ M hlpos.ne'
  have hK : (K₀ : ℝ) = (⌈y⌉₊ : ℝ) + 1 := by rw [hK₀, Nat.cast_add, Nat.cast_one]
  have hK1 : y + 1 ≤ (K₀ : ℝ) := by rw [hK]; linarith [Nat.le_ceil y]
  have hK2 : (K₀ : ℝ) ≤ y + 2 := by rw [hK]; linarith [Nat.ceil_lt_add_one hy0]
  have P4 : M + 1 ≤ (ℓ : ℝ) * (K₀ : ℝ) := by nlinarith
  have P6 : ∀ m : ℕ, (intBox n m).card = (2 * m + 1) ^ n := by
    intro m
    unfold intBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  have P7 : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → (1 + t) ^ n - 1 ≤ (n : ℝ) * 2 ^ (n - 1) * t := by
    intro t ht0 ht1
    have hg := geom_sum_mul (1 + t) n
    have hs : ∑ i ∈ Finset.range n, (1 + t) ^ i ≤ (n:ℝ) * 2 ^ (n - 1) := by
      have h := Finset.sum_le_card_nsmul (Finset.range n) (fun i => (1 + t) ^ i)
        ((2:ℝ) ^ (n - 1)) (by
          intro i hi
          have hi' : i ≤ n - 1 := by rw [Finset.mem_range] at hi; omega
          calc (1 + t) ^ i ≤ 2 ^ i := pow_le_pow_left₀ (by linarith) (by linarith) i
            _ ≤ 2 ^ (n - 1) := pow_le_pow_right₀ (by norm_num) hi')
      simpa [Finset.card_range, nsmul_eq_mul] using h
    rw [← hg]
    have h1 : (1 + t - 1) = t := by ring
    rw [h1]
    exact mul_le_mul_of_nonneg_right hs ht0
  have P8 : ∀ r : ℝ, 0 ≤ r →
      MeasureTheory.volume (realBox n r) = ENNReal.ofReal ((2 * r) ^ n) := by
    intro r hr
    have hset : realBox n r = Set.Icc (fun _ : Fin n => -r) (fun _ => r) := by
      ext z
      simp only [realBox, Set.mem_setOf_eq, Set.mem_Icc, Pi.le_def, abs_le]
      exact forall_and
    rw [hset, Real.volume_Icc_pi]
    simp only [sub_neg_eq_add, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    rw [ENNReal.ofReal_pow (by linarith : (0:ℝ) ≤ 2 * r), show r + r = 2 * r by ring]
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = M ^ ((1 : ℝ) / 4) := ⟨_, rfl⟩
  have ha1 : 1 ≤ a := by rw [ha_def]; exact Real.one_le_rpow hM (by norm_num)
  have hax : a * x = M := by
    rw [ha_def, hx_def, ← Real.rpow_add hM0]
    norm_num
  have hya : y ≤ a := by
    rw [hy_def, div_le_iff₀ hlpos]
    nlinarith
  have hk7 : 2 * (K₀:ℝ) + 1 ≤ 7 * a := by linarith
  have hexp : M ^ ((n:ℝ) - 3 / 4) = a ^ n * x ^ (n - 1) := by
    have h : (n:ℝ) - 3 / 4 = (1 / 4) * (n:ℝ) + (3 / 4) * ((n - 1 : ℕ) : ℝ) := by
      rw [Nat.cast_sub hn]; push_cast; ring
    rw [h, Real.rpow_add hM0, Real.rpow_mul hM0.le, Real.rpow_mul hM0.le, Real.rpow_natCast,
      Real.rpow_natCast, ha_def, hx_def]
  have P5 : ((intBox n K₀).card : ℝ) * (ℓ : ℝ) ^ (n - 1) ≤ 14 ^ n * M ^ ((n : ℝ) - 3 / 4) := by
    rw [P6]
    push_cast
    calc (2 * (K₀:ℝ) + 1) ^ n * (ℓ:ℝ) ^ (n - 1)
        ≤ (7 * a) ^ n * (2 * x) ^ (n - 1) :=
          mul_le_mul (pow_le_pow_left₀ (by positivity) hk7 n)
            (pow_le_pow_left₀ hlpos.le P3 (n - 1)) (by positivity) (by positivity)
      _ = 7 ^ n * 2 ^ (n - 1) * (a ^ n * x ^ (n - 1)) := by rw [mul_pow, mul_pow]; ring
      _ ≤ 7 ^ n * 2 ^ n * (a ^ n * x ^ (n - 1)) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (by norm_num) (Nat.sub_le n 1))
              (by positivity)) (by positivity)
      _ = 14 ^ n * M ^ ((n : ℝ) - 3 / 4) := by rw [hexp, ← mul_pow]; norm_num
  exact ⟨P1, P2, P3, P4, P5, P6, P7, P8⟩

theorem kai_weighted_coset_count (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C₅ : ℝ, 0 ≤ C₅ ∧
      ∀ (M : ℝ), 3 ≤ M →
      ∀ (𝔟 : Ideal (NumberField.RingOfIntegers K)), 𝔟 ≠ ⊥ →
        (Ideal.absNorm 𝔟 : ℝ) ≤ M ^ ((1:ℝ)/2) →
      ∀ (b : NumberField.RingOfIntegers K) (γ : ℝ), 1 / 2 ≤ γ → γ ≤ 1 →
      ∀ (S : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet S → Convex ℝ S →
        S ⊆ realBox (Module.finrank ℚ K) ((⌊M⌋₊ : ℝ) + 1 / 2) →
        |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
              (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ S ∧ x - b ∈ 𝔟)
              (fun _ => Classical.propDecidable _) (omegaBox ω M),
            ((Algebra.norm ℤ x).natAbs : ℝ) ^ (γ - 1)
          - (1 / (Ideal.absNorm 𝔟 : ℝ)) *
              ∫ v in S, (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ (γ - 1)|
          ≤ C₅ * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 24) :=
by
  classical
  have hn : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  obtain ⟨C_cc, hC_cc, hCC⟩ := kai_coset_convex_count K ω
  obtain ⟨C_W, hC_W, hWT⟩ := kai_weight_integral_bounds K ω
  obtain ⟨c_L, hc_L, hLip, hSlab, hVal⟩ := kai_omega_place_facts K ω
  choose a j₀ ha0 haL using hSlab
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = max c_L 1 := ⟨_, rfl⟩
  have hc1 : 1 ≤ c := by rw [hc_def]; exact le_max_right _ _
  have hcLc : c_L ≤ c := by rw [hc_def]; exact le_max_left _ _
  obtain ⟨A_sl, hA_def⟩ : ∃ A_sl : ℝ,
      A_sl = ∑ w : NumberField.InfinitePlace K, 1 / |a w (j₀ w)| := ⟨_, rfl⟩
  have hA0 : 0 ≤ A_sl := by
    rw [hA_def]; exact Finset.sum_nonneg (fun w _ => by positivity)
  obtain ⟨C₅, hC₅_def⟩ : ∃ C₅ : ℝ, C₅ = (Module.finrank ℚ K : ℝ) * 6 ^ (Module.finrank ℚ K)
      + 14 ^ (Module.finrank ℚ K) * C_cc
      + 16 * c * 4 ^ (Module.finrank ℚ K - 1) * A_sl
      + (2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2) * C_W := ⟨_, rfl⟩
  have hC₅0 : 0 ≤ C₅ := by
    rw [hC₅_def]
    have h1 : 0 ≤ (Module.finrank ℚ K : ℝ) * 6 ^ (Module.finrank ℚ K) := by positivity
    have h2 : 0 ≤ (14 : ℝ) ^ (Module.finrank ℚ K) * C_cc := mul_nonneg (by positivity) hC_cc
    have h3 : 0 ≤ 16 * c * 4 ^ (Module.finrank ℚ K - 1) * A_sl :=
      mul_nonneg (mul_nonneg (by linarith) (by positivity)) hA0
    have h4 : 0 ≤ (2 : ℝ) ^ ((Module.finrank ℚ K : ℝ) / 2) * C_W :=
      mul_nonneg (Real.rpow_nonneg (by norm_num) _) hC_W
    linarith
  refine ⟨C₅, hC₅0, ?_⟩
  intro M hM 𝔟 h𝔟 hN𝔟 b γ hγ1 hγ2 S hSm hSc hSbox
  have hM1 : (1 : ℝ) ≤ M := by linarith
  have hMpos : (0 : ℝ) < M := by linarith
  have hq1 : (1 : ℝ) ≤ (Ideal.absNorm 𝔟 : ℝ) := by
    have h : Ideal.absNorm 𝔟 ≠ 0 := fun h => h𝔟 (Ideal.absNorm_eq_zero_iff.1 h)
    exact_mod_cast Nat.one_le_iff_ne_zero.2 h
  
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℕ, ℓ = ⌈M ^ ((3 : ℝ) / 4)⌉₊ := ⟨_, rfl⟩
  obtain ⟨K₀, hK₀⟩ : ∃ K₀ : ℕ, K₀ = ⌈M / (ℓ : ℝ)⌉₊ + 1 := ⟨_, rfl⟩
  obtain ⟨P1, P2, P3, P4, P5, P6, P7, P8⟩ :=
    kai_cube_parameter_bounds (Module.finrank ℚ K) hn M hM1 ℓ K₀ hℓ hK₀
  have hℓ1 : (1 : ℝ) ≤ (ℓ : ℝ) := by exact_mod_cast P1
  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by linarith
  have hqℓ : (Ideal.absNorm 𝔟 : ℝ) ≤ (ℓ : ℝ) := hN𝔟.trans P2
  obtain ⟨μ, hμ_def⟩ : ∃ μ : ℝ, μ = M ^ ((1 : ℝ) / 8) := ⟨_, rfl⟩
