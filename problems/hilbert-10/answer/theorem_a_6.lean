    fun x ξ => if ξ ∈ S then ⌊(sg (ξ * x) + 2 * r) / r⌋ else 0 with hJ
  set T : Finset (ZMod P → ℤ) := Fintype.piFinset
    (fun ξ : ZMod P => if ξ ∈ S then Finset.Icc (0 : ℤ) 3 else ({0} : Finset ℤ)) with hT
  
  have hTcard : T.card = 4 ^ S.card := by
