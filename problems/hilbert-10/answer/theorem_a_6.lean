  have hpi2 : 0 < (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K := by
    have := Real.pi_pos; positivity
  have hprod0 : 0 ≤ ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (θ₂ p - θ₁ p) :=
