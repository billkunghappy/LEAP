  have hlipcore : ∀ u v : (Fin a → ℝ) × (Fin b → ℝ), (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) →
      (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, |u.2 k - v.2 k| ≤ 1) →
      ‖(∫ t in Set.Icc (0 : Fin b → ℝ) 1, (F (u.1, fun k => u.2 k + t k) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * t k : ℝ) : ℂ)))) -
        ∫ t in Set.Icc (0 : Fin b → ℝ) 1, (F (v.1, fun k => v.2 k + t k) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * t k : ℝ) : ℂ)))‖
        ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|) := by
    intro u v hu hv huv
    have hi1 : MeasureTheory.IntegrableOn (fun t : Fin b → ℝ =>
        (F (u.1, fun k => u.2 k + t k) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * t k : ℝ) : ℂ))))
        (Set.Icc (0 : Fin b → ℝ) 1) MeasureTheory.volume := (hcont u.1 u.2).integrableOn_Icc
    have hi2 : MeasureTheory.IntegrableOn (fun t : Fin b → ℝ =>
        (F (v.1, fun k => v.2 k + t k) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * t k : ℝ) : ℂ))))
        (Set.Icc (0 : Fin b → ℝ) 1) MeasureTheory.volume := (hcont v.1 v.2).integrableOn_Icc
    rw [← MeasureTheory.integral_sub hi1 hi2]
    apply hbox
    intro t
    beta_reduce
    rw [← sub_mul, norm_mul, hEn', mul_one, ← Complex.ofReal_sub, Complex.norm_real,
      Real.norm_eq_abs]
    have h := hlipx (u.1, fun k => u.2 k + t k) (v.1, fun k => v.2 k + t k) hu hv
