    intro x
    unfold cramerModel
    split_ifs
    · exact ⟨by rw [← hκ_def]; exact hκ0, by rw [← hκ_def]; exact hκT⟩
    · exact ⟨le_rfl, hT₀0⟩
  have hc_zero : ∀ x, ¬ CoprimeToNat (primorial m) x → cramerModel K ρ (primorial m) x = 0 := by
    intro x hx
    unfold cramerModel
    rw [if_neg hx]
  have hψ1 : ∀ x, |(ψ x : ℝ)| ≤ 1 := by
    intro x
    rcases hR.1 x with h | h | h <;> simp [h]
  
  have hQ1 : 1 ≤ Ideal.absNorm 𝔮 := by
    rcases Nat.eq_zero_or_pos (Ideal.absNorm 𝔮) with h | h
    · exact absurd (Ideal.absNorm_eq_zero_iff.mp h) h𝔮
    · exact h
  have hQ1r : (1:ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) := by exact_mod_cast hQ1
  have hQpos : (0:ℝ) < (Ideal.absNorm 𝔮 : ℝ) := by linarith
  have hQm' : Ideal.absNorm 𝔮 ≤ m := by exact_mod_cast hQm
  have hQq : 0 < (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4) := Real.rpow_pos_of_pos hQpos _
  
  have hnotcop0 : ¬ CoprimeToNat (primorial m) (0 : NumberField.RingOfIntegers K) := by
    intro hc
    obtain ⟨hcard, -⟩ := kai_phiK_prime_bounds K 2 Nat.prime_two
    have hne : Ideal.span {((2:ℕ) : NumberField.RingOfIntegers K)} ≠ ⊤ := by
      intro htop
      rw [htop] at hcard
      haveI : Subsingleton (NumberField.RingOfIntegers K ⧸
