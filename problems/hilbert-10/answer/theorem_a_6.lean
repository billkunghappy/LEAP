      { r := fun x y => ∃ w : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q w ∧
              (y : NumberField.RingOfIntegers K)
                = ((w : NumberField.RingOfIntegers K)) * (x : NumberField.RingOfIntegers K)
        iseqv := by
          constructor
          · intro x; exact ⟨1, hone, by simp⟩
          · rintro x y ⟨w, hw, hxy⟩
            refine ⟨w⁻¹, hinv w hw, ?_⟩
            rw [hxy, ← mul_assoc, Units.inv_mul, one_mul]
          · rintro x y z ⟨w, hw, hxy⟩ ⟨w', hw', hyz⟩
            refine ⟨w' * w, hmul w' w hw' hw, ?_⟩
            rw [hyz, hxy, Units.val_mul]; ring }
    obtain ⟨G, hGdef⟩ : ∃ G : Set (NumberField.RingOfIntegers K),
        G = Set.range (fun c : Quotient sr => (Quotient.out c).1) := ⟨_, rfl⟩
    have hmemG : ∀ x : NumberField.RingOfIntegers K,
