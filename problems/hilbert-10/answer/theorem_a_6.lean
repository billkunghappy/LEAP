        Nat.succ_pred_eq_of_pos hI.2.2.1
      have step1 : kaiZFVonMangoldt K I.1.1 * ((Ideal.absNorm I.1.1 : ℝ)) ^ (-σ)
          = Real.log ((Ideal.absNorm I.2.choose : ℝ)) *
              ((Ideal.absNorm I.1.1 : ℝ)) ^ (-σ) :=
        congrArg (fun t : ℝ => t * ((Ideal.absNorm I.1.1 : ℝ)) ^ (-σ)) hval
      have step2 : Real.log ((Ideal.absNorm I.2.choose : ℝ)) *
              ((Ideal.absNorm I.1.1 : ℝ)) ^ (-σ)
          = Real.log ((Ideal.absNorm I.2.choose : ℝ)) *
              (((Ideal.absNorm I.2.choose : ℝ)) ^ I.2.choose_spec.choose) ^ (-σ) :=
        congrArg (fun t : ℝ =>
          Real.log ((Ideal.absNorm I.2.choose : ℝ)) * t ^ (-σ)) hcast
      have step3 : Real.log ((Ideal.absNorm I.2.choose : ℝ)) *
              (((Ideal.absNorm I.2.choose : ℝ)) ^ I.2.choose_spec.choose) ^ (-σ)
          = Real.log ((Ideal.absNorm I.2.choose : ℝ)) *
              (((Ideal.absNorm I.2.choose : ℝ)) ^ (I.2.choose_spec.choose - 1 + 1)) ^ (-σ) :=
        congrArg (fun n : ℕ => Real.log ((Ideal.absNorm I.2.choose : ℝ)) *
          (((Ideal.absNorm I.2.choose : ℝ)) ^ n) ^ (-σ)) hk.symm
      exact step1.trans (step2.trans step3)
  obtain ⟨e, he_inj, he_eq⟩ := key
  have hzero : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      I ∉ Set.range (Subtype.val : {J : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
          ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
            P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ (J : Ideal (NumberField.RingOfIntegers K)) = P ^ k} →
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) →
      kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ) = 0 := by
    intro I hI
    rw [Subtype.range_coe_subtype] at hI
    have hΛ : kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) = 0 := dif_neg hI
    rw [hΛ, zero_mul]
  have hfc : Summable (fun I : {J : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
        ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
          P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ (J : Ideal (NumberField.RingOfIntegers K)) = P ^ k} =>
      kaiZFVonMangoldt K I.1.1 * ((Ideal.absNorm I.1.1 : ℝ)) ^ (-σ)) :=
    (hGsum.comp_injective he_inj).congr (fun I => (he_eq I).symm)
  have hsupp : Function.support (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))
      ⊆ Set.range (Subtype.val : {J : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
          ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
            P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ (J : Ideal (NumberField.RingOfIntegers K)) = P ^ k} →
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) := by
    intro x hx
    by_contra hcon
    exact hx (hzero x hcon)
  refine ⟨(Subtype.coe_injective.summable_iff hzero).mp hfc, ?_⟩
  have h10 := Subtype.coe_injective.tsum_eq hsupp
  have h11 : (∑' I : {J : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
        ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
          P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ (J : Ideal (NumberField.RingOfIntegers K)) = P ^ k},
        kaiZFVonMangoldt K I.1.1 * ((Ideal.absNorm I.1.1 : ℝ)) ^ (-σ))
      ≤ (∑' z : {P : Ideal (NumberField.RingOfIntegers K) // P.IsPrime ∧ P ≠ ⊥} × ℕ,
          Real.log ((Ideal.absNorm (z.1 : Ideal (NumberField.RingOfIntegers K)) : ℝ)) *
            (((Ideal.absNorm (z.1 : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (z.2 + 1)) ^
              (-σ)) :=
    Summable.tsum_le_tsum_of_inj e he_inj (fun c _ => hB1 c)
      (fun I => le_of_eq (he_eq I)) hfc hGsum
  rw [← h10]
  exact h11.trans hGle

theorem kai_zf_ideal_moebius (K : Type u) [Field K] [NumberField K] :
    KaiZFMoebiusProp K :=
by
  classical
  have gen : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDedekindDomain R],
      ∃ m : Ideal R → ℂ,
        (∀ J : Ideal R, ‖m J‖ ≤ 1) ∧
        (∑' J : {J : Ideal R // J ∣ (⊤ : Ideal R)}, m ((J : Ideal R))) = 1 ∧
        (∀ I : Ideal R, I ≠ 0 → I ≠ ⊤ →
          (∑' J : {J : Ideal R // J ∣ I}, m ((J : Ideal R))) = 0) := by
    intro R _ _ _
    obtain ⟨mu, hmu⟩ : ∃ mu : Ideal R → ℂ, mu = fun J =>
        if J = 0 then 0 else
        if (UniqueFactorizationMonoid.normalizedFactors J).Nodup then
          (-1 : ℂ) ^ (Multiset.card (UniqueFactorizationMonoid.normalizedFactors J))
        else 0 := ⟨_, rfl⟩
    have hmuval : ∀ J : Ideal R, mu J =
        if J = 0 then 0 else
        if (UniqueFactorizationMonoid.normalizedFactors J).Nodup then
          (-1 : ℂ) ^ (Multiset.card (UniqueFactorizationMonoid.normalizedFactors J))
        else 0 := fun J => by rw [hmu]
    have htop0 : (⊤ : Ideal R) ≠ 0 := by
      rw [Ne, Submodule.zero_eq_bot]
      exact top_ne_bot
    have hLA : ∀ I : Ideal R, I ≠ 0 → ∀ t : Multiset (Ideal R),
        t ≤ UniqueFactorizationMonoid.normalizedFactors I →
        UniqueFactorizationMonoid.normalizedFactors t.prod = t ∧ t.prod ∣ I := by
      intro I hI t ht
      have hprime : ∀ p ∈ t, Prime p := fun p hp =>
        UniqueFactorizationMonoid.prime_of_normalized_factor p (Multiset.mem_of_le ht hp)
      have h1 : UniqueFactorizationMonoid.normalizedFactors t.prod = t :=
        UniqueFactorizationMonoid.normalizedFactors_prod_of_prime hprime
      have h0 : t.prod ≠ 0 := by
        intro hz
        rw [hz, UniqueFactorizationMonoid.normalizedFactors_zero] at h1
        rw [← h1, Multiset.prod_zero, Ideal.one_eq_top, Submodule.zero_eq_bot] at hz
        exact top_ne_bot hz
      refine ⟨h1, ?_⟩
      refine (UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors
        h0 hI).mpr ?_
      rw [h1]
      exact ht
    have hLB : ∀ I : Ideal R, I ≠ 0 → ∀ f : Ideal R → ℂ,
        ∃ s : Finset (Ideal R), (∀ J : Ideal R, J ∈ s ↔ J ∣ I) ∧
          (∑' J : {J : Ideal R // J ∣ I}, f (J : Ideal R)) = ∑ J ∈ s, f J := by
      intro I hI f
      haveI : Fintype {J : Ideal R // J ∣ I} :=
        UniqueFactorizationMonoid.fintypeSubtypeDvd I hI
      refine ⟨Finset.image (fun J : {J : Ideal R // J ∣ I} => (J : Ideal R)) Finset.univ,
        ?_, ?_⟩
      · intro J
        simp only [Finset.mem_image, Finset.mem_univ, true_and]
        constructor
        · rintro ⟨a, rfl⟩
          exact a.2
        · intro hJ
          exact ⟨⟨J, hJ⟩, rfl⟩
      · rw [tsum_fintype]
        rw [Finset.sum_image (fun a _ b _ hab => Subtype.ext hab)]
    have hmutop : mu (⊤ : Ideal R) = 1 := by
      have hnf : UniqueFactorizationMonoid.normalizedFactors (⊤ : Ideal R) = 0 := by
        rw [← Ideal.one_eq_top, UniqueFactorizationMonoid.normalizedFactors_one]
      rw [hmuval, if_neg htop0, hnf]
      simp
    have hclause2 : (∑' J : {J : Ideal R // J ∣ (⊤ : Ideal R)}, mu (J : Ideal R)) = 1 := by
      have hsingle : ∀ b : {J : Ideal R // J ∣ (⊤ : Ideal R)},
          b = ⟨⊤, dvd_refl (⊤ : Ideal R)⟩ :=
        fun b => Subtype.ext (top_le_iff.mp (Ideal.dvd_iff_le.mp b.2))
      rw [tsum_eq_single ⟨⊤, dvd_refl (⊤ : Ideal R)⟩ (fun b hb => absurd (hsingle b) hb)]
      exact hmutop
    have hclause3 : ∀ I : Ideal R, I ≠ 0 → I ≠ ⊤ →
        (∑' J : {J : Ideal R // J ∣ I}, mu (J : Ideal R)) = 0 := by
      intro I hI0 hIT
      have hFne : UniqueFactorizationMonoid.normalizedFactors I ≠ 0 := by
        intro hF
        have hassoc := UniqueFactorizationMonoid.prod_normalizedFactors hI0
        rw [hF, Multiset.prod_zero] at hassoc
        exact hIT ((associated_iff_eq.mp hassoc).symm.trans Ideal.one_eq_top)
      obtain ⟨P, hP⟩ := Multiset.exists_mem_of_ne_zero hFne
      have hS : (UniqueFactorizationMonoid.normalizedFactors I).toFinset.Nonempty :=
        ⟨P, Multiset.mem_toFinset.mpr hP⟩
      obtain ⟨s, hsmem, hssum⟩ := hLB I hI0 mu
      rw [hssum]
      have hne0 : ∀ J ∈ s, J ≠ 0 := by
        intro J hJ hJ0
        obtain ⟨c, hc⟩ := (hsmem J).mp hJ
        rw [hJ0, zero_mul] at hc
        exact hI0 hc
      have hmus : ∀ J ∈ s, mu J =
          if (UniqueFactorizationMonoid.normalizedFactors J).Nodup then
            (-1 : ℂ) ^ (Multiset.card (UniqueFactorizationMonoid.normalizedFactors J))
          else 0 := by
        intro J hJ
        rw [hmuval J, if_neg (hne0 J hJ)]
      have hfilter :
          (∑ J ∈ s.filter
              (fun J => (UniqueFactorizationMonoid.normalizedFactors J).Nodup), mu J)
            = ∑ J ∈ s, mu J := by
        refine Finset.sum_subset (Finset.filter_subset _ s) ?_
        intro J hJ hJnot
        have hnd : ¬ (UniqueFactorizationMonoid.normalizedFactors J).Nodup := by
          intro hnd
          exact hJnot (Finset.mem_filter.mpr ⟨hJ, hnd⟩)
        rw [hmus J hJ, if_neg hnd]
      rw [← hfilter]
      have hsubT : ∀ T ∈ (UniqueFactorizationMonoid.normalizedFactors I).toFinset.powerset,
          T.val ≤ UniqueFactorizationMonoid.normalizedFactors I := by
        intro T hT
        rw [Finset.mem_powerset] at hT
        refine (Multiset.le_iff_subset T.nodup).mpr ?_
        intro Q hQ
        have hQS : Q ∈ (UniqueFactorizationMonoid.normalizedFactors I).toFinset :=
          hT (Finset.mem_val.mp hQ)
        rwa [Multiset.mem_toFinset] at hQS
      have hbij :
          (∑ J ∈ s.filter
              (fun J => (UniqueFactorizationMonoid.normalizedFactors J).Nodup), mu J)
            = ∑ T ∈ (UniqueFactorizationMonoid.normalizedFactors I).toFinset.powerset,
                (-1 : ℂ) ^ T.card := by
        refine Finset.sum_nbij'
          (fun J => (UniqueFactorizationMonoid.normalizedFactors J).toFinset)
          (fun T => T.val.prod) ?_ ?_ ?_ ?_ ?_
        · intro J hJ
          simp only [Finset.mem_filter] at hJ
          have hJ0 : J ≠ 0 := hne0 J hJ.1
          have hle : UniqueFactorizationMonoid.normalizedFactors J ≤
              UniqueFactorizationMonoid.normalizedFactors I :=
            (UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors
              hJ0 hI0).mp ((hsmem J).mp hJ.1)
          rw [Finset.mem_powerset]
          intro Q hQ
          rw [Multiset.mem_toFinset] at hQ ⊢
          exact Multiset.mem_of_le hle hQ
        · intro T hT
          obtain ⟨hnf, hdvd⟩ := hLA I hI0 T.val (hsubT T hT)
          refine Finset.mem_filter.mpr ⟨(hsmem _).mpr hdvd, ?_⟩
          rw [hnf]
          exact T.nodup
        · intro J hJ
          simp only [Finset.mem_filter] at hJ
          have hJ0 : J ≠ 0 := hne0 J hJ.1
          show ((UniqueFactorizationMonoid.normalizedFactors J).toFinset).val.prod = J
          rw [Multiset.toFinset_val, Multiset.Nodup.dedup hJ.2]
          exact associated_iff_eq.mp (UniqueFactorizationMonoid.prod_normalizedFactors hJ0)
        · intro T hT
          obtain ⟨hnf, -⟩ := hLA I hI0 T.val (hsubT T hT)
          show (UniqueFactorizationMonoid.normalizedFactors T.val.prod).toFinset = T
          rw [hnf, Finset.val_toFinset]
        · intro J hJ
          simp only [Finset.mem_filter] at hJ
          rw [hmus J hJ.1, if_pos hJ.2, Multiset.toFinset_card_of_nodup hJ.2]
      rw [hbij]
      have hZ : (∑ T ∈ (UniqueFactorizationMonoid.normalizedFactors I).toFinset.powerset,
          (-1 : ℤ) ^ T.card) = 0 :=
        Finset.sum_powerset_neg_one_pow_card_of_nonempty hS
      have hcast :
          (∑ T ∈ (UniqueFactorizationMonoid.normalizedFactors I).toFinset.powerset,
              (-1 : ℂ) ^ T.card)
            = ((∑ T ∈ (UniqueFactorizationMonoid.normalizedFactors I).toFinset.powerset,
                (-1 : ℤ) ^ T.card : ℤ) : ℂ) := by
        rw [Int.cast_sum]
        refine Finset.sum_congr rfl (fun T _ => ?_)
        push_cast
        ring
      rw [hcast, hZ, Int.cast_zero]
    refine ⟨mu, ?_, hclause2, hclause3⟩
    intro J
    rw [hmuval J]
    split_ifs <;> simp
  unfold KaiZFMoebiusProp
  exact gen (NumberField.RingOfIntegers K)

theorem kai_zf_ideal_dirichlet_conv (K : Type u) [Field K] [NumberField K] :
    KaiZFConvProp K :=
by
  classical
  unfold KaiZFConvProp
  intro f₀ g₀ s hFn hGn
  have hcpow : ∀ A B : Ideal (NumberField.RingOfIntegers K),
      ((Ideal.absNorm (A * B) : ℂ)) ^ s
        = ((Ideal.absNorm A : ℂ)) ^ s * ((Ideal.absNorm B : ℂ)) ^ s := by
    intro A B
    rw [map_mul, Nat.cast_mul,
      ← Complex.ofReal_natCast (Ideal.absNorm A),
      ← Complex.ofReal_natCast (Ideal.absNorm B),
      Complex.mul_cpow_ofReal_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _),
      Complex.ofReal_natCast, Complex.ofReal_natCast]
  have hpine : ∀ z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
        {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ((z.1 : Ideal (NumberField.RingOfIntegers K)) *
        (z.2 : Ideal (NumberField.RingOfIntegers K))) ≠ 0 := by
    intro z h
    rcases Ideal.mul_eq_bot.mp (h.trans Submodule.zero_eq_bot) with h1 | h1
    · exact z.1.2 (h1.trans Submodule.zero_eq_bot.symm)
    · exact z.2.2 (h1.trans Submodule.zero_eq_bot.symm)
  obtain ⟨pi, hpi⟩ :
      ∃ pi : ({I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) →
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ∀ z, (pi z : Ideal (NumberField.RingOfIntegers K))
          = (z.1 : Ideal (NumberField.RingOfIntegers K)) *
            (z.2 : Ideal (NumberField.RingOfIntegers K)) :=
    ⟨fun z => ⟨(z.1 : Ideal (NumberField.RingOfIntegers K)) *
        (z.2 : Ideal (NumberField.RingOfIntegers K)), hpine z⟩, fun _ => rfl⟩
  have hprod :
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          f₀ (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          g₀ (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
        = ∑' z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
              {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            (f₀ (z.1 : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (z.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
              (g₀ (z.2 : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (z.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) :=
    tsum_mul_tsum_of_summable_norm hFn hGn
  have hH : Summable (fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
        {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      (f₀ (z.1 : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (z.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
        (g₀ (z.2 : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (z.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) :=
    Summable.of_norm
      (Summable.congr
        (Summable.mul_of_nonneg hFn hGn (fun _ => norm_nonneg _) (fun _ => norm_nonneg _))
        (fun z => (norm_mul _ _).symm))
  have h1 : Summable
      ((fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        (f₀ (z.1 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (z.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
          (g₀ (z.2 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (z.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) ∘
        ⇑(Equiv.sigmaFiberEquiv pi)) :=
    (Equiv.summable_iff (Equiv.sigmaFiberEquiv pi)).mpr hH
  have hreg :
      (∑' z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        (f₀ (z.1 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (z.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
          (g₀ (z.2 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (z.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)))
      = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ∑' c : {z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
              {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // pi z = I},
            (f₀ (c.1.1 : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
              (g₀ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) :=
    (Equiv.tsum_eq (Equiv.sigmaFiberEquiv pi)
      (fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        (f₀ (z.1 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (z.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
          (g₀ (z.2 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (z.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)))).symm.trans
      h1.tsum_sigma
  have hfibeval : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      (∑' c : {z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
            {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // pi z = I},
          (f₀ (c.1.1 : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
            (g₀ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)))
        = (∑' pr : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                         {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
                (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (pr.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
            f₀ ((pr.1.1 : Ideal (NumberField.RingOfIntegers K))) *
              g₀ ((pr.1.2 : Ideal (NumberField.RingOfIntegers K)))) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) := by
    intro I
    have hiff : ∀ z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        pi z = I ↔ (z.1 : Ideal (NumberField.RingOfIntegers K)) *
          (z.2 : Ideal (NumberField.RingOfIntegers K))
            = (I : Ideal (NumberField.RingOfIntegers K)) := by
      intro z
      rw [← hpi z]
      exact Subtype.ext_iff
    have e1 :
        (∑' c : {z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
              {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // pi z = I},
            (f₀ (c.1.1 : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
              (g₀ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)))
          = ∑' pr : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                         {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
                (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (pr.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
              (f₀ (pr.1.1 : Ideal (NumberField.RingOfIntegers K)) /
                  ((Ideal.absNorm (pr.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
                (g₀ (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) /
                  ((Ideal.absNorm (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) :=
      Equiv.tsum_eq (Equiv.subtypeEquivRight hiff)
        (fun pr : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                        {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
              (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
                (pr.2 : Ideal (NumberField.RingOfIntegers K))
                  = (I : Ideal (NumberField.RingOfIntegers K))} =>
          (f₀ (pr.1.1 : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (pr.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
            (g₀ (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)))
    have hterm : ∀ pr : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                         {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
                (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (pr.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
        (f₀ (pr.1.1 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (pr.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
          (g₀ (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
          = (f₀ ((pr.1.1 : Ideal (NumberField.RingOfIntegers K))) *
              g₀ ((pr.1.2 : Ideal (NumberField.RingOfIntegers K)))) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) := by
      intro pr
      have hD : ((Ideal.absNorm (pr.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^ s *
            ((Ideal.absNorm (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^ s
          = ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^ s := by
        rw [← hcpow, pr.2]
      rw [← hD, div_mul_div_comm]
    exact e1.trans ((tsum_congr hterm).trans tsum_div_const)
  exact hprod.trans (hreg.trans (tsum_congr hfibeval))

theorem kai_zf_log_norm_divisor_sum (K : Type u) [Field K] [NumberField K]
    (I : Ideal (NumberField.RingOfIntegers K)) (hI : I ≠ 0) :
    (∑' J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I},
        kaiZFVonMangoldt K (J : Ideal (NumberField.RingOfIntegers K)))
      = Real.log (Ideal.absNorm I) :=
by
  classical
  have hNnat : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → 0 < Ideal.absNorm I := by
    intro I hI
    have hb : I ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hne : Ideal.absNorm I ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]
      exact hb
    omega
  have hVMpp : ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
      ∀ k : ℕ, 0 < k → kaiZFVonMangoldt K (P ^ k) = Real.log (Ideal.absNorm P) := by
    intro P hP hP0 k hk
    have hex : ∃ (Q : Ideal (NumberField.RingOfIntegers K)) (n : ℕ),
        Q.IsPrime ∧ Q ≠ ⊥ ∧ 0 < n ∧ P ^ k = Q ^ n := ⟨P, k, hP, hP0, hk, rfl⟩
    have hval : kaiZFVonMangoldt K (P ^ k) = Real.log (Ideal.absNorm hex.choose) := by
      simp only [kaiZFVonMangoldt]
      rw [dif_pos hex]
    rw [hval]
    obtain ⟨nn, hQp, hQb, hnn, heq⟩ := hex.choose_spec
    have hQprime : Prime hex.choose := Ideal.prime_of_isPrime hQb hQp
    have hPprime : Prime P := Ideal.prime_of_isPrime hP0 hP
    have hdvd : hex.choose ∣ P ^ k :=
      (dvd_pow_self hex.choose hnn.ne').trans (dvd_of_eq heq.symm)
    have hQP : hex.choose = P :=
      associated_iff_eq.mp (hQprime.associated_of_dvd hPprime (hQprime.dvd_of_dvd_pow hdvd))
    exact congrArg
      (fun J : Ideal (NumberField.RingOfIntegers K) => Real.log ((Ideal.absNorm J : ℕ) : ℝ)) hQP
  have hVMdiv : ∀ D : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ J : Ideal (NumberField.RingOfIntegers K), J ∈ D ↔ J ∣ I) →
        ∑ J ∈ D, kaiZFVonMangoldt K J = Real.log (Ideal.absNorm I) := by
    intro D hD
    obtain ⟨F, hFdef⟩ : ∃ F : Multiset (Ideal (NumberField.RingOfIntegers K)),
        F = UniqueFactorizationMonoid.normalizedFactors I := ⟨_, rfl⟩
    have hprime : ∀ P ∈ F.toFinset, Prime P := by
      intro P hP
      rw [Multiset.mem_toFinset, hFdef] at hP
      exact UniqueFactorizationMonoid.prime_of_normalized_factor P hP
    have hbot : ∀ P : Ideal (NumberField.RingOfIntegers K), Prime P → P ≠ ⊥ :=
      fun P hp h => hp.ne_zero (h.trans Submodule.zero_eq_bot.symm)
    have hnfP : ∀ P : Ideal (NumberField.RingOfIntegers K), Prime P →
        UniqueFactorizationMonoid.normalizedFactors P = {P} := by
      intro P hp
      rw [UniqueFactorizationMonoid.normalizedFactors_irreducible hp.irreducible, normalize_eq]
    have hdvdiff : ∀ P : Ideal (NumberField.RingOfIntegers K), Prime P → ∀ k : ℕ,
        (P ^ k ∣ I ↔ k ≤ Multiset.count P F) := by
      intro P hp k
      have hPk0 : P ^ k ≠ 0 := pow_ne_zero k hp.ne_zero
      rw [UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hPk0 hI,
        UniqueFactorizationMonoid.normalizedFactors_pow, hnfP P hp, Multiset.nsmul_singleton,
        hFdef]
      exact Multiset.le_count_iff_replicate_le.symm
    have hNP2 : ∀ P : Ideal (NumberField.RingOfIntegers K), Prime P →
        2 ≤ Ideal.absNorm P := by
      intro P hp
      have h0 : Ideal.absNorm P ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hbot P hp
      have h1 : Ideal.absNorm P ≠ 1 := by
        rw [Ne, Ideal.absNorm_eq_one_iff]
        intro h
        exact hp.not_unit (Ideal.isUnit_iff.mpr h)
      omega
    have hNP2R : ∀ P : Ideal (NumberField.RingOfIntegers K), Prime P →
        (2 : ℝ) ≤ (Ideal.absNorm P : ℝ) := by
      intro P hp
      exact_mod_cast hNP2 P hp
    have hlogNP : ∀ P : Ideal (NumberField.RingOfIntegers K), Prime P →
        0 < Real.log (Ideal.absNorm P) := by
      intro P hp
      exact Real.log_pos (by linarith [hNP2R P hp])
    have hIprod : I = ∏ P ∈ F.toFinset, P ^ Multiset.count P F := by
      have h1 : F.prod = I := by
        rw [hFdef]
        exact associated_iff_eq.mp (UniqueFactorizationMonoid.prod_normalizedFactors hI)
      rw [← h1, Finset.prod_multiset_count F]
    have hlogI : Real.log (Ideal.absNorm I)
        = ∑ P ∈ F.toFinset, (Multiset.count P F : ℝ) * Real.log (Ideal.absNorm P) := by
      have hN : Ideal.absNorm I
          = ∏ P ∈ F.toFinset, (Ideal.absNorm P) ^ Multiset.count P F := by
        conv_lhs => rw [hIprod]
        rw [map_prod Ideal.absNorm (fun P => P ^ Multiset.count P F) F.toFinset]
        exact Finset.prod_congr rfl (fun P _ => map_pow Ideal.absNorm P _)
      rw [hN]
      push_cast
      rw [Real.log_prod]
      · exact Finset.sum_congr rfl (fun P _ => Real.log_pow _ _)
      · intro P hP
        exact pow_ne_zero _ (by linarith [hNP2R P (hprime P hP)])
    have hsum : ∑ J ∈ D, kaiZFVonMangoldt K J
        = ∑ x ∈ F.toFinset.sigma (fun P => Finset.Icc 1 (Multiset.count P F)),
            Real.log (Ideal.absNorm x.1) := by
      rw [← Finset.sum_filter_ne_zero D]
      refine (Finset.sum_nbij
        (i := fun x : (_ : Ideal (NumberField.RingOfIntegers K)) × ℕ => x.1 ^ x.2)
        ?_ ?_ ?_ ?_).symm
      · rintro ⟨P, k⟩ ha
        simp only [Finset.mem_sigma, Finset.mem_Icc] at ha
        obtain ⟨hPT, hk1, hk2⟩ := ha
        have hp := hprime P hPT
        rw [Finset.mem_filter]
        refine ⟨(hD _).mpr ((hdvdiff P hp k).mpr hk2), ?_⟩
        rw [hVMpp P (Ideal.isPrime_of_prime hp) (hbot P hp) k (by omega)]
        exact ne_of_gt (hlogNP P hp)
      · rintro ⟨P, k⟩ ha ⟨Q, l⟩ hb hEq
        simp only [Finset.mem_coe, Finset.mem_sigma, Finset.mem_Icc] at ha hb
        obtain ⟨hPT, hk1, hk2⟩ := ha
        obtain ⟨hQT, hl1, hl2⟩ := hb
        have hp := hprime P hPT
        have hq := hprime Q hQT
        have hEq' : P ^ k = Q ^ l := hEq
        have hQdvd : Q ∣ P ^ k :=
          (dvd_pow_self Q (by omega : l ≠ 0)).trans (dvd_of_eq hEq'.symm)
        have hQP : Q = P :=
          associated_iff_eq.mp (hq.associated_of_dvd hp (hq.dvd_of_dvd_pow hQdvd))
        have hEq2 : P ^ k = P ^ l := by rw [hEq', hQP]
        have hn : Ideal.absNorm P ^ k = Ideal.absNorm P ^ l := by
          rw [← map_pow Ideal.absNorm P k, ← map_pow Ideal.absNorm P l, hEq2]
        have hkl : k = l := Nat.pow_right_injective (hNP2 P hp) hn
        rw [← hQP, hkl]
      · rintro J hJ
        simp only [Finset.mem_coe, Finset.mem_filter] at hJ
        obtain ⟨hJD, hJne⟩ := hJ
        have hguard : ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
            P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ J = P ^ k := by
          by_contra hg
          apply hJne
          simp only [kaiZFVonMangoldt]
          rw [dif_neg hg]
        obtain ⟨P, k, hPp, hPb, hk, hJeq⟩ := hguard
        have hp : Prime P := Ideal.prime_of_isPrime hPb hPp
        have hdvd : P ^ k ∣ I := by rw [← hJeq]; exact (hD J).mp hJD
        have hcnt : k ≤ Multiset.count P F := (hdvdiff P hp k).mp hdvd
        have hPT : P ∈ F.toFinset := by
          rw [Multiset.mem_toFinset, ← Multiset.count_pos]
          omega
        refine ⟨⟨P, k⟩, ?_, hJeq.symm⟩
        simp only [Finset.mem_coe, Finset.mem_sigma, Finset.mem_Icc]
        exact ⟨hPT, hk, hcnt⟩
      · rintro ⟨P, k⟩ ha
        simp only [Finset.mem_sigma, Finset.mem_Icc] at ha
        obtain ⟨hPT, hk1, hk2⟩ := ha
        have hp := hprime P hPT
        exact (hVMpp P (Ideal.isPrime_of_prime hp) (hbot P hp) k (by omega)).symm
    have hS : ∑ x ∈ F.toFinset.sigma (fun P => Finset.Icc 1 (Multiset.count P F)),
          Real.log (Ideal.absNorm x.1)
        = ∑ P ∈ F.toFinset, ∑ _k ∈ Finset.Icc 1 (Multiset.count P F),
            Real.log (Ideal.absNorm P) :=
      (Finset.sum_sigma' F.toFinset (fun P => Finset.Icc 1 (Multiset.count P F))
        (fun P _ => Real.log (Ideal.absNorm P))).symm
    rw [hsum, hS, hlogI]
    refine Finset.sum_congr rfl (fun P _ => ?_)
    rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul]
    simp
  have hfin : {J : Ideal (NumberField.RingOfIntegers K) | J ∣ I}.Finite := by
    refine Set.Finite.subset (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I)) ?_
    rintro J hJ
    exact Nat.le_of_dvd (hNnat I hI) (map_dvd Ideal.absNorm hJ)
  have hD : ∀ J : Ideal (NumberField.RingOfIntegers K), J ∈ hfin.toFinset ↔ J ∣ I :=
    fun J => Set.Finite.mem_toFinset _
  rw [← hVMdiv hfin.toFinset hD, ← Finset.tsum_subtype hfin.toFinset
    (fun J => kaiZFVonMangoldt K J)]
  exact Equiv.tsum_eq (Equiv.subtypeEquivRight (fun J => (hD J).symm))
    (fun J : {J : Ideal (NumberField.RingOfIntegers K) // J ∈ hfin.toFinset} =>
      kaiZFVonMangoldt K (J : Ideal (NumberField.RingOfIntegers K)))

theorem kai_hecke_series_basics_00 (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    KaiZFSeriesBasicsProp K :=
by
  obtain ⟨Z, hZ0, hzeta, -⟩ := kai_zf_ideal_norm_conv K
  obtain ⟨col, rchar, rdeg, hnorm, hcolinj⟩ := kai_zf_prime_norm_colouring K
  obtain ⟨Φ, hinj, hΦ⟩ := kai_zf_ideal_norm_tuple_inj K col rchar rdeg hnorm hcolinj
  have hzpow : ∀ σ : ℝ, 1 < σ →
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))
        ≤ (1 + 1 / (σ - 1)) ^ (Module.finrank ℚ K) := fun σ hσ =>
    kai_zf_dedekind_zeta_le_pow K Φ hinj hΦ σ hσ (hzeta σ hσ)
  have hmu := kai_zf_ideal_moebius K
  have hconv := kai_zf_ideal_dirichlet_conv K
  have hlogdiv := kai_zf_log_norm_divisor_sum K
  
  have hfib : KaiZFFiberProp K := by
    intro I hI gg
    obtain ⟨Phi, hPhi⟩ :
        ∃ Phi : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                      {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
              (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
                (pr.2 : Ideal (NumberField.RingOfIntegers K)) = I} →
            {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I},
          Phi = fun pr => ⟨(pr.1.2 : Ideal (NumberField.RingOfIntegers K)),
            ⟨(pr.1.1 : Ideal (NumberField.RingOfIntegers K)),
              pr.2.symm.trans (mul_comm _ _)⟩⟩ := ⟨_, rfl⟩
    have hval : ∀ pr, ((Phi pr : Ideal (NumberField.RingOfIntegers K)))
        = (pr.1.2 : Ideal (NumberField.RingOfIntegers K)) := by
      intro pr; rw [hPhi]
    have hinj' : Function.Injective Phi := by
      intro p q hpq
      have h2 : (p.1.2 : Ideal (NumberField.RingOfIntegers K))
          = (q.1.2 : Ideal (NumberField.RingOfIntegers K)) := by
        rw [← hval p, ← hval q, hpq]
      have hne : (p.1.2 : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := p.1.2.2
      have hpq2 : (p.1.1 : Ideal (NumberField.RingOfIntegers K)) *
            (p.1.2 : Ideal (NumberField.RingOfIntegers K))
          = (q.1.1 : Ideal (NumberField.RingOfIntegers K)) *
            (p.1.2 : Ideal (NumberField.RingOfIntegers K)) := by
        rw [p.2, h2, q.2]
      exact Subtype.ext
        (Prod.ext (Subtype.ext (mul_right_cancel₀ hne hpq2)) (Subtype.ext h2))
    have hsurj : Function.Surjective Phi := by
      rintro ⟨J, c, hc⟩
      have hJ0 : J ≠ 0 := by
        rintro rfl; rw [zero_mul] at hc; exact hI hc
      have hc0 : c ≠ 0 := by
        rintro rfl; rw [mul_zero] at hc; exact hI hc
      refine ⟨⟨(⟨c, hc0⟩, ⟨J, hJ0⟩), by rw [hc]; ring⟩, ?_⟩
      apply Subtype.ext
      rw [hval]
    have key := Equiv.tsum_eq (Equiv.ofBijective Phi ⟨hinj', hsurj⟩)
      (fun J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I} =>
        gg (J : Ideal (NumberField.RingOfIntegers K)))
    refine Eq.trans ?_ key
    exact tsum_congr (fun pr => congrArg gg (hval pr).symm)
  
  have hNnat : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      0 < Ideal.absNorm I := by
    intro I hI
    have hb : I ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hne : Ideal.absNorm I ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]
      exact hb
    omega
  have hNpos : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      (1 : ℝ) ≤ (Ideal.absNorm I : ℝ) := by
    intro I hI
    have h : (1 : ℕ) ≤ Ideal.absNorm I := hNnat I hI
    exact_mod_cast h
  have hvM0 : ∀ I : Ideal (NumberField.RingOfIntegers K),
      0 ≤ kaiZFVonMangoldt K I := by
    intro I
    simp only [kaiZFVonMangoldt]
    split_ifs with h
    · obtain ⟨k, hp, hb, hk, hIe⟩ := h.choose_spec
      have hP0 : h.choose ≠ 0 := fun hc => hb (hc.trans Submodule.zero_eq_bot)
      exact Real.log_nonneg (hNpos _ hP0)
    · exact le_rfl
  have hvMle : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      kaiZFVonMangoldt K I ≤ Real.log (Ideal.absNorm I) := by
    intro I hI
    simp only [kaiZFVonMangoldt]
    split_ifs with h
    · obtain ⟨k, hp, hb, hk, hIe⟩ := h.choose_spec
      have hP0 : h.choose ≠ 0 := fun hc => hb (hc.trans Submodule.zero_eq_bot)
      have hPn : 0 < Ideal.absNorm h.choose := hNnat _ hP0
      have hNe : Ideal.absNorm I = (Ideal.absNorm h.choose) ^ k := by
        have h2 : Ideal.absNorm I = Ideal.absNorm (h.choose ^ k) :=
          congrArg (fun J : Ideal (NumberField.RingOfIntegers K) => Ideal.absNorm J) hIe
        rw [h2]
        exact map_pow _ _ _
      have hle : (Ideal.absNorm h.choose : ℝ) ≤ (((Ideal.absNorm h.choose) ^ k : ℕ) : ℝ) := by
        exact_mod_cast Nat.le_self_pow (by omega) (Ideal.absNorm h.choose)
      rw [hNe]
      exact Real.log_le_log (by exact_mod_cast hPn) hle
    · exact Real.log_nonneg (hNpos I hI)
  have hlogrpow : ∀ y τ : ℝ, 1 ≤ y → 0 < τ → Real.log y ≤ y ^ τ / τ := by
    intro y τ hy hτ
    have hy0 : (0 : ℝ) < y := by linarith only [hy]
    have hstep : Real.log (y ^ τ) ≤ y ^ τ - 1 :=
      Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hy0 τ)
    rw [Real.log_rpow hy0] at hstep
    rw [le_div_iff₀ hτ]
    linarith only [hstep]
  
  have hnormdiv : ∀ (s c : ℂ) (I : Ideal (NumberField.RingOfIntegers K)), I ≠ 0 →
      ‖c / ((Ideal.absNorm I : ℂ) ^ s)‖
        = ‖c‖ * ((Ideal.absNorm I : ℝ)) ^ (-s.re) := by
    intro s c I hI
    rw [norm_div, Complex.norm_natCast_cpow_of_pos (hNnat I hI) s,
      Real.rpow_neg (Nat.cast_nonneg _), div_eq_mul_inv]
  have htermbd : ∀ (s : ℂ) (c : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖c I‖ ≤ 1) →
      ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ‖c (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)‖
          ≤ ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-s.re) := by
    intro s c hc I
    rw [hnormdiv s _ _ I.2]
    exact mul_le_of_le_one_left (Real.rpow_nonneg (Nat.cast_nonneg _) _) (hc _)
  have hsumnorm : ∀ s : ℂ, 1 < s.re → ∀ (c : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖c I‖ ≤ 1) →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ‖c (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)‖) := by
    intro s hs c hc
    exact Summable.of_nonneg_of_le (fun I => norm_nonneg _) (htermbd s c hc) (hzeta s.re hs)
  have hdivneg : ∀ (s c : ℂ) (I : Ideal (NumberField.RingOfIntegers K)),
      c / ((Ideal.absNorm I : ℂ) ^ s) = c * ((Ideal.absNorm I : ℂ) ^ (-s)) := by
    intro s c I
    rw [Complex.cpow_neg, div_eq_mul_inv]
  
  have hderivS : ∀ (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1) →
      ∀ s : ℂ, 1 < s.re →
      DifferentiableAt ℂ (kaiHeckeSeries K lam) s ∧
        deriv (kaiHeckeSeries K lam) s
          = - ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              lam (I : Ideal (NumberField.RingOfIntegers K)) *
                ((Real.log (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ) *
                ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) := by
    intro lam hbd s hs
    have key : ∀ m : ℕ, 0 < m → ∀ a z : ℂ,
        HasDerivAt (fun w : ℂ => a / ((m : ℂ) ^ w))
          (-(a * ((Real.log m : ℝ) : ℂ) * ((m : ℂ) ^ (-z)))) z := by
      intro m hm a z
      have hc : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have h1 : HasDerivAt (fun w : ℂ => -w) (-1) z := hasDerivAt_neg z
      have h2 := h1.const_cpow (Or.inl hc)
