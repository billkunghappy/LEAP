              ∃ m : ℤ, Algebra.trace ℚ K (((x : NumberField.RingOfIntegers K) : K) * y)
                = (m : ℚ)) ∧
          (∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
