        rw [Complex.mem_reProdIm, huIcc1, huIcc2]
        exact ⟨Set.Ioo_subset_Icc_self hz.1, Set.Ioo_subset_Icc_self hz.2⟩
      · rw [Complex.mem_reProdIm, Complex.ofReal_re, Complex.ofReal_im]
        exact ⟨Set.mem_Ioo.mpr ⟨hac, hcb⟩, Set.mem_Ioo.mpr ⟨by linarith, hT⟩⟩
    have hdiff : DifferentiableOn ℂ (dslope f ((c : ℝ) : ℂ))
        (Set.uIcc a b ×ℂ Set.uIcc (-T) T) :=
      (Complex.differentiableOn_dslope hnhds).mpr hfR
    have hdsC : ContinuousOn (dslope f ((c : ℝ) : ℂ)) (Set.uIcc a b ×ℂ Set.uIcc (-T) T) :=
      hdiff.continuousOn
    have hre1 : (((a : ℝ) : ℂ) + ((-T : ℝ) : ℂ) * Complex.I).re = a := by simp
    have him1 : (((a : ℝ) : ℂ) + ((-T : ℝ) : ℂ) * Complex.I).im = -T := by simp
    have hre2 : (((b : ℝ) : ℂ) + ((T : ℝ) : ℂ) * Complex.I).re = b := by simp
    have him2 : (((b : ℝ) : ℂ) + ((T : ℝ) : ℂ) * Complex.I).im = T := by simp
    have hCG := Complex.integral_boundary_rect_eq_zero_of_differentiableOn
        (dslope f ((c : ℝ) : ℂ)) (((a : ℝ) : ℂ) + ((-T : ℝ) : ℂ) * Complex.I)
        (((b : ℝ) : ℂ) + ((T : ℝ) : ℂ) * Complex.I)
        (by rw [hre1, him1, hre2, him2]; exact hdiff)
    rw [hre1, him1, hre2, him2, smul_eq_mul, smul_eq_mul] at hCG
    have hnzBo : ∀ x : ℝ, ((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) - (c : ℂ) ≠ 0 := by
      intro x hx
      have him : (((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) - (c : ℂ)).im = -T := by simp
      rw [hx] at him
      simp at him
      linarith
    have hnzTo : ∀ x : ℝ, ((x : ℂ) + ((T : ℝ) : ℂ) * Complex.I) - (c : ℂ) ≠ 0 := by
      intro x hx
      have him : (((x : ℂ) + ((T : ℝ) : ℂ) * Complex.I) - (c : ℂ)).im = T := by simp
