  obtain ⟨hCov, hIntTrans⟩ := hcov S (by rw [hSdetC]; exact hCdet0) F hFmeas
  have hCov' : (∫ v : NumberField.InfinitePlace K → ℝ, F (S v))
      = |C.det|⁻¹ * ∫ L : NumberField.InfinitePlace K → ℝ, F L := by
    rw [hCov, hSdetC]
  have hGint : MeasureTheory.Integrable
      (fun v : NumberField.InfinitePlace K → ℝ => F (S v)) := hIntTrans hFint
  
  have hSapply : ∀ (v : NumberField.InfinitePlace K → ℝ)
      (x : NumberField.InfinitePlace K),
      S v x = ∑ y : NumberField.InfinitePlace K, C x y * v y := by
    intro v x
    rw [hSdef]
    simp [Matrix.toLin'_apply, Matrix.mulVec, dotProduct]
  have hStheta : ∀ (ν : ℝ) (W : Fin (NumberField.Units.rank K) → ℝ)
      (x : NumberField.InfinitePlace K),
      S (fun i : NumberField.InfinitePlace K =>
          if h : i = w₀ then ν else W (ee ⟨i, h⟩)) x
        = ν / ((Module.finrank ℚ K : ℕ) : ℝ) + kaiTBShapeLog K H W x := by
    intro ν W x
    rw [hSapply, Fintype.sum_eq_add_sum_compl w₀]
    congr 1
    · rw [hCdef]
      simp only [Matrix.of_apply, dif_pos]
      rw [inv_mul_eq_div]
    · rw [Finset.sum_subtype (s := ({w₀} : Finset (NumberField.InfinitePlace K))ᶜ)
        (p := fun y : NumberField.InfinitePlace K => y ≠ w₀) (fun y => by simp)]
      have hterm : ∀ y : {w : NumberField.InfinitePlace K // w ≠ w₀},
          C x (y : NumberField.InfinitePlace K)
              * (if h : (y : NumberField.InfinitePlace K) = w₀ then ν
                  else W (ee ⟨(y : NumberField.InfinitePlace K), h⟩))
            = W (ee y)
                * Real.log (x (((H (ee y) : NumberField.RingOfIntegers K)) : K)) := by
        intro y
        rw [hCdef]
        simp only [Matrix.of_apply, dif_neg y.2, Subtype.coe_eta, kaiTBUnitLog]
        rw [mul_div_cancel_left₀ _ (hmultR x)]
        ring
      rw [Finset.sum_congr rfl (fun y _ => hterm y),
        Equiv.sum_comp ee (fun j => W j
          * Real.log (x (((H j : NumberField.RingOfIntegers K)) : K)))]
      rfl
  have hsumnu : ∀ (ν : ℝ) (W : Fin (NumberField.Units.rank K) → ℝ),
      (∑ x : NumberField.InfinitePlace K, ((x.mult : ℕ) : ℝ)
          * (ν / ((Module.finrank ℚ K : ℕ) : ℝ) + kaiTBShapeLog K H W x)) = ν := by
    intro ν W
    have h1 : ∀ x : NumberField.InfinitePlace K,
        ((x.mult : ℕ) : ℝ) * (ν / ((Module.finrank ℚ K : ℕ) : ℝ)
            + kaiTBShapeLog K H W x)
          = ((x.mult : ℕ) : ℝ) * (ν / ((Module.finrank ℚ K : ℕ) : ℝ))
            + ∑ j : Fin (NumberField.Units.rank K),
                W j * kaiTBUnitLog K (H j) x := by
      intro x
      rw [mul_add]
      congr 1
      simp only [kaiTBShapeLog, kaiTBUnitLog, Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [Finset.sum_congr rfl fun x _ => h1 x, Finset.sum_add_distrib, ← Finset.sum_mul,
      ← hsum_mult, Finset.sum_comm]
    have h2 : (∑ j : Fin (NumberField.Units.rank K),
        ∑ x : NumberField.InfinitePlace K, W j * kaiTBUnitLog K (H j) x) = 0 := by
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [← Finset.mul_sum, hunitlog j, mul_zero]
    rw [h2, add_zero]
    field_simp
  
  have hFfib : ∀ (ν : ℝ) (W : Fin (NumberField.Units.rank K) → ℝ),
      F (S (fun i : NumberField.InfinitePlace K =>
              if h : i = w₀ then ν else W (ee ⟨i, h⟩)))
        = (if ∀ x : NumberField.InfinitePlace K,
                kaiTBCellLo K a b ρ σ x
                    < Real.exp (ν / ((Module.finrank ℚ K : ℕ) : ℝ)
                        + kaiTBShapeLog K H W x)
                  ∧ Real.exp (ν / ((Module.finrank ℚ K : ℕ) : ℝ)
                        + kaiTBShapeLog K H W x) ≤ kaiTBCellHi K a b ρ σ x
            then Real.exp (γ * ν) else 0) := by
    intro ν W
    simp only [hFdef]
    by_cases hc : ∀ x : NumberField.InfinitePlace K,
        kaiTBCellLo K a b ρ σ x
            < Real.exp (ν / ((Module.finrank ℚ K : ℕ) : ℝ) + kaiTBShapeLog K H W x)
          ∧ Real.exp (ν / ((Module.finrank ℚ K : ℕ) : ℝ) + kaiTBShapeLog K H W x)
            ≤ kaiTBCellHi K a b ρ σ x
    · rw [if_pos hc]
      have hfac : ∀ x ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
          (if kaiTBCellLo K a b ρ σ x
                < Real.exp (S (fun i : NumberField.InfinitePlace K =>
                    if h : i = w₀ then ν else W (ee ⟨i, h⟩)) x)
              ∧ Real.exp (S (fun i : NumberField.InfinitePlace K =>
                    if h : i = w₀ then ν else W (ee ⟨i, h⟩)) x)
                ≤ kaiTBCellHi K a b ρ σ x
            then Real.exp ((γ * ((x.mult : ℕ) : ℝ))
                  * S (fun i : NumberField.InfinitePlace K =>
                      if h : i = w₀ then ν else W (ee ⟨i, h⟩)) x)
            else 0)
            = Real.exp ((γ * ((x.mult : ℕ) : ℝ))
                * (ν / ((Module.finrank ℚ K : ℕ) : ℝ) + kaiTBShapeLog K H W x)) := by
        intro x _
        rw [hStheta ν W x, if_pos (hc x)]
      rw [Finset.prod_congr rfl hfac, ← Real.exp_sum]
      congr 1
      conv_rhs => rw [← hsumnu ν W]
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun x _ => by ring)
    · rw [if_neg hc]
      obtain ⟨x₁, hx₁⟩ := not_forall.mp hc
      refine Finset.prod_eq_zero (Finset.mem_univ x₁) ?_
      rw [hStheta ν W x₁, if_neg hx₁]
  
  have hinner : ∀ W : Fin (NumberField.Units.rank K) → ℝ,
      (∫ ν : ℝ, F (S (fun i : NumberField.InfinitePlace K =>
            if h : i = w₀ then ν else W (ee ⟨i, h⟩))))
        = max (kaiTBEplus K H a b ρ σ W ^ γ - kaiTBEminus K H a b ρ σ W ^ γ) 0 / γ := by
    intro W
    rw [MeasureTheory.integral_congr_ae
      (Filter.Eventually.of_forall (fun ν => hFfib ν W)),
      hlayer (Module.finrank ℚ K) hnpos
        (kaiTBCellLo K a b ρ σ) (kaiTBCellHi K a b ρ σ) (kaiTBShapeLog K H W)
        (fun x => (hlo x).1) (fun x => le_of_lt (lt_of_le_of_lt (hlo x).1 (hlo x).2)) γ hγ]
    simp only [kaiTBEplus, kaiTBEminus]
  
  have hsplit := hsplitL w₀ ee
    (fun v : NumberField.InfinitePlace K → ℝ => F (S v)) hGint
  have hIntegral : kaiTBShapePow K H a b ρ σ γ / γ
      = ∫ v : NumberField.InfinitePlace K → ℝ, F (S v) := by
    rw [hsplit]
    simp only [kaiTBShapePow]
    rw [← MeasureTheory.integral_div]
    exact (MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hinner)).symm
  
  have hRne : Rq ≠ 0 := hRqpos.ne'
  have hq0 : Rq / (∏ w : NumberField.InfinitePlace K, ((w.mult : ℕ) : ℝ)) ≠ 0 :=
    div_ne_zero hRne hpne
  rw [hIntegral, hCov', hFval, hCabs, ← hprod2, ← mul_assoc, mul_inv_cancel₀ hq0, one_mul]

theorem kai_cell_trivial_bounds (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] (B₁ : ℝ) :
    ∃ MΨ V : ℝ, 0 ≤ MΨ ∧ 0 ≤ V ∧
      ∀ S : Set (NumberField.mixedEmbedding.mixedSpace K),
        (∀ z ∈ S, ∀ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w z < B₁) →
        (MeasureTheory.volume S).toReal ≤ V ∧
          ∀ (q : Ideal (NumberField.RingOfIntegers K)) (α : NumberField.RingOfIntegers K),
            0 ≤ kaiPrimePsi K q α S ∧ kaiPrimePsi K q α S ≤ MΨ :=
by
  classical
  have hfin : {x : NumberField.RingOfIntegers K |
      ∀ w : NumberField.InfinitePlace K, w (x : K) < B₁}.Finite := by
    refine Set.Finite.of_finite_image
      (f := fun x : NumberField.RingOfIntegers K => (x : K)) ?_ ?_
    · refine Set.Finite.subset (NumberField.Embeddings.finite_of_norm_le K ℂ B₁) ?_
      rintro y ⟨x, hx, rfl⟩
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      have h := hx (NumberField.InfinitePlace.mk φ)
      rw [NumberField.InfinitePlace.apply] at h
      exact h.le
    · intro a _ b _ hab
      exact NumberField.RingOfIntegers.coe_injective hab
  obtain ⟨T, hT⟩ : ∃ T : Finset (NumberField.RingOfIntegers K),
      ∀ x : NumberField.RingOfIntegers K,
        (∀ w : NumberField.InfinitePlace K, w (x : K) < B₁) → x ∈ T :=
    ⟨hfin.toFinset, fun x hx => hfin.mem_toFinset.mpr hx⟩
  have hbox : MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B₁} ≠ ⊤ := by
    have hsub : {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < B₁}
        ⊆ Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) (max B₁ 0) := by
      intro z hz
      rw [mem_closedBall_zero_iff, Prod.norm_def]
      refine max_le ?_ ?_
      · refine (pi_norm_le_iff_of_nonneg (le_max_right B₁ 0)).mpr (fun i => ?_)
        have h1 : ‖z.1 i‖ = NumberField.mixedEmbedding.normAtPlace i.1 z :=
          (NumberField.mixedEmbedding.normAtPlace_apply_of_isReal i.2 z).symm
        rw [h1]
        exact le_trans (hz i.1).le (le_max_left B₁ 0)
      · refine (pi_norm_le_iff_of_nonneg (le_max_right B₁ 0)).mpr (fun i => ?_)
        have h1 : ‖z.2 i‖ = NumberField.mixedEmbedding.normAtPlace i.1 z :=
          (NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex i.2 z).symm
        rw [h1]
        exact le_trans (hz i.1).le (le_max_left B₁ 0)
    exact (lt_of_le_of_lt (MeasureTheory.measure_mono hsub)
      MeasureTheory.measure_closedBall_lt_top).ne
  refine ⟨∑ x ∈ T, Real.log ((Algebra.norm ℤ x).natAbs : ℝ),
    (MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B₁}).toReal,
    Finset.sum_nonneg (fun x _ => Real.log_natCast_nonneg _), ENNReal.toReal_nonneg, ?_⟩
  intro S hS
  have hSsub : S ⊆ {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B₁} := fun z hz => hS z hz
  refine ⟨ENNReal.toReal_mono hbox (MeasureTheory.measure_mono hSsub), ?_⟩
  have hcap : ∀ x : NumberField.RingOfIntegers K,
      NumberField.mixedEmbedding K (x : K) ∈ S → x ∈ T := by
    intro x hx
    refine hT x (fun w => ?_)
    have h := hS _ hx w
    rwa [NumberField.mixedEmbedding.normAtPlace_apply] at h
  intro q α
  have hPsi : kaiPrimePsi K q α S = ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q},
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) := rfl
  rw [hPsi]
  refine ⟨tsum_nonneg (fun i => Real.log_natCast_nonneg _), ?_⟩
  refine tsum_le_of_sum_le'
    (Finset.sum_nonneg (fun x _ => Real.log_natCast_nonneg _)) (fun s => ?_)
  have hinj : Set.InjOn (fun i : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q} =>
      (i : NumberField.RingOfIntegers K)) ↑s := fun a _ b _ hab => Subtype.coe_injective hab
  have hsi : ∑ i ∈ s, Real.log ((Algebra.norm ℤ (i : NumberField.RingOfIntegers K)).natAbs : ℝ)
      = ∑ x ∈ Finset.image (fun i : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q} =>
          (i : NumberField.RingOfIntegers K)) s,
        Real.log ((Algebra.norm ℤ x).natAbs : ℝ) :=
    (Finset.sum_image (f := fun x : NumberField.RingOfIntegers K =>
      Real.log ((Algebra.norm ℤ x).natAbs : ℝ)) hinj).symm
  rw [hsi]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun x _ _ => Real.log_natCast_nonneg _)
  intro x hx
  simp only [Finset.mem_image] at hx
  obtain ⟨i, -, rfl⟩ := hx
  exact hcap _ i.2.2.1

theorem kai_lp_cell_estimate (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ cP : ℝ, 0 < cP → ∃ c₀ C₀ : ℝ, 0 < c₀ ∧ 0 ≤ C₀ ∧
      ∀ X : ℝ, 3 ≤ X →
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        (Ideal.absNorm q : ℝ) ≤ Real.exp (Real.log X ^ c₀) →
      ∀ (𝔮D : Ideal (NumberField.RingOfIntegers K))
        (ψ : NumberField.RingOfIntegers K → ℤ) (β : ℝ),
        (ψ = 0 ∨ (IsRealRayChar 𝔮D ψ ∧ 1 / 2 ≤ β ∧ β < 1)) →
      (∀ x : ℝ, 3 ≤ x → X ^ ((1:ℝ)/4) ≤ x →
        ∀ (t : NumberField.InfinitePlace K → ℝ)
          (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
          (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
          (∀ v : (NumberField.RingOfIntegers K)ˣ,
            kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1) →
          ‖(∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
              kaiHeckeTwist K q t l ξ η (kaiGen (P : Ideal (NumberField.RingOfIntegers K)))
                * ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ))
            - ((((@ite ℝ (∀ y : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q y) →
                      kaiHeckeTwist K q t l ξ η y = 1) (Classical.propDecidable _) (1 : ℝ) 0) * x
                  - (@ite ℝ (ψ ≠ 0 ∧ t = 0 ∧ l = 0 ∧
                        ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
                          IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
                          kaiHeckeTwist K q t l ξ η y = ((ψ y : ℤ) : ℂ))
                      (Classical.propDecidable _) (1 : ℝ) 0) * (x ^ β / β))
                / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)‖
            ≤ cP * x * Real.log x ^ 2 * Real.log (1 + kaiInfSize K t l) *
                Real.exp (-(Real.log x) /
                  (cP * (Real.sqrt (Real.log x) + Real.log (1 + kaiInfSize K t l))))) →
      ∀ α : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {α}) q →
      ∀ (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
        (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
        (∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ Real.sqrt X ≤ b w - a w ∧
          ((0 ≤ a w ∧ 0 < (NumberField.mixedEmbedding K (α : K)).1 w) ∨
           (b w ≤ 0 ∧ (NumberField.mixedEmbedding K (α : K)).1 w < 0))) →
        (∀ w, 0 ≤ ρ w ∧ ρ w < σ w ∧ σ w ≤ X ∧ Real.sqrt X ≤ σ w - ρ w ∧
          -Real.pi ≤ θ₁ w ∧ θ₁ w ≤ θ₂ w ∧ θ₂ w ≤ Real.pi) →
        |kaiPrimePsi K q α (kaiCell K a b ρ σ θ₁ θ₂)
          - kaiKappa0 K / (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
              ((MeasureTheory.volume (kaiCell K a b ρ σ θ₁ θ₂)).toReal
                - (@ite ℝ (ψ ≠ 0 ∧ q ≤ 𝔮D) (Classical.propDecidable _) ((ψ α : ℤ) : ℝ) 0) *
                    ∫ z in kaiCell K a b ρ σ θ₁ θ₂,
                      (NumberField.mixedEmbedding.norm z) ^ (β - 1))|
          ≤ C₀ * X ^ (Module.finrank ℚ K) * Real.exp (-(Real.log X ^ c₀)) :=
by
  classical
  intro cP hcP
  obtain ⟨B, hB1, hUL⟩ := kai_tb_unit_lattice K
  obtain ⟨c₂, K₂, hc₂, hK₂, hTB⟩ := kai_lp_torus_box K cP B hcP hB1
  obtain ⟨c₄, X₄, hc₄, hX₄, hCT⟩ := kai_lp_cell_of_torus_box K B c₂ hB1 hc₂
  obtain ⟨X₁, hX₁⟩ : ∃ X₁ : ℝ, X₁ = max (max X₄ (Real.exp (16 * K₂ ^ 4)))
      (max (Real.exp (c₄ ^ 4)) (Real.exp 8)) := ⟨_, rfl⟩
  have hX₁4 : X₄ ≤ X₁ := by rw [hX₁]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hX₁K : Real.exp (16 * K₂ ^ 4) ≤ X₁ := by
    rw [hX₁]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hX₁c : Real.exp (c₄ ^ 4) ≤ X₁ := by
    rw [hX₁]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hX₁8 : Real.exp 8 ≤ X₁ := by
    rw [hX₁]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  obtain ⟨MΨ, V, hMΨ, hV, hTriv⟩ := kai_cell_trivial_bounds K (X₁ + 1)
  have hκ₀ : 0 ≤ kaiKappa0 K := by
    unfold kaiKappa0
    have := NumberField.Units.regulator_pos K
    positivity
  obtain ⟨Ibd, hIbd⟩ : ∃ Ibd : ℝ, Ibd =
      (2 * Real.pi) ^ (Finset.univ : Finset {w : NumberField.InfinitePlace K // w.IsComplex}).card *
        (2 * X₁ ^ 2) ^ (Finset.univ : Finset (NumberField.InfinitePlace K)).card := ⟨_, rfl⟩
  have hIbd0 : 0 ≤ Ibd := by rw [hIbd]; positivity
  obtain ⟨Bnd, hBnd⟩ : ∃ Bnd : ℝ, Bnd = MΨ + kaiKappa0 K * (V + Ibd) := ⟨_, rfl⟩
  have hBnd0 : 0 ≤ Bnd := by rw [hBnd]; positivity
  have hC₀0 : 0 ≤ max c₄ (Bnd * Real.exp (Real.log X₁ ^ ((1:ℝ)/4))) :=
    le_max_of_le_left hc₄.le
  refine ⟨1/4, max c₄ (Bnd * Real.exp (Real.log X₁ ^ ((1:ℝ)/4))), by norm_num, hC₀0, ?_⟩
  intro X hX q hq hqN 𝔮D ψ β hψ HYP α hα a b ρ σ θ₁ θ₂ hab hρσ
  have hXpos : 0 < X := by linarith
  have hXn : (1 : ℝ) ≤ X ^ Module.finrank ℚ K := one_le_pow₀ (by linarith)
  have hidem : ∀ x : NumberField.RingOfIntegers K, ψ x = ψ x * ψ x → ψ x ≠ 0 → ψ x = 1 := by
    intro x h h0
    have h' : ψ x * ψ x = ψ x * 1 := by rw [mul_one]; exact h.symm
    exact mul_left_cancel₀ h0 h'
  
  obtain ⟨α', hα'0, hα'cop, hab', hΨeq, hεeq⟩ : ∃ α' : NumberField.RingOfIntegers K, α' ≠ 0 ∧
      IsCoprime (Ideal.span {α'}) q ∧
      (∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ Real.sqrt X ≤ b w - a w ∧
          ((0 ≤ a w ∧ 0 < (NumberField.mixedEmbedding K (α' : K)).1 w) ∨
           (b w ≤ 0 ∧ (NumberField.mixedEmbedding K (α' : K)).1 w < 0))) ∧
      kaiPrimePsi K q α (kaiCell K a b ρ σ θ₁ θ₂)
        = kaiPrimePsi K q α' (kaiCell K a b ρ σ θ₁ θ₂) ∧
      (@ite ℝ (ψ ≠ 0 ∧ q ≤ 𝔮D) (Classical.propDecidable _) ((ψ α : ℤ) : ℝ) 0)
        = (@ite ℝ (ψ ≠ 0 ∧ q ≤ 𝔮D) (Classical.propDecidable _) ((ψ α' : ℤ) : ℝ) 0) := by
    by_cases hα0 : α = 0
    · subst hα0
      have hqtop : q = ⊤ := by
        rw [Ideal.isCoprime_iff_sup_eq, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq] at hα
        exact hα
      have hnoreal : IsEmpty {w : NumberField.InfinitePlace K // w.IsReal} := by
        refine ⟨fun w => ?_⟩
        rcases (hab w).2.2.2.2 with h | h <;> simp at h
      subst hqtop
      refine ⟨1, one_ne_zero, ?_, fun w => hnoreal.elim w, ?_, ?_⟩
      · rw [Ideal.isCoprime_iff_sup_eq]; exact sup_top_eq _
      · unfold kaiPrimePsi
        exact (Equiv.subtypeEquivRight (fun π => by simp)).tsum_eq
          (fun π : {π : NumberField.RingOfIntegers K // Prime π ∧
              NumberField.mixedEmbedding K (π : K) ∈ kaiCell K a b ρ σ θ₁ θ₂ ∧
              π - 1 ∈ (⊤ : Ideal (NumberField.RingOfIntegers K))} =>
