theorem gi_spectral_shift (P : ℕ) [NeZero P] (A₁ A₂ L X : Finset (ZMod P)) (k : ℕ) (θ : ℝ)
    (u : ZMod P) (F : ZMod P → ℝ) (h₁ : A₁.Nonempty) (h₂ : A₂.Nonempty) (hX : X.Nonempty)
    (hθ : 0 ≤ θ)
    (hF : ∀ z, F z = ((A₂.filter (fun m => z + m ∈ L)).card : ℝ) / A₂.card)
    (hspec : ∀ ξ : ZMod P, (X.card : ℝ) ≤ 2 * ‖∑ x ∈ X, giE (((ξ * x).val : ℝ) / P)‖ →
      giCircNorm P (ξ * u) ≤ θ) :
    |(∑ v ∈ Fintype.piFinset (fun _ : Fin k => X), ∑ v' ∈ Fintype.piFinset (fun _ : Fin k => X),
          (∑ a ∈ A₁, F (a + (u + ∑ i, (v i - v' i)))) / A₁.card) / (X.card : ℝ) ^ (2 * k)
      - (∑ v ∈ Fintype.piFinset (fun _ : Fin k => X), ∑ v' ∈ Fintype.piFinset (fun _ : Fin k => X),
          (∑ a ∈ A₁, F (a + (0 + ∑ i, (v i - v' i)))) / A₁.card) / (X.card : ℝ) ^ (2 * k)|
      ≤ ((L.card : ℝ) / A₁.card) ^ ((1 : ℝ) / 2) * (2 * Real.pi * θ + 2 * (1 / 4) ^ k) :=
by
  set ψ : AddChar (ZMod P) ℂ := ZMod.stdAddChar with hψdef
  have hbr : ∀ t : ZMod P, giE ((t.val : ℝ) / P) = ψ t := by
    intro t
    rw [hψdef, ZMod.stdAddChar_apply, ZMod.toCircle_apply, giE]
    congr 1; push_cast; ring
  have hPpos : (0 : ℝ) < P := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne P)
  have hPC : (P : ℂ) ≠ 0 := by exact_mod_cast (NeZero.ne P)
  have hA1pos : (0 : ℝ) < A₁.card := by exact_mod_cast h₁.card_pos
  have hA2pos : (0 : ℝ) < A₂.card := by exact_mod_cast h₂.card_pos
  have hXpos : (0 : ℝ) < X.card := by exact_mod_cast hX.card_pos
  have hA2C : (A₂.card : ℂ) ≠ 0 := by exact_mod_cast hA2pos.ne'
  have horth : ∀ b : ZMod P, ∑ ξ : ZMod P, ψ (ξ * b) = if b = 0 then (P : ℂ) else 0 := by
    intro b
    rw [AddChar.sum_mulShift b (ZMod.isPrimitive_stdAddChar P), ZMod.card]
    split_ifs <;> simp
  have hnorm1 : ∀ t, ‖ψ t‖ = 1 := fun t => AddChar.norm_apply ψ t
  
  have hinv : ∀ (S : Finset (ZMod P)) (y : ZMod P),
      ∑ ξ : ZMod P, ψ (ξ * y) * (starRingEnd ℂ) (∑ s ∈ S, ψ (ξ * s))
        = if y ∈ S then (P : ℂ) else 0 := by
    intro S y
    have h1 : ∀ ξ : ZMod P, ψ (ξ * y) * (starRingEnd ℂ) (∑ s ∈ S, ψ (ξ * s))
