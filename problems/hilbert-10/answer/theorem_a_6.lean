      (π : NumberField.RingOfIntegers K → (Fin ν → ℤ) × (Fin ν → ℤ))
      (g : NumberField.RingOfIntegers K → ℂ) (δ : ℝ),
      (∀ x ∈ S, π x ∈ J) → (∀ x ∈ S, ‖g x‖ ≤ 1) →
      (∀ x ∈ S, ∀ y ∈ S, π x = π y → ‖g x - g y‖ ≤ δ) →
      (∀ i ∈ J, |∑ x ∈ S.filter (fun x => π x = i), f x| ≤ ε) →
      ‖∑ x ∈ S, ((f x : ℝ) : ℂ) * g x‖ ≤ (J.card : ℝ) * ε + δ * ∑ x ∈ S, |f x| := by
    intro S J π g δ hπ hg1 hgδ hε
    rw [← Finset.sum_fiberwise_of_maps_to hπ,
      ← Finset.sum_fiberwise_of_maps_to hπ (fun x => |f x|)]
    refine (norm_sum_le _ _).trans ?_
    rw [Finset.mul_sum, ← nsmul_eq_mul, ← Finset.sum_const, ← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro i hi
    rcases (S.filter (fun x => π x = i)).eq_empty_or_nonempty with h | ⟨y, hy⟩
    · have := hε i hi
