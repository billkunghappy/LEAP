  have hbox : ∀ z : Fin ν → ℤ, z ∈ intBox ν N ↔ ∀ k, -(N : ℤ) ≤ z k ∧ z k ≤ N := by
    intro z; unfold intBox; rw [Finset.mem_Icc, Pi.le_def, Pi.le_def]
    exact ⟨fun h k => ⟨h.1 k, h.2 k⟩, fun h => ⟨fun k => (h k).1, fun k => (h k).2⟩⟩
  have hmemX : ∀ z, z ∈ X ↔ z ∈ intBox ν N ∧ (fun j => ((z j : ℤ) : ℝ)) ∈ Ω := by
