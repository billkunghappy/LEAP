  obtain ⟨Bh, hBh⟩ : ∃ f : ZMod P → ℂ, f = fun ξ => ∑ m ∈ A₂, ψ (ξ * m) := ⟨_, rfl⟩
  obtain ⟨Lh, hLh⟩ : ∃ f : ZMod P → ℂ, f = fun ξ => ∑ l ∈ L, ψ (ξ * l) := ⟨_, rfl⟩
  obtain ⟨Sh, hSh⟩ : ∃ f : ZMod P → ℂ, f = fun ξ => ∑ x ∈ X, ψ (ξ * x) := ⟨_, rfl⟩
  have hinvL : ∀ y, ∑ ξ : ZMod P, ψ (ξ * y) * (starRingEnd ℂ) (Lh ξ)
      = if y ∈ L then (P : ℂ) else 0 := by
    intro y; rw [hLh]; exact hinv L y
  
  have hFrep : ∀ z, ((F z : ℝ) : ℂ) = ∑ ξ : ZMod P,
      (starRingEnd ℂ) (Lh ξ) * Bh ξ * ψ (ξ * z) / ((P : ℂ) * A₂.card) := by
    intro z
