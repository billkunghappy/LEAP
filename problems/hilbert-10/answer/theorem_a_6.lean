    (u := fun μ : ↥a => ‖kaiHZArchWeight K η l (ρ +
        NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K))‖ *
      kaiHZGaussian K (fun w => Real.exp (u₀ w - 1)) (ρ +
        NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K)))
    (fun μ => (hfcont μ).continuousOn) hMsum hbound
  exact hcontOn.continuousAt (hVopen.mem_nhds hu₀V)

theorem kai_mf_cone_gen_norm_summable {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hConv : KaiHZZetaConvProp K)
    (q b : Ideal (NumberField.RingOfIntegers K))
    (ρ₀ : NumberField.RingOfIntegers K) (hρq : ρ₀ - 1 ∈ q)
    (Gen : Set (NumberField.RingOfIntegers K))
