        ((F M * ((Ideal.absNorm M : ℂ) ^ (-s))) *
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            F (I : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) :=
      (Function.Injective.hasSum_iff hinj hoff).mp hHS
    have hbsum : Summable b := hbHS.summable
    have hbtsum : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}, b I)
        = (F M * ((Ideal.absNorm M : ℂ) ^ (-s))) *
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            F (I : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) :=
      hbHS.tsum_eq
    have hpt : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        h (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)
        = F (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) - b I := by
      intro I
      rw [hbdef]
      by_cases hd : M ∣ (I : Ideal (NumberField.RingOfIntegers K))
      · have hnt : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ M ≠ ⊤ :=
          fun hc => (hbridge _).mp hc hd
        rw [if_pos hd, hh0 _ hnt, zero_div, sub_self]
      · have ht : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ M = ⊤ := (hbridge _).mpr hd
        rw [if_neg hd, hh1 _ ht, sub_zero]
    calc (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            h (I : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
        = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            (F (I : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) - b I) :=
          tsum_congr hpt
      _ = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              F (I : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
            - (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}, b I) :=
          Summable.tsum_sub hsum' hbsum
      _ = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              F (I : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
            * (1 - F M * ((Ideal.absNorm M : ℂ) ^ (-s))) := by
          rw [hbtsum]; ring
  have key : ∀ n : ℕ, ∀ (F Gg : Ideal (NumberField.RingOfIntegers K) → ℂ)
      (m' : Ideal (NumberField.RingOfIntegers K)),
      (∀ I J : Ideal (NumberField.RingOfIntegers K), F (I * J) = F I * F J) →
      (∀ I : Ideal (NumberField.RingOfIntegers K), ‖F I‖ ≤ 1) →
      (∀ s : ℂ, 1 < s.re →
        Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          F (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) →
      m' ≠ 0 →
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ m' = ⊤ → Gg I = F I) →
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ m' ≠ ⊤ → Gg I = 0) →
      Ideal.absNorm m' = n →
      ∃ Pi : ℂ → ℂ, Differentiable ℂ Pi ∧ (∀ s : ℂ, 0 < s.re → Pi s ≠ 0) ∧
        (∀ s : ℂ, 1 < s.re →
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              Gg (I : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
            = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                F (I : Ideal (NumberField.RingOfIntegers K)) /
                  ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
              * Pi s) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
      intro F Gg m' hFmul hFnorm hFsum hm' hGg1 hGg0 hn
      by_cases hmt : m' = ⊤
      · refine ⟨fun _ => 1, differentiable_const 1, fun s _ => one_ne_zero, ?_⟩
        intro s hs
        rw [mul_one]
        refine tsum_congr (fun I => ?_)
        rw [hGg1 _ (by rw [hmt]; exact sup_top_eq _)]
      · obtain ⟨M, m₀, hM, hM0, hm₀0, hm₀, h2M, hlt⟩ := hfac m' hm' hmt
        obtain ⟨F₁, hF₁1, hF₁0⟩ :
            ∃ F₁ : Ideal (NumberField.RingOfIntegers K) → ℂ,
              (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ M = ⊤ → F₁ I = F I) ∧
              (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ M ≠ ⊤ → F₁ I = 0) :=
          ⟨fun I => if I ⊔ M = ⊤ then F I else 0, fun _ hI => if_pos hI, fun _ hI => if_neg hI⟩
        obtain ⟨hF₁mul, hF₁le⟩ := htrim F F₁ hFmul M hF₁1 hF₁0
        have hF₁norm : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖F₁ I‖ ≤ 1 :=
          fun I => le_trans (hF₁le I) (hFnorm I)
        have hF₁sum : ∀ s : ℂ, 1 < s.re →
            Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
              F₁ (I : Ideal (NumberField.RingOfIntegers K)) /
                ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) := by
          intro s hs
          refine Summable.of_norm_bounded (summable_norm_iff.mpr (hFsum s hs)) ?_
          intro I
          rw [div_eq_mul_inv, div_eq_mul_inv, norm_mul, norm_mul]
          exact mul_le_mul_of_nonneg_right (hF₁le _) (norm_nonneg _)
        have hsplit : ∀ I : Ideal (NumberField.RingOfIntegers K),
            I ⊔ m' = ⊤ ↔ (I ⊔ M = ⊤ ∧ I ⊔ m₀ = ⊤) := by
          intro I
          constructor
          · intro hI
            have hMle : m' ≤ M := by rw [hm₀, mul_comm]; exact Ideal.mul_le_left
            have hm0le : m' ≤ m₀ := by rw [hm₀]; exact Ideal.mul_le_left
            constructor
            · have hx : I ⊔ m' ≤ I ⊔ M := sup_le_sup_left hMle I
              rw [hI] at hx
              exact top_le_iff.mp hx
            · have hx : I ⊔ m' ≤ I ⊔ m₀ := sup_le_sup_left hm0le I
              rw [hI] at hx
              exact top_le_iff.mp hx
          · rintro ⟨h1, h2⟩
            rw [hm₀, ← Ideal.isCoprime_iff_sup_eq]
            exact IsCoprime.mul_right (Ideal.isCoprime_iff_sup_eq.mpr h1)
              (Ideal.isCoprime_iff_sup_eq.mpr h2)
        have hGg1' : ∀ I : Ideal (NumberField.RingOfIntegers K),
            I ⊔ m₀ = ⊤ → Gg I = F₁ I := by
          intro I hI
          by_cases hIM : I ⊔ M = ⊤
          · rw [hGg1 I ((hsplit I).mpr ⟨hIM, hI⟩), hF₁1 I hIM]
          · rw [hF₁0 I hIM, hGg0 I (fun hc => hIM ((hsplit I).mp hc).1)]
        have hGg0' : ∀ I : Ideal (NumberField.RingOfIntegers K),
            I ⊔ m₀ ≠ ⊤ → Gg I = 0 :=
          fun I hI => hGg0 I (fun hc => hI ((hsplit I).mp hc).2)
        obtain ⟨Pi₀, hPi₀d, hPi₀ne, hPi₀eq⟩ :=
          IH (Ideal.absNorm m₀) (by omega) F₁ Gg m₀ hF₁mul hF₁norm hF₁sum hm₀0 hGg1' hGg0' rfl
        obtain ⟨hud, hune⟩ := heuler (F M) (hFnorm M) (Ideal.absNorm M) h2M
        refine ⟨fun s => (1 - F M * ((Ideal.absNorm M : ℂ) ^ (-s))) * Pi₀ s, hud.mul hPi₀d,
          fun s hs => mul_ne_zero (hune s hs) (hPi₀ne s hs), ?_⟩
        intro s hs
        rw [hPi₀eq s hs, hcrux F F₁ hFmul M hM hM0 hF₁1 hF₁0 s (hFsum s hs)]
        ring
  
  obtain ⟨hlam1, hlammul, hlamu, hlamz, hlam0, -⟩ := id hext
  obtain ⟨hlam'1, hlam'mul, hlam'u, hlam'z, hlam'0, -⟩ := id hext'
  have hlamle : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1 := by
    intro I
    by_cases hI : I ⊔ q = ⊤
    · by_cases h0 : I = 0
      · rw [h0, hlam0, norm_zero]
        norm_num
      · exact le_of_eq (hlamu I h0 hI)
    · rw [hlamz I hI, norm_zero]
      norm_num
  have hlam'le : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam' I‖ ≤ 1 := by
    intro I
    by_cases hI : I ⊔ q' = ⊤
    · by_cases h0 : I = 0
      · rw [h0, hlam'0, norm_zero]
        norm_num
      · exact le_of_eq (hlam'u I h0 hI)
    · rw [hlam'z I hI, norm_zero]
      norm_num
  
  obtain ⟨Lam, hL1, hL0⟩ :
      ∃ Lam : Ideal (NumberField.RingOfIntegers K) → ℂ,
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q' = ⊤ → Lam I = lam I) ∧
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q' ≠ ⊤ → Lam I = 0) :=
    ⟨fun I => if I ⊔ q' = ⊤ then lam I else 0, fun _ h => if_pos h, fun _ h => if_neg h⟩
  obtain ⟨Lam', hL'1, hL'0⟩ :
      ∃ Lam' : Ideal (NumberField.RingOfIntegers K) → ℂ,
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q = ⊤ → Lam' I = lam' I) ∧
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ q ≠ ⊤ → Lam' I = 0) :=
    ⟨fun I => if I ⊔ q = ⊤ then lam' I else 0, fun _ h => if_pos h, fun _ h => if_neg h⟩
  have hconj : ∀ I : Ideal (NumberField.RingOfIntegers K),
      Lam' I = (starRingEnd ℂ) (Lam I) := by
    intro I
    by_cases h : I ⊔ q = ⊤
    · by_cases h' : I ⊔ q' = ⊤
      · by_cases h0 : I = 0
        · rw [hL'1 I h, hL1 I h', h0, hlam'0, hlam0, map_zero]
        · have hcop : I ⊔ (q * q') = ⊤ := by
            rw [← Ideal.isCoprime_iff_sup_eq]
            exact IsCoprime.mul_right (Ideal.isCoprime_iff_sup_eq.mpr h)
              (Ideal.isCoprime_iff_sup_eq.mpr h')
          have hmul : lam I * lam' I = 1 := hprin I h0 hcop
          have hnorm : ‖lam I‖ = 1 := hlamu I h0 h
          have hne : lam I ≠ 0 := by
            intro hc
            rw [hc, norm_zero] at hnorm
            exact zero_ne_one hnorm
          have hinv : lam' I = (lam I)⁻¹ := by
            rw [inv_eq_one_div, eq_div_iff hne, mul_comm]
            exact hmul
          rw [hL'1 I h, hL1 I h', hinv, Complex.inv_eq_conj hnorm]
      · rw [hL0 I h', hL'1 I h, hlam'z I h', map_zero]
    · rw [hL'0 I h]
      by_cases h' : I ⊔ q' = ⊤
      · rw [hL1 I h', hlamz I h, map_zero]
      · rw [hL0 I h', map_zero]
  
  obtain ⟨Pi', hPi'diff, -, hPi'eq⟩ :=
    key (Ideal.absNorm q') lam Lam q' hlammul hlamle (hsumC lam hlamle) hq' hL1 hL0 rfl
  obtain ⟨Pi, hPidiff, hPine, hPieq⟩ :=
    key (Ideal.absNorm q) lam' Lam' q hlam'mul hlam'le (hsumC lam' hlam'le) hq hL'1 hL'0 rfl
  have hTf : ∀ s : ℂ, 1 < s.re →
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          Lam (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
        = G s * Pi' s := by
    intro s hs
    have h1 : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        lam (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) = G s :=
      heq s hs
    rw [hPi'eq s hs, h1]
  have hT : ∀ s : ℂ, 1 < s.re →
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          Lam' (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
        = G' s * Pi s := by
    intro s hs
    have h1 : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        lam' (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) = G' s :=
      heq' s hs
    rw [hPieq s hs, h1]
  
  have hcast : ∀ (n : ℕ) (s : ℂ),
      (starRingEnd ℂ) (((n : ℕ) : ℂ) ^ ((starRingEnd ℂ) s)) = ((n : ℕ) : ℂ) ^ s := by
    intro n s
    have harg : ((n : ℕ) : ℂ).arg ≠ Real.pi := by
      rw [← Complex.ofReal_natCast, Complex.arg_ofReal_of_nonneg (Nat.cast_nonneg n)]
      exact ne_of_lt Real.pi_pos
    have h := Complex.cpow_conj ((n : ℕ) : ℂ) s harg
    rw [Complex.conj_natCast] at h
    rw [h, Complex.conj_conj]
  have hrel : ∀ s : ℂ, 1 < s.re →
      G' s * Pi s
        = (starRingEnd ℂ) (G ((starRingEnd ℂ) s) * Pi' ((starRingEnd ℂ) s)) := by
    intro s hs
    have hs' : 1 < ((starRingEnd ℂ) s).re := by
      rw [Complex.conj_re]
      exact hs
    rw [← hT s hs, ← hTf ((starRingEnd ℂ) s) hs', Complex.conj_tsum]
    refine tsum_congr ?_
    intro I
    rw [map_div₀, hcast, hconj]
  
  have hpair : ∀ F H : ℂ → ℂ, Differentiable ℂ F → Differentiable ℂ H →
      (∀ s : ℂ, 1 < s.re → F s = (starRingEnd ℂ) (H ((starRingEnd ℂ) s))) →
      ∀ s : ℂ, F s = (starRingEnd ℂ) (H ((starRingEnd ℂ) s)) := by
    intro F H hF hH hr s
    have hJ : Differentiable ℂ (⇑(starRingEnd ℂ) ∘ H ∘ ⇑(starRingEnd ℂ)) := by
      intro z
      have h1 := DifferentiableAt.conj_conj (hH ((starRingEnd ℂ) z))
      rwa [Complex.conj_conj] at h1
    have heqon : Set.EqOn F (⇑(starRingEnd ℂ) ∘ H ∘ ⇑(starRingEnd ℂ)) {w : ℂ | 1 < w.re} := by
      intro w hw
      have hw' : 1 < w.re := hw
      exact hr w hw'
    have hU : IsOpen {w : ℂ | 1 < w.re} := isOpen_lt continuous_const Complex.continuous_re
    have h2mem : (2 : ℂ) ∈ {w : ℂ | 1 < w.re} := by
      show (1 : ℝ) < (2 : ℂ).re
      norm_num
    have heqf : F =ᶠ[nhds (2 : ℂ)] (⇑(starRingEnd ℂ) ∘ H ∘ ⇑(starRingEnd ℂ)) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds h2mem) heqon
    have haf : AnalyticOnNhd ℂ F Set.univ := hF.differentiableOn.analyticOnNhd isOpen_univ
    have hag : AnalyticOnNhd ℂ (⇑(starRingEnd ℂ) ∘ H ∘ ⇑(starRingEnd ℂ)) Set.univ :=
      hJ.differentiableOn.analyticOnNhd isOpen_univ
    exact haf.eqOn_of_preconnected_of_eventuallyEq hag isPreconnected_univ
      (Set.mem_univ (2 : ℂ)) heqf (Set.mem_univ s)
  
  have hbeta : G' ((β : ℝ) : ℂ) * Pi ((β : ℝ) : ℂ)
      = (starRingEnd ℂ) (G ((starRingEnd ℂ) ((β : ℝ) : ℂ))
          * Pi' ((starRingEnd ℂ) ((β : ℝ) : ℂ))) :=
    hpair (fun s => G' s * Pi s) (fun s => G s * Pi' s)
      (hG'.mul hPidiff) (hG.mul hPi'diff) hrel ((β : ℝ) : ℂ)
  rw [Complex.conj_ofReal, hz, zero_mul, map_zero] at hbeta
  have hPib : Pi ((β : ℝ) : ℂ) ≠ 0 := by
    refine hPine ((β : ℝ) : ℂ) ?_
    rw [Complex.ofReal_re]
    exact hβ0
  exact (mul_eq_zero.mp hbeta).resolve_right hPib

theorem kai_hecke_siegel_00 (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ ε : ℝ, 0 < ε → ∃ Bε : ℝ, 0 < Bε ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam →
        ¬ KaiHeckePrincipal K q lam →
        (∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
        ∀ G : ℂ → ℂ, Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s) →
          ∀ β : ℝ, 1 - Bε * ((Ideal.absNorm q : ℝ) ^ (-ε)) < β → β < 1 → G (β : ℂ) ≠ 0 :=
by
  classical
  have hlogbd : ∀ u : ℝ, 0 < u → u ≤ 1 → ∀ x : ℝ, 1 ≤ x →
      u * Real.log (3 + x) ≤ 4 * x ^ u := by
    intro u hu hu1 x hx
    have hx0 : (0:ℝ) ≤ x := by linarith
    have h1 : Real.log (3 + x) ≤ (3 + x) ^ u / u :=
      Real.log_le_rpow_div (by linarith) hu
    have h2 : (3 + x) ^ u ≤ (4 * x) ^ u :=
      Real.rpow_le_rpow (by linarith) (by linarith) hu.le
    have h3 : (4 * x) ^ u = (4:ℝ) ^ u * x ^ u := Real.mul_rpow (by norm_num) hx0
    have h4 : (4:ℝ) ^ u ≤ 4 := by
      have h := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ) ≤ 4) hu1
      simpa using h
    have hxu : (0:ℝ) ≤ x ^ u := Real.rpow_nonneg hx0 u
    rw [h3] at h2
    have h5 : (3 + x) ^ u ≤ 4 * x ^ u := by nlinarith
    have h6 : u * Real.log (3 + x) ≤ u * ((3 + x) ^ u / u) :=
      mul_le_mul_of_nonneg_left h1 hu.le
    have h7 : u * ((3 + x) ^ u / u) = (3 + x) ^ u := by
      field_simp
    rw [h7] at h6
    linarith
  have hlog1 : ∀ x : ℝ, 1 ≤ x → (1:ℝ) ≤ Real.log (3 + x) := by
    intro x hx
    have h4 : Real.exp 1 ≤ 3 + x := by
      have h := Real.exp_one_lt_d9
      linarith
    calc (1:ℝ) = Real.log (Real.exp 1) := (Real.log_exp 1).symm
      _ ≤ Real.log (3 + x) := Real.log_le_log (Real.exp_pos 1) h4
  have hnorm1 : ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      (1:ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    intro q hq
    have hb : q ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hne : Ideal.absNorm q ≠ 0 := fun h => hb (Ideal.absNorm_eq_zero_iff.mp h)
    have h1 : 1 ≤ Ideal.absNorm q := Nat.one_le_iff_ne_zero.mpr hne
    exact_mod_cast h1
  obtain ⟨cL, aL, hcL, haL, hLandau⟩ := kai_hecke_landau_product K
  obtain ⟨C3, D3, hC3, hD3, hnear⟩ := kai_hecke_near_one_bounds K
  intro ε hε
  obtain ⟨e, hedef⟩ : ∃ e : ℝ, e = min ε (1/8) := ⟨_, rfl⟩
  have he0 : 0 < e := by rw [hedef]; exact lt_min hε (by norm_num)
  have he1 : e ≤ 1/8 := by rw [hedef]; exact min_le_right _ _
  have hee : e ≤ ε := by rw [hedef]; exact min_le_left _ _
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℝ, δ = e / (2 * (aL + 1)) := ⟨_, rfl⟩
  have hδ0 : 0 < δ := by rw [hδdef]; exact div_pos he0 (by linarith)
  have hδe : δ ≤ e / 2 := by
    rw [hδdef, div_le_iff₀ (by linarith : (0:ℝ) < 2 * (aL + 1))]
    nlinarith
  have hkey : aL * δ ≤ e / 2 := by
    rw [hδdef, ← mul_div_assoc, div_le_iff₀ (by linarith : (0:ℝ) < 2 * (aL + 1))]
    nlinarith
  by_cases hP : ∃ (q₁ : Ideal (NumberField.RingOfIntegers K))
      (ξ₁ : ((NumberField.RingOfIntegers K ⧸ q₁)ˣ) →* Circle)
      (η₁ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (lam₁ : Ideal (NumberField.RingOfIntegers K) → ℂ) (G₁ : ℂ → ℂ) (β₁ : ℝ),
      q₁ ≠ 0 ∧ KaiHeckeExt K q₁ 0 0 ξ₁ η₁ lam₁ ∧
