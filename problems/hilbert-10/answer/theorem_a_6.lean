            ∈ Set.Ioc (u j) (u j + 1 / (l : ℝ))} := ⟨fun x => by
      obtain ⟨π, hPc⟩ := x
      obtain ⟨h1, h2⟩ := hA1 π hPc
      have hTN : T < ((Algebra.norm ℤ π).natAbs : ℝ) := hPc.1.2.2.2
      have hN0 : (0 : ℝ) < ((Algebra.norm ℤ π).natAbs : ℝ) := by linarith only [hT, hTN]
      have hexpΔ := Real.exp_pos Δ
      have he1 : Real.exp (-Δ) * Real.exp Δ = 1 := by
        rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
      have h1' : kaiTBEminus K H a b ρ σ u
          ≤ ((Algebra.norm ℤ π).natAbs : ℝ) * Real.exp Δ := by
        have hm := mul_le_mul_of_nonneg_right h1 hexpΔ.le
        calc kaiTBEminus K H a b ρ σ u
            = kaiTBEminus K H a b ρ σ u * Real.exp (-Δ) * Real.exp Δ := by
              rw [mul_assoc, he1, mul_one]
          _ ≤ ((Algebra.norm ℤ π).natAbs : ℝ) * Real.exp Δ := hm
      have h2' : ((Algebra.norm ℤ π).natAbs : ℝ) * Real.exp Δ
          ≤ kaiTBEplus K H a b ρ σ u * Real.exp (2 * Δ) := by
        have hm := mul_le_mul_of_nonneg_right h2 hexpΔ.le
        calc ((Algebra.norm ℤ π).natAbs : ℝ) * Real.exp Δ
            ≤ kaiTBEplus K H a b ρ σ u * Real.exp Δ * Real.exp Δ := hm
          _ = kaiTBEplus K H a b ρ σ u * Real.exp (2 * Δ) := by
              rw [mul_assoc, ← Real.exp_add, two_mul]
      have hEp0 : 0 < kaiTBEplus K H a b ρ σ u := by
        by_contra hc
        push_neg at hc
        nlinarith [hexpΔ, hc, h2, hN0]
      have h23 : Real.exp (2 * Δ) ≤ Real.exp (3 * Δ) := Real.exp_le_exp.mpr (by linarith)
      have h3 := mul_le_mul_of_nonneg_left h23 hEp0.le
      linarith [h1', h2', h3, hin]⟩
    exact tsum_empty

theorem kai_lp_cube_cutoff_bounds (Xn Ep Em T Δ ε β x0p x1p x0m x1m : ℝ)
    (hEp0 : 0 ≤ Ep) (hEpX : Ep ≤ Xn) (hEm0 : 0 ≤ Em) (hT1 : 1 ≤ T) (hTX : T ≤ Xn)
    (hΔ0 : 0 ≤ Δ) (hΔ3 : Δ ≤ 1 / 3) (hε : |ε| ≤ 1) (hεβ : ε = 0 ∨ (1 / 2 ≤ β ∧ β < 1))
    (hx0p : x0p = max (Em * Real.exp (-(2 * Δ))) T)
    (hx1p : x1p = max (Ep * Real.exp Δ) x0p)
    (hx0m : x0m = max (Em * Real.exp Δ) T)
    (hx1m : x1m = max (Ep * Real.exp (-(2 * Δ))) x0m) :
    (T ≤ x0p ∧ x0p ≤ x1p ∧ T ≤ x0m ∧ x0m ≤ x1m) ∧
    (0 ≤ max ((max Ep T - ε * (max Ep T ^ β / β)) - (max Em T - ε * (max Em T ^ β / β))) 0 ∧
      max ((max Ep T - ε * (max Ep T ^ β / β)) - (max Em T - ε * (max Em T ^ β / β))) 0
        ≤ 2 * Xn) ∧
    (Ep * Real.exp (3 * Δ) < Em →
      max ((max Ep T - ε * (max Ep T ^ β / β)) - (max Em T - ε * (max Em T ^ β / β))) 0 = 0) ∧
    (Em ≤ Ep * Real.exp (3 * Δ) →
      x1p ≤ 5 * Xn ∧ x1m ≤ 5 * Xn ∧
      0 ≤ (x1p - ε * (x1p ^ β / β)) - (x0p - ε * (x0p ^ β / β)) ∧
      (x1p - ε * (x1p ^ β / β)) - (x0p - ε * (x0p ^ β / β)) ≤ 4 * Xn ∧
      |(x1p - ε * (x1p ^ β / β)) - (x0p - ε * (x0p ^ β / β))
        - max ((max Ep T - ε * (max Ep T ^ β / β)) - (max Em T - ε * (max Em T ^ β / β))) 0|
        ≤ 16 * Δ * Xn ∧
      0 ≤ (x1m - ε * (x1m ^ β / β)) - (x0m - ε * (x0m ^ β / β)) ∧
      (x1m - ε * (x1m ^ β / β)) - (x0m - ε * (x0m ^ β / β)) ≤ 4 * Xn ∧
      |(x1m - ε * (x1m ^ β / β)) - (x0m - ε * (x0m ^ β / β))
        - max ((max Ep T - ε * (max Ep T ^ β / β)) - (max Em T - ε * (max Em T ^ β / β))) 0|
        ≤ 16 * Δ * Xn) :=
by
  
  have hF : ∀ a b : ℝ, 1 ≤ a → a ≤ b →
      0 ≤ (b - ε * (b ^ β / β)) - (a - ε * (a ^ β / β)) ∧
      (b - ε * (b ^ β / β)) - (a - ε * (a ^ β / β)) ≤ 2 * (b - a) := by
    intro a b ha hab
    rcases hεβ with h0 | ⟨hβ1, hβ2⟩
    · subst h0
      simp only [zero_mul, sub_zero]
      constructor <;> linarith
    · have hβpos : 0 < β := by linarith
      have ha0 : 0 < a := by linarith
      have hb0 : 0 < b := by linarith
      have hs0 : a ^ β ≤ b ^ β := Real.rpow_le_rpow ha0.le hab hβpos.le
      have hr0 : 0 < a ^ β := Real.rpow_pos_of_pos ha0 β
      have hra : a ^ β ≤ a := by
        have := Real.rpow_le_rpow_of_exponent_le ha hβ2.le
        rwa [Real.rpow_one] at this
      have hba1 : 0 ≤ b / a - 1 := by
        rw [sub_nonneg, le_div_iff₀ ha0]; linarith
      have hbern : (1 + (b / a - 1)) ^ β ≤ 1 + β * (b / a - 1) :=
        rpow_one_add_le_one_add_mul_self (by linarith) hβpos.le hβ2.le
      have h1 : (1 + (b / a - 1)) = b / a := by ring
      rw [h1, Real.div_rpow hb0.le ha0.le, div_le_iff₀ hr0] at hbern
      have h2 : (1 + β * (b / a - 1)) * a ^ β = a ^ β + β * (a ^ β / a) * (b - a) := by
        field_simp
      have h3 : a ^ β / a ≤ 1 := by rw [div_le_one ha0]; exact hra
      have h4 : β * (a ^ β / a) * (b - a) ≤ β * (b - a) := by
        have hba : 0 ≤ b - a := by linarith
        have h5 : β * (a ^ β / a) ≤ β * 1 := mul_le_mul_of_nonneg_left h3 hβpos.le
        have := mul_le_mul_of_nonneg_right h5 hba
        linarith
      have hsle : b ^ β - a ^ β ≤ β * (b - a) := by linarith
      have hs_nonneg : 0 ≤ b ^ β / β - a ^ β / β := by
        rw [← sub_div]; exact div_nonneg (by linarith) hβpos.le
      have hs_le : b ^ β / β - a ^ β / β ≤ b - a := by
        rw [← sub_div, div_le_iff₀ hβpos]; linarith
      obtain ⟨hε1, hε2⟩ := abs_le.mp hε
      have e : (b - ε * (b ^ β / β)) - (a - ε * (a ^ β / β))
          = (b - a) - ε * (b ^ β / β - a ^ β / β) := by ring
      rw [e]
      have k1 := mul_nonneg (sub_nonneg.2 hε2) hs_nonneg
      have k2 := mul_nonneg (by linarith : (0 : ℝ) ≤ 1 + ε) hs_nonneg
      constructor <;> nlinarith
  
  have hexpΔ := Real.exp_pos Δ
  have hu1 : 1 ≤ Real.exp Δ := Real.one_le_exp hΔ0
  have hkey : (1 - Δ) * Real.exp Δ ≤ 1 := by
    have h := Real.add_one_le_exp (-Δ)
    have hid : Real.exp (-Δ) * Real.exp Δ = 1 := by
      rw [← Real.exp_add]; simp
    have := mul_le_mul_of_nonneg_right h hexpΔ.le
    linarith
  have hu32 : Real.exp Δ ≤ 3 / 2 := by
    have := mul_le_mul_of_nonneg_right hΔ3 hexpΔ.le
    nlinarith
  have hu' : Real.exp Δ - 1 ≤ 3 / 2 * Δ := by
    have := mul_le_mul_of_nonneg_left hu32 hΔ0
    nlinarith
  have hv0 : 0 < Real.exp (-(2 * Δ)) := Real.exp_pos _
  have hv1 : Real.exp (-(2 * Δ)) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
  have hv' : 1 - Real.exp (-(2 * Δ)) ≤ 2 * Δ := by
    have := Real.add_one_le_exp (-(2 * Δ)); linarith
  have hw1 : 1 ≤ Real.exp (3 * Δ) := Real.one_le_exp (by linarith)
  have hw3 : Real.exp (3 * Δ) ≤ 3 := by
    have h1 : Real.exp (3 * Δ) ≤ Real.exp 1 := Real.exp_le_exp.mpr (by linarith)
    have h9 := Real.exp_one_lt_d9
    norm_num at h9
    linarith
  have hwv : Real.exp (3 * Δ) * Real.exp (-(2 * Δ)) = Real.exp Δ := by
    rw [← Real.exp_add]; congr 1; ring
  
  have main : ∀ (F : ℝ → ℝ) (u v w : ℝ),
      (∀ a b : ℝ, 1 ≤ a → a ≤ b → 0 ≤ F b - F a ∧ F b - F a ≤ 2 * (b - a)) →
      1 ≤ u → u ≤ 3 / 2 → u - 1 ≤ 3 / 2 * Δ → 0 < v → v ≤ 1 → 1 - v ≤ 2 * Δ →
      1 ≤ w → w ≤ 3 → w * v = u →
      (T ≤ max (Em * v) T ∧ max (Em * v) T ≤ max (Ep * u) (max (Em * v) T) ∧
        T ≤ max (Em * u) T ∧ max (Em * u) T ≤ max (Ep * v) (max (Em * u) T)) ∧
      (0 ≤ max (F (max Ep T) - F (max Em T)) 0 ∧
        max (F (max Ep T) - F (max Em T)) 0 ≤ 2 * Xn) ∧
      (Ep * w < Em → max (F (max Ep T) - F (max Em T)) 0 = 0) ∧
      (Em ≤ Ep * w →
        max (Ep * u) (max (Em * v) T) ≤ 5 * Xn ∧ max (Ep * v) (max (Em * u) T) ≤ 5 * Xn ∧
        0 ≤ F (max (Ep * u) (max (Em * v) T)) - F (max (Em * v) T) ∧
        F (max (Ep * u) (max (Em * v) T)) - F (max (Em * v) T) ≤ 4 * Xn ∧
        |F (max (Ep * u) (max (Em * v) T)) - F (max (Em * v) T)
          - max (F (max Ep T) - F (max Em T)) 0| ≤ 16 * Δ * Xn ∧
        0 ≤ F (max (Ep * v) (max (Em * u) T)) - F (max (Em * u) T) ∧
        F (max (Ep * v) (max (Em * u) T)) - F (max (Em * u) T) ≤ 4 * Xn ∧
        |F (max (Ep * v) (max (Em * u) T)) - F (max (Em * u) T)
          - max (F (max Ep T) - F (max Em T)) 0| ≤ 16 * Δ * Xn) := by
    intro F u v w hF' hu1 hu32 hu' hv0 hv1 hv' hw1 hw3 hwv
    have hXn0 : 0 ≤ Xn := by linarith
    have hΔX : 0 ≤ Δ * Xn := mul_nonneg hΔ0 hXn0
    have hEpu : Ep * u - Ep ≤ 3 / 2 * Δ * Xn := by
      have h1 := mul_le_mul_of_nonneg_right hu' hEp0
      have h2 := mul_le_mul_of_nonneg_left hEpX hΔ0
      nlinarith
    have hEpv : Ep - Ep * v ≤ 2 * Δ * Xn := by
      have h1 := mul_le_mul_of_nonneg_right hv' hEp0
      have h2 := mul_le_mul_of_nonneg_left hEpX hΔ0
      nlinarith
    have hEpuge : Ep ≤ Ep * u := le_mul_of_one_le_right hEp0 hu1
    have hEpvle : Ep * v ≤ Ep := mul_le_of_le_one_right hEp0 hv1
    have hEmvle : Em * v ≤ Em := mul_le_of_le_one_right hEm0 hv1
    have hEmuge : Em ≤ Em * u := le_mul_of_one_le_right hEm0 hu1
    have hTa : T ≤ max Em T := le_max_right _ _
    have hEma : Em ≤ max Em T := le_max_left _ _
    have hTa' : T ≤ max (Em * v) T := le_max_right _ _
    have hEma' : Em * v ≤ max (Em * v) T := le_max_left _ _
    have hTa'' : T ≤ max (Em * u) T := le_max_right _ _
    have hEma'' : Em * u ≤ max (Em * u) T := le_max_left _ _
    have hTP : T ≤ max Ep T := le_max_right _ _
    have hPX : max Ep T ≤ Xn := max_le hEpX hTX
    have ha'a : max (Em * v) T ≤ max Em T := max_le_max hEmvle le_rfl
    have haa'' : max Em T ≤ max (Em * u) T := max_le_max hEmuge le_rfl
    refine ⟨⟨le_max_right _ _, le_max_right _ _, le_max_right _ _, le_max_right _ _⟩,
      ⟨le_max_right _ _, ?_⟩, ?_, ?_⟩
    · 
      refine max_le ?_ (by linarith)
      rcases le_total (max Ep T) (max Em T) with h | h
      · have := (hF' _ _ (by linarith) h).1
        linarith
      · have := (hF' _ _ (by linarith) h).2
        linarith
    · 
      intro hlt
      have hEpw : Ep ≤ Ep * w := le_mul_of_one_le_right hEp0 hw1
      have hPa : max Ep T ≤ max Em T := max_le_max (by linarith) le_rfl
