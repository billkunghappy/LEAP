  have hW1 : 1 ≤ primorial w := primorial_pos w
  have hs2' := hs2 (primorial w) hW1 c₀ c N Ω (by exact_mod_cast hN1) hΩm hΩc hΩbox
  rw [← hV_def] at hs2'
  have hq0 : 0 ≤ (primorial w : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial w) : ℝ) := by
