    obtain ⟨hdz, ht⟩ : (∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) ∧ t = 0 :=
      not_not.mp (fun hnp => hne (hee0 hnp))
    have hee : ee = 1 := hee1 ⟨hdz, ht⟩
    have h11 : (1 : ℂ) - 1 = 0 := sub_self 1
    have hzd0 : kaiMFConeZdual K t l η 0 = 0 := by
      funext w
      simp only [kaiMFConeZdual, hdz w, ht, Pi.zero_apply, mul_zero, zero_div,
        Complex.ofReal_zero, add_zero]
    have hRr1 : Rr 1 = 1 := by
      rw [hRr 1, h11, hzd0]
      simp only [Pi.zero_apply, zero_mul, Finset.sum_const_zero, neg_zero,
        Complex.exp_zero]
    have hZ1 : ∀ w : NumberField.InfinitePlace K,
        kaiMFConeZcan K t l η 1 w = ((kaiMFConeAlpha K w : ℝ) : ℂ) := by
      intro w
      simp only [kaiMFConeZcan, hdz w, ht, Pi.zero_apply, mul_one, mul_zero,
        zero_div, Complex.ofReal_zero, add_zero, sub_zero]
    have hD : (∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) = 0 :=
      Finset.sum_eq_zero (fun w _ => hdz w)
    have hpi0 : ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
        kaiHZDeg K η l w) / 2) : ℝ) : ℂ) = 1 := by
      rw [hD]
      simp only [neg_zero, zero_div, Real.rpow_zero, Complex.ofReal_one]
    have hreal : Real.exp ((Module.finrank ℚ K : ℝ) / 2 * Real.log Real.pi)
        = Real.pi ^ ((Module.finrank ℚ K : ℝ) / 2) := by
      rw [Real.rpow_def_of_pos Real.pi_pos,
        mul_comm (Real.log Real.pi) ((Module.finrank ℚ K : ℝ) / 2)]
    have hexp : Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 * Real.log Real.pi : ℝ) : ℂ) * 1)
        = ((Real.pi ^ ((Module.finrank ℚ K : ℝ) / 2) : ℝ) : ℂ) := by
      rw [mul_one, ← Complex.ofReal_exp, hreal]
    have hprod1 : (∏ w : NumberField.InfinitePlace K,
          (Complex.Gamma (kaiMFConeZcan K t l η 1 w))⁻¹)
        = ∏ w : NumberField.InfinitePlace K,
            (Complex.Gamma ((kaiMFConeAlpha K w : ℝ) : ℂ))⁻¹ :=
      Finset.prod_congr rfl (fun w _ => by rw [hZ1 w])
    have hprod : (∏ w : NumberField.InfinitePlace K,
          (Complex.Gamma (kaiMFConeZcan K t l η 1 w))⁻¹)
        = (∏ w : NumberField.InfinitePlace K,
            Complex.Gamma ((kaiMFConeAlpha K w : ℝ) : ℂ))⁻¹ := by
      rw [hprod1, Finset.prod_inv_distrib]
    have hPf1 : Pf 1 = (wq : ℂ)⁻¹ *
        ((Real.pi ^ ((Module.finrank ℚ K : ℝ) / 2) : ℝ) : ℂ) *
        (∏ w : NumberField.InfinitePlace K,
          Complex.Gamma ((kaiMFConeAlpha K w : ℝ) : ℂ))⁻¹ := by
      rw [hPf 1, hpi0, hexp, hprod, mul_one]
    rw [hGc 1, h11, hRr1, hzd0, hPf1, hee]
    simp only [zero_mul, mul_zero, zero_div, Complex.exp_zero, one_mul, mul_one,
      zero_add, sub_zero]
    have hdiv : ∀ a b c : ℂ, a / (b * c) = a * (b⁻¹ * c⁻¹) := by
      intro a b c
      rw [div_eq_mul_inv, mul_inv]
    rw [hdiv]
    ring

theorem kai_mf_cone_theta_fe_unit (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hP : KaiHZPoissonProp) (hF : KaiHZTestFourierProp) (hConv : KaiHZZetaConvProp K)
    (hGam : KaiMFConeGammaProp) (hFund : KaiMFConeFundDomProp K)
    (hTail : KaiMFConeTailProp K) (hSharp : KaiMFIdealThetaSharpProp K) :
    KaiMFConeFEUnitProp K :=
by
  classical
  have hSharp₀ := hSharp
  obtain ⟨B, hB1, hSh⟩ := hSharp₀
  obtain ⟨cK, hcK0, hkap⟩ := kai_mf_cone_kappa_value (K := K) hP hF
  have hGid := kai_mf_cone_gamma_identities
  have hWmul : ∀ (g g' : NumberField.InfinitePlace K → ℂ)
      (u : NumberField.InfinitePlace K → ℝ),
      kaiMFConeWeight K g u * kaiMFConeWeight K g' u
        = kaiMFConeWeight K (fun w => g w + g' w) u := by
    intro g g' u
    simp only [kaiMFConeWeight, ← Complex.exp_add, ← Finset.sum_add_distrib]
    congr 1
    exact Finset.sum_congr rfl (fun w _ => by ring)
  refine ⟨max 1 ((3 / 2) * 2 ^ (NumberField.InfinitePlace.nrRealPlaces K) *
      B ^ (3 * (Module.finrank ℚ K : ℝ) / 4 + 5 / 2)
      + (Module.finrank ℚ K : ℝ) + (3 / 2) * B + 3), le_max_left _ _, ?_⟩
  intro q hq t l ξ η htr hχu
  obtain ⟨Lat, F, c, wq, hwq, hc1, hcount, hFmeas, hfd, hLat0, hsh, hfib, hslab,
    htrans⟩ := hFund q hq
  haveI : Countable ↥Lat := hcount
  refine ⟨2 * (cK : ℂ) *
      (((MeasureTheory.volume (F ∩ {u : NumberField.InfinitePlace K → ℝ |
          0 ≤ kaiMFLogNorm K u ∧ kaiMFLogNorm K u ≤ 1})).toReal : ℝ) : ℂ) *
      ((Real.pi ^ ((Module.finrank ℚ K : ℝ) / 2) : ℝ) : ℂ) /
      ((wq : ℂ) * ((Ideal.absNorm q : ℝ) : ℂ) *
        ∏ w : NumberField.InfinitePlace K,
          Complex.Gamma ((kaiMFConeAlpha K w : ℝ) : ℂ)), ?_⟩
  intro b hb hbq ρ₀ hρ0 hρb hρq Gen hGen1 hGen2
  have hqb : q * b ≠ 0 := by
    intro h
    rw [Submodule.zero_eq_bot] at h
    rcases Ideal.mul_eq_bot.mp h with h' | h'
    · exact hq (by rw [Submodule.zero_eq_bot]; exact h')
    · exact hb (by rw [Submodule.zero_eq_bot]; exact h')
  obtain ⟨hsumP, bf, vv, κ, r, hr0, hrB, hbfle, hbfge, hκ1, hκ2, htrace, hsumD, hlaw⟩ :=
    hSh (q * b) hqb (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
  obtain ⟨Xi, MXi, c₂, hMXi0, hc₂1, hXirefl, hXiF0, hF2meas, hfd2, hslab2, hXi⟩ :=
    kai_mf_cone_slab_elementary_integral (K := K) Lat hcount F c hc1 hFmeas hfd hLat0
      hslab htrans (fun w => Real.log (r w))
  set δ : ℂ := if h : ∃ μ : ↥(q * b), NumberField.mixedEmbedding K ((ρ₀ : K)) +
      NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K) = 0
    then kaiHZArchWeight K η l 0 else 0 with hδdef
  have hδ1 : ∀ μ : ↥(q * b), NumberField.mixedEmbedding K ((ρ₀ : K)) +
      NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K) = 0 →
      δ = kaiHZArchWeight K η l 0 := by
    intro μ hμ; rw [hδdef, dif_pos ⟨μ, hμ⟩]
  have hδ2 : (∀ μ : ↥(q * b), NumberField.mixedEmbedding K ((ρ₀ : K)) +
      NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K) ≠ 0) →
      δ = 0 := by
    intro h; rw [hδdef, dif_neg]; rintro ⟨μ, hμ⟩; exact h μ hμ
  obtain ⟨hmeasP, e₀, he₀, hdecP⟩ :=
    kai_mf_cone_theta_shift_decay (K := K) (q * b) hqb
      (NumberField.mixedEmbedding K ((ρ₀ : K))) η l δ hδ1 hδ2
      (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
        - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ))
      (by
        intro w
        simp [Complex.sub_re, Complex.mul_re])
      c ((1 : ℝ) / 2 * ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * Real.log (r w)) hc1 hsumP
  obtain ⟨hmeasD, e₀', he₀', hdecD⟩ :=
    kai_mf_cone_thetachar_shift_decay (K := K) bf vv η l
      (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
        + Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ))
      (by
        intro w
        simp [Complex.add_re, Complex.mul_re])
      c₂ ((1 : ℝ) / 2 * ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * Real.log (r w)) hc₂1 hsumD
  set θ₀ : ℝ := (1 : ℝ) / 2 * ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * Real.log (r w) with hθ₀def
  obtain ⟨Ct, hCt0, hTdiff, hTbd⟩ := hTail
      (fun u : NumberField.InfinitePlace K → ℝ =>
        (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
            (fun w => Real.exp (u w)) - δ) *
          kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
            - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)) u)
      0 F θ₀ c e₀ hFmeas hc1 he₀ hmeasP hslab
      (fun u hu hT => hdecP u hT (hslab u hu))
  obtain ⟨Ct', hCt'0, hTdiff', hTbd'⟩ := hTail
      (fun u : NumberField.InfinitePlace K → ℝ =>
        (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w))
            - kaiHZArchWeight K η (fun p => -l p) 0) *
          kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
            + Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)) u)
      0 {u : NumberField.InfinitePlace K → ℝ | (fun w => Real.log (r w) - u w) ∈ F}
      θ₀ c₂ e₀' hF2meas hc₂1 he₀' hmeasD hslab2
      (fun u hu hT => hdecD u hT (hslab2 u hu))
  have hIP : ∀ (s : ℂ) (u : NumberField.InfinitePlace K → ℝ),
      ((kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
            (fun w => Real.exp (u w)) - δ) *
          kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
            - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)) u - 0) *
        kaiMFConeWeight K (fun w => (kaiMFConeAlpha K w : ℂ) * s) u
      = (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
            (fun w => Real.exp (u w)) - δ) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s) u := by
    intro s u
    have hz : (fun w : NumberField.InfinitePlace K =>
        (((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
            - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ))
          + (kaiMFConeAlpha K w : ℂ) * s) = kaiMFConeZcan K t l η s := by
      funext w
      simp only [kaiMFConeZcan]
      ring
    rw [sub_zero, mul_assoc, hWmul, hz]
  have hID : ∀ (s : ℂ) (u : NumberField.InfinitePlace K → ℝ),
      ((kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w))
            - kaiHZArchWeight K η (fun p => -l p) 0) *
          kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
            + Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)) u - 0) *
        kaiMFConeWeight K (fun w => (kaiMFConeAlpha K w : ℂ) * s) u
      = (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w))
            - kaiHZArchWeight K η (fun p => -l p) 0) *
          kaiMFConeWeight K (kaiMFConeZdual K t l η s) u := by
    intro s u
    have hz : (fun w : NumberField.InfinitePlace K =>
        (((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
            + Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ))
          + (kaiMFConeAlpha K w : ℂ) * s) = kaiMFConeZdual K t l η s := by
      funext w
      simp only [kaiMFConeZdual]
      ring
    rw [sub_zero, mul_assoc, hWmul, hz]
  have hEP : ∀ s : ℂ,
      (∫ u in F ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
        ((kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
              (fun w => Real.exp (u w)) - δ) *
            kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
              - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)) u - 0) *
          kaiMFConeWeight K (fun w => (kaiMFConeAlpha K w : ℂ) * s) u)
      = ∫ u in F ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
          (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
              (fun w => Real.exp (u w)) - δ) *
            kaiMFConeWeight K (kaiMFConeZcan K t l η s) u :=
    fun s => MeasureTheory.integral_congr_ae
      (Filter.Eventually.of_forall (fun u => hIP s u))
  have hED : ∀ s : ℂ,
      (∫ u in {u : NumberField.InfinitePlace K → ℝ |
            (fun w => Real.log (r w) - u w) ∈ F} ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
        ((kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w))
              - kaiHZArchWeight K η (fun p => -l p) 0) *
            kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
              + Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)) u - 0) *
          kaiMFConeWeight K (fun w => (kaiMFConeAlpha K w : ℂ) * s) u)
      = ∫ u in {u : NumberField.InfinitePlace K → ℝ |
            (fun w => Real.log (r w) - u w) ∈ F} ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
          (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w))
              - kaiHZArchWeight K η (fun p => -l p) 0) *
            kaiMFConeWeight K (kaiMFConeZdual K t l η s) u :=
    fun s => MeasureTheory.integral_congr_ae
      (Filter.Eventually.of_forall (fun u => hID s u))
  rw [funext hEP] at hTdiff
  rw [funext hED] at hTdiff'
  simp only [hEP] at hTbd
  simp only [hED] at hTbd'
  set δ' : ℂ := kaiHZArchWeight K η (fun p => -l p) 0 with hδ'def
  set Tl : ℂ → ℂ := fun s : ℂ => ∫ u in F ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
      (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
          (fun w => Real.exp (u w)) - δ) *
        kaiMFConeWeight K (kaiMFConeZcan K t l η s) u with hTldef
  set Tl' : ℂ → ℂ := fun s : ℂ => ∫ u in {u : NumberField.InfinitePlace K → ℝ |
        (fun w => Real.log (r w) - u w) ∈ F} ∩ {u | θ₀ ≤ kaiMFLogNorm K u},
      (kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w)) - δ') *
        kaiMFConeWeight K (kaiMFConeZdual K t l η s) u with hTl'def
  set Rr : ℂ → ℂ := fun s : ℂ => Complex.exp (-∑ w : NumberField.InfinitePlace K,
      kaiMFConeZdual K t l η (1 - s) w * ((Real.log (r w) : ℝ) : ℂ)) with hRrdef
  set Pf : ℂ → ℂ := fun s : ℂ =>
      ((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
          kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
        Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 * Real.log Real.pi : ℝ) : ℂ) * s) *
        ∏ w : NumberField.InfinitePlace K,
          (Complex.Gamma (kaiMFConeZcan K t l η s w))⁻¹ with hPfdef
  have hTlD : Differentiable ℂ Tl := by rw [hTldef]; exact hTdiff
  have hTl'D : Differentiable ℂ Tl' := by rw [hTl'def]; exact hTdiff'
  have hsubD : Differentiable ℂ (fun s : ℂ => (1 : ℂ) - s) := by fun_prop
  have hRrD : Differentiable ℂ Rr := by
    rw [hRrdef]; simp only [kaiMFConeZdual]; fun_prop
  have hPfD : Differentiable ℂ Pf := by
    rw [hPfdef]
    refine Differentiable.mul (Differentiable.mul (differentiable_const _) (by fun_prop)) ?_
    intro s
    refine DifferentiableAt.fun_finset_prod (fun w _ => ?_)
    have h1 : Differentiable ℂ (fun z : ℂ => kaiMFConeZcan K t l η z w) := by
      simp only [kaiMFConeZcan]; fun_prop
    have h2 : Differentiable ℂ
        (fun z : ℂ => (Complex.Gamma (kaiMFConeZcan K t l η z w))⁻¹) :=
      Complex.differentiable_one_div_Gamma.comp h1
    exact h2 s
  have hXiZcanD : ∀ G : Set (NumberField.InfinitePlace K → ℝ),
      (G = F ∨ G = {u : NumberField.InfinitePlace K → ℝ |
          (fun w => Real.log (r w) - u w) ∈ F}) →
      Differentiable ℂ (fun s : ℂ => Xi G (kaiMFConeZcan K t l η s)) := by
    intro G hG
    have heq : (fun s : ℂ => Xi G (kaiMFConeZcan K t l η s))
        = fun s : ℂ => Xi G (fun w => (kaiMFConeAlpha K w : ℂ) * s +
            (((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
              - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ))) := by
      funext s; congr 1; funext w; simp only [kaiMFConeZcan]; ring
    rw [heq]; exact (hXi G hG).2.1 _ _
  have hXiZdualD : ∀ G : Set (NumberField.InfinitePlace K → ℝ),
      (G = F ∨ G = {u : NumberField.InfinitePlace K → ℝ |
          (fun w => Real.log (r w) - u w) ∈ F}) →
      Differentiable ℂ (fun s : ℂ => Xi G (kaiMFConeZdual K t l η (1 - s))) := by
    intro G hG
    have heq : (fun s : ℂ => Xi G (kaiMFConeZdual K t l η (1 - s)))
        = fun s : ℂ => Xi G (fun w => (-(kaiMFConeAlpha K w : ℂ)) * s +
            ((kaiMFConeAlpha K w : ℂ) + ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
              + Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ))) := by
      funext s; congr 1; funext w; simp only [kaiMFConeZdual]; ring
    rw [heq]; exact (hXi G hG).2.1 _ _
  set ee : ℂ := if ((∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) ∧ t = 0)
    then 1 else 0 with heedef
  have hee : ee ≠ 0 →
      ((∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) ∧ t = 0) := by
    intro h
    by_contra hc
    rw [heedef, if_neg hc] at h
    exact h rfl
  set Gc : ℂ → ℂ := fun s : ℂ => (s - 1) * (Tl s + κ * Rr s * Tl' (1 - s)) * Pf s
      + ee * (κ * Rr s * 2 * Complex.exp ((1 - s) * (θ₀ : ℂ) / 2) *
          Xi {u : NumberField.InfinitePlace K → ℝ |
            (fun w => Real.log (r w) - u w) ∈ F}
            (kaiMFConeZdual K t l η (1 - s)) * Pf s)
      - ee * (δ * (s - 1) * 2 * Complex.exp (s * (θ₀ : ℂ) / 2) *
          Xi F (kaiMFConeZcan K t l η s) *
          ((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
              kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
          Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 * Real.log Real.pi : ℝ) : ℂ) * s) *
          (∏ w : NumberField.InfinitePlace K, ((kaiMFConeAlpha K w : ℝ) : ℂ)) *
          s ^ (Fintype.card (NumberField.InfinitePlace K) - 1) *
          ∏ w : NumberField.InfinitePlace K,
            (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + 1))⁻¹) with hGcdef
  have hGcval : ∀ s : ℂ, Gc s = (s - 1) * (Tl s + κ * Rr s * Tl' (1 - s)) * Pf s
      + ee * (κ * Rr s * 2 * Complex.exp ((1 - s) * (θ₀ : ℂ) / 2) *
          Xi {u : NumberField.InfinitePlace K → ℝ |
            (fun w => Real.log (r w) - u w) ∈ F}
            (kaiMFConeZdual K t l η (1 - s)) * Pf s)
      - ee * (δ * (s - 1) * 2 * Complex.exp (s * (θ₀ : ℂ) / 2) *
          Xi F (kaiMFConeZcan K t l η s) *
          ((wq : ℂ) * ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K,
              kaiHZDeg K η l w) / 2) : ℝ) : ℂ))⁻¹ *
          Complex.exp ((((Module.finrank ℚ K : ℝ) / 2 * Real.log Real.pi : ℝ) : ℂ) * s) *
          (∏ w : NumberField.InfinitePlace K, ((kaiMFConeAlpha K w : ℝ) : ℂ)) *
          s ^ (Fintype.card (NumberField.InfinitePlace K) - 1) *
          ∏ w : NumberField.InfinitePlace K,
            (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + 1))⁻¹) := by
    intro s; rw [hGcdef]
  have hGamInv1 : Differentiable ℂ (fun s : ℂ => ∏ w : NumberField.InfinitePlace K,
      (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + 1))⁻¹) := by
    intro s
    refine DifferentiableAt.fun_finset_prod (fun w _ => ?_)
    have h1 : Differentiable ℂ (fun z : ℂ => (kaiMFConeAlpha K w : ℂ) * z + 1) := by
      fun_prop
    have h2 : Differentiable ℂ
        (fun z : ℂ => (Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * z + 1))⁻¹) :=
