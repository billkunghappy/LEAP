      mul_pos (mul_pos (pow_pos hσa0 2) (pow_pos hσ₀0 2)) (pow_pos hQpos 2)
    have hB : 256 * R ^ 3 * ε / (σa ^ 2 * σ₀ ^ 2 * (4 * (S : ℝ) + 1) ^ 2)
        ≤ D ^ 8 * R ^ 3 * ε / (S : ℝ) ^ 2 := by
      rw [div_le_div_iff₀ hdenpos (pow_pos hS0 2)]
      have hRe : 0 ≤ R ^ 3 * ε := mul_nonneg (pow_nonneg hRpos.le 3) hε
      have := mul_le_mul_of_nonneg_left hden hRe
      nlinarith
    rw [eA]
    have hεS : 0 ≤ ε / (S : ℝ) ^ 2 := div_nonneg hε (pow_pos hS0 2).le
    calc (2 * R / σ₀) ^ m * (256 * R ^ 3 * ε / (σa ^ 2 * σ₀ ^ 2 * (4 * (S : ℝ) + 1) ^ 2))
        ≤ D ^ (2 * k + 2 * m) * (D ^ 8 * R ^ 3 * ε / (S : ℝ) ^ 2) :=
          mul_le_mul hTm hB (div_nonneg (by positivity) hdenpos.le) (pow_pos hDpos _).le
      _ = (D ^ (2 * k + 2 * m) * D ^ 8 * R ^ 3) * (ε / (S : ℝ) ^ 2) := by ring
      _ ≤ (D ^ (2 * k + 2 * m) * D ^ 8 * D ^ (6 * m)) * (ε / (S : ℝ) ^ 2) := by
          apply mul_le_mul_of_nonneg_right _ hεS
          exact mul_le_mul_of_nonneg_left hR3
            (mul_nonneg (pow_pos hDpos _).le (pow_pos hDpos _).le)
      _ ≤ D ^ n * (ε / (S : ℝ) ^ 2) := by
          apply mul_le_mul_of_nonneg_right _ hεS
          rw [← pow_add, ← pow_add]
          exact hDpow _ _ (by omega)
      _ = D ^ n * ε / (S : ℝ) ^ 2 := by ring
  exact ⟨hσa0, hσa1, h3, h4, hσ₀0, hσ₀1, hR1, h8, h9, h10, h11, h12⟩

theorem kai_quad_vinogradov_homog (ν : ℕ) :
    ∃ (Cq : ℝ) (Aq : ℕ), 1 ≤ Cq ∧ 1 ≤ Aq ∧
      ∀ (S : ℕ) (δ ε c : ℝ) (G : Finset (Fin ν → ℤ)) (B : Fin ν → Fin ν → ℝ),
        1 ≤ S → 0 < δ → δ ≤ 1 → 0 ≤ ε → ε ≤ (δ / Cq) ^ Aq → (Cq / δ) ^ Aq ≤ (S : ℝ) →
        G ⊆ intBox ν S → δ * (((2 * S + 1 : ℕ) : ℝ) ^ ν) ≤ (G.card : ℝ) →
        (∀ z ∈ G, ∃ k : ℤ,
          |c + ∑ l, ∑ l', B l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ) - (k : ℝ)| ≤ ε) →
        ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (Cq / δ) ^ Aq ∧
          ∀ l l', ∃ a : ℤ, |(q : ℝ) * (B l l' + B l' l) - (a : ℝ)|
            ≤ (Cq / δ) ^ Aq * ε / (S : ℝ) ^ 2 :=
by
  refine ⟨(2 : ℝ) ^ (2 * ν + 2), 2 * (ν ^ 4 + 5 * ν ^ 2 + 8), one_le_pow₀ (by norm_num),
    Nat.one_le_iff_ne_zero.mpr (by positivity), ?_⟩
  intro S δ ε c G B hS hδ hδ1 hε hεb hSb hG hcard hφ
  obtain ⟨σa, hσa⟩ : ∃ x : ℝ, x = δ ^ 2 / 2 ^ (2 * ν + 1) := ⟨_, rfl⟩
  obtain ⟨R, hR⟩ : ∃ x : ℝ, x = (2 / σa) ^ (ν * ν) := ⟨_, rfl⟩
  obtain ⟨σ₀, hσ₀⟩ : ∃ x : ℝ, x = δ ^ 2 / 2 ^ (ν + 1) := ⟨_, rfl⟩
  obtain ⟨η, hη⟩ : ∃ x : ℝ, x = R * (8 * (4 * ε) / (σa ^ 2 * (4 * (S : ℝ) + 1))) := ⟨_, rfl⟩
  obtain ⟨hσa0, hσa1, h4ε, hσaS, hσ₀0, hσ₀1, hR1, hη0, hησ, hσbS, hqT, herrT⟩ :=
    kai_qv_constants ν S δ ε σa R σ₀ η hS hδ hδ1 hε hεb hSb hσa hR hσ₀ hη
  
  have hpar : ∀ z w h : Fin ν → ℤ,
      (∃ k : ℤ, |c + ∑ l, ∑ l', B l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ) - (k : ℝ)| ≤ ε) →
      (∃ k : ℤ, |c + ∑ l, ∑ l', B l l' * (((z + h) l : ℤ) : ℝ) * (((z + h) l' : ℤ) : ℝ)
        - (k : ℝ)| ≤ ε) →
      (∃ k : ℤ, |c + ∑ l, ∑ l', B l l' * ((w l : ℤ) : ℝ) * ((w l' : ℤ) : ℝ) - (k : ℝ)| ≤ ε) →
      (∃ k : ℤ, |c + ∑ l, ∑ l', B l l' * (((w + h) l : ℤ) : ℝ) * (((w + h) l' : ℤ) : ℝ)
        - (k : ℝ)| ≤ ε) →
      ∃ m : ℤ, |∑ l, (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) * ((z l - w l : ℤ) : ℝ)
        - (m : ℝ)| ≤ 4 * ε := by
    intro z w h h1 h2 h3 h4
    have key : ∀ x : Fin ν → ℤ,
        ∑ l, ∑ l', B l l' * (((x + h) l : ℤ) : ℝ) * (((x + h) l' : ℤ) : ℝ)
          = ∑ l, ∑ l', B l l' * ((x l : ℤ) : ℝ) * ((x l' : ℤ) : ℝ)
            + ∑ l, (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) * ((x l : ℤ) : ℝ)
            + ∑ l, ∑ l', B l l' * ((h l : ℤ) : ℝ) * ((h l' : ℤ) : ℝ) := by
      intro x
      have e1 : ∀ l l', B l l' * (((x + h) l : ℤ) : ℝ) * (((x + h) l' : ℤ) : ℝ)
          = B l l' * ((x l : ℤ) : ℝ) * ((x l' : ℤ) : ℝ)
            + B l l' * ((h l' : ℤ) : ℝ) * ((x l : ℤ) : ℝ)
            + B l l' * ((h l : ℤ) : ℝ) * ((x l' : ℤ) : ℝ)
            + B l l' * ((h l : ℤ) : ℝ) * ((h l' : ℤ) : ℝ) := by
        intro l l'
        simp only [Pi.add_apply, Int.cast_add]
        ring
      have e3 : ∑ l, ∑ l', B l l' * ((h l : ℤ) : ℝ) * ((x l' : ℤ) : ℝ)
          = ∑ l, ∑ l', B l' l * ((h l' : ℤ) : ℝ) * ((x l : ℤ) : ℝ) := Finset.sum_comm
      have e2 : ∑ l, (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) * ((x l : ℤ) : ℝ)
          = ∑ l, ∑ l', B l l' * ((h l' : ℤ) : ℝ) * ((x l : ℤ) : ℝ)
            + ∑ l, ∑ l', B l l' * ((h l : ℤ) : ℝ) * ((x l' : ℤ) : ℝ) := by
        rw [e3, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [Finset.sum_mul, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun l' _ => ?_
        ring
      simp only [e1, Finset.sum_add_distrib]
      rw [e2]
      ring
    obtain ⟨k1, hk1⟩ := h1
    obtain ⟨k2, hk2⟩ := h2
    obtain ⟨k3, hk3⟩ := h3
    obtain ⟨k4, hk4⟩ := h4
    refine ⟨k2 - k1 - k4 + k3, ?_⟩
    have kz := key z
    have kw := key w
    have hL : ∑ l, (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) * ((z l - w l : ℤ) : ℝ)
        = ∑ l, (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) * ((z l : ℤ) : ℝ)
          - ∑ l, (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) * ((w l : ℤ) : ℝ) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun l _ => ?_
      push_cast
      ring
    have hm : (((k2 - k1 - k4 + k3 : ℤ) : ℝ)) = (k2 : ℝ) - k1 - k4 + k3 := by push_cast; ring
    rw [hL, hm]
    rw [abs_le] at hk1 hk2 hk3 hk4 ⊢
    constructor <;> linarith [hk1.1, hk1.2, hk2.1, hk2.2, hk3.1, hk3.2, hk4.1, hk4.2]
  obtain ⟨H₁, hH₁, hcardH₁, hGh⟩ := kai_qv_popular_differences ν S δ G hδ hG hcard
  rw [← hσ₀] at hcardH₁
  
  have htrans : ∀ (v : Fin ν → ℝ) (G' : Finset (Fin ν → ℤ)) (η' : ℝ), 0 ≤ η' → η' ≤ σa / 32 →
      G' ⊆ intBox ν S → σa * (4 * (S : ℝ) + 1) ^ ν ≤ (G'.card : ℝ) →
      (∀ z ∈ G', ∀ z' ∈ G', ∃ m : ℤ, |∑ l, v l * ((z l - z' l : ℤ) : ℝ) - (m : ℝ)| ≤ η') →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (2 / σa) ^ (ν * ν) ∧
        ∀ l, |(q : ℝ) * v l - ((round ((q : ℝ) * v l) : ℤ) : ℝ)|
          ≤ (q : ℝ) * (8 * η' / (σa ^ 2 * (4 * (S : ℝ) + 1))) := by
    intro v G' η' hη' hησ' hG' hcard' hpair
    have hpos : (0 : ℝ) < (G'.card : ℝ) := lt_of_lt_of_le (mul_pos hσa0 (by positivity)) hcard'
    obtain ⟨z₀, hz₀⟩ : G'.Nonempty := Finset.card_pos.mp (by exact_mod_cast hpos)
    have hDcard : (G'.image (fun z => z - z₀)).card = G'.card :=
      Finset.card_image_of_injective G' sub_left_injective
    have hDbox : G'.image (fun z => z - z₀) ⊆ intBox ν (2 * S) := by
      intro u hu
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hu
      have h1 := hG' hz
      have h2 := hG' hz₀
      simp only [intBox, Finset.mem_Icc, Pi.le_def] at h1 h2 ⊢
      refine ⟨fun i => ?_, fun i => ?_⟩
      · have a1 := h1.1 i
        have a2 := h1.2 i
        have a3 := h2.1 i
        have a4 := h2.2 i
        simp only [Pi.sub_apply]
        push_cast
        omega
      · have a1 := h1.1 i
        have a2 := h1.2 i
        have a3 := h2.1 i
        have a4 := h2.2 i
        simp only [Pi.sub_apply]
        push_cast
        omega
    obtain ⟨q, hq1, hqle, hqa⟩ := kai_qwi_quadratic_denominator ν S (fun _ l' => v l') σa η'
      (G'.image (fun z => z - z₀)) hS hσa0 hσa1 hη' hησ' hσaS hDbox
      (by rw [hDcard]; exact hcard') (by
        intro u hu l
        obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hu
        obtain ⟨m, hm⟩ := hpair z hz z₀ hz₀
        exact (round_le _ m).trans hm)
    exact ⟨q, hq1, hqle, fun l => hqa l l⟩
  have hq : ∀ h ∈ H₁, ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ R ∧ ∀ l,
      |(q : ℝ) * (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ))
        - ((round ((q : ℝ) * (∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ))) : ℤ) : ℝ)| ≤ η := by
    intro h hh
    obtain ⟨Gh, hGhG, hGhsh, hGhcard⟩ := hGh h hh
    rw [← hσa] at hGhcard
    obtain ⟨q, hq1, hqR, hqa⟩ := htrans
      (fun l => ∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) Gh (4 * ε)
      (by linarith) h4ε (hGhG.trans hG) hGhcard
      (fun z hz z' hz' => hpar z z' h (hφ z (hGhG hz))
        (hφ (z + h) (hGhsh z hz)) (hφ z' (hGhG hz')) (hφ (z' + h) (hGhsh z' hz')))
    have hqR' : (q : ℝ) ≤ R := by rw [hR]; exact hqR
    have hbr : 0 ≤ 8 * (4 * ε) / (σa ^ 2 * (4 * (S : ℝ) + 1)) :=
      div_nonneg (by linarith) (by positivity)
    refine ⟨q, hq1, hqR', fun l => ?_⟩
    calc _ ≤ (q : ℝ) * (8 * (4 * ε) / (σa ^ 2 * (4 * (S : ℝ) + 1))) := hqa l
      _ ≤ R * (8 * (4 * ε) / (σa ^ 2 * (4 * (S : ℝ) + 1))) :=
          mul_le_mul_of_nonneg_right hqR' hbr
      _ = η := hη.symm
  
  choose! f hf1 hfR hfa using hq
  have hR0 : 0 < R := by linarith
  have hfl : 1 ≤ ⌊R⌋₊ := Nat.le_floor (by exact_mod_cast hR1)
  have hmaps : ∀ h ∈ H₁, f h ∈ Finset.Icc 1 ⌊R⌋₊ := by
    intro h hh
    rw [Finset.mem_Icc]
    exact ⟨hf1 h hh, Nat.le_floor (hfR h hh)⟩
  have htne : (Finset.Icc 1 ⌊R⌋₊).Nonempty := ⟨1, Finset.mem_Icc.mpr ⟨le_rfl, hfl⟩⟩
  have hnsmul : (Finset.Icc 1 ⌊R⌋₊).card • ((H₁.card : ℝ) / R) ≤ (H₁.card : ℝ) := by
    rw [Nat.card_Icc, nsmul_eq_mul, Nat.add_sub_cancel]
    have hfR' : (⌊R⌋₊ : ℝ) ≤ R := Nat.floor_le (by linarith)
    calc (⌊R⌋₊ : ℝ) * ((H₁.card : ℝ) / R) ≤ R * ((H₁.card : ℝ) / R) :=
          mul_le_mul_of_nonneg_right hfR' (div_nonneg (Nat.cast_nonneg _) hR0.le)
      _ = (H₁.card : ℝ) := by field_simp
  obtain ⟨q₁, hq₁t, hq₁card⟩ :=
    Finset.exists_le_card_fiber_of_nsmul_le_card_of_maps_to hmaps htne hnsmul
  have hq₁1 : 1 ≤ q₁ := (Finset.mem_Icc.mp hq₁t).1
  have hq₁R : (q₁ : ℝ) ≤ R :=
    (Nat.cast_le.mpr (Finset.mem_Icc.mp hq₁t).2).trans (Nat.floor_le (by linarith))
  have hσb0 : 0 < σ₀ / R := div_pos hσ₀0 hR0
  have hσb1 : σ₀ / R ≤ 1 := by rw [div_le_one hR0]; linarith
  have hH₂box : H₁.filter (fun x => f x = q₁) ⊆ intBox ν (2 * S) :=
    (Finset.filter_subset _ _).trans hH₁
  have hH₂card : σ₀ / R * (4 * (S : ℝ) + 1) ^ ν ≤ ((H₁.filter (fun x => f x = q₁)).card : ℝ) := by
    calc σ₀ / R * (4 * (S : ℝ) + 1) ^ ν = σ₀ * (4 * (S : ℝ) + 1) ^ ν / R := by ring
      _ ≤ (H₁.card : ℝ) / R := div_le_div_of_nonneg_right hcardH₁ hR0.le
      _ ≤ _ := hq₁card
  have hgood : ∀ h ∈ H₁.filter (fun x => f x = q₁), ∀ l : Fin ν,
      |(∑ l', (q₁ : ℝ) * (B l l' + B l' l) * ((h l' : ℤ) : ℝ))
        - ((round (∑ l', (q₁ : ℝ) * (B l l' + B l' l) * ((h l' : ℤ) : ℝ)) : ℤ) : ℝ)| ≤ η := by
    intro h hh l
    obtain ⟨hh1, hh2⟩ := Finset.mem_filter.mp hh
    have e : ∑ l', (q₁ : ℝ) * (B l l' + B l' l) * ((h l' : ℤ) : ℝ)
        = (f h : ℝ) * ∑ l', (B l l' + B l' l) * ((h l' : ℤ) : ℝ) := by
      rw [hh2, Finset.mul_sum]
      refine Finset.sum_congr rfl fun l' _ => ?_
      ring
    rw [e]
    exact hfa h hh1 l
  obtain ⟨q₂, hq₂1, hq₂le, hq₂a⟩ := kai_qwi_quadratic_denominator ν S
    (fun l l' => (q₁ : ℝ) * (B l l' + B l' l)) (σ₀ / R) η (H₁.filter (fun x => f x = q₁))
    hS hσb0 hσb1 hη0 hησ hσbS hH₂box hH₂card hgood
  have h2R : 2 / (σ₀ / R) = 2 * R / σ₀ := div_div_eq_mul_div 2 σ₀ R
  rw [h2R] at hq₂le
  have hTpos : 0 ≤ (2 * R / σ₀) ^ (ν * ν) := pow_nonneg (div_nonneg (by linarith) hσ₀0.le) _
  refine ⟨q₂ * q₁, Nat.one_le_iff_ne_zero.mpr (mul_ne_zero (by omega) (by omega)), ?_,
    fun l l' => ?_⟩
  · push_cast
    calc (q₂ : ℝ) * q₁ ≤ (2 * R / σ₀) ^ (ν * ν) * R :=
          mul_le_mul hq₂le hq₁R (Nat.cast_nonneg _) hTpos
      _ = R * (2 * R / σ₀) ^ (ν * ν) := mul_comm _ _
      _ ≤ _ := hqT
  · refine ⟨round ((q₂ : ℝ) * ((q₁ : ℝ) * (B l l' + B l' l))), ?_⟩
    have e : ((q₂ * q₁ : ℕ) : ℝ) * (B l l' + B l' l)
        = (q₂ : ℝ) * ((q₁ : ℝ) * (B l l' + B l' l)) := by push_cast; ring
    rw [e]
    have hbr : 0 ≤ 8 * η / ((σ₀ / R) ^ 2 * (4 * (S : ℝ) + 1)) :=
      div_nonneg (by linarith) (by positivity)
    calc _ ≤ (q₂ : ℝ) * (8 * η / ((σ₀ / R) ^ 2 * (4 * (S : ℝ) + 1))) := hq₂a l l'
      _ ≤ (2 * R / σ₀) ^ (ν * ν) * (8 * η / ((σ₀ / R) ^ 2 * (4 * (S : ℝ) + 1))) :=
          mul_le_mul_of_nonneg_right hq₂le hbr
      _ ≤ _ := herrT

theorem kai_bilinear_w_vinogradov (ν : ℕ) :
    ∃ (Cv : ℝ) (Av : ℕ), 1 ≤ Cv ∧ 1 ≤ Av ∧
      ∀ (S q₀ : ℕ) (δ ε₁ ε₂ : ℝ) (G : Finset (Fin ν → ℤ))
        (Mt : Fin ν → Matrix (Fin ν) (Fin ν) ℤ) (c : Fin ν → ℤ)
        (lam : Fin ν → ℝ) (A : Fin ν → Fin ν → ℝ) (z' : Fin ν → ℤ),
        1 ≤ S → 0 < δ → δ ≤ 1 → 0 ≤ ε₁ → 0 ≤ ε₂ →
        ε₁ ≤ (δ / Cv) ^ Av → ε₂ ≤ (δ / Cv) ^ Av → (Cv / δ) ^ Av ≤ (S : ℝ) →
        G ⊆ intBox ν S → δ * (((2 * S + 1 : ℕ) : ℝ) ^ ν) ≤ (G.card : ℝ) →
        ∑ t, c t • Mt t = 1 →
        (∀ z ∈ G, ∀ j, ∃ b : ℤ,
          |(q₀ : ℝ) * (∑ i, (((∑ t, z t • Mt t) i j : ℤ) : ℝ) * lam i
              - ∑ i, (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * lam i) - (b : ℝ)| ≤ ε₁) →
        (∀ z ∈ G, ∀ j j', ∃ a : ℤ,
          |(q₀ : ℝ) * (∑ i, ∑ i', (((∑ t, z t • Mt t) i j : ℤ) : ℝ) * A i i'
                  * (((∑ t, z t • Mt t) i' j' : ℤ) : ℝ)
              - ∑ i, ∑ i', (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * A i i'
                  * (((∑ t, z' t • Mt t) i' j' : ℤ) : ℝ)) - (a : ℝ)| ≤ ε₂) →
        ∃ Q : ℕ, 1 ≤ Q ∧ (Q : ℝ) ≤ (Cv / δ) ^ Av ∧
          (∀ j, ∃ b : ℤ, |(Q : ℝ) * (q₀ : ℝ) * lam j - (b : ℝ)|
              ≤ (∑ t, |((c t : ℤ) : ℝ)|) * (Cv / δ) ^ Av * ε₁ / (S : ℝ)) ∧
          (∀ j j', ∃ a : ℤ, |2 * (Q : ℝ) * (q₀ : ℝ) * A j j' - (a : ℝ)|
              ≤ (∑ t, |((c t : ℤ) : ℝ)|) ^ 2 * (Cv / δ) ^ Av * ε₂ / (S : ℝ) ^ 2) :=
by
  classical
  obtain ⟨Cl, Al, hCl, hAl, hL⟩ := kai_lin_vinogradov_affine ν
  obtain ⟨Cq, Aq, hCq, hAq, hQd⟩ := kai_quad_vinogradov_homog ν
  obtain ⟨Cv, hCv⟩ : ∃ Cv : ℝ, Cv = max Cl Cq := ⟨_, rfl⟩
  obtain ⟨A', hA'⟩ : ∃ A' : ℕ, A' = max Al Aq := ⟨_, rfl⟩
  have hClCv : Cl ≤ Cv := hCv ▸ le_max_left _ _
  have hCqCv : Cq ≤ Cv := hCv ▸ le_max_right _ _
  have hCv1 : 1 ≤ Cv := le_trans hCl hClCv
  have hAlA : Al ≤ A' := hA' ▸ le_max_left _ _
  have hAqA : Aq ≤ A' := hA' ▸ le_max_right _ _
  have hA'1 : 1 ≤ A' := le_trans hAl hAlA
  have hA'Av : A' ≤ A' * (ν + ν * ν + 1) := Nat.le_mul_of_pos_right _ (by omega)
  refine ⟨Cv, A' * (ν + ν * ν + 1), hCv1, le_trans hA'1 hA'Av, ?_⟩
  intro S q₀ δ ε₁ ε₂ G Mt c lam A z' hS hδ hδ1 hε₁ hε₂ hε₁b hε₂b hSb hG hcard hc hlin hquad
  
  have hSpos : (0 : ℝ) < S := by exact_mod_cast hS
  have hCvδ : 1 ≤ Cv / δ := by rw [le_div_iff₀ hδ]; linarith
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = (Cv / δ) ^ A' := ⟨_, rfl⟩
  have hB1 : 1 ≤ B := hB ▸ one_le_pow₀ hCvδ
  have hB0 : 0 ≤ B := by linarith
  have hBl : (Cl / δ) ^ Al ≤ B := by
    rw [hB]
    calc (Cl / δ) ^ Al ≤ (Cv / δ) ^ Al :=
          pow_le_pow_left₀ (div_nonneg (by linarith) hδ.le)
            (div_le_div_of_nonneg_right hClCv hδ.le) Al
      _ ≤ (Cv / δ) ^ A' := pow_le_pow_right₀ hCvδ hAlA
  have hBq : (Cq / δ) ^ Aq ≤ B := by
    rw [hB]
    calc (Cq / δ) ^ Aq ≤ (Cv / δ) ^ Aq :=
          pow_le_pow_left₀ (div_nonneg (by linarith) hδ.le)
            (div_le_div_of_nonneg_right hCqCv hδ.le) Aq
      _ ≤ (Cv / δ) ^ A' := pow_le_pow_right₀ hCvδ hAqA
  have hBAv : B ^ (ν + ν * ν) * B = (Cv / δ) ^ (A' * (ν + ν * ν + 1)) := by
    rw [hB, ← pow_succ, ← pow_mul]
  have hBAv' : B ≤ (Cv / δ) ^ (A' * (ν + ν * ν + 1)) := hB ▸ pow_le_pow_right₀ hCvδ hA'Av
  have hSB : B ≤ (S : ℝ) := hBAv'.trans hSb
  have hδCv0 : 0 ≤ δ / Cv := div_nonneg hδ.le (by linarith)
  have hδCv1 : δ / Cv ≤ 1 := by rw [div_le_one (by linarith)]; linarith
  have hε₁l : ε₁ ≤ (δ / Cl) ^ Al := by
    calc ε₁ ≤ (δ / Cv) ^ (A' * (ν + ν * ν + 1)) := hε₁b
      _ ≤ (δ / Cv) ^ Al := pow_le_pow_of_le_one hδCv0 hδCv1 (hAlA.trans hA'Av)
      _ ≤ (δ / Cl) ^ Al := pow_le_pow_left₀ hδCv0
            (div_le_div_of_nonneg_left hδ.le (by linarith) hClCv) Al
  have hε₂q : ε₂ ≤ (δ / Cq) ^ Aq := by
    calc ε₂ ≤ (δ / Cv) ^ (A' * (ν + ν * ν + 1)) := hε₂b
      _ ≤ (δ / Cv) ^ Aq := pow_le_pow_of_le_one hδCv0 hδCv1 (hAqA.trans hA'Av)
      _ ≤ (δ / Cq) ^ Aq := pow_le_pow_left₀ hδCv0
            (div_le_div_of_nonneg_left hδ.le (by linarith) hCqCv) Aq
  
  obtain ⟨β, hβ⟩ : ∃ β : Fin ν → Fin ν → ℝ,
      β = fun t j => ∑ i, ((Mt t i j : ℤ) : ℝ) * lam i := ⟨_, rfl⟩
  obtain ⟨γ, hγ⟩ : ∃ γ : Fin ν → Fin ν → Fin ν → Fin ν → ℝ,
      γ = fun j j' t s => ∑ i, ∑ i', ((Mt t i j : ℤ) : ℝ) * A i i' * ((Mt s i' j' : ℤ) : ℝ) :=
    ⟨_, rfl⟩
  
  have hent : ∀ (z : Fin ν → ℤ) (i j : Fin ν),
      (∑ t, z t • Mt t) i j = ∑ t, z t * Mt t i j := by
    intro z i j
    simp only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]
  have hexp1 : ∀ (z : Fin ν → ℤ) (j : Fin ν),
      ∑ i, (((∑ t, z t • Mt t) i j : ℤ) : ℝ) * lam i = ∑ t, β t j * ((z t : ℤ) : ℝ) := by
    intro z j
    rw [hβ]
    simp only [hent, Int.cast_sum, Int.cast_mul, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun t _ => Finset.sum_congr rfl (fun i _ => by ring))
  have hexp2 : ∀ (z : Fin ν → ℤ) (j j' : Fin ν),
      ∑ i, ∑ i', (((∑ t, z t • Mt t) i j : ℤ) : ℝ) * A i i' * (((∑ t, z t • Mt t) i' j' : ℤ) : ℝ)
        = ∑ t, ∑ s, γ j j' t s * ((z t : ℤ) : ℝ) * ((z s : ℤ) : ℝ) := by
    intro z j j'
    rw [hγ]
    simp only [hent, Int.cast_sum, Int.cast_mul, Finset.sum_mul, Finset.mul_sum]
    refine (Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun i' _ =>
      Finset.sum_comm).trans ?_
    refine (Finset.sum_congr rfl fun i _ => Finset.sum_comm).trans ?_
    refine Finset.sum_comm.trans ?_
    refine Finset.sum_congr rfl fun t _ => ?_
    refine (Finset.sum_congr rfl fun i _ => Finset.sum_comm).trans ?_
    refine Finset.sum_comm.trans ?_
    exact Finset.sum_congr rfl fun s _ => Finset.sum_congr rfl fun i _ =>
      Finset.sum_congr rfl fun i' _ => by ring
  have hexp3 : ∀ j, lam j = ∑ t, ((c t : ℤ) : ℝ) * β t j := by
    intro j
    have h := hexp1 c j
    rw [hc] at h
    simp only [Matrix.one_apply] at h
    simp at h
    rw [h]
    exact Finset.sum_congr rfl fun t _ => by ring
  have hexp4 : ∀ j j', A j j' = ∑ t, ∑ s, γ j j' t s * ((c t : ℤ) : ℝ) * ((c s : ℤ) : ℝ) := by
    intro j j'
    have h := hexp2 c j j'
    rw [hc] at h
    simp only [Matrix.one_apply] at h
    simp at h
    exact h
  
  have hcomb : ∀ (y : Fin ν → ℝ) (e : ℝ), (∀ t, ∃ a : ℤ, |y t - (a : ℝ)| ≤ e) →
      ∃ a : ℤ, |∑ t, ((c t : ℤ) : ℝ) * y t - (a : ℝ)| ≤ (∑ t, |((c t : ℤ) : ℝ)|) * e := by
    intro y e h
    choose a ha using h
    refine ⟨∑ t, c t * a t, ?_⟩
    push_cast
    rw [← Finset.sum_sub_distrib]
    calc |∑ t, (((c t : ℤ) : ℝ) * y t - ((c t : ℤ) : ℝ) * ((a t : ℤ) : ℝ))|
        ≤ ∑ t, |((c t : ℤ) : ℝ) * y t - ((c t : ℤ) : ℝ) * ((a t : ℤ) : ℝ)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ = ∑ t, |((c t : ℤ) : ℝ)| * |y t - ((a t : ℤ) : ℝ)| := by
          refine Finset.sum_congr rfl fun t _ => ?_
          rw [← abs_mul, mul_sub]
      _ ≤ ∑ t, |((c t : ℤ) : ℝ)| * e :=
          Finset.sum_le_sum fun t _ => mul_le_mul_of_nonneg_left (ha t) (abs_nonneg _)
      _ = (∑ t, |((c t : ℤ) : ℝ)|) * e := by rw [Finset.sum_mul]
  
  have hdiv : ∀ (q Q : ℕ) (x e : ℝ), q ∣ Q → 1 ≤ q → 0 ≤ e →
      (∃ a : ℤ, |(q : ℝ) * x - (a : ℝ)| ≤ e) → ∃ a : ℤ, |(Q : ℝ) * x - (a : ℝ)| ≤ (Q : ℝ) * e := by
    rintro q Q x e ⟨K, rfl⟩ hq he ⟨a, ha⟩
    refine ⟨(K : ℤ) * a, ?_⟩
    have h1 : ((q * K : ℕ) : ℝ) * x - (((K : ℤ) * a : ℤ) : ℝ) = (K : ℝ) * ((q : ℝ) * x - a) := by
      push_cast; ring
    rw [h1, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
    have hq' : (1 : ℝ) ≤ q := by exact_mod_cast hq
    have hK : (0 : ℝ) ≤ K := Nat.cast_nonneg _
    have h3 : 0 ≤ (K : ℝ) * ((q : ℝ) - 1) * e :=
      mul_nonneg (mul_nonneg hK (by linarith)) he
    calc (K : ℝ) * |(q : ℝ) * x - a| ≤ K * e := mul_le_mul_of_nonneg_left ha hK
      _ ≤ ((q * K : ℕ) : ℝ) * e := by push_cast; nlinarith [h3]
  
  have hlinq : ∀ j, ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ B ∧
      ∀ t, ∃ b : ℤ, |(q : ℝ) * ((q₀ : ℝ) * β t j) - (b : ℝ)| ≤ B * ε₁ / S := by
    intro j
    obtain ⟨q, hq1, hqB, hqa⟩ := hL S δ ε₁
      (-((q₀ : ℝ) * ∑ i, (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * lam i)) G
      (fun l => (q₀ : ℝ) * β l j) hS hδ hδ1 hε₁ hε₁l (hBl.trans hSB) hG hcard (by
        intro z hz
        obtain ⟨b, hb⟩ := hlin z hz j
        refine ⟨b, ?_⟩
        have e1 : -((q₀ : ℝ) * ∑ i, (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * lam i)
              + ∑ l, (q₀ : ℝ) * β l j * ((z l : ℤ) : ℝ)
            = (q₀ : ℝ) * (∑ i, (((∑ t, z t • Mt t) i j : ℤ) : ℝ) * lam i
              - ∑ i, (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * lam i) := by
          rw [hexp1 z j, mul_sub]
          simp only [Finset.mul_sum, mul_assoc]
          ring
        rw [e1]; exact hb)
    refine ⟨q, hq1, hqB.trans hBl, fun t => ?_⟩
    obtain ⟨b, hb⟩ := hqa t
    refine ⟨b, hb.trans ?_⟩
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hBl hε₁) hSpos.le
  
  have hquadq : ∀ j j', ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ B ∧
      ∀ t s, ∃ a : ℤ, |(q : ℝ) * ((q₀ : ℝ) * γ j j' t s + (q₀ : ℝ) * γ j j' s t) - (a : ℝ)|
        ≤ B * ε₂ / (S : ℝ) ^ 2 := by
    intro j j'
    obtain ⟨q, hq1, hqB, hqa⟩ := hQd S δ ε₂
      (-((q₀ : ℝ) * ∑ i, ∑ i', (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * A i i'
                  * (((∑ t, z' t • Mt t) i' j' : ℤ) : ℝ))) G
      (fun t s => (q₀ : ℝ) * γ j j' t s) hS hδ hδ1 hε₂ hε₂q (hBq.trans hSB) hG hcard (by
        intro z hz
        obtain ⟨a, ha⟩ := hquad z hz j j'
        refine ⟨a, ?_⟩
        have e1 : -((q₀ : ℝ) * ∑ i, ∑ i', (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * A i i'
                  * (((∑ t, z' t • Mt t) i' j' : ℤ) : ℝ))
              + ∑ l, ∑ l', (q₀ : ℝ) * γ j j' l l' * ((z l : ℤ) : ℝ) * ((z l' : ℤ) : ℝ)
            = (q₀ : ℝ) * (∑ i, ∑ i', (((∑ t, z t • Mt t) i j : ℤ) : ℝ) * A i i'
                  * (((∑ t, z t • Mt t) i' j' : ℤ) : ℝ)
              - ∑ i, ∑ i', (((∑ t, z' t • Mt t) i j : ℤ) : ℝ) * A i i'
                  * (((∑ t, z' t • Mt t) i' j' : ℤ) : ℝ)) := by
          rw [hexp2 z j j', mul_sub, Finset.mul_sum]
          simp only [Finset.mul_sum, mul_assoc]
          ring
        rw [e1]; exact ha)
    refine ⟨q, hq1, hqB.trans hBq, fun t s => ?_⟩
    obtain ⟨a, ha⟩ := hqa t s
    refine ⟨a, ha.trans ?_⟩
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hBq hε₂) (by positivity)
  choose qL hqL1 hqLB hqLa using hlinq
  choose qQ hqQ1 hqQB hqQa using hquadq
  
  obtain ⟨Q, hQ⟩ : ∃ Q : ℕ, Q = (∏ j, qL j) * ∏ j, ∏ j', qQ j j' := ⟨_, rfl⟩
  have hQ1 : 1 ≤ Q := by
    rw [hQ, Nat.one_le_iff_ne_zero]
    refine mul_ne_zero ?_ ?_
    · exact Finset.prod_ne_zero_iff.mpr fun j _ => by have := hqL1 j; omega
    · exact Finset.prod_ne_zero_iff.mpr fun j _ =>
        Finset.prod_ne_zero_iff.mpr fun j' _ => by have := hqQ1 j j'; omega
  have hQB : (Q : ℝ) ≤ B ^ (ν + ν * ν) := by
    rw [hQ]
    push_cast
    have h1 : ∏ j, (qL j : ℝ) ≤ B ^ ν := by
      calc ∏ j, (qL j : ℝ) ≤ ∏ _j : Fin ν, B :=
            Finset.prod_le_prod (fun j _ => Nat.cast_nonneg _) (fun j _ => hqLB j)
        _ = B ^ ν := by simp
    have h2 : ∏ j, ∏ j', (qQ j j' : ℝ) ≤ (B ^ ν) ^ ν := by
      calc ∏ j, ∏ j', (qQ j j' : ℝ) ≤ ∏ _j : Fin ν, ∏ _j' : Fin ν, B :=
            Finset.prod_le_prod (fun j _ => Finset.prod_nonneg fun j' _ => Nat.cast_nonneg _)
              (fun j _ => Finset.prod_le_prod (fun j' _ => Nat.cast_nonneg _)
                (fun j' _ => hqQB j j'))
        _ = (B ^ ν) ^ ν := by simp
    calc (∏ j, (qL j : ℝ)) * ∏ j, ∏ j', (qQ j j' : ℝ) ≤ B ^ ν * (B ^ ν) ^ ν :=
          mul_le_mul h1 h2 (Finset.prod_nonneg fun j _ => Finset.prod_nonneg fun j' _ =>
            Nat.cast_nonneg _) (pow_nonneg hB0 _)
      _ = B ^ (ν + ν * ν) := by rw [← pow_mul, ← pow_add]
  have hQAv : (Q : ℝ) ≤ (Cv / δ) ^ (A' * (ν + ν * ν + 1)) := by
    rw [← hBAv]
    calc (Q : ℝ) ≤ B ^ (ν + ν * ν) := hQB
      _ ≤ B ^ (ν + ν * ν) * B := le_mul_of_one_le_right (pow_nonneg hB0 _) hB1
  have hlinQ : ∀ j t, ∃ b : ℤ, |(Q : ℝ) * ((q₀ : ℝ) * β t j) - (b : ℝ)|
      ≤ (Cv / δ) ^ (A' * (ν + ν * ν + 1)) * ε₁ / S := by
    intro j t
    have hdvd : qL j ∣ Q := by
      rw [hQ]; exact Dvd.dvd.mul_right (Finset.dvd_prod_of_mem _ (Finset.mem_univ j)) _
    obtain ⟨b, hb⟩ := hdiv (qL j) Q _ (B * ε₁ / S) hdvd (hqL1 j)
      (div_nonneg (mul_nonneg hB0 hε₁) hSpos.le) (hqLa j t)
    refine ⟨b, hb.trans ?_⟩
    rw [← hBAv]
    calc (Q : ℝ) * (B * ε₁ / S) ≤ B ^ (ν + ν * ν) * (B * ε₁ / S) :=
          mul_le_mul_of_nonneg_right hQB (div_nonneg (mul_nonneg hB0 hε₁) hSpos.le)
      _ = B ^ (ν + ν * ν) * B * ε₁ / S := by ring
  have hquadQ : ∀ j j' t s, ∃ a : ℤ,
      |(Q : ℝ) * ((q₀ : ℝ) * γ j j' t s + (q₀ : ℝ) * γ j j' s t) - (a : ℝ)|
        ≤ (Cv / δ) ^ (A' * (ν + ν * ν + 1)) * ε₂ / (S : ℝ) ^ 2 := by
    intro j j' t s
    have hdvd : qQ j j' ∣ Q := by
      rw [hQ]
      exact Dvd.dvd.mul_left (dvd_trans
        (Finset.dvd_prod_of_mem (fun j' => qQ j j') (Finset.mem_univ j'))
        (Finset.dvd_prod_of_mem (fun j => ∏ j', qQ j j') (Finset.mem_univ j))) _
    have he0 : 0 ≤ B * ε₂ / (S : ℝ) ^ 2 := div_nonneg (mul_nonneg hB0 hε₂) (by positivity)
    obtain ⟨a, ha⟩ := hdiv (qQ j j') Q _ (B * ε₂ / (S : ℝ) ^ 2) hdvd (hqQ1 j j') he0
      (hqQa j j' t s)
    refine ⟨a, ha.trans ?_⟩
    rw [← hBAv]
    calc (Q : ℝ) * (B * ε₂ / (S : ℝ) ^ 2) ≤ B ^ (ν + ν * ν) * (B * ε₂ / (S : ℝ) ^ 2) :=
          mul_le_mul_of_nonneg_right hQB he0
      _ = B ^ (ν + ν * ν) * B * ε₂ / (S : ℝ) ^ 2 := by ring
  refine ⟨Q, hQ1, hQAv, ?_, ?_⟩
  · intro j
    obtain ⟨b, hb⟩ := hcomb (fun t => (Q : ℝ) * ((q₀ : ℝ) * β t j)) _ (hlinQ j)
    refine ⟨b, ?_⟩
    have e1 : (Q : ℝ) * (q₀ : ℝ) * lam j
        = ∑ t, ((c t : ℤ) : ℝ) * ((Q : ℝ) * ((q₀ : ℝ) * β t j)) := by
      rw [hexp3 j, Finset.mul_sum]
      exact Finset.sum_congr rfl fun t _ => by ring
    rw [e1]
    refine hb.trans (le_of_eq ?_)
    ring
  · intro j j'
    have hinner : ∀ t, ∃ a : ℤ,
        |∑ s, ((c s : ℤ) : ℝ) * ((Q : ℝ) * ((q₀ : ℝ) * γ j j' t s + (q₀ : ℝ) * γ j j' s t))
          - (a : ℝ)|
          ≤ (∑ t, |((c t : ℤ) : ℝ)|) * ((Cv / δ) ^ (A' * (ν + ν * ν + 1)) * ε₂ / (S : ℝ) ^ 2) :=
      fun t => hcomb _ _ (hquadQ j j' t)
    obtain ⟨a, ha⟩ := hcomb _ _ hinner
    refine ⟨a, ?_⟩
    have h2 : ∑ t, ∑ s, ((c t : ℤ) : ℝ) * ((c s : ℤ) : ℝ) * γ j j' s t
        = ∑ t, ∑ s, γ j j' t s * ((c t : ℤ) : ℝ) * ((c s : ℤ) : ℝ) := by
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun s _ => by ring
    have e1 : 2 * (Q : ℝ) * (q₀ : ℝ) * A j j'
        = ∑ t, ((c t : ℤ) : ℝ) * ∑ s, ((c s : ℤ) : ℝ)
            * ((Q : ℝ) * ((q₀ : ℝ) * γ j j' t s + (q₀ : ℝ) * γ j j' s t)) := by
      calc 2 * (Q : ℝ) * (q₀ : ℝ) * A j j'
          = (Q : ℝ) * (q₀ : ℝ) * (∑ t, ∑ s, γ j j' t s * ((c t : ℤ) : ℝ) * ((c s : ℤ) : ℝ))
            + (Q : ℝ) * (q₀ : ℝ)
              * (∑ t, ∑ s, ((c t : ℤ) : ℝ) * ((c s : ℤ) : ℝ) * γ j j' s t) := by
            rw [h2, ← hexp4]; ring
        _ = _ := by
            simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun s _ => by ring
    rw [e1]
    refine ha.trans (le_of_eq ?_)
    ring

theorem kai_bilinear_cs {α β : Type*} (Y : Finset α) (W : Finset β) (a : α → ℂ) (b : β → ℂ)
    (g : β → α → ℂ) (hb : ∀ w, ‖b w‖ ≤ 1) :
    ‖∑ y ∈ Y, ∑ w ∈ W, a y * b w * g w y‖ ^ 2 ≤
      (∑ y ∈ Y, ‖a y‖ ^ 2) *
        ∑ w ∈ W, ∑ w' ∈ W, ‖∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y)‖ :=
by
  obtain ⟨F, hF⟩ : ∃ F : α → ℂ, F = fun y => ∑ w ∈ W, b w * g w y := ⟨_, rfl⟩
  have h1 : ∑ y ∈ Y, ∑ w ∈ W, a y * b w * g w y = ∑ y ∈ Y, a y * F y := by
    refine Finset.sum_congr rfl fun y _ => ?_
    rw [hF, Finset.mul_sum]
    refine Finset.sum_congr rfl fun w _ => ?_
    ring
  have h2 : ‖∑ y ∈ Y, a y * F y‖ ≤ ∑ y ∈ Y, ‖a y‖ * ‖F y‖ := by
    refine (norm_sum_le _ _).trans (le_of_eq ?_)
    exact Finset.sum_congr rfl fun y _ => norm_mul _ _
  have h3 : (∑ y ∈ Y, ‖a y‖ * ‖F y‖) ^ 2 ≤ (∑ y ∈ Y, ‖a y‖ ^ 2) * ∑ y ∈ Y, ‖F y‖ ^ 2 :=
    Finset.sum_mul_sq_le_sq_mul_sq _ _ _
  have h4 : (((∑ y ∈ Y, ‖F y‖ ^ 2 : ℝ)) : ℂ) = ∑ w ∈ W, ∑ w' ∈ W,
      b w * (starRingEnd ℂ) (b w') * ∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y) := by
    have hy : ∀ y, ((‖F y‖ ^ 2 : ℝ) : ℂ) = ∑ w ∈ W, ∑ w' ∈ W,
        b w * (starRingEnd ℂ) (b w') * (g w y * (starRingEnd ℂ) (g w' y)) := by
      intro y
      have e : ((‖F y‖ ^ 2 : ℝ) : ℂ) = F y * (starRingEnd ℂ) (F y) := by
        rw [Complex.mul_conj']; push_cast; rfl
      rw [e, hF]
      simp only [map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun w _ => Finset.sum_congr rfl fun w' _ => ?_
      ring
    rw [Complex.ofReal_sum]
    simp only [hy]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun w _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun w' _ => ?_
    rw [Finset.mul_sum]
  have h5 : ∑ y ∈ Y, ‖F y‖ ^ 2 ≤
      ∑ w ∈ W, ∑ w' ∈ W, ‖∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y)‖ := by
    have hnn : 0 ≤ ∑ y ∈ Y, ‖F y‖ ^ 2 := Finset.sum_nonneg fun _ _ => by positivity
    calc ∑ y ∈ Y, ‖F y‖ ^ 2 = ‖(((∑ y ∈ Y, ‖F y‖ ^ 2 : ℝ)) : ℂ)‖ := by
          rw [Complex.norm_real, Real.norm_of_nonneg hnn]
      _ = ‖∑ w ∈ W, ∑ w' ∈ W,
          b w * (starRingEnd ℂ) (b w') * ∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y)‖ := by
          rw [h4]
      _ ≤ ∑ w ∈ W, ∑ w' ∈ W,
          ‖b w * (starRingEnd ℂ) (b w') * ∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y)‖ :=
          (norm_sum_le _ _).trans (Finset.sum_le_sum fun w _ => norm_sum_le _ _)
      _ ≤ ∑ w ∈ W, ∑ w' ∈ W, ‖∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y)‖ := by
          refine Finset.sum_le_sum fun w _ => Finset.sum_le_sum fun w' _ => ?_
          rw [norm_mul, norm_mul, Complex.norm_conj]
          have hbb : ‖b w‖ * ‖b w'‖ ≤ 1 := mul_le_one₀ (hb w) (norm_nonneg _) (hb w')
          calc ‖b w‖ * ‖b w'‖ * ‖∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y)‖
              ≤ 1 * ‖∑ y ∈ Y, g w y * (starRingEnd ℂ) (g w' y)‖ :=
                mul_le_mul_of_nonneg_right hbb (norm_nonneg _)
            _ = _ := one_mul _
  rw [h1]
  calc ‖∑ y ∈ Y, a y * F y‖ ^ 2 ≤ (∑ y ∈ Y, ‖a y‖ * ‖F y‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h2 2
    _ ≤ (∑ y ∈ Y, ‖a y‖ ^ 2) * ∑ y ∈ Y, ‖F y‖ ^ 2 := h3
    _ ≤ _ := mul_le_mul_of_nonneg_left h5 (Finset.sum_nonneg fun _ _ => by positivity)

theorem kai_pair_pigeonhole {β : Type*} (W : Finset β) (I : β → β → ℝ) (P : β → β → ℕ → Prop)
    (Ymax L θ' T : ℝ) (hY : 0 < Ymax) (hL : 0 < L) (hθ : 0 < θ') (hT : 1 ≤ T)
    (hWL : (W.card : ℝ) ≤ L) (hI : ∀ w ∈ W, ∀ w' ∈ W, I w w' ≤ Ymax)
    (hsum : θ' * Ymax * L ^ 2 ≤ ∑ w ∈ W, ∑ w' ∈ W, I w w')
    (hq : ∀ w ∈ W, ∀ w' ∈ W, θ' / 2 * Ymax ≤ I w w' →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ T ∧ P w w' q) :
    ∃ w' ∈ W, ∃ q₀ : ℕ, 1 ≤ q₀ ∧ (q₀ : ℝ) ≤ T ∧
      ∃ G₀ : Finset β, G₀ ⊆ W ∧ θ' / (2 * T) * L ≤ (G₀.card : ℝ) ∧ ∀ w ∈ G₀, P w w' q₀ :=
by
  classical
  choose! Q hQ using hq
  obtain ⟨S, hS⟩ : ∃ S : Finset (β × β),
      S = (W ×ˢ W).filter (fun p => θ' / 2 * Ymax ≤ I p.1 p.2) := ⟨_, rfl⟩
  have hmemS : ∀ p, p ∈ S ↔ (p.1 ∈ W ∧ p.2 ∈ W) ∧ θ' / 2 * Ymax ≤ I p.1 p.2 := by
    intro p; rw [hS, Finset.mem_filter, Finset.mem_product]
  have hTpos : 0 < T := by linarith
  have hTne : T ≠ 0 := hTpos.ne'
  
  have hcount : θ' / 2 * L ^ 2 ≤ (S.card : ℝ) := by
    have h1 : ∑ w ∈ W, ∑ w' ∈ W, I w w' = ∑ p ∈ W ×ˢ W, I p.1 p.2 :=
      (Finset.sum_product' _ _ _).symm
    have h2 : ∑ p ∈ W ×ˢ W, I p.1 p.2 ≤ ∑ p ∈ W ×ˢ W,
        (Ymax * (if θ' / 2 * Ymax ≤ I p.1 p.2 then (1 : ℝ) else 0) + θ' / 2 * Ymax) := by
      apply Finset.sum_le_sum
      intro p hp
      rw [Finset.mem_product] at hp
      have hc : 0 < θ' / 2 * Ymax := by positivity
      split_ifs with h
      · have := hI p.1 hp.1 p.2 hp.2; linarith
      · push_neg at h; linarith
    have h3 : ∑ p ∈ W ×ˢ W,
        (Ymax * (if θ' / 2 * Ymax ≤ I p.1 p.2 then (1 : ℝ) else 0) + θ' / 2 * Ymax)
        = Ymax * (S.card : ℝ) + (W.card : ℝ) ^ 2 * (θ' / 2 * Ymax) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_boole, ← hS, Finset.sum_const,
        Finset.card_product, nsmul_eq_mul]
      push_cast; ring
    have hW0 : (0 : ℝ) ≤ W.card := Nat.cast_nonneg _
    have hW2 : (W.card : ℝ) ^ 2 ≤ L ^ 2 := pow_le_pow_left₀ hW0 hWL 2
    have h4 : (W.card : ℝ) ^ 2 * (θ' / 2 * Ymax) ≤ L ^ 2 * (θ' / 2 * Ymax) :=
      mul_le_mul_of_nonneg_right hW2 (by positivity)
    have h5 : θ' / 2 * L ^ 2 * Ymax ≤ (S.card : ℝ) * Ymax := by nlinarith
    exact le_of_mul_le_mul_right h5 hY
  
  have hmaps : ∀ p ∈ S, (fun p : β × β => (p.2, Q p.1 p.2)) p ∈ W ×ˢ Finset.Icc 1 ⌊T⌋₊ := by
    intro p hp
    rw [hmemS] at hp
    obtain ⟨h1, h2, _⟩ := hQ p.1 hp.1.1 p.2 hp.1.2 hp.2
    simp only [Finset.mem_product, Finset.mem_Icc]
    exact ⟨hp.1.2, h1, Nat.le_floor h2⟩
  have hSpos : 0 < S.card := by
    have : (0 : ℝ) < S.card := lt_of_lt_of_le (by positivity) hcount
    exact_mod_cast this
  obtain ⟨p₀, hp₀⟩ := Finset.card_pos.mp hSpos
  have htne : (W ×ˢ Finset.Icc 1 ⌊T⌋₊).Nonempty := ⟨_, hmaps p₀ hp₀⟩
  have hfl : (⌊T⌋₊ : ℝ) ≤ T := Nat.floor_le hTpos.le
  have htcard : ((W ×ˢ Finset.Icc 1 ⌊T⌋₊).card : ℝ) ≤ L * T := by
    rw [Finset.card_product, Nat.card_Icc, Nat.add_sub_cancel]
    push_cast
    exact mul_le_mul hWL hfl (Nat.cast_nonneg _) hL.le
  have hbpos : 0 ≤ θ' / (2 * T) * L := (mul_pos (div_pos hθ (by linarith)) hL).le
  have hb : (W ×ˢ Finset.Icc 1 ⌊T⌋₊).card • (θ' / (2 * T) * L) ≤ (S.card : ℝ) := by
    rw [nsmul_eq_mul]
    calc ((W ×ˢ Finset.Icc 1 ⌊T⌋₊).card : ℝ) * (θ' / (2 * T) * L)
        ≤ (L * T) * (θ' / (2 * T) * L) := mul_le_mul_of_nonneg_right htcard hbpos
      _ = θ' / 2 * L ^ 2 := by field_simp
      _ ≤ S.card := hcount
  obtain ⟨⟨w', q₀⟩, hy, hfib⟩ :=
    Finset.exists_le_card_fiber_of_nsmul_le_card_of_maps_to hmaps htne hb
  simp only [Finset.mem_product, Finset.mem_Icc] at hy
  obtain ⟨hw', hq1, hqn⟩ := hy
  refine ⟨w', hw', q₀, hq1, (Nat.le_floor_iff hTpos.le).mp hqn,
    (S.filter (fun p => (fun p : β × β => (p.2, Q p.1 p.2)) p = (w', q₀))).image Prod.fst,
    ?_, ?_, ?_⟩
  · intro w hw
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hw
    exact ((hmemS p).mp (Finset.mem_filter.mp hp).1).1.1
  · rw [Finset.card_image_of_injOn]
    · exact hfib
    · intro p hp p' hp' hpp
      have e1 := (Finset.mem_filter.mp hp).2
      have e2 := (Finset.mem_filter.mp hp').2
      simp only [Prod.mk.injEq] at e1 e2
      exact Prod.ext hpp (e1.1.trans e2.1.symm)
  · intro w hw
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hw
    obtain ⟨hpS, hpf⟩ := Finset.mem_filter.mp hp
    simp only [Prod.mk.injEq] at hpf
    have hm := (hmemS p).mp hpS
    obtain ⟨_, _, hP⟩ := hQ p.1 hm.1.1 p.2 hm.1.2 hm.2
    rw [hpf.2, hpf.1] at hP
    exact hP

theorem kai_bilinear_pair_identity (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (R : ℝ) (L : ℕ) (p₀ : ℝ) (p₁ : Fin (Module.finrank ℚ K) → ℝ)
    (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ)
    (w w' : NumberField.RingOfIntegers K) :
    ∑ y ∈ omegaBox ω R,
        (@ite ℂ (ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) L) (Classical.propDecidable _)
            (giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun (y * w)))) 0)
        * (starRingEnd ℂ) (@ite ℂ (ω.equivFun (y * w') ∈ intBox (Module.finrank ℚ K) L)
            (Classical.propDecidable _) (giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun (y * w')))) 0)
      = ∑ u ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
            (fun u => (fun j => ((u j : ℤ) : ℝ)) ∈
              {x : Fin (Module.finrank ℚ K) → ℝ | ∀ j,
                |∑ i, ((Algebra.leftMulMatrix ω w j i : ℤ) : ℝ) * x i| ≤ (L : ℝ) ∧
                |∑ i, ((Algebra.leftMulMatrix ω w' j i : ℤ) : ℝ) * x i| ≤ (L : ℝ)})
            (fun _ => Classical.propDecidable _) (intBox (Module.finrank ℚ K) ⌊R⌋₊),
          giE (kaiQuadPoly 0
            (fun l => ∑ j, ((Algebra.leftMulMatrix ω w j l : ℤ) : ℝ) * p₁ j
                - ∑ j, ((Algebra.leftMulMatrix ω w' j l : ℤ) : ℝ) * p₁ j)
            (fun l l' => ∑ j, ∑ j', ((Algebra.leftMulMatrix ω w j l : ℤ) : ℝ) * p₂ j j'
                  * ((Algebra.leftMulMatrix ω w j' l' : ℤ) : ℝ)
                - ∑ j, ∑ j', ((Algebra.leftMulMatrix ω w' j l : ℤ) : ℝ) * p₂ j j'
                  * ((Algebra.leftMulMatrix ω w' j' l' : ℤ) : ℝ)) u) :=
by
  classical
  
  have hreindex : ∀ (f : NumberField.RingOfIntegers K → ℂ),
      ∑ y ∈ omegaBox ω R, f y
        = ∑ u ∈ intBox (Module.finrank ℚ K) ⌊R⌋₊, f (ω.equivFun.symm u) := by
    intro f
    unfold omegaBox
    convert Finset.sum_image (f := f) (s := intBox (Module.finrank ℚ K) ⌊R⌋₊)
      (g := fun v => ω.equivFun.symm v) (fun x _ y _ h => ω.equivFun.symm.injective h)
  
  have hmv : ∀ (x : NumberField.RingOfIntegers K) (u : Fin (Module.finrank ℚ K) → ℤ),
      ω.equivFun (ω.equivFun.symm u * x) = (Algebra.leftMulMatrix ω x).mulVec u := by
    intro x u
    rw [mul_comm, Module.Basis.equivFun_apply, ← Algebra.leftMulMatrix_mulVec_repr,
      ← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
  
  have h4 : ∀ F : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) →
      Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ,
      ∑ j, ∑ j', ∑ l, ∑ l', F j j' l l' = ∑ l, ∑ l', ∑ j, ∑ j', F j j' l l' := by
    intro F
    calc ∑ j, ∑ j', ∑ l, ∑ l', F j j' l l' = ∑ j, ∑ l, ∑ j', ∑ l', F j j' l l' :=
          Finset.sum_congr rfl (fun j _ => Finset.sum_comm)
      _ = ∑ l, ∑ j, ∑ j', ∑ l', F j j' l l' := Finset.sum_comm
      _ = ∑ l, ∑ j, ∑ l', ∑ j', F j j' l l' :=
          Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun j _ => Finset.sum_comm))
      _ = ∑ l, ∑ l', ∑ j, ∑ j', F j j' l l' :=
          Finset.sum_congr rfl (fun l _ => Finset.sum_comm)
  have hsubst : ∀ (M : Matrix (Fin (Module.finrank ℚ K)) (Fin (Module.finrank ℚ K)) ℤ)
      (u : Fin (Module.finrank ℚ K) → ℤ),
      kaiQuadPoly p₀ p₁ p₂ (M.mulVec u)
        = kaiQuadPoly p₀ (fun l => ∑ j, ((M j l : ℤ) : ℝ) * p₁ j)
            (fun l l' => ∑ j, ∑ j', ((M j l : ℤ) : ℝ) * p₂ j j' * ((M j' l' : ℤ) : ℝ)) u := by
    intro M u
    have hv : ∀ j, (((M.mulVec u) j : ℤ) : ℝ) = ∑ l, ((M j l : ℤ) : ℝ) * ((u l : ℤ) : ℝ) := by
      intro j
      simp [Matrix.mulVec, dotProduct]
    have hlin : ∑ j, p₁ j * ∑ l, ((M j l : ℤ) : ℝ) * ((u l : ℤ) : ℝ)
        = ∑ l, (∑ j, ((M j l : ℤ) : ℝ) * p₁ j) * ((u l : ℤ) : ℝ) := by
      simp only [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
    have e1 : ∀ j j', p₂ j j' * (∑ l, ((M j l : ℤ) : ℝ) * ((u l : ℤ) : ℝ))
          * (∑ l', ((M j' l' : ℤ) : ℝ) * ((u l' : ℤ) : ℝ))
        = ∑ l, ∑ l', ((M j l : ℤ) : ℝ) * p₂ j j' * ((M j' l' : ℤ) : ℝ)
            * ((u l : ℤ) : ℝ) * ((u l' : ℤ) : ℝ) := by
      intro j j'
      rw [mul_assoc, Finset.sum_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      simp only [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun l' _ => by ring)
    have e2 : ∀ l l', (∑ j, ∑ j', ((M j l : ℤ) : ℝ) * p₂ j j' * ((M j' l' : ℤ) : ℝ))
          * ((u l : ℤ) : ℝ) * ((u l' : ℤ) : ℝ)
        = ∑ j, ∑ j', ((M j l : ℤ) : ℝ) * p₂ j j' * ((M j' l' : ℤ) : ℝ)
            * ((u l : ℤ) : ℝ) * ((u l' : ℤ) : ℝ) := by
      intro l l'
      simp only [Finset.sum_mul]
    have hquad : ∑ j, ∑ j', p₂ j j' * (∑ l, ((M j l : ℤ) : ℝ) * ((u l : ℤ) : ℝ))
          * (∑ l', ((M j' l' : ℤ) : ℝ) * ((u l' : ℤ) : ℝ))
        = ∑ l, ∑ l', (∑ j, ∑ j', ((M j l : ℤ) : ℝ) * p₂ j j' * ((M j' l' : ℤ) : ℝ))
            * ((u l : ℤ) : ℝ) * ((u l' : ℤ) : ℝ) := by
      simp only [e1, e2]
      exact h4 (fun j j' l l' => ((M j l : ℤ) : ℝ) * p₂ j j' * ((M j' l' : ℤ) : ℝ)
            * ((u l : ℤ) : ℝ) * ((u l' : ℤ) : ℝ))
    unfold kaiQuadPoly
    simp only [hv]
    rw [hlin, hquad]
  
  have hsub : ∀ (a₁ b₁ : Fin (Module.finrank ℚ K) → ℝ)
      (a₂ b₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ)
      (u : Fin (Module.finrank ℚ K) → ℤ),
      kaiQuadPoly p₀ a₁ a₂ u - kaiQuadPoly p₀ b₁ b₂ u
        = kaiQuadPoly 0 (fun l => a₁ l - b₁ l) (fun l l' => a₂ l l' - b₂ l l') u := by
    intro a₁ b₁ a₂ b₂ u
    simp only [kaiQuadPoly, sub_mul, Finset.sum_sub_distrib]
    ring
  
  have hconj : ∀ a b : ℝ, giE a * (starRingEnd ℂ) (giE b) = giE (a - b) := by
    intro a b
    simp only [giE]
    rw [← Complex.exp_conj, ← Complex.exp_add]
    congr 1
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
    push_cast
    ring
  
  have hbox : ∀ (M : Matrix (Fin (Module.finrank ℚ K)) (Fin (Module.finrank ℚ K)) ℤ)
      (u : Fin (Module.finrank ℚ K) → ℤ),
      M.mulVec u ∈ intBox (Module.finrank ℚ K) L
        ↔ ∀ j, |∑ i, ((M j i : ℤ) : ℝ) * ((u i : ℤ) : ℝ)| ≤ (L : ℝ) := by
    intro M u
    simp only [intBox, Finset.mem_Icc, Pi.le_def, ← forall_and]
    refine forall_congr' (fun j => ?_)
    have hj : (((M.mulVec u) j : ℤ) : ℝ) = ∑ i, ((M j i : ℤ) : ℝ) * ((u i : ℤ) : ℝ) := by
      simp [Matrix.mulVec, dotProduct]
    rw [abs_le, ← hj]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨by exact_mod_cast h1, by exact_mod_cast h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨by exact_mod_cast h1, by exact_mod_cast h2⟩
  
  rw [hreindex, Finset.sum_filter]
  refine Finset.sum_congr rfl (fun u _ => ?_)
  rw [hmv w u, hmv w' u]
  have hΩ : (fun j => ((u j : ℤ) : ℝ)) ∈
      {x : Fin (Module.finrank ℚ K) → ℝ | ∀ j,
        |∑ i, ((Algebra.leftMulMatrix ω w j i : ℤ) : ℝ) * x i| ≤ (L : ℝ) ∧
        |∑ i, ((Algebra.leftMulMatrix ω w' j i : ℤ) : ℝ) * x i| ≤ (L : ℝ)}
      ↔ ((Algebra.leftMulMatrix ω w).mulVec u ∈ intBox (Module.finrank ℚ K) L ∧
        (Algebra.leftMulMatrix ω w').mulVec u ∈ intBox (Module.finrank ℚ K) L) := by
    rw [hbox, hbox, Set.mem_setOf_eq, forall_and]
  by_cases h1 : (Algebra.leftMulMatrix ω w).mulVec u ∈ intBox (Module.finrank ℚ K) L
  · by_cases h2 : (Algebra.leftMulMatrix ω w').mulVec u ∈ intBox (Module.finrank ℚ K) L
    · rw [if_pos h1, if_pos h2, if_pos (hΩ.2 ⟨h1, h2⟩), hconj, hsubst, hsubst, hsub]
    · rw [if_pos h1, if_neg h2, if_neg (fun h => h2 (hΩ.1 h).2), map_zero, mul_zero]
  · rw [if_neg h1, if_neg (fun h => h1 (hΩ.1 h).1), zero_mul]

theorem kai_leftMulMatrix_coords {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) :
    (∀ y w : NumberField.RingOfIntegers K,
      ω.equivFun (y * w) = (Algebra.leftMulMatrix ω w).mulVec (ω.equivFun y)) ∧
    (∀ w : NumberField.RingOfIntegers K,
      ∑ t, (ω.equivFun w t) • Algebra.leftMulMatrix ω (ω t) = Algebra.leftMulMatrix ω w) ∧
    ∑ t, (ω.equivFun 1 t) • Algebra.leftMulMatrix ω (ω t) = 1 :=
by
  have h2 : ∀ w : NumberField.RingOfIntegers K,
      ∑ t, (ω.equivFun w t) • Algebra.leftMulMatrix ω (ω t) = Algebra.leftMulMatrix ω w := by
    intro w
    conv_rhs => rw [← ω.sum_equivFun w]
    rw [map_sum]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [map_zsmul]
  refine ⟨?_, h2, ?_⟩
  · intro y w
    rw [Module.Basis.equivFun_apply, Module.Basis.equivFun_apply,
      Algebra.leftMulMatrix_mulVec_repr, mul_comm]
  · rw [h2, map_one]

theorem kai_balanced_in_box (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (cb s : ℝ) (hcb : 1 ≤ cb) (hs : 0 < s)
    (w : NumberField.RingOfIntegers K)
    (hw : ∀ v : NumberField.InfinitePlace K, v ((w : NumberField.RingOfIntegers K) : K) ≤ cb * s) :
    ω.equivFun w ∈ intBox (Module.finrank ℚ K) ⌊C * cb * s⌋₊ :=
by
  have hC : 0 < C := lt_trans zero_lt_one hω.1
  have hcbs : 0 < cb * s := mul_pos (by linarith) hs
  have hcan : canNorm K (algebraMap (NumberField.RingOfIntegers K) K w) ≤ cb * s := by
    unfold canNorm
    exact Real.iSup_le (fun v => hw v) hcbs.le
  have hbsn : basisSupNorm ω w ≤ C * cb * s := by
    have h1 := ((hω.2 w).1).trans hcan
    rw [inv_mul_le_iff₀ hC] at h1
    linarith [h1, show C * (cb * s) = C * cb * s by ring]
  have hcoord : ∀ j, |((ω.repr w j : ℤ) : ℝ)| ≤ C * cb * s := by
    intro j
    refine le_trans ?_ hbsn
    unfold basisSupNorm
    exact le_ciSup (f := fun j => |((ω.repr w j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  have hnat : ∀ j, (ω.repr w j).natAbs ≤ ⌊C * cb * s⌋₊ := by
    intro j
    apply Nat.le_floor
    rw [Nat.cast_natAbs, Int.cast_abs]
    exact hcoord j
  unfold intBox
  rw [Finset.mem_Icc]
  constructor
  · intro j
    have h := hnat j
    simp only [Module.Basis.equivFun_apply]
    omega
  · intro j
    have h := hnat j
    simp only [Module.Basis.equivFun_apply]
    omega

theorem kai_slab_convex (ν : ℕ) (A₁ A₂ : Fin ν → Fin ν → ℝ) (c : ℝ) :
    Convex ℝ {x : Fin ν → ℝ | ∀ j, |∑ i, A₁ j i * x i| ≤ c ∧ |∑ i, A₂ j i * x i| ≤ c} :=
by
  have key : ∀ (A : Fin ν → Fin ν → ℝ) (j : Fin ν) (x y : Fin ν → ℝ) (a b : ℝ),
      0 ≤ a → 0 ≤ b → a + b = 1 →
      |∑ i, A j i * x i| ≤ c → |∑ i, A j i * y i| ≤ c →
      |∑ i, A j i * (a • x + b • y) i| ≤ c := by
    intro A j x y a b ha hb hab hx hy
    have hsum : ∑ i, A j i * (a • x + b • y) i
        = a * ∑ i, A j i * x i + b * ∑ i, A j i * y i := by
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.mul_sum,
        ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      ring
    rw [hsum]
    calc |a * ∑ i, A j i * x i + b * ∑ i, A j i * y i|
        ≤ |a * ∑ i, A j i * x i| + |b * ∑ i, A j i * y i| := abs_add_le _ _
      _ = a * |∑ i, A j i * x i| + b * |∑ i, A j i * y i| := by
          rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      _ ≤ a * c + b * c :=
          add_le_add (mul_le_mul_of_nonneg_left hx ha) (mul_le_mul_of_nonneg_left hy hb)
      _ = c := by rw [← add_mul, hab, one_mul]
  intro x hx y hy a b ha hb hab
  intro j
  exact ⟨key A₁ j x y a b ha hb hab (hx j).1 (hy j).1,
    key A₂ j x y a b ha hb hab (hx j).2 (hy j).2⟩

theorem kai_quad_coeff_symm {ν : ℕ} (M : Matrix (Fin ν) (Fin ν) ℤ) (p₂ : Fin ν → Fin ν → ℝ)
    (l l' : Fin ν) :
    (∑ j, ∑ j', ((M j l : ℤ) : ℝ) * p₂ j j' * ((M j' l' : ℤ) : ℝ))
      + (∑ j, ∑ j', ((M j l' : ℤ) : ℝ) * p₂ j j' * ((M j' l : ℤ) : ℝ))
      = ∑ j, ∑ j', ((M j l : ℤ) : ℝ) * (p₂ j j' + p₂ j' j) * ((M j' l' : ℤ) : ℝ) :=
by
  have h : (∑ j, ∑ j', ((M j l' : ℤ) : ℝ) * p₂ j j' * ((M j' l : ℤ) : ℝ))
      = ∑ j, ∑ j', ((M j l : ℤ) : ℝ) * p₂ j' j * ((M j' l' : ℤ) : ℝ) := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun j' _ => by ring))
  rw [h, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl (fun j' _ => by ring)

theorem kai_omegaBox_card {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) :
    ((omegaBox ω M).card : ℝ) = (((2 * ⌊M⌋₊ + 1 : ℕ) : ℝ)) ^ ν :=
by
  classical
  have h1 : (omegaBox ω M).card = (intBox ν ⌊M⌋₊).card := by
    unfold omegaBox
    convert Finset.card_image_of_injective (intBox ν ⌊M⌋₊) ω.equivFun.symm.injective
  have h2 : (intBox ν ⌊M⌋₊).card = (2 * ⌊M⌋₊ + 1) ^ ν := by
    unfold intBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  rw [h1, h2, Nat.cast_pow]

theorem kai_intBox_card (ν S : ℕ) :
    ((intBox ν S).card : ℝ) = (((2 * S + 1 : ℕ) : ℝ)) ^ ν :=
by
  have h2 : (intBox ν S).card = (2 * S + 1) ^ ν := by
    unfold intBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  rw [h2, Nat.cast_pow]

theorem kai_bilinear_constants (n Aw Av : ℕ) (Cw Cv κ₁ c₁ : ℝ) (hAw : 1 ≤ Aw) (hAv : 1 ≤ Av)
    (hCw : 1 ≤ Cw) (hCv : 1 ≤ Cv) (hκ : 1 ≤ κ₁) (hc : 1 ≤ c₁) :
    ∃ (Cb : ℝ) (Ab : ℕ), 1 ≤ Cb ∧ 1 ≤ Ab ∧
      ∀ (m G θ : ℝ), 1 ≤ m → 1 ≤ G → 0 < θ → θ ≤ 1 →
        64 * c₁ ^ 2
            * (Cv / ((θ ^ 2 / (G * (κ₁ * m) ^ (2 * n)))
                / (2 * (Cw / ((θ ^ 2 / (G * (κ₁ * m) ^ (2 * n))) / 2)) ^ Aw))) ^ Av
            * (Cw / ((θ ^ 2 / (G * (κ₁ * m) ^ (2 * n))) / 2)) ^ Aw
          ≤ (Cb * m * G / θ) ^ Ab :=
by
  have hE1 : 1 ≤ (Aw + 1) * Av + Aw := by
    have : Aw ≤ (Aw + 1) * Av + Aw := Nat.le_add_left _ _
    omega
  have hK0 : 1 ≤ 64 * c₁ ^ 2 * (2 * Cv) ^ Av * (2 * Cw) ^ (Aw * Av + Aw) := by
    have h1 : 1 ≤ c₁ ^ 2 := one_le_pow₀ hc
    have h2 : 1 ≤ (2 * Cv) ^ Av := one_le_pow₀ (by linarith)
    have h3 : 1 ≤ (2 * Cw) ^ (Aw * Av + Aw) := one_le_pow₀ (by linarith)
    have h4 : 1 ≤ 64 * c₁ ^ 2 := by linarith
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h4 h2) h3
  have hCb : 1 ≤ 64 * c₁ ^ 2 * (2 * Cv) ^ Av * (2 * Cw) ^ (Aw * Av + Aw)
      * κ₁ ^ (2 * n * ((Aw + 1) * Av + Aw)) :=
    one_le_mul_of_one_le_of_one_le hK0 (one_le_pow₀ hκ)
  have hAb : 1 ≤ (2 * n + 2) * ((Aw + 1) * Av + Aw) := by
    have : 1 ≤ 2 * n + 2 := by omega
    exact Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
  refine ⟨64 * c₁ ^ 2 * (2 * Cv) ^ Av * (2 * Cw) ^ (Aw * Av + Aw)
      * κ₁ ^ (2 * n * ((Aw + 1) * Av + Aw)), (2 * n + 2) * ((Aw + 1) * Av + Aw),
      hCb, hAb, ?_⟩
  intro m G θ hm hG hθ hθ1
  have hδ : 0 < θ ^ 2 / (G * (κ₁ * m) ^ (2 * n)) :=
    div_pos (pow_pos hθ 2)
      (mul_pos (by linarith) (pow_pos (mul_pos (by linarith) (by linarith)) _))
  have hu : 0 < m * G / θ := div_pos (mul_pos (by linarith) (by linarith)) hθ
  set δ := θ ^ 2 / (G * (κ₁ * m) ^ (2 * n)) with hδdef
  set K0 := 64 * c₁ ^ 2 * (2 * Cv) ^ Av * (2 * Cw) ^ (Aw * Av + Aw) with hK0def
  set E := (Aw + 1) * Av + Aw with hEdef
  have h1 : 64 * c₁ ^ 2 * (Cv / (δ / (2 * (Cw / (δ / 2)) ^ Aw))) ^ Av * (Cw / (δ / 2)) ^ Aw
      = K0 * δ⁻¹ ^ E := by
    have hX : Cw / (δ / 2) = 2 * Cw * δ⁻¹ := by rw [div_div_eq_mul_div]; ring
    have hY : Cv / (δ / (2 * (2 * Cw * δ⁻¹) ^ Aw)) = 2 * Cv * (2 * Cw * δ⁻¹) ^ Aw * δ⁻¹ := by
      rw [div_div_eq_mul_div]; ring
    rw [hX, hY, hK0def, hEdef]
    have key : ∀ t : ℝ, 64 * c₁ ^ 2 * (2 * Cv * (2 * Cw * t) ^ Aw * t) ^ Av * (2 * Cw * t) ^ Aw
        = 64 * c₁ ^ 2 * (2 * Cv) ^ Av * (2 * Cw) ^ (Aw * Av + Aw)
          * t ^ ((Aw + 1) * Av + Aw) := by
      intro t
      have hb : (2 * Cw) ^ (Aw * Av + Aw) = ((2 * Cw) ^ Aw) ^ Av * (2 * Cw) ^ Aw := by
        rw [pow_add (2 * Cw) (Aw * Av) Aw, pow_mul (2 * Cw) Aw Av]
      have ht : t ^ ((Aw + 1) * Av + Aw) = (t ^ Aw * t) ^ Av * t ^ Aw := by
        rw [pow_add t ((Aw + 1) * Av) Aw, pow_mul t (Aw + 1) Av, pow_succ t Aw]
      rw [hb, ht, mul_pow (2 * Cw) t Aw]
      generalize (2 * Cw) ^ Aw = b
      generalize t ^ Aw = a
      ring
    exact key δ⁻¹
  have h2 : δ⁻¹ ≤ κ₁ ^ (2 * n) * (m * G / θ) ^ (2 * n + 2) := by
    have hs : 1 ≤ θ⁻¹ := (one_le_inv₀ hθ).2 hθ1
    have e1 : δ⁻¹ = κ₁ ^ (2 * n) * (G * m ^ (2 * n) * θ⁻¹ ^ 2) := by
      rw [hδdef, inv_div, mul_pow]; ring
    have e2 : (m * G / θ) ^ (2 * n + 2) = G ^ (2 * n + 2) * m ^ (2 * n + 2) * θ⁻¹ ^ (2 * n + 2) := by
      ring
    rw [e1, e2]
    apply mul_le_mul_of_nonneg_left _ (pow_nonneg (by linarith) _)
    have a1 : G ≤ G ^ (2 * n + 2) := le_self_pow₀ hG (by omega)
    have a2 : m ^ (2 * n) ≤ m ^ (2 * n + 2) := pow_le_pow_right₀ hm (by omega)
    have a3 : θ⁻¹ ^ 2 ≤ θ⁻¹ ^ (2 * n + 2) := pow_le_pow_right₀ hs (by omega)
    have p1 : 0 ≤ m ^ (2 * n) := pow_nonneg (by linarith) _
    have p2 : 0 ≤ θ⁻¹ ^ 2 := pow_nonneg (by linarith) _
    have p3 : 0 ≤ G ^ (2 * n + 2) := pow_nonneg (by linarith) _
    exact mul_le_mul (mul_le_mul a1 a2 p1 p3) a3 p2 (mul_nonneg p3 (pow_nonneg (by linarith) _))
  have hK0nn : 0 ≤ K0 := by linarith
  have hδinv : 0 ≤ δ⁻¹ := inv_nonneg.2 hδ.le
  rw [h1]
  calc K0 * δ⁻¹ ^ E ≤ K0 * (κ₁ ^ (2 * n) * (m * G / θ) ^ (2 * n + 2)) ^ E :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hδinv h2 E) hK0nn
    _ = K0 * κ₁ ^ (2 * n * E) * (m * G / θ) ^ ((2 * n + 2) * E) := by
        rw [mul_pow, ← pow_mul, ← pow_mul]; ring
    _ ≤ (K0 * κ₁ ^ (2 * n * E)) ^ ((2 * n + 2) * E) * (m * G / θ) ^ ((2 * n + 2) * E) :=
        mul_le_mul_of_nonneg_right (le_self_pow₀ hCb (by omega)) (pow_nonneg hu.le _)
    _ = (K0 * κ₁ ^ (2 * n * E) * m * G / θ) ^ ((2 * n + 2) * E) := by
        rw [← mul_pow]; congr 1; ring

theorem kai_quad_bilinear_inverse (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (cb : ℝ) (hcb : 1 ≤ cb) :
    ∃ (Cb : ℝ) (Ab : ℕ), 1 ≤ Cb ∧ 1 ≤ Ab ∧
      ∀ (m N : ℕ) (s G θ : ℝ) (W : Finset (NumberField.RingOfIntegers K))
        (a b : NumberField.RingOfIntegers K → ℂ) (p₀ : ℝ)
        (p₁ : Fin (Module.finrank ℚ K) → ℝ)
        (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
        1 ≤ m → 1 ≤ N → 1 ≤ s → 1 ≤ G → 0 < θ → θ ≤ 1 →
        (∀ w ∈ W, ∀ v : NumberField.InfinitePlace K,
          s ≤ cb * v ((w : NumberField.RingOfIntegers K) : K) ∧
          v ((w : NumberField.RingOfIntegers K) : K) ≤ cb * s) →
        (∀ w, ‖b w‖ ≤ 1) →
        (∑ y ∈ omegaBox ω (C ^ 2 * cb * m * N / s), ‖a y‖ ^ 2)
          ≤ G * ((omegaBox ω (C ^ 2 * cb * m * N / s)).card : ℝ) →
        (Cb * m * G / θ) ^ Ab ≤ s → (Cb * m * G / θ) ^ Ab * s ≤ (N : ℝ) →
        θ * (((2 * N + 1 : ℕ) : ℝ) ^ Module.finrank ℚ K) ≤
          ‖∑ y ∈ omegaBox ω (C ^ 2 * cb * m * N / s), ∑ w ∈ W,
              a y * b w *
                (@ite ℂ (ω.equivFun (y * w) ∈ intBox (Module.finrank ℚ K) (m * N))
                  (Classical.propDecidable _)
                  (giE (kaiQuadPoly p₀ (fun l => p₁ l / m) (fun l l' => p₂ l l' / (m : ℝ) ^ 2)
                    (ω.equivFun (y * w)))) 0)‖ →
        ∃ q : ℕ, (q : ℝ) ≤ (Cb * m * G / θ) ^ Ab ∧
          KaiQuadMajor (Module.finrank ℚ K) N q ((Cb * m * G / θ) ^ Ab)
            (kaiQuadPoly p₀ p₁ p₂) :=
by
  classical
  obtain ⟨Cw, Aw, hCw, hAw, hweyl⟩ := kai_quad_weyl_inverse (Module.finrank ℚ K)
  obtain ⟨Cv, Av, hCv, hAv, hvino⟩ := kai_bilinear_w_vinogradov (Module.finrank ℚ K)
  obtain ⟨-, hcoord2, hcoord3⟩ := kai_leftMulMatrix_coords ω
  have hC1 : 1 < C := hω.1
  have hC0 : 0 < C := by linarith
  obtain ⟨σc, hσc⟩ : ∃ x : ℝ, x = ∑ t, |((ω.equivFun 1 t : ℤ) : ℝ)| := ⟨_, rfl⟩
  have hσc0 : 0 ≤ σc := by rw [hσc]; exact Finset.sum_nonneg (fun t _ => abs_nonneg _)
  obtain ⟨c₁, hc₁⟩ : ∃ x : ℝ, x = 1 + ∑ t, |((ω.equivFun 1 t : ℤ) : ℝ)| := ⟨_, rfl⟩
  rw [← hσc] at hc₁
  have hc₁1 : 1 ≤ c₁ := by rw [hc₁]; linarith
  have hσc_le : σc ≤ c₁ := by rw [hc₁]; linarith
  have hc₁sq : 1 ≤ c₁ ^ 2 := one_le_pow₀ hc₁1
  obtain ⟨κ₁, hκ₁⟩ : ∃ x : ℝ, x = 9 * C ^ 3 * cb ^ 2 := ⟨_, rfl⟩
  have hC3 : 1 ≤ C ^ 3 := one_le_pow₀ hC1.le
  have hcb2 : 1 ≤ cb ^ 2 := one_le_pow₀ hcb
  have hC3cb2 : 1 ≤ C ^ 3 * cb ^ 2 := one_le_mul_of_one_le_of_one_le hC3 hcb2
  have hκ₁1 : 1 ≤ κ₁ := by rw [hκ₁]; linarith
  obtain ⟨Cb, Ab, hCb, hAb, hconst⟩ := kai_bilinear_constants (Module.finrank ℚ K) Aw Av Cw Cv
    κ₁ c₁ hAw hAv hCw hCv hκ₁1 hc₁1
  refine ⟨Cb, Ab, hCb, hAb, ?_⟩
  intro m N s G θ W a b p₀ p₁ p₂ hm hN hs hG hθ hθ1 hW hb ha hts htN hbig
  have hmR : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hNR : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
  have hmpos : (0 : ℝ) < m := by linarith
  have hNpos : (0 : ℝ) < N := by linarith
  have hmne : (m : ℝ) ≠ 0 := hmpos.ne'
  have hNne : (N : ℝ) ≠ 0 := hNpos.ne'
  have hs0 : 0 < s := by linarith
  have hsne : s ≠ 0 := hs0.ne'
  have hG0 : 0 < G := by linarith
  have hGne : G ≠ 0 := hG0.ne'
  
  obtain ⟨θ₃, hθ₃⟩ : ∃ x : ℝ, x = θ ^ 2 / (G * (κ₁ * (m : ℝ)) ^ (2 * Module.finrank ℚ K)) :=
    ⟨_, rfl⟩
  obtain ⟨T₁, hT₁⟩ : ∃ x : ℝ, x = (Cw / (θ₃ / 2)) ^ Aw := ⟨_, rfl⟩
  obtain ⟨δ₃, hδ₃⟩ : ∃ x : ℝ, x = θ₃ / (2 * T₁) := ⟨_, rfl⟩
  obtain ⟨V, hV⟩ : ∃ x : ℝ, x = (Cv / δ₃) ^ Av := ⟨_, rfl⟩
  obtain ⟨t₀, ht₀⟩ : ∃ x : ℝ, x = (Cb * m * G / θ) ^ Ab := ⟨_, rfl⟩
  have hK : 64 * c₁ ^ 2 * V * T₁ ≤ t₀ := by
    have h := hconst m G θ hmR hG hθ hθ1
    rw [← hθ₃, ← hT₁, ← hδ₃, ← hV, ← ht₀] at h
    exact h
  rw [← ht₀] at hts htN ⊢
  have hκm : 1 ≤ κ₁ * (m : ℝ) := one_le_mul_of_one_le_of_one_le hκ₁1 hmR
  have hκmne : κ₁ * (m : ℝ) ≠ 0 := by
    have : (0 : ℝ) < κ₁ * m := by linarith
    exact this.ne'
  have hκmpow : 1 ≤ (κ₁ * (m : ℝ)) ^ (2 * Module.finrank ℚ K) := one_le_pow₀ hκm
  have hden : 1 ≤ G * (κ₁ * (m : ℝ)) ^ (2 * Module.finrank ℚ K) :=
    one_le_mul_of_one_le_of_one_le hG hκmpow
  have hθ₃pos : 0 < θ₃ := by rw [hθ₃]; exact div_pos (pow_pos hθ 2) (by linarith)
  have hθ₃1 : θ₃ ≤ 1 := by
    rw [hθ₃, div_le_one (by linarith)]
    have hθ2 : θ ^ 2 ≤ 1 := pow_le_one₀ hθ.le hθ1
    linarith
  have hT₁1 : 1 ≤ T₁ := by
    rw [hT₁]; apply one_le_pow₀; rw [le_div_iff₀ (by linarith)]; linarith
  have hT₁pos : 0 < T₁ := by linarith
  have hδ₃pos : 0 < δ₃ := by rw [hδ₃]; exact div_pos hθ₃pos (by linarith)
  have hδ₃1 : δ₃ ≤ 1 := by rw [hδ₃, div_le_one (by linarith)]; linarith
  have hV1 : 1 ≤ V := by
    rw [hV]; apply one_le_pow₀; rw [le_div_iff₀ hδ₃pos]; linarith
  have hVpos : 0 < V := by linarith
  have hVT1 : 1 ≤ V * T₁ := one_le_mul_of_one_le_of_one_le hV1 hT₁1
  have hcVT : V * T₁ ≤ c₁ ^ 2 * V * T₁ := by
    have := mul_le_mul_of_nonneg_right hc₁sq (by linarith : (0 : ℝ) ≤ V * T₁)
    linarith
  have hcV : V ≤ c₁ ^ 2 * V * T₁ := by
    have := mul_le_mul_of_nonneg_left hT₁1 hVpos.le
    linarith
  have ht₀1 : 1 ≤ t₀ := by linarith
  
  obtain ⟨R, hR⟩ : ∃ x : ℝ, x = C ^ 2 * cb * m * N / s := ⟨_, rfl⟩
  rw [← hR] at ha hbig
  have hC2 : 1 ≤ C ^ 2 := one_le_pow₀ hC1.le
  have hC2cbm : 1 ≤ C ^ 2 * cb * m :=
    one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hC2 hcb) hmR
  have hNs : t₀ ≤ N / s := by rw [le_div_iff₀ hs0]; exact htN
  have hRt₀ : t₀ ≤ R := by
    have h1 : (N : ℝ) / s ≤ C ^ 2 * cb * m * (N / s) :=
      le_mul_of_one_le_left (div_nonneg (Nat.cast_nonneg _) hs0.le) hC2cbm
    rw [hR]
    calc t₀ ≤ N / s := hNs
      _ ≤ C ^ 2 * cb * m * (N / s) := h1
      _ = C ^ 2 * cb * m * N / s := by ring
  have hR1 : 1 ≤ R := by linarith
  have hCcb : 1 ≤ C * cb := one_le_mul_of_one_le_of_one_le hC1.le hcb
  have hCs : t₀ ≤ C * cb * s := by
    have : s ≤ C * cb * s := le_mul_of_one_le_left hs0.le hCcb
    linarith
  have hCs1 : 1 ≤ C * cb * s := by linarith
  have hfloor : ∀ x : ℝ, 1 ≤ x → 1 ≤ ⌊x⌋₊ ∧ (⌊x⌋₊ : ℝ) ≤ x ∧ x ≤ 2 * (⌊x⌋₊ : ℝ) := by
    intro x hx
    have h1 : 1 ≤ ⌊x⌋₊ := Nat.le_floor (by exact_mod_cast hx)
    have h1' : (1 : ℝ) ≤ (⌊x⌋₊ : ℝ) := by exact_mod_cast h1
    refine ⟨h1, Nat.floor_le (by linarith), ?_⟩
    have := Nat.lt_floor_add_one x
    linarith
  obtain ⟨R₀, hR₀⟩ : ∃ k : ℕ, k = ⌊R⌋₊ := ⟨_, rfl⟩
  obtain ⟨S₀, hS₀⟩ : ∃ k : ℕ, k = ⌊C * cb * s⌋₊ := ⟨_, rfl⟩
  obtain ⟨hR₀1, hR₀le, hR₀ge⟩ := hfloor R hR1
  obtain ⟨hS₀1, hS₀le, hS₀ge⟩ := hfloor (C * cb * s) hCs1
  rw [← hR₀] at hR₀1 hR₀le hR₀ge
  rw [← hS₀] at hS₀1 hS₀le hS₀ge
  have hR₀R : (1 : ℝ) ≤ R₀ := by exact_mod_cast hR₀1
  have hS₀R : (1 : ℝ) ≤ S₀ := by exact_mod_cast hS₀1
  have hR₀pos : (0 : ℝ) < R₀ := by linarith
  have hS₀pos : (0 : ℝ) < S₀ := by linarith
  have hR₀ne : (R₀ : ℝ) ≠ 0 := hR₀pos.ne'
  have hS₀ne : (S₀ : ℝ) ≠ 0 := hS₀pos.ne'
  have hRCs : R * (C * cb * s) = C ^ 3 * cb ^ 2 * m * N := by
    rw [hR]; field_simp
  have hRS : (m : ℝ) * N ≤ 4 * (R₀ * S₀) := by
    have h1 : R * (C * cb * s) ≤ (2 * R₀) * (2 * S₀) :=
      mul_le_mul hR₀ge hS₀ge (by linarith) (by linarith)
    have h2 : (m : ℝ) * N ≤ C ^ 3 * cb ^ 2 * m * N := by
      have : (0 : ℝ) ≤ m * N := by positivity
      have h3 := mul_le_mul_of_nonneg_right hC3cb2 this
      linarith
    linarith
  have hmRS : (m : ℝ) / (R₀ * S₀) ≤ 4 / N := by
