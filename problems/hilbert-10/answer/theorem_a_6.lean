        _ = Real.exp (12 * Λ) * (H''.card * 64) := by ring
    exact le_of_mul_le_mul_left h' hpos
  · 
    intro a b ha hb hab
    have hζ : ∑ i, ξ (a i) - ∑ i, ξ (b i) ∈ A₀ := by
      rw [hA₀, Finset.mem_filter]
