    intro η c j hd hη hj hc0 hcP hcj hR hL
    have hP1 : 1 ≤ P := Nat.pos_of_ne_zero (NeZero.ne P)
    have hPpos : (0 : ℝ) < P := by exact_mod_cast hP1
    have hP1R : (1 : ℝ) ≤ P := by exact_mod_cast hP1
    have hdR : (1 : ℝ) ≤ (S.card : ℝ) := by exact_mod_cast hd
    have hjR : (2 : ℝ) ≤ (j : ℝ) := by exact_mod_cast hj
    have hcn0 : giCircNorm P 0 = 0 := by simp [giCircNorm]
