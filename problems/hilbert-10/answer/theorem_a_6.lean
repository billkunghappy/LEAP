    have hone : (∑' _ : Fin n, (1 : ℂ)) = (n : ℂ) := by
      rw [tsum_fintype]; simp
    have h2 : (∑' p : Y × Fin n, G p.1 * (1 : ℂ)) = ∑' p : Y × Fin n, G p.1 :=
      tsum_congr (fun p => mul_one _)
    rw [← h2, ← hval, hone]; ring
  have crux2 : ∀ (X Y : Type u) (ψ : X → Y) (n : ℕ), 0 < n →
      (∀ y : Y, Nat.card {x : X // ψ x = y} = n) →
      ∃ E : X ≃ Y × Fin n, ∀ x : X, (E x).1 = ψ x := by
    intro X Y ψ n hn hfb
    have hfin : ∀ y : Y, Finite {x : X // ψ x = y} := by
      intro y
      have h : 0 < Nat.card {x : X // ψ x = y} := by rw [hfb y]; exact hn
      exact (Nat.card_pos_iff.mp h).2
    have ee : ∀ y : Y, {x : X // ψ x = y} ≃ Fin n := by
      intro y
      haveI := hfin y
      exact Finite.equivFinOfCardEq (hfb y)
    exact ⟨(Equiv.sigmaFiberEquiv ψ).symm.trans
        ((Equiv.sigmaCongrRight ee).trans (Equiv.sigmaEquivProd Y (Fin n))),
      fun x => rfl⟩
  have crux : ∀ (X Y : Type u) (ψ : X → Y) (G : Y → ℂ) (n : ℕ),
      0 < n → Summable G → (∀ y : Y, Nat.card {x : X // ψ x = y} = n) →
      Summable (fun x : X => G (ψ x)) ∧
        ∑' x : X, G (ψ x) = (n : ℂ) * ∑' y : Y, G y := by
    intro X Y ψ G n hn hG hfb
    obtain ⟨E, hfst⟩ := crux2 X Y ψ n hn hfb
    obtain ⟨hprod, hvv⟩ := crux1 Y G n hG
    refine ⟨?_, ?_⟩
    · refine Summable.congr ((Equiv.summable_iff E).mpr hprod) (fun x => ?_)
      show G ((E x).1) = G (ψ x)
      rw [hfst x]
    · calc ∑' x : X, G (ψ x) = ∑' x : X, G ((E x).1) :=
          tsum_congr (fun x => by rw [hfst x])
        _ = ∑' p : Y × Fin n, G p.1 := Equiv.tsum_eq E (fun p : Y × Fin n => G p.1)
        _ = (n : ℂ) * ∑' y : Y, G y := hvv
  intro s hs
  have hNpos : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      0 < Ideal.absNorm I := by
    intro I hI
    rcases Nat.eq_zero_or_pos (Ideal.absNorm I) with h | h
    · exact absurd (Ideal.absNorm_eq_zero_iff.mp h)
        (by rw [← Submodule.zero_eq_bot]; exact hI)
    · exact h
  have hlam1 : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → ‖lam I‖ ≤ 1 := by
    intro I hI
    by_cases hIq : I ⊔ q = ⊤
    · exact le_of_eq (hH3 I hI hIq)
    · rw [hH4 I hIq, norm_zero]; norm_num
  have hnormbd : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ‖lam (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)‖
        ≤ ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-s.re) := by
    intro I
    have hI0 : 0 < Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) := hNpos _ I.2
    have hm : (0 : ℝ) <
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) := by
      exact_mod_cast hI0
    have hp : (0 : ℝ) <
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ s.re :=
      Real.rpow_pos_of_pos hm _
    rw [norm_div, Complex.norm_natCast_cpow_of_pos hI0, Real.rpow_neg hm.le,
      div_eq_mul_inv]
    exact mul_le_of_le_one_left (inv_nonneg.mpr hp.le) (hlam1 _ I.2)
  have hg's : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      lam (I : Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) :=
    Summable.of_norm_bounded (hZsum s.re hs) hnormbd
  set S : Set {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} :=
    {I | (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤} with hSdef
  have hgS : Summable (fun y : ↥S =>
      lam ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) :=
    hg's.subtype S
  have hsupp : Function.support
      (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        lam (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) ⊆ S := by
    intro I hI
    by_contra hcon
    apply hI
    show lam (I : Ideal (NumberField.RingOfIntegers K)) /
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) = 0
    rw [hH4 (I : Ideal (NumberField.RingOfIntegers K)) hcon, zero_div]
  have hstar : (∑' y : ↥S,
        lam ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
      = kaiHeckeSeries K lam s := by
    simp only [kaiHeckeSeries]
    exact tsum_subtype_eq_of_support_subset hsupp
  have hIspec : ∀ p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k},
      ∃ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 ∧ I ⊔ q = ⊤ ∧
        Ideal.span {(p.2 : NumberField.RingOfIntegers K)} = I * b p.1 :=
    fun p => hGenid p.1 (p.2 : NumberField.RingOfIntegers K) p.2.2
  set Iof : ((k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k}) →
      Ideal (NumberField.RingOfIntegers K) := fun p => (hIspec p).choose with hIofdef
  have hIof : ∀ p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k},
      Iof p ≠ 0 ∧ Iof p ⊔ q = ⊤ ∧
        Ideal.span {(p.2 : NumberField.RingOfIntegers K)} = Iof p * b p.1 :=
    fun p => (hIspec p).choose_spec
  set φ : ((k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k}) → ↥S :=
    fun p => ⟨⟨Iof p, (hIof p).1⟩, (hIof p).2.1⟩ with hφdef
  have hiff : ∀ (y : ↥S) (p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k}),
      φ p = y ↔ Ideal.span {(p.2 : NumberField.RingOfIntegers K)}
        = ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) * b p.1 := by
    intro y p
    constructor
    · intro h
      have h1 : Iof p = ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
          Ideal (NumberField.RingOfIntegers K)) := by rw [← h]
      rw [(hIof p).2.2, h1]
    · intro h
      have h2 : Iof p * b p.1
          = ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) * b p.1 := by
        rw [← (hIof p).2.2, h]
      exact Subtype.ext (Subtype.ext (mul_right_cancel₀ (hb p.1).1 h2))
  have hfib : ∀ y : ↥S,
      Nat.card {p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k} //
        φ p = y} = hh := by
    intro y
    have he : {p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k} // φ p = y}
        ≃ {p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k} //
            Ideal.span {(p.2 : NumberField.RingOfIntegers K)}
              = ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
                  Ideal (NumberField.RingOfIntegers K)) * b p.1} :=
      Equiv.subtypeEquivRight (fun p => hiff y p)
    rw [Nat.card_congr he]
    exact hcov _ (y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}).2 y.2
  have hterm : ∀ p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k},
      (starRingEnd ℂ) (lam (b p.1)) * ((Ideal.absNorm (b p.1) : ℂ) ^ s) *
          (kaiHeckeTwist K q t l ξ η (p.2 : NumberField.RingOfIntegers K) /
            ((Ideal.absNorm (Ideal.span
              {(p.2 : NumberField.RingOfIntegers K)}) : ℂ) ^ s))
        = lam ((φ p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm ((φ p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) := by
    intro p
    have hspan : Ideal.span {(p.2 : NumberField.RingOfIntegers K)} = Iof p * b p.1 :=
      (hIof p).2.2
    have hI0 : Iof p ≠ 0 := (hIof p).1
    have hc0 : b p.1 ≠ 0 := (hb p.1).1
    have hcq : b p.1 ⊔ q = ⊤ := (hb p.1).2
    have hμ0 : (p.2 : NumberField.RingOfIntegers K) ≠ 0 := by
      intro hzero
      have hbb : Ideal.span {(p.2 : NumberField.RingOfIntegers K)} = ⊥ :=
        Ideal.span_singleton_eq_bot.mpr hzero
      rw [hspan] at hbb
      rcases Ideal.mul_eq_bot.mp hbb with h1 | h1
      · exact hI0 (by rwa [← Submodule.zero_eq_bot] at h1)
      · exact hc0 (by rwa [← Submodule.zero_eq_bot] at h1)
    have hnum : kaiHeckeTwist K q t l ξ η (p.2 : NumberField.RingOfIntegers K)
        = lam (Iof p * b p.1) := by
      rw [← hH6 (p.2 : NumberField.RingOfIntegers K) hμ0, hspan]
    have hbotI : Iof p ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hbotc : b p.1 ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hNa : Ideal.absNorm (Iof p) ≠ 0 :=
      fun h => hbotI (Ideal.absNorm_eq_zero_iff.mp h)
    have hNd : Ideal.absNorm (b p.1) ≠ 0 :=
      fun h => hbotc (Ideal.absNorm_eq_zero_iff.mp h)
    have hD : ((Ideal.absNorm (b p.1) : ℕ) : ℂ) ^ s ≠ 0 := by
      intro h
      exact (Nat.cast_ne_zero.mpr hNd) ((Complex.cpow_eq_zero_iff _ _).mp h).1
    have hsplit : ((Ideal.absNorm (Iof p * b p.1) : ℕ) : ℂ) ^ s
        = ((Ideal.absNorm (Iof p) : ℕ) : ℂ) ^ s *
          ((Ideal.absNorm (b p.1) : ℕ) : ℂ) ^ s := by
      rw [map_mul Ideal.absNorm (Iof p) (b p.1)]
      have hc1 : ((Ideal.absNorm (Iof p) * Ideal.absNorm (b p.1) : ℕ) : ℂ)
          = ((Ideal.absNorm (Iof p) : ℝ) : ℂ) * ((Ideal.absNorm (b p.1) : ℝ) : ℂ) := by
        push_cast; ring
      rw [hc1, Complex.mul_cpow_ofReal_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _),
        Complex.ofReal_natCast, Complex.ofReal_natCast]
    have hcn : ‖lam (b p.1)‖ = 1 := hH3 (b p.1) hc0 hcq
    have hz : (starRingEnd ℂ) (lam (b p.1)) * lam (b p.1) = 1 := by
      have hne : lam (b p.1) ≠ 0 := by
        intro h; rw [h, norm_zero] at hcn; norm_num at hcn
      rw [← Complex.inv_eq_conj hcn]
      exact inv_mul_cancel₀ hne
    have hkey : ∀ z y A D : ℂ, D ≠ 0 → (starRingEnd ℂ) z * z = 1 →
        (starRingEnd ℂ) z * D * ((y * z) / (A * D)) = y / A := by
      intro z y A D hD' hz'
      have hDD : D / (A * D) = 1 / A := by
        rw [mul_comm A D, ← div_div, div_self hD']
      calc (starRingEnd ℂ) z * D * ((y * z) / (A * D))
          = ((starRingEnd ℂ) z * z) * y * (D / (A * D)) := by ring
        _ = y * (D / (A * D)) := by rw [hz']; ring
        _ = y * (1 / A) := by rw [hDD]
        _ = y / A := by ring
    have hφval : ((φ p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
        Ideal (NumberField.RingOfIntegers K)) = Iof p := rfl
    rw [hφval, hnum, hspan, hsplit, hH2 (Iof p) (b p.1)]
    exact hkey (lam (b p.1)) (lam (Iof p)) _ _ hD hz
  obtain ⟨hcS, hcV⟩ := crux
    ((k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k}) ↥S φ
    (fun y : ↥S =>
      lam ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm ((y : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
    hh hhh0 hgS hfib
  have hSF : Summable
      (fun p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k} =>
        (starRingEnd ℂ) (lam (b p.1)) * ((Ideal.absNorm (b p.1) : ℂ) ^ s) *
          (kaiHeckeTwist K q t l ξ η (p.2 : NumberField.RingOfIntegers K) /
            ((Ideal.absNorm (Ideal.span
              {(p.2 : NumberField.RingOfIntegers K)}) : ℂ) ^ s))) :=
    hcS.congr (fun p => (hterm p).symm)
  have hlhs : (∑' p : (k : Fin M) × {μ : NumberField.RingOfIntegers K // μ ∈ Gen k},
      (starRingEnd ℂ) (lam (b p.1)) * ((Ideal.absNorm (b p.1) : ℂ) ^ s) *
        (kaiHeckeTwist K q t l ξ η (p.2 : NumberField.RingOfIntegers K) /
          ((Ideal.absNorm (Ideal.span
            {(p.2 : NumberField.RingOfIntegers K)}) : ℂ) ^ s)))
      = (hh : ℂ) * kaiHeckeSeries K lam s := by
    rw [tsum_congr hterm, hcV, hstar]
  rw [← hlhs, hSF.tsum_sigma, tsum_fintype]
  refine Finset.sum_congr rfl (fun k _ => ?_)
  show (∑' c : {μ : NumberField.RingOfIntegers K // μ ∈ Gen k},
      ((starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s)) *
        (kaiHeckeTwist K q t l ξ η (c : NumberField.RingOfIntegers K) /
          ((Ideal.absNorm (Ideal.span
            {(c : NumberField.RingOfIntegers K)}) : ℂ) ^ s)))
    = (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) *
      ∑' μ : {ν : NumberField.RingOfIntegers K // ν ∈ Gen k},
        kaiHeckeTwist K q t l ξ η (μ : NumberField.RingOfIntegers K) /
          ((Ideal.absNorm (Ideal.span
            {(μ : NumberField.RingOfIntegers K)}) : ℂ) ^ s)
  rw [tsum_mul_left]

theorem kai_mf_twist_trivial_one (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K))
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (hd : ∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) (ht : t = 0)
    (γ : NumberField.RingOfIntegers K) (hγ : γ - 1 ∈ q) :
    kaiHeckeTwist K q t l ξ η γ = 1 :=
by
  have hη : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, η w = false := by
    intro w; have h := hd (w : NumberField.InfinitePlace K)
    rw [kaiHZDeg, dif_pos w.2] at h
    by_cases hw : η ⟨(w : NumberField.InfinitePlace K), w.2⟩
    · rw [if_pos hw] at h; norm_num at h
    · simpa using hw
  have hl : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex}, l p = 0 := by
    intro p
    have hnr : ¬ (p : NumberField.InfinitePlace K).IsReal :=
      NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr p.2
    have h := hd (p : NumberField.InfinitePlace K)
    rw [kaiHZDeg, dif_neg hnr] at h
    have h2 : ((l ⟨(p : NumberField.InfinitePlace K),
        (p : NumberField.InfinitePlace K).isReal_or_isComplex.resolve_left hnr⟩ : ℤ) : ℝ) = 0 := by
      rwa [abs_eq_zero] at h
    have h3 : l ⟨(p : NumberField.InfinitePlace K),
        (p : NumberField.InfinitePlace K).isReal_or_isComplex.resolve_left hnr⟩ = 0 := by
      exact_mod_cast h2
    simpa using h3
  have hmk : Ideal.Quotient.mk q γ = 1 := by
    have h := (Ideal.Quotient.eq (I := q) (x := γ) (y := 1)).mpr hγ
    simpa using h
  have hu : IsUnit (Ideal.Quotient.mk q γ) := by rw [hmk]; exact isUnit_one
  rw [kaiHeckeTwist, dif_pos hu]
  have hunit : hu.unit = 1 := by ext; rw [IsUnit.unit_spec, hmk]; rfl
  rw [hunit, map_one]
  subst ht
  simp [hη, hl]

theorem kai_mf_dslope_strip (Hf P : ℂ → ℂ) (Ca₁ : ℝ) (hCa₁ : 0 < Ca₁)
    (hHf : Differentiable ℂ Hf) (hHf1 : Hf 1 = 0)
    (hP : ∀ s : ℂ, 0 ≤ s.re → DifferentiableAt ℂ P s)
    (hstrip : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
        ‖Hf s * P s‖ ≤ Ca₁ * Real.exp (Ca₁ * (1 + |s.im|))) :
    ∃ (G : ℂ → ℂ) (Ca : ℝ), 0 < Ca ∧ Differentiable ℂ G ∧
      (∀ s : ℂ, s ≠ 1 → G s = Hf s / (s - 1)) ∧
      (∀ s : ℂ, 1 ≤ ‖s - 1‖ → ‖G s‖ ≤ ‖Hf s‖) ∧
      (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
        ‖G s * P s‖ ≤ Ca * Real.exp (Ca * (1 + |s.im|))) :=
by
  have hG_eq : ∀ s : ℂ, s ≠ 1 → dslope Hf 1 s = Hf s / (s - 1) := by
    intro s hs
    rw [dslope_of_ne Hf hs, slope_def_module, hHf1, sub_zero, smul_eq_mul, div_eq_inv_mul]
  have hG_diff : Differentiable ℂ (dslope Hf 1) := by
    have h := (Complex.differentiableOn_dslope (c := (1 : ℂ)) (s := Set.univ)
      Filter.univ_mem).mpr hHf.differentiableOn
    exact differentiableOn_univ.mp h
  have hG_le : ∀ s : ℂ, 1 ≤ ‖s - 1‖ → ‖dslope Hf 1 s‖ ≤ ‖Hf s‖ := by
    intro s hs
    have hne : s ≠ 1 := by
      intro h
      rw [h, sub_self, norm_zero] at hs
      linarith
    rw [hG_eq s hne, norm_div]
    exact div_le_self (norm_nonneg _) hs
  have hD : ∀ z ∈ Metric.closedBall (1 : ℂ) 1, 0 ≤ z.re := by
    intro z hz
    rw [Metric.mem_closedBall, dist_eq_norm] at hz
    have h1 := Complex.abs_re_le_norm (z - 1)
    rw [Complex.sub_re, Complex.one_re] at h1
    have h2 := (abs_le.mp (h1.trans hz)).1
    linarith
  have hcont : ContinuousOn (fun s => dslope Hf 1 s * P s) (Metric.closedBall (1 : ℂ) 1) := by
    apply ContinuousOn.mul hG_diff.continuous.continuousOn
    intro z hz
    exact (hP z (hD z hz)).continuousAt.continuousWithinAt
  obtain ⟨M, hM⟩ := (isCompact_closedBall (1 : ℂ) 1).exists_bound_of_continuousOn hcont
  have hCa1 : 1 ≤ max Ca₁ (max M 1) := (le_max_right M 1).trans (le_max_right _ _)
  have hCaC : Ca₁ ≤ max Ca₁ (max M 1) := le_max_left _ _
  have hCaM : M ≤ max Ca₁ (max M 1) := (le_max_left M 1).trans (le_max_right _ _)
  refine ⟨dslope Hf 1, max Ca₁ (max M 1), by linarith, hG_diff, hG_eq, hG_le, ?_⟩
  intro s hs1 hs2
  set Ca := max Ca₁ (max M 1) with hCa_def
  have ht : 0 ≤ 1 + |s.im| := by positivity
  by_cases hcase : 1 ≤ ‖s - 1‖
  · have h1 : ‖dslope Hf 1 s * P s‖ ≤ ‖Hf s * P s‖ := by
      rw [norm_mul, norm_mul]
      exact mul_le_mul_of_nonneg_right (hG_le s hcase) (norm_nonneg _)
    have h2 := hstrip s hs1 hs2
    have h3 : Real.exp (Ca₁ * (1 + |s.im|)) ≤ Real.exp (Ca * (1 + |s.im|)) :=
      Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hCaC ht)
    have h4 : Ca₁ * Real.exp (Ca₁ * (1 + |s.im|)) ≤ Ca * Real.exp (Ca * (1 + |s.im|)) :=
      mul_le_mul hCaC h3 (Real.exp_pos _).le (by linarith)
    linarith
  · push_neg at hcase
    have hmem : s ∈ Metric.closedBall (1 : ℂ) 1 := by
      rw [Metric.mem_closedBall, dist_eq_norm]; exact hcase.le
    have h1 := hM s hmem
    have h2 : 1 ≤ Real.exp (Ca * (1 + |s.im|)) :=
      Real.one_le_exp (mul_nonneg (by linarith) ht)
    have h3 : Ca ≤ Ca * Real.exp (Ca * (1 + |s.im|)) :=
      le_mul_of_one_le_right (by linarith) h2
    simp only at h1
    linarith

theorem kai_mf_edge_constant (A Cq Nq X A₃ : ℝ) (hA : 1 ≤ A) (hCq : 1 ≤ Cq)
    (hNq : 1 ≤ Nq) (hX : Nq ≤ X)
    (hA₃ : A * Cq ^ (1 + A) + Cq * (1 + A) + A ≤ A₃) :
    Cq * Nq ^ Cq * (A * (Cq * Nq ^ Cq * X) ^ A) ≤ A₃ * X ^ A₃ :=
by
  have hX1 : 1 ≤ X := le_trans hNq hX
  have hX0 : 0 < X := by linarith
  have hNq0 : 0 < Nq := by linarith
  have hCq0 : 0 < Cq := by linarith
  have hA0 : 0 ≤ A := by linarith
  have hNC : Nq ^ Cq ≤ X ^ Cq := Real.rpow_le_rpow hNq0.le hX hCq0.le
  have hNCpos : 0 < Nq ^ Cq := Real.rpow_pos_of_pos hNq0 Cq
  have hXC0 : 0 < X ^ Cq := Real.rpow_pos_of_pos hX0 Cq
  have hXC1 : X ^ (Cq + 1) = X ^ Cq * X := Real.rpow_add_one hX0.ne' Cq
  have h1 : Cq * Nq ^ Cq * X ≤ Cq * X ^ (Cq + 1) := by
    rw [hXC1, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hNC hCq0.le) hX0.le
  have h2 : (Cq * Nq ^ Cq * X) ^ A ≤ (Cq * X ^ (Cq + 1)) ^ A :=
    Real.rpow_le_rpow (by positivity) h1 hA0
  have h3 : (Cq * X ^ (Cq + 1)) ^ A = Cq ^ A * X ^ ((Cq + 1) * A) := by
    rw [Real.mul_rpow hCq0.le (Real.rpow_nonneg hX0.le _), ← Real.rpow_mul hX0.le]
  have h4 : Cq ^ (1 + A) = Cq * Cq ^ A := by
    rw [Real.rpow_add hCq0, Real.rpow_one]
  have h5 : X ^ (Cq + (Cq + 1) * A) = X ^ Cq * X ^ ((Cq + 1) * A) :=
    Real.rpow_add hX0 _ _
  have hCqA0 : 0 ≤ Cq ^ A := Real.rpow_nonneg hCq0.le A
  have hCq1A0 : 0 ≤ Cq ^ (1 + A) := Real.rpow_nonneg hCq0.le _
  have hP0 : 0 ≤ A * Cq ^ (1 + A) := mul_nonneg hA0 hCq1A0
  have hE : Cq + (Cq + 1) * A ≤ A₃ := by nlinarith
  have hcoef : A * Cq ^ (1 + A) ≤ A₃ := by nlinarith
  have hXE : X ^ (Cq + (Cq + 1) * A) ≤ X ^ A₃ :=
    Real.rpow_le_rpow_of_exponent_le hX1 hE
  have hXE0 : 0 ≤ X ^ (Cq + (Cq + 1) * A) := Real.rpow_nonneg hX0.le _
  calc Cq * Nq ^ Cq * (A * (Cq * Nq ^ Cq * X) ^ A)
      ≤ Cq * X ^ Cq * (A * (Cq ^ A * X ^ ((Cq + 1) * A))) := by
        rw [← h3]
        apply mul_le_mul (mul_le_mul_of_nonneg_left hNC hCq0.le)
          (mul_le_mul_of_nonneg_left h2 hA0) (by positivity) (by positivity)
    _ = (A * Cq ^ (1 + A)) * X ^ (Cq + (Cq + 1) * A) := by
        rw [h4, h5]; ring
    _ ≤ A₃ * X ^ A₃ := mul_le_mul hcoef hXE hXE0 (by linarith)

theorem kai_mf_hecke_cone_continuation (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hRay : KaiMFRayClassProp K) (hFEU : KaiMFConeFEUnitProp K)
    (hConv : KaiHZZetaConvProp K) : KaiMFHeckeContProp K :=
by
  classical
  
  
  
  
  obtain ⟨Cq, hCq1, hRay⟩ := hRay
  obtain ⟨A, hA1, hFE⟩ := hFEU
  obtain ⟨Z, hZ0, hZsum, hZle⟩ := hConv
  have hA0 : (0 : ℝ) < A := by linarith
  have hCq0 : (0 : ℝ) < Cq := by linarith
  have hCqA0 : (0 : ℝ) ≤ Cq ^ (1 + A) := Real.rpow_nonneg hCq0.le _
  obtain ⟨A₃, hA₃def⟩ : ∃ A₃ : ℝ, A₃ = max 2 (A * Cq ^ (1 + A) + Cq * (1 + A) + A) :=
    ⟨_, rfl⟩
  have hA₃2 : (2 : ℝ) ≤ A₃ := by rw [hA₃def]; exact le_max_left _ _
  have hA₃big : A * Cq ^ (1 + A) + Cq * (1 + A) + A ≤ A₃ := by
    rw [hA₃def]; exact le_max_right _ _
  have hA₃0 : (0 : ℝ) < A₃ := by linarith
  refine ⟨A₃, by linarith, ?_⟩
  intro q hq t l ξ η lam hext htr
  have hNQ1 : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    have hqb : q ≠ ⊥ := by rw [← Submodule.zero_eq_bot]; exact hq
    have hne : Ideal.absNorm q ≠ 0 := fun h => hqb (Ideal.absNorm_eq_zero_iff.mp h)
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
  have hV1 : (1 : ℝ) ≤ kaiHZInfSize K t l := by
    have h1 : (0 : ℝ) ≤ ∑ w : NumberField.InfinitePlace K, |t w| :=
      Finset.sum_nonneg fun _ _ => abs_nonneg _
    have h2 : (0 : ℝ) ≤ ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)| :=
      Finset.sum_nonneg fun _ _ => abs_nonneg _
    simp only [kaiHZInfSize]; linarith
  have htabs : ∀ w : NumberField.InfinitePlace K, |t w| ≤ kaiHZInfSize K t l := by
    intro w
    have h1 : |t w| ≤ ∑ w' : NumberField.InfinitePlace K, |t w'| :=
      Finset.single_le_sum (f := fun w' => |t w'|) (fun _ _ => abs_nonneg _) (Finset.mem_univ w)
    have h2 : (0 : ℝ) ≤ ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)| :=
      Finset.sum_nonneg fun _ _ => abs_nonneg _
    simp only [kaiHZInfSize]; linarith
  obtain ⟨M, hh, b, ρ, Gen, hM0, hhh0, hMle, hbk, hGenmem, hGenorb, hGenid, hcov, horth⟩ :=
    hRay q hq
  have hχunit : ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v →
      kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1 := by
    intro v _
    have h6 := hext.2.2.2.2.2 (v : NumberField.RingOfIntegers K) v.ne_zero
    rw [Ideal.span_singleton_eq_top.mpr v.isUnit] at h6
    rw [← h6, ← Ideal.one_eq_top]
    exact hext.1
  obtain ⟨c₀, hcell⟩ := hFE q hq t l ξ η htr hχunit
  have hkey := fun k : Fin M => hcell (b k) (hbk k).1 (hbk k).2.1 (ρ k) (hbk k).2.2.1
    (hbk k).2.2.2.1 (hbk k).2.2.2.2.1 (Gen k) (hGenmem k) (hGenorb k)
  choose Gc Ca hCa0 hGcdiff hGcser hGczero hGcres hGcstrip hGcedge using hkey
  have hNBpos : ∀ k : Fin M, 0 < Ideal.absNorm (b k) := by
    intro k
    rcases Nat.eq_zero_or_pos (Ideal.absNorm (b k)) with h | h
    · exact absurd (Ideal.absNorm_eq_zero_iff.mp h)
        (by rw [← Submodule.zero_eq_bot]; exact (hbk k).1)
    · exact h
  have hNB1 : ∀ k : Fin M, (1 : ℝ) ≤ (Ideal.absNorm (b k) : ℝ) := by
    intro k; exact_mod_cast Nat.one_le_iff_ne_zero.mpr (hNBpos k).ne'
  have hlamb : ∀ k : Fin M, ‖lam (b k)‖ = 1 := fun k => hext.2.2.1 (b k) (hbk k).1 (hbk k).2.1
  have hhC : (hh : ℂ) ≠ 0 := by exact_mod_cast hhh0.ne'
  have hhR1 : (1 : ℝ) ≤ (hh : ℝ) := by exact_mod_cast hhh0
  obtain ⟨Hf, hHfdef⟩ : ∃ Hf : ℂ → ℂ, Hf = fun s =>
    (∑ k : Fin M, (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s) /
      (hh : ℂ) := ⟨_, rfl⟩
  have hcpowdiff : ∀ k : Fin M,
      Differentiable ℂ (fun s : ℂ => ((Ideal.absNorm (b k) : ℂ) ^ s)) := by
    intro k
    refine Differentiable.const_cpow differentiable_id (Or.inl ?_)
    exact_mod_cast (hNBpos k).ne'
  have hterms : ∀ k : Fin M, Differentiable ℂ
      (fun s : ℂ => (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s) :=
    fun k => ((differentiable_const _).mul (hcpowdiff k)).mul (hGcdiff k)
  have hHfdiff : Differentiable ℂ Hf := by
    have hsum : Differentiable ℂ (fun s : ℂ => ∑ k : Fin M,
        (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s) := by
      have h : Differentiable ℂ (∑ k : Fin M, fun s : ℂ =>
          (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s) :=
        Differentiable.sum (fun k _ => hterms k)
      have heq : (∑ k : Fin M, fun s : ℂ =>
            (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s)
          = fun s : ℂ => ∑ k : Fin M,
            (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s := by
        funext s
        simp [Finset.sum_apply]
      rwa [heq] at h
    rw [hHfdef]
    exact fun s => (hsum s).div_const _
  have hHfval : ∀ s : ℂ, 1 < s.re → Hf s = (s - 1) * kaiHeckeSeries K lam s := by
    intro s hs
    have h8 := kai_mf_hecke_cell_reindex K q hq t l ξ η lam hext hZsum M hh b Gen hhh0
      (fun k => ⟨(hbk k).1, (hbk k).2.1⟩) hGenid hcov s hs
    rw [hHfdef]
    simp only
    rw [div_eq_iff hhC]
    have hstep : (∑ k : Fin M, (starRingEnd ℂ) (lam (b k)) *
          ((Ideal.absNorm (b k) : ℂ) ^ s) * Gc k s)
        = (s - 1) * ∑ k : Fin M, (starRingEnd ℂ) (lam (b k)) *
            ((Ideal.absNorm (b k) : ℂ) ^ s) *
            ∑' μ : {ν // ν ∈ Gen k},
              kaiHeckeTwist K q t l ξ η (μ : NumberField.RingOfIntegers K) /
                ((Ideal.absNorm (Ideal.span
                  {(μ : NumberField.RingOfIntegers K)}) : ℂ) ^ s) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [(hGcser k s hs).2]; ring
    rw [hstep, ← h8]; ring
  have htwist1 : ((∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) ∧ t = 0) →
      ∀ γ : NumberField.RingOfIntegers K, γ - 1 ∈ q →
        kaiHeckeTwist K q t l ξ η γ = 1 :=
    fun h γ hγ => kai_mf_twist_trivial_one K q t l ξ η h.1 h.2 γ hγ
  have hHf1 : ¬ KaiHeckePrincipal K q lam → Hf 1 = 0 := by
    intro hnp
    by_cases hcase : (∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) ∧ t = 0
    · have hsum0 : (∑ k : Fin M, (starRingEnd ℂ) (lam (b k))) = 0 := by
        refine horth (fun I => (starRingEnd ℂ) (lam I)) ?_ ?_ ?_ ?_ ?_
        · intro I J
          show (starRingEnd ℂ) (lam (I * J))
            = (starRingEnd ℂ) (lam I) * (starRingEnd ℂ) (lam J)
          rw [hext.2.1, map_mul]
        · intro I hI0 hIq
          show ‖(starRingEnd ℂ) (lam I)‖ = 1
          rw [RCLike.norm_conj]; exact hext.2.2.1 I hI0 hIq
        · intro I hIq
          show (starRingEnd ℂ) (lam I) = 0
          rw [hext.2.2.2.1 I hIq, map_zero]
        · intro γ hγ0 hγ1
          show (starRingEnd ℂ) (lam (Ideal.span {γ})) = 1
          rw [hext.2.2.2.2.2 γ hγ0, htwist1 hcase γ hγ1, map_one]
        · intro hcon
          refine hnp (fun I hI0 hIq => ?_)
          have h : (starRingEnd ℂ) (lam I) = 1 := hcon I hI0 hIq
          have h2 := congrArg (starRingEnd ℂ) h
          rwa [Complex.conj_conj, map_one] at h2
      rw [hHfdef]
      simp only
      rw [div_eq_zero_iff]
      left
      have hterm : ∀ k : Fin M, (starRingEnd ℂ) (lam (b k)) *
          ((Ideal.absNorm (b k) : ℂ) ^ (1 : ℂ)) * Gc k 1
          = c₀ * (starRingEnd ℂ) (lam (b k)) := by
        intro k
        rw [hGcres k hcase, Complex.cpow_one]
        have hne : ((Ideal.absNorm (b k) : ℝ) : ℂ) ≠ 0 := by
          simp only [ne_eq, Complex.ofReal_eq_zero]
          exact ne_of_gt (by exact_mod_cast hNBpos k)
        have hcast : ((Ideal.absNorm (b k) : ℕ) : ℂ) = ((Ideal.absNorm (b k) : ℝ) : ℂ) := by
          push_cast; ring
        rw [hcast]
        field_simp
      rw [Finset.sum_congr rfl (fun k _ => hterm k), ← Finset.mul_sum, hsum0, mul_zero]
    · rw [hHfdef]
      simp only
      rw [div_eq_zero_iff]
      left
      refine Finset.sum_eq_zero (fun k _ => ?_)
      rw [hGczero k hcase, mul_zero]
  have hmultle : ∀ w : NumberField.InfinitePlace K, w.mult ≤ 2 := by
    intro w; simp only [NumberField.InfinitePlace.mult]; split <;> norm_num
  have hmultge : ∀ w : NumberField.InfinitePlace K, 1 ≤ w.mult := by
    intro w; simp only [NumberField.InfinitePlace.mult]; split <;> norm_num
  have halpha : ∀ w : NumberField.InfinitePlace K,
      kaiMFConeAlpha K w = (w.mult : ℝ) / 2 ∧
        (1 : ℝ) / 2 ≤ kaiMFConeAlpha K w ∧ kaiMFConeAlpha K w ≤ 1 := by
    intro w
    have h1 : (1 : ℝ) ≤ (w.mult : ℝ) := by exact_mod_cast hmultge w
    have h2 : (w.mult : ℝ) ≤ 2 := by exact_mod_cast hmultle w
    refine ⟨rfl, ?_, ?_⟩ <;> simp only [kaiMFConeAlpha] <;> linarith
  have halpha0 : ∀ w : NumberField.InfinitePlace K, (0 : ℝ) ≤ kaiMFConeAlpha K w :=
    fun w => by linarith [(halpha w).2.1]
  have hbetare : ∀ w : NumberField.InfinitePlace K,
      (kaiMFConeBeta K t l η w).re
        = kaiHZDeg K η l w / 2 - (⌊kaiHZDeg K η l w / 2 - 1⌋ : ℤ) := by
    intro w; simp [kaiMFConeBeta, Complex.sub_re, Complex.mul_re]
  have hbetaim : ∀ w : NumberField.InfinitePlace K,
      (kaiMFConeBeta K t l η w).im = -((w.mult : ℝ) * t w / 2) := by
    intro w; simp [kaiMFConeBeta, Complex.sub_im, Complex.mul_im]
  have hbeta : ∀ w : NumberField.InfinitePlace K,
      1 ≤ (kaiMFConeBeta K t l η w).re ∧ (kaiMFConeBeta K t l η w).re ≤ 2 ∧
        ‖kaiMFConeBeta K t l η w‖ ≤ A₃ * (1 + kaiHZInfSize K t l) := by
    intro w
    have hfl1 : ((⌊kaiHZDeg K η l w / 2 - 1⌋ : ℤ) : ℝ) ≤ kaiHZDeg K η l w / 2 - 1 :=
      Int.floor_le _
    have hfl2 : kaiHZDeg K η l w / 2 - 1 - 1 < ((⌊kaiHZDeg K η l w / 2 - 1⌋ : ℤ) : ℝ) := by
      have h := Int.sub_one_lt_floor (kaiHZDeg K η l w / 2 - 1)
      linarith
    have hre1 : 1 ≤ (kaiMFConeBeta K t l η w).re := by rw [hbetare w]; linarith
    have hre2 : (kaiMFConeBeta K t l η w).re ≤ 2 := by rw [hbetare w]; linarith
    refine ⟨hre1, hre2, ?_⟩
    have hm2 : (w.mult : ℝ) ≤ 2 := by exact_mod_cast hmultle w
    have hm0 : (0 : ℝ) ≤ (w.mult : ℝ) := by positivity
    have him : |(kaiMFConeBeta K t l η w).im| ≤ |t w| := by
      rw [hbetaim w, abs_neg, abs_div, abs_mul]
      rw [abs_of_nonneg hm0, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]
      have hstep : (w.mult : ℝ) * |t w| ≤ 2 * |t w| :=
        mul_le_mul_of_nonneg_right hm2 (abs_nonneg _)
      linarith [abs_nonneg (t w)]
    have hnb : ‖kaiMFConeBeta K t l η w‖
        ≤ |(kaiMFConeBeta K t l η w).re| + |(kaiMFConeBeta K t l η w).im| :=
      Complex.norm_le_abs_re_add_abs_im _
    have hrr : |(kaiMFConeBeta K t l η w).re| ≤ 2 := by
      rw [abs_of_nonneg (by linarith)]; exact hre2
    have hV := htabs w
    have h3V : (2 : ℝ) * (1 + kaiHZInfSize K t l) ≤ A₃ * (1 + kaiHZInfSize K t l) :=
      mul_le_mul_of_nonneg_right hA₃2 (by linarith)
    linarith
  obtain ⟨Ca₁, hCa₁def⟩ : ∃ Ca₁ : ℝ, Ca₁ = (∑ k : Fin M, ((Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) * Ca k))
      + (∑ k : Fin M, Ca k) + 1 := ⟨_, rfl⟩
  have hCaterm0 : ∀ k : Fin M, (0 : ℝ) ≤ (Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) * Ca k :=
    fun k => mul_nonneg (Real.rpow_nonneg (by linarith [hNB1 k]) _) (hCa0 k).le
  have hsum1 : (0 : ℝ) ≤ ∑ k : Fin M, ((Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) * Ca k) :=
    Finset.sum_nonneg (fun k _ => hCaterm0 k)
  have hsum2 : (0 : ℝ) ≤ ∑ k : Fin M, Ca k :=
    Finset.sum_nonneg (fun k _ => (hCa0 k).le)
  have hCa₁0 : (0 : ℝ) < Ca₁ := by rw [hCa₁def]; linarith
  have hCakle : ∀ k : Fin M, Ca k ≤ Ca₁ := by
    intro k
    have h := Finset.single_le_sum (f := fun k : Fin M => Ca k)
      (fun j _ => (hCa0 j).le) (Finset.mem_univ k)
    rw [hCa₁def]; linarith
  have hCasumle : (∑ k : Fin M, ((Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) * Ca k)) ≤ Ca₁ := by
    rw [hCa₁def]; linarith
  have hnormcpow : ∀ (k : Fin M) (s : ℂ),
      ‖((Ideal.absNorm (b k) : ℂ) ^ s)‖ = (Ideal.absNorm (b k) : ℝ) ^ s.re :=
    fun k s => Complex.norm_natCast_cpow_of_pos (hNBpos k) s
  have hHfstrip : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
      ‖Hf s * ∏ w : NumberField.InfinitePlace K,
          Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w)‖
        ≤ Ca₁ * Real.exp (Ca₁ * (1 + |s.im|)) := by
    intro s hs1 hs2
    have habs : (0 : ℝ) ≤ |s.im| := abs_nonneg _
    have hrewrite : Hf s * ∏ w : NumberField.InfinitePlace K,
          Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w)
        = (∑ k : Fin M, (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) *
            (Gc k s * ∏ w : NumberField.InfinitePlace K,
              Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s
                + kaiMFConeBeta K t l η w))) / (hh : ℂ) := by
      rw [hHfdef]
      simp only
      rw [div_mul_eq_mul_div, Finset.sum_mul]
      congr 1
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    rw [hrewrite, norm_div, Complex.norm_natCast]
    have hnum : ‖∑ k : Fin M, (starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) *
            (Gc k s * ∏ w : NumberField.InfinitePlace K,
              Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w))‖
        ≤ Ca₁ * Real.exp (Ca₁ * (1 + |s.im|)) := by
      refine le_trans (norm_sum_le _ _) ?_
      have hbd : ∀ k : Fin M, ‖(starRingEnd ℂ) (lam (b k)) * ((Ideal.absNorm (b k) : ℂ) ^ s) *
            (Gc k s * ∏ w : NumberField.InfinitePlace K,
              Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w))‖
          ≤ ((Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) * Ca k) * Real.exp (Ca₁ * (1 + |s.im|)) := by
        intro k
        rw [norm_mul, norm_mul, RCLike.norm_conj, hlamb k, one_mul, hnormcpow k s]
        have hp1 : (Ideal.absNorm (b k) : ℝ) ^ s.re ≤ (Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (hNB1 k) hs2
        have hexp : Real.exp (Ca k * (1 + |s.im|)) ≤ Real.exp (Ca₁ * (1 + |s.im|)) :=
          Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (hCakle k) (by positivity))
        have hg2 : ‖Gc k s * ∏ w : NumberField.InfinitePlace K,
              Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w)‖
            ≤ Ca k * Real.exp (Ca₁ * (1 + |s.im|)) :=
          (hGcstrip k s hs1 hs2).trans (mul_le_mul_of_nonneg_left hexp (hCa0 k).le)
        calc (Ideal.absNorm (b k) : ℝ) ^ s.re *
              ‖Gc k s * ∏ w : NumberField.InfinitePlace K,
                Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s + kaiMFConeBeta K t l η w)‖
            ≤ (Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) * (Ca k * Real.exp (Ca₁ * (1 + |s.im|))) :=
              mul_le_mul hp1 hg2 (norm_nonneg _)
                (Real.rpow_nonneg (by linarith [hNB1 k]) _)
          _ = ((Ideal.absNorm (b k) : ℝ) ^ (4 : ℝ) * Ca k) * Real.exp (Ca₁ * (1 + |s.im|)) := by
