      Ideal.Quotient.mk q x = 1 := by
    intro x hx
    have h1 : Ideal.Quotient.mk q x = Ideal.Quotient.mk q 1 := Ideal.Quotient.eq.mpr hx
    rw [h1, map_one]
  have hGenq : ∀ μ : NumberField.RingOfIntegers K, μ ∈ Gen → μ - 1 ∈ q := by
    intro μ hμ
