      _ ≤ (cq ^ (M + 1) * (2 + τ) ^ M) * (2 + τ) := by
          refine mul_le_mul_of_nonneg_right ?_ (by linarith)
          nlinarith
      _ = cq ^ (M + 1) * ((2 + τ) ^ M * (2 + τ)) := by ring
      _ = cq ^ (M + 1) * (2 + τ) ^ (M + 1) := by ring
  have hedgeR : ∀ s : ℂ, s.re = 4 →
      ‖H s‖ ≤ (C₁ * cq ^ (M + 1)) * (2 + |s.im|) ^ (M + 1) := by
    intro s hs4
    have habs : (0 : ℝ) ≤ |s.im| := abs_nonneg _
    have hs1 : (1 : ℝ) < s.re := by rw [hs4]; norm_num
    have hs32 : (3 : ℝ) / 2 ≤ s.re := by rw [hs4]; norm_num
    have hsl : -(1 : ℝ) / 2 ≤ s.re := by rw [hs4]; norm_num
    have hsu : s.re ≤ 4 := by rw [hs4]
    have hGs : ‖G s‖ = ‖kaiHeckeSeries K lam s‖ * ‖s - 1‖ ^ E := by
      rw [← hGid s hs1, norm_mul, norm_pow]
    have hsm : ‖s - 1‖ ≤ 3 + |s.im| := by
      have h1 : (s - 1).re = 3 := by rw [Complex.sub_re, hs4]; norm_num
      have h2 : (s - 1).im = s.im := by simp
      calc ‖s - 1‖ ≤ |(s - 1).re| + |(s - 1).im| := Complex.norm_le_abs_re_add_abs_im _
        _ = 3 + |s.im| := by rw [h1, h2]; norm_num
    have hsE : ‖s - 1‖ ^ E ≤ 3 + |s.im| := by
      rcases (by omega : E = 0 ∨ E = 1) with h | h
      · rw [h, pow_zero]; linarith
      · rw [h, pow_one]; exact hsm
    have hGsle : ‖G s‖ ≤ Z * (3 + |s.im|) := by
      rw [hGs]
      exact mul_le_mul (hseries s hs32) hsE (pow_nonneg (norm_nonneg _) E) hZ0.le
    have hHle : ‖H s‖ ≤ (Z * (3 + |s.im|)) * CG := by
      rw [hHnorm s]
      exact mul_le_mul hGsle (hprodGam s hsl hsu)
        (Finset.prod_nonneg fun _ _ => norm_nonneg _)
        (mul_nonneg hZ0.le (by linarith))
    have hZCG : (0 : ℝ) ≤ Z * CG * (1 + |s.im|) :=
      mul_nonneg (mul_nonneg hZ0.le hCG0) (by linarith)
    have e1 : (Z * (3 + |s.im|)) * CG ≤ (2 * Z * CG) * (2 + |s.im|) := by
      nlinarith [hZCG]
    have h5 : 2 * Z * CG ≤ C₁ := by
      rw [hC₁def]
      nlinarith [mul_nonneg (mul_nonneg hA₃0.le hZ0.le) hCG0]
    have e2 : (2 * Z * CG) * (2 + |s.im|) ≤ (C₁ * cq ^ (M + 1)) * (2 + |s.im|) ^ (M + 1) := by
      have h4 : (2 + |s.im|) ≤ cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1) := hraise _ habs
      calc (2 * Z * CG) * (2 + |s.im|)
          ≤ C₁ * (cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1)) := by
            refine mul_le_mul h5 h4 (by linarith) ?_
            exact le_trans (mul_nonneg (mul_nonneg (by norm_num) hZ0.le) hCG0) h5
        _ = (C₁ * cq ^ (M + 1)) * (2 + |s.im|) ^ (M + 1) := by ring
    linarith
  have hedgeL : ∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
      ‖H s‖ ≤ (C₁ * cq ^ (M + 1)) * (2 + |s.im|) ^ (M + 1) := by
    intro s hs
    have habs : (0 : ℝ) ≤ |s.im| := abs_nonneg _
    have hsl : -(1 : ℝ) / 2 ≤ s.re := le_of_eq hs.symm
    have hsu : s.re ≤ 4 := by rw [hs]; norm_num
    have hX1 : (1 : ℝ) ≤ cq * (2 + |s.im|) := by nlinarith
    have hGle := hGleft s hs
    have hP0 : (0 : ℝ) ≤ (cq * (2 + |s.im|)) ^ A₃ := Real.rpow_nonneg (by linarith) _
    have hPQ : (cq * (2 + |s.im|)) ^ A₃ ≤ cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1) := by
      calc (cq * (2 + |s.im|)) ^ A₃
          ≤ (cq * (2 + |s.im|)) ^ (((M + 1 : ℕ) : ℝ)) :=
            Real.rpow_le_rpow_of_exponent_le hX1 hA₃A
        _ = cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1) := by rw [Real.rpow_natCast, mul_pow]
    have hQ0 : (0 : ℝ) ≤ cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1) := le_trans hP0 hPQ
    have hGle2 : ‖G s‖ ≤ (A₃ * Z) * (cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1)) := by
      refine le_trans hGle ?_
      have h1 : A₃ * (cq * (2 + |s.im|)) ^ A₃ *
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
              (-((3 : ℝ) / 2)))
          ≤ A₃ * (cq * (2 + |s.im|)) ^ A₃ * Z :=
        mul_le_mul_of_nonneg_left hTZ (mul_nonneg hA₃0.le hP0)
      have h2 := mul_le_mul_of_nonneg_left hPQ (mul_nonneg hA₃0.le hZ0.le)
      nlinarith [h1, h2]
    have hHle : ‖H s‖
        ≤ ((A₃ * Z) * (cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1))) * CG := by
      rw [hHnorm s]
      exact mul_le_mul hGle2 (hprodGam s hsl hsu)
        (Finset.prod_nonneg fun _ _ => norm_nonneg _)
        (mul_nonneg (mul_nonneg hA₃0.le hZ0.le) hQ0)
    have h5 : A₃ * Z * CG ≤ C₁ := by
      rw [hC₁def]
      nlinarith [mul_nonneg (mul_nonneg (show (0 : ℝ) ≤ 2 by norm_num) hZ0.le) hCG0]
    nlinarith [hHle, mul_le_mul_of_nonneg_right h5 hQ0]
  
  have hdiffH : ∀ s : ℂ, -1 < s.re → s.re < 5 → DifferentiableAt ℂ H s := by
    intro s h1 h2
    rw [hHdef]
    refine DifferentiableAt.mul (hGdiff s) ?_
    refine DifferentiableAt.fun_finset_prod (fun w _ => ?_)
    have hin : DifferentiableAt ℂ (fun z : ℂ => (α w : ℂ) * z + β w) s :=
      (differentiableAt_id.const_mul _).add_const _
    have hGa : DifferentiableAt ℂ Complex.Gamma ((α w : ℂ) * s + β w) := by
      refine Complex.differentiableAt_Gamma _ (fun m => ?_)
      intro hcon
      have h0 := hzre0 s h1 h2 w
      rw [hcon, Complex.neg_re, Complex.natCast_re] at h0
      have hm : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
      linarith
    exact DifferentiableAt.comp s hGa hin
  have hgrowH : ∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
      ‖H s‖ ≤ Ca * Real.exp (Ca * (1 + |s.im|)) := by
    intro s h1 h2
    rw [hH s]
    exact hCagrow s h1 h2
  have hedgeH : ∀ s : ℂ, s.re = -(1 : ℝ) / 2 ∨ s.re = 4 →
      ‖H s‖ ≤ (C₁ * cq ^ (M + 1)) * (2 + |s.im|) ^ (M + 1) := by
    intro s hs
    rcases hs with h | h
    · exact hedgeL s h
    · exact hedgeR s h
  have hstrip := hPL H (M + 1) (C₁ * cq ^ (M + 1)) Ca
    (mul_nonneg hC₁0 hcqA0) hCa0 hdiffH hgrowH hedgeH
  
  refine ⟨E, G, H, α, β, hE1, hEiff, hGdiff, hGid, ?_, ?_, hclause7, ?_, ?_⟩
  · exact fun w => ⟨(hα w).2.1, (hα w).2.2⟩
  · intro w
    refine ⟨by linarith [(hβ w).1], le_trans (hβ w).2.2 ?_⟩
    exact mul_le_mul_of_nonneg_right hA₂A₃ (by linarith)
  · intro s h1 h2
    have habs : (0 : ℝ) ≤ |s.im| := abs_nonneg _
    have hX1 : (1 : ℝ) ≤ cq * (2 + |s.im|) := by nlinarith
    have hb := hstrip s h1 h2
    have hpowe : cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1)
        = (cq * (2 + |s.im|)) ^ (((M + 1 : ℕ) : ℝ)) := by
      rw [Real.rpow_natCast, mul_pow]
    have hQ0 : (0 : ℝ) ≤ (cq * (2 + |s.im|)) ^ (((M + 1 : ℕ) : ℝ)) :=
      Real.rpow_nonneg (by linarith) _
    have hrp : (cq * (2 + |s.im|)) ^ (((M + 1 : ℕ) : ℝ)) ≤ (cq * (2 + |s.im|)) ^ A₂ :=
      Real.rpow_le_rpow_of_exponent_le hX1 hA₂A
    calc ‖H s‖ ≤ (9 : ℝ) ^ (M + 1) * (C₁ * cq ^ (M + 1)) * (2 + |s.im|) ^ (M + 1) := hb
      _ = ((9 : ℝ) ^ (M + 1) * C₁) * (cq ^ (M + 1) * (2 + |s.im|) ^ (M + 1)) := by ring
      _ = ((9 : ℝ) ^ (M + 1) * C₁) * ((cq * (2 + |s.im|)) ^ (((M + 1 : ℕ) : ℝ))) := by
          rw [hpowe]
      _ ≤ A₂ * ((cq * (2 + |s.im|)) ^ A₂) := mul_le_mul hA₂C hrp hQ0 (by linarith)
  · intro s hs
    have habs : (0 : ℝ) ≤ |s.im| := abs_nonneg _
    have hX1 : (1 : ℝ) ≤ cq * (2 + |s.im|) := by nlinarith
    have hP0 : (0 : ℝ) ≤ (cq * (2 + |s.im|)) ^ A₃ := Real.rpow_nonneg (by linarith) _
    have hrp : (cq * (2 + |s.im|)) ^ A₃ ≤ (cq * (2 + |s.im|)) ^ A₂ :=
      Real.rpow_le_rpow_of_exponent_le hX1 hA₂A₃
    refine le_trans (hGleft s hs) ?_
    exact mul_le_mul_of_nonneg_right (mul_le_mul hA₂A₃ hrp hP0 (by linarith)) hT0

theorem kai_hecke_zeta_continuation (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ A₀ : ℝ, 0 < A₀ ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ (t : NumberField.InfinitePlace K → ℝ)
          (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
          (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
          (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
          KaiHeckeExt K q t l ξ η lam →
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
          ∃ (E : ℕ) (G : ℂ → ℂ),
            E ≤ 1 ∧ (E = 1 ↔ KaiHeckePrincipal K q lam) ∧
            Differentiable ℂ G ∧
            (∀ s : ℂ, 1 < s.re →
                Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
                  lam (I : Ideal (NumberField.RingOfIntegers K)) /
                    ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) ∧
            (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) ∧
            (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
                ‖G s‖ ≤ A₀ * ((Ideal.absNorm q : ℝ) *
                  (1 + (1 + (∑ w : NumberField.InfinitePlace K, |t w|)
                    + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)|))
                  * (2 + |s.im|)) ^ A₀) :=
by
  classical
  have hP : KaiHZPoissonProp := kai_hz_lattice_poisson
  have hΓ : KaiHZGammaBoundProp := by
    constructor
    · intro x y hx
      have hzre : ((x : ℂ) + (y : ℂ) * Complex.I).re = x := by simp
      have hgi : Complex.Gamma ((x : ℂ) + (y : ℂ) * Complex.I)
          = ∫ t in Set.Ioi (0 : ℝ),
              (Real.exp (-t) : ℂ) * (t : ℂ) ^ (((x : ℂ) + (y : ℂ) * Complex.I) - 1) := by
        rw [Complex.Gamma_eq_integral (by rw [hzre]; exact hx), Complex.GammaIntegral.eq_def]
      rw [hgi]
      refine le_trans (MeasureTheory.norm_integral_le_integral_norm _) ?_
      have hcongr : (∫ t in Set.Ioi (0 : ℝ),
            ‖(Real.exp (-t) : ℂ) * (t : ℂ) ^ (((x : ℂ) + (y : ℂ) * Complex.I) - 1)‖)
          = ∫ t in Set.Ioi (0 : ℝ), Real.exp (-t) * t ^ (x - 1) := by
        refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi ?_
        intro t ht
        simp only [Set.mem_Ioi] at ht
        show ‖(Real.exp (-t) : ℂ) * (t : ℂ) ^ (((x : ℂ) + (y : ℂ) * Complex.I) - 1)‖
            = Real.exp (-t) * t ^ (x - 1)
        rw [norm_mul, Complex.norm_real, Complex.norm_cpow_eq_rpow_re_of_pos ht,
          show (((x : ℂ) + (y : ℂ) * Complex.I) - 1).re = x - 1 from by simp,
          Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      rw [hcongr]
      exact le_of_eq (Real.Gamma_eq_integral hx).symm
    · intro x y hx
      have hx0 : (0 : ℝ) < x := lt_of_lt_of_le zero_lt_one hx
      have hxne : x ≠ 0 := ne_of_gt hx0
      have claimA : ∀ m : ℕ, (∑ j ∈ Finset.range m, ((x + 1 + (j : ℝ)) ^ 2)⁻¹)
          ≤ x⁻¹ - (x + (m : ℝ))⁻¹ := by
        intro m
        induction m with
        | zero => simp
        | succ k ih =>
          have hkn : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
          have hk0 : (0 : ℝ) < x + (k : ℝ) := by linarith
          have hk1 : (0 : ℝ) < x + (k : ℝ) + 1 := by linarith
          have hkne : x + (k : ℝ) ≠ 0 := ne_of_gt hk0
          have hk1ne : x + (k : ℝ) + 1 ≠ 0 := ne_of_gt hk1
          have key : ((x + (k : ℝ) + 1) ^ 2)⁻¹ ≤ (x + (k : ℝ))⁻¹ - (x + (k : ℝ) + 1)⁻¹ := by
            rw [← sub_nonneg]
            have h : (x + (k : ℝ))⁻¹ - (x + (k : ℝ) + 1)⁻¹ - ((x + (k : ℝ) + 1) ^ 2)⁻¹
                = 1 / ((x + (k : ℝ)) * (x + (k : ℝ) + 1) ^ 2) := by
              field_simp
              ring
            rw [h]
            have hpos : (0 : ℝ) < 1 / ((x + (k : ℝ)) * (x + (k : ℝ) + 1) ^ 2) :=
              div_pos one_pos (mul_pos hk0 (pow_pos hk1 2))
            exact hpos.le
          rw [Finset.sum_range_succ]
          have e1 : x + ((k + 1 : ℕ) : ℝ) = x + (k : ℝ) + 1 := by push_cast; ring
          have e2 : x + 1 + (k : ℝ) = x + (k : ℝ) + 1 := by ring
          rw [e1, e2]
          linarith
      have hsum : ∀ n : ℕ, (∑ j ∈ Finset.range n, ((x + (j : ℝ)) ^ 2)⁻¹) ≤ 2 := by
        intro n
        cases n with
        | zero => simp
        | succ m =>
          rw [Finset.sum_range_succ']
          have hEq : (∑ k ∈ Finset.range m, ((x + ((k + 1 : ℕ) : ℝ)) ^ 2)⁻¹)
              = ∑ k ∈ Finset.range m, ((x + 1 + (k : ℝ)) ^ 2)⁻¹ :=
            Finset.sum_congr rfl (fun k _ => by push_cast; ring_nf)
          rw [hEq]
          have hmn : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
          have hm0 : (0 : ℝ) < x + (m : ℝ) := by linarith
          have h2 : (0 : ℝ) ≤ (x + (m : ℝ))⁻¹ := (inv_pos.mpr hm0).le
          have h3 : x⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hx
          have hA := claimA m
          have h4 : ((x + ((0 : ℕ) : ℝ)) ^ 2)⁻¹ ≤ 1 := by
            refine inv_le_one_of_one_le₀ ?_
            push_cast
            nlinarith
          linarith
      have hprod : ∀ n : ℕ, (∏ j ∈ Finset.range n, Real.sqrt ((x + (j : ℝ)) ^ 2 + y ^ 2))
          ≤ Real.exp (y ^ 2) * ∏ j ∈ Finset.range n, (x + (j : ℝ)) := by
        intro n
        have hpt : ∀ j ∈ Finset.range n, Real.sqrt ((x + (j : ℝ)) ^ 2 + y ^ 2)
            ≤ (x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹) := by
          intro j _
          have hj : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
          have haj : (0 : ℝ) < x + (j : ℝ) := by linarith
          have hajne : x + (j : ℝ) ≠ 0 := ne_of_gt haj
          have hR : (0 : ℝ) < (x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹) :=
            mul_pos haj (Real.exp_pos _)
          have hexp2 : (Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹)) ^ 2
              = Real.exp (y ^ 2 * ((x + (j : ℝ)) ^ 2)⁻¹) := by
            rw [sq, ← Real.exp_add]
            congr 1
            ring
          have h1u := Real.add_one_le_exp (y ^ 2 * ((x + (j : ℝ)) ^ 2)⁻¹)
          have hmul : (x + (j : ℝ)) ^ 2 * (y ^ 2 * ((x + (j : ℝ)) ^ 2)⁻¹ + 1)
              ≤ (x + (j : ℝ)) ^ 2 * Real.exp (y ^ 2 * ((x + (j : ℝ)) ^ 2)⁻¹) :=
            mul_le_mul_of_nonneg_left h1u (sq_nonneg _)
          have hexpand : (x + (j : ℝ)) ^ 2 * (y ^ 2 * ((x + (j : ℝ)) ^ 2)⁻¹ + 1)
              = y ^ 2 + (x + (j : ℝ)) ^ 2 := by
            field_simp
          have hsq : (x + (j : ℝ)) ^ 2 + y ^ 2
              ≤ ((x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹)) ^ 2 := by
            rw [mul_pow, hexp2]
            linarith
          calc Real.sqrt ((x + (j : ℝ)) ^ 2 + y ^ 2)
              ≤ Real.sqrt (((x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹)) ^ 2) :=
                Real.sqrt_le_sqrt hsq
            _ = (x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹) :=
                Real.sqrt_sq hR.le
        have hstep1 : (∏ j ∈ Finset.range n, Real.sqrt ((x + (j : ℝ)) ^ 2 + y ^ 2))
            ≤ ∏ j ∈ Finset.range n,
                ((x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹)) :=
          Finset.prod_le_prod (fun j _ => Real.sqrt_nonneg _) hpt
        have hstep2 :
            (∏ j ∈ Finset.range n,
                ((x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹)))
              = (∏ j ∈ Finset.range n, (x + (j : ℝ)))
                * Real.exp (∑ j ∈ Finset.range n, y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹) := by
          rw [Finset.prod_mul_distrib, Real.exp_sum]
        have hexpsum : (∑ j ∈ Finset.range n, y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹) ≤ y ^ 2 := by
          rw [← Finset.mul_sum]
          have hc : (0 : ℝ) ≤ y ^ 2 / 2 := by positivity
          have hh := mul_le_mul_of_nonneg_left (hsum n) hc
          linarith
        have hprodnn : (0 : ℝ) ≤ ∏ j ∈ Finset.range n, (x + (j : ℝ)) := by
          refine Finset.prod_nonneg ?_
          intro j _
          have hj : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
          linarith
        calc (∏ j ∈ Finset.range n, Real.sqrt ((x + (j : ℝ)) ^ 2 + y ^ 2))
            ≤ ∏ j ∈ Finset.range n,
                ((x + (j : ℝ)) * Real.exp (y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹)) := hstep1
          _ = (∏ j ∈ Finset.range n, (x + (j : ℝ)))
                * Real.exp (∑ j ∈ Finset.range n, y ^ 2 / 2 * ((x + (j : ℝ)) ^ 2)⁻¹) := hstep2
          _ ≤ (∏ j ∈ Finset.range n, (x + (j : ℝ))) * Real.exp (y ^ 2) :=
              mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexpsum) hprodnn
          _ = Real.exp (y ^ 2) * ∏ j ∈ Finset.range n, (x + (j : ℝ)) := mul_comm _ _
      have hgs : ∀ n : ℕ, Real.GammaSeq x n * Real.exp (-(y ^ 2))
          ≤ ‖Complex.GammaSeq ((x : ℂ) + (y : ℂ) * Complex.I) n‖ := by
        intro n
        rcases Nat.eq_zero_or_pos n with hn | hn
        · subst hn
          have h0 : Real.GammaSeq x 0 = 0 := by
            rw [Real.GammaSeq]
            simp [Real.zero_rpow hxne]
          rw [h0, zero_mul]
          exact norm_nonneg _
        · have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
          have hfac : (0 : ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
          have hN : (0 : ℝ) < (n : ℝ) ^ x * (n.factorial : ℝ) :=
            mul_pos (Real.rpow_pos_of_pos hnR x) hfac
          have hP' : (0 : ℝ) < ∏ j ∈ Finset.range (n + 1), (x + (j : ℝ)) := by
            refine Finset.prod_pos ?_
            intro j _
            have hj : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
