          have h3 := QuotientGroup.eq.mpr h2
          rw [hout] at h3
          exact h3
        · intro h
          have h3 : (QuotientGroup.mk (Quotient.out (κ.symm i)) :
              (NumberField.RingOfIntegers K)ˣ ⧸ G) = QuotientGroup.mk v := by
            rw [hout]; exact h
          have h2 := QuotientGroup.eq.mp h3
          rw [mul_comm] at h2
          exact h2
      refine ⟨fun i => Quotient.out (κ.symm i), fun v => ⟨κ (QuotientGroup.mk v), ?_, ?_⟩⟩
      · exact (hkey (κ (QuotientGroup.mk v)) v).mpr (by simp)
      · intro i' hi'
        have hi2 := (hkey i' v).mp hi'
        rw [← hi2]
        simp
  refine ⟨H, wq, (D : ℝ) * NumberField.Units.regulator K, e, ?_⟩
  refine ⟨hH1, ⟨hwq0, hwqdvd⟩, ⟨ζ, hζ1, hζord, hrep⟩, fun j => hsum0 (H j), ?_,
    he6, he7, hc8, hc9, hc10⟩
  intro j w
  exact le_trans (hstar j w) (mul_le_mul_of_nonneg_right hB1le hNqpos.le)

theorem kai_tb_exceptional_pair (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q 𝔮D : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : NumberField.RingOfIntegers K → ℤ) (hψ : IsRealRayChar 𝔮D ψ) :
    (∀ (ξ ξ' : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
       (η η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
       (∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
          IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
       (∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
          IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ' η' y = ((ψ y : ℤ) : ℂ)) →
       ξ = ξ' ∧ η = η') ∧
    (∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
       (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
       (∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
          IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
       q ≤ 𝔮D) ∧
    (q ≤ 𝔮D → ∃ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
       (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
       ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
         kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) :=
by
  classical
  obtain ⟨c1, c2, c3, c4, c5, c6⟩ := hψ
  have hq' : q ≠ ⊥ := hq
  
  
  have cop_cong : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (x y : NumberField.RingOfIntegers K),
      x - y ∈ 𝔞 → IsCoprime (Ideal.span {y}) 𝔞 → IsCoprime (Ideal.span {x}) 𝔞 := by
    intro 𝔞 x y hxy hy
    rw [Ideal.isCoprime_iff_sup_eq] at hy ⊢
    rw [eq_top_iff, ← hy]
    apply sup_le _ le_sup_right
    rw [Ideal.span_le, Set.singleton_subset_iff]
    have hmem : x - (x - y) ∈ Ideal.span {x} ⊔ 𝔞 :=
      Submodule.sub_mem _ (Submodule.mem_sup_left (Ideal.mem_span_singleton_self x))
        (Submodule.mem_sup_right hxy)
    simpa using hmem
  have cop_one : ∀ 𝔞 : Ideal (NumberField.RingOfIntegers K),
      IsCoprime (Ideal.span {(1 : NumberField.RingOfIntegers K)}) 𝔞 := by
    intro 𝔞
    rw [Ideal.isCoprime_iff_sup_eq, Ideal.span_singleton_one, top_sup_eq]
  have cop_ne_zero : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (x : NumberField.RingOfIntegers K),
      𝔞 ≠ ⊤ → IsCoprime (Ideal.span {x}) 𝔞 → x ≠ 0 := by
    intro 𝔞 x h𝔞 hx h0
    subst h0
    rw [Ideal.isCoprime_iff_sup_eq, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq] at hx
    exact h𝔞 hx
  have cop_mono : ∀ (A B : Ideal (NumberField.RingOfIntegers K)) (x : NumberField.RingOfIntegers K),
      A ≤ B → IsCoprime (Ideal.span {x}) A → IsCoprime (Ideal.span {x}) B := by
    intro A B x hAB hx
    rw [Ideal.isCoprime_iff_sup_eq] at hx ⊢
    exact top_unique (hx.symm.le.trans (sup_le_sup_left hAB _))
  
  
  have F1 : ψ 1 = 1 := by
    have h1 : ψ 1 ≠ 0 := fun h => ((c2 1).mp h) (cop_one 𝔮D)
    have h2 : ψ 1 = ψ 1 * ψ 1 := by simpa using c3 1 1
    rcases c1 1 with h | h | h
    · exact h
    · rw [h] at h2; norm_num at h2
    · exact absurd h h1
  have F2 : ∀ y : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {y}) 𝔮D →
      ψ y = 1 ∨ ψ y = -1 := by
    intro y hy
    rcases c1 y with h | h | h
    · exact Or.inl h
    · exact Or.inr h
    · exact absurd hy ((c2 y).mp h)
  have F0 : 𝔮D ≠ ⊥ := by
    intro hbot
    obtain ⟨x, y, hx, hy, -, -, hne⟩ := c6 ⊤ (by rw [hbot]; exact bot_lt_top)
    rw [hbot, Ideal.isCoprime_iff_sup_eq, sup_bot_eq, Ideal.span_singleton_eq_top] at hx hy
    apply hne
    have ex : ψ x = ψ 1 := by simpa using c4 hx.unit 1
    have ey : ψ y = ψ 1 := by simpa using c4 hy.unit 1
    rw [ex, ey]
  
  
  have hsgn_eq : ∀ a b : ℝ, 0 < a * b → Real.sign a = Real.sign b := by
    intro a b hab
    rcases lt_trichotomy a 0 with ha | rfl | ha
    · have hb : b < 0 := by
        by_contra hb; push_neg at hb; nlinarith
      rw [Real.sign_of_neg ha, Real.sign_of_neg hb]
    · simp at hab
    · have hb : 0 < b := by
        by_contra hb; push_neg at hb; nlinarith
      rw [Real.sign_of_pos ha, Real.sign_of_pos hb]
  have pchain : ∀ a b c : ℝ, 0 < a * b → 0 < b * c → 0 < a * c := by
    intro a b c h1 h2
    have h3 := mul_pos h1 h2
    have e : a * b * (b * c) = (a * c) * (b * b) := by ring
    rw [e] at h3
    by_contra hc
    push_neg at hc
    nlinarith [mul_self_nonneg b]
  have hembne : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ (w : {w : NumberField.InfinitePlace K // w.IsReal}),
        NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) ≠ 0 := by
    intro x hx w
    exact (map_ne_zero _).mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx)
  
  
  obtain ⟨S, hS⟩ : ∃ S : ({w : NumberField.InfinitePlace K // w.IsReal} → Bool) →
      NumberField.RingOfIntegers K → ℂ, ∀ η x, S η x =
        ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (if η w then
            ((Real.sign (NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K)) : ℝ) : ℂ)
           else 1) := ⟨_, fun _ _ => rfl⟩
  have hTa : ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
      (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (x : NumberField.RingOfIntegers K) (u : (NumberField.RingOfIntegers K ⧸ q)ˣ),
      Ideal.Quotient.mk q x = (u : NumberField.RingOfIntegers K ⧸ q) →
      kaiHeckeTwist K q 0 0 ξ η x = (ξ u : ℂ) * S η x := by
    intro ξ η x u hu
    have hx : IsUnit (Ideal.Quotient.mk q x) := hu ▸ u.isUnit
    have hxu : hx.unit = u := Units.ext (by rw [IsUnit.unit_spec]; exact hu)
    rw [hS]
    unfold kaiHeckeTwist
    rw [dif_pos hx, hxu]
    simp [NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
  have hTb : ∀ x : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {x}) q →
      ∃ u : (NumberField.RingOfIntegers K ⧸ q)ˣ,
        Ideal.Quotient.mk q x = (u : NumberField.RingOfIntegers K ⧸ q) := by
    intro x h
    rw [Ideal.isCoprime_iff_sup_eq] at h
    have h1 : (1 : NumberField.RingOfIntegers K) ∈ Ideal.span {x} ⊔ q := by
      rw [h]; exact Submodule.mem_top
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    have hrx : Ideal.Quotient.mk q x * Ideal.Quotient.mk q r = 1 := by
      rw [← map_mul, ← map_one (Ideal.Quotient.mk q), Ideal.Quotient.eq]
      have : x * r - 1 = -b := by rw [← hab]; ring
      rw [this]; exact q.neg_mem hb
    have hxu : IsUnit (Ideal.Quotient.mk q x) := isUnit_iff_exists_inv.mpr ⟨_, hrx⟩
    exact ⟨hxu.unit, hxu.unit_spec.symm⟩
  have hTc : ∀ (x : NumberField.RingOfIntegers K) (u : (NumberField.RingOfIntegers K ⧸ q)ˣ),
      Ideal.Quotient.mk q x = (u : NumberField.RingOfIntegers K ⧸ q) →
      IsCoprime (Ideal.span {x}) q := by
    intro x v hv
    rw [Ideal.isCoprime_iff_sup_eq]
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑v⁻¹ : NumberField.RingOfIntegers K ⧸ q)
    have hxy : Ideal.Quotient.mk q (x * y) = Ideal.Quotient.mk q 1 := by
      rw [map_mul, hy, hv, map_one]; exact v.mul_inv
    rw [Ideal.Quotient.eq] at hxy
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : NumberField.RingOfIntegers K) = x * y - (x * y - 1) := by ring
    rw [h1]
    exact Submodule.sub_mem _
      (Submodule.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self x)))
      (Submodule.mem_sup_right hxy)
  
  have S_eq : ∀ η (x y : NumberField.RingOfIntegers K),
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        0 < NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) *
          NumberField.InfinitePlace.embedding_of_isReal w.2 (y : K)) → S η x = S η y := by
    intro η x y hxy
    rw [hS, hS]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    rw [hsgn_eq _ _ (hxy w)]
  have S_split : ∀ η (x : NumberField.RingOfIntegers K), x ≠ 0 →
      S η x = ∏ w ∈ Finset.univ.filter (fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
          NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) < 0),
        (if η w then (-1 : ℂ) else 1) := by
    intro η x hx
    rw [hS, Finset.prod_filter]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    rcases lt_or_gt_of_ne (hembne x hx w) with h | h
    · rw [Real.sign_of_neg h, if_pos h]
      split_ifs <;> push_cast <;> rfl
    · rw [Real.sign_of_pos h, if_neg (not_lt.mpr h.le)]
      split_ifs <;> simp
  have S_ne : ∀ η (x : NumberField.RingOfIntegers K), x ≠ 0 → S η x ≠ 0 := by
    intro η x hx
    rw [S_split η x hx]
    exact Finset.prod_ne_zero_iff.mpr (fun w _ => by split_ifs <;> norm_num)
  have S_test : ∀ η (y : NumberField.RingOfIntegers K)
      (w₀ : {w : NumberField.InfinitePlace K // w.IsReal}),
      NumberField.InfinitePlace.embedding_of_isReal w₀.2 (y : K) < 0 →
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, w ≠ w₀ →
        0 < NumberField.InfinitePlace.embedding_of_isReal w.2 (y : K)) →
      S η y = if η w₀ then (-1 : ℂ) else 1 := by
    intro η y w₀ hneg hpos
    rw [hS, Finset.prod_eq_single w₀]
    · rw [Real.sign_of_neg hneg]; split_ifs <;> push_cast <;> rfl
    · intro b _ hb
      rw [Real.sign_of_pos (hpos b hb)]; split_ifs <;> simp
    · intro h; exact absurd (Finset.mem_univ w₀) h
  
  
  have hC : ∀ (I J : Ideal (NumberField.RingOfIntegers K)), J ≠ ⊥ →
      ∀ y : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {y}) I →
      ∃ m ∈ I, IsCoprime (Ideal.span {y + m}) J := by
    intro I J hJ y hy
    rw [Ideal.isCoprime_iff_sup_eq] at hy
    obtain ⟨d, hd⟩ := IsDedekindDomain.exists_sup_span_eq (le_sup_left : J ≤ J ⊔ I) hJ
    have hdmem : d ∈ J ⊔ I := by
      rw [← hd]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self d)
    obtain ⟨j, hj, i, hi, hji⟩ := Submodule.mem_sup.mp hdmem
    have hJi : J ⊔ Ideal.span {i} = J ⊔ I := by
      apply le_antisymm
      · exact sup_le le_sup_left
          (by rw [Ideal.span_le, Set.singleton_subset_iff]; exact Ideal.mem_sup_right hi)
      · rw [← hd]
        apply sup_le le_sup_left
        rw [Ideal.span_le, Set.singleton_subset_iff, ← hji]
        exact Submodule.add_mem _ (Ideal.mem_sup_left hj)
          (Ideal.mem_sup_right (Ideal.mem_span_singleton_self i))
    haveI : Finite (NumberField.RingOfIntegers K ⧸ J) := Ideal.finiteQuotientOfFreeOfNeBot J hJ
    obtain ⟨i₀, j₀, hij, hfij⟩ := Finite.exists_ne_map_eq_of_infinite
      (fun n : ℕ => Ideal.Quotient.mk J (i ^ n))
    obtain ⟨a, k, hk, hak⟩ : ∃ a k : ℕ, 0 < k ∧ i ^ (a + k) - i ^ a ∈ J := by
      rcases lt_or_gt_of_ne hij with h | h
      · refine ⟨i₀, j₀ - i₀, Nat.sub_pos_of_lt h, ?_⟩
        rw [Nat.add_sub_cancel' h.le, ← Ideal.Quotient.eq]; exact hfij.symm
      · refine ⟨j₀, i₀ - j₀, Nat.sub_pos_of_lt h, ?_⟩
        rw [Nat.add_sub_cancel' h.le, ← Ideal.Quotient.eq]; exact hfij
    have heI : i ^ k ∈ I := Ideal.pow_mem_of_mem I hi k hk
    refine ⟨i ^ k * (1 - y), Ideal.mul_mem_right _ _ heI, ?_⟩
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra hne
    obtain ⟨P, hPmax, hPle⟩ := Ideal.exists_le_maximal _ hne
    have hxP : y + i ^ k * (1 - y) ∈ P :=
      hPle (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
    have hJP : J ≤ P := le_trans le_sup_right hPle
    by_cases hIP : I ≤ P
    · have hyP : y ∈ P := by
        have h1 : y + i ^ k * (1 - y) - i ^ k * (1 - y) = y := by ring
        rw [← h1]; exact P.sub_mem hxP (Ideal.mul_mem_right _ _ (hIP heI))
      apply hPmax.ne_top
      rw [eq_top_iff, ← hy]
      exact sup_le (by rw [Ideal.span_le, Set.singleton_subset_iff]; exact hyP) hIP
    · have hiP : i ∉ P := by
        intro hiP
        apply hIP
        calc I ≤ J ⊔ I := le_sup_right
          _ = J ⊔ Ideal.span {i} := hJi.symm
          _ ≤ P := sup_le hJP (by rw [Ideal.span_le, Set.singleton_subset_iff]; exact hiP)
      have hiaP : i ^ a ∉ P := fun h => hiP (hPmax.isPrime.mem_of_pow_mem a h)
      have he1 : i ^ k - 1 ∈ P := by
        have h1 : i ^ a * (i ^ k - 1) ∈ P := by
          have e : i ^ a * (i ^ k - 1) = i ^ (a + k) - i ^ a := by rw [pow_add]; ring
          rw [e]; exact hJP hak
        exact (hPmax.isPrime.mem_or_mem h1).resolve_left hiaP
      apply hPmax.ne_top
      rw [Ideal.eq_top_iff_one]
      have h1 : (1 : NumberField.RingOfIntegers K) =
          (y + i ^ k * (1 - y)) + (y - 1) * (i ^ k - 1) := by ring
      rw [h1]
      exact P.add_mem hxP (Ideal.mul_mem_left _ _ he1)
  
  
  have hL : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)), 𝔞 ≠ ⊥ →
      ∀ y x : NumberField.RingOfIntegers K, x ≠ 0 →
      ∃ z : NumberField.RingOfIntegers K, z ≠ 0 ∧ z - y ∈ 𝔞 ∧
        ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          0 < NumberField.InfinitePlace.embedding_of_isReal w.2 (z : K) *
            NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) := by
    intro 𝔞 h𝔞 y x hx
    obtain ⟨n, hn⟩ : ∃ n : ℕ, n = Ideal.absNorm 𝔞 := ⟨_, rfl⟩
    have hn0 : n ≠ 0 := by
      rw [hn]; exact fun h => h𝔞 (Ideal.absNorm_eq_zero_iff.mp h)
    have hnq : ((n : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔞 := by
      rw [hn]; exact Ideal.absNorm_mem 𝔞
    have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hn0
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M = ∑ v : {w : NumberField.InfinitePlace K // w.IsReal},
        |NumberField.InfinitePlace.embedding_of_isReal v.2 (y : K)| /
          |NumberField.InfinitePlace.embedding_of_isReal v.2 (x : K)| := ⟨_, rfl⟩
    have key : ∀ k : ℕ, M < k → ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        0 < NumberField.InfinitePlace.embedding_of_isReal w.2
              (((y + (k : NumberField.RingOfIntegers K) * (n : NumberField.RingOfIntegers K) * x :
                NumberField.RingOfIntegers K)) : K) *
            NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) := by
      intro k hk w
      have hle : |NumberField.InfinitePlace.embedding_of_isReal w.2 (y : K)| /
          |NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K)| ≤ M := by
        rw [hM]
        exact Finset.single_le_sum
          (f := fun v : {w : NumberField.InfinitePlace K // w.IsReal} =>
            |NumberField.InfinitePlace.embedding_of_isReal v.2 (y : K)| /
              |NumberField.InfinitePlace.embedding_of_isReal v.2 (x : K)|)
          (fun _ _ => by positivity) (Finset.mem_univ w)
      have hexp : NumberField.InfinitePlace.embedding_of_isReal w.2
          (((y + (k : NumberField.RingOfIntegers K) * (n : NumberField.RingOfIntegers K) * x :
            NumberField.RingOfIntegers K)) : K) =
          NumberField.InfinitePlace.embedding_of_isReal w.2 (y : K) +
            (k : ℝ) * (n : ℝ) * NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) := by
        simp only [map_add, map_mul, map_natCast]
      rw [hexp]
      have he : NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) ≠ 0 := hembne x hx w
      generalize NumberField.InfinitePlace.embedding_of_isReal w.2 (y : K) = Y at hle ⊢
      generalize NumberField.InfinitePlace.embedding_of_isReal w.2 (x : K) = e at hle he ⊢
      have hepos : 0 < |e| := abs_pos.mpr he
      have hY : |Y| ≤ M * |e| := (div_le_iff₀ hepos).mp hle
      have h1 : -(|Y| * |e|) ≤ Y * e := by rw [← abs_mul]; exact neg_abs_le _
      have h2 : |e| * |e| = e * e := abs_mul_abs_self e
      have h3 : 0 < e * e := mul_self_pos.mpr he
      have hA : |Y| * |e| ≤ M * (e * e) := by
        rw [← h2, ← mul_assoc]; exact mul_le_mul_of_nonneg_right hY (abs_nonneg e)
      have hB : M * (e * e) < (k : ℝ) * (e * e) := mul_lt_mul_of_pos_right hk h3
      have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
      have hC' : (k : ℝ) * (e * e) ≤ (k : ℝ) * (n : ℝ) * (e * e) := by
        have h4 := mul_le_mul_of_nonneg_left hn1 (mul_nonneg hk0 h3.le)
        calc (k : ℝ) * (e * e) = (k : ℝ) * (e * e) * 1 := by ring
          _ ≤ (k : ℝ) * (e * e) * n := h4
          _ = (k : ℝ) * (n : ℝ) * (e * e) := by ring
      have hexp2 : (Y + (k : ℝ) * (n : ℝ) * e) * e = Y * e + (k : ℝ) * (n : ℝ) * (e * e) := by
        ring
      rw [hexp2]
      linarith
    obtain ⟨k, hk⟩ := exists_nat_gt M
    have hmem : ∀ k' : ℕ, y + (k' : NumberField.RingOfIntegers K) *
        (n : NumberField.RingOfIntegers K) * x - y ∈ 𝔞 := by
      intro k'
      have e : y + (k' : NumberField.RingOfIntegers K) * (n : NumberField.RingOfIntegers K) * x - y
          = ((k' : NumberField.RingOfIntegers K) * (n : NumberField.RingOfIntegers K)) * x := by ring
      rw [e]; exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hnq)
    by_cases hz : y + (k : NumberField.RingOfIntegers K) * (n : NumberField.RingOfIntegers K) * x = 0
    · refine ⟨y + ((k + 1 : ℕ) : NumberField.RingOfIntegers K) * (n : NumberField.RingOfIntegers K) * x,
        ?_, hmem (k + 1), key (k + 1) (by push_cast; linarith)⟩
      intro h
