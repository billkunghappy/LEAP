    have hE_le : ((m:ℝ) + 1) ^ k * E ≤ 3 ^ (Module.finrank ℚ K - 1) * C₁ * A := by
      have hX₀M : X₀ * ((m:ℝ) + 1) ^ k ≤ M ^ ((1:ℝ)/4) := hX0M
      have hX₀M' : X₀ ≤ M ^ ((1:ℝ)/4) := le_trans (le_mul_of_one_le_right hX₀0 hmk1) hX₀M
