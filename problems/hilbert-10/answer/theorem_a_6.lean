              · subst h; exact absurd h3 hp
              · omega
            · rintro ⟨⟨h1, h2⟩, h3⟩
              exact ⟨⟨by omega, h2⟩, h3⟩
          rw [heq]
          have ihl := ih (hi - (lo + 1)) (by omega) (lo + 1) rfl (by omega)
            (fun j h1 h2 => hmono j (by omega) h2)
          have := hmono lo le_rfl hlt
