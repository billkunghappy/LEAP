          - M (y + x - y) * (y + x - y)).val : ℝ) / P)) =
        (((g (y + x) : ℝ) : ℂ) * giE (((M x * x - (ξ₀ + 2 * M h') * (y + x)).val : ℝ) / P)) *
          giE (-(((ζ * x).val : ℝ) / P)) := by
      intro x _
      rw [add_sub_cancel_left, ← hEzneg, ← hEzneg, mul_assoc (((g (y + x) : ℝ) : ℂ)),
        ← hEzadd]
      rw [show -((ξ₀ + 2 * M h') * y + ((ξ₀ + 2 * M h') + ζ) * x - M x * x)
