  (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      if sgn w then
        0 < (NumberField.mixedEmbedding K ((π : NumberField.RingOfIntegers K) : K)).1 w
      else (NumberField.mixedEmbedding K ((π : NumberField.RingOfIntegers K) : K)).1 w < 0) ∧
  (((Algebra.norm ℤ π).natAbs : ℝ) ≤ x) ∧
  (∀ j, kaiTBPair K (e j) ((π : NumberField.RingOfIntegers K) : K)
      ∈ Set.Ioc (u j) (u j + γ j)) ∧
  (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ∃ k : ℤ,
      kaiTBTheta K H e p ((π : NumberField.RingOfIntegers K) : K) - vv p - (k : ℝ)
        ∈ Set.Ioc (0 : ℝ) (ϑ p))

