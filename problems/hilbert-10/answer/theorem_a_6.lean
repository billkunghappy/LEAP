              · rw [max_eq_right h2] at hA
                linarith
              · rw [max_eq_left h2] at hA
                have := mul_le_mul_of_nonneg_right hA hv0.le
                linarith
          rw [hD0, sub_zero, abs_of_nonneg hGp.1]
          linarith [hGp.2]
        · have hP : max Ep T = Ep := max_eq_left (by linarith)
          have hEmEp : Em < Ep := by linarith
          have hDeq : max (F (max Ep T) - F (max Em T)) 0 = F Ep - F (max Em T) := by
            rw [hP]; exact max_eq_left (hF' _ _ (by linarith) hB.le).1
          have hb' : max (Ep * u) (max (Em * v) T) = Ep * u := max_eq_left (by linarith)
          have h1 := hF' Ep (Ep * u) (by linarith) hEpuge
          have h2 := hF' (max (Em * v) T) (max Em T) (by linarith) ha'a
          have haa : max Em T - max (Em * v) T ≤ Ep - Ep * v := by
