  have E2 : (∫ u in G, ((max (-(g u).re) 0 : ℝ) : ℂ) * φ (∑ j, m j * u j))
      = (((∫ u in G ∩ Ω, max (-(g u).re) 0) : ℝ) : ℂ) * ∫ t : ℝ, φ t := I2.2
  have E3 : (∫ u in G, ((max ((g u).im) 0 : ℝ) : ℂ) * φ (∑ j, m j * u j))
