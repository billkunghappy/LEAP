    (div_le_one hpi2).mpr hprodle
  
  have hCq : 0 ≤ ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
        (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
          (NumberField.classNumber K : ℝ) *
          (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
          NumberField.Units.regulator K) ∧
      ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
        (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
          (NumberField.classNumber K : ℝ) *
          (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
          NumberField.Units.regulator K)
        ≤ ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * B / NumberField.Units.regulator K
          * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K := by
    have hRq := hdata.2.2.2.2.2.2.2.2.1
    have hKN : 0 ≤ ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * B
