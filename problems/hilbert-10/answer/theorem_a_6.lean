  have hgow' : ∀ i, gowersU3Pow ω (fun x => f i x - g i x) R ≤ δ ^ (4 * d + 8) := by
    intro i
    have h := hgow i
    rwa [show 4 * d + 7 + 1 = 4 * d + 8 by ring] at h
  have hN0 : (0:ℝ) ≤ N := Nat.cast_nonneg N
  have hd0 : (0:ℝ) ≤ d := Nat.cast_nonneg d
  have hR0 : 0 ≤ R := by rw [hR_def]; positivity
  have hTpos : 0 < T := by linarith
  have hT0 : T ≠ 0 := hTpos.ne'
  
  have hLd1 : 1 ≤ L ^ d := one_le_pow₀ hL
  have hLK : L ^ d ≤ L ^ (d + 2 * Module.finrank ℚ K) := pow_le_pow_right₀ hL (by omega)
