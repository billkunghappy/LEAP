  obtain ⟨hsumA, hprod4⟩ :=
    kai_ideal_dirichlet_conv_series K lam δ δ aa hbd hδbd hδbd haa0 hzeta hconv4
  have hδser : ∀ s : ℂ, (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
