  obtain ⟨A₈, hA₈⟩ : ∃ A₈ : ℕ, A₈ = A + 3 + K := ⟨_, rfl⟩
  refine ⟨A₈, by omega, ?_⟩
  intro D Q η C₁ a hD hQ hη hη1 hC₁ ha
