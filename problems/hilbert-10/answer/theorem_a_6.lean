          ≤ 1 / (2 * d) := by
      intro y a b
      obtain ⟨c, hc⟩ : ∃ c : ℝ, c = ∑ k, lam k * ((Function.update y l 0 k : ℤ) : ℝ) :=
        ⟨_, rfl⟩
