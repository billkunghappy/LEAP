  refine ⟨?_, fun s hs => (key s hs).2⟩
  intro σ hσ
  have hre : (1 : ℝ) < (((σ : ℝ) : ℂ)).re := by
    simpa using hσ
  have hid : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
