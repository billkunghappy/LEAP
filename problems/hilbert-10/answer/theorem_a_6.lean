  have hx0 : 0 < x := lt_of_lt_of_le hc0 hcx
  have hδ0 : 0 < x / L := div_pos hx0 hLpos
  have hδle : x / L ≤ x := div_le_self hx0.le hL1
  have hzre1 : 1 < z.re := by rw [hzre]; linarith
  
  have hgrowth : ∀ w ∈ Metric.closedBall z 1, ∃ X : ℝ, 0 ≤ X ∧ X ≤ 2 * Real.exp L ∧
