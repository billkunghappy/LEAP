    have hgrowth : ∀ z ∈ Metric.closedBall s₁ 1, ∃ X : ℝ, 0 ≤ X ∧
        X ≤ 3 / 2 * Real.exp L ∧ ‖G z‖ ≤ A * X ^ A := by
      intro z hz
      rw [Metric.mem_closedBall, Complex.dist_eq] at hz
      have hre := (Complex.abs_re_le_norm (z - s₁)).trans hz
      have him := (Complex.abs_im_le_norm (z - s₁)).trans hz
      rw [Complex.sub_re, hs₁re] at hre
      rw [Complex.sub_im, hs₁im] at him
      rw [abs_le] at hre
      have hab : |z.im| ≤ |s.im| + 1 := by
        have := abs_sub_abs_le_abs_sub z.im s.im; linarith
      refine ⟨(Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l) * (2 + |z.im|), ?_, ?_,
        H2 q hq t l ξ η lam hext htr E G hE hEiff hG hGeq z (by linarith) (by linarith)⟩
      · rw [← ha_def]; exact mul_nonneg ha0 (by positivity)
      · rw [← ha_def, hexpL]
        nlinarith [mul_le_mul_of_nonneg_left hab ha0, mul_nonneg ha0 (abs_nonneg s.im)]
    have hs₁gt : 1 < s₁.re := by rw [hs₁re]; exact hσ₁gt
    obtain ⟨hGs₁, hlows₁, hders₁⟩ := H1 q hq t l ξ η lam hext E G hE hGeq s₁ hs₁gt
    rw [hs₁re, hinv] at hlows₁
    rw [hs₁re] at hders₁
    obtain ⟨Z, mult, hZ1, hZ2, hZ3, hZ5⟩ :=
      H3 (Module.finrank ℚ K) A L G s₁ hA1 hL1 hG hgrowth hGs₁ hlows₁
    
    have hWc : ‖∑ ρ ∈ Z, (mult ρ : ℂ) / (s₁ - ρ)‖ ≤ (8 * DK + 8 + A₃) * L := by
      have h5 := hZ5 s₁ (Metric.mem_closedBall_self (by norm_num)) hGs₁
      rw [← hA₃_def] at h5
      have hder := hders₁ (by linarith)
      have hval : (DK + 1) / (σ₁ - 1) = (DK + 1) * (8 * L) := by
        rw [div_eq_mul_one_div, hinv]
      rw [hval] at hder
      have htri := norm_sub_le (deriv G s₁ / G s₁)
        (deriv G s₁ / G s₁ - ∑ ρ ∈ Z, (mult ρ : ℂ) / (s₁ - ρ))
      rw [sub_sub_cancel] at htri
      nlinarith
    
    have hRe : ∀ ρ ∈ Z, (m = 1 → ρ ≠ (β₀ : ℂ)) → ρ.re ≤ 1 - 8 * B / (9 * L) := by
      intro ρ hρ hne
      obtain ⟨hρball, hρz, -⟩ := hZ1 ρ hρ
      rw [Metric.mem_closedBall, Complex.dist_eq] at hρball
      have hre := (Complex.abs_re_le_norm (ρ - s₁)).trans hρball
      have him := (Complex.abs_im_le_norm (ρ - s₁)).trans hρball
      rw [Complex.sub_re, hs₁re] at hre
      rw [Complex.sub_im, hs₁im] at him
      rw [abs_le] at hre
      by_contra hcon
      push_neg at hcon
      have hpos : 1 < 3 + a * (2 + |ρ.im|) := by
        have : 0 ≤ a * (2 + |ρ.im|) := mul_nonneg ha0 (by positivity)
        linarith
      have hℓpos : 0 < Real.log (3 + a * (2 + |ρ.im|)) := Real.log_pos hpos
      have hℓle := hcond ρ.im him
      have hB' : 8 * B / (9 * L) ≤ B / Real.log (3 + a * (2 + |ρ.im|)) := by
        rw [div_le_div_iff₀ (by positivity) hℓpos]
        nlinarith
      obtain ⟨hm1, hρβ⟩ := hzero ρ (by linarith) (by rw [← ha_def]; linarith) hρz
      exact hne hm1 hρβ
    have hD := hZ5 s hsball hGs0
    rw [← hA₃_def] at hD
    have hW₀L : 0 ≤ W₀ * L := mul_nonneg hW₀.le hLpos.le
    have he0 : 0 < 23 * B / (36 * L) := by positivity
    have hhd : 3 / (8 * L) ≤ 3 * (1 / (8 * L)) := le_of_eq (by ring)
    have hhe : 3 / (8 * L) ≤ 1 / B * (23 * B / (36 * L)) := by
      have e1 : 1 / B * (23 * B / (36 * L)) = 23 / (36 * L) := by
        rw [div_mul_div_comm, one_mul, div_eq_div_iff (by positivity) (by positivity)]
        ring
      rw [e1, div_le_div_iff₀ (by positivity) (by positivity)]
      nlinarith
    have he_eq : 8 * B / (9 * L) - B / (4 * L) = 23 * B / (36 * L) := by
      rw [div_sub_div _ _ (by positivity) (by positivity),
        div_eq_div_iff (by positivity) (by positivity)]
      ring
    have hshift : ∀ Zs : Finset ℂ, (∀ ρ ∈ Zs, ρ.re ≤ 1 - 8 * B / (9 * L)) →
        ‖∑ ρ ∈ Zs, (mult ρ : ℂ) / (s₁ - ρ)‖ ≤ W₀ * L →
        ‖∑ ρ ∈ Zs, (mult ρ : ℂ) / (s - ρ)‖ ≤ W₀ * L * κ := by
      intro Zs hreZs hcenZs
      have hd' : ∀ ρ ∈ Zs, 1 / (8 * L) ≤ (s₁ - ρ).re := by
        intro ρ hρ
        have := hreZs ρ hρ
        have h89 : 0 ≤ 8 * B / (9 * L) := by positivity
        rw [Complex.sub_re, hs₁re]
        linarith
      have he' : ∀ ρ ∈ Zs, 23 * B / (36 * L) ≤ ‖s - ρ‖ := by
        intro ρ hρ
        have := hreZs ρ hρ
        have h2 : (s - ρ).re ≤ ‖s - ρ‖ := Complex.re_le_norm _
        rw [Complex.sub_re] at h2
        linarith
      have := hshiftA Zs mult s s₁ (1 / (8 * L)) (23 * B / (36 * L)) (3 / (8 * L)) (W₀ * L) 3
        (1 / B) hd0 he0 hW₀L (by norm_num) hBinv.le hss hhd hhe hd' he' hcenZs
      rw [hκ_def]; exact this
    have hWcW : (8 * DK + 8 + A₃) * L ≤ W₀ * L := by rw [hW₀_def]; nlinarith
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hm with hm0 | hm1
    · 
      subst hm0
      have hS := hshift Z (fun ρ hρ => hRe ρ hρ (fun h => absurd h (by norm_num)))
        (hWc.trans hWcW)
      simp only [Nat.cast_zero, zero_div, sub_zero]
      have htri := norm_add_le
        (deriv G s / G s - ∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ))
        (∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ))
      rw [sub_add_cancel] at htri
      apply hfinal
      nlinarith
    · 
      subst hm1
      obtain ⟨hβz, hβd⟩ := hsimp rfl
      simp only [Nat.cast_one]
      have hβre : (s₁ - (β₀ : ℂ)).re = σ₁ - β₀ := by
        rw [Complex.sub_re, hs₁re, Complex.ofReal_re]
      by_cases hnear : ‖s₁ - (β₀ : ℂ)‖ ≤ 1 / 2
      · have hβball : (β₀ : ℂ) ∈ Metric.closedBall s₁ (1 / 2) := by
          rw [Metric.mem_closedBall, Complex.dist_eq, norm_sub_rev]; exact hnear
        have hβZ := hZ2 _ hβball hβz
        have hmult := hZ3 _ hβZ hβd
        have hsplit : ∀ z : ℂ, ∑ ρ ∈ Z, (mult ρ : ℂ) / (z - ρ)
            = 1 / (z - (β₀ : ℂ)) + ∑ ρ ∈ Z.erase (β₀ : ℂ), (mult ρ : ℂ) / (z - ρ) := by
          intro z
          rw [← Finset.add_sum_erase Z _ hβZ, hmult, Nat.cast_one]
        have hcen1 : ‖(1 : ℂ) / (s₁ - (β₀ : ℂ))‖ ≤ 8 * L := by
          have hx : σ₁ - β₀ ≤ ‖s₁ - (β₀ : ℂ)‖ := by
            rw [← hβre]; exact Complex.re_le_norm _
          have h := hnormC _ (σ₁ - β₀) (by linarith) hx 1 le_rfl
          rw [Nat.cast_one] at h
          refine h.trans ?_
          rw [div_le_iff₀ (by linarith)]
          have e1 : 8 * L * (σ₁ - β₀) = 8 * L * (1 / (8 * L)) + 8 * L * (1 - β₀) := by
            rw [hσ₁_def]; ring
          have := mul_pos (by linarith : (0 : ℝ) < 8 * L) (sub_pos.2 hβ1)
          linarith
        have hcenZ' : ‖∑ ρ ∈ Z.erase (β₀ : ℂ), (mult ρ : ℂ) / (s₁ - ρ)‖ ≤ W₀ * L := by
          have hs := hsplit s₁
          have heq : ∑ ρ ∈ Z.erase (β₀ : ℂ), (mult ρ : ℂ) / (s₁ - ρ)
              = ∑ ρ ∈ Z, (mult ρ : ℂ) / (s₁ - ρ) - 1 / (s₁ - (β₀ : ℂ)) := by
            rw [hs]; ring
          rw [heq]
          refine (norm_sub_le _ _).trans ?_
          rw [hW₀_def]
          nlinarith
        have hreZ' : ∀ ρ ∈ Z.erase (β₀ : ℂ), ρ.re ≤ 1 - 8 * B / (9 * L) := by
          intro ρ hρ
          exact hRe ρ (Finset.mem_of_mem_erase hρ) (fun _ => Finset.ne_of_mem_erase hρ)
        have hS := hshift _ hreZ' hcenZ'
        have heq : deriv G s / G s - 1 / (s - (β₀ : ℂ))
            = (deriv G s / G s - ∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ))
              + ∑ ρ ∈ Z.erase (β₀ : ℂ), (mult ρ : ℂ) / (s - ρ) := by
          rw [hsplit s]; ring
        rw [heq]
        refine (norm_add_le _ _).trans ?_
        apply hfinal
        nlinarith
      · push_neg at hnear
        have hβnot : (β₀ : ℂ) ∉ Z := by
          intro hβZ
          have hb := (hZ1 _ hβZ).1
          rw [Metric.mem_closedBall, Complex.dist_eq, norm_sub_rev] at hb
          linarith
        have hreZ : ∀ ρ ∈ Z, ρ.re ≤ 1 - 8 * B / (9 * L) := by
          intro ρ hρ
          exact hRe ρ hρ (fun _ h => hβnot (h ▸ hρ))
        have hS := hshift Z hreZ (hWc.trans hWcW)
        have hsβ : 1 / 4 ≤ ‖s - (β₀ : ℂ)‖ := by
          have h1 := norm_add_le (s - (β₀ : ℂ)) (s₁ - s)
          have e : s - (β₀ : ℂ) + (s₁ - s) = s₁ - (β₀ : ℂ) := by ring
          rw [e, norm_sub_rev s₁ s] at h1
          linarith
        have hb4 : ‖(1 : ℂ) / (s - (β₀ : ℂ))‖ ≤ 4 * L := by
          have h := hnormC _ (1 / 4) (by norm_num) hsβ 1 le_rfl
          rw [Nat.cast_one] at h
          refine h.trans ?_
          norm_num
          linarith
        have heq : deriv G s / G s - 1 / (s - (β₀ : ℂ))
            = (deriv G s / G s - ∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ))
              + (∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ) - 1 / (s - (β₀ : ℂ))) := by
          ring
        rw [heq]
        refine (norm_add_le _ _).trans ?_
        have h2 := norm_sub_le (∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ))
          (1 / (s - (β₀ : ℂ)))
        apply hfinal
        nlinarith

theorem kai_hecke_zero_free_eff (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ B C : ℝ, 0 < B ∧ B ≤ 1 ∧ 0 < C ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ (t : NumberField.InfinitePlace K → ℝ)
          (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
          (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
          (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
          KaiHeckeExt K q t l ξ η lam →
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
          ∀ (E : ℕ) (G : ℂ → ℂ), E ≤ 1 →
            (E = 1 ↔ KaiHeckePrincipal K q lam) → Differentiable ℂ G →
            (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) →
            ∃ (m : ℕ) (β₀ : ℝ),
              m ≤ 1 ∧ (0 : ℝ) ≤ β₀ ∧ β₀ < 1 ∧
              (m = 1 → kaiInfSize K t l = 1 ∧ ¬ KaiHeckePrincipal K q lam ∧
                  ∀ I : Ideal (NumberField.RingOfIntegers K),
                    lam I = (starRingEnd ℂ) (lam I)) ∧
              (∀ s : ℂ, s.re ≤ 2 →
                  1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
                    * (2 + |s.im|)) ≤ s.re →
                  G s = 0 → m = 1 ∧ s = (β₀ : ℂ)) ∧
              (∀ s : ℂ, s.re ≤ 2 →
                  1 - B / (4 * Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
                    * (2 + |s.im|))) ≤ s.re →
                  ‖deriv G s / G s - (m : ℂ) / (s - (β₀ : ℂ))‖
                    ≤ C * Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
                      * (2 + |s.im|))) :=
by
  classical
  have hL : KaiZFLandauExpProp := kai_landau_logderiv_expansion
  have hcont : KaiZFZetaContProp K := kai_hecke_zeta_continuation K
  have hser := kai_hecke_series_basics_00 K
  have hpos := kai_hecke_char_positivity_00 K
  have hone := kai_hecke_real_one_ne_zero_00 K
  have hgen := kai_hecke_gen_char_basics K hser
  have htriv := kai_hecke_real_trivial_infinity K
  obtain ⟨B₁, hB₁, hB₁1, H₁⟩ := kai_hecke_no_zero_principal_00 K hL hcont hser hpos
  obtain ⟨B₂, hB₂, hB₂1, H₂⟩ := kai_hecke_zero_free_nonprincipal_00 K hL hcont hser hpos hone
  obtain ⟨B₃, hB₃, hB₃1, H₃⟩ := kai_hecke_zero_free_nonreal K hL hcont hser hpos hgen
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = min (min B₁ B₂) B₃ := ⟨_, rfl⟩
  have hB : 0 < B := by rw [hBdef]; exact lt_min (lt_min hB₁ hB₂) hB₃
  have hBB₁ : B ≤ B₁ := by rw [hBdef]; exact le_trans (min_le_left _ _) (min_le_left _ _)
  have hBB₂ : B ≤ B₂ := by rw [hBdef]; exact le_trans (min_le_left _ _) (min_le_right _ _)
  have hBB₃ : B ≤ B₃ := by rw [hBdef]; exact min_le_right _ _
  have hB1 : B ≤ 1 := hBB₁.trans hB₁1
  obtain ⟨C, hC, H₄⟩ := kai_hecke_logderiv_bound_gen K hL hcont hser hgen B hB hB1
  refine ⟨B, C, hB, hB1, hC, ?_⟩
  intro q hq t l ξ η lam hext htr E G hE hEiff hGd hGeq
  
  have hmono : ∀ b L₁ L₂ σ : ℝ, B ≤ b → 0 < L₁ → L₁ ≤ L₂ →
      1 - B / L₂ ≤ σ → 1 - b / L₁ ≤ σ := by
    intro b L₁ L₂ σ hBb hL₁ hL₁₂ hσ
    have hL₂ : 0 < L₂ := lt_of_lt_of_le hL₁ hL₁₂
    have hb : 0 ≤ b := le_trans hB.le hBb
    have h1 : B / L₂ ≤ b / L₂ := div_le_div_of_nonneg_right hBb hL₂.le
    have h2 : b / L₂ ≤ b / L₁ := div_le_div_of_nonneg_left hb hL₁ hL₁₂
    linarith
  have hNq : (0 : ℝ) ≤ (Ideal.absNorm q : ℝ) := Nat.cast_nonneg _
  have hinf : 1 ≤ kaiInfSize K t l := by
    unfold kaiInfSize
    have h1 : 0 ≤ ∑ w : NumberField.InfinitePlace K, |t w| :=
      Finset.sum_nonneg (fun w _ => abs_nonneg (t w))
    have h2 : 0 ≤ ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)| :=
      Finset.sum_nonneg (fun p _ => abs_nonneg _)
    linarith
  have h00pos : ∀ τ : ℝ, 0 < Real.log (3 + (Ideal.absNorm q : ℝ) * 2 * (2 + |τ|)) := by
    intro τ
    apply Real.log_pos
    have : 0 ≤ (Ideal.absNorm q : ℝ) * 2 * (2 + |τ|) := by positivity
    linarith
  have h00le : ∀ τ : ℝ, Real.log (3 + (Ideal.absNorm q : ℝ) * 2 * (2 + |τ|))
      ≤ Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l) * (2 + |τ|)) := by
    intro τ
    apply Real.log_le_log
    · have : 0 ≤ (Ideal.absNorm q : ℝ) * 2 * (2 + |τ|) := by positivity
      linarith
    · have hτ : 0 ≤ 2 + |τ| := by positivity
      have : (Ideal.absNorm q : ℝ) * 2 * (2 + |τ|)
          ≤ (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l) * (2 + |τ|) := by
        apply mul_le_mul_of_nonneg_right _ hτ
        apply mul_le_mul_of_nonneg_left _ hNq
        linarith
      linarith
  have hLpos : ∀ τ : ℝ,
      0 < Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l) * (2 + |τ|)) :=
    fun τ => lt_of_lt_of_le (h00pos τ) (h00le τ)
  by_cases hp : KaiHeckePrincipal K q lam
  · 
    have hlam : lam = kaiZFPrincipalChar K q := by
      funext I
      unfold kaiZFPrincipalChar
      split_ifs with hI
      · exact hp I hI.1 hI.2
      · by_cases hI0 : I = 0
        · rw [hI0]; exact hext.2.2.2.2.1
        · exact hext.2.2.2.1 I (fun h => hI ⟨hI0, h⟩)
    obtain ⟨hext0, hprin0⟩ := hpos.1 q hq
    have hEiff' := hEiff
    have hGeq' := hGeq
    rw [hlam] at hEiff' hGeq'
    have hnz := H₁ q hq 1 (fun _ => false) (kaiZFPrincipalChar K q) hext0 hprin0 E G hE
      hEiff' hGd hGeq'
    have hZ2 : ∀ s : ℂ, s.re ≤ 2 →
        1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
          * (2 + |s.im|)) ≤ s.re →
        G s = 0 → (0 : ℕ) = 1 ∧ s = ((0 : ℝ) : ℂ) := by
      intro s hs2 hsB hG0
      exact absurd hG0 (hnz s hs2 (hmono B₁ _ _ _ hBB₁ (h00pos _) (h00le _) hsB))
    refine ⟨0, 0, by norm_num, le_rfl, one_pos, fun h => absurd h (by norm_num), hZ2, ?_⟩
    exact H₄ q hq t l ξ η lam hext htr E G hE hEiff hGd hGeq 0 0 (by norm_num) le_rfl one_pos
      (fun h => absurd h (by norm_num)) hZ2
  · by_cases hr : ∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)
    · 
      obtain ⟨rfl, rfl⟩ := htriv q hq t l ξ η lam hext htr hr
      have hinf0 : kaiInfSize K (0 : NumberField.InfinitePlace K → ℝ)
          (0 : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) = 1 := by
        simp [kaiInfSize]
      obtain ⟨m, β₀, hm, hβ0, hβ1, hi, hii⟩ := H₂ q hq ξ η lam hext hp E G hE hEiff hGd hGeq
      have hZ2 : ∀ s : ℂ, s.re ≤ 2 →
          1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K 0 0)
            * (2 + |s.im|)) ≤ s.re →
          G s = 0 → m = 1 ∧ s = (β₀ : ℂ) := by
        intro s hs2 hsB hG0
        exact hii s hs2 (hmono B₂ _ _ _ hBB₂ (h00pos _) (h00le _) hsB) hG0
      refine ⟨m, β₀, hm, hβ0, hβ1, fun h => ⟨hinf0, hp, (hi h).1⟩, hZ2, ?_⟩
      exact H₄ q hq 0 0 ξ η lam hext htr E G hE hEiff hGd hGeq m β₀ hm hβ0 hβ1
        (fun h => (hi h).2) hZ2
    · 
      have hE0 : E = 0 := by
        rcases Nat.lt_or_ge E 1 with h | h
        · omega
        · exact absurd (hEiff.mp (by omega)) hp
      subst hE0
      have hGeq' : ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s = G s := by
        intro s hs
        have := hGeq s hs
        rwa [pow_zero, mul_one] at this
      have hnz := H₃ q hq t l ξ η lam hext htr hr G hGd hGeq'
      have hZ2 : ∀ s : ℂ, s.re ≤ 2 →
          1 - B / Real.log (3 + (Ideal.absNorm q : ℝ) * (1 + kaiInfSize K t l)
            * (2 + |s.im|)) ≤ s.re →
          G s = 0 → (0 : ℕ) = 1 ∧ s = ((0 : ℝ) : ℂ) := by
        intro s hs2 hsB hG0
        exact absurd hG0 (hnz s hs2 (hmono B₃ _ _ _ hBB₃ (hLpos _) le_rfl hsB))
      refine ⟨0, 0, by norm_num, le_rfl, one_pos, fun h => absurd h (by norm_num), hZ2, ?_⟩
      exact H₄ q hq t l ξ η lam hext htr 0 G hE hEiff hGd hGeq 0 0 (by norm_num) le_rfl one_pos
        (fun h => absurd h (by norm_num)) hZ2

theorem kai_lp_theta_count (K : Type u) [Field K] [NumberField K]
    (x : ℝ) (hx : 1 ≤ x) :
    (∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
          P.IsPrime ∧ P ≠ ⊥ ∧ (Ideal.absNorm P : ℝ) ≤ x},
        Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))))
      ≤ 4 * (Module.finrank ℚ K : ℝ) ^ 2 * x :=
by
  classical
  
  
  have hcolour : ∃ (col : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K))
      (rchar rdeg : Ideal (NumberField.RingOfIntegers K) → ℕ),
      (∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
          Nat.Prime (rchar P) ∧ 1 ≤ rdeg P ∧
            Ideal.absNorm P = rchar P ^ rdeg P) ∧
      (∀ P Q : Ideal (NumberField.RingOfIntegers K),
          P.IsPrime → P ≠ ⊥ → Q.IsPrime → Q ≠ ⊥ →
          rchar P = rchar Q → col P = col Q → P = Q) := by
    have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
    have sA : ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
        ∃ p f : ℕ, Nat.Prime p ∧ 1 ≤ f ∧ Ideal.absNorm P = p ^ f ∧
          (p : NumberField.RingOfIntegers K) ∈ P := by
      intro P hP hP0
      haveI := hP
      have hqdef : Ideal.under ℤ P
          = Ideal.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) P := Ideal.under_def ℤ P
      haveI hqp : (Ideal.under ℤ P).IsPrime := by
        rw [hqdef]; exact Ideal.comap_isPrime _ P
      have hNmem : ((Ideal.absNorm P : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [hqdef, Ideal.mem_comap]
        simpa using Ideal.absNorm_mem P
      have hN0 : (Ideal.absNorm P : ℕ) ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hP0
      have hqne : Ideal.under ℤ P ≠ ⊥ := by
        intro h
        rw [h, Ideal.mem_bot] at hNmem
        exact hN0 (by exact_mod_cast hNmem)
      obtain ⟨g, hgq⟩ : ∃ g : ℤ, Ideal.span {g} = Ideal.under ℤ P :=
        ⟨Submodule.IsPrincipal.generator (Ideal.under ℤ P), Ideal.span_singleton_generator _⟩
      have hg0 : g ≠ 0 := by
        intro h
        exact hqne (hgq ▸ (Ideal.span_singleton_eq_bot.mpr h))
      have hspanne : Ideal.span {g} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]; exact hg0
      haveI hspanp : (Ideal.span {g}).IsPrime := hgq ▸ hqp
      have hgp : Prime g := (Ideal.span_singleton_prime hg0).mp hspanp
      haveI hlo : P.LiesOver (Ideal.span {g}) := ⟨hgq⟩
      haveI hspanmax : (Ideal.span {g}).IsMaximal := hspanp.isMaximal hspanne
      refine ⟨g.natAbs, (Ideal.span {g}).inertiaDeg P, Int.prime_iff_natAbs_prime.mp hgp,
        Ideal.inertiaDeg_pos (Ideal.span {g}) P, Ideal.absNorm_eq_pow_inertiaDeg P hgp, ?_⟩
      have hmem : ((g.natAbs : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [← hgq]
        exact Ideal.mem_span_singleton.mpr (Int.dvd_natAbs.mpr dvd_rfl)
      rw [hqdef, Ideal.mem_comap] at hmem
      simpa using hmem
    have sB : ∀ p : ℕ, Nat.Prime p →
        ∃ t : Finset (Ideal (NumberField.RingOfIntegers K)),
          t.card ≤ Module.finrank ℚ K ∧
          ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
            (p : NumberField.RingOfIntegers K) ∈ P → P ∈ t := by
      intro p hp
      have hp0 : ((p : ℤ)) ≠ 0 := Int.natCast_ne_zero.mpr hp.ne_zero
      have hpp : Prime ((p : ℤ)) := Nat.prime_iff_prime_int.mp hp
      haveI hPp : (Ideal.span {(p : ℤ)}).IsPrime := (Ideal.span_singleton_prime hp0).mpr hpp
      have hne : Ideal.span {(p : ℤ)} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]; exact hp0
      haveI hmax : (Ideal.span {(p : ℤ)}).IsMaximal := hPp.isMaximal hne
      refine ⟨primesOverFinset (Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers K), ?_, ?_⟩
      · have hsum := Ideal.sum_ramification_inertia (NumberField.RingOfIntegers K) ℚ K hne
        rw [Finset.card_eq_sum_ones, ← hsum]
        refine Finset.sum_le_sum ?_
        intro P hPmem
        have hco : P ∈ (Ideal.span {(p : ℤ)}).primesOver (NumberField.RingOfIntegers K) := by
          rw [← coe_primesOverFinset hne (NumberField.RingOfIntegers K)]
          exact Finset.mem_coe.mpr hPmem
        rw [Ideal.primesOver.eq_def, Set.mem_setOf_eq] at hco
