    intro y hy hPy
    have hσ0 : (0 : ℝ) ≤ σ := by linarith
    have hY0 : ∀ i, (0 : ℝ) < y i := fun i => by linarith [hy i]
    have hL0 : ∀ i, (0 : ℝ) ≤ Real.log (y i) := fun i =>
      Real.log_nonneg (by linarith [hy i])
    have hx0 : ∀ i, (0 : ℝ) ≤ (y i) ^ (-σ) := fun i => Real.rpow_nonneg (hY0 i).le _
