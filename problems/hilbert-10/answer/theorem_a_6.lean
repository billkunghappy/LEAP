/-! ### Statement (originally `theorem_a_6.lean`) -/

/--
**Theorem A.6 ([5, Theorem 12.1]) / Theorem A.7.** Let `K` be a number field and `d ≥ 1`.
There are exponents `e, f > 0` such that for every norm-length compatible basis `ω` of
`𝓞_K` there is `Cerr ≥ 16` with the following property. Let `ψ₁, …, ψ₄ : ℤ^d → 𝓞_K` be
affine linear forms such that `ψ_i^hom` restricted to `ker ψ_j^hom` has finite cokernel
for `i ≠ j`, and which are locally solvable at every prime. Then there is `B > 0` such
that for all `N > Cerr` and every measurable convex `Ω ⊆ [-N, N]^d`, provided
`‖ψ_i‖_N ≤ (log log N)^e`, one has
`|∑_{z ∈ Ω ∩ ℤ^d} ∏ Λ(ψ_i(z)) - Vol(Ω) · B| ≤ Cerr · N^d / (log log N)^f`.
-/
def CoprimeToNat {K : Type u} [Field K] [NumberField K] (W : ℕ)
    (x : NumberField.RingOfIntegers K) : Prop :=
  ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    ((W : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal → x ∉ 𝔭.asIdeal


noncomputable def phiK (K : Type u) [Field K] [NumberField K] (W : ℕ) : ℕ :=
  Nat.card (NumberField.RingOfIntegers K ⧸
    Ideal.span {((W : ℕ) : NumberField.RingOfIntegers K)})ˣ


noncomputable def kaiW (N : ℝ) : ℕ := primorial ⌊Real.log (Real.log N)⌋₊

open scoped Classical in

noncomputable def cramerModel (K : Type u) [Field K] [NumberField K] (ρ : ℝ) (W : ℕ)
    (x : NumberField.RingOfIntegers K) : ℝ :=
  if CoprimeToNat W x then ρ * ((W : ℝ) ^ Module.finrank ℚ K / (phiK K W : ℝ)) else 0

open scoped Classical in

noncomputable def cramerSum {K : Type u} [Field K] [NumberField K] {d : ℕ} (ρ : ℝ) (W : ℕ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (Ω : Set (Fin d → ℝ)) (M : ℕ) : ℝ :=
  ∑ z ∈ intBox d M,
    if (fun k => ((z k : ℤ) : ℝ)) ∈ Ω
    then ∏ i : Fin 4, cramerModel K ρ W (affEval (c₀ i) (c i) z) else 0

open scoped Classical in

noncomputable def coprimeCount {K : Type u} [Field K] [NumberField K] {d : ℕ} (W : ℕ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (Ω : Set (Fin d → ℝ)) (M : ℕ) : ℝ :=
  ∑ z ∈ intBox d M,
    if (fun k => ((z k : ℤ) : ℝ)) ∈ Ω
    then (if ∀ i : Fin 4, CoprimeToNat W (affEval (c₀ i) (c i) z) then 1 else 0) else 0


def resBox (d W : ℕ) : Finset (Fin d → ℤ) :=
  Finset.Icc (fun _ => (0 : ℤ)) (fun _ => (W : ℤ) - 1)

open scoped Classical in

noncomputable def localDensity {K : Type u} [Field K] [NumberField K] {d : ℕ} (W : ℕ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) : ℝ :=
  (((resBox d W).filter
      (fun z => ∀ i : Fin 4, CoprimeToNat W (affEval (c₀ i) (c i) z))).card : ℝ)
    / (W : ℝ) ^ d


noncomputable def betaLocal {K : Type u} [Field K] [NumberField K] {d : ℕ} (p : ℕ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) : ℝ :=
  ((p : ℝ) ^ Module.finrank ℚ K / (phiK K p : ℝ)) ^ 4 * localDensity p c₀ c


noncomputable def betaPartial {K : Type u} [Field K] [NumberField K] {d : ℕ} (w : ℕ)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) : ℝ :=
  ∏ p ∈ (Finset.range (w + 1)).filter Nat.Prime, betaLocal p c₀ c
