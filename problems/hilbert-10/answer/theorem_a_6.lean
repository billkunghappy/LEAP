        Real.pi ^ NumberField.InfinitePlace.nrComplexPlaces K, by positivity, ?_⟩
    intro R hR
    refine le_of_eq ?_
    have hsplit : (Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) R)
