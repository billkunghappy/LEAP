      have c2 := abs_le.mp (hclose j' hj'.1)
      have eV : (V j : ℝ) = (V j' : ℝ) := by rw [hj.2, hj'.2]
      rw [← hwdiff, abs_le]
      constructor <;> linarith [c1.1, c1.2, c2.1, c2.2]
    
    have himg : ((S.image V).card : ℝ) ≤ 2 * ε + 2 * (M : ℝ) / d * x + 1 := by
      apply hdiam _ _ (by positivity)
      intro a ha b hb
      rw [Finset.mem_image] at ha hb
      obtain ⟨j, hj, rfl⟩ := ha
      obtain ⟨j', hj', rfl⟩ := hb
      have c1 := abs_le.mp (hclose j hj)
      have c2 := abs_le.mp (hclose j' hj')
      have hww : |w j - w j'| ≤ 2 * (M : ℝ) / d * x := by
        rw [hwdiff]
        exact mul_le_mul_of_nonneg_right (hjdist j hj j' hj') hxpos.le
      have c3 := abs_le.mp hww
      rw [abs_le]
      constructor <;> linarith [c1.1, c1.2, c2.1, c2.2, c3.1, c3.2]
    
    have hcount : (S.card : ℝ) ≤ (2 * ε + 2 * (M : ℝ) / d * x + 1) * (2 * ε / x + 1) := by
      have e := Finset.card_eq_sum_card_image V S
      rw [e]
      push_cast
      calc ∑ a ∈ S.image V, ((S.filter (fun j => V j = a)).card : ℝ)
          ≤ ∑ _a ∈ S.image V, (2 * ε / x + 1) := Finset.sum_le_sum (fun a _ => hfib a)
        _ = ((S.image V).card : ℝ) * (2 * ε / x + 1) := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ (2 * ε + 2 * (M : ℝ) / d * x + 1) * (2 * ε / x + 1) :=
            mul_le_mul_of_nonneg_right himg (by positivity)
    
    obtain ⟨P, hP⟩ : ∃ P : ℝ, P = 2 * ε / x := ⟨_, rfl⟩
    obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = 2 * (M : ℝ) / d := ⟨_, rfl⟩
    obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = σ * (2 * (M : ℝ) + 1) / d := ⟨_, rfl⟩
    rw [← hP, ← hQ] at hcount
    have hP0 : 0 ≤ P := by rw [hP]; positivity
    have hQ0 : 0 ≤ Q := by rw [hQ]; positivity
    have hxP : x * P = 2 * ε := by rw [hP]; field_simp
    have hZd : Z * d = σ * (2 * (M : ℝ) + 1) := by rw [hZ]; field_simp
    have hTS : (Tr.card : ℝ) = S.card := by rw [hScard]
    have hZle : Z ≤ (2 * ε + Q * x + 1) * (P + 1) := by
      rw [hZ]
      calc σ * (2 * (M : ℝ) + 1) / d ≤ (T.card : ℝ) / d :=
            div_le_div_of_nonneg_right hcard hdpos.le
        _ ≤ Tr.card := hr'
        _ = S.card := hTS
        _ ≤ _ := hcount
    have hε32 : ε ≤ 1 / 32 := by linarith
    have hx2 : x ≤ 2 * ε := hdα
    have L1 : Z ≤ 2 * ε * P + 2 * ε + 2 * ε * Q + Q * x + P + 1 := by
      have e : (2 * ε + Q * x + 1) * (P + 1)
          = 2 * ε * P + 2 * ε + Q * (x * P) + Q * x + P + 1 := by
        ring
      rw [e, hxP] at hZle
      linarith
    have L2 : 2 * ε * P ≤ P / 16 := by
      have h2e : 2 * ε ≤ 1 / 16 := by linarith
      calc 2 * ε * P ≤ (1 / 16) * P := mul_le_mul_of_nonneg_right h2e hP0
        _ = P / 16 := by ring
    have L3 : Q * x ≤ Q * (2 * ε) := mul_le_mul_of_nonneg_left hx2 hQ0
    have L4 : 4 * ε * Q ≤ Z / 8 := by
      have e : Z / 8 - 4 * ε * Q = (σ * (2 * (M : ℝ) + 1) - 64 * (M : ℝ) * ε) / (8 * d) := by
        rw [hZ, hQ]; field_simp; ring
      have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg M
      have hnum : 0 ≤ σ * (2 * (M : ℝ) + 1) - 64 * (M : ℝ) * ε := by
        have := mul_le_mul_of_nonneg_left hεσ hM0
        linarith
      have : 0 ≤ Z / 8 - 4 * ε * Q := by
        rw [e]; exact div_nonneg hnum (by positivity)
      linarith
    have hσd : σ * d ≤ 2 := by
      have := (le_div_iff₀ hσ).mp hdσ
      linarith
    have L5 : 16 ≤ Z := by
      rw [hZ, le_div_iff₀ hdpos]
      by_contra hcon
      push_neg at hcon
      have := mul_lt_mul_of_pos_left hcon hσ
      linarith
    have L7 : Z ≤ (272 / 207) * P := by linarith
    have L9 : x * Z ≤ 3 * ε := by
      have h := mul_le_mul_of_nonneg_left L7 hxpos.le
      have e : x * ((272 / 207) * P) = (272 / 207) * (x * P) := by ring
      rw [e, hxP] at h
      linarith
    rw [le_div_iff₀ (by positivity)]
    have e : x * (σ ^ 2 * (2 * (M : ℝ) + 1)) = (x * Z) * (σ * d) := by
      rw [show σ ^ 2 * (2 * (M : ℝ) + 1) = σ * (σ * (2 * (M : ℝ) + 1)) by ring, ← hZd]
      ring
    rw [e]
    have h6 : (x * Z) * (σ * d) ≤ (3 * ε) * 2 :=
      mul_le_mul L9 hσd (by positivity) (by positivity)
    linarith
  
  
  
  obtain ⟨M, hMdef⟩ : ∃ M : ℕ, M = 2 * N := ⟨_, rfl⟩
  rw [← hMdef] at hG
  have hMR : (M : ℝ) = 2 * (N : ℝ) := by rw [hMdef]; push_cast; ring
  have hK : 2 * (M : ℝ) + 1 = 4 * (N : ℝ) + 1 := by rw [hMR]; ring
  have hσM' : 32 ≤ σ ^ 2 * (2 * (M : ℝ) + 1) := by rw [hK]; exact hσN
  have hcard' : σ * (2 * (M : ℝ) + 1) ^ ν ≤ (G.card : ℝ) := by rw [hK]; exact hcard
  have hσM1 : 1 < σ * ((M : ℝ) + 1) := by
    have hN0 : (0 : ℝ) ≤ 4 * (N : ℝ) + 1 := by positivity
    have h1 : σ ^ 2 * (4 * (N : ℝ) + 1) ≤ σ * (4 * (N : ℝ) + 1) := by
      have : σ ^ 2 ≤ σ := by nlinarith
      exact mul_le_mul_of_nonneg_right this hN0
    rw [hMR]
    nlinarith
  
  have hentry : ∀ l l' : Fin ν, ∃ d : ℕ, 1 ≤ d ∧ (d : ℝ) ≤ 2 / σ ∧
      |(d : ℝ) * Sm l l' - ((round ((d : ℝ) * Sm l l') : ℤ) : ℝ)|
        ≤ 8 * ε / (σ ^ 2 * (2 * (M : ℝ) + 1)) := by
    intro l l'
    obtain ⟨y, hy⟩ := hs1 M l' hG hcard'
    obtain ⟨T, hTdef⟩ : ∃ T : Finset ℤ,
        T = (Finset.Icc (-(M : ℤ)) M).filter (fun t => Function.update y l' t ∈ G) := ⟨_, rfl⟩
    rw [← hTdef] at hy
    have hT : T ⊆ Finset.Icc (-(M : ℤ)) M := by rw [hTdef]; exact Finset.filter_subset _ _
    
    have hline : ∀ t : ℤ, ∑ k, Sm l k * ((Function.update y l' t k : ℤ) : ℝ)
        = (∑ k, Sm l k * ((y k : ℤ) : ℝ) - Sm l l' * ((y l' : ℤ) : ℝ)) + (t : ℝ) * Sm l l' := by
      intro t
      have hpt : ∀ k, Sm l k * ((Function.update y l' t k : ℤ) : ℝ)
          = Sm l k * ((y k : ℤ) : ℝ)
            + (if k = l' then Sm l l' * ((t : ℝ) - ((y l' : ℤ) : ℝ)) else 0) := by
        intro k
        by_cases hk : k = l'
        · subst hk
          rw [Function.update_self, if_pos rfl]
          ring
        · rw [Function.update_of_ne hk, if_neg hk]
          ring
      rw [Finset.sum_congr rfl (fun k _ => hpt k), Finset.sum_add_distrib, Finset.sum_ite_eq']
      simp only [Finset.mem_univ, if_true]
      ring
    have hgoodT : ∀ t ∈ T,
        |(∑ k, Sm l k * ((y k : ℤ) : ℝ) - Sm l l' * ((y l' : ℤ) : ℝ)) + (t : ℝ) * Sm l l'
          - ((round ((∑ k, Sm l k * ((y k : ℤ) : ℝ) - Sm l l' * ((y l' : ℤ) : ℝ))
