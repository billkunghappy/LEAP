      mul_le_mul hκW hX (by positivity) (by positivity)
    have hZ : ℓ ^ (2 * (4 * Module.finrank ℚ K + d)) * ((3 ^ (d - 1) * (N : ℝ) ^ (d - 1)) * ℓ)
