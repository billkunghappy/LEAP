theorem kai_v_typeI_dyadic_select (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ C_P : ℝ, 1 ≤ C_P ∧
      ∀ (M Q δ Y : ℝ) (Φ χ : NumberField.RingOfIntegers K → ℂ)
        (I : Finset (Ideal (NumberField.RingOfIntegers K)))
        (A₀ : Ideal (NumberField.RingOfIntegers K) → ℂ),
        3 ≤ M → 1 ≤ Q → 0 < δ → δ ≤ 1 →
        (∀ x, ‖Φ x‖ ≤ Q) → (∀ x, ‖χ x‖ ≤ 1) →
        (∀ 𝔡 ∈ I, 𝔡 ≠ ⊥ ∧
          (Ideal.absNorm 𝔡 : ℝ) ≤ M ^ ((3 * (Module.finrank ℚ K : ℝ)) / 4)) →
        (∀ 𝔡, ‖A₀ 𝔡‖ ≤ 1) →
        δ * ((omegaBox ω M).card : ℝ) < ‖kaiTypeIForm ω M Φ χ I A₀ Y‖ →
        ∃ (R : ℝ) (G : Finset (Ideal (NumberField.RingOfIntegers K))),
          1 ≤ R ∧ R ^ 4 ≤ M ^ 3 ∧ G ⊆ I ∧
          δ / (C_P * Q * Real.log M) * R ^ Module.finrank ℚ K ≤ (G.card : ℝ) ∧
          ∀ 𝔡 ∈ G, R ^ Module.finrank ℚ K ≤ (Ideal.absNorm 𝔡 : ℝ) ∧
            (Ideal.absNorm 𝔡 : ℝ) ≤ (2 * R) ^ Module.finrank ℚ K ∧
            δ / (C_P * Real.log M) * ((omegaBox ω M).card : ℝ) / (Ideal.absNorm 𝔡 : ℝ)
              ≤ ‖kaiTypeIInner ω M Φ χ 𝔡 Y‖ :=
by
  classical
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hn0 : Module.finrank ℚ K ≠ 0 := by omega
  
  
  
  have hcoord : ∀ (M : ℝ) (x : NumberField.RingOfIntegers K), x ∈ omegaBox ω M →
      ∀ i, -(⌊M⌋₊ : ℤ) ≤ ω.repr x i ∧ ω.repr x i ≤ (⌊M⌋₊ : ℤ) := by
    intro M x hx i
    unfold omegaBox at hx
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.1 hx
    have e : ω.repr (ω.equivFun.symm v) i = v i := by
      rw [← ω.equivFun_apply, ω.equivFun.apply_symm_apply]
    rw [e]
    unfold intBox at hv
    rw [Finset.mem_Icc] at hv
    exact ⟨hv.1 i, hv.2 i⟩
  have hmemBox : ∀ (k : ℕ) (x : NumberField.RingOfIntegers K),
      (∀ i, -(k : ℤ) ≤ ω.repr x i ∧ ω.repr x i ≤ (k : ℤ)) → x ∈ omegaBox ω (k : ℝ) := by
    intro k x hx
    unfold omegaBox
    refine Finset.mem_image.2 ⟨ω.equivFun x, ?_, ω.equivFun.symm_apply_apply x⟩
    unfold intBox
    rw [Finset.mem_Icc, Nat.floor_natCast]
    constructor
    · intro i; rw [ω.equivFun_apply]; exact (hx i).1
    · intro i; rw [ω.equivFun_apply]; exact (hx i).2
  have hcardB : ∀ M : ℝ, ((omegaBox ω M).card : ℝ)
      = (2 * (⌊M⌋₊ : ℝ) + 1) ^ Module.finrank ℚ K := by
    intro M
    unfold omegaBox
    rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective]
    unfold intBox
    rw [Pi.card_Icc]
    have hI : ∀ i : Fin (Module.finrank ℚ K),
        (Finset.Icc ((fun _ : Fin (Module.finrank ℚ K) => -(⌊M⌋₊ : ℤ)) i)
          ((fun _ : Fin (Module.finrank ℚ K) => (⌊M⌋₊ : ℤ)) i)).card = 2 * ⌊M⌋₊ + 1 := by
      intro i
      simp only [Int.card_Icc]
      omega
    rw [Finset.prod_congr rfl (fun i _ => hI i), Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
    norm_cast
  have hbox : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (M : ℝ),
      𝔞 ≠ ⊥ → 1 ≤ M → (Ideal.absNorm 𝔞 : ℝ) ≤ M ^ Module.finrank ℚ K →
      (((@Finset.filter (NumberField.RingOfIntegers K) (fun x => x ∈ 𝔞)
          (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
        * (Ideal.absNorm 𝔞 : ℝ) ≤ (2 * C) ^ Module.finrank ℚ K * ((omegaBox ω M).card : ℝ)) := by
    intro 𝔞 M h𝔞 hM hNM
    obtain ⟨m, hm⟩ : ∃ m : ℕ, m = ⌊M⌋₊ := ⟨_, rfl⟩
    have hMm : M < (m : ℝ) + 1 := by rw [hm]; exact Nat.lt_floor_add_one M
    have hN0 : Ideal.absNorm 𝔞 ≠ 0 := by rw [Ne, Ideal.absNorm_eq_zero_iff]; exact h𝔞
    have hN1 : (1 : ℝ) ≤ (Ideal.absNorm 𝔞 : ℝ) := by
      have : 1 ≤ Ideal.absNorm 𝔞 := Nat.one_le_iff_ne_zero.2 hN0
      exact_mod_cast this
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = (Ideal.absNorm 𝔞 : ℝ) ^ ((Module.finrank ℚ K : ℝ)⁻¹) :=
      ⟨_, rfl⟩
    have hr0 : 0 ≤ r := by rw [hr]; positivity
    have hrn : r ^ Module.finrank ℚ K = (Ideal.absNorm 𝔞 : ℝ) := by
      rw [hr]; exact Real.rpow_inv_natCast_pow (by positivity) hn0
    have hrM : r ≤ M := by
      have h : r ^ Module.finrank ℚ K ≤ M ^ Module.finrank ℚ K := by rw [hrn]; exact hNM
      exact (pow_le_pow_iff_left₀ hr0 (by linarith) hn0).1 h
    have hrpos : 0 < r := by
      rcases hr0.lt_or_eq with h | h
      · exact h
      · exfalso; rw [← h, zero_pow hn0] at hrn; linarith
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = r / C := ⟨_, rfl⟩
    have hs0 : 0 ≤ s := by rw [hs]; exact div_nonneg hr0 hCpos.le
    have hspos : 0 < s := by rw [hs]; exact div_pos hrpos hCpos
    have hCs : C * s = r := by rw [hs]; field_simp
    have hsr : s ≤ r := by rw [hs]; exact div_le_self hr0 hC1.le
    have hceil0 : ⌈s⌉₊ ≠ 0 := by
      rw [Ne, Nat.ceil_eq_zero, not_le]; exact hspos
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hceil0
    have hks : (k : ℝ) < s := by
      have := Nat.ceil_lt_add_one hs0
      rw [hk] at this; push_cast at this; linarith
    have hsk : s ≤ (k : ℝ) + 1 := by
      have := Nat.le_ceil s
      rw [hk] at this; push_cast at this; exact this
    have hkm : k ≤ m := by
      have h1 : (k : ℝ) < (m : ℝ) + 1 := by linarith
      have h2 : k < m + 1 := by exact_mod_cast h1
      omega
    have hlow : (C * (k : ℝ)) ^ Module.finrank ℚ K < (Ideal.absNorm 𝔞 : ℝ) := by
      rw [← hrn]
      refine pow_lt_pow_left₀ ?_ (mul_nonneg hCpos.le (Nat.cast_nonneg k)) hn0
      rw [← hCs]
      exact mul_lt_mul_of_pos_left hks hCpos
    have hk1 : (0 : ℝ) < (k : ℝ) + 1 := by positivity
    have hup : (Ideal.absNorm 𝔞 : ℝ) ≤ (C * ((k : ℝ) + 1)) ^ Module.finrank ℚ K := by
      rw [← hrn]
      refine pow_le_pow_left₀ hr0 ?_ _
      rw [← hCs]
      exact mul_le_mul_of_nonneg_left hsk hCpos.le
    obtain ⟨S, hS⟩ : ∃ S : Finset (NumberField.RingOfIntegers K),
        S = @Finset.filter (NumberField.RingOfIntegers K) (fun x => x ∈ 𝔞)
          (fun _ => Classical.propDecidable _) (omegaBox ω M) := ⟨_, rfl⟩
    rw [← hS]
    obtain ⟨g, hg⟩ : ∃ g : NumberField.RingOfIntegers K → (Fin (Module.finrank ℚ K) → ℕ),
        g = fun x i => (ω.repr x i + (m : ℤ)).toNat / (k + 1) := ⟨_, rfl⟩
    have hmaps : Set.MapsTo g S
        (↑(Fintype.piFinset (fun _ : Fin (Module.finrank ℚ K) => Finset.range (2 * m / (k + 1) + 1)))
          : Set (Fin (Module.finrank ℚ K) → ℕ)) := by
      intro x hx
      rw [Finset.mem_coe, hS, Finset.mem_filter] at hx
      rw [Finset.mem_coe, Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_range, Nat.lt_succ_iff, hg]
      apply Nat.div_le_div_right
      have := hcoord M x hx.1 i
      rw [← hm] at this
      omega
    have hkey : ∀ a b : ℕ, a / (k + 1) = b / (k + 1) → (a : ℤ) - b ≤ k ∧ (b : ℤ) - a ≤ k := by
      intro a b hab
      have e1 := Nat.div_add_mod a (k + 1)
      have e2 := Nat.div_add_mod b (k + 1)
      have l1 := Nat.mod_lt a (show 0 < k + 1 by omega)
      have l2 := Nat.mod_lt b (show 0 < k + 1 by omega)
      rw [hab] at e1
      generalize (k + 1) * (b / (k + 1)) = P at e1 e2
      generalize a % (k + 1) = r1 at e1 l1
      generalize b % (k + 1) = r2 at e2 l2
      omega
    have hinj : Set.InjOn g S := by
      intro x hx x' hx' hgg
      rw [Finset.mem_coe, hS, Finset.mem_filter] at hx hx'
      have hdiff : ∀ i, -(k : ℤ) ≤ ω.repr (x - x') i ∧ ω.repr (x - x') i ≤ (k : ℤ) := by
        intro i
        have h1 := hcoord M x hx.1 i
        have h2 := hcoord M x' hx'.1 i
        rw [← hm] at h1 h2
        have hgi := congrFun hgg i
        rw [hg] at hgi
        simp only at hgi
        rw [map_sub, Finsupp.sub_apply]
        have hk2 := hkey _ _ hgi
        have ha1 : (((ω.repr x i + (m : ℤ)).toNat : ℕ) : ℤ) = ω.repr x i + (m : ℤ) :=
          Int.toNat_of_nonneg (by omega)
        have ha2 : (((ω.repr x' i + (m : ℤ)).toNat : ℕ) : ℤ) = ω.repr x' i + (m : ℤ) :=
          Int.toNat_of_nonneg (by omega)
        rw [ha1, ha2] at hk2
        constructor <;> linarith [hk2.1, hk2.2]
      by_contra hne
      have hsep : Ideal.absNorm 𝔞 ≤ (Algebra.norm ℤ (x - x')).natAbs := by
        have hmem : x - x' ∈ 𝔞 := 𝔞.sub_mem hx.2 hx'.2
        have hdvd := Ideal.absNorm_dvd_absNorm_of_le ((Ideal.span_singleton_le_iff_mem 𝔞).2 hmem)
        rw [Ideal.absNorm_span_singleton] at hdvd
        apply Nat.le_of_dvd _ hdvd
        rw [Nat.pos_iff_ne_zero, ← Ideal.absNorm_span_singleton, Ne, Ideal.absNorm_eq_zero_iff,
          Ideal.span_singleton_eq_bot]
        exact sub_ne_zero.2 hne
      rcases Nat.eq_zero_or_pos k with hk0 | hk0
      · apply hne
        rw [ω.ext_elem_iff]
        intro i
        have := hdiff i
        simp only [hk0, Nat.cast_zero, neg_zero, map_sub, Finsupp.sub_apply] at this
        omega
