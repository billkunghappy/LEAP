  · rw [← h0, mul_zero, mul_zero]; positivity
  · obtain ⟨d, hd⟩ : ∃ d, d = |lam l - ((round (lam l) : ℤ) : ℝ)| := ⟨_, rfl⟩
    rw [← hd] at hpos ⊢
