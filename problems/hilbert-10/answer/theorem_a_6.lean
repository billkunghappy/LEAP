      have h2 := ENNReal.toReal_le_of_le_ofReal hnn hvolCU
      have he : cS * X ^ n * ((4 * δ) / X) = (4 * cS * X ^ n) * (δ / X) := by ring
      have h3 := mul_le_mul_of_nonneg_left hδX (by positivity : (0:ℝ) ≤ 4 * cS * X ^ n)
      linarith
    have hintCU : MeasureTheory.IntegrableOn
        (fun z : NumberField.mixedEmbedding.mixedSpace K =>
          (NumberField.mixedEmbedding.norm z) ^ (β' - 1)) (C \ U) :=
      hintC.mono_set Set.diff_subset
    have hintUU : MeasureTheory.IntegrableOn
        (fun z : NumberField.mixedEmbedding.mixedSpace K =>
          (NumberField.mixedEmbedding.norm z) ^ (β' - 1)) U := hintC.mono_set hUsubC
    have hintCsplit : ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)
        = (∫ z in U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))
          + ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) := by
      have h := MeasureTheory.setIntegral_union Set.disjoint_sdiff_right hCUmeas hintUU hintCU
      rw [Set.union_diff_cancel hUsubC] at h
      exact h
    have hJ0 : 0 ≤ ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) :=
      MeasureTheory.setIntegral_nonneg hCUmeas (fun z _ => hf0 z)
    have hJ : ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)
        ≤ (MeasureTheory.volume (C \ U)).toReal + CW * X ^ ((n:ℝ) / 2) :=
      hintS (C \ U) hCUmeas (fun z hz => hbox z hz.1)
    have hXhalf : X ^ ((n:ℝ) / 2) ≤ X ^ n * E₀ := by
      have h1 : X ^ ((n:ℝ) / 2) = Real.exp (L * ((n:ℝ) / 2)) := by
        rw [Real.rpow_def_of_pos hX0, hL_def]
      have h2 : X ^ n = Real.exp (L * n) := by
        rw [← Real.rpow_natCast, Real.rpow_def_of_pos hX0, hL_def]
      rw [h1, h2, hE₀_def, ← Real.exp_add]
      apply Real.exp_le_exp.mpr
      have h3 : L * 1 ≤ L * n := mul_le_mul_of_nonneg_left hn1 hL0.le
      linarith
    have hκD : |κ * ((MeasureTheory.volume (C \ U)).toReal
          - ε * ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))|
        ≤ κmax * (8 * cS + CW) * X ^ n * E₀ := by
      rw [abs_mul, abs_of_nonneg hκ0]
      have hεJ1 : ε * (∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))
          ≤ ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) := by
        linarith [mul_nonneg (sub_nonneg.mpr hε'.2) hJ0]
      have hεJ2 : -(∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))
          ≤ ε * ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) := by
        linarith [mul_nonneg (show (0:ℝ) ≤ 1 + ε by linarith) hJ0]
      have h1 : |(MeasureTheory.volume (C \ U)).toReal
            - ε * ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)|
          ≤ (MeasureTheory.volume (C \ U)).toReal
            + ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) := by
        rw [abs_le]; constructor <;> linarith
      have h2 : (MeasureTheory.volume (C \ U)).toReal
            + ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)
          ≤ (8 * cS + CW) * X ^ n * E₀ := by
        have h4 := mul_le_mul_of_nonneg_left hXhalf hCW0
        linarith
      calc κ * |(MeasureTheory.volume (C \ U)).toReal
            - ε * ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)|
          ≤ κmax * ((MeasureTheory.volume (C \ U)).toReal
            + ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)) :=
            mul_le_mul hκle h1 (abs_nonneg _) hκmax
        _ ≤ κmax * ((8 * cS + CW) * X ^ n * E₀) := mul_le_mul_of_nonneg_left h2 hκmax
        _ = κmax * (8 * cS + CW) * X ^ n * E₀ := by ring
    
    have hprimesub : {x : NumberField.RingOfIntegers K |
        Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ C \ U} ⊆
        {x : NumberField.RingOfIntegers K |
          NumberField.mixedEmbedding K (x : K) ∈ Sh (4 * δ)} := by
      rintro x ⟨hxp, hxC, hxU⟩
      refine hshellmem _ hxC hxU ?_
      refine hcover _ (fun w => hbox _ hxC w) (fun w => ?_)
      rw [NumberField.mixedEmbedding.normAtPlace_apply]
      exact NumberField.InfinitePlace.pos_iff.mpr
        (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hxp.ne_zero)
    have hVnn5 : (0:ℝ) ≤ cS * X ^ n * ((5 * δ) / X) := by positivity
    have hdilsub : {z : NumberField.mixedEmbedding.mixedSpace K |
        ∃ x ∈ Sh (4 * δ), ‖z - x‖ ≤ dL} ⊆ Sh (5 * δ) := by
      intro z hz
      obtain ⟨x, hx, hzx⟩ := hz
      rw [hSh] at hx ⊢
      obtain ⟨⟨y, hyC, hxy⟩, hx2⟩ := hx
      refine ⟨⟨y, hyC, ?_⟩, ?_⟩
      · calc ‖z - y‖ = ‖(z - x) + (x - y)‖ := by rw [sub_add_sub_cancel]
          _ ≤ ‖z - x‖ + ‖x - y‖ := norm_add_le _ _
          _ ≤ dL + 4 * δ := by linarith
          _ ≤ 5 * δ := by linarith
      · intro hall
        refine hx2 (fun p hpx => hall p ?_)
        have hrev : ‖x - z‖ = ‖z - x‖ := norm_sub_rev _ _
        calc ‖p - z‖ = ‖(p - x) + (x - z)‖ := by rw [sub_add_sub_cancel]
          _ ≤ ‖p - x‖ + ‖x - z‖ := norm_add_le _ _
          _ ≤ 4 * δ + dL := by linarith
          _ ≤ 5 * δ := by linarith
    have hdilvol : MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
        ∃ x ∈ Sh (4 * δ), ‖z - x‖ ≤ dL} ≤ ENNReal.ofReal (cS * X ^ n * ((5 * δ) / X)) :=
      le_trans (MeasureTheory.measure_mono hdilsub) hsh5
    obtain ⟨hfin, hcardle⟩ := hcount (Sh (4 * δ)) (cS * X ^ n * ((5 * δ) / X)) hVnn5 hdilvol
    have hcardmono : Nat.card {x : NumberField.RingOfIntegers K |
        Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ C \ U}
        ≤ Nat.card {x : NumberField.RingOfIntegers K |
          NumberField.mixedEmbedding K (x : K) ∈ Sh (4 * δ)} :=
      Nat.card_mono hfin hprimesub
    have hcardR : (Nat.card {x : NumberField.RingOfIntegers K |
        Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ C \ U} : ℝ)
        ≤ 5 * cL * cS * X ^ n * E₀ := by
      have h1 : (Nat.card {x : NumberField.RingOfIntegers K |
          Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ C \ U} : ℝ)
          ≤ (Nat.card {x : NumberField.RingOfIntegers K |
            NumberField.mixedEmbedding K (x : K) ∈ Sh (4 * δ)} : ℝ) := by
        exact_mod_cast hcardmono
      have he : cL * (cS * X ^ n * ((5 * δ) / X)) = (5 * cL * cS * X ^ n) * (δ / X) := by ring
      have h4 := mul_le_mul_of_nonneg_left hδX
        (by positivity : (0:ℝ) ≤ 5 * cL * cS * X ^ n)
      linarith
    obtain ⟨hmono1, hmono2⟩ := hmono U C hUsubC (fun z hz w => hbox z hz w)
    simp only [← hn_def, ← hL_def] at hmono2
    have hT1 : |kaiPrimePsi K q α C - kaiPrimePsi K q α U| ≤ A₂ * L * X ^ n * E₀ := by
      rw [abs_of_nonneg (sub_nonneg.mpr hmono1)]
      refine le_trans hmono2 ?_
      have hNL : (0:ℝ) ≤ (n:ℝ) * L := by positivity
      have h := mul_le_mul_of_nonneg_left hcardR hNL
      rw [hA₂_def]
      linarith
    
    have hdecomp : kaiPrimePsi K q α C - κ * ((MeasureTheory.volume C).toReal
          - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))
        = (kaiPrimePsi K q α C - kaiPrimePsi K q α U)
          + (kaiPrimePsi K q α U - κ * ((MeasureTheory.volume U).toReal
            - ε * ∫ z in U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)))
          - κ * ((MeasureTheory.volume (C \ U)).toReal
            - ε * ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)) := by
      rw [hvolCreal, hintCsplit]; ring
    have htot : |kaiPrimePsi K q α C - κ * ((MeasureTheory.volume C).toReal
          - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))|
        ≤ (A₁ + A₂) * X ^ n * (L * E₀) := by
      rw [hdecomp]
      have h1 := abs_sub ((kaiPrimePsi K q α C - kaiPrimePsi K q α U)
          + (kaiPrimePsi K q α U - κ * ((MeasureTheory.volume U).toReal
            - ε * ∫ z in U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))))
        (κ * ((MeasureTheory.volume (C \ U)).toReal
            - ε * ∫ z in C \ U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)))
      have h2 := abs_add_le (kaiPrimePsi K q α C - kaiPrimePsi K q α U)
          (kaiPrimePsi K q α U - κ * ((MeasureTheory.volume U).toReal
            - ε * ∫ z in U, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)))
      have hA₁eq : 14 ^ n * C₀ * X ^ n * E₀ + κmax * (8 * cS + CW) * X ^ n * E₀
          = A₁ * X ^ n * E₀ := by rw [hA₁_def]; ring
      have hAX : 0 ≤ A₁ * X ^ n * E₀ := mul_nonneg (mul_nonneg hA₁0 hXn0.le) hE₀0.le
      have h4 : A₁ * X ^ n * E₀ ≤ A₁ * X ^ n * E₀ * L := le_mul_of_one_le_right hAX hL1
      linarith [hT1, hE1, hκD]
    have hLE : L * E₀ ≤ Real.exp K' * Real.exp (-(Real.log X ^ c₄)) := by
      rw [← hL_def]
      obtain ⟨u, hu_def⟩ : ∃ u : ℝ, u = L ^ c₄ := ⟨_, rfl⟩
      rw [← hu_def]
      have hu0 : 0 < u := by rw [hu_def]; exact Real.rpow_pos_of_pos hL0 _
      have hsu : s = u ^ 2 := by
        rw [hs_def, hu_def, ← Real.rpow_natCast, ← Real.rpow_mul hL0.le, hc₄_def]
        congr 1; push_cast; ring
      have hlogL : Real.log L = Real.log u / c₄ := by
        rw [hu_def, Real.log_rpow hL0, mul_div_cancel_left₀ _ hc₄ne]
      have hlogu : Real.log u ≤ u := by
        have := Real.log_le_sub_one_of_pos hu0; linarith
      have h1 : Real.log u / c₄ ≤ u / c₄ := div_le_div_of_nonneg_right hlogu hc₄0.le
      have h3 : u / c₄ = (1 / c₄) * u := by ring
      have h2 : (1 / c₄) * u + u ≤ e' * u ^ 2 + K' := by
        have key : e' * u ^ 2 + K' - ((1 / c₄) * u + u) = (2 * e' * u - a') ^ 2 / (4 * e') := by
          rw [hK'_def, ha'_def]; field_simp; ring
        have hsq : 0 ≤ (2 * e' * u - a') ^ 2 / (4 * e') := by positivity
        linarith
      have hLexp : L * E₀ = Real.exp (Real.log L - e' * s) := by
        rw [hE₀_def, Real.exp_sub, Real.exp_log hL0, Real.exp_neg]; ring
      rw [hLexp, ← Real.exp_add]
      apply Real.exp_le_exp.mpr
      rw [hlogL, hsu]
      linarith
    calc |kaiPrimePsi K q α C - κ * ((MeasureTheory.volume C).toReal
          - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))|
        ≤ (A₁ + A₂) * X ^ n * (L * E₀) := htot
      _ ≤ (A₁ + A₂) * X ^ n * (Real.exp K' * Real.exp (-(Real.log X ^ c₄))) :=
          mul_le_mul_of_nonneg_left hLE (mul_nonneg (by linarith) hXn0.le)
      _ = ((A₁ + A₂) * Real.exp K') * X ^ n * Real.exp (-(Real.log X ^ c₄)) := by ring
      _ ≤ C₄ * X ^ n * Real.exp (-(Real.log X ^ c₄)) := by
          apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
          apply mul_le_mul_of_nonneg_right _ hXn0.le
          rw [hC₄_def]; exact le_max_left _ _
  · 
    push_neg at hbig
    have hCbox' : ∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X₀ :=
      fun z hz w => (hbox z hz w).trans hbig
    obtain ⟨hvolC, hpsi⟩ := hbnd C hCbox'
    obtain ⟨hpsi0, hpsiM⟩ := hpsi q α
    have hvol0 : 0 ≤ (MeasureTheory.volume C).toReal := ENNReal.toReal_nonneg
    have hJ0 : 0 ≤ ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) :=
      MeasureTheory.setIntegral_nonneg hCmeas (fun z _ => hf0 z)
    have hJ := hintS C hCmeas hCBox
    have hXX₀ : X ^ ((n:ℝ) / 2) ≤ X₀ ^ ((n:ℝ) / 2) :=
      Real.rpow_le_rpow hX0.le hbig.le (by positivity)
    have hCWX : CW * X ^ ((n:ℝ) / 2) ≤ CW * X₀ ^ ((n:ℝ) / 2) :=
      mul_le_mul_of_nonneg_left hXX₀ hCW0
    have hεJ1 : ε * (∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))
        ≤ ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) := by
      linarith [mul_nonneg (sub_nonneg.mpr hε'.2) hJ0]
    have hεJ2 : -(∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))
        ≤ ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1) := by
      linarith [mul_nonneg (show (0:ℝ) ≤ 1 + ε by linarith) hJ0]
    have h1 : |(MeasureTheory.volume C).toReal
          - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1)|
        ≤ 2 * V + CW * X₀ ^ ((n:ℝ) / 2) := by
      rw [abs_le]; constructor <;> linarith
    have h2 : |κ * ((MeasureTheory.volume C).toReal
          - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))|
        ≤ κmax * (2 * V + CW * X₀ ^ ((n:ℝ) / 2)) := by
      rw [abs_mul, abs_of_nonneg hκ0]
      exact mul_le_mul hκle h1 (abs_nonneg _) hκmax
    have habs : |kaiPrimePsi K q α C - κ * ((MeasureTheory.volume C).toReal
          - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))| ≤ Bnd := by
      refine (abs_sub _ _).trans ?_
      rw [abs_of_nonneg hpsi0, hBnd_def]
      linarith
    have hlogXX₀ : Real.log X ^ c₄ ≤ Real.log X₀ ^ c₄ :=
      Real.rpow_le_rpow (Real.log_nonneg hX1) (Real.log_le_log hX0 hbig.le) hc₄0.le
    have hexp1 : 1 ≤ Real.exp (Real.log X₀ ^ c₄) * Real.exp (-(Real.log X ^ c₄)) := by
      rw [← Real.exp_add]; exact Real.one_le_exp (by linarith)
    have hXn1 : 1 ≤ X ^ n := one_le_pow₀ hX1
    calc |kaiPrimePsi K q α C - κ * ((MeasureTheory.volume C).toReal
          - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β' - 1))| ≤ Bnd := habs
      _ ≤ Bnd * (X ^ n * (Real.exp (Real.log X₀ ^ c₄) * Real.exp (-(Real.log X ^ c₄)))) :=
          le_mul_of_one_le_right hBnd0 (one_le_mul_of_one_le_of_one_le hXn1 hexp1)
      _ = (Bnd * Real.exp (Real.log X₀ ^ c₄)) * X ^ n * Real.exp (-(Real.log X ^ c₄)) := by
          ring
      _ ≤ C₄ * X ^ n * Real.exp (-(Real.log X ^ c₄)) := by
          apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
          apply mul_le_mul_of_nonneg_right _ hXn0.le
          rw [hC₄_def]; exact le_max_right _ _

theorem kai_omega_mixed_change (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ covol : ℝ, 0 < covol ∧
      ∀ (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)),
        (∀ x : NumberField.RingOfIntegers K,
          kaiOmegaEmb ω (fun j => ((ω.equivFun x j : ℤ) : ℝ))
            = NumberField.mixedEmbedding K (x : K)) ∧
        Function.Injective (kaiOmegaEmb ω) ∧
        (∀ S : Set (Fin (Module.finrank ℚ K) → ℝ), IsOpen S → IsOpen (kaiOmegaEmb ω '' S)) ∧
        (∀ S : Set (Fin (Module.finrank ℚ K) → ℝ), Convex ℝ S → Convex ℝ (kaiOmegaEmb ω '' S)) ∧
        (∀ c : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ,
          IsOpen {v : Fin (Module.finrank ℚ K) → ℝ | ∀ w, 0 < (kaiOmegaEmb ω v).1 w * c w} ∧
          Convex ℝ {v : Fin (Module.finrank ℚ K) → ℝ | ∀ w, 0 < (kaiOmegaEmb ω v).1 w * c w}) ∧
        (∀ S : Set (Fin (Module.finrank ℚ K) → ℝ),
          (MeasureTheory.volume (kaiOmegaEmb ω '' S)).toReal
            = covol * (MeasureTheory.volume S).toReal) ∧
        (∀ (S : Set (Fin (Module.finrank ℚ K) → ℝ)) (γ : ℝ), MeasurableSet S →
          ∫ z in kaiOmegaEmb ω '' S, (NumberField.mixedEmbedding.norm z) ^ γ
            = covol * ∫ v in S, (NumberField.mixedEmbedding.norm (kaiOmegaEmb ω v)) ^ γ) ∧
        (∀ C : ℝ, IsNormLengthCompatible C ω →
          ∀ (R : ℝ) (v : Fin (Module.finrank ℚ K) → ℝ), (∀ j, |v j| ≤ R) →
          ∀ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v)
              ≤ (Module.finrank ℚ K : ℝ) * C * R) :=
by
  classical
  
  have s2 : ∀ ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K),
      ∃ b : Module.Basis (Fin (Module.finrank ℚ K)) ℝ (NumberField.mixedEmbedding.mixedSpace K),
        (∀ j, b j = NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) ∧
        (∀ x : NumberField.RingOfIntegers K,
          kaiOmegaEmb ω (fun j => ((ω.equivFun x j : ℤ) : ℝ))
            = NumberField.mixedEmbedding K (x : K)) ∧
        Submodule.span ℤ (Set.range b) = NumberField.mixedEmbedding.integerLattice K := by
    intro ω
    set e : Fin (Module.finrank ℚ K) → NumberField.mixedEmbedding.mixedSpace K :=
      fun j => NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K) with he
    let φ : NumberField.RingOfIntegers K →+ NumberField.mixedEmbedding.mixedSpace K :=
      (NumberField.mixedEmbedding K).toAddMonoidHom.comp
        (algebraMap (NumberField.RingOfIntegers K) K).toAddMonoidHom
    have hφ : ∀ x, φ x = NumberField.mixedEmbedding K (x : K) := fun x => rfl
    have hz : ∀ x : NumberField.RingOfIntegers K,
        NumberField.mixedEmbedding K (x : K) = ∑ j, (ω.equivFun x j) • e j := by
      intro x
      rw [← hφ]
      conv_lhs => rw [← ω.sum_equivFun x]
      rw [map_sum]
      simp only [map_zsmul, hφ, e]
    have hcoord : ∀ x : NumberField.RingOfIntegers K,
        kaiOmegaEmb ω (fun j => ((ω.equivFun x j : ℤ) : ℝ))
          = NumberField.mixedEmbedding K (x : K) := by
      intro x
      rw [hz x]
      unfold kaiOmegaEmb
      refine Finset.sum_congr rfl (fun j _ => ?_)
      exact Int.cast_smul_eq_zsmul ℝ _ _
    have hspan : Submodule.span ℤ (Set.range e)
        = NumberField.mixedEmbedding.integerLattice K := by
      apply le_antisymm
      · rw [Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        exact ⟨ω j, rfl⟩
      · rintro y ⟨x, rfl⟩
        show φ x ∈ _
        rw [hφ, hz x]
        exact Submodule.sum_mem _
          (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
    have htop : ⊤ ≤ Submodule.span ℝ (Set.range e) := by
      rw [← (NumberField.mixedEmbedding.latticeBasis K).span_eq, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      have h1 : NumberField.mixedEmbedding.latticeBasis K i
          ∈ Submodule.span ℤ (Set.range e) := by
        rw [hspan, ← NumberField.mixedEmbedding.span_latticeBasis]
        exact Submodule.subset_span ⟨i, rfl⟩
      exact Submodule.span_le_restrictScalars ℤ ℝ _ h1
    have hcard : Fintype.card (Fin (Module.finrank ℚ K))
        = Module.finrank ℝ (NumberField.mixedEmbedding.mixedSpace K) := by
      rw [Fintype.card_fin, NumberField.mixedEmbedding.finrank]
    have hli : LinearIndependent ℝ e :=
      linearIndependent_of_top_le_span_of_card_eq_finrank htop hcard
    refine ⟨Module.Basis.mk hli htop, fun j => by rw [Module.Basis.coe_mk], hcoord, ?_⟩
    rw [Module.Basis.coe_mk]
    exact hspan
  
  have s3 : ∀ b : Module.Basis (Fin (Module.finrank ℚ K)) ℝ
      (NumberField.mixedEmbedding.mixedSpace K),
      MeasureTheory.Measure.map (⇑b.equivFun.symm)
        (MeasureTheory.volume : MeasureTheory.Measure (Fin (Module.finrank ℚ K) → ℝ))
        = b.addHaar := by
    intro b
    let f : (Fin (Module.finrank ℚ K) → ℝ) ≃L[ℝ] NumberField.mixedEmbedding.mixedSpace K :=
      b.equivFun.symm.toContinuousLinearEquiv
    have hf : (⇑f : (Fin (Module.finrank ℚ K) → ℝ) → NumberField.mixedEmbedding.mixedSpace K)
        = ⇑b.equivFun.symm := rfl
    have hvol : (MeasureTheory.volume : MeasureTheory.Measure (Fin (Module.finrank ℚ K) → ℝ))
        = (Pi.basisFun ℝ (Fin (Module.finrank ℚ K))).addHaar := by
      rw [Module.Basis.addHaar_def, Module.Basis.parallelepiped_basisFun,
        MeasureTheory.addHaarMeasure_eq_volume_pi]
    rw [← hf, hvol, Module.Basis.map_addHaar]
    congr 1
    apply Module.Basis.eq_of_apply_eq
    intro i
    simp [f, Module.Basis.equivFun_symm_apply, Pi.single_apply]
  
  have s4 : ∀ b : Module.Basis (Fin (Module.finrank ℚ K)) ℝ
      (NumberField.mixedEmbedding.mixedSpace K),
      Submodule.span ℤ (Set.range b) = NumberField.mixedEmbedding.integerLattice K →
      0 < ZLattice.covolume (NumberField.mixedEmbedding.integerLattice K) MeasureTheory.volume ∧
      (MeasureTheory.volume : MeasureTheory.Measure (NumberField.mixedEmbedding.mixedSpace K))
        = ENNReal.ofReal (ZLattice.covolume (NumberField.mixedEmbedding.integerLattice K)
            MeasureTheory.volume) • b.addHaar := by
    intro b hb
    haveI : (MeasureTheory.volume :
        MeasureTheory.Measure (NumberField.mixedEmbedding.mixedSpace K)).IsAddHaarMeasure :=
      MeasureTheory.Measure.prod.instIsAddHaarMeasure _ _
    rw [← hb]
    have hF := ZSpan.isAddFundamentalDomain b
      (MeasureTheory.volume : MeasureTheory.Measure (NumberField.mixedEmbedding.mixedSpace K))
    have hcov := ZLattice.covolume_eq_measure_fundamentalDomain
      (Submodule.span ℤ (Set.range b)) MeasureTheory.volume hF
    refine ⟨ZLattice.covolume_pos _ _, ?_⟩
    have hfin : MeasureTheory.volume (ZSpan.fundamentalDomain b) ≠ ⊤ :=
      (ZSpan.fundamentalDomain_isBounded b).measure_lt_top.ne
    have hpar : MeasureTheory.volume (parallelepiped ⇑b)
        = MeasureTheory.volume (ZSpan.fundamentalDomain b) :=
      (MeasureTheory.measure_congr (ZSpan.fundamentalDomain_ae_parallelepiped b
        MeasureTheory.volume)).symm
    rw [hcov, MeasureTheory.measureReal_def, ENNReal.ofReal_toReal hfin, ← hpar,
      ← Module.Basis.coe_parallelepiped, Module.Basis.addHaar_def]
    exact MeasureTheory.Measure.addHaarMeasure_unique _ _
  
  have s5 : ∀ (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
      (C : ℝ), IsNormLengthCompatible C ω →
      ∀ (R : ℝ) (v : Fin (Module.finrank ℚ K) → ℝ), (∀ j, |v j| ≤ R) →
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w (kaiOmegaEmb ω v)
          ≤ (Module.finrank ℚ K : ℝ) * C * R := by
    intro ω C hω R v hv w
    have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
    have hR : 0 ≤ R := (abs_nonneg _).trans (hv ⟨0, hn⟩)
    have hC : 0 < C := lt_trans one_pos hω.1
    have hsup : ∀ j, basisSupNorm ω (ω j) ≤ 1 := by
      intro j
      haveI : Nonempty (Fin (Module.finrank ℚ K)) := ⟨⟨0, hn⟩⟩
      unfold basisSupNorm
      apply ciSup_le
      intro i
      rw [Module.Basis.repr_self, Finsupp.single_apply]
      split_ifs <;> simp
    have hwj : ∀ j, w ((ω j : NumberField.RingOfIntegers K) : K) ≤ C := by
      intro j
      have h1 : w ((ω j : NumberField.RingOfIntegers K) : K)
          ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K (ω j)) := by
        unfold canNorm
        exact le_ciSup (f := fun w' : NumberField.InfinitePlace K =>
          w' (algebraMap (NumberField.RingOfIntegers K) K (ω j)))
          (Set.finite_range _).bddAbove w
      have h2 := (hω.2 (ω j)).2
      calc _ ≤ _ := h1
        _ ≤ C * basisSupNorm ω (ω j) := h2
        _ ≤ C * 1 := mul_le_mul_of_nonneg_left (hsup j) hC.le
        _ = C := mul_one C
    have hw0 : ∀ j, 0 ≤ w ((ω j : NumberField.RingOfIntegers K) : K) := fun j => by positivity
    unfold kaiOmegaEmb
    calc NumberField.mixedEmbedding.normAtPlace w
          (∑ j, v j • NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K))
        ≤ ∑ j, NumberField.mixedEmbedding.normAtPlace w
            (v j • NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) :=
          Finset.le_sum_of_subadditive _ (map_zero _).le
            (NumberField.mixedEmbedding.normAtPlace_add_le w) _ _
      _ = ∑ j, |v j| * w ((ω j : NumberField.RingOfIntegers K) : K) := by
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [NumberField.mixedEmbedding.normAtPlace_smul,
            NumberField.mixedEmbedding.normAtPlace_apply]
      _ ≤ ∑ _j : Fin (Module.finrank ℚ K), R * C :=
          Finset.sum_le_sum (fun j _ => mul_le_mul (hv j) (hwj j) (hw0 j) hR)
      _ = (Module.finrank ℚ K : ℝ) * C * R := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
  
  obtain ⟨b₀, -, -, hb₀⟩ := s2 (Module.finBasisOfFinrankEq ℤ (NumberField.RingOfIntegers K)
    (NumberField.RingOfIntegers.rank K))
  have hcov : 0 < ZLattice.covolume (NumberField.mixedEmbedding.integerLattice K)
      MeasureTheory.volume := (s4 b₀ hb₀).1
  refine ⟨_, hcov, fun ω => ?_⟩
  
  obtain ⟨b, hbe, hcoord, hb⟩ := s2 ω
  have hT : kaiOmegaEmb ω = ⇑b.equivFun.symm := by
    funext v
    rw [Module.Basis.equivFun_symm_apply]
    unfold kaiOmegaEmb
    simp only [hbe]
  have hinj : Function.Injective (kaiOmegaEmb ω) := by
    rw [hT]; exact b.equivFun.symm.injective
  let T' : (Fin (Module.finrank ℚ K) → ℝ) ≃L[ℝ] NumberField.mixedEmbedding.mixedSpace K :=
    b.equivFun.symm.toContinuousLinearEquiv
  have hT' : (⇑T' : (Fin (Module.finrank ℚ K) → ℝ) → NumberField.mixedEmbedding.mixedSpace K)
      = kaiOmegaEmb ω := by rw [hT]; rfl
  have hME : MeasurableEmbedding (kaiOmegaEmb ω) := by
    rw [← hT']; exact T'.toHomeomorph.measurableEmbedding
  have hcont : Continuous (kaiOmegaEmb ω) := by rw [← hT']; exact T'.continuous
  
  have hstar : (MeasureTheory.volume :
      MeasureTheory.Measure (NumberField.mixedEmbedding.mixedSpace K))
      = ENNReal.ofReal (ZLattice.covolume (NumberField.mixedEmbedding.integerLattice K)
          MeasureTheory.volume) •
        MeasureTheory.Measure.map (kaiOmegaEmb ω) MeasureTheory.volume := by
    rw [hT, s3 b]; exact (s4 b hb).2
  refine ⟨hcoord, hinj, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro S hS
    rw [← hT']; exact T'.isOpenMap S hS
  · intro S hS
    rw [hT]; exact hS.linear_image b.equivFun.symm.toLinearMap
  · intro c
    have hcw : ∀ w, Continuous (fun v => (kaiOmegaEmb ω v).1 w * c w) := fun w =>
      ((continuous_apply w).comp (continuous_fst.comp hcont)).mul continuous_const
    constructor
    · rw [Set.setOf_forall]
      exact isOpen_iInter_of_finite (fun w => isOpen_lt continuous_const (hcw w))
    · rw [Set.setOf_forall]
      refine convex_iInter (fun w => ?_)
      have hlin : IsLinearMap ℝ (fun v => (kaiOmegaEmb ω v).1 w * c w) := by
        refine ⟨fun u v => ?_, fun t u => ?_⟩
        · simp only [hT, map_add, Prod.fst_add, Pi.add_apply, add_mul]
        · simp only [hT, map_smul, Prod.smul_fst, Pi.smul_apply, smul_eq_mul, mul_assoc]
      exact convex_halfSpace_gt hlin 0
  · intro S
    conv_lhs => rw [hstar]
    rw [MeasureTheory.Measure.smul_apply, hME.map_apply, Set.preimage_image_eq S hinj,
      smul_eq_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal hcov.le]
  · intro S γ _
    conv_lhs => rw [hstar]
    rw [MeasureTheory.Measure.restrict_smul, MeasureTheory.integral_smul_measure,
      hME.setIntegral_map, Set.preimage_image_eq S hinj, ENNReal.toReal_ofReal hcov.le,
      smul_eq_mul]
  · exact fun C hω R v hv w => s5 ω C hω R v hv w

theorem kai_omegaBox_place_bounds (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (M : ℝ) (hM : 1 ≤ M)
    (x : NumberField.RingOfIntegers K) (hx : x ∈ omegaBox ω M) :
    (∀ w : NumberField.InfinitePlace K, w (x : K) ≤ C * M) ∧
    (((Algebra.norm ℤ x).natAbs : ℝ) ≤ (C * M) ^ Module.finrank ℚ K) ∧
    (x ≠ 0 → ∀ w : NumberField.InfinitePlace K,
      ((C * M) ^ Module.finrank ℚ K)⁻¹ ≤ w (x : K)) :=
by
  classical
  have hC : 1 < C := hω.1
  have hB1 : 1 ≤ C * M := one_le_mul_of_one_le_of_one_le hC.le hM
  have hBpos : 0 < C * M := by linarith
  have hBn1 : 1 ≤ (C * M) ^ Module.finrank ℚ K := one_le_pow₀ hB1
  have hBnpos : 0 < (C * M) ^ Module.finrank ℚ K := by linarith
  
  have hs1 : basisSupNorm ω x ≤ M := by
    simp only [omegaBox, Finset.mem_image] at hx
    obtain ⟨v, hv, rfl⟩ := hx
    unfold basisSupNorm
    refine Real.iSup_le (fun j => ?_) (by linarith)
    have hrepr : ω.repr (ω.equivFun.symm v) j = v j := by
      rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    rw [hrepr]
    unfold intBox at hv
    rw [Finset.mem_Icc] at hv
    have h1 : -(⌊M⌋₊ : ℤ) ≤ v j := hv.1 j
    have h2 : v j ≤ (⌊M⌋₊ : ℤ) := hv.2 j
    have habs : |v j| ≤ (⌊M⌋₊ : ℤ) := abs_le.mpr ⟨h1, h2⟩
    have h3 : |((v j : ℤ) : ℝ)| ≤ ((⌊M⌋₊ : ℕ) : ℝ) := by
      rw [← Int.cast_abs]; exact_mod_cast habs
    exact h3.trans (Nat.floor_le (by linarith))
  have hbs0 : 0 ≤ basisSupNorm ω x := Real.iSup_nonneg (fun j => abs_nonneg _)
  
  have hs2 : ∀ w : NumberField.InfinitePlace K,
      w (algebraMap (NumberField.RingOfIntegers K) K x) ≤ C * M := by
    intro w
    have ha : w (algebraMap (NumberField.RingOfIntegers K) K x)
        ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) :=
      le_ciSup (f := fun w : NumberField.InfinitePlace K =>
        w (algebraMap (NumberField.RingOfIntegers K) K x)) (Set.finite_range _).bddAbove w
    have hb := (hω.2 x).2
    have hc : C * basisSupNorm ω x ≤ C * M := mul_le_mul_of_nonneg_left hs1 (by linarith)
    exact ha.trans (hb.trans hc)
  
  have hcast : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) = ∏ w : NumberField.InfinitePlace K,
      w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult := by
    rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs, Rat.cast_abs]
    congr 1
    have hn := Algebra.coe_norm_int x
    rw [show algebraMap (NumberField.RingOfIntegers K) K x = (x : K) from rfl, ← hn]
    simp
  
  have hs4 : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) ≤ (C * M) ^ Module.finrank ℚ K := by
    rw [hcast]
    have h1 : ∏ w : NumberField.InfinitePlace K,
          w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult
        ≤ ∏ w : NumberField.InfinitePlace K, (C * M) ^ w.mult :=
      Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w _) _)
        (fun w _ => pow_le_pow_left₀ (apply_nonneg w _) (hs2 w) _)
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
    exact h1
  refine ⟨hs2, hs4, ?_⟩
  intro hx0 w₀
  
  have hs5 : (1 : ℝ) ≤ ∏ w : NumberField.InfinitePlace K,
      w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult := by
    rw [← hcast]
    have hne : Algebra.norm ℤ x ≠ 0 := (Algebra.norm_ne_zero_iff (R := ℤ)).2 hx0
    have hpos : 0 < (Algebra.norm ℤ x).natAbs := Int.natAbs_pos.2 hne
    exact_mod_cast hpos
  
  rw [← Finset.mul_prod_erase Finset.univ
    (fun w : NumberField.InfinitePlace K =>
      w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult) (Finset.mem_univ w₀)] at hs5
  set P' := ∏ w ∈ Finset.univ.erase w₀,
    w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult with hP'
  have hP'0 : 0 ≤ P' := Finset.prod_nonneg (fun w _ => pow_nonneg (apply_nonneg _ _) _)
  have hP'le : P' ≤ (C * M) ^ Module.finrank ℚ K := by
    have h1 : P' ≤ ∏ w ∈ Finset.univ.erase w₀, (C * M) ^ w.mult :=
      Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w _) _)
        (fun w _ => pow_le_pow_left₀ (apply_nonneg w _) (hs2 w) _)
    rw [Finset.prod_pow_eq_pow_sum] at h1
    refine h1.trans (pow_le_pow_right₀ hB1 ?_)
    rw [← NumberField.InfinitePlace.sum_mult_eq (K := K)]
    exact Finset.sum_le_sum_of_subset (Finset.erase_subset w₀ Finset.univ)
  
  have ht0 : 0 ≤ w₀ (algebraMap (NumberField.RingOfIntegers K) K x) := apply_nonneg _ _
  have hm0 : w₀.mult ≠ 0 := NumberField.InfinitePlace.mult_pos.ne'
  have claim : 1 ≤ w₀ (algebraMap (NumberField.RingOfIntegers K) K x)
      * (C * M) ^ Module.finrank ℚ K := by
    by_cases h1 : 1 ≤ w₀ (algebraMap (NumberField.RingOfIntegers K) K x)
    · nlinarith
    · push_neg at h1
      have hpow : w₀ (algebraMap (NumberField.RingOfIntegers K) K x) ^ w₀.mult
          ≤ w₀ (algebraMap (NumberField.RingOfIntegers K) K x) :=
        pow_le_of_le_one ht0 h1.le hm0
      exact hs5.trans (mul_le_mul hpow hP'le hP'0 ht0)
  exact (inv_le_iff_one_le_mul₀ hBnpos).2 claim

theorem kai_associates_card_bound (K : Type u) [Field K] [NumberField K] :
    ∃ A₁ : ℝ, 0 ≤ A₁ ∧
      ∀ (Y : ℝ), 1 ≤ Y → ∀ (S : Finset (NumberField.RingOfIntegers K)),
        (∀ y ∈ S, ∀ y' ∈ S, Ideal.span {y} = Ideal.span {y'}) →
        (∀ y ∈ S, ∀ w : NumberField.InfinitePlace K, Y⁻¹ ≤ w (y : K) ∧ w (y : K) ≤ Y) →
        (S.card : ℝ) ≤ A₁ * (1 + Real.log Y) ^ Module.finrank ℚ K :=
by
  classical
  have hΦ := NumberField.Embeddings.finite_of_norm_le K ℂ (Real.exp 1)
  obtain ⟨F, hF⟩ : ∃ F : ℕ, F = hΦ.toFinset.card := ⟨_, rfl⟩
  have fiber : ∀ T : Finset (NumberField.RingOfIntegers K),
      (∀ y ∈ T, y ≠ 0) →
      (∀ y ∈ T, ∀ y' ∈ T, Ideal.span {y} = Ideal.span {y'}) →
      (∀ y ∈ T, ∀ y' ∈ T, ∀ φ : K →+* ℂ, ‖φ (y : K)‖ < Real.exp 1 * ‖φ (y' : K)‖) →
      T.card ≤ F := by
    intro T h0 hassoc hclose
    rcases T.eq_empty_or_nonempty with hT | ⟨y₁, hy₁⟩
    · simp [hT]
    have hy₁K : (y₁ : K) ≠ 0 := by
      intro h
      apply h0 y₁ hy₁
      exact NumberField.RingOfIntegers.coe_injective (by simpa using h)
    rw [hF]
    refine Finset.card_le_card_of_injOn (fun y => (y : K) / (y₁ : K)) ?_ ?_
    · intro y hy
      rw [Finset.mem_coe, Set.Finite.mem_toFinset]
      show IsIntegral ℤ ((y : K) / (y₁ : K)) ∧
        ∀ φ : K →+* ℂ, ‖φ ((y : K) / (y₁ : K))‖ ≤ Real.exp 1
      have hsp := hassoc y hy y₁ hy₁
      rw [Ideal.span_singleton_eq_span_singleton] at hsp
      obtain ⟨c, hc⟩ := hsp.symm.dvd
      refine ⟨?_, ?_⟩
      · have hyc : (y : K) = (y₁ : K) * (c : K) := by rw [hc]; simp
        have : (y : K) / (y₁ : K) = (c : K) := by
          rw [hyc]; exact mul_div_cancel_left₀ (c : K) hy₁K
        show IsIntegral ℤ ((y : K) / (y₁ : K))
        rw [this]; exact NumberField.RingOfIntegers.isIntegral_coe c
      · intro φ
        have hpos : 0 < ‖φ (y₁ : K)‖ := norm_pos_iff.mpr ((map_ne_zero φ).mpr hy₁K)
        show ‖φ ((y : K) / (y₁ : K))‖ ≤ Real.exp 1
        rw [map_div₀, norm_div, div_le_iff₀ hpos]
        exact (hclose y hy y₁ hy₁ φ).le
    · intro y hy y' hy' h
      have h' : (y : K) / (y₁ : K) = (y' : K) / (y₁ : K) := h
      exact NumberField.RingOfIntegers.coe_injective ((div_left_inj' hy₁K).mp h')
  have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hcardE : Fintype.card (K →+* ℂ) = Module.finrank ℚ K := NumberField.Embeddings.card K ℂ
  obtain ⟨φ₀⟩ : Nonempty (K →+* ℂ) := Fintype.card_pos_iff.mp (by rw [hcardE]; exact hn)
  refine ⟨(F : ℝ) * 2 ^ Module.finrank ℚ K, by positivity, ?_⟩
  intro Y hY S hassoc hH2
  have hYpos : 0 < Y := by linarith
  have hH2' : ∀ y ∈ S, ∀ φ : K →+* ℂ, Y⁻¹ ≤ ‖φ (y : K)‖ ∧ ‖φ (y : K)‖ ≤ Y := by
    intro y hy φ
    have := hH2 y hy (NumberField.InfinitePlace.mk φ)
    rwa [NumberField.InfinitePlace.apply] at this
  have hpos : ∀ y ∈ S, ∀ φ : K →+* ℂ, 0 < ‖φ (y : K)‖ := fun y hy φ =>
    lt_of_lt_of_le (inv_pos.mpr hYpos) (hH2' y hy φ).1
  have hne : ∀ y ∈ S, y ≠ 0 := by
    intro y hy h
    have := hpos y hy φ₀
    rw [h] at this
    simp at this
  obtain ⟨L, hL⟩ : ∃ L : ℕ, L = ⌊Real.log Y⌋₊ := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : Finset ℤ, W = Finset.Icc (-(L : ℤ) - 1) (L : ℤ) := ⟨_, rfl⟩
  have hlogY : 0 ≤ Real.log Y := Real.log_nonneg hY
  have hL1 : (L : ℝ) ≤ Real.log Y := by rw [hL]; exact Nat.floor_le hlogY
  have hL2 : Real.log Y < L + 1 := by rw [hL]; exact Nat.lt_floor_add_one _
  have hwin : ∀ a : ℝ, Y⁻¹ ≤ a → a ≤ Y → ⌊Real.log a⌋ ∈ W := by
    intro a ha1 ha2
    have hapos : 0 < a := lt_of_lt_of_le (inv_pos.mpr hYpos) ha1
    have hup : Real.log a ≤ Real.log Y := Real.log_le_log hapos ha2
    have hlo : -Real.log Y ≤ Real.log a := by
      have := Real.log_le_log (inv_pos.mpr hYpos) ha1
      rwa [Real.log_inv] at this
    rw [hW, Finset.mem_Icc]
    constructor
    · rw [Int.le_floor]; push_cast; linarith
    · have h1 : (⌊Real.log a⌋ : ℝ) < (L : ℝ) + 1 :=
        lt_of_le_of_lt (Int.floor_le _) (by linarith)
      have h2 : ⌊Real.log a⌋ < (L : ℤ) + 1 := by exact_mod_cast h1
      omega
  have hWcard : (W.card : ℝ) ≤ 2 * (1 + Real.log Y) := by
    have : W.card = 2 * L + 2 := by
      rw [hW, Int.card_Icc]; omega
    rw [this]; push_cast; linarith
  let κ : NumberField.RingOfIntegers K → (K →+* ℂ) → ℤ := fun y φ => ⌊Real.log ‖φ (y : K)‖⌋
  obtain ⟨B, hB⟩ : ∃ B : Finset ((K →+* ℂ) → ℤ), B = Fintype.piFinset (fun _ => W) :=
    ⟨_, rfl⟩
  have himg : S.image κ ⊆ B := by
    intro t ht
    rw [Finset.mem_image] at ht
    obtain ⟨y, hy, rfl⟩ := ht
    rw [hB, Fintype.mem_piFinset]
    intro φ
    exact hwin _ (hH2' y hy φ).1 (hH2' y hy φ).2
  have hBcard : B.card = W.card ^ Module.finrank ℚ K := by
    rw [hB, Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, hcardE]
  have hfib : ∀ t ∈ S.image κ, (S.filter (fun y => κ y = t)).card ≤ F := by
    intro t _
    apply fiber
    · intro y hy; exact hne y (Finset.mem_filter.mp hy).1
    · intro y hy y' hy'
      exact hassoc y (Finset.mem_filter.mp hy).1 y' (Finset.mem_filter.mp hy').1
    · intro y hy y' hy' φ
      obtain ⟨hyS, hyt⟩ := Finset.mem_filter.mp hy
      obtain ⟨hy'S, hy't⟩ := Finset.mem_filter.mp hy'
      have heq : ⌊Real.log ‖φ (y : K)‖⌋ = ⌊Real.log ‖φ (y' : K)‖⌋ :=
        congrFun (hyt.trans hy't.symm) φ
      have hu := hpos y hyS φ
      have hu' := hpos y' hy'S φ
      have h1 : Real.log ‖φ (y : K)‖ < Real.log ‖φ (y' : K)‖ + 1 := by
        have a1 := Int.lt_floor_add_one (Real.log ‖φ (y : K)‖)
        have a2 := Int.floor_le (Real.log ‖φ (y' : K)‖)
        rw [heq] at a1
        linarith
      calc ‖φ (y : K)‖ = Real.exp (Real.log ‖φ (y : K)‖) := (Real.exp_log hu).symm
        _ < Real.exp (Real.log ‖φ (y' : K)‖ + 1) := Real.exp_lt_exp.mpr h1
        _ = Real.exp 1 * ‖φ (y' : K)‖ := by rw [Real.exp_add, Real.exp_log hu', mul_comm]
  have hS := Finset.card_le_mul_card_image S F hfib
  have hSB : S.card ≤ F * W.card ^ Module.finrank ℚ K := by
    calc S.card ≤ F * (S.image κ).card := hS
      _ ≤ F * B.card := Nat.mul_le_mul_left _ (Finset.card_le_card himg)
      _ = _ := by rw [hBcard]
  have hSR : (S.card : ℝ) ≤ (F : ℝ) * (W.card : ℝ) ^ Module.finrank ℚ K := by
    exact_mod_cast hSB
  calc (S.card : ℝ) ≤ (F : ℝ) * (W.card : ℝ) ^ Module.finrank ℚ K := hSR
    _ ≤ (F : ℝ) * (2 * (1 + Real.log Y)) ^ Module.finrank ℚ K :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hWcard _) (by positivity)
    _ = (F : ℝ) * 2 ^ Module.finrank ℚ K * (1 + Real.log Y) ^ Module.finrank ℚ K := by
        rw [mul_pow]; ring

theorem kai_prime_ideal_count (K : Type u) [Field K] [NumberField K] :
    ∃ D₀ : ℝ, 0 ≤ D₀ ∧
      (∀ J : Ideal (NumberField.RingOfIntegers K), J ≠ ⊥ →
        ∀ S : Finset (Ideal (NumberField.RingOfIntegers K)),
          (∀ P ∈ S, P.IsMaximal ∧ J ≤ P) →
          (S.card : ℝ) * Real.log 2 ≤ Real.log (Ideal.absNorm J : ℝ)) ∧
      (∀ X : ℝ, 1 ≤ X → ∀ I : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ J ∈ I, (∃ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
            (m : ℕ), 2 ≤ m ∧ J = p.asIdeal ^ m) ∧ (Ideal.absNorm J : ℝ) ≤ X) →
        (I.card : ℝ) ≤ D₀ * X ^ ((1 : ℝ) / 2) * (1 + Real.log X) ^ 2) :=
by
  classical
  have hA : ∀ J : Ideal (NumberField.RingOfIntegers K), J ≠ ⊥ →
      ∀ S : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ P ∈ S, P.IsMaximal ∧ J ≤ P) →
        (S.card : ℝ) * Real.log 2 ≤ Real.log (Ideal.absNorm J : ℝ) := by
    intro J hJ S hS
    have hPne : ∀ P ∈ S, P ≠ ⊥ := by
      intro P hP h
      apply hJ
      have h' := (hS P hP).2
      rw [h] at h'
      exact le_bot_iff.mp h'
    have hprime : ∀ P ∈ S, Prime P := fun P hP =>
      Ideal.prime_of_isPrime (hPne P hP) (hS P hP).1.isPrime
    have hdvd : ∀ P ∈ S, P ∣ J := fun P hP => Ideal.dvd_iff_le.mpr (hS P hP).2
    have hprod : (∏ P ∈ S, P) ∣ J := Finset.prod_primes_dvd J hprime hdvd
    have hNdvd : (∏ P ∈ S, Ideal.absNorm P) ∣ Ideal.absNorm J := by
      rw [← map_prod]
      exact Ideal.absNorm_dvd_absNorm_of_le (Ideal.dvd_iff_le.mp hprod)
    have hJN : Ideal.absNorm J ≠ 0 := by
      rwa [Ne, Ideal.absNorm_eq_zero_iff]
    have hle : ∏ P ∈ S, Ideal.absNorm P ≤ Ideal.absNorm J :=
      Nat.le_of_dvd (Nat.pos_of_ne_zero hJN) hNdvd
    have h2 : ∀ P ∈ S, 2 ≤ Ideal.absNorm P := by
      intro P hP
      have h0 : Ideal.absNorm P ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hPne P hP
      have h1 : Ideal.absNorm P ≠ 1 := by
        rw [Ne, Ideal.absNorm_eq_one_iff]; exact (hS P hP).1.ne_top
      omega
    have hpow : 2 ^ S.card ≤ Ideal.absNorm J := by
      calc 2 ^ S.card = ∏ _P ∈ S, 2 := by rw [Finset.prod_const]
        _ ≤ ∏ P ∈ S, Ideal.absNorm P := Finset.prod_le_prod (fun _ _ => by norm_num) h2
        _ ≤ _ := hle
    have hpowR : (2:ℝ) ^ S.card ≤ (Ideal.absNorm J : ℝ) := by exact_mod_cast hpow
    have h3 := Real.log_le_log (by positivity) hpowR
    rwa [Real.log_pow] at h3
  have hnorm : ∀ k : ℕ, Ideal.absNorm (Ideal.span {((k : ℕ) : NumberField.RingOfIntegers K)})
      = k ^ Module.finrank ℚ K := by
    intro k
    rw [Ideal.absNorm_span_singleton]
    have hk : ((k : ℕ) : NumberField.RingOfIntegers K)
        = algebraMap ℤ (NumberField.RingOfIntegers K) (k : ℤ) := by simp
    rw [hk, Algebra.norm_algebraMap_of_basis
      (Module.Free.chooseBasis ℤ (NumberField.RingOfIntegers K)),
      ← Module.finrank_eq_card_chooseBasisIndex, NumberField.RingOfIntegers.rank]
    simp [Int.natAbs_pow]
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  refine ⟨(Module.finrank ℚ K : ℝ) / (Real.log 2) ^ 2, by positivity, hA, ?_⟩
  intro X hX I hI
  obtain ⟨Y, hY⟩ : ∃ Y : ℕ, Y = ⌊Real.sqrt X⌋₊ := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℕ, M = ⌊Real.log X / Real.log 2⌋₊ := ⟨_, rfl⟩
  obtain ⟨J₀, hJ₀⟩ : ∃ J₀ : Ideal (NumberField.RingOfIntegers K),
      J₀ = Ideal.span {((Y.factorial : ℕ) : NumberField.RingOfIntegers K)} := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : Finset (Ideal (NumberField.RingOfIntegers K)),
      T = I.image Ideal.radical := ⟨_, rfl⟩
  have hfacts : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (m : ℕ), 2 ≤ m → (Ideal.absNorm (p.asIdeal ^ m) : ℝ) ≤ X →
      p.asIdeal.IsMaximal ∧ (p.asIdeal ^ m).radical = p.asIdeal ∧ m ≤ M ∧ J₀ ≤ p.asIdeal := by
    intro p m hm hN
    have hmax : p.asIdeal.IsMaximal := p.isMaximal
    have ha2 : 2 ≤ Ideal.absNorm p.asIdeal := by
      have h0 : Ideal.absNorm p.asIdeal ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact p.ne_bot
      have h1 : Ideal.absNorm p.asIdeal ≠ 1 := by
        rw [Ne, Ideal.absNorm_eq_one_iff]; exact hmax.ne_top
      omega
    have haX : ((Ideal.absNorm p.asIdeal : ℝ)) ^ m ≤ X := by
      rw [map_pow] at hN; exact_mod_cast hN
    have ha2R : (2:ℝ) ≤ Ideal.absNorm p.asIdeal := by exact_mod_cast ha2
    refine ⟨hmax, ?_, ?_, ?_⟩
    · rw [Ideal.radical_pow _ (by omega : m ≠ 0)]; exact p.isPrime.radical
    · have h2m : (2:ℝ) ^ m ≤ X := (pow_le_pow_left₀ (by norm_num) ha2R m).trans haX
      have h3 := Real.log_le_log (by positivity) h2m
      rw [Real.log_pow] at h3
      rw [hM]
      apply Nat.le_floor
      rw [le_div_iff₀ hlog2]; exact h3
    · have ha_sq : (Ideal.absNorm p.asIdeal : ℝ) ^ 2 ≤ X :=
        (pow_le_pow_right₀ (by linarith) hm).trans haX
      have haY : Ideal.absNorm p.asIdeal ≤ Y := by
        rw [hY]
        apply Nat.le_floor
        exact le_trans (le_abs_self _) (Real.abs_le_sqrt ha_sq)
      have hdvd : Ideal.absNorm p.asIdeal ∣ Y.factorial := Nat.dvd_factorial (by omega) haY
      rw [hJ₀, Ideal.span_singleton_le_iff_mem]
      have hmem := Ideal.absNorm_mem p.asIdeal
      obtain ⟨c, hc⟩ := hdvd
      rw [hc, Nat.cast_mul]
      exact Ideal.mul_mem_right _ _ hmem
  have hsub : I ⊆ (T ×ˢ Finset.Icc 2 M).image (fun q => q.1 ^ q.2) := by
    intro J hJ
    obtain ⟨⟨p, m, hm, hJeq⟩, hN⟩ := hI J hJ
    rw [hJeq] at hN
    obtain ⟨_, hrad, hmM, _⟩ := hfacts p m hm hN
    rw [Finset.mem_image]
    refine ⟨(J.radical, m), ?_, ?_⟩
    · rw [Finset.mem_product, Finset.mem_Icc, hT]
      exact ⟨Finset.mem_image_of_mem _ hJ, hm, hmM⟩
    · simp only
      rw [hJeq, hrad]
  have hcard1 : I.card ≤ T.card * M := by
    calc I.card ≤ ((T ×ˢ Finset.Icc 2 M).image (fun q => q.1 ^ q.2)).card :=
          Finset.card_le_card hsub
      _ ≤ (T ×ˢ Finset.Icc 2 M).card := Finset.card_image_le
      _ = T.card * (M + 1 - 2) := by rw [Finset.card_product, Nat.card_Icc]
      _ ≤ T.card * M := Nat.mul_le_mul_left _ (by omega)
  have hTmax : ∀ P ∈ T, P.IsMaximal ∧ J₀ ≤ P := by
    intro P hP
    rw [hT] at hP
    obtain ⟨J, hJ, hPJ⟩ := Finset.mem_image.mp hP
    obtain ⟨⟨p, m, hm, hJeq⟩, hN⟩ := hI J hJ
    rw [hJeq] at hN
    obtain ⟨hmax, hrad, _, hle⟩ := hfacts p m hm hN
    rw [← hPJ, hJeq, hrad]
    exact ⟨hmax, hle⟩
  have hJ₀N : Ideal.absNorm J₀ = Y.factorial ^ Module.finrank ℚ K := by
    rw [hJ₀]; exact hnorm _
  have hJ₀ne : J₀ ≠ ⊥ := by
    intro h
    rw [h, Ideal.absNorm_bot] at hJ₀N
    exact pow_ne_zero _ (Nat.factorial_ne_zero Y) hJ₀N.symm
  have hE2 := hA J₀ hJ₀ne T hTmax
  rw [hJ₀N, Nat.cast_pow, Real.log_pow] at hE2
  have hX0 : (0:ℝ) ≤ X := by linarith
  have hsX : 1 ≤ Real.sqrt X := by
    rw [show (1:ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_le_sqrt hX
  have hY1 : 1 ≤ Y := by
    rw [hY]; apply Nat.le_floor; simpa using hsX
  have hYs : (Y:ℝ) ≤ Real.sqrt X := by rw [hY]; exact Nat.floor_le (Real.sqrt_nonneg X)
  have hsXX : Real.sqrt X ≤ X := by
    nlinarith [Real.sq_sqrt hX0]
  have hlogfac : Real.log (Y.factorial : ℝ) ≤ Real.sqrt X * Real.log X := by
    have h1 : (Y.factorial : ℝ) ≤ (Y:ℝ) ^ Y := by exact_mod_cast Nat.factorial_le_pow Y
    have hYpos : (0:ℝ) < Y := by exact_mod_cast hY1
    have h2 := Real.log_le_log (by positivity) h1
    rw [Real.log_pow] at h2
    have hlY : 0 ≤ Real.log (Y:ℝ) := Real.log_nonneg (by exact_mod_cast hY1)
    have hlYX : Real.log (Y:ℝ) ≤ Real.log X := Real.log_le_log hYpos (hYs.trans hsXX)
    calc Real.log (Y.factorial : ℝ) ≤ Y * Real.log Y := h2
      _ ≤ Real.sqrt X * Real.log X := mul_le_mul hYs hlYX hlY (Real.sqrt_nonneg _)
  have hL : 0 ≤ Real.log X := Real.log_nonneg hX
  have hn : (0:ℝ) ≤ Module.finrank ℚ K := Nat.cast_nonneg _
  have hTc : (T.card : ℝ) * Real.log 2 ≤ Module.finrank ℚ K * (Real.sqrt X * Real.log X) :=
    hE2.trans (mul_le_mul_of_nonneg_left hlogfac hn)
  have hMc : (M : ℝ) * Real.log 2 ≤ Real.log X := by
    have h1 : (M : ℝ) ≤ Real.log X / Real.log 2 := by
      rw [hM]; exact Nat.floor_le (div_nonneg hL hlog2.le)
    rwa [le_div_iff₀ hlog2] at h1
  have hIc : (I.card : ℝ) ≤ T.card * M := by exact_mod_cast hcard1
  have hLL : Real.log X * Real.log X ≤ (1 + Real.log X) ^ 2 := by nlinarith
  rw [← Real.sqrt_eq_rpow, div_mul_eq_mul_div, div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
  calc (I.card : ℝ) * Real.log 2 ^ 2 ≤ (T.card * M) * Real.log 2 ^ 2 := by gcongr
    _ = (T.card * Real.log 2) * (M * Real.log 2) := by ring
    _ ≤ (Module.finrank ℚ K * (Real.sqrt X * Real.log X)) * Real.log X :=
        mul_le_mul hTc hMc (by positivity) (by positivity)
    _ = (Module.finrank ℚ K * Real.sqrt X) * (Real.log X * Real.log X) := by ring
    _ ≤ (Module.finrank ℚ K * Real.sqrt X) * (1 + Real.log X) ^ 2 :=
        mul_le_mul_of_nonneg_left hLL (by positivity)

theorem kai_vonMangoldt_omegaBox_bound (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (M : ℝ) (hM : 1 ≤ M)
    (x : NumberField.RingOfIntegers K) (hx : x ∈ omegaBox ω M) :
    0 ≤ vonMangoldtO x ∧
      vonMangoldtO x ≤ (Module.finrank ℚ K : ℝ) * Real.log (C * M) :=
by
  classical
  have hC : 1 < C := hω.1
  have hCM : 1 ≤ C * M := one_le_mul_of_one_le_of_one_le hC.le hM
  have hlog : 0 ≤ Real.log (C * M) := Real.log_nonneg hCM
  
  have hs3 : basisSupNorm ω x ≤ M := by
    simp only [omegaBox, Finset.mem_image] at hx
    obtain ⟨v, hv, rfl⟩ := hx
    unfold basisSupNorm
    refine Real.iSup_le (fun j => ?_) (by linarith)
    have hrepr : ω.repr (ω.equivFun.symm v) j = v j := by
      rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    rw [hrepr]
    unfold intBox at hv
    rw [Finset.mem_Icc] at hv
    have h1 : -(⌊M⌋₊ : ℤ) ≤ v j := hv.1 j
    have h2 : v j ≤ (⌊M⌋₊ : ℤ) := hv.2 j
    have habs : |v j| ≤ (⌊M⌋₊ : ℤ) := abs_le.mpr ⟨h1, h2⟩
    have h3 : |((v j : ℤ) : ℝ)| ≤ ((⌊M⌋₊ : ℕ) : ℝ) := by
      rw [← Int.cast_abs]; exact_mod_cast habs
    exact h3.trans (Nat.floor_le (by linarith))
  have hbs0 : 0 ≤ basisSupNorm ω x := Real.iSup_nonneg (fun j => abs_nonneg _)
  have hcan0 : 0 ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) :=
    Real.iSup_nonneg (fun w => apply_nonneg w _)
  
  have hs1 : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) ≤
      canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ Module.finrank ℚ K := by
    have hle : ∀ w : NumberField.InfinitePlace K,
        w (algebraMap (NumberField.RingOfIntegers K) K x)
          ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) := fun w =>
      le_ciSup (f := fun w : NumberField.InfinitePlace K =>
        w (algebraMap (NumberField.RingOfIntegers K) K x)) (Set.finite_range _).bddAbove w
    have h1 : ∏ w : NumberField.InfinitePlace K,
          w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult
        ≤ ∏ w : NumberField.InfinitePlace K,
          canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult :=
      Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w _) _)
        (fun w _ => pow_le_pow_left₀ (apply_nonneg w _) (hle w) _)
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
    have hcast : (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) = ∏ w : NumberField.InfinitePlace K,
        w (algebraMap (NumberField.RingOfIntegers K) K x) ^ w.mult := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm, Nat.cast_natAbs, Int.cast_abs, Rat.cast_abs]
      congr 1
      have hn := Algebra.coe_norm_int x
      rw [show algebraMap (NumberField.RingOfIntegers K) K x = (x : K) from rfl, ← hn]
      simp
    rw [hcast]; exact h1
  unfold vonMangoldtO
  split_ifs with h
  · obtain ⟨m, hm, hspan⟩ := h.choose_spec
    have ha0 : Ideal.absNorm h.choose.asIdeal ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact h.choose.ne_bot
    have hnorm : (Algebra.norm ℤ x).natAbs = Ideal.absNorm h.choose.asIdeal ^ m := by
      have := congrArg Ideal.absNorm hspan
      rw [map_pow, Ideal.absNorm_span_singleton] at this
      exact this
    have ha_le : Ideal.absNorm h.choose.asIdeal ≤ (Algebra.norm ℤ x).natAbs := by
      rw [hnorm]; exact Nat.le_self_pow (Nat.pos_iff_ne_zero.mp hm) _
    have ha1 : (1 : ℝ) ≤ (Ideal.absNorm h.choose.asIdeal : ℝ) := by
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr ha0
    refine ⟨Real.log_nonneg ha1, ?_⟩
    have hchain : (Ideal.absNorm h.choose.asIdeal : ℝ) ≤ (C * M) ^ Module.finrank ℚ K := by
      calc (Ideal.absNorm h.choose.asIdeal : ℝ)
          ≤ (((Algebra.norm ℤ x).natAbs : ℕ) : ℝ) := by exact_mod_cast ha_le
        _ ≤ canNorm K (algebraMap (NumberField.RingOfIntegers K) K x) ^ Module.finrank ℚ K := hs1
        _ ≤ (C * basisSupNorm ω x) ^ Module.finrank ℚ K :=
            pow_le_pow_left₀ hcan0 ((hω.2 x).2) _
        _ ≤ (C * M) ^ Module.finrank ℚ K :=
            pow_le_pow_left₀ (mul_nonneg (by linarith) hbs0)
              (mul_le_mul_of_nonneg_left hs3 (by linarith)) _
    calc Real.log (Ideal.absNorm h.choose.asIdeal : ℝ)
        ≤ Real.log ((C * M) ^ Module.finrank ℚ K) := Real.log_le_log (by linarith) hchain
      _ = (Module.finrank ℚ K : ℝ) * Real.log (C * M) := Real.log_pow _ _
  · exact ⟨le_refl 0, mul_nonneg (Nat.cast_nonneg _) hlog⟩

theorem kai_vonMangoldt_negligible (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∃ C₇ : ℝ, 0 ≤ C₇ ∧
      (∀ x : NumberField.RingOfIntegers K, Prime x →
        vonMangoldtO x = Real.log ((Algebra.norm ℤ x).natAbs : ℝ)) ∧
      ∀ M : ℝ, 3 ≤ M →
        (∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K) (fun x => ¬ Prime x)
            (fun _ => Classical.propDecidable _) (omegaBox ω M), vonMangoldtO x)
            ≤ C₇ * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 4) ∧
        ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)) (a : NumberField.RingOfIntegers K),
          𝔮 ≠ ⊥ → ¬ IsCoprime (Ideal.span {a}) 𝔮 →
          (∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K) (fun x => Prime x ∧ x - a ∈ 𝔮)
              (fun _ => Classical.propDecidable _) (omegaBox ω M), vonMangoldtO x)
            ≤ C₇ * (1 + Real.log (Ideal.absNorm 𝔮 : ℝ)) * Real.log M ^ (Module.finrank ℚ K + 1) :=
by
  classical
  have hΛp : ∀ x : NumberField.RingOfIntegers K, Prime x →
      vonMangoldtO x = Real.log ((Algebra.norm ℤ x).natAbs : ℝ) := by
    intro x hx
    have hx0 : x ≠ 0 := hx.ne_zero
    have hPprime : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx0).mpr hx
    have hPbot : Ideal.span {x} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact hx0
    have h : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 0 < m ∧ Ideal.span {x} = p.asIdeal ^ m :=
      ⟨⟨Ideal.span {x}, hPprime, hPbot⟩, 1, one_pos, (pow_one _).symm⟩
    unfold vonMangoldtO
    rw [dif_pos h]
    obtain ⟨m, hm, hpm⟩ := h.choose_spec
    have hle1 : h.choose.asIdeal ≤ Ideal.span {x} :=
      hPprime.le_of_pow_le (le_of_eq hpm.symm)
    have hle2 : Ideal.span {x} ≤ h.choose.asIdeal :=
      hpm.le.trans (Ideal.pow_le_self (by omega))
    rw [le_antisymm hle1 hle2, Ideal.absNorm_span_singleton]
  have hΛnp : ∀ x : NumberField.RingOfIntegers K, ¬ Prime x → vonMangoldtO x ≠ 0 →
      ∃ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
        2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m := by
    intro x hx hne
    by_cases h : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 0 < m ∧ Ideal.span {x} = p.asIdeal ^ m
    · obtain ⟨p, m, hm, hpm⟩ := h
      refine ⟨p, m, ?_, hpm⟩
      by_contra hm2
      have hm1 : m = 1 := by omega
      rw [hm1, pow_one] at hpm
      have hx0 : x ≠ 0 := by
        intro hx0
        apply p.ne_bot
        rw [← hpm, hx0]
        exact Ideal.span_singleton_eq_bot.mpr rfl
      apply hx
      rw [← Ideal.span_singleton_prime hx0, hpm]
      exact p.isPrime
    · exfalso
      apply hne
      unfold vonMangoldtO
      rw [dif_neg h]
  obtain ⟨A₁, hA₁, hassoc⟩ := kai_associates_card_bound K
  obtain ⟨D₀, hD₀, hcrt, hpp⟩ := kai_prime_ideal_count K
  have hC1 : 1 < C := hω.1
  have hCpos : 0 < C := by linarith
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hn0 : Module.finrank ℚ K ≠ 0 := by omega
  obtain ⟨nR, hnR_def⟩ : ∃ nR : ℝ, nR = (Module.finrank ℚ K : ℝ) := ⟨_, rfl⟩
  have hnR1 : 1 ≤ nR := by rw [hnR_def]; exact_mod_cast hn1
  obtain ⟨γ, hγ_def⟩ : ∃ γ : ℝ, γ = Real.log C := ⟨_, rfl⟩
  have hγ : 0 < γ := by rw [hγ_def]; exact Real.log_pos hC1
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = nR * (1 + γ) := ⟨_, rfl⟩
  have ha0 : 0 ≤ a := by rw [ha_def]; exact mul_nonneg (by linarith) (by linarith)
  obtain ⟨κ, hκ_def⟩ : ∃ κ : ℝ, κ = a + 1 := ⟨_, rfl⟩
  have hκ0 : 0 ≤ κ := by linarith
  obtain ⟨A₀, hA₀_def⟩ : ∃ A₀ : ℝ, A₀ = A₁ * κ ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hA₀ : 0 ≤ A₀ := by rw [hA₀_def]; exact mul_nonneg hA₁ (pow_nonneg hκ0 _)
  obtain ⟨Cn, hCn_def⟩ : ∃ Cn : ℝ, Cn = (C ^ Module.finrank ℚ K) ^ ((1:ℝ)/2) := ⟨_, rfl⟩
  have hCn : 0 ≤ Cn := by rw [hCn_def]; exact Real.rpow_nonneg (pow_nonneg hCpos.le _) _
  obtain ⟨e, he_def⟩ : ∃ e : ℝ, e = 4 * (nR + 3) := ⟨_, rfl⟩
  have he : 0 < e := by rw [he_def]; linarith
  obtain ⟨K₃, hK₃_def⟩ : ∃ K₃ : ℝ, K₃ = e ^ (Module.finrank ℚ K + 3) := ⟨_, rfl⟩
  have hK₃ : 0 ≤ K₃ := by rw [hK₃_def]; exact pow_nonneg he.le _
  obtain ⟨G, hG_def⟩ : ∃ G : ℝ, G = a * A₀ * D₀ * κ ^ 2 * Cn := ⟨_, rfl⟩
  have hG : 0 ≤ G := by
    rw [hG_def]
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg ha0 hA₀) hD₀) (pow_nonneg hκ0 2)) hCn
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  obtain ⟨K₄, hK₄_def⟩ : ∃ K₄ : ℝ, K₄ = A₀ * a / Real.log 2 := ⟨_, rfl⟩
  have hK₄ : 0 ≤ K₄ := by rw [hK₄_def]; exact div_nonneg (mul_nonneg hA₀ ha0) hlog2.le
  have hK₂ : 0 ≤ G * K₃ := mul_nonneg hG hK₃
  refine ⟨G * K₃ + K₄, add_nonneg hK₂ hK₄, hΛp, ?_⟩
  intro M hM
  have hMpos : 0 < M := by linarith
  have hM1 : 1 ≤ M := by linarith
  obtain ⟨ℓ, hℓ_def⟩ : ∃ ℓ : ℝ, ℓ = Real.log M := ⟨_, rfl⟩
  have hℓ1 : 1 ≤ ℓ := by
    have h : 1 < Real.log M := by
      rw [Real.lt_log_iff_exp_lt hMpos]
      have := Real.exp_one_lt_d9
      linarith
    rw [hℓ_def]; exact h.le
  have hℓ0 : 0 ≤ ℓ := by linarith
  have hCM1 : 1 ≤ C * M := by nlinarith
  have hlogCM : Real.log (C * M) = γ + ℓ := by
    rw [Real.log_mul hCpos.ne' hMpos.ne', hγ_def, hℓ_def]
  have hΛB : ∀ x ∈ omegaBox ω M, 0 ≤ vonMangoldtO x ∧ vonMangoldtO x ≤ a * ℓ := by
    intro x hx
    obtain ⟨h0, h1⟩ := kai_vonMangoldt_omegaBox_bound K C ω hω M hM1 x hx
    refine ⟨h0, h1.trans ?_⟩
    rw [hlogCM, ← hnR_def, ha_def]
    have h3 : γ ≤ γ * ℓ := le_mul_of_one_le_right hγ.le hℓ1
    have h2 : nR * γ ≤ nR * (γ * ℓ) := mul_le_mul_of_nonneg_left h3 (by linarith)
    nlinarith
  obtain ⟨Y, hY_def⟩ : ∃ Y : ℝ, Y = (C * M) ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hY1 : 1 ≤ Y := by rw [hY_def]; exact one_le_pow₀ hCM1
  have hCMY : C * M ≤ Y := by rw [hY_def]; exact le_self_pow₀ hCM1 hn0
  have hlogY : Real.log Y = nR * (γ + ℓ) := by
    rw [hY_def, Real.log_pow, hlogCM, hnR_def]
  have h1logY0 : 0 ≤ 1 + Real.log Y := by have := Real.log_nonneg hY1; linarith
  have h1logY : 1 + Real.log Y ≤ κ * ℓ := by
    rw [hlogY, hκ_def, ha_def]
    have h3 : nR * γ ≤ nR * γ * ℓ := le_mul_of_one_le_right (by nlinarith) hℓ1
    nlinarith
  have F1 : ∀ S : Finset (NumberField.RingOfIntegers K), S ⊆ omegaBox ω M →
      (∀ y ∈ S, y ≠ 0) → (∀ y ∈ S, ∀ y' ∈ S, Ideal.span {y} = Ideal.span {y'}) →
      (S.card : ℝ) ≤ A₀ * ℓ ^ Module.finrank ℚ K := by
    intro S hSB hS0 hSspan
    have h := hassoc Y hY1 S hSspan (by
      intro y hy w
      obtain ⟨hup, -, hlow⟩ := kai_omegaBox_place_bounds K C ω hω M hM1 y (hSB hy)
      refine ⟨?_, (hup w).trans hCMY⟩
      rw [hY_def]; exact hlow (hS0 y hy) w)
    refine h.trans ?_
    rw [hA₀_def, mul_assoc, ← mul_pow]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ h1logY0 h1logY _) hA₁
  have F1' : ∀ T : Finset (NumberField.RingOfIntegers K), T ⊆ omegaBox ω M →
      (∀ y ∈ T, y ≠ 0) →
      (T.card : ℝ) ≤ A₀ * ℓ ^ Module.finrank ℚ K *
        (T.image (fun y => Ideal.span {y})).card := by
    intro T hTB hT0
    rw [Finset.card_eq_sum_card_image (fun y => Ideal.span {y}) T, Nat.cast_sum]
    calc ∑ I ∈ T.image (fun y => Ideal.span {y}),
          ((T.filter (fun y => Ideal.span {y} = I)).card : ℝ)
        ≤ ∑ I ∈ T.image (fun y => Ideal.span {y}), A₀ * ℓ ^ Module.finrank ℚ K := by
          apply Finset.sum_le_sum
          intro I _
          apply F1
          · exact (Finset.filter_subset _ _).trans hTB
          · intro y hy; exact hT0 y (Finset.filter_subset _ _ hy)
          · intro y hy y' hy'
            rw [(Finset.mem_filter.1 hy).2, (Finset.mem_filter.1 hy').2]
      _ = A₀ * ℓ ^ Module.finrank ℚ K * (T.image (fun y => Ideal.span {y})).card := by
          rw [Finset.sum_const, nsmul_eq_mul]; ring
  have hAl : 0 ≤ A₀ * ℓ ^ Module.finrank ℚ K := mul_nonneg hA₀ (pow_nonneg hℓ0 _)
  have haℓ : 0 ≤ a * ℓ := mul_nonneg ha0 hℓ0
  constructor
  · 
    obtain ⟨F, hF⟩ : ∃ F : Finset (NumberField.RingOfIntegers K),
        F = @Finset.filter (NumberField.RingOfIntegers K) (fun x => ¬ Prime x)
          (fun _ => Classical.propDecidable _) (omegaBox ω M) := ⟨_, rfl⟩
    rw [← hF]
    have hmemF : ∀ x, x ∈ F ↔ x ∈ omegaBox ω M ∧ ¬ Prime x := by
      intro x; rw [hF, Finset.filter_congr_decidable, Finset.mem_filter]
    rw [← Finset.sum_filter_ne_zero]
    obtain ⟨S₂, hS₂⟩ : ∃ S₂ : Finset (NumberField.RingOfIntegers K),
        S₂ = F.filter (fun x => vonMangoldtO x ≠ 0) := ⟨_, rfl⟩
    rw [← hS₂]
    have hmemS₂ : ∀ x ∈ S₂, x ∈ omegaBox ω M ∧ ¬ Prime x ∧ vonMangoldtO x ≠ 0 := by
      intro x hx
      rw [hS₂, Finset.mem_filter, hmemF] at hx
      exact ⟨hx.1.1, hx.1.2, hx.2⟩
    have hS₂B : S₂ ⊆ omegaBox ω M := fun x hx => (hmemS₂ x hx).1
    have hS₂struct : ∀ x ∈ S₂,
        ∃ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
          2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m :=
      fun x hx => hΛnp x (hmemS₂ x hx).2.1 (hmemS₂ x hx).2.2
    have hS₂0 : ∀ x ∈ S₂, x ≠ 0 := by
      intro x hx hx0
      obtain ⟨p, m, -, hpm⟩ := hS₂struct x hx
      have h1 : Ideal.span {x} = ⊥ := by rw [hx0]; exact Ideal.span_singleton_eq_bot.mpr rfl
      have h2 : p.asIdeal ^ m ≠ ⊥ := by
        rw [← Ideal.zero_eq_bot]
        exact pow_ne_zero m (by rw [Ideal.zero_eq_bot]; exact p.ne_bot)
      exact h2 (hpm.symm.trans h1)
    have hsum : ∑ x ∈ S₂, vonMangoldtO x ≤ (S₂.card : ℝ) * (a * ℓ) := by
      have := Finset.sum_le_card_nsmul S₂ vonMangoldtO (a * ℓ)
        (fun x hx => (hΛB x (hS₂B hx)).2)
      rwa [nsmul_eq_mul] at this
    have hI := hpp Y hY1 (S₂.image (fun y => Ideal.span {y})) (by
      intro J hJ
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.1 hJ
      refine ⟨hS₂struct x hx, ?_⟩
      rw [Ideal.absNorm_span_singleton, hY_def]
      exact (kai_omegaBox_place_bounds K C ω hω M hM1 x (hS₂B hx)).2.1)
    obtain ⟨P, hP_def⟩ : ∃ P : ℝ, P = M ^ (nR * ((1:ℝ)/2)) := ⟨_, rfl⟩
    have hP0 : 0 ≤ P := by rw [hP_def]; exact Real.rpow_nonneg hMpos.le _
    have hYP : Y ^ ((1:ℝ)/2) = Cn * P := by
      rw [hY_def, mul_pow, Real.mul_rpow (pow_nonneg hCpos.le _) (pow_nonneg hMpos.le _),
        hCn_def, hP_def, Real.rpow_mul hMpos.le, hnR_def, Real.rpow_natCast]
    obtain ⟨Q, hQ_def⟩ : ∃ Q : ℝ, Q = M ^ ((1:ℝ)/4) := ⟨_, rfl⟩
    have hℓ3 : ℓ ^ (Module.finrank ℚ K + 3) ≤ K₃ * Q := by
      have h1 := Real.log_le_rpow_div hMpos.le (inv_pos.mpr he)
      rw [div_inv_eq_mul, ← hℓ_def] at h1
      have hexp : e⁻¹ * (((Module.finrank ℚ K + 3 : ℕ)) : ℝ) = 1 / 4 := by
        have h3 : (Module.finrank ℚ K : ℝ) + 3 ≠ 0 := by positivity
        rw [he_def, hnR_def]; push_cast; field_simp
      calc ℓ ^ (Module.finrank ℚ K + 3) ≤ (M ^ e⁻¹ * e) ^ (Module.finrank ℚ K + 3) :=
            pow_le_pow_left₀ hℓ0 h1 _
        _ = e ^ (Module.finrank ℚ K + 3) * (M ^ e⁻¹) ^ (Module.finrank ℚ K + 3) := by ring
        _ = K₃ * Q := by
            rw [hK₃_def, hQ_def, ← Real.rpow_natCast (M ^ e⁻¹), ← Real.rpow_mul hMpos.le, hexp]
    have hPQ : P * Q ≤ M ^ ((Module.finrank ℚ K : ℝ) - 1 / 4) := by
      rw [hP_def, hQ_def, ← Real.rpow_add hMpos]
      apply Real.rpow_le_rpow_of_exponent_le hM1
      rw [← hnR_def]
      linarith
    have hcI : ((S₂.image (fun y => Ideal.span {y})).card : ℝ)
        ≤ D₀ * (Cn * P) * (κ * ℓ) ^ 2 := by
      refine hI.trans ?_
      rw [hYP]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ h1logY0 h1logY 2)
        (mul_nonneg hD₀ (mul_nonneg hCn hP0))
    have hcS₂ := F1' S₂ hS₂B hS₂0
    calc ∑ x ∈ S₂, vonMangoldtO x ≤ (S₂.card : ℝ) * (a * ℓ) := hsum
      _ ≤ (A₀ * ℓ ^ Module.finrank ℚ K
            * ((S₂.image (fun y => Ideal.span {y})).card : ℝ)) * (a * ℓ) :=
          mul_le_mul_of_nonneg_right hcS₂ haℓ
      _ ≤ (A₀ * ℓ ^ Module.finrank ℚ K * (D₀ * (Cn * P) * (κ * ℓ) ^ 2)) * (a * ℓ) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hcI hAl) haℓ
      _ = G * ℓ ^ (Module.finrank ℚ K + 3) * P := by rw [hG_def]; ring
      _ ≤ G * (K₃ * Q) * P :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hℓ3 hG) hP0
      _ = (G * K₃) * (P * Q) := by ring
      _ ≤ (G * K₃) * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 4) :=
          mul_le_mul_of_nonneg_left hPQ hK₂
      _ ≤ (G * K₃ + K₄) * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 4) :=
          mul_le_mul_of_nonneg_right (by linarith) (Real.rpow_nonneg hMpos.le _)
  · 
    intro 𝔮 a₀ h𝔮 hcop
    obtain ⟨F, hF⟩ : ∃ F : Finset (NumberField.RingOfIntegers K),
        F = @Finset.filter (NumberField.RingOfIntegers K) (fun x => Prime x ∧ x - a₀ ∈ 𝔮)
          (fun _ => Classical.propDecidable _) (omegaBox ω M) := ⟨_, rfl⟩
    rw [← hF, ← hℓ_def]
    have hmemF : ∀ x, x ∈ F ↔ x ∈ omegaBox ω M ∧ (Prime x ∧ x - a₀ ∈ 𝔮) := by
      intro x; rw [hF, Finset.filter_congr_decidable, Finset.mem_filter]
    have hFB : F ⊆ omegaBox ω M := fun x hx => ((hmemF x).1 hx).1
    have hF0 : ∀ x ∈ F, x ≠ 0 := fun x hx => ((hmemF x).1 hx).2.1.ne_zero
    have hmax : ∀ P ∈ F.image (fun y => Ideal.span {y}), P.IsMaximal ∧ 𝔮 ≤ P := by
      intro P hP
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hP
      obtain ⟨-, hyp, hya⟩ := (hmemF y).1 hy
      have hy0 : y ≠ 0 := hyp.ne_zero
      have hPprime : (Ideal.span {y}).IsPrime := (Ideal.span_singleton_prime hy0).mpr hyp
      have hPbot : Ideal.span {y} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]; exact hy0
      have hPmax : (Ideal.span {y}).IsMaximal := hPprime.isMaximal hPbot
      refine ⟨hPmax, ?_⟩
      by_contra hle
      have hlt : Ideal.span {y} < Ideal.span {y} ⊔ 𝔮 := by
        refine lt_of_le_of_ne le_sup_left ?_
        intro h
        exact hle (le_sup_right.trans h.ge)
      have htop : Ideal.span {y} ⊔ 𝔮 = ⊤ := hPmax.out.2 _ hlt
      apply hcop
      rw [Ideal.isCoprime_iff_sup_eq, eq_top_iff, ← htop]
      refine sup_le ?_ le_sup_right
      rw [Ideal.span_singleton_le_iff_mem]
      have hmem : a₀ + (y - a₀) ∈ Ideal.span {a₀} ⊔ 𝔮 :=
        Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self a₀))
          (Ideal.mem_sup_right hya)
      simpa using hmem
    have hc := hcrt 𝔮 h𝔮 _ hmax
    have hlogq : 0 ≤ Real.log (Ideal.absNorm 𝔮 : ℝ) := Real.log_natCast_nonneg _
    have hc' : ((F.image (fun y => Ideal.span {y})).card : ℝ)
        ≤ Real.log (Ideal.absNorm 𝔮 : ℝ) / Real.log 2 := by
      rw [le_div_iff₀ hlog2]; exact hc
    have hcF := F1' F hFB hF0
    have hsum : ∑ x ∈ F, vonMangoldtO x ≤ (F.card : ℝ) * (a * ℓ) := by
      have := Finset.sum_le_card_nsmul F vonMangoldtO (a * ℓ)
        (fun x hx => (hΛB x (hFB hx)).2)
      rwa [nsmul_eq_mul] at this
    calc ∑ x ∈ F, vonMangoldtO x ≤ (F.card : ℝ) * (a * ℓ) := hsum
      _ ≤ (A₀ * ℓ ^ Module.finrank ℚ K
            * ((F.image (fun y => Ideal.span {y})).card : ℝ)) * (a * ℓ) :=
          mul_le_mul_of_nonneg_right hcF haℓ
      _ ≤ (A₀ * ℓ ^ Module.finrank ℚ K
            * (Real.log (Ideal.absNorm 𝔮 : ℝ) / Real.log 2)) * (a * ℓ) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hc' hAl) haℓ
      _ = K₄ * Real.log (Ideal.absNorm 𝔮 : ℝ) * ℓ ^ (Module.finrank ℚ K + 1) := by
          rw [hK₄_def]; ring
      _ ≤ (G * K₃ + K₄) * (1 + Real.log (Ideal.absNorm 𝔮 : ℝ))
            * ℓ ^ (Module.finrank ℚ K + 1) := by
          apply mul_le_mul_of_nonneg_right _ (pow_nonneg hℓ0 _)
          nlinarith [mul_nonneg hK₂ hlogq]

theorem kai_convex_boundary_lattice (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C₉ : ℝ, 0 ≤ C₉ ∧ ∀ (M : ℝ), 1 ≤ M →
      ∀ Ω : Set (Fin (Module.finrank ℚ K) → ℝ), Convex ℝ Ω →
        (((@Finset.filter (NumberField.RingOfIntegers K) (fun x =>
            (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧
            (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∉ interior Ω)
            (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℕ) : ℝ)
          ≤ C₉ * (M + 1) ^ (Module.finrank ℚ K - 1) :=
by
  classical
  
  have s3 : ∀ (n : ℕ), 1 ≤ n → ∀ (Ω : Set (Fin n → ℝ)), Convex ℝ Ω → ∀ x : Fin n → ℝ,
      x ∈ Ω → x ∉ interior Ω →
      ∃ i : Fin n, ∃ σ : ℝ, (σ = 1 ∨ σ = -1) ∧
        ∀ t : ℝ, 0 < t → x + (σ * t) • (Pi.single i (1 : ℝ) : Fin n → ℝ) ∉ Ω := by
    intro n hn Ω hΩ x hx hxi
    by_contra h
    push_neg at h
    have hp : ∀ i, ∃ t : ℝ, 0 < t ∧ x + t • (Pi.single i (1:ℝ) : Fin n → ℝ) ∈ Ω := by
      intro i
      obtain ⟨t, ht, hm⟩ := h i 1 (Or.inl rfl)
      rw [one_mul] at hm
      exact ⟨t, ht, hm⟩
    have hm : ∀ i, ∃ t : ℝ, 0 < t ∧ x + (-t) • (Pi.single i (1:ℝ) : Fin n → ℝ) ∈ Ω := by
      intro i
      obtain ⟨t, ht, hm⟩ := h i (-1) (Or.inr rfl)
      rw [neg_one_mul] at hm
      exact ⟨t, ht, hm⟩
    choose tp htp hP using hp
    choose tm htm hQ using hm
    set τ : Fin n → ℝ := fun i => min (tp i) (tm i) with hτ
    have hτpos : ∀ i, 0 < τ i := fun i => lt_min (htp i) (htm i)
    have hline : ∀ i, ∀ s : ℝ, |s| < τ i →
        x + s • (Pi.single i (1:ℝ) : Fin n → ℝ) ∈ Ω := by
      intro i s hs
      have h1 : τ i ≤ tp i := min_le_left _ _
      have h2 : τ i ≤ tm i := min_le_right _ _
      rcases le_or_gt 0 s with h0 | h0
      · rw [abs_of_nonneg h0] at hs
        have hmem := hΩ.add_smul_mem hx (hP i)
          (t := s / tp i) ⟨div_nonneg h0 (htp i).le, (div_le_one (htp i)).2 (by linarith)⟩
        rwa [smul_smul, div_mul_cancel₀ _ (htp i).ne'] at hmem
      · rw [abs_of_neg h0] at hs
        have hmem := hΩ.add_smul_mem hx (hQ i)
          (t := s / (-tm i)) ⟨div_nonneg_of_nonpos h0.le (by linarith [htm i]),
            by rw [div_le_one_of_neg (by linarith [htm i])]; linarith⟩
        rwa [smul_smul, div_mul_cancel₀ _ (by linarith [htm i] : (-tm i) ≠ 0)] at hmem
    have hnpos : (0 : ℝ) < n := by exact_mod_cast hn
    set U : Set (Fin n → ℝ) :=
      Set.univ.pi (fun j => Set.Ioo (x j - τ j / n) (x j + τ j / n)) with hU
    have hUo : IsOpen U := isOpen_set_pi Set.finite_univ (fun _ _ => isOpen_Ioo)
    have hxU : x ∈ U := by
      rw [hU, Set.mem_univ_pi]
      intro j
      have := div_pos (hτpos j) hnpos
      constructor <;> linarith
    have hUΩ : U ⊆ Ω := by
      intro y hy
      rw [hU, Set.mem_univ_pi] at hy
      set z : Fin n → (Fin n → ℝ) :=
        fun j => x + ((n : ℝ) * (y j - x j)) • (Pi.single j (1:ℝ) : Fin n → ℝ) with hz
      have hzΩ : ∀ j ∈ (Finset.univ : Finset (Fin n)), z j ∈ Ω := by
        intro j _
        apply hline
        obtain ⟨h1, h2⟩ := hy j
        rw [abs_mul, abs_of_pos hnpos]
        have hlt : |y j - x j| < τ j / n := by rw [abs_lt]; constructor <;> linarith
        have e : (n : ℝ) * (τ j / n) = τ j := by field_simp
        calc (n : ℝ) * |y j - x j| < (n : ℝ) * (τ j / n) := mul_lt_mul_of_pos_left hlt hnpos
          _ = τ j := e
      have hsum : ∑ j, (1 / (n : ℝ)) • z j = y := by
        funext k
        simp only [hz, Finset.sum_apply, Pi.smul_apply, Pi.add_apply, Pi.single_apply,
          smul_eq_mul, mul_ite, mul_one, mul_zero, mul_add, Finset.sum_add_distrib]
        rw [Finset.sum_ite_eq]
        simp only [Finset.mem_univ, if_true, Finset.sum_const, Finset.card_univ,
          Fintype.card_fin, nsmul_eq_mul]
        field_simp
        ring
      rw [← hsum]
      apply hΩ.sum_mem
      · intro j _; positivity
      · rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        field_simp
      · exact hzΩ
    exact hxi (interior_maximal hUΩ hUo hxU)
  
  have s5 : ∀ (n : ℕ) (Ω : Set (Fin n → ℝ)) (i : Fin n) (σ : ℝ),
      (σ = 1 ∨ σ = -1) → ∀ (v w : Fin n → ℤ), (∀ j, j ≠ i → v j = w j) →
      (fun j => ((v j : ℤ) : ℝ)) ∈ Ω → (fun j => ((w j : ℤ) : ℝ)) ∈ Ω →
      (∀ t : ℝ, 0 < t →
        (fun j => ((v j : ℤ) : ℝ)) + (σ * t) • (Pi.single i (1 : ℝ) : Fin n → ℝ) ∉ Ω) →
      (∀ t : ℝ, 0 < t →
        (fun j => ((w j : ℤ) : ℝ)) + (σ * t) • (Pi.single i (1 : ℝ) : Fin n → ℝ) ∉ Ω) →
      v = w := by
    intro n Ω i σ hσ v w hvw hv hw hve hwe
    have key : ∀ a b : Fin n → ℤ, (∀ j, j ≠ i → a j = b j) → ∀ s : ℝ,
        s = ((b i - a i : ℤ) : ℝ) →
        (fun j => ((b j : ℤ) : ℝ)) =
          (fun j => ((a j : ℤ) : ℝ)) + s • (Pi.single i (1 : ℝ) : Fin n → ℝ) := by
      intro a b hab s hs
      funext j
      simp only [Pi.add_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
      by_cases hj : j = i
      · subst hj; rw [if_pos rfl, hs]; push_cast; ring
      · rw [if_neg hj, hab j hj]; ring
    have hwv : ∀ j, j ≠ i → w j = v j := fun j hj => (hvw j hj).symm
    have hii : v i = w i := by
      rcases lt_trichotomy (v i) (w i) with hlt | heq | hgt
      · exfalso
        have ht : (0:ℝ) < ((w i - v i : ℤ) : ℝ) := by exact_mod_cast sub_pos.mpr hlt
        rcases hσ with rfl | rfl
        · apply hve _ ht
          rw [one_mul, ← key v w hvw _ rfl]; exact hw
        · apply hwe _ ht
          rw [← key w v hwv _ (by push_cast; ring)]; exact hv
      · exact heq
      · exfalso
        have ht : (0:ℝ) < ((v i - w i : ℤ) : ℝ) := by exact_mod_cast sub_pos.mpr hgt
        rcases hσ with rfl | rfl
        · apply hwe _ ht
          rw [one_mul, ← key w v hwv _ rfl]; exact hv
        · apply hve _ ht
          rw [← key v w hvw _ (by push_cast; ring)]; exact hw
    funext j
    by_cases hj : j = i
    · subst hj; exact hii
    · exact hvw j hj
  
  have s6 : ∀ (n m : ℕ) (i : Fin n) (A : Finset (Fin n → ℤ)),
      A ⊆ Finset.Icc (fun _ => -(m:ℤ)) (fun _ => (m:ℤ)) →
      (∀ v ∈ A, ∀ w ∈ A, (∀ j, j ≠ i → v j = w j) → v = w) →
      A.card ≤ (2 * m + 1) ^ (n - 1) := by
    intro n m i A hA hinj
    set T := Fintype.piFinset (fun _ : {j // j ≠ i} => Finset.Icc (-(m:ℤ)) (m:ℤ)) with hT
    have hle : A.card ≤ T.card := by
      apply Finset.card_le_card_of_injOn (fun v => fun j : {j // j ≠ i} => v j)
      · intro v hv
        have hv' := hA hv
        simp only [Finset.mem_Icc, Pi.le_def] at hv'
        simp only [hT, Finset.mem_coe, Fintype.mem_piFinset, Finset.mem_Icc]
        intro j
        exact ⟨hv'.1 j, hv'.2 j⟩
      · intro v hv w hw hvw
        apply hinj v hv w hw
        intro j hj
        exact congrFun hvw ⟨j, hj⟩
    have hTc : T.card = (2 * m + 1) ^ (n - 1) := by
      rw [hT, Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Int.card_Icc]
      have h1 : ((m:ℤ) + 1 - -(m:ℤ)).toNat = 2 * m + 1 := by omega
      rw [h1]
      congr 1
      rw [Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_subtype_eq]
    omega
  
  have hn : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  refine ⟨2 * (Module.finrank ℚ K : ℝ) * 2 ^ (Module.finrank ℚ K - 1), by positivity, ?_⟩
  intro M hM Ω hΩ
  have hmM : ((⌊M⌋₊ : ℕ) : ℝ) ≤ M := Nat.floor_le (by linarith)
  have hbox : intBox (Module.finrank ℚ K) ⌊M⌋₊ =
      Finset.Icc (fun _ => -((⌊M⌋₊ : ℕ) : ℤ)) (fun _ => ((⌊M⌋₊ : ℕ) : ℤ)) := by
    unfold intBox; rfl
  set S : Finset (Fin (Module.finrank ℚ K) → ℤ) :=
    (intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun v =>
      (fun j => ((v j : ℤ) : ℝ)) ∈ Ω ∧ (fun j => ((v j : ℤ) : ℝ)) ∉ interior Ω) with hS
  have hFS : ∀ F' : Finset (NumberField.RingOfIntegers K), F' ⊆ omegaBox ω M →
      (∀ x ∈ F', (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧
        (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∉ interior Ω) → F'.card ≤ S.card := by
    intro F' hF'sub hF'
    apply Finset.card_le_card_of_injOn (fun x => ω.equivFun x)
    · intro x hx
      have hx' : x ∈ F' := hx
      obtain ⟨h1, h2⟩ := hF' x hx'
      have hxB := hF'sub hx'
      unfold omegaBox at hxB
      rw [Finset.mem_image] at hxB
      obtain ⟨v, hv, hvx⟩ := hxB
      have hev : ω.equivFun x = v := by rw [← hvx]; exact LinearEquiv.apply_symm_apply _ _
      show ω.equivFun x ∈ S
      rw [hS, Finset.mem_filter]
      exact ⟨hev ▸ hv, h1, h2⟩
    · intro x _ y _ hxy
      exact ω.equivFun.injective hxy
  set I : Finset (Fin (Module.finrank ℚ K) × ℝ) :=
    (Finset.univ : Finset (Fin (Module.finrank ℚ K))) ×ˢ ({1, -1} : Finset ℝ) with hI
  set E : Fin (Module.finrank ℚ K) × ℝ → Finset (Fin (Module.finrank ℚ K) → ℤ) :=
    fun p => (intBox (Module.finrank ℚ K) ⌊M⌋₊).filter (fun v =>
      (fun j => ((v j : ℤ) : ℝ)) ∈ Ω ∧ ∀ t : ℝ, 0 < t →
        (fun j => ((v j : ℤ) : ℝ)) + (p.2 * t) •
          (Pi.single p.1 (1 : ℝ) : Fin (Module.finrank ℚ K) → ℝ) ∉ Ω) with hE
  have hSsub : S ⊆ I.biUnion E := by
    intro v hv
    rw [hS, Finset.mem_filter] at hv
    obtain ⟨hvB, h1, h2⟩ := hv
    obtain ⟨i, σ, hσ, hext⟩ := s3 _ hn Ω hΩ _ h1 h2
    rw [Finset.mem_biUnion]
    refine ⟨(i, σ), ?_, ?_⟩
    · rw [hI, Finset.mem_product]
      refine ⟨Finset.mem_univ _, ?_⟩
      rcases hσ with rfl | rfl <;> simp
    · show v ∈ (intBox (Module.finrank ℚ K) ⌊M⌋₊).filter _
      rw [Finset.mem_filter]
      exact ⟨hvB, h1, hext⟩
  have hEcard : ∀ p ∈ I, (E p).card ≤ (2 * ⌊M⌋₊ + 1) ^ (Module.finrank ℚ K - 1) := by
    intro p hp
    rw [hI, Finset.mem_product] at hp
    have hσ : p.2 = 1 ∨ p.2 = -1 := by
      have := hp.2
      simpa using this
    apply s6 _ _ p.1 (E p)
    · rw [← hbox]; exact Finset.filter_subset _ _
    · intro v hv w hw hvw
      have hv' : v ∈ (intBox (Module.finrank ℚ K) ⌊M⌋₊).filter _ := hv
      have hw' : w ∈ (intBox (Module.finrank ℚ K) ⌊M⌋₊).filter _ := hw
      rw [Finset.mem_filter] at hv' hw'
      exact s5 _ Ω p.1 p.2 hσ v w hvw hv'.2.1 hw'.2.1 hv'.2.2 hw'.2.2
  have hIcard : I.card = Module.finrank ℚ K * 2 := by
    rw [hI, Finset.card_product, Finset.card_univ, Fintype.card_fin,
      Finset.card_pair (by norm_num)]
  have hScard : S.card ≤ Module.finrank ℚ K * 2 * (2 * ⌊M⌋₊ + 1) ^ (Module.finrank ℚ K - 1) := by
    calc S.card ≤ (I.biUnion E).card := Finset.card_le_card hSsub
      _ ≤ ∑ p ∈ I, (E p).card := Finset.card_biUnion_le
      _ ≤ I.card • (2 * ⌊M⌋₊ + 1) ^ (Module.finrank ℚ K - 1) :=
          Finset.sum_le_card_nsmul I (fun p => (E p).card) _ hEcard
      _ = Module.finrank ℚ K * 2 * (2 * ⌊M⌋₊ + 1) ^ (Module.finrank ℚ K - 1) := by
          rw [hIcard, smul_eq_mul]
  have hmain := (hFS _ (Finset.filter_subset _ _)
    (fun x hx => (Finset.mem_filter.mp hx).2)).trans hScard
  have hcast := (Nat.cast_le (α := ℝ)).mpr hmain
  refine le_trans (b := ((Module.finrank ℚ K * 2 * (2 * ⌊M⌋₊ + 1) ^ (Module.finrank ℚ K - 1) :
    ℕ) : ℝ)) ?_ ?_
  · convert hcast
  push_cast
  have hpow : (2 * ((⌊M⌋₊ : ℕ) : ℝ) + 1) ^ (Module.finrank ℚ K - 1)
      ≤ 2 ^ (Module.finrank ℚ K - 1) * (M + 1) ^ (Module.finrank ℚ K - 1) := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity) (by linarith) _
  calc (Module.finrank ℚ K : ℝ) * 2 * (2 * ((⌊M⌋₊ : ℕ) : ℝ) + 1) ^ (Module.finrank ℚ K - 1)
      ≤ (Module.finrank ℚ K : ℝ) * 2 *
          (2 ^ (Module.finrank ℚ K - 1) * (M + 1) ^ (Module.finrank ℚ K - 1)) :=
        mul_le_mul_of_nonneg_left hpow (by positivity)
    _ = 2 * (Module.finrank ℚ K : ℝ) * 2 ^ (Module.finrank ℚ K - 1) *
          (M + 1) ^ (Module.finrank ℚ K - 1) := by ring

theorem kai_primePsi_box_sum (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (M : ℝ) (hM : 1 ≤ M) (q : Ideal (NumberField.RingOfIntegers K))
    (α : NumberField.RingOfIntegers K) (S : Set (Fin (Module.finrank ℚ K) → ℝ))
    (hS : S ⊆ realBox (Module.finrank ℚ K) ((⌊M⌋₊ : ℝ) + 1 / 2)) :
    kaiPrimePsi K q α (kaiOmegaEmb ω '' S)
      = ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K) (fun x =>
            (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ S ∧ x - α ∈ q ∧ Prime x)
            (fun _ => Classical.propDecidable _) (omegaBox ω M),
          Real.log ((Algebra.norm ℤ x).natAbs : ℝ) :=
by
  classical
  
  have hA : ∀ x : NumberField.RingOfIntegers K,
      kaiOmegaEmb ω (fun j => ((ω.equivFun x j : ℤ) : ℝ))
        = NumberField.mixedEmbedding K (x : K) := by
    intro x
    unfold kaiOmegaEmb
    have hx : (x : K) = ∑ j, (ω.repr x j) • ((ω j : NumberField.RingOfIntegers K) : K) := by
      conv_lhs => rw [← ω.sum_repr x]
      simp only [NumberField.RingOfIntegers.coe_eq_algebraMap, map_sum, map_zsmul]
    rw [hx, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_zsmul, Module.Basis.equivFun_apply, Int.cast_smul_eq_zsmul]
  
  have hspan : ∀ v : Fin (Module.finrank ℚ K) → ℝ, kaiOmegaEmb ω v ∈
      Submodule.span ℝ (Set.range (fun j =>
        NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K))) := by
    intro v
    unfold kaiOmegaEmb
    exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
  have hli : LinearIndependent ℝ (fun j =>
      NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K)) := by
    apply linearIndependent_of_top_le_span_of_card_eq_finrank
    · rw [← (NumberField.mixedEmbedding.latticeBasis K).span_eq]
      apply Submodule.span_le.2
      rintro _ ⟨i, rfl⟩
      rw [NumberField.mixedEmbedding.latticeBasis_apply, NumberField.integralBasis_apply,
        ← NumberField.RingOfIntegers.coe_eq_algebraMap, ← hA]
      exact hspan _
    · rw [Fintype.card_fin, NumberField.mixedEmbedding.finrank]
  have hinj : ∀ v w : Fin (Module.finrank ℚ K) → ℝ, kaiOmegaEmb ω v = kaiOmegaEmb ω w → v = w := by
    intro v w hvw
    have h0 : ∑ j, (v j - w j) •
        NumberField.mixedEmbedding K ((ω j : NumberField.RingOfIntegers K) : K) = 0 := by
      simp only [sub_smul, Finset.sum_sub_distrib]
      unfold kaiOmegaEmb at hvw
      rw [hvw, sub_self]
    funext j
    have := Fintype.linearIndependent_iff.1 hli _ h0 j
    linarith
  
  have hC : ∀ x : NumberField.RingOfIntegers K,
      NumberField.mixedEmbedding K (x : K) ∈ kaiOmegaEmb ω '' S ↔
        (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ S := by
    intro x
    constructor
    · rintro ⟨v, hv, hveq⟩
      have : v = (fun j => ((ω.equivFun x j : ℤ) : ℝ)) := hinj v _ (hveq.trans (hA x).symm)
      rw [← this]; exact hv
    · intro hx
      exact ⟨_, hx, hA x⟩
  
  have hD : ∀ x : NumberField.RingOfIntegers K,
      (fun j => ((ω.equivFun x j : ℤ) : ℝ))
        ∈ realBox (Module.finrank ℚ K) ((⌊M⌋₊ : ℝ) + 1 / 2) → x ∈ omegaBox ω M := by
    intro x hx
    unfold omegaBox
    rw [Finset.mem_image]
    refine ⟨ω.equivFun x, ?_, ω.equivFun.symm_apply_apply x⟩
    unfold intBox
    rw [Finset.mem_Icc]
    simp only [realBox, Set.mem_setOf_eq] at hx
    have hj : ∀ j, |ω.equivFun x j| ≤ (⌊M⌋₊ : ℤ) := by
      intro j
      have h1 := hx j
      have h2 : ((|ω.equivFun x j| : ℤ) : ℝ) < (((⌊M⌋₊ : ℤ) + 1 : ℤ) : ℝ) := by
        push_cast
        linarith
      have h3 : |ω.equivFun x j| < (⌊M⌋₊ : ℤ) + 1 := by exact_mod_cast h2
      omega
    exact ⟨fun j => (abs_le.1 (hj j)).1, fun j => (abs_le.1 (hj j)).2⟩
  
  have hset : {π : NumberField.RingOfIntegers K | Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈ kaiOmegaEmb ω '' S ∧ π - α ∈ q}
      = ↑(@Finset.filter (NumberField.RingOfIntegers K) (fun x =>
            (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ S ∧ x - α ∈ q ∧ Prime x)
            (fun _ => Classical.propDecidable _) (omegaBox ω M)) := by
    ext π
    rw [Set.mem_setOf_eq, Finset.mem_coe,
      @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _), hC π]
    constructor
    · rintro ⟨hp, hc, hq⟩
      exact ⟨hD π (hS hc), hc, hq, hp⟩
    · rintro ⟨-, hc, hq, hp⟩
      exact ⟨hp, hc, hq⟩
  unfold kaiPrimePsi
  rw [← Finset.tsum_subtype']
  exact tsum_congr_set_coe
    (fun π : NumberField.RingOfIntegers K => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)) hset

theorem kai_coset_convex_count (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ (M : ℝ) (𝔟 : Ideal (NumberField.RingOfIntegers K)), 𝔟 ≠ ⊥ →
      ∀ (b : NumberField.RingOfIntegers K) (c : Fin (Module.finrank ℚ K) → ℤ) (R : ℕ),
        (Ideal.absNorm 𝔟 : ℝ) ≤ (R : ℝ) →
      ∀ (T : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet T → Convex ℝ T →
        T ⊆ realBox (Module.finrank ℚ K) ((⌊M⌋₊ : ℝ) + 1 / 2) →
        (∀ v ∈ T, ∀ j, |v j - (c j : ℝ)| ≤ (R : ℝ)) →
        |((@Finset.filter (NumberField.RingOfIntegers K)
              (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ T ∧ x - b ∈ 𝔟)
              (fun _ => Classical.propDecidable _) (omegaBox ω M)).card : ℝ)
          - (MeasureTheory.volume T).toReal / (Ideal.absNorm 𝔟 : ℝ)|
          ≤ C * (R : ℝ) ^ (Module.finrank ℚ K - 1) :=
by
  classical
  
  have s4 : ∀ (n : ℕ) (q : ℝ) (hq : 0 < q) (a : Fin n → ℝ) (T : Set (Fin n → ℝ)),
      (MeasureTheory.volume {y : Fin n → ℝ | (fun j => a j + q * y j) ∈ T}).toReal
        = (MeasureTheory.volume T).toReal / q ^ n := by
    intro n q hq a T
    have hset : {y : Fin n → ℝ | (fun j => a j + q * y j) ∈ T}
        = (fun y : Fin n → ℝ => q • y) ⁻¹' ((fun v => a + v) ⁻¹' T) := by
      ext y; exact Iff.rfl
    rw [hset, MeasureTheory.Measure.addHaar_preimage_smul MeasureTheory.volume hq.ne',
      MeasureTheory.measure_preimage_add, Module.finrank_fin_fun, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (abs_nonneg _), abs_of_pos (inv_pos.mpr (pow_pos hq n)),
      div_eq_inv_mul]
  
  have s5 : ∀ (n m q R : ℕ) (hq : 1 ≤ q) (r a c : Fin n → ℤ)
      (har : ∀ j, (q : ℤ) ∣ a j - r j) (hac : ∀ j, c j - (q : ℤ) < a j ∧ a j ≤ c j)
      (T : Set (Fin n → ℝ)) (hT : T ⊆ realBox n ((m : ℝ) + 1 / 2))
      (hR : ∀ v ∈ T, ∀ j, |v j - (c j : ℝ)| ≤ (R : ℝ)),
      {y : Fin n → ℝ | (fun j => (a j : ℝ) + (q : ℝ) * y j) ∈ T}
          ⊆ realBox n ((R / q + 2 : ℕ) : ℝ) ∧
      (@Finset.filter (Fin n → ℤ)
          (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ T ∧ ∀ j, (q : ℤ) ∣ z j - r j)
          (fun _ => Classical.propDecidable _) (intBox n m)).card
        = kaiLatticeCount n (R / q + 2)
            {y : Fin n → ℝ | (fun j => (a j : ℝ) + (q : ℝ) * y j) ∈ T} := by
    intro n m q R hq r a c har hac T hT hR
    have hqpos : (0:ℝ) < q := by exact_mod_cast hq
    have hqZ : (0:ℤ) < q := by exact_mod_cast hq
    have hB : ∀ (t : ℤ) (k : ℕ), |(t:ℝ)| < (k:ℝ) + 1 → -(k:ℤ) ≤ t ∧ t ≤ k := by
      intro t k h
      rw [abs_lt] at h
      obtain ⟨h1, h2⟩ := h
      have h1' : (-(k:ℤ) - 1) < t := by
        have : ((-(k:ℤ) - 1 : ℤ) : ℝ) < (t : ℝ) := by push_cast; linarith
        exact_mod_cast this
      have h2' : t < (k:ℤ) + 1 := by
        have : (t : ℝ) < (((k:ℤ) + 1 : ℤ) : ℝ) := by push_cast; linarith
        exact_mod_cast this
      omega
    have hdivR : (R:ℝ) < (q:ℝ) * (((R / q : ℕ) : ℝ) + 1) := by
      have := Nat.lt_mul_div_succ R hq
      exact_mod_cast this
    have hsub : {y : Fin n → ℝ | (fun j => (a j : ℝ) + (q : ℝ) * y j) ∈ T}
          ⊆ realBox n ((R / q + 2 : ℕ) : ℝ) := by
      intro y hy j
      have h1 := hR _ hy j
      simp only at h1
      rw [abs_le] at h1
      have h2 := hac j
      have h3 : (c j : ℝ) - q < a j := by exact_mod_cast h2.1
      have h4 : (a j : ℝ) ≤ c j := by exact_mod_cast h2.2
      push_cast
      rw [abs_le]
      constructor
      · have : (q:ℝ) * (-(((R / q : ℕ) : ℝ) + 2)) ≤ q * y j := by nlinarith
        exact le_of_mul_le_mul_left this hqpos
      · have : (q:ℝ) * y j ≤ q * (((R / q : ℕ) : ℝ) + 2) := by nlinarith
        exact le_of_mul_le_mul_left this hqpos
    refine ⟨hsub, ?_⟩
    unfold kaiLatticeCount
    have hdz : ∀ z : Fin n → ℤ, (∀ j, (q : ℤ) ∣ z j - r j) →
        ∀ k, a k + (q:ℤ) * ((z k - a k) / (q:ℤ)) = z k := by
      intro z hz k
      have : (q:ℤ) ∣ z k - a k := by
        have := dvd_sub (hz k) (har k)
        convert this using 1; ring
      rw [Int.mul_ediv_cancel' this]; ring
    apply Finset.card_nbij' (fun z => fun k => (z k - a k) / (q:ℤ))
      (fun y => fun j => a j + (q:ℤ) * y j)
    · intro z hz
      simp only [Finset.coe_filter, Set.mem_setOf_eq] at hz ⊢
      obtain ⟨_, hzT, hzd⟩ := hz
      have hmemT : (fun j => ((((z j - a j) / (q:ℤ) : ℤ)) : ℝ)) ∈
          {y : Fin n → ℝ | (fun j => (a j : ℝ) + (q : ℝ) * y j) ∈ T} := by
        show (fun j => (a j : ℝ) + (q : ℝ) * (((z j - a j) / (q:ℤ) : ℤ) : ℝ)) ∈ T
        have : (fun j => (a j : ℝ) + (q : ℝ) * (((z j - a j) / (q:ℤ) : ℤ) : ℝ))
            = fun j => ((z j : ℤ) : ℝ) := by
          funext j
          have := hdz z hzd j
          exact_mod_cast this
