    have hB : ∀ (c : Quotient sr) (w : (NumberField.RingOfIntegers K)ˣ),
        KaiMFCongUnit K q w →
        ∃! p : {ν // ν ∈ G} ×
               {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
          ((w : NumberField.RingOfIntegers K) * (Quotient.out c).1)
            = ((p.2 : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) * (p.1 : NumberField.RingOfIntegers K) := by
      intro c w hw
      refine ⟨(⟨(Quotient.out c).1, (hmemG _).mpr ⟨c, rfl⟩⟩, ⟨w, hw⟩), rfl, ?_⟩
      rintro ⟨⟨g', hg'⟩, ⟨w', hw'⟩⟩ heq
      obtain ⟨c', rfl⟩ := (hmemG g').mp hg'
      have hrel : Quotient.out c ≈ Quotient.out c' := by
        refine ⟨w'⁻¹ * w, hmul _ _ (hinv w' hw') hw, ?_⟩
        calc ((Quotient.out c').1 : NumberField.RingOfIntegers K)
            = ((w'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
                (((w' : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
                  ((Quotient.out c').1 : NumberField.RingOfIntegers K)) := by
              rw [← mul_assoc, Units.inv_mul, one_mul]
          _ = ((w'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
                (((w : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
                  ((Quotient.out c).1 : NumberField.RingOfIntegers K)) := by
              rw [← heq]
          _ = (((w'⁻¹ * w : (NumberField.RingOfIntegers K)ˣ)) : NumberField.RingOfIntegers K) *
                ((Quotient.out c).1 : NumberField.RingOfIntegers K) := by
              rw [Units.val_mul, mul_assoc]
