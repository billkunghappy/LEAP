        have hmain := (harc.ofReal_comp).fun_sub ((hlog.ofReal_comp).const_mul (Complex.I / 2))
        rw [hval v] at hmain
        exact hmain
      have hint : IntervalIntegrable (fun v : ℝ => ((d : ℂ) + (v : ℂ) * Complex.I)⁻¹)
          MeasureTheory.volume (-s) s :=
        (Continuous.inv₀ (by fun_prop) hcne).intervalIntegrable (-s) s
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hF x) hint]
      simp only [neg_div, Real.arctan_neg, neg_sq]
      push_cast
      ring
    have hA2 : ∀ p q r t : ℝ, t ≠ 0 →
        ((∫ u : ℝ in p..q, ((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹)
            - ∫ u : ℝ in p..q, ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹)
          = 2 * Complex.I *
              ((Real.arctan ((q - r) / t) - Real.arctan ((p - r) / t) : ℝ) : ℂ) := by
      intro p q r t ht
      have hpos : ∀ u : ℝ, (0 : ℝ) < (u - r) ^ 2 + t ^ 2 := by
        intro u
        have h : (0 : ℝ) < t ^ 2 := by positivity
        nlinarith [sq_nonneg (u - r)]
      have hne : ∀ u : ℝ, ((u - r) ^ 2 + t ^ 2 : ℝ) ≠ 0 := fun u => ne_of_gt (hpos u)
      have him1 : ∀ u : ℝ, ((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ)).im = -t :=
        fun u => by simp
      have him2 : ∀ u : ℝ, ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ)).im = t :=
        fun u => by simp
      have hz1 : ∀ u : ℝ, ((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ)) ≠ 0 := by
        intro u hu
        apply ht
        have h : (-t : ℝ) = 0 := by rw [← him1 u, hu]; simp
        linarith
      have hz2 : ∀ u : ℝ, ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ)) ≠ 0 := by
        intro u hu
        apply ht
        rw [← him2 u, hu]
        simp
      have hval : ∀ u : ℝ,
          2 * Complex.I * (((t / ((u - r) ^ 2 + t ^ 2) : ℝ)) : ℂ)
            = ((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹
                - ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹ := by
        intro u
        rw [inv_sub_inv (hz1 u) (hz2 u)]
        have hnum : ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ))
            - ((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ)) = 2 * Complex.I * (t : ℂ) := by
          push_cast; ring
        have hden : ((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ))
            * ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ))
            = ((((u - r) ^ 2 + t ^ 2 : ℝ)) : ℂ) := by
          push_cast
          linear_combination (-(t : ℂ) ^ 2) * Complex.I_sq
        rw [hnum, hden, Complex.ofReal_div, mul_div_assoc]
      have hint1 : IntervalIntegrable
          (fun u : ℝ => ((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹)
          MeasureTheory.volume p q :=
        (Continuous.inv₀ (by fun_prop) hz1).intervalIntegrable p q
      have hint2 : IntervalIntegrable
          (fun u : ℝ => ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹)
          MeasureTheory.volume p q :=
        (Continuous.inv₀ (by fun_prop) hz2).intervalIntegrable p q
      have hH : ∀ u : ℝ, HasDerivAt
          (fun w : ℝ => 2 * Complex.I * (((Real.arctan ((w - r) / t) : ℝ)) : ℂ))
          (((u : ℂ) + ((-t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹
            - ((u : ℂ) + ((t : ℝ) : ℂ) * Complex.I - (r : ℂ))⁻¹) u := by
        intro u
        have hq : HasDerivAt (fun w : ℝ => (w - r) / t) (1 / t) u := by
          simpa using ((hasDerivAt_id u).sub_const r).div_const t
        have harc : HasDerivAt (fun w : ℝ => Real.arctan ((w - r) / t))
            (t / ((u - r) ^ 2 + t ^ 2)) u := by
          have h := hq.arctan
          convert h using 1
          have hden : (1 : ℝ) + ((u - r) / t) ^ 2 ≠ 0 := by positivity
          field_simp
          ring
        have hmain := (harc.ofReal_comp).const_mul (2 * Complex.I)
        rw [hval u] at hmain
        exact hmain
      rw [← intervalIntegral.integral_sub hint1 hint2,
          intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hH x) (hint1.sub hint2)]
      push_cast
      ring
    have hab : a ≤ b := le_of_lt (lt_trans hac hcb)
    have hTT : (-T : ℝ) ≤ T := by linarith
    have hT0 : (T : ℝ) ≠ 0 := ne_of_gt hT
    have hbc : (0 : ℝ) < b - c := by linarith
    have hca : (0 : ℝ) < c - a := by linarith
    have hbc0 : (b - c : ℝ) ≠ 0 := ne_of_gt hbc
    have hac0 : (a - c : ℝ) ≠ 0 := sub_ne_zero.mpr (ne_of_lt hac)
    have huIcc1 : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
    have huIcc2 : Set.uIcc (-T) T = Set.Icc (-T) T := Set.uIcc_of_le hTT
    have hfR : DifferentiableOn ℂ f (Set.uIcc a b ×ℂ Set.uIcc (-T) T) := by
