          (NumberField.mixedEmbedding K (γ : K)).1 w := by
    intro 𝔪 h𝔪 a γ hγ
    let φ : {w : NumberField.InfinitePlace K // w.IsReal} → K →+* ℝ := fun w =>
      (Pi.evalRingHom (fun _ => ℝ) w).comp
        ((RingHom.fst _ _).comp (NumberField.mixedEmbedding K))
    have hφ : ∀ w (x : K), φ w x = (NumberField.mixedEmbedding K x).1 w := fun _ _ => rfl
    have hγK : (γ : K) ≠ 0 := by
      intro h
      apply hγ
      exact_mod_cast h
    have hγw : ∀ w, (NumberField.mixedEmbedding K (γ : K)).1 w ≠ 0 := by
      intro w
      rw [← hφ]
      exact (map_ne_zero (φ w)).mpr hγK
    have hN0 : Ideal.absNorm 𝔪 ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff, ← Ideal.zero_eq_bot]
      exact h𝔪
    have hNpos : (0 : ℝ) < (Ideal.absNorm 𝔪 : ℝ) := by
      exact_mod_cast Nat.pos_of_ne_zero hN0
    set g : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ :=
      fun w => (NumberField.mixedEmbedding K (γ : K)).1 w with hg
    set b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ :=
      fun w => (NumberField.mixedEmbedding K (a : K)).1 w with hb
    obtain ⟨k, hk⟩ := exists_nat_gt
      (∑ w, |b w * g w| / ((Ideal.absNorm 𝔪 : ℝ) * (g w * g w)))
    refine ⟨((k * Ideal.absNorm 𝔪 : ℕ) : NumberField.RingOfIntegers K) * γ, ?_, ?_⟩
    · apply Ideal.mul_mem_right
      push_cast
      exact Ideal.mul_mem_left _ _ (Ideal.absNorm_mem 𝔪)
    · intro w
      have hgw : 0 < g w * g w := mul_self_pos.mpr (hγw w)
      have hden : 0 < (Ideal.absNorm 𝔪 : ℝ) * (g w * g w) := mul_pos hNpos hgw
      have hval : (NumberField.mixedEmbedding K
          ((a + ((k * Ideal.absNorm 𝔪 : ℕ) : NumberField.RingOfIntegers K) * γ :
