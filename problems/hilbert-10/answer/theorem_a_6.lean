  have hB : (∑ P ∈ hfin.toFinset,
        ((Module.finrank ℚ K : ℝ) * Real.log ((rchar P : ℕ) : ℝ)))
      = ∑ y ∈ Finset.image (fun P : Ideal (NumberField.RingOfIntegers K) =>
            (col P, rchar P)) hfin.toFinset,
          ((Module.finrank ℚ K : ℝ) * Real.log ((y.2 : ℕ) : ℝ)) := by
    simp only [Finset.sum_image hinj]
  have hsub : Finset.image (fun P : Ideal (NumberField.RingOfIntegers K) =>
        (col P, rchar P)) hfin.toFinset
      ⊆ (Finset.univ : Finset (Fin (Module.finrank ℚ K))) ×ˢ
          ((Finset.range (⌊x⌋₊ + 1)).filter Nat.Prime) := by
    intro y hy
    obtain ⟨P, hPmem, rfl⟩ := Finset.mem_image.mp hy
    obtain ⟨hP1, hP2, hP3⟩ := hfin.mem_toFinset.mp hPmem
    obtain ⟨hp, hf1, hNP⟩ := hcol1 P hP1 hP2
    have hle : rchar P ≤ Ideal.absNorm P := by
