    have hLk : 16 * k ^ 4 ≤ Real.log X := by
      have := Real.log_le_log (Real.exp_pos _) hXk; rwa [Real.log_exp] at this
    have hL0 : 0 ≤ Real.log X := by linarith
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.sqrt (Real.log X) := ⟨_, rfl⟩
    have hs0 : 0 ≤ s := by rw [hs]; exact Real.sqrt_nonneg _
    have hss : s ^ 2 = Real.log X := by rw [hs]; exact Real.sq_sqrt hL0
    have hs2 : 2 ≤ s := by nlinarith
    rw [← hs]
    have hXn : X ≤ X ^ n := le_self_pow₀ hX1 (by omega)
    have hXn0 : 0 < X ^ n := pow_pos hXpos n
    refine ⟨?_, ?_⟩
    · have h1 : Real.exp (Real.log X + -2 * s) ≤ X ^ n * Real.exp (-2 * s) := by
        rw [Real.exp_add, Real.exp_log hXpos]
        exact mul_le_mul_of_nonneg_right hXn (Real.exp_pos _).le
      have h2 : 1 ≤ Real.exp (Real.log X + -2 * s) := Real.one_le_exp (by nlinarith)
      linarith
    · intro N hN1 hNu
      obtain ⟨u, hu⟩ : ∃ u : ℝ, u = Real.log X ^ ((1:ℝ)/4) := ⟨_, rfl⟩
      rw [← hu] at hNu
      have hu0 : 0 ≤ u := by rw [hu]; exact Real.rpow_nonneg hL0 _
      have hu4 : u ^ 4 = Real.log X := by
        rw [hu, ← Real.rpow_natCast, ← Real.rpow_mul hL0]; norm_num
      have hu2 : u ^ 2 = s := by
        rw [hs, ← hu4]
        have : u ^ 4 = (u ^ 2) ^ 2 := by ring
        rw [this, Real.sqrt_sq (by positivity)]
      have h2k : 2 * k ≤ u := by
        by_contra hcon
        push_neg at hcon
        have h1 : u ^ 4 < (2 * k) ^ 4 := pow_lt_pow_left₀ hcon hu0 (by norm_num)
        nlinarith
      have hku : k * u ≤ s / 2 := by nlinarith [mul_le_mul_of_nonneg_right h2k hu0]
      have hNk : N ^ (r + r * r) ≤ Real.exp (s / 2) := by
        calc N ^ (r + r * r) ≤ (Real.exp u) ^ (r + r * r) :=
              pow_le_pow_left₀ (by linarith) hNu _
          _ = Real.exp (k * u) := by rw [hk, ← Real.exp_nat_mul]
          _ ≤ Real.exp (s / 2) := Real.exp_le_exp.mpr hku
      have hexp : Real.exp (s / 2) * Real.exp (-s) = Real.exp (-s / 2) := by
        rw [← Real.exp_add]; ring_nf
      have hexp2 : Real.exp (-s / 2) ≤ Real.exp (-s / max C 2) := by
        apply Real.exp_le_exp.mpr
        rw [neg_div, neg_div, neg_le_neg_iff]
        exact div_le_div_of_nonneg_left hs0 (by norm_num) hc2
      calc C * N ^ (r + r * r) * (X ^ n * Real.exp (-s))
          ≤ C * Real.exp (s / 2) * (X ^ n * Real.exp (-s)) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hNk hC)
              (mul_nonneg hXn0.le (Real.exp_pos _).le)
        _ = C * X ^ n * Real.exp (-s / 2) := by rw [← hexp]; ring
        _ ≤ max C 2 * X ^ n * Real.exp (-s / max C 2) :=
            mul_le_mul (mul_le_mul_of_nonneg_right (le_max_left _ _) hXn0.le) hexp2
              (Real.exp_pos _).le (mul_nonneg hcpos.le hXn0.le)
  
  have kai_tb_shape_env_facts : ∀
      (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
      (X : ℝ), 0 ≤ X →
      ∀ (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
      (ρ σ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
      (∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ (0 ≤ a w ∨ b w ≤ 0)) →
      (∀ p, 0 ≤ ρ p ∧ ρ p < σ p ∧ σ p ≤ X) →
      Measurable (kaiTBEplus K H a b ρ σ) ∧
        Measurable (kaiTBEminus K H a b ρ σ) ∧
        (∀ W, 0 ≤ kaiTBEplus K H a b ρ σ W) ∧
        (∀ W, 0 ≤ kaiTBEminus K H a b ρ σ W) ∧
        (∀ W : Fin (NumberField.Units.rank K) → ℝ,
          kaiTBEplus K H a b ρ σ W
            ≤ X ^ (Module.finrank ℚ K) *
                Real.exp (-(Module.finrank ℚ K : ℝ) *
                  (⨆ w : NumberField.InfinitePlace K, kaiTBShapeLog K H W w))) := by
    intro H X _hX a b ρ σ hab hρσ
    have hbounds : ∀ w : NumberField.InfinitePlace K,
        0 ≤ kaiTBCellLo K a b ρ σ w ∧
          kaiTBCellLo K a b ρ σ w < kaiTBCellHi K a b ρ σ w ∧
          kaiTBCellHi K a b ρ σ w ≤ X := by
      intro w
      simp only [kaiTBCellLo, kaiTBCellHi]
      split_ifs with h ha
      · obtain ⟨h1, h2, h3, h4⟩ := hab ⟨w, h⟩
        exact ⟨ha, h2, h3⟩
      · obtain ⟨h1, h2, h3, h4⟩ := hab ⟨w, h⟩
        rcases h4 with h4 | h4
        · exact absurd h4 ha
        · refine ⟨by linarith, by linarith, by linarith⟩
      · exact hρσ ⟨w, NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h⟩
    have hLo0 : ∀ w : NumberField.InfinitePlace K, 0 ≤ kaiTBCellLo K a b ρ σ w :=
      fun w => (hbounds w).1
    have hHi0 : ∀ w : NumberField.InfinitePlace K, 0 ≤ kaiTBCellHi K a b ρ σ w :=
      fun w => le_of_lt (lt_of_le_of_lt (hbounds w).1 (hbounds w).2.1)
    have hHiX : ∀ w : NumberField.InfinitePlace K, kaiTBCellHi K a b ρ σ w ≤ X :=
      fun w => (hbounds w).2.2
    have hlin : ∀ w : NumberField.InfinitePlace K,
        Measurable (fun W : Fin (NumberField.Units.rank K) → ℝ =>
          kaiTBShapeLog K H W w) := by
      intro w
      simp only [kaiTBShapeLog]
      refine Finset.measurable_sum Finset.univ ?_
      intro j _
      exact (measurable_pi_apply j :
        Measurable (fun W : Fin (NumberField.Units.rank K) → ℝ => W j)).mul_const _
    have hFp : ∀ w : NumberField.InfinitePlace K,
        Measurable (fun W : Fin (NumberField.Units.rank K) → ℝ =>
          kaiTBCellHi K a b ρ σ w ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w)) :=
      fun w => measurable_const.mul
        (Real.measurable_exp.comp ((hlin w).const_mul (-(Module.finrank ℚ K : ℝ))))
    have hFm : ∀ w : NumberField.InfinitePlace K,
        Measurable (fun W : Fin (NumberField.Units.rank K) → ℝ =>
          kaiTBCellLo K a b ρ σ w ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w)) :=
      fun w => measurable_const.mul
        (Real.measurable_exp.comp ((hlin w).const_mul (-(Module.finrank ℚ K : ℝ))))
    have hEqP : kaiTBEplus K H a b ρ σ = fun W : Fin (NumberField.Units.rank K) → ℝ =>
        ⨅ w : NumberField.InfinitePlace K,
          kaiTBCellHi K a b ρ σ w ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w) := rfl
    have hEqM : kaiTBEminus K H a b ρ σ = fun W : Fin (NumberField.Units.rank K) → ℝ =>
        ⨆ w : NumberField.InfinitePlace K,
          kaiTBCellLo K a b ρ σ w ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w) := rfl
    have hMp : Measurable (kaiTBEplus K H a b ρ σ) := by
      rw [hEqP]
      exact Measurable.iInf hFp
    have hMm : Measurable (kaiTBEminus K H a b ρ σ) := by
      rw [hEqM]
      exact Measurable.iSup hFm
    have hEp0 : ∀ W : Fin (NumberField.Units.rank K) → ℝ,
        0 ≤ kaiTBEplus K H a b ρ σ W := by
      intro W
      simp only [kaiTBEplus]
      exact le_ciInf (fun w => mul_nonneg (pow_nonneg (hHi0 w) _) (Real.exp_pos _).le)
    have hEm0 : ∀ W : Fin (NumberField.Units.rank K) → ℝ,
        0 ≤ kaiTBEminus K H a b ρ σ W := by
      intro W
      simp only [kaiTBEminus]
      obtain ⟨w₀⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
      have h0 : (0:ℝ) ≤ kaiTBCellLo K a b ρ σ w₀ ^ (Module.finrank ℚ K) *
          Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w₀) :=
        mul_nonneg (pow_nonneg (hLo0 w₀) _) (Real.exp_pos _).le
      refine le_trans h0 ?_
      exact le_ciSup (f := fun w : NumberField.InfinitePlace K =>
          kaiTBCellLo K a b ρ σ w ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w))
        (Finite.bddAbove_range _) w₀
    have hEnv : ∀ W : Fin (NumberField.Units.rank K) → ℝ,
        kaiTBEplus K H a b ρ σ W
          ≤ X ^ (Module.finrank ℚ K) *
              Real.exp (-(Module.finrank ℚ K : ℝ) *
                (⨆ w : NumberField.InfinitePlace K, kaiTBShapeLog K H W w)) := by
      intro W
      obtain ⟨w₀, hw₀⟩ : ∃ w : NumberField.InfinitePlace K,
          kaiTBShapeLog K H W w
            = ⨆ v : NumberField.InfinitePlace K, kaiTBShapeLog K H W v :=
        exists_eq_ciSup_of_finite
      have h1 : kaiTBEplus K H a b ρ σ W
          ≤ kaiTBCellHi K a b ρ σ w₀ ^ (Module.finrank ℚ K) *
              Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w₀) := by
        simp only [kaiTBEplus]
        exact ciInf_le (Finite.bddBelow_range _) w₀
      have h2 : kaiTBCellHi K a b ρ σ w₀ ^ (Module.finrank ℚ K) *
            Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w₀)
          ≤ X ^ (Module.finrank ℚ K) *
              Real.exp (-(Module.finrank ℚ K : ℝ) * kaiTBShapeLog K H W w₀) :=
        mul_le_mul_of_nonneg_right
          (pow_le_pow_left₀ (hHi0 w₀) (hHiX w₀) _) (Real.exp_pos _).le
      rw [← hw₀]
      exact le_trans h1 h2
    exact ⟨hMp, hMm, hEp0, hEm0, hEnv⟩
  
  have kai_tb_shape_coord_bound : ∀ (B : ℝ) (q : Ideal (NumberField.RingOfIntegers K))
      (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
      (wq : ℕ) (Rq : ℝ)
      (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ),
      KaiTBUnitData K B q H wq Rq e →
      ∀ W : Fin (NumberField.Units.rank K) → ℝ,
        0 ≤ (⨆ w : NumberField.InfinitePlace K, kaiTBShapeLog K H W w) ∧
        ∀ j, |W j| ≤ B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K
                    * (Module.finrank ℚ K : ℝ) ^ 2
                    * (⨆ w : NumberField.InfinitePlace K, kaiTBShapeLog K H W w) := by
    intro B q H wq Rq e hdata
    obtain ⟨-, -, -, h4, -, h6, -, h8, -, -⟩ := hdata
    have hUL : ∀ (j : Fin (NumberField.Units.rank K)) (w : NumberField.InfinitePlace K),
        kaiTBUnitLog K (H j) w
          = (w.mult : ℝ) * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) :=
      fun _ _ => rfl
    have hSL : ∀ (W : Fin (NumberField.Units.rank K) → ℝ) (w : NumberField.InfinitePlace K),
        kaiTBShapeLog K H W w
          = ∑ j, W j * Real.log (w (((H j : NumberField.RingOfIntegers K)) : K)) :=
      fun _ _ => rfl
    have hsum : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)
        = (Module.finrank ℚ K : ℝ) := by
      rw [← Nat.cast_sum, NumberField.InfinitePlace.sum_mult_eq]
    have coreA : ∀ (L : NumberField.InfinitePlace K → ℝ) (M : ℝ),
        (∀ w : NumberField.InfinitePlace K, L w ≤ M) →
        (0 ≤ ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * L w) →
        ∀ w₀ : NumberField.InfinitePlace K,
          |L w₀| ≤ (Module.finrank ℚ K : ℝ) * M := by
      intro L M hLM htr w₀
      have hL0 := hLM w₀
      have hP1 : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * L w
          ≤ (Module.finrank ℚ K : ℝ) * M := by
        calc ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * L w
            ≤ ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * M :=
              Finset.sum_le_sum (fun w _ =>
                mul_le_mul_of_nonneg_left (hLM w) (Nat.cast_nonneg _))
          _ = (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)) * M :=
              (Finset.sum_mul _ _ _).symm
          _ = (Module.finrank ℚ K : ℝ) * M := by rw [hsum]
      have hnM : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) * M := le_trans htr hP1
      have hm1 : (1 : ℝ) ≤ (w₀.mult : ℝ) := by
        have hmp : 0 < w₀.mult := NumberField.InfinitePlace.mult_pos
        exact_mod_cast hmp
      have hni : (w₀.mult : ℝ) ≤ (Module.finrank ℚ K : ℝ) := by
        rw [← hsum]
        exact Finset.single_le_sum
          (f := fun w : NumberField.InfinitePlace K => ((w.mult : ℕ) : ℝ))
          (fun w _ => Nat.cast_nonneg _) (Finset.mem_univ w₀)
      have hn1 : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := le_trans hm1 hni
      have hnpos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by linarith
      have hM0 : (0 : ℝ) ≤ M := by
        by_contra hcon
        push_neg at hcon
        exact absurd hnM (not_le.mpr (mul_neg_of_pos_of_neg hnpos hcon))
      have hMnM : M ≤ (Module.finrank ℚ K : ℝ) * M := le_mul_of_one_le_left hM0 hn1
      have hFsum : ∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * (M - L w))
          = (Module.finrank ℚ K : ℝ) * M
              - ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * L w := by
        have hterm : ∀ w : NumberField.InfinitePlace K,
            ((w.mult : ℝ) * (M - L w)) = (w.mult : ℝ) * M - (w.mult : ℝ) * L w :=
          fun w => by ring
        rw [Finset.sum_congr rfl (fun w _ => hterm w), Finset.sum_sub_distrib,
          ← Finset.sum_mul, hsum]
      have hFi : (w₀.mult : ℝ) * (M - L w₀)
          ≤ ∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * (M - L w)) :=
        Finset.single_le_sum
          (f := fun w : NumberField.InfinitePlace K => ((w.mult : ℕ) : ℝ) * (M - L w))
          (fun w _ => mul_nonneg (Nat.cast_nonneg _) (by linarith [hLM w]))
          (Finset.mem_univ w₀)
      have hle : M - L w₀ ≤ (w₀.mult : ℝ) * (M - L w₀) :=
        le_mul_of_one_le_left (by linarith) hm1
      rw [abs_le]
      constructor
      · linarith
      · linarith
    have coreB : ∀ (L : NumberField.InfinitePlace K → ℝ) (M : ℝ),
        (∀ w : NumberField.InfinitePlace K, L w ≤ M) →
        (0 ≤ ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * L w) →
        ∀ (c : NumberField.InfinitePlace K → ℝ) (D : ℝ),
          (∀ w : NumberField.InfinitePlace K, |c w| ≤ D) →
          |∑ w : NumberField.InfinitePlace K, c w * ((w.mult : ℝ) * L w)|
            ≤ D * (Module.finrank ℚ K : ℝ) ^ 2 * M := by
      intro L M hLM htr c D hc
      have hterm : ∀ w : NumberField.InfinitePlace K,
          |c w * ((w.mult : ℝ) * L w)|
            ≤ D * ((w.mult : ℝ) * ((Module.finrank ℚ K : ℝ) * M)) := by
        intro w
        have hD0 : (0 : ℝ) ≤ D := le_trans (abs_nonneg (c w)) (hc w)
        have hmn : (0 : ℝ) ≤ ((w.mult : ℕ) : ℝ) := Nat.cast_nonneg _
        have habs : |c w * ((w.mult : ℝ) * L w)| = |c w| * ((w.mult : ℝ) * |L w|) := by
          rw [abs_mul, abs_mul, abs_of_nonneg hmn]
        rw [habs]
        have h3 : (w.mult : ℝ) * |L w|
            ≤ (w.mult : ℝ) * ((Module.finrank ℚ K : ℝ) * M) :=
          mul_le_mul_of_nonneg_left (coreA L M hLM htr w) hmn
        exact mul_le_mul (hc w) h3 (mul_nonneg hmn (abs_nonneg _)) hD0
      have hfin : ∑ w : NumberField.InfinitePlace K,
            D * ((w.mult : ℝ) * ((Module.finrank ℚ K : ℝ) * M))
          = D * (Module.finrank ℚ K : ℝ) ^ 2 * M := by
        have hterm2 : ∀ w : NumberField.InfinitePlace K,
            D * ((w.mult : ℝ) * ((Module.finrank ℚ K : ℝ) * M))
              = (w.mult : ℝ) * (D * ((Module.finrank ℚ K : ℝ) * M)) := fun w => by ring
        rw [Finset.sum_congr rfl (fun w _ => hterm2 w), ← Finset.sum_mul, hsum]
        ring
      calc |∑ w : NumberField.InfinitePlace K, c w * ((w.mult : ℝ) * L w)|
          ≤ ∑ w : NumberField.InfinitePlace K, |c w * ((w.mult : ℝ) * L w)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ w : NumberField.InfinitePlace K,
              D * ((w.mult : ℝ) * ((Module.finrank ℚ K : ℝ) * M)) :=
            Finset.sum_le_sum (fun w _ => hterm w)
        _ = D * (Module.finrank ℚ K : ℝ) ^ 2 * M := hfin
    have hi : ∀ W : Fin (NumberField.Units.rank K) → ℝ,
        ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * kaiTBShapeLog K H W w = 0 := by
      intro W
      have hstep : ∀ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * kaiTBShapeLog K H W w
            = ∑ j, W j * kaiTBUnitLog K (H j) w := by
        intro w
        rw [hSL, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hUL]
        ring
      rw [Finset.sum_congr rfl (fun w _ => hstep w), Finset.sum_comm]
      have hstep2 : ∀ j : Fin (NumberField.Units.rank K),
          ∑ w : NumberField.InfinitePlace K, W j * kaiTBUnitLog K (H j) w = 0 := by
        intro j
        rw [← Finset.mul_sum, h4 j, mul_zero]
      rw [Finset.sum_congr rfl (fun j _ => hstep2 j), Finset.sum_const_zero]
    have hii : ∀ (W : Fin (NumberField.Units.rank K) → ℝ)
        (b : Fin (NumberField.Units.rank K)),
        W b = ∑ w : NumberField.InfinitePlace K,
                e b w * (w.mult : ℝ) * kaiTBShapeLog K H W w := by
      intro W b
      have hstep : ∀ w : NumberField.InfinitePlace K,
          e b w * (w.mult : ℝ) * kaiTBShapeLog K H W w
            = ∑ j, W j * (kaiTBUnitLog K (H j) w * e b w) := by
        intro w
        rw [hSL, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hUL]
        ring
      rw [Finset.sum_congr rfl (fun w _ => hstep w), Finset.sum_comm]
      have hstep2 : ∀ j : Fin (NumberField.Units.rank K),
          ∑ w : NumberField.InfinitePlace K, W j * (kaiTBUnitLog K (H j) w * e b w)
            = W j * (if j = b then (1 : ℝ) else 0) := by
        intro j
        rw [← Finset.mul_sum, h6 j b]
      rw [Finset.sum_congr rfl (fun j _ => hstep2 j)]
      simp
    intro W
    have hbdd : BddAbove (Set.range (fun w : NumberField.InfinitePlace K =>
        kaiTBShapeLog K H W w)) := Finite.bddAbove_range _
    have hLM : ∀ w : NumberField.InfinitePlace K,
        kaiTBShapeLog K H W w
          ≤ ⨆ w : NumberField.InfinitePlace K, kaiTBShapeLog K H W w :=
      fun w => le_ciSup hbdd w
    have htr : (0 : ℝ) ≤ ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * kaiTBShapeLog K H W w := le_of_eq (hi W).symm
    refine ⟨?_, ?_⟩
    · by_contra hneg
      push_neg at hneg
      have hlt : ∀ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * kaiTBShapeLog K H W w < 0 := by
        intro w
        have h2 : (0:ℝ) < (w.mult : ℝ) := by
          exact_mod_cast NumberField.InfinitePlace.mult_pos
        exact mul_neg_of_pos_of_neg h2 (lt_of_le_of_lt (hLM w) hneg)
      have hlt2 : (∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * kaiTBShapeLog K H W w)
          < ∑ _w : NumberField.InfinitePlace K, (0:ℝ) :=
        Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty (fun w _ => hlt w)
      rw [Finset.sum_const_zero, hi W] at hlt2
      exact lt_irrefl 0 hlt2
    · intro j
      have hb := coreB (fun w => kaiTBShapeLog K H W w)
        (⨆ w : NumberField.InfinitePlace K, kaiTBShapeLog K H W w) hLM htr (e j)
        (B * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K) (fun w => h8 j w)
      have hassoc : ∑ w : NumberField.InfinitePlace K,
          e j w * (w.mult : ℝ) * kaiTBShapeLog K H W w
          = ∑ w : NumberField.InfinitePlace K,
              e j w * ((w.mult : ℝ) * kaiTBShapeLog K H W w) :=
        Finset.sum_congr rfl (fun w _ => mul_assoc _ _ _)
      rw [hii W j, hassoc]
      exact hb
  
  intro B hB
  have hB0 : (0:ℝ) < B := by linarith
  have hRg : (0:ℝ) < NumberField.Units.regulator K := NumberField.Units.regulator_pos K
