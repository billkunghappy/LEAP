      have hww : w = w' := Units.ext (mul_right_cancel₀ hne heq)
      subst hww
      rfl
    refine ⟨G, hA, ?_⟩
    intro μ hμ0 hμρ
    obtain ⟨w, hw, hval'⟩ : ∃ w : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q w ∧
        μ = ((w : NumberField.RingOfIntegers K)) *
          (Quotient.out (Quotient.mk sr
            (⟨μ, hμ0, hμρ⟩ :
              {μ : NumberField.RingOfIntegers K // μ ≠ 0 ∧ μ - ρ ∈ q * b}))).1 :=
      Quotient.mk_out
        (⟨μ, hμ0, hμρ⟩ : {μ : NumberField.RingOfIntegers K // μ ≠ 0 ∧ μ - ρ ∈ q * b})
    have hres := hB (Quotient.mk sr
      (⟨μ, hμ0, hμρ⟩ : {μ : NumberField.RingOfIntegers K // μ ≠ 0 ∧ μ - ρ ∈ q * b})) w hw
    rw [← hval'] at hres
    exact hres
  have hfib : ∀ (I : Ideal (NumberField.RingOfIntegers K))
      (μ₀ : NumberField.RingOfIntegers K),
      μ₀ ∈ Gen → Ideal.span {μ₀} = I * b →
      Nonempty ({t : (NumberField.RingOfIntegers K)ˣ // t ∈ T} ≃
        {μ : {ν // ν ∈ Gen} //
          Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b}) := by
    intro I μ₀ hμ₀Gen hμ₀span
    obtain ⟨hμ₀0, hμ₀ρ⟩ := hGen1 μ₀ hμ₀Gen
    have hμ₀1 : μ₀ - 1 ∈ q := hM2 μ₀ hμ₀ρ
    have hμ₀b : μ₀ ∈ b := hM1 μ₀ hμ₀ρ
    have hN2 : ∀ t : (NumberField.RingOfIntegers K)ˣ,
        ((t : NumberField.RingOfIntegers K) - 1 ∈ q) →
        ((t : NumberField.RingOfIntegers K) * μ₀ ≠ 0 ∧
          (t : NumberField.RingOfIntegers K) * μ₀ - ρ ∈ q * b) := by
      intro t ht
      refine ⟨mul_ne_zero (Units.ne_zero t) hμ₀0, ?_⟩
      have hid : (t : NumberField.RingOfIntegers K) * μ₀ - ρ
          = ((t : NumberField.RingOfIntegers K) - 1) * μ₀ + (μ₀ - ρ) := by ring
      rw [hid]
      exact Submodule.add_mem _ (Ideal.mul_mem_mul ht hμ₀b) hμ₀ρ
    have key : ∀ t : {t : (NumberField.RingOfIntegers K)ˣ // t ∈ T},
        ∃ (ν : {μ : {ν // ν ∈ Gen} //
              Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b})
          (z : {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}),
          ((t.1 : NumberField.RingOfIntegers K)) * μ₀
            = ((z.1 : NumberField.RingOfIntegers K)) * (ν.1.1) := by
      intro t
      obtain ⟨hm0, hmρ⟩ := hN2 t.1 (hTsub _ t.2)
      obtain ⟨p, hp, -⟩ := hGen2 _ hm0 hmρ
      have hspan : Ideal.span {(p.1.1 : NumberField.RingOfIntegers K)} = I * b := by
        have h1 := Ideal.span_singleton_mul_left_unit (Units.isUnit p.2.1)
            (p.1.1 : NumberField.RingOfIntegers K)
        rw [← h1, ← hp,
          Ideal.span_singleton_mul_left_unit (Units.isUnit t.1) μ₀]
        exact hμ₀span
      exact ⟨⟨p.1, hspan⟩, p.2, hp⟩
    choose Φ U hΦ using key
    have hinj : Function.Injective Φ := by
      intro t t' hEq
      have h1 := hΦ t
      have h2 := hΦ t'
      rw [hEq] at h1
      have h3 : ((((U t').1 * t.1 : (NumberField.RingOfIntegers K)ˣ)) :
            NumberField.RingOfIntegers K) * μ₀
          = ((((U t).1 * t'.1 : (NumberField.RingOfIntegers K)ˣ)) :
            NumberField.RingOfIntegers K) * μ₀ := by
        rw [Units.val_mul, Units.val_mul, mul_assoc, mul_assoc, h1, h2]
        ring
      have h4 : (U t').1 * t.1 = (U t).1 * t'.1 :=
        Units.ext (mul_right_cancel₀ hμ₀0 h3)
      have hE : ((((U t').1 * t.1 : (NumberField.RingOfIntegers K)ˣ)) :
          NumberField.RingOfIntegers K) - 1 ∈ q :=
        hEmul _ _ (U t').2.1 (hTsub _ t.2)
      obtain ⟨p, hp, huniq⟩ := hTfac _ hE
      have e1 : ((t, U t') : {t : (NumberField.RingOfIntegers K)ˣ // t ∈ T} ×
          {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}) = p :=
        huniq _ (by rw [mul_comm])
      have e2 : ((t', U t) : {t : (NumberField.RingOfIntegers K)ˣ // t ∈ T} ×
          {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}) = p :=
        huniq _ (by rw [h4, mul_comm])
      exact congrArg Prod.fst (e1.trans e2.symm)
    have hsurj : Function.Surjective Φ := by
      intro ν
      have hν1 : (ν.1.1 : NumberField.RingOfIntegers K) - 1 ∈ q :=
        hM2 _ (hGen1 _ ν.1.2).2
      obtain ⟨w, hw⟩ : Associated μ₀ (ν.1.1 : NumberField.RingOfIntegers K) :=
        Ideal.span_singleton_eq_span_singleton.mp (hμ₀span.trans ν.2.symm)
      have hwq : ((w : (NumberField.RingOfIntegers K)ˣ) :
          NumberField.RingOfIntegers K) - 1 ∈ q := by
        have hid : ((w : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) - 1
            = ((ν.1.1 : NumberField.RingOfIntegers K) - 1)
              - ((w : (NumberField.RingOfIntegers K)ˣ) :
                  NumberField.RingOfIntegers K) * (μ₀ - 1) := by
          linear_combination hw
        rw [hid]
        exact Submodule.sub_mem _ hν1 (Ideal.mul_mem_left q _ hμ₀1)
      obtain ⟨p, hp, -⟩ := hTfac w hwq
      refine ⟨p.1, ?_⟩
      obtain ⟨hm0, hmρ⟩ := hN2 p.1.1 (hTsub _ p.1.2)
      obtain ⟨pr, hpr, hpruniq⟩ := hGen2 _ hm0 hmρ
      have q1 : ((Φ p.1).1, U p.1) = pr := hpruniq _ (hΦ p.1)
      have q2 : ((ν.1, ⟨(p.2.1)⁻¹, hinv _ p.2.2⟩) :
          {ν // ν ∈ Gen} ×
          {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}) = pr := by
        refine hpruniq _ ?_
        have hpv : ((w : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
            = ((p.1.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
              ((p.2.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) := by
          rw [hp, Units.val_mul]
        have hinvv : (((p.2.1)⁻¹ : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) *
            ((p.2.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) = 1 :=
          p.2.1.inv_mul
        show ((p.1.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * μ₀
            = (((p.2.1)⁻¹ : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) * ν.1.1
        rw [← hw, hpv]
        linear_combination
          (-((p.1.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * μ₀) *
            hinvv
      exact Subtype.ext (congrArg Prod.fst (q1.trans q2.symm))
    exact ⟨Equiv.ofBijective Φ ⟨hinj, hsurj⟩⟩
  have hraywit : ∀ I : Ideal (NumberField.RingOfIntegers K),
      (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * (I * b) = Ideal.span {δ} * ⊤) →
      ∃ μ : NumberField.RingOfIntegers K,
        μ ≠ 0 ∧ μ - ρ ∈ q * b ∧ Ideal.span {μ} = I * b := by
    rintro I ⟨γ, δ, hγ0, hδ0, hγq, hδq, heq⟩
    rw [Ideal.mul_top] at heq
    have hδmem : δ ∈ Ideal.span {γ} * (I * b) := by
      rw [heq]; exact Ideal.mem_span_singleton_self δ
    obtain ⟨μ, hμJ, hγμ⟩ := Ideal.mem_span_singleton_mul.mp hδmem
    have hμ0 : μ ≠ 0 := by
      intro h
      rw [h, mul_zero] at hγμ
      exact hδ0 hγμ.symm
    have hspan : Ideal.span {μ} = I * b := by
      refine le_antisymm ?_ ?_
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hμJ
      intro j hj
      have h1 : γ * j ∈ Ideal.span {γ} * (I * b) :=
        Ideal.mul_mem_mul (Ideal.mem_span_singleton_self γ) hj
      rw [heq, ← hγμ] at h1
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp h1
      have hjc : j = μ * c := mul_left_cancel₀ hγ0 (by rw [hc]; ring)
      exact Ideal.mem_span_singleton.mpr ⟨c, hjc⟩
    have hμ1 : μ - 1 ∈ q := by
      have hid : μ - 1 = (δ - 1) - (γ - 1) * μ := by linear_combination hγμ
      rw [hid]
      exact Submodule.sub_mem _ hδq (Ideal.mul_mem_right _ _ hγq)
    have hμb : μ ∈ b := Ideal.mul_le_left hμJ
    have hμρq : μ - ρ ∈ q := by
      have hid : μ - ρ = (μ - 1) - (ρ - 1) := by ring
      rw [hid]; exact Submodule.sub_mem _ hμ1 hρq
    have hμρb : μ - ρ ∈ b := Submodule.sub_mem _ hμb hρb
    have hcop : b * q = b ⊓ q := Ideal.mul_eq_inf_of_coprime hbq
    have hqb : q * b = q ⊓ b := by rw [mul_comm, hcop, inf_comm]
    refine ⟨μ, hμ0, ?_, hspan⟩
    rw [hqb]
    exact Submodule.mem_inf.mpr ⟨hμρq, hμρb⟩
  refine ⟨Gen, hGen1, hGen2, ?_, ?_, ?_⟩
  · intro I hI0 hIq
    by_cases hne : Nonempty {μ : {ν // ν ∈ Gen} //
        Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b}
    · obtain ⟨g⟩ := hne
      obtain ⟨e⟩ := hfib I g.1.1 g.1.2 g.2
      exact Finite.of_equiv _ e
    · rw [not_nonempty_iff] at hne
      exact Finite.of_subsingleton
  · intro I hI0 hIq hray
    obtain ⟨μ, hμ0, hμρ, hμspan⟩ := hraywit I hray
    obtain ⟨p, hp, -⟩ := hGen2 μ hμ0 hμρ
    have hgspan : Ideal.span {(p.1.1 : NumberField.RingOfIntegers K)} = I * b := by
      have h1 := Ideal.span_singleton_mul_left_unit (Units.isUnit p.2.1)
          (p.1.1 : NumberField.RingOfIntegers K)
      rw [← h1, ← hp]
      exact hμspan
    obtain ⟨e⟩ := hfib I p.1.1 p.1.2 hgspan
    rw [← Nat.card_congr e, hTcard]
  · intro I hI0 hIq hnray μ hμGen hspan
    obtain ⟨hμ0, hμρ⟩ := hGen1 μ hμGen
    have hμ1 : μ - 1 ∈ q := hM2 μ hμρ
    refine hnray ⟨1, μ, one_ne_zero, hμ0, by simp, hμ1, ?_⟩
    rw [Ideal.span_singleton_one, Ideal.top_mul, Ideal.mul_top, hspan]

theorem kai_mf_ray_char_orth (K : Type u) [Field K] [NumberField K] :
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (M : ℕ) (b : Fin M → Ideal (NumberField.RingOfIntegers K)),
        (∀ k, b k ≠ 0 ∧ b k ⊔ q = ⊤) →
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
            ∃! k : Fin M, ∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
              γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * I = Ideal.span {δ} * b k) →
        ∀ f : Ideal (NumberField.RingOfIntegers K) → ℂ,
          (∀ I J, f (I * J) = f I * f J) →
          (∀ I, I ≠ 0 → I ⊔ q = ⊤ → ‖f I‖ = 1) →
          (∀ I, I ⊔ q ≠ ⊤ → f I = 0) →
          (∀ γ : NumberField.RingOfIntegers K, γ ≠ 0 → γ - 1 ∈ q →
              f (Ideal.span {γ}) = 1) →
          (¬ ∀ I, I ≠ 0 → I ⊔ q = ⊤ → f I = 1) →
          (∑ k : Fin M, f (b k)) = 0 :=
by
  classical
  intro q hq M b hb huniq f hmul hnorm hzero hprin hnontriv
  have hconst : ∀ I J : Ideal (NumberField.RingOfIntegers K),
      (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * I = Ideal.span {δ} * J) → f I = f J := by
    rintro I J ⟨γ, δ, hγ0, hδ0, hγq, hδq, E⟩
    have h := congrArg f E
    rw [hmul, hmul, hprin γ hγ0 hγq, hprin δ hδ0 hδq, one_mul, one_mul] at h
    exact h
  push_neg at hnontriv
  obtain ⟨I₀, hI₀0, hI₀q, hI₀f⟩ := hnontriv
  have hne : ∀ k : Fin M, I₀ * b k ≠ 0 := fun k => mul_ne_zero hI₀0 (hb k).1
  have hcop : ∀ k : Fin M, (I₀ * b k) ⊔ q = ⊤ := fun k =>
    Ideal.isCoprime_iff_sup_eq.mp
      ((Ideal.isCoprime_iff_sup_eq.mpr hI₀q).mul_left
        (Ideal.isCoprime_iff_sup_eq.mpr (hb k).2))
  have hex : ∀ k : Fin M, ∃ k' : Fin M,
      (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * (I₀ * b k) = Ideal.span {δ} * b k') := by
    intro k
    obtain ⟨k', hk', -⟩ := huniq (I₀ * b k) (hne k) (hcop k)
    exact ⟨k', hk'⟩
  choose σ hσ using hex
  have hrefl : ∀ X : Ideal (NumberField.RingOfIntegers K),
      ∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * X = Ideal.span {δ} * X :=
    fun X => ⟨1, 1, one_ne_zero, one_ne_zero, by simp, by simp, rfl⟩
  have hinj : Function.Injective σ := by
    intro k₁ k₂ hk
    have h2 : ∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * (I₀ * b k₂) = Ideal.span {δ} * b (σ k₁) := by
      rw [hk]; exact hσ k₂
    obtain ⟨γ₁, δ₁, hγ₁0, hδ₁0, hγ₁q, hδ₁q, E₁⟩ := hσ k₁
    obtain ⟨γ₂, δ₂, hγ₂0, hδ₂0, hγ₂q, hδ₂q, E₂⟩ := h2
    have hmem1 : δ₂ * γ₁ - 1 ∈ q := by
      have h : δ₂ * γ₁ - 1 = δ₂ * (γ₁ - 1) + (δ₂ - 1) := by ring
      rw [h]
      exact Submodule.add_mem _ (Ideal.mul_mem_left q δ₂ hγ₁q) hδ₂q
    have hmem2 : δ₁ * γ₂ - 1 ∈ q := by
      have h : δ₁ * γ₂ - 1 = δ₁ * (γ₂ - 1) + (δ₁ - 1) := by ring
      rw [h]
      exact Submodule.add_mem _ (Ideal.mul_mem_left q δ₁ hγ₂q) hδ₁q
    have Ebig : Ideal.span {δ₂ * γ₁} * (I₀ * b k₁)
        = Ideal.span {δ₁ * γ₂} * (I₀ * b k₂) := by
      calc Ideal.span {δ₂ * γ₁} * (I₀ * b k₁)
          = Ideal.span {δ₂} * (Ideal.span {γ₁} * (I₀ * b k₁)) := by
            rw [← Ideal.span_singleton_mul_span_singleton]; ring
        _ = Ideal.span {δ₁} * (Ideal.span {γ₂} * (I₀ * b k₂)) := by rw [E₁, E₂]; ring
        _ = Ideal.span {δ₁ * γ₂} * (I₀ * b k₂) := by
            rw [← Ideal.span_singleton_mul_span_singleton]; ring
    have Ecancel : I₀ * (Ideal.span {δ₂ * γ₁} * b k₁)
        = I₀ * (Ideal.span {δ₁ * γ₂} * b k₂) := by
      calc I₀ * (Ideal.span {δ₂ * γ₁} * b k₁)
          = Ideal.span {δ₂ * γ₁} * (I₀ * b k₁) := by ring
        _ = Ideal.span {δ₁ * γ₂} * (I₀ * b k₂) := Ebig
        _ = I₀ * (Ideal.span {δ₁ * γ₂} * b k₂) := by ring
    have h4 : ∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * b k₁ = Ideal.span {δ} * b k₂ :=
      ⟨δ₂ * γ₁, δ₁ * γ₂, mul_ne_zero hδ₂0 hγ₁0, mul_ne_zero hδ₁0 hγ₂0, hmem1, hmem2,
        mul_left_cancel₀ hI₀0 Ecancel⟩
    obtain ⟨k₀, -, hk₀u⟩ := huniq (b k₁) (hb k₁).1 (hb k₁).2
    exact (hk₀u k₁ (hrefl (b k₁))).trans (hk₀u k₂ h4).symm
  have hscale : ∀ k : Fin M, f (b (σ k)) = f I₀ * f (b k) := by
    intro k
    have h := hconst (I₀ * b k) (b (σ k)) (hσ k)
    rw [← h, hmul]
  have hbij : Function.Bijective σ := Finite.injective_iff_bijective.mp hinj
  have hsum1 : (∑ k : Fin M, f (b (σ k))) = ∑ k : Fin M, f (b k) :=
    Fintype.sum_bijective σ hbij _ _ (fun _ => rfl)
  have hsum2 : (∑ k : Fin M, f (b (σ k))) = f I₀ * ∑ k : Fin M, f (b k) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun k _ => hscale k)
  have hS : (∑ k : Fin M, f (b k)) = f I₀ * ∑ k : Fin M, f (b k) := hsum1.symm.trans hsum2
  have hzz : (f I₀ - 1) * (∑ k : Fin M, f (b k)) = 0 := by
    rw [sub_mul, one_mul, ← hS, sub_self]
  rcases mul_eq_zero.mp hzz with h | h
  · exact absurd (sub_eq_zero.mp h) hI₀f
  · exact h

theorem kai_mf_ray_class_split (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hClass : KaiHZClassCoprimeProp K) : KaiMFRayClassProp K :=
by
  classical
  have hcov := kai_mf_ray_class_cover K hClass
  have hrep := kai_mf_ray_small_rep K (kai_mf_small_coset_elt K)
  have htrans := kai_mf_ray_transversal K hrep hcov
  have hcellP := kai_mf_cell_gen K (kai_mf_cong_unit_index K)
  have horth := kai_mf_ray_char_orth K
  obtain ⟨C, hC1, hC⟩ := htrans
  refine ⟨C, hC1, ?_⟩
  intro q hq
  have hcop1 : ∀ (J : Ideal (NumberField.RingOfIntegers K))
      (x : NumberField.RingOfIntegers K), x ∈ J → x - 1 ∈ q → J ⊔ q = ⊤ := by
    intro J x hxJ hxq
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : NumberField.RingOfIntegers K) = x - (x - 1) := by ring
    rw [h1]
    exact Submodule.sub_mem _ (Ideal.mem_sup_left hxJ) (Ideal.mem_sup_right hxq)
  have hanch : ∀ J : Ideal (NumberField.RingOfIntegers K), J ≠ 0 → J ⊔ q = ⊤ →
      ∃ r : NumberField.RingOfIntegers K, r ≠ 0 ∧ r ∈ J ∧ r - 1 ∈ q := by
    intro J hJ0 hJq
    have h1 : (1 : NumberField.RingOfIntegers K) ∈ J ⊔ q := by
      rw [hJq]; exact Submodule.mem_top
    rw [Submodule.mem_sup] at h1
    obtain ⟨x, hxJ, y, hyq, hxy⟩ := h1
    by_cases hx : x = 0
    · have hy1 : y = 1 := by rw [hx] at hxy; simpa using hxy
      have hqtop : q = ⊤ := by
        rw [Ideal.eq_top_iff_one, ← hy1]; exact hyq
      refine ⟨((Ideal.absNorm J : ℕ) : NumberField.RingOfIntegers K), ?_,
        Ideal.absNorm_mem J, ?_⟩
      · have hne : Ideal.absNorm J ≠ 0 := by
          intro h0
          apply hJ0
          rw [Submodule.zero_eq_bot]
          exact Ideal.absNorm_eq_zero_iff.mp h0
        exact_mod_cast Nat.cast_ne_zero.mpr hne
      · rw [hqtop]; exact Submodule.mem_top
    · refine ⟨x, hx, hxJ, ?_⟩
      have hxy' : x - 1 = -y := by linear_combination hxy
      rw [hxy']
      exact Submodule.neg_mem _ hyq
  have hsymm : ∀ X Y : Ideal (NumberField.RingOfIntegers K),
      (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * X = Ideal.span {δ} * Y) →
      (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
        γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * Y = Ideal.span {δ} * X) := by
    rintro X Y ⟨γ, δ, h1, h2, h3, h4, h5⟩
    exact ⟨δ, γ, h2, h1, h4, h3, h5.symm⟩
  obtain ⟨M, b, hM0, hMbd, hb, huniq⟩ := hC q hq
  choose ρ hρ0 hρb hρq using
    fun k : Fin M => hanch (b k) (hb k).1 (hb k).2.1
  obtain ⟨hh, hhpos, hcell⟩ := hcellP q hq
  choose Gen hGen1 hGen2 hGenFin hGenCard hGenNone using
    fun k : Fin M =>
      hcell (b k) (hb k).1 (hb k).2.1 (ρ k) (hρ0 k) (hρb k) (hρq k)
  refine ⟨M, hh, b, ρ, Gen, hM0, hhpos, hMbd, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact fun k => ⟨(hb k).1, (hb k).2.1, hρ0 k, hρb k, hρq k, (hb k).2.2⟩
  · exact fun k => hGen1 k
  · exact fun k => hGen2 k
  · intro k μ hμ
    obtain ⟨hμ0, hμρ⟩ := hGen1 k μ hμ
    have hμb : μ ∈ b k := by
      have h1 : μ - ρ k ∈ b k := Ideal.mul_le_left hμρ
      have h2 : μ = (μ - ρ k) + ρ k := by ring
      rw [h2]
      exact Submodule.add_mem _ h1 (hρb k)
    have hμ1 : μ - 1 ∈ q := by
      have h1 : μ - ρ k ∈ q := Ideal.mul_le_right hμρ
      have h2 : μ - 1 = (μ - ρ k) + (ρ k - 1) := by ring
      rw [h2]
      exact Submodule.add_mem _ h1 (hρq k)
    obtain ⟨I, hI⟩ :=
      Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem (b k)).mpr hμb)
    refine ⟨I, ?_, ?_, by rw [hI]; ring⟩
    · intro hI0
      rw [hI0, mul_zero, Submodule.zero_eq_bot, Ideal.span_singleton_eq_bot] at hI
      exact hμ0 hI
    · refine hcop1 I μ ?_ hμ1
      have hle : Ideal.span {μ} ≤ I := by rw [hI]; exact Ideal.mul_le_left
      exact (Ideal.span_singleton_le_iff_mem I).mp hle
  · intro I hI0 hIq
    obtain ⟨γ₀, hγ₀0, hγ₀I, hγ₀q⟩ := hanch I hI0 hIq
    obtain ⟨I', hI'⟩ :=
      Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem I).mpr hγ₀I)
    have hI'0 : I' ≠ 0 := by
      intro h0
      rw [h0, mul_zero, Submodule.zero_eq_bot, Ideal.span_singleton_eq_bot] at hI'
      exact hγ₀0 hI'
    have hI'q : I' ⊔ q = ⊤ := by
      refine hcop1 I' γ₀ ?_ hγ₀q
      have hle : Ideal.span {γ₀} ≤ I' := by rw [hI']; exact Ideal.mul_le_left
      exact (Ideal.span_singleton_le_iff_mem I').mp hle
    have hiff : ∀ k : Fin M,
        (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
          γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * (I * b k) = Ideal.span {δ} * ⊤) ↔
        (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
          γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * b k = Ideal.span {δ} * I') := by
      intro k
      constructor
      · rintro ⟨γ, δ, hγ0, hδ0, hγq, hδq, heq⟩
        refine ⟨γ * γ₀, δ, mul_ne_zero hγ0 hγ₀0, hδ0, ?_, hδq, ?_⟩
        · have h : γ * γ₀ - 1 = γ * (γ₀ - 1) + (γ - 1) := by ring
          rw [h]
          exact Submodule.add_mem _ (Ideal.mul_mem_left q γ hγ₀q) hγq
        · calc Ideal.span {γ * γ₀} * b k
              = Ideal.span {γ} * Ideal.span {γ₀} * b k := by
                rw [Ideal.span_singleton_mul_span_singleton]
            _ = Ideal.span {γ} * (I * I') * b k := by rw [hI']
            _ = I' * (Ideal.span {γ} * (I * b k)) := by ring
            _ = I' * (Ideal.span {δ} * ⊤) := by rw [heq]
            _ = Ideal.span {δ} * I' := by rw [Ideal.mul_top]; ring
      · rintro ⟨γ, δ, hγ0, hδ0, hγq, hδq, heq⟩
        refine ⟨γ, δ * γ₀, hγ0, mul_ne_zero hδ0 hγ₀0, hγq, ?_, ?_⟩
        · have h : δ * γ₀ - 1 = δ * (γ₀ - 1) + (δ - 1) := by ring
          rw [h]
          exact Submodule.add_mem _ (Ideal.mul_mem_left q δ hγ₀q) hδq
        · calc Ideal.span {γ} * (I * b k)
              = I * (Ideal.span {γ} * b k) := by ring
            _ = I * (Ideal.span {δ} * I') := by rw [heq]
            _ = Ideal.span {δ} * (I * I') := by ring
            _ = Ideal.span {δ} * Ideal.span {γ₀} := by rw [← hI']
            _ = Ideal.span {δ * γ₀} := Ideal.span_singleton_mul_span_singleton δ γ₀
            _ = Ideal.span {δ * γ₀} * ⊤ := (Ideal.mul_top _).symm
    obtain ⟨k₀, hk₀, hk₀uniq⟩ := huniq I' hI'0 hI'q
    have hk₀' := (hiff k₀).mpr (hsymm _ _ hk₀)
    have hother : ∀ k : Fin M, k ≠ k₀ →
        ¬ (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
          γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * (I * b k) = Ideal.span {δ} * ⊤) := by
      intro k hk hcon
      exact hk (hk₀uniq k (hsymm _ _ ((hiff k).mp hcon)))
    haveI hfin : ∀ k : Fin M,
        Finite {μ : {ν // ν ∈ Gen k} //
          Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b k} :=
      fun k => hGenFin k I hI0 hIq
    have e : {p : (k : Fin M) × {μ // μ ∈ Gen k} //
          Ideal.span {(p.2 : NumberField.RingOfIntegers K)} = I * b p.1}
        ≃ Σ k : Fin M, {μ : {ν // ν ∈ Gen k} //
          Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b k} :=
      { toFun := fun p => ⟨p.1.1, ⟨p.1.2, p.2⟩⟩
        invFun := fun p => ⟨⟨p.1, p.2.1⟩, p.2.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    rw [Nat.card_congr e, Nat.card_sigma]
    refine Eq.trans (Finset.sum_eq_single k₀ ?_ ?_) (hGenCard k₀ I hI0 hIq hk₀')
    · intro k _ hk
      haveI : IsEmpty {μ : {ν // ν ∈ Gen k} //
          Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b k} := by
        constructor
        rintro ⟨⟨μ, hμGen⟩, hμeq⟩
        exact hGenNone k I hI0 hIq (hother k hk) μ hμGen hμeq
      exact Nat.card_of_isEmpty
    · intro hmem
      exact absurd (Finset.mem_univ k₀) hmem
  · intro f hmul hnorm hzero hprin hnontriv
    exact horth q hq M b (fun k => ⟨(hb k).1, (hb k).2.1⟩) huniq f hmul hnorm hzero
      hprin hnontriv

theorem kai_mf_cone_fund_domain (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : KaiMFConeFundDomProp K :=
by
  classical
  
  have s2 : kaiMFUnitShift K 1 = 0 ∧
      (∀ u v : (NumberField.RingOfIntegers K)ˣ,
          kaiMFUnitShift K (u * v) = kaiMFUnitShift K u + kaiMFUnitShift K v) ∧
      (∀ (u : (NumberField.RingOfIntegers K)ˣ) (k : ℤ),
          kaiMFUnitShift K (u ^ k) = (k : ℝ) • kaiMFUnitShift K u) ∧
      (∀ u : (NumberField.RingOfIntegers K)ˣ,
          kaiMFUnitShift K u = 0 ↔ u ∈ NumberField.Units.torsion K) ∧
      (∀ u : (NumberField.RingOfIntegers K)ˣ, kaiMFLogNorm K (kaiMFUnitShift K u) = 0) := by
    have hpos : ∀ (w : NumberField.InfinitePlace K) (v : (NumberField.RingOfIntegers K)ˣ),
        0 < w ((v : NumberField.RingOfIntegers K) : K) := by
      intro w v
      rw [NumberField.InfinitePlace.pos_iff]
      simp
    have hmulw : ∀ (w : NumberField.InfinitePlace K) (u v : (NumberField.RingOfIntegers K)ˣ),
        w (((u * v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
          = w ((u : NumberField.RingOfIntegers K) : K)
            * w ((v : NumberField.RingOfIntegers K) : K) := by
      intro w u v
      rw [Units.val_mul]
      push_cast
      exact map_mul w _ _
    have sh1 : kaiMFUnitShift K 1 = 0 := by
      funext w
      simp [kaiMFUnitShift]
    have shmul : ∀ u v : (NumberField.RingOfIntegers K)ˣ,
        kaiMFUnitShift K (u * v) = kaiMFUnitShift K u + kaiMFUnitShift K v := by
      intro u v
      funext w
      simp only [kaiMFUnitShift, Pi.add_apply]
      rw [hmulw, Real.log_mul (hpos w u).ne' (hpos w v).ne']
      ring
    have shinv : ∀ v : (NumberField.RingOfIntegers K)ˣ,
        kaiMFUnitShift K v⁻¹ = - kaiMFUnitShift K v := by
      intro v
      have h := shmul v⁻¹ v
      rw [inv_mul_cancel, sh1] at h
      exact eq_neg_of_add_eq_zero_left h.symm
    refine ⟨sh1, shmul, ?_, ?_, ?_⟩
    · intro u k
      induction k using Int.induction_on with
      | zero => simp [sh1]
      | succ n ih =>
        rw [zpow_add_one, shmul, ih]
        push_cast
        rw [add_smul, one_smul]
      | pred n ih =>
        rw [zpow_sub_one, shmul, ih, shinv]
        push_cast
        rw [sub_smul, one_smul, sub_eq_add_neg]
    · intro u
      rw [NumberField.Units.mem_torsion]
      constructor
      · intro h w
        have := congrFun h w
        simp only [kaiMFUnitShift, Pi.zero_apply] at this
        have hlog : Real.log (w ((u : NumberField.RingOfIntegers K) : K)) = 0 := by linarith
        exact Real.eq_one_of_pos_of_log_eq_zero (hpos w u) hlog
      · intro h
        funext w
        simp only [kaiMFUnitShift, Pi.zero_apply]
        rw [show w ((u : NumberField.RingOfIntegers K) : K) = 1 from h w]
        simp
    · intro u
      have hprod : ∏ w : NumberField.InfinitePlace K,
          w ((u : NumberField.RingOfIntegers K) : K) ^ w.mult = 1 := by
        rw [NumberField.InfinitePlace.prod_eq_abs_norm]
        have := NumberField.Units.norm K u
        exact_mod_cast this
      have hlog := congrArg Real.log hprod
      rw [Real.log_one, Real.log_prod (fun w _ => pow_ne_zero _ (hpos w u).ne')] at hlog
      simp only [Real.log_pow] at hlog
      unfold kaiMFLogNorm kaiMFUnitShift
      calc ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (2 * Real.log (w ((u : NumberField.RingOfIntegers K) : K)))
          = 2 * ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K)) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun w _ => ?_)
            ring
        _ = 0 := by rw [hlog, mul_zero]
  obtain ⟨sh1, shmul, shzpow, shker, shL⟩ := s2
  
  have s3 : ∃ ℓ : Fin (NumberField.Units.rank K) → (NumberField.InfinitePlace K → ℝ),
      (∀ i, kaiMFLogNorm K (ℓ i) = 0) ∧
      LinearIndependent ℝ (Fin.snoc ℓ (fun _ => (1 : ℝ)) :
        Fin (NumberField.Units.rank K + 1) → (NumberField.InfinitePlace K → ℝ)) ∧
      (∀ v : (NumberField.RingOfIntegers K)ˣ, ∃ a : Fin (NumberField.Units.rank K) → ℤ,
        kaiMFUnitShift K v = ∑ i, (a i : ℝ) • ℓ i) ∧
      (∀ i, ∃ ε : (NumberField.RingOfIntegers K)ˣ, kaiMFUnitShift K ε = ℓ i) := by
    have shprod : ∀ (f : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
        (s : Finset (Fin (NumberField.Units.rank K))),
        kaiMFUnitShift K (∏ i ∈ s, f i) = ∑ i ∈ s, kaiMFUnitShift K (f i) := by
      intro f s
      induction s using Finset.induction_on with
      | empty => simp [sh1]
      | insert j s hj ih => rw [Finset.prod_insert hj, Finset.sum_insert hj, shmul, ih]
    refine ⟨fun i => kaiMFUnitShift K (NumberField.Units.fundSystem K i),
      fun i => shL _, ?_, ?_, fun i => ⟨_, rfl⟩⟩
    · rw [Fintype.linearIndependent_iff]
      intro g hg
      rw [Fin.sum_univ_castSucc] at hg
      simp only [Fin.snoc_castSucc, Fin.snoc_last] at hg
      have hpt : ∀ w : NumberField.InfinitePlace K,
          ∑ j, g (Fin.castSucc j) * kaiMFUnitShift K (NumberField.Units.fundSystem K j) w
            + g (Fin.last _) = 0 := by
        intro w
        have := congrFun hg w
        simpa using this
      have hn : (0 : ℝ) < ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) := by
        have : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) = (Module.finrank ℚ K : ℝ) := by
          exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
        rw [this]; exact_mod_cast Module.finrank_pos
      have hlast : g (Fin.last _) = 0 := by
        have hsum : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) *
            (∑ j, g (Fin.castSucc j) * kaiMFUnitShift K (NumberField.Units.fundSystem K j) w
              + g (Fin.last _)) = 0 := by
          simp [hpt]
        have hexp : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) *
            (∑ j, g (Fin.castSucc j) * kaiMFUnitShift K (NumberField.Units.fundSystem K j) w
              + g (Fin.last _))
            = ∑ j, g (Fin.castSucc j) *
                kaiMFLogNorm K (kaiMFUnitShift K (NumberField.Units.fundSystem K j))
              + g (Fin.last _) * ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) := by
          simp only [kaiMFLogNorm, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
          congr 1
          · rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun w _ => ?_))
            ring
          · refine Finset.sum_congr rfl (fun w _ => ?_)
            ring
        rw [hexp] at hsum
        simp only [shL, mul_zero, Finset.sum_const_zero, zero_add] at hsum
        rcases mul_eq_zero.mp hsum with h | h
        · exact h
        · exact absurd h hn.ne'
      have hLI2 := NumberField.Units.isMaxRank_fundSystem K
      rw [NumberField.Units.IsMaxRank, Fintype.linearIndependent_iff] at hLI2
      have hzero : ∑ j, g (Fin.castSucc j) •
          NumberField.Units.logEmbedding K (Additive.ofMul (NumberField.Units.fundSystem K j))
            = 0 := by
        funext w
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
        have h := hpt w.1
        rw [hlast, add_zero] at h
        simp only [kaiMFUnitShift] at h
        calc ∑ j, g (Fin.castSucc j) * ((w.1.mult : ℝ) * Real.log (w.1
                ((algebraMap (NumberField.RingOfIntegers K) K)
                  (NumberField.Units.fundSystem K j : NumberField.RingOfIntegers K))))
            = ((w.1.mult : ℝ) / 2) * ∑ j, g (Fin.castSucc j) * (2 * Real.log (w.1
                (((NumberField.Units.fundSystem K j : NumberField.RingOfIntegers K) : K)))) := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              simp only [NumberField.RingOfIntegers.coe_eq_algebraMap]
              ring
          _ = 0 := by rw [h, mul_zero]
      intro i
      exact Fin.lastCases hlast (fun j => hLI2 _ hzero j) i
    · intro v
      obtain ⟨ζe, hζe, -⟩ := NumberField.Units.exist_unique_eq_mul_prod K v
      refine ⟨ζe.2, ?_⟩
      rw [hζe, shmul, (shker _).2 ζe.1.2, zero_add, shprod]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [shzpow]
  
  have s4 : ∀ (r N : ℕ) (hN : 0 < N) (S : AddSubgroup (Fin r → ℤ))
      (hS : ∀ a : Fin r → ℤ, (fun i => (N : ℤ) * a i) ∈ S),
      ∃ R : Set (Fin r → ℤ),
        (∀ k : Fin r → ℤ, ∃! ρ : Fin r → ℤ, ρ ∈ R ∧ ρ - k ∈ S) ∧
        (∀ ρ ∈ R, ∀ i, 0 ≤ ρ i ∧ ρ i < (N : ℤ)) := by
    intro r N hN S hS
    have hNz : (0 : ℤ) < N := by exact_mod_cast hN
    let red : (Fin r → ℤ) → (Fin r → ℤ) := fun k i => k i % (N : ℤ)
    have hredS : ∀ k, red k - k ∈ S := by
      intro k
      have : red k - k = fun i => (N : ℤ) * (-(k i / N)) := by
        funext i
        simp only [red, Pi.sub_apply]
        rw [Int.emod_def]; ring
      rw [this]; exact hS _
    have hredQ : ∀ k, ((red k : Fin r → ℤ) : (Fin r → ℤ) ⧸ S) = (k : (Fin r → ℤ) ⧸ S) :=
      fun k => (QuotientAddGroup.eq_iff_sub_mem).2 (hredS k)
    refine ⟨Set.range (fun x : (Fin r → ℤ) ⧸ S => red (Quotient.out x)), ?_, ?_⟩
    · intro k
      refine ⟨red (Quotient.out (k : (Fin r → ℤ) ⧸ S)), ⟨⟨_, rfl⟩, ?_⟩, ?_⟩
      · rw [← QuotientAddGroup.eq_iff_sub_mem, hredQ, QuotientAddGroup.out_eq']
      · rintro ρ ⟨⟨x, rfl⟩, hρ⟩
        rw [← QuotientAddGroup.eq_iff_sub_mem, hredQ, QuotientAddGroup.out_eq'] at hρ
        rw [hρ]
    · rintro ρ ⟨x, rfl⟩ i
      exact ⟨Int.emod_nonneg _ hNz.ne', Int.emod_lt_of_pos _ hNz⟩
  
  have s5 : ∀ {ι : Type u} [Fintype ι] (r N : ℕ)
      (m : ι → ℝ) (n : ℝ) (hn : 0 < n) (hmn : ∑ w, m w = n)
      (ℓ : Fin r → (ι → ℝ)) (hℓ0 : ∀ i, ∑ w, m w * ℓ i w = 0)
      (hLI : LinearIndependent ℝ (Fin.snoc ℓ (fun _ => (1 : ℝ)) : Fin (r + 1) → (ι → ℝ)))
      (hcard : r + 1 = Fintype.card ι)
      (Λ : AddSubgroup (ι → ℝ))
      (hΛ : ∀ γ ∈ Λ, ∃ a : Fin r → ℤ, γ = ∑ i, (a i : ℝ) • ℓ i)
      (R : Set (Fin r → ℤ))
      (hR : ∀ k : Fin r → ℤ, ∃! ρ : Fin r → ℤ,
          ρ ∈ R ∧ (∑ i, ((ρ i - k i : ℤ) : ℝ) • ℓ i) ∈ Λ)
      (hRbox : ∀ ρ ∈ R, ∀ i, 0 ≤ ρ i ∧ ρ i < (N : ℤ)),
      ∃ (F : Set (ι → ℝ)) (c : ℝ), 1 ≤ c ∧ Countable ↥Λ ∧ MeasurableSet F ∧
        MeasureTheory.IsAddFundamentalDomain (↥Λ) F MeasureTheory.volume ∧
        (∀ u ∈ F, ∀ w : ι, |u w - (∑ w', m w' * u w') / n| ≤ c) ∧
        (∀ (u : ι → ℝ) (t : ℝ), u ∈ F ↔ (fun w => u w + t) ∈ F) := by
    intro ι _ r N m n hn hmn ℓ hℓ0 hLI hcard Λ hΛ R hR hRbox
    have hcardB : Fintype.card (Fin (r + 1)) = Module.finrank ℝ (ι → ℝ) := by
      rw [Fintype.card_fin, Module.finrank_fintype_fun_eq_card, hcard]
    let Bs := basisOfLinearIndependentOfCardEqFinrank hLI hcardB
    have hBs : ∀ j, Bs j = (Fin.snoc ℓ (fun _ => (1 : ℝ)) : Fin (r + 1) → (ι → ℝ)) j := by
      intro j
      simp [Bs, coe_basisOfLinearIndependentOfCardEqFinrank]
    have hBℓ : ∀ i, Bs (Fin.castSucc i) = ℓ i := fun i => by rw [hBs]; simp
    have hB1 : Bs (Fin.last r) = fun _ => (1 : ℝ) := by rw [hBs]; simp
    let cc : Fin r → (ι → ℝ) → ℝ := fun i u => Bs.repr u (Fin.castSucc i)
    let c0 : (ι → ℝ) → ℝ := fun u => Bs.repr u (Fin.last r)
    have hcc_cont : ∀ i, Continuous (cc i) := by
      intro i
      have : cc i = ⇑(Bs.coord (Fin.castSucc i)) := by
        funext u; simp [cc, Module.Basis.coord_apply]
      rw [this]
      exact LinearMap.continuous_of_finiteDimensional _
    let φ : (Fin r → ℤ) → (ι → ℝ) := fun a => ∑ i, (a i : ℝ) • ℓ i
    have hI1 : ∀ u w, u w = ∑ i, cc i u * ℓ i w + c0 u := by
      intro u w
      have h := congrFun (Bs.sum_repr u) w
      rw [Fin.sum_univ_castSucc] at h
      simp only [Finset.sum_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hBℓ, hB1,
        mul_one] at h
      rw [← h]
    have hcc_phi : ∀ (a : Fin r → ℤ) (u : ι → ℝ) (i : Fin r),
        cc i (φ a + u) = a i + cc i u := by
      intro a u i
      have hφ : φ a = ∑ j, (a j : ℝ) • Bs (Fin.castSucc j) := by
        simp only [φ, hBℓ]
      simp only [cc, map_add, Finsupp.add_apply, hφ, map_sum, map_smul, Module.Basis.repr_self,
        Finsupp.coe_finset_sum, Finset.sum_apply, Finsupp.smul_apply, Finsupp.single_apply,
        Fin.castSucc_inj, smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
        Finset.mem_univ, if_true]
    have hcc_diag : ∀ (u : ι → ℝ) (t : ℝ) (i : Fin r), cc i (fun w => u w + t) = cc i u := by
      intro u t i
      have : (fun w => u w + t) = u + t • Bs (Fin.last r) := by
        rw [hB1]; funext w; simp
      simp only [cc, this, map_add, map_smul, Module.Basis.repr_self, Finsupp.add_apply,
        Finsupp.smul_apply, Finsupp.single_apply, smul_eq_mul]
      rw [if_neg (Fin.castSucc_lt_last i).ne', mul_zero, add_zero]
    have hL : ∀ u : ι → ℝ, (∑ w', m w' * u w') / n = c0 u := by
      intro u
      have h : ∑ w', m w' * u w' = n * c0 u := by
        calc ∑ w', m w' * u w' = ∑ w', m w' * (∑ i, cc i u * ℓ i w' + c0 u) :=
              Finset.sum_congr rfl (fun w' _ => by rw [← hI1])
          _ = ∑ w', ∑ i, cc i u * (m w' * ℓ i w') + ∑ w', c0 u * m w' := by
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl (fun w' _ => ?_)
              rw [mul_add, Finset.mul_sum]
              congr 1
              · exact Finset.sum_congr rfl (fun i _ => by ring)
              · ring
          _ = ∑ i, cc i u * (∑ w', m w' * ℓ i w') + c0 u * ∑ w', m w' := by
              rw [Finset.sum_comm, Finset.mul_sum]
              congr 1
              exact Finset.sum_congr rfl (fun i _ => by rw [Finset.mul_sum])
          _ = n * c0 u := by simp [hℓ0, hmn]; ring
      rw [h]; field_simp
    let κ : (ι → ℝ) → (Fin r → ℤ) := fun u i => ⌊cc i u⌋
    let F : Set (ι → ℝ) := κ ⁻¹' R
    have hκ_phi : ∀ a u, κ (φ a + u) = a + κ u := by
      intro a u
      funext i
      simp only [κ, Pi.add_apply, hcc_phi]
      exact Int.floor_intCast_add _ _
    have hκ_meas : Measurable κ := by
      apply measurable_pi_lambda
      intro i
      exact Int.measurable_floor.comp (hcc_cont i).measurable
    have hFm : MeasurableSet F := hκ_meas (Set.to_countable R).measurableSet
    refine ⟨F, 1 + N * ∑ i, ∑ w', |ℓ i w'|, ?_, ?_, hFm, ?_, ?_, ?_⟩
    · have : 0 ≤ (N : ℝ) * ∑ i, ∑ w', |ℓ i w'| := by positivity
      linarith
    · have hsub : (Λ : Set (ι → ℝ)) ⊆ Set.range φ := by
        intro γ hγ
        obtain ⟨a, ha⟩ := hΛ γ hγ
        exact ⟨a, ha.symm⟩
      exact ((Set.countable_range φ).mono hsub).to_subtype
    · refine MeasureTheory.IsAddFundamentalDomain.mk' hFm.nullMeasurableSet (fun x => ?_)
      obtain ⟨ρ, ⟨hρR, hρΛ⟩, huniq⟩ := hR (κ x)
      have hgmem : φ (ρ - κ x) ∈ Λ := hρΛ
      refine ⟨⟨φ (ρ - κ x), hgmem⟩, ?_, ?_⟩
      · show κ (φ (ρ - κ x) + x) ∈ R
        rw [hκ_phi, sub_add_cancel]
        exact hρR
      · rintro ⟨g, hg⟩ hgF
        obtain ⟨a, rfl⟩ := hΛ g hg
        have h1 : κ (φ a + x) ∈ R := hgF
        rw [hκ_phi] at h1
        have h2 : a + κ x = ρ := by
          refine huniq (a + κ x) ⟨h1, ?_⟩
          simpa using hg
        apply Subtype.ext
        show φ a = φ (ρ - κ x)
        rw [← h2, add_sub_cancel_right]
    · intro u hu w
      have hρ : κ u ∈ R := hu
      have hbd : ∀ i, |cc i u| ≤ N := by
        intro i
        obtain ⟨h0, hN⟩ := hRbox _ hρ i
        have f1 : ((κ u i : ℤ) : ℝ) ≤ cc i u := Int.floor_le _
        have f2 : cc i u < (κ u i : ℝ) + 1 := Int.lt_floor_add_one _
        have g0 : (0 : ℝ) ≤ (κ u i : ℝ) := by exact_mod_cast h0
        have g1 : (κ u i : ℝ) + 1 ≤ N := by
          have : κ u i + 1 ≤ (N : ℤ) := by omega
          exact_mod_cast this
        rw [abs_le]; constructor <;> linarith
      rw [hL u]
      have hdiff : u w - c0 u = ∑ i, cc i u * ℓ i w := by rw [hI1 u w]; ring
      rw [hdiff]
      calc |∑ i, cc i u * ℓ i w| ≤ ∑ i, |cc i u * ℓ i w| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i, (N : ℝ) * ∑ w', |ℓ i w'| := by
            refine Finset.sum_le_sum (fun i _ => ?_)
            rw [abs_mul]
            exact mul_le_mul (hbd i)
              (Finset.single_le_sum (f := fun w' => |ℓ i w'|) (fun _ _ => abs_nonneg _)
                (Finset.mem_univ w))
              (abs_nonneg _) (Nat.cast_nonneg _)
        _ = (N : ℝ) * ∑ i, ∑ w', |ℓ i w'| := by rw [Finset.mul_sum]
        _ ≤ 1 + N * ∑ i, ∑ w', |ℓ i w'| := by linarith
    · intro u t
      have : κ (fun w => u w + t) = κ u := by
        funext i
        simp only [κ, hcc_diag]
      show κ u ∈ R ↔ κ (fun w => u w + t) ∈ R
      rw [this]
  
  intro q hq
  
  have s1 : KaiMFCongUnit K q 1 ∧
      (∀ v₁ v₂ : (NumberField.RingOfIntegers K)ˣ,
          KaiMFCongUnit K q v₁ → KaiMFCongUnit K q v₂ → KaiMFCongUnit K q (v₁ * v₂)) ∧
      (∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v → KaiMFCongUnit K q v⁻¹) ∧
      ∃ N : ℕ, 0 < N ∧ ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q (v ^ N) := by
    set x : {w : NumberField.InfinitePlace K // w.IsReal} → NumberField.RingOfIntegers K → ℝ :=
      fun w a => (NumberField.mixedEmbedding K (a : K)).1 w with hxdef
    have hxmul : ∀ w (a b : NumberField.RingOfIntegers K), x w (a * b) = x w a * x w b := by
      intro w a b
      simp only [hxdef]
      push_cast
      rw [map_mul]
      rfl
    have hxone : ∀ w, x w 1 = 1 := by
      intro w
      simp only [hxdef]
      push_cast
      rw [map_one]
      rfl
    have hxpow : ∀ w (a : NumberField.RingOfIntegers K) (n : ℕ), x w (a ^ n) = x w a ^ n := by
      intro w a n
      induction n with
      | zero => simp [hxone]
      | succ n ih => rw [pow_succ, hxmul, ih, pow_succ]
    have hxinv : ∀ w (v : (NumberField.RingOfIntegers K)ˣ),
        x w ((v⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
          x w (v : NumberField.RingOfIntegers K) = 1 := by
      intro w v
      rw [← hxmul, Units.inv_mul, hxone]
    have hC : ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v ↔
        ((v : NumberField.RingOfIntegers K) - 1 ∈ q ∧ ∀ w, 0 < x w v) := fun v => Iff.rfl
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hC]
      refine ⟨by simp, fun w => ?_⟩
      rw [Units.val_one, hxone]
      exact one_pos
    · intro v₁ v₂ h₁ h₂
      rw [hC] at h₁ h₂ ⊢
      refine ⟨?_, fun w => ?_⟩
      · have : ((v₁ * v₂ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1
            = (v₁ : NumberField.RingOfIntegers K) * ((v₂ : NumberField.RingOfIntegers K) - 1)
              + ((v₁ : NumberField.RingOfIntegers K) - 1) := by
          rw [Units.val_mul]; ring
        rw [this]
        exact q.add_mem (q.mul_mem_left _ h₂.1) h₁.1
      · rw [Units.val_mul, hxmul]
        exact mul_pos (h₁.2 w) (h₂.2 w)
    · intro v h
      rw [hC] at h ⊢
      refine ⟨?_, fun w => ?_⟩
      · have hv : ((v⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
            * (v : NumberField.RingOfIntegers K) = 1 := Units.inv_mul v
        have : ((v⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1
            = -(((v⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
                * ((v : NumberField.RingOfIntegers K) - 1)) := by
          linear_combination hv
        rw [this]
        exact q.neg_mem (q.mul_mem_left _ h.1)
      · have h1 := hxinv w v
        have h2 := h.2 w
        nlinarith
    · have hfin : Finite (NumberField.RingOfIntegers K ⧸ q) :=
        Ideal.finiteQuotientOfFreeOfNeBot q hq
      set M := Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) with hM
      have hMpos : 0 < M := Nat.card_pos
      refine ⟨2 * M, by omega, fun v => ?_⟩
      rw [hC]
      refine ⟨?_, fun w => ?_⟩
      · have hu := pow_card_eq_one' (G := (NumberField.RingOfIntegers K ⧸ q)ˣ)
          (x := Units.map (Ideal.Quotient.mk q : NumberField.RingOfIntegers K →* _) v)
        rw [← hM] at hu
        have hu' : (Ideal.Quotient.mk q) ((v : NumberField.RingOfIntegers K) ^ M)
            = (Ideal.Quotient.mk q) 1 := by
          have := congrArg Units.val hu
          rw [Units.val_pow_eq_pow_val, Units.coe_map] at this
          rw [map_pow, map_one]
          exact this
        have hM1 : (v : NumberField.RingOfIntegers K) ^ M - 1 ∈ q := Ideal.Quotient.eq.mp hu'
        have : ((v ^ (2 * M) : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
              - 1
            = ((v : NumberField.RingOfIntegers K) ^ M - 1)
              * ((v : NumberField.RingOfIntegers K) ^ M + 1) := by
          rw [Units.val_pow_eq_pow_val]; ring
        rw [this]
        exact q.mul_mem_right _ hM1
      · rw [Units.val_pow_eq_pow_val, hxpow]
        have hne : x w (v : NumberField.RingOfIntegers K) ≠ 0 := by
          intro h0
          have := hxinv w v
          rw [h0, mul_zero] at this
          exact zero_ne_one this
        exact Even.pow_pos ⟨M, by ring⟩ hne
  obtain ⟨h1, hmul, hinv, N, hN, hpow⟩ := s1
  obtain ⟨ℓ, hℓL, hLI, hdec, hℓε⟩ := s3
  have shinv : ∀ v : (NumberField.RingOfIntegers K)ˣ,
      kaiMFUnitShift K v⁻¹ = - kaiMFUnitShift K v := by
    intro v
    have h := shmul v⁻¹ v
    rw [inv_mul_cancel, sh1] at h
    exact eq_neg_of_add_eq_zero_left h.symm
  
  let Λ : AddSubgroup (NumberField.InfinitePlace K → ℝ) :=
    { carrier := {γ | ∃ v, KaiMFCongUnit K q v ∧ kaiMFUnitShift K v = γ}
      zero_mem' := ⟨1, h1, sh1⟩
      add_mem' := by
        rintro _ _ ⟨v₁, h₁, rfl⟩ ⟨v₂, h₂, rfl⟩
        exact ⟨v₁ * v₂, hmul _ _ h₁ h₂, shmul _ _⟩
      neg_mem' := by
        rintro _ ⟨v, h, rfl⟩
        exact ⟨v⁻¹, hinv _ h, shinv v⟩ }
  
  let φ : (Fin (NumberField.Units.rank K) → ℤ) →+ (NumberField.InfinitePlace K → ℝ) :=
    { toFun := fun a => ∑ i, (a i : ℝ) • ℓ i
      map_zero' := by simp
      map_add' := by intro a b; simp [add_smul, Finset.sum_add_distrib] }
  let S : AddSubgroup (Fin (NumberField.Units.rank K) → ℤ) := Λ.comap φ
  have hS : ∀ a : Fin (NumberField.Units.rank K) → ℤ, (fun i => (N : ℤ) * a i) ∈ S := by
    intro a
    show (∑ i, (((N : ℤ) * a i : ℤ) : ℝ) • ℓ i) ∈ Λ
    apply AddSubgroup.sum_mem
    intro i _
    obtain ⟨ε, hε⟩ := hℓε i
    have hNℓ : (N : ℝ) • ℓ i ∈ Λ := by
      refine ⟨ε ^ N, hpow ε, ?_⟩
      rw [← hε, ← zpow_natCast, shzpow]
      simp
    have heq : (((N : ℤ) * a i : ℤ) : ℝ) • ℓ i = (a i : ℝ) • ((N : ℝ) • ℓ i) := by
      rw [smul_smul]; congr 1; push_cast; ring
    rw [heq, Int.cast_smul_eq_zsmul]
    exact Λ.zsmul_mem hNℓ _
  
  obtain ⟨R, hR₀, hRbox⟩ := s4 _ N hN S hS
  have hR : ∀ k : Fin (NumberField.Units.rank K) → ℤ,
      ∃! ρ : Fin (NumberField.Units.rank K) → ℤ,
        ρ ∈ R ∧ (∑ i, ((ρ i - k i : ℤ) : ℝ) • ℓ i) ∈ Λ := hR₀
  have hΛ : ∀ γ ∈ Λ, ∃ a : Fin (NumberField.Units.rank K) → ℤ,
      γ = ∑ i, (a i : ℝ) • ℓ i := by
    rintro _ ⟨v, _, rfl⟩
    exact hdec v
  
  have hn : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by exact_mod_cast Module.finrank_pos
  have hmn : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) = (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
  have hcard : NumberField.Units.rank K + 1 = Fintype.card (NumberField.InfinitePlace K) := by
    have := Fintype.card_pos (α := NumberField.InfinitePlace K)
    unfold NumberField.Units.rank
    omega
  obtain ⟨F, c, hc1, hcount, hmeas, hfund, hslab, hshift⟩ :=
    s5 (NumberField.Units.rank K) N (fun w : NumberField.InfinitePlace K => (w.mult : ℝ))
      (Module.finrank ℚ K : ℝ) hn hmn ℓ hℓL hLI hcard Λ hΛ R hR hRbox
  
  have hfin : Set.Finite {x : (NumberField.RingOfIntegers K)ˣ |
      KaiMFCongUnit K q x ∧ kaiMFUnitShift K x = 0} := by
    have htf : (NumberField.Units.torsion K : Set (NumberField.RingOfIntegers K)ˣ).Finite :=
      Set.finite_coe_iff.mp (inferInstanceAs (Finite (NumberField.Units.torsion K)))
    exact htf.subset (fun x hx => (shker x).1 hx.2)
  have hwq : 0 < Nat.card {x : (NumberField.RingOfIntegers K)ˣ //
      KaiMFCongUnit K q x ∧ kaiMFUnitShift K x = 0} := by
    haveI : Finite {x : (NumberField.RingOfIntegers K)ˣ //
        KaiMFCongUnit K q x ∧ kaiMFUnitShift K x = 0} := hfin.to_subtype
    haveI : Nonempty {x : (NumberField.RingOfIntegers K)ˣ //
        KaiMFCongUnit K q x ∧ kaiMFUnitShift K x = 0} := ⟨⟨1, h1, sh1⟩⟩
    exact Nat.card_pos
  have hfib : ∀ x₀ : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q x₀ →
      Nat.card {x : (NumberField.RingOfIntegers K)ˣ //
        KaiMFCongUnit K q x ∧ kaiMFUnitShift K x = kaiMFUnitShift K x₀}
        = Nat.card {x : (NumberField.RingOfIntegers K)ˣ //
          KaiMFCongUnit K q x ∧ kaiMFUnitShift K x = 0} := by
    intro x₀ hx₀
    apply Nat.card_congr
    exact
      { toFun := fun x => ⟨x.1 * x₀⁻¹, hmul _ _ x.2.1 (hinv _ hx₀), by
          rw [shmul, x.2.2, shinv x₀]; abel⟩
        invFun := fun y => ⟨y.1 * x₀, hmul _ _ y.2.1 hx₀, by rw [shmul, y.2.2, zero_add]⟩
        left_inv := fun x => Subtype.ext (by simp)
        right_inv := fun y => Subtype.ext (by simp) }
  
  refine ⟨Λ, F, c, _, hwq, hc1, hcount, hmeas, hfund, ?_, ?_, ?_, ?_, hshift⟩
  · rintro _ ⟨v, _, rfl⟩
    exact shL v
  · intro v hv
    exact ⟨v, hv, rfl⟩
  · rintro _ ⟨v₀, hv₀, rfl⟩
    exact hfib v₀ hv₀
  · intro u hu w
    exact hslab u hu w

theorem kai_mf_cone_tail_bound (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : KaiMFConeTailProp K :=
by
  classical
  
  have hone : ∀ ρ a L : ℝ, 0 ≤ ρ → 0 < a →
      MeasureTheory.IntegrableOn
        (fun x : ℝ => Real.exp (ρ * |x| - a * Real.exp x))
        (Set.Ici L) MeasureTheory.volume := by
    intro ρ a L hρ ha
    have hcont : Continuous (fun x : ℝ => Real.exp (ρ * |x| - a * Real.exp x)) :=
      Real.continuous_exp.comp
        ((continuous_const.mul continuous_abs).sub (continuous_const.mul Real.continuous_exp))
    have hLM : L ≤ max L 0 := le_max_left _ _
    have hM0 : (0 : ℝ) ≤ max L 0 := le_max_right _ _
    have hIcc : MeasureTheory.IntegrableOn
        (fun x : ℝ => Real.exp (ρ * |x| - a * Real.exp x))
        (Set.Icc L (max L 0)) MeasureTheory.volume := hcont.integrableOn_Icc
    have hIoi : MeasureTheory.IntegrableOn
        (fun x : ℝ => Real.exp (ρ * |x| - a * Real.exp x))
        (Set.Ioi (max L 0)) MeasureTheory.volume := by
      have hdomi : MeasureTheory.IntegrableOn
          (fun x : ℝ => Real.exp ((ρ + 1) ^ 2 / a + ρ * |L|) * Real.exp (-1 * x))
          (Set.Ioi (max L 0)) MeasureTheory.volume :=
        (exp_neg_integrableOn_Ioi (max L 0) (b := 1) one_pos).const_mul _
      refine MeasureTheory.Integrable.mono' hdomi hcont.aestronglyMeasurable ?_
      refine MeasureTheory.ae_restrict_of_forall_mem measurableSet_Ioi ?_
      intro x hx
      have hx0 : (0 : ℝ) ≤ x := le_trans hM0 (le_of_lt hx)
      have habsx : |x| = x := abs_of_nonneg hx0
      have hsq : x ^ 2 / 4 ≤ Real.exp x := by
        have h1 := Real.add_one_le_exp (x / 2)
        have h2 : Real.exp (x / 2) * Real.exp (x / 2) = Real.exp x := by
          rw [← Real.exp_add]; ring_nf
        nlinarith [Real.exp_pos (x / 2)]
      have h3 : (ρ + 1) * x - a / 4 * x ^ 2 ≤ (ρ + 1) ^ 2 / a := by
        rw [le_div_iff₀ ha]
        nlinarith [sq_nonneg ((ρ + 1) - a / 2 * x)]
      have h4 : (0 : ℝ) ≤ ρ * |L| := mul_nonneg hρ (abs_nonneg L)
      have hkey : ρ * |x| - a * Real.exp x ≤ (ρ + 1) ^ 2 / a + ρ * |L| + -1 * x := by
        rw [habsx]
        linarith [mul_le_mul_of_nonneg_left hsq ha.le]
      show ‖Real.exp (ρ * |x| - a * Real.exp x)‖
          ≤ Real.exp ((ρ + 1) ^ 2 / a + ρ * |L|) * Real.exp (-1 * x)
      rw [Real.norm_eq_abs, abs_of_nonneg (Real.exp_pos _).le, ← Real.exp_add]
      exact Real.exp_le_exp.mpr hkey
    have hun := hIcc.union hIoi
    rwa [Set.Icc_union_Ioi_eq_Ici hLM] at hun
  intro Θ δ F θ₀ c e₀ hF hc he₀ hΘ hshape hdec
  have hn0 : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by
    have h : 0 < Module.finrank ℚ K := Module.finrank_pos
    exact_mod_cast h
  have hmult2 : ∀ w : NumberField.InfinitePlace K, (w.mult : ℝ) ≤ 2 := by
    intro w
    have h : w.mult ≤ 2 := by
      simp only [NumberField.InfinitePlace.mult]
      split <;> norm_num
    exact_mod_cast h
  have hTeq : ∀ u : NumberField.InfinitePlace K → ℝ,
      kaiMFLogNorm K u = ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * u w :=
    fun _ => rfl
  have hTcont : Continuous (fun u : NumberField.InfinitePlace K → ℝ => kaiMFLogNorm K u) := by
    simp only [kaiMFLogNorm]
    exact continuous_finset_sum _ (fun w _ => continuous_const.mul (continuous_apply w))
  have hTmeas : Measurable (fun u : NumberField.InfinitePlace K → ℝ => kaiMFLogNorm K u) :=
    hTcont.measurable
  have hSmeas : MeasurableSet
      (F ∩ {u : NumberField.InfinitePlace K → ℝ | θ₀ ≤ kaiMFLogNorm K u}) :=
    hF.inter (measurableSet_le measurable_const hTmeas)
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = θ₀ / (Module.finrank ℚ K : ℝ) - c := ⟨_, rfl⟩
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
      A = e₀ * Real.exp (-c) /
        ((Fintype.card (NumberField.InfinitePlace K) : ℝ) + 1) := ⟨_, rfl⟩
  have hr0 : (0 : ℝ) ≤ (Fintype.card (NumberField.InfinitePlace K) : ℝ) := Nat.cast_nonneg _
  have hA0 : (0 : ℝ) < A := by
    rw [hAdef]
    exact div_pos (mul_pos he₀ (Real.exp_pos _)) (by linarith)
  
  have hG1 : ∀ u ∈ F ∩ {u : NumberField.InfinitePlace K → ℝ | θ₀ ≤ kaiMFLogNorm K u},
      ∀ w : NumberField.InfinitePlace K, L ≤ u w := by
    intro u hu w
    have huF : u ∈ F := hu.1
    have huT : θ₀ ≤ kaiMFLogNorm K u := hu.2
    have h1 := abs_le.mp (hshape u huF w)
    have h2 : θ₀ / (Module.finrank ℚ K : ℝ)
        ≤ kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) := by gcongr
    rw [hLdef]
    linarith [h1.1]
  
  have hG2 : ∀ u ∈ F ∩ {u : NumberField.InfinitePlace K → ℝ | θ₀ ≤ kaiMFLogNorm K u},
      A * (∑ w : NumberField.InfinitePlace K, Real.exp (u w))
        ≤ e₀ * Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)) := by
    intro u hu
    have huF : u ∈ F := hu.1
    have hE0 : (0 : ℝ) < Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)) :=
      Real.exp_pos _
    have hsum : (∑ w : NumberField.InfinitePlace K, Real.exp (u w))
        ≤ (Fintype.card (NumberField.InfinitePlace K) : ℝ) *
            (Real.exp c * Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ))) := by
      have hb : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
          Real.exp (u w)
            ≤ Real.exp c * Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)) := by
        intro w _
        rw [← Real.exp_add]
        refine Real.exp_le_exp.mpr ?_
        have h1 := abs_le.mp (hshape u huF w)
        linarith [h1.2]
      calc (∑ w : NumberField.InfinitePlace K, Real.exp (u w))
          ≤ ∑ _w : NumberField.InfinitePlace K,
              Real.exp c * Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)) :=
            Finset.sum_le_sum hb
        _ = (Fintype.card (NumberField.InfinitePlace K) : ℝ) *
              (Real.exp c * Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ))) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    have hstep : A * (∑ w : NumberField.InfinitePlace K, Real.exp (u w))
        ≤ A * ((Fintype.card (NumberField.InfinitePlace K) : ℝ) *
            (Real.exp c * Real.exp (kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)))) :=
