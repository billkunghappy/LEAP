        ← kai_cell_power_integral K a b ρ σ θ₁ θ₂ hab2 hρσ2 1 one_pos]
      simp [MeasureTheory.Measure.real]
    have hI : ε * ∫ z in kaiCell K a b ρ σ θ₁ θ₂, (NumberField.mixedEmbedding.norm z) ^ (β - 1)
        = ε * ((∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (θ₂ p - θ₁ p)) *
          (Rq / 2 ^ NumberField.InfinitePlace.nrComplexPlaces K *
            (kaiTBShapePow K H a b ρ σ β / β))) := by
      by_cases hε0 : ε = 0
      · rw [hε0, zero_mul, zero_mul]
      · have hβ0 : 0 < β := by linarith [(hεβ.resolve_left hε0).1]
        rw [kai_shape_power_eval K B q hq H wq Rq e hdata a b ρ σ hab2 hρσ3 β hβ0,
          kai_cell_power_integral K a b ρ σ θ₁ θ₂ hab2 hρσ2 β hβ0]
    have halg : ∀ tw Rq' Θ S1 Sb t1 pr hc Rg Phi t2 ε' β' : ℝ,
        tw / (t1 * pr * hc * Rg) / Phi * (Θ * (Rq' / t2 * (S1 / 1))
          - ε' * (Θ * (Rq' / t2 * (Sb / β'))))
        = Θ / (t2 * pr) * (tw * Rq' / (t1 * hc * Phi * Rg)) * (S1 - ε' * (Sb / β')) := by
      intros; ring
    have hdict : κφ * ((MeasureTheory.volume (kaiCell K a b ρ σ θ₁ θ₂)).toReal
        - ε * ∫ z in kaiCell K a b ρ σ θ₁ θ₂, (NumberField.mixedEmbedding.norm z) ^ (β - 1))
        = (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (θ₂ p - θ₁ p)) /
            (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
          (((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
            (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
              (NumberField.classNumber K : ℝ) *
              (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
              NumberField.Units.regulator K)) *
          (kaiTBShapePow K H a b ρ σ 1 - ε * (kaiTBShapePow K H a b ρ σ β / β)) := by
      rw [hV1, hI, hκφ]
      unfold kaiKappa0
      rw [mul_pow]
      exact halg _ _ _ _ _ _ _ _ _ _ _ _ _
    rw [hdict]
    refine hcell.trans ?_
    have hexp : Real.exp (-Real.sqrt (Real.log X) / c₄)
        ≤ Real.exp (-(Real.log X ^ ((1:ℝ)/4))) := by
      apply Real.exp_le_exp.mpr
      rw [← hℓ, ← hs, ← hr, neg_div, neg_le_neg_iff, le_div_iff₀ hc₄, hsr]
      nlinarith [mul_le_mul_of_nonneg_left hrc hr0]
    calc c₄ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₄)
        ≤ c₄ * X ^ (Module.finrank ℚ K) * Real.exp (-(Real.log X ^ ((1:ℝ)/4))) :=
          mul_le_mul_of_nonneg_left hexp (by positivity)
      _ ≤ max c₄ (Bnd * Real.exp (Real.log X₁ ^ ((1:ℝ)/4))) * X ^ (Module.finrank ℚ K) *
          Real.exp (-(Real.log X ^ ((1:ℝ)/4))) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (le_max_left _ _) (by positivity)) (Real.exp_pos _).le

theorem kai_cvx_cell_partition (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (X : ℝ) (hX : 0 < X) (Q : ℕ) (hQ : 1 ≤ Q) :
    ∃ (m : ℕ) (a b : Fin m → {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
      (ρ σ ψ χ : Fin m → {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
      m ≤ 7 ^ (Module.finrank ℚ K) * Q ^ (Module.finrank ℚ K) ∧
      (∀ i w, -X ≤ a i w ∧ a i w < b i w ∧ b i w ≤ X ∧ (0 ≤ a i w ∨ b i w ≤ 0) ∧
          b i w - a i w = X / (Q : ℝ)) ∧
      (∀ i w, 0 ≤ ρ i w ∧ ρ i w < σ i w ∧ σ i w ≤ X ∧ σ i w - ρ i w = X / (Q : ℝ) ∧
          -Real.pi ≤ ψ i w ∧ ψ i w < χ i w ∧ χ i w ≤ Real.pi) ∧
      (∀ i, MeasurableSet (kaiCell K (a i) (b i) (ρ i) (σ i) (ψ i) (χ i))) ∧
      (∀ i, MeasureTheory.volume (kaiCell K (a i) (b i) (ρ i) (σ i) (ψ i) (χ i)) ≠ ⊤) ∧
      (∀ i j, i ≠ j → Disjoint (kaiCell K (a i) (b i) (ρ i) (σ i) (ψ i) (χ i))
          (kaiCell K (a j) (b j) (ρ j) (σ j) (ψ j) (χ j))) ∧
      (∀ i, ∀ z ∈ kaiCell K (a i) (b i) (ρ i) (σ i) (ψ i) (χ i),
          ∀ z' ∈ kaiCell K (a i) (b i) (ρ i) (σ i) (ψ i) (χ i),
          ‖z - z'‖ ≤ 4 * (X / (Q : ℝ))) ∧
      (∀ z : NumberField.mixedEmbedding.mixedSpace K,
          (∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          (∀ w : NumberField.InfinitePlace K,
              0 < NumberField.mixedEmbedding.normAtPlace w z) →
          ∃ i, z ∈ kaiCell K (a i) (b i) (ρ i) (σ i) (ψ i) (χ i)) ∧
      MeasureTheory.volume ({z : NumberField.mixedEmbedding.mixedSpace K |
          ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X} \
          ⋃ i, kaiCell K (a i) (b i) (ρ i) (σ i) (ψ i) (χ i)) = 0 :=
by
  classical
  
  have cell_diam : ∀ (X δ η : ℝ) (hX : 0 ≤ X) (hδ : 0 ≤ δ) (hη0 : 0 ≤ η) (hη1 : η ≤ 1)
      (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
      (ρ σ ψ χ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
      (hab : ∀ w, b w - a w ≤ δ)
      (hρσ : ∀ w, σ w - ρ w ≤ δ)
      (hσX : ∀ w, σ w ≤ X)
      (hψχ : ∀ w, χ w - ψ w ≤ η)
      (z z' : NumberField.mixedEmbedding.mixedSpace K)
      (hz : z ∈ kaiCell K a b ρ σ ψ χ)
      (hz' : z' ∈ kaiCell K a b ρ σ ψ χ),
      ‖z - z'‖ ≤ δ + 2 * X * η := by
    intro X δ η hX hδ hη0 hη1 a b ρ σ ψ χ hab hρσ hσX hψχ z z' hz hz'
    have hXeta : (0:ℝ) ≤ 2 * X * η := by
      have h := mul_nonneg hX hη0
      linarith
    have hr : (0:ℝ) ≤ δ + 2 * X * η := by linarith
    have hchord : ∀ t t' : ℝ, |t - t'| ≤ 1 →
        ‖Complex.exp ((t : ℂ) * Complex.I) - Complex.exp ((t' : ℂ) * Complex.I)‖
          ≤ 2 * |t - t'| := by
      intro t t' h
      have hexpo : ((t' : ℂ) * Complex.I) + (((t - t' : ℝ) : ℂ) * Complex.I)
          = (t : ℂ) * Complex.I := by push_cast; ring
      have hfac : Complex.exp ((t : ℂ) * Complex.I) - Complex.exp ((t' : ℂ) * Complex.I)
          = Complex.exp ((t' : ℂ) * Complex.I)
              * (Complex.exp (((t - t' : ℝ) : ℂ) * Complex.I) - 1) := by
        rw [mul_sub, ← Complex.exp_add, hexpo, mul_one]
      have hx : ‖((t - t' : ℝ) : ℂ) * Complex.I‖ = |t - t'| := by
        rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
      have hxle : ‖((t - t' : ℝ) : ℂ) * Complex.I‖ ≤ 1 := by rw [hx]; exact h
      have hb := Complex.norm_exp_sub_one_le hxle
      rw [hx] at hb
      rw [hfac, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
      exact hb
    have hpolar : ∀ u v : ℂ, ‖u - v‖ ≤ |‖u‖ - ‖v‖| +
        ‖v‖ * ‖Complex.exp ((u.arg : ℂ) * Complex.I)
                - Complex.exp ((v.arg : ℂ) * Complex.I)‖ := by
      intro u v
      have hu := Complex.norm_mul_exp_arg_mul_I u
      have hv := Complex.norm_mul_exp_arg_mul_I v
      have hexp2 : ((‖u‖ - ‖v‖ : ℝ) : ℂ) * Complex.exp ((u.arg : ℂ) * Complex.I)
            + ((‖v‖ : ℝ) : ℂ) * (Complex.exp ((u.arg : ℂ) * Complex.I)
                - Complex.exp ((v.arg : ℂ) * Complex.I))
          = ((‖u‖ : ℝ) : ℂ) * Complex.exp ((u.arg : ℂ) * Complex.I)
            - ((‖v‖ : ℝ) : ℂ) * Complex.exp ((v.arg : ℂ) * Complex.I) := by
        push_cast; ring
      have hid : u - v
          = ((‖u‖ - ‖v‖ : ℝ) : ℂ) * Complex.exp ((u.arg : ℂ) * Complex.I)
            + ((‖v‖ : ℝ) : ℂ) * (Complex.exp ((u.arg : ℂ) * Complex.I)
                - Complex.exp ((v.arg : ℂ) * Complex.I)) := by
        rw [hexp2, hu, hv]
      have e1 : ‖((‖u‖ - ‖v‖ : ℝ) : ℂ) * Complex.exp ((u.arg : ℂ) * Complex.I)‖
          = |‖u‖ - ‖v‖| := by
        rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one, Complex.norm_real,
          Real.norm_eq_abs]
      have e2 : ‖((‖v‖ : ℝ) : ℂ) * (Complex.exp ((u.arg : ℂ) * Complex.I)
              - Complex.exp ((v.arg : ℂ) * Complex.I))‖
          = ‖v‖ * ‖Complex.exp ((u.arg : ℂ) * Complex.I)
              - Complex.exp ((v.arg : ℂ) * Complex.I)‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (norm_nonneg v)]
      rw [hid]
      refine le_trans (norm_add_le _ _) ?_
      exact le_of_eq (by rw [e1, e2])
    simp only [kaiCell, Set.mem_setOf_eq] at hz hz'
    obtain ⟨hzR, hzC⟩ := hz
    obtain ⟨hzR', hzC'⟩ := hz'
    rw [Prod.norm_def]
    refine max_le ?_ ?_
    · rw [pi_norm_le_iff_of_nonneg hr]
      intro w
      obtain ⟨h1, h2⟩ := hzR w
      obtain ⟨h1', h2'⟩ := hzR' w
      have h3 := hab w
      simp only [Prod.fst_sub, Pi.sub_apply, Real.norm_eq_abs]
      rw [abs_sub_le_iff]
      constructor <;> linarith
    · rw [pi_norm_le_iff_of_nonneg hr]
      intro w
      simp only [Prod.snd_sub, Pi.sub_apply]
      obtain ⟨g1, g2, g3, g4⟩ := hzC w
      obtain ⟨g1', g2', g3', g4'⟩ := hzC' w
      have hrad : |‖z.2 w‖ - ‖z'.2 w‖| ≤ δ := by
        rw [abs_sub_le_iff]
        constructor <;> linarith [hρσ w]
      have hang : |(z.2 w).arg - (z'.2 w).arg| ≤ η := by
        rw [abs_sub_le_iff]
        constructor <;> linarith [hψχ w]
      have hang1 : |(z.2 w).arg - (z'.2 w).arg| ≤ 1 := le_trans hang hη1
      have hD := hchord (z.2 w).arg (z'.2 w).arg hang1
      have hD2 : ‖Complex.exp (((z.2 w).arg : ℂ) * Complex.I)
          - Complex.exp (((z'.2 w).arg : ℂ) * Complex.I)‖ ≤ 2 * η := by linarith
      have hvX : ‖z'.2 w‖ ≤ X := le_trans g2' (hσX w)
      have hmul : ‖z'.2 w‖ * ‖Complex.exp (((z.2 w).arg : ℂ) * Complex.I)
          - Complex.exp (((z'.2 w).arg : ℂ) * Complex.I)‖ ≤ X * (2 * η) :=
        mul_le_mul hvX hD2 (norm_nonneg _) hX
      have hpol := hpolar (z.2 w) (z'.2 w)
      linarith
  
  have cell_meas : ∀ (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
      (ρ σ ψ χ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
      MeasurableSet (kaiCell K a b ρ σ ψ χ) := by
    intro a b ρ σ ψ χ
    have hRc : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        Measurable (fun z : NumberField.mixedEmbedding.mixedSpace K => z.1 w) :=
      fun w => (measurable_pi_apply w).comp' measurable_fst
    have hCc : ∀ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        Measurable (fun z : NumberField.mixedEmbedding.mixedSpace K => z.2 w) :=
      fun w => (measurable_pi_apply w).comp' measurable_snd
    have hNc : ∀ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        Measurable (fun z : NumberField.mixedEmbedding.mixedSpace K => ‖z.2 w‖) :=
      fun w => (hCc w).norm
    have hAc : ∀ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        Measurable (fun z : NumberField.mixedEmbedding.mixedSpace K => (z.2 w).arg) :=
      fun w => Complex.measurable_arg.comp' (hCc w)
    have key : kaiCell K a b ρ σ ψ χ =
        ((⋂ w : {w : NumberField.InfinitePlace K // w.IsReal},
            {z : NumberField.mixedEmbedding.mixedSpace K | a w < z.1 w}) ∩
          (⋂ w : {w : NumberField.InfinitePlace K // w.IsReal},
            {z : NumberField.mixedEmbedding.mixedSpace K | z.1 w ≤ b w})) ∩
        (((⋂ w : {w : NumberField.InfinitePlace K // w.IsComplex},
            {z : NumberField.mixedEmbedding.mixedSpace K | ρ w < ‖z.2 w‖}) ∩
          (⋂ w : {w : NumberField.InfinitePlace K // w.IsComplex},
            {z : NumberField.mixedEmbedding.mixedSpace K | ‖z.2 w‖ ≤ σ w})) ∩
         ((⋂ w : {w : NumberField.InfinitePlace K // w.IsComplex},
            {z : NumberField.mixedEmbedding.mixedSpace K | ψ w < (z.2 w).arg}) ∩
          (⋂ w : {w : NumberField.InfinitePlace K // w.IsComplex},
            {z : NumberField.mixedEmbedding.mixedSpace K | (z.2 w).arg ≤ χ w}))) := by
      ext z
      simp only [kaiCell, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨⟨fun w => (h1 w).1, fun w => (h1 w).2⟩,
          ⟨⟨fun w => (h2 w).1, fun w => (h2 w).2.1⟩,
            ⟨fun w => (h2 w).2.2.1, fun w => (h2 w).2.2.2⟩⟩⟩
      · rintro ⟨⟨g1, g2⟩, ⟨⟨g3, g4⟩, ⟨g5, g6⟩⟩⟩
        exact ⟨fun w => ⟨g1 w, g2 w⟩, fun w => ⟨g3 w, g4 w, g5 w, g6 w⟩⟩
    rw [key]
    exact
      ((MeasurableSet.iInter fun w => measurableSet_lt measurable_const (hRc w)).inter
          (MeasurableSet.iInter fun w => measurableSet_le (hRc w) measurable_const)).inter
        (((MeasurableSet.iInter fun w => measurableSet_lt measurable_const (hNc w)).inter
            (MeasurableSet.iInter fun w => measurableSet_le (hNc w) measurable_const)).inter
          ((MeasurableSet.iInter fun w => measurableSet_lt measurable_const (hAc w)).inter
            (MeasurableSet.iInter fun w => measurableSet_le (hAc w) measurable_const)))
  
  have cell_vol : ∀ (X : ℝ) (hX : 0 ≤ X)
      (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
      (ρ σ ψ χ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ)
      (ha : ∀ w, -X ≤ a w) (hb : ∀ w, b w ≤ X) (hσ : ∀ w, σ w ≤ X),
      MeasureTheory.volume (kaiCell K a b ρ σ ψ χ) ≠ ⊤ := by
    intro X hX a b ρ σ ψ χ ha hb hσ
    have hball : MeasureTheory.volume
        (Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) X) ≠ ⊤ :=
      MeasureTheory.measure_closedBall_lt_top.ne
    refine ne_top_of_le_ne_top hball (MeasureTheory.measure_mono ?_)
    intro z hz
    simp only [kaiCell, Set.mem_setOf_eq] at hz
    obtain ⟨h₁, h₂⟩ := hz
    rw [mem_closedBall_zero_iff, Prod.norm_def]
    refine max_le ?_ ?_
    · rw [pi_norm_le_iff_of_nonneg hX]
      intro w
      rw [Real.norm_eq_abs, abs_le]
      exact ⟨le_trans (ha w) (h₁ w).1.le, le_trans (h₁ w).2 (hb w)⟩
    · rw [pi_norm_le_iff_of_nonneg hX]
      intro w
      exact le_trans (h₂ w).2.1 (hσ w)
  
  have zero_null : MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
      ∃ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z = 0} = 0 := by
    have hfst : ∀ u : {w : NumberField.InfinitePlace K // w.IsReal},
        MeasureTheory.volume
          {z : NumberField.mixedEmbedding.mixedSpace K | z.1 u = 0} = 0 := by
      intro u
      have hA : MeasureTheory.volume
          {x : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ | x u = 0} = 0 := by
        rw [MeasureTheory.volume_pi]
        exact MeasureTheory.Measure.pi_hyperplane
          (fun _ : {w : NumberField.InfinitePlace K // w.IsReal} => MeasureTheory.volume) u 0
      have hset : {z : NumberField.mixedEmbedding.mixedSpace K | z.1 u = 0}
          = {x : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ | x u = 0} ×ˢ
              (Set.univ : Set ({w : NumberField.InfinitePlace K // w.IsComplex} → ℂ)) := by
        rw [Set.prod_univ]
        rfl
      rw [hset, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod, hA,
        zero_mul]
    have hsnd : ∀ u : {w : NumberField.InfinitePlace K // w.IsComplex},
        MeasureTheory.volume
          {z : NumberField.mixedEmbedding.mixedSpace K | z.2 u = 0} = 0 := by
      intro u
      have hB : MeasureTheory.volume
          {y : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ | y u = 0} = 0 := by
        rw [MeasureTheory.volume_pi]
        exact MeasureTheory.Measure.pi_hyperplane
          (fun _ : {w : NumberField.InfinitePlace K // w.IsComplex} => MeasureTheory.volume) u 0
      have hset : {z : NumberField.mixedEmbedding.mixedSpace K | z.2 u = 0}
          = (Set.univ : Set ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ)) ×ˢ
              {y : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ | y u = 0} := by
        rw [Set.univ_prod]
        rfl
      rw [hset, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod, hB,
        mul_zero]
    have hunion : {z : NumberField.mixedEmbedding.mixedSpace K |
          ∃ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w z = 0}
        = ⋃ w : NumberField.InfinitePlace K,
            {z : NumberField.mixedEmbedding.mixedSpace K |
              NumberField.mixedEmbedding.normAtPlace w z = 0} :=
      Set.setOf_exists (fun (w : NumberField.InfinitePlace K)
        (z : NumberField.mixedEmbedding.mixedSpace K) =>
          NumberField.mixedEmbedding.normAtPlace w z = 0)
    rw [hunion]
    refine MeasureTheory.measure_iUnion_null (fun w => ?_)
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · have hEq : {z : NumberField.mixedEmbedding.mixedSpace K |
            NumberField.mixedEmbedding.normAtPlace w z = 0}
          = {z : NumberField.mixedEmbedding.mixedSpace K | z.1 ⟨w, hw⟩ = 0} := by
        ext z
        simp only [Set.mem_setOf_eq,
          NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw, norm_eq_zero]
      rw [hEq]
      exact hfst ⟨w, hw⟩
    · have hEq : {z : NumberField.mixedEmbedding.mixedSpace K |
            NumberField.mixedEmbedding.normAtPlace w z = 0}
          = {z : NumberField.mixedEmbedding.mixedSpace K | z.2 ⟨w, hw⟩ = 0} := by
        ext z
        simp only [Set.mem_setOf_eq,
          NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw, norm_eq_zero]
      rw [hEq]
      exact hsnd ⟨w, hw⟩
  
  have hQ0 : (0:ℝ) < (Q:ℝ) := by exact_mod_cast hQ
  have hQ1 : (1:ℝ) ≤ (Q:ℝ) := by exact_mod_cast hQ
  have hπ0 : (0:ℝ) < Real.pi := Real.pi_pos
  set δ : ℝ := X / (Q:ℝ) with hδdef
  have hδ0 : (0:ℝ) < δ := by rw [hδdef]; exact div_pos hX hQ0
  have hQδ : (Q:ℝ) * δ = X := by rw [hδdef]; field_simp
  set τ : ℝ := Real.pi / (4 * (Q:ℝ)) with hτdef
  have hτ0 : (0:ℝ) < τ := by rw [hτdef]; exact div_pos hπ0 (by linarith)
  have hQτ : 4 * ((Q:ℝ) * τ) = Real.pi := by rw [hτdef]; field_simp
  have h8τ : 8 * (Q:ℝ) * τ = 2 * Real.pi := by linear_combination 2 * hQτ
  have hτ1 : τ ≤ 1 := by
    rw [hτdef, div_le_one (by linarith : (0:ℝ) < 4 * (Q:ℝ))]
    linarith [Real.pi_le_four]
  
  have grid_ex : ∀ (c t g : ℝ) (n : ℕ), 0 < g → c < t → t ≤ c + (n : ℝ) * g →
      ∃ k : ℕ, k < n ∧ c + (k : ℝ) * g < t ∧ t ≤ c + ((k : ℝ) + 1) * g := by
    intro c t g n hg hct htn
    have hs0 : (0:ℝ) < (t - c) / g := div_pos (by linarith) hg
    have hsn : (t - c) / g ≤ (n:ℝ) := by rw [div_le_iff₀ hg]; linarith
    have hK1 : (1:ℤ) ≤ ⌈(t - c) / g⌉ := by
      have h := Int.lt_ceil.mpr (show ((0:ℤ):ℝ) < (t - c) / g by exact_mod_cast hs0)
      omega
    have hKn : ⌈(t - c) / g⌉ ≤ (n:ℤ) := Int.ceil_le.mpr (by exact_mod_cast hsn)
    obtain ⟨k, hkv⟩ : ∃ k : ℕ, (k:ℤ) = ⌈(t - c) / g⌉ - 1 :=
      ⟨(⌈(t - c) / g⌉ - 1).toNat, Int.toNat_of_nonneg (by omega)⟩
    have hkn : k < n := by omega
    have hkr : (k:ℝ) = ((⌈(t - c) / g⌉ : ℤ) : ℝ) - 1 := by exact_mod_cast hkv
    have hlt : (k:ℝ) < (t - c) / g := by
      have h := Int.ceil_lt_add_one ((t - c) / g)
      rw [hkr]; linarith
    have hle : (t - c) / g ≤ (k:ℝ) + 1 := by
      have h := Int.le_ceil ((t - c) / g)
      rw [hkr]; linarith
    refine ⟨k, hkn, ?_, ?_⟩
    · rw [lt_div_iff₀ hg] at hlt; linarith
    · rw [div_le_iff₀ hg] at hle; linarith
  have grid_uniq : ∀ (c g : ℝ) (k k' : ℕ) (t : ℝ), 0 < g →
      c + (k:ℝ) * g < t → t ≤ c + ((k:ℝ) + 1) * g →
      c + (k':ℝ) * g < t → t ≤ c + ((k':ℝ) + 1) * g → k = k' := by
    intro c g k k' t hg h1 h2 h3 h4
    by_contra hne
    rcases Nat.lt_or_ge k k' with h | h
    · have hc : (k:ℝ) + 1 ≤ (k':ℝ) := by exact_mod_cast Nat.succ_le_of_lt h
      nlinarith [mul_le_mul_of_nonneg_right hc hg.le]
    · have h' : k' < k := lt_of_le_of_ne h (fun hh => hne hh.symm)
      have hc : (k':ℝ) + 1 ≤ (k:ℝ) := by exact_mod_cast Nat.succ_le_of_lt h'
      nlinarith [mul_le_mul_of_nonneg_right hc hg.le]
  have hRnorm : ∀ (w : {w : NumberField.InfinitePlace K // w.IsReal})
      (y : NumberField.mixedEmbedding.mixedSpace K),
      NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K) y
        = |y.1 w| := by
    intro w y
    rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
    simp [Real.norm_eq_abs]
  have hCnorm : ∀ (w : {w : NumberField.InfinitePlace K // w.IsComplex})
      (y : NumberField.mixedEmbedding.mixedSpace K),
      NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K) y
        = ‖y.2 w‖ := by
    intro w y
    rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
  
  obtain ⟨m, e, hmle⟩ : ∃ (m : ℕ) (e : Fin m ≃
      ((({w : NumberField.InfinitePlace K // w.IsReal} → Fin (2 * Q)) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → Fin Q) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → Fin (8 * Q))))),
      m ≤ 7 ^ (Module.finrank ℚ K) * Q ^ (Module.finrank ℚ K) := by
    refine ⟨Fintype.card ((({w : NumberField.InfinitePlace K // w.IsReal} → Fin (2 * Q)) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → Fin Q) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → Fin (8 * Q)))),
      (Fintype.equivFin _).symm, ?_⟩
    have h1 : Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
        = NumberField.InfinitePlace.nrRealPlaces K := by
      rw [NumberField.InfinitePlace.nrRealPlaces.eq_def]
      simp only [Fintype.card_eq_nat_card]
    have h2 : Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}
        = NumberField.InfinitePlace.nrComplexPlaces K := by
      rw [NumberField.InfinitePlace.nrComplexPlaces.eq_def]
      simp only [Fintype.card_eq_nat_card]
    have hbridge : Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
        + 2 * Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}
        = Module.finrank ℚ K := by
      rw [h1, h2, NumberField.InfinitePlace.card_add_two_mul_card_eq_rank]
    have arith : ∀ r1 r2 : ℕ,
        (2 * Q) ^ r1 * (Q ^ r2 * (8 * Q) ^ r2) ≤ 7 ^ (r1 + 2 * r2) * Q ^ (r1 + 2 * r2) := by
      intro r1 r2
      have e1 : (7:ℕ) ^ (r1 + 2 * r2) * Q ^ (r1 + 2 * r2)
          = (7 * Q) ^ r1 * ((7 * Q) ^ 2) ^ r2 := by
        rw [← mul_pow, pow_add, pow_mul]
      have e2 : Q ^ r2 * (8 * Q) ^ r2 = (8 * (Q * Q)) ^ r2 := by
        rw [← mul_pow]; congr 1; ring
      have e3 : (2 * Q) ^ r1 ≤ (7 * Q) ^ r1 := Nat.pow_le_pow_left (by omega) _
      have e4 : (8 * (Q * Q)) ^ r2 ≤ ((7 * Q) ^ 2) ^ r2 := by
        apply Nat.pow_le_pow_left
        have h : (7 * Q) ^ 2 = 49 * (Q * Q) := by ring
        rw [h]
        exact Nat.mul_le_mul (by norm_num) (le_refl _)
      calc (2 * Q) ^ r1 * (Q ^ r2 * (8 * Q) ^ r2)
            = (2 * Q) ^ r1 * (8 * (Q * Q)) ^ r2 := by rw [e2]
        _ ≤ (7 * Q) ^ r1 * ((7 * Q) ^ 2) ^ r2 := Nat.mul_le_mul e3 e4
        _ = 7 ^ (r1 + 2 * r2) * Q ^ (r1 + 2 * r2) := e1.symm
    have hcard : Fintype.card ((({w : NumberField.InfinitePlace K // w.IsReal} → Fin (2 * Q)) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → Fin Q) ×
        ({w : NumberField.InfinitePlace K // w.IsComplex} → Fin (8 * Q))))
        = (2 * Q) ^ (Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}) *
          (Q ^ (Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}) *
            (8 * Q) ^ (Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex})) := by
      rw [Fintype.card_prod, Fintype.card_prod, Fintype.card_fun, Fintype.card_fun,
        Fintype.card_fun, Fintype.card_fin, Fintype.card_fin, Fintype.card_fin]
    rw [hcard, ← hbridge]
    exact arith _ _
  
  obtain ⟨A, B, P, S, Ps, C, hA, hB, hP, hS, hPs, hC⟩ :
      ∃ (A B : Fin m → {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
        (P S Ps C : Fin m → {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
        (∀ i w, A i w = -X + (((e i).1 w : ℕ) : ℝ) * δ) ∧
        (∀ i w, B i w = -X + ((((e i).1 w : ℕ) : ℝ) + 1) * δ) ∧
        (∀ i w, P i w = (((e i).2.1 w : ℕ) : ℝ) * δ) ∧
        (∀ i w, S i w = ((((e i).2.1 w : ℕ) : ℝ) + 1) * δ) ∧
        (∀ i w, Ps i w = -Real.pi + (((e i).2.2 w : ℕ) : ℝ) * τ) ∧
        (∀ i w, C i w = -Real.pi + ((((e i).2.2 w : ℕ) : ℝ) + 1) * τ) :=
    ⟨fun i w => -X + (((e i).1 w : ℕ) : ℝ) * δ,
     fun i w => -X + ((((e i).1 w : ℕ) : ℝ) + 1) * δ,
     fun i w => (((e i).2.1 w : ℕ) : ℝ) * δ,
     fun i w => ((((e i).2.1 w : ℕ) : ℝ) + 1) * δ,
     fun i w => -Real.pi + (((e i).2.2 w : ℕ) : ℝ) * τ,
     fun i w => -Real.pi + ((((e i).2.2 w : ℕ) : ℝ) + 1) * τ,
     fun _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl,
     fun _ _ => rfl⟩
  have hjlt : ∀ (i : Fin m) (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (((e i).1 w : ℕ) : ℝ) + 1 ≤ 2 * (Q:ℝ) := by
    intro i w
    have h : ((e i).1 w : ℕ) < 2 * Q := ((e i).1 w).isLt
    have h' : ((e i).1 w : ℕ) + 1 ≤ 2 * Q := h
    exact_mod_cast h'
  have hklt : ∀ (i : Fin m) (w : {w : NumberField.InfinitePlace K // w.IsComplex}),
      (((e i).2.1 w : ℕ) : ℝ) + 1 ≤ (Q:ℝ) := by
    intro i w
    have h : ((e i).2.1 w : ℕ) < Q := ((e i).2.1 w).isLt
    have h' : ((e i).2.1 w : ℕ) + 1 ≤ Q := h
    exact_mod_cast h'
  have hllt : ∀ (i : Fin m) (w : {w : NumberField.InfinitePlace K // w.IsComplex}),
      (((e i).2.2 w : ℕ) : ℝ) + 1 ≤ 8 * (Q:ℝ) := by
    intro i w
    have h : ((e i).2.2 w : ℕ) < 8 * Q := ((e i).2.2 w).isLt
    have h' : ((e i).2.2 w : ℕ) + 1 ≤ 8 * Q := h
    exact_mod_cast h'
  have hP2 : ∀ (i : Fin m) (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      -X ≤ A i w ∧ A i w < B i w ∧ B i w ≤ X ∧ (0 ≤ A i w ∨ B i w ≤ 0) ∧
        B i w - A i w = δ := by
    intro i w
    have hj := hjlt i w
    have hj0 : (0:ℝ) ≤ (((e i).1 w : ℕ) : ℝ) := Nat.cast_nonneg _
    rw [hA, hB]
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · linarith [mul_nonneg hj0 hδ0.le]
    · linarith [hδ0]
    · linarith [mul_le_mul_of_nonneg_right hj hδ0.le, hQδ]
    · rcases Nat.lt_or_ge ((e i).1 w : ℕ) Q with h | h
      · right
        have h' : (((e i).1 w : ℕ) : ℝ) + 1 ≤ (Q:ℝ) := by
          exact_mod_cast Nat.succ_le_of_lt h
        linarith [mul_le_mul_of_nonneg_right h' hδ0.le, hQδ]
      · left
        have h' : (Q:ℝ) ≤ (((e i).1 w : ℕ) : ℝ) := by exact_mod_cast h
        linarith [mul_le_mul_of_nonneg_right h' hδ0.le, hQδ]
    · ring
  have hP3 : ∀ (i : Fin m) (w : {w : NumberField.InfinitePlace K // w.IsComplex}),
      0 ≤ P i w ∧ P i w < S i w ∧ S i w ≤ X ∧ S i w - P i w = δ ∧
        -Real.pi ≤ Ps i w ∧ Ps i w < C i w ∧ C i w ≤ Real.pi := by
    intro i w
    have hk := hklt i w
    have hk0 : (0:ℝ) ≤ (((e i).2.1 w : ℕ) : ℝ) := Nat.cast_nonneg _
    have hl := hllt i w
    have hl0 : (0:ℝ) ≤ (((e i).2.2 w : ℕ) : ℝ) := Nat.cast_nonneg _
    rw [hP, hS, hPs, hC]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact mul_nonneg hk0 hδ0.le
    · linarith [hδ0]
    · linarith [mul_le_mul_of_nonneg_right hk hδ0.le, hQδ]
    · ring
    · linarith [mul_nonneg hl0 hτ0.le]
    · linarith [hτ0]
    · linarith [mul_le_mul_of_nonneg_right hl hτ0.le, h8τ]
  
  have hP4 : ∀ i : Fin m,
      MeasurableSet (kaiCell K (A i) (B i) (P i) (S i) (Ps i) (C i)) :=
    fun i => cell_meas (A i) (B i) (P i) (S i) (Ps i) (C i)
  have hP5 : ∀ i : Fin m,
      MeasureTheory.volume (kaiCell K (A i) (B i) (P i) (S i) (Ps i) (C i)) ≠ ⊤ :=
    fun i => cell_vol X hX.le (A i) (B i) (P i) (S i) (Ps i) (C i)
      (fun w => (hP2 i w).1) (fun w => (hP2 i w).2.2.1) (fun w => (hP3 i w).2.2.1)
  
  have hP6 : ∀ i j : Fin m, i ≠ j →
      Disjoint (kaiCell K (A i) (B i) (P i) (S i) (Ps i) (C i))
        (kaiCell K (A j) (B j) (P j) (S j) (Ps j) (C j)) := by
    intro i j hij
    rw [Set.disjoint_left]
    intro z hzi hzj
    simp only [kaiCell, Set.mem_setOf_eq] at hzi hzj
    obtain ⟨hzi1, hzi2⟩ := hzi
    obtain ⟨hzj1, hzj2⟩ := hzj
    apply hij
    apply e.injective
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · funext w
      apply Fin.val_injective
      have hi := hzi1 w
      have hj := hzj1 w
      rw [hA, hB] at hi
      rw [hA, hB] at hj
      exact grid_uniq (-X) δ ((e i).1 w : ℕ) ((e j).1 w : ℕ) (z.1 w) hδ0
        hi.1 hi.2 hj.1 hj.2
    · funext w
      apply Fin.val_injective
      have hi := hzi2 w
      have hj := hzj2 w
      rw [hP, hS] at hi
      rw [hP, hS] at hj
      exact grid_uniq 0 δ ((e i).2.1 w : ℕ) ((e j).2.1 w : ℕ) ‖z.2 w‖ hδ0
        (by linarith [hi.1]) (by linarith [hi.2.1])
        (by linarith [hj.1]) (by linarith [hj.2.1])
    · funext w
      apply Fin.val_injective
      have hi := hzi2 w
      have hj := hzj2 w
      rw [hPs, hC] at hi
      rw [hPs, hC] at hj
      exact grid_uniq (-Real.pi) τ ((e i).2.2 w : ℕ) ((e j).2.2 w : ℕ) ((z.2 w).arg) hτ0
        hi.2.2.1 hi.2.2.2 hj.2.2.1 hj.2.2.2
  
  have hP7 : ∀ i : Fin m, ∀ z ∈ kaiCell K (A i) (B i) (P i) (S i) (Ps i) (C i),
      ∀ z' ∈ kaiCell K (A i) (B i) (P i) (S i) (Ps i) (C i), ‖z - z'‖ ≤ 4 * δ := by
    intro i z hz z' hz'
    have hangeq : ∀ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        C i w - Ps i w = τ := by
      intro w; rw [hPs, hC]; ring
    have hdiam := cell_diam X δ τ hX.le hδ0.le hτ0.le hτ1
      (A i) (B i) (P i) (S i) (Ps i) (C i)
      (fun w => le_of_eq (hP2 i w).2.2.2.2)
      (fun w => le_of_eq (hP3 i w).2.2.2.1)
      (fun w => (hP3 i w).2.2.1)
      (fun w => le_of_eq (hangeq w))
      z z' hz hz'
    have hh : 2 * X * τ = δ * (Real.pi / 2) := by
      rw [← hQδ]; linear_combination (δ / 2) * hQτ
    have h2 : 2 * X * τ ≤ 3 * δ := by
      rw [hh]
      linarith [mul_nonneg hδ0.le
        (by linarith [Real.pi_le_four] : (0:ℝ) ≤ 3 - Real.pi / 2)]
    linarith [hdiam, h2]
  
  have hcover : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
      (∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X) →
      (∀ w : NumberField.InfinitePlace K, 0 < NumberField.mixedEmbedding.normAtPlace w z) →
      ∃ i, z ∈ kaiCell K (A i) (B i) (P i) (S i) (Ps i) (C i) := by
    intro z hlt hpos
    have hreal : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        ∃ k : ℕ, k < 2 * Q ∧ -X + (k:ℝ) * δ < z.1 w ∧ z.1 w ≤ -X + ((k:ℝ) + 1) * δ := by
      intro w
      have h1 : |z.1 w| < X := by
        have h := hlt (w : NumberField.InfinitePlace K)
        rwa [hRnorm w z] at h
      have h2 : -X < z.1 w := (abs_lt.mp h1).1
      have h3 : z.1 w ≤ -X + ((2 * Q : ℕ) : ℝ) * δ := by
        have hc : ((2 * Q : ℕ) : ℝ) * δ = 2 * X := by push_cast; linarith [hQδ]
        rw [hc]; linarith [(abs_lt.mp h1).2]
      exact grid_ex (-X) (z.1 w) δ (2 * Q) hδ0 h2 h3
    have hrad : ∀ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        ∃ k : ℕ, k < Q ∧ (k:ℝ) * δ < ‖z.2 w‖ ∧ ‖z.2 w‖ ≤ ((k:ℝ) + 1) * δ := by
      intro w
      have h1 : ‖z.2 w‖ < X := by
        have h := hlt (w : NumberField.InfinitePlace K)
        rwa [hCnorm w z] at h
      have h0 : (0:ℝ) < ‖z.2 w‖ := by
        have h := hpos (w : NumberField.InfinitePlace K)
        rwa [hCnorm w z] at h
      have h3 : ‖z.2 w‖ ≤ 0 + ((Q : ℕ) : ℝ) * δ := by rw [zero_add]; linarith [hQδ]
      obtain ⟨k, hk, hk1, hk2⟩ := grid_ex 0 ‖z.2 w‖ δ Q hδ0 h0 h3
      exact ⟨k, hk, by linarith, by linarith⟩
    have hang : ∀ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        ∃ l : ℕ, l < 8 * Q ∧ -Real.pi + (l:ℝ) * τ < (z.2 w).arg ∧
          (z.2 w).arg ≤ -Real.pi + ((l:ℝ) + 1) * τ := by
      intro w
      have h1 : -Real.pi < (z.2 w).arg := Complex.neg_pi_lt_arg _
      have h2 : (z.2 w).arg ≤ -Real.pi + ((8 * Q : ℕ) : ℝ) * τ := by
        have hc : ((8 * Q : ℕ) : ℝ) * τ = 2 * Real.pi := by push_cast; linarith [h8τ]
        rw [hc]
        linarith [Complex.arg_le_pi (z.2 w)]
      exact grid_ex (-Real.pi) ((z.2 w).arg) τ (8 * Q) hτ0 h1 h2
    choose jr hjr1 hjr2 hjr3 using hreal
    choose kc hkc1 hkc2 hkc3 using hrad
    choose la hla1 hla2 hla3 using hang
    refine ⟨e.symm (fun w => ⟨jr w, hjr1 w⟩, fun w => ⟨kc w, hkc1 w⟩,
      fun w => ⟨la w, hla1 w⟩), ?_⟩
    simp only [kaiCell, Set.mem_setOf_eq]
    refine ⟨fun w => ?_, fun w => ?_⟩
    · rw [hA, hB, Equiv.apply_symm_apply]
      exact ⟨hjr2 w, hjr3 w⟩
    · rw [hP, hS, hPs, hC, Equiv.apply_symm_apply]
      exact ⟨hkc2 w, hkc3 w, hla2 w, hla3 w⟩
  
  have hP9 : MeasureTheory.volume ({z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X} \
      ⋃ i, kaiCell K (A i) (B i) (P i) (S i) (Ps i) (C i)) = 0 := by
    refine MeasureTheory.measure_mono_null ?_ zero_null
    rintro z ⟨hz1, hz2⟩
    simp only [Set.mem_setOf_eq] at hz1 ⊢
    by_contra hcon
    push_neg at hcon
    have hpos : ∀ w : NumberField.InfinitePlace K,
        0 < NumberField.mixedEmbedding.normAtPlace w z := fun w =>
      lt_of_le_of_ne (NumberField.mixedEmbedding.normAtPlace_nonneg w z) (Ne.symm (hcon w))
    obtain ⟨i, hi⟩ := hcover z hz1 hpos
    exact hz2 (Set.mem_iUnion.mpr ⟨i, hi⟩)
  exact ⟨m, A, B, P, S, Ps, C, hmle, hP2, hP3, hP4, hP5, hP6, hP7, hcover, hP9⟩

theorem kai_cvx_shell_volume (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ cS : ℝ, 0 < cS ∧
      ∀ X r : ℝ, 1 ≤ X → 0 < r → r ≤ X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z ≤ X) →
          MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
              (∃ x ∈ C, ‖z - x‖ ≤ r) ∧ ¬ (∀ y, ‖y - z‖ ≤ r → y ∈ C)}
            ≤ ENNReal.ofReal (cS * X ^ (Module.finrank ℚ K) * (r / X)) :=
by
  classical
  
  have hcoord : ∃ (E : Finset (NumberField.mixedEmbedding.mixedSpace K)) (κ : ℝ), 0 < κ ∧
      (∀ e ∈ E, ‖e‖ ≤ 1) ∧
      ∀ φ : NumberField.mixedEmbedding.mixedSpace K →L[ℝ] ℝ, φ ≠ 0 →
        ∃ e ∈ E, ∀ y : NumberField.mixedEmbedding.mixedSpace K,
          |φ y| ≤ κ * |φ e| * ‖y‖ := by
    obtain ⟨f, hfR, hfC, hfD⟩ :
        ∃ f : ({w : NumberField.InfinitePlace K // w.IsReal} ⊕
            ({w : NumberField.InfinitePlace K // w.IsComplex} ⊕
             {w : NumberField.InfinitePlace K // w.IsComplex})) →
            NumberField.mixedEmbedding.mixedSpace K,
          (∀ w, f (Sum.inl w) = (Pi.single w (1:ℝ), 0)) ∧
          (∀ w, f (Sum.inr (Sum.inl w)) = (0, Pi.single w (1:ℂ))) ∧
          (∀ w, f (Sum.inr (Sum.inr w)) = (0, Pi.single w Complex.I)) :=
      ⟨Sum.elim (fun w => (Pi.single w (1:ℝ), 0))
          (Sum.elim (fun w => (0, Pi.single w (1:ℂ))) (fun w => (0, Pi.single w Complex.I))),
        fun _ => rfl, fun _ => rfl, fun _ => rfl⟩
    obtain ⟨cc, hcR, hcC, hcD⟩ :
        ∃ cc : NumberField.mixedEmbedding.mixedSpace K →
            ({w : NumberField.InfinitePlace K // w.IsReal} ⊕
            ({w : NumberField.InfinitePlace K // w.IsComplex} ⊕
             {w : NumberField.InfinitePlace K // w.IsComplex})) → ℝ,
          (∀ y w, cc y (Sum.inl w) = y.1 w) ∧
          (∀ y w, cc y (Sum.inr (Sum.inl w)) = (y.2 w).re) ∧
          (∀ y w, cc y (Sum.inr (Sum.inr w)) = (y.2 w).im) :=
      ⟨fun y => Sum.elim (fun w => y.1 w)
          (Sum.elim (fun w => (y.2 w).re) (fun w => (y.2 w).im)),
        fun _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl⟩
    have key1 : ∀ g : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ,
        (∑ w, g w • (Pi.single w (1:ℝ) :
          {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)) = g := by
      intro g
      have e : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          g w • (Pi.single w (1:ℝ) : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
            = Pi.single w (g w) := by
        intro w; rw [← Pi.single_smul]; simp
      simp only [e]
      exact Finset.univ_sum_single g
    have key2 : ∀ h : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ,
