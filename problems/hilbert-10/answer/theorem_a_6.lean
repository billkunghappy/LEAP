    have hder : HasDerivAt (fun w => (w - (β : ℂ)) ^ 1 * g w)
        ((((1 : ℕ) : ℂ) * ((β : ℂ) - (β : ℂ)) ^ (1 - 1) * 1) * g (β : ℂ)
