  have hrgt1 : ∀ v : ℝ, ((κ : ℂ) + (v : ℂ) * Complex.I) ≠ 1 := by
    intro v h; have h2 := congrArg Complex.re h; simp at h2; linarith
  have hlft0 : ∀ v : ℝ, ((σ₁ : ℂ) + (v : ℂ) * Complex.I) ≠ 0 := by
    intro v h; have h2 := congrArg Complex.re h; simp at h2; linarith
  have hlft1 : ∀ v : ℝ, ((σ₁ : ℂ) + (v : ℂ) * Complex.I) ≠ 1 := by
    intro v h; have h2 := congrArg Complex.re h; simp at h2; linarith
  have hcau := hrect F σ₁ κ 1 T hσ2 hκ1 hT0 hFdiff
  simp only [Complex.ofReal_one] at hcau
  rw [hF1] at hcau
  have eBo : (∫ u : ℝ in σ₁..κ,
        F ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) /
          ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I - 1))
      = ∫ u : ℝ in σ₁..κ,
        (-(deriv G ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) /
              G ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I))
           + (E : ℂ) / ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I - 1)) *
          (x : ℂ) ^ ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) /
            ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) ^ 2 :=
    intervalIntegral.integral_congr (fun u _ => hFΦ _ (hbot0 u) (hbot1 u))
  have eTo : (∫ u : ℝ in σ₁..κ,
        F ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I) /
          ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I - 1))
      = ∫ u : ℝ in σ₁..κ,
        (-(deriv G ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I) /
              G ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I))
           + (E : ℂ) / ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I - 1)) *
          (x : ℂ) ^ ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I) /
            ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I) ^ 2 :=
    intervalIntegral.integral_congr (fun u _ => hFΦ _ (htop0 u) (htop1 u))
  have eRg : (∫ v : ℝ in (-T)..T,
        F ((κ : ℂ) + (v : ℂ) * Complex.I) /
          ((κ : ℂ) + (v : ℂ) * Complex.I - 1))
      = ∫ v : ℝ in (-T)..T,
        (-(deriv G ((κ : ℂ) + (v : ℂ) * Complex.I) /
              G ((κ : ℂ) + (v : ℂ) * Complex.I))
           + (E : ℂ) / ((κ : ℂ) + (v : ℂ) * Complex.I - 1)) *
          (x : ℂ) ^ ((κ : ℂ) + (v : ℂ) * Complex.I) /
            ((κ : ℂ) + (v : ℂ) * Complex.I) ^ 2 :=
    intervalIntegral.integral_congr (fun v _ => hFΦ _ (hrgt0 v) (hrgt1 v))
  have eLe : (∫ v : ℝ in (-T)..T,
        F ((σ₁ : ℂ) + (v : ℂ) * Complex.I) /
          ((σ₁ : ℂ) + (v : ℂ) * Complex.I - 1))
      = ∫ v : ℝ in (-T)..T,
        (-(deriv G ((σ₁ : ℂ) + (v : ℂ) * Complex.I) /
              G ((σ₁ : ℂ) + (v : ℂ) * Complex.I))
           + (E : ℂ) / ((σ₁ : ℂ) + (v : ℂ) * Complex.I - 1)) *
          (x : ℂ) ^ ((σ₁ : ℂ) + (v : ℂ) * Complex.I) /
            ((σ₁ : ℂ) + (v : ℂ) * Complex.I) ^ 2 :=
    intervalIntegral.integral_congr (fun v _ => hFΦ _ (hlft0 v) (hlft1 v))
  rw [eBo, eTo, eRg, eLe] at hcau
  have eTar : (∫ τ : ℝ in (-T)..T, Complex.I *
        (-(deriv G ((κ : ℂ) + (τ : ℂ) * Complex.I) /
              G ((κ : ℂ) + (τ : ℂ) * Complex.I))
           + (E : ℂ) / ((κ : ℂ) + (τ : ℂ) * Complex.I - 1)) *
        (x : ℂ) ^ ((κ : ℂ) + (τ : ℂ) * Complex.I) /
          ((κ : ℂ) + (τ : ℂ) * Complex.I) ^ 2)
      = Complex.I * (∫ v : ℝ in (-T)..T,
        (-(deriv G ((κ : ℂ) + (v : ℂ) * Complex.I) /
              G ((κ : ℂ) + (v : ℂ) * Complex.I))
           + (E : ℂ) / ((κ : ℂ) + (v : ℂ) * Complex.I - 1)) *
          (x : ℂ) ^ ((κ : ℂ) + (v : ℂ) * Complex.I) /
            ((κ : ℂ) + (v : ℂ) * Complex.I) ^ 2) := by
    rw [← intervalIntegral.integral_const_mul]
    exact intervalIntegral.integral_congr (fun τ _ => by ring)
  rw [eTar]
  
  have alg : ∀ Bo To Rg Le : ℂ,
      ((Bo - To) + Complex.I * Rg) - Complex.I * Le
          = 2 * (Real.pi : ℂ) * Complex.I * ((E : ℂ) * (x : ℂ)) →
      (1 / (2 * (Real.pi : ℂ) * Complex.I)) * (Complex.I * Rg) - (E : ℂ) * (x : ℂ)
          = (1 / (2 * (Real.pi : ℂ) * Complex.I)) * (-Bo + To + Complex.I * Le) := by
    intro Bo To Rg Le h
    have hRg : Complex.I * Rg
        = 2 * (Real.pi : ℂ) * Complex.I * ((E : ℂ) * (x : ℂ)) - Bo + To + Complex.I * Le := by
      linear_combination h
    rw [hRg]
    field_simp
    ring
  rw [alg _ _ _ _ hcau]
  have hnk : ‖(1 : ℂ) / (2 * (Real.pi : ℂ) * Complex.I)‖ = 1 / (2 * Real.pi) := by
    simp [abs_of_pos Real.pi_pos]
  have htri : ∀ p q r : ℂ, ‖-p + q + Complex.I * r‖ ≤ ‖p‖ + ‖q‖ + ‖r‖ := by
    intro p q r
    have h1 : ‖-p + q + Complex.I * r‖ ≤ ‖-p + q‖ + ‖Complex.I * r‖ := norm_add_le _ _
    have h2 : ‖-p + q‖ ≤ ‖-p‖ + ‖q‖ := norm_add_le _ _
    have h3 : ‖Complex.I * r‖ = ‖r‖ := by rw [norm_mul, Complex.norm_I, one_mul]
    have h4 : ‖-p‖ = ‖p‖ := norm_neg p
    linarith
  rw [norm_mul, hnk]
  have hconst : (0 : ℝ) ≤ 1 / (2 * Real.pi) :=
    le_of_lt (div_pos one_pos (by linarith [Real.pi_pos]))
  refine le_trans (mul_le_mul_of_nonneg_left (htri _ _ _) hconst) ?_
  
  have habsT : |(-T : ℝ)| = T := by rw [abs_neg]; exact abs_of_nonneg (by linarith)
  have habsT' : |(T : ℝ)| = T := abs_of_nonneg (by linarith)
  have hBo := hHoriz (-T) habsT
  have hTo := hHoriz T habsT'
  have hLe := hLeftBd
  have hnum : 1 / (2 * Real.pi) *
        (3 / 2 * ((M + 1) * x ^ κ / T ^ 2) + 3 / 2 * ((M + 1) * x ^ κ / T ^ 2)
          + 10 * x ^ σ₁ * (M + 1 / ρ + 1 / (1 - σ₁) + 1))
      ≤ 2 * x ^ σ₁ * (M + 1 / ρ + 1 / (1 - σ₁) + 1) + (M + 1) * x ^ κ / T ^ 2 := by
    have hxσ : (0 : ℝ) < x ^ σ₁ := Real.rpow_pos_of_pos hx0 _
    have hxκ : (0 : ℝ) < x ^ κ := Real.rpow_pos_of_pos hx0 _
    have hNb : (0 : ℝ) < M + 1 / ρ + 1 / (1 - σ₁) + 1 := by
      have hr : (0 : ℝ) < 1 / ρ := div_pos one_pos hρ
      have hs : (0 : ℝ) < 1 / (1 - σ₁) := div_pos one_pos h1σ
      linarith
    have hA0 : (0 : ℝ) ≤ (M + 1) * x ^ κ / T ^ 2 :=
      le_of_lt (div_pos (mul_pos (by linarith) hxκ) (pow_pos hT0 2))
    have hB0 : (0 : ℝ) ≤ x ^ σ₁ * (M + 1 / ρ + 1 / (1 - σ₁) + 1) := le_of_lt (mul_pos hxσ hNb)
    have hpi := Real.pi_gt_three
    have h2pi : (0 : ℝ) < 2 * Real.pi := by linarith
    rw [div_mul_eq_mul_div, one_mul, div_le_iff₀ h2pi]
    nlinarith [mul_nonneg
        (by linarith : (0:ℝ) ≤ (M + 1) * x ^ κ / T ^ 2
              + 2 * (x ^ σ₁ * (M + 1 / ρ + 1 / (1 - σ₁) + 1)))
        (by linarith : (0:ℝ) ≤ 2 * Real.pi - 6), hA0, hB0]
  refine le_trans (mul_le_mul_of_nonneg_left ?_ hconst) hnum
  linarith [hBo, hTo, hLe]

theorem kai_lp_logsum_main (K : Type u) [Field K] [NumberField K]
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (h1 : lam 1 = 1)
    (hmul : ∀ I J : Ideal (NumberField.RingOfIntegers K), lam (I * J) = lam I * lam J)
    (hbd : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1)
    (E : ℕ) (G : ℂ → ℂ) (hE : E ≤ 1) (hG : Differentiable ℂ G)
    (hEG : ∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s)
    (m : ℕ) (hm : m ≤ 1)
    (x X Λ B y σ₁ β₀ M ρ S N : ℝ)
    (hx : 3 ≤ x) (hX : X = Real.log x) (hX4 : 4 ≤ X)
    (hΛ : Real.sqrt X ≤ Λ) (hB0 : 0 < B) (hB1 : B ≤ 1)
    (hy3 : 3 ≤ y) (hyx : y ≤ x)
    (hσ12 : 1 / 2 ≤ σ₁) (hσ1 : σ₁ < 1) (hσgap : B / (40 * Λ) ≤ 1 - σ₁)
    (hβ0 : 0 ≤ β₀) (hβ1 : β₀ < 1)
    (hM : 0 < M) (hρ : 0 < ρ) (hρβ : ρ ≤ |σ₁ - β₀|)
    (hN : M + 1 / ρ + 1 / (1 - σ₁) + 1 ≤ N) (hS0 : 0 ≤ S)
    (hnz : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 2 →
        |s.im| ≤ Real.exp (Real.sqrt X) → G s ≠ 0)
    (hld : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 2 →
        |s.im| ≤ Real.exp (Real.sqrt X) →
        ‖deriv G s / G s - (m : ℂ) / (s - (β₀ : ℂ))‖ ≤ M)
    (hsum : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ‖((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K))‖ *
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-(1 + 1 / X))))
    (hSb : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        ‖((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K))‖ *
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-(1 + 1 / X)))
        ≤ S) :
    ‖(∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ y},
        ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
          ((Real.log (y / (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) : ℝ) : ℂ))
      - (E : ℂ) * (y : ℂ)‖
      ≤ (6 * S + 5 * N) * x * Real.exp (-(B * X) / (40 * Λ)) :=
by
  have hx0 : (0 : ℝ) < x := by linarith
  have hXpos : (0 : ℝ) < X := by linarith
  have hXne : X ≠ 0 := ne_of_gt hXpos
  have hxX : x = Real.exp X := by rw [hX, Real.exp_log hx0]
  have hy0 : (0 : ℝ) < y := by linarith
  have hsq2 : (2 : ℝ) ≤ Real.sqrt X := by
    have h2 : Real.sqrt 4 = 2 := by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num]
      exact Real.sqrt_sq (by norm_num)
    have h4 : Real.sqrt 4 ≤ Real.sqrt X := Real.sqrt_le_sqrt hX4
    linarith
  have hΛ0 : (0 : ℝ) < Λ := by linarith
  have h40Λ : (0 : ℝ) < 40 * Λ := by linarith
  have hinvXpos : (0 : ℝ) < 1 / X := div_pos one_pos hXpos
  have hinvX1 : 1 / X ≤ 1 := by rw [div_le_one hXpos]; linarith
  have hκ1 : (1 : ℝ) < 1 + 1 / X := by linarith
  have hκ2 : (1 : ℝ) + 1 / X ≤ 2 := by linarith
  have hT0 : (0 : ℝ) < Real.exp (Real.sqrt X) := Real.exp_pos _
  have hT3 : (3 : ℝ) ≤ Real.exp (Real.sqrt X) := by
    have h1 : Real.exp 2 ≤ Real.exp (Real.sqrt X) := Real.exp_le_exp.mpr hsq2
    have h2 : (2 : ℝ) + 1 ≤ Real.exp 2 := Real.add_one_le_exp 2
    linarith
  have hΔ0 : (0 : ℝ) < Real.exp (-(B * X) / (40 * Λ)) := Real.exp_pos _
  have hs1pos : (0 : ℝ) < 1 - σ₁ := by linarith
  have hrinv : (0 : ℝ) < 1 / ρ := div_pos one_pos hρ
  have hsinv : (0 : ℝ) < 1 / (1 - σ₁) := div_pos one_pos hs1pos
  have hNb0 : (0 : ℝ) ≤ M + 1 / ρ + 1 / (1 - σ₁) + 1 := by linarith
  have hMN : M + 1 ≤ N := by linarith
  have hN0 : (0 : ℝ) ≤ N := by linarith
  have hΔexp : -(B * X) / (40 * Λ) = -((B * X) / (40 * Λ)) := neg_div _ _
  
  have he1 : Real.exp 1 < 3 := lt_trans Real.exp_one_lt_d9 (by norm_num)
  have hA1 : y ^ (1 + 1 / X) ≤ 3 * x := by
    have h1 : y ^ (1 + 1 / X) ≤ x ^ (1 + 1 / X) :=
      Real.rpow_le_rpow (le_of_lt hy0) hyx (by linarith)
    have h2 : x ^ (1 + 1 / X) = Real.exp (Real.log x * (1 + 1 / X)) :=
      Real.rpow_def_of_pos hx0 _
    have h3 : Real.log x * (1 + 1 / X) = X + 1 := by
      rw [← hX]
      have h : X * (1 + 1 / X) = X + X * (1 / X) := by ring
      rw [h, mul_one_div, div_self hXne]
    have h4 : Real.exp (X + 1) = x * Real.exp 1 := by
      rw [Real.exp_add, ← hxX]
    have h5 : x * Real.exp 1 ≤ x * 3 :=
      mul_le_mul_of_nonneg_left (le_of_lt he1) (le_of_lt hx0)
    rw [h2, h3, h4] at h1
    linarith
  have hA2 : 1 / Real.exp (Real.sqrt X) ≤ Real.exp (-(B * X) / (40 * Λ)) := by
    have hkey : (B * X) / (40 * Λ) ≤ Real.sqrt X := by
      rw [div_le_iff₀ h40Λ]
      have hstep : Real.sqrt X * (40 * Real.sqrt X) ≤ Real.sqrt X * (40 * Λ) :=
        mul_le_mul_of_nonneg_left (by linarith) (Real.sqrt_nonneg X)
      have hss : Real.sqrt X * (40 * Real.sqrt X) = 40 * X := by
        have h : Real.sqrt X * (40 * Real.sqrt X)
            = 40 * (Real.sqrt X * Real.sqrt X) := by ring
        rw [h, Real.mul_self_sqrt (le_of_lt hXpos)]
      have hBX : B * X ≤ X := by
        nlinarith [mul_nonneg (le_of_lt hXpos) (sub_nonneg.mpr hB1)]
      linarith
    have h1 : 1 / Real.exp (Real.sqrt X) = Real.exp (-Real.sqrt X) := by
      rw [Real.exp_neg, one_div]
    rw [h1, hΔexp]
    apply Real.exp_le_exp.mpr
    linarith
  have hA3 : 1 / Real.exp (Real.sqrt X) ^ 2 ≤ Real.exp (-(B * X) / (40 * Λ)) := by
    have hTT : Real.exp (Real.sqrt X) ≤ Real.exp (Real.sqrt X) ^ 2 := by nlinarith
    have hstep := one_div_le_one_div_of_le hT0 hTT
    linarith
  have hA4 : y ^ σ₁ ≤ x * Real.exp (-(B * X) / (40 * Λ)) := by
    have hσ0 : (0 : ℝ) ≤ σ₁ := by linarith
    have h1 : y ^ σ₁ ≤ x ^ σ₁ := Real.rpow_le_rpow (le_of_lt hy0) hyx hσ0
    have h2 : x ^ σ₁ = Real.exp (X * σ₁) := by
      rw [Real.rpow_def_of_pos hx0, ← hX]
    have hgap2 : (B * X) / (40 * Λ) ≤ X - X * σ₁ := by
      have h := mul_le_mul_of_nonneg_left hσgap (le_of_lt hXpos)
      calc (B * X) / (40 * Λ) = X * (B / (40 * Λ)) := by ring
        _ ≤ X * (1 - σ₁) := h
        _ = X - X * σ₁ := by ring
    have h3 : x * Real.exp (-(B * X) / (40 * Λ))
        = Real.exp (X + -(B * X) / (40 * Λ)) := by
      rw [Real.exp_add, hxX]
    have h4 : Real.exp (X * σ₁) ≤ Real.exp (X + -(B * X) / (40 * Λ)) := by
      apply Real.exp_le_exp.mpr
      rw [hΔexp]
      linarith
    calc y ^ σ₁ ≤ x ^ σ₁ := h1
      _ = Real.exp (X * σ₁) := h2
      _ ≤ Real.exp (X + -(B * X) / (40 * Λ)) := h4
      _ = x * Real.exp (-(B * X) / (40 * Λ)) := h3.symm
  
  have hF : ∀ s : ℂ, 1 < s.re →
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
        = -(deriv G s / G s) + (E : ℂ) / (s - 1) :=
    fun s hs => (kai_lp_logderiv K lam h1 hmul hbd E G hG hEG s hs).2
  
  obtain ⟨P, hP⟩ : ∃ P : ℂ, P = (1 / (2 * (Real.pi : ℂ) * Complex.I)) *
      (∫ τ in (-(Real.exp (Real.sqrt X)))..(Real.exp (Real.sqrt X)), Complex.I *
        (-(deriv G (((1 + 1 / X : ℝ) : ℂ) + (τ : ℂ) * Complex.I) /
              G (((1 + 1 / X : ℝ) : ℂ) + (τ : ℂ) * Complex.I))
           + (E : ℂ) / (((1 + 1 / X : ℝ) : ℂ) + (τ : ℂ) * Complex.I - 1)) *
        (y : ℂ) ^ (((1 + 1 / X : ℝ) : ℂ) + (τ : ℂ) * Complex.I) /
          (((1 + 1 / X : ℝ) : ℂ) + (τ : ℂ) * Complex.I) ^ 2) := ⟨_, rfl⟩
  have h5 : ‖(∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ y},
        ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
          ((Real.log (y / (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) : ℝ) : ℂ))
        - P‖
      ≤ 2 * S * y ^ (1 + 1 / X) / Real.exp (Real.sqrt X) := by
    rw [hP]
    exact kai_lp_smoothed_perron
      (fun I => ((kaiZFVonMangoldt K I : ℝ) : ℂ) * lam I)
      (fun s => -(deriv G s / G s) + (E : ℂ) / (s - 1))
      y (Real.exp (Real.sqrt X)) (1 + 1 / X) S hy3 hT3 hκ1 hκ2 hF hsum hSb
  
  have hnz' : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 1 + 1 / X →
      |s.im| ≤ Real.exp (Real.sqrt X) → G s ≠ 0 :=
    fun s h1 h2 h3 => hnz s h1 (le_trans h2 hκ2) h3
  have hld' : ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ 1 + 1 / X →
      |s.im| ≤ Real.exp (Real.sqrt X) →
      ‖deriv G s / G s - (m : ℂ) / (s - (β₀ : ℂ))‖ ≤ M :=
    fun s h1 h2 h3 => hld s h1 (le_trans h2 hκ2) h3
  have h6 : ‖P - (E : ℂ) * (y : ℂ)‖
      ≤ 2 * y ^ σ₁ * (M + 1 / ρ + 1 / (1 - σ₁) + 1)
        + (M + 1) * y ^ (1 + 1 / X) / Real.exp (Real.sqrt X) ^ 2 := by
    rw [hP]
    exact kai_lp_contour_shift G hG y (Real.exp (Real.sqrt X)) σ₁ (1 + 1 / X)
      β₀ M ρ m E hy3 hT3 hσ12 hσ1 hκ1 hκ2 hm hE hM hρ hβ0 hβ1 hρβ hnz' hld'
  
  have htri := le_trans (norm_add_le _ _) (add_le_add h5 h6)
  rw [sub_add_sub_cancel] at htri
  have hyκ0 : (0 : ℝ) ≤ y ^ (1 + 1 / X) := Real.rpow_nonneg (le_of_lt hy0) _
  have hxΔ0 : (0 : ℝ) ≤ x * Real.exp (-(B * X) / (40 * Λ)) :=
    mul_nonneg (le_of_lt hx0) (le_of_lt hΔ0)
  have h3x0 : (0 : ℝ) ≤ 3 * x := by linarith
  have hTinv0 : (0 : ℝ) ≤ (Real.exp (Real.sqrt X))⁻¹ := inv_nonneg.mpr (le_of_lt hT0)
  have hT2inv0 : (0 : ℝ) ≤ (Real.exp (Real.sqrt X) ^ 2)⁻¹ :=
    inv_nonneg.mpr (le_of_lt (pow_pos hT0 2))
  have hb1 : 2 * S * y ^ (1 + 1 / X) / Real.exp (Real.sqrt X)
      ≤ 6 * S * (x * Real.exp (-(B * X) / (40 * Λ))) := by
    have hA2' : (Real.exp (Real.sqrt X))⁻¹ ≤ Real.exp (-(B * X) / (40 * Λ)) := by
      rw [← one_div]; exact hA2
    have hkey : y ^ (1 + 1 / X) * (Real.exp (Real.sqrt X))⁻¹
        ≤ 3 * x * Real.exp (-(B * X) / (40 * Λ)) :=
      mul_le_mul hA1 hA2' hTinv0 h3x0
    have hform : 2 * S * y ^ (1 + 1 / X) / Real.exp (Real.sqrt X)
        = 2 * S * (y ^ (1 + 1 / X) * (Real.exp (Real.sqrt X))⁻¹) := by
      rw [div_eq_mul_inv]; ring
    have h2S : (0 : ℝ) ≤ 2 * S := by linarith
    rw [hform]
    calc 2 * S * (y ^ (1 + 1 / X) * (Real.exp (Real.sqrt X))⁻¹)
        ≤ 2 * S * (3 * x * Real.exp (-(B * X) / (40 * Λ))) :=
          mul_le_mul_of_nonneg_left hkey h2S
      _ = 6 * S * (x * Real.exp (-(B * X) / (40 * Λ))) := by ring
  have hb2 : 2 * y ^ σ₁ * (M + 1 / ρ + 1 / (1 - σ₁) + 1)
      ≤ 2 * N * (x * Real.exp (-(B * X) / (40 * Λ))) := by
    have hkey : y ^ σ₁ * (M + 1 / ρ + 1 / (1 - σ₁) + 1)
        ≤ x * Real.exp (-(B * X) / (40 * Λ)) * N :=
      mul_le_mul hA4 hN hNb0 hxΔ0
    linarith
  have hb3 : (M + 1) * y ^ (1 + 1 / X) / Real.exp (Real.sqrt X) ^ 2
      ≤ 3 * N * (x * Real.exp (-(B * X) / (40 * Λ))) := by
    have hA3' : (Real.exp (Real.sqrt X) ^ 2)⁻¹ ≤ Real.exp (-(B * X) / (40 * Λ)) := by
      rw [← one_div]; exact hA3
    have hkey : y ^ (1 + 1 / X) * (Real.exp (Real.sqrt X) ^ 2)⁻¹
        ≤ 3 * x * Real.exp (-(B * X) / (40 * Λ)) :=
      mul_le_mul hA1 hA3' hT2inv0 h3x0
    have hform : (M + 1) * y ^ (1 + 1 / X) / Real.exp (Real.sqrt X) ^ 2
        = (M + 1) * (y ^ (1 + 1 / X) * (Real.exp (Real.sqrt X) ^ 2)⁻¹) := by
      rw [div_eq_mul_inv]; ring
    rw [hform]
    calc (M + 1) * (y ^ (1 + 1 / X) * (Real.exp (Real.sqrt X) ^ 2)⁻¹)
        ≤ N * (3 * x * Real.exp (-(B * X) / (40 * Λ))) :=
          mul_le_mul hMN hkey (mul_nonneg hyκ0 hT2inv0) hN0
      _ = 3 * N * (x * Real.exp (-(B * X) / (40 * Λ))) := by ring
  have hring : 6 * S * (x * Real.exp (-(B * X) / (40 * Λ)))
      + 2 * N * (x * Real.exp (-(B * X) / (40 * Λ)))
      + 3 * N * (x * Real.exp (-(B * X) / (40 * Λ)))
      = (6 * S + 5 * N) * x * Real.exp (-(B * X) / (40 * Λ)) := by ring
  linarith

theorem kai_lp_pole_residue (y T σ₁ κ β ρ : ℝ)
    (hy : 3 ≤ y) (hT : 3 ≤ T) (hσ1 : 1 / 2 ≤ σ₁) (hκ1 : 1 < κ) (hκ2 : κ ≤ 2)
    (hρ : 0 < ρ) (hσβ : σ₁ + ρ ≤ β) (hβ1 : β < 1) :
    ‖(1 / (2 * (Real.pi : ℂ) * Complex.I)) *
        (∫ τ in (-T)..T, Complex.I *
          (1 / ((κ : ℂ) + (τ : ℂ) * Complex.I - (β : ℂ))) *
          (y : ℂ) ^ ((κ : ℂ) + (τ : ℂ) * Complex.I) /
            ((κ : ℂ) + (τ : ℂ) * Complex.I) ^ 2)
      - (((y ^ β / β ^ 2 : ℝ)) : ℂ)‖
      ≤ 2 * y ^ σ₁ * (1 / ρ + 1 / (1 - σ₁) + 1) + y ^ κ / T ^ 2 :=
by
  
  
  have hrect : ∀ (f : ℂ → ℂ) (a b c T : ℝ), a < c → c < b → 0 < T →
      (∀ z : ℂ, a ≤ z.re → z.re ≤ b → |z.im| ≤ T → DifferentiableAt ℂ f z) →
      (((∫ u : ℝ in a..b,
            f ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) /
              ((u : ℂ) + ((-T : ℝ) : ℂ) * Complex.I - (c : ℂ)))
          - ∫ u : ℝ in a..b,
            f ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I) /
              ((u : ℂ) + ((T : ℝ) : ℂ) * Complex.I - (c : ℂ)))
        + Complex.I * (∫ v : ℝ in (-T)..T,
            f ((b : ℂ) + (v : ℂ) * Complex.I) /
              ((b : ℂ) + (v : ℂ) * Complex.I - (c : ℂ))))
        - Complex.I * (∫ v : ℝ in (-T)..T,
            f ((a : ℂ) + (v : ℂ) * Complex.I) /
              ((a : ℂ) + (v : ℂ) * Complex.I - (c : ℂ)))
        = 2 * (Real.pi : ℂ) * Complex.I * f (c : ℂ) := by
    intro f a b c T hac hcb hT hf
    have hA1 : ∀ d s : ℝ, d ≠ 0 →
        (∫ v : ℝ in (-s)..s, ((d : ℂ) + (v : ℂ) * Complex.I)⁻¹)
          = 2 * ((Real.arctan (s / d) : ℝ) : ℂ) := by
      intro d s hd
      have hpos : ∀ v : ℝ, (0 : ℝ) < d ^ 2 + v ^ 2 := by
        intro v
        have h : (0 : ℝ) < d ^ 2 := by positivity
        nlinarith [sq_nonneg v]
      have hne : ∀ v : ℝ, (d ^ 2 + v ^ 2 : ℝ) ≠ 0 := fun v => ne_of_gt (hpos v)
      have hre : ∀ v : ℝ, ((d : ℂ) + (v : ℂ) * Complex.I).re = d := fun v => by simp
      have hcne : ∀ v : ℝ, ((d : ℂ) + (v : ℂ) * Complex.I) ≠ 0 := by
        intro v hv
        apply hd
        rw [← hre v, hv]
        simp
      have hcast : ∀ v : ℝ, (((d ^ 2 + v ^ 2 : ℝ)) : ℂ) ≠ 0 := fun v =>
        Complex.ofReal_ne_zero.mpr (hne v)
      have hval : ∀ v : ℝ,
          (((d / (d ^ 2 + v ^ 2) : ℝ)) : ℂ)
              - Complex.I / 2 * (((2 * v / (d ^ 2 + v ^ 2) : ℝ)) : ℂ)
            = ((d : ℂ) + (v : ℂ) * Complex.I)⁻¹ := by
        intro v
        have h1 : (((d / (d ^ 2 + v ^ 2) : ℝ)) : ℂ)
              - Complex.I / 2 * (((2 * v / (d ^ 2 + v ^ 2) : ℝ)) : ℂ)
            = ((d : ℂ) - (v : ℂ) * Complex.I) / (((d ^ 2 + v ^ 2 : ℝ)) : ℂ) := by
          push_cast
          field_simp
        have h2 : ((d : ℂ) - (v : ℂ) * Complex.I) * ((d : ℂ) + (v : ℂ) * Complex.I)
            = (((d ^ 2 + v ^ 2 : ℝ)) : ℂ) := by
          push_cast
          linear_combination (-(v : ℂ) ^ 2) * Complex.I_sq
        have h3 : ((((d / (d ^ 2 + v ^ 2) : ℝ)) : ℂ)
              - Complex.I / 2 * (((2 * v / (d ^ 2 + v ^ 2) : ℝ)) : ℂ))
            * ((d : ℂ) + (v : ℂ) * Complex.I) = 1 := by
          rw [h1, div_mul_eq_mul_div, h2, div_self (hcast v)]
        exact (inv_eq_of_mul_eq_one_left h3).symm
      have hF : ∀ v : ℝ, HasDerivAt
          (fun w : ℝ => (((Real.arctan (w / d) : ℝ)) : ℂ)
            - Complex.I / 2 * (((Real.log (d ^ 2 + w ^ 2) : ℝ)) : ℂ))
          (((d : ℂ) + (v : ℂ) * Complex.I)⁻¹) v := by
        intro v
        have hq : HasDerivAt (fun w : ℝ => w / d) (1 / d) v := by
          simpa using (hasDerivAt_id v).div_const d
        have harc : HasDerivAt (fun w : ℝ => Real.arctan (w / d)) (d / (d ^ 2 + v ^ 2)) v := by
          have h := hq.arctan
          convert h using 1
          have hden : (1 : ℝ) + (v / d) ^ 2 ≠ 0 := by positivity
          field_simp
        have hs : HasDerivAt (fun w : ℝ => d ^ 2 + w ^ 2) (2 * v) v := by
          simpa using (hasDerivAt_pow 2 v).const_add (d ^ 2)
        have hlog : HasDerivAt (fun w : ℝ => Real.log (d ^ 2 + w ^ 2))
