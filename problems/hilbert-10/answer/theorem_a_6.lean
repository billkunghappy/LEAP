        · rintro ⟨t, ht, rfl⟩
          rw [hmemI] at ht
          refine ⟨(hmemX _).2 ⟨(hbox _).2 ?_, ht.2⟩, ?_⟩
          · intro k
            by_cases hk : k = l
            · rw [hk]; simp only [Function.update_self]; exact ht.1
            · simp only [Function.update_apply, hk, if_false]; exact hyk k hk
          · rw [Function.update_idem, Function.update_eq_self_iff]; exact hyl.symm
      rw [hfibsum]
      rcases I.eq_empty_or_nonempty with hIe | hIne
      · rw [hIe, Finset.sum_empty, norm_zero]; exact hB0
      · obtain ⟨φ, hφdef⟩ : ∃ φ : ℝ → (Fin ν → ℝ),
            φ = fun s j => if j = l then s else ((y j : ℤ) : ℝ) := ⟨_, rfl⟩
        have hφ : ∀ t : ℤ, (fun j => ((Function.update y l t j : ℤ) : ℝ)) = φ (t : ℝ) := by
          intro t; rw [hφdef]; funext j; simp only [Function.update_apply]; split_ifs <;> rfl
        have hT : Convex ℝ {s : ℝ | φ s ∈ Ω} := by
          intro s₁ hs₁ s₂ hs₂ α β hα hβ hαβ
          have h := hΩ hs₁ hs₂ hα hβ hαβ
          show φ (α • s₁ + β • s₂) ∈ Ω
          convert h using 1
          rw [hφdef]
          funext j
          simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
          split_ifs
          · rfl
          · rw [← add_mul, hαβ, one_mul]
