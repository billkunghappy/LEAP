  have hy0 : (0:ℝ) < (32 * T) ^ ((1 - β) / Real.log (4 / 3)) :=
    Real.rpow_pos_of_pos h32T0 _
  have he0 : (0:ℝ) < Real.exp 1 := Real.exp_pos 1
  have hne1 : Real.exp 1 ≠ 0 := ne_of_gt he0
  have hne2 : (32 * T) ^ ((1 - β) / Real.log (4 / 3)) ≠ 0 := ne_of_gt hy0
  have hlhs : (1 - β) / (2 * Real.exp 1) * (32 * T) ^ (-((1 - β) / Real.log (4 / 3)))
      = (1 - β) / (2 * Real.exp 1 * (32 * T) ^ ((1 - β) / Real.log (4 / 3))) := by
    rw [Real.rpow_neg h32T0.le]
    field_simp
  have hrN0 : (0:ℝ) < (2 - β) ^ N := pow_pos hrpos N
  have hcmp : 2 * (2 - β) ^ N
      ≤ 2 * Real.exp 1 * (32 * T) ^ ((1 - β) / Real.log (4 / 3)) := by linarith
  have hdd : (1 - β) / (2 * Real.exp 1 * (32 * T) ^ ((1 - β) / Real.log (4 / 3)))
      ≤ (1 - β) / (2 * (2 - β) ^ N) :=
    div_le_div_of_nonneg_left (by linarith) (by linarith) hcmp
  rw [hlhs]
  exact le_trans hdd hlanda

theorem kai_hecke_landau_product (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ c a : ℝ, 0 < c ∧ 0 < a ∧
      ∀ q₁ q₂ : Ideal (NumberField.RingOfIntegers K), q₁ ≠ 0 → q₂ ≠ 0 →
      ∀ (ξ₁ : ((NumberField.RingOfIntegers K ⧸ q₁)ˣ) →* Circle)
        (η₁ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam₁ : Ideal (NumberField.RingOfIntegers K) → ℂ)
        (ξ₂ : ((NumberField.RingOfIntegers K ⧸ q₂)ˣ) →* Circle)
        (η₂ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam₂ : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q₁ 0 0 ξ₁ η₁ lam₁ →
        KaiHeckeExt K q₂ 0 0 ξ₂ η₂ lam₂ →
        (∀ I : Ideal (NumberField.RingOfIntegers K), lam₁ I = (starRingEnd ℂ) (lam₁ I)) →
        (∀ I : Ideal (NumberField.RingOfIntegers K), lam₂ I = (starRingEnd ℂ) (lam₂ I)) →
        ¬ KaiHeckePrincipal K q₁ lam₁ →
        ¬ KaiHeckePrincipal K q₂ lam₂ →
        ¬ KaiHeckePrincipal K (q₁ * q₂) (fun I => lam₁ I * lam₂ I) →
      ∀ G₁ G₂ : ℂ → ℂ, Differentiable ℂ G₁ → Differentiable ℂ G₂ →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam₁ s = G₁ s) →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam₂ s = G₂ s) →
        ∃ (ξ₃ : ((NumberField.RingOfIntegers K ⧸ (q₁ * q₂))ˣ) →* Circle)
          (η₃ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
          (G₃ : ℂ → ℂ),
          KaiHeckeExt K (q₁ * q₂) 0 0 ξ₃ η₃ (fun I => lam₁ I * lam₂ I) ∧
          Differentiable ℂ G₃ ∧
          (∀ s : ℂ, 1 < s.re →
            kaiHeckeSeries K (fun I => lam₁ I * lam₂ I) s = G₃ s) ∧
          ∀ β : ℝ, 7 / 8 ≤ β → β < 1 → G₁ (β : ℂ) = 0 →
            c * (1 - β) *
                ((Ideal.absNorm (q₁ * q₂) : ℝ) ^ (-(a * (1 - β))))
              ≤ ‖G₁ 1‖ * ‖G₂ 1‖ * ‖G₃ 1‖ :=
by
  classical
  obtain ⟨A₀, hA₀, hD7⟩ := kai_hecke_zeta_continuation K
  
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = Real.log (4 / 3) := ⟨_, rfl⟩
  have hL0 : 0 < L := by rw [hLdef]; exact Real.log_pos (by norm_num)
  have h2401 : (1 : ℝ) ≤ (2401 : ℝ) ^ A₀ := by
    have h := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ) ≤ 2401) hA₀.le
    simpa using h
  obtain ⟨M₀, hM₀def⟩ : ∃ M₀ : ℝ, M₀ = (1 + A₀) ^ 4 * (2401 : ℝ) ^ A₀ := ⟨_, rfl⟩
  have hM₀1 : (1 : ℝ) ≤ M₀ := by
    rw [hM₀def]
    have h1 : (1:ℝ) ≤ (1 + A₀) ^ 4 := one_le_pow₀ (by linarith)
    nlinarith
  obtain ⟨M₁, hM₁def⟩ : ∃ M₁ : ℝ, M₁ = 32 * M₀ := ⟨_, rfl⟩
  have hM₁1 : (1 : ℝ) ≤ M₁ := by rw [hM₁def]; linarith
  obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = 2 * A₀ / L := ⟨_, rfl⟩
  have ha0 : 0 < a := by rw [hadef]; exact div_pos (by linarith) hL0
  obtain ⟨c₀, hc₀def⟩ : ∃ c₀ : ℝ, c₀ = M₁ ^ (-(1 / L)) / (2 * Real.exp 1) := ⟨_, rfl⟩
  have hc₀0 : 0 < c₀ := by
    rw [hc₀def]
    exact div_pos (Real.rpow_pos_of_pos (by linarith) _) (by positivity)
  have hDpos : (0:ℝ) < (1 + A₀) * (4 : ℝ) ^ A₀ :=
    mul_pos (by linarith) (Real.rpow_pos_of_pos (by norm_num) _)
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = c₀ / ((1 + A₀) * (4 : ℝ) ^ A₀) := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hcdef]; exact div_pos hc₀0 hDpos
  refine ⟨c, a, hc0, ha0, ?_⟩
  intro q₁ q₂ hq₁ hq₂ ξ₁ η₁ lam₁ ξ₂ η₂ lam₂ hext₁ hext₂ hreal₁ hreal₂ hnp₁ hnp₂ hnp₃
    G₁ G₂ hG₁d hG₂d heq₁ heq₂
  
  have hnorm1 : ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      (1:ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    intro q hq
    have hb : q ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hne : Ideal.absNorm q ≠ 0 := fun h => hb (Ideal.absNorm_eq_zero_iff.mp h)
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
  have hq₃ : q₁ * q₂ ≠ 0 := by
    intro h
    rw [Submodule.zero_eq_bot] at h
    rcases Ideal.mul_eq_bot.mp h with h1 | h1
    · exact hq₁ (by rwa [← Submodule.zero_eq_bot] at h1)
    · exact hq₂ (by rwa [← Submodule.zero_eq_bot] at h1)
  have hQ1 : (1:ℝ) ≤ (Ideal.absNorm (q₁ * q₂) : ℝ) := hnorm1 _ hq₃
  have hQ0 : (0:ℝ) < (Ideal.absNorm (q₁ * q₂) : ℝ) := by linarith
  have hQeq : ((Ideal.absNorm (q₁ * q₂) : ℕ) : ℝ)
      = (Ideal.absNorm q₁ : ℝ) * (Ideal.absNorm q₂ : ℝ) := by
    rw [map_mul]; push_cast; ring
  have htop0 : (⊤ : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Submodule.zero_eq_bot]; exact fun h => bot_ne_top h.symm
  have hNtop : ((Ideal.absNorm (⊤ : Ideal (NumberField.RingOfIntegers K)) : ℕ) : ℝ) = 1 := by
    have h : Ideal.absNorm (⊤ : Ideal (NumberField.RingOfIntegers K)) = 1 := by
      rw [← Ideal.one_eq_top]; exact map_one _
    rw [h]; norm_num
  have hone0 : (1 : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Ideal.one_eq_top, Submodule.zero_eq_bot]; exact fun h => bot_ne_top h.symm
  have htr : ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * (0 : NumberField.InfinitePlace K → ℝ) w = 0 := by simp
  have hinf : (1:ℝ) + (1 + (∑ w : NumberField.InfinitePlace K,
        |(0 : NumberField.InfinitePlace K → ℝ) w|)
      + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        |(((0 : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) p : ℤ) : ℝ)|) = 2 := by
    simp only [Pi.zero_apply, abs_zero, Finset.sum_const_zero, Int.cast_zero]
    norm_num
  
  have hvals : ∀ (q : Ideal (NumberField.RingOfIntegers K))
      (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
      (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      KaiHeckeExt K q 0 0 ξ η lam →
      (∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
      ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        lam I = 1 ∨ lam I = -1 ∨ lam I = 0 := by
    intro q ξ η lam hext hre I hI
    obtain ⟨-, -, hu, hzz, -, -⟩ := hext
    by_cases hc : I ⊔ q = ⊤
    · have h1 : ‖lam I‖ = 1 := hu I hI hc
      have him : (lam I).im = 0 := by
        have h := congrArg Complex.im (hre I)
        rw [Complex.conj_im] at h
        linarith
      have hreeq : lam I = (((lam I).re : ℝ) : ℂ) := by
        apply Complex.ext <;> simp [him]
      have h2 : |(lam I).re| = 1 := by
        rw [hreeq, Complex.norm_real, Real.norm_eq_abs] at h1
        exact h1
      rcases (abs_eq (by norm_num : (0:ℝ) ≤ 1)).mp h2 with h | h
      · left; rw [hreeq, h]; norm_num
      · right; left; rw [hreeq, h]; norm_num
    · right; right; exact hzz I hc
  have hval₁ := hvals q₁ ξ₁ η₁ lam₁ hext₁ hreal₁
  have hval₂ := hvals q₂ ξ₂ η₂ lam₂ hext₂ hreal₂
  have hnbaux : ∀ (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      lam 0 = 0 → (∀ I, I ≠ 0 → lam I = 1 ∨ lam I = -1 ∨ lam I = 0) →
      ∀ I, ‖lam I‖ ≤ 1 := by
    intro lam h0 hv I
    by_cases hI : I = 0
    · rw [hI, h0]; simp
    · rcases hv I hI with h | h | h <;> rw [h] <;> simp
  have hnb₁ : ∀ I, ‖lam₁ I‖ ≤ 1 := hnbaux lam₁ hext₁.2.2.2.2.1 hval₁
  have hnb₂ : ∀ I, ‖lam₂ I‖ ≤ 1 := hnbaux lam₂ hext₂.2.2.2.2.1 hval₂
  have hnb₃ : ∀ I, ‖lam₁ I * lam₂ I‖ ≤ 1 := by
    intro I
    rw [norm_mul]
    nlinarith [hnb₁ I, hnb₂ I, norm_nonneg (lam₁ I), norm_nonneg (lam₂ I)]
  
  obtain ⟨lam₀, ξ₀, η₀, hlam₀1, hlam₀0, hext₀, hpr₀⟩ :
      ∃ (lam₀ : Ideal (NumberField.RingOfIntegers K) → ℂ)
        (ξ₀ : ((NumberField.RingOfIntegers K ⧸
                (⊤ : Ideal (NumberField.RingOfIntegers K)))ˣ) →* Circle)
        (η₀ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → lam₀ I = 1) ∧
        lam₀ 0 = 0 ∧
        KaiHeckeExt K (⊤ : Ideal (NumberField.RingOfIntegers K)) 0 0 ξ₀ η₀ lam₀ ∧
        KaiHeckePrincipal K (⊤ : Ideal (NumberField.RingOfIntegers K)) lam₀ := by
    obtain ⟨f, hf1, hf0⟩ :
        ∃ f : Ideal (NumberField.RingOfIntegers K) → ℂ,
          (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → f I = 1) ∧ f 0 = 0 :=
      ⟨fun I => if I = 0 then (0 : ℂ) else 1, fun I hI => if_neg hI, if_pos rfl⟩
    refine ⟨f,
      (1 : ((NumberField.RingOfIntegers K ⧸
              (⊤ : Ideal (NumberField.RingOfIntegers K)))ˣ) →* Circle),
      (fun _ => false), hf1, hf0, ⟨?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · exact hf1 1 hone0
    · intro I J
      by_cases hI : I = 0
      · subst hI
        rw [zero_mul, hf0, zero_mul]
      · by_cases hJ : J = 0
        · subst hJ
          rw [mul_zero, hf0, mul_zero]
        · rw [hf1 _ (mul_ne_zero hI hJ), hf1 I hI, hf1 J hJ, mul_one]
    · intro I hI _
      rw [hf1 I hI, norm_one]
    · intro I h
      exact absurd (sup_top_eq I) h
    · exact hf0
    · intro α hα
      have hspan : Ideal.span {α} ≠ (0 : Ideal (NumberField.RingOfIntegers K)) := by
        intro h
        rw [Submodule.zero_eq_bot] at h
        exact hα (Ideal.span_singleton_eq_bot.mp h)
      have hx : IsUnit (Ideal.Quotient.mk
          (⊤ : Ideal (NumberField.RingOfIntegers K)) α) := isUnit_of_subsingleton _
      rw [hf1 _ hspan, kaiHeckeTwist, dif_pos hx]
      simp
    · intro I hI _
      exact hf1 I hI
  
  obtain ⟨ξ₃, η₃, hext₃⟩ :
      ∃ (ξ₃ : ((NumberField.RingOfIntegers K ⧸ (q₁ * q₂))ˣ) →* Circle)
        (η₃ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        KaiHeckeExt K (q₁ * q₂) 0 0 ξ₃ η₃ (fun I => lam₁ I * lam₂ I) := by
    obtain ⟨h₁1, h₁2, h₁3, h₁4, h₁5, h₁6⟩ := hext₁
    obtain ⟨h₂1, h₂2, h₂3, h₂4, h₂5, h₂6⟩ := hext₂
    have hle₁ : q₁ * q₂ ≤ q₁ := Ideal.mul_le_right
    have hle₂ : q₁ * q₂ ≤ q₂ := Ideal.mul_le_left
    obtain ⟨π₁, hπ₁⟩ :
        ∃ f : (NumberField.RingOfIntegers K ⧸ (q₁ * q₂)) →+*
            (NumberField.RingOfIntegers K ⧸ q₁),
          ∀ x : NumberField.RingOfIntegers K,
            f (Ideal.Quotient.mk (q₁ * q₂) x) = Ideal.Quotient.mk q₁ x :=
      ⟨Ideal.Quotient.factor hle₁, fun x => Ideal.Quotient.factor_mk hle₁ x⟩
    obtain ⟨π₂, hπ₂⟩ :
        ∃ f : (NumberField.RingOfIntegers K ⧸ (q₁ * q₂)) →+*
            (NumberField.RingOfIntegers K ⧸ q₂),
          ∀ x : NumberField.RingOfIntegers K,
            f (Ideal.Quotient.mk (q₁ * q₂) x) = Ideal.Quotient.mk q₂ x :=
      ⟨Ideal.Quotient.factor hle₂, fun x => Ideal.Quotient.factor_mk hle₂ x⟩
    obtain ⟨χ, hχ⟩ :
        ∃ f : ((NumberField.RingOfIntegers K ⧸ (q₁ * q₂))ˣ) →* Circle,
          ∀ u : ((NumberField.RingOfIntegers K ⧸ (q₁ * q₂))ˣ),
            f u = ξ₁ (Units.map π₁.toMonoidHom u) * ξ₂ (Units.map π₂.toMonoidHom u) :=
      ⟨(ξ₁.comp (Units.map π₁.toMonoidHom)) * (ξ₂.comp (Units.map π₂.toMonoidHom)),
        fun _ => rfl⟩
    have hsupA : ∀ I : Ideal (NumberField.RingOfIntegers K), I ⊔ (q₁ * q₂) = ⊤ →
        I ⊔ q₁ = ⊤ ∧ I ⊔ q₂ = ⊤ := by
      intro I hI
      constructor
      · have h := sup_le_sup_left hle₁ I
        rw [hI] at h
        exact top_le_iff.mp h
      · have h := sup_le_sup_left hle₂ I
        rw [hI] at h
        exact top_le_iff.mp h
    have hsupB : ∀ I : Ideal (NumberField.RingOfIntegers K),
        I ⊔ q₁ = ⊤ → I ⊔ q₂ = ⊤ → I ⊔ (q₁ * q₂) = ⊤ := by
      intro I ha hb
      exact Ideal.isCoprime_iff_sup_eq.mp
        ((Ideal.isCoprime_iff_sup_eq.mpr ha).mul_right (Ideal.isCoprime_iff_sup_eq.mpr hb))
    have hunit : ∀ x : NumberField.RingOfIntegers K,
        IsUnit (Ideal.Quotient.mk (q₁ * q₂) x) ↔
          (IsUnit (Ideal.Quotient.mk q₁ x) ∧ IsUnit (Ideal.Quotient.mk q₂ x)) := by
      intro x
      constructor
      · intro h
        constructor
        · have h' := h.map π₁
          rwa [hπ₁] at h'
        · have h' := h.map π₂
          rwa [hπ₂] at h'
      · rintro ⟨hu₁, hu₂⟩
        obtain ⟨b₁, hb₁⟩ := isUnit_iff_exists_inv.mp hu₁
        obtain ⟨b₂, hb₂⟩ := isUnit_iff_exists_inv.mp hu₂
        obtain ⟨β₁, rfl⟩ := Ideal.Quotient.mk_surjective b₁
        obtain ⟨β₂, rfl⟩ := Ideal.Quotient.mk_surjective b₂
        have e₁ : x * β₁ - 1 ∈ q₁ := by
          refine Ideal.Quotient.eq.mp ?_
          rw [map_mul, map_one]
          exact hb₁
        have e₂ : x * β₂ - 1 ∈ q₂ := by
          refine Ideal.Quotient.eq.mp ?_
          rw [map_mul, map_one]
          exact hb₂
        have hmem : x * (β₁ + β₂ - x * β₁ * β₂) - 1 ∈ q₁ * q₂ := by
          have hid : x * (β₁ + β₂ - x * β₁ * β₂) - 1
              = -((x * β₁ - 1) * (x * β₂ - 1)) := by ring
          rw [hid]
          exact Submodule.neg_mem _ (Ideal.mul_mem_mul e₁ e₂)
        refine isUnit_iff_exists_inv.mpr
          ⟨Ideal.Quotient.mk (q₁ * q₂) (β₁ + β₂ - x * β₁ * β₂), ?_⟩
        rw [← map_mul]
        have hone : (1 : NumberField.RingOfIntegers K ⧸ (q₁ * q₂))
            = Ideal.Quotient.mk (q₁ * q₂) 1 := by rw [map_one]
        rw [hone]
        exact Ideal.Quotient.eq.mpr hmem
    have htwP : ∀ (q : Ideal (NumberField.RingOfIntegers K))
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (x : NumberField.RingOfIntegers K) (hx : IsUnit (Ideal.Quotient.mk q x)),
        kaiHeckeTwist K q 0 0 ξ η x
          = (ξ hx.unit : ℂ) * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              if η w then
                ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
              else 1) := by
      intro q ξ η x hx
      simp only [kaiHeckeTwist]
      rw [dif_pos hx]
      simp
    have htwN : ∀ (q : Ideal (NumberField.RingOfIntegers K))
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (x : NumberField.RingOfIntegers K), ¬ IsUnit (Ideal.Quotient.mk q x) →
        kaiHeckeTwist K q 0 0 ξ η x = 0 := by
      intro q ξ η x hx
      simp only [kaiHeckeTwist]
      rw [dif_neg hx]
    have hsgn : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 →
        ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) *
            ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) = 1 := by
      intro x hx w
      have hK : ((x : K)) ≠ 0 := by
        intro h
        exact hx (by exact_mod_cast h)
      have hpos : 0 < (w : NumberField.InfinitePlace K) ((x : K)) :=
        NumberField.InfinitePlace.pos_iff.mpr hK
      have hnorm : (w : NumberField.InfinitePlace K) ((x : K))
          = ‖(NumberField.mixedEmbedding K ((x : K))).1 w‖ := by
        rw [← NumberField.mixedEmbedding.normAtPlace_apply
          (w : NumberField.InfinitePlace K) ((x : K))]
        exact NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.prop _
      have hv : (NumberField.mixedEmbedding K ((x : K))).1 w ≠ 0 := by
        have hn : 0 < ‖(NumberField.mixedEmbedding K ((x : K))).1 w‖ := by
          rw [← hnorm]; exact hpos
        exact norm_pos_iff.mp hn
      rcases lt_trichotomy ((NumberField.mixedEmbedding K ((x : K))).1 w) 0 with h | h | h
      · rw [Real.sign_of_neg h]; norm_num
      · exact absurd h hv
      · rw [Real.sign_of_pos h]; norm_num
    have hpt : ∀ (b₁ b₂ : Bool) (s : ℂ), s * s = 1 →
        (if xor b₁ b₂ then s else 1) = (if b₁ then s else 1) * (if b₂ then s else 1) := by
      intro b₁ b₂ s hs
      cases b₁ <;> cases b₂ <;> simp [hs]
    have hprodsgn : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 →
        (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if xor (η₁ w) (η₂ w) then
            ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) else 1)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η₁ w then
              ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ) else 1)
          * (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η₂ w then
              ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
              else 1) := by
      intro x hx
      rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl ?_
      intro w _
      exact hpt (η₁ w) (η₂ w) _ (hsgn x hx w)
    have hkey : ∀ (x : NumberField.RingOfIntegers K)
        (h₃ : IsUnit (Ideal.Quotient.mk (q₁ * q₂) x))
