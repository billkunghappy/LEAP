            NumberField.RingOfIntegers K) : K)) = 1 := by
        intro w
        have hpos : 0 < w (((ν.1).1.1 : K)) := NumberField.InfinitePlace.pos_iff.mpr hxν0
        have h2 : w (((((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) : K)) * w (((ν.1).1.1 : K))
            = 1 * w (((ν.1).1.1 : K)) := by
          rw [one_mul, ← hkey w, hshape w]
        exact mul_right_cancel₀ (ne_of_gt hpos) h2
      refine ⟨hCU, ?_⟩
      funext w
      show 2 * Real.log (w (((((ψ ν)⁻¹ * ψ μ : (NumberField.RingOfIntegers K)ˣ) :
        NumberField.RingOfIntegers K) : K))) = 0
      rw [hone w, Real.log_one, mul_zero]
    obtain ⟨hrfin, hrcard⟩ := hcount (Set.range ψ) hSrange
    haveI : Finite ↥(Set.range ψ) := hrfin
    haveI hFfin : Finite ↥({ν : Rep | J ν = J ν₀}) :=
      Finite.of_equiv _ (Equiv.ofInjective ψ hψinj).symm
    refine ⟨Set.toFinite _, ?_⟩
    rw [← Nat.card_range_of_injective hψinj]
    exact hrcard
  
  have hfg : ∀ ν : Rep,
      (|(Algebra.norm ℚ) (ν.1.1 : K)| : ℝ) ^ (-((3 : ℝ) / 2))
        = ((FractionalIdeal.absNorm
              (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
                : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) *
          ((Ideal.absNorm ((J ν : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-((3 : ℝ) / 2)) := by
    intro ν
    have hR : ((Ideal.absNorm ((J ν : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) :
          Ideal (NumberField.RingOfIntegers K)) : ℝ)) *
        ((FractionalIdeal.absNorm
          (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℚ) : ℝ)
