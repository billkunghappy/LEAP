  obtain ⟨Cst, hCst⟩ : ∃ cc : ℝ, cc = ∏ w : NumberField.InfinitePlace K,
      (Real.Gamma (zeta w) * Real.pi ^ (-(zeta w))) := ⟨_, rfl⟩
  have hPsiprod : ∀ (x : K) (u : NumberField.InfinitePlace K → ℝ),
      Psi x u = ‖kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K x)‖ *
        ∏ w : NumberField.InfinitePlace K,
          Real.exp (zeta w * u w - Real.pi * (w x) ^ 2 * Real.exp (u w)) := by
    intro x u
    have hsum2 : (∑ w : NumberField.InfinitePlace K,
          (zeta w * u w - Real.pi * (w x) ^ 2 * Real.exp (u w)))
        = (∑ w : NumberField.InfinitePlace K, zeta w * u w)
          - Real.pi * ∑ w : NumberField.InfinitePlace K, Real.exp (u w) * (w x) ^ 2 := by
      rw [Finset.sum_sub_distrib, Finset.mul_sum]
      exact congrArg _ (Finset.sum_congr rfl (fun w _ => by ring))
    rw [hPsi, ← Real.exp_sum, hsum2]
  have hGintval : ∀ x : K, x ≠ 0 →
      MeasureTheory.Integrable (fun u : NumberField.InfinitePlace K → ℝ => Psi x u)
          MeasureTheory.volume ∧
      (∫ u : NumberField.InfinitePlace K → ℝ, Psi x u)
        = Cst * ((|(Algebra.norm ℚ) x| : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) := by
    intro x hx
    have hxpos : ∀ w : NumberField.InfinitePlace K, 0 < w x :=
      fun w => NumberField.InfinitePlace.pos_iff.mpr hx
    have ha : ∀ w : NumberField.InfinitePlace K, 0 < Real.pi * (w x) ^ 2 :=
      fun w => mul_pos Real.pi_pos (pow_pos (hxpos w) 2)
    have hgp := hgamR (fun w : NumberField.InfinitePlace K => Real.pi * (w x) ^ 2) ha
      zeta hzetapos
    have heq : (fun u : NumberField.InfinitePlace K → ℝ => Psi x u)
        = fun u : NumberField.InfinitePlace K → ℝ =>
          ‖kaiHZArchWeight K η (fun p => -l p) (NumberField.mixedEmbedding K x)‖ *
            ∏ w : NumberField.InfinitePlace K,
              Real.exp (zeta w * u w - Real.pi * (w x) ^ 2 * Real.exp (u w)) :=
      funext (fun u => hPsiprod x u)
    refine ⟨by rw [heq]; exact hgp.1.const_mul _, ?_⟩
    rw [heq, MeasureTheory.integral_const_mul, hgp.2, hnA x hx]
    have hA : ∀ w : NumberField.InfinitePlace K,
        Real.Gamma (zeta w) * (Real.pi * (w x) ^ 2) ^ (-(zeta w))
          = (Real.Gamma (zeta w) * Real.pi ^ (-(zeta w))) * (w x) ^ (-(2 * zeta w)) := by
      intro w
      have h2 : ((w x) ^ 2 : ℝ) ^ (-(zeta w)) = (w x) ^ (-(2 * zeta w)) := by
        rw [← Real.rpow_natCast (w x) 2, ← Real.rpow_mul (hxpos w).le]
        norm_num
      rw [Real.mul_rpow Real.pi_pos.le (by positivity), h2]
      ring
    have hB : (∏ w : NumberField.InfinitePlace K, (w x) ^ (kaiHZDeg K η l w)) *
        (∏ w : NumberField.InfinitePlace K, (w x) ^ (-(2 * zeta w)))
        = ((|(Algebra.norm ℚ) x| : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) := by
      rw [← Finset.prod_mul_distrib, ← hnormpow x hx (-((3 : ℝ) / 2))]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [← Real.rpow_add (hxpos w)]
      have hd := hzetad w
      exact congrArg _ (by linarith)
    rw [Finset.prod_congr rfl (fun w _ => hA w), Finset.prod_mul_distrib, ← hCst]
    have hrw : (∏ w : NumberField.InfinitePlace K, (w x) ^ (kaiHZDeg K η l w)) *
        (Cst * ∏ w : NumberField.InfinitePlace K, (w x) ^ (-(2 * zeta w)))
        = Cst * ((∏ w : NumberField.InfinitePlace K, (w x) ^ (kaiHZDeg K η l w)) *
          ∏ w : NumberField.InfinitePlace K, (w x) ^ (-(2 * zeta w))) := by ring
    rw [hrw, hB]
  have hcsum : Summable (fun ν₀ : {ν₀ : K // ν₀ ∈ Rep} =>
      Cst * ((|(Algebra.norm ℚ) (ν₀ : K)| : ℚ) : ℝ) ^ (-((3 : ℝ) / 2))) := hRep3.mul_left Cst
  
  have hunfoldE : ∀ x : K,
      (∑' v : {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
          ∫⁻ u in F2, ENNReal.ofReal (Psi x (u + (pmap v : NumberField.InfinitePlace K → ℝ))))
        = (wq : ENNReal) * ∫⁻ u : NumberField.InfinitePlace K → ℝ, ENNReal.ofReal (Psi x u) := by
    intro x
    haveI : Countable ↥Lat := hcount
    have hfinf : ∀ γ : ↥Lat, Finite {v : {v : (NumberField.RingOfIntegers K)ˣ //
        KaiMFCongUnit K q v} // pmap v = γ} := by
      intro γ
      have h0 : 0 < Nat.card {v : {v : (NumberField.RingOfIntegers K)ˣ //
          KaiMFCongUnit K q v} // pmap v = γ} := by
        rw [hfib' γ]; exact hwq
      exact (Nat.card_pos_iff.mp h0).2
    have hconstE : ∀ (γ : ↥Lat) (y : ENNReal),
        (∑' _c : {v : {v : (NumberField.RingOfIntegers K)ˣ //
          KaiMFCongUnit K q v} // pmap v = γ}, y) = (wq : ENNReal) * y := by
      intro γ y
      haveI := hfinf γ
      haveI : Fintype {v : {v : (NumberField.RingOfIntegers K)ˣ //
          KaiMFCongUnit K q v} // pmap v = γ} := Fintype.ofFinite _
      rw [tsum_fintype, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
        hfib' γ, nsmul_eq_mul]
    have hcollapseE : ∀ h : ↥Lat → ENNReal,
        (∑' v : {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}, h (pmap v))
          = (wq : ENNReal) * ∑' γ : ↥Lat, h γ := by
      intro h
      calc (∑' v : {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}, h (pmap v))
          = ∑' qq : (γ : ↥Lat) × {v : {v : (NumberField.RingOfIntegers K)ˣ //
              KaiMFCongUnit K q v} // pmap v = γ}, h qq.1 := by
            rw [← Equiv.tsum_eq (Equiv.sigmaFiberEquiv pmap) (fun v => h (pmap v))]
            exact tsum_congr (fun qq => congrArg h qq.2.2)
        _ = ∑' γ : ↥Lat, ∑' _c : {v : {v : (NumberField.RingOfIntegers K)ˣ //
              KaiMFCongUnit K q v} // pmap v = γ}, h γ :=
            ENNReal.tsum_sigma' (fun qq => h qq.1)
        _ = ∑' γ : ↥Lat, (wq : ENNReal) * h γ := tsum_congr (fun γ => hconstE γ (h γ))
        _ = (wq : ENNReal) * ∑' γ : ↥Lat, h γ := ENNReal.tsum_mul_left
    have hshiftL : ∀ (γ : ↥Lat) (u : NumberField.InfinitePlace K → ℝ),
        (γ +ᵥ u : NumberField.InfinitePlace K → ℝ) = u + (γ : NumberField.InfinitePlace K → ℝ) := by
      intro γ u
      show (γ : NumberField.InfinitePlace K → ℝ) + u = u + (γ : NumberField.InfinitePlace K → ℝ)
      exact add_comm _ _
    have hlint2 : (∫⁻ u : NumberField.InfinitePlace K → ℝ, ENNReal.ofReal (Psi x u))
        = ∑' γ : ↥Lat, ∫⁻ u in F2,
            ENNReal.ofReal (Psi x (u + (γ : NumberField.InfinitePlace K → ℝ))) := by
      rw [hfd2.lintegral_eq_tsum'' (fun u => ENNReal.ofReal (Psi x u))]
      exact tsum_congr (fun γ =>
        MeasureTheory.lintegral_congr (fun u => by rw [hshiftL γ u]))
    rw [hlint2]
    exact hcollapseE (fun γ : ↥Lat => ∫⁻ u in F2,
      ENNReal.ofReal (Psi x (u + (γ : NumberField.InfinitePlace K → ℝ))))
  have hfin : (∑' z : {ν₀ : K // ν₀ ∈ Rep} ×
      {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
        ∫⁻ u in F2, ENNReal.ofReal (Psi (z.1 : K)
          (u + (pmap z.2 : NumberField.InfinitePlace K → ℝ)))) ≠ ⊤ := by
    have hc0 : ∀ i : {ν₀ : K // ν₀ ∈ Rep},
        0 ≤ Cst * ((|(Algebra.norm ℚ) (i : K)| : ℚ) : ℝ) ^ (-((3 : ℝ) / 2)) := by
      intro i
      rw [← (hGintval (i : K) (hRep1 _ i.2).1).2]
      exact MeasureTheory.integral_nonneg (fun u => hPsinn _ u)
    have key : ∀ i : {ν₀ : K // ν₀ ∈ Rep},
        (∑' v : {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
          ∫⁻ u in F2, ENNReal.ofReal (Psi (i : K)
            (u + (pmap v : NumberField.InfinitePlace K → ℝ))))
          = (wq : ENNReal) * ENNReal.ofReal
              (Cst * ((|(Algebra.norm ℚ) (i : K)| : ℚ) : ℝ) ^ (-((3 : ℝ) / 2))) := by
      intro i
      rw [hunfoldE (i : K), ← MeasureTheory.ofReal_integral_eq_lintegral_ofReal
        (hGintval (i : K) (hRep1 _ i.2).1).1
        (Filter.Eventually.of_forall (hPsinn (i : K))), (hGintval (i : K) (hRep1 _ i.2).1).2]
    have hsumE : (∑' z : {ν₀ : K // ν₀ ∈ Rep} ×
        {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
          ∫⁻ u in F2, ENNReal.ofReal (Psi (z.1 : K)
            (u + (pmap z.2 : NumberField.InfinitePlace K → ℝ))))
        = (wq : ENNReal) * ENNReal.ofReal (∑' i : {ν₀ : K // ν₀ ∈ Rep},
            Cst * ((|(Algebra.norm ℚ) (i : K)| : ℚ) : ℝ) ^ (-((3 : ℝ) / 2))) := by
      rw [ENNReal.tsum_prod', tsum_congr key, ENNReal.tsum_mul_left,
        ENNReal.ofReal_tsum_of_nonneg hc0 hcsum]
    rw [hsumE]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top wq) ENNReal.ofReal_ne_top
  have hmemmul : ∀ (v : (NumberField.RingOfIntegers K)ˣ) (y : K),
      y ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) →
      (((v : NumberField.RingOfIntegers K) : K)) * y ∈
        (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) := by
    intro v y hy
    have hy' : y ∈ ((bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K) :
        Submodule (NumberField.RingOfIntegers K) K) := hy
    have h := Submodule.smul_mem _ (v : NumberField.RingOfIntegers K) hy'
    rw [Algebra.smul_def] at h
    exact h
  let emap : ({ν₀ : K // ν₀ ∈ Rep} ×
      {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}) →
      {ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} // ((ν : K) ≠ 0)} :=
    fun z => ⟨⟨(((z.2 : (NumberField.RingOfIntegers K)ˣ) :
          NumberField.RingOfIntegers K) : K) * (z.1 : K),
        hmemmul _ _ (hRep1 _ z.1.2).2⟩,
      mul_ne_zero (hunitne _) (hRep1 _ z.1.2).1⟩
  have hemapbij : Function.Bijective emap := by
    constructor
    · intro z1 z2 h
      have hval : (((z1.2 : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) : K) * (z1.1 : K)
          = (((z2.2 : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) : K) * (z2.1 : K) :=
        congrArg Subtype.val (congrArg Subtype.val h)
      obtain ⟨pr, hpr, huniq⟩ := hRep2
        ((((z1.2 : (NumberField.RingOfIntegers K)ˣ) :
          NumberField.RingOfIntegers K) : K) * (z1.1 : K))
        (mul_ne_zero (hunitne _) (hRep1 _ z1.1.2).1)
        (hmemmul _ _ (hRep1 _ z1.1.2).2)
      exact (huniq z1 rfl).trans (huniq z2 hval).symm
    · intro ν
      obtain ⟨pr, hpr, -⟩ := hRep2 (ν.1 : K) ν.2 ν.1.2
      exact ⟨pr, Subtype.ext (Subtype.ext hpr.symm)⟩
  let ebij : ({ν₀ : K // ν₀ ∈ Rep} ×
      {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}) ≃
      {ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} // ((ν : K) ≠ 0)} :=
    Equiv.ofBijective emap hemapbij
  have hreindex : (∑' ν : {ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} // ((ν : K) ≠ 0)},
        ∫⁻ u in F2, ENNReal.ofReal (Psi (ν.1 : K) u))
      = ∑' z : ({ν₀ : K // ν₀ ∈ Rep} ×
          {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v}),
          ∫⁻ u in F2, ENNReal.ofReal (Psi (z.1 : K)
            (u + (pmap z.2 : NumberField.InfinitePlace K → ℝ))) := by
    rw [← Equiv.tsum_eq ebij
      (fun ν : {ν : {x : K // x ∈ (bf : FractionalIdeal
        (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} // ((ν : K) ≠ 0)} =>
        ∫⁻ u in F2, ENNReal.ofReal (Psi (ν.1 : K) u))]
    refine tsum_congr (fun z => ?_)
    refine MeasureTheory.lintegral_congr (fun u => ?_)
    have hv : ((ebij z).1 : K)
        = (((z.2 : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) : K) * (z.1 : K) := rfl
    rw [hv]
    exact congrArg ENNReal.ofReal
      (hshift (z.2 : (NumberField.RingOfIntegers K)ˣ) (z.1 : K) (hRep1 _ z.1.2).1 u)
  
  have hcwdef : ∀ (γ : NumberField.InfinitePlace K → ℂ)
      (u : NumberField.InfinitePlace K → ℝ),
      kaiMFConeWeight K γ u
        = Complex.exp (∑ w : NumberField.InfinitePlace K, γ w * ((u w : ℝ) : ℂ)) :=
    fun _ _ => rfl
  have hcwsplit : ∀ u : NumberField.InfinitePlace K → ℝ,
      kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)) u *
        kaiMFConeWeight K (fun w => kaiMFConeZdual K t l η (1 - s) w
          - ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)) u
        = kaiMFConeWeight K (kaiMFConeZdual K t l η (1 - s)) u := by
    intro u
    rw [hcwdef, hcwdef, hcwdef, ← Complex.exp_add, ← Finset.sum_add_distrib]
    exact congrArg Complex.exp (Finset.sum_congr rfl (fun w _ => by ring))
  have hcontrest : Continuous (fun u : NumberField.InfinitePlace K → ℝ =>
      kaiMFConeWeight K (fun w => kaiMFConeZdual K t l η (1 - s) w
        - ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)) u) := by
    have h : (fun u : NumberField.InfinitePlace K → ℝ =>
        kaiMFConeWeight K (fun w => kaiMFConeZdual K t l η (1 - s) w
          - ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)) u)
        = fun u : NumberField.InfinitePlace K → ℝ =>
          Complex.exp (∑ w : NumberField.InfinitePlace K,
            (kaiMFConeZdual K t l η (1 - s) w - ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)) *
              ((u w : ℝ) : ℂ)) := funext (fun u => hcwdef _ u)
    rw [h]
    exact Complex.continuous_exp.comp (continuous_finset_sum _ (fun w _ =>
      continuous_const.mul (Complex.continuous_ofReal.comp (continuous_apply w))))
  have hmeas0 := (kai_mf_cone_thetachar_shift_decay bf vv η l
      (fun w : NumberField.InfinitePlace K => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ))
      (fun w => Complex.ofReal_re _) 1 0 le_rfl hsumD).1
  have hmeasPhi : Measurable Phi := by
    have h : Phi = fun u : NumberField.InfinitePlace K → ℝ =>
        ((kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => Real.exp (u w)) -
            kaiHZArchWeight K η (fun p => -l p) 0) *
          kaiMFConeWeight K (fun w => ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)) u) *
          kaiMFConeWeight K (fun w => kaiMFConeZdual K t l η (1 - s) w
            - ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)) u := by
      funext u
      rw [hPhiapp u, mul_assoc, hcwsplit u]
    rw [h]
    exact hmeas0.mul hcontrest.measurable
  refine ⟨hmeasPhi.aestronglyMeasurable, ?_⟩
  rw [MeasureTheory.hasFiniteIntegral_iff_enorm]
  refine lt_of_le_of_lt hlint ?_
  rw [hreindex]
  exact lt_top_iff_ne_top.mpr hfin

theorem kai_mf_cone_gaussian_coeff_unique {J : Type*} [Fintype J] {ι : Type*} [Countable ι]
    (a : ι → J → ℝ) (ha0 : ∀ i j, 0 ≤ a i j) (hainj : Function.Injective a)
    (hlocfin : ∀ M : ℝ, {i : ι | ∑ j, a i j ≤ M}.Finite)
    (c : ι → ℂ)
    (hsum : ∀ x : J → ℝ, (∀ j, 0 < x j) →
      Summable (fun i => ‖c i‖ * Real.exp (-∑ j, x j * a i j)))
    (hzero : ∀ x : J → ℝ, (∀ j, 0 < x j) →
      ∑' i, c i * ((Real.exp (-∑ j, x j * a i j) : ℝ) : ℂ) = 0) :
    ∀ i, c i = 0 :=
by
  classical
  
  obtain ⟨w, hw1, hwinj⟩ : ∃ w : J → ℝ, (∀ j, 1 ≤ w j) ∧
      Function.Injective (fun i => ∑ j, w j * a i j) := by
    let H : ι × ι → Set (J → ℝ) := fun p =>
      {v | p.1 ≠ p.2 ∧ ∑ j, v j * a p.1 j = ∑ j, v j * a p.2 j}
    have hH : ∀ p, MeasureTheory.volume (H p) = 0 := by
      rintro ⟨i, k⟩
      by_cases hik : i = k
      · have hemp : H (i, k) = ∅ := by
          ext v; simp [H, hik]
        rw [hemp]; exact MeasureTheory.measure_empty
      · obtain ⟨j₀, hj₀⟩ : ∃ j₀, a i j₀ - a k j₀ ≠ 0 := by
          by_contra hc
          push_neg at hc
          exact hik (hainj (funext fun j => sub_eq_zero.mp (hc j)))
        let φ : (J → ℝ) →ₗ[ℝ] ℝ := Fintype.linearCombination ℝ (a i - a k)
        have hφ : ∀ v, φ v = ∑ j, v j * (a i j - a k j) := by
          intro v
          simp [φ, Fintype.linearCombination_apply, smul_eq_mul]
        have hne : LinearMap.ker φ ≠ ⊤ := by
          intro htop
          have hmem : (Pi.single j₀ (1 : ℝ) : J → ℝ) ∈ LinearMap.ker φ := by
            rw [htop]; exact Submodule.mem_top
          rw [LinearMap.mem_ker, hφ] at hmem
          rw [Finset.sum_eq_single j₀] at hmem
          · simp at hmem
            exact hj₀ (by linarith)
          · intro b _ hb
            simp [hb]
          · intro h; exact absurd (Finset.mem_univ j₀) h
        have hsub : H (i, k) ⊆ (LinearMap.ker φ : Set (J → ℝ)) := by
          intro v hv
          obtain ⟨-, hv⟩ := hv
          show φ v = 0
          rw [hφ]
          simp only [mul_sub, Finset.sum_sub_distrib]
          simp only at hv
          rw [hv, sub_self]
        exact MeasureTheory.measure_mono_null hsub
          (MeasureTheory.Measure.addHaar_submodule MeasureTheory.volume _ hne)
    have hU : MeasureTheory.volume (⋃ p, H p) = 0 := MeasureTheory.measure_iUnion_null hH
    have hB : MeasureTheory.volume (Set.Icc (fun _ : J => (1 : ℝ)) (fun _ => 2)) = 1 := by
      rw [Real.volume_Icc_pi]; norm_num
    have hns : ¬ (Set.Icc (fun _ : J => (1 : ℝ)) (fun _ => 2) ⊆ ⋃ p, H p) := by
      intro hsub
      have h0 := MeasureTheory.measure_mono_null hsub hU
      rw [hB] at h0
      exact one_ne_zero h0
    rw [Set.not_subset] at hns
    obtain ⟨v, hvB, hvU⟩ := hns
    refine ⟨v, fun j => hvB.1 j, ?_⟩
    intro i k hik
    by_contra hne
    exact hvU (Set.mem_iUnion.mpr ⟨(i, k), hne, hik⟩)
  
  obtain ⟨L, hL⟩ : ∃ L : ι → ℝ, L = fun i => ∑ j, w j * a i j := ⟨_, rfl⟩
  have hLinj : Function.Injective L := by rw [hL]; exact hwinj
  have hLfin : ∀ M : ℝ, {i : ι | L i ≤ M}.Finite := by
    intro M
    refine (hlocfin M).subset ?_
    intro i hi
    simp only [Set.mem_setOf_eq, hL] at hi ⊢
    exact le_trans (Finset.sum_le_sum fun j _ => le_mul_of_one_le_left (ha0 i j) (hw1 j)) hi
  have hx : ∀ t : ℝ, 0 < t → ∀ j, 0 < t * w j := fun t ht j =>
    mul_pos ht (by linarith [hw1 j])
  have hexp : ∀ t : ℝ, ∀ i, ∑ j, t * w j * a i j = t * L i := by
    intro t i
    simp only [hL, Finset.mul_sum, mul_assoc]
  have hsum' : ∀ t : ℝ, 0 < t → Summable (fun i => ‖c i‖ * Real.exp (-(t * L i))) := by
    intro t ht
    have h := hsum (fun j => t * w j) (hx t ht)
    simp only [hexp] at h
    exact h
  have hzero' : ∀ t : ℝ, 0 < t → ∑' i, c i * ((Real.exp (-(t * L i)) : ℝ) : ℂ) = 0 := by
    intro t ht
    have h := hzero (fun j => t * w j) (hx t ht)
    simp only [hexp] at h
    exact h
  
  intro i₁
  by_contra h₁
  let F : Finset ι := (hLfin (L i₁)).toFinset.filter (fun i => c i ≠ 0)
  have hi₁F : i₁ ∈ F := by simp [F, h₁]
  obtain ⟨is, hisF, hmin⟩ := F.exists_min_image L ⟨i₁, hi₁F⟩
  have hcis : c is ≠ 0 := (Finset.mem_filter.mp hisF).2
  obtain ⟨μ, hμ⟩ : ∃ μ, μ = L is := ⟨_, rfl⟩
  have hsupp : ∀ i, c i ≠ 0 → μ ≤ L i := by
    intro i hi
    rw [hμ]
    by_cases hle : L i ≤ L i₁
    · exact hmin i (by simp [F, hle, hi])
    · exact le_trans (hmin i₁ hi₁F) (not_le.mp hle).le
  have hstrict : ∀ i, c i ≠ 0 → i ≠ is → μ < L i := by
    intro i hi hne
    refine lt_of_le_of_ne (hsupp i hi) ?_
    intro h
    rw [hμ] at h
    exact hne (hLinj h).symm
  have hT1 : Filter.Tendsto
      (fun t : ℝ => ∑' i, c i * ((Real.exp (-(t * (L i - μ))) : ℝ) : ℂ))
      Filter.atTop (nhds 0) := by
    apply tendsto_const_nhds.congr'
    filter_upwards [Filter.eventually_gt_atTop 0] with t ht
    have e : ∀ i, c i * ((Real.exp (-(t * (L i - μ))) : ℝ) : ℂ)
        = ((Real.exp (t * μ) : ℝ) : ℂ) * (c i * ((Real.exp (-(t * L i)) : ℝ) : ℂ)) := by
      intro i
      rw [show -(t * (L i - μ)) = t * μ + -(t * L i) by ring, Real.exp_add]
      push_cast
      ring
    show (0 : ℂ) = _
    rw [tsum_congr e, tsum_mul_left, hzero' t ht, mul_zero]
  have hbound : Summable (fun i => ‖c i‖ * Real.exp (-(L i - μ))) := by
    refine ((hsum' 1 one_pos).mul_left (Real.exp μ)).congr ?_
    intro i
    rw [show -(L i - μ) = μ + -(1 * L i) by ring, Real.exp_add]
    ring
  have hlim : ∀ i, Filter.Tendsto
      (fun t : ℝ => c i * ((Real.exp (-(t * (L i - μ))) : ℝ) : ℂ))
      Filter.atTop (nhds (if i = is then c is else 0)) := by
    intro i
    by_cases hi : i = is
    · rw [if_pos hi, hi, ← hμ]
      simpa using tendsto_const_nhds
    · rw [if_neg hi]
      by_cases hci : c i = 0
      · simp [hci]
      · have hδ : 0 < L i - μ := sub_pos.mpr (hstrict i hci hi)
        have h1 : Filter.Tendsto (fun t : ℝ => t * (L i - μ)) Filter.atTop Filter.atTop :=
          Filter.tendsto_id.atTop_mul_const hδ
        have h2 : Filter.Tendsto (fun t : ℝ => Real.exp (-(t * (L i - μ)))) Filter.atTop
            (nhds 0) :=
          Real.tendsto_exp_neg_atTop_nhds_zero.comp h1
        have h3 : Filter.Tendsto (fun t : ℝ => ((Real.exp (-(t * (L i - μ))) : ℝ) : ℂ))
            Filter.atTop (nhds ((0 : ℝ) : ℂ)) :=
          (Complex.continuous_ofReal.tendsto 0).comp h2
        have h4 := h3.const_mul (c i)
        rw [Complex.ofReal_zero, mul_zero] at h4
        exact h4
  have hdom : ∀ᶠ t : ℝ in Filter.atTop, ∀ i,
      ‖c i * ((Real.exp (-(t * (L i - μ))) : ℝ) : ℂ)‖ ≤ ‖c i‖ * Real.exp (-(L i - μ)) := by
    filter_upwards [Filter.eventually_ge_atTop 1] with t ht i
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.exp_pos _).le]
    by_cases hci : c i = 0
    · simp [hci]
    · apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
      apply Real.exp_le_exp.mpr
      have h := hsupp i hci
      nlinarith [mul_nonneg (sub_nonneg.mpr ht) (sub_nonneg.mpr h)]
  have hT2 := tendsto_tsum_of_dominated_convergence hbound hlim hdom
  rw [tsum_ite_eq] at hT2
  exact hcis (tendsto_nhds_unique hT2 hT1)

theorem kai_mf_cone_fundamental_unfold {J : Type*} [Fintype J] {V : Type*}
    (Lat : AddSubgroup (J → ℝ)) (hcount : Countable ↥Lat)
    (F : Set (J → ℝ))
    (hfd : MeasureTheory.IsAddFundamentalDomain (↥Lat) F MeasureTheory.volume)
    (p : V → ↥Lat) (m : ℕ) (hm : 0 < m)
    (hfib : ∀ γ : ↥Lat, Nat.card {v : V // p v = γ} = m)
    (f : (J → ℝ) → ℂ) :
    (∑' v : V, ∫⁻ u in F, ‖f (u + (p v : J → ℝ))‖ₑ)
        = (m : ENNReal) * ∫⁻ u : J → ℝ, ‖f u‖ₑ ∧
      (MeasureTheory.Integrable f MeasureTheory.volume →
        Summable (fun v : V => ∫ u in F, f (u + (p v : J → ℝ))) ∧
        (∑' v : V, ∫ u in F, f (u + (p v : J → ℝ)))
          = (m : ℂ) * ∫ u : J → ℝ, f u) :=
by
  classical
  haveI := hcount
  
  have hfin : ∀ γ : ↥Lat, Finite {v : V // p v = γ} := by
    intro γ
    have h : 0 < Nat.card {v : V // p v = γ} := by rw [hfib γ]; exact hm
    exact (Nat.card_pos_iff.mp h).2
  let e := Equiv.sigmaFiberEquiv p
  
  have fibE : ∀ g : ↥Lat → ENNReal, (∑' v : V, g (p v)) = (m : ENNReal) * ∑' γ, g γ := by
    intro g
    rw [← e.tsum_eq]
    have hc : (fun x : (Σ γ : ↥Lat, {v : V // p v = γ}) => g (p (e x))) = fun x => g x.1 := by
      funext x
      exact congrArg g x.2.2
    rw [hc, ENNReal.tsum_sigma']
    have hin : ∀ γ : ↥Lat, (∑' _ : {v : V // p v = γ}, g γ) = (m : ENNReal) * g γ := by
      intro γ
      haveI := hfin γ
      haveI := Fintype.ofFinite {v : V // p v = γ}
      rw [tsum_fintype, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
        hfib γ, nsmul_eq_mul]
    simp_rw [hin]
    rw [ENNReal.tsum_mul_left]
  
  have fibC : ∀ g : ↥Lat → ℂ, Summable (fun γ => ‖g γ‖) →
      Summable (fun v : V => g (p v)) ∧ (∑' v : V, g (p v)) = (m : ℂ) * ∑' γ, g γ := by
    intro g hg
    have hg' : Summable (fun γ => ‖g γ‖₊) := by
      rw [← NNReal.summable_coe]; simpa using hg
    have h1 : (∑' γ, ((‖g γ‖₊ : NNReal) : ENNReal)) ≠ ⊤ :=
      ENNReal.tsum_coe_ne_top_iff_summable.mpr hg'
    have h2 : (∑' v, ((‖g (p v)‖₊ : NNReal) : ENNReal)) ≠ ⊤ := by
      have := fibE (fun γ => ((‖g γ‖₊ : NNReal) : ENNReal))
      simp only at this
      rw [this]
      exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top m) h1
    have h3 := ENNReal.tsum_coe_ne_top_iff_summable.mp h2
    rw [← NNReal.summable_coe] at h3
    have hsumN : Summable (fun v : V => ‖g (p v)‖) := by simpa using h3
    have hS : Summable (fun v : V => g (p v)) := hsumN.of_norm
    refine ⟨hS, ?_⟩
    have hH0 := (e.hasSum_iff (f := fun v => g (p v))).mpr hS.hasSum
    have heq : (fun v => g (p v)) ∘ e = fun x : (Σ γ : ↥Lat, {v : V // p v = γ}) => g x.1 := by
      funext x
      exact congrArg g x.2.2
    rw [heq] at hH0
    have hfibsum : ∀ γ : ↥Lat,
        HasSum (fun _ : {v : V // p v = γ} => g γ) ((m : ℂ) * g γ) := by
      intro γ
      haveI := hfin γ
      haveI := Fintype.ofFinite {v : V // p v = γ}
      have := hasSum_fintype (fun _ : {v : V // p v = γ} => g γ)
      rwa [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, hfib γ,
        nsmul_eq_mul] at this
    have h4 := hH0.sigma hfibsum
    have h5 : HasSum (fun γ => (m : ℂ) * g γ) ((m : ℂ) * ∑' γ, g γ) :=
      (hg.of_norm).hasSum.mul_left (m : ℂ)
    exact h4.unique h5
  
  have htr : ∀ (γ : ↥Lat) (u : J → ℝ), γ +ᵥ u = u + (γ : J → ℝ) := by
    intro γ u
    rw [AddSubgroup.vadd_def, vadd_eq_add, add_comm]
  
  have hL : (∑' γ : ↥Lat, ∫⁻ u in F, ‖f (u + (γ : J → ℝ))‖ₑ) = ∫⁻ u, ‖f u‖ₑ := by
    rw [hfd.lintegral_eq_tsum'' (fun x => ‖f x‖ₑ)]
    refine tsum_congr (fun γ => ?_)
    refine MeasureTheory.lintegral_congr (fun u => ?_)
    simp only [htr]
  
  have hI : MeasureTheory.Integrable f MeasureTheory.volume →
      (∑' γ : ↥Lat, ∫ u in F, f (u + (γ : J → ℝ))) = ∫ u, f u := by
    intro hf
    rw [hfd.integral_eq_tsum'' f hf]
    refine tsum_congr (fun γ => ?_)
    simp only [htr]
  
  have hGs : MeasureTheory.Integrable f MeasureTheory.volume →
      Summable (fun γ : ↥Lat => ‖∫ u in F, f (u + (γ : J → ℝ))‖) := by
    intro hf
    have hfin' : (∑' γ : ↥Lat, ∫⁻ u in F, ‖f (u + (γ : J → ℝ))‖ₑ) ≠ ⊤ := by
      rw [hL]; exact ne_of_lt hf.2
    have hb := ENNReal.summable_toReal hfin'
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun γ => ?_) hb
    have := MeasureTheory.norm_integral_le_lintegral_norm
      (μ := MeasureTheory.volume.restrict F) (fun u => f (u + (γ : J → ℝ)))
    simpa only [ofReal_norm_eq_enorm] using this
  refine ⟨?_, fun hf => ?_⟩
  · have h := fibE (fun γ : ↥Lat => ∫⁻ u in F, ‖f (u + (γ : J → ℝ))‖ₑ)
    simp only [hL] at h
    exact h
  · obtain ⟨hS, hV⟩ := fibC (fun γ : ↥Lat => ∫ u in F, f (u + (γ : J → ℝ))) (hGs hf)
    simp only [hI hf] at hV
    exact ⟨hS, hV⟩

theorem kai_mf_cone_dual_unit_equivariance {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (a : Ideal (NumberField.RingOfIntegers K)) (ha : a ≠ 0)
    (ρ₀ : NumberField.RingOfIntegers K)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (bf : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (vv : NumberField.mixedEmbedding.mixedSpace K) (κ : ℂ) (hκ0 : κ ≠ 0)
    (r : NumberField.InfinitePlace K → ℝ) (hr : ∀ w, 0 < r w)
    (hlaw : ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
        kaiHZIdealTheta K a (NumberField.mixedEmbedding K ((ρ₀ : K))) η l y
          = κ * (((∏ w : NumberField.InfinitePlace K,
                y w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ) *
              kaiHZIdealThetaChar K bf vv η (fun p => -l p) (fun w => r w / y w))
    (v' : (NumberField.RingOfIntegers K)ˣ)
    (hv'ρ : (v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀ ∈ a)
    (Y : NumberField.InfinitePlace K → ℝ) (hY : ∀ w, 0 < Y w) :
    kaiHZArchWeight K η l
          (NumberField.mixedEmbedding K (((v' : NumberField.RingOfIntegers K) : K))) *
        kaiHZIdealThetaChar K bf vv η (fun p => -l p)
          (fun w => Y w / (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2)
      = ((∏ w : NumberField.InfinitePlace K,
            (w (((v' : NumberField.RingOfIntegers K) : K))) ^
              (2 * kaiHZDeg K η l w) : ℝ) : ℂ) *
          kaiHZIdealThetaChar K bf vv η (fun p => -l p) Y :=
by
  classical
  have hVunit : IsUnit (((v' : NumberField.RingOfIntegers K) : K)) :=
    (Units.isUnit v').map (algebraMap (NumberField.RingOfIntegers K) K)
  have hV0 : (((v' : NumberField.RingOfIntegers K) : K)) ≠ 0 := hVunit.ne_zero
  have hc : ∀ w : NumberField.InfinitePlace K,
      0 < w (((v' : NumberField.RingOfIntegers K) : K)) :=
    fun w => NumberField.InfinitePlace.pos_iff.mpr hV0
  have hcplx : ∀ (n : ℤ) (z₁ z₂ : ℂ),
      kaiHZCplxWeight n (z₁ * z₂) = kaiHZCplxWeight n z₁ * kaiHZCplxWeight n z₂ := by
    intro n z₁ z₂
    have hdefc : ∀ (m : ℤ) (z : ℂ), kaiHZCplxWeight m z
        = if 0 ≤ m then z ^ m.toNat else (starRingEnd ℂ) z ^ (-m).toNat := fun _ _ => rfl
    rw [hdefc, hdefc, hdefc]
    split_ifs with h
    · exact mul_pow _ _ _
    · rw [map_mul]
      exact mul_pow _ _ _
  have hAdef : ∀ X : NumberField.mixedEmbedding.mixedSpace K,
      kaiHZArchWeight K η l X
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            if η w then ((X.1 w : ℝ) : ℂ) else 1) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            kaiHZCplxWeight (l p) (X.2 p) := fun _ => rfl
  have harch : ∀ x z : NumberField.mixedEmbedding.mixedSpace K,
      kaiHZArchWeight K η l (x * z)
        = kaiHZArchWeight K η l x * kaiHZArchWeight K η l z := by
    intro x z
    have e1 : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (if η w then (((x * z).1 w : ℝ) : ℂ) else 1)
          = (if η w then ((x.1 w : ℝ) : ℂ) else 1) *
              (if η w then ((z.1 w : ℝ) : ℂ) else 1) := by
      intro w
      have hxz : (x * z).1 w = x.1 w * z.1 w := rfl
      split_ifs with h
      · rw [hxz, Complex.ofReal_mul]
      · exact (one_mul 1).symm
    have e2 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        kaiHZCplxWeight (l p) ((x * z).2 p)
          = kaiHZCplxWeight (l p) (x.2 p) * kaiHZCplxWeight (l p) (z.2 p) := by
      intro p
      have hxz : (x * z).2 p = x.2 p * z.2 p := rfl
      rw [hxz]
      exact hcplx _ _ _
    rw [hAdef, hAdef, hAdef, Finset.prod_congr rfl (fun w _ => e1 w),
      Finset.prod_congr rfl (fun p _ => e2 p), Finset.prod_mul_distrib,
      Finset.prod_mul_distrib]
    ring
  have hnormprod : (∏ w : NumberField.InfinitePlace K,
      (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (w.mult)) = 1 := by
    rw [NumberField.InfinitePlace.prod_eq_abs_norm]
    have h2 : (Algebra.norm ℚ) (((v' : NumberField.RingOfIntegers K) : K))
        = (Algebra.norm ℚ) ((algebraMap (NumberField.RingOfIntegers K) K)
            (v' : NumberField.RingOfIntegers K)) := rfl
    rw [h2, NumberField.Units.norm K v']
    norm_num
  have hgaugeprod : ∀ zz : NumberField.InfinitePlace K → ℝ, (∀ w, 0 ≤ zz w) →
      (∏ w : NumberField.InfinitePlace K,
          (zz w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2) ^
            (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) *
        (∏ w : NumberField.InfinitePlace K,
          (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (2 * kaiHZDeg K η l w))
        = ∏ w : NumberField.InfinitePlace K,
            zz w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)) := by
    intro zz hzz
    have step1 : ∀ w : NumberField.InfinitePlace K,
        (zz w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2) ^
            (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))
          = zz w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)) *
            (w (((v' : NumberField.RingOfIntegers K) : K))) ^
              (2 * (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) := by
      intro w
      have hnp : (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (2 : ℕ)
          = (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (2 : ℝ) := by
        rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
      rw [Real.mul_rpow (hzz w) (sq_nonneg _), hnp, ← Real.rpow_mul (hc w).le]
    have step2 : ∀ w : NumberField.InfinitePlace K,
        (w (((v' : NumberField.RingOfIntegers K) : K))) ^
            (2 * (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) *
          (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (2 * kaiHZDeg K η l w)
          = (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (-(w.mult : ℝ)) := by
      intro w
      rw [← Real.rpow_add (hc w),
        show 2 * (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)) + 2 * kaiHZDeg K η l w
          = -(w.mult : ℝ) by ring]
    have step3 : (∏ w : NumberField.InfinitePlace K,
        (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (-(w.mult : ℝ))) = 1 := by
      have hpt : ∀ w : NumberField.InfinitePlace K,
          (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (-(w.mult : ℝ))
            = ((w (((v' : NumberField.RingOfIntegers K) : K))) ^ (w.mult))⁻¹ := by
        intro w
        rw [Real.rpow_neg (hc w).le, Real.rpow_natCast]
      rw [Finset.prod_congr rfl (fun w _ => hpt w), Finset.prod_inv_distrib, hnormprod,
        inv_one]
    rw [Finset.prod_congr rfl (fun w _ => step1 w), Finset.prod_mul_distrib, mul_assoc,
      ← Finset.prod_mul_distrib, Finset.prod_congr rfl (fun w _ => step2 w), step3, mul_one]
  have hgaussmul : ∀ (zz : NumberField.InfinitePlace K → ℝ)
      (X : NumberField.mixedEmbedding.mixedSpace K),
      kaiHZGaussian K zz
          (NumberField.mixedEmbedding K (((v' : NumberField.RingOfIntegers K) : K)) * X)
        = kaiHZGaussian K
            (fun w => zz w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2) X := by
    intro zz X
    have key : (Real.pi * ∑ w : NumberField.InfinitePlace K, zz w *
          NumberField.mixedEmbedding.normAtPlace w
            (NumberField.mixedEmbedding K (((v' : NumberField.RingOfIntegers K) : K)) * X) ^ 2)
        = Real.pi * ∑ w : NumberField.InfinitePlace K,
            zz w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2 *
              NumberField.mixedEmbedding.normAtPlace w X ^ 2 := by
      congr 1
      refine Finset.sum_congr rfl fun w _ => ?_
      rw [map_mul, NumberField.mixedEmbedding.normAtPlace_apply]
      ring
    simp only [kaiHZGaussian, key]
  have hu1 : ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
      (v' : NumberField.RingOfIntegers K) = 1 := v'.inv_mul
  have hu2 : (v' : NumberField.RingOfIntegers K) *
      ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) = 1 := v'.mul_inv
  have hfwd : ∀ μ : NumberField.RingOfIntegers K, μ ∈ a →
      (v' : NumberField.RingOfIntegers K) * μ +
        ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀) ∈ a :=
    fun μ hμ => a.add_mem (a.mul_mem_left _ hμ) hv'ρ
  have hbwd : ∀ μ : NumberField.RingOfIntegers K, μ ∈ a →
      ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * μ +
        (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * ρ₀
          - ρ₀) ∈ a := by
    intro μ hμ
    refine a.add_mem (a.mul_mem_left _ hμ) ?_
    have hid : ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * ρ₀ - ρ₀
        = -(((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
            ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀)) := by
      have hh : ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
            ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀)
          = (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
              (v' : NumberField.RingOfIntegers K)) * ρ₀
            - ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) * ρ₀ := by ring
      rw [hh, hu1, one_mul]
      ring
    rw [hid]
    exact neg_mem (a.mul_mem_left _ hv'ρ)
  obtain ⟨e, he⟩ : ∃ e : ↥a ≃ ↥a, ∀ μ : ↥a,
      ((e μ : ↥a) : NumberField.RingOfIntegers K)
        = (v' : NumberField.RingOfIntegers K) * (μ : NumberField.RingOfIntegers K) +
            ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀) :=
    ⟨{ toFun := fun μ => ⟨(v' : NumberField.RingOfIntegers K) *
            (μ : NumberField.RingOfIntegers K) +
            ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀), hfwd _ μ.2⟩
       invFun := fun μ => ⟨((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) * (μ : NumberField.RingOfIntegers K) +
            (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * ρ₀
              - ρ₀), hbwd _ μ.2⟩
       left_inv := by
         intro μ
         refine Subtype.ext ?_
         show ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
             ((v' : NumberField.RingOfIntegers K) * (μ : NumberField.RingOfIntegers K) +
               ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀)) +
             (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * ρ₀
               - ρ₀) = (μ : NumberField.RingOfIntegers K)
         have hh : ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
               ((v' : NumberField.RingOfIntegers K) * (μ : NumberField.RingOfIntegers K) +
                 ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀)) +
               (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * ρ₀
                 - ρ₀)
             = (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
                 (v' : NumberField.RingOfIntegers K)) *
                 ((μ : NumberField.RingOfIntegers K) + ρ₀) - ρ₀ := by ring
         rw [hh, hu1, one_mul]
         ring
       right_inv := by
         intro μ
         refine Subtype.ext ?_
         show (v' : NumberField.RingOfIntegers K) *
             (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
               (μ : NumberField.RingOfIntegers K) +
               (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * ρ₀
                 - ρ₀)) + ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀)
             = (μ : NumberField.RingOfIntegers K)
         have hh : (v' : NumberField.RingOfIntegers K) *
               (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
                 (μ : NumberField.RingOfIntegers K) +
                 (((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * ρ₀
                   - ρ₀)) + ((v' : NumberField.RingOfIntegers K) * ρ₀ - ρ₀)
             = ((v' : NumberField.RingOfIntegers K) *
                 ((v'⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)) *
                 ((μ : NumberField.RingOfIntegers K) + ρ₀) - ρ₀ := by ring
         rw [hh, hu2, one_mul]
         ring }, fun _ => rfl⟩
  have hF : ∀ x : NumberField.RingOfIntegers K,
      NumberField.mixedEmbedding K ((x : K))
        = ((NumberField.mixedEmbedding K).comp
            (algebraMap (NumberField.RingOfIntegers K) K)) x := fun _ => rfl
  have htrans : ∀ μ : ↥a,
      NumberField.mixedEmbedding K ((ρ₀ : K)) +
          NumberField.mixedEmbedding K
            ((((e μ : ↥a) : NumberField.RingOfIntegers K) : K))
        = NumberField.mixedEmbedding K (((v' : NumberField.RingOfIntegers K) : K)) *
            (NumberField.mixedEmbedding K ((ρ₀ : K)) +
              NumberField.mixedEmbedding K
                (((μ : NumberField.RingOfIntegers K) : K))) := by
    intro μ
    have hO : ρ₀ + ((e μ : ↥a) : NumberField.RingOfIntegers K)
        = (v' : NumberField.RingOfIntegers K) *
            (ρ₀ + (μ : NumberField.RingOfIntegers K)) := by
      rw [he μ]; ring
    simp only [hF]
    rw [← map_add, ← map_add, ← map_mul, hO]
  have hθdef : ∀ zz : NumberField.InfinitePlace K → ℝ,
      kaiHZIdealTheta K a (NumberField.mixedEmbedding K ((ρ₀ : K))) η l zz
        = ∑' μ : ↥a,
            kaiHZArchWeight K η l (NumberField.mixedEmbedding K ((ρ₀ : K)) +
                NumberField.mixedEmbedding K
                  ((μ : NumberField.RingOfIntegers K) : K)) *
              ((kaiHZGaussian K zz (NumberField.mixedEmbedding K ((ρ₀ : K)) +
                NumberField.mixedEmbedding K
                  ((μ : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ) := fun _ => rfl
  have hθ : ∀ zz : NumberField.InfinitePlace K → ℝ,
      kaiHZIdealTheta K a (NumberField.mixedEmbedding K ((ρ₀ : K))) η l zz
        = kaiHZArchWeight K η l
              (NumberField.mixedEmbedding K (((v' : NumberField.RingOfIntegers K) : K))) *
            kaiHZIdealTheta K a (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
              (fun w => zz w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2) := by
    intro zz
    rw [hθdef, hθdef, ← tsum_mul_left]
    refine Eq.trans (Equiv.tsum_eq e _).symm ?_
    refine tsum_congr fun μ => ?_
    simp only [htrans μ, harch, hgaussmul]
    ring
  have hypos : ∀ w : NumberField.InfinitePlace K, 0 < r w / Y w :=
    fun w => div_pos (hr w) (hY w)
  have hycpos : ∀ w : NumberField.InfinitePlace K,
      0 < r w / Y w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2 :=
    fun w => mul_pos (hypos w) (pow_pos (hc w) 2)
  have h1 := hlaw (fun w => r w / Y w) hypos
  have h2 := hlaw
      (fun w => r w / Y w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2) hycpos
  have hg1 : (fun w : NumberField.InfinitePlace K => r w / (r w / Y w)) = Y := by
    funext w
    have hrw : r w ≠ 0 := (hr w).ne'
    have hYw : Y w ≠ 0 := (hY w).ne'
    field_simp
  have hg2 : (fun w : NumberField.InfinitePlace K =>
        r w / (r w / Y w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2))
      = fun w : NumberField.InfinitePlace K =>
          Y w / (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2 := by
    funext w
    have hrw : r w ≠ 0 := (hr w).ne'
    have hYw : Y w ≠ 0 := (hY w).ne'
    have hcw : (w (((v' : NumberField.RingOfIntegers K) : K))) ≠ 0 := (hc w).ne'
    field_simp
  rw [hg1] at h1
  rw [hg2] at h2
  have h3 := hθ (fun w => r w / Y w)
  have h4 := hgaugeprod (fun w => r w / Y w) (fun w => (hypos w).le)
  have h4c : (((∏ w : NumberField.InfinitePlace K,
        (r w / Y w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2) ^
          (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ) *
      (((∏ w : NumberField.InfinitePlace K,
        (w (((v' : NumberField.RingOfIntegers K) : K))) ^ (2 * kaiHZDeg K η l w)) : ℝ) : ℂ)
      = (((∏ w : NumberField.InfinitePlace K,
        (r w / Y w) ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, h4]
  have hPyc : (0 : ℝ) < ∏ w : NumberField.InfinitePlace K,
      (r w / Y w * (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2) ^
        (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w)) :=
    Finset.prod_pos (fun w _ => Real.rpow_pos_of_pos (hycpos w) _)
  have alg : ∀ A T0 T1 Θy Θyc κ' Py Pyc Q : ℂ, κ' ≠ 0 → Pyc ≠ 0 →
      Θy = κ' * Py * T0 → Θyc = κ' * Pyc * T1 → Θy = A * Θyc → Pyc * Q = Py →
      A * T1 = Q * T0 := by
    intro A T0 T1 Θy Θyc κ' Py Pyc Q hκ' hPyc' e1 e2 e3 e4
    refine mul_left_cancel₀ (mul_ne_zero hκ' hPyc') ?_
    linear_combination e1 - A * e2 - e3 - κ' * T0 * e4
  exact alg _ _ _ _ _ _ _ _ _ hκ0 (Complex.ofReal_ne_zero.mpr hPyc.ne') h1 h2 h3 h4c

theorem kai_mf_cone_unit_twist_shift_cancel {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K))
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (hχu : ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v →
        kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1)
    (v' : (NumberField.RingOfIntegers K)ˣ) (hv' : KaiMFCongUnit K q v') (z : ℂ) :
    kaiHZArchWeight K η l
          (NumberField.mixedEmbedding K (((v' : NumberField.RingOfIntegers K) : K))) *
        Complex.exp (∑ w : NumberField.InfinitePlace K,
          kaiMFConeZdual K t l η z w * ((kaiMFUnitShift K v' w : ℝ) : ℂ))
      = ((∏ w : NumberField.InfinitePlace K,
          (w (((v' : NumberField.RingOfIntegers K) : K))) ^
            (2 * kaiHZDeg K η l w) : ℝ) : ℂ) :=
by
  have hμ0 : ((v' : NumberField.RingOfIntegers K)) ≠ 0 := Units.ne_zero v'
  have hK0 : (((v' : NumberField.RingOfIntegers K) : K)) ≠ 0 :=
    NumberField.Units.coe_ne_zero v'
  have hapos : ∀ w : NumberField.InfinitePlace K,
      0 < w (((v' : NumberField.RingOfIntegers K) : K)) :=
    fun _ => NumberField.InfinitePlace.pos_iff.mpr hK0
  have hμu : IsUnit (Ideal.Quotient.mk q ((v' : NumberField.RingOfIntegers K))) :=
    IsUnit.map (Ideal.Quotient.mk q) (Units.isUnit v')
  have hmk1 : Ideal.Quotient.mk q ((v' : NumberField.RingOfIntegers K)) = 1 := by
    have h : (Ideal.Quotient.mk q) (((v' : NumberField.RingOfIntegers K)) - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hv'.1
    rw [map_sub, map_one, sub_eq_zero] at h
    exact h
  have hunit1 : hμu.unit = 1 :=
    Units.ext (by rw [IsUnit.unit_spec, hmk1, Units.val_one])
  have hξ1 : ((ξ hμu.unit : Circle) : ℂ) = 1 := by
    rw [hunit1, map_one, Circle.coe_one]
  have hNcpow :
      ((Ideal.absNorm (Ideal.span {((v' : NumberField.RingOfIntegers K))}) : ℂ)) ^ (-z)
        = 1 := by
    rw [Ideal.span_singleton_eq_top.mpr (Units.isUnit v'), Ideal.absNorm_top,
      Nat.cast_one, Complex.one_cpow]
  have hkey := (kai_mf_cone_arch_twist_cancel q t l ξ η
      ((v' : NumberField.RingOfIntegers K)) hμ0 hμu).2 (-z)
  rw [hξ1, inv_one, hχu v' hv', hNcpow, div_one, one_mul] at hkey
  have hterm : ∀ w : NumberField.InfinitePlace K,
      kaiMFConeZdual K t l η z w * ((kaiMFUnitShift K v' w : ℝ) : ℂ)
        = (-2 * kaiMFConeZcan K t l η (-z) w) *
            ((Real.log (w (((v' : NumberField.RingOfIntegers K) : K))) : ℝ) : ℂ)
          + ((2 * kaiHZDeg K η l w : ℝ) : ℂ) *
            ((Real.log (w (((v' : NumberField.RingOfIntegers K) : K))) : ℝ) : ℂ) := by
    intro w
    simp only [kaiMFConeZdual, kaiMFConeZcan, kaiMFConeAlpha, kaiMFUnitShift]
    push_cast
    ring
  have hsum : (∑ w : NumberField.InfinitePlace K,
        kaiMFConeZdual K t l η z w * ((kaiMFUnitShift K v' w : ℝ) : ℂ))
      = (∑ w : NumberField.InfinitePlace K,
          (-2 * kaiMFConeZcan K t l η (-z) w) *
            ((Real.log (w (((v' : NumberField.RingOfIntegers K) : K))) : ℝ) : ℂ))
        + (∑ w : NumberField.InfinitePlace K,
          ((2 * kaiHZDeg K η l w : ℝ) : ℂ) *
            ((Real.log (w (((v' : NumberField.RingOfIntegers K) : K))) : ℝ) : ℂ)) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun w _ => hterm w
  have hP : Complex.exp (∑ w : NumberField.InfinitePlace K,
        (-2 * kaiMFConeZcan K t l η (-z) w) *
          ((Real.log (w (((v' : NumberField.RingOfIntegers K) : K))) : ℝ) : ℂ))
      = ∏ w : NumberField.InfinitePlace K,
          ((w (((v' : NumberField.RingOfIntegers K) : K)) : ℝ) : ℂ) ^
            (-2 * kaiMFConeZcan K t l η (-z) w) := by
    rw [Complex.exp_sum]
    refine Finset.prod_congr rfl fun w _ => ?_
    rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (ne_of_gt (hapos w)))]
    exact congrArg Complex.exp (by rw [← Complex.ofReal_log (hapos w).le]; ring)
  have hR : Complex.exp (∑ w : NumberField.InfinitePlace K,
        ((2 * kaiHZDeg K η l w : ℝ) : ℂ) *
          ((Real.log (w (((v' : NumberField.RingOfIntegers K) : K))) : ℝ) : ℂ))
      = ((∏ w : NumberField.InfinitePlace K,
          (w (((v' : NumberField.RingOfIntegers K) : K))) ^
            (2 * kaiHZDeg K η l w) : ℝ) : ℂ) := by
    rw [Complex.exp_sum, Complex.ofReal_prod]
    refine Finset.prod_congr rfl fun w _ => ?_
    rw [Real.rpow_def_of_pos (hapos w), Complex.ofReal_exp]
    exact congrArg Complex.exp (by push_cast; ring)
  rw [hsum, Complex.exp_add, hP, hR, ← mul_assoc, hkey, one_mul]

theorem kai_mf_cone_frac_ideal_box_finite {K : Type u} [Field K] [NumberField K]
    (bf : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ) :
    (∀ M : ℝ, {ν : {x : K //
        x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
      ∀ w : NumberField.InfinitePlace K, w ((ν : K)) ≤ M}.Finite) ∧
      Countable (kaiMFDualShape K bf) :=
by
  classical
  obtain ⟨a₀, ha₀, hfrac⟩ := FractionalIdeal.isFractional
    (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
  have ha0 : (algebraMap (NumberField.RingOfIntegers K) K a₀) ≠ 0 := by
    intro h
    apply nonZeroDivisors.ne_zero ha₀
    exact (NumberField.RingOfIntegers.coe_eq_zero_iff).mp h
  have hint : ∀ x : K,
      x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) →
      IsIntegral ℤ (algebraMap (NumberField.RingOfIntegers K) K a₀ * x) := by
    intro x hx
    obtain ⟨r, hr⟩ := hfrac x hx
    rw [Algebra.smul_def] at hr
    rw [← hr]
    exact NumberField.RingOfIntegers.isIntegral_coe r
  have hA : ∀ M : ℝ, {ν : {x : K //
        x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
      ∀ w : NumberField.InfinitePlace K, w ((ν : K)) ≤ M}.Finite := by
    intro M
    have hY := NumberField.Embeddings.finite_of_norm_le K ℂ
      ((∑ φ : K →+* ℂ, ‖φ (algebraMap (NumberField.RingOfIntegers K) K a₀)‖) * max M 0)
    apply Set.Finite.of_finite_image
      (f := fun ν : {x : K //
        x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
          algebraMap (NumberField.RingOfIntegers K) K a₀ * (ν : K))
    · apply hY.subset
      rintro _ ⟨ν, hν, rfl⟩
      refine ⟨hint ν.1 ν.2, fun φ => ?_⟩
      simp only [map_mul, norm_mul]
      have h1 : ‖φ (ν : K)‖ ≤ max M 0 := by
        rw [← NumberField.InfinitePlace.apply φ]
        exact (hν _).trans (le_max_left _ _)
      have h2 : ‖φ (algebraMap (NumberField.RingOfIntegers K) K a₀)‖ ≤
          ∑ ψ : K →+* ℂ, ‖ψ (algebraMap (NumberField.RingOfIntegers K) K a₀)‖ :=
        Finset.single_le_sum
          (f := fun ψ : K →+* ℂ => ‖ψ (algebraMap (NumberField.RingOfIntegers K) K a₀)‖)
          (fun ψ _ => norm_nonneg _) (Finset.mem_univ φ)
      exact mul_le_mul h2 h1 (norm_nonneg _) (le_trans (norm_nonneg _) h2)
    · intro x _ y _ hxy
      exact Subtype.ext (mul_left_cancel₀ ha0 hxy)
  refine ⟨hA, ?_⟩
  have hV : Countable {x : K //
      x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} := by
    have hU : (Set.univ : Set {x : K //
        x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}) =
        ⋃ n : ℕ, {ν : {x : K //
          x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
            ∀ w : NumberField.InfinitePlace K, w ((ν : K)) ≤ (n : ℝ)} := by
      ext ν
      simp only [Set.mem_univ, Set.mem_iUnion, Set.mem_setOf_eq, true_iff]
      refine ⟨⌈∑ w' : NumberField.InfinitePlace K, w' (ν : K)⌉₊, fun w => ?_⟩
      exact (Finset.single_le_sum
        (f := fun w' : NumberField.InfinitePlace K => w' (ν : K))
        (fun w' _ => apply_nonneg w' _) (Finset.mem_univ w)).trans (Nat.le_ceil _)
    have hc : (Set.univ : Set {x : K //
        x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}).Countable := by
      rw [hU]
      exact Set.countable_iUnion (fun n => (hA n).countable)
    exact Set.countable_univ_iff.mp hc
  let g : {z : {x : K //
      x ∈ (bf : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} //
        (z : K) ≠ 0} → kaiMFDualShape K bf :=
    fun z => ⟨fun w => w (z.1 : K), z.1.1, z.1.2, z.2, rfl⟩
  have hg : Function.Surjective g := by
    rintro ⟨σ, x, hx, hx0, hσ⟩
    exact ⟨⟨⟨x, hx⟩, hx0⟩, Subtype.ext hσ⟩
  exact hg.countable

theorem kai_mf_cone_shape_coeff_equivariance {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (bf : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (vv : NumberField.mixedEmbedding.mixedSpace K)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (hsumD : ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
        Summable (fun ν : {x : K // x ∈ (bf : FractionalIdeal
            (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} =>
          ‖kaiHZArchWeight K η (fun p => -l p)
              (NumberField.mixedEmbedding K (ν : K))‖ *
            kaiHZGaussian K y (NumberField.mixedEmbedding K (ν : K))))
    (hfin : ∀ M : ℝ, {ν : {x : K // x ∈ (bf : FractionalIdeal
          (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} |
        ∀ w : NumberField.InfinitePlace K, w ((ν : K)) ≤ M}.Finite)
    (v' : (NumberField.RingOfIntegers K)ˣ) (E : ℂ)
    (hequiv : ∀ Y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < Y w) →
        kaiHZIdealThetaChar K bf vv η (fun p => -l p)
            (fun w => Y w / (w (((v' : NumberField.RingOfIntegers K) : K))) ^ 2)
          = E * kaiHZIdealThetaChar K bf vv η (fun p => -l p) Y)
    (σ : NumberField.InfinitePlace K → ℝ) :
    kaiMFDualCoeff K bf vv η (fun p => -l p)
        (fun w => (w (((v' : NumberField.RingOfIntegers K) : K))) * σ w)
      = E * kaiMFDualCoeff K bf vv η (fun p => -l p) σ :=
by
  classical
  have s1gen : ∀ (α : Type u) (sh : α → (NumberField.InfinitePlace K → ℝ)) (A : α → ℂ)
      (y : NumberField.InfinitePlace K → ℝ),
      Summable (fun a : α => ‖A a‖ *
          Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K, y w * sh a w ^ 2))) →
      Summable (fun s : NumberField.InfinitePlace K → ℝ =>
          ‖∑' a : {a : α // sh a = s}, A (a : α)‖ *
            Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K, y w * s w ^ 2))) ∧
        HasSum (fun s : NumberField.InfinitePlace K → ℝ =>
            (∑' a : {a : α // sh a = s}, A (a : α)) *
              ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
                y w * s w ^ 2)) : ℝ) : ℂ))
          (∑' a : α, A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            y w * sh a w ^ 2)) : ℝ) : ℂ)) := by
    intro α sh A y hsum
    have hFnorm : ∀ a : α,
        ‖A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
            y w * sh a w ^ 2)) : ℝ) : ℂ)‖
          = ‖A a‖ * Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
              y w * sh a w ^ 2)) := by
      intro a
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    have hFsum : Summable (fun a : α =>
        ‖A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh a w ^ 2)) : ℝ) : ℂ)‖) := by
      simpa only [hFnorm] using hsum
    have hFs : Summable (fun a : α =>
        A a * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh a w ^ 2)) : ℝ) : ℂ)) := hFsum.of_norm
    have hN0 := ((Equiv.sigmaFiberEquiv sh).summable_iff).mpr hFsum
    have hF0 := ((Equiv.sigmaFiberEquiv sh).summable_iff).mpr hFs
    have hH0 := ((Equiv.sigmaFiberEquiv sh).hasSum_iff).mpr hFs.hasSum
    have hN : Summable (fun p : (Σ s : NumberField.InfinitePlace K → ℝ,
        {a : α // sh a = s}) =>
        ‖A ((p.2 : α)) * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh ((p.2 : α)) w ^ 2)) : ℝ) : ℂ)‖) := hN0
    have hF : Summable (fun p : (Σ s : NumberField.InfinitePlace K → ℝ,
        {a : α // sh a = s}) =>
        A ((p.2 : α)) * ((Real.exp (-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * sh ((p.2 : α)) w ^ 2)) : ℝ) : ℂ)) := hF0
