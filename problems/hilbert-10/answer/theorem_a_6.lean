    ⟨_, rfl⟩
  obtain ⟨e, he_def⟩ : ∃ e : NumberField.RingOfIntegers K → ℝ, e = fun x => f x + g x :=
    ⟨_, rfl⟩
  have hpt : ∀ x ∈ omegaBox ω M, |e x| ≤ T₀ / L := by
    intro x hx
