      linarith
    rw [he', add_div, sub_div, mul_div_cancel_left₀ _ hPpos.ne']
  
  have hcmp : ∀ a b : ZMod P, giCircNorm P (a - b) ≤ |sg a - sg b| := by
    intro a b
    obtain ⟨e, he⟩ := hvsub a b
    obtain ⟨ma, hma⟩ := hsg2 a
    obtain ⟨mb, hmb⟩ := hsg2 b
    have heq : sg a - sg b = ((a - b).val : ℝ) / P - ((e + ma - mb : ℤ) : ℝ) := by
      rw [hma, hmb, he]; push_cast; ring
