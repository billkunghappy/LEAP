def KaiMFConeFEUnitProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ A : ℝ, 1 ≤ A ∧
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (t : NumberField.InfinitePlace K → ℝ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
        (∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v →
            kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1) →
        ∃ c₀ : ℂ,
          ∀ b : Ideal (NumberField.RingOfIntegers K), b ≠ 0 → b ⊔ q = ⊤ →
          ∀ ρ₀ : NumberField.RingOfIntegers K, ρ₀ ≠ 0 → ρ₀ ∈ b → ρ₀ - 1 ∈ q →
          ∀ Gen : Set (NumberField.RingOfIntegers K),
            (∀ μ ∈ Gen, μ ≠ 0 ∧ μ - ρ₀ ∈ q * b) →
            (∀ μ : NumberField.RingOfIntegers K, μ ≠ 0 → μ - ρ₀ ∈ q * b →
                ∃! p : {ν // ν ∈ Gen} ×
                       {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
                  μ = ((p.2 : (NumberField.RingOfIntegers K)ˣ) :
                        NumberField.RingOfIntegers K)
                      * (p.1 : NumberField.RingOfIntegers K)) →
            ∃ (Gc : ℂ → ℂ) (Ca : ℝ), 0 < Ca ∧ Differentiable ℂ Gc ∧
              (∀ s : ℂ, 1 < s.re →
                  Summable (fun μ : {ν // ν ∈ Gen} =>
                    kaiHeckeTwist K q t l ξ η (μ : NumberField.RingOfIntegers K) /
                      ((Ideal.absNorm (Ideal.span
                        {(μ : NumberField.RingOfIntegers K)}) : ℂ) ^ s)) ∧
                  Gc s = (s - 1) * ∑' μ : {ν // ν ∈ Gen},
                    kaiHeckeTwist K q t l ξ η (μ : NumberField.RingOfIntegers K) /
                      ((Ideal.absNorm (Ideal.span
                        {(μ : NumberField.RingOfIntegers K)}) : ℂ) ^ s)) ∧
              ((¬ ((∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) ∧ t = 0)) →
                  Gc 1 = 0) ∧
              (((∀ w : NumberField.InfinitePlace K, kaiHZDeg K η l w = 0) ∧ t = 0) →
                  Gc 1 = c₀ / ((Ideal.absNorm b : ℝ) : ℂ)) ∧
              (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
                  ‖Gc s * ∏ w : NumberField.InfinitePlace K,
                      Complex.Gamma ((kaiMFConeAlpha K w : ℂ) * s
                        + kaiMFConeBeta K t l η w)‖
                    ≤ Ca * Real.exp (Ca * (1 + |s.im|))) ∧
              (∀ s : ℂ, s.re = -(1 : ℝ) / 2 →
                  ‖Gc s‖ ≤ A * ((Ideal.absNorm q : ℝ) * (Ideal.absNorm b : ℝ) *
                      (1 + kaiHZInfSize K t l) * (2 + |s.im|)) ^ A *
                    ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
                        (-((3 : ℝ) / 2)))
abbrev kaiHZCoordIndex (K : Type u) [Field K] [NumberField K] : Type _ :=
  {w : NumberField.InfinitePlace K // w.IsReal} ⊕
    ({w : NumberField.InfinitePlace K // w.IsComplex} ⊕
      {w : NumberField.InfinitePlace K // w.IsComplex})

noncomputable def kaiHZCoord (K : Type u) [Field K] [NumberField K] :
    NumberField.mixedEmbedding.mixedSpace K ≃ₗ[ℝ] (kaiHZCoordIndex K → ℝ) where
  toFun x := Sum.elim (fun w => x.1 w)
      (Sum.elim (fun p => (x.2 p).re) (fun p => (x.2 p).im))
  invFun u := (fun w => u (Sum.inl w),
      fun p => Complex.mk (u (Sum.inr (Sum.inl p))) (u (Sum.inr (Sum.inr p))))
  map_add' x z := by funext i; rcases i with w | (p | p) <;> simp
  map_smul' c x := by funext i; rcases i with w | (p | p) <;> simp
  left_inv x := Prod.ext rfl (funext fun p => Complex.ext rfl rfl)
  right_inv u := by funext i; rcases i with w | (p | p) <;> rfl
noncomputable def kaiZFVonMangoldt (K : Type u) [Field K] [NumberField K]
    (I : Ideal (NumberField.RingOfIntegers K)) : ℝ := by
  classical
  exact if h : ∃ (P : Ideal (NumberField.RingOfIntegers K)) (k : ℕ),
      P.IsPrime ∧ P ≠ ⊥ ∧ 0 < k ∧ I = P ^ k
    then Real.log (Ideal.absNorm h.choose) else 0

noncomputable def kaiZFHeckeLogSum (K : Type u) [Field K] [NumberField K]
    (mu : Ideal (NumberField.RingOfIntegers K) → ℂ) (s : ℂ) : ℂ :=
  ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
    mu (I : Ideal (NumberField.RingOfIntegers K)) *
      ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
      ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s))

noncomputable def kaiZFPrincipalChar (K : Type u) [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) :
    Ideal (NumberField.RingOfIntegers K) → ℂ := by
  classical
  exact fun I => if I ≠ 0 ∧ I ⊔ q = ⊤ then 1 else 0

def KaiZFLandauExpProp : Prop :=
  ∃ CL : ℝ, 0 < CL ∧
    ∀ (f : ℂ → ℂ) (s₀ : ℂ) (r M : ℝ),
      Differentiable ℂ f → 0 < r → 3 ≤ M → f s₀ ≠ 0 →
      (∀ s ∈ Metric.closedBall s₀ r, ‖f s‖ ≤ M * ‖f s₀‖) →
      ∃ (Z : Finset ℂ) (mult : ℂ → ℕ),
        (∀ ρ ∈ Z, ρ ∈ Metric.closedBall s₀ (r / 2) ∧ f ρ = 0 ∧ 1 ≤ mult ρ) ∧
        (∀ ρ : ℂ, ρ ∈ Metric.closedBall s₀ (r / 2) → f ρ = 0 → ρ ∈ Z) ∧
        (∀ ρ ∈ Z, deriv f ρ ≠ 0 → mult ρ = 1) ∧
        (∑ ρ ∈ Z, (mult ρ : ℝ)) ≤ CL * Real.log M ∧
        (∀ s ∈ Metric.closedBall s₀ (r / 4), f s ≠ 0 →
          ‖deriv f s / f s - ∑ ρ ∈ Z, (mult ρ : ℂ) / (s - ρ)‖ ≤ CL * Real.log M / r)

def KaiZFZetaContProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ A₀ : ℝ, 0 < A₀ ∧
    ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (t : NumberField.InfinitePlace K → ℝ)
        (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
        (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q t l ξ η lam →
        (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
        ∃ (E : ℕ) (G : ℂ → ℂ),
          E ≤ 1 ∧ (E = 1 ↔ KaiHeckePrincipal K q lam) ∧
          Differentiable ℂ G ∧
          (∀ s : ℂ, 1 < s.re →
              Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
                lam (I : Ideal (NumberField.RingOfIntegers K)) /
                  ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) ∧
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) ∧
          (∀ s : ℂ, -(1 : ℝ) / 2 ≤ s.re → s.re ≤ 4 →
              ‖G s‖ ≤ A₀ * ((Ideal.absNorm q : ℝ) *
                (1 + (1 + (∑ w : NumberField.InfinitePlace K, |t w|)
                  + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)|))
                * (2 + |s.im|)) ^ A₀)

def KaiZFSeriesBasicsProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∃ DK : ℝ, 1 ≤ DK ∧
    (∀ σ : ℝ, 1 < σ →
        Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)) ∧
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))
          ≤ (1 + 1 / (σ - 1)) ^ (Module.finrank ℚ K)) ∧
    (∀ σ : ℝ, 1 < σ → σ ≤ 2 →
        Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)) ∧
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ))
          ≤ DK / (σ - 1)) ∧
    ∀ (q : Ideal (NumberField.RingOfIntegers K))
      (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
      (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      q ≠ 0 → KaiHeckeExt K q 0 0 ξ η lam →
      (∀ s : ℂ, 1 < s.re →
          Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
            lam (I : Ideal (NumberField.RingOfIntegers K)) /
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))) ∧
      (∀ s : ℂ, 1 < s.re →
          1 ≤ ‖kaiHeckeSeries K lam s‖ * (1 + 1 / (s.re - 1)) ^ (Module.finrank ℚ K)) ∧
      (∀ s : ℂ, 1 < s.re →
          Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
            lam (I : Ideal (NumberField.RingOfIntegers K)) *
              ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)))) ∧
      (∀ s : ℂ, 1 < s.re →
          DifferentiableAt ℂ (kaiHeckeSeries K lam) s ∧
          deriv (kaiHeckeSeries K lam) s / kaiHeckeSeries K lam s
            = - kaiZFHeckeLogSum K lam s) ∧
      ((∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
          ∀ s : ℂ, 1 < s.re →
            kaiHeckeSeries K lam ((starRingEnd ℂ) s) = (starRingEnd ℂ) (kaiHeckeSeries K lam s))

def KaiZFCharPositivityProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  (∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      KaiHeckeExt K q 0 0 1 (fun _ => false) (kaiZFPrincipalChar K q) ∧
      KaiHeckePrincipal K q (kaiZFPrincipalChar K q)) ∧
  (∀ (q : Ideal (NumberField.RingOfIntegers K))
     (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
     (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
     (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      q ≠ 0 → KaiHeckeExt K q 0 0 ξ η lam →
      KaiHeckeExt K q 0 0 (ξ ^ 2) (fun _ => false) (fun I => lam I * lam I)) ∧
  (∀ (q : Ideal (NumberField.RingOfIntegers K))
     (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
     (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
     (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      KaiHeckeExt K q 0 0 ξ η lam →
      ((∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) ↔
          KaiHeckePrincipal K q (fun I => lam I * lam I)) ∧
      ((∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
          (fun I => lam I * lam I) = kaiZFPrincipalChar K q)) ∧
  (∀ (q : Ideal (NumberField.RingOfIntegers K))
     (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
     (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
     (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      q ≠ 0 → KaiHeckeExt K q 0 0 ξ η lam →
      (∀ σ γ : ℝ, 1 < σ →
          0 ≤ 3 * (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) (σ : ℂ)).re
              + 4 * (kaiZFHeckeLogSum K lam ((σ : ℂ) + (γ : ℂ) * Complex.I)).re
              + (kaiZFHeckeLogSum K (fun I => lam I * lam I)
                  ((σ : ℂ) + 2 * (γ : ℂ) * Complex.I)).re) ∧
      (∀ σ : ℝ, 1 < σ → 0 ≤ (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) (σ : ℂ)).re) ∧
      ((∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
          ∀ σ : ℝ, 1 < σ →
            (kaiZFHeckeLogSum K lam (σ : ℂ)).re
              ≤ (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) (σ : ℂ)).re) ∧
      (∀ σ : ℝ, 1 < σ →
          (kaiZFHeckeLogSum K (kaiZFPrincipalChar K (⊤ : Ideal (NumberField.RingOfIntegers K)))
              (σ : ℂ)).re - Real.log (Ideal.absNorm q)
            ≤ (kaiZFHeckeLogSum K (kaiZFPrincipalChar K q) (σ : ℂ)).re))

def KaiZFRealOneNeZeroProp (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] : Prop :=
  ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
    ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
      (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
      (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
      KaiHeckeExt K q 0 0 ξ η lam →
      (∀ I : Ideal (NumberField.RingOfIntegers K), lam I = (starRingEnd ℂ) (lam I)) →
      ¬ KaiHeckePrincipal K q lam →
      ∀ Zeta : ℂ → ℂ, Differentiable ℂ Zeta →
        (∀ s : ℂ, 1 < s.re →
          Zeta s = (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s))) * (s - 1)) →
      ∀ Zf : ℂ → ℂ, DifferentiableOn ℂ Zf {s : ℂ | 0 < s.re} →
        (∀ s : ℂ, 1 < s.re → Zf s = kaiHeckeSeries K lam s) →
        Zf 1 ≠ 0
noncomputable def kaiMFConeZcan (K : Type u) [Field K] [NumberField K]
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (s : ℂ) (w : NumberField.InfinitePlace K) : ℂ :=
  (kaiMFConeAlpha K w : ℂ) * s + ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
    - Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)

noncomputable def kaiMFConeZdual (K : Type u) [Field K] [NumberField K]
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (s : ℂ) (w : NumberField.InfinitePlace K) : ℂ :=
  (kaiMFConeAlpha K w : ℂ) * s + ((kaiHZDeg K η l w / 2 : ℝ) : ℂ)
    + Complex.I * (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)
def KaiZFMoebiusProp (K : Type u) [Field K] [NumberField K] : Prop :=
  ∃ m : Ideal (NumberField.RingOfIntegers K) → ℂ,
    (∀ J : Ideal (NumberField.RingOfIntegers K), ‖m J‖ ≤ 1) ∧
    (∑' J : {J : Ideal (NumberField.RingOfIntegers K) //
        J ∣ (⊤ : Ideal (NumberField.RingOfIntegers K))},
      m (J : Ideal (NumberField.RingOfIntegers K))) = 1 ∧
    (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ≠ ⊤ →
      (∑' J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I},
        m (J : Ideal (NumberField.RingOfIntegers K))) = 0)

def KaiZFConvProp (K : Type u) [Field K] [NumberField K] : Prop :=
  ∀ (f g : Ideal (NumberField.RingOfIntegers K) → ℂ) (s : ℂ),
    Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      ‖f (I : Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)‖) →
    Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      ‖g (I : Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)‖) →
    (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        f (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)) *
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        g (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
      = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          (∑' pr : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                         {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
                (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (pr.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
            f ((pr.1.1 : Ideal (NumberField.RingOfIntegers K))) *
              g ((pr.1.2 : Ideal (NumberField.RingOfIntegers K)))) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)

def KaiZFFiberProp (K : Type u) [Field K] [NumberField K] : Prop :=
  ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
    ∀ gg : Ideal (NumberField.RingOfIntegers K) → ℂ,
      (∑' pr : {pr : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                     {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
            (pr.1 : Ideal (NumberField.RingOfIntegers K)) *
              (pr.2 : Ideal (NumberField.RingOfIntegers K)) = I},
          gg ((pr.1.2 : Ideal (NumberField.RingOfIntegers K))))
        = ∑' J : {J : Ideal (NumberField.RingOfIntegers K) // J ∣ I},
            gg (J : Ideal (NumberField.RingOfIntegers K))
