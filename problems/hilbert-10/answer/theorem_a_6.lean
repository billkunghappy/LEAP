  have giBohr_card_two_mul_le : ∀ r : ℝ, 0 < r →
      (giBohr P S (2 * r)).card ≤ 4 ^ S.card * (giBohr P S r).card := by
    intro r hr
    have hP1 : 1 ≤ P := Nat.pos_of_ne_zero (NeZero.ne P)
    have hPpos : (0 : ℝ) < P := by exact_mod_cast hP1
    have hcn_le : ∀ (k : ZMod P) (m : ℤ), giCircNorm P k ≤ |(k.val : ℝ) / P - m| := by
      intro k m
      have hk : (k.val : ℝ) < P := by exact_mod_cast ZMod.val_lt k
      have ht0 : 0 ≤ (k.val : ℝ) / P := by positivity
      have ht1 : (k.val : ℝ) / P < 1 := (div_lt_one hPpos).2 hk
      unfold giCircNorm
      rcases le_or_gt m 0 with hm | hm
      · have : (m : ℝ) ≤ 0 := by exact_mod_cast hm
        exact (min_le_left _ _).trans (by rw [abs_of_nonneg (by linarith)]; linarith)
      · have : (1 : ℝ) ≤ m := by exact_mod_cast hm
        exact (min_le_right _ _).trans (by rw [abs_of_nonpos (by linarith)]; linarith)
    obtain ⟨τ, hτ⟩ : ∃ τ : ZMod P → ℝ, τ = fun a =>
        if (a.val : ℝ) / P ≤ 1 - (a.val : ℝ) / P then (a.val : ℝ) / P else (a.val : ℝ) / P - 1 :=
      ⟨_, rfl⟩
    have hτ1 : ∀ a, |τ a| = giCircNorm P a := by
      intro a
      have hk : (a.val : ℝ) < P := by exact_mod_cast ZMod.val_lt a
      have ht0 : 0 ≤ (a.val : ℝ) / P := by positivity
      have ht1 : (a.val : ℝ) / P < 1 := (div_lt_one hPpos).2 hk
      rw [hτ]
      unfold giCircNorm
      simp only
      split_ifs with h
      · rw [min_eq_left h, abs_of_nonneg ht0]
      · push_neg at h
        rw [min_eq_right h.le, abs_of_neg (by linarith)]
        ring
    have hτ2 : ∀ a, ∃ m : ℤ, τ a = (a.val : ℝ) / P - m := by
      intro a
      rw [hτ]
      simp only
      split_ifs
      · exact ⟨0, by simp⟩
      · exact ⟨1, by simp⟩
    have hτ4 : ∀ a b : ZMod P, giCircNorm P (a - b) ≤ |τ a - τ b| := by
      intro a b
      obtain ⟨ma, hma⟩ := hτ2 a
      obtain ⟨mb, hmb⟩ := hτ2 b
      have hdvd : (P : ℤ) ∣ (((a - b).val : ℤ) - a.val + b.val) := by
        rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
        push_cast
        simp only [ZMod.natCast_val, ZMod.cast_id', id]
        ring
      obtain ⟨t, ht⟩ := hdvd
      have htZ : ((a - b).val : ℤ) = (a.val : ℤ) - b.val + P * t := by linarith
      have htR : ((a - b).val : ℝ) = (a.val : ℝ) - b.val + P * t := by
        have := congrArg (fun z : ℤ => (z : ℝ)) htZ
        push_cast at this
        exact this
      calc giCircNorm P (a - b) ≤ |((a - b).val : ℝ) / P - ((t + ma - mb : ℤ) : ℝ)| := hcn_le _ _
        _ = |τ a - τ b| := by
            congr 1; rw [hma, hmb, htR]; push_cast; field_simp; ring
    obtain ⟨cell, hcell⟩ : ∃ cell : ZMod P → (ZMod P → ℤ), cell = fun x ξ =>
        if ξ ∈ S then ⌊τ (ξ * x) / r⌋ else 0 := ⟨_, rfl⟩
    obtain ⟨T, hT⟩ : ∃ T : Finset (ZMod P → ℤ), T = Fintype.piFinset
        (fun ξ : ZMod P => if ξ ∈ S then Finset.Icc (-2 : ℤ) 1 else {0}) := ⟨_, rfl⟩
    have hTcard : T.card = 4 ^ S.card := by
      rw [hT, Fintype.card_piFinset]
      have : ∀ ξ : ZMod P, (if ξ ∈ S then Finset.Icc (-2 : ℤ) 1 else {0}).card
          = if ξ ∈ S then 4 else 1 := by
        intro ξ; split_ifs <;> simp
      rw [Finset.prod_congr rfl (fun ξ _ => this ξ), Finset.prod_ite_mem, Finset.univ_inter,
        Finset.prod_const]
    have himg : (giBohr P S (2 * r)).image cell ⊆ T := by
      intro b hb
      rw [Finset.mem_image] at hb
      obtain ⟨x, hx, rfl⟩ := hb
      simp only [giBohr, Finset.mem_filter, Finset.mem_univ, true_and] at hx
      rw [hT, Fintype.mem_piFinset]
      intro ξ
      rw [hcell]
      by_cases hξ : ξ ∈ S
      · simp only [hξ, if_true, Finset.mem_Icc]
        have h1 := hx ξ hξ
        rw [← hτ1] at h1
        have h2 := abs_lt.mp h1
        constructor
        · rw [Int.le_floor]
          rw [le_div_iff₀ hr]; push_cast; linarith
        · have : ⌊τ (ξ * x) / r⌋ < 2 := by
            rw [Int.floor_lt, div_lt_iff₀ hr]; push_cast; linarith
          omega
      · simp [hξ]
    have hfib : ∀ b ∈ (giBohr P S (2 * r)).image cell,
        ((giBohr P S (2 * r)).filter (fun x => cell x = b)).card ≤ (giBohr P S r).card := by
      intro b _
      rcases ((giBohr P S (2 * r)).filter (fun x => cell x = b)).eq_empty_or_nonempty with he | hne
      · rw [he]; simp
      · obtain ⟨x₀, hx₀⟩ := hne
        rw [Finset.mem_filter] at hx₀
        apply Finset.card_le_card_of_injOn (fun y => y - x₀)
        · intro y hy
          rw [Finset.mem_coe, Finset.mem_filter] at hy
          simp only [giBohr, Finset.mem_coe, Finset.mem_filter, Finset.mem_univ, true_and]
          intro ξ hξ
          have hc : cell y ξ = cell x₀ ξ := by rw [hy.2, hx₀.2]
          rw [hcell] at hc
          simp only [hξ, if_true] at hc
          have h1 := Int.abs_sub_lt_one_of_floor_eq_floor hc
          rw [← sub_div, abs_div, abs_of_pos hr, div_lt_one hr] at h1
          calc giCircNorm P (ξ * (y - x₀)) = giCircNorm P (ξ * y - ξ * x₀) := by rw [mul_sub]
            _ ≤ |τ (ξ * y) - τ (ξ * x₀)| := hτ4 _ _
            _ < r := h1
        · intro y₁ _ y₂ _ h
          simpa using h
    have h1 := Finset.card_le_mul_card_image (giBohr P S (2 * r)) (giBohr P S r).card hfib
    have h2 := Finset.card_le_card himg
    rw [hTcard] at h2
    calc (giBohr P S (2 * r)).card
        ≤ (giBohr P S r).card * ((giBohr P S (2 * r)).image cell).card := h1
      _ ≤ (giBohr P S r).card * 4 ^ S.card := Nat.mul_le_mul_left _ h2
      _ = 4 ^ S.card * (giBohr P S r).card := mul_comm _ _
  
  
  
  have giRegularBohr_of_grid_good : ∀ (η c : ℝ) (j : ℕ), 1 ≤ S.card → 0 < η → 2 ≤ j →
      0 ≤ c → 2 * c * ((P : ℝ) + 1) ≤ 1 → c * (j : ℝ) ≤ 20 * (S.card : ℝ) →
      (∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ (j : ℝ) / (100 * (S.card : ℝ)) + 1 →
        Real.log ((giBohr P S (((j : ℝ) + (m : ℝ)) * η)).card : ℝ)
          - Real.log ((giBohr P S ((j : ℝ) * η)).card : ℝ) ≤ c * (m : ℝ)) →
