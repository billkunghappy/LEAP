      have hprod := hPmul x x⁻¹ w
      rw [huu, hP1 w] at hprod
      nlinarith [hx2 w]
  have hTfin : Finite {t : (NumberField.RingOfIntegers K)ˣ // t ∈ T} := by
    have hpos : 0 < Nat.card {t : (NumberField.RingOfIntegers K)ˣ // t ∈ T} := by
      rw [hTcard]; exact hhpos
    exact (Nat.card_pos_iff.mp hpos).2
  refine ⟨hh, hhpos, ?_⟩
  intro b hb0 hbq ρ hρ0 hρb hρq
  have hM1 : ∀ μ : NumberField.RingOfIntegers K, μ - ρ ∈ q * b → μ ∈ b := by
    intro μ h
    have h1 : μ - ρ ∈ b := Ideal.mul_le_left h
    have h2 : (μ - ρ) + ρ ∈ b := Submodule.add_mem _ h1 hρb
    simpa using h2
  have hM2 : ∀ μ : NumberField.RingOfIntegers K, μ - ρ ∈ q * b → μ - 1 ∈ q := by
    intro μ h
    have h1 : μ - ρ ∈ q := Ideal.mul_le_right h
    have h2 : (μ - ρ) + (ρ - 1) ∈ q := Submodule.add_mem _ h1 hρq
    have h3 : (μ - ρ) + (ρ - 1) = μ - 1 := by ring
    rwa [h3] at h2
