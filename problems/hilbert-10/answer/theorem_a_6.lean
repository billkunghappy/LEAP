  have hT : ∀ ξ : ZMod P, ∑ v ∈ Fintype.piFinset (fun _ : Fin k => X),
      ∑ v' ∈ Fintype.piFinset (fun _ : Fin k => X), ψ (ξ * ∑ i, (v i - v' i))
