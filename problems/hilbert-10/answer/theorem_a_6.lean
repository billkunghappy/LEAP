noncomputable def gowersCubeSum {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K))
    (Φ : (Fin 3 → Fin 2) → NumberField.RingOfIntegers K → ℝ) (M : ℝ) : ℝ :=
  ∑ x ∈ omegaBox ω M, ∑ h₁ ∈ omegaBox ω (2 * M), ∑ h₂ ∈ omegaBox ω (2 * M),
      ∑ h₃ ∈ omegaBox ω (2 * M),
        ∏ ε : Fin 3 → Fin 2,
          (if cubeVertex x h₁ h₂ h₃ ε ∈ omegaBox ω M then Φ ε (cubeVertex x h₁ h₂ h₃ ε) else 0)
noncomputable def siegelModel (K : Type u) [Field K] [NumberField K] (ρ : ℝ) (W : ℕ)
    (ψ : NumberField.RingOfIntegers K → ℤ) (β : ℝ) (x : NumberField.RingOfIntegers K) : ℝ :=
  cramerModel K ρ W x * (1 - (ψ x : ℝ) * (((Algebra.norm ℤ x).natAbs : ℝ) ^ (β - 1)))


def IsRealRayChar {K : Type u} [Field K] [NumberField K]
    (𝔮 : Ideal (NumberField.RingOfIntegers K)) (ψ : NumberField.RingOfIntegers K → ℤ) : Prop :=
  (∀ x, ψ x = 1 ∨ ψ x = -1 ∨ ψ x = 0) ∧
  (∀ x, ψ x = 0 ↔ ¬ IsCoprime (Ideal.span {x}) 𝔮) ∧
  (∀ x y, ψ (x * y) = ψ x * ψ y) ∧
  (∀ (u : (NumberField.RingOfIntegers K)ˣ) x, ψ ((u : NumberField.RingOfIntegers K) * x) = ψ x) ∧
  (∀ x y : NumberField.RingOfIntegers K, x - y ∈ 𝔮 →
    (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
          NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) →
    ψ x = ψ y) ∧
  (∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), 𝔮 < 𝔡 →
    ∃ x y : NumberField.RingOfIntegers K,
      IsCoprime (Ideal.span {x}) 𝔮 ∧ IsCoprime (Ideal.span {y}) 𝔮 ∧ x - y ∈ 𝔡 ∧
      (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
        0 < NumberField.InfinitePlace.embedding_of_isReal hw (x : K) *
            NumberField.InfinitePlace.embedding_of_isReal hw (y : K)) ∧
      ψ x ≠ ψ y)


def IsSiegelDatum {K : Type u} [Field K] [NumberField K] (m : ℕ)
    (Dt : Ideal (NumberField.RingOfIntegers K) × (NumberField.RingOfIntegers K → ℤ) × ℝ) : Prop :=
  Dt.1 ≠ ⊥ ∧
  (Dt.2.1 = 0 ∨
    (IsRealRayChar Dt.1 Dt.2.1 ∧ (1 / 2 : ℝ) ≤ Dt.2.2 ∧ Dt.2.2 < 1 ∧
      (Ideal.absNorm Dt.1 : ℝ) ≤ (m : ℝ) ∧
      ∀ 𝔭 : Ideal (NumberField.RingOfIntegers K), 𝔭.IsPrime → Dt.1 ≤ 𝔭 →
        ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭))
noncomputable def giU3 (P : ℕ) [NeZero P] (g : ZMod P → ℝ) : ℝ :=
  (∑ x : ZMod P, ∑ h₁ : ZMod P, ∑ h₂ : ZMod P, ∑ h₃ : ZMod P,
      ∏ ε : Fin 3 → Fin 2, g (cubeVertex x h₁ h₂ h₃ ε)) / (P : ℝ) ^ 4


noncomputable def giE (t : ℝ) : ℂ := Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (t : ℂ))


noncomputable def giCircNorm (P : ℕ) (k : ZMod P) : ℝ :=
  min ((k.val : ℝ) / P) (1 - (k.val : ℝ) / P)

