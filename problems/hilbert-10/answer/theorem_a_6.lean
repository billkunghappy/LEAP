  have hJinj : Function.Injective (fun μ : {ν // ν ∈ Gen} =>
      ((⟨Ideal.span {(μ : NumberField.RingOfIntegers K)},
          hspan_ne _ (hGen1 _ μ.2).1⟩ :
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}),
