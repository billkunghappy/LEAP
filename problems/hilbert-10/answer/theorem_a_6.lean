          ∑ p ∈ (Finset.range (⌊x⌋₊ + 1)).filter Nat.Prime, Real.log ((p : ℕ) : ℝ) := by
    rw [Finset.sum_product]
    simp only [← Finset.mul_sum, Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
