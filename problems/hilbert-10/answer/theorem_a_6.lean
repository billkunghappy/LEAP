          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
  
  refine ⟨a, p₀, p₁, fun _ _ _ => 0, fun u => ∫ w in Set.Icc (0 : Fin b → ℝ) 1, F (u, w),
    ?_, ?_, ?_, ?_, ?_⟩
  · have : (a : ℝ) ≤ ((a + b : ℕ) : ℝ) := by exact_mod_cast Nat.le_add_right a b
    linarith
  · intro u
    exact hbox _ 1 (fun w => hF1 (u, w))
  · intro u γ
    exact hper u γ
  · intro u v
    have hS : 0 ≤ ∑ i, |u i - v i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
    suffices h : |(∫ w in Set.Icc (0 : Fin b → ℝ) 1, F (u, w)) -
        ∫ w in Set.Icc (0 : Fin b → ℝ) 1, F (v, w)| ≤ Q * ∑ i, |u i - v i| by
      exact h.trans (mul_le_mul_of_nonneg_right hQX hS)
    by_cases h : ∃ i, 1 < |u i - v i|
    · obtain ⟨i₀, hi₀⟩ := h
      have hu := abs_le.mp (hbox _ 1 (fun w => hF1 (u, w)))
      have hv := abs_le.mp (hbox _ 1 (fun w => hF1 (v, w)))
      have h2 : |(∫ w in Set.Icc (0 : Fin b → ℝ) 1, F (u, w)) -
          ∫ w in Set.Icc (0 : Fin b → ℝ) 1, F (v, w)| ≤ 2 :=
        abs_le.mpr ⟨by linarith [hu.1, hv.2], by linarith [hu.2, hv.1]⟩
      have hle : |u i₀ - v i₀| ≤ ∑ i, |u i - v i| :=
        Finset.single_le_sum (f := fun i => |u i - v i|) (fun i _ => abs_nonneg _)
          (Finset.mem_univ i₀)
      have h3 : 2 * |u i₀ - v i₀| ≤ Q * |u i₀ - v i₀| :=
        mul_le_mul_of_nonneg_right hQ (abs_nonneg _)
      have h4 : Q * |u i₀ - v i₀| ≤ Q * ∑ i, |u i - v i| := mul_le_mul_of_nonneg_left hle hQ0
      linarith
    · push_neg at h
      obtain ⟨n, hn⟩ := hwin u v h
      rw [← hper u n, ← hper v n]
      rw [← MeasureTheory.integral_sub (hcont (fun i => u i + (n i : ℝ))).integrableOn_Icc
        (hcont (fun i => v i + (n i : ℝ))).integrableOn_Icc]
      apply hbox
      intro w
      have := hlipx ((fun i => u i + (n i : ℝ)), w) ((fun i => v i + (n i : ℝ)), w)
        (fun i => (hn i).1) (fun i => (hn i).2) (fun k => by simp)
      simpa using this
  · intro z
    simp

theorem nil2_vertical_piece (ν a b : ℕ) (D Q X κ : ℝ) (hQ : 2 ≤ Q) (hQX : Q ≤ X) (hκ0 : 0 ≤ κ) (hκ1 : κ ≤ 1) (hab : ((a + b : ℕ) : ℝ) ≤ D) (Bc : Fin a → Fin a → Fin b → ℤ) (hBc : ∀ i j k, |(Bc i j k : ℝ)| ≤ Q) (F : (Fin a → ℝ) × (Fin b → ℝ) → ℝ) (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ) (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ) (hF1 : ∀ u, |F u| ≤ 1) (hvert : ∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (n : Fin b → ℤ), F (u₁, w + fun k => (n k : ℝ)) = F (u₁, w)) (hhor : ∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (γ₁ : Fin a → ℤ), F ((fun i => u₁ i + (γ₁ i : ℝ)), (fun k => w k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ))) = F (u₁, w)) (hlipx : ∀ u v : (Fin a → ℝ) × (Fin b → ℝ), (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, |u.2 k - v.2 k| ≤ 1) → |F u - F v| ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|)) (hvlip : ∀ (u₁ : Fin a → ℝ) (w w' : Fin b → ℝ), |F (u₁, w) - F (u₁, w')| ≤ Q * ∑ k, |w k - w' k|) (hshift : ∀ (g : (Fin b → ℝ) → ℂ), (∀ (w : Fin b → ℝ) (n : Fin b → ℤ), g (w + fun k => (n k : ℝ)) = g w) → ∀ c : Fin b → ℝ, ∫ w in Set.Icc (0 : Fin b → ℝ) 1, g (w + c) = ∫ w in Set.Icc (0 : Fin b → ℝ) 1, g w) (ζ : Fin b → ℤ) (hζ0 : ζ ≠ 0) (hζX : ∀ k, |(ζ k : ℝ)| ≤ X) : IsNil2VertSeq ν D X (fun z => (κ : ℂ) * Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * (r₀ k + ∑ l, (z l : ℝ) * r₁ l k + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * r₂ l l' k) : ℝ) : ℂ)) * ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F ((fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i), w) : ℂ) * Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ)))) :=
by
