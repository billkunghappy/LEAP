      calc _ ≤ (C_M * max 1 (Real.log m)) ^ Module.finrank ℚ K := hdens m
        _ ≤ (C_M * Real.log M) ^ Module.finrank ℚ K :=
            pow_le_pow_left₀ (mul_nonneg hCM0 (le_trans zero_le_one (le_max_left _ _)))
              (mul_le_mul_of_nonneg_left hmax hCM0) _
        _ = _ := mul_pow _ _ _
    unfold cramerModel
    split_ifs
    · refine ⟨mul_nonneg hρ.le h0, ?_⟩
      calc ρ * ((primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ))
          ≤ ρ * (C_M ^ Module.finrank ℚ K * Real.log M ^ Module.finrank ℚ K) :=
            mul_le_mul_of_nonneg_left hq hρ.le
        _ = _ := by ring
    · exact ⟨le_rfl, mul_nonneg (mul_nonneg hρ.le (pow_nonneg hCM0 _)) (pow_nonneg hℓ0 _)⟩
  have hbd2 : ∀ x, 2 * cramerModel K ρ (primorial m) x
      ≤ max C₀' (2 * ρ * C_M ^ Module.finrank ℚ K) * Real.log M ^ Module.finrank ℚ K := by
    intro x
    have h3 := (hF4 x).2
    have hmx : 2 * ρ * C_M ^ Module.finrank ℚ K * Real.log M ^ Module.finrank ℚ K
        ≤ max C₀' (2 * ρ * C_M ^ Module.finrank ℚ K) * Real.log M ^ Module.finrank ℚ K :=
      mul_le_mul_of_nonneg_right (le_max_right _ _) (pow_nonneg hℓ0 _)
    have heq : 2 * (ρ * C_M ^ Module.finrank ℚ K * Real.log M ^ Module.finrank ℚ K)
        = 2 * ρ * C_M ^ Module.finrank ℚ K * Real.log M ^ Module.finrank ℚ K := by ring
    linarith
  have hCBnn : 0 ≤ CW / cA ^ cW / Real.log M ^ B :=
    div_nonneg (div_nonneg hCW (Real.rpow_nonneg hcA.le _)) (pow_nonneg hℓ0 _)
  
  have hpartc : ∀ φ : (Fin (Module.finrank ℚ K) → ℤ) → ℝ,
      IsNil2Seq (Module.finrank ℚ K) (Real.log M ^ c) (Real.exp (Real.log M ^ c)) φ →
      |∑ x ∈ omegaBox ω M,
          (vonMangoldtO x - siegelModel K ρ (primorial m) (D M m).2.1 (D M m).2.2 x)
            * φ (ω.equivFun x)|
        ≤ max C₀' (2 * ρ * C_M ^ Module.finrank ℚ K) * ((omegaBox ω M).card : ℝ)
            * Real.exp (-(Real.log M ^ c)) := by
    intro φ hφ
    refine (hC M m hM h1 h2 φ hφ).trans ?_
    apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
    exact mul_le_mul_of_nonneg_right (le_max_left _ _) (Nat.cast_nonneg _)
  refine ⟨siegelModel K ρ (primorial m) (D M m).2.1 (D M m).2.2, ?_, ?_, hpartc⟩
  · 
    intro x _
    by_cases hψ : (D M m).2.1 = 0
    · have hg : siegelModel K ρ (primorial m) (D M m).2.1 (D M m).2.2 x
          = cramerModel K ρ (primorial m) x := by
        simp [siegelModel, hψ]
      rw [hg, abs_of_nonneg (hF4 x).1]
      have := hbd2 x
      have := (hF4 x).1
      linarith
    · rcases (hD M m).2 with h | ⟨hR, _, hβ2, _, _⟩
      · exact absurd h hψ
      have hψx : |((D M m).2.1 x : ℝ)| ≤ 1 := by
        rcases hR.1 x with h | h | h <;> simp [h]
      have ht : 0 ≤ ((Algebra.norm ℤ x).natAbs : ℝ) ^ ((D M m).2.2 - 1) ∧
          ((Algebra.norm ℤ x).natAbs : ℝ) ^ ((D M m).2.2 - 1) ≤ 1 := by
        rcases Nat.eq_zero_or_pos (Algebra.norm ℤ x).natAbs with h0 | hpos
        · rw [h0, Nat.cast_zero, Real.zero_rpow (sub_neg.mpr hβ2).ne]
