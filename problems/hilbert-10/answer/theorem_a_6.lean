        ∀ b : Ideal (NumberField.RingOfIntegers K), b ≠ 0 → b ⊔ q = ⊤ →
        ∀ ρ : NumberField.RingOfIntegers K, ρ ≠ 0 → ρ ∈ b → ρ - 1 ∈ q →
          ∃ Gen : Set (NumberField.RingOfIntegers K),
            (∀ μ ∈ Gen, μ ≠ 0 ∧ μ - ρ ∈ q * b) ∧
            (∀ μ : NumberField.RingOfIntegers K, μ ≠ 0 → μ - ρ ∈ q * b →
                ∃! p : {ν // ν ∈ Gen} ×
                       {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
                  μ = ((p.2 : (NumberField.RingOfIntegers K)ˣ) :
                        NumberField.RingOfIntegers K) * (p.1 : NumberField.RingOfIntegers K)) ∧
            (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
                Finite {μ : {ν // ν ∈ Gen} //
                  Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b}) ∧
            (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
                (∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
                  γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * (I * b) = Ideal.span {δ} * ⊤) →
                Nat.card {μ : {ν // ν ∈ Gen} //
                  Ideal.span {(μ : NumberField.RingOfIntegers K)} = I * b} = hh) ∧
            (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ →
                (¬ ∃ γ δ : NumberField.RingOfIntegers K, γ ≠ 0 ∧ δ ≠ 0 ∧
                  γ - 1 ∈ q ∧ δ - 1 ∈ q ∧ Ideal.span {γ} * (I * b) = Ideal.span {δ} * ⊤) →
                ∀ μ ∈ Gen, Ideal.span {μ} ≠ I * b) :=
by
  classical
  intro q hq
  obtain ⟨hh, T, hhpos, hTcard, hTsub, hTfac⟩ := hidx q hq
  have hEmul : ∀ x y : (NumberField.RingOfIntegers K)ˣ,
      ((x : NumberField.RingOfIntegers K) - 1 ∈ q) →
      ((y : NumberField.RingOfIntegers K) - 1 ∈ q) →
      (((x * y : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) - 1 ∈ q) := by
    intro x y hx hy
    have hid : (((x * y : (NumberField.RingOfIntegers K)ˣ)) : NumberField.RingOfIntegers K) - 1
        = (x : NumberField.RingOfIntegers K) * ((y : NumberField.RingOfIntegers K) - 1)
          + ((x : NumberField.RingOfIntegers K) - 1) := by
      rw [Units.val_mul]; ring
    rw [hid]
    exact Submodule.add_mem _ (Ideal.mul_mem_left q _ hy) hx
  have hP1 : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (NumberField.mixedEmbedding K ((((1 : (NumberField.RingOfIntegers K)ˣ)) :
          NumberField.RingOfIntegers K) : K)).1 w = 1 := by
    intro w; simp
  have hPmul : ∀ (x y : (NumberField.RingOfIntegers K)ˣ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K ((((x * y : (NumberField.RingOfIntegers K)ˣ)) :
          NumberField.RingOfIntegers K) : K)).1 w
        = (NumberField.mixedEmbedding K (((x : NumberField.RingOfIntegers K)) : K)).1 w *
          (NumberField.mixedEmbedding K (((y : NumberField.RingOfIntegers K)) : K)).1 w := by
    intro x y w
    have h1 : ((((x * y : (NumberField.RingOfIntegers K)ˣ)) :
        NumberField.RingOfIntegers K) : K)
        = (((x : NumberField.RingOfIntegers K)) : K) *
          (((y : NumberField.RingOfIntegers K)) : K) := by
      rw [Units.val_mul]; simp
    rw [h1, map_mul]
    simp
