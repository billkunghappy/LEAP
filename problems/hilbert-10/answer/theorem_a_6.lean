theorem kai_layer_cake_pointwise (β : ℝ) (hβ₁ : (1/2 : ℝ) ≤ β) (hβ₂ : β < 1)
    (L : ℕ) (hL : 1 ≤ L) (t : ℕ) (ht : 1 ≤ t) :
    0 ≤ (t : ℝ) ^ (β - 1) - (1 / (L : ℝ)) *
        (((Finset.range L).filter
          (fun j : ℕ => (t : ℝ) ≤ (((j : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1)))).card : ℝ) ∧
    (t : ℝ) ^ (β - 1) - (1 / (L : ℝ)) *
        (((Finset.range L).filter
          (fun j : ℕ => (t : ℝ) ≤ (((j : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1)))).card : ℝ)
      ≤ 1 / (L : ℝ) :=
by
  have hγ : β - 1 < 0 := by linarith
  have hγne : β - 1 ≠ 0 := ne_of_lt hγ
  have hLpos : (0 : ℝ) < L := by exact_mod_cast hL
  have htpos : (0 : ℝ) < t := by exact_mod_cast ht
  have ht1 : (1 : ℝ) ≤ t := by exact_mod_cast ht
  obtain ⟨s, hs_def⟩ : ∃ s : ℝ, s = (t : ℝ) ^ (β - 1) := ⟨_, rfl⟩
  rw [← hs_def]
  have hspos : 0 < s := by rw [hs_def]; exact Real.rpow_pos_of_pos htpos _
  have hs1 : s ≤ 1 := by
    rw [hs_def]; exact Real.rpow_le_one_of_one_le_of_nonpos ht1 hγ.le
  have key : ∀ x : ℝ, 0 < x → ((t : ℝ) ≤ x ^ (1 / (β - 1)) ↔ x ≤ s) := by
    intro x hx
    rw [one_div]
    constructor
    · intro h
      have h2 := Real.rpow_le_rpow_of_nonpos htpos h hγ.le
      rw [Real.rpow_inv_rpow hx.le hγne] at h2
      rw [hs_def]; exact h2
    · intro h
      have h2 := Real.rpow_le_rpow_of_nonpos hx h (inv_nonpos.mpr hγ.le)
      rw [hs_def, Real.rpow_rpow_inv htpos.le hγne] at h2
      exact h2
  have hLs0 : 0 ≤ (L : ℝ) * s := by positivity
  have hLsL : (L : ℝ) * s ≤ L := mul_le_of_le_one_right hLpos.le hs1
  have hfilter : (Finset.range L).filter
      (fun j : ℕ => (t : ℝ) ≤ (((j : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1)))
      = Finset.range ⌊(L : ℝ) * s⌋₊ := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_range]
    have hx : 0 < ((j : ℝ) + 1) / L := by positivity
    rw [key _ hx, div_le_iff₀ hLpos,
