                ((μ : NumberField.RingOfIntegers K) : K)) ^ 2
            ≤ Real.exp (u w) * NumberField.mixedEmbedding.normAtPlace w (ρ +
              NumberField.mixedEmbedding K
                ((μ : NumberField.RingOfIntegers K) : K)) ^ 2 := by
        intro w _
        exact mul_le_mul_of_nonneg_right
          (Real.exp_le_exp.mpr (le_of_lt (hu' w))) (sq_nonneg _)
