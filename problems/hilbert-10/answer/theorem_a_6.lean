      exact ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hGΩfin) hb
    have hs4 := s4 (MeasureTheory.volume.restrict G) (fun u : ι → ℝ => ∑ j, m j * u j) hL
