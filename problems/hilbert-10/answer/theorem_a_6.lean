            - 2 * (Real.pi : ℂ) * Complex.I := by push_cast; ring
      rw [this, Complex.exp_sub, Complex.exp_two_pi_mul_I, div_one]
    have b1 : ‖Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (((t.val : ℝ) / P : ℝ) : ℂ)) - 1‖
        ≤ 2 * Real.pi * ((t.val : ℝ) / P) := by
      rw [e1]
