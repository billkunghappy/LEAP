theorem box_fejer_kernel_moments (b R : ℕ) (hR : 1 ≤ R) (horth : ∀ ζ : Fin b → ℤ, ∫ w in Set.Icc (0 : Fin b → ℝ) 1, Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ)) = if ζ = 0 then (1 : ℂ) else 0) (hexp : ∀ (f : (Fin b → ℝ) → ℝ), Continuous f → ∀ x : Fin b → ℝ, (((∫ w in Set.Icc (0 : Fin b → ℝ) 1, f w * ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (x k - w k) : ℝ) : ℂ))‖ ^ 2 : ℝ)) : ℂ) = ∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), ∑ m' ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), Complex.exp (2 * Real.pi * Complex.I * ((∑ k, ((m k : ℝ) - (m' k : ℝ)) * x k : ℝ) : ℂ)) * ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (f w : ℂ) * Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, ((m k : ℝ) - (m' k : ℝ)) * w k : ℝ) : ℂ)))) (x : Fin b → ℝ) : (∫ w in Set.Icc (0 : Fin b → ℝ) 1, ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (x k - w k) : ℝ) : ℂ))‖ ^ 2 = (R : ℝ) ^ b) ∧ (∀ k : Fin b, ∫ w in Set.Icc (0 : Fin b → ℝ) 1, Real.sin (Real.pi * (x k - w k)) ^ 2 * ‖∑ m ∈ Fintype.piFinset (fun _ : Fin b => Finset.range R), Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (m k : ℝ) * (x k - w k) : ℝ) : ℂ))‖ ^ 2 = (R : ℝ) ^ b / (2 * R)) :=
by
  
