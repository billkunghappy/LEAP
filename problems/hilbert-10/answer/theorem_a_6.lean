      have e2 : (fun k => u.2 k + t k + (γ₂ k : ℝ)) =
          (fun k => u.2 k + t k) + fun k => (γ₂ k : ℝ) := by
        funext k; simp
      rw [e2, hvert]
    rw [hF'J, hF'J]
    simp only [hpt]
  · 
    intro u t
    rw [hF'u, hF'u]
    dsimp only
    rw [hsum2, hE_add]
    ring
  · 
    intro u v hu1 _hu2 hv1 _hv2
    have hS : 0 ≤ ∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k| :=
      add_nonneg (Finset.sum_nonneg fun i _ => abs_nonneg _)
        (Finset.sum_nonneg fun k _ => abs_nonneg _)
    refine le_trans ?_ (mul_le_mul_of_nonneg_right hQX hS)
    by_cases hfar : ∃ k₀, 1 < |u.2 k₀ - v.2 k₀|
    · obtain ⟨k₀, hk₀⟩ := hfar
      have h1 : ‖F' u - F' v‖ ≤ 2 :=
        (norm_sub_le _ _).trans (by linarith [hF'1 u, hF'1 v])
