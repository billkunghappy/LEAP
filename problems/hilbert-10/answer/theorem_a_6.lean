    nlinarith
  have hsq : 2 * (2 * T₀ / (N : ℝ) ^ 2) * ((q₁ : ℝ) * q₂) * (L₁ : ℝ) ^ 2 * (L₂ : ℝ) ^ 2 < 1 := by
    have hN2 : (N : ℝ) ≤ (N : ℝ) ^ 2 := by nlinarith
    rw [show 2 * (2 * T₀ / (N : ℝ) ^ 2) * ((q₁ : ℝ) * q₂) * (L₁ : ℝ) ^ 2 * (L₂ : ℝ) ^ 2
        = 4 * (T₀ * ((q₁ : ℝ) * q₂)) * ((L₁ : ℝ) * L₂) ^ 2 / (N : ℝ) ^ 2 by ring]
    rw [div_lt_one (pow_pos hNpos 2)]
    have h4 : 0 ≤ (T₀ * ((q₁ : ℝ) * q₂)) * ((L₁ : ℝ) * L₂) ^ 2 := by positivity
    have h5 := mul_le_mul_of_nonneg_right hν h4
    nlinarith
  have hsl : 2 * ((2 * (ν : ℝ) + 1) * T₀ / N) * ((q₁ : ℝ) * q₂ * (G : ℝ) ^ 2) * (L₁ : ℝ)
      * (L₂ : ℝ) < 1 := by
    have hG2 : (G : ℝ) ^ 2 ≤ (L₁ : ℝ) * L₂ := by
      rw [sq]; exact mul_le_mul hGL₁r hGL₂r (by positivity) (by positivity)
    have h1 : 0 ≤ (2 * (ν : ℝ) + 1) * (T₀ * ((q₁ : ℝ) * q₂)) * ((L₁ : ℝ) * L₂) := by
      positivity
    have h2 := mul_le_mul_of_nonneg_left hG2 h1
    have h5 : 0 ≤ (2 * (ν : ℝ) + 1) * (T₀ * ((q₁ : ℝ) * q₂)) * ((L₁ : ℝ) * L₂) ^ 2 := by
      positivity
    rw [show 2 * ((2 * (ν : ℝ) + 1) * T₀ / N) * ((q₁ : ℝ) * q₂ * (G : ℝ) ^ 2) * (L₁ : ℝ)
        * (L₂ : ℝ) = 2 * ((2 * (ν : ℝ) + 1) * (T₀ * ((q₁ : ℝ) * q₂)) * ((L₁ : ℝ) * L₂)
          * (G : ℝ) ^ 2) / N by ring]
    rw [div_lt_one hNpos]
    nlinarith
  
  have hXex : ∀ l l', ∃ C : ℤ, (C : ℝ) / (D * (G : ℝ) ^ 2)
      = (((q₂ : ℤ) * (a₁ l l' + a₁ l' l) : ℤ) : ℝ) / (D * (L₁ : ℝ) ^ 2) := by
    intro l l'
    obtain ⟨C, hC⟩ := s4 (p₂ l l' + p₂ l' l) ((q₂ : ℤ) * (a₁ l l' + a₁ l' l))
      ((q₁ : ℤ) * (a₂ l l' + a₂ l' l)) D (L₁ ^ 2) (L₂ ^ 2) (2 * T₀ / (N : ℝ) ^ 2) hDpos
      (one_le_pow₀ hL₁) (one_le_pow₀ hL₂)
      (by rw [Nat.cast_pow]; exact hA₁ l l') (by rw [Nat.cast_pow]; exact hA₂ l l')
      (by push_cast; rw [hDdef]; exact hsq)
    refine ⟨C, ?_⟩
    rw [Nat.pow_gcd_pow, Nat.cast_pow, Nat.cast_pow, ← hG] at hC
    exact hC
  choose Xh hXh using hXex
  have hquad : ∀ l l', |p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)|
      ≤ 2 * T₀ / (N : ℝ) ^ 2 := by
    intro l l'; rw [hXh l l']; exact hA₁ l l'
  
  have hlin₁ := s5 r₁ (fun l => (q₂ : ℤ) * b₁ l) Xh D L₁ G hDpos hL₁ hGpos hL₁N hr₁ hY₁ hquad
  have hlin₂ := s5 r₂ (fun l => (q₁ : ℤ) * b₂ l) Xh D L₂ G hDpos hL₂ hGpos hL₂N hr₂ hY₂ hquad
  
  have hZex : ∀ l, ∃ C : ℤ, (C : ℝ) / (D * (G : ℝ) ^ 2 * (G : ℝ))
      = ((((G : ℤ) ^ 2 * ((q₂ : ℤ) * b₁ l) - (L₁ : ℤ) * ∑ l', Xh l l' * r₁ l' : ℤ) : ℝ)
          / (D * (G : ℝ) ^ 2 * L₁)) := by
    intro l
    obtain ⟨C, hC⟩ := s4 (p₁ l) _ _ (D * (G : ℝ) ^ 2) L₁ L₂ ((2 * (ν : ℝ) + 1) * T₀ / N)
      (mul_pos hDpos (by positivity)) hL₁ hL₂ (hlin₁ l) (hlin₂ l) (by rw [hDdef]; exact hsl)
    refine ⟨C, ?_⟩
    rw [← hG] at hC
    exact hC
  choose Zh hZh using hZex
  have hlinZ : ∀ l, |p₁ l - (Zh l : ℝ) / (D * (G : ℝ) ^ 2 * (G : ℝ))|
      ≤ (2 * (ν : ℝ) + 1) * T₀ / N := by
    intro l; rw [hZh l]; exact hlin₁ l
  
  have hqpos : 1 ≤ 2 * q₁ * q₂ * G ^ 3 :=
    Nat.mul_pos (Nat.mul_pos (Nat.mul_pos two_pos hq₁) hq₂) (pow_pos hGpos 3)
  have hqcast : ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) = 2 * D * (G : ℝ) ^ 2 * G := by
    rw [hDdef]; push_cast; ring
  have hq0 : ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) ≠ 0 := by
    rw [hqcast]; positivity
  refine s6 _ _ (fun l => 2 * Zh l) (fun l l' => (G : ℤ) * Xh l l') hqpos ?_ ?_
  · intro l
    have e1 : ((2 * Zh l : ℤ) : ℝ) / ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ)
        = (Zh l : ℝ) / (D * (G : ℝ) ^ 2 * (G : ℝ)) := by
      rw [hqcast]; push_cast; field_simp
    have e2 : ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * (2 * (ν : ℝ) + 1) * T₀
        / (((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * N) = (2 * (ν : ℝ) + 1) * T₀ / N := by
      rw [mul_assoc, mul_div_mul_left _ _ hq0]
    show |p₁ l - ((2 * Zh l : ℤ) : ℝ) / ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ)|
      ≤ ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * (2 * (ν : ℝ) + 1) * T₀
        / (((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * N)
    rw [e1, e2]
    exact hlinZ l
  · intro l l'
    have e1 : 2 * (((G : ℤ) * Xh l l' : ℤ) : ℝ) / ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ)
        = (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2) := by
      rw [hqcast]; push_cast; field_simp
    have e2 : 2 * (((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * (2 * (ν : ℝ) + 1) * T₀
        / (((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * (N : ℝ) ^ 2))
        = 2 * ((2 * (ν : ℝ) + 1) * T₀) / (N : ℝ) ^ 2 := by
      rw [mul_assoc (((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ)), mul_div_mul_left _ _ hq0, mul_div_assoc']
    show |p₂ l l' + p₂ l' l - 2 * (((G : ℤ) * Xh l l' : ℤ) : ℝ)
        / ((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ)|
      ≤ 2 * (((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * (2 * (ν : ℝ) + 1) * T₀
        / (((2 * q₁ * q₂ * G ^ 3 : ℕ) : ℝ) * (N : ℝ) ^ 2))
    rw [e1, e2]
    refine (hquad l l').trans ?_
    refine div_le_div_of_nonneg_right ?_ (by positivity)
    nlinarith

theorem kai_quad_periodic_weyl (ν : ℕ) :
    ∃ (Cs : ℝ) (As : ℕ), 1 ≤ Cs ∧ 1 ≤ As ∧
      ∀ (N L : ℕ) (δ : ℝ), 1 ≤ L → 0 < δ → δ ≤ 1 →
        Cs * ((L : ℝ) / δ) ^ As ≤ (N : ℝ) →
      ∀ (Ω : Set (Fin ν → ℝ)), Convex ℝ Ω →
      ∀ (A : (Fin ν → ℤ) → Prop),
        (∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (L : ℤ)]) → (A z ↔ A w)) →
      ∀ (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ),
        δ * (((2 * N + 1 : ℕ) : ℝ) ^ ν) ≤
          ‖∑ z ∈ @Finset.filter (Fin ν → ℤ)
                (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ A z)
                (fun _ => Classical.propDecidable _) (intBox ν N),
              giE (kaiQuadPoly p₀ p₁ p₂ z)‖ →
        ∃ q : ℕ, (q : ℝ) ≤ Cs * ((L : ℝ) / δ) ^ As ∧
          KaiQuadMajor ν N q (Cs * ((L : ℝ) / δ) ^ As) (kaiQuadPoly p₀ p₁ p₂) :=
by
  obtain ⟨Cw, Aw, hCw, hAw, hW⟩ := kai_quad_weyl_inverse ν
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = (5 / 2 : ℝ) ^ ν * Cw := ⟨_, rfl⟩
  have hc1 : 1 ≤ c := by
    rw [hc_def]; exact one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num)) hCw
  have hK1 : (1 : ℝ) ≤ 2 * (ν : ℝ) + 1 := by
    have := (Nat.cast_nonneg ν : (0 : ℝ) ≤ ν); linarith
  have hcA : 1 ≤ c ^ (3 * Aw) := one_le_pow₀ hc1
  obtain ⟨Cs, hCs⟩ : ∃ Cs : ℝ, Cs = 16 * (2 * (ν : ℝ) + 1) * c ^ (3 * Aw) := ⟨_, rfl⟩
  obtain ⟨As, hAs⟩ : ∃ As : ℕ, As = 3 * Aw + 6 := ⟨_, rfl⟩
  have hKc : 1 ≤ (2 * (ν : ℝ) + 1) * c ^ (3 * Aw) := one_le_mul_of_one_le_of_one_le hK1 hcA
  have hCs16 : 16 ≤ Cs := by rw [hCs]; linarith
  refine ⟨Cs, As, by linarith, by omega, ?_⟩
  intro N L δ hL hδ hδ1 hthr Ω hΩ A hA p₀ p₁ p₂ hyp
  
  have hL1 : (1 : ℝ) ≤ L := by exact_mod_cast hL
  have hL0 : (0 : ℝ) ≤ L := by linarith
  have hLpos : 0 < L := by omega
  obtain ⟨x, hx_def⟩ : ∃ x : ℝ, x = (L : ℝ) / δ := ⟨_, rfl⟩
  rw [← hx_def] at hthr ⊢
  have hxL : (L : ℝ) ≤ x := by rw [hx_def]; exact le_div_self hL0 hδ hδ1
  have hx1 : 1 ≤ x := le_trans hL1 hxL
  obtain ⟨M, hM_def⟩ : ∃ M : ℝ, M = c ^ (3 * Aw) * x ^ As := ⟨_, rfl⟩
  have hxA1 : 1 ≤ x ^ As := one_le_pow₀ hx1
  have hM1 : 1 ≤ M := by rw [hM_def]; exact one_le_mul_of_one_le_of_one_le hcA hxA1
  have hCsx : Cs * x ^ As = 16 * ((2 * (ν : ℝ) + 1) * M) := by rw [hCs, hM_def]; ring
  
  obtain ⟨T₀, hT₀_def⟩ : ∃ T₀ : ℝ, T₀ = (Cw / (δ * (2 / 5 : ℝ) ^ ν)) ^ Aw := ⟨_, rfl⟩
  have h25 : (2 / 5 : ℝ) ^ ν * (5 / 2) ^ ν = 1 := by rw [← mul_pow]; norm_num
  have h25pos : (0 : ℝ) < (2 / 5 : ℝ) ^ ν := by positivity
  have hdiv : Cw / (δ * (2 / 5 : ℝ) ^ ν) = c / δ := by
    rw [div_eq_div_iff (by positivity) hδ.ne', hc_def]
    linear_combination (-(Cw * δ)) * h25
