noncomputable def kaiTBTheta (K : Type u) [Field K] [NumberField K]
    (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ)
    (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ)
