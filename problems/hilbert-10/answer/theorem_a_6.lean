      by_cases hc : I ≠ 0 ∧ I ⊔ q = ⊤
      · have hsq : lam I * lam I = 1 := hpr I hc.1 hc.2
        rcases mul_self_eq_one_iff.mp hsq with h | h <;> rw [h] <;> simp
      · rw [hoff I hc]; simp
  exact ⟨hC1, hC2, fun s hs => (hC3N s hs).of_norm, hC4, hC5, hC6, hC7,
    fun σ γ _ => s4 q lam hnorm σ γ⟩

theorem kai_hecke_real_trivial_infinity (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    KaiZFTrivInfProp K :=
by
  classical
  
  have hcovering : ∃ R : ℝ, 0 < R ∧
      ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        ∃ y : NumberField.RingOfIntegers K,
          (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
              |(NumberField.mixedEmbedding K (y : K)).1 w - z.1 w| ≤ R) ∧
          (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ‖(NumberField.mixedEmbedding K (y : K)).2 p - z.2 p‖ ≤ R) := by
    have hS0 : (0:ℝ) ≤ ∑ i, ‖NumberField.mixedEmbedding.latticeBasis K i‖ :=
      Finset.sum_nonneg fun i _ => norm_nonneg _
    refine ⟨1 + ∑ i, ‖NumberField.mixedEmbedding.latticeBasis K i‖, by linarith, ?_⟩
    intro z
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp
      (ZSpan.floor (NumberField.mixedEmbedding.latticeBasis K) z).property
    obtain ⟨y, hy⟩ : ∃ y : NumberField.RingOfIntegers K,
        NumberField.mixedEmbedding K (y : K)
          = ((ZSpan.floor (NumberField.mixedEmbedding.latticeBasis K) z :
              NumberField.mixedEmbedding.mixedSpace K)) := by
      refine ⟨∑ i, c i • NumberField.RingOfIntegers.basis K i, ?_⟩
      rw [← hc]
      simp only [NumberField.RingOfIntegers.coe_eq_algebraMap, map_sum, map_zsmul,
        ← NumberField.integralBasis_apply,
        ← NumberField.mixedEmbedding.latticeBasis_apply]
    have hd : NumberField.mixedEmbedding K (y : K) - z
        = -(ZSpan.fract (NumberField.mixedEmbedding.latticeBasis K) z) := by
      rw [ZSpan.fract_apply, hy, neg_sub]
    have hglob : ‖NumberField.mixedEmbedding K (y : K) - z‖
        ≤ 1 + ∑ i, ‖NumberField.mixedEmbedding.latticeBasis K i‖ := by
      rw [hd, norm_neg]
      have h := ZSpan.norm_fract_le (NumberField.mixedEmbedding.latticeBasis K) z
      linarith
    refine ⟨y, ?_, ?_⟩
    · intro w
      have h1 : (NumberField.mixedEmbedding K (y : K)).1 w - z.1 w
          = (NumberField.mixedEmbedding K (y : K) - z).1 w := rfl
      rw [h1, ← Real.norm_eq_abs]
      exact le_trans (norm_le_pi_norm _ w) (le_trans (norm_fst_le _) hglob)
    · intro p
      have h1 : ‖(NumberField.mixedEmbedding K (y : K)).2 p - z.2 p‖
          = ‖(NumberField.mixedEmbedding K (y : K) - z).2 p‖ := rfl
      rw [h1]
      exact le_trans (norm_le_pi_norm _ p) (le_trans (norm_snd_le _) hglob)
  
  have hlogle : ∀ ρ r x : ℝ, 0 < ρ → 0 ≤ r → 2 * r ≤ ρ → |x - ρ| ≤ r →
      |Real.log x - Real.log ρ| ≤ 2 * r / ρ := by
    intro ρ r x hρ hr h2 hx
    obtain ⟨hxlo, hxhi⟩ := abs_le.mp hx
    have hxpos : 0 < x := by linarith
    have h2x : ρ ≤ 2 * x := by linarith
    have hA : Real.log (x / ρ) ≤ x / ρ - 1 :=
      Real.log_le_sub_one_of_pos (div_pos hxpos hρ)
    have hB : Real.log (ρ / x) ≤ ρ / x - 1 :=
      Real.log_le_sub_one_of_pos (div_pos hρ hxpos)
    rw [Real.log_div hxpos.ne' hρ.ne', div_sub_one hρ.ne'] at hA
    rw [Real.log_div hρ.ne' hxpos.ne', div_sub_one hxpos.ne'] at hB
    have hAmul : (Real.log x - Real.log ρ) * ρ ≤ x - ρ := (le_div_iff₀ hρ).mp hA
    have hBmul : (Real.log ρ - Real.log x) * x ≤ ρ - x := (le_div_iff₀ hxpos).mp hB
    have hs8 : (Real.log x - Real.log ρ) * ρ ≤ 2 * r := by linarith
    have hs9 : (Real.log ρ - Real.log x) * ρ ≤ 2 * r := by
      by_cases hu : Real.log ρ - Real.log x ≤ 0
      · nlinarith [mul_nonneg (neg_nonneg.mpr hu) hρ.le]
      · push_neg at hu
        nlinarith [mul_le_mul_of_nonneg_left h2x hu.le]
    rw [abs_le]
    constructor
    · rw [neg_le, le_div_iff₀ hρ]
      linarith
    · rw [le_div_iff₀ hρ]
      exact hs8
  
  have hargle : ∀ (ρ r φ : ℝ) (z : ℂ), 0 < ρ → 0 ≤ r → 4 * r ≤ ρ → |φ| ≤ Real.pi / 4 →
      ‖z - (ρ : ℂ) * Complex.exp ((φ : ℂ) * Complex.I)‖ ≤ r →
      |z.arg - φ| ≤ 4 * r / ρ := by
    intro ρ r φ z hρ hr h4 hφ hz
    have hpi : (0:ℝ) < Real.pi := Real.pi_pos
    have hφab := abs_le.mp hφ
    have harcsin : ∀ x : ℝ, 0 ≤ x → x ≤ 1 → Real.arcsin x ≤ Real.pi / 2 * x := by
      intro x hx0 hx1
      have hphi0 : 0 ≤ Real.arcsin x := Real.arcsin_nonneg.mpr hx0
      have hphi1 : Real.arcsin x ≤ Real.pi / 2 := Real.arcsin_le_pi_div_two x
      have hj := Real.mul_le_sin hphi0 hphi1
      rw [Real.sin_arcsin (by linarith) hx1] at hj
      rw [div_mul_eq_mul_div, div_le_iff₀ hpi] at hj
      nlinarith [hj, hpi]
    have hhalf : ∀ w : ℂ, 0 < w.re → |w.arg| ≤ 2 * (|w.im| / w.re) := by
      intro w hw
      have hnorm : w.re ≤ ‖w‖ := le_trans (le_abs_self _) (Complex.abs_re_le_norm w)
      have hn0 : (0:ℝ) < ‖w‖ := lt_of_lt_of_le hw hnorm
      have him : |w.im| ≤ ‖w‖ := Complex.abs_im_le_norm w
      have hs1 : |w.im / ‖w‖| ≤ 1 := by
        rw [abs_div, abs_of_pos hn0]
        exact div_le_one_of_le₀ him hn0.le
      have harg : w.arg = Real.arcsin (w.im / ‖w‖) := Complex.arg_of_re_nonneg hw.le
      have habs : |Real.arcsin (w.im / ‖w‖)| ≤ Real.pi / 2 * |w.im / ‖w‖| := by
        by_cases hsg : 0 ≤ w.im / ‖w‖
        · rw [abs_of_nonneg hsg, abs_of_nonneg (Real.arcsin_nonneg.mpr hsg)]
          exact harcsin _ hsg (by rw [abs_of_nonneg hsg] at hs1; exact hs1)
        · push_neg at hsg
          have hneg : Real.arcsin (w.im / ‖w‖) ≤ 0 := Real.arcsin_nonpos.mpr hsg.le
          rw [abs_of_neg hsg, abs_of_nonpos hneg, ← Real.arcsin_neg]
          exact harcsin _ (by linarith) (by rw [abs_of_neg hsg] at hs1; exact hs1)
      have hpi2 : Real.pi / 2 ≤ 2 := by nlinarith [Real.pi_le_four]
      have habs2 : |w.im / ‖w‖| ≤ |w.im| / w.re := by
        rw [abs_div, abs_of_pos hn0]
        exact div_le_div_of_nonneg_left (abs_nonneg _) hw hnorm
      rw [harg]
      calc |Real.arcsin (w.im / ‖w‖)| ≤ Real.pi / 2 * |w.im / ‖w‖| := habs
        _ ≤ 2 * (|w.im| / w.re) := mul_le_mul hpi2 habs2 (abs_nonneg _) (by norm_num)
    have hnorm_eb : ‖Complex.exp (((-φ : ℝ) : ℂ) * Complex.I)‖ = 1 :=
      Complex.norm_exp_ofReal_mul_I (-φ)
    have hee : Complex.exp ((φ : ℂ) * Complex.I)
        * Complex.exp (((-φ : ℝ) : ℂ) * Complex.I) = 1 := by
      rw [← Complex.exp_add]
      have hexp : (φ : ℂ) * Complex.I + ((-φ : ℝ) : ℂ) * Complex.I = 0 := by
        push_cast; ring
      rw [hexp, Complex.exp_zero]
    obtain ⟨ζ, hζ⟩ : ∃ ζ : ℂ, ζ = z * Complex.exp (((-φ : ℝ) : ℂ) * Complex.I) := ⟨_, rfl⟩
    have hzeq : Complex.exp ((φ : ℂ) * Complex.I) * ζ = z := by
      have h1 : Complex.exp ((φ : ℂ) * Complex.I) * ζ
          = (Complex.exp ((φ : ℂ) * Complex.I)
              * Complex.exp (((-φ : ℝ) : ℂ) * Complex.I)) * z := by
        rw [hζ]; ring
      rw [h1, hee, one_mul]
    have hzζ : ‖ζ - (ρ : ℂ)‖ ≤ r := by
      have hfac : (z - (ρ : ℂ) * Complex.exp ((φ : ℂ) * Complex.I))
          * Complex.exp (((-φ : ℝ) : ℂ) * Complex.I) = ζ - (ρ : ℂ) := by
        rw [hζ]
        have h2 : (z - (ρ : ℂ) * Complex.exp ((φ : ℂ) * Complex.I))
            * Complex.exp (((-φ : ℝ) : ℂ) * Complex.I)
            = z * Complex.exp (((-φ : ℝ) : ℂ) * Complex.I)
              - (ρ : ℂ) * (Complex.exp ((φ : ℂ) * Complex.I)
                  * Complex.exp (((-φ : ℝ) : ℂ) * Complex.I)) := by ring
        rw [h2, hee, mul_one]
      rw [← hfac, norm_mul, hnorm_eb, mul_one]
      exact hz
    have hre_bd : |ζ.re - ρ| ≤ r := by
      have h1 : |(ζ - (ρ : ℂ)).re| ≤ ‖ζ - (ρ : ℂ)‖ := Complex.abs_re_le_norm _
      simpa using h1.trans hzζ
    have him_bd : |ζ.im| ≤ r := by
      have h1 : |(ζ - (ρ : ℂ)).im| ≤ ‖ζ - (ρ : ℂ)‖ := Complex.abs_im_le_norm _
      simpa using h1.trans hzζ
    have hre_ab := abs_le.mp hre_bd
    have hrepos : 0 < ζ.re := by linarith [hre_ab.1]
    have hre34 : 3 * ρ / 4 ≤ ζ.re := by linarith [hre_ab.1]
    have hζne : ζ ≠ 0 := by
      intro h
      rw [h] at hrepos
      simp at hrepos
    have hψ := hhalf ζ hrepos
    have hD : |ζ.arg| * ζ.re ≤ 2 * r := by
      have h1 : |ζ.arg| * ζ.re ≤ (2 * (|ζ.im| / ζ.re)) * ζ.re :=
        mul_le_mul_of_nonneg_right hψ hrepos.le
      have h2 : (2 * (|ζ.im| / ζ.re)) * ζ.re = 2 * |ζ.im| := by field_simp
      rw [h2] at h1
      linarith [him_bd]
    have hk : (4 * r / ρ) * ρ = 4 * r := by field_simp
    have hk0 : (0:ℝ) ≤ 4 * r / ρ := div_nonneg (by linarith) hρ.le
    have hfinal : |ζ.arg| ≤ 4 * r / ρ := by
      by_contra hcon
      push_neg at hcon
      have h1 : (4 * r / ρ) * ζ.re < |ζ.arg| * ζ.re := mul_lt_mul_of_pos_right hcon hrepos
      have h2 : (4 * r / ρ) * (3 * ρ / 4) ≤ (4 * r / ρ) * ζ.re :=
        mul_le_mul_of_nonneg_left hre34 hk0
      have h3 : (4 * r / ρ) * (3 * ρ / 4) = 3 * r := by
        have h4' : (4 * r / ρ) * (3 * ρ / 4) = ((4 * r / ρ) * ρ) * (3 / 4) := by ring
        rw [h4', hk]; ring
      linarith [hD]
    have hargE : (Complex.exp ((φ : ℂ) * Complex.I)).arg = φ := by
      rw [Complex.exp_mul_I]
      exact Complex.arg_cos_add_sin_mul_I
        (Set.mem_Ioc.mpr ⟨by linarith [hφab.1], by linarith [hφab.2]⟩)
    have hargψ : |ζ.arg| < Real.pi / 2 :=
      Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl hrepos)
    have hψab := abs_lt.mp hargψ
    have hmem : (Complex.exp ((φ : ℂ) * Complex.I)).arg + ζ.arg
        ∈ Set.Ioc (-Real.pi) Real.pi := by
      rw [hargE]
      exact Set.mem_Ioc.mpr ⟨by linarith [hφab.1, hψab.1], by linarith [hφab.2, hψab.2]⟩
    have hargz : z.arg = φ + ζ.arg := by
      have hmul := (Complex.arg_mul_eq_add_arg_iff (Complex.exp_ne_zero _) hζne).mpr hmem
      rw [hzeq, hargE] at hmul
      exact hmul
    rw [hargz]
    have hsimp : φ + ζ.arg - φ = ζ.arg := by ring
    rw [hsimp]
    exact hfinal
  intro q hq t l ξ η lam hext htr hreal
  obtain ⟨R, hR0, hcov⟩ := hcovering
  
  have hcoset : ∃ R' : ℝ, 0 < R' ∧
      ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        ∃ x : NumberField.RingOfIntegers K, x - 1 ∈ q ∧
          (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
              |(NumberField.mixedEmbedding K (x : K)).1 w - z.1 w| ≤ R') ∧
          (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ‖(NumberField.mixedEmbedding K (x : K)).2 p - z.2 p‖ ≤ R') := by
    obtain ⟨m, hmdef⟩ : ∃ m : ℕ, m = Ideal.absNorm q := ⟨_, rfl⟩
    have hmq : (m : NumberField.RingOfIntegers K) ∈ q := by
      rw [hmdef]; exact Ideal.absNorm_mem q
    have hm0 : 0 < m := by
      have hb : q ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
      rw [hmdef]
      exact Nat.pos_of_ne_zero (fun h => hb (Ideal.absNorm_eq_zero_iff.mp h))
    have hmRpos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm0
    have hmR : (m : ℝ) ≠ 0 := ne_of_gt hmRpos
    have hmC : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hm0.ne'
    refine ⟨(m : ℝ) * R, mul_pos hmRpos hR0, ?_⟩
    intro z
    obtain ⟨y, hy1, hy2⟩ :=
      hcov ((fun w => (z.1 w - 1) / (m : ℝ)), (fun p => (z.2 p - 1) / (m : ℂ)))
    have hemb : NumberField.mixedEmbedding K
        ((1 + (m : NumberField.RingOfIntegers K) * y : NumberField.RingOfIntegers K) : K)
        = 1 + (m : NumberField.mixedEmbedding.mixedSpace K)
            * NumberField.mixedEmbedding K (y : K) := by
      have h1 : ((1 + (m : NumberField.RingOfIntegers K) * y :
          NumberField.RingOfIntegers K) : K) = 1 + (m : K) * (y : K) := by
        push_cast; ring
      rw [h1, map_add, map_mul, map_one, map_natCast]
    refine ⟨1 + (m : NumberField.RingOfIntegers K) * y, ?_, ?_, ?_⟩
    · rw [add_sub_cancel_left]
      exact Ideal.mul_mem_right y q hmq
    · intro w
      have hx : (NumberField.mixedEmbedding K
          ((1 + (m : NumberField.RingOfIntegers K) * y :
            NumberField.RingOfIntegers K) : K)).1 w
          = 1 + (m : ℝ) * (NumberField.mixedEmbedding K (y : K)).1 w := by
        rw [hemb]; simp
      rw [hx]
      have hid : 1 + (m : ℝ) * (NumberField.mixedEmbedding K (y : K)).1 w - z.1 w
          = (m : ℝ) * ((NumberField.mixedEmbedding K (y : K)).1 w
              - (z.1 w - 1) / (m : ℝ)) := by
        rw [mul_sub, mul_div_cancel₀ _ hmR]; ring
      rw [hid, abs_mul, abs_of_pos hmRpos]
      exact mul_le_mul_of_nonneg_left (hy1 w) hmRpos.le
    · intro p
      have hx : (NumberField.mixedEmbedding K
          ((1 + (m : NumberField.RingOfIntegers K) * y :
            NumberField.RingOfIntegers K) : K)).2 p
          = 1 + (m : ℂ) * (NumberField.mixedEmbedding K (y : K)).2 p := by
        rw [hemb]; simp
      rw [hx]
      have hid : 1 + (m : ℂ) * (NumberField.mixedEmbedding K (y : K)).2 p - z.2 p
          = (m : ℂ) * ((NumberField.mixedEmbedding K (y : K)).2 p
              - (z.2 p - 1) / (m : ℂ)) := by
        rw [mul_sub, mul_div_cancel₀ _ hmC]; ring
      rw [hid, norm_mul, Complex.norm_natCast]
      exact mul_le_mul_of_nonneg_left (hy2 p) hmRpos.le
  obtain ⟨R', hR'0, hcov'⟩ := hcoset
  
  have happrox : ∀ (ρ : NumberField.InfinitePlace K → ℝ)
      (φ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
      (∀ w : NumberField.InfinitePlace K, 4 * R' ≤ ρ w) →
      ∃ x : NumberField.RingOfIntegers K,
        x - 1 ∈ q ∧ x ≠ 0 ∧
        (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
            0 < (NumberField.mixedEmbedding K (x : K)).1 w) ∧
        (∀ w : NumberField.InfinitePlace K, |w (x : K) - ρ w| ≤ R') ∧
        (∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            ‖(NumberField.mixedEmbedding K (x : K)).2 p
              - (ρ (p : NumberField.InfinitePlace K) : ℂ)
                * Complex.exp ((φ p : ℂ) * Complex.I)‖ ≤ R') := by
    intro ρ φ hρ
    obtain ⟨x, hx1, hxr, hxc⟩ := hcov'
      ((fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
          ρ (w : NumberField.InfinitePlace K)),
       (fun p : {w : NumberField.InfinitePlace K // w.IsComplex} =>
          (ρ (p : NumberField.InfinitePlace K) : ℂ) * Complex.exp ((φ p : ℂ) * Complex.I)))
    have hxr' : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        |(NumberField.mixedEmbedding K (x : K)).1 w
          - ρ (w : NumberField.InfinitePlace K)| ≤ R' := fun w => hxr w
    have hxc' : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        ‖(NumberField.mixedEmbedding K (x : K)).2 p
          - (ρ (p : NumberField.InfinitePlace K) : ℂ)
            * Complex.exp ((φ p : ℂ) * Complex.I)‖ ≤ R' := fun p => hxc p
    have hpos : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        0 < (NumberField.mixedEmbedding K (x : K)).1 w := by
      intro w
      have h1 := abs_le.mp (hxr' w)
      have h2 := hρ (w : NumberField.InfinitePlace K)
      linarith [h1.1]
    have hplace : ∀ w : NumberField.InfinitePlace K, |w (x : K) - ρ w| ≤ R' := by
      intro w
      rcases w.isReal_or_isComplex with hw | hw
      · have hval : w (x : K)
            = |(NumberField.mixedEmbedding K (x : K)).1 ⟨w, hw⟩| := by
          rw [← NumberField.mixedEmbedding.normAtPlace_apply w ((x : K)),
            NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw, Real.norm_eq_abs]
        rw [hval, abs_of_pos (hpos ⟨w, hw⟩)]
        exact hxr' ⟨w, hw⟩
      · have hval : w (x : K)
            = ‖(NumberField.mixedEmbedding K (x : K)).2 ⟨w, hw⟩‖ := by
          rw [← NumberField.mixedEmbedding.normAtPlace_apply w ((x : K)),
            NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw]
        have hρ0 : (0 : ℝ) ≤ ρ w := by linarith [hρ w, hR'0]
        have hnc : ‖(ρ w : ℂ) * Complex.exp ((φ ⟨w, hw⟩ : ℂ) * Complex.I)‖ = ρ w := by
          rw [Complex.norm_mul, Complex.norm_real, Complex.norm_exp_ofReal_mul_I,
            Real.norm_eq_abs, abs_of_nonneg hρ0, mul_one]
        have hkey := abs_norm_sub_norm_le
          ((NumberField.mixedEmbedding K (x : K)).2 ⟨w, hw⟩)
          ((ρ w : ℂ) * Complex.exp ((φ ⟨w, hw⟩ : ℂ) * Complex.I))
        rw [hnc] at hkey
        rw [hval]
        exact hkey.trans (hxc' ⟨w, hw⟩)
    refine ⟨x, hx1, ?_, hpos, hplace, hxc'⟩
    obtain ⟨w₀⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
    have h1 := abs_le.mp (hplace w₀)
    have h2 := hρ w₀
    have h3 : 0 < w₀ (x : K) := by linarith [h1.1]
    have h4 : (x : K) ≠ 0 := NumberField.InfinitePlace.pos_iff.mp h3
    intro hx
    apply h4
    rw [hx]
    exact map_zero (algebraMap (NumberField.RingOfIntegers K) K)
  
  have htwist : ∀ x : NumberField.RingOfIntegers K, x - 1 ∈ q →
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        0 < (NumberField.mixedEmbedding K (x : K)).1 w) →
      kaiHeckeTwist K q t l ξ η x
        = Complex.exp ((((∑ w : NumberField.InfinitePlace K,
                t w * (w.mult : ℝ) * Real.log (w (x : K)))
              + (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                (l p : ℝ) * ((NumberField.mixedEmbedding K (x : K)).2 p).arg) : ℝ) : ℂ)
            * Complex.I) := by
    intro x hx1 hpos
    have hmk : Ideal.Quotient.mk q x = 1 :=
      (Ideal.Quotient.eq.mpr hx1).trans (map_one (Ideal.Quotient.mk q))
    have hx : IsUnit (Ideal.Quotient.mk q x) := by rw [hmk]; exact isUnit_one
    have hunit : hx.unit = 1 := Units.ext (by rw [IsUnit.unit_spec, Units.val_one, hmk])
    have hxi : (ξ hx.unit : ℂ) = 1 := by rw [hunit, map_one, Circle.coe_one]
    have hsign : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (if η w then
          ((Real.sign ((NumberField.mixedEmbedding K ((x : K))).1 w) : ℝ) : ℂ)
        else 1)) = 1 := by
      refine Finset.prod_eq_one (fun w _ => ?_)
      rw [Real.sign_of_pos (hpos w)]
      simp
    have hA : ((∑ w : NumberField.InfinitePlace K,
          t w * (w.mult : ℝ) * Real.log (w (x : K)) : ℝ) : ℂ)
        = ∑ w : NumberField.InfinitePlace K,
            (t w : ℂ) * ((w.mult : ℝ) : ℂ) * ((Real.log (w ((x : K))) : ℝ) : ℂ) := by
      rw [Complex.ofReal_sum]
      exact Finset.sum_congr rfl (fun w _ => by push_cast; ring)
    have hB : ((∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (l p : ℝ) * ((NumberField.mixedEmbedding K (x : K)).2 p).arg : ℝ) : ℂ)
        = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            ((l p : ℤ) : ℂ) *
              ((((NumberField.mixedEmbedding K ((x : K))).2 p).arg : ℝ) : ℂ) := by
      rw [Complex.ofReal_sum]
      exact Finset.sum_congr rfl (fun p _ => by push_cast; ring)
    simp only [kaiHeckeTwist]
    rw [dif_pos hx, hxi, hsign, one_mul, one_mul,
      ← Complex.exp_sum, ← Complex.exp_add, Complex.ofReal_add, hA, hB]
    congr 1
    rw [add_mul, Finset.mul_sum, Finset.sum_mul, Finset.sum_mul]
    congr 1
    · exact Finset.sum_congr rfl (fun w _ => by ring)
    · exact Finset.sum_congr rfl (fun p _ => by ring)
  
  have hH6 : ∀ α : NumberField.RingOfIntegers K, α ≠ 0 →
      lam (Ideal.span {α}) = kaiHeckeTwist K q t l ξ η α := hext.2.2.2.2.2
  have hpi : (0:ℝ) < Real.pi := Real.pi_pos
  have hmult0 : ∀ w : NumberField.InfinitePlace K, (0:ℝ) ≤ (w.mult : ℝ) :=
    fun w => by positivity
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
      A = ∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * t w) ^ 2 := ⟨_, rfl⟩
  obtain ⟨Bq, hBdef⟩ : ∃ Bq : ℝ,
      Bq = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ((l p : ℝ)) ^ 2 := ⟨_, rfl⟩
  have hA0 : (0:ℝ) ≤ A := by
    rw [hAdef]; exact Finset.sum_nonneg fun w _ => sq_nonneg _
  have hB0 : (0:ℝ) ≤ Bq := by
    rw [hBdef]; exact Finset.sum_nonneg fun p _ => sq_nonneg _
  have main : ¬ (0 < A + Bq) := by
    intro hSpos
    obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = A + Bq := ⟨_, rfl⟩
    have hS0 : 0 < S := by rw [hSdef]; exact hSpos
    have hSne : S ≠ 0 := ne_of_gt hS0
    obtain ⟨c, hcdef⟩ : ∃ c : NumberField.InfinitePlace K → ℝ,
        c = fun w => Real.pi / 4 * ((w.mult : ℝ) * t w) / S := ⟨_, rfl⟩
    obtain ⟨φ, hφdef⟩ : ∃ φ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ,
        φ = fun p => Real.pi / 4 * ((l p : ℝ)) / S := ⟨_, rfl⟩
    have hid1 : (∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * t w) * c w)
        = Real.pi / 4 / S * A := by
      rw [hAdef, Finset.mul_sum]
      refine Finset.sum_congr rfl fun w _ => ?_
      simp only [hcdef]
      ring
    have hid2 : (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ((l p : ℝ)) * φ p)
        = Real.pi / 4 / S * Bq := by
      rw [hBdef, Finset.mul_sum]
      refine Finset.sum_congr rfl fun p _ => ?_
      simp only [hφdef]
      ring
    have hid : (∑ w : NumberField.InfinitePlace K, ((w.mult : ℝ) * t w) * c w)
        + (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ((l p : ℝ)) * φ p)
        = Real.pi / 4 := by
      rw [hid1, hid2, ← mul_add, ← hSdef]
      field_simp
    have hφbd : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        |φ p| ≤ Real.pi / 4 := by
      intro p
      by_cases hlp : l p = 0
      · have hz : φ p = 0 := by simp only [hφdef, hlp]; norm_num
        rw [hz, abs_zero]; linarith
      · have h1 : (1:ℝ) ≤ |(l p : ℝ)| := by
          rw [← Int.cast_abs]
          exact_mod_cast Int.one_le_abs hlp
        have h2 : ((l p : ℝ)) ^ 2 ≤ Bq := by
          rw [hBdef]
          exact Finset.single_le_sum
            (f := fun p : {w : NumberField.InfinitePlace K // w.IsComplex} => ((l p : ℝ)) ^ 2)
            (fun i _ => sq_nonneg _) (Finset.mem_univ p)
        have h3 : |(l p : ℝ)| ≤ S := by
          have hs : |(l p : ℝ)| ^ 2 = ((l p : ℝ)) ^ 2 := sq_abs _
          have hnn : (0:ℝ) ≤ (|(l p : ℝ)| - 1) * |(l p : ℝ)| :=
            mul_nonneg (by linarith) (abs_nonneg _)
          rw [hSdef]
          nlinarith [h1, h2, hA0, hs, hnn]
        have heq : |φ p| = Real.pi / 4 * |(l p : ℝ)| / S := by
          simp only [hφdef]
          rw [abs_div, abs_mul, abs_of_nonneg (by positivity : (0:ℝ) ≤ Real.pi / 4),
            abs_of_pos hS0]
        rw [heq, div_le_iff₀ hS0]
        nlinarith [h3, hpi]
    obtain ⟨T, hTdef⟩ : ∃ T : ℝ,
        T = ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * |t w| := ⟨_, rfl⟩
    obtain ⟨D, hDdef⟩ : ∃ D : ℝ,
        D = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |(l p : ℝ)| := ⟨_, rfl⟩
    have hT0 : (0:ℝ) ≤ T := by
      rw [hTdef]
      exact Finset.sum_nonneg fun w _ => mul_nonneg (hmult0 w) (abs_nonneg _)
    have hD0 : (0:ℝ) ≤ D := by
      rw [hDdef]; exact Finset.sum_nonneg fun p _ => abs_nonneg _
    obtain ⟨Lam, hLamdef⟩ : ∃ Lam : ℝ, Lam = 1 + T + D := ⟨_, rfl⟩
    have hLam1 : (1:ℝ) ≤ Lam := by rw [hLamdef]; linarith
    have hLam0 : (0:ℝ) < Lam := by linarith
    have hLamne : Lam ≠ 0 := ne_of_gt hLam0
    obtain ⟨ep, hepdef⟩ : ∃ ep : ℝ, ep = Real.pi / (8 * Lam) := ⟨_, rfl⟩
    have hep0 : 0 < ep := by rw [hepdef]; positivity
    obtain ⟨Cm, hCmdef⟩ : ∃ Cm : ℝ,
        Cm = ∑ w : NumberField.InfinitePlace K, |c w| := ⟨_, rfl⟩
    have hcCm : ∀ w : NumberField.InfinitePlace K, |c w| ≤ Cm := by
      intro w
      rw [hCmdef]
      exact Finset.single_le_sum
        (f := fun w : NumberField.InfinitePlace K => |c w|)
        (fun i _ => abs_nonneg _) (Finset.mem_univ w)
    obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = Real.exp (-Cm) := ⟨_, rfl⟩
    have ha0 : 0 < a := by rw [hadef]; exact Real.exp_pos _
    obtain ⟨N, hNdef⟩ : ∃ N : ℝ,
        N = max (4 * R' / a) (4 * R' / (a * ep)) + 1 := ⟨_, rfl⟩
    have hmax0 : (0:ℝ) ≤ max (4 * R' / a) (4 * R' / (a * ep)) :=
      le_trans (by positivity) (le_max_left (4 * R' / a) (4 * R' / (a * ep)))
    have hN1 : (1:ℝ) ≤ N := by rw [hNdef]; linarith
    have hN0 : (0:ℝ) < N := by linarith
    have hNapos : (0:ℝ) < N * a := by positivity
    have hNa : 4 * R' < N * a := by
      have h1 : 4 * R' / a ≤ max (4 * R' / a) (4 * R' / (a * ep)) := le_max_left _ _
