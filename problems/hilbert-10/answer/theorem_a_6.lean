            · rw [max_eq_right h3]; linarith
            · rw [max_eq_left h3]
              have := mul_nonneg (sub_nonneg.2 hEmEp.le) (sub_nonneg.2 hv1)
              nlinarith
          rw [hb', hDeq, abs_le]
