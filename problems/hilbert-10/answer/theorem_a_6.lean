          = G ∩ {u : ι → ℝ | (∑ j, m j * u j) ∈ A} := Set.inter_comm _ _
      rw [MeasureTheory.Measure.map_apply hL hA, MeasureTheory.withDensity_apply _ (hL hA),
        MeasureTheory.Measure.restrict_restrict (hL hA), hset]
    have hinv : ∀ (b : ℝ) (A : Set ℝ), MeasurableSet A →
        MeasureTheory.Measure.map (fun u : ι → ℝ => ∑ j, m j * u j)
            ((MeasureTheory.volume.restrict G).withDensity w) ((fun t : ℝ => b + t) ⁻¹' A)
          = MeasureTheory.Measure.map (fun u : ι → ℝ => ∑ j, m j * u j)
            ((MeasureTheory.volume.restrict G).withDensity w) A := by
      intro b A hA
