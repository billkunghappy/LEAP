theorem kai_landau_entire_lower_bound (Phi : ℂ → ℂ) (hPhi : Differentiable ℂ Phi)
    (cc : ℕ → ℝ) (T : ℝ) (hT : 1 ≤ T)
    (hcc : ∀ m : ℕ, 0 ≤ cc m) (hcc0 : 1 ≤ cc 0)
    (hbd : ∀ z : ℂ, ‖z - 2‖ ≤ 3 / 2 → ‖Phi z‖ ≤ T)
    (hexp : ∀ z : ℂ, ‖z‖ < 1 →
        HasSum (fun m : ℕ => (cc m : ℂ) * z ^ m) (Phi (2 - z) / (1 - z)))
    (β : ℝ) (hβ0 : 7 / 8 ≤ β) (hβ1 : β < 1) (hzero : Phi (β : ℂ) = 0) :
    (1 - β) / (2 * Real.exp 1) *
        (32 * T) ^ (-((1 - β) / Real.log (4 / 3))) ≤ (Phi 1).re :=
by
  have hT0 : (0:ℝ) < T := by linarith
  have h32T : (1:ℝ) < 32 * T := by linarith
  have h32T0 : (0:ℝ) < 32 * T := by linarith
  have hL : 0 < Real.log (4 / 3) := Real.log_pos (by norm_num)
  have hrpos : (0:ℝ) < 2 - β := by linarith
  have hr1 : (1:ℝ) < 2 - β := by linarith
  
  
  have hS7 : ∀ f : ℂ → ℂ, Differentiable ℂ f → ∀ (u : ℕ → ℂ) (R C : ℝ), 0 < R →
      (∀ z : ℂ, ‖z‖ = R → ‖f z‖ ≤ C) →
      (∀ z : ℂ, ‖z‖ < 1 → HasSum (fun m : ℕ => u m * z ^ m) (f z)) →
      (∀ m : ℕ, ‖u m‖ ≤ C / R ^ m) ∧
        (∀ z : ℂ, HasSum (fun m : ℕ => u m * z ^ m) (f z)) := by
    intro f hf u R C hR hC hu
    obtain ⟨v, hvdef⟩ : ∃ v : ℕ → ℂ, ∀ m, v m = iteratedDeriv m f 0 / (m.factorial : ℂ) :=
      ⟨_, fun _ => rfl⟩
    have htay : ∀ z : ℂ, HasSum (fun m : ℕ => v m * z ^ m) (f z) := by
      intro z
      have e : (fun n : ℕ => ((n.factorial : ℂ))⁻¹ • ((z - (0 : ℂ)) ^ n • iteratedDeriv n f 0))
          = (fun n : ℕ => v n * z ^ n) := by
        funext n
        rw [hvdef, sub_zero, smul_eq_mul, smul_eq_mul, div_eq_mul_inv]
        ring
      rw [← e]
      exact Complex.hasSum_taylorSeries_of_entire hf 0 z
    have hfps : ∀ w : ℕ → ℂ, (∀ z : ℂ, ‖z‖ < 1 → HasSum (fun m : ℕ => w m * z ^ m) (f z)) →
        HasFPowerSeriesAt f (FormalMultilinearSeries.ofScalars ℂ w) 0 := by
      intro w hw
      obtain ⟨t, htval⟩ : ∃ t : NNReal, (t : ℝ) = 1 / 2 := ⟨⟨1 / 2, by norm_num⟩, rfl⟩
      have ht0 : (0:ℝ) < (t : ℝ) := by rw [htval]; norm_num
      have htr : (t : ℝ) < 1 := by rw [htval]; norm_num
      have hnormeq : ∀ n : ℕ, ‖FormalMultilinearSeries.ofScalars ℂ w n‖ = ‖w n‖ :=
        fun n => FormalMultilinearSeries.ofScalars_norm ℂ w n
      have hrad : (t : ENNReal) ≤ (FormalMultilinearSeries.ofScalars ℂ w).radius := by
        apply FormalMultilinearSeries.le_radius_of_summable_norm
        have hz : ‖(((t : ℝ)) : ℂ)‖ < 1 := by
          rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht0]; exact htr
        have hs2 : Summable (fun m : ℕ => ‖w m * ((((t : ℝ)) : ℂ)) ^ m‖) :=
          summable_norm_iff.mpr (hw (((t : ℝ)) : ℂ) hz).summable
        refine hs2.congr (fun n => ?_)
        rw [hnormeq, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht0]
      have hball : HasFPowerSeriesOnBall f (FormalMultilinearSeries.ofScalars ℂ w) 0
          (t : ENNReal) := by
        refine ⟨hrad, ?_, ?_⟩
