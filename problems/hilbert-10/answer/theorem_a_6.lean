      intro i j
      rw [hinner, hβa i, kai_hz_mixed_inner_trace, hbio i j]
      split_ifs <;> norm_num
    have hpois := hP (Module.finrank ℚ K) (fun i => Φ (βa i))
      (fun j => Φ (kaiHZDualTwist K (NumberField.mixedEmbedding K (ν j))))
      hbioE F (Φ ρ)
    have hLHS : kaiHZIdealTheta K a ρ η l y
        = ∑' m : Fin (Module.finrank ℚ K) → ℤ, F (Φ ρ + ∑ i, (m i : ℝ) • Φ (βa i)) := by
      simp only [kaiHZIdealTheta]
      rw [← ea.tsum_eq]
      refine tsum_congr fun m => ?_
      have h1 : Φ ρ + ∑ i, (m i : ℝ) • Φ (βa i)
          = Φ (ρ + NumberField.mixedEmbedding K
                ((ea m : NumberField.RingOfIntegers K) : K)) := by
        rw [hea m, map_add, map_sum]
        congr 1
        exact Finset.sum_congr rfl fun i _ => (map_smul Φ _ _).symm
      rw [h1, hFΦ]
    have hstep : ∀ m : Fin (Module.finrank ℚ K) → ℤ,
        FourierTransform.fourier (fun x => F x)
            (∑ j, (m j : ℝ) •
              Φ (kaiHZDualTwist K (NumberField.mixedEmbedding K (ν j)))) *
          Complex.exp (2 * Real.pi * Complex.I *
            ((inner ℝ (∑ j, (m j : ℝ) •
                Φ (kaiHZDualTwist K (NumberField.mixedEmbedding K (ν j)))) (Φ ρ) : ℝ) : ℂ))
        = (κ₀ * (((∏ w : NumberField.InfinitePlace K,
              y w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ) * TC) *
          (kaiHZArchWeight K η (fun p => -l p)
              (NumberField.mixedEmbedding K ((eb m : K))) *
            ((kaiHZGaussian K (fun w => rr w / y w)
              (NumberField.mixedEmbedding K ((eb m : K))) : ℝ) : ℂ) *
            Complex.exp (2 * Real.pi * Complex.I *
              ((kaiHZMixedInner K (NumberField.mixedEmbedding K ((eb m : K)))
                (kaiHZDualTwist K ρ) : ℝ) : ℂ))) := by
      intro m
      have hvec : (∑ j, (m j : ℝ) •
            Φ (kaiHZDualTwist K (NumberField.mixedEmbedding K (ν j))))
          = Φ (kaiHZDualTwist K (NumberField.mixedEmbedding K ((eb m : K)))) := by
        rw [heb m]
        simp only [map_sum, map_smul]
      have hscale : (fun w => rr w * (1 / y w)) = fun w => rr w / y w := by
