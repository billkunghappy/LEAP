    rwa [FractionalIdeal.coeIdeal_absNorm,
      FractionalIdeal.absNorm_span_singleton (NumberField.RingOfIntegers K)] at h
  have hJorb : ∀ ν μ : Rep, J ν = J μ → ∃ ε : (NumberField.RingOfIntegers K)ˣ,
      ((ε : NumberField.RingOfIntegers K) : K) * (ν.1.1 : K) = (μ.1.1 : K) := by
    intro ν μ h
    have hsp : FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) (ν.1.1 : K)
        = FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) (μ.1.1 : K) := by
      rw [← hJ ν, ← hJ μ, h]
    obtain ⟨z, hz⟩ := FractionalIdeal.spanSingleton_eq_spanSingleton.mp hsp
    refine ⟨z, ?_⟩
    rw [Units.smul_def, Algebra.smul_def] at hz
    exact hz
  
  have hfib : ∀ ν₀ : Rep, ({ν : Rep | J ν = J ν₀}).Finite ∧
      Nat.card ↥({ν : Rep | J ν = J ν₀}) ≤ G.index * wq := by
    intro ν₀
    have hψex : ∀ ν : ↥({ν : Rep | J ν = J ν₀}), ∃ ε : (NumberField.RingOfIntegers K)ˣ,
        ((ε : NumberField.RingOfIntegers K) : K) * (ν₀.1.1 : K) = ((ν.1).1.1 : K) :=
      fun ν => hJorb ν₀ ν.1 (ν.2).symm
    choose ψ hψ using hψex
    have hψinj : Function.Injective ψ := by
      intro ν μ h
      have h1 : ((ν.1).1.1 : K) = ((μ.1).1.1 : K) := by
        rw [← hψ ν, ← hψ μ, h]
      exact Subtype.ext (Subtype.ext (Subtype.ext h1))
    have hSrange : ∀ a ∈ Set.range ψ, ∀ c ∈ Set.range ψ, a⁻¹ * c ∈ G →
        a⁻¹ * c ∈ {v : (NumberField.RingOfIntegers K)ˣ |
