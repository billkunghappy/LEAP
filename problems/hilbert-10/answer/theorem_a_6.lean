    have hf' : Continuous (fun t : Fin b → ℝ => (F (u₁, fun k => u₂ k + t k) : ℂ)) :=
      Complex.continuous_ofReal.comp hf
    exact hf'.mul (by fun_prop)
  
  have hsf : ∀ (u₁ : Fin a → ℝ) (u₂ : Fin b → ℝ),
      Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * u₂ k : ℝ) : ℂ)) *
        ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (F (u₁, w) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ)))
      = ∫ t in Set.Icc (0 : Fin b → ℝ) 1, (F (u₁, fun k => u₂ k + t k) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * t k : ℝ) : ℂ))) := by
    intro u₁ u₂
    obtain ⟨g, hg⟩ : ∃ g : (Fin b → ℝ) → ℂ, g = fun w => (F (u₁, w) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I * ((∑ k, (ζ k : ℝ) * w k : ℝ) : ℂ))) := ⟨_, rfl⟩
    have hsumInt : ∀ (w : Fin b → ℝ) (n : Fin b → ℤ),
        ∑ k, (ζ k : ℝ) * (w + fun k => (n k : ℝ)) k =
          ∑ k, (ζ k : ℝ) * w k + (((∑ k, ζ k * n k : ℤ)) : ℝ) := by
