  have he_le : e ≤ e₀ := by rw [he_def]; exact min_le_left _ _
  have he_nn : 0 ≤ e := by rw [he_def]; exact he_pos.le
  have he_a : e ≤ 1 / (2 * a) := by rw [he_def]; exact min_le_right _ _
  have hf_le : f ≤ f₀ := by rw [hf_def]; exact min_le_left _ _
  have hf_half : f ≤ 1 / 2 := by rw [hf_def]; exact min_le_right _ _
