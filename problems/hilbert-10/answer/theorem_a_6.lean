      (fun I => haa0 _) hnn1 hlog (fun s => Zeta s * dslope Zf 1 s) hΦdiff hderiv
      (1 / (2 * ((Module.finrank ℚ K : ℕ) : ℝ))) hτ0 hτ1
  
  have hgen : ∀ m : ℕ, ((m + 1 : ℕ) : NumberField.RingOfIntegers K) ≠ 0 := by
