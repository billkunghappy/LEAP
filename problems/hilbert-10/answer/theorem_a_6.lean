theorem kai_v_bracket_lemma : ∃ C₀ : ℕ, 1 ≤ C₀ ∧
    ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (r : ℕ) (M δ ε : ℝ) (H : ℕ),
