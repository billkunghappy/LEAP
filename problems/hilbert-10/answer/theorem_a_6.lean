    have hAsum : ∀ m : ℕ, Summable (fun x : X =>
        a x * Real.log ((nn x : ℝ)) ^ m * ((nn x : ℝ)) ^ (-(2 : ℝ))) := by
      intro m
      obtain ⟨E, hEdef⟩ : ∃ E : ℝ, E = 1 / (2 * ((m : ℝ) + 1)) := ⟨_, rfl⟩
      have hmpos : (0 : ℝ) < 2 * ((m : ℝ) + 1) := by positivity
      have hEpos : (0 : ℝ) < E := by rw [hEdef]; positivity
      obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = (E ^ m)⁻¹ := ⟨_, rfl⟩
