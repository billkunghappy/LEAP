    mul_nonneg (mul_nonneg hn0 hS0) (sq_nonneg _)
  linarith

theorem kai_lp_vm_short_count (K : Type u) [Field K] [NumberField K]
    (x y : ℝ) (hx : 1 ≤ x) (hy : 0 ≤ y) (hyx : y ≤ x) :
    (∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
          I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x ∧ ¬ ((Ideal.absNorm I : ℝ) ≤ y)},
        kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)))
      ≤ 4 * (Module.finrank ℚ K : ℝ) * (x - y + 1) * Real.log x :=
by
  classical
  
  
  have hcolour : ∃ (col : Ideal (NumberField.RingOfIntegers K) → Fin (Module.finrank ℚ K))
      (rchar rdeg : Ideal (NumberField.RingOfIntegers K) → ℕ),
      (∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
          Nat.Prime (rchar P) ∧ 1 ≤ rdeg P ∧
            Ideal.absNorm P = rchar P ^ rdeg P) ∧
      (∀ P Q : Ideal (NumberField.RingOfIntegers K),
          P.IsPrime → P ≠ ⊥ → Q.IsPrime → Q ≠ ⊥ →
          rchar P = rchar Q → col P = col Q → P = Q) := by
    have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
    have sA : ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
        ∃ p f : ℕ, Nat.Prime p ∧ 1 ≤ f ∧ Ideal.absNorm P = p ^ f ∧
          (p : NumberField.RingOfIntegers K) ∈ P := by
      intro P hP hP0
      haveI := hP
      have hqdef : Ideal.under ℤ P
          = Ideal.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) P := Ideal.under_def ℤ P
      haveI hqp : (Ideal.under ℤ P).IsPrime := by
        rw [hqdef]; exact Ideal.comap_isPrime _ P
      have hNmem : ((Ideal.absNorm P : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [hqdef, Ideal.mem_comap]
        simpa using Ideal.absNorm_mem P
      have hN0 : (Ideal.absNorm P : ℕ) ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hP0
      have hqne : Ideal.under ℤ P ≠ ⊥ := by
        intro h
        rw [h, Ideal.mem_bot] at hNmem
        exact hN0 (by exact_mod_cast hNmem)
      obtain ⟨g, hgq⟩ : ∃ g : ℤ, Ideal.span {g} = Ideal.under ℤ P :=
        ⟨Submodule.IsPrincipal.generator (Ideal.under ℤ P), Ideal.span_singleton_generator _⟩
      have hg0 : g ≠ 0 := by
        intro h
        exact hqne (hgq ▸ (Ideal.span_singleton_eq_bot.mpr h))
      have hspanne : Ideal.span {g} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]; exact hg0
      haveI hspanp : (Ideal.span {g}).IsPrime := hgq ▸ hqp
      have hgp : Prime g := (Ideal.span_singleton_prime hg0).mp hspanp
      haveI hlo : P.LiesOver (Ideal.span {g}) := ⟨hgq⟩
      haveI hspanmax : (Ideal.span {g}).IsMaximal := hspanp.isMaximal hspanne
      refine ⟨g.natAbs, (Ideal.span {g}).inertiaDeg P, Int.prime_iff_natAbs_prime.mp hgp,
        Ideal.inertiaDeg_pos (Ideal.span {g}) P, Ideal.absNorm_eq_pow_inertiaDeg P hgp, ?_⟩
      have hmem : ((g.natAbs : ℕ) : ℤ) ∈ Ideal.under ℤ P := by
        rw [← hgq]
        exact Ideal.mem_span_singleton.mpr (Int.dvd_natAbs.mpr dvd_rfl)
      rw [hqdef, Ideal.mem_comap] at hmem
      simpa using hmem
    have sB : ∀ p : ℕ, Nat.Prime p →
        ∃ t : Finset (Ideal (NumberField.RingOfIntegers K)),
          t.card ≤ Module.finrank ℚ K ∧
          ∀ P : Ideal (NumberField.RingOfIntegers K), P.IsPrime → P ≠ ⊥ →
            (p : NumberField.RingOfIntegers K) ∈ P → P ∈ t := by
      intro p hp
      have hp0 : ((p : ℤ)) ≠ 0 := Int.natCast_ne_zero.mpr hp.ne_zero
      have hpp : Prime ((p : ℤ)) := Nat.prime_iff_prime_int.mp hp
      haveI hPp : (Ideal.span {(p : ℤ)}).IsPrime := (Ideal.span_singleton_prime hp0).mpr hpp
      have hne : Ideal.span {(p : ℤ)} ≠ ⊥ := by
        rw [Ne, Ideal.span_singleton_eq_bot]; exact hp0
      haveI hmax : (Ideal.span {(p : ℤ)}).IsMaximal := hPp.isMaximal hne
      refine ⟨primesOverFinset (Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers K), ?_, ?_⟩
      · have hsum := Ideal.sum_ramification_inertia (NumberField.RingOfIntegers K) ℚ K hne
        rw [Finset.card_eq_sum_ones, ← hsum]
        refine Finset.sum_le_sum ?_
        intro P hPmem
        have hco : P ∈ (Ideal.span {(p : ℤ)}).primesOver (NumberField.RingOfIntegers K) := by
          rw [← coe_primesOverFinset hne (NumberField.RingOfIntegers K)]
          exact Finset.mem_coe.mpr hPmem
        rw [Ideal.primesOver.eq_def, Set.mem_setOf_eq] at hco
        obtain ⟨hPprime, hPlo⟩ := hco
        haveI := hPprime
        haveI := hPlo
        have hf : 0 < (Ideal.span {(p : ℤ)}).inertiaDeg P := Ideal.inertiaDeg_pos _ P
        have hmapne : Ideal.map (algebraMap ℤ (NumberField.RingOfIntegers K))
            (Ideal.span {(p : ℤ)}) ≠ ⊥ := by
          rw [Ideal.map_span, Set.image_singleton, Ne, Ideal.span_singleton_eq_bot]
          have hc : ((p : ℕ) : NumberField.RingOfIntegers K) ≠ 0 :=
