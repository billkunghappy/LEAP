  have hdist : ∀ t : ℝ, 0 ≤ t → dist (((β + t : ℝ)) : ℂ) (β : ℂ) = t := by
    intro t ht
    rw [Complex.dist_eq, Complex.ofReal_add, add_sub_cancel_left, Complex.norm_real,
      Real.norm_of_nonneg ht]
  
  have hnz : ¬ ∀ᶠ z in nhds (β : ℂ), G z = 0 := by
    intro h
    obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 h
    have ht : 0 < min ε δ / 2 := by positivity
    have h1 : min ε δ / 2 < ε := by have := min_le_left ε δ; linarith
    have h2 : min ε δ / 2 < δ := by have := min_le_right ε δ; linarith
    exact (hloc (β + min ε δ / 2) (by linarith) (by linarith)).1
