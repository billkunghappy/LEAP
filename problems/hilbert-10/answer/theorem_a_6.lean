            (∑' J : {J : Ideal (NumberField.RingOfIntegers K) //
                J ∣ (⊤ : Ideal (NumberField.RingOfIntegers K))},
              mu ((J : Ideal (NumberField.RingOfIntegers K))))) /
          ((Ideal.absNorm (⊤ : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) = 1
      rw [hmutop, mul_one, hNtop, Nat.cast_one, Complex.one_cpow, div_one,
        ← Ideal.one_eq_top]
      exact h1
  intro h0
  rw [h0, zero_mul] at hLM
  exact zero_ne_one hLM

theorem kai_ld_series_deriv (K : Type u) [Field K] [NumberField K]
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hbd : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1)
    (hzeta : ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)))
    (s : ℂ) (hs : 1 < s.re) :
    DifferentiableAt ℂ (kaiHeckeSeries K lam) s ∧
      deriv (kaiHeckeSeries K lam) s
        = - ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
            lam (I : Ideal (NumberField.RingOfIntegers K)) *
              ((Real.log (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) :=
by
  classical
  have key : ∀ m : ℕ, 0 < m → ∀ a z : ℂ,
      HasDerivAt (fun w : ℂ => a / ((m : ℂ) ^ w))
        (-(a * ((Real.log m : ℝ) : ℂ) * ((m : ℂ) ^ (-z)))) z := by
    intro m hm a z
    have hc : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    have h1 : HasDerivAt (fun w : ℂ => -w) (-1) z := hasDerivAt_neg z
    have h2 := h1.const_cpow (Or.inl hc)
    have h3 := h2.const_mul a
    have hfun : (fun w : ℂ => a / ((m : ℂ) ^ w)) = (fun w : ℂ => a * ((m : ℂ) ^ (-w))) := by
      funext w
      rw [Complex.cpow_neg, div_eq_mul_inv]
    have hval : a * ((m : ℂ) ^ (-z) * Complex.log (m : ℂ) * (-1))
        = -(a * ((Real.log m : ℝ) : ℂ) * ((m : ℂ) ^ (-z))) := by
      rw [Complex.natCast_log]
      ring
    rw [hfun, ← hval]
    exact h3
  have maj : ∀ m : ℕ, 0 < m → ∀ a : ℂ, ‖a‖ ≤ 1 → ∀ (t : ℝ) (w : ℂ), t ≤ w.re →
      ‖a / ((m : ℂ) ^ w)‖ ≤ (m : ℝ) ^ (-t) := by
    intro m hm a ha t w hw
    have hm1 : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
    have hm0 : (0 : ℝ) ≤ (m : ℝ) := by linarith only [hm1]
    rw [norm_div, Complex.norm_natCast_cpow_of_pos hm, div_eq_mul_inv, ← Real.rpow_neg hm0]
    calc ‖a‖ * ((m : ℝ) ^ (-w.re)) ≤ (m : ℝ) ^ (-w.re) :=
          mul_le_of_le_one_left (Real.rpow_nonneg hm0 _) ha
      _ ≤ (m : ℝ) ^ (-t) := Real.rpow_le_rpow_of_exponent_le hm1 (neg_le_neg hw)
  obtain ⟨σ₀, hσ₀def⟩ : ∃ x : ℝ, x = (1 + s.re) / 2 := ⟨_, rfl⟩
  have hσ₀1 : 1 < σ₀ := by rw [hσ₀def]; linarith only [hs]
  have hσ₀s : σ₀ < s.re := by rw [hσ₀def]; linarith only [hs]
  have hN : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      0 < Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) := by
    intro I
    have hb : (I : Ideal (NumberField.RingOfIntegers K)) ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot]
      exact I.2
    have hne : Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]
      exact hb
    omega
  have hU : IsOpen {w : ℂ | σ₀ < w.re} :=
    isOpen_lt continuous_const Complex.continuous_re
  have hsU : s ∈ {w : ℂ | σ₀ < w.re} := hσ₀s
  have hdiffOnF : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      DifferentiableOn ℂ
        (fun w : ℂ => lam (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ w))
        {w : ℂ | σ₀ < w.re} :=
    fun I => Differentiable.differentiableOn
      (fun w =>
        (key _ (hN I) (lam (I : Ideal (NumberField.RingOfIntegers K))) w).differentiableAt)
  have hbdF : ∀ I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ∀ w ∈ {w : ℂ | σ₀ < w.re},
      ‖lam (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ w)‖
        ≤ ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ₀) :=
    fun I w hw =>
      maj _ (hN I) _ (hbd (I : Ideal (NumberField.RingOfIntegers K))) σ₀ w (le_of_lt hw)
  have hdiffOn : DifferentiableOn ℂ (kaiHeckeSeries K lam) {w : ℂ | σ₀ < w.re} :=
    Complex.differentiableOn_tsum_of_summable_norm (hzeta σ₀ hσ₀1) hdiffOnF hU hbdF
  refine ⟨hdiffOn.differentiableAt (hU.mem_nhds hsU), ?_⟩
  have hHS : HasSum
      (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        deriv (fun w : ℂ => lam (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ w)) s)
      (deriv (kaiHeckeSeries K lam) s) :=
    Complex.hasSum_deriv_of_summable_norm (hzeta σ₀ hσ₀1) hdiffOnF hU hbdF hsU
  have hterm : (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        deriv (fun w : ℂ => lam (I : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ w)) s)
      = (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        -(lam (I : Ideal (NumberField.RingOfIntegers K)) *
            ((Real.log (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)))) := by
    funext I
    exact (key _ (hN I) (lam (I : Ideal (NumberField.RingOfIntegers K))) s).deriv
  rw [hterm] at hHS
  have h4 := hHS.tsum_eq
  rw [tsum_neg] at h4
  exact h4.symm

theorem kai_ld_logsum_mul (K : Type u) [Field K] [NumberField K]
    (lam : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hmul : ∀ I J : Ideal (NumberField.RingOfIntegers K), lam (I * J) = lam I * lam J)
    (hbd : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1)
    (hzeta : ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)))
    (Λ : Ideal (NumberField.RingOfIntegers K) → ℝ)
    (hΛ0 : ∀ I : Ideal (NumberField.RingOfIntegers K), 0 ≤ Λ I)
    (hΛle : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      Λ I ≤ Real.log (Ideal.absNorm I))
    (hΛdiv : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      ∀ D : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ J : Ideal (NumberField.RingOfIntegers K), J ∈ D ↔ J ∣ I) →
        ∑ J ∈ D, Λ J = Real.log (Ideal.absNorm I))
    (s : ℂ) (hs : 1 < s.re) :
    kaiHeckeSeries K lam s *
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ((Λ (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
      = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
            ((Real.log (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) :=
by
  have hNnat : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → 0 < Ideal.absNorm I := by
    intro I hI
    have hb : I ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hne : Ideal.absNorm I ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]
      exact hb
    omega
  have hNpos : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      (1 : ℝ) ≤ (Ideal.absNorm I : ℝ) := by
    intro I hI
    have h : (1 : ℕ) ≤ Ideal.absNorm I := hNnat I hI
    exact_mod_cast h
  have hFib : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      ∀ D : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ J : Ideal (NumberField.RingOfIntegers K), J ∈ D ↔ J ∣ I) →
        ∀ gg : Ideal (NumberField.RingOfIntegers K) → ℂ,
          (∑' p : {x : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                      {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
                    ((x.1 : Ideal (NumberField.RingOfIntegers K)) *
                      (x.2 : Ideal (NumberField.RingOfIntegers K)) = I)},
              gg ((p.1.2 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
                  Ideal (NumberField.RingOfIntegers K)))
            = ∑ J ∈ D, gg J := by
    classical
    intro I hI D hD gg
    have hmem : ∀ p : {x : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                  {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
                ((x.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (x.2 : Ideal (NumberField.RingOfIntegers K)) = I)},
        ((p.1.2 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
          Ideal (NumberField.RingOfIntegers K)) ∈ D := by
      intro p
      refine (hD _).mpr ⟨(p.1.1 : Ideal (NumberField.RingOfIntegers K)), ?_⟩
      exact p.2.symm.trans (mul_comm _ _)
    have hbij : Function.Bijective
        (fun p : {x : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} ×
                    {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0} //
                  ((x.1 : Ideal (NumberField.RingOfIntegers K)) *
                    (x.2 : Ideal (NumberField.RingOfIntegers K)) = I)} =>
          (⟨((p.1.2 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
              Ideal (NumberField.RingOfIntegers K)), hmem p⟩ :
            {J : Ideal (NumberField.RingOfIntegers K) // J ∈ D})) := by
      constructor
      · intro p q h
        have h2 : ((p.1.2 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K))
            = ((q.1.2 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) := by
          exact congrArg (fun z : {J : Ideal (NumberField.RingOfIntegers K) // J ∈ D} =>
            (z : Ideal (NumberField.RingOfIntegers K))) h
        have hMne : ((p.1.2 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) ≠ 0 := p.1.2.2
        have h1 : ((p.1.1 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K))
            = ((q.1.1 : {J : Ideal (NumberField.RingOfIntegers K) // J ≠ 0}) :
            Ideal (NumberField.RingOfIntegers K)) := by
          refine mul_right_cancel₀ hMne ?_
          rw [p.2, h2, q.2]
        exact Subtype.ext (Prod.ext (Subtype.ext h1) (Subtype.ext h2))
      · rintro ⟨J, hJD⟩
        obtain ⟨J', hJ'⟩ := (hD J).mp hJD
        have hJ0 : J ≠ 0 := by
          intro h; apply hI; rw [hJ', h, zero_mul]
        have hJ'0 : J' ≠ 0 := by
          intro h; apply hI; rw [hJ', h, mul_zero]
        refine ⟨⟨(⟨J', hJ'0⟩, ⟨J, hJ0⟩), ?_⟩, ?_⟩
        · show J' * J = I
          rw [hJ']; ring
        · rfl
    rw [← Finset.tsum_subtype D gg]
    exact Equiv.tsum_eq (Equiv.ofBijective _ hbij)
      (fun J : {J : Ideal (NumberField.RingOfIntegers K) // J ∈ D} =>
        gg (J : Ideal (NumberField.RingOfIntegers K)))
  have hlogrpow : ∀ y τ : ℝ, 1 ≤ y → 0 < τ → Real.log y ≤ y ^ τ / τ := by
    intro y τ hy hτ
    have hy0 : (0 : ℝ) < y := by linarith only [hy]
    have hstep : Real.log (y ^ τ) ≤ y ^ τ - 1 :=
      Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hy0 τ)
    rw [Real.log_rpow hy0] at hstep
    rw [le_div_iff₀ hτ]
    linarith only [hstep]
  obtain ⟨f, hf⟩ : ∃ f : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} → ℂ,
      ∀ J : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        f J = lam (J : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) :=
    ⟨fun J => lam (J : Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s), fun _ => rfl⟩
  obtain ⟨g, hg⟩ : ∃ g : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} → ℂ,
      ∀ M : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
        g M = ((Λ (M : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
          lam (M : Ideal (NumberField.RingOfIntegers K)) /
          ((Ideal.absNorm (M : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s) :=
    ⟨fun M => ((Λ (M : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
        lam (M : Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm (M : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s), fun _ => rfl⟩
  have hnf : Summable (fun J : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      ‖f J‖) := by
    refine Summable.of_nonneg_of_le (fun J => norm_nonneg _) ?_ (hzeta s.re hs)
    intro J
    have hIpos : 0 < Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers K)) := hNnat _ J.2
    have hI1 : (1 : ℝ) ≤ (Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers K)) : ℝ) :=
      hNpos _ J.2
    have hI0 : (0 : ℝ) ≤ (Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers K)) : ℝ) := by
      linarith only [hI1]
    rw [hf J, norm_div, Complex.norm_natCast_cpow_of_pos hIpos, Real.rpow_neg hI0,
      div_eq_mul_inv]
    exact mul_le_of_le_one_left (inv_nonneg.mpr (Real.rpow_nonneg hI0 _))
      (hbd (J : Ideal (NumberField.RingOfIntegers K)))
  have hng : Summable (fun M : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
      ‖g M‖) := by
    obtain ⟨τ, hτdef⟩ : ∃ x : ℝ, x = (s.re - 1) / 2 := ⟨_, rfl⟩
    have hτ0 : 0 < τ := by rw [hτdef]; linarith only [hs]
    have hρ : 1 < s.re - τ := by rw [hτdef]; linarith only [hs]
    have hmaj : Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        1 / τ * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^
          (-(s.re - τ))) := (hzeta (s.re - τ) hρ).mul_left (1 / τ)
    refine Summable.of_nonneg_of_le (fun M => norm_nonneg _) ?_ hmaj
    intro I
    have hIpos : 0 < Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) := hNnat _ I.2
    have hI1 : (1 : ℝ) ≤ (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) :=
      hNpos _ I.2
    have hN0 : (0 : ℝ) < (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) := by
      linarith only [hI1]
    have hL0 : 0 ≤ Λ (I : Ideal (NumberField.RingOfIntegers K)) := hΛ0 _
    rw [hg I, norm_div, norm_mul, Complex.norm_natCast_cpow_of_pos hIpos,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hL0, div_eq_mul_inv,
      ← Real.rpow_neg hN0.le]
    have hrw : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-(s.re - τ))
        = ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ *
          ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-s.re) := by
      rw [← Real.rpow_add hN0]
      congr 1
      ring
    rw [hrw]
    have hpow0 : (0 : ℝ) <
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-s.re) :=
      Real.rpow_pos_of_pos hN0 _
    have ha : Λ (I : Ideal (NumberField.RingOfIntegers K)) *
        ‖lam (I : Ideal (NumberField.RingOfIntegers K))‖
        ≤ Λ (I : Ideal (NumberField.RingOfIntegers K)) := by
      have hstep := mul_le_mul_of_nonneg_left
        (hbd (I : Ideal (NumberField.RingOfIntegers K))) hL0
      rwa [mul_one] at hstep
    have hb2 : Λ (I : Ideal (NumberField.RingOfIntegers K))
        ≤ ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ / τ :=
      le_trans (hΛle _ I.2) (hlogrpow _ τ hI1 hτ0)
    have hkey : Λ (I : Ideal (NumberField.RingOfIntegers K)) *
        ‖lam (I : Ideal (NumberField.RingOfIntegers K))‖
        ≤ 1 / τ * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ := by
      have heq : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ / τ
          = 1 / τ *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ := by ring
      linarith only [ha, hb2, heq]
    have hfin := mul_le_mul_of_nonneg_right hkey hpow0.le
    linarith only [hfin]
  have hdivfin : ∀ I0 : Ideal (NumberField.RingOfIntegers K), I0 ≠ 0 →
      {J : Ideal (NumberField.RingOfIntegers K) | J ∣ I0}.Finite := by
    intro I0 hI0
    refine Set.Finite.subset (Ideal.finite_setOf_absNorm_le (Ideal.absNorm I0)) ?_
    rintro J hJ
    exact Nat.le_of_dvd (hNnat I0 hI0) (map_dvd Ideal.absNorm hJ)
  have hmulne : ∀ J M : Ideal (NumberField.RingOfIntegers K), J ≠ 0 → M ≠ 0 → J * M ≠ 0 := by
    intro J M hJ hM h
    rw [Submodule.zero_eq_bot] at h
    rcases Ideal.mul_eq_bot.mp h with h1 | h1
    · exact hJ (h1.trans Submodule.zero_eq_bot.symm)
    · exact hM (h1.trans Submodule.zero_eq_bot.symm)
  obtain ⟨m, hm⟩ : ∃ m : ({I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
        {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) →
        {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      ∀ p, (m p : Ideal (NumberField.RingOfIntegers K))
        = (p.1 : Ideal (NumberField.RingOfIntegers K)) *
          (p.2 : Ideal (NumberField.RingOfIntegers K)) :=
    ⟨fun p => ⟨(p.1 : Ideal (NumberField.RingOfIntegers K)) *
        (p.2 : Ideal (NumberField.RingOfIntegers K)), hmulne _ _ p.1.2 p.2.2⟩, fun _ => rfl⟩
  have hHS : kaiHeckeSeries K lam s
      = ∑' J : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}, f J := by
    unfold kaiHeckeSeries
    exact tsum_congr (fun J => (hf J).symm)
  have hHLS : (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ((Λ (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
            lam (I : Ideal (NumberField.RingOfIntegers K)) /
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s))
      = ∑' M : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}, g M :=
    tsum_congr (fun M => (hg M).symm)
  have hFsum : Summable (fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
      {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} => f z.1 * g z.2) :=
    summable_mul_of_summable_norm hnf hng
  have hEt : (∑' q : (I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}) ×
          {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // m p = I},
        f q.2.1.1 * g q.2.1.2)
      = ∑' z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
            {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}, f z.1 * g z.2 :=
    Equiv.tsum_eq (Equiv.sigmaFiberEquiv m)
      (fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
          {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} => f z.1 * g z.2)
  have hFsig : Summable ((fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
      {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} => f z.1 * g z.2)
      ∘ (Equiv.sigmaFiberEquiv m)) :=
    (Equiv.summable_iff (Equiv.sigmaFiberEquiv m)).mpr hFsum
  have hsigma : (∑' z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
        {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0}, f z.1 * g z.2)
      = ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
          ∑' c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                    {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // m p = I},
            f c.1.1 * g c.1.2 := by
    rw [← hEt]
    exact hFsig.tsum_sigma
  rw [hHS, hHLS, tsum_mul_tsum_of_summable_norm hnf hng, hsigma]
  refine tsum_congr ?_
  intro I
  obtain ⟨D, hD⟩ : ∃ D : Finset (Ideal (NumberField.RingOfIntegers K)),
      ∀ J : Ideal (NumberField.RingOfIntegers K),
        J ∈ D ↔ J ∣ (I : Ideal (NumberField.RingOfIntegers K)) :=
    ⟨(hdivfin (I : Ideal (NumberField.RingOfIntegers K)) I.2).toFinset,
      fun J => Set.Finite.mem_toFinset _⟩
  have hbridge : ∀ p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
        {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
      (m p = I) ↔ ((p.1 : Ideal (NumberField.RingOfIntegers K)) *
        (p.2 : Ideal (NumberField.RingOfIntegers K))
          = (I : Ideal (NumberField.RingOfIntegers K))) := by
    intro p
    constructor
    · intro h
      rw [← hm p]
      exact congrArg (fun z : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        (z : Ideal (NumberField.RingOfIntegers K))) h
    · intro h
      exact Subtype.ext ((hm p).trans h)
  have hstep2 : (∑' c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
            {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} // m p = I},
          f c.1.1 * g c.1.2)
      = ∑' c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                  {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
                (p.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (p.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
          f c.1.1 * g c.1.2 :=
    Equiv.tsum_eq (Equiv.subtypeEquivRight hbridge)
      (fun c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                  {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
                (p.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (p.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))} =>
        f c.1.1 * g c.1.2)
  have hcast : ∀ n : ℕ, ((n : ℂ)) = (((n : ℝ)) : ℂ) := fun n => (Complex.ofReal_natCast n).symm
  have hcol : ∀ c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                  {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
                (p.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (p.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
      f c.1.1 * g c.1.2
        = lam (I : Ideal (NumberField.RingOfIntegers K)) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) *
            ((Λ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) := by
    intro c
    have hc : (c.1.1 : Ideal (NumberField.RingOfIntegers K)) *
        (c.1.2 : Ideal (NumberField.RingOfIntegers K))
        = (I : Ideal (NumberField.RingOfIntegers K)) := c.2
    have hlamI : lam (c.1.1 : Ideal (NumberField.RingOfIntegers K)) *
        lam (c.1.2 : Ideal (NumberField.RingOfIntegers K))
        = lam (I : Ideal (NumberField.RingOfIntegers K)) := by
      rw [← hmul, hc]
    have hNI : Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) *
        Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K))
        = Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) := by
      rw [← map_mul Ideal.absNorm, hc]
    have hNIR : ((Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℝ)) *
        ((Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℝ))
        = ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) := by
      exact_mod_cast hNI
    have hcpow : ((Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^ (-s) *
        ((Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^ (-s)
        = ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ)) ^ (-s) := by
      rw [hcast (Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K))),
        hcast (Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K))),
        hcast (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))),
        ← Complex.mul_cpow_ofReal_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _),
        ← Complex.ofReal_mul, hNIR]
    have hdivA : lam (c.1.1 : Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)
        = lam (c.1.1 : Ideal (NumberField.RingOfIntegers K)) *
          ((Ideal.absNorm (c.1.1 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) := by
      rw [Complex.cpow_neg, div_eq_mul_inv]
    have hdivB : ((Λ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
        lam (c.1.2 : Ideal (NumberField.RingOfIntegers K)) /
        ((Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ s)
        = ((Λ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
          lam (c.1.2 : Ideal (NumberField.RingOfIntegers K)) *
          ((Ideal.absNorm (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) := by
      rw [Complex.cpow_neg, div_eq_mul_inv]
    rw [hf, hg, hdivA, hdivB, ← hlamI, ← hcpow]
    ring
  have hcong : (∑' c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                  {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
                (p.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (p.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
          f c.1.1 * g c.1.2)
      = ∑' c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                  {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
                (p.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (p.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
          lam (I : Ideal (NumberField.RingOfIntegers K)) *
              ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (-s)) *
            ((Λ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) :=
    tsum_congr hcol
  have hfib : (∑' c : {p : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
                  {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} //
                (p.1 : Ideal (NumberField.RingOfIntegers K)) *
                  (p.2 : Ideal (NumberField.RingOfIntegers K))
                    = (I : Ideal (NumberField.RingOfIntegers K))},
          ((Λ (c.1.2 : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ))
      = ∑ J ∈ D, ((Λ J : ℝ) : ℂ) :=
    hFib (I : Ideal (NumberField.RingOfIntegers K)) I.2 D hD
      (fun J => ((Λ J : ℝ) : ℂ))
  rw [hstep2, hcong, tsum_mul_left, hfib, ← Complex.ofReal_sum,
    hΛdiv (I : Ideal (NumberField.RingOfIntegers K)) I.2 D hD]
  ring

theorem kai_hecke_logderiv_00 (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ Λ : Ideal (NumberField.RingOfIntegers K) → ℝ,
      (∀ I : Ideal (NumberField.RingOfIntegers K), 0 ≤ Λ I) ∧
      (∀ σ : ℝ, 1 < σ → σ ≤ 2 →
        Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
          Λ (I : Ideal (NumberField.RingOfIntegers K)) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)))) ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam : Ideal (NumberField.RingOfIntegers K) → ℂ),
        KaiHeckeExt K q 0 0 ξ η lam →
        ∀ (E : ℕ) (G : ℂ → ℂ), Differentiable ℂ G →
          (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam s * (s - 1) ^ E = G s) →
          ∀ σ : ℝ, 1 < σ →
            G (σ : ℂ) ≠ 0 ∧
            (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0},
                ((Λ (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
                  lam (I : Ideal (NumberField.RingOfIntegers K)) /
                  ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℂ) ^ (σ : ℂ)))
              = -(deriv G (σ : ℂ) / G (σ : ℂ)) + (E : ℂ) / ((σ : ℂ) - 1) :=
by
  classical
  have hzeta := kai_ld_zeta_summable K
  obtain ⟨Λ, hΛ0, hΛle, hΛdiv⟩ := kai_ld_vonMangoldt_exists K
  refine ⟨Λ, hΛ0, ?_, ?_⟩
  · intro σ hσ _
    obtain ⟨τ, hτ⟩ : ∃ τ : ℝ, τ = (σ - 1) / 2 := ⟨_, rfl⟩
    have hτpos : 0 < τ := by rw [hτ]; linarith
    have hστ : 1 < σ - τ := by rw [hτ]; linarith
    refine Summable.of_nonneg_of_le (fun I => ?_) (fun I => ?_)
      ((hzeta (σ - τ) hστ).mul_left (1 / τ))
    · exact mul_nonneg (hΛ0 _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)
    · have hI := I.2
      have hN0 : Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
        rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hI
      have hN1 : (1 : ℝ) ≤ (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) := by
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr hN0
      have hNpos : (0 : ℝ) < (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) := by
        linarith
      have hlog := Real.log_le_rpow_div
        (x := (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ))
        (Nat.cast_nonneg _) hτpos
      have hrp : 0 ≤ ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ) :=
        Real.rpow_nonneg (Nat.cast_nonneg _) _
      have hsplit : ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-(σ - τ))
          = ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ) := by
        rw [← Real.rpow_add hNpos]; congr 1; ring
      calc Λ (I : Ideal (NumberField.RingOfIntegers K)) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)
          ≤ Real.log (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K))) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ) :=
            mul_le_mul_of_nonneg_right (hΛle _ hI) hrp
        _ ≤ (((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ τ / τ) *
            ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ) :=
            mul_le_mul_of_nonneg_right hlog hrp
        _ = 1 / τ * ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-(σ - τ)) := by
            rw [hsplit]; ring
  · intro q _ ξ η lam hext E G _ hGeq σ hσ
    have h1 : lam 1 = 1 := hext.1
    have hmul := hext.2.1
    have hbd : ∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1 := by
      intro I
      by_cases hIq : I ⊔ q = ⊤
      · by_cases hI0 : I = 0
        · rw [hI0, hext.2.2.2.2.1, norm_zero]; exact zero_le_one
        · rw [hext.2.2.1 I hI0 hIq]
      · rw [hext.2.2.2.1 I hIq, norm_zero]; exact zero_le_one
    have hs : 1 < (σ : ℂ).re := by rw [Complex.ofReal_re]; exact hσ
    have hs1 : (σ : ℂ) - 1 ≠ 0 := by
      intro h
      have h' := congrArg Complex.re h
      rw [Complex.sub_re, Complex.one_re, Complex.zero_re, Complex.ofReal_re] at h'
      linarith
    have hL0 : kaiHeckeSeries K lam (σ : ℂ) ≠ 0 :=
      kai_ld_series_ne_zero K lam h1 hmul hbd hzeta (σ : ℂ) hs
    have hGs : G (σ : ℂ) = kaiHeckeSeries K lam (σ : ℂ) * ((σ : ℂ) - 1) ^ E :=
      (hGeq (σ : ℂ) hs).symm
    have hGne : G (σ : ℂ) ≠ 0 := by
      rw [hGs]; exact mul_ne_zero hL0 (pow_ne_zero _ hs1)
    refine ⟨hGne, ?_⟩
    obtain ⟨hLd, hLderiv⟩ := kai_ld_series_deriv K lam hbd hzeta (σ : ℂ) hs
    have hprod := kai_ld_logsum_mul K lam hmul hbd hzeta Λ hΛ0 hΛle hΛdiv (σ : ℂ) hs
    rw [← hprod] at hLderiv
    have hopen : IsOpen {z : ℂ | 1 < z.re} := isOpen_lt continuous_const Complex.continuous_re
    have hev : (fun z => kaiHeckeSeries K lam z * (z - 1) ^ E) =ᶠ[nhds (σ : ℂ)] G := by
      filter_upwards [hopen.mem_nhds hs] with z hz
      exact hGeq z hz
    have hlin : HasDerivAt (fun z : ℂ => z - 1) 1 (σ : ℂ) := (hasDerivAt_id (σ : ℂ)).sub_const 1
    have hderE := hLd.hasDerivAt.mul (hlin.pow E)
    have hdG : deriv G (σ : ℂ)
        = deriv (kaiHeckeSeries K lam) (σ : ℂ) * ((σ : ℂ) - 1) ^ E
          + kaiHeckeSeries K lam (σ : ℂ) * ((E : ℂ) * ((σ : ℂ) - 1) ^ (E - 1) * 1) := by
      rw [← hev.deriv_eq]; exact hderE.deriv
    have hkey : kaiHeckeSeries K lam (σ : ℂ) * ((E : ℂ) * ((σ : ℂ) - 1) ^ (E - 1) * 1)
        = kaiHeckeSeries K lam (σ : ℂ) * ((σ : ℂ) - 1) ^ E * ((E : ℂ) / ((σ : ℂ) - 1)) := by
      rcases E with _ | k
      · simp
      · rw [Nat.add_sub_cancel, pow_succ]
        field_simp
    rw [hdG, hkey, hLderiv, hGs]
    field_simp
    ring

theorem kai_page_uniqueness (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ B_P : ℝ, 0 < B_P ∧
      ∀ Q : ℝ, 3 ≤ Q →
      ∀ (q₁ q₂ : Ideal (NumberField.RingOfIntegers K))
        (ξ₁ : ((NumberField.RingOfIntegers K ⧸ q₁)ˣ) →* Circle)
        (η₁ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam₁ : Ideal (NumberField.RingOfIntegers K) → ℂ)
        (ξ₂ : ((NumberField.RingOfIntegers K ⧸ q₂)ˣ) →* Circle)
        (η₂ : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
        (lam₂ : Ideal (NumberField.RingOfIntegers K) → ℂ)
        (G₁ G₂ : ℂ → ℂ) (β₁ β₂ : ℝ),
        q₁ ≠ 0 → q₂ ≠ 0 →
        (Ideal.absNorm q₁ : ℝ) ≤ Q → (Ideal.absNorm q₂ : ℝ) ≤ Q →
        KaiHeckeExt K q₁ 0 0 ξ₁ η₁ lam₁ → KaiHeckeExt K q₂ 0 0 ξ₂ η₂ lam₂ →
        (∀ I : Ideal (NumberField.RingOfIntegers K), lam₁ I = (starRingEnd ℂ) (lam₁ I)) →
        (∀ I : Ideal (NumberField.RingOfIntegers K), lam₂ I = (starRingEnd ℂ) (lam₂ I)) →
        ¬ KaiHeckePrincipal K q₁ lam₁ → ¬ KaiHeckePrincipal K q₂ lam₂ →
        Differentiable ℂ G₁ → Differentiable ℂ G₂ →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam₁ s = G₁ s) →
        (∀ s : ℂ, 1 < s.re → kaiHeckeSeries K lam₂ s = G₂ s) →
        1 - B_P / Real.log Q ≤ β₁ → β₁ < 1 → 1 - B_P / Real.log Q ≤ β₂ → β₂ < 1 →
        G₁ (β₁ : ℂ) = 0 → G₂ (β₂ : ℂ) = 0 →
        KaiHeckePrincipal K (q₁ * q₂) (fun I => lam₁ I * lam₂ I) ∧ β₁ = β₂ :=
by
  classical
  obtain ⟨A₀, -, hcont⟩ := kai_hecke_zeta_continuation K
  obtain ⟨B, C, hB, -, hC, hZF⟩ := kai_hecke_zero_free_real_00 K
  obtain ⟨Λ, hΛ, hΛsum, hLD⟩ := kai_hecke_logderiv_00 K
  obtain ⟨lam₀, h0one, hext₀, hprin₀⟩ : ∃ lam₀ : Ideal (NumberField.RingOfIntegers K) → ℂ,
      (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → lam₀ I = 1) ∧
      KaiHeckeExt K ⊤ 0 0 1 (fun _ => false) lam₀ ∧
      KaiHeckePrincipal K ⊤ lam₀ := by
    refine ⟨fun I => if I = 0 then 0 else 1, fun I hI => if_neg hI,
      ⟨?_, ?_, ?_, ?_, ?_, ?_⟩, fun I hI _ => if_neg hI⟩
    · have h1 : (1 : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
        rw [Ideal.one_eq_top, Ideal.zero_eq_bot]
        exact top_ne_bot
      simp only [if_neg h1]
    · intro I J
      by_cases hI : I = 0
      · simp [hI]
      · by_cases hJ : J = 0
        · simp [hJ]
        · have hIJ : I * J ≠ 0 := fun h => (Ideal.mul_eq_bot.mp h).elim hI hJ
          simp only [if_neg hI, if_neg hJ, if_neg hIJ, mul_one]
    · intro I hI _
      show ‖(if I = 0 then (0 : ℂ) else 1)‖ = 1
      rw [if_neg hI, norm_one]
    · intro I hI
      exact absurd (sup_top_eq _) hI
    · simp
    · intro α hα
      have hspan : Ideal.span {α} ≠ 0 := by
        rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]
        exact hα
      have hu : IsUnit (Ideal.Quotient.mk (⊤ : Ideal (NumberField.RingOfIntegers K)) α) := by
        haveI : Subsingleton (NumberField.RingOfIntegers K ⧸
            (⊤ : Ideal (NumberField.RingOfIntegers K))) :=
          Ideal.Quotient.subsingleton_iff.mpr rfl
        exact isUnit_of_subsingleton _
      simp only [if_neg hspan]
      unfold kaiHeckeTwist
      rw [dif_pos hu]
      simp
  
  obtain ⟨κ, hκ_def⟩ : ∃ κ : ℝ, κ = 40 * C + 1 := ⟨_, rfl⟩
  have hκpos : 0 < κ := by rw [hκ_def]; linarith
  have hκ1 : 1 ≤ κ := by rw [hκ_def]; linarith
  obtain ⟨BP, hBP_def⟩ : ∃ BP : ℝ, BP = min (B / 3) (1 / (4 * κ)) := ⟨_, rfl⟩
  have hBPpos : 0 < BP := by rw [hBP_def]; exact lt_min (by positivity) (by positivity)
  have hBP3 : BP ≤ B / 3 := by rw [hBP_def]; exact min_le_left _ _
  have hBPk : BP ≤ 1 / (4 * κ) := by rw [hBP_def]; exact min_le_right _ _
  have hκBP : κ * BP ≤ 1 / 4 := by
    have h := mul_le_mul_of_nonneg_left hBPk hκpos.le
    have h' : κ * (1 / (4 * κ)) = 1 / 4 := by field_simp
    linarith
  refine ⟨BP, hBPpos, ?_⟩
  intro Q hQ q₁ q₂ ξ₁ η₁ lam₁ ξ₂ η₂ lam₂ G₁ G₂ β₁ β₂ hq₁ hq₂ hN₁ hN₂ hext₁ hext₂ hreal₁ hreal₂
    hnp₁ hnp₂ hG₁ hG₂ heq₁ heq₂ hβ₁l hβ₁u hβ₂l hβ₂u hz₁ hz₂
  
  obtain ⟨L, hL_def⟩ : ∃ L : ℝ, L = Real.log Q := ⟨_, rfl⟩
  rw [← hL_def] at hβ₁l hβ₂l
  have hQpos : 0 < Q := by linarith
  have hL1 : 1 < L := by
    rw [hL_def, Real.lt_log_iff_exp_lt hQpos]
    have := Real.exp_one_lt_d9
    linarith
  have hLpos : 0 < L := by linarith
  have hCL : 0 < C * L := mul_pos hC hLpos
  have hlogk : ∀ x : ℝ, 0 ≤ x → ∀ k : ℕ, 3 + 4 * x ≤ Q ^ k →
      Real.log (3 + 4 * x) ≤ (k : ℝ) * L := by
