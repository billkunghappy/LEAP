        ≤ M ^ Module.finrank ℚ K * Real.exp (-(t ^ c₃)) := by
      rw [← Real.exp_nat_mul, hMr, hMn, ← Real.exp_add, ← Real.exp_add]
      apply Real.exp_le_exp.2
      push_cast
      linarith
    calc C₄ * X ^ Module.finrank ℚ K * Real.exp (-(Real.log X ^ c₄))
          + C₆ * ρ * Real.exp u ^ 4 * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 24)
        ≤ C₄ * (KX ^ Module.finrank ℚ K * M ^ Module.finrank ℚ K) * Real.exp (-(t ^ c₃))
          + C₆ * ρ * (M ^ Module.finrank ℚ K * Real.exp (-(t ^ c₃))) := by
          apply add_le_add
          · exact mul_le_mul (mul_le_mul_of_nonneg_left h1 hC₄) h2 (Real.exp_pos _).le
              (mul_nonneg hC₄ (mul_nonneg (pow_nonneg hKX0 _) (pow_nonneg hMpos.le _)))
          · rw [mul_assoc (C₆ * ρ)]
            exact mul_le_mul_of_nonneg_left h3 (mul_nonneg hC₆ hρ.le)
      _ = _ := by ring
  rw [hFsplit, hGsplit]
  calc _ ≤ |∑ x ∈ G, (if Prime x then 0 else vonMangoldtO x)|
        + |∑ x ∈ G, ((if Prime x then vonMangoldtO x else 0) - qSiegelModel K ρ 𝔮 𝔮D ψD βD x)|
        + |∑ x ∈ Bd, (vonMangoldtO x - qSiegelModel K ρ 𝔮 𝔮D ψD βD x)| := abs_add_three _ _ _
    _ ≤ C₇ * M ^ ((Module.finrank ℚ K : ℝ) - 1 / 4) + (NP : ℝ) * E
        + Kbd * M ^ Module.finrank ℚ K * Real.exp (-(t ^ c₃)) :=
        add_le_add_three (by rw [abs_of_nonneg hNP0]; exact hNP1) hpatsum hBdsum
    _ ≤ C₇ * (M ^ Module.finrank ℚ K * Real.exp (-(t ^ c₃)))
        + (NP : ℝ) * ((C₄ * KX ^ Module.finrank ℚ K + C₆ * ρ)
          * (M ^ Module.finrank ℚ K * Real.exp (-(t ^ c₃))))
        + Kbd * M ^ Module.finrank ℚ K * Real.exp (-(t ^ c₃)) :=
        add_le_add_three (mul_le_mul_of_nonneg_left hI1 hC₇)
          (mul_le_mul_of_nonneg_left hEbound (Nat.cast_nonneg _)) le_rfl
    _ = (C₇ + Kmain + Kbd) * M ^ Module.finrank ℚ K * Real.exp (-(t ^ c₃)) := by
        rw [hKmain]; ring
    _ ≤ _ := hfinal _ (by linarith)

theorem kai_resBox_fiber_count (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (b : NumberField.RingOfIntegers K) (q : ℕ),
      1 ≤ q → ((q : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔞 →
      ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔞)
          (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) q)).card : ℝ)
        * (Ideal.absNorm 𝔞 : ℝ) = (q : ℝ) ^ Module.finrank ℚ K :=
by
  classical
  intro 𝔞 b q hq hqa
  set e := ω.equivFun.symm with he_def
  have hQ : (0 : ℤ) < (q : ℤ) := by exact_mod_cast hq
  have hmem : ∀ z : Fin (Module.finrank ℚ K) → ℤ,
      z ∈ resBox (Module.finrank ℚ K) q ↔ ∀ j, 0 ≤ z j ∧ z j < (q : ℤ) := by
    intro z
    unfold resBox
    simp only [Finset.mem_Icc, Pi.le_def]
    constructor
    · rintro ⟨h1, h2⟩ j
      exact ⟨h1 j, by have := h2 j; omega⟩
    · intro h
      exact ⟨fun j => (h j).1, fun j => by have := (h j).2; omega⟩
  have hred : ∀ z : Fin (Module.finrank ℚ K) → ℤ,
      (fun j => z j % (q : ℤ)) ∈ resBox (Module.finrank ℚ K) q ∧
        e (fun j => z j % (q : ℤ)) - e z ∈ 𝔞 := by
    intro z
    refine ⟨(hmem _).2 fun j => ⟨Int.emod_nonneg _ hQ.ne', Int.emod_lt_of_pos _ hQ⟩, ?_⟩
    have hfun : (fun j => z j % (q : ℤ)) - z = (q : ℤ) • (fun j => -(z j / (q : ℤ))) := by
      funext j
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      have := Int.emod_add_mul_ediv (z j) (q : ℤ)
      linear_combination this
    rw [← map_sub, hfun, map_zsmul, zsmul_eq_mul]
    have hc : ((q : ℤ) : NumberField.RingOfIntegers K) = ((q : ℕ) : NumberField.RingOfIntegers K) :=
      Int.cast_natCast q
    rw [hc]
    exact Ideal.mul_mem_right _ _ hqa
  let F : NumberField.RingOfIntegers K → Finset (Fin (Module.finrank ℚ K) → ℤ) := fun x =>
    @Finset.filter (Fin (Module.finrank ℚ K) → ℤ) (fun z => e z - x ∈ 𝔞)
      (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) q)
  have hle : ∀ x y, (F x).card ≤ (F y).card := by
    intro x y
    set v := ω.equivFun (y - x) with hv
    have hev : e v = y - x := by rw [he_def, hv]; exact ω.equivFun.symm_apply_apply _
    apply Finset.card_le_card_of_injOn (fun z => fun j => (z j + v j) % (q : ℤ))
    · intro z hz
      have hz' : z ∈ F x := hz
      obtain ⟨hzB, hzx⟩ := Finset.mem_filter.1 hz'
      obtain ⟨h1, h2⟩ := hred (z + v)
      show _ ∈ F y
      refine Finset.mem_filter.2 ⟨h1, ?_⟩
      show e (fun j => (z + v) j % (q : ℤ)) - y ∈ 𝔞
      have hid : e (fun j => (z + v) j % (q : ℤ)) - y
          = (e (fun j => (z + v) j % (q : ℤ)) - e (z + v)) + (e z - x) + (e v - (y - x)) := by
        rw [map_add e z v]; ring
      rw [hid, hev, sub_self, add_zero]
      exact 𝔞.add_mem h2 hzx
    · intro z hz z' hz' hzz
      have hzB := (Finset.mem_filter.1 (show z ∈ F x from hz)).1
      have hzB' := (Finset.mem_filter.1 (show z' ∈ F x from hz')).1
      rw [hmem] at hzB hzB'
      funext j
      have h : (z j + v j) % (q : ℤ) = (z' j + v j) % (q : ℤ) := congrFun hzz j
      obtain ⟨a1, a2⟩ := hzB j
      obtain ⟨b1, b2⟩ := hzB' j
      have h3 : z j % (q : ℤ) = z' j % (q : ℤ) := Int.ModEq.add_right_cancel' (v j) h
      rwa [Int.emod_eq_of_lt a1 a2, Int.emod_eq_of_lt b1 b2] at h3
  have hsurj : ∀ c : NumberField.RingOfIntegers K ⧸ 𝔞,
      ∃ z ∈ resBox (Module.finrank ℚ K) q, Ideal.Quotient.mk 𝔞 (e z) = c := by
    intro c
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective c
    obtain ⟨h1, h2⟩ := hred (ω.equivFun x)
    refine ⟨_, h1, ?_⟩
    rw [Ideal.Quotient.eq]
    have h3 : e (ω.equivFun x) = x := by rw [he_def]; exact ω.equivFun.symm_apply_apply x
    rw [h3] at h2
    exact h2
  have hfin : Finite (NumberField.RingOfIntegers K ⧸ 𝔞) := by
    let g : {z // z ∈ resBox (Module.finrank ℚ K) q} → NumberField.RingOfIntegers K ⧸ 𝔞 :=
      fun z => Ideal.Quotient.mk 𝔞 (e z.1)
    refine Finite.of_surjective g ?_
    intro c
    obtain ⟨z, hz, hzc⟩ := hsurj c
    exact ⟨⟨z, hz⟩, hzc⟩
  letI : Fintype (NumberField.RingOfIntegers K ⧸ 𝔞) := Fintype.ofFinite _
  have hcount : (resBox (Module.finrank ℚ K) q).card
      = Fintype.card (NumberField.RingOfIntegers K ⧸ 𝔞) * (F b).card := by
    have h1 := Finset.card_eq_sum_card_fiberwise (s := resBox (Module.finrank ℚ K) q)
      (t := Finset.univ) (f := fun z => Ideal.Quotient.mk 𝔞 (e z))
      (fun z _ => Finset.mem_univ _)
    rw [h1, Finset.sum_congr rfl (g := fun _ => (F b).card) ?_, Finset.sum_const,
      Finset.card_univ, smul_eq_mul]
    intro c _
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective c
    rw [show (F b).card = (F x).card from le_antisymm (hle b x) (hle x b)]
    congr 1
    ext z
    simp only [F, Finset.mem_filter, Ideal.Quotient.eq]
  have hbox : (resBox (Module.finrank ℚ K) q).card = q ^ Module.finrank ℚ K := by
    unfold resBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      sub_add_cancel, sub_zero, Int.toNat_natCast]
  have hnorm : Ideal.absNorm 𝔞 = Fintype.card (NumberField.RingOfIntegers K ⧸ 𝔞) := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
  have key : (F b).card * Ideal.absNorm 𝔞 = q ^ Module.finrank ℚ K := by
    rw [hnorm, ← hbox, hcount, mul_comm]
  have hR : ((F b).card : ℝ) * (Ideal.absNorm 𝔞 : ℝ) = (q : ℝ) ^ Module.finrank ℚ K := by
    exact_mod_cast key
  exact hR

theorem kai_periodic_box_count (d : ℕ) (hd : 1 ≤ d) :
    ∃ C₁ : ℝ, 0 ≤ C₁ ∧ ∀ (q : ℕ), 1 ≤ q → ∀ (G : Set (Fin d → ℤ)),
      (∀ z v : Fin d → ℤ, z + (q : ℤ) • v ∈ G ↔ z ∈ G) →
      (∀ (u : Fin d → ℤ) (L : ℕ) (R : Set (Fin d → ℝ)), MeasurableSet R → Convex ℝ R →
          R ⊆ {x | ∀ j, (u j : ℝ) ≤ x j ∧ x j ≤ (u j : ℝ) + L} →
          |((@Finset.filter (Fin d → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ z ∈ G)
                (fun _ => Classical.propDecidable _)
                (Finset.Icc u (u + fun _ => (L : ℤ)))).card : ℝ)
            - ((@Finset.filter (Fin d → ℤ) (fun z => z ∈ G)
                (fun _ => Classical.propDecidable _) (resBox d q)).card : ℝ) / (q : ℝ) ^ d
              * (MeasureTheory.volume R).toReal|
            ≤ C₁ * (q : ℝ) * ((L : ℝ) + 3 * (q : ℝ)) ^ (d - 1)) ∧
      (∀ q' : ℕ, q ∣ q' → 1 ≤ q' →
          ((@Finset.filter (Fin d → ℤ) (fun z => z ∈ G)
              (fun _ => Classical.propDecidable _) (resBox d q')).card : ℝ) / (q' : ℝ) ^ d
            = ((@Finset.filter (Fin d → ℤ) (fun z => z ∈ G)
              (fun _ => Classical.propDecidable _) (resBox d q)).card : ℝ) / (q : ℝ) ^ d) :=
by
  classical
  obtain ⟨C, hC, hcnt⟩ := convex_lattice_count d hd
  refine ⟨C, hC, ?_⟩
  intro q hq G hG
  have hQ : (0 : ℤ) < (q : ℤ) := by exact_mod_cast hq
  have hqpos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq
  have memRes : ∀ (W : ℕ) (z : Fin d → ℤ),
      z ∈ resBox d W ↔ ∀ k, 0 ≤ z k ∧ z k ≤ (W : ℤ) - 1 := by
    intro W z
    simp only [resBox, Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h k => ⟨h.1 k, h.2 k⟩, fun h => ⟨fun k => (h k).1, fun k => (h k).2⟩⟩
  have memInt : ∀ (M : ℕ) (z : Fin d → ℤ),
      z ∈ intBox d M ↔ ∀ k, -(M : ℤ) ≤ z k ∧ z k ≤ (M : ℤ) := by
    intro M z
    simp only [intBox, Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h k => ⟨h.1 k, h.2 k⟩, fun h => ⟨fun k => (h k).1, fun k => (h k).2⟩⟩
  have hGmod : ∀ z : Fin d → ℤ, z ∈ G ↔ (fun k => z k % (q : ℤ)) ∈ G := by
    intro z
    have e : (fun k => z k % (q : ℤ)) + (q : ℤ) • (fun k => z k / (q : ℤ)) = z := by
      funext k
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      exact Int.emod_add_ediv _ _
    have h := hG (fun k => z k % (q : ℤ)) (fun k => z k / (q : ℤ))
    rw [e] at h
    exact h
  have hmodRes : ∀ z : Fin d → ℤ, (fun k => z k % (q : ℤ)) ∈ resBox d q := by
    intro z
    rw [memRes]
    intro k
    refine ⟨Int.emod_nonneg _ hQ.ne', ?_⟩
    have := Int.emod_lt_of_pos (z k) hQ
    omega
  have hres : ∀ W : ℕ, (resBox d W).card = W ^ d := by
    intro W
    simp [resBox, Pi.card_Icc, Int.card_Icc]
  obtain ⟨Res, hRes⟩ : ∃ Res : Finset (Fin d → ℤ), Res = @Finset.filter (Fin d → ℤ)
      (fun z => z ∈ G) (fun _ => Classical.propDecidable _) (resBox d q) := ⟨_, rfl⟩
  have hResG : ∀ r ∈ Res, r ∈ resBox d q ∧ r ∈ G := by
    intro r hr
    rw [hRes] at hr
    exact Finset.mem_filter.1 hr
  have hcardRes : (Res.card : ℝ) ≤ (q : ℝ) ^ d := by
    have h1 : Res.card ≤ (resBox d q).card := by rw [hRes]; exact Finset.card_filter_le _ _
    rw [hres] at h1
    exact_mod_cast h1
  rw [← hRes]
  refine ⟨?_, ?_⟩
  · intro u L R hRm hRc hRsub
    obtain ⟨V, hV⟩ : ∃ V : ℝ, V = (MeasureTheory.volume R).toReal := ⟨_, rfl⟩
    rw [← hV]
    obtain ⟨M₀, hM₀⟩ : ∃ M₀ : ℕ, M₀ = ⌈(L : ℝ) / (q : ℝ)⌉₊ + 1 := ⟨_, rfl⟩
    have hLq0 : (0 : ℝ) ≤ (L : ℝ) / (q : ℝ) := div_nonneg (Nat.cast_nonneg _) hqpos.le
    have hM₀R : (M₀ : ℝ) = (⌈(L : ℝ) / (q : ℝ)⌉₊ : ℝ) + 1 := by rw [hM₀]; push_cast; ring
    have hceil1 : (L : ℝ) ≤ (q : ℝ) * (⌈(L : ℝ) / (q : ℝ)⌉₊ : ℝ) := by
      have h := Nat.le_ceil ((L : ℝ) / (q : ℝ))
      have h2 := mul_le_mul_of_nonneg_left h hqpos.le
      have e : (q : ℝ) * ((L : ℝ) / (q : ℝ)) = (L : ℝ) := by
        first
          | (field_simp; done)
          | (field_simp; ring)
      linarith
    have hceil2 : (⌈(L : ℝ) / (q : ℝ)⌉₊ : ℝ) < (L : ℝ) / (q : ℝ) + 1 := Nat.ceil_lt_add_one hLq0
    have hvol : ∀ a : Fin d → ℤ,
        (MeasureTheory.volume
            {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ R}).toReal
          = V / (q : ℝ) ^ d := by
      intro a
      rw [hV]
      have hset : {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ R}
          = (fun x : Fin d → ℝ => (q : ℝ) • x) ⁻¹'
              ((fun v : Fin d → ℝ => (fun k => ((a k : ℤ) : ℝ)) + v) ⁻¹' R) := by
        ext x
        simp only [Set.mem_setOf_eq, Set.mem_preimage]
        rfl
      rw [hset, MeasureTheory.Measure.addHaar_preimage_smul MeasureTheory.volume
        (ne_of_gt hqpos), MeasureTheory.measure_preimage_add]
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (abs_nonneg _), Module.finrank_fin_fun,
        abs_of_pos (inv_pos.2 (pow_pos hqpos d)), div_eq_inv_mul]
    have hmeas : ∀ a : Fin d → ℤ,
        MeasurableSet {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ R} := by
      intro a
      have hm : Measurable
          (fun x : Fin d → ℝ => fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) := by
        fun_prop
      exact hm hRm
    have hconv : ∀ a : Fin d → ℤ,
        Convex ℝ {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ R} := by
      intro a x hx y hy s t hs ht hst
      have h := hRc hx hy hs ht hst
      show (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * (s • x + t • y) k) ∈ R
      convert h using 1
      funext k
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      linear_combination (-((a k : ℤ) : ℝ)) * hst
    
    have hper : ∀ r ∈ Res,
        |((@Finset.filter (Fin d → ℤ)
            (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ (fun k => z k % (q : ℤ)) = r)
            (fun _ => Classical.propDecidable _)
            (Finset.Icc u (u + fun _ => (L : ℤ)))).card : ℝ)
          - V / (q : ℝ) ^ d| ≤ C * ((L : ℝ) / (q : ℝ) + 3) ^ (d - 1) := by
      intro r hr
      have hrBox := (hResG r hr).1
      rw [memRes] at hrBox
      obtain ⟨a, ha⟩ : ∃ a : Fin d → ℤ, a = fun k => u k - (u k - r k) % (q : ℤ) := ⟨_, rfl⟩
      have hak : ∀ k, a k = r k + (q : ℤ) * ((u k - r k) / (q : ℤ)) := by
        intro k
        have e := Int.emod_add_ediv (u k - r k) (q : ℤ)
        rw [ha]
        linarith
      have hs0 : ∀ k, 0 ≤ (u k - r k) % (q : ℤ) := fun k => Int.emod_nonneg _ hQ.ne'
      have hs1 : ∀ k, (u k - r k) % (q : ℤ) < (q : ℤ) := fun k => Int.emod_lt_of_pos _ hQ
      have hamod : ∀ k, a k % (q : ℤ) = r k := by
        intro k
        rw [hak k, Int.add_mul_emod_self_left]
        exact Int.emod_eq_of_lt (hrBox k).1 (by linarith [(hrBox k).2])
      have hsub : {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ R}
          ⊆ realBox d (M₀ : ℝ) := by
        intro x hx k
        have hb1 : ((u k : ℤ) : ℝ) ≤ ((a k : ℤ) : ℝ) + (q : ℝ) * x k := (hRsub hx k).1
        have hb2 : ((a k : ℤ) : ℝ) + (q : ℝ) * x k ≤ ((u k : ℤ) : ℝ) + (L : ℝ) :=
          (hRsub hx k).2
        have haR : ((a k : ℤ) : ℝ) = ((u k : ℤ) : ℝ) - (((u k - r k) % (q : ℤ) : ℤ) : ℝ) := by
          rw [ha]; push_cast; ring
        have hs0' : (0 : ℝ) ≤ (((u k - r k) % (q : ℤ) : ℤ) : ℝ) := by exact_mod_cast hs0 k
        have hs1' : (((u k - r k) % (q : ℤ) : ℤ) : ℝ) ≤ (q : ℝ) - 1 := by
          have h := hs1 k
          have h' : (u k - r k) % (q : ℤ) ≤ (q : ℤ) - 1 := by omega
          have h'' : (((u k - r k) % (q : ℤ) : ℤ) : ℝ) ≤ (((q : ℤ) - 1 : ℤ) : ℝ) := by
            exact_mod_cast h'
          simpa using h''
        rw [haR] at hb1 hb2
        rw [abs_le, hM₀R]
        have hc0 : (0 : ℝ) ≤ (⌈(L : ℝ) / (q : ℝ)⌉₊ : ℝ) := Nat.cast_nonneg _
        constructor
        · have hx0 : 0 ≤ x k := by
            by_contra hlt
            push_neg at hlt
            have := mul_neg_of_pos_of_neg hqpos hlt
            linarith
          linarith
        · by_contra hlt
          push_neg at hlt
          have := mul_lt_mul_of_pos_left hlt hqpos
          nlinarith
      have hbij : (@Finset.filter (Fin d → ℤ)
            (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ (fun k => z k % (q : ℤ)) = r)
            (fun _ => Classical.propDecidable _)
            (Finset.Icc u (u + fun _ => (L : ℤ)))).card
          = kaiLatticeCount d M₀
              {x : Fin d → ℝ | (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * x k) ∈ R} := by
        have hdvd : ∀ z : Fin d → ℤ, (fun k => z k % (q : ℤ)) = r →
            ∀ k, a k + (q : ℤ) * ((z k - a k) / (q : ℤ)) = z k := by
          intro z hzr k
          have hrk : z k % (q : ℤ) = r k := congrFun hzr k
          have hd : (q : ℤ) ∣ z k - a k := by
            refine ⟨z k / (q : ℤ) - (u k - r k) / (q : ℤ), ?_⟩
            have e2 := Int.emod_add_ediv (z k) (q : ℤ)
            rw [mul_sub, hak k]
            linarith
          rw [Int.mul_ediv_cancel' hd]
          ring
        unfold kaiLatticeCount
        refine Finset.card_nbij' (fun z k => (z k - a k) / (q : ℤ))
          (fun w k => a k + (q : ℤ) * w k) ?_ ?_ ?_ ?_
        · intro z hz
          simp only [Finset.mem_coe, Finset.mem_filter] at hz ⊢
          obtain ⟨_, hzR, hzr⟩ := hz
          have hz' := hdvd z hzr
          have hfun : (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * ((((z k - a k) / (q : ℤ) : ℤ)) : ℝ))
              = fun k => ((z k : ℤ) : ℝ) := by
            funext k
            exact_mod_cast hz' k
          have hmem : (fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * ((((z k - a k) / (q : ℤ) : ℤ)) : ℝ))
              ∈ R := by
            rw [hfun]; exact hzR
          refine ⟨?_, hmem⟩
          rw [memInt]
          intro k
          have hb := hsub hmem k
          rw [abs_le] at hb
          obtain ⟨hb1, hb2⟩ := hb
          constructor
          · have : ((-(M₀ : ℤ) : ℤ) : ℝ) ≤ (((z k - a k) / (q : ℤ) : ℤ) : ℝ) := by
              push_cast; linarith
            exact_mod_cast this
          · have : (((z k - a k) / (q : ℤ) : ℤ) : ℝ) ≤ (((M₀ : ℤ) : ℤ) : ℝ) := by
              push_cast; linarith
            exact_mod_cast this
        · intro w hw
          simp only [Finset.mem_coe, Finset.mem_filter, Set.mem_setOf_eq] at hw ⊢
          obtain ⟨_, hwΩ⟩ := hw
          have hfun : (fun k => (((a k + (q : ℤ) * w k : ℤ)) : ℝ))
              = fun k => ((a k : ℤ) : ℝ) + (q : ℝ) * ((w k : ℤ) : ℝ) := by
            funext k
            push_cast
            ring
          have hP : (fun k => (((a k + (q : ℤ) * w k : ℤ)) : ℝ)) ∈ R := by
            rw [hfun]; exact hwΩ
          have hresd : (fun k => (a k + (q : ℤ) * w k) % (q : ℤ)) = r := by
            funext k
            rw [Int.add_mul_emod_self_left]
            exact hamod k
          have hb : ∀ k, u k ≤ a k + (q : ℤ) * w k ∧ a k + (q : ℤ) * w k ≤ u k + (L : ℤ) := by
            intro k
            have h1 : ((u k : ℤ) : ℝ) ≤ (((a k + (q : ℤ) * w k : ℤ)) : ℝ) := (hRsub hP k).1
            have h2 : (((a k + (q : ℤ) * w k : ℤ)) : ℝ) ≤ ((u k : ℤ) : ℝ) + (L : ℝ) :=
              (hRsub hP k).2
            constructor
            · exact_mod_cast h1
            · have : (((a k + (q : ℤ) * w k : ℤ)) : ℝ) ≤ (((u k + (L : ℤ)) : ℤ) : ℝ) := by
                push_cast at h2 ⊢; linarith
              exact_mod_cast this
          refine ⟨?_, hP, hresd⟩
          rw [Finset.mem_Icc]
          exact ⟨fun k => (hb k).1, fun k => (hb k).2⟩
        · intro z hz
          simp only [Finset.mem_coe, Finset.mem_filter] at hz
          obtain ⟨_, _, hzr⟩ := hz
          funext k
          exact hdvd z hzr k
        · intro w _
          funext k
          show (a k + (q : ℤ) * w k - a k) / (q : ℤ) = w k
          rw [add_sub_cancel_left, Int.mul_ediv_cancel_left _ hQ.ne']
      have h := hcnt M₀ _ (hmeas a) (hconv a) hsub
      rw [hvol a, ← hbij] at h
      refine h.trans ?_
      refine mul_le_mul_of_nonneg_left ?_ hC
      refine pow_le_pow_left₀ (by positivity) ?_ _
      rw [hM₀R]
      linarith
    
    have hmaps : ∀ z ∈ @Finset.filter (Fin d → ℤ)
          (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ z ∈ G)
          (fun _ => Classical.propDecidable _) (Finset.Icc u (u + fun _ => (L : ℤ))),
        (fun k => z k % (q : ℤ)) ∈ Res := by
      intro z hz
      have hz' := (@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).1 hz
      rw [hRes]
      exact Finset.mem_filter.2 ⟨hmodRes z, (hGmod z).1 hz'.2.2⟩
    have hsplit : ((@Finset.filter (Fin d → ℤ)
          (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ z ∈ G)
          (fun _ => Classical.propDecidable _)
          (Finset.Icc u (u + fun _ => (L : ℤ)))).card : ℝ)
        = ∑ r ∈ Res, ((@Finset.filter (Fin d → ℤ)
            (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ (fun k => z k % (q : ℤ)) = r)
            (fun _ => Classical.propDecidable _)
            (Finset.Icc u (u + fun _ => (L : ℤ)))).card : ℝ) := by
      rw [Finset.card_eq_sum_card_fiberwise hmaps, Nat.cast_sum]
      refine Finset.sum_congr rfl (fun r hr => ?_)
      rw [Nat.cast_inj]
      congr 1
      ext z
      simp only [Finset.mem_filter]
      constructor
      · rintro ⟨⟨h1, h2, _⟩, h4⟩
        exact ⟨h1, h2, h4⟩
      · rintro ⟨h1, h2, h4⟩
        refine ⟨⟨h1, h2, ?_⟩, h4⟩
        rw [hGmod, h4]
        exact (hResG r hr).2
    rw [hsplit]
    have hmain : (Res.card : ℝ) / (q : ℝ) ^ d * V = ∑ r ∈ Res, V / (q : ℝ) ^ d := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ring
    rw [hmain, ← Finset.sum_sub_distrib]
    have hq3 : (q : ℝ) ^ d * (C * ((L : ℝ) / (q : ℝ) + 3) ^ (d - 1))
        = C * (q : ℝ) * ((L : ℝ) + 3 * (q : ℝ)) ^ (d - 1) := by
      have e1 : (q : ℝ) ^ d = (q : ℝ) * (q : ℝ) ^ (d - 1) := by
        rw [← pow_succ']
        congr 1
        omega
      have e2 : (q : ℝ) * ((L : ℝ) / (q : ℝ) + 3) = (L : ℝ) + 3 * (q : ℝ) := by
        first
          | (field_simp; done)
          | (field_simp; ring)
      rw [e1, ← e2, mul_pow]
      ring
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_sum hper).trans ?_
    rw [Finset.sum_const, nsmul_eq_mul, ← hq3]
    exact mul_le_mul_of_nonneg_right hcardRes (mul_nonneg hC (pow_nonneg (by positivity) _))
  · intro q' hqq' hq'
    obtain ⟨s, rfl⟩ := hqq'
    have hs : 1 ≤ s := by
      rcases Nat.eq_zero_or_pos s with h | h
      · subst h; simp at hq'
      · exact h
    have hmaps2 : ∀ r' ∈ @Finset.filter (Fin d → ℤ) (fun z => z ∈ G)
        (fun _ => Classical.propDecidable _) (resBox d (q * s)),
        (fun k => r' k % (q : ℤ)) ∈ Res := by
      intro r' hr'
      have hr'' := Finset.mem_filter.1 hr'
      rw [hRes]
      exact Finset.mem_filter.2 ⟨hmodRes r', (hGmod r').1 hr''.2⟩
    have hscale : (@Finset.filter (Fin d → ℤ) (fun z => z ∈ G)
        (fun _ => Classical.propDecidable _) (resBox d (q * s))).card = s ^ d * Res.card := by
      rw [Finset.card_eq_sum_card_fiberwise hmaps2]
      calc _ = ∑ _r ∈ Res, s ^ d := by
            refine Finset.sum_congr rfl (fun r hr => ?_)
            obtain ⟨hrBox, hrG⟩ := hResG r hr
            rw [memRes] at hrBox
            rw [← hres s]
            symm
            refine Finset.card_nbij' (fun v k => r k + (q : ℤ) * v k)
              (fun r' k => r' k / (q : ℤ)) ?_ ?_ ?_ ?_
            · intro v hv
              simp only [Finset.mem_coe, Finset.mem_filter, memRes] at hv ⊢
              refine ⟨⟨fun k => ?_, ?_⟩, ?_⟩
              · obtain ⟨hv0, hv1⟩ := hv k
                obtain ⟨hr0, hr1⟩ := hrBox k
                have h1 := mul_le_mul_of_nonneg_left hv1 hQ.le
                have h2 := mul_nonneg hQ.le hv0
                rw [mul_sub, mul_one] at h1
                push_cast
                constructor
                · linarith
                · linarith
              · have e : (fun k => r k + (q : ℤ) * v k) = r + (q : ℤ) • v := by
                  funext k; simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
                rw [e]; exact (hG r v).2 hrG
              · funext k
                rw [Int.add_mul_emod_self_left]
                exact Int.emod_eq_of_lt (hrBox k).1 (by linarith [(hrBox k).2])
            · intro r' hr'
              simp only [Finset.mem_coe, Finset.mem_filter, memRes] at hr' ⊢
              obtain ⟨⟨hb, _⟩, _⟩ := hr'
              intro k
              obtain ⟨hb0, hb1⟩ := hb k
              push_cast at hb1
              constructor
              · exact Int.ediv_nonneg hb0 hQ.le
              · have : r' k / (q : ℤ) < (s : ℤ) := by
                  apply Int.ediv_lt_of_lt_mul hQ
                  linarith
                linarith
            · intro v _
              funext k
              show (r k + (q : ℤ) * v k) / (q : ℤ) = v k
              rw [Int.add_mul_ediv_left _ _ hQ.ne', Int.ediv_eq_zero_of_lt (hrBox k).1
                (by linarith [(hrBox k).2]), zero_add]
            · intro r' hr'
              simp only [Finset.mem_coe, Finset.mem_filter] at hr'
              obtain ⟨_, hfr⟩ := hr'
              funext k
              have hrk : r' k % (q : ℤ) = r k := congrFun hfr k
              show r k + (q : ℤ) * (r' k / (q : ℤ)) = r' k
              rw [← hrk]
              exact Int.emod_add_ediv _ _
        _ = s ^ d * Res.card := by rw [Finset.sum_const, smul_eq_mul, mul_comm]
    rw [hscale]
    push_cast
    have hsR : (0 : ℝ) < (s : ℝ) := by exact_mod_cast hs
    have hq0 : (q : ℝ) ≠ 0 := hqpos.ne'
    have hs0 : (s : ℝ) ≠ 0 := hsR.ne'
    rw [mul_pow, mul_comm ((q : ℝ) ^ d), ← div_div, mul_div_cancel_left₀ _
      (pow_ne_zero d hs0)]

theorem kai_coset_coprime_density (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    (∀ 𝔠 : Ideal (NumberField.RingOfIntegers K), 𝔠 ≠ ⊥ →
        1 ≤ Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ)) ∧
    (∀ W : ℕ, 1 ≤ W → 1 ≤ phiK K W) ∧
    (∀ (𝔠 : Ideal (NumberField.RingOfIntegers K)) (b : NumberField.RingOfIntegers K) (W : ℕ),
        𝔠 ≠ ⊥ → 1 ≤ W →
        (∀ 𝔭 : Ideal (NumberField.RingOfIntegers K), 𝔭.IsPrime → 𝔠 ≤ 𝔭 →
            ((W : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭) →
        IsCoprime (Ideal.span {b}) 𝔠 →
        ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
            (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧ CoprimeToNat W (ω.equivFun.symm z))
            (fun _ => Classical.propDecidable _)
            (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * W))).card : ℝ)
          * ((W : ℝ) ^ Module.finrank ℚ K
              * (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) : ℝ))
          = ((Ideal.absNorm 𝔠 * W : ℕ) : ℝ) ^ Module.finrank ℚ K * (phiK K W : ℝ)) :=
by
  classical
  
  
  have hfinQ : ∀ 𝔞 : Ideal (NumberField.RingOfIntegers K), 𝔞 ≠ ⊥ →
      Finite (NumberField.RingOfIntegers K ⧸ 𝔞) := by
    intro 𝔞 h𝔞
    have h0 : Ideal.absNorm 𝔞 ≠ 0 := by rwa [Ne, Ideal.absNorm_eq_zero_iff]
    exact (Ideal.absNorm_ne_zero_iff 𝔞).1 h0
  
  have hA : ∀ 𝔠 : Ideal (NumberField.RingOfIntegers K), 𝔠 ≠ ⊥ →
      1 ≤ Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) := by
    intro 𝔠 h𝔠
    haveI := hfinQ 𝔠 h𝔠
    haveI : Finite ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) :=
      Finite.of_injective (fun u : (NumberField.RingOfIntegers K ⧸ 𝔠)ˣ =>
        (u : NumberField.RingOfIntegers K ⧸ 𝔠)) (fun _ _ h => Units.ext h)
    exact Nat.one_le_iff_ne_zero.2 (Nat.card_pos (α := (NumberField.RingOfIntegers K ⧸ 𝔠)ˣ)).ne'
  
  
  have H1 : ∀ {G H : Type u} [Group G] [Group H] (f : G →* H), Function.Surjective f →
      ∀ v : H, Nat.card {g // f g = v} * Nat.card H = Nat.card G := by
    intro G H _ _ f hf v
    obtain ⟨g₀, hg₀⟩ := hf v
    have e1 : Nat.card {g // f g = v} = Nat.card f.ker := by
      apply Nat.card_congr
      exact
        { toFun := fun g => ⟨g.1 * g₀⁻¹, by
            rw [MonoidHom.mem_ker, map_mul, map_inv, g.2, hg₀, mul_inv_cancel]⟩
          invFun := fun k => ⟨k.1 * g₀, by
            rw [map_mul, (MonoidHom.mem_ker).1 k.2, hg₀, one_mul]⟩
          left_inv := fun g => by ext; simp
          right_inv := fun k => by ext; simp }
    rw [e1, Subgroup.card_eq_card_quotient_mul_card_subgroup f.ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv, mul_comm]
  have H1a : ∀ {G H : Type u} [AddGroup G] [AddGroup H] (f : G →+ H), Function.Surjective f →
      ∀ v : H, Nat.card {g // f g = v} * Nat.card H = Nat.card G := by
    intro G H _ _ f hf v
    obtain ⟨g₀, hg₀⟩ := hf v
    have e1 : Nat.card {g // f g = v} = Nat.card f.ker := by
      apply Nat.card_congr
      exact
        { toFun := fun g => ⟨g.1 - g₀, by
            rw [AddMonoidHom.mem_ker, map_sub, g.2, hg₀, sub_self]⟩
          invFun := fun k => ⟨k.1 + g₀, by
            rw [map_add, (AddMonoidHom.mem_ker).1 k.2, hg₀, zero_add]⟩
          left_inv := fun g => by ext; simp
          right_inv := fun k => by ext; simp }
    rw [e1, AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup f.ker,
      Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective f hf).toEquiv, mul_comm]
  
  
  have s6 : ∀ (I J : Ideal (NumberField.RingOfIntegers K)) (hIJ : I ≤ J),
      (∀ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk J x) →
        ∃ y : NumberField.RingOfIntegers K, y - x ∈ J ∧ IsUnit (Ideal.Quotient.mk I y)) →
      ∀ b : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk J b) →
      Nat.card {t : NumberField.RingOfIntegers K ⧸ I //
          Ideal.Quotient.factor hIJ t = Ideal.Quotient.mk J b ∧ IsUnit t}
        * Nat.card (NumberField.RingOfIntegers K ⧸ J)ˣ
        = Nat.card (NumberField.RingOfIntegers K ⧸ I)ˣ := by
    intro I J hIJ hlift b hb
    let f : (NumberField.RingOfIntegers K ⧸ I)ˣ →* (NumberField.RingOfIntegers K ⧸ J)ˣ :=
      Units.map (Ideal.Quotient.factor hIJ :
        NumberField.RingOfIntegers K ⧸ I →* NumberField.RingOfIntegers K ⧸ J)
    have hf : Function.Surjective f := by
      intro v
      obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (v : NumberField.RingOfIntegers K ⧸ J)
      obtain ⟨y, hyx, hy⟩ := hlift x (by rw [hx]; exact v.isUnit)
      refine ⟨hy.unit, Units.ext ?_⟩
      simp only [f, Units.coe_map, IsUnit.unit_spec, MonoidHom.coe_coe, Ideal.Quotient.factor_mk]
      rw [← hx, Ideal.Quotient.eq]
      exact hyx
    rw [← H1 f hf hb.unit]
    congr 1
    apply Nat.card_congr
    exact
      { toFun := fun t => ⟨t.2.2.unit, Units.ext (by simp [f, t.2.1])⟩
        invFun := fun u => ⟨(u.1 : NumberField.RingOfIntegers K ⧸ I), by
            have h := congrArg Units.val u.2
            simpa [f] using h, u.1.isUnit⟩
        left_inv := fun t => by ext; simp
        right_inv := fun u => by ext; simp }
  
  have s7 : ∀ (I J : Ideal (NumberField.RingOfIntegers K)) (hIJ : I ≤ J),
      (∀ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk J x) →
        IsUnit (Ideal.Quotient.mk I x)) →
      Nat.card (NumberField.RingOfIntegers K ⧸ I)ˣ * Nat.card (NumberField.RingOfIntegers K ⧸ J)
        = Nat.card (NumberField.RingOfIntegers K ⧸ J)ˣ
          * Nat.card (NumberField.RingOfIntegers K ⧸ I) := by
    intro I J hIJ hrad
    have h6 := s6 I J hIJ (fun x hx => ⟨x, by rw [sub_self]; exact J.zero_mem, hrad x hx⟩) 1
      (by rw [map_one]; exact isUnit_one)
    have hcrit : ∀ t : NumberField.RingOfIntegers K ⧸ I,
        Ideal.Quotient.factor hIJ t = 1 → IsUnit t := by
      intro t ht
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective t
      apply hrad
      rw [Ideal.Quotient.factor_mk] at ht
      rw [ht]
      exact isUnit_one
    have e1 : Nat.card {t : NumberField.RingOfIntegers K ⧸ I //
          Ideal.Quotient.factor hIJ t = Ideal.Quotient.mk J 1 ∧ IsUnit t}
        = Nat.card {t : NumberField.RingOfIntegers K ⧸ I //
          (Ideal.Quotient.factor hIJ).toAddMonoidHom t = 1} := by
      apply Nat.card_congr
      apply Equiv.subtypeEquivRight
      intro t
      simp only [map_one, RingHom.toAddMonoidHom_eq_coe, AddMonoidHom.coe_coe]
      exact ⟨fun h => h.1, fun h => ⟨h, hcrit t h⟩⟩
    have h1a := H1a (Ideal.Quotient.factor hIJ).toAddMonoidHom
      (Ideal.Quotient.factor_surjective hIJ) 1
    rw [e1] at h6
    rw [← h6, ← h1a]
    ring
  
  
  have s4 : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (x : NumberField.RingOfIntegers K),
      𝔞 ≠ ⊥ →
      (IsUnit (Ideal.Quotient.mk 𝔞 x) ↔
        ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          𝔞 ≤ 𝔭.asIdeal → x ∉ 𝔭.asIdeal) := by
    intro 𝔞 x h𝔞
    constructor
    · intro hu 𝔭 h𝔭 hx
      obtain ⟨y, hy⟩ := hu.exists_right_inv
      obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [← map_mul, ← map_one (Ideal.Quotient.mk 𝔞), Ideal.Quotient.eq] at hy
      have h1 : x * y' ∈ 𝔭.asIdeal := Ideal.mul_mem_right _ _ hx
      have h2 : x * y' - 1 ∈ 𝔭.asIdeal := h𝔭 hy
      have h3 : (1 : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal := by
        have h4 := Ideal.sub_mem _ h1 h2
        simpa using h4
      exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h3)
    · intro h
      by_contra hu
      have hne : Ideal.span {x} ⊔ 𝔞 ≠ ⊤ := by
        intro htop
        apply hu
        have h1 : (1 : NumberField.RingOfIntegers K) ∈ Ideal.span {x} ⊔ 𝔞 := by
          rw [htop]; exact Submodule.mem_top
        obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.1 h1
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.1 hy
        refine isUnit_iff_exists_inv.2 ⟨Ideal.Quotient.mk 𝔞 r, ?_⟩
        rw [← map_mul, ← map_one (Ideal.Quotient.mk 𝔞), Ideal.Quotient.eq]
        have h2 : x * r - 1 = -z := by rw [← hyz]; ring
        rw [h2]
        exact 𝔞.neg_mem hz
      obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
      have hMbot : M ≠ ⊥ := by
        intro hb
        apply h𝔞
        rw [eq_bot_iff, ← hb]
        exact le_sup_right.trans hle
      exact h ⟨M, hM.isPrime, hMbot⟩ (le_sup_right.trans hle)
        (hle (Ideal.mem_sup_left (Ideal.mem_span_singleton_self x)))
  
  
  have s5 : ∀ (𝔑 𝔠 : Ideal (NumberField.RingOfIntegers K)) (x : NumberField.RingOfIntegers K),
      𝔑 ≠ ⊥ →
      (∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          𝔠 ≤ 𝔭.asIdeal → x ∉ 𝔭.asIdeal) →
      ∃ y : NumberField.RingOfIntegers K, y - x ∈ 𝔠 ∧
        ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          𝔑 ≤ 𝔭.asIdeal → y ∉ 𝔭.asIdeal := by
    intro 𝔑 𝔠 x h𝔑 hx
    have h𝔑0 : 𝔑 ≠ 0 := h𝔑
    have hfin : {𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        𝔑 ≤ 𝔭.asIdeal ∧ ¬ 𝔠 ≤ 𝔭.asIdeal}.Finite := by
      apply (Ideal.finite_factors h𝔑0).subset
      intro 𝔭 h𝔭
      exact Ideal.dvd_iff_le.2 h𝔭.1
    have hcop : IsCoprime 𝔠 (∏ 𝔭 ∈ hfin.toFinset, 𝔭.asIdeal) := by
      apply IsCoprime.prod_right
      intro 𝔭 h𝔭
      rw [Set.Finite.mem_toFinset] at h𝔭
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra hne
      have heq := 𝔭.isMaximal.eq_of_le hne le_sup_right
      exact h𝔭.2 (heq ▸ le_sup_left)
    rw [Ideal.isCoprime_iff_sup_eq] at hcop
    have h1 : (1 : NumberField.RingOfIntegers K) ∈ 𝔠 ⊔ ∏ 𝔭 ∈ hfin.toFinset, 𝔭.asIdeal := by
      rw [hcop]; exact Submodule.mem_top
    obtain ⟨c₀, hc₀, a₀, ha₀, hca⟩ := Submodule.mem_sup.1 h1
    have hdiff : x * a₀ + c₀ - x ∈ 𝔠 := by
      have h2 : x * a₀ + c₀ - x = c₀ * (1 - x) := by linear_combination x * hca
      rw [h2]
      exact Ideal.mul_mem_right _ _ hc₀
    refine ⟨x * a₀ + c₀, hdiff, ?_⟩
    intro 𝔭 h𝔭 hy
    by_cases hc : 𝔠 ≤ 𝔭.asIdeal
    · apply hx 𝔭 hc
      have h2 : x = (x * a₀ + c₀) - (x * a₀ + c₀ - x) := by ring
      rw [h2]
      exact Ideal.sub_mem _ hy (hc hdiff)
    · have hT : 𝔭 ∈ hfin.toFinset := by
        rw [Set.Finite.mem_toFinset]; exact ⟨h𝔭, hc⟩
      have ha : a₀ ∈ 𝔭.asIdeal := (Ideal.prod_le_inf.trans (Finset.inf_le hT)) ha₀
      have h2 : (1 : NumberField.RingOfIntegers K) = (x * a₀ + c₀) - a₀ * (x - 1) := by
        linear_combination (-1 : NumberField.RingOfIntegers K) * hca
      have h3 : (1 : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal := by
        rw [h2]; exact Ideal.sub_mem _ hy (Ideal.mul_mem_right _ _ ha)
      exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h3)
  
  
  have s8 : ∀ W : ℕ, Ideal.absNorm (Ideal.span {((W : ℕ) : NumberField.RingOfIntegers K)})
      = W ^ Module.finrank ℚ K := by
    intro W
    rw [Ideal.absNorm_span_singleton]
    have h : ((W : ℕ) : NumberField.RingOfIntegers K)
        = algebraMap ℤ (NumberField.RingOfIntegers K) ((W : ℕ) : ℤ) := by simp
    rw [h, Algebra.norm_algebraMap_of_basis ω, Fintype.card_fin, Int.natAbs_pow]
    simp
  
  
  have hfib : ∀ (𝔞 : Ideal (NumberField.RingOfIntegers K)) (b : NumberField.RingOfIntegers K)
      (q : ℕ), 1 ≤ q → ((q : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔞 →
      ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔞)
          (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) q)).card : ℝ)
        * (Ideal.absNorm 𝔞 : ℝ) = (q : ℝ) ^ Module.finrank ℚ K := by
    intro 𝔞 b q hq hqa
    set e := ω.equivFun.symm with he_def
    have hQ : (0 : ℤ) < (q : ℤ) := by exact_mod_cast hq
    have hmem : ∀ z : Fin (Module.finrank ℚ K) → ℤ,
        z ∈ resBox (Module.finrank ℚ K) q ↔ ∀ j, 0 ≤ z j ∧ z j < (q : ℤ) := by
      intro z
      unfold resBox
      simp only [Finset.mem_Icc, Pi.le_def]
      constructor
      · rintro ⟨h1, h2⟩ j
        exact ⟨h1 j, by have := h2 j; omega⟩
      · intro h
        exact ⟨fun j => (h j).1, fun j => by have := (h j).2; omega⟩
    have hred : ∀ z : Fin (Module.finrank ℚ K) → ℤ,
        (fun j => z j % (q : ℤ)) ∈ resBox (Module.finrank ℚ K) q ∧
          e (fun j => z j % (q : ℤ)) - e z ∈ 𝔞 := by
      intro z
      refine ⟨(hmem _).2 fun j => ⟨Int.emod_nonneg _ hQ.ne', Int.emod_lt_of_pos _ hQ⟩, ?_⟩
      have hfun : (fun j => z j % (q : ℤ)) - z = (q : ℤ) • (fun j => -(z j / (q : ℤ))) := by
        funext j
        simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
        have := Int.emod_add_mul_ediv (z j) (q : ℤ)
        linear_combination this
      rw [← map_sub, hfun, map_zsmul, zsmul_eq_mul]
      have hc : ((q : ℤ) : NumberField.RingOfIntegers K)
          = ((q : ℕ) : NumberField.RingOfIntegers K) :=
        Int.cast_natCast q
      rw [hc]
      exact Ideal.mul_mem_right _ _ hqa
    let F : NumberField.RingOfIntegers K → Finset (Fin (Module.finrank ℚ K) → ℤ) := fun x =>
      @Finset.filter (Fin (Module.finrank ℚ K) → ℤ) (fun z => e z - x ∈ 𝔞)
        (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) q)
    have hle : ∀ x y, (F x).card ≤ (F y).card := by
      intro x y
      set v := ω.equivFun (y - x) with hv
      have hev : e v = y - x := by rw [he_def, hv]; exact ω.equivFun.symm_apply_apply _
      apply Finset.card_le_card_of_injOn (fun z => fun j => (z j + v j) % (q : ℤ))
      · intro z hz
        have hz' : z ∈ F x := hz
        obtain ⟨hzB, hzx⟩ := Finset.mem_filter.1 hz'
        obtain ⟨h1, h2⟩ := hred (z + v)
        show _ ∈ F y
        refine Finset.mem_filter.2 ⟨h1, ?_⟩
        show e (fun j => (z + v) j % (q : ℤ)) - y ∈ 𝔞
        have hid : e (fun j => (z + v) j % (q : ℤ)) - y
            = (e (fun j => (z + v) j % (q : ℤ)) - e (z + v)) + (e z - x)
              + (e v - (y - x)) := by
          rw [map_add e z v]; ring
        rw [hid, hev, sub_self, add_zero]
        exact 𝔞.add_mem h2 hzx
      · intro z hz z' hz' hzz
        have hzB := (Finset.mem_filter.1 (show z ∈ F x from hz)).1
        have hzB' := (Finset.mem_filter.1 (show z' ∈ F x from hz')).1
        rw [hmem] at hzB hzB'
        funext j
        have h : (z j + v j) % (q : ℤ) = (z' j + v j) % (q : ℤ) := congrFun hzz j
        obtain ⟨a1, a2⟩ := hzB j
        obtain ⟨b1, b2⟩ := hzB' j
        have h3 : z j % (q : ℤ) = z' j % (q : ℤ) := Int.ModEq.add_right_cancel' (v j) h
        rwa [Int.emod_eq_of_lt a1 a2, Int.emod_eq_of_lt b1 b2] at h3
    have hsurj : ∀ c : NumberField.RingOfIntegers K ⧸ 𝔞,
        ∃ z ∈ resBox (Module.finrank ℚ K) q, Ideal.Quotient.mk 𝔞 (e z) = c := by
      intro c
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective c
      obtain ⟨h1, h2⟩ := hred (ω.equivFun x)
      refine ⟨_, h1, ?_⟩
      rw [Ideal.Quotient.eq]
      have h3 : e (ω.equivFun x) = x := by rw [he_def]; exact ω.equivFun.symm_apply_apply x
      rw [h3] at h2
      exact h2
    have hfin : Finite (NumberField.RingOfIntegers K ⧸ 𝔞) := by
      let g : {z // z ∈ resBox (Module.finrank ℚ K) q} → NumberField.RingOfIntegers K ⧸ 𝔞 :=
        fun z => Ideal.Quotient.mk 𝔞 (e z.1)
      refine Finite.of_surjective g ?_
      intro c
      obtain ⟨z, hz, hzc⟩ := hsurj c
      exact ⟨⟨z, hz⟩, hzc⟩
    letI : Fintype (NumberField.RingOfIntegers K ⧸ 𝔞) := Fintype.ofFinite _
    have hcount : (resBox (Module.finrank ℚ K) q).card
        = Fintype.card (NumberField.RingOfIntegers K ⧸ 𝔞) * (F b).card := by
      have h1 := Finset.card_eq_sum_card_fiberwise (s := resBox (Module.finrank ℚ K) q)
        (t := Finset.univ) (f := fun z => Ideal.Quotient.mk 𝔞 (e z))
        (fun z _ => Finset.mem_univ _)
      rw [h1, Finset.sum_congr rfl (g := fun _ => (F b).card) ?_, Finset.sum_const,
        Finset.card_univ, smul_eq_mul]
      intro c _
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective c
      rw [show (F b).card = (F x).card from le_antisymm (hle b x) (hle x b)]
      congr 1
      ext z
      simp only [F, Finset.mem_filter, Ideal.Quotient.eq]
    have hbox : (resBox (Module.finrank ℚ K) q).card = q ^ Module.finrank ℚ K := by
      unfold resBox
      rw [Pi.card_Icc]
      simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
        sub_add_cancel, sub_zero, Int.toNat_natCast]
    have hnorm : Ideal.absNorm 𝔞 = Fintype.card (NumberField.RingOfIntegers K ⧸ 𝔞) := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
    have key : (F b).card * Ideal.absNorm 𝔞 = q ^ Module.finrank ℚ K := by
      rw [hnorm, ← hbox, hcount, mul_comm]
    have hR : ((F b).card : ℝ) * (Ideal.absNorm 𝔞 : ℝ) = (q : ℝ) ^ Module.finrank ℚ K := by
      exact_mod_cast key
    exact hR
  
  
  have hspan : ∀ W : ℕ, 1 ≤ W →
      Ideal.span {((W : ℕ) : NumberField.RingOfIntegers K)} ≠ ⊥ := by
    intro W hW
    rw [Ne, Ideal.span_singleton_eq_bot]
    exact_mod_cast (show W ≠ 0 by omega)
  refine ⟨hA, ?_, ?_⟩
  · 
    intro W hW
    unfold phiK
    exact hA _ (hspan W hW)
  · 
    intro 𝔠 b W h𝔠 hW hprim hb
    obtain ⟨w, hw⟩ : ∃ w : NumberField.RingOfIntegers K,
        w = ((W : ℕ) : NumberField.RingOfIntegers K) := ⟨_, rfl⟩
    obtain ⟨𝔚, h𝔚def⟩ : ∃ 𝔚 : Ideal (NumberField.RingOfIntegers K), 𝔚 = Ideal.span {w} :=
      ⟨_, rfl⟩
    have h𝔚 : 𝔚 ≠ ⊥ := by rw [h𝔚def, hw]; exact hspan W hW
    obtain ⟨𝔑, h𝔑def⟩ : ∃ 𝔑 : Ideal (NumberField.RingOfIntegers K), 𝔑 = 𝔠 * 𝔚 := ⟨_, rfl⟩
    have h𝔑 : 𝔑 ≠ ⊥ := by
      rw [h𝔑def, Ne, Ideal.mul_eq_bot]
      push_neg
      exact ⟨h𝔠, h𝔚⟩
    have h𝔑𝔠 : 𝔑 ≤ 𝔠 := by rw [h𝔑def]; exact Ideal.mul_le_right
    have h𝔑𝔚 : 𝔑 ≤ 𝔚 := by rw [h𝔑def]; exact Ideal.mul_le_left
    have hNc : Ideal.absNorm 𝔠 ≠ 0 := by rwa [Ne, Ideal.absNorm_eq_zero_iff]
    obtain ⟨Q, hQ⟩ : ∃ Q : ℕ, Q = Ideal.absNorm 𝔠 * W := ⟨_, rfl⟩
    have hQ1 : 1 ≤ Q := by rw [hQ]; exact Nat.mul_pos (Nat.pos_of_ne_zero hNc) hW
    have hQmem : ((Q : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔑 := by
      rw [hQ, Nat.cast_mul, h𝔑def, h𝔚def, hw]
      exact Ideal.mul_mem_mul (Ideal.absNorm_mem 𝔠) (Ideal.mem_span_singleton_self _)
    have hF4 : ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        𝔑 ≤ 𝔭.asIdeal ↔ w ∈ 𝔭.asIdeal := by
      intro 𝔭
      constructor
      · intro h
        rw [h𝔑def] at h
        rcases 𝔭.isPrime.mul_le.1 h with h1 | h1
        · rw [hw]; exact hprim 𝔭.asIdeal 𝔭.isPrime h1
        · rw [h𝔚def] at h1; exact (Ideal.span_singleton_le_iff_mem _).1 h1
      · intro h
        exact h𝔑𝔚.trans (by rw [h𝔚def]; exact (Ideal.span_singleton_le_iff_mem _).2 h)
    have hbunit : IsUnit (Ideal.Quotient.mk 𝔠 b) := by
      rw [Ideal.isCoprime_iff_sup_eq] at hb
      have h1 : (1 : NumberField.RingOfIntegers K) ∈ Ideal.span {b} ⊔ 𝔠 := by
        rw [hb]; exact Submodule.mem_top
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.1 h1
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hy
      refine isUnit_iff_exists_inv.2 ⟨Ideal.Quotient.mk 𝔠 a, ?_⟩
      rw [← map_mul, ← map_one (Ideal.Quotient.mk 𝔠), Ideal.Quotient.eq]
      have h2 : b * a - 1 = -z := by rw [← hyz]; ring
      rw [h2]
      exact 𝔠.neg_mem hz
    haveI hfinN : Finite (NumberField.RingOfIntegers K ⧸ 𝔑) := hfinQ 𝔑 h𝔑
    letI : Fintype (NumberField.RingOfIntegers K ⧸ 𝔑) := Fintype.ofFinite _
    obtain ⟨P, hP⟩ : ∃ P : NumberField.RingOfIntegers K ⧸ 𝔑 → Prop,
        P = fun t => Ideal.Quotient.factor h𝔑𝔠 t = Ideal.Quotient.mk 𝔠 b ∧ IsUnit t :=
      ⟨_, rfl⟩
    have hPiff : ∀ x : NumberField.RingOfIntegers K,
        (x - b ∈ 𝔠 ∧ CoprimeToNat W x) ↔ P (Ideal.Quotient.mk 𝔑 x) := by
      intro x
      rw [hP]
      simp only [Ideal.Quotient.factor_mk]
      rw [Ideal.Quotient.eq, s4 𝔑 x h𝔑]
      apply and_congr Iff.rfl
      unfold CoprimeToNat
      apply forall_congr'
      intro 𝔭
      rw [hF4 𝔭, hw]
    
    have hfilt : (@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
        (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧ CoprimeToNat W (ω.equivFun.symm z))
        (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) Q))
        = (resBox (Module.finrank ℚ K) Q).filter
            (fun z => P (Ideal.Quotient.mk 𝔑 (ω.equivFun.symm z))) := by
      ext z
      simp only [Finset.mem_filter]
      rw [hPiff]
    have hE1 : (((resBox (Module.finrank ℚ K) Q).filter
            (fun z => P (Ideal.Quotient.mk 𝔑 (ω.equivFun.symm z)))).card : ℝ)
          * (Ideal.absNorm 𝔑 : ℝ)
        = (Q : ℝ) ^ Module.finrank ℚ K * ((Finset.univ.filter P).card : ℝ) := by
      rw [Finset.card_eq_sum_card_fiberwise (f := fun z => Ideal.Quotient.mk 𝔑 (ω.equivFun.symm z))
        (t := Finset.univ.filter P)
        (fun z hz => by
          have hz' := Finset.mem_coe.1 hz
          exact Finset.mem_coe.2
            (Finset.mem_filter.2 ⟨Finset.mem_univ _, (Finset.mem_filter.1 hz').2⟩))]
      push_cast
      rw [Finset.sum_mul, Finset.sum_congr rfl (g := fun _ => (Q : ℝ) ^ Module.finrank ℚ K),
        Finset.sum_const, nsmul_eq_mul, mul_comm]
      intro t ht
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective t
      have hPx : P (Ideal.Quotient.mk 𝔑 x) := (Finset.mem_filter.1 ht).2
      have heq : ((resBox (Module.finrank ℚ K) Q).filter
            (fun z => P (Ideal.Quotient.mk 𝔑 (ω.equivFun.symm z)))).filter
            (fun z => Ideal.Quotient.mk 𝔑 (ω.equivFun.symm z) = Ideal.Quotient.mk 𝔑 x)
          = @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
              (fun z => ω.equivFun.symm z - x ∈ 𝔑)
              (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) Q) := by
        ext z
        simp only [Finset.mem_filter]
        constructor
        · rintro ⟨⟨h1, _⟩, h2⟩
          exact ⟨h1, Ideal.Quotient.eq.1 h2⟩
        · rintro ⟨h1, h2⟩
          have h3 : Ideal.Quotient.mk 𝔑 (ω.equivFun.symm z) = Ideal.Quotient.mk 𝔑 x :=
            Ideal.Quotient.eq.2 h2
          exact ⟨⟨h1, by rw [h3]; exact hPx⟩, h3⟩
      rw [heq]
      exact hfib 𝔑 x Q hQ1 hQmem
    
    have hlift : ∀ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk 𝔠 x) →
        ∃ y : NumberField.RingOfIntegers K, y - x ∈ 𝔠 ∧ IsUnit (Ideal.Quotient.mk 𝔑 y) := by
      intro x hx
      obtain ⟨y, hy1, hy2⟩ := s5 𝔑 𝔠 x h𝔑 ((s4 𝔠 x h𝔠).1 hx)
      exact ⟨y, hy1, (s4 𝔑 y h𝔑).2 hy2⟩
    have hE2 := s6 𝔑 𝔠 h𝔑𝔠 hlift b hbunit
    have hA_card : Nat.card {t : NumberField.RingOfIntegers K ⧸ 𝔑 //
          Ideal.Quotient.factor h𝔑𝔠 t = Ideal.Quotient.mk 𝔠 b ∧ IsUnit t}
        = (Finset.univ.filter P).card := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype, hP]
      congr
    rw [hA_card] at hE2
    
    have hrad : ∀ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk 𝔚 x) →
        IsUnit (Ideal.Quotient.mk 𝔑 x) := by
      intro x hx
      apply (s4 𝔑 x h𝔑).2
      intro 𝔭 h𝔭
      apply (s4 𝔚 x h𝔚).1 hx 𝔭
      rw [h𝔚def]
      exact (Ideal.span_singleton_le_iff_mem _).2 ((hF4 𝔭).1 h𝔭)
    have hE3 := s7 𝔑 𝔚 h𝔑𝔚 hrad
    have hcardW : Nat.card (NumberField.RingOfIntegers K ⧸ 𝔚) = W ^ Module.finrank ℚ K := by
      rw [← Submodule.cardQuot_apply, ← Ideal.absNorm_apply, h𝔚def, hw, s8]
    have hcardN : Nat.card (NumberField.RingOfIntegers K ⧸ 𝔑) = Ideal.absNorm 𝔑 := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    have hphi : phiK K W = Nat.card (NumberField.RingOfIntegers K ⧸ 𝔚)ˣ := by
      rw [h𝔚def, hw]; rfl
    rw [hcardW, hcardN, ← hphi] at hE3
    
    have hNr : (Ideal.absNorm 𝔑 : ℝ) ≠ 0 := by
      have : Ideal.absNorm 𝔑 ≠ 0 := by rwa [Ne, Ideal.absNorm_eq_zero_iff]
      exact_mod_cast this
    have hE2' : ((Finset.univ.filter P).card : ℝ)
        * (Nat.card (NumberField.RingOfIntegers K ⧸ 𝔠)ˣ : ℝ)
        = (Nat.card (NumberField.RingOfIntegers K ⧸ 𝔑)ˣ : ℝ) := by exact_mod_cast hE2
    have hE3' : (Nat.card (NumberField.RingOfIntegers K ⧸ 𝔑)ˣ : ℝ) * (W : ℝ) ^ Module.finrank ℚ K
        = (phiK K W : ℝ) * (Ideal.absNorm 𝔑 : ℝ) := by exact_mod_cast hE3
    rw [← hQ, hfilt]
    apply mul_right_cancel₀ hNr
    linear_combination ((W : ℝ) ^ Module.finrank ℚ K
        * (Nat.card (NumberField.RingOfIntegers K ⧸ 𝔠)ˣ : ℝ)) * hE1
      + ((Q : ℝ) ^ Module.finrank ℚ K * (W : ℝ) ^ Module.finrank ℚ K) * hE2'
      + (Q : ℝ) ^ Module.finrank ℚ K * hE3'

theorem kai_coset_bad_density_bound (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∀ (𝔠 : Ideal (NumberField.RingOfIntegers K)) (b : NumberField.RingOfIntegers K)
      (U : Finset ℕ), 𝔠 ≠ ⊥ → IsCoprime (Ideal.span {b}) 𝔠 → (∀ p ∈ U, p.Prime) →
      ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧
            ∀ p ∈ U, ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧
              ω.equivFun.symm z ∈ 𝔭.asIdeal)
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * ∏ p ∈ U, p))).card : ℝ)
        * ((Ideal.absNorm 𝔠 : ℝ) * ∏ p ∈ U, (p : ℝ))
        ≤ (Module.finrank ℚ K : ℝ) ^ U.card
            * ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℝ) ^ Module.finrank ℚ K :=
by
  intro 𝔠 b U h𝔠 hb hU
  
  have hnormp : ∀ p : ℕ, p.Prime →
      Ideal.absNorm (Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)})
        = p ^ Module.finrank ℚ K := by
    intro p hp
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    exact (kai_phiK_prime_bounds K p hp).1
  have hspan_ne : ∀ p : ℕ, p.Prime →
      Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)} ≠ 0 := by
    intro p hp h
    have h1 := hnormp p hp
    rw [h, Submodule.zero_eq_bot, Ideal.absNorm_bot] at h1
    exact pow_ne_zero _ hp.ne_zero h1.symm
  
  have hpN : ∀ p : ℕ, p.Prime →
      ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal → p ≤ Ideal.absNorm 𝔭.asIdeal := by
    intro p hp 𝔭 h𝔭
    have hdvd : Ideal.absNorm 𝔭.asIdeal ∣ p ^ Module.finrank ℚ K := by
      rw [← hnormp p hp]
      exact Ideal.absNorm_dvd_absNorm_of_le ((Ideal.span_singleton_le_iff_mem _).2 h𝔭)
    obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow hp).1 hdvd
    have hk0 : k ≠ 0 := by
      rintro rfl
      rw [pow_zero, Ideal.absNorm_eq_one_iff] at hk
      exact 𝔭.isPrime.ne_top hk
    rw [hk]
    exact Nat.le_self_pow hk0 p
  
  have hcop_ne : ∀ 𝔭 𝔮 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      𝔭 ≠ 𝔮 → IsCoprime 𝔭.asIdeal 𝔮.asIdeal := by
    intro 𝔭 𝔮 hne
    rw [Ideal.isCoprime_iff_sup_eq]
    exact Ideal.IsMaximal.coprime_of_ne 𝔭.isMaximal 𝔮.isMaximal
      (fun h => hne (IsDedekindDomain.HeightOneSpectrum.ext h))
  
  have htwo : ∀ p p' : ℕ, p.Prime → p'.Prime → p ≠ p' →
      ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal →
      ((p' : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal → False := by
    intro p p' hp hp' hne 𝔭 h h'
    obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.2 ((Nat.coprime_primes hp hp').2 hne)
    have h1 : ((u : ℤ) : NumberField.RingOfIntegers K) * ((p : ℕ) : NumberField.RingOfIntegers K)
        + ((v : ℤ) : NumberField.RingOfIntegers K) * ((p' : ℕ) : NumberField.RingOfIntegers K)
          = 1 := by
      have h2 := congrArg (Int.cast : ℤ → NumberField.RingOfIntegers K) huv
      push_cast at h2
      exact h2
    have h1mem : (1 : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal := by
      rw [← h1]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h) (Ideal.mul_mem_left _ _ h')
    exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h1mem)
  
  have hT : ∀ p : ℕ, p.Prime →
      ∃ T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        T.card ≤ Module.finrank ℚ K ∧
        ∀ 𝔭, 𝔭 ∈ T ↔ ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal := by
    intro p hp
    have hfin : {𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal}.Finite := by
      refine (Ideal.finite_factors (hspan_ne p hp)).subset ?_
      intro 𝔭 h𝔭
      exact Ideal.dvd_span_singleton.2 h𝔭
    refine ⟨hfin.toFinset, ?_, fun 𝔭 => by simp⟩
    have hdvd : (∏ 𝔭 ∈ hfin.toFinset, 𝔭.asIdeal)
        ∣ Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)} := by
      apply Finset.prod_dvd_of_coprime
      · intro 𝔭 _ 𝔮 _ hne
        exact hcop_ne 𝔭 𝔮 hne
      · intro 𝔭 h𝔭
        rw [Set.Finite.mem_toFinset] at h𝔭
        exact Ideal.dvd_span_singleton.2 h𝔭
    have hN := Ideal.absNorm_dvd_absNorm_of_le (Ideal.le_of_dvd hdvd)
    rw [hnormp p hp, map_prod] at hN
    have hle : p ^ hfin.toFinset.card ≤ ∏ 𝔭 ∈ hfin.toFinset, Ideal.absNorm 𝔭.asIdeal := by
      apply Finset.pow_card_le_prod
      intro 𝔭 h𝔭
      rw [Set.Finite.mem_toFinset] at h𝔭
      exact hpN p hp 𝔭 h𝔭
    have h2 := hle.trans (Nat.le_of_dvd (pow_pos hp.pos _) hN)
    exact (Nat.pow_le_pow_iff_right hp.one_lt).1 h2
  
  have hNc0 : Ideal.absNorm 𝔠 ≠ 0 := fun h => h𝔠 (Ideal.absNorm_eq_zero_iff.mp h)
  have hPpos : 0 < ∏ p ∈ U, p := Finset.prod_pos (fun p hp => (hU p hp).pos)
  have hQ1 : 1 ≤ Ideal.absNorm 𝔠 * ∏ p ∈ U, p := Nat.mul_pos (Nat.pos_of_ne_zero hNc0) hPpos
  have hD : (Ideal.absNorm 𝔠 : ℝ) * ∏ p ∈ U, (p : ℝ)
      = ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℝ) := by
    push_cast; ring
  have hD0 : (0 : ℝ) ≤ (Ideal.absNorm 𝔠 : ℝ) * ∏ p ∈ U, (p : ℝ) := by positivity
  have hQn0 : (0 : ℝ) ≤ ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℝ) ^ Module.finrank ℚ K := by
    positivity
  
  obtain ⟨A, hAdef⟩ : ∃ A : ({p // p ∈ U} →
      IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) →
      Finset (Fin (Module.finrank ℚ K) → ℤ),
      A = fun σ => @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧
            ∀ p : {p // p ∈ U}, ω.equivFun.symm z ∈ (σ p).asIdeal)
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * ∏ p ∈ U, p)) := ⟨_, rfl⟩
  
  have hcount : ∀ σ : {p // p ∈ U} →
      IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (∀ p : {p // p ∈ U}, ((p.1 : ℕ) : NumberField.RingOfIntegers K) ∈ (σ p).asIdeal) →
      ((A σ).card : ℝ) * ((Ideal.absNorm 𝔠 : ℝ) * ∏ p ∈ U, (p : ℝ))
        ≤ ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℝ) ^ Module.finrank ℚ K := by
    intro σ hσ
    rcases (A σ).eq_empty_or_nonempty with hAe | ⟨z₀, hz₀⟩
    · rw [hAe, Finset.card_empty, Nat.cast_zero, zero_mul]
      exact hQn0
    rw [hAdef] at hz₀
    simp only [Finset.mem_filter] at hz₀
    obtain ⟨-, hz₀c, hz₀σ⟩ := hz₀
    have hnot : ∀ p, ¬ 𝔠 ≤ (σ p).asIdeal := by
      intro p hle
      have hbmem : b ∈ (σ p).asIdeal := by
        have h1 := Ideal.sub_mem _ (hz₀σ p) (hle hz₀c)
        rwa [sub_sub_cancel] at h1
      have htop : Ideal.span {b} ⊔ 𝔠 ≤ (σ p).asIdeal :=
        sup_le ((Ideal.span_singleton_le_iff_mem _).2 hbmem) hle
      rw [Ideal.isCoprime_iff_sup_eq.1 hb, top_le_iff] at htop
      exact (σ p).isPrime.ne_top htop
    have hcop𝔠 : ∀ p, IsCoprime 𝔠 (σ p).asIdeal := by
      intro p
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra hne
      have h1 := (σ p).isMaximal.eq_of_le hne le_sup_right
      exact hnot p (le_of_le_of_eq le_sup_left h1.symm)
    have hinj : Function.Injective σ := by
      intro p p' hpp'
      by_contra hne
      have hne' : p.1 ≠ p'.1 := fun h => hne (Subtype.ext h)
      exact htwo p.1 p'.1 (hU p.1 p.2) (hU p'.1 p'.2) hne' (σ p) (hσ p) (hpp' ▸ hσ p')
    obtain ⟨J, hJ⟩ : ∃ J : Ideal (NumberField.RingOfIntegers K),
        J = 𝔠 * ∏ p : {p // p ∈ U}, (σ p).asIdeal := ⟨_, rfl⟩
    have hmemJ : ∀ x, x ∈ 𝔠 → (∀ p, x ∈ (σ p).asIdeal) → x ∈ J := by
      intro x hx𝔠 hxσ
      have h1 : (∏ p : {p // p ∈ U}, (σ p).asIdeal) ∣ Ideal.span {x} := by
        apply Finset.prod_dvd_of_coprime
        · intro p _ p' _ hne
          exact hcop_ne (σ p) (σ p') (fun h => hne (hinj h))
        · intro p _
          exact Ideal.dvd_span_singleton.2 (hxσ p)
      have h2 : IsCoprime 𝔠 (∏ p : {p // p ∈ U}, (σ p).asIdeal) :=
        IsCoprime.prod_right (fun p _ => hcop𝔠 p)
      have h3 := h2.mul_dvd (Ideal.dvd_span_singleton.2 hx𝔠) h1
      rw [hJ]
      exact Ideal.le_of_dvd h3 (Ideal.mem_span_singleton_self x)
    obtain ⟨A', hA'⟩ : ∃ A' : Finset (Fin (Module.finrank ℚ K) → ℤ),
        A' = @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - ω.equivFun.symm z₀ ∈ J)
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * ∏ p ∈ U, p)) := ⟨_, rfl⟩
    have hsub : A σ ⊆ A' := by
      intro z hz
      rw [hAdef] at hz
      simp only [Finset.mem_filter] at hz
      rw [hA']
      simp only [Finset.mem_filter]
      refine ⟨hz.1, hmemJ _ ?_ ?_⟩
      · have h1 := Ideal.sub_mem _ hz.2.1 hz₀c
        rwa [sub_sub_sub_cancel_right] at h1
      · intro p
        exact Ideal.sub_mem _ (hz.2.2 p) (hz₀σ p)
    have hQJ : ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : NumberField.RingOfIntegers K) ∈ J := by
      rw [Nat.cast_mul, Nat.cast_prod,
        ← Finset.prod_coe_sort U (fun p => ((p : ℕ) : NumberField.RingOfIntegers K)), hJ]
      exact Ideal.mul_mem_mul (Ideal.absNorm_mem 𝔠)
        (Ideal.prod_mem_prod (fun p _ => hσ p))
    have hfib := kai_resBox_fiber_count K ω J (ω.equivFun.symm z₀) _ hQ1 hQJ
    rw [← hA'] at hfib
    have hNJ : Ideal.absNorm 𝔠 * ∏ p ∈ U, p ≤ Ideal.absNorm J := by
      rw [hJ, map_mul, map_prod, ← Finset.prod_coe_sort U (fun p => p)]
      exact Nat.mul_le_mul_left _
        (Finset.prod_le_prod' (fun p _ => hpN p.1 (hU p.1 p.2) (σ p) (hσ p)))
    have hNJr : (Ideal.absNorm 𝔠 : ℝ) * ∏ p ∈ U, (p : ℝ) ≤ (Ideal.absNorm J : ℝ) := by
      rw [hD]
      exact_mod_cast hNJ
    have hcard : ((A σ).card : ℝ) ≤ (A'.card : ℝ) := by
      exact_mod_cast Finset.card_le_card hsub
    rw [← hfib]
    exact mul_le_mul hcard hNJr hD0 (Nat.cast_nonneg _)
  
  choose T hTcard hTmem using fun p : {p // p ∈ U} => hT p.1 (hU p.1 p.2)
  have hFsub : (@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧
            ∀ p ∈ U, ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧
              ω.equivFun.symm z ∈ 𝔭.asIdeal)
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * ∏ p ∈ U, p)))
        ⊆ (Fintype.piFinset T).biUnion A := by
    intro z hz
    simp only [Finset.mem_filter] at hz
    obtain ⟨hzbox, hzc, hzU⟩ := hz
    choose g hg using fun p : {p // p ∈ U} => hzU p.1 p.2
    rw [Finset.mem_biUnion]
    refine ⟨g, Fintype.mem_piFinset.2 (fun p => (hTmem p (g p)).2 (hg p).1), ?_⟩
    rw [hAdef]
    simp only [Finset.mem_filter]
    exact ⟨hzbox, hzc, fun p => (hg p).2⟩
  have hcardF := (Finset.card_le_card hFsub).trans Finset.card_biUnion_le
  have hcardF' : ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧
            ∀ p ∈ U, ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧
              ω.equivFun.symm z ∈ 𝔭.asIdeal)
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * ∏ p ∈ U, p))).card : ℝ)
        ≤ ∑ σ ∈ Fintype.piFinset T, ((A σ).card : ℝ) := by
    exact_mod_cast hcardF
  have hSigcard : ((Fintype.piFinset T).card : ℝ) ≤ (Module.finrank ℚ K : ℝ) ^ U.card := by
    rw [Fintype.card_piFinset]
    have h1 : ∏ p : {p // p ∈ U}, (T p).card ≤ Module.finrank ℚ K ^ U.card := by
      calc ∏ p : {p // p ∈ U}, (T p).card
          ≤ Module.finrank ℚ K ^ (Finset.univ : Finset {p // p ∈ U}).card :=
            Finset.prod_le_pow_card _ _ _ (fun p _ => hTcard p)
        _ = Module.finrank ℚ K ^ U.card := by rw [Finset.card_univ, Fintype.card_coe]
    exact_mod_cast h1
  calc _ ≤ (∑ σ ∈ Fintype.piFinset T, ((A σ).card : ℝ))
          * ((Ideal.absNorm 𝔠 : ℝ) * ∏ p ∈ U, (p : ℝ)) :=
        mul_le_mul_of_nonneg_right hcardF' hD0
    _ = ∑ σ ∈ Fintype.piFinset T,
          ((A σ).card : ℝ) * ((Ideal.absNorm 𝔠 : ℝ) * ∏ p ∈ U, (p : ℝ)) := Finset.sum_mul _ _ _
    _ ≤ ∑ σ ∈ Fintype.piFinset T,
          ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℝ) ^ Module.finrank ℚ K := by
        apply Finset.sum_le_sum
        intro σ hσ
        exact hcount σ (fun p => (hTmem p (σ p)).1 (Fintype.mem_piFinset.1 hσ p))
    _ = ((Fintype.piFinset T).card : ℝ)
          * ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℝ) ^ Module.finrank ℚ K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right hSigcard hQn0

theorem kai_bonferroni_compare {α β : Type*} (P : Finset ℕ) (T : α → Finset ℕ)
    (T' : β → Finset ℕ) (S : Finset α) (Y : Finset β) (N V : ℝ) (r : ℕ)
    (hN : 0 < N) (hV : 0 ≤ V) (hT : ∀ x, T x ⊆ P) (hT' : ∀ y, T' y ⊆ P) :
    |((S.filter (fun x => T x = ∅)).card : ℝ)
        - V * ((Y.filter (fun y => T' y = ∅)).card : ℝ) / N|
      ≤ ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r + 1),
          |((S.filter (fun x => U ⊆ T x)).card : ℝ)
            - V * ((Y.filter (fun y => U ⊆ T' y)).card : ℝ) / N|
        + 2 * V * ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1),
            ((Y.filter (fun y => U ⊆ T' y)).card : ℝ) / N :=
by
  
  have hrestr : ∀ (t : Finset ℕ), t ⊆ P → ∀ (q : Finset ℕ → Prop) [DecidablePred q]
      (g : Finset ℕ → ℝ),
      ∑ U ∈ P.powerset.filter q, g U * (if U ⊆ t then (1:ℝ) else 0)
        = ∑ U ∈ t.powerset.filter q, g U := by
    intro t ht q _ g
    simp only [mul_ite, mul_one, mul_zero]
    rw [← Finset.sum_filter]
    apply Finset.sum_congr _ (fun _ _ => rfl)
    ext U
    simp only [Finset.mem_filter, Finset.mem_powerset]
    constructor
    · rintro ⟨⟨_, hq⟩, hU⟩; exact ⟨hU, hq⟩
    · rintro ⟨hU, hq⟩; exact ⟨⟨hU.trans ht, hq⟩, hU⟩
  
  have hgroup : ∀ t : Finset ℕ, ∑ U ∈ t.powerset.filter (fun U => U.card ≤ r), (-1:ℝ) ^ U.card
      = ∑ j ∈ Finset.range (r + 1), (-1:ℝ) ^ j * ((t.card.choose j : ℕ) : ℝ) := by
    intro t
    rw [← Finset.sum_fiberwise_of_maps_to (g := Finset.card) (t := Finset.range (r + 1))
      (fun U hU => by
        simp only [Finset.mem_filter] at hU
        exact Finset.mem_range.2 (by omega)) (fun U => (-1:ℝ) ^ U.card)]
    apply Finset.sum_congr rfl
    intro j hj
    have hj' : j ≤ r := by
      have := Finset.mem_range.1 hj
      omega
    have hfib : (t.powerset.filter (fun U => U.card ≤ r)).filter (fun U => U.card = j)
        = t.powersetCard j := by
      rw [Finset.powersetCard_eq_filter, Finset.filter_filter]
      apply Finset.filter_congr
      intro U _
      constructor
      · rintro ⟨_, h⟩; exact h
      · intro h; exact ⟨by omega, h⟩
    rw [hfib, Finset.sum_congr rfl (g := fun _ => (-1:ℝ) ^ j)
      (fun U hU => by rw [(Finset.mem_powersetCard.1 hU).2]),
      Finset.sum_const, Finset.card_powersetCard, nsmul_eq_mul, mul_comm]
  
  have hpt : ∀ t : Finset ℕ, t ⊆ P →
      0 ≤ (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
            (-1:ℝ) ^ U.card * (if U ⊆ t then (1:ℝ) else 0) - (if t = ∅ then (1:ℝ) else 0)) ∧
      (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
            (-1:ℝ) ^ U.card * (if U ⊆ t then (1:ℝ) else 0) - (if t = ∅ then (1:ℝ) else 0))
        ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), (if U ⊆ t then (1:ℝ) else 0) := by
    intro t ht
    have h1 := hrestr t ht (fun U => U.card = r + 1) (fun _ => (1:ℝ))
    simp only [one_mul, Finset.sum_const, nsmul_eq_mul, mul_one] at h1
    rw [h1, hrestr t ht (fun U => U.card ≤ r) (fun U => (-1:ℝ) ^ U.card), hgroup t]
    have hcard : (t.powerset.filter (fun U => U.card = r + 1)).card = (t.card).choose (r + 1) := by
      rw [← Finset.powersetCard_eq_filter, Finset.card_powersetCard]
    rw [hcard]
    rcases Nat.eq_zero_or_pos t.card with h0 | hpos
    · have : t = ∅ := Finset.card_eq_zero.1 h0
      rw [if_pos this, h0]
      simp [Finset.sum_range_succ', Nat.choose_zero_succ]
    · obtain ⟨k, hk⟩ : ∃ k, t.card = k + 1 := ⟨t.card - 1, by omega⟩
      have hne : t ≠ ∅ := by
        intro h
        rw [h] at hk
        simp at hk
      rw [if_neg hne, hk]
      have hid := Int.alternating_sum_range_choose_eq_choose (n := k) (m := r)
      have hidR : ∑ j ∈ Finset.range (r + 1), (-1:ℝ) ^ j * (((k + 1).choose j : ℕ) : ℝ)
          = (-1:ℝ) ^ r * ((k.choose r : ℕ) : ℝ) := by
        exact_mod_cast hid
      rw [hidR, sub_zero, ← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul]
      refine ⟨Nat.cast_nonneg _, ?_⟩
      have : k.choose r ≤ (k + 1).choose (r + 1) := by
        rw [Nat.choose_succ_succ']
        exact Nat.le_add_right _ _
      exact_mod_cast this
  
  have hfamA : 0 ≤ (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * ((S.filter (fun x => U ⊆ T x)).card : ℝ)
        - ((S.filter (fun x => T x = ∅)).card : ℝ)) ∧
      (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * ((S.filter (fun x => U ⊆ T x)).card : ℝ)
        - ((S.filter (fun x => T x = ∅)).card : ℝ))
        ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1),
            ((S.filter (fun x => U ⊆ T x)).card : ℝ) := by
    have hX : ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * ((S.filter (fun x => U ⊆ T x)).card : ℝ)
        - ((S.filter (fun x => T x = ∅)).card : ℝ)
        = ∑ x ∈ S, (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
            (-1:ℝ) ^ U.card * (if U ⊆ T x then (1:ℝ) else 0)
              - (if T x = ∅ then (1:ℝ) else 0)) := by
      rw [Finset.sum_sub_distrib]
      simp only [Finset.natCast_card_filter, Finset.mul_sum]
      rw [Finset.sum_comm]
    have hσ : ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1),
          ((S.filter (fun x => U ⊆ T x)).card : ℝ)
        = ∑ x ∈ S, ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1),
            (if U ⊆ T x then (1:ℝ) else 0) := by
      simp only [Finset.natCast_card_filter]
      rw [Finset.sum_comm]
    rw [hX, hσ, Finset.mul_sum]
    exact ⟨Finset.sum_nonneg fun x _ => (hpt (T x) (hT x)).1,
      Finset.sum_le_sum fun x _ => (hpt (T x) (hT x)).2⟩
  
  have hfamB : 0 ≤ (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * ((Y.filter (fun y => U ⊆ T' y)).card : ℝ)
        - ((Y.filter (fun y => T' y = ∅)).card : ℝ)) ∧
      (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * ((Y.filter (fun y => U ⊆ T' y)).card : ℝ)
        - ((Y.filter (fun y => T' y = ∅)).card : ℝ))
        ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1),
            ((Y.filter (fun y => U ⊆ T' y)).card : ℝ) := by
    have hX : ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * ((Y.filter (fun y => U ⊆ T' y)).card : ℝ)
        - ((Y.filter (fun y => T' y = ∅)).card : ℝ)
        = ∑ y ∈ Y, (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
            (-1:ℝ) ^ U.card * (if U ⊆ T' y then (1:ℝ) else 0)
              - (if T' y = ∅ then (1:ℝ) else 0)) := by
      rw [Finset.sum_sub_distrib]
      simp only [Finset.natCast_card_filter, Finset.mul_sum]
      rw [Finset.sum_comm]
    have hσ : ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1),
          ((Y.filter (fun y => U ⊆ T' y)).card : ℝ)
        = ∑ y ∈ Y, ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1),
            (if U ⊆ T' y then (1:ℝ) else 0) := by
      simp only [Finset.natCast_card_filter]
      rw [Finset.sum_comm]
    rw [hX, hσ, Finset.mul_sum]
    exact ⟨Finset.sum_nonneg fun y _ => (hpt (T' y) (hT' y)).1,
      Finset.sum_le_sum fun y _ => (hpt (T' y) (hT' y)).2⟩
  
  have hbook : ∀ (a b : Finset ℕ → ℝ) (A B : ℝ),
      (0 ≤ (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * a U - A) ∧
        (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * a U - A) ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), a U) →
      (0 ≤ (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * b U - B) ∧
        (-1:ℝ) ^ r * (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
          (-1:ℝ) ^ U.card * b U - B) ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), b U) →
      |A - V * B / N| ≤ ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r + 1),
          |a U - V * b U / N|
        + 2 * V * ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), b U / N := by
    intro a b A B ha hb
    have hsabs : |(-1:ℝ) ^ r| = 1 := by simp
    have hc : 0 ≤ V / N := div_nonneg hV hN.le
    obtain ⟨Xa, hXa⟩ : ∃ X : ℝ, X = ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
        (-1:ℝ) ^ U.card * a U - A := ⟨_, rfl⟩
    obtain ⟨Xb, hXb⟩ : ∃ X : ℝ, X = ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
        (-1:ℝ) ^ U.card * b U - B := ⟨_, rfl⟩
    rw [← hXa] at ha
    rw [← hXb] at hb
    have hXa' : |Xa| ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), a U := by
      have : |Xa| = (-1:ℝ) ^ r * Xa := by
        rw [← abs_of_nonneg ha.1, abs_mul, hsabs, one_mul]
      rw [this]; exact ha.2
    have hXb' : |Xb| ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), b U := by
      have : |Xb| = (-1:ℝ) ^ r * Xb := by
        rw [← abs_of_nonneg hb.1, abs_mul, hsabs, one_mul]
      rw [this]; exact hb.2
    have hid : A - V * B / N = ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
        (-1:ℝ) ^ U.card * (a U - V * b U / N) - (Xa - V / N * Xb) := by
      rw [hXa, hXb]
      simp only [mul_sub, Finset.sum_sub_distrib]
      have : ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r), (-1:ℝ) ^ U.card * (V * b U / N)
          = V / N * ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r), (-1:ℝ) ^ U.card * b U := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro U _
        ring
      rw [this]
      ring
    have h1 : |∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
        (-1:ℝ) ^ U.card * (a U - V * b U / N)|
        ≤ ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r), |a U - V * b U / N| := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq (Finset.sum_congr rfl fun U _ => ?_))
      rw [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
    have h2 : |Xa - V / N * Xb| ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), a U
        + V / N * ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), b U := by
      refine (abs_sub _ _).trans (add_le_add hXa' ?_)
      rw [abs_mul, abs_of_nonneg hc]
      exact mul_le_mul_of_nonneg_left hXb' hc
    have h3 : ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), a U
        ≤ ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), |a U - V * b U / N|
          + V / N * ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), b U := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      apply Finset.sum_le_sum
      intro U _
      have := le_abs_self (a U - V * b U / N)
      have e : V / N * b U = V * b U / N := by ring
      linarith
    have h4 : ∀ f : Finset ℕ → ℝ, ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r + 1), f U
        = ∑ U ∈ P.powerset.filter (fun U => U.card ≤ r), f U
          + ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), f U := by
      intro f
      have e1 : (P.powerset.filter (fun U => U.card ≤ r + 1)).filter (fun U => U.card ≤ r)
          = P.powerset.filter (fun U => U.card ≤ r) := by
        rw [Finset.filter_filter]
        apply Finset.filter_congr
        intro U _
        omega
      have e2 : (P.powerset.filter (fun U => U.card ≤ r + 1)).filter (fun U => ¬ U.card ≤ r)
          = P.powerset.filter (fun U => U.card = r + 1) := by
        rw [Finset.filter_filter]
        apply Finset.filter_congr
        intro U _
        omega
      rw [← e1, ← e2]
      exact (Finset.sum_filter_add_sum_filter_not _ _ _).symm
    have h5 : 2 * V * ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), b U / N
        = 2 * (V / N * ∑ U ∈ P.powerset.filter (fun U => U.card = r + 1), b U) := by
      rw [← Finset.sum_div]
      ring
    rw [hid, h4, h5]
    have h6 := abs_sub (∑ U ∈ P.powerset.filter (fun U => U.card ≤ r),
        (-1:ℝ) ^ U.card * (a U - V * b U / N)) (Xa - V / N * Xb)
    linarith
  exact hbook (fun U => ((S.filter (fun x => U ⊆ T x)).card : ℝ))
    (fun U => ((Y.filter (fun y => U ⊆ T' y)).card : ℝ)) _ _ hfamA hfamB

theorem kai_sieve_level_numerics (n : ℕ) (hn : 1 ≤ n) :
    ∃ ℓ₀ : ℝ, 182 ≤ ℓ₀ ∧ ∀ M : ℝ, 3 ≤ M → ℓ₀ ≤ Real.log M →
      1 ≤ ⌈Real.log M ^ ((2:ℝ)/3) / 16⌉₊ ∧
      (∀ (m : ℕ) (X : ℝ), (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) → 0 ≤ X →
          X ≤ Real.exp (2 * Real.log M ^ ((1:ℝ)/3)) →
          X * ((m : ℝ) + 1) ^ (2 * ⌈Real.log M ^ ((2:ℝ)/3) / 16⌉₊) ≤ M ^ ((1:ℝ)/4)) ∧
      (∀ S : ℝ, 0 ≤ S → S ≤ 1 + Real.log M ^ ((1:ℝ)/3) →
          ((n : ℝ) * S) ^ ⌈Real.log M ^ ((2:ℝ)/3) / 16⌉₊
            / ((⌈Real.log M ^ ((2:ℝ)/3) / 16⌉₊).factorial : ℝ)
            ≤ Real.exp (-((1:ℝ)/16 * Real.log M ^ ((2:ℝ)/3)))) :=
by
  have hn1 : (1:ℝ) ≤ n := by exact_mod_cast hn
  have h300 : (0:ℝ) ≤ 300 * n := by positivity
  refine ⟨((300:ℝ) * n) ^ 3, ?_, ?_⟩
  · nlinarith [pow_le_pow_left₀ (by norm_num : (0:ℝ) ≤ 300)
      (show (300:ℝ) ≤ 300 * n by linarith) 3]
  intro M hM hℓ
  have hM0 : 0 < M := by linarith
  have hlam0 : 0 < Real.log M := by
    have : (0:ℝ) < ((300:ℝ) * n) ^ 3 := by positivity
    linarith
  have h13 : (1:ℝ)/3 = ((3:ℕ):ℝ)⁻¹ := by norm_num
  have hF1 : 300 * (n:ℝ) ≤ Real.log M ^ ((1:ℝ)/3) := by
    have h := Real.rpow_le_rpow (by positivity : (0:ℝ) ≤ ((300:ℝ) * n) ^ 3) hℓ
      (by norm_num : (0:ℝ) ≤ (1:ℝ)/3)
    rw [h13, Real.pow_rpow_inv_natCast h300 (by norm_num)] at h
    rw [h13]; exact h
  have hF2 : (Real.log M ^ ((1:ℝ)/3)) ^ 3 = Real.log M := by
    rw [h13]; exact Real.rpow_inv_natCast_pow hlam0.le (by norm_num)
  have hF3 : Real.log M ^ ((2:ℝ)/3) = (Real.log M ^ ((1:ℝ)/3)) ^ 2 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hlam0.le]; norm_num
  have hF4 : M ^ ((1:ℝ)/4) = Real.exp ((Real.log M ^ ((1:ℝ)/3)) ^ 3 / 4) := by
    rw [hF2, Real.rpow_def_of_pos hM0]; congr 1; ring
  obtain ⟨u, hu⟩ : ∃ u : ℝ, u = Real.log M ^ ((1:ℝ)/3) := ⟨_, rfl⟩
  rw [hF3, hF4, ← hu]
  rw [← hu] at hF1
  have hu300 : 300 ≤ u := by nlinarith
  have hupos : 0 < u := by linarith
  obtain ⟨k, hk⟩ : ∃ k : ℕ, k = ⌈u ^ 2 / 16⌉₊ := ⟨_, rfl⟩
  rw [← hk]
  have hK1 : u ^ 2 / 16 ≤ (k : ℝ) := by rw [hk]; exact Nat.le_ceil _
  have hK2 : (k : ℝ) < u ^ 2 / 16 + 1 := by
    rw [hk]; exact Nat.ceil_lt_add_one (by positivity)
  have hk1 : 1 ≤ k := by
    have h : (0:ℝ) < k := by nlinarith
    have : 0 < k := by exact_mod_cast h
    omega
  refine ⟨hk1, ?_, ?_⟩
  · intro m X hm hX0 hX
    have hm0 : (0:ℝ) ≤ (m:ℝ) + 1 := by positivity
    have h1 : ((m:ℝ) + 1) ^ (2 * k) ≤ Real.exp u ^ (2 * k) := pow_le_pow_left₀ hm0 hm _
    have h2 : Real.exp u ^ (2 * k) = Real.exp (2 * (k:ℝ) * u) := by
      rw [← Real.exp_nat_mul]; congr 1; norm_num
    have h3 : X * ((m:ℝ) + 1) ^ (2 * k) ≤ Real.exp (2 * u) * Real.exp (2 * (k:ℝ) * u) := by
      rw [← h2]; exact mul_le_mul hX h1 (by positivity) (Real.exp_pos _).le
    rw [← Real.exp_add] at h3
    refine h3.trans (Real.exp_le_exp.mpr ?_)
    have h32 : 0 ≤ u ^ 2 - 32 := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hK2.le (by linarith : (0:ℝ) ≤ 2 * u),
      mul_nonneg hupos.le h32]
  · intro S hS0 hS
    have hn0 : (0:ℝ) ≤ n := by positivity
    have ha0 : 0 ≤ (n:ℝ) * S := mul_nonneg hn0 hS0
    have ha : 8 * ((n:ℝ) * S) ≤ (k:ℝ) := by
      have h1 : (n:ℝ) * S ≤ n * (1 + u) := mul_le_mul_of_nonneg_left hS hn0
      have h2 : (n:ℝ) * (1 + u) ≤ 2 * n * u := by
        nlinarith [mul_nonneg hn0 (show (0:ℝ) ≤ u - 1 by linarith)]
      have h3 : 300 * (n:ℝ) * u ≤ u * u := mul_le_mul_of_nonneg_right hF1 hupos.le
      have h4 : 0 ≤ (n:ℝ) * u := mul_nonneg hn0 hupos.le
      nlinarith
    have hkpos : (0:ℝ) < k := by
      have : 0 < k := by omega
      exact_mod_cast this
    have hfac : (0:ℝ) < (k.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos k
    have hpow : ((n:ℝ) * S) ^ k ≤ ((k:ℝ) / 8) ^ k := pow_le_pow_left₀ ha0 (by linarith) k
    have hst : (k:ℝ) ^ k / (k.factorial : ℝ) ≤ Real.exp k :=
      Real.pow_div_factorial_le_exp (k:ℝ) hkpos.le k
    have he2 : Real.exp 2 ≤ 8 := by
      have h := Real.exp_one_lt_d9
      have : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
      rw [this]; nlinarith [Real.exp_pos 1]
    have h18 : (1:ℝ)/8 ≤ Real.exp (-2) := by
      rw [Real.exp_neg, one_div]; exact inv_anti₀ (Real.exp_pos 2) he2
    have h8k : ((1:ℝ)/8) ^ k ≤ Real.exp (-2) ^ k := pow_le_pow_left₀ (by norm_num) h18 k
    have hexpk : Real.exp (-2) ^ k * Real.exp k = Real.exp (-(k:ℝ)) := by
      rw [← Real.exp_nat_mul, ← Real.exp_add]; congr 1; ring
    calc ((n:ℝ) * S) ^ k / (k.factorial : ℝ) ≤ ((k:ℝ) / 8) ^ k / (k.factorial : ℝ) :=
          div_le_div_of_nonneg_right hpow hfac.le
      _ = ((1:ℝ)/8) ^ k * ((k:ℝ) ^ k / (k.factorial : ℝ)) := by ring
      _ ≤ Real.exp (-2) ^ k * Real.exp k :=
          mul_le_mul h8k hst (by positivity) (by positivity)
      _ = Real.exp (-(k:ℝ)) := hexpk
      _ ≤ Real.exp (-((1:ℝ)/16 * u ^ 2)) := Real.exp_le_exp.mpr (by linarith)

theorem kai_prime_powerset_bounds : (∀ m k : ℕ, ((((Finset.range (m + 1)).filter Nat.Prime).powerset.filter
        (fun U => U.card ≤ k)).card : ℝ) ≤ ((m : ℝ) + 1) ^ k) ∧
    (∀ (m : ℕ) (U : Finset ℕ), U ⊆ (Finset.range (m + 1)).filter Nat.Prime →
        ((∏ p ∈ U, p : ℕ) : ℝ) ≤ ((m : ℝ) + 1) ^ U.card) ∧
    (∀ m : ℕ, ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 : ℝ) / (p : ℝ)
        ≤ 1 + Real.log ((m : ℝ) + 1)) ∧
    (∀ (s : Finset ℕ) (a : ℕ → ℝ) (k : ℕ), (∀ p ∈ s, 0 ≤ a p) →
        ∑ U ∈ s.powersetCard k, ∏ p ∈ U, a p ≤ (∑ p ∈ s, a p) ^ k / (k.factorial : ℝ)) :=
by
  have s1 : ∀ (s : Finset ℕ) (k : ℕ),
      (s.powerset.filter (fun U => U.card ≤ k)).card ≤ (s.card + 1) ^ k := by
    intro s k
    induction k with
    | zero =>
      have hsub : s.powerset.filter (fun U => U.card ≤ 0) ⊆ {∅} := by
        intro U hU
        rw [Finset.mem_filter] at hU
        rw [Finset.mem_singleton]
        exact Finset.card_eq_zero.mp (Nat.le_zero.mp hU.2)
      simpa using Finset.card_le_card hsub
    | succ k ih =>
      have hsub : s.powerset.filter (fun U => U.card ≤ k + 1) ⊆
          s.powerset.filter (fun U => U.card ≤ k) ∪
            (s ×ˢ s.powerset.filter (fun U => U.card ≤ k)).image
              (fun x => insert x.1 x.2) := by
        intro U hU
        rw [Finset.mem_filter, Finset.mem_powerset] at hU
        rw [Finset.mem_union]
        by_cases hk : U.card ≤ k
        · left; rw [Finset.mem_filter, Finset.mem_powerset]; exact ⟨hU.1, hk⟩
        · right
          have hpos : 0 < U.card := by omega
          obtain ⟨p, hp⟩ := Finset.card_pos.mp hpos
          rw [Finset.mem_image]
          refine ⟨(p, U.erase p), ?_, Finset.insert_erase hp⟩
          rw [Finset.mem_product, Finset.mem_filter, Finset.mem_powerset]
          refine ⟨hU.1 hp, (Finset.erase_subset p U).trans hU.1, ?_⟩
          rw [Finset.card_erase_of_mem hp]; omega
      calc _ ≤ _ := Finset.card_le_card hsub
        _ ≤ (s.powerset.filter (fun U => U.card ≤ k)).card
              + ((s ×ˢ s.powerset.filter (fun U => U.card ≤ k)).image
                  (fun x => insert x.1 x.2)).card := Finset.card_union_le _ _
        _ ≤ (s.powerset.filter (fun U => U.card ≤ k)).card
              + (s ×ˢ s.powerset.filter (fun U => U.card ≤ k)).card :=
            Nat.add_le_add_left Finset.card_image_le _
        _ = (s.card + 1) * (s.powerset.filter (fun U => U.card ≤ k)).card := by
            rw [Finset.card_product]; ring
        _ ≤ (s.card + 1) * (s.card + 1) ^ k := Nat.mul_le_mul_left _ ih
        _ = (s.card + 1) ^ (k + 1) := by ring
  have hPcard : ∀ m : ℕ, ((Finset.range (m + 1)).filter Nat.Prime).card ≤ m := by
    intro m
    have h : (Finset.range (m + 1)).filter Nat.Prime ⊆ (Finset.range (m + 1)).erase 0 := by
      intro p hp
      rw [Finset.mem_filter] at hp
      exact Finset.mem_erase.mpr ⟨hp.2.ne_zero, hp.1⟩
    have := Finset.card_le_card h
    rw [Finset.card_erase_of_mem (by simp), Finset.card_range] at this
    simpa using this
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro m k
    have h1 := s1 ((Finset.range (m + 1)).filter Nat.Prime) k
    have h2 : (((Finset.range (m + 1)).filter Nat.Prime).card + 1) ^ k ≤ (m + 1) ^ k :=
      Nat.pow_le_pow_left (by have := hPcard m; omega) k
    exact_mod_cast h1.trans h2
  · intro m U hU
    have h : ∏ p ∈ U, p ≤ (m + 1) ^ U.card := by
      apply Finset.prod_le_pow_card
      intro p hp
      have := hU hp
      rw [Finset.mem_filter, Finset.mem_range] at this
      omega
    exact_mod_cast h
  · intro m
    have hsub : (Finset.range (m + 1)).filter Nat.Prime ⊆ Finset.Icc 1 m := by
      intro p hp
      rw [Finset.mem_filter, Finset.mem_range] at hp
      rw [Finset.mem_Icc]
      exact ⟨hp.2.one_lt.le, by omega⟩
    have h1 : ∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 : ℝ) / (p : ℝ)
        ≤ ∑ n ∈ Finset.Icc 1 m, (1 : ℝ) / (n : ℝ) :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (fun i _ _ => by positivity)
    have h2 : ∑ n ∈ Finset.Icc 1 m, (1 : ℝ) / (n : ℝ) = ((harmonic m : ℚ) : ℝ) := by
      rw [harmonic_eq_sum_Icc]; push_cast; simp [one_div]
    have h3 := harmonic_le_one_add_log m
    have h4 : Real.log (m : ℝ) ≤ Real.log ((m : ℝ) + 1) := by
      rcases Nat.eq_zero_or_pos m with h | h
      · subst h; simp
      · exact Real.log_le_log (by exact_mod_cast h) (by linarith)
    linarith
  · have B : ∀ j : ℕ, ∀ S A : ℝ, 0 ≤ S → 0 ≤ A →
        S ^ (j + 1) + ((j : ℝ) + 1) * A * S ^ j ≤ (S + A) ^ (j + 1) := by
      intro j
      induction j with
      | zero => intro S A _ _; simp
      | succ j ih =>
        intro S A hS hA
        have h := mul_le_mul_of_nonneg_left (ih S A hS hA) (add_nonneg hS hA)
        have hnn : 0 ≤ ((j : ℝ) + 1) * A ^ 2 * S ^ j := by positivity
        push_cast
        calc S ^ (j + 1 + 1) + ((j : ℝ) + 1 + 1) * A * S ^ (j + 1)
            = (S + A) * (S ^ (j + 1) + ((j : ℝ) + 1) * A * S ^ j)
                - ((j : ℝ) + 1) * A ^ 2 * S ^ j := by ring
          _ ≤ (S + A) * (S + A) ^ (j + 1) - 0 := by linarith
          _ = (S + A) ^ (j + 1 + 1) := by ring
    intro s a
    induction s using Finset.induction_on with
    | empty =>
      intro k _
      cases k with
      | zero => simp
      | succ j =>
        rw [Finset.powersetCard_eq_empty.mpr (by simp)]
        simp
    | insert x s hx ih =>
      intro k ha
      have has : ∀ p ∈ s, 0 ≤ a p := fun p hp => ha p (Finset.mem_insert_of_mem hp)
      have hA : 0 ≤ a x := ha x (Finset.mem_insert_self x s)
      have hS : 0 ≤ ∑ p ∈ s, a p := Finset.sum_nonneg has
      rw [Finset.sum_insert hx]
      cases k with
      | zero => simp
      | succ j =>
        have hdisj : Disjoint (s.powersetCard (j + 1)) ((s.powersetCard j).image (insert x)) := by
          rw [Finset.disjoint_left]
          intro U hU hU'
          obtain ⟨V, _, rfl⟩ := Finset.mem_image.mp hU'
          exact hx ((Finset.mem_powersetCard.mp hU).1 (Finset.mem_insert_self x V))
        have hinj : Set.InjOn (insert x) (s.powersetCard j : Set (Finset ℕ)) := by
          intro V hV W hW hVW
          have hxV : x ∉ V := fun h => hx ((Finset.mem_powersetCard.mp hV).1 h)
          have hxW : x ∉ W := fun h => hx ((Finset.mem_powersetCard.mp hW).1 h)
          have := congrArg (fun T => Finset.erase T x) hVW
          simpa [Finset.erase_insert hxV, Finset.erase_insert hxW] using this
        rw [Finset.powersetCard_succ_insert hx, Finset.sum_union hdisj, Finset.sum_image hinj]
        have hprod : ∀ V ∈ s.powersetCard j, ∏ p ∈ insert x V, a p = a x * ∏ p ∈ V, a p := by
          intro V hV
          have hxV : x ∉ V := fun h => hx ((Finset.mem_powersetCard.mp hV).1 h)
          exact Finset.prod_insert hxV
        rw [Finset.sum_congr rfl hprod, ← Finset.mul_sum]
        have ih1 := ih (j + 1) has
        have ih0 := ih j has
        have hf : (0 : ℝ) < (j.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos j
        have hfac : (((j + 1).factorial : ℕ) : ℝ) = ((j : ℝ) + 1) * (j.factorial : ℝ) := by
          rw [Nat.factorial_succ]; push_cast; ring
        rw [hfac] at ih1 ⊢
        have hB := B j _ _ hS hA
        have h2 := mul_le_mul_of_nonneg_left ih0 hA
        have e : ((∑ p ∈ s, a p) ^ (j + 1) + ((j : ℝ) + 1) * a x * (∑ p ∈ s, a p) ^ j)
              / (((j : ℝ) + 1) * (j.factorial : ℝ))
            = (∑ p ∈ s, a p) ^ (j + 1) / (((j : ℝ) + 1) * (j.factorial : ℝ))
              + a x * ((∑ p ∈ s, a p) ^ j / (j.factorial : ℝ)) := by
          field_simp
        have key : (∑ U ∈ s.powersetCard (j + 1), ∏ p ∈ U, a p)
              + a x * (∑ U ∈ s.powersetCard j, ∏ p ∈ U, a p)
            ≤ ((∑ p ∈ s, a p) ^ (j + 1) + ((j : ℝ) + 1) * a x * (∑ p ∈ s, a p) ^ j)
              / (((j : ℝ) + 1) * (j.factorial : ℝ)) := by
          rw [e]; linarith
        refine key.trans ?_
        rw [add_comm (a x)]
        exact div_le_div_of_nonneg_right hB (by positivity)

theorem kai_coset_sieve_arith (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    (∀ (m : ℕ) (x : NumberField.RingOfIntegers K),
      CoprimeToNat (primorial m) x ↔
        ∀ p ∈ (Finset.range (m + 1)).filter Nat.Prime,
          ¬ ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧ x ∈ 𝔭.asIdeal) ∧
    (∀ (𝔠 : Ideal (NumberField.RingOfIntegers K)) (b : NumberField.RingOfIntegers K)
        (U : Finset ℕ) (z v : Fin (Module.finrank ℚ K) → ℤ),
      ((ω.equivFun.symm (z + ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℤ) • v) - b ∈ 𝔠 ∧
          ∀ p ∈ U, ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧
            ω.equivFun.symm (z + ((Ideal.absNorm 𝔠 * ∏ p ∈ U, p : ℕ) : ℤ) • v) ∈ 𝔭.asIdeal) ↔
        (ω.equivFun.symm z - b ∈ 𝔠 ∧
          ∀ p ∈ U, ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧
            ω.equivFun.symm z ∈ 𝔭.asIdeal))) :=
by
  classical
  refine ⟨fun m x => ⟨?_, ?_⟩, fun 𝔠 b U z v => ?_⟩
  · intro h p hp hex
    obtain ⟨𝔭, hp𝔭, hx𝔭⟩ := hex
    unfold CoprimeToNat at h
    have hdvd : p ∣ primorial m := by
      unfold primorial
      exact Finset.dvd_prod_of_mem (fun q => q) (by simpa using hp)
    have hmem : ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal :=
      Ideal.mem_of_dvd 𝔭.asIdeal (Nat.cast_dvd_cast hdvd) hp𝔭
    exact h 𝔭 hmem hx𝔭
  · intro H
    unfold CoprimeToNat
    intro 𝔭 hW hx
    haveI : 𝔭.asIdeal.IsPrime := 𝔭.isPrime
    unfold primorial at hW
    rw [Nat.cast_prod, Ideal.IsPrime.prod_mem_iff] at hW
    obtain ⟨p, hpP, hp𝔭⟩ := hW
    exact H p (by simpa using hpP) ⟨𝔭, hp𝔭, hx⟩
  · set Q : ℕ := Ideal.absNorm 𝔠 * ∏ p ∈ U, p with hQ
    have hx' : ω.equivFun.symm (z + (Q : ℤ) • v)
        = ω.equivFun.symm z + (Q : NumberField.RingOfIntegers K) * ω.equivFun.symm v := by
      rw [map_add, map_zsmul, zsmul_eq_mul, Int.cast_natCast]
    rw [hx']
    have h7 : (Q : NumberField.RingOfIntegers K) * ω.equivFun.symm v ∈ 𝔠 := by
      apply Ideal.mul_mem_right
      rw [hQ, Nat.cast_mul]
      exact Ideal.mul_mem_right _ _ (Ideal.absNorm_mem 𝔠)
    have h8 : ∀ p ∈ U, ∀ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal →
        (Q : NumberField.RingOfIntegers K) * ω.equivFun.symm v ∈ 𝔭.asIdeal := by
      intro p hp 𝔭 hp𝔭
      apply Ideal.mul_mem_right
      have hd : p ∣ Q := dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem (fun q => q) hp) _
      exact Ideal.mem_of_dvd _ (Nat.cast_dvd_cast hd) hp𝔭
    apply and_congr
    · rw [add_sub_right_comm]
      exact Ideal.add_mem_iff_left 𝔠 h7
    · apply forall₂_congr
      intro p hp
      constructor
      · rintro ⟨𝔭, hp𝔭, h⟩
        exact ⟨𝔭, hp𝔭, (Ideal.add_mem_iff_left _ (h8 p hp 𝔭 hp𝔭)).1 h⟩
      · rintro ⟨𝔭, hp𝔭, h⟩
        exact ⟨𝔭, hp𝔭, (Ideal.add_mem_iff_left _ (h8 p hp 𝔭 hp𝔭)).2 h⟩

theorem kai_coset_sieve_fundamental (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C c : ℝ, 0 ≤ C ∧ 0 < c ∧
      ∀ (M : ℝ) (m : ℕ), 3 ≤ M → (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
      ∀ (𝔠 : Ideal (NumberField.RingOfIntegers K)), 𝔠 ≠ ⊥ →
        (Ideal.absNorm 𝔠 : ℝ) ≤ Real.exp (2 * Real.log M ^ ((1:ℝ)/3)) →
        (∀ 𝔭 : Ideal (NumberField.RingOfIntegers K), 𝔭.IsPrime → 𝔠 ≤ 𝔭 →
            ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭) →
        (Ideal.absNorm 𝔠 : ℝ) / (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) : ℝ)
            ≤ (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ) ∧
        ∀ (b : NumberField.RingOfIntegers K), IsCoprime (Ideal.span {b}) 𝔠 →
        ∀ (u : Fin (Module.finrank ℚ K) → ℤ) (L : ℕ), (L : ℝ) ≤ 2 * M + 2 →
        ∀ (R : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet R → Convex ℝ R →
          R ⊆ {x | ∀ j, (u j : ℝ) ≤ x j ∧ x j ≤ (u j : ℝ) + L} →
          |∑ z ∈ @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
                (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ ω.equivFun.symm z - b ∈ 𝔠)
                (fun _ => Classical.propDecidable _) (Finset.Icc u (u + fun _ => (L : ℤ))),
              ((primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ)
                  * @ite ℝ (CoprimeToNat (primorial m) (ω.equivFun.symm z))
                      (Classical.propDecidable _) 1 0
                - (Ideal.absNorm 𝔠 : ℝ) / (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) : ℝ))|
            ≤ C * ((primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ))
                * (M ^ ((1:ℝ)/4) * ((L : ℝ) + M ^ ((1:ℝ)/4)) ^ (Module.finrank ℚ K - 1)
                    + (MeasureTheory.volume R).toReal * Real.exp (-(c * Real.log M ^ ((2:ℝ)/3)))) :=
by
  classical
  have hn : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  obtain ⟨C₁, hC₁, hPB⟩ := kai_periodic_box_count (Module.finrank ℚ K) hn
  obtain ⟨ℓ₀, hℓ₀, hNum⟩ := kai_sieve_level_numerics (Module.finrank ℚ K) hn
  obtain ⟨hφc, hφW, hdens⟩ := kai_coset_coprime_density K ω
  obtain ⟨hcop_iff, hper⟩ := kai_coset_sieve_arith K ω
  obtain ⟨hs8a, hs8b, hs8c, hs8d⟩ := kai_prime_powerset_bounds
  have hfib := kai_resBox_fiber_count K ω
  have hbad := kai_coset_bad_density_bound K ω
  have h3pos : (0:ℝ) ≤ 3 ^ (Module.finrank ℚ K - 1) := by positivity
  refine ⟨2 * 3 ^ (Module.finrank ℚ K - 1) * C₁ + 2 * Real.exp ℓ₀ + 3, 1 / 16,
    by positivity, by norm_num, ?_⟩
  intro M m hM hm 𝔠 h𝔠 hN𝔠 hprim
  
  have hMpos : (0:ℝ) < M := by linarith
  have hNc1 : 1 ≤ Ideal.absNorm 𝔠 :=
    Nat.pos_of_ne_zero (fun h => h𝔠 (Ideal.absNorm_eq_zero_iff.mp h))
  have hNc1r : (1:ℝ) ≤ (Ideal.absNorm 𝔠 : ℝ) := by exact_mod_cast hNc1
  have hW1 : 1 ≤ primorial m := primorial_pos m
  have hW1r : (1:ℝ) ≤ (primorial m : ℝ) := by exact_mod_cast hW1
  have hφc1 : (1:ℝ) ≤ (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) : ℝ) := by
    exact_mod_cast hφc 𝔠 h𝔠
  have hφW1 : (1:ℝ) ≤ (phiK K (primorial m) : ℝ) := by exact_mod_cast hφW _ hW1
  have hNmem : ((Ideal.absNorm 𝔠 : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔠 := Ideal.absNorm_mem 𝔠
  have hQmem : ((Ideal.absNorm 𝔠 * primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔠 := by
    rw [Nat.cast_mul]; exact Ideal.mul_mem_right _ _ hNmem
  have hQ1 : 1 ≤ Ideal.absNorm 𝔠 * primorial m := Nat.one_le_iff_ne_zero.mpr (by positivity)
  have hQpos : (0:ℝ) < ((Ideal.absNorm 𝔠 * primorial m : ℕ) : ℝ) ^ Module.finrank ℚ K := by
    have : (1:ℝ) ≤ ((Ideal.absNorm 𝔠 * primorial m : ℕ) : ℝ) := by exact_mod_cast hQ1
    positivity
  
  have hmain : ∀ b : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {b}) 𝔠 →
      ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧ CoprimeToNat (primorial m) (ω.equivFun.symm z))
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * primorial m))).card : ℝ)
        * ((primorial m : ℝ) ^ Module.finrank ℚ K
            * (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) : ℝ))
        = ((Ideal.absNorm 𝔠 * primorial m : ℕ) : ℝ) ^ Module.finrank ℚ K
            * (phiK K (primorial m) : ℝ) ∧
      ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠 ∧ CoprimeToNat (primorial m) (ω.equivFun.symm z))
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * primorial m))).card : ℝ)
        ≤ ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠)
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * primorial m))).card : ℝ) ∧
      ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
          (fun z => ω.equivFun.symm z - b ∈ 𝔠)
          (fun _ => Classical.propDecidable _)
          (resBox (Module.finrank ℚ K) (Ideal.absNorm 𝔠 * primorial m))).card : ℝ)
        * (Ideal.absNorm 𝔠 : ℝ)
        = ((Ideal.absNorm 𝔠 * primorial m : ℕ) : ℝ) ^ Module.finrank ℚ K := by
    intro b hb
    refine ⟨hdens 𝔠 b (primorial m) h𝔠 hW1 hprim hb, Nat.cast_le.mpr (Finset.card_le_card ?_),
      hfib 𝔠 b _ hQ1 hQmem⟩
    intro z hz
    simp only [Finset.mem_filter] at hz ⊢
    exact ⟨hz.1, hz.2.1⟩
  set κW : ℝ := (primorial m : ℝ) ^ Module.finrank ℚ K / (phiK K (primorial m) : ℝ) with hκW
  set κc : ℝ := (Ideal.absNorm 𝔠 : ℝ) / (Nat.card ((NumberField.RingOfIntegers K ⧸ 𝔠)ˣ) : ℝ)
    with hκc
  have hκW0 : 0 ≤ κW := by positivity
  have hκc0 : 0 ≤ κc := by positivity
  have hcoprime1 : IsCoprime (Ideal.span {(1 : NumberField.RingOfIntegers K)}) 𝔠 := by
    rw [Ideal.span_singleton_one, ← Ideal.one_eq_top]; exact isCoprime_one_left
  have key_ineq : ∀ (cnt y N Wn φc φW Qn : ℝ), 0 < Qn → 0 < N → 0 < φc → 0 < φW → 0 ≤ Wn →
      cnt * (Wn * φc) = Qn * φW → cnt ≤ y → y * N = Qn → N / φc ≤ Wn / φW := by
    intro cnt y N Wn φc φW Qn hQ hN hc hW hWn h1 h2 h3
    rw [div_le_div_iff₀ hc hW]
    have h5 : cnt * (Wn * φc) * N ≤ y * (Wn * φc) * N := by
      apply mul_le_mul_of_nonneg_right _ hN.le
      exact mul_le_mul_of_nonneg_right h2 (mul_nonneg hWn hc.le)
    have h4 : Qn * (N * φW) ≤ Qn * (Wn * φc) := by
      calc Qn * (N * φW) = cnt * (Wn * φc) * N := by rw [h1]; ring
        _ ≤ y * (Wn * φc) * N := h5
        _ = Qn * (Wn * φc) := by rw [← h3]; ring
    exact le_of_mul_le_mul_left h4 hQ
  
  have hκle : κc ≤ κW := by
    obtain ⟨h1, h2, h3⟩ := hmain 1 hcoprime1
    exact key_ineq _ _ _ _ _ _ _ hQpos (by linarith) (by linarith) (by linarith) (by positivity)
      h1 h2 h3
  refine ⟨hκle, ?_⟩
  intro b hb u L hL R hRm hRc hRsub
  obtain ⟨hm1', hm2', hm3'⟩ := hmain b hb
  set V : ℝ := (MeasureTheory.volume R).toReal with hV
  have hV0 : 0 ≤ V := ENNReal.toReal_nonneg
  set η : ℝ := Real.exp (-(1 / 16 * Real.log M ^ ((2:ℝ)/3))) with hη
  have hη0 : 0 ≤ η := (Real.exp_pos _).le
  set A : ℝ := M ^ ((1:ℝ)/4) * ((L : ℝ) + M ^ ((1:ℝ)/4)) ^ (Module.finrank ℚ K - 1) with hA
  have hM14 : 1 ≤ M ^ ((1:ℝ)/4) := Real.one_le_rpow (by linarith) (by norm_num)
  have hL0 : (0:ℝ) ≤ (L : ℝ) := Nat.cast_nonneg L
  have hA0 : 0 ≤ A := mul_nonneg (by linarith) (pow_nonneg (by linarith) _)
  set SS := @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
      (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ R ∧ ω.equivFun.symm z - b ∈ 𝔠)
      (fun _ => Classical.propDecidable _) (Finset.Icc u (u + fun _ => (L : ℤ))) with hSS
  obtain ⟨P, hP⟩ : ∃ P : Finset ℕ, P = (Finset.range (m + 1)).filter Nat.Prime := ⟨_, rfl⟩
  have hWP : primorial m = ∏ p ∈ P, p := by rw [hP]; rfl
  have hPprime : ∀ p ∈ P, p.Prime := by
    intro p hp; rw [hP] at hp; exact (Finset.mem_filter.mp hp).2
  obtain ⟨T, hT⟩ : ∃ T : (Fin (Module.finrank ℚ K) → ℤ) → Finset ℕ, T = fun z =>
      @Finset.filter ℕ (fun p => ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers K),
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧ ω.equivFun.symm z ∈ 𝔭.asIdeal)
        (fun _ => Classical.propDecidable _) P := ⟨_, rfl⟩
  have hTP : ∀ z, T z ⊆ P := by intro z; rw [hT]; exact Finset.filter_subset _ _
  have hTempty : ∀ z, T z = ∅ ↔ CoprimeToNat (primorial m) (ω.equivFun.symm z) := by
    intro z
    rw [hcop_iff m, ← hP, hT]
    exact Finset.filter_eq_empty_iff
  have hTsub : ∀ U : Finset ℕ, U ⊆ P → ∀ z, (U ⊆ T z ↔ ∀ p ∈ U,
      ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ((p : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧
        ω.equivFun.symm z ∈ 𝔭.asIdeal) := by
    intro U hU z
    rw [hT]
    constructor
    · intro h p hp; exact (Finset.mem_filter.mp (h hp)).2
    · intro h p hp; exact Finset.mem_filter.mpr ⟨hU hp, h p hp⟩
  
  have hite : ∑ z ∈ SS, @ite ℝ (CoprimeToNat (primorial m) (ω.equivFun.symm z))
        (Classical.propDecidable _) 1 0 = ((SS.filter (fun z => T z = ∅)).card : ℝ) := by
    rw [Finset.card_filter (fun z => T z = ∅) SS]
    push_cast
    apply Finset.sum_congr rfl
    intro z _
    by_cases h : CoprimeToNat (primorial m) (ω.equivFun.symm z)
    · rw [if_pos h, if_pos ((hTempty z).mpr h)]
    · rw [if_neg h, if_neg (fun h' => h ((hTempty z).mp h'))]
  have hsum : ∑ z ∈ SS, (κW * @ite ℝ (CoprimeToNat (primorial m) (ω.equivFun.symm z))
        (Classical.propDecidable _) 1 0 - κc)
      = κW * ((SS.filter (fun z => T z = ∅)).card : ℝ) - κc * (SS.card : ℝ) := by
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, hite, Finset.sum_const, nsmul_eq_mul]
    ring
  rw [hsum]
  have hcS0 : (0:ℝ) ≤ ((SS.filter (fun z => T z = ∅)).card : ℝ) := Nat.cast_nonneg _
  have hcSle : ((SS.filter (fun z => T z = ∅)).card : ℝ) ≤ (SS.card : ℝ) := by
    exact_mod_cast Finset.card_filter_le _ _
  have hSS0 : (0:ℝ) ≤ (SS.card : ℝ) := Nat.cast_nonneg _
  by_cases hlarge : ℓ₀ ≤ Real.log M
  swap
  · 
    push_neg at hlarge
    have hMlt : M < Real.exp ℓ₀ := by
      rw [← Real.exp_log hMpos]; exact Real.exp_lt_exp.mpr hlarge
    have habs : |κW * ((SS.filter (fun z => T z = ∅)).card : ℝ) - κc * (SS.card : ℝ)|
        ≤ κW * (SS.card : ℝ) := by
      rw [abs_le]; constructor
      · nlinarith [mul_le_mul_of_nonneg_right hκle hSS0, mul_nonneg hκW0 hcS0]
      · nlinarith [mul_le_mul_of_nonneg_left hcSle hκW0, mul_nonneg hκc0 hSS0]
    have hcardSS : (SS.card : ℝ) ≤ ((L:ℝ) + 1) ^ Module.finrank ℚ K := by
      have h1 : SS.card ≤ (Finset.Icc u (u + fun _ => (L : ℤ))).card := by
        apply Finset.card_le_card
        intro z hz
        simp only [hSS, Finset.mem_filter] at hz
        exact hz.1
      have h2 : (Finset.Icc u (u + fun _ => (L : ℤ))).card = (L + 1) ^ Module.finrank ℚ K := by
        rw [Pi.card_Icc]
        simp only [Pi.add_apply, Int.card_Icc]
        have h3 : ∀ i, (u i + (L:ℤ) + 1 - u i).toNat = L + 1 := fun i => by omega
        simp only [h3, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      rw [h2] at h1
      calc (SS.card : ℝ) ≤ (((L + 1) ^ Module.finrank ℚ K : ℕ) : ℝ) := by exact_mod_cast h1
        _ = _ := by push_cast; ring
    have hpow : ((L:ℝ) + 1) ^ Module.finrank ℚ K ≤ (2 * Real.exp ℓ₀ + 3) * A := by
