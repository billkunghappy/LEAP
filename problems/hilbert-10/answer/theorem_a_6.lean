  have hwpos : ∀ T ⊆ Pp, 0 < ∏ p ∈ T, c / (p : ℝ) := fun T hT =>
    Finset.prod_pos (fun p hp => div_pos hc (by exact_mod_cast (hprime p (hT hp)).pos))
  have hprod1 : (1:ℝ) ≤ ∏ p ∈ Pp, (1 + c / (p : ℝ)) := by
    calc (1:ℝ) = ∏ p ∈ Pp, (1:ℝ) := Finset.prod_const_one.symm
      _ ≤ ∏ p ∈ Pp, (1 + c / (p : ℝ)) :=
        Finset.prod_le_prod (fun _ _ => zero_le_one)
          (fun p _ => by
            have : 0 ≤ c / (p:ℝ) := div_nonneg hc.le (Nat.cast_nonneg p)
            linarith)
  have hH1 : (1:ℝ) ≤ H := hprod1.trans hH
  have hHpos : (0:ℝ) < H := by linarith
  have hD1 : 1 ≤ D := by
    have h := hD ∅ (Finset.empty_mem_powerset Pp) (by simp)
    rwa [Finset.prod_empty] at h
  have hDr : (1:ℝ) ≤ D := by exact_mod_cast hD1
  have hQr : (1:ℝ) ≤ Q₀ := by exact_mod_cast hQ1
  obtain ⟨-, hDQ, hδW0, hδW1, hT01, hfin⟩ := kai_typeI_param_bounds ν c Cw Aw hc hCw hAw
    H Q₀ D η N hH1 hQr hDr hη hη1 hsize
  have hsumw : ∑ T ∈ Pp.powerset, ∏ p ∈ T, c / (p : ℝ) = ∏ p ∈ Pp, (1 + c / (p : ℝ)) :=
    (Finset.prod_one_add Pp).symm
  have hgiE : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t; unfold giE; rw [Complex.norm_exp]; simp
  set B : ℝ := ((2 * N + 1 : ℕ) : ℝ) ^ ν with hB
  have hB0 : 0 < B := by rw [hB]; positivity
  set δ : ℝ := η / (2 * H) with hδ
  have hδ0 : 0 < δ := div_pos hη (by linarith)
  obtain ⟨ST, hST⟩ : ∃ ST : Finset ℕ → ℂ, ∀ T, ST T = ∑ z ∈ @Finset.filter (Fin ν → ℤ)
      (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ T, F p z))
      (fun _ => Classical.propDecidable _) (intBox ν N), giE (kaiQuadPoly p₀ p₁ p₂ z) :=
    ⟨_, fun _ => rfl⟩
  have hmain' : η * B ≤ ∑ T ∈ Pp.powerset.filter (fun T => T.card ≤ k), ‖ST T‖ := by
    simp only [hST]; exact hmain
  
  have htriv : ∀ T ∈ Pp.powerset.filter (fun T => T.card ≤ k),
      ‖ST T‖ ≤ 2 ^ ν * B * ∏ p ∈ T, c / (p : ℝ) := by
    intro T hT
    rw [Finset.mem_filter] at hT
    rw [hST]
    refine (norm_sum_le _ _).trans ?_
    simp only [hgiE, Finset.sum_const, nsmul_eq_mul, mul_one]
    refine le_trans ?_ (hbox T hT.1 hT.2)
    exact_mod_cast Finset.card_le_card (fun z hz => by
      simp only [Finset.mem_filter] at hz ⊢
      exact ⟨hz.1, hz.2.2.2⟩)
  obtain ⟨Gs, hGs⟩ : ∃ Gs : Finset (Finset ℕ),
      Gs = (Pp.powerset.filter (fun T => T.card ≤ k)).filter
        (fun T : Finset ℕ => δ * B * ∏ p ∈ T, c / (p : ℝ) ≤ ‖ST T‖) := ⟨_, rfl⟩
  have hGsub : Gs ⊆ Pp.powerset := by
    intro T hT; rw [hGs, Finset.mem_filter, Finset.mem_filter] at hT; exact hT.1.1
  have hGmem : ∀ T ∈ Gs, T ⊆ Pp ∧ T.card ≤ k ∧ δ * B * ∏ p ∈ T, c / (p : ℝ) ≤ ‖ST T‖ := by
    intro T hT
    rw [hGs, Finset.mem_filter, Finset.mem_filter, Finset.mem_powerset] at hT
    exact ⟨hT.1.1, hT.1.2, hT.2⟩
  have hbad : ∑ T ∈ (Pp.powerset.filter (fun T => T.card ≤ k)).filter
      (fun T : Finset ℕ => ¬ (δ * B * ∏ p ∈ T, c / (p : ℝ) ≤ ‖ST T‖)), ‖ST T‖ ≤ η * B / 2 := by
    calc _ ≤ ∑ T ∈ (Pp.powerset.filter (fun T => T.card ≤ k)).filter
          (fun T : Finset ℕ => ¬ (δ * B * ∏ p ∈ T, c / (p : ℝ) ≤ ‖ST T‖)), δ * B * ∏ p ∈ T, c / (p : ℝ) :=
          Finset.sum_le_sum (fun T hT => (not_le.mp (Finset.mem_filter.mp hT).2).le)
      _ ≤ ∑ T ∈ Pp.powerset, δ * B * ∏ p ∈ T, c / (p : ℝ) :=
          Finset.sum_le_sum_of_subset_of_nonneg
            (fun T hT => (Finset.mem_filter.mp (Finset.mem_filter.mp hT).1).1)
            (fun T _ _ => mul_nonneg (mul_nonneg hδ0.le hB0.le) (hwnn T))
      _ = δ * B * ∏ p ∈ Pp, (1 + c / (p : ℝ)) := by rw [← Finset.mul_sum, hsumw]
      _ ≤ δ * B * H := mul_le_mul_of_nonneg_left hH (mul_nonneg hδ0.le hB0.le)
      _ = η * B / 2 := by rw [hδ]; field_simp
  have hsplit := Finset.sum_filter_add_sum_filter_not (Pp.powerset.filter (fun T => T.card ≤ k))
    (fun T : Finset ℕ => δ * B * ∏ p ∈ T, c / (p : ℝ) ≤ ‖ST T‖) (fun T => ‖ST T‖)
  rw [← hGs] at hsplit
  have hgoodsum : η * B / 2 ≤ ∑ T ∈ Gs, ‖ST T‖ := by linarith
  have hgoodle : ∑ T ∈ Gs, ‖ST T‖ ≤ 2 ^ ν * B * ∑ T ∈ Gs, ∏ p ∈ T, c / (p : ℝ) := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum (fun T hT =>
      htriv T (by rw [hGs] at hT; exact (Finset.mem_filter.mp hT).1))
  have hμ : η / 2 ^ (ν + 1) ≤ ∑ T ∈ Gs, ∏ p ∈ T, c / (p : ℝ) := by
    rw [div_le_iff₀ (by positivity)]
    have h1 : η * B ≤ (∑ T ∈ Gs, ∏ p ∈ T, c / (p : ℝ)) * 2 ^ (ν + 1) * B := by
      rw [pow_succ]; linarith [hgoodsum, hgoodle]
    exact le_of_mul_le_mul_right h1 hB0
  
  obtain ⟨T₁, hT₁, T₂, hT₂, hgcd⟩ := kai_prime_pair_small_gcd Pp hprime c H hc.le hH Gs
    (η / 2 ^ (ν + 1)) hGsub (div_pos hη (by positivity)) hμ
  
  have hcoset : ∀ T ∈ Gs, ∀ L : ℕ, (∏ p ∈ T, p) ∣ L → Q₀ ∣ L → 1 ≤ L → L ≤ N →
      ∃ (r : Fin ν → ℤ) (q : ℕ), (∀ l, 0 ≤ r l ∧ r l < (L : ℤ)) ∧
        (q : ℝ) ≤ (Cw / (η * (2 / 5 : ℝ) ^ ν / (2 * H))) ^ Aw ∧
        KaiQuadMajor ν (N / L + 1) q ((Cw / (η * (2 / 5 : ℝ) ^ ν / (2 * H))) ^ Aw)
          (fun w => kaiQuadPoly p₀ p₁ p₂ (fun l => r l + (L : ℤ) * w l)) := by
    intro T hT L hdL hQL hL1 hLN
    obtain ⟨hTsub, hTk, hgood⟩ := hGmem T hT
    have hLpos : (0:ℝ) < L := by exact_mod_cast hL1
    have hA : ∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (L : ℤ)]) →
        ((Cq z ∧ ∀ p ∈ T, F p z) ↔ (Cq w ∧ ∀ p ∈ T, F p w)) := by
      intro z w hzw
      have hQ : Cq z ↔ Cq w :=
        hCq z w (fun l => Int.ModEq.of_dvd (Int.natCast_dvd_natCast.mpr hQL) (hzw l))
      have hp : ∀ p ∈ T, (F p z ↔ F p w) := fun p hp =>
        hF p (hTsub hp) z w (fun l => Int.ModEq.of_dvd
          (Int.natCast_dvd_natCast.mpr ((Finset.dvd_prod_of_mem (fun p => p) hp).trans hdL))
          (hzw l))
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨hQ.mp h1, fun p hp' => (hp p hp').mp (h2 p hp')⟩
      · rintro ⟨h1, h2⟩; exact ⟨hQ.mpr h1, fun p hp' => (hp p hp').mpr (h2 p hp')⟩
    obtain ⟨hdec, hconv⟩ := kai_box_residue_decomp ν N L hL1 Ω
      (fun z => Cq z ∧ ∀ p ∈ T, F p z) hA (fun z => giE (kaiQuadPoly p₀ p₁ p₂ z))
    obtain ⟨S, hS⟩ : ∃ S : (Fin ν → ℤ) → ℂ, S = fun r => ∑ w ∈ @Finset.filter (Fin ν → ℤ)
              (fun w => (fun j => ((w j : ℤ) : ℝ)) ∈
                {u : Fin ν → ℝ | (fun j => (r j : ℝ) + (L : ℝ) * u j) ∈ Ω ∧
                  ∀ j, |(r j : ℝ) + (L : ℝ) * u j| ≤ (N : ℝ)})
              (fun _ => Classical.propDecidable _) (intBox ν (N / L + 1)),
            giE (kaiQuadPoly p₀ p₁ p₂ (fun j => r j + (L : ℤ) * w j)) := ⟨_, rfl⟩
    obtain ⟨I, hI⟩ : ∃ I : Finset (Fin ν → ℤ), I = @Finset.filter (Fin ν → ℤ)
        (fun z => Cq z ∧ ∀ p ∈ T, F p z) (fun _ => Classical.propDecidable _) (resBox ν L) :=
      ⟨_, rfl⟩
    have hdec' : ST T = ∑ r ∈ I, S r := by
      rw [hST, hdec, hI, hS]
    have hcard : (I.card : ℝ) ≤ (L : ℝ) ^ ν * ∏ p ∈ T, c / (p : ℝ) := by
      refine le_trans ?_ (hres T (Finset.mem_powerset.mpr hTsub) hTk L hdL hL1)
      rw [hI]
      exact_mod_cast Finset.card_le_card (fun z hz => by
        simp only [Finset.mem_filter] at hz ⊢
        exact ⟨hz.1, hz.2.2⟩)
    have hgoodpos : 0 < δ * B * ∏ p ∈ T, c / (p : ℝ) :=
      mul_pos (mul_pos hδ0 hB0) (hwpos T hTsub)
    have hLν : (0:ℝ) < (L : ℝ) ^ ν := pow_pos hLpos ν
    have hpig : ∃ r ∈ I, δ * B / (L : ℝ) ^ ν ≤ ‖S r‖ := by
      by_contra hcon
      push_neg at hcon
      have hTT : ‖ST T‖ ≤ ∑ r ∈ I, ‖S r‖ := by rw [hdec']; exact norm_sum_le _ _
      rcases I.eq_empty_or_nonempty with hIe | hIne
      · rw [hIe, Finset.sum_empty] at hTT
        linarith
      · have h1 : ∑ r ∈ I, ‖S r‖ < ∑ r ∈ I, δ * B / (L : ℝ) ^ ν :=
          Finset.sum_lt_sum_of_nonempty hIne hcon
        rw [Finset.sum_const, nsmul_eq_mul] at h1
        have h2 : (I.card : ℝ) * (δ * B / (L : ℝ) ^ ν) ≤ δ * B * ∏ p ∈ T, c / (p : ℝ) := by
          calc (I.card : ℝ) * (δ * B / (L : ℝ) ^ ν)
              ≤ ((L : ℝ) ^ ν * ∏ p ∈ T, c / (p : ℝ)) * (δ * B / (L : ℝ) ^ ν) :=
                mul_le_mul_of_nonneg_right hcard
                  (div_nonneg (mul_nonneg hδ0.le hB0.le) hLν.le)
            _ = δ * B * ∏ p ∈ T, c / (p : ℝ) := by field_simp
        linarith
    obtain ⟨r, hrI, hrS⟩ := hpig
    have hm : ((N / L : ℕ) : ℝ) * L ≤ N := by exact_mod_cast Nat.div_mul_le_self N L
    have hLN' : (L : ℝ) ≤ N := by exact_mod_cast hLN
    have hden : (2 / 5 : ℝ) * ((2 * (N / L + 1) + 1 : ℕ) : ℝ) ≤ ((2 * N + 1 : ℕ) : ℝ) / L := by
      rw [le_div_iff₀ hLpos]
      push_cast
      linarith [hm, hLN']
    have hdens : η * (2 / 5 : ℝ) ^ ν / (2 * H) * (((2 * (N / L + 1) + 1 : ℕ) : ℝ) ^ ν)
        ≤ ‖S r‖ := by
      have h1 : ((2 / 5 : ℝ) * ((2 * (N / L + 1) + 1 : ℕ) : ℝ)) ^ ν
          ≤ (((2 * N + 1 : ℕ) : ℝ) / L) ^ ν :=
        pow_le_pow_left₀ (by positivity) hden ν
      rw [mul_pow, div_pow (((2 * N + 1 : ℕ) : ℝ)) (L : ℝ)] at h1
      refine le_trans ?_ hrS
      calc η * (2 / 5 : ℝ) ^ ν / (2 * H) * (((2 * (N / L + 1) + 1 : ℕ) : ℝ) ^ ν)
          = δ * ((2 / 5 : ℝ) ^ ν * ((2 * (N / L + 1) + 1 : ℕ) : ℝ) ^ ν) := by rw [hδ]; ring
        _ ≤ δ * (((2 * N + 1 : ℕ) : ℝ) ^ ν / (L : ℝ) ^ ν) :=
            mul_le_mul_of_nonneg_left h1 hδ0.le
        _ = δ * B / (L : ℝ) ^ ν := by rw [hB]; ring
    have hS' : S r = ∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈
          {u : Fin ν → ℝ | (fun j => (r j : ℝ) + (L : ℝ) * u j) ∈ Ω ∧
                  ∀ j, |(r j : ℝ) + (L : ℝ) * u j| ≤ (N : ℝ)})
          (fun _ => Classical.propDecidable _) (intBox ν (N / L + 1)),
        giE (kaiQuadPoly (kaiQuadPoly p₀ p₁ p₂ r)
          (fun l => (L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)))
          (fun l l' => (L : ℝ) ^ 2 * p₂ l l') z) := by
      rw [hS]
      exact Finset.sum_congr rfl (fun w _ => congrArg giE (kai_quad_poly_affine_subst p₀ p₁ p₂ L r w))
    rw [hS'] at hdens
    obtain ⟨q, hqT, hmaj⟩ := hW (N / L + 1) (η * (2 / 5 : ℝ) ^ ν / (2 * H)) (Nat.le_add_left 1 _)
      hδW0 hδW1 _ (hconv r hΩ) _ _ _ hdens
    have hfun : (kaiQuadPoly (kaiQuadPoly p₀ p₁ p₂ r)
          (fun l => (L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)))
          (fun l l' => (L : ℝ) ^ 2 * p₂ l l')) =
        (fun w => kaiQuadPoly p₀ p₁ p₂ (fun l => r l + (L : ℤ) * w l)) :=
      funext (fun w => (kai_quad_poly_affine_subst p₀ p₁ p₂ L r w).symm)
    rw [hfun] at hmaj
    have hr : r ∈ resBox ν L := by
      rw [hI] at hrI
      exact ((@Finset.mem_filter _ (fun z => Cq z ∧ ∀ p ∈ T, F p z)
        (fun _ => Classical.propDecidable _) (resBox ν L) r).mp hrI).1
    refine ⟨r, q, fun l => ?_, hqT, hmaj⟩
    simp only [resBox, Finset.mem_Icc] at hr
    have h1 : (0:ℤ) ≤ r l := hr.1 l
    have h2 : r l ≤ (L:ℤ) - 1 := hr.2 l
    constructor <;> omega
  
  obtain ⟨hT₁sub, hT₁k, -⟩ := hGmem T₁ hT₁
  obtain ⟨hT₂sub, hT₂k, -⟩ := hGmem T₂ hT₂
  have hd₁pos : 0 < ∏ p ∈ T₁, p := Finset.prod_pos (fun p hp => (hprime p (hT₁sub hp)).pos)
  have hd₂pos : 0 < ∏ p ∈ T₂, p := Finset.prod_pos (fun p hp => (hprime p (hT₂sub hp)).pos)
  have hQpos : 0 < Q₀ := by omega
  have hd₁D : ∏ p ∈ T₁, p ≤ D := hD T₁ (Finset.mem_powerset.mpr hT₁sub) hT₁k
  have hd₂D : ∏ p ∈ T₂, p ≤ D := hD T₂ (Finset.mem_powerset.mpr hT₂sub) hT₂k
  obtain ⟨L₁, hL₁def⟩ : ∃ L : ℕ, L = Nat.lcm (∏ p ∈ T₁, p) Q₀ := ⟨_, rfl⟩
  obtain ⟨L₂, hL₂def⟩ : ∃ L : ℕ, L = Nat.lcm (∏ p ∈ T₂, p) Q₀ := ⟨_, rfl⟩
  have hL₁pos : 0 < L₁ := by rw [hL₁def]; exact Nat.lcm_pos hd₁pos hQpos
  have hL₂pos : 0 < L₂ := by rw [hL₂def]; exact Nat.lcm_pos hd₂pos hQpos
  have hL₁dvd : L₁ ∣ (∏ p ∈ T₁, p) * Q₀ := by rw [hL₁def]; exact Nat.lcm_dvd_mul _ _
  have hL₂dvd : L₂ ∣ (∏ p ∈ T₂, p) * Q₀ := by rw [hL₂def]; exact Nat.lcm_dvd_mul _ _
  have hL₁le : L₁ ≤ D * Q₀ :=
    (Nat.le_of_dvd (Nat.mul_pos hd₁pos hQpos) hL₁dvd).trans (Nat.mul_le_mul hd₁D le_rfl)
  have hL₂le : L₂ ≤ D * Q₀ :=
    (Nat.le_of_dvd (Nat.mul_pos hd₂pos hQpos) hL₂dvd).trans (Nat.mul_le_mul hd₂D le_rfl)
  have hL₁r : (L₁ : ℝ) ≤ (D : ℝ) * Q₀ := by exact_mod_cast hL₁le
  have hL₂r : (L₂ : ℝ) ≤ (D : ℝ) * Q₀ := by exact_mod_cast hL₂le
  have hL₁N : L₁ ≤ N := by exact_mod_cast hL₁r.trans hDQ
  have hL₂N : L₂ ≤ N := by exact_mod_cast hL₂r.trans hDQ
  have hG : Nat.gcd L₁ L₂ ≤ Nat.gcd (∏ p ∈ T₁, p) (∏ p ∈ T₂, p) * Q₀ := by
    apply Nat.le_of_dvd (Nat.mul_pos (Nat.gcd_pos_of_pos_left _ hd₁pos) hQpos)
    rw [← Nat.gcd_mul_right]
    exact Nat.dvd_gcd ((Nat.gcd_dvd_left _ _).trans hL₁dvd)
      ((Nat.gcd_dvd_right _ _).trans hL₂dvd)
  obtain ⟨r₁, q₁, hr₁, hq₁T, hmaj₁⟩ := hcoset T₁ hT₁ L₁
    (by rw [hL₁def]; exact Nat.dvd_lcm_left _ _) (by rw [hL₁def]; exact Nat.dvd_lcm_right _ _)
    hL₁pos hL₁N
  obtain ⟨r₂, q₂, hr₂, hq₂T, hmaj₂⟩ := hcoset T₂ hT₂ L₂
    (by rw [hL₂def]; exact Nat.dvd_lcm_left _ _) (by rw [hL₂def]; exact Nat.dvd_lcm_right _ _)
    hL₂pos hL₂N
  have hq₁1 : (1:ℝ) ≤ q₁ := by exact_mod_cast hmaj₁.1
  have hq₂1 : (1:ℝ) ≤ q₂ := by exact_mod_cast hmaj₂.1
  obtain ⟨hsmall, hqC, hTC⟩ := hfin q₁ q₂ L₁ L₂ (Nat.gcd (∏ p ∈ T₁, p) (∏ p ∈ T₂, p))
    (Nat.gcd L₁ L₂) hq₁1 hq₁T hq₂1 hq₂T (by exact_mod_cast hL₁pos) hL₁r
    (by exact_mod_cast hL₂pos) hL₂r (Nat.cast_nonneg _) hgcd (Nat.cast_nonneg _)
    (by exact_mod_cast hG)
  have hNL : ∀ L : ℕ, 0 < L → (N : ℝ) ≤ (L : ℝ) * ((N / L + 1 : ℕ) : ℝ) := by
    intro L hL
    have h := Nat.lt_div_mul_add (a := N) hL
    have h' : (N : ℝ) < ((N / L : ℕ) : ℝ) * L + L := by exact_mod_cast h
    push_cast
    linarith [h']
  have hlift := kai_quad_major_lift_two_cosets ν N hN1 p₀ p₁ p₂ L₁ L₂ (N / L₁ + 1) (N / L₂ + 1)
    q₁ q₂ r₁ r₂ ((Cw / (η * (2 / 5 : ℝ) ^ ν / (2 * H))) ^ Aw) hL₁pos hL₂pos hL₁N hL₂N
    (hNL L₁ hL₁pos) (hNL L₂ hL₂pos) hr₁ hr₂ (by linarith) hmaj₁ hmaj₂ hsmall
  
  refine ⟨2 * q₁ * q₂ * (Nat.gcd L₁ L₂) ^ 3, by exact_mod_cast hqC, ?_⟩
  obtain ⟨hq1, γ, b, a, η', θ, h1, h2, h3⟩ := hlift
  refine ⟨hq1, γ, b, a, η', θ, fun l => (h1 l).trans ?_, fun l l' => (h2 l l').trans ?_, h3⟩
  · exact div_le_div_of_nonneg_right (by exact_mod_cast hTC) (by positivity)
  · exact div_le_div_of_nonneg_right (by exact_mod_cast hTC) (by positivity)

theorem kai_pure_sieve_bound (ν N k : ℕ) (c : ℝ) (hc : 0 ≤ c) (Pp : Finset ℕ)
    (Ω : Set (Fin ν → ℝ)) (Cq : (Fin ν → ℤ) → Prop) (F : ℕ → (Fin ν → ℤ) → Prop)
    (g : (Fin ν → ℤ) → ℂ) (hg : ∀ z, ‖g z‖ ≤ 1)
    (hbox : ∀ T ∈ Pp.powerset, T.card = k →
      ((@Finset.filter (Fin ν → ℤ) (fun z => ∀ p ∈ T, F p z)
          (fun _ => Classical.propDecidable _) (intBox ν N)).card : ℝ)
        ≤ 2 ^ ν * ((2 * N + 1 : ℕ) : ℝ) ^ ν * ∏ p ∈ T, (c / (p : ℝ))) :
    ‖∑ z ∈ @Finset.filter (Fin ν → ℤ)
          (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ Pp, ¬ F p z))
          (fun _ => Classical.propDecidable _) (intBox ν N), g z‖
      ≤ ∑ T ∈ Pp.powerset.filter (fun T => T.card ≤ k),
          ‖∑ z ∈ @Finset.filter (Fin ν → ℤ)
              (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ T, F p z))
              (fun _ => Classical.propDecidable _) (intBox ν N), g z‖
        + 2 ^ ν * ((2 * N + 1 : ℕ) : ℝ) ^ ν
          * ((1 / 2 : ℝ) ^ k * (∏ p ∈ Pp, (1 + c / (p : ℝ))) ^ 2) :=
by
  generalize intBox ν N = Z at hbox ⊢
  classical
  
  have hA : ∀ (S : Finset ℕ) (k : ℕ),
      ∑ T ∈ S.powerset.filter (fun T => T.card ≤ k), (-1:ℝ) ^ T.card
        = ∑ j ∈ Finset.range (k + 1), (-1:ℝ) ^ j * (S.card.choose j : ℝ) := by
    intro S k
    induction k with
    | zero =>
      rw [Finset.sum_filter]
      rw [Finset.sum_eq_single (∅ : Finset ℕ)]
      · simp
      · intro T _ hT
        rw [if_neg]
        intro h
        exact hT (Finset.card_eq_zero.1 (Nat.le_zero.1 h))
      · intro h
        exact absurd (Finset.empty_mem_powerset S) h
    | succ k ih =>
      rw [Finset.sum_filter] at ih ⊢
      rw [Finset.sum_range_succ, ← ih]
      have hsplit : ∀ T ∈ S.powerset, (if T.card ≤ k + 1 then (-1:ℝ) ^ T.card else 0)
          = (if T.card ≤ k then (-1:ℝ) ^ T.card else 0)
            + (if T.card = k + 1 then (-1:ℝ) ^ T.card else 0) := by
        intro T _
        split_ifs <;> first | (exfalso; omega) | ring
      have hcard : ∑ T ∈ S.powerset, (if T.card = k + 1 then (-1:ℝ) ^ T.card else 0)
          = (-1:ℝ) ^ (k + 1) * (S.card.choose (k + 1) : ℝ) := by
        rw [← Finset.sum_filter, ← Finset.powersetCard_eq_filter,
          Finset.sum_congr rfl (fun T hT => by rw [(Finset.mem_powersetCard.1 hT).2]),
          Finset.sum_const, Finset.card_powersetCard, nsmul_eq_mul]
        ring
      rw [Finset.sum_congr rfl hsplit, Finset.sum_add_distrib, hcard]
  
  have s1 : ∀ S : Finset ℕ, |(if S = ∅ then (1:ℝ) else 0)
        - ∑ T ∈ S.powerset.filter (fun T => T.card ≤ k), (-1:ℝ) ^ T.card|
        ≤ (S.card.choose k : ℝ) := by
    intro S
    rw [hA S k]
    rcases Nat.eq_zero_or_pos S.card with h0 | hpos
    · have hS : S = ∅ := Finset.card_eq_zero.1 h0
      rw [if_pos hS, h0, Finset.sum_range_succ', Finset.sum_eq_zero (fun j _ => by simp)]
      simp
    · obtain ⟨n, hn⟩ : ∃ n, S.card = n + 1 := ⟨S.card - 1, by omega⟩
      have hS : S ≠ ∅ := by
        intro h
        rw [h, Finset.card_empty] at hn
        omega
      rw [if_neg hS, hn]
      have hint := @Int.alternating_sum_range_choose_eq_choose n k
      have hreal : ∑ j ∈ Finset.range (k + 1), (-1:ℝ) ^ j * ((n + 1).choose j : ℝ)
          = (-1:ℝ) ^ k * (n.choose k : ℝ) := by
        have := congrArg (Int.cast : ℤ → ℝ) hint
        push_cast at this
        exact this
      rw [hreal, zero_sub, abs_neg, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul,
        Nat.abs_cast]
      exact_mod_cast Nat.choose_le_succ n k
  
  have s2 : ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (c / (p:ℝ))
      ≤ (1/2:ℝ) ^ k * (∏ p ∈ Pp, (1 + c / (p:ℝ))) ^ 2 := by
    have hx : ∀ p : ℕ, 0 ≤ c / (p:ℝ) := fun p => div_nonneg hc (Nat.cast_nonneg p)
    have h1 : ∏ p ∈ Pp, (1 + 2 * (c / (p:ℝ))) ≤ (∏ p ∈ Pp, (1 + c / (p:ℝ))) ^ 2 := by
      rw [← Finset.prod_pow]
      apply Finset.prod_le_prod
      · intro p _; linarith [hx p]
      · intro p _; nlinarith [sq_nonneg (c / (p:ℝ))]
    have h2 : ∏ p ∈ Pp, (1 + 2 * (c / (p:ℝ))) = ∑ T ∈ Pp.powerset, ∏ p ∈ T, (2 * (c / (p:ℝ))) :=
      Finset.prod_one_add _
    have h3 : ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (2 * (c / (p:ℝ)))
        ≤ ∑ T ∈ Pp.powerset, ∏ p ∈ T, (2 * (c / (p:ℝ))) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · rw [Finset.powersetCard_eq_filter]; exact Finset.filter_subset _ _
      · intro T _ _; exact Finset.prod_nonneg (fun p _ => by linarith [hx p])
    have h4 : ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (2 * (c / (p:ℝ)))
        = 2 ^ k * ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (c / (p:ℝ)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro T hT
      rw [Finset.prod_mul_distrib, Finset.prod_const, (Finset.mem_powersetCard.1 hT).2]
    have h5 : (2:ℝ) ^ k * ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (c / (p:ℝ))
        ≤ (∏ p ∈ Pp, (1 + c / (p:ℝ))) ^ 2 := by linarith
    have h6 : (1/2:ℝ) ^ k * 2 ^ k = 1 := by rw [← mul_pow]; norm_num
    calc ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (c / (p:ℝ))
        = (1/2:ℝ) ^ k * (2 ^ k * ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (c / (p:ℝ))) := by
          rw [← mul_assoc, h6, one_mul]
      _ ≤ _ := mul_le_mul_of_nonneg_left h5 (by positivity)
  
  obtain ⟨E, hE⟩ : ∃ E : (Fin ν → ℤ) → ℝ, ∀ z, E z =
      (if Pp.filter (fun p => F p z) = ∅ then (1:ℝ) else 0)
        - ∑ T ∈ (Pp.filter (fun p => F p z)).powerset.filter (fun T => T.card ≤ k),
            (-1:ℝ) ^ T.card :=
    ⟨fun z => (if Pp.filter (fun p => F p z) = ∅ then (1:ℝ) else 0)
        - ∑ T ∈ (Pp.filter (fun p => F p z)).powerset.filter (fun T => T.card ≤ k),
            (-1:ℝ) ^ T.card, fun _ => rfl⟩
  have hEbd : ∀ z, |E z| ≤ ((Pp.filter (fun p => F p z)).card.choose k : ℝ) := by
    intro z; rw [hE]; exact s1 _
  have key : ∀ z, ∑ T ∈ Pp.powerset.filter (fun T => T.card ≤ k),
      (if ∀ p ∈ T, F p z then (-1:ℝ) ^ T.card else 0) + E z
        = if ∀ p ∈ Pp, ¬ F p z then 1 else 0 := by
    intro z
    have hset : (Pp.filter (fun p => F p z)).powerset.filter (fun T => T.card ≤ k)
        = (Pp.powerset.filter (fun T => T.card ≤ k)).filter (fun T => ∀ p ∈ T, F p z) := by
      ext T
      simp only [Finset.mem_filter, Finset.mem_powerset, Finset.subset_iff]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨⟨fun p hp => (h1 hp).1, h2⟩, fun p hp => (h1 hp).2⟩
      · rintro ⟨⟨h1, h2⟩, h3⟩
        exact ⟨fun p hp => ⟨h1 hp, h3 p hp⟩, h2⟩
    have hemp : Pp.filter (fun p => F p z) = ∅ ↔ ∀ p ∈ Pp, ¬ F p z :=
      Finset.filter_eq_empty_iff
    rw [hE, hset, Finset.sum_filter (fun T => ∀ p ∈ T, F p z)]
    by_cases h : ∀ p ∈ Pp, ¬ F p z
    · rw [if_pos (hemp.2 h), if_pos h]; ring
    · rw [if_neg (fun h' => h (hemp.1 h')), if_neg h]; ring
  
  have hpt : ∀ z, (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ Pp, ¬ F p z)
        then g z else 0)
      = ∑ T ∈ Pp.powerset.filter (fun T => T.card ≤ k),
          (-1:ℂ) ^ T.card * (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ T, F p z)
            then g z else 0)
        + (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ Cq z then g z * ((E z : ℝ) : ℂ) else 0) := by
    intro z
    by_cases h : (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ Cq z
    · have h1 : ∀ T ∈ Pp.powerset.filter (fun T => T.card ≤ k),
          (-1:ℂ) ^ T.card * (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ T, F p z)
            then g z else 0)
            = g z * (((if ∀ p ∈ T, F p z then (-1:ℝ) ^ T.card else 0 : ℝ)) : ℂ) := by
        intro T _
        by_cases hT : ∀ p ∈ T, F p z
        · rw [if_pos ⟨h.1, h.2, hT⟩, if_pos hT]; push_cast; ring
        · rw [if_neg (fun h' => hT h'.2.2), if_neg hT]; simp
      rw [Finset.sum_congr rfl h1, ← Finset.mul_sum, if_pos h, ← mul_add, ← Complex.ofReal_sum,
        ← Complex.ofReal_add, key z]
      by_cases h2 : ∀ p ∈ Pp, ¬ F p z
      · rw [if_pos ⟨h.1, h.2, h2⟩, if_pos h2]; simp
      · rw [if_neg (fun h' => h2 h'.2.2), if_neg h2]; simp
    · have h1 : ∀ T ∈ Pp.powerset.filter (fun T => T.card ≤ k),
          (-1:ℂ) ^ T.card * (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ T, F p z)
            then g z else 0) = 0 := by
        intro T _
        rw [if_neg (fun h' => h ⟨h'.1, h'.2.1⟩), mul_zero]
      rw [Finset.sum_congr rfl h1, Finset.sum_const_zero, if_neg h,
        if_neg (fun h' => h ⟨h'.1, h'.2.1⟩)]
      simp
  
  obtain ⟨Y, hY⟩ : ∃ Y : Finset ℕ → ℂ, ∀ T, Y T = ∑ z ∈ @Finset.filter (Fin ν → ℤ)
      (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ T, F p z))
      (fun _ => Classical.propDecidable _) Z, g z := ⟨_, fun _ => rfl⟩
  obtain ⟨X, hX⟩ : ∃ X : ℂ, X = ∑ z ∈ @Finset.filter (Fin ν → ℤ)
      (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ Pp, ¬ F p z))
      (fun _ => Classical.propDecidable _) Z, g z := ⟨_, rfl⟩
  rw [← hX]
  simp only [← hY]
  have hY' : ∀ T, Y T = ∑ z ∈ Z, (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ T, F p z)
      then g z else 0) := by
    intro T
    rw [hY, Finset.sum_filter]
    try exact Finset.sum_congr rfl (fun z _ => by split_ifs <;> rfl)
  have hX' : X = ∑ z ∈ Z, (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ (Cq z ∧ ∀ p ∈ Pp, ¬ F p z)
      then g z else 0) := by
    rw [hX, Finset.sum_filter]
    try exact Finset.sum_congr rfl (fun z _ => by split_ifs <;> rfl)
  have hXeq : X = ∑ T ∈ Pp.powerset.filter (fun T => T.card ≤ k), (-1:ℂ) ^ T.card * Y T
      + ∑ z ∈ Z, (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ Cq z
          then g z * ((E z : ℝ) : ℂ) else 0) := by
    rw [hX']
    simp only [hY', Finset.mul_sum]
    rw [Finset.sum_comm, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun z _ => hpt z)
  have hR : ‖∑ z ∈ Z, (if (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ Cq z
          then g z * ((E z : ℝ) : ℂ) else 0)‖
      ≤ ∑ z ∈ Z, ((Pp.filter (fun p => F p z)).card.choose k : ℝ) := by
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun z _ => ?_))
    split_ifs
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      calc ‖g z‖ * |E z| ≤ 1 * ((Pp.filter (fun p => F p z)).card.choose k : ℝ) :=
            mul_le_mul (hg z) (hEbd z) (abs_nonneg _) zero_le_one
        _ = _ := one_mul _
    · rw [norm_zero]; positivity
  have hTn : ‖∑ T ∈ Pp.powerset.filter (fun T => T.card ≤ k), (-1:ℂ) ^ T.card * Y T‖
      ≤ ∑ T ∈ Pp.powerset.filter (fun T => T.card ≤ k), ‖Y T‖ := by
    refine (norm_sum_le _ _).trans (le_of_eq (Finset.sum_congr rfl (fun T _ => ?_)))
    rw [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
  have hDC : ∑ z ∈ Z, ((Pp.filter (fun p => F p z)).card.choose k : ℝ)
      ≤ 2 ^ ν * ((2 * N + 1 : ℕ) : ℝ) ^ ν * ∑ T ∈ Pp.powersetCard k, ∏ p ∈ T, (c / (p:ℝ)) := by
    have h1 : ∀ z, ((Pp.filter (fun p => F p z)).card.choose k : ℝ)
        = ∑ T ∈ Pp.powersetCard k, (if ∀ p ∈ T, F p z then (1:ℝ) else 0) := by
      intro z
      rw [← Finset.card_powersetCard, Finset.sum_boole]
      congr 2
      ext T
      simp only [Finset.mem_powersetCard, Finset.mem_filter, Finset.subset_iff]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨⟨fun p hp => (h1 hp).1, h2⟩, fun p hp => (h1 hp).2⟩
      · rintro ⟨⟨h1, h2⟩, h3⟩; exact ⟨fun p hp => ⟨h1 hp, h3 p hp⟩, h2⟩
    rw [Finset.sum_congr rfl (fun z _ => h1 z), Finset.sum_comm, Finset.mul_sum]
    apply Finset.sum_le_sum
    intro T hT
    have hT' := Finset.mem_powersetCard.1 hT
    have hb := hbox T (Finset.mem_powerset.2 hT'.1) hT'.2
    rw [Finset.card_filter, Nat.cast_sum] at hb
    refine le_trans (le_of_eq (Finset.sum_congr rfl (fun z _ => ?_))) hb
    split_ifs <;> simp
  have hB : (0:ℝ) ≤ 2 ^ ν * ((2 * N + 1 : ℕ) : ℝ) ^ ν := by positivity
  rw [hXeq]
  exact (norm_add_le _ _).trans
    (add_le_add hTn (hR.trans (hDC.trans (mul_le_mul_of_nonneg_left s2 hB))))

theorem kai_noncoprime_residue_prime (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (p : ℕ) (hp : p.Prime) :
    (∀ z w : Fin (Module.finrank ℚ K) → ℤ, (∀ l, z l ≡ w l [ZMOD (p : ℤ)]) →
      (CoprimeToNat p (ω.equivFun.symm z) ↔ CoprimeToNat p (ω.equivFun.symm w))) ∧
    ((@Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
        (fun r => ¬ CoprimeToNat p (ω.equivFun.symm r))
        (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) p)).card : ℝ)
      ≤ (p : ℝ) ^ Module.finrank ℚ K * ((Module.finrank ℚ K : ℝ) / p) :=
by
  classical
  refine ⟨?_, ?_⟩
  · intro z w hzw
    have hd : ω.equivFun.symm z - ω.equivFun.symm w ∈
        Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)} := by
      have hdv : ∀ l, (p : ℤ) ∣ z l - w l := fun l => (hzw l).symm.dvd
      choose t ht using hdv
      have hzw' : z - w = (p : ℤ) • t := by
        funext l; simp [ht l]
      rw [← map_sub, hzw', map_zsmul, zsmul_eq_mul]
      apply Ideal.mul_mem_right
      simpa using Ideal.mem_span_singleton_self ((p : ℕ) : NumberField.RingOfIntegers K)
    unfold CoprimeToNat
    refine forall_congr' (fun 𝔭 => imp_congr_right (fun hp𝔭 => not_congr ?_))
    have hle : Ideal.span {((p : ℕ) : NumberField.RingOfIntegers K)} ≤ 𝔭.asIdeal :=
      (Ideal.span_singleton_le_iff_mem _).mpr hp𝔭
    have hd' := hle hd
    constructor
    · intro hx
      have h1 := 𝔭.asIdeal.sub_mem hx hd'
      simpa using h1
    · intro hy
      have h1 := 𝔭.asIdeal.add_mem hd' hy
      simpa using h1
  · have h := kai_coset_bad_density_bound K ω ⊤ 0 {p} top_ne_bot
      (by rw [← Ideal.one_eq_top]; exact isCoprime_one_right)
      (fun q hq => by rw [Finset.mem_singleton] at hq; rw [hq]; exact hp)
    have e : Ideal.absNorm (⊤ : Ideal (NumberField.RingOfIntegers K))
        * ∏ q ∈ ({p} : Finset ℕ), q = p := by
      simp [Ideal.absNorm_top]
    rw [e] at h
    have heq : @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
        (fun r => ¬ CoprimeToNat p (ω.equivFun.symm r))
        (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) p) =
      @Finset.filter (Fin (Module.finrank ℚ K) → ℤ)
        (fun z => ω.equivFun.symm z - 0 ∈ (⊤ : Ideal (NumberField.RingOfIntegers K)) ∧
            ∀ q ∈ ({p} : Finset ℕ),
              ∃ 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              ((q : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal ∧
                ω.equivFun.symm z ∈ 𝔭.asIdeal)
        (fun _ => Classical.propDecidable _) (resBox (Module.finrank ℚ K) p) := by
      ext r
      simp only [Finset.mem_filter, Submodule.mem_top, true_and, Finset.mem_singleton, forall_eq,
        forall_eq', CoprimeToNat, not_forall, not_not, exists_prop]
    rw [← heq] at h
    simp only [Ideal.absNorm_top, Nat.cast_one, one_mul, Finset.prod_singleton,
      Finset.card_singleton, pow_one] at h
    have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
    rw [show (p : ℝ) ^ Module.finrank ℚ K * ((Module.finrank ℚ K : ℝ) / p)
        = ((Module.finrank ℚ K : ℝ) * (p : ℝ) ^ Module.finrank ℚ K) / p by ring,
      le_div_iff₀ hp0]
    exact h

theorem kai_crt_residue_count (ν : ℕ) (c : ℝ) (hc : 0 ≤ c) (T : Finset ℕ)
    (hT : ∀ p ∈ T, p.Prime) (F : ℕ → (Fin ν → ℤ) → Prop)
    (hper : ∀ p ∈ T, ∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (p : ℤ)]) → (F p z ↔ F p w))
    (hcount : ∀ p ∈ T, ((@Finset.filter (Fin ν → ℤ) (F p) (fun _ => Classical.propDecidable _)
        (resBox ν p)).card : ℝ) ≤ (p : ℝ) ^ ν * (c / p)) :
    (∀ L : ℕ, (∏ p ∈ T, p) ∣ L → 1 ≤ L →
      ((@Finset.filter (Fin ν → ℤ) (fun r => ∀ p ∈ T, F p r)
          (fun _ => Classical.propDecidable _) (resBox ν L)).card : ℝ)
        ≤ (L : ℝ) ^ ν * ∏ p ∈ T, (c / (p : ℝ))) ∧
    (∀ N : ℕ, (∏ p ∈ T, p) ≤ 2 * N + 1 →
      ((@Finset.filter (Fin ν → ℤ) (fun z => ∀ p ∈ T, F p z)
          (fun _ => Classical.propDecidable _) (intBox ν N)).card : ℝ)
        ≤ 2 ^ ν * ((2 * N + 1 : ℕ) : ℝ) ^ ν * ∏ p ∈ T, (c / (p : ℝ))) :=
by
  
  have memF : ∀ (G : (Fin ν → ℤ) → Prop) (S : Finset (Fin ν → ℤ)) (x : Fin ν → ℤ),
      x ∈ @Finset.filter (Fin ν → ℤ) G (fun _ => Classical.propDecidable _) S ↔ x ∈ S ∧ G x := by
    intro G S x
    classical
    exact Finset.mem_filter
  
  have hcardRes : ∀ m : ℕ, (resBox ν m).card = m ^ ν := by
    intro m
    unfold resBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  
  have hmemRes : ∀ (m : ℕ) (r : Fin ν → ℤ),
      r ∈ resBox ν m ↔ ∀ l, 0 ≤ r l ∧ r l ≤ (m : ℤ) - 1 := by
    intro m r
    unfold resBox
    simp only [Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h l => ⟨h.1 l, h.2 l⟩, fun h => ⟨fun l => (h l).1, fun l => (h l).2⟩⟩
  have hmemInt : ∀ (N : ℕ) (z : Fin ν → ℤ),
      z ∈ intBox ν N ↔ ∀ l, -(N : ℤ) ≤ z l ∧ z l ≤ (N : ℤ) := by
    intro N z
    unfold intBox
    simp only [Finset.mem_Icc, Pi.le_def]
    exact ⟨fun h l => ⟨h.1 l, h.2 l⟩, fun h => ⟨fun l => (h l).1, fun l => (h l).2⟩⟩
  
  have hA : ∀ (T : Finset ℕ), (∀ p ∈ T, p.Prime) →
      (∀ p ∈ T, ∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (p : ℤ)]) → (F p z ↔ F p w)) →
      (@Finset.filter (Fin ν → ℤ) (fun r => ∀ p ∈ T, F p r)
          (fun _ => Classical.propDecidable _) (resBox ν (∏ p ∈ T, p))).card
        ≤ ∏ p ∈ T, (@Finset.filter (Fin ν → ℤ) (F p)
          (fun _ => Classical.propDecidable _) (resBox ν p)).card := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      intro _ _
      rw [Finset.prod_empty, Finset.prod_empty]
      calc _ ≤ (resBox ν 1).card := Finset.card_le_card (fun x hx => ((memF _ _ x).1 hx).1)
        _ = 1 := by rw [hcardRes, one_pow]
    | insert p T' hpT' ih =>
      intro hT hper
      have hT' : ∀ q ∈ T', q.Prime := fun q hq => hT q (Finset.mem_insert_of_mem hq)
      have hper' : ∀ q ∈ T', ∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (q : ℤ)]) →
          (F q z ↔ F q w) := fun q hq => hper q (Finset.mem_insert_of_mem hq)
      have ih' := ih hT' hper'
      have hp : p.Prime := hT p (Finset.mem_insert_self p T')
      rw [Finset.prod_insert hpT', Finset.prod_insert hpT']
      obtain ⟨d', hd'⟩ : ∃ d', d' = ∏ q ∈ T', q := ⟨_, rfl⟩
      rw [← hd'] at ih' ⊢
      have hd'pos : 0 < d' := by rw [hd']; exact Finset.prod_pos (fun q hq => (hT' q hq).pos)
      have hppos : 0 < p := hp.pos
      have hcop : Nat.Coprime d' p := by
        rw [hd']
        exact Nat.Coprime.prod_left (fun q hq =>
          (Nat.coprime_primes (hT' q hq) hp).2 (fun h => hpT' (h ▸ hq)))
      have hd0 : (0 : ℤ) < (d' : ℤ) := by exact_mod_cast hd'pos
      have hp0 : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hppos
      calc _ ≤ ((@Finset.filter _ (fun r => ∀ q ∈ T', F q r)
                (fun _ => Classical.propDecidable _) (resBox ν d')) ×ˢ
              (@Finset.filter _ (F p) (fun _ => Classical.propDecidable _) (resBox ν p))).card := by
            apply Finset.card_le_card_of_injOn
              (fun r => ((fun l => r l % (d' : ℤ)), (fun l => r l % (p : ℤ))))
            · intro r hr
              have hr' := (memF _ _ _).1 hr
              simp only [Finset.mem_coe, Finset.mem_product, memF, hmemRes]
              refine ⟨⟨fun l => ⟨Int.emod_nonneg _ hd0.ne', ?_⟩, fun q hq => ?_⟩,
                fun l => ⟨Int.emod_nonneg _ hp0.ne', ?_⟩, ?_⟩
              · have := Int.emod_lt_of_pos (r l) hd0
                omega
              · have hqd : (q : ℤ) ∣ (d' : ℤ) := by
                  rw [hd']
                  exact Int.natCast_dvd_natCast.2 (Finset.dvd_prod_of_mem (fun q => q) hq)
                exact (hper' q hq (fun l => r l % (d' : ℤ)) r
                  (fun l => Int.emod_emod_of_dvd (r l) hqd)).2
                  (hr'.2 q (Finset.mem_insert_of_mem hq))
              · have := Int.emod_lt_of_pos (r l) hp0
                omega
              · exact (hper p (Finset.mem_insert_self p T') (fun l => r l % (p : ℤ)) r
                  (fun l => Int.emod_emod_of_dvd (r l) dvd_rfl)).2
                  (hr'.2 p (Finset.mem_insert_self p T'))
            · intro r hr s hs hrs
              have hrb := (hmemRes _ r).1 ((memF _ _ _).1 hr).1
              have hsb := (hmemRes _ s).1 ((memF _ _ _).1 hs).1
              simp only [Prod.mk.injEq] at hrs
              funext l
              have e1 : r l ≡ s l [ZMOD (d' : ℤ)] := congrFun hrs.1 l
              have e2 : r l ≡ s l [ZMOD (p : ℤ)] := congrFun hrs.2 l
              have hcop' : (d' : ℤ).natAbs.Coprime (p : ℤ).natAbs := by
                rw [Int.natAbs_natCast, Int.natAbs_natCast]; exact hcop
              have e3 : r l % ((d' : ℤ) * (p : ℤ)) = s l % ((d' : ℤ) * (p : ℤ)) :=
                (Int.modEq_and_modEq_iff_modEq_mul hcop').1 ⟨e1, e2⟩
              have hM : (((p * d' : ℕ) : ℤ)) = (d' : ℤ) * (p : ℤ) := by push_cast; ring
              have hr1 := hrb l
              have hs1 := hsb l
              rw [hM] at hr1 hs1
              rw [Int.emod_eq_of_lt hr1.1 (by linarith [hr1.2]),
                Int.emod_eq_of_lt hs1.1 (by linarith [hs1.2])] at e3
              exact e3
        _ = _ := Finset.card_product _ _
        _ ≤ (∏ q ∈ T', (@Finset.filter (Fin ν → ℤ) (F q)
              (fun _ => Classical.propDecidable _) (resBox ν q)).card) *
            (@Finset.filter (Fin ν → ℤ) (F p)
              (fun _ => Classical.propDecidable _) (resBox ν p)).card :=
            Nat.mul_le_mul_right _ ih'
        _ = _ := mul_comm _ _
  
  have hB : ∀ (d L : ℕ), 1 ≤ d → d ∣ L → ∀ (G : (Fin ν → ℤ) → Prop),
      (∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (d : ℤ)]) → (G z ↔ G w)) →
      (@Finset.filter (Fin ν → ℤ) G (fun _ => Classical.propDecidable _) (resBox ν L)).card
        ≤ (L / d) ^ ν *
          (@Finset.filter (Fin ν → ℤ) G (fun _ => Classical.propDecidable _) (resBox ν d)).card := by
    intro d L hd hdL G hG
    obtain ⟨k, rfl⟩ := hdL
    rw [Nat.mul_div_cancel_left k (by omega : 0 < d)]
    have hd0 : (0 : ℤ) < (d : ℤ) := by exact_mod_cast hd
    calc _ ≤ ((@Finset.filter _ G (fun _ => Classical.propDecidable _) (resBox ν d)) ×ˢ
            resBox ν k).card := by
          apply Finset.card_le_card_of_injOn
            (fun r => ((fun l => r l % (d : ℤ)), (fun l => r l / (d : ℤ))))
          · intro r hr
            have hr' := (memF _ _ _).1 hr
            have hb := (hmemRes _ r).1 hr'.1
            simp only [Finset.mem_coe, Finset.mem_product, memF, hmemRes]
            refine ⟨⟨fun l => ⟨Int.emod_nonneg _ hd0.ne', ?_⟩, ?_⟩,
              fun l => ⟨Int.ediv_nonneg (hb l).1 hd0.le, ?_⟩⟩
            · have := Int.emod_lt_of_pos (r l) hd0
              omega
            · exact (hG (fun l => r l % (d : ℤ)) r
                (fun l => Int.emod_emod_of_dvd (r l) dvd_rfl)).2 hr'.2
            · have h1 : r l < (k : ℤ) * (d : ℤ) := by
                have := (hb l).2
                push_cast at this
                linarith
              have := Int.ediv_lt_of_lt_mul hd0 h1
              omega
          · intro r hr s hs hrs
            simp only [Prod.mk.injEq] at hrs
            funext l
            have h1 : r l % (d : ℤ) = s l % (d : ℤ) := congrFun hrs.1 l
            have h2 : r l / (d : ℤ) = s l / (d : ℤ) := congrFun hrs.2 l
            rw [← Int.mul_ediv_add_emod (r l) (d : ℤ), ← Int.mul_ediv_add_emod (s l) (d : ℤ), h1, h2]
      _ = _ := by rw [Finset.card_product, hcardRes, mul_comm]
  
  have hC : ∀ (N L : ℕ), 2 * N + 1 ≤ L → ∀ (G : (Fin ν → ℤ) → Prop),
      (∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (L : ℤ)]) → (G z ↔ G w)) →
      (@Finset.filter (Fin ν → ℤ) G (fun _ => Classical.propDecidable _) (intBox ν N)).card
        ≤ (@Finset.filter (Fin ν → ℤ) G (fun _ => Classical.propDecidable _)
            (resBox ν L)).card := by
    intro N L hL G hG
    have hL0 : (0 : ℤ) < (L : ℤ) := by exact_mod_cast (by omega : 0 < L)
    have hLc : 2 * (N : ℤ) + 1 ≤ (L : ℤ) := by exact_mod_cast hL
    apply Finset.card_le_card_of_injOn (fun z => fun l => z l % (L : ℤ))
    · intro z hz
      have hz' := (memF _ _ _).1 hz
      simp only [Finset.mem_coe, memF, hmemRes]
      refine ⟨fun l => ⟨Int.emod_nonneg _ hL0.ne', ?_⟩, ?_⟩
      · have := Int.emod_lt_of_pos (z l) hL0
        omega
      · exact (hG (fun l => z l % (L : ℤ)) z
          (fun l => Int.emod_emod_of_dvd (z l) dvd_rfl)).2 hz'.2
    · intro z hz z' hz' hzz
      have hb := (hmemInt _ z).1 ((memF _ _ _).1 hz).1
      have hb' := (hmemInt _ z').1 ((memF _ _ _).1 hz').1
      funext l
      have h1 : z l % (L : ℤ) = z' l % (L : ℤ) := congrFun hzz l
      have e1 : (z l + N) % (L : ℤ) = (z' l + N) % (L : ℤ) := by
        rw [Int.add_emod, h1, ← Int.add_emod]
      rw [Int.emod_eq_of_lt (by linarith [(hb l).1]) (by linarith [(hb l).2]),
        Int.emod_eq_of_lt (by linarith [(hb' l).1]) (by linarith [(hb' l).2])] at e1
      linarith
  
  have hd1 : 0 < ∏ p ∈ T, p := Finset.prod_pos (fun p hp => (hT p hp).pos)
  have hGper : ∀ m : ℕ, (∏ p ∈ T, p) ∣ m → ∀ z w : Fin ν → ℤ,
      (∀ l, z l ≡ w l [ZMOD (m : ℤ)]) → ((∀ p ∈ T, F p z) ↔ (∀ p ∈ T, F p w)) := by
    intro m hm z w hzw
    have key : ∀ p ∈ T, (F p z ↔ F p w) := fun p hp => hper p hp z w (fun l =>
      Int.ModEq.of_dvd (Int.natCast_dvd_natCast.2
        ((Finset.dvd_prod_of_mem (fun q => q) hp).trans hm)) (hzw l))
    exact ⟨fun h p hp => (key p hp).1 (h p hp), fun h p hp => (key p hp).2 (h p hp)⟩
  
  have hI : ∀ L : ℕ, (∏ p ∈ T, p) ∣ L → 1 ≤ L →
      ((@Finset.filter (Fin ν → ℤ) (fun r => ∀ p ∈ T, F p r)
          (fun _ => Classical.propDecidable _) (resBox ν L)).card : ℝ)
        ≤ (L : ℝ) ^ ν * ∏ p ∈ T, (c / (p : ℝ)) := by
    intro L hdL _
    have h1 := hB (∏ p ∈ T, p) L hd1 hdL (fun r => ∀ p ∈ T, F p r) (hGper _ dvd_rfl)
    have h2 := hA T hT hper
    obtain ⟨k, hk⟩ : ∃ k, k = L / ∏ p ∈ T, p := ⟨_, rfl⟩
    rw [← hk] at h1
    have hkL : k * ∏ p ∈ T, p = L := by rw [hk]; exact Nat.div_mul_cancel hdL
    have h3 : ((@Finset.filter (Fin ν → ℤ) (fun r => ∀ p ∈ T, F p r)
          (fun _ => Classical.propDecidable _) (resBox ν L)).card : ℝ)
        ≤ (k : ℝ) ^ ν * ∏ p ∈ T, ((@Finset.filter (Fin ν → ℤ) (F p)
          (fun _ => Classical.propDecidable _) (resBox ν p)).card : ℝ) := by
      have := h1.trans (Nat.mul_le_mul_left _ h2)
      exact_mod_cast this
    have h4 : ∏ p ∈ T, ((@Finset.filter (Fin ν → ℤ) (F p)
          (fun _ => Classical.propDecidable _) (resBox ν p)).card : ℝ)
        ≤ ∏ p ∈ T, ((p : ℝ) ^ ν * (c / p)) :=
      Finset.prod_le_prod (fun p _ => Nat.cast_nonneg _) hcount
    have h5 : ∏ p ∈ T, ((p : ℝ) ^ ν * (c / p))
        = ((∏ p ∈ T, p : ℕ) : ℝ) ^ ν * ∏ p ∈ T, (c / (p : ℝ)) := by
      rw [Finset.prod_mul_distrib, Finset.prod_pow, Nat.cast_prod]
    have h6 : (k : ℝ) ^ ν * ((∏ p ∈ T, p : ℕ) : ℝ) ^ ν = (L : ℝ) ^ ν := by
      rw [← mul_pow, ← Nat.cast_mul, hkL]
    calc _ ≤ _ := h3
      _ ≤ (k : ℝ) ^ ν * (((∏ p ∈ T, p : ℕ) : ℝ) ^ ν * ∏ p ∈ T, (c / (p : ℝ))) := by
          rw [← h5]; exact mul_le_mul_of_nonneg_left h4 (by positivity)
      _ = _ := by rw [← mul_assoc, h6]
  refine ⟨hI, ?_⟩
  
  intro N hN
  obtain ⟨d, hd⟩ : ∃ d, d = ∏ p ∈ T, p := ⟨_, rfl⟩
  rw [← hd] at hN hd1
  obtain ⟨L₀, hL₀⟩ : ∃ L₀, L₀ = d * (2 * N / d + 1) := ⟨_, rfl⟩
  have hdvd : (∏ p ∈ T, p) ∣ L₀ := by rw [← hd]; exact ⟨_, hL₀⟩
  have hc1 : 2 * N < L₀ := by rw [hL₀]; exact Nat.lt_mul_div_succ (2 * N) hd1
  have hc2 : L₀ ≤ 2 * (2 * N + 1) := by
    have h := Nat.mul_div_le (2 * N) d
    rw [hL₀, mul_add, mul_one]
    generalize d * (2 * N / d) = X at h ⊢
    omega
  have hbox := hC N L₀ (by omega) (fun z => ∀ p ∈ T, F p z) (hGper L₀ hdvd)
  have hres := hI L₀ hdvd (by omega)
  have hprod0 : 0 ≤ ∏ p ∈ T, (c / (p : ℝ)) :=
    Finset.prod_nonneg (fun p _ => div_nonneg hc (Nat.cast_nonneg _))
  have hL₀r : (L₀ : ℝ) ^ ν ≤ 2 ^ ν * ((2 * N + 1 : ℕ) : ℝ) ^ ν := by
    rw [← mul_pow]
    apply pow_le_pow_left₀ (Nat.cast_nonneg _)
    exact_mod_cast hc2
  calc _ ≤ ((@Finset.filter (Fin ν → ℤ) (fun r => ∀ p ∈ T, F p r)
          (fun _ => Classical.propDecidable _) (resBox ν L₀)).card : ℝ) := by
        exact_mod_cast hbox
    _ ≤ _ := hres
    _ ≤ _ := mul_le_mul_of_nonneg_right hL₀r hprod0

theorem kai_prime_recip_prod_bound : ∃ C₀ : ℝ, 1 ≤ C₀ ∧ ∀ m : ℕ,
      ∏ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 + 1 / (p : ℝ))
        ≤ C₀ * max 1 (Real.log m) :=
by
  
  have hs3 : ∀ t : ℕ, 1 ≤ t →
      ∑ p ∈ Finset.filter Nat.Prime (Finset.range (t + 1)), Real.log (p : ℝ) / (p : ℝ)
        ≤ Real.log (t : ℝ) + Real.log 4 := by
    intro m hm
    set P := Finset.filter Nat.Prime (Finset.range (m + 1)) with hP
    have hmem : ∀ p ∈ P, p.Prime ∧ p ≤ m := by
      intro p hp
      rw [hP, Finset.mem_filter, Finset.mem_range] at hp
      exact ⟨hp.2, by omega⟩
    have hfact0 : m.factorial ≠ 0 := Nat.factorial_ne_zero m
    have hleg : ∀ p ∈ P, m / p ≤ (m.factorial).factorization p := by
      intro p hp
      obtain ⟨hpp, hpm⟩ := hmem p hp
      rw [← hpp.pow_dvd_iff_le_factorization hfact0]
      rw [hpp.pow_dvd_factorial_iff (b := m + 1)]
      · have h1 : (1 : ℕ) ∈ Finset.Ico 1 (m + 1) := by simp; omega
        have := Finset.single_le_sum (f := fun i => m / p ^ i) (fun _ _ => Nat.zero_le _) h1
        simpa using this
      · have := Nat.log_le_self p m
        omega
    have hlogfact : Real.log (m.factorial : ℝ)
        = ∑ p ∈ P, ((m.factorial).factorization p : ℝ) * Real.log (p : ℝ) := by
      rw [Real.log_nat_eq_sum_factorization]
      apply Finsupp.sum_of_support_subset
      · intro p hp
        rw [Nat.support_factorization, Nat.mem_primeFactors] at hp
        obtain ⟨hpp, hdvd, -⟩ := hp
        rw [hP, Finset.mem_filter, Finset.mem_range]
        refine ⟨?_, hpp⟩
        have := (Nat.Prime.dvd_factorial hpp).1 hdvd
        omega
      · intro p _
        simp
    have hfloor : ∀ p ∈ P, (m : ℝ) / p - 1 ≤ ((m / p : ℕ) : ℝ) := by
      intro p hp
      obtain ⟨hpp, -⟩ := hmem p hp
      have hp0 : (0 : ℝ) < p := by exact_mod_cast hpp.pos
      have h1 := Nat.div_add_mod m p
      have h2 := Nat.mod_lt m hpp.pos
      have h1' : (p : ℝ) * ((m / p : ℕ) : ℝ) + ((m % p : ℕ) : ℝ) = m := by exact_mod_cast h1
      have h2' : ((m % p : ℕ) : ℝ) < p := by exact_mod_cast h2
      rw [div_sub_one hp0.ne', div_le_iff₀ hp0]
      nlinarith
    have hlogp : ∀ p ∈ P, 0 ≤ Real.log (p : ℝ) := fun p _ => Real.log_natCast_nonneg p
    have hA : ∑ p ∈ P, ((m : ℝ) / p - 1) * Real.log (p : ℝ) ≤ Real.log (m.factorial : ℝ) := by
      rw [hlogfact]
      apply Finset.sum_le_sum
      intro p hp
      apply mul_le_mul_of_nonneg_right _ (hlogp p hp)
      refine (hfloor p hp).trans ?_
      exact_mod_cast hleg p hp
    have hmpos : (0 : ℝ) < m := by exact_mod_cast hm
    have hB : Real.log (m.factorial : ℝ) ≤ m * Real.log (m : ℝ) := by
      rw [← Real.log_pow]
      apply Real.log_le_log (by exact_mod_cast Nat.factorial_pos m)
      exact_mod_cast Nat.factorial_le_pow m
    have hC : ∑ p ∈ P, Real.log (p : ℝ) ≤ m * Real.log 4 := by
      have hprod : ((primorial m : ℕ) : ℝ) = ∏ p ∈ P, (p : ℝ) := by
        rw [hP]; unfold primorial; push_cast; rfl
      rw [← Real.log_prod]
      · rw [← hprod, ← Real.log_pow]
        apply Real.log_le_log (by exact_mod_cast primorial_pos m)
        exact_mod_cast primorial_le_4_pow m
      · intro p hp
        exact_mod_cast (hmem p hp).1.ne_zero
    have hsplit : ∑ p ∈ P, ((m : ℝ) / p - 1) * Real.log (p : ℝ)
        = (m : ℝ) * ∑ p ∈ P, Real.log (p : ℝ) / (p : ℝ) - ∑ p ∈ P, Real.log (p : ℝ) := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro p _
      ring
    have hkey : (m : ℝ) * ∑ p ∈ P, Real.log (p : ℝ) / (p : ℝ)
        ≤ (m : ℝ) * (Real.log (m : ℝ) + Real.log 4) := by
      rw [mul_add]; linarith
    exact le_of_mul_le_mul_left hkey hmpos
  
  have hs4 : ∀ m : ℕ, ∑ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), (1 : ℝ) / (p : ℝ)
      ≤ Real.log (max 1 (Real.log (m : ℝ))) + 4 := by
    have hM := hs3
    set S : ℕ → ℝ := fun m =>
      ∑ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), (1 : ℝ) / (p : ℝ) with hS
    set A : ℕ → ℝ := fun m =>
      ∑ p ∈ Finset.filter Nat.Prime (Finset.range (m + 1)), Real.log (p : ℝ) / (p : ℝ) with hA
    have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hc : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; push_cast; ring
    have hc2 : Real.log 4 * (1 / Real.log 2) = 2 := by rw [hc]; field_simp
    have hAk : ∀ k : ℕ, A (k + 2) ≤ Real.log ((k : ℝ) + 2) + Real.log 4 := by
      intro k
      have := hM (k + 2) (by omega)
      push_cast at this
      exact this
    have inv : ∀ k : ℕ, S (k + 2) - A (k + 2) / Real.log ((k : ℝ) + 2) ≤
        Real.log (Real.log ((k : ℝ) + 2)) - Real.log (Real.log 2)
          + Real.log 4 * (1 / Real.log 2 - 1 / Real.log ((k : ℝ) + 2)) := by
      intro k
      induction k with
      | zero =>
        have hP : Finset.filter Nat.Prime (Finset.range (0 + 2 + 1)) = {2} := by decide
        simp only [hS, hA, hP, Finset.sum_singleton]
        rw [show ((0 : ℕ) : ℝ) + 2 = 2 by norm_num, show ((2 : ℕ) : ℝ) = 2 by norm_num,
          show Real.log 2 / 2 / Real.log 2 = 1 / 2 by field_simp]
        simp
      | succ k ih =>
        obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, ℓ = Real.log ((k : ℝ) + 2) := ⟨_, rfl⟩
        obtain ⟨ℓ', hℓ'⟩ : ∃ ℓ', ℓ' = Real.log (((k + 1 : ℕ) : ℝ) + 2) := ⟨_, rfl⟩
        rw [← hℓ] at ih
        rw [← hℓ']
        have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
        have hℓpos : 0 < ℓ := by rw [hℓ]; exact Real.log_pos (by linarith)
        have hℓle : ℓ ≤ ℓ' := by
          rw [hℓ, hℓ']; exact Real.log_le_log (by positivity) (by push_cast; linarith)
        have hℓ'pos : 0 < ℓ' := lt_of_lt_of_le hℓpos hℓle
        have hid : S (k + 1 + 2) - A (k + 1 + 2) / ℓ' = S (k + 2) - A (k + 2) / ℓ' := by
          simp only [hS, hA]
          rw [show k + 1 + 2 + 1 = (k + 2 + 1) + 1 by ring, Finset.range_add_one,
            Finset.filter_insert]
          split_ifs with hp
          · rw [Finset.sum_insert (by simp), Finset.sum_insert (by simp)]
            have hq : ((k + 2 + 1 : ℕ) : ℝ) ≠ 0 := by positivity
            have heq : ℓ' = Real.log ((k + 2 + 1 : ℕ) : ℝ) := by
              rw [hℓ']; congr 1; push_cast; ring
            have h3 : Real.log ((k + 2 + 1 : ℕ) : ℝ) / ((k + 2 + 1 : ℕ) : ℝ) / ℓ'
                = 1 / ((k + 2 + 1 : ℕ) : ℝ) := by
              rw [← heq]; field_simp
            rw [add_div, h3]; ring
          · rfl
        have hAm := hAk k
        rw [← hℓ] at hAm
        have hD : 0 ≤ 1 / ℓ - 1 / ℓ' := by
          rw [sub_nonneg]; exact one_div_le_one_div_of_le hℓpos hℓle
        have hconc : ℓ * (1 / ℓ - 1 / ℓ') ≤ Real.log ℓ' - Real.log ℓ := by
          have h1 : ℓ * (1 / ℓ - 1 / ℓ') = 1 - ℓ / ℓ' := by field_simp
          have h2 := Real.log_le_sub_one_of_pos (div_pos hℓpos hℓ'pos)
          rw [Real.log_div hℓpos.ne' hℓ'pos.ne'] at h2
          linarith
        have hsplit : S (k + 2) - A (k + 2) / ℓ'
            = (S (k + 2) - A (k + 2) / ℓ) + A (k + 2) * (1 / ℓ - 1 / ℓ') := by
          field_simp; ring
        have hAD : A (k + 2) * (1 / ℓ - 1 / ℓ') ≤ (ℓ + Real.log 4) * (1 / ℓ - 1 / ℓ') :=
          mul_le_mul_of_nonneg_right hAm hD
        have hexp : (ℓ + Real.log 4) * (1 / ℓ - 1 / ℓ')
            = ℓ * (1 / ℓ - 1 / ℓ') + Real.log 4 * (1 / ℓ) - Real.log 4 * (1 / ℓ') := by ring
        have hexp2 : Real.log 4 * (1 / Real.log 2 - 1 / ℓ')
            = Real.log 4 * (1 / Real.log 2) - Real.log 4 * (1 / ℓ') := by ring
        have hexp3 : Real.log 4 * (1 / Real.log 2 - 1 / ℓ)
            = Real.log 4 * (1 / Real.log 2) - Real.log 4 * (1 / ℓ) := by ring
        rw [hid, hsplit, hexp2]
        rw [hexp3] at ih
        linarith
    intro m
    show S m ≤ _
    rcases Nat.lt_or_ge m 2 with h | h
    · have hS0 : S m = 0 := by
        interval_cases m
        · simp only [hS]
          rw [show Finset.filter Nat.Prime (Finset.range (0 + 1)) = ∅ by decide]; simp
        · simp only [hS]
          rw [show Finset.filter Nat.Prime (Finset.range (1 + 1)) = ∅ by decide]; simp
      rw [hS0]
      have := Real.log_nonneg (le_max_left 1 (Real.log (m : ℝ)))
      linarith
    · obtain ⟨k, rfl⟩ : ∃ k, m = k + 2 := ⟨m - 2, by omega⟩
      have hI := inv k
      obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, ℓ = Real.log ((k : ℝ) + 2) := ⟨_, rfl⟩
      rw [← hℓ] at hI
      have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
      have hℓpos : 0 < ℓ := by rw [hℓ]; exact Real.log_pos (by linarith)
      have hAm := hAk k
      rw [← hℓ] at hAm
      have hAl : A (k + 2) / ℓ ≤ 1 + Real.log 4 * (1 / ℓ) := by
        rw [div_le_iff₀ hℓpos]
        have : (1 + Real.log 4 * (1 / ℓ)) * ℓ = ℓ + Real.log 4 := by field_simp
        rw [this]; exact hAm
      have hexp3 : Real.log 4 * (1 / Real.log 2 - 1 / ℓ)
          = Real.log 4 * (1 / Real.log 2) - Real.log 4 * (1 / ℓ) := by ring
      rw [hexp3, hc2] at hI
      have hll2 : -1 ≤ Real.log (Real.log 2) := by
        have he := Real.exp_one_gt_d9
        have hem : Real.exp (-1) * Real.exp 1 = 1 := by rw [← Real.exp_add]; norm_num
        have hep := Real.exp_pos (-1)
        have hl2' := Real.log_two_gt_d9
        have hle : Real.exp (-1) ≤ Real.log 2 := by nlinarith
        have := Real.log_le_log hep hle
        rwa [Real.log_exp] at this
      have hmax : Real.log ℓ ≤ Real.log (max 1 ℓ) := Real.log_le_log hℓpos (le_max_right _ _)
      have hgoal : Real.log (max 1 (Real.log (((k + 2 : ℕ) : ℝ)))) = Real.log (max 1 ℓ) := by
        rw [hℓ]; push_cast; rfl
      rw [hgoal]
      linarith
  
  refine ⟨Real.exp 4, Real.one_le_exp (by norm_num), ?_⟩
  intro m
  have hL : 0 < max 1 (Real.log (m : ℝ)) := lt_of_lt_of_le one_pos (le_max_left _ _)
  have hprod : ∏ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 + 1 / (p : ℝ))
      ≤ ∏ p ∈ (Finset.range (m + 1)).filter Nat.Prime, Real.exp (1 / (p : ℝ)) := by
    apply Finset.prod_le_prod
    · intro p _; positivity
    · intro p _
      have := Real.add_one_le_exp (1 / (p : ℝ))
      linarith
  rw [← Real.exp_sum] at hprod
  calc ∏ p ∈ (Finset.range (m + 1)).filter Nat.Prime, (1 + 1 / (p : ℝ))
      ≤ Real.exp (∑ p ∈ (Finset.range (m + 1)).filter Nat.Prime, 1 / (p : ℝ)) := hprod
    _ ≤ Real.exp (Real.log (max 1 (Real.log (m : ℝ))) + 4) := Real.exp_le_exp.2 (hs4 m)
    _ = Real.exp 4 * max 1 (Real.log m) := by
        rw [Real.exp_add, Real.exp_log hL, mul_comm]

theorem kai_cqm_thresholds (K₁ K₂ : ℝ) (a : ℕ) :
    ∃ M₀ : ℝ, 3 ≤ M₀ ∧ ∀ M : ℝ, M₀ ≤ M →
      1 ≤ Real.log M ∧
      5 * (Real.log M ^ ((1:ℝ)/10) * Real.log M ^ ((1:ℝ)/3)) ≤ Real.log M ∧
      K₁ * Real.log M ^ a
          * Real.exp ((a : ℝ) * (Real.log M ^ ((1:ℝ)/10) * Real.log M ^ ((1:ℝ)/3)))
        ≤ Real.exp (Real.log M - 1) ∧
      K₂ * Real.log M ^ a ≤ Real.exp (Real.log M ^ ((1:ℝ)/10)) :=
by
  have hF : ∀ L : ℝ, 1 ≤ L → 0 ≤ L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3) ∧
      L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3) ≤ Real.sqrt L := by
    intro L hL
    have hL0 : 0 < L := by linarith
    refine ⟨by positivity, ?_⟩
    rw [← Real.rpow_add hL0, Real.sqrt_eq_rpow]
    exact Real.rpow_le_rpow_of_exponent_le hL (by norm_num)
  have s1 : ∀ L : ℝ, 25 ≤ L → 5 * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)) ≤ L := by
    intro L hL
    obtain ⟨h0, h1⟩ := hF L (by linarith)
    have hr0 := Real.sqrt_nonneg L
    have hrr := Real.mul_self_sqrt (show (0:ℝ) ≤ L by linarith)
    have h5 : (5:ℝ) ≤ Real.sqrt L := by
      by_contra h
      push_neg at h
      nlinarith
    have h2 : 5 * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)) ≤ 5 * Real.sqrt L := by linarith
    have h3 : 5 * Real.sqrt L ≤ Real.sqrt L * Real.sqrt L :=
      mul_le_mul_of_nonneg_right h5 hr0
    linarith
  have s2 : ∀ L : ℝ, 1 ≤ L → (1 + |K₂| * ((10 * a + 1).factorial : ℝ)) ^ 10 ≤ L →
      K₂ * L ^ a ≤ Real.exp (L ^ ((1:ℝ)/10)) := by
    intro L hL hB
    have hFpos : (0:ℝ) < ((10 * a + 1).factorial : ℝ) := by
      exact_mod_cast Nat.factorial_pos _
    have hK0 := abs_nonneg K₂
    have hB1 : (1:ℝ) ≤ 1 + |K₂| * ((10 * a + 1).factorial : ℝ) := by
      have := mul_nonneg hK0 hFpos.le
      linarith
    have ht0 : 0 ≤ L ^ ((1:ℝ)/10) := Real.rpow_nonneg (by linarith) _
    have ht10 : (L ^ ((1:ℝ)/10)) ^ (10:ℕ) = L := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by linarith)]
      norm_num
    have htB : 1 + |K₂| * ((10 * a + 1).factorial : ℝ) ≤ L ^ ((1:ℝ)/10) := by
      by_contra h
      push_neg at h
      have : (L ^ ((1:ℝ)/10)) ^ (10:ℕ) < (1 + |K₂| * ((10 * a + 1).factorial : ℝ)) ^ 10 :=
        pow_lt_pow_left₀ h ht0 (by norm_num)
      linarith
    have hLa : L ^ a = (L ^ ((1:ℝ)/10)) ^ (10 * a) := by rw [pow_mul, ht10]
    have hK : |K₂| * ((10 * a + 1).factorial : ℝ) ≤ L ^ ((1:ℝ)/10) := by linarith
    have hexp := Real.pow_div_factorial_le_exp (L ^ ((1:ℝ)/10)) ht0 (10 * a + 1)
    have htp : 0 ≤ (L ^ ((1:ℝ)/10)) ^ (10 * a) := pow_nonneg ht0 _
    have h1 : K₂ * L ^ a ≤ |K₂| * (L ^ ((1:ℝ)/10)) ^ (10 * a) := by
      rw [hLa]; exact mul_le_mul_of_nonneg_right (le_abs_self _) htp
    have h2 : |K₂| * (L ^ ((1:ℝ)/10)) ^ (10 * a)
        ≤ (L ^ ((1:ℝ)/10)) ^ (10 * a + 1) / ((10 * a + 1).factorial : ℝ) := by
      rw [le_div_iff₀ hFpos, pow_succ]
      have := mul_le_mul_of_nonneg_left hK htp
      nlinarith
    linarith
  have s3 : ∀ L : ℝ, 4 ≤ L → 16 * (a : ℝ) ^ 2 ≤ L →
      2 ^ (a + 1) * ((a + 1).factorial : ℝ) * |K₁| ≤ L →
      K₁ * L ^ a * Real.exp ((a : ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)))
        ≤ Real.exp (L - 1) := by
    intro L hL4 hLa hLK
    obtain ⟨hs0, hsr⟩ := hF L (by linarith)
    have hr0 := Real.sqrt_nonneg L
    have hrr := Real.mul_self_sqrt (show (0:ℝ) ≤ L by linarith)
    have ha0 : (0:ℝ) ≤ a := Nat.cast_nonneg a
    have h4a : 4 * (a:ℝ) ≤ Real.sqrt L := by
      by_contra h
      push_neg at h
      have : Real.sqrt L * Real.sqrt L < (4 * (a:ℝ)) * (4 * (a:ℝ)) :=
        mul_self_lt_mul_self hr0 h
      nlinarith
    have hc1 : (a:ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)) ≤ (a:ℝ) * Real.sqrt L :=
      mul_le_mul_of_nonneg_left hsr ha0
    have hc2 : 4 * (a:ℝ) * Real.sqrt L ≤ Real.sqrt L * Real.sqrt L :=
      mul_le_mul_of_nonneg_right h4a hr0
    have hc : (a:ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)) + 1 ≤ L / 2 := by nlinarith
    have hD : (0:ℝ) < 2 ^ (a + 1) * ((a + 1).factorial : ℝ) := by
      have : (0:ℝ) < ((a + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
      positivity
    have hexp := Real.pow_div_factorial_le_exp (L / 2) (by linarith) (a + 1)
    rw [div_pow, div_div] at hexp
    have hLpow : 0 ≤ L ^ a := pow_nonneg (by linarith) a
    have he : |K₁| * L ^ a ≤ L ^ (a + 1) / (2 ^ (a + 1) * ((a + 1).factorial : ℝ)) := by
      rw [le_div_iff₀ hD]
      have := mul_le_mul_of_nonneg_right hLK hLpow
      calc |K₁| * L ^ a * (2 ^ (a + 1) * ((a + 1).factorial : ℝ))
          = 2 ^ (a + 1) * ((a + 1).factorial : ℝ) * |K₁| * L ^ a := by ring
        _ ≤ L * L ^ a := this
        _ = L ^ (a + 1) := by ring
    have hE := Real.exp_pos ((a : ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)))
    calc K₁ * L ^ a * Real.exp ((a : ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)))
        ≤ |K₁| * L ^ a * Real.exp ((a : ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3))) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self K₁) hLpow) hE.le
      _ ≤ Real.exp (L / 2) * Real.exp ((a : ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3))) :=
          mul_le_mul_of_nonneg_right (by linarith) hE.le
      _ ≤ Real.exp ((L - 1) - (a : ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3)))
            * Real.exp ((a : ℝ) * (L ^ ((1:ℝ)/10) * L ^ ((1:ℝ)/3))) :=
          mul_le_mul_of_nonneg_right (Real.exp_le_exp.2 (by linarith)) hE.le
      _ = Real.exp (L - 1) := by rw [← Real.exp_add]; congr 1; ring
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = max (max 25 (16 * (a:ℝ) ^ 2))
      (max (2 ^ (a + 1) * ((a + 1).factorial : ℝ) * |K₁|)
        ((1 + |K₂| * ((10 * a + 1).factorial : ℝ)) ^ 10)) := ⟨_, rfl⟩
  have hT25 : 25 ≤ T := by rw [hT]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hTa : 16 * (a:ℝ) ^ 2 ≤ T := by
    rw [hT]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hTK1 : 2 ^ (a + 1) * ((a + 1).factorial : ℝ) * |K₁| ≤ T := by
    rw [hT]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hTK2 : (1 + |K₂| * ((10 * a + 1).factorial : ℝ)) ^ 10 ≤ T := by
    rw [hT]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  refine ⟨Real.exp T, ?_, ?_⟩
  · have := Real.add_one_le_exp T; linarith
  · intro M hM
    have hL : T ≤ Real.log M := by
      rw [← Real.log_exp T]; exact Real.log_le_log (Real.exp_pos T) hM
    exact ⟨by linarith, s1 _ (by linarith), s3 _ (by linarith) (by linarith) (by linarith),
      s2 _ (by linarith) (by linarith)⟩

theorem kai_cramer_quad_minor_arc (K : Type u) [Field K] [NumberField K] (C : ℝ)
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ (c₀ Cm : ℝ) (A : ℕ), 0 < c₀ ∧ 1 ≤ Cm ∧ 1 ≤ A ∧
      ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
        Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
        (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
      ∀ η : ℝ, Real.exp (-(Real.log M ^ c₀)) ≤ η → η ≤ 1 →
      ∀ (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet Ω → Convex ℝ Ω →
      ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
        (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₀) →
      ∀ (a : NumberField.RingOfIntegers K) (p₀ : ℝ) (p₁ : Fin (Module.finrank ℚ K) → ℝ)
        (p₂ : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℝ),
        η * ((omegaBox ω M).card : ℝ) ≤
          ‖∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧ x - a ∈ 𝔮)
                (fun _ => Classical.propDecidable _) (omegaBox ω M),
              ((cramerModel K ρ (primorial m) x : ℝ) : ℂ)
                * giE (kaiQuadPoly p₀ p₁ p₂ (ω.equivFun x))‖ →
        ∃ q : ℕ, (q : ℝ) ≤ Real.exp (Cm * (1 + Real.log
              ((Ideal.absNorm 𝔮 : ℝ) * Real.log M / η)) ^ A) ∧
          KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q
            (Real.exp (Cm * (1 + Real.log ((Ideal.absNorm 𝔮 : ℝ) * Real.log M / η)) ^ A))
            (kaiQuadPoly p₀ p₁ p₂) :=
by
  classical
  have hn0 : 0 < Module.finrank ℚ K := Module.finrank_pos
  obtain ⟨C_M, hCM, hdens⟩ := kai_cramer_density_bound K
  obtain ⟨C₀, hC₀, hmert⟩ := kai_prime_recip_prod_bound
  obtain ⟨C₁, A₁, hC₁, hA₁, hTI⟩ :=
    kai_sieve_typeI_quad_inverse (Module.finrank ℚ K) (Module.finrank ℚ K : ℝ)
      (by exact_mod_cast hn0)
  have hC₀0 : 0 < C₀ := by linarith
  have hCM0 : 0 < C_M := by linarith
  obtain ⟨G, hG_def⟩ : ∃ G : ℝ,
      G = 2 * ρ * C₀ ^ Module.finrank ℚ K * C_M ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hG : 0 < G := by rw [hG_def]; positivity
  obtain ⟨K₁, hK₁_def⟩ : ∃ K₁ : ℝ, K₁ = C₁ * G ^ A₁ := ⟨_, rfl⟩
  have hK₁ : 0 < K₁ := by
    rw [hK₁_def]; exact mul_pos (by linarith) (pow_pos hG _)
  obtain ⟨K₂, hK₂_def⟩ : ∃ K₂ : ℝ, K₂ = 2 ^ (Module.finrank ℚ K + 1)
      * C₀ ^ (2 * Module.finrank ℚ K) * ρ * C_M ^ Module.finrank ℚ K := ⟨_, rfl⟩
  have hK₂ : 0 ≤ K₂ := by rw [hK₂_def]; positivity
  obtain ⟨a₀, ha₀_def⟩ : ∃ a₀ : ℕ,
      a₀ = 2 * Module.finrank ℚ K * A₁ + 7 * A₁ + 3 * Module.finrank ℚ K := ⟨_, rfl⟩
  obtain ⟨M₀, hM₀3, hthr⟩ := kai_cqm_thresholds K₁ K₂ a₀
  refine ⟨(1:ℝ)/10, max (max 1 (Real.log K₁))
      (max (2 * (Module.finrank ℚ K : ℝ) * A₁) (2 * Real.log M₀)), 1, by norm_num,
      le_trans (le_max_left _ _) (le_max_left _ _), le_rfl, ?_⟩
  intro M m hM3 hm1 hm2 η hη1 hη2 Ω hΩm hΩc 𝔮 h𝔮 hQ a p₀ p₁ p₂ hyp
  obtain ⟨Cm, hCm_def⟩ : ∃ Cm : ℝ, Cm = max (max 1 (Real.log K₁))
      (max (2 * (Module.finrank ℚ K : ℝ) * A₁) (2 * Real.log M₀)) := ⟨_, rfl⟩
  rw [← hCm_def]
  have hCm1 : 1 ≤ Cm := by
    rw [hCm_def]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hCmK : Real.log K₁ ≤ Cm := by
    rw [hCm_def]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hCmA : 2 * (Module.finrank ℚ K : ℝ) * A₁ ≤ Cm := by
    rw [hCm_def]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hCmM : 2 * Real.log M₀ ≤ Cm := by
    rw [hCm_def]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hMpos : 0 < M := by linarith
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ, Real.log M = ℓ := ⟨_, rfl⟩
  rw [hℓ] at hm1 hm2 hη1 hQ
  rw [hℓ]
  have hℓ1 : 1 ≤ ℓ := by
    rw [← hℓ, Real.le_log_iff_exp_le hMpos]
    have := Real.exp_one_lt_d9; linarith
  have hηpos : 0 < η := lt_of_lt_of_le (Real.exp_pos _) hη1
  have hQ0ne : Ideal.absNorm 𝔮 ≠ 0 := fun h => h𝔮 (Ideal.absNorm_eq_zero_iff.mp h)
  have hQ1n : 1 ≤ Ideal.absNorm 𝔮 := Nat.one_le_iff_ne_zero.mpr hQ0ne
  have hQ1 : (1:ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ) := by exact_mod_cast hQ1n
  obtain ⟨X, hX_def⟩ : ∃ X : ℝ, X = (Ideal.absNorm 𝔮 : ℝ) * ℓ / η := ⟨_, rfl⟩
  rw [← hX_def]
  have hX1 : 1 ≤ X := by
    rw [hX_def, le_div_iff₀ hηpos]
    have h := mul_le_mul hQ1 hℓ1 zero_le_one (by linarith : (0:ℝ) ≤ (Ideal.absNorm 𝔮 : ℝ))
    linarith
  have hXpos : 0 < X := by linarith
  have hlogX : 0 ≤ Real.log X := Real.log_nonneg hX1
  have hΦ : Real.exp Cm ≤ Real.exp (Cm * (1 + Real.log X) ^ 1) := by
    apply Real.exp_le_exp.mpr; rw [pow_one]
    have h := mul_le_mul_of_nonneg_left (by linarith : (1:ℝ) ≤ 1 + Real.log X)
      (by linarith : (0:ℝ) ≤ Cm)
    linarith
  have hN3 : 3 ≤ ⌊M⌋₊ := Nat.le_floor (by exact_mod_cast hM3)
  have hN3r : (3:ℝ) ≤ (⌊M⌋₊ : ℝ) := by exact_mod_cast hN3
  have hNM : (⌊M⌋₊ : ℝ) ≤ M := Nat.floor_le hMpos.le
  have hMN : M < (⌊M⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one M
  have hmono : ∀ (q : ℕ) (T T' : ℝ) (P : (Fin (Module.finrank ℚ K) → ℤ) → ℝ), T ≤ T' →
      KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q T P →
      KaiQuadMajor (Module.finrank ℚ K) ⌊M⌋₊ q T' P := by
    intro q T T' P hTT hP
    obtain ⟨hq, γ, b, a', e, θ, h1, h2, h3⟩ := hP
    exact ⟨hq, γ, b, a', e, θ,
      fun l => (h1 l).trans (div_le_div_of_nonneg_right hTT (by positivity)),
      fun l l' => (h2 l l').trans (div_le_div_of_nonneg_right hTT (by positivity)), h3⟩
  by_cases hsmall : M < M₀
  · 
    have hM₀pos : 0 < M₀ := by linarith
    have hM₀sq : M₀ ^ 2 ≤ Real.exp Cm := by
      have he : Real.exp (2 * Real.log M₀) = M₀ ^ 2 := by
        rw [two_mul, Real.exp_add, Real.exp_log hM₀pos]; ring
      rw [← he]; exact Real.exp_le_exp.mpr hCmM
    have hNsq : (⌊M⌋₊ : ℝ) ^ 2 ≤ Real.exp (Cm * (1 + Real.log X) ^ 1) := by
      have h1 : (⌊M⌋₊ : ℝ) ^ 2 ≤ M₀ ^ 2 := pow_le_pow_left₀ (by positivity) (by linarith) 2
      linarith
    refine ⟨1, ?_, le_rfl, p₀, fun l => round (p₁ l), fun l l' => round (p₂ l l'),
      fun l => p₁ l - round (p₁ l), fun l l' => p₂ l l' - round (p₂ l l'), ?_, ?_, ?_⟩
    · have : (1:ℝ) ≤ Real.exp Cm := Real.one_le_exp (by linarith)
      push_cast; linarith
