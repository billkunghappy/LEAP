    have h := Finset.sum_le_card_nsmul B (fun I => kaiZFVonMangoldt K I) (Real.log x) hwt
    rwa [nsmul_eq_mul] at h
  refine le_trans hsum ?_
  have h6 := mul_le_mul_of_nonneg_right hcardR hLnn
  have hnn : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) * (x - y + 1) * Real.log x :=
    mul_nonneg (mul_nonneg hn0 (by linarith)) hLnn
  linarith

theorem kai_lp_chebyshev (K : Type u) [Field K] [NumberField K] :
    ∃ CK : ℝ, 1 ≤ CK ∧
      ∀ lam : Ideal (NumberField.RingOfIntegers K) → ℂ,
        (∀ I : Ideal (NumberField.RingOfIntegers K), ‖lam I‖ ≤ 1) →
        (∀ x : ℝ, 3 ≤ x →
            ‖(∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
                  P.IsPrime ∧ P ≠ ⊥ ∧ (Ideal.absNorm P : ℝ) ≤ x},
                lam (P : Ideal (NumberField.RingOfIntegers K)) *
                  ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ))‖
              ≤ CK * x ∧
            ‖(∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
                  P.IsPrime ∧ P ≠ ⊥ ∧ (Ideal.absNorm P : ℝ) ≤ x},
                lam (P : Ideal (NumberField.RingOfIntegers K)) *
                  ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ))
              - (∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                  I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x},
                ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
                  lam (I : Ideal (NumberField.RingOfIntegers K)))‖
              ≤ CK * Real.sqrt x * Real.log x ^ 2 ∧
            ∀ y : ℝ, 0 ≤ y → y ≤ x →
              ‖(∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ x},
                  ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
                    lam (I : Ideal (NumberField.RingOfIntegers K)))
                - (∑' I : {I : Ideal (NumberField.RingOfIntegers K) //
                    I ≠ 0 ∧ (Ideal.absNorm I : ℝ) ≤ y},
                  ((kaiZFVonMangoldt K (I : Ideal (NumberField.RingOfIntegers K)) : ℝ) : ℂ) *
                    lam (I : Ideal (NumberField.RingOfIntegers K)))‖
                ≤ CK * (x - y + 1) * Real.log x) ∧
        (∀ κ : ℝ, 1 < κ → κ ≤ 2 →
