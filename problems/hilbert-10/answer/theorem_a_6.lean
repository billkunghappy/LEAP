  refine ⟨hl1, hΔ, hΔθ, le_trans hbud ?_⟩
  calc Ks * Real.exp (M * u) * Real.exp (-(δ * u ^ 2)) * X ^ n
      = Ks * (Real.exp (M * u) * Real.exp (-(δ * u ^ 2))) * X ^ n := by ring
    _ ≤ Ks * Real.exp (-(δ / 2 * u ^ 2)) * X ^ n := by gcongr
    _ ≤ max (Ks + 1) (2 / δ) * Real.exp (-Real.sqrt (Real.log X) / max (Ks + 1) (2 / δ))
          * X ^ n := by gcongr
    _ = max (Ks + 1) (2 / δ) * X ^ n
          * Real.exp (-Real.sqrt (Real.log X) / max (Ks + 1) (2 / δ)) := by ring

theorem kai_lp_cell_of_torus_box (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ B c₂ : ℝ, 1 ≤ B → 0 < c₂ → ∃ c X₀ : ℝ, 0 < c ∧ 3 ≤ X₀ ∧
      ∀ X : ℝ, X₀ ≤ X →
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        (Ideal.absNorm q : ℝ) ≤ Real.exp (Real.log X ^ ((1:ℝ)/4)) →
      ∀ (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ) (wq : ℕ)
        (Rq : ℝ) (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ),
        KaiTBUnitData K B q H wq Rq e →
      ∀ α : NumberField.RingOfIntegers K, IsCoprime (Ideal.span {α}) q →
      ∀ ε β : ℝ, |ε| ≤ 1 → (ε = 0 ∨ (1 / 2 ≤ β ∧ β < 1)) →
      (∀ x : ℝ, X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)) ≤ x →
        ∀ u γ : Fin (NumberField.Units.rank K) → ℝ, (∀ j, 0 < γ j ∧ γ j ≤ 1) →
        ∀ vv ϑ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ,
          (∀ p, 0 < ϑ p ∧ ϑ p ≤ 1) →
          |(∑' π : {π : NumberField.RingOfIntegers K //
                KaiTBMem K q H e α
                  (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w))
                  u γ vv ϑ x π},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            - (∏ j, γ j) * (∏ p, ϑ p) *
              (((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
                (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
                  (NumberField.classNumber K : ℝ) *
                  (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
                  NumberField.Units.regulator K)) * (x - ε * (x ^ β / β))|
            ≤ c₂ * x * Real.exp (-Real.sqrt (Real.log x) / c₂)) →
      ∀ (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
        (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
        (∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ Real.sqrt X ≤ b w - a w ∧
          ((0 ≤ a w ∧ 0 < (NumberField.mixedEmbedding K (α : K)).1 w) ∨
           (b w ≤ 0 ∧ (NumberField.mixedEmbedding K (α : K)).1 w < 0))) →
        (∀ w, 0 ≤ ρ w ∧ ρ w < σ w ∧ σ w ≤ X ∧ Real.sqrt X ≤ σ w - ρ w ∧
          -Real.pi ≤ θ₁ w ∧ θ₁ w ≤ θ₂ w ∧ θ₂ w ≤ Real.pi) →
        |kaiPrimePsi K q α (kaiCell K a b ρ σ θ₁ θ₂)
          - (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (θ₂ p - θ₁ p)) /
              (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
            (((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
              (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
                (NumberField.classNumber K : ℝ) *
                (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
                NumberField.Units.regulator K)) *
            (kaiTBShapePow K H a b ρ σ 1 - ε * (kaiTBShapePow K H a b ρ σ β / β))|
          ≤ c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) :=
by
  intro B c₂ hB hc₂
  obtain ⟨c₁, X₁, hc₁, hX₁, hs1⟩ := kai_lp_cell_small_norm K B c₂ hB hc₂
  obtain ⟨C₁, hC₁, hs2⟩ := kai_lp_cell_cube_sum K B c₂ hB hc₂
  obtain ⟨C₂, hC₂, hs3⟩ := kai_lp_trunc_riemann_sum K B hB
  obtain ⟨c₄, X₄, hc₄, hX₄, hs4⟩ := kai_lp_shape_trunc_tail K B hB
  have hn1 : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  have hR : 0 < NumberField.Units.regulator K := NumberField.Units.regulator_pos K
  have hKq : 0 ≤ ((NumberField.Units.torsionOrder K : ℕ) : ℝ) * B
      / NumberField.Units.regulator K :=
    div_nonneg (mul_nonneg (Nat.cast_nonneg _) (by linarith)) hR.le
  obtain ⟨c₅, X₅, hc₅, hX₅, hs5⟩ := kai_lp_cell_error_budget (Module.finrank ℚ K)
    (NumberField.Units.rank K) hn1 B c₂ C₁ C₂
    (((NumberField.Units.torsionOrder K : ℕ) : ℝ) * B / NumberField.Units.regulator K)
    hB hc₂ hC₁.le hC₂.le hKq
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = max (max c₁ c₄) c₅ := ⟨_, rfl⟩
  have hc₁M : c₁ ≤ M := by rw [hM]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hc₄M : c₄ ≤ M := by rw [hM]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hc₅M : c₅ ≤ M := by rw [hM]; exact le_max_right _ _
  have hM0 : 0 < M := lt_of_lt_of_le hc₁ hc₁M
  
  have key : ∀ (Ψ Ψab Θ Cq GS IF SP Xn s A P D R3 KN : ℝ),
      |Ψ - Ψab| ≤ c₁ * Xn * Real.exp (-s / c₁) →
      |Ψab - Θ * Cq * GS| ≤ C₁ * (A + P * Cq * D * Xn) →
      |GS - IF| ≤ R3 →
      |Θ * Cq * SP - Θ * Cq * IF| ≤ c₄ * Xn * Real.exp (-s / c₄) →
      C₁ * (A + P * KN * D * Xn) + KN * R3 ≤ c₅ * Xn * Real.exp (-s / c₅) →
      0 ≤ Θ → Θ ≤ 1 → 0 ≤ Cq → Cq ≤ KN → 0 ≤ P → 0 ≤ D → 0 ≤ Xn → 0 ≤ s →
      |Ψ - Θ * Cq * SP| ≤ 3 * M * Xn * Real.exp (-s / (3 * M)) := by
    intro Ψ Ψab Θ Cq GS IF SP Xn s A P D R3 KN h1 h2 h3 h4 h5 hΘ0 hΘ1 hCq0 hCqK hP hD hXn hs
    have hΘC : 0 ≤ Θ * Cq := mul_nonneg hΘ0 hCq0
    have hΘCle : Θ * Cq ≤ KN := le_trans (mul_le_of_le_one_left hCq0 hΘ1) hCqK
    have e3 : |Θ * Cq * GS - Θ * Cq * IF| ≤ KN * R3 := by
      rw [← mul_sub, abs_mul, abs_of_nonneg hΘC]
      exact mul_le_mul hΘCle h3 (abs_nonneg _) (le_trans hΘC hΘCle)
    have hmono : P * Cq * D * Xn ≤ P * KN * D * Xn :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hCqK hP) hD) hXn
    have e2 : |Ψab - Θ * Cq * GS| ≤ C₁ * (A + P * KN * D * Xn) :=
      le_trans h2 (mul_le_mul_of_nonneg_left (by linarith) hC₁.le)
    have bound : ∀ d : ℝ, 0 < d → d ≤ M →
        d * Xn * Real.exp (-s / d) ≤ M * Xn * Real.exp (-s / (3 * M)) := by
      intro d hd hdM
      have hexp : Real.exp (-s / d) ≤ Real.exp (-s / (3 * M)) := by
        apply Real.exp_le_exp.mpr
        rw [neg_div, neg_div, neg_le_neg_iff]
        exact div_le_div_of_nonneg_left hs hd (by linarith)
      exact mul_le_mul (mul_le_mul_of_nonneg_right hdM hXn) hexp (Real.exp_pos _).le
        (mul_nonneg hM0.le hXn)
    have b1 := bound c₁ hc₁ hc₁M
    have b4 := bound c₄ hc₄ hc₄M
    have b5 := bound c₅ hc₅ hc₅M
    obtain ⟨h1a, h1b⟩ := abs_le.mp h1
    obtain ⟨e2a, e2b⟩ := abs_le.mp e2
    obtain ⟨e3a, e3b⟩ := abs_le.mp e3
    obtain ⟨h4a, h4b⟩ := abs_le.mp h4
    rw [abs_le]
    constructor <;> nlinarith
  refine ⟨3 * M, max (max X₁ X₄) (max X₅ (Real.exp 8)), by positivity,
    le_trans hX₁ (le_trans (le_max_left _ _) (le_max_left _ _)), ?_⟩
  intro X hX q hq hqN H wq Rq e hdata α hα ε β hε hεβ hTB a b ρ σ θ₁ θ₂ hab hρσ
  have hX1 : X₁ ≤ X := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hX
  have hX4 : X₄ ≤ X := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hX
  have hX5 : X₅ ≤ X := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hX
  have hXe : Real.exp 8 ≤ X := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hX
  have hX3 : (3 : ℝ) ≤ X := le_trans hX₁ hX1
  have hXpos : 0 < X := by linarith
  
  have hN1 : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    have h0 : Ideal.absNorm q ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]; exact hq
    exact_mod_cast Nat.pos_of_ne_zero h0
  
  have hℓ : 8 ≤ Real.log X := by
    have := Real.log_le_log (Real.exp_pos 8) hXe
    rwa [Real.log_exp] at this
  have hs0 : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hss : Real.sqrt (Real.log X) ^ 2 = Real.log X := Real.sq_sqrt (by linarith)
  have hs83 : 8 / 3 ≤ Real.sqrt (Real.log X) := by nlinarith
  have hXn : 0 < X ^ (Module.finrank ℚ K) := pow_pos hXpos _
  have hnR : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := by exact_mod_cast hn1
  have hlogT : Real.log (X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)))
      = (Module.finrank ℚ K : ℝ) * Real.log X - 2 * Real.sqrt (Real.log X) := by
    rw [Real.log_mul hXn.ne' (Real.exp_pos _).ne', Real.log_pow, Real.log_exp]; ring
  have hlogT4 : Real.log X / 4
      ≤ Real.log (X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X))) := by
    rw [hlogT]
    have h1 : Real.log X ≤ (Module.finrank ℚ K : ℝ) * Real.log X := by
      nlinarith
    have h2 : 0 ≤ Real.sqrt (Real.log X) * (3 / 4 * Real.sqrt (Real.log X) - 2) :=
      mul_nonneg hs0 (by linarith)
    nlinarith
  have hT0pos : 0 < X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)) :=
    mul_pos hXn (Real.exp_pos _)
  have hT3 : (3 : ℝ) ≤ X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)) := by
    have h2 : 2 ≤ Real.log (X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X))) := by
      linarith
    have h3 := Real.add_one_le_exp 2
    calc (3 : ℝ) ≤ Real.exp 2 := by linarith
      _ ≤ Real.exp (Real.log (X ^ (Module.finrank ℚ K)
            * Real.exp (-2 * Real.sqrt (Real.log X)))) := Real.exp_le_exp.mpr h2
      _ = X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)) :=
            Real.exp_log hT0pos
  have hTX : X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X))
      ≤ X ^ (Module.finrank ℚ K) :=
    mul_le_of_le_one_right hXn.le (Real.exp_le_one_iff.mpr (by linarith))
  
  have hE0 : 0 ≤ Real.exp (-Real.sqrt (Real.log X) / (2 * c₂)) := (Real.exp_pos _).le
  have hE : ∀ x : ℝ, X ^ (Module.finrank ℚ K) * Real.exp (-2 * Real.sqrt (Real.log X)) ≤ x →
      Real.exp (-Real.sqrt (Real.log x) / c₂)
        ≤ Real.exp (-Real.sqrt (Real.log X) / (2 * c₂)) := by
    intro x hx
    have hlx : Real.log X / 4 ≤ Real.log x := le_trans hlogT4 (Real.log_le_log hT0pos hx)
    have hsq : Real.sqrt (Real.log X) / 2 ≤ Real.sqrt (Real.log x) := by
      calc Real.sqrt (Real.log X) / 2 = Real.sqrt ((Real.sqrt (Real.log X) / 2) ^ 2) :=
