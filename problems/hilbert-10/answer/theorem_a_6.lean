    rw [hcast, Real.log_pow]
    refine mul_le_mul_of_nonneg_right ?_ (Real.log_natCast_nonneg _)
    exact_mod_cast hdeg P hP1 hP2
  have hinj : Set.InjOn (fun P : Ideal (NumberField.RingOfIntegers K) => (col P, rchar P))
      (hfin.toFinset : Finset (Ideal (NumberField.RingOfIntegers K))) := by
    intro P hP Q hQ hPQ
    obtain ⟨hP1, hP2, -⟩ := hfin.mem_toFinset.mp (Finset.mem_coe.mp hP)
    obtain ⟨hQ1, hQ2, -⟩ := hfin.mem_toFinset.mp (Finset.mem_coe.mp hQ)
    have h1 : col P = col Q := congrArg Prod.fst hPQ
    have h2 : rchar P = rchar Q := congrArg Prod.snd hPQ
