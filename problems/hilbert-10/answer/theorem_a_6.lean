by
  classical
  obtain ⟨hCw1, -, -⟩ := kai_qwi_param_bounds ν 1 one_pos le_rfl
  refine ⟨5 * 2 ^ (2 * ν + 7) * (2 ^ (ν + 2)) ^ (ν * ν)
      * (1 + 7 * (2 * (ν : ℝ) + 1) * 2 ^ (3 * ν + 1)), 4 * ν * ν + 14, hCw1, by omega, ?_⟩
