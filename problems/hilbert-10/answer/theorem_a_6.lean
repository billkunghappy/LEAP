    have hinv : 0 < 1 / (M + K + 1) := by positivity
    set t := min (min ε δ) (1 / (M + K + 1)) / 2 with ht_def
    have ht : 0 < t := by positivity
    have hm1 := min_le_left (min ε δ) (1 / (M + K + 1))
    have hm2 := min_le_right (min ε δ) (1 / (M + K + 1))
    have hm3 := min_le_left ε δ
    have hm4 := min_le_right ε δ
    have htε : t < ε := by linarith
    have htδ : t < δ := by linarith
    have htM : t < 1 / (M + K + 1) := by linarith
