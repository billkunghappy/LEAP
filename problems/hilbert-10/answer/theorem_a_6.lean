theorem kai_nil2_orthogonality_reduction (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) (ρ : ℝ) (hρ : 0 < ρ)
    (D : ℝ → ℕ → Ideal (NumberField.RingOfIntegers K) ×
        (NumberField.RingOfIntegers K → ℤ) × ℝ)
    (hD : ∀ (M : ℝ) (m : ℕ), IsSiegelDatum m (D M m))
    (hSiegel : ∀ A : ℕ, ∃ cA : ℝ, 0 < cA ∧
        ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
          Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
          (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
          (D M m).2.1 ≠ 0 →
          cA * Real.log M ^ A ≤ (Ideal.absNorm (D M m).1 : ℝ))
    (c₁ C₁ : ℝ) (hc₁ : 0 < c₁) (hC₁ : 0 ≤ C₁)
    (hStep0 : ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
        Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
        (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
        ∀ (Ω : Set (Fin (Module.finrank ℚ K) → ℝ)), MeasurableSet Ω → Convex ℝ Ω →
        ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)), 𝔮 ≠ ⊥ →
          (Ideal.absNorm 𝔮 : ℝ) ≤ Real.exp (Real.log M ^ c₁) →
        ∀ a : NumberField.RingOfIntegers K,
          |∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
                (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧ x - a ∈ 𝔮)
                (fun _ => Classical.propDecidable _) (omegaBox ω M),
              (vonMangoldtO x
                - siegelModel K ρ (primorial m) (D M m).2.1 (D M m).2.2 x)|
            ≤ C₁ * ((omegaBox ω M).card : ℝ) * Real.exp (-(Real.log M ^ c₁)))
    (cW CW : ℝ) (kW : ℕ) (hcW : 0 < cW) (hCW : 0 ≤ CW)
    (hU3 : ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
        Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
        (m : ℝ) + 1 ≤ Real.exp (Real.log M ^ ((1:ℝ)/3)) →
        (D M m).2.1 ≠ 0 →
        gowersU3Pow ω (fun x => siegelModel K ρ (primorial m) (D M m).2.1 (D M m).2.2 x
            - cramerModel K ρ (primorial m) x) M
          ≤ CW * Real.log M ^ kW / (Ideal.absNorm (D M m).1 : ℝ) ^ cW) :
    ∃ (c C₀ : ℝ), 0 < c ∧ 1 ≤ C₀ ∧
      ∀ (M : ℝ) (m : ℕ), 3 ≤ M →
        Real.exp (Real.log M ^ ((1:ℝ)/100)) ≤ (m : ℝ) →
