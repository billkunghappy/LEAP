    have hNae : 4 * R' / (N * a) ≤ ep := by
      have h1 : 4 * R' / (a * ep) ≤ max (4 * R' / a) (4 * R' / (a * ep)) := le_max_right _ _
      have h2 : 4 * R' / (a * ep) < N := by rw [hNdef]; linarith
      rw [div_lt_iff₀ (by positivity : (0:ℝ) < a * ep)] at h2
      rw [div_le_iff₀ hNapos]
