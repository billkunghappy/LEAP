by
  classical
  
  have factorZeros : ∀ (f : ℂ → ℂ) (c : ℂ) (R : ℝ), Differentiable ℂ f → 0 < R → f c ≠ 0 →
      ∃ (Z : Finset ℂ) (m : ℂ → ℕ) (h : ℂ → ℂ),
        Differentiable ℂ h ∧
        (∀ ρ : ℂ, ρ ∈ Z ↔ (ρ ∈ Metric.closedBall c R ∧ f ρ = 0)) ∧
        (∀ ρ ∈ Z, 1 ≤ m ρ) ∧
        (∀ z ∈ Metric.closedBall c R, h z ≠ 0) ∧
        (∀ z : ℂ, f z = (∏ ρ ∈ Z, (z - ρ) ^ m ρ) * h z) ∧
        (∀ ρ ∈ Z, 2 ≤ m ρ → deriv f ρ = 0) := by
    intro f c R hf hR hc
    have hid : ∀ u : ℂ → ℂ, Differentiable ℂ u → u c ≠ 0 → ∀ ρ : ℂ,
        ¬ (∃ᶠ z in nhdsWithin ρ ({ρ}ᶜ : Set ℂ), u z = 0) := by
      intro u hu huc ρ hfr
      have hana : AnalyticOnNhd ℂ u Set.univ := fun w _ => hu.analyticAt w
      have heq := hana.eqOn_zero_of_preconnected_of_frequently_eq_zero
        isPreconnected_univ (Set.mem_univ ρ) hfr
      exact huc (by simpa using heq (Set.mem_univ c))
    have hfin : {z : ℂ | z ∈ Metric.closedBall c R ∧ f z = 0}.Finite := by
      by_contra hcon
      have hinf : {z : ℂ | z ∈ Metric.closedBall c R ∧ f z = 0}.Infinite := hcon
      obtain ⟨x, -, hacc⟩ := hinf.exists_accPt_of_subset_isCompact
        (isCompact_closedBall c R) (fun z hz => hz.1)
      have hfr : ∃ᶠ z in nhdsWithin x ({x}ᶜ : Set ℂ), f z = 0 := by
        rw [frequently_nhdsWithin_iff]
        exact (accPt_iff_frequently.mp hacc).mono (fun y hy => ⟨hy.2.2, hy.1⟩)
      exact hid f hf hc x hfr
    have hpt : ∀ u : ℂ → ℂ, Differentiable ℂ u → u c ≠ 0 → ∀ ρ : ℂ,
        ∃ (n : ℕ) (g : ℂ → ℂ), Differentiable ℂ g ∧ g ρ ≠ 0 ∧
          ∀ z : ℂ, u z = (z - ρ) ^ n * g z := by
      intro u hu huc ρ
      have hnev : ¬ (∀ᶠ z in nhds ρ, u z = 0) := by
        intro hev
        exact hid u hu huc ρ ((hev.filter_mono nhdsWithin_le_nhds).frequently)
      obtain ⟨n, g₀, hg₀a, hg₀ne, hg₀ev⟩ :=
        (hu.analyticAt ρ).exists_eventuallyEq_pow_smul_nonzero_iff.mpr hnev
      have hEv : ∀ᶠ z in nhdsWithin ρ ({ρ}ᶜ : Set ℂ), u z = (z - ρ) ^ n * g₀ z := by
        filter_upwards [hg₀ev.filter_mono nhdsWithin_le_nhds] with z hz
        simpa [smul_eq_mul] using hz
      have hcont : ∀ k : ℕ, ContinuousAt (fun z : ℂ => (z - ρ) ^ k * g₀ z) ρ := by
        intro k
        exact ContinuousAt.mul (by fun_prop) hg₀a.continuousAt
      have punct : ∀ p q : ℂ → ℂ, ContinuousAt p ρ → ContinuousAt q ρ →
          (∀ᶠ z in nhdsWithin ρ ({ρ}ᶜ : Set ℂ), p z = q z) → p ρ = q ρ := by
        intro p q hp hq hpq
        have h1 : Filter.Tendsto p (nhdsWithin ρ ({ρ}ᶜ : Set ℂ)) (nhds (p ρ)) :=
          hp.continuousWithinAt
        have h2 : Filter.Tendsto q (nhdsWithin ρ ({ρ}ᶜ : Set ℂ)) (nhds (q ρ)) :=
          hq.continuousWithinAt
        exact tendsto_nhds_unique (Filter.Tendsto.congr' hpq h1) h2
      have key : ∀ (k : ℕ) (v : ℂ → ℂ), Differentiable ℂ v → v c ≠ 0 →
          (∀ᶠ z in nhdsWithin ρ ({ρ}ᶜ : Set ℂ), v z = (z - ρ) ^ k * g₀ z) →
          ∃ g : ℂ → ℂ, Differentiable ℂ g ∧ g ρ ≠ 0 ∧
            ∀ z : ℂ, v z = (z - ρ) ^ k * g z := by
        intro k
        induction k with
        | zero =>
          intro v hv hvc hev
          have h0 : v ρ = (ρ - ρ) ^ 0 * g₀ ρ :=
            punct v (fun z => (z - ρ) ^ 0 * g₀ z) hv.continuous.continuousAt (hcont 0) hev
          refine ⟨v, hv, ?_, fun z => by simp⟩
          rw [h0]
          simpa using hg₀ne
        | succ n ih =>
          intro v hv hvc hev
          have hvρ : v ρ = 0 := by
            have hh := punct v (fun z => (z - ρ) ^ (n + 1) * g₀ z)
              hv.continuous.continuousAt (hcont (n + 1)) hev
            simpa using hh
          have hw : Differentiable ℂ (dslope v ρ) := by
            rw [← differentiableOn_univ]
            exact (Complex.differentiableOn_dslope Filter.univ_mem).mpr hv.differentiableOn
          have hdiv : ∀ z : ℂ, (z - ρ) * dslope v ρ z = v z := by
            intro z
            have hs := sub_smul_dslope v ρ z
            rw [smul_eq_mul] at hs
            rw [hs, hvρ, sub_zero]
          have hwc : dslope v ρ c ≠ 0 := by
            intro h0
            exact hvc (by rw [← hdiv c, h0, mul_zero])
          have hwev : ∀ᶠ z in nhdsWithin ρ ({ρ}ᶜ : Set ℂ),
              dslope v ρ z = (z - ρ) ^ n * g₀ z := by
            filter_upwards [hev, self_mem_nhdsWithin] with z hz hzne
            have hzρ : z - ρ ≠ 0 := sub_ne_zero.mpr hzne
            apply mul_left_cancel₀ hzρ
            rw [hdiv z, hz]
            ring
          obtain ⟨g, hg, hgρ, hgeq⟩ := ih (dslope v ρ) hw hwc hwev
          refine ⟨g, hg, hgρ, ?_⟩
          intro z
          rw [← hdiv z, hgeq z]
          ring
      obtain ⟨g, hg, hgρ, hgeq⟩ := key n u hu huc hEv
      exact ⟨n, g, hg, hgρ, hgeq⟩
    have hprod : ∀ (W : Finset ℂ) (F : ℂ → ℂ), Differentiable ℂ F → F c ≠ 0 →
        ∃ (m : ℂ → ℕ) (h : ℂ → ℂ), Differentiable ℂ h ∧
          (∀ ρ ∈ W, h ρ ≠ 0) ∧
          (∀ ρ ∈ W, F ρ = 0 → 1 ≤ m ρ) ∧
          (∀ z : ℂ, F z = (∏ ρ ∈ W, (z - ρ) ^ m ρ) * h z) := by
      intro W
      induction W using Finset.induction_on with
      | empty =>
        intro F hF hFc
        exact ⟨fun _ => 0, F, hF, by simp, by simp, by simp⟩
      | @insert a s ha ih =>
        intro F hF hFc
        obtain ⟨n, g, hg, hga, hgfac⟩ := hpt F hF hFc a
        have hgc : g c ≠ 0 := by
          intro h0
          exact hFc (by rw [hgfac c, h0, mul_zero])
        obtain ⟨m', h, hh, hhs, hm's, hfacs⟩ := ih g hg hgc
        refine ⟨Function.update m' a n, h, hh, ?_, ?_, ?_⟩
        · intro ρ hρ
          rcases Finset.mem_insert.mp hρ with rfl | hρs
          · intro h0
            exact hga (by rw [hfacs ρ, h0, mul_zero])
          · exact hhs ρ hρs
        · intro ρ hρ hFρ
          rcases Finset.mem_insert.mp hρ with rfl | hρs
          · rw [Function.update_self]
            rcases Nat.eq_zero_or_pos n with rfl | hn
            · exfalso
              apply hga
              have hgg := hgfac ρ
              rw [hFρ] at hgg
              simpa using hgg.symm
            · exact hn
          · have hρa : ρ ≠ a := by rintro rfl; exact ha hρs
            rw [Function.update_of_ne hρa]
            apply hm's ρ hρs
            have hne : (ρ - a) ^ n ≠ 0 := pow_ne_zero _ (sub_ne_zero.mpr hρa)
            have hgg := hgfac ρ
            rw [hFρ] at hgg
            exact (mul_eq_zero.mp hgg.symm).resolve_left hne
        · intro z
          have hupd : ∀ ρ ∈ s, (z - ρ) ^ (Function.update m' a n ρ) = (z - ρ) ^ (m' ρ) := by
            intro ρ hρs
            have hρa : ρ ≠ a := by rintro rfl; exact ha hρs
            rw [Function.update_of_ne hρa]
          rw [Finset.prod_insert ha, Function.update_self, Finset.prod_congr rfl hupd,
            hgfac z, hfacs z]
          ring
    obtain ⟨m, h, hh, hhZ, hm1, hfac⟩ := hprod hfin.toFinset f hf hc
    have hmem : ∀ ρ : ℂ, ρ ∈ hfin.toFinset ↔ (ρ ∈ Metric.closedBall c R ∧ f ρ = 0) := by
      intro ρ
      exact Set.Finite.mem_toFinset hfin
    refine ⟨hfin.toFinset, m, h, hh, hmem, ?_, ?_, hfac, ?_⟩
    · intro ρ hρ
      exact hm1 ρ hρ ((hmem ρ).mp hρ).2
    · intro z hz hz0
      by_cases hfz : f z = 0
      · exact hhZ z ((hmem z).mpr ⟨hz, hfz⟩) hz0
      · exact hfz (by rw [hfac z, hz0, mul_zero])
    · intro ρ hρ hm2
      have hQd : Differentiable ℂ (fun z : ℂ =>
          (∏ ρ' ∈ hfin.toFinset.erase ρ, (z - ρ') ^ m ρ') * h z) := by
        have hre : (fun z : ℂ => ∏ ρ' ∈ hfin.toFinset.erase ρ, (z - ρ') ^ m ρ')
            = ∏ ρ' ∈ hfin.toFinset.erase ρ, (fun z : ℂ => (z - ρ') ^ m ρ') := by
          funext z; simp
        have hP : Differentiable ℂ
            (fun z : ℂ => ∏ ρ' ∈ hfin.toFinset.erase ρ, (z - ρ') ^ m ρ') := by
          rw [hre]
          exact Differentiable.finset_prod (fun i _ => by fun_prop)
        exact hP.mul hh
      have hfac2 : ∀ z : ℂ, f z = (z - ρ) ^ m ρ *
          ((∏ ρ' ∈ hfin.toFinset.erase ρ, (z - ρ') ^ m ρ') * h z) := by
        intro z
        rw [hfac z, ← Finset.mul_prod_erase hfin.toFinset (fun ρ' => (z - ρ') ^ m ρ') hρ,
          mul_assoc]
      have hlin : HasDerivAt (fun z : ℂ => z - ρ) 1 ρ := (hasDerivAt_id ρ).sub_const ρ
      have hpow : HasDerivAt (fun z : ℂ => (z - ρ) ^ m ρ) 0 ρ := by
        have h1 := hlin.pow (m ρ)
        have hne : m ρ - 1 ≠ 0 := by omega
        rw [sub_self, zero_pow hne, mul_zero, zero_mul] at h1
        exact h1
      have hmul : HasDerivAt (fun z : ℂ => (z - ρ) ^ m ρ *
          ((∏ ρ' ∈ hfin.toFinset.erase ρ, (z - ρ') ^ m ρ') * h z)) 0 ρ := by
        have hprodrule := hpow.mul ((hQd ρ).hasDerivAt)
        have hne : m ρ ≠ 0 := by omega
        simpa [zero_pow hne] using hprodrule
      have hfe : f = fun z : ℂ => (z - ρ) ^ m ρ *
          ((∏ ρ' ∈ hfin.toFinset.erase ρ, (z - ρ') ^ m ρ') * h z) := funext hfac2
      rw [hfe]
      exact hmul.deriv
  
  have blaschke : ∀ (f h : ℂ → ℂ) (c : ℂ) (r M : ℝ) (Z : Finset ℂ) (m : ℂ → ℕ),
      0 < r → Differentiable ℂ f → Differentiable ℂ h → f c ≠ 0 →
      (∀ ρ ∈ Z, ρ ∈ Metric.closedBall c (r / 2)) →
      (∀ z : ℂ, f z = (∏ ρ ∈ Z, (z - ρ) ^ m ρ) * h z) →
      (∀ z ∈ Metric.closedBall c r, ‖f z‖ ≤ M * ‖f c‖) →
      (2 : ℝ) ^ (∑ ρ ∈ Z, m ρ) ≤ M ∧
        ∀ z ∈ Metric.closedBall c r, ‖h z‖ ≤ M * ‖h c‖ := by
    intro f h c r M Z m hr hf hh hc hZ hfac hM
    set N : ℕ := ∑ ρ ∈ Z, m ρ with hN
    have maxmod : ∀ (F : ℂ → ℂ) (C : ℝ), Differentiable ℂ F →
        (∀ z ∈ Metric.sphere c r, ‖F z‖ ≤ C) →
        ∀ z ∈ Metric.closedBall c r, ‖F z‖ ≤ C := by
      intro F C hF hb z hz
      refine Complex.norm_le_of_forall_mem_frontier_norm_le (U := Metric.ball c r)
        Metric.isBounded_ball hF.diffContOnCl ?_ ?_
      · rw [frontier_ball c hr.ne']
        exact hb
      · rw [closure_ball c hr.ne']
        exact hz
    have hfc0 : 0 < ‖f c‖ := norm_pos_iff.mpr hc
    have hcmem : c ∈ Metric.closedBall c r := Metric.mem_closedBall_self hr.le
    have hM1 : (1 : ℝ) ≤ M := by
      have h0 := hM c hcmem
      refine le_of_mul_le_mul_right ?_ hfc0
      linarith
    have hM0 : (0 : ℝ) ≤ M := by linarith
    have hhc : h c ≠ 0 := by
      intro h0
      exact hc (by rw [hfac c, h0, mul_zero])
    have hhc0 : 0 < ‖h c‖ := norm_pos_iff.mpr hhc
    have hr2 : (0 : ℝ) < r / 2 := by linarith
    have hK : (0 : ℝ) < (r / 2) ^ N := pow_pos hr2 N
    have hrN : (0 : ℝ) < r ^ N := pow_pos hr N
    have h2N : (0 : ℝ) < (2 : ℝ) ^ N := by positivity
    have hnormfac : ∀ z : ℂ, ‖f z‖ = (∏ ρ ∈ Z, ‖z - ρ‖ ^ m ρ) * ‖h z‖ := by
      intro z
      rw [hfac z, norm_mul, norm_prod]
      congr 1
      exact Finset.prod_congr rfl (fun ρ _ => norm_pow _ _)
    have hcentre : (∏ ρ ∈ Z, ‖c - ρ‖ ^ m ρ) ≤ (r / 2) ^ N := by
      have hstep : (∏ ρ ∈ Z, ‖c - ρ‖ ^ m ρ) ≤ ∏ ρ ∈ Z, (r / 2) ^ m ρ := by
        refine Finset.prod_le_prod (fun ρ _ => pow_nonneg (norm_nonneg _) _) ?_
        intro ρ hρ
        have h1 := hZ ρ hρ
        rw [Metric.mem_closedBall, dist_eq_norm] at h1
        refine pow_le_pow_left₀ (norm_nonneg _) ?_ _
        rw [norm_sub_rev]
        exact h1
      refine hstep.trans ?_
      rw [hN]
      exact le_of_eq (Finset.prod_pow_eq_pow_sum Z m (r / 2))
    have hsph : ∀ z ∈ Metric.sphere c r, (r / 2) ^ N ≤ ∏ ρ ∈ Z, ‖z - ρ‖ ^ m ρ := by
      intro z hz
      rw [Metric.mem_sphere, dist_eq_norm] at hz
      have heq : (r / 2) ^ N = ∏ ρ ∈ Z, (r / 2) ^ m ρ := by
        rw [hN]
        exact (Finset.prod_pow_eq_pow_sum Z m (r / 2)).symm
      rw [heq]
      refine Finset.prod_le_prod (fun ρ _ => pow_nonneg hr2.le _) ?_
      intro ρ hρ
      have h1 := hZ ρ hρ
      rw [Metric.mem_closedBall, dist_eq_norm] at h1
      have h2 : ‖z - c‖ - ‖ρ - c‖ ≤ ‖(z - c) - (ρ - c)‖ := norm_sub_norm_le _ _
      have h3 : (z - c) - (ρ - c) = z - ρ := by ring
      rw [h3, hz] at h2
      exact pow_le_pow_left₀ hr2.le (by linarith) _
    set β : ℂ → ℂ :=
      fun z => ∏ ρ ∈ Z, (((r : ℂ) ^ 2 - (starRingEnd ℂ) (ρ - c) * (z - c)) / (r : ℂ)) ^ m ρ
      with hβ
    have hrne : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr.ne'
    have hβdiff : Differentiable ℂ β := by
      rw [hβ]
      have hre :
          (fun z : ℂ =>
              ∏ ρ ∈ Z, (((r : ℂ) ^ 2 - (starRingEnd ℂ) (ρ - c) * (z - c)) / (r : ℂ)) ^ m ρ)
            = ∏ ρ ∈ Z,
                (fun z : ℂ =>
                  (((r : ℂ) ^ 2 - (starRingEnd ℂ) (ρ - c) * (z - c)) / (r : ℂ)) ^ m ρ) := by
        funext z
        simp
      rw [hre]
      exact Differentiable.finset_prod (fun ρ _ => by fun_prop)
    have hβc : β c = (r : ℂ) ^ N := by
      have hstep : β c = ∏ ρ ∈ Z, (r : ℂ) ^ m ρ := by
        rw [hβ]
        refine Finset.prod_congr rfl ?_
        intro ρ _
        congr 1
        rw [sub_self, mul_zero, sub_zero, pow_two, mul_div_assoc, div_self hrne, mul_one]
      rw [hstep, hN]
      exact Finset.prod_pow_eq_pow_sum Z m (r : ℂ)
    have hβnorm : ∀ z ∈ Metric.sphere c r, ‖β z‖ = ∏ ρ ∈ Z, ‖z - ρ‖ ^ m ρ := by
      intro z hz
      rw [Metric.mem_sphere, dist_eq_norm] at hz
      have key : ∀ ρ : ℂ,
          ‖((r : ℂ) ^ 2 - (starRingEnd ℂ) (ρ - c) * (z - c)) / (r : ℂ)‖ = ‖z - ρ‖ := by
        intro ρ
        have hw : (z - c) * (starRingEnd ℂ) (z - c) = ((‖z - c‖ : ℝ) : ℂ) ^ 2 :=
          Complex.mul_conj' _
        have hr2' : ((‖z - c‖ : ℝ) : ℂ) ^ 2 = (r : ℂ) ^ 2 := by rw [hz]
        have hconj : (starRingEnd ℂ) (z - ρ)
            = (starRingEnd ℂ) (z - c) - (starRingEnd ℂ) (ρ - c) := by
          rw [show z - ρ = (z - c) - (ρ - c) by ring, map_sub]
        have hid : (r : ℂ) ^ 2 - (starRingEnd ℂ) (ρ - c) * (z - c)
            = (z - c) * (starRingEnd ℂ) (z - ρ) := by
          rw [hconj, ← hr2', ← hw]
          ring
        rw [hid, norm_div, norm_mul, Complex.norm_conj, hz, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr, mul_comm, mul_div_assoc, div_self hr.ne', mul_one]
      rw [hβ, norm_prod]
      refine Finset.prod_congr rfl ?_
      intro ρ _
      rw [norm_pow, key ρ]
    have hcentreEst : ‖f c‖ ≤ (r / 2) ^ N * ‖h c‖ := by
      rw [hnormfac c]
      exact mul_le_mul_of_nonneg_right hcentre (norm_nonneg _)
    have hquot : ∀ z ∈ Metric.closedBall c r, ‖h z‖ ≤ M * ‖h c‖ := by
      refine maxmod h (M * ‖h c‖) hh ?_
      intro z hz
      have h1 : (r / 2) ^ N * ‖h z‖ ≤ ‖f z‖ := by
        rw [hnormfac z]
        exact mul_le_mul_of_nonneg_right (hsph z hz) (norm_nonneg _)
      have h2 : ‖f z‖ ≤ M * ‖f c‖ := hM z (Metric.sphere_subset_closedBall hz)
      have h3 : M * ‖f c‖ ≤ M * ((r / 2) ^ N * ‖h c‖) :=
        mul_le_mul_of_nonneg_left hcentreEst hM0
      have h4 : (r / 2) ^ N * ‖h z‖ ≤ (r / 2) ^ N * (M * ‖h c‖) := by
        calc (r / 2) ^ N * ‖h z‖ ≤ M * ((r / 2) ^ N * ‖h c‖) := by linarith
          _ = (r / 2) ^ N * (M * ‖h c‖) := by ring
      exact le_of_mul_le_mul_left h4 hK
    have hgsph : ∀ z ∈ Metric.sphere c r, ‖h z * β z‖ ≤ M * ‖f c‖ := by
      intro z hz
      rw [norm_mul, hβnorm z hz, mul_comm ‖h z‖ (∏ ρ ∈ Z, ‖z - ρ‖ ^ m ρ), ← hnormfac z]
      exact hM z (Metric.sphere_subset_closedBall hz)
    have hgc : ‖h c * β c‖ ≤ M * ‖f c‖ :=
      maxmod (fun z => h z * β z) (M * ‖f c‖) (hh.mul hβdiff) hgsph c hcmem
    have hgcval : ‖h c * β c‖ = ‖h c‖ * r ^ N := by
      rw [hβc, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
    have hkey : ‖h c‖ * r ^ N ≤ M * ((r / 2) ^ N * ‖h c‖) := by
      rw [← hgcval]
      exact hgc.trans (mul_le_mul_of_nonneg_left hcentreEst hM0)
    have hfinal : r ^ N ≤ M * (r / 2) ^ N := by
      refine le_of_mul_le_mul_left ?_ hhc0
      calc ‖h c‖ * r ^ N ≤ M * ((r / 2) ^ N * ‖h c‖) := hkey
        _ = ‖h c‖ * (M * (r / 2) ^ N) := by ring
    refine ⟨?_, hquot⟩
    rw [div_pow] at hfinal
    have h6 : (2 : ℝ) ^ N * (M * (r ^ N / (2 : ℝ) ^ N)) = M * r ^ N := by
      field_simp
    have h7 : (2 : ℝ) ^ N * r ^ N ≤ M * r ^ N := by
      have h5 : (2 : ℝ) ^ N * r ^ N ≤ (2 : ℝ) ^ N * (M * (r ^ N / (2 : ℝ) ^ N)) :=
        mul_le_mul_of_nonneg_left hfinal h2N.le
      linarith [h5, h6]
    exact le_of_mul_le_mul_right h7 hrN
  
  have holoLog : ∀ (h : ℂ → ℂ) (c : ℂ) (R : ℝ), 0 < R → Differentiable ℂ h →
      (∀ z ∈ Metric.ball c R, h z ≠ 0) →
      ∃ F : ℂ → ℂ, DifferentiableOn ℂ F (Metric.ball c R) ∧ F c = 0 ∧
        (∀ z ∈ Metric.ball c R, h z = h c * Complex.exp (F z)) := by
    intro h c R hR hh hnz
    obtain ⟨u, hu_def⟩ : ∃ u : ℂ → ℂ, u = fun z => deriv h z / h z := ⟨_, rfl⟩
    obtain ⟨a, ha_def⟩ : ∃ a : ℕ → ℂ,
        a = fun n => ((n.factorial : ℂ))⁻¹ * iteratedDeriv n u c := ⟨_, rfl⟩
    obtain ⟨F, hF_def⟩ :
        ∃ F : ℂ → ℂ, F = fun w => ∑' n : ℕ, a n / ((n : ℂ) + 1) * (w - c) ^ (n + 1) :=
      ⟨_, rfl⟩
    have hu : DifferentiableOn ℂ u (Metric.ball c R) := by
      rw [hu_def]
      have h1 : AnalyticOnNhd ℂ h (Metric.ball c R) :=
        hh.differentiableOn.analyticOnNhd Metric.isOpen_ball
      exact DifferentiableOn.div h1.deriv.differentiableOn hh.differentiableOn hnz
    have hT : ∀ z ∈ Metric.ball c R, HasSum (fun n : ℕ => a n * (z - c) ^ n) (u z) := by
      intro z hz
