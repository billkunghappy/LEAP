            mul_le_mul (hqv m) ((hk₀X m i).trans hXv) (abs_nonneg _) (hvp0 _)
        _ = v ^ E4 := by rw [hE4, pow_succ v ((c₁ + 1) * Module.finrank ℚ K ^ 2)]
        _ ≤ Ξ := hpowv _ (by omega)
    · intro m l
      obtain ⟨z, hz⟩ := hqz m l
      refine ⟨z, ?_⟩
      show |∑ i, ((((q m : ℕ) : ℤ) * k₀ m i : ℤ) : ℝ) * p₁ l i - (z : ℝ)| ≤ Ξ / M
      have hsum : ∑ i, ((((q m : ℕ) : ℤ) * k₀ m i : ℤ) : ℝ) * p₁ l i
          = ((q m : ℕ) : ℝ) * ∑ i, ((k₀ m i : ℤ) : ℝ) * p₁ l i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        push_cast; ring
      rw [hsum]
      exact hz.trans hRHS

theorem kai_v_typeI_dichotomy (K : Type u) [Field K] [NumberField K]
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω) :
    ∀ A : ℕ, Nil2VertEquidist (Module.finrank ℚ K) A →
    ∃ (A' : ℕ) (M₀ : ℝ), 1 ≤ A' ∧ 3 ≤ M₀ ∧
      ∀ (M D Q δ X : ℝ), M₀ ≤ M → 1 ≤ D → 2 ≤ Q → 0 < δ → δ ≤ 1 →
        (D + Real.log Q + Real.log (1 / δ) + Real.log (Real.log M)) ^ A' ≤ Real.log M →
        Real.exp ((D + Real.log Q + Real.log (1 / δ) + Real.log (Real.log M)) ^ A') ≤ X →
      ∀ φ : (Fin (Module.finrank ℚ K) → ℤ) → ℂ,
        IsNil2VertSeq (Module.finrank ℚ K) D Q φ →
        ¬ IsNil2VertStructSeq (Module.finrank ℚ K) D Q M X φ →
      ∀ (𝔮 : Ideal (NumberField.RingOfIntegers K)) (χ : NumberField.RingOfIntegers K → ℂ),
        𝔮 ≠ ⊥ → (Ideal.absNorm 𝔮 : ℝ) ≤ 1 / δ → (∀ x, ‖χ x‖ ≤ 1) →
        (∀ x₁ x₂ : NumberField.RingOfIntegers K, x₁ - x₂ ∈ 𝔮 →
          (∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal),
            0 < NumberField.InfinitePlace.embedding_of_isReal hw (x₁ : K) *
              NumberField.InfinitePlace.embedding_of_isReal hw (x₂ : K)) → χ x₁ = χ x₂) →
      ∀ (I : Finset (Ideal (NumberField.RingOfIntegers K)))
        (A₀ : Ideal (NumberField.RingOfIntegers K) → ℂ) (Y : ℝ),
        (∀ 𝔡 ∈ I, 𝔡 ≠ ⊥ ∧
          (Ideal.absNorm 𝔡 : ℝ) ≤ M ^ ((3 * (Module.finrank ℚ K : ℝ)) / 4)) →
        (∀ 𝔡, ‖A₀ 𝔡‖ ≤ 1) →
        ‖kaiTypeIForm ω M (fun x => φ (ω.equivFun x)) χ I A₀ Y‖
          ≤ δ * ((omegaBox ω M).card : ℝ) :=
by
  classical
  intro A hE
  obtain ⟨A₇, M₇, hA₇, hM₇, hS3⟩ := kai_v_typeI_single_ideal K C ω hω A hE
  obtain ⟨C_P, hC_P, hP⟩ := kai_v_typeI_dyadic_select K C ω hω
  obtain ⟨C_E, hC_E, hExt⟩ := kai_v_typeI_extrapolate K C ω hω
  obtain ⟨Λ₀, hΛ₀_def⟩ : ∃ Λ₀ : ℝ, Λ₀ = Real.log C_P + (3 : ℝ) ^ A₇ + 56 * C_E + 10 :=
    ⟨_, rfl⟩
  have hlogCP : 0 ≤ Real.log C_P := Real.log_nonneg hC_P
  have h3A : (1 : ℝ) ≤ (3 : ℝ) ^ A₇ := one_le_pow₀ (by norm_num)
  refine ⟨A₇ + 6, max M₇ (Real.exp (Real.exp Λ₀)), by omega,
    le_trans hM₇ (le_max_left _ _), ?_⟩
  intro M D Q δ X hM hD hQ hδ hδ1 hLM hLX φ hφ hnot 𝔮 χ h𝔮 hN𝔮 hχ hper I A₀ Y hI hA₀
  by_contra hcon
  push_neg at hcon
  apply hnot
  obtain ⟨a, b, Bc, ξ, p₀, p₁, r₀, r₁, r₂, F, h1, h2, h3, h4, h5, h6, h7, h8, hφeq⟩ := hφ
  have hdata : Nil2VertData D Q Bc ξ F := ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩
  
  have hM7 : M₇ ≤ M := le_trans (le_max_left _ _) hM
  have hMe : Real.exp (Real.exp Λ₀) ≤ M := le_trans (le_max_right _ _) hM
  have hMpos : 0 < M := lt_of_lt_of_le (Real.exp_pos _) hMe
  have hM3 : (3 : ℝ) ≤ M := le_trans hM₇ hM7
  have hlogM : Real.exp Λ₀ ≤ Real.log M := by
    rw [Real.le_log_iff_exp_le hMpos]; exact hMe
  have hexpΛ : Λ₀ + 1 ≤ Real.exp Λ₀ := Real.add_one_le_exp Λ₀
  have hlogM1 : 1 ≤ Real.log M := by linarith
  have hlogMpos : 0 < Real.log M := by linarith
  have hloglog : Λ₀ ≤ Real.log (Real.log M) := by
    rw [Real.le_log_iff_exp_le hlogMpos]; exact hlogM
  have hQpos : 0 < Q := by linarith
  have hlogQ : 0 < Real.log Q := Real.log_pos (by linarith)
  have hδinv : 1 ≤ 1 / δ := by rw [le_div_iff₀ hδ]; linarith
  have hlogδ : 0 ≤ Real.log (1 / δ) := Real.log_nonneg hδinv
  have hCPpos : 0 < C_P := by linarith
  have hCEpos : 0 < C_E := by linarith
  
  obtain ⟨L, hL_def⟩ : ∃ L : ℝ,
      L = D + Real.log Q + Real.log (1 / δ) + Real.log (Real.log M) := ⟨_, rfl⟩
  rw [← hL_def] at hLM hLX
  have hLΛ : Λ₀ ≤ L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hLpos : 0 < L := by linarith
  have hLD : D ≤ L := by linarith
  have hLQ : Real.log Q ≤ L := by linarith
  have hLδ : Real.log (1 / δ) ≤ L := by linarith
  have hLll : Real.log (Real.log M) ≤ L := by linarith
  have hLCP : Real.log C_P ≤ L := by linarith
  have hL3A : (3 : ℝ) ^ A₇ ≤ L := by linarith
  have hLCE : 56 * C_E ≤ L := by linarith
  have hL4 : 4 ≤ L := by linarith
  have hLpow_mono : ∀ i j : ℕ, i ≤ j → L ^ i ≤ L ^ j :=
    fun i j hij => pow_le_pow_right₀ hL1 hij
  
  have hΦ : ∀ x, ‖φ (ω.equivFun x)‖ ≤ Q := by
    intro x; rw [hφeq]; exact h5 _
  obtain ⟨R, G, hR1, hR4, hGI, hGcard, hG⟩ :=
    hP M Q δ Y (fun x => φ (ω.equivFun x)) χ I A₀ hM3 (by linarith) hδ hδ1 hΦ hχ hI hA₀ hcon
  
  obtain ⟨η, hη_def⟩ : ∃ η : ℝ, η = δ / (C_P * Real.log M) := ⟨_, rfl⟩
  have hCPlog : 1 ≤ C_P * Real.log M := one_le_mul_of_one_le_of_one_le hC_P hlogM1
  have hηpos : 0 < η := by rw [hη_def]; exact div_pos hδ (mul_pos hCPpos hlogMpos)
  have hη1 : η ≤ 1 := by
    rw [hη_def, div_le_one (mul_pos hCPpos hlogMpos)]; linarith
  have hηδ : η ≤ δ := by rw [hη_def]; exact div_le_self hδ.le hCPlog
  have hinvη : 1 / η = C_P * Real.log M * (1 / δ) := by
    rw [hη_def, one_div_div, div_eq_mul_one_div]
  have hlogη : Real.log (1 / η)
      = Real.log C_P + Real.log (Real.log M) + Real.log (1 / δ) := by
    rw [hinvη, Real.log_mul (mul_pos hCPpos hlogMpos).ne' (by positivity),
      Real.log_mul hCPpos.ne' hlogMpos.ne']
  obtain ⟨Lη, hLη_def⟩ : ∃ Lη : ℝ,
      Lη = D + Real.log Q + Real.log (1 / η) + Real.log (Real.log M) := ⟨_, rfl⟩
  have hLη3 : Lη ≤ 3 * L := by rw [hLη_def, hlogη]; linarith
  have hLη0 : 0 ≤ Lη := by rw [hLη_def, hlogη]; linarith
  have hLηA : Lη ^ A₇ ≤ L ^ (A₇ + 1) := by
    calc Lη ^ A₇ ≤ (3 * L) ^ A₇ := pow_le_pow_left₀ hLη0 hLη3 _
      _ = (3 : ℝ) ^ A₇ * L ^ A₇ := mul_pow _ _ _
      _ ≤ L * L ^ A₇ := mul_le_mul_of_nonneg_right hL3A (pow_nonneg hLpos.le _)
      _ = L ^ (A₇ + 1) := by ring
  have hLηM : Lη ^ A₇ ≤ Real.log M :=
    hLηA.trans ((hLpow_mono _ _ (by omega)).trans hLM)
  have hN𝔮η : (Ideal.absNorm 𝔮 : ℝ) ≤ 1 / η :=
    hN𝔮.trans (one_div_le_one_div_of_le hηpos hηδ)
  obtain ⟨X₇, hX₇_def⟩ : ∃ X₇ : ℝ, X₇ = Real.exp (Lη ^ A₇) := ⟨_, rfl⟩
  have hX₇1 : 1 ≤ X₇ := by rw [hX₇_def]; exact Real.one_le_exp (pow_nonneg hLη0 _)
  
  have hφfun : (fun x => φ (ω.equivFun x))
      = fun x => nil2Eval p₀ p₁ r₀ r₁ r₂ F (ω.equivFun x) := by
    funext x; exact hφeq _
  have hS3' : ∀ 𝔡 ∈ G, ∃ (e : NumberField.RingOfIntegers K) (k : Fin a → Fin a → ℤ),
      e ∈ 𝔡 ∧ e ≠ 0 ∧ basisSupNorm ω e ≤ X₇ * (2 * R) ∧
        (∀ m i, |((k m i : ℤ) : ℝ)| ≤ X₇) ∧ Nil2Isotropic Bc ξ k ∧
        ∀ (m : Fin a) (y : NumberField.RingOfIntegers K), ∃ z : ℤ,
          |∑ l, ((ω.repr (e * y) l : ℤ) : ℝ) * ∑ i, ((k m i : ℤ) : ℝ) * p₁ l i - z|
            ≤ X₇ * basisSupNorm ω y * (2 * R) / M := by
    intro 𝔡 h𝔡
    obtain ⟨-, hR𝔡', hS𝔡⟩ := hG 𝔡 h𝔡
    obtain ⟨h𝔡ne, h𝔡M⟩ := hI 𝔡 (hGI h𝔡)
    have hsum : η * ((omegaBox ω M).card : ℝ) / (Ideal.absNorm 𝔡 : ℝ)
        ≤ ‖kaiTypeIInner ω M (fun x => nil2Eval p₀ p₁ r₀ r₁ r₂ F (ω.equivFun x)) χ 𝔡 Y‖ := by
      have hS := hS𝔡
      rw [hφfun] at hS
      rw [hη_def]; exact hS
    have hres := hS3 M D Q η Y hM7 hD hQ hηpos hη1 (by rw [← hLη_def]; exact hLηM)
      a b Bc ξ F hdata p₀ p₁ r₀ r₁ r₂ 𝔮 χ h𝔮 hN𝔮η hχ hper 𝔡 (2 * R) h𝔡ne h𝔡M
      (by linarith) hR𝔡' hsum
    rw [← hLη_def, ← hX₇_def] at hres
    obtain ⟨e, he1, he2, he3, k, hk1, hk2, hk3⟩ := hres
    exact ⟨e, k, he1, he2, he3, hk1, hk2, hk3⟩
  choose! e k hek using hS3'
  
  obtain ⟨ηG, hηG_def⟩ : ∃ ηG : ℝ, ηG = δ / (C_P * Q * Real.log M) := ⟨_, rfl⟩
  have hCPQ : 0 < C_P * Q * Real.log M := mul_pos (mul_pos hCPpos hQpos) hlogMpos
  have hCPQ1 : 1 ≤ C_P * Q * Real.log M := by
    have : 1 ≤ C_P * Q := one_le_mul_of_one_le_of_one_le hC_P (by linarith)
    exact one_le_mul_of_one_le_of_one_le this hlogM1
  have hηGpos : 0 < ηG := by rw [hηG_def]; exact div_pos hδ hCPQ
  have hηG1 : ηG ≤ 1 := by rw [hηG_def, div_le_one hCPQ]; linarith
  have hinvηG : 1 / ηG = C_P * Q * Real.log M * (1 / δ) := by
    rw [hηG_def, one_div_div, div_eq_mul_one_div]
  have hlogηG : Real.log (1 / ηG)
      = Real.log C_P + Real.log Q + Real.log (Real.log M) + Real.log (1 / δ) := by
    rw [hinvηG, Real.log_mul hCPQ.ne' (by positivity),
      Real.log_mul (mul_pos hCPpos hQpos).ne' hlogMpos.ne',
      Real.log_mul hCPpos.ne' hQpos.ne']
  have hlog2X : Real.log (2 * X₇) ≤ 1 + L ^ (A₇ + 1) := by
    rw [hX₇_def, Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]
    have : Real.log 2 ≤ 1 := by
      have := Real.log_two_lt_d9; linarith
    linarith
  have ha : (a : ℝ) + 1 ≤ 2 * L := by
    have hab : ((a + b : ℕ) : ℝ) ≤ D := h1
    push_cast at hab
    have : (0 : ℝ) ≤ b := Nat.cast_nonneg b
    linarith
  obtain ⟨Ex, hEx_def⟩ : ∃ Ex : ℝ,
      Ex = C_E * ((a : ℝ) + 1) ^ 3 * (Real.log (2 * X₇) + Real.log (1 / ηG) + 1) :=
    ⟨_, rfl⟩
  have hEx : Ex ≤ L ^ (A₇ + 5) := by
    have hLle : L ≤ L ^ (A₇ + 1) := by
      calc L = L ^ 1 := (pow_one L).symm
        _ ≤ L ^ (A₇ + 1) := hLpow_mono _ _ (by omega)
    have hinner : Real.log (2 * X₇) + Real.log (1 / ηG) + 1 ≤ 7 * L ^ (A₇ + 1) := by
      rw [hlogηG]; linarith
    have hinner0 : 0 ≤ Real.log (2 * X₇) + Real.log (1 / ηG) + 1 := by
      have h2X : 0 ≤ Real.log (2 * X₇) := Real.log_nonneg (by linarith)
      have h1G : 0 ≤ Real.log (1 / ηG) :=
        Real.log_nonneg (by rw [le_div_iff₀ hηGpos]; linarith)
      linarith
    have ha3 : ((a : ℝ) + 1) ^ 3 ≤ (2 * L) ^ 3 := pow_le_pow_left₀ (by positivity) ha _
    rw [hEx_def]
    calc C_E * ((a : ℝ) + 1) ^ 3 * (Real.log (2 * X₇) + Real.log (1 / ηG) + 1)
        ≤ C_E * (2 * L) ^ 3 * (7 * L ^ (A₇ + 1)) := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left ha3 hCEpos.le) hinner hinner0
          exact mul_nonneg hCEpos.le (pow_nonneg (by linarith) _)
      _ = (56 * C_E) * L ^ (A₇ + 4) := by ring
      _ ≤ L * L ^ (A₇ + 4) := mul_le_mul_of_nonneg_right hLCE (pow_nonneg hLpos.le _)
      _ = L ^ (A₇ + 5) := by ring
  have hΞ4 : Real.exp Ex ^ 4 = Real.exp (4 * Ex) := by
    rw [← Real.exp_nat_mul]; norm_num
  have hEx6 : 4 * Ex ≤ L ^ (A₇ + 6) := by
    calc 4 * Ex ≤ 4 * L ^ (A₇ + 5) := by linarith
      _ ≤ L * L ^ (A₇ + 5) := mul_le_mul_of_nonneg_right hL4 (pow_nonneg hLpos.le _)
      _ = L ^ (A₇ + 6) := by ring
  have hΞM : Real.exp Ex ^ 4 ≤ M := by
    rw [hΞ4]
    calc Real.exp (4 * Ex) ≤ Real.exp (Real.log M) := Real.exp_le_exp.mpr (hEx6.trans hLM)
      _ = M := Real.exp_log hMpos
  have hΞX : Real.exp Ex ≤ X := by
    refine le_trans (Real.exp_le_exp.mpr ?_) hLX
    exact hEx.trans (hLpow_mono _ _ (by omega))
  
  have hEdata : ∀ 𝔡 ∈ G, R ^ Module.finrank ℚ K ≤ (Ideal.absNorm 𝔡 : ℝ) ∧ e 𝔡 ∈ 𝔡 ∧
      e 𝔡 ≠ 0 ∧ basisSupNorm ω (e 𝔡) ≤ (2 * X₇) * R ∧
      (∀ m i, |((k 𝔡 m i : ℤ) : ℝ)| ≤ 2 * X₇) ∧ Nil2Isotropic Bc ξ (k 𝔡) ∧
      ∀ (m : Fin a) (y : NumberField.RingOfIntegers K), ∃ z : ℤ,
        |∑ l, ((ω.repr (e 𝔡 * y) l : ℤ) : ℝ) * ∑ i, ((k 𝔡 m i : ℤ) : ℝ) * p₁ l i - z|
          ≤ (2 * X₇) * basisSupNorm ω y * R / M := by
    intro 𝔡 h𝔡
    obtain ⟨he1, he2, he3, hk1, hk2, hk3⟩ := hek 𝔡 h𝔡
    refine ⟨(hG 𝔡 h𝔡).1, he1, he2, ?_, ?_, hk2, ?_⟩
    · calc basisSupNorm ω (e 𝔡) ≤ X₇ * (2 * R) := he3
        _ = (2 * X₇) * R := by ring
    · intro m i; have := hk1 m i; linarith
    · intro m y
      obtain ⟨z, hz⟩ := hk3 m y
      refine ⟨z, hz.trans (le_of_eq ?_)⟩
      ring
  obtain ⟨k', hk'1, hk'2, hk'3⟩ := hExt a b Bc ξ p₁ (2 * X₇) ηG R M (by linarith) hηGpos hηG1
    hR1 hR4 (by rw [← hEx_def]; exact hΞM) G e k (by rw [hηG_def]; exact hGcard) hEdata
  rw [← hEx_def] at hk'1 hk'3
  
  refine ⟨a, b, Bc, ξ, p₀, p₁, r₀, r₁, r₂, F, a, k', hdata, fun z => hφeq z, ?_, hk'2, ?_⟩
  · intro m i; exact (hk'1 m i).trans hΞX
  · intro m l
    obtain ⟨z, hz⟩ := hk'3 m l
    exact ⟨z, hz.trans (div_le_div_of_nonneg_right hΞX hMpos.le)⟩

theorem kai_t2_pair_chars : ∀ (ν A : ℕ), Nil2VertEquidist ν A →
    ∀ (D Q η : ℝ) (Lc a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
      (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ)
      (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ)
      (A₁ A₂ : Fin ν → Fin ν → ℤ) (z₀ : Fin ν → ℤ),
      1 ≤ D → 2 ≤ Q → 0 < η → η ≤ 1 → 1 ≤ Lc → Nil2VertData D Q Bc ξ F →
      η * (Lc : ℝ) ^ ν ≤
        ‖∑ w ∈ Finset.Icc z₀ (z₀ + fun _ => (Lc : ℤ) - 1),
          nil2Eval p₀ p₁ r₀ r₁ r₂ F (fun l => ∑ i, A₁ l i * w i) *
            (starRingEnd ℂ) (nil2Eval p₀ p₁ r₀ r₁ r₂ F (fun l => ∑ i, A₂ l i * w i))‖ →
      ∃ (k1 k2 : Fin (a + a) → Fin a → ℤ),
        (∀ m j, |(k1 m j : ℝ)| ≤ Real.exp ((2 * D + Real.log (Q ^ 2) + Real.log (1 / η)) ^ A) ∧
                |(k2 m j : ℝ)| ≤ Real.exp ((2 * D + Real.log (Q ^ 2) + Real.log (1 / η)) ^ A)) ∧
        Nil2Isotropic Bc ξ (Fin.append k1 k2) ∧
        ∀ (m : Fin (a + a)) (i : Fin ν), ∃ e : ℤ,
          |∑ l, (A₁ l i : ℝ) * ∑ j, (k1 m j : ℝ) * p₁ l j
            + ∑ l, (A₂ l i : ℝ) * ∑ j, (k2 m j : ℝ) * p₁ l j - (e : ℝ)|
            ≤ Real.exp ((2 * D + Real.log (Q ^ 2) + Real.log (1 / η)) ^ A) / (Lc : ℝ) :=
by
  
  have t_s5 : ∀ (ν a : ℕ) (A₁ A₂ : Fin ν → Fin ν → ℤ)
      (p₁ : Fin ν → Fin a → ℝ) (κ : Fin (a + a) → ℤ) (i : Fin ν),
      ∑ I, (κ I : ℝ) * nil2DblP1 A₁ A₂ p₁ i I
        = ∑ l, (A₁ l i : ℝ) * ∑ j, (κ (Fin.castAdd a j) : ℝ) * p₁ l j
          + ∑ l, (A₂ l i : ℝ) * ∑ j, (κ (Fin.natAdd a j) : ℝ) * p₁ l j := by
    intro ν a A₁ A₂ p₁ κ i
    rw [Fin.sum_univ_add]
    simp only [nil2DblP1, Fin.append_left, Fin.append_right, Finset.mul_sum]
    congr 1 <;> rw [Finset.sum_comm] <;>
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
  
  have t_s3 : ∀ (ν a b : ℕ) (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ)
      (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ)
      (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) (A₁ A₂ : Fin ν → Fin ν → ℤ) (w : Fin ν → ℤ),
      nil2Eval (Fin.append p₀ p₀) (nil2DblP1 A₁ A₂ p₁) (Fin.append r₀ r₀) (nil2DblR1 A₁ A₂ r₁)
          (nil2DblR2 A₁ A₂ r₂) (nil2DblF F) w
        = nil2Eval p₀ p₁ r₀ r₁ r₂ F (fun l => ∑ i, A₁ l i * w i) *
            (starRingEnd ℂ) (nil2Eval p₀ p₁ r₀ r₁ r₂ F (fun l => ∑ i, A₂ l i * w i)) := by
    intro ν a b p₀ p₁ r₀ r₁ r₂ F A₁ A₂ w
    have hor : ∀ (B : Fin ν → Fin ν → ℤ) (j : Fin a),
        ∑ l, (w l : ℝ) * ∑ l', (B l' l : ℝ) * p₁ l' j
          = ∑ l, (((∑ i, B l i * w i : ℤ)) : ℝ) * p₁ l j := by
      intro B j
      push_cast
      simp only [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
    have ver1 : ∀ (B : Fin ν → Fin ν → ℤ) (t : Fin b),
        ∑ l, (w l : ℝ) * ∑ l', (B l' l : ℝ) * r₁ l' t
          = ∑ l, (((∑ i, B l i * w i : ℤ)) : ℝ) * r₁ l t := by
      intro B t
      push_cast
      simp only [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
    have ver2 : ∀ (B : Fin ν → Fin ν → ℤ) (t : Fin b),
        ∑ l, ∑ l', (w l : ℝ) * (w l' : ℝ) * ∑ m, ∑ m', (B m l : ℝ) * (B m' l' : ℝ) * r₂ m m' t
          = ∑ l, ∑ l', (((∑ i, B l i * w i : ℤ)) : ℝ) * (((∑ i, B l' i * w i : ℤ)) : ℝ)
              * r₂ l l' t := by
      intro B t
      push_cast
      simp only [Finset.mul_sum, Finset.sum_mul]
      calc _ = ∑ l, ∑ m, ∑ l', ∑ m',
                (w l : ℝ) * (w l' : ℝ) * ((B m l : ℝ) * (B m' l' : ℝ) * r₂ m m' t) := by
            refine Finset.sum_congr rfl (fun l _ => ?_)
            rw [Finset.sum_comm]
        _ = ∑ m, ∑ l, ∑ l', ∑ m',
                (w l : ℝ) * (w l' : ℝ) * ((B m l : ℝ) * (B m' l' : ℝ) * r₂ m m' t) := by
            rw [Finset.sum_comm]
        _ = ∑ m, ∑ l, ∑ m', ∑ l',
                (w l : ℝ) * (w l' : ℝ) * ((B m l : ℝ) * (B m' l' : ℝ) * r₂ m m' t) := by
            refine Finset.sum_congr rfl (fun m _ => Finset.sum_congr rfl (fun l _ => ?_))
            rw [Finset.sum_comm]
        _ = ∑ m, ∑ m', ∑ l, ∑ l',
                (w l : ℝ) * (w l' : ℝ) * ((B m l : ℝ) * (B m' l' : ℝ) * r₂ m m' t) := by
            refine Finset.sum_congr rfl (fun m _ => ?_)
            rw [Finset.sum_comm]
        _ = _ := by
            refine Finset.sum_congr rfl (fun m _ => Finset.sum_congr rfl (fun m' _ => ?_))
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun l' _ => by ring))
    unfold nil2Eval nil2DblF
    simp only [Fin.append_left, Fin.append_right, nil2DblP1, nil2DblR1, nil2DblR2]
    simp only [hor, ver1, ver2]
  
  have t_s4 : ∀ (a b r : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
      (k : Fin r → Fin (a + a) → ℤ), Nil2Isotropic (nil2DblBc Bc) (nil2DblXi ξ) k →
      ∀ v w : Fin a → ℝ,
        (∀ m, ∑ I, (k m I : ℝ) * Fin.append v w I = 0) →
        (∀ m, ∑ I, (k m I : ℝ) * Fin.append w v I = 0) →
        ∑ i, ∑ j, ∑ t, (ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ)) * v i * w j = 0 := by
    intro a b r Bc ξ k hk v w h1 h2
    have H := hk (Fin.append v w) (Fin.append w v) h1 h2
    simp only [Fin.sum_univ_add, nil2DblBc, nil2DblXi, Fin.append_left, Fin.append_right,
      Int.cast_zero, Int.cast_neg, sub_self, mul_zero, zero_mul, Finset.sum_const_zero,
      add_zero, zero_add] at H
    have anti : ∑ i, ∑ j, ∑ t, (ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ)) * w i * v j
        = - ∑ i, ∑ j, ∑ t, (ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ)) * v i * w j := by
      rw [Finset.sum_comm]
      simp only [← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ =>
        Finset.sum_congr rfl (fun _ _ => by ring)))
    have H2 : ∑ i, ∑ j, ∑ t, -(ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ)) * w i * v j
        = - ∑ i, ∑ j, ∑ t, (ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ)) * w i * v j := by
      simp only [← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ =>
        Finset.sum_congr rfl (fun _ _ => by ring)))
    rw [H2, anti] at H
    linarith
  
  have t_s6 : ∀ (m r : ℕ) (k : Fin r → Fin m → ℤ), ∃ k' : Fin m → Fin m → ℤ,
      (∀ i, k' i = 0 ∨ ∃ j, k' i = k j) ∧
      ∀ v : Fin m → ℝ,
        (∀ i, ∑ p, (k' i p : ℝ) * v p = 0) ↔ (∀ j, ∑ p, (k j p : ℝ) * v p = 0) := by
    intro m r k
    classical
    let κ : Fin r → (Fin m → ℝ) := fun j p => (k j p : ℝ)
    obtain ⟨ι', f, hf, hspan, hli⟩ := exists_linearIndependent' ℝ κ
    haveI : Finite ι' := Finite.of_injective f hf
    haveI : Fintype ι' := Fintype.ofFinite ι'
    have hcard : Fintype.card ι' ≤ m := by
      have := hli.fintype_card_le_finrank
      simpa [Module.finrank_fin_fun] using this
    let e : ι' ↪ Fin m := (Fintype.equivFin ι').toEmbedding.trans (Fin.castLEEmb hcard)
    refine ⟨Function.extend e (fun x => k (f x)) (fun _ => 0), ?_, ?_⟩
    · intro i
      by_cases h : ∃ x, e x = i
      · obtain ⟨x, rfl⟩ := h
        right
        exact ⟨f x, e.injective.extend_apply _ _ x⟩
      · left
        exact Function.extend_apply' _ _ _ h
    · intro v
      constructor
      · intro hv j
        have hgen : ∀ x : ι', ∑ p, κ (f x) p * v p = 0 := by
          intro x
          have := hv (e x)
          rw [e.injective.extend_apply] at this
          simpa [κ] using this
        have hmem : κ j ∈ Submodule.span ℝ (Set.range (κ ∘ f)) := by
          rw [hspan]; exact Submodule.subset_span ⟨j, rfl⟩
        have key : ∀ u ∈ Submodule.span ℝ (Set.range (κ ∘ f)), ∑ p, u p * v p = 0 := by
          intro u hu
          induction hu using Submodule.span_induction with
          | mem x hx =>
            obtain ⟨y, rfl⟩ := hx
            exact hgen y
          | zero => simp
          | add x y _ _ hx hy =>
            simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib, hx, hy, add_zero]
          | smul c x _ hx =>
            simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, hx, mul_zero]
        simpa [κ] using key _ hmem
      · intro hv i
        by_cases h : ∃ x, e x = i
        · obtain ⟨x, rfl⟩ := h
          rw [e.injective.extend_apply]
          exact hv (f x)
        · rw [Function.extend_apply' _ _ _ h]
          simp
  
  have t_s1 : ∀ (a b : ℕ) (D Q : ℝ) (Bc : Fin a → Fin a → Fin b → ℤ)
      (ξ : Fin b → ℤ) (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ), 1 ≤ Q → Nil2VertData D Q Bc ξ F →
      (((a + a + (b + b) : ℕ) : ℝ) ≤ 2 * D) ∧
      (∀ I J T, |(nil2DblBc Bc I J T : ℝ)| ≤ Q ^ 2) ∧
      (∀ T, |(nil2DblXi ξ T : ℝ)| ≤ Q ^ 2) ∧ nil2DblXi ξ ≠ 0 ∧
      (∀ u : (Fin (a + a) → ℝ) × (Fin (b + b) → ℝ), ‖nil2DblF F u‖ ≤ Q ^ 2) ∧
      (∀ u v : (Fin (a + a) → ℝ) × (Fin (b + b) → ℝ),
        (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ k, -1 ≤ u.2 k ∧ u.2 k ≤ 2) →
        (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, -1 ≤ v.2 k ∧ v.2 k ≤ 2) →
        ‖nil2DblF F u - nil2DblF F v‖
          ≤ Q ^ 2 * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|)) := by
    intro a b D Q Bc ξ F hQ hdata
    obtain ⟨h1, h2, h3, h4, h5, -, -, h8⟩ := hdata
    have hQQ : Q ≤ Q ^ 2 := by nlinarith
    have hQ0 : 0 ≤ Q := by linarith
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · push_cast at h1 ⊢; linarith
    · intro I J T
      induction I using Fin.addCases <;> induction J using Fin.addCases <;>
        induction T using Fin.addCases <;>
        simp only [nil2DblBc, Fin.append_left, Fin.append_right, Int.cast_zero, abs_zero] <;>
        first | positivity | exact (h2 _ _ _).trans hQQ
    · intro T
      induction T using Fin.addCases <;>
        simp only [nil2DblXi, Fin.append_left, Fin.append_right, Int.cast_neg, abs_neg] <;>
        exact (h3 _).trans hQQ
    · intro h
      obtain ⟨t, ht⟩ := Function.ne_iff.mp h4
      apply ht
      have := congrFun h (Fin.castAdd b t)
      simpa [nil2DblXi] using this
    · intro u
      simp only [nil2DblF, norm_mul, Complex.norm_conj, sq]
      exact mul_le_mul (h5 _) (h5 _) (norm_nonneg _) hQ0
    · intro u v hu1 hu2 hv1 hv2
      have alg : ∀ (x y x' y' : ℂ) (d1 d2 : ℝ), ‖x‖ ≤ Q → ‖y'‖ ≤ Q → ‖x - x'‖ ≤ Q * d1 →
          ‖y - y'‖ ≤ Q * d2 →
          ‖x * (starRingEnd ℂ) y - x' * (starRingEnd ℂ) y'‖ ≤ Q ^ 2 * (d1 + d2) := by
        intro x y x' y' d1 d2 hx hy' e1 e2
        calc ‖x * (starRingEnd ℂ) y - x' * (starRingEnd ℂ) y'‖
            = ‖x * (starRingEnd ℂ) (y - y') + (x - x') * (starRingEnd ℂ) y'‖ := by
              rw [map_sub]; congr 1; ring
          _ ≤ ‖x‖ * ‖y - y'‖ + ‖x - x'‖ * ‖y'‖ := by
              refine (norm_add_le _ _).trans (le_of_eq ?_)
              rw [norm_mul, norm_mul, Complex.norm_conj, Complex.norm_conj]
          _ ≤ Q * (Q * d2) + (Q * d1) * Q :=
              add_le_add (mul_le_mul hx e2 (norm_nonneg _) hQ0)
                (mul_le_mul e1 hy' (norm_nonneg _) ((norm_nonneg _).trans e1))
          _ = Q ^ 2 * (d1 + d2) := by ring
      have e1 := h8 (fun i => u.1 (Fin.castAdd a i), fun t => u.2 (Fin.castAdd b t))
        (fun i => v.1 (Fin.castAdd a i), fun t => v.2 (Fin.castAdd b t))
        (fun i => hu1 _) (fun k => hu2 _) (fun i => hv1 _) (fun k => hv2 _)
      have e2 := h8 (fun i => u.1 (Fin.natAdd a i), fun t => u.2 (Fin.natAdd b t))
        (fun i => v.1 (Fin.natAdd a i), fun t => v.2 (Fin.natAdd b t))
        (fun i => hu1 _) (fun k => hu2 _) (fun i => hv1 _) (fun k => hv2 _)
      have := alg _ _ _ _ _ _ (h5 _) (h5 _) e1 e2
      refine this.trans (le_of_eq ?_)
      rw [Fin.sum_univ_add, Fin.sum_univ_add]
      ring
  
  have t_s2 : ∀ (a b : ℕ) (D Q : ℝ) (Bc : Fin a → Fin a → Fin b → ℤ)
      (ξ : Fin b → ℤ) (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ), Nil2VertData D Q Bc ξ F →
      (∀ (u : (Fin (a + a) → ℝ) × (Fin (b + b) → ℝ)) (γ₁ : Fin (a + a) → ℤ)
          (γ₂ : Fin (b + b) → ℤ),
        nil2DblF F (nil2Mul (nil2DblBc Bc) u ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ))))
          = nil2DblF F u) ∧
      (∀ (u : (Fin (a + a) → ℝ) × (Fin (b + b) → ℝ)) (t : Fin (b + b) → ℝ),
        nil2DblF F (u.1, fun k => u.2 k + t k)
          = Complex.exp (2 * Real.pi * Complex.I * ((∑ k, (nil2DblXi ξ k : ℝ) * t k : ℝ) : ℂ))
              * nil2DblF F u) := by
    intro a b D Q Bc ξ F hdata
    obtain ⟨-, -, -, -, -, h6, h7, -⟩ := hdata
    refine ⟨?_, ?_⟩
    · intro u γ₁ γ₂
      have b1 : ((fun i => (nil2Mul (nil2DblBc Bc) u
                    ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).1 (Fin.castAdd a i)),
                 (fun t => (nil2Mul (nil2DblBc Bc) u
                    ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).2 (Fin.castAdd b t)))
          = nil2Mul Bc (fun i => u.1 (Fin.castAdd a i), fun t => u.2 (Fin.castAdd b t))
              ((fun i => (γ₁ (Fin.castAdd a i) : ℝ)),
                (fun t => (γ₂ (Fin.castAdd b t) : ℝ))) := by
        simp only [nil2Mul, Prod.mk.injEq, true_and]
        funext t
        simp only [Fin.sum_univ_add, nil2DblBc, Fin.append_left, Fin.append_right, Int.cast_zero,
          zero_mul, Finset.sum_const_zero, add_zero]
      have b2 : ((fun i => (nil2Mul (nil2DblBc Bc) u
                    ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).1 (Fin.natAdd a i)),
                 (fun t => (nil2Mul (nil2DblBc Bc) u
                    ((fun i => (γ₁ i : ℝ)), (fun k => (γ₂ k : ℝ)))).2 (Fin.natAdd b t)))
          = nil2Mul Bc (fun i => u.1 (Fin.natAdd a i), fun t => u.2 (Fin.natAdd b t))
              ((fun i => (γ₁ (Fin.natAdd a i) : ℝ)),
                (fun t => (γ₂ (Fin.natAdd b t) : ℝ))) := by
        simp only [nil2Mul, Prod.mk.injEq, true_and]
        funext t
        simp only [Fin.sum_univ_add, nil2DblBc, Fin.append_left, Fin.append_right, Int.cast_zero,
          zero_mul, Finset.sum_const_zero, add_zero, zero_add]
      unfold nil2DblF
      rw [b1, b2, h6, h6]
    · intro u t
      have e1 := h7 (fun i => u.1 (Fin.castAdd a i), fun s => u.2 (Fin.castAdd b s))
        (fun s => t (Fin.castAdd b s))
      have e2 := h7 (fun i => u.1 (Fin.natAdd a i), fun s => u.2 (Fin.natAdd b s))
        (fun s => t (Fin.natAdd b s))
      unfold nil2DblF
      dsimp only at e1 e2 ⊢
      rw [e1, e2]
      have hsum : ∑ k, (nil2DblXi ξ k : ℝ) * t k
          = ∑ s, (ξ s : ℝ) * t (Fin.castAdd b s) - ∑ s, (ξ s : ℝ) * t (Fin.natAdd b s) := by
        rw [Fin.sum_univ_add]
        simp only [nil2DblXi, Fin.append_left, Fin.append_right, Int.cast_neg, neg_mul,
          Finset.sum_neg_distrib, sub_eq_add_neg]
      have hexp : ∀ x y : ℝ, Complex.exp (2 * ↑Real.pi * Complex.I * ((x - y : ℝ) : ℂ))
          = Complex.exp (2 * ↑Real.pi * Complex.I * (x : ℂ))
            * Complex.exp (2 * ↑Real.pi * -Complex.I * (y : ℂ)) := by
        intro x y; rw [← Complex.exp_add]; congr 1; push_cast; ring
      rw [hsum, map_mul, ← Complex.exp_conj]
      simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
      rw [hexp]
      ring
  
  intro ν A hE D Q η Lc a b Bc ξ F p₀ p₁ r₀ r₁ r₂ A₁ A₂ z₀ hD hQ hη hη1 hLc hdata hcor
  have hQ1 : (1 : ℝ) ≤ Q := by linarith
  obtain ⟨d1, d2, d3, d4, d5, d8⟩ := t_s1 a b D Q Bc ξ F hQ1 hdata
  obtain ⟨d6, d7⟩ := t_s2 a b D Q Bc ξ F hdata
  have hdata2 : Nil2VertData (2 * D) (Q ^ 2) (nil2DblBc Bc) (nil2DblXi ξ) (nil2DblF F) :=
    ⟨d1, d2, d3, d4, d5, d6, d7, d8⟩
  have hsum : η * (Lc : ℝ) ^ ν ≤ ‖∑ w ∈ Finset.Icc z₀ (z₀ + fun _ => ((Lc : ℤ) - 1)),
      nil2Eval (Fin.append p₀ p₀) (nil2DblP1 A₁ A₂ p₁) (Fin.append r₀ r₀)
        (nil2DblR1 A₁ A₂ r₁) (nil2DblR2 A₁ A₂ r₂) (nil2DblF F) w‖ := by
    simp only [t_s3]; exact hcor
  have hQ2 : (2 : ℝ) ≤ Q ^ 2 := by nlinarith
  obtain ⟨r, k, hkb, hkiso, hksm⟩ := hE (2 * D) (Q ^ 2) η Lc (by linarith) hQ2 hη hη1 hLc
    (a + a) (b + b) (nil2DblBc Bc) (nil2DblXi ξ) (nil2DblF F) hdata2 (Fin.append p₀ p₀)
    (nil2DblP1 A₁ A₂ p₁) (Fin.append r₀ r₀) (nil2DblR1 A₁ A₂ r₁) (nil2DblR2 A₁ A₂ r₂) z₀ hsum
  obtain ⟨k', hrow, hker⟩ := t_s6 (a + a) r k
  have hX0 : 0 ≤ Real.exp ((2 * D + Real.log (Q ^ 2) + Real.log (1 / η)) ^ A) :=
    (Real.exp_pos _).le
  have hLc0 : (0 : ℝ) < Lc := by exact_mod_cast hLc
  refine ⟨fun m j => k' m (Fin.castAdd a j), fun m j => k' m (Fin.natAdd a j), ?_, ?_, ?_⟩
  · intro m j
    beta_reduce
    rcases hrow m with h0 | ⟨j', hj'⟩
    · rw [h0]; simp only [Pi.zero_apply, Int.cast_zero, abs_zero]; exact ⟨hX0, hX0⟩
    · rw [hj']; exact ⟨hkb _ _, hkb _ _⟩
  · intro v w hv hw
    have hv1 : ∀ m, ∑ j, (k' m (Fin.castAdd a j) : ℝ) * v j = 0 := fun m => by
      have := hv (Fin.castAdd (a + a) m); simpa only [Fin.append_left] using this
    have hv2 : ∀ m, ∑ j, (k' m (Fin.natAdd a j) : ℝ) * v j = 0 := fun m => by
      have := hv (Fin.natAdd (a + a) m); simpa only [Fin.append_right] using this
    have hw1 : ∀ m, ∑ j, (k' m (Fin.castAdd a j) : ℝ) * w j = 0 := fun m => by
      have := hw (Fin.castAdd (a + a) m); simpa only [Fin.append_left] using this
    have hw2 : ∀ m, ∑ j, (k' m (Fin.natAdd a j) : ℝ) * w j = 0 := fun m => by
      have := hw (Fin.natAdd (a + a) m); simpa only [Fin.append_right] using this
    have hk1 : ∀ m, ∑ I, (k' m I : ℝ) * Fin.append v w I = 0 := fun m => by
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right, hv1, hw2, add_zero]
    have hk2 : ∀ m, ∑ I, (k' m I : ℝ) * Fin.append w v I = 0 := fun m => by
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right, hw1, hv2, add_zero]
    exact t_s4 a b r Bc ξ k hkiso v w ((hker _).mp hk1) ((hker _).mp hk2)
  · intro m i
    beta_reduce
    have hs := t_s5 ν a A₁ A₂ p₁ (k' m) i
    rcases hrow m with h0 | ⟨j', hj'⟩
    · refine ⟨0, ?_⟩
      rw [← hs, h0]
      simp only [Pi.zero_apply, Int.cast_zero, zero_mul, Finset.sum_const_zero, sub_zero,
        abs_zero]
      exact div_nonneg hX0 hLc0.le
    · obtain ⟨e, he⟩ := hksm j' i
      refine ⟨e, ?_⟩
      rw [← hs, hj']
      exact he

theorem kai_t2_simul_vinogradov : ∀ ν : ℕ, 1 ≤ ν → ∃ C₄ : ℕ, 1 ≤ C₄ ∧
    ∀ (ι : Type) [Fintype ι] (G1 G2 : ι → Fin ν → ℝ)
      (S : Finset ((Fin ν → ℤ) × (Fin ν → ℤ))) (T : ℕ) (η ε : ℝ),
      0 < η → η ≤ 1 → 0 ≤ ε →
      (∀ s ∈ S, ∀ k, |s.1 k| ≤ (T : ℤ) ∧ |s.2 k| ≤ (T : ℤ)) →
      η * (2 * (T : ℝ) + 1) ^ (2 * ν) ≤ (S.card : ℝ) →
      (∀ s ∈ S, ∀ j, ∃ e : ℤ,
        |∑ k, (s.1 k : ℝ) * G1 j k + ∑ k, (s.2 k : ℝ) * G2 j k - (e : ℝ)| ≤ ε) →
      ((C₄ : ℝ) / η) ^ C₄ ≤ (T : ℝ) →
      ε * ((C₄ : ℝ) / η) ^ C₄ ≤ 1 →
      ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (((C₄ : ℝ) / η) ^ C₄) ^ Fintype.card ι ∧
        ∀ j k,
          (∃ e : ℤ, |(q : ℝ) * G1 j k - (e : ℝ)|
              ≤ (((C₄ : ℝ) / η) ^ C₄) ^ Fintype.card ι * ε / (T : ℝ)) ∧
          (∃ e : ℤ, |(q : ℝ) * G2 j k - (e : ℝ)|
              ≤ (((C₄ : ℝ) / η) ^ C₄) ^ Fintype.card ι * ε / (T : ℝ)) :=
by
  classical
  intro ν hν
  obtain ⟨Cl, Al, hCl, hAl, hlin⟩ := kai_lin_vinogradov_affine (ν + ν)
  refine ⟨max ⌈Cl⌉₊ Al, le_max_of_le_right hAl, ?_⟩
  intro ι _ G1 G2 S T η ε hη hη1 hε hbox hdens hgood hPT hεP
  set C₄ : ℕ := max ⌈Cl⌉₊ Al with hC₄
  set P : ℝ := ((C₄ : ℝ) / η) ^ C₄ with hP
  set P' : ℝ := (Cl / η) ^ Al with hP'
  have f1 : Cl ≤ (C₄ : ℝ) :=
    (Nat.le_ceil Cl).trans (by exact_mod_cast le_max_left _ _)
  have f2 : Al ≤ C₄ := le_max_right _ _
  have f3 : 1 ≤ Cl / η := by rw [le_div_iff₀ hη]; linarith
  have f4 : Cl / η ≤ (C₄ : ℝ) / η := div_le_div_of_nonneg_right f1 hη.le
  have f5 : P' ≤ P :=
    (pow_le_pow_left₀ (by linarith) f4 Al).trans (pow_le_pow_right₀ (f3.trans f4) f2)
  have f6 : 1 ≤ P' := one_le_pow₀ f3
  have hP'pos : 0 < P' := by linarith
  have hT1r : (1 : ℝ) ≤ T := by linarith
  have hT1 : 1 ≤ T := by exact_mod_cast hT1r
  have hTpos : (0 : ℝ) < T := by linarith
  have f8 : P' ≤ (T : ℝ) := f5.trans hPT
  have f9 : ε ≤ (η / Cl) ^ Al := by
    have h1 : ε * P' ≤ 1 := (mul_le_mul_of_nonneg_left f5 hε).trans hεP
    have h2 : (η / Cl) ^ Al = 1 / P' := by
      rw [hP', div_pow, div_pow, one_div_div]
    rw [h2, le_div_iff₀ hP'pos]; exact h1
  
  let emb : (Fin ν → ℤ) × (Fin ν → ℤ) → (Fin (ν + ν) → ℤ) := fun s => Fin.append s.1 s.2
  have hinj : Function.Injective emb := by
    intro a b hab
    have h1 : a.1 = b.1 := funext fun k => by
      have := congrFun hab (Fin.castAdd ν k)
      simp only [emb, Fin.append_left] at this
      exact this
    have h2 : a.2 = b.2 := funext fun k => by
      have := congrFun hab (Fin.natAdd ν k)
      simp only [emb, Fin.append_right] at this
      exact this
    exact Prod.ext h1 h2
  have hcard : (S.image emb).card = S.card := Finset.card_image_of_injective _ hinj
  have hsub : S.image emb ⊆ intBox (ν + ν) T := by
    intro z hz
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hz
    unfold intBox
    rw [Finset.mem_Icc]
    constructor
    · intro l
      induction l using Fin.addCases with
      | left k =>
        show -(T : ℤ) ≤ Fin.append s.1 s.2 (Fin.castAdd ν k)
        rw [Fin.append_left]; exact (abs_le.mp (hbox s hs k).1).1
      | right k =>
        show -(T : ℤ) ≤ Fin.append s.1 s.2 (Fin.natAdd ν k)
        rw [Fin.append_right]; exact (abs_le.mp (hbox s hs k).2).1
    · intro l
      induction l using Fin.addCases with
      | left k =>
        show Fin.append s.1 s.2 (Fin.castAdd ν k) ≤ (T : ℤ)
        rw [Fin.append_left]; exact (abs_le.mp (hbox s hs k).1).2
      | right k =>
        show Fin.append s.1 s.2 (Fin.natAdd ν k) ≤ (T : ℤ)
        rw [Fin.append_right]; exact (abs_le.mp (hbox s hs k).2).2
  have hdens' : η * (((2 * T + 1 : ℕ) : ℝ) ^ (ν + ν)) ≤ ((S.image emb).card : ℝ) := by
    rw [hcard, ← two_mul]; push_cast; exact hdens
  have hform : ∀ (g1 g2 : Fin ν → ℝ) (s : (Fin ν → ℤ) × (Fin ν → ℤ)),
      ∑ l, Fin.append g1 g2 l * ((emb s l : ℤ) : ℝ)
        = ∑ k, (s.1 k : ℝ) * g1 k + ∑ k, (s.2 k : ℝ) * g2 k := by
    intro g1 g2 s
    rw [Fin.sum_univ_add]
    simp only [emb, Fin.append_left, Fin.append_right]
    congr 1
    · exact Finset.sum_congr rfl fun k _ => mul_comm _ _
    · exact Finset.sum_congr rfl fun k _ => mul_comm _ _
  have hper : ∀ j, ∃ qj : ℕ, 1 ≤ qj ∧ (qj : ℝ) ≤ P' ∧
      ∀ l, ∃ b : ℤ, |(qj : ℝ) * Fin.append (G1 j) (G2 j) l - (b : ℝ)| ≤ P' * ε / T := by
    intro j
    refine hlin T η ε 0 (S.image emb) (Fin.append (G1 j) (G2 j)) hT1 hη hη1 hε f9 f8
      hsub hdens' ?_
    intro z hz
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hz
    obtain ⟨e, he⟩ := hgood s hs j
    exact ⟨e, by rw [zero_add, hform]; exact he⟩
  choose qf hqf1 hqfP hqfe using hper
  have hprod_le : ∀ s : Finset ι, ((∏ i ∈ s, qf i : ℕ) : ℝ) ≤ P' ^ s.card := by
    intro s
    rw [Nat.cast_prod]
    calc ∏ i ∈ s, (qf i : ℝ) ≤ ∏ _i ∈ s, P' :=
          Finset.prod_le_prod (fun i _ => Nat.cast_nonneg _) (fun i _ => hqfP i)
      _ = P' ^ s.card := Finset.prod_const _
  have hPP : P' ^ Fintype.card ι ≤ P ^ Fintype.card ι := pow_le_pow_left₀ hP'pos.le f5 _
  have key : ∀ j l, ∃ b : ℤ, |((∏ i, qf i : ℕ) : ℝ) * Fin.append (G1 j) (G2 j) l - (b : ℝ)|
      ≤ P ^ Fintype.card ι * ε / T := by
    intro j l
    obtain ⟨b, hb⟩ := hqfe j l
    have hq : ∏ i, qf i = qf j * ∏ i ∈ Finset.univ.erase j, qf i :=
      (Finset.mul_prod_erase _ _ (Finset.mem_univ j)).symm
    have hrle : ((∏ i ∈ Finset.univ.erase j, qf i : ℕ) : ℝ) ≤ P' ^ (Fintype.card ι - 1) := by
      have := hprod_le (Finset.univ.erase j)
      rwa [Finset.card_erase_of_mem (Finset.mem_univ j), Finset.card_univ] at this
    have hne : Nonempty ι := ⟨j⟩
    have hcardpos : 0 < Fintype.card ι := Fintype.card_pos
    refine ⟨((∏ i ∈ Finset.univ.erase j, qf i : ℕ) : ℤ) * b, ?_⟩
    have heq : ((∏ i, qf i : ℕ) : ℝ) * Fin.append (G1 j) (G2 j) l
          - ((((∏ i ∈ Finset.univ.erase j, qf i : ℕ) : ℤ) * b : ℤ) : ℝ)
        = ((∏ i ∈ Finset.univ.erase j, qf i : ℕ) : ℝ)
          * ((qf j : ℝ) * Fin.append (G1 j) (G2 j) l - (b : ℝ)) := by
      rw [hq]; push_cast; ring
    rw [heq, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
    have hPε : 0 ≤ P' * ε / T := div_nonneg (mul_nonneg hP'pos.le hε) hTpos.le
    calc ((∏ i ∈ Finset.univ.erase j, qf i : ℕ) : ℝ)
          * |(qf j : ℝ) * Fin.append (G1 j) (G2 j) l - (b : ℝ)|
        ≤ P' ^ (Fintype.card ι - 1) * (P' * ε / T) :=
          mul_le_mul hrle hb (abs_nonneg _) (pow_nonneg hP'pos.le _)
      _ = P' ^ Fintype.card ι * ε / T := by
          rw [← mul_div_assoc, ← mul_assoc, ← pow_succ, Nat.sub_add_cancel hcardpos]
      _ ≤ P ^ Fintype.card ι * ε / T :=
          div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hPP hε) hTpos.le
  refine ⟨∏ i, qf i, ?_, ?_, ?_⟩
  · exact Nat.one_le_iff_ne_zero.mpr
      (Finset.prod_ne_zero_iff.mpr fun i _ => by have := hqf1 i; omega)
  · calc ((∏ i, qf i : ℕ) : ℝ) ≤ P' ^ (Finset.univ : Finset ι).card := hprod_le _
      _ = P' ^ Fintype.card ι := by rw [Finset.card_univ]
      _ ≤ P ^ Fintype.card ι := hPP
  · intro j k
    constructor
    · obtain ⟨b, hb⟩ := key j (Fin.castAdd ν k)
      rw [Fin.append_left] at hb
      exact ⟨b, hb⟩
    · obtain ⟨b, hb⟩ := key j (Fin.natAdd ν k)
      rw [Fin.append_right] at hb
      exact ⟨b, hb⟩

theorem kai_t2_coef_recover : ∀ (ν : ℕ) (c lam : Fin ν → Fin ν → Fin ν → ℤ) (C₁ β : ℝ) (q : ℕ)
    (θ : Fin ν → ℝ), 0 ≤ β →
    (∀ l k i, |(lam l k i : ℝ)| ≤ C₁) →
    (∀ l l', ∑ k, ∑ i, lam l k i * c k i l' = if l = l' then 1 else 0) →
    (∀ k i, ∃ e : ℤ, |(q : ℝ) * ∑ l, (c k i l : ℝ) * θ l - (e : ℝ)| ≤ β) →
    ∀ l, ∃ e : ℤ, |(q : ℝ) * θ l - (e : ℝ)| ≤ (ν : ℝ) ^ 2 * C₁ * β :=
by
  intro ν c lam C₁ β q θ hβ hlam hinv happ l
  choose e he using happ
  refine ⟨∑ k, ∑ i, lam l k i * e k i, ?_⟩
  have h1 : ∀ l', (∑ k, ∑ i, (lam l k i : ℝ) * (c k i l' : ℝ)) = if l = l' then 1 else 0 := by
    intro l'
    have h := congrArg (fun z : ℤ => (z : ℝ)) (hinv l l')
    simp only [Int.cast_sum, Int.cast_mul] at h
    rw [h]
    split_ifs <;> simp
  have hθ : θ l = ∑ k, ∑ i, (lam l k i : ℝ) * ∑ l', (c k i l' : ℝ) * θ l' := by
    calc θ l = ∑ l', (if l = l' then (1 : ℝ) else 0) * θ l' := by simp
      _ = ∑ l', (∑ k, ∑ i, (lam l k i : ℝ) * (c k i l' : ℝ)) * θ l' := by
          refine Finset.sum_congr rfl fun l' _ => ?_
          rw [h1 l']
      _ = ∑ l', ∑ k, ∑ i, (lam l k i : ℝ) * ((c k i l' : ℝ) * θ l') := by
          refine Finset.sum_congr rfl fun l' _ => ?_
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
      _ = ∑ k, ∑ l', ∑ i, (lam l k i : ℝ) * ((c k i l' : ℝ) * θ l') := Finset.sum_comm
      _ = ∑ k, ∑ i, ∑ l', (lam l k i : ℝ) * ((c k i l' : ℝ) * θ l') :=
          Finset.sum_congr rfl fun k _ => Finset.sum_comm
      _ = ∑ k, ∑ i, (lam l k i : ℝ) * ∑ l', (c k i l' : ℝ) * θ l' := by
          refine Finset.sum_congr rfl fun k _ => ?_
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Finset.mul_sum]
  have key : (q : ℝ) * θ l - (((∑ k, ∑ i, lam l k i * e k i : ℤ)) : ℝ)
      = ∑ k, ∑ i, (lam l k i : ℝ) *
          ((q : ℝ) * ∑ l', (c k i l' : ℝ) * θ l' - (e k i : ℝ)) := by
    rw [hθ, Finset.mul_sum]
    simp only [Int.cast_sum, Int.cast_mul]
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  rw [key]
  calc |∑ k, ∑ i, (lam l k i : ℝ) *
          ((q : ℝ) * ∑ l', (c k i l' : ℝ) * θ l' - (e k i : ℝ))|
      ≤ ∑ k, |∑ i, (lam l k i : ℝ) *
          ((q : ℝ) * ∑ l', (c k i l' : ℝ) * θ l' - (e k i : ℝ))| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ k, ∑ i, |(lam l k i : ℝ) *
          ((q : ℝ) * ∑ l', (c k i l' : ℝ) * θ l' - (e k i : ℝ))| :=
        Finset.sum_le_sum fun k _ => Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _k : Fin ν, ∑ _i : Fin ν, C₁ * β := by
        refine Finset.sum_le_sum fun k _ => Finset.sum_le_sum fun i _ => ?_
        rw [abs_mul]
        exact mul_le_mul (hlam l k i) (he k i) (abs_nonneg _)
          ((abs_nonneg _).trans (hlam l k i))
    _ = (ν : ℝ) ^ 2 * C₁ * β := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

theorem kai_t2_pigeon_family : ∀ {α : Type} (S : Finset α) (R a : ℕ) (X₁ : ℝ)
    (f : α → (Fin R → Fin a → ℤ) × (Fin R → Fin a → ℤ)), 0 ≤ X₁ →
    (∀ s ∈ S, ∀ m j, |((f s).1 m j : ℝ)| ≤ X₁ ∧ |((f s).2 m j : ℝ)| ≤ X₁) →
    ∃ g : (Fin R → Fin a → ℤ) × (Fin R → Fin a → ℤ),
      (∀ m j, |(g.1 m j : ℝ)| ≤ X₁ ∧ |(g.2 m j : ℝ)| ≤ X₁) ∧
      (S.card : ℝ) ≤ (2 * X₁ + 1) ^ (2 * R * a) * ((S.filter (fun s => f s = g)).card : ℝ) :=
by
  intro α S R a X₁ f hX₁ hf
  have s1 : ∀ z : ℤ, |(z : ℝ)| ≤ X₁ ↔ z ∈ Finset.Icc (-⌊X₁⌋) ⌊X₁⌋ := by
    intro z
    rw [Finset.mem_Icc, ← abs_le, Int.le_floor, Int.cast_abs]
  have s2 : ((Finset.Icc (-⌊X₁⌋) ⌊X₁⌋).card : ℝ) ≤ 2 * X₁ + 1 := by
    have hF : 0 ≤ ⌊X₁⌋ := Int.floor_nonneg.mpr hX₁
    have hFle : ((⌊X₁⌋ : ℤ) : ℝ) ≤ X₁ := Int.floor_le X₁
    rw [Int.card_Icc]
    have hk : 0 ≤ ⌊X₁⌋ + 1 - -⌊X₁⌋ := by omega
    have hc : (((⌊X₁⌋ + 1 - -⌊X₁⌋).toNat : ℕ) : ℝ) = (((⌊X₁⌋ + 1 - -⌊X₁⌋ : ℤ)) : ℝ) := by
      rw [← Int.cast_natCast, Int.toNat_of_nonneg hk]
    rw [hc]
    push_cast
    linarith
  set I : Finset ℤ := Finset.Icc (-⌊X₁⌋) ⌊X₁⌋ with hI
  set P : Finset (Fin R → Fin a → ℤ) :=
    Fintype.piFinset (fun _ : Fin R => Fintype.piFinset (fun _ : Fin a => I)) with hP
  set B : Finset ((Fin R → Fin a → ℤ) × (Fin R → Fin a → ℤ)) := P ×ˢ P with hB
  have memB : ∀ g : (Fin R → Fin a → ℤ) × (Fin R → Fin a → ℤ),
      g ∈ B ↔ (∀ m j, g.1 m j ∈ I) ∧ (∀ m j, g.2 m j ∈ I) := by
    intro g
    simp only [hB, hP, Finset.mem_product, Fintype.mem_piFinset]
  have hmaps : ∀ s ∈ S, f s ∈ B := by
    intro s hs
    rw [memB]
    exact ⟨fun m j => (s1 _).mp (hf s hs m j).1, fun m j => (s1 _).mp (hf s hs m j).2⟩
  have h0I : (0 : ℤ) ∈ I := (s1 0).mp (by simpa using hX₁)
  have hne : B.Nonempty := ⟨(fun _ _ => 0, fun _ _ => 0), (memB _).mpr ⟨fun _ _ => h0I, fun _ _ => h0I⟩⟩
  have hBpos : (0 : ℝ) < (B.card : ℝ) := by exact_mod_cast Finset.card_pos.mpr hne
  have hBcard : B.card = I.card ^ (2 * R * a) := by
    simp only [hB, hP, Finset.card_product, Fintype.card_piFinset, Finset.prod_const,
      Finset.card_univ, Fintype.card_fin]
    ring
  have hBle : (B.card : ℝ) ≤ (2 * X₁ + 1) ^ (2 * R * a) := by
    rw [hBcard, Nat.cast_pow]
    exact pow_le_pow_left₀ (Nat.cast_nonneg _) s2 _
  obtain ⟨g, hgB, hb⟩ := Finset.exists_le_card_fiber_of_nsmul_le_card_of_maps_to
    (M := ℝ) (b := (S.card : ℝ) / (B.card : ℝ)) hmaps hne
    (by rw [nsmul_eq_mul, mul_div_cancel₀ _ hBpos.ne'])
  refine ⟨g, ?_, ?_⟩
  · intro m j
    obtain ⟨h1, h2⟩ := (memB g).mp hgB
    exact ⟨(s1 _).mpr (h1 m j), (s1 _).mpr (h2 m j)⟩
  · rw [div_le_iff₀ hBpos] at hb
    have hF0 : (0 : ℝ) ≤ ((S.filter (fun s => f s = g)).card : ℝ) := Nat.cast_nonneg _
    calc (S.card : ℝ) ≤ ((S.filter (fun s => f s = g)).card : ℝ) * B.card := hb
      _ = (B.card : ℝ) * ((S.filter (fun s => f s = g)).card : ℝ) := mul_comm _ _
      _ ≤ (2 * X₁ + 1) ^ (2 * R * a) * ((S.filter (fun s => f s = g)).card : ℝ) :=
          mul_le_mul_of_nonneg_right hBle hF0

theorem kai_t2_A8_numeric : ∀ (ν A C₄ : ℕ), 1 ≤ ν → 1 ≤ C₄ → ∃ A₈ : ℕ, 1 ≤ A₈ ∧
