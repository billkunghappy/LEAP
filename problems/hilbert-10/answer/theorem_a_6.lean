noncomputable def kaiBadResidueCount {K : Type u} [Field K] [NumberField K] {d : ℕ}
    (S : Finset ℕ) (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) : ℕ :=
  ((resBox d (∏ p ∈ S, p)).filter (fun a =>
      ∀ p ∈ S, ∃ i : Fin 4, ¬ CoprimeToNat p (affEval (c₀ i) (c i) a))).card
