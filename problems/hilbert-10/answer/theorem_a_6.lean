theorem kai_param_exp_integral_differentiable {X : Type*} [MeasurableSpace X]
    (μ : MeasureTheory.Measure X) (D : Set X) (hD : MeasurableSet D)
    (hfin : μ D ≠ ⊤) (a b : X → ℂ) (ha : Measurable a) (hb : Measurable b)
    (Ra Rb : ℝ) (hab : ∀ x ∈ D, ‖a x‖ ≤ Ra) (hbb : ∀ x ∈ D, ‖b x‖ ≤ Rb) :
    Differentiable ℂ (fun s : ℂ => ∫ x in D, Complex.exp (s * a x + b x) ∂μ) :=
by
  intro s₀
  haveI : MeasureTheory.IsFiniteMeasure (μ.restrict D) :=
    MeasureTheory.isFiniteMeasure_restrict.mpr hfin
  set M : ℝ := (‖s₀‖ + 1) * Ra + Rb with hM
  have hmeasF : ∀ s : ℂ, Measurable (fun x => Complex.exp (s * a x + b x)) := fun s =>
    Complex.measurable_exp.comp ((measurable_const.mul ha).add hb)
  have key : ∀ x ∈ D, ∀ s : ℂ, ‖s‖ ≤ ‖s₀‖ + 1 →
      ‖Complex.exp (s * a x + b x)‖ ≤ Real.exp M ∧
      ‖a x * Complex.exp (s * a x + b x)‖ ≤ Ra * Real.exp M := by
    intro x hx s hs
    have hax := hab x hx
    have hbx := hbb x hx
    have hRa : 0 ≤ Ra := (norm_nonneg _).trans hax
    have h1 : (s * a x + b x).re ≤ M := by
      have e1 := Complex.re_le_norm (s * a x + b x)
      have e2 := norm_add_le (s * a x) (b x)
      have e3 : ‖s * a x‖ = ‖s‖ * ‖a x‖ := norm_mul _ _
      have e4 : ‖s‖ * ‖a x‖ ≤ (‖s₀‖ + 1) * Ra :=
        mul_le_mul hs hax (norm_nonneg _) (by positivity)
      rw [hM]; linarith
    have h2 : ‖Complex.exp (s * a x + b x)‖ ≤ Real.exp M := by
      rw [Complex.norm_exp]; exact Real.exp_le_exp.mpr h1
    refine ⟨h2, ?_⟩
    rw [norm_mul]
    exact mul_le_mul hax h2 (norm_nonneg _) hRa
  have hball : ∀ s ∈ Metric.ball s₀ 1, ‖s‖ ≤ ‖s₀‖ + 1 := by
    intro s hs
    rw [mem_ball_iff_norm] at hs
    have := norm_sub_norm_le s s₀
    linarith
  have hderiv := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := μ.restrict D) (x₀ := s₀)
    (F := fun s x => Complex.exp (s * a x + b x))
    (F' := fun s x => a x * Complex.exp (s * a x + b x))
    (bound := fun _ => Ra * Real.exp M)
    (Metric.ball_mem_nhds s₀ one_pos)
    (Filter.Eventually.of_forall (fun s => (hmeasF s).aestronglyMeasurable))
    (MeasureTheory.Integrable.of_bound (hmeasF s₀).aestronglyMeasurable (Real.exp M)
      ((MeasureTheory.ae_restrict_mem hD).mono (fun x hx => (key x hx s₀ (by linarith)).1)))
    ((ha.mul (hmeasF s₀)).aestronglyMeasurable)
    ((MeasureTheory.ae_restrict_mem hD).mono (fun x hx s hs => (key x hx s (hball s hs)).2))
    (MeasureTheory.integrable_const _)
    (Filter.Eventually.of_forall (fun x s _ => by
      have h := (((hasDerivAt_id' s).mul_const (a x)).add_const (b x)).cexp
      convert h using 1
      ring))
  exact hderiv.2.differentiableAt

theorem kai_slab_character_vanishing {ι : Type*} [Fintype ι] [Nonempty ι]
    (m : ι → ℝ) (hm : ∀ i, 0 < m i) (n : ℝ) (hmn : (∑ j, m j) = n)
    (Lat : AddSubgroup (ι → ℝ)) (hcount : Countable ↥Lat)
    (hLat0 : ∀ γ' ∈ Lat, (∑ j, m j * γ' j) = 0)
    (G : Set (ι → ℝ))
    (hfd : MeasureTheory.IsAddFundamentalDomain (↥Lat) G MeasureTheory.volume)
    (γ : ι → ℂ)
    (hper : ∀ γ' ∈ Lat, Complex.exp (∑ j, γ j * ((γ' j : ℝ) : ℂ)) = 1)
    (hnp : ¬ ∃ lam : ℂ, ∀ j, γ j = lam * ((m j : ℝ) : ℂ)) :
    (∫ u in G ∩ {u : ι → ℝ | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1},
        Complex.exp (∑ j, γ j * ((u j - (∑ k, m k * u k) / n : ℝ) : ℂ))) = 0 :=
by
  classical
  haveI : Countable ↥Lat := hcount
  set Ω : Set (ι → ℝ) := {u : ι → ℝ | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1} with hΩdef
  set χ : (ι → ℝ) → ℂ :=
    fun u => Complex.exp (∑ j, γ j * ((u j - (∑ k, m k * u k) / n : ℝ) : ℂ)) with hχdef
  have hLadd : ∀ a u : ι → ℝ, (∑ j, m j * (a + u) j) = (∑ j, m j * a j) + ∑ j, m j * u j := by
    intro a u
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by rw [Pi.add_apply]; ring
  have hLtrans : ∀ a u : ι → ℝ, (∑ j, m j * a j) = 0 →
      (∑ j, m j * (a + u) j) = ∑ j, m j * u j := by
    intro a u ha
    rw [hLadd a u, ha, zero_add]
  have hmemΩ : ∀ a u : ι → ℝ, (∑ j, m j * a j) = 0 → (a + u ∈ Ω ↔ u ∈ Ω) := by
    intro a u ha
    simp only [hΩdef, Set.mem_setOf_eq, hLtrans a u ha]
  have hchi : ∀ a u : ι → ℝ, (∑ j, m j * a j) = 0 →
      χ (a + u) = Complex.exp (∑ j, γ j * ((a j : ℝ) : ℂ)) * χ u := by
    intro a u ha
    simp only [hχdef]
    rw [← Complex.exp_add, hLtrans a u ha, ← Finset.sum_add_distrib]
    refine congrArg Complex.exp (Finset.sum_congr rfl fun j _ => ?_)
    rw [Pi.add_apply]
    push_cast
    ring
  have hFa : ∀ a : ι → ℝ, (∑ j, m j * a j) = 0 → ∀ x : ι → ℝ,
      Set.indicator Ω χ (a + x)
        = Complex.exp (∑ j, γ j * ((a j : ℝ) : ℂ)) * Set.indicator Ω χ x := by
    intro a ha x
    by_cases hx : x ∈ Ω
    · have hax : a + x ∈ Ω := (hmemΩ a x ha).mpr hx
      rw [Set.indicator_of_mem hax, Set.indicator_of_mem hx, hchi a x ha]
    · have hax : a + x ∉ Ω := fun h => hx ((hmemΩ a x ha).mp h)
      rw [Set.indicator_of_notMem hax, Set.indicator_of_notMem hx, mul_zero]
  have hFper : ∀ (g : ↥Lat) (x : ι → ℝ),
      Set.indicator Ω χ (g +ᵥ x) = Set.indicator Ω χ x := by
    intro g x
    have hgm : (g : ι → ℝ) ∈ Lat := g.2
    have h := hFa (g : ι → ℝ) (hLat0 _ hgm) x
    rw [hper _ hgm, one_mul] at h
    have hvadd : (g +ᵥ x : ι → ℝ) = (g : ι → ℝ) + x := rfl
    rw [hvadd]
    exact h
  have translate : ∀ (Fn : (ι → ℝ) → ℂ) (c : ℂ) (a : ι → ℝ),
      (∀ (g : ↥Lat) (x : ι → ℝ), Fn (g +ᵥ x) = Fn x) →
      (∀ x : ι → ℝ, Fn (a + x) = c * Fn x) →
      c * (∫ u in G, Fn u) = ∫ u in G, Fn u := by
    intro Fn c a hpr heig
    have hmp : MeasureTheory.MeasurePreserving (fun x : ι → ℝ => a + x)
        (MeasureTheory.volume : MeasureTheory.Measure (ι → ℝ)) MeasureTheory.volume :=
      MeasureTheory.measurePreserving_add_left MeasureTheory.volume a
    have hme : MeasurableEmbedding (fun x : ι → ℝ => a + x) := measurableEmbedding_addLeft a
    have hfd2 : MeasureTheory.IsAddFundamentalDomain (↥Lat)
        ((fun x : ι → ℝ => a + x) ⁻¹' G) MeasureTheory.volume := by
      refine hfd.preimage_of_equiv hmp.quasiMeasurePreserving Function.bijective_id ?_
      intro g x
      show a + ((g : ι → ℝ) + x) = (g : ι → ℝ) + (a + x)
      abel
    have e1 : (∫ u in G, Fn u) = ∫ u in ((fun x : ι → ℝ => a + x) ⁻¹' G), Fn u :=
      hfd.setIntegral_eq hfd2 hpr
    have e2 : (∫ x in ((fun x : ι → ℝ => a + x) ⁻¹' G), Fn (a + x)) = ∫ y in G, Fn y :=
      hmp.setIntegral_preimage_emb hme Fn G
    have e3 : (∫ x in ((fun x : ι → ℝ => a + x) ⁻¹' G), Fn (a + x))
        = ∫ x in ((fun x : ι → ℝ => a + x) ⁻¹' G), c * Fn x := by
      simp only [heig]
    have e4 : (∫ x in ((fun x : ι → ℝ => a + x) ⁻¹' G), c * Fn x)
        = c * ∫ x in ((fun x : ι → ℝ => a + x) ⁻¹' G), Fn x :=
      MeasureTheory.integral_const_mul c Fn
    calc c * (∫ u in G, Fn u)
        = c * ∫ u in ((fun x : ι → ℝ => a + x) ⁻¹' G), Fn u := by rw [e1]
      _ = ∫ x in ((fun x : ι → ℝ => a + x) ⁻¹' G), c * Fn x := e4.symm
      _ = ∫ x in ((fun x : ι → ℝ => a + x) ⁻¹' G), Fn (a + x) := e3.symm
      _ = ∫ y in G, Fn y := e2
  have hLmeas : Measurable (fun u : ι → ℝ => ∑ j, m j * u j) :=
    (continuous_finset_sum Finset.univ
      (fun j _ => continuous_const.mul (continuous_apply j))).measurable
  have hΩmeas : MeasurableSet Ω := by
    rw [hΩdef]
    exact (measurableSet_le measurable_const hLmeas).inter
      (measurableSet_le hLmeas measurable_const)
  have e5 : (∫ u in G, Set.indicator Ω χ u) = ∫ u in G ∩ Ω, χ u :=
    MeasureTheory.setIntegral_indicator hΩmeas
  have key : ∀ a : ι → ℝ, (∑ j, m j * a j) = 0 →
      Complex.exp (∑ j, γ j * ((a j : ℝ) : ℂ)) * (∫ u in G ∩ Ω, χ u)
        = ∫ u in G ∩ Ω, χ u := by
    intro a ha
    rw [← e5]
    exact translate (Set.indicator Ω χ) _ a hFper (hFa a ha)
  have rigid : ∀ z : ℂ, (∀ t : ℝ, Complex.exp ((t : ℂ) * z) = 1) → z = 0 := by
    intro z hz
    have h1 : Complex.exp z = 1 := by
      have h := hz 1
      simpa using h
    obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.mp h1
    rcases eq_or_ne k 0 with hk0 | hk0
    · rw [hk, hk0]
      simp
    · have hkC : ((k : ℂ)) ≠ 0 := Int.cast_ne_zero.mpr hk0
      have ht := hz (1 / (2 * (k : ℝ)))
      have hcast : ((1 / (2 * (k : ℝ)) : ℝ) : ℂ) * z = (Real.pi : ℂ) * Complex.I := by
        rw [hk]
        push_cast
        field_simp
      rw [hcast, Complex.exp_pi_mul_I] at ht
      norm_num at ht
  by_contra hI
  have hI0 : (∫ u in G ∩ Ω, χ u) ≠ 0 := hI
  have hchar : ∀ a : ι → ℝ, (∑ j, m j * a j) = 0 →
      Complex.exp (∑ j, γ j * ((a j : ℝ) : ℂ)) = 1 := by
    intro a ha
    have h2 : Complex.exp (∑ j, γ j * ((a j : ℝ) : ℂ)) * (∫ u in G ∩ Ω, χ u)
        = 1 * (∫ u in G ∩ Ω, χ u) := by
      rw [one_mul]
      exact key a ha
    exact mul_right_cancel₀ hI0 h2
  have hker : ∀ a : ι → ℝ, (∑ j, m j * a j) = 0 →
      (∑ j, γ j * ((a j : ℝ) : ℂ)) = 0 := by
    intro a ha
    refine rigid _ (fun t => ?_)
    have hta : (∑ j, m j * (t * a j)) = 0 := by
      have hts : (∑ j, m j * (t * a j)) = t * ∑ j, m j * a j := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [hts, ha, mul_zero]
    have h : Complex.exp (∑ j, γ j * ((t * a j : ℝ) : ℂ)) = 1 :=
      hchar (fun j => t * a j) hta
    have hzt : (∑ j, γ j * ((t * a j : ℝ) : ℂ))
        = (t : ℂ) * ∑ j, γ j * ((a j : ℝ) : ℂ) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      push_cast
      ring
    rw [hzt] at h
    exact h
  obtain ⟨i0⟩ : Nonempty ι := inferInstance
  have hm0 : ((m i0 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt (hm i0))
  apply hnp
  refine ⟨γ i0 / ((m i0 : ℝ) : ℂ), fun j => ?_⟩
  set a : ι → ℝ := fun k => m j * (if k = i0 then (1 : ℝ) else 0)
      - m i0 * (if k = j then (1 : ℝ) else 0) with hadef
  have ha0 : (∑ k, m k * a k) = 0 := by
    have hterm : ∀ k : ι, m k * a k
        = (if k = i0 then m k * m j else 0) - (if k = j then m k * m i0 else 0) := by
      intro k
      simp only [hadef]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl fun k _ => hterm k, Finset.sum_sub_distrib,
      Finset.sum_ite_eq' Finset.univ i0 (fun k => m k * m j),
      Finset.sum_ite_eq' Finset.univ j (fun k => m k * m i0)]
    simp only [Finset.mem_univ, if_true]
    ring
  have hcast : ∀ k : ι, γ k * ((a k : ℝ) : ℂ)
      = (if k = i0 then γ k * ((m j : ℝ) : ℂ) else 0)
        - (if k = j then γ k * ((m i0 : ℝ) : ℂ) else 0) := by
    intro k
    simp only [hadef]
    split_ifs <;> push_cast <;> ring
  have hstar : ((m j : ℝ) : ℂ) * γ i0 - ((m i0 : ℝ) : ℂ) * γ j = 0 := by
    have h := hker a ha0
    rw [Finset.sum_congr rfl fun k _ => hcast k, Finset.sum_sub_distrib,
      Finset.sum_ite_eq' Finset.univ i0 (fun k => γ k * ((m j : ℝ) : ℂ)),
      Finset.sum_ite_eq' Finset.univ j (fun k => γ k * ((m i0 : ℝ) : ℂ))] at h
    simp only [Finset.mem_univ, if_true] at h
    linear_combination h
  rw [div_mul_eq_mul_div, eq_div_iff hm0]
  linear_combination -hstar

theorem kai_reflected_slab_domain {ι : Type*} [Fintype ι]
    (m : ι → ℝ) (n : ℝ) (hmn : (∑ j, m j) = n) (hn : 0 < n)
    (Lat : AddSubgroup (ι → ℝ)) (hcount : Countable ↥Lat)
    (F : Set (ι → ℝ)) (hF : MeasurableSet F)
    (hfd : MeasureTheory.IsAddFundamentalDomain (↥Lat) F MeasureTheory.volume)
    (htr : ∀ (u : ι → ℝ) (ρ : ℝ), u ∈ F ↔ (fun i => u i + ρ) ∈ F)
    (c : ℝ) (hslab : ∀ u ∈ F, ∀ i, |u i - (∑ j, m j * u j) / n| ≤ c)
    (x : ι → ℝ) :
    MeasurableSet {u : ι → ℝ | (fun i => x i - u i) ∈ F} ∧
    MeasureTheory.IsAddFundamentalDomain (↥Lat)
        {u : ι → ℝ | (fun i => x i - u i) ∈ F} MeasureTheory.volume ∧
    (∀ (u : ι → ℝ) (ρ : ℝ),
        (fun i => x i - u i) ∈ F ↔ (fun i => x i - (u i + ρ)) ∈ F) ∧
    (∀ u : ι → ℝ, (fun i => x i - u i) ∈ F → ∀ i,
        |u i - (∑ j, m j * u j) / n| ≤ c + |x i - (∑ j, m j * x j) / n|) ∧
    MeasureTheory.volume ({u : ι → ℝ | (fun i => x i - u i) ∈ F} ∩
          {u | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1})
      = MeasureTheory.volume (F ∩
          {u | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1}) :=
by
  classical
  have hT : MeasureTheory.MeasurePreserving
      (fun u : ι → ℝ => fun i => x i - u i)
      MeasureTheory.volume MeasureTheory.volume := by
    have h := (MeasureTheory.measurePreserving_add_left
        (MeasureTheory.volume : MeasureTheory.Measure (ι → ℝ)) x).comp
      (MeasureTheory.Measure.measurePreserving_neg
        (MeasureTheory.volume : MeasureTheory.Measure (ι → ℝ)))
    have heq : ((fun v : ι → ℝ => x + v) ∘ (Neg.neg : (ι → ℝ) → (ι → ℝ)))
        = (fun u : ι → ℝ => fun i => x i - u i) := by
      funext u i
      simp [Function.comp_apply, Pi.add_apply, Pi.neg_apply, sub_eq_add_neg]
    rw [heq] at h
    exact h
  have hLmeas : Measurable (fun u : ι → ℝ => ∑ j, m j * u j) := by
    have hterm : ∀ j : ι, Measurable (fun u : ι → ℝ => m j * u j) := by
      intro j
      exact Measurable.mul measurable_const (measurable_pi_apply j)
    exact Finset.measurable_sum Finset.univ (fun j _ => hterm j)
  have hLT : ∀ u : ι → ℝ,
      (∑ j, m j * (x j - u j)) = (∑ j, m j * x j) - (∑ j, m j * u j) := by
    intro u
    rw [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl (fun j _ => mul_sub (m j) (x j) (u j))
  have hSmeas : MeasurableSet {v : ι → ℝ | (∑ j, m j * x j) - 1 ≤ ∑ j, m j * v j ∧
      (∑ j, m j * v j) ≤ (∑ j, m j * x j)} :=
    MeasurableSet.inter (measurableSet_le measurable_const hLmeas)
      (measurableSet_le hLmeas measurable_const)
  have hFS : MeasurableSet (F ∩ {v : ι → ℝ | (∑ j, m j * x j) - 1 ≤ ∑ j, m j * v j ∧
      (∑ j, m j * v j) ≤ (∑ j, m j * x j)}) := hF.inter hSmeas
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact hF.preimage hT.measurable
  · have he : Function.Bijective (fun γ : ↥Lat => -γ) := neg_involutive.bijective
    have hsc : ∀ γ : ↥Lat, Function.Semiconj (fun u : ι → ℝ => fun i => x i - u i)
        (fun u : ι → ℝ => (fun γ : ↥Lat => -γ) γ +ᵥ u) (fun u : ι → ℝ => γ +ᵥ u) := by
      intro γ u
      funext i
      simp only [AddSubgroup.vadd_def, vadd_eq_add, Pi.add_apply, Pi.neg_apply,
        NegMemClass.coe_neg]
      ring
    exact hfd.preimage_of_equiv hT.quasiMeasurePreserving he hsc
  · intro u ρ
    have hfun : (fun i => x i - u i + -ρ) = (fun i => x i - (u i + ρ)) := by
      funext i; ring
    rw [← hfun]
    exact htr (fun i => x i - u i) (-ρ)
  · intro u hu i
    have h2 := hslab (fun i => x i - u i) hu i
    rw [hLT u] at h2
    have hstar : u i - (∑ j, m j * u j) / n
        = (x i - (∑ j, m j * x j) / n)
          - (x i - u i - ((∑ j, m j * x j) - (∑ j, m j * u j)) / n) := by
      ring
    rw [hstar]
    have h1 := abs_sub (x i - (∑ j, m j * x j) / n)
      (x i - u i - ((∑ j, m j * x j) - (∑ j, m j * u j)) / n)
    linarith
  · have hset1 : {u : ι → ℝ | (fun i => x i - u i) ∈ F} ∩
        {u | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1}
        = (fun u : ι → ℝ => fun i => x i - u i) ⁻¹'
          (F ∩ {v : ι → ℝ | (∑ j, m j * x j) - 1 ≤ ∑ j, m j * v j ∧
                (∑ j, m j * v j) ≤ (∑ j, m j * x j)}) := by
      ext u
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_setOf_eq, hLT u]
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨h1, by linarith, by linarith⟩
      · rintro ⟨h1, h2, h3⟩
        exact ⟨h1, by linarith, by linarith⟩
    have he5 : MeasureTheory.volume ({u : ι → ℝ | (fun i => x i - u i) ∈ F} ∩
          {u | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1})
        = MeasureTheory.volume (F ∩ {v : ι → ℝ |
            (∑ j, m j * x j) - 1 ≤ ∑ j, m j * v j ∧
            (∑ j, m j * v j) ≤ (∑ j, m j * x j)}) := by
      rw [hset1]
      exact hT.measure_preimage hFS.nullMeasurableSet
    have hn0 : n ≠ 0 := ne_of_gt hn
    have hLtau : ∀ u : ι → ℝ,
        (∑ j, m j * (u j + ((∑ j, m j * x j) - 1) / n))
          = (∑ j, m j * u j) + ((∑ j, m j * x j) - 1) := by
      intro u
      have h1 : (∑ j, m j * (u j + ((∑ j, m j * x j) - 1) / n))
          = (∑ j, m j * u j) + (∑ j, m j) * (((∑ j, m j * x j) - 1) / n) := by
        simp only [mul_add]
        rw [Finset.sum_add_distrib, ← Finset.sum_mul]
      have h2 : n * (((∑ j, m j * x j) - 1) / n) = (∑ j, m j * x j) - 1 := by
        field_simp
      rw [h1, hmn, h2]
    have hset2 : F ∩ {u : ι → ℝ | 0 ≤ ∑ j, m j * u j ∧ (∑ j, m j * u j) ≤ 1}
        = (fun u : ι → ℝ => fun i => u i + ((∑ j, m j * x j) - 1) / n) ⁻¹'
          (F ∩ {v : ι → ℝ | (∑ j, m j * x j) - 1 ≤ ∑ j, m j * v j ∧
                (∑ j, m j * v j) ≤ (∑ j, m j * x j)}) := by
      ext u
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_setOf_eq, hLtau u]
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨(htr u (((∑ j, m j * x j) - 1) / n)).mp h1, by linarith, by linarith⟩
      · rintro ⟨h1, h2, h3⟩
        exact ⟨(htr u (((∑ j, m j * x j) - 1) / n)).mpr h1, by linarith, by linarith⟩
    have htau : MeasureTheory.MeasurePreserving
        (fun u : ι → ℝ => fun i => u i + ((∑ j, m j * x j) - 1) / n)
        MeasureTheory.volume MeasureTheory.volume := by
      have h := MeasureTheory.measurePreserving_add_right
        (MeasureTheory.volume : MeasureTheory.Measure (ι → ℝ))
        (fun _ : ι => ((∑ j, m j * x j) - 1) / n)
      have heq : (fun v : ι → ℝ => v + (fun _ : ι => ((∑ j, m j * x j) - 1) / n))
          = (fun u : ι → ℝ => fun i => u i + ((∑ j, m j * x j) - 1) / n) := by
        funext u i; simp
      rw [heq] at h
      exact h
    have he6 := htau.measure_preimage hFS.nullMeasurableSet
    rw [← hset2] at he6
    exact he5.trans he6.symm

theorem kai_slab_split_at_level {ι : Type*} [Fintype ι]
    (m : ι → ℝ) (i₀ : ι) (hm : m i₀ ≠ 0)
    (G : Set (ι → ℝ)) (hGm : MeasurableSet G) (θ : ℝ) (f : (ι → ℝ) → ℂ)
    (h1 : MeasureTheory.IntegrableOn f
        (G ∩ {u | (∑ j, m j * u j) ≤ θ}) MeasureTheory.volume)
    (h2 : MeasureTheory.IntegrableOn f
        (G ∩ {u | θ ≤ ∑ j, m j * u j}) MeasureTheory.volume) :
    MeasureTheory.IntegrableOn f G MeasureTheory.volume ∧
      (∫ u in G, f u) = (∫ u in G ∩ {u | (∑ j, m j * u j) ≤ θ}, f u)
        + ∫ u in G ∩ {u | θ ≤ ∑ j, m j * u j}, f u :=
by
  classical
  have hterm : ∀ j : ι, Measurable (fun u : ι → ℝ => m j * u j) :=
    fun j => Measurable.mul measurable_const (measurable_pi_apply j)
  have hL : Measurable (fun u : ι → ℝ => ∑ j, m j * u j) :=
    Finset.measurable_sum Finset.univ (fun j _ => hterm j)
  have hBpos : MeasurableSet {u : ι → ℝ | θ < ∑ j, m j * u j} :=
    measurableSet_lt measurable_const hL
  have hnull : MeasureTheory.volume {u : ι → ℝ | (∑ j, m j * u j) = θ} = 0 := by
    obtain ⟨Lm, hLmapp⟩ : ∃ Lm : (ι → ℝ) →ₗ[ℝ] ℝ, ∀ u : ι → ℝ, Lm u = ∑ j, m j * u j :=
      ⟨∑ j : ι, m j • LinearMap.proj j, fun u => by
        simp [LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.proj_apply, smul_eq_mul]⟩
    have hsingle : ∀ c : ℝ, Lm (Pi.single i₀ c) = m i₀ * c := by
      intro c
      rw [hLmapp]
      have hoff : ∀ b ∈ (Finset.univ : Finset ι), b ≠ i₀ →
          m b * (Pi.single i₀ c : ι → ℝ) b = 0 := by
        intro b _ hb
        rw [Pi.single_eq_of_ne hb, mul_zero]
      rw [Finset.sum_eq_single i₀ hoff (fun h => absurd (Finset.mem_univ i₀) h),
        Pi.single_eq_same]
    have hK : LinearMap.ker Lm ≠ ⊤ := by
      intro htop
      have hmem : (Pi.single i₀ (1 : ℝ) : ι → ℝ) ∈ LinearMap.ker Lm :=
        Submodule.eq_top_iff'.mp htop _
      rw [LinearMap.mem_ker, hsingle, mul_one] at hmem
      exact hm hmem
    have hKnull :
        MeasureTheory.volume ((LinearMap.ker Lm : Submodule ℝ (ι → ℝ)) : Set (ι → ℝ)) = 0 :=
      MeasureTheory.Measure.addHaar_submodule MeasureTheory.volume _ hK
    obtain ⟨u₀, hLu₀⟩ : ∃ u₀ : ι → ℝ, Lm u₀ = θ :=
      ⟨Pi.single i₀ (θ / m i₀), by rw [hsingle, mul_div_cancel₀ _ hm]⟩
    have hset : {u : ι → ℝ | (∑ j, m j * u j) = θ}
        = (fun w : ι → ℝ => w + (-u₀)) ⁻¹'
            ((LinearMap.ker Lm : Submodule ℝ (ι → ℝ)) : Set (ι → ℝ)) := by
      ext v
      constructor
      · intro hv
        simp only [Set.mem_setOf_eq] at hv
        simp only [Set.mem_preimage, SetLike.mem_coe, LinearMap.mem_ker]
        rw [← sub_eq_add_neg, map_sub, hLu₀, hLmapp, hv, sub_self]
      · intro hv
        simp only [Set.mem_preimage, SetLike.mem_coe, LinearMap.mem_ker] at hv
        rw [← sub_eq_add_neg, map_sub, hLu₀, sub_eq_zero, hLmapp] at hv
        exact hv
    rw [hset, MeasureTheory.measure_preimage_add_right]
    exact hKnull
  have hsubset : G ∩ {u : ι → ℝ | θ < ∑ j, m j * u j}
      ⊆ G ∩ {u : ι → ℝ | θ ≤ ∑ j, m j * u j} := by
    rintro u ⟨hg, hlt⟩
    have hlt' : θ < ∑ j, m j * u j := hlt
    exact ⟨hg, le_of_lt hlt'⟩
  have hsplit : (G ∩ {u : ι → ℝ | (∑ j, m j * u j) ≤ θ})
      ∪ (G ∩ {u : ι → ℝ | θ < ∑ j, m j * u j}) = G := by
    ext u
    simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_setOf_eq]
    constructor
    · rintro (⟨hg, -⟩ | ⟨hg, -⟩) <;> exact hg
    · intro hg
      by_cases h : (∑ j, m j * u j) ≤ θ
      · exact Or.inl ⟨hg, h⟩
      · push_neg at h
        exact Or.inr ⟨hg, h⟩
  have hdisj : Disjoint (G ∩ {u : ι → ℝ | (∑ j, m j * u j) ≤ θ})
      (G ∩ {u : ι → ℝ | θ < ∑ j, m j * u j}) := by
    rw [Set.disjoint_left]
    intro u hu hu'
    have ha : (∑ j, m j * u j) ≤ θ := hu.2
    have hb : θ < ∑ j, m j * u j := hu'.2
    linarith
  have h2' : MeasureTheory.IntegrableOn f
      (G ∩ {u : ι → ℝ | θ < ∑ j, m j * u j}) MeasureTheory.volume := h2.mono_set hsubset
  have hIntG : MeasureTheory.IntegrableOn f G MeasureTheory.volume := by
    rw [← hsplit]
    exact h1.union h2'
  have hae : ((G ∩ {u : ι → ℝ | θ < ∑ j, m j * u j} : Set (ι → ℝ)))
      =ᵐ[MeasureTheory.volume] ((G ∩ {u : ι → ℝ | θ ≤ ∑ j, m j * u j} : Set (ι → ℝ))) := by
    rw [MeasureTheory.ae_eq_set]
    refine ⟨?_, ?_⟩
    · rw [Set.diff_eq_empty.mpr hsubset]
      exact MeasureTheory.measure_empty
    · refine MeasureTheory.measure_mono_null ?_ hnull
      intro u hu
      have hg : u ∈ G := hu.1.1
      have hge : θ ≤ ∑ j, m j * u j := hu.1.2
      have hnotlt : ¬ (θ < ∑ j, m j * u j) := fun h => hu.2 ⟨hg, h⟩
      push_neg at hnotlt
      exact le_antisymm hnotlt hge
  refine ⟨hIntG, ?_⟩
  have key : (∫ u in G, f u)
      = (∫ u in G ∩ {u : ι → ℝ | (∑ j, m j * u j) ≤ θ}, f u)
        + ∫ u in G ∩ {u : ι → ℝ | θ < ∑ j, m j * u j}, f u := by
    rw [← MeasureTheory.setIntegral_union hdisj (hGm.inter hBpos) h1 h2', hsplit]
  rw [key, MeasureTheory.setIntegral_congr_set hae]

theorem kai_mf_cone_slab_elementary_integral {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (Lat : AddSubgroup (NumberField.InfinitePlace K → ℝ)) (hcount : Countable ↥Lat)
    (F : Set (NumberField.InfinitePlace K → ℝ)) (c : ℝ) (hc : 1 ≤ c)
    (hF : MeasurableSet F)
    (hfd : MeasureTheory.IsAddFundamentalDomain (↥Lat) F MeasureTheory.volume)
    (hLat0 : ∀ γ ∈ Lat, kaiMFLogNorm K γ = 0)
    (hslab : ∀ u ∈ F, ∀ w : NumberField.InfinitePlace K,
        |u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)| ≤ c)
    (htrans : ∀ (u : NumberField.InfinitePlace K → ℝ) (ρ : ℝ),
        u ∈ F ↔ (fun w => u w + ρ) ∈ F)
    (x : NumberField.InfinitePlace K → ℝ) :
    ∃ (Xi : Set (NumberField.InfinitePlace K → ℝ) →
            (NumberField.InfinitePlace K → ℂ) → ℂ) (MXi c₂ : ℝ),
      0 ≤ MXi ∧ 1 ≤ c₂ ∧
      Xi {u : NumberField.InfinitePlace K → ℝ | (fun w => x w - u w) ∈ F} 0 = Xi F 0 ∧
      Xi F 0 = (((MeasureTheory.volume (F ∩ {u : NumberField.InfinitePlace K → ℝ |
          0 ≤ kaiMFLogNorm K u ∧ kaiMFLogNorm K u ≤ 1})).toReal : ℝ) : ℂ) ∧
      MeasurableSet {u : NumberField.InfinitePlace K → ℝ | (fun w => x w - u w) ∈ F} ∧
      MeasureTheory.IsAddFundamentalDomain (↥Lat)
        {u : NumberField.InfinitePlace K → ℝ | (fun w => x w - u w) ∈ F}
        MeasureTheory.volume ∧
      (∀ u ∈ {u : NumberField.InfinitePlace K → ℝ | (fun w => x w - u w) ∈ F},
          ∀ w : NumberField.InfinitePlace K,
            |u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ)| ≤ c₂) ∧
      (∀ G : Set (NumberField.InfinitePlace K → ℝ),
        (G = F ∨ G = {u : NumberField.InfinitePlace K → ℝ | (fun w => x w - u w) ∈ F}) →
        (∀ γ : NumberField.InfinitePlace K → ℂ,
            ‖Xi G γ‖ ≤ MXi *
              Real.exp (c₂ * ∑ w : NumberField.InfinitePlace K, |(γ w).re|)) ∧
        (∀ AA BB : NumberField.InfinitePlace K → ℂ,
            Differentiable ℂ (fun s : ℂ => Xi G (fun w => AA w * s + BB w))) ∧
        (∀ γ : NumberField.InfinitePlace K → ℂ,
            (∀ γ' ∈ Lat, Complex.exp (∑ w : NumberField.InfinitePlace K,
                γ w * ((γ' w : ℝ) : ℂ)) = 1) →
            (¬ ∃ lam : ℂ, ∀ w : NumberField.InfinitePlace K,
                γ w = lam * ((w.mult : ℝ) : ℂ)) → Xi G γ = 0) ∧
        (∀ γ : NumberField.InfinitePlace K → ℂ,
            0 < (∑ w : NumberField.InfinitePlace K, γ w).re → ∀ θ : ℝ,
            MeasureTheory.IntegrableOn (fun u => kaiMFConeWeight K γ u)
                (G ∩ {u | kaiMFLogNorm K u ≤ θ}) MeasureTheory.volume ∧
            (∫ u in G ∩ {u | kaiMFLogNorm K u ≤ θ}, kaiMFConeWeight K γ u)
              = ((Module.finrank ℚ K : ℂ) /
                    (∑ w : NumberField.InfinitePlace K, γ w)) *
                  Complex.exp ((∑ w : NumberField.InfinitePlace K, γ w) * (θ : ℂ) /
                    (Module.finrank ℚ K : ℂ)) * Xi G γ) ∧
        (∀ γ : NumberField.InfinitePlace K → ℂ,
            (∑ w : NumberField.InfinitePlace K, γ w).re < 0 → ∀ θ : ℝ,
            MeasureTheory.IntegrableOn (fun u => kaiMFConeWeight K γ u)
                (G ∩ {u | θ ≤ kaiMFLogNorm K u}) MeasureTheory.volume ∧
            (∫ u in G ∩ {u | θ ≤ kaiMFLogNorm K u}, kaiMFConeWeight K γ u)
              = -((Module.finrank ℚ K : ℂ) /
                    (∑ w : NumberField.InfinitePlace K, γ w)) *
                  Complex.exp ((∑ w : NumberField.InfinitePlace K, γ w) * (θ : ℂ) /
                    (Module.finrank ℚ K : ℂ)) * Xi G γ) ∧
        (∀ (γ : NumberField.InfinitePlace K → ℂ) (θ e : ℝ), 0 < e →
            ∀ f : (NumberField.InfinitePlace K → ℝ) → ℂ, Measurable f →
            (∀ u ∈ G ∩ {u | θ ≤ kaiMFLogNorm K u}, ‖f u‖ ≤ e⁻¹ *
                Real.exp (-(e * Real.exp (kaiMFLogNorm K u /
                  (Module.finrank ℚ K : ℝ))))) →
            MeasureTheory.IntegrableOn (fun u => f u * kaiMFConeWeight K γ u)
              (G ∩ {u | θ ≤ kaiMFLogNorm K u}) MeasureTheory.volume) ∧
        (∀ (f : (NumberField.InfinitePlace K → ℝ) → ℂ) (θ : ℝ),
            MeasureTheory.IntegrableOn f (G ∩ {u | kaiMFLogNorm K u ≤ θ})
              MeasureTheory.volume →
            MeasureTheory.IntegrableOn f (G ∩ {u | θ ≤ kaiMFLogNorm K u})
              MeasureTheory.volume →
            MeasureTheory.IntegrableOn f G MeasureTheory.volume ∧
            (∫ u in G, f u) = (∫ u in G ∩ {u | kaiMFLogNorm K u ≤ θ}, f u)
              + ∫ u in G ∩ {u | θ ≤ kaiMFLogNorm K u}, f u)) :=
by
  classical
  have hmsum : (∑ w : NumberField.InfinitePlace K, ((w.mult : ℕ) : ℝ))
      = (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have hLsum : ∀ u : NumberField.InfinitePlace K → ℝ,
      (∑ j : NumberField.InfinitePlace K, ((j.mult : ℕ) : ℝ) * u j) = kaiMFLogNorm K u :=
    fun _ => rfl
  have hmpos : ∀ w : NumberField.InfinitePlace K, (0:ℝ) < ((w.mult : ℕ) : ℝ) := by
    intro w; exact_mod_cast NumberField.InfinitePlace.mult_pos
  have hrank : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hnpos : (0:ℝ) < (Module.finrank ℚ K : ℝ) := by exact_mod_cast hrank
  have hnne : (Module.finrank ℚ K : ℝ) ≠ 0 := ne_of_gt hnpos
  have hnCne : (Module.finrank ℚ K : ℂ) ≠ 0 := by
    simpa using (Nat.cast_ne_zero (R := ℂ)).mpr hrank.ne'
  have hnC : ((Module.finrank ℚ K : ℂ)) = (((Module.finrank ℚ K : ℝ)) : ℂ) := by
    push_cast; ring
  haveI hne : Nonempty (NumberField.InfinitePlace K) := by
    rcases isEmpty_or_nonempty (NumberField.InfinitePlace K) with h | h
    · exfalso
      have h0 : (∑ w : NumberField.InfinitePlace K, ((w.mult : ℕ) : ℝ)) = 0 := by simp
      rw [hmsum] at h0; linarith
    · exact h
  have hLcont : Continuous (fun u : NumberField.InfinitePlace K → ℝ => kaiMFLogNorm K u) := by
    simp only [kaiMFLogNorm]
    exact continuous_finset_sum _ (fun w _ => continuous_const.mul (continuous_apply w))
  have hLmeas : Measurable (fun u : NumberField.InfinitePlace K → ℝ => kaiMFLogNorm K u) :=
    hLcont.measurable
  have hOmM : MeasurableSet {u : NumberField.InfinitePlace K → ℝ |
      0 ≤ kaiMFLogNorm K u ∧ kaiMFLogNorm K u ≤ 1} := by
    have h1 : {u : NumberField.InfinitePlace K → ℝ |
        0 ≤ kaiMFLogNorm K u ∧ kaiMFLogNorm K u ≤ 1}
        = {u : NumberField.InfinitePlace K → ℝ | 0 ≤ kaiMFLogNorm K u}
          ∩ {u : NumberField.InfinitePlace K → ℝ | kaiMFLogNorm K u ≤ 1} := rfl
    rw [h1]
    exact (measurableSet_le measurable_const hLmeas).inter
      (measurableSet_le hLmeas measurable_const)
  have hLshift : ∀ (u : NumberField.InfinitePlace K → ℝ) (ρ : ℝ),
      kaiMFLogNorm K (fun w => u w + ρ)
        = kaiMFLogNorm K u + ρ * (Module.finrank ℚ K : ℝ) := by
    intro u ρ
    have hterm : ∀ w : NumberField.InfinitePlace K,
        ((w.mult : ℕ) : ℝ) * (u w + ρ) = ((w.mult : ℕ) : ℝ) * u w + ((w.mult : ℕ) : ℝ) * ρ :=
      fun w => mul_add _ _ _
    simp only [kaiMFLogNorm, hterm, Finset.sum_add_distrib, ← Finset.sum_mul, hmsum]
    ring
  have hproj_inv : ∀ (u : NumberField.InfinitePlace K → ℝ) (ρ : ℝ)
      (w : NumberField.InfinitePlace K),
      (u w + ρ) - kaiMFLogNorm K (fun i => u i + ρ) / (Module.finrank ℚ K : ℝ)
        = u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) := by
    intro u ρ w
    rw [hLshift]
    field_simp
    ring
  have hfact : ∀ (γ : NumberField.InfinitePlace K → ℂ)
      (u : NumberField.InfinitePlace K → ℝ),
      kaiMFConeWeight K γ u
        = Complex.exp (∑ w : NumberField.InfinitePlace K,
            γ w * ((u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ))
          * Complex.exp ((∑ w : NumberField.InfinitePlace K, γ w)
              * ((kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ)) := by
    intro γ u
    have hterm : ∀ w : NumberField.InfinitePlace K,
        γ w * ((u w : ℝ) : ℂ)
          = γ w * ((u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ)
            + γ w * ((kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ) := by
      intro w; push_cast; ring
    simp only [kaiMFConeWeight, ← Complex.exp_add, hterm, Finset.sum_add_distrib,
      ← Finset.sum_mul]
  have hAmeas : ∀ AA : NumberField.InfinitePlace K → ℂ,
      Measurable (fun u : NumberField.InfinitePlace K → ℝ =>
        ∑ w : NumberField.InfinitePlace K,
          AA w * ((u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ)) := by
    intro AA
    refine Finset.measurable_sum _ (fun w _ => ?_)
    exact (Complex.continuous_ofReal.measurable.comp
      ((measurable_pi_apply w).sub (hLmeas.div_const _))).const_mul _
  have hchimeas : ∀ γ : NumberField.InfinitePlace K → ℂ,
      Measurable (fun u : NumberField.InfinitePlace K → ℝ =>
        Complex.exp (∑ w : NumberField.InfinitePlace K,
          γ w * ((u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ))) :=
    fun γ => Complex.continuous_exp.measurable.comp (hAmeas γ)
  have hWmeas : ∀ γ : NumberField.InfinitePlace K → ℂ,
      Measurable (fun u : NumberField.InfinitePlace K → ℝ => kaiMFConeWeight K γ u) := by
    intro γ
    simp only [kaiMFConeWeight]
    refine Complex.continuous_exp.measurable.comp ?_
    refine Finset.measurable_sum _ (fun w _ => ?_)
    exact (Complex.continuous_ofReal.measurable.comp (measurable_pi_apply w)).const_mul _
  have hchire : ∀ (γ : NumberField.InfinitePlace K → ℂ)
      (u : NumberField.InfinitePlace K → ℝ),
      ‖Complex.exp (∑ w : NumberField.InfinitePlace K,
          γ w * ((u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ))‖
        = Real.exp (∑ w : NumberField.InfinitePlace K,
            (γ w).re * (u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ))) := by
    intro γ u
    rw [Complex.norm_exp]
    congr 1
    rw [Complex.re_sum]
    exact Finset.sum_congr rfl (fun w _ => by simp [Complex.mul_re])
  have hchiinv : ∀ (γ : NumberField.InfinitePlace K → ℂ)
      (u : NumberField.InfinitePlace K → ℝ) (ρ : ℝ),
      Complex.exp (∑ w : NumberField.InfinitePlace K,
          γ w * (((fun i => u i + ρ) w -
            kaiMFLogNorm K (fun i => u i + ρ) / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ))
        = Complex.exp (∑ w : NumberField.InfinitePlace K,
            γ w * ((u w - kaiMFLogNorm K u / (Module.finrank ℚ K : ℝ) : ℝ) : ℂ)) := by
    intro γ u ρ
    congr 1
    exact Finset.sum_congr rfl (fun w _ => by rw [hproj_inv u ρ w])
  have hIciIoi : ∀ (g : ℝ → ℂ) (a : ℝ),
      MeasureTheory.IntegrableOn g (Set.Ioi a) MeasureTheory.volume →
      MeasureTheory.IntegrableOn g (Set.Ici a) MeasureTheory.volume := by
    intro g a hg
    have hsing : MeasureTheory.IntegrableOn g {a} MeasureTheory.volume := by
      show MeasureTheory.Integrable g (MeasureTheory.volume.restrict {a})
      rw [MeasureTheory.Measure.restrict_eq_zero.mpr (MeasureTheory.measure_singleton a)]
      exact MeasureTheory.integrable_zero_measure
    have hset : Set.Ici a = Set.Ioi a ∪ {a} := by
      ext t; simp only [Set.mem_Ici, Set.mem_Ioi, Set.mem_union, Set.mem_singleton_iff]
      constructor
      · intro h; rcases eq_or_lt_of_le h with h1 | h1
        · exact Or.inr h1.symm
        · exact Or.inl h1
      · rintro (h | h)
        · exact h.le
        · exact h.ge
    rw [hset]
    exact hg.union hsing
  
  obtain ⟨hs4a, hs4b, hs4c, hs4d, hs4e⟩ :=
    kai_reflected_slab_domain (ι := NumberField.InfinitePlace K)
      (fun w => ((w.mult : ℕ) : ℝ)) (Module.finrank ℚ K : ℝ) hmsum hnpos Lat hcount F hF hfd
      htrans c hslab x
  simp only [hLsum] at hs4d hs4e
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ w : NumberField.InfinitePlace K,
      |x w - kaiMFLogNorm K x / (Module.finrank ℚ K : ℝ)| := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by rw [hS]; exact Finset.sum_nonneg (fun w _ => abs_nonneg _)
  have hxS : ∀ w : NumberField.InfinitePlace K,
      |x w - kaiMFLogNorm K x / (Module.finrank ℚ K : ℝ)| ≤ S := by
    intro w; rw [hS]
    exact Finset.single_le_sum (f := fun w : NumberField.InfinitePlace K =>
      |x w - kaiMFLogNorm K x / (Module.finrank ℚ K : ℝ)|)
      (fun i _ => abs_nonneg _) (Finset.mem_univ w)
  obtain ⟨c₂, hc₂⟩ : ∃ c₂ : ℝ, c₂ = c + S + 1 := ⟨_, rfl⟩
  have hc₂1 : (1:ℝ) ≤ c₂ := by rw [hc₂]; linarith
  have hcc₂ : c ≤ c₂ := by rw [hc₂]; linarith
