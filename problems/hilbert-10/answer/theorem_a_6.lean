    have hdisj : ∀ i j : ℕ, i ≠ j → Disjoint (T i) (T j) := by
      intro i j hij
      rcases lt_or_gt_of_ne hij with h | h
      · exact hdisj_lt i j h
      · exact (hdisj_lt j i h).symm
    haveI hinv : (MeasureTheory.volume :
        MeasureTheory.Measure (NumberField.mixedEmbedding.mixedSpace K)).IsAddLeftInvariant := by
      show (MeasureTheory.volume : MeasureTheory.Measure
        (({w : NumberField.InfinitePlace K // w.IsReal} → ℝ) ×
          ({w : NumberField.InfinitePlace K // w.IsComplex} → ℂ))).IsAddLeftInvariant
      rw [MeasureTheory.Measure.volume_eq_prod]
      exact MeasureTheory.Measure.prod.instIsAddLeftInvariant
    have hTmeas : ∀ i : ℕ, MeasurableSet (T i) := by
      intro i
      rw [hTdef]
      exact hFmeas.preimage (measurable_const_add _)
    have hTvol : ∀ i : ℕ, MeasureTheory.volume (T i) = MeasureTheory.volume F := by
      intro i
      rw [hTdef]
      exact MeasureTheory.measure_preimage_add MeasureTheory.volume _ F
    have hTsub : ∀ i : ℕ, i < k →
        T i ⊆ Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) (3 * X) := by
      intro i hik y hy
      rw [hmemT] at hy
      have hyD : ((-(i:ℝ)) • u + y) ∈ D := ((hmemF _).mp hy).1
      have hn1 : ‖(-(i:ℝ)) • u + y‖ ≤ 2 * X := hDb _ hyD
      have hyeq : y = (i:ℝ) • u + ((-(i:ℝ)) • u + y) := by
        rw [← add_assoc, ← add_smul]
        simp
      have hiR : (i:ℝ) ≤ (k:ℝ) := by exact_mod_cast le_of_lt hik
      have hn2 : ‖(i:ℝ) • u‖ ≤ X := by
        rw [norm_smul, Real.norm_natCast]
        calc (i:ℝ) * ‖u‖ ≤ (i:ℝ) * lam := mul_le_mul_of_nonneg_left hu (Nat.cast_nonneg i)
          _ ≤ (k:ℝ) * lam := mul_le_mul_of_nonneg_right hiR hlam.le
          _ ≤ X := hklam
