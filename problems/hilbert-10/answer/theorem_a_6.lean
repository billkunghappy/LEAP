          - (∑ j, (∑ i, c i j * t i) * P₀ j)) * giE (∑ j, (∑ i, c i j * t i) * P₀ j) := by
      rw [← G1, ← G1, ← G1]; congr 1; ring
    linear_combination (F ((fun i => P₀ i + t i), fun _ => 0) *
      starRingEnd ℂ (F (P₀, fun _ => 0))) * key
  have hPz : ∀ z : Fin ν → ℤ, (fun i => p₀ i + ∑ l, ((z + y) l : ℝ) * p₁ l i) =
      fun i => ((p₀ i + ∑ l, (z l : ℝ) * p₁ l i) + t i) + (n i : ℝ) := by
    intro z; funext i
    simp only [Pi.add_apply, Int.cast_add, add_mul, Finset.sum_add_distrib]
    rw [hnt i]; ring
  refine ⟨μ, κ, K, hKb, hper, hfin, fun z => ?_⟩
  rw [h9 (z + y), h9 z, hid _ _ _ _ (hPz z)]
  congr 2
  have k1 := hμκ z
  have k2 := eS z
  linarith

theorem kai_v_complex_torus_fourier (b : ℕ) (K : (Fin b → ℝ) → ℂ) (R Lip η : ℝ)
    (hR : 0 < R) (hLip : 0 ≤ Lip) (hη : 0 < η) (hη1 : η ≤ 1)
    (hK : ∀ u, ‖K u‖ ≤ R)
    (hper : ∀ u (γ : Fin b → ℤ), K (fun i => u i + (γ i : ℝ)) = K u)
    (hlip : ∀ u v, ‖K u - K v‖ ≤ Lip * ∑ i, |u i - v i|) :
    ∃ (J : ℕ) (c : Fin J → ℂ) (m : Fin J → Fin b → ℤ),
      (J : ℝ) ≤ 4 * (20 * ((b : ℝ) + 1) ^ 2 * (Lip / R + 1) ^ 2 / η ^ 2) ^ b ∧
      (∀ j, ‖c j‖ ≤ R / 2) ∧
      ∀ u, ‖K u - ∑ j, c j * giE (∑ i, (m j i : ℝ) * u i)‖ ≤ 2 * R * η :=
by
  classical
  have hRne : R ≠ 0 := hR.ne'
  
  have hconj : ∀ t : ℝ, (starRingEnd ℂ) (giE t) = giE (-t) := by
    intro t
    unfold giE
    rw [← Complex.exp_conj]
    congr 1
    simp only [map_mul, map_ofNat, Complex.conj_ofReal, Complex.conj_I, Complex.ofReal_neg]
    ring
  
  have hre : ∀ (k : ℕ) (a : Fin k → ℂ) (ξ : Fin k → Fin b → ℤ), (∀ j, ‖a j‖ ≤ 1) →
      ∃ (c : Fin (k + k) → ℂ) (m : Fin (k + k) → Fin b → ℤ),
        (∀ j, ‖c j‖ ≤ 1 / 2) ∧
        ∀ u : Fin b → ℝ, (((∑ j, a j * giE (∑ i, (ξ j i : ℝ) * u i)).re : ℝ) : ℂ)
          = ∑ j, c j * giE (∑ i, (m j i : ℝ) * u i) := by
    intro k a ξ hA
    have h2 : ‖(2 : ℂ)‖ = 2 := by simp
    refine ⟨Fin.append (fun j => a j / 2) (fun j => starRingEnd ℂ (a j) / 2),
      Fin.append ξ (fun j i => -ξ j i), ?_, ?_⟩
    · intro j
      induction j using Fin.addCases with
      | left i =>
        rw [Fin.append_left, norm_div, h2]
        linarith [hA i]
      | right i =>
        rw [Fin.append_right, norm_div, Complex.norm_conj, h2]
        linarith [hA i]
    · intro u
      rw [Complex.re_eq_add_conj, Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right, map_sum, map_mul, hconj]
      rw [add_div, Finset.sum_div, Finset.sum_div]
      congr 1
      · refine Finset.sum_congr rfl (fun j _ => ?_)
        ring
      · refine Finset.sum_congr rfl (fun j _ => ?_)
        have hneg : -(∑ i, (ξ j i : ℝ) * u i) = ∑ i, ((-ξ j i : ℤ) : ℝ) * u i := by
          rw [← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          push_cast
          ring
        rw [hneg]
        ring
  
  have hcomb : ∀ (k₁ k₂ : ℕ) (c₁ : Fin k₁ → ℂ) (m₁ : Fin k₁ → Fin b → ℤ)
      (c₂ : Fin k₂ → ℂ) (m₂ : Fin k₂ → Fin b → ℤ) (α β : ℂ),
      ‖α‖ ≤ R → ‖β‖ ≤ R → (∀ j, ‖c₁ j‖ ≤ 1 / 2) → (∀ j, ‖c₂ j‖ ≤ 1 / 2) →
      ∃ (c : Fin (k₁ + k₂) → ℂ) (m : Fin (k₁ + k₂) → Fin b → ℤ),
        (∀ j, ‖c j‖ ≤ R / 2) ∧
        ∀ u : Fin b → ℝ, ∑ j, c j * giE (∑ i, (m j i : ℝ) * u i)
          = α * ∑ j, c₁ j * giE (∑ i, (m₁ j i : ℝ) * u i)
            + β * ∑ j, c₂ j * giE (∑ i, (m₂ j i : ℝ) * u i) := by
    intro k₁ k₂ c₁ m₁ c₂ m₂ α β hα hβ h₁ h₂
    refine ⟨Fin.append (fun j => α * c₁ j) (fun j => β * c₂ j), Fin.append m₁ m₂, ?_, ?_⟩
    · intro j
      induction j using Fin.addCases with
      | left i =>
        rw [Fin.append_left, norm_mul]
        calc ‖α‖ * ‖c₁ i‖ ≤ R * (1 / 2) := mul_le_mul hα (h₁ i) (norm_nonneg _) hR.le
          _ = R / 2 := by ring
      | right i =>
        rw [Fin.append_right, norm_mul]
        calc ‖β‖ * ‖c₂ i‖ ≤ R * (1 / 2) := mul_le_mul hβ (h₂ i) (norm_nonneg _) hR.le
          _ = R / 2 := by ring
    · intro u
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right, Finset.mul_sum, mul_assoc]
  
  have hQ : 0 ≤ Lip / R := div_nonneg hLip hR.le
  obtain ⟨k₁, ξ₁, a₁, hk₁, ha₁, happ₁⟩ :=
    kai_torus_fourier_approx b (fun u => (K u).re / R) (Lip / R) η hQ hη hη1
      (fun u => by
        show |(K u).re / R| ≤ 1
        rw [abs_div, abs_of_pos hR, div_le_one hR]
        exact (Complex.abs_re_le_norm _).trans (hK u))
      (fun u γ => by
        show (K (fun k => u k + (γ k : ℝ))).re / R = (K u).re / R
        rw [hper u γ])
      (fun u v => by
        show |(K u).re / R - (K v).re / R| ≤ Lip / R * ∑ k, |u k - v k|
        rw [← sub_div, abs_div, abs_of_pos hR, ← Complex.sub_re, div_le_iff₀ hR]
        calc |(K u - K v).re| ≤ ‖K u - K v‖ := Complex.abs_re_le_norm _
          _ ≤ Lip * ∑ k, |u k - v k| := hlip u v
          _ = (Lip / R * ∑ k, |u k - v k|) * R := by field_simp)
  obtain ⟨k₂, ξ₂, a₂, hk₂, ha₂, happ₂⟩ :=
    kai_torus_fourier_approx b (fun u => (K u).im / R) (Lip / R) η hQ hη hη1
      (fun u => by
        show |(K u).im / R| ≤ 1
        rw [abs_div, abs_of_pos hR, div_le_one hR]
        exact (Complex.abs_im_le_norm _).trans (hK u))
      (fun u γ => by
        show (K (fun k => u k + (γ k : ℝ))).im / R = (K u).im / R
        rw [hper u γ])
      (fun u v => by
        show |(K u).im / R - (K v).im / R| ≤ Lip / R * ∑ k, |u k - v k|
        rw [← sub_div, abs_div, abs_of_pos hR, ← Complex.sub_im, div_le_iff₀ hR]
        calc |(K u - K v).im| ≤ ‖K u - K v‖ := Complex.abs_im_le_norm _
          _ ≤ Lip * ∑ k, |u k - v k| := hlip u v
          _ = (Lip / R * ∑ k, |u k - v k|) * R := by field_simp)
  
  obtain ⟨c₁', m₁', hc₁', hid₁⟩ := hre k₁ a₁ ξ₁ ha₁
  obtain ⟨c₂', m₂', hc₂', hid₂⟩ := hre k₂ a₂ ξ₂ ha₂
  have hnR : ‖(R : ℂ)‖ = R := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR]
  have hnRI : ‖(R : ℂ) * Complex.I‖ = R := by
    rw [norm_mul, Complex.norm_I, mul_one, hnR]
  obtain ⟨c, m, hc, hid⟩ := hcomb _ _ c₁' m₁' c₂' m₂' (R : ℂ) ((R : ℂ) * Complex.I)
    hnR.le hnRI.le hc₁' hc₂'
  refine ⟨_, c, m, ?_, hc, ?_⟩
  · 
    push_cast
    linarith
  · 
    intro u
    have e1 : |(K u).re / R - (∑ j, a₁ j * giE (∑ i, (ξ₁ j i : ℝ) * u i)).re| ≤ η :=
      happ₁ u
    have e2 : |(K u).im / R - (∑ j, a₂ j * giE (∑ i, (ξ₂ j i : ℝ) * u i)).re| ≤ η :=
      happ₂ u
    rw [hid u, ← hid₁ u, ← hid₂ u]
    have hr : (K u).re = R * ((K u).re / R) := by field_simp
    have hi : (K u).im = R * ((K u).im / R) := by field_simp
    have hKu : K u = ((K u).re : ℂ) + ((K u).im : ℂ) * Complex.I := (Complex.re_add_im _).symm
    generalize (∑ j, a₁ j * giE (∑ i, (ξ₁ j i : ℝ) * u i)).re = x₁ at e1 ⊢
    generalize (∑ j, a₂ j * giE (∑ i, (ξ₂ j i : ℝ) * u i)).re = x₂ at e2 ⊢
    generalize (K u).re / R = f₁ at e1 hr
    generalize (K u).im / R = f₂ at e2 hi
    rw [hr, hi] at hKu
    have key : K u - ((R : ℂ) * (x₁ : ℂ) + (R : ℂ) * Complex.I * (x₂ : ℂ))
        = (R : ℂ) * ((f₁ - x₁ : ℝ) : ℂ) + (R : ℂ) * Complex.I * ((f₂ - x₂ : ℝ) : ℂ) := by
      rw [hKu]
      push_cast
      ring
    rw [key]
    calc ‖(R : ℂ) * ((f₁ - x₁ : ℝ) : ℂ) + (R : ℂ) * Complex.I * ((f₂ - x₂ : ℝ) : ℂ)‖
        ≤ ‖(R : ℂ) * ((f₁ - x₁ : ℝ) : ℂ)‖ + ‖(R : ℂ) * Complex.I * ((f₂ - x₂ : ℝ) : ℂ)‖ :=
          norm_add_le _ _
      _ = R * |f₁ - x₁| + R * |f₂ - x₂| := by
          rw [norm_mul, norm_mul, hnR, hnRI, Complex.norm_real, Complex.norm_real,
            Real.norm_eq_abs, Real.norm_eq_abs]
      _ ≤ R * η + R * η := by
          have := mul_le_mul_of_nonneg_left e1 hR.le
          have := mul_le_mul_of_nonneg_left e2 hR.le
          linarith
      _ = 2 * R * η := by ring

theorem kai_v_vdc_shift_square {α : Type*} [AddCommGroup α] (B D : Finset α)
    (hBD : ∀ x ∈ B, ∀ y ∈ B, y - x ∈ D) :
    (∀ F : α → ℝ, (∀ x, x ∉ B → F x = 0) → ∀ x ∈ B, ∑ h ∈ D, F (x + h) = ∑ y ∈ B, F y) ∧
    (∀ g : α → ℂ, (∀ x, x ∉ B → g x = 0) →
      (((‖∑ x ∈ B, g x‖ ^ 2 : ℝ)) : ℂ) = ∑ h ∈ D, ∑ x ∈ B, g (x + h) * starRingEnd ℂ (g x)) :=
by
  classical
  have key : ∀ {M : Type} [AddCommMonoid M] (F : α → M), (∀ x, x ∉ B → F x = 0) →
      ∀ x ∈ B, ∑ h ∈ D, F (x + h) = ∑ y ∈ B, F y := by
    intro M _ F hF x hx
    have hsub : B.image (fun y => y - x) ⊆ D := by
      intro h hh
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hh
      exact hBD x hx y hy
    rw [← Finset.sum_subset hsub ?_]
    · rw [Finset.sum_image (fun a _ b _ hab => sub_left_injective hab)]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      rw [add_sub_cancel]
    · intro h _ hnot
      apply hF
      intro hxB
      apply hnot
      exact Finset.mem_image.mpr ⟨x + h, hxB, add_sub_cancel_left x h⟩
  refine ⟨fun F hF x hx => key F hF x hx, ?_⟩
  intro g hg
  have hnorm : (((‖∑ x ∈ B, g x‖ ^ 2 : ℝ)) : ℂ)
      = (∑ y ∈ B, g y) * starRingEnd ℂ (∑ x ∈ B, g x) := by
    rw [Complex.mul_conj']
    push_cast
    ring
  rw [hnorm, map_sum, Finset.mul_sum]
  have hinner : ∀ x ∈ B, (∑ y ∈ B, g y) * starRingEnd ℂ (g x)
      = ∑ h ∈ D, g (x + h) * starRingEnd ℂ (g x) := by
    intro x hx
    rw [Finset.sum_mul]
    refine (key (fun y => g y * starRingEnd ℂ (g x)) ?_ x hx).symm
    intro y hy
    simp [hg y hy]
  rw [Finset.sum_congr rfl hinner]
  exact Finset.sum_comm

theorem kai_v_approx_phase_U2 {α : Type*} [AddCommGroup α] (B D : Finset α)
    (hBD : ∀ x ∈ B, ∀ y ∈ B, y - x ∈ D) (G : α → ℝ) (hG : ∀ x, x ∉ B → G x = 0)
    (Ψ : α → ℂ) (J : ℕ) (c : Fin J → ℂ) (Lf : Fin J → α → ℝ) (R δ : ℝ)
    (hc : ∀ j, ‖c j‖ ≤ R)
    (hL : ∀ j x h, Lf j (x + h) + Lf j 0 = Lf j x + Lf j h)
    (hΨ : ∀ x ∈ B, ‖Ψ x - ∑ j, c j * giE (Lf j x)‖ ≤ δ) :
    ‖∑ x ∈ B, (G x : ℂ) * Ψ x‖ ≤
      (J : ℝ) * R * Real.sqrt (Real.sqrt ((D.card : ℝ) *
          ∑ h ∈ D, (∑ x ∈ B, G (x + h) * G x) ^ 2))
        + δ * ∑ x ∈ B, |G x| :=
by
  classical
  
  have gmul : ∀ a b : ℝ, giE a * giE b = giE (a + b) := by
    intro a b; unfold giE; rw [← Complex.exp_add]; congr 1; push_cast; ring
  have gconj : ∀ t : ℝ, starRingEnd ℂ (giE t) = giE (-t) := by
    intro t; unfold giE; rw [← Complex.exp_conj]; congr 1
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat, Complex.ofReal_neg]
    ring
  have gnorm : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t
    have e : giE t = Complex.exp (((2 * Real.pi * t : ℝ) : ℂ) * Complex.I) := by
      unfold giE; congr 1; push_cast; ring
    rw [e, Complex.norm_exp_ofReal_mul_I]
  
  have shift : ∀ g : α → ℂ, (∀ x, x ∉ B → g x = 0) → ∀ x ∈ B,
      ∑ h ∈ D, g (x + h) = ∑ y ∈ B, g y := by
    intro g hg x hx
    have hinj : ∀ a ∈ D, ∀ b ∈ D, x + a = x + b → a = b :=
      fun a _ b _ hab => add_left_cancel hab
    have h1 : ∑ y ∈ D.image (fun h => x + h), g y = ∑ h ∈ D, g (x + h) :=
      Finset.sum_image hinj
    rw [← h1]
    symm
    apply Finset.sum_subset
    · intro y hy
      rw [Finset.mem_image]
      exact ⟨y - x, hBD x hx y hy, by abel⟩
    · intro y _ hy
      exact hg y hy
  
  have vdc : ∀ g : α → ℂ, (∀ x, x ∉ B → g x = 0) →
      (((‖∑ x ∈ B, g x‖ ^ 2 : ℝ)) : ℂ) =
        ∑ h ∈ D, ∑ x ∈ B, g (x + h) * starRingEnd ℂ (g x) := by
    intro g hg
    rw [Finset.sum_comm]
    have e : ∀ x ∈ B, ∑ h ∈ D, g (x + h) * starRingEnd ℂ (g x)
        = (∑ y ∈ B, g y) * starRingEnd ℂ (g x) := by
      intro x hx; rw [← Finset.sum_mul, shift g hg x hx]
    rw [Finset.sum_congr rfl e, ← Finset.mul_sum, ← map_sum, Complex.mul_conj,
      Complex.normSq_eq_norm_sq]
  
  have perphase : ∀ j, ‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ≤
      Real.sqrt (Real.sqrt ((D.card : ℝ) * ∑ h ∈ D, (∑ x ∈ B, G (x + h) * G x) ^ 2)) := by
    intro j
    have hg : ∀ x, x ∉ B → (G x : ℂ) * giE (Lf j x) = 0 := by
      intro x hx; rw [hG x hx]; simp
    have h1 := vdc (fun x => (G x : ℂ) * giE (Lf j x)) hg
    have hpair : ∀ h x, (G (x + h) : ℂ) * giE (Lf j (x + h)) *
        starRingEnd ℂ ((G x : ℂ) * giE (Lf j x))
        = giE (Lf j h - Lf j 0) * ((G (x + h) * G x : ℝ) : ℂ) := by
      intro h x
      rw [map_mul, Complex.conj_ofReal, gconj]
      have e : giE (Lf j (x + h)) * giE (-Lf j x) = giE (Lf j h - Lf j 0) := by
        rw [gmul]; congr 1; linarith [hL j x h]
      rw [← e]; push_cast; ring
    have h2 : (((‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2 : ℝ)) : ℂ)
        = ∑ h ∈ D, giE (Lf j h - Lf j 0) * (((∑ x ∈ B, G (x + h) * G x) : ℝ) : ℂ) := by
      refine h1.trans ?_
      refine Finset.sum_congr rfl (fun h _ => ?_)
      rw [Complex.ofReal_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      exact hpair h x
    have hsq : ‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2 ≤
        ∑ h ∈ D, |∑ x ∈ B, G (x + h) * G x| := by
      have e1 : ‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2
          = ‖(((‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2 : ℝ)) : ℂ)‖ :=
        (Complex.norm_of_nonneg (sq_nonneg _)).symm
      rw [e1, h2]
      refine (norm_sum_le _ _).trans (le_of_eq ?_)
      refine Finset.sum_congr rfl (fun h _ => ?_)
      rw [norm_mul, gnorm, one_mul, Complex.norm_real, Real.norm_eq_abs]
    have hcs : (∑ h ∈ D, |∑ x ∈ B, G (x + h) * G x|) ^ 2 ≤
        (D.card : ℝ) * ∑ h ∈ D, (∑ x ∈ B, G (x + h) * G x) ^ 2 := by
      have := sq_sum_le_card_mul_sum_sq (s := D) (f := fun h => |∑ x ∈ B, G (x + h) * G x|)
      simpa only [sq_abs] using this
    have h4 : (‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2) ^ 2 ≤
        (D.card : ℝ) * ∑ h ∈ D, (∑ x ∈ B, G (x + h) * G x) ^ 2 :=
      (pow_le_pow_left₀ (sq_nonneg _) hsq 2).trans hcs
    have h5 : ‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2 ≤
        Real.sqrt ((D.card : ℝ) * ∑ h ∈ D, (∑ x ∈ B, G (x + h) * G x) ^ 2) := by
      calc ‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2
          = Real.sqrt ((‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2) ^ 2) :=
            (Real.sqrt_sq (sq_nonneg _)).symm
        _ ≤ _ := Real.sqrt_le_sqrt h4
    calc ‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖
        = Real.sqrt (‖∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖ ^ 2) :=
          (Real.sqrt_sq (norm_nonneg _)).symm
      _ ≤ _ := Real.sqrt_le_sqrt h5
  
  have split : ∑ x ∈ B, (G x : ℂ) * Ψ x =
      ∑ j, c j * ∑ x ∈ B, (G x : ℂ) * giE (Lf j x)
        + ∑ x ∈ B, (G x : ℂ) * (Ψ x - ∑ j, c j * giE (Lf j x)) := by
    have e : ∑ j, c j * ∑ x ∈ B, (G x : ℂ) * giE (Lf j x)
        = ∑ x ∈ B, (G x : ℂ) * ∑ j, c j * giE (Lf j x) := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun x _ => Finset.sum_congr rfl (fun j _ => by ring))
    rw [e, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun x _ => by ring)
  rw [split]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · refine (norm_sum_le _ _).trans ?_
    calc ∑ j, ‖c j * ∑ x ∈ B, (G x : ℂ) * giE (Lf j x)‖
        ≤ ∑ j : Fin J, R * Real.sqrt (Real.sqrt ((D.card : ℝ) *
            ∑ h ∈ D, (∑ x ∈ B, G (x + h) * G x) ^ 2)) := by
          refine Finset.sum_le_sum (fun j _ => ?_)
          rw [norm_mul]
          exact mul_le_mul (hc j) (perphase j) (norm_nonneg _) ((norm_nonneg _).trans (hc j))
      _ = (J : ℝ) * R * Real.sqrt (Real.sqrt ((D.card : ℝ) *
            ∑ h ∈ D, (∑ x ∈ B, G (x + h) * G x) ^ 2)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]; ring
  · refine (norm_sum_le _ _).trans ?_
    calc ∑ x ∈ B, ‖(G x : ℂ) * (Ψ x - ∑ j, c j * giE (Lf j x))‖
        ≤ ∑ x ∈ B, |G x| * δ := by
          refine Finset.sum_le_sum (fun x hx => ?_)
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
          exact mul_le_mul_of_nonneg_left (hΨ x hx) (abs_nonneg _)
      _ = δ * ∑ x ∈ B, |G x| := by rw [← Finset.sum_mul, mul_comm]

theorem kai_v_gowers_box_sum_sq {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K))
    (f G : NumberField.RingOfIntegers K → ℝ) (M : ℝ) (hM : 0 ≤ M)
    (hG1 : ∀ x ∈ omegaBox ω M, G x = f x)
    (hG0 : ∀ x, x ∉ omegaBox ω M → G x = 0) :
    gowersU3Pow ω f M * ((omegaBox ω M).card : ℝ) ^ 4 =
      ∑ y ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)), ∑ h ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)),
        (∑ x ∈ omegaBox ω M, (G (x + h + y) * G (x + h)) * (G (x + y) * G x)) ^ 2 :=
by
  classical
  
  have hmem : ∀ (R : ℝ) (x : NumberField.RingOfIntegers K),
      x ∈ omegaBox ω R ↔ ∀ k, -(⌊R⌋₊ : ℤ) ≤ ω.equivFun x k ∧ ω.equivFun x k ≤ ⌊R⌋₊ := by
    intro R x
    unfold omegaBox
    rw [Finset.mem_image]
    constructor
    · rintro ⟨v, hv, rfl⟩
      simp only [intBox, Finset.mem_Icc, Pi.le_def] at hv
      intro k
      simp only [LinearEquiv.apply_symm_apply]
      exact ⟨hv.1 k, hv.2 k⟩
    · intro h
      refine ⟨ω.equivFun x, ?_, ω.equivFun.symm_apply_apply x⟩
      simp only [intBox, Finset.mem_Icc, Pi.le_def]
      exact ⟨fun k => (h k).1, fun k => (h k).2⟩
  have hfl : ⌊2 * (⌊M⌋₊ : ℝ)⌋₊ = 2 * ⌊M⌋₊ := by
    have : 2 * (⌊M⌋₊ : ℝ) = ((2 * ⌊M⌋₊ : ℕ) : ℝ) := by push_cast; ring
    rw [this, Nat.floor_natCast]
  have hNM : (⌊M⌋₊ : ℝ) ≤ M := Nat.floor_le hM
  have hfl2 : 2 * ⌊M⌋₊ ≤ ⌊2 * M⌋₊ := by
    apply Nat.le_floor; push_cast; linarith
  have hBD : ∀ x ∈ omegaBox ω M, ∀ y ∈ omegaBox ω M,
      y - x ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ)) := by
    intro x hx y hy
    rw [hmem] at hx hy ⊢
    rw [hfl]
    intro k
    have h1 := hx k
    have h2 := hy k
    simp only [map_sub, Pi.sub_apply]
    push_cast
    omega
  have hDB₂ : omegaBox ω (2 * (⌊M⌋₊ : ℝ)) ⊆ omegaBox ω (2 * M) := by
    intro x hx
    rw [hmem] at hx ⊢
    rw [hfl] at hx
    intro k
    have h1 := hx k
    have h3 : ((2 * ⌊M⌋₊ : ℕ) : ℤ) ≤ (⌊2 * M⌋₊ : ℤ) := by exact_mod_cast hfl2
    push_cast at h1 h3
    omega
  have hcardB : (0 : ℝ) < ((omegaBox ω M).card : ℝ) := by
    have h0 : (0 : NumberField.RingOfIntegers K) ∈ omegaBox ω M := by
      rw [hmem]; intro k; simp
    exact_mod_cast Finset.card_pos.mpr ⟨0, h0⟩
  
  obtain ⟨B, hB⟩ : ∃ B, B = omegaBox ω M := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D, D = omegaBox ω (2 * (⌊M⌋₊ : ℝ)) := ⟨_, rfl⟩
  obtain ⟨B₂, hB₂⟩ : ∃ B₂, B₂ = omegaBox ω (2 * M) := ⟨_, rfl⟩
  rw [← hB, ← hD] at hBD
  rw [← hD, ← hB₂] at hDB₂
  rw [← hB] at hcardB hG1 hG0
  rw [← hB, ← hD]
  have hBB₂ : ∀ x ∈ B, ∀ y ∈ B, y - x ∈ B₂ := fun x hx y hy => hDB₂ (hBD x hx y hy)
  
  have hshift : ∀ (S' : Finset (NumberField.RingOfIntegers K)),
      (∀ x ∈ B, ∀ y ∈ B, y - x ∈ S') →
      ∀ F : NumberField.RingOfIntegers K → ℝ, (∀ z, z ∉ B → F z = 0) →
      ∀ x ∈ B, ∑ k ∈ S', F (x + k) = ∑ z ∈ B, F z := by
    intro S' hS' F hF x hx
    rw [← Finset.sum_image (s := S') (g := fun h => x + h) (f := F)
      (fun a _ b _ hab => add_left_cancel hab)]
    symm
    apply Finset.sum_subset
    · intro y hy
      rw [Finset.mem_image]
      exact ⟨y - x, hS' x hx y hy, by abel⟩
    · intro y _ hy
      exact hF y hy
  obtain ⟨A, hA⟩ : ∃ A : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K →
      NumberField.RingOfIntegers K → ℝ,
      A = fun y h z => (G (z + h + y) * G (z + h)) * (G (z + y) * G z) := ⟨_, rfl⟩
  have hA0 : ∀ y h z, z ∉ B → A y h z = 0 := by
    intro y h z hz; rw [hA]; simp only [hG0 z hz, mul_zero]
  have hout : ∀ x ∈ B, ∀ k, k ∉ D → G (x + k) = 0 := by
    intro x hx k hk
    apply hG0
    intro hxk
    apply hk
    have h5 := hBD x hx (x + k) hxk
    rwa [add_sub_cancel_left] at h5
  obtain ⟨S, hS⟩ : ∃ S : NumberField.RingOfIntegers K → NumberField.RingOfIntegers K → ℝ,
      S = fun y h => ∑ x ∈ B, A y h x := ⟨_, rfl⟩
  have hSy : ∀ y h, y ∉ D → S y h = 0 := by
    intro y h hy
    simp only [hS]
    refine Finset.sum_eq_zero (fun x hx => ?_)
    simp only [hA, hout x hx y hy, mul_zero, zero_mul]
  have hSh : ∀ y h, h ∉ D → S y h = 0 := by
    intro y h hh
    simp only [hS]
    refine Finset.sum_eq_zero (fun x hx => ?_)
    simp only [hA, hout x hx h hh, mul_zero, zero_mul]
  
  have t_cube : ∀ F : (Fin 3 → Fin 2) → ℝ,
      ∏ ε : Fin 3 → Fin 2, F ε =
        F ![0, 0, 0] * F ![1, 0, 0] * F ![0, 1, 0] * F ![1, 1, 0]
          * F ![0, 0, 1] * F ![1, 0, 1] * F ![0, 1, 1] * F ![1, 1, 1] := by
    intro F
    let e : Fin 2 × Fin 2 × Fin 2 ≃ (Fin 3 → Fin 2) :=
      { toFun := fun p => ![p.1, p.2.1, p.2.2]
        invFun := fun ε => (ε 0, ε 1, ε 2)
        left_inv := fun p => by simp
        right_inv := fun ε => by funext i; fin_cases i <;> rfl }
    rw [← e.prod_comp]
    simp only [Fintype.prod_prod_type, Fin.prod_univ_two]
    simp only [e, Equiv.coe_fn_mk]
    simp only [mul_comm, mul_assoc, mul_left_comm]
  have hprod : ∀ x h₁ h₂ h₃ : NumberField.RingOfIntegers K,
      ∏ ε : Fin 3 → Fin 2, G (cubeVertex x h₁ h₂ h₃ ε) = A h₁ h₂ x * A h₁ h₂ (x + h₃) := by
    intro x h₁ h₂ h₃
    rw [t_cube (fun ε => G (cubeVertex x h₁ h₂ h₃ ε))]
    have hv : ∀ a b c : Fin 2, cubeVertex x h₁ h₂ h₃ ![a, b, c]
        = x + (a : ℕ) • h₁ + (b : ℕ) • h₂ + (c : ℕ) • h₃ := fun _ _ _ => rfl
    simp only [hv, Fin.val_zero, Fin.val_one, zero_smul, one_smul, add_zero, hA]
    rw [show x + h₃ + h₂ + h₁ = x + h₁ + h₂ + h₃ by abel,
      show x + h₃ + h₂ = x + h₂ + h₃ by abel,
      show x + h₃ + h₁ = x + h₁ + h₃ by abel,
      show x + h₂ + h₁ = x + h₁ + h₂ by abel]
    ring
  
  have hgow : gowersU3Pow ω f M * (B.card : ℝ) ^ 4 =
      ∑ x ∈ B, ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, ∑ h₃ ∈ B₂, A h₁ h₂ x * A h₁ h₂ (x + h₃) := by
    unfold gowersU3Pow
    rw [← hB, ← hB₂, div_mul_cancel₀ _ (pow_ne_zero 4 hcardB.ne')]
    refine Finset.sum_congr rfl (fun x _ => Finset.sum_congr rfl (fun h₁ _ =>
      Finset.sum_congr rfl (fun h₂ _ => Finset.sum_congr rfl (fun h₃ _ => ?_))))
    rw [← hprod]
    refine Finset.prod_congr rfl (fun ε _ => ?_)
    by_cases hv : cubeVertex x h₁ h₂ h₃ ε ∈ B
    · rw [if_pos hv]; exact (hG1 _ hv).symm
    · rw [if_neg hv, hG0 _ hv]
  have hstep2 : ∑ x ∈ B, ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, ∑ h₃ ∈ B₂, A h₁ h₂ x * A h₁ h₂ (x + h₃)
      = ∑ x ∈ B, ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, A h₁ h₂ x * S h₁ h₂ := by
    refine Finset.sum_congr rfl (fun x hx => Finset.sum_congr rfl (fun h₁ _ =>
      Finset.sum_congr rfl (fun h₂ _ => ?_)))
    rw [← Finset.mul_sum, hshift B₂ hBB₂ (A h₁ h₂) (hA0 h₁ h₂) x hx, hS]
  have hstep3 : ∑ x ∈ B, ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, A h₁ h₂ x * S h₁ h₂
      = ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, S h₁ h₂ ^ 2 := by
    calc _ = ∑ h₁ ∈ B₂, ∑ x ∈ B, ∑ h₂ ∈ B₂, A h₁ h₂ x * S h₁ h₂ := Finset.sum_comm
      _ = ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, ∑ x ∈ B, A h₁ h₂ x * S h₁ h₂ :=
          Finset.sum_congr rfl (fun h₁ _ => Finset.sum_comm)
      _ = _ := Finset.sum_congr rfl (fun h₁ _ => Finset.sum_congr rfl (fun h₂ _ => by
          rw [← Finset.sum_mul, sq, hS]))
  have hstep4 : ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, S h₁ h₂ ^ 2 = ∑ h₁ ∈ D, ∑ h₂ ∈ D, S h₁ h₂ ^ 2 := by
    symm
    calc ∑ h₁ ∈ D, ∑ h₂ ∈ D, S h₁ h₂ ^ 2 = ∑ h₁ ∈ D, ∑ h₂ ∈ B₂, S h₁ h₂ ^ 2 :=
          Finset.sum_congr rfl (fun h₁ _ => Finset.sum_subset hDB₂ (fun h₂ _ hh₂ => by
            rw [hSh h₁ h₂ hh₂]; ring))
      _ = ∑ h₁ ∈ B₂, ∑ h₂ ∈ B₂, S h₁ h₂ ^ 2 :=
          Finset.sum_subset hDB₂ (fun h₁ _ hh₁ => Finset.sum_eq_zero (fun h₂ _ => by
            rw [hSy h₁ h₂ hh₁]; ring))
  rw [hgow, hstep2, hstep3, hstep4]
  subst hS
  subst hA
  rfl

theorem kai_v_omegaBox_diff_facts {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ) (hM : 0 ≤ M) :
    (∀ x ∈ omegaBox ω M, ∀ y ∈ omegaBox ω M, y - x ∈ omegaBox ω (2 * (⌊M⌋₊ : ℝ))) ∧
    omegaBox ω (2 * (⌊M⌋₊ : ℝ)) ⊆ omegaBox ω (2 * M) ∧
    ((omegaBox ω (2 * (⌊M⌋₊ : ℝ))).card : ℝ) ≤ 2 ^ ν * ((omegaBox ω M).card : ℝ) ∧
    (0 : ℝ) < ((omegaBox ω M).card : ℝ) :=
by
  classical
  have hcard : ∀ M' : ℝ, (omegaBox ω M').card = (2 * ⌊M'⌋₊ + 1) ^ ν := by
    intro M'
    unfold omegaBox
    rw [Finset.card_image_of_injective _ ω.equivFun.symm.injective]
    unfold intBox
    rw [Pi.card_Icc]
    simp only [Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    congr 1
    omega
  have hfloor2 : ⌊(2 : ℝ) * (⌊M⌋₊ : ℝ)⌋₊ = 2 * ⌊M⌋₊ := by
    rw [show (2 : ℝ) * (⌊M⌋₊ : ℝ) = ((2 * ⌊M⌋₊ : ℕ) : ℝ) by push_cast; ring, Nat.floor_natCast]
  have h2M : 2 * ⌊M⌋₊ ≤ ⌊2 * M⌋₊ := by
    apply Nat.le_floor
    push_cast
    linarith [Nat.floor_le hM]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro x hx y hy
    unfold omegaBox at hx hy ⊢
    rw [hfloor2]
    rw [Finset.mem_image] at hx hy ⊢
    obtain ⟨vx, hvx, rfl⟩ := hx
    obtain ⟨vy, hvy, rfl⟩ := hy
    refine ⟨vy - vx, ?_, by simp [map_sub]⟩
    unfold intBox at hvx hvy ⊢
    rw [Finset.mem_Icc] at hvx hvy ⊢
    obtain ⟨hx1, hx2⟩ := hvx
    obtain ⟨hy1, hy2⟩ := hvy
    constructor
    · intro i
      have a1 : -((⌊M⌋₊ : ℕ) : ℤ) ≤ vy i := hy1 i
      have a2 : vx i ≤ ((⌊M⌋₊ : ℕ) : ℤ) := hx2 i
      show -(((2 * ⌊M⌋₊ : ℕ)) : ℤ) ≤ vy i - vx i
      push_cast
      linarith
    · intro i
      have a1 : -((⌊M⌋₊ : ℕ) : ℤ) ≤ vx i := hx1 i
      have a2 : vy i ≤ ((⌊M⌋₊ : ℕ) : ℤ) := hy2 i
      show vy i - vx i ≤ (((2 * ⌊M⌋₊ : ℕ)) : ℤ)
      push_cast
      linarith
  · intro z hz
    unfold omegaBox at hz ⊢
    rw [hfloor2] at hz
    rw [Finset.mem_image] at hz ⊢
    obtain ⟨v, hv, rfl⟩ := hz
    refine ⟨v, ?_, rfl⟩
    unfold intBox at hv ⊢
    rw [Finset.mem_Icc] at hv ⊢
    obtain ⟨h1, h2⟩ := hv
    have h2M' : ((2 * ⌊M⌋₊ : ℕ) : ℤ) ≤ ((⌊2 * M⌋₊ : ℕ) : ℤ) := by exact_mod_cast h2M
    constructor
    · intro i
      have a : -(((2 * ⌊M⌋₊ : ℕ)) : ℤ) ≤ v i := h1 i
      show -((⌊2 * M⌋₊ : ℕ) : ℤ) ≤ v i
      linarith
    · intro i
      have a : v i ≤ (((2 * ⌊M⌋₊ : ℕ)) : ℤ) := h2 i
      show v i ≤ ((⌊2 * M⌋₊ : ℕ) : ℤ)
      linarith
  · rw [hcard, hcard, hfloor2]
    have hnat : (2 * (2 * ⌊M⌋₊) + 1) ^ ν ≤ 2 ^ ν * (2 * ⌊M⌋₊ + 1) ^ ν := by
      rw [← mul_pow]
      exact Nat.pow_le_pow_left (by omega) ν
    exact_mod_cast hnat
  · rw [hcard]
    positivity

theorem kai_v_converse_numeric (n a : ℕ) (D Q ε M : ℝ) (hD : 1 ≤ D) (hQ : 2 ≤ Q)
    (hε : 0 < ε) (hε1 : ε ≤ 1) (hM : 3 ≤ M) (ha : (a : ℝ) ≤ D) :
    Q ≤ Real.exp ((D + Real.log Q + Real.log (1 / ε) + Real.log (Real.log M)) ^ (2 * n + 52)) ∧
    Real.sqrt (2 ^ n * Q ^ 2 / 2 * (4 * (20 * ((a : ℝ) + 1) ^ 2 *
        (8 * D ^ 2 * Q ^ 4 / Q ^ 2 + 1) ^ 2 / (ε ^ 2 / (2 * Q ^ 2)) ^ 2) ^ a)) ≤
      Real.exp ((D + Real.log Q + Real.log (1 / ε) + Real.log (Real.log M)) ^ (2 * n + 52)) :=
by
  have hQpos : 0 < Q := by linarith
  have hεinv : 0 < 1 / ε := by positivity
  have hlog2 := Real.log_two_gt_d9
  have hq2 : Real.log 2 ≤ Real.log Q := Real.log_le_log (by norm_num) hQ
  have hl : 0 ≤ Real.log (1 / ε) := Real.log_nonneg (by rw [le_div_iff₀ hε]; linarith)
  have hlogM : 1 ≤ Real.log M := by
    rw [Real.le_log_iff_exp_le (by linarith)]
    have := Real.exp_one_lt_d9
    linarith
  have hlam : 0 ≤ Real.log (Real.log M) := Real.log_nonneg hlogM
  have hexpQ : Real.exp (Real.log Q) = Q := Real.exp_log hQpos
  have hexpE : Real.exp (Real.log (1 / ε)) = 1 / ε := Real.exp_log hεinv
  obtain ⟨q, hq_def⟩ : ∃ q, q = Real.log Q := ⟨_, rfl⟩
  obtain ⟨l, hl_def⟩ : ∃ l, l = Real.log (1 / ε) := ⟨_, rfl⟩
  obtain ⟨lam, hlam_def⟩ : ∃ lam, lam = Real.log (Real.log M) := ⟨_, rfl⟩
  rw [← hq_def, ← hl_def, ← hlam_def]
  rw [← hq_def] at hq2 hexpQ
  rw [← hl_def] at hl hexpE
  rw [← hlam_def] at hlam
  have hq : (1 : ℝ) / 2 ≤ q := by linarith
  obtain ⟨Y, hY_def⟩ : ∃ Y, Y = D + q + l := ⟨_, rfl⟩
  rw [← hY_def]
  obtain ⟨X, hX_def⟩ : ∃ X, X = Y + lam := ⟨_, rfl⟩
  rw [← hX_def]
  have hY1 : 1 ≤ Y := by linarith
  have hYX : Y ≤ X := by linarith
  have hX : 3 / 2 ≤ X := by linarith
  have hX1 : 1 ≤ X := by linarith
  have hXN0 : 0 ≤ X ^ (2 * n + 52) := by positivity
  have hXXN : X ≤ X ^ (2 * n + 52) := le_self_pow₀ hX1 (by omega)
  have h2e : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
  refine ⟨?_, ?_⟩
  · rw [← hexpQ]
    exact Real.exp_le_exp.2 (by linarith)
  
  have hpoly : (n : ℝ) + 1 + 2 * X + 23 * X ^ 2 ≤ X ^ (2 * n + 52) := by
    have hX2 : (1 : ℝ) + 5 / 4 ≤ X ^ 2 := by nlinarith
    have hb : 1 + (n : ℝ) * (5 / 4) ≤ (1 + 5 / 4) ^ n := one_add_mul_le_pow (by norm_num) n
    have hb2 : ((1 : ℝ) + 5 / 4) ^ n ≤ (X ^ 2) ^ n := pow_le_pow_left₀ (by norm_num) hX2 n
    have h50 : ((3 : ℝ) / 2) ^ 50 ≤ X ^ 50 := pow_le_pow_left₀ (by norm_num) hX 50
    have h50' : (26 : ℝ) ≤ (3 / 2) ^ 50 := by norm_num
    have hsplit : X ^ (2 * n + 52) = (X ^ 2) ^ n * X ^ 50 * X ^ 2 := by
      rw [← pow_mul, ← pow_add, ← pow_add]
    rw [hsplit]
    obtain ⟨A, hA_def⟩ : ∃ A, A = (X ^ 2) ^ n := ⟨_, rfl⟩
    rw [← hA_def] at hb2 ⊢
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have hA : (n : ℝ) + 1 ≤ A := by linarith
    have hX2' : 1 ≤ X ^ 2 := by linarith
    have h1 : ((n : ℝ) + 1) * 26 ≤ A * X ^ 50 :=
      mul_le_mul hA (by linarith) (by norm_num) (by linarith)
    have h2 : ((n : ℝ) + 1) * 26 * X ^ 2 ≤ A * X ^ 50 * X ^ 2 :=
      mul_le_mul_of_nonneg_right h1 (by positivity)
    have h3 : (n : ℝ) ≤ n * X ^ 2 := le_mul_of_one_le_right hn0 hX2'
    have h4 : X ≤ X ^ 2 := by nlinarith
    have h5 : 0 ≤ (n : ℝ) * X ^ 2 := by positivity
    have h6 : ((n : ℝ) + 1) * 26 * X ^ 2 = 26 * ((n : ℝ) * X ^ 2) + 26 * X ^ 2 := by ring
    linarith
  
  have hZeq : 20 * ((a : ℝ) + 1) ^ 2 * (8 * D ^ 2 * Q ^ 4 / Q ^ 2 + 1) ^ 2 / (ε ^ 2 / (2 * Q ^ 2)) ^ 2
      = 80 * ((a : ℝ) + 1) ^ 2 * (8 * D ^ 2 * Q ^ 2 + 1) ^ 2 * Q ^ 4 * (1 / ε) ^ 4 := by
    field_simp
    ring
  have hZ0 : 0 ≤ 80 * ((a : ℝ) + 1) ^ 2 * (8 * D ^ 2 * Q ^ 2 + 1) ^ 2 * Q ^ 4 * (1 / ε) ^ 4 := by
    positivity
  have ha1 : ((a : ℝ) + 1) ^ 2 ≤ 4 * D ^ 2 := by
    have : (a : ℝ) + 1 ≤ 2 * D := by linarith
    nlinarith [Nat.cast_nonneg (α := ℝ) a]
  have hDQ : 1 ≤ D ^ 2 * Q ^ 2 := by
    have h1 : 1 ≤ D ^ 2 := by nlinarith
    have h2 : 1 ≤ Q ^ 2 := by nlinarith
    nlinarith
  have hDQ2 : (8 * D ^ 2 * Q ^ 2 + 1) ^ 2 ≤ 81 * D ^ 4 * Q ^ 4 := by
    have : 8 * D ^ 2 * Q ^ 2 + 1 ≤ 9 * (D ^ 2 * Q ^ 2) := by linarith
    have h0 : 0 ≤ 8 * D ^ 2 * Q ^ 2 + 1 := by positivity
    calc (8 * D ^ 2 * Q ^ 2 + 1) ^ 2 ≤ (9 * (D ^ 2 * Q ^ 2)) ^ 2 := pow_le_pow_left₀ h0 this 2
      _ = 81 * D ^ 4 * Q ^ 4 := by ring
  have hZle1 : 80 * ((a : ℝ) + 1) ^ 2 * (8 * D ^ 2 * Q ^ 2 + 1) ^ 2 * Q ^ 4 * (1 / ε) ^ 4
      ≤ 25920 * D ^ 6 * Q ^ 8 * (1 / ε) ^ 4 := by
    calc 80 * ((a : ℝ) + 1) ^ 2 * (8 * D ^ 2 * Q ^ 2 + 1) ^ 2 * Q ^ 4 * (1 / ε) ^ 4
        ≤ 80 * (4 * D ^ 2) * (81 * D ^ 4 * Q ^ 4) * Q ^ 4 * (1 / ε) ^ 4 := by gcongr
      _ = 25920 * D ^ 6 * Q ^ 8 * (1 / ε) ^ 4 := by ring
