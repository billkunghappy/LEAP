        have hne : e - b ≠ 0 := by omega
        rw [zero_pow hne]
        ring
      · intro h; exact absurd (Finset.mem_range.mpr (Nat.lt_succ_self e)) h
  
  have hpp : ∀ (P : Ideal (NumberField.RingOfIntegers K)) (e : ℕ), Prime P →
      0 ≤ (S (P ^ e)).re := by
    intro P e hP
    have hP0 : P ≠ 0 := hP.ne_zero
    obtain ⟨xz, hxz, hxzv⟩ : ∃ z : ℤ, ((z : ℂ) = lam₁ P) ∧ (z = 1 ∨ z = -1 ∨ z = 0) := by
      rcases hval₁ P hP0 with h | h | h
      · exact ⟨1, by simp [h], Or.inl rfl⟩
      · exact ⟨-1, by simp [h], Or.inr (Or.inl rfl)⟩
      · exact ⟨0, by simp [h], Or.inr (Or.inr rfl)⟩
    obtain ⟨yz, hyz, hyzv⟩ : ∃ z : ℤ, ((z : ℂ) = lam₂ P) ∧ (z = 1 ∨ z = -1 ∨ z = 0) := by
      rcases hval₂ P hP0 with h | h | h
      · exact ⟨1, by simp [h], Or.inl rfl⟩
      · exact ⟨-1, by simp [h], Or.inr (Or.inl rfl)⟩
      · exact ⟨0, by simp [h], Or.inr (Or.inr rfl)⟩
    rw [hprime P hP e, ← hxz, ← hyz]
    have hcast : (∑ k ∈ Finset.range (e + 1),
          (∑ i ∈ Finset.range (k + 1), ((xz : ℂ)) ^ i) * ((yz : ℂ)) ^ (e - k) *
            (∑ i ∈ Finset.range (e - k + 1), ((xz : ℂ)) ^ i))
        = (((∑ k ∈ Finset.range (e + 1),
              (∑ i ∈ Finset.range (k + 1), xz ^ i) * yz ^ (e - k) *
                (∑ i ∈ Finset.range (e - k + 1), xz ^ i)) : ℤ) : ℂ) := by
      push_cast
      ring
    rw [hcast, Complex.intCast_re]
    exact_mod_cast hlocal xz yz hxzv hyzv e
  
  have hnn : ∀ M : Ideal (NumberField.RingOfIntegers K),
      0 ≤ (if M = 0 then (0 : ℝ) else (S M).re) := by
    intro M
    refine UniqueFactorizationMonoid.induction_on_coprime M ?_ ?_ ?_ ?_
    · simp
    · intro x hx
      rw [Ideal.isUnit_iff, ← Ideal.one_eq_top] at hx
      subst hx
      rw [if_neg hone0, hvalone]
      norm_num
    · intro p i hp
      have hp0 : p ^ i ≠ 0 := pow_ne_zero i hp.ne_zero
      rw [if_neg hp0]
      exact hpp p i hp
    · intro a b hab ha hb
      by_cases ha0 : a = 0
      · subst ha0; simp
      by_cases hb0 : b = 0
      · subst hb0; simp
      have hab0 : a * b ≠ 0 := mul_ne_zero ha0 hb0
      rw [if_neg hab0]
      rw [if_neg ha0] at ha
      rw [if_neg hb0] at hb
      have hre : (S a * S b).re = (S a).re * (S b).re := by
        rw [Complex.mul_re, hkey a ha0, hkey b hb0]; ring
      rw [hconv a b ha0 hb0 hab, hre]
      exact mul_nonneg ha hb
  refine ⟨fun M => if M = 0 then (0 : ℝ) else (S M).re, hnn, ?_, ?_⟩
  · show (if (1 : Ideal (NumberField.RingOfIntegers K)) = 0 then (0 : ℝ) else (S 1).re) = 1
    rw [if_neg hone0, hvalone]
    norm_num
  · intro I hI
    show (((if I = 0 then (0 : ℝ) else (S I).re) : ℝ) : ℂ) = _
    rw [if_neg hI, hreal I hI, hS]

theorem kai_ideal_dirichlet_conv_series (K : Type u) [Field K] [NumberField K]
    (f₁ f₂ f₃ : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (aa : Ideal (NumberField.RingOfIntegers K) → ℝ)
    (hf₁ : ∀ I, ‖f₁ I‖ ≤ 1) (hf₂ : ∀ I, ‖f₂ I‖ ≤ 1) (hf₃ : ∀ I, ‖f₃ I‖ ≤ 1)
    (haa : ∀ I, 0 ≤ aa I)
    (hzeta : ∀ σ : ℝ, 1 < σ →
      Summable (fun I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} =>
        ((Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers K)) : ℝ)) ^ (-σ)))
    (hconv : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
        ((aa I : ℂ) =
