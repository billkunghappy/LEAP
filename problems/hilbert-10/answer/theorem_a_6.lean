      nlinarith [mul_le_mul_of_nonneg_right h hNpos.le, mul_le_mul_of_nonneg_left hN1 hNpos.le]
    · intro l l'
      beta_reduce
      have h := abs_sub_round (p₂ l l')
      rw [Nat.cast_one, one_mul, le_div_iff₀ (by positivity)]
      nlinarith [mul_le_mul_of_nonneg_right h (sq_nonneg (N : ℝ))]
    · intro z
      beta_reduce
      unfold kaiQuadPoly
