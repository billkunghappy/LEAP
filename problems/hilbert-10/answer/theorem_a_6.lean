      exact hP ⟨hm0, hβeq ▸ hβ'⟩

theorem kai_class_char_match_unique (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (Λ : Fin (NumberField.classNumber K) → (Ideal (NumberField.RingOfIntegers K) → ℂ))
    (hΛext : ∀ j, KaiHeckeExt K q 0 0 ξ η (Λ j))
    (hΛpr : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → Submodule.IsPrincipal I →
      ∑ j, Λ j I = (NumberField.classNumber K : ℂ) * kaiHeckeTwist K q 0 0 ξ η (kaiGen I))
    (hΛnp : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → ¬ Submodule.IsPrincipal I →
      ∑ j, Λ j I = 0)
    (𝔮D : Ideal (NumberField.RingOfIntegers K)) (h𝔮D : 𝔮D ≠ ⊥)
    (ξD : ((NumberField.RingOfIntegers K ⧸ 𝔮D)ˣ) →* Circle)
    (ηD : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (lamD : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hD : KaiHeckeExt K 𝔮D 0 0 ξD ηD lamD)
    (hDreal : ∀ I : Ideal (NumberField.RingOfIntegers K), lamD I = (starRingEnd ℂ) (lamD I))
    (hmatch : ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
      IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
      kaiHeckeTwist K q 0 0 ξ η y = lamD (Ideal.span {y})) :
    ∃ j₀, (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → I ⊔ 𝔮D = ⊤ →
        Λ j₀ I = lamD I) ∧
      ∀ j, (∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → I ⊔ 𝔮D = ⊤ →
        Λ j I = lamD I) → j = j₀ :=
by
  classical
  
  have s1 : ∀ (q₁ : Ideal (NumberField.RingOfIntegers K)), q₁ ≠ 0 →
      ∀ c : ClassGroup (NumberField.RingOfIntegers K),
      ∃ I : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))),
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧ ClassGroup.mk0 I = c := by
    intro q hq c
    by_cases hqtop : q = ⊤
    · obtain ⟨I, hI⟩ := ClassGroup.mk0_surjective c
      exact ⟨I, by rw [hqtop]; exact sup_top_eq _, hI⟩
    obtain ⟨⟨a, ha⟩, hA₀⟩ := ClassGroup.mk0_surjective c⁻¹
    have ha0 : a ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp ha
    have F : {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        v.asIdeal ∣ q}.Finite :=
      Ideal.finite_factors hq
    set S : Finset (Ideal (NumberField.RingOfIntegers K)) :=
      Finset.image (fun v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) =>
        v.asIdeal) F.toFinset with hSdef
    have hSmax : ∀ p ∈ S, p.IsMaximal ∧ p ≠ ⊥ := by
      intro p hp
      rw [hSdef, Finset.mem_image] at hp
      obtain ⟨v, -, rfl⟩ := hp
      exact ⟨Ideal.IsPrime.isMaximal v.isPrime v.ne_bot, v.ne_bot⟩
    have hScov : ∀ m : Ideal (NumberField.RingOfIntegers K), m.IsMaximal → q ≤ m → m ∈ S := by
      intro m hm hqm
      have hm0 : m ≠ ⊥ := by
        intro h
        apply hq
        rw [Ideal.zero_eq_bot]
        exact le_bot_iff.mp (h ▸ hqm)
      have hv : (⟨m, hm.isPrime, hm0⟩ :
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) ∈ F.toFinset := by
        rw [Set.Finite.mem_toFinset]
        exact Ideal.dvd_iff_le.mpr hqm
      rw [hSdef, Finset.mem_image]
      exact ⟨_, hv, rfl⟩
    have hwit : ∀ p ∈ S, ∃ z : NumberField.RingOfIntegers K,
        z ∈ a ∧ (∀ r ∈ S, r ≠ p → z ∈ a * r) ∧ z ∉ a * p := by
      intro p hpS
      obtain ⟨hpmax, hp0⟩ := hSmax p hpS
      have hprime : Prime p := Ideal.prime_of_isPrime hp0 hpmax.isPrime
      have hnle : ¬ ((a * ∏ r ∈ S.erase p, r) ≤ a * p) := by
        intro hle
        have hdvd : a * p ∣ a * ∏ r ∈ S.erase p, r := Ideal.dvd_iff_le.mpr hle
        have hpd : p ∣ ∏ r ∈ S.erase p, r := (mul_dvd_mul_iff_left ha0).mp hdvd
        obtain ⟨r, hr, hpr⟩ := hprime.exists_mem_finset_dvd hpd
        have hrle : r ≤ p := Ideal.le_of_dvd hpr
        have hrS : r ∈ S := (Finset.mem_erase.mp hr).2
        have hrmax : r.IsMaximal := (hSmax r hrS).1
        exact (Finset.mem_erase.mp hr).1 (hrmax.eq_of_le hpmax.ne_top hrle)
      obtain ⟨z, hz1, hz2⟩ := SetLike.not_le_iff_exists.mp hnle
      refine ⟨z, Ideal.mul_le_right hz1, ?_, hz2⟩
      intro r hrS hrp
      have hrmem : r ∈ S.erase p := Finset.mem_erase.mpr ⟨hrp, hrS⟩
      have hdvd : r ∣ ∏ t ∈ S.erase p, t := Finset.dvd_prod_of_mem (fun t => t) hrmem
      exact Ideal.le_of_dvd (mul_dvd_mul_left a hdvd) hz1
    choose! z hz1 hz2 hz3 using hwit
    set α : NumberField.RingOfIntegers K := ∑ p ∈ S, z p with hαdef
    have hαa : α ∈ a := Submodule.sum_mem a (fun p hp => hz1 p hp)
    have hαout : ∀ p ∈ S, α ∉ a * p := by
      intro p hpS hmem
      have hsplit : z p + ∑ r ∈ S.erase p, z r = α := Finset.add_sum_erase S z hpS
      have hT : (∑ r ∈ S.erase p, z r) ∈ a * p := by
        refine Submodule.sum_mem _ ?_
        intro r hr
        exact hz2 r (Finset.mem_erase.mp hr).2 p hpS (Ne.symm (Finset.mem_erase.mp hr).1)
      have hzp : z p ∈ a * p := by
        have hsub := Submodule.sub_mem (a * p) hmem hT
        rwa [← hsplit, add_sub_cancel_right] at hsub
      exact hz3 p hpS hzp
    obtain ⟨m, hmmax, hqm⟩ := Ideal.exists_le_maximal q hqtop
    have hmS : m ∈ S := hScov m hmmax hqm
    have hα0 : α ≠ 0 := by
      intro h
      apply hαout m hmS
      rw [h]
      exact Submodule.zero_mem _
    have hspan_le : Ideal.span {α} ≤ a := (Ideal.span_singleton_le_iff_mem a).mpr hαa
    obtain ⟨b, hb⟩ := Ideal.dvd_iff_le.mpr hspan_le
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hb
      exact hα0 (Ideal.span_singleton_eq_bot.mp (by rw [hb, Ideal.zero_eq_bot]))
    have hbnz : b ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      mem_nonZeroDivisors_iff_ne_zero.mpr hb0
    have hbq : b ⊔ q = ⊤ := by
      by_contra hne
      obtain ⟨m', hm'max, hm'le⟩ := Ideal.exists_le_maximal (b ⊔ q) hne
      have hbm : b ≤ m' := le_sup_left.trans hm'le
      have hqm' : q ≤ m' := le_sup_right.trans hm'le
      apply hαout m' (hScov m' hm'max hqm')
      have hle : a * b ≤ a * m' := Ideal.mul_mono (le_refl a) hbm
      exact hle (by rw [← hb]; exact Ideal.mem_span_singleton_self α)
    have hmul : ((⟨a, ha⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) *
        ⟨b, hbnz⟩) = ⟨a * b, Submonoid.mul_mem _ ha hbnz⟩ := rfl
    have h1 : ClassGroup.mk0
          (⟨a, ha⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))))
        * ClassGroup.mk0
          (⟨b, hbnz⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) = 1 := by
      rw [← map_mul, hmul, ClassGroup.mk0_eq_one_iff]
      exact ⟨⟨α, hb.symm⟩⟩
    rw [hA₀] at h1
    exact ⟨⟨b, hbnz⟩, hbq, by rw [eq_inv_of_mul_eq_one_right h1, inv_inv]⟩
  
  have h𝔮D0 : 𝔮D ≠ 0 := by rw [Ne, Ideal.zero_eq_bot]; exact h𝔮D
  have hqD0 : q * 𝔮D ≠ 0 := mul_ne_zero hq h𝔮D0
  have hnz : ∀ I : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))),
      (I : Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
    fun I => mem_nonZeroDivisors_iff_ne_zero.mp I.2
  have hcopmul : ∀ I J P : Ideal (NumberField.RingOfIntegers K), I ⊔ P = ⊤ → J ⊔ P = ⊤ →
      (I * J) ⊔ P = ⊤ := by
    intro I J P hI hJ
    exact Ideal.isCoprime_iff_sup_eq.mp
      (IsCoprime.mul_left (Ideal.isCoprime_iff_sup_eq.mpr hI) (Ideal.isCoprime_iff_sup_eq.mpr hJ))
  
  have sqD : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ 𝔮D = ⊤ →
      lamD I * lamD I = 1 := by
    intro I hI0 hID
    have hn := hD.2.2.1 I hI0 hID
    calc lamD I * lamD I = lamD I * (starRingEnd ℂ) (lamD I) := by rw [← hDreal I]
      _ = ((Complex.normSq (lamD I) : ℝ) : ℂ) := Complex.mul_conj _
      _ = 1 := by rw [Complex.normSq_eq_norm_sq, hn]; norm_num
  
  have hgen : ∀ I : Ideal (NumberField.RingOfIntegers K), Submodule.IsPrincipal I →
      I = Ideal.span {kaiGen I} := by
    intro I hI
    have h : ∃ a : NumberField.RingOfIntegers K, I = Ideal.span {a} :=
      ⟨_, (Ideal.span_singleton_generator I).symm⟩
    unfold kaiGen
    rw [dif_pos h]
    exact h.choose_spec
  have hprinc : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → I ⊔ 𝔮D = ⊤ →
      Submodule.IsPrincipal I →
      kaiHeckeTwist K q 0 0 ξ η (kaiGen I) = lamD I ∧ ∀ j, Λ j I = lamD I := by
    intro I hI0 hIq hID hP
    obtain ⟨g, hg⟩ : ∃ g, kaiGen I = g := ⟨_, rfl⟩
    have hIg : I = Ideal.span {g} := hg ▸ hgen I hP
    rw [hg]
    subst hIg
    have hg0 : g ≠ 0 := by
      intro h; apply hI0; rw [h, Ideal.zero_eq_bot]; exact Ideal.span_singleton_eq_bot.mpr rfl
    have htw : kaiHeckeTwist K q 0 0 ξ η g = lamD (Ideal.span {g}) :=
      hmatch g hg0 (Ideal.isCoprime_iff_sup_eq.mpr hIq) (Ideal.isCoprime_iff_sup_eq.mpr hID)
    refine ⟨htw, fun j => ?_⟩
    rw [← htw]
    exact (hΛext j).2.2.2.2.2 g hg0
  have hsum_pr : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → I ⊔ 𝔮D = ⊤ →
      Submodule.IsPrincipal I →
      ∑ j, Λ j I * lamD I = (NumberField.classNumber K : ℂ) := by
    intro I hI0 hIq hID hP
    rw [← Finset.sum_mul, hΛpr I hI0 hP, (hprinc I hI0 hIq hID hP).1, mul_assoc,
      sqD I hI0 hID, mul_one]
  have hsum_np : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
      ¬ Submodule.IsPrincipal I → ∑ j, Λ j I * lamD I = 0 := by
    intro I hI0 hP
    rw [← Finset.sum_mul, hΛnp I hI0 hP, zero_mul]
  have hμmul : ∀ j (I J : Ideal (NumberField.RingOfIntegers K)),
      Λ j (I * J) * lamD (I * J) = (Λ j I * lamD I) * (Λ j J * lamD J) := by
    intro j I J
    rw [(hΛext j).2.1 I J, hD.2.1 I J]; ring
  have hμne : ∀ j (I : Ideal (NumberField.RingOfIntegers K)), I ≠ 0 → I ⊔ q = ⊤ →
      I ⊔ 𝔮D = ⊤ → Λ j I * lamD I ≠ 0 := by
    intro j I hI0 hIq hID h
    have hn : ‖Λ j I * lamD I‖ = 1 := by
      rw [norm_mul, (hΛext j).2.2.1 I hI0 hIq, hD.2.2.1 I hI0 hID, mul_one]
    rw [h, norm_zero] at hn
    exact zero_ne_one hn
  
  have hrep : ∀ c : ClassGroup (NumberField.RingOfIntegers K),
      ∃ I : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))),
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ 𝔮D = ⊤ ∧ ClassGroup.mk0 I = c := by
    intro c
    obtain ⟨I, hI, hc⟩ := s1 (q * 𝔮D) hqD0 c
    exact ⟨I, eq_top_mono (sup_le_sup_left Ideal.mul_le_right _) hI,
      eq_top_mono (sup_le_sup_left Ideal.mul_le_left _) hI, hc⟩
  choose rep hrepq hrepD hrepc using hrep
  
  have hinv : ∀ j (I J : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ →
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ 𝔮D = ⊤ →
      (J : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ →
      (J : Ideal (NumberField.RingOfIntegers K)) ⊔ 𝔮D = ⊤ →
      ClassGroup.mk0 I = ClassGroup.mk0 J →
      Λ j (I : Ideal (NumberField.RingOfIntegers K)) * lamD (I : Ideal (NumberField.RingOfIntegers K))
        = Λ j (J : Ideal (NumberField.RingOfIntegers K)) *
            lamD (J : Ideal (NumberField.RingOfIntegers K)) := by
    intro j I J hIq hID hJq hJD hIJ
    have h1 : ClassGroup.mk0 (I * rep (ClassGroup.mk0 J)⁻¹) = 1 := by
      rw [map_mul, hrepc, hIJ, mul_inv_cancel]
    have h2 : ClassGroup.mk0 (J * rep (ClassGroup.mk0 J)⁻¹) = 1 := by
      rw [map_mul, hrepc, mul_inv_cancel]
    have hP1 := (ClassGroup.mk0_eq_one_iff (I * rep (ClassGroup.mk0 J)⁻¹).2).mp h1
    have hP2 := (ClassGroup.mk0_eq_one_iff (J * rep (ClassGroup.mk0 J)⁻¹).2).mp h2
    have e1 := hμmul j (I : Ideal (NumberField.RingOfIntegers K))
      (rep (ClassGroup.mk0 J)⁻¹ : Ideal (NumberField.RingOfIntegers K))
    have e2 := hμmul j (J : Ideal (NumberField.RingOfIntegers K))
      (rep (ClassGroup.mk0 J)⁻¹ : Ideal (NumberField.RingOfIntegers K))
    have p1 := (hprinc _ (hnz (I * rep (ClassGroup.mk0 J)⁻¹))
      (hcopmul _ _ _ hIq (hrepq _)) (hcopmul _ _ _ hID (hrepD _)) hP1).2 j
    have p2 := (hprinc _ (hnz (J * rep (ClassGroup.mk0 J)⁻¹))
      (hcopmul _ _ _ hJq (hrepq _)) (hcopmul _ _ _ hJD (hrepD _)) hP2).2 j
    have q1 := sqD _ (hnz (I * rep (ClassGroup.mk0 J)⁻¹)) (hcopmul _ _ _ hID (hrepD _))
    have q2 := sqD _ (hnz (J * rep (ClassGroup.mk0 J)⁻¹)) (hcopmul _ _ _ hJD (hrepD _))
    simp only [Submonoid.coe_mul] at p1 p2 q1 q2
    have hne := hμne j _ (hnz (rep (ClassGroup.mk0 J)⁻¹)) (hrepq _) (hrepD _)
    apply mul_right_cancel₀ hne
    rw [← e1, ← e2, p1, p2, q1, q2]
  
  obtain ⟨ν, hν⟩ : ∃ ν : Fin (NumberField.classNumber K) →
      ClassGroup (NumberField.RingOfIntegers K) → ℂ,
      ν = fun j c => Λ j (rep c : Ideal (NumberField.RingOfIntegers K)) *
        lamD (rep c : Ideal (NumberField.RingOfIntegers K)) := ⟨_, rfl⟩
  have hνmul : ∀ j a b, ν j (a * b) = ν j a * ν j b := by
    intro j a b
    rw [hν]
    have hcl : ClassGroup.mk0 (rep (a * b)) = ClassGroup.mk0 (rep a * rep b) := by
      rw [map_mul, hrepc, hrepc, hrepc]
    have := hinv j (rep (a * b)) (rep a * rep b) (hrepq _) (hrepD _)
      (hcopmul _ _ _ (hrepq a) (hrepq b)) (hcopmul _ _ _ (hrepD a) (hrepD b)) hcl
    simp only [Submonoid.coe_mul] at this
    show Λ j (rep (a * b) : Ideal (NumberField.RingOfIntegers K)) *
        lamD (rep (a * b) : Ideal (NumberField.RingOfIntegers K)) =
      (Λ j (rep a : Ideal (NumberField.RingOfIntegers K)) *
        lamD (rep a : Ideal (NumberField.RingOfIntegers K))) *
      (Λ j (rep b : Ideal (NumberField.RingOfIntegers K)) *
        lamD (rep b : Ideal (NumberField.RingOfIntegers K)))
    rw [this, hμmul]
  have hνsum1 : ∑ j, ν j 1 = (NumberField.classNumber K : ℂ) := by
    rw [hν]
    have hP := (ClassGroup.mk0_eq_one_iff (rep 1).2).mp (hrepc 1)
    exact hsum_pr _ (hnz _) (hrepq _) (hrepD _) hP
  have hνsum : ∀ c, c ≠ 1 → ∑ j, ν j c = 0 := by
    intro c hc
    rw [hν]
    have hP : ¬ Submodule.IsPrincipal (rep c : Ideal (NumberField.RingOfIntegers K)) := by
      intro hP
      apply hc
      rw [← hrepc c]
      exact (ClassGroup.mk0_eq_one_iff (rep c).2).mpr hP
    exact hsum_np _ (hnz _) hP
  
  have hcardG : Fintype.card (ClassGroup (NumberField.RingOfIntegers K))
      = NumberField.classNumber K := rfl
  have hS : ∀ j, ∑ c, ν j c =
      if (∀ c, ν j c = 1) then (NumberField.classNumber K : ℂ) else 0 := by
    intro j
    split_ifs with hj
    · rw [Finset.sum_congr rfl (fun c _ => hj c), Finset.sum_const, Finset.card_univ,
        nsmul_eq_mul, mul_one, hcardG]
    · push_neg at hj
      obtain ⟨c₀, hc₀⟩ := hj
      have e1 : ∑ c, ν j c = ν j c₀ * ∑ c, ν j c := by
        calc ∑ c, ν j c = ∑ c, ν j (c₀ * c) :=
              (Equiv.sum_comp (Equiv.mulLeft c₀) (ν j)).symm
          _ = ∑ c, ν j c₀ * ν j c := Finset.sum_congr rfl (fun c _ => hνmul j c₀ c)
          _ = ν j c₀ * ∑ c, ν j c := by rw [Finset.mul_sum]
      have e2 : (1 - ν j c₀) * ∑ c, ν j c = 0 := by
        rw [sub_mul, one_mul, ← e1, sub_self]
      exact (mul_eq_zero.mp e2).resolve_left (sub_ne_zero.mpr (Ne.symm hc₀))
  have hdouble : ∑ j, ∑ c, ν j c = (NumberField.classNumber K : ℂ) := by
    rw [Finset.sum_comm, Finset.sum_eq_single (1 : ClassGroup (NumberField.RingOfIntegers K))]
    · exact hνsum1
    · intro c _ hc; exact hνsum c hc
    · intro h; exact absurd (Finset.mem_univ _) h
  have hdouble' : ∑ j, (if (∀ c, ν j c = 1) then (NumberField.classNumber K : ℂ) else 0)
      = (NumberField.classNumber K : ℂ) := by
    exact (Finset.sum_congr rfl (fun j _ => (hS j).symm)).trans hdouble
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, nsmul_eq_mul]
    at hdouble'
  have hhpos : 0 < NumberField.classNumber K := by
    rw [← hcardG]; exact Fintype.card_pos
  have hh0 : (NumberField.classNumber K : ℂ) ≠ 0 := by exact_mod_cast hhpos.ne'
  have hcardT : (Finset.univ.filter (fun j => ∀ c, ν j c = 1)).card = 1 := by
    have h1 : ((Finset.univ.filter (fun j => ∀ c, ν j c = 1)).card : ℂ) = 1 := by
      apply mul_right_cancel₀ hh0
      rw [hdouble', one_mul]
    exact_mod_cast h1
  obtain ⟨j₀, hj₀⟩ := Finset.card_eq_one.mp hcardT
  have hTmem : ∀ j, j ∈ Finset.univ.filter (fun j => ∀ c, ν j c = 1) ↔ j = j₀ := by
    intro j; rw [hj₀, Finset.mem_singleton]
  have hj₀triv : ∀ c, ν j₀ c = 1 := by
    have := (hTmem j₀).mpr rfl
    exact (Finset.mem_filter.mp this).2
  refine ⟨j₀, ?_, ?_⟩
  · intro I hI0 hIq hID
    have hInz : I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      mem_nonZeroDivisors_iff_ne_zero.mpr hI0
    have h1 := hj₀triv (ClassGroup.mk0 ⟨I, hInz⟩)
    rw [hν] at h1
    simp only at h1
    rw [hinv j₀ _ ⟨I, hInz⟩ (hrepq _) (hrepD _) hIq hID (hrepc _)] at h1
    calc Λ j₀ I = Λ j₀ I * (lamD I * lamD I) := by rw [sqD I hI0 hID, mul_one]
      _ = (Λ j₀ I * lamD I) * lamD I := by ring
      _ = lamD I := by rw [h1, one_mul]
  · intro j hj
    apply (hTmem j).mp
    rw [Finset.mem_filter]
    refine ⟨Finset.mem_univ _, fun c => ?_⟩
    rw [hν]
    simp only
    rw [hj _ (hnz _) (hrepq c) (hrepD c), sqD _ (hnz _) (hrepD c)]

theorem kai_hecke_principal_of_trivial_off (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (𝔮D q : Ideal (NumberField.RingOfIntegers K)) (h𝔮D : 𝔮D ≠ ⊥) (hq : q ≠ 0)
    (ξD : ((NumberField.RingOfIntegers K ⧸ 𝔮D)ˣ) →* Circle)
    (ηD : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (lamD : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hD : KaiHeckeExt K 𝔮D 0 0 ξD ηD lamD)
    (htriv : ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 → I ⊔ q = ⊤ → I ⊔ 𝔮D = ⊤ →
      lamD I = 1) :
    KaiHeckePrincipal K 𝔮D lamD :=
by
  classical
  
  have s1 : ∀ (q₁ : Ideal (NumberField.RingOfIntegers K)), q₁ ≠ 0 →
      ∀ c : ClassGroup (NumberField.RingOfIntegers K),
      ∃ I : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))),
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧ ClassGroup.mk0 I = c := by
    intro q hq c
    by_cases hqtop : q = ⊤
    · obtain ⟨I, hI⟩ := ClassGroup.mk0_surjective c
      exact ⟨I, by rw [hqtop]; exact sup_top_eq _, hI⟩
    obtain ⟨⟨a, ha⟩, hA₀⟩ := ClassGroup.mk0_surjective c⁻¹
    have ha0 : a ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp ha
    have F : {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        v.asIdeal ∣ q}.Finite :=
      Ideal.finite_factors hq
    set S : Finset (Ideal (NumberField.RingOfIntegers K)) :=
      Finset.image (fun v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) =>
        v.asIdeal) F.toFinset with hSdef
    have hSmax : ∀ p ∈ S, p.IsMaximal ∧ p ≠ ⊥ := by
      intro p hp
      rw [hSdef, Finset.mem_image] at hp
      obtain ⟨v, -, rfl⟩ := hp
      exact ⟨Ideal.IsPrime.isMaximal v.isPrime v.ne_bot, v.ne_bot⟩
    have hScov : ∀ m : Ideal (NumberField.RingOfIntegers K), m.IsMaximal → q ≤ m → m ∈ S := by
      intro m hm hqm
      have hm0 : m ≠ ⊥ := by
        intro h
        apply hq
        rw [Ideal.zero_eq_bot]
        exact le_bot_iff.mp (h ▸ hqm)
      have hv : (⟨m, hm.isPrime, hm0⟩ :
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) ∈ F.toFinset := by
        rw [Set.Finite.mem_toFinset]
        exact Ideal.dvd_iff_le.mpr hqm
      rw [hSdef, Finset.mem_image]
      exact ⟨_, hv, rfl⟩
    have hwit : ∀ p ∈ S, ∃ z : NumberField.RingOfIntegers K,
        z ∈ a ∧ (∀ r ∈ S, r ≠ p → z ∈ a * r) ∧ z ∉ a * p := by
      intro p hpS
      obtain ⟨hpmax, hp0⟩ := hSmax p hpS
      have hprime : Prime p := Ideal.prime_of_isPrime hp0 hpmax.isPrime
      have hnle : ¬ ((a * ∏ r ∈ S.erase p, r) ≤ a * p) := by
        intro hle
        have hdvd : a * p ∣ a * ∏ r ∈ S.erase p, r := Ideal.dvd_iff_le.mpr hle
        have hpd : p ∣ ∏ r ∈ S.erase p, r := (mul_dvd_mul_iff_left ha0).mp hdvd
        obtain ⟨r, hr, hpr⟩ := hprime.exists_mem_finset_dvd hpd
        have hrle : r ≤ p := Ideal.le_of_dvd hpr
        have hrS : r ∈ S := (Finset.mem_erase.mp hr).2
        have hrmax : r.IsMaximal := (hSmax r hrS).1
        exact (Finset.mem_erase.mp hr).1 (hrmax.eq_of_le hpmax.ne_top hrle)
      obtain ⟨z, hz1, hz2⟩ := SetLike.not_le_iff_exists.mp hnle
      refine ⟨z, Ideal.mul_le_right hz1, ?_, hz2⟩
      intro r hrS hrp
      have hrmem : r ∈ S.erase p := Finset.mem_erase.mpr ⟨hrp, hrS⟩
      have hdvd : r ∣ ∏ t ∈ S.erase p, t := Finset.dvd_prod_of_mem (fun t => t) hrmem
      exact Ideal.le_of_dvd (mul_dvd_mul_left a hdvd) hz1
    choose! z hz1 hz2 hz3 using hwit
    set α : NumberField.RingOfIntegers K := ∑ p ∈ S, z p with hαdef
    have hαa : α ∈ a := Submodule.sum_mem a (fun p hp => hz1 p hp)
    have hαout : ∀ p ∈ S, α ∉ a * p := by
      intro p hpS hmem
      have hsplit : z p + ∑ r ∈ S.erase p, z r = α := Finset.add_sum_erase S z hpS
      have hT : (∑ r ∈ S.erase p, z r) ∈ a * p := by
        refine Submodule.sum_mem _ ?_
        intro r hr
        exact hz2 r (Finset.mem_erase.mp hr).2 p hpS (Ne.symm (Finset.mem_erase.mp hr).1)
      have hzp : z p ∈ a * p := by
        have hsub := Submodule.sub_mem (a * p) hmem hT
        rwa [← hsplit, add_sub_cancel_right] at hsub
      exact hz3 p hpS hzp
    obtain ⟨m, hmmax, hqm⟩ := Ideal.exists_le_maximal q hqtop
    have hmS : m ∈ S := hScov m hmmax hqm
    have hα0 : α ≠ 0 := by
      intro h
      apply hαout m hmS
      rw [h]
      exact Submodule.zero_mem _
    have hspan_le : Ideal.span {α} ≤ a := (Ideal.span_singleton_le_iff_mem a).mpr hαa
    obtain ⟨b, hb⟩ := Ideal.dvd_iff_le.mpr hspan_le
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hb
      exact hα0 (Ideal.span_singleton_eq_bot.mp (by rw [hb, Ideal.zero_eq_bot]))
    have hbnz : b ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      mem_nonZeroDivisors_iff_ne_zero.mpr hb0
    have hbq : b ⊔ q = ⊤ := by
      by_contra hne
      obtain ⟨m', hm'max, hm'le⟩ := Ideal.exists_le_maximal (b ⊔ q) hne
      have hbm : b ≤ m' := le_sup_left.trans hm'le
      have hqm' : q ≤ m' := le_sup_right.trans hm'le
      apply hαout m' (hScov m' hm'max hqm')
      have hle : a * b ≤ a * m' := Ideal.mul_mono (le_refl a) hbm
      exact hle (by rw [← hb]; exact Ideal.mem_span_singleton_self α)
    have hmul : ((⟨a, ha⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) *
        ⟨b, hbnz⟩) = ⟨a * b, Submonoid.mul_mem _ ha hbnz⟩ := rfl
    have h1 : ClassGroup.mk0
          (⟨a, ha⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))))
        * ClassGroup.mk0
          (⟨b, hbnz⟩ : ↥(nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))) = 1 := by
      rw [← map_mul, hmul, ClassGroup.mk0_eq_one_iff]
      exact ⟨⟨α, hb.symm⟩⟩
    rw [hA₀] at h1
    exact ⟨⟨b, hbnz⟩, hbq, by rw [eq_inv_of_mul_eq_one_right h1, inv_inv]⟩
  
  have s2 : ∀ y y' : NumberField.RingOfIntegers K, y - y' ∈ 𝔮D →
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        0 < (NumberField.mixedEmbedding K (y : K)).1 w *
          (NumberField.mixedEmbedding K (y' : K)).1 w) →
      kaiHeckeTwist K 𝔮D 0 0 ξD ηD y = kaiHeckeTwist K 𝔮D 0 0 ξD ηD y' := by
    intro y y' hyy hsign
    have hm : Ideal.Quotient.mk 𝔮D y = Ideal.Quotient.mk 𝔮D y' := Ideal.Quotient.eq.mpr hyy
    have hprod : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if ηD w then ((Real.sign ((NumberField.mixedEmbedding K ((y : K))).1 w) : ℝ) : ℂ)
          else 1)
        = ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          if ηD w then ((Real.sign ((NumberField.mixedEmbedding K ((y' : K))).1 w) : ℝ) : ℂ)
          else 1 := by
      refine Finset.prod_congr rfl (fun w _ => ?_)
      have hs : Real.sign ((NumberField.mixedEmbedding K ((y : K))).1 w)
          = Real.sign ((NumberField.mixedEmbedding K ((y' : K))).1 w) := by
        rcases pos_and_pos_or_neg_and_neg_of_mul_pos (hsign w) with ⟨h1, h2⟩ | ⟨h1, h2⟩
        · rw [Real.sign_of_pos h1, Real.sign_of_pos h2]
        · rw [Real.sign_of_neg h1, Real.sign_of_neg h2]
      rw [hs]
    unfold kaiHeckeTwist
    by_cases hx : IsUnit (Ideal.Quotient.mk 𝔮D y)
    · have hx' : IsUnit (Ideal.Quotient.mk 𝔮D y') := hm ▸ hx
      have hu : hx.unit = hx'.unit := Units.ext (by simp [hm])
      rw [dif_pos hx, dif_pos hx', hu, hprod]
      simp
    · have hx' : ¬ IsUnit (Ideal.Quotient.mk 𝔮D y') := hm ▸ hx
      rw [dif_neg hx, dif_neg hx']
  
  have s3 : ∀ γ : NumberField.RingOfIntegers K, Ideal.span {γ} ⊔ 𝔮D = ⊤ →
      ∃ γ'' : NumberField.RingOfIntegers K, γ'' - γ ∈ 𝔮D ∧ Ideal.span {γ''} ⊔ q = ⊤ := by
    intro γ hγ
    have F : {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        v.asIdeal ∣ q}.Finite := Ideal.finite_factors hq
    obtain ⟨S, hSdef⟩ : ∃ S : Finset (IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K)), S = F.toFinset.filter (fun v => ¬ 𝔮D ≤ v.asIdeal) :=
      ⟨_, rfl⟩
    have hcop : IsCoprime (∏ v ∈ S, v.asIdeal) 𝔮D := by
      apply IsCoprime.prod_left
      intro v hv
      have hvS : ¬ 𝔮D ≤ v.asIdeal := by
        rw [hSdef] at hv
        exact (Finset.mem_filter.mp hv).2
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra hne
      have hmax : v.asIdeal.IsMaximal := v.isMaximal
      have heq : v.asIdeal = v.asIdeal ⊔ 𝔮D := hmax.eq_of_le hne le_sup_left
      apply hvS
      rw [heq]
      exact le_sup_right
    obtain ⟨v₀, hv₀, u, hu, hvu⟩ := Ideal.isCoprime_iff_exists.mp hcop
    refine ⟨γ * v₀ + u, ?_, ?_⟩
    · have he : γ * v₀ + u - γ = u * (1 - γ) := by linear_combination γ * hvu
      rw [he]
      exact Ideal.mul_mem_right _ _ hu
    · by_contra hne
      obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
      have hγM : γ * v₀ + u ∈ M := hle (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
      have hqM : q ≤ M := le_sup_right.trans hle
      by_cases hDM : 𝔮D ≤ M
      · have hγ' : γ ∈ M := by
          have h1 : γ * v₀ + u - γ ∈ M := by
            have he : γ * v₀ + u - γ = u * (1 - γ) := by linear_combination γ * hvu
            rw [he]
            exact hDM (Ideal.mul_mem_right _ _ hu)
