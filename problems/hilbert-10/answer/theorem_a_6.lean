theorem box_fejer_approx (b R : ℕ) (hR : 1 ≤ R) (Q : ℝ) (hQ : 0 ≤ Q) (f : (Fin b → ℝ) → ℝ) (hper : ∀ (w : Fin b → ℝ) (n : Fin b → ℤ), f (w + fun k => (n k : ℝ)) = f w) (hlip : ∀ w w' : Fin b → ℝ, |f w - f w'| ≤ Q * ∑ k, |w k - w' k|) (x : Fin b → ℝ) (P : (Fin b → ℝ) → ℂ) (hP : Continuous P) (hK1 : ∫ w in Set.Icc (0 : Fin b → ℝ) 1, ‖P w‖ ^ 2 = (R : ℝ) ^ b) (hK2 : ∀ k : Fin b, ∫ w in Set.Icc (0 : Fin b → ℝ) 1, Real.sin (Real.pi * (x k - w k)) ^ 2 * ‖P w‖ ^ 2 = (R : ℝ) ^ b / (2 * R)) : |f x - (∫ w in Set.Icc (0 : Fin b → ℝ) 1, f w * ‖P w‖ ^ 2) / (R : ℝ) ^ b| ≤ Q * b / Real.sqrt R :=
by
  have hRpos : (0 : ℝ) < R := by exact_mod_cast (show 0 < R by omega)
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = Real.sqrt R := ⟨_, rfl⟩
  rw [← ha_def]
  have ha : 0 < a := by rw [ha_def]; exact Real.sqrt_pos.2 hRpos
  have haa : a * a = R := by rw [ha_def]; exact Real.mul_self_sqrt hRpos.le
  
  have s1 : ∀ t : ℝ, |t - ((round t : ℤ) : ℝ)| ≤ (a * Real.sin (Real.pi * t) ^ 2 + 1 / a) / 4 := by
    intro t
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = t - ((round t : ℤ) : ℝ) := ⟨_, rfl⟩
    rw [← hs]
    have hs2 : |s| ≤ 1 / 2 := by rw [hs]; exact abs_sub_round t
    have hsin : Real.sin (Real.pi * t) ^ 2 = Real.sin (Real.pi * s) ^ 2 := by
      have e : Real.pi * t = Real.pi * s + ((round t : ℤ) : ℝ) * Real.pi := by rw [hs]; ring
      rw [e, Real.sin_add_int_mul_pi, mul_pow, ← sq_abs ((-1 : ℝ) ^ (round t)), abs_neg_one_zpow,
        one_pow, one_mul]
    have hjor : 2 * |s| ≤ |Real.sin (Real.pi * s)| := by
      have hpi := Real.pi_pos
      rcases le_or_gt 0 s with h0 | h0
      · have h1 : s ≤ 1 / 2 := (le_abs_self s).trans hs2
        have h2 := Real.mul_le_sin (x := Real.pi * s) (by positivity) (by nlinarith)
        have h3 : 2 / Real.pi * (Real.pi * s) = 2 * s := by field_simp
        rw [h3] at h2
        rw [abs_of_nonneg h0, abs_of_nonneg (by linarith)]
        exact h2
      · have h1 : -s ≤ 1 / 2 := (neg_le_abs s).trans hs2
        have h2 := Real.mul_le_sin (x := Real.pi * (-s)) (by nlinarith) (by nlinarith)
        have h3 : 2 / Real.pi * (Real.pi * (-s)) = 2 * (-s) := by field_simp
        rw [h3, mul_neg Real.pi s, Real.sin_neg] at h2
        rw [abs_of_neg h0, abs_of_neg (by linarith)]
        linarith
    obtain ⟨v, hv⟩ : ∃ v : ℝ, v = |Real.sin (Real.pi * s)| := ⟨_, rfl⟩
    have hv2 : Real.sin (Real.pi * s) ^ 2 = v ^ 2 := by rw [hv, sq_abs]
    rw [hsin, hv2]
    rw [← hv] at hjor
    have hamgm : 0 ≤ a * v ^ 2 + 1 / a - 2 * v := by
      have e : a * v ^ 2 + 1 / a - 2 * v = (a * v - 1) ^ 2 / a := by
        field_simp
        ring
      rw [e]
      positivity
    linarith
  
  have hfc : Continuous f := by
    have hL : LipschitzWith (Real.toNNReal (Q * b)) f := by
      apply LipschitzWith.of_dist_le_mul
      intro w w'
      rw [Real.coe_toNNReal _ (mul_nonneg hQ (Nat.cast_nonneg b)), Real.dist_eq]
      calc |f w - f w'| ≤ Q * ∑ k, |w k - w' k| := hlip w w'
        _ ≤ Q * ∑ _k : Fin b, dist w w' := by
          apply mul_le_mul_of_nonneg_left _ hQ
          apply Finset.sum_le_sum
          intro k _
          rw [← Real.dist_eq]
          exact dist_le_pi_dist w w' k
        _ = Q * b * dist w w' := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          ring
    exact hL.continuous
  
  obtain ⟨H, hH⟩ : ∃ H : (Fin b → ℝ) → ℝ,
      H = fun w => Q / 4 * ∑ k, (a * Real.sin (Real.pi * (x k - w k)) ^ 2 + 1 / a) := ⟨_, rfl⟩
  have hpt : ∀ w, |f x - f w| ≤ H w := by
    intro w
    have h1 := hper w (fun k => round (x k - w k))
    rw [← h1]
    refine (hlip x _).trans ?_
    calc Q * ∑ k, |x k - (w + fun k => ((round (x k - w k) : ℤ) : ℝ)) k|
        ≤ Q * ∑ k, (a * Real.sin (Real.pi * (x k - w k)) ^ 2 + 1 / a) / 4 := by
          apply mul_le_mul_of_nonneg_left _ hQ
          apply Finset.sum_le_sum
          intro k _
          have := s1 (x k - w k)
          have e : x k - (w + fun k => ((round (x k - w k) : ℤ) : ℝ)) k
              = (x k - w k) - ((round (x k - w k) : ℤ) : ℝ) := by
            simp only [Pi.add_apply]; ring
          rw [e]
          exact this
      _ = H w := by
          rw [hH, ← Finset.sum_div]
          ring
  have hHc : Continuous H := by
    rw [hH]
    fun_prop
  have hρc : Continuous (fun w => ‖P w‖ ^ 2) := hP.norm.pow 2
  
  have hdev : |f x * (∫ w in Set.Icc (0 : Fin b → ℝ) 1, ‖P w‖ ^ 2)
      - ∫ w in Set.Icc (0 : Fin b → ℝ) 1, f w * ‖P w‖ ^ 2|
      ≤ ∫ w in Set.Icc (0 : Fin b → ℝ) 1, H w * ‖P w‖ ^ 2 := by
    rw [← MeasureTheory.integral_const_mul,
      ← MeasureTheory.integral_sub ((continuous_const.mul hρc).integrableOn_Icc)
        ((hfc.mul hρc).integrableOn_Icc)]
    rw [← Real.norm_eq_abs]
    apply MeasureTheory.norm_integral_le_of_norm_le ((hHc.mul hρc).integrableOn_Icc)
    apply MeasureTheory.ae_of_all
    intro w
    rw [Real.norm_eq_abs, ← sub_mul, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖P w‖ ^ 2)]
    exact mul_le_mul_of_nonneg_right (hpt w) (by positivity)
  
  have s2 : ∫ w in Set.Icc (0 : Fin b → ℝ) 1, H w * ‖P w‖ ^ 2
      = Q / 4 * b * (a * ((R : ℝ) ^ b / (2 * R)) + (R : ℝ) ^ b / a) := by
    have hint1 : MeasureTheory.IntegrableOn (fun w => ‖P w‖ ^ 2) (Set.Icc (0 : Fin b → ℝ) 1) :=
      hρc.integrableOn_Icc
    have hint2 : ∀ k : Fin b, MeasureTheory.IntegrableOn
        (fun w => Real.sin (Real.pi * (x k - w k)) ^ 2 * ‖P w‖ ^ 2) (Set.Icc (0 : Fin b → ℝ) 1) := by
      intro k
      apply Continuous.integrableOn_Icc
      fun_prop
    have heq : ∀ w, H w * ‖P w‖ ^ 2 = ∑ k : Fin b, (Q / 4 * a * (Real.sin (Real.pi * (x k - w k)) ^ 2
        * ‖P w‖ ^ 2) + Q / 4 * (1 / a) * ‖P w‖ ^ 2) := by
      intro w
      simp only [hH, Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun k _ => ?_
      ring
    simp_rw [heq]
    rw [MeasureTheory.integral_finset_sum]
    swap
    · intro k _
      exact ((hint2 k).const_mul (Q / 4 * a)).add (hint1.const_mul (Q / 4 * (1 / a)))
    have hk : ∀ k : Fin b, ∫ w in Set.Icc (0 : Fin b → ℝ) 1, (Q / 4 * a * (Real.sin (Real.pi * (x k - w k)) ^ 2
        * ‖P w‖ ^ 2) + Q / 4 * (1 / a) * ‖P w‖ ^ 2)
        = Q / 4 * a * ((R : ℝ) ^ b / (2 * R)) + Q / 4 * (1 / a) * (R : ℝ) ^ b := by
      intro k
      rw [MeasureTheory.integral_add
          (f := fun w => Q / 4 * a * (Real.sin (Real.pi * (x k - w k)) ^ 2 * ‖P w‖ ^ 2))
          (g := fun w => Q / 4 * (1 / a) * ‖P w‖ ^ 2)
          ((hint2 k).const_mul (Q / 4 * a)) (hint1.const_mul (Q / 4 * (1 / a))),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul, hK2 k, hK1]
    rw [Finset.sum_congr rfl (fun k _ => hk k), Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]
    ring
  
  rw [hK1, s2] at hdev
  have hA : (0 : ℝ) < (R : ℝ) ^ b := pow_pos hRpos b
  obtain ⟨A, hA_def⟩ : ∃ A : ℝ, A = (R : ℝ) ^ b := ⟨_, rfl⟩
  rw [← hA_def] at hdev hA ⊢
  have hgoal_eq : f x - (∫ w in Set.Icc (0 : Fin b → ℝ) 1, f w * ‖P w‖ ^ 2) / A
      = (f x * A - ∫ w in Set.Icc (0 : Fin b → ℝ) 1, f w * ‖P w‖ ^ 2) / A := by
    field_simp
  rw [hgoal_eq, abs_div, abs_of_pos hA, div_le_iff₀ hA]
  refine hdev.trans ?_
  rw [← haa]
  have e : Q / 4 * b * (a * (A / (2 * (a * a))) + A / a) = 3 / 8 * (Q * b / a * A) := by
    field_simp
    ring
  rw [e]
  have : 0 ≤ Q * b / a * A := by positivity
  linarith

theorem nil2_torus_piece (ν a b : ℕ) (D Q X : ℝ) (hQ : 2 ≤ Q) (hQX : Q ≤ X) (hab : ((a + b : ℕ) : ℝ) ≤ D) (Bc : Fin a → Fin a → Fin b → ℤ) (F : (Fin a → ℝ) × (Fin b → ℝ) → ℝ) (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ) (hF1 : ∀ u, |F u| ≤ 1) (hvert : ∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (n : Fin b → ℤ), F (u₁, w + fun k => (n k : ℝ)) = F (u₁, w)) (hhor : ∀ (u₁ : Fin a → ℝ) (w : Fin b → ℝ) (γ₁ : Fin a → ℤ), F ((fun i => u₁ i + (γ₁ i : ℝ)), (fun k => w k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ₁ j : ℝ))) = F (u₁, w)) (hlipx : ∀ u v : (Fin a → ℝ) × (Fin b → ℝ), (∀ i, -1 ≤ u.1 i ∧ u.1 i ≤ 2) → (∀ i, -1 ≤ v.1 i ∧ v.1 i ≤ 2) → (∀ k, |u.2 k - v.2 k| ≤ 1) → |F u - F v| ≤ Q * (∑ i, |u.1 i - v.1 i| + ∑ k, |u.2 k - v.2 k|)) (hvlip : ∀ (u₁ : Fin a → ℝ) (w w' : Fin b → ℝ), |F (u₁, w) - F (u₁, w')| ≤ Q * ∑ k, |w k - w' k|) (hshift : ∀ (g : (Fin b → ℝ) → ℂ), (∀ (w : Fin b → ℝ) (n : Fin b → ℤ), g (w + fun k => (n k : ℝ)) = g w) → ∀ c : Fin b → ℝ, ∫ w in Set.Icc (0 : Fin b → ℝ) 1, g (w + c) = ∫ w in Set.Icc (0 : Fin b → ℝ) 1, g w) : IsTorusQuadSeq ν D X (fun z => ∫ w in Set.Icc (0 : Fin b → ℝ) 1, F ((fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i), w)) :=
by
  classical
  
  have hbox : ∀ (f : (Fin b → ℝ) → ℝ) (C : ℝ), (∀ w, |f w| ≤ C) →
      |∫ w in Set.Icc (0 : Fin b → ℝ) 1, f w| ≤ C := by
    intro f C hf
    have hfin : MeasureTheory.volume (Set.Icc (0 : Fin b → ℝ) 1) < ⊤ := measure_Icc_lt_top
    have h := MeasureTheory.norm_setIntegral_le_of_norm_le_const (f := f) (C := C) hfin
      (fun x _ => by rw [Real.norm_eq_abs]; exact hf x)
    have hvol : MeasureTheory.volume.real (Set.Icc (0 : Fin b → ℝ) 1) = 1 := by
      rw [MeasureTheory.measureReal_def, Real.volume_Icc_pi_toReal
        (show (0 : Fin b → ℝ) ≤ 1 from fun _ => zero_le_one)]
      simp
    rw [hvol, mul_one, Real.norm_eq_abs] at h
    exact h
  
  have hper : ∀ (u₁ : Fin a → ℝ) (γ : Fin a → ℤ),
      ∫ w in Set.Icc (0 : Fin b → ℝ) 1, F ((fun i => u₁ i + (γ i : ℝ)), w) =
      ∫ w in Set.Icc (0 : Fin b → ℝ) 1, F (u₁, w) := by
    intro u₁ γ
    obtain ⟨c, hc⟩ : ∃ c : Fin b → ℝ,
        c = fun k => ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ j : ℝ) := ⟨_, rfl⟩
    have hpt : ∀ w, F ((fun i => u₁ i + (γ i : ℝ)), w) = F (u₁, w + (-c)) := by
      intro w
      have h1 := hhor u₁ (w + (-c)) γ
      have hw : (fun k => (w + -c) k + ∑ i, ∑ j, (Bc i j k : ℝ) * u₁ i * (γ j : ℝ)) = w := by
        funext k
        rw [hc]
        simp
      rw [hw] at h1
      exact h1
    simp_rw [hpt]
    have hg : ∀ (w : Fin b → ℝ) (n : Fin b → ℤ),
        (fun w => ((F (u₁, w) : ℝ) : ℂ)) (w + fun k => (n k : ℝ)) =
          (fun w => ((F (u₁, w) : ℝ) : ℂ)) w := by
      intro w n
      simp only [hvert]
    have h2 := hshift (fun w => ((F (u₁, w) : ℝ) : ℂ)) hg (-c)
    simp only at h2
    rw [integral_complex_ofReal, integral_complex_ofReal] at h2
    exact_mod_cast h2
  
  have hwin : ∀ (u v : Fin a → ℝ), (∀ i, |u i - v i| ≤ 1) → ∃ n : Fin a → ℤ, ∀ i,
      (-1 ≤ u i + (n i : ℝ) ∧ u i + (n i : ℝ) ≤ 2) ∧
        (-1 ≤ v i + (n i : ℝ) ∧ v i + (n i : ℝ) ≤ 2) := by
    intro u v huv
    refine ⟨fun i => -⌊min (u i) (v i)⌋, fun i => ?_⟩
    have h1 := Int.floor_le (min (u i) (v i))
    have h2 := Int.lt_floor_add_one (min (u i) (v i))
    have h3 := min_le_left (u i) (v i)
    have h4 := min_le_right (u i) (v i)
    have h5 := abs_sub_le_iff.mp (huv i)
    have h6 : u i ≤ min (u i) (v i) + 1 ∧ v i ≤ min (u i) (v i) + 1 := by
      rcases le_total (u i) (v i) with h | h
      · rw [min_eq_left h]; constructor <;> linarith
      · rw [min_eq_right h]; constructor <;> linarith
    push_cast
    exact ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩
  
  have hQ0 : 0 ≤ Q := by linarith
  have hcont : ∀ u₁ : Fin a → ℝ, Continuous (fun w : Fin b → ℝ => F (u₁, w)) := by
    intro u₁
    apply LipschitzWith.continuous (K := Real.toNNReal (Q * b))
    apply LipschitzWith.of_dist_le_mul
    intro w w'
    rw [Real.dist_eq, Real.coe_toNNReal _ (mul_nonneg hQ0 (Nat.cast_nonneg b))]
