theorem kai_v_ext_adjugate (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K)) :
    ∃ C₃ : ℝ, 1 ≤ C₃ ∧ ∀ e : NumberField.RingOfIntegers K, e ≠ 0 →
      Algebra.norm ℤ e ≠ 0 ∧
      |((Algebra.norm ℤ e : ℤ) : ℝ)| ≤ C₃ * basisSupNorm ω e ^ Module.finrank ℚ K ∧
      ∀ l : Fin (Module.finrank ℚ K), ∃ y : NumberField.RingOfIntegers K,
        e * y = ((Algebra.norm ℤ e : ℤ) : NumberField.RingOfIntegers K) * ω l ∧
        basisSupNorm ω y ≤ C₃ * basisSupNorm ω e ^ Module.finrank ℚ K :=
by
  have hsup : ∀ x : NumberField.RingOfIntegers K,
      basisSupNorm ω x = ⨆ j, |((ω.repr x j : ℤ) : ℝ)| := fun x => rfl
  have hnn : ∀ x : NumberField.RingOfIntegers K, 0 ≤ basisSupNorm ω x := fun x => by
    rw [hsup]; exact Real.iSup_nonneg (fun j => abs_nonneg _)
  have hcoord : ∀ (x : NumberField.RingOfIntegers K) (j : Fin (Module.finrank ℚ K)),
      |((ω.repr x j : ℤ) : ℝ)| ≤ basisSupNorm ω x := fun x j => by
    rw [hsup]
    exact le_ciSup (f := fun j => |((ω.repr x j : ℤ) : ℝ)|) (Set.finite_range _).bddAbove j
  have hone : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → 1 ≤ basisSupNorm ω x := by
    intro x hx
    obtain ⟨j, hj⟩ : ∃ j, ω.repr x j ≠ 0 := by
      by_contra h
      push_neg at h
      apply hx
      have h0 : ω.repr x = 0 := Finsupp.ext h
      exact (LinearEquiv.map_eq_zero_iff ω.repr).1 h0
    have h1 : (1 : ℝ) ≤ |((ω.repr x j : ℤ) : ℝ)| := by
      rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hj
    exact h1.trans (hcoord x j)
  have hdet : ∀ (A : Matrix (Fin (Module.finrank ℚ K)) (Fin (Module.finrank ℚ K)) ℤ) (B : ℝ),
      (∀ i j, |((A i j : ℤ) : ℝ)| ≤ B) →
      |((A.det : ℤ) : ℝ)| ≤ ((Module.finrank ℚ K).factorial : ℝ) * B ^ Module.finrank ℚ K := by
    intro A B hA
    have h := Matrix.det_le (abv := AbsoluteValue.abs) (A := (Int.castRingHom ℝ).mapMatrix A)
      (x := B) (fun i j => by simpa using hA i j)
    rw [← RingHom.map_det] at h
    simpa [Fintype.card_fin, nsmul_eq_mul] using h
  obtain ⟨C₂, hC₂, hE⟩ : ∃ C₂ : ℝ, 1 ≤ C₂ ∧ ∀ (x : NumberField.RingOfIntegers K)
      (j l : Fin (Module.finrank ℚ K)),
      |((Algebra.leftMulMatrix ω x j l : ℤ) : ℝ)| ≤ C₂ * basisSupNorm ω x := by
    let r : Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → Fin (Module.finrank ℚ K) → ℤ :=
      fun i l j => ω.repr (ω i * ω l) j
    have hS : 0 ≤ ∑ i, ∑ l, ∑ j, |(r i l j : ℝ)| :=
      Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun l _ =>
        Finset.sum_nonneg (fun j _ => abs_nonneg _)))
    refine ⟨1 + ∑ i, ∑ l, ∑ j, |(r i l j : ℝ)|, by linarith, ?_⟩
    intro x j l
    have hexp : (Algebra.leftMulMatrix ω x j l : ℤ) = ∑ i, ω.repr x i * r i l j := by
      rw [Algebra.leftMulMatrix_eq_repr_mul]
      conv_lhs => rw [← ω.sum_repr x]
      rw [Finset.sum_mul, map_sum, Finsupp.finset_sum_apply]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [smul_mul_assoc, map_zsmul, Finsupp.smul_apply, smul_eq_mul]
    rw [hexp]
    push_cast
    have hsub : ∑ i, |(r i l j : ℝ)| ≤ ∑ i, ∑ l', ∑ j', |(r i l' j' : ℝ)| := by
      apply Finset.sum_le_sum
      intro i _
      calc |(r i l j : ℝ)| ≤ ∑ j', |(r i l j' : ℝ)| :=
            Finset.single_le_sum (f := fun j' => |(r i l j' : ℝ)|) (fun _ _ => abs_nonneg _)
              (Finset.mem_univ j)
        _ ≤ ∑ l', ∑ j', |(r i l' j' : ℝ)| :=
            Finset.single_le_sum (f := fun l' => ∑ j', |(r i l' j' : ℝ)|)
              (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (Finset.mem_univ l)
    calc |∑ i, ((ω.repr x i : ℤ) : ℝ) * (r i l j : ℝ)|
        ≤ ∑ i, |((ω.repr x i : ℤ) : ℝ) * (r i l j : ℝ)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i, basisSupNorm ω x * |(r i l j : ℝ)| := by
          apply Finset.sum_le_sum
          intro i _
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right (hcoord x i) (abs_nonneg _)
      _ = basisSupNorm ω x * ∑ i, |(r i l j : ℝ)| := by rw [Finset.mul_sum]
      _ ≤ basisSupNorm ω x * (1 + ∑ i, ∑ l, ∑ j, |(r i l j : ℝ)|) := by
          apply mul_le_mul_of_nonneg_left _ (hnn x)
          linarith
      _ = (1 + ∑ i, ∑ l, ∑ j, |(r i l j : ℝ)|) * basisSupNorm ω x := by ring
  have hC₂0 : 0 ≤ C₂ := by linarith
  refine ⟨((Module.finrank ℚ K).factorial : ℝ) * C₂ ^ Module.finrank ℚ K,
    one_le_mul_of_one_le_of_one_le (by exact_mod_cast Nat.factorial_pos _) (one_le_pow₀ hC₂), ?_⟩
  intro e he
  have hs : 1 ≤ basisSupNorm ω e := hone e he
  have hB1 : 1 ≤ C₂ * basisSupNorm ω e := one_le_mul_of_one_le_of_one_le hC₂ hs
  have hBn : ((Module.finrank ℚ K).factorial : ℝ) * (C₂ * basisSupNorm ω e) ^ Module.finrank ℚ K
      = ((Module.finrank ℚ K).factorial : ℝ) * C₂ ^ Module.finrank ℚ K
        * basisSupNorm ω e ^ Module.finrank ℚ K := by
    rw [mul_pow]; ring
  have hEe : ∀ j l, |((Algebra.leftMulMatrix ω e j l : ℤ) : ℝ)| ≤ C₂ * basisSupNorm ω e :=
    fun j l => hE e j l
  refine ⟨Algebra.norm_ne_zero_iff.2 he, ?_, ?_⟩
  · rw [Algebra.norm_eq_matrix_det ω e, ← hBn]
    exact hdet _ _ hEe
  · intro l
    refine ⟨∑ j, (Algebra.leftMulMatrix ω e).adjugate j l • ω j, ?_, ?_⟩
    · apply ω.ext_elem
      intro i
      rw [← zsmul_eq_mul, map_zsmul, ω.repr_self, ← Algebra.leftMulMatrix_mulVec_repr,
        ω.repr_sum_self]
      have h1 : Matrix.mulVec (Algebra.leftMulMatrix ω e)
            (fun j => (Algebra.leftMulMatrix ω e).adjugate j l) i
          = ((Algebra.leftMulMatrix ω e) * (Algebra.leftMulMatrix ω e).adjugate) i l := by
        simp [Matrix.mulVec, dotProduct, Matrix.mul_apply]
      rw [h1, Matrix.mul_adjugate, ← Algebra.norm_eq_matrix_det]
      by_cases hil : i = l
      · subst hil; simp
      · simp [hil, Finsupp.single_apply, Ne.symm hil]
    · have hpos : 0 ≤ ((Module.finrank ℚ K).factorial : ℝ) * C₂ ^ Module.finrank ℚ K
          * basisSupNorm ω e ^ Module.finrank ℚ K :=
        mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hC₂0 _)) (pow_nonneg (hnn e) _)
      rw [hsup]
      refine Real.iSup_le (fun j => ?_) hpos
      rw [ω.repr_sum_self, Matrix.adjugate_apply, ← hBn]
      apply hdet
      intro i k
      rw [Matrix.updateRow_apply]
      split_ifs with hi
      · rw [Pi.single_apply]
        split_ifs with hk
        · simp; linarith
        · simp; linarith
      · exact hEe i k

theorem kai_v_ext_ideal_multiplicity (K : Type u) [Field K] [NumberField K] :
    ∃ (C₄ : ℝ) (κ : ℕ), 1 ≤ C₄ ∧ ∀ (b : NumberField.RingOfIntegers K), b ≠ 0 →
      ∀ D₀ : ℝ, 0 < D₀ → ∀ I : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ 𝔡 ∈ I, b ∈ 𝔡 ∧ D₀ ≤ (Ideal.absNorm 𝔡 : ℝ)) →
        (I.card : ℝ) ≤ C₄ * (((Algebra.norm ℤ b).natAbs : ℝ) / D₀ + 1) ^ κ :=
by
  classical
  obtain ⟨C₅, hC₅, hcount⟩ := kai_ideal_count_bounds K
  refine ⟨C₅, 1, hC₅, ?_⟩
  intro b hb D₀ hD₀ I hI
  set Nb : ℝ := ((Algebra.norm ℤ b).natAbs : ℝ) with hNb_def
  have hNb0 : 0 ≤ Nb := Nat.cast_nonneg _
  have hX1 : (1 : ℝ) ≤ Nb / D₀ + 1 := by
    have : 0 ≤ Nb / D₀ := div_nonneg hNb0 hD₀.le
    linarith
  have hex : ∀ 𝔡 : Ideal (NumberField.RingOfIntegers K), ∃ 𝔢 : Ideal (NumberField.RingOfIntegers K),
      𝔡 ∣ Ideal.span {b} → Ideal.span {b} = 𝔡 * 𝔢 := by
    intro 𝔡
    by_cases h : 𝔡 ∣ Ideal.span {b}
    · obtain ⟨𝔢, h𝔢⟩ := h
      exact ⟨𝔢, fun _ => h𝔢⟩
    · exact ⟨⊥, fun h' => absurd h' h⟩
  choose f hf using hex
  have hspan_ne : Ideal.span {b} ≠ (⊥ : Ideal (NumberField.RingOfIntegers K)) := by
    rw [Ne, Ideal.span_singleton_eq_bot]; exact hb
  have hE : ∀ 𝔡 ∈ I, Ideal.span {b} = 𝔡 * f 𝔡 := by
    intro 𝔡 h𝔡
    apply hf
    rw [Ideal.dvd_iff_le]
    exact (Ideal.span_singleton_le_iff_mem 𝔡).2 (hI 𝔡 h𝔡).1
  have hfne : ∀ 𝔡 ∈ I, f 𝔡 ≠ ⊥ := by
    intro 𝔡 h𝔡 hbot
    apply hspan_ne
    rw [hE 𝔡 h𝔡, hbot, Ideal.mul_bot]
  have hnorm : ∀ 𝔡 ∈ I, (Ideal.absNorm (f 𝔡) : ℝ) ≤ Nb / D₀ + 1 := by
    intro 𝔡 h𝔡
    have h1 : Ideal.absNorm (Ideal.span {b}) = Ideal.absNorm 𝔡 * Ideal.absNorm (f 𝔡) := by
      rw [hE 𝔡 h𝔡, map_mul]
    rw [Ideal.absNorm_span_singleton] at h1
    have h2 : Nb = (Ideal.absNorm 𝔡 : ℝ) * (Ideal.absNorm (f 𝔡) : ℝ) := by
      rw [hNb_def, h1, Nat.cast_mul]
    have h3 : (Ideal.absNorm (f 𝔡) : ℝ) * D₀ ≤ Nb := by
      rw [h2, mul_comm (Ideal.absNorm 𝔡 : ℝ)]
      exact mul_le_mul_of_nonneg_left (hI 𝔡 h𝔡).2 (Nat.cast_nonneg _)
    have h4 : (Ideal.absNorm (f 𝔡) : ℝ) ≤ Nb / D₀ := (le_div_iff₀ hD₀).2 h3
    linarith
  have hinj : Set.InjOn f ↑I := by
    intro 𝔡 h𝔡 𝔡' h𝔡' heq
    have h𝔡m : 𝔡 ∈ I := h𝔡
    have h𝔡m' : 𝔡' ∈ I := h𝔡'
    have hne0 : f 𝔡 ≠ 0 := hfne 𝔡 h𝔡m
    have : 𝔡 * f 𝔡 = 𝔡' * f 𝔡 := by
      rw [← hE 𝔡 h𝔡m, heq, ← hE 𝔡' h𝔡m']
    exact mul_right_cancel₀ hne0 this
  have hcard : (I.image f).card = I.card := Finset.card_image_of_injOn hinj
  have hS : ∀ 𝔞 ∈ I.image f, 𝔞 ≠ ⊥ ∧ (Ideal.absNorm 𝔞 : ℝ) ≤ Nb / D₀ + 1 := by
    intro 𝔞 h𝔞
    obtain ⟨𝔡, h𝔡, rfl⟩ := Finset.mem_image.1 h𝔞
    exact ⟨hfne 𝔡 h𝔡, hnorm 𝔡 h𝔡⟩
  have := (hcount (Nb / D₀ + 1) hX1 (I.image f) hS).1
  rw [hcard] at this
  rw [pow_one]
  exact this

theorem kai_v_ext_family_pigeonhole {ι : Type*} [DecidableEq ι] (a : ℕ) (G : Finset ι)
    (k : ι → Fin a → Fin a → ℤ) (X : ℝ) (hX : 1 ≤ X)
    (hk : ∀ 𝔡 ∈ G, ∀ m i, |((k 𝔡 m i : ℤ) : ℝ)| ≤ X) :
    ∃ (k₀ : Fin a → Fin a → ℤ) (G' : Finset ι), G' ⊆ G ∧ (∀ 𝔡 ∈ G', k 𝔡 = k₀) ∧
      (G.card : ℝ) ≤ (3 * X) ^ (a * a) * (G'.card : ℝ) :=
by
  classical
  obtain ⟨N, hN_def⟩ : ∃ N : ℤ, N = ⌊X⌋ := ⟨_, rfl⟩
  have hN0 : 0 ≤ N := by rw [hN_def]; exact Int.floor_nonneg.mpr (by linarith)
  have hNX : (N : ℝ) ≤ X := by rw [hN_def]; exact Int.floor_le X
  have hbd : ∀ 𝔡 ∈ G, ∀ m i, -N ≤ k 𝔡 m i ∧ k 𝔡 m i ≤ N := by
    intro 𝔡 h𝔡 m i
    have h := abs_le.mp (hk 𝔡 h𝔡 m i)
    constructor
    · have : -(k 𝔡 m i) ≤ N := by
        rw [hN_def]; exact Int.le_floor.mpr (by push_cast; linarith [h.1])
      omega
    · rw [hN_def]; exact Int.le_floor.mpr h.2
  let T : Finset (Fin a → Fin a → ℤ) :=
    Fintype.piFinset (fun _ : Fin a => Fintype.piFinset (fun _ : Fin a => Finset.Icc (-N) N))
  have hmaps : ∀ 𝔡 ∈ G, k 𝔡 ∈ T := by
    intro 𝔡 h𝔡
    simp only [T, Fintype.mem_piFinset, Finset.mem_Icc]
    exact fun m i => hbd 𝔡 h𝔡 m i
  have hTne : T.Nonempty := ⟨fun _ _ => 0, by
    simp only [T, Fintype.mem_piFinset, Finset.mem_Icc]
    intro _ _; omega⟩
  have hTcard : (T.card : ℝ) = (2 * (N : ℝ) + 1) ^ (a * a) := by
    have h1 : T.card = ((N + 1 - -N).toNat ^ a) ^ a := by
      simp only [T, Fintype.card_piFinset, Int.card_Icc, Finset.prod_const, Finset.card_univ,
        Fintype.card_fin]
    have h2 : (((N + 1 - -N).toNat : ℕ) : ℤ) = 2 * N + 1 := by
      rw [Int.toNat_of_nonneg (by omega)]; ring
    have h3 : (((N + 1 - -N).toNat : ℕ) : ℝ) = 2 * (N : ℝ) + 1 := by
      have : (((N + 1 - -N).toNat : ℕ) : ℝ) = ((((N + 1 - -N).toNat : ℕ) : ℤ) : ℝ) := by
        norm_cast
      rw [this, h2]; push_cast; ring
    rw [h1, Nat.cast_pow, Nat.cast_pow, h3, ← pow_mul]
  have hTpos : (0 : ℝ) < T.card := by exact_mod_cast Finset.card_pos.mpr hTne
  have hN0' : (0 : ℝ) ≤ N := by exact_mod_cast hN0
  have hTle : (T.card : ℝ) ≤ (3 * X) ^ (a * a) := by
    rw [hTcard]
    exact pow_le_pow_left₀ (by linarith) (by linarith) _
  obtain ⟨k₀, -, hfib⟩ := Finset.exists_le_card_fiber_of_nsmul_le_card_of_maps_to hmaps hTne
    (b := (G.card : ℝ) / (T.card : ℝ)) (by rw [nsmul_eq_mul, mul_div_cancel₀ _ hTpos.ne'])
  refine ⟨k₀, G.filter (fun 𝔡 => k 𝔡 = k₀), Finset.filter_subset _ _,
    fun 𝔡 h => (Finset.mem_filter.mp h).2, ?_⟩
  rw [div_le_iff₀ hTpos] at hfib
  calc (G.card : ℝ) ≤ ((G.filter (fun 𝔡 => k 𝔡 = k₀)).card : ℝ) * T.card := by
        convert hfib using 3
    _ ≤ (3 * X) ^ (a * a) * ((G.filter (fun 𝔡 => k 𝔡 = k₀)).card : ℝ) := by
        rw [mul_comm]; exact mul_le_mul_of_nonneg_right hTle (Nat.cast_nonneg _)

theorem kai_v_linear_vinogradov : ∀ (ν : ℕ) (R η ε : ℝ) (β : Fin ν → ℝ) (S : Finset (Fin ν → ℤ)), 0 < η → η ≤ 1 → 6 / η ^ 2 ≤ R → 0 ≤ ε → ε ≤ η ^ 2 / 200 → (∀ b ∈ S, ∀ j, |((b j : ℤ) : ℝ)| ≤ R) → η * (2 * R + 1) ^ ν ≤ (S.card : ℝ) → (∀ b ∈ S, ∃ m : ℤ, |∑ j, ((b j : ℤ) : ℝ) * β j - m| ≤ ε) → ∃ q : ℕ, 1 ≤ q ∧ (q : ℝ) ≤ (2 / η) ^ ν ∧ ∀ j, ∃ m : ℤ, |(q : ℝ) * β j - m| ≤ (2 / η) ^ ν * (4 * ε / (η ^ 2 * R)) :=
by
  
  have lv_common_denom : ∀ (ν : ℕ) (P δ : ℝ) (q : Fin ν → ℕ) (β : Fin ν → ℝ), 1 ≤ P → 0 ≤ δ →
      (∀ j, 1 ≤ q j) → (∀ j, (q j : ℝ) ≤ P) → (∀ j, ∃ m : ℤ, |(q j : ℝ) * β j - m| ≤ δ) →
      1 ≤ ∏ j, q j ∧ ((∏ j, q j : ℕ) : ℝ) ≤ P ^ ν ∧
        ∀ j, ∃ m : ℤ, |((∏ j, q j : ℕ) : ℝ) * β j - m| ≤ P ^ ν * δ := by
    intro ν P δ q β _hP hδ hq1 hqP hβ
    have h1 : 1 ≤ ∏ j, q j := Finset.one_le_prod' (fun j _ => hq1 j)
    have h2 : ((∏ j, q j : ℕ) : ℝ) ≤ P ^ ν := by
      rw [Nat.cast_prod]
      calc ∏ j, (q j : ℝ) ≤ ∏ _j : Fin ν, P :=
            Finset.prod_le_prod (fun j _ => Nat.cast_nonneg _) (fun j _ => hqP j)
        _ = P ^ ν := by simp
    refine ⟨h1, h2, fun j => ?_⟩
    obtain ⟨m, hm⟩ := hβ j
    have hsplit := Finset.mul_prod_erase Finset.univ q (Finset.mem_univ j)
    obtain ⟨Qj, hQj⟩ : ∃ Qj : ℕ, Qj = ∏ k ∈ Finset.univ.erase j, q k := ⟨_, rfl⟩
    rw [← hQj] at hsplit
    refine ⟨(Qj : ℤ) * m, ?_⟩
    have hprod : ((∏ j, q j : ℕ) : ℝ) = (q j : ℝ) * (Qj : ℝ) := by
      rw [← hsplit]; push_cast; ring
    have hqj1 : (1:ℝ) ≤ q j := by exact_mod_cast hq1 j
    have hQjle : (Qj : ℝ) ≤ P ^ ν := by
      have h0 : (0:ℝ) ≤ Qj := Nat.cast_nonneg Qj
      calc (Qj : ℝ) = 1 * Qj := by ring
        _ ≤ (q j : ℝ) * Qj := mul_le_mul_of_nonneg_right hqj1 h0
        _ = _ := hprod.symm
        _ ≤ P ^ ν := h2
    have heq : ((∏ j, q j : ℕ) : ℝ) * β j - (((Qj : ℤ) * m : ℤ) : ℝ)
        = (Qj : ℝ) * ((q j : ℝ) * β j - m) := by
      rw [hprod]; push_cast; ring
    rw [heq, abs_mul, Nat.abs_cast]
    calc (Qj : ℝ) * |(q j : ℝ) * β j - m| ≤ (Qj:ℝ) * δ :=
          mul_le_mul_of_nonneg_left hm (Nat.cast_nonneg _)
      _ ≤ P ^ ν * δ := mul_le_mul_of_nonneg_right hQjle hδ
  
  have lv_dichotomy : ∀ (η R ε γ D N : ℝ), 0 < η → η ≤ 1 → 6 / η ^ 2 ≤ R → 0 ≤ ε →
      ε ≤ η ^ 2 / 200 → |γ| ≤ 2 * ε → η ^ 2 * (2 * R + 1) / 2 ≤ N → N ≤ D + 1 → D ≤ 2 * R →
      (∃ z : ℤ, |D * γ - z| ≤ 2 * ε) →
      (γ ≠ 0 → N ≤ (D * |γ| + 2 * ε + 1) * (2 * ε / |γ| + 1)) →
      |γ| ≤ 4 * ε / (η ^ 2 * R) := by
    intro η R ε γ D N hη0 hη1 hR hε0 hε1 hγ hN1 hN2 hD hDγ hcount
    have hη2 : 0 < η ^ 2 := by positivity
    have hκ : 6 ≤ η ^ 2 * R := by rw [div_le_iff₀ hη2] at hR; linarith
    have hη21 : η ^ 2 ≤ 1 := by nlinarith
    have hε2 : ε ≤ 1 / 200 := by linarith
    have hR0 : 0 < R := by nlinarith
    have hDlow : η ^ 2 * R / 2 ≤ D := by nlinarith
    have hκpos : 0 < η ^ 2 * R := by linarith
    have hD0 : 0 ≤ D := by linarith
    by_cases hcase : D * |γ| < 1 / 2
    · obtain ⟨z, hz⟩ := hDγ
      have h1 : |D * γ| = D * |γ| := by rw [abs_mul, abs_of_nonneg hD0]
      have hzabs : |(z : ℝ)| < 1 := by
        have h2 := abs_sub_abs_le_abs_sub (z:ℝ) (D * γ)
        rw [abs_sub_comm] at h2
        linarith
      have hz0 : z = 0 := by
        have : |z| < 1 := by exact_mod_cast hzabs
        exact Int.abs_lt_one_iff.mp this
      subst hz0
      rw [Int.cast_zero, sub_zero, h1] at hz
      rw [le_div_iff₀ hκpos]
      have := mul_le_mul_of_nonneg_right hDlow (abs_nonneg γ)
      nlinarith
    · push_neg at hcase
      have hγ0 : γ ≠ 0 := by
        intro h; rw [h, abs_zero, mul_zero] at hcase; norm_num at hcase
      have hg : 0 < |γ| := abs_pos.mpr hγ0
      have hc := hcount hγ0
      have h2 : (D * |γ| + 2 * ε + 1) * (2 * ε / |γ| + 1)
          ≤ 4 * D * |γ| * (2 * ε / |γ| + 1) := by
        apply mul_le_mul_of_nonneg_right _ (by positivity)
        linarith
