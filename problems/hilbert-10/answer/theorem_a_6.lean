theorem kai_lp_shape_trunc_tail (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ B : ℝ, 1 ≤ B → ∃ c X₀ : ℝ, 0 < c ∧ 3 ≤ X₀ ∧
      ∀ X : ℝ, X₀ ≤ X →
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        (Ideal.absNorm q : ℝ) ≤ Real.exp (Real.log X ^ ((1:ℝ)/4)) →
      ∀ (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ) (wq : ℕ)
        (Rq : ℝ) (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ),
        KaiTBUnitData K B q H wq Rq e →
      ∀ ε β : ℝ, |ε| ≤ 1 → (ε = 0 ∨ (1 / 2 ≤ β ∧ β < 1)) →
      ∀ (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
        (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
        (∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ (0 ≤ a w ∨ b w ≤ 0)) →
        (∀ p, 0 ≤ ρ p ∧ ρ p < σ p ∧ σ p ≤ X ∧
          -Real.pi ≤ θ₁ p ∧ θ₁ p ≤ θ₂ p ∧ θ₂ p ≤ Real.pi) →
        |(∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (θ₂ p - θ₁ p)) /
              (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
            (((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
              (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
                (NumberField.classNumber K : ℝ) *
                (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ) *
                NumberField.Units.regulator K)) *
            (kaiTBShapePow K H a b ρ σ 1 - ε * (kaiTBShapePow K H a b ρ σ β / β))
          - (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (θ₂ p - θ₁ p)) /
              (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
            (((NumberField.Units.torsionOrder K : ℕ) : ℝ) * Rq /
              (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
