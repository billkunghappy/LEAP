    simp only [Set.mem_preimage, Set.mem_Ioi]
    linarith
  have hMsum := hsum (fun w => Real.exp (u₀ w - 1)) (fun w => Real.exp_pos _)
  have hbound : ∀ (μ : ↥a) (u : NumberField.InfinitePlace K → ℝ),
