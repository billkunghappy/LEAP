            * (z * ((Real.log ((nn p.2 : ℝ)) : ℝ) : ℂ)) ^ p.1
            / ((Nat.factorial p.1 : ℕ) : ℂ) := ⟨_, fun _ => rfl⟩
      have hFmk : ∀ (m : ℕ) (x : X), F (m, x) =
          ((a x * ((nn x : ℝ)) ^ (-(2 : ℝ)) : ℝ) : ℂ)
            * (z * ((Real.log ((nn x : ℝ)) : ℝ) : ℂ)) ^ m
            / ((Nat.factorial m : ℕ) : ℂ) := fun m x => hFdef (m, x)
