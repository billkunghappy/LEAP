  obtain ⟨hGsum, hGle⟩ :=
    partA (fun P => ((Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K)) : ℝ))) hB0 hP
  have hB1 : ∀ z : {P : Ideal (NumberField.RingOfIntegers K) // P.IsPrime ∧ P ≠ ⊥} × ℕ,
