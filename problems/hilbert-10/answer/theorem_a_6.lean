    rw [← ENNReal.ofReal_pow hR 2,
      ← ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ R ^ 2),
      ← ENNReal.ofReal_pow (by linarith : (0:ℝ) ≤ 2 * R),
      ← ENNReal.ofReal_pow (by positivity : (0:ℝ) ≤ R ^ 2 * Real.pi),
      ← ENNReal.ofReal_mul (by positivity :
        (0:ℝ) ≤ (2 * R) ^ NumberField.InfinitePlace.nrRealPlaces K)]
    congr 1
    rw [← NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K, mul_pow, mul_pow, pow_add,
      pow_mul]
    ring
  
  obtain ⟨E, κ, hκ0, hEnorm, hdom⟩ := hcoord
  obtain ⟨cB, hcB0, hballvol⟩ := hballex
  set n : ℕ := Module.finrank ℚ K with hndef
  have h3n : (0:ℝ) ≤ (3:ℝ) ^ n := by positivity
  have h2n : (0:ℝ) ≤ (2:ℝ) ^ n := by positivity
  have hT1 : (0:ℝ) ≤ 12 * (E.card : ℝ) * κ * cB * 3 ^ n :=
    mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (Nat.cast_nonneg _))
      hκ0.le) hcB0.le) h3n
  have hT2 : (0:ℝ) ≤ 3 * κ * cB * 2 ^ n :=
    mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hκ0.le) hcB0.le) h2n
  refine ⟨12 * (E.card : ℝ) * κ * cB * 3 ^ n + 3 * κ * cB * 2 ^ n + 1, by linarith, ?_⟩
  intro X r hX hr hrX C hconv hopen hbox
  have hX0 : (0:ℝ) < X := lt_of_lt_of_le one_pos hX
  have hXn0 : (0:ℝ) < X ^ n := pow_pos hX0 n
  have hrXnn : (0:ℝ) ≤ r / X := (div_pos hr hX0).le
  have hPnn : (0:ℝ) ≤ X ^ n * (r / X) := mul_nonneg hXn0.le hrXnn
  set S : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    {z : NumberField.mixedEmbedding.mixedSpace K |
      (∃ x ∈ C, ‖z - x‖ ≤ r) ∧ ¬ (∀ y, ‖y - z‖ ≤ r → y ∈ C)} with hSdef
  set D : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    {z : NumberField.mixedEmbedding.mixedSpace K | ∃ x ∈ C, ‖z - x‖ ≤ r} with hDdef
  have hDmem : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
      z ∈ D ↔ ∃ x ∈ C, ‖z - x‖ ≤ r := fun _ => Iff.rfl
  have hnormC : ∀ z ∈ C, ‖z‖ ≤ X := by
    intro z hz
    rw [Prod.norm_def]
    refine max_le ?_ ?_
    · rw [pi_norm_le_iff_of_nonneg hX0.le]
      intro w
      have h := hbox z hz (w : NumberField.InfinitePlace K)
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2] at h
      exact h
    · rw [pi_norm_le_iff_of_nonneg hX0.le]
      intro w
      have h := hbox z hz (w : NumberField.InfinitePlace K)
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2] at h
      exact h
  have hShD : S ⊆ D := fun z hz => hz.1
  have hDopen : IsOpen D := by
    rw [Metric.isOpen_iff]
    intro z hz
    obtain ⟨x, hxC, hzx⟩ := (hDmem z).mp hz
    obtain ⟨ε, hε0, hεC⟩ := Metric.isOpen_iff.mp hopen x hxC
    refine ⟨ε, hε0, ?_⟩
    intro z' hz'
    have hz'' : ‖z' - z‖ < ε := by
      rw [Metric.mem_ball, dist_eq_norm] at hz'
      exact hz'
    refine (hDmem z').mpr ⟨x + (z' - z), hεC ?_, ?_⟩
    · rw [Metric.mem_ball, dist_eq_norm]
      have he : x + (z' - z) - x = z' - z := by abel
      rw [he]
      exact hz''
    · have he : z' - (x + (z' - z)) = z - x := by abel
      rw [he]
      exact hzx
  have hDconv : Convex ℝ D := by
    intro z₁ hz₁ z₂ hz₂ a b ha hb hab
    obtain ⟨x₁, hx₁, h₁⟩ := (hDmem z₁).mp hz₁
    obtain ⟨x₂, hx₂, h₂⟩ := (hDmem z₂).mp hz₂
    refine (hDmem _).mpr ⟨a • x₁ + b • x₂, hconv hx₁ hx₂ ha hb hab, ?_⟩
    have he : a • z₁ + b • z₂ - (a • x₁ + b • x₂) = a • (z₁ - x₁) + b • (z₂ - x₂) := by
      simp only [smul_sub]; abel
    rw [he]
    calc ‖a • (z₁ - x₁) + b • (z₂ - x₂)‖
        ≤ ‖a • (z₁ - x₁)‖ + ‖b • (z₂ - x₂)‖ := norm_add_le _ _
      _ = a * ‖z₁ - x₁‖ + b * ‖z₂ - x₂‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
            abs_of_nonneg ha, abs_of_nonneg hb]
      _ ≤ a * r + b * r := by
          have p1 := mul_le_mul_of_nonneg_left h₁ ha
          have p2 := mul_le_mul_of_nonneg_left h₂ hb
          linarith
      _ = r := by rw [← add_mul, hab, one_mul]
  have hDbound : ∀ z ∈ D, ‖z‖ ≤ 2 * X := by
    intro z hz
    obtain ⟨x, hxC, hzx⟩ := (hDmem z).mp hz
    have h1 : ‖x‖ ≤ X := hnormC x hxC
    have hzz : z = (z - x) + x := by abel
    have h2 : ‖z‖ ≤ ‖z - x‖ + ‖x‖ := by
      calc ‖z‖ = ‖(z - x) + x‖ := by rw [← hzz]
        _ ≤ ‖z - x‖ + ‖x‖ := norm_add_le _ _
    linarith
  obtain ⟨lam, hlamdef⟩ : ∃ l : ℝ, l = 3 * κ * r := ⟨_, rfl⟩
  have hlam0 : (0:ℝ) < lam := by
    rw [hlamdef]; exact mul_pos (mul_pos (by norm_num) hκ0) hr
  by_cases hcase : lam ≤ X
  · have hL : ∀ u : NumberField.mixedEmbedding.mixedSpace K, ‖u‖ ≤ lam →
        MeasureTheory.volume {y | y ∈ D ∧ y + u ∉ D}
          ≤ ENNReal.ofReal (6 * κ * cB * 3 ^ n * X ^ n * (r / X)) := by
      intro u hu
      have h1 := hlayer X lam u D hlam0 hcase hu hDconv hDopen hDbound
      have h2 := hballvol (3 * X) (by linarith)
      have h3 : MeasureTheory.volume {y | y ∈ D ∧ y + u ∉ D}
          ≤ ENNReal.ofReal (2 * lam / X) * ENNReal.ofReal (cB * (3 * X) ^ n) :=
        le_trans h1 (mul_le_mul_left' h2 _)
      refine le_trans h3 ?_
      rw [← ENNReal.ofReal_mul (div_nonneg (by linarith : (0:ℝ) ≤ 2 * lam) hX0.le)]
      apply ENNReal.ofReal_le_ofReal
      have hkey : 2 * lam / X * (cB * (3 * X) ^ n)
          = 6 * κ * cB * 3 ^ n * X ^ n * (r / X) := by
        rw [hlamdef, mul_pow]
        field_simp
        ring
      exact le_of_eq hkey
    have hnormu : ∀ e ∈ E, ∀ t : ℝ, |t| = lam → ‖t • e‖ ≤ lam := by
      intro e he t ht
      rw [norm_smul, Real.norm_eq_abs, ht]
      calc lam * ‖e‖ ≤ lam * 1 := mul_le_mul_of_nonneg_left (hEnorm e he) hlam0.le
        _ = lam := mul_one lam
    have hcover : S ⊆ ⋃ e ∈ E,
        ({y | y ∈ D ∧ y + lam • e ∉ D} ∪
         {y | y ∈ D ∧ y + (-lam) • e ∉ D}) := by
      intro z hz
      obtain ⟨φ, hφ0, hφ⟩ := hsepf C r z hconv hopen hz
      obtain ⟨e, heE, hedom⟩ := hdom φ hφ0
      have hzD : z ∈ D := hShD hz
      have hm0 : (0:ℝ) ≤ |φ e| := abs_nonneg _
      have hmpos : (0:ℝ) < |φ e| := by
        rcases hm0.lt_or_eq with h | h
        · exact h
        · exfalso
          refine hφ0 (ContinuousLinearMap.ext (fun y => ?_))
          have hy := hedom y
          rw [← h] at hy
          have hy0 : |φ y| ≤ 0 := by
            calc |φ y| ≤ κ * 0 * ‖y‖ := hy
              _ = 0 := by ring
          have hy1 : φ y = 0 := abs_nonpos_iff.mp hy0
          simp [hy1]
      have hopn : ‖φ‖ ≤ κ * |φ e| := by
        refine ContinuousLinearMap.opNorm_le_bound φ (mul_nonneg hκ0.le hm0) ?_
        intro y
        rw [Real.norm_eq_abs]
        exact hedom y
      refine Set.mem_iUnion₂.mpr ⟨e, heE, ?_⟩
      by_cases hsign : 0 ≤ φ e
      · have hme : |φ e| = φ e := abs_of_nonneg hsign
        refine Or.inl ⟨hzD, ?_⟩
        intro hmem
        have h1 := hφ (z + lam • e) hmem
        have h2 : φ (z + lam • e) - φ z = lam * |φ e| := by
          rw [map_add, map_smul, smul_eq_mul, hme]; ring
        rw [h2, hlamdef] at h1
        have h3 : ‖φ‖ * r ≤ κ * |φ e| * r := mul_le_mul_of_nonneg_right hopn hr.le
        nlinarith [mul_pos (mul_pos hκ0 hmpos) hr]
      · push_neg at hsign
        have hme : |φ e| = -φ e := abs_of_neg hsign
        refine Or.inr ⟨hzD, ?_⟩
        intro hmem
        have h1 := hφ (z + (-lam) • e) hmem
        have h2 : φ (z + (-lam) • e) - φ z = lam * |φ e| := by
          rw [map_add, map_smul, smul_eq_mul, hme]; ring
        rw [h2, hlamdef] at h1
        have h3 : ‖φ‖ * r ≤ κ * |φ e| * r := mul_le_mul_of_nonneg_right hopn hr.le
        nlinarith [mul_pos (mul_pos hκ0 hmpos) hr]
    have hAnn : (0:ℝ) ≤ 6 * κ * cB * 3 ^ n * X ^ n * (r / X) :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hκ0.le)
        hcB0.le) h3n) hXn0.le) hrXnn
    calc MeasureTheory.volume S
        ≤ MeasureTheory.volume (⋃ e ∈ E,
            ({y | y ∈ D ∧ y + lam • e ∉ D} ∪
             {y | y ∈ D ∧ y + (-lam) • e ∉ D})) :=
          MeasureTheory.measure_mono hcover
      _ ≤ ∑ e ∈ E, MeasureTheory.volume
            ({y | y ∈ D ∧ y + lam • e ∉ D} ∪
             {y | y ∈ D ∧ y + (-lam) • e ∉ D}) :=
          MeasureTheory.measure_biUnion_finset_le _ _
      _ ≤ ∑ _e ∈ E, (ENNReal.ofReal (6 * κ * cB * 3 ^ n * X ^ n * (r / X)) +
              ENNReal.ofReal (6 * κ * cB * 3 ^ n * X ^ n * (r / X))) := by
          refine Finset.sum_le_sum (fun e he => ?_)
          refine le_trans (MeasureTheory.measure_union_le _ _) (add_le_add ?_ ?_)
          · exact hL _ (hnormu e he lam (abs_of_pos hlam0))
          · exact hL _ (hnormu e he (-lam) (by rw [abs_neg]; exact abs_of_pos hlam0))
      _ = E.card • (ENNReal.ofReal (6 * κ * cB * 3 ^ n * X ^ n * (r / X)) +
              ENNReal.ofReal (6 * κ * cB * 3 ^ n * X ^ n * (r / X))) := Finset.sum_const _
      _ ≤ ENNReal.ofReal ((12 * (E.card : ℝ) * κ * cB * 3 ^ n + 3 * κ * cB * 2 ^ n + 1)
              * X ^ n * (r / X)) := by
          rw [← ENNReal.ofReal_add hAnn hAnn, nsmul_eq_mul,
            ← ENNReal.ofReal_natCast E.card,
            ← ENNReal.ofReal_mul (Nat.cast_nonneg _)]
          apply ENNReal.ofReal_le_ofReal
          have hc1 : 12 * (E.card : ℝ) * κ * cB * 3 ^ n
              ≤ 12 * (E.card : ℝ) * κ * cB * 3 ^ n + 3 * κ * cB * 2 ^ n + 1 := by linarith
          nlinarith [mul_le_mul_of_nonneg_right hc1 hPnn]
  · push_neg at hcase
    have hXlt : X < 3 * κ * r := by rw [← hlamdef]; exact hcase
    have hgt : (1:ℝ) < 3 * κ * (r / X) := by
      have he : 3 * κ * (r / X) = (3 * κ * r) / X := by ring
      rw [he, lt_div_iff₀ hX0, one_mul]
      exact hXlt
    have hsub : S ⊆
        Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) (2 * X) := by
      intro z hz
      rw [mem_closedBall_zero_iff]
      exact hDbound z (hShD hz)
    have h1 : MeasureTheory.volume S ≤ ENNReal.ofReal (cB * (2 * X) ^ n) :=
      le_trans (MeasureTheory.measure_mono hsub) (hballvol (2 * X) (by linarith))
    refine le_trans h1 (ENNReal.ofReal_le_ofReal ?_)
    have hP : (0:ℝ) ≤ cB * 2 ^ n * X ^ n :=
      mul_nonneg (mul_nonneg hcB0.le h2n) hXn0.le
    have hmul := mul_nonneg hP (by linarith : (0:ℝ) ≤ 3 * κ * (r / X) - 1)
    have hstep1 : cB * (2 * X) ^ n ≤ 3 * κ * cB * 2 ^ n * X ^ n * (r / X) := by
      rw [mul_pow]
      nlinarith [hmul]
    have hc2 : 3 * κ * cB * 2 ^ n
        ≤ 12 * (E.card : ℝ) * κ * cB * 3 ^ n + 3 * κ * cB * 2 ^ n + 1 := by linarith
    nlinarith [mul_le_mul_of_nonneg_right hc2 hPnn, hstep1]

theorem kai_cvx_lattice_count (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ dL cL : ℝ, 0 < dL ∧ 0 < cL ∧
      ∀ (S : Set (NumberField.mixedEmbedding.mixedSpace K)) (V : ℝ), 0 ≤ V →
        MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
            ∃ x ∈ S, ‖z - x‖ ≤ dL} ≤ ENNReal.ofReal V →
        {x : NumberField.RingOfIntegers K |
            NumberField.mixedEmbedding K (x : K) ∈ S}.Finite ∧
        (Nat.card {x : NumberField.RingOfIntegers K |
            NumberField.mixedEmbedding K (x : K) ∈ S} : ℝ) ≤ cL * V :=
by
  classical
  have hnormAt : ∀ (u : NumberField.mixedEmbedding.mixedSpace K)
      (w : NumberField.InfinitePlace K), NumberField.mixedEmbedding.normAtPlace w u ≤ ‖u‖ := by
    intro u w
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw]
      exact le_trans (norm_le_pi_norm u.1 ⟨w, hw⟩) (by rw [Prod.norm_def]; exact le_max_left _ _)
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw]
      exact le_trans (norm_le_pi_norm u.2 ⟨w, hw⟩) (by rw [Prod.norm_def]; exact le_max_right _ _)
  have hsep : ∀ x y : NumberField.RingOfIntegers K, x ≠ y →
      1 ≤ ‖NumberField.mixedEmbedding K (x : K) - NumberField.mixedEmbedding K (y : K)‖ := by
    intro x y hxy
    have hz0 : x - y ≠ 0 := sub_ne_zero.mpr hxy
    have hmap : NumberField.mixedEmbedding K (x : K) - NumberField.mixedEmbedding K (y : K)
        = NumberField.mixedEmbedding K ((x - y : NumberField.RingOfIntegers K) : K) := by
      push_cast
      rw [map_sub]
    rw [hmap]
    set z : K := ((x - y : NumberField.RingOfIntegers K) : K) with hzdef
    set M : ℝ := ‖NumberField.mixedEmbedding K z‖ with hMdef
    have hM0 : (0:ℝ) ≤ M := norm_nonneg _
    have ha : ∀ w : NumberField.InfinitePlace K, w z ≤ M := by
      intro w
      rw [← NumberField.mixedEmbedding.normAtPlace_apply w z]
      exact hnormAt _ w
    have hnz : Algebra.norm ℤ (x - y : NumberField.RingOfIntegers K) ≠ 0 := by
      simpa [Algebra.norm_eq_zero_iff] using hz0
    have hb1 : (1:ℤ) ≤ |Algebra.norm ℤ (x - y : NumberField.RingOfIntegers K)| :=
      Int.one_le_abs hnz
    have hbQ : ((Algebra.norm ℤ (x - y : NumberField.RingOfIntegers K) : ℤ) : ℚ)
        = Algebra.norm ℚ z := by
      rw [hzdef]; exact Algebra.coe_norm_int _
    have hb : (1:ℝ) ≤ |(Algebra.norm ℚ z : ℚ)| := by
      rw [← hbQ]
      exact_mod_cast hb1
    have hprodeq : ∏ w : NumberField.InfinitePlace K, w z ^ w.mult
        = |(Algebra.norm ℚ z : ℚ)| := NumberField.InfinitePlace.prod_eq_abs_norm z
    have hb2 : (1:ℝ) ≤ ∏ w : NumberField.InfinitePlace K, w z ^ w.mult := by
      rw [hprodeq]; exact hb
    have hle : ∏ w : NumberField.InfinitePlace K, w z ^ w.mult
        ≤ ∏ w : NumberField.InfinitePlace K, M ^ w.mult :=
      Finset.prod_le_prod (fun w _ => pow_nonneg (AbsoluteValue.nonneg _ _) _)
        (fun w _ => pow_le_pow_left₀ (AbsoluteValue.nonneg _ _) (ha w) _)
    have hpow : ∏ w : NumberField.InfinitePlace K, M ^ w.mult
        = M ^ (∑ w : NumberField.InfinitePlace K, w.mult) := Finset.prod_pow_eq_pow_sum _ _ _
    rw [NumberField.InfinitePlace.sum_mult_eq] at hpow
    have hn : 0 < Module.finrank ℚ K := Module.finrank_pos
    by_contra hcon
    push_neg at hcon
    have hlt1 : M ^ (Module.finrank ℚ K) < 1 := pow_lt_one₀ hM0 hcon hn.ne'
    rw [← hpow] at hlt1
    linarith
  have hinj : Function.Injective
      (fun x : NumberField.RingOfIntegers K => NumberField.mixedEmbedding K (x : K)) := by
    intro x y hxy
    by_contra hne
    have h1 := hsep x y hne
    simp only at hxy
    rw [hxy, sub_self, norm_zero] at h1
    linarith
  obtain ⟨v, hv, hball⟩ : ∃ v : ℝ, 0 < v ∧
      ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        MeasureTheory.volume (Metric.closedBall z (1/3 : ℝ)) = ENNReal.ofReal v := by
    have hr : (0:ℝ) < 1/3 := by norm_num
    set c : ENNReal :=
      ENNReal.ofReal (2 * (1/3 : ℝ)) ^ (Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
        * (ENNReal.ofReal (1/3 : ℝ) ^ 2 * (NNReal.pi : ENNReal))
          ^ (Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}) with hcdef
    have h2r : ENNReal.ofReal (2 * (1/3 : ℝ)) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero]; push_neg; norm_num
    have hrr : ENNReal.ofReal (1/3 : ℝ) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero]; push_neg; norm_num
    have hpi : (NNReal.pi : ENNReal) ≠ 0 := by
      rw [Ne, ENNReal.coe_eq_zero, ← NNReal.coe_eq_zero, NNReal.coe_real_pi]
      exact Real.pi_ne_zero
    have hc0 : c ≠ 0 := by
      rw [hcdef]
      exact mul_ne_zero (pow_ne_zero _ h2r)
        (pow_ne_zero _ (mul_ne_zero (pow_ne_zero _ hrr) hpi))
    have hctop : c ≠ ⊤ := by
      rw [hcdef]
      refine ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) ?_
      exact ENNReal.pow_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
        ENNReal.coe_ne_top)
    refine ⟨c.toReal, ENNReal.toReal_pos hc0 hctop, ?_⟩
    intro z
    rw [ENNReal.ofReal_toReal hctop, hcdef]
    rw [← closedBall_prod_same z.1 z.2 (1/3 : ℝ), MeasureTheory.Measure.volume_eq_prod,
      MeasureTheory.Measure.prod_prod]
    rw [closedBall_pi _ hr.le, closedBall_pi _ hr.le,
      MeasureTheory.volume_pi_pi, MeasureTheory.volume_pi_pi]
    simp only [Real.volume_closedBall, Complex.volume_closedBall, Finset.prod_const,
      Finset.card_univ]
  refine ⟨1/3, 1/v, by norm_num, one_div_pos.mpr hv, ?_⟩
  intro S V hV hS
  have key : ∀ T : Finset (NumberField.RingOfIntegers K),
      (∀ x ∈ T, NumberField.mixedEmbedding K (x : K) ∈ S) → (T.card : ℝ) ≤ (1/v) * V := by
    intro T hT
    set F : Finset (NumberField.mixedEmbedding.mixedSpace K) :=
      T.image (fun x : NumberField.RingOfIntegers K =>
        NumberField.mixedEmbedding K (x : K)) with hFdef
    have hFcard : F.card = T.card := Finset.card_image_of_injective T hinj
    have hdisj : (↑F : Set (NumberField.mixedEmbedding.mixedSpace K)).PairwiseDisjoint
        (fun p => Metric.closedBall p (1/3 : ℝ)) := by
      intro p hp p' hp' hne
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hp)
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hp')
      have hab : a ≠ b := by
        intro h; exact hne (by rw [h])
      have hnorm : 1 ≤ ‖NumberField.mixedEmbedding K (a : K)
          - NumberField.mixedEmbedding K (b : K)‖ := hsep a b hab
      simp only [Function.onFun]
      refine Metric.closedBall_disjoint_closedBall ?_
      rw [dist_eq_norm]
      linarith
    have hmeas : ∀ p ∈ F, MeasurableSet (Metric.closedBall p (1/3 : ℝ)) :=
      fun p _ => measurableSet_closedBall
    have hsub : (⋃ p ∈ F, Metric.closedBall p (1/3 : ℝ)) ⊆
        {z : NumberField.mixedEmbedding.mixedSpace K | ∃ x ∈ S, ‖z - x‖ ≤ (1/3 : ℝ)} := by
      refine Set.iUnion₂_subset (fun p hp => ?_)
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hp
      intro u hu
      rw [Metric.mem_closedBall, dist_eq_norm] at hu
      exact ⟨NumberField.mixedEmbedding K (a : K), hT a ha, hu⟩
    have hle1 : ∑ p ∈ F, MeasureTheory.volume (Metric.closedBall p (1/3 : ℝ))
        ≤ ENNReal.ofReal V := by
      rw [← MeasureTheory.measure_biUnion_finset hdisj hmeas]
      exact le_trans (MeasureTheory.measure_mono hsub) hS
    have hsum : ∑ p ∈ F, MeasureTheory.volume (Metric.closedBall p (1/3 : ℝ))
        = ENNReal.ofReal ((F.card : ℝ) * v) := by
      simp only [hball, Finset.sum_const, nsmul_eq_mul]
      rw [ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
    rw [hsum] at hle1
    have hle2 : (F.card : ℝ) * v ≤ V := (ENNReal.ofReal_le_ofReal_iff hV).mp hle1
    rw [← hFcard]
    have hdiv : (F.card : ℝ) ≤ V / v := by rw [le_div_iff₀ hv]; exact hle2
    calc (F.card : ℝ) ≤ V / v := hdiv
      _ = (1/v) * V := by ring
  have hfin : {x : NumberField.RingOfIntegers K |
      NumberField.mixedEmbedding K (x : K) ∈ S}.Finite := by
    by_contra hnf
    have hinf : Set.Infinite {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ S} := hnf
    obtain ⟨T, hTsub, hTcard⟩ := hinf.exists_subset_card_eq (⌊(1/v) * V⌋₊ + 1)
    have hkey := key T (fun x hx => hTsub (Finset.mem_coe.mpr hx))
    rw [hTcard] at hkey
    have hlt := Nat.lt_floor_add_one ((1/v) * V)
    push_cast at hkey
    linarith
  refine ⟨hfin, ?_⟩
  rw [Nat.card_eq_card_finite_toFinset hfin]
  exact key hfin.toFinset (fun x hx => hfin.mem_toFinset.mp hx)

theorem kai_cvx_psi_basic (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (q : Ideal (NumberField.RingOfIntegers K)) (α : NumberField.RingOfIntegers K)
    (B : ℝ) (hB : 1 ≤ B) :
    (∀ (m : ℕ) (I : Finset (Fin m))
         (S : Fin m → Set (NumberField.mixedEmbedding.mixedSpace K)),
        (∀ z ∈ (⋃ i ∈ I, S i), ∀ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w z < B) →
        (∀ i ∈ I, ∀ j ∈ I, i ≠ j → Disjoint (S i) (S j)) →
        kaiPrimePsi K q α (⋃ i ∈ I, S i) = ∑ i ∈ I, kaiPrimePsi K q α (S i)) ∧
    (∀ S T : Set (NumberField.mixedEmbedding.mixedSpace K), S ⊆ T →
        (∀ z ∈ T, ∀ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w z < B) →
        kaiPrimePsi K q α S ≤ kaiPrimePsi K q α T ∧
        kaiPrimePsi K q α T - kaiPrimePsi K q α S
          ≤ (Module.finrank ℚ K : ℝ) * Real.log B *
              (Nat.card {x : NumberField.RingOfIntegers K |
                  Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ T \ S} : ℝ)) :=
by
  classical
  have hNorth : {x : NumberField.RingOfIntegers K |
      ∀ w : NumberField.InfinitePlace K, w (x : K) < B}.Finite := by
    have himg : (fun x : NumberField.RingOfIntegers K => (x : K)) ''
        {x : NumberField.RingOfIntegers K |
          ∀ w : NumberField.InfinitePlace K, w (x : K) < B}
        ⊆ {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ B} := by
      rintro _ ⟨x, hx, rfl⟩
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      have hxw := hx (NumberField.InfinitePlace.mk φ)
      rw [NumberField.InfinitePlace.apply] at hxw
      exact hxw.le
    have hfinimg := (NumberField.Embeddings.finite_of_norm_le K ℂ B).subset himg
    exact Set.Finite.of_finite_image hfinimg
      (Set.injOn_of_injective NumberField.RingOfIntegers.coe_injective)
  have hlogbd : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 →
      (∀ w : NumberField.InfinitePlace K, w (x : K) < B) →
      Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
        ≤ (Module.finrank ℚ K : ℝ) * Real.log B := by
    intro x hx hplace
    have hN : ((Algebra.norm ℤ x).natAbs : ℝ)
        = ∏ w : NumberField.InfinitePlace K, (w (x : K)) ^ w.mult := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm (x : K), ← Algebra.coe_norm_int x]
      push_cast
      rw [Nat.cast_natAbs, Int.cast_abs]
    have hprod : ∏ w : NumberField.InfinitePlace K, (w (x : K)) ^ w.mult
        ≤ ∏ w : NumberField.InfinitePlace K, B ^ w.mult :=
      Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg _ _) _)
        (fun w _ => pow_le_pow_left₀ (apply_nonneg _ _) (hplace w).le _)
    have hcollapse : ∏ _w : NumberField.InfinitePlace K, B ^ (_w.mult)
        = B ^ (Module.finrank ℚ K) := by
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    have hpos : (0 : ℝ) < ((Algebra.norm ℤ x).natAbs : ℝ) := by
      have h0 : Algebra.norm ℤ x ≠ 0 := by
        simpa [Algebra.norm_eq_zero_iff] using hx
      have h1 : 0 < (Algebra.norm ℤ x).natAbs := Int.natAbs_pos.mpr h0
      exact_mod_cast h1
    have hle : ((Algebra.norm ℤ x).natAbs : ℝ) ≤ B ^ (Module.finrank ℚ K) := by
      rw [hN, ← hcollapse]; exact hprod
    calc Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
        ≤ Real.log (B ^ (Module.finrank ℚ K)) := Real.log_le_log hpos hle
      _ = (Module.finrank ℚ K : ℝ) * Real.log B := Real.log_pow _ _
  have hpsiF : ∀ (S : Set (NumberField.mixedEmbedding.mixedSpace K))
      (F : Finset (NumberField.RingOfIntegers K)),
      (∀ x : NumberField.RingOfIntegers K, x ∈ F ↔
        (Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ S ∧ x - α ∈ q)) →
      kaiPrimePsi K q α S = ∑ x ∈ F, Real.log ((Algebra.norm ℤ x).natAbs : ℝ) := by
    intro S F hF
    have hrfl : kaiPrimePsi K q α S
        = ∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) := rfl
    rw [hrfl]
    haveI : Fintype {π : NumberField.RingOfIntegers K //
        Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q} :=
      Fintype.ofFinset F (fun x => hF x)
    rw [tsum_fintype]
    exact (Finset.sum_subtype F hF
      (fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ))).symm
  obtain ⟨Fi, hFi⟩ :
      ∃ Fi : Set (NumberField.mixedEmbedding.mixedSpace K) →
          Finset (NumberField.RingOfIntegers K),
        ∀ (S : Set (NumberField.mixedEmbedding.mixedSpace K))
          (x : NumberField.RingOfIntegers K),
          x ∈ Fi S ↔ (x ∈ hNorth.toFinset ∧
            (Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ S ∧ x - α ∈ q)) :=
    ⟨fun S => hNorth.toFinset.filter
        (fun x => Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ S ∧ x - α ∈ q),
      fun S x => Finset.mem_filter⟩
  have hboxmem : ∀ S : Set (NumberField.mixedEmbedding.mixedSpace K),
      (∀ z ∈ S, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B) →
      ∀ x : NumberField.RingOfIntegers K, x ∈ Fi S ↔
        (Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ S ∧ x - α ∈ q) := by
    intro S hS x
    rw [hFi S x]
    refine ⟨fun h => h.2, fun h => ⟨?_, h⟩⟩
    rw [Set.Finite.mem_toFinset]
    intro w
    have hz := hS _ h.2.1 w
    rwa [NumberField.mixedEmbedding.normAtPlace_apply] at hz
  have hPsiEq : ∀ S : Set (NumberField.mixedEmbedding.mixedSpace K),
      (∀ z ∈ S, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B) →
      kaiPrimePsi K q α S = ∑ x ∈ Fi S, Real.log ((Algebra.norm ℤ x).natAbs : ℝ) :=
    fun S hS => hpsiF S (Fi S) (hboxmem S hS)
  have hnn : ∀ x : NumberField.RingOfIntegers K,
      0 ≤ Real.log ((Algebra.norm ℤ x).natAbs : ℝ) :=
    fun x => Real.log_natCast_nonneg _
  constructor
  · intro m I S hbox hdisj
    have hboxi : ∀ i ∈ I, ∀ z ∈ S i, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B :=
      fun i hi z hz w => hbox z (Set.subset_iUnion₂ i hi hz) w
    have hbiU : Fi (⋃ i ∈ I, S i) = I.biUnion (fun i => Fi (S i)) := by
      ext x
      rw [Finset.mem_biUnion, hFi]
      constructor
      · rintro ⟨hx1, hp, hxU, hxq⟩
        rw [Set.mem_iUnion₂] at hxU
        obtain ⟨i, hi, hxi⟩ := hxU
        exact ⟨i, hi, (hFi (S i) x).mpr ⟨hx1, hp, hxi, hxq⟩⟩
      · rintro ⟨i, hi, hxi⟩
        rw [hFi] at hxi
        obtain ⟨hx1, hp, hxSi, hxq⟩ := hxi
        exact ⟨hx1, hp, Set.mem_iUnion₂.mpr ⟨i, hi, hxSi⟩, hxq⟩
    have hpd : (↑I : Set (Fin m)).PairwiseDisjoint (fun i => Fi (S i)) := by
      intro i hi j hj hij
      simp only [Function.onFun]
      rw [Finset.disjoint_left]
      intro x hxi hxj
      rw [hFi] at hxi
      rw [hFi] at hxj
      exact Set.disjoint_left.mp
        (hdisj i (Finset.mem_coe.mp hi) j (Finset.mem_coe.mp hj) hij)
        hxi.2.2.1 hxj.2.2.1
    rw [hPsiEq _ hbox, hbiU, Finset.sum_biUnion hpd]
    exact Finset.sum_congr rfl (fun i hi => (hPsiEq (S i) (hboxi i hi)).symm)
  · intro S T hST hboxT
    have hboxS : ∀ z ∈ S, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B := fun z hz w => hboxT z (hST hz) w
    have hsub : Fi S ⊆ Fi T := by
      intro x hx
      rw [hFi] at hx ⊢
      exact ⟨hx.1, hx.2.1, hST hx.2.2.1, hx.2.2.2⟩
    have hmono : kaiPrimePsi K q α S ≤ kaiPrimePsi K q α T := by
      rw [hPsiEq S hboxS, hPsiEq T hboxT]
      exact Finset.sum_le_sum_of_subset_of_nonneg hsub (fun i _ _ => hnn i)
    refine ⟨hmono, ?_⟩
    have hdiff : kaiPrimePsi K q α T - kaiPrimePsi K q α S
        = ∑ x ∈ Fi T \ Fi S, Real.log ((Algebra.norm ℤ x).natAbs : ℝ) := by
      rw [hPsiEq S hboxS, hPsiEq T hboxT, Finset.sum_sdiff_eq_sub hsub]
    have hGfin : {x : NumberField.RingOfIntegers K |
        Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ T \ S}.Finite := by
      refine hNorth.subset ?_
      rintro x ⟨-, hxT, -⟩
      intro w
      have hz := hboxT _ hxT w
      rwa [NumberField.mixedEmbedding.normAtPlace_apply] at hz
    have hDsub : (↑(Fi T \ Fi S) : Set (NumberField.RingOfIntegers K)) ⊆
        {x : NumberField.RingOfIntegers K |
          Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ T \ S} := by
      intro x hx
      rw [Finset.mem_coe, Finset.mem_sdiff, hFi, hFi] at hx
      obtain ⟨⟨hx1, hp, hxT, hxq⟩, hns⟩ := hx
      exact ⟨hp, hxT, fun hxS => hns ⟨hx1, hp, hxS, hxq⟩⟩
    have hcardD : ((Fi T \ Fi S).card : ℝ)
        ≤ (Nat.card {x : NumberField.RingOfIntegers K |
            Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ T \ S} : ℝ) := by
      have h1 := Nat.card_mono hGfin hDsub
      have h2 : Nat.card (↑(Fi T \ Fi S) : Set (NumberField.RingOfIntegers K))
          = (Fi T \ Fi S).card := by
        rw [Finset.coe_sort_coe, Nat.card_eq_finsetCard]
      rw [h2] at h1
      exact_mod_cast h1
    have hterm : ∀ x ∈ Fi T \ Fi S, Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
        ≤ (Module.finrank ℚ K : ℝ) * Real.log B := by
      intro x hx
      rw [Finset.mem_sdiff, hFi] at hx
      obtain ⟨⟨-, hp, hxT, -⟩, -⟩ := hx
      refine hlogbd x hp.ne_zero (fun w => ?_)
      have hz := hboxT _ hxT w
      rwa [NumberField.mixedEmbedding.normAtPlace_apply] at hz
    have hsumle : ∑ x ∈ Fi T \ Fi S, Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
        ≤ ((Fi T \ Fi S).card : ℝ) * ((Module.finrank ℚ K : ℝ) * Real.log B) := by
      have h := Finset.sum_le_card_nsmul (Fi T \ Fi S)
        (fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ))
        ((Module.finrank ℚ K : ℝ) * Real.log B) hterm
      simpa [nsmul_eq_mul] using h
    have hnnc : (0 : ℝ) ≤ (Module.finrank ℚ K : ℝ) * Real.log B :=
      mul_nonneg (Nat.cast_nonneg _) (Real.log_nonneg hB)
    calc kaiPrimePsi K q α T - kaiPrimePsi K q α S
        = ∑ x ∈ Fi T \ Fi S, Real.log ((Algebra.norm ℤ x).natAbs : ℝ) := hdiff
      _ ≤ ((Fi T \ Fi S).card : ℝ) * ((Module.finrank ℚ K : ℝ) * Real.log B) := hsumle
      _ ≤ (Nat.card {x : NumberField.RingOfIntegers K |
              Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ T \ S} : ℝ) *
            ((Module.finrank ℚ K : ℝ) * Real.log B) :=
          mul_le_mul_of_nonneg_right hcardD hnnc
      _ = (Module.finrank ℚ K : ℝ) * Real.log B *
            (Nat.card {x : NumberField.RingOfIntegers K |
              Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ T \ S} : ℝ) := by ring

theorem kai_cvx_trivial_bounds (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (B : ℝ) :
    ∃ MΨ V : ℝ, 0 ≤ MΨ ∧ 0 ≤ V ∧
      ∀ S : Set (NumberField.mixedEmbedding.mixedSpace K),
        (∀ z ∈ S, ∀ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w z < B) →
        (MeasureTheory.volume S).toReal ≤ V ∧
          ∀ (q : Ideal (NumberField.RingOfIntegers K))
            (α : NumberField.RingOfIntegers K),
            0 ≤ kaiPrimePsi K q α S ∧ kaiPrimePsi K q α S ≤ MΨ :=
by
  classical
  have hfin : {x : NumberField.RingOfIntegers K |
      ∀ w : NumberField.InfinitePlace K, w (x : K) < B}.Finite := by
    refine Set.Finite.of_finite_image
      (f := fun x : NumberField.RingOfIntegers K => (x : K)) ?_ ?_
    · refine Set.Finite.subset (NumberField.Embeddings.finite_of_norm_le K ℂ B) ?_
      rintro y ⟨x, hx, rfl⟩
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      have h := hx (NumberField.InfinitePlace.mk φ)
      rw [NumberField.InfinitePlace.apply] at h
      exact h.le
    · intro a _ b _ hab
      exact NumberField.RingOfIntegers.coe_injective hab
  obtain ⟨T, hT⟩ : ∃ T : Finset (NumberField.RingOfIntegers K),
      ∀ x : NumberField.RingOfIntegers K,
        (∀ w : NumberField.InfinitePlace K, w (x : K) < B) → x ∈ T :=
    ⟨hfin.toFinset, fun x hx => hfin.mem_toFinset.mpr hx⟩
  have hbox : MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B} ≠ ⊤ := by
    have hsub : {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < B}
        ⊆ Metric.closedBall (0 : NumberField.mixedEmbedding.mixedSpace K) (max B 0) := by
      intro z hz
      rw [mem_closedBall_zero_iff, Prod.norm_def]
      refine max_le ?_ ?_
      · refine (pi_norm_le_iff_of_nonneg (le_max_right B 0)).mpr (fun i => ?_)
        have h1 : ‖z.1 i‖ = NumberField.mixedEmbedding.normAtPlace i.1 z :=
          (NumberField.mixedEmbedding.normAtPlace_apply_of_isReal i.2 z).symm
        rw [h1]
        exact le_trans (hz i.1).le (le_max_left B 0)
      · refine (pi_norm_le_iff_of_nonneg (le_max_right B 0)).mpr (fun i => ?_)
        have h1 : ‖z.2 i‖ = NumberField.mixedEmbedding.normAtPlace i.1 z :=
          (NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex i.2 z).symm
        rw [h1]
        exact le_trans (hz i.1).le (le_max_left B 0)
    exact (lt_of_le_of_lt (MeasureTheory.measure_mono hsub)
      MeasureTheory.measure_closedBall_lt_top).ne
  refine ⟨∑ x ∈ T, Real.log ((Algebra.norm ℤ x).natAbs : ℝ),
    (MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B}).toReal,
    Finset.sum_nonneg (fun x _ => Real.log_natCast_nonneg _), ENNReal.toReal_nonneg, ?_⟩
  intro S hS
  have hSsub : S ⊆ {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < B} := fun z hz => hS z hz
  refine ⟨ENNReal.toReal_mono hbox (MeasureTheory.measure_mono hSsub), ?_⟩
  have hcap : ∀ x : NumberField.RingOfIntegers K,
      NumberField.mixedEmbedding K (x : K) ∈ S → x ∈ T := by
    intro x hx
    refine hT x (fun w => ?_)
    have h := hS _ hx w
    rwa [NumberField.mixedEmbedding.normAtPlace_apply] at h
  intro q α
  have hPsi : kaiPrimePsi K q α S = ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q},
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) := rfl
  rw [hPsi]
  refine ⟨tsum_nonneg (fun i => Real.log_natCast_nonneg _), ?_⟩
  refine tsum_le_of_sum_le'
    (Finset.sum_nonneg (fun x _ => Real.log_natCast_nonneg _)) (fun s => ?_)
  have hinj : Set.InjOn (fun i : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q} =>
      (i : NumberField.RingOfIntegers K)) ↑s := fun a _ b _ hab => Subtype.coe_injective hab
  have hsi : ∑ i ∈ s, Real.log ((Algebra.norm ℤ (i : NumberField.RingOfIntegers K)).natAbs : ℝ)
      = ∑ x ∈ Finset.image (fun i : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ S ∧ π - α ∈ q} =>
          (i : NumberField.RingOfIntegers K)) s,
        Real.log ((Algebra.norm ℤ x).natAbs : ℝ) :=
    (Finset.sum_image (f := fun x : NumberField.RingOfIntegers K =>
      Real.log ((Algebra.norm ℤ x).natAbs : ℝ)) hinj).symm
  rw [hsi]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun x _ _ => Real.log_natCast_nonneg _)
  intro x hx
  simp only [Finset.mem_image] at hx
  obtain ⟨i, -, rfl⟩ := hx
  exact hcap _ i.2.2.1

theorem kai_norm_rpow_box_bound (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ CW : ℝ, 0 ≤ CW ∧
      ∀ X γ : ℝ, 1 ≤ X → -(1 / 2) ≤ γ → γ ≤ 0 →
        MeasureTheory.IntegrableOn
            (fun z : NumberField.mixedEmbedding.mixedSpace K =>
              (NumberField.mixedEmbedding.norm z) ^ γ)
            {z : NumberField.mixedEmbedding.mixedSpace K |
              ∀ w : NumberField.InfinitePlace K,
                NumberField.mixedEmbedding.normAtPlace w z < X} ∧
        ∀ S : Set (NumberField.mixedEmbedding.mixedSpace K), MeasurableSet S →
          S ⊆ {z : NumberField.mixedEmbedding.mixedSpace K |
              ∀ w : NumberField.InfinitePlace K,
                NumberField.mixedEmbedding.normAtPlace w z < X} →
          ∫ z in S, (NumberField.mixedEmbedding.norm z) ^ γ
            ≤ (MeasureTheory.volume S).toReal
              + CW * X ^ ((Module.finrank ℚ K : ℝ) / 2) :=
by
  classical
  
  have t_real : ∀ X : ℝ, 0 < X →
      ∫ x in Set.Ioo (-X) X, |x| ^ (-(1 / 2 : ℝ)) = 4 * X ^ ((1 : ℝ) / 2) := by
    intro X hX
    have hr : (-1:ℝ) < -(1/2) := by norm_num
    have hpos : ∫ x in (0:ℝ)..X, |x| ^ (-(1/2:ℝ)) = 2 * X ^ ((1:ℝ)/2) := by
      rw [intervalIntegral.integral_congr (g := fun y => y ^ (-(1/2:ℝ))) (fun y hy => ?_)]
      · rw [integral_rpow (Or.inl hr), Real.zero_rpow (by norm_num)]
        rw [show (-(1/2:ℝ)) + 1 = (1:ℝ)/2 by norm_num]
        ring
      · rw [Set.uIcc_of_le hX.le] at hy
        simp only
        rw [abs_of_nonneg hy.1]
    have hneg : ∫ x in (-X)..0, |x| ^ (-(1/2:ℝ)) = 2 * X ^ ((1:ℝ)/2) := by
      have h2 := intervalIntegral.integral_comp_neg (a := -X) (b := 0)
        (fun y => |y| ^ (-(1/2:ℝ)))
      simp only [abs_neg, neg_neg, neg_zero] at h2
      rw [h2, hpos]
    have hne : 2 * X ^ ((1:ℝ)/2) ≠ 0 := by positivity
    have hi1 : IntervalIntegrable (fun x : ℝ => |x| ^ (-(1/2:ℝ)))
        MeasureTheory.volume (-X) 0 := by
      by_contra h
      exact hne (hneg ▸ intervalIntegral.integral_undef h)
    have hi2 : IntervalIntegrable (fun x : ℝ => |x| ^ (-(1/2:ℝ)))
        MeasureTheory.volume 0 X := by
      by_contra h
      exact hne (hpos ▸ intervalIntegral.integral_undef h)
    rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo,
      ← intervalIntegral.integral_of_le (by linarith),
      ← intervalIntegral.integral_add_adjacent_intervals hi1 hi2, hneg, hpos]
    ring
  
  have t_cplx : ∀ X : ℝ, 0 < X →
      ∫ c in {c : ℂ | ‖c‖ < X}, (‖c‖ ^ 2) ^ (-(1 / 2 : ℝ)) = 2 * Real.pi * X := by
    intro X hX
    have hSmeas : MeasurableSet {c : ℂ | ‖c‖ < X} :=
      measurableSet_lt measurable_norm measurable_const
    have hTmeas : MeasurableSet (Set.Ioo 0 X ×ˢ Set.Ioo (-Real.pi) Real.pi) :=
      measurableSet_Ioo.prod measurableSet_Ioo
    have htgt : MeasurableSet polarCoord.target := by
      rw [polarCoord_target]; exact measurableSet_Ioi.prod measurableSet_Ioo
    rw [← MeasureTheory.integral_indicator hSmeas,
      ← Complex.integral_comp_polarCoord_symm]
    have hEq : Set.EqOn
        (fun p : ℝ × ℝ => p.1 •
          ({c : ℂ | ‖c‖ < X}.indicator
            (fun c : ℂ => (‖c‖ ^ 2) ^ (-(1 / 2 : ℝ)))) (Complex.polarCoord.symm p))
        (fun p : ℝ × ℝ =>
          (Set.Ioo 0 X ×ˢ Set.Ioo (-Real.pi) Real.pi).indicator
            (fun q : ℝ × ℝ => q.1 * (q.1 ^ 2) ^ (-(1 / 2 : ℝ))) p)
        polarCoord.target := by
      intro p hp
      have hp' : p ∈ Complex.polarCoord.target := by
        rw [Complex.polarCoord_target]
        rw [polarCoord_target] at hp
        exact hp
      have hinv := Complex.polarCoord.right_inv hp'
      rw [Complex.polarCoord_apply] at hinv
      have h1 : ‖Complex.polarCoord.symm p‖ = p.1 := congrArg Prod.fst hinv
      rw [polarCoord_target] at hp
      have hiff : (Complex.polarCoord.symm p ∈ {c : ℂ | ‖c‖ < X})
          ↔ p ∈ Set.Ioo 0 X ×ˢ Set.Ioo (-Real.pi) Real.pi := by
        simp only [Set.mem_setOf_eq, h1, Set.mem_prod, Set.mem_Ioo]
        simp only [Set.mem_prod, Set.mem_Ioi, Set.mem_Ioo] at hp
        constructor
        · intro h; exact ⟨⟨hp.1, h⟩, hp.2⟩
        · intro h; exact h.1.2
      by_cases hmem : p ∈ Set.Ioo 0 X ×ˢ Set.Ioo (-Real.pi) Real.pi
      · simp only [Set.indicator_of_mem (hiff.mpr hmem), Set.indicator_of_mem hmem, h1,
          smul_eq_mul]
      · simp only [Set.indicator_of_notMem (fun h => hmem (hiff.mp h)),
          Set.indicator_of_notMem hmem, smul_eq_mul, mul_zero]
    rw [MeasureTheory.setIntegral_congr_fun htgt hEq,
      MeasureTheory.setIntegral_indicator hTmeas]
    have hint : polarCoord.target ∩ (Set.Ioo 0 X ×ˢ Set.Ioo (-Real.pi) Real.pi)
        = Set.Ioo 0 X ×ˢ Set.Ioo (-Real.pi) Real.pi := by
      rw [polarCoord_target]
      apply Set.inter_eq_self_of_subset_right
      intro p hp
      exact ⟨hp.1.1, hp.2⟩
    rw [hint, MeasureTheory.Measure.volume_eq_prod ℝ ℝ]
    have hP := MeasureTheory.setIntegral_prod_mul
      (μ := (MeasureTheory.volume : MeasureTheory.Measure ℝ))
      (ν := (MeasureTheory.volume : MeasureTheory.Measure ℝ))
      (fun r : ℝ => r * (r ^ 2) ^ (-(1 / 2 : ℝ))) (fun _ : ℝ => (1 : ℝ)) (Set.Ioo 0 X)
      (Set.Ioo (-Real.pi) Real.pi)
    simp only [mul_one] at hP
    rw [hP]
    have hang : ∫ y in Set.Ioo (-Real.pi) Real.pi, (1 : ℝ) = 2 * Real.pi := by
      rw [MeasureTheory.setIntegral_const, smul_eq_mul, mul_one, MeasureTheory.measureReal_def,
        Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith [Real.pi_pos])]
      ring
    have hrad : ∫ r in Set.Ioo 0 X, r * (r ^ 2) ^ (-(1 / 2 : ℝ)) = X := by
      rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioo (g := fun _ => (1:ℝ))
        (fun r hr => ?_)]
      · rw [MeasureTheory.setIntegral_const, smul_eq_mul, mul_one, MeasureTheory.measureReal_def,
          Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith)]
        ring
      · have hr0 : 0 < r := hr.1
        simp only
        rw [← Real.rpow_natCast, ← Real.rpow_mul hr0.le,
          show ((2:ℕ):ℝ) * (-(1/2:ℝ)) = -1 by norm_num, Real.rpow_neg_one,
          mul_inv_cancel₀ hr0.ne']
    rw [hang, hrad]
    ring
  
  have s4 : ∀ t γ : ℝ, 0 ≤ t → -(1 / 2) ≤ γ → γ ≤ 0 → t ^ γ ≤ 1 + t ^ (-(1 / 2 : ℝ)) := by
    intro t γ ht h1 h2
    rcases ht.eq_or_lt with h0 | h0
    · subst h0
      rw [Real.zero_rpow (by norm_num : (-(1 / 2 : ℝ)) ≠ 0)]
      linarith [Real.zero_rpow_le_one γ]
    · rcases le_or_gt 1 t with ht1 | ht1
      · have e1 := Real.rpow_le_one_of_one_le_of_nonpos ht1 h2
        have e2 := Real.rpow_nonneg ht (-(1 / 2 : ℝ))
        linarith
      · have e1 := Real.rpow_le_rpow_of_exponent_ge h0 ht1.le h1
        linarith
  
  have hsplitP : ∀ F : NumberField.InfinitePlace K → ℝ,
      (∏ v : NumberField.InfinitePlace K, F v)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              F (w : NumberField.InfinitePlace K))
          * ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              F (p : NumberField.InfinitePlace K) := by
    intro F
    rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
        (fun v : NumberField.InfinitePlace K => v.IsReal) F]
    congr 1
    · exact Finset.prod_subtype _ (fun v => by simp) F
    · exact Finset.prod_subtype _
        (fun v => by simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]) F
  
  have hnorm : ∀ (r : ℝ) (z : NumberField.mixedEmbedding.mixedSpace K),
      NumberField.mixedEmbedding.norm z ^ r
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, |z.1 w| ^ r) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (‖z.2 p‖ ^ 2) ^ r := by
    intro r z
    rw [NumberField.mixedEmbedding.norm_apply, hsplitP]
    have hR : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        NumberField.mixedEmbedding.normAtPlace (w : NumberField.InfinitePlace K) z
          ^ (w : NumberField.InfinitePlace K).mult = |z.1 w| := by
      intro w
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2,
        NumberField.InfinitePlace.mult_isReal, pow_one, Real.norm_eq_abs]
    have hC : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        NumberField.mixedEmbedding.normAtPlace (p : NumberField.InfinitePlace K) z
          ^ (p : NumberField.InfinitePlace K).mult = ‖z.2 p‖ ^ 2 := by
      intro p
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex p.2,
        NumberField.InfinitePlace.mult_isComplex]
    rw [Finset.prod_congr rfl (fun w _ => hR w), Finset.prod_congr rfl (fun p _ => hC p),
      Real.mul_rpow (Finset.prod_nonneg fun _ _ => abs_nonneg _)
        (Finset.prod_nonneg fun _ _ => by positivity),
      ← Real.finset_prod_rpow _ _ (fun _ _ => abs_nonneg _),
      ← Real.finset_prod_rpow _ _ (fun _ _ => by positivity)]
  
  have hprod : ∀ X : ℝ, {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X}
      = (Set.univ.pi fun _ : {w : NumberField.InfinitePlace K // w.IsReal} =>
            Set.Ioo (-X) X)
        ×ˢ (Set.univ.pi fun _ : {w : NumberField.InfinitePlace K // w.IsComplex} =>
            {c : ℂ | ‖c‖ < X}) := by
    intro X
    ext z
    simp only [Set.mem_setOf_eq, Set.mem_prod, Set.mem_univ_pi, Set.mem_Ioo]
    constructor
    · intro h
      refine ⟨fun w => ?_, fun p => ?_⟩
      · have e := h w
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2, Real.norm_eq_abs] at e
        exact abs_lt.mp e
      · have e := h p
        rwa [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex p.2] at e
    · rintro ⟨h1, h2⟩ v
      rcases NumberField.InfinitePlace.isReal_or_isComplex v with hv | hv
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hv, Real.norm_eq_abs]
        exact abs_lt.mpr (h1 ⟨v, hv⟩)
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hv]
        exact h2 ⟨v, hv⟩
  
  have s3 : ∀ X : ℝ, ∫ z in {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X},
        (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ))
      = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            ∫ x in Set.Ioo (-X) X, |x| ^ (-(1 / 2 : ℝ))) *
        ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            ∫ c in {c : ℂ | ‖c‖ < X}, (‖c‖ ^ 2) ^ (-(1 / 2 : ℝ)) := by
    intro X
    simp_rw [hnorm (-(1 / 2 : ℝ))]
    rw [hprod X, MeasureTheory.Measure.volume_eq_prod
          ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
          ({w : NumberField.InfinitePlace K // w.IsComplex} → ℂ)]
    refine (MeasureTheory.setIntegral_prod_mul
        (fun u : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ =>
          ∏ w, |u w| ^ (-(1 / 2 : ℝ)))
        (fun v : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ =>
          ∏ p, (‖v p‖ ^ 2) ^ (-(1 / 2 : ℝ))) _ _).trans ?_
    congr 1
    · rw [MeasureTheory.volume_pi, MeasureTheory.Measure.restrict_pi_pi]
      exact MeasureTheory.integral_fintype_prod_eq_prod
        (fun w (t : ℝ) => |t| ^ (-(1 / 2 : ℝ)))
    · rw [MeasureTheory.volume_pi, MeasureTheory.Measure.restrict_pi_pi]
      exact MeasureTheory.integral_fintype_prod_eq_prod
        (fun p (c : ℂ) => (‖c‖ ^ 2) ^ (-(1 / 2 : ℝ)))
  
  have hBfin : ∀ X : ℝ, MeasureTheory.volume {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X} < ⊤ := by
    intro X
    rw [hprod X, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
      MeasureTheory.volume_pi, MeasureTheory.volume_pi, MeasureTheory.Measure.pi_pi,
      MeasureTheory.Measure.pi_pi]
    have hball : {c : ℂ | ‖c‖ < X} = Metric.ball 0 X := by
      ext c; simp
    rw [hball]
    exact ENNReal.mul_lt_top (ENNReal.prod_lt_top fun _ _ => measure_Ioo_lt_top)
      (ENNReal.prod_lt_top fun _ _ => MeasureTheory.measure_ball_lt_top)
  
  have hcard : (Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} : ℝ)
      + 2 * (Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex} : ℝ)
      = (Module.finrank ℚ K : ℝ) := by
    have h := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
    rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card]
    simp only [NumberField.InfinitePlace.nrRealPlaces, NumberField.InfinitePlace.nrComplexPlaces,
      Fintype.card_eq_nat_card] at h
    exact_mod_cast h
  
  refine ⟨4 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
      * (2 * Real.pi) ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex},
    by positivity, ?_⟩
  intro X γ hX1 hγ1 hγ2
  have hX : 0 < X := by linarith
  have hIval : ∫ z in {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X},
        (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ))
      = 4 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
        * (2 * Real.pi) ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}
        * X ^ ((Module.finrank ℚ K : ℝ) / 2) := by
    rw [s3 X, Finset.prod_congr rfl (fun w _ => t_real X hX),
      Finset.prod_congr rfl (fun p _ => t_cplx X hX), Finset.prod_const, Finset.prod_const,
      Finset.card_univ, Finset.card_univ]
    have hexp : (Module.finrank ℚ K : ℝ) / 2
        = (1 : ℝ) / 2 * (Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} : ℝ)
          + (Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex} : ℝ) := by
      rw [← hcard]; ring
    rw [hexp, Real.rpow_add hX, Real.rpow_mul hX.le, Real.rpow_natCast, Real.rpow_natCast]
    ring
  have hIpos : 0 < ∫ z in {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X},
        (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ)) := by
    rw [hIval]; positivity
  have hInt_h : MeasureTheory.IntegrableOn
      (fun z : NumberField.mixedEmbedding.mixedSpace K =>
        (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ)))
      {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X} :=
    MeasureTheory.Integrable.of_integral_ne_zero hIpos.ne'
  have hInt_1 : MeasureTheory.IntegrableOn
      (fun _ : NumberField.mixedEmbedding.mixedSpace K => (1 : ℝ))
      {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X} :=
    MeasureTheory.integrableOn_const (hBfin X).ne
  have hInt_g : MeasureTheory.IntegrableOn
      (fun z : NumberField.mixedEmbedding.mixedSpace K =>
        1 + (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ)))
      {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X} :=
    hInt_1.add hInt_h
  have hmeas : Measurable (fun z : NumberField.mixedEmbedding.mixedSpace K =>
      (NumberField.mixedEmbedding.norm z) ^ γ) :=
    (NumberField.mixedEmbedding.continuous_norm K).measurable.pow_const γ
  have hdom : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
      (NumberField.mixedEmbedding.norm z) ^ γ
        ≤ 1 + (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ)) :=
    fun z => s4 _ γ (NumberField.mixedEmbedding.norm_nonneg z) hγ1 hγ2
  have hfB : MeasureTheory.IntegrableOn
      (fun z : NumberField.mixedEmbedding.mixedSpace K =>
        (NumberField.mixedEmbedding.norm z) ^ γ)
      {z : NumberField.mixedEmbedding.mixedSpace K |
        ∀ w : NumberField.InfinitePlace K, NumberField.mixedEmbedding.normAtPlace w z < X} := by
    refine MeasureTheory.Integrable.mono' hInt_g hmeas.aestronglyMeasurable
      (MeasureTheory.ae_of_all _ fun z => ?_)
    rw [Real.norm_of_nonneg (Real.rpow_nonneg (NumberField.mixedEmbedding.norm_nonneg z) γ)]
    exact hdom z
  refine ⟨hfB, ?_⟩
  intro S hS hSB
  have hSfin : MeasureTheory.volume S < ⊤ :=
    (MeasureTheory.measure_mono hSB).trans_lt (hBfin X)
  have h1S : MeasureTheory.IntegrableOn
      (fun _ : NumberField.mixedEmbedding.mixedSpace K => (1 : ℝ)) S :=
    MeasureTheory.integrableOn_const hSfin.ne
  calc ∫ z in S, (NumberField.mixedEmbedding.norm z) ^ γ
      ≤ ∫ z in S, (1 + (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ))) :=
        MeasureTheory.setIntegral_mono_on (hfB.mono_set hSB) (hInt_g.mono_set hSB) hS
          (fun z _ => hdom z)
    _ = (MeasureTheory.volume S).toReal
          + ∫ z in S, (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ)) := by
        rw [MeasureTheory.integral_add h1S (hInt_h.mono_set hSB),
          MeasureTheory.setIntegral_const, smul_eq_mul, mul_one,
          MeasureTheory.measureReal_def]
    _ ≤ (MeasureTheory.volume S).toReal
          + ∫ z in {z : NumberField.mixedEmbedding.mixedSpace K |
              ∀ w : NumberField.InfinitePlace K,
                NumberField.mixedEmbedding.normAtPlace w z < X},
            (NumberField.mixedEmbedding.norm z) ^ (-(1 / 2 : ℝ)) := by
        have hmono := MeasureTheory.setIntegral_mono_set hInt_h
          (MeasureTheory.ae_of_all _ fun z =>
            Real.rpow_nonneg (NumberField.mixedEmbedding.norm_nonneg z) (-(1 / 2 : ℝ)))
          hSB.eventuallyLE
        linarith
    _ = (MeasureTheory.volume S).toReal
          + 4 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
            * (2 * Real.pi) ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}
            * X ^ ((Module.finrank ℚ K : ℝ) / 2) := by
        rw [hIval]

theorem kai_lp_convex_of_cell (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ c₀ C₀ κmax : ℝ, 0 < c₀ → 0 ≤ C₀ → 0 ≤ κmax →
    ∃ c₄ C₄ : ℝ, 0 < c₄ ∧ 0 ≤ C₄ ∧
      ∀ X : ℝ, 3 ≤ X →
      ∀ (q : Ideal (NumberField.RingOfIntegers K)) (α : NumberField.RingOfIntegers K)
        (κ ε β : ℝ), 0 ≤ κ → κ ≤ κmax → |ε| ≤ 1 → (ε = 0 ∨ (1 / 2 ≤ β ∧ β < 1)) →
      (∀ (a b : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
          (ρ σ θ₁ θ₂ : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
          (∀ w, -X ≤ a w ∧ a w < b w ∧ b w ≤ X ∧ Real.sqrt X ≤ b w - a w ∧
            ((0 ≤ a w ∧ 0 < (NumberField.mixedEmbedding K (α : K)).1 w) ∨
             (b w ≤ 0 ∧ (NumberField.mixedEmbedding K (α : K)).1 w < 0))) →
          (∀ w, 0 ≤ ρ w ∧ ρ w < σ w ∧ σ w ≤ X ∧ Real.sqrt X ≤ σ w - ρ w ∧
            -Real.pi ≤ θ₁ w ∧ θ₁ w ≤ θ₂ w ∧ θ₂ w ≤ Real.pi) →
          |kaiPrimePsi K q α (kaiCell K a b ρ σ θ₁ θ₂)
            - κ * ((MeasureTheory.volume (kaiCell K a b ρ σ θ₁ θ₂)).toReal
                - ε * ∫ z in kaiCell K a b ρ σ θ₁ θ₂,
                    (NumberField.mixedEmbedding.norm z) ^ (β - 1))|
            ≤ C₀ * X ^ (Module.finrank ℚ K) * Real.exp (-(Real.log X ^ c₀))) →
      ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
        (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X) →
        (∀ z ∈ C, ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          0 < z.1 w * (NumberField.mixedEmbedding K (α : K)).1 w) →
        |kaiPrimePsi K q α C
          - κ * ((MeasureTheory.volume C).toReal
              - ε * ∫ z in C, (NumberField.mixedEmbedding.norm z) ^ (β - 1))|
          ≤ C₄ * X ^ (Module.finrank ℚ K) * Real.exp (-(Real.log X ^ c₄)) :=
by
  classical
  intro c₀ C₀ κmax hc₀ hC₀ hκmax
  obtain ⟨cS, hcS0, hshell⟩ := kai_cvx_shell_volume K
  obtain ⟨dL, cL, hdL0, hcL0, hcount⟩ := kai_cvx_lattice_count K
  obtain ⟨CW, hCW0, hW⟩ := kai_norm_rpow_box_bound K
  have hn0 : 0 < Module.finrank ℚ K := Module.finrank_pos
  set n : ℕ := Module.finrank ℚ K with hn_def
  have hn1 : (1:ℝ) ≤ (n:ℝ) := by exact_mod_cast hn0
  have hnpos : (0:ℝ) < (n:ℝ) := by linarith
  have hnne : (n:ℝ) ≠ 0 := hnpos.ne'
  
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = min c₀ (1 / 2) := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hc_def]; exact lt_min hc₀ (by norm_num)
  have hcc₀ : c ≤ c₀ := by rw [hc_def]; exact min_le_left _ _
  have hchalf : c ≤ 1 / 2 := by rw [hc_def]; exact min_le_right _ _
  obtain ⟨c₄, hc₄_def⟩ : ∃ c₄ : ℝ, c₄ = c / 2 := ⟨_, rfl⟩
  have hc₄0 : 0 < c₄ := by rw [hc₄_def]; linarith
  have hc₄ne : c₄ ≠ 0 := hc₄0.ne'
  obtain ⟨e', he'_def⟩ : ∃ e' : ℝ, e' = 1 / (2 * (n:ℝ)) := ⟨_, rfl⟩
  have he'0 : 0 < e' := by rw [he'_def]; positivity
  have he'ne : e' ≠ 0 := he'0.ne'
  have hne' : (n:ℝ) * e' = 1 / 2 := by rw [he'_def]; field_simp
  have he'half : e' ≤ 1 / 2 := by
    have h := mul_le_mul_of_nonneg_left hn1 he'0.le
    linarith
  obtain ⟨L₁, hL₁_def⟩ : ∃ L₁ : ℝ, L₁ = (2 * (n:ℝ) * Real.log 5) ^ c⁻¹ := ⟨_, rfl⟩
  have hlog5 : 0 < Real.log 5 := Real.log_pos (by norm_num)
  have hL₁0 : 0 ≤ L₁ := by rw [hL₁_def]; exact Real.rpow_nonneg (by positivity) _
  have hL₁c : L₁ ^ c = 2 * (n:ℝ) * Real.log 5 := by
    rw [hL₁_def]; exact Real.rpow_inv_rpow (by positivity) hc0.ne'
  obtain ⟨X₀, hX₀_def⟩ : ∃ X₀ : ℝ, X₀ = max (Real.exp (max 4 L₁)) (dL ^ 2 + 1) := ⟨_, rfl⟩
  have hX₀1 : 1 ≤ X₀ := by
    rw [hX₀_def]
    have h := sq_nonneg dL
    exact le_trans (by linarith) (le_max_right _ _)
  obtain ⟨a', ha'_def⟩ : ∃ a' : ℝ, a' = 1 / c₄ + 1 := ⟨_, rfl⟩
  obtain ⟨K', hK'_def⟩ : ∃ K' : ℝ, K' = a' ^ 2 / (4 * e') := ⟨_, rfl⟩
  obtain ⟨A₁, hA₁_def⟩ : ∃ A₁ : ℝ, A₁ = 14 ^ n * C₀ + κmax * (8 * cS + CW) := ⟨_, rfl⟩
  have hA₁0 : 0 ≤ A₁ := by rw [hA₁_def]; positivity
  obtain ⟨A₂, hA₂_def⟩ : ∃ A₂ : ℝ, A₂ = 5 * (n:ℝ) * cL * cS := ⟨_, rfl⟩
  have hA₂0 : 0 ≤ A₂ := by rw [hA₂_def]; positivity
  obtain ⟨MΨ, V, hMΨ0, hV0, hbnd⟩ := kai_cvx_trivial_bounds K X₀
  have hX₀n : 0 ≤ X₀ ^ ((n:ℝ) / 2) := Real.rpow_nonneg (by linarith) _
  obtain ⟨Bnd, hBnd_def⟩ : ∃ Bnd : ℝ,
      Bnd = MΨ + κmax * (2 * V + CW * X₀ ^ ((n:ℝ) / 2)) := ⟨_, rfl⟩
  have hBnd0 : 0 ≤ Bnd := by rw [hBnd_def]; positivity
