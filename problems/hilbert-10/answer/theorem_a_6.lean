    have hs : (0 : ℝ) ≤ (∑ k : ι₁, |((ν.1 k : ℤ) : ℝ)|)
        + ∑ p : ι₂, |((ν.2 p : ℤ) : ℝ)| :=
      add_nonneg (Finset.sum_nonneg fun _ _ => abs_nonneg _)
        (Finset.sum_nonneg fun _ _ => abs_nonneg _)
    have h3 : (0 : ℝ) ≤ Real.log (1 + (1 + F * ((∑ k : ι₁, |((ν.1 k : ℤ) : ℝ)|)
        + ∑ p : ι₂, |((ν.2 p : ℤ) : ℝ)|))) := by
      apply Real.log_nonneg
      have hFS : (0 : ℝ) ≤ F * ((∑ k : ι₁, |((ν.1 k : ℤ) : ℝ)|)
          + ∑ p : ι₂, |((ν.2 p : ℤ) : ℝ)|) := mul_nonneg (by linarith) hs
      linarith
    exact mul_nonneg (mul_nonneg (mul_nonneg h1 h2) h3) (Real.exp_nonneg _)
  have hmajsum : Summable (fun ν : (ι₁ → ℤ) × (ι₂ → ℤ) =>
      6 * Real.log (1 + F)
        * Real.exp (-(Real.log x) /
            (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
        * ((∏ k : ι₁, hw (ν.1 k)) * (∏ p : ι₂, hw (ν.2 p)))) :=
    hprodsum.mul_left _
  have hWsum : Summable TW := Summable.of_nonneg_of_le hTW0 hpt hmajsum
  have hstep1 : (∑' ν : (ι₁ → ℤ) × (ι₂ → ℤ), TW ν)
      ≤ ∑' ν : (ι₁ → ℤ) × (ι₂ → ℤ),
          6 * Real.log (1 + F)
            * Real.exp (-(Real.log x) /
                (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
            * ((∏ k : ι₁, hw (ν.1 k)) * (∏ p : ι₂, hw (ν.2 p))) :=
    Summable.tsum_le_tsum hpt hWsum hmajsum
  have hstep2 : (∑' ν : (ι₁ → ℤ) × (ι₂ → ℤ),
        6 * Real.log (1 + F)
          * Real.exp (-(Real.log x) /
              (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
          * ((∏ k : ι₁, hw (ν.1 k)) * (∏ p : ι₂, hw (ν.2 p))))
      = 6 * Real.log (1 + F)
          * Real.exp (-(Real.log x) /
              (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
          * ((∑' m : ℤ, hw m) ^ (Fintype.card ι₁ + Fintype.card ι₂)) := by
    rw [Summable.tsum_mul_left _ hprodsum, hsumval]
  have hGpow : (∑' m : ℤ, hw m) ^ (Fintype.card ι₁ + Fintype.card ι₂)
      ≤ (2 / δ) ^ (Fintype.card ι₁ + Fintype.card ι₂) :=
    pow_le_pow_left₀ hG0 hwle _
  have hstep3 : 6 * Real.log (1 + F)
        * Real.exp (-(Real.log x) /
            (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
        * ((∑' m : ℤ, hw m) ^ (Fintype.card ι₁ + Fintype.card ι₂))
      ≤ 6 * Real.log (1 + F)
        * Real.exp (-(Real.log x) /
            (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
        * ((2 / δ) ^ (Fintype.card ι₁ + Fintype.card ι₂)) :=
    mul_le_mul_of_nonneg_left hGpow hR0
  have hstep4 : 6 * Real.log (1 + F)
        * Real.exp (-(Real.log x) /
            (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
        * ((2 / δ) ^ (Fintype.card ι₁ + Fintype.card ι₂))
      ≤ C * Real.log (1 + F)
          * Real.exp (-(Real.log x) /
              (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
          / δ ^ (Fintype.card ι₁ + Fintype.card ι₂) := by
    rw [div_pow]
    have e1 : 6 * Real.log (1 + F)
          * Real.exp (-(Real.log x) /
              (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
          * ((2 : ℝ) ^ (Fintype.card ι₁ + Fintype.card ι₂)
              / δ ^ (Fintype.card ι₁ + Fintype.card ι₂))
        = (6 * (2 : ℝ) ^ (Fintype.card ι₁ + Fintype.card ι₂)
            * (Real.log (1 + F)
              * Real.exp (-(Real.log x) /
                  (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))))
          / δ ^ (Fintype.card ι₁ + Fintype.card ι₂) := by
      ring
    have e2 : C * Real.log (1 + F)
          * Real.exp (-(Real.log x) /
              (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
          / δ ^ (Fintype.card ι₁ + Fintype.card ι₂)
        = (C * (Real.log (1 + F)
              * Real.exp (-(Real.log x) /
                  (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))))
          / δ ^ (Fintype.card ι₁ + Fintype.card ι₂) := by
      ring
    rw [e1, e2]
    refine hdivmono _ _ _ hδn ?_
    exact mul_le_mul_of_nonneg_right hC6 (mul_nonneg hLam0 hEpos.le)
  have hfinal : Summable TW ∧ (∑' ν : (ι₁ → ℤ) × (ι₂ → ℤ), TW ν)
      ≤ C * Real.log (1 + F)
          * Real.exp (-(Real.log x) /
              (C * (Real.sqrt (Real.log x) + Real.log (1 + F))))
          / δ ^ (Fintype.card ι₁ + Fintype.card ι₂) :=
    ⟨hWsum, by linarith [hstep1, hstep2, hstep3, hstep4]⟩
  subst hTWdef
  exact hfinal

theorem kai_lp_fs_nonzero_tail (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ cP B : ℝ, 0 < cP → 1 ≤ B → ∃ C₇ : ℝ, 0 < C₇ ∧
      ∀ x : ℝ, 3 ≤ x → ∀ δ : ℝ, 0 < δ → δ ≤ 1 / 4 →
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      ∀ (𝔮D : Ideal (NumberField.RingOfIntegers K))
        (ψ : NumberField.RingOfIntegers K → ℤ) (β : ℝ),
      (∀ (t : NumberField.InfinitePlace K → ℝ)
          (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
          (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
          (∀ v : (NumberField.RingOfIntegers K)ˣ,
            kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1) →
          ‖(∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
              kaiHeckeTwist K q t l ξ η (kaiGen (P : Ideal (NumberField.RingOfIntegers K)))
                * ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ))
            - ((((@ite ℝ (∀ y : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q y) →
                      kaiHeckeTwist K q t l ξ η y = 1) (Classical.propDecidable _) (1 : ℝ) 0) * x
                  - (@ite ℝ (ψ ≠ 0 ∧ t = 0 ∧ l = 0 ∧
                        ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
                          IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
                          kaiHeckeTwist K q t l ξ η y = ((ψ y : ℤ) : ℂ))
                      (Classical.propDecidable _) (1 : ℝ) 0) * (x ^ β / β))
                / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)‖
            ≤ cP * x * Real.log x ^ 2 * Real.log (1 + kaiInfSize K t l) *
                Real.exp (-(Real.log x) /
                  (cP * (Real.sqrt (Real.log x) + Real.log (1 + kaiInfSize K t l))))) →
      ∀ α : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q α) →
      ∀ sgn : {w : NumberField.InfinitePlace K // w.IsReal} → Bool,
      ∀ (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ) (wq : ℕ)
        (Rq : ℝ) (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ),
        KaiTBUnitData K B q H wq Rq e →
      ∀ Ξ : Finset (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle),
        Ξ.card = Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) →
      ∀ (cT : Fin (NumberField.Units.rank K) → ℤ → ℂ)
        (cS : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ → ℂ),
        (∀ j m, ‖cT j m‖ ≤ kaiLPCoefBd δ m) →
        (∀ p l, ‖cS p l‖ ≤ kaiLPCoefBd δ l) →
        Summable (fun ml : (Fin (NumberField.Units.rank K) → ℤ) ×
            ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) =>
          ‖kaiLPFreqSum K q H e α sgn cT cS Ξ ml x‖) →
        ‖(∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
              ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
            kaiLPFreqSum K q H e α sgn cT cS Ξ ml x)
          - kaiLPFreqSum K q H e α sgn cT cS Ξ
              (0 : (Fin (NumberField.Units.rank K) → ℤ) ×
                ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)) x‖
          ≤ ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ)
                * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
              * (cP * x * Real.log x ^ 2)
              * (C₇ * Real.log (2 + 2 * Real.pi
                    * (Fintype.card (NumberField.InfinitePlace K) : ℝ) * B
                    * max 1 ((NumberField.Units.rank K : ℝ) / 2)
                    * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K)
                * Real.exp (-(Real.log x) / (C₇ * (Real.sqrt (Real.log x)
                    + Real.log (2 + 2 * Real.pi
                        * (Fintype.card (NumberField.InfinitePlace K) : ℝ) * B
                        * max 1 ((NumberField.Units.rank K : ℝ) / 2)
                        * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K))))
                / δ ^ (NumberField.Units.rank K
                    + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex})) :=
by
  intro cP B hcP hB
  obtain ⟨C₇, hC₇, hTW⟩ := kai_lp_tail_weight_profile_bound
    (ι₁ := Fin (NumberField.Units.rank K))
    (ι₂ := {w : NumberField.InfinitePlace K // w.IsComplex}) cP hcP
  refine ⟨C₇, hC₇, ?_⟩
  intro x hx δ hδ hδ4 q hq 𝔮D ψ β HYP α hα sgn H wq Rq e hdata Ξ hΞcard cT cS hbdT hbdS hsum
  classical
  
  have hx0 : (0 : ℝ) < x := by linarith
  have hL : 0 < Real.log x := Real.log_pos (by linarith)
  have hu : 0 < Real.sqrt (Real.log x) := Real.sqrt_pos.mpr hL
  have hcPxL : 0 ≤ cP * x * Real.log x ^ 2 :=
    mul_nonneg (mul_nonneg hcP.le hx0.le) (sq_nonneg _)
  have hP0 : (0 : ℝ) ≤ (Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ)
      * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} := by positivity
  have hcb0 : ∀ n : ℤ, 0 ≤ kaiLPCoefBd δ n := by
    intro n
    unfold kaiLPCoefBd
    split_ifs
    · norm_num
    · refine le_min ?_ ?_
      · exact div_nonneg zero_le_one (mul_nonneg Real.pi_pos.le (abs_nonneg _))
      · exact div_nonneg zero_le_one
          (mul_nonneg (mul_nonneg (sq_nonneg _) hδ.le) (sq_nonneg _))
  obtain ⟨X, hXdef⟩ : ∃ X : ℝ, X = 2 * Real.pi
      * (Fintype.card (NumberField.InfinitePlace K) : ℝ) * B
      * max 1 ((NumberField.Units.rank K : ℝ) / 2)
      * (Ideal.absNorm q : ℝ) ^ NumberField.Units.rank K := ⟨_, rfl⟩
  have hX0 : 0 ≤ X := by
    rw [hXdef]
    have h1 : (0 : ℝ) ≤ 2 * Real.pi * (Fintype.card (NumberField.InfinitePlace K) : ℝ) := by
      positivity
    exact mul_nonneg (mul_nonneg (mul_nonneg h1 (by linarith))
      (le_trans zero_le_one (le_max_left _ _))) (by positivity)
  rw [← hXdef]
  obtain ⟨F, hF⟩ : ∃ F : ℝ, F = X + 1 := ⟨_, rfl⟩
  have hF1 : 1 ≤ F := by rw [hF]; linarith
  have h1F : 1 + F = 2 + X := by rw [hF]; ring
  obtain ⟨hTWsum, hTWbd⟩ := hTW x δ F hx hδ hδ4 hF1
  rw [h1F, Fintype.card_fin] at hTWbd
  obtain ⟨hFA1, -, hFA3, -, hFA5⟩ := kai_lp_freq_type_algebra K B q H wq Rq e hdata
  rw [← hXdef] at hFA5
  obtain ⟨TW, hTWdef⟩ : ∃ TW : (Fin (NumberField.Units.rank K) → ℤ) ×
      ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) → ℝ,
      TW = fun ν => (∏ k : Fin (NumberField.Units.rank K), kaiLPCoefBd δ (ν.1 k))
          * (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, kaiLPCoefBd δ (ν.2 p))
          * Real.log (1 + (1 + F * ((∑ k : Fin (NumberField.Units.rank K), |((ν.1 k : ℤ) : ℝ)|)
                + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |((ν.2 p : ℤ) : ℝ)|)))
          * Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x)
              + Real.log (1 + (1 + F * ((∑ k : Fin (NumberField.Units.rank K),
                    |((ν.1 k : ℤ) : ℝ)|)
                + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                    |((ν.2 p : ℤ) : ℝ)|)))))) :=
    ⟨_, rfl⟩
  have hTWs : Summable TW := by rw [hTWdef]; exact hTWsum
  have hTWb : ∑' ν, TW ν ≤ C₇ * Real.log (2 + X)
      * Real.exp (-(Real.log x) / (C₇ * (Real.sqrt (Real.log x) + Real.log (2 + X))))
      / δ ^ (NumberField.Units.rank K
          + Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}) := by
    rw [hTWdef]; exact hTWbd
  have hTW0 : ∀ ν, 0 ≤ TW ν := by
    intro ν
    rw [hTWdef]
    dsimp only
    have hS : 0 ≤ (∑ k : Fin (NumberField.Units.rank K), |((ν.1 k : ℤ) : ℝ)|)
        + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, |((ν.2 p : ℤ) : ℝ)| := by
      positivity
    have hFS := mul_nonneg (show (0 : ℝ) ≤ F by linarith) hS
    refine mul_nonneg (mul_nonneg (mul_nonneg ?_ ?_) (Real.log_nonneg (by linarith)))
      (Real.exp_nonneg _)
    · exact Finset.prod_nonneg (fun k _ => hcb0 _)
    · exact Finset.prod_nonneg (fun p _ => hcb0 _)
  
  have hmono : ∀ y z : ℝ, 0 ≤ y → y ≤ z →
      Real.log (1 + y) * Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x)
          + Real.log (1 + y))))
        ≤ Real.log (1 + z) * Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x)
          + Real.log (1 + z)))) := by
    intro y z hy hyz
    have h1 : 0 ≤ Real.log (1 + y) := Real.log_nonneg (by linarith)
    have h2 : Real.log (1 + y) ≤ Real.log (1 + z) :=
      Real.log_le_log (by linarith) (by linarith)
    have hd1 : 0 < cP * (Real.sqrt (Real.log x) + Real.log (1 + y)) :=
      mul_pos hcP (by linarith)
    have hd2 : cP * (Real.sqrt (Real.log x) + Real.log (1 + y))
        ≤ cP * (Real.sqrt (Real.log x) + Real.log (1 + z)) :=
      mul_le_mul_of_nonneg_left (by linarith) hcP.le
    have h3 : Real.log x / (cP * (Real.sqrt (Real.log x) + Real.log (1 + z)))
        ≤ Real.log x / (cP * (Real.sqrt (Real.log x) + Real.log (1 + y))) :=
      div_le_div_of_nonneg_left hL.le hd1 hd2
    have h4 : Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x) + Real.log (1 + y))))
        ≤ Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x) + Real.log (1 + z)))) := by
      apply Real.exp_le_exp.mpr
      rw [neg_div, neg_div]
      linarith
    exact mul_le_mul h2 h4 (Real.exp_nonneg _) (le_trans h1 h2)
  
  have hprin : ∀ (m : Fin (NumberField.Units.rank K) → ℤ)
      (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ), ¬ (m = 0 ∧ l = 0) →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
      ¬ (∀ y : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q y) →
          kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η y = 1) := by
    intro m l hml ξ η h
    obtain ⟨ht, hl, -, -⟩ :=
      kai_lp_twist_trivial_of_eq_one K q hq _ l ξ η (hFA1 m l) h
    subst hl
    exact hml ⟨hFA3 m ht, rfl⟩
  have hexc : ∀ (m : Fin (NumberField.Units.rank K) → ℤ)
      (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ), ¬ (m = 0 ∧ l = 0) →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
      ¬ (ψ ≠ 0 ∧ kaiLPFreqType K H e m l = 0 ∧ l = 0 ∧
          ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
            IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
            kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η y = ((ψ y : ℤ) : ℂ)) := by
    rintro m l hml ξ η ⟨-, ht, hl, -⟩
    subst hl
    exact hml ⟨hFA3 m ht, rfl⟩
  
  have hterm : ∀ (m : Fin (NumberField.Units.rank K) → ℤ)
      (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ), ¬ (m = 0 ∧ l = 0) →
      ∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
        (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
      ‖kaiLPFreqTerm K q H e α sgn cT cS m l ξ η x‖
        ≤ cP * x * Real.log x ^ 2 * TW (m, l) := by
    intro m l hml ξ η
    unfold kaiLPFreqTerm
    by_cases hcond : ∀ y : (NumberField.RingOfIntegers K)ˣ,
        kaiHeckeTwist K q (kaiLPFreqType K H e m l) l ξ η
          ((y : NumberField.RingOfIntegers K)) = 1
    · rw [if_pos hcond, one_mul]
      have hH := HYP (kaiLPFreqType K H e m l) l ξ η (hFA1 m l) hcond
      rw [if_neg (hprin m l hml ξ η), if_neg (hexc m l hml ξ η)] at hH
      simp only [zero_mul, sub_zero, zero_div, Complex.ofReal_zero] at hH
      obtain ⟨Ms, hMs⟩ : ∃ s : ℝ, s = ∑ j, |((m j : ℤ) : ℝ)| := ⟨_, rfl⟩
      obtain ⟨Ls, hLs⟩ : ∃ s : ℝ, s = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          |((l p : ℤ) : ℝ)| := ⟨_, rfl⟩
      have hMs0 : 0 ≤ Ms := by rw [hMs]; positivity
      have hLs0 : 0 ≤ Ls := by rw [hLs]; positivity
      have h5 := hFA5 m l
      rw [← hMs, ← hLs] at h5
      have hV0 : 0 ≤ kaiInfSize K (kaiLPFreqType K H e m l) l := by
        unfold kaiInfSize; positivity
      have hVZ : kaiInfSize K (kaiLPFreqType K H e m l) l ≤ 1 + F * (Ms + Ls) := by
        unfold kaiInfSize
        rw [← hLs]
        have e1 : F * (Ms + Ls) = X * (Ms + Ls) + Ms + Ls := by rw [hF]; ring
        linarith
      have key : ∀ a : ℝ, a ≤ cP * x * Real.log x ^ 2
          * Real.log (1 + kaiInfSize K (kaiLPFreqType K H e m l) l)
          * Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x)
              + Real.log (1 + kaiInfSize K (kaiLPFreqType K H e m l) l)))) →
          a ≤ cP * x * Real.log x ^ 2 * (Real.log (1 + (1 + F * (Ms + Ls)))
            * Real.exp (-(Real.log x) / (cP * (Real.sqrt (Real.log x)
              + Real.log (1 + (1 + F * (Ms + Ls))))))) := by
        intro a ha
        refine ha.trans ?_
        rw [mul_assoc (cP * x * Real.log x ^ 2)]
        exact mul_le_mul_of_nonneg_left (hmono _ _ hV0 hVZ) hcPxL
      have hΘ := key _ hH
      simp only [norm_mul]
      rw [dif_pos hα, Complex.norm_conj, Circle.norm_coe]
      have hsg : ‖∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (if η w then (if sgn w then (1 : ℂ) else -1) else 1)‖ = 1 := by
        rw [norm_prod]
        apply Finset.prod_eq_one
        intro w _
        split_ifs <;> simp
      rw [hsg]
      simp only [mul_one]
      have hA : ‖∏ j, cT j (m j)‖ ≤ ∏ j, kaiLPCoefBd δ (m j) := by
        rw [norm_prod]
        exact Finset.prod_le_prod (fun j _ => norm_nonneg _) (fun j _ => hbdT j (m j))
      have hB : ‖∏ p, cS p (l p)‖ ≤ ∏ p, kaiLPCoefBd δ (l p) := by
        rw [norm_prod]
        exact Finset.prod_le_prod (fun p _ => norm_nonneg _) (fun p _ => hbdS p (l p))
      have hA0 : 0 ≤ ∏ j, kaiLPCoefBd δ (m j) := Finset.prod_nonneg (fun j _ => hcb0 _)
      have hB0 : 0 ≤ ∏ p, kaiLPCoefBd δ (l p) := Finset.prod_nonneg (fun p _ => hcb0 _)
      refine le_trans (mul_le_mul (mul_le_mul hA hB (norm_nonneg _) hA0) hΘ (norm_nonneg _)
        (mul_nonneg hA0 hB0)) (le_of_eq ?_)
      rw [hTWdef, hMs, hLs]
      dsimp only
      ring
    · rw [if_neg hcond]
      simp only [zero_mul, norm_zero]
      exact mul_nonneg hcPxL (hTW0 _)
  
  have hbb : ∀ ml : (Fin (NumberField.Units.rank K) → ℤ) ×
      ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
      ‖(if ml = 0 then (0 : ℂ) else kaiLPFreqSum K q H e α sgn cT cS Ξ ml x)‖
        ≤ ((Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) : ℝ)
            * 2 ^ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
          * (cP * x * Real.log x ^ 2) * TW ml := by
    intro ml
    by_cases h0 : ml = 0
    · rw [if_pos h0, norm_zero]
      exact mul_nonneg (mul_nonneg hP0 hcPxL) (hTW0 ml)
    · rw [if_neg h0]
      have hml : ¬ (ml.1 = 0 ∧ ml.2 = 0) := fun h => h0 (Prod.ext h.1 h.2)
      unfold kaiLPFreqSum
      refine (norm_sum_le _ _).trans ?_
      refine (Finset.sum_le_sum (fun ξ _ => norm_sum_le _ _)).trans ?_
      refine (Finset.sum_le_sum (fun ξ _ => Finset.sum_le_sum
        (fun η _ => hterm ml.1 ml.2 hml ξ η))).trans (le_of_eq ?_)
      rw [Finset.sum_const, Finset.sum_const, hΞcard, Finset.card_univ,
        Fintype.card_eq_nat_card (α := {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
        Nat.card_fun, Nat.card_eq_fintype_card (α := Bool), Fintype.card_bool,
        Nat.card_eq_fintype_card (α := {w : NumberField.InfinitePlace K // w.IsReal}),
        nsmul_eq_mul, nsmul_eq_mul, Prod.mk.eta]
      push_cast
      ring
  
  have hsF : Summable (fun ml => kaiLPFreqSum K q H e α sgn cT cS Ξ ml x) := hsum.of_norm
  rw [hsF.tsum_eq_add_tsum_ite 0, add_sub_cancel_left]
  have hsI : Summable (fun ml : (Fin (NumberField.Units.rank K) → ℤ) ×
      ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) =>
      ‖(if ml = 0 then (0 : ℂ) else kaiLPFreqSum K q H e α sgn cT cS Ξ ml x)‖) := by
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun ml => ?_) hsum
    by_cases h0 : ml = 0 <;> simp [h0]
  refine (norm_tsum_le_tsum_norm hsI).trans ?_
  refine (Summable.tsum_le_tsum hbb hsI (hTWs.mul_left _)).trans ?_
  rw [tsum_mul_left]
  exact mul_le_mul_of_nonneg_left hTWb (mul_nonneg hP0 hcPxL)

theorem kai_lp_fs_zero_decay (c : ℝ) (hc : 0 < c) :
    ∃ C' : ℝ, 0 < C' ∧ ∀ x : ℝ, 3 ≤ x →
      Real.log x ^ 2 * Real.log 2
          * Real.exp (-(Real.log x) / (c * (Real.sqrt (Real.log x) + Real.log 2)))
        ≤ C' * Real.exp (-Real.sqrt (Real.log x) / (4 * c)) :=
by
  refine ⟨24 * (4 * c) ^ 4, by positivity, ?_⟩
  intro x hx
  have hx0 : 0 < x := by linarith
  have hL1 : 1 ≤ Real.log x := by
    rw [Real.le_log_iff_exp_le hx0]
    have := Real.exp_one_lt_d9
    linarith
  set L := Real.log x with hL_def
  set s := Real.sqrt L with hs_def
  have hs0 : 0 ≤ s := Real.sqrt_nonneg L
  have hss : s * s = L := Real.mul_self_sqrt (by linarith)
  have hs1 : 1 ≤ s := by
    rw [hs_def, show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_le_sqrt hL1
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hl2' : Real.log 2 < 1 := by have := Real.log_two_lt_d9; linarith
  set l2 := Real.log 2 with hl2_def
  set t := s / (4 * c) with ht_def
  have ht0 : 0 ≤ t := by positivity
  have h1 : -L / (c * (s + l2)) ≤ -t + -t := by
    have hpos : 0 < c * (s + l2) := by positivity
    rw [div_le_iff₀ hpos]
    have e1 : -t + -t = -(s / (2 * c)) := by rw [ht_def]; ring
    rw [e1]
    have e2 : -(s / (2 * c)) * (c * (s + l2)) = -(s * (s + l2) / 2) := by
      field_simp
    rw [e2]
    have h3 : s * l2 ≤ s * s := mul_le_mul_of_nonneg_left (by linarith) hs0
    nlinarith
  have hexp1 : Real.exp (-L / (c * (s + l2))) ≤ Real.exp (-t) * Real.exp (-t) := by
    rw [← Real.exp_add]; exact Real.exp_le_exp.2 h1
  have h2 : t ^ 4 / (Nat.factorial 4 : ℝ) ≤ Real.exp t := Real.pow_div_factorial_le_exp t ht0 4
  have hfact : (Nat.factorial 4 : ℝ) = 24 := by norm_num [Nat.factorial]
  rw [hfact] at h2
  have h2' : t ^ 4 ≤ Real.exp t * 24 := (div_le_iff₀ (by norm_num)).1 h2
  have hs4 : s ^ 4 = (4 * c) ^ 4 * t ^ 4 := by
    rw [ht_def]; field_simp
  have hL2 : L ^ 2 = s ^ 4 := by rw [← hss]; ring
  have hs4' : s ^ 4 ≤ (4 * c) ^ 4 * (Real.exp t * 24) := by
    rw [hs4]; exact mul_le_mul_of_nonneg_left h2' (by positivity)
  have hrhs : -s / (4 * c) = -t := by rw [ht_def, neg_div]
  rw [hrhs, hL2]
  calc s ^ 4 * l2 * Real.exp (-L / (c * (s + l2)))
      ≤ s ^ 4 * 1 * (Real.exp (-t) * Real.exp (-t)) := by
        gcongr
    _ = s ^ 4 * Real.exp (-t) * Real.exp (-t) := by ring
    _ ≤ (4 * c) ^ 4 * (Real.exp t * 24) * Real.exp (-t) * Real.exp (-t) := by
        gcongr
    _ = 24 * (4 * c) ^ 4 * (Real.exp t * Real.exp (-t)) * Real.exp (-t) := by ring
    _ = 24 * (4 * c) ^ 4 * Real.exp (-t) := by
        rw [← Real.exp_add, add_neg_cancel, Real.exp_zero, mul_one]

theorem kai_lp_fs_tail_decay (C₇ cF : ℝ) (r Nb : ℕ) (hC₇ : 0 < C₇) (hcF : 0 ≤ cF) :
    ∃ K₁ G : ℝ, 0 < K₁ ∧ 0 < G ∧
      ∀ K₀ : ℝ, K₁ ≤ K₀ → ∀ x : ℝ, 3 ≤ x → ∀ δ : ℝ, 0 < δ →
        Real.exp (-Real.sqrt (Real.log x) / K₀) ≤ 4 * δ →
        ∀ N : ℝ, 0 ≤ N → N ≤ Real.exp (Real.sqrt (Real.log x)) →
          Real.log x ^ 2 * Real.log (2 + cF * N ^ r)
              * Real.exp (-(Real.log x) /
                  (C₇ * (Real.sqrt (Real.log x) + Real.log (2 + cF * N ^ r))))
              / δ ^ Nb
            ≤ G * Real.exp (-Real.sqrt (Real.log x) / K₀) :=
by
  have ha : 0 < Real.log (2 + cF) := Real.log_pos (by linarith)
  have hr0 : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
  obtain ⟨S, hS_def⟩ : ∃ S : ℝ, S = Real.log (2 + cF) + (r : ℝ) := ⟨_, rfl⟩
  have hS : 0 < S := by rw [hS_def]; linarith
  obtain ⟨D, hD_def⟩ : ∃ D : ℝ, D = C₇ * (1 + S) := ⟨_, rfl⟩
  have hD : 0 < D := by rw [hD_def]; exact mul_pos hC₇ (by linarith)
  have hNb0 : (0 : ℝ) ≤ (Nb : ℝ) := Nat.cast_nonneg Nb
  refine ⟨2 * ((Nb : ℝ) + 1) * D, 120 * 4 ^ Nb * S * (2 * D) ^ 5, by positivity,
    by positivity, ?_⟩
  intro K₀ hK₀ x hx δ hδ hδK N hN0 hNu
  have hK₁pos : 0 < 2 * ((Nb : ℝ) + 1) * D := by positivity
  have hK₀pos : 0 < K₀ := lt_of_lt_of_le hK₁pos hK₀
  have hL1 : 1 ≤ Real.log x := by
    rw [Real.le_log_iff_exp_le (by linarith)]
    have := Real.exp_one_lt_d9
    linarith
  have hL0 : 0 ≤ Real.log x := by linarith
  obtain ⟨u, hu_def⟩ : ∃ u : ℝ, u = Real.sqrt (Real.log x) := ⟨_, rfl⟩
  have hu1 : 1 ≤ u := by rw [hu_def]; exact Real.one_le_sqrt.mpr hL1
  have hu0 : 0 ≤ u := by linarith
  have hLu : Real.log x = u ^ 2 := by rw [hu_def]; exact (Real.sq_sqrt hL0).symm
  rw [← hu_def] at hδK hNu ⊢
  rw [hLu]
  obtain ⟨W, hW_def⟩ : ∃ W : ℝ, W = Real.log (2 + cF * N ^ r) := ⟨_, rfl⟩
  rw [← hW_def]
  
  have hNr0 : 0 ≤ N ^ r := pow_nonneg hN0 r
  have hcN : 0 ≤ cF * N ^ r := mul_nonneg hcF hNr0
  have hW0 : 0 < W := by rw [hW_def]; exact Real.log_pos (by linarith)
  have hWS : W ≤ S * u := by
    have hNr : N ^ r ≤ Real.exp ((r : ℝ) * u) := by
      rw [Real.exp_nat_mul]; exact pow_le_pow_left₀ hN0 hNu r
    have hE1 : 1 ≤ Real.exp ((r : ℝ) * u) := Real.one_le_exp (by positivity)
    have hle : 2 + cF * N ^ r ≤ (2 + cF) * Real.exp ((r : ℝ) * u) := by
      nlinarith [mul_le_mul_of_nonneg_left hNr hcF]
    have h1 := Real.log_le_log (by linarith) hle
    rw [Real.log_mul (by linarith) (Real.exp_pos _).ne', Real.log_exp] at h1
    have h2 : Real.log (2 + cF) ≤ Real.log (2 + cF) * u := le_mul_of_one_le_right ha.le hu1
    have h3 : S * u = Real.log (2 + cF) * u + (r : ℝ) * u := by rw [hS_def]; ring
    rw [hW_def, h3]
    linarith
  
  have hEx : Real.exp (-(u ^ 2) / (C₇ * (u + W))) ≤ Real.exp (-u / D) := by
    apply Real.exp_le_exp.mpr
    rw [neg_div, neg_div, neg_le_neg_iff, div_le_div_iff₀ hD (by positivity)]
    have h := mul_le_mul_of_nonneg_left hWS (le_of_lt (mul_pos hC₇ (by linarith : 0 < u)))
    rw [hD_def]
    nlinarith [h]
  
  have hE : 0 < 2 * D := by positivity
  have hP : u ^ 5 * Real.exp (-u / (2 * D)) ≤ 120 * (2 * D) ^ 5 := by
    have h := Real.pow_div_factorial_le_exp (u / (2 * D)) (div_nonneg hu0 hE.le) 5
    have hf : ((Nat.factorial 5 : ℕ) : ℝ) = 120 := by norm_num [Nat.factorial]
    rw [hf, div_pow, div_div, div_le_iff₀ (by positivity)] at h
    have hm : Real.exp (u / (2 * D)) * Real.exp (-u / (2 * D)) = 1 := by
      rw [← Real.exp_add, neg_div, add_neg_cancel, Real.exp_zero]
    calc u ^ 5 * Real.exp (-u / (2 * D))
        ≤ (Real.exp (u / (2 * D)) * ((2 * D) ^ 5 * 120)) * Real.exp (-u / (2 * D)) :=
          mul_le_mul_of_nonneg_right h (Real.exp_pos _).le
      _ = (Real.exp (u / (2 * D)) * Real.exp (-u / (2 * D))) * (120 * (2 * D) ^ 5) := by ring
      _ = 120 * (2 * D) ^ 5 := by rw [hm, one_mul]
  
  have hinv : 1 / δ ≤ 4 * Real.exp (u / K₀) := by
    rw [div_le_iff₀ hδ]
    have hm : Real.exp (-u / K₀) * Real.exp (u / K₀) = 1 := by
      rw [← Real.exp_add, neg_div, neg_add_cancel, Real.exp_zero]
    nlinarith [mul_le_mul_of_nonneg_right hδK (Real.exp_pos (u / K₀)).le]
  have hI : 1 / δ ^ Nb ≤ 4 ^ Nb * Real.exp ((Nb : ℝ) * (u / K₀)) := by
    rw [← one_div_pow, Real.exp_nat_mul, ← mul_pow]
    exact pow_le_pow_left₀ (by positivity) hinv Nb
  
  have hexp : -u / (2 * D) + (Nb : ℝ) * (u / K₀) ≤ -u / K₀ := by
    have h1 : u * ((Nb : ℝ) + 1) / K₀ ≤ u * ((Nb : ℝ) + 1) / (2 * ((Nb : ℝ) + 1) * D) :=
      div_le_div_of_nonneg_left (by positivity) hK₁pos hK₀
    have h2 : u * ((Nb : ℝ) + 1) / (2 * ((Nb : ℝ) + 1) * D) = u / (2 * D) := by
      field_simp
    have h3 : -u / (2 * D) + (Nb : ℝ) * (u / K₀) - (-u / K₀)
        = u * ((Nb : ℝ) + 1) / K₀ - u / (2 * D) := by
      field_simp
      ring
    linarith
  
  have hsplit : Real.exp (-u / D) = Real.exp (-u / (2 * D)) * Real.exp (-u / (2 * D)) := by
    rw [← Real.exp_add]
    congr 1
    field_simp
    ring
  have hstep1 : (u ^ 2) ^ 2 * W * Real.exp (-(u ^ 2) / (C₇ * (u + W)))
      ≤ S * (120 * (2 * D) ^ 5) * Real.exp (-u / (2 * D)) := by
    calc (u ^ 2) ^ 2 * W * Real.exp (-(u ^ 2) / (C₇ * (u + W)))
        ≤ (u ^ 2) ^ 2 * (S * u) * Real.exp (-u / D) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hWS (by positivity)) hEx
            (Real.exp_pos _).le (by positivity)
      _ = S * (u ^ 5 * Real.exp (-u / (2 * D))) * Real.exp (-u / (2 * D)) := by
          rw [hsplit]; ring
      _ ≤ S * (120 * (2 * D) ^ 5) * Real.exp (-u / (2 * D)) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hP hS.le) (Real.exp_pos _).le
  rw [div_eq_mul_one_div]
  calc (u ^ 2) ^ 2 * W * Real.exp (-(u ^ 2) / (C₇ * (u + W))) * (1 / δ ^ Nb)
      ≤ (S * (120 * (2 * D) ^ 5) * Real.exp (-u / (2 * D)))
          * (4 ^ Nb * Real.exp ((Nb : ℝ) * (u / K₀))) :=
        mul_le_mul hstep1 hI (by positivity) (by positivity)
    _ = 120 * 4 ^ Nb * S * (2 * D) ^ 5
          * Real.exp (-u / (2 * D) + (Nb : ℝ) * (u / K₀)) := by
        rw [Real.exp_add]; ring
    _ ≤ 120 * 4 ^ Nb * S * (2 * D) ^ 5 * Real.exp (-u / K₀) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexp) (by positivity)

theorem kai_lp_freq_series_error (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∀ cP B : ℝ, 0 < cP → 1 ≤ B → ∃ K₀ C₀ : ℝ, 0 < K₀ ∧ 0 < C₀ ∧
      ∀ x : ℝ, 3 ≤ x →
      ∀ δ : ℝ, 0 < δ → δ ≤ 1 / 4 →
        δ ≤ Real.exp (-Real.sqrt (Real.log x) / K₀) →
        Real.exp (-Real.sqrt (Real.log x) / K₀) ≤ 4 * δ →
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        (Ideal.absNorm q : ℝ) ≤ Real.exp (Real.sqrt (Real.log x)) →
      ∀ (𝔮D : Ideal (NumberField.RingOfIntegers K))
        (ψ : NumberField.RingOfIntegers K → ℤ) (β ε : ℝ),
        (ε = 0 ∨ (1 / 2 ≤ β ∧ β < 1)) →
      (∀ (t : NumberField.InfinitePlace K → ℝ)
          (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
          (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0) →
          (∀ v : (NumberField.RingOfIntegers K)ˣ,
            kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1) →
          ‖(∑' P : {P : Ideal (NumberField.RingOfIntegers K) //
                P.IsPrime ∧ P ≠ ⊥ ∧ Submodule.IsPrincipal P ∧ (Ideal.absNorm P : ℝ) ≤ x},
              kaiHeckeTwist K q t l ξ η (kaiGen (P : Ideal (NumberField.RingOfIntegers K)))
                * ((Real.log (Ideal.absNorm (P : Ideal (NumberField.RingOfIntegers K))) : ℝ) : ℂ))
            - ((((@ite ℝ (∀ y : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q y) →
                      kaiHeckeTwist K q t l ξ η y = 1) (Classical.propDecidable _) (1 : ℝ) 0) * x
                  - (@ite ℝ (ψ ≠ 0 ∧ t = 0 ∧ l = 0 ∧
                        ∀ y : NumberField.RingOfIntegers K, y ≠ 0 →
                          IsCoprime (Ideal.span {y}) q → IsCoprime (Ideal.span {y}) 𝔮D →
                          kaiHeckeTwist K q t l ξ η y = ((ψ y : ℤ) : ℂ))
                      (Classical.propDecidable _) (1 : ℝ) 0) * (x ^ β / β))
                / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)‖
            ≤ cP * x * Real.log x ^ 2 * Real.log (1 + kaiInfSize K t l) *
                Real.exp (-(Real.log x) /
                  (cP * (Real.sqrt (Real.log x) + Real.log (1 + kaiInfSize K t l))))) →
      (∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
          ∀ v : (NumberField.RingOfIntegers K)ˣ,
            kaiHeckeTwist K q 0 0 ξ η (v : NumberField.RingOfIntegers K) = 1) →
      (∀ (ξ ξ' : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η η' : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ' η' y = ((ψ y : ℤ) : ℂ)) →
          ξ = ξ' ∧ η = η') →
      ∀ α : NumberField.RingOfIntegers K, α ≠ 0 → IsUnit (Ideal.Quotient.mk q α) →
      (∀ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          (ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
          kaiHeckeTwist K q 0 0 ξ η α = ((ε : ℝ) : ℂ)) →
      (ε ≠ 0 → ∃ (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
          (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool),
          ψ ≠ 0 ∧ ∀ y : NumberField.RingOfIntegers K, y ≠ 0 → IsCoprime (Ideal.span {y}) q →
            IsCoprime (Ideal.span {y}) 𝔮D → kaiHeckeTwist K q 0 0 ξ η y = ((ψ y : ℤ) : ℂ)) →
      ∀ (H : Fin (NumberField.Units.rank K) → (NumberField.RingOfIntegers K)ˣ) (wq : ℕ)
        (Rq : ℝ) (e : Fin (NumberField.Units.rank K) → NumberField.InfinitePlace K → ℝ),
        KaiTBUnitData K B q H wq Rq e →
      ∀ Ξ : Finset (((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle),
        (1 : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle) ∈ Ξ →
        Ξ.card = Nat.card ((NumberField.RingOfIntegers K ⧸ q)ˣ) →
        (∀ ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle, ξ ∈ Ξ) →
      ∀ (cT : Fin (NumberField.Units.rank K) → ℤ → ℂ)
        (cS : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ → ℂ)
        (g : Fin (NumberField.Units.rank K) → ℝ)
        (th : {w : NumberField.InfinitePlace K // w.IsComplex} → ℝ),
        (∀ j m, ‖cT j m‖ ≤ kaiLPCoefBd δ m) →
        (∀ p l, ‖cS p l‖ ≤ kaiLPCoefBd δ l) →
        (∀ j, ‖cT j 0 - ((g j : ℝ) : ℂ)‖ ≤ δ) →
        (∀ p, ‖cS p 0 - ((th p : ℝ) : ℂ)‖ ≤ δ) →
        (∀ j, 0 ≤ g j ∧ g j ≤ 1) → (∀ p, 0 ≤ th p ∧ th p ≤ 1) →
        Summable (fun ml : (Fin (NumberField.Units.rank K) → ℤ) ×
            ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) =>
          ‖kaiLPFreqSum K q H e α
              (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w))
              cT cS Ξ ml x‖) →
        ‖(∑' ml : (Fin (NumberField.Units.rank K) → ℤ) ×
              ({w : NumberField.InfinitePlace K // w.IsComplex} → ℤ),
            kaiLPFreqSum K q H e α
              (fun w => decide (0 < (NumberField.mixedEmbedding K (α : K)).1 w))
              cT cS Ξ ml x)
            - (((∏ j, g j) * (∏ p, th p) * (x - ε * (x ^ β / β))
                  / (NumberField.classNumber K : ℝ) : ℝ) : ℂ)‖
