by
  classical
  
  have hgadd : ∀ x y : ℝ, giE (x + y) = giE x * giE y := by
    intro x y; unfold giE; rw [← Complex.exp_add]; congr 1; push_cast; ring
  have hgn : ∀ t : ℝ, ‖giE t‖ = 1 := by
    intro t; unfold giE; rw [Complex.norm_exp]; simp
  
  have hjordan : ∀ x : ℝ, 4 * |x - ((round x : ℤ) : ℝ)| ≤ ‖giE x - 1‖ := by
    intro x
    have h1 : giE x = Complex.exp (Complex.I * ((2 * Real.pi * x : ℝ) : ℂ)) := by
      unfold giE; congr 1; push_cast; ring
    rw [h1, Complex.norm_exp_I_mul_ofReal_sub_one, Real.norm_eq_abs, abs_mul, abs_two]
    have hy2 : |x - ((round x : ℤ) : ℝ)| ≤ 1 / 2 := abs_sub_round x
    have harg : 2 * Real.pi * x / 2
