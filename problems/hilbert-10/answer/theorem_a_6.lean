        have hmk : (((μ : NumberField.RingOfIntegers K) *
              (c : NumberField.RingOfIntegers K) : NumberField.RingOfIntegers K) : K)
            = (((μ : NumberField.RingOfIntegers K) : K)) *
              (((c : NumberField.RingOfIntegers K) : K)) := by push_cast; ring
        rw [hmk, map_mul]
        rfl
      have hiff := hsgn w
      rw [hval] at hiff
      rcases lt_trichotomy ((NumberField.mixedEmbedding K
          (((μ : NumberField.RingOfIntegers K) : K))).1 w) 0 with hB | hB | hB
      · have h1 : ¬ (0 < (NumberField.mixedEmbedding K
              (((μ : NumberField.RingOfIntegers K) : K))).1 w *
            (NumberField.mixedEmbedding K
              (((c : NumberField.RingOfIntegers K) : K))).1 w) := by
          intro hcon
          exact absurd (hiff.mpr hcon) (by linarith)
        have h2 : (NumberField.mixedEmbedding K
              (((μ : NumberField.RingOfIntegers K) : K))).1 w *
            (NumberField.mixedEmbedding K
              (((c : NumberField.RingOfIntegers K) : K))).1 w ≠ 0 := mul_ne_zero hBne hAne
        have h3 : (NumberField.mixedEmbedding K
              (((μ : NumberField.RingOfIntegers K) : K))).1 w *
            (NumberField.mixedEmbedding K
              (((c : NumberField.RingOfIntegers K) : K))).1 w < 0 :=
          lt_of_le_of_ne (not_lt.mp h1) h2
        nlinarith
      · exact absurd hB hBne
      · have h4 := hiff.mp hB
        nlinarith
    have hcU : KaiMFCongUnit K q c := ⟨hcq, hcpos⟩
    have h1U : KaiMFCongUnit K q 1 := by
      constructor
      · have h0 : ((1 : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) - 1 = 0 := by simp
        rw [h0]
        exact q.zero_mem
      · intro w
        have h0 : (((1 : (NumberField.RingOfIntegers K)ˣ) :
            NumberField.RingOfIntegers K) : K) = 1 := by push_cast; ring
        rw [h0, map_one]
        have h1 : (1 : NumberField.mixedEmbedding.mixedSpace K).1 w = 1 := rfl
        rw [h1]
        exact zero_lt_one
    obtain ⟨p₀, -, huniq⟩ := hGen2 (μ' : NumberField.RingOfIntegers K) hμ'0
      (hGen1 _ μ'.2).2
    have eq1 : (μ' : NumberField.RingOfIntegers K)
        = (((⟨c, hcU⟩ : {v : (NumberField.RingOfIntegers K)ˣ //
            KaiMFCongUnit K q v}) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) *
          ((μ : {ν // ν ∈ Gen}) : NumberField.RingOfIntegers K) := by
      rw [← hc]; ring
    have eq2 : (μ' : NumberField.RingOfIntegers K)
        = (((⟨1, h1U⟩ : {v : (NumberField.RingOfIntegers K)ˣ //
            KaiMFCongUnit K q v}) : (NumberField.RingOfIntegers K)ˣ) :
              NumberField.RingOfIntegers K) *
          ((μ' : {ν // ν ∈ Gen}) : NumberField.RingOfIntegers K) := by
      simp
    exact congrArg Prod.fst ((huniq (μ, ⟨c, hcU⟩) eq1).trans
      (huniq (μ', ⟨1, h1U⟩) eq2).symm)
  have hfinsum : Summable (fun _ : ({w : NumberField.InfinitePlace K // w.IsReal} → Bool) =>
      (1 : ℝ)) := Summable.of_finite
  have hmul := Summable.mul_of_nonneg (hZsum σ hσ) hfinsum
    (by intro I; positivity) (by intro x; exact zero_le_one)
  have hprodsummable : Summable
      (fun x : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0} ×
        ({w : NumberField.InfinitePlace K // w.IsReal} → Bool) =>
      (Ideal.absNorm (x.1 : Ideal (NumberField.RingOfIntegers K)) : ℝ) ^ (-σ)) := by
    simpa using hmul
  exact (hprodsummable.comp_injective hJinj).congr (fun μ => rfl)

theorem kai_mf_cone_gamma_places (hGam : KaiMFConeGammaProp)
    {J : Type*} [Fintype J] (a : J → ℝ) (ha : ∀ i, 0 < a i) :
    (∀ z : J → ℂ, (∀ i, 0 < (z i).re) →
        MeasureTheory.Integrable
            (fun u : J → ℝ => ∏ i, Complex.exp (z i * ((u i : ℝ) : ℂ)
                - ((a i * Real.exp (u i) : ℝ) : ℂ)))
            MeasureTheory.volume ∧
          (∫ u : J → ℝ, ∏ i, Complex.exp (z i * ((u i : ℝ) : ℂ)
                - ((a i * Real.exp (u i) : ℝ) : ℂ)))
            = ∏ i, (Complex.Gamma (z i) * ((a i : ℝ) : ℂ) ^ (-(z i)))) ∧
    (∀ c : J → ℝ, (∀ i, 0 < c i) →
        MeasureTheory.Integrable
            (fun u : J → ℝ => ∏ i, Real.exp (c i * u i - a i * Real.exp (u i)))
            MeasureTheory.volume ∧
          (∫ u : J → ℝ, ∏ i, Real.exp (c i * u i - a i * Real.exp (u i)))
            = ∏ i, (Real.Gamma (c i) * a i ^ (-(c i)))) :=
by
  classical
  have key : ∀ b : ℝ, 0 < b → ∀ w : ℂ, 0 < w.re →
      MeasureTheory.Integrable
          (fun x : ℝ => Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)))
          MeasureTheory.volume ∧
        (∫ x : ℝ, Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)))
          = Complex.Gamma w * ((b : ℝ) : ℂ) ^ (-w) := by
    intro b hb w hw
    obtain ⟨hI, hV⟩ := hGam 1 (fun _ => b) (fun _ => hb) (fun _ => w) (fun _ => hw)
    have hmp : MeasureTheory.MeasurePreserving
        (MeasurableEquiv.funUnique (Fin 1) ℝ)
        (MeasureTheory.volume : MeasureTheory.Measure (Fin 1 → ℝ))
        (MeasureTheory.volume : MeasureTheory.Measure ℝ) :=
      MeasureTheory.volume_preserving_funUnique (Fin 1) ℝ
    have hemb : MeasurableEmbedding (MeasurableEquiv.funUnique (Fin 1) ℝ) :=
      (MeasurableEquiv.funUnique (Fin 1) ℝ).measurableEmbedding
    have hfun : (fun u : Fin 1 → ℝ => ∏ i, Complex.exp (w * ((u i : ℝ) : ℂ)
            - ((b * Real.exp (u i) : ℝ) : ℂ)))
        = (fun x : ℝ => Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)))
            ∘ (MeasurableEquiv.funUnique (Fin 1) ℝ) := by
      funext u
      simp [Function.comp_apply, MeasurableEquiv.funUnique_apply, Fin.prod_univ_one]
    have hIpi : MeasureTheory.Integrable
        ((fun x : ℝ => Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)))
            ∘ (MeasurableEquiv.funUnique (Fin 1) ℝ))
        (MeasureTheory.volume : MeasureTheory.Measure (Fin 1 → ℝ)) := by
      rw [← hfun, MeasureTheory.volume_pi]
      exact hI
    have hVal : (∫ x : ℝ, Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)))
        = Complex.Gamma w * ((b : ℝ) : ℂ) ^ (-w) := by
      have h2 : (∫ u : Fin 1 → ℝ, ∏ i, Complex.exp (w * ((u i : ℝ) : ℂ)
              - ((b * Real.exp (u i) : ℝ) : ℂ)))
          = ∫ x : ℝ, Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)) := by
        rw [hfun]
        exact hmp.integral_comp'
          (fun x : ℝ => Complex.exp (w * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ)))
      rw [← h2, MeasureTheory.volume_pi, hV, Fin.prod_univ_one]
    exact ⟨(hmp.integrable_comp_emb hemb).mp hIpi, hVal⟩
  have keyR : ∀ b : ℝ, 0 < b → ∀ γ : ℝ, 0 < γ →
      MeasureTheory.Integrable
          (fun x : ℝ => Real.exp (γ * x - b * Real.exp x)) MeasureTheory.volume ∧
        (∫ x : ℝ, Real.exp (γ * x - b * Real.exp x)) = Real.Gamma γ * b ^ (-γ) := by
    intro b hb γ hγ
    have hre : 0 < ((γ : ℝ) : ℂ).re := by
      rw [Complex.ofReal_re]; exact hγ
    obtain ⟨hI, hV⟩ := key b hb ((γ : ℝ) : ℂ) hre
    have hpt : ∀ x : ℝ, Complex.exp (((γ : ℝ) : ℂ) * (x : ℂ) - ((b * Real.exp x : ℝ) : ℂ))
        = ((Real.exp (γ * x - b * Real.exp x) : ℝ) : ℂ) := by
      intro x
      rw [Complex.ofReal_exp]
      congr 1
      push_cast
      ring
    have hIc : MeasureTheory.Integrable
        (fun x : ℝ => ((Real.exp (γ * x - b * Real.exp x) : ℝ) : ℂ))
        MeasureTheory.volume := by
      simpa only [hpt] using hI
    have hIr : MeasureTheory.Integrable
        (fun x : ℝ => Real.exp (γ * x - b * Real.exp x)) MeasureTheory.volume := by
      simpa only [RCLike.re_to_complex, Complex.ofReal_re] using hIc.re
    refine ⟨hIr, ?_⟩
    have hlin := ContinuousLinearMap.integral_comp_comm Complex.ofRealCLM hIr
    simp only [Complex.ofRealCLM_apply] at hlin
    have hVc : (∫ x : ℝ, ((Real.exp (γ * x - b * Real.exp x) : ℝ) : ℂ))
        = Complex.Gamma ((γ : ℝ) : ℂ) * ((b : ℝ) : ℂ) ^ (-((γ : ℝ) : ℂ)) := by
      simpa only [hpt] using hV
    have hrhs : Complex.Gamma ((γ : ℝ) : ℂ) * ((b : ℝ) : ℂ) ^ (-((γ : ℝ) : ℂ))
        = ((Real.Gamma γ * b ^ (-γ) : ℝ) : ℂ) := by
      rw [Complex.Gamma_ofReal, Complex.ofReal_mul, Complex.ofReal_cpow hb.le,
        Complex.ofReal_neg]
    have hfinal : ((∫ x : ℝ, Real.exp (γ * x - b * Real.exp x) : ℝ) : ℂ)
        = ((Real.Gamma γ * b ^ (-γ) : ℝ) : ℂ) := by
      rw [← hlin, hVc, hrhs]
    exact Complex.ofReal_inj.mp hfinal
  refine ⟨?_, ?_⟩
  · intro z hz
    have hco : ∀ i : J, MeasureTheory.Integrable
        (fun x : ℝ => Complex.exp (z i * (x : ℂ) - ((a i * Real.exp x : ℝ) : ℂ)))
        MeasureTheory.volume := fun i => (key (a i) (ha i) (z i) (hz i)).1
    constructor
    · rw [MeasureTheory.volume_pi]
      exact MeasureTheory.Integrable.fintype_prod
        (f := fun i : J => fun x : ℝ =>
          Complex.exp (z i * (x : ℂ) - ((a i * Real.exp x : ℝ) : ℂ)))
        (μ := fun _ : J => (MeasureTheory.volume : MeasureTheory.Measure ℝ)) hco
    · rw [MeasureTheory.volume_pi,
        MeasureTheory.integral_fintype_prod_eq_prod
          (fun i : J => fun x : ℝ =>
            Complex.exp (z i * (x : ℂ) - ((a i * Real.exp x : ℝ) : ℂ)))]
      exact Finset.prod_congr rfl (fun i _ => (key (a i) (ha i) (z i) (hz i)).2)
  · intro c hc
    have hco : ∀ i : J, MeasureTheory.Integrable
        (fun x : ℝ => Real.exp (c i * x - a i * Real.exp x))
        MeasureTheory.volume := fun i => (keyR (a i) (ha i) (c i) (hc i)).1
    constructor
    · rw [MeasureTheory.volume_pi]
      exact MeasureTheory.Integrable.fintype_prod
        (f := fun i : J => fun x : ℝ => Real.exp (c i * x - a i * Real.exp x))
        (μ := fun _ : J => (MeasureTheory.volume : MeasureTheory.Measure ℝ)) hco
    · rw [MeasureTheory.volume_pi,
        MeasureTheory.integral_fintype_prod_eq_prod
          (fun i : J => fun x : ℝ => Real.exp (c i * x - a i * Real.exp x))]
      exact Finset.prod_congr rfl (fun i _ => (keyR (a i) (ha i) (c i) (hc i)).2)

theorem kai_mf_cone_single_term_mellin {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hGam : KaiMFConeGammaProp)
    (q : Ideal (NumberField.RingOfIntegers K))
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (htr : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0)
    (s : ℂ) (hs : 0 < s.re)
    (μ : NumberField.RingOfIntegers K) (hμ0 : μ ≠ 0)
    (hnorm : ‖kaiHeckeTwist K q t l ξ η μ‖ = 1)
    (harch : kaiHZArchWeight K η l (NumberField.mixedEmbedding K ((μ : K))) *
        ∏ w : NumberField.InfinitePlace K,
          ((w ((μ : K)) : ℝ) : ℂ) ^ (-2 * kaiMFConeZcan K t l η s w)
      = kaiHeckeTwist K q t l ξ η μ /
          ((Ideal.absNorm (Ideal.span {μ}) : ℂ) ^ s)) :
    MeasureTheory.Integrable (fun u : NumberField.InfinitePlace K → ℝ =>
        kaiHZArchWeight K η l (NumberField.mixedEmbedding K ((μ : K))) *
          ((kaiHZGaussian K (fun w => Real.exp (u w))
              (NumberField.mixedEmbedding K ((μ : K))) : ℝ) : ℂ) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s) u) MeasureTheory.volume ∧
    (∫ u : NumberField.InfinitePlace K → ℝ,
        kaiHZArchWeight K η l (NumberField.mixedEmbedding K ((μ : K))) *
          ((kaiHZGaussian K (fun w => Real.exp (u w))
              (NumberField.mixedEmbedding K ((μ : K))) : ℝ) : ℂ) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s) u)
      = ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) / 2) : ℝ) : ℂ) *
          (((Real.pi ^ (-(Module.finrank ℚ K : ℝ) / 2) : ℝ) : ℂ)) ^ s *
          (∏ w : NumberField.InfinitePlace K, Complex.Gamma (kaiMFConeZcan K t l η s w)) *
          (kaiHeckeTwist K q t l ξ η μ /
            ((Ideal.absNorm (Ideal.span {μ}) : ℂ) ^ s)) ∧
    (∫⁻ u : NumberField.InfinitePlace K → ℝ,
        ‖kaiHZArchWeight K η l (NumberField.mixedEmbedding K ((μ : K))) *
          ((kaiHZGaussian K (fun w => Real.exp (u w))
              (NumberField.mixedEmbedding K ((μ : K))) : ℝ) : ℂ) *
          kaiMFConeWeight K (kaiMFConeZcan K t l η s) u‖ₑ)
      = ENNReal.ofReal ((∏ w : NumberField.InfinitePlace K,
            Real.Gamma ((kaiMFConeZcan K t l η s w).re)) *
          Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (kaiMFConeZcan K t l η s w).re)) *
          (Ideal.absNorm (Ideal.span {μ}) : ℝ) ^ (-s.re)) :=
by
  classical
  have hx : ((μ : K)) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hμ0
  have hwx : ∀ w : NumberField.InfinitePlace K, 0 < w ((μ : K)) :=
    fun w => NumberField.InfinitePlace.pos_iff.mpr hx
  have ha : ∀ w : NumberField.InfinitePlace K, 0 < Real.pi * w ((μ : K)) ^ 2 :=
    fun w => mul_pos Real.pi_pos (pow_pos (hwx w) 2)
  have hNpos : 0 < Ideal.absNorm (Ideal.span {μ}) := by
    refine Nat.pos_of_ne_zero (fun h => hμ0 ?_)
    exact Ideal.span_singleton_eq_bot.mp (Ideal.absNorm_eq_zero_iff.mp h)
  set z := kaiMFConeZcan K t l η s with hz
  set A := kaiHZArchWeight K η l (NumberField.mixedEmbedding K ((μ : K))) with hA
  set χ := kaiHeckeTwist K q t l ξ η μ with hχ
  set N := Ideal.absNorm (Ideal.span {μ}) with hN
  
  have hzre : ∀ w, (z w).re = kaiMFConeAlpha K w * s.re + kaiHZDeg K η l w / 2 := by
    intro w
    simp only [hz, kaiMFConeZcan, Complex.add_re, Complex.sub_re, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im]
    ring
  have hdeg : ∀ w, 0 ≤ kaiHZDeg K η l w := by
    intro w
    unfold kaiHZDeg
    split_ifs <;> positivity
  have hmult : ∀ w : NumberField.InfinitePlace K, (1 : ℝ) ≤ (w.mult : ℝ) := by
    intro w
    simp only [NumberField.InfinitePlace.mult]
    split <;> norm_num
  have hzpos : ∀ w, 0 < (z w).re := by
    intro w
    rw [hzre]
    unfold kaiMFConeAlpha
    have h1 := hmult w
    have h2 := hdeg w
    have h3 : 0 < (w.mult : ℝ) / 2 * s.re := mul_pos (by linarith) hs
    linarith
  
  have hfac : ∀ u : NumberField.InfinitePlace K → ℝ,
      A * ((kaiHZGaussian K (fun w => Real.exp (u w))
          (NumberField.mixedEmbedding K ((μ : K))) : ℝ) : ℂ) * kaiMFConeWeight K z u
        = A * ∏ w : NumberField.InfinitePlace K, Complex.exp (z w * ((u w : ℝ) : ℂ)
            - ((Real.pi * w ((μ : K)) ^ 2 * Real.exp (u w) : ℝ) : ℂ)) := by
    intro u
    unfold kaiHZGaussian kaiMFConeWeight
    simp only [NumberField.mixedEmbedding.normAtPlace_apply]
    rw [mul_assoc, Complex.ofReal_exp, ← Complex.exp_add, ← Complex.exp_sum]
    congr 2
    push_cast
    rw [Finset.mul_sum, ← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun w _ => ?_)
    ring
  have hnfac : ∀ u : NumberField.InfinitePlace K → ℝ,
      ‖A * ((kaiHZGaussian K (fun w => Real.exp (u w))
          (NumberField.mixedEmbedding K ((μ : K))) : ℝ) : ℂ) * kaiMFConeWeight K z u‖
        = ‖A‖ * ∏ w : NumberField.InfinitePlace K,
            Real.exp ((z w).re * u w - Real.pi * w ((μ : K)) ^ 2 * Real.exp (u w)) := by
    intro u
    rw [hfac u, norm_mul, norm_prod]
    congr 1
    refine Finset.prod_congr rfl (fun w _ => ?_)
    rw [Complex.norm_exp]
    congr 1
    simp only [Complex.sub_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im]
    ring
  obtain ⟨hGc, hGr⟩ := kai_mf_cone_gamma_places hGam
    (fun w : NumberField.InfinitePlace K => Real.pi * w ((μ : K)) ^ 2) ha
  obtain ⟨hint, hval⟩ := hGc z hzpos
  obtain ⟨hintR, hvalR⟩ := hGr (fun w => (z w).re) hzpos
  have hfun : (fun u : NumberField.InfinitePlace K → ℝ =>
      A * ((kaiHZGaussian K (fun w => Real.exp (u w))
          (NumberField.mixedEmbedding K ((μ : K))) : ℝ) : ℂ) * kaiMFConeWeight K z u)
      = fun u => A * ∏ w : NumberField.InfinitePlace K, Complex.exp (z w * ((u w : ℝ) : ℂ)
            - ((Real.pi * w ((μ : K)) ^ 2 * Real.exp (u w) : ℝ) : ℂ)) := funext hfac
  
  have hcp : ∀ b : ℝ, 0 < b → ∀ c : ℂ,
      ((b : ℝ) : ℂ) ^ c = Complex.exp (((Real.log b : ℝ) : ℂ) * c) := by
    intro b hb c
    rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hb.ne'), Complex.ofReal_log hb.le]
  
  have hm : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)) = (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
  have htr' : (∑ w : NumberField.InfinitePlace K,
      (((w.mult : ℝ) * t w / 2 : ℝ) : ℂ)) = 0 := by
    rw [← Complex.ofReal_sum, ← Finset.sum_div, htr]
    simp
  have hsumz : ∑ w, z w = (((Module.finrank ℚ K : ℝ) / 2 : ℝ) : ℂ) * s
      + (((∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) / 2 : ℝ) : ℂ) := by
    simp only [hz, kaiMFConeZcan, kaiMFConeAlpha]
    rw [Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, htr', mul_zero,
      sub_zero, ← Finset.sum_mul, ← Complex.ofReal_sum, ← Complex.ofReal_sum, ← Finset.sum_div,
      ← Finset.sum_div, hm]
  
  have hvalue : (∏ w : NumberField.InfinitePlace K,
        ((Real.pi * w ((μ : K)) ^ 2 : ℝ) : ℂ) ^ (-(z w)))
      = ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) / 2) : ℝ) : ℂ) *
          (((Real.pi ^ (-(Module.finrank ℚ K : ℝ) / 2) : ℝ) : ℂ)) ^ s *
          ∏ w : NumberField.InfinitePlace K, ((w ((μ : K)) : ℝ) : ℂ) ^ (-2 * z w) := by
    have hlog : ∀ w : NumberField.InfinitePlace K, Real.log (Real.pi * w ((μ : K)) ^ 2)
        = Real.log Real.pi + 2 * Real.log (w ((μ : K))) := by
      intro w
      rw [Real.log_mul Real.pi_pos.ne' (pow_pos (hwx w) 2).ne', Real.log_pow]
      push_cast
      ring
    rw [Finset.prod_congr rfl (fun w _ => by rw [hcp _ (ha w), hlog w]),
      Finset.prod_congr rfl (fun w _ => hcp _ (hwx w) (-2 * z w)),
      hcp _ (Real.rpow_pos_of_pos Real.pi_pos _) s, Real.log_rpow Real.pi_pos,
      Real.rpow_def_of_pos Real.pi_pos, Complex.ofReal_exp, ← Complex.exp_sum,
      ← Complex.exp_sum, ← Complex.exp_add, ← Complex.exp_add]
    congr 1
    have e1 : ∑ w : NumberField.InfinitePlace K,
        (((Real.log Real.pi + 2 * Real.log (w ((μ : K))) : ℝ) : ℂ)) * (-(z w))
        = -((Real.log Real.pi : ℝ) : ℂ) * ∑ w, z w
          + ∑ w : NumberField.InfinitePlace K,
              ((Real.log (w ((μ : K))) : ℝ) : ℂ) * (-2 * z w) := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      push_cast
      ring
    rw [e1, hsumz]
    push_cast
    ring
  
  have hnormarch := congrArg norm harch
  rw [norm_mul, norm_prod, norm_div, hnorm, Complex.norm_natCast_cpow_of_pos hNpos] at hnormarch
  have hAabs : ‖A‖ * ∏ w : NumberField.InfinitePlace K,
      (w ((μ : K))) ^ (-2 * (z w).re) = ((N : ℝ) ^ s.re)⁻¹ := by
    rw [← one_div, ← hnormarch]
    congr 1
    refine Finset.prod_congr rfl (fun w _ => ?_)
    rw [Complex.norm_cpow_eq_rpow_re_of_pos (hwx w)]
    congr 1
    simp
  have habs : ‖A‖ * ∏ w : NumberField.InfinitePlace K,
        (Real.Gamma (z w).re * (Real.pi * w ((μ : K)) ^ 2) ^ (-(z w).re))
      = (∏ w : NumberField.InfinitePlace K, Real.Gamma (z w).re) *
          Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (z w).re)) *
          (N : ℝ) ^ (-s.re) := by
    have hsplit : ∀ w : NumberField.InfinitePlace K,
        (Real.pi * w ((μ : K)) ^ 2) ^ (-(z w).re)
          = Real.pi ^ (-(z w).re) * (w ((μ : K))) ^ (-2 * (z w).re) := by
      intro w
      rw [Real.mul_rpow Real.pi_pos.le (sq_nonneg _), ← Real.rpow_natCast,
        ← Real.rpow_mul (hwx w).le]
      congr 2
      push_cast
      ring
    rw [Finset.prod_congr rfl (fun w _ => by rw [hsplit w]),
      Finset.prod_congr rfl (fun w _ => (mul_assoc _ _ _).symm),
      Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      ← Real.rpow_sum_of_pos Real.pi_pos, Finset.sum_neg_distrib,
      Real.rpow_neg (Nat.cast_nonneg _)]
    linear_combination ((∏ w : NumberField.InfinitePlace K, Real.Gamma (z w).re) *
      Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, (z w).re))) * hAabs
  refine ⟨?_, ?_, ?_⟩
  · rw [hfun]
    exact hint.const_mul A
  · rw [hfun, MeasureTheory.integral_const_mul, hval, Finset.prod_mul_distrib, hvalue,
      ← harch]
    ring
  · have hlin : (fun u : NumberField.InfinitePlace K → ℝ =>
        ‖A * ((kaiHZGaussian K (fun w => Real.exp (u w))
          (NumberField.mixedEmbedding K ((μ : K))) : ℝ) : ℂ) * kaiMFConeWeight K z u‖ₑ)
        = fun u => ENNReal.ofReal (‖A‖ * ∏ w : NumberField.InfinitePlace K,
            Real.exp ((z w).re * u w - Real.pi * w ((μ : K)) ^ 2 * Real.exp (u w))) := by
      funext u
      rw [← ofReal_norm_eq_enorm, hnfac u]
    rw [hlin, ← MeasureTheory.ofReal_integral_eq_lintegral_ofReal (hintR.const_mul _)
      (Filter.Eventually.of_forall (fun u => mul_nonneg (norm_nonneg _)
        (Finset.prod_nonneg (fun w _ => (Real.exp_pos _).le)))),
      MeasureTheory.integral_const_mul, hvalR, habs]

theorem kai_mf_cone_orbit_fubini {J : Type*} [Fintype J] {G U X : Type*} [Countable X]
    (Lat : AddSubgroup (J → ℝ)) (hcount : Countable ↥Lat)
    (F : Set (J → ℝ))
    (hfd : MeasureTheory.IsAddFundamentalDomain (↥Lat) F MeasureTheory.volume)
    (p : U → ↥Lat) (m : ℕ) (hm : 0 < m)
    (hfib : ∀ γ : ↥Lat, Nat.card {v : U // p v = γ} = m)
    (e : G × U ≃ X)
    (Ψ : X → (J → ℝ) → ℂ) (Φ : G → (J → ℝ) → ℂ)
    (hΨcont : ∀ x, Continuous (Ψ x))
    (hequiv : ∀ (g : G) (v : U) (u : J → ℝ), Ψ (e (g, v)) u = Φ g (u + (p v : J → ℝ)))
    (hΦint : ∀ g, MeasureTheory.Integrable (Φ g) MeasureTheory.volume)
    (hfin : (∑' g : G, ∫⁻ u : J → ℝ, ‖Φ g u‖ₑ) ≠ ⊤)
    (f : (J → ℝ) → ℂ) (hfcont : Continuous f)
    (hf : ∀ u, f u = ∑' x : X, Ψ x u) :
    MeasureTheory.IntegrableOn f F MeasureTheory.volume ∧
    (∫ u in F, f u) = (m : ℂ) * ∑' g : G, ∫ u : J → ℝ, Φ g u :=
by
  classical
  haveI : Countable ↥Lat := hcount
  
  have hfibfin : ∀ γ : ↥Lat, Finite {v : U // p v = γ} := by
    intro γ
    have h0 : 0 < Nat.card {v : U // p v = γ} := by
      rw [hfib γ]; exact hm
    exact (Nat.card_pos_iff.mp h0).2
  have hconstE : ∀ (γ : ↥Lat) (x : ENNReal),
      (∑' _c : {v : U // p v = γ}, x) = (m : ENNReal) * x := by
    intro γ x
    haveI := hfibfin γ
    haveI : Fintype {v : U // p v = γ} := Fintype.ofFinite _
    rw [tsum_fintype, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
      hfib γ, nsmul_eq_mul]
  have hconstC : ∀ (γ : ↥Lat) (x : ℂ),
      (∑' _c : {v : U // p v = γ}, x) = (m : ℂ) * x := by
    intro γ x
    haveI := hfibfin γ
    haveI : Fintype {v : U // p v = γ} := Fintype.ofFinite _
    rw [tsum_fintype, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
      hfib γ, nsmul_eq_mul]
  have hcollapseE : ∀ h : ↥Lat → ENNReal,
      (∑' v : U, h (p v)) = (m : ENNReal) * ∑' γ : ↥Lat, h γ := by
    intro h
    calc (∑' v : U, h (p v))
        = ∑' q : (γ : ↥Lat) × {v : U // p v = γ}, h q.1 := by
          rw [← Equiv.tsum_eq (Equiv.sigmaFiberEquiv p) (fun v => h (p v))]
          exact tsum_congr (fun q => congrArg h q.2.2)
      _ = ∑' γ : ↥Lat, ∑' _c : {v : U // p v = γ}, h γ :=
          ENNReal.tsum_sigma' (fun q => h q.1)
      _ = ∑' γ : ↥Lat, (m : ENNReal) * h γ := tsum_congr (fun γ => hconstE γ (h γ))
      _ = (m : ENNReal) * ∑' γ : ↥Lat, h γ := ENNReal.tsum_mul_left
  have hcollapseC : ∀ h : ↥Lat → ℂ, Summable (fun v : U => h (p v)) →
      (∑' v : U, h (p v)) = (m : ℂ) * ∑' γ : ↥Lat, h γ := by
    intro h hsum
    have hS : Summable (fun q : (γ : ↥Lat) × {v : U // p v = γ} => h q.1) := by
      have h0 : Summable ((fun v : U => h (p v)) ∘ (Equiv.sigmaFiberEquiv p)) :=
        (Equiv.summable_iff (Equiv.sigmaFiberEquiv p)).mpr hsum
      exact h0.congr (fun q => congrArg h q.2.2)
    calc (∑' v : U, h (p v))
        = ∑' q : (γ : ↥Lat) × {v : U // p v = γ}, h q.1 := by
          rw [← Equiv.tsum_eq (Equiv.sigmaFiberEquiv p) (fun v => h (p v))]
          exact tsum_congr (fun q => congrArg h q.2.2)
      _ = ∑' γ : ↥Lat, ∑' _c : {v : U // p v = γ}, h γ := hS.tsum_sigma
      _ = ∑' γ : ↥Lat, (m : ℂ) * h γ := tsum_congr (fun γ => hconstC γ (h γ))
      _ = (m : ℂ) * ∑' γ : ↥Lat, h γ := tsum_mul_left
  
  have hshift : ∀ (γ : ↥Lat) (u : J → ℝ), (γ +ᵥ u : J → ℝ) = u + (γ : J → ℝ) := by
    intro γ u
    show (γ : J → ℝ) + u = u + (γ : J → ℝ)
    exact add_comm _ _
  have hunfold : ∀ φ : (J → ℝ) → ℂ,
      (∑' v : U, ∫⁻ u in F, ‖φ (u + (p v : J → ℝ))‖ₑ)
          = (m : ENNReal) * ∫⁻ u : J → ℝ, ‖φ u‖ₑ ∧
        (MeasureTheory.Integrable φ MeasureTheory.volume →
          Summable (fun v : U => ∫ u in F, φ (u + (p v : J → ℝ))) ∧
          (∑' v : U, ∫ u in F, φ (u + (p v : J → ℝ)))
            = (m : ℂ) * ∫ u : J → ℝ, φ u) := by
    intro φ
    have hlint : (∫⁻ u : J → ℝ, ‖φ u‖ₑ)
        = ∑' γ : ↥Lat, ∫⁻ u in F, ‖φ (u + (γ : J → ℝ))‖ₑ := by
      rw [hfd.lintegral_eq_tsum'' (fun u => ‖φ u‖ₑ)]
      exact tsum_congr (fun γ =>
        MeasureTheory.lintegral_congr (fun u => by rw [hshift γ u]))
    have ha : (∑' v : U, ∫⁻ u in F, ‖φ (u + (p v : J → ℝ))‖ₑ)
        = (m : ENNReal) * ∫⁻ u : J → ℝ, ‖φ u‖ₑ := by
      have h1 := hcollapseE (fun γ : ↥Lat => ∫⁻ u in F, ‖φ (u + (γ : J → ℝ))‖ₑ)
      rw [hlint]
      exact h1
    refine ⟨ha, fun hφ => ?_⟩
    have hfinite : (∫⁻ u : J → ℝ, ‖φ u‖ₑ) ≠ ⊤ :=
      ne_of_lt (MeasureTheory.hasFiniteIntegral_iff_enorm.mp hφ.hasFiniteIntegral)
    have hne : (∑' v : U, ∫⁻ u in F, ‖φ (u + (p v : J → ℝ))‖ₑ) ≠ ⊤ := by
      rw [ha]
      exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top m) hfinite
    have hle : (∑' v : U, ((‖∫ u in F, φ (u + (p v : J → ℝ))‖₊ : NNReal) : ENNReal))
        ≤ ∑' v : U, ∫⁻ u in F, ‖φ (u + (p v : J → ℝ))‖ₑ :=
      ENNReal.tsum_le_tsum (fun v => by
        rw [← enorm_eq_nnnorm]
        exact MeasureTheory.enorm_integral_le_lintegral_enorm _)
    have hsum : Summable (fun v : U => ∫ u in F, φ (u + (p v : J → ℝ))) :=
      Summable.of_nnnorm
        (ENNReal.tsum_coe_ne_top_iff_summable.mp (ne_top_of_le_ne_top hne hle))
    refine ⟨hsum, ?_⟩
    have hint : (∫ u : J → ℝ, φ u)
        = ∑' γ : ↥Lat, ∫ u in F, φ (u + (γ : J → ℝ)) := by
      rw [hfd.integral_eq_tsum'' φ hφ]
      refine tsum_congr (fun γ => ?_)
      have hfun : (fun u : J → ℝ => φ (γ +ᵥ u))
          = (fun u : J → ℝ => φ (u + (γ : J → ℝ))) := by
        funext u
        rw [hshift γ u]
      rw [hfun]
    have h2 := hcollapseC (fun γ : ↥Lat => ∫ u in F, φ (u + (γ : J → ℝ))) hsum
    rw [hint]
    exact h2
  
  have hTprod : (∑' c : G × U, ∫⁻ u in F, ‖Φ c.1 (u + (p c.2 : J → ℝ))‖ₑ)
      = ∑' x : X, ∫⁻ u in F, ‖Ψ x u‖ₑ := by
    rw [← Equiv.tsum_eq e (fun x : X => ∫⁻ u in F, ‖Ψ x u‖ₑ)]
    refine tsum_congr (fun c => ?_)
    obtain ⟨g, v⟩ := c
    exact congrArg (fun k : (J → ℝ) → ENNReal => ∫⁻ u in F, k u)
      (funext (fun u => (congrArg (fun z : ℂ => ‖z‖ₑ) (hequiv g v u)).symm))
  have hTmaster : (∑' x : X, ∫⁻ u in F, ‖Ψ x u‖ₑ)
      = (m : ENNReal) * ∑' g : G, ∫⁻ u : J → ℝ, ‖Φ g u‖ₑ := by
    have hsplit : (∑' c : G × U, ∫⁻ u in F, ‖Φ c.1 (u + (p c.2 : J → ℝ))‖ₑ)
        = ∑' g : G, ∑' v : U, ∫⁻ u in F, ‖Φ g (u + (p v : J → ℝ))‖ₑ :=
      ENNReal.tsum_prod (f := fun (g : G) (v : U) =>
        ∫⁻ u in F, ‖Φ g (u + (p v : J → ℝ))‖ₑ)
    rw [← hTprod, hsplit, tsum_congr (fun g => (hunfold (Φ g)).1), ENNReal.tsum_mul_left]
  have hTfin : (∑' x : X, ∫⁻ u in F, ‖Ψ x u‖ₑ) ≠ ⊤ := by
    rw [hTmaster]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top m) hfin
  
  have hlintle : (∫⁻ u in F, ‖f u‖ₑ) ≤ ∑' x : X, ∫⁻ u in F, ‖Ψ x u‖ₑ := by
    calc (∫⁻ u in F, ‖f u‖ₑ)
        ≤ ∫⁻ u in F, ∑' x : X, ‖Ψ x u‖ₑ := by
          refine MeasureTheory.lintegral_mono (fun u => ?_)
          rw [hf u]
          exact enorm_tsum_le_tsum_enorm
      _ = ∑' x : X, ∫⁻ u in F, ‖Ψ x u‖ₑ :=
          MeasureTheory.lintegral_tsum
            (fun x => ((hΨcont x).enorm).measurable.aemeasurable)
  have hconj1 : MeasureTheory.IntegrableOn f F MeasureTheory.volume := by
    refine ⟨hfcont.aestronglyMeasurable, ?_⟩
    rw [MeasureTheory.hasFiniteIntegral_iff_enorm]
    exact lt_of_le_of_lt hlintle (lt_top_iff_ne_top.mpr hTfin)
  refine ⟨hconj1, ?_⟩
  
  have hstep1 : (∫ u in F, f u) = ∑' x : X, ∫ u in F, Ψ x u := by
    have hfun : f = fun u => ∑' x : X, Ψ x u := funext hf
    rw [hfun]
    exact MeasureTheory.integral_tsum
      (fun x => (hΨcont x).aestronglyMeasurable) hTfin
  have hstep2 : (∑' x : X, ∫ u in F, Ψ x u)
      = ∑' c : G × U, ∫ u in F, Φ c.1 (u + (p c.2 : J → ℝ)) := by
    rw [← Equiv.tsum_eq e (fun x : X => ∫ u in F, Ψ x u)]
    refine tsum_congr (fun c => ?_)
    obtain ⟨g, v⟩ := c
    exact congrArg (fun k : (J → ℝ) → ℂ => ∫ u in F, k u)
      (funext (fun u => hequiv g v u))
  have hPsumProd : Summable (fun c : G × U =>
      ∫ u in F, Φ c.1 (u + (p c.2 : J → ℝ))) := by
    have hle : (∑' c : G × U,
          ((‖∫ u in F, Φ c.1 (u + (p c.2 : J → ℝ))‖₊ : NNReal) : ENNReal))
        ≤ ∑' c : G × U, ∫⁻ u in F, ‖Φ c.1 (u + (p c.2 : J → ℝ))‖ₑ := by
      refine ENNReal.tsum_le_tsum (fun c => ?_)
      rw [← enorm_eq_nnnorm]
      exact MeasureTheory.enorm_integral_le_lintegral_enorm _
    have hfin2 : (∑' c : G × U, ∫⁻ u in F, ‖Φ c.1 (u + (p c.2 : J → ℝ))‖ₑ) ≠ ⊤ := by
      rw [hTprod]; exact hTfin
    exact Summable.of_nnnorm (ENNReal.tsum_coe_ne_top_iff_summable.mp
      (lt_of_le_of_lt hle (lt_top_iff_ne_top.mpr hfin2)).ne)
  have hslice : ∀ g : G, Summable (fun v : U =>
      ∫ u in F, Φ g (u + (p v : J → ℝ))) := fun g =>
    ((hunfold (Φ g)).2 (hΦint g)).1
  have hstep3 : (∑' c : G × U, ∫ u in F, Φ c.1 (u + (p c.2 : J → ℝ)))
      = ∑' g : G, ∑' v : U, ∫ u in F, Φ g (u + (p v : J → ℝ)) :=
    hPsumProd.tsum_prod' hslice
  have hstep4 : ∀ g : G, (∑' v : U, ∫ u in F, Φ g (u + (p v : J → ℝ)))
      = (m : ℂ) * ∫ u : J → ℝ, Φ g u := fun g =>
    ((hunfold (Φ g)).2 (hΦint g)).2
  rw [hstep1, hstep2, hstep3, tsum_congr hstep4, tsum_mul_left]

theorem kai_mf_cone_mellin_unfold {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hGam : KaiMFConeGammaProp) (hConv : KaiHZZetaConvProp K)
    (hSharp : KaiMFIdealThetaSharpProp K)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (t : NumberField.InfinitePlace K → ℝ)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (ξ : ((NumberField.RingOfIntegers K ⧸ q)ˣ) →* Circle)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (htr : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * t w = 0)
    (hχu : ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v →
        kaiHeckeTwist K q t l ξ η (v : NumberField.RingOfIntegers K) = 1)
    (b : Ideal (NumberField.RingOfIntegers K)) (hb : b ≠ 0) (hbq : b ⊔ q = ⊤)
    (ρ₀ : NumberField.RingOfIntegers K) (hρ0 : ρ₀ ≠ 0) (hρb : ρ₀ ∈ b)
    (hρq : ρ₀ - 1 ∈ q)
    (Gen : Set (NumberField.RingOfIntegers K))
    (hGen1 : ∀ μ ∈ Gen, μ ≠ 0 ∧ μ - ρ₀ ∈ q * b)
    (hGen2 : ∀ μ : NumberField.RingOfIntegers K, μ ≠ 0 → μ - ρ₀ ∈ q * b →
        ∃! p : {ν // ν ∈ Gen} ×
               {v : (NumberField.RingOfIntegers K)ˣ // KaiMFCongUnit K q v},
          μ = ((p.2 : (NumberField.RingOfIntegers K)ˣ) :
                NumberField.RingOfIntegers K) * (p.1 : NumberField.RingOfIntegers K))
    (Lat : AddSubgroup (NumberField.InfinitePlace K → ℝ)) (hcount : Countable ↥Lat)
    (F : Set (NumberField.InfinitePlace K → ℝ)) (wq : ℕ) (hwq : 0 < wq)
    (hF : MeasurableSet F)
    (hfd : MeasureTheory.IsAddFundamentalDomain (↥Lat) F MeasureTheory.volume)
    (hsh : ∀ v : (NumberField.RingOfIntegers K)ˣ, KaiMFCongUnit K q v →
        kaiMFUnitShift K v ∈ Lat)
    (hfib : ∀ γ : NumberField.InfinitePlace K → ℝ, γ ∈ Lat →
        Nat.card {v : (NumberField.RingOfIntegers K)ˣ //
          KaiMFCongUnit K q v ∧ kaiMFUnitShift K v = γ} = wq)
    (δ : ℂ)
    (hδ1 : ∀ μ : ↥(q * b), NumberField.mixedEmbedding K ((ρ₀ : K)) +
        NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K) = 0 →
        δ = kaiHZArchWeight K η l 0)
    (hδ2 : (∀ μ : ↥(q * b), NumberField.mixedEmbedding K ((ρ₀ : K)) +
        NumberField.mixedEmbedding K ((μ : NumberField.RingOfIntegers K) : K) ≠ 0) →
        δ = 0)
    (s : ℂ) (hs : 1 < s.re) :
    Summable (fun μ : {ν // ν ∈ Gen} =>
        kaiHeckeTwist K q t l ξ η (μ : NumberField.RingOfIntegers K) /
          ((Ideal.absNorm (Ideal.span
            {(μ : NumberField.RingOfIntegers K)}) : ℂ) ^ s)) ∧
    MeasureTheory.IntegrableOn
        (fun u : NumberField.InfinitePlace K → ℝ =>
          (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
              (fun w => Real.exp (u w)) - δ) *
            kaiMFConeWeight K (kaiMFConeZcan K t l η s) u) F MeasureTheory.volume ∧
    (∫ u in F, (kaiHZIdealTheta K (q * b) (NumberField.mixedEmbedding K ((ρ₀ : K))) η l
              (fun w => Real.exp (u w)) - δ) *
            kaiMFConeWeight K (kaiMFConeZcan K t l η s) u)
      = (wq : ℂ) *
          ((Real.pi ^ (-(∑ w : NumberField.InfinitePlace K, kaiHZDeg K η l w) / 2) : ℝ) : ℂ) *
          (((Real.pi ^ (-(Module.finrank ℚ K : ℝ) / 2) : ℝ) : ℂ)) ^ s *
          (∏ w : NumberField.InfinitePlace K,
              Complex.Gamma (kaiMFConeZcan K t l η s w)) *
          ∑' μ : {ν // ν ∈ Gen},
              kaiHeckeTwist K q t l ξ η (μ : NumberField.RingOfIntegers K) /
                ((Ideal.absNorm (Ideal.span
                  {(μ : NumberField.RingOfIntegers K)}) : ℂ) ^ s) :=
by
  classical
  haveI hcO : Countable (NumberField.RingOfIntegers K) :=
    Countable.of_equiv _ (NumberField.RingOfIntegers.basis K).equivFun.toEquiv.symm
  haveI hcLat : Countable ↥Lat := hcount
  
  have hwpos : ∀ ν : NumberField.RingOfIntegers K, ν ≠ 0 →
      ∀ w : NumberField.InfinitePlace K, 0 < w ((ν : K)) := by
    intro ν hν w
    exact NumberField.InfinitePlace.pos_iff.mpr
      (fun h => hν (NumberField.RingOfIntegers.coe_eq_zero_iff.mp h))
  have hNpos : ∀ μ : NumberField.RingOfIntegers K, μ ≠ 0 →
      0 < Ideal.absNorm (Ideal.span {μ}) := by
    intro μ hμ
    refine Nat.pos_of_ne_zero (fun h => hμ ?_)
    exact Ideal.span_singleton_eq_bot.mp (Ideal.absNorm_eq_zero_iff.mp h)
  have hAne : q * b ≠ 0 := by
    intro h
    rw [Submodule.zero_eq_bot, Ideal.mul_eq_bot] at h
    rcases h with h | h
    · exact hq (by rw [Submodule.zero_eq_bot]; exact h)
    · exact hb (by rw [Submodule.zero_eq_bot]; exact h)
  have hmk1 : ∀ x : NumberField.RingOfIntegers K, x - 1 ∈ q →
      Ideal.Quotient.mk q x = 1 := by
    intro x hx
    have h1 : Ideal.Quotient.mk q x = Ideal.Quotient.mk q 1 := Ideal.Quotient.eq.mpr hx
    rw [h1, map_one]
  have hGenq : ∀ μ : NumberField.RingOfIntegers K, μ ∈ Gen → μ - 1 ∈ q := by
    intro μ hμ
    have h2 : μ - ρ₀ ∈ q := Ideal.mul_le_right (hGen1 μ hμ).2
    have h3 : μ - 1 = (μ - ρ₀) + (ρ₀ - 1) := by ring
    rw [h3]
    exact Ideal.add_mem q h2 hρq
  have hxione : ∀ (x : NumberField.RingOfIntegers K)
      (hx : IsUnit (Ideal.Quotient.mk q x)),
      Ideal.Quotient.mk q x = 1 → (ξ hx.unit : ℂ) = 1 := by
    intro x hx h1
    have hu : hx.unit = 1 := Units.ext (by rw [IsUnit.unit_spec, Units.val_one]; exact h1)
    rw [hu, map_one]
    simp
  have hcpow : ∀ y : ℝ, 0 < y → ∀ c : ℂ,
      ((y : ℝ) : ℂ) ^ c = Complex.exp (c * ((Real.log y : ℝ) : ℂ)) := by
    intro y hy c
    rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast ne_of_gt hy),
      ← Complex.ofReal_log hy.le, mul_comm]
  
  obtain ⟨Bsh, -, hshp⟩ := hSharp
