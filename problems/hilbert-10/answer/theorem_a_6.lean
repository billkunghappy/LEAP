                + ∑ l, ∑ l', (z l : ℝ) * (z l' : ℝ) * r₂ l l' k))


def Nil2Isotropic {a b r : ℕ} (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (k : Fin r → Fin a → ℤ) : Prop :=
  ∀ v w : Fin a → ℝ, (∀ m, ∑ i, (k m i : ℝ) * v i = 0) → (∀ m, ∑ i, (k m i : ℝ) * w i = 0) →
    ∑ i, ∑ j, ∑ t, (ξ t : ℝ) * ((Bc i j t : ℝ) - (Bc j i t : ℝ)) * v i * w j = 0


def Nil2Smooth {ν a r : ℕ} (p₁ : Fin ν → Fin a → ℝ) (k : Fin r → Fin a → ℤ) (X N : ℝ) : Prop :=
  ∀ m l, ∃ e : ℤ, |∑ i, (k m i : ℝ) * p₁ l i - (e : ℝ)| ≤ X / N


def IsNil2VertStructSeq (ν : ℕ) (D Q N X : ℝ) (φ : (Fin ν → ℤ) → ℂ) : Prop :=
  ∃ (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ)
    (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ) (r₂ : Fin ν → Fin ν → Fin b → ℝ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) (r : ℕ) (k : Fin r → Fin a → ℤ),
    Nil2VertData D Q Bc ξ F ∧ (∀ z, φ z = nil2Eval p₀ p₁ r₀ r₁ r₂ F z) ∧
    (∀ m i, |(k m i : ℝ)| ≤ X) ∧ Nil2Isotropic Bc ξ k ∧ Nil2Smooth p₁ k X N


def Nil2VertEquidist (ν A : ℕ) : Prop :=
  ∀ (D Q δ : ℝ) (L : ℕ), 1 ≤ D → 2 ≤ Q → 0 < δ → δ ≤ 1 → 1 ≤ L →
  ∀ (a b : ℕ) (Bc : Fin a → Fin a → Fin b → ℤ) (ξ : Fin b → ℤ)
    (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ), Nil2VertData D Q Bc ξ F →
  ∀ (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ) (r₀ : Fin b → ℝ) (r₁ : Fin ν → Fin b → ℝ)
    (r₂ : Fin ν → Fin ν → Fin b → ℝ) (z₀ : Fin ν → ℤ),
    δ * (L : ℝ) ^ ν ≤ ‖∑ z ∈ Finset.Icc z₀ (z₀ + fun _ => ((L : ℤ) - 1)),
        nil2Eval p₀ p₁ r₀ r₁ r₂ F z‖ →
    ∃ (r : ℕ) (k : Fin r → Fin a → ℤ),
      (∀ m i, |(k m i : ℝ)| ≤ Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ A)) ∧
      Nil2Isotropic Bc ξ k ∧
      Nil2Smooth p₁ k (Real.exp ((D + Real.log Q + Real.log (1 / δ)) ^ A)) (L : ℝ)

open scoped Classical in

noncomputable def kaiTypeIForm {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ)
    (Φ χ : NumberField.RingOfIntegers K → ℂ)
    (I : Finset (Ideal (NumberField.RingOfIntegers K)))
    (A : Ideal (NumberField.RingOfIntegers K) → ℂ) (Y : ℝ) : ℂ :=
  ∑ 𝔡 ∈ I, A 𝔡 * ∑ x ∈ (omegaBox ω M).filter
      (fun x => x ∈ 𝔡 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y), χ x * Φ x

open scoped Classical in

noncomputable def kaiTypeIIForm {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ)
    (Φ : NumberField.RingOfIntegers K → ℂ)
    (I₁ I₂ : Finset (Ideal (NumberField.RingOfIntegers K)))
    (L T : Ideal (NumberField.RingOfIntegers K) → ℂ) : ℂ :=
  ∑ 𝔡₁ ∈ I₁, ∑ 𝔡₂ ∈ I₂, L 𝔡₁ * T 𝔡₂ *
    ∑ x ∈ (omegaBox ω M).filter (fun x => Ideal.span {x} = 𝔡₁ * 𝔡₂), Φ x
open scoped Classical in

noncomputable def kaiTypeIInner {K : Type u} [Field K] [NumberField K] {ν : ℕ}
    (ω : Module.Basis (Fin ν) ℤ (NumberField.RingOfIntegers K)) (M : ℝ)
    (Φ χ : NumberField.RingOfIntegers K → ℂ)
    (𝔡 : Ideal (NumberField.RingOfIntegers K)) (Y : ℝ) : ℂ :=
  ∑ x ∈ (omegaBox ω M).filter
      (fun x => x ∈ 𝔡 ∧ ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Y), χ x * Φ x
def kaiBil {ν : ℕ} (c : Fin ν → Fin ν → Fin ν → ℤ) (t w : Fin ν → ℤ) : Fin ν → ℤ :=
  fun l => ∑ k, ∑ i, t k * w i * c k i l
noncomputable def nil2DblBc {a b : ℕ} (Bc : Fin a → Fin a → Fin b → ℤ) :
    Fin (a + a) → Fin (a + a) → Fin (b + b) → ℤ :=
  Fin.append (fun i => Fin.append (fun j => Fin.append (Bc i j) (fun _ => (0 : ℤ)))
                                  (fun _ _ => (0 : ℤ)))
             (fun i => Fin.append (fun _ _ => (0 : ℤ))
                                  (fun j => Fin.append (fun _ => (0 : ℤ)) (Bc i j)))

noncomputable def nil2DblXi {b : ℕ} (ξ : Fin b → ℤ) : Fin (b + b) → ℤ :=
  Fin.append ξ (fun t => -ξ t)

noncomputable def nil2DblF {a b : ℕ} (F : (Fin a → ℝ) × (Fin b → ℝ) → ℂ) :
    (Fin (a + a) → ℝ) × (Fin (b + b) → ℝ) → ℂ :=
  fun u => F (fun i => u.1 (Fin.castAdd a i), fun t => u.2 (Fin.castAdd b t)) *
    (starRingEnd ℂ) (F (fun i => u.1 (Fin.natAdd a i), fun t => u.2 (Fin.natAdd b t)))

noncomputable def nil2DblP1 {ν a : ℕ} (A₁ A₂ : Fin ν → Fin ν → ℤ) (p₁ : Fin ν → Fin a → ℝ) :
    Fin ν → Fin (a + a) → ℝ :=
  fun i => Fin.append (fun j => ∑ l, (A₁ l i : ℝ) * p₁ l j) (fun j => ∑ l, (A₂ l i : ℝ) * p₁ l j)

noncomputable def nil2DblR1 {ν b : ℕ} (A₁ A₂ : Fin ν → Fin ν → ℤ) (r₁ : Fin ν → Fin b → ℝ) :
    Fin ν → Fin (b + b) → ℝ :=
  fun i => Fin.append (fun t => ∑ l, (A₁ l i : ℝ) * r₁ l t) (fun t => ∑ l, (A₂ l i : ℝ) * r₁ l t)

noncomputable def nil2DblR2 {ν b : ℕ} (A₁ A₂ : Fin ν → Fin ν → ℤ)
    (r₂ : Fin ν → Fin ν → Fin b → ℝ) : Fin ν → Fin ν → Fin (b + b) → ℝ :=
  fun i i' => Fin.append (fun t => ∑ l, ∑ l', (A₁ l i : ℝ) * (A₁ l' i' : ℝ) * r₂ l l' t)
                         (fun t => ∑ l, ∑ l', (A₂ l i : ℝ) * (A₂ l' i' : ℝ) * r₂ l l' t)
def kaiVAffineZ (ν : ℕ) (g : (Fin ν → ℤ) → ℝ) : Prop :=
  ∃ (μ : ℝ) (κ : Fin ν → ℝ), ∀ z : Fin ν → ℤ, g z = μ + ∑ l, κ l * (z l : ℝ)
def kaiT2Cube {ν : ℕ} (z₀ : Fin ν → ℤ) (Lc : ℕ) (m : Fin ν → ℕ) : Finset (Fin ν → ℤ) :=
  Finset.Icc (z₀ + fun i => (Lc : ℤ) * (m i : ℤ))
    ((z₀ + fun i => (Lc : ℤ) * (m i : ℤ)) + fun _ => (Lc : ℤ) - 1)
noncomputable def vbSigma (n r : ℕ) (M δ : ℝ) : ℝ :=
  δ / (6 ^ n * ((n : ℝ) * M + 3) ^ r * (4 * (r : ℝ)) ^ r)


noncomputable def vbTau (n r : ℕ) (M δ : ℝ) : ℝ :=
  vbSigma n r M δ / (2 ^ ((n + r) ^ 2) * (3 * ((n + r : ℕ) : ℝ) + 3) ^ (n + r))


noncomputable def vbT (d : ℕ) (τ : ℝ) : ℝ :=
  (Nat.factorial d : ℝ) * (12 ^ d / τ) ^ (d + 2)


noncomputable def vbY (d : ℕ) (T : ℝ) : ℝ :=
  (Nat.factorial (d + 1) : ℝ) ^ 2 * ((d : ℝ) + 1) ^ (d + 1) * T ^ (3 * d + 1)
def vbMinSys {D : Type} [Fintype D] (Γ : AddSubgroup (D → ℝ)) (B : Set (D → ℝ))
    (k : ℕ) (b : Fin k → D → ℝ) (lam : Fin k → ℝ) : Prop :=
  LinearIndependent ℝ b ∧ (∀ i, b i ∈ Γ) ∧ (∀ i, 0 < lam i ∧ lam i ≤ 1) ∧ Monotone lam ∧
  (∀ i (μ : ℝ), lam i < μ → b i ∈ (fun x => μ • x) '' B) ∧
  (∀ i (γ : D → ℝ) (μ : ℝ), γ ∈ Γ → 0 ≤ μ → μ < lam i → γ ∈ (fun x => μ • x) '' B →
      γ ∈ Submodule.span ℝ (b '' {j | j < i}))

theorem kai_euler_product_tail : ∀ (n Δ : ℕ), 1 ≤ n → 1 ≤ Δ → ∀ (β : ℕ → ℝ),
    (∀ p : ℕ, p.Prime → 0 ≤ β p) →
    (∀ p : ℕ, p.Prime → β p ≤ (p : ℝ) ^ (4 * n)) →
    (∀ p : ℕ, p.Prime → 2 * n ≤ p → β p ≤ 16) →
    (∀ p : ℕ, p.Prime → 2 * n ≤ p → ¬ p ∣ Δ → |β p - 1| ≤ 96 * (n : ℝ) ^ 2 / (p : ℝ) ^ 2) →
    ∃ P : ℝ, ((∀ p : ℕ, p.Prime → 0 < β p) → 0 < P) ∧
      ∀ w : ℕ, Δ ≤ w → 384 * n ^ 2 ≤ w →
        |(∏ p ∈ (Finset.range (w + 1)).filter Nat.Prime, β p) - P| ≤
          (2 * (n : ℝ)) ^ (8 * n ^ 2) * Real.exp (96 * (n : ℝ) ^ 2) * (Δ : ℝ) ^ 4 *
            (192 * (n : ℝ) ^ 2) / (w : ℝ) :=
by
  intro n Δ hn hΔ β h0 h1 h2 h3
  
  have hA : ∀ a b : ℕ, 1 ≤ a → a ≤ b →
      ∑ m ∈ Finset.Ioc a b, 1 / (m : ℝ) ^ 2 ≤ 1 / (a : ℝ) - 1 / (b : ℝ) := by
    intro a b ha hab
    induction b, hab using Nat.le_induction with
    | base => simp
    | succ b hab ih =>
      rw [Finset.sum_Ioc_succ_top hab]
      have hb : (1:ℝ) ≤ b := by exact_mod_cast (le_trans ha hab)
      have key : 1 / ((b + 1 : ℕ) : ℝ) ^ 2 ≤ 1 / (b : ℝ) - 1 / ((b + 1 : ℕ) : ℝ) := by
        push_cast
        rw [div_sub_div _ _ (by positivity) (by positivity),
          div_le_div_iff₀ (by positivity) (by positivity)]
        nlinarith
      linarith
  have hA' : ∀ a b : ℕ, 1 ≤ a → ∑ m ∈ Finset.Ioc a b, 1 / (m : ℝ) ^ 2 ≤ 1 / (a : ℝ) := by
    intro a b ha
    by_cases hab : a ≤ b
    · have := hA a b ha hab
      have : (0:ℝ) ≤ 1 / (b : ℝ) := by positivity
      linarith
    · rw [Finset.Ioc_eq_empty (by omega), Finset.sum_empty]
      positivity
  
  have hB1 : ∀ (S : Finset ℕ) (ε : ℕ → ℝ),
      |(∏ i ∈ S, (1 + ε i)) - 1| ≤ (∏ i ∈ S, (1 + |ε i|)) - 1 := by
    intro S ε
    refine Finset.induction_on S ?_ ?_
    · simp
    · intro a S ha ih
      rw [Finset.prod_insert ha, Finset.prod_insert ha]
      have h1 : (1 + ε a) * (∏ i ∈ S, (1 + ε i)) - 1 =
          ((∏ i ∈ S, (1 + ε i)) - 1) + ε a + ε a * ((∏ i ∈ S, (1 + ε i)) - 1) := by ring
      rw [h1]
      have h3' := abs_add_three ((∏ i ∈ S, (1 + ε i)) - 1) (ε a)
        (ε a * ((∏ i ∈ S, (1 + ε i)) - 1))
      rw [abs_mul] at h3'
      have h4 := mul_le_mul_of_nonneg_left ih (abs_nonneg (ε a))
      nlinarith
  
  have hn1 : (1:ℝ) ≤ n := by exact_mod_cast hn
  have hs1 : ∀ T : Finset ℕ, (∀ p ∈ T, p.Prime ∧ p < 2 * n) →
      ∏ p ∈ T, β p ≤ (2 * (n : ℝ)) ^ (8 * n ^ 2) := by
    intro T hT
    have hX1 : (1:ℝ) ≤ (2 * (n:ℝ)) ^ (4 * n) := one_le_pow₀ (by linarith)
    calc ∏ p ∈ T, β p ≤ ∏ p ∈ T, (2 * (n:ℝ)) ^ (4 * n) := by
          apply Finset.prod_le_prod
          · intro p hp; exact h0 p (hT p hp).1
          · intro p hp
            have h := (hT p hp).2
            have hp2' : (p:ℝ) < 2 * n := by exact_mod_cast h
            exact (h1 p (hT p hp).1).trans (pow_le_pow_left₀ (Nat.cast_nonneg _) hp2'.le _)
      _ = ((2 * (n:ℝ)) ^ (4 * n)) ^ T.card := Finset.prod_const _
      _ ≤ ((2 * (n:ℝ)) ^ (4 * n)) ^ (2 * n) := by
          apply pow_le_pow_right₀ hX1
          calc T.card ≤ (Finset.range (2 * n)).card :=
                Finset.card_le_card (fun p hp => Finset.mem_range.2 (hT p hp).2)
            _ = 2 * n := Finset.card_range _
      _ = (2 * (n:ℝ)) ^ (8 * n ^ 2) := by rw [← pow_mul]; congr 1; ring
  
  have hs2 : ∀ T : Finset ℕ, (∀ p ∈ T, p.Prime ∧ 2 * n ≤ p ∧ p ∣ Δ) →
      ∏ p ∈ T, β p ≤ (Δ : ℝ) ^ 4 := by
    intro T hT
    have hdvd : (∏ p ∈ T, p) ∣ Δ :=
      Finset.prod_primes_dvd Δ (fun a ha => (hT a ha).1.prime) (fun a ha => (hT a ha).2.2)
    have hle : (∏ p ∈ T, p) ≤ Δ := Nat.le_of_dvd (by omega) hdvd
    calc ∏ p ∈ T, β p ≤ ∏ p ∈ T, ((p:ℝ) ^ 4) := by
          apply Finset.prod_le_prod
          · intro p hp; exact h0 p (hT p hp).1
          · intro p hp
            have hp2 : (2:ℝ) ≤ p := by exact_mod_cast (hT p hp).1.two_le
            have h16 : (16:ℝ) ≤ (p:ℝ) ^ 4 := by
              calc (16:ℝ) = 2 ^ 4 := by norm_num
                _ ≤ (p:ℝ) ^ 4 := pow_le_pow_left₀ (by norm_num) hp2 4
            exact (h2 p (hT p hp).1 (hT p hp).2.1).trans h16
      _ = ((∏ p ∈ T, p : ℕ) : ℝ) ^ 4 := by rw [Finset.prod_pow, Nat.cast_prod]
      _ ≤ (Δ:ℝ) ^ 4 := pow_le_pow_left₀ (Nat.cast_nonneg _) (by exact_mod_cast hle) 4
  
  have hs3 : ∀ (w : ℕ) (T : Finset ℕ), (∀ p ∈ T, p.Prime ∧ p ≤ w ∧ 2 * n ≤ p ∧ ¬ p ∣ Δ) →
      ∏ p ∈ T, β p ≤ Real.exp (96 * (n : ℝ) ^ 2) := by
    intro w T hT
    have hsum : ∑ p ∈ T, 1 / (p:ℝ) ^ 2 ≤ 1 := by
      calc ∑ p ∈ T, 1 / (p:ℝ) ^ 2 ≤ ∑ m ∈ Finset.Ioc 1 w, 1 / (m:ℝ) ^ 2 := by
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · intro p hp
              rw [Finset.mem_Ioc]
              exact ⟨(hT p hp).1.one_lt, (hT p hp).2.1⟩
            · intro _ _ _; positivity
        _ ≤ 1 / ((1:ℕ):ℝ) := hA' 1 w le_rfl
        _ = 1 := by norm_num
    calc ∏ p ∈ T, β p ≤ ∏ p ∈ T, Real.exp (96 * (n:ℝ) ^ 2 * (1 / (p:ℝ) ^ 2)) := by
          apply Finset.prod_le_prod
          · intro p hp; exact h0 p (hT p hp).1
          · intro p hp
            have h := h3 p (hT p hp).1 (hT p hp).2.2.1 (hT p hp).2.2.2
            have hb : β p ≤ 1 + 96 * (n:ℝ) ^ 2 / (p:ℝ) ^ 2 := by
              linarith [le_abs_self (β p - 1)]
            calc β p ≤ 96 * (n:ℝ) ^ 2 * (1 / (p:ℝ) ^ 2) + 1 := by rw [mul_one_div]; linarith
              _ ≤ _ := Real.add_one_le_exp _
      _ = Real.exp (∑ p ∈ T, 96 * (n:ℝ) ^ 2 * (1 / (p:ℝ) ^ 2)) := (Real.exp_sum _ _).symm
      _ ≤ Real.exp (96 * (n:ℝ) ^ 2) := by
          apply Real.exp_le_exp.2
          rw [← Finset.mul_sum]
          have : (0:ℝ) ≤ 96 * (n:ℝ) ^ 2 := by positivity
          nlinarith
  
  obtain ⟨u, hu⟩ : ∃ u : ℕ → ℝ, ∀ w, u w = ∏ p ∈ (Finset.range (w + 1)).filter Nat.Prime, β p :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : ℕ → ℕ → ℝ, ∀ w w', T w w' =
      ∏ p ∈ ((Finset.range (w' + 1)).filter Nat.Prime).filter (fun p => w < p), β p :=
    ⟨_, fun _ _ => rfl⟩
  
  obtain ⟨M, hM⟩ : ∃ M : ℝ,
      M = (2 * (n : ℝ)) ^ (8 * n ^ 2) * Real.exp (96 * (n : ℝ) ^ 2) * (Δ : ℝ) ^ 4 := ⟨_, rfl⟩
  have hM0 : 0 ≤ M := by rw [hM]; positivity
  have hu0 : ∀ w, 0 ≤ u w := fun w => by
    rw [hu]; exact Finset.prod_nonneg (fun p hp => h0 p (Finset.mem_filter.1 hp).2)
  have key3 : ∀ a b c : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ c → a ≤ (2 * (n : ℝ)) ^ (8 * n ^ 2) →
      b ≤ (Δ : ℝ) ^ 4 → c ≤ Real.exp (96 * (n : ℝ) ^ 2) → a * (b * c) ≤ M := by
    intro a b c ha hb hc hab hbb hcb
    rw [hM]
    calc a * (b * c) ≤ (2 * (n : ℝ)) ^ (8 * n ^ 2) * ((Δ : ℝ) ^ 4 * Real.exp (96 * (n : ℝ) ^ 2)) :=
          mul_le_mul hab (mul_le_mul hbb hcb hc (by positivity)) (mul_nonneg hb hc) (by positivity)
      _ = _ := by ring
  have huM : ∀ w, u w ≤ M := by
    intro w
    rw [hu, ← Finset.prod_filter_mul_prod_filter_not ((Finset.range (w + 1)).filter Nat.Prime)
      (fun p => p < 2 * n),
      ← Finset.prod_filter_mul_prod_filter_not
        (((Finset.range (w + 1)).filter Nat.Prime).filter (fun p => ¬ p < 2 * n)) (fun p => p ∣ Δ)]
    refine key3 _ _ _ (Finset.prod_nonneg ?_) (Finset.prod_nonneg ?_) (Finset.prod_nonneg ?_)
      (hs1 _ ?_) (hs2 _ ?_) (hs3 w _ ?_)
    · intro p hp; simp only [Finset.mem_filter, Finset.mem_range] at hp; exact h0 p hp.1.2
    · intro p hp; simp only [Finset.mem_filter, Finset.mem_range] at hp; exact h0 p hp.1.1.2
    · intro p hp; simp only [Finset.mem_filter, Finset.mem_range] at hp; exact h0 p hp.1.1.2
    · intro p hp; simp only [Finset.mem_filter, Finset.mem_range] at hp; exact ⟨hp.1.2, hp.2⟩
    · intro p hp; simp only [Finset.mem_filter, Finset.mem_range] at hp
      exact ⟨hp.1.1.2, by omega, hp.2⟩
    · intro p hp; simp only [Finset.mem_filter, Finset.mem_range] at hp
      exact ⟨hp.1.1.2, by omega, by omega, hp.2⟩
  
  have hs5 : ∀ w w' : ℕ, Δ ≤ w → 384 * n ^ 2 ≤ w →
      |T w w' - 1| ≤ 192 * (n : ℝ) ^ 2 / (w : ℝ) := by
    intro w w' hΔw h384
    have hw1 : 1 ≤ w := le_trans hΔ hΔw
    have hwpos : (0:ℝ) < w := by exact_mod_cast hw1
    have hn2 : 384 * (n:ℝ) ^ 2 ≤ w := by exact_mod_cast h384
    obtain ⟨F, hF⟩ : ∃ F : Finset ℕ,
        F = ((Finset.range (w' + 1)).filter Nat.Prime).filter (fun p => w < p) := ⟨_, rfl⟩
    have hmem : ∀ p ∈ F, p.Prime ∧ w < p ∧ p ≤ w' := by
      intro p hp
      rw [hF] at hp
      simp only [Finset.mem_filter, Finset.mem_range] at hp
      exact ⟨hp.1.2, hp.2, by omega⟩
    have hε : ∀ p ∈ F, |β p - 1| ≤ 96 * (n:ℝ) ^ 2 / (p:ℝ) ^ 2 := by
      intro p hp
      obtain ⟨hpp, hwp, -⟩ := hmem p hp
      apply h3 p hpp
      · nlinarith
      · intro hd
        have := Nat.le_of_dvd (by omega) hd
        omega
    have hsum : ∑ p ∈ F, |β p - 1| ≤ 96 * (n:ℝ) ^ 2 / w := by
      calc ∑ p ∈ F, |β p - 1| ≤ ∑ p ∈ F, 96 * (n:ℝ) ^ 2 * (1 / (p:ℝ) ^ 2) := by
            apply Finset.sum_le_sum; intro p hp; rw [mul_one_div]; exact hε p hp
        _ = 96 * (n:ℝ) ^ 2 * ∑ p ∈ F, 1 / (p:ℝ) ^ 2 := by rw [Finset.mul_sum]
        _ ≤ 96 * (n:ℝ) ^ 2 * ∑ m ∈ Finset.Ioc w w', 1 / (m:ℝ) ^ 2 := by
            apply mul_le_mul_of_nonneg_left _ (by positivity)
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · intro p hp
              rw [Finset.mem_Ioc]
