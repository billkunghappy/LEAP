        mellin_convergent_iff_norm (Set.Subset.refl _) measurableSet_Ioi haem]
      have hn : ∀ t : ℝ, ‖((max (-(Real.log t)) 0 : ℝ) : ℂ)‖ = max (-(Real.log t)) 0 := by
        intro t
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (le_max_right _ _)]
      simp only [hn]
      rw [← Set.Ioc_union_Ioi_eq_Ioi (zero_le_one : (0:ℝ) ≤ 1)]
      apply MeasureTheory.IntegrableOn.union
