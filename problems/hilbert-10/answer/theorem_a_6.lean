      have hb'le : max (Ep * u) (max (Em * v) T) ≤ Ep * u + max (Em * v) T :=
        max_le (by linarith) (by linarith)
      have hb''le : max (Ep * v) (max (Em * u) T) ≤ Ep * v + max (Em * u) T :=
        max_le (by linarith) (by linarith)
      have hGp := hF' (max (Em * v) T) (max (Ep * u) (max (Em * v) T)) (by linarith)
        (le_max_right _ _)
      have hGm := hF' (max (Em * u) T) (max (Ep * v) (max (Em * u) T)) (by linarith)
