  have hreidx : ∑ x ∈ @Finset.filter (NumberField.RingOfIntegers K)
              (fun x => (fun j => ((ω.equivFun x j : ℤ) : ℝ)) ∈ Ω ∧ x - a ∈ 𝔮)
