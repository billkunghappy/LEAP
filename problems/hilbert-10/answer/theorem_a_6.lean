theorem kai_box_residue_decomp (ν N L : ℕ) (hL : 1 ≤ L) (Ω : Set (Fin ν → ℝ))
    (A : (Fin ν → ℤ) → Prop)
    (hA : ∀ z w : Fin ν → ℤ, (∀ l, z l ≡ w l [ZMOD (L : ℤ)]) → (A z ↔ A w))
    (f : (Fin ν → ℤ) → ℂ) :
    (∑ z ∈ @Finset.filter (Fin ν → ℤ) (fun z => (fun j => ((z j : ℤ) : ℝ)) ∈ Ω ∧ A z)
        (fun _ => Classical.propDecidable _) (intBox ν N), f z)
      = (∑ r ∈ @Finset.filter (Fin ν → ℤ) A (fun _ => Classical.propDecidable _) (resBox ν L),
          ∑ w ∈ @Finset.filter (Fin ν → ℤ)
              (fun w => (fun j => ((w j : ℤ) : ℝ)) ∈
                {u : Fin ν → ℝ | (fun j => (r j : ℝ) + (L : ℝ) * u j) ∈ Ω ∧
                  ∀ j, |(r j : ℝ) + (L : ℝ) * u j| ≤ (N : ℝ)})
              (fun _ => Classical.propDecidable _) (intBox ν (N / L + 1)),
            f (fun j => r j + (L : ℤ) * w j)) ∧
      ∀ r : Fin ν → ℤ, Convex ℝ Ω →
        Convex ℝ {u : Fin ν → ℝ | (fun j => (r j : ℝ) + (L : ℝ) * u j) ∈ Ω ∧
          ∀ j, |(r j : ℝ) + (L : ℝ) * u j| ≤ (N : ℝ)} :=
