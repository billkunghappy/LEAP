            {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ))
          + (∑ w, (h w).im • (Pi.single w Complex.I :
            {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ)) = h := by
      intro h
      rw [← Finset.sum_add_distrib]
