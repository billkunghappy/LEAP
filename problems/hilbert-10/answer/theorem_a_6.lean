    exact hE4 z hz.2 l
  · intro w _
    rfl

theorem kai_quad_poly_affine_subst {ν : ℕ} (p₀ : ℝ) (p₁ : Fin ν → ℝ)
    (p₂ : Fin ν → Fin ν → ℝ) (L : ℕ) (r w : Fin ν → ℤ) :
    kaiQuadPoly p₀ p₁ p₂ (fun l => r l + (L : ℤ) * w l)
      = kaiQuadPoly (kaiQuadPoly p₀ p₁ p₂ r)
          (fun l => (L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)))
          (fun l l' => (L : ℝ) ^ 2 * p₂ l l') w :=
by
  simp only [kaiQuadPoly]
  push_cast
  have h1 : ∑ l, p₁ l * ((r l : ℝ) + (L : ℝ) * (w l : ℝ))
      = ∑ l, p₁ l * (r l : ℝ) + ∑ l, (L : ℝ) * (p₁ l * (w l : ℝ)) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun l _ => by ring
  have h2 : ∑ l, ∑ l', p₂ l l' * ((r l : ℝ) + (L : ℝ) * (w l : ℝ))
        * ((r l' : ℝ) + (L : ℝ) * (w l' : ℝ))
      = ∑ l, ∑ l', p₂ l l' * (r l : ℝ) * (r l' : ℝ)
        + ∑ l, ∑ l', (L : ℝ) ^ 2 * p₂ l l' * (w l : ℝ) * (w l' : ℝ)
        + ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (r l : ℝ) * (w l' : ℝ))
        + ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (w l : ℝ) * (r l' : ℝ)) := by
    simp only [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun l' _ => by ring
  have h3 : ∑ l, (L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)) * (w l : ℝ)
      = ∑ l, (L : ℝ) * (p₁ l * (w l : ℝ))
        + ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (w l : ℝ) * (r l' : ℝ))
        + ∑ l, ∑ l', (L : ℝ) * (p₂ l' l * (r l' : ℝ) * (w l : ℝ)) := by
    simp only [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [mul_add, add_mul, Finset.mul_sum, Finset.sum_mul, add_assoc]
    congr 1
    · ring
    · rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun l' _ => by ring
  have h4 : ∑ l, ∑ l', (L : ℝ) * (p₂ l' l * (r l' : ℝ) * (w l : ℝ))
      = ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (r l : ℝ) * (w l' : ℝ)) := Finset.sum_comm
  rw [h1, h2, h3, h4]
  ring

theorem kai_quad_major_lift_two_cosets (ν N : ℕ) (hN : 1 ≤ N)
    (p₀ : ℝ) (p₁ : Fin ν → ℝ) (p₂ : Fin ν → Fin ν → ℝ)
    (L₁ L₂ N₁ N₂ q₁ q₂ : ℕ) (r₁ r₂ : Fin ν → ℤ) (T₀ : ℝ)
    (hL₁ : 1 ≤ L₁) (hL₂ : 1 ≤ L₂) (hL₁N : L₁ ≤ N) (hL₂N : L₂ ≤ N)
    (hN₁ : (N : ℝ) ≤ (L₁ : ℝ) * N₁) (hN₂ : (N : ℝ) ≤ (L₂ : ℝ) * N₂)
    (hr₁ : ∀ l, 0 ≤ r₁ l ∧ r₁ l < L₁) (hr₂ : ∀ l, 0 ≤ r₂ l ∧ r₂ l < L₂)
    (hT₀ : 0 ≤ T₀)
    (hmaj₁ : KaiQuadMajor ν N₁ q₁ T₀
      (fun w => kaiQuadPoly p₀ p₁ p₂ (fun l => r₁ l + (L₁ : ℤ) * w l)))
    (hmaj₂ : KaiQuadMajor ν N₂ q₂ T₀
      (fun w => kaiQuadPoly p₀ p₁ p₂ (fun l => r₂ l + (L₂ : ℤ) * w l)))
    (hsmall : 8 * (2 * (ν : ℝ) + 1) * T₀ * ((q₁ : ℝ) * q₂) * ((L₁ : ℝ) * L₂) ^ 3 < N) :
    KaiQuadMajor ν N (2 * q₁ * q₂ * (Nat.gcd L₁ L₂) ^ 3)
      ((2 * q₁ * q₂ * (Nat.gcd L₁ L₂) ^ 3 : ℕ) * (2 * (ν : ℝ) + 1) * T₀)
      (kaiQuadPoly p₀ p₁ p₂) :=
by
  
  have hform : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ) (z : Fin ν → ℤ),
      kaiQuadPoly c β Γ z
        = c + ∑ l, β l * (z l : ℝ) + ∑ l, (z l : ℝ) * ∑ l', Γ l l' * (z l' : ℝ) := by
    intro c β Γ z
    unfold kaiQuadPoly
    congr 1
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun l' _ => ?_)
    ring
  have hev0 : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ),
      kaiQuadPoly c β Γ (fun _ => 0) = c := by
    intro c β Γ
    simp [kaiQuadPoly]
  have hev1 : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ) (l : Fin ν),
      kaiQuadPoly c β Γ (fun m => if m = l then 1 else 0) = c + β l + Γ l l := by
    intro c β Γ l
    rw [hform]
    simp [Int.cast_ite, mul_ite, ite_mul, Finset.sum_ite_eq']
  have hev2 : ∀ (c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ) (l l' : Fin ν),
      kaiQuadPoly c β Γ (fun m => (if m = l then 1 else 0) + (if m = l' then 1 else 0))
        = c + β l + β l' + (Γ l l + Γ l l' + Γ l' l + Γ l' l') := by
    intro c β Γ l l'
    rw [hform]
    simp [Int.cast_ite, mul_add, add_mul, Finset.sum_add_distrib, mul_ite, ite_mul,
      Finset.sum_ite_eq']
    ring
  have s2 : ∀ (M q : ℕ) (T c : ℝ) (β : Fin ν → ℝ) (Γ : Fin ν → Fin ν → ℝ),
      KaiQuadMajor ν M q T (kaiQuadPoly c β Γ) →
      1 ≤ q ∧ ∃ (b : Fin ν → ℤ) (a : Fin ν → Fin ν → ℤ),
        (∀ l, |β l - (b l : ℝ) / q| ≤ T / ((q : ℝ) * M)) ∧
        (∀ l l', |Γ l l' + Γ l' l - ((a l l' + a l' l : ℤ) : ℝ) / q|
          ≤ 2 * (T / ((q : ℝ) * (M : ℝ) ^ 2))) := by
    intro M q T c β Γ hmaj
    obtain ⟨hq, γ, b, a, η, θ, hη, hθ, hid⟩ := hmaj
    refine ⟨hq, b, a, ?_⟩
    have hid' : ∀ z, kaiQuadPoly c β Γ z = kaiQuadPoly γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') z := by
      intro z
      rw [hid z]
      simp only [kaiQuadPoly, add_div, Finset.sum_div, add_mul, Finset.sum_add_distrib,
        div_mul_eq_mul_div] <;> ring
    have hQ : ∀ l l', Γ l l' + Γ l' l
        = ((a l l' : ℝ) / q + θ l l') + ((a l' l : ℝ) / q + θ l' l) := by
      intro l l'
      have e2a := hev2 c β Γ l l'
      have e2b := hev2 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l l'
      have e1a := hev1 c β Γ l
      have e1b := hev1 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l
      have e1a' := hev1 c β Γ l'
      have e1b' := hev1 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l'
      have e0a := hev0 c β Γ
      have e0b := hev0 γ (fun l => (b l : ℝ) / q + η l) (fun l l' => (a l l' : ℝ) / q + θ l l')
      have h2 := hid' (fun m => (if m = l then 1 else 0) + (if m = l' then 1 else 0))
      have h1 := hid' (fun m => if m = l then 1 else 0)
      have h1' := hid' (fun m => if m = l' then 1 else 0)
      have h0 := hid' (fun _ => 0)
      linarith
    have hL : ∀ l, β l = (b l : ℝ) / q + η l := by
      intro l
      have e1a := hev1 c β Γ l
      have e1b := hev1 γ (fun l => (b l : ℝ) / q + η l)
        (fun l l' => (a l l' : ℝ) / q + θ l l') l
      have e0a := hev0 c β Γ
      have e0b := hev0 γ (fun l => (b l : ℝ) / q + η l) (fun l l' => (a l l' : ℝ) / q + θ l l')
      have h1 := hid' (fun m => if m = l then 1 else 0)
      have h0 := hid' (fun _ => 0)
      have hll := hQ l l
      linarith
    constructor
    · intro l
      rw [hL l, add_sub_cancel_left]
      exact hη l
    · intro l l'
      have e : Γ l l' + Γ l' l - ((a l l' + a l' l : ℤ) : ℝ) / q = θ l l' + θ l' l := by
        rw [hQ l l']; push_cast; ring
      rw [e]
      have h1 := hθ l l'
      have h2 := hθ l' l
      calc |θ l l' + θ l' l| ≤ |θ l l'| + |θ l' l| := abs_add_le _ _
        _ ≤ 2 * (T / ((q : ℝ) * (M : ℝ) ^ 2)) := by linarith
  have hNr : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hNpos : (0 : ℝ) < N := by linarith
  
  have s3 : ∀ (M L q k : ℕ) (D : ℝ) (r b : Fin ν → ℤ) (a : Fin ν → Fin ν → ℤ),
      1 ≤ L → 1 ≤ q → 1 ≤ k → D = (q : ℝ) * k → (N : ℝ) ≤ (L : ℝ) * M →
      (∀ l, |(L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)) - (b l : ℝ) / q|
          ≤ T₀ / ((q : ℝ) * M)) →
      (∀ l l', |(L : ℝ) ^ 2 * p₂ l l' + (L : ℝ) ^ 2 * p₂ l' l - ((a l l' + a l' l : ℤ) : ℝ) / q|
          ≤ 2 * (T₀ / ((q : ℝ) * (M : ℝ) ^ 2))) →
      (∀ l l', |p₂ l l' + p₂ l' l - (((k : ℤ) * (a l l' + a l' l) : ℤ) : ℝ) / (D * (L : ℝ) ^ 2)|
          ≤ 2 * T₀ / (N : ℝ) ^ 2) ∧
      (∀ l, |p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ) - (((k : ℤ) * b l : ℤ) : ℝ) / (D * L)|
          ≤ T₀ / N) := by
    intro M L q k D r b a hL hq hk hD hNM hb ha
    have hu : (0 : ℝ) < L := by exact_mod_cast hL
    have hqr : (1 : ℝ) ≤ q := by exact_mod_cast hq
    have hkr : (0 : ℝ) < k := by exact_mod_cast hk
    have hune : (L : ℝ) ≠ 0 := hu.ne'
    have hqne : (q : ℝ) ≠ 0 := by positivity
    have hkne : (k : ℝ) ≠ 0 := hkr.ne'
    have hM : (0 : ℝ) < M := by
      rcases Nat.eq_zero_or_pos M with h | h
      · rw [h, Nat.cast_zero, mul_zero] at hNM; linarith
      · exact_mod_cast h
    subst hD
    constructor
    · intro l l'
      have key : p₂ l l' + p₂ l' l - (((k : ℤ) * (a l l' + a l' l) : ℤ) : ℝ)
            / ((q : ℝ) * k * (L : ℝ) ^ 2)
          = ((L : ℝ) ^ 2 * p₂ l l' + (L : ℝ) ^ 2 * p₂ l' l - ((a l l' + a l' l : ℤ) : ℝ) / q)
            / (L : ℝ) ^ 2 := by
        push_cast
        field_simp
      rw [key, abs_div, abs_of_pos (pow_pos hu 2)]
      have hNLM : (N : ℝ) ^ 2 ≤ (q : ℝ) * (M : ℝ) ^ 2 * (L : ℝ) ^ 2 := by
        have h1 : (N : ℝ) ^ 2 ≤ ((L : ℝ) * M) ^ 2 := pow_le_pow_left₀ (by linarith) hNM 2
        have h2 : 0 ≤ (M : ℝ) ^ 2 * (L : ℝ) ^ 2 := by positivity
        nlinarith
      calc _ ≤ 2 * (T₀ / ((q : ℝ) * (M : ℝ) ^ 2)) / (L : ℝ) ^ 2 :=
            div_le_div_of_nonneg_right (ha l l') (by positivity)
        _ = 2 * T₀ / ((q : ℝ) * (M : ℝ) ^ 2 * (L : ℝ) ^ 2) := by rw [mul_div_assoc', div_div]
        _ ≤ 2 * T₀ / (N : ℝ) ^ 2 :=
            div_le_div_of_nonneg_left (by linarith) (pow_pos hNpos 2) hNLM
    · intro l
      have key : p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ) - (((k : ℤ) * b l : ℤ) : ℝ)
            / ((q : ℝ) * k * L)
          = ((L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)) - (b l : ℝ) / q)
            / L := by
        push_cast
        field_simp
      rw [key, abs_div, abs_of_pos hu]
      have hNLM : (N : ℝ) ≤ (q : ℝ) * M * L := by nlinarith [mul_pos hM hu]
      calc _ ≤ T₀ / ((q : ℝ) * M) / L := div_le_div_of_nonneg_right (hb l) hu.le
        _ = T₀ / ((q : ℝ) * M * L) := by rw [div_div]
        _ ≤ T₀ / N := div_le_div_of_nonneg_left hT₀ hNpos hNLM
  
  have s4 : ∀ (s : ℝ) (A B : ℤ) (D : ℝ) (m n : ℕ) (ε : ℝ), 0 < D → 1 ≤ m → 1 ≤ n →
      |s - (A : ℝ) / (D * m)| ≤ ε → |s - (B : ℝ) / (D * n)| ≤ ε → 2 * ε * D * m * n < 1 →
      ∃ C : ℤ, (C : ℝ) / (D * ((Nat.gcd m n : ℕ) : ℝ)) = (A : ℝ) / (D * m) := by
    intro s A B D m n ε hD hm hn hA hB hs
    have hmr : (0 : ℝ) < m := by exact_mod_cast hm
    have hnr : (0 : ℝ) < n := by exact_mod_cast hn
    have hDne : D ≠ 0 := hD.ne'
    have hmne : (m : ℝ) ≠ 0 := hmr.ne'
    have hnne : (n : ℝ) ≠ 0 := hnr.ne'
    have hgpos : 0 < Nat.gcd m n := Nat.gcd_pos_of_pos_left n hm
    have hgr : (0 : ℝ) < ((Nat.gcd m n : ℕ) : ℝ) := by exact_mod_cast hgpos
    have hdiff : |(A : ℝ) / (D * m) - (B : ℝ) / (D * n)| ≤ 2 * ε := by
      have h1 := abs_sub_le ((A : ℝ) / (D * m)) s ((B : ℝ) / (D * n))
      rw [abs_sub_comm ((A : ℝ) / (D * m)) s] at h1
      linarith
    have hint : ((A * n - B * m : ℤ) : ℝ)
        = D * m * n * ((A : ℝ) / (D * m) - (B : ℝ) / (D * n)) := by
      push_cast
      field_simp
    have hDmn : 0 < D * m * n := mul_pos (mul_pos hD hmr) hnr
    have hlt : |((A * n - B * m : ℤ) : ℝ)| < 1 := by
      rw [hint, abs_mul, abs_of_pos hDmn]
      calc D * m * n * |(A : ℝ) / (D * m) - (B : ℝ) / (D * n)| ≤ D * m * n * (2 * ε) :=
            mul_le_mul_of_nonneg_left hdiff hDmn.le
        _ < 1 := by linarith
    have hz : A * n - B * m = 0 := by
      have h' : |A * (n : ℤ) - B * m| < 1 := by
        have : ((|A * (n : ℤ) - B * m| : ℤ) : ℝ) < ((1 : ℤ) : ℝ) := by
          rw [Int.cast_abs, Int.cast_one]; exact hlt
        exact_mod_cast this
      exact Int.abs_lt_one_iff.mp h'
    refine ⟨A * Nat.gcdA m n + B * Nat.gcdB m n, ?_⟩
    have hCm : (A * Nat.gcdA m n + B * Nat.gcdB m n) * (m : ℤ)
        = A * ((Nat.gcd m n : ℕ) : ℤ) := by
      rw [Nat.gcd_eq_gcd_ab]
      linear_combination (-(Nat.gcdB m n)) * hz
    have hCmR : ((A * Nat.gcdA m n + B * Nat.gcdB m n : ℤ) : ℝ) * (m : ℝ)
        = (A : ℝ) * ((Nat.gcd m n : ℕ) : ℝ) := by
      exact_mod_cast hCm
    rw [div_eq_div_iff (mul_pos hD hgr).ne' (mul_pos hD hmr).ne']
    linear_combination D * hCmR
  
  have s5 : ∀ (r Y : Fin ν → ℤ) (Xh : Fin ν → Fin ν → ℤ) (D : ℝ) (L G : ℕ),
      0 < D → 1 ≤ L → 1 ≤ G → L ≤ N → (∀ l, 0 ≤ r l ∧ r l < L) →
      (∀ l, |p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ) - (Y l : ℝ) / (D * L)| ≤ T₀ / N) →
      (∀ l l', |p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)| ≤ 2 * T₀ / (N : ℝ) ^ 2) →
      ∀ l, |p₁ l - ((((G : ℤ) ^ 2 * Y l - (L : ℤ) * ∑ l', Xh l l' * r l' : ℤ) : ℝ)
          / (D * (G : ℝ) ^ 2 * L))| ≤ (2 * (ν : ℝ) + 1) * T₀ / N := by
    intro r Y Xh D L G hD hL hG hLN hr hlin hquad l
    have hLr : (0 : ℝ) < L := by exact_mod_cast hL
    have hGr : (0 : ℝ) < G := by exact_mod_cast hG
    have hLNr : (L : ℝ) ≤ N := by exact_mod_cast hLN
    have hDne : D ≠ 0 := hD.ne'
    have hLne : (L : ℝ) ≠ 0 := hLr.ne'
    have hGne : (G : ℝ) ≠ 0 := hGr.ne'
    have e1 : ∑ l', (p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)) * (r l' : ℝ)
        = ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)
          - (∑ l', (Xh l l' : ℝ) * (r l' : ℝ)) / (D * (G : ℝ) ^ 2) := by
      rw [Finset.sum_div, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun l' _ => ?_)
      ring
    have key : p₁ l - ((((G : ℤ) ^ 2 * Y l - (L : ℤ) * ∑ l', Xh l l' * r l' : ℤ) : ℝ)
          / (D * (G : ℝ) ^ 2 * L))
        = (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ) - (Y l : ℝ) / (D * L))
          - ∑ l', (p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)) * (r l' : ℝ) := by
      rw [e1]
      push_cast
      field_simp
      ring
    rw [key]
    have hterm : ∀ l', |(p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)) * (r l' : ℝ)|
        ≤ 2 * T₀ / N := by
      intro l'
      rw [abs_mul]
      have hr0 : (0 : ℝ) ≤ (r l' : ℝ) := by exact_mod_cast (hr l').1
      have hrL : (r l' : ℝ) ≤ N := by
        have : (r l' : ℝ) < L := by exact_mod_cast (hr l').2
        linarith
      rw [abs_of_nonneg hr0]
      calc _ ≤ 2 * T₀ / (N : ℝ) ^ 2 * N := mul_le_mul (hquad l l') hrL hr0 (by positivity)
        _ = 2 * T₀ / N := by
            rw [div_mul_eq_mul_div, sq, mul_div_mul_right _ _ hNpos.ne']
    have hsum : |∑ l', (p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)) * (r l' : ℝ)|
        ≤ (ν : ℝ) * (2 * T₀ / N) := by
      calc _ ≤ ∑ l', |(p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)) * (r l' : ℝ)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _l' : Fin ν, 2 * T₀ / N := Finset.sum_le_sum (fun l' _ => hterm l')
        _ = (ν : ℝ) * (2 * T₀ / N) := by simp
    calc _ ≤ |p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ) - (Y l : ℝ) / (D * L)|
          + |∑ l', (p₂ l l' + p₂ l' l - (Xh l l' : ℝ) / (D * (G : ℝ) ^ 2)) * (r l' : ℝ)| :=
          abs_sub _ _
      _ ≤ T₀ / N + (ν : ℝ) * (2 * T₀ / N) := add_le_add (hlin l) hsum
      _ = (2 * (ν : ℝ) + 1) * T₀ / N := by ring
  
  have s6 : ∀ (q : ℕ) (T : ℝ) (b : Fin ν → ℤ) (a : Fin ν → Fin ν → ℤ), 1 ≤ q →
      (∀ l, |p₁ l - (b l : ℝ) / q| ≤ T / ((q : ℝ) * N)) →
      (∀ l l', |p₂ l l' + p₂ l' l - 2 * (a l l' : ℝ) / q|
          ≤ 2 * (T / ((q : ℝ) * (N : ℝ) ^ 2))) →
      KaiQuadMajor ν N q T (kaiQuadPoly p₀ p₁ p₂) := by
    intro q T b a hq hb ha
    refine ⟨hq, p₀, b, a, fun l => p₁ l - (b l : ℝ) / q,
      fun l l' => (p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q, hb, ?_, ?_⟩
    · intro l l'
      show |(p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q| ≤ T / ((q : ℝ) * (N : ℝ) ^ 2)
      have e : (p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q
          = (p₂ l l' + p₂ l' l - 2 * (a l l' : ℝ) / q) / 2 := by ring
      rw [e, abs_div, abs_two]
      have := ha l l'
      linarith
    · intro z
      show kaiQuadPoly p₀ p₁ p₂ z = p₀
        + (∑ l, (b l : ℝ) * (z l : ℝ) + ∑ l, ∑ l', (a l l' : ℝ) * (z l : ℝ) * (z l' : ℝ)) / (q : ℝ)
        + ∑ l, (p₁ l - (b l : ℝ) / q) * (z l : ℝ)
        + ∑ l, ∑ l', ((p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q) * (z l : ℝ) * (z l' : ℝ)
      have hsym : ∑ l, ∑ l', p₂ l' l * (z l : ℝ) * (z l' : ℝ)
          = ∑ l, ∑ l', p₂ l l' * (z l : ℝ) * (z l' : ℝ) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun l' _ => ?_))
        ring
      have e1 : ∑ l, (p₁ l - (b l : ℝ) / q) * (z l : ℝ)
          = ∑ l, p₁ l * (z l : ℝ) - (∑ l, (b l : ℝ) * (z l : ℝ)) / q := by
        rw [Finset.sum_div, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        ring
      have e2 : ∑ l, ∑ l', ((p₂ l l' + p₂ l' l) / 2 - (a l l' : ℝ) / q) * (z l : ℝ) * (z l' : ℝ)
          = (∑ l, ∑ l', p₂ l l' * (z l : ℝ) * (z l' : ℝ)) / 2
            + (∑ l, ∑ l', p₂ l' l * (z l : ℝ) * (z l' : ℝ)) / 2
            - (∑ l, ∑ l', (a l l' : ℝ) * (z l : ℝ) * (z l' : ℝ)) / q := by
        rw [Finset.sum_div, Finset.sum_div, Finset.sum_div, ← Finset.sum_add_distrib,
          ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [Finset.sum_div, Finset.sum_div, Finset.sum_div, ← Finset.sum_add_distrib,
          ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun l' _ => ?_)
        ring
      rw [e1, e2, hsym]
      unfold kaiQuadPoly
      ring
  
  
  
  have haff : ∀ (L : ℕ) (r w : Fin ν → ℤ),
      kaiQuadPoly p₀ p₁ p₂ (fun l => r l + (L : ℤ) * w l)
        = kaiQuadPoly (kaiQuadPoly p₀ p₁ p₂ r)
            (fun l => (L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)))
            (fun l l' => (L : ℝ) ^ 2 * p₂ l l') w := by
    intro L r w
    simp only [kaiQuadPoly]
    push_cast
    have h1 : ∑ l, p₁ l * ((r l : ℝ) + (L : ℝ) * (w l : ℝ))
        = ∑ l, p₁ l * (r l : ℝ) + ∑ l, (L : ℝ) * (p₁ l * (w l : ℝ)) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun l _ => by ring
    have h2 : ∑ l, ∑ l', p₂ l l' * ((r l : ℝ) + (L : ℝ) * (w l : ℝ))
          * ((r l' : ℝ) + (L : ℝ) * (w l' : ℝ))
        = ∑ l, ∑ l', p₂ l l' * (r l : ℝ) * (r l' : ℝ)
          + ∑ l, ∑ l', (L : ℝ) ^ 2 * p₂ l l' * (w l : ℝ) * (w l' : ℝ)
          + ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (r l : ℝ) * (w l' : ℝ))
          + ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (w l : ℝ) * (r l' : ℝ)) := by
      simp only [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun l' _ => by ring
    have h3 : ∑ l, (L : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r l' : ℝ)) * (w l : ℝ)
        = ∑ l, (L : ℝ) * (p₁ l * (w l : ℝ))
          + ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (w l : ℝ) * (r l' : ℝ))
          + ∑ l, ∑ l', (L : ℝ) * (p₂ l' l * (r l' : ℝ) * (w l : ℝ)) := by
      simp only [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [mul_add, add_mul, Finset.mul_sum, Finset.sum_mul, add_assoc]
      congr 1
      · ring
      · rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun l' _ => by ring
    have h4 : ∑ l, ∑ l', (L : ℝ) * (p₂ l' l * (r l' : ℝ) * (w l : ℝ))
        = ∑ l, ∑ l', (L : ℝ) * (p₂ l l' * (r l : ℝ) * (w l' : ℝ)) := Finset.sum_comm
    rw [h1, h2, h3, h4]
    ring
  have hfun₁ : (fun w : Fin ν → ℤ => kaiQuadPoly p₀ p₁ p₂ (fun l => r₁ l + (L₁ : ℤ) * w l))
      = kaiQuadPoly (kaiQuadPoly p₀ p₁ p₂ r₁)
          (fun l => (L₁ : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r₁ l' : ℝ)))
          (fun l l' => (L₁ : ℝ) ^ 2 * p₂ l l') :=
    funext fun w => haff L₁ r₁ w
  have hfun₂ : (fun w : Fin ν → ℤ => kaiQuadPoly p₀ p₁ p₂ (fun l => r₂ l + (L₂ : ℤ) * w l))
      = kaiQuadPoly (kaiQuadPoly p₀ p₁ p₂ r₂)
          (fun l => (L₂ : ℝ) * (p₁ l + ∑ l', (p₂ l l' + p₂ l' l) * (r₂ l' : ℝ)))
          (fun l l' => (L₂ : ℝ) ^ 2 * p₂ l l') :=
    funext fun w => haff L₂ r₂ w
  rw [hfun₁] at hmaj₁
  rw [hfun₂] at hmaj₂
  obtain ⟨hq₁, b₁, a₁, hb₁, ha₁⟩ := s2 N₁ q₁ T₀ _ _ _ hmaj₁
  obtain ⟨hq₂, b₂, a₂, hb₂, ha₂⟩ := s2 N₂ q₂ T₀ _ _ _ hmaj₂
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = (q₁ : ℝ) * q₂ := ⟨_, rfl⟩
  obtain ⟨hA₁, hY₁⟩ := s3 N₁ L₁ q₁ q₂ D r₁ b₁ a₁ hL₁ hq₁ hq₂ hDdef hN₁ hb₁ ha₁
  obtain ⟨hA₂, hY₂⟩ := s3 N₂ L₂ q₂ q₁ D r₂ b₂ a₂ hL₂ hq₂ hq₁ (by rw [hDdef, mul_comm]) hN₂ hb₂ ha₂
  obtain ⟨G, hG⟩ : ∃ G : ℕ, G = Nat.gcd L₁ L₂ := ⟨_, rfl⟩
  rw [← hG]
  have hGpos : 1 ≤ G := by rw [hG]; exact Nat.gcd_pos_of_pos_left _ hL₁
  have hGL₁ : G ≤ L₁ := by rw [hG]; exact Nat.gcd_le_left _ hL₁
  have hGL₂ : G ≤ L₂ := by rw [hG]; exact Nat.gcd_le_right _ hL₂
  have hq₁r : (1 : ℝ) ≤ q₁ := by exact_mod_cast hq₁
  have hq₂r : (1 : ℝ) ≤ q₂ := by exact_mod_cast hq₂
  have hL₁r : (1 : ℝ) ≤ L₁ := by exact_mod_cast hL₁
  have hL₂r : (1 : ℝ) ≤ L₂ := by exact_mod_cast hL₂
  have hGr : (1 : ℝ) ≤ G := by exact_mod_cast hGpos
  have hGL₁r : (G : ℝ) ≤ L₁ := by exact_mod_cast hGL₁
  have hGL₂r : (G : ℝ) ≤ L₂ := by exact_mod_cast hGL₂
  have hD1 : 1 ≤ D := by rw [hDdef]; exact one_le_mul_of_one_le_of_one_le hq₁r hq₂r
  have hDpos : 0 < D := by linarith
  have hDne : D ≠ 0 := hDpos.ne'
  have hGne : (G : ℝ) ≠ 0 := by positivity
  have hν : (1 : ℝ) ≤ 2 * (ν : ℝ) + 1 := by
    have := (Nat.cast_nonneg ν : (0 : ℝ) ≤ ν); linarith
  
  have hK1 : (1 : ℝ) ≤ (L₁ : ℝ) * L₂ := one_le_mul_of_one_le_of_one_le hL₁r hL₂r
  have hX : 0 ≤ T₀ * ((q₁ : ℝ) * q₂) := by positivity
  have hbase : 4 * (2 * (ν : ℝ) + 1) * (T₀ * ((q₁ : ℝ) * q₂)) * ((L₁ : ℝ) * L₂) ^ 2 < N := by
    have h1 : 0 ≤ (2 * (ν : ℝ) + 1) * (T₀ * ((q₁ : ℝ) * q₂)) * ((L₁ : ℝ) * L₂) ^ 2 := by
      positivity
    have h2 : 4 ≤ 8 * ((L₁ : ℝ) * L₂) := by linarith
