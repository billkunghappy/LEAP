          _ = B + 2 * c * B := by ring
          _ ≤ B + 2 * c * P := by linarith
          _ < B + 1 := by linarith
      have : A < B + 1 := by exact_mod_cast h3
      omega
    intro κ hκ
    have hρpos : 0 < (j : ℝ) * η := by positivity
    have hN0pos := hNpos _ hρpos
