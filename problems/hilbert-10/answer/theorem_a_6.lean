      (((hasDerivAt_id' σ).sub_const (β : ℂ)).pow n).mul hant.differentiableAt.hasDerivAt
    have hdG : deriv G σ
        = ((n : ℂ) * (σ - (β : ℂ)) ^ (n - 1) * 1) * g σ + (σ - (β : ℂ)) ^ n * deriv g σ := by
      rw [Filter.EventuallyEq.deriv_eq (f := fun w => (w - (β : ℂ)) ^ n * g w) ?_]
      · exact hder.deriv
      · filter_upwards [hGt] with w hw
        simpa [smul_eq_mul] using hw
    have hpow : (σ - (β : ℂ)) * ((n : ℂ) * (σ - (β : ℂ)) ^ (n - 1))
