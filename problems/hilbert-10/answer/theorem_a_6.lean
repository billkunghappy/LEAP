  have key : ∀ (w : (ι → ℝ) → ENNReal), Measurable w →
      (∀ (u : ι → ℝ) (ρ : ℝ), w (fun i => u i + ρ) = w u) →
      ∀ Mw : ENNReal, Mw ≠ ⊤ → (∀ u ∈ G, w u ≤ Mw) →
