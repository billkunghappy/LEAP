        Ideal.Quotient.subsingleton_iff.mpr rfl
      rw [Nat.card_of_subsingleton (0 : NumberField.RingOfIntegers K ⧸
          (⊤ : Ideal (NumberField.RingOfIntegers K)))] at hcard
      have hn1 : 0 < Module.finrank ℚ K := Module.finrank_pos
      have h2 : 2 ≤ 2 ^ Module.finrank ℚ K := by
        calc 2 = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ Module.finrank ℚ K := Nat.pow_le_pow_right (by norm_num) hn1
      omega
    obtain ⟨𝔪, h𝔪max, h𝔪le⟩ := Ideal.exists_le_maximal _ hne
    have h2mem : ((2:ℕ) : NumberField.RingOfIntegers K) ∈ 𝔪 :=
      h𝔪le (Ideal.mem_span_singleton_self _)
    have h𝔪bot : 𝔪 ≠ ⊥ := by
      intro hbot
      rw [hbot, Ideal.mem_bot] at h2mem
      exact (Nat.cast_ne_zero.mpr (by norm_num : (2:ℕ) ≠ 0)) h2mem
    let 𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
      ⟨𝔪, h𝔪max.isPrime, h𝔪bot⟩
    have h2W : 2 ∣ primorial m := by
      unfold primorial
      exact Finset.dvd_prod_of_mem _
        (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), Nat.prime_two⟩)
    have hW : ((primorial m : ℕ) : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal := by
      obtain ⟨k, hk⟩ := h2W
      rw [hk, Nat.cast_mul]
      exact Ideal.mul_mem_right _ _ h2mem
    exact hc 𝔭 hW (Ideal.zero_mem _)
  
  obtain ⟨L, hL_def⟩ : ∃ L : ℕ, L = 2 ^ Ideal.absNorm 𝔮 := ⟨_, rfl⟩
  have hL1 : 1 ≤ L := by rw [hL_def]; exact Nat.one_le_two_pow
  have hQL : Ideal.absNorm 𝔮 < L := by rw [hL_def]; exact Nat.lt_two_pow_self
  have hLpos : (0:ℝ) < (L:ℝ) := by exact_mod_cast hL1
  obtain ⟨I, hI_def⟩ : ∃ I : Finset (ℕ × KaiPattern K),
      I = Finset.range L ×ˢ Finset.univ := ⟨_, rfl⟩
  obtain ⟨H, hH_def⟩ : ∃ H : ℕ × KaiPattern K → NumberField.RingOfIntegers K → ℝ,
      H = fun p => kaiCutoffPiece ω M ρ (primorial m) ψ
        (((((p.1 : ℕ) : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1))) p.2 := ⟨_, rfl⟩
  obtain ⟨g, hg_def⟩ : ∃ g : NumberField.RingOfIntegers K → ℝ,
      g = fun x => (1 / (L : ℝ)) * ∑ p ∈ I, H p x := ⟨_, rfl⟩
  
  have hB₀ : 0 ≤ κ ^ 8 * (C₄ * (C₃ + 1)) / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4) :=
    div_nonneg (mul_nonneg (pow_nonneg hκ0 8) hC₆) hQq.le
  have hpiece : ∀ p ∈ I, gowersU3Pow ω (H p) M
      ≤ κ ^ 8 * (C₄ * (C₃ + 1)) / (Ideal.absNorm 𝔮 : ℝ) ^ ((1:ℝ)/4) := by
    intro p _
    have h3 := hs3 ω 𝔮 h𝔮 ψ hR
    have h2 := kai_norm_cutoff_line_intervals K ω M
      (((((p.1 : ℕ) : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1))) p.2
    have hsub : kaiCutoffSet ω M (((((p.1 : ℕ) : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1))) p.2
        ⊆ ↑(omegaBox ω M) := fun x hx => hx.1
    have h4 := hs4 M m (Ideal.absNorm 𝔮) hM hQ1 hQm' (by linarith) _ hsub h2
    have h5 := kai_orthant_char_lift 𝔮 h𝔮 ψ hR p.2
    have h6 := kai_cutoff_piece_U3 K ρ hρ ω M m (𝔮, ψ, β) hM hm1 hm2 hDt' hψ
      (((((p.1 : ℕ) : ℝ) + 1) / (L : ℝ)) ^ (1 / (β - 1))) p.2 C₃ C₄ (by linarith) hC₄ h3 h4 h5
    rw [hH_def, hκ_def]
    exact h6
  
  have hcardI : I.card ≤ 2 ^ (Ideal.absNorm 𝔮 + Module.finrank ℚ K) := by
    rw [hI_def, Finset.card_product, Finset.card_range, Finset.card_univ, pow_add, ← hL_def]
    apply Nat.mul_le_mul_left
    rw [Fintype.card_eq_nat_card, Nat.card_fun, Nat.card_eq_fintype_card (α := Bool),
      Fintype.card_bool]
    apply Nat.pow_le_pow_right (by norm_num)
    have h := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
    unfold NumberField.InfinitePlace.nrRealPlaces at h
    rw [Fintype.card_eq_nat_card] at h
    omega
  
  have hsumbd := gowersU3Pow_finset_sum_le ω M I H (Ideal.absNorm 𝔮 + Module.finrank ℚ K)
    hcardI _ hB₀ hpiece
  have hg_eq : gowersU3Pow ω g M
      = (1 / (L:ℝ)) ^ 8 * gowersU3Pow ω (fun x => ∑ p ∈ I, H p x) M := by
