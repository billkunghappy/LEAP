    intro w hw
    rw [Metric.mem_closedBall, dist_eq_norm] at hw
    have hre : |(w - z).re| ≤ 1 := (Complex.abs_re_le_norm _).trans hw
    have him : |(w - z).im| ≤ 1 := (Complex.abs_im_le_norm _).trans hw
    rw [Complex.sub_re] at hre
    rw [Complex.sub_im] at him
    obtain ⟨hre1, hre2⟩ := abs_le.mp hre
    have hwim : |w.im| ≤ 2 * |τ| + 1 := by
      have := abs_sub_abs_le_abs_sub w.im z.im
      linarith
    refine ⟨(Ideal.absNorm q : ℝ) * 2 * (2 + |w.im|), by positivity, ?_, ?_⟩
    · rw [hexpL]
      have h1 : 2 + |w.im| ≤ 2 * (2 + |τ|) := by linarith [abs_nonneg τ]
      have h2 : (Ideal.absNorm q : ℝ) * 2 * (2 + |w.im|)
          ≤ (Ideal.absNorm q : ℝ) * 2 * (2 * (2 + |τ|)) :=
        mul_le_mul_of_nonneg_left h1 (by positivity)
      nlinarith
    · exact H2 q hq ξ η mu hext E f hE hEiff hf hfeq w (by linarith) (by linarith)
  
  obtain ⟨-, hlowS, -, hderiv, -⟩ := hbas q ξ η mu hq hext
  have hfne : ∀ w : ℂ, 1 < w.re → f w ≠ 0 := by
    intro w hw
    have hlw := hlowS w hw
    have hLw : kaiHeckeSeries K mu w ≠ 0 := by
      intro h0; rw [h0, norm_zero, zero_mul] at hlw; linarith
    have hnz1 : w.re - 1 ≤ ‖w - 1‖ := by
      have := Complex.re_le_norm (w - 1)
      simpa using this
    have hw1 : w - 1 ≠ 0 := by
      intro h0; rw [h0, norm_zero] at hnz1; linarith
    rw [← hfeq w hw]; exact mul_ne_zero hLw (pow_ne_zero _ hw1)
  have hδz : 0 < z.re - 1 := by linarith
  have hlowz := hlowS z hzre1
  have hLz0 : kaiHeckeSeries K mu z ≠ 0 := by
    intro h0; rw [h0, norm_zero, zero_mul] at hlowz; linarith
  have hnz1 : z.re - 1 ≤ ‖z - 1‖ := by
    have := Complex.re_le_norm (z - 1)
    simpa using this
  have hz1 : z - 1 ≠ 0 := by
    intro h0; rw [h0, norm_zero] at hnz1; linarith
  have hfzeq : f z = kaiHeckeSeries K mu z * (z - 1) ^ E := (hfeq z hzre1).symm
  have hfz : f z ≠ 0 := by rw [hfzeq]; exact mul_ne_zero hLz0 (pow_ne_zero _ hz1)
  have hlow : 1 ≤ ‖f z‖ * (1 + 1 / (z.re - 1)) ^ (Module.finrank ℚ K + 1) := by
    have hinv0 : 0 ≤ 1 / (z.re - 1) := by positivity
    have hfac : 1 ≤ ‖z - 1‖ ^ E * (1 + 1 / (z.re - 1)) := by
      rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hE with h | h
      · subst h; rw [pow_zero, one_mul]; linarith
      · subst h
        rw [pow_one]
        have e : (z.re - 1) * (1 + 1 / (z.re - 1)) = z.re - 1 + 1 := by
          field_simp
        calc (1 : ℝ) ≤ (z.re - 1) * (1 + 1 / (z.re - 1)) := by rw [e]; linarith
          _ ≤ ‖z - 1‖ * (1 + 1 / (z.re - 1)) :=
            mul_le_mul_of_nonneg_right hnz1 (by linarith)
    rw [hfzeq, norm_mul, norm_pow, pow_succ]
    calc (1 : ℝ) ≤ (‖kaiHeckeSeries K mu z‖ * (1 + 1 / (z.re - 1)) ^ Module.finrank ℚ K)
          * (‖z - 1‖ ^ E * (1 + 1 / (z.re - 1))) := one_le_mul_of_one_le_of_one_le hlowz hfac
      _ = ‖kaiHeckeSeries K mu z‖ * ‖z - 1‖ ^ E
          * ((1 + 1 / (z.re - 1)) ^ Module.finrank ℚ K * (1 + 1 / (z.re - 1))) := by ring
  have hinv : 1 / (z.re - 1) = L / x := by
    rw [hzre, add_sub_cancel_left, one_div_div]
  rw [hinv] at hlow
  obtain ⟨hdiff, hldS⟩ := hderiv z hzre1
  have hopen : IsOpen {w : ℂ | 1 < w.re} := isOpen_lt continuous_const Complex.continuous_re
  have hev : f =ᶠ[nhds z] (fun w => kaiHeckeSeries K mu w * (w - 1) ^ E) := by
    filter_upwards [hopen.mem_nhds hzre1] with w hw
    exact (hfeq w hw).symm
  have hld : deriv f z / f z = - kaiZFHeckeLogSum K mu z + (E : ℂ) / (z - 1) := by
    rw [hev.deriv_eq, hfzeq, ← hldS]
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hE with h | h
    · subst h; simp
    · subst h
      simp only [pow_one, Nat.cast_one]
      have hd : HasDerivAt (fun w => kaiHeckeSeries K mu w * (w - 1))
