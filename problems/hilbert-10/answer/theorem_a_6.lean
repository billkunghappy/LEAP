        Complex.exp (-(2 * Real.pi * Complex.I * (s' : ℂ))) := by
    intro s s'
    rw [← Complex.exp_add]; congr 1; push_cast; ring
  have hint : ∀ m : ℤ, Complex.exp (-(2 * Real.pi * Complex.I * (((m : ℝ)) : ℂ))) = 1 := by
