      rw [Complex.mem_reProdIm, huIcc1, huIcc2, Set.mem_Icc, Set.mem_Icc] at hz
      exact (hf z hz.1.1 hz.1.2 (abs_le.mpr ⟨hz.2.1, hz.2.2⟩)).differentiableWithinAt
    have hnhds : (Set.uIcc a b ×ℂ Set.uIcc (-T) T) ∈ nhds ((c : ℝ) : ℂ) := by
      rw [mem_nhds_iff]
      refine ⟨Set.Ioo a b ×ℂ Set.Ioo (-T) T, ?_, IsOpen.reProdIm isOpen_Ioo isOpen_Ioo, ?_⟩
      · intro z hz
