      obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun i => |φ (f i)|)
        ⟨i₀, Finset.mem_univ i₀⟩
      refine ⟨f j, Finset.mem_image_of_mem f (Finset.mem_univ j), ?_⟩
      intro y
      have hstep1 := Finset.sum_le_sum (s := (Finset.univ : Finset _))
        (f := fun i => |φ (f i)|) (g := fun _ => |φ (f j)|)
