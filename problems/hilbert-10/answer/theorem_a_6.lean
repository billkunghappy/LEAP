theorem kai_v_nil2_diff_structure (ν : ℕ) (D Q : ℝ) (hD : 1 ≤ D) (hQ : 2 ≤ Q)
    (φ : (Fin ν → ℤ) → ℂ) (hφ : IsNil2VertSeq ν D Q φ) :
    ∃ (a : ℕ) (p₀ : Fin a → ℝ) (p₁ : Fin ν → Fin a → ℝ), (a : ℝ) ≤ D ∧
      (∀ z, ‖φ z‖ ≤ Q) ∧
      ∀ y : Fin ν → ℤ, ∃ (μ : ℝ) (κ : Fin ν → ℝ) (K : (Fin a → ℝ) → ℂ),
        (∀ u, ‖K u‖ ≤ Q ^ 2) ∧
        (∀ u (γ : Fin a → ℤ), K (fun i => u i + (γ i : ℝ)) = K u) ∧
        (∀ u v, ‖K u - K v‖ ≤ 8 * D ^ 2 * Q ^ 4 * ∑ i, |u i - v i|) ∧
        ∀ z : Fin ν → ℤ, φ (z + y) * starRingEnd ℂ (φ z) =
          giE (μ + ∑ l, κ l * (z l : ℝ)) * K (fun i => p₀ i + ∑ l, (z l : ℝ) * p₁ l i) :=
by
  classical
  
  have G1 : ∀ s t : ℝ, giE (s + t) = giE s * giE t := by
    intro s t; unfold giE; rw [← Complex.exp_add]; congr 1; push_cast; ring
  have G0 : giE 0 = 1 := by unfold giE; simp
  have G2 : ∀ s : ℝ, starRingEnd ℂ (giE s) = giE (-s) := by
    intro s; unfold giE; rw [← Complex.exp_conj]; congr 1
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]; push_cast; ring
  have G3 : ∀ s : ℝ, ‖giE s‖ = 1 := by
    intro s
    have : giE s = Complex.exp (((2 * Real.pi * s : ℝ) : ℂ) * Complex.I) := by
      unfold giE; congr 1; push_cast; ring
    rw [this, Complex.norm_exp_ofReal_mul_I]
  have G4 : ∀ s s' : ℝ, ‖giE s - giE s'‖ ≤ 2 * Real.pi * |s - s'| := by
    intro s s'
    have e0 : s' + (s - s') = s := by ring
    have h1 : giE s - giE s' = giE s' * (giE (s - s') - 1) := by
      rw [mul_sub, ← G1, mul_one, e0]
    have h2 : giE (s - s') = Complex.exp (Complex.I * ((2 * Real.pi * (s - s') : ℝ) : ℂ)) := by
      unfold giE; congr 1; push_cast; ring
    rw [h1, norm_mul, G3, one_mul, h2]
    refine (Real.norm_exp_I_mul_ofReal_sub_one_le).trans ?_
    rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 2),
      abs_of_pos Real.pi_pos]
  
  have A_const : ∀ m : ℝ, kaiVAffineZ ν (fun _ => m) :=
    fun m => ⟨m, fun _ => 0, fun z => by simp⟩
  have A_coord : ∀ l₀ : Fin ν, kaiVAffineZ ν (fun z => (z l₀ : ℝ)) :=
    fun l₀ => ⟨0, fun l => if l = l₀ then 1 else 0, fun z => by simp⟩
  have A_add : ∀ g h : (Fin ν → ℤ) → ℝ, kaiVAffineZ ν g → kaiVAffineZ ν h →
      kaiVAffineZ ν (fun z => g z + h z) := by
    rintro g h ⟨μ₁, κ₁, h₁⟩ ⟨μ₂, κ₂, h₂⟩
    refine ⟨μ₁ + μ₂, fun l => κ₁ l + κ₂ l, fun z => ?_⟩
    beta_reduce
    rw [h₁ z, h₂ z]; simp only [add_mul, Finset.sum_add_distrib]; ring
  have A_sub : ∀ g h : (Fin ν → ℤ) → ℝ, kaiVAffineZ ν g → kaiVAffineZ ν h →
      kaiVAffineZ ν (fun z => g z - h z) := by
    rintro g h ⟨μ₁, κ₁, h₁⟩ ⟨μ₂, κ₂, h₂⟩
    refine ⟨μ₁ - μ₂, fun l => κ₁ l - κ₂ l, fun z => ?_⟩
    beta_reduce
    rw [h₁ z, h₂ z]; simp only [sub_mul, Finset.sum_sub_distrib]; ring
  have A_smul : ∀ (m : ℝ) (g : (Fin ν → ℤ) → ℝ), kaiVAffineZ ν g →
      kaiVAffineZ ν (fun z => m * g z) := by
    rintro m g ⟨μ₁, κ₁, h₁⟩
    refine ⟨m * μ₁, fun l => m * κ₁ l, fun z => ?_⟩
    beta_reduce
    rw [h₁ z, mul_add, Finset.mul_sum]; simp only [mul_assoc]
  have A_mulr : ∀ (m : ℝ) (g : (Fin ν → ℤ) → ℝ), kaiVAffineZ ν g →
      kaiVAffineZ ν (fun z => g z * m) := by
    rintro m g ⟨μ₁, κ₁, h₁⟩
    refine ⟨μ₁ * m, fun l => κ₁ l * m, fun z => ?_⟩
    beta_reduce
    rw [h₁ z, add_mul, Finset.sum_mul]; congr 1
    exact Finset.sum_congr rfl (fun l _ => by ring)
  have A_sum : ∀ (m : ℕ) (g : Fin m → (Fin ν → ℤ) → ℝ), (∀ i, kaiVAffineZ ν (g i)) →
      kaiVAffineZ ν (fun z => ∑ i, g i z) := by
    intro m g hg
    have hg' : ∀ i, ∃ (μ : ℝ) (κ : Fin ν → ℝ), ∀ z : Fin ν → ℤ,
        g i z = μ + ∑ l, κ l * (z l : ℝ) := hg
    choose μ κ hμ using hg'
    exact ⟨∑ i, μ i, fun l => ∑ i, κ i l, fun z => by
      simp only [hμ, Finset.sum_add_distrib, Finset.sum_mul]; congr 1; exact Finset.sum_comm⟩
  
