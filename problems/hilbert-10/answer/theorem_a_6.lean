              {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ)
            + (h w).im • (Pi.single w Complex.I :
              {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ)
            = Pi.single w (h w) := by
        intro w
        rw [← Pi.single_smul, ← Pi.single_smul, ← Pi.single_add]
        congr 1
        rw [Complex.real_smul, Complex.real_smul, mul_one, Complex.re_add_im]
