          Complex.exp (-((Real.pi : ℂ) / (y : ℂ)) * (((u.re : ℂ)) ^ 2 + ((u.im : ℂ)) ^ 2)))
            * Complex.re_add_im u
        + (Complex.exp (-((Real.pi : ℂ) / (y : ℂ)) * (((u.re : ℂ)) ^ 2 + ((u.im : ℂ)) ^ 2))
            * c * (n : ℂ) * u ^ (n - 1)) * Complex.I_mul_I
    have hsc : ∀ Z : ℂ, Complex.I / (2 * (Real.pi : ℂ)) *
        (-(2 * (Real.pi : ℂ) / (y : ℂ)) * Z) = -(Complex.I / (y : ℂ)) * Z := by
      intro Z
      have hpiC : ((Real.pi : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
      have hyC : ((y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hy.ne'
      field_simp
    have H : ∀ n : ℕ, ∀ u : ℂ,
        FourierTransform.fourier
            (fun z : ℂ => z ^ n * Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ))) u
          = (-Complex.I) ^ n * ((y ^ (-(1 + (n : ℝ))) : ℝ) : ℂ) * u ^ n *
              Complex.exp (((-(Real.pi * ‖u‖ ^ 2 / y) : ℝ) : ℂ)) := by
      intro n
      induction n with
      | zero =>
          intro u
          simp only [pow_zero, one_mul, mul_one, Nat.cast_zero, add_zero]
          exact hbase u
      | succ n IH =>
          intro u
          have hFT : FourierTransform.fourier
              (fun z : ℂ => z ^ n * Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ)))
                = (fun t : ℂ => (-Complex.I) ^ n * ((y ^ (-(1 + (n : ℝ))) : ℝ) : ℂ) * t ^ n *
                    Complex.exp (((-(Real.pi * ‖t‖ ^ 2 / y) : ℝ) : ℂ))) := funext IH
          have hstep := hrec
            (fun z : ℂ => z ^ n * Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ)))
            (hint1 n) (hint2 n) u
          have hmono : (fun v : ℂ =>
                v * (v ^ n * Complex.exp (((-(Real.pi * y * ‖v‖ ^ 2) : ℝ) : ℂ))))
              = (fun z : ℂ => z ^ (n + 1) *
                  Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ))) := by
            funext v; ring
          rw [hmono, hFT,
            hcrux ((-Complex.I) ^ n * ((y ^ (-(1 + (n : ℝ))) : ℝ) : ℂ)) n u, hsc] at hstep
          have hr : (y ^ (-(1 + ((n + 1 : ℕ) : ℝ))) : ℝ)
              = y ^ (-(1 + (n : ℝ))) * y⁻¹ := by
            rw [show (-(1 + ((n + 1 : ℕ) : ℝ))) = (-(1 + (n : ℝ))) + (-1) by push_cast; ring,
              Real.rpow_add hy, Real.rpow_neg_one]
          rw [hstep, hr]
          push_cast
          ring
    exact H k w
  
  have hzbar : ∀ y : ℝ, 0 < y → ∀ k : ℕ, ∀ w : ℂ,
      FourierTransform.fourier
          (fun z : ℂ => ((starRingEnd ℂ) z) ^ k *
            Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ))) w
        = (-Complex.I) ^ k * ((y ^ (-(1 + (k : ℝ))) : ℝ) : ℂ) * ((starRingEnd ℂ) w) ^ k *
            Complex.exp (((-(Real.pi * ‖w‖ ^ 2 / y) : ℝ) : ℂ)) := by
    intro y hy k w
    have hstar : ∀ (g : ℂ → ℂ) (v : ℂ),
        FourierTransform.fourier (fun z : ℂ => (starRingEnd ℂ) (g z)) v
          = (starRingEnd ℂ) (FourierTransform.fourier g (-v)) := by
      intro g v
      rw [Real.fourier_eq, Real.fourier_eq, ← integral_conj]
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
      dsimp only
      rw [inner_neg_right, neg_neg, Circle.smul_def, Circle.smul_def, smul_eq_mul,
        smul_eq_mul, map_mul, ← Circle.coe_inv_eq_conj, ← AddChar.map_neg_eq_inv]
    have hfun : (fun z : ℂ => ((starRingEnd ℂ) z) ^ k *
          Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ)))
        = fun z : ℂ => (starRingEnd ℂ)
            (z ^ k * Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ))) := by
      funext z
      rw [map_mul, map_pow, ← Complex.exp_conj, Complex.conj_ofReal]
    rw [hfun, hstar, hz y hy k (-w), norm_neg]
    rw [map_mul, map_mul, map_mul, map_pow, map_pow, Complex.conj_neg_I,
      Complex.conj_ofReal, ← Complex.exp_conj, Complex.conj_ofReal, map_neg,
      neg_pow ((starRingEnd ℂ) w) k, neg_pow Complex.I k]
    ring
  
  constructor
  · intro y hy ε hε
    interval_cases ε
    · refine ⟨1, norm_one, fun ξ => ?_⟩
      have e0 : ((1 : ℝ) / 2 + ((0 : ℕ) : ℝ)) = (1 : ℝ) / 2 := by push_cast; ring
      simp only [pow_zero, one_mul, mul_one, e0]
      exact hg0 y hy ξ
    · refine ⟨-Complex.I, by simp, fun ξ => ?_⟩
      have e1 : ((1 : ℝ) / 2 + ((1 : ℕ) : ℝ)) = (3 : ℝ) / 2 := by push_cast; ring
      simp only [pow_one, e1]
      exact hlin y hy ξ
  · intro y hy l
    by_cases hl : 0 ≤ l
    · refine ⟨(-Complex.I) ^ l.toNat, by simp, fun w => ?_⟩
      have hwt : ∀ z : ℂ, kaiHZCplxWeight l z = z ^ l.toNat := by
        intro z
        simp [kaiHZCplxWeight, hl]
      have habs : |(l : ℝ)| = ((l.toNat : ℕ) : ℝ) := by
        have hcast : ((l.toNat : ℕ) : ℤ) = l := Int.toNat_of_nonneg hl
        have hl' : (0 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
        rw [abs_of_nonneg hl']
        exact_mod_cast hcast.symm
      simp only [hwt, habs]
      exact hz y hy l.toNat w
    · refine ⟨(-Complex.I) ^ (-l).toNat, by simp, fun w => ?_⟩
      have hlneg : l < 0 := lt_of_not_ge hl
      have hwt : ∀ z : ℂ, kaiHZCplxWeight l z = ((starRingEnd ℂ) z) ^ (-l).toNat := by
        intro z
        simp [kaiHZCplxWeight, hl]
      have habs : |(l : ℝ)| = (((-l).toNat : ℕ) : ℝ) := by
        have hcast : (((-l).toNat : ℕ) : ℤ) = -l := Int.toNat_of_nonneg (by omega)
        have hl' : (l : ℝ) < 0 := by exact_mod_cast hlneg
        rw [abs_of_neg hl']
        exact_mod_cast hcast.symm
      simp only [hwt, habs]
      exact hzbar y hy (-l).toNat w

theorem kai_hz_mixed_euclid_coords (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ Φ : (NumberField.mixedEmbedding.mixedSpace K) ≃ₗ[ℝ]
            EuclideanSpace ℝ (Fin (Module.finrank ℚ K)),
      (∀ x v : NumberField.mixedEmbedding.mixedSpace K,
          (inner ℝ (Φ x) (Φ v) : ℝ) = kaiHZMixedInner K x v) ∧
      MeasureTheory.MeasurePreserving (⇑Φ)
          MeasureTheory.volume MeasureTheory.volume ∧
      (∀ β : Module.Basis (Fin (Module.finrank ℚ K)) ℝ
              (NumberField.mixedEmbedding.mixedSpace K),
          |(Matrix.of fun i j => Φ (β i) j).det|
            = (MeasureTheory.volume (ZSpan.fundamentalDomain β)).toReal) :=
by
  classical
  have c1 : ∀ (y : NumberField.mixedEmbedding.mixedSpace K)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      kaiHZCoord K y (Sum.inl w) = y.1 w := fun _ _ => rfl
  have c2 : ∀ (y : NumberField.mixedEmbedding.mixedSpace K)
      (p : {w : NumberField.InfinitePlace K // w.IsComplex}),
      kaiHZCoord K y (Sum.inr (Sum.inl p)) = (y.2 p).re := fun _ _ => rfl
  have c3 : ∀ (y : NumberField.mixedEmbedding.mixedSpace K)
      (p : {w : NumberField.InfinitePlace K // w.IsComplex}),
      kaiHZCoord K y (Sum.inr (Sum.inr p)) = (y.2 p).im := fun _ _ => rfl
  have hdot : ∀ x v : NumberField.mixedEmbedding.mixedSpace K,
      (∑ i : kaiHZCoordIndex K, kaiHZCoord K x i * kaiHZCoord K v i)
        = kaiHZMixedInner K x v := by
    intro x v
    rw [Fintype.sum_sum_type]
    rw [Fintype.sum_sum_type
      (fun i : {w : NumberField.InfinitePlace K // w.IsComplex} ⊕
          {w : NumberField.InfinitePlace K // w.IsComplex} =>
        kaiHZCoord K x (Sum.inr i) * kaiHZCoord K v (Sum.inr i))]
    simp only [c1, c2, c3, kaiHZMixedInner]
    congr 1
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp only [Complex.mul_re, Complex.conj_re, Complex.conj_im]
    ring
  have hcard : Fintype.card (kaiHZCoordIndex K) = Module.finrank ℚ K := by
    have h1 : Module.finrank ℝ (kaiHZCoordIndex K → ℝ)
        = Fintype.card (kaiHZCoordIndex K) := Module.finrank_fintype_fun_eq_card ℝ
    have h2 : Module.finrank ℝ (NumberField.mixedEmbedding.mixedSpace K)
        = Module.finrank ℝ (kaiHZCoordIndex K → ℝ) := (kaiHZCoord K).finrank_eq
    have h3 : Module.finrank ℝ (NumberField.mixedEmbedding.mixedSpace K)
        = Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) :=
      Module.finrank_eq_card_basis (NumberField.mixedEmbedding.latticeBasis K)
    have h4 : Module.finrank ℤ (NumberField.RingOfIntegers K)
        = Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) :=
      Module.finrank_eq_card_basis (Module.Free.chooseBasis ℤ (NumberField.RingOfIntegers K))
    have h5 : Module.finrank ℤ (NumberField.RingOfIntegers K) = Module.finrank ℚ K :=
      NumberField.RingOfIntegers.rank K
    omega
  have hcoordmp : MeasureTheory.MeasurePreserving (⇑(kaiHZCoord K))
      MeasureTheory.volume MeasureTheory.volume := by
    have hid : MeasureTheory.MeasurePreserving
        (id : ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ) →
          ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ))
        MeasureTheory.volume MeasureTheory.volume :=
      MeasureTheory.MeasurePreserving.id _
    have h1 : MeasureTheory.MeasurePreserving
        (fun z : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ =>
          fun p => Complex.measurableEquivRealProd (z p))
        MeasureTheory.volume MeasureTheory.volume :=
      MeasureTheory.measurePreserving_pi _ _
        (fun _ => Complex.volume_preserving_equiv_real_prod)
    have hg1 := hid.prod h1
    have hg2 := hid.prod
      (MeasureTheory.volume_measurePreserving_arrowProdEquivProdArrow ℝ ℝ
        {w : NumberField.InfinitePlace K // w.IsComplex})
    have hs : MeasureTheory.MeasurePreserving
        (⇑(MeasurableEquiv.sumPiEquivProdPi
            (fun _ : {w : NumberField.InfinitePlace K // w.IsComplex} ⊕
              {w : NumberField.InfinitePlace K // w.IsComplex} => ℝ)).symm)
        MeasureTheory.volume MeasureTheory.volume :=
      MeasureTheory.MeasurePreserving.symm _
        (MeasureTheory.volume_measurePreserving_sumPiEquivProdPi _)
    have hg3 := hid.prod hs
    have hg4 : MeasureTheory.MeasurePreserving
        (⇑(MeasurableEquiv.sumPiEquivProdPi (fun _ : kaiHZCoordIndex K => ℝ)).symm)
        MeasureTheory.volume MeasureTheory.volume :=
      MeasureTheory.MeasurePreserving.symm _
        (MeasureTheory.volume_measurePreserving_sumPiEquivProdPi _)
    have key : MeasureTheory.MeasurePreserving
        (fun x : NumberField.mixedEmbedding.mixedSpace K =>
          (MeasurableEquiv.sumPiEquivProdPi (fun _ : kaiHZCoordIndex K => ℝ)).symm
            (Prod.map id
              (⇑(MeasurableEquiv.sumPiEquivProdPi
                  (fun _ : {w : NumberField.InfinitePlace K // w.IsComplex} ⊕
                    {w : NumberField.InfinitePlace K // w.IsComplex} => ℝ)).symm)
              (Prod.map id
                (⇑(MeasurableEquiv.arrowProdEquivProdArrow ℝ ℝ
                  {w : NumberField.InfinitePlace K // w.IsComplex}))
                (Prod.map id
                  (fun z : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ =>
                    fun p => Complex.measurableEquivRealProd (z p)) x))))
        MeasureTheory.volume MeasureTheory.volume :=
      ((hg4.comp hg3).comp hg2).comp hg1
    have hfun : ⇑(kaiHZCoord K) =
        (fun x : NumberField.mixedEmbedding.mixedSpace K =>
          (MeasurableEquiv.sumPiEquivProdPi (fun _ : kaiHZCoordIndex K => ℝ)).symm
            (Prod.map id
              (⇑(MeasurableEquiv.sumPiEquivProdPi
                  (fun _ : {w : NumberField.InfinitePlace K // w.IsComplex} ⊕
                    {w : NumberField.InfinitePlace K // w.IsComplex} => ℝ)).symm)
              (Prod.map id
                (⇑(MeasurableEquiv.arrowProdEquivProdArrow ℝ ℝ
                  {w : NumberField.InfinitePlace K // w.IsComplex}))
                (Prod.map id
                  (fun z : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ =>
                    fun p => Complex.measurableEquivRealProd (z p)) x)))) := by
      funext x i
      rcases i with w | (p | p) <;> rfl
    rw [hfun]
    exact key
  obtain ⟨Θ, hΘinner, hΘmp⟩ :
      ∃ Θ : NumberField.mixedEmbedding.mixedSpace K ≃ₗ[ℝ]
          (Fin (Module.finrank ℚ K) → ℝ),
        (∀ x v : NumberField.mixedEmbedding.mixedSpace K,
            (∑ j : Fin (Module.finrank ℚ K), Θ x j * Θ v j) = kaiHZMixedInner K x v) ∧
        MeasureTheory.MeasurePreserving (⇑Θ)
          MeasureTheory.volume MeasureTheory.volume := by
    set e : Fin (Module.finrank ℚ K) ≃ kaiHZCoordIndex K :=
      (Fintype.equivFinOfCardEq hcard).symm with he
    refine ⟨(kaiHZCoord K).trans (LinearEquiv.funCongrLeft ℝ ℝ e), ?_, ?_⟩
    · intro x v
      have hco : ∀ (y : NumberField.mixedEmbedding.mixedSpace K)
          (j : Fin (Module.finrank ℚ K)),
          ((kaiHZCoord K).trans (LinearEquiv.funCongrLeft ℝ ℝ e)) y j
            = kaiHZCoord K y (e j) := fun _ _ => rfl
      simp only [hco]
      rw [Equiv.sum_comp e (fun i => kaiHZCoord K x i * kaiHZCoord K v i)]
      exact hdot x v
    · have hmp1 : MeasureTheory.MeasurePreserving
          (⇑(MeasurableEquiv.piCongrLeft (fun _ : kaiHZCoordIndex K => ℝ) e).symm)
          MeasureTheory.volume MeasureTheory.volume :=
        MeasureTheory.MeasurePreserving.symm _
          (MeasureTheory.volume_measurePreserving_piCongrLeft
            (fun _ : kaiHZCoordIndex K => ℝ) e)
      have hfun : ⇑(MeasurableEquiv.piCongrLeft (fun _ : kaiHZCoordIndex K => ℝ) e).symm
          = ⇑(LinearEquiv.funCongrLeft ℝ ℝ e :
              (kaiHZCoordIndex K → ℝ) ≃ₗ[ℝ] (Fin (Module.finrank ℚ K) → ℝ)) := by
        funext u j
        rfl
      rw [hfun] at hmp1
      exact hmp1.comp hcoordmp
  refine ⟨Θ.trans (WithLp.linearEquiv 2 ℝ (Fin (Module.finrank ℚ K) → ℝ)).symm, ?_, ?_, ?_⟩
  · intro x v
    have hco : ∀ (y : NumberField.mixedEmbedding.mixedSpace K)
        (j : Fin (Module.finrank ℚ K)),
        ((Θ.trans (WithLp.linearEquiv 2 ℝ (Fin (Module.finrank ℚ K) → ℝ)).symm) y).ofLp j
          = Θ y j := fun _ _ => rfl
    rw [PiLp.inner_apply, ← hΘinner x v]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [RCLike.inner_apply, hco, hco]
    simp [mul_comm]
  · exact (MeasureTheory.MeasurePreserving.symm _
      (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp
        (Fin (Module.finrank ℚ K)))).comp hΘmp
  · intro β
    have hmap : ⇑Θ '' ZSpan.fundamentalDomain β = ZSpan.fundamentalDomain (β.map Θ) :=
      ZSpan.map_fundamentalDomain β Θ
    have hpre : ⇑Θ ⁻¹' (ZSpan.fundamentalDomain (β.map Θ)) = ZSpan.fundamentalDomain β := by
      rw [← hmap, Set.preimage_image_eq _ Θ.injective]
    have hms : MeasurableSet (ZSpan.fundamentalDomain (β.map Θ)) :=
      ZSpan.fundamentalDomain_measurableSet (β.map Θ)
    have hvol : MeasureTheory.volume (ZSpan.fundamentalDomain β)
        = MeasureTheory.volume (ZSpan.fundamentalDomain (β.map Θ)) := by
      rw [← hpre]
      exact hΘmp.measure_preimage hms.nullMeasurableSet
    have hmat : (Matrix.of fun i j =>
        ((Θ.trans (WithLp.linearEquiv 2 ℝ (Fin (Module.finrank ℚ K) → ℝ)).symm) (β i)) j)
          = Matrix.of ⇑(β.map Θ) := by
      funext i j
      simp [Module.Basis.map_apply]
    rw [hvol, hmat, ZSpan.volume_fundamentalDomain (β.map Θ),
      ENNReal.toReal_ofReal (abs_nonneg _)]

theorem kai_hz_mixed_inner_trace (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] (x z : K) :
    kaiHZMixedInner K (NumberField.mixedEmbedding K x)
        (kaiHZDualTwist K (NumberField.mixedEmbedding K z))
      = ((Algebra.trace ℚ K (x * z) : ℚ) : ℝ) :=
by
  classical
  have tsplit : ∀ f : NumberField.InfinitePlace K → ℝ,
      (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * f w)
        = (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
              f (w : NumberField.InfinitePlace K))
          + 2 * ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              f (p : NumberField.InfinitePlace K) := by
    intro f
    have hreal : (∑ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsReal),
          ((w.mult : ℝ) * f w))
        = ∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
            (((w : NumberField.InfinitePlace K).mult : ℝ) *
              f (w : NumberField.InfinitePlace K)) := by
      refine Finset.sum_subtype _ (fun w => ?_) _
      simp
    have hreal2 : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
            (((w : NumberField.InfinitePlace K).mult : ℝ) *
              f (w : NumberField.InfinitePlace K)))
        = ∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
            f (w : NumberField.InfinitePlace K) := by
      refine Finset.sum_congr rfl fun w _ => ?_
      rw [NumberField.InfinitePlace.mult_isReal w]
      norm_num
    have hcplx : (∑ w ∈ Finset.univ.filter
          (fun w : NumberField.InfinitePlace K => ¬ w.IsReal), ((w.mult : ℝ) * f w))
        = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            (((p : NumberField.InfinitePlace K).mult : ℝ) *
              f (p : NumberField.InfinitePlace K)) := by
      refine Finset.sum_subtype _ (fun w => ?_) _
      simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]
    have hcplx2 : (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            (((p : NumberField.InfinitePlace K).mult : ℝ) *
              f (p : NumberField.InfinitePlace K)))
        = 2 * ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            f (p : NumberField.InfinitePlace K) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [NumberField.InfinitePlace.mult_isComplex p]
      norm_num
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ
        (fun w : NumberField.InfinitePlace K => w.IsReal) (fun w => ((w.mult : ℝ) * f w)),
      hreal, hreal2, hcplx, hcplx2]
  have ttrace : ∀ α : K, ((Algebra.trace ℚ K α : ℚ) : ℝ)
      = ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * ((w.embedding) α).re := by
    intro α
    have h1 : (algebraMap ℚ ℂ) ((Algebra.trace ℚ K) α) = ∑ σ : K →ₐ[ℚ] ℂ, σ α :=
      trace_eq_sum_embeddings ℂ
    have h2 : (∑ σ : K →ₐ[ℚ] ℂ, σ α) = ∑ φ : K →+* ℂ, φ α := by
      rw [← Equiv.sum_comp (RingHom.equivRatAlgHom (R := K) (S := ℂ))
        (fun σ : K →ₐ[ℚ] ℂ => σ α)]
      exact Finset.sum_congr rfl fun φ _ => rfl
    have h3 : (((Algebra.trace ℚ K α : ℚ)) : ℂ) = ∑ φ : K →+* ℂ, φ α := by
      rw [← h1.trans h2, eq_ratCast]
    have h4 : ((Algebra.trace ℚ K α : ℚ) : ℝ) = ∑ φ : K →+* ℂ, (φ α).re := by
      have h5 := congrArg Complex.re h3
      rw [Complex.re_sum] at h5
      rw [← h5]
      simp
    rw [h4, ← Finset.sum_fiberwise Finset.univ
      (fun φ : K →+* ℂ => NumberField.InfinitePlace.mk φ) (fun φ => (φ α).re)]
    refine Finset.sum_congr rfl fun w _ => ?_
    have hconst : ∀ φ ∈ Finset.univ.filter
        (fun φ : K →+* ℂ => NumberField.InfinitePlace.mk φ = w),
        (φ α).re = ((w.embedding) α).re := by
      intro φ hφ
      rw [Finset.mem_filter] at hφ
      have hmk : NumberField.InfinitePlace.mk φ
          = NumberField.InfinitePlace.mk w.embedding := by
        rw [hφ.2, NumberField.InfinitePlace.mk_embedding]
      rcases NumberField.InfinitePlace.mk_eq_iff.mp hmk with h | h
      · rw [h]
      · have h' := RingHom.congr_fun h α
        rw [NumberField.ComplexEmbedding.conjugate_coe_eq] at h'
        rw [← h', Complex.conj_re]
    have hcard : (Finset.univ.filter
        (fun φ : K →+* ℂ => NumberField.InfinitePlace.mk φ = w)).card = w.mult := by
      simpa using NumberField.InfinitePlace.card_filter_mk_eq w
    rw [Finset.sum_congr rfl hconst, Finset.sum_const, hcard, nsmul_eq_mul]
  have hc1 : ∀ (y : K) (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (NumberField.mixedEmbedding K y).1 w
        = ((w : NumberField.InfinitePlace K).embedding y).re := by
    intro y w
    obtain ⟨w, hw⟩ := w
    rw [← NumberField.mixedEmbedding.commMap_canonical_eq_mixed K y,
      NumberField.mixedEmbedding.commMap_apply_of_isReal K _ hw,
      NumberField.canonicalEmbedding.apply_at]
  have hc2 : ∀ (y : K) (p : {w : NumberField.InfinitePlace K // w.IsComplex}),
      (NumberField.mixedEmbedding K y).2 p
        = ((p : NumberField.InfinitePlace K).embedding) y := by
    intro y p
    obtain ⟨p, hp⟩ := p
    rw [← NumberField.mixedEmbedding.commMap_canonical_eq_mixed K y,
      NumberField.mixedEmbedding.commMap_apply_of_isComplex K _ hp,
      NumberField.canonicalEmbedding.apply_at]
  have hR : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (NumberField.mixedEmbedding K x).1 w
          * (kaiHZDualTwist K (NumberField.mixedEmbedding K z)).1 w)
      = ∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (((w : NumberField.InfinitePlace K).embedding) (x * z)).re := by
    refine Finset.sum_congr rfl fun w _ => ?_
    have hz : (kaiHZDualTwist K (NumberField.mixedEmbedding K z)).1 w
        = (NumberField.mixedEmbedding K z).1 w := rfl
    have him : (((w : NumberField.InfinitePlace K).embedding) z).im = 0 := by
      have h := NumberField.ComplexEmbedding.IsReal.coe_embedding_apply
        (NumberField.InfinitePlace.isReal_iff.mp w.2) z
      rw [← h, Complex.ofReal_im]
    rw [hz, hc1 x w, hc1 z w, map_mul, Complex.mul_re, him]
    ring
  have hC : (∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        ((NumberField.mixedEmbedding K x).2 p *
          (starRingEnd ℂ)
            ((kaiHZDualTwist K (NumberField.mixedEmbedding K z)).2 p)).re)
      = 2 * ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (((p : NumberField.InfinitePlace K).embedding) (x * z)).re := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    have hz : (kaiHZDualTwist K (NumberField.mixedEmbedding K z)).2 p
        = 2 * (starRingEnd ℂ) ((NumberField.mixedEmbedding K z).2 p) := rfl
    have e : (starRingEnd ℂ)
          (2 * (starRingEnd ℂ) ((NumberField.mixedEmbedding K z).2 p))
        = 2 * (NumberField.mixedEmbedding K z).2 p := by
      rw [map_mul, Complex.conj_conj, map_ofNat]
    rw [hz, e, hc2 x p, hc2 z p, map_mul,
      show ((p : NumberField.InfinitePlace K).embedding) x *
            (2 * ((p : NumberField.InfinitePlace K).embedding) z)
          = 2 * (((p : NumberField.InfinitePlace K).embedding) x *
              ((p : NumberField.InfinitePlace K).embedding) z) from by ring,
      Complex.mul_re]
    simp
  have hsplit := tsplit (fun w : NumberField.InfinitePlace K => ((w.embedding) (x * z)).re)
  have htr := ttrace (x * z)
  simp only [kaiHZMixedInner]
  rw [hR, hC, htr, hsplit]

theorem kai_hz_ideal_lattice_data (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ c₀ cK : ℝ, 0 < c₀ ∧ 0 < cK ∧
      ∀ a : Ideal (NumberField.RingOfIntegers K), a ≠ 0 →
        ∃ (μ ν : Fin (Module.finrank ℚ K) → K)
          (b : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
          (βa : Module.Basis (Fin (Module.finrank ℚ K)) ℝ
              (NumberField.mixedEmbedding.mixedSpace K))
          (ea : (Fin (Module.finrank ℚ K) → ℤ) ≃ ↥a)
          (eb : (Fin (Module.finrank ℚ K) → ℤ) ≃
              {x : K // x ∈ (b : FractionalIdeal
                (nonZeroDivisors (NumberField.RingOfIntegers K)) K)}),
          (∀ i, βa i = NumberField.mixedEmbedding K (μ i)) ∧
          (∀ i j, Algebra.trace ℚ K (μ i * ν j) = if i = j then 1 else 0) ∧
          LinearIndependent ℝ (fun j => NumberField.mixedEmbedding K (ν j)) ∧
          (∀ m : Fin (Module.finrank ℚ K) → ℤ,
              NumberField.mixedEmbedding K
                  ((ea m : NumberField.RingOfIntegers K) : K)
                = ∑ i, (m i : ℝ) • βa i) ∧
          (∀ m : Fin (Module.finrank ℚ K) → ℤ,
              NumberField.mixedEmbedding K ((eb m : K))
                = ∑ j, (m j : ℝ) • NumberField.mixedEmbedding K (ν j)) ∧
          c₀ ≤ (MeasureTheory.volume (ZSpan.fundamentalDomain βa)).toReal ∧
          ((FractionalIdeal.absNorm
              (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℚ) : ℝ)
            = cK / (Ideal.absNorm a : ℝ) :=
by
  rename_i instR instC
  have hs7 : ∃ V₀ : ℝ, 0 < V₀ ∧
      ∀ I : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ,
        (MeasureTheory.volume (ZSpan.fundamentalDomain
            (NumberField.mixedEmbedding.fractionalIdealLatticeBasis K I))).toReal
          = ((FractionalIdeal.absNorm
              (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℚ) : ℝ)
              * V₀ := by
    have hR : instR = @Subtype.fintype (NumberField.InfinitePlace K)
        (fun w => NumberField.InfinitePlace.IsReal w)
        (fun a => Classical.propDecidable _) inferInstance := Subsingleton.elim _ _
    have hC : instC = @Subtype.fintype (NumberField.InfinitePlace K)
        (fun w => NumberField.InfinitePlace.IsComplex w)
        (fun a => Classical.propDecidable _) inferInstance := Subsingleton.elim _ _
    subst hR
    subst hC
    have hd : ‖NumberField.discr K‖₊ ≠ 0 := by
      simpa using NumberField.discr_ne_zero K
    have hs : NNReal.sqrt ‖NumberField.discr K‖₊ ≠ 0 := by
      intro h
      apply hd
      rw [← NNReal.sq_sqrt ‖NumberField.discr K‖₊, h]
      ring
    refine ⟨(((2 : ENNReal))⁻¹ ^ NumberField.InfinitePlace.nrComplexPlaces K *
        ((NNReal.sqrt ‖NumberField.discr K‖₊ : NNReal) : ENNReal)).toReal, ?_, ?_⟩
    · refine ENNReal.toReal_pos ?_ ?_
      · refine mul_ne_zero (pow_ne_zero _ (by simp)) ?_
        simpa using hs
      · exact ENNReal.mul_ne_top (ENNReal.pow_ne_top (by simp)) ENNReal.coe_ne_top
    · intro I
      rw [NumberField.mixedEmbedding.volume_fundamentalDomain_fractionalIdealLatticeBasis,
        NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis,
        ENNReal.toReal_mul, ENNReal.toReal_ofReal]
      exact_mod_cast FractionalIdeal.absNorm_nonneg
        (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
  have hs6 : ∃ cK : ℝ, 0 < cK ∧
      ∀ a : Ideal (NumberField.RingOfIntegers K), a ≠ 0 →
        ((FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
            ((a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K))) : ℚ) : ℝ)
          = cK / (Ideal.absNorm a : ℝ) := by
    have hone : (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ≠ 0 :=
      one_ne_zero
    have hD0 : FractionalIdeal.dual ℤ ℚ
        (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ≠ 0 :=
      FractionalIdeal.dual_ne_zero ℤ ℚ hone
    have hNn : (0 : ℚ) ≤ FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
        (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) :=
      FractionalIdeal.absNorm_nonneg _
    have hNne : FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
        (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) ≠ 0 :=
      fun h => hD0 (FractionalIdeal.absNorm_eq_zero_iff.mp h)
    have hpos : (0 : ℚ) < FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
        (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) :=
      lt_of_le_of_ne hNn (Ne.symm hNne)
    refine ⟨((FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
        (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) : ℚ) : ℝ),
      by exact_mod_cast hpos, ?_⟩
    intro a ha
    have hab : a ≠ ⊥ := by rw [← Submodule.zero_eq_bot]; exact ha
    have hIa0 : ((a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) ≠ 0 :=
      FractionalIdeal.coeIdeal_ne_zero.mpr hab
    have hDa0 : FractionalIdeal.dual ℤ ℚ
        ((a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) ≠ 0 :=
      FractionalIdeal.dual_ne_zero ℤ ℚ hIa0
    have hdd := FractionalIdeal.dual_div_dual (A := ℤ) (K := ℚ)
      (I := (a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) (J := 1)
    rw [div_one] at hdd
    have hmul : FractionalIdeal.dual ℤ ℚ
        (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
        = (a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) *
          FractionalIdeal.dual ℤ ℚ
            ((a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) :=
      (div_eq_iff hDa0).mp hdd
    have hN : FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
        (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K))
        = (Ideal.absNorm a : ℚ) * FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
          ((a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K))) := by
      rw [hmul, map_mul, FractionalIdeal.coeIdeal_absNorm]
    have hNa : (Ideal.absNorm a : ℚ) ≠ 0 := by
      have h0 : Ideal.absNorm a ≠ 0 := fun h => hab (Ideal.absNorm_eq_zero_iff.mp h)
      exact_mod_cast h0
    have hfin : FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
        ((a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)))
        = FractionalIdeal.absNorm (FractionalIdeal.dual ℤ ℚ
          (1 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K))
          / (Ideal.absNorm a : ℚ) := by
      field_simp [hN]
      linarith [hN]
    rw [hfin]
    push_cast
    ring
  have hs8 : ∀ (T : Type u) (v : Fin (Module.finrank ℚ K) → K), LinearIndependent ℚ v →
      ∀ f : T → K, Function.Injective f →
        (∀ x : K, x ∈ Submodule.span ℤ (Set.range v) ↔ ∃ t : T, f t = x) →
        ∃ e : (Fin (Module.finrank ℚ K) → ℤ) ≃ T,
          ∀ m : Fin (Module.finrank ℚ K) → ℤ, f (e m) = ∑ i, m i • v i := by
    classical
    intro T v hv f hf hmem
    have hginj : Function.Injective
        (fun m : Fin (Module.finrank ℚ K) → ℤ => ∑ i, m i • v i) := by
      intro m m' h
      simp only at h
      have h0 : ∑ i, (((m i - m' i : ℤ) : ℚ)) • v i = 0 := by
        have hterm : ∀ i : Fin (Module.finrank ℚ K),
            (((m i - m' i : ℤ) : ℚ)) • v i = m i • v i - m' i • v i := by
          intro i
          rw [Int.cast_smul_eq_zsmul, sub_smul]
        rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_sub_distrib, h, sub_self]
      funext i
      have hzero := Fintype.linearIndependent_iff.mp hv
        (fun i => (((m i - m' i : ℤ) : ℚ))) h0 i
      have h2 : (m i - m' i : ℤ) = 0 := by exact_mod_cast hzero
      omega
    have hex : ∀ m : Fin (Module.finrank ℚ K) → ℤ, ∃ t : T, f t = ∑ i, m i • v i := by
      intro m
      exact (hmem _).mp ((Submodule.mem_span_range_iff_exists_fun ℤ).mpr ⟨m, rfl⟩)
    choose e₀ he using hex
    have hinj : Function.Injective e₀ := by
      intro m m' h
      apply hginj
      simp only
      rw [← he m, ← he m', h]
    have hsurj : Function.Surjective e₀ := by
      intro t
      have h1 : f t ∈ Submodule.span ℤ (Set.range v) := (hmem _).mpr ⟨t, rfl⟩
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp h1
      refine ⟨c, hf ?_⟩
      rw [he c, hc]
    exact ⟨Equiv.ofBijective e₀ ⟨hinj, hsurj⟩, he⟩
  have hs4 : ∀ (μ : Module.Basis (Fin (Module.finrank ℚ K)) ℚ K)
      (I : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ),
      (∀ x : K, x ∈ Submodule.span ℤ (Set.range ⇑μ) ↔
          x ∈ (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) →
      ∃ ν : Module.Basis (Fin (Module.finrank ℚ K)) ℚ K,
        (∀ i j, Algebra.trace ℚ K (μ i * ν j) = if i = j then 1 else 0) ∧
        (∀ x : K, x ∈ Submodule.span ℤ (Set.range ⇑ν) ↔
          x ∈ FractionalIdeal.dual ℤ ℚ
            (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) := by
    classical
    intro μ I hspan
    have hnd : (Algebra.traceForm ℚ K).Nondegenerate := traceForm_nondegenerate ℚ K
    refine ⟨(Algebra.traceForm ℚ K).dualBasis hnd μ, ?_, ?_⟩
    · intro i j
      have h := LinearMap.BilinForm.apply_dualBasis_left hnd μ j i
      rw [Algebra.traceForm_apply, mul_comm] at h
      exact h
    · intro x
      have hcoord : ∀ i, ((Algebra.traceForm ℚ K).dualBasis hnd μ).repr x i
          = (Algebra.traceForm ℚ K) x (μ i) :=
        fun i => LinearMap.BilinForm.dualBasis_repr_apply hnd μ x i
      have hI0 : (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ≠ 0 :=
        Units.ne_zero I
      rw [Module.Basis.mem_span_iff_repr_mem ℤ, FractionalIdeal.mem_dual hI0]
      constructor
      · intro hx y hy
        have hy' : y ∈ Submodule.span ℤ (Set.range ⇑μ) := (hspan y).mpr hy
        obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp hy'
        have hc : ∀ i, ∃ z : ℤ, (algebraMap ℤ ℚ) z = (Algebra.traceForm ℚ K) x (μ i) := by
          intro i
          have hxi := hx i
          rw [hcoord i] at hxi
          exact hxi
        choose c hcc using hc
        refine ⟨∑ i, d i * c i, ?_⟩
        have hexp : (Algebra.traceForm ℚ K) x y
            = ∑ i, ((d i : ℚ)) * ((Algebra.traceForm ℚ K) x (μ i)) := by
          rw [← hd, map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_zsmul, zsmul_eq_mul]
        rw [hexp, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        have hcast : (algebraMap ℤ ℚ) (d i) = ((d i : ℤ) : ℚ) := by simp
        rw [map_mul, hcc i, hcast]
      · intro hx i
        rw [hcoord i]
        have hmu : μ i ∈
            (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) :=
          (hspan (μ i)).mp (Submodule.subset_span ⟨i, rfl⟩)
        exact hx (μ i) hmu
  have hs5 : ∀ (ν : Module.Basis (Fin (Module.finrank ℚ K)) ℚ K)
      (b : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ),
      (∀ x : K, x ∈ Submodule.span ℤ (Set.range ⇑ν) ↔
          x ∈ (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) →
      LinearIndependent ℝ (fun j => NumberField.mixedEmbedding K (ν j)) := by
    classical
    intro ν b hspan
    have hν'b : ∀ i, (NumberField.basisOfFractionalIdeal K b i) ∈
        (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) := by
      intro i
      have h1 := (NumberField.mem_span_basisOfFractionalIdeal K (I := b)
        (x := NumberField.basisOfFractionalIdeal K b i)).mp (Submodule.subset_span ⟨i, rfl⟩)
      exact FractionalIdeal.mem_coe.mp h1
    have hmem : ∀ i, NumberField.mixedEmbedding K (NumberField.basisOfFractionalIdeal K b i) ∈
        Submodule.span ℝ (Set.range (fun j => NumberField.mixedEmbedding K (ν j))) := by
      intro i
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp
        ((hspan _).mpr (hν'b i))
      rw [← hc, map_sum]
      refine Submodule.sum_mem _ fun j _ => ?_
      rw [map_zsmul, ← Int.cast_smul_eq_zsmul ℝ]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    have htop : (⊤ : Submodule ℝ (NumberField.mixedEmbedding.mixedSpace K)) ≤
        Submodule.span ℝ (Set.range (fun j => NumberField.mixedEmbedding K (ν j))) := by
      rw [← (NumberField.mixedEmbedding.fractionalIdealLatticeBasis K b).span_eq,
        Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      rw [NumberField.mixedEmbedding.fractionalIdealLatticeBasis_apply]
      exact hmem i
    have hcard : Fintype.card (Fin (Module.finrank ℚ K))
        = Module.finrank ℝ (NumberField.mixedEmbedding.mixedSpace K) := by
      rw [← Module.finrank_eq_card_basis ν,
        Module.finrank_eq_card_basis
          (NumberField.mixedEmbedding.fractionalIdealLatticeBasis K b)]
      exact Module.finrank_eq_card_basis (NumberField.basisOfFractionalIdeal K b)
    exact linearIndependent_of_top_le_span_of_card_eq_finrank htop hcard
  classical
  obtain ⟨V₀, hV₀, hcov⟩ := hs7
  obtain ⟨cK, hcK, hnorm⟩ := hs6
  refine ⟨V₀, cK, hV₀, hcK, ?_⟩
  intro a ha
  have hab : a ≠ ⊥ := by rw [← Submodule.zero_eq_bot]; exact ha
  have hIa0 : ((a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) ≠ 0 :=
    FractionalIdeal.coeIdeal_ne_zero.mpr hab
  obtain ⟨I, hIval⟩ :
      ∃ I : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ,
        (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
          = (a : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) :=
    ⟨Units.mk0 _ hIa0, rfl⟩
  obtain ⟨μB, βa, hclause1, hspanμ, hfd⟩ :
      ∃ (μB : Module.Basis (Fin (Module.finrank ℚ K)) ℚ K)
        (βa : Module.Basis (Fin (Module.finrank ℚ K)) ℝ
          (NumberField.mixedEmbedding.mixedSpace K)),
        (∀ i, βa i = NumberField.mixedEmbedding K (μB i)) ∧
        (∀ x : K, x ∈ Submodule.span ℤ (Set.range ⇑μB) ↔
          x ∈ (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)) ∧
        ZSpan.fundamentalDomain βa = ZSpan.fundamentalDomain
          (NumberField.mixedEmbedding.fractionalIdealLatticeBasis K I) := by
    refine ⟨(NumberField.basisOfFractionalIdeal K I).reindex
        ((NumberField.basisOfFractionalIdeal K I).indexEquiv (Module.finBasis ℚ K)),
      (NumberField.mixedEmbedding.fractionalIdealLatticeBasis K I).reindex
        ((NumberField.basisOfFractionalIdeal K I).indexEquiv (Module.finBasis ℚ K)),
      ?_, ?_, ZSpan.fundamentalDomain_reindex _ _⟩
    · intro i
      rw [Module.Basis.reindex_apply, Module.Basis.reindex_apply,
        NumberField.mixedEmbedding.fractionalIdealLatticeBasis_apply]
    · intro x
      have hr : Set.range ⇑((NumberField.basisOfFractionalIdeal K I).reindex
          ((NumberField.basisOfFractionalIdeal K I).indexEquiv (Module.finBasis ℚ K)))
          = Set.range ⇑(NumberField.basisOfFractionalIdeal K I) := by
        rw [Module.Basis.coe_reindex, Set.range_comp, Equiv.range_eq_univ, Set.image_univ]
      rw [hr, NumberField.mem_span_basisOfFractionalIdeal]
      exact FractionalIdeal.mem_coe
  obtain ⟨νB, hbio, hspanν⟩ := hs4 μB I hspanμ
  have hdual0 : FractionalIdeal.dual ℤ ℚ
      (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) ≠ 0 :=
    FractionalIdeal.dual_ne_zero ℤ ℚ (Units.ne_zero I)
  obtain ⟨b, hbval⟩ :
      ∃ b : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ,
        (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
          = FractionalIdeal.dual ℤ ℚ
            (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) :=
    ⟨Units.mk0 _ hdual0, rfl⟩
  have hspanν' : ∀ x : K, x ∈ Submodule.span ℤ (Set.range ⇑νB) ↔
      x ∈ (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) := by
    intro x; rw [hbval]; exact hspanν x
  have hclause3 : LinearIndependent ℝ (fun j => NumberField.mixedEmbedding K (νB j)) :=
    hs5 νB b hspanν'
  have hfa : Function.Injective (fun t : ↥a => ((t : NumberField.RingOfIntegers K) : K)) := by
    intro t₁ t₂ h
    exact Subtype.ext (NumberField.RingOfIntegers.coe_injective h)
  have hmema : ∀ x : K, x ∈ Submodule.span ℤ (Set.range ⇑μB) ↔
      ∃ t : ↥a, ((t : NumberField.RingOfIntegers K) : K) = x := by
    intro x
    rw [hspanμ x, hIval, FractionalIdeal.mem_coeIdeal]
    constructor
    · rintro ⟨x', hx', rfl⟩
      exact ⟨⟨x', hx'⟩, rfl⟩
    · rintro ⟨t, rfl⟩
      exact ⟨(t : NumberField.RingOfIntegers K), t.2, rfl⟩
  obtain ⟨ea, hea⟩ := hs8 _ (⇑μB) μB.linearIndependent _ hfa hmema
  have hclause4 : ∀ m : Fin (Module.finrank ℚ K) → ℤ,
      NumberField.mixedEmbedding K ((ea m : NumberField.RingOfIntegers K) : K)
        = ∑ i, (m i : ℝ) • βa i := by
    intro m
    rw [hea m, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_zsmul, hclause1 i, Int.cast_smul_eq_zsmul]
  have hfb : Function.Injective (fun t : {x : K // x ∈
      (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)} => (t : K)) :=
    fun t₁ t₂ h => Subtype.ext h
  have hmemb : ∀ x : K, x ∈ Submodule.span ℤ (Set.range ⇑νB) ↔
      ∃ t : {x : K // x ∈
        (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)},
        (t : K) = x := by
    intro x
    rw [hspanν' x]
    constructor
    · intro hx
      exact ⟨⟨x, hx⟩, rfl⟩
    · rintro ⟨t, rfl⟩
      exact t.2
  obtain ⟨eb, heb⟩ := hs8 _ (⇑νB) νB.linearIndependent _ hfb hmemb
  have hclause5 : ∀ m : Fin (Module.finrank ℚ K) → ℤ,
      NumberField.mixedEmbedding K ((eb m : K))
        = ∑ j, (m j : ℝ) • NumberField.mixedEmbedding K (νB j) := by
    intro m
    rw [heb m, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_zsmul, Int.cast_smul_eq_zsmul]
  have hNa1 : (1 : ℝ) ≤ (Ideal.absNorm a : ℝ) := by
    have h0 : Ideal.absNorm a ≠ 0 := fun h => hab (Ideal.absNorm_eq_zero_iff.mp h)
    have h1 : 1 ≤ Ideal.absNorm a := Nat.one_le_iff_ne_zero.mpr h0
    exact_mod_cast h1
  have hclause6 : V₀ ≤ (MeasureTheory.volume (ZSpan.fundamentalDomain βa)).toReal := by
    rw [hfd, hcov I, hIval, FractionalIdeal.coeIdeal_absNorm]
    have h2 : (1 : ℝ) * V₀ ≤ (Ideal.absNorm a : ℝ) * V₀ :=
      mul_le_mul_of_nonneg_right hNa1 hV₀.le
    push_cast
    linarith
  have hclause7 : ((FractionalIdeal.absNorm
      (b : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℚ) : ℝ)
      = cK / (Ideal.absNorm a : ℝ) := by
    rw [hbval, hIval]
    exact hnorm a ha
  exact ⟨⇑μB, ⇑νB, b, βa, ea, eb, hclause1, hbio, hclause3, hclause4, hclause5,
    hclause6, hclause7⟩

theorem kai_hz_mixed_test_schwartz (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (d : ℕ)
    (Φ : (NumberField.mixedEmbedding.mixedSpace K) ≃ₗ[ℝ] EuclideanSpace ℝ (Fin d))
    (hΦ : ∀ x v : NumberField.mixedEmbedding.mixedSpace K,
        (inner ℝ (Φ x) (Φ v) : ℝ) = kaiHZMixedInner K x v)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (y : NumberField.InfinitePlace K → ℝ) (hy : ∀ w, 0 < y w) :
    ∃ F : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
      ∀ x : NumberField.mixedEmbedding.mixedSpace K,
        F (Φ x) = kaiHZArchWeight K η l x * ((kaiHZGaussian K y x : ℝ) : ℂ) :=
by
  classical
  
  have hgcs : ∀ (T : EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)) (c : ℝ),
      0 < c → (∀ u : EuclideanSpace ℝ (Fin d), c * ‖u‖ ≤ ‖T u‖) →
      ∃ F : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
        ∀ u : EuclideanSpace ℝ (Fin d),
          F u = Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ)) := by
    clear * -
    intro T c hc hT
    have scalar : ∀ a : ℝ, 0 < a → ∀ k : ℕ, ∃ C : ℝ,
        ∀ t : ℝ, 0 ≤ t → t ^ k * Real.exp (-(a * t ^ 2)) ≤ C := by
      intro a ha k
      have hak : (0:ℝ) < a ^ k := pow_pos ha k
      have hakne : (a : ℝ) ^ k ≠ 0 := ne_of_gt hak
      have hfac : (0:ℝ) < (k.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos k
      have hfacne : ((k.factorial : ℝ)) ≠ 0 := ne_of_gt hfac
      refine ⟨1 + (a ^ k)⁻¹ * (k.factorial : ℝ), ?_⟩
      intro t ht
      have hq0 : (0:ℝ) ≤ (a ^ k)⁻¹ * (k.factorial : ℝ) := by positivity
      have h3 : (0:ℝ) ≤ Real.exp (-(a * t ^ 2)) := (Real.exp_pos _).le
      have core : t ^ (2 * k) * Real.exp (-(a * t ^ 2)) ≤ (a ^ k)⁻¹ * (k.factorial : ℝ) := by
        have hs0 : (0:ℝ) ≤ a * t ^ 2 := by positivity
        have hE : (0:ℝ) < Real.exp (a * t ^ 2) := Real.exp_pos _
        have hEne : Real.exp (a * t ^ 2) ≠ 0 := ne_of_gt hE
        have hsum := Real.sum_le_exp_of_nonneg hs0 (k + 1)
        have hterm : (a * t ^ 2) ^ k / (k.factorial : ℝ)
            ≤ ∑ i ∈ Finset.range (k + 1), (a * t ^ 2) ^ i / (i.factorial : ℝ) := by
          refine Finset.single_le_sum (f := fun i => (a * t ^ 2) ^ i / (i.factorial : ℝ)) ?_ ?_
          · intro i _
            positivity
          · exact Finset.self_mem_range_succ k
        have h1 : (a * t ^ 2) ^ k / (k.factorial : ℝ) ≤ Real.exp (a * t ^ 2) := hterm.trans hsum
        rw [div_eq_mul_inv] at h1
        have hmul := mul_le_mul_of_nonneg_right h1 hfac.le
        rw [mul_assoc, inv_mul_cancel₀ hfacne, mul_one] at hmul
        have hexpand : (a * t ^ 2) ^ k = a ^ k * t ^ (2 * k) := by
          rw [mul_pow, pow_mul]
        rw [hexpand] at hmul
        have hcoef : (0:ℝ) ≤ (Real.exp (a * t ^ 2))⁻¹ * (a ^ k)⁻¹ := by positivity
        have hmul2 := mul_le_mul_of_nonneg_right hmul hcoef
        have hLl : a ^ k * t ^ (2 * k) * ((Real.exp (a * t ^ 2))⁻¹ * (a ^ k)⁻¹)
            = t ^ (2 * k) * (Real.exp (a * t ^ 2))⁻¹ := by
          field_simp
        have hRr : Real.exp (a * t ^ 2) * (k.factorial : ℝ) *
              ((Real.exp (a * t ^ 2))⁻¹ * (a ^ k)⁻¹)
            = (a ^ k)⁻¹ * (k.factorial : ℝ) := by
          field_simp
        rw [hLl, hRr] at hmul2
        rw [Real.exp_neg]
        exact hmul2
      rcases le_total t 1 with h | h
      · have h1 : t ^ k ≤ 1 := pow_le_one₀ ht h
        have h2 : Real.exp (-(a * t ^ 2)) ≤ 1 := by
          have hneg : -(a * t ^ 2) ≤ 0 := by nlinarith [sq_nonneg t]
          calc Real.exp (-(a * t ^ 2)) ≤ Real.exp 0 := Real.exp_le_exp.mpr hneg
            _ = 1 := Real.exp_zero
        have h6 : t ^ k * Real.exp (-(a * t ^ 2)) ≤ 1 * Real.exp (-(a * t ^ 2)) :=
          mul_le_mul_of_nonneg_right h1 h3
        linarith
      · have h1 : t ^ k ≤ t ^ (2 * k) := pow_le_pow_right₀ h (by omega)
        have h5 : t ^ k * Real.exp (-(a * t ^ 2)) ≤ t ^ (2 * k) * Real.exp (-(a * t ^ 2)) :=
          mul_le_mul_of_nonneg_right h1 h3
        linarith
    have crux : ∀ (G : EuclideanSpace ℝ (Fin d) → ℂ)
        (L : EuclideanSpace ℝ (Fin d) →L[ℝ] (EuclideanSpace ℝ (Fin d) →L[ℝ] ℂ)),
        ContDiff ℝ (⊤ : ℕ∞) G → fderiv ℝ G = (fun u => G u • L u) →
        (∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d), ‖u‖ ^ k * ‖G u‖ ≤ C) →
        ∀ n k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
          ‖u‖ ^ k * ‖iteratedFDeriv ℝ n G u‖ ≤ C := by
      intro G L hG hfd hdec0
      have hA : (0:ℝ) ≤ ‖L‖ := norm_nonneg L
      have hmn : ∀ m : ℕ, (m : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
        intro m; exact_mod_cast le_top
      have hLfd : fderiv ℝ (⇑L) = fun _ => L := funext fun x => L.fderiv
      have hL0 : ∀ u : EuclideanSpace ℝ (Fin d),
          ‖iteratedFDeriv ℝ 0 (⇑L) u‖ ≤ ‖L‖ * ‖u‖ := by
        intro u
        rw [norm_iteratedFDeriv_zero]
        exact L.le_opNorm u
      have hL1 : ∀ u : EuclideanSpace ℝ (Fin d), ‖iteratedFDeriv ℝ 1 (⇑L) u‖ = ‖L‖ := by
        intro u
        have h : ‖iteratedFDeriv ℝ (0 + 1) (⇑L) u‖ = ‖L‖ := by
          rw [← norm_iteratedFDeriv_fderiv, hLfd, norm_iteratedFDeriv_zero]
        simpa using h
      have hLz : ∀ j : ℕ, 2 ≤ j → ∀ u : EuclideanSpace ℝ (Fin d),
          ‖iteratedFDeriv ℝ j (⇑L) u‖ = 0 := by
        intro j hj u
        obtain ⟨m, rfl⟩ : ∃ m, j = m + 1 := ⟨j - 1, by omega⟩
        have hm : m ≠ 0 := by omega
        have h0 : iteratedFDeriv ℝ m (fderiv ℝ (⇑L)) u = 0 := by
          rw [hLfd, iteratedFDeriv_const_of_ne hm]
          rfl
        rw [← norm_iteratedFDeriv_fderiv, h0, norm_zero]
      have step : ∀ m : ℕ,
          (∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
            ‖u‖ ^ k * ‖iteratedFDeriv ℝ m G u‖ ≤ C) →
          (∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
            ‖u‖ ^ k * ‖iteratedFDeriv ℝ (m - 1) G u‖ ≤ C) →
          ∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
            ‖u‖ ^ k * ‖iteratedFDeriv ℝ (m + 1) G u‖ ≤ C := by
        intro m hPm hPm1 k
        obtain ⟨C₁, hC₁⟩ := hPm (k + 1)
        obtain ⟨C₂, hC₂⟩ := hPm1 k
        refine ⟨‖L‖ * C₁ + ‖L‖ * (m : ℝ) * C₂, fun u => ?_⟩
        have hu0 : (0:ℝ) ≤ ‖u‖ ^ k := pow_nonneg (norm_nonneg u) k
        have hleib : ‖iteratedFDeriv ℝ (m + 1) G u‖
            ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * ‖iteratedFDeriv ℝ i G u‖ *
                ‖iteratedFDeriv ℝ (m - i) (⇑L) u‖ := by
          rw [← norm_iteratedFDeriv_fderiv, hfd]
          exact norm_iteratedFDeriv_smul_le hG L.contDiff u (hmn m)
        rcases Nat.eq_zero_or_pos m with rfl | hm
        · have hb : ‖iteratedFDeriv ℝ (0 + 1) G u‖ ≤ ‖G u‖ * (‖L‖ * ‖u‖) := by
            refine hleib.trans ?_
            rw [Finset.sum_range_one]
            simp only [Nat.choose_self, Nat.cast_one, one_mul, norm_iteratedFDeriv_zero]
            exact mul_le_mul_of_nonneg_left (hL0 u) (norm_nonneg _)
          have h2 : ‖u‖ ^ k * ‖iteratedFDeriv ℝ (0 + 1) G u‖
              ≤ ‖u‖ ^ k * (‖G u‖ * (‖L‖ * ‖u‖)) := mul_le_mul_of_nonneg_left hb hu0
          have h3 : ‖u‖ ^ k * (‖G u‖ * (‖L‖ * ‖u‖)) = ‖L‖ * (‖u‖ ^ (k + 1) * ‖G u‖) := by
            rw [pow_succ]; ring
          have h4 : ‖u‖ ^ (k + 1) * ‖G u‖ ≤ C₁ := by
            have h := hC₁ u
            rwa [norm_iteratedFDeriv_zero] at h
          have h5 : ‖L‖ * (‖u‖ ^ (k + 1) * ‖G u‖) ≤ ‖L‖ * C₁ :=
            mul_le_mul_of_nonneg_left h4 hA
          have h6 : ‖L‖ * ((0:ℕ) : ℝ) * C₂ = 0 := by simp
          linarith
        · obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
          have e1 : m' + 1 - m' = 1 := by omega
          have e2 : m' + 1 - (m' + 1) = 0 := by omega
          have hC₂' : ∀ v : EuclideanSpace ℝ (Fin d),
              ‖v‖ ^ k * ‖iteratedFDeriv ℝ m' G v‖ ≤ C₂ := hC₂
          have hb : ‖iteratedFDeriv ℝ (m' + 1 + 1) G u‖
              ≤ ((m' : ℝ) + 1) * ‖iteratedFDeriv ℝ m' G u‖ * ‖L‖
                + ‖iteratedFDeriv ℝ (m' + 1) G u‖ * (‖L‖ * ‖u‖) := by
            refine hleib.trans ?_
            rw [Finset.sum_range_succ]
            rw [Finset.sum_eq_single m'
              (by
                intro b hb hbne
                have hb2 : 2 ≤ m' + 1 - b := by
                  have := Finset.mem_range.mp hb
                  omega
                rw [hLz _ hb2 u, mul_zero])
              (fun h => absurd (Finset.self_mem_range_succ m') h)]
            rw [e1, e2, Nat.choose_succ_self_right, Nat.choose_self, hL1 u,
              norm_iteratedFDeriv_zero]
            have hop := mul_le_mul_of_nonneg_left (L.le_opNorm u)
              (norm_nonneg (iteratedFDeriv ℝ (m' + 1) G u))
            push_cast
            linarith
          have h2 : ‖u‖ ^ k * ‖iteratedFDeriv ℝ (m' + 1 + 1) G u‖
              ≤ ‖u‖ ^ k * (((m' : ℝ) + 1) * ‖iteratedFDeriv ℝ m' G u‖ * ‖L‖
                + ‖iteratedFDeriv ℝ (m' + 1) G u‖ * (‖L‖ * ‖u‖)) :=
            mul_le_mul_of_nonneg_left hb hu0
          have h3 : ‖u‖ ^ k * (((m' : ℝ) + 1) * ‖iteratedFDeriv ℝ m' G u‖ * ‖L‖
                + ‖iteratedFDeriv ℝ (m' + 1) G u‖ * (‖L‖ * ‖u‖))
              = ‖L‖ * ((m' : ℝ) + 1) * (‖u‖ ^ k * ‖iteratedFDeriv ℝ m' G u‖)
                + ‖L‖ * (‖u‖ ^ (k + 1) * ‖iteratedFDeriv ℝ (m' + 1) G u‖) := by
            rw [pow_succ]; ring
          have h4 : ‖L‖ * ((m' : ℝ) + 1) * (‖u‖ ^ k * ‖iteratedFDeriv ℝ m' G u‖)
              ≤ ‖L‖ * ((m' : ℝ) + 1) * C₂ :=
            mul_le_mul_of_nonneg_left (hC₂' u) (by positivity)
          have h5 : ‖L‖ * (‖u‖ ^ (k + 1) * ‖iteratedFDeriv ℝ (m' + 1) G u‖) ≤ ‖L‖ * C₁ :=
            mul_le_mul_of_nonneg_left (hC₁ u) hA
          have h6 : ((m' + 1 : ℕ) : ℝ) = (m' : ℝ) + 1 := by push_cast; ring
          rw [h6]
          linarith
      have base : ∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
          ‖u‖ ^ k * ‖iteratedFDeriv ℝ 0 G u‖ ≤ C := by
        intro k
        obtain ⟨C, hC⟩ := hdec0 k
        refine ⟨C, fun u => ?_⟩
        rw [norm_iteratedFDeriv_zero]
        exact hC u
      have pair : ∀ n : ℕ,
          (∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
            ‖u‖ ^ k * ‖iteratedFDeriv ℝ n G u‖ ≤ C) ∧
          (∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
            ‖u‖ ^ k * ‖iteratedFDeriv ℝ (n + 1) G u‖ ≤ C) := by
        intro n
        induction n with
        | zero =>
          refine ⟨base, ?_⟩
          have h := step 0 base (by simpa using base)
          simpa using h
        | succ p ih =>
          refine ⟨ih.2, ?_⟩
          exact step (p + 1) ih.2 (by simpa using ih.1)
      intro n k
      exact (pair n).1 k
    have hsmooth : ContDiff ℝ (⊤ : ℕ∞)
        (fun u : EuclideanSpace ℝ (Fin d) =>
          Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ))) := by
      have h1 : ContDiff ℝ (⊤ : ℕ∞) (fun u : EuclideanSpace ℝ (Fin d) => ‖T u‖ ^ 2) :=
        (contDiff_norm_sq ℝ).comp T.contDiff
      have h2 : ContDiff ℝ (⊤ : ℕ∞)
          (fun u : EuclideanSpace ℝ (Fin d) => -(Real.pi * ‖T u‖ ^ 2)) :=
        (contDiff_const.mul h1).neg
      have h3 : ContDiff ℝ (⊤ : ℕ∞)
          (fun u : EuclideanSpace ℝ (Fin d) => ((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ)) := by
        have h := Complex.ofRealCLM.contDiff.comp h2
        simp only [Function.comp_def, Complex.ofRealCLM_apply] at h
        exact h
      have h4 := (Complex.contDiff_exp (𝕜 := ℝ)).comp h3
      simp only [Function.comp_def] at h4
      exact h4
    set L : EuclideanSpace ℝ (Fin d) →L[ℝ] (EuclideanSpace ℝ (Fin d) →L[ℝ] ℂ) :=
      (-(2 * Real.pi) : ℝ) •
        ((ContinuousLinearMap.compL ℝ (EuclideanSpace ℝ (Fin d)) ℝ ℂ Complex.ofRealCLM).comp
          (((ContinuousLinearMap.compL ℝ (EuclideanSpace ℝ (Fin d))
                (EuclideanSpace ℝ (Fin d)) ℝ).flip T).comp
            ((innerSL ℝ).comp T))) with hLdef
    have hfd : fderiv ℝ
          (fun u : EuclideanSpace ℝ (Fin d) =>
            Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ)))
        = fun u : EuclideanSpace ℝ (Fin d) =>
            Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ)) • L u := by
      funext u
      have hq : (fun x : EuclideanSpace ℝ (Fin d) => ‖T x‖ ^ 2)
          = fun x : EuclideanSpace ℝ (Fin d) => (inner ℝ (T x) (T x) : ℝ) := by
        funext x
        rw [real_inner_self_eq_norm_sq]
      have h1 : HasFDerivAt (fun x : EuclideanSpace ℝ (Fin d) => ‖T x‖ ^ 2)
          ((fderivInnerCLM ℝ (T u, T u)).comp (T.prod T)) u := by
        rw [hq]
        exact (T.hasFDerivAt).inner ℝ (T.hasFDerivAt)
      have h2 := (h1.const_mul Real.pi).neg
      have h3 : HasFDerivAt
          (fun x : EuclideanSpace ℝ (Fin d) => ((-(Real.pi * ‖T x‖ ^ 2) : ℝ) : ℂ))
          (Complex.ofRealCLM.comp
            (-(Real.pi • ((fderivInnerCLM ℝ (T u, T u)).comp (T.prod T))))) u :=
        Complex.ofRealCLM.hasFDerivAt.comp u h2
      have h4 := h3.cexp
      have h5 : Complex.ofRealCLM.comp
          (-(Real.pi • ((fderivInnerCLM ℝ (T u, T u)).comp (T.prod T)))) = L u := by
        apply ContinuousLinearMap.ext
        intro v
        have hcomm : (inner ℝ (T v) (T u) : ℝ) = (inner ℝ (T u) (T v) : ℝ) :=
          real_inner_comm _ _
        simp only [hLdef, Complex.ofRealCLM_apply,
          ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
          ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply, fderivInnerCLM_apply,
          ContinuousLinearMap.compL_apply, ContinuousLinearMap.flip_apply,
          innerSL_apply_apply, hcomm, smul_eq_mul, Complex.real_smul]
        push_cast
        ring
      rw [← h5]
      exact h4.fderiv
    have hdec0 : ∀ k : ℕ, ∃ C : ℝ, ∀ u : EuclideanSpace ℝ (Fin d),
        ‖u‖ ^ k * ‖Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ))‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := scalar (Real.pi * c ^ 2) (by positivity) k
      refine ⟨C, fun u => ?_⟩
      have hnorm : ‖Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ))‖
          = Real.exp (-(Real.pi * ‖T u‖ ^ 2)) := by
        rw [Complex.norm_exp, Complex.ofReal_re]
      rw [hnorm]
      have hcu : c * ‖u‖ ≤ ‖T u‖ := hT u
      have h0 : (0:ℝ) ≤ c * ‖u‖ := mul_nonneg hc.le (norm_nonneg u)
      have hsq : (c * ‖u‖) ^ 2 ≤ ‖T u‖ ^ 2 := by nlinarith
      have hle : -(Real.pi * ‖T u‖ ^ 2) ≤ -(Real.pi * c ^ 2 * ‖u‖ ^ 2) := by
        nlinarith [Real.pi_pos]
      have hmono := Real.exp_le_exp.mpr hle
      have h2 : ‖u‖ ^ k * Real.exp (-(Real.pi * ‖T u‖ ^ 2))
          ≤ ‖u‖ ^ k * Real.exp (-(Real.pi * c ^ 2 * ‖u‖ ^ 2)) :=
        mul_le_mul_of_nonneg_left hmono (pow_nonneg (norm_nonneg u) k)
      exact h2.trans (hC ‖u‖ (norm_nonneg u))
    have hdecay := crux
      (fun u : EuclideanSpace ℝ (Fin d) => Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ)))
      L hsmooth hfd hdec0
    exact ⟨SchwartzMap.mk
      (fun u : EuclideanSpace ℝ (Fin d) => Complex.exp (((-(Real.pi * ‖T u‖ ^ 2) : ℝ) : ℂ)))
      hsmooth (fun k n => hdecay n k), fun u => rfl⟩
  
  have hmulpow : ∀ (ι : Type u) [Fintype ι]
      (Λ : ι → (EuclideanSpace ℝ (Fin d) →L[ℝ] ℂ)) (k : ι → ℕ)
      (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ),
      ∃ g : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
        ∀ u : EuclideanSpace ℝ (Fin d), g u = (∏ i, (Λ i u) ^ (k i)) * f u := by
    clear * -
    intro ι _ Λ k f
    have hP : Function.HasTemperateGrowth
        (∏ i : ι, (⇑(Λ i)) ^ (k i) : EuclideanSpace ℝ (Fin d) → ℂ) := by
      refine Finset.prod_induction (fun i => (⇑(Λ i)) ^ (k i))
        Function.HasTemperateGrowth (fun a b ha hb => ha.mul hb)
        (Function.HasTemperateGrowth.const (1 : ℂ)) ?_
      intro i _
      exact (ContinuousLinearMap.hasTemperateGrowth (Λ i)).pow (k i)
    refine ⟨SchwartzMap.bilinLeftCLM (ContinuousLinearMap.mul ℝ ℂ) hP f, fun u => ?_⟩
    simp only [SchwartzMap.bilinLeftCLM_apply, ContinuousLinearMap.mul_apply',
      Finset.prod_apply, Pi.pow_apply]
    ring
  
  have hquadclm : ∃ (T : EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)) (c : ℝ),
      0 < c ∧ (∀ u : EuclideanSpace ℝ (Fin d), c * ‖u‖ ≤ ‖T u‖) ∧
      ∀ x : NumberField.mixedEmbedding.mixedSpace K,
        ‖T (Φ x)‖ ^ 2
          = ∑ w : NumberField.InfinitePlace K,
              y w * NumberField.mixedEmbedding.normAtPlace w x ^ 2 := by
    have hs1 : ∀ x : NumberField.mixedEmbedding.mixedSpace K,
        kaiHZMixedInner K x x
          = ∑ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w x ^ 2 := by
      intro x
      have hsplit :
          (∑ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w x ^ 2)
            = (∑ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsReal),
                NumberField.mixedEmbedding.normAtPlace w x ^ 2)
              + ∑ w ∈ Finset.univ.filter
                  (fun w : NumberField.InfinitePlace K => ¬ w.IsReal),
                NumberField.mixedEmbedding.normAtPlace w x ^ 2 :=
        (Finset.sum_filter_add_sum_filter_not Finset.univ _ _).symm
      have hreal :
          (∑ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsReal),
              NumberField.mixedEmbedding.normAtPlace w x ^ 2)
            = ∑ v : {w : NumberField.InfinitePlace K // w.IsReal},
                NumberField.mixedEmbedding.normAtPlace (v : NumberField.InfinitePlace K) x ^ 2 :=
        Finset.sum_subtype _ (fun w => by simp) _
      have hcplx :
          (∑ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => ¬ w.IsReal),
              NumberField.mixedEmbedding.normAtPlace w x ^ 2)
            = ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                NumberField.mixedEmbedding.normAtPlace (p : NumberField.InfinitePlace K) x ^ 2 :=
        Finset.sum_subtype _
          (fun w => by simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]) _
      have hr2 : ∀ v : {w : NumberField.InfinitePlace K // w.IsReal},
          NumberField.mixedEmbedding.normAtPlace (v : NumberField.InfinitePlace K) x ^ 2
            = x.1 v * x.1 v := by
        intro v
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal v.2, Real.norm_eq_abs, sq_abs,
          pow_two]
      have hc2 : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          NumberField.mixedEmbedding.normAtPlace (p : NumberField.InfinitePlace K) x ^ 2
            = (x.2 p * (starRingEnd ℂ) (x.2 p)).re := by
        intro p
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex p.2, Complex.mul_conj',
          ← Complex.ofReal_pow, Complex.ofReal_re]
      rw [hsplit, hreal, hcplx, Finset.sum_congr rfl (fun v _ => hr2 v),
        Finset.sum_congr rfl (fun p _ => hc2 p)]
      rfl
    have hHN : ∀ v : NumberField.mixedEmbedding.mixedSpace K,
        ‖Φ v‖ ^ 2 = ∑ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w v ^ 2 := by
      intro v
      rw [← real_inner_self_eq_norm_sq, hΦ v v, hs1 v]
    obtain ⟨z, hz⟩ : ∃ z : NumberField.mixedEmbedding.mixedSpace K,
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z = Real.sqrt (y w) := by
      refine ⟨(fun v : {w : NumberField.InfinitePlace K // w.IsReal} =>
          Real.sqrt (y (v : NumberField.InfinitePlace K)),
        fun p : {w : NumberField.InfinitePlace K // w.IsComplex} =>
          ((Real.sqrt (y (p : NumberField.InfinitePlace K)) : ℝ) : ℂ)), ?_⟩
      intro w
      rcases w.isReal_or_isComplex with hw | hw
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw]
        simpa using Real.norm_of_nonneg (Real.sqrt_nonneg (y w))
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw]
        simpa using Real.norm_of_nonneg (Real.sqrt_nonneg (y w))
    have hmul : ∀ (w : NumberField.InfinitePlace K)
        (x : NumberField.mixedEmbedding.mixedSpace K),
        NumberField.mixedEmbedding.normAtPlace w (z * x)
          = Real.sqrt (y w) * NumberField.mixedEmbedding.normAtPlace w x := by
      intro w x
      rw [map_mul, hz w]
    obtain ⟨T, hT⟩ : ∃ T : EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d),
        ∀ x : NumberField.mixedEmbedding.mixedSpace K, T (Φ x) = Φ (z * x) := by
      refine ⟨LinearMap.toContinuousLinearMap
        (Φ.toLinearMap ∘ₗ LinearMap.mulLeft ℝ z ∘ₗ Φ.symm.toLinearMap), ?_⟩
      intro x
      simp [LinearMap.mulLeft_apply]
    have hquad : ∀ x : NumberField.mixedEmbedding.mixedSpace K,
        ‖T (Φ x)‖ ^ 2 = ∑ w : NumberField.InfinitePlace K,
          y w * NumberField.mixedEmbedding.normAtPlace w x ^ 2 := by
      intro x
      rw [hT x, hHN (z * x)]
      refine Finset.sum_congr rfl fun w _ => ?_
      rw [hmul w x, mul_pow, Real.sq_sqrt (hy w).le]
    have hmpos : 0 < ∏ w : NumberField.InfinitePlace K, min (y w) 1 :=
      Finset.prod_pos (fun w _ => lt_min (hy w) one_pos)
    have hmle : ∀ j : NumberField.InfinitePlace K,
        (∏ w : NumberField.InfinitePlace K, min (y w) 1) ≤ y j := by
      intro j
      have h1 : (∏ w ∈ Finset.univ.erase j, min (y w) 1) ≤ 1 :=
        Finset.prod_le_one (fun i _ => le_min (hy i).le zero_le_one)
          (fun i _ => min_le_right _ _)
      have h2 : min (y j) 1 * (∏ w ∈ Finset.univ.erase j, min (y w) 1)
          = ∏ w : NumberField.InfinitePlace K, min (y w) 1 :=
        Finset.mul_prod_erase Finset.univ (fun w => min (y w) 1) (Finset.mem_univ j)
      have h3 : (0 : ℝ) ≤ min (y j) 1 := le_min (hy j).le zero_le_one
      calc (∏ w : NumberField.InfinitePlace K, min (y w) 1)
          = min (y j) 1 * (∏ w ∈ Finset.univ.erase j, min (y w) 1) := h2.symm
        _ ≤ min (y j) 1 * 1 := mul_le_mul_of_nonneg_left h1 h3
        _ = min (y j) 1 := mul_one _
        _ ≤ y j := min_le_left _ _
    refine ⟨T, Real.sqrt (∏ w : NumberField.InfinitePlace K, min (y w) 1),
      Real.sqrt_pos.mpr hmpos, ?_, hquad⟩
    intro u
    have hu : Φ (Φ.symm u) = u := Φ.apply_symm_apply u
    have hA : ‖u‖ ^ 2 = ∑ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w (Φ.symm u) ^ 2 := by
      have h := hHN (Φ.symm u); rwa [hu] at h
    have hB : ‖T u‖ ^ 2 = ∑ w : NumberField.InfinitePlace K,
        y w * NumberField.mixedEmbedding.normAtPlace w (Φ.symm u) ^ 2 := by
      have h := hquad (Φ.symm u); rwa [hu] at h
    have hkey : (∏ w : NumberField.InfinitePlace K, min (y w) 1) * ‖u‖ ^ 2 ≤ ‖T u‖ ^ 2 := by
      rw [hA, hB, Finset.mul_sum]
      exact Finset.sum_le_sum fun w _ =>
        mul_le_mul_of_nonneg_right (hmle w) (sq_nonneg _)
    have h1 : Real.sqrt ((∏ w : NumberField.InfinitePlace K, min (y w) 1) * ‖u‖ ^ 2)
        ≤ Real.sqrt (‖T u‖ ^ 2) := Real.sqrt_le_sqrt hkey
    rwa [Real.sqrt_mul hmpos.le, Real.sqrt_sq (norm_nonneg u),
      Real.sqrt_sq (norm_nonneg (T u))] at h1
  
  have harch : ∃ (Λr : {w : NumberField.InfinitePlace K // w.IsReal} →
              (EuclideanSpace ℝ (Fin d) →L[ℝ] ℂ))
      (Λc : {w : NumberField.InfinitePlace K // w.IsComplex} →
              (EuclideanSpace ℝ (Fin d) →L[ℝ] ℂ)),
      ∀ x : NumberField.mixedEmbedding.mixedSpace K,
        (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            (Λr w (Φ x)) ^ (if η w then 1 else 0)) *
          (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            (Λc p (Φ x)) ^ ((l p).natAbs))
          = kaiHZArchWeight K η l x := by
    obtain ⟨Λr, hΛr⟩ :
        ∃ Λr : {w : NumberField.InfinitePlace K // w.IsReal} →
            (EuclideanSpace ℝ (Fin d) →L[ℝ] ℂ),
          ∀ (w : {w : NumberField.InfinitePlace K // w.IsReal})
            (x : NumberField.mixedEmbedding.mixedSpace K),
            Λr w (Φ x) = ((x.1 w : ℝ) : ℂ) := by
      refine ⟨fun w => LinearMap.toContinuousLinearMap
        ((Complex.ofRealCLM : ℝ →L[ℝ] ℂ).toLinearMap.comp
          (((LinearMap.proj (R := ℝ)
                (φ := fun _ : {w : NumberField.InfinitePlace K // w.IsReal} => ℝ) w).comp
              (LinearMap.fst ℝ ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
                ({w : NumberField.InfinitePlace K // w.IsComplex} → ℂ))).comp
            (Φ.symm : EuclideanSpace ℝ (Fin d) →ₗ[ℝ]
                NumberField.mixedEmbedding.mixedSpace K))), ?_⟩
      intro w x
      simp only [LinearMap.coe_toContinuousLinearMap', LinearMap.comp_apply,
        LinearMap.proj_apply, LinearMap.fst_apply, ContinuousLinearMap.coe_coe,
        Complex.ofRealCLM_apply, LinearEquiv.coe_coe, LinearEquiv.coe_toLinearMap,
        LinearEquiv.symm_apply_apply]
    obtain ⟨Λc, hΛc⟩ :
        ∃ Λc : {w : NumberField.InfinitePlace K // w.IsComplex} →
            (EuclideanSpace ℝ (Fin d) →L[ℝ] ℂ),
          ∀ (p : {w : NumberField.InfinitePlace K // w.IsComplex})
            (x : NumberField.mixedEmbedding.mixedSpace K),
            Λc p (Φ x) = if 0 ≤ l p then x.2 p else (starRingEnd ℂ) (x.2 p) := by
      refine ⟨fun p =>
        if 0 ≤ l p then
          LinearMap.toContinuousLinearMap
            (((LinearMap.proj (R := ℝ)
                  (φ := fun _ : {w : NumberField.InfinitePlace K // w.IsComplex} => ℂ) p).comp
                (LinearMap.snd ℝ ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
                  ({w : NumberField.InfinitePlace K // w.IsComplex} → ℂ))).comp
              (Φ.symm : EuclideanSpace ℝ (Fin d) →ₗ[ℝ]
                  NumberField.mixedEmbedding.mixedSpace K))
        else
          (Complex.conjCLE : ℂ →L[ℝ] ℂ).comp
            (LinearMap.toContinuousLinearMap
              (((LinearMap.proj (R := ℝ)
                    (φ := fun _ : {w : NumberField.InfinitePlace K // w.IsComplex} => ℂ) p).comp
                  (LinearMap.snd ℝ ({w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
                    ({w : NumberField.InfinitePlace K // w.IsComplex} → ℂ))).comp
                (Φ.symm : EuclideanSpace ℝ (Fin d) →ₗ[ℝ]
                    NumberField.mixedEmbedding.mixedSpace K))), ?_⟩
      intro p x
      by_cases h : 0 ≤ l p
      · simp only [if_pos h, LinearMap.coe_toContinuousLinearMap', LinearMap.comp_apply,
          LinearMap.proj_apply, LinearMap.snd_apply, LinearEquiv.coe_coe,
          LinearEquiv.coe_toLinearMap, LinearEquiv.symm_apply_apply]
      · simp only [if_neg h, ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
          Complex.conjCLE_apply, LinearMap.coe_toContinuousLinearMap',
          LinearMap.comp_apply, LinearMap.proj_apply, LinearMap.snd_apply,
          LinearEquiv.coe_coe, LinearEquiv.coe_toLinearMap,
          LinearEquiv.symm_apply_apply]
    refine ⟨Λr, Λc, fun x => ?_⟩
    have hr : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (Λr w (Φ x)) ^ (if η w then 1 else 0)
          = (if η w then ((x.1 w : ℝ) : ℂ) else 1) := by
      intro w
      rw [hΛr w x]
      by_cases hw : η w = true
      · simp [hw]
      · simp [hw]
    have hc : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        (Λc p (Φ x)) ^ ((l p).natAbs) = kaiHZCplxWeight (l p) (x.2 p) := by
      intro p
      rw [hΛc p x]
      by_cases h : 0 ≤ l p
      · have hexp : (l p).natAbs = (l p).toNat := by omega
        rw [if_pos h, hexp]
        simp only [kaiHZCplxWeight]
        rw [if_pos h]
      · have hexp : (l p).natAbs = (-(l p)).toNat := by omega
        rw [if_neg h, hexp]
        simp only [kaiHZCplxWeight]
        rw [if_neg h]
    have hP1 : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (Λr w (Φ x)) ^ (if η w then 1 else 0))
        = ∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            (if η w then ((x.1 w : ℝ) : ℂ) else 1) :=
      Finset.prod_congr rfl (fun w _ => hr w)
    have hP2 : (∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
          (Λc p (Φ x)) ^ ((l p).natAbs))
        = ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            kaiHZCplxWeight (l p) (x.2 p) :=
      Finset.prod_congr rfl (fun p _ => hc p)
    rw [hP1, hP2]
    simp only [kaiHZArchWeight]
  
  obtain ⟨Λr, Λc, hΛ⟩ := harch
  obtain ⟨T, c, hc, hcoer, hTsq⟩ := hquadclm
  obtain ⟨F₀, hF₀⟩ := hgcs T c hc hcoer
  obtain ⟨F₁, hF₁⟩ :=
    hmulpow _ Λr (fun w => if η w then 1 else 0) F₀
  obtain ⟨F₂, hF₂⟩ :=
    hmulpow _ Λc (fun p => (l p).natAbs) F₁
  refine ⟨F₂, fun x => ?_⟩
  have hgauss : ((kaiHZGaussian K y x : ℝ) : ℂ)
      = Complex.exp (((-(Real.pi * ∑ w : NumberField.InfinitePlace K,
          y w * NumberField.mixedEmbedding.normAtPlace w x ^ 2) : ℝ) : ℂ)) := by
    simp only [kaiHZGaussian, Complex.ofReal_exp]
  rw [hgauss, ← hΛ x]
  simp only [hF₂, hF₁, hF₀, hTsq]
  ring

theorem kai_hz_test_fourier_unif (hF : KaiHZTestFourierProp) : KaiHZTestFourierUnifProp :=
by
  
  have dilR : ∀ (f : ℝ → ℂ) (b : ℂ) (a : ℝ), 0 < a → ∀ ξ : ℝ,
      FourierTransform.fourier (fun x : ℝ => b * f (a * x)) ξ
        = b * ((a⁻¹ : ℝ) : ℂ) * FourierTransform.fourier f (ξ / a) := by
    intro f b a ha ξ
    rw [Real.fourier_real_eq, Real.fourier_real_eq]
    have hpt : ∀ x : ℝ, Real.fourierChar (-(x * ξ)) • (b * f (a * x))
        = b * (fun t : ℝ => Real.fourierChar (-(t * (ξ / a))) • f t) (a * x) := by
      intro x
      have hx : a * x * (ξ / a) = x * ξ := by field_simp
      simp only [hx, Circle.smul_def, smul_eq_mul]
      ring
    refine (MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hpt)).trans ?_
    rw [MeasureTheory.integral_const_mul, MeasureTheory.Measure.integral_comp_mul_left
      (fun t : ℝ => Real.fourierChar (-(t * (ξ / a))) • f t) a,
      abs_of_pos (inv_pos.mpr ha), Complex.real_smul]
    ring
  
  have dilC : ∀ (g : ℂ → ℂ) (b : ℂ) (a : ℝ), 0 < a → ∀ w : ℂ,
      FourierTransform.fourier (fun z : ℂ => b * g (a • z)) w
        = b * (((a ^ 2)⁻¹ : ℝ) : ℂ) * FourierTransform.fourier g (a⁻¹ • w) := by
    intro g b a ha w
    rw [Real.fourier_eq, Real.fourier_eq]
    have hpt : ∀ z : ℂ, Real.fourierChar (-(inner ℝ z w)) • (b * g (a • z))
        = b * (fun u : ℂ => Real.fourierChar (-(inner ℝ u (a⁻¹ • w))) • g u) (a • z) := by
      intro z
      have hz : inner ℝ (a • z) (a⁻¹ • w) = inner ℝ z w := by
        rw [real_inner_smul_left, real_inner_smul_right, ← mul_assoc, mul_inv_cancel₀ ha.ne',
          one_mul]
      simp only [hz, Circle.smul_def, smul_eq_mul]
      ring
    refine (MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hpt)).trans ?_
    rw [MeasureTheory.integral_const_mul, MeasureTheory.Measure.integral_comp_smul
      MeasureTheory.volume (fun u : ℂ => Real.fourierChar (-(inner ℝ u (a⁻¹ • w))) • g u) a,
      Complex.finrank_real_complex, abs_of_pos (by positivity), Complex.real_smul]
    ring
  
  have wsmul : ∀ (l : ℤ) (a : ℝ) (z : ℂ),
      kaiHZCplxWeight l (a • z) = (a : ℂ) ^ l.natAbs * kaiHZCplxWeight l z := by
    intro l a z
    unfold kaiHZCplxWeight
    rw [Complex.real_smul]
    split_ifs with hl
    · have h : l.toNat = l.natAbs := by omega
      rw [mul_pow, h]
    · have h : (-l).toNat = l.natAbs := by omega
      rw [map_mul, Complex.conj_ofReal, mul_pow, h]
  
  have hexp : ∀ y : ℝ, 0 < y → ∀ m : ℕ, y ^ (-((m : ℝ) / 2)) = ((Real.sqrt y) ^ m)⁻¹ := by
    intro y hy m
    rw [Real.rpow_neg hy.le, show (m : ℝ) / 2 = (1 / 2) * (m : ℝ) by ring,
      Real.rpow_mul_natCast hy.le, ← Real.sqrt_eq_rpow]
  refine ⟨?_, ?_⟩
  · intro ε hε
    obtain ⟨c, hc, h1⟩ := hF.1 1 one_pos ε hε
    obtain ⟨f₁, hf₁⟩ : ∃ f₁ : ℝ → ℂ, f₁ = fun x : ℝ =>
        (x : ℂ) ^ ε * Complex.exp (((-(Real.pi * 1 * x ^ 2) : ℝ) : ℂ)) := ⟨_, rfl⟩
    rw [← hf₁] at h1
    refine ⟨c, hc, ?_⟩
    intro y hy ξ
    obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = Real.sqrt y := ⟨_, rfl⟩
    have ha : 0 < a := by rw [ha_def]; exact Real.sqrt_pos.mpr hy
    have ha2 : a ^ 2 = y := by rw [ha_def]; exact Real.sq_sqrt hy.le
    have haC : (a : ℂ) ≠ 0 := by exact_mod_cast ha.ne'
    have hexpa : ∀ m : ℕ, y ^ (-((m : ℝ) / 2)) = (a ^ m)⁻¹ := by
      intro m; rw [ha_def]; exact hexp y hy m
    have hfun : (fun x : ℝ => (x : ℂ) ^ ε * Complex.exp (((-(Real.pi * y * x ^ 2) : ℝ) : ℂ)))
        = fun x : ℝ => (((a ^ ε)⁻¹ : ℝ) : ℂ) * f₁ (a * x) := by
      funext x
      have e1 : Real.pi * 1 * (a * x) ^ 2 = Real.pi * y * x ^ 2 := by rw [← ha2]; ring
      rw [hf₁]
      simp only [e1]
      push_cast
      rw [mul_pow]
      field_simp
    have e2 : -(Real.pi * (ξ / a) ^ 2 / 1) = -(Real.pi * ξ ^ 2 / y) := by
      rw [div_pow, ha2]; ring
    have e3 : y ^ (-((1 : ℝ) / 2 + (ε : ℝ))) = (a ^ (2 * ε + 1))⁻¹ := by
      rw [← hexpa]; congr 1; push_cast; ring
    rw [hfun, dilR f₁ _ a ha ξ, h1 (ξ / a), Real.one_rpow, e2, e3]
    push_cast
    ring
  · intro l
    obtain ⟨c, hc, h1⟩ := hF.2 1 one_pos l
    obtain ⟨g₁, hg₁⟩ : ∃ g₁ : ℂ → ℂ, g₁ = fun z : ℂ =>
        kaiHZCplxWeight l z * Complex.exp (((-(Real.pi * 1 * ‖z‖ ^ 2) : ℝ) : ℂ)) := ⟨_, rfl⟩
    rw [← hg₁] at h1
    refine ⟨c, hc, ?_⟩
    intro y hy w
    obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = Real.sqrt y := ⟨_, rfl⟩
    have ha : 0 < a := by rw [ha_def]; exact Real.sqrt_pos.mpr hy
    have ha2 : a ^ 2 = y := by rw [ha_def]; exact Real.sq_sqrt hy.le
    have haC : (a : ℂ) ≠ 0 := by exact_mod_cast ha.ne'
    have hexpa : ∀ m : ℕ, y ^ (-((m : ℝ) / 2)) = (a ^ m)⁻¹ := by
      intro m; rw [ha_def]; exact hexp y hy m
    have hfun : (fun z : ℂ => kaiHZCplxWeight l z *
          Complex.exp (((-(Real.pi * y * ‖z‖ ^ 2) : ℝ) : ℂ)))
        = fun z : ℂ => (((a ^ l.natAbs)⁻¹ : ℝ) : ℂ) * g₁ (a • z) := by
      funext z
      have e1 : Real.pi * 1 * ‖a • z‖ ^ 2 = Real.pi * y * ‖z‖ ^ 2 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos ha, ← ha2]; ring
      rw [hg₁]
      simp only [e1, wsmul]
      push_cast
      field_simp
    have e2 : -(Real.pi * ‖a⁻¹ • w‖ ^ 2 / 1) = -(Real.pi * ‖w‖ ^ 2 / y) := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ha), mul_pow, inv_pow, ha2]
      ring
    have habs : |(l : ℝ)| = ((l.natAbs : ℕ) : ℝ) := by
      rw [Nat.cast_natAbs, Int.cast_abs]
    have e3 : y ^ (-(1 + |(l : ℝ)|)) = (a ^ (2 * l.natAbs + 2))⁻¹ := by
      rw [← hexpa, habs]; congr 1; push_cast; ring
    rw [hfun, dilC g₁ _ a ha w, h1 (a⁻¹ • w), wsmul l a⁻¹ w, Real.one_rpow, e2, e3]
    push_cast
    ring

theorem kai_hz_mixed_test_fourier_formula (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hU : KaiHZTestFourierUnifProp)
    (d : ℕ)
    (Φ : (NumberField.mixedEmbedding.mixedSpace K) ≃ₗ[ℝ] EuclideanSpace ℝ (Fin d))
    (hΦ : ∀ x v : NumberField.mixedEmbedding.mixedSpace K,
        (inner ℝ (Φ x) (Φ v) : ℝ) = kaiHZMixedInner K x v)
    (hmeas : MeasureTheory.MeasurePreserving (⇑Φ)
        MeasureTheory.volume MeasureTheory.volume)
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ) :
    ∃ κ₀ : ℂ, ‖κ₀‖ = 1 ∧
      ∀ y : NumberField.InfinitePlace K → ℝ, (∀ w, 0 < y w) →
        ∀ ξ : NumberField.mixedEmbedding.mixedSpace K,
          FourierTransform.fourier
              (fun z : EuclideanSpace ℝ (Fin d) =>
                kaiHZArchWeight K η l (Φ.symm z) *
                  ((kaiHZGaussian K y (Φ.symm z) : ℝ) : ℂ)) (Φ ξ)
            = κ₀ * (((∏ w : NumberField.InfinitePlace K,
                    y w ^ (-((w.mult : ℝ) / 2 + kaiHZDeg K η l w))) : ℝ) : ℂ)
                * kaiHZArchWeight K η l ξ
                * ((kaiHZGaussian K (fun w => 1 / y w) ξ : ℝ) : ℂ) :=
by
  classical
  
  have hfactor : ∀ (f : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ → ℂ)
      (g : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ → ℂ)
      (ξ : NumberField.mixedEmbedding.mixedSpace K),
      FourierTransform.fourier
          (fun z : EuclideanSpace ℝ (Fin d) =>
            (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, f w ((Φ.symm z).1 w)) *
              ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, g p ((Φ.symm z).2 p))
          (Φ ξ)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              FourierTransform.fourier (f w) (ξ.1 w)) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              FourierTransform.fourier (g p) (ξ.2 p) := by
    intro f g ξ
    obtain ⟨A, hA⟩ : ∃ A : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ → ℂ,
        A = fun w t =>
          Complex.exp (((-2 * Real.pi * (t * ξ.1 w) : ℝ) : ℂ) * Complex.I) * f w t := ⟨_, rfl⟩
    obtain ⟨B, hB⟩ : ∃ B : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ → ℂ,
        B = fun p z =>
          Complex.exp (((-2 * Real.pi * (z * (starRingEnd ℂ) (ξ.2 p)).re : ℝ) : ℂ) *
            Complex.I) * g p z := ⟨_, rfl⟩
    have hRfour : ∀ (h : ℝ → ℂ) (t : ℝ),
        FourierTransform.fourier h t
          = ∫ s : ℝ, Complex.exp (((-2 * Real.pi * (s * t) : ℝ) : ℂ) * Complex.I) * h s := by
      intro h t
      rw [Real.fourier_eq']
      have hrr : ∀ v : ℝ, (inner ℝ v t : ℝ) = v * t := by
        intro v; rw [RCLike.inner_apply, starRingEnd_apply, star_trivial, mul_comm]
      simp only [hrr, smul_eq_mul]
    have hCfour : ∀ (h : ℂ → ℂ) (w : ℂ),
        FourierTransform.fourier h w
          = ∫ z : ℂ, Complex.exp (((-2 * Real.pi * (z * (starRingEnd ℂ) w).re : ℝ) : ℂ) *
              Complex.I) * h z := by
      intro h w
      rw [Real.fourier_eq']
      have hcc : ∀ v : ℂ, (inner ℝ v w : ℝ) = (v * (starRingEnd ℂ) w).re := by
        intro v
        rw [real_inner_eq_re_inner ℂ, RCLike.inner_apply, RCLike.re_to_complex]
        simp only [Complex.mul_re, Complex.conj_re, Complex.conj_im]
        ring
      simp only [hcc, smul_eq_mul]
    have hker : ∀ x : NumberField.mixedEmbedding.mixedSpace K,
        Complex.exp (((-2 * Real.pi * kaiHZMixedInner K x ξ : ℝ) : ℂ) * Complex.I)
          = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                Complex.exp (((-2 * Real.pi * (x.1 w * ξ.1 w) : ℝ) : ℂ) * Complex.I)) *
            ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                Complex.exp (((-2 * Real.pi * (x.2 p * (starRingEnd ℂ) (ξ.2 p)).re : ℝ) : ℂ) *
                  Complex.I) := by
      intro x
      have hexp : (-2 * Real.pi * kaiHZMixedInner K x ξ)
          = (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
                -2 * Real.pi * (x.1 w * ξ.1 w))
            + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                -2 * Real.pi * (x.2 p * (starRingEnd ℂ) (ξ.2 p)).re := by
        simp only [kaiHZMixedInner, mul_add, Finset.mul_sum]
      rw [← Complex.exp_sum, ← Complex.exp_sum, ← Complex.exp_add, hexp]
      push_cast
      rw [add_mul, Finset.sum_mul, Finset.sum_mul]
    have hfub : ∀ (A' : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ → ℂ)
        (B' : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ → ℂ),
        (∫ x : NumberField.mixedEmbedding.mixedSpace K,
            (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, A' w (x.1 w)) *
              ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, B' p (x.2 p))
          = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, ∫ t : ℝ, A' w t) *
              ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ∫ z : ℂ, B' p z := by
      intro A' B'
      refine Eq.trans (MeasureTheory.integral_prod_mul
          (fun u : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ => ∏ w, A' w (u w))
          (fun v : {w : NumberField.InfinitePlace K // w.IsComplex} → ℂ => ∏ p, B' p (v p))) ?_
      congr 1
      · exact MeasureTheory.integral_fintype_prod_eq_prod A'
      · exact MeasureTheory.integral_fintype_prod_eq_prod B'
    have hemb : MeasurableEmbedding (⇑Φ) :=
      Φ.toContinuousLinearEquiv.toHomeomorph.measurableEmbedding
    calc FourierTransform.fourier
          (fun z : EuclideanSpace ℝ (Fin d) =>
            (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, f w ((Φ.symm z).1 w)) *
              ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, g p ((Φ.symm z).2 p))
          (Φ ξ)
        = ∫ v : EuclideanSpace ℝ (Fin d),
            Complex.exp (((-2 * Real.pi * (inner ℝ v (Φ ξ) : ℝ) : ℝ) : ℂ) * Complex.I) •
              ((∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, f w ((Φ.symm v).1 w)) *
                ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                  g p ((Φ.symm v).2 p)) :=
          Real.fourier_eq' _ _
      _ = ∫ x : NumberField.mixedEmbedding.mixedSpace K,
            Complex.exp (((-2 * Real.pi * (inner ℝ (Φ x) (Φ ξ) : ℝ) : ℝ) : ℂ) * Complex.I) •
              ((∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
                  f w ((Φ.symm (Φ x)).1 w)) *
                ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                  g p ((Φ.symm (Φ x)).2 p)) := (hmeas.integral_comp hemb _).symm
      _ = ∫ x : NumberField.mixedEmbedding.mixedSpace K,
            (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, A w (x.1 w)) *
              ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, B p (x.2 p) := by
          refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
          dsimp only
          rw [hΦ x ξ, LinearEquiv.symm_apply_apply, smul_eq_mul, hker x]
          simp only [hA, hB, Finset.prod_mul_distrib]
          ring
      _ = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, ∫ t : ℝ, A w t) *
            ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, ∫ z : ℂ, B p z := hfub A B
      _ = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              FourierTransform.fourier (f w) (ξ.1 w)) *
            ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              FourierTransform.fourier (g p) (ξ.2 p) := by
          rw [hA, hB]
          congr 1
          · exact Finset.prod_congr rfl fun w _ => (hRfour (f w) (ξ.1 w)).symm
          · exact Finset.prod_congr rfl fun p _ => (hCfour (g p) (ξ.2 p)).symm
  
  have hagp : ∀ (y : NumberField.InfinitePlace K → ℝ)
      (x : NumberField.mixedEmbedding.mixedSpace K),
      kaiHZArchWeight K η l x * ((kaiHZGaussian K y x : ℝ) : ℂ)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              (((x.1 w : ℝ) : ℂ) ^ (if η w then 1 else 0 : ℕ) *
                Complex.exp (((-(Real.pi * y (w : NumberField.InfinitePlace K) *
                  (x.1 w) ^ 2) : ℝ) : ℂ)))) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              (kaiHZCplxWeight (l p) (x.2 p) *
                Complex.exp (((-(Real.pi * y (p : NumberField.InfinitePlace K) *
                  ‖x.2 p‖ ^ 2) : ℝ) : ℂ))) := by
    intro y x
    have hsplit : ∀ F : NumberField.InfinitePlace K → ℝ,
        (∑ v : NumberField.InfinitePlace K, F v)
          = (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
                F (w : NumberField.InfinitePlace K))
            + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                F (p : NumberField.InfinitePlace K) := by
      intro F
      rw [← Finset.sum_filter_add_sum_filter_not Finset.univ
          (fun v : NumberField.InfinitePlace K => v.IsReal) F]
      congr 1
      · exact Finset.sum_subtype _ (fun v => by simp) F
      · exact Finset.sum_subtype _
          (fun v => by simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]) F
    have hexpsplit :
        -(Real.pi * ∑ v : NumberField.InfinitePlace K,
            y v * NumberField.mixedEmbedding.normAtPlace v x ^ 2)
          = (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
                -(Real.pi * y (w : NumberField.InfinitePlace K) * (x.1 w) ^ 2))
            + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex},
                -(Real.pi * y (p : NumberField.InfinitePlace K) * ‖x.2 p‖ ^ 2) := by
      have h0 : -(Real.pi * ∑ v : NumberField.InfinitePlace K,
            y v * NumberField.mixedEmbedding.normAtPlace v x ^ 2)
          = ∑ v : NumberField.InfinitePlace K,
              -(Real.pi * (y v * NumberField.mixedEmbedding.normAtPlace v x ^ 2)) := by
        rw [Finset.mul_sum, Finset.sum_neg_distrib]
      rw [h0, hsplit (fun v : NumberField.InfinitePlace K =>
        -(Real.pi * (y v * NumberField.mixedEmbedding.normAtPlace v x ^ 2)))]
      congr 1
      · refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2 x, Subtype.coe_eta,
          Real.norm_eq_abs, sq_abs]
        ring
      · refine Finset.sum_congr rfl (fun p _ => ?_)
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex p.2 x, Subtype.coe_eta]
        ring
    have hG : ((kaiHZGaussian K y x : ℝ) : ℂ)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              Complex.exp (((-(Real.pi * y (w : NumberField.InfinitePlace K) *
                (x.1 w) ^ 2) : ℝ) : ℂ))) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              Complex.exp (((-(Real.pi * y (p : NumberField.InfinitePlace K) *
                ‖x.2 p‖ ^ 2) : ℝ) : ℂ)) := by
      simp only [kaiHZGaussian]
      rw [hexpsplit, Complex.ofReal_exp, Complex.ofReal_add, Complex.exp_add,
        Complex.ofReal_sum, Complex.ofReal_sum, Complex.exp_sum, Complex.exp_sum]
    have hW : kaiHZArchWeight K η l x
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              ((x.1 w : ℝ) : ℂ) ^ (if η w then 1 else 0 : ℕ)) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              kaiHZCplxWeight (l p) (x.2 p) := by
      simp only [kaiHZArchWeight]
      congr 1
      refine Finset.prod_congr rfl (fun w _ => ?_)
      cases h : η w <;> simp [h]
    rw [hW, hG, Finset.prod_mul_distrib, Finset.prod_mul_distrib]
    ring
  
  obtain ⟨c0, hc0n, hc0⟩ := hU.1 0 (by norm_num)
  obtain ⟨c1, hc1n, hc1⟩ := hU.1 1 le_rfl
  choose cC hcCn hcC using hU.2
  obtain ⟨cR, hcR⟩ : ∃ cR : {w : NumberField.InfinitePlace K // w.IsReal} → ℂ,
      cR = fun w => if η w then c1 else c0 := ⟨_, rfl⟩
  have hcRn : ∀ w, ‖cR w‖ = 1 := by
    intro w
    rw [hcR]
    dsimp only
    split_ifs
    · exact hc1n
    · exact hc0n
  obtain ⟨κ₀, hκ₀⟩ : ∃ κ₀ : ℂ,
      κ₀ = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, cR w) *
        ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex}, cC (l p) := ⟨_, rfl⟩
  have hκn : ‖κ₀‖ = 1 := by
    rw [hκ₀, norm_mul, norm_prod, norm_prod,
      Finset.prod_eq_one (fun w _ => hcRn w), Finset.prod_eq_one (fun p _ => hcCn (l p)),
      mul_one]
  refine ⟨κ₀, hκn, ?_⟩
  intro y hy ξ
  have hfun : (fun z : EuclideanSpace ℝ (Fin d) =>
        kaiHZArchWeight K η l (Φ.symm z) *
          ((kaiHZGaussian K y (Φ.symm z) : ℝ) : ℂ))
      = fun z : EuclideanSpace ℝ (Fin d) =>
        (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            ((((Φ.symm z).1 w : ℝ) : ℂ) ^ (if η w then 1 else 0 : ℕ) *
              Complex.exp (((-(Real.pi * y (w : NumberField.InfinitePlace K) *
                ((Φ.symm z).1 w) ^ 2) : ℝ) : ℂ)))) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            (kaiHZCplxWeight (l p) ((Φ.symm z).2 p) *
              Complex.exp (((-(Real.pi * y (p : NumberField.InfinitePlace K) *
                ‖(Φ.symm z).2 p‖ ^ 2) : ℝ) : ℂ))) := by
    funext z
    exact hagp y (Φ.symm z)
  have hfac := hfactor
      (fun w t => ((t : ℂ) ^ (if η w then 1 else 0 : ℕ) *
        Complex.exp (((-(Real.pi * y (w : NumberField.InfinitePlace K) * t ^ 2) : ℝ) : ℂ))))
      (fun p z => (kaiHZCplxWeight (l p) z *
        Complex.exp (((-(Real.pi * y (p : NumberField.InfinitePlace K) *
          ‖z‖ ^ 2) : ℝ) : ℂ))))
      ξ
  rw [hfun, hfac]
  have hR : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      FourierTransform.fourier
          (fun t : ℝ => ((t : ℂ) ^ (if η w then 1 else 0 : ℕ) *
            Complex.exp (((-(Real.pi * y (w : NumberField.InfinitePlace K) *
              t ^ 2) : ℝ) : ℂ)))) (ξ.1 w)
        = cR w *
            ((y (w : NumberField.InfinitePlace K) ^
                (-((1 : ℝ) / 2 + ((if η w then 1 else 0 : ℕ) : ℝ))) : ℝ) : ℂ) *
            ((ξ.1 w : ℝ) : ℂ) ^ (if η w then 1 else 0 : ℕ) *
            Complex.exp (((-(Real.pi * (ξ.1 w) ^ 2 /
              y (w : NumberField.InfinitePlace K)) : ℝ) : ℂ)) := by
    intro w
    by_cases h : η w = true
    · simp only [hcR, if_pos h]
      exact hc1 (y (w : NumberField.InfinitePlace K)) (hy _) (ξ.1 w)
    · simp only [hcR, if_neg h]
      exact hc0 (y (w : NumberField.InfinitePlace K)) (hy _) (ξ.1 w)
  have hC : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
      FourierTransform.fourier
          (fun z : ℂ => (kaiHZCplxWeight (l p) z *
            Complex.exp (((-(Real.pi * y (p : NumberField.InfinitePlace K) *
              ‖z‖ ^ 2) : ℝ) : ℂ)))) (ξ.2 p)
        = cC (l p) *
            ((y (p : NumberField.InfinitePlace K) ^
                (-(1 + |((l p : ℤ) : ℝ)|)) : ℝ) : ℂ) *
            kaiHZCplxWeight (l p) (ξ.2 p) *
            Complex.exp (((-(Real.pi * ‖ξ.2 p‖ ^ 2 /
              y (p : NumberField.InfinitePlace K)) : ℝ) : ℂ)) := by
    intro p
    exact hcC (l p) (y (p : NumberField.InfinitePlace K)) (hy _) (ξ.2 p)
  simp only [hR, hC, Finset.prod_mul_distrib]
  have hsplit : ∀ G : NumberField.InfinitePlace K → ℝ,
      (∏ v : NumberField.InfinitePlace K, G v)
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              G (w : NumberField.InfinitePlace K)) *
          ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              G (p : NumberField.InfinitePlace K) := by
    intro G
    rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
        (fun v : NumberField.InfinitePlace K => v.IsReal) G]
    congr 1
    · exact Finset.prod_subtype _ (fun v => by simp) G
    · exact Finset.prod_subtype _
        (fun v => by simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]) G
  have hPreal : (∏ v : NumberField.InfinitePlace K,
        y v ^ (-((v.mult : ℝ) / 2 + kaiHZDeg K η l v)))
      = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            y (w : NumberField.InfinitePlace K) ^
              (-((1 : ℝ) / 2 + ((if η w then 1 else 0 : ℕ) : ℝ)))) *
        ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            y (p : NumberField.InfinitePlace K) ^ (-(1 + |((l p : ℤ) : ℝ)|)) := by
    rw [hsplit (fun v : NumberField.InfinitePlace K =>
      y v ^ (-((v.mult : ℝ) / 2 + kaiHZDeg K η l v)))]
    congr 1
    · refine Finset.prod_congr rfl (fun w _ => ?_)
      have hm : (((w : NumberField.InfinitePlace K).mult : ℕ) : ℝ) = 1 := by
        rw [NumberField.InfinitePlace.mult_isReal w]; norm_num
      have hd : kaiHZDeg K η l (w : NumberField.InfinitePlace K)
          = ((if η w then 1 else 0 : ℕ) : ℝ) := by
        have h1 : kaiHZDeg K η l (w : NumberField.InfinitePlace K)
            = (if η w then (1 : ℝ) else 0) := by
          simp only [kaiHZDeg, dif_pos w.2, Subtype.coe_eta]
        rw [h1]
        cases h : η w <;> simp
      rw [hm, hd]
    · refine Finset.prod_congr rfl (fun p _ => ?_)
      have hnr : ¬ (p : NumberField.InfinitePlace K).IsReal := by
        rw [NumberField.InfinitePlace.not_isReal_iff_isComplex]; exact p.2
      have hm : (((p : NumberField.InfinitePlace K).mult : ℕ) : ℝ) = 2 := by
        rw [NumberField.InfinitePlace.mult_isComplex p]; norm_num
      have hd : kaiHZDeg K η l (p : NumberField.InfinitePlace K) = |((l p : ℤ) : ℝ)| := by
        simp only [kaiHZDeg, dif_neg hnr, Subtype.coe_eta]
      rw [hm, hd]
      norm_num
  have hP : (((∏ v : NumberField.InfinitePlace K,
        y v ^ (-((v.mult : ℝ) / 2 + kaiHZDeg K η l v))) : ℝ) : ℂ)
      = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
            ((y (w : NumberField.InfinitePlace K) ^
              (-((1 : ℝ) / 2 + ((if η w then 1 else 0 : ℕ) : ℝ))) : ℝ) : ℂ)) *
        ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
            ((y (p : NumberField.InfinitePlace K) ^
              (-(1 + |((l p : ℤ) : ℝ)|)) : ℝ) : ℂ) := by
    rw [hPreal, Complex.ofReal_mul, Complex.ofReal_prod, Complex.ofReal_prod]
  have hexp : ∀ a t : ℝ, -(Real.pi * (1 / a) * t ^ 2) = -(Real.pi * t ^ 2 / a) := by
    intro a t; ring
  have hs4ξ := hagp (fun w => 1 / y w) ξ
  simp only [hexp, Finset.prod_mul_distrib] at hs4ξ
  have hfinal : κ₀ *
        (((∏ v : NumberField.InfinitePlace K,
            y v ^ (-((v.mult : ℝ) / 2 + kaiHZDeg K η l v))) : ℝ) : ℂ) *
        kaiHZArchWeight K η l ξ *
        ((kaiHZGaussian K (fun w => 1 / y w) ξ : ℝ) : ℂ)
      = (κ₀ *
          (((∏ v : NumberField.InfinitePlace K,
            y v ^ (-((v.mult : ℝ) / 2 + kaiHZDeg K η l v))) : ℝ) : ℂ)) *
        (kaiHZArchWeight K η l ξ *
          ((kaiHZGaussian K (fun w => 1 / y w) ξ : ℝ) : ℂ)) := by
    ring
  rw [hfinal, hκ₀, hP, hs4ξ]
  ring

theorem kai_hz_lattice_gauss_summable (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (η : {w : NumberField.InfinitePlace K // w.IsReal} → Bool)
    (l : {w : NumberField.InfinitePlace K // w.IsComplex} → ℤ)
    (y : NumberField.InfinitePlace K → ℝ) (hy : ∀ w, 0 < y w)
    (ρ : NumberField.mixedEmbedding.mixedSpace K)
    (d : ℕ) (β : Fin d → NumberField.mixedEmbedding.mixedSpace K)
    (hβ : LinearIndependent ℝ β) :
    Summable (fun m : Fin d → ℤ =>
      ‖kaiHZArchWeight K η l (ρ + ∑ i, (m i : ℝ) • β i)‖ *
        kaiHZGaussian K y (ρ + ∑ i, (m i : ℝ) • β i)) :=
by
  classical
  obtain ⟨D, hD⟩ : ∃ D : ℕ,
      D = (∑ w : {w : NumberField.InfinitePlace K // w.IsReal}, (if η w then 1 else 0))
          + ∑ p : {w : NumberField.InfinitePlace K // w.IsComplex}, (l p).natAbs := ⟨_, rfl⟩
  have hs1 : ∀ x : NumberField.mixedEmbedding.mixedSpace K,
      ‖kaiHZArchWeight K η l x‖ ≤ ‖x‖ ^ D := by
    intro x
    have hx0 : (0 : ℝ) ≤ ‖x‖ := norm_nonneg x
    have hreal : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        ‖(if η w then ((x.1 w : ℝ) : ℂ) else 1)‖ ≤ ‖x‖ ^ (if η w then 1 else 0) := by
      intro w
      by_cases h : η w = true
      · rw [if_pos h, if_pos h, Complex.norm_real, pow_one]
        exact le_trans (norm_le_pi_norm x.1 w) (norm_fst_le x)
      · rw [if_neg h, if_neg h, norm_one, pow_zero]
    have hcplx : ∀ p : {w : NumberField.InfinitePlace K // w.IsComplex},
        ‖kaiHZCplxWeight (l p) (x.2 p)‖ ≤ ‖x‖ ^ (l p).natAbs := by
      intro p
      have hz : ‖x.2 p‖ ≤ ‖x‖ := le_trans (norm_le_pi_norm x.2 p) (norm_snd_le x)
      have heq : ‖kaiHZCplxWeight (l p) (x.2 p)‖ = ‖x.2 p‖ ^ (l p).natAbs := by
        simp only [kaiHZCplxWeight]
        by_cases h : 0 ≤ l p
        · rw [if_pos h, norm_pow]
          congr 1
          omega
        · rw [if_neg h, norm_pow, RCLike.norm_conj]
          congr 1
          omega
      rw [heq]
      exact pow_le_pow_left₀ (norm_nonneg _) hz _
    calc ‖kaiHZArchWeight K η l x‖
        = (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              ‖(if η w then ((x.1 w : ℝ) : ℂ) else 1)‖) *
            ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ‖kaiHZCplxWeight (l p) (x.2 p)‖ := by
          simp only [kaiHZArchWeight, norm_mul, norm_prod]
      _ ≤ (∏ w : {w : NumberField.InfinitePlace K // w.IsReal},
              ‖x‖ ^ (if η w then 1 else 0)) *
            ∏ p : {w : NumberField.InfinitePlace K // w.IsComplex},
              ‖x‖ ^ (l p).natAbs := by
          refine mul_le_mul
            (Finset.prod_le_prod (fun i _ => norm_nonneg _) (fun i _ => hreal i))
            (Finset.prod_le_prod (fun i _ => norm_nonneg _) (fun i _ => hcplx i))
            (Finset.prod_nonneg (fun i _ => norm_nonneg _))
            (Finset.prod_nonneg (fun i _ => pow_nonneg hx0 _))
      _ = ‖x‖ ^ D := by
          rw [Finset.prod_pow_eq_pow_sum, Finset.prod_pow_eq_pow_sum, ← pow_add, hD]
  obtain ⟨w₁, -, hw₁⟩ := Finset.exists_min_image
    (Finset.univ : Finset (NumberField.InfinitePlace K)) y Finset.univ_nonempty
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = Real.pi * y w₁ := ⟨_, rfl⟩
  have ha0 : 0 < a := by rw [ha]; exact mul_pos Real.pi_pos (hy w₁)
  have hs2 : ∀ x : NumberField.mixedEmbedding.mixedSpace K,
      kaiHZGaussian K y x ≤ Real.exp (-(a * ‖x‖ ^ 2)) := by
    intro x
    obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = ∑ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w x ^ 2 := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := by
      rw [hSdef]; exact Finset.sum_nonneg (fun w _ => sq_nonneg _)
    have hle : ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w x ≤ Real.sqrt S := by
      intro w
      have h1 : NumberField.mixedEmbedding.normAtPlace w x ^ 2 ≤ S := by
        rw [hSdef]
        exact Finset.single_le_sum
          (f := fun w : NumberField.InfinitePlace K =>
            NumberField.mixedEmbedding.normAtPlace w x ^ 2)
          (fun i _ => sq_nonneg _) (Finset.mem_univ w)
      have h2 := Real.sqrt_le_sqrt h1
      rwa [Real.sqrt_sq (NumberField.mixedEmbedding.normAtPlace_nonneg w x)] at h2
    have hx1 : ‖x.1‖ ≤ Real.sqrt S := by
      rw [pi_norm_le_iff_of_nonneg (Real.sqrt_nonneg S)]
      intro i
      have h3 := hle (i : NumberField.InfinitePlace K)
      rwa [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal i.2 x,
        Subtype.coe_eta] at h3
    have hx2 : ‖x.2‖ ≤ Real.sqrt S := by
      rw [pi_norm_le_iff_of_nonneg (Real.sqrt_nonneg S)]
      intro i
      have h3 := hle (i : NumberField.InfinitePlace K)
      rwa [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex i.2 x,
        Subtype.coe_eta] at h3
    have hxn : ‖x‖ ≤ Real.sqrt S := by
      rw [Prod.norm_def]; exact max_le hx1 hx2
    have hsq : ‖x‖ ^ 2 ≤ S := by
      have h4 := pow_le_pow_left₀ (norm_nonneg x) hxn 2
      rwa [Real.sq_sqrt hS0] at h4
    have hbig : a * ‖x‖ ^ 2 ≤ Real.pi * ∑ w : NumberField.InfinitePlace K,
        y w * NumberField.mixedEmbedding.normAtPlace w x ^ 2 := by
      have h1 : y w₁ * S ≤ ∑ w : NumberField.InfinitePlace K,
          y w * NumberField.mixedEmbedding.normAtPlace w x ^ 2 := by
        rw [hSdef, Finset.mul_sum]
        exact Finset.sum_le_sum (fun w _ =>
          mul_le_mul_of_nonneg_right (hw₁ w (Finset.mem_univ w)) (sq_nonneg _))
      have h2 : y w₁ * ‖x‖ ^ 2 ≤ y w₁ * S :=
        mul_le_mul_of_nonneg_left hsq (hy w₁).le
      calc a * ‖x‖ ^ 2 = Real.pi * (y w₁ * ‖x‖ ^ 2) := by rw [ha]; ring
        _ ≤ Real.pi * (y w₁ * S) := mul_le_mul_of_nonneg_left h2 Real.pi_pos.le
        _ ≤ Real.pi * ∑ w : NumberField.InfinitePlace K,
              y w * NumberField.mixedEmbedding.normAtPlace w x ^ 2 :=
            mul_le_mul_of_nonneg_left h1 Real.pi_pos.le
    simp only [kaiHZGaussian]
    exact Real.exp_le_exp.mpr (by linarith)
  have hpoly : ∀ b : ℝ, 0 < b → ∀ n : ℕ, ∃ Cb : ℝ, 0 ≤ Cb ∧
      ∀ t : ℝ, 0 ≤ t → t ^ n * Real.exp (-(b * t ^ 2)) ≤ Cb := by
    intro b hb n
    obtain ⟨M, hM⟩ : ∃ M : ℕ, M = n + 1 := ⟨_, rfl⟩
    have hM1 : 1 ≤ M := by omega
    have hMR : (0 : ℝ) < (M : ℝ) := by exact_mod_cast hM1
    have hMne : (M : ℝ) ≠ 0 := ne_of_gt hMR
    have hbne : b ≠ 0 := ne_of_gt hb
    refine ⟨Real.exp (2 * b) * ((M : ℝ) / b) ^ M,
      mul_nonneg (Real.exp_nonneg _) (pow_nonneg (div_nonneg hMR.le hb.le) _), ?_⟩
    intro t ht
    have h1t : (1 : ℝ) ≤ 1 + t := by linarith
    have h0t : (0 : ℝ) < 1 + t := by linarith
    have hstep1 : t ^ n ≤ (1 + t) ^ M := by
      calc t ^ n ≤ (1 + t) ^ n := pow_le_pow_left₀ ht (by linarith) n
        _ ≤ (1 + t) ^ M := pow_le_pow_right₀ h1t (by omega)
    have hstep2 : Real.exp (-(b * t ^ 2))
        ≤ Real.exp (2 * b) * Real.exp (-(b * (1 + t))) := by
      rw [← Real.exp_add]
      refine Real.exp_le_exp.mpr ?_
      have hq : (0 : ℝ) ≤ t ^ 2 - t + 1 := by nlinarith [sq_nonneg (t - 1 / 2)]
      nlinarith [mul_nonneg hb.le hq]
    have hstep3 : (1 + t) ^ M * Real.exp (-(b * (1 + t))) ≤ ((M : ℝ) / b) ^ M := by
      have h6 : (0 : ℝ) ≤ b * (1 + t) / (M : ℝ) :=
        div_nonneg (mul_nonneg hb.le h0t.le) hMR.le
      have h5 : b * (1 + t) / (M : ℝ) + 1 ≤ Real.exp (b * (1 + t) / (M : ℝ)) :=
        Real.add_one_le_exp _
      have h7 : (b * (1 + t) / (M : ℝ)) ^ M ≤ (Real.exp (b * (1 + t) / (M : ℝ))) ^ M :=
        pow_le_pow_left₀ h6 (by linarith) M
      have h10 : (Real.exp (b * (1 + t) / (M : ℝ))) ^ M = Real.exp (b * (1 + t)) := by
        rw [← Real.exp_nat_mul]
        congr 1
        field_simp
      rw [h10] at h7
      have hMa : ((M : ℝ) / b) * (b * (1 + t) / (M : ℝ)) = 1 + t := by field_simp
      have h8 : (1 + t) ^ M = ((M : ℝ) / b) ^ M * (b * (1 + t) / (M : ℝ)) ^ M := by
        rw [← mul_pow, hMa]
      have h9 : (1 + t) ^ M ≤ ((M : ℝ) / b) ^ M * Real.exp (b * (1 + t)) := by
        rw [h8]
        exact mul_le_mul_of_nonneg_left h7 (pow_nonneg (div_nonneg hMR.le hb.le) _)
      rw [Real.exp_neg, ← div_eq_mul_inv, div_le_iff₀ (Real.exp_pos _)]
      exact h9
    calc t ^ n * Real.exp (-(b * t ^ 2))
        ≤ (1 + t) ^ M * (Real.exp (2 * b) * Real.exp (-(b * (1 + t)))) :=
          mul_le_mul hstep1 hstep2 (Real.exp_nonneg _) (pow_nonneg h0t.le _)
      _ = Real.exp (2 * b) * ((1 + t) ^ M * Real.exp (-(b * (1 + t)))) := by ring
      _ ≤ Real.exp (2 * b) * ((M : ℝ) / b) ^ M :=
          mul_le_mul_of_nonneg_left hstep3 (Real.exp_nonneg _)
  obtain ⟨C₁, hC₁0, hC₁⟩ := hpoly (a / 2) (by linarith) D
  have hcomb : ∀ x : NumberField.mixedEmbedding.mixedSpace K,
      ‖kaiHZArchWeight K η l x‖ * kaiHZGaussian K y x
        ≤ C₁ * Real.exp (-(a / 2 * ‖x‖ ^ 2)) := by
    intro x
    have hab : ‖kaiHZArchWeight K η l x‖ * kaiHZGaussian K y x
        ≤ ‖x‖ ^ D * Real.exp (-(a * ‖x‖ ^ 2)) := by
      refine mul_le_mul (hs1 x) (hs2 x) ?_ (pow_nonneg (norm_nonneg _) _)
      simp only [kaiHZGaussian]
      exact Real.exp_nonneg _
    refine hab.trans ?_
    have hsplit : Real.exp (-(a * ‖x‖ ^ 2))
        = Real.exp (-(a / 2 * ‖x‖ ^ 2)) * Real.exp (-(a / 2 * ‖x‖ ^ 2)) := by
      rw [← Real.exp_add]; congr 1; ring
    rw [hsplit, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (hC₁ ‖x‖ (norm_nonneg x)) (Real.exp_nonneg _)
  obtain ⟨κ, hκ0, hκ⟩ : ∃ κ : ℝ, 0 < κ ∧ ∀ t : Fin d → ℝ,
      κ * ‖(WithLp.toLp 2 t : EuclideanSpace ℝ (Fin d))‖ ≤ ‖∑ i, t i • β i‖ := by
    obtain ⟨v, hvapp⟩ : ∃ v : EuclideanSpace ℝ (Fin d) →ₗ[ℝ]
        NumberField.mixedEmbedding.mixedSpace K,
        ∀ u : EuclideanSpace ℝ (Fin d), v u = ∑ i, (WithLp.ofLp u) i • β i := by
      refine ⟨(Fintype.linearCombination ℝ β).comp
        (WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).toLinearMap, ?_⟩
      intro u
      simp [Fintype.linearCombination_apply]
    have hker : LinearMap.ker v = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro u hu
      rw [hvapp] at hu
      have h2 := Fintype.linearIndependent_iff.mp hβ _ hu
      have h3 : WithLp.ofLp u = 0 := funext h2
      have h4 : WithLp.toLp 2 (WithLp.ofLp u) = WithLp.toLp 2 (0 : Fin d → ℝ) :=
        congrArg _ h3
      simpa using h4
    obtain ⟨Kc, hKc, hanti⟩ := LinearMap.exists_antilipschitzWith v hker
    have hKc0 : (0 : ℝ) < (Kc : ℝ) := hKc
    refine ⟨(Kc : ℝ)⁻¹, by positivity, ?_⟩
    intro t
    have h := hanti.le_mul_norm_sub (WithLp.toLp 2 t) 0
    simp only [sub_zero, map_zero] at h
    rw [hvapp, WithLp.ofLp_toLp] at h
    rw [inv_mul_le_iff₀ hKc0]
    exact h
  obtain ⟨b, hbdef⟩ : ∃ b : ℝ, b = a * κ ^ 2 / 4 := ⟨_, rfl⟩
  have hb0 : 0 < b := by
    rw [hbdef]
    exact div_pos (mul_pos ha0 (pow_pos hκ0 2)) (by norm_num)
  obtain ⟨C₂, hC₂def⟩ : ∃ C : ℝ, C = C₁ * Real.exp (a / 2 * ‖ρ‖ ^ 2) := ⟨_, rfl⟩
  have hC₂0 : 0 ≤ C₂ := by
    rw [hC₂def]; exact mul_nonneg hC₁0 (Real.exp_nonneg _)
  have habs : ∀ T S : ℝ, 0 ≤ T → 0 ≤ S → κ * S ≤ T + ‖ρ‖ →
      C₁ * Real.exp (-(a / 2 * T ^ 2)) ≤ C₂ * Real.exp (-(b * S ^ 2)) := by
    intro T S hT hS hcoer
    have hR0 : (0 : ℝ) ≤ ‖ρ‖ := norm_nonneg ρ
    have h1 : (κ * S) ^ 2 ≤ (T + ‖ρ‖) ^ 2 :=
      pow_le_pow_left₀ (mul_nonneg hκ0.le hS) hcoer 2
    have h2 : (T + ‖ρ‖) ^ 2 ≤ 2 * T ^ 2 + 2 * ‖ρ‖ ^ 2 := by
      nlinarith [sq_nonneg (T - ‖ρ‖)]
    have h3 : (0 : ℝ) ≤ 2 * T ^ 2 + 2 * ‖ρ‖ ^ 2 - (κ * S) ^ 2 := by linarith
    have h4 : (0 : ℝ) ≤ a * (2 * T ^ 2 + 2 * ‖ρ‖ ^ 2 - (κ * S) ^ 2) :=
      mul_nonneg ha0.le h3
    have hkey : -(a / 2 * T ^ 2) ≤ a / 2 * ‖ρ‖ ^ 2 + -(b * S ^ 2) := by
      rw [hbdef]; nlinarith [h4]
    calc C₁ * Real.exp (-(a / 2 * T ^ 2))
        ≤ C₁ * (Real.exp (a / 2 * ‖ρ‖ ^ 2) * Real.exp (-(b * S ^ 2))) := by
          refine mul_le_mul_of_nonneg_left ?_ hC₁0
          rw [← Real.exp_add]
          exact Real.exp_le_exp.mpr hkey
      _ = C₂ * Real.exp (-(b * S ^ 2)) := by rw [hC₂def]; ring
  have hgz : Summable (fun j : ℤ => Real.exp (-(b * (j : ℝ) ^ 2))) := by
    have hr1 : Real.exp (-b) < 1 := by rw [Real.exp_lt_one_iff]; linarith
    have hgeo : Summable (fun n : ℕ => (Real.exp (-b)) ^ n) :=
      summable_geometric_of_lt_one (Real.exp_nonneg _) hr1
    have hnat : Summable (fun n : ℕ => Real.exp (-(b * (n : ℝ) ^ 2))) := by
      refine Summable.of_nonneg_of_le (fun n => Real.exp_nonneg _) (fun n => ?_) hgeo
      rw [← Real.exp_nat_mul]
      refine Real.exp_le_exp.mpr ?_
      have h1 : n ≤ n ^ 2 := Nat.le_self_pow (by norm_num) n
      have hn : (n : ℝ) ≤ ((n : ℝ)) ^ 2 := by exact_mod_cast h1
      nlinarith
    refine Summable.of_nat_of_neg ?_ ?_
    · simpa using hnat
    · simpa using hnat
  have hprodsum : ∀ n : ℕ, Summable (fun m : Fin n → ℤ =>
      ∏ i, Real.exp (-(b * ((m i : ℤ) : ℝ) ^ 2))) := by
    intro n
    induction n with
    | zero => exact Summable.of_finite
    | succ n ih =>
      have hmul : Summable (fun p : ℤ × (Fin n → ℤ) =>
          Real.exp (-(b * ((p.1 : ℤ) : ℝ) ^ 2)) *
            ∏ i, Real.exp (-(b * ((p.2 i : ℤ) : ℝ) ^ 2))) :=
        hgz.mul_of_nonneg ih (fun j => Real.exp_nonneg _)
          (fun m => Finset.prod_nonneg (fun i _ => Real.exp_nonneg _))
      have hcong : (fun m : Fin (n + 1) → ℤ => ∏ i, Real.exp (-(b * ((m i : ℤ) : ℝ) ^ 2)))
          = (fun p : ℤ × (Fin n → ℤ) =>
              Real.exp (-(b * ((p.1 : ℤ) : ℝ) ^ 2)) *
                ∏ i, Real.exp (-(b * ((p.2 i : ℤ) : ℝ) ^ 2))) ∘
              ((Fin.consEquiv (fun _ : Fin (n + 1) => ℤ)).symm) := by
        funext m
        simp [Fin.prod_univ_succ, Fin.consEquiv, Fin.tail]
      rw [hcong]
      exact (Equiv.summable_iff _).mpr hmul
  have hfnn : ∀ m : Fin d → ℤ,
      (0 : ℝ) ≤ ‖kaiHZArchWeight K η l (ρ + ∑ i, (m i : ℝ) • β i)‖ *
        kaiHZGaussian K y (ρ + ∑ i, (m i : ℝ) • β i) := by
    intro m
    refine mul_nonneg (norm_nonneg _) ?_
    simp only [kaiHZGaussian]
    exact Real.exp_nonneg _
  have hmain : ∀ m : Fin d → ℤ,
      ‖kaiHZArchWeight K η l (ρ + ∑ i, (m i : ℝ) • β i)‖ *
          kaiHZGaussian K y (ρ + ∑ i, (m i : ℝ) • β i)
        ≤ C₂ * ∏ i, Real.exp (-(b * ((m i : ℤ) : ℝ) ^ 2)) := by
    intro m
    have hS2 : ‖(WithLp.toLp 2 (fun i => ((m i : ℤ) : ℝ)) :
          EuclideanSpace ℝ (Fin d))‖ ^ 2 = ∑ i, ((m i : ℤ) : ℝ) ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
      simp [Real.norm_eq_abs, sq_abs]
    have hcoer : κ * ‖(WithLp.toLp 2 (fun i => ((m i : ℤ) : ℝ)) :
          EuclideanSpace ℝ (Fin d))‖ ≤ ‖ρ + ∑ i, (m i : ℝ) • β i‖ + ‖ρ‖ := by
      refine le_trans (hκ (fun i => ((m i : ℤ) : ℝ))) ?_
      have heq : (∑ i, ((m i : ℤ) : ℝ) • β i)
          = (ρ + ∑ i, ((m i : ℤ) : ℝ) • β i) - ρ := by abel
      calc ‖∑ i, ((m i : ℤ) : ℝ) • β i‖
          = ‖(ρ + ∑ i, ((m i : ℤ) : ℝ) • β i) - ρ‖ := by rw [← heq]
        _ ≤ ‖ρ + ∑ i, ((m i : ℤ) : ℝ) • β i‖ + ‖ρ‖ := norm_sub_le _ _
    have hprodeq : (∏ i, Real.exp (-(b * ((m i : ℤ) : ℝ) ^ 2)))
        = Real.exp (-(b * ‖(WithLp.toLp 2 (fun i => ((m i : ℤ) : ℝ)) :
            EuclideanSpace ℝ (Fin d))‖ ^ 2)) := by
      rw [← Real.exp_sum, hS2]
      congr 1
      rw [Finset.mul_sum, Finset.sum_neg_distrib]
    rw [hprodeq]
    exact le_trans (hcomb _)
      (habs _ _ (norm_nonneg _) (norm_nonneg _) hcoer)
  exact Summable.of_nonneg_of_le hfnn hmain ((hprodsum d).mul_left C₂)

theorem kai_hz_theta_transformation (K : Type u) [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (hP : KaiHZPoissonProp) (hF : KaiHZTestFourierProp) : KaiHZIdealThetaProp K :=
by
  classical
  obtain ⟨Φ, hinner, hmeas, hdet⟩ := kai_hz_mixed_euclid_coords K
  obtain ⟨c₀, cK, hc₀, hcK, hdata⟩ := kai_hz_ideal_lattice_data K
  have hU : KaiHZTestFourierUnifProp := kai_hz_test_fourier_unif hF
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = max (max 4 (1 / c₀)) (max cK (1 / cK)) := ⟨_, rfl⟩
  have hB4 : (4 : ℝ) ≤ B := by
    rw [hBdef]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hBc₀ : 1 / c₀ ≤ B := by
    rw [hBdef]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hBcK : cK ≤ B := by
    rw [hBdef]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hBcK' : 1 / cK ≤ B := by
    rw [hBdef]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hB1 : (1 : ℝ) ≤ B := by linarith
  have hB0 : (0 : ℝ) < B := by linarith
  refine ⟨B, hB1, ?_⟩
  intro a ha ρ η l
  obtain ⟨μ, ν, b, βa, ea, eb, hβa, hbio, hνind, hea, heb, hcov, hbn⟩ := hdata a ha
  have hab : a ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
  have hNne : Ideal.absNorm a ≠ 0 := fun h => hab (Ideal.absNorm_eq_zero_iff.mp h)
  have hN1 : (1 : ℝ) ≤ (Ideal.absNorm a : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hNne
  have hN0 : (0 : ℝ) < (Ideal.absNorm a : ℝ) := by linarith
  have hNB1 : (1 : ℝ) ≤ (Ideal.absNorm a : ℝ) ^ B := by
    calc (1 : ℝ) = (1 : ℝ) ^ B := (Real.one_rpow B).symm
      _ ≤ (Ideal.absNorm a : ℝ) ^ B := Real.rpow_le_rpow (by norm_num) hN1 (by linarith)
  have hNBN : (Ideal.absNorm a : ℝ) ≤ (Ideal.absNorm a : ℝ) ^ B := by
    calc (Ideal.absNorm a : ℝ) = (Ideal.absNorm a : ℝ) ^ (1 : ℝ) := (Real.rpow_one _).symm
      _ ≤ (Ideal.absNorm a : ℝ) ^ B := Real.rpow_le_rpow_of_exponent_le hN1 hB1
  have hμeq : (fun i => NumberField.mixedEmbedding K (μ i)) = ⇑βa :=
    funext fun i => (hβa i).symm
  have hμind : LinearIndependent ℝ (fun i => NumberField.mixedEmbedding K (μ i)) := by
