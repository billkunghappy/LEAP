          (Ideal.ramificationIdx_ne_one_iff h_map).mp hQE_ram
        have h_dvd2 :
            Q_E ^ 2 ∣ Ideal.map
              (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) p₀.asIdeal :=
          Ideal.dvd_iff_le.mpr h_le2
        have h_dvdD : Q_E ∣ D_EF := by
          simpa using pow_sub_one_dvd_differentIdeal (NumberField.RingOfIntegers F) Q_E 2 p₀.ne_bot h_dvd2
        have h_rel_dvd : Ideal.relNorm (NumberField.RingOfIntegers F) Q_E ∣ N_EF :=
          map_dvd (Ideal.relNorm (NumberField.RingOfIntegers F)) h_dvdD
        have h_rel_eq :
            Ideal.relNorm (NumberField.RingOfIntegers F) Q_E =
              p₀.asIdeal ^ (p₀.asIdeal.inertiaDeg Q_E) :=
          Ideal.relNorm_eq_pow_of_isMaximal Q_E p₀.asIdeal
        rw [h_rel_eq] at h_rel_dvd
        have h_f_ne : p₀.asIdeal.inertiaDeg Q_E ≠ 0 := (Ideal.inertiaDeg_pos p₀.asIdeal Q_E).ne'
        have hp₀_dvd_NEF : p₀.asIdeal ∣ N_EF :=
          dvd_trans (dvd_pow_self p₀.asIdeal h_f_ne) h_rel_dvd
        have hI₂_le_map :
            I₂ ≤ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L)) p₀.asIdeal :=
          Ideal.map_mono (Ideal.dvd_iff_le.mp hp₀_dvd_NEF)
        have h_map_le_P :
            Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L)) p₀.asIdeal ≤ P.asIdeal :=
          Ideal.map_le_iff_le_comap.mpr rfl.le
        exact hP_not_I₂ (Ideal.dvd_iff_le.mpr (hI₂_le_map.trans h_map_le_P))
      have hp₀_m : (m : NumberField.RingOfIntegers F) ∉ p₀.asIdeal := by
        intro hm_in
        have hm_P : (m : NumberField.RingOfIntegers L) ∈ P.asIdeal := by
          rw [← map_natCast (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L))]
