          _ = (x P) ^ ((2 : ℕ) : ℝ) := by rw [Real.rpow_natCast]
          _ = (Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ ((-s) * ((2 : ℕ) : ℝ)) := by
              rw [← Real.rpow_mul h_0]
          _ ≤ y P := Real.rpow_le_rpow_of_exponent_le h_1 (by push_cast; linarith)
    have hz_norm : ∀ P : ι, ‖z P‖ ≤ x P := by
      intro P
      dsimp [z]
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hx_bounds P).1]
      exact mul_le_of_le_one_left (hx_bounds P).1 (hϕ_norm P.asIdeal)
    have hSum_z : Summable z := hPrime_s.of_norm_bounded hz_norm
    have hSum_log : Summable (fun P : ι => -Complex.log (1 - z P)) := hSum_z.clog_one_sub.neg
    have h_pt : ∀ P : ι, ‖z P - (-Complex.log (1 - z P))‖ ≤ y P := by
      intro P
      have hz_half : ‖z P‖ ≤ 1 / 2 := (hz_norm P).trans (hx_bounds P).2.1
      have h_neg_z_lt : ‖-z P‖ < 1 := by
        rw [norm_neg]
        linarith
      have h_log := Complex.norm_log_one_add_sub_self_le h_neg_z_lt
      rw [norm_neg] at h_log
      have h_eq : z P - (-Complex.log (1 - z P)) = Complex.log (1 + -z P) - -z P := by
        rw [sub_eq_add_neg (1 : ℂ) (z P)]
        ring
      rw [h_eq]
      have h1mz : 1 / 2 ≤ 1 - ‖z P‖ := by linarith
      have h1mz_pos : 0 < 1 - ‖z P‖ := by linarith
      have h_inv_le : (1 - ‖z P‖)⁻¹ ≤ 2 := by
        rw [inv_le_comm₀ h1mz_pos (by norm_num)]
        linarith
      have h_sq_le : ‖z P‖ ^ 2 ≤ (x P) ^ 2 := by
        nlinarith [norm_nonneg (z P), hz_norm P]
      have h_mid : ‖z P‖ ^ 2 * (1 - ‖z P‖)⁻¹ / 2 ≤ (x P) ^ 2 := by
        have h_mul := mul_le_mul_of_nonneg_left h_inv_le (sq_nonneg ‖z P‖)
        linarith
      exact (h_log.trans h_mid).trans (hx_bounds P).2.2
    have hSum_diff : Summable (fun P : ι => z P - (-Complex.log (1 - z P))) := hSum_z.sub hSum_log
    have h_norm_tsum : ‖∑' P : ι, (z P - (-Complex.log (1 - z P)))‖ ≤ ∑' P : ι, y P :=
      (norm_tsum_le_tsum_norm hSum_diff.norm).trans
        (Summable.tsum_le_tsum h_pt hSum_diff.norm hPrime_2)
    have h_re_le : (∑' P : ι, (z P - (-Complex.log (1 - z P)))).re ≤ ∑' P : ι, y P :=
      (Complex.re_le_norm _).trans h_norm_tsum
    rw [Summable.tsum_sub hSum_z hSum_log, Complex.sub_re] at h_re_le
    exact ⟨hSum_z, by linarith⟩
  
  have h_top_cop : IsCoprime (⊤ : Ideal R_K) 𝔪 :=
    Ideal.isCoprime_iff_sup_eq.mpr (sup_eq_left.mpr le_top)
  obtain ⟨j₀, _⟩ := hJ_cov ⊤ top_ne_bot h_top_cop
  have h_finrank_pos : 0 < Module.finrank ℚ K := Module.finrank_pos
  have h_one_le : (1 : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.one_le_cast.mpr h_finrank_pos
  have h_pos_real : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by linarith
  have h_div_pos : (0 : ℝ) < 1 / (Module.finrank ℚ K : ℝ) := one_div_pos.mpr h_pos_real
  have h_div_le_one : 1 / (Module.finrank ℚ K : ℝ) ≤ 1 := div_le_one_of_le₀ h_one_le h_pos_real.le
  let r : ℝ := 1 - 1 / (Module.finrank ℚ K : ℝ)
  have hr_nonneg : 0 ≤ r := by dsimp [r]; linarith
  have hr_lt_one : r < 1 := by dsimp [r]; linarith
  have h_diff_bigO : ∀ j : Fin N_ray,
      (fun n : ℕ => (PrinCount j n : ℝ) - (PrinCount j₀ n : ℝ)) =O[Filter.atTop]
        (fun n : ℕ => (n : ℝ) ^ r) :=
    fun j => principal_ray_dvd_natCard_sub_isBigO 𝔪 (J_all j) (J_all j₀) h𝔪_ne
      (hJ_prop j).1 (hJ_prop j).2 (hJ_prop j₀).1 (hJ_prop j₀).2
  have h_sum_bigO :
      (fun n : ℕ =>
        ∑ j : Fin N_ray, (ϕ (J_all j))⁻¹ * Complex.ofRealCLM ((PrinCount j n : ℝ) - (PrinCount j₀ n : ℝ))) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ r) := by
    refine Asymptotics.IsBigO.sum fun j _ => ?_
    exact ((Complex.ofRealCLM.isBigO_comp
      (fun n : ℕ => (PrinCount j n : ℝ) - (PrinCount j₀ n : ℝ)) Filter.atTop).trans (h_diff_bigO j)).const_mul_left
      (ϕ (J_all j))⁻¹
  have hBigO : ∃ r' : ℝ, 0 ≤ r' ∧ r' < 1 ∧
      (fun n : ℕ =>
        ∑ k ∈ Finset.Icc 1 n,
          (∑' f : { f : ι →₀ ℕ // N_prod f = k }, A f.val)) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ r') := by
    refine ⟨r, hr_nonneg, hr_lt_one, h_sum_bigO.congr_left fun n => ?_⟩
    have h_pt : ∀ j : Fin N_ray,
        (ϕ (J_all j))⁻¹ * Complex.ofRealCLM ((PrinCount j n : ℝ) - (PrinCount j₀ n : ℝ)) =
          (ϕ (J_all j))⁻¹ * (PrinCount j n : ℂ) - (ϕ (J_all j))⁻¹ * (PrinCount j₀ n : ℂ) := by
      intro j
      rw [map_sub, Complex.ofRealCLM_apply, Complex.ofRealCLM_apply,
        Complex.ofReal_natCast, Complex.ofReal_natCast, mul_sub]
    simp_rw [h_pt]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hϕ_sum, zero_mul, sub_zero, ← h_s1 n]
  let α : ι → ℂ := fun P => ϕ P.asIdeal
  have hα_norm : ∀ P : ι, ‖α P‖ ≤ 1 := fun P => hϕ_norm P.asIdeal
  obtain ⟨w, hw_L⟩ :=
    exists_tendsto_lSeries_of_sum_isBigO_rpow_lt_one
      (fun n : ℕ =>
        ∑' f : { f : ι →₀ ℕ //
            f.prod (fun P k => (Nat.card (R_K ⧸ P.asIdeal)) ^ k) = n },
          f.val.prod (fun P k => (α P) ^ k))
      (fun s hs => (tsum_finsupp_prod_eq_lSeries_and_summable α hα_norm hs).1)
      hBigO
  have hIdeal_2 := (dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := K) one_lt_two).1
  have hPrime_2 := (tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_2).1
  have hw : Filter.Tendsto
      (fun s : ℝ =>
        Complex.exp
          (∑' P : ι,
            -Complex.log (1 - α P * (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds w) := by
    refine hw_L.congr' (eventually_nhdsWithin_of_forall fun s hs => ?_)
    dsimp only
    have hs1 : 1 < s := hs
    have hIdeal_s := (dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := K) hs1).1
    obtain ⟨hPrime_s, hProd_s, _⟩ := tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_s
    obtain ⟨hBounds_s, hSumLog_s, _, _⟩ :=
      prime_rpow_neg_log_sub_tsum_bounds hs1 hPrime_s hPrime_2
    have hNorm_s : ∀ P : ι,
        ‖α P * (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)‖ ≤
          ((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s)) := by
      intro P
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hBounds_s P).1]
      exact mul_le_of_le_one_left (hBounds_s P).1 (hα_norm P)
    have hEuler :=
      tsum_finsupp_prod_pow_eq_cexp_tsum_neg_clog_one_sub
        (fun P : ι =>
          α P * (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ))
        (fun P : ι =>
          ((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s)))
        hNorm_s
        (fun P => (hBounds_s P).2)
        hSumLog_s
        hProd_s
    rw [← hEuler, (tsum_finsupp_prod_eq_lSeries_and_summable α hα_norm hs1).2]
  refine ⟨‖w‖ + ∑' P : ι, ((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-2 : ℝ)), ?_⟩
  have h_w_lt_exp : ‖w‖ < Real.exp ‖w‖ := by
    linarith [Real.add_one_le_exp ‖w‖]
  have h_norm_tendsto : Filter.Tendsto
      (fun s : ℝ =>
        ‖Complex.exp
          (∑' P : ι,
            -Complex.log (1 - α P * (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))‖)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds ‖w‖) :=
    (continuous_norm.tendsto w).comp hw
  have h_ev_lt : ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
      ‖Complex.exp
        (∑' P : ι,
          -Complex.log (1 - α P * (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))‖ <
      Real.exp ‖w‖ :=
    h_norm_tendsto.eventually (Iio_mem_nhds h_w_lt_exp)
  filter_upwards [self_mem_nhdsWithin, h_ev_lt] with s hs_gt hs_lt
  have hs1 : 1 < s := hs_gt
  have hIdeal_s := (dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := K) hs1).1
  have hPrime_s := (tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_s).1
  obtain ⟨hSum_P, hRe_P⟩ := h_s5 hs1 hPrime_s hPrime_2
  rw [Complex.norm_exp] at hs_lt
  have hRe_log_lt :
      (∑' P : ι,
        -Complex.log (1 - α P * (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ))).re <
      ‖w‖ :=
    Real.exp_lt_exp.mp hs_lt
  exact ⟨hSum_P, by linarith⟩

theorem prime_sum_le_finrank_mul_coprime_artin_ker_prime_sum_add {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (θ : Ideal (NumberField.RingOfIntegers K) → (L ≃ₐ[K] L))
    (hθ_relNorm : ∀ B : Ideal (NumberField.RingOfIntegers L),
      B ≠ ⊥ → θ (Ideal.relNorm (NumberField.RingOfIntegers K) B) = 1)
    (𝔪 : Ideal (NumberField.RingOfIntegers K))
    (h𝔪_ne : 𝔪 ≠ ⊥) :
    ∃ C₀ : ℝ, ∀ s ∈ Set.Ioo (1 : ℝ) 2,
      (∑' Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
        ((Nat.card (NumberField.RingOfIntegers L ⧸ Q.asIdeal) : ℝ) ^ (-s))) ≤
      (Module.finrank K L : ℝ) *
        (∑' P : { P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsCoprime P.asIdeal 𝔪 ∧ θ P.asIdeal = 1 },
          ((Nat.card (NumberField.RingOfIntegers K ⧸ P.1.asIdeal) : ℝ) ^ (-s))) + C₀ :=
by
  classical
  have h_summable : ∀ (F : Type u) [Field F] [NumberField F] {t : ℝ}, 1 < t →
      Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
        ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-t))) := by
    intro F _ _ t ht
    let R_F := NumberField.RingOfIntegers F
    let d_F : ℕ := Module.finrank ℚ F
    have hd_F_pos : 0 < d_F := Module.finrank_pos
    let π_Z : IsDedekindDomain.HeightOneSpectrum R_F → IsDedekindDomain.HeightOneSpectrum ℤ :=
      fun q =>
        haveI : q.asIdeal.IsPrime := q.isPrime
        ⟨Ideal.under ℤ q.asIdeal, Ideal.IsPrime.under ℤ q.asIdeal,
          Ideal.under_ne_bot ℤ q.ne_bot⟩
    let ℓ : IsDedekindDomain.HeightOneSpectrum R_F → ℕ :=
      fun q => Ideal.absNorm (π_Z q).asIdeal
    have h_mem_Z : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        q.asIdeal ∈ primesOverFinset (π_Z q).asIdeal R_F := by
      intro q
      letI : (π_Z q).asIdeal.IsMaximal := (π_Z q).isMaximal
      rw [mem_primesOverFinset_iff (π_Z q).ne_bot R_F]
      exact ⟨q.isPrime, ⟨rfl⟩⟩
    have h_card_Z : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        (primesOverFinset (π_Z q).asIdeal R_F).card ≤ d_F := by
      intro q
      letI : (π_Z q).asIdeal.IsMaximal := (π_Z q).isMaximal
      exact Ideal.card_primesOverFinset_le_finrank R_F ℚ F (π_Z q).ne_bot
    let fibIdx : Ideal ℤ → Ideal R_F → ℕ := fun I P =>
      if h : P ∈ primesOverFinset I R_F then ((primesOverFinset I R_F).equivFin ⟨P, h⟩).1 else 0
    have h_fibIdx_lt : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        fibIdx (π_Z q).asIdeal q.asIdeal < d_F := by
      intro q
      dsimp only [fibIdx]
      rw [dif_pos (h_mem_Z q)]
      exact lt_of_lt_of_le
        (((primesOverFinset (π_Z q).asIdeal R_F).equivFin ⟨q.asIdeal, h_mem_Z q⟩).2)
        (h_card_Z q)
    let idx : IsDedekindDomain.HeightOneSpectrum R_F → ℕ :=
      fun q => d_F * ℓ q + fibIdx (π_Z q).asIdeal q.asIdeal
    have h_idx_inj : Function.Injective idx := by
      intro q₁ q₂ h
      dsimp only [idx] at h
      have hi₁ : fibIdx (π_Z q₁).asIdeal q₁.asIdeal < d_F := h_fibIdx_lt q₁
      have hi₂ : fibIdx (π_Z q₂).asIdeal q₂.asIdeal < d_F := h_fibIdx_lt q₂
      have h_ell : ℓ q₁ = ℓ q₂ := by nlinarith
      have h_i_val : fibIdx (π_Z q₁).asIdeal q₁.asIdeal = fibIdx (π_Z q₂).asIdeal q₂.asIdeal := by
        nlinarith
      have h_pZ : (π_Z q₁).asIdeal = (π_Z q₂).asIdeal := by
        rw [← Int.ideal_span_absNorm_eq_self (π_Z q₁).asIdeal,
            ← Int.ideal_span_absNorm_eq_self (π_Z q₂).asIdeal]
        change Ideal.span {(ℓ q₁ : ℤ)} = Ideal.span {(ℓ q₂ : ℤ)}
        rw [h_ell]
      rw [← h_pZ] at h_i_val
      dsimp only [fibIdx] at h_i_val
      have h_mem₂ : q₂.asIdeal ∈ primesOverFinset (π_Z q₁).asIdeal R_F := h_pZ ▸ h_mem_Z q₂
      rw [dif_pos (h_mem_Z q₁), dif_pos h_mem₂] at h_i_val
      have h_fin_eq : ((primesOverFinset (π_Z q₁).asIdeal R_F).equivFin ⟨q₁.asIdeal, h_mem_Z q₁⟩) =
          ((primesOverFinset (π_Z q₁).asIdeal R_F).equivFin ⟨q₂.asIdeal, h_mem₂⟩) :=
        Fin.ext h_i_val
      have h_sub_eq := ((primesOverFinset (π_Z q₁).asIdeal R_F).equivFin).injective h_fin_eq
      apply IsDedekindDomain.HeightOneSpectrum.ext
      exact congrArg Subtype.val h_sub_eq
    have h_idx_bounds : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        0 < idx q ∧ idx q ≤ (2 * d_F + 1) * Nat.card (R_F ⧸ q.asIdeal) := by
      intro q
      have h_card_eq : Nat.card (R_F ⧸ q.asIdeal) = Ideal.absNorm q.asIdeal := by
        rw [← Submodule.cardQuot_apply, ← Ideal.absNorm_apply]
      have h_one_lt : 1 < Ideal.absNorm q.asIdeal :=
        NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
      have h_card_pos : 1 ≤ Nat.card (R_F ⧸ q.asIdeal) := by omega
      have h_dvd : ℓ q ∣ Ideal.absNorm q.asIdeal :=
        Int.absNorm_under_dvd_absNorm q.asIdeal
      have hm_pos : 0 < ℓ q := Nat.pos_of_dvd_of_pos h_dvd (by omega)
      have hm_le : ℓ q ≤ Nat.card (R_F ⧸ q.asIdeal) := by
        rw [h_card_eq]
        exact Nat.le_of_dvd (by omega) h_dvd
      have hi_lt : fibIdx (π_Z q).asIdeal q.asIdeal < d_F := h_fibIdx_lt q
      constructor
      · dsimp only [idx]
        exact Nat.add_pos_left (Nat.mul_pos hd_F_pos hm_pos) _
      · dsimp only [idx]
        have h1 : d_F * ℓ q ≤ d_F * Nat.card (R_F ⧸ q.asIdeal) := Nat.mul_le_mul_left _ hm_le
        have h2 : fibIdx (π_Z q).asIdeal q.asIdeal ≤ d_F * Nat.card (R_F ⧸ q.asIdeal) :=
          calc fibIdx (π_Z q).asIdeal q.asIdeal ≤ d_F := hi_lt.le
            _ = d_F * 1 := (Nat.mul_one _).symm
            _ ≤ d_F * Nat.card (R_F ⧸ q.asIdeal) := Nat.mul_le_mul_left _ h_card_pos
        calc d_F * ℓ q + fibIdx (π_Z q).asIdeal q.asIdeal
            ≤ d_F * Nat.card (R_F ⧸ q.asIdeal) + d_F * Nat.card (R_F ⧸ q.asIdeal) :=
              Nat.add_le_add h1 h2
          _ ≤ (2 * d_F + 1) * Nat.card (R_F ⧸ q.asIdeal) := by
              have : d_F * Nat.card (R_F ⧸ q.asIdeal) + d_F * Nat.card (R_F ⧸ q.asIdeal) =
                  (2 * d_F) * Nat.card (R_F ⧸ q.asIdeal) := by ring
              rw [this]
              exact Nat.mul_le_mul_right _ (by omega)
    let C : ℝ := 2 * (d_F : ℝ) + 1
    have hC_pos : 0 < C := by positivity
    have h_dom : Summable (fun q : IsDedekindDomain.HeightOneSpectrum R_F =>
        (C ^ t) * ((idx q : ℝ) ^ (-t))) := by
      have h_nat : Summable (fun n : ℕ => (n : ℝ) ^ (-t)) :=
        Real.summable_nat_rpow.mpr (by linarith)
      exact (h_nat.mul_left (C ^ t)).comp_injective h_idx_inj
    refine Summable.of_nonneg_of_le (fun q => by positivity) (fun q => ?_) h_dom
    obtain ⟨hk_pos, hk_le⟩ := h_idx_bounds q
    have h_card_pos : 0 < Nat.card (R_F ⧸ q.asIdeal) := by
      by_contra h_zero
      have h0 : Nat.card (R_F ⧸ q.asIdeal) = 0 := by omega
      rw [h0, mul_zero] at hk_le
      omega
    have hk_pos_real : (0 : ℝ) < (idx q : ℝ) := Nat.cast_pos.mpr hk_pos
    have h_card_pos_real : (0 : ℝ) < (Nat.card (R_F ⧸ q.asIdeal) : ℝ) :=
      Nat.cast_pos.mpr h_card_pos
    have hk_le_real : (idx q : ℝ) ≤ C * (Nat.card (R_F ⧸ q.asIdeal) : ℝ) := by
      dsimp only [C]
      exact_mod_cast hk_le
    have h_rpow_le : ((C * (Nat.card (R_F ⧸ q.asIdeal) : ℝ)) ^ (-t)) ≤ (idx q : ℝ) ^ (-t) :=
      Real.rpow_le_rpow_of_nonpos hk_pos_real hk_le_real (by linarith)
    rw [Real.mul_rpow hC_pos.le h_card_pos_real.le] at h_rpow_le
    have h_mul := mul_le_mul_of_nonneg_left h_rpow_le (Real.rpow_pos_of_pos hC_pos t).le
    rw [← mul_assoc, ← Real.rpow_add hC_pos, add_neg_cancel, Real.rpow_zero, one_mul] at h_mul
    exact h_mul
  let R_K := NumberField.RingOfIntegers K
  let R_L := NumberField.RingOfIntegers L
  let ι_K := IsDedekindDomain.HeightOneSpectrum R_K
  let ι_L := IsDedekindDomain.HeightOneSpectrum R_L
  let d : ℕ := Module.finrank K L
  let π : ι_L → ι_K := fun Q =>
    haveI : Q.asIdeal.IsPrime := Q.isPrime
    ⟨Ideal.under R_K Q.asIdeal, Ideal.IsPrime.under R_K Q.asIdeal,
      Ideal.under_ne_bot R_K Q.ne_bot⟩
  letI : NoZeroSMulDivisors R_K R_L := ⟨fun h => smul_eq_zero.mp h⟩
  have hFibCard : ∀ P : ι_K,
      ∃ (_ : Fintype { Q : ι_L // π Q = P }),
        @Fintype.card { Q : ι_L // π Q = P } ‹_› ≤ d := by
    intro P
    haveI : P.asIdeal.IsMaximal := P.isMaximal
    let ψ_P : { Q : ι_L // π Q = P } → primesOverFinset P.asIdeal R_L := fun ⟨Q, hQ⟩ =>
      have h_under : Ideal.under R_K Q.asIdeal = P.asIdeal :=
        congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal hQ
      ⟨Q.asIdeal, (mem_primesOverFinset_iff P.ne_bot R_L).mpr ⟨Q.isPrime, ⟨h_under.symm⟩⟩⟩
    have hψ_P_inj : Function.Injective ψ_P := by
      rintro ⟨Q₁, hQ₁⟩ ⟨Q₂, hQ₂⟩ h
      have h_id : Q₁.asIdeal = Q₂.asIdeal := congrArg Subtype.val h
      exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext h_id)
    haveI : Finite { Q : ι_L // π Q = P } := Finite.of_injective ψ_P hψ_P_inj
    letI : Fintype { Q : ι_L // π Q = P } := Fintype.ofFinite { Q : ι_L // π Q = P }
    refine ⟨inferInstance, ?_⟩
    have h_le₁ : Fintype.card { Q : ι_L // π Q = P } ≤ Fintype.card (primesOverFinset P.asIdeal R_L) :=
      Fintype.card_le_of_injective ψ_P hψ_P_inj
    rw [Fintype.card_coe] at h_le₁
    have h_le₂ : (primesOverFinset P.asIdeal R_L).card ≤ d :=
      Ideal.card_primesOverFinset_le_finrank R_L K L P.ne_bot
    exact h_le₁.trans h_le₂
  let S_ker : Set ι_K := { P : ι_K | IsCoprime P.asIdeal 𝔪 ∧ θ P.asIdeal = 1 }
  let S_𝔪 : Set ι_K := { P : ι_K | P.asIdeal ∣ 𝔪 }
  let f_L : ℝ → ι_L → ℝ := fun s Q => ((Nat.card (R_L ⧸ Q.asIdeal) : ℝ) ^ (-s))
  let f_K : ℝ → ι_K → ℝ := fun s P => ((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s))
  let B : ℝ → ι_K → ℝ := fun s P =>
    S_ker.indicator (f_K s) P + f_K 2 P + S_𝔪.indicator (fun _ => (1 : ℝ)) P
  have hB_nonneg : ∀ (s : ℝ) (P : ι_K), 0 ≤ B s P := by
    intro s P
    have h1 : 0 ≤ S_ker.indicator (f_K s) P :=
      Set.indicator_nonneg (fun _ _ => Real.rpow_nonneg (Nat.cast_nonneg _) _) P
    have h2 : 0 ≤ f_K 2 P := Real.rpow_nonneg (Nat.cast_nonneg _) _
    have h3 : 0 ≤ S_𝔪.indicator (fun _ => (1 : ℝ)) P :=
      Set.indicator_nonneg (fun _ _ => zero_le_one) P
    dsimp only [B]
    linarith
  have hTermBound : ∀ s ∈ Set.Ioo (1 : ℝ) 2, ∀ (P : ι_K) (x : { Q : ι_L // π Q = P }),
      f_L s x.1 ≤ B s P := by
    rintro s ⟨hs1, _⟩ P ⟨Q, hQ⟩
    have h_under : Ideal.under R_K Q.asIdeal = P.asIdeal :=
      congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal hQ
    haveI : P.asIdeal.IsPrime := P.isPrime
    haveI : P.asIdeal.IsMaximal := P.isMaximal
    haveI : Q.asIdeal.IsPrime := Q.isPrime
    haveI : Q.asIdeal.LiesOver P.asIdeal := ⟨h_under.symm⟩
    haveI : Q.asIdeal.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q.asIdeal P.asIdeal
    have h_card_L : Nat.card (R_L ⧸ Q.asIdeal) = Ideal.absNorm Q.asIdeal := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    have h_card_K : Nat.card (R_K ⧸ P.asIdeal) = Ideal.absNorm P.asIdeal := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    have h_pow : Nat.card (R_L ⧸ Q.asIdeal) =
        (Nat.card (R_K ⧸ P.asIdeal)) ^ (P.asIdeal.inertiaDeg Q.asIdeal) := by
      rw [h_card_L, h_card_K]
      exact Ideal.absNorm_eq_pow_inertiaDeg_of_liesOver Q.asIdeal P.asIdeal P.isPrime P.ne_bot
    have hf_pos : 0 < P.asIdeal.inertiaDeg Q.asIdeal := Ideal.inertiaDeg_pos P.asIdeal Q.asIdeal
    have h_gt_K : 1 < Nat.card (R_K ⧸ P.asIdeal) := by
      rw [h_card_K]
      exact NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm P
    have h_gt_L : 1 < Nat.card (R_L ⧸ Q.asIdeal) := by
      rw [h_card_L]
      exact NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm Q
    have h_one_le_K : (1 : ℝ) ≤ (Nat.card (R_K ⧸ P.asIdeal) : ℝ) := by
      exact_mod_cast h_gt_K.le
    have h_one_le_L : (1 : ℝ) ≤ (Nat.card (R_L ⧸ Q.asIdeal) : ℝ) := by
      exact_mod_cast h_gt_L.le
    have h1_nn : 0 ≤ S_ker.indicator (f_K s) P :=
      Set.indicator_nonneg (fun _ _ => Real.rpow_nonneg (Nat.cast_nonneg _) _) P
    have h2_nn : 0 ≤ f_K 2 P := Real.rpow_nonneg (Nat.cast_nonneg _) _
    have h3_nn : 0 ≤ S_𝔪.indicator (fun _ => (1 : ℝ)) P :=
      Set.indicator_nonneg (fun _ _ => zero_le_one) P
    by_cases h_cop : IsCoprime P.asIdeal 𝔪
    · by_cases hf1 : P.asIdeal.inertiaDeg Q.asIdeal = 1
      · have h_card_eq : Nat.card (R_L ⧸ Q.asIdeal) = Nat.card (R_K ⧸ P.asIdeal) := by
          rw [h_pow, hf1, pow_one]
        have h_f_eq : f_L s Q = f_K s P := by
          dsimp only [f_L, f_K]
          rw [h_card_eq]
        have h_rel : Ideal.relNorm R_K Q.asIdeal = P.asIdeal := by
          rw [Ideal.relNorm_eq_pow_of_isMaximal Q.asIdeal P.asIdeal, hf1, pow_one]
        have h_θ : θ P.asIdeal = 1 := by
          rw [← h_rel]
          exact hθ_relNorm Q.asIdeal Q.ne_bot
        have hP_ker : P ∈ S_ker := ⟨h_cop, h_θ⟩
        have h_ind : S_ker.indicator (f_K s) P = f_K s P := Set.indicator_of_mem hP_ker (f_K s)
        dsimp only [B]
        linarith
      · have hf_ge_two : 2 ≤ P.asIdeal.inertiaDeg Q.asIdeal := by omega
        have hf_real_ge : (2 : ℝ) ≤ (P.asIdeal.inertiaDeg Q.asIdeal : ℝ) := by
          exact_mod_cast hf_ge_two
        have h_exp_le : (P.asIdeal.inertiaDeg Q.asIdeal : ℝ) * (-s) ≤ -(2 : ℝ) := by
          nlinarith
        have h_fL_eq : f_L s Q =
            (Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ ((P.asIdeal.inertiaDeg Q.asIdeal : ℝ) * (-s)) := by
          dsimp only [f_L]
          rw [h_pow, Nat.cast_pow, ← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg _)]
        have h_le_fK2 : f_L s Q ≤ f_K 2 P := by
          rw [h_fL_eq]
          exact Real.rpow_le_rpow_of_exponent_le h_one_le_K h_exp_le
        dsimp only [B]
        linarith
    · have hP_𝔪 : P ∈ S_𝔪 := by
        change P.asIdeal ∣ 𝔪
        rw [Ideal.dvd_iff_le]
        by_contra h_not_le
        apply h_cop
        rw [Ideal.isCoprime_iff_sup_eq]
        by_contra h_ne_top
        have h_eq : P.asIdeal = P.asIdeal ⊔ 𝔪 :=
          P.isMaximal.eq_of_le h_ne_top le_sup_left
        apply h_not_le
        calc 𝔪 ≤ P.asIdeal ⊔ 𝔪 := le_sup_right
          _ = P.asIdeal := h_eq.symm
      have h_ind_𝔪 : S_𝔪.indicator (fun _ => (1 : ℝ)) P = 1 :=
        Set.indicator_of_mem hP_𝔪 _
      have h_fL_le_one : f_L s Q ≤ 1 :=
        Real.rpow_le_one_of_one_le_of_nonpos h_one_le_L (by linarith)
      dsimp only [B]
      linarith
  have hFibBound : ∀ s ∈ Set.Ioo (1 : ℝ) 2, ∀ P : ι_K,
      (∑' x : { Q : ι_L // π Q = P }, f_L s x.1) ≤ (d : ℝ) * B s P := by
    intro s hs P
    obtain ⟨inst, h_card_le⟩ := hFibCard P
    letI : Fintype { Q : ι_L // π Q = P } := inst
    rw [tsum_fintype]
    have h_sum_le : (∑ x : { Q : ι_L // π Q = P }, f_L s x.1) ≤
        (Fintype.card { Q : ι_L // π Q = P } : ℝ) * B s P := by
      have h1 := Finset.sum_le_card_nsmul Finset.univ (fun x : { Q : ι_L // π Q = P } => f_L s x.1)
        (B s P) (fun x _ => hTermBound s hs P x)
      rwa [Finset.card_univ, nsmul_eq_mul] at h1
    have h_card_real : (Fintype.card { Q : ι_L // π Q = P } : ℝ) ≤ (d : ℝ) :=
      Nat.cast_le.mpr h_card_le
    exact h_sum_le.trans (mul_le_mul_of_nonneg_right h_card_real (hB_nonneg s P))
  let C₀ : ℝ := (d : ℝ) * ((∑' P : ι_K, f_K 2 P) + (∑' P : ι_K, S_𝔪.indicator (fun _ => (1 : ℝ)) P))
  refine ⟨C₀, fun s hs => ?_⟩
  have hSum_L : Summable (f_L s) := h_summable L hs.1
  have hSum_K : Summable (f_K s) := h_summable K hs.1
  have hSum_ker : Summable (S_ker.indicator (f_K s)) := hSum_K.indicator S_ker
  have hSum_2 : Summable (f_K 2) := h_summable K one_lt_two
  have hSum_𝔪 : Summable (S_𝔪.indicator (fun _ => (1 : ℝ))) := by
    have hS_𝔪_fin : S_𝔪.Finite := Ideal.finite_factors h𝔪_ne
    refine summable_of_ne_finset_zero (s := hS_𝔪_fin.toFinset) (fun P hP => ?_)
    have hP_not : P ∉ S_𝔪 := fun h_in => hP ((Set.Finite.mem_toFinset hS_𝔪_fin).mpr h_in)
    exact Set.indicator_of_notMem hP_not _
  have hSum_B : Summable (B s) := (hSum_ker.add hSum_2).add hSum_𝔪
  have hSum_dB : Summable (fun P : ι_K => (d : ℝ) * B s P) := hSum_B.mul_left (d : ℝ)
  let e_fib : (Σ P : ι_K, { Q : ι_L // π Q = P }) ≃ ι_L := Equiv.sigmaFiberEquiv π
  have hSigmaSum : Summable (fun p : (Σ P : ι_K, { Q : ι_L // π Q = P }) => f_L s (e_fib p)) :=
    (Equiv.summable_iff e_fib).mpr hSum_L
  have hOuterSum : Summable (fun P : ι_K => ∑' x : { Q : ι_L // π Q = P }, f_L s x.1) :=
    Summable.of_nonneg_of_le
      (fun P => tsum_nonneg (fun _ => Real.rpow_nonneg (Nat.cast_nonneg _) _))
      (fun P => hFibBound s hs P)
      hSum_dB
  have h_lhs_eq : (∑' Q : ι_L, f_L s Q) =
      ∑' P : ι_K, ∑' x : { Q : ι_L // π Q = P }, f_L s x.1 := by
    rw [← Equiv.tsum_eq e_fib (f_L s), Summable.tsum_sigma hSigmaSum]
    rfl
  have h_le_dB : (∑' Q : ι_L, f_L s Q) ≤ ∑' P : ι_K, (d : ℝ) * B s P := by
    rw [h_lhs_eq]
    exact Summable.tsum_le_tsum (hFibBound s hs) hOuterSum hSum_dB
  have h_rhs_eq : (∑' P : ι_K, (d : ℝ) * B s P) =
      (d : ℝ) * (∑' P : S_ker, f_K s P.1) + C₀ := by
    rw [tsum_mul_left]
    dsimp only [B, C₀]
    rw [Summable.tsum_add (hSum_ker.add hSum_2) hSum_𝔪,
        Summable.tsum_add hSum_ker hSum_2,
        ← tsum_subtype S_ker (f_K s)]
    ring
  exact h_le_dB.trans_eq h_rhs_eq

theorem narrow_ray_relNorm_eq_of_cyclic_principal_ray_ker {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (σ : L ≃ₐ[K] L)
    (hCyclic : ∀ ρ : L ≃ₐ[K] L, ρ ∈ Subgroup.zpowers σ)
    (θ : Ideal (NumberField.RingOfIntegers K) → (L ≃ₐ[K] L))
    (hθ_top : θ ⊤ = 1)
    (hθ_mul : ∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
      J₁ ≠ ⊥ → J₂ ≠ ⊥ → θ (J₁ * J₂) = θ J₁ * θ J₂)
    (hθ_frob : ∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      IsUnramifiedAtPrime K L P → FrobeniusClassAt K L P ⊆ {θ P.asIdeal})
    (hθ_relNorm : ∀ B : Ideal (NumberField.RingOfIntegers L),
      B ≠ ⊥ → θ (Ideal.relNorm (NumberField.RingOfIntegers K) B) = 1)
    (𝔪 : Ideal (NumberField.RingOfIntegers K))
    (h𝔪_ne : 𝔪 ≠ ⊥)
    (h𝔪_ram : ∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ IsUnramifiedAtPrime K L P → P.asIdeal ∣ 𝔪)
    (h𝔪_ker : ∀ α : NumberField.RingOfIntegers K,
      α ≠ 0 →
      α - 1 ∈ 𝔪 →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (α : K)).re) →
      θ (Ideal.span {α}) = 1)
    (I₁ I₂ : Ideal (NumberField.RingOfIntegers K))
    (hI₁_ne : I₁ ≠ ⊥) (hI₂_ne : I₂ ≠ ⊥)
    (hI₁_cop : IsCoprime I₁ 𝔪) (hI₂_cop : IsCoprime I₂ 𝔪)
    (hθ_eq : θ I₁ = θ I₂) :
    ∃ (α₁ α₂ : NumberField.RingOfIntegers K)
      (C₁ C₂ : Ideal (NumberField.RingOfIntegers L)),
      α₁ ≠ 0 ∧ α₂ ≠ 0 ∧ C₁ ≠ ⊥ ∧ C₂ ≠ ⊥ ∧
      α₁ - 1 ∈ 𝔪 ∧ α₂ - 1 ∈ 𝔪 ∧
      (∀ w : NumberField.InfinitePlace K,
        w.IsReal →
        0 < (w.embedding (α₁ : K)).re ∧ 0 < (w.embedding (α₂ : K)).re) ∧
      I₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
        I₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂ :=
by
  classical
  by_contra h_not_rel
  let R_K := NumberField.RingOfIntegers K
  let R_L := NumberField.RingOfIntegers L
  have h_split : ∀ P : IsDedekindDomain.HeightOneSpectrum R_K,
      IsCoprime P.asIdeal 𝔪 →
      θ P.asIdeal = 1 →
      ∃ Q : Ideal R_L,
        Q ≠ ⊥ ∧ Ideal.relNorm R_K Q = P.asIdeal := by
    intro P hP_cop hP_θ
    have hP_unr : IsUnramifiedAtPrime K L P := by
      by_contra h_ram
      have hdvd : P.asIdeal ∣ 𝔪 := h𝔪_ram P h_ram
      have hle : 𝔪 ≤ P.asIdeal := Ideal.dvd_iff_le.mp hdvd
      have htop : P.asIdeal ⊔ 𝔪 = ⊤ := Ideal.isCoprime_iff_sup_eq.mp hP_cop
      rw [sup_eq_left.mpr hle] at htop
      exact P.isMaximal.ne_top htop
    haveI : P.asIdeal.IsPrime := P.isPrime
    haveI : P.asIdeal.IsMaximal := P.isMaximal
    obtain ⟨⟨Q, hQ_prime, hQ_over⟩⟩ := Ideal.nonempty_primesOver (P := P.asIdeal) (S := R_L)
    haveI : Q.IsPrime := hQ_prime
    haveI : Q.LiesOver P.asIdeal := hQ_over
    have hQ_under : Ideal.under R_K Q = P.asIdeal := (Ideal.LiesOver.over (P := Q) (p := P.asIdeal)).symm
    haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q P.asIdeal
    have hQ_ne : Q ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot P.ne_bot Q
    haveI : Algebra.IsInvariant R_K R_L (L ≃ₐ[K] L) := inferInstance
    obtain ⟨g, hg_arith⟩ := IsArithFrobAt.exists_of_isInvariant R_K (L ≃ₐ[K] L) Q
    have hg_frob : g ∈ FrobeniusClassAt K L P := by
      refine ⟨Q, hQ_prime, hQ_under, fun x z hz => ?_⟩
      have hzx : z = g • x := Subtype.ext hz
      rw [hzx, ← hQ_under]
      exact hg_arith x
    have hg_one : g = 1 := by
      have h1 := Set.mem_singleton_iff.mp (hθ_frob P hP_unr hg_frob)
      exact h1.trans hP_θ
    rw [hg_one] at hg_arith
    letI := Ideal.Quotient.field P.asIdeal
    letI := Ideal.Quotient.field Q
    letI : Fintype (R_K ⧸ P.asIdeal) := Fintype.ofFinite (R_K ⧸ P.asIdeal)
    haveI : Finite (R_L ⧸ Q) := Ideal.finiteQuotientOfFreeOfNeBot Q hQ_ne
    have h_frob_eq_one : FiniteField.frobeniusAlgEquivOfAlgebraic (R_K ⧸ P.asIdeal) (R_L ⧸ Q) = 1 := by
      ext x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, AlgEquiv.one_apply, ← map_pow]
      symm
      rw [Ideal.Quotient.eq]
      have h_card : Fintype.card (R_K ⧸ P.asIdeal) = Nat.card (R_K ⧸ Ideal.under R_K Q) := by
        rw [hQ_under, Nat.card_eq_fintype_card]
      rw [h_card]
      simpa using hg_arith y
    have h_inertia_one : P.asIdeal.inertiaDeg Q = 1 := by
      rw [Ideal.inertiaDeg_algebraMap, ← FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic,
        h_frob_eq_one, orderOf_one]
    refine ⟨Q, hQ_ne, ?_⟩
    rw [Ideal.relNorm_eq_pow_of_isMaximal Q P.asIdeal, h_inertia_one, pow_one]
  obtain ⟨N_ray, J_all, hJ_prop, hJ_cov, hJ_inj⟩ :=
    exists_finite_narrow_ray_class_partition 𝔪 h𝔪_ne
  obtain ⟨ϕ, hϕ_prop, hϕ_sum_P⟩ :=
    exists_twisted_narrow_ray_chars_of_not_relNorm_eq σ hCyclic θ hθ_top hθ_mul hθ_relNorm
      𝔪 h𝔪_ne h𝔪_ker N_ray J_all hJ_prop hJ_cov hJ_inj h_split
      I₁ I₂ hI₁_ne hI₂_ne hI₁_cop hI₂_cop hθ_eq h_not_rel
  have h_ex_M : ∀ i : Fin (Module.finrank K L),
      ∃ M : ℝ, ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
        Summable (fun P : IsDedekindDomain.HeightOneSpectrum R_K =>
          ϕ i P.asIdeal *
            (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)) ∧
        (∑' P : IsDedekindDomain.HeightOneSpectrum R_K,
          ϕ i P.asIdeal *
            (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)).re ≤ M := by
    intro i
    rcases hϕ_prop i with ⟨h_top, h_norm, h_mul, h_not_cop, h_cell, h_sum⟩
    exact eventually_re_prime_sum_le_of_narrow_ray_char_sum_zero
      𝔪 h𝔪_ne N_ray J_all hJ_prop hJ_cov hJ_inj (ϕ i) h_top h_norm h_mul h_not_cop h_cell h_sum
  choose M hM using h_ex_M
  obtain ⟨C₀, hC₀⟩ :=
    prime_sum_le_finrank_mul_coprime_artin_ker_prime_sum_add θ hθ_relNorm 𝔪 h𝔪_ne
  let M_tot : ℝ := (∑ i : Fin (Module.finrank K L), M i) + C₀
  let S_ker : Set (IsDedekindDomain.HeightOneSpectrum R_K) :=
    { P | IsCoprime P.asIdeal 𝔪 ∧ θ P.asIdeal = 1 }
  have h_ev_bound : ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
      (∑' Q : IsDedekindDomain.HeightOneSpectrum R_L,
        ((Nat.card (R_L ⧸ Q.asIdeal) : ℝ) ^ (-s))) ≤ M_tot := by
    filter_upwards [Filter.eventually_all.mpr hM, Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)] with s hs_M hs_Ioo
    have h_sum_le :
        (∑ i : Fin (Module.finrank K L),
          (∑' P : IsDedekindDomain.HeightOneSpectrum R_K,
            ϕ i P.asIdeal *
              (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)).re) ≤
        ∑ i : Fin (Module.finrank K L), M i :=
      Finset.sum_le_sum (fun i _ => (hs_M i).2)
    have h_sum_eq :
        (∑ i : Fin (Module.finrank K L),
          (∑' P : IsDedekindDomain.HeightOneSpectrum R_K,
            ϕ i P.asIdeal *
              (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)).re) =
        (Module.finrank K L : ℝ) *
          (∑' P : S_ker,
            ((Nat.card (R_K ⧸ P.1.asIdeal) : ℝ) ^ (-s))) := by
      rw [← Complex.re_sum, ← Summable.tsum_finsetSum (fun i _ => (hs_M i).1)]
      have h_inner : ∀ P : IsDedekindDomain.HeightOneSpectrum R_K,
          (∑ i : Fin (Module.finrank K L),
            ϕ i P.asIdeal *
              (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)) =
          (((Module.finrank K L : ℝ) *
            S_ker.indicator (fun P' : IsDedekindDomain.HeightOneSpectrum R_K =>
              ((Nat.card (R_K ⧸ P'.asIdeal) : ℝ) ^ (-s))) P : ℝ) : ℂ) := by
        intro P
        rw [← Finset.sum_mul]
        by_cases hP : P ∈ S_ker
        · rw [(hϕ_sum_P P).1 hP, Set.indicator_of_mem hP]
          push_cast
          rfl
        · rw [(hϕ_sum_P P).2 hP, Set.indicator_of_notMem hP]
          simp
      simp_rw [h_inner]
      rw [← Complex.ofReal_tsum, Complex.ofReal_re, tsum_mul_left, ← tsum_subtype S_ker]
    rw [h_sum_eq] at h_sum_le
    have h_c₀ := hC₀ s hs_Ioo
    dsimp [M_tot]
    linarith
  have h_sub : Filter.Tendsto (fun s : ℝ => s - 1) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin 0 (Set.Ioi 0)) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · have h0 : Filter.Tendsto (fun s : ℝ => s - 1) (nhds (1 : ℝ)) (nhds ((1 : ℝ) - 1)) :=
        (continuous_id.tendsto (1 : ℝ)).sub_const (1 : ℝ)
      rw [sub_self] at h0
      exact h0.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact sub_pos.mpr (Set.mem_Ioi.mp hs)
  have h_inv : Filter.Tendsto (fun s : ℝ => 1 / (s - 1)) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
    simp only [one_div]
    exact tendsto_inv_nhdsGT_zero.comp h_sub
  have h_log : Filter.Tendsto (fun s : ℝ => Real.log (1 / (s - 1))) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop :=
    Real.tendsto_log_atTop.comp h_inv
  have h_rhs_tendsto : Filter.Tendsto (fun s : ℝ => M_tot / Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    have h1 := (tendsto_inv_atTop_zero.comp h_log).const_mul M_tot
    rw [mul_zero] at h1
    simp only [div_eq_mul_inv]
    exact h1
  have h_lhs_tendsto : Filter.Tendsto
      (fun s : ℝ =>
        (∑' Q : IsDedekindDomain.HeightOneSpectrum R_L,
          ((Nat.card (R_L ⧸ Q.asIdeal) : ℝ) ^ (-s))) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 1) :=
    tendsto_univ_prime_sum_div_log (F := L)
  have h_ev_div : ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
      (∑' Q : IsDedekindDomain.HeightOneSpectrum R_L,
        ((Nat.card (R_L ⧸ Q.asIdeal) : ℝ) ^ (-s))) /
      Real.log (1 / (s - 1)) ≤
      M_tot / Real.log (1 / (s - 1)) := by
    filter_upwards [h_ev_bound, Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)] with s hs_b hs_Ioo
    have hs1 : 0 < s - 1 := sub_pos.mpr hs_Ioo.1
    have hs2 : s - 1 < 1 := by linarith [hs_Ioo.2]
    have h_one_lt : 1 < 1 / (s - 1) := (one_lt_div hs1).mpr hs2
    have h_log_pos : 0 < Real.log (1 / (s - 1)) := Real.log_pos h_one_lt
    exact div_le_div_of_nonneg_right hs_b h_log_pos.le
  have h_one_le_zero : (1 : ℝ) ≤ 0 :=
    le_of_tendsto_of_tendsto h_lhs_tendsto h_rhs_tendsto h_ev_div
  linarith

theorem relNorm_narrow_ray_eq_of_isGalois_tower {F E K L : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra F E] [Algebra F K] [IsGalois F K] [Algebra K L] [Algebra E L] [Algebra F L]
    [IsScalarTower F K L] [IsScalarTower F E L]
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (I₁ I₂ : Ideal (NumberField.RingOfIntegers K))
    (α₁ α₂ : NumberField.RingOfIntegers K)
    (C₁ C₂ : Ideal (NumberField.RingOfIntegers L))
    (hα₁_ne : α₁ ≠ 0) (hα₂_ne : α₂ ≠ 0)
    (hC₁_ne : C₁ ≠ ⊥) (hC₂_ne : C₂ ≠ ⊥)
    (hα₁_m₀ : α₁ - 1 ∈ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K)) m₀)
    (hα₂_m₀ : α₂ - 1 ∈ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K)) m₀)
    (hα_pos : ∀ w : NumberField.InfinitePlace K,
      w.IsReal →
      0 < (w.embedding (α₁ : K)).re ∧ 0 < (w.embedding (α₂ : K)).re)
    (h_eq : I₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
      I₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂) :
    ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
      (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      Ideal.relNorm (NumberField.RingOfIntegers F) I₁ * Ideal.span {a₁} *
          Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
        Ideal.relNorm (NumberField.RingOfIntegers F) I₂ * Ideal.span {a₂} *
          Ideal.relNorm (NumberField.RingOfIntegers F) B₂ :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let R_K := NumberField.RingOfIntegers K
  let M_K : Ideal R_K := Ideal.map (algebraMap R_F R_K) m₀
  have h_s1 : ∀ α : R_K, α - 1 ∈ M_K →
      algebraMap R_F R_K (Algebra.intNorm R_F R_K α - 1) ∈ M_K := by
    intro α hα_m₀
    have h_prod :
        algebraMap R_F R_K (Algebra.intNorm R_F R_K α) =
          ∏ σ : K ≃ₐ[F] K, (galRestrict R_F F K R_K σ) α := by
      apply IsIntegralClosure.algebraMap_injective R_K R_F K
      rw [← IsScalarTower.algebraMap_apply R_F R_K K,
        IsScalarTower.algebraMap_apply R_F F K,
        Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := K) (B := R_K) α,
        Algebra.norm_eq_prod_automorphisms F (algebraMap R_K K α),
        map_prod]
      refine Finset.prod_congr rfl (fun σ _ => ?_)
      exact (algebraMap_galRestrict_apply R_F σ α).symm
    have h_map_le : ∀ σ : K ≃ₐ[F] K,
        M_K ≤ Ideal.comap (galRestrict R_F F K R_K σ).toRingHom M_K := by
      intro σ
      refine Ideal.map_le_iff_le_comap.mpr (fun y hy => ?_)
      rw [Ideal.mem_comap]
      change (galRestrict R_F F K R_K σ) (algebraMap R_F R_K y) ∈ M_K
      rw [(galRestrict R_F F K R_K σ).commutes y]
      exact Ideal.mem_map_of_mem (algebraMap R_F R_K) hy
    have h_gal_mem : ∀ σ : K ≃ₐ[F] K, (galRestrict R_F F K R_K σ) α - 1 ∈ M_K := by
      intro σ
      have h1 := h_map_le σ hα_m₀
      rw [Ideal.mem_comap] at h1
      change (galRestrict R_F F K R_K σ) (α - 1) ∈ M_K at h1
      rwa [map_sub, map_one] at h1
    have h_finset_prod : ∀ s : Finset (K ≃ₐ[F] K),
        (∏ σ ∈ s, (galRestrict R_F F K R_K σ) α) - 1 ∈ M_K := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · rw [Finset.prod_empty, sub_self]
        exact M_K.zero_mem
      · intro σ₀ s hσ₀ ih
        rw [Finset.prod_insert hσ₀]
        have h_id :
            (galRestrict R_F F K R_K σ₀) α * (∏ σ ∈ s, (galRestrict R_F F K R_K σ) α) - 1 =
              ((galRestrict R_F F K R_K σ₀) α - 1) * (∏ σ ∈ s, (galRestrict R_F F K R_K σ) α) +
              ((∏ σ ∈ s, (galRestrict R_F F K R_K σ) α) - 1) := by ring
        rw [h_id]
        exact M_K.add_mem (Ideal.mul_mem_right _ M_K (h_gal_mem σ₀)) ih
    rw [map_sub, map_one, h_prod]
    exact h_finset_prod Finset.univ
  have h_s2 : ∀ x : R_F, algebraMap R_F R_K x ∈ M_K → x ∈ m₀ := by
    intro x hx
    by_cases hx_ne : x = 0
    · rw [hx_ne]
      exact m₀.zero_mem
    · let J : Ideal R_F := Ideal.span ({x} : Set R_F)
      have hJ_ne : J ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hx_ne
      have hJ_zero : J ≠ 0 := by rwa [Submodule.zero_eq_bot]
      have h_map_J : Ideal.map (algebraMap R_F R_K) J ≤ M_K := by
        dsimp [J]
        rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem]
        exact hx
      have h_dvd_map : M_K ∣ Ideal.map (algebraMap R_F R_K) J :=
        Ideal.dvd_iff_le.mpr h_map_J
      have h_dvd_rel :
          Ideal.relNorm R_F M_K ∣ Ideal.relNorm R_F (Ideal.map (algebraMap R_F R_K) J) :=
        map_dvd (Ideal.relNorm R_F) h_dvd_map
      letI : Algebra (FractionRing R_F) (FractionRing R_K) :=
        FractionRing.liftAlgebra R_F (FractionRing R_K)
      let n : ℕ := Module.finrank (FractionRing R_F) (FractionRing R_K)
      have hn_eq : n = Module.finrank F K :=
        (Algebra.IsAlgebraic.finrank_of_isFractionRing R_F (FractionRing R_F) R_K (FractionRing R_K)).trans
          (Algebra.IsAlgebraic.finrank_of_isFractionRing R_F F R_K K).symm
      have hn_pos : 0 < n := by
        rw [hn_eq]
        exact Module.finrank_pos
      have h_dvd_pow : m₀ ^ n ∣ J ^ n := by
        dsimp [M_K, n] at h_dvd_rel ⊢
        rwa [Ideal.relNorm_algebraMap R_K m₀, Ideal.relNorm_algebraMap R_K J] at h_dvd_rel
      have hJn_zero : J ^ n ≠ 0 := pow_ne_zero n hJ_zero
      have hm₀n_zero : m₀ ^ n ≠ 0 := ne_zero_of_dvd_ne_zero hJn_zero h_dvd_pow
      have hm₀_zero : m₀ ≠ 0 := fun h0 => hm₀n_zero (by rw [h0, zero_pow hn_pos.ne'])
      have h_nf_pow :
          UniqueFactorizationMonoid.normalizedFactors (m₀ ^ n) ≤
            UniqueFactorizationMonoid.normalizedFactors (J ^ n) :=
        (UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hm₀n_zero hJn_zero).mp h_dvd_pow
      rw [UniqueFactorizationMonoid.normalizedFactors_pow,
        UniqueFactorizationMonoid.normalizedFactors_pow,
        Multiset.le_iff_count] at h_nf_pow
      have h_nf :
          UniqueFactorizationMonoid.normalizedFactors m₀ ≤
            UniqueFactorizationMonoid.normalizedFactors J := by
        rw [Multiset.le_iff_count]
        intro P
        have hP := h_nf_pow P
        rw [Multiset.count_nsmul, Multiset.count_nsmul] at hP
        exact Nat.le_of_mul_le_mul_left hP hn_pos
      have h_dvd : m₀ ∣ J :=
        (UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hm₀_zero hJ_zero).mpr h_nf
      exact Ideal.dvd_span_singleton.mp h_dvd
  have h_s3 : ∀ α : R_K, α ≠ 0 →
      (∀ w_K : NumberField.InfinitePlace K, w_K.IsReal → 0 < (w_K.embedding (α : K)).re) →
      Algebra.intNorm R_F R_K α ≠ 0 ∧
      ∀ w : NumberField.InfinitePlace F, w.IsReal →
        0 < (w.embedding (Algebra.intNorm R_F R_K α : F)).re := by
    intro α hα_ne hα_pos_single
    let a : R_F := Algebra.intNorm R_F R_K α
    let x : K := (α : K)
    have hx_ne : x ≠ 0 := NumberField.RingOfIntegers.coe_eq_zero_iff.not.mpr hα_ne
    have ha_alg : algebraMap R_F F a = Algebra.norm F x :=
      Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := K) (B := R_K) α
    have ha_coe : (a : F) = Algebra.norm F x := ha_alg
    have ha_ne : a ≠ 0 := by
      intro ha0
      have h_norm_ne : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx_ne
      apply h_norm_ne
      rw [← ha_alg, ha0, map_zero]
    refine ⟨ha_ne, fun w hw => ?_⟩
    letI : Algebra F ℂ := w.embedding.toAlgebra
    have h_alg_eq : algebraMap F ℂ = w.embedding := rfl
    have h_prod_alg : w.embedding (a : F) = ∏ ψ : K →ₐ[F] ℂ, ψ x := by
      rw [ha_coe, ← h_alg_eq]
      exact Algebra.norm_eq_prod_embeddings F ℂ x
    have h_w_real : ∀ y : F, (starRingEnd ℂ) (w.embedding y) = w.embedding y := by
      intro y
      have h_real_emb : NumberField.ComplexEmbedding.IsReal w.embedding :=
        NumberField.InfinitePlace.isReal_iff.mp hw
      have h_conj_emb : NumberField.ComplexEmbedding.conjugate w.embedding = w.embedding :=
        NumberField.ComplexEmbedding.isReal_iff.mp h_real_emb
      rw [← NumberField.ComplexEmbedding.conjugate_coe_eq w.embedding y, h_conj_emb]
    let conjAlg : (K →ₐ[F] ℂ) → (K →ₐ[F] ℂ) := fun ψ =>
      { toRingHom := (starRingEnd ℂ).comp ψ.toRingHom
        commutes' := fun y => by
          change (starRingEnd ℂ) (ψ (algebraMap F K y)) = algebraMap F ℂ y
          rw [ψ.commutes y, h_alg_eq, h_w_real y] }
    have h_conjAlg_apply : ∀ (ψ : K →ₐ[F] ℂ) (z : K), conjAlg ψ z = (starRingEnd ℂ) (ψ z) :=
      fun _ _ => rfl
    have h_conjAlg_inv : ∀ ψ : K →ₐ[F] ℂ, conjAlg (conjAlg ψ) = ψ := by
      intro ψ
      ext z
      exact starRingEnd_self_apply (ψ z)
    have hψ_ne : ∀ ψ : K →ₐ[F] ℂ, ψ x ≠ 0 :=
      fun ψ => (map_ne_zero ψ).mpr hx_ne
    have h_norm_pos : ∀ ψ : K →ₐ[F] ℂ, 0 < ‖ψ x‖ :=
      fun ψ => norm_pos_iff.mpr (hψ_ne ψ)
    have h_norm_c_ne : ∀ ψ : K →ₐ[F] ℂ, (‖ψ x‖ : ℂ) ≠ 0 :=
      fun ψ => Complex.ofReal_ne_zero.mpr (h_norm_pos ψ).ne'
    let u : (K →ₐ[F] ℂ) → ℂ := fun ψ => ψ x / (‖ψ x‖ : ℂ)
    have h_factor : ∀ ψ : K →ₐ[F] ℂ, ψ x = u ψ * (‖ψ x‖ : ℂ) := by
      intro ψ
      dsimp [u]
      exact (div_mul_cancel₀ (ψ x) (h_norm_c_ne ψ)).symm
    have h_prod_factor :
        (∏ ψ : K →ₐ[F] ℂ, ψ x) =
          (∏ ψ : K →ₐ[F] ℂ, u ψ) * ((∏ ψ : K →ₐ[F] ℂ, ‖ψ x‖ : ℝ) : ℂ) := by
      calc
        (∏ ψ : K →ₐ[F] ℂ, ψ x) = ∏ ψ : K →ₐ[F] ℂ, (u ψ * (‖ψ x‖ : ℂ)) :=
          Finset.prod_congr rfl (fun ψ _ => h_factor ψ)
        _ = (∏ ψ : K →ₐ[F] ℂ, u ψ) * (∏ ψ : K →ₐ[F] ℂ, (‖ψ x‖ : ℂ)) :=
          Finset.prod_mul_distrib
        _ = (∏ ψ : K →ₐ[F] ℂ, u ψ) * ((∏ ψ : K →ₐ[F] ℂ, ‖ψ x‖ : ℝ) : ℂ) := by
          rw [Complex.ofReal_prod]
    have hu_fixed : ∀ ψ : K →ₐ[F] ℂ, conjAlg ψ = ψ → u ψ = 1 := by
      intro ψ h_fix
      have h_conj_ring : NumberField.ComplexEmbedding.conjugate ψ.toRingHom = ψ.toRingHom := by
        ext z
        exact congrFun (congrArg DFunLike.coe h_fix) z
      have h_real_ψ : NumberField.ComplexEmbedding.IsReal ψ.toRingHom :=
        NumberField.ComplexEmbedding.isReal_iff.mpr h_conj_ring
      let w_K : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk ψ.toRingHom
      have hw_K : w_K.IsReal := NumberField.InfinitePlace.isReal_mk_iff.mpr h_real_ψ
      have hw_K_emb : w_K.embedding = ψ.toRingHom :=
        NumberField.InfinitePlace.embedding_mk_eq_of_isReal h_real_ψ
      have h_re_pos : 0 < (ψ x).re := by
        have h1 := hα_pos_single w_K hw_K
        rwa [hw_K_emb] at h1
      have h_conj_x : (starRingEnd ℂ) (ψ x) = ψ x :=
        congrFun (congrArg DFunLike.coe h_fix) x
      have h_re_eq : ((ψ x).re : ℂ) = ψ x := Complex.conj_eq_iff_re.mp h_conj_x
      have h_norm_eq : ‖ψ x‖ = (ψ x).re := by
        calc ‖ψ x‖ = ‖((ψ x).re : ℂ)‖ := congrArg norm h_re_eq.symm
        _ = ‖(ψ x).re‖ := Complex.norm_real (ψ x).re
        _ = (ψ x).re := Real.norm_of_nonneg h_re_pos.le
      dsimp [u]
      rw [h_norm_eq, h_re_eq]
      exact div_self (hψ_ne ψ)
    have h_prod_u : (∏ ψ : K →ₐ[F] ℂ, u ψ) = 1 := by
      refine Finset.prod_involution (fun (ψ : K →ₐ[F] ℂ) _ => conjAlg ψ) ?_ ?_ ?_ ?_
      · intro ψ _
        dsimp [u]
        rw [h_conjAlg_apply, Complex.norm_conj (ψ x), div_mul_div_comm,
          Complex.mul_conj' (ψ x), ← sq]
        exact div_self (pow_ne_zero 2 (h_norm_c_ne ψ))
      · intro ψ _ hu_ne h_fix
        exact hu_ne (hu_fixed ψ h_fix)
      · intro ψ _
        exact Finset.mem_univ _
      · intro ψ _
        exact h_conjAlg_inv ψ
    have h_emb_eq :
        w.embedding (a : F) = ((∏ ψ : K →ₐ[F] ℂ, ‖ψ x‖ : ℝ) : ℂ) := by
      rw [h_prod_alg, h_prod_factor, h_prod_u, one_mul]
    have h_re_eq :
        (w.embedding (a : F)).re = ∏ ψ : K →ₐ[F] ℂ, ‖ψ x‖ := by
      have h_re := congrArg Complex.re h_emb_eq
      simpa only [Complex.ofReal_re] using h_re
    rw [h_re_eq]
    exact Finset.prod_pos (fun ψ _ => h_norm_pos ψ)
  let a₁ : R_F := Algebra.intNorm R_F R_K α₁
  let a₂ : R_F := Algebra.intNorm R_F R_K α₂
  let B₁ : Ideal R_E := Ideal.relNorm R_E C₁
  let B₂ : Ideal R_E := Ideal.relNorm R_E C₂
  obtain ⟨ha₁_ne, ha₁_pos⟩ := h_s3 α₁ hα₁_ne (fun w hw => (hα_pos w hw).1)
  obtain ⟨ha₂_ne, ha₂_pos⟩ := h_s3 α₂ hα₂_ne (fun w hw => (hα_pos w hw).2)
  have hB₁_ne : B₁ ≠ ⊥ := (Ideal.relNorm_eq_bot_iff (R := R_E)).not.mpr hC₁_ne
  have hB₂_ne : B₂ ≠ ⊥ := (Ideal.relNorm_eq_bot_iff (R := R_E)).not.mpr hC₂_ne
  have ha₁_m₀ : a₁ - 1 ∈ m₀ := h_s2 (a₁ - 1) (h_s1 α₁ hα₁_m₀)
  have ha₂_m₀ : a₂ - 1 ∈ m₀ := h_s2 (a₂ - 1) (h_s1 α₂ hα₂_m₀)
  refine ⟨a₁, a₂, B₁, B₂, ha₁_ne, ha₂_ne, hB₁_ne, hB₂_ne, ha₁_m₀, ha₂_m₀,
    fun w hw => ⟨ha₁_pos w hw, ha₂_pos w hw⟩, ?_⟩
  have h_rel := congrArg (Ideal.relNorm R_F) h_eq
  dsimp only [a₁, a₂, B₁, B₂] at h_rel ⊢
  rw [map_mul, map_mul, map_mul, map_mul,
    Ideal.relNorm_singleton R_F α₁, Ideal.relNorm_singleton R_F α₂,
    Ideal.relNorm_relNorm R_F R_K C₁, Ideal.relNorm_relNorm R_F R_K C₂,
    ← Ideal.relNorm_relNorm R_F R_E C₁, ← Ideal.relNorm_relNorm R_F R_E C₂] at h_rel
  exact h_rel

theorem exists_ambient_cyclotomic_galois_equiv_reduction {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (m : ℕ)
    (hm_one : 1 ≤ m)
    (hm_sq : Squarefree m)
    (hm_unr : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m →
      Ideal.absNorm (differentIdeal ℤ (NumberField.RingOfIntegers E)) < ℓ)
    (P : Prop)
    (hP : ∀ {M : Type u} [Field M] [NumberField M]
      [Algebra F M] [IsGalois F M] [Algebra E M] [IsScalarTower F E M]
      (ζ : NumberField.RingOfIntegers M)
      (Φ : (M ≃ₐ[F] M) ≃* (E ≃ₐ[F] E) × (ZMod m)ˣ),
      (∀ τ : M ≃ₐ[F] M, (Φ τ).1 = AlgEquiv.restrictNormalHom E τ) →
      (∀ (τ : M ≃ₐ[F] M) (k : ℕ) (Q : Ideal (NumberField.RingOfIntegers M)),
        Q.IsPrime →
        (m : NumberField.RingOfIntegers M) ∉ Q →
        τ • ζ - ζ ^ k ∈ Q →
        (((Φ τ).2 : (ZMod m)ˣ) : ZMod m) = (k : ZMod m)) →
      P) :
    P :=
by
  haveI h_norm_FE : Normal F E := IsGalois.to_normal
  have autToPow_zmod_eq_of_smul_sub_pow_mem_prime :
      ∀ {F M : Type u} [Field F] [NumberField F] [Field M] [NumberField M] [Algebra F M]
        (m : ℕ) [NeZero m] (ζ : NumberField.RingOfIntegers M) (hζ_M : IsPrimitiveRoot (ζ : M) m)
        (τ : M ≃ₐ[F] M) (k : ℕ) (Q : Ideal (NumberField.RingOfIntegers M)),
        Q.IsPrime →
        (m : NumberField.RingOfIntegers M) ∉ Q →
        τ • ζ - ζ ^ k ∈ Q →
        (((IsPrimitiveRoot.autToPow F hζ_M τ : (ZMod m)ˣ) : ZMod m)) = (k : ZMod m) := by
    intro F M _ _ _ _ _ m _ ζ hζ_M τ k Q _hQ_prime hm_not_Q h_mem
    have hm_pos : 0 < m := NeZero.pos m
    have hζ : IsPrimitiveRoot ζ m :=
      IsPrimitiveRoot.of_map_of_injective hζ_M Subtype.val_injective
    let u : (ZMod m)ˣ := IsPrimitiveRoot.autToPow F hζ_M τ
    let a : ℕ := (u : ZMod m).val
    have h_smul : τ • ζ = ζ ^ a := by
      apply Subtype.ext
      have h_spec := IsPrimitiveRoot.autToPow_spec F hζ_M τ
      change (ζ : M) ^ a = τ (ζ : M) at h_spec
      exact h_spec.symm
    let ξ₁ : NumberField.RingOfIntegers M := ζ ^ a
    let ξ₂ : NumberField.RingOfIntegers M := ζ ^ k
    have hξ₁_pow : ξ₁ ^ m = 1 := by
      dsimp [ξ₁]
      rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
    have hξ₂_pow : ξ₂ ^ m = 1 := by
      dsimp [ξ₂]
      rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
    have h_diff_Q : ξ₁ - ξ₂ ∈ Q := by
      dsimp [ξ₁, ξ₂]
      rwa [← h_smul]
    have h_eq_pow : ξ₁ = ξ₂ := by
      by_contra h_ne
      have h_sub_ne : ξ₁ - ξ₂ ≠ 0 := sub_ne_zero.mpr h_ne
      have h_geom := geom_sum₂_mul ξ₁ ξ₂ m
      rw [hξ₁_pow, hξ₂_pow, sub_self] at h_geom
      have h_sum_zero : (∑ i ∈ Finset.range m, ξ₁ ^ i * ξ₂ ^ (m - 1 - i)) = 0 :=
        (mul_eq_zero.mp h_geom).resolve_right h_sub_ne
      let π_Q := Ideal.Quotient.mk Q
      have h_eq_mod : π_Q ξ₁ = π_Q ξ₂ := Ideal.Quotient.eq.mpr h_diff_Q
      have h_zero_mod : π_Q (∑ i ∈ Finset.range m, ξ₁ ^ i * ξ₂ ^ (m - 1 - i)) * π_Q ξ₂ = 0 := by
        rw [h_sum_zero, map_zero, zero_mul]
      rw [map_sum, Finset.sum_mul] at h_zero_mod
      have h_term : ∀ i ∈ Finset.range m,
          π_Q (ξ₁ ^ i * ξ₂ ^ (m - 1 - i)) * π_Q ξ₂ = 1 := by
        intro i hi
        rw [Finset.mem_range] at hi
        rw [map_mul, map_pow π_Q ξ₁, map_pow π_Q ξ₂, h_eq_mod, ← pow_add, ← pow_succ]
        have h_exp : i + (m - 1 - i) + 1 = m := by omega
        rw [h_exp, ← map_pow, hξ₂_pow, map_one]
