          Ideal.relNorm_eq_pow_of_isMaximal Q P.asIdeal
        rw [h_rel_eq] at h_rel_dvd
        have h_f_ne : P.asIdeal.inertiaDeg Q ≠ 0 := (Ideal.inertiaDeg_pos P.asIdeal Q).ne'
        exact hP_not_I₁ (dvd_trans (dvd_pow_self P.asIdeal h_f_ne) h_rel_dvd)
