            Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₁ =
            Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₂ }) ⧸
      (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).range.subgroupOf
