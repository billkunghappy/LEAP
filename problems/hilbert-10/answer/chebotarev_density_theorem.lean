      have hp₀_ne_bot : p₀_ideal ≠ ⊥ :=
        Ideal.under_ne_bot (NumberField.RingOfIntegers F) P.ne_bot
      let p₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) :=
