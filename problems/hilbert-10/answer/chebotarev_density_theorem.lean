            ⟨⟨y.1, h_mem_T⟩, Subtype.ext h_pi⟩
          left_inv := fun _ => Subtype.ext (Subtype.ext rfl)
          right_inv := fun _ => Subtype.ext rfl }
    have h_fib_card : ∀ q : U_F, Nat.card { x : T_K' // proj x = q } = m := by
      intro q
      rw [Nat.card_congr (h_fib_equiv q)]
      exact (h_s2 q.1 q.2).1
    have h_ineq_s : ∀ s : ℝ, 1 < s →
        (m : ℝ) *
          (∑' q : U_F,
            ((Nat.card (NumberField.RingOfIntegers F ⧸ q.1.asIdeal) : ℝ) ^ (-s))) ≤
        ∑' q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'),
          ((Nat.card (NumberField.RingOfIntegers K' ⧸ q'.asIdeal) : ℝ) ^ (-s)) := by
      intro s hs
      let f_s : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℝ :=
        fun q => (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)
      let g_s : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K') → ℝ :=
        fun q' => (Nat.card (NumberField.RingOfIntegers K' ⧸ q'.asIdeal) : ℝ) ^ (-s)
      have hIdeal_K' := (dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := K') hs).1
      have h_sum_g : Summable g_s :=
        (tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_K').1
      have h_le_univ : (∑' x : T_K', g_s x.1) ≤ ∑' q', g_s q' :=
        Summable.tsum_subtype_le g_s T_K' (fun _ => Real.rpow_nonneg (Nat.cast_nonneg _) (-s)) h_sum_g
      have h_fib_fin : ∀ q : U_F, Finite { x : T_K' // proj x = q } := by
        intro q
        apply Nat.finite_of_card_ne_zero
        rw [h_fib_card q]
        exact hm_ne
      have h_sum_T : Summable (fun x : T_K' => g_s x.1) := h_sum_g.subtype T_K'
      have h_sum_sigma :
          Summable (fun u : (q : U_F) × { x : T_K' // proj x = q } => g_s u.2.1.1) := by
        change Summable ((fun x : T_K' => g_s x.1) ∘ (Equiv.sigmaFiberEquiv proj))
        exact h_sum_T.comp_injective (Equiv.sigmaFiberEquiv proj).injective
      have h_eq_T :
          (∑' x : T_K', g_s x.1) = (m : ℝ) * ∑' q : U_F, f_s q.1 := by
        rw [← (Equiv.sigmaFiberEquiv proj).tsum_eq (fun x : T_K' => g_s x.1)]
        change (∑' u : (q : U_F) × { x : T_K' // proj x = q }, g_s u.2.1.1) =
          (m : ℝ) * ∑' q : U_F, f_s q.1
        rw [Summable.tsum_sigma' (fun q => Summable.of_finite) h_sum_sigma]
        have h_inner : ∀ q : U_F,
            (∑' x : { x : T_K' // proj x = q }, g_s x.1.1) = (m : ℝ) * f_s q.1 := by
          intro q
          haveI : Finite { x : T_K' // proj x = q } := h_fib_fin q
          letI : Fintype { x : T_K' // proj x = q } := Fintype.ofFinite _
          rw [tsum_fintype]
          have h_const : ∀ x : { x : T_K' // proj x = q }, g_s x.1.1 = f_s q.1 := by
            intro x
            dsimp [g_s, f_s]
            have h_under : Ideal.under (NumberField.RingOfIntegers F) x.1.1.asIdeal = q.1.asIdeal :=
              congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal (congrArg Subtype.val x.2)
            rw [(h_s2 q.1 q.2).2 x.1.1 h_under]
          simp_rw [h_const]
          rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
            h_fib_card q, nsmul_eq_mul]
        simp_rw [h_inner]
        exact tsum_mul_left
      linarith
    have h_lhs :
        Filter.Tendsto
          (fun s : ℝ =>
            (m : ℝ) *
              ((∑' q : U_F,
                ((Nat.card (NumberField.RingOfIntegers F ⧸ q.1.asIdeal) : ℝ) ^ (-s))) /
              Real.log (1 / (s - 1))))
          (nhdsWithin (1 : ℝ) (Set.Ioi 1))
          (nhds ((m : ℝ) * 1)) :=
      h_unr_tendsto.const_mul (m : ℝ)
    rw [mul_one] at h_lhs
    have h_rhs := tendsto_univ_prime_sum_div_log (F := K')
    have h_real_le : (m : ℝ) ≤ 1 := by
      refine le_of_tendsto_of_tendsto h_lhs h_rhs ?_
      filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)] with s hs
      have hs1 : 0 < s - 1 := sub_pos.mpr hs.1
      have hs2 : s - 1 < 1 := by linarith [hs.2]
      have h_one_lt : 1 < 1 / (s - 1) := (one_lt_div hs1).mpr hs2
      have h_log_pos : 0 < Real.log (1 / (s - 1)) := Real.log_pos h_one_lt
      rw [← mul_div_assoc]
      exact div_le_div_of_nonneg_right (h_ineq_s s hs.1) h_log_pos.le
    exact_mod_cast h_real_le
  
  have hm_eq : m = 1 := le_antisymm hm_le hm_pos
  have h_card_H : Nat.card H = Nat.card (E ≃ₐ[F] E) := by
    have h_mul := Module.finrank_mul_finrank F K' E
    change m * Module.finrank K' E = Module.finrank F E at h_mul
    rw [hm_eq, one_mul, IntermediateField.finrank_fixedField_eq_card H,
      ← IsGalois.card_aut_eq_finrank F E] at h_mul
    exact h_mul
  have hH_top : H = ⊤ := Subgroup.eq_top_of_card_eq H h_card_H
  have hρ_mem : ρ ∈ H := by
    rw [hH_top]
    exact Subgroup.mem_top ρ
  exact hH_ideal ρ hρ_mem

theorem exists_frob_exponent_and_artin_map_eq_pow_finsupp_sum {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (θ : Ideal (NumberField.RingOfIntegers F) → (E ≃ₐ[F] E))
    (hθ_top : θ ⊤ = 1)
    (hθ_mul : ∀ I₁ I₂ : Ideal (NumberField.RingOfIntegers F),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂)
    (hθ_frob : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {θ q.asIdeal}) :
    ∃ e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ,
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {σ ^ (e q)}) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers F),
        I ≠ ⊥ →
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) →
        ∃ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
          I = f.prod (fun q m => q.asIdeal ^ m) ∧
          (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
          θ I = σ ^ (f.sum (fun q m => e q * m))) :=
by
  classical
  let ι := IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)
  have h_ex_e : ∀ q : ι, ∃ k : ℕ, σ ^ k = θ q.asIdeal := by
    intro q
    exact mem_powers_iff_mem_zpowers.mpr (hCyclic (θ q.asIdeal))
  choose e he using h_ex_e
  have he_frob : ∀ q : ι, IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {σ ^ (e q)} := by
    intro q hq
    rw [he q]
    exact hθ_frob q hq
  let P_prod : (ι →₀ ℕ) → Ideal (NumberField.RingOfIntegers F) :=
    fun f => f.prod (fun q m => q.asIdeal ^ m)
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal :
        ι → Ideal (NumberField.RingOfIntegers F)) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  have h_toMultiset_prod :
      ∀ f : ι →₀ ℕ,
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod =
          P_prod f := by
    intro f
    unfold P_prod
    rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
      Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
  have h_prod_ne_bot : ∀ f : ι →₀ ℕ, P_prod f ≠ ⊥ := by
    intro f
    rw [← h_toMultiset_prod f, ← Submodule.zero_eq_bot]
    apply Multiset.prod_ne_zero
    intro h0
    rw [Multiset.mem_map] at h0
    rcases h0 with ⟨q, _, hq0⟩
    rw [Submodule.zero_eq_bot] at hq0
    exact q.ne_bot hq0
  have h_pow_ne_bot : ∀ (q : ι) (m : ℕ), q.asIdeal ^ m ≠ ⊥ := by
    intro q m
    rw [← Submodule.zero_eq_bot]
    exact pow_ne_zero m (by rw [Submodule.zero_eq_bot]; exact q.ne_bot)
  have hθ_pow : ∀ (q : ι) (m : ℕ), θ (q.asIdeal ^ m) = σ ^ (e q * m) := by
    intro q m
    induction m with
    | zero =>
      rw [pow_zero, Ideal.one_eq_top, hθ_top, mul_zero, pow_zero]
    | succ m ih =>
      rw [pow_succ, hθ_mul (q.asIdeal ^ m) q.asIdeal (h_pow_ne_bot q m) q.ne_bot,
        ih, ← he q, mul_add, mul_one, pow_add]
  have hθ_prod : ∀ f : ι →₀ ℕ, θ (P_prod f) = σ ^ (f.sum (fun q m => e q * m)) := by
    intro f
    refine Finsupp.induction f ?_ ?_
    · change θ (P_prod 0) = σ ^ ((0 : ι →₀ ℕ).sum (fun q m => e q * m))
      unfold P_prod
      rw [Finsupp.prod_zero_index, Ideal.one_eq_top, hθ_top, Finsupp.sum_zero_index, pow_zero]
    · intro q m g hq_not_mem hm_ne_zero ih
      have hP_add : P_prod (Finsupp.single q m + g) = P_prod (Finsupp.single q m) * P_prod g :=
        Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)
      have hP_single : P_prod (Finsupp.single q m) = q.asIdeal ^ m :=
        Finsupp.prod_single_index (pow_zero _)
      rw [hP_add, hθ_mul _ _ (h_prod_ne_bot _) (h_prod_ne_bot _), hP_single, hθ_pow q m, ih,
        Finsupp.sum_add_index' (fun _ => mul_zero _) (fun _ _ _ => mul_add _ _ _),
        Finsupp.sum_single_index (mul_zero _), pow_add]
  refine ⟨e, he_frob, fun J hJ hJ_unr => ?_⟩
  let N := UniqueFactorizationMonoid.normalizedFactors J
  let m_ms : Multiset ι :=
    Multiset.pmap
      (fun (p : Ideal (NumberField.RingOfIntegers F)) (hp : Prime p) =>
        IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
      N
      (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
  let f : ι →₀ ℕ := Multiset.toFinsupp m_ms
  have hJf : J = P_prod f := by
    rw [← h_toMultiset_prod f]
    have hfm : Finsupp.toMultiset f = m_ms := Multiset.toFinsupp_toMultiset m_ms
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m_ms = N := by
      dsimp [m_ms]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact (prod_normalizedFactors_eq_self hJ).symm
  have hf_supp : ∀ q ∈ f.support, IsUnramifiedAtPrime F E q := by
    intro q hq
    apply hJ_unr q
    rw [hJf]
    unfold P_prod
    rw [Finsupp.prod]
    have h_dvd_pow : q.asIdeal ∣ q.asIdeal ^ f q :=
      dvd_pow_self _ (Finsupp.mem_support_iff.mp hq)
    exact dvd_trans h_dvd_pow (Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ f q') hq)
  refine ⟨f, hJf, hf_supp, ?_⟩
  rw [hJf, hθ_prod f]

theorem valued_algebraMap_adicCompletion_eq_exp_neg_of_span_eq_finsupp_prod {F : Type u} [Field F] [NumberField F]
    (a : NumberField.RingOfIntegers F)
    (ha_ne : a ≠ 0)
    (f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ)
    (hf_prod : Ideal.span {a} = f.prod (fun q m => q.asIdeal ^ m))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
    Valued.v (algebraMap F (q.adicCompletion F) (a : F)) =
      WithZero.exp (-(f q : ℤ)) :=
by
  classical
  have h_val_adic : Valued.v (algebraMap F (q.adicCompletion F) (a : F)) =
      (IsDedekindDomain.HeightOneSpectrum.valuation F q) (a : F) :=
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' q (a : F)
  have h_val_int : (IsDedekindDomain.HeightOneSpectrum.valuation F q) (a : F) =
      q.intValuation a :=
    IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap q a
  let k : ℕ := (Associates.mk q.asIdeal).count (Associates.mk (Ideal.span {a})).factors
  have h_int : q.intValuation a = WithZero.exp (-(k : ℤ)) :=
    IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg q ha_ne
  have h_dvd_iff : ∀ n : ℕ, -(k : ℤ) ≤ -(n : ℤ) ↔ q.asIdeal ^ n ∣ Ideal.span {a} := by
    intro n
    rw [← WithZero.exp_le_exp, ← h_int]
    exact IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_dvd q a n
  have h_dvd_fq : q.asIdeal ^ (f q) ∣ Ideal.span {a} := by
    by_cases hq : q ∈ f.support
    · rw [hf_prod, Finsupp.prod]
      exact Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ (f q')) hq
    · have hfq0 : f q = 0 := Finsupp.notMem_support_iff.mp hq
      rw [hfq0, pow_zero]
      exact one_dvd _
  have h_le : f q ≤ k := by
    have h1 := (h_dvd_iff (f q)).mpr h_dvd_fq
    omega
  have h_erase : Ideal.span {a} =
      q.asIdeal ^ (f q) * ∏ q' ∈ f.support.erase q, q'.asIdeal ^ (f q') := by
    by_cases hq : q ∈ f.support
    · rw [hf_prod, Finsupp.prod]
      exact (Finset.mul_prod_erase f.support (fun q' => q'.asIdeal ^ (f q')) hq).symm
    · have hfq0 : f q = 0 := Finsupp.notMem_support_iff.mp hq
      rw [hf_prod, Finsupp.prod, hfq0, pow_zero, one_mul, Finset.erase_eq_of_notMem hq]
  have h_not_dvd_succ : ¬ (q.asIdeal ^ (f q + 1) ∣ Ideal.span {a}) := by
    intro h_dvd_succ
    have hq_ne_zero : (q.asIdeal : Ideal (NumberField.RingOfIntegers F)) ≠ 0 := by
      rw [Submodule.zero_eq_bot]
      exact q.ne_bot
    have hq_pow_ne_zero : (q.asIdeal : Ideal (NumberField.RingOfIntegers F)) ^ (f q) ≠ 0 :=
      pow_ne_zero (f q) hq_ne_zero
    rw [pow_succ, h_erase] at h_dvd_succ
    have h_dvd_rest : q.asIdeal ∣ ∏ q' ∈ f.support.erase q, q'.asIdeal ^ (f q') :=
      (mul_dvd_mul_iff_left hq_pow_ne_zero).mp h_dvd_succ
    rcases (Prime.dvd_finset_prod_iff q.prime _).mp h_dvd_rest with ⟨q', hq'_mem, h_dvd_pow⟩
    have h_dvd_q' : q.asIdeal ∣ q'.asIdeal := q.prime.dvd_of_dvd_pow h_dvd_pow
    have h_le_q' : q'.asIdeal ≤ q.asIdeal := Ideal.dvd_iff_le.mp h_dvd_q'
    have h_eq_ideal : q'.asIdeal = q.asIdeal :=
      q'.isMaximal.eq_of_le q.isMaximal.ne_top h_le_q'
    have h_eq : q' = q := IsDedekindDomain.HeightOneSpectrum.ext h_eq_ideal
    exact (Finset.ne_of_mem_erase hq'_mem) h_eq
  have h_lt : k < f q + 1 := by
    have h1 := (h_dvd_iff (f q + 1)).not.mpr h_not_dvd_succ
    omega
  have hk_eq : k = f q := by omega
  rw [h_val_adic, h_val_int, h_int, hk_eq]

theorem exists_ideal_pow_mem_of_eventually_nhds_one_adicCompletion {F : Type u} [Field F] [NumberField F] {α : Type*}
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))
    (ψ : q.adicCompletion F → α)
    (z₀ : α)
    (hψ : ∀ᶠ x : q.adicCompletion F in nhds 1, ψ x = z₀) :
    ∃ c : ℕ, ∀ a : NumberField.RingOfIntegers F,
      a - 1 ∈ q.asIdeal ^ c →
      ψ (algebraMap F (q.adicCompletion F) (a : F)) = z₀ :=
by
  rcases (Valued.mem_nhds (s := {x : q.adicCompletion F | ψ x = z₀}) (x := 1)).mp hψ with ⟨γ, hγ⟩
  let k : ℤ := WithZero.log (γ : WithZero (Multiplicative ℤ))
  have h_exp : WithZero.exp k = (γ : WithZero (Multiplicative ℤ)) :=
    WithZero.exp_log (Units.ne_zero γ)
  let c : ℕ := Int.toNat (-k) + 1
  have h_lt_k : -(c : ℤ) < k := by
    dsimp [c]
    omega
  have hc_lt : WithZero.exp (-(c : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
    rw [← h_exp, WithZero.exp_lt_exp]
    exact h_lt_k
  refine ⟨c, fun a ha => hγ ?_⟩
  change Valued.v (algebraMap F (q.adicCompletion F) (a : F) - 1) <
    (γ : WithZero (Multiplicative ℤ))
  have h_intVal : q.intValuation (a - 1) ≤ WithZero.exp (-(c : ℤ)) :=
    (q.intValuation_le_pow_iff_mem (a - 1) c).mpr ha
  have h_sub :
      algebraMap F (q.adicCompletion F) (a : F) - 1 =
        algebraMap F (q.adicCompletion F)
          (algebraMap (NumberField.RingOfIntegers F) F (a - 1)) := by
    rw [map_sub, map_one, ← map_one (algebraMap F (q.adicCompletion F)), ← map_sub]
  have h_val :
      Valued.v (algebraMap F (q.adicCompletion F) (a : F) - 1) =
        q.intValuation (a - 1) := by
    rw [h_sub]
    exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' q
      (algebraMap (NumberField.RingOfIntegers F) F (a - 1))).trans
      (q.valuation_of_algebraMap (a - 1))
  rw [h_val]
  exact lt_of_le_of_lt h_intVal hc_lt

theorem isSquare_algebraMap_infinitePlace_completion_of_pos_re {F : Type u} [Field F] [NumberField F]
    (a : NumberField.RingOfIntegers F)
    (ha_pos : ∀ w : NumberField.InfinitePlace F,
      w.IsReal → 0 < (w.embedding (a : F)).re)
    (w : NumberField.InfinitePlace F) :
    IsSquare (algebraMap F w.Completion (a : F)) :=
by
  let x : w.Completion := algebraMap F w.Completion (a : F)
  change IsSquare x
  rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
  · let e_R : w.Completion ≃+* ℝ := NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw
    have h_eq : e_R x = (w.embedding (a : F)).re :=
      NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw (a : F)
    have h_nonneg : 0 ≤ e_R x := by
      rw [h_eq]
      exact (ha_pos w hw).le
    have h_sqrt : Real.sqrt (e_R x) * Real.sqrt (e_R x) = e_R x :=
      Real.mul_self_sqrt h_nonneg
    refine ⟨e_R.symm (Real.sqrt (e_R x)), ?_⟩
    rw [← map_mul, h_sqrt, e_R.symm_apply_apply]
  · let e_C : w.Completion ≃+* ℂ := NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hw
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_eq_mul_self (e_C x)
    refine ⟨e_C.symm z, ?_⟩
    rw [← map_mul, ← hz, e_C.symm_apply_apply]

theorem exists_local_completion_symbols_of_narrow_ray_finsum_eq_zero {F : Type u} [Field F] [NumberField F]
    (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → Prop)
    (d : ℕ)
    (e c : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (h_ray : ∀ a : NumberField.RingOfIntegers F,
      a ≠ 0 →
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        ¬ P q → a - 1 ∈ q.asIdeal ^ (c q)) →
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a : F)).re) →
      (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) // P q },
        ((e q.1 * (-WithZero.log (q.1.intValuation a)).toNat : ℕ) : ZMod d)) = 0) :
    ∃ (ψ_fin : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        q.adicCompletion F → ZMod d)
      (ψ_inf : ∀ w : NumberField.InfinitePlace F,
        w.Completion → ZMod d),
      (∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
        P q →
        ∀ (x : q.adicCompletion F) (m : ℕ),
          Valued.v x = WithZero.exp (-(m : ℤ)) →
          ψ_fin q x = (e q * m : ZMod d)) ∧
      (∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
        ¬ P q →
        ∀ᶠ x : q.adicCompletion F in nhds 1, ψ_fin q x = 0) ∧
      (∀ (w : NumberField.InfinitePlace F) (x : w.Completion),
        IsSquare x → ψ_inf w x = 0) ∧
      (∀ (a : NumberField.RingOfIntegers F),
        a ≠ 0 →
        ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))),
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            Valued.v (algebraMap F (q.adicCompletion F) (a : F)) ≠ 1 →
            q ∈ S) →
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            ¬ P q → q ∈ S) →
          (∑ q ∈ S, ψ_fin q (algebraMap F (q.adicCompletion F) (a : F))) +
            (∑ w : NumberField.InfinitePlace F,
              ψ_inf w (algebraMap F w.Completion (a : F))) = 0) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  let ι_q : ∀ q : ι, R_F → q.adicCompletion F :=
    fun q a => algebraMap F (q.adicCompletion F) (a : F)
  let ι_w : ∀ w : NumberField.InfinitePlace F, R_F → w.Completion :=
    fun w a => algebraMap F w.Completion (a : F)
  have hι_q_inj : ∀ q : ι, Function.Injective (ι_q q) :=
    fun q => (RingHom.injective (algebraMap F (q.adicCompletion F))).comp Subtype.val_injective
  have hι_w_inj : ∀ w : NumberField.InfinitePlace F, Function.Injective (ι_w w) :=
    fun w => (RingHom.injective (algebraMap F w.Completion)).comp Subtype.val_injective
  have h_choose_q : ∀ (q : ι) (a : R_F) (hx : ∃ a' : R_F, ι_q q a' = ι_q q a),
      Classical.choose hx = a :=
    fun q a hx => hι_q_inj q (Classical.choose_spec hx)
  have h_choose_w : ∀ (w : NumberField.InfinitePlace F) (a : R_F)
      (hx : ∃ a' : R_F, ι_w w a' = ι_w w a), Classical.choose hx = a :=
    fun w a hx => hι_w_inj w (Classical.choose_spec hx)
  let Φ : R_F → ZMod d := fun a =>
    ∑ᶠ q : { q : ι // P q },
      ((e q.1 * (-WithZero.log (q.1.intValuation a)).toNat : ℕ) : ZMod d)
  let BadRam : R_F → Prop := fun a =>
    ∃ q : ι, ¬ P q ∧ a - 1 ∉ q.asIdeal ^ (c q)
  let BadInf : R_F → Prop := fun a =>
    ∃ w : NumberField.InfinitePlace F, ¬ IsSquare (ι_w w a)
  let ψ_fin_aux : ι → R_F → ZMod d := fun q b =>
    if h_br : BadRam b then
      if q = Classical.choose h_br then -Φ b else 0
    else 0
  let ψ_inf_aux : NumberField.InfinitePlace F → R_F → ZMod d := fun w b =>
    if ¬ BadRam b then
      if h_bi : BadInf b then
        if w = Classical.choose h_bi then -Φ b else 0
      else 0
    else 0
  let ψ_fin : ∀ q : ι, q.adicCompletion F → ZMod d := fun q x =>
    if P q then
      ((e q * (-WithZero.log (Valued.v x)).toNat : ℕ) : ZMod d)
    else if Valued.v (x - 1) ≤ WithZero.exp (-(c q : ℤ)) then
      0
    else if hx : ∃ a : R_F, ι_q q a = x then
      ψ_fin_aux q (Classical.choose hx)
    else 0
  let ψ_inf : ∀ w : NumberField.InfinitePlace F, w.Completion → ZMod d := fun w x =>
    if IsSquare x then
      0
    else if hx : ∃ a : R_F, ι_w w a = x then
      ψ_inf_aux w (Classical.choose hx)
    else 0
  have hψ_fin_ram : ∀ (q : ι), ¬ P q → ∀ (a : R_F),
      ψ_fin q (ι_q q a) =
        if Valued.v (ι_q q a - 1) ≤ WithZero.exp (-(c q : ℤ)) then 0 else ψ_fin_aux q a := by
    intro q hq a
    dsimp only [ψ_fin]
    rw [if_neg hq]
    by_cases h_le : Valued.v (ι_q q a - 1) ≤ WithZero.exp (-(c q : ℤ))
    · rw [if_pos h_le, if_pos h_le]
    · rw [if_neg h_le, if_neg h_le, dif_pos ⟨a, rfl⟩, h_choose_q q a]
  have hψ_inf_eval : ∀ (w : NumberField.InfinitePlace F) (a : R_F),
      ψ_inf w (ι_w w a) =
        if IsSquare (ι_w w a) then 0 else ψ_inf_aux w a := by
    intro w a
    dsimp only [ψ_inf]
    by_cases h_sq : IsSquare (ι_w w a)
    · rw [if_pos h_sq, if_pos h_sq]
    · rw [if_neg h_sq, if_neg h_sq, dif_pos ⟨a, rfl⟩, h_choose_w w a]
  have h_val : ∀ (q : ι) (r : R_F), Valued.v (ι_q q r) = q.intValuation r := by
    intro q r
    have h1 : Valued.v (ι_q q r) = q.valuation F (algebraMap R_F F r) :=
      IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' q (r : F)
    rw [h1, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
  have h_ball : ∀ (q : ι) (a : R_F),
      Valued.v (ι_q q a - 1) ≤ WithZero.exp (-(c q : ℤ)) ↔ a - 1 ∈ q.asIdeal ^ (c q) := by
    intro q a
    have h_sub : ι_q q a - 1 = ι_q q (a - 1) := by
      dsimp only [ι_q]
      push_cast
      rfl
    rw [h_sub, h_val q (a - 1),
      IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem]
  refine ⟨ψ_fin, ψ_inf, ?_, ?_, ?_, ?_⟩
  · intro q hq x m hv
    dsimp only [ψ_fin]
    rw [if_pos hq, hv, WithZero.log_exp, neg_neg, Int.toNat_natCast, Nat.cast_mul]
  · intro q hq
    let γ : (WithZero (Multiplicative ℤ))ˣ :=
      Units.mk0 (WithZero.exp (-(c q : ℤ))) WithZero.exp_ne_zero
    have h_nhds : { x : q.adicCompletion F | Valued.v (x - 1) < (γ : WithZero (Multiplicative ℤ)) } ∈
        nhds (1 : q.adicCompletion F) :=
      (Valued.mem_nhds (x := (1 : q.adicCompletion F))).mpr ⟨γ, Set.Subset.rfl⟩
    filter_upwards [h_nhds] with x hx
    have h_le : Valued.v (x - 1) ≤ WithZero.exp (-(c q : ℤ)) := le_of_lt hx
    dsimp only [ψ_fin]
    rw [if_neg hq, if_pos h_le]
  · intro w x hx
    dsimp only [ψ_inf]
    rw [if_pos hx]
  · intro a ha_ne S hS_val hS_ram
    change (∑ q ∈ S, ψ_fin q (ι_q q a)) + (∑ w : NumberField.InfinitePlace F, ψ_inf w (ι_w w a)) = 0
    have h_split :
        (∑ q ∈ S, ψ_fin q (ι_q q a)) =
          (∑ q ∈ S.filter P, ψ_fin q (ι_q q a)) +
            (∑ q ∈ S.filter (fun q => ¬ P q), ψ_fin q (ι_q q a)) :=
      (Finset.sum_filter_add_sum_filter_not S P (fun q => ψ_fin q (ι_q q a))).symm
    have h_sum_P : (∑ q ∈ S.filter P, ψ_fin q (ι_q q a)) = Φ a := by
      have h_congr :
          (∑ q ∈ S.filter P, ψ_fin q (ι_q q a)) =
            ∑ q ∈ S.filter P, ((e q * (-WithZero.log (q.intValuation a)).toNat : ℕ) : ZMod d) := by
        refine Finset.sum_congr rfl fun q hq => ?_
        have hPq : P q := (Finset.mem_filter.mp hq).2
        dsimp only [ψ_fin]
        rw [if_pos hPq, h_val q a]
      rw [h_congr, ← Finset.sum_subtype_eq_sum_filter]
      symm
      refine finsum_eq_sum_of_support_subset _ ?_
      intro q hq_supp
      rw [Function.mem_support] at hq_supp
      rw [Finset.mem_coe, Finset.mem_subtype]
      apply hS_val q.1
      rw [h_val q.1 a]
      intro h_eq_one
      apply hq_supp
      rw [h_eq_one, WithZero.log_one, neg_zero, Int.toNat_zero, mul_zero, Nat.cast_zero]
    rw [h_split, h_sum_P]
    by_cases h_br : BadRam a
    · let q₀ : ι := Classical.choose h_br
      have hq₀_spec : ¬ P q₀ ∧ a - 1 ∉ q₀.asIdeal ^ (c q₀) := Classical.choose_spec h_br
      have hq₀_mem : q₀ ∈ S.filter (fun q => ¬ P q) :=
        Finset.mem_filter.mpr ⟨hS_ram q₀ hq₀_spec.1, hq₀_spec.1⟩
      have h_sum_not_P :
          (∑ q ∈ S.filter (fun q => ¬ P q), ψ_fin q (ι_q q a)) = -Φ a := by
        rw [Finset.sum_eq_single q₀]
        · rw [hψ_fin_ram q₀ hq₀_spec.1 a]
          have h_not_le : ¬ Valued.v (ι_q q₀ a - 1) ≤ WithZero.exp (-(c q₀ : ℤ)) :=
            fun h_le => hq₀_spec.2 ((h_ball q₀ a).mp h_le)
          rw [if_neg h_not_le]
          dsimp only [ψ_fin_aux]
          rw [dif_pos h_br, if_pos rfl]
        · intro q hq hq_ne
          have hq_not_P : ¬ P q := (Finset.mem_filter.mp hq).2
          rw [hψ_fin_ram q hq_not_P a]
          split_ifs with h_le
          · rfl
          · dsimp only [ψ_fin_aux]
            rw [dif_pos h_br, if_neg hq_ne]
        · intro h_not_mem
          exact False.elim (h_not_mem hq₀_mem)
      have h_sum_inf : (∑ w : NumberField.InfinitePlace F, ψ_inf w (ι_w w a)) = 0 := by
        refine Finset.sum_eq_zero fun w _ => ?_
        rw [hψ_inf_eval w a]
        split_ifs with h_sq
        · rfl
        · dsimp only [ψ_inf_aux]
          rw [if_neg (not_not.mpr h_br)]
      rw [h_sum_not_P, h_sum_inf, add_neg_cancel, add_zero]
    · have h_sum_not_P :
          (∑ q ∈ S.filter (fun q => ¬ P q), ψ_fin q (ι_q q a)) = 0 := by
        refine Finset.sum_eq_zero fun q hq => ?_
        have hq_not_P : ¬ P q := (Finset.mem_filter.mp hq).2
        rw [hψ_fin_ram q hq_not_P a]
        have ha_mem : a - 1 ∈ q.asIdeal ^ (c q) := by
          by_contra h_not_mem
          exact h_br ⟨q, hq_not_P, h_not_mem⟩
        rw [if_pos ((h_ball q a).mpr ha_mem)]
      by_cases h_bi : BadInf a
      · let w₀ : NumberField.InfinitePlace F := Classical.choose h_bi
        have hw₀_spec : ¬ IsSquare (ι_w w₀ a) := Classical.choose_spec h_bi
        have h_sum_inf :
            (∑ w : NumberField.InfinitePlace F, ψ_inf w (ι_w w a)) = -Φ a := by
          rw [Finset.sum_eq_single w₀]
          · rw [hψ_inf_eval w₀ a, if_neg hw₀_spec]
            dsimp only [ψ_inf_aux]
            rw [if_pos h_br, dif_pos h_bi, if_pos rfl]
          · intro w _ hw_ne
            rw [hψ_inf_eval w a]
            split_ifs with h_sq
            · rfl
            · dsimp only [ψ_inf_aux]
              rw [if_pos h_br, dif_pos h_bi, if_neg hw_ne]
          · intro h_not_mem
            exact False.elim (h_not_mem (Finset.mem_univ w₀))
        rw [h_sum_not_P, h_sum_inf, add_zero, add_neg_cancel]
      · have h_sum_inf :
            (∑ w : NumberField.InfinitePlace F, ψ_inf w (ι_w w a)) = 0 := by
          refine Finset.sum_eq_zero fun w _ => ?_
          rw [hψ_inf_eval w a]
          have h_sq : IsSquare (ι_w w a) := by
            by_contra h_not_sq
            exact h_bi ⟨w, h_not_sq⟩
          rw [if_pos h_sq]
        have h_ram_all : ∀ q : ι, ¬ P q → a - 1 ∈ q.asIdeal ^ (c q) := by
          intro q hq_not_P
          by_contra h_not_mem
          exact h_br ⟨q, hq_not_P, h_not_mem⟩
        have h_pos_all : ∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re := by
          intro w hw
          have h_sq : IsSquare (ι_w w a) := by
            by_contra h_not_sq
            exact h_bi ⟨w, h_not_sq⟩
          rcases h_sq with ⟨y, hy⟩
          let e_R : w.Completion ≃+* ℝ :=
            NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw
          have h_coe : e_R (ι_w w a) = (w.embedding (a : F)).re :=
            NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw (a : F)
          have h_nonneg : 0 ≤ (w.embedding (a : F)).re := by
            rw [← h_coe, hy, map_mul]
            exact mul_self_nonneg (e_R y)
          have h_ne_zero : (w.embedding (a : F)).re ≠ 0 := by
            intro h_zero
            rw [← h_coe] at h_zero
            have h_a_zero : ι_w w a = ι_w w 0 := by
              apply e_R.injective
              rw [h_zero]
              dsimp only [ι_w]
              simp only [map_zero]
            exact ha_ne (hι_w_inj w h_a_zero)
          exact lt_of_le_of_ne h_nonneg h_ne_zero.symm
        have h_Φ_zero : Φ a = 0 := h_ray a ha_ne h_ram_all h_pos_all
        rw [h_Φ_zero, h_sum_not_P, h_sum_inf, add_zero, add_zero]

theorem unramified_frob_exponent_mul_inertiaDeg_eq_zero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_arith : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ Q : Ideal (NumberField.RingOfIntegers E),
        Q.IsPrime →
        Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal →
        IsArithFrobAt (NumberField.RingOfIntegers F) (σ ^ (e q)) Q)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))
    (hq : IsUnramifiedAtPrime F E q)
    (Q : Ideal (NumberField.RingOfIntegers E))
    (hQ_prime : Q.IsPrime)
    (hQ_under : Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal) :
    ((e q * (q.asIdeal.inertiaDeg Q) : ℕ) : ZMod (Module.finrank F E)) = 0 :=
by
  open scoped Pointwise in
  let R := NumberField.RingOfIntegers F
  let S := NumberField.RingOfIntegers E
  let G := E ≃ₐ[F] E
  let τ : G := σ ^ (e q)
  haveI : q.asIdeal.IsPrime := q.isPrime
  haveI : q.asIdeal.IsMaximal := q.isMaximal
  letI := Ideal.Quotient.field q.asIdeal
  letI : Fintype (R ⧸ q.asIdeal) := Fintype.ofFinite (R ⧸ q.asIdeal)
  haveI : PerfectField (R ⧸ q.asIdeal) := PerfectField.ofFinite
  haveI : Q.IsPrime := hQ_prime
  haveI : Q.LiesOver q.asIdeal := ⟨hQ_under.symm⟩
  haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q q.asIdeal
  letI := Ideal.Quotient.field Q
  haveI : Algebra.IsSeparable (R ⧸ q.asIdeal) (S ⧸ Q) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  have hQ_frob : IsArithFrobAt R τ Q := he_arith q hq Q hQ_prime hQ_under
  have hcomap : Ideal.comap (MulSemiringAction.toAlgHom R S τ) Q = Q :=
    AlgHom.IsArithFrobAt.comap_eq hQ_frob
  have hτ_inv_stab : τ⁻¹ ∈ MulAction.stabilizer G Q := by
    rw [MulAction.mem_stabilizer_iff]
    ext x
    rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, inv_inv]
    exact SetLike.ext_iff.mp hcomap x
  have hτ_stab : τ ∈ MulAction.stabilizer G Q := inv_mem_iff.mp hτ_inv_stab
  let φ := Ideal.Quotient.stabilizerHom Q q.asIdeal G
  have h_inertia_card : Nat.card ((Submodule.toAddSubgroup Q).inertia G) = 1 := by
    rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q,
        Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q G]
    exact hq Q hQ_prime hQ_under
  have h_inertia_bot : (Submodule.toAddSubgroup Q).inertia G = ⊥ :=
    Subgroup.card_eq_one.mp h_inertia_card
  have hφ_ker : φ.ker = ⊥ := by
    rw [Ideal.Quotient.ker_stabilizerHom Q q.asIdeal G, h_inertia_bot, Subgroup.bot_subgroupOf]
  have hφ_inj : Function.Injective φ := (MonoidHom.ker_eq_bot_iff φ).mp hφ_ker
  let τ_tilde : MulAction.stabilizer G Q := ⟨τ, hτ_stab⟩
  have hφ_τ : φ τ_tilde = FiniteField.frobeniusAlgEquivOfAlgebraic (R ⧸ q.asIdeal) (S ⧸ Q) := by
    ext x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.Quotient.stabilizerHom_apply]
    change Ideal.Quotient.mk Q ((MulSemiringAction.toAlgHom R S τ) y) = _
    rw [AlgHom.IsArithFrobAt.mk_apply hQ_frob y, hQ_under,
        FiniteField.frobeniusAlgEquivOfAlgebraic_apply, Fintype.card_eq_nat_card]
  have h_ord_τ : orderOf τ = q.asIdeal.inertiaDeg Q := by
    rw [← Subgroup.orderOf_mk τ hτ_stab, ← orderOf_injective φ hφ_inj τ_tilde,
        hφ_τ, FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic (R ⧸ q.asIdeal) (S ⧸ Q),
        ← Ideal.inertiaDeg_algebraMap q.asIdeal Q]
  have h_pow_one : σ ^ (e q * (q.asIdeal.inertiaDeg Q)) = 1 := by
    rw [pow_mul, ← h_ord_τ]
    exact pow_orderOf_eq_one τ
  have h_ord_σ : orderOf σ = Module.finrank F E := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hCyclic, IsGalois.card_aut_eq_finrank F E]
  have h_dvd : Module.finrank F E ∣ e q * (q.asIdeal.inertiaDeg Q) := by
    rw [← h_ord_σ]
    exact orderOf_dvd_iff_pow_eq_one.mpr h_pow_one
  exact (ZMod.natCast_eq_zero_iff (e q * (q.asIdeal.inertiaDeg Q)) (Module.finrank F E)).mpr h_dvd

theorem unramified_intNorm_finsum_eq_zero_of_inertiaDeg_mul_eq_zero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E]
    (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → Prop)
    (d : ℕ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (h_inertia : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      P q →
      ∀ Q : Ideal (NumberField.RingOfIntegers E),
        Q.IsPrime →
        Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal →
        ((e q * (q.asIdeal.inertiaDeg Q) : ℕ) : ZMod d) = 0)
    (b : NumberField.RingOfIntegers E)
    (hb_ne : b ≠ 0)
    (hb_unr : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b} →
      P q) :
    (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) // P q },
      ((e q.1 * (-WithZero.log (q.1.intValuation
        (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b))).toNat : ℕ) : ZMod d)) = 0 :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  refine finsum_eq_zero_of_forall_eq_zero fun ⟨q, hPq⟩ => ?_
  dsimp only
  let N_b : R_F := Algebra.intNorm R_F R_E b
  have hNb_ne : N_b ≠ 0 := Algebra.intNorm_ne_zero.mpr hb_ne
  have h_val : (-WithZero.log (q.intValuation N_b)).toNat =
      (Associates.mk q.asIdeal).count (Associates.mk (Ideal.span {N_b})).factors := by
    rw [IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg q hNb_ne,
      WithZero.log_exp, neg_neg, Int.toNat_natCast]
  have h_relNorm_b : Ideal.span {N_b} = Ideal.relNorm R_F (Ideal.span {b}) :=
    (Ideal.relNorm_singleton R_F b).symm
  have hIb_ne : Ideal.span {b} ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hb_ne
  let M : Multiset (Ideal R_E) := UniqueFactorizationMonoid.normalizedFactors (Ideal.span {b})
  have hM_prod : M.prod = Ideal.span {b} := prod_normalizedFactors_eq_self hIb_ne
  have hM_prime : ∀ Q ∈ M, Prime Q :=
    fun Q hQ => UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ
  change ((e q * (-WithZero.log (q.intValuation N_b)).toNat : ℕ) : ZMod d) = 0
  rw [h_val, h_relNorm_b, ← hM_prod]
  have hq_irr : Irreducible (Associates.mk q.asIdeal) :=
    IsDedekindDomain.HeightOneSpectrum.associates_irreducible q
  have h_single : ∀ Q : Ideal R_E, Prime Q →
      ((e q * (Associates.mk q.asIdeal).count
        (Associates.mk (Ideal.relNorm R_F Q)).factors : ℕ) : ZMod d) = 0 := by
    intro Q hQ_prime_elt
    have hQ_isPrime : Q.IsPrime := Ideal.isPrime_of_prime hQ_prime_elt
    have hQ_ne_bot : Q ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot]
      exact hQ_prime_elt.ne_zero
    haveI : Q.IsMaximal := Ideal.IsPrime.isMaximal hQ_isPrime hQ_ne_bot
    let p_Q : Ideal R_F := Ideal.under R_F Q
    haveI : Q.LiesOver p_Q := ⟨rfl⟩
    haveI : p_Q.IsMaximal := Ideal.IsMaximal.under R_F Q
    have hpQ_prime : p_Q.IsPrime := Ideal.IsMaximal.isPrime inferInstance
    have hpQ_ne_bot : p_Q ≠ ⊥ := Ideal.under_ne_bot R_F hQ_ne_bot
    have hpQ_ne_zero : p_Q ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have h_mk_pQ_ne : Associates.mk p_Q ≠ 0 := Associates.mk_ne_zero.mpr hpQ_ne_zero
    have h_rel_Q : Ideal.relNorm R_F Q = p_Q ^ (p_Q.inertiaDeg Q) :=
      Ideal.relNorm_eq_pow_of_isMaximal Q p_Q
    rw [h_rel_Q, Associates.mk_pow, Associates.count_pow h_mk_pQ_ne hq_irr]
    by_cases h_eq : p_Q = q.asIdeal
    · rw [h_eq, Associates.count_self hq_irr, mul_one]
      exact h_inertia q hPq Q hQ_isPrime h_eq
    · let q_Q : IsDedekindDomain.HeightOneSpectrum R_F := ⟨p_Q, hpQ_prime, hpQ_ne_bot⟩
      have hqQ_irr : Irreducible (Associates.mk p_Q) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q_Q
      have h_mk_ne : Associates.mk q.asIdeal ≠ Associates.mk p_Q := by
        intro h_mk_eq
        exact h_eq (Associates.mk_injective h_mk_eq).symm
      rw [Associates.count_eq_zero_of_ne hq_irr hqQ_irr h_mk_ne, mul_zero, mul_zero, Nat.cast_zero]
  have h_ind : ∀ (L : Multiset (Ideal R_E)), (∀ Q ∈ L, Prime Q) →
      ((e q * (Associates.mk q.asIdeal).count
        (Associates.mk (Ideal.relNorm R_F L.prod)).factors : ℕ) : ZMod d) = 0 := by
    intro L
    refine Multiset.induction_on L ?_ ?_
    · intro _
      rw [Multiset.prod_zero, map_one, Associates.mk_one, Associates.factors_one,
        Associates.count_zero hq_irr, mul_zero, Nat.cast_zero]
    · intro Q L' ih hL
      have hQ : Prime Q := hL Q (Multiset.mem_cons_self Q L')
      have hL' : ∀ P ∈ L', Prime P := fun P hP => hL P (Multiset.mem_cons_of_mem hP)
      have hQ_ne_bot : Q ≠ ⊥ := by
        rw [← Submodule.zero_eq_bot]
        exact hQ.ne_zero
      have hL'_ne_zero : L'.prod ≠ 0 := by
        apply Multiset.prod_ne_zero
        intro h0
        exact not_prime_zero (hL' 0 h0)
      have hL'_ne_bot : L'.prod ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
      have h_rel_Q_ne : Ideal.relNorm R_F Q ≠ 0 := by
        rw [Submodule.zero_eq_bot]
        exact (Ideal.relNorm_eq_bot_iff (R := R_F)).not.mpr hQ_ne_bot
      have h_rel_L'_ne : Ideal.relNorm R_F L'.prod ≠ 0 := by
        rw [Submodule.zero_eq_bot]
        exact (Ideal.relNorm_eq_bot_iff (R := R_F)).not.mpr hL'_ne_bot
      have h_mk_Q : Associates.mk (Ideal.relNorm R_F Q) ≠ 0 :=
        Associates.mk_ne_zero.mpr h_rel_Q_ne
      have h_mk_L' : Associates.mk (Ideal.relNorm R_F L'.prod) ≠ 0 :=
        Associates.mk_ne_zero.mpr h_rel_L'_ne
      rw [Multiset.prod_cons, map_mul, ← Associates.mk_mul_mk,
        Associates.count_mul h_mk_Q h_mk_L' hq_irr, Nat.mul_add, Nat.cast_add,
        h_single Q hQ, ih hL', add_zero]
  exact h_ind M hM_prime

theorem absNorm_span_singleton_eq_intNorm_and_pos_of_isReal_re_pos {F : Type u} [Field F] [NumberField F]
    (a : NumberField.RingOfIntegers F)
    (ha_ne : a ≠ 0)
    (ha_pos : ∀ w : NumberField.InfinitePlace F,
      w.IsReal → 0 < (w.embedding (a : F)).re) :
    0 < Algebra.intNorm ℤ (NumberField.RingOfIntegers F) a ∧
    (Ideal.absNorm (Ideal.span {a}) : ℤ) = Algebra.intNorm ℤ (NumberField.RingOfIntegers F) a :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let x : F := (a : F)
  have hx_ne : x ≠ 0 := by
    dsimp [x]
    exact NumberField.RingOfIntegers.coe_eq_zero_iff.not.mpr ha_ne
  have h_intNorm_eq : Algebra.intNorm ℤ R_F a = Algebra.norm ℤ a := by
    rw [Algebra.intNorm_eq_norm]
  have h_coe_norm : ((Algebra.intNorm ℤ R_F a : ℤ) : ℚ) = Algebra.norm ℚ x := by
    rw [h_intNorm_eq]
    exact Algebra.coe_norm_int a
  have h_prod_alg : (algebraMap ℚ ℂ) (Algebra.norm ℚ x) = ∏ σ : F →ₐ[ℚ] ℂ, σ x :=
    Algebra.norm_eq_prod_embeddings ℚ ℂ x
  have h_prod_ring : ((Algebra.norm ℚ x : ℚ) : ℂ) = ∏ φ : F →+* ℂ, φ x := by
    have h_reindex : (∏ φ : F →+* ℂ, (RingHom.equivRatAlgHom φ) x) = ∏ σ : F →ₐ[ℚ] ℂ, σ x :=
      Equiv.prod_comp RingHom.equivRatAlgHom (fun σ : F →ₐ[ℚ] ℂ => σ x)
    have h_apply : ∀ φ : F →+* ℂ, (RingHom.equivRatAlgHom φ) x = φ x := by
      intro φ
      rw [RingHom.equivRatAlgHom_apply, RingHom.toRatAlgHom_apply]
    simp_rw [h_apply] at h_reindex
    rw [h_reindex, ← h_prod_alg]
    rfl
  have hφ_ne : ∀ φ : F →+* ℂ, φ x ≠ 0 :=
    fun φ => (map_ne_zero φ).mpr hx_ne
  have h_norm_pos : ∀ φ : F →+* ℂ, 0 < ‖φ x‖ :=
    fun φ => norm_pos_iff.mpr (hφ_ne φ)
  have h_norm_c_ne : ∀ φ : F →+* ℂ, (‖φ x‖ : ℂ) ≠ 0 :=
    fun φ => Complex.ofReal_ne_zero.mpr (h_norm_pos φ).ne'
  let u : (F →+* ℂ) → ℂ := fun φ => φ x / (‖φ x‖ : ℂ)
  have h_factor : ∀ φ : F →+* ℂ, φ x = u φ * (‖φ x‖ : ℂ) := by
    intro φ
    dsimp [u]
    exact (div_mul_cancel₀ (φ x) (h_norm_c_ne φ)).symm
  have h_prod_factor :
      (∏ φ : F →+* ℂ, φ x) =
        (∏ φ : F →+* ℂ, u φ) * ((∏ φ : F →+* ℂ, ‖φ x‖ : ℝ) : ℂ) := by
    calc
      (∏ φ : F →+* ℂ, φ x) = ∏ φ : F →+* ℂ, (u φ * (‖φ x‖ : ℂ)) := by
        refine Finset.prod_congr rfl (fun φ _ => h_factor φ)
      _ = (∏ φ : F →+* ℂ, u φ) * (∏ φ : F →+* ℂ, (‖φ x‖ : ℂ)) := Finset.prod_mul_distrib
      _ = (∏ φ : F →+* ℂ, u φ) * ((∏ φ : F →+* ℂ, ‖φ x‖ : ℝ) : ℂ) := by
        rw [Complex.ofReal_prod]
  have hu_real : ∀ φ : F →+* ℂ, NumberField.ComplexEmbedding.IsReal φ → u φ = 1 := by
    intro φ hφ
    let w : NumberField.InfinitePlace F := NumberField.InfinitePlace.mk φ
    have hw : w.IsReal := NumberField.InfinitePlace.isReal_mk_iff.mpr hφ
    have hw_emb : w.embedding = φ := NumberField.InfinitePlace.embedding_mk_eq_of_isReal hφ
    have h_re_pos : 0 < (φ x).re := by
      have h1 := ha_pos w hw
      rwa [hw_emb] at h1
    have h_conj_φ : NumberField.ComplexEmbedding.conjugate φ = φ :=
      NumberField.ComplexEmbedding.isReal_iff.mp hφ
    have h_conj_x : (starRingEnd ℂ) (φ x) = φ x := by
      rw [← NumberField.ComplexEmbedding.conjugate_coe_eq φ x, h_conj_φ]
    have h_re_eq : ((φ x).re : ℂ) = φ x := Complex.conj_eq_iff_re.mp h_conj_x
    have h_norm_eq : ‖φ x‖ = (φ x).re := by
      calc ‖φ x‖ = ‖((φ x).re : ℂ)‖ := congrArg norm h_re_eq.symm
      _ = ‖(φ x).re‖ := Complex.norm_real (φ x).re
      _ = (φ x).re := Real.norm_of_nonneg h_re_pos.le
    dsimp [u]
    rw [h_norm_eq, h_re_eq]
    exact div_self (hφ_ne φ)
  have h_prod_u : (∏ φ : F →+* ℂ, u φ) = 1 := by
    refine Finset.prod_involution
      (fun (φ : F →+* ℂ) _ => NumberField.ComplexEmbedding.conjugate φ)
      ?_ ?_ ?_ ?_
    · intro φ _
      dsimp [u]
      rw [Complex.norm_conj (φ x), div_mul_div_comm, Complex.mul_conj' (φ x), ← sq]
      exact div_self (pow_ne_zero 2 (h_norm_c_ne φ))
    · intro φ _ hu_ne h_conj_eq
      exact hu_ne (hu_real φ (NumberField.ComplexEmbedding.isReal_iff.mpr h_conj_eq))
    · intro φ _
      exact Finset.mem_univ _
    · intro φ _
      exact NumberField.ComplexEmbedding.involutive_conjugate F φ
  have h_norm_c_eq :
      ((Algebra.norm ℚ x : ℚ) : ℂ) = ((∏ φ : F →+* ℂ, ‖φ x‖ : ℝ) : ℂ) := by
    rw [h_prod_ring, h_prod_factor, h_prod_u, one_mul]
  have h_norm_r_eq :
      (Algebra.norm ℚ x : ℝ) = ∏ φ : F →+* ℂ, ‖φ x‖ := by
    have h_re := congrArg Complex.re h_norm_c_eq
    simpa only [Complex.ratCast_re, Complex.ofReal_re] using h_re
  have h_prod_pos : 0 < ∏ φ : F →+* ℂ, ‖φ x‖ :=
    Finset.prod_pos (fun φ _ => h_norm_pos φ)
  have h_norm_r_pos : (0 : ℝ) < (Algebra.norm ℚ x : ℝ) := by
    rw [h_norm_r_eq]
    exact h_prod_pos
  have h_norm_q_pos : 0 < Algebra.norm ℚ x := by
    exact_mod_cast h_norm_r_pos
  have h_intNorm_q_pos : (0 : ℚ) < ((Algebra.intNorm ℤ R_F a : ℤ) : ℚ) := by
    rw [h_coe_norm]
    exact h_norm_q_pos
  have h_intNorm_pos : 0 < Algebra.intNorm ℤ R_F a := by
    exact_mod_cast h_intNorm_q_pos
  refine ⟨h_intNorm_pos, ?_⟩
  rw [Ideal.absNorm_span_singleton a, ← h_intNorm_eq]
  exact Int.natAbs_of_nonneg h_intNorm_pos.le

theorem intNorm_eq_one_in_zmod_and_absNorm_modEq_one_of_sub_one_mem_span_natCast {F : Type u} [Field F] [NumberField F]
    (m : ℕ) (a : NumberField.RingOfIntegers F)
    (ha_m : a - 1 ∈ Ideal.span {(m : NumberField.RingOfIntegers F)}) :
    ((Algebra.intNorm ℤ (NumberField.RingOfIntegers F) a : ℤ) : ZMod m) = 1 ∧
    ((Ideal.absNorm (Ideal.span {a}) : ℤ) = Algebra.intNorm ℤ (NumberField.RingOfIntegers F) a →
      Ideal.absNorm (Ideal.span {a}) ≡ 1 [MOD m]) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let ι_B := Module.Free.ChooseBasisIndex ℤ R_F
  let B : Module.Basis ι_B ℤ R_F := NumberField.RingOfIntegers.basis F
  let Φ : R_F →+* Matrix ι_B ι_B ℤ :=
    ((LinearMap.toMatrixAlgEquiv B).toAlgHom.comp (Algebra.lmul ℤ R_F)).toRingHom
  have hΦ_apply : ∀ x : R_F, Φ x = LinearMap.toMatrix B B (Algebra.lmul ℤ R_F x) := by
    intro x
    ext i j
    rfl
  have h_det : Algebra.intNorm ℤ R_F a = (Φ a).det := by
    rw [Algebra.intNorm_eq_norm ℤ R_F, Algebra.norm_apply ℤ a,
      ← LinearMap.det_toMatrix B (Algebra.lmul ℤ R_F a), hΦ_apply a]
  let π : ℤ →+* ZMod m := Int.castRingHom (ZMod m)
  let Ψ : R_F →+* Matrix ι_B ι_B (ZMod m) := (π.mapMatrix).comp Φ
  have h_zmod_det : ((Algebra.intNorm ℤ R_F a : ℤ) : ZMod m) = (Ψ a).det := by
    rw [h_det]
    change π ((Φ a).det) = (Ψ a).det
    exact RingHom.map_det π (Φ a)
  rcases Ideal.mem_span_singleton.mp ha_m with ⟨r, hr⟩
  have ha_eq : a = 1 + (m : R_F) * r := by
    rw [← hr, add_sub_cancel]
  have hm_mat : (m : Matrix ι_B ι_B (ZMod m)) = 0 := by
    ext i j
    rw [Matrix.natCast_apply, Matrix.zero_apply]
    split_ifs with hij
    · exact ZMod.natCast_self m
    · exact Nat.cast_zero
  have hΨ_a : Ψ a = 1 := by
    calc
      Ψ a = Ψ (1 + (m : R_F) * r) := by rw [← ha_eq]
      _ = 1 + (m : Matrix ι_B ι_B (ZMod m)) * Ψ r := by
        rw [map_add, map_one, map_mul, map_natCast]
      _ = 1 := by rw [hm_mat, zero_mul, add_zero]
  have h_first : ((Algebra.intNorm ℤ R_F a : ℤ) : ZMod m) = 1 := by
    rw [h_zmod_det, hΨ_a, Matrix.det_one]
  refine ⟨h_first, fun h_abs_eq => ?_⟩
  have h_cast := congrArg (Int.cast : ℤ → ZMod m) h_abs_eq
  rw [Int.cast_natCast, h_first, ← Nat.cast_one] at h_cast
  exact (ZMod.natCast_eq_natCast_iff (Ideal.absNorm (Ideal.span {a})) 1 m).mp h_cast

theorem unramified_frob_pow_finsum_smul_root_of_unity_eq_self {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → Prop)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_map : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      P q →
      ∀ x : NumberField.RingOfIntegers E,
        (σ ^ (e q)) • x - x ^ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ∈
          Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal)
    (m : ℕ) (hm : 1 ≤ m)
    (a : NumberField.RingOfIntegers F) (ha_ne : a ≠ 0)
    (ha_m : a - 1 ∈ Ideal.span {(m : NumberField.RingOfIntegers F)})
    (ha_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      ¬ P q → a - 1 ∈ q.asIdeal)
    (h_abs : Ideal.absNorm (Ideal.span {a}) ≡ 1 [MOD m])
    (ζ : NumberField.RingOfIntegers E) (hζ : ζ ^ m = 1) :
    (σ ^ (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) // P q },
      e q.1 * (-WithZero.log (q.1.intValuation a)).toNat)) • ζ = ζ :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  have h_single : ∀ (q : ι), P q → (m : R_F) ∉ q.asIdeal →
      ∀ (ξ : R_E), ξ ^ m = 1 →
      (σ ^ (e q)) • ξ = ξ ^ (Ideal.absNorm q.asIdeal) := by
    intro q hPq hm_not_mem ξ hξ
    have h_card_eq : Nat.card (R_F ⧸ q.asIdeal) = Ideal.absNorm q.asIdeal := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    let ξ₁ : R_E := (σ ^ (e q)) • ξ
    let ξ₂ : R_E := ξ ^ (Ideal.absNorm q.asIdeal)
    change ξ₁ = ξ₂
    let φ : R_E →+* R_E := MulSemiringAction.toRingHom (E ≃ₐ[F] E) R_E (σ ^ (e q))
    have hξ₁_pow : ξ₁ ^ m = 1 := by
      change (φ ξ) ^ m = 1
      rw [← map_pow φ ξ m, hξ, map_one]
    have hξ₂_pow : ξ₂ ^ m = 1 := by
      dsimp [ξ₂]
      rw [← pow_mul, mul_comm, pow_mul, hξ, one_pow]
    haveI : q.asIdeal.IsPrime := q.isPrime
    obtain ⟨⟨Q, hQ_prime, hQ_over⟩⟩ := Ideal.nonempty_primesOver (S := R_E) q.asIdeal
    haveI : Q.IsPrime := hQ_prime
    haveI : Q.LiesOver q.asIdeal := hQ_over
    have hQ_under : q.asIdeal = Ideal.under R_F Q :=
      Ideal.LiesOver.over (A := R_F) (P := Q) (p := q.asIdeal)
    have hIq_le_Q : Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ Q :=
      Ideal.map_le_iff_le_comap.mpr hQ_under.le
    have h_diff_mem : ξ₁ - ξ₂ ∈ Q := by
      have h_map := he_map q hPq ξ
      rw [h_card_eq] at h_map
      exact hIq_le_Q h_map
    let π_Q : R_E →+* R_E ⧸ Q := Ideal.Quotient.mk Q
    have h_eq_Q : π_Q ξ₁ = π_Q ξ₂ := Ideal.Quotient.eq.mpr h_diff_mem
    by_contra h_ne
    have h_sub_ne : ξ₁ - ξ₂ ≠ 0 := sub_ne_zero.mpr h_ne
    have h_geom : (∑ j ∈ Finset.range m, ξ₁ ^ j * ξ₂ ^ (m - 1 - j)) * (ξ₁ - ξ₂) = 0 := by
      rw [geom_sum₂_mul, hξ₁_pow, hξ₂_pow, sub_self]
    have h_sum_zero : (∑ j ∈ Finset.range m, ξ₁ ^ j * ξ₂ ^ (m - 1 - j)) = 0 :=
      (mul_eq_zero.mp h_geom).resolve_right h_sub_ne
    have h_quot_zero : π_Q (∑ j ∈ Finset.range m, ξ₁ ^ j * ξ₂ ^ (m - 1 - j)) * π_Q ξ₂ = 0 := by
      rw [h_sum_zero, map_zero, zero_mul]
    rw [map_sum, Finset.sum_mul] at h_quot_zero
    have h_term_one : ∀ j ∈ Finset.range m,
        π_Q (ξ₁ ^ j * ξ₂ ^ (m - 1 - j)) * π_Q ξ₂ = 1 := by
      intro j hj
      have hj_lt : j < m := Finset.mem_range.mp hj
      have hj_eq : j + (m - 1 - j) + 1 = m := by omega
      rw [map_mul, map_pow, map_pow, h_eq_Q, ← pow_add, ← pow_succ, hj_eq,
        ← map_pow, hξ₂_pow, map_one]
    rw [Finset.sum_congr rfl h_term_one, Finset.sum_const, Finset.card_range,
      nsmul_one, ← map_natCast π_Q m] at h_quot_zero
    have hm_mem_Q : (m : R_E) ∈ Q := Ideal.Quotient.eq_zero_iff_mem.mp h_quot_zero
    have hm_alg : algebraMap R_F R_E (m : R_F) ∈ Q := by
      rwa [map_natCast]
    have hm_mem_q : (m : R_F) ∈ q.asIdeal := by
      rw [hQ_under]
      exact hm_alg
    exact hm_not_mem hm_mem_q
  have h_prime_div : ∀ (p : Ideal R_F), Prime p → p ∣ Ideal.span {a} →
      ∃ q : ι, q.asIdeal = p ∧ P q ∧ (m : R_F) ∉ p := by
    intro p hp_prime hp_dvd
    have hp_isPrime : p.IsPrime := Ideal.isPrime_of_prime hp_prime
    have hp_ne_bot : p ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot]
      exact hp_prime.ne_zero
    let q_p : ι := ⟨p, hp_isPrime, hp_ne_bot⟩
    have ha_mem : a ∈ p := Ideal.dvd_span_singleton.mp hp_dvd
    have hP_qp : P q_p := by
      by_contra h_not_P
      have ha1_mem : a - 1 ∈ p := ha_ram q_p h_not_P
      have h1_mem : (1 : R_F) ∈ p := by
        have h_sub := p.sub_mem ha_mem ha1_mem
        rwa [sub_sub_cancel] at h_sub
      exact q_p.isMaximal.ne_top ((Ideal.eq_top_iff_one p).mpr h1_mem)
    have hm_not_p : (m : R_F) ∉ p := by
      intro hm_in
      have h_le : Ideal.span {(m : R_F)} ≤ p := (Ideal.span_singleton_le_iff_mem p).mpr hm_in
      have ha1_mem : a - 1 ∈ p := h_le ha_m
      have h1_mem : (1 : R_F) ∈ p := by
        have h_sub := p.sub_mem ha_mem ha1_mem
        rwa [sub_sub_cancel] at h_sub
      exact q_p.isMaximal.ne_top ((Ideal.eq_top_iff_one p).mpr h1_mem)
    exact ⟨q_p, rfl, hP_qp, hm_not_p⟩
  let E_P : Ideal R_F → ℕ := fun J =>
    ∑ᶠ q : { q : ι // P q },
      e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk J).factors
  have hE_span : E_P (Ideal.span {a}) =
      ∑ᶠ q : { q : ι // P q },
        e q.1 * (-WithZero.log (q.1.intValuation a)).toNat := by
    dsimp [E_P]
    refine finsum_congr fun q => ?_
    rw [IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg q.1 ha_ne,
      WithZero.log_exp, neg_neg, Int.toNat_natCast]
  have hE_one : E_P 1 = 0 := by
    dsimp [E_P]
    refine finsum_eq_zero_of_forall_eq_zero fun q => ?_
    have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
      IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
    rw [Associates.factors_one, Associates.count_zero hq_irr, mul_zero]
  have hE_prime : ∀ (p : Ideal R_F) (q_p : ι),
      q_p.asIdeal = p → P q_p → E_P p = e q_p := by
    intro p q_p hqp_eq hP_qp
    dsimp [E_P]
    let q_sub : { q : ι // P q } := ⟨q_p, hP_qp⟩
    have hqp_irr : Irreducible (Associates.mk q_p.asIdeal) :=
      IsDedekindDomain.HeightOneSpectrum.associates_irreducible q_p
    rw [finsum_eq_single _ q_sub]
    · dsimp [q_sub]
      rw [← hqp_eq, Associates.count_self hqp_irr, mul_one]
    · intro q hq_ne
      have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
      have h_ne_val : q.1 ≠ q_p := fun h_eq => hq_ne (Subtype.ext h_eq)
      have h_ne_ideal : q.1.asIdeal ≠ q_p.asIdeal :=
        fun h_eq => h_ne_val (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
      have h_ne_mk : Associates.mk q.1.asIdeal ≠ Associates.mk q_p.asIdeal :=
        fun h_eq => h_ne_ideal (Associates.mk_injective h_eq)
      rw [← hqp_eq, Associates.count_eq_zero_of_ne hq_irr hqp_irr h_ne_mk, mul_zero]
  have h_fin_supp : ∀ (J : Ideal R_F), J ≠ 0 →
      (Function.support (fun q : { q : ι // P q } =>
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk J).factors)).Finite := by
    intro J hJ_zero
    have hJ_ne_bot : J ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have h_fac_fin : { v : ι | v.asIdeal ∣ J }.Finite := Ideal.finite_factors hJ_ne_bot
    have h_sub_fin : (Subtype.val ⁻¹' { v : ι | v.asIdeal ∣ J } : Set { q : ι // P q }).Finite :=
      h_fac_fin.preimage Subtype.val_injective.injOn
    refine h_sub_fin.subset fun q hq => ?_
    rw [Function.mem_support] at hq
    have h_cnt_ne : (Associates.mk q.1.asIdeal).count (Associates.mk J).factors ≠ 0 :=
      right_ne_zero_of_mul hq
    exact (Associates.count_ne_zero_iff_dvd hJ_zero q.1.prime.irreducible).mp h_cnt_ne
  have hE_mul : ∀ (J₁ J₂ : Ideal R_F), J₁ ≠ 0 → J₂ ≠ 0 →
      E_P (J₁ * J₂) = E_P J₁ + E_P J₂ := by
    intro J₁ J₂ hJ₁ hJ₂
    dsimp [E_P]
    have h_mk₁ : Associates.mk J₁ ≠ 0 := Associates.mk_ne_zero.mpr hJ₁
    have h_mk₂ : Associates.mk J₂ ≠ 0 := Associates.mk_ne_zero.mpr hJ₂
    have h_term : ∀ q : { q : ι // P q },
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk (J₁ * J₂)).factors =
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk J₁).factors +
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk J₂).factors := by
      intro q
      have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
      rw [← Associates.mk_mul_mk, Associates.count_mul h_mk₁ h_mk₂ hq_irr, Nat.mul_add]
    simp_rw [h_term]
    exact finsum_add_distrib (h_fin_supp J₁ hJ₁) (h_fin_supp J₂ hJ₂)
  have h_ind : ∀ (L : Multiset (Ideal R_F)),
      (∀ p ∈ L, Prime p ∧ p ∣ Ideal.span {a}) →
      ∀ (ξ : R_E), ξ ^ m = 1 →
      (σ ^ (E_P L.prod)) • ξ = ξ ^ (Ideal.absNorm L.prod) := by
    intro L
    refine Multiset.induction_on L ?_ ?_
    · intro _ ξ _
      rw [Multiset.prod_zero, hE_one, pow_zero, one_smul, map_one, pow_one]
    · intro p L' ih hL ξ hξ
      obtain ⟨hp_prime, hp_dvd⟩ := hL p (Multiset.mem_cons_self p L')
      have hL' : ∀ p' ∈ L', Prime p' ∧ p' ∣ Ideal.span {a} :=
        fun p' hp' => hL p' (Multiset.mem_cons_of_mem hp')
      obtain ⟨q_p, hqp_eq, hP_qp, hm_not_p⟩ := h_prime_div p hp_prime hp_dvd
      have hp_zero : p ≠ 0 := hp_prime.ne_zero
      have hL'_zero : L'.prod ≠ 0 := by
        apply Multiset.prod_ne_zero
        intro h0
        exact not_prime_zero (hL' 0 h0).1
      rw [Multiset.prod_cons, hE_mul p L'.prod hp_zero hL'_zero,
        hE_prime p q_p hqp_eq hP_qp, pow_add, mul_smul, ih hL' ξ hξ]
      let ξ' : R_E := ξ ^ (Ideal.absNorm L'.prod)
      have hξ' : ξ' ^ m = 1 := by
        dsimp [ξ']
        rw [← pow_mul, mul_comm, pow_mul, hξ, one_pow]
      have hm_not_qp : (m : R_F) ∉ q_p.asIdeal := by rwa [hqp_eq]
      have h_step := h_single q_p hP_qp hm_not_qp ξ' hξ'
      rw [hqp_eq] at h_step
      change (σ ^ (e q_p)) • ξ' = ξ ^ (Ideal.absNorm (p * L'.prod))
      rw [h_step]
      dsimp [ξ']
      rw [← pow_mul, mul_comm (Ideal.absNorm L'.prod) (Ideal.absNorm p), ← map_mul]
  have hIa_ne : Ideal.span {a} ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr ha_ne
  let M : Multiset (Ideal R_F) := UniqueFactorizationMonoid.normalizedFactors (Ideal.span {a})
  have hM_prod : M.prod = Ideal.span {a} := prod_normalizedFactors_eq_self hIa_ne
  have hM_prop : ∀ p ∈ M, Prime p ∧ p ∣ Ideal.span {a} := by
    intro p hp
    exact ⟨UniqueFactorizationMonoid.prime_of_normalized_factor p hp,
      UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hp⟩
  have h_main : (σ ^ (∑ᶠ q : { q : ι // P q },
      e q.1 * (-WithZero.log (q.1.intValuation a)).toNat)) • ζ =
      ζ ^ (Ideal.absNorm (Ideal.span {a})) := by
    rw [← hE_span, ← hM_prod]
    exact h_ind M hM_prop ζ hζ
  have h_pow_mod : ∀ k : ℕ, ζ ^ k = ζ ^ (k % m) := by
    intro k
    conv_lhs => rw [← Nat.div_add_mod k m]
    rw [pow_add, pow_mul, hζ, one_pow, one_mul]
  have h_mod_eq : Ideal.absNorm (Ideal.span {a}) % m = 1 % m := h_abs
  rw [h_main, h_pow_mod (Ideal.absNorm (Ideal.span {a})), h_mod_eq, ← h_pow_mod 1, pow_one]

theorem exists_finite_narrow_ray_class_partition {F : Type u} [Field F] [NumberField F]
    (m : Ideal (NumberField.RingOfIntegers F))
    (hm : m ≠ ⊥) :
    ∃ (N_ray : ℕ) (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F)),
      (∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m) ∧
      (∀ I : Ideal (NumberField.RingOfIntegers F),
        I ≠ ⊥ → IsCoprime I m →
        ∃ j : Fin N_ray,
          ∃ a : NumberField.RingOfIntegers F,
            a - 1 ∈ m ∧
            (∀ w : NumberField.InfinitePlace F,
              w.IsReal → 0 < (w.embedding (a : F)).re) ∧
            I * J_all j = Ideal.span {a}) ∧
      (∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
        I ≠ ⊥ →
        (∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j₁ = Ideal.span {a}) →
        (∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j₂ = Ideal.span {a}) →
        j₁ = j₂) :=
by
  classical
  let R := NumberField.RingOfIntegers F
  
  have h_s1 : ∀ (I : Ideal R), I ≠ ⊥ → IsCoprime I m →
      ∃ (J : Ideal R) (a : R),
        J ≠ ⊥ ∧
        IsCoprime J m ∧
        a - 1 ∈ m ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J = Ideal.span {a} := by
    intro I hI hCop
    have h_sup : I ⊔ m = ⊤ := Ideal.isCoprime_iff_sup_eq.mp hCop
    have h_one : (1 : R) ∈ I ⊔ m := by
      rw [h_sup]
      exact Submodule.mem_top
    rcases Submodule.mem_sup.mp h_one with ⟨a₀, ha₀_I, y₀, hy₀_m, ha₀_y₀⟩
    have ha₀_m : a₀ - 1 ∈ m := by
      have h_eq : a₀ - 1 = -y₀ := by linear_combination ha₀_y₀
      rw [h_eq]
      exact m.neg_mem hy₀_m
    have hIm_ne : I * m ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot] at hI hm ⊢
      exact mul_ne_zero hI hm
    let M : ℕ := Ideal.absNorm (I * m)
    have hM_pos : 0 < M :=
      Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
        (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact hIm_ne))
    have hM_one_le : (1 : ℝ) ≤ (M : ℝ) := Nat.one_le_cast.mpr hM_pos
    have hM_mem : (M : R) ∈ I * m := Ideal.absNorm_mem (I * m)
    have hM_I : (M : R) ∈ I := Ideal.mul_le_right hM_mem
    have hM_m : (M : R) ∈ m := Ideal.mul_le_left hM_mem
    obtain ⟨t, ht⟩ := exists_nat_gt (∑ w : NumberField.InfinitePlace F, |(w.embedding (a₀ : F)).re|)
    let a : R := a₀ + (t : R) * (M : R)
    have ha_I : a ∈ I := I.add_mem ha₀_I (I.mul_mem_left (t : R) hM_I)
    have ha_m : a - 1 ∈ m := by
      have h_eq : a - 1 = (a₀ - 1) + (t : R) * (M : R) := by dsimp [a]; ring
      rw [h_eq]
      exact m.add_mem ha₀_m (m.mul_mem_left (t : R) hM_m)
    have ha_pos_all : ∀ w₀ : NumberField.InfinitePlace F, 0 < (w₀.embedding (a : F)).re := by
      intro w₀
      have h_le_sum : |(w₀.embedding (a₀ : F)).re| ≤
          ∑ w : NumberField.InfinitePlace F, |(w.embedding (a₀ : F)).re| :=
        Finset.single_le_sum (f := fun w : NumberField.InfinitePlace F => |(w.embedding (a₀ : F)).re|)
          (fun w _ => abs_nonneg _) (Finset.mem_univ w₀)
      have h_neg_le : -|(w₀.embedding (a₀ : F)).re| ≤ (w₀.embedding (a₀ : F)).re :=
        neg_abs_le _
      have ht_nonneg : (0 : ℝ) ≤ (t : ℝ) := Nat.cast_nonneg t
      have htM_ge : (t : ℝ) ≤ (t : ℝ) * (M : ℝ) := le_mul_of_one_le_right ht_nonneg hM_one_le
      have h_re_eq : (w₀.embedding (a : F)).re =
          (w₀.embedding (a₀ : F)).re + (t : ℝ) * (M : ℝ) := by
        change (w₀.embedding (algebraMap R F (a₀ + (t : R) * (M : R)))).re = _
        simp only [map_add, map_mul, map_natCast, Complex.add_re, Complex.mul_re,
          Complex.natCast_re, Complex.natCast_im, mul_zero, sub_zero]
        rfl
      linarith
    have ha_ne : a ≠ 0 := by
      intro ha0
      obtain ⟨w₀⟩ := (inferInstance : Nonempty (NumberField.InfinitePlace F))
      have h_pos := ha_pos_all w₀
      rw [ha0] at h_pos
      change 0 < (w₀.embedding (algebraMap R F 0)).re at h_pos
      simp only [map_zero, Complex.zero_re, lt_self_iff_false] at h_pos
    have h_span_le : Ideal.span {a} ≤ I := by
      rw [Ideal.span_singleton_le_iff_mem]
      exact ha_I
    obtain ⟨J, hIJ_eq⟩ := Ideal.dvd_iff_le.mpr h_span_le
    have hIJ : I * J = Ideal.span {a} := hIJ_eq.symm
    have hJ_ne : J ≠ ⊥ := by
      intro hJ0
      have h_span_bot : Ideal.span {a} = ⊥ := by
        rw [← hIJ, hJ0, Ideal.mul_bot]
      exact ha_ne (Ideal.span_singleton_eq_bot.mp h_span_bot)
    have h_cop_IJ : IsCoprime (I * J) m := by
      rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
      have ha_mem : a ∈ I * J := by
        rw [hIJ]
        exact Ideal.subset_span (Set.mem_singleton a)
      have h_neg : 1 - a ∈ m := by
        have h1 : -(a - 1) ∈ m := m.neg_mem ha_m
        have h2 : -(a - 1) = 1 - a := neg_sub a 1
        rwa [h2] at h1
      have h_sum : a + (1 - a) ∈ (I * J) ⊔ m := Submodule.add_mem_sup ha_mem h_neg
      have h_eq1 : a + (1 - a) = 1 := add_sub_cancel a 1
      rwa [h_eq1] at h_sum
    have hJ_cop : IsCoprime J m := IsCoprime.of_mul_left_right h_cop_IJ
    exact ⟨J, a, hJ_ne, hJ_cop, ha_m, fun w _ => ha_pos_all w, hIJ⟩
  
  have h_s2 : ∀ (K J₁ J₂ I : Ideal R),
      K ≠ ⊥ → J₁ ≠ ⊥ → J₂ ≠ ⊥ →
      ∀ (b₁ b₂ : R),
        K * J₁ = Ideal.span {b₁} →
        K * J₂ = Ideal.span {b₂} →
        IsCoprime (Ideal.span {b₁}) m →
        b₁ - b₂ ∈ m →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → (0 < (w.embedding (b₁ : F)).re ↔ 0 < (w.embedding (b₂ : F)).re)) →
        ∀ (a₁ : R),
          a₁ - 1 ∈ m →
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a₁ : F)).re) →
          I * J₁ = Ideal.span {a₁} →
          ∃ a₂ : R,
            a₂ - 1 ∈ m ∧
            (∀ w : NumberField.InfinitePlace F,
              w.IsReal → 0 < (w.embedding (a₂ : F)).re) ∧
            I * J₂ = Ideal.span {a₂} := by
    intro K J₁ J₂ I hK hJ₁ hJ₂ b₁ b₂ hKJ₁ hKJ₂ hb₁_cop hb_sub hb_sign a₁ ha₁_m ha₁_pos hIJ₁
    have hKJ₁_ne : K * J₁ ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot] at hK hJ₁ ⊢
      exact mul_ne_zero hK hJ₁
    have hb₁_span_ne : Ideal.span ({b₁} : Set R) ≠ ⊥ := by
      rw [← hKJ₁]
      exact hKJ₁_ne
    have hb₁_ne : b₁ ≠ 0 := by
      intro hb0
      apply hb₁_span_ne
      exact Ideal.span_singleton_eq_bot.mpr hb0
    have hKJ₂_ne : K * J₂ ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot] at hK hJ₂ ⊢
      exact mul_ne_zero hK hJ₂
    have hb₂_ne : b₂ ≠ 0 := by
      intro hb0
      apply hKJ₂_ne
      rw [hKJ₂, Ideal.span_singleton_eq_bot.mpr hb0]
    have h_ideal_eq1 : ((I * J₂) * Ideal.span {b₁}) * J₁ = Ideal.span {a₁ * b₂} * J₁ := by
      calc
        ((I * J₂) * Ideal.span {b₁}) * J₁
            = (I * J₂) * (K * J₁) * J₁ := by rw [hKJ₁]
        _ = (I * J₁) * (K * J₂) * J₁ := by ring
        _ = (Ideal.span {a₁} * Ideal.span {b₂}) * J₁ := by rw [hIJ₁, hKJ₂]
        _ = Ideal.span {a₁ * b₂} * J₁ := by rw [Ideal.span_singleton_mul_span_singleton]
    have hJ₁_ne_zero : J₁ ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have h_ideal_eq2 : (I * J₂) * Ideal.span {b₁} = Ideal.span {a₁ * b₂} :=
      mul_right_cancel₀ hJ₁_ne_zero h_ideal_eq1
    have h_le_span : Ideal.span {a₁ * b₂} ≤ Ideal.span {b₁} := by
      rw [← h_ideal_eq2]
      exact Ideal.mul_le_left
    have h_dvd : b₁ ∣ a₁ * b₂ := Ideal.span_singleton_le_span_singleton.mp h_le_span
    rcases h_dvd with ⟨a₂, ha₂_eq⟩
    have hb₁_span_ne_zero : Ideal.span ({b₁} : Set R) ≠ 0 := by
      rwa [Submodule.zero_eq_bot]
    have hIJ₂ : I * J₂ = Ideal.span {a₂} := by
      apply mul_right_cancel₀ hb₁_span_ne_zero
      rw [h_ideal_eq2, ha₂_eq, mul_comm b₁ a₂, ← Ideal.span_singleton_mul_span_singleton]
    have hb₁_a₂_m : b₁ * (a₂ - 1) ∈ m := by
      have h_ring : b₁ * (a₂ - 1) = (a₁ - 1) * b₂ - (b₁ - b₂) := by
        linear_combination -ha₂_eq
      rw [h_ring]
      exact m.sub_mem (m.mul_mem_right b₂ ha₁_m) hb_sub
    have h_sup : Ideal.span {b₁} ⊔ m = ⊤ := Ideal.isCoprime_iff_sup_eq.mp hb₁_cop
    have h_one : (1 : R) ∈ Ideal.span {b₁} ⊔ m := by
      rw [h_sup]
      exact Submodule.mem_top
    rcases Submodule.mem_sup.mp h_one with ⟨u, hu_b₁, v, hv_m, huv⟩
    rcases Ideal.mem_span_singleton'.mp hu_b₁ with ⟨r, rfl⟩
    have ha₂_m : a₂ - 1 ∈ m := by
      have h_ring : a₂ - 1 = r * (b₁ * (a₂ - 1)) + v * (a₂ - 1) := by
        linear_combination (a₂ - 1) * huv.symm
      rw [h_ring]
      exact m.add_mem (m.mul_mem_left r hb₁_a₂_m) (m.mul_mem_right (a₂ - 1) hv_m)
    have ha₂_pos : ∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a₂ : F)).re := by
      intro w hw
      let φ : F →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have hφ_re : ∀ x : F, (w.embedding x).re = φ x := by
        intro x
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw x, Complex.ofReal_re]
      have h_inj_R : Function.Injective (algebraMap R F) :=
        FaithfulSMul.algebraMap_injective R F
      have h_inj_φ : Function.Injective φ := φ.injective
      have hφ_b₁_ne : φ (b₁ : F) ≠ 0 := by
        intro h0
        rw [← map_zero φ] at h0
        have hb₁_F0 : (b₁ : F) = 0 := h_inj_φ h0
        rw [← map_zero (algebraMap R F)] at hb₁_F0
        exact hb₁_ne (h_inj_R hb₁_F0)
      have hφ_b₂_ne : φ (b₂ : F) ≠ 0 := by
        intro h0
        rw [← map_zero φ] at h0
        have hb₂_F0 : (b₂ : F) = 0 := h_inj_φ h0
        rw [← map_zero (algebraMap R F)] at hb₂_F0
        exact hb₂_ne (h_inj_R hb₂_F0)
      have h_sign_iff : 0 < φ (b₁ : F) ↔ 0 < φ (b₂ : F) := by
        rw [← hφ_re (b₁ : F), ← hφ_re (b₂ : F)]
        exact hb_sign w hw
      have h_prod_b_pos : 0 < φ (b₁ : F) * φ (b₂ : F) := by
        rcases lt_or_gt_of_ne hφ_b₁_ne with hb₁_neg | hb₁_pos
        · have hb₂_not_pos : ¬ (0 < φ (b₂ : F)) := by
            intro hb₂_pos
            have hb₁_pos : 0 < φ (b₁ : F) := h_sign_iff.mpr hb₂_pos
            linarith
          have hb₂_neg : φ (b₂ : F) < 0 :=
            lt_of_le_of_ne (not_lt.mp hb₂_not_pos) hφ_b₂_ne
          exact mul_pos_of_neg_of_neg hb₁_neg hb₂_neg
        · have hb₂_pos : 0 < φ (b₂ : F) := h_sign_iff.mp hb₁_pos
          exact mul_pos hb₁_pos hb₂_pos
      have hφ_a₁_pos : 0 < φ (a₁ : F) := by
        rw [← hφ_re (a₁ : F)]
        exact ha₁_pos w hw
      have h_eq_F : (a₁ : F) * (b₂ : F) = (b₁ : F) * (a₂ : F) := by
        exact_mod_cast ha₂_eq
      have h_eq_R : φ (a₁ : F) * φ (b₂ : F) = φ (b₁ : F) * φ (a₂ : F) := by
        simpa only [map_mul] using congrArg φ h_eq_F
      have h_sq_eq : (φ (b₁ : F) * φ (b₁ : F)) * φ (a₂ : F) =
          φ (a₁ : F) * (φ (b₁ : F) * φ (b₂ : F)) := by
        linear_combination φ (b₁ : F) * h_eq_R.symm
      have h_rhs_pos : 0 < φ (a₁ : F) * (φ (b₁ : F) * φ (b₂ : F)) :=
        mul_pos hφ_a₁_pos h_prod_b_pos
      have h_lhs_pos : 0 < (φ (b₁ : F) * φ (b₁ : F)) * φ (a₂ : F) := by
        rwa [h_sq_eq]
      have h_sq_nonneg : 0 ≤ φ (b₁ : F) * φ (b₁ : F) := mul_self_nonneg (φ (b₁ : F))
      have hφ_a₂_pos : 0 < φ (a₂ : F) := pos_of_mul_pos_right h_lhs_pos h_sq_nonneg
      rwa [hφ_re (a₂ : F)]
    exact ⟨a₂, ha₂_m, ha₂_pos, hIJ₂⟩
  
  let J_sub := { J : Ideal R // J ≠ ⊥ ∧ IsCoprime J m }
  let nzd : ∀ (J : Ideal R), J ≠ ⊥ → nonZeroDivisors (Ideal R) :=
    fun J hJ => ⟨J, mem_nonZeroDivisors_of_ne_zero (by rwa [Submodule.zero_eq_bot])⟩
  let cls : J_sub → ClassGroup R := fun u => ClassGroup.mk0 (nzd u.1 u.2.1)
  let C_range := Set.range cls
  let u_rep : C_range → J_sub := fun c => Classical.choose c.2
  have hu_rep : ∀ c : C_range, cls (u_rep c) = c.1 := fun c => Classical.choose_spec c.2
  have h_ex_K : ∀ c : C_range,
      ∃ (K : Ideal R) (a : R),
        K ≠ ⊥ ∧ IsCoprime K m ∧ K * (u_rep c).1 = Ideal.span {a} := by
    intro c
    obtain ⟨K, a, hK_ne, hK_cop, _, _, hIK⟩ :=
      h_s1 (u_rep c).1 (u_rep c).2.1 (u_rep c).2.2
    exact ⟨K, a, hK_ne, hK_cop, by rw [mul_comm, hIK]⟩
  choose K_rep a_rep hK_rep_ne hK_rep_cop hK_rep_span using h_ex_K
  let c_of : J_sub → C_range := fun u => ⟨cls u, ⟨u, rfl⟩⟩
  have h_ex_b : ∀ u : J_sub,
      ∃ b : R, K_rep (c_of u) * u.1 = Ideal.span {b} := by
    intro u
    let c := c_of u
    let k_nzd := nzd (K_rep c) (hK_rep_ne c)
    have h_rep_prin : (k_nzd * nzd (u_rep c).1 (u_rep c).2.1 : nonZeroDivisors (Ideal R)).1.IsPrincipal :=
      ⟨⟨a_rep c, hK_rep_span c⟩⟩
    have h_mk_rep_one : ClassGroup.mk0 (k_nzd * nzd (u_rep c).1 (u_rep c).2.1) = 1 :=
      (ClassGroup.mk0_eq_one_iff _).mpr h_rep_prin
    have h_mk_u_one : ClassGroup.mk0 (k_nzd * nzd u.1 u.2.1) = 1 := by
      rw [map_mul, show ClassGroup.mk0 (nzd u.1 u.2.1) = c.1 from rfl, ← hu_rep c,
        ← map_mul, h_mk_rep_one]
    have h_u_prin : (K_rep c * u.1).IsPrincipal :=
      (ClassGroup.mk0_eq_one_iff (k_nzd * nzd u.1 u.2.1).2).mp h_mk_u_one
    rcases h_u_prin with ⟨⟨b, hb⟩⟩
    exact ⟨b, hb⟩
  choose b_of hb_of_span using h_ex_b
  have hb_of_cop : ∀ u : J_sub, IsCoprime (Ideal.span {b_of u}) m := by
    intro u
    rw [← hb_of_span u]
    exact IsCoprime.mul_left (hK_rep_cop (c_of u)) u.2.2
  haveI : Finite (R ⧸ m) := Ideal.finiteQuotientOfFreeOfNeBot m hm
  let X := ClassGroup R × (R ⧸ m) × (NumberField.InfinitePlace F → Bool)
  haveI : Finite X := inferInstance
  let ψ : J_sub → X := fun u =>
    (cls u,
      Ideal.Quotient.mk m (b_of u),
      fun w => decide (0 < (w.embedding (b_of u : F)).re))
  haveI : Finite (Set.range ψ) := Subtype.finite
  letI : Fintype (Set.range ψ) := Fintype.ofFinite (Set.range ψ)
  let M_cand : ℕ := Fintype.card (Set.range ψ)
  let e_M : Fin M_cand ≃ Set.range ψ := (Fintype.equivFin (Set.range ψ)).symm
  let u_cand : Fin M_cand → J_sub := fun i => Classical.choose (e_M i).2
  have hu_cand_ψ : ∀ i : Fin M_cand, ψ (u_cand i) = (e_M i).1 :=
    fun i => Classical.choose_spec (e_M i).2
  let J_cand : Fin M_cand → Ideal R := fun i => (u_cand i).1
  have hJ_cand_prop : ∀ i : Fin M_cand, J_cand i ≠ ⊥ ∧ IsCoprime (J_cand i) m :=
    fun i => (u_cand i).2
  
  let InRayCell : Ideal R → Ideal R → Prop := fun I J₀ =>
    ∃ a : R,
      a - 1 ∈ m ∧
      (∀ w : NumberField.InfinitePlace F, w.IsReal → 0 < (w.embedding (a : F)).re) ∧
      I * J₀ = Ideal.span {a}
  have h_cand_cov : ∀ I : Ideal R, I ≠ ⊥ → IsCoprime I m →
      ∃ i : Fin M_cand, InRayCell I (J_cand i) := by
    intro I hI hCop
    obtain ⟨J, a₁, hJ_ne, hJ_cop, ha₁_m, ha₁_pos, hIJ⟩ := h_s1 I hI hCop
    let u : J_sub := ⟨J, hJ_ne, hJ_cop⟩
    let i : Fin M_cand := e_M.symm ⟨ψ u, ⟨u, rfl⟩⟩
    have hψ_eq : ψ u = ψ (u_cand i) := by
      rw [hu_cand_ψ i]
      exact (congrArg Subtype.val (e_M.apply_symm_apply ⟨ψ u, ⟨u, rfl⟩⟩)).symm
    have h_cls_eq : cls u = cls (u_cand i) := congrArg Prod.fst hψ_eq
    have hc_eq : c_of u = c_of (u_cand i) := Subtype.ext h_cls_eq
    have h_quot_eq : Ideal.Quotient.mk m (b_of u) = Ideal.Quotient.mk m (b_of (u_cand i)) :=
      congrArg (Prod.fst ∘ Prod.snd) hψ_eq
    have hb_sub : b_of u - b_of (u_cand i) ∈ m := Ideal.Quotient.eq.mp h_quot_eq
    have h_sign_fun := congrArg (Prod.snd ∘ Prod.snd) hψ_eq
    have hb_sign : ∀ w : NumberField.InfinitePlace F,
        w.IsReal → (0 < (w.embedding (b_of u : F)).re ↔ 0 < (w.embedding (b_of (u_cand i) : F)).re) := by
      intro w _
      have hw_eq := congrFun h_sign_fun w
      exact decide_eq_decide.mp hw_eq
    have hKJ_cand : K_rep (c_of u) * J_cand i = Ideal.span {b_of (u_cand i)} := by
      rw [hc_eq]
      exact hb_of_span (u_cand i)
    refine ⟨i, h_s2 (K_rep (c_of u)) J (J_cand i) I (hK_rep_ne (c_of u)) hJ_ne (hJ_cand_prop i).1
      (b_of u) (b_of (u_cand i)) (hb_of_span u) hKJ_cand (hb_of_cop u) hb_sub hb_sign
      a₁ ha₁_m ha₁_pos hIJ⟩
  have h_cell_trans : ∀ (J₁ J₂ I₀ I : Ideal R),
      J₁ ≠ ⊥ → J₂ ≠ ⊥ → I₀ ≠ ⊥ →
      InRayCell I₀ J₁ → InRayCell I₀ J₂ → InRayCell I J₁ → InRayCell I J₂ := by
    rintro J₁ J₂ I₀ I hJ₁ hJ₂ hI₀ ⟨b₁, hb₁_m, hb₁_pos, hI₀J₁⟩ ⟨b₂, hb₂_m, hb₂_pos, hI₀J₂⟩
      ⟨a₁, ha₁_m, ha₁_pos, hIJ₁⟩
    have hb₁_cop : IsCoprime (Ideal.span {b₁}) m := by
      rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
      have hb₁_mem : b₁ ∈ Ideal.span {b₁} := Ideal.subset_span (Set.mem_singleton b₁)
      have h_neg : 1 - b₁ ∈ m := by
        have h1 : -(b₁ - 1) ∈ m := m.neg_mem hb₁_m
        have h2 : -(b₁ - 1) = 1 - b₁ := neg_sub b₁ 1
        rwa [h2] at h1
      have h_sum : b₁ + (1 - b₁) ∈ Ideal.span {b₁} ⊔ m := Submodule.add_mem_sup hb₁_mem h_neg
      have h_eq1 : b₁ + (1 - b₁) = 1 := add_sub_cancel b₁ 1
      rwa [h_eq1] at h_sum
    have hb_sub : b₁ - b₂ ∈ m := by
      have h_eq : b₁ - b₂ = (b₁ - 1) - (b₂ - 1) := by ring
      rw [h_eq]
      exact m.sub_mem hb₁_m hb₂_m
    have hb_sign : ∀ w : NumberField.InfinitePlace F,
        w.IsReal → (0 < (w.embedding (b₁ : F)).re ↔ 0 < (w.embedding (b₂ : F)).re) :=
      fun w hw => ⟨fun _ => hb₂_pos w hw, fun _ => hb₁_pos w hw⟩
    exact h_s2 I₀ J₁ J₂ I hI₀ hJ₁ hJ₂ b₁ b₂ hI₀J₁ hI₀J₂ hb₁_cop hb_sub hb_sign a₁ ha₁_m ha₁_pos hIJ₁
  let g : Fin M_cand → Set (Ideal R) := fun i =>
    { I : Ideal R | I ≠ ⊥ ∧ InRayCell I (J_cand i) }
  haveI : Finite (Set.range g) := Set.Finite.to_subtype (Set.finite_range g)
  letI : Fintype (Set.range g) := Fintype.ofFinite (Set.range g)
  let N_ray : ℕ := Fintype.card (Set.range g)
  let e_ray : Fin N_ray ≃ Set.range g := (Fintype.equivFin (Set.range g)).symm
  let idx_all : Fin N_ray → Fin M_cand := fun j => Classical.choose (e_ray j).2
  have hidx_all : ∀ j : Fin N_ray, g (idx_all j) = (e_ray j).1 :=
    fun j => Classical.choose_spec (e_ray j).2
  let J_all : Fin N_ray → Ideal R := fun j => J_cand (idx_all j)
  refine ⟨N_ray, J_all, fun j => hJ_cand_prop (idx_all j), ?_, ?_⟩
  · intro I hI hCop
    obtain ⟨i, hi_cell⟩ := h_cand_cov I hI hCop
    let j : Fin N_ray := e_ray.symm ⟨g i, ⟨i, rfl⟩⟩
    have hg_eq : g (idx_all j) = g i := by
      rw [hidx_all j]
      exact congrArg Subtype.val (e_ray.apply_symm_apply ⟨g i, ⟨i, rfl⟩⟩)
    have hI_mem : I ∈ g i := ⟨hI, hi_cell⟩
    rw [← hg_eq] at hI_mem
    exact ⟨j, hI_mem.2⟩
  · intro I j₁ j₂ hI h₁ h₂
    have hg_eq : g (idx_all j₁) = g (idx_all j₂) := by
      ext I'
      constructor
      · rintro ⟨hI', h_cell'⟩
        exact ⟨hI', h_cell_trans (J_all j₁) (J_all j₂) I I'
          (hJ_cand_prop (idx_all j₁)).1 (hJ_cand_prop (idx_all j₂)).1 hI h₁ h₂ h_cell'⟩
      · rintro ⟨hI', h_cell'⟩
        exact ⟨hI', h_cell_trans (J_all j₂) (J_all j₁) I I'
          (hJ_cand_prop (idx_all j₂)).1 (hJ_cand_prop (idx_all j₁)).1 hI h₂ h₁ h_cell'⟩
    have he_eq : (e_ray j₁).1 = (e_ray j₂).1 := by
      rw [← hidx_all j₁, ← hidx_all j₂, hg_eq]
    exact e_ray.injective (Subtype.ext he_eq)

theorem narrow_ray_partition_card_le_mul_of_relNorm_coset_cover {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E]
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ j : Fin N_ray,
        ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j = Ideal.span {a})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₁ = Ideal.span {a}) →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₂ = Ideal.span {a}) →
      j₁ = j₂)
    (k : ℕ)
    (K : Fin k → Ideal (NumberField.RingOfIntegers F))
    (hK_cop : ∀ i : Fin k, K i ≠ ⊥ ∧ IsCoprime (K i) m₀)
    (h_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ i : Fin k,
        ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
          (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
          a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
          a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal →
            0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
          I * K i * Ideal.span {a₁} *
              Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
            Ideal.span {a₂} *
              Ideal.relNorm (NumberField.RingOfIntegers F) B₂) :
    0 < N_ray ∧
    N_ray ≤ k * Nat.card { j : Fin N_ray //
      ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
        (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all j * Ideal.span {a₁} *
            Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
          Ideal.span {a₂} *
            Ideal.relNorm (NumberField.RingOfIntegers F) B₂ } :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let InRayCell : Ideal R_F → Ideal R_F → Prop := fun I J =>
    ∃ a : R_F,
      a - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a : F)).re) ∧
      I * J = Ideal.span {a}
  let S_norm := { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
        Ideal.span {a₂} * Ideal.relNorm R_F B₂ }
  have h_top_cop : IsCoprime (⊤ : Ideal R_F) m₀ :=
    Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
  obtain ⟨j₀, _⟩ := hJ_cov ⊤ top_ne_bot h_top_cop
  have hN_pos : 0 < N_ray := Fin.pos j₀
  have h_cell_ne_zero : ∀ {I J : Ideal R_F} {a : R_F},
      I ≠ ⊥ → J ≠ ⊥ → I * J = Ideal.span {a} → a ≠ 0 := by
    intro I J a hI hJ hIJ ha0
    have hIJ_ne : I * J ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot] at hI hJ ⊢
      exact mul_ne_zero hI hJ
    apply hIJ_ne
    rw [hIJ, ha0, Ideal.span_singleton_eq_bot.mpr rfl]
  have h_ray_sub_one : ∀ {a b : R_F}, a - 1 ∈ m₀ → b - 1 ∈ m₀ → a * b - 1 ∈ m₀ := by
    intro a b ha hb
    have h_eq : a * b - 1 = (a - 1) * b + (b - 1) := by ring
    rw [h_eq]
    exact m₀.add_mem (m₀.mul_mem_right b ha) hb
  have h_ray_pos_mul : ∀ {a b : R_F} (w : NumberField.InfinitePlace F),
      w.IsReal →
      0 < (w.embedding (a : F)).re →
      0 < (w.embedding (b : F)).re →
      0 < (w.embedding ((a * b : R_F) : F)).re := by
    intro a b w hw ha hb
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (a : F),
        Complex.ofReal_re] at ha
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (b : F),
        Complex.ofReal_re] at hb
    change 0 < (w.embedding (algebraMap R_F F (a * b))).re
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (algebraMap R_F F (a * b)),
        Complex.ofReal_re, map_mul, map_mul]
    exact mul_pos ha hb
  have h_cov_J : ∀ j : Fin N_ray,
      ∃ i : Fin k,
        ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
          a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
          a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal →
            0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
          J_all j * K i * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
            Ideal.span {a₂} * Ideal.relNorm R_F B₂ :=
    fun j => h_cov (J_all j) (hJ_prop j).1 (hJ_prop j).2
  choose φ a₁_of a₂_of B₁_of B₂_of ha₁_ne ha₂_ne hB₁_ne hB₂_ne ha₁_m₀ ha₂_m₀ ha_pos h_rel_eq using h_cov_J
  have hJK_ne : ∀ j : Fin N_ray, J_all j * K (φ j) ≠ ⊥ := by
    intro j
    have h1 : J_all j ≠ ⊥ := (hJ_prop j).1
    have h2 : K (φ j) ≠ ⊥ := (hK_cop (φ j)).1
    change J_all j * K (φ j) ≠ ⊥
    rw [← Submodule.zero_eq_bot] at h1 h2 ⊢
    exact mul_ne_zero h1 h2
  have hJK_cop : ∀ j : Fin N_ray, IsCoprime (J_all j * K (φ j)) m₀ :=
    fun j => IsCoprime.mul_left (hJ_prop j).2 (hK_cop (φ j)).2
  have h_inv1 : ∀ j : Fin N_ray,
      ∃ u : Fin N_ray,
        ∃ d₁ : R_F,
          d₁ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (d₁ : F)).re) ∧
          (J_all j * K (φ j)) * J_all u = Ideal.span {d₁} :=
    fun j => hJ_cov (J_all j * K (φ j)) (hJK_ne j) (hJK_cop j)
  choose u d₁_of hd₁_m₀ hd₁_pos hd₁_eq using h_inv1
  have h_inv2 : ∀ j : Fin N_ray,
      ∃ t : Fin N_ray,
        ∃ d₂ : R_F,
          d₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (d₂ : F)).re) ∧
          J_all (u j) * J_all t = Ideal.span {d₂} :=
    fun j => hJ_cov (J_all (u j)) (hJ_prop (u j)).1 (hJ_prop (u j)).2
  choose t d₂_of hd₂_m₀ hd₂_pos hd₂_eq using h_inv2
  have ht_mem : ∀ j : Fin N_ray,
      ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all (t j) * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
          Ideal.span {a₂} * Ideal.relNorm R_F B₂ := by
    intro j
    have hd₁_ne : d₁_of j ≠ 0 :=
      h_cell_ne_zero (hJK_ne j) (hJ_prop (u j)).1 (hd₁_eq j)
    have hd₂_ne : d₂_of j ≠ 0 :=
      h_cell_ne_zero (hJ_prop (u j)).1 (hJ_prop (t j)).1 (hd₂_eq j)
    refine ⟨d₁_of j * a₁_of j, d₂_of j * a₂_of j, B₁_of j, B₂_of j,
      mul_ne_zero hd₁_ne (ha₁_ne j), mul_ne_zero hd₂_ne (ha₂_ne j),
      hB₁_ne j, hB₂_ne j,
      h_ray_sub_one (hd₁_m₀ j) (ha₁_m₀ j),
      h_ray_sub_one (hd₂_m₀ j) (ha₂_m₀ j),
      fun w hw => ⟨h_ray_pos_mul w hw (hd₁_pos j w hw) (ha_pos j w hw).1,
                   h_ray_pos_mul w hw (hd₂_pos j w hw) (ha_pos j w hw).2⟩,
      ?_⟩
    calc
      J_all (t j) * Ideal.span {d₁_of j * a₁_of j} * Ideal.relNorm R_F (B₁_of j)
          = J_all (t j) * (Ideal.span {d₁_of j} * Ideal.span {a₁_of j}) * Ideal.relNorm R_F (B₁_of j) := by
              rw [← Ideal.span_singleton_mul_span_singleton]
      _ = J_all (t j) * (((J_all j * K (φ j)) * J_all (u j)) * Ideal.span {a₁_of j}) * Ideal.relNorm R_F (B₁_of j) := by
              rw [← hd₁_eq j]
      _ = (J_all j * K (φ j) * Ideal.span {a₁_of j} * Ideal.relNorm R_F (B₁_of j)) * (J_all (u j) * J_all (t j)) := by
              ring
      _ = (Ideal.span {a₂_of j} * Ideal.relNorm R_F (B₂_of j)) * Ideal.span {d₂_of j} := by
              rw [h_rel_eq j, hd₂_eq j]
      _ = (Ideal.span {d₂_of j} * Ideal.span {a₂_of j}) * Ideal.relNorm R_F (B₂_of j) := by
              ring
      _ = Ideal.span {d₂_of j * a₂_of j} * Ideal.relNorm R_F (B₂_of j) := by
              rw [Ideal.span_singleton_mul_span_singleton]
  let Ψ : Fin N_ray → Fin k × S_norm := fun j => (φ j, ⟨t j, ht_mem j⟩)
  have hΨ_inj : Function.Injective Ψ := by
    intro j₁ j₂ hΨ
    have hφ_eq : φ j₁ = φ j₂ := congrArg Prod.fst hΨ
    have ht_eq : t j₁ = t j₂ := congrArg (Subtype.val ∘ Prod.snd) hΨ
    have h_u1 : InRayCell (J_all (t j₁)) (J_all (u j₁)) :=
      ⟨d₂_of j₁, hd₂_m₀ j₁, hd₂_pos j₁, by rw [mul_comm, hd₂_eq j₁]⟩
    have h_u2 : InRayCell (J_all (t j₁)) (J_all (u j₂)) :=
      ⟨d₂_of j₂, hd₂_m₀ j₂, hd₂_pos j₂, by rw [ht_eq, mul_comm, hd₂_eq j₂]⟩
    have hu_eq : u j₁ = u j₂ :=
      hJ_inj (J_all (t j₁)) (u j₁) (u j₂) (hJ_prop (t j₁)).1 h_u1 h_u2
    let I₀ : Ideal R_F := K (φ j₁) * J_all (u j₁)
    have hI₀_ne : I₀ ≠ ⊥ := by
      have h1 : K (φ j₁) ≠ ⊥ := (hK_cop (φ j₁)).1
      have h2 : J_all (u j₁) ≠ ⊥ := (hJ_prop (u j₁)).1
      change K (φ j₁) * J_all (u j₁) ≠ ⊥
      rw [← Submodule.zero_eq_bot] at h1 h2 ⊢
      exact mul_ne_zero h1 h2
    have h_j1 : InRayCell I₀ (J_all j₁) := by
      refine ⟨d₁_of j₁, hd₁_m₀ j₁, hd₁_pos j₁, ?_⟩
      have h_comm : I₀ * J_all j₁ = (J_all j₁ * K (φ j₁)) * J_all (u j₁) := by
        dsimp [I₀]
        ring
      rw [h_comm, hd₁_eq j₁]
    have h_j2 : InRayCell I₀ (J_all j₂) := by
      refine ⟨d₁_of j₂, hd₁_m₀ j₂, hd₁_pos j₂, ?_⟩
      have h_comm : I₀ * J_all j₂ = (J_all j₂ * K (φ j₂)) * J_all (u j₂) := by
        dsimp [I₀]
        rw [hφ_eq, hu_eq]
        ring
      rw [h_comm, hd₁_eq j₂]
    exact hJ_inj I₀ j₁ j₂ hI₀_ne h_j1 h_j2
  have h_card_le : Nat.card (Fin N_ray) ≤ Nat.card (Fin k × S_norm) :=
    Nat.card_le_card_of_injective Ψ hΨ_inj
  rw [Nat.card_fin, Nat.card_prod, Nat.card_fin] at h_card_le
  exact ⟨hN_pos, h_card_le⟩

theorem galois_fixed_units_and_intNorm_eq_prod_galRestrict_pow {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ) :
    Function.Injective (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)) ∧
    (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)).range =
      (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
        Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker ∧
    (∀ u : (NumberField.RingOfIntegers E)ˣ,
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (0 : ℕ))).toMonoidHom) u = u ∧
      (∀ k : ℕ,
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom) u) ∧
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom) u)) ∧
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (Nat.card (E ≃ₐ[F] E)))).toMonoidHom) u = u ∧
      (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
        NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E))
        ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))) u) =
        ∏ k : Fin (Nat.card (E ≃ₐ[F] E)),
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ))).toMonoidHom) u) ∧
    0 < Nat.card ((NumberField.RingOfIntegers F)ˣ ⧸
      (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).range) ∧
    (AddSubgroup.map (nsmulAddMonoidHom (Nat.card (E ≃ₐ[F] E)))
      (AddSubgroup.map (NumberField.Units.logEmbedding E)
        (Subgroup.toAddSubgroup
          (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
            Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))).relIndex
      (AddSubgroup.map (NumberField.Units.logEmbedding E)
        (Subgroup.toAddSubgroup
          (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
            Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker)) =
      (Nat.card (E ≃ₐ[F] E)) ^ (NumberField.Units.rank F) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let ι : R_Fˣ →* R_Eˣ := Units.map (algebraMap R_F R_E : R_F →* R_E)
  let φ_N : R_Eˣ →* R_Fˣ := Units.map (Algebra.intNorm R_F R_E)
  let φ_pow : ℕ → R_Eˣ →* R_Eˣ :=
    fun k => Units.map (galRestrict R_F F E R_E (σ ^ k)).toMonoidHom
  let φ_σ : R_Eˣ →* R_Eˣ := Units.map (galRestrict R_F F E R_E σ).toMonoidHom
  let D : R_Eˣ →* R_Eˣ := MonoidHom.id R_Eˣ / φ_σ
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  have h_alg_inj : Function.Injective (algebraMap R_F R_E) :=
    FaithfulSMul.algebraMap_injective R_F R_E
  have hι_inj : Function.Injective ι := by
    intro u₁ u₂ h
    exact Units.ext (h_alg_inj (congrArg Units.val h))
  have h_fixed_apply : ∀ v : R_Fˣ, φ_σ (ι v) = ι v := by
    intro v
    apply Units.ext
    exact (galRestrict R_F F E R_E σ).commutes v.val
  have h_fixed_elem : ∀ x : R_E, (galRestrict R_F F E R_E σ) x = x →
      ∃ y : R_F, algebraMap R_F R_E y = x := by
    intro x hx
    have hx_E : σ (algebraMap R_E E x) = algebraMap R_E E x := by
      rw [← algebraMap_galRestrict_apply R_F σ x, hx]
    have h_stab : σ ∈ MulAction.stabilizer (E ≃ₐ[F] E) (algebraMap R_E E x) := hx_E
    have h_all : ∀ ρ : E ≃ₐ[F] E, ρ (algebraMap R_E E x) = algebraMap R_E E x := by
      intro ρ
      exact (Subgroup.zpowers_le.mpr h_stab) (hCyclic ρ)
    have h_bot : algebraMap R_E E x ∈ (⊥ : IntermediateField F E) :=
      (IsGalois.mem_bot_iff_fixed (algebraMap R_E E x)).mpr h_all
    rcases IntermediateField.mem_bot.mp h_bot with ⟨y_F, hy_F⟩
    have hx_int : IsIntegral ℤ (algebraMap R_E E x) :=
      (IsIntegralClosure.isIntegral_iff (A := R_E) (R := ℤ) (B := E)).mpr ⟨x, rfl⟩
    rw [← hy_F] at hx_int
    have hy_int : IsIntegral ℤ y_F := by
      have h_tower : algebraMap F E y_F = (IsScalarTower.toAlgHom ℤ F E) y_F := rfl
      rw [h_tower] at hx_int
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom ℤ F E) (algebraMap F E).injective).mp hx_int
    rcases (IsIntegralClosure.isIntegral_iff (A := R_F) (R := ℤ) (B := F)).mp hy_int with ⟨y, hy⟩
    refine ⟨y, ?_⟩
    apply IsIntegralClosure.algebraMap_injective R_E R_F E
    rw [← IsScalarTower.algebraMap_apply R_F R_E E y, IsScalarTower.algebraMap_apply R_F F E y, hy, hy_F]
  have hι_range : ι.range = D.ker := by
    apply le_antisymm
    · rintro _ ⟨v, rfl⟩
      rw [MonoidHom.mem_ker]
      change (ι v) / φ_σ (ι v) = 1
      rw [h_fixed_apply v, div_self']
    · intro u hu
      rw [MonoidHom.mem_ker] at hu
      have hu_eq : φ_σ u = u := (div_eq_one.mp hu).symm
      have hu_val : (galRestrict R_F F E R_E σ) u.val = u.val := congrArg Units.val hu_eq
      have hu_inv_eq : φ_σ u⁻¹ = u⁻¹ := by rw [map_inv, hu_eq]
      have hu_inv_val : (galRestrict R_F F E R_E σ) (↑u⁻¹ : R_E) = (↑u⁻¹ : R_E) :=
        congrArg Units.val hu_inv_eq
      rcases h_fixed_elem u.val hu_val with ⟨y₁, hy₁⟩
      rcases h_fixed_elem (↑u⁻¹ : R_E) hu_inv_val with ⟨y₂, hy₂⟩
      have h12 : y₁ * y₂ = 1 := by
        apply h_alg_inj
        rw [map_mul, map_one, hy₁, hy₂, Units.mul_inv]
      have h21 : y₂ * y₁ = 1 := by
        apply h_alg_inj
        rw [map_mul, map_one, hy₁, hy₂, Units.inv_mul]
      let v : R_Fˣ := ⟨y₁, y₂, h12, h21⟩
      exact ⟨v, Units.ext hy₁⟩
  have h_order : orderOf σ = d := orderOf_eq_card_of_forall_mem_zpowers hCyclic
  have h_bij : Function.Bijective (fun k : Fin d => σ ^ (k : ℕ)) := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨?_, ?_⟩
    · intro k₁ k₂ hk
      have hk₁ : (k₁ : ℕ) < orderOf σ := by rw [h_order]; exact k₁.isLt
      have hk₂ : (k₂ : ℕ) < orderOf σ := by rw [h_order]; exact k₂.isLt
      exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ hk)
    · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card]
  let e_gal : Fin d ≃ (E ≃ₐ[F] E) := Equiv.ofBijective (fun k : Fin d => σ ^ (k : ℕ)) h_bij
  have h_gal : ∀ u : R_Eˣ,
      φ_pow 0 u = u ∧
      (∀ k : ℕ,
        φ_pow (k + 1) u = φ_pow k (φ_σ u) ∧
        φ_pow (k + 1) u = φ_σ (φ_pow k u)) ∧
      φ_pow d u = u ∧
      ι (φ_N u) = ∏ k : Fin d, φ_pow (k : ℕ) u := by
    intro u
    refine ⟨?_, ?_, ?_, ?_⟩
    · apply Units.ext
      change (galRestrict R_F F E R_E (σ ^ (0 : ℕ))) u.val = u.val
      rw [pow_zero, map_one, AlgEquiv.one_apply]
    · intro k
      constructor
      · apply Units.ext
        change (galRestrict R_F F E R_E (σ ^ (k + 1))) u.val =
          (galRestrict R_F F E R_E (σ ^ k)) ((galRestrict R_F F E R_E σ) u.val)
        rw [pow_succ, map_mul, AlgEquiv.mul_apply]
      · apply Units.ext
        change (galRestrict R_F F E R_E (σ ^ (k + 1))) u.val =
          (galRestrict R_F F E R_E σ) ((galRestrict R_F F E R_E (σ ^ k)) u.val)
        rw [pow_succ', map_mul, AlgEquiv.mul_apply]
    · apply Units.ext
      change (galRestrict R_F F E R_E (σ ^ d)) u.val = u.val
      have h_pow_d : σ ^ d = 1 := by
        dsimp [d]
        rw [Nat.card_eq_fintype_card, pow_card_eq_one]
      rw [h_pow_d, map_one, AlgEquiv.one_apply]
    · apply Units.ext
      have h_val_prod : (↑(∏ k : Fin d, φ_pow (k : ℕ) u) : R_E) =
          ∏ k : Fin d, (galRestrict R_F F E R_E (σ ^ (k : ℕ))) u.val := by
        exact map_prod (Units.coeHom R_E) (fun k : Fin d => φ_pow (k : ℕ) u) Finset.univ
      rw [h_val_prod]
      change algebraMap R_F R_E (Algebra.intNorm R_F R_E u.val) =
        ∏ k : Fin d, (galRestrict R_F F E R_E (σ ^ (k : ℕ))) u.val
      apply IsIntegralClosure.algebraMap_injective R_E R_F E
      rw [← IsScalarTower.algebraMap_apply R_F R_E E, IsScalarTower.algebraMap_apply R_F F E,
        Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E),
        Algebra.norm_eq_prod_automorphisms, map_prod]
      conv_lhs => rw [← Equiv.prod_comp e_gal (fun ρ : E ≃ₐ[F] E => ρ (algebraMap R_E E u.val))]
      refine Finset.prod_congr rfl fun k _ => ?_
      exact (algebraMap_galRestrict_apply R_F (σ ^ (k : ℕ)) u.val).symm
  have h_norm_pow_mem : ∀ v : R_Fˣ, v ^ d ∈ φ_N.range := by
    intro v
    have h_pow_fix : ∀ k : ℕ, φ_pow k (ι v) = ι v := by
      intro k
      induction k with
      | zero => exact (h_gal (ι v)).1
      | succ k ih =>
        rw [((h_gal (ι v)).2.1 k).2, ih, h_fixed_apply v]
    have h_norm_v : ι (φ_N (ι v)) = ι (v ^ d) := by
      rw [(h_gal (ι v)).2.2.2]
      have h_prod_const : (∏ k : Fin d, φ_pow (k : ℕ) (ι v)) = ∏ _k : Fin d, ι v :=
        Finset.prod_congr rfl fun k _ => h_pow_fix (k : ℕ)
      rw [h_prod_const, Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← map_pow]
    exact ⟨ι v, hι_inj h_norm_v⟩
  let ℓ_E := NumberField.Units.logEmbedding E
  let Λ_pos : AddSubgroup (NumberField.Units.dirichletUnitTheorem.logSpace E) :=
    AddSubgroup.map ℓ_E (Subgroup.toAddSubgroup D.ker)
  have h_log_iota_eq_zero : ∀ v : R_Fˣ,
      ℓ_E (Additive.ofMul (ι v)) = 0 ↔ v ∈ NumberField.Units.torsion F := by
    intro v
    rw [NumberField.Units.dirichletUnitTheorem.logEmbedding_eq_zero_iff,
      NumberField.Units.mem_torsion, NumberField.Units.mem_torsion]
    have h_eq : ∀ w_E : NumberField.InfinitePlace E,
        w_E (algebraMap R_E E ((ι v : R_Eˣ) : R_E)) =
          (w_E.comap (algebraMap F E)) (algebraMap R_F F (v : R_F)) := by
      intro w_E
      change w_E (algebraMap R_E E (algebraMap R_F R_E (v : R_F))) =
        (w_E.comap (algebraMap F E)) (algebraMap R_F F (v : R_F))
      rw [← IsScalarTower.algebraMap_apply R_F R_E E (v : R_F),
        IsScalarTower.algebraMap_apply R_F F E (v : R_F),
        NumberField.InfinitePlace.comap_apply]
    constructor
    · intro hE w
      obtain ⟨w_E, rfl⟩ := NumberField.InfinitePlace.comap_surjective (k := F) (K := E) w
      rw [← h_eq w_E]
      exact hE w_E
    · intro hF w_E
      rw [h_eq w_E]
      exact hF (w_E.comap (algebraMap F E))
  let r_F : ℕ := NumberField.Units.rank F
  let ε : Fin r_F → R_Fˣ := NumberField.Units.fundSystem F
  let u_free : (Fin r_F → ℤ) → R_Fˣ := fun g => ∏ i : Fin r_F, (ε i) ^ (g i)
  have hu_free_zero : u_free 0 = 1 := by
    dsimp [u_free]
    simp
  have hu_free_add : ∀ g₁ g₂ : Fin r_F → ℤ, u_free (g₁ + g₂) = u_free g₁ * u_free g₂ := by
    intro g₁ g₂
    dsimp [u_free]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun i _ => ?_
    exact zpow_add (ε i) (g₁ i) (g₂ i)
  let f : (Fin r_F → ℤ) →+ NumberField.Units.dirichletUnitTheorem.logSpace E :=
    { toFun := fun g => ℓ_E (Additive.ofMul (ι (u_free g)))
      map_zero' := by rw [hu_free_zero, map_one, ofMul_one, map_zero]
      map_add' := fun g₁ g₂ => by
        rw [hu_free_add, map_mul, ofMul_mul, map_add] }
  have hf_range : f.range = Λ_pos := by
    apply le_antisymm
    · rintro _ ⟨g, rfl⟩
      refine ⟨Additive.ofMul (ι (u_free g)), ?_, rfl⟩
      change ι (u_free g) ∈ D.ker
      rw [← hι_range]
      exact ⟨u_free g, rfl⟩
    · rintro y ⟨u, hu_ker, rfl⟩
      change Additive.toMul u ∈ D.ker at hu_ker
      rw [← hι_range] at hu_ker
      rcases hu_ker with ⟨x, hx⟩
      obtain ⟨⟨ζ, g⟩, h_eq, _⟩ := NumberField.Units.exist_unique_eq_mul_prod F x
      dsimp at h_eq
      refine ⟨g, ?_⟩
      change ℓ_E (Additive.ofMul (ι (u_free g))) = ℓ_E u
      have hu_eq : u = Additive.ofMul (ι x) := by
        rw [hx, ofMul_toMul]
      rw [hu_eq, h_eq, map_mul, ofMul_mul, map_add]
      have h_tors : ℓ_E (Additive.ofMul (ι (ζ : R_Fˣ))) = 0 :=
        (h_log_iota_eq_zero (ζ : R_Fˣ)).mpr ζ.2
      change ℓ_E (Additive.ofMul (ι (u_free g))) =
        ℓ_E (Additive.ofMul (ι (ζ : R_Fˣ))) + ℓ_E (Additive.ofMul (ι (u_free g)))
      rw [h_tors, zero_add]
  have hf_inj : Function.Injective f := by
    intro g₁ g₂ h_fg
    have hg : f (g₁ - g₂) = 0 := by rw [map_sub, h_fg, sub_self]
    have h_tors : u_free (g₁ - g₂) ∈ NumberField.Units.torsion F :=
      (h_log_iota_eq_zero (u_free (g₁ - g₂))).mp hg
    let ζ_g : NumberField.Units.torsion F := ⟨u_free (g₁ - g₂), h_tors⟩
    let ζ_1 : NumberField.Units.torsion F := 1
    have h1 : u_free (g₁ - g₂) = (ζ_1 : R_Fˣ) * ∏ i, (ε i) ^ ((g₁ - g₂) i) := by
      change u_free (g₁ - g₂) = 1 * u_free (g₁ - g₂)
      rw [one_mul]
    have h2 : u_free (g₁ - g₂) = (ζ_g : R_Fˣ) * ∏ i, (ε i) ^ ((0 : Fin r_F → ℤ) i) := by
      change u_free (g₁ - g₂) = u_free (g₁ - g₂) * u_free 0
      rw [hu_free_zero, mul_one]
    have h_pair : (ζ_1, g₁ - g₂) = (ζ_g, 0) :=
      (NumberField.Units.exist_unique_eq_mul_prod F (u_free (g₁ - g₂))).unique h1 h2
    exact sub_eq_zero.mp (congrArg Prod.snd h_pair)
  have hd_pos : 0 < d := Nat.card_pos
  have hd_int_pos : (0 : ℤ) < (d : ℤ) := Nat.cast_pos.mpr hd_pos
  have hQcoker_pos : 0 < Nat.card (R_Fˣ ⧸ φ_N.range) := by
    let Φ : NumberField.Units.torsion F × (Fin r_F → Fin d) → R_Fˣ ⧸ φ_N.range :=
      fun p => QuotientGroup.mk ((p.1 : R_Fˣ) * ∏ i : Fin r_F, (ε i) ^ ((p.2 i : ℕ) : ℤ))
    have hΦ_surj : Function.Surjective Φ := by
      intro q
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨⟨ζ, g⟩, hx_eq, _⟩ := NumberField.Units.exist_unique_eq_mul_prod F x
      dsimp at hx_eq
      let r : Fin r_F → Fin d := fun i =>
        ⟨(g i % (d : ℤ)).toNat, by
          have h_nonneg : 0 ≤ g i % (d : ℤ) := Int.emod_nonneg (g i) hd_int_pos.ne'
          have h_lt : g i % (d : ℤ) < (d : ℤ) := Int.emod_lt_of_pos (g i) hd_int_pos
          zify
          rw [Int.toNat_of_nonneg h_nonneg]
          exact h_lt⟩
      let q_div : Fin r_F → ℤ := fun i => g i / (d : ℤ)
      refine ⟨(ζ, r), ?_⟩
      apply QuotientGroup.eq.mpr
      have h_decomp : ∀ i : Fin r_F,
          (ε i) ^ (g i) = (ε i) ^ ((r i : ℕ) : ℤ) * ((ε i) ^ (q_div i)) ^ d := by
        intro i
        have h_ri : ((r i : ℕ) : ℤ) = g i % (d : ℤ) :=
          Int.toNat_of_nonneg (Int.emod_nonneg (g i) hd_int_pos.ne')
        have h_gi : g i = ((r i : ℕ) : ℤ) + q_div i * (d : ℤ) := by
          have h_div := Int.mul_ediv_add_emod (g i) (d : ℤ)
          dsimp [q_div]
          linarith
        rw [h_gi, zpow_add, zpow_mul, zpow_natCast ((ε i) ^ (q_div i)) d]
      have h_prod_decomp : (∏ i : Fin r_F, (ε i) ^ (g i)) =
          (∏ i : Fin r_F, (ε i) ^ ((r i : ℕ) : ℤ)) * (∏ i : Fin r_F, (ε i) ^ (q_div i)) ^ d := by
        rw [← Finset.prod_pow, ← Finset.prod_mul_distrib]
        exact Finset.prod_congr rfl fun i _ => h_decomp i
      let w : R_Fˣ := ∏ i : Fin r_F, (ε i) ^ (q_div i)
      have hx_w : x = ((ζ : R_Fˣ) * ∏ i : Fin r_F, (ε i) ^ ((r i : ℕ) : ℤ)) * w ^ d := by
        rw [hx_eq, h_prod_decomp, mul_assoc]
      change ((ζ : R_Fˣ) * ∏ i : Fin r_F, (ε i) ^ ((r i : ℕ) : ℤ))⁻¹ * x ∈ φ_N.range
      rw [hx_w, inv_mul_cancel_left]
      exact h_norm_pow_mem w
    haveI : Finite (R_Fˣ ⧸ φ_N.range) := Finite.of_surjective Φ hΦ_surj
    exact Nat.card_pos
  have hI_pos : (AddSubgroup.map (nsmulAddMonoidHom d) Λ_pos).relIndex Λ_pos = d ^ r_F := by
    let H := AddSubgroup.map (nsmulAddMonoidHom d) Λ_pos
    have h_rel : H.relIndex Λ_pos = (AddSubgroup.comap f H).index := by
      rw [← hf_range, ← AddSubgroup.index_comap H f]
    rw [h_rel]
    let π_d : (Fin r_F → ℤ) →+ (Fin r_F → ZMod d) :=
      { toFun := fun g i => (g i : ZMod d)
        map_zero' := by ext i; simp
        map_add' := fun g₁ g₂ => by ext i; simp }
    have hπ_surj : Function.Surjective π_d := by
      intro c
      refine ⟨fun i => (ZMod.intCast_surjective (c i)).choose, ?_⟩
      ext i
      exact (ZMod.intCast_surjective (c i)).choose_spec
    have h_comap_eq : AddSubgroup.comap f H = π_d.ker := by
      ext g
      rw [AddSubgroup.mem_comap, AddMonoidHom.mem_ker]
      constructor
      · intro hg
        rcases hg with ⟨y, hy_mem, hy_eq⟩
        rw [← hf_range] at hy_mem
        rcases hy_mem with ⟨h, rfl⟩
        change d • f h = f g at hy_eq
        rw [← map_nsmul] at hy_eq
        have h_eq : d • h = g := hf_inj hy_eq
        ext i
        rw [← h_eq]
        change (((d • h) i : ℤ) : ZMod d) = 0
        rw [Pi.smul_apply, nsmul_eq_mul, Int.cast_mul, Int.cast_natCast,
          ZMod.natCast_self, zero_mul]
      · intro hg
        have h_dvd : ∀ i : Fin r_F, (d : ℤ) ∣ g i := by
          intro i
          have hi : (g i : ZMod d) = 0 := congrFun hg i
          exact (ZMod.intCast_zmod_eq_zero_iff_dvd (g i) d).mp hi
        let h : Fin r_F → ℤ := fun i => g i / (d : ℤ)
        have h_eq : d • h = g := by
          ext i
          rw [Pi.smul_apply, nsmul_eq_mul]
          exact Int.mul_ediv_cancel' (h_dvd i)
        refine ⟨f h, ?_, ?_⟩
        · rw [← hf_range]
          exact ⟨h, rfl⟩
        · change d • f h = f g
          rw [← map_nsmul, h_eq]
    rw [h_comap_eq, AddSubgroup.index_eq_card]
    have h_card := Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective π_d hπ_surj).toEquiv
    rw [h_card, Nat.card_fun, Nat.card_zmod, Nat.card_fin]
  exact ⟨hι_inj, hι_range, h_gal, hQcoker_pos, hI_pos⟩

theorem unit_coker_mul_log_ker_relIndex_eq_of_galRestrict_pow {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hι_inj : Function.Injective (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)))
    (hι_range : (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)).range =
      (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
        Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker)
    (h_gal : ∀ u : (NumberField.RingOfIntegers E)ˣ,
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (0 : ℕ))).toMonoidHom) u = u ∧
      (∀ k : ℕ,
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom) u) ∧
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom) u)) ∧
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (Nat.card (E ≃ₐ[F] E)))).toMonoidHom) u = u ∧
      (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
        NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E))
        ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))) u) =
        ∏ k : Fin (Nat.card (E ≃ₐ[F] E)),
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ))).toMonoidHom) u) :
    Nat.card ((NumberField.RingOfIntegers F)ˣ ⧸
      (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).range) *
      ((AddSubgroup.map (NumberField.Units.logEmbedding E)
        (Subgroup.toAddSubgroup
          (Subgroup.map
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))).relIndex
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))) =
    Nat.card ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker ⧸
      ((MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
        Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).range.subgroupOf
        (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker)) *
      ((AddSubgroup.map (nsmulAddMonoidHom (Nat.card (E ≃ₐ[F] E)))
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))).relIndex
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))) :=
by
  let U_F := (NumberField.RingOfIntegers F)ˣ
  let U_E := (NumberField.RingOfIntegers E)ˣ
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  have hd_pos : 0 < d := Nat.card_pos
  have hd_ne : d ≠ 0 := hd_pos.ne'
  let ι : U_F →* U_E :=
    Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)
  let φ_N : U_E →* U_F :=
    Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
  let φ : ℕ → (U_E →* U_E) := fun k =>
    Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom
  let φ_σ : U_E →* U_E :=
    Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom
  let D : U_E →* U_E := MonoidHom.id U_E / φ_σ
  let N_E : U_E →* U_E := ι.comp φ_N
  let p_d : U_E →* U_E := powMonoidHom d
  let K_pos : Subgroup U_E := D.ker
  let K_neg : Subgroup U_E := φ_N.ker
  let A_pos : Subgroup U_E := Subgroup.map p_d K_pos
  let A_neg : Subgroup U_E := Subgroup.map D K_neg
  let T : Subgroup U_E := NumberField.Units.torsion E
  let ℓ := NumberField.Units.logEmbedding E
  
  have hN_ker : N_E.ker = K_neg := by
    ext u
    simp only [N_E, K_neg, MonoidHom.mem_ker, MonoidHom.comp_apply]
    exact ⟨fun h => hι_inj (by rw [h, map_one]), fun h => by rw [h, map_one]⟩
  have hN_range_le : N_E.range ≤ K_pos := by
    rintro _ ⟨u, rfl⟩
    change N_E u ∈ D.ker
    rw [← hι_range]
    exact ⟨φ_N u, rfl⟩
  have h_fixed_pow : ∀ u ∈ K_pos, N_E u = p_d u := by
    intro u hu
    have hu_div : u / φ_σ u = 1 := hu
    have hu_σ : φ_σ u = u := (div_eq_one.mp hu_div).symm
    have hu_k : ∀ k : ℕ, φ k u = u := by
      intro k
      induction k with
      | zero => exact (h_gal u).1
      | succ k ih => rw [((h_gal u).2.1 k).1, hu_σ, ih]
    change ι (φ_N u) = u ^ d
    rw [(h_gal u).2.2.2]
    calc
      (∏ k : Fin d, φ (k : ℕ) u) = ∏ _k : Fin d, u :=
        Finset.prod_congr rfl (fun k _ => hu_k (k : ℕ))
      _ = u ^ d := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  have hA_pos_eq : A_pos = Subgroup.map N_E K_pos := by
    ext x
    simp only [A_pos, Subgroup.mem_map]
    refine ⟨?_, ?_⟩
    · rintro ⟨u, hu, rfl⟩; exact ⟨u, hu, h_fixed_pow u hu⟩
    · rintro ⟨u, hu, rfl⟩; exact ⟨u, hu, (h_fixed_pow u hu).symm⟩
  have hA_pos_le_N : A_pos ≤ N_E.range := by
    rw [hA_pos_eq]; rintro _ ⟨u, _, rfl⟩; exact ⟨u, rfl⟩
  have hA_pos_le : A_pos ≤ K_pos := hA_pos_le_N.trans hN_range_le
  have h_ker_pd_pos : p_d.ker ⊓ K_pos = K_pos ⊓ K_neg := by
    ext u
    simp only [Subgroup.mem_inf, MonoidHom.mem_ker]
    refine ⟨fun ⟨h1, h2⟩ => ⟨h2, ?_⟩, fun ⟨h1, h2⟩ => ⟨?_, h1⟩⟩
    · rw [← hN_ker, MonoidHom.mem_ker, h_fixed_pow u h2]; exact h1
    · rw [← h_fixed_pow u h1]; rw [← hN_ker, MonoidHom.mem_ker] at h2; exact h2
  
  have hφ_D : ∀ (u : U_E) (j : ℕ), φ j (D u) = φ j u / φ (j + 1) u ∧ φ j (D u) = D (φ j u) := by
    intro u j
    have hD_apply : D u = u / φ_σ u := rfl
    rw [hD_apply, map_div]
    refine ⟨?_, ?_⟩
    · rw [← ((h_gal u).2.1 j).1]
    · change φ j u / φ j (φ_σ u) = φ j u / φ_σ (φ j u)
      rw [← ((h_gal u).2.1 j).1, ((h_gal u).2.1 j).2]
  have h_tele : ∀ (u : U_E) (k : ℕ), (∏ j ∈ Finset.range k, φ j (D u)) = u / φ k u := by
    intro u k
    induction k with
    | zero => rw [Finset.prod_range_zero, (h_gal u).1, div_self']
    | succ k ih => rw [Finset.prod_range_succ, ih, (hφ_D u k).1, div_mul_div_cancel]
  have hD_range_le : D.range ≤ K_neg := by
    rintro _ ⟨u, rfl⟩
    rw [← hN_ker, MonoidHom.mem_ker]
    change ι (φ_N (D u)) = 1
    rw [(h_gal (D u)).2.2.2, Fin.prod_univ_eq_prod_range (fun j => φ j (D u)) d,
      h_tele u d, (h_gal u).2.2.1, div_self']
  have hA_neg_le_D : A_neg ≤ D.range := by
    rintro _ ⟨u, _, rfl⟩; exact ⟨u, rfl⟩
  have hA_neg_le : A_neg ≤ K_neg := hA_neg_le_D.trans hD_range_le
  have h_pow_decomp : ∀ u : U_E,
      u ^ d = N_E u * ∏ k : Fin d, ∏ j ∈ Finset.range k.1, φ j (D u) := by
    intro u
    have h_prod_fin :
        (∏ k : Fin d, ∏ j ∈ Finset.range k.1, φ j (D u)) = u ^ d / N_E u := by
      calc
        (∏ k : Fin d, ∏ j ∈ Finset.range k.1, φ j (D u))
            = ∏ k : Fin d, (u / φ (k : ℕ) u) :=
          Finset.prod_congr rfl (fun k _ => h_tele u k.1)
        _ = (∏ _k : Fin d, u) / (∏ k : Fin d, φ (k : ℕ) u) := by rw [Finset.prod_div_distrib]
        _ = u ^ d / N_E u := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← (h_gal u).2.2.2]
          rfl
    rw [h_prod_fin, mul_div_cancel]
  
  have h_pow_mem_sup : ∀ u : U_E, u ^ d ∈ K_pos ⊔ K_neg := by
    intro u
    rw [h_pow_decomp u]
    refine Subgroup.mul_mem _ (Subgroup.mem_sup_left (hN_range_le ⟨u, rfl⟩)) ?_
    refine Subgroup.prod_mem _ fun k _ => Subgroup.prod_mem _ fun j _ => ?_
    rw [(hφ_D u j).2]
    exact Subgroup.mem_sup_right (hD_range_le ⟨φ j u, rfl⟩)
  have h_idx_pos : 0 < (K_pos ⊔ K_neg).index := by
    haveI : NeZero d := ⟨hd_ne⟩
    let S : Subgroup U_E := K_pos ⊔ K_neg
    let H : AddSubgroup (Additive U_E) := Subgroup.toAddSubgroup S
    have h_nsmul : ∀ x : Additive U_E, d • x ∈ H := by
      intro x
      change Additive.toMul (d • x) ∈ S
      rw [toMul_nsmul]
      exact h_pow_mem_sup (Additive.toMul x)
    letI inst_mod : Module (ZMod d) (Additive U_E ⧸ H) := QuotientAddGroup.zmodModule h_nsmul
    haveI : Module.Finite ℤ (Additive U_E ⧸ H) := by
      change Module.Finite ℤ (Additive U_E ⧸ H.toIntSubmodule)
      exact Module.Finite.quotient ℤ H.toIntSubmodule
    haveI : IsScalarTower ℤ (ZMod d) (Additive U_E ⧸ H) := AddCommGroup.intIsScalarTower
    haveI inst_fin : Module.Finite (ZMod d) (Additive U_E ⧸ H) :=
      Module.Finite.of_restrictScalars_finite ℤ (ZMod d) (Additive U_E ⧸ H)
    haveI : Finite (Additive U_E ⧸ H) :=
      @Module.finite_of_finite (ZMod d) (Additive U_E ⧸ H) _ _ inst_mod _ inst_fin
    have h_ne : H.index ≠ 0 := AddSubgroup.index_ne_zero_of_finite
    rw [Subgroup.index_toAddSubgroup] at h_ne
    exact Nat.pos_of_ne_zero h_ne
  
  have h_comap_pos : Subgroup.comap N_E A_pos = K_pos ⊔ K_neg := by
    have h_map_sup : Subgroup.map N_E (K_pos ⊔ K_neg) = A_pos := by
      rw [hA_pos_eq]
      apply le_antisymm
      · rintro _ ⟨u, hu, rfl⟩
        rw [← hN_ker, ← Subgroup.comap_map_eq N_E K_pos] at hu
        exact hu
      · exact Subgroup.map_mono le_sup_left
    rw [← h_map_sup, Subgroup.comap_map_eq, hN_ker, sup_assoc, sup_idem]
  have h_rel_pos_N : A_pos.relIndex N_E.range = (K_pos ⊔ K_neg).index := by
    have h_range_NE : N_E.range = Subgroup.map N_E ⊤ := by ext x; simp
    rw [h_range_NE, ← Subgroup.relIndex_comap A_pos N_E ⊤, h_comap_pos, Subgroup.relIndex_top_right]
  have h_rel_N_Kpos : N_E.range.relIndex K_pos = Nat.card (U_F ⧸ φ_N.range) := by
    have h1 : N_E.range = Subgroup.map ι φ_N.range := by
      ext x
      simp only [N_E, MonoidHom.mem_range, MonoidHom.comp_apply, Subgroup.mem_map]
      exact ⟨fun ⟨u, hu⟩ => ⟨φ_N u, ⟨u, rfl⟩, hu⟩, fun ⟨_, ⟨u, rfl⟩, hu⟩ => ⟨u, hu⟩⟩
    have h2 : K_pos = Subgroup.map ι ⊤ := by
      change D.ker = Subgroup.map ι ⊤
      rw [← hι_range]
      ext x; simp [ι]; exact Iff.rfl
    rw [h1, h2, Subgroup.relIndex_map_map_of_injective _ _ hι_inj,
      Subgroup.relIndex_top_right, Subgroup.index_eq_card]
  have h_diamond_pos :
      A_pos.relIndex K_pos = (K_pos ⊔ K_neg).index * Nat.card (U_F ⧸ φ_N.range) := by
    rw [← Subgroup.relIndex_mul_relIndex A_pos N_E.range K_pos hA_pos_le_N hN_range_le,
      h_rel_pos_N, h_rel_N_Kpos]
  have h_comap_neg : Subgroup.comap D A_neg = K_pos ⊔ K_neg := by
    have h_map_sup : Subgroup.map D (K_pos ⊔ K_neg) = A_neg := by
      apply le_antisymm
      · rintro _ ⟨u, hu, rfl⟩
        rw [sup_comm] at hu
        change u ∈ K_neg ⊔ D.ker at hu
        rw [← Subgroup.comap_map_eq D K_neg] at hu
        exact hu
      · exact Subgroup.map_mono le_sup_right
    have h_ker_D : D.ker = K_pos := rfl
    rw [← h_map_sup, Subgroup.comap_map_eq, h_ker_D, sup_comm K_pos K_neg, sup_assoc,
      sup_idem, sup_comm]
  have h_rel_neg_D : A_neg.relIndex D.range = (K_pos ⊔ K_neg).index := by
    have h_range_D : D.range = Subgroup.map D ⊤ := by ext x; simp
    rw [h_range_D, ← Subgroup.relIndex_comap A_neg D ⊤, h_comap_neg, Subgroup.relIndex_top_right]
  have h_diamond_neg :
      A_neg.relIndex K_neg =
        (K_pos ⊔ K_neg).index * Nat.card (K_neg ⧸ D.range.subgroupOf K_neg) := by
    rw [← Subgroup.relIndex_mul_relIndex A_neg D.range K_neg hA_neg_le_D hD_range_le,
      h_rel_neg_D]
    congr 1
  
  have h_torsion_factor : ∀ (f : U_E →* U_E) (B : Subgroup U_E),
      Subgroup.map f B ≤ B →
      (∀ u ∈ B, f u ∈ T ↔ u ∈ T) →
      (Subgroup.map f B).relIndex B =
        Nat.card ↥(f.ker ⊓ B) *
          ((AddSubgroup.map ℓ (Subgroup.toAddSubgroup (Subgroup.map f B))).relIndex
            (AddSubgroup.map ℓ (Subgroup.toAddSubgroup B))) := by
    intro f B hAB h_tors
    let A := Subgroup.map f B
    let M := B ⊓ T
    have h_log_rel :
        ((AddSubgroup.map ℓ (Subgroup.toAddSubgroup A)).relIndex
          (AddSubgroup.map ℓ (Subgroup.toAddSubgroup B))) =
        (A ⊔ M).relIndex B := by
      rw [← AddSubgroup.relIndex_comap
            (AddSubgroup.map ℓ (Subgroup.toAddSubgroup A)) ℓ (Subgroup.toAddSubgroup B),
          AddSubgroup.comap_map_eq,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_ker,
          ← OrderIso.map_sup,
          Subgroup.relIndex_toAddSubgroup,
          ← Subgroup.inf_relIndex_right (A ⊔ T) B,
          sup_inf_assoc_of_le T hAB,
          inf_comm T B]
    have hAM_eq : A ⊓ M = Subgroup.map f M := by
      ext x
      simp only [A, M, Subgroup.mem_inf, Subgroup.mem_map]
      refine ⟨?_, ?_⟩
      · rintro ⟨⟨u, huB, rfl⟩, _, hxT⟩
        exact ⟨u, ⟨huB, (h_tors u huB).mp hxT⟩, rfl⟩
      · rintro ⟨u, ⟨huB, huT⟩, rfl⟩
        exact ⟨⟨u, huB, rfl⟩, hAB ⟨u, huB, rfl⟩, (h_tors u huB).mpr huT⟩
    have h_ker_eq : f.ker ⊓ M = f.ker ⊓ B := by
      ext u
      simp only [M, Subgroup.mem_inf, MonoidHom.mem_ker]
      refine ⟨fun ⟨h1, h2, _⟩ => ⟨h1, h2⟩, fun ⟨h1, h2⟩ => ⟨h1, h2, ?_⟩⟩
      apply (h_tors u h2).mp
      rw [h1]
      exact T.one_mem
    have h_mapM_le : Subgroup.map f M ≤ M := by
      rw [← hAM_eq]; exact inf_le_right
    haveI : Finite ↥M :=
      Finite.of_injective (Subgroup.inclusion (inf_le_right : M ≤ T))
        (Subgroup.inclusion_injective _)
    haveI : Finite ↥(Subgroup.map f M) :=
      Finite.of_injective (Subgroup.inclusion h_mapM_le) (Subgroup.inclusion_injective _)
    have h_card_M1 : Nat.card ↥(f.ker ⊓ M) * Nat.card ↥(Subgroup.map f M) = Nat.card ↥M := by
      have h1 := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup U_E) (Subgroup.comap f ⊥ ⊓ M) M
        bot_le inf_le_right
      rw [Subgroup.relIndex_bot_left, Subgroup.inf_relIndex_right,
          Subgroup.relIndex_comap ⊥ f M, Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left] at h1
      exact h1
    have h_card_M2 :
        Nat.card ↥(Subgroup.map f M) * (Subgroup.map f M).relIndex M = Nat.card ↥M := by
      have h2 := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup U_E) (Subgroup.map f M) M
        bot_le h_mapM_le
      rw [Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left] at h2
      exact h2
    have h_pos_mapM : 0 < Nat.card ↥(Subgroup.map f M) := Nat.card_pos
    have h_rel_M : (Subgroup.map f M).relIndex M = Nat.card ↥(f.ker ⊓ B) := by
      rw [← h_ker_eq]
      apply Nat.eq_of_mul_eq_mul_left h_pos_mapM
      rw [h_card_M2, ← h_card_M1, mul_comm]
    have h_sup_le : A ⊔ M ≤ B := sup_le hAB inf_le_left
    have h_rel_sup : A.relIndex (A ⊔ M) = (Subgroup.map f M).relIndex M := by
      rw [sup_comm A M, Subgroup.relIndex_sup_right, ← Subgroup.inf_relIndex_right A M, hAM_eq]
    rw [h_log_rel, ← Subgroup.relIndex_mul_relIndex A (A ⊔ M) B le_sup_left h_sup_le,
        h_rel_sup, h_rel_M]
  
  have h_tors_pos : ∀ u ∈ K_pos, p_d u ∈ T ↔ u ∈ T := by
    intro u _
    change u ^ d ∈ CommGroup.torsion U_E ↔ u ∈ CommGroup.torsion U_E
    rw [CommGroup.mem_torsion, CommGroup.mem_torsion, isOfFinOrder_pow, or_iff_left hd_ne]
  have h_nsmul_map :
      AddSubgroup.map (nsmulAddMonoidHom d) (AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_pos)) =
        AddSubgroup.map ℓ (Subgroup.toAddSubgroup A_pos) := by
    ext y
    simp only [AddSubgroup.mem_map, A_pos, nsmulAddMonoidHom_apply]
    refine ⟨?_, ?_⟩
    · rintro ⟨_, ⟨u, hu, rfl⟩, rfl⟩
      refine ⟨Additive.ofMul (p_d (Additive.toMul u)), ⟨Additive.toMul u, hu, rfl⟩, ?_⟩
      change ℓ (Additive.ofMul (Additive.toMul u ^ d)) = d • ℓ u
      rw [ofMul_pow, ofMul_toMul, map_nsmul]
    · rintro ⟨x, ⟨u, hu, rfl⟩, rfl⟩
      refine ⟨ℓ (Additive.ofMul u), ⟨Additive.ofMul u, hu, rfl⟩, ?_⟩
      change d • ℓ (Additive.ofMul u) = ℓ (Additive.ofMul (u ^ d))
      rw [ofMul_pow, map_nsmul]
  have h_factor_pos :
      A_pos.relIndex K_pos =
        Nat.card ↥(K_pos ⊓ K_neg) *
          ((AddSubgroup.map (nsmulAddMonoidHom d)
            (AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_pos))).relIndex
            (AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_pos))) := by
    rw [h_nsmul_map, h_torsion_factor p_d K_pos hA_pos_le h_tors_pos, h_ker_pd_pos]
  have h_inter_le_T : K_pos ⊓ K_neg ≤ T := by
    rw [← h_ker_pd_pos]
    rintro u ⟨hu_ker, _⟩
    change IsOfFinOrder u
    exact isOfFinOrder_iff_pow_eq_one.mpr ⟨d, hd_pos, hu_ker⟩
  haveI : Finite ↥(K_pos ⊓ K_neg) :=
    Finite.of_injective (Subgroup.inclusion h_inter_le_T) (Subgroup.inclusion_injective _)
  have h_inter_pos : 0 < Nat.card ↥(K_pos ⊓ K_neg) := Nat.card_pos
  have h_tors_neg : ∀ u ∈ K_neg, D u ∈ T ↔ u ∈ T := by
    intro u hu
    refine ⟨fun hDu => ?_, fun huT => ?_⟩
    · have h_pow_T : u ^ d ∈ T := by
        rw [h_pow_decomp u]
        have hN_one : N_E u = 1 := by rwa [← MonoidHom.mem_ker, hN_ker]
        rw [hN_one, one_mul]
        refine Subgroup.prod_mem T fun k _ => Subgroup.prod_mem T fun j _ => ?_
        exact (CommGroup.mem_torsion U_E _).mpr
          ((φ j).isOfFinOrder ((CommGroup.mem_torsion U_E _).mp hDu))
      exact (CommGroup.mem_torsion U_E u).mpr
        ((isOfFinOrder_pow.mp ((CommGroup.mem_torsion U_E (u ^ d)).mp h_pow_T)).resolve_right hd_ne)
    · exact (CommGroup.mem_torsion U_E (D u)).mpr
        (D.isOfFinOrder ((CommGroup.mem_torsion U_E u).mp huT))
  have h_factor_neg :
      A_neg.relIndex K_neg =
        Nat.card ↥(K_pos ⊓ K_neg) *
          ((AddSubgroup.map ℓ (Subgroup.toAddSubgroup A_neg)).relIndex
            (AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_neg))) := by
    exact h_torsion_factor D K_neg hA_neg_le h_tors_neg
  
  let Idx := (K_pos ⊔ K_neg).index
  let C_inf := Nat.card ↥(K_pos ⊓ K_neg)
  let Q_coker := Nat.card (U_F ⧸ φ_N.range)
  let Q_ker := Nat.card (K_neg ⧸ D.range.subgroupOf K_neg)
  let I_pos := (AddSubgroup.map (nsmulAddMonoidHom d)
    (AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_pos))).relIndex
    (AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_pos))
  let I_neg := (AddSubgroup.map ℓ (Subgroup.toAddSubgroup A_neg)).relIndex
    (AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_neg))
  have h_eq_pos : Idx * Q_coker = C_inf * I_pos := h_diamond_pos.symm.trans h_factor_pos
  have h_eq_neg : Idx * Q_ker = C_inf * I_neg := h_diamond_neg.symm.trans h_factor_neg
  have h_mul_pos : 0 < Idx * C_inf := Nat.mul_pos h_idx_pos h_inter_pos
  change Q_coker * I_neg = Q_ker * I_pos
  apply Nat.eq_of_mul_eq_mul_left h_mul_pos
  calc
    (Idx * C_inf) * (Q_coker * I_neg)
        = (Idx * Q_coker) * (C_inf * I_neg) := by ring
    _ = (C_inf * I_pos) * (Idx * Q_ker) := by rw [h_eq_pos, ← h_eq_neg]
    _ = (Idx * C_inf) * (Q_ker * I_pos) := by ring

theorem exists_int_zeroSum_galois_linearMap_and_place_index_eq {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E) :
    ∃ τ_ℤ : ({ w : NumberField.InfinitePlace E // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℤ) →ₗ[ℤ]
        ({ w : NumberField.InfinitePlace E // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℤ),
      (∀ f : NumberField.InfinitePlace E → ℤ,
        (∑ w_E : NumberField.InfinitePlace E, f w_E) = 0 →
        τ_ℤ (fun w => f w.1) = (fun w => f (σ⁻¹ • w.1))) ∧
      (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)),
          (LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E)) ^ (k : ℕ)) +
        (1 - LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E))).toAddMonoidHom).range.index =
      Nat.card (E ≃ₐ[F] E) *
        (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℤ ^ (k : ℕ)) +
          (1 - τ_ℤ)).toAddMonoidHom).range.index :=
by
  classical
  let W := NumberField.InfinitePlace E
  let w₀ : W := NumberField.Units.dirichletUnitTheorem.w₀
  let W' := { w : W // w ≠ w₀ }
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  let τ_P : (W → ℤ) →ₗ[ℤ] (W → ℤ) :=
    LinearMap.funLeft ℤ ℤ (fun w_E : W => σ⁻¹ • w_E)
  let res_ℤ : (W → ℤ) →ₗ[ℤ] (W' → ℤ) :=
    LinearMap.funLeft ℤ ℤ (Subtype.val : W' → W)
  let ext_ℤ : (W' → ℤ) →ₗ[ℤ] (W → ℤ) :=
    { toFun := fun v w_E => if h : w_E = w₀ then - ∑ u : W', v u else v ⟨w_E, h⟩
      map_add' := by
        intro v₁ v₂
        ext w_E
        simp only [Pi.add_apply]
        split_ifs with h
        · rw [Finset.sum_add_distrib, neg_add]
        · rfl
      map_smul' := by
        intro c v
        ext w_E
        simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul]
        split_ifs with h
        · rw [← Finset.mul_sum, mul_neg]
        · rfl }
  let sum_ℤ : (W → ℤ) →+ ℤ :=
    { toFun := fun f => ∑ w_E : W, f w_E
      map_zero' := Finset.sum_const_zero
      map_add' := fun _ _ => Finset.sum_add_distrib }
  let τ_ℤ : (W' → ℤ) →ₗ[ℤ] (W' → ℤ) := res_ℤ.comp (τ_P.comp ext_ℤ)
  have h_res_ext : ∀ v : W' → ℤ, res_ℤ (ext_ℤ v) = v := by
    intro v
    ext w
    change (if h : w.1 = w₀ then - ∑ u : W', v u else v ⟨w.1, h⟩) = v w
    rw [dif_neg w.2]
  have h_ext_inj : Function.Injective ext_ℤ := by
    intro v₁ v₂ h
    have h1 := congrArg res_ℤ h
    rwa [h_res_ext, h_res_ext] at h1
  have h_sum_ext : ∀ v : W' → ℤ, sum_ℤ (ext_ℤ v) = 0 := by
    intro v
    change (∑ w_E : W, ext_ℤ v w_E) = 0
    rw [Fintype.sum_eq_add_sum_subtype_ne (ext_ℤ v) w₀]
    have hw₀ : ext_ℤ v w₀ = - ∑ u : W', v u := dif_pos rfl
    have h_sub : (∑ u : W', ext_ℤ v u.1) = ∑ u : W', v u := by
      refine Finset.sum_congr rfl fun u _ => ?_
      exact dif_neg u.2
    rw [hw₀, h_sub, neg_add_cancel]
  have h_ext_res : ∀ f : W → ℤ, sum_ℤ f = 0 → ext_ℤ (res_ℤ f) = f := by
    intro f hf
    change (∑ w_E : W, f w_E) = 0 at hf
    rw [Fintype.sum_eq_add_sum_subtype_ne f w₀] at hf
    have hfw₀ : f w₀ = - ∑ u : W', f u.1 := eq_neg_of_add_eq_zero_left hf
    ext w_E
    change (if h : w_E = w₀ then - ∑ u : W', f u.1 else f w_E) = f w_E
    split_ifs with h
    · rw [h, hfw₀]
    · rfl
  have h_range_ext : ext_ℤ.toAddMonoidHom.range = sum_ℤ.ker := by
    apply le_antisymm
    · rintro f ⟨v, rfl⟩
      exact h_sum_ext v
    · intro f hf
      exact ⟨res_ℤ f, h_ext_res f hf⟩
  have hτ_ℤ : ∀ f : W → ℤ, (∑ w_E : W, f w_E) = 0 →
      τ_ℤ (fun w => f w.1) = (fun w => f (σ⁻¹ • w.1)) := by
    intro f hf
    change res_ℤ (τ_P (ext_ℤ (res_ℤ f))) = res_ℤ (τ_P f)
    rw [h_ext_res f hf]
  have h_sum_τP : ∀ f : W → ℤ, sum_ℤ (τ_P f) = sum_ℤ f := by
    intro f
    change (∑ w_E : W, f ((MulAction.toPerm σ⁻¹) w_E)) = ∑ w_E : W, f w_E
    exact Equiv.sum_comp (MulAction.toPerm σ⁻¹) f
  have h_ext_τ : ∀ v : W' → ℤ, ext_ℤ (τ_ℤ v) = τ_P (ext_ℤ v) := by
    intro v
    change ext_ℤ (res_ℤ (τ_P (ext_ℤ v))) = τ_P (ext_ℤ v)
    apply h_ext_res
    rw [h_sum_τP, h_sum_ext]
  have h_sum_τP_pow : ∀ (k : ℕ) (f : W → ℤ), sum_ℤ ((τ_P ^ k) f) = sum_ℤ f := by
    intro k
    induction k with
    | zero =>
      intro f
      simp
    | succ k ih =>
      intro f
      rw [pow_succ' τ_P k, Module.End.mul_apply, h_sum_τP, ih]
  have h_ext_τ_pow : ∀ (k : ℕ) (v : W' → ℤ), ext_ℤ ((τ_ℤ ^ k) v) = (τ_P ^ k) (ext_ℤ v) := by
    intro k
    induction k with
    | zero =>
      intro v
      simp
    | succ k ih =>
      intro v
      rw [pow_succ' τ_ℤ k, pow_succ' τ_P k, Module.End.mul_apply, Module.End.mul_apply, h_ext_τ, ih]
  let T_place : (W → ℤ) →ₗ[ℤ] (W → ℤ) :=
    (∑ k : Fin d, τ_P ^ (k : ℕ)) + (1 - τ_P)
  let T_ℤ : (W' → ℤ) →ₗ[ℤ] (W' → ℤ) :=
    (∑ k : Fin d, τ_ℤ ^ (k : ℕ)) + (1 - τ_ℤ)
  have h_ext_T : ∀ v : W' → ℤ, ext_ℤ (T_ℤ v) = T_place (ext_ℤ v) := by
    intro v
    dsimp [T_ℤ, T_place]
    simp only [LinearMap.sum_apply, map_add, map_sub, map_sum, h_ext_τ_pow, h_ext_τ]
  have h_sum_T : ∀ f : W → ℤ, sum_ℤ (T_place f) = (d : ℤ) * sum_ℤ f := by
    intro f
    dsimp [T_place]
    simp only [LinearMap.sum_apply, map_add, map_sub, map_sum, h_sum_τP_pow, h_sum_τP]
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, sub_self, add_zero, nsmul_eq_mul]
  let R_place : AddSubgroup (W → ℤ) := T_place.toAddMonoidHom.range
  let R_ℤ : AddSubgroup (W' → ℤ) := T_ℤ.toAddMonoidHom.range
  let H_ℤ : AddSubgroup (W → ℤ) := sum_ℤ.ker
  have hd_pos : 0 < d := Nat.card_pos
  have hd_ne : (d : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
  have h_comap_ext : AddSubgroup.comap ext_ℤ.toAddMonoidHom R_place = R_ℤ := by
    ext v
    dsimp [R_place, R_ℤ]
    simp only [AddSubgroup.mem_comap, AddMonoidHom.mem_range, LinearMap.toAddMonoidHom_coe]
    constructor
    · rintro ⟨f, hf⟩
      have h_sum_eq : (d : ℤ) * sum_ℤ f = 0 := by
        rw [← h_sum_T f, hf, h_sum_ext v]
      have hf_ker : sum_ℤ f = 0 := (mul_eq_zero.mp h_sum_eq).resolve_left hd_ne
      refine ⟨res_ℤ f, h_ext_inj ?_⟩
      rw [h_ext_T, h_ext_res f hf_ker, hf]
    · rintro ⟨u, rfl⟩
      exact ⟨ext_ℤ u, (h_ext_T u).symm⟩
  have h_rel_H : R_place.relIndex H_ℤ = R_ℤ.index := by
    dsimp [H_ℤ]
    rw [← h_range_ext, ← AddSubgroup.index_comap R_place ext_ℤ.toAddMonoidHom, h_comap_ext]
  have h_sum_single : ∀ c : ℤ, sum_ℤ (Pi.single w₀ c) = c := by
    intro c
    change (∑ w_E : W, Pi.single w₀ c w_E) = c
    exact Fintype.sum_pi_single' w₀ c
  have hsum_surj : Function.Surjective sum_ℤ := fun c => ⟨Pi.single w₀ c, h_sum_single c⟩
  have h_sup_eq : H_ℤ ⊔ R_place = AddSubgroup.comap sum_ℤ (AddSubgroup.zmultiples (d : ℤ)) := by
    apply le_antisymm
    · apply sup_le
      · intro f hf
        change sum_ℤ f ∈ AddSubgroup.zmultiples (d : ℤ)
        have hf0 : sum_ℤ f = 0 := hf
        rw [hf0]
        exact zero_mem _
      · rintro g ⟨f, rfl⟩
        change sum_ℤ (T_place f) ∈ AddSubgroup.zmultiples (d : ℤ)
        rw [h_sum_T f, Int.mem_zmultiples_iff]
        exact ⟨sum_ℤ f, by ring⟩
    · intro f hf
      change sum_ℤ f ∈ AddSubgroup.zmultiples (d : ℤ) at hf
      rw [Int.mem_zmultiples_iff] at hf
      rcases hf with ⟨m, hm⟩
      let g : W → ℤ := T_place (Pi.single w₀ m)
      have hg_mem : g ∈ R_place := ⟨Pi.single w₀ m, rfl⟩
      have h_sum_g : sum_ℤ g = sum_ℤ f := by
        dsimp [g]
        rw [h_sum_T, h_sum_single, hm]
      have h_sub_mem : f - g ∈ H_ℤ := by
        change sum_ℤ (f - g) = 0
        rw [map_sub, h_sum_g, sub_self]
      have h_eq : (f - g) + g = f := sub_add_cancel f g
      rw [← h_eq]
      exact AddSubgroup.add_mem_sup h_sub_mem hg_mem
  have h_sup_idx : (H_ℤ ⊔ R_place).index = d := by
    rw [h_sup_eq, AddSubgroup.index_comap_of_surjective (AddSubgroup.zmultiples (d : ℤ)) hsum_surj,
      AddSubgroup.index_eq_card,
      Nat.card_congr (Int.quotientZMultiplesNatEquivZMod d).toEquiv,
      Nat.card_zmod]
  refine ⟨τ_ℤ, hτ_ℤ, ?_⟩
  change R_place.index = d * R_ℤ.index
  calc
    R_place.index
        = (R_place.relIndex (H_ℤ ⊔ R_place)) * (H_ℤ ⊔ R_place).index :=
          (AddSubgroup.relIndex_mul_index (le_sup_right : R_place ≤ H_ℤ ⊔ R_place)).symm
    _ = (R_place.relIndex H_ℤ) * (H_ℤ ⊔ R_place).index := by
          rw [AddSubgroup.relIndex_sup_right H_ℤ R_place]
    _ = R_ℤ.index * d := by
          rw [h_rel_H, h_sup_idx]
    _ = d * R_ℤ.index := mul_comm _ _

theorem exists_logSpace_galois_linearMap_equivariant {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (h_gal : ∀ u : (NumberField.RingOfIntegers E)ˣ,
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (0 : ℕ))).toMonoidHom) u = u ∧
      (∀ k : ℕ,
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom) u) ∧
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom) u)) ∧
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (Nat.card (E ≃ₐ[F] E)))).toMonoidHom) u = u ∧
      (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
        NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E))
        ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))) u) =
        ∏ k : Fin (Nat.card (E ≃ₐ[F] E)),
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ))).toMonoidHom) u) :
    ∃ τ_ℝ : NumberField.Units.dirichletUnitTheorem.logSpace E →ₗ[ℝ]
        NumberField.Units.dirichletUnitTheorem.logSpace E,
      τ_ℝ ^ (Nat.card (E ≃ₐ[F] E)) = 1 ∧
      (∀ f : NumberField.InfinitePlace E → ℝ,
        (∑ w_E : NumberField.InfinitePlace E, f w_E) = 0 →
        τ_ℝ (fun w => f w.1) = (fun w => f (σ⁻¹ • w.1))) ∧
      (∀ u : (NumberField.RingOfIntegers E)ˣ, ∀ k : ℕ,
        NumberField.Units.logEmbedding E
          (Additive.ofMul ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom) u)) =
        (τ_ℝ ^ k) (NumberField.Units.logEmbedding E (Additive.ofMul u))) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let W := NumberField.InfinitePlace E
  let w₀ : W := NumberField.Units.dirichletUnitTheorem.w₀
  let W' := { w : W // w ≠ w₀ }
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  let res_ℝ : (W → ℝ) →ₗ[ℝ] NumberField.Units.dirichletUnitTheorem.logSpace E :=
    LinearMap.funLeft ℝ ℝ Subtype.val
  let ext_ℝ : NumberField.Units.dirichletUnitTheorem.logSpace E →ₗ[ℝ] (W → ℝ) :=
    ∑ u : W',
      (LinearMap.single ℝ (fun _ : W => ℝ) u.1 -
        LinearMap.single ℝ (fun _ : W => ℝ) w₀).comp (LinearMap.proj u)
  let τ_P : (W → ℝ) →ₗ[ℝ] (W → ℝ) :=
    LinearMap.funLeft ℝ ℝ (fun w_E : W => σ⁻¹ • w_E)
  let τ_ℝ : NumberField.Units.dirichletUnitTheorem.logSpace E →ₗ[ℝ]
      NumberField.Units.dirichletUnitTheorem.logSpace E :=
    res_ℝ.comp (τ_P.comp ext_ℝ)
  have h_ext_apply : ∀ (v : NumberField.Units.dirichletUnitTheorem.logSpace E) (w_E : W),
      ext_ℝ v w_E = ∑ u : W', ((Pi.single u.1 (v u) : W → ℝ) w_E - (Pi.single w₀ (v u) : W → ℝ) w_E) := by
    intro v w_E
    dsimp [ext_ℝ]
    rw [LinearMap.sum_apply, Finset.sum_apply]
    refine Finset.sum_congr rfl (fun u _ => ?_)
    simp only [LinearMap.comp_apply, LinearMap.sub_apply, Pi.sub_apply,
      LinearMap.single_apply, LinearMap.proj_apply]
    rfl
  have h_ext_w₀ : ∀ v : NumberField.Units.dirichletUnitTheorem.logSpace E,
      ext_ℝ v w₀ = - ∑ u : W', v u := by
    intro v
    rw [h_ext_apply v w₀, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun u _ => ?_)
    rw [Pi.single_eq_of_ne u.2.symm, Pi.single_eq_same, zero_sub]
  have h_ext_sub : ∀ (v : NumberField.Units.dirichletUnitTheorem.logSpace E) (w : W'),
      ext_ℝ v w.1 = v w := by
    intro v w
    rw [h_ext_apply v w.1]
    have h_step1 : (∑ u : W', ((Pi.single u.1 (v u) : W → ℝ) w.1 - (Pi.single w₀ (v u) : W → ℝ) w.1)) =
        ∑ u : W', (Pi.single u.1 (v u) : W → ℝ) w.1 := by
      refine Finset.sum_congr rfl (fun u _ => ?_)
      rw [Pi.single_eq_of_ne w.2, sub_zero]
    rw [h_step1, Finset.sum_eq_single w]
    · rw [Pi.single_eq_same]
    · intro u _ hu
      have h_ne : w.1 ≠ u.1 := fun h => hu (Subtype.ext h.symm)
      rw [Pi.single_eq_of_ne h_ne]
    · intro hw_not_mem
      exact (hw_not_mem (Finset.mem_univ w)).elim
  have h_res_ext : ∀ v : NumberField.Units.dirichletUnitTheorem.logSpace E,
      res_ℝ (ext_ℝ v) = v := by
    intro v
    ext w
    exact h_ext_sub v w
  have h_sum_decomp : ∀ f : W → ℝ,
      (∑ w_E : W, f w_E) = f w₀ + ∑ u : W', f u.1 := by
    intro f
    rw [Finset.sum_eq_add_sum_diff_singleton (Finset.mem_univ w₀) f]
    congr 1
    refine Finset.sum_subtype (Finset.univ \ {w₀}) (fun x => ?_) f
    simp only [Finset.mem_sdiff, Finset.mem_univ, Finset.mem_singleton, true_and]
  have h_sum_ext : ∀ v : NumberField.Units.dirichletUnitTheorem.logSpace E,
      (∑ w_E : W, ext_ℝ v w_E) = 0 := by
    intro v
    rw [h_sum_decomp (ext_ℝ v), h_ext_w₀ v]
    have h_sub_sum : (∑ u : W', ext_ℝ v u.1) = ∑ u : W', v u :=
      Finset.sum_congr rfl (fun u _ => h_ext_sub v u)
    rw [h_sub_sum, neg_add_cancel]
  have h_ext_res_of_sum_zero : ∀ f : W → ℝ,
      (∑ w_E : W, f w_E) = 0 → ext_ℝ (res_ℝ f) = f := by
    intro f hf
    have hf_w₀ : f w₀ = - ∑ u : W', f u.1 := by
      have h1 := h_sum_decomp f
      rw [hf] at h1
      linarith
    ext w_E
    by_cases hw : w_E = w₀
    · subst hw
      rw [h_ext_w₀ (res_ℝ f), hf_w₀]
      rfl
    · exact h_ext_sub (res_ℝ f) ⟨w_E, hw⟩
  have hτ_ℝ : ∀ f : W → ℝ,
      (∑ w_E : W, f w_E) = 0 →
      τ_ℝ (fun w => f w.1) = (fun w => f (σ⁻¹ • w.1)) := by
    intro f hf
    change res_ℝ (τ_P (ext_ℝ (res_ℝ f))) = (fun w => f (σ⁻¹ • w.1))
    rw [h_ext_res_of_sum_zero f hf]
    rfl
  have h_sum_τ_P : ∀ f : W → ℝ,
      (∑ w_E : W, τ_P f w_E) = ∑ w_E : W, f w_E := by
    intro f
    exact Equiv.sum_comp (MulAction.toPerm (σ⁻¹)) f
  have h_sum_τ_P_pow : ∀ (k : ℕ) (f : W → ℝ),
      (∑ w_E : W, ((τ_P ^ k) f) w_E) = ∑ w_E : W, f w_E := by
    intro k
    induction k with
    | zero =>
      intro f
      simp only [pow_zero, Module.End.one_apply]
    | succ k ih =>
      intro f
      rw [pow_succ', Module.End.mul_apply, h_sum_τ_P, ih]
  have h_τ_P_pow_apply : ∀ (k : ℕ) (f : W → ℝ) (w_E : W),
      ((τ_P ^ k) f) w_E = f (((σ⁻¹) ^ k) • w_E) := by
    intro k
    induction k with
    | zero =>
      intro f w_E
      simp only [pow_zero, Module.End.one_apply, one_smul]
    | succ k ih =>
      intro f w_E
      rw [pow_succ', Module.End.mul_apply]
      change ((τ_P ^ k) f) (σ⁻¹ • w_E) = f (((σ⁻¹) ^ (k + 1)) • w_E)
      rw [ih, ← mul_smul, ← pow_succ]
  have h_τ_ℝ_pow : ∀ (k : ℕ) (v : NumberField.Units.dirichletUnitTheorem.logSpace E),
      (τ_ℝ ^ k) v = res_ℝ ((τ_P ^ k) (ext_ℝ v)) := by
    intro k
    induction k with
    | zero =>
      intro v
      simp only [pow_zero, Module.End.one_apply]
      exact (h_res_ext v).symm
    | succ k ih =>
      intro v
      rw [pow_succ', Module.End.mul_apply, ih v]
      change res_ℝ (τ_P (ext_ℝ (res_ℝ ((τ_P ^ k) (ext_ℝ v))))) =
        res_ℝ ((τ_P ^ (k + 1)) (ext_ℝ v))
      have h_zero : (∑ w_E : W, ((τ_P ^ k) (ext_ℝ v)) w_E) = 0 := by
        rw [h_sum_τ_P_pow k (ext_ℝ v), h_sum_ext v]
      rw [h_ext_res_of_sum_zero _ h_zero, pow_succ', Module.End.mul_apply]
  have hτ_pow : τ_ℝ ^ d = 1 := by
    apply LinearMap.ext
    intro v
    rw [h_τ_ℝ_pow d v, Module.End.one_apply]
    have h_pow_d : (σ⁻¹) ^ d = 1 := by
      dsimp [d]
      rw [Nat.card_eq_fintype_card, pow_card_eq_one]
    have h_τ_P_d : (τ_P ^ d) (ext_ℝ v) = ext_ℝ v := by
      ext w_E
      rw [h_τ_P_pow_apply d (ext_ℝ v) w_E, h_pow_d, one_smul]
    rw [h_τ_P_d, h_res_ext v]
  let φ_σ : R_Eˣ →* R_Eˣ :=
    Units.map (galRestrict R_F F E R_E σ).toMonoidHom
  let f_log : R_Eˣ → W → ℝ :=
    fun u w_E => (w_E.mult : ℝ) * Real.log (w_E (algebraMap R_E E (u : R_E)))
  have h_f_log_res : ∀ u : R_Eˣ,
      (fun w : W' => f_log u w.1) = NumberField.Units.logEmbedding E (Additive.ofMul u) := by
    intro u
    ext w
    exact (NumberField.Units.dirichletUnitTheorem.logEmbedding_component u w).symm
  have h_f_log_sum : ∀ u : R_Eˣ, (∑ w_E : W, f_log u w_E) = 0 := by
    intro u
    rw [h_sum_decomp (f_log u)]
    have h_sub : (∑ w : W', f_log u w.1) =
        ∑ w : W', NumberField.Units.logEmbedding E (Additive.ofMul u) w :=
      Finset.sum_congr rfl (fun w _ => (NumberField.Units.dirichletUnitTheorem.logEmbedding_component u w).symm)
    rw [h_sub, NumberField.Units.dirichletUnitTheorem.sum_logEmbedding_component u]
    dsimp [f_log, w₀]
    ring
  have h_mult_smul : ∀ w_E : W, (σ⁻¹ • w_E).mult = w_E.mult := by
    intro w_E
    by_cases hw : w_E.IsReal
    · have hw' : (σ⁻¹ • w_E).IsReal := NumberField.InfinitePlace.isReal_smul_iff.mpr hw
      rw [NumberField.InfinitePlace.mult_isReal ⟨σ⁻¹ • w_E, hw'⟩,
        NumberField.InfinitePlace.mult_isReal ⟨w_E, hw⟩]
    · have hc : w_E.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw
      have hc' : (σ⁻¹ • w_E).IsComplex := NumberField.InfinitePlace.isComplex_smul_iff.mpr hc
      rw [NumberField.InfinitePlace.mult_isComplex ⟨σ⁻¹ • w_E, hc'⟩,
        NumberField.InfinitePlace.mult_isComplex ⟨w_E, hc⟩]
  have h_place_smul : ∀ (u : R_Eˣ) (w_E : W),
      (σ⁻¹ • w_E) (algebraMap R_E E (u : R_E)) =
        w_E (algebraMap R_E E ((φ_σ u : R_Eˣ) : R_E)) := by
    intro u w_E
    rw [NumberField.InfinitePlace.smul_apply, AlgEquiv.aut_inv, AlgEquiv.symm_symm]
    have h_coe : ((φ_σ u : R_Eˣ) : R_E) = (galRestrict R_F F E R_E σ) (u : R_E) := rfl
    rw [h_coe, algebraMap_galRestrict_apply R_F σ (u : R_E)]
  have h_equiv_one : ∀ u : R_Eˣ,
      NumberField.Units.logEmbedding E (Additive.ofMul (φ_σ u)) =
        τ_ℝ (NumberField.Units.logEmbedding E (Additive.ofMul u)) := by
    intro u
    rw [← h_f_log_res u, ← h_f_log_res (φ_σ u), hτ_ℝ (f_log u) (h_f_log_sum u)]
    ext w
    dsimp [f_log]
    rw [h_mult_smul w.1, h_place_smul u w.1]
  have hτ_equiv : ∀ (u : R_Eˣ) (k : ℕ),
      NumberField.Units.logEmbedding E
        (Additive.ofMul ((Units.map (galRestrict R_F F E R_E (σ ^ k)).toMonoidHom) u)) =
      (τ_ℝ ^ k) (NumberField.Units.logEmbedding E (Additive.ofMul u)) := by
    intro u k
    induction k with
    | zero =>
      rw [(h_gal u).1, pow_zero, Module.End.one_apply]
    | succ k ih =>
      rw [((h_gal u).2.1 k).2]
      change NumberField.Units.logEmbedding E
          (Additive.ofMul (φ_σ ((Units.map (galRestrict R_F F E R_E (σ ^ k)).toMonoidHom) u))) =
        (τ_ℝ ^ (k + 1)) (NumberField.Units.logEmbedding E (Additive.ofMul u))
      rw [h_equiv_one, ih, pow_succ', Module.End.mul_apply]
  exact ⟨τ_ℝ, hτ_pow, hτ_ℝ, hτ_equiv⟩

theorem unitLattice_relIndex_eq_pi_int_index_of_zeroSum_galois {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (τ_ℤ : ({ w : NumberField.InfinitePlace E // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℤ) →ₗ[ℤ]
      ({ w : NumberField.InfinitePlace E // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℤ))
    (τ_ℝ : NumberField.Units.dirichletUnitTheorem.logSpace E →ₗ[ℝ]
      NumberField.Units.dirichletUnitTheorem.logSpace E)
    (hτ_ℤ : ∀ f : NumberField.InfinitePlace E → ℤ,
      (∑ w_E : NumberField.InfinitePlace E, f w_E) = 0 →
      τ_ℤ (fun w => f w.1) = (fun w => f (σ⁻¹ • w.1)))
    (hτ_ℝ : ∀ f : NumberField.InfinitePlace E → ℝ,
      (∑ w_E : NumberField.InfinitePlace E, f w_E) = 0 →
      τ_ℝ (fun w => f w.1) = (fun w => f (σ⁻¹ • w.1)))
    (hT_inj : Function.Injective (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℝ ^ (k : ℕ)) + (1 - τ_ℝ)).toAddMonoidHom))
    (hT_mem : ∀ x ∈ (NumberField.Units.unitLattice E).toAddSubgroup,
      (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℝ ^ (k : ℕ)) + (1 - τ_ℝ)) x) ∈
        (NumberField.Units.unitLattice E).toAddSubgroup) :
    (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℤ ^ (k : ℕ)) +
      (1 - τ_ℤ)).toAddMonoidHom).range.index =
    (AddSubgroup.map
      (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℝ ^ (k : ℕ)) + (1 - τ_ℝ)).toAddMonoidHom)
      (NumberField.Units.unitLattice E).toAddSubgroup).relIndex
      (NumberField.Units.unitLattice E).toAddSubgroup :=
by
  classical
  let W := NumberField.InfinitePlace E
  let w₀ : W := NumberField.Units.dirichletUnitTheorem.w₀
  let W' := { w : W // w ≠ w₀ }
  let d := Nat.card (E ≃ₐ[F] E)
  let T_ℤ : (W' → ℤ) →ₗ[ℤ] (W' → ℤ) :=
    (∑ k : Fin d, τ_ℤ ^ (k : ℕ)) + (1 - τ_ℤ)
  let T_ℝ : NumberField.Units.dirichletUnitTheorem.logSpace E →ₗ[ℝ]
      NumberField.Units.dirichletUnitTheorem.logSpace E :=
    (∑ k : Fin d, τ_ℝ ^ (k : ℕ)) + (1 - τ_ℝ)
  let ι_std : (W' → ℤ) →ₗ[ℤ] NumberField.Units.dirichletUnitTheorem.logSpace E :=
    { toFun := fun v w => (v w : ℝ)
      map_add' := fun u v => by ext w; exact Int.cast_add (u w) (v w)
      map_smul' := fun c v => by ext w; simp [zsmul_eq_mul] }
  have hι_inj : Function.Injective ι_std := by
    intro u v huv
    ext w
    exact Int.cast_injective (congrFun huv w)
  let b_ℤ : Module.Basis W' ℤ (W' → ℤ) := Pi.basisFun ℤ W'
  let b_ℝ : Module.Basis W' ℝ (NumberField.Units.dirichletUnitTheorem.logSpace E) := Pi.basisFun ℝ W'
  have h_intertwine_τ_hom :
      (τ_ℝ.restrictScalars ℤ).comp ι_std = ι_std.comp τ_ℤ := by
    apply b_ℤ.ext
    intro u
    change τ_ℝ (ι_std (b_ℤ u)) = ι_std (τ_ℤ (b_ℤ u))
    let e_u : W → ℤ := Pi.single u.1 (1 : ℤ) - Pi.single w₀ (1 : ℤ)
    let e_u_ℝ : W → ℝ := fun w_E => (e_u w_E : ℝ)
    have h_sum_ℤ : (∑ w_E : W, e_u w_E) = 0 := by
      dsimp [e_u]
      rw [Finset.sum_sub_distrib,
        Fintype.sum_eq_single u.1 (fun w_E hw => Pi.single_eq_of_ne hw 1),
        Fintype.sum_eq_single w₀ (fun w_E hw => Pi.single_eq_of_ne hw 1),
        Pi.single_eq_same, Pi.single_eq_same, sub_self]
    have h_sum_ℝ : (∑ w_E : W, e_u_ℝ w_E) = 0 := by
      dsimp [e_u_ℝ]
      rw [← Int.cast_sum, h_sum_ℤ, Int.cast_zero]
    have h_res_ℤ : (fun w : W' => e_u w.1) = b_ℤ u := by
      ext w
      dsimp [e_u, b_ℤ]
      rw [Pi.basisFun_apply, Pi.single_eq_of_ne w.2 1, sub_zero]
      by_cases hwu : w = u
      · subst hwu
        simp
      · have hwu1 : w.1 ≠ u.1 := fun h => hwu (Subtype.ext h)
        rw [Pi.single_eq_of_ne hwu1 1, Pi.single_eq_of_ne hwu 1]
    have h_res_ℝ : (fun w : W' => e_u_ℝ w.1) = ι_std (b_ℤ u) := by
      ext w
      change (e_u w.1 : ℝ) = (b_ℤ u w : ℝ)
      rw [← h_res_ℤ]
    rw [← h_res_ℝ, hτ_ℝ e_u_ℝ h_sum_ℝ, ← h_res_ℤ, hτ_ℤ e_u h_sum_ℤ]
    rfl
  have h_intertwine_τ : ∀ v : W' → ℤ, τ_ℝ (ι_std v) = ι_std (τ_ℤ v) :=
    fun v => LinearMap.congr_fun h_intertwine_τ_hom v
  have h_intertwine_pow : ∀ (k : ℕ) (v : W' → ℤ), (τ_ℝ ^ k) (ι_std v) = ι_std ((τ_ℤ ^ k) v) := by
    intro k
    induction k with
    | zero =>
      intro v
      rw [pow_zero, pow_zero, Module.End.one_apply, Module.End.one_apply]
    | succ k ih =>
      intro v
      rw [pow_succ, pow_succ, Module.End.mul_apply, Module.End.mul_apply,
        h_intertwine_τ, ih (τ_ℤ v)]
  have h_intertwine_T : ∀ v : W' → ℤ, T_ℝ (ι_std v) = ι_std (T_ℤ v) := by
    intro v
    dsimp only [T_ℝ, T_ℤ]
    rw [LinearMap.add_apply, LinearMap.add_apply, LinearMap.sub_apply, LinearMap.sub_apply,
      LinearMap.sum_apply, LinearMap.sum_apply, Module.End.one_apply, Module.End.one_apply,
      map_add, map_sub, map_sum, h_intertwine_τ]
    simp_rw [h_intertwine_pow]
    rfl
  have hT_ℤ_inj : Function.Injective T_ℤ.toAddMonoidHom := by
    intro u v huv
    apply hι_inj
    apply hT_inj
    change T_ℝ (ι_std u) = T_ℝ (ι_std v)
    rw [h_intertwine_T u, h_intertwine_T v]
    exact congrArg ι_std huv
  have h_mat_std :
      (Int.castRingHom ℝ).mapMatrix (LinearMap.toMatrix b_ℤ b_ℤ T_ℤ) =
        LinearMap.toMatrix b_ℝ b_ℝ T_ℝ := by
    ext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, LinearMap.toMatrix_apply, LinearMap.toMatrix_apply]
    have hbj : b_ℝ j = ι_std (b_ℤ j) := by
      ext w
      dsimp [b_ℝ, b_ℤ, ι_std]
      rw [Pi.basisFun_apply, Pi.basisFun_apply]
      by_cases hwj : w = j
      · subst hwj; simp
      · rw [Pi.single_eq_of_ne hwj, Pi.single_eq_of_ne hwj, Int.cast_zero]
    rw [hbj, h_intertwine_T (b_ℤ j)]
    dsimp [b_ℝ, b_ℤ, ι_std]
    rw [Pi.basisFun_repr, Pi.basisFun_repr]
  have h_det_std : ((LinearMap.det T_ℤ : ℤ) : ℝ) = LinearMap.det T_ℝ := by
    rw [← LinearMap.det_toMatrix b_ℤ T_ℤ, ← LinearMap.det_toMatrix b_ℝ T_ℝ, ← h_mat_std]
    exact RingHom.map_det (Int.castRingHom ℝ) (LinearMap.toMatrix b_ℤ b_ℤ T_ℤ)
  let e_ℤ : (W' → ℤ) ≃ₗ[ℤ] ↥(LinearMap.range T_ℤ) :=
    LinearEquiv.ofInjective T_ℤ hT_ℤ_inj
  let b_N_ℤ : Module.Basis W' ℤ ↥(T_ℤ.toAddMonoidHom.range) := b_ℤ.map e_ℤ
  have h_idx_ℤ : T_ℤ.toAddMonoidHom.range.index = (LinearMap.det T_ℤ).natAbs := by
    rw [AddSubgroup.index_eq_natAbs_det b_ℤ T_ℤ.toAddMonoidHom.range b_N_ℤ]
    have h_comp_ℤ : (fun x => (b_N_ℤ x : W' → ℤ)) = ⇑T_ℤ ∘ ⇑b_ℤ := by
      ext x w
      rfl
    rw [h_comp_ℤ, Module.Basis.det_comp b_ℤ T_ℤ b_ℤ, Module.Basis.det_self b_ℤ, mul_one]
  let Λ₁ := NumberField.Units.unitLattice E
  let T_Λ : ↥Λ₁ →ₗ[ℤ] ↥Λ₁ := (T_ℝ.restrictScalars ℤ).restrict hT_mem
  let b₁ := NumberField.Units.basisUnitLattice E
  let b₁_ℝ := Module.Basis.ofZLatticeBasis ℝ Λ₁ b₁
  have h_mat_unit :
      (Int.castRingHom ℝ).mapMatrix (LinearMap.toMatrix b₁ b₁ T_Λ) =
        LinearMap.toMatrix b₁_ℝ b₁_ℝ T_ℝ := by
    ext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, LinearMap.toMatrix_apply, LinearMap.toMatrix_apply]
    have h_app : T_ℝ (b₁_ℝ j) = (T_Λ (b₁ j) : NumberField.Units.dirichletUnitTheorem.logSpace E) := by
      dsimp [b₁_ℝ, T_Λ]
      rw [Module.Basis.ofZLatticeBasis_apply]
    rw [h_app]
    dsimp [b₁_ℝ]
    rw [Module.Basis.ofZLatticeBasis_repr_apply]
  have h_det_unit_ℝ : ((LinearMap.det T_Λ : ℤ) : ℝ) = LinearMap.det T_ℝ := by
    rw [← LinearMap.det_toMatrix b₁ T_Λ, ← LinearMap.det_toMatrix b₁_ℝ T_ℝ, ← h_mat_unit]
    exact RingHom.map_det (Int.castRingHom ℝ) (LinearMap.toMatrix b₁ b₁ T_Λ)
  have h_det_eq : LinearMap.det T_ℤ = LinearMap.det T_Λ :=
    Int.cast_injective (h_det_std.trans h_det_unit_ℝ.symm)
  have hT_Λ_inj : Function.Injective T_Λ := by
    intro x y hxy
    apply Subtype.ext
    apply hT_inj
    exact congrArg Subtype.val hxy
  have h_sub_range :
      (AddSubgroup.map T_ℝ.toAddMonoidHom Λ₁.toAddSubgroup).addSubgroupOf Λ₁.toAddSubgroup =
        T_Λ.toAddMonoidHom.range := by
    ext ⟨y, hy⟩
    simp only [AddSubgroup.mem_addSubgroupOf, AddSubgroup.mem_map, AddMonoidHom.mem_range,
      LinearMap.toAddMonoidHom_coe, Subtype.ext_iff]
    constructor
    · rintro ⟨x, hx, hxy⟩
      exact ⟨⟨x, hx⟩, hxy⟩
    · rintro ⟨⟨x, hx⟩, hxy⟩
      exact ⟨x, hx, hxy⟩
  let e_Λ : ↥Λ₁ ≃ₗ[ℤ] ↥(LinearMap.range T_Λ) :=
    LinearEquiv.ofInjective T_Λ hT_Λ_inj
  let b_N_Λ : Module.Basis (Fin (NumberField.Units.rank E)) ℤ ↥(T_Λ.toAddMonoidHom.range) :=
    b₁.map e_Λ
  have h_idx_Λ :
      (AddSubgroup.map T_ℝ.toAddMonoidHom Λ₁.toAddSubgroup).relIndex Λ₁.toAddSubgroup =
        (LinearMap.det T_Λ).natAbs := by
    change ((AddSubgroup.map T_ℝ.toAddMonoidHom Λ₁.toAddSubgroup).addSubgroupOf Λ₁.toAddSubgroup).index =
      (LinearMap.det T_Λ).natAbs
    rw [h_sub_range, AddSubgroup.index_eq_natAbs_det b₁ T_Λ.toAddMonoidHom.range b_N_Λ]
    have h_comp_Λ : (fun x => (b_N_Λ x : ↥Λ₁)) = ⇑T_Λ ∘ ⇑b₁ := by
      ext x
      rfl
    rw [h_comp_Λ, Module.Basis.det_comp b₁ T_Λ b₁, Module.Basis.det_self b₁, mul_one]
  change T_ℤ.toAddMonoidHom.range.index =
    (AddSubgroup.map T_ℝ.toAddMonoidHom Λ₁.toAddSubgroup).relIndex Λ₁.toAddSubgroup
  rw [h_idx_ℤ, h_idx_Λ, h_det_eq]

theorem unitLattice_norm_add_diff_relIndex_eq_mul_relIndex {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hι_inj : Function.Injective (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)))
    (hι_range : (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)).range =
      (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
        Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker)
    (h_gal : ∀ u : (NumberField.RingOfIntegers E)ˣ,
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (0 : ℕ))).toMonoidHom) u = u ∧
      (∀ k : ℕ,
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom) u) ∧
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom) u)) ∧
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (Nat.card (E ≃ₐ[F] E)))).toMonoidHom) u = u ∧
      (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
        NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E))
        ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))) u) =
        ∏ k : Fin (Nat.card (E ≃ₐ[F] E)),
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ))).toMonoidHom) u)
    (τ_ℝ : NumberField.Units.dirichletUnitTheorem.logSpace E →ₗ[ℝ]
      NumberField.Units.dirichletUnitTheorem.logSpace E)
    (hτ_pow : τ_ℝ ^ (Nat.card (E ≃ₐ[F] E)) = 1)
    (hτ_equiv : ∀ u : (NumberField.RingOfIntegers E)ˣ, ∀ k : ℕ,
      NumberField.Units.logEmbedding E
        (Additive.ofMul ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom) u)) =
      (τ_ℝ ^ k) (NumberField.Units.logEmbedding E (Additive.ofMul u))) :
    Function.Injective (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℝ ^ (k : ℕ)) + (1 - τ_ℝ)).toAddMonoidHom) ∧
    (∀ x ∈ (NumberField.Units.unitLattice E).toAddSubgroup,
      (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℝ ^ (k : ℕ)) + (1 - τ_ℝ)) x) ∈
        (NumberField.Units.unitLattice E).toAddSubgroup) ∧
    (AddSubgroup.map
      (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)), τ_ℝ ^ (k : ℕ)) + (1 - τ_ℝ)).toAddMonoidHom)
      (NumberField.Units.unitLattice E).toAddSubgroup).relIndex
      (NumberField.Units.unitLattice E).toAddSubgroup =
      ((AddSubgroup.map (nsmulAddMonoidHom (Nat.card (E ≃ₐ[F] E)))
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))).relIndex
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))) *
      ((AddSubgroup.map (NumberField.Units.logEmbedding E)
        (Subgroup.toAddSubgroup
          (Subgroup.map
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))).relIndex
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))) :=
by
  let U_F := (NumberField.RingOfIntegers F)ˣ
  let U_E := (NumberField.RingOfIntegers E)ˣ
  let V := NumberField.Units.dirichletUnitTheorem.logSpace E
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  have hd_pos : 0 < d := Nat.card_pos
  have hd_ne : d ≠ 0 := hd_pos.ne'
  have hd_real_ne : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
  let ι : U_F →* U_E :=
    Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)
  let φ_N : U_E →* U_F :=
    Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
  let φ : ℕ → (U_E →* U_E) := fun k =>
    Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom
  let φ_σ : U_E →* U_E :=
    Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom
  let D : U_E →* U_E := MonoidHom.id U_E / φ_σ
  let N_E : U_E →* U_E := ι.comp φ_N
  let K_pos : Subgroup U_E := D.ker
  let K_neg : Subgroup U_E := φ_N.ker
  let ℓ := NumberField.Units.logEmbedding E
  let Λ₁ : AddSubgroup V := (NumberField.Units.unitLattice E).toAddSubgroup
  let Λ_pos : AddSubgroup V := AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_pos)
  let Λ_neg : AddSubgroup V := AddSubgroup.map ℓ (Subgroup.toAddSubgroup K_neg)
  let A_pos : AddSubgroup V := AddSubgroup.map (nsmulAddMonoidHom d) Λ_pos
  let A_neg : AddSubgroup V := AddSubgroup.map ℓ (Subgroup.toAddSubgroup (Subgroup.map D K_neg))
  let N_ℝ : V →ₗ[ℝ] V := ∑ k : Fin d, τ_ℝ ^ (k : ℕ)
  let D_ℝ : V →ₗ[ℝ] V := 1 - τ_ℝ
  let T_ℝ : V →ₗ[ℝ] V := N_ℝ + D_ℝ
  
  have h_nsmul_eq_zero : ∀ y : V, d • y = 0 → y = 0 := by
    intro y hy
    have h_smul : (d : ℝ) • y = 0 := by
      rw [Nat.cast_smul_eq_nsmul ℝ d y]
      exact hy
    exact (smul_eq_zero.mp h_smul).resolve_left hd_real_ne
  have hN_of_D_eq_zero : ∀ y : V, D_ℝ y = 0 → N_ℝ y = d • y := by
    intro y hy
    have h_sub : y - τ_ℝ y = 0 := by
      simpa only [D_ℝ, LinearMap.sub_apply, Module.End.one_apply] using hy
    have hτy : τ_ℝ y = y := (sub_eq_zero.mp h_sub).symm
    have h_pow_y : ∀ k : ℕ, (τ_ℝ ^ k) y = y := by
      intro k
      induction k with
      | zero => rw [pow_zero, Module.End.one_apply]
      | succ k ih => rw [pow_succ', Module.End.mul_apply, ih, hτy]
    change (∑ k : Fin d, τ_ℝ ^ (k : ℕ)) y = d • y
    rw [LinearMap.sum_apply]
    calc
      (∑ k : Fin d, (τ_ℝ ^ (k : ℕ)) y) = ∑ _k : Fin d, y :=
        Finset.sum_congr rfl (fun k _ => h_pow_y (k : ℕ))
      _ = d • y := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
  have hDN_zero : ∀ x : V, D_ℝ (N_ℝ x) = 0 := by
    intro x
    change D_ℝ ((∑ k : Fin d, τ_ℝ ^ (k : ℕ)) x) = 0
    rw [LinearMap.sum_apply, map_sum, Fin.sum_univ_eq_sum_range (fun k => D_ℝ ((τ_ℝ ^ k) x)) d]
    have h_term : ∀ k : ℕ, D_ℝ ((τ_ℝ ^ k) x) = (τ_ℝ ^ k) x - (τ_ℝ ^ (k + 1)) x := by
      intro k
      change (1 - τ_ℝ) ((τ_ℝ ^ k) x) = (τ_ℝ ^ k) x - (τ_ℝ ^ (k + 1)) x
      rw [LinearMap.sub_apply, Module.End.one_apply, ← Module.End.mul_apply, ← pow_succ']
    simp_rw [h_term]
    rw [Finset.sum_range_sub' (fun k => (τ_ℝ ^ k) x) d, pow_zero, hτ_pow,
      Module.End.one_apply, sub_self]
  have hND_zero : ∀ x : V, N_ℝ (D_ℝ x) = 0 := by
    intro x
    change (∑ k : Fin d, τ_ℝ ^ (k : ℕ)) (D_ℝ x) = 0
    rw [LinearMap.sum_apply, Fin.sum_univ_eq_sum_range (fun k => (τ_ℝ ^ k) (D_ℝ x)) d]
    have h_term : ∀ k : ℕ, (τ_ℝ ^ k) (D_ℝ x) = (τ_ℝ ^ k) x - (τ_ℝ ^ (k + 1)) x := by
      intro k
      change (τ_ℝ ^ k) ((1 - τ_ℝ) x) = (τ_ℝ ^ k) x - (τ_ℝ ^ (k + 1)) x
      rw [LinearMap.sub_apply, Module.End.one_apply, map_sub, ← Module.End.mul_apply, ← pow_succ]
    simp_rw [h_term]
    rw [Finset.sum_range_sub' (fun k => (τ_ℝ ^ k) x) d, pow_zero, hτ_pow,
      Module.End.one_apply, sub_self]
  have hT_inj : Function.Injective T_ℝ.toAddMonoidHom := by
    refine (injective_iff_map_eq_zero T_ℝ.toAddMonoidHom).mpr (fun x hx => ?_)
    have hx' : N_ℝ x + D_ℝ x = 0 := by
      simpa only [T_ℝ, LinearMap.toAddMonoidHom_coe, LinearMap.add_apply] using hx
    have hN_apply : N_ℝ (N_ℝ x + D_ℝ x) = 0 := by rw [hx', map_zero]
    rw [map_add, hN_of_D_eq_zero (N_ℝ x) (hDN_zero x), hND_zero x, add_zero] at hN_apply
    have hNx : N_ℝ x = 0 := h_nsmul_eq_zero (N_ℝ x) hN_apply
    have hDx : D_ℝ x = 0 := by rw [hNx, zero_add] at hx'; exact hx'
    have hd_x : d • x = 0 := by rw [← hN_of_D_eq_zero x hDx, hNx]
    exact h_nsmul_eq_zero x hd_x
  
  have hΛ₁_eq_map : Λ₁ = AddSubgroup.map ℓ ⊤ := by
    change (Submodule.map ℓ.toIntLinearMap ⊤).toAddSubgroup = AddSubgroup.map ℓ ⊤
    rw [Submodule.map_top, LinearMap.range_toAddSubgroup]
    exact AddMonoidHom.range_eq_map ℓ
  have hΛ_pos_le : Λ_pos ≤ Λ₁ := by
    rw [hΛ₁_eq_map]; exact AddSubgroup.map_mono le_top
  have hΛ_neg_le : Λ_neg ≤ Λ₁ := by
    rw [hΛ₁_eq_map]; exact AddSubgroup.map_mono le_top
  have hN_log : ∀ u : U_E, N_ℝ (ℓ (Additive.ofMul u)) = ℓ (Additive.ofMul (N_E u)) := by
    intro u
    change (∑ k : Fin d, τ_ℝ ^ (k : ℕ)) (ℓ (Additive.ofMul u)) = ℓ (Additive.ofMul (ι (φ_N u)))
    rw [LinearMap.sum_apply]
    have h_sum :
        (∑ k : Fin d, (τ_ℝ ^ (k : ℕ)) (ℓ (Additive.ofMul u))) =
          ∑ k : Fin d, ℓ (Additive.ofMul (φ (k : ℕ) u)) :=
      Finset.sum_congr rfl (fun k _ => (hτ_equiv u (k : ℕ)).symm)
    rw [h_sum, ← map_sum, ← ofMul_prod, ← (h_gal u).2.2.2]
  have hD_log : ∀ u : U_E, D_ℝ (ℓ (Additive.ofMul u)) = ℓ (Additive.ofMul (D u)) := by
    intro u
    have hτ1 : τ_ℝ (ℓ (Additive.ofMul u)) = ℓ (Additive.ofMul (φ_σ u)) := by
      have h1 := (hτ_equiv u 1).symm
      simpa only [pow_one] using h1
    change (1 - τ_ℝ) (ℓ (Additive.ofMul u)) = ℓ (Additive.ofMul (u / φ_σ u))
    rw [LinearMap.sub_apply, Module.End.one_apply, hτ1, ← map_sub, ← ofMul_div]
  have hT_log : ∀ u : U_E, T_ℝ (ℓ (Additive.ofMul u)) = ℓ (Additive.ofMul (N_E u * D u)) := by
    intro u
    change (N_ℝ + D_ℝ) (ℓ (Additive.ofMul u)) = ℓ (Additive.ofMul (N_E u * D u))
    rw [LinearMap.add_apply, hN_log u, hD_log u, ← map_add, ← ofMul_mul]
  have hT_mem : ∀ x ∈ Λ₁, T_ℝ x ∈ Λ₁ := by
    intro x hx
    rw [hΛ₁_eq_map] at hx ⊢
    rcases hx with ⟨y, _, rfl⟩
    refine ⟨Additive.ofMul (N_E (Additive.toMul y) * D (Additive.toMul y)), trivial, ?_⟩
    exact (hT_log (Additive.toMul y)).symm
  have h_fixed_pow : ∀ u ∈ K_pos, N_E u = u ^ d := by
    intro u hu
    have hu_div : u / φ_σ u = 1 := hu
    have hu_σ : φ_σ u = u := (div_eq_one.mp hu_div).symm
    have hu_k : ∀ k : ℕ, φ k u = u := by
      intro k
      induction k with
      | zero => exact (h_gal u).1
      | succ k ih => rw [((h_gal u).2.1 k).1, hu_σ, ih]
    change ι (φ_N u) = u ^ d
    rw [(h_gal u).2.2.2]
    calc
      (∏ k : Fin d, φ (k : ℕ) u) = ∏ _k : Fin d, u :=
        Finset.prod_congr rfl (fun k _ => hu_k (k : ℕ))
      _ = u ^ d := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  have hN_on_pos : ∀ x ∈ Λ_pos, N_ℝ x = d • x := by
    rintro _ ⟨y, hy, rfl⟩
    have hu : Additive.toMul y ∈ K_pos := hy
    have h1 := hN_log (Additive.toMul y)
    rw [ofMul_toMul, h_fixed_pow (Additive.toMul y) hu, ofMul_pow, ofMul_toMul, map_nsmul] at h1
    exact h1
  have hD_on_pos : ∀ x ∈ Λ_pos, D_ℝ x = 0 := by
    rintro _ ⟨y, hy, rfl⟩
    have hu : D (Additive.toMul y) = 1 := hy
    have h1 := hD_log (Additive.toMul y)
    rw [ofMul_toMul, hu, ofMul_one, map_zero] at h1
    exact h1
  have hT_on_pos : ∀ x ∈ Λ_pos, T_ℝ x = d • x := by
    intro x hx
    change N_ℝ x + D_ℝ x = d • x
    rw [hN_on_pos x hx, hD_on_pos x hx, add_zero]
  have hA_pos_le : A_pos ≤ Λ_pos := by
    rintro _ ⟨x, hx, rfl⟩
    exact Λ_pos.nsmul_mem hx d
  have hf_pos : AddSubgroup.map T_ℝ.toAddMonoidHom Λ_pos = A_pos := by
    ext z
    simp only [A_pos, AddSubgroup.mem_map, LinearMap.toAddMonoidHom_coe, nsmulAddMonoidHom_apply]
    refine ⟨?_, ?_⟩
    · rintro ⟨x, hx, rfl⟩; exact ⟨x, hx, (hT_on_pos x hx).symm⟩
    · rintro ⟨x, hx, rfl⟩; exact ⟨x, hx, hT_on_pos x hx⟩
  have hN_ker : N_E.ker = K_neg := by
    ext u
    simp only [N_E, K_neg, MonoidHom.mem_ker, MonoidHom.comp_apply]
    exact ⟨fun h => hι_inj (by rw [h, map_one]), fun h => by rw [h, map_one]⟩
  have hN_on_neg : ∀ x ∈ Λ_neg, N_ℝ x = 0 := by
    rintro _ ⟨y, hy, rfl⟩
    have hu : N_E (Additive.toMul y) = 1 := by
      rw [← MonoidHom.mem_ker, hN_ker]; exact hy
    have h1 := hN_log (Additive.toMul y)
    rw [ofMul_toMul, hu, ofMul_one, map_zero] at h1
    exact h1
  have hf_neg : AddSubgroup.map T_ℝ.toAddMonoidHom Λ_neg = A_neg := by
    ext z
    simp only [A_neg, Λ_neg, AddSubgroup.mem_map, LinearMap.toAddMonoidHom_coe]
    refine ⟨?_, ?_⟩
    · rintro ⟨_, ⟨y, hy, rfl⟩, rfl⟩
      have hu : Additive.toMul y ∈ K_neg := hy
      refine ⟨Additive.ofMul (D (Additive.toMul y)), ⟨Additive.toMul y, hu, rfl⟩, ?_⟩
      change ℓ (Additive.ofMul (D (Additive.toMul y))) = (N_ℝ + D_ℝ) (ℓ y)
      rw [LinearMap.add_apply, hN_on_neg (ℓ y) ⟨y, hy, rfl⟩, zero_add, ← hD_log (Additive.toMul y),
        ofMul_toMul]
    · rintro ⟨w, hw, rfl⟩
      rcases hw with ⟨u, hu, hDu⟩
      refine ⟨ℓ (Additive.ofMul u), ⟨Additive.ofMul u, hu, rfl⟩, ?_⟩
      change (N_ℝ + D_ℝ) (ℓ (Additive.ofMul u)) = ℓ w
      have hw_eq : Additive.ofMul (D u) = w := by
        rw [hDu, ofMul_toMul]
      rw [LinearMap.add_apply, hN_on_neg (ℓ (Additive.ofMul u)) ⟨Additive.ofMul u, hu, rfl⟩,
        zero_add, hD_log u, hw_eq]
  have h_tele : ∀ (u : U_E) (k : ℕ), (∏ j ∈ Finset.range k, φ j (D u)) = u / φ k u := by
    intro u k
    induction k with
    | zero => rw [Finset.prod_range_zero, (h_gal u).1, div_self']
    | succ k ih =>
      have hφ_D : φ k (D u) = φ k u / φ (k + 1) u := by
        change φ k (u / φ_σ u) = φ k u / φ (k + 1) u
        rw [map_div, ← ((h_gal u).2.1 k).1]
      rw [Finset.prod_range_succ, ih, hφ_D, div_mul_div_cancel]
  have hD_range_le : D.range ≤ K_neg := by
    rintro _ ⟨u, rfl⟩
    rw [← hN_ker, MonoidHom.mem_ker]
    change ι (φ_N (D u)) = 1
    rw [(h_gal (D u)).2.2.2, Fin.prod_univ_eq_prod_range (fun j => φ j (D u)) d,
      h_tele u d, (h_gal u).2.2.1, div_self']
  have hA_neg_le : A_neg ≤ Λ_neg := by
    apply AddSubgroup.map_mono
    rintro y ⟨u, _, hDu⟩
    exact hD_range_le ⟨u, hDu⟩
  have h_disj : Λ_pos ⊓ Λ_neg = ⊥ := by
    rw [eq_bot_iff]
    intro x ⟨hx_pos, hx_neg⟩
    have hd_x : d • x = 0 := by
      rw [← hN_on_pos x hx_pos, hN_on_neg x hx_neg]
    exact h_nsmul_eq_zero x hd_x
  have hN_range_le : N_E.range ≤ K_pos := by
    rintro _ ⟨u, rfl⟩
    change N_E u ∈ D.ker
    rw [← hι_range]
    exact ⟨φ_N u, rfl⟩
  have h_nsmul : ∀ x ∈ Λ₁, d • x ∈ Λ_pos ⊔ Λ_neg := by
    intro x hx
    rw [hΛ₁_eq_map] at hx
    rcases hx with ⟨y, _, rfl⟩
    let u : U_E := Additive.toMul y
    let a : U_E := N_E u
    have ha_pos : a ∈ K_pos := hN_range_le ⟨u, rfl⟩
    let b : U_E := a⁻¹ * u ^ d
    have hb_neg : b ∈ K_neg := by
      rw [← hN_ker, MonoidHom.mem_ker]
      change N_E (a⁻¹ * u ^ d) = 1
      rw [map_mul, map_inv, map_pow, h_fixed_pow a ha_pos, inv_mul_cancel]
    have hab : a * b = u ^ d := mul_inv_cancel_left a (u ^ d)
    have h_eq : d • ℓ y = ℓ (Additive.ofMul a) + ℓ (Additive.ofMul b) := by
      calc
        d • ℓ y = d • ℓ (Additive.ofMul u) := by rw [ofMul_toMul]
        _ = ℓ (Additive.ofMul (u ^ d)) := by rw [ofMul_pow, map_nsmul]
        _ = ℓ (Additive.ofMul (a * b)) := by rw [hab]
        _ = ℓ (Additive.ofMul a) + ℓ (Additive.ofMul b) := by rw [ofMul_mul, map_add]
    rw [h_eq]
    exact AddSubgroup.add_mem_sup ⟨Additive.ofMul a, ha_pos, rfl⟩ ⟨Additive.ofMul b, hb_neg, rfl⟩
  
  let S : AddSubgroup V := Λ_pos ⊔ Λ_neg
  have hS_le : S ≤ Λ₁ := sup_le hΛ_pos_le hΛ_neg_le
  have hA_sup_le_mid : A_pos ⊔ A_neg ≤ Λ_pos ⊔ A_neg := sup_le_sup_right hA_pos_le A_neg
  have h_mid_le_S : Λ_pos ⊔ A_neg ≤ S := sup_le_sup_left hA_neg_le Λ_pos
  have h_rel_factor1 : (A_pos ⊔ A_neg).relIndex (Λ_pos ⊔ A_neg) = A_pos.relIndex Λ_pos := by
    have h_sup_eq : Λ_pos ⊔ (A_pos ⊔ A_neg) = Λ_pos ⊔ A_neg := by
      rw [← sup_assoc, sup_of_le_left hA_pos_le]
    have h_inf_bot : A_neg ⊓ Λ_pos = ⊥ := by
      rw [← le_bot_iff, ← h_disj, inf_comm]
      exact inf_le_inf_left Λ_pos hA_neg_le
    rw [← h_sup_eq, AddSubgroup.relIndex_sup_right Λ_pos (A_pos ⊔ A_neg),
      ← AddSubgroup.inf_relIndex_right (A_pos ⊔ A_neg) Λ_pos,
      sup_inf_assoc_of_le A_neg hA_pos_le, h_inf_bot, sup_bot_eq]
  have h_rel_factor2 : (Λ_pos ⊔ A_neg).relIndex S = A_neg.relIndex Λ_neg := by
    have h_sup_eq : Λ_neg ⊔ (Λ_pos ⊔ A_neg) = S := by
      dsimp [S]
      rw [sup_left_comm, sup_of_le_left hA_neg_le]
    have h_inf_bot : Λ_pos ⊓ Λ_neg = ⊥ := h_disj
    rw [← h_sup_eq, AddSubgroup.relIndex_sup_right Λ_neg (Λ_pos ⊔ A_neg),
      ← AddSubgroup.inf_relIndex_right (Λ_pos ⊔ A_neg) Λ_neg,
      sup_comm Λ_pos A_neg, sup_inf_assoc_of_le Λ_pos hA_neg_le, h_inf_bot, sup_bot_eq]
  have h_rel_sup :
      (A_pos ⊔ A_neg).relIndex S = (A_pos.relIndex Λ_pos) * (A_neg.relIndex Λ_neg) := by
    rw [← AddSubgroup.relIndex_mul_relIndex (A_pos ⊔ A_neg) (Λ_pos ⊔ A_neg) S
      hA_sup_le_mid h_mid_le_S, h_rel_factor1, h_rel_factor2]
  have hS_rel_pos : 0 < S.relIndex Λ₁ := by
    haveI : NeZero d := ⟨hd_ne⟩
    let H : AddSubgroup (Additive U_E) := AddSubgroup.comap ℓ S
    have h_rel_eq_idx : S.relIndex Λ₁ = H.index := by
      rw [hΛ₁_eq_map, ← AddSubgroup.relIndex_comap S ℓ ⊤, AddSubgroup.relIndex_top_right]
    have hH_nsmul : ∀ y : Additive U_E, d • y ∈ H := by
      intro y
      change ℓ (d • y) ∈ S
      rw [map_nsmul]
      exact h_nsmul (ℓ y) (by rw [hΛ₁_eq_map]; exact ⟨y, trivial, rfl⟩)
    letI inst_mod : Module (ZMod d) (Additive U_E ⧸ H) := QuotientAddGroup.zmodModule hH_nsmul
    haveI : Module.Finite ℤ (Additive U_E ⧸ H) := by
      change Module.Finite ℤ (Additive U_E ⧸ H.toIntSubmodule)
      exact Module.Finite.quotient ℤ H.toIntSubmodule
    haveI : IsScalarTower ℤ (ZMod d) (Additive U_E ⧸ H) := AddCommGroup.intIsScalarTower
    haveI inst_fin : Module.Finite (ZMod d) (Additive U_E ⧸ H) :=
      Module.Finite.of_restrictScalars_finite ℤ (ZMod d) (Additive U_E ⧸ H)
    haveI : Finite (Additive U_E ⧸ H) :=
      @Module.finite_of_finite (ZMod d) (Additive U_E ⧸ H) _ _ inst_mod _ inst_fin
    have h_ne : H.index ≠ 0 := AddSubgroup.index_ne_zero_of_finite
    rw [h_rel_eq_idx]
    exact Nat.pos_of_ne_zero h_ne
  let f : V →+ V := T_ℝ.toAddMonoidHom
  have hf_S : AddSubgroup.map f S = A_pos ⊔ A_neg := by
    dsimp [S]
    rw [AddSubgroup.map_sup, hf_pos, hf_neg]
  have hf_Λ₁_le : AddSubgroup.map f Λ₁ ≤ Λ₁ := by
    rintro _ ⟨x, hx, rfl⟩
    exact hT_mem x hx
  have h_chain1 :
      (S.relIndex Λ₁) * ((AddSubgroup.map f Λ₁).relIndex Λ₁) =
        (AddSubgroup.map f S).relIndex Λ₁ := by
    rw [← AddSubgroup.relIndex_map_map_of_injective S Λ₁ hT_inj]
    exact AddSubgroup.relIndex_mul_relIndex
      (AddSubgroup.map f S) (AddSubgroup.map f Λ₁) Λ₁
      (AddSubgroup.map_mono hS_le) hf_Λ₁_le
  have h_chain2 :
      ((A_pos.relIndex Λ_pos) * (A_neg.relIndex Λ_neg)) * (S.relIndex Λ₁) =
        (AddSubgroup.map f S).relIndex Λ₁ := by
    rw [← h_rel_sup, ← hf_S]
    have h_mapS_le_S : AddSubgroup.map f S ≤ S := by
      rw [hf_S]
      exact sup_le_sup hA_pos_le hA_neg_le
    exact AddSubgroup.relIndex_mul_relIndex (AddSubgroup.map f S) S Λ₁ h_mapS_le_S hS_le
  have h_rel_unit :
      (AddSubgroup.map f Λ₁).relIndex Λ₁ = (A_pos.relIndex Λ_pos) * (A_neg.relIndex Λ_neg) := by
    apply Nat.eq_of_mul_eq_mul_left hS_rel_pos
    rw [h_chain1, ← h_chain2, mul_comm]
  exact ⟨hT_inj, hT_mem, h_rel_unit⟩

theorem infinitePlace_int_pi_index_eq_mul_unit_log_relIndex_of_galRestrict_pow {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hι_inj : Function.Injective (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)))
    (hι_range : (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
      NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E)).range =
      (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
        Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker)
    (h_gal : ∀ u : (NumberField.RingOfIntegers E)ˣ,
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (0 : ℕ))).toMonoidHom) u = u ∧
      (∀ k : ℕ,
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom) u) ∧
        (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k + 1))).toMonoidHom) u =
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            ((Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ k)).toMonoidHom) u)) ∧
      (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (Nat.card (E ≃ₐ[F] E)))).toMonoidHom) u = u ∧
      (Units.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) :
        NumberField.RingOfIntegers F →* NumberField.RingOfIntegers E))
        ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))) u) =
        ∏ k : Fin (Nat.card (E ≃ₐ[F] E)),
          (Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ))).toMonoidHom) u) :
    (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)),
        (LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E)) ^ (k : ℕ)) +
      (1 - LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E))).toAddMonoidHom).range.index =
    Nat.card (E ≃ₐ[F] E) *
      ((AddSubgroup.map (nsmulAddMonoidHom (Nat.card (E ≃ₐ[F] E)))
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))).relIndex
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))) *
      ((AddSubgroup.map (NumberField.Units.logEmbedding E)
        (Subgroup.toAddSubgroup
          (Subgroup.map
            (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
            (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))).relIndex
        (AddSubgroup.map (NumberField.Units.logEmbedding E)
          (Subgroup.toAddSubgroup
            (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))) :=
by
  obtain ⟨τ_ℤ, hτ_ℤ, h_idx_place⟩ :=
    exists_int_zeroSum_galois_linearMap_and_place_index_eq (F := F) σ
  obtain ⟨τ_ℝ, hτ_pow, hτ_ℝ, hτ_equiv⟩ :=
    exists_logSpace_galois_linearMap_equivariant σ h_gal
  obtain ⟨hT_inj, hT_mem, h_rel_unit⟩ :=
    unitLattice_norm_add_diff_relIndex_eq_mul_relIndex σ hι_inj hι_range h_gal τ_ℝ hτ_pow hτ_equiv
  have h_det_bridge :=
    unitLattice_relIndex_eq_pi_int_index_of_zeroSum_galois σ τ_ℤ τ_ℝ hτ_ℤ hτ_ℝ hT_inj hT_mem
  rw [h_idx_place, h_det_bridge, h_rel_unit, mul_assoc]

theorem infinitePlace_int_pi_norm_add_diff_index_eq {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ) :
    (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)),
        (LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E)) ^ (k : ℕ)) +
      (1 - LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E))).toAddMonoidHom).range.index *
      2 ^ (Nat.card { w : NumberField.InfinitePlace F //
        w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal }) =
    (Nat.card (E ≃ₐ[F] E)) ^ (2 * Fintype.card (NumberField.InfinitePlace F)) :=
by
  classical
  have h_s1 : ∀ {X : Type u} (d : ℕ) (hd : 0 < d) (α : X → X) (hα : ∀ x : X, (α^[d]) x = x),
      (∑ k : Fin d, (LinearMap.funLeft ℤ ℤ α) ^ (k : ℕ)).toAddMonoidHom.range ≤
        (1 - LinearMap.funLeft ℤ ℤ α).toAddMonoidHom.ker ∧
      (1 - LinearMap.funLeft ℤ ℤ α).toAddMonoidHom.range =
        (∑ k : Fin d, (LinearMap.funLeft ℤ ℤ α) ^ (k : ℕ)).toAddMonoidHom.ker ∧
      AddSubgroup.map (∑ k : Fin d, (LinearMap.funLeft ℤ ℤ α) ^ (k : ℕ)).toAddMonoidHom
        (1 - LinearMap.funLeft ℤ ℤ α).toAddMonoidHom.ker =
        AddSubgroup.map (nsmulAddMonoidHom d)
          (1 - LinearMap.funLeft ℤ ℤ α).toAddMonoidHom.ker ∧
      (1 - LinearMap.funLeft ℤ ℤ α).toAddMonoidHom.ker ⊓
        (∑ k : Fin d, (LinearMap.funLeft ℤ ℤ α) ^ (k : ℕ)).toAddMonoidHom.ker = ⊥ ∧
      (∑ k : Fin d, (LinearMap.funLeft ℤ ℤ α) ^ (k : ℕ)).toAddMonoidHom.ker ⊓
        ((∑ k : Fin d, (LinearMap.funLeft ℤ ℤ α) ^ (k : ℕ)) +
          (1 - LinearMap.funLeft ℤ ℤ α)).toAddMonoidHom.range =
        AddSubgroup.map (1 - LinearMap.funLeft ℤ ℤ α).toAddMonoidHom
          (∑ k : Fin d, (LinearMap.funLeft ℤ ℤ α) ^ (k : ℕ)).toAddMonoidHom.ker := by
    intro X d hd α hα
    let τ : (X → ℤ) →ₗ[ℤ] (X → ℤ) := LinearMap.funLeft ℤ ℤ α
    let N_lin : (X → ℤ) →ₗ[ℤ] (X → ℤ) := ∑ k : Fin d, τ ^ (k : ℕ)
    let D_lin : (X → ℤ) →ₗ[ℤ] (X → ℤ) := 1 - τ
    let N : (X → ℤ) →+ (X → ℤ) := N_lin.toAddMonoidHom
    let D : (X → ℤ) →+ (X → ℤ) := D_lin.toAddMonoidHom
    have hτ_pow : ∀ (k : ℕ) (f : X → ℤ) (x : X), ((τ ^ k) f) x = f ((α^[k]) x) := by
      intro k
      induction k with
      | zero =>
        intro f x
        simp
      | succ k ih =>
        intro f x
        rw [pow_succ', Module.End.mul_apply, LinearMap.funLeft_apply, ih,
          ← Function.iterate_succ_apply]
    have hN_apply : ∀ (f : X → ℤ) (x : X), N f x = ∑ k ∈ Finset.range d, f ((α^[k]) x) := by
      intro f x
      change (∑ k : Fin d, τ ^ (k : ℕ)) f x = ∑ k ∈ Finset.range d, f ((α^[k]) x)
      rw [LinearMap.sum_apply, Finset.sum_apply, ← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun k _ => ?_
      exact hτ_pow k f x
    have hD_apply : ∀ (f : X → ℤ) (x : X), D f x = f x - f (α x) := by
      intro f x
      rfl
    have hDN : ∀ f : X → ℤ, D (N f) = 0 := by
      intro f
      ext x
      rw [Pi.zero_apply, hD_apply, hN_apply, hN_apply]
      have h_shift : (∑ k ∈ Finset.range d, f ((α^[k]) (α x))) =
          ∑ k ∈ Finset.range d, f ((α^[k + 1]) x) := by
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [Function.iterate_succ_apply]
      rw [h_shift, ← Finset.sum_sub_distrib, Finset.sum_range_sub' (fun k => f ((α^[k]) x)) d,
        Function.iterate_zero_apply, hα x, sub_self]
    have hND : ∀ f : X → ℤ, N (D f) = 0 := by
      intro f
      ext x
      rw [Pi.zero_apply, hN_apply]
      have h_term : (∑ k ∈ Finset.range d, D f ((α^[k]) x)) =
          ∑ k ∈ Finset.range d, (f ((α^[k]) x) - f ((α^[k + 1]) x)) := by
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [hD_apply, Function.iterate_succ_apply']
      rw [h_term, Finset.sum_range_sub' (fun k => f ((α^[k]) x)) d,
        Function.iterate_zero_apply, hα x, sub_self]
    have h_N_range : N.range ≤ D.ker := by
      rintro _ ⟨f, rfl⟩
      exact hDN f
    have h_D_le_N : D.range ≤ N.ker := by
      rintro _ ⟨f, rfl⟩
      exact hND f
    have h_ker_D_iter : ∀ (f : X → ℤ), f ∈ D.ker → ∀ (k : ℕ) (x : X), f ((α^[k]) x) = f x := by
      intro f hf k
      induction k with
      | zero => intro x; rfl
      | succ k ih =>
        intro x
        rw [Function.iterate_succ_apply, ih (α x)]
        have hx := congrFun hf x
        rw [Pi.zero_apply, hD_apply, sub_eq_zero] at hx
        exact hx.symm
    have h_N_on_ker_apply : ∀ f ∈ D.ker, N f = nsmulAddMonoidHom d f := by
      intro f hf
      ext x
      rw [hN_apply]
      have h_const : (∑ k ∈ Finset.range d, f ((α^[k]) x)) = ∑ _k ∈ Finset.range d, f x := by
        refine Finset.sum_congr rfl fun k _ => ?_
        exact h_ker_D_iter f hf k x
      rw [h_const, Finset.sum_const, Finset.card_range]
      rfl
    have h_N_on_ker : AddSubgroup.map N D.ker = AddSubgroup.map (nsmulAddMonoidHom d) D.ker := by
      ext g
      simp only [AddSubgroup.mem_map]
      constructor
      · rintro ⟨f, hf, rfl⟩
        exact ⟨f, hf, (h_N_on_ker_apply f hf).symm⟩
      · rintro ⟨f, hf, rfl⟩
        exact ⟨f, hf, h_N_on_ker_apply f hf⟩
    have hd_ne : (d : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hd.ne'
    have h_inf_bot : D.ker ⊓ N.ker = ⊥ := by
      rw [eq_bot_iff]
      intro f hf
      rcases hf with ⟨hfD, hfN⟩
      have hNf : N f = 0 := hfN
      rw [h_N_on_ker_apply f hfD] at hNf
      ext x
      have hx := congrFun hNf x
      change (d • f) x = 0 at hx
      rw [Pi.smul_apply, nsmul_eq_mul] at hx
      exact (mul_eq_zero.mp hx).resolve_left hd_ne
    have h_T_inf : N.ker ⊓ (N_lin + D_lin).toAddMonoidHom.range = AddSubgroup.map D N.ker := by
      apply le_antisymm
      · rintro g ⟨hgN, f, rfl⟩
        have h_eq : (N_lin + D_lin).toAddMonoidHom f = N f + D f := rfl
        rw [h_eq] at hgN ⊢
        have hNf_D : N f ∈ D.ker := h_N_range ⟨f, rfl⟩
        have hDf_N : D f ∈ N.ker := h_D_le_N ⟨f, rfl⟩
        have hNg : N (N f + D f) = 0 := hgN
        have hDf0 : N (D f) = 0 := hDf_N
        rw [map_add, hDf0, add_zero] at hNg
        have hNf_zero : N f = 0 := by
          have h_mem : N f ∈ D.ker ⊓ N.ker := ⟨hNf_D, hNg⟩
          rw [h_inf_bot, AddSubgroup.mem_bot] at h_mem
          exact h_mem
        rw [hNf_zero, zero_add]
        exact ⟨f, hNf_zero, rfl⟩
      · rintro _ ⟨f, hfN, rfl⟩
        refine ⟨h_D_le_N ⟨f, rfl⟩, f, ?_⟩
        change N f + D f = D f
        have hf0 : N f = 0 := hfN
        rw [hf0, zero_add]
    have hα_inj : Function.Injective α := by
      intro x₁ x₂ h_eq
      have h_pred : d - 1 + 1 = d := Nat.sub_add_cancel hd
      have h1 := congrArg (α^[d - 1]) h_eq
      rw [← Function.iterate_succ_apply, ← Function.iterate_succ_apply,
        Nat.succ_eq_add_one, h_pred, hα x₁, hα x₂] at h1
      exact h1
    let orb : X → Set X := fun x => { y : X | ∃ k : ℕ, (α^[k]) y = x }
    have h_orb_nonempty : ∀ x : X, (orb x).Nonempty := fun x => ⟨x, 0, rfl⟩
    have h_orb_step : ∀ x : X, orb (α x) = orb x := by
      intro x
      ext y
      simp only [orb, Set.mem_setOf_eq]
      constructor
      · rintro ⟨k, hk⟩
        refine ⟨(d - 1) + k, ?_⟩
        rw [Function.iterate_add_apply, hk, ← Function.iterate_succ_apply,
          Nat.succ_eq_add_one, Nat.sub_add_cancel hd, hα x]
      · rintro ⟨k, hk⟩
        refine ⟨k + 1, ?_⟩
        rw [Function.iterate_succ_apply', hk]
    let x₀ : X → X := fun x => (h_orb_nonempty x).some
    have hx₀_step : ∀ x : X, x₀ (α x) = x₀ x := by
      intro x
      dsimp [x₀]
      congr 1
      exact h_orb_step x
    have h_reach : ∀ x : X, ∃ k : ℕ, (α^[k]) (x₀ x) = x :=
      fun x => (h_orb_nonempty x).some_mem
    let idx : X → ℕ := fun x => Nat.find (h_reach x)
    have h_idx_spec : ∀ x : X, (α^[idx x]) (x₀ x) = x :=
      fun x => Nat.find_spec (h_reach x)
    have h_idx_min : ∀ (x : X) (k : ℕ), k < idx x → (α^[k]) (x₀ x) ≠ x :=
      fun x k hk => Nat.find_min (h_reach x) hk
    have h_idx_step_le : ∀ x : X, idx (α x) ≤ idx x + 1 := by
      intro x
      refine Nat.find_le ?_
      rw [hx₀_step x, Function.iterate_succ_apply', h_idx_spec x]
    have h_idx_step_cases : ∀ x : X, idx (α x) = idx x + 1 ∨ (idx (α x) = 0 ∧ α x = x₀ x) := by
      intro x
      by_cases h0 : idx (α x) = 0
      · right
        refine ⟨h0, ?_⟩
        have h_spec := h_idx_spec (α x)
        rw [h0, hx₀_step x, Function.iterate_zero_apply] at h_spec
        exact h_spec.symm
      · left
        have h_pos : 0 < idx (α x) := Nat.pos_of_ne_zero h0
        have h_spec := h_idx_spec (α x)
        rw [hx₀_step x, ← Nat.sub_add_cancel h_pos, Function.iterate_succ_apply'] at h_spec
        have h_pre : (α^[idx (α x) - 1]) (x₀ x) = x := hα_inj h_spec
        have h_le : idx x ≤ idx (α x) - 1 := Nat.find_le h_pre
        have h_le' := h_idx_step_le x
        omega
    have h_N_le_D : N.ker ≤ D.range := by
      intro f hfN
      let g : X → ℤ := fun x => - ∑ j ∈ Finset.range (idx x), f ((α^[j]) (x₀ x))
      refine ⟨g, ?_⟩
      ext x
      rw [hD_apply]
      rcases h_idx_step_cases x with h_succ | ⟨h_zero, h_wrap⟩
      · dsimp [g]
        rw [hx₀_step x, h_succ, Finset.sum_range_succ, h_idx_spec x]
        ring
      · dsimp [g]
        rw [hx₀_step x, h_zero, Finset.range_zero, Finset.sum_empty, neg_zero, sub_zero]
        let m : ℕ := idx x + 1
        have hm_pos : 0 < m := Nat.succ_pos _
        have hm_per : (α^[m]) (x₀ x) = x₀ x := by
          change (α^[idx x + 1]) (x₀ x) = x₀ x
          rw [Function.iterate_succ_apply', h_idx_spec x, h_wrap]
        have hm_iter_mul : ∀ (q r : ℕ), (α^[m * q + r]) (x₀ x) = (α^[r]) (x₀ x) := by
          intro q
          induction q with
          | zero => intro r; simp
          | succ q ih =>
            intro r
            rw [Nat.mul_succ, Nat.add_assoc, Nat.add_comm m r, ← Nat.add_assoc,
              Function.iterate_add_apply, hm_per, ih r]
        have h_mod_zero : d % m = 0 := by
          by_contra h_mod_ne
          have h_mod_pos : 0 < d % m := Nat.pos_of_ne_zero h_mod_ne
          have h_mod_lt : d % m < m := Nat.mod_lt d hm_pos
          have h_eq_x₀ : (α^[d % m]) (x₀ x) = x₀ x := by
            have h1 := hm_iter_mul (d / m) (d % m)
            rw [Nat.div_add_mod] at h1
            rw [← h1, hα (x₀ x)]
          have h_eq_α : α ((α^[d % m - 1]) (x₀ x)) = α x := by
            have h_step := Function.iterate_succ_apply' α (d % m - 1) (x₀ x)
            rw [Nat.succ_eq_add_one, Nat.sub_add_cancel h_mod_pos] at h_step
            rw [← h_step, h_eq_x₀, h_wrap]
          have h_pre : (α^[d % m - 1]) (x₀ x) = x := hα_inj h_eq_α
          have h_lt_idx : d % m - 1 < idx x := by omega
          exact h_idx_min x (d % m - 1) h_lt_idx h_pre
        have hd_eq : d = m * (d / m) := (Nat.div_add_mod d m).symm.trans (by rw [h_mod_zero, add_zero])
        have h_block_sum : ∀ q : ℕ,
            (∑ k ∈ Finset.range (m * q), f ((α^[k]) (x₀ x))) =
