          ∃ b₁ b₂ : NumberField.RingOfIntegers E,
            b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
            IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₁}) m₀ ∧
            IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₂}) m₀ ∧
            (u : NumberField.RingOfIntegers F) *
              Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₁ =
              Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₂ })))
    (hFin_K : Finite (
      ((Subgroup.closure { x : Eˣ |
        ∃ b : NumberField.RingOfIntegers E,
          (x : E) = algebraMap (NumberField.RingOfIntegers E) E b ∧
          IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b}) m₀ } ⊓
        (Units.map (Algebra.norm F)).ker : Subgroup Eˣ)) ⧸
      (Subgroup.map (Units.map (algebraMap (NumberField.RingOfIntegers E) E : NumberField.RingOfIntegers E →* E))
        (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker ⊔
        Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom)
          (Subgroup.closure { x : Eˣ |
            ∃ b : NumberField.RingOfIntegers E,
              (x : E) = algebraMap (NumberField.RingOfIntegers E) E b ∧
              IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b}) m₀ })).subgroupOf
        (Subgroup.closure { x : Eˣ |
          ∃ b : NumberField.RingOfIntegers E,
            (x : E) = algebraMap (NumberField.RingOfIntegers E) E b ∧
            IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b}) m₀ } ⊓
          (Units.map (Algebra.norm F)).ker))) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let ι : R_Eˣ →* Eˣ := Units.map (algebraMap R_E E : R_E →* E)
    let K_unit : Subgroup R_Eˣ := (Units.map (Algebra.intNorm R_F R_E)).ker
    let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
      ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
    let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
    let B_cop : Subgroup Eˣ :=
      Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
    let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
      ∃ b₁ b₂ : R_E,
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
    Nat.card ↥(MonoidHom.id (ClassGroup R_E) / σ_Cl).ker ≤
      Nat.card ↥ext_Cl.range *
        Nat.card (K_cop ⧸ (Subgroup.map ι K_unit ⊔ B_cop).subgroupOf K_cop) *
        Nat.card (H_unr ⧸ (Units.map (Algebra.intNorm R_F R_E)).range.subgroupOf H_unr) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
  let ι : R_Eˣ →* Eˣ := Units.map (algebraMap R_E E : R_E →* E)
  let φ_N : R_Eˣ →* R_Fˣ := Units.map (Algebra.intNorm R_F R_E)
  let K_unit : Subgroup R_Eˣ := φ_N.ker
  let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
    ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
  let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
  let B_cop : Subgroup Eˣ :=
    Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
  let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
    ∃ b₁ b₂ : R_E,
      b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
      (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
  let G_amb : Subgroup (ClassGroup R_E) := (MonoidHom.id (ClassGroup R_E) / σ_Cl).ker
  have h_intNorm_σ : ∀ b : R_E, Algebra.intNorm R_F R_E (σ_int b) = Algebra.intNorm R_F R_E b := by
    intro b
    apply FaithfulSMul.algebraMap_injective R_F F
    rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
      algebraMap_galRestrict_apply, Algebra.norm_eq_of_algEquiv]
  have h_intNorm_ne_zero : ∀ {b : R_E}, b ≠ 0 → Algebra.intNorm R_F R_E b ≠ 0 := by
    intro b hb h0
    have h1 : algebraMap R_E E b ≠ 0 :=
      (FaithfulSMul.algebraMap_injective R_E E).ne hb
    have h2 : Algebra.norm F (algebraMap R_E E b) ≠ 0 :=
      Algebra.norm_ne_zero_iff.mpr h1
    apply h2
    rw [← Algebra.algebraMap_intNorm (A := R_F), h0, map_zero]
  have h_wit : ∀ c : ↥G_amb,
      ∃ (B : Ideal R_E) (hB : B ∈ nonZeroDivisors (Ideal R_E))
        (b₁ b₂ : R_E) (u : R_Fˣ),
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.relNorm R_F B) m₀ ∧
        ClassGroup.mk0 ⟨B, hB⟩ = c.1 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        Ideal.map σ_int B * Ideal.span {b₁} = B * Ideal.span {b₂} ∧
        (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ := by
    intro c
    have hc_ker : (MonoidHom.id (ClassGroup R_E) / σ_Cl) c.1 = 1 := c.2
    rw [MonoidHom.div_apply, MonoidHom.id_apply, div_eq_one] at hc_ker
    obtain ⟨B, hB, hB_cop, hB_mk0⟩ := h_cop_rep c.1
    have hB_ne_zero : B ≠ 0 := nonZeroDivisors.ne_zero hB
    have hB_ne_bot : B ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hBσ_ne_bot : Ideal.map σ_int B ≠ ⊥ :=
      (Ideal.map_eq_bot_iff_of_injective σ_int.injective).not.mpr hB_ne_bot
    have hBσ : Ideal.map σ_int B ∈ nonZeroDivisors (Ideal R_E) :=
      mem_nonZeroDivisors_of_ne_zero (by rwa [Submodule.zero_eq_bot])
    have hBσ_cop : IsCoprime (Ideal.relNorm R_F (Ideal.map σ_int B)) m₀ := by
      rw [Ideal.relNorm_map_algEquiv]
      exact hB_cop
    have h_mk0_eq : ClassGroup.mk0 ⟨Ideal.map σ_int B, hBσ⟩ = ClassGroup.mk0 ⟨B, hB⟩ := by
      rw [← hσ_Cl B hB hBσ, hB_mk0, hc_ker.symm]
    obtain ⟨b₁, b₂, hb₁, hb₂, hc₁, hc₂, h_ideal_eq⟩ :=
      h_rep_eq (Ideal.map σ_int B) B hBσ hB hBσ_cop hB_cop h_mk0_eq
    have h_norm_ideal := congrArg (Ideal.relNorm R_F) h_ideal_eq
    rw [map_mul, map_mul, Ideal.relNorm_map_algEquiv, Ideal.relNorm_singleton,
      Ideal.relNorm_singleton] at h_norm_ideal
    have h_relNorm_ne_bot : Ideal.relNorm R_F B ≠ ⊥ :=
      (Ideal.relNorm_eq_bot_iff (R := R_F)).not.mpr hB_ne_bot
    have h_relNorm_ne_zero : Ideal.relNorm R_F B ≠ 0 := by
      rwa [Submodule.zero_eq_bot]
    have h_span_eq : Ideal.span {Algebra.intNorm R_F R_E b₁} =
        Ideal.span {Algebra.intNorm R_F R_E b₂} :=
