theorem bdd_on_Ioo_of_continuousOn_Ioc_and_tendsto_cexp_ne_zero (f : ℝ → ℂ)
    (hCont : ContinuousOn f (Set.Ioc (1 : ℝ) 2))
    (hLim : ∃ w : ℂ, w ≠ 0 ∧
      Filter.Tendsto (fun s : ℝ => Complex.exp (f s))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds w)) :
    ∃ M₂ : ℝ, ∀ s ∈ Set.Ioo (1 : ℝ) 2, ‖f s‖ ≤ M₂ :=
by
  rcases hLim with ⟨w, hw, hTendsto⟩
  let q : ℝ → ℂ := fun s => Complex.exp (f s) / w
  have hq : Filter.Tendsto q (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 1) := by
    have h1 := hTendsto.div_const w
    rwa [div_self hw] at h1
  have hq_log : Filter.Tendsto (fun s => Complex.log (q s)) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    have h1 := hq.clog Complex.one_mem_slitPlane
    rwa [Complex.log_one] at h1
  have hq_norm : Filter.Tendsto (fun s => ‖Complex.log (q s)‖) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    have h1 := hq_log.norm
    rwa [norm_zero] at h1
  have h_ev1 : {s : ℝ | q s ∈ Complex.slitPlane} ∈ nhdsWithin (1 : ℝ) (Set.Ioi 1) :=
    hq (Complex.isOpen_slitPlane.mem_nhds Complex.one_mem_slitPlane)
  have h_ev2 : {s : ℝ | ‖Complex.log (q s)‖ ≤ 1} ∈ nhdsWithin (1 : ℝ) (Set.Ioi 1) :=
    hq_norm (Iic_mem_nhds (by norm_num : (0 : ℝ) < 1))
  rcases mem_nhdsGT_iff_exists_Ioo_subset.mp (Filter.inter_mem h_ev1 h_ev2) with ⟨a, ha1, ha_sub⟩
  let δ : ℝ := min a 2
  have h1δ : 1 < δ := lt_min (Set.mem_Ioi.mp ha1) (by norm_num)
  have hδ2 : δ ≤ 2 := min_le_right a 2
  have hδa : δ ≤ a := min_le_left a 2
  have hq_slit : ∀ s ∈ Set.Ioo 1 δ, q s ∈ Complex.slitPlane := fun s hs =>
    (ha_sub ⟨hs.1, hs.2.trans_le hδa⟩).1
  have hq_log_le : ∀ s ∈ Set.Ioo 1 δ, ‖Complex.log (q s)‖ ≤ 1 := fun s hs =>
    (ha_sub ⟨hs.1, hs.2.trans_le hδa⟩).2
  let g : ℝ → ℂ := fun s => f s - Complex.log (q s)
  have hCont_f_U : ContinuousOn f (Set.Ioo 1 δ) :=
    hCont.mono (fun s hs => ⟨hs.1, hs.2.le.trans hδ2⟩)
  have hCont_q_U : ContinuousOn q (Set.Ioo 1 δ) :=
    hCont_f_U.cexp.div_const w
  have hCont_g_U : ContinuousOn g (Set.Ioo 1 δ) :=
    hCont_f_U.sub (hCont_q_U.clog hq_slit)
  have hexp_g : ∀ s ∈ Set.Ioo 1 δ, Complex.exp (g s) = w := by
    intro s hs
    have hq_ne : q s ≠ 0 := Complex.slitPlane_ne_zero (hq_slit s hs)
    dsimp [g]
    rw [Complex.exp_sub, Complex.exp_log hq_ne]
    dsimp [q]
    exact div_div_cancel₀ (Complex.exp_ne_zero (f s))
  let s₀ : ℝ := (1 + δ) / 2
  have hs₀ : s₀ ∈ Set.Ioo 1 δ := ⟨by dsimp [s₀]; linarith, by dsimp [s₀]; linarith⟩
  let d : ℝ → ℝ := fun s => ‖g s - g s₀‖
  have hCont_d : ContinuousOn d (Set.Ioo 1 δ) :=
    (hCont_g_U.sub continuousOn_const).norm
  have hd_s₀ : d s₀ = 0 := by dsimp [d]; rw [sub_self, norm_zero]
  have hd_dich : ∀ t ∈ Set.Ioo 1 δ, d t = 0 ∨ 1 < d t := by
    intro t ht
    have hexp_eq : Complex.exp (g t) = Complex.exp (g s₀) := by
      rw [hexp_g t ht, hexp_g s₀ hs₀]
    rcases Complex.exp_eq_exp_iff_exists_int.mp hexp_eq with ⟨n, hn⟩
    have hdiff : g t - g s₀ = (n : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
      rw [hn, add_sub_cancel_left]
    have hd_eq : d t = |(n : ℝ)| * (2 * Real.pi) := by
      dsimp [d]
      rw [hdiff, norm_mul, norm_mul, norm_mul, Complex.norm_intCast, Complex.norm_ofNat,
        Complex.norm_real, Complex.norm_I, mul_one, Real.norm_of_nonneg Real.pi_nonneg,
        ← Int.cast_abs]
    by_cases hn0 : n = 0
    · left
      rw [hd_eq, hn0, Int.cast_zero, abs_zero, zero_mul]
    · right
      have hn1 : (1 : ℝ) ≤ |(n : ℝ)| := by
        rw [← Int.cast_abs]
        exact_mod_cast Int.one_le_abs hn0
      have hpi : 3 < Real.pi := Real.pi_gt_three
      have h2pi : 0 < 2 * Real.pi := by linarith
      have h_le : 1 * (2 * Real.pi) ≤ |(n : ℝ)| * (2 * Real.pi) :=
        mul_le_mul_of_nonneg_right hn1 h2pi.le
      linarith
  have hg_const : ∀ s ∈ Set.Ioo 1 δ, g s = g s₀ := by
    intro s hs
    have hd0 : d s = 0 := by
      rcases hd_dich s hs with h0 | h1
      · exact h0
      · exfalso
        have h_iv := isPreconnected_Ioo.intermediate_value hs₀ hs hCont_d
        have h1_mem : (1 : ℝ) ∈ Set.Icc (d s₀) (d s) := by
          rw [hd_s₀]
          exact ⟨by norm_num, h1.le⟩
        rcases h_iv h1_mem with ⟨t, ht, hdt⟩
        rcases hd_dich t ht with ht0 | ht1 <;> linarith
    exact sub_eq_zero.mp (norm_eq_zero.mp hd0)
  have hf_U : ∀ s ∈ Set.Ioo 1 δ, ‖f s‖ ≤ ‖g s₀‖ + 1 := by
    intro s hs
    have hfs : f s = g s₀ + Complex.log (q s) := by
      rw [← hg_const s hs]
      dsimp [g]
      exact (sub_add_cancel (f s) (Complex.log (q s))).symm
    rw [hfs]
    linarith [norm_add_le (g s₀) (Complex.log (q s)), hq_log_le s hs]
  have hCont_K : ContinuousOn (fun s => ‖f s‖) (Set.Icc s₀ 2) :=
    (hCont.mono (fun s hs => ⟨hs₀.1.trans_le hs.1, hs.2⟩)).norm
  rcases bddAbove_def.mp (isCompact_Icc.bddAbove_image hCont_K) with ⟨M_K, hM_K⟩
  refine ⟨max (‖g s₀‖ + 1) M_K, fun s hs => ?_⟩
  rcases lt_or_ge s δ with hlt | hge
  · exact (hf_U s ⟨hs.1, hlt⟩).trans (le_max_left _ _)
  · have hs_K : s ∈ Set.Icc s₀ 2 := ⟨hs₀.2.le.trans hge, hs.2.le⟩
    exact (hM_K (‖f s‖) ⟨s, hs_K, rfl⟩).trans (le_max_right _ _)

theorem continuousOn_Ioc_char_log_euler_sum {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (χ : (E ≃ₐ[F] E) →* ℂˣ) :
    ContinuousOn
      (fun s : ℝ =>
        ∑ ρ : E ≃ₐ[F] E,
          (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
              IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
            -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
              (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ))))
      (Set.Ioc (1 : ℝ) 2) :=
by
  have h_exists_i :
      ∃ i : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
          Fin (Module.finrank ℚ F),
        ∀ q₁ q₂, Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal → i q₁ = i q₂ → q₁ = q₂ := by
    have hp_max (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
        (Ideal.under ℤ q.asIdeal).IsMaximal := by
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      exact Ideal.IsMaximal.under ℤ q.asIdeal
    have hp_ne_bot (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
        Ideal.under ℤ q.asIdeal ≠ ⊥ :=
      Ideal.under_ne_bot ℤ q.ne_bot
    have h_over (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
        q.asIdeal ∈ (Ideal.under ℤ q.asIdeal).primesOver (NumberField.RingOfIntegers F) :=
      ⟨q.isPrime, ⟨rfl⟩⟩
    let idx (P : Ideal ℤ) (hP_max : P.IsMaximal) (hP_ne : P ≠ ⊥)
        (Q : Ideal (NumberField.RingOfIntegers F))
        (hQ : Q ∈ P.primesOver (NumberField.RingOfIntegers F)) : Fin (Module.finrank ℚ F) :=
      letI : P.IsMaximal := hP_max
      Fin.castLE (Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers F) ℚ F hP_ne)
        ((primesOverFinset P (NumberField.RingOfIntegers F)).equivFin
          ⟨Q, (mem_primesOverFinset_iff hP_ne (NumberField.RingOfIntegers F)).mpr hQ⟩)
    have h_idx_congr : ∀ {P₁ P₂ : Ideal ℤ} (hP : P₁ = P₂)
        (h₁_max : P₁.IsMaximal) (h₂_max : P₂.IsMaximal)
        (h₁_ne : P₁ ≠ ⊥) (h₂_ne : P₂ ≠ ⊥)
        (Q : Ideal (NumberField.RingOfIntegers F))
        (hQ₁ : Q ∈ P₁.primesOver (NumberField.RingOfIntegers F))
        (hQ₂ : Q ∈ P₂.primesOver (NumberField.RingOfIntegers F)),
        idx P₁ h₁_max h₁_ne Q hQ₁ = idx P₂ h₂_max h₂_ne Q hQ₂ := by
      rintro P₁ _ rfl _ _ _ _ Q _ _
      rfl
    refine ⟨fun q => idx (Ideal.under ℤ q.asIdeal) (hp_max q) (hp_ne_bot q) q.asIdeal (h_over q), ?_⟩
    intro q₁ q₂ hp_eq hi_eq
    have hQ₁_over₂ : q₁.asIdeal ∈ (Ideal.under ℤ q₂.asIdeal).primesOver (NumberField.RingOfIntegers F) :=
      hp_eq ▸ h_over q₁
    have h_idx_eq : idx (Ideal.under ℤ q₂.asIdeal) (hp_max q₂) (hp_ne_bot q₂) q₁.asIdeal hQ₁_over₂ =
        idx (Ideal.under ℤ q₂.asIdeal) (hp_max q₂) (hp_ne_bot q₂) q₂.asIdeal (h_over q₂) := by
      rw [← h_idx_congr hp_eq (hp_max q₁) (hp_max q₂) (hp_ne_bot q₁) (hp_ne_bot q₂)
        q₁.asIdeal (h_over q₁) hQ₁_over₂]
      exact hi_eq
    letI : (Ideal.under ℤ q₂.asIdeal).IsMaximal := hp_max q₂
    have h_equiv_eq := Fin.castLE_injective
      (Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers F) ℚ F (hp_ne_bot q₂)) h_idx_eq
    have h_sub_eq := ((primesOverFinset (Ideal.under ℤ q₂.asIdeal) (NumberField.RingOfIntegers F)).equivFin).injective h_equiv_eq
    exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val h_sub_eq)
  rcases h_exists_i with ⟨i, hi_inj⟩
  have h_exists_k :
      ∃ k : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ,
        Function.Injective k ∧
        ∀ q, 0 < k q ∧
          k q ≤ (2 * Module.finrank ℚ F + 1) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
    refine ⟨fun q => Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) + (i q : ℕ), ?_, ?_⟩
    · intro q₁ q₂ h_eq
      dsimp only at h_eq
      have hi₁ : (i q₁ : ℕ) < Module.finrank ℚ F := (i q₁).isLt
      have hi₂ : (i q₂ : ℕ) < Module.finrank ℚ F := (i q₂).isLt
      have h_div₁ : (Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) + (i q₁ : ℕ)) / Module.finrank ℚ F =
          Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) := by
        rw [Nat.mul_add_div hi₁.pos, Nat.div_eq_of_lt hi₁, add_zero]
      have h_div₂ : (Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) + (i q₂ : ℕ)) / Module.finrank ℚ F =
          Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) := by
        rw [Nat.mul_add_div hi₂.pos, Nat.div_eq_of_lt hi₂, add_zero]
      have hm : Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) = Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) := by
        rw [← h_div₁, ← h_div₂, h_eq]
      have hi_val : (i q₁ : ℕ) = (i q₂ : ℕ) := by
        rw [hm] at h_eq
        exact Nat.add_left_cancel h_eq
      have hp_eq : Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal := by
        rw [← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₁.asIdeal),
            ← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₂.asIdeal), hm]
      exact hi_inj q₁ q₂ hp_eq (Fin.ext hi_val)
    · intro q
      have h_card_eq : Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) = Ideal.absNorm q.asIdeal := by
        rw [← Submodule.cardQuot_apply, ← Ideal.absNorm_apply]
      have h_one_lt : 1 < Ideal.absNorm q.asIdeal :=
        NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
      have h_card_pos : 1 ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by omega
      have h_dvd : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ∣ Ideal.absNorm q.asIdeal :=
        Int.absNorm_under_dvd_absNorm q.asIdeal
      have hm_pos : 0 < Ideal.absNorm (Ideal.under ℤ q.asIdeal) :=
        Nat.pos_of_dvd_of_pos h_dvd (by omega)
      have hm_le : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
        rw [h_card_eq]
        exact Nat.le_of_dvd (by omega) h_dvd
      have hi_lt : (i q : ℕ) < Module.finrank ℚ F := (i q).isLt
      constructor
      · exact Nat.add_pos_left (Nat.mul_pos hi_lt.pos hm_pos) (i q : ℕ)
      · have h1 : Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) ≤
            Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
          Nat.mul_le_mul_left _ hm_le
        have h2 : (i q : ℕ) ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
          calc (i q : ℕ) ≤ Module.finrank ℚ F := hi_lt.le
            _ = Module.finrank ℚ F * 1 := (Nat.mul_one _).symm
            _ ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
              Nat.mul_le_mul_left _ h_card_pos
        calc Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) + (i q : ℕ)
            ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) +
                Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
              Nat.add_le_add h1 h2
          _ ≤ (2 * Module.finrank ℚ F + 1) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
              have : Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) +
                  Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) =
                  (2 * Module.finrank ℚ F) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by ring
              rw [this]
              exact Nat.mul_le_mul_right _ (by omega)
  rcases h_exists_k with ⟨k, hk_inj, hk_bounds⟩
  have h_summable : ∀ {a : ℝ}, 1 < a →
      Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
        ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-a))) := by
    intro a ha
    let C : ℝ := 2 * (Module.finrank ℚ F : ℝ) + 1
    have hC_pos : 0 < C := by positivity
    have h_dom : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
        (C ^ a) * ((k q : ℝ) ^ (-a))) := by
      have h_nat : Summable (fun n : ℕ => (n : ℝ) ^ (-a)) :=
        Real.summable_nat_rpow.mpr (by linarith)
      exact (h_nat.mul_left (C ^ a)).comp_injective hk_inj
    refine Summable.of_nonneg_of_le (fun q => by positivity) (fun q => ?_) h_dom
    obtain ⟨hk_pos, hk_le⟩ := hk_bounds q
    have h_card_pos : 0 < Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
      by_contra h_zero
      have h0 : Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) = 0 := by omega
      rw [h0, mul_zero] at hk_le
      omega
    have hk_pos_real : (0 : ℝ) < (k q : ℝ) := Nat.cast_pos.mpr hk_pos
    have h_card_pos_real : (0 : ℝ) < (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) :=
      Nat.cast_pos.mpr h_card_pos
    have hk_le_real : (k q : ℝ) ≤ C * (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) := by
      dsimp only [C]
      exact_mod_cast hk_le
    have h_rpow_le : ((C * (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ)) ^ (-a)) ≤ (k q : ℝ) ^ (-a) :=
      Real.rpow_le_rpow_of_nonpos hk_pos_real hk_le_real (by linarith)
    rw [Real.mul_rpow hC_pos.le h_card_pos_real.le] at h_rpow_le
    have h_mul := mul_le_mul_of_nonneg_left h_rpow_le (Real.rpow_pos_of_pos hC_pos a).le
    rw [← mul_assoc, ← Real.rpow_add hC_pos, add_neg_cancel, Real.rpow_zero, one_mul] at h_mul
    exact h_mul
  have h_prime_char : ∀ (ρ : E ≃ₐ[F] E)
      (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
      ‖(χ ρ : ℂ)‖ = 1 ∧
      (2 : ℝ) ≤ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) := by
    intro ρ q
    refine ⟨?_, ?_⟩
    · have h_pow : (χ ρ : ℂ) ^ Fintype.card (E ≃ₐ[F] E) = 1 := by
        rw [← Units.val_pow_eq_pow_val, ← map_pow, pow_card_eq_one, map_one, Units.val_one]
      exact Complex.norm_eq_one_of_pow_eq_one h_pow Fintype.card_ne_zero
    · have h_norm_eq : Ideal.absNorm q.asIdeal = Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
        rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
      have h_gt1 : 1 < Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
        rw [← h_norm_eq]
        exact NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
      have h_ge2_nat : 2 ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := h_gt1
      exact_mod_cast h_ge2_nat
  have h_term : ∀ (b : ℝ) (hb : 2 ≤ b) (u : ℂ) (hu : ‖u‖ = 1) {a : ℝ} (ha : 1 < a),
      ContinuousOn (fun s : ℝ => -Complex.log (1 - u * ((b ^ (-s) : ℝ) : ℂ))) (Set.Ici a) ∧
      ∀ s ∈ Set.Ici a,
        ‖-Complex.log (1 - u * ((b ^ (-s) : ℝ) : ℂ))‖ ≤ (3 / 2 : ℝ) * (b ^ (-a)) := by
    intro b hb u hu a ha
    have hb_pos : 0 < b := by linarith
    have hb_nonneg : 0 ≤ b := hb_pos.le
    have hb_ne : b ≠ 0 := hb_pos.ne'
    have hb_ge1 : 1 ≤ b := by linarith
    have h_rpow_bounds : ∀ s ∈ Set.Ici a,
        0 ≤ b ^ (-s) ∧ b ^ (-s) ≤ b ^ (-a) ∧ b ^ (-a) ≤ 1 / 2 := by
      intro s hs
      have hsa : a ≤ s := hs
      refine ⟨Real.rpow_nonneg hb_nonneg (-s),
        Real.rpow_le_rpow_of_exponent_le hb_ge1 (by linarith), ?_⟩
      have h_le_m1 : b ^ (-a) ≤ b ^ (-1 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le hb_ge1 (by linarith)
      have h_m1_le_half : b ^ (-1 : ℝ) ≤ (2 : ℝ) ^ (-1 : ℝ) :=
        Real.rpow_le_rpow_of_nonpos (by norm_num) hb (by norm_num)
      exact h_le_m1.trans (h_m1_le_half.trans_eq (by norm_num))
    have h_norm_z : ∀ s ∈ Set.Ici a,
        ‖u * ((b ^ (-s) : ℝ) : ℂ)‖ = b ^ (-s) := by
      intro s hs
      rw [norm_mul, hu, one_mul, Complex.norm_real, Real.norm_of_nonneg (h_rpow_bounds s hs).1]
    refine ⟨?_, ?_⟩
    · have h_cont_rpow : Continuous (fun s : ℝ => b ^ (-s)) :=
        continuous_const.rpow continuous_id.neg (fun _ => Or.inl hb_ne)
      have h_cont_inner : Continuous (fun s : ℝ => (1 : ℂ) - u * ((b ^ (-s) : ℝ) : ℂ)) :=
        continuous_const.sub (continuous_const.mul (Complex.continuous_ofReal.comp h_cont_rpow))
      have h_slit : ∀ s ∈ Set.Ici a, (1 : ℂ) - u * ((b ^ (-s) : ℝ) : ℂ) ∈ Complex.slitPlane := by
        intro s hs
        rw [Complex.mem_slitPlane_iff]
        left
        rw [Complex.sub_re, Complex.one_re]
        have h_re : (u * ((b ^ (-s) : ℝ) : ℂ)).re ≤ ‖u * ((b ^ (-s) : ℝ) : ℂ)‖ :=
          Complex.re_le_norm _
        have h_le_half : ‖u * ((b ^ (-s) : ℝ) : ℂ)‖ ≤ 1 / 2 := by
          rw [h_norm_z s hs]
          exact (h_rpow_bounds s hs).2.1.trans (h_rpow_bounds s hs).2.2
        linarith
      exact (h_cont_inner.continuousOn.clog h_slit).neg
    · intro s hs
      have h_neg_norm : ‖-(u * ((b ^ (-s) : ℝ) : ℂ))‖ ≤ 1 / 2 := by
        rw [norm_neg, h_norm_z s hs]
        exact (h_rpow_bounds s hs).2.1.trans (h_rpow_bounds s hs).2.2
      have h_log := Complex.norm_log_one_add_half_le_self h_neg_norm
      rw [norm_neg, ← sub_eq_add_neg, h_norm_z s hs] at h_log
      rw [norm_neg]
      exact h_log.trans (mul_le_mul_of_nonneg_left (h_rpow_bounds s hs).2.1 (by norm_num))
  have h_crux : ∀ {ι : Type u} (f : ι → ℝ → ℂ) (M : ℝ → ι → ℝ),
      (∀ {a : ℝ}, 1 < a → ∀ i : ι, ContinuousOn (f i) (Set.Ici a)) →
      (∀ {a : ℝ}, 1 < a → Summable (M a)) →
      (∀ {a : ℝ}, 1 < a → ∀ i : ι, ∀ s ∈ Set.Ici a, ‖f i s‖ ≤ M a i) →
      ContinuousOn (fun s : ℝ => ∑' i : ι, f i s) (Set.Ioc (1 : ℝ) 2) := by
    intro ι f M hCont hSum hBound s₀ hs₀
    let a : ℝ := (1 + s₀) / 2
    have ha : 1 < a := by dsimp [a]; linarith [hs₀.1]
    have ha_lt : a < s₀ := by dsimp [a]; linarith [hs₀.1]
    have h_Ici : ContinuousOn (fun s : ℝ => ∑' i : ι, f i s) (Set.Ici a) :=
      continuousOn_tsum (hCont ha) (hSum ha) (hBound ha)
    exact (h_Ici.continuousAt (Ici_mem_nhds ha_lt)).continuousWithinAt
  refine continuousOn_finset_sum Finset.univ (fun ρ _ => ?_)
  let S : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
    { q | IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} }
  refine h_crux
    (fun (q : S) (s : ℝ) =>
      -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
        (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))
    (fun (a : ℝ) (q : S) =>
      (3 / 2 : ℝ) * ((Nat.card (NumberField.RingOfIntegers F ⧸
        (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-a)))
    (fun {a} ha q => ?_)
    (fun {a} ha => ((h_summable ha).subtype S).mul_left (3 / 2 : ℝ))
    (fun {a} ha q s hs => ?_)
  · obtain ⟨hu, hb⟩ := h_prime_char ρ q.1
    exact (h_term _ hb (χ ρ : ℂ) hu ha).1
  · obtain ⟨hu, hb⟩ := h_prime_char ρ q.1
    exact (h_term _ hb (χ ρ : ℂ) hu ha).2 s hs

theorem exists_local_frob_char_and_euler_sum_eq_tsum {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (χ : (E ≃ₐ[F] E) →* ℂˣ) :
    ∃ α : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℂ,
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F), ‖α q‖ ≤ 1) ∧
      (∀ (ρ : E ≃ₐ[F] E) (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
        IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {ρ} → α q = (χ ρ : ℂ)) ∧
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        ¬ IsUnramifiedAtPrime F E q → α q = 0) ∧
      (∀ {s : ℝ}, 1 < s →
        (∑ ρ : E ≃ₐ[F] E,
          (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
              IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
            -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
              (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))) =
        (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          -Complex.log (1 - α q * (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))) :=
by
  classical
  have h_exists_i :
      ∃ i : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
          Fin (Module.finrank ℚ F),
        ∀ q₁ q₂, Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal → i q₁ = i q₂ → q₁ = q₂ := by
    have hp_max (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
        (Ideal.under ℤ q.asIdeal).IsMaximal := by
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      exact Ideal.IsMaximal.under ℤ q.asIdeal
    have hp_ne_bot (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
        Ideal.under ℤ q.asIdeal ≠ ⊥ :=
      Ideal.under_ne_bot ℤ q.ne_bot
    have h_over (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
        q.asIdeal ∈ (Ideal.under ℤ q.asIdeal).primesOver (NumberField.RingOfIntegers F) :=
      ⟨q.isPrime, ⟨rfl⟩⟩
    let idx (P : Ideal ℤ) (hP_max : P.IsMaximal) (hP_ne : P ≠ ⊥)
        (Q : Ideal (NumberField.RingOfIntegers F))
        (hQ : Q ∈ P.primesOver (NumberField.RingOfIntegers F)) : Fin (Module.finrank ℚ F) :=
      letI : P.IsMaximal := hP_max
      Fin.castLE (Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers F) ℚ F hP_ne)
        ((primesOverFinset P (NumberField.RingOfIntegers F)).equivFin
          ⟨Q, (mem_primesOverFinset_iff hP_ne (NumberField.RingOfIntegers F)).mpr hQ⟩)
    have h_idx_congr : ∀ {P₁ P₂ : Ideal ℤ} (hP : P₁ = P₂)
        (h₁_max : P₁.IsMaximal) (h₂_max : P₂.IsMaximal)
        (h₁_ne : P₁ ≠ ⊥) (h₂_ne : P₂ ≠ ⊥)
        (Q : Ideal (NumberField.RingOfIntegers F))
        (hQ₁ : Q ∈ P₁.primesOver (NumberField.RingOfIntegers F))
        (hQ₂ : Q ∈ P₂.primesOver (NumberField.RingOfIntegers F)),
        idx P₁ h₁_max h₁_ne Q hQ₁ = idx P₂ h₂_max h₂_ne Q hQ₂ := by
      rintro P₁ _ rfl _ _ _ _ Q _ _
      rfl
    refine ⟨fun q => idx (Ideal.under ℤ q.asIdeal) (hp_max q) (hp_ne_bot q) q.asIdeal (h_over q), ?_⟩
    intro q₁ q₂ hp_eq hi_eq
    have hQ₁_over₂ : q₁.asIdeal ∈ (Ideal.under ℤ q₂.asIdeal).primesOver (NumberField.RingOfIntegers F) :=
      hp_eq ▸ h_over q₁
    have h_idx_eq : idx (Ideal.under ℤ q₂.asIdeal) (hp_max q₂) (hp_ne_bot q₂) q₁.asIdeal hQ₁_over₂ =
        idx (Ideal.under ℤ q₂.asIdeal) (hp_max q₂) (hp_ne_bot q₂) q₂.asIdeal (h_over q₂) := by
      rw [← h_idx_congr hp_eq (hp_max q₁) (hp_max q₂) (hp_ne_bot q₁) (hp_ne_bot q₂)
        q₁.asIdeal (h_over q₁) hQ₁_over₂]
      exact hi_eq
    letI : (Ideal.under ℤ q₂.asIdeal).IsMaximal := hp_max q₂
    have h_equiv_eq := Fin.castLE_injective
      (Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers F) ℚ F (hp_ne_bot q₂)) h_idx_eq
    have h_sub_eq := ((primesOverFinset (Ideal.under ℤ q₂.asIdeal) (NumberField.RingOfIntegers F)).equivFin).injective h_equiv_eq
    exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val h_sub_eq)
  rcases h_exists_i with ⟨i, hi_inj⟩
  have h_exists_k :
      ∃ k : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ,
        Function.Injective k ∧
        ∀ q, 0 < k q ∧
          k q ≤ (2 * Module.finrank ℚ F + 1) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
    refine ⟨fun q => Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) + (i q : ℕ), ?_, ?_⟩
    · intro q₁ q₂ h_eq
      dsimp only at h_eq
      have hi₁ : (i q₁ : ℕ) < Module.finrank ℚ F := (i q₁).isLt
      have hi₂ : (i q₂ : ℕ) < Module.finrank ℚ F := (i q₂).isLt
      have h_div₁ : (Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) + (i q₁ : ℕ)) / Module.finrank ℚ F =
          Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) := by
        rw [Nat.mul_add_div hi₁.pos, Nat.div_eq_of_lt hi₁, add_zero]
      have h_div₂ : (Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) + (i q₂ : ℕ)) / Module.finrank ℚ F =
          Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) := by
        rw [Nat.mul_add_div hi₂.pos, Nat.div_eq_of_lt hi₂, add_zero]
      have hm : Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) = Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) := by
        rw [← h_div₁, ← h_div₂, h_eq]
      have hi_val : (i q₁ : ℕ) = (i q₂ : ℕ) := by
        rw [hm] at h_eq
        exact Nat.add_left_cancel h_eq
      have hp_eq : Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal := by
        rw [← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₁.asIdeal),
            ← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₂.asIdeal), hm]
      exact hi_inj q₁ q₂ hp_eq (Fin.ext hi_val)
    · intro q
      have h_card_eq : Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) = Ideal.absNorm q.asIdeal := by
        rw [← Submodule.cardQuot_apply, ← Ideal.absNorm_apply]
      have h_one_lt : 1 < Ideal.absNorm q.asIdeal :=
        NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
      have h_card_pos : 1 ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by omega
      have h_dvd : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ∣ Ideal.absNorm q.asIdeal :=
        Int.absNorm_under_dvd_absNorm q.asIdeal
      have hm_pos : 0 < Ideal.absNorm (Ideal.under ℤ q.asIdeal) :=
        Nat.pos_of_dvd_of_pos h_dvd (by omega)
      have hm_le : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
        rw [h_card_eq]
        exact Nat.le_of_dvd (by omega) h_dvd
      have hi_lt : (i q : ℕ) < Module.finrank ℚ F := (i q).isLt
      constructor
      · exact Nat.add_pos_left (Nat.mul_pos hi_lt.pos hm_pos) (i q : ℕ)
      · have h1 : Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) ≤
            Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
          Nat.mul_le_mul_left _ hm_le
        have h2 : (i q : ℕ) ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
          calc (i q : ℕ) ≤ Module.finrank ℚ F := hi_lt.le
            _ = Module.finrank ℚ F * 1 := (Nat.mul_one _).symm
            _ ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
              Nat.mul_le_mul_left _ h_card_pos
        calc Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) + (i q : ℕ)
            ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) +
                Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
              Nat.add_le_add h1 h2
          _ ≤ (2 * Module.finrank ℚ F + 1) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
              have : Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) +
                  Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) =
                  (2 * Module.finrank ℚ F) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by ring
              rw [this]
              exact Nat.mul_le_mul_right _ (by omega)
  rcases h_exists_k with ⟨k, hk_inj, hk_bounds⟩
  have h_summable : ∀ {t : ℝ}, 1 < t →
      Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
        ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-t))) := by
    intro t ht
    let C : ℝ := 2 * (Module.finrank ℚ F : ℝ) + 1
    have hC_pos : 0 < C := by positivity
    have h_dom : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
        (C ^ t) * ((k q : ℝ) ^ (-t))) := by
      have h_nat : Summable (fun n : ℕ => (n : ℝ) ^ (-t)) :=
        Real.summable_nat_rpow.mpr (by linarith)
      exact (h_nat.mul_left (C ^ t)).comp_injective hk_inj
    refine Summable.of_nonneg_of_le (fun q => by positivity) (fun q => ?_) h_dom
    obtain ⟨hk_pos, hk_le⟩ := hk_bounds q
    have h_card_pos : 0 < Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
      by_contra h_zero
      have h0 : Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) = 0 := by omega
      rw [h0, mul_zero] at hk_le
      omega
    have hk_pos_real : (0 : ℝ) < (k q : ℝ) := Nat.cast_pos.mpr hk_pos
    have h_card_pos_real : (0 : ℝ) < (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) :=
      Nat.cast_pos.mpr h_card_pos
    have hk_le_real : (k q : ℝ) ≤ C * (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) := by
      dsimp only [C]
      exact_mod_cast hk_le
    have h_rpow_le : ((C * (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ)) ^ (-t)) ≤ (k q : ℝ) ^ (-t) :=
      Real.rpow_le_rpow_of_nonpos hk_pos_real hk_le_real (by linarith)
    rw [Real.mul_rpow hC_pos.le h_card_pos_real.le] at h_rpow_le
    have h_mul := mul_le_mul_of_nonneg_left h_rpow_le (Real.rpow_pos_of_pos hC_pos t).le
    rw [← mul_assoc, ← Real.rpow_add hC_pos, add_neg_cancel, Real.rpow_zero, one_mul] at h_mul
    exact h_mul
  have h_comm : ∀ ρ g : E ≃ₐ[F] E, ρ * g * ρ⁻¹ = g := by
    intro ρ g
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic ρ)
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic g)
    rw [← zpow_add, add_comm m n, zpow_add, mul_inv_cancel_right]
  have h_frob_singleton : ∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
      IsUnramifiedAtPrime F E q →
      ∃ g : E ≃ₐ[F] E, ∀ τ : E ≃ₐ[F] E, (FrobeniusClassAt F E q ⊆ {τ} ↔ g = τ) := by
    intro q hq
    have h_frob_iff : ∀ g : E ≃ₐ[F] E, g ∈ FrobeniusClassAt F E q ↔
        ∃ Q : Ideal (NumberField.RingOfIntegers E), Q.IsPrime ∧
          Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal ∧
          IsArithFrobAt (NumberField.RingOfIntegers F) g Q := by
      intro g
      simp only [FrobeniusClassAt, Set.mem_setOf_eq]
      refine exists_congr (fun Q => and_congr_right (fun _ => and_congr_right (fun h_under => ?_)))
      constructor
      · intro h x
        have hx := h x (g • x) rfl
        rwa [h_under]
      · intro h x z hz
        have hzx : z = g • x := Subtype.ext hz
        rw [hzx, ← h_under]
        exact h x
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    obtain ⟨Q₁, hQ₁⟩ := Ideal.nonempty_primesOver (S := NumberField.RingOfIntegers E) q.asIdeal
    have hQ₁_prime : Q₁.IsPrime := hQ₁.1
    have hQ₁_over : Q₁.LiesOver q.asIdeal := hQ₁.2
    have h_under₁ : Ideal.under (NumberField.RingOfIntegers F) Q₁ = q.asIdeal :=
      hQ₁_over.over.symm
    haveI : Q₁.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₁ q.asIdeal
    obtain ⟨g, hg₁⟩ := IsArithFrobAt.exists_of_isInvariant
      (NumberField.RingOfIntegers F) (E ≃ₐ[F] E) Q₁
    have hg_mem : g ∈ FrobeniusClassAt F E q :=
      (h_frob_iff g).mpr ⟨Q₁, hQ₁_prime, h_under₁, hg₁⟩
    refine ⟨g, fun τ => ⟨fun h_sub => Set.mem_singleton_iff.mp (h_sub hg_mem), ?_⟩⟩
    rintro rfl g₂ hg₂
    rw [h_frob_iff] at hg₂
    rcases hg₂ with ⟨Q₂, hQ₂_prime, h_under₂, hg₂⟩
    haveI : Q₂.LiesOver q.asIdeal := ⟨h_under₂.symm⟩
    obtain ⟨ρ, hρ⟩ := Ideal.exists_smul_eq_of_isGaloisGroup q.asIdeal Q₁ Q₂ (E ≃ₐ[F] E)
    have hg₁' : IsArithFrobAt (NumberField.RingOfIntegers F) (ρ * g * ρ⁻¹) Q₂ := by
      rw [← hρ]
      exact hg₁.conj ρ
    have h_mem := hg₁'.mul_inv_mem_inertia hg₂
    haveI : Q₂.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₂ q.asIdeal
    letI := Ideal.Quotient.field q.asIdeal
    letI := Ideal.Quotient.field Q₂
    haveI : PerfectField (NumberField.RingOfIntegers F ⧸ q.asIdeal) := PerfectField.ofFinite
    haveI : Algebra.IsSeparable (NumberField.RingOfIntegers F ⧸ q.asIdeal)
      (NumberField.RingOfIntegers E ⧸ Q₂) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    have h_card : Nat.card ((Submodule.toAddSubgroup Q₂).inertia (E ≃ₐ[F] E)) = 1 := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q₂,
        Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q₂ (E ≃ₐ[F] E)]
      exact hq Q₂ hQ₂_prime h_under₂
    have h_bot : (Submodule.toAddSubgroup Q₂).inertia (E ≃ₐ[F] E) = ⊥ :=
      Subgroup.card_eq_one.mp h_card
    rw [h_bot, Subgroup.mem_bot, mul_inv_eq_one, h_comm ρ g] at h_mem
    exact Set.mem_singleton_iff.mpr h_mem.symm
  let α : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℂ :=
    fun q => if hq : IsUnramifiedAtPrime F E q then (χ (h_frob_singleton q hq).choose : ℂ) else 0
  have h_char_norm : ∀ ρ : E ≃ₐ[F] E, ‖(χ ρ : ℂ)‖ = 1 := by
    intro ρ
    have h_pow : (χ ρ : ℂ) ^ Fintype.card (E ≃ₐ[F] E) = 1 := by
      rw [← Units.val_pow_eq_pow_val, ← map_pow, pow_card_eq_one, map_one, Units.val_one]
    exact Complex.norm_eq_one_of_pow_eq_one h_pow Fintype.card_ne_zero
  have hα_norm : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F), ‖α q‖ ≤ 1 := by
    intro q
    dsimp only [α]
    split_ifs with hq
    · exact (h_char_norm _).le
    · rw [norm_zero]
      exact zero_le_one
  have hα_unr : ∀ (ρ : E ≃ₐ[F] E) (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {ρ} → α q = (χ ρ : ℂ) := by
    intro ρ q hq h_sub
    dsimp only [α]
    rw [dif_pos hq]
    have hg : (h_frob_singleton q hq).choose = ρ :=
      ((h_frob_singleton q hq).choose_spec ρ).mp h_sub
    rw [hg]
  have hα_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      ¬ IsUnramifiedAtPrime F E q → α q = 0 := by
    intro q hq
    dsimp only [α]
    exact dif_neg hq
  refine ⟨α, hα_norm, hα_unr, hα_ram, fun {s} hs => ?_⟩
  let U : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
    { q | IsUnramifiedAtPrime F E q }
  let S (ρ : E ≃ₐ[F] E) : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
    { q | IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} }
  let x (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) : ℝ :=
    ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))
  let z (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) : ℂ :=
    α q * (x q : ℂ)
  let F_term (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) : ℂ :=
    -Complex.log (1 - z q)
  have hx_nonneg : ∀ q, 0 ≤ x q := fun q => Real.rpow_nonneg (Nat.cast_nonneg _) (-s)
  have hz_norm : ∀ q, ‖z q‖ ≤ x q := by
    intro q
    dsimp only [z]
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hx_nonneg q)]
    exact mul_le_of_le_one_left (hx_nonneg q) (hα_norm q)
  have hSum_x : Summable x := h_summable hs
  have hSum_z : Summable z := Summable.of_norm_bounded hSum_x hz_norm
  have hSum_F : Summable F_term := hSum_z.clog_one_sub.neg
  have h_supp : Function.support F_term ⊆ U := by
    intro q hq_supp
    by_contra hq_not_U
    have hα0 : α q = 0 := hα_ram q hq_not_U
    have hF0 : F_term q = 0 := by
      dsimp only [F_term, z]
      rw [hα0, zero_mul, sub_zero, Complex.log_one, neg_zero]
    exact hq_supp hF0
  have h_tsum_U : (∑' u : U, F_term u.1) = (∑' q, F_term q) :=
    tsum_subtype_eq_of_support_subset h_supp
  let π (u : U) : E ≃ₐ[F] E := (h_frob_singleton u.1 u.2).choose
  have h_π (u : U) (ρ : E ≃ₐ[F] E) : FrobeniusClassAt F E u.1 ⊆ {ρ} ↔ π u = ρ :=
    (h_frob_singleton u.1 u.2).choose_spec ρ
  let e₁ : (Σ ρ : E ≃ₐ[F] E, { u : U // π u = ρ }) ≃ U := Equiv.sigmaFiberEquiv π
  have hSum_U : Summable (fun u : U => F_term u.1) := hSum_F.subtype U
  have hSum_sigma : Summable (fun p : (Σ ρ : E ≃ₐ[F] E, { u : U // π u = ρ }) => F_term (e₁ p).1) :=
    (Equiv.summable_iff e₁).mpr hSum_U
  change (∑ ρ : E ≃ₐ[F] E, ∑' w : S ρ, -Complex.log (1 - (χ ρ : ℂ) * (x w.1 : ℂ))) = ∑' q, F_term q
  rw [← h_tsum_U, ← Equiv.tsum_eq e₁ (fun u : U => F_term u.1), Summable.tsum_sigma hSum_sigma, tsum_fintype]
  refine Finset.sum_congr rfl (fun ρ _ => ?_)
  let e₂ : { u : U // π u = ρ } ≃ S ρ :=
    { toFun := fun y => ⟨y.1.1, ⟨y.1.2, (h_π y.1 ρ).mpr y.2⟩⟩
      invFun := fun w => ⟨⟨w.1, w.2.1⟩, (h_π ⟨w.1, w.2.1⟩ ρ).mp w.2.2⟩
      left_inv := fun y => by ext; rfl
      right_inv := fun w => by ext; rfl }
  rw [← Equiv.tsum_eq e₂ (fun w : S ρ => -Complex.log (1 - (χ ρ : ℂ) * (x w.1 : ℂ)))]
  refine tsum_congr (fun y => ?_)
  change -Complex.log (1 - (χ ρ : ℂ) * (x y.1.1 : ℂ)) =
    -Complex.log (1 - α y.1.1 * (x y.1.1 : ℂ))
  rw [hα_unr ρ y.1.1 y.1.2 ((h_π y.1 ρ).mpr y.2)]

theorem tsum_finsupp_prod_pow_eq_cexp_tsum_neg_clog_one_sub {ι : Type u} (z : ι → ℂ) (x : ι → ℝ)
    (hNorm : ∀ i : ι, ‖z i‖ ≤ x i)
    (hx_lt_one : ∀ i : ι, x i < 1)
    (hSumLog : Summable (fun i : ι => -Real.log (1 - x i)))
    (hSumProd : Summable (fun f : ι →₀ ℕ => f.prod (fun i k => (x i) ^ k))) :
    (∑' f : ι →₀ ℕ, f.prod (fun i k => (z i) ^ k)) =
      Complex.exp (∑' i : ι, -Complex.log (1 - z i)) :=
by
  classical
  have hz_lt_one : ∀ i : ι, ‖z i‖ < 1 := fun i => (hNorm i).trans_lt (hx_lt_one i)
  have hSum_z : Summable z := by
    refine hSumLog.of_norm_bounded (fun i => ?_)
    have hpos : 0 < 1 - x i := sub_pos.mpr (hx_lt_one i)
    have hlog := Real.log_le_sub_one_of_pos hpos
    linarith [hNorm i]
  have hSumClog : Summable (fun i : ι => -Complex.log (1 - z i)) :=
    hSum_z.clog_one_sub.neg
  have hSumG : Summable (fun f : ι →₀ ℕ => f.prod (fun i k => (z i) ^ k)) := by
    refine hSumProd.of_norm_bounded (fun f => ?_)
    change ‖∏ i ∈ f.support, (z i) ^ (f i)‖ ≤ ∏ i ∈ f.support, (x i) ^ (f i)
    rw [norm_prod]
    refine (Finset.prod_congr rfl (fun i _ => norm_pow (z i) (f i))).le.trans ?_
    exact Finset.prod_le_prod (fun i _ => pow_nonneg (norm_nonneg (z i)) (f i))
      (fun i _ => pow_le_pow_left₀ (norm_nonneg (z i)) (hNorm i) (f i))
  have hInsert : ∀ (a : ι) (S : Finset ι), a ∉ S →
      (∑' f : { f : ι →₀ ℕ // f.support ⊆ insert a S }, f.val.prod (fun i k => (z i) ^ k)) =
        (1 - z a)⁻¹ *
          (∑' g : { g : ι →₀ ℕ // g.support ⊆ S }, g.val.prod (fun i k => (z i) ^ k)) := by
    intro a S ha
    have h_equiv : ∃ e : ℕ × { g : ι →₀ ℕ // g.support ⊆ S } ≃ { f : ι →₀ ℕ // f.support ⊆ insert a S },
        ∀ p : ℕ × { g : ι →₀ ℕ // g.support ⊆ S }, (e p).val = Finsupp.single a p.1 + p.2.val := by
      refine ⟨{
        toFun := fun p =>
          ⟨Finsupp.single a p.1 + p.2.val, by
            intro i hi
            rcases Finset.mem_union.mp (Finsupp.support_add hi) with hi1 | hi2
            · exact Finset.mem_insert.mpr (Or.inl (Finset.mem_singleton.mp (Finsupp.support_single_subset hi1)))
            · exact Finset.mem_insert_of_mem (p.2.property hi2)⟩
        invFun := fun f =>
          (f.val a, ⟨Finsupp.erase a f.val, by
            rw [Finsupp.support_erase]
            exact Finset.subset_insert_iff.mp f.property⟩)
        left_inv := by
          rintro ⟨k, g⟩
          have hga : g.val a = 0 := by
            by_contra hne
            exact ha (g.property (Finsupp.mem_support_iff.mpr hne))
          refine Prod.ext ?_ (Subtype.ext (Finsupp.ext (fun i => ?_)))
          · simp [hga]
          · by_cases hia : i = a
            · subst hia
              simp [hga]
            · simp [Finsupp.erase_ne hia]
        right_inv := by
          intro f
          ext1
          exact Finsupp.single_add_erase a f.val
      }, fun _ => rfl⟩
    rcases h_equiv with ⟨e, he⟩
    rw [← Equiv.tsum_eq e]
    have h_factor : ∀ p : ℕ × { g : ι →₀ ℕ // g.support ⊆ S },
        (e p).val.prod (fun i k => (z i) ^ k) =
          (z a) ^ p.1 * p.2.val.prod (fun i k => (z i) ^ k) := by
      rintro ⟨k, g⟩
      rw [he]
      rw [Finsupp.prod_add_index' (fun i => pow_zero (z i)) (fun i b₁ b₂ => pow_add (z i) b₁ b₂),
        Finsupp.prod_single_index (h := fun i m => (z i) ^ m) (pow_zero (z a))]
    simp_rw [h_factor]
    have hSumGeom : Summable (fun k : ℕ => (z a) ^ k) :=
      summable_geometric_of_norm_lt_one (hz_lt_one a)
    have hSumSub : Summable (fun g : { g : ι →₀ ℕ // g.support ⊆ S } => g.val.prod (fun i k => (z i) ^ k)) :=
      hSumG.subtype { g : ι →₀ ℕ | g.support ⊆ S }
    rw [← tsum_mul_tsum_of_summable_norm hSumGeom.norm hSumSub.norm,
      tsum_geometric_of_norm_lt_one (hz_lt_one a)]
  have hFin : ∀ S : Finset ι,
      (∑' f : { f : ι →₀ ℕ // f.support ⊆ S }, f.val.prod (fun i k => (z i) ^ k)) =
        Complex.exp (∑ i ∈ S, -Complex.log (1 - z i)) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      let z₀ : { f : ι →₀ ℕ // f.support ⊆ ∅ } := ⟨0, by simp⟩
      rw [tsum_eq_single z₀]
      · simp [z₀, Finsupp.prod_zero_index]
      · intro f hf
        exfalso
        apply hf
        ext1
        exact Finsupp.support_eq_empty.mp (Finset.subset_empty.mp f.property)
    | @insert a S ha ih =>
      have h_ne_zero : 1 - z a ≠ 0 := by
        intro h_eq
        have hza : z a = 1 := (sub_eq_zero.mp h_eq).symm
        have h1 : ‖z a‖ = 1 := by rw [hza, norm_one]
        exact (hz_lt_one a).ne h1
      rw [hInsert a S ha, ih, Finset.sum_insert ha, Complex.exp_add, Complex.exp_neg,
        Complex.exp_log h_ne_zero]
  have hTendstoLHS : Filter.Tendsto
      (fun S : Finset ι => ∑' f : { f : ι →₀ ℕ // f.support ⊆ S }, f.val.prod (fun i k => (z i) ^ k))
      Filter.atTop
      (nhds (∑' f : ι →₀ ℕ, f.prod (fun i k => (z i) ^ k))) := by
    let G : (ι →₀ ℕ) → ℂ := fun f => f.prod (fun i k => (z i) ^ k)
    change Filter.Tendsto (fun S : Finset ι => ∑' f : { f : ι →₀ ℕ // f.support ⊆ S }, G f.val)
      Filter.atTop (nhds (∑' f : ι →₀ ℕ, G f))
    have hSumNorm : Summable (fun f : ι →₀ ℕ => ‖G f‖) := hSumG.norm
    rw [NormedAddCommGroup.tendsto_atTop]
    intro ε hε
    rcases (NormedAddCommGroup.tendsto_atTop.mp hSumNorm.hasSum) ε hε with ⟨T₀, hT₀⟩
    have hT₀_tail : (∑' f : ι →₀ ℕ, ‖G f‖) - (∑ f ∈ T₀, ‖G f‖) < ε := by
      have h1 := hT₀ T₀ le_rfl
      rw [norm_sub_rev] at h1
      exact (Real.le_norm_self _).trans_lt h1
    let S₀ : Finset ι := T₀.biUnion Finsupp.support
    refine ⟨S₀, fun S hS => ?_⟩
    let P : Set (ι →₀ ℕ) := { f : ι →₀ ℕ | f.support ⊆ S }
    have hT₀_sub : ∀ f ∈ T₀, f.support ⊆ S :=
      fun f hf => (Finset.subset_biUnion_of_mem Finsupp.support hf).trans hS
    have h_sum_eq : (∑ f ∈ T₀, ‖G f‖) =
        ∑ f ∈ T₀.subtype (fun f : ι →₀ ℕ => f.support ⊆ S), ‖G f.val‖ :=
      (Finset.sum_subtype_of_mem (fun f : ι →₀ ℕ => ‖G f‖) hT₀_sub).symm
    have h_le_sub : (∑ f ∈ T₀.subtype (fun f : ι →₀ ℕ => f.support ⊆ S), ‖G f.val‖) ≤
        ∑' f : { f : ι →₀ ℕ // f.support ⊆ S }, ‖G f.val‖ :=
      (hSumNorm.subtype { f : ι →₀ ℕ | f.support ⊆ S }).sum_le_tsum
        (T₀.subtype (fun f : ι →₀ ℕ => f.support ⊆ S)) (fun f _ => norm_nonneg (G f.val))
    have h_sum_le : (∑ f ∈ T₀, ‖G f‖) ≤ ∑' f : P, ‖G f.val‖ := by
      rw [h_sum_eq]
      exact h_le_sub
    have h_split_norm : (∑' f : P, ‖G f.val‖) + (∑' f : ↥Pᶜ, ‖G f.val‖) = ∑' f : ι →₀ ℕ, ‖G f‖ :=
      Summable.tsum_add_tsum_compl (hSumNorm.subtype P) (hSumNorm.subtype Pᶜ)
    have h_split_G : (∑' f : P, G f.val) + (∑' f : ↥Pᶜ, G f.val) = ∑' f : ι →₀ ℕ, G f :=
      Summable.tsum_add_tsum_compl (hSumG.subtype P) (hSumG.subtype Pᶜ)
    have h_diff : (∑' f : P, G f.val) - (∑' f : ι →₀ ℕ, G f) = -(∑' f : ↥Pᶜ, G f.val) := by
      rw [← h_split_G]
      ring
    have h_norm_diff : ‖(∑' f : P, G f.val) - (∑' f : ι →₀ ℕ, G f)‖ ≤ ∑' f : ↥Pᶜ, ‖G f.val‖ := by
      rw [h_diff, norm_neg]
      exact norm_tsum_le_tsum_norm (hSumG.subtype Pᶜ).norm
    change ‖(∑' f : P, G f.val) - (∑' f : ι →₀ ℕ, G f)‖ < ε
    linarith
  simp_rw [hFin] at hTendstoLHS
  have hTendstoRHS : Filter.Tendsto
      (fun S : Finset ι => Complex.exp (∑ i ∈ S, -Complex.log (1 - z i)))
      Filter.atTop
      (nhds (Complex.exp (∑' i : ι, -Complex.log (1 - z i)))) :=
    (Complex.continuous_exp.tendsto (∑' i : ι, -Complex.log (1 - z i))).comp hSumClog.hasSum
  exact tendsto_nhds_unique hTendstoLHS hTendstoRHS

theorem tsum_finsupp_prod_eq_lSeries_and_summable {F : Type u} [Field F] [NumberField F]
    (α : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℂ)
    (hα_norm : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F), ‖α q‖ ≤ 1)
    {s : ℝ} (hs : 1 < s) :
    LSeriesSummable
      (fun n : ℕ =>
        ∑' f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
            f.prod (fun q k => (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ^ k) = n },
          f.val.prod (fun q k => (α q) ^ k))
      (s : ℂ) ∧
    (∑' f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      f.prod (fun q k => (α q * (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)) ^ k)) =
    LSeries
      (fun n : ℕ =>
        ∑' f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
            f.prod (fun q k => (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ^ k) = n },
          f.val.prod (fun q k => (α q) ^ k))
      (s : ℂ) :=
by
  classical
  have hSum : ∀ n : ℕ,
      (∑ k ∈ Finset.Icc 1 n,
        Nat.card { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = k }) =
      Nat.card { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
        Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n } := by
    intro n
    let e : (k : Finset.Icc 1 n) × { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = k.1 } ≃
        { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
          Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n } :=
      { toFun := fun ⟨⟨k, hk⟩, ⟨I, hI⟩⟩ =>
          ⟨⟨I, Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by
              dsimp at hI
              have hk1 : 1 ≤ k := (Finset.mem_Icc.mp hk).1
              omega)⟩,
            by
              dsimp at hI ⊢
              rw [hI]
              exact (Finset.mem_Icc.mp hk).2⟩
        invFun := fun ⟨⟨I, hI_nzd⟩, hI_le⟩ =>
          ⟨⟨Ideal.absNorm I, Finset.mem_Icc.mpr ⟨by
              have hne : Ideal.absNorm I ≠ 0 :=
                Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mpr hI_nzd
              omega, hI_le⟩⟩,
            ⟨I, rfl⟩⟩
        left_inv := fun ⟨⟨k, hk⟩, ⟨I, hI⟩⟩ => by
          dsimp at hI ⊢
          subst hI
          rfl
        right_inv := fun ⟨⟨I, hI_nzd⟩, hI_le⟩ => rfl }
    haveI : ∀ a : Finset.Icc 1 n,
        Finite { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = a.1 } :=
      fun a => Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_eq a.1)
    rw [Nat.card_congr e.symm, Nat.card_sigma, Finset.univ_eq_attach]
    exact (Finset.sum_attach (Finset.Icc 1 n)
      (fun k => Nat.card { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = k })).symm
  let c_I : ℕ → ℕ := fun n =>
    Nat.card { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n }
  have hLSum_I : LSeriesSummable (fun n : ℕ => (c_I n : ℂ)) (s : ℂ) := by
    have hTendsto := (NumberField.Ideal.tendsto_norm_le_div_atTop₀ F).comp tendsto_natCast_atTop_atTop
    have hEqSum : (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, (c_I k : ℝ)) =
        (fun n : ℕ => (Nat.card { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) : ℝ) ≤ (n : ℝ) } : ℝ)) := by
      ext n
      rw [← Nat.cast_sum, hSum n]
      simp only [Nat.cast_le]
    have hBigO : (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, (c_I k : ℝ)) =O[Filter.atTop]
        (fun n : ℕ => (n : ℝ) ^ (1 : ℝ)) := by
      have hBigO1 : (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, (c_I k : ℝ)) =O[Filter.atTop]
          (fun n : ℕ => (n : ℝ)) := by
        refine Asymptotics.isBigO_of_div_tendsto_nhds ?_ _
          (hTendsto.congr (fun n => by
            dsimp
            rw [← congr_fun hEqSum n]))
        refine Filter.Eventually.of_forall (fun n hn => ?_)
        have hn0 : n = 0 := Nat.cast_eq_zero.mp hn
        subst hn0
        simp
      simpa only [Real.rpow_one] using hBigO1
    have hSummable := LSeriesSummable_of_sum_norm_bigO_and_nonneg (s := (s : ℂ)) hBigO
      (fun n => Nat.cast_nonneg (c_I n)) (by norm_num : (0 : ℝ) ≤ 1)
      (by simpa [Complex.ofReal_re] using hs)
    simpa only [Complex.ofReal_natCast] using hSummable
  have hTermRe : ∀ n : ℕ,
      (LSeries.term (fun k : ℕ => (c_I k : ℂ)) (s : ℂ) n).re = (c_I n : ℝ) * ((n : ℝ) ^ (-s)) := by
    intro n
    rcases eq_or_ne n 0 with rfl | hn
    · rw [LSeries.term_zero, Complex.zero_re, Nat.cast_zero, Real.zero_rpow (by linarith), mul_zero]
    · rw [LSeries.term_of_ne_zero hn]
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_cpow : ((n : ℂ) ^ (s : ℂ)) = (((n : ℝ) ^ s : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg s]
      rw [h_cpow, div_eq_mul_inv, ← Complex.ofReal_inv, ← Real.rpow_neg hn_nonneg,
        ← Complex.ofReal_natCast, ← Complex.ofReal_mul, Complex.ofReal_re]
  have hNatSum : Summable (fun n : ℕ => (c_I n : ℝ) * ((n : ℝ) ^ (-s))) := by
    have hReSum := Complex.reCLM.summable hLSum_I
    exact hReSum.congr (fun n => hTermRe n)
  let g_I : Ideal (NumberField.RingOfIntegers F) → ℝ :=
      fun I => ((Ideal.absNorm I : ℝ) ^ (-s))
  let e_fib_I : (n : ℕ) × { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } ≃
      Ideal (NumberField.RingOfIntegers F) :=
    Equiv.sigmaFiberEquiv Ideal.absNorm
  have hFibFin : ∀ n : ℕ,
      Finite { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } :=
    fun n => Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_eq n)
  have hFibTsum : ∀ n : ℕ,
      (∑' I : { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n },
        g_I (e_fib_I ⟨n, I⟩)) = (c_I n : ℝ) * ((n : ℝ) ^ (-s)) := by
    intro n
    haveI := hFibFin n
    have hConst : (fun I : { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } =>
        g_I (e_fib_I ⟨n, I⟩)) = (fun _ => ((n : ℝ) ^ (-s))) := by
      ext I
      dsimp [g_I, e_fib_I, Equiv.sigmaFiberEquiv]
      rw [I.2]
    rw [hConst, tsum_const, nsmul_eq_mul]
  have hSigmaSum : Summable (fun p : (n : ℕ) × { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } =>
      g_I (e_fib_I p)) := by
    refine (summable_sigma_of_nonneg (fun p => Real.rpow_nonneg (Nat.cast_nonneg _) _)).mpr ⟨?_, ?_⟩
    · intro n
      haveI := hFibFin n
      exact Summable.of_finite
    · exact hNatSum.congr (fun n => (hFibTsum n).symm)
  have hIdealAllSum : Summable g_I := (Equiv.summable_iff e_fib_I).mp hSigmaSum
  have hIdeal : Summable (fun I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } =>
      ((Ideal.absNorm I.val : ℝ) ^ (-s))) :=
    hIdealAllSum.subtype { I : Ideal (NumberField.RingOfIntegers F) | I ≠ ⊥ }
  have hAbsNorm : ∀ I : Ideal (NumberField.RingOfIntegers F),
      Ideal.absNorm I = Nat.card (NumberField.RingOfIntegers F ⧸ I) := by
    intro I
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal :
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
          Ideal (NumberField.RingOfIntegers F)) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  have h_toMultiset_prod :
      ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod =
          f.prod (fun q k => q.asIdeal ^ k) := by
    intro f
    rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
      Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
  have h_prod_ne_bot :
      ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        f.prod (fun q k => q.asIdeal ^ k) ≠ ⊥ := by
    intro f
    rw [← h_toMultiset_prod f, ← Submodule.zero_eq_bot]
    apply Multiset.prod_ne_zero
    intro h0
    rw [Multiset.mem_map] at h0
    rcases h0 with ⟨q, _, hq0⟩
    rw [Submodule.zero_eq_bot] at hq0
    exact q.ne_bot hq0
  have h_normFactors :
      ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        UniqueFactorizationMonoid.normalizedFactors (f.prod (fun q k => q.asIdeal ^ k)) =
          Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f) := by
    intro f
    rw [← h_toMultiset_prod f]
    apply UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
    intro p hp
    rw [Multiset.mem_map] at hp
    rcases hp with ⟨q, _, rfl⟩
    exact q.prime
  let Φ : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) →
      { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } :=
    fun f => ⟨f.prod (fun q k => q.asIdeal ^ k), h_prod_ne_bot f⟩
  have hΦ_inj : Function.Injective Φ := by
    intro f₁ f₂ h
    have hval : f₁.prod (fun q k => q.asIdeal ^ k) = f₂.prod (fun q k => q.asIdeal ^ k) :=
      congrArg Subtype.val h
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hval
    rw [h_normFactors f₁, h_normFactors f₂] at hnf
    have htm : Finsupp.toMultiset f₁ = Finsupp.toMultiset f₂ :=
      Multiset.map_injective hasIdeal_inj hnf
    have htf := congrArg Multiset.toFinsupp htm
    simpa only [Finsupp.toMultiset_toFinsupp] using htf
  have hΦ_surj : Function.Surjective Φ := by
    rintro ⟨I, hI⟩
    let N_fac := UniqueFactorizationMonoid.normalizedFactors I
    let m : Multiset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
      Multiset.pmap
        (fun (p : Ideal (NumberField.RingOfIntegers F)) (hp : Prime p) =>
          IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
        N_fac
        (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
    let f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ :=
      Multiset.toFinsupp m
    refine ⟨f, Subtype.ext ?_⟩
    change f.prod (fun q k => q.asIdeal ^ k) = I
    rw [← h_toMultiset_prod f]
    have hfm : Finsupp.toMultiset f = m := Multiset.toFinsupp_toMultiset m
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m = N_fac := by
      dsimp [m]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact prod_normalizedFactors_eq_self hI
  let e_fac : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) ≃
      { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } :=
    Equiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩
  have h_term : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      ((Ideal.absNorm (e_fac f).val : ℝ) ^ (-s)) =
        f.prod (fun q k => (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ k)) := by
    intro f
    have hef : (e_fac f).val = f.prod (fun q k => q.asIdeal ^ k) := rfl
    rw [hef]
    unfold Finsupp.prod
    rw [map_prod]
    simp only [map_pow]
    simp only [hAbsNorm]
    rw [Nat.cast_prod]
    simp only [Nat.cast_pow]
    rw [← Real.finset_prod_rpow _ _ (fun q _ => by positivity)]
    refine Finset.prod_congr rfl (fun q _ => ?_)
    rw [← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg _),
      mul_comm (f q : ℝ) (-s), Real.rpow_mul (Nat.cast_nonneg _), Real.rpow_natCast]
  have hSumR : Summable (fun f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ =>
      f.prod (fun q k => (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ k))) := by
    refine ((Equiv.summable_iff e_fac).mpr hIdeal).congr ?_
    intro f
    exact h_term f
  let N : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ :=
    fun q => Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)
  have hN_pos : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F), 0 < N q := by
    intro q
    dsimp [N]
    rw [← hAbsNorm]
    exact Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
      (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact q.ne_bot))
  let N_prod : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) → ℕ :=
    fun f => f.prod (fun q k => (N q) ^ k)
  let A : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) → ℂ :=
    fun f => f.prod (fun q k => (α q) ^ k)
  let G_α : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) → ℂ :=
    fun f => f.prod (fun q k => (α q * (((N q : ℝ) ^ (-s) : ℝ) : ℂ)) ^ k)
  let G_R : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) → ℝ :=
    fun f => f.prod (fun q k => (((N q : ℝ) ^ (-s)) ^ k))
  have hN_prod_pos : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      0 < N_prod f := by
    intro f
    unfold N_prod Finsupp.prod
    exact Finset.prod_pos (fun q _ => pow_pos (hN_pos q) (f q))
  have hG_R : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      G_R f = (((N_prod f : ℕ) : ℝ) ^ (-s)) := by
    intro f
    unfold G_R N_prod Finsupp.prod
    rw [Nat.cast_prod]
    simp only [Nat.cast_pow]
    rw [← Real.finset_prod_rpow _ _ (fun q _ => by positivity)]
    refine Finset.prod_congr rfl (fun q _ => ?_)
    rw [← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg _),
      mul_comm (-s) (f q : ℝ), Real.rpow_mul (Nat.cast_nonneg _), Real.rpow_natCast]
  have hG_α : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      G_α f = A f * ((((N_prod f : ℕ) : ℝ) ^ (-s) : ℝ) : ℂ) := by
    intro f
    rw [← hG_R f]
    unfold G_α A G_R Finsupp.prod
    have h_step : ∀ q ∈ f.support,
        (α q * (((N q : ℝ) ^ (-s) : ℝ) : ℂ)) ^ (f q) =
          (α q) ^ (f q) * ((((N q : ℝ) ^ (-s)) ^ (f q) : ℝ) : ℂ) := by
      intro q _
      rw [mul_pow, Complex.ofReal_pow]
    rw [Finset.prod_congr rfl h_step, Finset.prod_mul_distrib, Complex.ofReal_prod]
  have hNorm : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      ‖G_α f‖ ≤ G_R f := by
    intro f
    rw [hG_α f, hG_R f, norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) (-s))]
    have h_norm_α : ‖A f‖ ≤ 1 := by
      unfold A Finsupp.prod
      rw [norm_prod]
      refine Finset.prod_le_one (fun q _ => norm_nonneg _) (fun q _ => ?_)
      rw [norm_pow]
      exact pow_le_one₀ (norm_nonneg _) (hα_norm q)
    exact mul_le_of_le_one_left (Real.rpow_nonneg (Nat.cast_nonneg _) (-s)) h_norm_α
  let c : ℕ → ℂ := fun n =>
    ∑' f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
        N_prod f = n }, A f.val
  let e_fib : (n : ℕ) × { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
      N_prod f = n } ≃
      (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) :=
    Equiv.sigmaFiberEquiv N_prod
  have hFibEq : ∀ n : ℕ,
      (∑' f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          N_prod f = n }, G_α f.val) = LSeries.term c (s : ℂ) n := by
    intro n
    have h_congr : (fun f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          N_prod f = n } => G_α f.val) =
        (fun f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          N_prod f = n } => A f.val * (((n : ℝ) ^ (-s) : ℝ) : ℂ)) := by
      ext f
      rw [hG_α f.val, f.2]
    rw [h_congr, tsum_mul_right]
    change c n * (((n : ℝ) ^ (-s) : ℝ) : ℂ) = LSeries.term c (s : ℂ) n
    rcases eq_or_ne n 0 with rfl | hn
    · haveI : IsEmpty { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          N_prod f = 0 } := ⟨fun ⟨f, hf⟩ => (hN_prod_pos f).ne' hf⟩
      have hc0 : c 0 = 0 := by
        dsimp [c]
        exact tsum_empty
      rw [hc0, zero_mul, LSeries.term_zero]
    · rw [LSeries.term_of_ne_zero hn]
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_cpow : ((n : ℂ) ^ (s : ℂ)) = (((n : ℝ) ^ s : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg s]
      rw [h_cpow, div_eq_mul_inv, ← Complex.ofReal_inv, ← Real.rpow_neg hn_nonneg]
  have hG_R_nonneg : ∀ p : (n : ℕ) × { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
      N_prod f = n }, 0 ≤ G_R (e_fib p) :=
    fun p => (norm_nonneg _).trans (hNorm (e_fib p))
  have hSigmaR : Summable (fun p : (n : ℕ) × { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
      N_prod f = n } => G_R (e_fib p)) :=
    (Equiv.summable_iff e_fib).mpr hSumR
  obtain ⟨hFibR, hOuterR⟩ := (summable_sigma_of_nonneg hG_R_nonneg).mp hSigmaR
  have hLSum : LSeriesSummable c (s : ℂ) := by
    rw [LSeriesSummable]
    refine hOuterR.of_norm_bounded (fun n => ?_)
    rw [← hFibEq n]
    have hFibNorm : Summable (fun f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          N_prod f = n } => ‖G_α f.val‖) :=
      (hFibR n).of_norm_bounded (fun f => by rw [Real.norm_of_nonneg (norm_nonneg _)]; exact hNorm f.val)
    exact (norm_tsum_le_tsum_norm hFibNorm).trans
      (hFibNorm.tsum_le_tsum (fun f => hNorm f.val) (hFibR n))
  have hSumG : Summable G_α := hSumR.of_norm_bounded hNorm
  have hSigmaG : Summable (fun p : (n : ℕ) × { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
      N_prod f = n } => G_α (e_fib p)) :=
    (Equiv.summable_iff e_fib).mpr hSumG
  have hEq : (∑' f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ, G_α f) =
      LSeries c (s : ℂ) := by
    rw [← Equiv.tsum_eq e_fib G_α, hSigmaG.tsum_sigma]
    rw [LSeries]
    exact tsum_congr hFibEq
  exact ⟨hLSum, hEq⟩

theorem exists_tendsto_lSeries_of_sum_isBigO_rpow_lt_one (c : ℕ → ℂ)
    (hSummable : ∀ s : ℝ, 1 < s → LSeriesSummable c (s : ℂ))
    (hBigO : ∃ r : ℝ, 0 ≤ r ∧ r < 1 ∧
      (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, c k) =O[Filter.atTop] (fun n : ℕ => (n : ℝ) ^ r)) :
    ∃ w : ℂ,
      Filter.Tendsto (fun s : ℝ => LSeries c (s : ℂ))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds w) :=
by
  rcases hBigO with ⟨r, hr0, hr1, hO⟩
  let S_c : ℕ → ℂ := fun n => ∑ k ∈ Finset.Icc 1 n, c k
  let F : ℝ → ℝ → ℂ := fun s t => S_c ⌊t⌋₊ * (t : ℂ) ^ (-((s : ℂ) + 1))
  rcases hO.exists_nonneg with ⟨C₀, hC₀_nonneg, hC₀⟩
  rcases Filter.Eventually.exists_forall_of_atTop hC₀.bound with ⟨N, hN⟩
  let C : ℝ := C₀ + ∑ m ∈ Finset.range N, ‖S_c m‖
  have hSum_nonneg : 0 ≤ ∑ m ∈ Finset.range N, ‖S_c m‖ :=
    Finset.sum_nonneg (fun m _ => norm_nonneg _)
  have hC_nonneg : 0 ≤ C := add_nonneg hC₀_nonneg hSum_nonneg
  have hS_bound : ∀ n : ℕ, 1 ≤ n → ‖S_c n‖ ≤ C * (n : ℝ) ^ r := by
    intro n hn
    have hn_cast : (1 : ℝ) ≤ (n : ℝ) := Nat.one_le_cast.mpr hn
    have hrpow_ge_one : 1 ≤ (n : ℝ) ^ r := Real.one_le_rpow hn_cast hr0
    have hrpow_nonneg : 0 ≤ (n : ℝ) ^ r := Real.rpow_nonneg (Nat.cast_nonneg n) r
    by_cases h_ge : N ≤ n
    · have h1 := hN n h_ge
      rw [Real.norm_of_nonneg hrpow_nonneg] at h1
      have hC₀_le : C₀ ≤ C := le_add_of_nonneg_right hSum_nonneg
      exact h1.trans (mul_le_mul_of_nonneg_right hC₀_le hrpow_nonneg)
    · push_neg at h_ge
      have h_mem : n ∈ Finset.range N := Finset.mem_range.mpr h_ge
      have h1 : ‖S_c n‖ ≤ ∑ m ∈ Finset.range N, ‖S_c m‖ :=
        Finset.single_le_sum (fun m _ => norm_nonneg (S_c m)) h_mem
      have h2 : ∑ m ∈ Finset.range N, ‖S_c m‖ ≤ C := le_add_of_nonneg_left hC₀_nonneg
      calc ‖S_c n‖
        _ ≤ C := h1.trans h2
        _ = C * 1 := (mul_one C).symm
        _ ≤ C * (n : ℝ) ^ r := mul_le_mul_of_nonneg_left hrpow_ge_one hC_nonneg
  have hF_bound : ∀ s : ℝ, 1 < s → ∀ t : ℝ, 1 < t → ‖F s t‖ ≤ C * t ^ (r - 2) := by
    intro s hs t ht
    have ht0 : 0 < t := zero_lt_one.trans ht
    have ht_nonneg : 0 ≤ t := ht0.le
    have hfloor_ge : 1 ≤ ⌊t⌋₊ := (Nat.le_floor_iff ht_nonneg).mpr (by exact_mod_cast ht.le)
    have hfloor_le : (⌊t⌋₊ : ℝ) ≤ t := Nat.floor_le ht_nonneg
    have h1 : ‖S_c ⌊t⌋₊‖ ≤ C * t ^ r := by
      calc ‖S_c ⌊t⌋₊‖
        _ ≤ C * (⌊t⌋₊ : ℝ) ^ r := hS_bound ⌊t⌋₊ hfloor_ge
        _ ≤ C * t ^ r := mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow (Nat.cast_nonneg _) hfloor_le hr0) hC_nonneg
    have h2 : ‖(t : ℂ) ^ (-((s : ℂ) + 1))‖ ≤ t ^ (-2 : ℝ) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos ht0]
      have hre : (-((s : ℂ) + 1)).re = -(s + 1) := by simp
      rw [hre]
      exact Real.rpow_le_rpow_of_exponent_le ht.le (by linarith)
    dsimp [F]
    rw [norm_mul]
    calc ‖S_c ⌊t⌋₊‖ * ‖(t : ℂ) ^ (-((s : ℂ) + 1))‖
      _ ≤ (C * t ^ r) * t ^ (-2 : ℝ) := mul_le_mul h1 h2 (norm_nonneg _)
          (mul_nonneg hC_nonneg (Real.rpow_nonneg ht_nonneg r))
      _ = C * (t ^ r * t ^ (-2 : ℝ)) := by ring
      _ = C * t ^ (r + (-2 : ℝ)) := by rw [← Real.rpow_add ht0]
      _ = C * t ^ (r - 2) := by ring_nf
  have hF_meas : ∀ s : ℝ,
      MeasureTheory.AEStronglyMeasurable (F s) (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) := by
    intro s
    refine Measurable.aestronglyMeasurable ?_
    exact ((measurable_from_nat (f := S_c)).comp Nat.measurable_floor).mul
      (Complex.continuous_ofReal.measurable.pow_const _)
  have h_maj_int : MeasureTheory.Integrable (fun t : ℝ => C * t ^ (r - 2))
      (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) :=
    (integrableOn_Ioi_rpow_of_lt (by linarith : r - 2 < -1) zero_lt_one).const_mul C
  have h_ae_bound : ∀ᶠ s in nhdsWithin (1 : ℝ) (Set.Ioi 1),
      ∀ᵐ t ∂(MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))), ‖F s t‖ ≤ C * t ^ (r - 2) := by
    filter_upwards [self_mem_nhdsWithin] with s hs
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with t ht
    exact hF_bound s hs t ht
  have h_ae_lim : ∀ᵐ t ∂(MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))),
      Filter.Tendsto (fun s : ℝ => F s t) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds (F 1 t)) := by
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with t ht
    have ht0 : 0 < t := zero_lt_one.trans ht
    have ht_ne : (t : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt ht0)
    have h_cont : Continuous (fun s : ℝ => F s t) :=
      continuous_const.mul (Continuous.const_cpow
        ((Complex.continuous_ofReal.add continuous_const).neg) (Or.inl ht_ne))
    exact (h_cont.tendsto 1).mono_left nhdsWithin_le_nhds
  have h_int_lim : Filter.Tendsto
      (fun s : ℝ => ∫ t in Set.Ioi (1 : ℝ), F s t)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (∫ t in Set.Ioi (1 : ℝ), F 1 t)) :=
    MeasureTheory.tendsto_integral_filter_of_dominated_convergence
      (fun t : ℝ => C * t ^ (r - 2))
      (Filter.Eventually.of_forall hF_meas)
      h_ae_bound
      h_maj_int
      h_ae_lim
  refine ⟨((1 : ℝ) : ℂ) * ∫ t in Set.Ioi (1 : ℝ), F 1 t, ?_⟩
  have h_s_lim : Filter.Tendsto (fun s : ℝ => (s : ℂ))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds ((1 : ℝ) : ℂ)) :=
    (Complex.continuous_ofReal.tendsto (1 : ℝ)).mono_left nhdsWithin_le_nhds
  have h_mul_lim := h_s_lim.mul h_int_lim
  refine h_mul_lim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with s hs
  have hs_re : r < (s : ℂ).re := by
    rw [Complex.ofReal_re]
    exact hr1.trans hs
  exact (LSeries_eq_mul_integral c hr0 hs_re (hSummable s hs) hO).symm

theorem exists_frob_exponent_and_finsupp_prod_eq {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (χ : (E ≃ₐ[F] E) →* ℂˣ)
    (α : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℂ)
    (hα_unr : ∀ (ρ : E ≃ₐ[F] E) (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {ρ} → α q = (χ ρ : ℂ))
    (hα_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      ¬ IsUnramifiedAtPrime F E q → α q = 0) :
    ∃ e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ,
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {σ ^ (e q)}) ∧
      (∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) →
          f.prod (fun q m => (α q) ^ m) = (χ (σ ^ (f.sum (fun q m => e q * m))) : ℂ)) ∧
      (∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        ¬ (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) →
          f.prod (fun q m => (α q) ^ m) = 0) :=
by
  classical
  have h_comm : ∀ ρ g : E ≃ₐ[F] E, ρ * g * ρ⁻¹ = g := by
    intro ρ g
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic ρ)
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic g)
    rw [← zpow_add, add_comm m n, zpow_add, mul_inv_cancel_right]
  have h_npow : ∀ g : E ≃ₐ[F] E, ∃ d : ℕ, σ ^ d = g := by
    intro g
    exact (Submonoid.mem_powers_iff g σ).mp (mem_powers_iff_mem_zpowers.mpr (hCyclic g))
  have h_ex : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → ∃ d : ℕ, FrobeniusClassAt F E q ⊆ {σ ^ d} := by
    intro q hq
    have h_frob_iff : ∀ g : E ≃ₐ[F] E, g ∈ FrobeniusClassAt F E q ↔
        ∃ Q : Ideal (NumberField.RingOfIntegers E), Q.IsPrime ∧
          Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal ∧
          IsArithFrobAt (NumberField.RingOfIntegers F) g Q := by
      intro g
      simp only [FrobeniusClassAt, Set.mem_setOf_eq]
      refine exists_congr (fun Q => and_congr_right (fun _ => and_congr_right (fun h_under => ?_)))
      constructor
      · intro h x
        have hx := h x (g • x) rfl
        rwa [h_under]
      · intro h x z hz
        have hzx : z = g • x := Subtype.ext hz
        rw [hzx, ← h_under]
        exact h x
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    obtain ⟨Q₁, hQ₁⟩ := Ideal.nonempty_primesOver (S := NumberField.RingOfIntegers E) q.asIdeal
    have hQ₁_prime : Q₁.IsPrime := hQ₁.1
    have hQ₁_over : Q₁.LiesOver q.asIdeal := hQ₁.2
    have h_under₁ : Ideal.under (NumberField.RingOfIntegers F) Q₁ = q.asIdeal :=
      hQ₁_over.over.symm
    haveI : Q₁.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₁ q.asIdeal
    obtain ⟨g, hg₁⟩ := IsArithFrobAt.exists_of_isInvariant
      (NumberField.RingOfIntegers F) (E ≃ₐ[F] E) Q₁
    obtain ⟨d, rfl⟩ := h_npow g
    refine ⟨d, fun g₂ hg₂ => ?_⟩
    rw [h_frob_iff] at hg₂
    rcases hg₂ with ⟨Q₂, hQ₂_prime, h_under₂, hg₂⟩
    haveI : Q₂.LiesOver q.asIdeal := ⟨h_under₂.symm⟩
    obtain ⟨ρ, hρ⟩ := Ideal.exists_smul_eq_of_isGaloisGroup q.asIdeal Q₁ Q₂ (E ≃ₐ[F] E)
    have hg₁' : IsArithFrobAt (NumberField.RingOfIntegers F) (ρ * (σ ^ d) * ρ⁻¹) Q₂ := by
      rw [← hρ]
      exact hg₁.conj ρ
    have h_mem := hg₁'.mul_inv_mem_inertia hg₂
    haveI : Q₂.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₂ q.asIdeal
    letI := Ideal.Quotient.field q.asIdeal
    letI := Ideal.Quotient.field Q₂
    haveI : PerfectField (NumberField.RingOfIntegers F ⧸ q.asIdeal) := PerfectField.ofFinite
    haveI : Algebra.IsSeparable (NumberField.RingOfIntegers F ⧸ q.asIdeal)
      (NumberField.RingOfIntegers E ⧸ Q₂) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    have h_card : Nat.card ((Submodule.toAddSubgroup Q₂).inertia (E ≃ₐ[F] E)) = 1 := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q₂,
        Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q₂ (E ≃ₐ[F] E)]
      exact hq Q₂ hQ₂_prime h_under₂
    have h_bot : (Submodule.toAddSubgroup Q₂).inertia (E ≃ₐ[F] E) = ⊥ :=
      Subgroup.card_eq_one.mp h_card
    rw [h_bot, Subgroup.mem_bot, mul_inv_eq_one, h_comm ρ (σ ^ d)] at h_mem
    exact Set.mem_singleton_iff.mpr h_mem.symm
  let e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ :=
    fun q => if hq : IsUnramifiedAtPrime F E q then (h_ex q hq).choose else 0
  have he : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {σ ^ (e q)} := by
    intro q hq
    dsimp only [e]
    rw [dif_pos hq]
    exact (h_ex q hq).choose_spec
  refine ⟨e, he, ?_, ?_⟩
  · intro f hUnr
    change (∏ q ∈ f.support, (α q) ^ (f q)) = (χ (σ ^ (∑ q ∈ f.support, e q * f q)) : ℂ)
    have h_congr : (∏ q ∈ f.support, (α q) ^ (f q)) =
        ∏ q ∈ f.support, (χ σ : ℂ) ^ (e q * f q) := by
      refine Finset.prod_congr rfl (fun q hq_mem => ?_)
      have hq : IsUnramifiedAtPrime F E q := hUnr q hq_mem
      rw [hα_unr (σ ^ (e q)) q hq (he q hq), map_pow, Units.val_pow_eq_pow_val, ← pow_mul]
    rw [h_congr, Finset.prod_pow_eq_pow_sum, ← Units.val_pow_eq_pow_val, ← map_pow]
  · intro f hRam
    push_neg at hRam
    rcases hRam with ⟨q₀, hq₀_mem, hq₀_ram⟩
    change (∏ q ∈ f.support, (α q) ^ (f q)) = 0
    refine Finset.prod_eq_zero hq₀_mem ?_
    rw [hα_ram q₀ hq₀_ram, zero_pow (Finsupp.mem_support_iff.mp hq₀_mem)]

theorem sum_Icc_tsum_finsupp_prod_eq_sum_group_natCard {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (χ : (E ≃ₐ[F] E) →* ℂˣ)
    (α : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℂ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (hProd_unr : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) →
        f.prod (fun q m => (α q) ^ m) = (χ (σ ^ (f.sum (fun q m => e q * m))) : ℂ))
    (hProd_ram : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      ¬ (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) →
        f.prod (fun q m => (α q) ^ m) = 0)
    (n : ℕ) :
    (∑ k ∈ Finset.Icc 1 n,
      (∑' f : { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          f.prod (fun q m => (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ^ m) = k },
        f.val.prod (fun q m => (α q) ^ m))) =
    ∑ ρ : E ≃ₐ[F] E,
      (χ ρ : ℂ) *
        (Nat.card { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
          σ ^ (f.sum (fun q m => e q * m)) = ρ ∧
          Ideal.absNorm (f.prod (fun q m => q.asIdeal ^ m)) ≤ n } : ℂ) :=
by
  classical
  let ι := IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)
  let I : (ι →₀ ℕ) → Ideal (NumberField.RingOfIntegers F) :=
    fun f => f.prod (fun q m => q.asIdeal ^ m)
  let N_prod : (ι →₀ ℕ) → ℕ :=
    fun f => f.prod (fun q m => (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ^ m)
  let A : (ι →₀ ℕ) → ℂ :=
    fun f => f.prod (fun q m => (α q) ^ m)
  let P : (ι →₀ ℕ) → Prop :=
    fun f => ∀ q ∈ f.support, IsUnramifiedAtPrime F E q
  let ψ : (ι →₀ ℕ) → (E ≃ₐ[F] E) :=
    fun f => σ ^ (f.sum (fun q m => e q * m))
  have hAbsNorm : ∀ J : Ideal (NumberField.RingOfIntegers F),
      Ideal.absNorm J = Nat.card (NumberField.RingOfIntegers F ⧸ J) := by
    intro J
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  have h_norm_prod : ∀ f : ι →₀ ℕ, Ideal.absNorm (I f) = N_prod f := by
    intro f
    unfold I N_prod Finsupp.prod
    rw [map_prod]
    simp only [map_pow]
    simp only [hAbsNorm]
  have hN_q_pos : ∀ q : ι, 0 < Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
    intro q
    rw [← hAbsNorm]
    exact Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
      (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact q.ne_bot))
  have hN_prod_pos : ∀ f : ι →₀ ℕ, 0 < N_prod f := by
    intro f
    unfold N_prod Finsupp.prod
    exact Finset.prod_pos (fun q _ => pow_pos (hN_q_pos q) (f q))
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal :
        ι → Ideal (NumberField.RingOfIntegers F)) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  have h_toMultiset_prod : ∀ f : ι →₀ ℕ,
      (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod = I f := by
    intro f
    unfold I
    rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
      Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
  have h_normFactors : ∀ f : ι →₀ ℕ,
      UniqueFactorizationMonoid.normalizedFactors (I f) =
        Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f) := by
    intro f
    rw [← h_toMultiset_prod f]
    apply UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
    intro p hp
    rw [Multiset.mem_map] at hp
    rcases hp with ⟨q, _, rfl⟩
    exact q.prime
  have hI_inj : Function.Injective I := by
    intro f₁ f₂ hval
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hval
    rw [h_normFactors f₁, h_normFactors f₂] at hnf
    have htm : Finsupp.toMultiset f₁ = Finsupp.toMultiset f₂ :=
      Multiset.map_injective hasIdeal_inj hnf
    have htf := congrArg Multiset.toFinsupp htm
    simpa only [Finsupp.toMultiset_toFinsupp] using htf
  let F_fib : ℕ → Type u := fun k => { f : ι →₀ ℕ // N_prod f = k }
  have hFin_k : ∀ k : ℕ, Fintype (F_fib k) := by
    intro k
    haveI : Finite { J : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm J = k } :=
      Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_eq k)
    let ι_k : F_fib k → { J : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm J = k } :=
      fun x => ⟨I x.val, (h_norm_prod x.val).trans x.2⟩
    have hι_k_inj : Function.Injective ι_k := by
      intro x₁ x₂ h
      exact Subtype.ext (hI_inj (congrArg Subtype.val h))
    haveI : Finite (F_fib k) := Finite.of_injective ι_k hι_k_inj
    exact Fintype.ofFinite (F_fib k)
  letI : ∀ k : ℕ, Fintype (F_fib k) := hFin_k
  let F_le_n := { f : ι →₀ ℕ // Ideal.absNorm (I f) ≤ n }
  let e_le_n : ((k : Finset.Icc 1 n) × F_fib k.1) ≃ F_le_n :=
    { toFun := fun ⟨⟨k, hk⟩, ⟨f, hf⟩⟩ =>
        ⟨f, by
          dsimp [F_fib] at hf
          rw [h_norm_prod f, hf]
          exact (Finset.mem_Icc.mp hk).2⟩
      invFun := fun ⟨f, hf_le⟩ =>
        ⟨⟨N_prod f, Finset.mem_Icc.mpr ⟨by
            have hpos := hN_prod_pos f
            omega,
            by
              rw [← h_norm_prod f]
              exact hf_le⟩⟩,
          ⟨f, rfl⟩⟩
      left_inv := fun ⟨⟨k, hk⟩, ⟨f, hf⟩⟩ => by
        dsimp [F_fib] at hf ⊢
        subst hf
        rfl
      right_inv := fun ⟨f, hf_le⟩ => rfl }
  letI : Fintype F_le_n := Fintype.ofEquiv _ e_le_n
  have hCollapse :
      (∑ k ∈ Finset.Icc 1 n, (∑' f : F_fib k, A f.val)) =
        ∑ f : F_le_n, A f.val := by
    have h_tsum : ∀ k : ℕ, (∑' f : F_fib k, A f.val) = ∑ f : F_fib k, A f.val :=
      fun k => tsum_fintype (fun f : F_fib k => A f.val)
    simp_rw [h_tsum]
    have h_sigma :
        (∑ x : Finset.Icc 1 n, ∑ f : F_fib x.1, A f.val) =
          ∑ p : (k : Finset.Icc 1 n) × F_fib k.1, A p.2.val :=
      (Fintype.sum_sigma (f := fun p : (k : Finset.Icc 1 n) × F_fib k.1 => A p.2.val)).symm
    rw [← Finset.sum_attach (Finset.Icc 1 n) (fun k => ∑ f : F_fib k, A f.val),
      ← Finset.univ_eq_attach, h_sigma]
    exact Equiv.sum_comp e_le_n (fun f : F_le_n => A f.val)
  have hA_expand : ∀ f : ι →₀ ℕ,
      A f = ∑ ρ : E ≃ₐ[F] E, (if P f ∧ ψ f = ρ then (χ ρ : ℂ) else 0) := by
    intro f
    dsimp only [A]
    by_cases hP : P f
    · rw [hProd_unr f hP]
      simp only [hP, true_and, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
      rfl
    · rw [hProd_ram f hP]
      simp only [hP, false_and, ↓reduceIte, Finset.sum_const_zero]
  change (∑ k ∈ Finset.Icc 1 n, (∑' f : F_fib k, A f.val)) = _
  rw [hCollapse]
  simp_rw [hA_expand]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun ρ _ => ?_)
  let Q_ρ : F_le_n → Prop := fun f => P f.val ∧ ψ f.val = ρ
  change (∑ f : F_le_n, if Q_ρ f then (χ ρ : ℂ) else 0) = _
  rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm,
    ← Fintype.card_subtype Q_ρ, ← Nat.card_eq_fintype_card]
  let e_ρ : { f : F_le_n // Q_ρ f } ≃
      { f : ι →₀ ℕ // P f ∧ ψ f = ρ ∧ Ideal.absNorm (I f) ≤ n } :=
    { toFun := fun ⟨⟨f, hf_le⟩, hf_P, hf_ψ⟩ => ⟨f, hf_P, hf_ψ, hf_le⟩
      invFun := fun ⟨f, hf_P, hf_ψ, hf_le⟩ => ⟨⟨f, hf_le⟩, hf_P, hf_ψ⟩
      left_inv := fun ⟨⟨_, _⟩, _, _⟩ => rfl
      right_inv := fun ⟨_, _, _, _⟩ => rfl }
  rw [Nat.card_congr e_ρ]

theorem isBigO_char_sum_of_sub_linear_isBigO {G : Type u} [Group G] [Fintype G]
    (χ : G →* ℂˣ)
    (hχ : χ ≠ 1)
    (A : G → ℕ → ℕ)
    {κ r : ℝ}
    (hAsymp : ∀ ρ : G,
      (fun n : ℕ => (A ρ n : ℝ) - κ * (n : ℝ)) =O[Filter.atTop]
        (fun n : ℕ => (n : ℝ) ^ r)) :
    (fun n : ℕ => ∑ ρ : G, (χ ρ : ℂ) * (A ρ n : ℂ)) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ r) :=
by
  have h_sum_zero : ∑ ρ : G, (χ ρ : ℂ) = 0 := by
    obtain ⟨g₀, hg₀⟩ := DFunLike.ne_iff.mp hχ
    rw [MonoidHom.one_apply] at hg₀
    have hg₀_val : (χ g₀ : ℂ) ≠ 1 := by
      intro h_eq
      exact hg₀ (Units.ext h_eq)
    have h_reindex : ∑ ρ : G, (χ (g₀ * ρ) : ℂ) = ∑ ρ : G, (χ ρ : ℂ) :=
      Equiv.sum_comp (Equiv.mulLeft g₀) (fun ρ : G => (χ ρ : ℂ))
    have h_factor : ∑ ρ : G, (χ (g₀ * ρ) : ℂ) = (χ g₀ : ℂ) * ∑ ρ : G, (χ ρ : ℂ) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun ρ _ => ?_
      rw [map_mul, Units.val_mul]
    have h_sub : ((χ g₀ : ℂ) - 1) * ∑ ρ : G, (χ ρ : ℂ) = 0 := by
      linear_combination h_factor.symm.trans h_reindex
    rcases mul_eq_zero.mp h_sub with h_left | h_right
    · exact False.elim (hg₀_val (sub_eq_zero.mp h_left))
    · exact h_right
  have h_sum_bigO :
      (fun n : ℕ => ∑ ρ : G, (χ ρ : ℂ) * Complex.ofRealCLM ((A ρ n : ℝ) - κ * (n : ℝ))) =O[Filter.atTop]
        (fun n : ℕ => (n : ℝ) ^ r) := by
    refine Asymptotics.IsBigO.sum fun ρ _ => ?_
    exact ((Complex.ofRealCLM.isBigO_comp
      (fun n : ℕ => (A ρ n : ℝ) - κ * (n : ℝ)) Filter.atTop).trans (hAsymp ρ)).const_mul_left
      (χ ρ : ℂ)
  refine h_sum_bigO.congr_left fun n => ?_
  have h_pt : ∀ ρ : G,
      (χ ρ : ℂ) * Complex.ofRealCLM ((A ρ n : ℝ) - κ * (n : ℝ)) =
        (χ ρ : ℂ) * (A ρ n : ℂ) - (χ ρ : ℂ) * Complex.ofRealCLM (κ * (n : ℝ)) := by
    intro ρ
    rw [map_sub, Complex.ofRealCLM_apply (A ρ n : ℝ), Complex.ofReal_natCast, mul_sub]
  simp_rw [h_pt]
  rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_zero, zero_mul, sub_zero]

theorem normLeOne_image_bounded_measurable_and_frontier_lipschitz_cover {F : Type u} [Field F] [NumberField F]
    (Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin (Module.finrank ℚ F) → ℝ)) :
    Bornology.IsBounded (Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F) ∧
    MeasurableSet (Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F) ∧
    ∃ (M : ℕ) (L_lip : ℝ)
      (γ : Fin M → (Fin (Module.finrank ℚ F - 1) → ℝ) → (Fin (Module.finrank ℚ F) → ℝ)),
      0 ≤ L_lip ∧
      (∀ (m : Fin M) (u v : Fin (Module.finrank ℚ F - 1) → ℝ),
        (∀ j, u j ∈ Set.Icc (0 : ℝ) 1) →
        (∀ j, v j ∈ Set.Icc (0 : ℝ) 1) →
        ∀ i : Fin (Module.finrank ℚ F),
          |γ m u i - γ m v i| ≤ L_lip * ∑ j : Fin (Module.finrank ℚ F - 1), |u j - v j|) ∧
      frontier (Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F) ⊆
        ⋃ m : Fin M, γ m '' { u : Fin (Module.finrank ℚ F - 1) → ℝ | ∀ j, u j ∈ Set.Icc (0 : ℝ) 1 } :=
by
  classical
  refine ⟨Φ.toContinuousLinearMap.lipschitz.isBounded_image
      (NumberField.mixedEmbedding.fundamentalCone.isBounded_normLeOne F),
    (Φ.toHomeomorph.toMeasurableEquiv.measurableSet_image).mpr
      (NumberField.mixedEmbedding.fundamentalCone.measurableSet_normLeOne F), ?_⟩
  
  have h_s4 : Nonempty
      (({ w : NumberField.InfinitePlace F // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } ⊕
        { w : NumberField.InfinitePlace F // w.IsComplex }) ≃
        Fin (Module.finrank ℚ F - 1)) := by
    clear Φ
    let w₀ : NumberField.InfinitePlace F := NumberField.Units.dirichletUnitTheorem.w₀
    have h_pos : 0 < Fintype.card (NumberField.InfinitePlace F) := Fintype.card_pos_iff.mpr ⟨w₀⟩
    have h_ne : Fintype.card { w : NumberField.InfinitePlace F // w ≠ w₀ } =
        Fintype.card (NumberField.InfinitePlace F) - 1 := Set.card_ne_eq w₀
    have h_c : Fintype.card { w : NumberField.InfinitePlace F // w.IsComplex } =
        NumberField.InfinitePlace.nrComplexPlaces F := rfl
    have h_sum1 := NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces F
    have h_sum2 := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank F
    have h_card : Fintype.card
        (({ w : NumberField.InfinitePlace F // w ≠ w₀ } ⊕
          { w : NumberField.InfinitePlace F // w.IsComplex })) =
        Module.finrank ℚ F - 1 := by
      rw [Fintype.card_sum, h_ne, h_c]
      omega
    exact ⟨Fintype.equivFinOfCardEq h_card⟩

  
  have h_s2 : ∃ (B_E L_E : ℝ), 0 ≤ B_E ∧ 0 ≤ L_E ∧
      (∀ u : NumberField.mixedEmbedding.realSpace F,
        (∀ w : NumberField.InfinitePlace F, u w ∈ Set.Icc (0 : ℝ) 1) →
        ‖NumberField.mixedEmbedding.fundamentalCone.expMapBasis u‖ ≤ B_E) ∧
      (∀ u v : NumberField.mixedEmbedding.realSpace F,
        (∀ w : NumberField.InfinitePlace F, u w ∈ Set.Icc (0 : ℝ) 1) →
        (∀ w : NumberField.InfinitePlace F, v w ∈ Set.Icc (0 : ℝ) 1) →
        ‖NumberField.mixedEmbedding.fundamentalCone.expMapBasis u -
          NumberField.mixedEmbedding.fundamentalCone.expMapBasis v‖ ≤ L_E * ‖u - v‖) := by
    clear Φ h_s4
    have abs_exp_sub_exp_le : ∀ {a b C : ℝ}, a ≤ C → b ≤ C →
        |Real.exp a - Real.exp b| ≤ Real.exp C * |a - b| := by
      intro a b C ha hb
      have h_case : ∀ x y : ℝ, x ≤ y → y ≤ C →
          |Real.exp x - Real.exp y| ≤ Real.exp C * |x - y| := by
        intro x y hxy hyC
        have hexp_le : Real.exp x ≤ Real.exp y := Real.exp_le_exp.mpr hxy
        have hexp_yC : Real.exp y ≤ Real.exp C := Real.exp_le_exp.mpr hyC
        have h1 : (x - y) + 1 ≤ Real.exp (x - y) := Real.add_one_le_exp (x - y)
        rw [Real.exp_sub] at h1
        have hy_pos : 0 < Real.exp y := Real.exp_pos y
        have h2 : ((x - y) + 1) * Real.exp y ≤ Real.exp x :=
          (le_div_iff₀ hy_pos).mp h1
        have h3 : Real.exp y - Real.exp x ≤ Real.exp y * (y - x) := by linarith
        have h4 : Real.exp y * (y - x) ≤ Real.exp C * (y - x) :=
          mul_le_mul_of_nonneg_right hexp_yC (sub_nonneg.mpr hxy)
        rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr hexp_le),
          abs_sub_comm x y, abs_of_nonneg (sub_nonneg.mpr hxy)]
        exact h3.trans h4
      rcases le_total a b with hab | hba
      · exact h_case a b hab hb
      · rw [abs_sub_comm, abs_sub_comm a b]
        exact h_case b a hba ha
    let T : NumberField.mixedEmbedding.realSpace F →L[ℝ] NumberField.mixedEmbedding.realSpace F :=
      ((NumberField.mixedEmbedding.fundamentalCone.completeBasis F).equivFun.symm).toContinuousLinearEquiv.toContinuousLinearMap
    have hT_nonneg : 0 ≤ ‖T‖ := norm_nonneg T
    let B_E : ℝ := Real.exp ‖T‖
    let L_E : ℝ := Real.exp ‖T‖ * ‖T‖
    have hB_pos : 0 < B_E := Real.exp_pos ‖T‖
    have hL_nonneg : 0 ≤ L_E := mul_nonneg hB_pos.le hT_nonneg
    have h_mult_inv : ∀ w : NumberField.InfinitePlace F,
        0 ≤ (w.mult : ℝ)⁻¹ ∧ (w.mult : ℝ)⁻¹ ≤ 1 := by
      intro w
      have h1 : (1 : ℝ) ≤ (w.mult : ℝ) := NumberField.InfinitePlace.one_le_mult
      exact ⟨inv_nonneg.mpr (by linarith), inv_le_one_of_one_le₀ h1⟩
    have h_coord_bound : ∀ (z : NumberField.mixedEmbedding.realSpace F) (w : NumberField.InfinitePlace F),
        |(w.mult : ℝ)⁻¹ * (T z w)| ≤ ‖T‖ * ‖z‖ := by
      intro z w
      rw [abs_mul, abs_of_nonneg (h_mult_inv w).1]
      have h1 : (w.mult : ℝ)⁻¹ * |T z w| ≤ 1 * |T z w| :=
        mul_le_mul_of_nonneg_right (h_mult_inv w).2 (abs_nonneg _)
      rw [one_mul] at h1
      have h2 : |T z w| ≤ ‖T z‖ := norm_le_pi_norm (T z) w
      have h3 : ‖T z‖ ≤ ‖T‖ * ‖z‖ := T.le_opNorm z
      exact (h1.trans h2).trans h3
    have h_u_norm : ∀ u : NumberField.mixedEmbedding.realSpace F,
        (∀ w : NumberField.InfinitePlace F, u w ∈ Set.Icc (0 : ℝ) 1) → ‖u‖ ≤ 1 := by
      intro u hu
      rw [pi_norm_le_iff_of_nonneg zero_le_one]
      intro w
      rw [Real.norm_eq_abs, abs_of_nonneg (hu w).1]
      exact (hu w).2
    refine ⟨B_E, L_E, hB_pos.le, hL_nonneg, ?_, ?_⟩
    · intro u hu
      rw [pi_norm_le_iff_of_nonneg hB_pos.le]
      intro w
      rw [NumberField.mixedEmbedding.fundamentalCone.expMapBasis_apply,
        NumberField.mixedEmbedding.fundamentalCone.expMap_apply]
      change ‖Real.exp ((w.mult : ℝ)⁻¹ * (T u w))‖ ≤ Real.exp ‖T‖
      rw [Real.norm_of_nonneg (Real.exp_pos _).le, Real.exp_le_exp]
      have h1 := (le_abs_self _).trans (h_coord_bound u w)
      have h2 : ‖T‖ * ‖u‖ ≤ ‖T‖ * 1 := mul_le_mul_of_nonneg_left (h_u_norm u hu) hT_nonneg
      linarith
    · intro u v hu hv
      have h_rhs_nonneg : 0 ≤ L_E * ‖u - v‖ := mul_nonneg hL_nonneg (norm_nonneg _)
      rw [pi_norm_le_iff_of_nonneg h_rhs_nonneg]
      intro w
      simp only [Pi.sub_apply, NumberField.mixedEmbedding.fundamentalCone.expMapBasis_apply,
        NumberField.mixedEmbedding.fundamentalCone.expMap_apply, Real.norm_eq_abs]
      change |Real.exp ((w.mult : ℝ)⁻¹ * (T u w)) - Real.exp ((w.mult : ℝ)⁻¹ * (T v w))| ≤ L_E * ‖u - v‖
      have hu_le : (w.mult : ℝ)⁻¹ * (T u w) ≤ ‖T‖ := by
        have h1 := (le_abs_self _).trans (h_coord_bound u w)
        have h2 : ‖T‖ * ‖u‖ ≤ ‖T‖ * 1 := mul_le_mul_of_nonneg_left (h_u_norm u hu) hT_nonneg
        linarith
      have hv_le : (w.mult : ℝ)⁻¹ * (T v w) ≤ ‖T‖ := by
        have h1 := (le_abs_self _).trans (h_coord_bound v w)
        have h2 : ‖T‖ * ‖v‖ ≤ ‖T‖ * 1 := mul_le_mul_of_nonneg_left (h_u_norm v hv) hT_nonneg
        linarith
      have h_exp := abs_exp_sub_exp_le hu_le hv_le
      have h_lin : (w.mult : ℝ)⁻¹ * (T u w) - (w.mult : ℝ)⁻¹ * (T v w) =
          (w.mult : ℝ)⁻¹ * (T (u - v) w) := by
        rw [map_sub, Pi.sub_apply, mul_sub]
      rw [h_lin] at h_exp
      have h_diff := h_coord_bound (u - v) w
      calc
        |Real.exp ((w.mult : ℝ)⁻¹ * (T u w)) - Real.exp ((w.mult : ℝ)⁻¹ * (T v w))|
            ≤ Real.exp ‖T‖ * |(w.mult : ℝ)⁻¹ * (T (u - v) w)| := h_exp
        _ ≤ Real.exp ‖T‖ * (‖T‖ * ‖u - v‖) := mul_le_mul_of_nonneg_left h_diff hB_pos.le
        _ = L_E * ‖u - v‖ := by ring

  
  have h_s3 : ∃ (Ψ : ({ w : NumberField.InfinitePlace F // w.IsReal } → Bool) →
        NumberField.mixedEmbedding.realSpace F →
        ({ w : NumberField.InfinitePlace F // w.IsComplex } → ℝ) →
        NumberField.mixedEmbedding.mixedSpace F),
      (∀ x : NumberField.mixedEmbedding.mixedSpace F,
        ∃ (σ : { w : NumberField.InfinitePlace F // w.IsReal } → Bool)
          (θ : { w : NumberField.InfinitePlace F // w.IsComplex } → ℝ),
          (∀ w, θ w ∈ Set.Icc (0 : ℝ) 1) ∧
          Ψ σ (NumberField.mixedEmbedding.normAtAllPlaces x) θ = x) ∧
      (∀ (σ : { w : NumberField.InfinitePlace F // w.IsReal } → Bool)
        (y₁ y₂ : NumberField.mixedEmbedding.realSpace F)
        (θ₁ θ₂ : { w : NumberField.InfinitePlace F // w.IsComplex } → ℝ),
        (∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
          |(Ψ σ y₁ θ₁).1 w - (Ψ σ y₂ θ₂).1 w| ≤ ‖y₁ - y₂‖) ∧
        (∀ w : { w : NumberField.InfinitePlace F // w.IsComplex },
          ‖(Ψ σ y₁ θ₁).2 w - (Ψ σ y₂ θ₂).2 w‖ ≤
            ‖y₁ - y₂‖ + 4 * Real.pi * ‖y₂‖ * |θ₁ w - θ₂ w|)) := by
    clear Φ h_s4 h_s2
    let Ψ : ({ w : NumberField.InfinitePlace F // w.IsReal } → Bool) →
        NumberField.mixedEmbedding.realSpace F →
        ({ w : NumberField.InfinitePlace F // w.IsComplex } → ℝ) →
        NumberField.mixedEmbedding.mixedSpace F :=
      fun σ y θ =>
        (fun w => (if σ w then (1 : ℝ) else -1) * y w.1,
         fun w => (y w.1 : ℂ) * Complex.exp ((((2 * θ w - 1) * Real.pi : ℝ) : ℂ) * Complex.I))
    refine ⟨Ψ, ?_, ?_⟩
    · intro x
      let σ : { w : NumberField.InfinitePlace F // w.IsReal } → Bool :=
        fun w => decide (0 ≤ x.1 w)
      let θ : { w : NumberField.InfinitePlace F // w.IsComplex } → ℝ :=
        fun w => ((x.2 w).arg + Real.pi) / (2 * Real.pi)
      refine ⟨σ, θ, ?_, ?_⟩
      · intro w
        dsimp only [θ]
        have h_pi_pos : 0 < 2 * Real.pi := by linarith [Real.pi_pos]
        have h_lt := Complex.neg_pi_lt_arg (x.2 w)
        have h_le := Complex.arg_le_pi (x.2 w)
        exact ⟨div_nonneg (by linarith) h_pi_pos.le, (div_le_one h_pi_pos).mpr (by linarith)⟩
      · ext w
        · dsimp only [Ψ, σ]
          rw [NumberField.mixedEmbedding.normAtAllPlaces_apply,
            NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2 x, Real.norm_eq_abs]
          by_cases h0 : 0 ≤ x.1 w
          · simp [h0, abs_of_nonneg h0]
          · have h_neg : x.1 w < 0 := lt_of_not_ge h0
            simp [h0, abs_of_neg h_neg]
        · dsimp only [Ψ, θ]
          rw [NumberField.mixedEmbedding.normAtAllPlaces_apply,
            NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2 x]
          have h_pi_ne : Real.pi ≠ 0 := Real.pi_ne_zero
          have h_arg : (2 * (((x.2 w).arg + Real.pi) / (2 * Real.pi)) - 1) * Real.pi = (x.2 w).arg := by
            field_simp
            ring
          rw [h_arg]
          exact Complex.norm_mul_exp_arg_mul_I (x.2 w)
    · intro σ y₁ y₂ θ₁ θ₂
      refine ⟨?_, ?_⟩
      · intro w
        dsimp only [Ψ]
        have h_sub : (if σ w then (1 : ℝ) else -1) * y₁ w.1 - (if σ w then (1 : ℝ) else -1) * y₂ w.1 =
            (if σ w then (1 : ℝ) else -1) * (y₁ w.1 - y₂ w.1) := by ring
        rw [h_sub, abs_mul]
        have h_sign : |if σ w then (1 : ℝ) else -1| = 1 := by
          cases σ w <;> norm_num
        rw [h_sign, one_mul]
        exact norm_le_pi_norm (y₁ - y₂) w.1
      · intro w
        dsimp only [Ψ]
        let a₁ : ℝ := (2 * θ₁ w - 1) * Real.pi
        let a₂ : ℝ := (2 * θ₂ w - 1) * Real.pi
        let E₁ : ℂ := Complex.exp ((a₁ : ℂ) * Complex.I)
        let E₂ : ℂ := Complex.exp ((a₂ : ℂ) * Complex.I)
        have hE₁_norm : ‖E₁‖ = 1 := Complex.norm_exp_ofReal_mul_I a₁
        have hE_diff : ‖E₁ - E₂‖ ≤ 4 * Real.pi * |θ₁ w - θ₂ w| := by
          have h_re_im := Complex.norm_le_abs_re_add_abs_im (E₁ - E₂)
          have h_re : (E₁ - E₂).re = Real.cos a₁ - Real.cos a₂ := by
            simp [E₁, E₂, Complex.exp_ofReal_mul_I_re]
          have h_im : (E₁ - E₂).im = Real.sin a₁ - Real.sin a₂ := by
            simp [E₁, E₂, Complex.exp_ofReal_mul_I_im]
          rw [h_re, h_im] at h_re_im
          have h_cos : |Real.cos a₁ - Real.cos a₂| ≤ |a₁ - a₂| := by
            simpa [Real.dist_eq] using Real.lipschitzWith_cos.dist_le_mul a₁ a₂
          have h_sin : |Real.sin a₁ - Real.sin a₂| ≤ |a₁ - a₂| := by
            simpa [Real.dist_eq] using Real.lipschitzWith_sin.dist_le_mul a₁ a₂
          have h_a_diff : a₁ - a₂ = (2 * Real.pi) * (θ₁ w - θ₂ w) := by
            dsimp only [a₁, a₂]; ring
          have h_abs_a : |a₁ - a₂| = 2 * Real.pi * |θ₁ w - θ₂ w| := by
            rw [h_a_diff, abs_mul, abs_of_pos (by linarith [Real.pi_pos])]
          linarith
        have h_decomp : (y₁ w.1 : ℂ) * E₁ - (y₂ w.1 : ℂ) * E₂ =
            ((y₁ w.1 - y₂ w.1 : ℝ) : ℂ) * E₁ + (y₂ w.1 : ℂ) * (E₁ - E₂) := by
          push_cast; ring
        change ‖(y₁ w.1 : ℂ) * E₁ - (y₂ w.1 : ℂ) * E₂‖ ≤ _
        rw [h_decomp]
        have h_tri := norm_add_le (((y₁ w.1 - y₂ w.1 : ℝ) : ℂ) * E₁) ((y₂ w.1 : ℂ) * (E₁ - E₂))
        rw [norm_mul, Complex.norm_real, hE₁_norm, mul_one, norm_mul, Complex.norm_real] at h_tri
        have hy_diff : ‖y₁ w.1 - y₂ w.1‖ ≤ ‖y₁ - y₂‖ := norm_le_pi_norm (y₁ - y₂) w.1
        have hy₂_le : ‖y₂ w.1‖ ≤ ‖y₂‖ := norm_le_pi_norm y₂ w.1
        have h_prod : ‖y₂ w.1‖ * ‖E₁ - E₂‖ ≤ 4 * Real.pi * ‖y₂‖ * |θ₁ w - θ₂ w| := by
          calc
            ‖y₂ w.1‖ * ‖E₁ - E₂‖ ≤ ‖y₂‖ * (4 * Real.pi * |θ₁ w - θ₂ w|) :=
              mul_le_mul hy₂_le hE_diff (norm_nonneg _) (norm_nonneg _)
            _ = 4 * Real.pi * ‖y₂‖ * |θ₁ w - θ₂ w| := by ring
        linarith

  
  have h_s1 : ∃ (M_Y : ℕ)
      (τ : Fin M_Y → ({ w : NumberField.InfinitePlace F // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℝ) → ℝ)
      (g : Fin M_Y → ({ w : NumberField.InfinitePlace F // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℝ) →
        NumberField.mixedEmbedding.realSpace F),
      (∀ (m : Fin M_Y) (p : { w : NumberField.InfinitePlace F // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℝ),
        (∀ w, p w ∈ Set.Icc (0 : ℝ) 1) →
        τ m p ∈ Set.Icc (0 : ℝ) 1 ∧ ∀ w : NumberField.InfinitePlace F, g m p w ∈ Set.Icc (0 : ℝ) 1) ∧
      (∀ (m : Fin M_Y) (p q : { w : NumberField.InfinitePlace F // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℝ)
        (S : ℝ), 0 ≤ S → (∀ w, |p w - q w| ≤ S) →
        |τ m p - τ m q| ≤ S ∧ ‖g m p - g m q‖ ≤ S) ∧
      (∀ x ∈ frontier (NumberField.mixedEmbedding.fundamentalCone.normLeOne F),
        ∃ (m : Fin M_Y) (p : { w : NumberField.InfinitePlace F // w ≠ NumberField.Units.dirichletUnitTheorem.w₀ } → ℝ),
          (∀ w, p w ∈ Set.Icc (0 : ℝ) 1) ∧
          NumberField.mixedEmbedding.normAtAllPlaces x =
            τ m p • NumberField.mixedEmbedding.fundamentalCone.expMapBasis (g m p)) := by
    clear Φ h_s4 h_s2 h_s3
    let w₀ : NumberField.InfinitePlace F := NumberField.Units.dirichletUnitTheorem.w₀
    let W' := { w : NumberField.InfinitePlace F // w ≠ w₀ }
    let FaceIdx := Unit ⊕ Unit ⊕ (W' × Bool)
    let M_Y : ℕ := Fintype.card FaceIdx
    let e_F : Fin M_Y ≃ FaceIdx := (Fintype.equivFin FaceIdx).symm
    let τ_idx : FaceIdx → (W' → ℝ) → ℝ := fun idx p =>
      match idx with
      | Sum.inl () => 0
      | Sum.inr (Sum.inl ()) => 1
      | Sum.inr (Sum.inr (w₁, _)) => p w₁
    let g_idx : FaceIdx → (W' → ℝ) → NumberField.mixedEmbedding.realSpace F := fun idx p w =>
      match idx with
      | Sum.inl () => 0
      | Sum.inr (Sum.inl ()) =>
          if h₀ : w = w₀ then 0 else p ⟨w, h₀⟩
      | Sum.inr (Sum.inr (w₁, ε)) =>
          if h₀ : w = w₀ then 0
          else if w = w₁.1 then (if ε then 1 else 0)
          else p ⟨w, h₀⟩
    let τ : Fin M_Y → (W' → ℝ) → ℝ := fun m => τ_idx (e_F m)
    let g : Fin M_Y → (W' → ℝ) → NumberField.mixedEmbedding.realSpace F := fun m => g_idx (e_F m)
    refine ⟨M_Y, τ, g, ?_, ?_, ?_⟩
    · intro m p hp
      dsimp only [τ, g]
      rcases e_F m with ⟨⟩ | ⟨⟩ | ⟨w₁, ε⟩
      · refine ⟨⟨le_refl 0, zero_le_one⟩, fun _ => ⟨le_refl 0, zero_le_one⟩⟩
      · refine ⟨⟨zero_le_one, le_refl 1⟩, fun w => ?_⟩
        dsimp only [g_idx]
        split_ifs with h₀
        · exact ⟨le_refl 0, zero_le_one⟩
        · exact hp ⟨w, h₀⟩
      · refine ⟨hp w₁, fun w => ?_⟩
        dsimp only [g_idx]
        split_ifs with h₀ hw₁ hε
        · exact ⟨le_refl 0, zero_le_one⟩
        · exact ⟨zero_le_one, le_refl 1⟩
        · exact ⟨le_refl 0, zero_le_one⟩
        · exact hp ⟨w, h₀⟩
    · intro m p q S hS hpq
      dsimp only [τ, g]
      rcases e_F m with ⟨⟩ | ⟨⟩ | ⟨w₁, ε⟩
      · refine ⟨by simp [τ_idx, hS], ?_⟩
        rw [pi_norm_le_iff_of_nonneg hS]
        intro w
        simp [g_idx, hS]
      · refine ⟨by simp [τ_idx, hS], ?_⟩
        rw [pi_norm_le_iff_of_nonneg hS]
        intro w
        dsimp only [Pi.sub_apply, g_idx]
        split_ifs with h₀
        · simp [hS]
        · simpa [Real.norm_eq_abs] using hpq ⟨w, h₀⟩
      · refine ⟨hpq w₁, ?_⟩
        rw [pi_norm_le_iff_of_nonneg hS]
        intro w
        dsimp only [Pi.sub_apply, g_idx]
        split_ifs with h₀ hw₁ hε
        · simp [hS]
        · simp [hS]
        · simp [hS]
        · simpa [Real.norm_eq_abs] using hpq ⟨w, h₀⟩
    · intro x hx
      have hx_cl : NumberField.mixedEmbedding.normAtAllPlaces x ∈
          NumberField.mixedEmbedding.fundamentalCone.compactSet F :=
        NumberField.mixedEmbedding.fundamentalCone.closure_normLeOne_subset F hx.1
      rw [NumberField.mixedEmbedding.fundamentalCone.compactSet_eq_union F] at hx_cl
      rcases hx_cl with ⟨u, hu_cl, hu_eq⟩ | hx_zero
      · have hu_not_int : u ∉ interior (NumberField.mixedEmbedding.fundamentalCone.paramSet F) := by
          intro hu_int
          apply hx.2
          apply NumberField.mixedEmbedding.fundamentalCone.subset_interior_normLeOne F
          exact ⟨u, hu_int, hu_eq⟩
        have hu_cl' := hu_cl
        rw [NumberField.mixedEmbedding.fundamentalCone.closure_paramSet F] at hu_cl'
        have hu_w₀ : u w₀ ≤ 0 := by
          have h := hu_cl' w₀ (Set.mem_univ w₀)
          simpa [w₀] using h
        have hu_ne : ∀ w : W', u w.1 ∈ Set.Icc (0 : ℝ) 1 := by
          intro w
          have h := hu_cl' w.1 (Set.mem_univ w.1)
          have hw_ne : w.1 ≠ NumberField.Units.dirichletUnitTheorem.w₀ := w.2
          simpa [hw_ne] using h
        by_cases hu₀ : u w₀ = 0
        · refine ⟨e_F.symm (Sum.inr (Sum.inl ())), fun w => u w.1, hu_ne, ?_⟩
          dsimp only [τ, g]
          rw [Equiv.apply_symm_apply]
          dsimp only [τ_idx]
          rw [one_smul, ← hu_eq]
          congr 1
          ext w
          dsimp only [g_idx]
          split_ifs with h₀
          · subst h₀; exact hu₀
          · rfl
        · have hu₀_lt : u w₀ < 0 := lt_of_le_of_ne hu_w₀ hu₀
          have h_exists_wall : ∃ w₁ : W', u w₁.1 ∉ Set.Ioo (0 : ℝ) 1 := by
            by_contra! h_all
            apply hu_not_int
            rw [NumberField.mixedEmbedding.fundamentalCone.interior_paramSet F]
            intro w _
            dsimp only
            split_ifs with h₀
            · subst h₀; exact hu₀_lt
            · exact h_all ⟨w, h₀⟩
          rcases h_exists_wall with ⟨w₁, hw₁_not⟩
          have hw₁_Icc := hu_ne w₁
          have hw₁_01 : u w₁.1 = 0 ∨ u w₁.1 = 1 := by
            rw [Set.mem_Icc] at hw₁_Icc
            rw [Set.mem_Ioo, not_and_or, not_lt, not_lt] at hw₁_not
            rcases hw₁_not with h_le0 | h_ge1
            · left; linarith
            · right; linarith
          let ε : Bool := decide (u w₁.1 = 1)
          have hw₁_eq : u w₁.1 = if ε then 1 else 0 := by
            dsimp only [ε]
            rcases hw₁_01 with h0 | h1
            · simp [h0]
            · simp [h1]
          let p : W' → ℝ := fun w => if w = w₁ then Real.exp (u w₀) else u w.1
          have hp_Icc : ∀ w : W', p w ∈ Set.Icc (0 : ℝ) 1 := by
            intro w
            dsimp only [p]
            split_ifs with hw
            · exact ⟨(Real.exp_pos _).le, Real.exp_le_one_iff.mpr hu_w₀⟩
            · exact hu_ne w
          refine ⟨e_F.symm (Sum.inr (Sum.inr (w₁, ε))), p, hp_Icc, ?_⟩
          dsimp only [τ, g]
          rw [Equiv.apply_symm_apply]
          dsimp only [τ_idx]
          have hp_w₁ : p w₁ = Real.exp (u w₀) := by simp [p]
          rw [hp_w₁, ← hu_eq, NumberField.mixedEmbedding.fundamentalCone.expMapBasis_apply'' u]
          congr 2
          ext w
          dsimp only [g_idx]
          by_cases h₀ : w = w₀
          · subst h₀; simp [w₀]
          · by_cases hw₁ : w = w₁.1
            · subst hw₁
              have h₀' : w₁.1 ≠ NumberField.Units.dirichletUnitTheorem.w₀ := w₁.2
              simp [h₀, h₀', hw₁_eq]
            · have h₀' : w ≠ NumberField.Units.dirichletUnitTheorem.w₀ := h₀
              have h_ne : (⟨w, h₀⟩ : W') ≠ w₁ := fun h_eq => hw₁ (congrArg Subtype.val h_eq)
              simp [p, h₀, h₀', hw₁, h_ne]
      · have hx0 : NumberField.mixedEmbedding.normAtAllPlaces x = 0 := Set.mem_singleton_iff.mp hx_zero
        refine ⟨e_F.symm (Sum.inl ()), fun _ => 0, fun _ => ⟨le_refl 0, zero_le_one⟩, ?_⟩
        dsimp only [τ, g]
        rw [Equiv.apply_symm_apply]
        dsimp only [τ_idx]
        rw [zero_smul, hx0]
  let d := Module.finrank ℚ F
  let w₀ : NumberField.InfinitePlace F := NumberField.Units.dirichletUnitTheorem.w₀
  let W' := { w : NumberField.InfinitePlace F // w ≠ w₀ }
  let W_R := { w : NumberField.InfinitePlace F // w.IsReal }
  let W_C := { w : NumberField.InfinitePlace F // w.IsComplex }
  obtain ⟨e_param⟩ := h_s4
  obtain ⟨B_E, L_E, hB_E, hL_E, h_bdd_E, h_lip_E⟩ := h_s2
  obtain ⟨Ψ, h_lift, h_lip_Ψ⟩ := h_s3
  obtain ⟨M_Y, τ, g, h_Icc, h_lip_tg, h_front⟩ := h_s1

  
  let Idx := Fin M_Y × (W_R → Bool)
  let M : ℕ := Fintype.card Idx
  let e_idx : Fin M ≃ Idx := (Fintype.equivFin Idx).symm
  let p_of : (Fin (d - 1) → ℝ) → (W' → ℝ) := fun u w => u (e_param (Sum.inl w))
  let θ_of : (Fin (d - 1) → ℝ) → (W_C → ℝ) := fun u w => u (e_param (Sum.inr w))
  let Y : Fin M → (W' → ℝ) → NumberField.mixedEmbedding.realSpace F :=
    fun m p => τ (e_idx m).1 p • NumberField.mixedEmbedding.fundamentalCone.expMapBasis (g (e_idx m).1 p)
  let γ : Fin M → (Fin (d - 1) → ℝ) → (Fin d → ℝ) :=
    fun m u => Φ (Ψ (e_idx m).2 (Y m (p_of u)) (θ_of u))
  let L_lip : ℝ := ‖Φ.toContinuousLinearMap‖ * (B_E + L_E + 4 * Real.pi * B_E)
  have hL_lip_nonneg : 0 ≤ L_lip := by
    dsimp only [L_lip]
    refine mul_nonneg (norm_nonneg _) ?_
    have h_pi : 0 ≤ Real.pi := Real.pi_pos.le
    positivity
  refine ⟨M, L_lip, γ, hL_lip_nonneg, ?_, ?_⟩
  · intro m u v hu hv i
    let S : ℝ := ∑ j : Fin (d - 1), |u j - v j|
    have hS_nonneg : 0 ≤ S := Finset.sum_nonneg (fun j _ => abs_nonneg (u j - v j))
    have hp_u : ∀ w : W', p_of u w ∈ Set.Icc (0 : ℝ) 1 := fun w => hu (e_param (Sum.inl w))
    have hp_v : ∀ w : W', p_of v w ∈ Set.Icc (0 : ℝ) 1 := fun w => hv (e_param (Sum.inl w))
    have hgp_u := h_Icc (e_idx m).1 (p_of u) hp_u
    have hgp_v := h_Icc (e_idx m).1 (p_of v) hp_v
    have hp_diff : ∀ w : W', |p_of u w - p_of v w| ≤ S := fun w =>
      Finset.single_le_sum (fun j _ => abs_nonneg (u j - v j)) (Finset.mem_univ (e_param (Sum.inl w)))
    have hθ_diff : ∀ w : W_C, |θ_of u w - θ_of v w| ≤ S := fun w =>
      Finset.single_le_sum (fun j _ => abs_nonneg (u j - v j)) (Finset.mem_univ (e_param (Sum.inr w)))
    have htg_diff := h_lip_tg (e_idx m).1 (p_of u) (p_of v) S hS_nonneg hp_diff
    let E_u := NumberField.mixedEmbedding.fundamentalCone.expMapBasis (g (e_idx m).1 (p_of u))
    let E_v := NumberField.mixedEmbedding.fundamentalCone.expMapBasis (g (e_idx m).1 (p_of v))
    have hEu_bdd : ‖E_u‖ ≤ B_E := h_bdd_E _ hgp_u.2
    have hEv_bdd : ‖E_v‖ ≤ B_E := h_bdd_E _ hgp_v.2
    have hE_diff : ‖E_u - E_v‖ ≤ L_E * S :=
      (h_lip_E _ _ hgp_u.2 hgp_v.2).trans (mul_le_mul_of_nonneg_left htg_diff.2 hL_E)
    let τ_u := τ (e_idx m).1 (p_of u)
    let τ_v := τ (e_idx m).1 (p_of v)
    have hτv_abs : |τ_v| ≤ 1 := by
      rw [abs_of_nonneg hgp_v.1.1]
      exact hgp_v.1.2
    have hYv_bdd : ‖Y m (p_of v)‖ ≤ B_E := by
      dsimp only [Y]
      rw [norm_smul, Real.norm_eq_abs]
      calc
        |τ_v| * ‖E_v‖ ≤ 1 * B_E := mul_le_mul hτv_abs hEv_bdd (norm_nonneg _) zero_le_one
        _ = B_E := one_mul B_E
    have hY_diff : ‖Y m (p_of u) - Y m (p_of v)‖ ≤ (B_E + L_E) * S := by
      have h_decomp : Y m (p_of u) - Y m (p_of v) = (τ_u - τ_v) • E_u + τ_v • (E_u - E_v) := by
        ext w
        simp [Y, τ_u, τ_v, E_u, E_v]
        ring
      rw [h_decomp]
      have h_tri := norm_add_le ((τ_u - τ_v) • E_u) (τ_v • (E_u - E_v))
      rw [norm_smul, Real.norm_eq_abs, norm_smul, Real.norm_eq_abs] at h_tri
      have h1 : |τ_u - τ_v| * ‖E_u‖ ≤ S * B_E :=
        mul_le_mul htg_diff.1 hEu_bdd (norm_nonneg _) hS_nonneg
      have h2 : |τ_v| * ‖E_u - E_v‖ ≤ 1 * (L_E * S) :=
        mul_le_mul hτv_abs hE_diff (norm_nonneg _) zero_le_one
      linarith
    let C_Ψ : ℝ := (B_E + L_E + 4 * Real.pi * B_E) * S
    have hC_Ψ_nonneg : 0 ≤ C_Ψ := by
      dsimp only [C_Ψ]
      have h_pi : 0 ≤ Real.pi := Real.pi_pos.le
      positivity
    have hΨ_diff : ‖Ψ (e_idx m).2 (Y m (p_of u)) (θ_of u) - Ψ (e_idx m).2 (Y m (p_of v)) (θ_of v)‖ ≤ C_Ψ := by
      have h_lip_m := h_lip_Ψ (e_idx m).2 (Y m (p_of u)) (Y m (p_of v)) (θ_of u) (θ_of v)
      rw [Prod.norm_def, max_le_iff]
      refine ⟨?_, ?_⟩
      · rw [pi_norm_le_iff_of_nonneg hC_Ψ_nonneg]
        intro w
        have hw := (h_lip_m.1 w).trans hY_diff
        have h_extra : 0 ≤ 4 * Real.pi * B_E * S := by
          have h_pi : 0 ≤ Real.pi := Real.pi_pos.le
          positivity
        dsimp only [Prod.fst_sub, Pi.sub_apply, Real.norm_eq_abs]
        linarith
      · rw [pi_norm_le_iff_of_nonneg hC_Ψ_nonneg]
        intro w
        have hw := h_lip_m.2 w
        have h_term2 : 4 * Real.pi * ‖Y m (p_of v)‖ * |θ_of u w - θ_of v w| ≤ 4 * Real.pi * B_E * S := by
          have h_pi : 0 ≤ 4 * Real.pi := by linarith [Real.pi_pos]
          have h_yv : 4 * Real.pi * ‖Y m (p_of v)‖ ≤ 4 * Real.pi * B_E :=
            mul_le_mul_of_nonneg_left hYv_bdd h_pi
          exact mul_le_mul h_yv (hθ_diff w) (abs_nonneg _) (by positivity)
        dsimp only [Prod.snd_sub, Pi.sub_apply]
        linarith
    have h_coord : |γ m u i - γ m v i| ≤ ‖Φ.toContinuousLinearMap (Ψ (e_idx m).2 (Y m (p_of u)) (θ_of u) - Ψ (e_idx m).2 (Y m (p_of v)) (θ_of v))‖ := by
      dsimp only [γ]
      have h_sub : Φ (Ψ (e_idx m).2 (Y m (p_of u)) (θ_of u)) i - Φ (Ψ (e_idx m).2 (Y m (p_of v)) (θ_of v)) i =
          (Φ.toContinuousLinearMap (Ψ (e_idx m).2 (Y m (p_of u)) (θ_of u) - Ψ (e_idx m).2 (Y m (p_of v)) (θ_of v))) i := by
        rw [map_sub, Pi.sub_apply]
        rfl
      rw [h_sub, ← Real.norm_eq_abs]
      exact norm_le_pi_norm _ i
    have h_op := Φ.toContinuousLinearMap.le_opNorm
      (Ψ (e_idx m).2 (Y m (p_of u)) (θ_of u) - Ψ (e_idx m).2 (Y m (p_of v)) (θ_of v))
    calc
      |γ m u i - γ m v i|
          ≤ ‖Φ.toContinuousLinearMap‖ * ‖Ψ (e_idx m).2 (Y m (p_of u)) (θ_of u) - Ψ (e_idx m).2 (Y m (p_of v)) (θ_of v)‖ :=
            h_coord.trans h_op
      _ ≤ ‖Φ.toContinuousLinearMap‖ * C_Ψ := mul_le_mul_of_nonneg_left hΨ_diff (norm_nonneg _)
      _ = L_lip * S := by dsimp only [L_lip, C_Ψ]; ring
  · intro z hz
    change z ∈ frontier (⇑Φ.toHomeomorph '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F) at hz
    rw [← Φ.toHomeomorph.image_frontier (NumberField.mixedEmbedding.fundamentalCone.normLeOne F)] at hz
    rcases hz with ⟨x, hx_front, rfl⟩
    obtain ⟨m_Y, p, hp_Icc, hx_norm⟩ := h_front x hx_front
    obtain ⟨σ, θ, hθ_Icc, hx_lift⟩ := h_lift x
    let m : Fin M := e_idx.symm (m_Y, σ)
    let u : Fin (d - 1) → ℝ := fun j => Sum.elim p θ (e_param.symm j)
    have hu_Icc : ∀ j : Fin (d - 1), u j ∈ Set.Icc (0 : ℝ) 1 := by
      intro j
      dsimp only [u]
      rcases e_param.symm j with w | w
      · exact hp_Icc w
      · exact hθ_Icc w
    rw [Set.mem_iUnion]
    refine ⟨m, u, hu_Icc, ?_⟩
    dsimp only [γ, Y]
    have hm : e_idx m = (m_Y, σ) := Equiv.apply_symm_apply e_idx (m_Y, σ)
    have hp_u : p_of u = p := by
      ext w
      dsimp only [p_of, u]
      rw [Equiv.symm_apply_apply]
      rfl
    have hθ_u : θ_of u = θ := by
      ext w
      dsimp only [θ_of, u]
      rw [Equiv.symm_apply_apply]
      rfl
    rw [hm, hp_u, hθ_u]
    dsimp only
    rw [← hx_norm, hx_lift]
    rfl

theorem int_lattice_natCard_sub_volume_mul_pow_le_of_frontier_lipschitz_cover (d : ℕ) (hd : 0 < d) (Ω : Set (Fin d → ℝ))
    (hBdd : Bornology.IsBounded Ω) (hMeas : MeasurableSet Ω)
    (M : ℕ) (L_lip : ℝ) (hL : 0 ≤ L_lip)
    (γ : Fin M → (Fin (d - 1) → ℝ) → (Fin d → ℝ))
    (hLip : ∀ (m : Fin M) (u v : Fin (d - 1) → ℝ),
      (∀ j, u j ∈ Set.Icc (0 : ℝ) 1) →
      (∀ j, v j ∈ Set.Icc (0 : ℝ) 1) →
      ∀ i : Fin d,
        |γ m u i - γ m v i| ≤ L_lip * ∑ j : Fin (d - 1), |u j - v j|)
    (hFront : frontier Ω ⊆
      ⋃ m : Fin M, γ m '' { u : Fin (d - 1) → ℝ | ∀ j, u j ∈ Set.Icc (0 : ℝ) 1 }) :
    ∃ B : ℝ, ∀ R : ℝ, 1 ≤ R →
      |(Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } : ℝ) -
        MeasureTheory.volume.real Ω * R ^ d| ≤ B * R ^ (d - 1) :=
by
  classical
  have h_step1 : ∀ (R : ℝ), 0 < R → ∀ (z : Fin d → ℤ) (y : Fin d → ℝ),
      (∀ i : Fin d, (z i : ℝ) ≤ y i ∧ y i ≤ (z i : ℝ) + 1) →
      (((fun i : Fin d => (z i : ℝ) / R) ∈ Ω ∧ (fun i : Fin d => y i / R) ∉ Ω) ∨
       ((fun i : Fin d => (z i : ℝ) / R) ∉ Ω ∧ (fun i : Fin d => y i / R) ∈ Ω)) →
      ∃ w ∈ frontier Ω, ∀ i : Fin d, |(z i : ℝ) - R * w i| ≤ 1 := by
    intro R hR z y hy hStraddle
    let K : Set (Fin d → ℝ) :=
      Set.univ.pi (fun i : Fin d => Set.Icc ((z i : ℝ) / R) (((z i : ℝ) + 1) / R))
    have hK_conv : Convex ℝ K := convex_pi (fun i _ => convex_Icc _ _)
    have hK_pre : IsPreconnected K := hK_conv.isPreconnected
    let p : Fin d → ℝ := fun i => (z i : ℝ) / R
    let q : Fin d → ℝ := fun i => y i / R
    have hpK : p ∈ K := by
      intro i _
      exact ⟨le_rfl, div_le_div_of_nonneg_right (by linarith) hR.le⟩
    have hqK : q ∈ K := by
      intro i _
      exact ⟨div_le_div_of_nonneg_right (hy i).1 hR.le,
             div_le_div_of_nonneg_right (hy i).2 hR.le⟩
    have h_inter : (K ∩ frontier Ω).Nonempty := by
      by_contra h_empty
      rw [Set.not_nonempty_iff_eq_empty] at h_empty
      have hK_sub : K ⊆ interior Ω ∪ interior Ωᶜ := by
        intro x hx
        have hx_not_front : x ∉ frontier Ω := by
          intro hxf
          have : x ∈ K ∩ frontier Ω := ⟨hx, hxf⟩
          rw [h_empty] at this
          exact this
        have h_compl : (frontier Ω)ᶜ = interior Ω ∪ interior Ωᶜ := compl_frontier_eq_union_interior
        exact h_compl ▸ hx_not_front
      have h_disj : K ∩ (interior Ω ∩ interior Ωᶜ) = ∅ := by
        ext x
        simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
        intro _ hx1 hx2
        exact (interior_subset hx2) (interior_subset hx1)
      have h_or := isPreconnected_iff_subset_of_disjoint.mp hK_pre (interior Ω) (interior Ωᶜ)
        isOpen_interior isOpen_interior hK_sub h_disj
      rcases h_or with hK_in | hK_out
      · have hp_in : p ∈ Ω := interior_subset (hK_in hpK)
        have hq_in : q ∈ Ω := interior_subset (hK_in hqK)
        rcases hStraddle with ⟨_, hq_not⟩ | ⟨hp_not, _⟩
        · exact hq_not hq_in
        · exact hp_not hp_in
      · have hp_out : p ∉ Ω := interior_subset (hK_out hpK)
        have hq_out : q ∉ Ω := interior_subset (hK_out hqK)
        rcases hStraddle with ⟨hp_in, _⟩ | ⟨_, hq_in⟩
        · exact hp_out hp_in
        · exact hq_out hq_in
    rcases h_inter with ⟨w, hwK, hwF⟩
    refine ⟨w, hwF, fun i => ?_⟩
    have hwi := hwK i (Set.mem_univ i)
    have h1 : (z i : ℝ) ≤ R * w i := by
      have := (div_le_iff₀ hR).mp hwi.1
      linarith
    have h2 : R * w i ≤ (z i : ℝ) + 1 := by
      have := (le_div_iff₀ hR).mp hwi.2
      linarith
    rw [abs_le]
    constructor <;> linarith

  have h_step2 : ∀ (R : ℝ), 0 < R → ∀ (F_bdry : Finset (Fin d → ℤ)),
      (∀ (z : Fin d → ℤ) (y : Fin d → ℝ),
        (∀ i : Fin d, (z i : ℝ) ≤ y i ∧ y i < (z i : ℝ) + 1) →
        (((fun i : Fin d => (z i : ℝ) / R) ∈ Ω ∧ (fun i : Fin d => y i / R) ∉ Ω) ∨
         ((fun i : Fin d => (z i : ℝ) / R) ∉ Ω ∧ (fun i : Fin d => y i / R) ∈ Ω)) →
        z ∈ F_bdry) →
      |(Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } : ℝ) -
        MeasureTheory.volume.real Ω * R ^ d| ≤ (F_bdry.card : ℝ) := by
    intro R hR F_bdry hCover
    obtain ⟨C, hC_pos, hC_le⟩ := hBdd.exists_pos_norm_le
    let B_nat : ℕ := Nat.ceil (R * C)
    let B_int : ℤ := (B_nat : ℤ)
    let Box_in : Finset (Fin d → ℤ) :=
      Fintype.piFinset (fun _ : Fin d => Finset.Icc (-B_int) B_int)
    let F_in : Finset (Fin d → ℤ) :=
      Box_in.filter (fun z => (fun i : Fin d => (z i : ℝ) / R) ∈ Ω)
    have h_mem_Fin : ∀ z : Fin d → ℤ,
        z ∈ F_in ↔ (fun i : Fin d => (z i : ℝ) / R) ∈ Ω := by
      intro z
      rw [Finset.mem_filter]
      refine ⟨fun h => h.2, fun hz => ⟨?_, hz⟩⟩
      rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_Icc]
      have h_norm_pt : ‖(fun j : Fin d => (z j : ℝ) / R)‖ ≤ C := hC_le _ hz
      have h_coord_le : ‖(z i : ℝ) / R‖ ≤ C :=
        (norm_le_pi_norm (fun j : Fin d => (z j : ℝ) / R) i).trans h_norm_pt
      rw [Real.norm_eq_abs, abs_div, abs_of_pos hR, div_le_iff₀ hR] at h_coord_le
      have h_le_B : |(z i : ℝ)| ≤ (B_int : ℝ) := by
        have h_ceil : R * C ≤ (B_nat : ℝ) := Nat.le_ceil (R * C)
        have h_cast : (B_int : ℝ) = (B_nat : ℝ) := by exact_mod_cast rfl
        linarith
      have h_abs := abs_le.mp h_le_B
      have h1 : ((-B_int : ℤ) : ℝ) ≤ (z i : ℝ) := by push_cast; linarith
      have h2 : (z i : ℝ) ≤ (B_int : ℝ) := by linarith
      exact ⟨Int.cast_le.mp h1, Int.cast_le.mp h2⟩
    have h_card_Fin : Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } = F_in.card := by
      have e : { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } ≃ { z : Fin d → ℤ // z ∈ F_in } :=
        Equiv.subtypeEquivRight (fun z => (h_mem_Fin z).symm)
      rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_coe]

    let Q : (Fin d → ℤ) → Set (Fin d → ℝ) := fun z =>
      Set.univ.pi (fun i : Fin d => Set.Ico (z i : ℝ) ((z i : ℝ) + 1))
    have hQ_meas : ∀ z : Fin d → ℤ, MeasurableSet (Q z) :=
      fun z => MeasurableSet.univ_pi (fun _ => measurableSet_Ico)
    have hQ_vol : ∀ z : Fin d → ℤ, MeasureTheory.volume (Q z) = 1 := by
      intro z
      dsimp [Q]
      rw [Real.volume_pi_Ico]
      have h_diff : ∀ i : Fin d, ENNReal.ofReal (((z i : ℝ) + 1) - (z i : ℝ)) = 1 := by
        intro i
        rw [add_sub_cancel_left, ENNReal.ofReal_one]
      simp_rw [h_diff, Finset.prod_const_one]
    have hQ_ne_top : ∀ z : Fin d → ℤ, MeasureTheory.volume (Q z) ≠ ⊤ := by
      intro z
      rw [hQ_vol z]
      exact ENNReal.one_ne_top
    have hQ_vol_real : ∀ z : Fin d → ℤ, MeasureTheory.volume.real (Q z) = 1 := by
      intro z
      rw [MeasureTheory.measureReal_def, hQ_vol z, ENNReal.toReal_one]
    have hQ_disj : (F_in : Set (Fin d → ℤ)).PairwiseDisjoint Q := by
      intro z₁ _ z₂ _ hne
      change Disjoint (Q z₁) (Q z₂)
      rw [Set.disjoint_left]
      intro y hy1 hy2
      apply hne
      ext i
      have h1 := hy1 i (Set.mem_univ i)
      have h2 := hy2 i (Set.mem_univ i)
      have hf1 : Int.floor (y i) = z₁ i := Int.floor_eq_iff.mpr ⟨h1.1, h1.2⟩
      have hf2 : Int.floor (y i) = z₂ i := Int.floor_eq_iff.mpr ⟨h2.1, h2.2⟩
      exact hf1.symm.trans hf2

    let U : Set (Fin d → ℝ) := ⋃ z ∈ F_in, Q z
    have hU_vol_real : MeasureTheory.volume.real U = (F_in.card : ℝ) := by
      dsimp [U]
      rw [MeasureTheory.measureReal_biUnion_finset hQ_disj (fun z _ => hQ_meas z) (fun z _ => hQ_ne_top z)]
      simp_rw [hQ_vol_real, Finset.sum_const, nsmul_eq_mul, mul_one]

    let W : Set (Fin d → ℝ) := ⋃ z ∈ F_bdry, Q z
    have hW_ne_top : MeasureTheory.volume W ≠ ⊤ := by
      dsimp [W]
      exact (MeasureTheory.measure_biUnion_lt_top F_bdry.finite_toSet (fun z _ => (hQ_ne_top z).lt_top)).ne
    have hW_vol_real : MeasureTheory.volume.real W ≤ (F_bdry.card : ℝ) := by
      calc
        MeasureTheory.volume.real W ≤ ∑ z ∈ F_bdry, MeasureTheory.volume.real (Q z) :=
          MeasureTheory.measureReal_biUnion_finset_le F_bdry Q
        _ = (F_bdry.card : ℝ) := by
          simp_rw [hQ_vol_real, Finset.sum_const, nsmul_eq_mul, mul_one]

    let Ω_R : Set (Fin d → ℝ) := (fun y : Fin d → ℝ => R⁻¹ • y) ⁻¹' Ω
    have hR_inv_pos : 0 < R⁻¹ := inv_pos.mpr hR
    have hR_inv_ne : R⁻¹ ≠ 0 := hR_inv_pos.ne'
    have hΩR_vol : MeasureTheory.volume Ω_R = ENNReal.ofReal (R ^ d) * MeasureTheory.volume Ω := by
      dsimp [Ω_R]
      rw [MeasureTheory.Measure.addHaar_preimage_smul MeasureTheory.volume hR_inv_ne Ω,
        Module.finrank_fin_fun ℝ, inv_pow, inv_inv, abs_of_pos (pow_pos hR d)]
    have hΩR_ne_top : MeasureTheory.volume Ω_R ≠ ⊤ := by
      rw [hΩR_vol]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hBdd.measure_lt_top.ne
    have hU_ne_top : MeasureTheory.volume U ≠ ⊤ := by
      dsimp [U]
      exact (MeasureTheory.measure_biUnion_lt_top F_in.finite_toSet (fun z _ => (hQ_ne_top z).lt_top)).ne
    have hΩR_vol_real : MeasureTheory.volume.real Ω_R = MeasureTheory.volume.real Ω * R ^ d := by
      rw [MeasureTheory.measureReal_def, hΩR_vol, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (pow_nonneg hR.le d), MeasureTheory.measureReal_def, mul_comm]

    have h_diff1 : U \ Ω_R ⊆ W := by
      intro y ⟨hyU, hy_not_ΩR⟩
      dsimp [U] at hyU
      rw [Set.mem_iUnion₂] at hyU
      rcases hyU with ⟨z, hz_in, hyQ⟩
      have hz_Ω : (fun i : Fin d => (z i : ℝ) / R) ∈ Ω := (h_mem_Fin z).mp hz_in
      have hy_Ω : (fun i : Fin d => y i / R) ∉ Ω := by
        intro hy_in
        apply hy_not_ΩR
        change (fun i : Fin d => R⁻¹ * y i) ∈ Ω
        convert hy_in using 1
        ext i
        ring
      have hz_bdry : z ∈ F_bdry :=
        hCover z y (fun i => hyQ i (Set.mem_univ i)) (Or.inl ⟨hz_Ω, hy_Ω⟩)
      dsimp [W]
      rw [Set.mem_iUnion₂]
      exact ⟨z, hz_bdry, hyQ⟩

    have h_diff2 : Ω_R \ U ⊆ W := by
      intro y ⟨hy_ΩR, hy_not_U⟩
      let z : Fin d → ℤ := fun i => Int.floor (y i)
      have hyQ : y ∈ Q z := by
        intro i _
        exact ⟨Int.floor_le (y i), Int.lt_floor_add_one (y i)⟩
      have hz_not_in : z ∉ F_in := by
        intro hz_in
        apply hy_not_U
        dsimp [U]
        rw [Set.mem_iUnion₂]
        exact ⟨z, hz_in, hyQ⟩
      have hz_not_Ω : (fun i : Fin d => (z i : ℝ) / R) ∉ Ω :=
        fun hz_Ω => hz_not_in ((h_mem_Fin z).mpr hz_Ω)
      have hy_Ω : (fun i : Fin d => y i / R) ∈ Ω := by
        change (fun i : Fin d => R⁻¹ * y i) ∈ Ω at hy_ΩR
        convert hy_ΩR using 1
        ext i
        ring
      have hz_bdry : z ∈ F_bdry :=
        hCover z y (fun i => hyQ i (Set.mem_univ i)) (Or.inr ⟨hz_not_Ω, hy_Ω⟩)
      dsimp [W]
      rw [Set.mem_iUnion₂]
      exact ⟨z, hz_bdry, hyQ⟩

    rw [h_card_Fin, ← hU_vol_real, ← hΩR_vol_real]
    refine (abs_sub_le_iff.mpr ⟨?_, ?_⟩).trans hW_vol_real
    · exact le_trans (MeasureTheory.le_measureReal_diff (h := hΩR_ne_top)) (MeasureTheory.measureReal_mono h_diff1 hW_ne_top)
    · exact le_trans (MeasureTheory.le_measureReal_diff (h := hU_ne_top)) (MeasureTheory.measureReal_mono h_diff2 hW_ne_top)

  have h_step3 : ∀ (R : ℝ), 1 ≤ R → ∀ (z : Fin d → ℤ) (w : Fin d → ℝ),
      w ∈ frontier Ω →
      (∀ i : Fin d, |(z i : ℝ) - R * w i| ≤ 1) →
      ∃ (m : Fin M) (k : Fin (d - 1) → Fin (Nat.ceil R)),
        ∀ i : Fin d,
          |(z i : ℝ) -
            R * γ m (fun j : Fin (d - 1) => ((k j : ℕ) : ℝ) / (Nat.ceil R : ℝ)) i| ≤
            1 + L_lip * ((d - 1 : ℕ) : ℝ) := by
    intro R hR z w hw hzw
    have hw_cov := hFront hw
    rw [Set.mem_iUnion] at hw_cov
    rcases hw_cov with ⟨m, u, hu, rfl⟩
    let N := Nat.ceil R
    have hR_pos : 0 < R := by linarith
    have hN_pos : 0 < N := Nat.ceil_pos.mpr hR_pos
    have hN_real_pos : (0 : ℝ) < (N : ℝ) := Nat.cast_pos.mpr hN_pos
    have hR_le_N : R ≤ (N : ℝ) := Nat.le_ceil R
    let k : Fin (d - 1) → Fin N := fun j =>
      ⟨min (Int.floor (u j * (N : ℝ))).toNat (N - 1),
       Nat.lt_of_le_of_lt (Nat.min_le_right _ _) (Nat.sub_lt hN_pos zero_lt_one)⟩
    let v : Fin (d - 1) → ℝ := fun j => ((k j : ℕ) : ℝ) / (N : ℝ)
    have hv_mem : ∀ j : Fin (d - 1), v j ∈ Set.Icc (0 : ℝ) 1 := by
      intro j
      constructor
      · exact div_nonneg (Nat.cast_nonneg _) hN_real_pos.le
      · rw [div_le_one hN_real_pos]
        exact Nat.cast_le.mpr (le_of_lt (k j).2)
    have huv_diff : ∀ j : Fin (d - 1), |u j - v j| ≤ 1 / (N : ℝ) := by
      intro j
      have huj := hu j
      have huj0 : 0 ≤ u j := huj.1
      have huj1 : u j ≤ 1 := huj.2
      have h_mul_nonneg : 0 ≤ u j * (N : ℝ) := mul_nonneg huj0 hN_real_pos.le
      have h_floor_nonneg : 0 ≤ Int.floor (u j * (N : ℝ)) := Int.floor_nonneg.mpr h_mul_nonneg
      let a := (Int.floor (u j * (N : ℝ))).toNat
      have ha_cast : (a : ℝ) = (Int.floor (u j * (N : ℝ)) : ℝ) := by
        have : (a : ℤ) = Int.floor (u j * (N : ℝ)) := Int.toNat_of_nonneg h_floor_nonneg
        exact_mod_cast this
      have ha_le : (a : ℝ) ≤ u j * (N : ℝ) := by
        rw [ha_cast]
        exact Int.floor_le (u j * (N : ℝ))
      have h_lt_a_add : u j * (N : ℝ) < (a : ℝ) + 1 := by
        rw [ha_cast]
        exact Int.lt_floor_add_one (u j * (N : ℝ))
      have hk_bounds : ((k j : ℕ) : ℝ) ≤ u j * (N : ℝ) ∧ u j * (N : ℝ) ≤ ((k j : ℕ) : ℝ) + 1 := by
        change ((min a (N - 1) : ℕ) : ℝ) ≤ u j * (N : ℝ) ∧
          u j * (N : ℝ) ≤ ((min a (N - 1) : ℕ) : ℝ) + 1
        by_cases h_case : a ≤ N - 1
        · rw [Nat.min_eq_left h_case]
          exact ⟨ha_le, h_lt_a_add.le⟩
        · push_neg at h_case
          rw [Nat.min_eq_right h_case.le]
          have hN_sub_cast : ((N - 1 : ℕ) : ℝ) + 1 = (N : ℝ) := by
            exact_mod_cast Nat.sub_add_cancel hN_pos
          have h_uN_le_N : u j * (N : ℝ) ≤ (N : ℝ) := by nlinarith
          have h_N_le_a : N ≤ a := by omega
          have h_N_le_uN : (N : ℝ) ≤ u j * (N : ℝ) :=
            (Nat.cast_le.mpr h_N_le_a).trans ha_le
          constructor <;> linarith
      have hv_le_u : v j ≤ u j := by
        dsimp [v]
        rw [div_le_iff₀ hN_real_pos]
        exact hk_bounds.1
      have hu_le_v_add : u j ≤ v j + 1 / (N : ℝ) := by
        dsimp [v]
        rw [← add_div, le_div_iff₀ hN_real_pos]
        exact hk_bounds.2
      rw [abs_le]
      constructor <;> linarith
    refine ⟨m, k, fun i => ?_⟩
    have h_lip_i := hLip m u v hu hv_mem i
    have h_sum_le : (∑ j : Fin (d - 1), |u j - v j|) ≤ ((d - 1 : ℕ) : ℝ) / (N : ℝ) := by
      calc
        (∑ j : Fin (d - 1), |u j - v j|) ≤ ∑ _j : Fin (d - 1), (1 / (N : ℝ)) :=
          Finset.sum_le_sum (fun j _ => huv_diff j)
        _ = ((d - 1 : ℕ) : ℝ) * (1 / (N : ℝ)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        _ = ((d - 1 : ℕ) : ℝ) / (N : ℝ) := mul_one_div _ _
    have h_gamma_diff : |γ m u i - γ m v i| ≤ L_lip * (((d - 1 : ℕ) : ℝ) / (N : ℝ)) :=
      h_lip_i.trans (mul_le_mul_of_nonneg_left h_sum_le hL)
    have h_scaled_diff : |R * γ m u i - R * γ m v i| ≤ L_lip * ((d - 1 : ℕ) : ℝ) := by
      rw [← mul_sub, abs_mul, abs_of_pos hR_pos]
      calc
        R * |γ m u i - γ m v i| ≤ (N : ℝ) * (L_lip * (((d - 1 : ℕ) : ℝ) / (N : ℝ))) :=
          mul_le_mul hR_le_N h_gamma_diff (abs_nonneg _) hN_real_pos.le
        _ = L_lip * ((d - 1 : ℕ) : ℝ) * ((N : ℝ) / (N : ℝ)) := by ring
        _ = L_lip * ((d - 1 : ℕ) : ℝ) := by rw [div_self hN_real_pos.ne', mul_one]
    have h_tri : |(z i : ℝ) - R * γ m v i| ≤
        |(z i : ℝ) - R * γ m u i| + |R * γ m u i - R * γ m v i| := by
      have : (z i : ℝ) - R * γ m v i = ((z i : ℝ) - R * γ m u i) + (R * γ m u i - R * γ m v i) := by ring
      rw [this]
      exact abs_add_le _ _
    linarith [hzw i]

  have h_step4 : ∀ (N : ℕ) (Δ : ℝ), 0 ≤ Δ →
      ∀ (c : Fin M → (Fin (d - 1) → Fin N) → (Fin d → ℝ)),
        ∃ F : Finset (Fin d → ℤ),
          (∀ z : Fin d → ℤ,
            (∃ (m : Fin M) (k : Fin (d - 1) → Fin N),
              ∀ i : Fin d, |(z i : ℝ) - c m k i| ≤ Δ) →
            z ∈ F) ∧
          F.card ≤ M * (2 * Nat.ceil Δ + 2) ^ d * N ^ (d - 1) := by
    intro N Δ hΔ c
    let K := Nat.ceil Δ
    have hΔ_le_K : Δ ≤ (K : ℝ) := Nat.le_ceil Δ
    let Box : Fin M × (Fin (d - 1) → Fin N) → Finset (Fin d → ℤ) := fun p =>
      Fintype.piFinset (fun i : Fin d =>
        Finset.Icc (Int.floor (c p.1 p.2 i) - (K : ℤ)) (Int.floor (c p.1 p.2 i) + (K : ℤ) + 1))
    let F : Finset (Fin d → ℤ) := Finset.univ.biUnion Box
    refine ⟨F, ?_, ?_⟩
    · intro z ⟨m, k, hz⟩
      rw [Finset.mem_biUnion]
      refine ⟨(m, k), Finset.mem_univ _, ?_⟩
      rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_Icc]
      have hzi := abs_le.mp (hz i)
      have h_fl_le : (Int.floor (c m k i) : ℝ) ≤ c m k i := Int.floor_le (c m k i)
      have h_lt_fl : c m k i < (Int.floor (c m k i) : ℝ) + 1 := Int.lt_floor_add_one (c m k i)
      have h_low_real : ((Int.floor (c m k i) - (K : ℤ) : ℤ) : ℝ) ≤ (z i : ℝ) := by
        push_cast
        linarith
      have h_high_real : (z i : ℝ) ≤ ((Int.floor (c m k i) + (K : ℤ) + 1 : ℤ) : ℝ) := by
        push_cast
        linarith
      exact ⟨Int.cast_le.mp h_low_real, Int.cast_le.mp h_high_real⟩
    · have h_box_card : ∀ p : Fin M × (Fin (d - 1) → Fin N),
          (Box p).card = (2 * K + 2) ^ d := by
        intro p
        dsimp [Box]
        rw [Fintype.card_piFinset]
        have h_interval_card : ∀ i : Fin d,
            (Finset.Icc (Int.floor (c p.1 p.2 i) - (K : ℤ))
              (Int.floor (c p.1 p.2 i) + (K : ℤ) + 1)).card = 2 * K + 2 := by
          intro i
          rw [Int.card_Icc]
          have : Int.floor (c p.1 p.2 i) + (K : ℤ) + 1 + 1 - (Int.floor (c p.1 p.2 i) - (K : ℤ)) =
              ((2 * K + 2 : ℕ) : ℤ) := by
            push_cast
            ring
          rw [this, Int.toNat_natCast]
        simp_rw [h_interval_card]
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      calc
        F.card ≤ ∑ p ∈ (Finset.univ : Finset (Fin M × (Fin (d - 1) → Fin N))), (Box p).card :=
          Finset.card_biUnion_le
        _ = ∑ _p ∈ (Finset.univ : Finset (Fin M × (Fin (d - 1) → Fin N))), (2 * K + 2) ^ d := by
          refine Finset.sum_congr rfl (fun p _ => h_box_card p)
        _ = Fintype.card (Fin M × (Fin (d - 1) → Fin N)) * (2 * K + 2) ^ d := by
          rw [Finset.sum_const, Finset.card_univ, smul_eq_mul]
        _ = (M * N ^ (d - 1)) * (2 * K + 2) ^ d := by
          simp only [Fintype.card_prod, Fintype.card_fun, Fintype.card_fin]
        _ = M * (2 * K + 2) ^ d * N ^ (d - 1) := by ring

  let Δ : ℝ := 1 + L_lip * ((d - 1 : ℕ) : ℝ)
  have hΔ : 0 ≤ Δ := by positivity
  let K : ℕ := Nat.ceil Δ
  let B : ℝ := (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (2 : ℝ) ^ (d - 1)
  refine ⟨B, fun R hR => ?_⟩
  have hR_pos : 0 < R := by linarith
  let N : ℕ := Nat.ceil R
  let c : Fin M → (Fin (d - 1) → Fin N) → (Fin d → ℝ) :=
    fun m k i => R * γ m (fun j => ((k j : ℕ) : ℝ) / (N : ℝ)) i
  obtain ⟨F_bdry, hF_mem, hF_card⟩ := h_step4 N Δ hΔ c
  have hCover : ∀ (z : Fin d → ℤ) (y : Fin d → ℝ),
      (∀ i : Fin d, (z i : ℝ) ≤ y i ∧ y i < (z i : ℝ) + 1) →
      (((fun i : Fin d => (z i : ℝ) / R) ∈ Ω ∧ (fun i : Fin d => y i / R) ∉ Ω) ∨
       ((fun i : Fin d => (z i : ℝ) / R) ∉ Ω ∧ (fun i : Fin d => y i / R) ∈ Ω)) →
      z ∈ F_bdry := by
    intro z y hy hStraddle
    obtain ⟨w, hw_front, hzw⟩ :=
      h_step1 R hR_pos z y (fun i => ⟨(hy i).1, (hy i).2.le⟩) hStraddle
    obtain ⟨m, k, hmk⟩ := h_step3 R hR z w hw_front hzw
    exact hF_mem z ⟨m, k, hmk⟩
  have h_vol_diff := h_step2 R hR_pos F_bdry hCover
  have h_card_real : (F_bdry.card : ℝ) ≤
      (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (N : ℝ) ^ (d - 1) := by
    exact_mod_cast hF_card
  have hN_le_2R : (N : ℝ) ≤ 2 * R := by
    have h_lt : (N : ℝ) < R + 1 := Nat.ceil_lt_add_one hR_pos.le
    linarith
  have hN_pow_le : (N : ℝ) ^ (d - 1) ≤ (2 : ℝ) ^ (d - 1) * R ^ (d - 1) := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (Nat.cast_nonneg N) hN_le_2R (d - 1)
  have h_bound_final :
      (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (N : ℝ) ^ (d - 1) ≤ B * R ^ (d - 1) := by
    dsimp [B]
    calc
      (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (N : ℝ) ^ (d - 1)
          ≤ (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * ((2 : ℝ) ^ (d - 1) * R ^ (d - 1)) :=
        mul_le_mul_of_nonneg_left hN_pow_le (by positivity)
      _ = (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (2 : ℝ) ^ (d - 1) * R ^ (d - 1) := by ring
  exact h_vol_diff.trans (h_card_real.trans h_bound_final)

theorem exists_ideal_ne_bot_absNorm_le_natCard_sub_linear_isBigO {F : Type u} [Field F] [NumberField F] :
    ∃ κ_F : ℝ,
      (fun n : ℕ =>
        (Nat.card { I : Ideal (NumberField.RingOfIntegers F) //
          I ≠ ⊥ ∧ Ideal.absNorm I ≤ n } : ℝ) -
        κ_F * (n : ℝ)) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ (1 - 1 / (Module.finrank ℚ F : ℝ))) :=
by
  classical
  let N_C : ClassGroup (NumberField.RingOfIntegers F) → ℕ → ℕ := fun C n =>
    Nat.card { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
      Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n ∧
      ClassGroup.mk0 I = C }
  have h_step1 : ∀ n : ℕ,
      Nat.card { I : Ideal (NumberField.RingOfIntegers F) //
        I ≠ ⊥ ∧ Ideal.absNorm I ≤ n } =
      ∑ C : ClassGroup (NumberField.RingOfIntegers F), N_C C n := by
    intro n
    let T_n := { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
      Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n }
    have h_mem_nzd : ∀ I : Ideal (NumberField.RingOfIntegers F),
        I ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) ↔ I ≠ ⊥ := by
      intro I
      rw [mem_nonZeroDivisors_iff_ne_zero, Submodule.zero_eq_bot]
    let e_nzd : { I : Ideal (NumberField.RingOfIntegers F) //
        I ≠ ⊥ ∧ Ideal.absNorm I ≤ n } ≃ T_n :=
      { toFun := fun ⟨I, hI_ne, hI_le⟩ => ⟨⟨I, (h_mem_nzd I).mpr hI_ne⟩, hI_le⟩
        invFun := fun ⟨⟨I, hI_mem⟩, hI_le⟩ => ⟨I, (h_mem_nzd I).mp hI_mem, hI_le⟩
        left_inv := fun ⟨_, _, _⟩ => rfl
        right_inv := fun ⟨⟨_, _⟩, _⟩ => rfl }
    rw [Nat.card_congr e_nzd]
    haveI : Finite { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I ≤ n } :=
      Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_le n)
    let ι_T : T_n → { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I ≤ n } :=
      fun x => ⟨x.1.1, x.2⟩
    have hι_T_inj : Function.Injective ι_T := by
      rintro ⟨⟨I₁, _⟩, _⟩ ⟨⟨I₂, _⟩, _⟩ h
      cases h
      rfl
    haveI : Finite T_n := Finite.of_injective ι_T hι_T_inj
    letI : Fintype T_n := Fintype.ofFinite T_n
    let ψ : T_n → ClassGroup (NumberField.RingOfIntegers F) := fun x => ClassGroup.mk0 x.1
    have h_fib : ∀ C : ClassGroup (NumberField.RingOfIntegers F),
        N_C C n = Fintype.card { x : T_n // ψ x = C } := by
      intro C
      dsimp only [N_C]
      rw [← Nat.card_eq_fintype_card]
      let e_C : { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
          Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n ∧
          ClassGroup.mk0 I = C } ≃ { x : T_n // ψ x = C } :=
        { toFun := fun ⟨I, hI_le, hI_C⟩ => ⟨⟨I, hI_le⟩, hI_C⟩
          invFun := fun ⟨⟨I, hI_le⟩, hI_C⟩ => ⟨I, hI_le, hI_C⟩
          left_inv := fun ⟨_, _, _⟩ => rfl
          right_inv := fun ⟨⟨_, _⟩, _⟩ => rfl }
      exact Nat.card_congr e_C
    simp_rw [h_fib]
    rw [← Fintype.card_sigma, ← Nat.card_eq_fintype_card]
    exact (Nat.card_congr (Equiv.sigmaFiberEquiv ψ)).symm

  have h_step2 : ∀ C : ClassGroup (NumberField.RingOfIntegers F),
      ∃ J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)),
        ∀ n : ℕ,
          N_C C n * NumberField.Units.torsionOrder F =
          Nat.card { a : NumberField.mixedEmbedding.fundamentalCone.idealSet F J //
            NumberField.mixedEmbedding.norm (a : NumberField.mixedEmbedding.mixedSpace F) ≤
              (n : ℝ) * (Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) : ℝ) } := by
    intro C
    obtain ⟨J, hJ_mk0⟩ := ClassGroup.mk0_surjective C⁻¹
    refine ⟨J, fun n => ?_⟩
    rw [← NumberField.mixedEmbedding.fundamentalCone.card_isPrincipal_dvd_norm_le F J
      ((n : ℝ) * (Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) : ℝ))]
    congr 1
    have hJ_pos : 0 < Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) :=
      Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr J.2
    have h_mul_inj : ∀ I₁ I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)),
        (J : Ideal (NumberField.RingOfIntegers F)) * I₁ =
        (J : Ideal (NumberField.RingOfIntegers F)) * I₂ → I₁ = I₂ := by
      intro I₁ I₂ h_eq
      have h_nzd_eq : J * I₁ = J * I₂ := Subtype.ext h_eq
      have h_frac := congrArg (FractionalIdeal.mk0 F) h_nzd_eq
      rw [map_mul, map_mul, mul_right_inj] at h_frac
      have h_coe : ((FractionalIdeal.mk0 F I₁ : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) =
          ((FractionalIdeal.mk0 F I₂ : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) :=
        congrArg Units.val h_frac
      rw [FractionalIdeal.coe_mk0, FractionalIdeal.coe_mk0, FractionalIdeal.coeIdeal_inj] at h_coe
      exact Subtype.ext h_coe
    have h_fwd : ∀ I : { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
        Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n ∧
        ClassGroup.mk0 I = C },
        (J : Ideal (NumberField.RingOfIntegers F)) ∣ ((J * I.1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F))) : Ideal (NumberField.RingOfIntegers F)) ∧
        Submodule.IsPrincipal ((J * I.1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F))) : Ideal (NumberField.RingOfIntegers F)) ∧
        (Ideal.absNorm ((J * I.1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F))) : Ideal (NumberField.RingOfIntegers F)) : ℝ) ≤
          (n : ℝ) * (Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) : ℝ) := by
      rintro ⟨I, hI_le, hI_C⟩
      refine ⟨dvd_mul_right _ _, ?_, ?_⟩
      · rw [← ClassGroup.mk0_eq_one_iff (J * I).2, map_mul, hJ_mk0, hI_C, inv_mul_cancel]
      · change (Ideal.absNorm ((J : Ideal (NumberField.RingOfIntegers F)) * (I : Ideal (NumberField.RingOfIntegers F))) : ℝ) ≤ _
        rw [map_mul, Nat.cast_mul, mul_comm]
        exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hI_le) (Nat.cast_nonneg _)
    have h_bwd : ∀ I' : { I' : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
        (J : Ideal (NumberField.RingOfIntegers F)) ∣ (I' : Ideal (NumberField.RingOfIntegers F)) ∧
        Submodule.IsPrincipal (I' : Ideal (NumberField.RingOfIntegers F)) ∧
        (Ideal.absNorm (I' : Ideal (NumberField.RingOfIntegers F)) : ℝ) ≤
          (n : ℝ) * (Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) : ℝ) },
        ∃ I : { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
          Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n ∧
          ClassGroup.mk0 I = C },
          J * I.1 = I'.1 := by
      rintro ⟨I', ⟨I₀, hI₀_mul⟩, hI'_prin, hI'_le⟩
      have hI'_ne_zero : (I' : Ideal (NumberField.RingOfIntegers F)) ≠ 0 :=
        mem_nonZeroDivisors_iff_ne_zero.mp I'.2
      have hI₀_ne_zero : I₀ ≠ 0 := by
        intro h0
        apply hI'_ne_zero
        rw [hI₀_mul, h0, mul_zero]
      let I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) :=
        ⟨I₀, mem_nonZeroDivisors_of_ne_zero hI₀_ne_zero⟩
      have hJI : J * I = I' := Subtype.ext hI₀_mul.symm
      refine ⟨⟨I, ?_, ?_⟩, hJI⟩
      · have h_norm : Ideal.absNorm (I' : Ideal (NumberField.RingOfIntegers F)) =
            Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) * Ideal.absNorm I₀ := by
          rw [hI₀_mul, map_mul]
        have h_le_nat : Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) * Ideal.absNorm I₀ ≤
            n * Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) := by
          exact_mod_cast (h_norm ▸ hI'_le)
        rw [mul_comm] at h_le_nat
        exact Nat.le_of_mul_le_mul_right h_le_nat hJ_pos
      · have h_mk_one : ClassGroup.mk0 I' = 1 :=
          (ClassGroup.mk0_eq_one_iff I'.2).mpr hI'_prin
        rw [← hJI, map_mul, hJ_mk0] at h_mk_one
        exact (inv_mul_eq_one.mp h_mk_one).symm
    choose g hg using h_bwd
    let e_bij : { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
        Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n ∧
        ClassGroup.mk0 I = C } ≃
        { I' : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
          (J : Ideal (NumberField.RingOfIntegers F)) ∣ (I' : Ideal (NumberField.RingOfIntegers F)) ∧
          Submodule.IsPrincipal (I' : Ideal (NumberField.RingOfIntegers F)) ∧
          (Ideal.absNorm (I' : Ideal (NumberField.RingOfIntegers F)) : ℝ) ≤
            (n : ℝ) * (Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F)) : ℝ) } :=
      { toFun := fun I => ⟨J * I.1, h_fwd I⟩
        invFun := g
        left_inv := fun I => by
          apply Subtype.ext
          apply h_mul_inj
          exact congrArg Subtype.val (hg ⟨J * I.1, h_fwd I⟩)
        right_inv := fun I' => Subtype.ext (hg I') }
    exact Nat.card_congr e_bij

  let d := Module.finrank ℚ F
  have h_step3 : ∀ J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)),
      ∃ Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin d → ℝ),
        ∀ R : ℝ, 0 < R →
          Nat.card { a : NumberField.mixedEmbedding.fundamentalCone.idealSet F J //
            NumberField.mixedEmbedding.norm (a : NumberField.mixedEmbedding.mixedSpace F) ≤
              R ^ d } =
          Nat.card { z : Fin d → ℤ //
            (fun i : Fin d => (z i : ℝ) / R) ∈
              Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F } := by
    intro J
    let I_J := FractionalIdeal.mk0 F J
    let L_J := NumberField.mixedEmbedding.idealLattice F I_J
    have h_rank : Fintype.card (Module.Free.ChooseBasisIndex ℤ ↥L_J) = d := by
      rw [← Module.finrank_eq_card_chooseBasisIndex, ZLattice.rank ℝ L_J,
        NumberField.mixedEmbedding.finrank F]
    let e_idx : Module.Free.ChooseBasisIndex ℤ ↥L_J ≃ Fin d :=
      Fintype.equivFinOfCardEq h_rank
    let b : Module.Basis (Fin d) ℤ ↥L_J := (Module.Free.chooseBasis ℤ ↥L_J).reindex e_idx
    let b_R : Module.Basis (Fin d) ℝ (NumberField.mixedEmbedding.mixedSpace F) :=
      Module.Basis.ofZLatticeBasis ℝ L_J b
    let Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin d → ℝ) :=
      b_R.equivFun.toContinuousLinearEquiv
    refine ⟨Φ, fun R hR => ?_⟩
    have hR_ne : R ≠ 0 := hR.ne'
    have hR_inv_pos : 0 < R⁻¹ := inv_pos.mpr hR
    have hR_inv_ne : R⁻¹ ≠ 0 := inv_ne_zero hR_ne
    have hRd_pos : 0 < R ^ d := pow_pos hR d
    have h_mem_L_iff : ∀ x : NumberField.mixedEmbedding.mixedSpace F,
        x ∈ L_J ↔ ∃ a ∈ (J.1 : Set (NumberField.RingOfIntegers F)),
          NumberField.mixedEmbedding F (a : F) = x := by
      intro x
      rw [NumberField.mixedEmbedding.mem_idealLattice]
      constructor
      · rintro ⟨y', hy', rfl⟩
        dsimp only [I_J] at hy'
        rw [SetLike.mem_coe, FractionalIdeal.coe_mk0, FractionalIdeal.mem_coeIdeal] at hy'
        rcases hy' with ⟨a, haJ, rfl⟩
        exact ⟨a, haJ, rfl⟩
      · rintro ⟨a, haJ, rfl⟩
        refine ⟨(a : F), ?_, rfl⟩
        dsimp only [I_J]
        rw [SetLike.mem_coe, FractionalIdeal.coe_mk0, FractionalIdeal.mem_coeIdeal]
        exact ⟨a, haJ, rfl⟩
    have h_idealSet_iff : ∀ x : NumberField.mixedEmbedding.mixedSpace F,
        x ∈ NumberField.mixedEmbedding.fundamentalCone.idealSet F J ↔
          x ∈ NumberField.mixedEmbedding.fundamentalCone F ∧ x ∈ L_J := by
      intro x
      rw [NumberField.mixedEmbedding.fundamentalCone.mem_idealSet, h_mem_L_iff]
    have h_cone_norm_iff : ∀ x : NumberField.mixedEmbedding.mixedSpace F,
        (x ∈ NumberField.mixedEmbedding.fundamentalCone F ∧
          NumberField.mixedEmbedding.norm x ≤ R ^ d) ↔
        R⁻¹ • x ∈ NumberField.mixedEmbedding.fundamentalCone.normLeOne F := by
      intro x
      rw [NumberField.mixedEmbedding.fundamentalCone.mem_normLeOne,
        NumberField.mixedEmbedding.fundamentalCone.smul_mem_iff_mem hR_inv_ne,
        NumberField.mixedEmbedding.norm_smul, abs_of_pos hR_inv_pos, inv_pow,
        inv_mul_le_iff₀ hRd_pos, mul_one]
    have h_Φ_repr : ∀ (x : ↥L_J) (i : Fin d),
        Φ (x : NumberField.mixedEmbedding.mixedSpace F) i = (b.repr x i : ℝ) := by
      intro x i
      change (b_R.repr (x : NumberField.mixedEmbedding.mixedSpace F)) i = (b.repr x i : ℝ)
      exact Module.Basis.ofZLatticeBasis_repr_apply ℝ L_J b x i
    have h_Φ_smul : ∀ (x : ↥L_J),
        Φ (R⁻¹ • (x : NumberField.mixedEmbedding.mixedSpace F)) =
          fun i : Fin d => (b.repr x i : ℝ) / R := by
      intro x
      ext i
      rw [map_smul, Pi.smul_apply, h_Φ_repr x i, smul_eq_mul, inv_mul_eq_div]
    let z_to_L : (Fin d → ℤ) ≃ ↥L_J :=
      (Finsupp.equivFunOnFinite.symm.trans b.repr.symm.toEquiv)
    have hz_repr : ∀ (z : Fin d → ℤ) (i : Fin d), b.repr (z_to_L z) i = z i := by
      intro z i
      change b.repr (b.repr.symm (Finsupp.equivFunOnFinite.symm z)) i = z i
      rw [LinearEquiv.apply_symm_apply]
      rfl
    have hL_repr : ∀ x : ↥L_J, z_to_L (fun i => b.repr x i) = x := by
      intro x
      change b.repr.symm (Finsupp.equivFunOnFinite.symm (Finsupp.equivFunOnFinite (b.repr x))) = x
      rw [Equiv.symm_apply_apply, LinearEquiv.symm_apply_apply]
    let e_coord : { a : NumberField.mixedEmbedding.fundamentalCone.idealSet F J //
        NumberField.mixedEmbedding.norm (a : NumberField.mixedEmbedding.mixedSpace F) ≤ R ^ d } ≃
        { z : Fin d → ℤ //
          (fun i : Fin d => (z i : ℝ) / R) ∈
            Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F } :=
      { toFun := fun ⟨⟨a, ha_set⟩, ha_norm⟩ =>
          let ha := (h_idealSet_iff a).mp ha_set
          let x : ↥L_J := ⟨a, ha.2⟩
          ⟨fun i => b.repr x i, by
            have h_mem : R⁻¹ • a ∈ NumberField.mixedEmbedding.fundamentalCone.normLeOne F :=
              (h_cone_norm_iff a).mp ⟨ha.1, ha_norm⟩
            rw [← h_Φ_smul x]
            exact ⟨R⁻¹ • a, h_mem, rfl⟩⟩
        invFun := fun ⟨z, hz_mem⟩ =>
          let x : ↥L_J := z_to_L z
          have h_smul_eq : Φ (R⁻¹ • (x : NumberField.mixedEmbedding.mixedSpace F)) =
              fun i : Fin d => (z i : ℝ) / R := by
            rw [h_Φ_smul x]
            ext i
            rw [hz_repr z i]
          have h_in_normLeOne : R⁻¹ • (x : NumberField.mixedEmbedding.mixedSpace F) ∈
              NumberField.mixedEmbedding.fundamentalCone.normLeOne F := by
            rcases hz_mem with ⟨w, hw, hw_eq⟩
            rw [← h_smul_eq] at hw_eq
            have hw_x := Φ.injective hw_eq
            rwa [← hw_x]
          have h_cone_norm := (h_cone_norm_iff x.1).mpr h_in_normLeOne
          ⟨⟨x.1, (h_idealSet_iff x.1).mpr ⟨h_cone_norm.1, x.2⟩⟩, h_cone_norm.2⟩
        left_inv := fun ⟨⟨a, ha_set⟩, ha_norm⟩ => by
          apply Subtype.ext
          apply Subtype.ext
          dsimp only
          have ha := (h_idealSet_iff a).mp ha_set
          exact congrArg Subtype.val (hL_repr ⟨a, ha.2⟩)
        right_inv := fun ⟨z, hz_mem⟩ => by
          apply Subtype.ext
          ext i
          exact hz_repr z i }
    exact Nat.card_congr e_coord

  have hd_pos : 0 < d := Module.finrank_pos
  have hd_one_le : (1 : ℝ) ≤ (d : ℝ) := Nat.one_le_cast.mpr hd_pos
  have hd_real_pos : (0 : ℝ) < (d : ℝ) := by linarith
  have hd_real_ne : (d : ℝ) ≠ 0 := hd_real_pos.ne'
  let r : ℝ := 1 - 1 / (d : ℝ)
  let w_F : ℕ := NumberField.Units.torsionOrder F
  have hw_pos : 0 < w_F := NumberField.Units.torsionOrder_pos F
  have hw_real_pos : (0 : ℝ) < (w_F : ℝ) := Nat.cast_pos.mpr hw_pos
  have hw_real_ne : (w_F : ℝ) ≠ 0 := hw_real_pos.ne'

  have h_class : ∀ C : ClassGroup (NumberField.RingOfIntegers F),
      ∃ κ_C : ℝ,
        (fun n : ℕ => (N_C C n : ℝ) - κ_C * (n : ℝ)) =O[Filter.atTop]
        (fun n : ℕ => (n : ℝ) ^ r) := by
    intro C
    obtain ⟨J, hJ⟩ := h_step2 C
    obtain ⟨Φ, hΦ⟩ := h_step3 J
    let Ω : Set (Fin d → ℝ) := Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F
    obtain ⟨hBdd, hMeas, M, L_lip, γ, hL, hLip, hFront⟩ :=
      normLeOne_image_bounded_measurable_and_frontier_lipschitz_cover Φ
    obtain ⟨B, hB⟩ :=
      int_lattice_natCard_sub_volume_mul_pow_le_of_frontier_lipschitz_cover
        d hd_pos Ω hBdd hMeas M L_lip hL γ hLip hFront
    let m_C : ℕ := Ideal.absNorm (J : Ideal (NumberField.RingOfIntegers F))
    have hm_pos : 0 < m_C := Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr J.2
    have hm_one_le : (1 : ℝ) ≤ (m_C : ℝ) := Nat.one_le_cast.mpr hm_pos
    have hm_nonneg : (0 : ℝ) ≤ (m_C : ℝ) := Nat.cast_nonneg m_C
    let κ_C : ℝ := MeasureTheory.volume.real Ω * (m_C : ℝ) / (w_F : ℝ)
    refine ⟨κ_C, Asymptotics.IsBigO.of_bound (|B| * (m_C : ℝ) ^ r / (w_F : ℝ)) ?_⟩
    filter_upwards [Filter.eventually_ge_atTop 1] with n hn
    have hn_one_le : (1 : ℝ) ≤ (n : ℝ) := Nat.one_le_cast.mpr hn
    have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    let s_n : ℝ := (n : ℝ) * (m_C : ℝ)
    have hs_one_le : (1 : ℝ) ≤ s_n := one_le_mul_of_one_le_of_one_le hn_one_le hm_one_le
    have hs_nonneg : 0 ≤ s_n := mul_nonneg hn_nonneg hm_nonneg
    let R_n : ℝ := s_n ^ (1 / (d : ℝ))
    have h_inv_d_nonneg : 0 ≤ 1 / (d : ℝ) := div_nonneg zero_le_one hd_real_pos.le
    have hRn_one_le : 1 ≤ R_n := Real.one_le_rpow hs_one_le h_inv_d_nonneg
    have hRn_pos : 0 < R_n := lt_of_lt_of_le zero_lt_one hRn_one_le
    have hRn_nonneg : 0 ≤ R_n := hRn_pos.le
    have hRn_pow_d : R_n ^ d = s_n := by
      calc
        R_n ^ d = R_n ^ (d : ℝ) := (Real.rpow_natCast R_n d).symm
        _ = s_n ^ ((1 / (d : ℝ)) * (d : ℝ)) := (Real.rpow_mul hs_nonneg (1 / (d : ℝ)) (d : ℝ)).symm
        _ = s_n ^ (1 : ℝ) := by rw [one_div_mul_cancel hd_real_ne]
        _ = s_n := Real.rpow_one s_n
    have hRn_pow_d_sub_one : R_n ^ (d - 1) = (m_C : ℝ) ^ r * (n : ℝ) ^ r := by
      calc
        R_n ^ (d - 1) = R_n ^ ((d - 1 : ℕ) : ℝ) := (Real.rpow_natCast R_n (d - 1)).symm
        _ = s_n ^ ((1 / (d : ℝ)) * ((d - 1 : ℕ) : ℝ)) :=
            (Real.rpow_mul hs_nonneg (1 / (d : ℝ)) ((d - 1 : ℕ) : ℝ)).symm
        _ = s_n ^ r := by
            congr 1
            rw [one_div_mul_eq_div, Nat.cast_sub hd_pos, sub_div, div_self hd_real_ne]
            push_cast
            rfl
        _ = ((n : ℝ) * (m_C : ℝ)) ^ r := rfl
        _ = (n : ℝ) ^ r * (m_C : ℝ) ^ r := Real.mul_rpow hn_nonneg hm_nonneg
        _ = (m_C : ℝ) ^ r * (n : ℝ) ^ r := mul_comm _ _
    have h_card_eq : N_C C n * w_F =
        Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R_n) ∈ Ω } := by
      have h2 := hJ n
      change N_C C n * w_F =
        Nat.card { a : NumberField.mixedEmbedding.fundamentalCone.idealSet F J //
          NumberField.mixedEmbedding.norm (a : NumberField.mixedEmbedding.mixedSpace F) ≤ s_n } at h2
      rw [← hRn_pow_d] at h2
      exact h2.trans (hΦ R_n hRn_pos)
    have h_card_cast : (N_C C n : ℝ) * (w_F : ℝ) =
        (Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R_n) ∈ Ω } : ℝ) := by
      exact_mod_cast h_card_eq
    have h_bound_Rn := hB R_n hRn_one_le
    rw [← h_card_cast, hRn_pow_d, hRn_pow_d_sub_one] at h_bound_Rn
    have h_le_absB : B * ((m_C : ℝ) ^ r * (n : ℝ) ^ r) ≤
        |B| * ((m_C : ℝ) ^ r * (n : ℝ) ^ r) :=
      mul_le_mul_of_nonneg_right (le_abs_self B)
        (mul_nonneg (Real.rpow_nonneg hm_nonneg r) (Real.rpow_nonneg hn_nonneg r))
    have h_bound_abs := h_bound_Rn.trans h_le_absB
    have h_diff_eq : (N_C C n : ℝ) - κ_C * (n : ℝ) =
        ((N_C C n : ℝ) * (w_F : ℝ) - MeasureTheory.volume.real Ω * s_n) / (w_F : ℝ) := by
      dsimp only [κ_C, s_n]
      rw [sub_div, mul_div_cancel_right₀ _ hw_real_ne]
      ring
    rw [Real.norm_eq_abs, Real.norm_of_nonneg (Real.rpow_nonneg hn_nonneg r),
      h_diff_eq, abs_div, abs_of_pos hw_real_pos, div_mul_eq_mul_div, mul_assoc]
    exact div_le_div_of_nonneg_right h_bound_abs hw_real_pos.le

  choose κ_C hκ_C using h_class
  refine ⟨∑ C : ClassGroup (NumberField.RingOfIntegers F), κ_C C, ?_⟩
  have h_sum_eq : (fun n : ℕ =>
        (Nat.card { I : Ideal (NumberField.RingOfIntegers F) //
          I ≠ ⊥ ∧ Ideal.absNorm I ≤ n } : ℝ) -
        (∑ C : ClassGroup (NumberField.RingOfIntegers F), κ_C C) * (n : ℝ)) =
      (fun n : ℕ =>
        ∑ C : ClassGroup (NumberField.RingOfIntegers F),
          ((N_C C n : ℝ) - κ_C C * (n : ℝ))) := by
    ext n
    rw [h_step1 n, Nat.cast_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
  rw [h_sum_eq]
  exact Asymptotics.IsBigO.sum (fun C _ => hκ_C C)

theorem exists_unramified_ideal_artin_surjective {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (θ : Ideal (NumberField.RingOfIntegers F) → (E ≃ₐ[F] E))
    (hθ_top : θ ⊤ = 1)
    (hθ_mul : ∀ I₁ I₂ : Ideal (NumberField.RingOfIntegers F),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂)
    (hθ_frob : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {θ q.asIdeal})
    (ρ : E ≃ₐ[F] E) :
    ∃ K : Ideal (NumberField.RingOfIntegers F),
      K ≠ ⊥ ∧
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        q.asIdeal ∣ K → IsUnramifiedAtPrime F E q) ∧
      θ K = ρ :=
by
  classical
  
  have h_s1 :
      ∃ H : Subgroup (E ≃ₐ[F] E),
        (∀ τ ∈ H,
          ∃ K : Ideal (NumberField.RingOfIntegers F),
            K ≠ ⊥ ∧
            (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
              q.asIdeal ∣ K → IsUnramifiedAtPrime F E q) ∧
            θ K = τ) ∧
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          IsUnramifiedAtPrime F E q → θ q.asIdeal ∈ H) := by
    let P_unr : Ideal (NumberField.RingOfIntegers F) → Prop := fun K =>
      K ≠ ⊥ ∧
      ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        q.asIdeal ∣ K → IsUnramifiedAtPrime F E q
    let M_θ : Set (E ≃ₐ[F] E) := { τ | ∃ K : Ideal (NumberField.RingOfIntegers F), P_unr K ∧ θ K = τ }
    have h_one : (1 : E ≃ₐ[F] E) ∈ M_θ := by
      refine ⟨⊤, ⟨top_ne_bot, fun q hq => ?_⟩, hθ_top⟩
      exfalso
      exact q.isPrime.ne_top (top_unique (Ideal.dvd_iff_le.mp hq))
    have h_mul : ∀ {τ₁ τ₂ : E ≃ₐ[F] E}, τ₁ ∈ M_θ → τ₂ ∈ M_θ → τ₁ * τ₂ ∈ M_θ := by
      rintro τ₁ τ₂ ⟨K₁, ⟨hK₁_ne, hK₁_unr⟩, rfl⟩ ⟨K₂, ⟨hK₂_ne, hK₂_unr⟩, rfl⟩
      have hK₁₂_ne : K₁ * K₂ ≠ ⊥ := by
        rw [← Submodule.zero_eq_bot] at hK₁_ne hK₂_ne ⊢
        exact mul_ne_zero hK₁_ne hK₂_ne
      refine ⟨K₁ * K₂, ⟨hK₁₂_ne, fun q hq => ?_⟩, hθ_mul K₁ K₂ hK₁_ne hK₂_ne⟩
      rcases q.prime.dvd_or_dvd hq with h₁ | h₂
      · exact hK₁_unr q h₁
      · exact hK₂_unr q h₂
