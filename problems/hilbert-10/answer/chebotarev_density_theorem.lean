        have hP'_ne_bot : P' ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot P.ne_bot P'
        obtain ⟨Q, hQ_prime, hQ_over⟩ :=
          Ideal.nonempty_primesOver
            (R := NumberField.RingOfIntegers K')
            (S := NumberField.RingOfIntegers M) P'
        haveI : Q.IsPrime := hQ_prime
        haveI : Q.LiesOver P' := hQ_over
        have hQ_under_K' : Ideal.under (NumberField.RingOfIntegers K') Q = P' :=
          (Ideal.LiesOver.over (P := Q) (p := P')).symm
        have hQ_under_L : Ideal.under (NumberField.RingOfIntegers L) Q = P.asIdeal := by
          rw [← Ideal.under_under (B := NumberField.RingOfIntegers K') Q,
            hQ_under_K', hP'_under_L]
        haveI : Q.LiesOver P.asIdeal := ⟨hQ_under_L.symm⟩
        haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q P.asIdeal
        have h_map_P' :
            Ideal.map (algebraMap (NumberField.RingOfIntegers K') (NumberField.RingOfIntegers M)) P' ≠ ⊥ :=
          (Ideal.map_eq_bot_iff_of_injective
            (FaithfulSMul.algebraMap_injective
              (NumberField.RingOfIntegers K') (NumberField.RingOfIntegers M))).not.mpr hP'_ne_bot
        have h_map_P :
            Ideal.map (algebraMap (NumberField.RingOfIntegers L) (NumberField.RingOfIntegers M))
              P.asIdeal ≠ ⊥ :=
          (Ideal.map_eq_bot_iff_of_injective
            (FaithfulSMul.algebraMap_injective
              (NumberField.RingOfIntegers L) (NumberField.RingOfIntegers M))).not.mpr P.ne_bot
        have h_le_P'Q :
            Ideal.map (algebraMap (NumberField.RingOfIntegers K') (NumberField.RingOfIntegers M)) P' ≤ Q :=
          Ideal.map_le_iff_le_comap.mpr hQ_under_K'.ge
        have h_tower := Ideal.ramificationIdx_algebra_tower
          (R := NumberField.RingOfIntegers L)
          (S := NumberField.RingOfIntegers K')
          (T := NumberField.RingOfIntegers M)
          h_map_P' h_map_P h_le_P'Q
        rw [hP_unram Q hQ_prime hQ_under_L] at h_tower
        have h_ram_one :
            Ideal.ramificationIdx
