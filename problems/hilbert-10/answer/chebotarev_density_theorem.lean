            (y_E (b₁' c₂) (hb₁' c₂)) (y_E (b₂' c₂) (hb₂' c₂))
            (y_E α₁ hα₁) (y_E α₂ hα₂) (σ_E (y_E α₁ hα₁)) (σ_E (y_E α₂ hα₂)) h_units
          rw [map_inv]
          dsimp [x_c, y_α, δ_E]
          rw [map_mul, map_inv]
          exact h_cg
        dsimp [f₂]
        rw [← QuotientGroup.mk_mul, QuotientGroup.eq, Subgroup.mem_subgroupOf]
        change (x_c (c₁ * c₂))⁻¹ * (x_c c₁ * x_c c₂) ∈ Subgroup.map ι K_unit ⊔ B_cop
        rw [h_ratio]
        refine Subgroup.mul_mem _ ?_ ?_
        · exact Subgroup.mem_sup_left ⟨w⁻¹, K_unit.inv_mem hw_ker, rfl⟩
        · exact Subgroup.mem_sup_right (B_cop.inv_mem ⟨y_α, hy_α_mem, rfl⟩)
      refine ⟨MonoidHom.mk' f₂ hf₂_mul, fun c hc => ?_⟩
      rw [MonoidHom.mem_ker, MonoidHom.mk'_apply] at hc
      dsimp [f₂] at hc
      rwa [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hc
    rcases h_ex_ψ₂ with ⟨ψ₂, hψ₂_ker⟩
    haveI : Finite Q_K := hFin_K
    have h_lag₂ : Nat.card ↥H = Nat.card (↥H ⧸ ψ₂.ker) * Nat.card ↥ψ₂.ker :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup ψ₂.ker
    have h_iso₂ : Nat.card (↥H ⧸ ψ₂.ker) = Nat.card ↥ψ₂.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange ψ₂).toEquiv
    have h_le₂ : Nat.card ↥ψ₂.range ≤ Nat.card Q_K :=
      Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
    have h_ker₂_mem : ∀ c : ↥ψ₂.ker, c.1.1 ∈ ext_Cl.range := by
      intro c
      have hc := hψ₂_ker c.1 c.2
      rw [Subgroup.mem_sup] at hc
      rcases hc with ⟨u₀, ⟨w, hw_ker, rfl⟩, z, hz_Bcop, hwz_eq⟩
      obtain ⟨d₁, hd₁_ne, hd₁_cop, hd₁_eq⟩ := hB_cop_rep z hz_Bcop
      have h_xc_val : (x_c c.1 : E) * algebraMap R_E E (b₁' c.1) = algebraMap R_E E (b₂' c.1) := by
        dsimp [x_c]
        push_cast
        exact inv_mul_cancel_right₀ ((FaithfulSMul.algebraMap_injective R_E E).ne (hb₁' c.1)) _
      have hwz_val : (x_c c.1 : E) = algebraMap R_E E (w : R_E) * (z : E) := by
        rw [← hwz_eq]
        rfl
      have h_d₁_E : algebraMap R_E E ((w : R_E) * b₁' c.1 * d₁) =
          algebraMap R_E E (b₂' c.1 * σ_int d₁) := by
        repeat rw [map_mul]
        rw [algebraMap_galRestrict_apply]
        calc
          algebraMap R_E E (w : R_E) * algebraMap R_E E (b₁' c.1) * algebraMap R_E E d₁
              = algebraMap R_E E (w : R_E) * algebraMap R_E E (b₁' c.1) *
                  ((z : E) * σ (algebraMap R_E E d₁)) := by rw [hd₁_eq]
          _ = (algebraMap R_E E (w : R_E) * (z : E)) * algebraMap R_E E (b₁' c.1) *
                σ (algebraMap R_E E d₁) := by ring
          _ = ((x_c c.1 : E) * algebraMap R_E E (b₁' c.1)) * σ (algebraMap R_E E d₁) := by rw [← hwz_val]
          _ = algebraMap R_E E (b₂' c.1) * σ (algebraMap R_E E d₁) := by rw [h_xc_val]
      have h_d₁_RE : (w : R_E) * b₁' c.1 * d₁ = b₂' c.1 * σ_int d₁ :=
        FaithfulSMul.algebraMap_injective R_E E h_d₁_E
      have h_span_d₁ : Ideal.span {b₁' c.1} * Ideal.span {d₁} =
          Ideal.span {b₂' c.1} * Ideal.map σ_int (Ideal.span {d₁}) := by
        rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_mul_span_singleton,
          Ideal.span_singleton_mul_span_singleton, ← h_d₁_RE, mul_assoc,
          Ideal.span_singleton_mul_left_unit w.isUnit]
      let D : Ideal R_E := B' c.1 * Ideal.span {d₁}
      have hd₁_span_ne_zero : Ideal.span ({d₁} : Set R_E) ≠ 0 := by
        rw [Submodule.zero_eq_bot]
        exact Ideal.span_singleton_eq_bot.not.mpr hd₁_ne
      have h_span_d₁_nzd : Ideal.span ({d₁} : Set R_E) ∈ nonZeroDivisors (Ideal R_E) :=
        mem_nonZeroDivisors_of_ne_zero hd₁_span_ne_zero
      have hD_nzd : D ∈ nonZeroDivisors (Ideal R_E) :=
        Submonoid.mul_mem _ (hB' c.1) h_span_d₁_nzd
      have hD_ne_bot : D ≠ ⊥ := by
        rw [← Submodule.zero_eq_bot]
        exact nonZeroDivisors.ne_zero hD_nzd
      have hD_cop : IsCoprime (Ideal.relNorm R_F D) m₀ := by
        dsimp [D]
        rw [map_mul, Ideal.relNorm_singleton]
        exact IsCoprime.mul_left (hB'_cop c.1) hd₁_cop
      have hD_inv_mul : Ideal.map σ_int D * Ideal.span {b₁' c.1} = D * Ideal.span {b₁' c.1} := by
        dsimp [D]
        calc
          Ideal.map σ_int (B' c.1 * Ideal.span {d₁}) * Ideal.span {b₁' c.1}
              = (Ideal.map σ_int (B' c.1) * Ideal.span {b₁' c.1}) *
                  Ideal.map σ_int (Ideal.span {d₁}) := by
                rw [Ideal.map_mul, mul_right_comm]
          _ = B' c.1 * (Ideal.span {b₂' c.1} * Ideal.map σ_int (Ideal.span {d₁})) := by
                rw [h_eq' c.1, mul_assoc]
          _ = B' c.1 * (Ideal.span {b₁' c.1} * Ideal.span {d₁}) := by rw [← h_span_d₁]
          _ = (B' c.1 * Ideal.span {d₁}) * Ideal.span {b₁' c.1} := by
                rw [← mul_assoc, mul_right_comm]
      have hb₁'_span_ne_zero : Ideal.span ({b₁' c.1} : Set R_E) ≠ 0 := by
        rw [Submodule.zero_eq_bot]
        exact Ideal.span_singleton_eq_bot.not.mpr (hb₁' c.1)
      have hD_inv : Ideal.map σ_int D = D :=
        mul_right_cancel₀ hb₁'_span_ne_zero hD_inv_mul
      obtain ⟨A, hA_ne_bot, _, hDA⟩ := h_descent D hD_ne_bot hD_cop hD_inv
      have hA_nzd : A ∈ nonZeroDivisors (Ideal R_F) :=
        mem_nonZeroDivisors_of_ne_zero (by rwa [Submodule.zero_eq_bot])
      have hAE_nzd : Ideal.map (algebraMap R_F R_E) A ∈ nonZeroDivisors (Ideal R_E) := by
        rw [← hDA]
        exact hD_nzd
      have h_mk0_d₁ : ClassGroup.mk0 ⟨Ideal.span {d₁}, h_span_d₁_nzd⟩ = 1 :=
        (ClassGroup.mk0_eq_one_iff h_span_d₁_nzd).mpr ⟨⟨d₁, rfl⟩⟩
      have h_mk0_D : ClassGroup.mk0 ⟨D, hD_nzd⟩ = c.1.1 := by
        have h_mul : ClassGroup.mk0 ⟨D, hD_nzd⟩ =
            ClassGroup.mk0 ⟨B' c.1, hB' c.1⟩ * ClassGroup.mk0 ⟨Ideal.span {d₁}, h_span_d₁_nzd⟩ := by
          rw [← map_mul]
          rfl
        rw [h_mul, h_mk0_d₁, mul_one, hB'_mk0 c.1]
      refine ⟨ClassGroup.mk0 ⟨A, hA_nzd⟩, ?_⟩
      rw [hext_Cl A hA_nzd hAE_nzd, ← h_mk0_D]
      congr 1
      apply Subtype.ext
      exact hDA.symm
    let ι_ker : ↥ψ₂.ker → ↥ext_Cl.range := fun c => ⟨c.1.1, h_ker₂_mem c⟩
    have hι_ker_inj : Function.Injective ι_ker := by
      intro c₁ c₂ h
      have h1 := congrArg Subtype.val h
      exact Subtype.ext (Subtype.ext h1)
    have h_le_ker₂ : Nat.card ↥ψ₂.ker ≤ Nat.card ↥ext_Cl.range :=
      Nat.card_le_card_of_injective ι_ker hι_ker_inj
    rw [h_lag₂, h_iso₂, mul_comm]
    exact Nat.mul_le_mul h_le_ker₂ h_le₂
  exact h_card_G_amb.trans (Nat.mul_le_mul_right _ h_stage2)

theorem norm_ray_cells_card_mul_unit_ker_le_classGroup_mul_pnorm_of_nonzero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_dvd : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₀ ↔ ¬ IsUnramifiedAtPrime F E q)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ j : Fin N_ray,
        ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j = Ideal.span {a})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₁ = Ideal.span {a}) →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₂ = Ideal.span {a}) →
      j₁ = j₂) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
      ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
    let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
    let B_cop : Subgroup Eˣ :=
      Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
    let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
      ∃ b₁ b₂ : R_E,
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
    let S_pnorm := { j : Fin N_ray //
      ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all j * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
          Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} }
    let S_norm := { j : Fin N_ray //
      ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all j * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
          Ideal.span {a₂} * Ideal.relNorm R_F B₂ }
    Nat.card ((Units.map (Algebra.intNorm R_F R_E)).ker ⧸
      ((MonoidHom.id R_Eˣ /
        Units.map (galRestrict R_F F E R_E σ).toMonoidHom).range.subgroupOf
        (Units.map (Algebra.intNorm R_F R_E)).ker)) *
      Nat.card S_norm ≤
    Nat.card (ClassGroup R_F) *
      Nat.card (K_cop ⧸ B_cop.subgroupOf K_cop) *
      Nat.card (H_unr ⧸ (Units.map (Algebra.intNorm R_F R_E)).range.subgroupOf H_unr) *
      Nat.card S_pnorm :=
by
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
  let ι : R_Eˣ →* Eˣ := Units.map (algebraMap R_E E : R_E →* E)
  let φ_N : R_Eˣ →* R_Fˣ := Units.map (Algebra.intNorm R_F R_E)
  let K_unit : Subgroup R_Eˣ := φ_N.ker
  let B_unit : Subgroup R_Eˣ :=
    (MonoidHom.id R_Eˣ / Units.map σ_int.toMonoidHom).range
  let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
    ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
  let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
  let B_cop : Subgroup Eˣ :=
    Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
  let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
    ∃ b₁ b₂ : R_E,
      b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
      (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
  let H_unr_old : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
    ∃ b₁ b₂ : R_E,
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
      (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
  let S_pnorm := { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
        Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} }
  let S_norm := { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
        Ideal.span {a₂} * Ideal.relNorm R_F B₂ }
  obtain ⟨σ_Cl, hσ_Cl, h_cop_rep, h_rep_eq, h_s1⟩ :=
    norm_ray_cells_card_le_classGroup_quotient_mul_pnorm σ m₀ hm₀_ne N_ray J_all hJ_prop hJ_cov hJ_inj
  obtain ⟨ext_Cl, hext_Cl, hB_cop_rep, h_descent, _⟩ :=
    unramified_galRestrict_invariant_ideal_and_coboundary_descent σ hCyclic m₀ hm₀_ne hm₀_dvd
  obtain ⟨h_s3, hFin_U_old, hFin_K⟩ :=
    unit_ker_inter_coboundary_card_le_and_finite_quotients σ hCyclic m₀ hm₀_ne
      ext_Cl hext_Cl hB_cop_rep h_descent h_rep_eq
  have h_le_Hunr : φ_N.range ≤ H_unr := by
    rintro u ⟨v, rfl⟩
    apply Subgroup.subset_closure
    refine ⟨1, (v : R_E), one_ne_zero, Units.ne_zero v, ?_, ?_, ?_⟩
    · rw [map_one, Ideal.span_singleton_one]
      exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
    · have h_unit : IsUnit (Algebra.intNorm R_F R_E (v : R_E)) := (φ_N v).isUnit
      rw [Ideal.span_singleton_eq_top.mpr h_unit]
      exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
    · rw [map_one, mul_one]
      rfl
  have hH_le : H_unr ≤ H_unr_old := by
    refine Subgroup.closure_mono ?_
    rintro u ⟨b₁, b₂, _, _, hc₁, hc₂, heq⟩
    exact ⟨b₁, b₂, hc₁, hc₂, heq⟩
  have hFin_U : Finite (H_unr ⧸ φ_N.range.subgroupOf H_unr) := by
    haveI : Finite (H_unr_old ⧸ φ_N.range.subgroupOf H_unr_old) := hFin_U_old
    have h_pos : 0 < Nat.card (H_unr_old ⧸ φ_N.range.subgroupOf H_unr_old) := Nat.card_pos
    have h_rel := Subgroup.relIndex_mul_relIndex φ_N.range H_unr H_unr_old h_le_Hunr hH_le
    dsimp only [Subgroup.relIndex] at h_rel
    rw [Subgroup.index_eq_card, Subgroup.index_eq_card] at h_rel
    have h_ne : Nat.card (H_unr ⧸ φ_N.range.subgroupOf H_unr) ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at h_rel
      exact h_pos.ne h_rel
    exact Nat.finite_of_card_ne_zero h_ne
  have h_s4 :=
    ambiguous_classGroup_card_le_ext_range_mul_coprime_ker_mul_unit_sub_of_nonzero σ m₀
      σ_Cl hσ_Cl h_cop_rep h_rep_eq ext_Cl hext_Cl hB_cop_rep h_descent hFin_U hFin_K
  let δ_Cl : ClassGroup R_E →* ClassGroup R_E := MonoidHom.id (ClassGroup R_E) / σ_Cl
  have h_lag_E : Nat.card (ClassGroup R_E) =
      Nat.card (ClassGroup R_E ⧸ δ_Cl.range) * Nat.card ↥δ_Cl.range :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup δ_Cl.range
  have h_ker_E : Nat.card (ClassGroup R_E) =
      Nat.card (ClassGroup R_E ⧸ δ_Cl.ker) * Nat.card ↥δ_Cl.ker :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup δ_Cl.ker
  have h_iso_E : Nat.card (ClassGroup R_E ⧸ δ_Cl.ker) = Nat.card ↥δ_Cl.range :=
    Nat.card_congr (QuotientGroup.quotientKerEquivRange δ_Cl).toEquiv
  have h_range_pos : 0 < Nat.card ↥δ_Cl.range := Nat.card_pos
  have h_Cl_E : Nat.card (ClassGroup R_E ⧸ δ_Cl.range) = Nat.card ↥δ_Cl.ker := by
    have h_eq : Nat.card (ClassGroup R_E ⧸ δ_Cl.range) * Nat.card ↥δ_Cl.range =
        Nat.card ↥δ_Cl.ker * Nat.card ↥δ_Cl.range := by
      rw [← h_lag_E, h_ker_E, h_iso_E, mul_comm]
    exact Nat.eq_of_mul_eq_mul_right h_range_pos h_eq
  have h_Cl_F : Nat.card (ClassGroup R_F) =
      Nat.card ↥ext_Cl.range * Nat.card ↥ext_Cl.ker := by
    have h_ker_F : Nat.card (ClassGroup R_F) =
        Nat.card (ClassGroup R_F ⧸ ext_Cl.ker) * Nat.card ↥ext_Cl.ker :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup ext_Cl.ker
    have h_iso_F : Nat.card (ClassGroup R_F ⧸ ext_Cl.ker) = Nat.card ↥ext_Cl.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange ext_Cl).toEquiv
    rwa [h_iso_F] at h_ker_F
  have h_intNorm_σ : ∀ b : R_E, Algebra.intNorm R_F R_E (σ_int b) = Algebra.intNorm R_F R_E b := by
    intro b
    apply FaithfulSMul.algebraMap_injective R_F F
    rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
      algebraMap_galRestrict_apply, Algebra.norm_eq_of_algEquiv]
  have h_unit_in_Ecop : ∀ u : R_Eˣ, ι u ∈ E_cop := by
    intro u
    apply Subgroup.subset_closure
    refine ⟨(u : R_E), rfl, ?_⟩
    have h_isUnit : IsUnit (Algebra.intNorm R_F R_E (u : R_E)) := (φ_N u).isUnit
    rw [Ideal.span_singleton_eq_top.mpr h_isUnit]
    exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
  have h_Bunit_le : B_unit ≤ K_unit ⊓ Subgroup.comap ι B_cop := by
    rintro _ ⟨u, rfl⟩
    rw [Subgroup.mem_inf]
    refine ⟨?_, ?_⟩
    · change φ_N ((MonoidHom.id R_Eˣ / Units.map σ_int.toMonoidHom) u) = 1
      rw [MonoidHom.div_apply, MonoidHom.id_apply, map_div, div_eq_one]
      apply Units.ext
      exact (h_intNorm_σ (u : R_E)).symm
    · rw [Subgroup.mem_comap]
      refine ⟨ι u, h_unit_in_Ecop u, ?_⟩
      rw [MonoidHom.div_apply, MonoidHom.div_apply, MonoidHom.id_apply, MonoidHom.id_apply, map_div]
      congr 1
      ext
      exact (algebraMap_galRestrict_apply R_F σ (u : R_E)).symm
  have h_Ecop_σ : E_cop ≤ Subgroup.comap (Units.map (σ : E ≃* E).toMonoidHom) E_cop := by
    rw [Subgroup.closure_le]
    rintro x ⟨b, hb_eq, hb_cop⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap]
    apply Subgroup.subset_closure
    refine ⟨σ_int b, ?_, ?_⟩
    · change σ (x : E) = algebraMap R_E E (σ_int b)
      rw [hb_eq, algebraMap_galRestrict_apply]
    · rwa [h_intNorm_σ b]
  have h_Bcop_le : B_cop ≤ K_cop := by
    rintro _ ⟨x, hx, rfl⟩
    rw [Subgroup.mem_inf]
    refine ⟨?_, ?_⟩
    · exact E_cop.mul_mem hx (E_cop.inv_mem (h_Ecop_σ hx))
    · change Units.map (Algebra.norm F) ((MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) x) = 1
      rw [MonoidHom.div_apply, MonoidHom.id_apply, map_div, div_eq_one]
      ext
      exact (Algebra.norm_eq_of_algEquiv σ (x : E)).symm
  have h_map_Kunit_le : Subgroup.map ι K_unit ≤ K_cop := by
    rintro _ ⟨u, hu, rfl⟩
    rw [Subgroup.mem_inf]
    refine ⟨h_unit_in_Ecop u, ?_⟩
    change φ_N u = 1 at hu
    change Units.map (Algebra.norm F) (ι u) = 1
    ext
    change Algebra.norm F (algebraMap R_E E (u : R_E)) = 1
    rw [← Algebra.algebraMap_intNorm (A := R_F),
      show Algebra.intNorm R_F R_E (u : R_E) = ((φ_N u : R_Fˣ) : R_F) from rfl,
      hu, Units.val_one, map_one]
  let I_common : ℕ := (Subgroup.comap ι B_cop).relIndex K_unit
  let Q_ker : ℕ := Nat.card (K_unit ⧸ B_unit.subgroupOf K_unit)
  let Q_amb : ℕ := Nat.card (↥(K_unit ⊓ Subgroup.comap ι B_cop) ⧸
    B_unit.subgroupOf (K_unit ⊓ Subgroup.comap ι B_cop))
  let K_quot : ℕ := Nat.card (K_cop ⧸ B_cop.subgroupOf K_cop)
  let K_rem : ℕ := Nat.card (K_cop ⧸ (Subgroup.map ι K_unit ⊔ B_cop).subgroupOf K_cop)
  have h_Qker_eq : Q_amb * I_common = Q_ker := by
    have h1 := Subgroup.relIndex_mul_relIndex B_unit (K_unit ⊓ Subgroup.comap ι B_cop) K_unit
      h_Bunit_le inf_le_left
    rw [Subgroup.inf_relIndex_left] at h1
    simpa only [Q_amb, I_common, Q_ker, Subgroup.relIndex, Subgroup.index_eq_card] using h1
  have h_Kquot_eq : I_common * K_rem = K_quot := by
    have h_sup_le : Subgroup.map ι K_unit ⊔ B_cop ≤ K_cop :=
      sup_le h_map_Kunit_le h_Bcop_le
    have h1 := Subgroup.relIndex_mul_relIndex B_cop (Subgroup.map ι K_unit ⊔ B_cop) K_cop
      le_sup_right h_sup_le
    rw [Subgroup.relIndex_sup_right, ← Subgroup.relIndex_comap] at h1
    simpa only [I_common, K_rem, K_quot, Subgroup.relIndex, Subgroup.index_eq_card] using h1
  let U_sub : ℕ := Nat.card (H_unr ⧸ φ_N.range.subgroupOf H_unr)
  rw [h_Cl_E] at h_s1
  change Q_ker * Nat.card S_norm ≤
    Nat.card (ClassGroup R_F) * K_quot * U_sub * Nat.card S_pnorm
  calc
    Q_ker * Nat.card S_norm
        = (Q_amb * I_common) * Nat.card S_norm := by rw [← h_Qker_eq]
    _ ≤ (Q_amb * I_common) * (Nat.card ↥δ_Cl.ker * Nat.card S_pnorm) :=
        Nat.mul_le_mul_left _ h_s1
    _ = I_common * (Q_amb * Nat.card ↥δ_Cl.ker) * Nat.card S_pnorm := by ring
    _ ≤ I_common * (Nat.card ↥ext_Cl.ker *
          (Nat.card ↥ext_Cl.range * K_rem * U_sub)) * Nat.card S_pnorm := by
        gcongr
    _ = (Nat.card ↥ext_Cl.range * Nat.card ↥ext_Cl.ker) *
          (I_common * K_rem) * U_sub * Nat.card S_pnorm := by ring
    _ = Nat.card (ClassGroup R_F) * K_quot * U_sub * Nat.card S_pnorm := by
        rw [← h_Cl_F, h_Kquot_eq]

theorem exists_ramified_exponents_and_tower_ideals {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] :
    let R_F := NumberField.RingOfIntegers F
    ∃ c₀ : IsDedekindDomain.HeightOneSpectrum R_F → ℕ,
      (∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        ¬ IsUnramifiedAtPrime F E q → 1 ≤ c₀ q) ∧
      ∀ (m₀ : Ideal R_F),
        m₀ ≠ ⊥ →
        (∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
          q.asIdeal ∣ m₀ ↔ ¬ IsUnramifiedAtPrime F E q) →
        (∀ a : R_F,
          (∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
            ¬ IsUnramifiedAtPrime F E q → a - 1 ∈ q.asIdeal ^ (c₀ q)) ↔
          a - 1 ∈ m₀) →
        ∃ (D_ram J_d m₂ m₁ : Ideal R_F) (t₀ : R_F),
          D_ram ≠ ⊥ ∧ J_d ≠ ⊥ ∧ m₂ ≠ ⊥ ∧ m₁ ≠ ⊥ ∧
          Ideal.span {(Module.finrank F E : R_F)} = D_ram * J_d ∧
          IsCoprime J_d m₀ ∧
          m₁ = D_ram * m₂ ∧
          m₀ = D_ram * m₁ ∧
          m₂ ^ 2 ≤ m₁ ∧
          m₁ ^ 2 ≤ m₀ ∧
          (∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
            (q.asIdeal ∣ m₂ ↔ q.asIdeal ∣ m₀) ∧
            (q.asIdeal ∣ m₁ ↔ q.asIdeal ∣ m₀) ∧
            (q.asIdeal ∣ D_ram → q.asIdeal ∣ m₀)) ∧
          t₀ ∈ J_d ∧
          t₀ - 1 ∈ m₀ :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  let d : ℕ := Module.finrank F E
  have hd_pos : 0 < d := Module.finrank_pos
  have hd_ne : (d : R_F) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
  let I_d : Ideal R_F := Ideal.span {(d : R_F)}
  have hId_ne : I_d ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hd_ne
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal : ι → Ideal R_F) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  let N : Multiset (Ideal R_F) := UniqueFactorizationMonoid.normalizedFactors I_d
  let m : Multiset ι :=
    Multiset.pmap
      (fun (p : Ideal R_F) (hp : Prime p) =>
        IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
      N
      (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
  let f_d : ι →₀ ℕ := Multiset.toFinsupp m
  have hf_d : (∏ q ∈ f_d.support, q.asIdeal ^ (f_d q)) = I_d := by
    change f_d.prod (fun q k => q.asIdeal ^ k) = I_d
    have h_toMultiset :
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f_d)).prod =
          f_d.prod (fun q k => q.asIdeal ^ k) := by
      rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
        Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
    rw [← h_toMultiset]
    have hfm : Finsupp.toMultiset f_d = m := Multiset.toFinsupp_toMultiset m
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m = N := by
      dsimp [m]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact prod_normalizedFactors_eq_self hId_ne
  let c₀ : ι → ℕ := fun q => 1 + 3 * f_d q
  refine ⟨c₀, fun q _ => Nat.le_add_right 1 (3 * f_d q), fun m₀ hm₀_ne hm₀_dvd hm₀_mem => ?_⟩
  have hm₀_ne_zero : m₀ ≠ 0 := by rwa [Submodule.zero_eq_bot]
  have hS_fin : { q : ι | q.asIdeal ∣ m₀ }.Finite := Ideal.finite_factors hm₀_ne_zero
  let S_ram : Finset ι := hS_fin.toFinset
  have h_mem_S_ram : ∀ q : ι, q ∈ S_ram ↔ q.asIdeal ∣ m₀ :=
    fun q => Set.Finite.mem_toFinset hS_fin
  let D_ram : Ideal R_F := ∏ q ∈ S_ram, q.asIdeal ^ (f_d q)
  let J_d : Ideal R_F := ∏ q ∈ f_d.support \ S_ram, q.asIdeal ^ (f_d q)
  let m₂ : Ideal R_F := ∏ q ∈ S_ram, q.asIdeal ^ (1 + f_d q)
  let m₁ : Ideal R_F := ∏ q ∈ S_ram, q.asIdeal ^ (1 + 2 * f_d q)
  have h_prod_ne_bot : ∀ (s : Finset ι) (g : ι → ℕ), (∏ q ∈ s, q.asIdeal ^ (g q)) ≠ ⊥ := by
    intro s g
    rw [← Submodule.zero_eq_bot]
    apply Finset.prod_ne_zero_iff.mpr
    intro q _
    apply pow_ne_zero
    rw [Submodule.zero_eq_bot]
    exact q.ne_bot
  have hD_ne : D_ram ≠ ⊥ := h_prod_ne_bot S_ram f_d
  have hJd_ne : J_d ≠ ⊥ := h_prod_ne_bot (f_d.support \ S_ram) f_d
  have hm₂_ne : m₂ ≠ ⊥ := h_prod_ne_bot S_ram (fun q => 1 + f_d q)
  have hm₁_ne : m₁ ≠ ⊥ := h_prod_ne_bot S_ram (fun q => 1 + 2 * f_d q)
  have h_span_d : I_d = D_ram * J_d := by
    have hD_inter : (∏ q ∈ f_d.support ∩ S_ram, q.asIdeal ^ (f_d q)) = D_ram := by
      dsimp [D_ram]
      refine Finset.prod_subset Finset.inter_subset_right (fun q hq_S hq_not_inter => ?_)
      have hq_not_supp : q ∉ f_d.support :=
        fun hq_supp => hq_not_inter (Finset.mem_inter.mpr ⟨hq_supp, hq_S⟩)
      have hfq_zero : f_d q = 0 := Finsupp.notMem_support_iff.mp hq_not_supp
      rw [hfq_zero, pow_zero]
    dsimp [J_d]
    rw [← hD_inter, Finset.prod_inter_mul_prod_diff, hf_d]
  have h_cop_Jd : IsCoprime J_d m₀ := by
    dsimp [J_d]
    refine IsCoprime.prod_left fun q hq => ?_
    apply IsCoprime.pow_left
    have hq_not_S : q ∉ S_ram := (Finset.mem_sdiff.mp hq).2
    have hq_not_dvd : ¬ (q.asIdeal ∣ m₀) :=
      fun hdvd => hq_not_S ((h_mem_S_ram q).mpr hdvd)
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    have h_eq : q.asIdeal = q.asIdeal ⊔ m₀ :=
      q.isMaximal.eq_of_le h_ne_top le_sup_left
    have hm₀_le : m₀ ≤ q.asIdeal := le_sup_right.trans h_eq.symm.le
    exact hq_not_dvd (Ideal.dvd_iff_le.mpr hm₀_le)
  have hm₁_eq : m₁ = D_ram * m₂ := by
    dsimp [m₁, D_ram, m₂]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun q _ => ?_
    rw [← pow_add]
    congr 1
    omega
  have hm₀_prod : m₀ = ∏ q ∈ S_ram, q.asIdeal ^ (c₀ q) := by
    have h_prod_mem : ∀ (s : Finset ι) (x : R_F),
        (∀ q ∈ s, x ∈ q.asIdeal ^ (c₀ q)) →
        x ∈ ∏ q ∈ s, q.asIdeal ^ (c₀ q) := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · intro x _
        rw [Finset.prod_empty, Ideal.one_eq_top]
        exact Submodule.mem_top
      · intro q₀ s hq₀_not_in ih x hx
        rw [Finset.prod_insert hq₀_not_in]
        have hx_q₀ : x ∈ q₀.asIdeal ^ (c₀ q₀) := hx q₀ (Finset.mem_insert_self q₀ s)
        have hx_s : x ∈ ∏ q ∈ s, q.asIdeal ^ (c₀ q) :=
          ih x (fun q hq => hx q (Finset.mem_insert_of_mem hq))
        have h_cop : IsCoprime (q₀.asIdeal ^ (c₀ q₀)) (∏ q ∈ s, q.asIdeal ^ (c₀ q)) := by
          refine IsCoprime.prod_right fun q hq => ?_
          have h_ne : q₀ ≠ q := fun h_eq => hq₀_not_in (h_eq ▸ hq)
          have h_ne_ideal : q₀.asIdeal ≠ q.asIdeal :=
            fun h_eq => h_ne (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
          have h_cop_base : IsCoprime q₀.asIdeal q.asIdeal :=
            Ideal.isCoprime_iff_sup_eq.mpr
              (Ideal.IsMaximal.coprime_of_ne q₀.isMaximal q.isMaximal h_ne_ideal)
          exact h_cop_base.pow
        rw [← Ideal.inf_eq_mul_of_isCoprime h_cop]
        exact ⟨hx_q₀, hx_s⟩
    ext x
    have hx_sub : (x + 1) - 1 = x := add_sub_cancel_right x 1
    constructor
    · intro hx_m₀
      have hx_ram : ∀ q : ι, ¬ IsUnramifiedAtPrime F E q → x ∈ q.asIdeal ^ (c₀ q) := by
        intro q hq_ram
        have h1 := (hm₀_mem (x + 1)).mpr (by rwa [hx_sub]) q hq_ram
        rwa [hx_sub] at h1
      exact h_prod_mem S_ram x (fun q hq => hx_ram q ((hm₀_dvd q).mp ((h_mem_S_ram q).mp hq)))
    · intro hx_prod
      have h1 : (x + 1) - 1 ∈ m₀ := by
        refine (hm₀_mem (x + 1)).mp (fun q hq_ram => ?_)
        rw [hx_sub]
        have hq_mem : q ∈ S_ram := (h_mem_S_ram q).mpr ((hm₀_dvd q).mpr hq_ram)
        have hdvd : q.asIdeal ^ (c₀ q) ∣ ∏ q' ∈ S_ram, q'.asIdeal ^ (c₀ q') :=
          Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ (c₀ q')) hq_mem
        exact (Ideal.dvd_iff_le.mp hdvd) hx_prod
      rwa [hx_sub] at h1
  have hm₀_eq : m₀ = D_ram * m₁ := by
    rw [hm₀_prod]
    dsimp [D_ram, m₁, c₀]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun q _ => ?_
    rw [← pow_add]
    congr 1
    omega
  have hm₂_sq : m₂ ^ 2 ≤ m₁ := by
    rw [← Ideal.dvd_iff_le]
    dsimp [m₁, m₂]
    rw [← Finset.prod_pow]
    refine Finset.prod_dvd_prod_of_dvd _ _ fun q _ => ?_
    rw [← pow_mul, Ideal.dvd_iff_le]
    exact Ideal.pow_le_pow_right (by omega)
  have hm₁_sq : m₁ ^ 2 ≤ m₀ := by
    rw [hm₀_prod, ← Ideal.dvd_iff_le]
    dsimp [m₁, c₀]
    rw [← Finset.prod_pow]
    refine Finset.prod_dvd_prod_of_dvd _ _ fun q _ => ?_
    rw [← pow_mul, Ideal.dvd_iff_le]
    exact Ideal.pow_le_pow_right (by omega)
  have h_dvd_to_m₀ : ∀ (g : ι → ℕ) (q : ι),
      q.asIdeal ∣ (∏ q' ∈ S_ram, q'.asIdeal ^ (g q')) → q.asIdeal ∣ m₀ := by
    intro g q hdvd
    rw [Prime.dvd_finset_prod_iff q.prime] at hdvd
    rcases hdvd with ⟨q', hq'_mem, hdvd_pow⟩
    have hdvd_q' : q.asIdeal ∣ q'.asIdeal := q.prime.dvd_of_dvd_pow hdvd_pow
    have hle : q'.asIdeal ≤ q.asIdeal := Ideal.dvd_iff_le.mp hdvd_q'
    have heq_ideal : q'.asIdeal = q.asIdeal :=
      q'.isMaximal.eq_of_le q.isMaximal.ne_top hle
    have heq : q' = q := IsDedekindDomain.HeightOneSpectrum.ext heq_ideal
    rw [← heq]
    exact (h_mem_S_ram q').mp hq'_mem
  have h_m₀_to_dvd : ∀ (g : ι → ℕ) (q : ι),
      g q ≠ 0 → q.asIdeal ∣ m₀ → q.asIdeal ∣ (∏ q' ∈ S_ram, q'.asIdeal ^ (g q')) := by
    intro g q hg_ne hdvd
    have hq_mem : q ∈ S_ram := (h_mem_S_ram q).mpr hdvd
    exact dvd_trans (dvd_pow_self q.asIdeal hg_ne)
      (Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ (g q')) hq_mem)
  have h_dvd : ∀ q : ι,
      (q.asIdeal ∣ m₂ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ m₁ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ D_ram → q.asIdeal ∣ m₀) := by
    intro q
    refine ⟨⟨h_dvd_to_m₀ (fun q' => 1 + f_d q') q,
      h_m₀_to_dvd (fun q' => 1 + f_d q') q (by dsimp; omega)⟩,
      ⟨h_dvd_to_m₀ (fun q' => 1 + 2 * f_d q') q,
      h_m₀_to_dvd (fun q' => 1 + 2 * f_d q') q (by dsimp; omega)⟩,
      h_dvd_to_m₀ f_d q⟩
  obtain ⟨t₀, ht₀_Jd, y₀, hy₀_m₀, h_sum⟩ := Ideal.isCoprime_iff_exists.mp h_cop_Jd
  have ht₀_sub : t₀ - 1 ∈ m₀ := by
    have h_eq : t₀ - 1 = -y₀ := by
      rw [← h_sum]
      ring
    rw [h_eq]
    exact m₀.neg_mem hy₀_m₀
  exact ⟨D_ram, J_d, m₂, m₁, t₀, hD_ne, hJd_ne, hm₂_ne, hm₁_ne,
    h_span_d, h_cop_Jd, hm₁_eq, hm₀_eq, hm₂_sq, hm₁_sq, h_dvd, ht₀_Jd, ht₀_sub⟩

theorem coprime_norm_closure_characterizations_and_mod_coboundary_mem {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_le : m₀ ≤ m₁) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
      ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
    let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
    let B_cop : Subgroup Eˣ :=
      Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
    let B_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b c : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk I₁ (b * σ_int c) = Ideal.Quotient.mk I₁ c }
    (∀ x ∈ K_cop,
      ∃ a₁ a₂ : R_E,
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E a₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E a₂}) m₀ ∧
        Algebra.intNorm R_F R_E a₁ = Algebra.intNorm R_F R_E a₂ ∧
        (x : E) * algebraMap R_E E a₂ = algebraMap R_E E a₁) ∧
    (∀ z : Eˣ,
      (∃ c : R_E,
        c ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
        (z : E) * σ (algebraMap R_E E c) = algebraMap R_E E c) →
      z ∈ B_cop) ∧
    (∀ u ∈ B_mod,
      ∃ b c : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk I₁ (b * σ_int c) = Ideal.Quotient.mk I₁ c) :=
by
  intro R_F R_E σ_int I₁ I₀ E_cop K_cop B_cop B_mod
  classical
  have hinj_F : Function.Injective (algebraMap R_F F) :=
    FaithfulSMul.algebraMap_injective R_F F
  have hinj_E : Function.Injective (algebraMap R_E E) :=
    FaithfulSMul.algebraMap_injective R_E E
  have hI₀_le : I₀ ≤ I₁ := Ideal.map_mono hm₀_le
  refine ⟨?_, ?_, ?_⟩
  · let H_frac : Subgroup Eˣ :=
      { carrier := { x : Eˣ |
          ∃ a₁ a₂ : R_E,
            a₁ ≠ 0 ∧ a₂ ≠ 0 ∧
            IsCoprime (Ideal.span {Algebra.intNorm R_F R_E a₁}) m₀ ∧
            IsCoprime (Ideal.span {Algebra.intNorm R_F R_E a₂}) m₀ ∧
            (x : E) * algebraMap R_E E a₂ = algebraMap R_E E a₁ }
        one_mem' := by
          refine ⟨1, 1, one_ne_zero, one_ne_zero, ?_, ?_, ?_⟩
          · rw [map_one, Ideal.span_singleton_one]
            exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
          · rw [map_one, Ideal.span_singleton_one]
            exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
          · rw [Units.val_one, one_mul]
        mul_mem' := by
          rintro x y ⟨a₁, a₂, ha₁_ne, ha₂_ne, ha₁_cop, ha₂_cop, hx_eq⟩
            ⟨b₁, b₂, hb₁_ne, hb₂_ne, hb₁_cop, hb₂_cop, hy_eq⟩
          refine ⟨a₁ * b₁, a₂ * b₂, mul_ne_zero ha₁_ne hb₁_ne, mul_ne_zero ha₂_ne hb₂_ne,
            ?_, ?_, ?_⟩
          · rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
            exact IsCoprime.mul_left ha₁_cop hb₁_cop
          · rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
            exact IsCoprime.mul_left ha₂_cop hb₂_cop
          · rw [Units.val_mul, map_mul, map_mul]
            calc
              ((x : E) * (y : E)) * (algebraMap R_E E a₂ * algebraMap R_E E b₂)
                  = ((x : E) * algebraMap R_E E a₂) * ((y : E) * algebraMap R_E E b₂) := by ring
              _ = algebraMap R_E E a₁ * algebraMap R_E E b₁ := by rw [hx_eq, hy_eq]
        inv_mem' := by
          rintro x ⟨a₁, a₂, ha₁_ne, ha₂_ne, ha₁_cop, ha₂_cop, hx_eq⟩
          refine ⟨a₂, a₁, ha₂_ne, ha₁_ne, ha₂_cop, ha₁_cop, ?_⟩
          calc
            ((x⁻¹ : Eˣ) : E) * algebraMap R_E E a₁
                = ((x⁻¹ : Eˣ) : E) * ((x : E) * algebraMap R_E E a₂) := by rw [← hx_eq]
            _ = (((x⁻¹ : Eˣ) : E) * (x : E)) * algebraMap R_E E a₂ := by ring
            _ = 1 * algebraMap R_E E a₂ := by rw [Units.inv_mul]
            _ = algebraMap R_E E a₂ := by rw [one_mul] }
    have hE_le : E_cop ≤ H_frac := by
      rw [Subgroup.closure_le]
      rintro x ⟨b, hb_eq, hb_cop⟩
      have hb_ne : b ≠ 0 := by
        intro hb0
        apply x.ne_zero
        rw [hb_eq, hb0, map_zero]
      refine ⟨b, 1, hb_ne, one_ne_zero, hb_cop, ?_, ?_⟩
      · rw [map_one, Ideal.span_singleton_one]
        exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
      · rw [hb_eq, map_one, mul_one]
    intro x hx
    obtain ⟨a₁, a₂, ha₁_ne, ha₂_ne, ha₁_cop, ha₂_cop, hx_eq⟩ := hE_le hx.1
    have hx_norm_unit : (Units.map (Algebra.norm F)) x = 1 := MonoidHom.mem_ker.mp hx.2
    have hx_norm : Algebra.norm F (x : E) = 1 := congrArg Units.val hx_norm_unit
    have h_norm_eq : Algebra.intNorm R_F R_E a₁ = Algebra.intNorm R_F R_E a₂ := by
      apply hinj_F
      rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
        ← hx_eq, map_mul, hx_norm, one_mul]
    exact ⟨a₁, a₂, ha₁_ne, ha₂_ne, ha₁_cop, ha₂_cop, h_norm_eq, hx_eq⟩
  · rintro z ⟨c, hc_ne, hc_cop, hz_eq⟩
    have hcE_ne : algebraMap R_E E c ≠ 0 :=
      (map_ne_zero_iff (algebraMap R_E E) hinj_E).mpr hc_ne
    let y_c : Eˣ := Units.mk0 (algebraMap R_E E c) hcE_ne
    have hy_c_mem : y_c ∈ E_cop :=
      Subgroup.subset_closure ⟨c, Units.val_mk0 hcE_ne, hc_cop⟩
    rw [Subgroup.mem_map]
    refine ⟨y_c, hy_c_mem, ?_⟩
    apply Units.ext
    have hδ : (((MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) y_c : Eˣ) : E) =
        (y_c : E) / σ (y_c : E) := by
      change ((y_c / Units.map (σ : E ≃* E).toMonoidHom y_c : Eˣ) : E) = (y_c : E) / σ (y_c : E)
      rw [Units.val_div_eq_div_val]
      rfl
    have hσ_ne : σ (algebraMap R_E E c) ≠ 0 :=
      (map_ne_zero_iff σ σ.injective).mpr hcE_ne
    rw [hδ, Units.val_mk0 hcE_ne, div_eq_iff hσ_ne]
    exact hz_eq.symm
  · have h_intNorm_gal : ∀ (ρ : E ≃ₐ[F] E) (b : R_E),
        Algebra.intNorm R_F R_E (galRestrict R_F F E R_E ρ b) = Algebra.intNorm R_F R_E b := by
      intro ρ b
      apply hinj_F
      rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
        algebraMap_galRestrict_apply, Algebra.norm_eq_of_algEquiv]
    let cof : R_E → R_E := fun c =>
      ∏ ρ ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase 1, galRestrict R_F F E R_E ρ c
    have hcof_mul : ∀ c : R_E,
        c * cof c = algebraMap R_F R_E (Algebra.intNorm R_F R_E c) := by
      intro c
      have h_prod : c * cof c = ∏ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ c := by
        dsimp [cof]
        have h1 := Finset.mul_prod_erase (Finset.univ : Finset (E ≃ₐ[F] E))
          (fun ρ : E ≃ₐ[F] E => galRestrict R_F F E R_E ρ c) (Finset.mem_univ (1 : E ≃ₐ[F] E))
        dsimp only at h1
        rwa [map_one, AlgEquiv.one_apply] at h1
      apply hinj_E
      rw [h_prod, map_prod]
      simp_rw [algebraMap_galRestrict_apply]
      rw [← Algebra.norm_eq_prod_automorphisms F (algebraMap R_E E c),
        ← Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E),
        ← IsScalarTower.algebraMap_apply R_F F E,
        IsScalarTower.algebraMap_apply R_F R_E E]
    have hcof_fix : ∀ c : R_E,
        σ_int c * σ_int (cof c) = c * cof c := by
      intro c
      rw [← map_mul, hcof_mul c, σ_int.commutes]
    have hcof_cop : ∀ c : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ →
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (cof c)}) m₀ := by
      intro c hc_cop
      have h_norm_cof : Algebra.intNorm R_F R_E (cof c) =
          (Algebra.intNorm R_F R_E c) ^ ((Finset.univ : Finset (E ≃ₐ[F] E)).erase 1).card := by
        dsimp [cof]
        rw [map_prod, Finset.prod_congr rfl (fun ρ _ => h_intNorm_gal ρ c), Finset.prod_const]
      rw [h_norm_cof, ← Ideal.span_singleton_pow]
      exact hc_cop.pow_left
    let H_mod : Subgroup (R_E ⧸ I₀)ˣ :=
      { carrier := { u : (R_E ⧸ I₀)ˣ |
          ∃ b c : R_E,
            IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
            (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
            Ideal.Quotient.mk I₁ (b * σ_int c) = Ideal.Quotient.mk I₁ c }
        one_mem' := by
          refine ⟨1, 1, ?_, ?_, ?_⟩
          · rw [map_one, Ideal.span_singleton_one]
            exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
          · rw [Units.val_one, map_one]
          · rw [one_mul, map_one]
        mul_mem' := by
          rintro u₁ u₂ ⟨b₁, c₁, hc₁_cop, hu₁_eq, h₁⟩ ⟨b₂, c₂, hc₂_cop, hu₂_eq, h₂⟩
          refine ⟨b₁ * b₂, c₁ * c₂, ?_, ?_, ?_⟩
          · rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
            exact IsCoprime.mul_left hc₁_cop hc₂_cop
          · rw [Units.val_mul, hu₁_eq, hu₂_eq, ← map_mul]
          · have h_assoc : (b₁ * b₂) * σ_int (c₁ * c₂) = (b₁ * σ_int c₁) * (b₂ * σ_int c₂) := by
              rw [map_mul]
              ring
            rw [h_assoc, map_mul, h₁, h₂, ← map_mul]
        inv_mem' := by
          rintro u ⟨b, c, hc_cop, hu_eq, hbc⟩
          obtain ⟨b', hb'_eq⟩ := Ideal.Quotient.mk_surjective ((u⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀)
          refine ⟨b', cof c, hcof_cop c hc_cop, hb'_eq.symm, ?_⟩
          have hb'b_I₀ : Ideal.Quotient.mk I₀ (b' * b) = Ideal.Quotient.mk I₀ 1 := by
            rw [map_mul, hb'_eq, ← hu_eq, Units.inv_mul, map_one]
          have hb'b_mem₀ : b' * b - 1 ∈ I₀ := Ideal.Quotient.eq.mp hb'b_I₀
          have hb'b_I₁ : Ideal.Quotient.mk I₁ (b' * b) = 1 := by
            rw [← map_one (Ideal.Quotient.mk I₁)]
            exact Ideal.Quotient.eq.mpr (hI₀_le hb'b_mem₀)
          obtain ⟨x, hx_span, s, hs_m₀, hxs⟩ := Ideal.isCoprime_iff_exists.mp hc_cop
          obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hx_span
          have hs_m₁ : s ∈ m₁ := hm₀_le hs_m₀
          have h_sub_m₁ : Algebra.intNorm R_F R_E c * r - 1 ∈ m₁ := by
            have h_eq : Algebra.intNorm R_F R_E c * r - 1 = -s := by
              calc
                Algebra.intNorm R_F R_E c * r - 1
                    = (Algebra.intNorm R_F R_E c * r + s) - 1 - s := by ring
                _ = 1 - 1 - s := by rw [hxs]
                _ = -s := by ring
            rw [h_eq]
            exact m₁.neg_mem hs_m₁
          have h_map_I₁ : algebraMap R_F R_E (Algebra.intNorm R_F R_E c * r - 1) ∈ I₁ :=
            Ideal.mem_map_of_mem (algebraMap R_F R_E) h_sub_m₁
          have h_ccof_mem : c * cof c * algebraMap R_F R_E r - 1 ∈ I₁ := by
            have h_eq : c * cof c * algebraMap R_F R_E r - 1 =
                algebraMap R_F R_E (Algebra.intNorm R_F R_E c * r - 1) := by
              rw [map_sub, map_mul, map_one, ← hcof_mul c]
            rwa [h_eq]
          have h_unit_I₁ : Ideal.Quotient.mk I₁ (c * cof c * algebraMap R_F R_E r) = 1 := by
            rw [← map_one (Ideal.Quotient.mk I₁)]
            exact Ideal.Quotient.eq.mpr h_ccof_mem
          have h_ring₁ : (b' * σ_int (cof c)) * (c * cof c * algebraMap R_F R_E r) =
              b' * c * (σ_int (cof c) * cof c * algebraMap R_F R_E r) := by ring
          have h_ring₂ : b' * (b * σ_int c) * (σ_int (cof c) * cof c * algebraMap R_F R_E r) =
              (b' * b) * ((σ_int c * σ_int (cof c)) * algebraMap R_F R_E r) * cof c := by ring
          calc
            Ideal.Quotient.mk I₁ (b' * σ_int (cof c))
                = Ideal.Quotient.mk I₁ (b' * σ_int (cof c)) * 1 := (mul_one _).symm
            _ = Ideal.Quotient.mk I₁ (b' * σ_int (cof c)) *
                  Ideal.Quotient.mk I₁ (c * cof c * algebraMap R_F R_E r) := by rw [h_unit_I₁]
            _ = Ideal.Quotient.mk I₁ ((b' * σ_int (cof c)) * (c * cof c * algebraMap R_F R_E r)) :=
                  (map_mul _ _ _).symm
            _ = Ideal.Quotient.mk I₁ (b' * c * (σ_int (cof c) * cof c * algebraMap R_F R_E r)) := by
                  rw [h_ring₁]
            _ = Ideal.Quotient.mk I₁ b' * Ideal.Quotient.mk I₁ c *
                  Ideal.Quotient.mk I₁ (σ_int (cof c) * cof c * algebraMap R_F R_E r) := by
                  rw [map_mul, map_mul]
            _ = Ideal.Quotient.mk I₁ b' * Ideal.Quotient.mk I₁ (b * σ_int c) *
                  Ideal.Quotient.mk I₁ (σ_int (cof c) * cof c * algebraMap R_F R_E r) := by
                  rw [← hbc]
            _ = Ideal.Quotient.mk I₁ (b' * (b * σ_int c) *
                  (σ_int (cof c) * cof c * algebraMap R_F R_E r)) := by
                  rw [← map_mul, ← map_mul]
            _ = Ideal.Quotient.mk I₁ ((b' * b) * ((σ_int c * σ_int (cof c)) * algebraMap R_F R_E r) *
                  cof c) := by
                  rw [h_ring₂]
            _ = Ideal.Quotient.mk I₁ (b' * b) *
                  Ideal.Quotient.mk I₁ (c * cof c * algebraMap R_F R_E r) *
                  Ideal.Quotient.mk I₁ (cof c) := by
                  rw [hcof_fix c, map_mul, map_mul]
            _ = 1 * 1 * Ideal.Quotient.mk I₁ (cof c) := by rw [hb'b_I₁, h_unit_I₁]
            _ = Ideal.Quotient.mk I₁ (cof c) := by rw [one_mul, one_mul] }
    have hB_mod_le : B_mod ≤ H_mod := by
      rw [Subgroup.closure_le]
      intro _ hu
      exact hu
    intro u hu
    exact hB_mod_le hu

theorem exists_mod_unit_hom_of_coprime_norm_one {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_le : m₀ ≤ m₁) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
      ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
    let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
    let B_cop : Subgroup Eˣ :=
      Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
    let K_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b : R_E,
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) = 1 }
    let B_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b c : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk I₁ (b * σ_int c) = Ideal.Quotient.mk I₁ c }
    Finite (K_mod ⧸ B_mod.subgroupOf K_mod) ∧
    ∃ π₀ : E_cop →* (R_E ⧸ I₀)ˣ,
      (∀ (x : E_cop) (b₁ b₂ : R_E),
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ →
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ →
        ((x : Eˣ) : E) * algebraMap R_E E b₂ = algebraMap R_E E b₁ →
        (π₀ x : R_E ⧸ I₀) * Ideal.Quotient.mk I₀ b₂ = Ideal.Quotient.mk I₀ b₁) ∧
      (∀ x : E_cop, (x : Eˣ) ∈ K_cop → π₀ x ∈ K_mod) ∧
      (∀ x : E_cop, (x : Eˣ) ∈ B_cop → π₀ x ∈ B_mod) :=
by
  intro R_F R_E σ_int I₁ I₀ E_cop K_cop B_cop K_mod B_mod
  refine ⟨?_, ?_⟩
  · have hinj_FE : Function.Injective (algebraMap R_F R_E) :=
      FaithfulSMul.algebraMap_injective R_F R_E
    have hI₀_ne : I₀ ≠ ⊥ := (Ideal.map_eq_bot_iff_of_injective hinj_FE).not.mpr hm₀_ne
    haveI : Finite (R_E ⧸ I₀) := Ideal.finiteQuotientOfFreeOfNeBot I₀ hI₀_ne
    haveI : Finite (R_E ⧸ I₀)ˣ := inferInstance
    haveI : Finite K_mod := Subtype.finite
    exact Quotient.finite (QuotientGroup.leftRel (B_mod.subgroupOf K_mod))
  · classical
    have hinj_F : Function.Injective (algebraMap R_F F) :=
      FaithfulSMul.algebraMap_injective R_F F
    have hinj_E : Function.Injective (algebraMap R_E E) :=
      FaithfulSMul.algebraMap_injective R_E E
    have hinj_FE : Function.Injective (algebraMap R_F R_E) :=
      FaithfulSMul.algebraMap_injective R_F R_E
    have hI₀_le : I₀ ≤ I₁ := Ideal.map_mono hm₀_le
    have h_intNorm_gal : ∀ (ρ : E ≃ₐ[F] E) (b : R_E),
        Algebra.intNorm R_F R_E (galRestrict R_F F E R_E ρ b) = Algebra.intNorm R_F R_E b := by
      intro ρ b
      apply hinj_F
      rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
        algebraMap_galRestrict_apply, Algebra.norm_eq_of_algEquiv]
    obtain ⟨cof, hcof_mul, h_norm_base, h_norm_cof_eq⟩ :
        ∃ cof : R_E → R_E,
          (∀ b : R_E, b * cof b = algebraMap R_F R_E (Algebra.intNorm R_F R_E b)) ∧
          (∀ r : R_F, Algebra.intNorm R_F R_E (algebraMap R_F R_E r) = r ^ Fintype.card (E ≃ₐ[F] E)) ∧
          (∀ b₁ b₂ : R_E,
            Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ →
            Algebra.intNorm R_F R_E (b₁ * cof b₂) =
              (Algebra.intNorm R_F R_E b₂) ^ Fintype.card (E ≃ₐ[F] E)) := by
      let cof_fn : R_E → R_E := fun b =>
        ∏ ρ ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase 1, galRestrict R_F F E R_E ρ b
      have h_prod_gal : ∀ b : R_E,
          (∏ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ b) =
            algebraMap R_F R_E (Algebra.intNorm R_F R_E b) := by
        intro b
        apply hinj_E
        rw [map_prod (algebraMap R_E E)]
        simp_rw [algebraMap_galRestrict_apply]
        rw [← Algebra.norm_eq_prod_automorphisms F (algebraMap R_E E b),
          ← Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E),
          ← IsScalarTower.algebraMap_apply R_F F E,
          IsScalarTower.algebraMap_apply R_F R_E E]
      refine ⟨cof_fn, ?_, ?_, ?_⟩
      · intro b
        have h1 := Finset.mul_prod_erase (Finset.univ : Finset (E ≃ₐ[F] E))
          (fun ρ : E ≃ₐ[F] E => galRestrict R_F F E R_E ρ b) (Finset.mem_univ (1 : E ≃ₐ[F] E))
        have h_one : galRestrict R_F F E R_E (1 : E ≃ₐ[F] E) b = b := by
          rw [map_one (galRestrict R_F F E R_E), AlgEquiv.one_apply]
        dsimp only at h1
        rw [h_one] at h1
        exact h1.trans (h_prod_gal b)
      · intro r
        apply hinj_FE
        rw [← h_prod_gal (algebraMap R_F R_E r)]
        have h_comm : ∀ ρ : E ≃ₐ[F] E,
            galRestrict R_F F E R_E ρ (algebraMap R_F R_E r) = algebraMap R_F R_E r :=
          fun ρ => (galRestrict R_F F E R_E ρ).commutes r
        simp_rw [h_comm]
        rw [Finset.prod_const, Finset.card_univ, ← map_pow (algebraMap R_F R_E)]
      · intro b₁ b₂ h_eq
        dsimp [cof_fn]
        rw [map_mul (Algebra.intNorm R_F R_E), h_eq, map_prod (Algebra.intNorm R_F R_E),
          Finset.prod_congr rfl (fun ρ _ => h_intNorm_gal ρ b₂)]
        have h1 := Finset.mul_prod_erase (Finset.univ : Finset (E ≃ₐ[F] E))
          (fun _ : E ≃ₐ[F] E => Algebra.intNorm R_F R_E b₂) (Finset.mem_univ (1 : E ≃ₐ[F] E))
        dsimp only at h1
        rw [h1, Finset.prod_const, Finset.card_univ]
    have h_inv_ex : ∀ b : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ →
        ∃ r : R_F, Algebra.intNorm R_F R_E b * r - 1 ∈ m₀ := by
      intro b hb
      obtain ⟨y, hy_span, s, hs_m₀, hys⟩ := Ideal.isCoprime_iff_exists.mp hb
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hy_span
      refine ⟨r, ?_⟩
      have h_eq : Algebra.intNorm R_F R_E b * r - 1 = -s := by
        calc
          Algebra.intNorm R_F R_E b * r - 1
              = (Algebra.intNorm R_F R_E b * r + s) - 1 - s := by ring
          _ = 1 - 1 - s := by rw [hys]
          _ = -s := by ring
      rw [h_eq]
      exact m₀.neg_mem hs_m₀
    have h_inv_sub_mem : ∀ (b : R_E) (r : R_F),
        Algebra.intNorm R_F R_E b * r - 1 ∈ m₀ →
        b * (cof b * algebraMap R_F R_E r) - 1 ∈ I₀ := by
      intro b r hr
      have h_map : algebraMap R_F R_E (Algebra.intNorm R_F R_E b * r - 1) ∈ I₀ :=
        Ideal.mem_map_of_mem (algebraMap R_F R_E) hr
      have h_eq : b * (cof b * algebraMap R_F R_E r) - 1 =
          algebraMap R_F R_E (Algebra.intNorm R_F R_E b * r - 1) := by
        calc
          b * (cof b * algebraMap R_F R_E r) - 1
              = (b * cof b) * algebraMap R_F R_E r - 1 :=
              congrArg (· - 1) (mul_assoc b (cof b) (algebraMap R_F R_E r)).symm
          _ = algebraMap R_F R_E (Algebra.intNorm R_F R_E b) * algebraMap R_F R_E r - 1 :=
              congrArg (fun t => t * algebraMap R_F R_E r - 1) (hcof_mul b)
          _ = algebraMap R_F R_E (Algebra.intNorm R_F R_E b * r) - algebraMap R_F R_E 1 :=
              congrArg₂ (· - ·)
                (map_mul (algebraMap R_F R_E) (Algebra.intNorm R_F R_E b) r).symm
                (map_one (algebraMap R_F R_E)).symm
          _ = algebraMap R_F R_E (Algebra.intNorm R_F R_E b * r - 1) :=
              (map_sub (algebraMap R_F R_E) (Algebra.intNorm R_F R_E b * r) 1).symm
      exact h_eq.symm ▸ h_map
    have h_inv_I₀ : ∀ (b : R_E) (r : R_F),
        Algebra.intNorm R_F R_E b * r - 1 ∈ m₀ →
        Ideal.Quotient.mk I₀ b * Ideal.Quotient.mk I₀ (cof b * algebraMap R_F R_E r) = 1 :=
      fun b r hr =>
        (map_mul (Ideal.Quotient.mk I₀) b (cof b * algebraMap R_F R_E r)).symm.trans
          ((Ideal.Quotient.eq.mpr (h_inv_sub_mem b r hr)).trans (map_one (Ideal.Quotient.mk I₀)))
    have h_inv_m₀ : ∀ (b : R_E) (r : R_F),
        Algebra.intNorm R_F R_E b * r - 1 ∈ m₀ →
        Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b * r) = 1 :=
      fun b r hr => (Ideal.Quotient.eq.mpr hr).trans (map_one (Ideal.Quotient.mk m₀))
    have h_clear_denom : ∀ (z : R_E ⧸ I₀) (b₁ b₂ : R_E) (r : R_F),
        z * Ideal.Quotient.mk I₀ b₂ = Ideal.Quotient.mk I₀ b₁ →
        Algebra.intNorm R_F R_E b₂ * r - 1 ∈ m₀ →
        z = Ideal.Quotient.mk I₀ (b₁ * cof b₂ * algebraMap R_F R_E r) := by
      intro z b₁ b₂ r h_spec hr
      calc
        z = z * 1 := (mul_one z).symm
        _ = z * (Ideal.Quotient.mk I₀ b₂ * Ideal.Quotient.mk I₀ (cof b₂ * algebraMap R_F R_E r)) :=
            congrArg (z * ·) (h_inv_I₀ b₂ r hr).symm
        _ = (z * Ideal.Quotient.mk I₀ b₂) * Ideal.Quotient.mk I₀ (cof b₂ * algebraMap R_F R_E r) :=
            (mul_assoc _ _ _).symm
        _ = Ideal.Quotient.mk I₀ b₁ * Ideal.Quotient.mk I₀ (cof b₂ * algebraMap R_F R_E r) :=
            congrArg (· * _) h_spec
        _ = Ideal.Quotient.mk I₀ (b₁ * (cof b₂ * algebraMap R_F R_E r)) :=
            (map_mul (Ideal.Quotient.mk I₀) b₁ _).symm
        _ = Ideal.Quotient.mk I₀ (b₁ * cof b₂ * algebraMap R_F R_E r) :=
            congrArg (Ideal.Quotient.mk I₀) (mul_assoc b₁ (cof b₂) (algebraMap R_F R_E r)).symm
    obtain ⟨u₀, hu₀_val⟩ :
        ∃ u₀ : ∀ b : R_E, IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ → (R_E ⧸ I₀)ˣ,
          ∀ (b : R_E) (hb : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀),
            (u₀ b hb : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b := by
      have hu₀ : ∀ b : R_E,
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ →
          IsUnit (Ideal.Quotient.mk I₀ b) := by
        intro b hb
        obtain ⟨r, hr⟩ := h_inv_ex b hb
        exact isUnit_iff_exists_inv.mpr
          ⟨Ideal.Quotient.mk I₀ (cof b * algebraMap R_F R_E r), h_inv_I₀ b r hr⟩
      exact ⟨fun b hb => (hu₀ b hb).unit, fun b hb => (hu₀ b hb).unit_spec⟩
    have hu₀_mul : ∀ (b₁ b₂ : R_E)
        (hb₁ : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀)
        (hb₂ : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀)
        (hb₁₂ : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (b₁ * b₂)}) m₀),
        u₀ (b₁ * b₂) hb₁₂ = u₀ b₁ hb₁ * u₀ b₂ hb₂ := by
      intro b₁ b₂ hb₁ hb₂ hb₁₂
      apply Units.ext
      calc
        (u₀ (b₁ * b₂) hb₁₂ : R_E ⧸ I₀)
            = Ideal.Quotient.mk I₀ (b₁ * b₂) := hu₀_val (b₁ * b₂) hb₁₂
        _ = Ideal.Quotient.mk I₀ b₁ * Ideal.Quotient.mk I₀ b₂ :=
            map_mul (Ideal.Quotient.mk I₀) b₁ b₂
        _ = (u₀ b₁ hb₁ : R_E ⧸ I₀) * (u₀ b₂ hb₂ : R_E ⧸ I₀) :=
            congrArg₂ (· * ·) (hu₀_val b₁ hb₁).symm (hu₀_val b₂ hb₂).symm
        _ = ((u₀ b₁ hb₁ * u₀ b₂ hb₂ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) :=
            (Units.val_mul (u₀ b₁ hb₁) (u₀ b₂ hb₂)).symm
    have h1_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E 1}) m₀ := by
      rw [map_one (Algebra.intNorm R_F R_E), Ideal.span_singleton_one]
      exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
    have hmul_cop : ∀ {b₁ b₂ : R_E},
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ →
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ →
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (b₁ * b₂)}) m₀ := by
      intro b₁ b₂ hb₁ hb₂
      rw [map_mul (Algebra.intNorm R_F R_E), ← Ideal.span_singleton_mul_span_singleton]
      exact IsCoprime.mul_left hb₁ hb₂
    obtain ⟨B₁, B₂, hB₁, hB₂, hB_eq⟩ :
        ∃ (B₁ B₂ : E_cop → R_E),
          (∀ x : E_cop, IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (B₁ x)}) m₀) ∧
          (∀ x : E_cop, IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (B₂ x)}) m₀) ∧
          (∀ x : E_cop, ((x : Eˣ) : E) * algebraMap R_E E (B₂ x) = algebraMap R_E E (B₁ x)) := by
      let H_frac : Subgroup Eˣ :=
        { carrier := { x : Eˣ |
            ∃ b₁ b₂ : R_E,
              IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
              IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
              (x : E) * algebraMap R_E E b₂ = algebraMap R_E E b₁ }
          one_mem' := ⟨1, 1, h1_cop, h1_cop, by rw [Units.val_one, one_mul]⟩
          mul_mem' := by
            rintro x y ⟨b₁, b₂, hb₁, hb₂, hx_eq⟩ ⟨c₁, c₂, hc₁, hc₂, hy_eq⟩
            refine ⟨b₁ * c₁, b₂ * c₂, hmul_cop hb₁ hc₁, hmul_cop hb₂ hc₂, ?_⟩
            rw [Units.val_mul, map_mul (algebraMap R_E E), map_mul (algebraMap R_E E)]
            calc
              ((x : E) * (y : E)) * (algebraMap R_E E b₂ * algebraMap R_E E c₂)
                  = ((x : E) * algebraMap R_E E b₂) * ((y : E) * algebraMap R_E E c₂) := by ring
              _ = algebraMap R_E E b₁ * algebraMap R_E E c₁ := by rw [hx_eq, hy_eq]
          inv_mem' := by
            rintro x ⟨b₁, b₂, hb₁, hb₂, hx_eq⟩
            refine ⟨b₂, b₁, hb₂, hb₁, ?_⟩
            calc
              ((x⁻¹ : Eˣ) : E) * algebraMap R_E E b₁
                  = ((x⁻¹ : Eˣ) : E) * ((x : E) * algebraMap R_E E b₂) := by rw [← hx_eq]
              _ = (((x⁻¹ : Eˣ) : E) * (x : E)) * algebraMap R_E E b₂ := by ring
              _ = 1 * algebraMap R_E E b₂ := by rw [Units.inv_mul]
              _ = algebraMap R_E E b₂ := by rw [one_mul] }
      have h_frac : E_cop ≤ H_frac := by
        rw [Subgroup.closure_le]
        rintro x ⟨b, hb_eq, hb_cop⟩
        exact ⟨b, 1, hb_cop, h1_cop, by rw [hb_eq, map_one (algebraMap R_E E), mul_one]⟩
      exact ⟨fun x => Classical.choose (h_frac x.2),
        fun x => Classical.choose (Classical.choose_spec (h_frac x.2)),
        fun x => (Classical.choose_spec (Classical.choose_spec (h_frac x.2))).1,
        fun x => (Classical.choose_spec (Classical.choose_spec (h_frac x.2))).2.1,
        fun x => (Classical.choose_spec (Classical.choose_spec (h_frac x.2))).2.2⟩
    obtain ⟨π₀, hπ₀_spec⟩ :
        ∃ π₀ : E_cop →* (R_E ⧸ I₀)ˣ,
          ∀ (x : E_cop) (b₁ b₂ : R_E),
            IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ →
            IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ →
            ((x : Eˣ) : E) * algebraMap R_E E b₂ = algebraMap R_E E b₁ →
            (π₀ x : R_E ⧸ I₀) * Ideal.Quotient.mk I₀ b₂ = Ideal.Quotient.mk I₀ b₁ := by
      obtain ⟨π₀_fun, hπ₀_def⟩ :
          ∃ π₀_fun : E_cop → (R_E ⧸ I₀)ˣ,
            ∀ x : E_cop, π₀_fun x = u₀ (B₁ x) (hB₁ x) * (u₀ (B₂ x) (hB₂ x))⁻¹ :=
        ⟨fun x => u₀ (B₁ x) (hB₁ x) * (u₀ (B₂ x) (hB₂ x))⁻¹, fun _ => rfl⟩
      have hπ₀_spec_fun : ∀ (x : E_cop) (b₁ b₂ : R_E),
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ →
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ →
          ((x : Eˣ) : E) * algebraMap R_E E b₂ = algebraMap R_E E b₁ →
          (π₀_fun x : R_E ⧸ I₀) * Ideal.Quotient.mk I₀ b₂ = Ideal.Quotient.mk I₀ b₁ := by
        intro x b₁ b₂ hb₁ hb₂ hx_eq
        have h_cross : B₁ x * b₂ = b₁ * B₂ x := by
          apply hinj_E
          calc
            algebraMap R_E E (B₁ x * b₂)
                = algebraMap R_E E (B₁ x) * algebraMap R_E E b₂ := map_mul _ _ _
            _ = (((x : Eˣ) : E) * algebraMap R_E E (B₂ x)) * algebraMap R_E E b₂ := by rw [← hB_eq x]
            _ = (((x : Eˣ) : E) * algebraMap R_E E b₂) * algebraMap R_E E (B₂ x) := by ring
            _ = algebraMap R_E E b₁ * algebraMap R_E E (B₂ x) := by rw [hx_eq]
            _ = algebraMap R_E E (b₁ * B₂ x) := (map_mul _ _ _).symm
        let q : R_E →+* R_E ⧸ I₀ := Ideal.Quotient.mk I₀
        let u₁ : (R_E ⧸ I₀)ˣ := u₀ (B₁ x) (hB₁ x)
        let u₂ : (R_E ⧸ I₀)ˣ := u₀ (B₂ x) (hB₂ x)
        have hu₂_inv : ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * q (B₂ x) = 1 :=
          (congrArg (((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * ·)
            (hu₀_val (B₂ x) (hB₂ x)).symm).trans (Units.inv_mul u₂)
        have h_lhs : (π₀_fun x : R_E ⧸ I₀) = q (B₁ x) * ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) :=
          (congrArg Units.val (hπ₀_def x)).trans
            ((Units.val_mul u₁ u₂⁻¹).trans
              (congrArg (· * ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀)) (hu₀_val (B₁ x) (hB₁ x))))
        calc
          (π₀_fun x : R_E ⧸ I₀) * q b₂
              = (q (B₁ x) * ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀)) * q b₂ :=
              congrArg (· * q b₂) h_lhs
          _ = (((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * q (B₁ x)) * q b₂ :=
              congrArg (· * q b₂) (mul_comm (q (B₁ x)) ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀))
          _ = ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * (q (B₁ x) * q b₂) :=
              mul_assoc _ _ _
          _ = ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * q (B₁ x * b₂) :=
              congrArg (((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * ·) (map_mul q _ _).symm
          _ = ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * q (b₁ * B₂ x) :=
              congrArg (fun t => ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * q t) h_cross
          _ = ((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * (q b₁ * q (B₂ x)) :=
              congrArg (((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * ·) (map_mul q _ _)
          _ = q b₁ * (((u₂⁻¹ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) * q (B₂ x)) :=
              mul_left_comm _ _ _
          _ = q b₁ * 1 := congrArg (q b₁ * ·) hu₂_inv
          _ = q b₁ := mul_one (q b₁)
      have hπ₀_unit : ∀ (x : E_cop) (b₁ b₂ : R_E)
          (hb₁ : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀)
          (hb₂ : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀),
          ((x : Eˣ) : E) * algebraMap R_E E b₂ = algebraMap R_E E b₁ →
          π₀_fun x = u₀ b₁ hb₁ * (u₀ b₂ hb₂)⁻¹ := by
        intro x b₁ b₂ hb₁ hb₂ hx_eq
        apply eq_mul_inv_iff_mul_eq.mpr
        apply Units.ext
        calc
          ((π₀_fun x * u₀ b₂ hb₂ : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀)
              = (π₀_fun x : R_E ⧸ I₀) * (u₀ b₂ hb₂ : R_E ⧸ I₀) :=
              Units.val_mul (π₀_fun x) (u₀ b₂ hb₂)
          _ = (π₀_fun x : R_E ⧸ I₀) * Ideal.Quotient.mk I₀ b₂ :=
              congrArg ((π₀_fun x : R_E ⧸ I₀) * ·) (hu₀_val b₂ hb₂)
          _ = Ideal.Quotient.mk I₀ b₁ := hπ₀_spec_fun x b₁ b₂ hb₁ hb₂ hx_eq
          _ = (u₀ b₁ hb₁ : R_E ⧸ I₀) := (hu₀_val b₁ hb₁).symm
      refine ⟨{ toFun := π₀_fun
                map_one' := by
                  have h_one_eq : (((1 : E_cop) : Eˣ) : E) * algebraMap R_E E 1 = algebraMap R_E E 1 := by
                    rw [Subgroup.coe_one, Units.val_one, one_mul]
                  exact (hπ₀_unit 1 1 1 h1_cop h1_cop h_one_eq).trans (mul_inv_cancel (u₀ 1 h1_cop))
                map_mul' := by
                  intro x y
                  have h_xy_eq : (((x * y : E_cop) : Eˣ) : E) * algebraMap R_E E (B₂ x * B₂ y) =
                      algebraMap R_E E (B₁ x * B₁ y) := by
                    rw [Subgroup.coe_mul, Units.val_mul, map_mul (algebraMap R_E E), map_mul (algebraMap R_E E)]
                    calc
                      (((x : Eˣ) : E) * ((y : Eˣ) : E)) * (algebraMap R_E E (B₂ x) * algebraMap R_E E (B₂ y))
                          = (((x : Eˣ) : E) * algebraMap R_E E (B₂ x)) *
                              (((y : Eˣ) : E) * algebraMap R_E E (B₂ y)) := by ring
                      _ = algebraMap R_E E (B₁ x) * algebraMap R_E E (B₁ y) := by rw [hB_eq x, hB_eq y]
                  let u₁x := u₀ (B₁ x) (hB₁ x)
                  let u₁y := u₀ (B₁ y) (hB₁ y)
                  let u₂x := u₀ (B₂ x) (hB₂ x)
                  let u₂y := u₀ (B₂ y) (hB₂ y)
                  calc
                    π₀_fun (x * y)
                        = u₀ (B₁ x * B₁ y) (hmul_cop (hB₁ x) (hB₁ y)) *
                            (u₀ (B₂ x * B₂ y) (hmul_cop (hB₂ x) (hB₂ y)))⁻¹ :=
                        hπ₀_unit (x * y) (B₁ x * B₁ y) (B₂ x * B₂ y)
                          (hmul_cop (hB₁ x) (hB₁ y)) (hmul_cop (hB₂ x) (hB₂ y)) h_xy_eq
                    _ = (u₁x * u₁y) * (u₂x * u₂y)⁻¹ :=
                        congrArg₂ (· * ·)
                          (hu₀_mul (B₁ x) (B₁ y) (hB₁ x) (hB₁ y) (hmul_cop (hB₁ x) (hB₁ y)))
                          (congrArg Inv.inv (hu₀_mul (B₂ x) (B₂ y) (hB₂ x) (hB₂ y) (hmul_cop (hB₂ x) (hB₂ y))))
                    _ = (u₁x * u₁y) * (u₂y⁻¹ * u₂x⁻¹) :=
                        congrArg ((u₁x * u₁y) * ·) (mul_inv_rev u₂x u₂y)
                    _ = (u₁x * u₁y) * (u₂x⁻¹ * u₂y⁻¹) :=
                        congrArg ((u₁x * u₁y) * ·) (mul_comm u₂y⁻¹ u₂x⁻¹)
                    _ = (u₁x * u₂x⁻¹) * (u₁y * u₂y⁻¹) :=
                        mul_mul_mul_comm u₁x u₁y u₂x⁻¹ u₂y⁻¹
                    _ = π₀_fun x * π₀_fun y :=
                        congrArg₂ (· * ·) (hπ₀_def x).symm (hπ₀_def y).symm }, hπ₀_spec_fun⟩
    have hπ₀_K : ∀ x : E_cop, (x : Eˣ) ∈ K_cop → π₀ x ∈ K_mod := by
      intro x hx_K
      let b₁ : R_E := B₁ x
      let b₂ : R_E := B₂ x
      have hx_norm_unit : (Units.map (Algebra.norm F)) (x : Eˣ) = 1 :=
        MonoidHom.mem_ker.mp hx_K.2
      have hx_norm : Algebra.norm F ((x : Eˣ) : E) = 1 :=
        congrArg Units.val hx_norm_unit
      have h_norm_eq : Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ := by
        apply hinj_F
        rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
          ← hB_eq x, map_mul (Algebra.norm F), hx_norm, one_mul]
      obtain ⟨r, hr⟩ := h_inv_ex b₂ (hB₂ x)
      let b : R_E := b₁ * cof b₂ * algebraMap R_F R_E r
      apply Subgroup.subset_closure
      refine ⟨b, h_clear_denom (π₀ x : R_E ⧸ I₀) b₁ b₂ r (hπ₀_spec x b₁ b₂ (hB₁ x) (hB₂ x) (hB_eq x)) hr, ?_⟩
      have h_norm_b : Algebra.intNorm R_F R_E b =
          (Algebra.intNorm R_F R_E b₂ * r) ^ Fintype.card (E ≃ₐ[F] E) := by
        dsimp [b]
        rw [map_mul (Algebra.intNorm R_F R_E), h_norm_cof_eq b₁ b₂ h_norm_eq, h_norm_base r, ← mul_pow]
      calc
        Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b)
            = Ideal.Quotient.mk m₀ ((Algebra.intNorm R_F R_E b₂ * r) ^ Fintype.card (E ≃ₐ[F] E)) :=
            congrArg (Ideal.Quotient.mk m₀) h_norm_b
        _ = (Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b₂ * r)) ^ Fintype.card (E ≃ₐ[F] E) :=
            map_pow (Ideal.Quotient.mk m₀) _ _
        _ = 1 ^ Fintype.card (E ≃ₐ[F] E) :=
            congrArg (· ^ Fintype.card (E ≃ₐ[F] E)) (h_inv_m₀ b₂ r hr)
        _ = 1 := one_pow _
    have hπ₀_B : ∀ x : E_cop, (x : Eˣ) ∈ B_cop → π₀ x ∈ B_mod := by
      let τ_E : Eˣ →* Eˣ := Units.map (σ : E ≃* E).toMonoidHom
      let δ_E : Eˣ →* Eˣ := MonoidHom.id Eˣ / τ_E
      let H_cob : Subgroup Eˣ :=
        { carrier := { y : Eˣ | ∃ h_δ : δ_E y ∈ E_cop, π₀ ⟨δ_E y, h_δ⟩ ∈ B_mod }
          one_mem' := by
            have h1 : δ_E 1 ∈ E_cop := (map_one δ_E).symm ▸ E_cop.one_mem
            refine ⟨h1, ?_⟩
            have h_eq : π₀ ⟨δ_E 1, h1⟩ = 1 :=
              (congrArg π₀ (Subtype.ext (map_one δ_E))).trans (map_one π₀)
            exact h_eq.symm ▸ B_mod.one_mem
          mul_mem' := by
            rintro y₁ y₂ ⟨h₁, hp₁⟩ ⟨h₂, hp₂⟩
            have h₁₂ : δ_E (y₁ * y₂) ∈ E_cop := (map_mul δ_E y₁ y₂).symm ▸ E_cop.mul_mem h₁ h₂
            refine ⟨h₁₂, ?_⟩
            have h_eq : π₀ ⟨δ_E (y₁ * y₂), h₁₂⟩ = π₀ ⟨δ_E y₁, h₁⟩ * π₀ ⟨δ_E y₂, h₂⟩ :=
              (congrArg π₀ (Subtype.ext (map_mul δ_E y₁ y₂))).trans
                (map_mul π₀ ⟨δ_E y₁, h₁⟩ ⟨δ_E y₂, h₂⟩)
            exact h_eq.symm ▸ B_mod.mul_mem hp₁ hp₂
          inv_mem' := by
            rintro y ⟨h₁, hp₁⟩
            have h_inv : δ_E y⁻¹ ∈ E_cop := (map_inv δ_E y).symm ▸ E_cop.inv_mem h₁
            refine ⟨h_inv, ?_⟩
            have h_eq : π₀ ⟨δ_E y⁻¹, h_inv⟩ = (π₀ ⟨δ_E y, h₁⟩)⁻¹ :=
              (congrArg π₀ (Subtype.ext (map_inv δ_E y))).trans (map_inv π₀ ⟨δ_E y, h₁⟩)
            exact h_eq.symm ▸ B_mod.inv_mem hp₁ }
      have h_cob : E_cop ≤ H_cob := by
        rw [Subgroup.closure_le]
        rintro y ⟨c, hy_c, hc_cop⟩
        have hy_mem : y ∈ E_cop := Subgroup.subset_closure ⟨c, hy_c, hc_cop⟩
        have hτ_val : (τ_E y : E) = algebraMap R_E E (σ_int c) := by
          change σ (y : E) = algebraMap R_E E (σ_int c)
          rw [hy_c, ← algebraMap_galRestrict_apply R_F σ c]
        have hσc_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (σ_int c)}) m₀ := by
          dsimp [σ_int]
          rwa [h_intNorm_gal σ c]
        have hτ_mem : τ_E y ∈ E_cop := Subgroup.subset_closure ⟨σ_int c, hτ_val, hσc_cop⟩
        have h_δ : δ_E y ∈ E_cop := E_cop.div_mem hy_mem hτ_mem
        refine ⟨h_δ, ?_⟩
        have h_δ_eq : (((⟨δ_E y, h_δ⟩ : E_cop) : Eˣ) : E) * algebraMap R_E E (σ_int c) =
            algebraMap R_E E c := by
          have h_mul : δ_E y * τ_E y = y := div_mul_cancel y (τ_E y)
          have h_val := congrArg Units.val h_mul
          rw [Units.val_mul, hτ_val, hy_c] at h_val
          exact h_val
        obtain ⟨r, hr⟩ := h_inv_ex (σ_int c) hσc_cop
        let b : R_E := c * cof (σ_int c) * algebraMap R_F R_E r
        apply Subgroup.subset_closure
        refine ⟨b, c, hc_cop,
          h_clear_denom (π₀ ⟨δ_E y, h_δ⟩ : R_E ⧸ I₀) c (σ_int c) r
            (hπ₀_spec ⟨δ_E y, h_δ⟩ c (σ_int c) hc_cop hσc_cop h_δ_eq) hr, ?_⟩
        have h_inv_I₁ : Ideal.Quotient.mk I₁
            (σ_int c * (cof (σ_int c) * algebraMap R_F R_E r)) = 1 :=
          (Ideal.Quotient.eq.mpr (hI₀_le (h_inv_sub_mem (σ_int c) r hr))).trans
            (map_one (Ideal.Quotient.mk I₁))
        have h_ring : b * σ_int c =
            c * (σ_int c * (cof (σ_int c) * algebraMap R_F R_E r)) := by
          dsimp [b]
          ring
        calc
          Ideal.Quotient.mk I₁ (b * σ_int c)
              = Ideal.Quotient.mk I₁ (c * (σ_int c * (cof (σ_int c) * algebraMap R_F R_E r))) :=
              congrArg (Ideal.Quotient.mk I₁) h_ring
          _ = Ideal.Quotient.mk I₁ c *
                Ideal.Quotient.mk I₁ (σ_int c * (cof (σ_int c) * algebraMap R_F R_E r)) :=
              map_mul (Ideal.Quotient.mk I₁) c _
          _ = Ideal.Quotient.mk I₁ c * 1 := congrArg (Ideal.Quotient.mk I₁ c * ·) h_inv_I₁
          _ = Ideal.Quotient.mk I₁ c := mul_one _
      intro x hx_B
      obtain ⟨y, hy_E, hy_eq⟩ := Subgroup.mem_map.mp hx_B
      obtain ⟨h_δ, hp⟩ := h_cob hy_E
      have h_sub_eq : π₀ ⟨δ_E y, h_δ⟩ = π₀ x := congrArg π₀ (Subtype.ext hy_eq)
      exact h_sub_eq ▸ hp
    exact ⟨π₀, hπ₀_spec, hπ₀_K, hπ₀_B⟩

theorem speiser_resolvent_mul_galRestrict_eq_and_sub_mem_map {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₁ : Ideal (NumberField.RingOfIntegers F))
    (b₁ b₂ : NumberField.RingOfIntegers E)
    (h_norm_eq : Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₁ =
      Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₂) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    (b₁ - b₂ ∈ I₁ →
      ∃ W : R_E,
        b₁ * σ_int W = b₂ * W ∧
        W - (Module.finrank F E : R_E) * algebraMap R_F R_E (Algebra.intNorm R_F R_E b₂) ∈ I₁) ∧
    (b₁ ≠ 0 → b₂ ≠ 0 →
      ∃ W₀ : R_E,
        W₀ ≠ 0 ∧
        b₁ * σ_int W₀ = b₂ * W₀) :=
by
  intro R_F R_E σ_int I₁
  let d : ℕ := Module.finrank F E
  have hd_pos : 0 < d := Module.finrank_pos
  have h_card : Nat.card (E ≃ₐ[F] E) = d := IsGalois.card_aut_eq_finrank F E
  have h_ord : orderOf σ = d := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hCyclic, h_card]
  have hσ_pow_d : σ ^ d = 1 := by
    rw [← h_ord, pow_orderOf_eq_one]
  have hσ_int_pow_d : σ_int ^ d = 1 := by
    dsimp [σ_int]
    rw [← map_pow, hσ_pow_d, map_one]
  have hσ_int_d : ∀ x : R_E, (σ_int ^ d) x = x := by
    intro x
    rw [hσ_int_pow_d, AlgEquiv.one_apply]
  have hσ_int_succ : ∀ (k : ℕ) (x : R_E), σ_int ((σ_int ^ k) x) = (σ_int ^ (k + 1)) x := by
    intro k x
    rw [pow_succ', AlgEquiv.mul_apply]
  have h_bij : Function.Bijective (fun k : Fin d => σ ^ (k : ℕ)) := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨?_, ?_⟩
    · intro k₁ k₂ h_eq
      have hk₁ : (k₁ : ℕ) ∈ Set.Iio (orderOf σ) := by
        rw [Set.mem_Iio, h_ord]
        exact k₁.isLt
      have hk₂ : (k₂ : ℕ) ∈ Set.Iio (orderOf σ) := by
        rw [Set.mem_Iio, h_ord]
        exact k₂.isLt
      exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ h_eq)
    · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, h_card]
  let e_gal : Fin d ≃ (E ≃ₐ[F] E) := Equiv.ofBijective (fun k : Fin d => σ ^ (k : ℕ)) h_bij
  have h_norm_prod : ∀ b : R_E,
      algebraMap R_F R_E (Algebra.intNorm R_F R_E b) =
        ∏ i ∈ Finset.range d, (σ_int ^ i) b := by
    intro b
    apply IsIntegralClosure.algebraMap_injective R_E R_F E
    rw [← IsScalarTower.algebraMap_apply R_F R_E E,
      IsScalarTower.algebraMap_apply R_F F E,
      Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E),
      Algebra.norm_eq_prod_automorphisms,
      ← Equiv.prod_comp e_gal]
    have h_step : ∀ k : Fin d,
        (e_gal k) (algebraMap R_E E b) =
          algebraMap R_E E ((σ_int ^ (k : ℕ)) b) := by
      intro k
      change (σ ^ (k : ℕ)) (algebraMap R_E E b) = algebraMap R_E E ((σ_int ^ (k : ℕ)) b)
      rw [← algebraMap_galRestrict_apply R_F (σ ^ (k : ℕ)) b]
      congr 2
      exact map_pow (galRestrict R_F F E R_E) σ (k : ℕ)
    simp_rw [h_step]
    rw [← map_prod, Fin.prod_univ_eq_prod_range (fun i => (σ_int ^ i) b) d]
  let C : ℕ → R_E := fun j =>
    (∏ i ∈ Finset.range j, (σ_int ^ i) b₁) * (∏ i ∈ Finset.Ico j d, (σ_int ^ i) b₂)
  let W : R_E → R_E := fun θ =>
    ∑ j ∈ Finset.range d, ((σ_int ^ j) θ) * C j
  have hC0_prod : C 0 = ∏ i ∈ Finset.range d, (σ_int ^ i) b₂ := by
    dsimp [C]
    rw [one_mul, Nat.Ico_zero_eq_range]
  have hC0 : C 0 = algebraMap R_F R_E (Algebra.intNorm R_F R_E b₂) := by
    rw [hC0_prod, ← h_norm_prod b₂]
  have hCd : C d = C 0 := by
    rw [hC0]
    dsimp [C]
    rw [Finset.Ico_self, Finset.prod_empty, mul_one, ← h_norm_prod b₁, h_norm_eq]
  have hC_step : ∀ j : ℕ, j < d → b₁ * σ_int (C j) = b₂ * C (j + 1) := by
    intro j hj
    have h_pref : b₁ * σ_int (∏ i ∈ Finset.range j, (σ_int ^ i) b₁) =
        ∏ i ∈ Finset.range (j + 1), (σ_int ^ i) b₁ := by
      rw [map_prod]
      simp_rw [hσ_int_succ]
      rw [Finset.prod_range_succ' (fun i => (σ_int ^ i) b₁) j, pow_zero, AlgEquiv.one_apply, mul_comm]
    have h_suff : σ_int (∏ i ∈ Finset.Ico j d, (σ_int ^ i) b₂) =
        (∏ i ∈ Finset.Ico (j + 1) d, (σ_int ^ i) b₂) * b₂ := by
      rw [map_prod]
      simp_rw [hσ_int_succ]
      rw [Finset.prod_Ico_add' (fun i => (σ_int ^ i) b₂) j d 1,
        Finset.prod_Ico_succ_top (Nat.succ_le_of_lt hj) (fun i => (σ_int ^ i) b₂),
        hσ_int_d b₂]
    dsimp [C]
    rw [map_mul]
    calc
      b₁ * (σ_int (∏ i ∈ Finset.range j, (σ_int ^ i) b₁) *
          σ_int (∏ i ∈ Finset.Ico j d, (σ_int ^ i) b₂))
          = (b₁ * σ_int (∏ i ∈ Finset.range j, (σ_int ^ i) b₁)) *
              σ_int (∏ i ∈ Finset.Ico j d, (σ_int ^ i) b₂) := by ring
      _ = (∏ i ∈ Finset.range (j + 1), (σ_int ^ i) b₁) *
            ((∏ i ∈ Finset.Ico (j + 1) d, (σ_int ^ i) b₂) * b₂) := by rw [h_pref, h_suff]
      _ = b₂ * ((∏ i ∈ Finset.range (j + 1), (σ_int ^ i) b₁) *
            (∏ i ∈ Finset.Ico (j + 1) d, (σ_int ^ i) b₂)) := by ring
  have hW_eq : ∀ θ : R_E, b₁ * σ_int (W θ) = b₂ * W θ := by
    intro θ
    let f : ℕ → R_E := fun j => ((σ_int ^ j) θ) * C j
    have hf_step : ∀ j ∈ Finset.range d, b₁ * σ_int (f j) = b₂ * f (j + 1) := by
      intro j hj
      dsimp [f]
      rw [map_mul, hσ_int_succ j θ]
      calc
        b₁ * (((σ_int ^ (j + 1)) θ) * σ_int (C j))
            = ((σ_int ^ (j + 1)) θ) * (b₁ * σ_int (C j)) := by ring
        _ = ((σ_int ^ (j + 1)) θ) * (b₂ * C (j + 1)) := by
            rw [hC_step j (Finset.mem_range.mp hj)]
        _ = b₂ * (((σ_int ^ (j + 1)) θ) * C (j + 1)) := by ring
    have hf_d : f d = f 0 := by
      dsimp [f]
      rw [hσ_int_d θ, hCd, pow_zero, AlgEquiv.one_apply]
    have h_sum_shift : (∑ j ∈ Finset.range d, f (j + 1)) = ∑ j ∈ Finset.range d, f j := by
      have h1 := Finset.sum_range_succ f d
      have h2 := Finset.sum_range_succ' f d
      rw [h1, hf_d] at h2
      exact add_right_cancel h2.symm
    change b₁ * σ_int (∑ j ∈ Finset.range d, f j) = b₂ * (∑ j ∈ Finset.range d, f j)
    rw [map_sum, Finset.mul_sum, Finset.sum_congr rfl hf_step, ← Finset.mul_sum, h_sum_shift]
  refine ⟨?_, ?_⟩
  · intro hb_sub
    refine ⟨W 1, hW_eq 1, ?_⟩
    have h_mk_i : ∀ i : ℕ,
        Ideal.Quotient.mk I₁ ((σ_int ^ i) b₁) = Ideal.Quotient.mk I₁ ((σ_int ^ i) b₂) := by
      intro i
      let τ : R_E ≃ₐ[R_F] R_E := σ_int ^ i
      have h_comm : (τ : R_E →+* R_E).comp (algebraMap R_F R_E) = algebraMap R_F R_E := by
        apply RingHom.ext
        exact τ.commutes
      have h_map_I₁ : Ideal.map (τ : R_E →+* R_E) I₁ = I₁ := by
        dsimp [I₁]
        rw [Ideal.map_map, h_comm]
      have h_mem : τ (b₁ - b₂) ∈ I₁ := by
        rw [← h_map_I₁]
        exact Ideal.mem_map_of_mem (τ : R_E →+* R_E) hb_sub
      rw [map_sub] at h_mem
      exact Ideal.Quotient.eq.mpr h_mem
    have h_mk_C : ∀ j ∈ Finset.range d,
        Ideal.Quotient.mk I₁ (C j) = Ideal.Quotient.mk I₁ (C 0) := by
      intro j hj
      rw [hC0_prod]
      dsimp [C]
      rw [map_mul, map_prod, map_prod,
        Finset.prod_congr rfl (fun i _ => h_mk_i i),
        Finset.prod_range_mul_prod_Ico _ (Finset.mem_range.mp hj).le,
        ← map_prod]
    have h_mk_W1 : Ideal.Quotient.mk I₁ (W 1) =
        Ideal.Quotient.mk I₁ ((d : R_E) * algebraMap R_F R_E (Algebra.intNorm R_F R_E b₂)) := by
      dsimp [W]
      rw [map_sum]
      have h_term : ∀ j ∈ Finset.range d,
          Ideal.Quotient.mk I₁ (((σ_int ^ j) 1) * C j) = Ideal.Quotient.mk I₁ (C 0) := by
        intro j hj
        rw [map_one, one_mul, h_mk_C j hj]
      rw [Finset.sum_congr rfl h_term, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul, ← map_natCast (Ideal.Quotient.mk I₁) d, ← map_mul, hC0]
    exact Ideal.Quotient.eq.mp h_mk_W1
  · intro hb₁_ne hb₂_ne
    have h_ex_θ : ∃ θ : R_E, W θ ≠ 0 := by
      by_contra h_all_zero
      push_neg at h_all_zero
      have hC0_ne : C 0 ≠ 0 := by
        rw [hC0_prod]
        apply Finset.prod_ne_zero_iff.mpr
        intro i _
        exact (map_ne_zero_iff (σ_int ^ i) (σ_int ^ i).injective).mpr hb₂_ne
      let ψ : Fin d → (R_E →ₐ[R_F] R_E) := fun j => AlgEquiv.toAlgHom (σ_int ^ (j : ℕ))
      have hψ_inj : Function.Injective ψ := by
        intro j₁ j₂ hj
        have h_eq_int : σ_int ^ (j₁ : ℕ) = σ_int ^ (j₂ : ℕ) :=
          AlgEquiv.coe_algHom_injective hj
        have h_eq_σ : σ ^ (j₁ : ℕ) = σ ^ (j₂ : ℕ) := by
          apply (galRestrict R_F F E R_E).injective
          change (galRestrict R_F F E R_E) (σ ^ (j₁ : ℕ)) = (galRestrict R_F F E R_E) (σ ^ (j₂ : ℕ))
          rw [map_pow, map_pow]
          exact h_eq_int
        exact h_bij.1 h_eq_σ
      have h_lin : LinearIndependent R_E (fun j : Fin d => (ψ j).toLinearMap) :=
        (linearIndependent_algHom_toLinearMap R_F R_E R_E).comp ψ hψ_inj
      let g : Fin d → R_E := fun j => C (j : ℕ)
      have h_sum : ∑ j : Fin d, g j • (ψ j).toLinearMap = 0 := by
        apply LinearMap.ext
        intro θ
        rw [LinearMap.sum_apply, LinearMap.zero_apply]
        have h_eval : ∀ j : Fin d,
            (g j • (ψ j).toLinearMap) θ = ((σ_int ^ (j : ℕ)) θ) * C (j : ℕ) := by
          intro j
          rw [LinearMap.smul_apply, smul_eq_mul, AlgHom.toLinearMap_apply]
          dsimp [g, ψ]
          rw [mul_comm]
        simp_rw [h_eval]
        rw [Fin.sum_univ_eq_sum_range (fun j => ((σ_int ^ j) θ) * C j) d]
        exact h_all_zero θ
      have h_g0 : g ⟨0, hd_pos⟩ = 0 :=
        Fintype.linearIndependent_iff.mp h_lin g h_sum ⟨0, hd_pos⟩
      exact hC0_ne h_g0
    rcases h_ex_θ with ⟨θ, hθ_ne⟩
    exact ⟨W θ, hθ_ne, hW_eq θ⟩

theorem exists_coprime_coboundary_of_speiser_congruence {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (D_ram J_d m₂ m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (t₀ : NumberField.RingOfIntegers F)
    (hm₀_ne : m₀ ≠ ⊥)
    (h_span_d : Ideal.span {(Module.finrank F E : NumberField.RingOfIntegers F)} = D_ram * J_d)
    (hm₁_eq : m₁ = D_ram * m₂)
    (hm₀_eq : m₀ = D_ram * m₁)
    (h_dvd : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      (q.asIdeal ∣ m₂ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ m₁ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ D_ram → q.asIdeal ∣ m₀))
    (ht₀_mem : t₀ ∈ J_d)
    (ht₀_sub : t₀ - 1 ∈ m₀)
    (b₁ b₂ W : NumberField.RingOfIntegers E)
    (hb₂_cop : IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₂}) m₀)
    (hW_eq : b₁ * galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ W = b₂ * W)
    (hW_sub : W - (Module.finrank F E : NumberField.RingOfIntegers E) *
      algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)
        (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₂) ∈
      Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) m₁) :
    ∃ w : NumberField.RingOfIntegers E,
      IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) w}) m₀ ∧
      b₁ * galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ w = b₂ * w :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let d : ℕ := Module.finrank F E
  let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
  let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
  let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
  let z : R_E := W - (d : R_E) * algebraMap R_F R_E (Algebra.intNorm R_F R_E b₂)
  have ht₀_le : Ideal.span {t₀} ≤ J_d := (Ideal.span_singleton_le_iff_mem J_d).mpr ht₀_mem
  have h_mul_le : Ideal.span {t₀} * m₁ ≤ Ideal.span {(d : R_F)} * m₂ := by
    calc
      Ideal.span {t₀} * m₁ ≤ J_d * m₁ := Ideal.mul_mono_left ht₀_le
      _ = J_d * (D_ram * m₂) := by rw [hm₁_eq]
      _ = (D_ram * J_d) * m₂ := by rw [← mul_assoc, mul_comm J_d D_ram]
      _ = Ideal.span {(d : R_F)} * m₂ := by rw [← h_span_d]
  have h_map_le : Ideal.span {algebraMap R_F R_E t₀} * I₁ ≤ Ideal.span {(d : R_E)} * I₂ := by
    have h1 := Ideal.map_mono (f := algebraMap R_F R_E) h_mul_le
    simpa only [Ideal.map_mul, Ideal.map_span, Set.image_singleton, map_natCast] using h1
  have h_tz_mem : algebraMap R_F R_E t₀ * z ∈ Ideal.span {(d : R_E)} * I₂ :=
    h_map_le (Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hW_sub)
  obtain ⟨u₂, hu₂_mem, hu₂_eq⟩ := Ideal.mem_span_singleton_mul.mp h_tz_mem
  let a₂ : R_F := t₀ * Algebra.intNorm R_F R_E b₂
  let w : R_E := algebraMap R_F R_E a₂ + u₂
  have hdw : (d : R_E) * w = algebraMap R_F R_E t₀ * W := by
    calc
      (d : R_E) * w = (d : R_E) * algebraMap R_F R_E a₂ + (d : R_E) * u₂ := mul_add _ _ _
      _ = (d : R_E) * algebraMap R_F R_E (t₀ * Algebra.intNorm R_F R_E b₂) +
            algebraMap R_F R_E t₀ * z := by rw [hu₂_eq]
      _ = algebraMap R_F R_E t₀ *
            ((d : R_E) * algebraMap R_F R_E (Algebra.intNorm R_F R_E b₂) + z) := by
          rw [map_mul]
          ring
      _ = algebraMap R_F R_E t₀ * W := by
          dsimp [z]
          rw [add_sub_cancel]
  have hd_σw : (d : R_E) * σ_int w = algebraMap R_F R_E t₀ * σ_int W := by
    calc
      (d : R_E) * σ_int w = σ_int ((d : R_E) * w) := by rw [map_mul, map_natCast]
      _ = σ_int (algebraMap R_F R_E t₀ * W) := by rw [hdw]
      _ = algebraMap R_F R_E t₀ * σ_int W := by rw [map_mul, σ_int.commutes t₀]
  have hd_bw : (d : R_E) * (b₁ * σ_int w) = (d : R_E) * (b₂ * w) := by
    calc
      (d : R_E) * (b₁ * σ_int w) = b₁ * ((d : R_E) * σ_int w) := by ring
      _ = b₁ * (algebraMap R_F R_E t₀ * σ_int W) := by rw [hd_σw]
      _ = algebraMap R_F R_E t₀ * (b₁ * σ_int W) := by ring
      _ = algebraMap R_F R_E t₀ * (b₂ * W) := by rw [hW_eq]
      _ = b₂ * (algebraMap R_F R_E t₀ * W) := by ring
      _ = b₂ * ((d : R_E) * w) := by rw [← hdw]
      _ = (d : R_E) * (b₂ * w) := by ring
  have hd_pos : 0 < d := Module.finrank_pos
  have hd_ne : (d : R_E) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
  have hw_eq : b₁ * σ_int w = b₂ * w := mul_left_cancel₀ hd_ne hd_bw
  have hm₂_ne : m₂ ≠ ⊥ := by
    intro hm₂_bot
    apply hm₀_ne
    rw [hm₀_eq, hm₁_eq, hm₂_bot, Ideal.mul_bot, Ideal.mul_bot]
  have h_cop_of_dvd : ∀ (I J : Ideal R_F), I ≠ ⊥ →
      (∀ q : IsDedekindDomain.HeightOneSpectrum R_F, q.asIdeal ∣ I → q.asIdeal ∣ J) →
      ∀ A : Ideal R_F, IsCoprime A J → IsCoprime A I := by
    intro I J hI_ne hIJ A hAJ
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    obtain ⟨M, hM_max, h_le_M⟩ := Ideal.exists_le_maximal (A ⊔ I) h_ne_top
    have hA_le : A ≤ M := le_sup_left.trans h_le_M
    have hI_le : I ≤ M := le_sup_right.trans h_le_M
    have hM_ne_bot : M ≠ ⊥ := by
      intro hM_bot
      apply hI_ne
      exact le_bot_iff.mp (hM_bot ▸ hI_le)
    let q_M : IsDedekindDomain.HeightOneSpectrum R_F := ⟨M, hM_max.isPrime, hM_ne_bot⟩
    have hq_I : q_M.asIdeal ∣ I := Ideal.dvd_iff_le.mpr hI_le
    have hq_J : q_M.asIdeal ∣ J := hIJ q_M hq_I
    have hJ_le : J ≤ M := Ideal.dvd_iff_le.mp hq_J
    have h_top_le : ⊤ ≤ M := by
      rw [← Ideal.isCoprime_iff_sup_eq.mp hAJ]
      exact sup_le hA_le hJ_le
    exact hM_max.ne_top (top_le_iff.mp h_top_le)
  have h_cop_m₀_to_m₂ : ∀ A : Ideal R_F, IsCoprime A m₀ → IsCoprime A m₂ :=
    h_cop_of_dvd m₂ m₀ hm₂_ne (fun q => (h_dvd q).1.mp)
  have h_cop_m₂_to_m₀ : ∀ A : Ideal R_F, IsCoprime A m₂ → IsCoprime A m₀ :=
    h_cop_of_dvd m₀ m₂ hm₀_ne (fun q => (h_dvd q).1.mpr)
  have ht₀_cop : IsCoprime (Ideal.span {t₀}) m₀ := by
    rw [Ideal.isCoprime_iff_exists]
    refine ⟨t₀, Ideal.mem_span_singleton_self t₀, -(t₀ - 1), neg_mem ht₀_sub, by ring⟩
  have ha₂_cop : IsCoprime (Ideal.span {a₂}) m₀ := by
    dsimp [a₂]
    rw [← Ideal.span_singleton_mul_span_singleton]
    exact IsCoprime.mul_left ht₀_cop hb₂_cop
  let n_G : ℕ := Fintype.card (E ≃ₐ[F] E)
  have ha₂_pow_cop_m₀ : IsCoprime (Ideal.span {a₂ ^ n_G}) m₀ := by
    rw [← Ideal.span_singleton_pow]
    exact ha₂_cop.pow_left
  have ha₂_pow_cop : IsCoprime (Ideal.span {a₂ ^ n_G}) m₂ :=
    h_cop_m₀_to_m₂ _ ha₂_pow_cop_m₀
  have hρ_mk : ∀ ρ : E ≃ₐ[F] E,
      Ideal.Quotient.mk I₂ (galRestrict R_F F E R_E ρ w) =
        Ideal.Quotient.mk I₂ (algebraMap R_F R_E a₂) := by
    intro ρ
    let ρ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E ρ
    have h_comp : (ρ_int : R_E →+* R_E).comp (algebraMap R_F R_E) = algebraMap R_F R_E :=
      RingHom.ext ρ_int.commutes
    have h_map_I₂ : Ideal.map (ρ_int : R_E →+* R_E) I₂ = I₂ := by
      dsimp [I₂]
      rw [Ideal.map_map, h_comp]
    have h_ρu₂ : ρ_int u₂ ∈ I₂ := by
      rw [← h_map_I₂]
      exact Ideal.mem_map_of_mem (ρ_int : R_E →+* R_E) hu₂_mem
    apply Ideal.Quotient.eq.mpr
    have h_sub : ρ_int w - algebraMap R_F R_E a₂ = ρ_int u₂ := by
      dsimp [w]
      rw [map_add, ρ_int.commutes a₂, add_sub_cancel_left]
    rw [h_sub]
    exact h_ρu₂
  have h_prod_norm :
      (∏ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ w) =
        algebraMap R_F R_E (Algebra.intNorm R_F R_E w) := by
    apply IsIntegralClosure.algebraMap_injective R_E R_F E
    rw [map_prod, ← IsScalarTower.algebraMap_apply R_F R_E E,
      IsScalarTower.algebraMap_apply R_F F E,
      Algebra.algebraMap_intNorm (L := E),
      Algebra.norm_eq_prod_automorphisms F (algebraMap R_E E w)]
    refine Finset.prod_congr rfl (fun ρ _ => ?_)
    exact algebraMap_galRestrict_apply R_F ρ w
  have h_mk_norm :
      Ideal.Quotient.mk I₂ (algebraMap R_F R_E (a₂ ^ n_G)) =
        Ideal.Quotient.mk I₂ (algebraMap R_F R_E (Algebra.intNorm R_F R_E w)) := by
    calc
      Ideal.Quotient.mk I₂ (algebraMap R_F R_E (a₂ ^ n_G))
          = (Ideal.Quotient.mk I₂ (algebraMap R_F R_E a₂)) ^ n_G := by
          rw [map_pow, map_pow]
      _ = ∏ _ρ : E ≃ₐ[F] E, Ideal.Quotient.mk I₂ (algebraMap R_F R_E a₂) := by
          rw [Finset.prod_const, Finset.card_univ]
      _ = ∏ ρ : E ≃ₐ[F] E, Ideal.Quotient.mk I₂ (galRestrict R_F F E R_E ρ w) := by
          refine Finset.prod_congr rfl (fun ρ _ => (hρ_mk ρ).symm)
      _ = Ideal.Quotient.mk I₂ (∏ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ w) := by
          rw [map_prod]
      _ = Ideal.Quotient.mk I₂ (algebraMap R_F R_E (Algebra.intNorm R_F R_E w)) := by
          rw [h_prod_norm]
  have h_norm_diff :
      algebraMap R_F R_E (a₂ ^ n_G) - algebraMap R_F R_E (Algebra.intNorm R_F R_E w) ∈ I₂ :=
    Ideal.Quotient.eq.mp h_mk_norm
  let J : Ideal R_F := Ideal.span {Algebra.intNorm R_F R_E w} ⊔ m₂
  let J_E : Ideal R_E := Ideal.map (algebraMap R_F R_E) J
  have hJ_E : J_E = Ideal.span {algebraMap R_F R_E (Algebra.intNorm R_F R_E w)} ⊔ I₂ := by
    dsimp [J_E, J, I₂]
    rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton]
  have ha₂_top : Ideal.span {algebraMap R_F R_E (a₂ ^ n_G)} ⊔ I₂ = ⊤ := by
    have h1 := congrArg (Ideal.map (algebraMap R_F R_E)) (Ideal.isCoprime_iff_sup_eq.mp ha₂_pow_cop)
    simpa only [Ideal.map_sup, Ideal.map_span, Set.image_singleton, Ideal.map_top] using h1
  have h_nw_mem : algebraMap R_F R_E (Algebra.intNorm R_F R_E w) ∈ J_E := by
    rw [hJ_E]
    exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  have h_diff_mem :
      algebraMap R_F R_E (a₂ ^ n_G) - algebraMap R_F R_E (Algebra.intNorm R_F R_E w) ∈ J_E := by
    rw [hJ_E]
    exact Ideal.mem_sup_right h_norm_diff
  have ha₂_mem_JE : algebraMap R_F R_E (a₂ ^ n_G) ∈ J_E := by
    have h_add := add_mem h_diff_mem h_nw_mem
    rwa [sub_add_cancel] at h_add
  have hJ_E_top : Ideal.map (algebraMap R_F R_E) J = ⊤ := by
    change J_E = ⊤
    rw [← top_le_iff, ← ha₂_top]
    refine sup_le ((Ideal.span_singleton_le_iff_mem J_E).mpr ha₂_mem_JE) ?_
    rw [hJ_E]
    exact le_sup_right
  have hJ_top : J = ⊤ := by
    have h_rel := congrArg (Ideal.relNorm R_F) hJ_E_top
    rw [Ideal.relNorm_algebraMap R_E J, ← Ideal.one_eq_top, map_one, Ideal.one_eq_top] at h_rel
    rw [← top_le_iff, ← h_rel]
    apply Ideal.pow_le_self
    intro hd'0
    have h_bot := Ideal.relNorm_algebraMap R_E (⊥ : Ideal R_F)
    rw [Ideal.map_bot, ← Submodule.zero_eq_bot, map_zero, Submodule.zero_eq_bot,
      hd'0, pow_zero, Ideal.one_eq_top] at h_bot
    exact bot_ne_top h_bot
  have hw_cop_m₂ : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E w}) m₂ :=
    Ideal.isCoprime_iff_sup_eq.mpr hJ_top
  have hw_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E w}) m₀ :=
    h_cop_m₂_to_m₀ _ hw_cop_m₂
  exact ⟨w, hw_cop, hw_eq⟩

theorem coprime_norm_one_quotient_le_mod_unit_cohomology_image {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (D_ram J_d m₂ m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (t₀ : NumberField.RingOfIntegers F)
    (hm₀_ne : m₀ ≠ ⊥)
    (h_span_d : Ideal.span {(Module.finrank F E : NumberField.RingOfIntegers F)} = D_ram * J_d)
    (hm₁_eq : m₁ = D_ram * m₂)
    (hm₀_eq : m₀ = D_ram * m₁)
    (h_dvd : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      (q.asIdeal ∣ m₂ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ m₁ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ D_ram → q.asIdeal ∣ m₀))
    (ht₀_mem : t₀ ∈ J_d)
    (ht₀_sub : t₀ - 1 ∈ m₀) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
      ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
    let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
    let B_cop : Subgroup Eˣ :=
      Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
    let K_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b : R_E,
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) = 1 }
    let B_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b c : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk I₁ (b * galRestrict R_F F E R_E σ c) =
          Ideal.Quotient.mk I₁ c }
    Nat.card (K_cop ⧸ B_cop.subgroupOf K_cop) ≤
      Nat.card (K_mod ⧸ B_mod.subgroupOf K_mod) :=
by
  intro R_F R_E I₁ I₀ E_cop K_cop B_cop K_mod B_mod
  let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
  have hm₀_le : m₀ ≤ m₁ := hm₀_eq.trans_le Ideal.mul_le_left
  have hI₀_le : I₀ ≤ I₁ := Ideal.map_mono hm₀_le
  obtain ⟨hK_cop_rep, hB_cop_mem, hB_mod_rep⟩ :=
    coprime_norm_closure_characterizations_and_mod_coboundary_mem σ m₁ m₀ hm₀_le
  obtain ⟨hFin_mod, π₀, hπ₀_spec, hπ₀_K, hπ₀_B⟩ :=
    exists_mod_unit_hom_of_coprime_norm_one σ m₁ m₀ hm₀_ne hm₀_le
  let π_K : K_cop →* K_mod :=
    { toFun := fun x => ⟨π₀ ⟨x.1, x.2.1⟩, hπ₀_K ⟨x.1, x.2.1⟩ x.2⟩
      map_one' := Subtype.ext (map_one π₀)
      map_mul' := fun x y => Subtype.ext (map_mul π₀ ⟨x.1, x.2.1⟩ ⟨y.1, y.2.1⟩) }
  let φ : K_cop →* K_mod ⧸ B_mod.subgroupOf K_mod :=
    (QuotientGroup.mk' (B_mod.subgroupOf K_mod)).comp π_K
  have hφ_ker : ∀ x ∈ B_cop.subgroupOf K_cop, x ∈ φ.ker := by
    intro x hx
    rw [MonoidHom.mem_ker]
    change QuotientGroup.mk (π_K x) = 1
    rw [QuotientGroup.eq_one_iff]
    exact hπ₀_B ⟨x.1, x.2.1⟩ hx
  let π_bar : K_cop ⧸ B_cop.subgroupOf K_cop →* K_mod ⧸ B_mod.subgroupOf K_mod :=
    QuotientGroup.lift (B_cop.subgroupOf K_cop) φ hφ_ker
  have hπ_bar_inj : Function.Injective π_bar := by
    rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
    intro q hq
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    rw [MonoidHom.mem_ker] at hq
    change QuotientGroup.mk (π_K x) = 1 at hq
    have h_in_B_mod : π₀ ⟨x.1, x.2.1⟩ ∈ B_mod := (QuotientGroup.eq_one_iff (π_K x)).mp hq
    rw [QuotientGroup.eq_one_iff]
    change x.1 ∈ B_cop
    obtain ⟨a₁, a₂, ha₁_ne, ha₂_ne, ha₁_cop, ha₂_cop, h_norm_a, hx_eq⟩ :=
      hK_cop_rep x.1 x.2
    have h_cobound_of_eq : ∀ y : R_E,
        a₁ * σ_int y = a₂ * y →
        (x.1 : E) * σ (algebraMap R_E E y) = algebraMap R_E E y := by
      intro y hy_eq
      have ha₂_E_ne : algebraMap R_E E a₂ ≠ 0 :=
        (map_ne_zero_iff (algebraMap R_E E) (FaithfulSMul.algebraMap_injective R_E E)).mpr ha₂_ne
      have h_map := congrArg (algebraMap R_E E) hy_eq
      rw [map_mul, map_mul, algebraMap_galRestrict_apply R_F σ y, ← hx_eq] at h_map
      apply mul_left_cancel₀ ha₂_E_ne
      calc
        algebraMap R_E E a₂ * ((x.1 : E) * σ (algebraMap R_E E y))
            = ((x.1 : E) * algebraMap R_E E a₂) * σ (algebraMap R_E E y) := by ring
        _ = algebraMap R_E E a₂ * algebraMap R_E E y := h_map
    by_cases hm₀_top : m₀ = ⊤
    · obtain ⟨W₀, hW₀_ne, hW₀_eq⟩ :=
        (speiser_resolvent_mul_galRestrict_eq_and_sub_mem_map σ hCyclic m₁ a₁ a₂ h_norm_a).2
          ha₁_ne ha₂_ne
      have hW₀_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E W₀}) m₀ := by
        rw [Ideal.isCoprime_iff_sup_eq, hm₀_top, sup_top_eq]
      exact hB_cop_mem x.1 ⟨W₀, hW₀_ne, hW₀_cop, h_cobound_of_eq W₀ hW₀_eq⟩
    · have h_norm_zero : Algebra.intNorm R_F R_E 0 = 0 := by
        apply FaithfulSMul.algebraMap_injective R_F F
        rw [Algebra.algebraMap_intNorm (L := E), map_zero, Algebra.norm_zero, map_zero]
      have h_ne_zero_of_cop : ∀ y : R_E,
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E y}) m₀ → y ≠ 0 := by
        intro y hy_cop hy0
        apply hm₀_top
        have h_sup : Ideal.span {Algebra.intNorm R_F R_E y} ⊔ m₀ = ⊤ :=
          Ideal.isCoprime_iff_sup_eq.mp hy_cop
        rw [hy0, h_norm_zero, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq] at h_sup
        exact h_sup
      obtain ⟨b, c, hc_cop, hπ_b, hbc_I₁⟩ := hB_mod_rep (π₀ ⟨x.1, x.2.1⟩) h_in_B_mod
      have hc_ne : c ≠ 0 := h_ne_zero_of_cop c hc_cop
      let b₁ : R_E := a₁ * σ_int c
      let b₂ : R_E := a₂ * c
      have h_norm_σc : Algebra.intNorm R_F R_E (σ_int c) = Algebra.intNorm R_F R_E c := by
        apply FaithfulSMul.algebraMap_injective R_F F
        rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
          algebraMap_galRestrict_apply R_F σ c, Algebra.norm_eq_of_algEquiv σ]
      have h_norm_b : Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ := by
        dsimp [b₁, b₂]
        rw [map_mul, map_mul, h_norm_a, h_norm_σc]
      have hb₂_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ := by
        dsimp [b₂]
        rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
        exact IsCoprime.mul_left ha₂_cop hc_cop
      have hb_sub : b₁ - b₂ ∈ I₁ := by
        have h_mk₀ := hπ₀_spec ⟨x.1, x.2.1⟩ a₁ a₂ ha₁_cop ha₂_cop hx_eq
        rw [hπ_b, ← map_mul] at h_mk₀
        have h_mem₀ : b * a₂ - a₁ ∈ I₀ := Ideal.Quotient.eq.mp h_mk₀
        have h_mk₁ : Ideal.Quotient.mk I₁ (b * a₂) = Ideal.Quotient.mk I₁ a₁ :=
          Ideal.Quotient.eq.mpr (hI₀_le h_mem₀)
        have h_b₁_b₂ : Ideal.Quotient.mk I₁ b₁ = Ideal.Quotient.mk I₁ b₂ := by
          dsimp [b₁, b₂]
          calc
            Ideal.Quotient.mk I₁ (a₁ * σ_int c)
                = Ideal.Quotient.mk I₁ a₁ * Ideal.Quotient.mk I₁ (σ_int c) := map_mul _ _ _
            _ = Ideal.Quotient.mk I₁ (b * a₂) * Ideal.Quotient.mk I₁ (σ_int c) := by rw [← h_mk₁]
            _ = Ideal.Quotient.mk I₁ a₂ * Ideal.Quotient.mk I₁ (b * σ_int c) := by
                rw [← map_mul, ← map_mul]
                congr 1
                ring
            _ = Ideal.Quotient.mk I₁ a₂ * Ideal.Quotient.mk I₁ c := by rw [hbc_I₁]
            _ = Ideal.Quotient.mk I₁ (a₂ * c) := (map_mul _ _ _).symm
        exact Ideal.Quotient.eq.mp h_b₁_b₂
      obtain ⟨W, hW_eq, hW_sub⟩ :=
        (speiser_resolvent_mul_galRestrict_eq_and_sub_mem_map σ hCyclic m₁ b₁ b₂ h_norm_b).1 hb_sub
      obtain ⟨w, hw_cop, hw_eq⟩ :=
        exists_coprime_coboundary_of_speiser_congruence
          σ D_ram J_d m₂ m₁ m₀ t₀ hm₀_ne h_span_d hm₁_eq hm₀_eq h_dvd ht₀_mem ht₀_sub
          b₁ b₂ W hb₂_cop hW_eq hW_sub
      have hw_ne : w ≠ 0 := h_ne_zero_of_cop w hw_cop
      let w' : R_E := c * w
      have hw'_ne : w' ≠ 0 := mul_ne_zero hc_ne hw_ne
      have hw'_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E w'}) m₀ := by
        dsimp [w']
        rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
        exact IsCoprime.mul_left hc_cop hw_cop
      have hw'_eq : a₁ * σ_int w' = a₂ * w' := by
        dsimp [w']
        calc
          a₁ * σ_int (c * w) = a₁ * (σ_int c * σ_int w) := by rw [map_mul]
          _ = b₁ * σ_int w := by dsimp [b₁]; ring
          _ = b₂ * w := hw_eq
          _ = a₂ * (c * w) := by dsimp [b₂]; ring
      exact hB_cop_mem x.1 ⟨w', hw'_ne, hw'_cop, h_cobound_of_eq w' hw'_eq⟩
  haveI : Finite (K_mod ⧸ B_mod.subgroupOf K_mod) := hFin_mod
  exact Nat.card_le_card_of_injective π_bar hπ_bar_inj

theorem quotient_algebraMap_injective_and_base_unit_card_eq {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E]
    (m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₁_ne : m₁ ≠ ⊥)
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_le : m₀ ≤ m₁)
    (hm₁_sq : m₁ ^ 2 ≤ m₀) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let ι_R₀ : R_F ⧸ m₀ →+* R_E ⧸ I₀ :=
      Ideal.quotientMap I₀ (algebraMap R_F R_E) Ideal.le_comap_map
    let ι_R₁ : R_F ⧸ m₁ →+* R_E ⧸ I₁ :=
      Ideal.quotientMap I₁ (algebraMap R_F R_E) Ideal.le_comap_map
    let F_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
      ∃ a : R_F,
        (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
    let U_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ a ∈ m₁,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (1 + a) }
    Finite (R_F ⧸ m₀) ∧
    Finite (R_E ⧸ I₀) ∧
    Finite (R_E ⧸ I₁) ∧
    Function.Injective ι_R₀ ∧
    Function.Injective ι_R₁ ∧
    (∀ x : R_F ⧸ m₀, IsUnit (ι_R₀ x) ↔ IsUnit x) ∧
    Nat.card (R_F ⧸ m₀)ˣ = Nat.card F_fix * Nat.card U_ker :=
by
  classical
  intro R_F R_E I₁ I₀ ι_R₀ ι_R₁ F_fix U_ker
  have hinj : Function.Injective (algebraMap R_F R_E) :=
    FaithfulSMul.algebraMap_injective R_F R_E
  have hI₁_ne : I₁ ≠ ⊥ := (Ideal.map_eq_bot_iff_of_injective hinj).not.mpr hm₁_ne
  have hI₀_ne : I₀ ≠ ⊥ := (Ideal.map_eq_bot_iff_of_injective hinj).not.mpr hm₀_ne
  have hFin_F₀ : Finite (R_F ⧸ m₀) := Ideal.finiteQuotientOfFreeOfNeBot m₀ hm₀_ne
  have hFin_F₁ : Finite (R_F ⧸ m₁) := Ideal.finiteQuotientOfFreeOfNeBot m₁ hm₁_ne
  have hFin_E₀ : Finite (R_E ⧸ I₀) := Ideal.finiteQuotientOfFreeOfNeBot I₀ hI₀_ne
  have hFin_E₁ : Finite (R_E ⧸ I₁) := Ideal.finiteQuotientOfFreeOfNeBot I₁ hI₁_ne
  haveI : Finite (R_F ⧸ m₀) := hFin_F₀
  haveI : Finite (R_F ⧸ m₁) := hFin_F₁
  haveI : Finite (R_E ⧸ I₀) := hFin_E₀
  haveI : Finite (R_E ⧸ I₁) := hFin_E₁
  have h_map_inj : ∀ A₁ A₂ : Ideal R_F,
      A₁ ≠ ⊥ → A₂ ≠ ⊥ →
      Ideal.map (algebraMap R_F R_E) A₁ = Ideal.map (algebraMap R_F R_E) A₂ →
      A₁ = A₂ := by
    intro A₁ A₂ hA₁ hA₂ hmap
    have h_bot := Ideal.relNorm_algebraMap R_E (⊥ : Ideal R_F)
    rw [Ideal.map_bot, ← Submodule.zero_eq_bot, map_zero, Submodule.zero_eq_bot] at h_bot
    have hrel := congrArg (Ideal.relNorm R_F) hmap
    rw [Ideal.relNorm_algebraMap R_E A₁, Ideal.relNorm_algebraMap R_E A₂] at hrel
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hrel
    rw [UniqueFactorizationMonoid.normalizedFactors_pow,
      UniqueFactorizationMonoid.normalizedFactors_pow] at hnf
    have hnf_eq : UniqueFactorizationMonoid.normalizedFactors A₁ =
        UniqueFactorizationMonoid.normalizedFactors A₂ := by
      ext P
      have hcnt := congrArg (Multiset.count P) hnf
      rw [Multiset.count_nsmul, Multiset.count_nsmul] at hcnt
      refine Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero fun hd0 => ?_) hcnt
      rw [hd0, pow_zero, Ideal.one_eq_top] at h_bot
      exact bot_ne_top h_bot
    rw [← prod_normalizedFactors_eq_self hA₁, ← prod_normalizedFactors_eq_self hA₂, hnf_eq]
  have h_comap_le : ∀ m : Ideal R_F, m ≠ ⊥ →
      Ideal.comap (algebraMap R_F R_E) (Ideal.map (algebraMap R_F R_E) m) ≤ m := by
    intro m hm a ha
    rw [Ideal.mem_comap] at ha
    let A₁ : Ideal R_F := m ⊔ Ideal.span {a}
    have hA₁_ne : A₁ ≠ ⊥ := by
      intro h_bot
      exact hm (le_bot_iff.mp (h_bot ▸ le_sup_left))
    have h_map_eq : Ideal.map (algebraMap R_F R_E) A₁ = Ideal.map (algebraMap R_F R_E) m := by
      dsimp [A₁]
      rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton, sup_eq_left,
        Ideal.span_singleton_le_iff_mem]
      exact ha
    have hA₁_eq : A₁ = m := h_map_inj A₁ m hA₁_ne hm h_map_eq
    have ha_mem_A₁ : a ∈ A₁ :=
      (le_sup_right : Ideal.span {a} ≤ A₁) (Ideal.mem_span_singleton_self a)
    rwa [hA₁_eq] at ha_mem_A₁
  have hι₀_inj : Function.Injective ι_R₀ :=
    Ideal.quotientMap_injective' (h_comap_le m₀ hm₀_ne)
  have hι₁_inj : Function.Injective ι_R₁ :=
    Ideal.quotientMap_injective' (h_comap_le m₁ hm₁_ne)
  have h_unit_reflect : ∀ {A B : Type u} [CommRing A] [Finite A] [CommRing B]
      (f : A →+* B), Function.Injective f → ∀ x : A, IsUnit (f x) ↔ IsUnit x := by
    intro A B _ _ _ f hf x
    constructor
    · rintro ⟨u, hu⟩
      have hL_inj : Function.Injective (fun y : A => x * y) := by
        intro y₁ y₂ h₁₂
        have hf₁₂ : f (x * y₁) = f (x * y₂) := congrArg f h₁₂
        rw [map_mul, map_mul, ← hu] at hf₁₂
        have hu₁₂ := congrArg ((↑u⁻¹ : B) * ·) hf₁₂
        dsimp only at hu₁₂
        rw [Units.inv_mul_cancel_left, Units.inv_mul_cancel_left] at hu₁₂
        exact hf hu₁₂
      obtain ⟨y, hy⟩ := Finite.surjective_of_injective hL_inj 1
      exact isUnit_iff_exists_inv.mpr ⟨y, hy⟩
    · intro hx
      exact hx.map f
  have hι₀_unit : ∀ x : R_F ⧸ m₀, IsUnit (ι_R₀ x) ↔ IsUnit x :=
    h_unit_reflect ι_R₀ hι₀_inj
  have hι₁_unit : ∀ x : R_F ⧸ m₁, IsUnit (ι_R₁ x) ↔ IsUnit x :=
    h_unit_reflect ι_R₁ hι₁_inj
  let π_R : R_F ⧸ m₀ →+* R_F ⧸ m₁ := Ideal.Quotient.factor hm₀_le
  let ψ₀₁ : (R_F ⧸ m₀)ˣ →* (R_E ⧸ I₁)ˣ :=
    Units.map (ι_R₁.comp π_R).toMonoidHom
  have hψ_mk : ∀ a : R_F,
      (ι_R₁.comp π_R) (Ideal.Quotient.mk m₀ a) =
        Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) := by
    intro a
    change ι_R₁ (Ideal.Quotient.factor hm₀_le (Ideal.Quotient.mk m₀ a)) =
      Ideal.Quotient.mk I₁ (algebraMap R_F R_E a)
    rw [Ideal.Quotient.factor_mk hm₀_le a, Ideal.quotientMap_mk]
  have h_ker : ψ₀₁.ker = U_ker := by
    apply le_antisymm
    · intro w hw
      rw [MonoidHom.mem_ker] at hw
      have hw_val : (ψ₀₁ w : R_E ⧸ I₁) = 1 := congrArg Units.val hw
      obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (w : R_F ⧸ m₀)
      have h_img : ι_R₁ (Ideal.Quotient.mk m₁ x) = ι_R₁ (Ideal.Quotient.mk m₁ 1) := by
        have h1 : (ι_R₁.comp π_R) (Ideal.Quotient.mk m₀ x) = 1 := by
          rw [hx]
          exact hw_val
        change ι_R₁ (Ideal.Quotient.factor hm₀_le (Ideal.Quotient.mk m₀ x)) = 1 at h1
        rw [Ideal.Quotient.factor_mk hm₀_le x] at h1
        rw [h1, map_one, map_one]
      have h_mk_eq : Ideal.Quotient.mk m₁ x = Ideal.Quotient.mk m₁ 1 := hι₁_inj h_img
      have hx_mem : x - 1 ∈ m₁ := Ideal.Quotient.eq.mp h_mk_eq
      apply Subgroup.subset_closure
      refine ⟨x - 1, hx_mem, ?_⟩
      rw [← hx, add_sub_cancel]
    · rw [Subgroup.closure_le]
      rintro w ⟨a, ha_mem, hw_eq⟩
      rw [SetLike.mem_coe, MonoidHom.mem_ker]
      apply Units.ext
      change (ι_R₁.comp π_R) (w : R_F ⧸ m₀) = 1
      rw [hw_eq]
      change ι_R₁ (Ideal.Quotient.factor hm₀_le (Ideal.Quotient.mk m₀ (1 + a))) = 1
      rw [Ideal.Quotient.factor_mk hm₀_le (1 + a)]
      have h_mk1 : Ideal.Quotient.mk m₁ (1 + a) = Ideal.Quotient.mk m₁ 1 :=
        Ideal.Quotient.eq.mpr (by simpa using ha_mem)
      rw [h_mk1, map_one, map_one]
  have h_range : ψ₀₁.range = F_fix := by
    apply le_antisymm
    · rintro u ⟨w, rfl⟩
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (w : R_F ⧸ m₀)
      apply Subgroup.subset_closure
      refine ⟨a, ?_⟩
      change (ι_R₁.comp π_R) (w : R_F ⧸ m₀) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a)
      rw [← ha, hψ_mk a]
    · rw [Subgroup.closure_le]
      rintro u ⟨a, hu_eq⟩
      rw [SetLike.mem_coe, MonoidHom.mem_range]
      have hu_unit : IsUnit (ι_R₁ (Ideal.Quotient.mk m₁ a)) := by
        rw [Ideal.quotientMap_mk, ← hu_eq]
        exact u.isUnit
      have ha_unit : IsUnit (Ideal.Quotient.mk m₁ a) := (hι₁_unit _).mp hu_unit
      obtain ⟨ybar, hybar⟩ := isUnit_iff_exists_inv.mp ha_unit
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective ybar
      have h_ab_mk : Ideal.Quotient.mk m₁ (a * b) = Ideal.Quotient.mk m₁ 1 := by
        rw [map_mul, map_one, hybar]
      have hr : a * b - 1 ∈ m₁ := Ideal.Quotient.eq.mp h_ab_mk
      have h_sq_m₁ : (a * b - 1) * (a * b - 1) ∈ m₁ ^ 2 := by
        rw [sq]
        exact Ideal.mul_mem_mul hr hr
      have h_sq_m₀ : (a * b - 1) * (a * b - 1) ∈ m₀ := hm₁_sq h_sq_m₁
      let b' : R_F := b * (2 - a * b)
      have h_newton : a * b' - 1 = -((a * b - 1) * (a * b - 1)) := by
        dsimp [b']
        ring
      have hab'_mem : a * b' - 1 ∈ m₀ := by
        rw [h_newton]
        exact Submodule.neg_mem m₀ h_sq_m₀
      have h_ab'_mk : Ideal.Quotient.mk m₀ a * Ideal.Quotient.mk m₀ b' = 1 := by
        rw [← map_mul, ← map_one (Ideal.Quotient.mk m₀)]
        exact Ideal.Quotient.eq.mpr hab'_mem
      have h_b'a_mk : Ideal.Quotient.mk m₀ b' * Ideal.Quotient.mk m₀ a = 1 := by
        rw [mul_comm, h_ab'_mk]
      let w : (R_F ⧸ m₀)ˣ :=
        ⟨Ideal.Quotient.mk m₀ a, Ideal.Quotient.mk m₀ b', h_ab'_mk, h_b'a_mk⟩
      refine ⟨w, Units.ext ?_⟩
      change (ι_R₁.comp π_R) (Ideal.Quotient.mk m₀ a) = (u : R_E ⧸ I₁)
      rw [hψ_mk a, hu_eq]
  have hW₀_card : Nat.card (R_F ⧸ m₀)ˣ = Nat.card F_fix * Nat.card U_ker := by
    have h_lag := Subgroup.card_eq_card_quotient_mul_card_subgroup ψ₀₁.ker
    have h_iso : Nat.card ((R_F ⧸ m₀)ˣ ⧸ ψ₀₁.ker) = Nat.card ψ₀₁.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange ψ₀₁).toEquiv
    rw [h_iso, h_range, h_ker] at h_lag
    exact h_lag
  exact ⟨hFin_F₀, hFin_E₀, hFin_E₁, hι₀_inj, hι₁_inj, hι₀_unit, hW₀_card⟩

theorem exists_mod_galois_unit_homomorphisms {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_le : m₀ ≤ m₁) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let U_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
      ∃ b : R_E,
        (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b ∧
        Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ b) = (u : R_E ⧸ I₁) }
    let F_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
      ∃ a : R_F,
        (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
    ∃ (D₀ N₀ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₀)ˣ)
      (D₁ : (R_E ⧸ I₁)ˣ →* (R_E ⧸ I₁)ˣ)
      (p₀₁ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₁)ˣ),
      (∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
        (D₀ u : R_E ⧸ I₀) * Ideal.Quotient.mk I₀ (galRestrict R_F F E R_E σ b) =
          Ideal.Quotient.mk I₀ b) ∧
      (∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
        (N₀ u : R_E ⧸ I₀) =
          Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b))) ∧
      (∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
        (p₀₁ u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b) ∧
      (∀ u : (R_E ⧸ I₀)ˣ, p₀₁ (D₀ u) = D₁ (p₀₁ u)) ∧
      D₀.range ≤ N₀.ker ∧
      U_fix = D₁.ker ∧
      F_fix ≤ U_fix ∧
      (∀ b : R_E,
        IsUnit (Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b))) →
        IsUnit (Ideal.Quotient.mk I₀ b)) ∧
      (∀ z ∈ I₁,
        Ideal.Quotient.mk I₁ (algebraMap R_F R_E (Algebra.intNorm R_F R_E (1 + z))) = 1) :=
by
  classical
  intro R_F R_E I₁ I₀ U_fix F_fix
  let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  have hd_pos : 0 < d := Nat.card_pos
  have h_order : orderOf σ = d := orderOf_eq_card_of_forall_mem_zpowers hCyclic
  have h_bij : Function.Bijective (fun k : Fin d => σ ^ (k : ℕ)) := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨?_, ?_⟩
    · intro k₁ k₂ hk
      have hk₁ : (k₁ : ℕ) < orderOf σ := by rw [h_order]; exact k₁.isLt
      have hk₂ : (k₂ : ℕ) < orderOf σ := by rw [h_order]; exact k₂.isLt
      exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ hk)
    · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card]
  let e_gal : Fin d ≃ (E ≃ₐ[F] E) := Equiv.ofBijective (fun k : Fin d => σ ^ (k : ℕ)) h_bij
  have h_gal_pow : ∀ k : ℕ, galRestrict R_F F E R_E (σ ^ k) = σ_int ^ k := by
    intro k
    induction k with
    | zero => rw [pow_zero, pow_zero, map_one]
    | succ k ih => rw [pow_succ, pow_succ, map_mul, ih]
  have hσ_int_d : σ_int ^ d = 1 := by
    have h_pow_d : σ ^ d = 1 := by
      dsimp [d]
      rw [Nat.card_eq_fintype_card, pow_card_eq_one]
    rw [← h_gal_pow d, h_pow_d, map_one]
  have hσ_int_zero : ∀ b : R_E, (σ_int ^ (0 : ℕ)) b = b := by
    intro b
    rw [pow_zero, AlgEquiv.one_apply]
  have hσ_int_succ : ∀ (k : ℕ) (b : R_E), (σ_int ^ (k + 1)) b = (σ_int ^ k) (σ_int b) := by
    intro k b
    rw [pow_succ, AlgEquiv.mul_apply]
  have hσ_int_succ' : ∀ (k : ℕ) (b : R_E), (σ_int ^ (k + 1)) b = σ_int ((σ_int ^ k) b) := by
    intro k b
    rw [pow_succ', AlgEquiv.mul_apply]
  have hσ_int_period : ∀ b : R_E, (σ_int ^ d) b = b := by
    intro b
    rw [hσ_int_d, AlgEquiv.one_apply]
  have h_intNorm_prod : ∀ b : R_E,
      algebraMap R_F R_E (Algebra.intNorm R_F R_E b) =
        ∏ k : Fin d, (σ_int ^ (k : ℕ)) b := by
    intro b
    apply IsIntegralClosure.algebraMap_injective R_E R_F E
    rw [← IsScalarTower.algebraMap_apply R_F R_E E, IsScalarTower.algebraMap_apply R_F F E,
      Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E),
      Algebra.norm_eq_prod_automorphisms, map_prod]
    conv_lhs => rw [← Equiv.prod_comp e_gal (fun ρ : E ≃ₐ[F] E => ρ (algebraMap R_E E b))]
    refine Finset.prod_congr rfl fun k _ => ?_
    change (σ ^ (k : ℕ)) (algebraMap R_E E b) = algebraMap R_E E ((σ_int ^ (k : ℕ)) b)
    rw [← h_gal_pow (k : ℕ)]
    exact (algebraMap_galRestrict_apply R_F (σ ^ (k : ℕ)) b).symm
  have h_map_comap : ∀ m : Ideal R_F,
      Ideal.map (algebraMap R_F R_E) m ≤
        Ideal.comap σ_int.toRingHom (Ideal.map (algebraMap R_F R_E) m) := by
    intro m
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    change σ_int (algebraMap R_F R_E a) ∈ Ideal.map (algebraMap R_F R_E) m
    rw [σ_int.commutes a]
    exact Ideal.mem_map_of_mem (algebraMap R_F R_E) ha
  have h_pow_mem : ∀ (m : Ideal R_F) (k : ℕ) {z : R_E},
      z ∈ Ideal.map (algebraMap R_F R_E) m →
      (σ_int ^ k) z ∈ Ideal.map (algebraMap R_F R_E) m := by
    intro m k
    induction k with
    | zero =>
      intro z hz
      rw [hσ_int_zero]
      exact hz
    | succ k ih =>
      intro z hz
      rw [hσ_int_succ']
      exact h_map_comap m (ih hz)
  have h_pow_comap : ∀ (m : Ideal R_F) (k : ℕ),
      Ideal.map (algebraMap R_F R_E) m ≤
        Ideal.comap (σ_int ^ k).toRingHom (Ideal.map (algebraMap R_F R_E) m) := by
    intro m k z hz
    exact h_pow_mem m k hz
  let σ_bar₀ : (R_E ⧸ I₀) →+* (R_E ⧸ I₀) :=
    Ideal.quotientMap I₀ σ_int.toRingHom (h_map_comap m₀)
  let σ_bar₁ : (R_E ⧸ I₁) →+* (R_E ⧸ I₁) :=
    Ideal.quotientMap I₁ σ_int.toRingHom (h_map_comap m₁)
  let σ_bar₀_pow : ℕ → ((R_E ⧸ I₀) →+* (R_E ⧸ I₀)) :=
    fun k => Ideal.quotientMap I₀ (σ_int ^ k).toRingHom (h_pow_comap m₀ k)
  let q₀₁ : (R_E ⧸ I₀) →+* (R_E ⧸ I₁) :=
    Ideal.Quotient.factor (Ideal.map_mono hm₀_le)
  let τ₀ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₀)ˣ := Units.map σ_bar₀.toMonoidHom
  let τ₁ : (R_E ⧸ I₁)ˣ →* (R_E ⧸ I₁)ˣ := Units.map σ_bar₁.toMonoidHom
  let τ₀_pow : ℕ → (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₀)ˣ :=
    fun k => Units.map (σ_bar₀_pow k).toMonoidHom
  let D₀ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₀)ˣ := MonoidHom.id (R_E ⧸ I₀)ˣ / τ₀
  let D₁ : (R_E ⧸ I₁)ˣ →* (R_E ⧸ I₁)ˣ := MonoidHom.id (R_E ⧸ I₁)ˣ / τ₁
  let p₀₁ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₁)ˣ := Units.map q₀₁.toMonoidHom
  let N₀ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₀)ˣ :=
    { toFun := fun u => ∏ k : Fin d, τ₀_pow (k : ℕ) u
      map_one' := by simp [map_one]
      map_mul' := fun u v => by simp [map_mul, Finset.prod_mul_distrib] }
  have hτ₀_pow : ∀ (k : ℕ) (u : (R_E ⧸ I₀)ˣ) (b : R_E),
      (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
      ((τ₀_pow k u : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ ((σ_int ^ k) b) := by
    intro k u b hu
    change σ_bar₀_pow k (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ ((σ_int ^ k) b)
    rw [hu, Ideal.quotientMap_mk]
    rfl
  have hτ₀_zero : ∀ u : (R_E ⧸ I₀)ˣ, τ₀_pow 0 u = u := by
    intro u
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
    apply Units.ext
    rw [hτ₀_pow 0 u b hb.symm, hσ_int_zero b, hb]
  have hτ₀_d : ∀ u : (R_E ⧸ I₀)ˣ, τ₀_pow d u = u := by
    intro u
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
    apply Units.ext
    rw [hτ₀_pow d u b hb.symm, hσ_int_period b, hb]
  have hτ₀_succ : ∀ (k : ℕ) (u : (R_E ⧸ I₀)ˣ), τ₀_pow k (τ₀ u) = τ₀_pow (k + 1) u := by
    intro k u
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
    have hτ₀_b : (τ₀ u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ (σ_int b) := by
      change σ_bar₀ (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ (σ_int b)
      rw [← hb, Ideal.quotientMap_mk]
      rfl
    apply Units.ext
    rw [hτ₀_pow k (τ₀ u) (σ_int b) hτ₀_b, hτ₀_pow (k + 1) u b hb.symm, hσ_int_succ k b]
  have hD₀ : ∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
      (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
      (D₀ u : R_E ⧸ I₀) * Ideal.Quotient.mk I₀ (galRestrict R_F F E R_E σ b) =
        Ideal.Quotient.mk I₀ b := by
    intro u b hu
    have h_mul : D₀ u * τ₀ u = u := div_mul_cancel u (τ₀ u)
    have h_val : (D₀ u : R_E ⧸ I₀) * (τ₀ u : R_E ⧸ I₀) = (u : R_E ⧸ I₀) :=
      congrArg Units.val h_mul
    have hτ₀_val : (τ₀ u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ (σ_int b) := by
      change σ_bar₀ (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ (σ_int b)
      rw [hu, Ideal.quotientMap_mk]
      rfl
    rw [hτ₀_val, hu] at h_val
    exact h_val
  have hN₀ : ∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
      (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
      (N₀ u : R_E ⧸ I₀) =
        Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b)) := by
    intro u b hu
    have h_val_prod : (N₀ u : R_E ⧸ I₀) = ∏ k : Fin d, ((τ₀_pow (k : ℕ) u : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀) :=
      map_prod (Units.coeHom (R_E ⧸ I₀)) (fun k : Fin d => τ₀_pow (k : ℕ) u) Finset.univ
    rw [h_val_prod]
    have h_congr : (∏ k : Fin d, ((τ₀_pow (k : ℕ) u : (R_E ⧸ I₀)ˣ) : R_E ⧸ I₀)) =
        ∏ k : Fin d, Ideal.Quotient.mk I₀ ((σ_int ^ (k : ℕ)) b) :=
      Finset.prod_congr rfl fun k _ => hτ₀_pow (k : ℕ) u b hu
    rw [h_congr, ← map_prod, ← h_intNorm_prod b]
  have hp₀₁ : ∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
      (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
      (p₀₁ u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b := by
    intro u b hu
    change q₀₁ (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₁ b
    rw [hu, Ideal.Quotient.factor_mk]
  have h_comm : ∀ u : (R_E ⧸ I₀)ˣ, p₀₁ (D₀ u) = D₁ (p₀₁ u) := by
    intro u
    have h_tau : p₀₁ (τ₀ u) = τ₁ (p₀₁ u) := by
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
      apply Units.ext
      change q₀₁ (σ_bar₀ (u : R_E ⧸ I₀)) = σ_bar₁ (q₀₁ (u : R_E ⧸ I₀))
      rw [← hb, Ideal.quotientMap_mk, Ideal.Quotient.factor_mk,
        Ideal.Quotient.factor_mk, Ideal.quotientMap_mk]
    change p₀₁ (u / τ₀ u) = (p₀₁ u) / τ₁ (p₀₁ u)
    rw [map_div, h_tau]
  have hD₀_le_ker : D₀.range ≤ N₀.ker := by
    rintro _ ⟨u, rfl⟩
    rw [MonoidHom.mem_ker]
    change N₀ (u / τ₀ u) = 1
    rw [map_div, div_eq_one]
    have h1 : N₀ u = ∏ k ∈ Finset.range d, τ₀_pow k u := by
      change (∏ k : Fin d, τ₀_pow (k : ℕ) u) = ∏ k ∈ Finset.range d, τ₀_pow k u
      exact Fin.prod_univ_eq_prod_range (fun k : ℕ => τ₀_pow k u) d
    have h2 : N₀ (τ₀ u) = ∏ k ∈ Finset.range d, τ₀_pow (k + 1) u := by
      change (∏ k : Fin d, τ₀_pow (k : ℕ) (τ₀ u)) = ∏ k ∈ Finset.range d, τ₀_pow (k + 1) u
      rw [Fin.prod_univ_eq_prod_range (fun k : ℕ => τ₀_pow k (τ₀ u)) d]
      refine Finset.prod_congr rfl fun k _ => hτ₀_succ k u
    apply mul_right_cancel (b := u)
    calc
      N₀ u * u
          = (∏ k ∈ Finset.range d, τ₀_pow k u) * τ₀_pow d u := by
            rw [h1, hτ₀_d u]
      _ = ∏ k ∈ Finset.range (d + 1), τ₀_pow k u :=
            (Finset.prod_range_succ (fun k : ℕ => τ₀_pow k u) d).symm
      _ = (∏ k ∈ Finset.range d, τ₀_pow (k + 1) u) * τ₀_pow 0 u :=
            Finset.prod_range_succ' (fun k : ℕ => τ₀_pow k u) d
      _ = N₀ (τ₀ u) * u := by
            rw [← h2, hτ₀_zero u]
  have hU_fix : U_fix = D₁.ker := by
    apply le_antisymm
    · rw [Subgroup.closure_le]
      rintro u ⟨b, hu, hσ⟩
      rw [SetLike.mem_coe, MonoidHom.mem_ker]
      have hτ₁ : τ₁ u = u := by
        apply Units.ext
        change σ_bar₁ (u : R_E ⧸ I₁) = (u : R_E ⧸ I₁)
        rw [hu, Ideal.quotientMap_mk]
        exact hσ.trans hu
      change u / τ₁ u = 1
      rw [hτ₁, div_self']
    · intro u hu
      rw [MonoidHom.mem_ker] at hu
      have h_div : u / τ₁ u = 1 := hu
      have hτ₁ : τ₁ u = u := (div_eq_one.mp h_div).symm
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₁)
      apply Subgroup.subset_closure
      refine ⟨b, hb.symm, ?_⟩
      have h_val : (τ₁ u : R_E ⧸ I₁) = (u : R_E ⧸ I₁) := congrArg Units.val hτ₁
      change σ_bar₁ (u : R_E ⧸ I₁) = (u : R_E ⧸ I₁) at h_val
      rw [← hb, Ideal.quotientMap_mk] at h_val
      exact h_val.trans hb
  have hF_le_U : F_fix ≤ U_fix := by
    rw [Subgroup.closure_le]
    rintro u ⟨a, hu⟩
    rw [SetLike.mem_coe]
    apply Subgroup.subset_closure
    refine ⟨algebraMap R_F R_E a, hu, ?_⟩
    rw [σ_int.commutes a, ← hu]
  have h_unit_of_norm : ∀ b : R_E,
      IsUnit (Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b))) →
      IsUnit (Ideal.Quotient.mk I₀ b) := by
    intro b h_unit
    let k₀ : Fin d := ⟨0, hd_pos⟩
    have h_prod : Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b)) =
        Ideal.Quotient.mk I₀ b *
          ∏ k ∈ (Finset.univ : Finset (Fin d)).erase k₀,
            Ideal.Quotient.mk I₀ ((σ_int ^ (k : ℕ)) b) := by
      rw [h_intNorm_prod b, map_prod,
        ← Finset.mul_prod_erase Finset.univ
          (fun k : Fin d => Ideal.Quotient.mk I₀ ((σ_int ^ (k : ℕ)) b))
          (Finset.mem_univ k₀)]
      congr 1
    rw [h_prod] at h_unit
    exact isUnit_of_mul_isUnit_left h_unit
  have h_norm_one_add : ∀ z ∈ I₁,
      Ideal.Quotient.mk I₁ (algebraMap R_F R_E (Algebra.intNorm R_F R_E (1 + z))) = 1 := by
    intro z hz
    rw [h_intNorm_prod (1 + z), map_prod]
    have h_one : ∀ k ∈ (Finset.univ : Finset (Fin d)),
        Ideal.Quotient.mk I₁ ((σ_int ^ (k : ℕ)) (1 + z)) = 1 := by
      intro k _
      rw [map_add, map_one, map_add, map_one]
      have hz_k : (σ_int ^ (k : ℕ)) z ∈ I₁ := h_pow_mem m₁ (k : ℕ) hz
      have h_zero : Ideal.Quotient.mk I₁ ((σ_int ^ (k : ℕ)) z) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hz_k
      rw [h_zero, add_zero]
    rw [Finset.prod_congr rfl h_one, Finset.prod_const_one]
  exact ⟨D₀, N₀, D₁, p₀₁, hD₀, hN₀, hp₀₁, h_comm, hD₀_le_ker, hU_fix, hF_le_U,
    h_unit_of_norm, h_norm_one_add⟩

theorem mod_norm_and_coboundary_subgroup_identifications {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_le : m₀ ≤ m₁)
    (hm₁_sq : m₁ ^ 2 ≤ m₀) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let ι_R₀ : R_F ⧸ m₀ →+* R_E ⧸ I₀ :=
      Ideal.quotientMap I₀ (algebraMap R_F R_E) Ideal.le_comap_map
    let ι_R₁ : R_F ⧸ m₁ →+* R_E ⧸ I₁ :=
      Ideal.quotientMap I₁ (algebraMap R_F R_E) Ideal.le_comap_map
    let K_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b : R_E,
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) = 1 }
    let B_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b c : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk I₁ (b * galRestrict R_F F E R_E σ c) =
          Ideal.Quotient.mk I₁ c }
    let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ b : R_E,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
    let U_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ a ∈ m₁,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (1 + a) }
    let N_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ z ∈ I₁,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E (1 + z)) }
    Function.Injective ι_R₀ →
    Function.Injective ι_R₁ →
    (∀ x : R_F ⧸ m₀, IsUnit (ι_R₀ x) ↔ IsUnit x) →
    ∀ (D₀ N₀ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₀)ˣ)
      (p₀₁ : (R_E ⧸ I₀)ˣ →* (R_E ⧸ I₁)ˣ),
      (∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
        (D₀ u : R_E ⧸ I₀) * Ideal.Quotient.mk I₀ (galRestrict R_F F E R_E σ b) =
          Ideal.Quotient.mk I₀ b) →
      (∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
        (N₀ u : R_E ⧸ I₀) =
          Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b))) →
      (∀ (u : (R_E ⧸ I₀)ˣ) (b : R_E),
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b →
        (p₀₁ u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b) →
      (∀ b : R_E,
        IsUnit (Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b))) →
        IsUnit (Ideal.Quotient.mk I₀ b)) →
      (∀ z ∈ I₁,
        Ideal.Quotient.mk I₁ (algebraMap R_F R_E (Algebra.intNorm R_F R_E (1 + z))) = 1) →
      K_mod = N₀.ker ∧
      p₀₁.ker ≤ B_mod ∧
      D₀.range ≤ B_mod ∧
      N_ker ≤ U_ker ∧
      Nat.card N₀.range = Nat.card N_mod ∧
      Nat.card (Subgroup.map N₀ p₀₁.ker) = Nat.card N_ker :=
by
  intro R_F R_E I₁ I₀ ι_R₀ ι_R₁ K_mod B_mod N_mod U_ker N_ker
  intro hι₀_inj hι₁_inj hι₀_unit D₀ N₀ p₀₁ hD₀ hN₀ hp₀₁ h_unit_of_norm h_norm_one_add
  let ι₀ : (R_F ⧸ m₀)ˣ →* (R_E ⧸ I₀)ˣ := Units.map ι_R₀.toMonoidHom
  have hι₀_units_inj : Function.Injective ι₀ := Units.map_injective hι₀_inj
  have hι₀_mk : ∀ a : R_F, ι_R₀ (Ideal.Quotient.mk m₀ a) =
      Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) :=
    fun _ => Ideal.quotientMap_mk
  have hι₁_mk : ∀ a : R_F, ι_R₁ (Ideal.Quotient.mk m₁ a) =
      Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) :=
    fun _ => Ideal.quotientMap_mk
  have h1 : K_mod = N₀.ker := by
    apply le_antisymm
    · rw [Subgroup.closure_le]
      rintro u ⟨b, hu, hnorm⟩
      rw [SetLike.mem_coe, MonoidHom.mem_ker, Units.ext_iff, Units.val_one,
        hN₀ u b hu, ← hι₀_mk, hnorm, map_one]
    · intro u hu
      rw [MonoidHom.mem_ker] at hu
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
      apply Subgroup.subset_closure
      refine ⟨b, hb.symm, ?_⟩
      apply hι₀_inj
      rw [hι₀_mk, ← hN₀ u b hb.symm, hu, Units.val_one, map_one]
  have h2 : p₀₁.ker ≤ B_mod := by
    intro u hu
    rw [MonoidHom.mem_ker] at hu
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
    apply Subgroup.subset_closure
    refine ⟨b, 1, ?_, hb.symm, ?_⟩
    · rw [map_one, Ideal.span_singleton_one]
      exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
    · rw [map_one, mul_one, ← hp₀₁ u b hb.symm, hu, Units.val_one, map_one]
  have h3 : D₀.range ≤ B_mod := by
    rintro u ⟨v, rfl⟩
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (D₀ v : R_E ⧸ I₀)
    obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (v : R_E ⧸ I₀)
    apply Subgroup.subset_closure
    refine ⟨b, c, ?_, hb.symm, ?_⟩
    · have h_unit_E : IsUnit (ι_R₀ (Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E c))) := by
        rw [hι₀_mk, ← hN₀ v c hc.symm]
        exact (N₀ v).isUnit
      obtain ⟨u_F, hu_F⟩ := (hι₀_unit _).mp h_unit_E
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective ((u_F⁻¹ : (R_F ⧸ m₀)ˣ) : R_F ⧸ m₀)
      have h_mk_one : Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E c * r) =
          Ideal.Quotient.mk m₀ 1 := by
        rw [map_mul, ← hu_F, hr, Units.mul_inv, map_one]
      have h_sub_mem : Algebra.intNorm R_F R_E c * r - 1 ∈ m₀ :=
        Ideal.Quotient.eq.mp h_mk_one
      have h_one_sub_mem : 1 - Algebra.intNorm R_F R_E c * r ∈ m₀ := by
        have h_neg := Submodule.neg_mem m₀ h_sub_mem
        rwa [neg_sub] at h_neg
      rw [Ideal.isCoprime_iff_exists]
      refine ⟨Algebra.intNorm R_F R_E c * r, Ideal.mem_span_singleton.mpr ⟨r, rfl⟩,
        1 - Algebra.intNorm R_F R_E c * r, h_one_sub_mem, by ring⟩
    · have h_I₀ : Ideal.Quotient.mk I₀ (b * galRestrict R_F F E R_E σ c) =
          Ideal.Quotient.mk I₀ c := by
        rw [map_mul, hb, hD₀ v c hc.symm]
      have h_fac := congrArg (Ideal.Quotient.factor (Ideal.map_mono hm₀_le)) h_I₀
      simpa only [Ideal.Quotient.factor_mk] using h_fac
  have h4 : N_ker ≤ U_ker := by
    rw [Subgroup.closure_le]
    rintro w ⟨z, hz, hw⟩
    rw [SetLike.mem_coe]
    have h_mk₁ : Ideal.Quotient.mk m₁ (Algebra.intNorm R_F R_E (1 + z)) =
        Ideal.Quotient.mk m₁ 1 := by
      apply hι₁_inj
      rw [hι₁_mk, h_norm_one_add z hz, map_one, map_one]
    have ha_mem : Algebra.intNorm R_F R_E (1 + z) - 1 ∈ m₁ :=
      Ideal.Quotient.eq.mp h_mk₁
    apply Subgroup.subset_closure
    refine ⟨Algebra.intNorm R_F R_E (1 + z) - 1, ha_mem, ?_⟩
    rw [add_sub_cancel, hw]
  have h5 : Nat.card N₀.range = Nat.card N_mod := by
    have h_range_eq : N₀.range = Subgroup.map ι₀ N_mod := by
      apply le_antisymm
      · rintro y ⟨u, rfl⟩
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
        have h_unit_E : IsUnit (ι_R₀ (Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b))) := by
          rw [hι₀_mk, ← hN₀ u b hb.symm]
          exact (N₀ u).isUnit
        obtain ⟨w, hw⟩ := (hι₀_unit _).mp h_unit_E
        refine ⟨w, Subgroup.subset_closure ⟨b, hw⟩, ?_⟩
        ext
        change ι_R₀ (w : R_F ⧸ m₀) = (N₀ u : R_E ⧸ I₀)
        rw [hw, hι₀_mk, hN₀ u b hb.symm]
      · rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
        rintro w ⟨b, hw⟩
        rw [SetLike.mem_coe, Subgroup.mem_comap, MonoidHom.mem_range]
        have h_unit_norm : IsUnit
            (Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E b))) := by
          rw [← hι₀_mk, ← hw]
          exact (ι₀ w).isUnit
        obtain ⟨u, hu⟩ := h_unit_of_norm b h_unit_norm
        refine ⟨u, ?_⟩
        ext
        change (N₀ u : R_E ⧸ I₀) = ι_R₀ (w : R_F ⧸ m₀)
        rw [hN₀ u b hu, ← hι₀_mk, ← hw]
    rw [h_range_eq]
    exact (Nat.card_congr (N_mod.equivMapOfInjective ι₀ hι₀_units_inj).toEquiv).symm
  have h6 : Nat.card (Subgroup.map N₀ p₀₁.ker) = Nat.card N_ker := by
    have hI₁_sq : I₁ ^ 2 ≤ I₀ := by
      dsimp [I₁, I₀]
      rw [← Ideal.map_pow]
      exact Ideal.map_mono hm₁_sq
    have h_map_eq : Subgroup.map N₀ p₀₁.ker = Subgroup.map ι₀ N_ker := by
      apply le_antisymm
      · rintro y ⟨u, hu_ker, rfl⟩
        change p₀₁ u = 1 at hu_ker
        obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₀)
        have h_mk₁ : Ideal.Quotient.mk I₁ x = Ideal.Quotient.mk I₁ 1 := by
          rw [← hp₀₁ u x hx.symm, hu_ker, Units.val_one, map_one]
        have hz_mem : x - 1 ∈ I₁ := Ideal.Quotient.eq.mp h_mk₁
        let z : R_E := x - 1
        have hx_eq : (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ (1 + z) := by
          dsimp [z]
          rw [add_sub_cancel, hx]
        have h_unit_E : IsUnit (ι_R₀ (Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E (1 + z)))) := by
          rw [hι₀_mk, ← hN₀ u (1 + z) hx_eq]
          exact (N₀ u).isUnit
        obtain ⟨w, hw⟩ := (hι₀_unit _).mp h_unit_E
        refine ⟨w, Subgroup.subset_closure ⟨z, hz_mem, hw⟩, ?_⟩
        ext
        change ι_R₀ (w : R_F ⧸ m₀) = (N₀ u : R_E ⧸ I₀)
        rw [hw, hι₀_mk, hN₀ u (1 + z) hx_eq]
      · rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
        rintro w ⟨z, hz, hw⟩
        rw [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.mem_map]
        have hz_sq : z * z ∈ I₀ := by
          apply hI₁_sq
          rw [sq]
          exact Ideal.mul_mem_mul hz hz
        have h_prod_sub : (1 + z) * (1 - z) - 1 ∈ I₀ := by
          have h_eq : (1 + z) * (1 - z) - 1 = -(z * z) := by ring
          rw [h_eq]
          exact Submodule.neg_mem I₀ hz_sq
        have h_inv_mk : Ideal.Quotient.mk I₀ (1 + z) * Ideal.Quotient.mk I₀ (1 - z) = 1 := by
          rw [← map_mul, ← map_one (Ideal.Quotient.mk I₀)]
          exact Ideal.Quotient.eq.mpr h_prod_sub
        let u_z : (R_E ⧸ I₀)ˣ :=
          ⟨Ideal.Quotient.mk I₀ (1 + z), Ideal.Quotient.mk I₀ (1 - z),
            h_inv_mk, by rw [mul_comm]; exact h_inv_mk⟩
        have hu_z_ker : u_z ∈ p₀₁.ker := by
          rw [MonoidHom.mem_ker, Units.ext_iff, Units.val_one, hp₀₁ u_z (1 + z) rfl,
            ← map_one (Ideal.Quotient.mk I₁), Ideal.Quotient.eq]
          simpa using hz
        refine ⟨u_z, hu_z_ker, ?_⟩
        ext
        change (N₀ u_z : R_E ⧸ I₀) = ι_R₀ (w : R_F ⧸ m₀)
        rw [hN₀ u_z (1 + z) rfl, ← hι₀_mk, ← hw]
    rw [h_map_eq]
    exact (Nat.card_congr (N_ker.equivMapOfInjective ι₀ hι₀_units_inj).toEquiv).symm
  exact ⟨h1, h2, h3, h4, h5, h6⟩

theorem commGroup_herbrand_quotient_natCard_inequality {M₀ M₁ W₀ : Type*} [CommGroup M₀] [Finite M₀] [CommGroup M₁] [Finite M₁]
    [CommGroup W₀] [Finite W₀]
    (D₀ N₀ : M₀ →* M₀)
    (D₁ : M₁ →* M₁)
    (p₀₁ : M₀ →* M₁)
    (K_mod B_mod : Subgroup M₀)
    (N_mod U_ker N_ker : Subgroup W₀)
    (U_fix F_fix : Subgroup M₁)
    (hW₀_card : Nat.card W₀ = Nat.card F_fix * Nat.card U_ker)
    (h_comm : ∀ u : M₀, p₀₁ (D₀ u) = D₁ (p₀₁ u))
    (hD₀_le_ker : D₀.range ≤ N₀.ker)
    (hU_fix : U_fix = D₁.ker)
    (hF_le_U : F_fix ≤ U_fix)
    (hK_mod : K_mod = N₀.ker)
    (hp_le_B : p₀₁.ker ≤ B_mod)
    (hD_le_B : D₀.range ≤ B_mod)
    (hN_le_U : N_ker ≤ U_ker)
    (hN_mod_card : Nat.card N₀.range = Nat.card N_mod)
    (hN_ker_card : Nat.card (Subgroup.map N₀ p₀₁.ker) = Nat.card N_ker) :
    Nat.card (K_mod ⧸ B_mod.subgroupOf K_mod) *
      Nat.card (U_ker ⧸ N_ker.subgroupOf U_ker) ≤
    Nat.card (W₀ ⧸ N_mod) *
      Nat.card (U_fix ⧸ F_fix.subgroupOf U_fix) :=
by
  have h_map_card : ∀ (f : M₀ →* M₀) (L : Subgroup M₀),
      Nat.card ↥(f.ker ⊓ L) * Nat.card ↥(Subgroup.map f L) = Nat.card ↥L := by
    intro f L
    have h := Subgroup.relIndex_inf_mul_relIndex (⊥ : Subgroup M₀) f.ker L
    rw [bot_inf_eq, ← MonoidHom.comap_bot f, Subgroup.relIndex_comap,
      Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left] at h
    exact h
  have h_top_card : ∀ (f : M₀ →* M₀),
      Nat.card ↥f.ker * Nat.card ↥f.range = Nat.card M₀ := by
    intro f
    have h := h_map_card f (⊤ : Subgroup M₀)
    rw [inf_top_eq, ← MonoidHom.range_eq_map f, Nat.card_congr Subgroup.topEquiv.toEquiv] at h
    exact h
  have h_sup_inf : ∀ (A B : Subgroup M₀),
      Nat.card ↥(A ⊔ B) * Nat.card ↥(B ⊓ A) = Nat.card ↥A * Nat.card ↥B := by
    intro A B
    have hA := Subgroup.relIndex_inf_mul_relIndex (⊥ : Subgroup M₀) B A
    rw [bot_inf_eq, Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left] at hA
    have hAB := Subgroup.relIndex_inf_mul_relIndex (⊥ : Subgroup M₀) B (A ⊔ B)
    rw [bot_inf_eq, inf_of_le_left le_sup_right, Subgroup.relIndex_bot_left,
      Subgroup.relIndex_bot_left, Subgroup.relIndex_sup_right A B] at hAB
    calc
      Nat.card ↥(A ⊔ B) * Nat.card ↥(B ⊓ A)
          = (Nat.card ↥B * B.relIndex A) * Nat.card ↥(B ⊓ A) := by rw [← hAB]
      _ = (Nat.card ↥(B ⊓ A) * B.relIndex A) * Nat.card ↥B := by ring
      _ = Nat.card ↥A * Nat.card ↥B := by rw [hA]
  let K₀₁ : Subgroup M₀ := p₀₁.ker
  let A₀ : Subgroup M₀ := K₀₁ ⊓ K_mod
  let H_pre : Subgroup M₀ := Subgroup.comap D₀ K₀₁
  let a : ℕ := Nat.card ↥(A₀ ⊔ D₀.range)
  let b : ℕ := Nat.card ↥(D₀.range ⊓ K₀₁)
  let c : ℕ := Nat.card ↥A₀
  let d_R : ℕ := Nat.card ↥D₀.range
  let d_K : ℕ := Nat.card ↥D₀.ker
  let k_M : ℕ := Nat.card ↥K_mod
  let n_M : ℕ := Nat.card ↥N_mod
  let k₀₁ : ℕ := Nat.card ↥K₀₁
  let n_K : ℕ := Nat.card ↥N_ker
  let u_F : ℕ := Nat.card ↥U_fix
  let f_F : ℕ := Nat.card ↥F_fix
  let H_mod : ℕ := Nat.card (K_mod ⧸ B_mod.subgroupOf K_mod)
  let M_ker : ℕ := Nat.card (U_ker ⧸ N_ker.subgroupOf U_ker)
  let Q_mod : ℕ := Nat.card (W₀ ⧸ N_mod)
  let M_fix : ℕ := Nat.card (U_fix ⧸ F_fix.subgroupOf U_fix)
  have hD₀_le_K : D₀.range ≤ K_mod := hK_mod ▸ hD₀_le_ker
  have h₁ : H_mod * a ≤ k_M := by
    have h_sub : A₀ ⊔ D₀.range ≤ B_mod ⊓ K_mod :=
      le_inf (sup_le (inf_le_left.trans hp_le_B) hD_le_B) (sup_le inf_le_right hD₀_le_K)
    have h_le : a ≤ Nat.card ↥(B_mod ⊓ K_mod) := Subgroup.card_le_of_le h_sub
    have h_eq : Nat.card ↥(B_mod ⊓ K_mod) * H_mod = k_M := by
      have h := Subgroup.relIndex_inf_mul_relIndex (⊥ : Subgroup M₀) B_mod K_mod
      rw [bot_inf_eq, Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left,
        Subgroup.relIndex, Subgroup.index_eq_card] at h
      exact h
    calc
      H_mod * a ≤ H_mod * Nat.card ↥(B_mod ⊓ K_mod) := Nat.mul_le_mul_left H_mod h_le
      _ = Nat.card ↥(B_mod ⊓ K_mod) * H_mod := mul_comm _ _
      _ = k_M := h_eq
  have h₂ : M_ker * f_F * n_K = Q_mod * n_M := by
    have h_uker : n_K * M_ker = Nat.card ↥U_ker := by
      have h := Subgroup.relIndex_inf_mul_relIndex (⊥ : Subgroup W₀) N_ker U_ker
      rw [bot_inf_eq, inf_of_le_left hN_le_U, Subgroup.relIndex_bot_left,
        Subgroup.relIndex_bot_left, Subgroup.relIndex, Subgroup.index_eq_card] at h
      exact h
    have h_w₀ : Nat.card W₀ = Q_mod * n_M := Subgroup.card_eq_card_quotient_mul_card_subgroup N_mod
    calc
      M_ker * f_F * n_K = f_F * (n_K * M_ker) := by ring
      _ = f_F * Nat.card ↥U_ker := by rw [h_uker]
      _ = Nat.card W₀ := hW₀_card.symm
      _ = Q_mod * n_M := h_w₀
  have h₃ : b * d_K ≤ M_fix * f_F * n_K * c := by
    have h_ker_le_pre : D₀.ker ≤ H_pre := by
      rw [← MonoidHom.comap_bot D₀]
      exact Subgroup.comap_mono bot_le
    have h_pre_eq : d_K * b = Nat.card ↥H_pre := by
      have h := h_map_card D₀ H_pre
      rw [inf_of_le_left h_ker_le_pre, Subgroup.map_comap_eq D₀ K₀₁] at h
      exact h
    have h_map_p₀₁_le : Subgroup.map p₀₁ H_pre ≤ U_fix := by
      rw [Subgroup.map_le_iff_le_comap, hU_fix]
      intro u hu
      rw [Subgroup.mem_comap, MonoidHom.mem_ker] at hu ⊢
      rw [← h_comm u, hu]
    have h_pre_le : Nat.card ↥H_pre ≤ k₀₁ * u_F := by
      have h := Subgroup.relIndex_inf_mul_relIndex (⊥ : Subgroup M₀) p₀₁.ker H_pre
      rw [bot_inf_eq, ← MonoidHom.comap_bot p₀₁, Subgroup.relIndex_comap,
        Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left] at h
      rw [← h]
      exact Nat.mul_le_mul (Subgroup.card_le_of_le inf_le_left) (Subgroup.card_le_of_le h_map_p₀₁_le)
    have h_k₀₁ : c * n_K = k₀₁ := by
      have h := h_map_card N₀ K₀₁
      rw [← hK_mod, inf_comm K_mod K₀₁, hN_ker_card] at h
      exact h
    have h_u_F : f_F * M_fix = u_F := by
      have h := Subgroup.relIndex_inf_mul_relIndex (⊥ : Subgroup M₁) F_fix U_fix
      rw [bot_inf_eq, inf_of_le_left hF_le_U, Subgroup.relIndex_bot_left,
        Subgroup.relIndex_bot_left, Subgroup.relIndex, Subgroup.index_eq_card] at h
      exact h
    calc
      b * d_K = d_K * b := mul_comm _ _
      _ = Nat.card ↥H_pre := h_pre_eq
      _ ≤ k₀₁ * u_F := h_pre_le
      _ = (c * n_K) * (f_F * M_fix) := by rw [← h_k₀₁, ← h_u_F]
      _ = M_fix * f_F * n_K * c := by ring
  have h₄ : n_M * k_M = d_R * d_K := by
    have hN := h_top_card N₀
    rw [← hK_mod, hN_mod_card] at hN
    have hD := h_top_card D₀
    calc
      n_M * k_M = k_M * n_M := mul_comm _ _
      _ = Nat.card M₀ := hN
      _ = d_K * d_R := hD.symm
      _ = d_R * d_K := mul_comm _ _
  have h₅ : c * d_R = a * b := by
    have h := h_sup_inf A₀ D₀.range
    have h_inf_eq : D₀.range ⊓ A₀ = D₀.range ⊓ K₀₁ := by
      change D₀.range ⊓ (K₀₁ ⊓ K_mod) = D₀.range ⊓ K₀₁
      rw [inf_left_comm, inf_of_le_left hD₀_le_K, inf_comm]
    rw [h_inf_eq] at h
    exact h.symm
  have ha_pos : 0 < a := Nat.card_pos
  have hb_pos : 0 < b := Nat.card_pos
  have hdK_pos : 0 < d_K := Nat.card_pos
  have hfF_pos : 0 < f_F := Nat.card_pos
  have hnK_pos : 0 < n_K := Nat.card_pos
  have h_pos : 0 < a * b * d_K * f_F * n_K :=
    Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos ha_pos hb_pos) hdK_pos) hfF_pos) hnK_pos
  change H_mod * M_ker ≤ Q_mod * M_fix
  have h_mul_ineq :
      (H_mod * M_ker) * (a * b * d_K * f_F * n_K) ≤
        (Q_mod * M_fix) * (a * b * d_K * f_F * n_K) := by
    calc
      (H_mod * M_ker) * (a * b * d_K * f_F * n_K)
          = ((H_mod * a) * (M_ker * f_F * n_K)) * (b * d_K) := by ring
      _ ≤ (k_M * (Q_mod * n_M)) * (M_fix * f_F * n_K * c) :=
          Nat.mul_le_mul (Nat.mul_le_mul h₁ (le_of_eq h₂)) h₃
      _ = Q_mod * M_fix * (n_M * k_M) * f_F * n_K * c := by ring
      _ = Q_mod * M_fix * (d_R * d_K) * f_F * n_K * c := by rw [h₄]
      _ = Q_mod * M_fix * (c * d_R) * d_K * f_F * n_K := by ring
      _ = Q_mod * M_fix * (a * b) * d_K * f_F * n_K := by rw [h₅]
      _ = (Q_mod * M_fix) * (a * b * d_K * f_F * n_K) := by ring
  exact Nat.le_of_mul_le_mul_right h_mul_ineq h_pos

theorem mod_unit_cohomology_image_mul_congruence_norm_le_mod_norm_mul_congruence_fixed {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (D_ram m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₁_ne : m₁ ≠ ⊥)
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_eq : m₀ = D_ram * m₁)
    (hm₁_sq : m₁ ^ 2 ≤ m₀)
    (h_dvd : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₁ ↔ q.asIdeal ∣ m₀) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let K_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b : R_E,
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) = 1 }
    let B_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
      ∃ b c : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
        (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
        Ideal.Quotient.mk I₁ (b * galRestrict R_F F E R_E σ c) =
          Ideal.Quotient.mk I₁ c }
    let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ b : R_E,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
    let U_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
      ∃ b : R_E,
        (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b ∧
        Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ b) = (u : R_E ⧸ I₁) }
    let F_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
      ∃ a : R_F,
        (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
    let U_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ a ∈ m₁,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (1 + a) }
    let N_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ z ∈ I₁,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E (1 + z)) }
    Nat.card (K_mod ⧸ B_mod.subgroupOf K_mod) *
      Nat.card (U_ker ⧸ N_ker.subgroupOf U_ker) ≤
    Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) *
      Nat.card (U_fix ⧸ F_fix.subgroupOf U_fix) :=
by
  intro R_F R_E I₁ I₀ K_mod B_mod N_mod U_fix F_fix U_ker N_ker
  have hm₀_le : m₀ ≤ m₁ := hm₀_eq.symm ▸ Ideal.mul_le_left
  obtain ⟨hFin_F₀, hFin_E₀, hFin_E₁, hι₀_inj, hι₁_inj, hι₀_unit, hW₀_card⟩ :=
    quotient_algebraMap_injective_and_base_unit_card_eq (E := E) m₁ m₀ hm₁_ne hm₀_ne hm₀_le hm₁_sq
  haveI : Finite (R_F ⧸ m₀) := hFin_F₀
  haveI : Finite (R_E ⧸ I₀) := hFin_E₀
  haveI : Finite (R_E ⧸ I₁) := hFin_E₁
  obtain ⟨D₀, N₀, D₁, p₀₁, hD₀, hN₀, hp₀₁, h_comm, hD₀_le_ker, hU_fix, hF_le_U,
    h_unit_of_norm, h_norm_one_add⟩ :=
    exists_mod_galois_unit_homomorphisms σ hCyclic m₁ m₀ hm₀_le
  obtain ⟨hK_mod, hp_le_B, hD_le_B, hN_le_U, hN_mod_card, hN_ker_card⟩ :=
    mod_norm_and_coboundary_subgroup_identifications σ m₁ m₀ hm₀_le hm₁_sq
      hι₀_inj hι₁_inj hι₀_unit D₀ N₀ p₀₁ hD₀ hN₀ hp₀₁ h_unit_of_norm h_norm_one_add
  exact commGroup_herbrand_quotient_natCard_inequality
    D₀ N₀ D₁ p₀₁ K_mod B_mod N_mod U_ker N_ker U_fix F_fix
    hW₀_card h_comm hD₀_le_ker hU_fix hF_le_U hK_mod hp_le_B hD_le_B hN_le_U
    hN_mod_card hN_ker_card

theorem congruence_fixed_and_norm_quotients_le_additive_quotients {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (D_ram J_d m₂ m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (t₀ : NumberField.RingOfIntegers F)
    (hm₂_ne : m₂ ≠ ⊥)
    (hm₁_ne : m₁ ≠ ⊥)
    (hm₀_ne : m₀ ≠ ⊥)
    (h_span_d : Ideal.span {(Module.finrank F E : NumberField.RingOfIntegers F)} = D_ram * J_d)
    (hm₁_eq : m₁ = D_ram * m₂)
    (hm₀_eq : m₀ = D_ram * m₁)
    (hm₂_sq : m₂ ^ 2 ≤ m₁)
    (hm₁_sq : m₁ ^ 2 ≤ m₀)
    (h_dvd : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      (q.asIdeal ∣ m₂ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ m₁ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ D_ram → q.asIdeal ∣ m₀))
    (ht₀_mem : t₀ ∈ J_d)
    (ht₀_sub : t₀ - 1 ∈ m₀) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let U_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
      ∃ b : R_E,
        (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b ∧
        Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ b) = (u : R_E ⧸ I₁) }
    let F_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
      ∃ a : R_F,
        (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
    let U_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ a ∈ m₁,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (1 + a) }
    let N_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ z ∈ I₁,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E (1 + z)) }
    let G_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
      ∃ z ∈ I₂,
        x = Ideal.Quotient.mk I₁ z ∧
        Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ z) = x }
    let B_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
      ∃ a ∈ m₂,
        x = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
    let B_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
      ∃ a ∈ m₁,
        x = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) }
    let T_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
      ∃ z ∈ I₁,
        x = Ideal.Quotient.mk I₀
          (∑ k : Fin (Module.finrank F E),
            galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) }
    0 < Nat.card (B_tr ⧸ T_tr.addSubgroupOf B_tr) ∧
    Nat.card (U_fix ⧸ F_fix.subgroupOf U_fix) ≤
      Nat.card (G_fix ⧸ B_fix.addSubgroupOf G_fix) ∧
    Nat.card (B_tr ⧸ T_tr.addSubgroupOf B_tr) ≤
      Nat.card (U_ker ⧸ N_ker.subgroupOf U_ker) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
  let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
  let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
  let d : ℕ := Module.finrank F E
  let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
  let U_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
    ∃ b : R_E,
      (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b ∧
      Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ b) = (u : R_E ⧸ I₁) }
  let F_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
    ∃ a : R_F,
      (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
  let U_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
    ∃ a ∈ m₁,
      (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (1 + a) }
  let N_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
    ∃ z ∈ I₁,
      (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E (1 + z)) }
  let G_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
    ∃ z ∈ I₂,
      x = Ideal.Quotient.mk I₁ z ∧
      Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ z) = x }
  let B_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
    ∃ a ∈ m₂,
      x = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
  let B_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
    ∃ a ∈ m₁,
      x = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) }
  let T_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
    ∃ z ∈ I₁,
      x = Ideal.Quotient.mk I₀
        (∑ k : Fin d,
          galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) }
  have h_s1 :
      (∀ b : R_E,
        galRestrict R_F F E R_E σ b - b ∈ I₁ →
        ∃ a : R_F, b - algebraMap R_F R_E a ∈ I₂) ∧
      (∀ z ∈ I₁,
        algebraMap R_F R_E (Algebra.intNorm R_F R_E (1 + z)) -
          (1 + ∑ k : Fin d,
            galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) ∈ I₀) := by
    have hd_pos : 0 < d := Module.finrank_pos
    have hd_ne_zero : (d : R_E) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
    have h_card_aut : Nat.card (E ≃ₐ[F] E) = d := IsGalois.card_aut_eq_finrank F E
    have h_order : orderOf σ = d := by
      rw [← h_card_aut]
      exact orderOf_eq_card_of_forall_mem_zpowers hCyclic
    have h_pow_d : σ ^ d = 1 := by
      rw [← h_order, pow_orderOf_eq_one]
    have h_gal_mem_map : ∀ (ρ : E ≃ₐ[F] E) (m : Ideal R_F) {w : R_E},
        w ∈ Ideal.map (algebraMap R_F R_E) m →
        galRestrict R_F F E R_E ρ w ∈ Ideal.map (algebraMap R_F R_E) m := by
      intro ρ m w hw
      have h_mem := Ideal.mem_map_of_mem (galRestrict R_F F E R_E ρ).toRingHom hw
      rw [Ideal.map_map] at h_mem
      have h_comp : (galRestrict R_F F E R_E ρ).toRingHom.comp (algebraMap R_F R_E) =
          algebraMap R_F R_E :=
        (galRestrict R_F F E R_E ρ).toAlgHom.comp_algebraMap
      rwa [h_comp] at h_mem
    have h_gal_zero : ∀ x : R_E, galRestrict R_F F E R_E (σ ^ (0 : ℕ)) x = x := by
      intro x
      rw [pow_zero, map_one, AlgEquiv.one_apply]
    have h_gal_succ : ∀ (k : ℕ) (x : R_E),
        galRestrict R_F F E R_E (σ ^ (k + 1)) x =
          σ_int (galRestrict R_F F E R_E (σ ^ k) x) := by
      intro k x
      rw [pow_succ', map_mul, AlgEquiv.mul_apply]
    have h_gal_d : ∀ x : R_E, galRestrict R_F F E R_E (σ ^ d) x = x := by
      intro x
      rw [h_pow_d, map_one, AlgEquiv.one_apply]
    have h_fixed_elem : ∀ x : R_E, σ_int x = x → ∃ a : R_F, algebraMap R_F R_E a = x := by
      intro x hx
      have hx_E : σ (algebraMap R_E E x) = algebraMap R_E E x := by
        rw [← algebraMap_galRestrict_apply R_F σ x, hx]
      have h_stab : σ ∈ MulAction.stabilizer (E ≃ₐ[F] E) (algebraMap R_E E x) := hx_E
      have h_all : ∀ ρ : E ≃ₐ[F] E, ρ (algebraMap R_E E x) = algebraMap R_E E x := by
        intro ρ
        exact (Subgroup.zpowers_le.mpr h_stab) (hCyclic ρ)
      have h_bot : algebraMap R_E E x ∈ (⊥ : IntermediateField F E) :=
        (IsGalois.mem_bot_iff_fixed (algebraMap R_E E x)).mpr h_all
      rcases IntermediateField.mem_bot.mp h_bot with ⟨y_F, hy_F⟩
      have hx_int : IsIntegral ℤ (algebraMap R_E E x) :=
        (IsIntegralClosure.isIntegral_iff (A := R_E) (R := ℤ) (B := E)).mpr ⟨x, rfl⟩
      rw [← hy_F] at hx_int
      have hy_int : IsIntegral ℤ y_F := by
        have h_tower : algebraMap F E y_F = (IsScalarTower.toAlgHom ℤ F E) y_F := rfl
        rw [h_tower] at hx_int
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom ℤ F E) (algebraMap F E).injective).mp hx_int
      rcases (IsIntegralClosure.isIntegral_iff (A := R_F) (R := ℤ) (B := F)).mp hy_int with ⟨a, ha⟩
      refine ⟨a, ?_⟩
      apply IsIntegralClosure.algebraMap_injective R_E R_F E
      rw [← IsScalarTower.algebraMap_apply R_F R_E E a,
        IsScalarTower.algebraMap_apply R_F F E a, ha, hy_F]
    constructor
    · intro b hb
      have h_pow_sub : ∀ k : ℕ, galRestrict R_F F E R_E (σ ^ k) b - b ∈ I₁ := by
        intro k
        induction k with
        | zero =>
          rw [h_gal_zero, sub_self]
          exact Submodule.zero_mem I₁
        | succ k ih =>
          have h_decomp : galRestrict R_F F E R_E (σ ^ (k + 1)) b - b =
              σ_int (galRestrict R_F F E R_E (σ ^ k) b - b) + (σ_int b - b) := by
            rw [h_gal_succ, map_sub]
            ring
          rw [h_decomp]
          exact Submodule.add_mem I₁ (h_gal_mem_map σ m₁ ih) hb
      let T : R_E := ∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) b
      have hT_range : T = ∑ k ∈ Finset.range d, galRestrict R_F F E R_E (σ ^ k) b :=
        Fin.sum_univ_eq_sum_range (fun k => galRestrict R_F F E R_E (σ ^ k) b) d
      have hT_sub : σ_int T - T = 0 := by
        rw [hT_range, map_sum, ← Finset.sum_sub_distrib]
        have h_congr : (∑ x ∈ Finset.range d, (σ_int (galRestrict R_F F E R_E (σ ^ x) b) -
              galRestrict R_F F E R_E (σ ^ x) b)) =
            ∑ x ∈ Finset.range d, (galRestrict R_F F E R_E (σ ^ (x + 1)) b -
              galRestrict R_F F E R_E (σ ^ x) b) :=
          Finset.sum_congr rfl fun x _ => by rw [h_gal_succ]
        rw [h_congr, Finset.sum_range_sub (fun x => galRestrict R_F F E R_E (σ ^ x) b) d,
          h_gal_d, h_gal_zero, sub_self]
      have hT_fix : σ_int T = T := sub_eq_zero.mp hT_sub
      let z : R_E := T - (d : R_E) * b
      have hz_eq : z = ∑ k : Fin d, (galRestrict R_F F E R_E (σ ^ (k : ℕ)) b - b) := by
        dsimp [z, T]
        rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      have hz_mem : z ∈ I₁ := by
        rw [hz_eq]
        exact Submodule.sum_mem I₁ fun k _ => h_pow_sub (k : ℕ)
      have h_Jd_m₁_eq : J_d * m₁ = Ideal.span {(d : R_F)} * m₂ := by
        rw [hm₁_eq, ← mul_assoc, mul_comm J_d D_ram, h_span_d]
      have h_map_eq : Ideal.map (algebraMap R_F R_E) J_d * I₁ = Ideal.span {(d : R_E)} * I₂ := by
        have h1 := congrArg (Ideal.map (algebraMap R_F R_E)) h_Jd_m₁_eq
        rwa [Ideal.map_mul, Ideal.map_mul, Ideal.map_span, Set.image_singleton, map_natCast] at h1
      have h_t₀_mem_map : algebraMap R_F R_E t₀ ∈ Ideal.map (algebraMap R_F R_E) J_d :=
        Ideal.mem_map_of_mem (algebraMap R_F R_E) ht₀_mem
      have h_t₀z_mem : algebraMap R_F R_E t₀ * z ∈ Ideal.span {(d : R_E)} * I₂ := by
        rw [← h_map_eq]
        exact Ideal.mul_mem_mul h_t₀_mem_map hz_mem
      obtain ⟨u₂, hu₂_mem, hu₂_eq⟩ := Ideal.mem_span_singleton_mul.mp h_t₀z_mem
      let y : R_E := algebraMap R_F R_E t₀ * b + u₂
      have h_dy : (d : R_E) * y = algebraMap R_F R_E t₀ * T := by
        calc
          (d : R_E) * y = (d : R_E) * (algebraMap R_F R_E t₀ * b) + (d : R_E) * u₂ := by
            dsimp [y]; ring
          _ = (d : R_E) * (algebraMap R_F R_E t₀ * b) + algebraMap R_F R_E t₀ * (T - (d : R_E) * b) := by
            rw [hu₂_eq]
          _ = algebraMap R_F R_E t₀ * T := by ring
      have h_dy_fix : (d : R_E) * σ_int y = (d : R_E) * y := by
        have h1 : σ_int ((d : R_E) * y) = (d : R_E) * σ_int y := by
          rw [map_mul, map_natCast]
        rw [← h1, h_dy, map_mul, σ_int.commutes t₀, hT_fix, ← h_dy]
      have hy_fix : σ_int y = y := mul_left_cancel₀ hd_ne_zero h_dy_fix
      obtain ⟨a, ha_eq⟩ := h_fixed_elem y hy_fix
      refine ⟨a, ?_⟩
      have hm₀_le_m₂ : m₀ ≤ m₂ := by
        rw [hm₀_eq, hm₁_eq]
        exact Ideal.mul_le_left.trans Ideal.mul_le_left
      have ht₀_sub_m₂ : t₀ - 1 ∈ m₂ := hm₀_le_m₂ ht₀_sub
      have h_alg_t₀_sub : algebraMap R_F R_E (t₀ - 1) ∈ I₂ :=
        Ideal.mem_map_of_mem (algebraMap R_F R_E) ht₀_sub_m₂
      have h_diff_eq : b - algebraMap R_F R_E a =
          -(algebraMap R_F R_E (t₀ - 1) * b) - u₂ := by
        rw [ha_eq]
        dsimp [y]
        rw [map_sub, map_one]
        ring
      rw [h_diff_eq]
      exact Submodule.sub_mem I₂ (Submodule.neg_mem I₂ (Ideal.mul_mem_right b I₂ h_alg_t₀_sub)) hu₂_mem
    · intro z hz
      have h_bij : Function.Bijective (fun k : Fin d => σ ^ (k : ℕ)) := by
        rw [Fintype.bijective_iff_injective_and_card]
        refine ⟨?_, ?_⟩
        · intro k₁ k₂ hk
          have hk₁ : (k₁ : ℕ) < orderOf σ := by rw [h_order]; exact k₁.isLt
          have hk₂ : (k₂ : ℕ) < orderOf σ := by rw [h_order]; exact k₂.isLt
          exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ hk)
        · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, h_card_aut]
      let e_gal : Fin d ≃ (E ≃ₐ[F] E) := Equiv.ofBijective (fun k : Fin d => σ ^ (k : ℕ)) h_bij
      have h_norm_prod : algebraMap R_F R_E (Algebra.intNorm R_F R_E (1 + z)) =
          ∏ k : Fin d, (1 + galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) := by
        apply IsIntegralClosure.algebraMap_injective R_E R_F E
        rw [← IsScalarTower.algebraMap_apply R_F R_E E, IsScalarTower.algebraMap_apply R_F F E,
          Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E),
          Algebra.norm_eq_prod_automorphisms, map_prod]
        conv_lhs => rw [← Equiv.prod_comp e_gal (fun ρ : E ≃ₐ[F] E => ρ (algebraMap R_E E (1 + z)))]
        refine Finset.prod_congr rfl fun k _ => ?_
        have h_apply := (algebraMap_galRestrict_apply R_F (σ ^ (k : ℕ)) (1 + z)).symm
        dsimp [e_gal]
        rw [h_apply, map_add, map_one]
      have hI₁_sq : I₁ ^ 2 ≤ I₀ := by
        calc
          I₁ ^ 2 = Ideal.map (algebraMap R_F R_E) (m₁ ^ 2) := (Ideal.map_pow (algebraMap R_F R_E) m₁ 2).symm
          _ ≤ Ideal.map (algebraMap R_F R_E) m₀ := Ideal.map_mono hm₁_sq
      have hI₁_mul : ∀ {w₁ w₂ : R_E}, w₁ ∈ I₁ → w₂ ∈ I₁ → w₁ * w₂ ∈ I₀ := by
        intro w₁ w₂ hw₁ hw₂
        rw [sq] at hI₁_sq
        exact hI₁_sq (Ideal.mul_mem_mul hw₁ hw₂)
      have h_ind : ∀ s : Finset (Fin d),
          (∏ k ∈ s, (1 + galRestrict R_F F E R_E (σ ^ (k : ℕ)) z)) -
            (1 + ∑ k ∈ s, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) ∈ I₀ := by
        intro s
        refine Finset.induction_on s ?_ ?_
        · simp
        · intro k₀ s hk₀ ih
          rw [Finset.prod_insert hk₀, Finset.sum_insert hk₀]
          let P := ∏ k ∈ s, (1 + galRestrict R_F F E R_E (σ ^ (k : ℕ)) z)
          let S := ∑ k ∈ s, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z
          let w₀ := galRestrict R_F F E R_E (σ ^ (k₀ : ℕ)) z
          have hw₀ : w₀ ∈ I₁ := h_gal_mem_map (σ ^ (k₀ : ℕ)) m₁ hz
          have hS : S ∈ I₁ := Submodule.sum_mem I₁ fun k _ => h_gal_mem_map (σ ^ (k : ℕ)) m₁ hz
          have h_alg : (1 + w₀) * P - (1 + (w₀ + S)) =
              (P - (1 + S)) + w₀ * (P - (1 + S)) + w₀ * S := by ring
          change (1 + w₀) * P - (1 + (w₀ + S)) ∈ I₀
          rw [h_alg]
          exact Submodule.add_mem I₀
            (Submodule.add_mem I₀ ih (Ideal.mul_mem_left I₀ w₀ ih))
            (hI₁_mul hw₀ hS)
      rw [h_norm_prod]
      exact h_ind Finset.univ
  obtain ⟨h_approx, h_norm_exp⟩ := h_s1
  have h_alg_inj : Function.Injective (algebraMap R_F R_E) :=
    FaithfulSMul.algebraMap_injective R_F R_E
  have h_s2 : Nat.card (U_fix ⧸ F_fix.subgroupOf U_fix) ≤
      Nat.card (G_fix ⧸ B_fix.addSubgroupOf G_fix) := by
    have hI₁_ne : I₁ ≠ ⊥ := (Ideal.map_eq_bot_iff_of_injective h_alg_inj).not.mpr hm₁_ne
    haveI : Finite (R_E ⧸ I₁) := Ideal.finiteQuotientOfFreeOfNeBot I₁ hI₁_ne
    have h_gal_mem_I₁ : ∀ {w : R_E}, w ∈ I₁ → σ_int w ∈ I₁ := by
      intro w hw
      have h_mem := Ideal.mem_map_of_mem σ_int.toRingHom hw
      rw [Ideal.map_map] at h_mem
      have h_comp : σ_int.toRingHom.comp (algebraMap R_F R_E) = algebraMap R_F R_E :=
        σ_int.toAlgHom.comp_algebraMap
      rwa [h_comp] at h_mem
    let σ_bar₁ : (R_E ⧸ I₁) →+* (R_E ⧸ I₁) :=
      Ideal.Quotient.lift I₁ ((Ideal.Quotient.mk I₁).comp σ_int.toRingHom)
        (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (h_gal_mem_I₁ hr))
    have h_σ_bar₁_mk : ∀ r : R_E,
        σ_bar₁ (Ideal.Quotient.mk I₁ r) = Ideal.Quotient.mk I₁ (σ_int r) :=
      fun r => rfl
    have hI₂_sq : I₂ ^ 2 ≤ I₁ := by
      calc
        I₂ ^ 2 = Ideal.map (algebraMap R_F R_E) (m₂ ^ 2) :=
          (Ideal.map_pow (algebraMap R_F R_E) m₂ 2).symm
        _ ≤ Ideal.map (algebraMap R_F R_E) m₁ := Ideal.map_mono hm₂_sq
    have hI₂_mul_zero : ∀ {z₁ z₂ : R_E}, z₁ ∈ I₂ → z₂ ∈ I₂ →
        Ideal.Quotient.mk I₁ z₁ * Ideal.Quotient.mk I₁ z₂ = 0 := by
      intro z₁ z₂ hz₁ hz₂
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      rw [sq] at hI₂_sq
      exact hI₂_sq (Ideal.mul_mem_mul hz₁ hz₂)
    let G_sub : AddSubgroup (R_E ⧸ I₁) :=
      { carrier := { x : R_E ⧸ I₁ | (∃ z ∈ I₂, x = Ideal.Quotient.mk I₁ z) ∧ σ_bar₁ x = x }
        zero_mem' := ⟨⟨0, Submodule.zero_mem I₂, (map_zero _).symm⟩, σ_bar₁.map_zero⟩
        add_mem' := by
          rintro x₁ x₂ ⟨⟨z₁, hz₁, rfl⟩, hx₁_fix⟩ ⟨⟨z₂, hz₂, rfl⟩, hx₂_fix⟩
          refine ⟨⟨z₁ + z₂, Submodule.add_mem I₂ hz₁ hz₂, (map_add _ _ _).symm⟩, ?_⟩
          rw [σ_bar₁.map_add, hx₁_fix, hx₂_fix]
        neg_mem' := by
          rintro x ⟨⟨z, hz, rfl⟩, hx_fix⟩
          refine ⟨⟨-z, Submodule.neg_mem I₂ hz, (map_neg _ _).symm⟩, ?_⟩
          rw [RingHom.map_neg σ_bar₁, hx_fix] }
    have hG_le : G_fix ≤ G_sub := by
      rw [AddSubgroup.closure_le]
      rintro x ⟨z, hz, rfl, h_fix⟩
      exact ⟨⟨z, hz, rfl⟩, h_fix⟩
    have hG_mul_zero : ∀ x y : G_fix, (x : R_E ⧸ I₁) * (y : R_E ⧸ I₁) = 0 := by
      intro x y
      rcases (hG_le x.2).1 with ⟨z₁, hz₁, hx_eq⟩
      rcases (hG_le y.2).1 with ⟨z₂, hz₂, hy_eq⟩
      rw [hx_eq, hy_eq]
      exact hI₂_mul_zero hz₁ hz₂
    let B_sub : AddSubgroup (R_E ⧸ I₁) :=
      { carrier := { x : R_E ⧸ I₁ | ∃ a ∈ m₂, x = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
        zero_mem' := ⟨0, Submodule.zero_mem m₂, by simp⟩
        add_mem' := by
          rintro x₁ x₂ ⟨a₁, ha₁, rfl⟩ ⟨a₂, ha₂, rfl⟩
          exact ⟨a₁ + a₂, Submodule.add_mem m₂ ha₁ ha₂, by simp⟩
        neg_mem' := by
          rintro x ⟨a, ha, rfl⟩
          exact ⟨-a, Submodule.neg_mem m₂ ha, by simp⟩ }
    have hB_le : B_fix ≤ B_sub := by
      rw [AddSubgroup.closure_le]
      rintro x ⟨a, ha, rfl⟩
      exact ⟨a, ha, rfl⟩
    let U_sub : Subgroup (R_E ⧸ I₁)ˣ :=
      { carrier := { u : (R_E ⧸ I₁)ˣ | σ_bar₁ (u : R_E ⧸ I₁) = (u : R_E ⧸ I₁) }
        one_mem' := by change σ_bar₁ 1 = 1; exact σ_bar₁.map_one
        mul_mem' := by
          intro u₁ u₂ hu₁ hu₂
          change σ_bar₁ ((u₁ : R_E ⧸ I₁) * (u₂ : R_E ⧸ I₁)) = (u₁ : R_E ⧸ I₁) * (u₂ : R_E ⧸ I₁)
          rw [σ_bar₁.map_mul, hu₁, hu₂]
        inv_mem' := by
          intro u hu
          change σ_bar₁ (↑u⁻¹ : R_E ⧸ I₁) = (↑u⁻¹ : R_E ⧸ I₁)
          have h_mul : σ_bar₁ (↑u⁻¹ : R_E ⧸ I₁) * (u : R_E ⧸ I₁) = 1 := by
            rw [← hu, ← σ_bar₁.map_mul, Units.inv_mul, σ_bar₁.map_one]
          have h_eq := congrArg (· * (↑u⁻¹ : R_E ⧸ I₁)) h_mul
          dsimp at h_eq
          rwa [mul_assoc, Units.mul_inv, mul_one, one_mul] at h_eq }
    have hU_le : U_fix ≤ U_sub := by
      rw [Subgroup.closure_le]
      rintro u ⟨b, hb_eq, hb_fix⟩
      change σ_bar₁ (u : R_E ⧸ I₁) = (u : R_E ⧸ I₁)
      rw [hb_eq, h_σ_bar₁_mk, ← hb_eq, hb_fix]
    have h_mem_U_fix_of_fix : ∀ u : (R_E ⧸ I₁)ˣ,
        σ_bar₁ (u : R_E ⧸ I₁) = (u : R_E ⧸ I₁) → u ∈ U_fix := by
      intro u hu
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (u : R_E ⧸ I₁)
      apply Subgroup.subset_closure
      refine ⟨b, hb.symm, ?_⟩
      rw [← h_σ_bar₁_mk, hb, hu]
    let u₁ : G_fix → (R_E ⧸ I₁)ˣ := fun x =>
      { val := 1 + (x : R_E ⧸ I₁)
        inv := 1 - (x : R_E ⧸ I₁)
        val_inv := by
          have h0 : (x : R_E ⧸ I₁) * (x : R_E ⧸ I₁) = 0 := hG_mul_zero x x
          calc
            (1 + (x : R_E ⧸ I₁)) * (1 - (x : R_E ⧸ I₁)) = 1 - (x : R_E ⧸ I₁) * (x : R_E ⧸ I₁) := by ring
            _ = 1 := by rw [h0, sub_zero]
        inv_val := by
          have h0 : (x : R_E ⧸ I₁) * (x : R_E ⧸ I₁) = 0 := hG_mul_zero x x
          calc
            (1 - (x : R_E ⧸ I₁)) * (1 + (x : R_E ⧸ I₁)) = 1 - (x : R_E ⧸ I₁) * (x : R_E ⧸ I₁) := by ring
            _ = 1 := by rw [h0, sub_zero] }
    have hu₁_mem : ∀ x : G_fix, u₁ x ∈ U_fix := by
      intro x
      apply h_mem_U_fix_of_fix
      change σ_bar₁ (1 + (x : R_E ⧸ I₁)) = 1 + (x : R_E ⧸ I₁)
      rw [σ_bar₁.map_add, σ_bar₁.map_one, (hG_le x.2).2]
    let exp₁ : G_fix → U_fix := fun x => ⟨u₁ x, hu₁_mem x⟩
    have hexp₁_add : ∀ x y : G_fix, exp₁ (x + y) = exp₁ x * exp₁ y := by
      intro x y
      apply Subtype.ext
      apply Units.ext
      change (1 : R_E ⧸ I₁) + ((x : R_E ⧸ I₁) + (y : R_E ⧸ I₁)) =
        (1 + (x : R_E ⧸ I₁)) * (1 + (y : R_E ⧸ I₁))
      have h0 : (x : R_E ⧸ I₁) * (y : R_E ⧸ I₁) = 0 := hG_mul_zero x y
      calc
        (1 : R_E ⧸ I₁) + ((x : R_E ⧸ I₁) + (y : R_E ⧸ I₁)) =
            (1 + (x : R_E ⧸ I₁)) * (1 + (y : R_E ⧸ I₁)) - (x : R_E ⧸ I₁) * (y : R_E ⧸ I₁) := by ring
        _ = (1 + (x : R_E ⧸ I₁)) * (1 + (y : R_E ⧸ I₁)) := by rw [h0, sub_zero]
    have hexp₁_zero : exp₁ 0 = 1 := by
      apply Subtype.ext
      apply Units.ext
      change (1 : R_E ⧸ I₁) + 0 = 1
      exact add_zero 1
    have hexp₁_neg : ∀ x : G_fix, exp₁ (-x) = (exp₁ x)⁻¹ := by
      intro x
      apply mul_left_cancel (a := exp₁ x)
      rw [← hexp₁_add, add_neg_cancel, hexp₁_zero, mul_inv_cancel]
    have hexp₁_B : ∀ x : G_fix, x ∈ B_fix.addSubgroupOf G_fix →
        exp₁ x ∈ F_fix.subgroupOf U_fix := by
      intro x hx
      change u₁ x ∈ F_fix
      rcases hB_le hx with ⟨a, _, ha_eq⟩
      have ha_eq' : (x : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) := ha_eq
      apply Subgroup.subset_closure
      refine ⟨1 + a, ?_⟩
      change (1 : R_E ⧸ I₁) + (x : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E (1 + a))
      rw [ha_eq', map_add, map_one, map_add, map_one]
    let ψ₁ : G_fix → U_fix ⧸ F_fix.subgroupOf U_fix :=
      fun x => QuotientGroup.mk (exp₁ x)
    have hψ₁_rel : ∀ x₁ x₂ : G_fix,
        QuotientAddGroup.leftRel (B_fix.addSubgroupOf G_fix) x₁ x₂ → ψ₁ x₁ = ψ₁ x₂ := by
      intro x₁ x₂ hrel
      rw [QuotientAddGroup.leftRel_apply] at hrel
      dsimp [ψ₁]
      apply QuotientGroup.eq.mpr
      have h_eq : (exp₁ x₁)⁻¹ * exp₁ x₂ = exp₁ (-x₁ + x₂) := by
        rw [hexp₁_add, hexp₁_neg]
      rw [h_eq]
      exact hexp₁_B (-x₁ + x₂) hrel
    let ψ₁_bar : (G_fix ⧸ B_fix.addSubgroupOf G_fix) → (U_fix ⧸ F_fix.subgroupOf U_fix) :=
      Quotient.lift ψ₁ hψ₁_rel
    have hψ₁_bar_surj : Function.Surjective ψ₁_bar := by
      intro q
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective ((u : (R_E ⧸ I₁)ˣ) : R_E ⧸ I₁)
      have hu_fix : σ_bar₁ ((u : (R_E ⧸ I₁)ˣ) : R_E ⧸ I₁) = ((u : (R_E ⧸ I₁)ˣ) : R_E ⧸ I₁) :=
        hU_le u.2
      have hb_sub : σ_int b - b ∈ I₁ := by
        apply Ideal.Quotient.eq.mp
        rw [← h_σ_bar₁_mk, hb, hu_fix]
      obtain ⟨a, hw₂_mem⟩ := h_approx b hb_sub
      let w₂ : R_E := b - algebraMap R_F R_E a
      change w₂ ∈ I₂ at hw₂_mem
      let w₂_bar : R_E ⧸ I₁ := Ideal.Quotient.mk I₁ w₂
      have hw₂_sq : w₂_bar * w₂_bar = 0 := hI₂_mul_zero hw₂_mem hw₂_mem
      let u_val : R_E ⧸ I₁ := ((u : (R_E ⧸ I₁)ˣ) : R_E ⧸ I₁)
      let u_inv : R_E ⧸ I₁ := (↑(u : (R_E ⧸ I₁)ˣ)⁻¹ : R_E ⧸ I₁)
      have hu_mul_inv : u_val * u_inv = 1 := (u : (R_E ⧸ I₁)ˣ).val_inv
      let a_bar : R_E ⧸ I₁ := Ideal.Quotient.mk I₁ (algebraMap R_F R_E a)
      have ha_bar_eq : a_bar = u_val - w₂_bar := by
        change Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) =
          ((u : (R_E ⧸ I₁)ˣ) : R_E ⧸ I₁) - Ideal.Quotient.mk I₁ (b - algebraMap R_F R_E a)
        rw [← hb, map_sub, sub_sub_cancel]
      let v_inv : R_E ⧸ I₁ := u_inv * (1 + u_inv * w₂_bar)
      have hv_val_inv : a_bar * v_inv = 1 := by
        rw [ha_bar_eq]
        dsimp [v_inv]
        calc
          (u_val - w₂_bar) * (u_inv * (1 + u_inv * w₂_bar))
              = (u_val * u_inv) * (1 + u_inv * w₂_bar) - w₂_bar * u_inv -
                  u_inv * u_inv * (w₂_bar * w₂_bar) := by ring
          _ = 1 * (1 + u_inv * w₂_bar) - w₂_bar * u_inv - u_inv * u_inv * 0 := by
              rw [hu_mul_inv, hw₂_sq]
          _ = 1 := by ring
      have hv_inv_val : v_inv * a_bar = 1 := by
        rw [mul_comm, hv_val_inv]
      let v : (R_E ⧸ I₁)ˣ :=
        { val := a_bar
          inv := v_inv
          val_inv := hv_val_inv
          inv_val := hv_inv_val }
      have hv_F : v ∈ F_fix := Subgroup.subset_closure ⟨a, rfl⟩
      have hv_U : v ∈ U_fix := by
        apply h_mem_U_fix_of_fix
        change σ_bar₁ (Ideal.Quotient.mk I₁ (algebraMap R_F R_E a)) =
          Ideal.Quotient.mk I₁ (algebraMap R_F R_E a)
        rw [h_σ_bar₁_mk, σ_int.commutes]
      let v_U : U_fix := ⟨v, hv_U⟩
      have hv_U_F : v_U ∈ F_fix.subgroupOf U_fix := hv_F
      obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective v_inv
      let z : R_E := w₂ * c
      have hz_mem : z ∈ I₂ := Ideal.mul_mem_right c I₂ hw₂_mem
      let x₀ : R_E ⧸ I₁ := Ideal.Quotient.mk I₁ z
      have hx₀_eq : x₀ = u_val * v_inv - 1 := by
        calc
          x₀ = w₂_bar * v_inv := by
            dsimp [x₀, z, w₂_bar]
            rw [map_mul, hc]
          _ = (u_val - a_bar) * v_inv := by
            rw [ha_bar_eq]
            ring
          _ = u_val * v_inv - a_bar * v_inv := by ring
          _ = u_val * v_inv - 1 := by rw [hv_val_inv]
      have hx₀_fix : σ_bar₁ x₀ = x₀ := by
        have h_uv_fix : σ_bar₁ (u_val * v_inv) = u_val * v_inv :=
          hU_le (u * v_U⁻¹).2
        rw [hx₀_eq, RingHom.map_sub σ_bar₁, σ_bar₁.map_one, h_uv_fix]
      have hx₀_G : x₀ ∈ G_fix := by
        apply AddSubgroup.subset_closure
        refine ⟨z, hz_mem, rfl, ?_⟩
        rw [← h_σ_bar₁_mk]
        exact hx₀_fix
      let x : G_fix := ⟨x₀, hx₀_G⟩
      refine ⟨QuotientAddGroup.mk x, ?_⟩
      change QuotientGroup.mk (exp₁ x) = QuotientGroup.mk u
      apply QuotientGroup.eq.mpr
      have hexp_x : exp₁ x = u * v_U⁻¹ := by
        apply Subtype.ext
        apply Units.ext
        change 1 + x₀ = u_val * v_inv
        rw [hx₀_eq, add_sub_cancel]
      have h_inv_mul : (exp₁ x)⁻¹ * u = v_U := by
        rw [hexp_x, mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one]
      rw [h_inv_mul]
      exact hv_U_F
    exact Nat.card_le_card_of_surjective ψ₁_bar hψ₁_bar_surj
  have h_s3 : 0 < Nat.card (B_tr ⧸ T_tr.addSubgroupOf B_tr) ∧
      Nat.card (B_tr ⧸ T_tr.addSubgroupOf B_tr) ≤
        Nat.card (U_ker ⧸ N_ker.subgroupOf U_ker) := by
    have hI₀_ne : I₀ ≠ ⊥ := (Ideal.map_eq_bot_iff_of_injective h_alg_inj).not.mpr hm₀_ne
    haveI : Finite (R_F ⧸ m₀) := Ideal.finiteQuotientOfFreeOfNeBot m₀ hm₀_ne
    haveI : Finite (R_E ⧸ I₀) := Ideal.finiteQuotientOfFreeOfNeBot I₀ hI₀_ne
    refine ⟨Nat.card_pos, ?_⟩
    have hI₁_sq : I₁ ^ 2 ≤ I₀ := by
      calc
        I₁ ^ 2 = Ideal.map (algebraMap R_F R_E) (m₁ ^ 2) :=
          (Ideal.map_pow (algebraMap R_F R_E) m₁ 2).symm
        _ ≤ Ideal.map (algebraMap R_F R_E) m₀ := Ideal.map_mono hm₁_sq
    have hI₁_mul_zero : ∀ {z₁ z₂ : R_E}, z₁ ∈ I₁ → z₂ ∈ I₁ →
        Ideal.Quotient.mk I₀ z₁ * Ideal.Quotient.mk I₀ z₂ = 0 := by
      intro z₁ z₂ hz₁ hz₂
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      rw [sq] at hI₁_sq
      exact hI₁_sq (Ideal.mul_mem_mul hz₁ hz₂)
    let J₁₀ : AddSubgroup (R_E ⧸ I₀) :=
      { carrier := { x : R_E ⧸ I₀ | ∃ z ∈ I₁, x = Ideal.Quotient.mk I₀ z }
        zero_mem' := ⟨0, Submodule.zero_mem I₁, (map_zero _).symm⟩
        add_mem' := by
          rintro x₁ x₂ ⟨z₁, hz₁, rfl⟩ ⟨z₂, hz₂, rfl⟩
          exact ⟨z₁ + z₂, Submodule.add_mem I₁ hz₁ hz₂, (map_add _ _ _).symm⟩
        neg_mem' := by
          rintro x ⟨z, hz, rfl⟩
          exact ⟨-z, Submodule.neg_mem I₁ hz, (map_neg _ _).symm⟩ }
    have hJ₁₀_mul_zero : ∀ {x y : R_E ⧸ I₀}, x ∈ J₁₀ → y ∈ J₁₀ → x * y = 0 := by
      rintro x y ⟨z₁, hz₁, rfl⟩ ⟨z₂, hz₂, rfl⟩
      exact hI₁_mul_zero hz₁ hz₂
    let B_sub₀ : AddSubgroup (R_E ⧸ I₀) :=
      { carrier := { x : R_E ⧸ I₀ | ∃ a ∈ m₁, x = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) }
        zero_mem' := ⟨0, Submodule.zero_mem m₁, by simp⟩
        add_mem' := by
          rintro x₁ x₂ ⟨a₁, ha₁, rfl⟩ ⟨a₂, ha₂, rfl⟩
          exact ⟨a₁ + a₂, Submodule.add_mem m₁ ha₁ ha₂, by simp⟩
        neg_mem' := by
          rintro x ⟨a, ha, rfl⟩
          exact ⟨-a, Submodule.neg_mem m₁ ha, by simp⟩ }
    have hB_tr_le_sub : B_tr ≤ B_sub₀ := by
      rw [AddSubgroup.closure_le]
      rintro x ⟨a, ha, rfl⟩
      exact ⟨a, ha, rfl⟩
    have hB_tr_le_J₁₀ : B_tr ≤ J₁₀ := by
      intro x hx
      rcases hB_tr_le_sub hx with ⟨a, ha, rfl⟩
      exact ⟨algebraMap R_F R_E a, Ideal.mem_map_of_mem (algebraMap R_F R_E) ha, rfl⟩
    have h_gal_mem_I₁ : ∀ (ρ : E ≃ₐ[F] E) {w : R_E}, w ∈ I₁ →
        galRestrict R_F F E R_E ρ w ∈ I₁ := by
      intro ρ w hw
      have h_mem := Ideal.mem_map_of_mem (galRestrict R_F F E R_E ρ).toRingHom hw
      rw [Ideal.map_map] at h_mem
      have h_comp : (galRestrict R_F F E R_E ρ).toRingHom.comp (algebraMap R_F R_E) =
          algebraMap R_F R_E :=
        (galRestrict R_F F E R_E ρ).toAlgHom.comp_algebraMap
      rwa [h_comp] at h_mem
    have hT_tr_le_J₁₀ : T_tr ≤ J₁₀ := by
      rw [AddSubgroup.closure_le]
      rintro x ⟨z, hz, rfl⟩
      refine ⟨∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z, ?_, rfl⟩
      exact Submodule.sum_mem I₁ fun k _ => h_gal_mem_I₁ (σ ^ (k : ℕ)) hz
    let ι₀ : (R_F ⧸ m₀) →+* (R_E ⧸ I₀) :=
      Ideal.quotientMap I₀ (algebraMap R_F R_E) Ideal.le_comap_map
    have hι₀_mk : ∀ a : R_F,
        ι₀ (Ideal.Quotient.mk m₀ a) = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) :=
      fun a => Ideal.quotientMap_mk
    let lam₀ : (R_F ⧸ m₀)ˣ → (R_E ⧸ I₀) := fun u => ι₀ (u : R_F ⧸ m₀) - 1
    have hlam₀_one : lam₀ 1 = 0 := by
      change ι₀ 1 - 1 = 0
      rw [map_one, sub_self]
    have hlam₀_mul : ∀ {u v : (R_F ⧸ m₀)ˣ}, lam₀ u ∈ J₁₀ → lam₀ v ∈ J₁₀ →
        lam₀ (u * v) = lam₀ u + lam₀ v := by
      intro u v hu hv
      have h0 : lam₀ u * lam₀ v = 0 := hJ₁₀_mul_zero hu hv
      change ι₀ ((u : R_F ⧸ m₀) * (v : R_F ⧸ m₀)) - 1 =
        (ι₀ (u : R_F ⧸ m₀) - 1) + (ι₀ (v : R_F ⧸ m₀) - 1)
      rw [map_mul]
      calc
        ι₀ (u : R_F ⧸ m₀) * ι₀ (v : R_F ⧸ m₀) - 1
            = (ι₀ (u : R_F ⧸ m₀) - 1) + (ι₀ (v : R_F ⧸ m₀) - 1) + lam₀ u * lam₀ v := by
              dsimp [lam₀]; ring
        _ = (ι₀ (u : R_F ⧸ m₀) - 1) + (ι₀ (v : R_F ⧸ m₀) - 1) := by rw [h0, add_zero]
    have hlam₀_inv : ∀ {u : (R_F ⧸ m₀)ˣ}, lam₀ u ∈ J₁₀ → lam₀ u⁻¹ = -lam₀ u := by
      intro u hu
      have h0 : lam₀ u * lam₀ u = 0 := hJ₁₀_mul_zero hu hu
      have h_inv_mul : ι₀ (↑u⁻¹ : R_F ⧸ m₀) * ι₀ (u : R_F ⧸ m₀) = 1 := by
        rw [← map_mul, Units.inv_mul, map_one]
      have h_prod : ι₀ (u : R_F ⧸ m₀) * (1 - lam₀ u) = 1 := by
        calc
          ι₀ (u : R_F ⧸ m₀) * (1 - lam₀ u)
              = (1 + lam₀ u) * (1 - lam₀ u) := by dsimp [lam₀]; ring
          _ = 1 - lam₀ u * lam₀ u := by ring
          _ = 1 := by rw [h0, sub_zero]
      have h_inv_eq : ι₀ (↑u⁻¹ : R_F ⧸ m₀) = 1 - lam₀ u := by
        calc
          ι₀ (↑u⁻¹ : R_F ⧸ m₀) = ι₀ (↑u⁻¹ : R_F ⧸ m₀) * (ι₀ (u : R_F ⧸ m₀) * (1 - lam₀ u)) := by
            rw [h_prod, mul_one]
          _ = (ι₀ (↑u⁻¹ : R_F ⧸ m₀) * ι₀ (u : R_F ⧸ m₀)) * (1 - lam₀ u) := by ring
          _ = 1 - lam₀ u := by rw [h_inv_mul, one_mul]
      change ι₀ (↑u⁻¹ : R_F ⧸ m₀) - 1 = -lam₀ u
      rw [h_inv_eq]
      ring
    let H_sub : ∀ (A : AddSubgroup (R_E ⧸ I₀)), A ≤ J₁₀ → Subgroup (R_F ⧸ m₀)ˣ :=
      fun A hA =>
        { carrier := { u : (R_F ⧸ m₀)ˣ | lam₀ u ∈ A }
          one_mem' := by change lam₀ 1 ∈ A; rw [hlam₀_one]; exact A.zero_mem
          mul_mem' := by
            intro u v hu hv
            change lam₀ (u * v) ∈ A
            rw [hlam₀_mul (hA hu) (hA hv)]
            exact A.add_mem hu hv
          inv_mem' := by
            intro u hu
            change lam₀ u⁻¹ ∈ A
            rw [hlam₀_inv (hA hu)]
            exact A.neg_mem hu }
    have hU_ker_le : U_ker ≤ H_sub B_tr hB_tr_le_J₁₀ := by
      rw [Subgroup.closure_le]
      rintro u ⟨a, ha, hu_eq⟩
      change lam₀ u ∈ B_tr
      have h_eq : lam₀ u = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) := by
        change ι₀ (u : R_F ⧸ m₀) - 1 = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a)
        rw [hu_eq, hι₀_mk, map_add, map_one, map_add, map_one, add_sub_cancel_left]
      rw [h_eq]
      exact AddSubgroup.subset_closure ⟨a, ha, rfl⟩
    have hN_ker_le : N_ker ≤ H_sub T_tr hT_tr_le_J₁₀ := by
      rw [Subgroup.closure_le]
      rintro u ⟨z, hz, hu_eq⟩
      change lam₀ u ∈ T_tr
      have h_eq : lam₀ u = Ideal.Quotient.mk I₀
          (∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) := by
        change ι₀ (u : R_F ⧸ m₀) - 1 = _
        rw [hu_eq, hι₀_mk]
        have h_mk_eq : Ideal.Quotient.mk I₀ (algebraMap R_F R_E (Algebra.intNorm R_F R_E (1 + z))) =
            Ideal.Quotient.mk I₀ (1 + ∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) :=
          Ideal.Quotient.eq.mpr (h_norm_exp z hz)
        rw [h_mk_eq, map_add, map_one, add_sub_cancel_left]
      rw [h_eq]
      exact AddSubgroup.subset_closure ⟨z, hz, rfl⟩
    let L₀ : U_ker → B_tr := fun u => ⟨lam₀ (u : (R_F ⧸ m₀)ˣ), hU_ker_le u.2⟩
    have hL₀_mul : ∀ u v : U_ker, L₀ (u * v) = L₀ u + L₀ v := by
      intro u v
      apply Subtype.ext
      exact hlam₀_mul (hB_tr_le_J₁₀ (hU_ker_le u.2)) (hB_tr_le_J₁₀ (hU_ker_le v.2))
    have hL₀_inv : ∀ u : U_ker, L₀ u⁻¹ = -L₀ u := by
      intro u
      apply Subtype.ext
      exact hlam₀_inv (hB_tr_le_J₁₀ (hU_ker_le u.2))
    let ψ₀ : U_ker → B_tr ⧸ T_tr.addSubgroupOf B_tr :=
      fun u => QuotientAddGroup.mk (L₀ u)
    have hψ₀_rel : ∀ u₁ u₂ : U_ker,
        QuotientGroup.leftRel (N_ker.subgroupOf U_ker) u₁ u₂ → ψ₀ u₁ = ψ₀ u₂ := by
      intro u₁ u₂ hrel
      rw [QuotientGroup.leftRel_apply] at hrel
      dsimp [ψ₀]
      apply QuotientAddGroup.eq.mpr
      have h_eq : -L₀ u₁ + L₀ u₂ = L₀ (u₁⁻¹ * u₂) := by
        rw [hL₀_mul, hL₀_inv]
      rw [h_eq]
      exact hN_ker_le hrel
    let ψ₀_bar : (U_ker ⧸ N_ker.subgroupOf U_ker) → (B_tr ⧸ T_tr.addSubgroupOf B_tr) :=
      Quotient.lift ψ₀ hψ₀_rel
    have hψ₀_bar_surj : Function.Surjective ψ₀_bar := by
      intro q
      obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
      rcases hB_tr_le_sub x.2 with ⟨a, ha, hx_eq⟩
      have ha_sq_mem : a * a ∈ m₀ := by
        have h_sq := hm₁_sq
        rw [sq] at h_sq
        exact h_sq (Ideal.mul_mem_mul ha ha)
      have ha_sq_zero : Ideal.Quotient.mk m₀ a * Ideal.Quotient.mk m₀ a = 0 := by
        rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
        exact ha_sq_mem
      let u_a : (R_F ⧸ m₀)ˣ :=
        { val := Ideal.Quotient.mk m₀ (1 + a)
          inv := Ideal.Quotient.mk m₀ (1 - a)
          val_inv := by
            rw [map_add, map_sub, map_one]
            calc
              (1 + Ideal.Quotient.mk m₀ a) * (1 - Ideal.Quotient.mk m₀ a)
                  = 1 - Ideal.Quotient.mk m₀ a * Ideal.Quotient.mk m₀ a := by ring
              _ = 1 := by rw [ha_sq_zero, sub_zero]
          inv_val := by
            rw [map_add, map_sub, map_one]
            calc
              (1 - Ideal.Quotient.mk m₀ a) * (1 + Ideal.Quotient.mk m₀ a)
                  = 1 - Ideal.Quotient.mk m₀ a * Ideal.Quotient.mk m₀ a := by ring
              _ = 1 := by rw [ha_sq_zero, sub_zero] }
      have hu_a_mem : u_a ∈ U_ker := Subgroup.subset_closure ⟨a, ha, rfl⟩
      let u : U_ker := ⟨u_a, hu_a_mem⟩
      refine ⟨QuotientGroup.mk u, ?_⟩
      change QuotientAddGroup.mk (L₀ u) = QuotientAddGroup.mk x
      congr 1
      apply Subtype.ext
      change ι₀ (Ideal.Quotient.mk m₀ (1 + a)) - 1 = (x : R_E ⧸ I₀)
      rw [hι₀_mk, map_add, map_one, map_add, map_one, add_sub_cancel_left, hx_eq]
    exact Nat.card_le_card_of_surjective ψ₀_bar hψ₀_bar_surj
  exact ⟨h_s3.1, h_s2, h_s3.2⟩

theorem exists_normalBasis_addSubgroup_le_map {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₂ : Ideal (NumberField.RingOfIntegers F))
    (hm₂_ne : m₂ ≠ ⊥) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let d := Module.finrank F E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let Tr_G : R_E → R_E := fun z =>
      ∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z
    let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
    ∃ (L' : AddSubgroup R_E) (a₀ : R_F),
      a₀ ≠ 0 ∧
      L' ≤ I₂.toAddSubgroup ∧
      (∀ (a : R_F) (z : R_E), z ∈ L' → algebraMap R_F R_E a * z ∈ L') ∧
      (∀ z : R_E, z ∈ L' → σ_int z ∈ L') ∧
      (∀ z : R_E, algebraMap R_F R_E a₀ * z ∈ L') ∧
      (∀ x : R_E, x ∈ L' → σ_int x = x → ∃ w ∈ L', Tr_G w = x) ∧
      (∀ y : R_E, y ∈ L' → Tr_G y = 0 → ∃ w ∈ L', w - σ_int w = y) :=
by
  classical
  intro R_F R_E d σ_int Tr_G I₂
  
  let b₀ : Module.Basis (E ≃ₐ[F] E) F E := IsGalois.normalBasis F E
  let x₀ : E := b₀ 1
  haveI : IsLocalization (Algebra.algebraMapSubmonoid R_E (nonZeroDivisors ℤ)) E :=
    IsIntegralClosure.isLocalization ℤ ℚ E R_E
  obtain ⟨⟨y₀, s⟩, hy₀⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid R_E (nonZeroDivisors ℤ)) x₀
  rcases s.2 with ⟨d₀, hd₀_mem, hd₀_eq⟩
  have hd₀_ne : d₀ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hd₀_mem
  have hy₀_eq : algebraMap R_E E y₀ = (d₀ : E) * x₀ := by
    dsimp at hy₀
    rw [← hy₀, ← hd₀_eq]
    simp [mul_comm]
  obtain ⟨m₂', hm₂'_mem, hm₂'_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm₂_ne
  let θ : R_E := algebraMap R_F R_E m₂' * y₀
  let c₀ : F := algebraMap R_F F m₂' * (d₀ : F)
  have hc₀_ne : c₀ ≠ 0 := by
    refine mul_ne_zero ?_ (Int.cast_ne_zero.mpr hd₀_ne)
    exact (map_ne_zero_iff (algebraMap R_F F) (FaithfulSMul.algebraMap_injective R_F F)).mpr hm₂'_ne
  have hθ_apply : ∀ ρ : E ≃ₐ[F] E,
      algebraMap R_E E (galRestrict R_F F E R_E ρ θ) = c₀ • b₀ ρ := by
    intro ρ
    rw [algebraMap_galRestrict_apply]
    have hθ_E : algebraMap R_E E θ = c₀ • x₀ := by
      dsimp [θ, c₀]
      rw [map_mul, ← IsScalarTower.algebraMap_apply R_F R_E E,
        IsScalarTower.algebraMap_apply R_F F E, hy₀_eq, Algebra.smul_def,
        map_mul, map_intCast, mul_assoc]
    rw [hθ_E, map_smul, IsGalois.normalBasis_apply]
  have hθ_mem : ∀ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ θ ∈ I₂ := by
    intro ρ
    dsimp [θ]
    rw [map_mul, AlgEquiv.commutes]
    exact Ideal.mul_mem_right _ I₂ (Ideal.mem_map_of_mem (algebraMap R_F R_E) hm₂'_mem)
  let Φ : ((E ≃ₐ[F] E) → R_F) →+ R_E :=
    { toFun := fun f => ∑ ρ : E ≃ₐ[F] E, algebraMap R_F R_E (f ρ) * galRestrict R_F F E R_E ρ θ
      map_zero' := by simp
      map_add' := fun f₁ f₂ => by
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib] }
  have hΦ_apply : ∀ f : (E ≃ₐ[F] E) → R_F,
      Φ f = ∑ ρ : E ≃ₐ[F] E, algebraMap R_F R_E (f ρ) * galRestrict R_F F E R_E ρ θ :=
    fun _ => rfl
  have hθ_indep : ∀ f : (E ≃ₐ[F] E) → R_F, Φ f = 0 → ∀ ρ : E ≃ₐ[F] E, f ρ = 0 := by
    intro f hf ρ
    have hf_E : algebraMap R_E E (Φ f) = 0 := by rw [hf, map_zero]
    rw [hΦ_apply, map_sum] at hf_E
    have hf_basis : (∑ τ : E ≃ₐ[F] E, (algebraMap R_F F (f τ) * c₀) • b₀ τ) = 0 := by
      rw [← hf_E]
      refine Finset.sum_congr rfl fun τ _ => ?_
      rw [(algebraMap R_E E).map_mul, ← IsScalarTower.algebraMap_apply R_F R_E E,
        IsScalarTower.algebraMap_apply R_F F E, hθ_apply τ,
        mul_smul, Algebra.smul_def, Algebra.smul_def]
    have h_coeff := Fintype.linearIndependent_iff.mp b₀.linearIndependent
      (fun τ => algebraMap R_F F (f τ) * c₀) hf_basis ρ
    have hf_F : algebraMap R_F F (f ρ) = 0 := (mul_eq_zero.mp h_coeff).resolve_right hc₀_ne
    exact (map_eq_zero_iff (algebraMap R_F F) (FaithfulSMul.algebraMap_injective R_F F)).mp hf_F
  have hθ_span_F : ∀ x : E, ∃ g : (E ≃ₐ[F] E) → F,
      x = ∑ ρ : E ≃ₐ[F] E, g ρ • algebraMap R_E E (galRestrict R_F F E R_E ρ θ) := by
    intro x
    refine ⟨fun ρ => c₀⁻¹ * b₀.repr x ρ, ?_⟩
    calc
      x = ∑ ρ : E ≃ₐ[F] E, (b₀.repr x ρ) • b₀ ρ := (b₀.sum_repr x).symm
      _ = ∑ ρ : E ≃ₐ[F] E, (c₀⁻¹ * b₀.repr x ρ) • algebraMap R_E E (galRestrict R_F F E R_E ρ θ) := by
        refine Finset.sum_congr rfl fun ρ _ => ?_
        rw [hθ_apply ρ, smul_smul, mul_right_comm, inv_mul_cancel₀ hc₀_ne, one_mul]
  
  have h_pt : ∀ z : R_E, ∃ (s_z : R_F) (f : (E ≃ₐ[F] E) → R_F),
      s_z ≠ 0 ∧ algebraMap R_F R_E s_z * z = Φ f := by
    intro z
    obtain ⟨g, hg⟩ := hθ_span_F (algebraMap R_E E z)
    have h_frac : ∀ ρ : E ≃ₐ[F] E, ∃ (n d_ρ : R_F),
        d_ρ ∈ nonZeroDivisors R_F ∧ algebraMap R_F F n / algebraMap R_F F d_ρ = g ρ :=
      fun ρ => IsFractionRing.div_surjective (A := R_F) (g ρ)
    choose n d_ρ hd_mem hd_eq using h_frac
    let s_z : R_F := ∏ τ : E ≃ₐ[F] E, d_ρ τ
    have hs_ne : s_z ≠ 0 := Finset.prod_ne_zero_iff.mpr fun τ _ => mem_nonZeroDivisors_iff_ne_zero.mp (hd_mem τ)
    let f : (E ≃ₐ[F] E) → R_F := fun ρ =>
      n ρ * ∏ τ ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase ρ, d_ρ τ
    refine ⟨s_z, f, hs_ne, ?_⟩
    apply FaithfulSMul.algebraMap_injective R_E E
    rw [hΦ_apply, (algebraMap R_E E).map_mul, ← IsScalarTower.algebraMap_apply R_F R_E E,
      IsScalarTower.algebraMap_apply R_F F E, hg, ← Algebra.smul_def,
      Finset.smul_sum, map_sum]
    refine Finset.sum_congr rfl fun ρ _ => ?_
    rw [(algebraMap R_E E).map_mul, ← IsScalarTower.algebraMap_apply R_F R_E E,
      IsScalarTower.algebraMap_apply R_F F E, ← Algebra.smul_def, smul_smul]
    congr 1
    have hd_ne : algebraMap R_F F (d_ρ ρ) ≠ 0 :=
      (map_ne_zero_iff (algebraMap R_F F) (FaithfulSMul.algebraMap_injective R_F F)).mpr
        (mem_nonZeroDivisors_iff_ne_zero.mp (hd_mem ρ))
    have hs_split : s_z = d_ρ ρ * ∏ τ ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase ρ, d_ρ τ :=
      (Finset.mul_prod_erase Finset.univ d_ρ (Finset.mem_univ ρ)).symm
    have hn_eq : algebraMap R_F F (n ρ) = g ρ * algebraMap R_F F (d_ρ ρ) :=
      (div_eq_iff hd_ne).mp (hd_eq ρ)
    dsimp [f]
    rw [hs_split, map_mul, map_mul, hn_eq]
    ring
  let ι_E := Module.Free.ChooseBasisIndex ℤ R_E
  let ω : Module.Basis ι_E ℤ R_E := NumberField.RingOfIntegers.basis E
  choose s_ω f_s hs_ne hf_s using fun i : ι_E => h_pt (ω i)
  let a₀ : R_F := ∏ i : ι_E, s_ω i
  have ha₀_ne : a₀ ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hs_ne i
  have ha₀_mem : ∀ z : R_E, algebraMap R_F R_E a₀ * z ∈ Φ.range := by
    intro z
    let c : ι_E → R_F := fun i => ∏ j ∈ (Finset.univ : Finset ι_E).erase i, s_ω j
    have ha₀_split : ∀ i : ι_E, a₀ = c i * s_ω i := fun i => by
      dsimp [a₀, c]
      rw [mul_comm]
      exact (Finset.mul_prod_erase Finset.univ s_ω (Finset.mem_univ i)).symm
    refine ⟨fun ρ => ∑ i : ι_E, (ω.repr z i) • (c i * f_s i ρ), ?_⟩
    rw [hΦ_apply]
    symm
    calc
      algebraMap R_F R_E a₀ * z
          = algebraMap R_F R_E a₀ * (∑ i : ι_E, (ω.repr z i) • ω i) := by
            rw [ω.sum_repr z]
      _ = ∑ i : ι_E, (ω.repr z i) • (algebraMap R_F R_E (c i) * (algebraMap R_F R_E (s_ω i) * ω i)) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [mul_smul_comm, ha₀_split i, (algebraMap R_F R_E).map_mul, mul_assoc]
      _ = ∑ i : ι_E, ∑ ρ : E ≃ₐ[F] E,
            (ω.repr z i) • (algebraMap R_F R_E (c i * f_s i ρ) * galRestrict R_F F E R_E ρ θ) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hf_s i, hΦ_apply, Finset.mul_sum, Finset.smul_sum]
            refine Finset.sum_congr rfl fun ρ _ => ?_
            rw [(algebraMap R_F R_E).map_mul, mul_assoc]
      _ = ∑ ρ : E ≃ₐ[F] E, algebraMap R_F R_E (∑ i : ι_E, (ω.repr z i) • (c i * f_s i ρ)) *
            galRestrict R_F F E R_E ρ θ := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun ρ _ => ?_
            rw [map_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_zsmul, smul_mul_assoc]
  
  have h_gal_mul : ∀ (τ₁ τ₂ : E ≃ₐ[F] E) (z : R_E),
      galRestrict R_F F E R_E τ₁ (galRestrict R_F F E R_E τ₂ z) =
        galRestrict R_F F E R_E (τ₁ * τ₂) z :=
    fun τ₁ τ₂ z => by rw [map_mul]; rfl
  have h_gal_Φ : ∀ (τ : E ≃ₐ[F] E) (f : (E ≃ₐ[F] E) → R_F),
      galRestrict R_F F E R_E τ (Φ f) = Φ (fun ρ => f (τ⁻¹ * ρ)) := by
    intro τ f
    rw [hΦ_apply, hΦ_apply, map_sum]
    have h1 : ∀ ρ : E ≃ₐ[F] E,
        galRestrict R_F F E R_E τ (algebraMap R_F R_E (f ρ) * galRestrict R_F F E R_E ρ θ) =
          algebraMap R_F R_E (f ρ) * galRestrict R_F F E R_E (τ * ρ) θ := by
      intro ρ
      rw [map_mul, AlgEquiv.commutes, h_gal_mul]
    simp_rw [h1]
    rw [← Equiv.sum_comp (Equiv.mulLeft τ⁻¹)]
    refine Finset.sum_congr rfl fun ρ _ => ?_
    dsimp [Equiv.mulLeft]
    rw [mul_inv_cancel_left]
  have hd_card : Fintype.card (E ≃ₐ[F] E) = d := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank F E]
  have h_ord : orderOf σ = d := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hCyclic, Nat.card_eq_fintype_card, hd_card]
  have h_inj : Function.Injective (fun k : Fin d => σ ^ (k : ℕ)) := by
    intro k₁ k₂ hk
    ext
    exact pow_injOn_Iio_orderOf (h_ord.symm ▸ k₁.2) (h_ord.symm ▸ k₂.2) hk
  have h_bij : Function.Bijective (fun k : Fin d => σ ^ (k : ℕ)) :=
    (Fintype.bijective_iff_injective_and_card _).mpr ⟨h_inj, by rw [Fintype.card_fin, hd_card]⟩
  let e_gal : Fin d ≃ (E ≃ₐ[F] E) := Equiv.ofBijective (fun k : Fin d => σ ^ (k : ℕ)) h_bij
  have he_gal_apply : ∀ k : Fin d, e_gal k = σ ^ (k : ℕ) := fun _ => rfl
  have h_Tr_eq_sum : ∀ z : R_E,
      Tr_G z = ∑ τ : E ≃ₐ[F] E, galRestrict R_F F E R_E τ z := by
    intro z
    exact Equiv.sum_comp e_gal (fun τ => galRestrict R_F F E R_E τ z)
  have h_Tr_Φ : ∀ f : (E ≃ₐ[F] E) → R_F,
      Tr_G (Φ f) = Φ (fun _ => ∑ τ : E ≃ₐ[F] E, f τ) := by
    intro f
    rw [h_Tr_eq_sum]
    simp_rw [h_gal_Φ, hΦ_apply]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun ρ _ => ?_
    rw [← Finset.sum_mul, ← map_sum]
    congr 2
    let e_τ : (E ≃ₐ[F] E) ≃ (E ≃ₐ[F] E) := (Equiv.inv (E ≃ₐ[F] E)).trans (Equiv.mulRight ρ)
    exact Equiv.sum_comp e_τ f
  have hL'_smul : ∀ (a : R_F) (z : R_E), z ∈ Φ.range → algebraMap R_F R_E a * z ∈ Φ.range := by
    rintro a _ ⟨f, rfl⟩
    refine ⟨fun ρ => a * f ρ, ?_⟩
    rw [hΦ_apply, hΦ_apply, Finset.mul_sum]
    refine Finset.sum_congr rfl fun ρ _ => ?_
    rw [(algebraMap R_F R_E).map_mul, mul_assoc]
  have h_conj_mem : ∀ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ θ ∈ Φ.range := by
    intro ρ
    refine ⟨fun τ => if τ = ρ then 1 else 0, ?_⟩
    rw [hΦ_apply]
    simp
  refine ⟨Φ.range, a₀, ha₀_ne, ?_, hL'_smul, ?_, ha₀_mem, ?_, ?_⟩
  · 
    rintro _ ⟨f, rfl⟩
    rw [hΦ_apply]
    exact Submodule.sum_mem I₂ fun ρ _ => I₂.mul_mem_left _ (hθ_mem ρ)
  · 
    rintro _ ⟨f, rfl⟩
    exact ⟨fun ρ => f (σ⁻¹ * ρ), (h_gal_Φ σ f).symm⟩
  · 
    rintro _ ⟨f, rfl⟩ hx
    change galRestrict R_F F E R_E σ (Φ f) = Φ f at hx
    rw [h_gal_Φ σ f] at hx
    have h_diff : Φ ((fun ρ => f (σ⁻¹ * ρ)) - f) = 0 := by
      rw [map_sub, hx, sub_self]
    have h_shift_eq : ∀ ρ : E ≃ₐ[F] E, f (σ * ρ) = f ρ := by
      intro ρ
      have h1 := sub_eq_zero.mp (hθ_indep _ h_diff (σ * ρ))
      dsimp at h1
      rw [inv_mul_cancel_left] at h1
      exact h1.symm
    have h_pow_eq : ∀ n : ℕ, f (σ ^ n) = f 1 := by
      intro n
      induction n with
      | zero => rw [pow_zero]
      | succ n ih => rw [pow_succ', h_shift_eq, ih]
    have hf_const : ∀ ρ : E ≃ₐ[F] E, f ρ = f 1 := by
      intro ρ
      obtain ⟨k, rfl⟩ := e_gal.surjective ρ
      exact h_pow_eq (k : ℕ)
    let g : (E ≃ₐ[F] E) → R_F := fun ρ => if ρ = 1 then f 1 else 0
    refine ⟨Φ g, ⟨g, rfl⟩, ?_⟩
    rw [h_Tr_Φ g]
    congr 1
    ext ρ
    simp [g, hf_const ρ]
  · 
    rintro _ ⟨f, rfl⟩ hy
    rw [h_Tr_Φ f] at hy
    have h_sum_zero : (∑ τ : E ≃ₐ[F] E, f τ) = 0 := hθ_indep _ hy 1
    have h_sum_fin : (∑ k : Fin d, f (e_gal k)) = 0 := by
      rw [Equiv.sum_comp e_gal f, h_sum_zero]
    let u : ℕ → R_E := fun m => ∑ j ∈ Finset.range m, galRestrict R_F F E R_E (σ ^ j) θ
    have hu_mem : ∀ m : ℕ, u m ∈ Φ.range := by
      intro m
      exact AddSubgroup.sum_mem Φ.range fun j _ => h_conj_mem (σ ^ j)
    have hu_sub : ∀ m : ℕ, u m - σ_int (u m) = θ - galRestrict R_F F E R_E (σ ^ m) θ := by
      intro m
      dsimp [u, σ_int]
      rw [map_sum, ← Finset.sum_sub_distrib]
      have h_step : ∀ j : ℕ,
          galRestrict R_F F E R_E (σ ^ j) θ -
            galRestrict R_F F E R_E σ (galRestrict R_F F E R_E (σ ^ j) θ) =
          galRestrict R_F F E R_E (σ ^ j) θ - galRestrict R_F F E R_E (σ ^ (j + 1)) θ := by
        intro j
        rw [h_gal_mul, pow_succ']
      simp_rw [h_step]
      rw [Finset.sum_range_sub' (fun j => galRestrict R_F F E R_E (σ ^ j) θ) m,
        pow_zero, map_one, AlgEquiv.one_apply]
    let w : R_E := -∑ k : Fin d, algebraMap R_F R_E (f (e_gal k)) * u (k : ℕ)
    have hw_mem : w ∈ Φ.range := by
      apply AddSubgroup.neg_mem
      exact AddSubgroup.sum_mem Φ.range fun k _ => hL'_smul (f (e_gal k)) (u (k : ℕ)) (hu_mem (k : ℕ))
    refine ⟨w, hw_mem, ?_⟩
    dsimp [w]
    rw [map_neg, neg_sub_neg, map_sum, ← Finset.sum_sub_distrib]
    have h_term : ∀ k : Fin d,
        σ_int (algebraMap R_F R_E (f (e_gal k)) * u (k : ℕ)) -
          algebraMap R_F R_E (f (e_gal k)) * u (k : ℕ) =
        algebraMap R_F R_E (f (e_gal k)) * galRestrict R_F F E R_E (e_gal k) θ -
          algebraMap R_F R_E (f (e_gal k)) * θ := by
      intro k
      rw [map_mul σ_int, AlgEquiv.commutes, ← mul_sub, ← neg_sub (u (k : ℕ)), hu_sub (k : ℕ),
        he_gal_apply k]
      ring
    simp_rw [h_term]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, ← map_sum, h_sum_fin, map_zero, zero_mul, sub_zero,
      hΦ_apply]
    exact Equiv.sum_comp e_gal (fun ρ => algebraMap R_F R_E (f ρ) * galRestrict R_F F E R_E ρ θ)

theorem exists_idempotent_mem_of_span_eq_mul_and_isCoprime {F : Type u} [Field F] [NumberField F]
    (D_ram J_d m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (d : ℕ)
    (hd_pos : 0 < d)
    (h_span_d : Ideal.span {(d : NumberField.RingOfIntegers F)} = D_ram * J_d)
    (h_cop_Jd : IsCoprime J_d m₀)
    (a₀ : NumberField.RingOfIntegers F)
    (ha₀_ne : a₀ ≠ 0) :
    let R_F := NumberField.RingOfIntegers F
    ∃ e : R_F,
      e ∈ J_d ∧
      1 - e ∈ m₀ ∧
      ∃ c : R_F, e - e ^ 2 = (d : R_F) * a₀ * c :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  have hd_ne : (d : R_F) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
  have hda₀_ne : (d : R_F) * a₀ ≠ 0 := mul_ne_zero hd_ne ha₀_ne
  let I_ann : Ideal R_F := Ideal.span {(d : R_F) * a₀}
  have hIann_ne : I_ann ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hda₀_ne
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal : ι → Ideal R_F) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  let N : Multiset (Ideal R_F) := UniqueFactorizationMonoid.normalizedFactors I_ann
  let m : Multiset ι :=
    Multiset.pmap
      (fun (p : Ideal R_F) (hp : Prime p) =>
        IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
      N
      (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
  let f_ann : ι →₀ ℕ := Multiset.toFinsupp m
  have hf_ann : (∏ q ∈ f_ann.support, q.asIdeal ^ (f_ann q)) = I_ann := by
    change f_ann.prod (fun q k => q.asIdeal ^ k) = I_ann
    have h_toMultiset :
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f_ann)).prod =
          f_ann.prod (fun q k => q.asIdeal ^ k) := by
      rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
        Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
    rw [← h_toMultiset]
    have hfm : Finsupp.toMultiset f_ann = m := Multiset.toFinsupp_toMultiset m
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m = N := by
      dsimp [m]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact prod_normalizedFactors_eq_self hIann_ne
  have hm₀_ne_zero : m₀ ≠ 0 := by rwa [Submodule.zero_eq_bot]
  have hS_fin : { q : ι | q.asIdeal ∣ m₀ }.Finite := Ideal.finite_factors hm₀_ne_zero
  let S_ram : Finset ι := hS_fin.toFinset
  have h_mem_S_ram : ∀ q : ι, q ∈ S_ram ↔ q.asIdeal ∣ m₀ :=
    fun q => Set.Finite.mem_toFinset hS_fin
  let I_wild : Ideal R_F := ∏ q ∈ S_ram, q.asIdeal ^ (f_ann q)
  let J_cop : Ideal R_F := ∏ q ∈ f_ann.support \ S_ram, q.asIdeal ^ (f_ann q)
  have h_ann_eq : I_ann = I_wild * J_cop := by
    have hW_inter : (∏ q ∈ f_ann.support ∩ S_ram, q.asIdeal ^ (f_ann q)) = I_wild := by
      dsimp [I_wild]
      refine Finset.prod_subset Finset.inter_subset_right (fun q hq_S hq_not_inter => ?_)
      have hq_not_supp : q ∉ f_ann.support :=
        fun hq_supp => hq_not_inter (Finset.mem_inter.mpr ⟨hq_supp, hq_S⟩)
      have hfq_zero : f_ann q = 0 := Finsupp.notMem_support_iff.mp hq_not_supp
      rw [hfq_zero, pow_zero]
    dsimp [J_cop]
    rw [← hW_inter, Finset.prod_inter_mul_prod_diff, hf_ann]
  have h_cop_Jcop_m₀ : IsCoprime J_cop m₀ := by
    dsimp [J_cop]
    refine IsCoprime.prod_left fun q hq => ?_
    apply IsCoprime.pow_left
    have hq_not_S : q ∉ S_ram := (Finset.mem_sdiff.mp hq).2
    have hq_not_dvd : ¬ (q.asIdeal ∣ m₀) :=
      fun hdvd => hq_not_S ((h_mem_S_ram q).mpr hdvd)
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    have h_eq : q.asIdeal = q.asIdeal ⊔ m₀ :=
      q.isMaximal.eq_of_le h_ne_top le_sup_left
    have hm₀_le : m₀ ≤ q.asIdeal := le_sup_right.trans h_eq.symm.le
    exact hq_not_dvd (Ideal.dvd_iff_le.mpr hm₀_le)
  have h_cop_Jcop_Iwild : IsCoprime J_cop I_wild := by
    dsimp [J_cop, I_wild]
    refine IsCoprime.prod_left fun q hq => ?_
    refine IsCoprime.prod_right fun q' hq' => ?_
    have hq_not_S : q ∉ S_ram := (Finset.mem_sdiff.mp hq).2
    have h_ne : q ≠ q' := fun h_eq => hq_not_S (h_eq ▸ hq')
    have h_ne_ideal : q.asIdeal ≠ q'.asIdeal :=
      fun h_eq => h_ne (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
    have h_cop_base : IsCoprime q.asIdeal q'.asIdeal :=
      Ideal.isCoprime_iff_sup_eq.mpr
        (Ideal.IsMaximal.coprime_of_ne q.isMaximal q'.isMaximal h_ne_ideal)
    exact h_cop_base.pow
  have h_cop_Jd_Iwild : IsCoprime J_d I_wild := by
    dsimp [I_wild]
    refine IsCoprime.prod_right fun q hq => ?_
    apply IsCoprime.pow_right
    have hdvd : q.asIdeal ∣ m₀ := (h_mem_S_ram q).mp hq
    rcases hdvd with ⟨C, hC⟩
    have h_cop_mul : IsCoprime J_d (q.asIdeal * C) := hC ▸ h_cop_Jd
    exact h_cop_mul.of_mul_right_left
  have hJd_dvd_d : J_d ∣ Ideal.span {(d : R_F)} := by
    rw [h_span_d]
    exact dvd_mul_left J_d D_ram
  have hd_dvd_ann : Ideal.span {(d : R_F)} ∣ I_ann := by
    rw [Ideal.dvd_iff_le]
    dsimp [I_ann]
    exact Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_right (d : R_F) a₀)
  have hJd_dvd_mul : J_d ∣ I_wild * J_cop := by
    rw [← h_ann_eq]
    exact dvd_trans hJd_dvd_d hd_dvd_ann
  have hJd_dvd_Jcop : J_d ∣ J_cop :=
    h_cop_Jd_Iwild.dvd_of_dvd_mul_left hJd_dvd_mul
  have hJcop_le_Jd : J_cop ≤ J_d :=
    Ideal.dvd_iff_le.mp hJd_dvd_Jcop
  have h_cop_prod : IsCoprime J_cop (I_wild * m₀) :=
    h_cop_Jcop_Iwild.mul_right h_cop_Jcop_m₀
  obtain ⟨e, he_Jcop, y₀, hy₀_mem, h_sum⟩ := Ideal.isCoprime_iff_exists.mp h_cop_prod
  have h_one_sub : 1 - e = y₀ := by
    rw [← h_sum]
    ring
  have he_Jd : e ∈ J_d := hJcop_le_Jd he_Jcop
  have h_one_sub_m₀ : 1 - e ∈ m₀ := by
    rw [h_one_sub]
    exact Ideal.mul_le_left hy₀_mem
  have h_one_sub_Iwild : 1 - e ∈ I_wild := by
    rw [h_one_sub]
    exact Ideal.mul_le_right hy₀_mem
  have h_mul_mem : (1 - e) * e ∈ I_ann := by
    rw [h_ann_eq]
    exact Ideal.mul_mem_mul h_one_sub_Iwild he_Jcop
  have h_idemp_mem : e - e ^ 2 ∈ Ideal.span {(d : R_F) * a₀} := by
    have h_eq : e - e ^ 2 = (1 - e) * e := by ring
    rw [h_eq]
    exact h_mul_mem
  rcases Ideal.mem_span_singleton.mp h_idemp_mem with ⟨c, hc⟩
  exact ⟨e, he_Jd, h_one_sub_m₀, c, hc⟩

theorem idempotent_herbrand_quotient_card_eq_of_normalBasis_addSubgroup {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₂ : Ideal (NumberField.RingOfIntegers F))
    (L' : AddSubgroup (NumberField.RingOfIntegers E))
    (hL'_le : L' ≤ (Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) m₂).toAddSubgroup)
    (hL'_smul : ∀ (a : NumberField.RingOfIntegers F) (z : NumberField.RingOfIntegers E),
      z ∈ L' → algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a * z ∈ L')
    (hL'_gal : ∀ z : NumberField.RingOfIntegers E,
      z ∈ L' → galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ z ∈ L')
    (a₀ : NumberField.RingOfIntegers F)
    (ha₀_ne : a₀ ≠ 0)
    (ha₀_mem : ∀ z : NumberField.RingOfIntegers E,
      algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a₀ * z ∈ L')
    (hL'_fix : ∀ x : NumberField.RingOfIntegers E,
      x ∈ L' →
      galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ x = x →
      ∃ w ∈ L',
        (∑ k : Fin (Module.finrank F E),
          galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ)) w) = x)
    (hL'_tr : ∀ y : NumberField.RingOfIntegers E,
      y ∈ L' →
      (∑ k : Fin (Module.finrank F E),
        galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ)) y) = 0 →
      ∃ w ∈ L',
        w - galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ w = y)
    (e c : NumberField.RingOfIntegers F)
    (he_idemp : e - e ^ 2 = (Module.finrank F E : NumberField.RingOfIntegers F) * a₀ * c) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let d := Module.finrank F E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let Tr_G : R_E → R_E := fun z =>
      ∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z
    let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
    let L_minus : AddSubgroup R_E := AddSubgroup.closure { y : R_E |
      y ∈ I₂ ∧ Tr_G y = 0 }
    let K_minus : AddSubgroup R_E := AddSubgroup.closure { y : R_E |
      y ∈ I₂ ∧ Tr_G y = 0 ∧
      ∃ w ∈ I₂, algebraMap R_F R_E e * y = w - σ_int w }
    let L_plus : AddSubgroup R_E := AddSubgroup.closure { x : R_E |
      x ∈ I₂ ∧ σ_int x = x }
    let K_plus : AddSubgroup R_E := AddSubgroup.closure { x : R_E |
      x ∈ I₂ ∧ σ_int x = x ∧
      ∃ w ∈ I₂, algebraMap R_F R_E e * x = Tr_G w }
    Finite (L_minus ⧸ K_minus.addSubgroupOf L_minus) ∧
    Nat.card (L_minus ⧸ K_minus.addSubgroupOf L_minus) =
      Nat.card (L_plus ⧸ K_plus.addSubgroupOf L_plus) :=
by
  dsimp only
  
  have hFin_Q : Finite (NumberField.RingOfIntegers E ⧸ L') := by
    let a₀_E : NumberField.RingOfIntegers E :=
      algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a₀
    let I_a₀ : Ideal (NumberField.RingOfIntegers E) := Ideal.span {a₀_E}
    have ha₀_E_ne : a₀_E ≠ 0 := fun h =>
      ha₀_ne (FaithfulSMul.algebraMap_injective
        (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) (h.trans (map_zero _).symm))
    have hIa₀_ne : I_a₀ ≠ ⊥ :=
      Ideal.span_singleton_eq_bot.not.mpr ha₀_E_ne
    haveI hFin_Ia₀ : Finite (NumberField.RingOfIntegers E ⧸ I_a₀) :=
      Ideal.finiteQuotientOfFreeOfNeBot I_a₀ hIa₀_ne
    haveI hFin_Ia₀_add : Finite (NumberField.RingOfIntegers E ⧸ I_a₀.toAddSubgroup) := hFin_Ia₀
    have h_Ia₀_le : I_a₀.toAddSubgroup ≤ L'.comap (AddMonoidHom.id (NumberField.RingOfIntegers E)) := by
      intro w hw
      change w ∈ I_a₀ at hw
      rw [Ideal.mem_span_singleton] at hw
      rcases hw with ⟨r, rfl⟩
      exact ha₀_mem r
    let q_map : (NumberField.RingOfIntegers E ⧸ I_a₀.toAddSubgroup) →+ (NumberField.RingOfIntegers E ⧸ L') :=
      QuotientAddGroup.map I_a₀.toAddSubgroup L' (AddMonoidHom.id (NumberField.RingOfIntegers E)) h_Ia₀_le
    have hq_surj : Function.Surjective q_map := by
      intro u
      rcases QuotientAddGroup.mk'_surjective L' u with ⟨z, rfl⟩
      exact ⟨QuotientAddGroup.mk' I_a₀.toAddSubgroup z, rfl⟩
    exact Finite.of_surjective q_map hq_surj
  haveI : Finite (NumberField.RingOfIntegers E ⧸ L') := hFin_Q

  
  have h_gal_mul : ∀ (τ₁ τ₂ : E ≃ₐ[F] E) (z : NumberField.RingOfIntegers E),
      galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) τ₁
        (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) τ₂ z) =
        galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (τ₁ * τ₂) z := by
    intro τ₁ τ₂ z
    rw [map_mul, AlgEquiv.mul_apply]
  have h_gal_one : ∀ z : NumberField.RingOfIntegers E,
      galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) 1 z = z := by
    intro z
    rw [map_one, AlgEquiv.one_apply]
  have h_pow_d : σ ^ (Module.finrank F E) = 1 := by
    have h_ord : orderOf σ = Module.finrank F E := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hCyclic, IsGalois.card_aut_eq_finrank F E]
    rw [← h_ord, pow_orderOf_eq_one]
  let σ_int : NumberField.RingOfIntegers E ≃ₐ[NumberField.RingOfIntegers F] NumberField.RingOfIntegers E :=
    galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ
  let Tr_G : NumberField.RingOfIntegers E → NumberField.RingOfIntegers E := fun z =>
    ∑ k : Fin (Module.finrank F E),
      galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ)) z
  let I₂ : Ideal (NumberField.RingOfIntegers E) :=
    Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) m₂
  let e_E : NumberField.RingOfIntegers E :=
    algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) e
  have hTr_sub : ∀ z : NumberField.RingOfIntegers E, Tr_G (z - σ_int z) = 0 := by
    intro z
    dsimp only [Tr_G, σ_int]
    rw [Fin.sum_univ_eq_sum_range (fun n =>
      galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n)
        (z - galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ z))
      (Module.finrank F E)]
    have h_term : ∀ n : ℕ,
        galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n)
          (z - galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ z) =
          galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z -
            galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (n + 1)) z := by
      intro n
      rw [map_sub, h_gal_mul, ← pow_succ]
    simp_rw [h_term]
    rw [Finset.sum_range_sub' (fun n =>
      galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z)
      (Module.finrank F E), pow_zero, h_pow_d, sub_self]
  have hσ_Tr : ∀ z : NumberField.RingOfIntegers E, σ_int (Tr_G z) = Tr_G z := by
    intro z
    dsimp only [Tr_G, σ_int]
    rw [map_sum]
    have h_sub_zero :
        (∑ k : Fin (Module.finrank F E),
          galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ
            (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ)) z)) -
          (∑ k : Fin (Module.finrank F E),
            galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (k : ℕ)) z) = 0 := by
      rw [← Finset.sum_sub_distrib,
        Fin.sum_univ_eq_sum_range (fun n =>
          galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ
            (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z) -
            galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z)
          (Module.finrank F E)]
      have h_term : ∀ n : ℕ,
          galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ
            (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z) -
            galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z =
          galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ (n + 1)) z -
            galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z := by
        intro n
        rw [h_gal_mul, ← pow_succ']
      simp_rw [h_term]
      rw [Finset.sum_range_sub (fun n =>
        galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z)
        (Module.finrank F E), h_pow_d, pow_zero, sub_self]
    exact sub_eq_zero.mp h_sub_zero
  have h_gal_smul : ∀ (ρ : E ≃ₐ[F] E) (a : NumberField.RingOfIntegers F) (z : NumberField.RingOfIntegers E),
      galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) ρ
        (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a * z) =
        algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a *
          galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) ρ z := by
    intro ρ a z
    rw [map_mul, AlgEquiv.commutes]
  have hI₂_gal : ∀ (ρ : E ≃ₐ[F] E) (z : NumberField.RingOfIntegers E),
      z ∈ I₂ → galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) ρ z ∈ I₂ := by
    intro ρ z hz
    dsimp only [I₂] at hz ⊢
    rw [Ideal.map, Ideal.span] at hz
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
    · rintro x ⟨a, ha, rfl⟩
      rw [AlgEquiv.commutes]
      exact Ideal.mem_map_of_mem (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) ha
    · rw [map_zero]
      exact I₂.zero_mem
    · intro x y _ _ hx hy
      rw [map_add]
      exact I₂.add_mem hx hy
    · intro r x _ hx
      rw [smul_eq_mul, map_mul]
      exact I₂.mul_mem_left _ hx
  have hI₂_σ : ∀ z : NumberField.RingOfIntegers E, z ∈ I₂ → σ_int z ∈ I₂ := hI₂_gal σ
  have hI₂_Tr : ∀ z : NumberField.RingOfIntegers E, z ∈ I₂ → Tr_G z ∈ I₂ := by
    intro z hz
    exact I₂.sum_mem (fun k _ => hI₂_gal (σ ^ (k : ℕ)) z hz)
  have hL'_pow : ∀ (n : ℕ) (z : NumberField.RingOfIntegers E),
      z ∈ L' → galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) (σ ^ n) z ∈ L' := by
    intro n
    induction n with
    | zero =>
      intro z hz
      rw [pow_zero, h_gal_one]
      exact hz
    | succ n ih =>
      intro z hz
      rw [pow_succ', ← h_gal_mul]
      exact hL'_gal _ (ih z hz)
  have hL'_Tr : ∀ z : NumberField.RingOfIntegers E, z ∈ L' → Tr_G z ∈ L' := by
    intro z hz
    exact L'.sum_mem (fun k _ => hL'_pow (k : ℕ) z hz)
  have hTr_e : ∀ z : NumberField.RingOfIntegers E, Tr_G (e_E * z) = e_E * Tr_G z := by
    intro z
    dsimp only [Tr_G, e_E]
    simp_rw [h_gal_smul _ e z]
    rw [← Finset.mul_sum]
  have hD_e : ∀ z : NumberField.RingOfIntegers E, e_E * z - σ_int (e_E * z) = e_E * (z - σ_int z) := by
    intro z
    dsimp only [σ_int, e_E]
    rw [h_gal_smul σ e z, ← mul_sub]
  have he_mod : ∀ z : NumberField.RingOfIntegers E, e_E * z - e_E * (e_E * z) ∈ L' := by
    intro z
    have h_eq : e_E * z - e_E * (e_E * z) =
        algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) ((Module.finrank F E : NumberField.RingOfIntegers F) * c) *
          (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a₀ * z) := by
      have h1 : e_E - e_E ^ 2 = algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) (e - e ^ 2) := by
        dsimp only [e_E]
        rw [map_sub, map_pow]
      calc
        e_E * z - e_E * (e_E * z) = (e_E - e_E ^ 2) * z := by ring
        _ = algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) (e - e ^ 2) * z := by rw [h1]
        _ = algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) ((Module.finrank F E : NumberField.RingOfIntegers F) * a₀ * c) * z := by rw [he_idemp]
        _ = algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) ((Module.finrank F E : NumberField.RingOfIntegers F) * c) *
              (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a₀ * z) := by
          rw [map_mul, map_mul, map_mul]
          ring
    rw [h_eq]
    exact hL'_smul ((Module.finrank F E : NumberField.RingOfIntegers F) * c)
      (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) a₀ * z) (ha₀_mem z)

  
  let T : NumberField.RingOfIntegers E →+ NumberField.RingOfIntegers E :=
    { toFun := Tr_G
      map_zero' := by dsimp [Tr_G]; simp
      map_add' := by intro x y; dsimp [Tr_G]; simp [map_add, Finset.sum_add_distrib] }
  let D : NumberField.RingOfIntegers E →+ NumberField.RingOfIntegers E :=
    { toFun := fun z => z - σ_int z
      map_zero' := by rw [map_zero, sub_zero]
      map_add' := by intro x y; rw [map_add]; ring }
  let E_mul : NumberField.RingOfIntegers E →+ NumberField.RingOfIntegers E :=
    { toFun := fun z => e_E * z
      map_zero' := mul_zero e_E
      map_add' := mul_add e_E }
  let π : NumberField.RingOfIntegers E →+ (NumberField.RingOfIntegers E ⧸ L') := QuotientAddGroup.mk' L'
  have hπ_zero : ∀ z : NumberField.RingOfIntegers E, π z = 0 ↔ z ∈ L' := by
    intro z
    rw [← AddMonoidHom.mem_ker, QuotientAddGroup.ker_mk']
  have hT_D : ∀ z : NumberField.RingOfIntegers E, T (D z) = 0 := hTr_sub
  have hD_T : ∀ z : NumberField.RingOfIntegers E, D (T z) = 0 := fun z => sub_eq_zero.mpr (hσ_Tr z).symm
  have hT_e : ∀ z : NumberField.RingOfIntegers E, T (e_E * z) = e_E * T z := hTr_e
  have hD_e' : ∀ z : NumberField.RingOfIntegers E, D (e_E * z) = e_E * D z := hD_e
  have hT_L' : L' ≤ L'.comap T := fun z hz => hL'_Tr z hz
  have hD_L' : L' ≤ L'.comap D := fun z hz => L'.sub_mem hz (hL'_gal z hz)
  let T_bar : (NumberField.RingOfIntegers E ⧸ L') →+ (NumberField.RingOfIntegers E ⧸ L') :=
    QuotientAddGroup.map L' L' T hT_L'
  let D_bar : (NumberField.RingOfIntegers E ⧸ L') →+ (NumberField.RingOfIntegers E ⧸ L') :=
    QuotientAddGroup.map L' L' D hD_L'
  let M_e : AddSubgroup (NumberField.RingOfIntegers E ⧸ L') :=
    AddSubgroup.map (π.comp E_mul) I₂.toAddSubgroup
  let Z_minus : AddSubgroup (NumberField.RingOfIntegers E ⧸ L') := T_bar.ker ⊓ M_e
  let B_minus : AddSubgroup (NumberField.RingOfIntegers E ⧸ L') := AddSubgroup.map D_bar M_e
  let Z_plus : AddSubgroup (NumberField.RingOfIntegers E ⧸ L') := D_bar.ker ⊓ M_e
  let B_plus : AddSubgroup (NumberField.RingOfIntegers E ⧸ L') := AddSubgroup.map T_bar M_e
  let L_minus : AddSubgroup (NumberField.RingOfIntegers E) := AddSubgroup.closure { y | y ∈ I₂ ∧ Tr_G y = 0 }
  let K_minus : AddSubgroup (NumberField.RingOfIntegers E) := AddSubgroup.closure { y | y ∈ I₂ ∧ Tr_G y = 0 ∧ ∃ w ∈ I₂, e_E * y = w - σ_int w }
  let L_plus : AddSubgroup (NumberField.RingOfIntegers E) := AddSubgroup.closure { x | x ∈ I₂ ∧ σ_int x = x }
  let K_plus : AddSubgroup (NumberField.RingOfIntegers E) := AddSubgroup.closure { x | x ∈ I₂ ∧ σ_int x = x ∧ ∃ w ∈ I₂, e_E * x = Tr_G w }

  
  have hL_minus_iff : ∀ y : NumberField.RingOfIntegers E, y ∈ L_minus ↔ y ∈ I₂ ∧ T y = 0 := by
    intro y
    constructor
    · intro hy
      refine AddSubgroup.closure_induction ?_ ?_ ?_ ?_ hy
      · intro z hz; exact hz
      · exact ⟨I₂.zero_mem, map_zero T⟩
      · intro x z _ _ hx hz
        exact ⟨I₂.add_mem hx.1 hz.1, by rw [map_add, hx.2, hz.2, add_zero]⟩
      · intro x _ hx
        exact ⟨I₂.neg_mem hx.1, by rw [map_neg, hx.2, neg_zero]⟩
    · intro hy
      exact AddSubgroup.subset_closure hy
  have hK_minus_iff : ∀ y : NumberField.RingOfIntegers E,
      y ∈ K_minus ↔ y ∈ I₂ ∧ T y = 0 ∧ ∃ w ∈ I₂, e_E * y = D w := by
    intro y
    constructor
    · intro hy
      refine AddSubgroup.closure_induction ?_ ?_ ?_ ?_ hy
      · intro z hz; exact hz
      · exact ⟨I₂.zero_mem, map_zero T, 0, I₂.zero_mem, by rw [mul_zero, map_zero]⟩
      · rintro x z _ _ ⟨hx_I₂, hx_T, wx, hwx_I₂, hwx_eq⟩ ⟨hz_I₂, hz_T, wz, hwz_I₂, hwz_eq⟩
        refine ⟨I₂.add_mem hx_I₂ hz_I₂, by rw [map_add, hx_T, hz_T, add_zero],
          wx + wz, I₂.add_mem hwx_I₂ hwz_I₂, ?_⟩
        rw [mul_add, hwx_eq, hwz_eq, ← map_add]
      · rintro x _ ⟨hx_I₂, hx_T, wx, hwx_I₂, hwx_eq⟩
        refine ⟨I₂.neg_mem hx_I₂, by rw [map_neg, hx_T, neg_zero],
          -wx, I₂.neg_mem hwx_I₂, ?_⟩
        rw [mul_neg, hwx_eq, ← map_neg]
    · intro hy
      exact AddSubgroup.subset_closure hy
  have hL_plus_iff : ∀ x : NumberField.RingOfIntegers E, x ∈ L_plus ↔ x ∈ I₂ ∧ σ_int x = x := by
    intro x
    constructor
    · intro hx
      refine AddSubgroup.closure_induction ?_ ?_ ?_ ?_ hx
      · intro z hz; exact hz
      · exact ⟨I₂.zero_mem, map_zero σ_int⟩
      · intro y z _ _ hy hz
        exact ⟨I₂.add_mem hy.1 hz.1, by rw [map_add, hy.2, hz.2]⟩
      · intro y _ hy
        exact ⟨I₂.neg_mem hy.1, by rw [map_neg, hy.2]⟩
    · intro hx
      exact AddSubgroup.subset_closure hx
  have hK_plus_iff : ∀ x : NumberField.RingOfIntegers E,
      x ∈ K_plus ↔ x ∈ I₂ ∧ σ_int x = x ∧ ∃ w ∈ I₂, e_E * x = T w := by
    intro x
    constructor
    · intro hx
      refine AddSubgroup.closure_induction ?_ ?_ ?_ ?_ hx
      · intro z hz; exact hz
      · exact ⟨I₂.zero_mem, map_zero σ_int, 0, I₂.zero_mem, by rw [mul_zero, map_zero]⟩
      · rintro y z _ _ ⟨hy_I₂, hy_fix, wy, hwy_I₂, hwy_eq⟩ ⟨hz_I₂, hz_fix, wz, hwz_I₂, hwz_eq⟩
        refine ⟨I₂.add_mem hy_I₂ hz_I₂, by rw [map_add, hy_fix, hz_fix],
          wy + wz, I₂.add_mem hwy_I₂ hwz_I₂, ?_⟩
        rw [mul_add, hwy_eq, hwz_eq, ← map_add]
      · rintro y _ ⟨hy_I₂, hy_fix, wy, hwy_I₂, hwy_eq⟩
        refine ⟨I₂.neg_mem hy_I₂, by rw [map_neg, hy_fix],
          -wy, I₂.neg_mem hwy_I₂, ?_⟩
        rw [mul_neg, hwy_eq, ← map_neg]
    · intro hx
      exact AddSubgroup.subset_closure hx

  
  have h_minus_all :
      Finite (L_minus ⧸ K_minus.addSubgroupOf L_minus) ∧
      Nat.card (L_minus ⧸ K_minus.addSubgroupOf L_minus) =
        Nat.card (Z_minus ⧸ B_minus.addSubgroupOf Z_minus) := by
    have h_mem_Z_minus : ∀ y : L_minus, π (e_E * y.1) ∈ Z_minus := by
      intro ⟨y, hy⟩
      rcases (hL_minus_iff y).mp hy with ⟨hy_I₂, hy_T⟩
      refine ⟨?_, ⟨y, hy_I₂, rfl⟩⟩
      change T_bar (π (e_E * y)) = 0
      change π (T (e_E * y)) = 0
      rw [hT_e y, hy_T, mul_zero, map_zero]
    let φ_minus : L_minus →+ Z_minus :=
      { toFun := fun y => ⟨π (e_E * y.1), h_mem_Z_minus y⟩
        map_zero' := by ext; change π (e_E * 0) = 0; rw [mul_zero, map_zero]
        map_add' := by
          intro y₁ y₂
          ext
          change π (e_E * (y₁.1 + y₂.1)) = π (e_E * y₁.1) + π (e_E * y₂.1)
          rw [mul_add, map_add] }
    let ψ_minus : L_minus →+ (Z_minus ⧸ B_minus.addSubgroupOf Z_minus) :=
      (QuotientAddGroup.mk' (B_minus.addSubgroupOf Z_minus)).comp φ_minus
    have hφ_minus_surj : Function.Surjective φ_minus := by
      rintro ⟨u, hu_ker, ⟨z, hz_I₂, rfl⟩⟩
      change T_bar (π (e_E * z)) = 0 at hu_ker
      change π (T (e_E * z)) = 0 at hu_ker
      rw [hπ_zero] at hu_ker
      rcases hL'_fix (T (e_E * z)) hu_ker (hσ_Tr (e_E * z)) with ⟨w', hw'_L', hw'_eq⟩
      change T w' = T (e_E * z) at hw'_eq
      let y : NumberField.RingOfIntegers E := e_E * z - w'
      have hy_L_minus : y ∈ L_minus := by
        rw [hL_minus_iff]
        refine ⟨I₂.sub_mem (I₂.mul_mem_left e_E hz_I₂) (hL'_le hw'_L'), ?_⟩
        dsimp [y]
        rw [map_sub, hw'_eq, sub_self]
      refine ⟨⟨y, hy_L_minus⟩, Subtype.ext ?_⟩
      change π (e_E * y) = π (e_E * z)
      rw [← sub_eq_zero, ← map_sub, hπ_zero]
      have h_diff : e_E * y - e_E * z = -((e_E * z - e_E * (e_E * z)) + e_E * w') := by
        dsimp [y]; ring
      rw [h_diff]
      exact L'.neg_mem (L'.add_mem (he_mod z) (hL'_smul e w' hw'_L'))
    have hψ_minus_surj : Function.Surjective ψ_minus :=
      (QuotientAddGroup.mk'_surjective _).comp hφ_minus_surj
    have hψ_minus_ker : ψ_minus.ker = K_minus.addSubgroupOf L_minus := by
      ext ⟨y, hy⟩
      rw [AddMonoidHom.mem_ker, AddSubgroup.mem_addSubgroupOf]
      change (φ_minus ⟨y, hy⟩ : Z_minus ⧸ B_minus.addSubgroupOf Z_minus) = 0 ↔ y ∈ K_minus
      rw [QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf]
      change π (e_E * y) ∈ B_minus ↔ y ∈ K_minus
      rcases (hL_minus_iff y).mp hy with ⟨hy_I₂, hy_T⟩
      constructor
      · rintro ⟨_, ⟨z, hz_I₂, rfl⟩, h_eq⟩
        change D_bar (π (e_E * z)) = π (e_E * y) at h_eq
        change π (D (e_E * z)) = π (e_E * y) at h_eq
        rw [hD_e' z] at h_eq
        have hv_L' : e_E * y - e_E * D z ∈ L' := by
          rw [← hπ_zero, map_sub, h_eq, sub_self]
        let v : NumberField.RingOfIntegers E := e_E * y - e_E * D z
        have hTv : Tr_G v = 0 := by
          change T v = 0
          dsimp [v]
          rw [map_sub, hT_e, hT_e, hy_T, hT_D z, mul_zero, sub_zero]
        rcases hL'_tr v hv_L' hTv with ⟨w', hw'_L', hw'_eq⟩
        change D w' = v at hw'_eq
        rw [hK_minus_iff]
        refine ⟨hy_I₂, hy_T, e_E * z + w', I₂.add_mem (I₂.mul_mem_left e_E hz_I₂) (hL'_le hw'_L'), ?_⟩
        rw [map_add, hD_e' z, hw'_eq]
        dsimp [v]; ring
      · intro hy_K
        rcases (hK_minus_iff y).mp hy_K with ⟨_, _, w, hw_I₂, hw_eq⟩
        refine ⟨π (e_E * w), ⟨w, hw_I₂, rfl⟩, ?_⟩
        change π (D (e_E * w)) = π (e_E * y)
        rw [hD_e' w, ← hw_eq, ← sub_eq_zero, ← map_sub, hπ_zero]
        have h_neg : e_E * (e_E * y) - e_E * y = -(e_E * y - e_E * (e_E * y)) := by ring
        rw [h_neg]
        exact L'.neg_mem (he_mod y)
    let e_minus : (L_minus ⧸ K_minus.addSubgroupOf L_minus) ≃+ (Z_minus ⧸ B_minus.addSubgroupOf Z_minus) :=
      (QuotientAddGroup.quotientAddEquivOfEq hψ_minus_ker).symm.trans
        (QuotientAddGroup.quotientKerEquivOfSurjective ψ_minus hψ_minus_surj)
    exact ⟨Finite.of_equiv _ e_minus.toEquiv.symm, Nat.card_congr e_minus.toEquiv⟩

  
  have hCard_plus :
      Nat.card (L_plus ⧸ K_plus.addSubgroupOf L_plus) =
        Nat.card (Z_plus ⧸ B_plus.addSubgroupOf Z_plus) := by
    have h_mem_Z_plus : ∀ x : L_plus, π (e_E * x.1) ∈ Z_plus := by
      intro ⟨x, hx⟩
      rcases (hL_plus_iff x).mp hx with ⟨hx_I₂, hx_fix⟩
      refine ⟨?_, ⟨x, hx_I₂, rfl⟩⟩
      change D_bar (π (e_E * x)) = 0
      change π (D (e_E * x)) = 0
      have hDx : D x = 0 := sub_eq_zero.mpr hx_fix.symm
      rw [hD_e' x, hDx, mul_zero, map_zero]
    let φ_plus : L_plus →+ Z_plus :=
      { toFun := fun x => ⟨π (e_E * x.1), h_mem_Z_plus x⟩
        map_zero' := by ext; change π (e_E * 0) = 0; rw [mul_zero, map_zero]
        map_add' := by
          intro x₁ x₂
          ext
          change π (e_E * (x₁.1 + x₂.1)) = π (e_E * x₁.1) + π (e_E * x₂.1)
          rw [mul_add, map_add] }
    let ψ_plus : L_plus →+ (Z_plus ⧸ B_plus.addSubgroupOf Z_plus) :=
      (QuotientAddGroup.mk' (B_plus.addSubgroupOf Z_plus)).comp φ_plus
    have hφ_plus_surj : Function.Surjective φ_plus := by
      rintro ⟨u, hu_ker, ⟨z, hz_I₂, rfl⟩⟩
      change D_bar (π (e_E * z)) = 0 at hu_ker
      change π (D (e_E * z)) = 0 at hu_ker
      rw [hπ_zero] at hu_ker
      rcases hL'_tr (D (e_E * z)) hu_ker (hTr_sub (e_E * z)) with ⟨w', hw'_L', hw'_eq⟩
      change D w' = D (e_E * z) at hw'_eq
      let x : NumberField.RingOfIntegers E := e_E * z - w'
      have hx_L_plus : x ∈ L_plus := by
        rw [hL_plus_iff]
        refine ⟨I₂.sub_mem (I₂.mul_mem_left e_E hz_I₂) (hL'_le hw'_L'), ?_⟩
        have hDx : D x = 0 := by
          dsimp [x]
          rw [map_sub, hw'_eq, sub_self]
        exact (sub_eq_zero.mp hDx).symm
      refine ⟨⟨x, hx_L_plus⟩, Subtype.ext ?_⟩
      change π (e_E * x) = π (e_E * z)
      rw [← sub_eq_zero, ← map_sub, hπ_zero]
      have h_diff : e_E * x - e_E * z = -((e_E * z - e_E * (e_E * z)) + e_E * w') := by
        dsimp [x]; ring
      rw [h_diff]
      exact L'.neg_mem (L'.add_mem (he_mod z) (hL'_smul e w' hw'_L'))
    have hψ_plus_surj : Function.Surjective ψ_plus :=
      (QuotientAddGroup.mk'_surjective _).comp hφ_plus_surj
    have hψ_plus_ker : ψ_plus.ker = K_plus.addSubgroupOf L_plus := by
      ext ⟨x, hx⟩
      rw [AddMonoidHom.mem_ker, AddSubgroup.mem_addSubgroupOf]
      change (φ_plus ⟨x, hx⟩ : Z_plus ⧸ B_plus.addSubgroupOf Z_plus) = 0 ↔ x ∈ K_plus
      rw [QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf]
      change π (e_E * x) ∈ B_plus ↔ x ∈ K_plus
      rcases (hL_plus_iff x).mp hx with ⟨hx_I₂, hx_fix⟩
      constructor
      · rintro ⟨_, ⟨z, hz_I₂, rfl⟩, h_eq⟩
        change T_bar (π (e_E * z)) = π (e_E * x) at h_eq
        change π (T (e_E * z)) = π (e_E * x) at h_eq
        rw [hT_e z] at h_eq
        have hv_L' : e_E * x - e_E * T z ∈ L' := by
          rw [← hπ_zero, map_sub, h_eq, sub_self]
        let v : NumberField.RingOfIntegers E := e_E * x - e_E * T z
        have hv_fix : σ_int v = v := by
          have hDv : D v = 0 := by
            have hDx : D x = 0 := sub_eq_zero.mpr hx_fix.symm
            dsimp [v]
            rw [map_sub, hD_e', hD_e', hDx, hD_T z, mul_zero, sub_zero]
          exact (sub_eq_zero.mp hDv).symm
        rcases hL'_fix v hv_L' hv_fix with ⟨w', hw'_L', hw'_eq⟩
        change T w' = v at hw'_eq
        rw [hK_plus_iff]
        refine ⟨hx_I₂, hx_fix, e_E * z + w', I₂.add_mem (I₂.mul_mem_left e_E hz_I₂) (hL'_le hw'_L'), ?_⟩
        rw [map_add, hT_e z, hw'_eq]
        dsimp [v]; ring
      · intro hx_K
        rcases (hK_plus_iff x).mp hx_K with ⟨_, _, w, hw_I₂, hw_eq⟩
        refine ⟨π (e_E * w), ⟨w, hw_I₂, rfl⟩, ?_⟩
        change π (T (e_E * w)) = π (e_E * x)
        rw [hT_e w, ← hw_eq, ← sub_eq_zero, ← map_sub, hπ_zero]
        have h_neg : e_E * (e_E * x) - e_E * x = -(e_E * x - e_E * (e_E * x)) := by ring
        rw [h_neg]
        exact L'.neg_mem (he_mod x)
    let e_plus : (L_plus ⧸ K_plus.addSubgroupOf L_plus) ≃+ (Z_plus ⧸ B_plus.addSubgroupOf Z_plus) :=
      (QuotientAddGroup.quotientAddEquivOfEq hψ_plus_ker).symm.trans
        (QuotientAddGroup.quotientKerEquivOfSurjective ψ_plus hψ_plus_surj)
    exact Nat.card_congr e_plus.toEquiv

  
  have hB_minus_le : B_minus ≤ Z_minus := by
    rintro _ ⟨_, ⟨z, hz_I₂, rfl⟩, rfl⟩
    refine ⟨?_, ⟨D z, I₂.sub_mem hz_I₂ (hI₂_σ z hz_I₂), ?_⟩⟩
    · change T_bar (D_bar (π (e_E * z))) = 0
      change π (T (D (e_E * z))) = 0
      rw [hT_D (e_E * z), map_zero]
    · change π (e_E * D z) = D_bar (π (e_E * z))
      change π (e_E * D z) = π (D (e_E * z))
      rw [hD_e' z]
  have hB_plus_le : B_plus ≤ Z_plus := by
    rintro _ ⟨_, ⟨z, hz_I₂, rfl⟩, rfl⟩
    refine ⟨?_, ⟨T z, hI₂_Tr z hz_I₂, ?_⟩⟩
    · change D_bar (T_bar (π (e_E * z))) = 0
      change π (D (T (e_E * z))) = 0
      rw [hD_T (e_E * z), map_zero]
    · change π (e_E * T z) = T_bar (π (e_E * z))
      change π (e_E * T z) = π (T (e_E * z))
      rw [hT_e z]
  have h_map_card : ∀ (f : (NumberField.RingOfIntegers E ⧸ L') →+ (NumberField.RingOfIntegers E ⧸ L')),
      Nat.card ↥(f.ker ⊓ M_e) * Nat.card ↥(AddSubgroup.map f M_e) = Nat.card ↥M_e := by
    intro f
    have h := AddSubgroup.relIndex_inf_mul_relIndex (⊥ : AddSubgroup (NumberField.RingOfIntegers E ⧸ L')) f.ker M_e
    rw [bot_inf_eq, ← AddMonoidHom.comap_bot f, AddSubgroup.relIndex_comap,
      AddSubgroup.relIndex_bot_left, AddSubgroup.relIndex_bot_left, AddSubgroup.relIndex_bot_left] at h
    exact h
  have h_quot_card : ∀ (B Z : AddSubgroup (NumberField.RingOfIntegers E ⧸ L')), B ≤ Z →
      Nat.card ↥B * Nat.card (Z ⧸ B.addSubgroupOf Z) = Nat.card ↥Z := by
    intro B Z hBZ
    have h := AddSubgroup.relIndex_inf_mul_relIndex (⊥ : AddSubgroup (NumberField.RingOfIntegers E ⧸ L')) B Z
    rw [bot_inf_eq, inf_of_le_left hBZ, AddSubgroup.relIndex_bot_left,
      AddSubgroup.relIndex_bot_left, AddSubgroup.relIndex, AddSubgroup.index_eq_card] at h
    exact h
  have h_Me_T : Nat.card ↥Z_minus * Nat.card ↥B_plus = Nat.card ↥M_e := h_map_card T_bar
  have h_Me_D : Nat.card ↥Z_plus * Nat.card ↥B_minus = Nat.card ↥M_e := h_map_card D_bar
  have h_Z_minus : Nat.card ↥B_minus * Nat.card (Z_minus ⧸ B_minus.addSubgroupOf Z_minus) = Nat.card ↥Z_minus :=
    h_quot_card B_minus Z_minus hB_minus_le
  have h_Z_plus : Nat.card ↥B_plus * Nat.card (Z_plus ⧸ B_plus.addSubgroupOf Z_plus) = Nat.card ↥Z_plus :=
    h_quot_card B_plus Z_plus hB_plus_le
  have h_prod_pos : 0 < Nat.card ↥B_minus * Nat.card ↥B_plus :=
    Nat.mul_pos Nat.card_pos Nat.card_pos
  have h_herbrand :
      Nat.card (Z_minus ⧸ B_minus.addSubgroupOf Z_minus) =
        Nat.card (Z_plus ⧸ B_plus.addSubgroupOf Z_plus) := by
    apply Nat.mul_right_cancel h_prod_pos
    calc
      Nat.card (Z_minus ⧸ B_minus.addSubgroupOf Z_minus) * (Nat.card ↥B_minus * Nat.card ↥B_plus)
          = (Nat.card ↥B_minus * Nat.card (Z_minus ⧸ B_minus.addSubgroupOf Z_minus)) * Nat.card ↥B_plus := by ring
      _ = Nat.card ↥Z_minus * Nat.card ↥B_plus := by rw [h_Z_minus]
      _ = Nat.card ↥M_e := h_Me_T
      _ = Nat.card ↥Z_plus * Nat.card ↥B_minus := h_Me_D.symm
      _ = (Nat.card ↥B_plus * Nat.card (Z_plus ⧸ B_plus.addSubgroupOf Z_plus)) * Nat.card ↥B_minus := by rw [← h_Z_plus]
      _ = Nat.card (Z_plus ⧸ B_plus.addSubgroupOf Z_plus) * (Nat.card ↥B_minus * Nat.card ↥B_plus) := by ring
  exact ⟨h_minus_all.1, (h_minus_all.2.trans h_herbrand).trans hCard_plus.symm⟩

theorem fixed_quotient_card_le_trace_zero_idempotent_quotient_card {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (D_ram J_d m₂ m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₂_ne : m₂ ≠ ⊥)
    (hm₁_ne : m₁ ≠ ⊥)
    (h_span_d : Ideal.span {(Module.finrank F E : NumberField.RingOfIntegers F)} = D_ram * J_d)
    (hm₁_eq : m₁ = D_ram * m₂)
    (hm₀_eq : m₀ = D_ram * m₁)
    (e : NumberField.RingOfIntegers F)
    (he_Jd : e ∈ J_d)
    (he_sub : 1 - e ∈ m₀) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let d := Module.finrank F E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let Tr_G : R_E → R_E := fun z =>
      ∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z
    let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let G_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
      ∃ z ∈ I₂,
        x = Ideal.Quotient.mk I₁ z ∧
        Ideal.Quotient.mk I₁ (σ_int z) = x }
    let B_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
      ∃ a ∈ m₂,
        x = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
    let L_minus : AddSubgroup R_E := AddSubgroup.closure { y : R_E |
      y ∈ I₂ ∧ Tr_G y = 0 }
    let K_minus : AddSubgroup R_E := AddSubgroup.closure { y : R_E |
      y ∈ I₂ ∧ Tr_G y = 0 ∧
      ∃ w ∈ I₂, algebraMap R_F R_E e * y = w - σ_int w }
    Finite (L_minus ⧸ K_minus.addSubgroupOf L_minus) →
    Nat.card (G_fix ⧸ B_fix.addSubgroupOf G_fix) ≤
      Nat.card (L_minus ⧸ K_minus.addSubgroupOf L_minus) :=
by
  classical
  intro R_F R_E d σ_int Tr_G I₂ I₁ G_fix B_fix L_minus K_minus hFin
  let S_add : R_E → R_E := fun z =>
    ∑ k : Fin d, ∑ j ∈ Finset.range (k : ℕ), galRestrict R_F F E R_E (σ ^ j) z
  have h_s1 :
      (∀ z : R_E, S_add z - σ_int (S_add z) = (d : R_E) * z - Tr_G z) ∧
      (∀ z : R_E, S_add (z - σ_int z) = (d : R_E) * z - Tr_G z) ∧
      (∀ z : R_E, Tr_G (z - σ_int z) = 0) ∧
      (∀ z : R_E, σ_int (Tr_G z) = Tr_G z) ∧
      (∀ x ∈ I₂, σ_int x = x → ∃ a ∈ m₂, algebraMap R_F R_E a = x) := by
    have h_card_aut : Nat.card (E ≃ₐ[F] E) = d := IsGalois.card_aut_eq_finrank F E
    have h_order : orderOf σ = d := by
      rw [← h_card_aut]
      exact orderOf_eq_card_of_forall_mem_zpowers hCyclic
    have h_pow_d : σ ^ d = 1 := by
      rw [← h_order, pow_orderOf_eq_one]
    have h_gal_zero : ∀ z : R_E, galRestrict R_F F E R_E (σ ^ (0 : ℕ)) z = z := by
      intro z
      rw [pow_zero, map_one, AlgEquiv.one_apply]
    have h_gal_succ₁ : ∀ (j : ℕ) (z : R_E),
        galRestrict R_F F E R_E (σ ^ (j + 1)) z =
          σ_int (galRestrict R_F F E R_E (σ ^ j) z) := by
      intro j z
      rw [pow_succ', map_mul, AlgEquiv.mul_apply]
    have h_gal_succ₂ : ∀ (j : ℕ) (z : R_E),
        galRestrict R_F F E R_E (σ ^ (j + 1)) z =
          galRestrict R_F F E R_E (σ ^ j) (σ_int z) := by
      intro j z
      rw [pow_succ, map_mul, AlgEquiv.mul_apply]
    have h_gal_d : ∀ z : R_E, galRestrict R_F F E R_E (σ ^ d) z = z := by
      intro z
      rw [h_pow_d, map_one, AlgEquiv.one_apply]
    have hS_sub : ∀ z : R_E, S_add z - σ_int (S_add z) = (d : R_E) * z - Tr_G z := by
      intro z
      dsimp [S_add, Tr_G]
      rw [map_sum, ← Finset.sum_sub_distrib]
      have h_inner : ∀ k : Fin d,
          (∑ j ∈ Finset.range (k : ℕ), galRestrict R_F F E R_E (σ ^ j) z) -
            σ_int (∑ j ∈ Finset.range (k : ℕ), galRestrict R_F F E R_E (σ ^ j) z) =
          z - galRestrict R_F F E R_E (σ ^ (k : ℕ)) z := by
        intro k
        rw [map_sum, ← Finset.sum_sub_distrib]
        have h_congr : (∑ j ∈ Finset.range (k : ℕ),
              (galRestrict R_F F E R_E (σ ^ j) z - σ_int (galRestrict R_F F E R_E (σ ^ j) z))) =
            ∑ j ∈ Finset.range (k : ℕ),
              (galRestrict R_F F E R_E (σ ^ j) z - galRestrict R_F F E R_E (σ ^ (j + 1)) z) :=
          Finset.sum_congr rfl fun j _ => by rw [h_gal_succ₁]
        rw [h_congr, Finset.sum_range_sub' (fun j => galRestrict R_F F E R_E (σ ^ j) z) (k : ℕ),
          h_gal_zero]
      simp_rw [h_inner]
      rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have hS_cob : ∀ z : R_E, S_add (z - σ_int z) = (d : R_E) * z - Tr_G z := by
      intro z
      dsimp [S_add, Tr_G]
      have h_inner : ∀ k : Fin d,
          (∑ j ∈ Finset.range (k : ℕ), galRestrict R_F F E R_E (σ ^ j) (z - σ_int z)) =
          z - galRestrict R_F F E R_E (σ ^ (k : ℕ)) z := by
        intro k
        have h_congr : (∑ j ∈ Finset.range (k : ℕ), galRestrict R_F F E R_E (σ ^ j) (z - σ_int z)) =
            ∑ j ∈ Finset.range (k : ℕ),
              (galRestrict R_F F E R_E (σ ^ j) z - galRestrict R_F F E R_E (σ ^ (j + 1)) z) :=
          Finset.sum_congr rfl fun j _ => by rw [map_sub, h_gal_succ₂]
        rw [h_congr, Finset.sum_range_sub' (fun j => galRestrict R_F F E R_E (σ ^ j) z) (k : ℕ),
          h_gal_zero]
      simp_rw [h_inner]
      rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have hTr_cob : ∀ z : R_E, Tr_G (z - σ_int z) = 0 := by
      intro z
      dsimp [Tr_G]
      rw [Fin.sum_univ_eq_sum_range (fun k => galRestrict R_F F E R_E (σ ^ k) (z - σ_int z)) d]
      have h_congr : (∑ k ∈ Finset.range d, galRestrict R_F F E R_E (σ ^ k) (z - σ_int z)) =
          ∑ k ∈ Finset.range d,
            (galRestrict R_F F E R_E (σ ^ k) z - galRestrict R_F F E R_E (σ ^ (k + 1)) z) :=
        Finset.sum_congr rfl fun k _ => by rw [map_sub, h_gal_succ₂]
      rw [h_congr, Finset.sum_range_sub' (fun k => galRestrict R_F F E R_E (σ ^ k) z) d,
        h_gal_zero, h_gal_d, sub_self]
    have hTr_fix : ∀ z : R_E, σ_int (Tr_G z) = Tr_G z := by
      intro z
      apply sub_eq_zero.mp
      dsimp [Tr_G]
      rw [Fin.sum_univ_eq_sum_range (fun k => galRestrict R_F F E R_E (σ ^ k) z) d,
        map_sum, ← Finset.sum_sub_distrib]
      have h_congr : (∑ k ∈ Finset.range d,
            (σ_int (galRestrict R_F F E R_E (σ ^ k) z) - galRestrict R_F F E R_E (σ ^ k) z)) =
          ∑ k ∈ Finset.range d,
            (galRestrict R_F F E R_E (σ ^ (k + 1)) z - galRestrict R_F F E R_E (σ ^ k) z) :=
        Finset.sum_congr rfl fun k _ => by rw [h_gal_succ₁]
      rw [h_congr, Finset.sum_range_sub (fun k => galRestrict R_F F E R_E (σ ^ k) z) d,
        h_gal_d, h_gal_zero, sub_self]
    have h_fixed_I₂ : ∀ x ∈ I₂, σ_int x = x → ∃ a ∈ m₂, algebraMap R_F R_E a = x := by
      intro x hx_mem hx_fix
      have hx_E : σ (algebraMap R_E E x) = algebraMap R_E E x := by
        rw [← algebraMap_galRestrict_apply R_F σ x, hx_fix]
      have h_stab : σ ∈ MulAction.stabilizer (E ≃ₐ[F] E) (algebraMap R_E E x) := hx_E
      have h_all : ∀ ρ : E ≃ₐ[F] E, ρ (algebraMap R_E E x) = algebraMap R_E E x := by
        intro ρ
        exact (Subgroup.zpowers_le.mpr h_stab) (hCyclic ρ)
      have h_bot : algebraMap R_E E x ∈ (⊥ : IntermediateField F E) :=
        (IsGalois.mem_bot_iff_fixed (algebraMap R_E E x)).mpr h_all
      rcases IntermediateField.mem_bot.mp h_bot with ⟨y_F, hy_F⟩
      have hx_int : IsIntegral ℤ (algebraMap R_E E x) :=
        (IsIntegralClosure.isIntegral_iff (A := R_E) (R := ℤ) (B := E)).mpr ⟨x, rfl⟩
      rw [← hy_F] at hx_int
      have hy_int : IsIntegral ℤ y_F := by
        have h_tower : algebraMap F E y_F = (IsScalarTower.toAlgHom ℤ F E) y_F := rfl
        rw [h_tower] at hx_int
        exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom ℤ F E) (algebraMap F E).injective).mp hx_int
      rcases (IsIntegralClosure.isIntegral_iff (A := R_F) (R := ℤ) (B := F)).mp hy_int with ⟨a, ha⟩
      have ha_eq : algebraMap R_F R_E a = x := by
        apply IsIntegralClosure.algebraMap_injective R_E R_F E
        rw [← IsScalarTower.algebraMap_apply R_F R_E E a,
          IsScalarTower.algebraMap_apply R_F F E a, ha, hy_F]
      refine ⟨a, ?_, ha_eq⟩
      have ha_in_I₂ : algebraMap R_F R_E a ∈ I₂ := by rwa [ha_eq]
      let A₁ : Ideal R_F := m₂ ⊔ Ideal.span {a}
      have hA₁_ne : A₁ ≠ ⊥ := by
        intro h_bot
        exact hm₂_ne (le_bot_iff.mp (h_bot ▸ le_sup_left))
      have h_map_eq : Ideal.map (algebraMap R_F R_E) A₁ = Ideal.map (algebraMap R_F R_E) m₂ := by
        dsimp [A₁]
        rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton, sup_eq_left,
          Ideal.span_singleton_le_iff_mem]
        exact ha_in_I₂
      have h_bot_rel := Ideal.relNorm_algebraMap R_E (⊥ : Ideal R_F)
      rw [Ideal.map_bot, ← Submodule.zero_eq_bot, map_zero, Submodule.zero_eq_bot] at h_bot_rel
      have hrel := congrArg (Ideal.relNorm R_F) h_map_eq
      rw [Ideal.relNorm_algebraMap R_E A₁, Ideal.relNorm_algebraMap R_E m₂] at hrel
      have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hrel
      rw [UniqueFactorizationMonoid.normalizedFactors_pow,
        UniqueFactorizationMonoid.normalizedFactors_pow] at hnf
      have hnf_eq : UniqueFactorizationMonoid.normalizedFactors A₁ =
          UniqueFactorizationMonoid.normalizedFactors m₂ := by
        ext P
        have hcnt := congrArg (Multiset.count P) hnf
        rw [Multiset.count_nsmul, Multiset.count_nsmul] at hcnt
        refine Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero fun hd0 => ?_) hcnt
        rw [hd0, pow_zero, Ideal.one_eq_top] at h_bot_rel
        exact bot_ne_top h_bot_rel
      have hA₁_eq : A₁ = m₂ := by
        rw [← prod_normalizedFactors_eq_self hA₁_ne, ← prod_normalizedFactors_eq_self hm₂_ne, hnf_eq]
      have ha_mem_A₁ : a ∈ A₁ :=
        (le_sup_right : Ideal.span {a} ≤ A₁) (Ideal.mem_span_singleton_self a)
      rwa [hA₁_eq] at ha_mem_A₁
    exact ⟨hS_sub, hS_cob, hTr_cob, hTr_fix, h_fixed_I₂⟩
  obtain ⟨hS_sub, hS_cob, hTr_cob, hTr_fix, h_fixed_I₂⟩ := h_s1
  have h_s2 : ∃ F_hom : R_E →+ R_E,
      (∀ y ∈ I₂, Tr_G y = 0 → F_hom y ∈ I₂ ∧ F_hom y - σ_int (F_hom y) ∈ I₁) ∧
      (∀ y ∈ I₂, Tr_G y = 0 → (∃ w ∈ I₂, algebraMap R_F R_E e * y = w - σ_int w) →
        ∃ a ∈ m₂, F_hom y - algebraMap R_F R_E a ∈ I₁) ∧
      (∀ z ∈ I₂, z - σ_int z ∈ I₁ →
        ∃ y ∈ I₂, Tr_G y = 0 ∧ ∃ a ∈ m₂, F_hom y + algebraMap R_F R_E a - z ∈ I₁) := by
    have hd_pos : 0 < d := Module.finrank_pos
    have hd_ne_zero : (d : R_E) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
    have hS_zero : S_add 0 = 0 := by
      dsimp [S_add]
      simp
    have hS_add : ∀ z₁ z₂ : R_E, S_add (z₁ + z₂) = S_add z₁ + S_add z₂ := by
      intro z₁ z₂
      dsimp [S_add]
      simp [map_add, Finset.sum_add_distrib]
    have hS_alg_mul : ∀ (c : R_F) (z : R_E),
        S_add (algebraMap R_F R_E c * z) = algebraMap R_F R_E c * S_add z := by
      intro c z
      dsimp [S_add]
      have h_inner : ∀ k : Fin d,
          (∑ j ∈ Finset.range (k : ℕ), galRestrict R_F F E R_E (σ ^ j) (algebraMap R_F R_E c * z)) =
          algebraMap R_F R_E c * ∑ j ∈ Finset.range (k : ℕ), galRestrict R_F F E R_E (σ ^ j) z := by
        intro k
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, (galRestrict R_F F E R_E (σ ^ j)).commutes c]
      simp_rw [h_inner]
      rw [← Finset.mul_sum]
    have hS_d_mul : ∀ z : R_E, S_add ((d : R_E) * z) = (d : R_E) * S_add z := by
      intro z
      have h_eq : (d : R_E) = algebraMap R_F R_E (d : R_F) := (map_natCast (algebraMap R_F R_E) d).symm
      rw [h_eq, hS_alg_mul]
    have hTr_alg_mul : ∀ (c : R_F) (z : R_E),
        Tr_G (algebraMap R_F R_E c * z) = algebraMap R_F R_E c * Tr_G z := by
      intro c z
      dsimp [Tr_G]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, (galRestrict R_F F E R_E (σ ^ (k : ℕ))).commutes c]
    have hTr_d_mul : ∀ z : R_E, Tr_G ((d : R_E) * z) = (d : R_E) * Tr_G z := by
      intro z
      have h_eq : (d : R_E) = algebraMap R_F R_E (d : R_F) := (map_natCast (algebraMap R_F R_E) d).symm
      rw [h_eq, hTr_alg_mul]
    have h_gal_mem_map : ∀ (ρ : E ≃ₐ[F] E) (m : Ideal R_F) {w : R_E},
        w ∈ Ideal.map (algebraMap R_F R_E) m →
        galRestrict R_F F E R_E ρ w ∈ Ideal.map (algebraMap R_F R_E) m := by
      intro ρ m w hw
      have h_mem := Ideal.mem_map_of_mem (galRestrict R_F F E R_E ρ).toRingHom hw
      rw [Ideal.map_map] at h_mem
      have h_comp : (galRestrict R_F F E R_E ρ).toRingHom.comp (algebraMap R_F R_E) =
          algebraMap R_F R_E :=
        (galRestrict R_F F E R_E ρ).toAlgHom.comp_algebraMap
      rwa [h_comp] at h_mem
    have hS_mem_map : ∀ (m : Ideal R_F) {w : R_E},
        w ∈ Ideal.map (algebraMap R_F R_E) m →
        S_add w ∈ Ideal.map (algebraMap R_F R_E) m := by
      intro m w hw
      dsimp [S_add]
      exact Submodule.sum_mem _ fun k _ =>
        Submodule.sum_mem _ fun j _ => h_gal_mem_map (σ ^ j) m hw
    have hTr_mem_map : ∀ (m : Ideal R_F) {w : R_E},
        w ∈ Ideal.map (algebraMap R_F R_E) m →
        Tr_G w ∈ Ideal.map (algebraMap R_F R_E) m := by
      intro m w hw
      dsimp [Tr_G]
      exact Submodule.sum_mem _ fun k _ => h_gal_mem_map (σ ^ (k : ℕ)) m hw
    have hI₁_eq_mul : I₁ = Ideal.map (algebraMap R_F R_E) D_ram * I₂ := by
      dsimp [I₁, I₂]
      rw [hm₁_eq, Ideal.map_mul]
    have hd_mul_mem_I₁ : ∀ {z : R_E}, z ∈ I₂ → (d : R_E) * z ∈ I₁ := by
      have hd_mem_Dram : (d : R_F) ∈ D_ram := by
        have h1 : (d : R_F) ∈ Ideal.span {(d : R_F)} := Ideal.mem_span_singleton_self (d : R_F)
        rw [h_span_d] at h1
        exact Ideal.mul_le_right h1
      have hd_mem_map_Dram : (d : R_E) ∈ Ideal.map (algebraMap R_F R_E) D_ram := by
        have h1 := Ideal.mem_map_of_mem (algebraMap R_F R_E) hd_mem_Dram
        rwa [map_natCast] at h1
      intro z hz
      rw [hI₁_eq_mul]
      exact Ideal.mul_mem_mul hd_mem_map_Dram hz
    have h_div_d : ∀ {v : R_E}, v ∈ I₁ → ∃ u ∈ I₂, (d : R_E) * u = algebraMap R_F R_E e * v := by
      have h_Jd_m₁_eq : J_d * m₁ = Ideal.span {(d : R_F)} * m₂ := by
        rw [hm₁_eq, ← mul_assoc, mul_comm J_d D_ram, h_span_d]
      have h_map_eq : Ideal.map (algebraMap R_F R_E) J_d * I₁ = Ideal.span {(d : R_E)} * I₂ := by
        have h1 := congrArg (Ideal.map (algebraMap R_F R_E)) h_Jd_m₁_eq
        rwa [Ideal.map_mul, Ideal.map_mul, Ideal.map_span, Set.image_singleton, map_natCast] at h1
      have he_mem_map : algebraMap R_F R_E e ∈ Ideal.map (algebraMap R_F R_E) J_d :=
        Ideal.mem_map_of_mem (algebraMap R_F R_E) he_Jd
      intro v hv
      have h_ev_mem : algebraMap R_F R_E e * v ∈ Ideal.span {(d : R_E)} * I₂ := by
        rw [← h_map_eq]
        exact Ideal.mul_mem_mul he_mem_map hv
      obtain ⟨u, hu_mem, hu_eq⟩ := Ideal.mem_span_singleton_mul.mp h_ev_mem
      exact ⟨u, hu_mem, hu_eq⟩
    have h_one_sub_e_sq_mul_mem_I₁ : ∀ {z : R_E}, z ∈ I₂ →
        algebraMap R_F R_E (1 - e ^ 2) * z ∈ I₁ := by
      have hm₀_le_Dram : m₀ ≤ D_ram := by
        rw [hm₀_eq]
        exact Ideal.mul_le_right
      have h_sub_Dram : 1 - e ∈ D_ram := hm₀_le_Dram he_sub
      have h_sq_Dram : 1 - e ^ 2 ∈ D_ram := by
        have h_fac : 1 - e ^ 2 = (1 - e) * (1 + e) := by ring
        rw [h_fac]
        exact Ideal.mul_mem_right (1 + e) D_ram h_sub_Dram
      have h_sq_map_Dram : algebraMap R_F R_E (1 - e ^ 2) ∈ Ideal.map (algebraMap R_F R_E) D_ram :=
        Ideal.mem_map_of_mem (algebraMap R_F R_E) h_sq_Dram
      intro z hz
      rw [hI₁_eq_mul]
      exact Ideal.mul_mem_mul h_sq_map_Dram hz
    let F_hom : R_E →+ R_E :=
      { toFun := fun y => S_add (algebraMap R_F R_E e * y)
        map_zero' := by rw [mul_zero, hS_zero]
        map_add' := fun y₁ y₂ => by rw [mul_add, hS_add] }
    refine ⟨F_hom, ?_, ?_, ?_⟩
    · intro y hy_mem hy_tr
      have hey_mem : algebraMap R_F R_E e * y ∈ I₂ :=
        Ideal.mul_mem_left I₂ (algebraMap R_F R_E e) hy_mem
      refine ⟨hS_mem_map m₂ hey_mem, ?_⟩
      change S_add (algebraMap R_F R_E e * y) - σ_int (S_add (algebraMap R_F R_E e * y)) ∈ I₁
      rw [hS_sub (algebraMap R_F R_E e * y), hTr_alg_mul e y, hy_tr, mul_zero, sub_zero]
      exact hd_mul_mem_I₁ hey_mem
    · rintro y _ _ ⟨w, hw_mem, hw_eq⟩
      have hF_eq : F_hom y = (d : R_E) * w - Tr_G w := by
        change S_add (algebraMap R_F R_E e * y) = (d : R_E) * w - Tr_G w
        rw [hw_eq, hS_cob w]
      have hTr_w_mem : Tr_G w ∈ I₂ := hTr_mem_map m₂ hw_mem
      obtain ⟨a₀, ha₀_mem, ha₀_eq⟩ := h_fixed_I₂ (Tr_G w) hTr_w_mem (hTr_fix w)
      refine ⟨-a₀, Submodule.neg_mem m₂ ha₀_mem, ?_⟩
      have h_diff : F_hom y - algebraMap R_F R_E (-a₀) = (d : R_E) * w := by
        rw [hF_eq, map_neg, ha₀_eq]
        ring
      rw [h_diff]
      exact hd_mul_mem_I₁ hw_mem
    · intro z hz_mem hz_sub
      obtain ⟨y, hy_mem, hy_eq⟩ := h_div_d hz_sub
      have hd_Tr_y : (d : R_E) * Tr_G y = (d : R_E) * 0 := by
        rw [← hTr_d_mul y, hy_eq, hTr_alg_mul, hTr_cob z, mul_zero, mul_zero]
      have hy_tr : Tr_G y = 0 := mul_left_cancel₀ hd_ne_zero hd_Tr_y
      have hTr_z_eq : Tr_G z = (d : R_E) * z - S_add (z - σ_int z) := by
        rw [hS_cob z]
        ring
      have hTr_z_mem : Tr_G z ∈ I₁ := by
        rw [hTr_z_eq]
        exact Submodule.sub_mem I₁ (hd_mul_mem_I₁ hz_mem) (hS_mem_map m₁ hz_sub)
      obtain ⟨w₀, hw₀_mem, hw₀_eq⟩ := h_div_d hTr_z_mem
      have hd_w₀_fix : (d : R_E) * σ_int w₀ = (d : R_E) * w₀ := by
        have h1 : σ_int ((d : R_E) * w₀) = (d : R_E) * σ_int w₀ := by
          rw [map_mul, map_natCast]
        rw [← h1, hw₀_eq, map_mul, σ_int.commutes e, hTr_fix z, ← hw₀_eq]
      have hw₀_fix : σ_int w₀ = w₀ := mul_left_cancel₀ hd_ne_zero hd_w₀_fix
      obtain ⟨a₀, ha₀_mem, ha₀_eq⟩ := h_fixed_I₂ w₀ hw₀_mem hw₀_fix
      have hd_F_y : (d : R_E) * F_hom y =
          (d : R_E) * (algebraMap R_F R_E (e ^ 2) * z - algebraMap R_F R_E (e * a₀)) := by
        change (d : R_E) * S_add (algebraMap R_F R_E e * y) =
          (d : R_E) * (algebraMap R_F R_E (e ^ 2) * z - algebraMap R_F R_E (e * a₀))
        have h_mul_comm : (d : R_E) * (algebraMap R_F R_E e * y) =
            algebraMap R_F R_E e * ((d : R_E) * y) := by ring
        rw [← hS_d_mul, h_mul_comm, hy_eq, hS_alg_mul, hS_alg_mul, hS_cob z]
        have h_e_Tr : algebraMap R_F R_E e * Tr_G z = (d : R_E) * algebraMap R_F R_E a₀ := by
          rw [← hw₀_eq, ha₀_eq]
        calc
          algebraMap R_F R_E e * (algebraMap R_F R_E e * ((d : R_E) * z - Tr_G z))
              = (d : R_E) * (algebraMap R_F R_E e * algebraMap R_F R_E e * z) -
                  algebraMap R_F R_E e * (algebraMap R_F R_E e * Tr_G z) := by ring
          _ = (d : R_E) * (algebraMap R_F R_E (e ^ 2) * z) -
                algebraMap R_F R_E e * ((d : R_E) * algebraMap R_F R_E a₀) := by
              rw [h_e_Tr, sq, map_mul]
          _ = (d : R_E) * (algebraMap R_F R_E (e ^ 2) * z - algebraMap R_F R_E (e * a₀)) := by
              rw [map_mul]
              ring
      have hF_y_eq : F_hom y = algebraMap R_F R_E (e ^ 2) * z - algebraMap R_F R_E (e * a₀) :=
        mul_left_cancel₀ hd_ne_zero hd_F_y
      refine ⟨y, hy_mem, hy_tr, e * a₀, Ideal.mul_mem_left m₂ e ha₀_mem, ?_⟩
      have h_diff : F_hom y + algebraMap R_F R_E (e * a₀) - z =
          -(algebraMap R_F R_E (1 - e ^ 2) * z) := by
        rw [hF_y_eq, map_sub, map_one]
        ring
      rw [h_diff]
      exact Submodule.neg_mem I₁ (h_one_sub_e_sq_mul_mem_I₁ hz_mem)
  obtain ⟨F_hom, hF_G, hF_B, hF_surj⟩ := h_s2
  have hTr_zero : Tr_G 0 = 0 := by
    dsimp [Tr_G]
    simp
  have hTr_add : ∀ y₁ y₂ : R_E, Tr_G (y₁ + y₂) = Tr_G y₁ + Tr_G y₂ := by
    intro y₁ y₂
    dsimp [Tr_G]
    simp [map_add, Finset.sum_add_distrib]
  have hTr_neg : ∀ y : R_E, Tr_G (-y) = -Tr_G y := by
    intro y
    dsimp [Tr_G]
    simp [map_neg, Finset.sum_neg_distrib]
  let L_sub : AddSubgroup R_E :=
    { carrier := { y : R_E | y ∈ I₂ ∧ Tr_G y = 0 }
      zero_mem' := ⟨Submodule.zero_mem I₂, hTr_zero⟩
      add_mem' := by
        rintro y₁ y₂ ⟨hy₁_mem, hy₁_tr⟩ ⟨hy₂_mem, hy₂_tr⟩
        refine ⟨Submodule.add_mem I₂ hy₁_mem hy₂_mem, ?_⟩
        rw [hTr_add, hy₁_tr, hy₂_tr, add_zero]
      neg_mem' := by
        rintro y ⟨hy_mem, hy_tr⟩
        refine ⟨Submodule.neg_mem I₂ hy_mem, ?_⟩
        rw [hTr_neg, hy_tr, neg_zero] }
  have hL_le : L_minus ≤ L_sub := by
    rw [AddSubgroup.closure_le]
    rintro y hy
    exact hy
  let K_sub : AddSubgroup R_E :=
    { carrier := { y : R_E | y ∈ I₂ ∧ Tr_G y = 0 ∧ ∃ w ∈ I₂, algebraMap R_F R_E e * y = w - σ_int w }
      zero_mem' := ⟨Submodule.zero_mem I₂, hTr_zero, 0, Submodule.zero_mem I₂, by simp⟩
      add_mem' := by
        rintro y₁ y₂ ⟨hy₁_mem, hy₁_tr, w₁, hw₁_mem, hw₁_eq⟩ ⟨hy₂_mem, hy₂_tr, w₂, hw₂_mem, hw₂_eq⟩
        refine ⟨Submodule.add_mem I₂ hy₁_mem hy₂_mem, ?_, w₁ + w₂, Submodule.add_mem I₂ hw₁_mem hw₂_mem, ?_⟩
        · rw [hTr_add, hy₁_tr, hy₂_tr, add_zero]
        · rw [mul_add, hw₁_eq, hw₂_eq, map_add]
          ring
      neg_mem' := by
        rintro y ⟨hy_mem, hy_tr, w, hw_mem, hw_eq⟩
        refine ⟨Submodule.neg_mem I₂ hy_mem, ?_, -w, Submodule.neg_mem I₂ hw_mem, ?_⟩
        · rw [hTr_neg, hy_tr, neg_zero]
        · rw [mul_neg, hw_eq, map_neg]
          ring }
  have hK_le : K_minus ≤ K_sub := by
    rw [AddSubgroup.closure_le]
    rintro y hy
    exact hy
  have h_gal_mem_I₁ : ∀ {w : R_E}, w ∈ I₁ → σ_int w ∈ I₁ := by
    intro w hw
    have h_mem := Ideal.mem_map_of_mem σ_int.toRingHom hw
    rw [Ideal.map_map] at h_mem
    have h_comp : σ_int.toRingHom.comp (algebraMap R_F R_E) = algebraMap R_F R_E :=
      σ_int.toAlgHom.comp_algebraMap
    rwa [h_comp] at h_mem
  let σ_bar₁ : (R_E ⧸ I₁) →+* (R_E ⧸ I₁) :=
    Ideal.Quotient.lift I₁ ((Ideal.Quotient.mk I₁).comp σ_int.toRingHom)
      (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (h_gal_mem_I₁ hr))
  have h_σ_bar₁_mk : ∀ r : R_E,
      σ_bar₁ (Ideal.Quotient.mk I₁ r) = Ideal.Quotient.mk I₁ (σ_int r) :=
    fun _ => rfl
  let G_sub : AddSubgroup (R_E ⧸ I₁) :=
    { carrier := { x : R_E ⧸ I₁ | (∃ z ∈ I₂, x = Ideal.Quotient.mk I₁ z) ∧ σ_bar₁ x = x }
      zero_mem' := ⟨⟨0, Submodule.zero_mem I₂, (map_zero _).symm⟩, σ_bar₁.map_zero⟩
      add_mem' := by
        rintro x₁ x₂ ⟨⟨z₁, hz₁, rfl⟩, hx₁_fix⟩ ⟨⟨z₂, hz₂, rfl⟩, hx₂_fix⟩
        refine ⟨⟨z₁ + z₂, Submodule.add_mem I₂ hz₁ hz₂, (map_add _ _ _).symm⟩, ?_⟩
        rw [σ_bar₁.map_add, hx₁_fix, hx₂_fix]
      neg_mem' := by
        rintro x ⟨⟨z, hz, rfl⟩, hx_fix⟩
        refine ⟨⟨-z, Submodule.neg_mem I₂ hz, (map_neg _ _).symm⟩, ?_⟩
        rw [RingHom.map_neg σ_bar₁, hx_fix] }
  have hG_le : G_fix ≤ G_sub := by
    rw [AddSubgroup.closure_le]
    rintro x ⟨z, hz, rfl, h_fix⟩
    exact ⟨⟨z, hz, rfl⟩, h_fix⟩
  have h_phi_mem : ∀ y : L_minus, Ideal.Quotient.mk I₁ (F_hom y.1) ∈ G_fix := by
    intro y
    obtain ⟨hy_mem, hy_tr⟩ := hL_le y.2
    obtain ⟨hFy_mem, hFy_sub⟩ := hF_G y.1 hy_mem hy_tr
    apply AddSubgroup.subset_closure
    refine ⟨F_hom y.1, hFy_mem, rfl, ?_⟩
    exact (Ideal.Quotient.eq.mpr hFy_sub).symm
  let φ : L_minus → G_fix := fun y => ⟨Ideal.Quotient.mk I₁ (F_hom y.1), h_phi_mem y⟩
  have hφ_add : ∀ y₁ y₂ : L_minus, φ (y₁ + y₂) = φ y₁ + φ y₂ := by
    intro y₁ y₂
    apply Subtype.ext
    change Ideal.Quotient.mk I₁ (F_hom (y₁.1 + y₂.1)) =
      Ideal.Quotient.mk I₁ (F_hom y₁.1) + Ideal.Quotient.mk I₁ (F_hom y₂.1)
    rw [map_add, map_add]
  have hφ_neg : ∀ y : L_minus, φ (-y) = -φ y := by
    intro y
    apply Subtype.ext
    change Ideal.Quotient.mk I₁ (F_hom (-y.1)) = -Ideal.Quotient.mk I₁ (F_hom y.1)
    rw [map_neg, map_neg]
  have hφ_K : ∀ y : L_minus, y ∈ K_minus.addSubgroupOf L_minus →
      φ y ∈ B_fix.addSubgroupOf G_fix := by
    intro y hy
    obtain ⟨hy_mem, hy_tr, hw⟩ := hK_le hy
    obtain ⟨a, ha_mem, ha_sub⟩ := hF_B y.1 hy_mem hy_tr hw
    change Ideal.Quotient.mk I₁ (F_hom y.1) ∈ B_fix
    apply AddSubgroup.subset_closure
    exact ⟨a, ha_mem, Ideal.Quotient.eq.mpr ha_sub⟩
  let ψ : L_minus → G_fix ⧸ B_fix.addSubgroupOf G_fix :=
    fun y => QuotientAddGroup.mk (φ y)
  have hψ_rel : ∀ y₁ y₂ : L_minus,
      QuotientAddGroup.leftRel (K_minus.addSubgroupOf L_minus) y₁ y₂ → ψ y₁ = ψ y₂ := by
    intro y₁ y₂ hrel
    rw [QuotientAddGroup.leftRel_apply] at hrel
    dsimp [ψ]
    apply QuotientAddGroup.eq.mpr
    have h_eq : -φ y₁ + φ y₂ = φ (-y₁ + y₂) := by
      rw [hφ_add, hφ_neg]
    rw [h_eq]
    exact hφ_K (-y₁ + y₂) hrel
  let Ψ_minus : (L_minus ⧸ K_minus.addSubgroupOf L_minus) →
      (G_fix ⧸ B_fix.addSubgroupOf G_fix) :=
    Quotient.lift ψ hψ_rel
  have hΨ_surj : Function.Surjective Ψ_minus := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
    rcases (hG_le x.2).1 with ⟨z, hz_mem, hx_eq⟩
    have hx_fix : σ_bar₁ (x : R_E ⧸ I₁) = (x : R_E ⧸ I₁) := (hG_le x.2).2
    have hz_sub : z - σ_int z ∈ I₁ := by
      apply Ideal.Quotient.eq.mp
      rw [← h_σ_bar₁_mk, ← hx_eq, hx_fix]
    obtain ⟨y₀, hy₀_mem, hy₀_tr, a, ha_mem, ha_sub⟩ := hF_surj z hz_mem hz_sub
    have hy₀_L : y₀ ∈ L_minus := AddSubgroup.subset_closure ⟨hy₀_mem, hy₀_tr⟩
    let y : L_minus := ⟨y₀, hy₀_L⟩
    refine ⟨QuotientAddGroup.mk y, ?_⟩
    change QuotientAddGroup.mk (φ y) = QuotientAddGroup.mk x
    apply QuotientAddGroup.eq.mpr
    change -(Ideal.Quotient.mk I₁ (F_hom y₀)) + (x : R_E ⧸ I₁) ∈ B_fix
    apply AddSubgroup.subset_closure
    refine ⟨a, ha_mem, ?_⟩
    rw [hx_eq, ← map_neg, ← map_add]
    apply Ideal.Quotient.eq.mpr
    have h_neg : -F_hom y₀ + z - algebraMap R_F R_E a =
        -(F_hom y₀ + algebraMap R_F R_E a - z) := by ring
    rw [h_neg]
    exact Submodule.neg_mem I₁ ha_sub
  exact Nat.card_le_card_of_surjective Ψ_minus hΨ_surj

theorem fixed_idempotent_quotient_card_le_trace_quotient_card {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (D_ram J_d m₂ m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₁_ne : m₁ ≠ ⊥)
    (hm₀_ne : m₀ ≠ ⊥)
    (h_span_d : Ideal.span {(Module.finrank F E : NumberField.RingOfIntegers F)} = D_ram * J_d)
    (hm₁_eq : m₁ = D_ram * m₂)
    (hm₀_eq : m₀ = D_ram * m₁)
    (e b_d : NumberField.RingOfIntegers F)
    (he_Jd : e ∈ J_d)
    (he_idemp : e - e ^ 2 = (Module.finrank F E : NumberField.RingOfIntegers F) * b_d) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let d := Module.finrank F E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let Tr_G : R_E → R_E := fun z =>
      ∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) z
    let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let B_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
      ∃ a ∈ m₁,
        x = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) }
    let T_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
      ∃ z ∈ I₁,
        x = Ideal.Quotient.mk I₀ (Tr_G z) }
    let L_plus : AddSubgroup R_E := AddSubgroup.closure { x : R_E |
      x ∈ I₂ ∧ σ_int x = x }
    let K_plus : AddSubgroup R_E := AddSubgroup.closure { x : R_E |
      x ∈ I₂ ∧ σ_int x = x ∧
      ∃ w ∈ I₂, algebraMap R_F R_E e * x = Tr_G w }
    Nat.card (L_plus ⧸ K_plus.addSubgroupOf L_plus) ≤
      Nat.card (B_tr ⧸ T_tr.addSubgroupOf B_tr) :=
by
  classical
  intro R_F R_E d σ_int Tr_G I₂ I₁ I₀ B_tr T_tr L_plus K_plus
  have hd_pos : 0 < d := Module.finrank_pos
  have hd_ne_zero : (d : R_E) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
  have h_alg_inj : Function.Injective (algebraMap R_F R_E) :=
    FaithfulSMul.algebraMap_injective R_F R_E
  have h_card_aut : Nat.card (E ≃ₐ[F] E) = d := IsGalois.card_aut_eq_finrank F E
  have h_order : orderOf σ = d := by
    rw [← h_card_aut]
    exact orderOf_eq_card_of_forall_mem_zpowers hCyclic
  have h_pow_d : σ ^ d = 1 := by
    rw [← h_order, pow_orderOf_eq_one]
  have h_gal_zero : ∀ z : R_E, galRestrict R_F F E R_E (σ ^ (0 : ℕ)) z = z := by
    intro z
    rw [pow_zero, map_one, AlgEquiv.one_apply]
  have h_gal_succ : ∀ (k : ℕ) (z : R_E),
      galRestrict R_F F E R_E (σ ^ (k + 1)) z =
        σ_int (galRestrict R_F F E R_E (σ ^ k) z) := by
    intro k z
    rw [pow_succ', map_mul, AlgEquiv.mul_apply]
  have h_gal_d : ∀ z : R_E, galRestrict R_F F E R_E (σ ^ d) z = z := by
    intro z
    rw [h_pow_d, map_one, AlgEquiv.one_apply]
  have hTr_fix : ∀ z : R_E, σ_int (Tr_G z) = Tr_G z := by
    intro z
    have h_range : Tr_G z = ∑ k ∈ Finset.range d, galRestrict R_F F E R_E (σ ^ k) z :=
      Fin.sum_univ_eq_sum_range (fun k => galRestrict R_F F E R_E (σ ^ k) z) d
    have h_sub : σ_int (Tr_G z) - Tr_G z = 0 := by
      rw [h_range, map_sum, ← Finset.sum_sub_distrib]
      have h_congr : (∑ x ∈ Finset.range d, (σ_int (galRestrict R_F F E R_E (σ ^ x) z) -
            galRestrict R_F F E R_E (σ ^ x) z)) =
          ∑ x ∈ Finset.range d, (galRestrict R_F F E R_E (σ ^ (x + 1)) z -
            galRestrict R_F F E R_E (σ ^ x) z) :=
        Finset.sum_congr rfl fun x _ => by rw [h_gal_succ]
      rw [h_congr, Finset.sum_range_sub (fun x => galRestrict R_F F E R_E (σ ^ x) z) d,
        h_gal_d, h_gal_zero, sub_self]
    exact sub_eq_zero.mp h_sub
  have hTr_of_fix : ∀ x : R_E, σ_int x = x → Tr_G x = (d : R_E) * x := by
    intro x hx
    have h_pow : ∀ k : ℕ, galRestrict R_F F E R_E (σ ^ k) x = x := by
      intro k
      induction k with
      | zero => exact h_gal_zero x
      | succ k ih => rw [h_gal_succ, ih, hx]
    dsimp [Tr_G]
    have h_congr : (∑ k : Fin d, galRestrict R_F F E R_E (σ ^ (k : ℕ)) x) = ∑ _k : Fin d, x :=
      Finset.sum_congr rfl fun k _ => h_pow (k : ℕ)
    rw [h_congr, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hTr_zero : Tr_G 0 = 0 := by
    dsimp [Tr_G]
    simp
  have hTr_add : ∀ z₁ z₂ : R_E, Tr_G (z₁ + z₂) = Tr_G z₁ + Tr_G z₂ := by
    intro z₁ z₂
    dsimp [Tr_G]
    simp [map_add, Finset.sum_add_distrib]
  have hTr_neg : ∀ z : R_E, Tr_G (-z) = -Tr_G z := by
    intro z
    dsimp [Tr_G]
    simp [map_neg, Finset.sum_neg_distrib]
  have hTr_mul_algebraMap : ∀ (a : R_F) (z : R_E),
      Tr_G (algebraMap R_F R_E a * z) = algebraMap R_F R_E a * Tr_G z := by
    intro a z
    dsimp [Tr_G]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, (galRestrict R_F F E R_E (σ ^ (k : ℕ))).commutes a]
  have hTr_mul_natCast : ∀ z : R_E, Tr_G ((d : R_E) * z) = (d : R_E) * Tr_G z := by
    intro z
    dsimp [Tr_G]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, map_natCast]
  have h_fixed_elem : ∀ y : R_E, σ_int y = y → ∃ b : R_F, algebraMap R_F R_E b = y := by
    intro y hy
    have hy_E : σ (algebraMap R_E E y) = algebraMap R_E E y := by
      rw [← algebraMap_galRestrict_apply R_F σ y, hy]
    have h_stab : σ ∈ MulAction.stabilizer (E ≃ₐ[F] E) (algebraMap R_E E y) := hy_E
    have h_all : ∀ ρ : E ≃ₐ[F] E, ρ (algebraMap R_E E y) = algebraMap R_E E y := by
      intro ρ
      exact (Subgroup.zpowers_le.mpr h_stab) (hCyclic ρ)
    have h_bot : algebraMap R_E E y ∈ (⊥ : IntermediateField F E) :=
      (IsGalois.mem_bot_iff_fixed (algebraMap R_E E y)).mpr h_all
    rcases IntermediateField.mem_bot.mp h_bot with ⟨y_F, hy_F⟩
    have hy_int_E : IsIntegral ℤ (algebraMap R_E E y) :=
      (IsIntegralClosure.isIntegral_iff (A := R_E) (R := ℤ) (B := E)).mpr ⟨y, rfl⟩
    rw [← hy_F] at hy_int_E
    have hy_int : IsIntegral ℤ y_F := by
      have h_tower : algebraMap F E y_F = (IsScalarTower.toAlgHom ℤ F E) y_F := rfl
      rw [h_tower] at hy_int_E
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom ℤ F E) (algebraMap F E).injective).mp hy_int_E
    rcases (IsIntegralClosure.isIntegral_iff (A := R_F) (R := ℤ) (B := F)).mp hy_int with ⟨b, hb⟩
    refine ⟨b, ?_⟩
    apply IsIntegralClosure.algebraMap_injective R_E R_F E
    rw [← IsScalarTower.algebraMap_apply R_F R_E E b,
      IsScalarTower.algebraMap_apply R_F F E b, hb, hy_F]
  have h_map_inj : ∀ A₁ A₂ : Ideal R_F,
      A₁ ≠ ⊥ → A₂ ≠ ⊥ →
      Ideal.map (algebraMap R_F R_E) A₁ = Ideal.map (algebraMap R_F R_E) A₂ →
      A₁ = A₂ := by
    intro A₁ A₂ hA₁ hA₂ hmap
    have h_bot := Ideal.relNorm_algebraMap R_E (⊥ : Ideal R_F)
    rw [Ideal.map_bot, ← Submodule.zero_eq_bot, map_zero, Submodule.zero_eq_bot] at h_bot
    have hrel := congrArg (Ideal.relNorm R_F) hmap
    rw [Ideal.relNorm_algebraMap R_E A₁, Ideal.relNorm_algebraMap R_E A₂] at hrel
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hrel
    rw [UniqueFactorizationMonoid.normalizedFactors_pow,
      UniqueFactorizationMonoid.normalizedFactors_pow] at hnf
    have hnf_eq : UniqueFactorizationMonoid.normalizedFactors A₁ =
        UniqueFactorizationMonoid.normalizedFactors A₂ := by
      ext P
      have hcnt := congrArg (Multiset.count P) hnf
      rw [Multiset.count_nsmul, Multiset.count_nsmul] at hcnt
      refine Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero fun hd0 => ?_) hcnt
      rw [hd0, pow_zero, Ideal.one_eq_top] at h_bot
      exact bot_ne_top h_bot
    rw [← prod_normalizedFactors_eq_self hA₁, ← prod_normalizedFactors_eq_self hA₂, hnf_eq]
  have h_contract : ∀ y ∈ I₁, σ_int y = y → ∃ b ∈ m₁, algebraMap R_F R_E b = y := by
    intro y hy_mem hy_fix
    obtain ⟨b, hb_eq⟩ := h_fixed_elem y hy_fix
    refine ⟨b, ?_, hb_eq⟩
    let A₁ : Ideal R_F := m₁ ⊔ Ideal.span {b}
    have hA₁_ne : A₁ ≠ ⊥ := by
      intro h_bot
      exact hm₁_ne (le_bot_iff.mp (le_sup_left.trans h_bot.le))
    have h_map_eq : Ideal.map (algebraMap R_F R_E) A₁ = Ideal.map (algebraMap R_F R_E) m₁ := by
      dsimp [A₁]
      rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton, hb_eq]
      exact sup_eq_left.mpr ((Ideal.span_singleton_le_iff_mem I₁).mpr hy_mem)
    have h_eq : A₁ = m₁ := h_map_inj A₁ m₁ hA₁_ne hm₁_ne h_map_eq
    have h_le : Ideal.span {b} ≤ m₁ := le_sup_right.trans h_eq.le
    exact (Ideal.span_singleton_le_iff_mem m₁).mp h_le
  have h_Jd_m₁ : J_d * m₁ = Ideal.span {(d : R_F)} * m₂ := by
    rw [hm₁_eq, ← mul_assoc, mul_comm J_d D_ram, h_span_d]
  have h_Jd_m₀ : J_d * m₀ = Ideal.span {(d : R_F)} * m₁ := by
    rw [hm₀_eq, ← mul_assoc, mul_comm J_d D_ram, h_span_d]
  have h_map_₁ : Ideal.map (algebraMap R_F R_E) J_d * I₁ = Ideal.span {(d : R_E)} * I₂ := by
    have h1 := congrArg (Ideal.map (algebraMap R_F R_E)) h_Jd_m₁
    rwa [Ideal.map_mul, Ideal.map_mul, Ideal.map_span, Set.image_singleton, map_natCast] at h1
  have h_map_₀ : Ideal.map (algebraMap R_F R_E) J_d * I₀ = Ideal.span {(d : R_E)} * I₁ := by
    have h1 := congrArg (Ideal.map (algebraMap R_F R_E)) h_Jd_m₀
    rwa [Ideal.map_mul, Ideal.map_mul, Ideal.map_span, Set.image_singleton, map_natCast] at h1
  have hd_I₁ : ∀ x ∈ I₂, (d : R_E) * x ∈ I₁ := by
    intro x hx
    have h_span_le_D : Ideal.span {(d : R_F)} ≤ D_ram := by
      rw [h_span_d]
      exact Ideal.mul_le_right
    have h_m₂_le : Ideal.span {(d : R_F)} * m₂ ≤ m₁ := by
      rw [hm₁_eq]
      exact Ideal.mul_mono_left h_span_le_D
    have h_I₂_le : Ideal.span {(d : R_E)} * I₂ ≤ I₁ := by
      have h1 := Ideal.map_mono (f := algebraMap R_F R_E) h_m₂_le
      rwa [Ideal.map_mul, Ideal.map_span, Set.image_singleton, map_natCast] at h1
    exact h_I₂_le (Ideal.mul_mem_mul (Ideal.mem_span_singleton_self (d : R_E)) hx)
  have h_mul_d : ∀ x ∈ I₂, σ_int x = x → ∃ b ∈ m₁, (d : R_E) * x = algebraMap R_F R_E b := by
    intro x hx_mem hx_fix
    have hdx_mem : (d : R_E) * x ∈ I₁ := hd_I₁ x hx_mem
    have hdx_fix : σ_int ((d : R_E) * x) = (d : R_E) * x := by
      rw [map_mul, map_natCast, hx_fix]
    obtain ⟨b, hb_mem, hb_eq⟩ := h_contract ((d : R_E) * x) hdx_mem hdx_fix
    exact ⟨b, hb_mem, hb_eq.symm⟩
  have h_div_eb : ∀ b ∈ m₁, ∃ x ∈ I₂, σ_int x = x ∧ (d : R_E) * x = algebraMap R_F R_E (e * b) := by
    intro b hb
    have heb_mem : e * b ∈ Ideal.span {(d : R_F)} * m₂ := by
      rw [← h_Jd_m₁]
      exact Ideal.mul_mem_mul he_Jd hb
    obtain ⟨a_b, ha_b_mem, ha_b_eq⟩ := Ideal.mem_span_singleton_mul.mp heb_mem
    refine ⟨algebraMap R_F R_E a_b, Ideal.mem_map_of_mem (algebraMap R_F R_E) ha_b_mem,
      σ_int.commutes a_b, ?_⟩
    have h1 := congrArg (algebraMap R_F R_E) ha_b_eq
    rwa [map_mul, map_natCast] at h1
  have h_ker_tr : ∀ (b : R_F) (x z₁ : R_E),
      x ∈ I₂ → z₁ ∈ I₁ → σ_int x = x →
      (d : R_E) * x = algebraMap R_F R_E (e * b) →
      algebraMap R_F R_E b - Tr_G z₁ ∈ I₀ →
      ∃ w ∈ I₂, algebraMap R_F R_E e * x = Tr_G w := by
    intro b x z₁ hx_mem hz₁_mem hx_fix hdx_eq hu₀_mem
    let e_E : R_E := algebraMap R_F R_E e
    have he_map : e_E ∈ Ideal.map (algebraMap R_F R_E) J_d :=
      Ideal.mem_map_of_mem (algebraMap R_F R_E) he_Jd
    have hez₁_mem : e_E * z₁ ∈ Ideal.span {(d : R_E)} * I₂ := by
      rw [← h_map_₁]
      exact Ideal.mul_mem_mul he_map hz₁_mem
    obtain ⟨z₂, hz₂_mem, hz₂_eq⟩ := Ideal.mem_span_singleton_mul.mp hez₁_mem
    have hTr_z₂ : (d : R_E) * Tr_G z₂ = e_E * Tr_G z₁ := by
      rw [← hTr_mul_natCast z₂, hz₂_eq, hTr_mul_algebraMap e z₁]
    let u₀ : R_E := algebraMap R_F R_E b - Tr_G z₁
    have heu₀_mem : e_E * u₀ ∈ Ideal.span {(d : R_E)} * I₁ := by
      rw [← h_map_₀]
      exact Ideal.mul_mem_mul he_map hu₀_mem
    obtain ⟨w₁, hw₁_mem, hw₁_eq⟩ := Ideal.mem_span_singleton_mul.mp heu₀_mem
    have h_dw₁ : (d : R_E) * (x - Tr_G z₂) = (d : R_E) * w₁ := by
      calc
        (d : R_E) * (x - Tr_G z₂)
            = (d : R_E) * x - (d : R_E) * Tr_G z₂ := by ring
        _ = algebraMap R_F R_E (e * b) - e_E * Tr_G z₁ := by rw [hdx_eq, hTr_z₂]
        _ = e_E * u₀ := by dsimp [e_E, u₀]; rw [map_mul]; ring
        _ = (d : R_E) * w₁ := hw₁_eq.symm
    have hw₁_id : x - Tr_G z₂ = w₁ := mul_left_cancel₀ hd_ne_zero h_dw₁
    have hew₁_mem : e_E * w₁ ∈ Ideal.span {(d : R_E)} * I₂ := by
      rw [← h_map_₁]
      exact Ideal.mul_mem_mul he_map hw₁_mem
    obtain ⟨w₂, hw₂_mem, hw₂_eq⟩ := Ideal.mem_span_singleton_mul.mp hew₁_mem
    have hw₁_fix : σ_int w₁ = w₁ := by
      rw [← hw₁_id, map_sub, hx_fix, hTr_fix z₂]
    have h_dw₂_fix : (d : R_E) * σ_int w₂ = (d : R_E) * w₂ := by
      have h1 : σ_int ((d : R_E) * w₂) = (d : R_E) * σ_int w₂ := by
        rw [map_mul, map_natCast]
      rw [← h1, hw₂_eq, map_mul, σ_int.commutes e, hw₁_fix, ← hw₂_eq]
    have hw₂_fix : σ_int w₂ = w₂ := mul_left_cancel₀ hd_ne_zero h_dw₂_fix
    have hTr_w₂ : Tr_G w₂ = e_E * (x - Tr_G z₂) := by
      rw [hTr_of_fix w₂ hw₂_fix, hw₂_eq, hw₁_id]
    refine ⟨e_E * z₂ + w₂, Submodule.add_mem I₂ (Ideal.mul_mem_left I₂ e_E hz₂_mem) hw₂_mem, ?_⟩
    rw [hTr_add, hTr_mul_algebraMap e z₂, hTr_w₂]
    dsimp [e_E]
    ring
  have hI₀_ne : I₀ ≠ ⊥ := (Ideal.map_eq_bot_iff_of_injective h_alg_inj).not.mpr hm₀_ne
  haveI : Finite (R_E ⧸ I₀) := Ideal.finiteQuotientOfFreeOfNeBot I₀ hI₀_ne
  let B_sub : AddSubgroup (R_E ⧸ I₀) :=
    { carrier := { x : R_E ⧸ I₀ | ∃ a ∈ m₁, x = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) }
      zero_mem' := ⟨0, Submodule.zero_mem m₁, by simp⟩
      add_mem' := by
        rintro x₁ x₂ ⟨a₁, ha₁, rfl⟩ ⟨a₂, ha₂, rfl⟩
        exact ⟨a₁ + a₂, Submodule.add_mem m₁ ha₁ ha₂, by simp⟩
      neg_mem' := by
        rintro x ⟨a, ha, rfl⟩
        exact ⟨-a, Submodule.neg_mem m₁ ha, by simp⟩ }
  have hB_le : B_tr ≤ B_sub := by
    rw [AddSubgroup.closure_le]
    rintro x ⟨a, ha, rfl⟩
    exact ⟨a, ha, rfl⟩
  let T_sub : AddSubgroup (R_E ⧸ I₀) :=
    { carrier := { x : R_E ⧸ I₀ | ∃ z ∈ I₁, x = Ideal.Quotient.mk I₀ (Tr_G z) }
      zero_mem' := ⟨0, Submodule.zero_mem I₁, by rw [hTr_zero, map_zero]⟩
      add_mem' := by
        rintro x₁ x₂ ⟨z₁, hz₁, rfl⟩ ⟨z₂, hz₂, rfl⟩
        exact ⟨z₁ + z₂, Submodule.add_mem I₁ hz₁ hz₂, by rw [hTr_add, map_add]⟩
      neg_mem' := by
        rintro x ⟨z, hz, rfl⟩
        exact ⟨-z, Submodule.neg_mem I₁ hz, by rw [hTr_neg, map_neg]⟩ }
  have hT_le : T_tr ≤ T_sub := by
    rw [AddSubgroup.closure_le]
    rintro x ⟨z, hz, rfl⟩
    exact ⟨z, hz, rfl⟩
  let L_sub : AddSubgroup R_E :=
    { carrier := { x : R_E | x ∈ I₂ ∧ σ_int x = x }
      zero_mem' := ⟨Submodule.zero_mem I₂, map_zero σ_int⟩
      add_mem' := by
        rintro x₁ x₂ ⟨hx₁_mem, hx₁_fix⟩ ⟨hx₂_mem, hx₂_fix⟩
        exact ⟨Submodule.add_mem I₂ hx₁_mem hx₂_mem, by rw [map_add, hx₁_fix, hx₂_fix]⟩
      neg_mem' := by
        rintro x ⟨hx_mem, hx_fix⟩
        exact ⟨Submodule.neg_mem I₂ hx_mem, by rw [map_neg, hx_fix]⟩ }
  have hL_le : L_plus ≤ L_sub := by
    rw [AddSubgroup.closure_le]
    rintro x ⟨hx_mem, hx_fix⟩
    exact ⟨hx_mem, hx_fix⟩
  let b_of : B_tr → R_F := fun u => Classical.choose (hB_le u.2)
  have hb_of_mem : ∀ u : B_tr, b_of u ∈ m₁ :=
    fun u => (Classical.choose_spec (hB_le u.2)).1
  have hb_of_eq : ∀ u : B_tr,
      (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ (algebraMap R_F R_E (b_of u)) :=
    fun u => (Classical.choose_spec (hB_le u.2)).2
  let x_val : B_tr → R_E := fun u => Classical.choose (h_div_eb (b_of u) (hb_of_mem u))
  have hx_val_mem : ∀ u : B_tr, x_val u ∈ I₂ :=
    fun u => (Classical.choose_spec (h_div_eb (b_of u) (hb_of_mem u))).1
  have hx_val_fix : ∀ u : B_tr, σ_int (x_val u) = x_val u :=
    fun u => (Classical.choose_spec (h_div_eb (b_of u) (hb_of_mem u))).2.1
  have hx_val_eq : ∀ u : B_tr, (d : R_E) * x_val u = algebraMap R_F R_E (e * b_of u) :=
    fun u => (Classical.choose_spec (h_div_eb (b_of u) (hb_of_mem u))).2.2
  have hx_val_L : ∀ u : B_tr, x_val u ∈ L_plus :=
    fun u => AddSubgroup.subset_closure ⟨hx_val_mem u, hx_val_fix u⟩
  let x_of : B_tr → L_plus := fun u => ⟨x_val u, hx_val_L u⟩
  let ψ_plus : B_tr → L_plus ⧸ K_plus.addSubgroupOf L_plus :=
    fun u => QuotientAddGroup.mk (x_of u)
  have hψ_plus_rel : ∀ u₁ u₂ : B_tr,
      QuotientAddGroup.leftRel (T_tr.addSubgroupOf B_tr) u₁ u₂ → ψ_plus u₁ = ψ_plus u₂ := by
    intro u₁ u₂ hrel
    rw [QuotientAddGroup.leftRel_apply] at hrel
    dsimp [ψ_plus]
    apply QuotientAddGroup.eq.mpr
    change -(x_val u₁) + x_val u₂ ∈ K_plus
    obtain ⟨z₁, hz₁_mem, hz₁_eq⟩ := hT_le hrel
    have h_u_diff : (-(u₁ : R_E ⧸ I₀) + (u₂ : R_E ⧸ I₀)) =
        Ideal.Quotient.mk I₀ (algebraMap R_F R_E (b_of u₂ - b_of u₁)) := by
      rw [hb_of_eq u₁, hb_of_eq u₂, map_sub, map_sub, neg_add_eq_sub]
    have h_mk_eq : Ideal.Quotient.mk I₀ (algebraMap R_F R_E (b_of u₂ - b_of u₁)) =
        Ideal.Quotient.mk I₀ (Tr_G z₁) := by
      rw [← h_u_diff]
      exact hz₁_eq
    have hu₀_mem : algebraMap R_F R_E (b_of u₂ - b_of u₁) - Tr_G z₁ ∈ I₀ :=
      Ideal.Quotient.eq.mp h_mk_eq
    let x_diff : R_E := -(x_val u₁) + x_val u₂
    have hx_diff_mem : x_diff ∈ I₂ :=
      Submodule.add_mem I₂ (Submodule.neg_mem I₂ (hx_val_mem u₁)) (hx_val_mem u₂)
    have hx_diff_fix : σ_int x_diff = x_diff := by
      dsimp [x_diff]
      rw [map_add, map_neg, hx_val_fix u₁, hx_val_fix u₂]
    have hx_diff_d : (d : R_E) * x_diff = algebraMap R_F R_E (e * (b_of u₂ - b_of u₁)) := by
      calc
        (d : R_E) * x_diff = -((d : R_E) * x_val u₁) + (d : R_E) * x_val u₂ := by
          dsimp [x_diff]; ring
        _ = -(algebraMap R_F R_E (e * b_of u₁)) + algebraMap R_F R_E (e * b_of u₂) := by
          rw [hx_val_eq u₁, hx_val_eq u₂]
        _ = algebraMap R_F R_E (e * (b_of u₂ - b_of u₁)) := by
          rw [mul_sub, map_sub, neg_add_eq_sub]
    obtain ⟨w, hw_mem, hw_eq⟩ :=
      h_ker_tr (b_of u₂ - b_of u₁) x_diff z₁ hx_diff_mem hz₁_mem hx_diff_fix hx_diff_d hu₀_mem
    exact AddSubgroup.subset_closure ⟨hx_diff_mem, hx_diff_fix, ⟨w, hw_mem, hw_eq⟩⟩
  let Ψ_plus : (B_tr ⧸ T_tr.addSubgroupOf B_tr) → (L_plus ⧸ K_plus.addSubgroupOf L_plus) :=
    Quotient.lift ψ_plus hψ_plus_rel
  have hΨ_plus_surj : Function.Surjective Ψ_plus := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
    rcases hL_le x.2 with ⟨hx_mem, hx_fix⟩
    obtain ⟨b, hb_mem, hb_eq⟩ := h_mul_d x.1 hx_mem hx_fix
    let u_val : R_E ⧸ I₀ := Ideal.Quotient.mk I₀ (algebraMap R_F R_E b)
    have hu_mem : u_val ∈ B_tr := AddSubgroup.subset_closure ⟨b, hb_mem, rfl⟩
    let u : B_tr := ⟨u_val, hu_mem⟩
    refine ⟨QuotientAddGroup.mk u, ?_⟩
    change QuotientAddGroup.mk (x_of u) = QuotientAddGroup.mk x
    apply QuotientAddGroup.eq.mpr
    change -(x_val u) + x.1 ∈ K_plus
    have h_mk_b : Ideal.Quotient.mk I₀ (algebraMap R_F R_E (b - b_of u)) =
        Ideal.Quotient.mk I₀ (Tr_G 0) := by
      rw [hTr_zero, map_zero, map_sub, map_sub, ← hb_of_eq u]
      exact sub_self u_val
    have hu₀_mem : algebraMap R_F R_E (b - b_of u) - Tr_G 0 ∈ I₀ :=
      Ideal.Quotient.eq.mp h_mk_b
    let x_diff : R_E := algebraMap R_F R_E e * x.1 - x_val u
    have hx_diff_mem : x_diff ∈ I₂ :=
      Submodule.sub_mem I₂ (Ideal.mul_mem_left I₂ (algebraMap R_F R_E e) hx_mem) (hx_val_mem u)
    have hx_diff_fix : σ_int x_diff = x_diff := by
      dsimp [x_diff]
      rw [map_sub, map_mul, σ_int.commutes e, hx_fix, hx_val_fix u]
    have hx_diff_d : (d : R_E) * x_diff = algebraMap R_F R_E (e * (b - b_of u)) := by
      calc
        (d : R_E) * x_diff = algebraMap R_F R_E e * ((d : R_E) * x.1) - (d : R_E) * x_val u := by
          dsimp [x_diff]; ring
        _ = algebraMap R_F R_E e * algebraMap R_F R_E b - algebraMap R_F R_E (e * b_of u) := by
          rw [hb_eq, hx_val_eq u]
        _ = algebraMap R_F R_E (e * (b - b_of u)) := by
          rw [mul_sub, map_sub, ← map_mul]
    obtain ⟨w₀, hw₀_mem, hw₀_eq⟩ :=
      h_ker_tr (b - b_of u) x_diff 0 hx_diff_mem (Submodule.zero_mem I₁) hx_diff_fix hx_diff_d hu₀_mem
    let w_d : R_E := algebraMap R_F R_E b_d * x.1
    have hw_d_mem : w_d ∈ I₂ := Ideal.mul_mem_left I₂ (algebraMap R_F R_E b_d) hx_mem
    have hw_d_fix : σ_int w_d = w_d := by
      dsimp [w_d]
      rw [map_mul, σ_int.commutes b_d, hx_fix]
    have hTr_wd : Tr_G w_d = algebraMap R_F R_E (e - e ^ 2) * x.1 := by
      rw [hTr_of_fix w_d hw_d_fix, he_idemp, map_mul, map_natCast]
      dsimp [w_d]
      ring
    have h_mem_I₂ : -(x_val u) + x.1 ∈ I₂ :=
      Submodule.add_mem I₂ (Submodule.neg_mem I₂ (hx_val_mem u)) hx_mem
    have h_fix : σ_int (-(x_val u) + x.1) = -(x_val u) + x.1 := by
      rw [map_add, map_neg, hx_val_fix u, hx_fix]
    refine AddSubgroup.subset_closure ⟨h_mem_I₂, h_fix, ⟨w₀ + w_d, Submodule.add_mem I₂ hw₀_mem hw_d_mem, ?_⟩⟩
    rw [hTr_add, ← hw₀_eq, hTr_wd]
    dsimp [x_diff]
    rw [map_sub, map_pow]
    ring
  exact Nat.card_le_card_of_surjective Ψ_plus hΨ_plus_surj

theorem fixed_quotient_card_le_trace_quotient_card_of_ramified_tower {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (D_ram J_d m₂ m₁ m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₂_ne : m₂ ≠ ⊥)
    (hm₁_ne : m₁ ≠ ⊥)
    (hm₀_ne : m₀ ≠ ⊥)
    (h_span_d : Ideal.span {(Module.finrank F E : NumberField.RingOfIntegers F)} = D_ram * J_d)
    (h_cop_Jd : IsCoprime J_d m₀)
    (hm₁_eq : m₁ = D_ram * m₂)
    (hm₀_eq : m₀ = D_ram * m₁)
    (h_dvd : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      (q.asIdeal ∣ m₂ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ m₁ ↔ q.asIdeal ∣ m₀) ∧
      (q.asIdeal ∣ D_ram → q.asIdeal ∣ m₀)) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
    let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
    let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
    let G_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
      ∃ z ∈ I₂,
        x = Ideal.Quotient.mk I₁ z ∧
        Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ z) = x }
    let B_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
      ∃ a ∈ m₂,
        x = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
    let B_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
      ∃ a ∈ m₁,
        x = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) }
    let T_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
      ∃ z ∈ I₁,
        x = Ideal.Quotient.mk I₀
          (∑ k : Fin (Module.finrank F E),
            galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) }
    Nat.card (G_fix ⧸ B_fix.addSubgroupOf G_fix) ≤
      Nat.card (B_tr ⧸ T_tr.addSubgroupOf B_tr) :=
by
  obtain ⟨L', a₀, ha₀_ne, hL'_le, hL'_smul, hL'_gal, ha₀_mem, hL'_fix, hL'_tr⟩ :=
    exists_normalBasis_addSubgroup_le_map σ hCyclic m₂ hm₂_ne
  obtain ⟨e, he_Jd, he_sub, c, he_idemp⟩ :=
    exists_idempotent_mem_of_span_eq_mul_and_isCoprime
      D_ram J_d m₀ hm₀_ne (Module.finrank F E) Module.finrank_pos h_span_d h_cop_Jd a₀ ha₀_ne
  obtain ⟨hFin_minus, h_s3⟩ :=
    idempotent_herbrand_quotient_card_eq_of_normalBasis_addSubgroup
      σ hCyclic m₂ L' hL'_le hL'_smul hL'_gal a₀ ha₀_ne ha₀_mem hL'_fix hL'_tr e c he_idemp
  have h_s4 :=
    fixed_quotient_card_le_trace_zero_idempotent_quotient_card
      σ hCyclic D_ram J_d m₂ m₁ m₀ hm₂_ne hm₁_ne h_span_d hm₁_eq hm₀_eq e he_Jd he_sub hFin_minus
  have h_s5 :=
    fixed_idempotent_quotient_card_le_trace_quotient_card
      σ hCyclic D_ram J_d m₂ m₁ m₀ hm₁_ne hm₀_ne h_span_d hm₁_eq hm₀_eq e (a₀ * c) he_Jd
      (by rw [← mul_assoc]; exact he_idemp)
  exact h_s4.trans (h_s3.le.trans h_s5)

theorem exists_ramified_exponents_coprime_norm_one_quotient_le_mod_norm_index {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    ∃ c₀ : IsDedekindDomain.HeightOneSpectrum R_F → ℕ,
      (∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        ¬ IsUnramifiedAtPrime F E q → 1 ≤ c₀ q) ∧
      ∀ (m₀ : Ideal R_F),
        m₀ ≠ ⊥ →
        (∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
          q.asIdeal ∣ m₀ ↔ ¬ IsUnramifiedAtPrime F E q) →
        (∀ a : R_F,
          (∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
            ¬ IsUnramifiedAtPrime F E q → a - 1 ∈ q.asIdeal ^ (c₀ q)) ↔
          a - 1 ∈ m₀) →
        let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
          ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
            IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
        let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
        let B_cop : Subgroup Eˣ :=
          Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
        let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
          ∃ b : R_E,
            (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
        Nat.card (K_cop ⧸ B_cop.subgroupOf K_cop) ≤
          Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) :=
by
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  obtain ⟨c₀, hc₀_pos, h_tower⟩ :=
    exists_ramified_exponents_and_tower_ideals (F := F) (E := E)
  refine ⟨c₀, hc₀_pos, fun m₀ hm₀_ne hm₀_dvd hm₀_mem => ?_⟩
  obtain ⟨D_ram, J_d, m₂, m₁, t₀, _hD_ne, _hJd_ne, hm₂_ne, hm₁_ne,
    h_span_d, h_cop_Jd, hm₁_eq, hm₀_eq, hm₂_sq, hm₁_sq, h_dvd, ht₀_mem, ht₀_sub⟩ :=
    h_tower m₀ hm₀_ne hm₀_dvd hm₀_mem
  have h_s2 :=
    coprime_norm_one_quotient_le_mod_unit_cohomology_image
      σ hCyclic D_ram J_d m₂ m₁ m₀ t₀ hm₀_ne h_span_d hm₁_eq hm₀_eq h_dvd ht₀_mem ht₀_sub
  have h_s3 :=
    mod_unit_cohomology_image_mul_congruence_norm_le_mod_norm_mul_congruence_fixed
      σ hCyclic D_ram m₁ m₀ hm₁_ne hm₀_ne hm₀_eq hm₁_sq (fun q => (h_dvd q).2.1)
  obtain ⟨hQtr_pos, h_s4_fix, h_s4_tr⟩ :=
    congruence_fixed_and_norm_quotients_le_additive_quotients
      σ hCyclic D_ram J_d m₂ m₁ m₀ t₀ hm₂_ne hm₁_ne hm₀_ne
      h_span_d hm₁_eq hm₀_eq hm₂_sq hm₁_sq h_dvd ht₀_mem ht₀_sub
  have h_s5 :=
    fixed_quotient_card_le_trace_quotient_card_of_ramified_tower
      σ hCyclic D_ram J_d m₂ m₁ m₀ hm₂_ne hm₁_ne hm₀_ne
      h_span_d h_cop_Jd hm₁_eq hm₀_eq h_dvd
  let I₂ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₂
  let I₁ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₁
  let I₀ : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
  let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
    ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
  let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
  let B_cop : Subgroup Eˣ :=
    Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
  let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
    ∃ b : R_E,
      (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
  let K_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
    ∃ b : R_E,
      (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
      Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) = 1 }
  let B_mod : Subgroup (R_E ⧸ I₀)ˣ := Subgroup.closure { u : (R_E ⧸ I₀)ˣ |
    ∃ b c : R_E,
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E c}) m₀ ∧
      (u : R_E ⧸ I₀) = Ideal.Quotient.mk I₀ b ∧
      Ideal.Quotient.mk I₁ (b * galRestrict R_F F E R_E σ c) =
        Ideal.Quotient.mk I₁ c }
  let U_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
    ∃ b : R_E,
      (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ b ∧
      Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ b) = (u : R_E ⧸ I₁) }
  let F_fix : Subgroup (R_E ⧸ I₁)ˣ := Subgroup.closure { u : (R_E ⧸ I₁)ˣ |
    ∃ a : R_F,
      (u : R_E ⧸ I₁) = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
  let U_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
    ∃ a ∈ m₁,
      (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (1 + a) }
  let N_ker : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
    ∃ z ∈ I₁,
      (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E (1 + z)) }
  let G_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
    ∃ z ∈ I₂,
      x = Ideal.Quotient.mk I₁ z ∧
      Ideal.Quotient.mk I₁ (galRestrict R_F F E R_E σ z) = x }
  let B_fix : AddSubgroup (R_E ⧸ I₁) := AddSubgroup.closure { x : R_E ⧸ I₁ |
    ∃ a ∈ m₂,
      x = Ideal.Quotient.mk I₁ (algebraMap R_F R_E a) }
  let B_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
    ∃ a ∈ m₁,
      x = Ideal.Quotient.mk I₀ (algebraMap R_F R_E a) }
  let T_tr : AddSubgroup (R_E ⧸ I₀) := AddSubgroup.closure { x : R_E ⧸ I₀ |
    ∃ z ∈ I₁,
      x = Ideal.Quotient.mk I₀
        (∑ k : Fin (Module.finrank F E),
          galRestrict R_F F E R_E (σ ^ (k : ℕ)) z) }
  let K_quot := Nat.card (K_cop ⧸ B_cop.subgroupOf K_cop)
  let H_mod := Nat.card (K_mod ⧸ B_mod.subgroupOf K_mod)
  let Q_mod := Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod)
  let M_fix := Nat.card (U_fix ⧸ F_fix.subgroupOf U_fix)
  let M_ker := Nat.card (U_ker ⧸ N_ker.subgroupOf U_ker)
  let Q_fix := Nat.card (G_fix ⧸ B_fix.addSubgroupOf G_fix)
  let Q_tr := Nat.card (B_tr ⧸ T_tr.addSubgroupOf B_tr)
  change K_quot ≤ H_mod at h_s2
  change H_mod * M_ker ≤ Q_mod * M_fix at h_s3
  change 0 < Q_tr at hQtr_pos
  change M_fix ≤ Q_fix at h_s4_fix
  change Q_tr ≤ M_ker at h_s4_tr
  change Q_fix ≤ Q_tr at h_s5
  change K_quot ≤ Q_mod
  have h_mul_ineq : K_quot * Q_tr ≤ Q_mod * Q_tr := by
    calc
      K_quot * Q_tr
          ≤ H_mod * Q_tr := Nat.mul_le_mul_right Q_tr h_s2
      _ ≤ H_mod * M_ker := Nat.mul_le_mul_left H_mod h_s4_tr
      _ ≤ Q_mod * M_fix := h_s3
      _ ≤ Q_mod * Q_fix := Nat.mul_le_mul_left Q_mod h_s4_fix
      _ ≤ Q_mod * Q_tr := Nat.mul_le_mul_left Q_mod h_s5
  exact Nat.le_of_mul_le_mul_right h_mul_ineq hQtr_pos

theorem exists_ramified_exponents_norm_ray_cells_card_bound {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ) :
    ∃ c₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ,
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        ¬ IsUnramifiedAtPrime F E q → 1 ≤ c₀ q) ∧
      ∀ (m₀ : Ideal (NumberField.RingOfIntegers F)),
        m₀ ≠ ⊥ →
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          q.asIdeal ∣ m₀ ↔ ¬ IsUnramifiedAtPrime F E q) →
        (∀ a : NumberField.RingOfIntegers F,
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            ¬ IsUnramifiedAtPrime F E q → a - 1 ∈ q.asIdeal ^ (c₀ q)) ↔
          a - 1 ∈ m₀) →
        ∀ (N_ray : ℕ) (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F)),
          (∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀) →
          (∀ I : Ideal (NumberField.RingOfIntegers F),
            I ≠ ⊥ → IsCoprime I m₀ →
            ∃ j : Fin N_ray,
              ∃ a : NumberField.RingOfIntegers F,
                a - 1 ∈ m₀ ∧
                (∀ w : NumberField.InfinitePlace F,
                  w.IsReal → 0 < (w.embedding (a : F)).re) ∧
                I * J_all j = Ideal.span {a}) →
          (∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
            I ≠ ⊥ →
            (∃ a : NumberField.RingOfIntegers F,
              a - 1 ∈ m₀ ∧
              (∀ w : NumberField.InfinitePlace F,
                w.IsReal → 0 < (w.embedding (a : F)).re) ∧
              I * J_all j₁ = Ideal.span {a}) →
            (∃ a : NumberField.RingOfIntegers F,
              a - 1 ∈ m₀ ∧
              (∀ w : NumberField.InfinitePlace F,
                w.IsReal → 0 < (w.embedding (a : F)).re) ∧
              I * J_all j₂ = Ideal.span {a}) →
            j₁ = j₂) →
          (Nat.card ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker ⧸
            ((MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
              Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).range.subgroupOf
              (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker)) *
            2 ^ (Nat.card { w : NumberField.InfinitePlace F //
              w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal })) *
            Nat.card { j : Fin N_ray //
              ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
                (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
                a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
                a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
                (∀ w : NumberField.InfinitePlace F,
                  w.IsReal →
                  0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
                J_all j * Ideal.span {a₁} *
                    Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
                  Ideal.span {a₂} *
                    Ideal.relNorm (NumberField.RingOfIntegers F) B₂ } ≤
          N_ray *
            Nat.card ((NumberField.RingOfIntegers F)ˣ ⧸
              (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).range) :=
by
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  obtain ⟨c₀, hc₀_pos, hc₀_mod⟩ :=
    exists_ramified_exponents_coprime_norm_one_quotient_le_mod_norm_index σ hCyclic
  refine ⟨c₀, hc₀_pos, fun m₀ hm₀_ne hm₀_dvd hm₀_mem N_ray J_all hJ_prop hJ_cov hJ_inj => ?_⟩
  have h_s1 := narrow_ray_partition_card_eq_classGroup_mul_isPrincipal_card
    m₀ hm₀_ne N_ray J_all hJ_prop hJ_cov hJ_inj
  obtain ⟨hQmod_pos, hMpnorm_pos, h_s2⟩ :=
    principal_narrow_ray_norm_cells_card_bound_of_nonzero (E := E) m₀ hm₀_ne N_ray J_all hJ_prop hJ_cov hJ_inj
  have h_s3 := norm_ray_cells_card_mul_unit_ker_le_classGroup_mul_pnorm_of_nonzero
    σ hCyclic m₀ hm₀_ne hm₀_dvd N_ray J_all hJ_prop hJ_cov hJ_inj
  have h_s4 := hc₀_mod m₀ hm₀_ne hm₀_dvd hm₀_mem
  let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
    ∃ b : R_E,
      (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
  let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
    ∃ b₁ b₂ : R_E,
      b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
      (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
  let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
    ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
  let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
  let B_cop : Subgroup Eˣ :=
    Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
  let S_pnorm := { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
        Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} }
  let S_norm := { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
        Ideal.span {a₂} * Ideal.relNorm R_F B₂ }
  have h_le_Hunr : (Units.map (Algebra.intNorm R_F R_E)).range ≤ H_unr := by
    rintro u ⟨v, rfl⟩
    apply Subgroup.subset_closure
    refine ⟨1, (v : R_E), one_ne_zero, Units.ne_zero v, ?_, ?_, ?_⟩
    · rw [map_one, Ideal.span_singleton_one]
      exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
    · have h_unit : IsUnit (Algebra.intNorm R_F R_E (v : R_E)) :=
        ((Units.map (Algebra.intNorm R_F R_E)) v).isUnit
      rw [Ideal.span_singleton_eq_top.mpr h_unit]
      exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
    · rw [map_one, mul_one]
      rfl
  have h_unit_idx :
      Nat.card (H_unr ⧸ (Units.map (Algebra.intNorm R_F R_E)).range.subgroupOf H_unr) *
        Nat.card (R_Fˣ ⧸ H_unr) =
      Nat.card (R_Fˣ ⧸ (Units.map (Algebra.intNorm R_F R_E)).range) := by
    have h1 := Subgroup.relIndex_mul_index h_le_Hunr
    simpa only [Subgroup.relIndex, Subgroup.index_eq_card] using h1
  let h_F := Nat.card (ClassGroup R_F)
  let N_prin := Nat.card { j : Fin N_ray // (J_all j).IsPrincipal }
  let Q_mod := Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod)
  let M_pnorm := Nat.card S_pnorm
  let M_norm := Nat.card S_norm
  let K_quot := Nat.card (K_cop ⧸ B_cop.subgroupOf K_cop)
  let U_sub := Nat.card (H_unr ⧸ (Units.map (Algebra.intNorm R_F R_E)).range.subgroupOf H_unr)
  let U_coker := Nat.card (R_Fˣ ⧸ H_unr)
  let Q_coker := Nat.card (R_Fˣ ⧸ (Units.map (Algebra.intNorm R_F R_E)).range)
  let Q_ker := Nat.card ((Units.map (Algebra.intNorm R_F R_E)).ker ⧸
    ((MonoidHom.id R_Eˣ /
      Units.map (galRestrict R_F F E R_E σ).toMonoidHom).range.subgroupOf
      (Units.map (Algebra.intNorm R_F R_E)).ker))
  let Pow_inf := 2 ^ (Nat.card { w : NumberField.InfinitePlace F //
    w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal })
  change N_ray = h_F * N_prin at h_s1
  change Pow_inf * Q_mod * M_pnorm ≤ N_prin * U_coker at h_s2
  change Q_ker * M_norm ≤ h_F * K_quot * U_sub * M_pnorm at h_s3
  change K_quot ≤ Q_mod at h_s4
  change U_sub * U_coker = Q_coker at h_unit_idx
  change 0 < Q_mod at hQmod_pos
  change 0 < M_pnorm at hMpnorm_pos
  change (Q_ker * Pow_inf) * M_norm ≤ N_ray * Q_coker
  have h_pos : 0 < Q_mod * M_pnorm := Nat.mul_pos hQmod_pos hMpnorm_pos
  have h_mul_ineq :
      ((Q_ker * Pow_inf) * M_norm) * (Q_mod * M_pnorm) ≤
        (N_ray * Q_coker) * (Q_mod * M_pnorm) := by
    calc
      ((Q_ker * Pow_inf) * M_norm) * (Q_mod * M_pnorm)
          = (Q_ker * M_norm) * (Pow_inf * Q_mod * M_pnorm) := by ring
      _ ≤ (h_F * K_quot * U_sub * M_pnorm) * (N_prin * U_coker) :=
          Nat.mul_le_mul h_s3 h_s2
      _ ≤ (h_F * Q_mod * U_sub * M_pnorm) * (N_prin * U_coker) := by
          gcongr
      _ = ((h_F * N_prin) * (U_sub * U_coker)) * (Q_mod * M_pnorm) := by ring
      _ = (N_ray * Q_coker) * (Q_mod * M_pnorm) := by
          rw [← h_s1, h_unit_idx]
  exact Nat.le_of_mul_le_mul_right h_mul_ineq h_pos

theorem exists_ramified_modulus_narrow_ray_relNorm_index_ge_card {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ) :
    ∃ (c₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
      (m₀ : Ideal (NumberField.RingOfIntegers F)),
      m₀ ≠ ⊥ ∧
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q) ∧
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        ¬ IsUnramifiedAtPrime F E q → 1 ≤ c₀ q) ∧
      (∀ a : NumberField.RingOfIntegers F,
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ¬ IsUnramifiedAtPrime F E q → a - 1 ∈ q.asIdeal ^ (c₀ q)) →
        a - 1 ∈ m₀) ∧
      (∀ (k : ℕ) (K : Fin k → Ideal (NumberField.RingOfIntegers F)),
        (∀ i : Fin k,
          K i ≠ ⊥ ∧
          ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            q.asIdeal ∣ K i → IsUnramifiedAtPrime F E q) →
        (∀ I : Ideal (NumberField.RingOfIntegers F),
          I ≠ ⊥ →
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) →
          ∃ i : Fin k,
            ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
              (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
              a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
              a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
              (∀ w : NumberField.InfinitePlace F,
                w.IsReal →
                0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
              I * K i * Ideal.span {a₁} *
                  Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
                Ideal.span {a₂} *
                  Ideal.relNorm (NumberField.RingOfIntegers F) B₂) →
        Nat.card (E ≃ₐ[F] E) ≤ k) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  obtain ⟨c₀, hc₀_pos, hc₀_bound⟩ :=
    exists_ramified_exponents_norm_ray_cells_card_bound σ hCyclic
  let S_unr : Set ι := { q | IsUnramifiedAtPrime F E q }
  have hS : S_unrᶜ.Finite := by
    let D : Ideal R_E := differentIdeal R_F R_E
    have hD : D ≠ ⊥ := differentIdeal_ne_bot
    let T_D : Set (IsDedekindDomain.HeightOneSpectrum R_E) := { v | v.asIdeal ∣ D }
    have hT_D : T_D.Finite := Ideal.finite_factors hD
    have h_ex : ∀ q : ↑S_unrᶜ, ∃ v : ↑T_D,
        Ideal.under R_F v.1.asIdeal = q.1.asIdeal := by
      intro ⟨q, hq⟩
      change ¬ IsUnramifiedAtPrime F E q at hq
      rw [IsUnramifiedAtPrime] at hq
      push_neg at hq
      rcases hq with ⟨P, hP_prime, h_under, h_ram⟩
      haveI : P.IsPrime := hP_prime
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      have h_map : Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ P :=
        Ideal.map_le_iff_le_comap.mpr h_under.symm.le
      have h_le2 : Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ P ^ 2 :=
        (Ideal.ramificationIdx_ne_one_iff h_map).mp h_ram
      have h_dvd2 : P ^ 2 ∣ Ideal.map (algebraMap R_F R_E) q.asIdeal :=
        Ideal.dvd_iff_le.mpr h_le2
      have h_dvdD : P ∣ D := by
        simpa using pow_sub_one_dvd_differentIdeal R_F P 2 q.ne_bot h_dvd2
      have hP_ne_bot : P ≠ ⊥ := by
        intro h_bot
        rw [h_bot, ← Submodule.zero_eq_bot, zero_dvd_iff, Submodule.zero_eq_bot] at h_dvdD
        exact hD h_dvdD
      exact ⟨⟨⟨P, hP_prime, hP_ne_bot⟩, h_dvdD⟩, h_under⟩
    choose φ hφ using h_ex
    have hφ_inj : Function.Injective φ := by
      intro q₁ q₂ hq
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      rw [← hφ q₁, hq, hφ q₂]
    haveI : Finite ↑T_D := hT_D.to_subtype
    haveI : Finite ↑S_unrᶜ := Finite.of_injective φ hφ_inj
    exact Set.finite_coe_iff.mp inferInstance
  let m₀ : Ideal R_F := ∏ q ∈ hS.toFinset, q.asIdeal ^ (c₀ q)
  have hm₀_ne : m₀ ≠ ⊥ := by
    change (∏ q ∈ hS.toFinset, q.asIdeal ^ (c₀ q)) ≠ ⊥
    rw [← Submodule.zero_eq_bot]
    apply Finset.prod_ne_zero_iff.mpr
    intro q _
    apply pow_ne_zero
    rw [Submodule.zero_eq_bot]
    exact q.ne_bot
  have hm₀_dvd : ∀ q : ι, q.asIdeal ∣ m₀ ↔ ¬ IsUnramifiedAtPrime F E q := by
    intro q
    change q.asIdeal ∣ (∏ q' ∈ hS.toFinset, q'.asIdeal ^ (c₀ q')) ↔ ¬ IsUnramifiedAtPrime F E q
    rw [Prime.dvd_finset_prod_iff q.prime]
    constructor
    · rintro ⟨q', hq'_mem, hdvd_pow⟩
      have hdvd_q' : q.asIdeal ∣ q'.asIdeal := q.prime.dvd_of_dvd_pow hdvd_pow
      have hle : q'.asIdeal ≤ q.asIdeal := Ideal.dvd_iff_le.mp hdvd_q'
      have heq_ideal : q'.asIdeal = q.asIdeal :=
        q'.isMaximal.eq_of_le q.isMaximal.ne_top hle
      have heq : q' = q := IsDedekindDomain.HeightOneSpectrum.ext heq_ideal
      subst heq
      exact (Set.Finite.mem_toFinset hS).mp hq'_mem
    · intro hq_ram
      have hq_mem : q ∈ hS.toFinset := (Set.Finite.mem_toFinset hS).mpr hq_ram
      have hc_ne : c₀ q ≠ 0 := Nat.one_le_iff_ne_zero.mp (hc₀_pos q hq_ram)
      exact ⟨q, hq_mem, dvd_pow_self q.asIdeal hc_ne⟩
  have h_prod_mem : ∀ (s : Finset ι) (x : R_F),
      (∀ q ∈ s, x ∈ q.asIdeal ^ (c₀ q)) →
      x ∈ ∏ q ∈ s, q.asIdeal ^ (c₀ q) := by
    intro s
    refine Finset.induction_on s ?_ ?_
    · intro x _
      rw [Finset.prod_empty, Ideal.one_eq_top]
      exact Submodule.mem_top
    · intro q₀ s hq₀_not_in ih x hx
      rw [Finset.prod_insert hq₀_not_in]
      have hx_q₀ : x ∈ q₀.asIdeal ^ (c₀ q₀) := hx q₀ (Finset.mem_insert_self q₀ s)
      have hx_s : x ∈ ∏ q ∈ s, q.asIdeal ^ (c₀ q) :=
        ih x (fun q hq => hx q (Finset.mem_insert_of_mem hq))
      have h_cop : IsCoprime (q₀.asIdeal ^ (c₀ q₀)) (∏ q ∈ s, q.asIdeal ^ (c₀ q)) := by
        refine IsCoprime.prod_right fun q hq => ?_
        have h_ne : q₀ ≠ q := fun h_eq => hq₀_not_in (h_eq ▸ hq)
        have h_ne_ideal : q₀.asIdeal ≠ q.asIdeal :=
          fun h_eq => h_ne (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
        have h_cop_base : IsCoprime q₀.asIdeal q.asIdeal :=
          Ideal.isCoprime_iff_sup_eq.mpr
            (Ideal.IsMaximal.coprime_of_ne q₀.isMaximal q.isMaximal h_ne_ideal)
        exact h_cop_base.pow
      rw [← Ideal.inf_eq_mul_of_isCoprime h_cop]
      exact ⟨hx_q₀, hx_s⟩
  have hm₀_mem_iff : ∀ a : R_F,
      (∀ q : ι, ¬ IsUnramifiedAtPrime F E q → a - 1 ∈ q.asIdeal ^ (c₀ q)) ↔ a - 1 ∈ m₀ := by
    intro a
    constructor
    · intro ha
      exact h_prod_mem hS.toFinset (a - 1)
        (fun q hq => ha q ((Set.Finite.mem_toFinset hS).mp hq))
    · intro ha_m₀ q hq_ram
      have hq_mem : q ∈ hS.toFinset := (Set.Finite.mem_toFinset hS).mpr hq_ram
      have hdvd : q.asIdeal ^ (c₀ q) ∣ m₀ :=
        Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ (c₀ q')) hq_mem
      exact (Ideal.dvd_iff_le.mp hdvd) ha_m₀
  have hm₀_unram : ∀ I : Ideal R_F, I ≠ ⊥ →
      ((∀ q : ι, q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) ↔ IsCoprime I m₀) := by
    intro I _
    constructor
    · intro h_unr
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      obtain ⟨M, hM_max, h_le_M⟩ := Ideal.exists_le_maximal (I ⊔ m₀) h_ne_top
      have hI_le_M : I ≤ M := le_sup_left.trans h_le_M
      have hm_le_M : m₀ ≤ M := le_sup_right.trans h_le_M
      have hM_ne_bot : M ≠ ⊥ := by
        intro hM_bot
        apply hm₀_ne
        exact le_bot_iff.mp (hM_bot ▸ hm_le_M)
      let q_M : ι := ⟨M, hM_max.isPrime, hM_ne_bot⟩
      have hqM_dvd_I : q_M.asIdeal ∣ I := Ideal.dvd_iff_le.mpr hI_le_M
      have hqM_dvd_m : q_M.asIdeal ∣ m₀ := Ideal.dvd_iff_le.mpr hm_le_M
      exact (hm₀_dvd q_M).mp hqM_dvd_m (h_unr q_M hqM_dvd_I)
    · intro h_cop q hq_I
      by_contra hq_ram
      have hq_m : q.asIdeal ∣ m₀ := (hm₀_dvd q).mpr hq_ram
      have hI_le : I ≤ q.asIdeal := Ideal.dvd_iff_le.mp hq_I
      have hm_le : m₀ ≤ q.asIdeal := Ideal.dvd_iff_le.mp hq_m
      have h_top_le : ⊤ ≤ q.asIdeal := by
        rw [← Ideal.isCoprime_iff_sup_eq.mp h_cop]
        exact sup_le hI_le hm_le
      exact q.isMaximal.ne_top (top_le_iff.mp h_top_le)
  refine ⟨c₀, m₀, hm₀_ne, fun q h => (hm₀_dvd q).mp h, hc₀_pos,
    fun a h => (hm₀_mem_iff a).mp h, fun k K hK_unr h_cov => ?_⟩
  obtain ⟨N_ray, J_all, hJ_prop, hJ_cov, hJ_inj⟩ :=
    exists_finite_narrow_ray_class_partition m₀ hm₀_ne
  have hK_cop : ∀ i : Fin k, K i ≠ ⊥ ∧ IsCoprime (K i) m₀ :=
    fun i => ⟨(hK_unr i).1, (hm₀_unram (K i) (hK_unr i).1).mp (hK_unr i).2⟩
  have h_cov_cop : ∀ I : Ideal R_F, I ≠ ⊥ → IsCoprime I m₀ →
      ∃ i : Fin k,
        ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
          a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
          a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
          I * K i * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
            Ideal.span {a₂} * Ideal.relNorm R_F B₂ :=
    fun I hI_ne hI_cop => h_cov I hI_ne ((hm₀_unram I hI_ne).mpr hI_cop)
  obtain ⟨hN_pos, h_cover_le⟩ :=
    narrow_ray_partition_card_le_mul_of_relNorm_coset_cover
      m₀ hm₀_ne N_ray J_all hJ_prop hJ_cov hJ_inj k K hK_cop h_cov_cop
  obtain ⟨hQcoker_pos, h_herbrand⟩ :=
    unit_herbrand_quotient_of_cyclic_numberField σ hCyclic
  have h_cell_bound :=
    hc₀_bound m₀ hm₀_ne hm₀_dvd hm₀_mem_iff N_ray J_all hJ_prop hJ_cov hJ_inj
  rw [← h_herbrand] at h_cell_bound
  let M_norm : ℕ := Nat.card { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
        Ideal.span {a₂} * Ideal.relNorm R_F B₂ }
  let Q_coker : ℕ := Nat.card ((R_F)ˣ ⧸ (Units.map (Algebra.intNorm R_F R_E)).range)
  change (Nat.card (E ≃ₐ[F] E) * Q_coker) * M_norm ≤ N_ray * Q_coker at h_cell_bound
  change N_ray ≤ k * M_norm at h_cover_le
  change 0 < Q_coker at hQcoker_pos
  have hM_ne : M_norm ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at h_cover_le
    omega
  have hM_pos : 0 < M_norm := Nat.pos_of_ne_zero hM_ne
  have h_mul_pos : 0 < M_norm * Q_coker := Nat.mul_pos hM_pos hQcoker_pos
  have h_ineq : Nat.card (E ≃ₐ[F] E) * (M_norm * Q_coker) ≤ k * (M_norm * Q_coker) := by
    calc
      Nat.card (E ≃ₐ[F] E) * (M_norm * Q_coker)
          = (Nat.card (E ≃ₐ[F] E) * Q_coker) * M_norm := by ring
      _ ≤ N_ray * Q_coker := h_cell_bound
      _ ≤ (k * M_norm) * Q_coker := Nat.mul_le_mul_right Q_coker h_cover_le
      _ = k * (M_norm * Q_coker) := by ring
  exact Nat.le_of_mul_le_mul_right h_ineq h_mul_pos

theorem exists_prime_gt_and_orderOf_zmod_eq_prime_pow (a v r₀ B : ℕ)
    (ha : 2 ≤ a)
    (hv : v.Prime) :
    ∃ (r ℓ : ℕ),
      r₀ ≤ r ∧
      ℓ.Prime ∧
      B < ℓ ∧
      Nat.Coprime a ℓ ∧
      orderOf (a : ZMod ℓ) = v ^ r :=
by
  have h_geom : ∀ z : ℕ, 1 ≤ z →
      (∑ j ∈ Finset.range v, z ^ j) * (z - 1) = z ^ v - 1 ∧
      (∃ K : ℕ, (∑ j ∈ Finset.range v, z ^ j) = (z - 1) * K + v) ∧
      (2 ≤ z → v < ∑ j ∈ Finset.range v, z ^ j) := by
    intro z hz
    have hz_add : z - 1 + 1 = z := Nat.sub_add_cancel hz
    have h1 : (∑ j ∈ Finset.range v, z ^ j) * (z - 1) = z ^ v - 1 := by
      have hg := geom_sum_mul_add (z - 1) v
      rw [hz_add] at hg
      omega
    have h_sum_split : (∑ j ∈ Finset.range v, z ^ j) =
        (∑ j ∈ Finset.range v, (z ^ j - 1)) + v := by
      have h_congr : (∑ j ∈ Finset.range v, z ^ j) =
          ∑ j ∈ Finset.range v, ((z ^ j - 1) + 1) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        exact (Nat.sub_add_cancel (Nat.one_le_pow j z hz)).symm
      rw [h_congr, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul, mul_one]
    have h_dvd : z - 1 ∣ ∑ j ∈ Finset.range v, (z ^ j - 1) := by
      refine Finset.dvd_sum fun j _ => ?_
      simpa using Nat.sub_dvd_pow_sub_pow z 1 j
    refine ⟨h1, ?_, ?_⟩
    · rcases h_dvd with ⟨K, hK⟩
      exact ⟨K, by rw [h_sum_split, hK]⟩
    · intro hz2
      have h1_mem : 1 ∈ Finset.range v := Finset.mem_range.mpr hv.two_le
      have h_le : z ^ 1 - 1 ≤ ∑ j ∈ Finset.range v, (z ^ j - 1) :=
        Finset.single_le_sum (fun j _ => Nat.zero_le (z ^ j - 1)) h1_mem
      rw [pow_one] at h_le
      omega
  let r : ℕ := max r₀ (B + 2)
  have hr₀ : r₀ ≤ r := le_max_left r₀ (B + 2)
  have hr2 : 2 ≤ r := by omega
  have hr1 : 1 ≤ r := by omega
  have hBr : B < r := by omega
  let y : ℕ := a ^ (v ^ (r - 2))
  have hy2 : 2 ≤ y := by
    have h_ne : v ^ (r - 2) ≠ 0 := pow_ne_zero (r - 2) hv.ne_zero
    exact le_trans ha (Nat.le_self_pow h_ne a)
  have hy1 : 1 ≤ y := by omega
  let x : ℕ := y ^ v
  have hx2 : 2 ≤ x := le_trans hy2 (Nat.le_self_pow hv.ne_zero y)
  have hx1 : 1 ≤ x := by omega
  have hx_eq : x = a ^ (v ^ (r - 1)) := by
    dsimp [x, y]
    rw [← pow_mul, ← pow_succ]
    congr 2
    omega
  have hxv_eq : x ^ v = a ^ (v ^ r) := by
    rw [hx_eq, ← pow_mul, ← pow_succ]
    congr 2
    omega
  let S_y : ℕ := ∑ j ∈ Finset.range v, y ^ j
  let Q : ℕ := ∑ j ∈ Finset.range v, x ^ j
  obtain ⟨hSy_mul, ⟨Ky, hSy_mod⟩, _⟩ := h_geom y hy1
  obtain ⟨hQ_mul, ⟨Kx, hQ_mod⟩, hQ_gt⟩ := h_geom x hx1
  have hv_lt_Q : v < Q := hQ_gt hx2
  have h_not_v2_dvd_Q : ¬ (v * v ∣ Q) := by
    intro hv2Q
    have hvQ : v ∣ Q := dvd_trans (dvd_mul_right v v) hv2Q
    have hv_xv : v ∣ x ^ v - 1 := by
      rw [← hQ_mul]
      exact dvd_mul_of_dvd_left hvQ (x - 1)
    haveI : Fact v.Prime := ⟨hv⟩
    have h_xv_one : 1 ≤ x ^ v := Nat.one_le_pow v x hx1
    have h_xv_zmod : ((x ^ v - 1 : ℕ) : ZMod v) = 0 :=
      (ZMod.natCast_eq_zero_iff (x ^ v - 1) v).mpr hv_xv
    rw [Nat.cast_sub h_xv_one, Nat.cast_pow, Nat.cast_one, sub_eq_zero] at h_xv_zmod
    have hx_zmod : (x : ZMod v) = 1 := by
      have h_flt : (x : ZMod v) ^ v = (x : ZMod v) := ZMod.pow_card (x : ZMod v)
      rw [← h_flt]
      exact h_xv_zmod
    have hy_zmod : (y : ZMod v) = 1 := by
      have h_flt : (y : ZMod v) ^ v = (y : ZMod v) := ZMod.pow_card (y : ZMod v)
      have hy_pow : (y : ZMod v) ^ v = (x : ZMod v) := (Nat.cast_pow y v).symm
      rw [← h_flt, hy_pow, hx_zmod]
    have hvy : v ∣ y - 1 := by
      apply (ZMod.natCast_eq_zero_iff (y - 1) v).mp
      rw [Nat.cast_sub hy1, hy_zmod, Nat.cast_one, sub_self]
    have hvSy : v ∣ S_y := by
      change v ∣ ∑ j ∈ Finset.range v, y ^ j
      rw [hSy_mod]
      exact dvd_add (dvd_mul_of_dvd_left hvy Ky) dvd_rfl
    have hv2_x : v * v ∣ x - 1 := by
      change v * v ∣ y ^ v - 1
      rw [← hSy_mul]
      exact mul_dvd_mul hvSy hvy
    have hv2_Kx : v * v ∣ (x - 1) * Kx := dvd_mul_of_dvd_left hv2_x Kx
    have hv2_Q_sum : v * v ∣ (x - 1) * Kx + v := by
      rw [← hQ_mod]
      exact hv2Q
    have hv2_v : v * v ∣ v := (Nat.dvd_add_right hv2_Kx).mp hv2_Q_sum
    have hv2_le : v * v ≤ v := Nat.le_of_dvd hv.pos hv2_v
    have hv_two : 2 ≤ v := hv.two_le
    nlinarith
  have h_ex_ℓ : ∃ ℓ : ℕ, ℓ.Prime ∧ ℓ ≠ v ∧ ℓ ∣ Q := by
    by_cases hvQ : v ∣ Q
    · rcases hvQ with ⟨m, hm⟩
      have hm_gt : 1 < m := by
        have hv_pos : 0 < v := hv.pos
        nlinarith [hv_lt_Q, hm]
      have hm_ne : m ≠ 1 := by omega
      refine ⟨m.minFac, Nat.minFac_prime hm_ne, ?_, ?_⟩
      · intro h_eq
        apply h_not_v2_dvd_Q
        rw [hm]
        apply mul_dvd_mul_left v
        rw [← h_eq]
        exact Nat.minFac_dvd m
      · rw [hm]
        exact dvd_mul_of_dvd_right (Nat.minFac_dvd m) v
    · have hQ_ne : Q ≠ 1 := by
        have hv_two : 2 ≤ v := hv.two_le
        omega
      refine ⟨Q.minFac, Nat.minFac_prime hQ_ne, ?_, Nat.minFac_dvd Q⟩
      intro h_eq
      apply hvQ
      rw [← h_eq]
      exact Nat.minFac_dvd Q
  rcases h_ex_ℓ with ⟨ℓ, hℓ, hℓ_ne_v, hℓ_dvd_Q⟩
  have hℓ_dvd_xv : ℓ ∣ a ^ (v ^ r) - 1 := by
    rw [← hxv_eq, ← hQ_mul]
    exact dvd_mul_of_dvd_left hℓ_dvd_Q (x - 1)
  have hℓ_not_dvd_x : ¬ (ℓ ∣ a ^ (v ^ (r - 1)) - 1) := by
    rw [← hx_eq]
    intro hℓ_x
    have hℓ_Kx : ℓ ∣ (x - 1) * Kx := dvd_mul_of_dvd_left hℓ_x Kx
    have hℓ_sum : ℓ ∣ (x - 1) * Kx + v := by
      rw [← hQ_mod]
      exact hℓ_dvd_Q
    have hℓ_v : ℓ ∣ v := (Nat.dvd_add_right hℓ_Kx).mp hℓ_sum
    have h_eq : v = ℓ := (hv.dvd_iff_eq hℓ.ne_one).mp hℓ_v
    exact hℓ_ne_v h_eq.symm
  have ha1 : 1 ≤ a := by omega
  have h_pow_one : (a : ZMod ℓ) ^ (v ^ r) = 1 := by
    have h_le : 1 ≤ a ^ (v ^ r) := Nat.one_le_pow (v ^ r) a ha1
    have h_zmod : ((a ^ (v ^ r) - 1 : ℕ) : ZMod ℓ) = 0 :=
      (ZMod.natCast_eq_zero_iff (a ^ (v ^ r) - 1) ℓ).mpr hℓ_dvd_xv
    rwa [Nat.cast_sub h_le, Nat.cast_pow, Nat.cast_one, sub_eq_zero] at h_zmod
  have h_pow_ne_one : (a : ZMod ℓ) ^ (v ^ (r - 1)) ≠ 1 := by
    intro h_eq
    apply hℓ_not_dvd_x
    apply (ZMod.natCast_eq_zero_iff (a ^ (v ^ (r - 1)) - 1) ℓ).mp
    have h_le : 1 ≤ a ^ (v ^ (r - 1)) := Nat.one_le_pow (v ^ (r - 1)) a ha1
    rw [Nat.cast_sub h_le, Nat.cast_pow, Nat.cast_one, h_eq, sub_self]
  have h_ord_dvd : orderOf (a : ZMod ℓ) ∣ v ^ r :=
    orderOf_dvd_iff_pow_eq_one.mpr h_pow_one
  rcases (Nat.dvd_prime_pow hv).mp h_ord_dvd with ⟨k, hk_le, hk_eq⟩
  have hk_eq_r : k = r := by
    by_contra hk_ne
    have hk_le' : k ≤ r - 1 := by omega
    have h_dvd_r1 : orderOf (a : ZMod ℓ) ∣ v ^ (r - 1) := by
      rw [hk_eq]
      exact pow_dvd_pow v hk_le'
    exact h_pow_ne_one (orderOf_dvd_iff_pow_eq_one.mp h_dvd_r1)
  have h_ord : orderOf (a : ZMod ℓ) = v ^ r := by
    rwa [hk_eq_r] at hk_eq
  have h_cop : Nat.Coprime a ℓ := by
    have h_unit : IsUnit (a : ZMod ℓ) :=
      IsUnit.of_pow_eq_one h_pow_one (pow_ne_zero r hv.ne_zero)
    exact (ZMod.isUnit_iff_coprime a ℓ).mp h_unit
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have h_vr_le_ℓ : v ^ r ≤ ℓ := by
    have h_le_card : orderOf (a : ZMod ℓ) ≤ Fintype.card (ZMod ℓ) :=
      orderOf_le_card_univ
    rwa [h_ord, ZMod.card ℓ] at h_le_card
  have h_B_lt_ℓ : B < ℓ := by
    have h_lt_two_pow : r < 2 ^ r := Nat.lt_two_pow_self
    have h_two_pow_le : 2 ^ r ≤ v ^ r := Nat.pow_le_pow_left hv.two_le r
    omega
  exact ⟨r, ℓ, hr₀, hℓ, h_B_lt_ℓ, h_cop, h_ord⟩

theorem exists_zmod_units_subgroups_and_homs_of_artin_prime {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (h_artin_prime : ∀ (a v r₀ B : ℕ),
      2 ≤ a → v.Prime →
      ∃ (r ℓ : ℕ),
        r₀ ≤ r ∧ ℓ.Prime ∧ B < ℓ ∧ Nat.Coprime a ℓ ∧ orderOf (a : ZMod ℓ) = v ^ r)
    (B : ℕ)
    (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)))
    (a e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (ha : ∀ q ∈ S, 2 ≤ a q) :
    ∃ (m : ℕ) (u_S : (ZMod m)ˣ)
      (U : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → Subgroup (ZMod m)ˣ)
      (Ψ : ∀ q, U q →* (E ≃ₐ[F] E)),
      1 ≤ m ∧
      Squarefree m ∧
      (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m → B < ℓ) ∧
      ∀ q ∈ S,
        (∃ u_q : U q, (((u_q : (ZMod m)ˣ) : ZMod m) = (a q : ZMod m)) ∧ Ψ q u_q = σ ^ (e q)) ∧
        (∃ u_gen : U q, (u_gen : (ZMod m)ˣ) = u_S ∧ Ψ q u_gen = σ) :=
by
  classical
  have h_cop_of_gt : ∀ (x m B' : ℕ),
      1 ≤ x → x ≤ B' → (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m → B' < ℓ) → Nat.Coprime x m := by
    intro x m B' hx_one hx_le hm_gt
    by_contra h_not_cop
    have h_gcd_ne : Nat.gcd x m ≠ 1 := h_not_cop
    obtain ⟨ℓ, hℓ_prime, hℓ_dvd⟩ := Nat.exists_prime_and_dvd h_gcd_ne
    have hℓ_x : ℓ ∣ x := dvd_trans hℓ_dvd (Nat.gcd_dvd_left x m)
    have hℓ_m : ℓ ∣ m := dvd_trans hℓ_dvd (Nat.gcd_dvd_right x m)
    have h_gt : B' < ℓ := hm_gt ℓ hℓ_prime hℓ_m
    have h_le : ℓ ≤ x := Nat.le_of_dvd (by omega) hℓ_x
    omega
  have h_single : ∀ (a₀ D B' : ℕ),
      2 ≤ a₀ → 1 ≤ D →
      ∃ m : ℕ,
        1 ≤ m ∧
        Squarefree m ∧
        (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m → B' < ℓ) ∧
        Nat.Coprime a₀ m ∧
        D ∣ orderOf (a₀ : ZMod m) := by
    intro a₀ D B' ha₀ hD
    have h_ind : ∀ (s : Finset ℕ),
        (∀ v ∈ s, v.Prime) →
        ∃ m : ℕ,
          1 ≤ m ∧
          Squarefree m ∧
          (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m → B' < ℓ) ∧
          Nat.Coprime a₀ m ∧
          (∏ v ∈ s, v ^ (D.factorization v)) ∣ orderOf (a₀ : ZMod m) := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · intro _
        refine ⟨1, le_rfl, squarefree_one, ?_, Nat.coprime_one_right a₀, ?_⟩
        · intro ℓ hℓ h_dvd
          exact False.elim (hℓ.not_dvd_one h_dvd)
        · rw [Finset.prod_empty]
          exact one_dvd _
      · intro v s hv_not_mem ih hs
        have hv : v.Prime := hs v (Finset.mem_insert_self v s)
        have hs' : ∀ p ∈ s, p.Prime := fun p hp => hs p (Finset.mem_insert_of_mem hp)
        obtain ⟨m', hm'_one, hm'_sq, hm'_gt, hm'_cop, hm'_dvd⟩ := ih hs'
        obtain ⟨r, ℓ, hr, hℓ_prime, hℓ_gt, hℓ_cop, hℓ_ord⟩ :=
          h_artin_prime a₀ v (D.factorization v) (max B' m') ha₀ hv
        have hm'_lt_ℓ : m' < ℓ := (le_max_right B' m').trans_lt hℓ_gt
        have hB'_lt_ℓ : B' < ℓ := (le_max_left B' m').trans_lt hℓ_gt
        have h_not_dvd : ¬ (ℓ ∣ m') := Nat.not_dvd_of_pos_of_lt (by omega) hm'_lt_ℓ
        have hm'ℓ_cop : Nat.Coprime m' ℓ := (hℓ_prime.coprime_iff_not_dvd.mpr h_not_dvd).symm
        have hℓ_sq : Squarefree ℓ :=
          Irreducible.squarefree ((Nat.irreducible_iff_nat_prime ℓ).mpr hℓ_prime)
        have hm_sq : Squarefree (m' * ℓ) :=
          Nat.squarefree_mul_iff.mpr ⟨hm'ℓ_cop, hm'_sq, hℓ_sq⟩
        have hm_one : 1 ≤ m' * ℓ := Nat.mul_pos (by omega) hℓ_prime.pos
        have hm_gt : ∀ p : ℕ, p.Prime → p ∣ m' * ℓ → B' < p := by
          intro p hp hp_dvd
          rcases hp.dvd_mul.mp hp_dvd with hp_m' | hp_ℓ
          · exact hm'_gt p hp hp_m'
          · rcases (Nat.dvd_prime hℓ_prime).mp hp_ℓ with rfl | rfl
            · exact False.elim (hp.ne_one rfl)
            · exact hB'_lt_ℓ
        have hm_cop : Nat.Coprime a₀ (m' * ℓ) := hm'_cop.mul_right hℓ_cop
        have h_dvd_m' : orderOf (a₀ : ZMod m') ∣ orderOf (a₀ : ZMod (m' * ℓ)) := by
          let π₁ := ZMod.castHom (dvd_mul_right m' ℓ) (ZMod m')
          have h_map : π₁.toMonoidHom (a₀ : ZMod (m' * ℓ)) = (a₀ : ZMod m') := map_natCast π₁ a₀
          rw [← h_map]
          exact orderOf_map_dvd π₁.toMonoidHom (a₀ : ZMod (m' * ℓ))
        have h_dvd_s : (∏ p ∈ s, p ^ (D.factorization p)) ∣ orderOf (a₀ : ZMod (m' * ℓ)) :=
          dvd_trans hm'_dvd h_dvd_m'
        have h_dvd_ℓ : orderOf (a₀ : ZMod ℓ) ∣ orderOf (a₀ : ZMod (m' * ℓ)) := by
          let π₂ := ZMod.castHom (dvd_mul_left ℓ m') (ZMod ℓ)
          have h_map : π₂.toMonoidHom (a₀ : ZMod (m' * ℓ)) = (a₀ : ZMod ℓ) := map_natCast π₂ a₀
          rw [← h_map]
          exact orderOf_map_dvd π₂.toMonoidHom (a₀ : ZMod (m' * ℓ))
        have h_dvd_v : v ^ (D.factorization v) ∣ orderOf (a₀ : ZMod (m' * ℓ)) := by
          have h1 : v ^ (D.factorization v) ∣ v ^ r := Nat.pow_dvd_pow v hr
          rw [← hℓ_ord] at h1
          exact dvd_trans h1 h_dvd_ℓ
        have h_cop_vs : Nat.Coprime (v ^ (D.factorization v)) (∏ p ∈ s, p ^ (D.factorization p)) := by
          refine Nat.Coprime.prod_right fun p hp => ?_
          have hvp : v ≠ p := fun h_eq => hv_not_mem (h_eq ▸ hp)
          exact ((Nat.coprime_primes hv (hs' p hp)).mpr hvp).pow _ _
        refine ⟨m' * ℓ, hm_one, hm_sq, hm_gt, hm_cop, ?_⟩
        rw [Finset.prod_insert hv_not_mem]
        exact h_cop_vs.mul_dvd_of_dvd_of_dvd h_dvd_v h_dvd_s
    have hs_prime : ∀ v ∈ D.factorization.support, v.Prime := by
      intro v hv
      rw [Nat.support_factorization] at hv
      exact Nat.prime_of_mem_primeFactors hv
    obtain ⟨m, hm_one, hm_sq, hm_gt, hm_cop, hm_dvd⟩ := h_ind D.factorization.support hs_prime
    have hD_prod : (∏ v ∈ D.factorization.support, v ^ (D.factorization v)) = D :=
      Nat.factorization_prod_pow_eq_self (by omega)
    rw [hD_prod] at hm_dvd
    exact ⟨m, hm_one, hm_sq, hm_gt, hm_cop, hm_dvd⟩
  have h_finset : ∀ (D B₁ : ℕ)
      (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))),
      1 ≤ D →
      (∀ q ∈ T, q ∈ S) →
      ∃ m₁ : ℕ,
        1 ≤ m₁ ∧
        Squarefree m₁ ∧
        (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m₁ → B₁ < ℓ) ∧
        ∀ q ∈ T, D ∣ orderOf (a q : ZMod m₁) := by
    intro D B₁ T hD
    refine Finset.induction_on T ?_ ?_
    · intro _
      refine ⟨1, le_rfl, squarefree_one, ?_, ?_⟩
      · intro ℓ hℓ h_dvd
        exact False.elim (hℓ.not_dvd_one h_dvd)
      · intro q hq
        simp at hq
    · intro q₀ T hq₀_not_mem ih hT
      have hq₀_S : q₀ ∈ S := hT q₀ (Finset.mem_insert_self q₀ T)
      have hT' : ∀ q ∈ T, q ∈ S := fun q hq => hT q (Finset.mem_insert_of_mem hq)
      obtain ⟨m₁', hm₁'_one, hm₁'_sq, hm₁'_gt, hm₁'_dvd⟩ := ih hT'
      obtain ⟨M, hM_one, hM_sq, hM_gt, _, hM_dvd⟩ :=
        h_single (a q₀) D (max B₁ m₁') (ha q₀ hq₀_S) hD
      have hm₁'M_cop : Nat.Coprime m₁' M :=
        h_cop_of_gt m₁' M (max B₁ m₁') hm₁'_one (le_max_right B₁ m₁') hM_gt
      have hm₁_one : 1 ≤ m₁' * M := Nat.mul_pos hm₁'_one hM_one
      have hm₁_sq : Squarefree (m₁' * M) :=
        Nat.squarefree_mul_iff.mpr ⟨hm₁'M_cop, hm₁'_sq, hM_sq⟩
      have hm₁_gt : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m₁' * M → B₁ < ℓ := by
        intro ℓ hℓ h_dvd
        rcases hℓ.dvd_mul.mp h_dvd with h_m₁' | h_M
        · exact hm₁'_gt ℓ hℓ h_m₁'
        · exact (le_max_left B₁ m₁').trans_lt (hM_gt ℓ hℓ h_M)
      refine ⟨m₁' * M, hm₁_one, hm₁_sq, hm₁_gt, ?_⟩
      intro q hq
      rcases Finset.mem_insert.mp hq with rfl | hq_T
      · let π_M := ZMod.castHom (dvd_mul_left M m₁') (ZMod M)
        have h_map : π_M.toMonoidHom (a q : ZMod (m₁' * M)) = (a q : ZMod M) := map_natCast π_M (a q)
        have h_ord_dvd : orderOf (a q : ZMod M) ∣ orderOf (a q : ZMod (m₁' * M)) := by
          rw [← h_map]
          exact orderOf_map_dvd π_M.toMonoidHom (a q : ZMod (m₁' * M))
        exact dvd_trans hM_dvd h_ord_dvd
      · let π_m₁' := ZMod.castHom (dvd_mul_right m₁' M) (ZMod m₁')
        have h_map : π_m₁'.toMonoidHom (a q : ZMod (m₁' * M)) = (a q : ZMod m₁') := map_natCast π_m₁' (a q)
        have h_ord_dvd : orderOf (a q : ZMod m₁') ∣ orderOf (a q : ZMod (m₁' * M)) := by
          rw [← h_map]
          exact orderOf_map_dvd π_m₁'.toMonoidHom (a q : ZMod (m₁' * M))
        exact dvd_trans (hm₁'_dvd q hq_T) h_ord_dvd
  let d : ℕ := orderOf σ
  have hd_pos : 1 ≤ d := orderOf_pos σ
  let B₀ : ℕ := max B (S.sup a)
  obtain ⟨m₀, hm₀_one, hm₀_sq, hm₀_gt, h2_cop, hd_dvd₀⟩ :=
    h_single 2 d B₀ (by omega) hd_pos
  haveI : NeZero m₀ := ⟨by omega⟩
  let D : ℕ := d * Nat.card (ZMod m₀)ˣ
  have hD_pos : 1 ≤ D := Nat.mul_pos hd_pos Nat.card_pos
  obtain ⟨m₁, hm₁_one, hm₁_sq, hm₁_gt, hm₁_dvd⟩ :=
    h_finset D (max B₀ m₀) S hD_pos (fun q hq => hq)
  haveI : NeZero m₁ := ⟨by omega⟩
  have hm₀₁ : Nat.Coprime m₀ m₁ :=
    h_cop_of_gt m₀ m₁ (max B₀ m₀) hm₀_one (le_max_right B₀ m₀) hm₁_gt
  let m : ℕ := m₀ * m₁
  have hm_one : 1 ≤ m := Nat.mul_pos hm₀_one hm₁_one
  have hm_sq : Squarefree m := Nat.squarefree_mul_iff.mpr ⟨hm₀₁, hm₀_sq, hm₁_sq⟩
  have hm_gt₀ : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m → B₀ < ℓ := by
    intro ℓ hℓ h_dvd
    rcases hℓ.dvd_mul.mp h_dvd with h₀ | h₁
    · exact hm₀_gt ℓ hℓ h₀
    · exact (le_max_left B₀ m₀).trans_lt (hm₁_gt ℓ hℓ h₁)
  have hm_gt : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m → B < ℓ :=
    fun ℓ hℓ h_dvd => (le_max_left B (S.sup a)).trans_lt (hm_gt₀ ℓ hℓ h_dvd)
  let k_crt := Nat.chineseRemainder hm₀₁ 2 1
  let k : ℕ := k_crt.1
  have hk_m₀ : (k : ZMod m₀) = ((2 : ℕ) : ZMod m₀) :=
    (ZMod.natCast_eq_natCast_iff k 2 m₀).mpr k_crt.2.1
  have hk_m₁ : (k : ZMod m₁) = ((1 : ℕ) : ZMod m₁) :=
    (ZMod.natCast_eq_natCast_iff k 1 m₁).mpr k_crt.2.2
  have hk_cop₀ : Nat.Coprime k m₀ := by
    rw [← ZMod.isUnit_iff_coprime, hk_m₀, ZMod.isUnit_iff_coprime]
    exact h2_cop
  have hk_cop₁ : Nat.Coprime k m₁ := by
    rw [← ZMod.isUnit_iff_coprime, hk_m₁, ZMod.isUnit_iff_coprime]
    exact Nat.coprime_one_left m₁
  have hk_cop : Nat.Coprime k m := hk_cop₀.mul_right hk_cop₁
  let u_S : (ZMod m)ˣ := ZMod.unitOfCoprime k hk_cop
  let π₀ : (ZMod m)ˣ →* (ZMod m₀)ˣ :=
    Units.map (ZMod.castHom (dvd_mul_right m₀ m₁) (ZMod m₀)).toMonoidHom
  let π₁ : (ZMod m)ˣ →* (ZMod m₁)ˣ :=
    Units.map (ZMod.castHom (dvd_mul_left m₁ m₀) (ZMod m₁)).toMonoidHom
  have hπ₀_uS : π₀ u_S = ZMod.unitOfCoprime 2 h2_cop := by
    ext
    simp [π₀, u_S, hk_m₀]
  have hπ₁_uS : π₁ u_S = 1 := by
    ext
    simp [π₁, u_S, hk_m₁]
  have h_hom_gen : ∀ (u₁ u₂ : (ZMod m)ˣ) (e₀ : ℕ),
      (∀ k₁ k₂ : ℤ, u₁ ^ k₁ * u₂ ^ k₂ = 1 → (d : ℤ) ∣ k₁ ∧ (d : ℤ) ∣ k₂) →
      ∃ (U₀ : Subgroup (ZMod m)ˣ) (Ψ₀ : U₀ →* (E ≃ₐ[F] E)),
        (∃ v₂ : U₀, (v₂ : (ZMod m)ˣ) = u₂ ∧ Ψ₀ v₂ = σ ^ e₀) ∧
        (∃ v₁ : U₀, (v₁ : (ZMod m)ˣ) = u₁ ∧ Ψ₀ v₁ = σ) := by
    intro u₁ u₂ e₀ h_dvd
    let U₀ : Subgroup (ZMod m)ˣ :=
      { carrier := { u : (ZMod m)ˣ | ∃ k₁ k₂ : ℤ, u₁ ^ k₁ * u₂ ^ k₂ = u }
        one_mem' := ⟨0, 0, by simp⟩
        mul_mem' := by
          rintro x y ⟨k₁, k₂, rfl⟩ ⟨l₁, l₂, rfl⟩
          refine ⟨k₁ + l₁, k₂ + l₂, ?_⟩
          rw [zpow_add, zpow_add, mul_mul_mul_comm]
        inv_mem' := by
          rintro x ⟨k₁, k₂, rfl⟩
          refine ⟨-k₁, -k₂, ?_⟩
          rw [zpow_neg, zpow_neg, mul_inv] }
    have h_wd : ∀ (k₁ k₂ l₁ l₂ : ℤ),
        u₁ ^ k₁ * u₂ ^ k₂ = u₁ ^ l₁ * u₂ ^ l₂ →
        σ ^ (k₁ + (e₀ : ℤ) * k₂) = σ ^ (l₁ + (e₀ : ℤ) * l₂) := by
      intro k₁ k₂ l₁ l₂ h_eq
      have h_sub_eq : u₁ ^ (k₁ - l₁) * u₂ ^ (k₂ - l₂) = 1 := by
        rw [zpow_sub, zpow_sub, mul_mul_mul_comm, ← mul_inv, h_eq, mul_inv_cancel]
      obtain ⟨hd₁, hd₂⟩ := h_dvd (k₁ - l₁) (k₂ - l₂) h_sub_eq
      have hd_comb : (orderOf σ : ℤ) ∣ (k₁ + (e₀ : ℤ) * k₂) - (l₁ + (e₀ : ℤ) * l₂) := by
        have h_ring : (k₁ + (e₀ : ℤ) * k₂) - (l₁ + (e₀ : ℤ) * l₂) =
            (k₁ - l₁) + (e₀ : ℤ) * (k₂ - l₂) := by ring
        rw [h_ring]
        exact dvd_add hd₁ (dvd_mul_of_dvd_right hd₂ (e₀ : ℤ))
      have h_zpow_one : σ ^ ((k₁ + (e₀ : ℤ) * k₂) - (l₁ + (e₀ : ℤ) * l₂)) = 1 :=
        orderOf_dvd_iff_zpow_eq_one.mp hd_comb
      rw [zpow_sub, mul_inv_eq_one] at h_zpow_one
      exact h_zpow_one
    let k₁_fn : U₀ → ℤ := fun v => Classical.choose v.2
    let k₂_fn : U₀ → ℤ := fun v => Classical.choose (Classical.choose_spec v.2)
    have hk_spec : ∀ v : U₀, u₁ ^ (k₁_fn v) * u₂ ^ (k₂_fn v) = v.1 :=
      fun v => Classical.choose_spec (Classical.choose_spec v.2)
    let Ψ₀ : U₀ →* (E ≃ₐ[F] E) :=
      { toFun := fun v => σ ^ (k₁_fn v + (e₀ : ℤ) * k₂_fn v)
        map_one' := by
          have h1 : u₁ ^ (k₁_fn 1) * u₂ ^ (k₂_fn 1) = u₁ ^ (0 : ℤ) * u₂ ^ (0 : ℤ) := by
            rw [hk_spec 1]
            simp
          have h2 := h_wd (k₁_fn 1) (k₂_fn 1) 0 0 h1
          simpa using h2
        map_mul' := by
          intro x y
          have h1 : u₁ ^ (k₁_fn (x * y)) * u₂ ^ (k₂_fn (x * y)) =
              u₁ ^ (k₁_fn x + k₁_fn y) * u₂ ^ (k₂_fn x + k₂_fn y) := by
            rw [hk_spec (x * y), Subgroup.coe_mul, ← hk_spec x, ← hk_spec y,
              zpow_add, zpow_add, mul_mul_mul_comm]
          have h2 := h_wd (k₁_fn (x * y)) (k₂_fn (x * y)) (k₁_fn x + k₁_fn y) (k₂_fn x + k₂_fn y) h1
          have h_add : (k₁_fn x + k₁_fn y) + (e₀ : ℤ) * (k₂_fn x + k₂_fn y) =
              (k₁_fn x + (e₀ : ℤ) * k₂_fn x) + (k₁_fn y + (e₀ : ℤ) * k₂_fn y) := by ring
          rw [h2, h_add, zpow_add] }
    let v₂ : U₀ := ⟨u₂, ⟨0, 1, by simp⟩⟩
    let v₁ : U₀ := ⟨u₁, ⟨1, 0, by simp⟩⟩
    refine ⟨U₀, Ψ₀, ⟨v₂, rfl, ?_⟩, ⟨v₁, rfl, ?_⟩⟩
    · have h1 : u₁ ^ (k₁_fn v₂) * u₂ ^ (k₂_fn v₂) = u₁ ^ (0 : ℤ) * u₂ ^ (1 : ℤ) := by
        rw [hk_spec v₂]
        simp [v₂]
      have h2 := h_wd (k₁_fn v₂) (k₂_fn v₂) 0 1 h1
      change σ ^ (k₁_fn v₂ + (e₀ : ℤ) * k₂_fn v₂) = σ ^ e₀
      rw [h2, zero_add, mul_one, zpow_natCast]
    · have h1 : u₁ ^ (k₁_fn v₁) * u₂ ^ (k₂_fn v₁) = u₁ ^ (1 : ℤ) * u₂ ^ (0 : ℤ) := by
        rw [hk_spec v₁]
        simp [v₁]
      have h2 := h_wd (k₁_fn v₁) (k₂_fn v₁) 1 0 h1
      change σ ^ (k₁_fn v₁ + (e₀ : ℤ) * k₂_fn v₁) = σ
      rw [h2, mul_zero, add_zero, zpow_one]
  have h_ex : ∀ q ∈ S,
      ∃ (U_q : Subgroup (ZMod m)ˣ) (Ψ_q : U_q →* (E ≃ₐ[F] E)),
        (∃ u_q : U_q, (((u_q : (ZMod m)ˣ) : ZMod m) = (a q : ZMod m)) ∧ Ψ_q u_q = σ ^ (e q)) ∧
        (∃ u_gen : U_q, (u_gen : (ZMod m)ˣ) = u_S ∧ Ψ_q u_gen = σ) := by
    intro q hq
    have ha_ge : 2 ≤ a q := ha q hq
    have ha_le : a q ≤ B₀ := (Finset.le_sup hq).trans (le_max_right B (S.sup a))
    have ha_cop : Nat.Coprime (a q) m := h_cop_of_gt (a q) m B₀ (by omega) ha_le hm_gt₀
    have ha_cop₁ : Nat.Coprime (a q) m₁ :=
      h_cop_of_gt (a q) m₁ (max B₀ m₀) (by omega) (ha_le.trans (le_max_left B₀ m₀)) hm₁_gt
    let u_a : (ZMod m)ˣ := ZMod.unitOfCoprime (a q) ha_cop
    have hπ₁_ua : π₁ u_a = ZMod.unitOfCoprime (a q) ha_cop₁ := by
      ext
      simp [π₁, u_a]
    have h_dvd_rel : ∀ k₁ k₂ : ℤ,
        u_S ^ k₁ * u_a ^ k₂ = 1 → (d : ℤ) ∣ k₁ ∧ (d : ℤ) ∣ k₂ := by
      intro k₁ k₂ h_rel
      have h_rel₁ : (π₁ u_a) ^ k₂ = 1 := by
        have h1 := congrArg π₁ h_rel
        rw [map_mul, map_zpow, map_zpow, hπ₁_uS, one_zpow, one_mul, map_one] at h1
        exact h1
      have h_ord_ua₁ : orderOf (π₁ u_a) = orderOf (a q : ZMod m₁) := by
        rw [← orderOf_units, hπ₁_ua, ZMod.coe_unitOfCoprime]
      have h_ord_dvd_k₂ : (orderOf (a q : ZMod m₁) : ℤ) ∣ k₂ := by
        rw [← h_ord_ua₁]
        exact orderOf_dvd_iff_zpow_eq_one.mpr h_rel₁
      have hD_dvd_ord : (D : ℤ) ∣ (orderOf (a q : ZMod m₁) : ℤ) :=
        Int.ofNat_dvd.mpr (hm₁_dvd q hq)
      have hD_dvd_k₂ : ((d * Nat.card (ZMod m₀)ˣ : ℕ) : ℤ) ∣ k₂ :=
        dvd_trans hD_dvd_ord h_ord_dvd_k₂
      rw [Nat.cast_mul] at hD_dvd_k₂
      have hd_dvd_k₂ : (d : ℤ) ∣ k₂ := dvd_of_mul_right_dvd hD_dvd_k₂
      have hcard_dvd_k₂ : (Nat.card (ZMod m₀)ˣ : ℤ) ∣ k₂ := dvd_of_mul_left_dvd hD_dvd_k₂
      have h_ord_ua₀_dvd : (orderOf (π₀ u_a) : ℤ) ∣ k₂ :=
        dvd_trans (Int.ofNat_dvd.mpr (orderOf_dvd_natCard (π₀ u_a))) hcard_dvd_k₂
      have h_ua₀_one : (π₀ u_a) ^ k₂ = 1 := orderOf_dvd_iff_zpow_eq_one.mp h_ord_ua₀_dvd
      have h_rel₀ : (π₀ u_S) ^ k₁ = 1 := by
        have h0 := congrArg π₀ h_rel
        rw [map_mul, map_zpow, map_zpow, h_ua₀_one, mul_one, map_one] at h0
        exact h0
      have h_ord_uS₀ : orderOf (π₀ u_S) = orderOf (2 : ZMod m₀) := by
        rw [← orderOf_units, hπ₀_uS, ZMod.coe_unitOfCoprime, Nat.cast_ofNat]
      have h_ord2_dvd_k₁ : (orderOf (2 : ZMod m₀) : ℤ) ∣ k₁ := by
        rw [← h_ord_uS₀]
        exact orderOf_dvd_iff_zpow_eq_one.mpr h_rel₀
      have hd_dvd_k₁ : (d : ℤ) ∣ k₁ :=
        dvd_trans (Int.ofNat_dvd.mpr hd_dvd₀) h_ord2_dvd_k₁
      exact ⟨hd_dvd_k₁, hd_dvd_k₂⟩
    obtain ⟨U_q, Ψ_q, ⟨v₂, hv₂_coe, hv₂_ψ⟩, ⟨v₁, hv₁_coe, hv₁_ψ⟩⟩ :=
      h_hom_gen u_S u_a (e q) h_dvd_rel
    refine ⟨U_q, Ψ_q, ⟨v₂, ?_, hv₂_ψ⟩, ⟨v₁, hv₁_coe, hv₁_ψ⟩⟩
    rw [hv₂_coe, ZMod.coe_unitOfCoprime]
  let UΨ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
      Σ U_q : Subgroup (ZMod m)ˣ, (U_q →* (E ≃ₐ[F] E)) :=
    fun q =>
      if hq : q ∈ S then
        ⟨Classical.choose (h_ex q hq), Classical.choose (Classical.choose_spec (h_ex q hq))⟩
      else
        ⟨⊤, 1⟩
  refine ⟨m, u_S, fun q => (UΨ q).1, fun q => (UΨ q).2, hm_one, hm_sq, hm_gt, ?_⟩
  intro q hq
  dsimp only [UΨ]
  rw [dif_pos hq]
  exact Classical.choose_spec (Classical.choose_spec (h_ex q hq))

theorem exists_twisted_narrow_ray_chars_of_not_relNorm_eq {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (σ : L ≃ₐ[K] L)
    (hCyclic : ∀ ρ : L ≃ₐ[K] L, ρ ∈ Subgroup.zpowers σ)
    (θ : Ideal (NumberField.RingOfIntegers K) → (L ≃ₐ[K] L))
    (hθ_top : θ ⊤ = 1)
    (hθ_mul : ∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
      J₁ ≠ ⊥ → J₂ ≠ ⊥ → θ (J₁ * J₂) = θ J₁ * θ J₂)
    (hθ_relNorm : ∀ B : Ideal (NumberField.RingOfIntegers L),
      B ≠ ⊥ → θ (Ideal.relNorm (NumberField.RingOfIntegers K) B) = 1)
    (𝔪 : Ideal (NumberField.RingOfIntegers K))
    (h𝔪_ne : 𝔪 ≠ ⊥)
    (h𝔪_ker : ∀ α : NumberField.RingOfIntegers K,
      α ≠ 0 →
      α - 1 ∈ 𝔪 →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (α : K)).re) →
      θ (Ideal.span {α}) = 1)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers K))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) 𝔪)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers K),
      I ≠ ⊥ → IsCoprime I 𝔪 →
      ∃ j : Fin N_ray,
        ∃ α : NumberField.RingOfIntegers K,
          α - 1 ∈ 𝔪 ∧
          (∀ w : NumberField.InfinitePlace K,
            w.IsReal → 0 < (w.embedding (α : K)).re) ∧
          I * J_all j = Ideal.span {α})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ α : NumberField.RingOfIntegers K,
        α - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal → 0 < (w.embedding (α : K)).re) ∧
        I * J_all j₁ = Ideal.span {α}) →
      (∃ α : NumberField.RingOfIntegers K,
        α - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal → 0 < (w.embedding (α : K)).re) ∧
        I * J_all j₂ = Ideal.span {α}) →
      j₁ = j₂)
    (h_split : ∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      IsCoprime P.asIdeal 𝔪 →
      θ P.asIdeal = 1 →
      ∃ Q : Ideal (NumberField.RingOfIntegers L),
        Q ≠ ⊥ ∧ Ideal.relNorm (NumberField.RingOfIntegers K) Q = P.asIdeal)
    (I₁ I₂ : Ideal (NumberField.RingOfIntegers K))
    (hI₁_ne : I₁ ≠ ⊥) (hI₂_ne : I₂ ≠ ⊥)
    (hI₁_cop : IsCoprime I₁ 𝔪) (hI₂_cop : IsCoprime I₂ 𝔪)
    (hθ_eq : θ I₁ = θ I₂)
    (h_not_rel : ¬ ∃ (α₁ α₂ : NumberField.RingOfIntegers K)
      (C₁ C₂ : Ideal (NumberField.RingOfIntegers L)),
      α₁ ≠ 0 ∧ α₂ ≠ 0 ∧ C₁ ≠ ⊥ ∧ C₂ ≠ ⊥ ∧
      α₁ - 1 ∈ 𝔪 ∧ α₂ - 1 ∈ 𝔪 ∧
      (∀ w : NumberField.InfinitePlace K,
        w.IsReal →
        0 < (w.embedding (α₁ : K)).re ∧ 0 < (w.embedding (α₂ : K)).re) ∧
      I₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
        I₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂) :
    ∃ ϕ : Fin (Module.finrank K L) → Ideal (NumberField.RingOfIntegers K) → ℂ,
      (∀ i : Fin (Module.finrank K L),
        ϕ i ⊤ = 1 ∧
        (∀ J : Ideal (NumberField.RingOfIntegers K), ‖ϕ i J‖ ≤ 1) ∧
        (∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
          J₁ ≠ ⊥ → J₂ ≠ ⊥ → ϕ i (J₁ * J₂) = ϕ i J₁ * ϕ i J₂) ∧
        (∀ J : Ideal (NumberField.RingOfIntegers K), ¬ IsCoprime J 𝔪 → ϕ i J = 0) ∧
        (∀ (I : Ideal (NumberField.RingOfIntegers K)) (j : Fin N_ray),
          I ≠ ⊥ →
          (∃ α : NumberField.RingOfIntegers K,
            α - 1 ∈ 𝔪 ∧
            (∀ w : NumberField.InfinitePlace K,
              w.IsReal → 0 < (w.embedding (α : K)).re) ∧
            I * J_all j = Ideal.span {α}) →
          ϕ i I = (ϕ i (J_all j))⁻¹) ∧
        (∑ j : Fin N_ray, (ϕ i (J_all j))⁻¹) = 0) ∧
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (IsCoprime P.asIdeal 𝔪 ∧ θ P.asIdeal = 1 →
          (∑ i : Fin (Module.finrank K L), ϕ i P.asIdeal) = (Module.finrank K L : ℂ)) ∧
        (¬ (IsCoprime P.asIdeal 𝔪 ∧ θ P.asIdeal = 1) →
          (∑ i : Fin (Module.finrank K L), ϕ i P.asIdeal) = 0)) :=
by
  classical
  let IsNarrowRay : NumberField.RingOfIntegers K → Prop := fun α =>
    α ≠ 0 ∧ α - 1 ∈ 𝔪 ∧
    ∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (α : K)).re
  have hNR_one : IsNarrowRay 1 := by
    refine ⟨one_ne_zero, by rw [sub_self]; exact 𝔪.zero_mem, fun w _ => ?_⟩
    simp
  have hNR_mul : ∀ {α β : NumberField.RingOfIntegers K},
      IsNarrowRay α → IsNarrowRay β → IsNarrowRay (α * β) := by
    rintro α β ⟨hα_ne, hα_m, hα_pos⟩ ⟨hβ_ne, hβ_m, hβ_pos⟩
    refine ⟨mul_ne_zero hα_ne hβ_ne, ?_, ?_⟩
    · have h_eq : α * β - 1 = (α - 1) * β + (β - 1) := by ring
      rw [h_eq]
      exact 𝔪.add_mem (Ideal.mul_mem_right β 𝔪 hα_m) hβ_m
    · intro w hw
      have hα_re := hα_pos w hw
      have hβ_re := hβ_pos w hw
      rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (α : K),
          Complex.ofReal_re] at hα_re
      rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (β : K),
          Complex.ofReal_re] at hβ_re
      change 0 < (w.embedding (algebraMap (NumberField.RingOfIntegers K) K (α * β))).re
      rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw
            (algebraMap (NumberField.RingOfIntegers K) K (α * β)),
          Complex.ofReal_re, map_mul, map_mul]
      exact mul_pos hα_re hβ_re
  have h_ideal_mul_ne_bot : ∀ {A B : Ideal (NumberField.RingOfIntegers K)},
      A ≠ ⊥ → B ≠ ⊥ → A * B ≠ ⊥ := by
    intro A B hA hB
    rw [← Submodule.zero_eq_bot] at hA hB ⊢
    exact mul_ne_zero hA hB
  have h_idealL_mul_ne_bot : ∀ {C₁ C₂ : Ideal (NumberField.RingOfIntegers L)},
      C₁ ≠ ⊥ → C₂ ≠ ⊥ → C₁ * C₂ ≠ ⊥ := by
    intro C₁ C₂ h₁ h₂
    rw [← Submodule.zero_eq_bot] at h₁ h₂ ⊢
    exact mul_ne_zero h₁ h₂
  let InRayCell : Ideal (NumberField.RingOfIntegers K) → Ideal (NumberField.RingOfIntegers K) → Prop :=
    fun I J =>
      ∃ α : NumberField.RingOfIntegers K,
        α - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (α : K)).re) ∧
        I * J = Ideal.span {α}
  have h_cell_ne_zero : ∀ {I J : Ideal (NumberField.RingOfIntegers K)}
      {α : NumberField.RingOfIntegers K},
      I ≠ ⊥ → J ≠ ⊥ → I * J = Ideal.span {α} → α ≠ 0 := by
    intro I J α hI hJ hIJ hα0
    apply h_ideal_mul_ne_bot hI hJ
    rw [hIJ, hα0, Ideal.span_singleton_eq_bot.mpr rfl]
  let RelNormEq : Ideal (NumberField.RingOfIntegers K) → Ideal (NumberField.RingOfIntegers K) → Prop :=
    fun J₁ J₂ =>
      ∃ (α₁ α₂ : NumberField.RingOfIntegers K) (C₁ C₂ : Ideal (NumberField.RingOfIntegers L)),
        IsNarrowRay α₁ ∧ IsNarrowRay α₂ ∧ C₁ ≠ ⊥ ∧ C₂ ≠ ⊥ ∧
        J₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
          J₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂
  have h_not_rel' : ¬ RelNormEq I₁ I₂ := by
    rintro ⟨α₁, α₂, C₁, C₂, ⟨hα₁_ne, hα₁_m, hα₁_pos⟩, ⟨hα₂_ne, hα₂_m, hα₂_pos⟩, hC₁, hC₂, h_eq⟩
    exact h_not_rel ⟨α₁, α₂, C₁, C₂, hα₁_ne, hα₂_ne, hC₁, hC₂, hα₁_m, hα₂_m,
      fun w hw => ⟨hα₁_pos w hw, hα₂_pos w hw⟩, h_eq⟩
  have h_rel_refl : ∀ J : Ideal (NumberField.RingOfIntegers K), RelNormEq J J :=
    fun J => ⟨1, 1, ⊤, ⊤, hNR_one, hNR_one, top_ne_bot, top_ne_bot, rfl⟩
  have h_rel_symm : ∀ {J₁ J₂ : Ideal (NumberField.RingOfIntegers K)},
      RelNormEq J₁ J₂ → RelNormEq J₂ J₁ := by
    rintro J₁ J₂ ⟨α₁, α₂, C₁, C₂, hα₁, hα₂, hC₁, hC₂, h_eq⟩
    exact ⟨α₂, α₁, C₂, C₁, hα₂, hα₁, hC₂, hC₁, h_eq.symm⟩
  have h_rel_trans : ∀ {J₁ J₂ J₃ : Ideal (NumberField.RingOfIntegers K)},
      RelNormEq J₁ J₂ → RelNormEq J₂ J₃ → RelNormEq J₁ J₃ := by
    rintro J₁ J₂ J₃ ⟨α₁, α₂, C₁, C₂, hα₁, hα₂, hC₁, hC₂, h₁₂⟩
      ⟨β₁, β₂, D₁, D₂, hβ₁, hβ₂, hD₁, hD₂, h₂₃⟩
    refine ⟨α₁ * β₁, α₂ * β₂, C₁ * D₁, C₂ * D₂,
      hNR_mul hα₁ hβ₁, hNR_mul hα₂ hβ₂,
      h_idealL_mul_ne_bot hC₁ hD₁, h_idealL_mul_ne_bot hC₂ hD₂, ?_⟩
    rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton,
      map_mul, map_mul]
    calc
      J₁ * (Ideal.span {α₁} * Ideal.span {β₁}) *
          (Ideal.relNorm (NumberField.RingOfIntegers K) C₁ * Ideal.relNorm (NumberField.RingOfIntegers K) D₁)
          = (J₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁) *
              Ideal.span {β₁} * Ideal.relNorm (NumberField.RingOfIntegers K) D₁ := by ring
      _ = (J₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂) *
            Ideal.span {β₁} * Ideal.relNorm (NumberField.RingOfIntegers K) D₁ := by rw [h₁₂]
      _ = (J₂ * Ideal.span {β₁} * Ideal.relNorm (NumberField.RingOfIntegers K) D₁) *
            Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂ := by ring
      _ = (J₃ * Ideal.span {β₂} * Ideal.relNorm (NumberField.RingOfIntegers K) D₂) *
            Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂ := by rw [h₂₃]
      _ = J₃ * (Ideal.span {α₂} * Ideal.span {β₂}) *
            (Ideal.relNorm (NumberField.RingOfIntegers K) C₂ * Ideal.relNorm (NumberField.RingOfIntegers K) D₂) := by ring
  have h_rel_mul : ∀ {J₁ J₁' J₂ J₂' : Ideal (NumberField.RingOfIntegers K)},
      RelNormEq J₁ J₁' → RelNormEq J₂ J₂' → RelNormEq (J₁ * J₂) (J₁' * J₂') := by
    rintro J₁ J₁' J₂ J₂' ⟨α₁, α₂, C₁, C₂, hα₁, hα₂, hC₁, hC₂, h₁⟩
      ⟨β₁, β₂, D₁, D₂, hβ₁, hβ₂, hD₁, hD₂, h₂⟩
    refine ⟨α₁ * β₁, α₂ * β₂, C₁ * D₁, C₂ * D₂,
      hNR_mul hα₁ hβ₁, hNR_mul hα₂ hβ₂,
      h_idealL_mul_ne_bot hC₁ hD₁, h_idealL_mul_ne_bot hC₂ hD₂, ?_⟩
    rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton,
      map_mul, map_mul]
    calc
      (J₁ * J₂) * (Ideal.span {α₁} * Ideal.span {β₁}) *
          (Ideal.relNorm (NumberField.RingOfIntegers K) C₁ * Ideal.relNorm (NumberField.RingOfIntegers K) D₁)
          = (J₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁) *
              (J₂ * Ideal.span {β₁} * Ideal.relNorm (NumberField.RingOfIntegers K) D₁) := by ring
      _ = (J₁' * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂) *
            (J₂' * Ideal.span {β₂} * Ideal.relNorm (NumberField.RingOfIntegers K) D₂) := by rw [h₁, h₂]
      _ = (J₁' * J₂') * (Ideal.span {α₂} * Ideal.span {β₂}) *
            (Ideal.relNorm (NumberField.RingOfIntegers K) C₂ * Ideal.relNorm (NumberField.RingOfIntegers K) D₂) := by ring
  have h_mul_top : ∀ J : Ideal (NumberField.RingOfIntegers K), J * ⊤ = J :=
    fun J => by rw [← Ideal.one_eq_top, mul_one]
  have h_top_mul : ∀ J : Ideal (NumberField.RingOfIntegers K), ⊤ * J = J :=
    fun J => by rw [← Ideal.one_eq_top, one_mul]
  have h_rel_cell : ∀ {I J : Ideal (NumberField.RingOfIntegers K)},
      I ≠ ⊥ → J ≠ ⊥ → InRayCell I J → RelNormEq (I * J) ⊤ := by
    rintro I J hI hJ ⟨α, hα_m, hα_pos, hIJ⟩
    have hα_ne : α ≠ 0 := h_cell_ne_zero hI hJ hIJ
    refine ⟨1, α, ⊤, ⊤, hNR_one, ⟨hα_ne, hα_m, hα_pos⟩, top_ne_bot, top_ne_bot, ?_⟩
    rw [hIJ, Ideal.span_singleton_one, h_mul_top, h_top_mul]
  let invCls : ∀ (I : Ideal (NumberField.RingOfIntegers K)), I ≠ ⊥ → IsCoprime I 𝔪 → Fin N_ray :=
    fun I hI h_cop => (hJ_cov I hI h_cop).choose
  have h_invCls : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (hI : I ≠ ⊥) (h_cop : IsCoprime I 𝔪),
      InRayCell I (J_all (invCls I hI h_cop)) :=
    fun I hI h_cop => (hJ_cov I hI h_cop).choose_spec
  let rep : ∀ (I : Ideal (NumberField.RingOfIntegers K)), I ≠ ⊥ → IsCoprime I 𝔪 → Fin N_ray :=
    fun I hI h_cop =>
      let u := invCls I hI h_cop
      invCls (J_all u) (hJ_prop u).1 (hJ_prop u).2
  have h_rel_rep : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (hI : I ≠ ⊥) (h_cop : IsCoprime I 𝔪),
      RelNormEq I (J_all (rep I hI h_cop)) := by
    intro I hI h_cop
    let u := invCls I hI h_cop
    let r := rep I hI h_cop
    rcases h_invCls I hI h_cop with ⟨α₁, hα₁_m, hα₁_pos, h_u⟩
    rcases h_invCls (J_all u) (hJ_prop u).1 (hJ_prop u).2 with ⟨α₂, hα₂_m, hα₂_pos, h_r⟩
    have hα₁_ne : α₁ ≠ 0 := h_cell_ne_zero hI (hJ_prop u).1 h_u
    have hα₂_ne : α₂ ≠ 0 := h_cell_ne_zero (hJ_prop u).1 (hJ_prop r).1 h_r
    refine ⟨α₂, α₁, ⊤, ⊤, ⟨hα₂_ne, hα₂_m, hα₂_pos⟩, ⟨hα₁_ne, hα₁_m, hα₁_pos⟩,
      top_ne_bot, top_ne_bot, ?_⟩
    change I * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) ⊤ =
      J_all r * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) ⊤
    rw [← h_r, ← h_u]
    ring
  have h_top_cop : IsCoprime (⊤ : Ideal (NumberField.RingOfIntegers K)) 𝔪 :=
    Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq 𝔪)
  let zero_idx : Fin N_ray := rep ⊤ top_ne_bot h_top_cop
  have h_zero_idx : RelNormEq ⊤ (J_all zero_idx) := h_rel_rep ⊤ top_ne_bot h_top_cop
  let neg_idx : Fin N_ray → Fin N_ray :=
    fun j => invCls (J_all j) (hJ_prop j).1 (hJ_prop j).2
  have h_neg_idx : ∀ j : Fin N_ray, RelNormEq (J_all j * J_all (neg_idx j)) ⊤ :=
    fun j => h_rel_cell (hJ_prop j).1 (hJ_prop (neg_idx j)).1
      (h_invCls (J_all j) (hJ_prop j).1 (hJ_prop j).2)
  let add_idx : Fin N_ray → Fin N_ray → Fin N_ray :=
    fun j₁ j₂ =>
      rep (J_all j₁ * J_all j₂)
        (h_ideal_mul_ne_bot (hJ_prop j₁).1 (hJ_prop j₂).1)
        (IsCoprime.mul_left (hJ_prop j₁).2 (hJ_prop j₂).2)
  have h_add_idx : ∀ j₁ j₂ : Fin N_ray,
      RelNormEq (J_all j₁ * J_all j₂) (J_all (add_idx j₁ j₂)) :=
    fun j₁ j₂ =>
      h_rel_rep (J_all j₁ * J_all j₂)
        (h_ideal_mul_ne_bot (hJ_prop j₁).1 (hJ_prop j₂).1)
        (IsCoprime.mul_left (hJ_prop j₁).2 (hJ_prop j₂).2)
  let s : Setoid (Fin N_ray) :=
    { r := fun j₁ j₂ => RelNormEq (J_all j₁) (J_all j₂)
      iseqv := ⟨fun j => h_rel_refl (J_all j),
                fun h => h_rel_symm h,
                fun h₁ h₂ => h_rel_trans h₁ h₂⟩ }
  let Q_norm := Quotient s
  letI : Fintype Q_norm := Quotient.fintype s
  let zero_Q : Q_norm := Quotient.mk s zero_idx
  let neg_Q : Q_norm → Q_norm :=
    Quotient.lift (fun j => Quotient.mk s (neg_idx j)) (by
      intro j₁ j₂ h₁₂
      apply Quotient.sound
      change RelNormEq (J_all (neg_idx j₁)) (J_all (neg_idx j₂))
      have step1 : RelNormEq (J_all (neg_idx j₁)) ((J_all j₂ * J_all (neg_idx j₂)) * J_all (neg_idx j₁)) := by
        have h := h_rel_mul (h_rel_symm (h_neg_idx j₂)) (h_rel_refl (J_all (neg_idx j₁)))
        rwa [h_top_mul] at h
      have step2 : (J_all j₂ * J_all (neg_idx j₂)) * J_all (neg_idx j₁) =
          (J_all j₂ * J_all (neg_idx j₁)) * J_all (neg_idx j₂) := by ring
      have step3 : RelNormEq ((J_all j₂ * J_all (neg_idx j₁)) * J_all (neg_idx j₂))
          ((J_all j₁ * J_all (neg_idx j₁)) * J_all (neg_idx j₂)) :=
        h_rel_mul (h_rel_mul (h_rel_symm h₁₂) (h_rel_refl (J_all (neg_idx j₁))))
          (h_rel_refl (J_all (neg_idx j₂)))
      have step4 : RelNormEq ((J_all j₁ * J_all (neg_idx j₁)) * J_all (neg_idx j₂)) (J_all (neg_idx j₂)) := by
        have h := h_rel_mul (h_neg_idx j₁) (h_rel_refl (J_all (neg_idx j₂)))
        rwa [h_top_mul] at h
      rw [step2] at step1
      exact h_rel_trans step1 (h_rel_trans step3 step4))
  let add_Q : Q_norm → Q_norm → Q_norm :=
    Quotient.lift₂ (fun j₁ j₂ => Quotient.mk s (add_idx j₁ j₂)) (by
      intro j₁ j₂ j₁' j₂' h₁ h₂
      apply Quotient.sound
      exact h_rel_trans (h_rel_symm (h_add_idx j₁ j₂))
        (h_rel_trans (h_rel_mul h₁ h₂) (h_add_idx j₁' j₂')))
  letI : Zero Q_norm := ⟨zero_Q⟩
  letI : Neg Q_norm := ⟨neg_Q⟩
  letI : Add Q_norm := ⟨add_Q⟩
  letI : AddCommGroup Q_norm :=
    { add := add_Q
      zero := zero_Q
      neg := neg_Q
      nsmul := nsmulRec
      zsmul := zsmulRec
      add_assoc := by
        intro x y z
        rcases Quotient.exists_rep x with ⟨j₁, rfl⟩
        rcases Quotient.exists_rep y with ⟨j₂, rfl⟩
        rcases Quotient.exists_rep z with ⟨j₃, rfl⟩
        apply Quotient.sound
        have hL : RelNormEq ((J_all j₁ * J_all j₂) * J_all j₃) (J_all (add_idx (add_idx j₁ j₂) j₃)) :=
          h_rel_trans (h_rel_mul (h_add_idx j₁ j₂) (h_rel_refl (J_all j₃)))
            (h_add_idx (add_idx j₁ j₂) j₃)
        have hR : RelNormEq (J_all j₁ * (J_all j₂ * J_all j₃)) (J_all (add_idx j₁ (add_idx j₂ j₃))) :=
          h_rel_trans (h_rel_mul (h_rel_refl (J_all j₁)) (h_add_idx j₂ j₃))
            (h_add_idx j₁ (add_idx j₂ j₃))
        rw [mul_assoc] at hL
        exact h_rel_trans (h_rel_symm hL) hR
      zero_add := by
        intro x
        rcases Quotient.exists_rep x with ⟨j, rfl⟩
        apply Quotient.sound
        have h1 : RelNormEq (⊤ * J_all j) (J_all (add_idx zero_idx j)) :=
          h_rel_trans (h_rel_mul h_zero_idx (h_rel_refl (J_all j))) (h_add_idx zero_idx j)
        rw [h_top_mul] at h1
        exact h_rel_symm h1
      add_zero := by
        intro x
        rcases Quotient.exists_rep x with ⟨j, rfl⟩
        apply Quotient.sound
        have h1 : RelNormEq (J_all j * ⊤) (J_all (add_idx j zero_idx)) :=
          h_rel_trans (h_rel_mul (h_rel_refl (J_all j)) h_zero_idx) (h_add_idx j zero_idx)
        rw [h_mul_top] at h1
        exact h_rel_symm h1
      neg_add_cancel := by
        intro x
        rcases Quotient.exists_rep x with ⟨j, rfl⟩
        apply Quotient.sound
        have h1 : RelNormEq (J_all (neg_idx j) * J_all j) (J_all (add_idx (neg_idx j) j)) :=
          h_add_idx (neg_idx j) j
        rw [mul_comm] at h1
        exact h_rel_trans (h_rel_symm h1) (h_rel_trans (h_neg_idx j) h_zero_idx)
      add_comm := by
        intro x y
        rcases Quotient.exists_rep x with ⟨j₁, rfl⟩
        rcases Quotient.exists_rep y with ⟨j₂, rfl⟩
        apply Quotient.sound
        have h1 : RelNormEq (J_all j₁ * J_all j₂) (J_all (add_idx j₁ j₂)) := h_add_idx j₁ j₂
        have h2 : RelNormEq (J_all j₂ * J_all j₁) (J_all (add_idx j₂ j₁)) := h_add_idx j₂ j₁
        rw [mul_comm] at h1
        exact h_rel_trans (h_rel_symm h1) h2 }
  let π : ∀ (I : Ideal (NumberField.RingOfIntegers K)), I ≠ ⊥ → IsCoprime I 𝔪 → Q_norm :=
    fun I hI h_cop => Quotient.mk s (rep I hI h_cop)
  have hπ_eq_iff : ∀ {I_a I_b : Ideal (NumberField.RingOfIntegers K)}
      (h_a : I_a ≠ ⊥) (hcop_a : IsCoprime I_a 𝔪)
      (h_b : I_b ≠ ⊥) (hcop_b : IsCoprime I_b 𝔪),
      π I_a h_a hcop_a = π I_b h_b hcop_b ↔ RelNormEq I_a I_b := by
    intro I_a I_b h_a hcop_a h_b hcop_b
    change Quotient.mk s (rep I_a h_a hcop_a) = Quotient.mk s (rep I_b h_b hcop_b) ↔ RelNormEq I_a I_b
    rw [Quotient.eq]
    change RelNormEq (J_all (rep I_a h_a hcop_a)) (J_all (rep I_b h_b hcop_b)) ↔ RelNormEq I_a I_b
    exact ⟨fun h => h_rel_trans (h_rel_rep I_a h_a hcop_a)
              (h_rel_trans h (h_rel_symm (h_rel_rep I_b h_b hcop_b))),
           fun h => h_rel_trans (h_rel_symm (h_rel_rep I_a h_a hcop_a))
              (h_rel_trans h (h_rel_rep I_b h_b hcop_b))⟩
  have hπ_mul : ∀ {I_a I_b : Ideal (NumberField.RingOfIntegers K)}
      (h_a : I_a ≠ ⊥) (hcop_a : IsCoprime I_a 𝔪)
      (h_b : I_b ≠ ⊥) (hcop_b : IsCoprime I_b 𝔪),
      π (I_a * I_b) (h_ideal_mul_ne_bot h_a h_b) (IsCoprime.mul_left hcop_a hcop_b) =
        π I_a h_a hcop_a + π I_b h_b hcop_b := by
    intro I_a I_b h_a hcop_a h_b hcop_b
    apply Quotient.sound
    have h1 := h_rel_rep (I_a * I_b) (h_ideal_mul_ne_bot h_a h_b) (IsCoprime.mul_left hcop_a hcop_b)
    have h2 := h_rel_mul (h_rel_rep I_a h_a hcop_a) (h_rel_rep I_b h_b hcop_b)
    have h3 := h_add_idx (rep I_a h_a hcop_a) (rep I_b h_b hcop_b)
    exact h_rel_trans (h_rel_symm h1) (h_rel_trans h2 h3)
  have hπ_ne : π I₁ hI₁_ne hI₁_cop ≠ π I₂ hI₂_ne hI₂_cop :=
    fun h => h_not_rel' ((hπ_eq_iff hI₁_ne hI₁_cop hI₂_ne hI₂_cop).mp h)
  have h_sub_ne : π I₁ hI₁_ne hI₁_cop - π I₂ hI₂_ne hI₂_cop ≠ 0 :=
    sub_ne_zero.mpr hπ_ne
  have h_ex_char : ∃ ψ₀ : AddChar Q_norm ℂ,
      ψ₀ (π I₁ hI₁_ne hI₁_cop) ≠ ψ₀ (π I₂ hI₂_ne hI₂_cop) := by
    by_contra h_all
    push_neg at h_all
    have h_sum : (∑ ψ : AddChar Q_norm ℂ, ψ (π I₁ hI₁_ne hI₁_cop - π I₂ hI₂_ne hI₂_cop)) =
        if π I₁ hI₁_ne hI₁_cop - π I₂ hI₂_ne hI₂_cop = 0 then (Fintype.card Q_norm : ℂ) else 0 :=
      AddChar.sum_apply_eq_ite (π I₁ hI₁_ne hI₁_cop - π I₂ hI₂_ne hI₂_cop)
    rw [if_neg h_sub_ne] at h_sum
    have h_each : ∀ ψ : AddChar Q_norm ℂ,
        ψ (π I₁ hI₁_ne hI₁_cop - π I₂ hI₂_ne hI₂_cop) = 1 := by
      intro ψ
      rw [sub_eq_add_neg, AddChar.map_add_eq_mul, AddChar.map_neg_eq_inv, h_all ψ]
      have h_norm : ‖ψ (π I₂ hI₂_ne hI₂_cop)‖ = 1 :=
        AddChar.norm_apply ψ (π I₂ hI₂_ne hI₂_cop)
      have h_nz : ψ (π I₂ hI₂_ne hI₂_cop) ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at h_norm
        exact zero_ne_one h_norm
      exact mul_inv_cancel₀ h_nz
    simp_rw [h_each] at h_sum
    rw [Finset.sum_const, Finset.card_univ, nsmul_one, AddChar.card_eq] at h_sum
    haveI : Nonempty Q_norm := ⟨0⟩
    have h_pos : 0 < Fintype.card Q_norm := Fintype.card_pos
    exact (Nat.cast_ne_zero.mpr h_pos.ne') h_sum
  obtain ⟨ψ₀, hψ₀_ne⟩ := h_ex_char
  let η : Ideal (NumberField.RingOfIntegers K) → ℂ := fun J =>
    if h : J ≠ ⊥ ∧ IsCoprime J 𝔪 then ψ₀ (π J h.1 h.2) else 0
  have hη_top : η ⊤ = 1 := by
    have h_top : (⊤ : Ideal (NumberField.RingOfIntegers K)) ≠ ⊥ ∧
        IsCoprime (⊤ : Ideal (NumberField.RingOfIntegers K)) 𝔪 := ⟨top_ne_bot, h_top_cop⟩
    dsimp only [η]
    rw [dif_pos h_top]
    exact AddChar.map_zero_eq_one ψ₀
  have hη_norm : ∀ J : Ideal (NumberField.RingOfIntegers K),
      J ≠ ⊥ ∧ IsCoprime J 𝔪 → ‖η J‖ = 1 := by
    intro J hJ
    dsimp only [η]
    rw [dif_pos hJ]
    exact AddChar.norm_apply ψ₀ (π J hJ.1 hJ.2)
  have hη_zero : ∀ J : Ideal (NumberField.RingOfIntegers K),
      ¬ (J ≠ ⊥ ∧ IsCoprime J 𝔪) → η J = 0 := by
    intro J hJ
    dsimp only [η]
    rw [dif_neg hJ]
  have hη_mul : ∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
      J₁ ≠ ⊥ → J₂ ≠ ⊥ → η (J₁ * J₂) = η J₁ * η J₂ := by
    intro J₁ J₂ hJ₁ hJ₂
    by_cases hcop : IsCoprime J₁ 𝔪 ∧ IsCoprime J₂ 𝔪
    · have h₁ : J₁ ≠ ⊥ ∧ IsCoprime J₁ 𝔪 := ⟨hJ₁, hcop.1⟩
      have h₂ : J₂ ≠ ⊥ ∧ IsCoprime J₂ 𝔪 := ⟨hJ₂, hcop.2⟩
      have h₁₂ : J₁ * J₂ ≠ ⊥ ∧ IsCoprime (J₁ * J₂) 𝔪 :=
        ⟨h_ideal_mul_ne_bot hJ₁ hJ₂, IsCoprime.mul_left hcop.1 hcop.2⟩
      dsimp only [η]
      rw [dif_pos h₁₂, dif_pos h₁, dif_pos h₂, hπ_mul hJ₁ hcop.1 hJ₂ hcop.2]
      exact AddChar.map_add_eq_mul ψ₀ (π J₁ hJ₁ hcop.1) (π J₂ hJ₂ hcop.2)
    · have h_not_mul : ¬ (J₁ * J₂ ≠ ⊥ ∧ IsCoprime (J₁ * J₂) 𝔪) := by
        intro h
        exact hcop ⟨IsCoprime.of_mul_left_left h.2, IsCoprime.of_mul_left_right h.2⟩
      dsimp only [η]
      rw [dif_neg h_not_mul]
      rcases not_and_or.mp hcop with hnc₁ | hnc₂
      · have hn₁ : ¬ (J₁ ≠ ⊥ ∧ IsCoprime J₁ 𝔪) := fun h => hnc₁ h.2
        rw [dif_neg hn₁, zero_mul]
      · have hn₂ : ¬ (J₂ ≠ ⊥ ∧ IsCoprime J₂ 𝔪) := fun h => hnc₂ h.2
        rw [dif_neg hn₂, mul_zero]
  have hη_cell : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (j : Fin N_ray),
      I ≠ ⊥ → InRayCell I (J_all j) → η I = (η (J_all j))⁻¹ := by
    intro I j hI h_cell
    have hIj_cop : IsCoprime (I * J_all j) 𝔪 := by
      rcases h_cell with ⟨α, hα_m, _, hIJ⟩
      rw [hIJ, Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
      have hα_in : α ∈ Ideal.span {α} ⊔ 𝔪 :=
        Ideal.mem_sup_left (Ideal.mem_span_singleton_self α)
      have h_sub_in : α - 1 ∈ Ideal.span {α} ⊔ 𝔪 :=
        Ideal.mem_sup_right hα_m
      have h1 := (Ideal.span {α} ⊔ 𝔪).sub_mem hα_in h_sub_in
      rwa [sub_sub_cancel] at h1
    have hI_cop : IsCoprime I 𝔪 := IsCoprime.of_mul_left_left hIj_cop
    have hI_cond : I ≠ ⊥ ∧ IsCoprime I 𝔪 := ⟨hI, hI_cop⟩
    have hj_cond : J_all j ≠ ⊥ ∧ IsCoprime (J_all j) 𝔪 := hJ_prop j
    dsimp only [η]
    rw [dif_pos hI_cond, dif_pos hj_cond]
    have h_add_zero : π I hI hI_cop + π (J_all j) hj_cond.1 hj_cond.2 = 0 := by
      rw [← hπ_mul hI hI_cop hj_cond.1 hj_cond.2]
      exact (hπ_eq_iff (h_ideal_mul_ne_bot hI hj_cond.1) (IsCoprime.mul_left hI_cop hj_cond.2)
        top_ne_bot h_top_cop).mpr (h_rel_cell hI hj_cond.1 h_cell)
    have h_neg : π I hI hI_cop = - π (J_all j) hj_cond.1 hj_cond.2 :=
      eq_neg_of_add_eq_zero_left h_add_zero
    rw [h_neg, AddChar.map_neg_eq_inv]
  have hη_relNorm : ∀ Q : Ideal (NumberField.RingOfIntegers L),
      Q ≠ ⊥ →
      IsCoprime (Ideal.relNorm (NumberField.RingOfIntegers K) Q) 𝔪 →
      η (Ideal.relNorm (NumberField.RingOfIntegers K) Q) = 1 := by
    intro Q hQ_ne hQ_cop
    have hQ_rel_ne : Ideal.relNorm (NumberField.RingOfIntegers K) Q ≠ ⊥ :=
      (Ideal.relNorm_eq_bot_iff (R := NumberField.RingOfIntegers K)).not.mpr hQ_ne
    have hQ_cond : Ideal.relNorm (NumberField.RingOfIntegers K) Q ≠ ⊥ ∧
        IsCoprime (Ideal.relNorm (NumberField.RingOfIntegers K) Q) 𝔪 :=
      ⟨hQ_rel_ne, hQ_cop⟩
    dsimp only [η]
    rw [dif_pos hQ_cond]
    have h_eq_zero : π (Ideal.relNorm (NumberField.RingOfIntegers K) Q) hQ_rel_ne hQ_cop = 0 := by
      apply (hπ_eq_iff hQ_rel_ne hQ_cop top_ne_bot h_top_cop).mpr
      refine ⟨1, 1, ⊤, Q, hNR_one, hNR_one, top_ne_bot, hQ_ne, ?_⟩
      rw [Ideal.span_singleton_one, h_mul_top, h_top_mul, Ideal.relNorm_top, h_mul_top, h_top_mul]
    rw [h_eq_zero, AddChar.map_zero_eq_one]
  have hη_ne : η I₁ ≠ η I₂ := by
    have h₁ : I₁ ≠ ⊥ ∧ IsCoprime I₁ 𝔪 := ⟨hI₁_ne, hI₁_cop⟩
    have h₂ : I₂ ≠ ⊥ ∧ IsCoprime I₂ 𝔪 := ⟨hI₂_ne, hI₂_cop⟩
    dsimp only [η]
    rw [dif_pos h₁, dif_pos h₂]
    exact hψ₀_ne
  
  have h_comm : ∀ g₁ g₂ : L ≃ₐ[K] L, g₁ * g₂ = g₂ * g₁ := by
    intro g₁ g₂
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic g₁) with ⟨n₁, rfl⟩
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic g₂) with ⟨n₂, rfl⟩
    rw [← zpow_add, add_comm, zpow_add]
  letI : CommGroup (L ≃ₐ[K] L) :=
    { (inferInstance : Group (L ≃ₐ[K] L)) with mul_comm := h_comm }
  let A_G := Additive (L ≃ₐ[K] L)
  have h_card_A : Fintype.card A_G = Module.finrank K L := by
    rw [Fintype.card_congr Additive.toMul, ← Nat.card_eq_fintype_card,
      IsGalois.card_aut_eq_finrank K L]
  have h_card_char : Fintype.card (AddChar A_G ℂ) = Module.finrank K L := by
    rw [AddChar.card_eq, h_card_A]
  let e_char : Fin (Module.finrank K L) ≃ AddChar A_G ℂ :=
    (finCongr h_card_char.symm).trans (Fintype.equivFin (AddChar A_G ℂ)).symm
  let χ : Fin (Module.finrank K L) → (L ≃ₐ[K] L) → ℂ :=
    fun i g => (e_char i) (Additive.ofMul g)
  have hχ_one : ∀ i : Fin (Module.finrank K L), χ i 1 = 1 :=
    fun i => AddChar.map_zero_eq_one (e_char i)
  have hχ_norm : ∀ (i : Fin (Module.finrank K L)) (g : L ≃ₐ[K] L), ‖χ i g‖ = 1 :=
    fun i g => AddChar.norm_apply (e_char i) (Additive.ofMul g)
  have hχ_mul : ∀ (i : Fin (Module.finrank K L)) (g₁ g₂ : L ≃ₐ[K] L),
      χ i (g₁ * g₂) = χ i g₁ * χ i g₂ :=
    fun i g₁ g₂ => AddChar.map_add_eq_mul (e_char i) (Additive.ofMul g₁) (Additive.ofMul g₂)
  have hχ_sum : ∀ g : L ≃ₐ[K] L,
      (g = 1 → (∑ i : Fin (Module.finrank K L), χ i g) = (Module.finrank K L : ℂ)) ∧
      (g ≠ 1 → (∑ i : Fin (Module.finrank K L), χ i g) = 0) := by
    intro g
    have h_sum_eq : (∑ i : Fin (Module.finrank K L), χ i g) =
        ∑ ψ : AddChar A_G ℂ, ψ (Additive.ofMul g) :=
      Fintype.sum_equiv e_char _ (fun ψ => ψ (Additive.ofMul g)) (fun _ => rfl)
    have h_ite : (∑ ψ : AddChar A_G ℂ, ψ (Additive.ofMul g)) =
        if Additive.ofMul g = 0 then (Fintype.card A_G : ℂ) else 0 :=
      AddChar.sum_apply_eq_ite (Additive.ofMul g)
    rw [h_sum_eq, h_ite, h_card_A]
    refine ⟨fun hg => ?_, fun hg => ?_⟩
    · rw [hg, ofMul_one, if_pos rfl]
    · have h_ne : Additive.ofMul g ≠ 0 := by
        intro h0
        apply hg
        exact Additive.ofMul.injective h0
      rw [if_neg h_ne]
  
  let ϕ : Fin (Module.finrank K L) → Ideal (NumberField.RingOfIntegers K) → ℂ :=
    fun i J => χ i (θ J) * η J
  refine ⟨ϕ, ?_, ?_⟩
  · intro i
    have hϕ_top : ϕ i ⊤ = 1 := by
      dsimp only [ϕ]
      rw [hθ_top, hχ_one i, hη_top, mul_one]
    have hϕ_norm : ∀ J : Ideal (NumberField.RingOfIntegers K), ‖ϕ i J‖ ≤ 1 := by
      intro J
      dsimp only [ϕ]
      rw [norm_mul, hχ_norm i (θ J), one_mul]
      by_cases hJ : J ≠ ⊥ ∧ IsCoprime J 𝔪
      · rw [hη_norm J hJ]
      · rw [hη_zero J hJ, norm_zero]
        exact zero_le_one
    have hϕ_mul : ∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
        J₁ ≠ ⊥ → J₂ ≠ ⊥ → ϕ i (J₁ * J₂) = ϕ i J₁ * ϕ i J₂ := by
      intro J₁ J₂ hJ₁ hJ₂
      dsimp only [ϕ]
      rw [hθ_mul J₁ J₂ hJ₁ hJ₂, hχ_mul i (θ J₁) (θ J₂), hη_mul J₁ J₂ hJ₁ hJ₂]
      ring
    have hϕ_not_cop : ∀ J : Ideal (NumberField.RingOfIntegers K),
        ¬ IsCoprime J 𝔪 → ϕ i J = 0 := by
      intro J hnc
      dsimp only [ϕ]
      rw [hη_zero J (fun h => hnc h.2), mul_zero]
    have hϕ_cell : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (j : Fin N_ray),
        I ≠ ⊥ → InRayCell I (J_all j) → ϕ i I = (ϕ i (J_all j))⁻¹ := by
      intro I j hI h_cell
      rcases h_cell with ⟨α, hα_m, hα_pos, hIJ⟩
      have hα_ne : α ≠ 0 := h_cell_ne_zero hI (hJ_prop j).1 hIJ
      have hθ_prod : θ I * θ (J_all j) = 1 := by
        rw [← hθ_mul I (J_all j) hI (hJ_prop j).1, hIJ]
        exact h𝔪_ker α hα_ne hα_m hα_pos
      have hχ_prod : χ i (θ I) * χ i (θ (J_all j)) = 1 := by
        rw [← hχ_mul i (θ I) (θ (J_all j)), hθ_prod, hχ_one i]
      have hχ_inv : χ i (θ I) = (χ i (θ (J_all j)))⁻¹ :=
        eq_inv_of_mul_eq_one_left hχ_prod
      have hη_inv : η I = (η (J_all j))⁻¹ :=
        hη_cell I j hI ⟨α, hα_m, hα_pos, hIJ⟩
      dsimp only [ϕ]
      rw [hχ_inv, hη_inv, ← mul_inv]
    have hϕ_sum_zero : (∑ j : Fin N_ray, (ϕ i (J_all j))⁻¹) = 0 := by
      have hϕ_ne : ϕ i I₁ ≠ ϕ i I₂ := by
        intro h_eq
        dsimp only [ϕ] at h_eq
        rw [hθ_eq] at h_eq
        have hχ_nz : χ i (θ I₂) ≠ 0 := by
          intro h0
          have hn := hχ_norm i (θ I₂)
          rw [h0, norm_zero] at hn
          exact zero_ne_one hn
        exact hη_ne (mul_left_cancel₀ hχ_nz h_eq)
      have hϕ₁_norm : ‖ϕ i I₁‖ = 1 := by
        dsimp only [ϕ]
        rw [norm_mul, hχ_norm i (θ I₁), hη_norm I₁ ⟨hI₁_ne, hI₁_cop⟩, mul_one]
      have hϕ₂_norm : ‖ϕ i I₂‖ = 1 := by
        dsimp only [ϕ]
        rw [norm_mul, hχ_norm i (θ I₂), hη_norm I₂ ⟨hI₂_ne, hI₂_cop⟩, mul_one]
      have hϕ₁_nz : ϕ i I₁ ≠ 0 := by
        intro h0; rw [h0, norm_zero] at hϕ₁_norm; exact zero_ne_one hϕ₁_norm
      have hϕ₂_nz : ϕ i I₂ ≠ 0 := by
        intro h0; rw [h0, norm_zero] at hϕ₂_norm; exact zero_ne_one hϕ₂_norm
      have h_ex_I₀ : ∃ I₀ : Ideal (NumberField.RingOfIntegers K),
          I₀ ≠ ⊥ ∧ IsCoprime I₀ 𝔪 ∧ ϕ i I₀ ≠ 0 ∧ ϕ i I₀ ≠ 1 := by
        by_cases h1 : ϕ i I₁ = 1
        · refine ⟨I₂, hI₂_ne, hI₂_cop, hϕ₂_nz, ?_⟩
          intro h2
          exact hϕ_ne (h1.trans h2.symm)
        · exact ⟨I₁, hI₁_ne, hI₁_cop, hϕ₁_nz, h1⟩
      obtain ⟨I₀, hI₀_ne, hI₀_cop, hϕ₀_nz, hϕ₀_ne_one⟩ := h_ex_I₀
      let u_of : Fin N_ray → Fin N_ray := fun j =>
        invCls (I₀ * J_all j)
          (h_ideal_mul_ne_bot hI₀_ne (hJ_prop j).1)
          (IsCoprime.mul_left hI₀_cop (hJ_prop j).2)
      let t_of : Fin N_ray → Fin N_ray := fun j =>
        invCls (J_all (u_of j)) (hJ_prop (u_of j)).1 (hJ_prop (u_of j)).2
      have ht_inj : Function.Injective t_of := by
        intro j₁ j₂ ht
        have hu₁_cell : InRayCell (J_all (t_of j₁)) (J_all (u_of j₁)) := by
          rcases h_invCls (J_all (u_of j₁)) (hJ_prop (u_of j₁)).1 (hJ_prop (u_of j₁)).2 with
            ⟨α, hα_m, hα_pos, h_eq⟩
          exact ⟨α, hα_m, hα_pos, by rw [mul_comm]; exact h_eq⟩
        have hu₂_cell : InRayCell (J_all (t_of j₁)) (J_all (u_of j₂)) := by
          rcases h_invCls (J_all (u_of j₂)) (hJ_prop (u_of j₂)).1 (hJ_prop (u_of j₂)).2 with
            ⟨α, hα_m, hα_pos, h_eq⟩
          exact ⟨α, hα_m, hα_pos, by rw [ht, mul_comm]; exact h_eq⟩
        have hu_eq : u_of j₁ = u_of j₂ :=
          hJ_inj (J_all (t_of j₁)) (u_of j₁) (u_of j₂) (hJ_prop (t_of j₁)).1 hu₁_cell hu₂_cell
        have hj₁_cell : InRayCell (I₀ * J_all (u_of j₁)) (J_all j₁) := by
          rcases h_invCls (I₀ * J_all j₁)
            (h_ideal_mul_ne_bot hI₀_ne (hJ_prop j₁).1)
            (IsCoprime.mul_left hI₀_cop (hJ_prop j₁).2) with ⟨α, hα_m, hα_pos, h_eq⟩
          refine ⟨α, hα_m, hα_pos, ?_⟩
          calc
            (I₀ * J_all (u_of j₁)) * J_all j₁ = (I₀ * J_all j₁) * J_all (u_of j₁) := by ring
            _ = Ideal.span {α} := h_eq
        have hj₂_cell : InRayCell (I₀ * J_all (u_of j₁)) (J_all j₂) := by
          rcases h_invCls (I₀ * J_all j₂)
            (h_ideal_mul_ne_bot hI₀_ne (hJ_prop j₂).1)
            (IsCoprime.mul_left hI₀_cop (hJ_prop j₂).2) with ⟨α, hα_m, hα_pos, h_eq⟩
          refine ⟨α, hα_m, hα_pos, ?_⟩
          calc
            (I₀ * J_all (u_of j₁)) * J_all j₂ = (I₀ * J_all j₂) * J_all (u_of j₂) := by
              rw [hu_eq]; ring
            _ = Ideal.span {α} := h_eq
        exact hJ_inj (I₀ * J_all (u_of j₁)) j₁ j₂
          (h_ideal_mul_ne_bot hI₀_ne (hJ_prop (u_of j₁)).1) hj₁_cell hj₂_cell
      have ht_bij : Function.Bijective t_of :=
        ⟨ht_inj, Finite.surjective_of_injective ht_inj⟩
      have ht_val : ∀ j : Fin N_ray,
          (ϕ i (J_all (t_of j)))⁻¹ = (ϕ i I₀)⁻¹ * (ϕ i (J_all j))⁻¹ := by
        intro j
        have h1 : ϕ i (I₀ * J_all j) = (ϕ i (J_all (u_of j)))⁻¹ :=
          hϕ_cell (I₀ * J_all j) (u_of j)
            (h_ideal_mul_ne_bot hI₀_ne (hJ_prop j).1)
            (h_invCls (I₀ * J_all j)
              (h_ideal_mul_ne_bot hI₀_ne (hJ_prop j).1)
              (IsCoprime.mul_left hI₀_cop (hJ_prop j).2))
        have h2 : ϕ i (J_all (u_of j)) = (ϕ i (J_all (t_of j)))⁻¹ :=
          hϕ_cell (J_all (u_of j)) (t_of j)
            (hJ_prop (u_of j)).1
            (h_invCls (J_all (u_of j)) (hJ_prop (u_of j)).1 (hJ_prop (u_of j)).2)
        rw [hϕ_mul I₀ (J_all j) hI₀_ne (hJ_prop j).1] at h1
        rw [← h2, ← inv_inv (ϕ i (J_all (u_of j))), ← h1, mul_inv]
      have h_sum_bij : (∑ j : Fin N_ray, (ϕ i (J_all (t_of j)))⁻¹) =
          ∑ j : Fin N_ray, (ϕ i (J_all j))⁻¹ :=
        Fintype.sum_bijective t_of ht_bij _ (fun j => (ϕ i (J_all j))⁻¹) (fun _ => rfl)
      simp_rw [ht_val] at h_sum_bij
      rw [← Finset.mul_sum] at h_sum_bij
      have h_sub_zero : (1 - (ϕ i I₀)⁻¹) * (∑ j : Fin N_ray, (ϕ i (J_all j))⁻¹) = 0 := by
        calc
          (1 - (ϕ i I₀)⁻¹) * (∑ j : Fin N_ray, (ϕ i (J_all j))⁻¹)
              = (∑ j : Fin N_ray, (ϕ i (J_all j))⁻¹) -
                  (ϕ i I₀)⁻¹ * (∑ j : Fin N_ray, (ϕ i (J_all j))⁻¹) := by ring
          _ = 0 := sub_eq_zero.mpr h_sum_bij.symm
      have h_inv_ne_one : (ϕ i I₀)⁻¹ ≠ 1 := inv_ne_one.mpr hϕ₀_ne_one
      have h_one_sub_ne : 1 - (ϕ i I₀)⁻¹ ≠ 0 := sub_ne_zero.mpr h_inv_ne_one.symm
      exact (mul_eq_zero.mp h_sub_zero).resolve_left h_one_sub_ne
    exact ⟨hϕ_top, hϕ_norm, hϕ_mul, hϕ_not_cop, hϕ_cell, hϕ_sum_zero⟩
  · intro P
    have h_sum_P : (∑ i : Fin (Module.finrank K L), ϕ i P.asIdeal) =
        (∑ i : Fin (Module.finrank K L), χ i (θ P.asIdeal)) * η P.asIdeal := by
      dsimp only [ϕ]
      rw [← Finset.sum_mul]
    rw [h_sum_P]
    refine ⟨fun hP => ?_, fun hP => ?_⟩
    · obtain ⟨Q, hQ_ne, hQ_rel⟩ := h_split P hP.1 hP.2
      have hη_P : η P.asIdeal = 1 := by
        rw [← hQ_rel]
        exact hη_relNorm Q hQ_ne (by rw [hQ_rel]; exact hP.1)
      rw [(hχ_sum (θ P.asIdeal)).1 hP.2, hη_P, mul_one]
    · rcases not_and_or.mp hP with hnc | hθ_ne
      · rw [hη_zero P.asIdeal (fun h => hnc h.2), mul_zero]
      · rw [(hχ_sum (θ P.asIdeal)).2 hθ_ne, zero_mul]

theorem exists_admissible_ray_classes_natCard_mul_torsionOrder_eq_sum {F : Type u} [Field F] [NumberField F]
    (m : Ideal (NumberField.RingOfIntegers F)) (hm : m ≠ ⊥) :
    ∃ (k : ℕ)
      (r : Fin k → NumberField.RingOfIntegers F ⧸ m)
      (ε : Fin k → ({ w : NumberField.InfinitePlace F // w.IsReal } → Bool)),
      ∀ (J : Ideal (NumberField.RingOfIntegers F)) (n : ℕ),
        Nat.card { P : Ideal (NumberField.RingOfIntegers F) //
          P ≠ ⊥ ∧
          (∃ a ∈ J,
            a - 1 ∈ m ∧
            (∀ w : NumberField.InfinitePlace F,
              w.IsReal → 0 < (w.embedding (a : F)).re) ∧
            P = Ideal.span {a}) ∧
          Ideal.absNorm P ≤ n * Ideal.absNorm J } *
        NumberField.Units.torsionOrder F =
        ∑ i : Fin k,
          Nat.card { b : NumberField.RingOfIntegers F //
            b ∈ J ∧
            Ideal.Quotient.mk m b = r i ∧
            NumberField.mixedEmbedding F (b : F) ∈
              NumberField.mixedEmbedding.fundamentalCone F ∧
            (∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
              decide (0 < (w.1.embedding (b : F)).re) = ε i w) ∧
            NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤
              (n : ℝ) * (Ideal.absNorm J : ℝ) } :=
by
  classical
  let R := NumberField.RingOfIntegers F
  let W := { w : NumberField.InfinitePlace F // w.IsReal }
  haveI : Finite (R ⧸ m) := Ideal.finiteQuotientOfFreeOfNeBot m hm
  let P_adm : (R ⧸ m) × (W → Bool) → Prop := fun p =>
    ∃ u : Rˣ,
      Ideal.Quotient.mk m (u : R) * p.1 = 1 ∧
      ∀ w : W,
        if p.2 w then 0 < (w.1.embedding ((u : R) : F)).re
        else (w.1.embedding ((u : R) : F)).re < 0
  let S_adm := { p : (R ⧸ m) × (W → Bool) // P_adm p }
  letI : Fintype S_adm := Fintype.ofFinite S_adm
  let k : ℕ := Fintype.card S_adm
  let e_fin : Fin k ≃ S_adm := (Fintype.equivFin S_adm).symm
  let r : Fin k → R ⧸ m := fun i => (e_fin i).1.1
  let ε : Fin k → (W → Bool) := fun i => (e_fin i).1.2
  refine ⟨k, r, ε, fun J n => ?_⟩
  let ψ : R → (R ⧸ m) × (W → Bool) := fun b =>
    (Ideal.Quotient.mk m b, fun w : W => decide (0 < (w.1.embedding (b : F)).re))
  have h_re_eq : ∀ (w : W) (x : F),
      (w.1.embedding x).re = w.1.embedding_of_isReal w.2 x := by
    intro w x
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply w.2 x, Complex.ofReal_re]
  have h_re_mul : ∀ (w : W) (x y : R),
      (w.1.embedding (((x * y : R) : F))).re =
        (w.1.embedding (x : F)).re * (w.1.embedding (y : F)).re := by
    intro w x y
    rw [h_re_eq, h_re_eq, h_re_eq]
    push_cast
    rw [map_mul]
  have h_re_ne_zero : ∀ {b : R}, b ≠ 0 → ∀ w : W, (w.1.embedding (b : F)).re ≠ 0 := by
    intro b hb w
    rw [h_re_eq, ← map_zero (w.1.embedding_of_isReal w.2)]
    have hbF : (b : F) ≠ 0 := by exact_mod_cast hb
    exact (RingHom.injective (w.1.embedding_of_isReal w.2)).ne hbF
  have h_sign_iff : ∀ {b : R}, b ≠ 0 → ∀ (u : Rˣ) (w : W),
      0 < (w.1.embedding ((((u : R) * b : R) : F))).re ↔
        (if decide (0 < (w.1.embedding (b : F)).re) then
          0 < (w.1.embedding ((u : R) : F)).re
        else
          (w.1.embedding ((u : R) : F)).re < 0) := by
    intro b hb u w
    rw [h_re_mul, mul_pos_iff]
    have hb_ne : (w.1.embedding (b : F)).re ≠ 0 := h_re_ne_zero hb w
    by_cases hb_pos : 0 < (w.1.embedding (b : F)).re
    · simp only [hb_pos, decide_true, ↓reduceIte]
      have hb_not_neg : ¬ (w.1.embedding (b : F)).re < 0 := not_lt.mpr hb_pos.le
      tauto
    · simp only [hb_pos, decide_false, Bool.false_eq_true, ↓reduceIte]
      have hb_neg : (w.1.embedding (b : F)).re < 0 :=
        lt_of_le_of_ne (not_lt.mp hb_pos) hb_ne
      tauto
  have h_adm_iff : ∀ {b : R}, b ≠ 0 →
      ((∃ a ∈ J,
        a - 1 ∈ m ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        Ideal.span {b} = Ideal.span {a}) ↔
      b ∈ J ∧ P_adm (ψ b)) := by
    intro b hb
    constructor
    · rintro ⟨a, ha_J, ha_m, ha_pos, h_span⟩
      have hb_J : b ∈ J := by
        have hb_mem : b ∈ Ideal.span {b} := Ideal.subset_span (Set.mem_singleton b)
        rw [h_span, Ideal.mem_span_singleton] at hb_mem
        rcases hb_mem with ⟨c, rfl⟩
        exact Ideal.mul_mem_right c J ha_J
      obtain ⟨u, hu_eq⟩ := Ideal.span_singleton_eq_span_singleton.mp h_span
      have ha_eq : (u : R) * b = a := by rw [mul_comm, hu_eq]
      refine ⟨hb_J, u, ?_, ?_⟩
      · dsimp [ψ]
        rw [← map_mul, ha_eq, ← map_one (Ideal.Quotient.mk m),
          Ideal.Quotient.mk_eq_mk_iff_sub_mem]
        exact ha_m
      · intro w
        dsimp [ψ]
        rw [← h_sign_iff hb u w, ha_eq]
        exact ha_pos w.1 w.2
    · rintro ⟨hb_J, u, hu_m, hu_sign⟩
      let a : R := (u : R) * b
      have ha_J : a ∈ J := Ideal.mul_mem_left J (u : R) hb_J
      have ha_m : a - 1 ∈ m := by
        rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem, map_one]
        change Ideal.Quotient.mk m ((u : R) * b) = 1
        rw [map_mul]
        exact hu_m
      have ha_pos : ∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re := by
        intro w hw
        exact (h_sign_iff hb u ⟨w, hw⟩).mpr (hu_sign ⟨w, hw⟩)
      have h_span : Ideal.span {b} = Ideal.span {a} :=
        Ideal.span_singleton_eq_span_singleton.mpr ⟨u, mul_comm b (u : R)⟩
      exact ⟨a, ha_J, ha_m, ha_pos, h_span⟩
  let ConeInt := { b : R // NumberField.mixedEmbedding F (b : F) ∈ NumberField.mixedEmbedding.fundamentalCone F }
  let e_cone : ConeInt ≃ ↥(NumberField.mixedEmbedding.fundamentalCone.integerSet F) :=
    { toFun := fun b =>
        ⟨NumberField.mixedEmbedding F (b.1 : F),
          NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨b.2, b.1, rfl⟩⟩
      invFun := fun x =>
        ⟨(NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet x : R), by
          rw [NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet]
          exact (NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mp x.2).1⟩
      left_inv := fun b => Subtype.ext
        (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding _)
      right_inv := fun x => Subtype.ext
        (NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet x) }
  have hb_ne : ∀ b : ConeInt, b.1 ≠ 0 := by
    intro b
    have h_eq : (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (e_cone b) : R) = b.1 :=
      NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding _
    rw [← h_eq]
    exact mem_nonZeroDivisors_iff_ne_zero.mp
      (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (e_cone b)).2
  have h_norm_cone : ∀ b : ConeInt,
      (Ideal.absNorm (Ideal.span {b.1}) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b.1 : F)) := by
    intro b
    have h1 : Ideal.absNorm (Ideal.span {b.1}) =
        NumberField.mixedEmbedding.fundamentalCone.intNorm (e_cone b) := by
      rw [Ideal.absNorm_span_singleton]
      exact congrArg Int.natAbs (congrArg (Algebra.norm ℤ)
        (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding _).symm)
    rw [h1, NumberField.mixedEmbedding.fundamentalCone.intNorm_coe]
    rfl
  let L_set := { P : Ideal R //
    P ≠ ⊥ ∧
    (∃ a ∈ J,
      a - 1 ∈ m ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a : F)).re) ∧
      P = Ideal.span {a}) ∧
    Ideal.absNorm P ≤ n * Ideal.absNorm J }
  let B_adm := { b : R //
    b ∈ J ∧
    P_adm (ψ b) ∧
    NumberField.mixedEmbedding F (b : F) ∈
      NumberField.mixedEmbedding.fundamentalCone F ∧
    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤
      (n : ℝ) * (Ideal.absNorm J : ℝ) }
  let PrinNZD := { I : nonZeroDivisors (Ideal R) // Submodule.IsPrincipal (I : Ideal R) }
  let Q_prin : PrinNZD → Prop := fun I =>
    (∃ a ∈ J,
      a - 1 ∈ m ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a : F)).re) ∧
      (I.1 : Ideal R) = Ideal.span {a}) ∧
    Ideal.absNorm (I.1 : Ideal R) ≤ n * Ideal.absNorm J
  let e_L : L_set ≃ { I : PrinNZD // Q_prin I } :=
    { toFun := fun P =>
        ⟨⟨⟨P.1, mem_nonZeroDivisors_iff_ne_zero.mpr (by rw [Submodule.zero_eq_bot]; exact P.2.1)⟩,
          by
            rcases P.2.2.1 with ⟨a, _, _, _, hP⟩
            exact ⟨⟨a, hP⟩⟩⟩,
          P.2.2⟩
      invFun := fun I =>
        ⟨I.1.1.1,
          by
            rw [← Submodule.zero_eq_bot]
            exact mem_nonZeroDivisors_iff_ne_zero.mp I.1.1.2,
          I.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  let e_prod : L_set × ↥(NumberField.Units.torsion F) ≃
      { p : PrinNZD × ↥(NumberField.Units.torsion F) // Q_prin p.1 } :=
    { toFun := fun p => ⟨(e_L p.1, p.2), (e_L p.1).2⟩
      invFun := fun q => (e_L.symm ⟨q.1.1, q.2⟩, q.1.2)
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  let e_int : ConeInt ≃ PrinNZD × ↥(NumberField.Units.torsion F) :=
    e_cone.trans (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv F)
  have he_int_fst : ∀ b : ConeInt,
      (((e_int b).1 : nonZeroDivisors (Ideal R)) : Ideal R) = Ideal.span {b.1} := by
    intro b
    change (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv F (e_cone b)).1 :
      nonZeroDivisors (Ideal R)) : Ideal R) = Ideal.span {b.1}
    rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst]
    dsimp [e_cone]
    rw [NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding]
  have hQ_iff : ∀ b : ConeInt,
      (b.1 ∈ J ∧ P_adm (ψ b.1) ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b.1 : F)) ≤
          (n : ℝ) * (Ideal.absNorm J : ℝ)) ↔
      Q_prin (e_int b).1 := by
    intro b
    dsimp [Q_prin]
    rw [he_int_fst b, h_adm_iff (hb_ne b), ← Nat.cast_le (α := ℝ), Nat.cast_mul, h_norm_cone b,
      and_assoc]
  let e_B_cone : B_adm ≃
      { b : ConeInt //
        b.1 ∈ J ∧ P_adm (ψ b.1) ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b.1 : F)) ≤
            (n : ℝ) * (Ideal.absNorm J : ℝ) } :=
    { toFun := fun b => ⟨⟨b.1, b.2.2.2.1⟩, b.2.1, b.2.2.1, b.2.2.2.2⟩
      invFun := fun b => ⟨b.1.1, b.2.1, b.2.2.1, b.1.2, b.2.2.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  let e_tot : L_set × ↥(NumberField.Units.torsion F) ≃ B_adm :=
    (e_prod.trans (Equiv.subtypeEquiv e_int hQ_iff).symm).trans e_B_cone.symm
  have h_torsion_card : Nat.card ↥(NumberField.Units.torsion F) = NumberField.Units.torsionOrder F :=
    Nat.card_eq_fintype_card
  have h_card_mul : Nat.card L_set * NumberField.Units.torsionOrder F = Nat.card B_adm := by
    have h1 := Nat.card_congr e_tot
    rw [Nat.card_prod, h_torsion_card] at h1
    exact h1
  haveI : Finite { P : Ideal R // Ideal.absNorm P ≤ n * Ideal.absNorm J } :=
    Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_le (n * Ideal.absNorm J))
  let ι_L : L_set → { P : Ideal R // Ideal.absNorm P ≤ n * Ideal.absNorm J } :=
    fun P => ⟨P.1, P.2.2.2⟩
  have hι_L_inj : Function.Injective ι_L := by
    intro P₁ P₂ h
    have h_val := congrArg Subtype.val h
    exact Subtype.ext h_val
  haveI : Finite L_set := Finite.of_injective ι_L hι_L_inj
  haveI : Finite B_adm := Finite.of_equiv _ e_tot
  letI : Fintype B_adm := Fintype.ofFinite B_adm
  let B_fiber : Fin k → Type u := fun i =>
    { b : R //
      b ∈ J ∧
      Ideal.Quotient.mk m b = r i ∧
      NumberField.mixedEmbedding F (b : F) ∈
        NumberField.mixedEmbedding.fundamentalCone F ∧
      (∀ w : W, decide (0 < (w.1.embedding (b : F)).re) = ε i w) ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤
        (n : ℝ) * (Ideal.absNorm J : ℝ) }
  let Φ_adm : B_adm → S_adm := fun b => ⟨ψ b.1, b.2.2.1⟩
  have h_fib_card : ∀ i : Fin k,
      Nat.card (B_fiber i) = Fintype.card { b : B_adm // Φ_adm b = e_fin i } := by
    intro i
    rw [← Nat.card_eq_fintype_card]
    let e_fib : B_fiber i ≃ { b : B_adm // Φ_adm b = e_fin i } :=
      { toFun := fun b =>
          have h_ψ : ψ b.1 = (e_fin i).1 := by
            ext
            · exact b.2.2.1
            · exact b.2.2.2.2.1 _
          have h_P : P_adm (ψ b.1) := by
            rw [h_ψ]
            exact (e_fin i).2
          ⟨⟨b.1, b.2.1, h_P, b.2.2.2.1, b.2.2.2.2.2⟩, Subtype.ext h_ψ⟩
        invFun := fun u =>
          have h_ψ : ψ u.1.1 = (e_fin i).1 := congrArg Subtype.val u.2
          have h_r : Ideal.Quotient.mk m u.1.1 = r i := congrArg Prod.fst h_ψ
          have h_ε : ∀ w : W, decide (0 < (w.1.embedding (u.1.1 : F)).re) = ε i w :=
            congrFun (congrArg Prod.snd h_ψ)
          ⟨u.1.1, u.1.2.1, h_r, u.1.2.2.2.1, h_ε, u.1.2.2.2.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    exact Nat.card_congr e_fib
  have h_sum_fib : (∑ i : Fin k, Nat.card (B_fiber i)) = Nat.card B_adm := by
    simp_rw [h_fib_card]
    have h_reindex :
        (∑ i : Fin k, Fintype.card { b : B_adm // Φ_adm b = e_fin i }) =
        ∑ s : S_adm, Fintype.card { b : B_adm // Φ_adm b = s } :=
      Fintype.sum_equiv e_fin
        (fun i => Fintype.card { b : B_adm // Φ_adm b = e_fin i })
        (fun s => Fintype.card { b : B_adm // Φ_adm b = s })
        (fun _ => rfl)
    rw [h_reindex, ← Fintype.card_sigma, ← Nat.card_eq_fintype_card]
    exact Nat.card_congr (Equiv.sigmaFiberEquiv Φ_adm)
  rw [← h_sum_fib] at h_card_mul
  exact h_card_mul

theorem exists_orthant_cone_natCard_eq_shifted_int_lattice_and_volume_eq {F : Type u} [Field F] [NumberField F]
    (m : Ideal (NumberField.RingOfIntegers F)) (hm : m ≠ ⊥)
    (ε₀ : { w : NumberField.InfinitePlace F // w.IsReal } → Bool) :
    ∃ κ₀ : ℝ,
      ∀ (J : Ideal (NumberField.RingOfIntegers F)),
        J ≠ ⊥ → IsCoprime J m →
        ∀ (r₀ : NumberField.RingOfIntegers F ⧸ m),
          ∃ (Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin (Module.finrank ℚ F) → ℝ))
            (Ω : Set (Fin (Module.finrank ℚ F) → ℝ))
            (v₀ : Fin (Module.finrank ℚ F) → ℝ),
            Ω ⊆ Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F ∧
            MeasurableSet Ω ∧
            frontier Ω ⊆ frontier (Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F) ∧
            MeasureTheory.volume.real Ω * (Ideal.absNorm J : ℝ) = κ₀ ∧
            ∀ R : ℝ, 0 < R →
              Nat.card { b : NumberField.RingOfIntegers F //
                b ∈ J ∧
                Ideal.Quotient.mk m b = r₀ ∧
                NumberField.mixedEmbedding F (b : F) ∈
                  NumberField.mixedEmbedding.fundamentalCone F ∧
                (∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
                  decide (0 < (w.1.embedding (b : F)).re) = ε₀ w) ∧
                NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤
                  R ^ (Module.finrank ℚ F) } =
              Nat.card { z : Fin (Module.finrank ℚ F) → ℤ //
                (fun i : Fin (Module.finrank ℚ F) => ((z i : ℝ) + v₀ i) / R) ∈ Ω } :=
by
  classical
  have h_s1 :
      ∀ (Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin (Module.finrank ℚ F) → ℝ)),
        let S : Set (NumberField.mixedEmbedding.mixedSpace F) :=
          { x ∈ NumberField.mixedEmbedding.fundamentalCone.normLeOne F |
            ∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
              decide (0 < x.1 w) = ε₀ w }
        Φ '' S ⊆ Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F ∧
        MeasurableSet (Φ '' S) ∧
        frontier (Φ '' S) ⊆ frontier (Φ '' NumberField.mixedEmbedding.fundamentalCone.normLeOne F) ∧
        ∀ (b : NumberField.RingOfIntegers F) (R : ℝ), 0 < R →
          ((NumberField.mixedEmbedding F (b : F) ∈ NumberField.mixedEmbedding.fundamentalCone F ∧
            (∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
              decide (0 < (w.1.embedding (b : F)).re) = ε₀ w) ∧
            NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤
              R ^ (Module.finrank ℚ F)) ↔
            R⁻¹ • NumberField.mixedEmbedding F (b : F) ∈ S) := by
    intro Φ S
    let A : Set (NumberField.mixedEmbedding.mixedSpace F) :=
      NumberField.mixedEmbedding.fundamentalCone.normLeOne F
    have hS_sub_A : S ⊆ A := Set.sep_subset _ _
    have h_img_sub : Φ '' S ⊆ Φ '' A := Set.image_mono hS_sub_A
    have hA_ne_zero : ∀ x ∈ A, ∀ w : { w : NumberField.InfinitePlace F // w.IsReal }, x.1 w ≠ 0 := by
      intro x hx w
      have hx_cone : x ∈ NumberField.mixedEmbedding.fundamentalCone F :=
        (NumberField.mixedEmbedding.fundamentalCone.mem_normLeOne.mp hx).1
      have h_pos : 0 < NumberField.mixedEmbedding.normAtPlace w.1 x :=
        NumberField.mixedEmbedding.fundamentalCone.normAtPlace_pos_of_mem hx_cone w.1
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2 x] at h_pos
      exact norm_pos_iff.mp h_pos
    let O : Set (NumberField.mixedEmbedding.mixedSpace F) :=
      ⋂ w : { w : NumberField.InfinitePlace F // w.IsReal },
        { x : NumberField.mixedEmbedding.mixedSpace F |
          if ε₀ w = true then 0 < x.1 w else x.1 w < 0 }
    let O' : Set (NumberField.mixedEmbedding.mixedSpace F) :=
      ⋃ w : { w : NumberField.InfinitePlace F // w.IsReal },
        { x : NumberField.mixedEmbedding.mixedSpace F |
          if ε₀ w = true then x.1 w < 0 else 0 < x.1 w }
    have hO_open : IsOpen O := by
      apply isOpen_iInter_of_finite
      intro w
      have h_cont : Continuous (fun x : NumberField.mixedEmbedding.mixedSpace F => x.1 w) :=
        (continuous_apply w).comp continuous_fst
      by_cases hε : ε₀ w = true
      · simp only [hε, ↓reduceIte]
        exact isOpen_lt continuous_const h_cont
      · simp only [hε]
        exact isOpen_lt h_cont continuous_const
    have hO'_open : IsOpen O' := by
      apply isOpen_iUnion
      intro w
      have h_cont : Continuous (fun x : NumberField.mixedEmbedding.mixedSpace F => x.1 w) :=
        (continuous_apply w).comp continuous_fst
      by_cases hε : ε₀ w = true
      · simp only [hε, ↓reduceIte]
        exact isOpen_lt h_cont continuous_const
      · simp only [hε]
        exact isOpen_lt continuous_const h_cont
    have hS_eq_inter : S = A ∩ O := by
      ext x
      simp only [S, A, O, Set.mem_inter_iff, Set.mem_iInter, Set.mem_setOf_eq]
      refine and_congr_right fun hxA => forall_congr' fun w => ?_
      have h_ne := hA_ne_zero x hxA w
      cases hε : ε₀ w
      · simp only [Bool.false_eq_true, ↓reduceIte, decide_eq_false_iff_not, not_lt]
        exact ⟨fun h_le => lt_of_le_of_ne h_le h_ne, le_of_lt⟩
      · simp only [↓reduceIte, decide_eq_true_eq]
    have hA_sub_union : A ⊆ O ∪ O' := by
      intro x hxA
      by_cases hxO : x ∈ O
      · exact Or.inl hxO
      · right
        simp only [O, Set.mem_iInter, Set.mem_setOf_eq, not_forall] at hxO
        rcases hxO with ⟨w, hw⟩
        rw [Set.mem_iUnion]
        refine ⟨w, ?_⟩
        simp only [Set.mem_setOf_eq]
        have h_ne := hA_ne_zero x hxA w
        cases hε : ε₀ w
        · simp only [hε, Bool.false_eq_true, ↓reduceIte, not_lt] at hw ⊢
          exact lt_of_le_of_ne hw h_ne.symm
        · simp only [hε, ↓reduceIte, not_lt] at hw ⊢
          exact lt_of_le_of_ne hw h_ne
    have hO'_inter_S : O' ∩ S = ∅ := by
      rw [hS_eq_inter]
      ext x
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
      intro hxO' _ hxO
      simp only [O', Set.mem_iUnion, Set.mem_setOf_eq] at hxO'
      rcases hxO' with ⟨w, hw'⟩
      have hw := Set.mem_iInter.mp hxO w
      simp only [Set.mem_setOf_eq] at hw
      by_cases hε : ε₀ w = true
      · simp only [hε, ↓reduceIte] at hw hw'
        exact lt_asymm hw hw'
      · simp only [hε] at hw hw'
        exact lt_asymm hw hw'
    have hS_meas : MeasurableSet S := by
      rw [hS_eq_inter]
      exact (NumberField.mixedEmbedding.fundamentalCone.measurableSet_normLeOne F).inter
        hO_open.measurableSet
    let e_meas : NumberField.mixedEmbedding.mixedSpace F ≃ᵐ (Fin (Module.finrank ℚ F) → ℝ) :=
      Φ.toHomeomorph.toMeasurableEquiv
    have h_img_meas : MeasurableSet (Φ '' S) :=
      (e_meas.measurableSet_image).mpr hS_meas
    have h_front_S : frontier S ⊆ frontier A := by
      intro y hy
      rcases hy with ⟨hy_cl, hy_not_int⟩
      refine ⟨closure_mono hS_sub_A hy_cl, ?_⟩
      intro hy_intA
      have hyA : y ∈ A := interior_subset hy_intA
      rcases hA_sub_union hyA with hyO | hyO'
      · apply hy_not_int
        rw [hS_eq_inter, interior_inter, hO_open.interior_eq]
        exact ⟨hy_intA, hyO⟩
      · have hy_inter : y ∈ O' ∩ closure S := ⟨hyO', hy_cl⟩
        have hy_cl_inter : y ∈ closure (O' ∩ S) := hO'_open.inter_closure hy_inter
        rw [hO'_inter_S, closure_empty] at hy_cl_inter
        exact hy_cl_inter
    have h_img_front : frontier (Φ '' S) ⊆ frontier (Φ '' A) := by
      change frontier (Φ.toHomeomorph '' S) ⊆ frontier (Φ.toHomeomorph '' A)
      rw [← Φ.toHomeomorph.image_frontier S, ← Φ.toHomeomorph.image_frontier A]
      exact Set.image_mono h_front_S
    refine ⟨h_img_sub, h_img_meas, h_img_front, fun b R hR => ?_⟩
    have hR_ne : R ≠ 0 := hR.ne'
    have hR_inv_pos : 0 < R⁻¹ := inv_pos.mpr hR
    have hR_inv_ne : R⁻¹ ≠ 0 := inv_ne_zero hR_ne
    have hRd_pos : 0 < R ^ (Module.finrank ℚ F) := pow_pos hR (Module.finrank ℚ F)
    have h_cone_norm :
        (NumberField.mixedEmbedding F (b : F) ∈ NumberField.mixedEmbedding.fundamentalCone F ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤
            R ^ (Module.finrank ℚ F)) ↔
        R⁻¹ • NumberField.mixedEmbedding F (b : F) ∈ A := by
      rw [NumberField.mixedEmbedding.fundamentalCone.mem_normLeOne,
        NumberField.mixedEmbedding.fundamentalCone.smul_mem_iff_mem hR_inv_ne,
        NumberField.mixedEmbedding.norm_smul, abs_of_pos hR_inv_pos, inv_pow,
        inv_mul_le_iff₀ hRd_pos, mul_one]
    have h_sign : ∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
        decide (0 < (w.1.embedding (b : F)).re) =
          decide (0 < (R⁻¹ • NumberField.mixedEmbedding F (b : F)).1 w) := by
      intro w
      congr 1
      rw [eq_iff_iff]
      have h_emb : (NumberField.mixedEmbedding F (b : F)).1 w = (w.1.embedding (b : F)).re := by
        rw [NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
        rfl
      change 0 < (w.1.embedding (b : F)).re ↔ 0 < R⁻¹ * (NumberField.mixedEmbedding F (b : F)).1 w
      rw [h_emb]
      exact (mul_pos_iff_of_pos_left hR_inv_pos).symm
    simp only [S, Set.mem_sep_iff]
    rw [← h_cone_norm]
    constructor
    · rintro ⟨h1, h2, h3⟩
      refine ⟨⟨h1, h3⟩, fun w => ?_⟩
      rw [← h_sign w]
      exact h2 w
    · rintro ⟨⟨h1, h3⟩, h2⟩
      refine ⟨h1, fun w => ?_, h3⟩
      rw [h_sign w]
      exact h2 w

  have h_s2 :
      ∀ (J : Ideal (NumberField.RingOfIntegers F))
        (hJm : J * m ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)))
        (hJ_cop : IsCoprime J m)
        (r₀ : NumberField.RingOfIntegers F ⧸ m)
        (b_Z : Module.Basis (Fin (Module.finrank ℚ F)) ℤ
          ↥(NumberField.mixedEmbedding.idealLattice F (FractionalIdeal.mk0 F ⟨J * m, hJm⟩)))
        (Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin (Module.finrank ℚ F) → ℝ)),
        (∀ (x : ↥(NumberField.mixedEmbedding.idealLattice F (FractionalIdeal.mk0 F ⟨J * m, hJm⟩)))
          (i : Fin (Module.finrank ℚ F)),
          Φ (x : NumberField.mixedEmbedding.mixedSpace F) i = (b_Z.repr x i : ℝ)) →
        ∃ v₀ : Fin (Module.finrank ℚ F) → ℝ,
          ∀ (S : Set (NumberField.mixedEmbedding.mixedSpace F)) (R : ℝ), 0 < R →
            Nat.card { b : NumberField.RingOfIntegers F //
              b ∈ J ∧
              Ideal.Quotient.mk m b = r₀ ∧
              R⁻¹ • NumberField.mixedEmbedding F (b : F) ∈ S } =
            Nat.card { z : Fin (Module.finrank ℚ F) → ℤ //
              (fun i : Fin (Module.finrank ℚ F) => ((z i : ℝ) + v₀ i) / R) ∈ Φ '' S } := by
    intro J hJm hJ_cop r₀ b_Z Φ hΦ_repr
    let d := Module.finrank ℚ F
    obtain ⟨x₀, hx₀⟩ := Ideal.Quotient.mk_surjective r₀
    obtain ⟨u, hu, v, hv, huv⟩ := Ideal.isCoprime_iff_exists.mp hJ_cop
    let b₀ : NumberField.RingOfIntegers F := u * x₀
    have hb₀_J : b₀ ∈ J := Ideal.mul_mem_right x₀ J hu
    have hb₀_m : Ideal.Quotient.mk m b₀ = r₀ := by
      rw [← hx₀, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      have h_sub : b₀ - x₀ = (-v) * x₀ := by
        dsimp [b₀]
        calc u * x₀ - x₀ = (u + v - 1) * x₀ + (-v) * x₀ := by ring
        _ = (-v) * x₀ := by rw [huv, sub_self, zero_mul, zero_add]
      rw [h_sub]
      exact Ideal.mul_mem_right x₀ m (m.neg_mem hv)
    have h_coset : ∀ b : NumberField.RingOfIntegers F,
        (b ∈ J ∧ Ideal.Quotient.mk m b = r₀) ↔ b - b₀ ∈ J * m := by
      intro b
      rw [← Ideal.inf_eq_mul_of_isCoprime hJ_cop, Submodule.mem_inf,
        ← hb₀_m, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      refine and_congr ?_ Iff.rfl
      exact ⟨fun hb => J.sub_mem hb hb₀_J, fun hsub => by
        have h_eq : b = (b - b₀) + b₀ := (sub_add_cancel b b₀).symm
        rw [h_eq]
        exact J.add_mem hsub hb₀_J⟩
    let v₀ : Fin d → ℝ := Φ (NumberField.mixedEmbedding F (b₀ : F))
    refine ⟨v₀, fun S R hR => ?_⟩
    let I_Jm := FractionalIdeal.mk0 F ⟨J * m, hJm⟩
    let L_Jm := NumberField.mixedEmbedding.idealLattice F I_Jm
    have h_mem_L_iff : ∀ x : NumberField.mixedEmbedding.mixedSpace F,
        x ∈ L_Jm ↔ ∃ a ∈ J * m, NumberField.mixedEmbedding F (a : F) = x := by
      intro x
      rw [NumberField.mixedEmbedding.mem_idealLattice]
      constructor
      · rintro ⟨y', hy', rfl⟩
        dsimp only [I_Jm] at hy'
        rw [SetLike.mem_coe, FractionalIdeal.coe_mk0, FractionalIdeal.mem_coeIdeal] at hy'
        rcases hy' with ⟨a, haJm, rfl⟩
        exact ⟨a, haJm, rfl⟩
      · rintro ⟨a, haJm, rfl⟩
        refine ⟨(a : F), ?_, rfl⟩
        dsimp only [I_Jm]
        rw [SetLike.mem_coe, FractionalIdeal.coe_mk0, FractionalIdeal.mem_coeIdeal]
        exact ⟨a, haJm, rfl⟩
    have h_emb_inj : Function.Injective (fun a : NumberField.RingOfIntegers F =>
        NumberField.mixedEmbedding F (a : F)) := by
      intro a₁ a₂ h
      have h_alg : (a₁ : F) = (a₂ : F) := (RingHom.injective (NumberField.mixedEmbedding F)) h
      exact Subtype.ext h_alg
    have h_a_mem_iff : ∀ a : NumberField.RingOfIntegers F,
        a ∈ J * m ↔ NumberField.mixedEmbedding F (a : F) ∈ L_Jm := by
      intro a
      rw [h_mem_L_iff]
      exact ⟨fun ha => ⟨a, ha, rfl⟩, fun ⟨a', ha', h_eq⟩ => (h_emb_inj h_eq) ▸ ha'⟩
    let z_to_L : (Fin d → ℤ) ≃ ↥L_Jm :=
      Finsupp.equivFunOnFinite.symm.trans b_Z.repr.symm.toEquiv
    have hz_repr : ∀ (z : Fin d → ℤ) (i : Fin d), b_Z.repr (z_to_L z) i = z i := by
      intro z i
      change b_Z.repr (b_Z.repr.symm (Finsupp.equivFunOnFinite.symm z)) i = z i
      rw [LinearEquiv.apply_symm_apply]
      rfl
    have hL_repr : ∀ x : ↥L_Jm, z_to_L (fun i => b_Z.repr x i) = x := by
      intro x
      change b_Z.repr.symm (Finsupp.equivFunOnFinite.symm (Finsupp.equivFunOnFinite (b_Z.repr x))) = x
      rw [Equiv.symm_apply_apply, LinearEquiv.symm_apply_apply]
    have h_inv_exist : ∀ z : Fin d → ℤ,
        ∃ a : NumberField.RingOfIntegers F, a ∈ J * m ∧
          NumberField.mixedEmbedding F (a : F) = (z_to_L z).1 := by
      intro z
      exact (h_mem_L_iff (z_to_L z).1).mp (z_to_L z).2
    choose a_of_z ha_of_z_mem ha_of_z_eq using h_inv_exist
    have h_Φ_shift : ∀ (b : NumberField.RingOfIntegers F) (hb : b - b₀ ∈ J * m),
        let x : ↥L_Jm := ⟨NumberField.mixedEmbedding F ((b - b₀ : NumberField.RingOfIntegers F) : F),
          (h_a_mem_iff (b - b₀)).mp hb⟩
        Φ (R⁻¹ • NumberField.mixedEmbedding F (b : F)) =
          fun i : Fin d => ((b_Z.repr x i : ℝ) + v₀ i) / R := by
      intro b hb x
      ext i
      have h_b_eq : (b : F) = ((b - b₀ : NumberField.RingOfIntegers F) : F) + (b₀ : F) := by
        push_cast
        ring
      have h_emb_add : NumberField.mixedEmbedding F (b : F) =
          (x : NumberField.mixedEmbedding.mixedSpace F) + NumberField.mixedEmbedding F (b₀ : F) := by
        rw [h_b_eq, map_add]
      rw [map_smul, Pi.smul_apply, h_emb_add, map_add, Pi.add_apply, hΦ_repr x i, smul_eq_mul, inv_mul_eq_div]
    let e_bij : { b : NumberField.RingOfIntegers F //
        b ∈ J ∧ Ideal.Quotient.mk m b = r₀ ∧ R⁻¹ • NumberField.mixedEmbedding F (b : F) ∈ S } ≃
      { z : Fin d → ℤ // (fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Φ '' S } :=
      { toFun := fun ⟨b, hbJ, hbm, hbS⟩ =>
          have hb_sub : b - b₀ ∈ J * m := (h_coset b).mp ⟨hbJ, hbm⟩
          let x : ↥L_Jm := ⟨NumberField.mixedEmbedding F ((b - b₀ : NumberField.RingOfIntegers F) : F),
            (h_a_mem_iff (b - b₀)).mp hb_sub⟩
          ⟨fun i => b_Z.repr x i, by
            rw [← h_Φ_shift b hb_sub]
            exact ⟨R⁻¹ • NumberField.mixedEmbedding F (b : F), hbS, rfl⟩⟩
        invFun := fun ⟨z, hz⟩ =>
          let b : NumberField.RingOfIntegers F := a_of_z z + b₀
          have hb_sub : b - b₀ ∈ J * m := by
            dsimp [b]
            rw [add_sub_cancel_right]
            exact ha_of_z_mem z
          have hx_eq : (⟨NumberField.mixedEmbedding F ((b - b₀ : NumberField.RingOfIntegers F) : F),
              (h_a_mem_iff (b - b₀)).mp hb_sub⟩ : ↥L_Jm) = z_to_L z := by
            apply Subtype.ext
            dsimp [b]
            rw [add_sub_cancel_right]
            exact ha_of_z_eq z
          have h_shift_z : Φ (R⁻¹ • NumberField.mixedEmbedding F (b : F)) =
              fun i : Fin d => ((z i : ℝ) + v₀ i) / R := by
            rw [h_Φ_shift b hb_sub]
            ext i
            rw [hx_eq, hz_repr z i]
          have hbS : R⁻¹ • NumberField.mixedEmbedding F (b : F) ∈ S := by
            rcases hz with ⟨w, hwS, hw_eq⟩
            rw [← h_shift_z] at hw_eq
            have hw := Φ.injective hw_eq
            rwa [← hw]
          have hbJm := (h_coset b).mpr hb_sub
          ⟨b, hbJm.1, hbJm.2, hbS⟩
        left_inv := fun ⟨b, hbJ, hbm, hbS⟩ => by
          apply Subtype.ext
          dsimp only
          have hb_sub : b - b₀ ∈ J * m := (h_coset b).mp ⟨hbJ, hbm⟩
          let x : ↥L_Jm := ⟨NumberField.mixedEmbedding F ((b - b₀ : NumberField.RingOfIntegers F) : F),
            (h_a_mem_iff (b - b₀)).mp hb_sub⟩
          have h_z_eq : z_to_L (fun i => b_Z.repr x i) = x := hL_repr x
          have h_emb : NumberField.mixedEmbedding F (a_of_z (fun i => b_Z.repr x i) : F) =
              NumberField.mixedEmbedding F ((b - b₀ : NumberField.RingOfIntegers F) : F) := by
            rw [ha_of_z_eq, h_z_eq]
          have h_a_eq : a_of_z (fun i => b_Z.repr x i) = b - b₀ := h_emb_inj h_emb
          rw [h_a_eq, sub_add_cancel]
        right_inv := fun ⟨z, hz⟩ => by
          apply Subtype.ext
          ext i
          dsimp only
          have h_sub_eq : a_of_z z + b₀ - b₀ = a_of_z z := add_sub_cancel_right (a_of_z z) b₀
          have hx_eq : (⟨NumberField.mixedEmbedding F ((a_of_z z + b₀ - b₀ : NumberField.RingOfIntegers F) : F),
              (h_a_mem_iff (a_of_z z + b₀ - b₀)).mp (h_sub_eq.symm ▸ ha_of_z_mem z)⟩ : ↥L_Jm) = z_to_L z := by
            apply Subtype.ext
            dsimp only
            rw [h_sub_eq, ha_of_z_eq z]
          rw [hx_eq, hz_repr z i] }
    exact Nat.card_congr e_bij

  have h_s3 :
      ∀ (L : Submodule ℤ (NumberField.mixedEmbedding.mixedSpace F))
        [DiscreteTopology ↥L] [IsZLattice ℝ L]
        (b : Module.Basis (Fin (Module.finrank ℚ F)) ℤ ↥L)
        (s : Set (NumberField.mixedEmbedding.mixedSpace F)),
        MeasureTheory.volume.real s =
          ZLattice.covolume L MeasureTheory.volume *
            MeasureTheory.volume.real ((Module.Basis.ofZLatticeBasis ℝ L b).equivFun '' s) := by
    intro L _ _ b s
    let d := Module.finrank ℚ F
    let μ : MeasureTheory.Measure (NumberField.mixedEmbedding.mixedSpace F) := MeasureTheory.volume
    let b_R : Module.Basis (Fin d) ℝ (NumberField.mixedEmbedding.mixedSpace F) :=
      Module.Basis.ofZLatticeBasis ℝ L b
    let Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin d → ℝ) :=
      b_R.equivFun.toContinuousLinearEquiv
    let e_meas : NumberField.mixedEmbedding.mixedSpace F ≃ᵐ (Fin d → ℝ) :=
      Φ.toHomeomorph.toMeasurableEquiv
    let μ_map : MeasureTheory.Measure (Fin d → ℝ) := MeasureTheory.Measure.map Φ μ
    haveI : μ_map.IsAddHaarMeasure := ContinuousLinearEquiv.isAddHaarMeasure_map Φ μ
    let c : NNReal := μ_map.addHaarScalarFactor MeasureTheory.volume
    have h_smul : μ_map = c • MeasureTheory.volume :=
      MeasureTheory.Measure.isAddLeftInvariant_eq_smul μ_map MeasureTheory.volume
    have h_prop : ∀ X : Set (NumberField.mixedEmbedding.mixedSpace F),
        μ.real X = (c : ℝ) * MeasureTheory.volume.real (b_R.equivFun '' X) := by
      intro X
      have h_map_X : μ_map (Φ '' X) = μ X := by
        change (MeasureTheory.Measure.map e_meas μ) (Φ '' X) = μ X
        rw [MeasurableEquiv.map_apply]
        change μ (⇑Φ ⁻¹' (⇑Φ '' X)) = μ X
        rw [Set.preimage_image_eq X Φ.injective]
      have h_real_X : μ.real X = (μ_map (Φ '' X)).toReal := by
        rw [MeasureTheory.measureReal_def, h_map_X]
      rw [h_real_X, h_smul, MeasureTheory.Measure.smul_apply, ENNReal.toReal_smul]
      rfl
    let X₀ : Set (NumberField.mixedEmbedding.mixedSpace F) := ZSpan.fundamentalDomain b_R
    have h_fund : MeasureTheory.IsAddFundamentalDomain L X₀ μ :=
      ZLattice.isAddFundamentalDomain b μ
    have h_lhs : μ.real X₀ = ZLattice.covolume L μ :=
      (ZLattice.covolume_eq_measure_fundamentalDomain L μ h_fund).symm
    have h_img_X₀ : b_R.equivFun '' X₀ = ZSpan.fundamentalDomain (b_R.map b_R.equivFun) :=
      ZSpan.map_fundamentalDomain b_R b_R.equivFun
    have h_mat_one : Matrix.of ⇑(b_R.map b_R.equivFun) = (1 : Matrix (Fin d) (Fin d) ℝ) := by
      ext i j
      rw [Matrix.of_apply, Module.Basis.map_apply, Module.Basis.equivFun_self, Matrix.one_apply]
    have h_rhs : MeasureTheory.volume.real (b_R.equivFun '' X₀) = 1 := by
      rw [h_img_X₀, ZSpan.volume_real_fundamentalDomain, h_mat_one, Matrix.det_one, abs_one]
    have hc_eq : (c : ℝ) = ZLattice.covolume L μ := by
      have h0 := h_prop X₀
      rw [h_lhs, h_rhs, mul_one] at h0
      exact h0.symm
    rw [h_prop s, hc_eq]

  let d := Module.finrank ℚ F
  let S : Set (NumberField.mixedEmbedding.mixedSpace F) :=
    { x ∈ NumberField.mixedEmbedding.fundamentalCone.normLeOne F |
      ∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
        decide (0 < x.1 w) = ε₀ w }
  let C_m : ℝ :=
    (Ideal.absNorm m : ℝ) * 2⁻¹ ^ (NumberField.InfinitePlace.nrComplexPlaces F) *
      Real.sqrt |(NumberField.discr F : ℝ)|
  have hm_pos : 0 < Ideal.absNorm m :=
    Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
      (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact hm))
  have hm_ne : (Ideal.absNorm m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hm_pos.ne'
  have h_pow_ne : (2⁻¹ : ℝ) ^ (NumberField.InfinitePlace.nrComplexPlaces F) ≠ 0 :=
    pow_ne_zero _ (inv_ne_zero two_ne_zero)
  have h_discr_ne : (NumberField.discr F : ℝ) ≠ 0 :=
    Int.cast_ne_zero.mpr (NumberField.discr_ne_zero F)
  have h_sqrt_ne : Real.sqrt |(NumberField.discr F : ℝ)| ≠ 0 :=
    (Real.sqrt_ne_zero (abs_nonneg _)).mpr (abs_ne_zero.mpr h_discr_ne)
  have hCm_ne : C_m ≠ 0 := mul_ne_zero (mul_ne_zero hm_ne h_pow_ne) h_sqrt_ne
  refine ⟨MeasureTheory.volume.real S / C_m, fun J hJ hJ_cop r₀ => ?_⟩
  have hJ0 : J ≠ 0 := by rw [Submodule.zero_eq_bot]; exact hJ
  have hm0 : m ≠ 0 := by rw [Submodule.zero_eq_bot]; exact hm
  have hJm_ne : J * m ≠ 0 := mul_ne_zero hJ0 hm0
  have hJm : J * m ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) :=
    mem_nonZeroDivisors_of_ne_zero hJm_ne
  let I_Jm := FractionalIdeal.mk0 F ⟨J * m, hJm⟩
  let L_Jm := NumberField.mixedEmbedding.idealLattice F I_Jm
  have h_rank : Fintype.card (Module.Free.ChooseBasisIndex ℤ ↥L_Jm) = d := by
    rw [← Module.finrank_eq_card_chooseBasisIndex, ZLattice.rank ℝ L_Jm,
      NumberField.mixedEmbedding.finrank F]
  let e_idx : Module.Free.ChooseBasisIndex ℤ ↥L_Jm ≃ Fin d :=
    Fintype.equivFinOfCardEq h_rank
  let b_Z : Module.Basis (Fin d) ℤ ↥L_Jm :=
    (Module.Free.chooseBasis ℤ ↥L_Jm).reindex e_idx
  let b_R : Module.Basis (Fin d) ℝ (NumberField.mixedEmbedding.mixedSpace F) :=
    Module.Basis.ofZLatticeBasis ℝ L_Jm b_Z
  let Φ : NumberField.mixedEmbedding.mixedSpace F ≃L[ℝ] (Fin d → ℝ) :=
    b_R.equivFun.toContinuousLinearEquiv
  let Ω : Set (Fin d → ℝ) := Φ '' S
  have hΦ_repr : ∀ (x : ↥L_Jm) (i : Fin d),
      Φ (x : NumberField.mixedEmbedding.mixedSpace F) i = (b_Z.repr x i : ℝ) := by
    intro x i
    change (b_R.repr (x : NumberField.mixedEmbedding.mixedSpace F)) i = (b_Z.repr x i : ℝ)
    exact Module.Basis.ofZLatticeBasis_repr_apply ℝ L_Jm b_Z x i
  obtain ⟨v₀, hv₀⟩ := h_s2 J hJm hJ_cop r₀ b_Z Φ hΦ_repr
  obtain ⟨hΩ_sub, hΩ_meas, hΩ_front, h_mem_S⟩ := h_s1 Φ
  refine ⟨Φ, Ω, v₀, hΩ_sub, hΩ_meas, hΩ_front, ?_, ?_⟩
  · have h_vol := h_s3 L_Jm b_Z S
    have h_cov := NumberField.mixedEmbedding.covolume_idealLattice F I_Jm
    have h_coe_I : (I_Jm : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) =
        ((J * m : Ideal (NumberField.RingOfIntegers F)) :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) :=
      FractionalIdeal.coe_mk0 F ⟨J * m, hJm⟩
    have h_norm : FractionalIdeal.absNorm
        (I_Jm : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) =
        (Ideal.absNorm J : ℚ) * (Ideal.absNorm m : ℚ) := by
      rw [h_coe_I, FractionalIdeal.coeIdeal_absNorm, map_mul, Nat.cast_mul]
    have h_cov_eq : ZLattice.covolume L_Jm MeasureTheory.volume =
        (Ideal.absNorm J : ℝ) * C_m := by
      dsimp [L_Jm, C_m]
      rw [h_cov, h_norm]
      push_cast
      ring
    change MeasureTheory.volume.real (b_R.equivFun '' S) * (Ideal.absNorm J : ℝ) =
      MeasureTheory.volume.real S / C_m
    rw [h_vol, h_cov_eq]
    have h_alg : ((Ideal.absNorm J : ℝ) * C_m * MeasureTheory.volume.real (b_R.equivFun '' S)) / C_m =
        C_m * (MeasureTheory.volume.real (b_R.equivFun '' S) * (Ideal.absNorm J : ℝ)) / C_m := by
      ring
    rw [h_alg, mul_div_cancel_left₀ _ hCm_ne]
  · intro R hR
    have h1 := hv₀ S R hR
    rw [← h1]
    refine Nat.card_congr (Equiv.subtypeEquivRight fun b => ?_)
    exact and_congr_right fun _ => and_congr_right fun _ => h_mem_S b R hR

theorem shifted_int_lattice_natCard_sub_le_of_frontier_lipschitz_cover (d : ℕ) (hd : 0 < d) (Ω : Set (Fin d → ℝ))
    (hBdd : Bornology.IsBounded Ω)
    (M : ℕ) (L_lip : ℝ) (hL : 0 ≤ L_lip)
    (γ : Fin M → (Fin (d - 1) → ℝ) → (Fin d → ℝ))
    (hLip : ∀ (m : Fin M) (u v : Fin (d - 1) → ℝ),
      (∀ j, u j ∈ Set.Icc (0 : ℝ) 1) →
      (∀ j, v j ∈ Set.Icc (0 : ℝ) 1) →
      ∀ i : Fin d,
        |γ m u i - γ m v i| ≤ L_lip * ∑ j : Fin (d - 1), |u j - v j|)
    (hFront : frontier Ω ⊆
      ⋃ m : Fin M, γ m '' { u : Fin (d - 1) → ℝ | ∀ j, u j ∈ Set.Icc (0 : ℝ) 1 })
    (v₀ : Fin d → ℝ) :
    ∃ B : ℝ, ∀ R : ℝ, 1 ≤ R →
      |(Nat.card { z : Fin d → ℤ // (fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω } : ℝ) -
        (Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } : ℝ)| ≤ B * R ^ (d - 1) :=
by
  classical
  have h_step1 : ∀ (R : ℝ), 0 < R → ∀ (z : Fin d → ℤ),
      (((fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω ∧ (fun i : Fin d => (z i : ℝ) / R) ∉ Ω) ∨
       ((fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∉ Ω ∧ (fun i : Fin d => (z i : ℝ) / R) ∈ Ω)) →
      ∃ w ∈ frontier Ω, ∀ i : Fin d, |(z i : ℝ) - R * w i| ≤ ‖v₀‖ := by
    intro R hR z hStraddle
    let K : Set (Fin d → ℝ) :=
      Set.univ.pi (fun i : Fin d => Set.Icc (((z i : ℝ) - |v₀ i|) / R) (((z i : ℝ) + |v₀ i|) / R))
    have hK_conv : Convex ℝ K := convex_pi (fun i _ => convex_Icc _ _)
    have hK_pre : IsPreconnected K := hK_conv.isPreconnected
    let p : Fin d → ℝ := fun i => (z i : ℝ) / R
    let q : Fin d → ℝ := fun i => ((z i : ℝ) + v₀ i) / R
    have hpK : p ∈ K := by
      intro i _
      have habs : 0 ≤ |v₀ i| := abs_nonneg (v₀ i)
      exact ⟨div_le_div_of_nonneg_right (by linarith) hR.le,
             div_le_div_of_nonneg_right (by linarith) hR.le⟩
    have hqK : q ∈ K := by
      intro i _
      have h1 : -|v₀ i| ≤ v₀ i := neg_abs_le (v₀ i)
      have h2 : v₀ i ≤ |v₀ i| := le_abs_self (v₀ i)
      exact ⟨div_le_div_of_nonneg_right (by linarith) hR.le,
             div_le_div_of_nonneg_right (by linarith) hR.le⟩
    have h_inter : (K ∩ frontier Ω).Nonempty := by
      by_contra h_empty
      rw [Set.not_nonempty_iff_eq_empty] at h_empty
      have hK_sub : K ⊆ interior Ω ∪ interior Ωᶜ := by
        intro x hx
        have hx_not_front : x ∉ frontier Ω := by
          intro hxf
          have : x ∈ K ∩ frontier Ω := ⟨hx, hxf⟩
          rw [h_empty] at this
          exact this
        have h_compl : (frontier Ω)ᶜ = interior Ω ∪ interior Ωᶜ := compl_frontier_eq_union_interior
        exact h_compl ▸ hx_not_front
      have h_disj : K ∩ (interior Ω ∩ interior Ωᶜ) = ∅ := by
        ext x
        simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
        intro _ hx1 hx2
        exact (interior_subset hx2) (interior_subset hx1)
      have h_or := isPreconnected_iff_subset_of_disjoint.mp hK_pre (interior Ω) (interior Ωᶜ)
        isOpen_interior isOpen_interior hK_sub h_disj
      rcases h_or with hK_in | hK_out
      · have hp_in : p ∈ Ω := interior_subset (hK_in hpK)
        have hq_in : q ∈ Ω := interior_subset (hK_in hqK)
        rcases hStraddle with ⟨_, hp_not⟩ | ⟨hq_not, _⟩
        · exact hp_not hp_in
        · exact hq_not hq_in
      · have hp_out : p ∉ Ω := interior_subset (hK_out hpK)
        have hq_out : q ∉ Ω := interior_subset (hK_out hqK)
        rcases hStraddle with ⟨hq_in, _⟩ | ⟨_, hp_in⟩
        · exact hq_out hq_in
        · exact hp_out hp_in
    rcases h_inter with ⟨w, hwK, hwF⟩
    refine ⟨w, hwF, fun i => ?_⟩
    have hwi := hwK i (Set.mem_univ i)
    have h1 : (z i : ℝ) - |v₀ i| ≤ R * w i := by
      have := (div_le_iff₀ hR).mp hwi.1
      linarith
    have h2 : R * w i ≤ (z i : ℝ) + |v₀ i| := by
      have := (le_div_iff₀ hR).mp hwi.2
      linarith
    have h_coord_norm : |v₀ i| ≤ ‖v₀‖ := by
      rw [← Real.norm_eq_abs]
      exact norm_le_pi_norm v₀ i
    rw [abs_le]
    constructor <;> linarith

  have h_step2 : ∀ (R : ℝ), 0 < R → ∀ (F_bdry : Finset (Fin d → ℤ)),
      (∀ z : Fin d → ℤ,
        (((fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω ∧ (fun i : Fin d => (z i : ℝ) / R) ∉ Ω) ∨
         ((fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∉ Ω ∧ (fun i : Fin d => (z i : ℝ) / R) ∈ Ω)) →
        z ∈ F_bdry) →
      |(Nat.card { z : Fin d → ℤ // (fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω } : ℝ) -
        (Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } : ℝ)| ≤ (F_bdry.card : ℝ) := by
    intro R hR F_bdry hCover
    obtain ⟨C, hC_pos, hC_le⟩ := hBdd.exists_pos_norm_le
    let B_nat : ℕ := Nat.ceil (R * C + ‖v₀‖)
    let B_int : ℤ := (B_nat : ℤ)
    let Box_in : Finset (Fin d → ℤ) :=
      Fintype.piFinset (fun _ : Fin d => Finset.Icc (-B_int) B_int)
    let F_shift : Finset (Fin d → ℤ) :=
      Box_in.filter (fun z => (fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω)
    let F_0 : Finset (Fin d → ℤ) :=
      Box_in.filter (fun z => (fun i : Fin d => (z i : ℝ) / R) ∈ Ω)
    have h_mem_shift : ∀ z : Fin d → ℤ,
        z ∈ F_shift ↔ (fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω := by
      intro z
      rw [Finset.mem_filter]
      refine ⟨fun h => h.2, fun hz => ⟨?_, hz⟩⟩
      rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_Icc]
      have h_norm_pt : ‖(fun j : Fin d => ((z j : ℝ) + v₀ j) / R)‖ ≤ C := hC_le _ hz
      have h_coord_le : ‖((z i : ℝ) + v₀ i) / R‖ ≤ C :=
        (norm_le_pi_norm (fun j : Fin d => ((z j : ℝ) + v₀ j) / R) i).trans h_norm_pt
      rw [Real.norm_eq_abs, abs_div, abs_of_pos hR, div_le_iff₀ hR] at h_coord_le
      have h_v0_le : |v₀ i| ≤ ‖v₀‖ := by
        rw [← Real.norm_eq_abs]
        exact norm_le_pi_norm v₀ i
      have h_coord_abs := abs_le.mp h_coord_le
      have h_v0_abs := abs_le.mp h_v0_le
      have h_ceil : R * C + ‖v₀‖ ≤ (B_nat : ℝ) := Nat.le_ceil (R * C + ‖v₀‖)
      have h_cast : (B_int : ℝ) = (B_nat : ℝ) := by exact_mod_cast rfl
      have h1 : ((-B_int : ℤ) : ℝ) ≤ (z i : ℝ) := by push_cast; linarith
      have h2 : (z i : ℝ) ≤ (B_int : ℝ) := by linarith
      exact ⟨Int.cast_le.mp h1, Int.cast_le.mp h2⟩
    have h_mem_0 : ∀ z : Fin d → ℤ,
        z ∈ F_0 ↔ (fun i : Fin d => (z i : ℝ) / R) ∈ Ω := by
      intro z
      rw [Finset.mem_filter]
      refine ⟨fun h => h.2, fun hz => ⟨?_, hz⟩⟩
      rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_Icc]
      have h_norm_pt : ‖(fun j : Fin d => (z j : ℝ) / R)‖ ≤ C := hC_le _ hz
      have h_coord_le : ‖(z i : ℝ) / R‖ ≤ C :=
        (norm_le_pi_norm (fun j : Fin d => (z j : ℝ) / R) i).trans h_norm_pt
      rw [Real.norm_eq_abs, abs_div, abs_of_pos hR, div_le_iff₀ hR] at h_coord_le
      have h_v0_nonneg : 0 ≤ ‖v₀‖ := norm_nonneg v₀
      have h_le_B : |(z i : ℝ)| ≤ (B_int : ℝ) := by
        have h_ceil : R * C + ‖v₀‖ ≤ (B_nat : ℝ) := Nat.le_ceil (R * C + ‖v₀‖)
        have h_cast : (B_int : ℝ) = (B_nat : ℝ) := by exact_mod_cast rfl
        linarith
      have h_abs := abs_le.mp h_le_B
      have h1 : ((-B_int : ℤ) : ℝ) ≤ (z i : ℝ) := by push_cast; linarith
      have h2 : (z i : ℝ) ≤ (B_int : ℝ) := by linarith
      exact ⟨Int.cast_le.mp h1, Int.cast_le.mp h2⟩
    have h_card_shift : Nat.card { z : Fin d → ℤ // (fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω } = F_shift.card := by
      have e : { z : Fin d → ℤ // (fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω } ≃ { z : Fin d → ℤ // z ∈ F_shift } :=
        Equiv.subtypeEquivRight (fun z => (h_mem_shift z).symm)
      rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_coe]
    have h_card_0 : Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } = F_0.card := by
      have e : { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R) ∈ Ω } ≃ { z : Fin d → ℤ // z ∈ F_0 } :=
        Equiv.subtypeEquivRight (fun z => (h_mem_0 z).symm)
      rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_coe]
    have h_sub1 : F_shift ⊆ F_0 ∪ F_bdry := by
      intro z hz
      rw [Finset.mem_union]
      by_cases hz0 : z ∈ F_0
      · exact Or.inl hz0
      · exact Or.inr (hCover z (Or.inl ⟨(h_mem_shift z).mp hz, fun h => hz0 ((h_mem_0 z).mpr h)⟩))
    have h_sub2 : F_0 ⊆ F_shift ∪ F_bdry := by
      intro z hz
      rw [Finset.mem_union]
      by_cases hzs : z ∈ F_shift
      · exact Or.inl hzs
      · exact Or.inr (hCover z (Or.inr ⟨fun h => hzs ((h_mem_shift z).mpr h), (h_mem_0 z).mp hz⟩))
    have h_le1 : F_shift.card ≤ F_0.card + F_bdry.card :=
      (Finset.card_le_card h_sub1).trans (Finset.card_union_le _ _)
    have h_le2 : F_0.card ≤ F_shift.card + F_bdry.card :=
      (Finset.card_le_card h_sub2).trans (Finset.card_union_le _ _)
    have h_le1_real : (F_shift.card : ℝ) ≤ (F_0.card : ℝ) + (F_bdry.card : ℝ) := by
      exact_mod_cast h_le1
    have h_le2_real : (F_0.card : ℝ) ≤ (F_shift.card : ℝ) + (F_bdry.card : ℝ) := by
      exact_mod_cast h_le2
    rw [h_card_shift, h_card_0, abs_le]
    constructor <;> linarith

  have h_step3 : ∀ (R : ℝ), 1 ≤ R → ∀ (z : Fin d → ℤ) (w : Fin d → ℝ),
      w ∈ frontier Ω →
      (∀ i : Fin d, |(z i : ℝ) - R * w i| ≤ ‖v₀‖) →
      ∃ (m : Fin M) (k : Fin (d - 1) → Fin (Nat.ceil R)),
        ∀ i : Fin d,
          |(z i : ℝ) -
            R * γ m (fun j : Fin (d - 1) => ((k j : ℕ) : ℝ) / (Nat.ceil R : ℝ)) i| ≤
            ‖v₀‖ + L_lip * ((d - 1 : ℕ) : ℝ) := by
    intro R hR z w hw hzw
    have hw_cov := hFront hw
    rw [Set.mem_iUnion] at hw_cov
    rcases hw_cov with ⟨m, u, hu, rfl⟩
    let N := Nat.ceil R
    have hR_pos : 0 < R := by linarith
    have hN_pos : 0 < N := Nat.ceil_pos.mpr hR_pos
    have hN_real_pos : (0 : ℝ) < (N : ℝ) := Nat.cast_pos.mpr hN_pos
    have hR_le_N : R ≤ (N : ℝ) := Nat.le_ceil R
    let k : Fin (d - 1) → Fin N := fun j =>
      ⟨min (Int.floor (u j * (N : ℝ))).toNat (N - 1),
       Nat.lt_of_le_of_lt (Nat.min_le_right _ _) (Nat.sub_lt hN_pos zero_lt_one)⟩
    let v : Fin (d - 1) → ℝ := fun j => ((k j : ℕ) : ℝ) / (N : ℝ)
    have hv_mem : ∀ j : Fin (d - 1), v j ∈ Set.Icc (0 : ℝ) 1 := by
      intro j
      constructor
      · exact div_nonneg (Nat.cast_nonneg _) hN_real_pos.le
      · rw [div_le_one hN_real_pos]
        exact Nat.cast_le.mpr (le_of_lt (k j).2)
    have huv_diff : ∀ j : Fin (d - 1), |u j - v j| ≤ 1 / (N : ℝ) := by
      intro j
      have huj := hu j
      have huj0 : 0 ≤ u j := huj.1
      have huj1 : u j ≤ 1 := huj.2
      have h_mul_nonneg : 0 ≤ u j * (N : ℝ) := mul_nonneg huj0 hN_real_pos.le
      have h_floor_nonneg : 0 ≤ Int.floor (u j * (N : ℝ)) := Int.floor_nonneg.mpr h_mul_nonneg
      let a := (Int.floor (u j * (N : ℝ))).toNat
      have ha_cast : (a : ℝ) = (Int.floor (u j * (N : ℝ)) : ℝ) := by
        have : (a : ℤ) = Int.floor (u j * (N : ℝ)) := Int.toNat_of_nonneg h_floor_nonneg
        exact_mod_cast this
      have ha_le : (a : ℝ) ≤ u j * (N : ℝ) := by
        rw [ha_cast]
        exact Int.floor_le (u j * (N : ℝ))
      have h_lt_a_add : u j * (N : ℝ) < (a : ℝ) + 1 := by
        rw [ha_cast]
        exact Int.lt_floor_add_one (u j * (N : ℝ))
      have hk_bounds : ((k j : ℕ) : ℝ) ≤ u j * (N : ℝ) ∧ u j * (N : ℝ) ≤ ((k j : ℕ) : ℝ) + 1 := by
        change ((min a (N - 1) : ℕ) : ℝ) ≤ u j * (N : ℝ) ∧
          u j * (N : ℝ) ≤ ((min a (N - 1) : ℕ) : ℝ) + 1
        by_cases h_case : a ≤ N - 1
        · rw [Nat.min_eq_left h_case]
          exact ⟨ha_le, h_lt_a_add.le⟩
        · push_neg at h_case
          rw [Nat.min_eq_right h_case.le]
          have hN_sub_cast : ((N - 1 : ℕ) : ℝ) + 1 = (N : ℝ) := by
            exact_mod_cast Nat.sub_add_cancel hN_pos
          have h_uN_le_N : u j * (N : ℝ) ≤ (N : ℝ) := by nlinarith
          have h_N_le_a : N ≤ a := by omega
          have h_N_le_uN : (N : ℝ) ≤ u j * (N : ℝ) :=
            (Nat.cast_le.mpr h_N_le_a).trans ha_le
          constructor <;> linarith
      have hv_le_u : v j ≤ u j := by
        dsimp [v]
        rw [div_le_iff₀ hN_real_pos]
        exact hk_bounds.1
      have hu_le_v_add : u j ≤ v j + 1 / (N : ℝ) := by
        dsimp [v]
        rw [← add_div, le_div_iff₀ hN_real_pos]
        exact hk_bounds.2
      rw [abs_le]
      constructor <;> linarith
    refine ⟨m, k, fun i => ?_⟩
    have h_lip_i := hLip m u v hu hv_mem i
    have h_sum_le : (∑ j : Fin (d - 1), |u j - v j|) ≤ ((d - 1 : ℕ) : ℝ) / (N : ℝ) := by
      calc
        (∑ j : Fin (d - 1), |u j - v j|) ≤ ∑ _j : Fin (d - 1), (1 / (N : ℝ)) :=
          Finset.sum_le_sum (fun j _ => huv_diff j)
        _ = ((d - 1 : ℕ) : ℝ) * (1 / (N : ℝ)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        _ = ((d - 1 : ℕ) : ℝ) / (N : ℝ) := mul_one_div _ _
    have h_gamma_diff : |γ m u i - γ m v i| ≤ L_lip * (((d - 1 : ℕ) : ℝ) / (N : ℝ)) :=
      h_lip_i.trans (mul_le_mul_of_nonneg_left h_sum_le hL)
    have h_scaled_diff : |R * γ m u i - R * γ m v i| ≤ L_lip * ((d - 1 : ℕ) : ℝ) := by
      rw [← mul_sub, abs_mul, abs_of_pos hR_pos]
      calc
        R * |γ m u i - γ m v i| ≤ (N : ℝ) * (L_lip * (((d - 1 : ℕ) : ℝ) / (N : ℝ))) :=
          mul_le_mul hR_le_N h_gamma_diff (abs_nonneg _) hN_real_pos.le
        _ = L_lip * ((d - 1 : ℕ) : ℝ) * ((N : ℝ) / (N : ℝ)) := by ring
        _ = L_lip * ((d - 1 : ℕ) : ℝ) := by rw [div_self hN_real_pos.ne', mul_one]
    have h_tri : |(z i : ℝ) - R * γ m v i| ≤
        |(z i : ℝ) - R * γ m u i| + |R * γ m u i - R * γ m v i| := by
      have : (z i : ℝ) - R * γ m v i = ((z i : ℝ) - R * γ m u i) + (R * γ m u i - R * γ m v i) := by ring
      rw [this]
      exact abs_add_le _ _
    linarith [hzw i]

  have h_step4 : ∀ (N : ℕ) (Δ : ℝ), 0 ≤ Δ →
      ∀ (c : Fin M → (Fin (d - 1) → Fin N) → (Fin d → ℝ)),
        ∃ F : Finset (Fin d → ℤ),
          (∀ z : Fin d → ℤ,
            (∃ (m : Fin M) (k : Fin (d - 1) → Fin N),
              ∀ i : Fin d, |(z i : ℝ) - c m k i| ≤ Δ) →
            z ∈ F) ∧
          F.card ≤ M * (2 * Nat.ceil Δ + 2) ^ d * N ^ (d - 1) := by
    intro N Δ hΔ c
    let K := Nat.ceil Δ
    have hΔ_le_K : Δ ≤ (K : ℝ) := Nat.le_ceil Δ
    let Box : Fin M × (Fin (d - 1) → Fin N) → Finset (Fin d → ℤ) := fun p =>
      Fintype.piFinset (fun i : Fin d =>
        Finset.Icc (Int.floor (c p.1 p.2 i) - (K : ℤ)) (Int.floor (c p.1 p.2 i) + (K : ℤ) + 1))
    let F : Finset (Fin d → ℤ) := Finset.univ.biUnion Box
    refine ⟨F, ?_, ?_⟩
    · intro z ⟨m, k, hz⟩
      rw [Finset.mem_biUnion]
      refine ⟨(m, k), Finset.mem_univ _, ?_⟩
      rw [Fintype.mem_piFinset]
      intro i
      rw [Finset.mem_Icc]
      have hzi := abs_le.mp (hz i)
      have h_fl_le : (Int.floor (c m k i) : ℝ) ≤ c m k i := Int.floor_le (c m k i)
      have h_lt_fl : c m k i < (Int.floor (c m k i) : ℝ) + 1 := Int.lt_floor_add_one (c m k i)
      have h_low_real : ((Int.floor (c m k i) - (K : ℤ) : ℤ) : ℝ) ≤ (z i : ℝ) := by
        push_cast
        linarith
      have h_high_real : (z i : ℝ) ≤ ((Int.floor (c m k i) + (K : ℤ) + 1 : ℤ) : ℝ) := by
        push_cast
        linarith
      exact ⟨Int.cast_le.mp h_low_real, Int.cast_le.mp h_high_real⟩
    · have h_box_card : ∀ p : Fin M × (Fin (d - 1) → Fin N),
          (Box p).card = (2 * K + 2) ^ d := by
        intro p
        dsimp [Box]
        rw [Fintype.card_piFinset]
        have h_interval_card : ∀ i : Fin d,
            (Finset.Icc (Int.floor (c p.1 p.2 i) - (K : ℤ))
              (Int.floor (c p.1 p.2 i) + (K : ℤ) + 1)).card = 2 * K + 2 := by
          intro i
          rw [Int.card_Icc]
          have : Int.floor (c p.1 p.2 i) + (K : ℤ) + 1 + 1 - (Int.floor (c p.1 p.2 i) - (K : ℤ)) =
              ((2 * K + 2 : ℕ) : ℤ) := by
            push_cast
            ring
          rw [this, Int.toNat_natCast]
        simp_rw [h_interval_card]
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      calc
        F.card ≤ ∑ p ∈ (Finset.univ : Finset (Fin M × (Fin (d - 1) → Fin N))), (Box p).card :=
          Finset.card_biUnion_le
        _ = ∑ _p ∈ (Finset.univ : Finset (Fin M × (Fin (d - 1) → Fin N))), (2 * K + 2) ^ d := by
          refine Finset.sum_congr rfl (fun p _ => h_box_card p)
        _ = Fintype.card (Fin M × (Fin (d - 1) → Fin N)) * (2 * K + 2) ^ d := by
          rw [Finset.sum_const, Finset.card_univ, smul_eq_mul]
        _ = (M * N ^ (d - 1)) * (2 * K + 2) ^ d := by
          simp only [Fintype.card_prod, Fintype.card_fun, Fintype.card_fin]
        _ = M * (2 * K + 2) ^ d * N ^ (d - 1) := by ring

  let Δ : ℝ := ‖v₀‖ + L_lip * ((d - 1 : ℕ) : ℝ)
  have hΔ : 0 ≤ Δ := by positivity
  let K : ℕ := Nat.ceil Δ
  let B : ℝ := (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (2 : ℝ) ^ (d - 1)
  refine ⟨B, fun R hR => ?_⟩
  have hR_pos : 0 < R := by linarith
  let N : ℕ := Nat.ceil R
  let c : Fin M → (Fin (d - 1) → Fin N) → (Fin d → ℝ) :=
    fun m k i => R * γ m (fun j => ((k j : ℕ) : ℝ) / (N : ℝ)) i
  obtain ⟨F_bdry, hF_mem, hF_card⟩ := h_step4 N Δ hΔ c
  have hCover : ∀ z : Fin d → ℤ,
      (((fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∈ Ω ∧ (fun i : Fin d => (z i : ℝ) / R) ∉ Ω) ∨
       ((fun i : Fin d => ((z i : ℝ) + v₀ i) / R) ∉ Ω ∧ (fun i : Fin d => (z i : ℝ) / R) ∈ Ω)) →
      z ∈ F_bdry := by
    intro z hStraddle
    obtain ⟨w, hw_front, hzw⟩ := h_step1 R hR_pos z hStraddle
    obtain ⟨m, k, hmk⟩ := h_step3 R hR z w hw_front hzw
    exact hF_mem z ⟨m, k, hmk⟩
  have h_diff := h_step2 R hR_pos F_bdry hCover
  have h_card_real : (F_bdry.card : ℝ) ≤
      (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (N : ℝ) ^ (d - 1) := by
    exact_mod_cast hF_card
  have hN_le_2R : (N : ℝ) ≤ 2 * R := by
    have h_lt : (N : ℝ) < R + 1 := Nat.ceil_lt_add_one hR_pos.le
    linarith
  have hN_pow_le : (N : ℝ) ^ (d - 1) ≤ (2 : ℝ) ^ (d - 1) * R ^ (d - 1) := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (Nat.cast_nonneg N) hN_le_2R (d - 1)
  have h_bound_final :
      (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (N : ℝ) ^ (d - 1) ≤ B * R ^ (d - 1) := by
    dsimp [B]
    calc
      (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (N : ℝ) ^ (d - 1)
          ≤ (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * ((2 : ℝ) ^ (d - 1) * R ^ (d - 1)) :=
        mul_le_mul_of_nonneg_left hN_pow_le (by positivity)
      _ = (M : ℝ) * ((2 * K + 2 : ℕ) : ℝ) ^ d * (2 : ℝ) ^ (d - 1) * R ^ (d - 1) := by ring
  exact h_diff.trans (h_card_real.trans h_bound_final)

theorem principal_ray_dvd_natCard_sub_isBigO {F : Type u} [Field F] [NumberField F]
    (m J₁ J₂ : Ideal (NumberField.RingOfIntegers F))
    (hm : m ≠ ⊥)
    (hJ₁ : J₁ ≠ ⊥) (hJ₁_cop : IsCoprime J₁ m)
    (hJ₂ : J₂ ≠ ⊥) (hJ₂_cop : IsCoprime J₂ m) :
    (fun n : ℕ =>
      (Nat.card { P : Ideal (NumberField.RingOfIntegers F) //
        P ≠ ⊥ ∧
        (∃ a ∈ J₁,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          P = Ideal.span {a}) ∧
        Ideal.absNorm P ≤ n * Ideal.absNorm J₁ } : ℝ) -
      (Nat.card { P : Ideal (NumberField.RingOfIntegers F) //
        P ≠ ⊥ ∧
        (∃ a ∈ J₂,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          P = Ideal.span {a}) ∧
        Ideal.absNorm P ≤ n * Ideal.absNorm J₂ } : ℝ)) =O[Filter.atTop]
    (fun n : ℕ => (n : ℝ) ^ (1 - 1 / (Module.finrank ℚ F : ℝ))) :=
by
  classical
  let d : ℕ := Module.finrank ℚ F
  have hd_pos : 0 < d := Module.finrank_pos
  have hd_one_le : (1 : ℝ) ≤ (d : ℝ) := Nat.one_le_cast.mpr hd_pos
  have hd_real_pos : (0 : ℝ) < (d : ℝ) := by linarith
  have hd_real_ne : (d : ℝ) ≠ 0 := hd_real_pos.ne'
  let r_exp : ℝ := 1 - 1 / (d : ℝ)
  let w_F : ℕ := NumberField.Units.torsionOrder F
  have hw_pos : 0 < w_F := NumberField.Units.torsionOrder_pos F
  have hw_real_pos : (0 : ℝ) < (w_F : ℝ) := Nat.cast_pos.mpr hw_pos
  have hw_real_ne : (w_F : ℝ) ≠ 0 := hw_real_pos.ne'

  let N_cone : Ideal (NumberField.RingOfIntegers F) →
      (NumberField.RingOfIntegers F ⧸ m) →
      ({ w : NumberField.InfinitePlace F // w.IsReal } → Bool) → ℕ → ℕ :=
    fun J r₀ ε₀ n =>
      Nat.card { b : NumberField.RingOfIntegers F //
        b ∈ J ∧
        Ideal.Quotient.mk m b = r₀ ∧
        NumberField.mixedEmbedding F (b : F) ∈
          NumberField.mixedEmbedding.fundamentalCone F ∧
        (∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
          decide (0 < (w.1.embedding (b : F)).re) = ε₀ w) ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤
          (n : ℝ) * (Ideal.absNorm J : ℝ) }

  have h_cone_asymp :
      ∀ (ε₀ : { w : NumberField.InfinitePlace F // w.IsReal } → Bool),
        ∃ κ₀ : ℝ,
          ∀ (J : Ideal (NumberField.RingOfIntegers F)),
            J ≠ ⊥ → IsCoprime J m →
            ∀ (r₀ : NumberField.RingOfIntegers F ⧸ m),
              (fun n : ℕ => (N_cone J r₀ ε₀ n : ℝ) - κ₀ * (n : ℝ)) =O[Filter.atTop]
              (fun n : ℕ => (n : ℝ) ^ r_exp) := by
    intro ε₀
    obtain ⟨κ₀, h_orth⟩ :=
      exists_orthant_cone_natCard_eq_shifted_int_lattice_and_volume_eq m hm ε₀
    refine ⟨κ₀, fun J hJ hJ_cop r₀ => ?_⟩
    obtain ⟨Φ, Ω, v₀, hΩ_sub, hΩ_meas, hΩ_front, hΩ_vol, hΩ_card⟩ :=
      h_orth J hJ hJ_cop r₀
    obtain ⟨hBdd_full, _, M, L_lip, γ, hL, hLip, hFront_full⟩ :=
      normLeOne_image_bounded_measurable_and_frontier_lipschitz_cover Φ
    have hΩ_bdd : Bornology.IsBounded Ω := hBdd_full.subset hΩ_sub
    have hFront_Ω : frontier Ω ⊆
        ⋃ m_idx : Fin M, γ m_idx '' { u : Fin (d - 1) → ℝ | ∀ j, u j ∈ Set.Icc (0 : ℝ) 1 } :=
      hΩ_front.trans hFront_full
    obtain ⟨B₁, hB₁⟩ :=
      int_lattice_natCard_sub_volume_mul_pow_le_of_frontier_lipschitz_cover
        d hd_pos Ω hΩ_bdd hΩ_meas M L_lip hL γ hLip hFront_Ω
    obtain ⟨B₂, hB₂⟩ :=
      shifted_int_lattice_natCard_sub_le_of_frontier_lipschitz_cover
        d hd_pos Ω hΩ_bdd M L_lip hL γ hLip hFront_Ω v₀
    let m_J : ℕ := Ideal.absNorm J
    have hmJ_pos : 0 < m_J :=
      Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
        (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact hJ))
    have hmJ_one_le : (1 : ℝ) ≤ (m_J : ℝ) := Nat.one_le_cast.mpr hmJ_pos
    have hmJ_nonneg : (0 : ℝ) ≤ (m_J : ℝ) := Nat.cast_nonneg m_J
    refine Asymptotics.IsBigO.of_bound ((|B₂| + |B₁|) * (m_J : ℝ) ^ r_exp) ?_
    filter_upwards [Filter.eventually_ge_atTop 1] with n hn
    have hn_one_le : (1 : ℝ) ≤ (n : ℝ) := Nat.one_le_cast.mpr hn
    have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    let s_n : ℝ := (n : ℝ) * (m_J : ℝ)
    have hs_one_le : (1 : ℝ) ≤ s_n := one_le_mul_of_one_le_of_one_le hn_one_le hmJ_one_le
    have hs_nonneg : 0 ≤ s_n := mul_nonneg hn_nonneg hmJ_nonneg
    let R_n : ℝ := s_n ^ (1 / (d : ℝ))
    have h_inv_d_nonneg : 0 ≤ 1 / (d : ℝ) := div_nonneg zero_le_one hd_real_pos.le
    have hRn_one_le : 1 ≤ R_n := Real.one_le_rpow hs_one_le h_inv_d_nonneg
    have hRn_pos : 0 < R_n := lt_of_lt_of_le zero_lt_one hRn_one_le
    have hRn_pow_d : R_n ^ d = s_n := by
      calc
        R_n ^ d = R_n ^ (d : ℝ) := (Real.rpow_natCast R_n d).symm
        _ = s_n ^ ((1 / (d : ℝ)) * (d : ℝ)) := (Real.rpow_mul hs_nonneg (1 / (d : ℝ)) (d : ℝ)).symm
        _ = s_n ^ (1 : ℝ) := by rw [one_div_mul_cancel hd_real_ne]
        _ = s_n := Real.rpow_one s_n
    have hRn_pow_d_sub_one : R_n ^ (d - 1) = (m_J : ℝ) ^ r_exp * (n : ℝ) ^ r_exp := by
      calc
        R_n ^ (d - 1) = R_n ^ ((d - 1 : ℕ) : ℝ) := (Real.rpow_natCast R_n (d - 1)).symm
        _ = s_n ^ ((1 / (d : ℝ)) * ((d - 1 : ℕ) : ℝ)) :=
            (Real.rpow_mul hs_nonneg (1 / (d : ℝ)) ((d - 1 : ℕ) : ℝ)).symm
        _ = s_n ^ r_exp := by
            congr 1
            rw [one_div_mul_eq_div, Nat.cast_sub hd_pos, sub_div, div_self hd_real_ne]
            push_cast
            rfl
        _ = ((n : ℝ) * (m_J : ℝ)) ^ r_exp := rfl
        _ = (n : ℝ) ^ r_exp * (m_J : ℝ) ^ r_exp := Real.mul_rpow hn_nonneg hmJ_nonneg
        _ = (m_J : ℝ) ^ r_exp * (n : ℝ) ^ r_exp := mul_comm _ _
    have h_card_eq : N_cone J r₀ ε₀ n =
        Nat.card { z : Fin d → ℤ // (fun i : Fin d => ((z i : ℝ) + v₀ i) / R_n) ∈ Ω } := by
      dsimp only [N_cone]
      change Nat.card { b : NumberField.RingOfIntegers F //
          b ∈ J ∧
          Ideal.Quotient.mk m b = r₀ ∧
          NumberField.mixedEmbedding F (b : F) ∈
            NumberField.mixedEmbedding.fundamentalCone F ∧
          (∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
            decide (0 < (w.1.embedding (b : F)).re) = ε₀ w) ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding F (b : F)) ≤ s_n } = _
      rw [← hRn_pow_d]
      exact hΩ_card R_n hRn_pos
    have h_card_cast : (N_cone J r₀ ε₀ n : ℝ) =
        (Nat.card { z : Fin d → ℤ // (fun i : Fin d => ((z i : ℝ) + v₀ i) / R_n) ∈ Ω } : ℝ) := by
      exact_mod_cast h_card_eq
    have h_vol_Rn : MeasureTheory.volume.real Ω * R_n ^ d = κ₀ * (n : ℝ) := by
      rw [hRn_pow_d]
      dsimp only [s_n, m_J]
      calc
        MeasureTheory.volume.real Ω * ((n : ℝ) * (Ideal.absNorm J : ℝ))
            = (MeasureTheory.volume.real Ω * (Ideal.absNorm J : ℝ)) * (n : ℝ) := by ring
        _ = κ₀ * (n : ℝ) := by rw [hΩ_vol]
    have h_b1 := hB₁ R_n hRn_one_le
    have h_b2 := hB₂ R_n hRn_one_le
    rw [← h_card_cast] at h_b2
    rw [h_vol_Rn] at h_b1
    have h_tri : |(N_cone J r₀ ε₀ n : ℝ) - κ₀ * (n : ℝ)| ≤
        (B₂ + B₁) * R_n ^ (d - 1) := by
      have h_abs := abs_sub_le
        (N_cone J r₀ ε₀ n : ℝ)
        (Nat.card { z : Fin d → ℤ // (fun i : Fin d => (z i : ℝ) / R_n) ∈ Ω } : ℝ)
        (κ₀ * (n : ℝ))
      linarith
    have h_le_abs : (B₂ + B₁) * R_n ^ (d - 1) ≤ (|B₂| + |B₁|) * R_n ^ (d - 1) := by
      have h_nonneg_pow : 0 ≤ R_n ^ (d - 1) := pow_nonneg hRn_pos.le (d - 1)
      exact mul_le_mul_of_nonneg_right (add_le_add (le_abs_self B₂) (le_abs_self B₁)) h_nonneg_pow
    have h_comb := h_tri.trans h_le_abs
    rw [hRn_pow_d_sub_one, ← mul_assoc] at h_comb
    rw [Real.norm_eq_abs, Real.norm_of_nonneg (Real.rpow_nonneg hn_nonneg r_exp)]
    exact h_comb

  obtain ⟨k, r_cls, ε_cls, h_adm_sum⟩ :=
    exists_admissible_ray_classes_natCard_mul_torsionOrder_eq_sum m hm
  have h_diff_i : ∀ i : Fin k,
      (fun n : ℕ =>
        (N_cone J₁ (r_cls i) (ε_cls i) n : ℝ) -
        (N_cone J₂ (r_cls i) (ε_cls i) n : ℝ)) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ r_exp) := by
    intro i
    obtain ⟨κ_i, hκ_i⟩ := h_cone_asymp (ε_cls i)
    have h1 := hκ_i J₁ hJ₁ hJ₁_cop (r_cls i)
    have h2 := hκ_i J₂ hJ₂ hJ₂_cop (r_cls i)
    have h_sub := h1.sub h2
    refine h_sub.congr' (Filter.Eventually.of_forall fun n => ?_) Filter.EventuallyEq.rfl
    dsimp only
    ring
  have h_sum_diff :
      (fun n : ℕ =>
        ∑ i : Fin k,
          ((N_cone J₁ (r_cls i) (ε_cls i) n : ℝ) -
           (N_cone J₂ (r_cls i) (ε_cls i) n : ℝ))) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ r_exp) :=
    Asymptotics.IsBigO.sum (fun i _ => h_diff_i i)
  have h_mul := h_sum_diff.const_mul_left (w_F : ℝ)⁻¹
  refine h_mul.congr' (Filter.Eventually.of_forall fun n => ?_) Filter.EventuallyEq.rfl
  dsimp only
  have h_sum1 :
      (Nat.card { P : Ideal (NumberField.RingOfIntegers F) //
        P ≠ ⊥ ∧
        (∃ a ∈ J₁,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          P = Ideal.span {a}) ∧
        Ideal.absNorm P ≤ n * Ideal.absNorm J₁ } : ℝ) * (w_F : ℝ) =
      ∑ i : Fin k, (N_cone J₁ (r_cls i) (ε_cls i) n : ℝ) := by
    have h1 := congrArg (Nat.cast : ℕ → ℝ) (h_adm_sum J₁ n)
    rw [Nat.cast_mul, Nat.cast_sum] at h1
    exact h1
  have h_sum2 :
      (Nat.card { P : Ideal (NumberField.RingOfIntegers F) //
        P ≠ ⊥ ∧
        (∃ a ∈ J₂,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          P = Ideal.span {a}) ∧
        Ideal.absNorm P ≤ n * Ideal.absNorm J₂ } : ℝ) * (w_F : ℝ) =
      ∑ i : Fin k, (N_cone J₂ (r_cls i) (ε_cls i) n : ℝ) := by
    have h2 := congrArg (Nat.cast : ℕ → ℝ) (h_adm_sum J₂ n)
    rw [Nat.cast_mul, Nat.cast_sum] at h2
    exact h2
  rw [Finset.sum_sub_distrib, ← h_sum1, ← h_sum2, ← sub_mul,
    inv_mul_eq_div, mul_div_cancel_right₀ _ hw_real_ne]

theorem eventually_re_prime_sum_le_of_narrow_ray_char_sum_zero {K : Type u} [Field K] [NumberField K]
    (𝔪 : Ideal (NumberField.RingOfIntegers K))
    (h𝔪_ne : 𝔪 ≠ ⊥)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers K))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) 𝔪)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers K),
      I ≠ ⊥ → IsCoprime I 𝔪 →
      ∃ j : Fin N_ray,
        ∃ α : NumberField.RingOfIntegers K,
          α - 1 ∈ 𝔪 ∧
          (∀ w : NumberField.InfinitePlace K,
            w.IsReal → 0 < (w.embedding (α : K)).re) ∧
          I * J_all j = Ideal.span {α})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ α : NumberField.RingOfIntegers K,
        α - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal → 0 < (w.embedding (α : K)).re) ∧
        I * J_all j₁ = Ideal.span {α}) →
      (∃ α : NumberField.RingOfIntegers K,
        α - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal → 0 < (w.embedding (α : K)).re) ∧
        I * J_all j₂ = Ideal.span {α}) →
      j₁ = j₂)
    (ϕ : Ideal (NumberField.RingOfIntegers K) → ℂ)
    (hϕ_top : ϕ ⊤ = 1)
    (hϕ_norm : ∀ J : Ideal (NumberField.RingOfIntegers K), ‖ϕ J‖ ≤ 1)
    (hϕ_mul : ∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
      J₁ ≠ ⊥ → J₂ ≠ ⊥ → ϕ (J₁ * J₂) = ϕ J₁ * ϕ J₂)
    (hϕ_not_cop : ∀ J : Ideal (NumberField.RingOfIntegers K), ¬ IsCoprime J 𝔪 → ϕ J = 0)
    (hϕ_cell : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (j : Fin N_ray),
      I ≠ ⊥ →
      (∃ α : NumberField.RingOfIntegers K,
        α - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal → 0 < (w.embedding (α : K)).re) ∧
        I * J_all j = Ideal.span {α}) →
      ϕ I = (ϕ (J_all j))⁻¹)
    (hϕ_sum : (∑ j : Fin N_ray, (ϕ (J_all j))⁻¹) = 0) :
    ∃ M : ℝ, ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
      Summable (fun P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) =>
        ϕ P.asIdeal *
          (((Nat.card (NumberField.RingOfIntegers K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)) ∧
      (∑' P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ϕ P.asIdeal *
          (((Nat.card (NumberField.RingOfIntegers K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)).re ≤ M :=
by
  classical
  let R_K := NumberField.RingOfIntegers K
  let ι := IsDedekindDomain.HeightOneSpectrum R_K
  let I : (ι →₀ ℕ) → Ideal R_K := fun f => f.prod (fun P m => P.asIdeal ^ m)
  let N_prod : (ι →₀ ℕ) → ℕ :=
    fun f => f.prod (fun P m => (Nat.card (R_K ⧸ P.asIdeal)) ^ m)
  let A : (ι →₀ ℕ) → ℂ := fun f => f.prod (fun P m => (ϕ P.asIdeal) ^ m)
  let PrinCount : Fin N_ray → ℕ → ℕ := fun j n =>
    Nat.card { P : Ideal R_K //
      P ≠ ⊥ ∧
      (∃ a ∈ J_all j,
        a - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal → 0 < (w.embedding (a : K)).re) ∧
        P = Ideal.span {a}) ∧
      Ideal.absNorm P ≤ n * Ideal.absNorm (J_all j) }
  
  have h_s1 : ∀ n : ℕ,
      (∑ k ∈ Finset.Icc 1 n,
        (∑' f : { f : ι →₀ ℕ // N_prod f = k }, A f.val)) =
      ∑ j : Fin N_ray, (ϕ (J_all j))⁻¹ * (PrinCount j n : ℂ) := by
    intro n
    have h_pow_ne_bot : ∀ (P : ι) (m : ℕ), P.asIdeal ^ m ≠ ⊥ := by
      intro P m
      rw [← Submodule.zero_eq_bot]
      exact pow_ne_zero m (by rw [Submodule.zero_eq_bot]; exact P.ne_bot)
    have hϕ_pow : ∀ (P : ι) (m : ℕ), ϕ (P.asIdeal ^ m) = (ϕ P.asIdeal) ^ m := by
      intro P m
      induction m with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top, hϕ_top, pow_zero]
      | succ m ih =>
        rw [pow_succ, hϕ_mul (P.asIdeal ^ m) P.asIdeal (h_pow_ne_bot P m) P.ne_bot,
          ih, pow_succ]
    have h_finset_prod_ne_bot : ∀ (s : Finset ι) (g : ι → ℕ),
        (∏ P ∈ s, P.asIdeal ^ g P) ≠ ⊥ := by
      intro s g
      rw [← Submodule.zero_eq_bot]
      apply Finset.prod_ne_zero_iff.mpr
      intro P _
      rw [Submodule.zero_eq_bot]
      exact h_pow_ne_bot P (g P)
    have hϕ_finset_prod : ∀ (s : Finset ι) (g : ι → ℕ),
        ϕ (∏ P ∈ s, P.asIdeal ^ g P) = ∏ P ∈ s, (ϕ P.asIdeal) ^ g P := by
      intro s g
      refine Finset.induction_on s ?_ ?_
      · rw [Finset.prod_empty, Ideal.one_eq_top, hϕ_top, Finset.prod_empty]
      · intro P s hP_not_mem ih
        rw [Finset.prod_insert hP_not_mem,
          hϕ_mul (P.asIdeal ^ g P) (∏ P' ∈ s, P'.asIdeal ^ g P')
            (h_pow_ne_bot P (g P)) (h_finset_prod_ne_bot s g),
          hϕ_pow P (g P), ih, Finset.prod_insert hP_not_mem]
    have h_prod_ne_bot : ∀ f : ι →₀ ℕ, I f ≠ ⊥ :=
      fun f => h_finset_prod_ne_bot f.support f
    have hA_eq_ϕ : ∀ f : ι →₀ ℕ, A f = ϕ (I f) :=
      fun f => (hϕ_finset_prod f.support f).symm
    have hAbsNorm : ∀ J : Ideal R_K, Ideal.absNorm J = Nat.card (R_K ⧸ J) := by
      intro J
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    have h_norm_prod : ∀ f : ι →₀ ℕ, Ideal.absNorm (I f) = N_prod f := by
      intro f
      unfold I N_prod Finsupp.prod
      rw [map_prod]
      simp only [map_pow]
      simp only [hAbsNorm]
    have hN_P_pos : ∀ P : ι, 0 < Nat.card (R_K ⧸ P.asIdeal) := by
      intro P
      rw [← hAbsNorm]
      exact Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
        (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact P.ne_bot))
    have hN_prod_pos : ∀ f : ι →₀ ℕ, 0 < N_prod f := by
      intro f
      unfold N_prod Finsupp.prod
      exact Finset.prod_pos (fun P _ => pow_pos (hN_P_pos P) (f P))
    have hasIdeal_inj : Function.Injective
        (IsDedekindDomain.HeightOneSpectrum.asIdeal : ι → Ideal R_K) :=
      fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
    have h_toMultiset_prod : ∀ f : ι →₀ ℕ,
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod = I f := by
      intro f
      unfold I
      rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
        Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
    have h_normFactors : ∀ f : ι →₀ ℕ,
        UniqueFactorizationMonoid.normalizedFactors (I f) =
          Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f) := by
      intro f
      rw [← h_toMultiset_prod f]
      apply UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
      intro p hp
      rw [Multiset.mem_map] at hp
      rcases hp with ⟨P, _, rfl⟩
      exact P.prime
    have hI_inj : Function.Injective I := by
      intro f₁ f₂ hval
      have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hval
      rw [h_normFactors f₁, h_normFactors f₂] at hnf
      have htm : Finsupp.toMultiset f₁ = Finsupp.toMultiset f₂ :=
        Multiset.map_injective hasIdeal_inj hnf
      have htf := congrArg Multiset.toFinsupp htm
      simpa only [Finsupp.toMultiset_toFinsupp] using htf
    let Φ : (ι →₀ ℕ) → { J : Ideal R_K // J ≠ ⊥ } :=
      fun f => ⟨I f, h_prod_ne_bot f⟩
    have hΦ_inj : Function.Injective Φ := by
      intro f₁ f₂ h
      exact hI_inj (congrArg Subtype.val h)
    have hΦ_surj : Function.Surjective Φ := by
      rintro ⟨J, hJ⟩
      let N := UniqueFactorizationMonoid.normalizedFactors J
      let m : Multiset ι :=
        Multiset.pmap
          (fun (p : Ideal R_K) (hp : Prime p) =>
            IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
          N
          (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
      let f : ι →₀ ℕ := Multiset.toFinsupp m
      refine ⟨f, Subtype.ext ?_⟩
      change I f = J
      rw [← h_toMultiset_prod f]
      have hfm : Finsupp.toMultiset f = m := Multiset.toFinsupp_toMultiset m
      rw [hfm]
      have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m = N := by
        dsimp [m]
        rw [Multiset.map_pmap]
        simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
          Multiset.pmap_eq_map, Multiset.map_id']
      rw [hmap]
      exact prod_normalizedFactors_eq_self hJ
    let e_ufm : (ι →₀ ℕ) ≃ { J : Ideal R_K // J ≠ ⊥ } :=
      Equiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩
    have he_ufm_symm : ∀ (J : Ideal R_K) (hJ : J ≠ ⊥),
