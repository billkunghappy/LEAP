        have h_dvdD : Q ∣ D_ML := by
          simpa using pow_sub_one_dvd_differentIdeal (NumberField.RingOfIntegers L) Q 2 P.ne_bot h_dvd2
        have h_rel_dvd : Ideal.relNorm (NumberField.RingOfIntegers L) Q ∣ I₁ :=
