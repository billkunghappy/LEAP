      · rintro ⟨f, hf⟩ w hw
        have h_eval := congrFun hf (s w)
        change N_P f (s w) = h (π (s w)) at h_eval
        rw [hN_formula f (s w), hs w, if_pos hw] at h_eval
        exact ⟨∑ v ∈ Finset.univ.filter (fun v => π v = w), f v, h_eval.symm⟩
      · intro h_div
        have h_div_c : ∀ w : NumberField.InfinitePlace F,
            ((if P_ram w then 2 else 1 : ℕ) : ℤ) ∣ h w := by
          intro w
          split_ifs with hw
          · exact h_div w hw
          · exact one_dvd (h w)
        choose q hq using h_div_c
        let f : NumberField.InfinitePlace E → ℤ :=
          fun v => if v = s (π v) then q (π v) else 0
        refine ⟨f, ?_⟩
        ext w_E
        change N_P f w_E = h (π w_E)
        rw [hN_formula f w_E]
        have h_sum_single :
            (∑ v ∈ Finset.univ.filter (fun v : NumberField.InfinitePlace E => π v = π w_E), f v) =
              q (π w_E) := by
          rw [Finset.sum_eq_single (s (π w_E))]
          · dsimp [f]
            rw [hs (π w_E), if_pos rfl]
          · intro v hv hv_ne
            have hv_eq : π v = π w_E := (Finset.mem_filter.mp hv).2
            dsimp [f]
            rw [hv_eq, if_neg hv_ne]
          · intro h_not_mem
            exfalso
            apply h_not_mem
            rw [Finset.mem_filter]
            exact ⟨Finset.mem_univ _, hs (π w_E)⟩
        rw [h_sum_single, ← hq (π w_E)]
    exact ⟨hα_per, hP_range, h_comap_d, h_comap_N⟩
  have h_s4 : ∀ {ι : Type u} [Fintype ι] (d : ℕ) (_hd : 0 < d) (P : ι → Prop)
      (L_d L_2 : AddSubgroup (ι → ℤ))
      (_hL_d : ∀ h : ι → ℤ, h ∈ L_d ↔ ∀ w : ι, (d : ℤ) ∣ h w)
      (_hL_2 : ∀ h : ι → ℤ, h ∈ L_2 ↔ ∀ w : ι, P w → (2 : ℤ) ∣ h w),
      L_d.index = d ^ (Fintype.card ι) ∧
      L_2.index = 2 ^ (Nat.card { w : ι // P w }) := by
    intro ι _ d hd P L_d L_2 hL_d hL_2
    constructor
    · haveI : NeZero d := ⟨hd.ne'⟩
      let Φ_d : (ι → ℤ) →+ (ι → ZMod d) :=
        { toFun := fun h w => (h w : ZMod d)
          map_zero' := by ext w; simp
          map_add' := by intro h₁ h₂; ext w; simp }
      have h_ker_d : L_d = Φ_d.ker := by
        ext h
        rw [hL_d h, AddMonoidHom.mem_ker, funext_iff]
        refine forall_congr' fun w => ?_
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd (h w) d).symm
      have h_surj_d : Function.Surjective Φ_d := by
        intro g
        refine ⟨fun w => ((g w).val : ℤ), ?_⟩
        ext w
        change (((g w).val : ℤ) : ZMod d) = g w
        rw [Int.cast_natCast, ZMod.natCast_zmod_val]
      rw [h_ker_d, AddSubgroup.index_eq_card,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective Φ_d h_surj_d).toEquiv,
        Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card]
    · let Φ_2 : (ι → ℤ) →+ ({ w : ι // P w } → ZMod 2) :=
        { toFun := fun h w => (h w.1 : ZMod 2)
          map_zero' := by ext w; simp
          map_add' := by intro h₁ h₂; ext w; simp }
      have h_ker_2 : L_2 = Φ_2.ker := by
        ext h
        rw [hL_2 h, AddMonoidHom.mem_ker, funext_iff, Subtype.forall]
        refine forall_congr' fun w => forall_congr' fun _ => ?_
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd (h w) 2).symm
      have h_surj_2 : Function.Surjective Φ_2 := by
        intro g
        refine ⟨fun w => if hw : P w then ((g ⟨w, hw⟩).val : ℤ) else 0, ?_⟩
        ext ⟨w, hw⟩
        change ((if hw' : P w then ((g ⟨w, hw'⟩).val : ℤ) else 0 : ℤ) : ZMod 2) = g ⟨w, hw⟩
        rw [dif_pos hw, Int.cast_natCast, ZMod.natCast_zmod_val]
      rw [h_ker_2, AddSubgroup.index_eq_card,
        Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective Φ_2 h_surj_2).toEquiv,
        Nat.card_fun, Nat.card_zmod]
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  have hd : 0 < d := Nat.card_pos
  obtain ⟨hα_per, hP_range, h_comap_d, h_comap_N⟩ := h_s3
  obtain ⟨h_N_range, h_D_range, h_N_on_ker, h_inf_bot, h_T_inf⟩ :=
    h_s1 d hd (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E) hα_per
  let τ_P := LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E)
  let N_P := (∑ k : Fin d, τ_P ^ (k : ℕ)).toAddMonoidHom
  let D_P := (1 - τ_P).toAddMonoidHom
  let P_comap := (LinearMap.funLeft ℤ ℤ
    (fun w_E : NumberField.InfinitePlace E => w_E.comap (algebraMap F E))).toAddMonoidHom
  have h_diamond := h_s2 N_P D_P d h_N_range h_D_range h_N_on_ker h_inf_bot h_T_inf
  have h_rel_d : (AddSubgroup.map (nsmulAddMonoidHom d) D_P.ker).relIndex D_P.ker =
      (AddSubgroup.comap P_comap (AddSubgroup.map (nsmulAddMonoidHom d) D_P.ker)).index := by
    have h1 := AddSubgroup.relIndex_comap
      (AddSubgroup.map (nsmulAddMonoidHom d) D_P.ker) P_comap ⊤
    rw [AddSubgroup.relIndex_top_right, ← AddMonoidHom.range_eq_map, hP_range] at h1
    exact h1.symm
  have h_rel_N : N_P.range.relIndex D_P.ker =
      (AddSubgroup.comap P_comap N_P.range).index := by
    have h1 := AddSubgroup.relIndex_comap N_P.range P_comap ⊤
    rw [AddSubgroup.relIndex_top_right, ← AddMonoidHom.range_eq_map, hP_range] at h1
    exact h1.symm
  obtain ⟨h_idx_d, h_idx_2⟩ := h_s4 d hd
    (fun w : NumberField.InfinitePlace F =>
      w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal)
    (AddSubgroup.comap P_comap (AddSubgroup.map (nsmulAddMonoidHom d) D_P.ker))
    (AddSubgroup.comap P_comap N_P.range)
    h_comap_d h_comap_N
  rw [h_rel_d, h_rel_N, h_idx_d, h_idx_2] at h_diamond
  change ((N_P + D_P).range.index) *
      2 ^ (Nat.card { w : NumberField.InfinitePlace F //
        w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal }) =
    d ^ (2 * Fintype.card (NumberField.InfinitePlace F))
  rw [h_diamond, ← pow_mul, mul_comm (Fintype.card (NumberField.InfinitePlace F)) 2]

theorem unit_herbrand_quotient_of_cyclic_numberField {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ) :
    0 < Nat.card ((NumberField.RingOfIntegers F)ˣ ⧸
      (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).range) ∧
    Nat.card (E ≃ₐ[F] E) *
      Nat.card ((NumberField.RingOfIntegers F)ˣ ⧸
        (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).range) =
    Nat.card ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker ⧸
      ((MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
        Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).range.subgroupOf
        (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker)) *
      2 ^ (Nat.card { w : NumberField.InfinitePlace F //
        w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal }) :=
by
  obtain ⟨hι_inj, hι_range, h_gal, hQcoker_pos, hI_pos⟩ :=
    galois_fixed_units_and_intNorm_eq_prod_galRestrict_pow σ hCyclic
  have h_s2 := unit_coker_mul_log_ker_relIndex_eq_of_galRestrict_pow σ hι_inj hι_range h_gal
  have h_s3 := infinitePlace_int_pi_index_eq_mul_unit_log_relIndex_of_galRestrict_pow σ hι_inj hι_range h_gal
  have h_s4 := infinitePlace_int_pi_norm_add_diff_index_eq σ hCyclic
  refine ⟨hQcoker_pos, ?_⟩
  let d : ℕ := Nat.card (E ≃ₐ[F] E)
  let Q_coker : ℕ := Nat.card ((NumberField.RingOfIntegers F)ˣ ⧸
    (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).range)
  let Q_ker : ℕ := Nat.card ((Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker ⧸
    ((MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
      Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).range.subgroupOf
      (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))
  let I_pos : ℕ := (AddSubgroup.map (nsmulAddMonoidHom (Nat.card (E ≃ₐ[F] E)))
    (AddSubgroup.map (NumberField.Units.logEmbedding E)
      (Subgroup.toAddSubgroup
        (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
          Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))).relIndex
    (AddSubgroup.map (NumberField.Units.logEmbedding E)
      (Subgroup.toAddSubgroup
        (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
          Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom).ker))
  let I_neg : ℕ := (AddSubgroup.map (NumberField.Units.logEmbedding E)
    (Subgroup.toAddSubgroup
      (Subgroup.map
        (MonoidHom.id (NumberField.RingOfIntegers E)ˣ /
          Units.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ).toMonoidHom)
        (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))).relIndex
    (AddSubgroup.map (NumberField.Units.logEmbedding E)
      (Subgroup.toAddSubgroup
        (Units.map (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))).ker))
  let I_P : ℕ := (((∑ k : Fin (Nat.card (E ≃ₐ[F] E)),
      (LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E)) ^ (k : ℕ)) +
    (1 - LinearMap.funLeft ℤ ℤ (fun w_E : NumberField.InfinitePlace E => σ⁻¹ • w_E))).toAddMonoidHom).range.index
  let P_ram : ℕ := 2 ^ (Nat.card { w : NumberField.InfinitePlace F //
    w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal })
  change I_pos = d ^ (NumberField.Units.rank F) at hI_pos
  change Q_coker * I_neg = Q_ker * I_pos at h_s2
  change I_P = d * I_pos * I_neg at h_s3
  change I_P * P_ram = d ^ (2 * Fintype.card (NumberField.InfinitePlace F)) at h_s4
  change d * Q_coker = Q_ker * P_ram
  have h_rank_add : NumberField.Units.rank F + 1 = Fintype.card (NumberField.InfinitePlace F) := by
    change Fintype.card (NumberField.InfinitePlace F) - 1 + 1 = Fintype.card (NumberField.InfinitePlace F)
    exact Nat.sub_add_cancel Fintype.card_pos
  have h_d_I_pos : d * I_pos = d ^ (Fintype.card (NumberField.InfinitePlace F)) := by
    rw [hI_pos, ← pow_succ', h_rank_add]
  have h_sq : (d * I_pos) ^ 2 = I_P * P_ram := by
    rw [h_d_I_pos, h_s4, ← pow_mul, mul_comm]
  have h_mul_eq : (d * Q_coker) * (I_P * P_ram) = (Q_ker * P_ram) * (I_P * P_ram) := by
    calc
      (d * Q_coker) * (I_P * P_ram)
          = (d * Q_coker) * ((d * I_pos * I_neg) * P_ram) := by rw [h_s3]
      _ = d ^ 2 * I_pos * (Q_coker * I_neg) * P_ram := by ring
      _ = d ^ 2 * I_pos * (Q_ker * I_pos) * P_ram := by rw [h_s2]
      _ = (Q_ker * P_ram) * (d * I_pos) ^ 2 := by ring
      _ = (Q_ker * P_ram) * (I_P * P_ram) := by rw [h_sq]
  have hd_pos : 0 < d := Nat.card_pos
  have h_rhs_pos : 0 < I_P * P_ram := by
    rw [h_s4]
    exact pow_pos hd_pos _
  exact Nat.eq_of_mul_eq_mul_right h_rhs_pos h_mul_eq

theorem narrow_ray_partition_card_eq_classGroup_mul_isPrincipal_card {F : Type u} [Field F] [NumberField F]
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ j : Fin N_ray,
        ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j = Ideal.span {a})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₁ = Ideal.span {a}) →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₂ = Ideal.span {a}) →
      j₁ = j₂) :
    N_ray =
      Nat.card (ClassGroup (NumberField.RingOfIntegers F)) *
        Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } :=
by
  classical
  have h_mk0_mul_eq_one_of_span :
      ∀ (I J : Ideal (NumberField.RingOfIntegers F))
        (hI0 : I ≠ 0) (hJ0 : J ≠ 0) (a : NumberField.RingOfIntegers F),
        I * J = Ideal.span {a} →
        ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero hI0⟩ *
          ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJ0⟩ = 1 := by
    intro I J hI0 hJ0 a hIJ
    rw [← map_mul]
    exact (ClassGroup.mk0_eq_one_iff _).mpr ⟨⟨a, hIJ⟩⟩
  have h_mk0_mul3_eq_one_of_span :
      ∀ (I J L : Ideal (NumberField.RingOfIntegers F))
        (hI0 : I ≠ 0) (hJ0 : J ≠ 0) (hL0 : L ≠ 0) (a : NumberField.RingOfIntegers F),
        (I * J) * L = Ideal.span {a} →
        ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero hI0⟩ *
          ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJ0⟩ *
          ClassGroup.mk0 ⟨L, mem_nonZeroDivisors_of_ne_zero hL0⟩ = 1 := by
    intro I J L hI0 hJ0 hL0 a hIJL
    rw [← map_mul, ← map_mul]
    exact (ClassGroup.mk0_eq_one_iff _).mpr ⟨⟨a, hIJL⟩⟩
  have hJ0 : ∀ j : Fin N_ray, J_all j ≠ 0 := by
    intro j
    rw [Submodule.zero_eq_bot]
    exact (hJ_prop j).1
  have h_ex_π : ∃ π : Fin N_ray → ClassGroup (NumberField.RingOfIntegers F),
      (∀ j : Fin N_ray, π j = ClassGroup.mk0 ⟨J_all j, mem_nonZeroDivisors_of_ne_zero (hJ0 j)⟩) ∧
      (∀ j : Fin N_ray, π j = 1 ↔ (J_all j).IsPrincipal) := by
    refine ⟨fun j => ClassGroup.mk0 ⟨J_all j, mem_nonZeroDivisors_of_ne_zero (hJ0 j)⟩,
      fun _ => rfl,
      fun j => ClassGroup.mk0_eq_one_iff _⟩
  rcases h_ex_π with ⟨π, hπ_def, hπ_eq_one_iff⟩
  have h_ex_cop_rep : ∀ c : ClassGroup (NumberField.RingOfIntegers F),
      ∃ (K : Ideal (NumberField.RingOfIntegers F)) (hK0 : K ≠ 0),
        IsCoprime K m₀ ∧
        ClassGroup.mk0 ⟨K, mem_nonZeroDivisors_of_ne_zero hK0⟩ = c⁻¹ := by
    intro c
    by_cases hm₀_top : m₀ = ⊤
    · obtain ⟨K_nzd, hK_mk⟩ := ClassGroup.mk0_surjective c⁻¹
      have hK0 : (K_nzd : Ideal (NumberField.RingOfIntegers F)) ≠ 0 := nonZeroDivisors.ne_zero K_nzd.2
      have hK_cop : IsCoprime (K_nzd : Ideal (NumberField.RingOfIntegers F)) m₀ := by
        rw [hm₀_top, Ideal.isCoprime_iff_sup_eq, sup_top_eq]
      exact ⟨K_nzd.1, hK0, hK_cop, hK_mk⟩
    · obtain ⟨J_nzd, hJ_mk⟩ := ClassGroup.mk0_surjective c
      let J : Ideal (NumberField.RingOfIntegers F) := J_nzd.1
      have hJ_z : J ≠ 0 := nonZeroDivisors.ne_zero J_nzd.2
      have hm₀0 : m₀ ≠ 0 := by rwa [Submodule.zero_eq_bot]
      have hJm₀0 : J * m₀ ≠ 0 := mul_ne_zero hJ_z hm₀0
      have hJm₀_le : J * m₀ ≤ J := Ideal.mul_le_right
      obtain ⟨a, ha_sup⟩ := IsDedekindDomain.exists_sup_span_eq hJm₀_le hJm₀0
      have ha_le : Ideal.span {a} ≤ J := le_sup_right.trans ha_sup.le
      obtain ⟨K, hJK⟩ := Ideal.dvd_iff_le.mpr ha_le
      have h_mul_sup : J * (m₀ ⊔ K) = J * ⊤ := by
        rw [Submodule.mul_sup, ← hJK, ha_sup, Ideal.mul_top]
      have h_sup_top : m₀ ⊔ K = ⊤ := mul_left_cancel₀ hJ_z h_mul_sup
      have hK_cop : IsCoprime K m₀ := by
        rw [Ideal.isCoprime_iff_sup_eq, sup_comm]
        exact h_sup_top
      have hK_ne : K ≠ ⊥ := by
        intro hK_bot
        apply hm₀_top
        rw [hK_bot, sup_bot_eq] at h_sup_top
        exact h_sup_top
      have hK0 : K ≠ 0 := by rwa [Submodule.zero_eq_bot]
      have h_mul_one :
          ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJ_z⟩ *
            ClassGroup.mk0 ⟨K, mem_nonZeroDivisors_of_ne_zero hK0⟩ = 1 :=
        h_mk0_mul_eq_one_of_span J K hJ_z hK0 a hJK.symm
      rw [hJ_mk] at h_mul_one
      exact ⟨K, hK0, hK_cop, (mul_eq_one_iff_inv_eq.mp h_mul_one).symm⟩
  have h_ex_K_of :
      ∃ (K_of : ClassGroup (NumberField.RingOfIntegers F) → Ideal (NumberField.RingOfIntegers F))
        (hK0 : ∀ c, K_of c ≠ 0),
        (∀ c, IsCoprime (K_of c) m₀) ∧
        (∀ c, ClassGroup.mk0 ⟨K_of c, mem_nonZeroDivisors_of_ne_zero (hK0 c)⟩ = c⁻¹) := by
    choose K_of hK0 hK_cop hK_mk using h_ex_cop_rep
    exact ⟨K_of, hK0, hK_cop, hK_mk⟩
  rcases h_ex_K_of with ⟨K_of, hK0, hK_cop, hK_mk⟩
  have hKJ0 : ∀ (c : ClassGroup (NumberField.RingOfIntegers F)) (j : Fin N_ray),
      K_of c * J_all j ≠ 0 :=
    fun c j => mul_ne_zero (hK0 c) (hJ0 j)
  have hKJ_ne : ∀ (c : ClassGroup (NumberField.RingOfIntegers F)) (j : Fin N_ray),
      K_of c * J_all j ≠ ⊥ := by
    intro c j
    rw [← Submodule.zero_eq_bot]
    exact hKJ0 c j
  have hKJ_cop : ∀ (c : ClassGroup (NumberField.RingOfIntegers F)) (j : Fin N_ray),
      IsCoprime (K_of c * J_all j) m₀ :=
    fun c j => IsCoprime.mul_left (hK_cop c) (hJ_prop j).2
  have h_ex_τ :
      ∃ τ : ClassGroup (NumberField.RingOfIntegers F) → Fin N_ray → Fin N_ray,
        ∀ c j, ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          (K_of c * J_all j) * J_all (τ c j) = Ideal.span {a} := by
    choose τ hτ_cell using fun (c : ClassGroup (NumberField.RingOfIntegers F)) (j : Fin N_ray) =>
      hJ_cov (K_of c * J_all j) (hKJ_ne c j) (hKJ_cop c j)
    exact ⟨τ, hτ_cell⟩
  rcases h_ex_τ with ⟨τ, hτ_cell⟩
  have hτ_inv : ∀ (c : ClassGroup (NumberField.RingOfIntegers F)) (j : Fin N_ray),
      τ c (τ c j) = j := by
    intro c j
    rcases hτ_cell c j with ⟨a, ha_m, ha_pos, h_span⟩
    have h_symm : ∃ a' : NumberField.RingOfIntegers F,
        a' - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a' : F)).re) ∧
        (K_of c * J_all (τ c j)) * J_all j = Ideal.span {a'} := by
      refine ⟨a, ha_m, ha_pos, ?_⟩
      rw [mul_right_comm (K_of c) (J_all (τ c j)) (J_all j), h_span]
    exact hJ_inj (K_of c * J_all (τ c j)) (τ c (τ c j)) j
      (hKJ_ne c (τ c j)) (hτ_cell c (τ c j)) h_symm
  have hτ_cls : ∀ (c : ClassGroup (NumberField.RingOfIntegers F)) (j : Fin N_ray),
      c⁻¹ * π j * π (τ c j) = 1 := by
    intro c j
    rcases hτ_cell c j with ⟨a, _, _, h_span⟩
    have h1 := h_mk0_mul3_eq_one_of_span (K_of c) (J_all j) (J_all (τ c j))
      (hK0 c) (hJ0 j) (hJ0 (τ c j)) a h_span
    rw [hK_mk c, ← hπ_def j, ← hπ_def (τ c j)] at h1
    exact h1
  have hτ_to_prin : ∀ (c : ClassGroup (NumberField.RingOfIntegers F)) (u : Fin N_ray),
      π u = c → (J_all (τ c u)).IsPrincipal := by
    intro c u hu
    have h1 := hτ_cls c u
    rw [hu, inv_mul_cancel, one_mul] at h1
    exact (hπ_eq_one_iff (τ c u)).mp h1
  have hτ_to_fiber : ∀ (c : ClassGroup (NumberField.RingOfIntegers F)) (j : Fin N_ray),
      (J_all j).IsPrincipal → π (τ c j) = c := by
    intro c j hj
    have h1 := hτ_cls c j
    rw [(hπ_eq_one_iff j).mpr hj, mul_one] at h1
    exact (inv_mul_eq_one.mp h1).symm
  have h_fib_card : ∀ c : ClassGroup (NumberField.RingOfIntegers F),
      Nat.card { u : Fin N_ray // π u = c } =
        Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } := by
    intro c
    refine Nat.card_congr
      { toFun := fun ⟨u, hu⟩ => ⟨τ c u, hτ_to_prin c u hu⟩
        invFun := fun ⟨j, hj⟩ => ⟨τ c j, hτ_to_fiber c j hj⟩
        left_inv := fun ⟨u, _⟩ => Subtype.ext (hτ_inv c u)
        right_inv := fun ⟨j, _⟩ => Subtype.ext (hτ_inv c j) }
  calc
    N_ray = Nat.card (Fin N_ray) := (Nat.card_fin N_ray).symm
    _ = Nat.card (Σ c : ClassGroup (NumberField.RingOfIntegers F), { u : Fin N_ray // π u = c }) :=
        (Nat.card_congr (Equiv.sigmaFiberEquiv π)).symm
    _ = ∑ c : ClassGroup (NumberField.RingOfIntegers F), Nat.card { u : Fin N_ray // π u = c } :=
        Nat.card_sigma
    _ = ∑ _c : ClassGroup (NumberField.RingOfIntegers F),
          Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } := by
        simp_rw [h_fib_card]
    _ = Nat.card (ClassGroup (NumberField.RingOfIntegers F)) *
          Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } := by
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, smul_eq_mul]

theorem intNorm_pos_at_ramified_real_infinitePlace {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E]
    (b : NumberField.RingOfIntegers E)
    (hb_ne : b ≠ 0)
    (w : NumberField.InfinitePlace F)
    (hw_real : w.IsReal)
    (hw_ram : ∀ w_E : NumberField.InfinitePlace E,
      w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal) :
    0 < (w.embedding ((Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b :
      NumberField.RingOfIntegers F) : F)).re :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let x : E := (b : E)
  have hx_ne : x ≠ 0 := NumberField.RingOfIntegers.coe_eq_zero_iff.not.mpr hb_ne
  have h_intNorm : ((Algebra.intNorm R_F R_E b : R_F) : F) = Algebra.norm F x :=
    Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E) b
  letI : Algebra F ℂ := w.embedding.toAlgebra
  have h_prod_alg : w.embedding (Algebra.norm F x) = ∏ σ : E →ₐ[F] ℂ, σ x :=
    Algebra.norm_eq_prod_embeddings F ℂ x
  have h_conj_w : NumberField.ComplexEmbedding.conjugate w.embedding = w.embedding :=
    NumberField.ComplexEmbedding.isReal_iff.mp (NumberField.InfinitePlace.isReal_iff.mp hw_real)
  have h_star_w : ∀ y : F, (starRingEnd ℂ) (w.embedding y) = w.embedding y := by
    intro y
    rw [← NumberField.ComplexEmbedding.conjugate_coe_eq w.embedding y, h_conj_w]
  let τ : (E →ₐ[F] ℂ) → (E →ₐ[F] ℂ) := fun σ =>
    { toRingHom := NumberField.ComplexEmbedding.conjugate σ.toRingHom
      commutes' := fun y => by
        change (NumberField.ComplexEmbedding.conjugate σ.toRingHom) (algebraMap F E y) = w.embedding y
        rw [NumberField.ComplexEmbedding.conjugate_coe_eq]
        change (starRingEnd ℂ) (σ (algebraMap F E y)) = w.embedding y
        rw [σ.commutes y]
        exact h_star_w y }
  have hτ_apply : ∀ (σ : E →ₐ[F] ℂ) (z : E), τ σ z = (starRingEnd ℂ) (σ z) := by
    intro σ z
    exact NumberField.ComplexEmbedding.conjugate_coe_eq σ.toRingHom z
  have hτ_inv : ∀ σ : E →ₐ[F] ℂ, τ (τ σ) = σ := by
    intro σ
    apply AlgHom.ext
    intro z
    rw [hτ_apply, hτ_apply, RingHomCompTriple.comp_apply, RingHom.id_apply]
  have hτ_ne : ∀ σ : E →ₐ[F] ℂ, τ σ ≠ σ := by
    intro σ h_eq
    have h_conj_σ : NumberField.ComplexEmbedding.conjugate σ.toRingHom = σ.toRingHom := by
      ext z
      exact congrArg (fun f : E →ₐ[F] ℂ => f z) h_eq
    have hσ_real : NumberField.ComplexEmbedding.IsReal σ.toRingHom :=
      NumberField.ComplexEmbedding.isReal_iff.mpr h_conj_σ
    let w_E : NumberField.InfinitePlace E := NumberField.InfinitePlace.mk σ.toRingHom
    have hw_E_real : w_E.IsReal := NumberField.InfinitePlace.isReal_mk_iff.mpr hσ_real
    have h_comp : σ.toRingHom.comp (algebraMap F E) = w.embedding := by
      ext y
      exact σ.commutes y
    have hw_E_comap : w_E.comap (algebraMap F E) = w :=
      (NumberField.InfinitePlace.comap_mk σ.toRingHom (algebraMap F E)).trans
        ((congrArg NumberField.InfinitePlace.mk h_comp).trans
          (NumberField.InfinitePlace.mk_embedding w))
    exact hw_ram w_E hw_E_comap hw_E_real
  have hσ_ne : ∀ σ : E →ₐ[F] ℂ, σ x ≠ 0 :=
    fun σ => (map_ne_zero σ).mpr hx_ne
  have h_norm_pos : ∀ σ : E →ₐ[F] ℂ, 0 < ‖σ x‖ :=
    fun σ => norm_pos_iff.mpr (hσ_ne σ)
  have h_norm_c_ne : ∀ σ : E →ₐ[F] ℂ, (‖σ x‖ : ℂ) ≠ 0 :=
    fun σ => Complex.ofReal_ne_zero.mpr (h_norm_pos σ).ne'
  let u : (E →ₐ[F] ℂ) → ℂ := fun σ => σ x / (‖σ x‖ : ℂ)
  have h_factor : ∀ σ : E →ₐ[F] ℂ, σ x = u σ * (‖σ x‖ : ℂ) := by
    intro σ
    dsimp [u]
    exact (div_mul_cancel₀ (σ x) (h_norm_c_ne σ)).symm
  have h_prod_factor :
      (∏ σ : E →ₐ[F] ℂ, σ x) =
        (∏ σ : E →ₐ[F] ℂ, u σ) * ((∏ σ : E →ₐ[F] ℂ, ‖σ x‖ : ℝ) : ℂ) := by
    calc
      (∏ σ : E →ₐ[F] ℂ, σ x) = ∏ σ : E →ₐ[F] ℂ, (u σ * (‖σ x‖ : ℂ)) := by
        refine Finset.prod_congr rfl (fun σ _ => h_factor σ)
      _ = (∏ σ : E →ₐ[F] ℂ, u σ) * (∏ σ : E →ₐ[F] ℂ, (‖σ x‖ : ℂ)) := Finset.prod_mul_distrib
      _ = (∏ σ : E →ₐ[F] ℂ, u σ) * ((∏ σ : E →ₐ[F] ℂ, ‖σ x‖ : ℝ) : ℂ) := by
        rw [Complex.ofReal_prod]
  have h_prod_u : (∏ σ : E →ₐ[F] ℂ, u σ) = 1 := by
    refine Finset.prod_involution
      (fun (σ : E →ₐ[F] ℂ) _ => τ σ)
      ?_ ?_ ?_ ?_
    · intro σ _
      dsimp [u]
      rw [hτ_apply σ x, Complex.norm_conj (σ x), div_mul_div_comm, Complex.mul_conj' (σ x), ← sq]
      exact div_self (pow_ne_zero 2 (h_norm_c_ne σ))
    · intro σ _ _
      exact hτ_ne σ
    · intro σ _
      exact Finset.mem_univ _
    · intro σ _
      exact hτ_inv σ
  have h_emb_eq :
      w.embedding ((Algebra.intNorm R_F R_E b : R_F) : F) =
        ((∏ σ : E →ₐ[F] ℂ, ‖σ x‖ : ℝ) : ℂ) := by
    rw [h_intNorm, h_prod_alg, h_prod_factor, h_prod_u, one_mul]
  have h_re_eq :
      (w.embedding ((Algebra.intNorm R_F R_E b : R_F) : F)).re =
        ∏ σ : E →ₐ[F] ℂ, ‖σ x‖ := by
    have h_re := congrArg Complex.re h_emb_eq
    simpa only [Complex.ofReal_re] using h_re
  rw [h_re_eq]
  exact Finset.prod_pos (fun σ _ => h_norm_pos σ)

theorem principal_narrow_ray_cells_card_ge_unit_mod_index {F : Type u} [Field F] [NumberField F]
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ j : Fin N_ray,
        ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j = Ideal.span {a}) :
    let R_F := NumberField.RingOfIntegers F
    let U_mod : Subgroup ((R_F ⧸ m₀)ˣ × ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ)) :=
      Subgroup.closure { g | ∃ u : R_Fˣ,
        g.1 = Units.map (Ideal.Quotient.mk m₀ : R_F →* R_F ⧸ m₀) u ∧
        g.2 = fun w => if 0 < (w.1.embedding ((u : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ) }
    U_mod.index ≤ Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } :=
by
  classical
  intro R_F U_mod
  let W_real := { w : NumberField.InfinitePlace F // w.IsReal }
  let Γ := (R_F ⧸ m₀)ˣ × (W_real → ℤˣ)
  let S_prin := { j : Fin N_ray // (J_all j).IsPrincipal }
  let sgn : R_F → (W_real → ℤˣ) :=
    fun x w => if 0 < (w.1.embedding (x : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)
  have h_s1 : ∀ (u₀ : (R_F ⧸ m₀)ˣ) (s₀ : W_real → ℤˣ),
      ∃ x : R_F,
        x ≠ 0 ∧
        IsCoprime (Ideal.span {x}) m₀ ∧
        Ideal.Quotient.mk m₀ x = (u₀ : R_F ⧸ m₀) ∧
        ∀ w : W_real, sgn x w = s₀ w := by
    intro u₀ s₀
    have h_cop_of_mk : ∀ x : R_F,
        Ideal.Quotient.mk m₀ x = (u₀ : R_F ⧸ m₀) → IsCoprime (Ideal.span {x}) m₀ := by
      intro x h_mk
      obtain ⟨y₀, hy₀⟩ := Ideal.Quotient.mk_surjective ((u₀⁻¹ : (R_F ⧸ m₀)ˣ) : R_F ⧸ m₀)
      have h_mul_one : Ideal.Quotient.mk m₀ (x * y₀) = Ideal.Quotient.mk m₀ 1 := by
        rw [map_mul, h_mk, hy₀, Units.mul_inv, map_one]
      have h_sub_mem : 1 - x * y₀ ∈ m₀ := Ideal.Quotient.eq.mp h_mul_one.symm
      exact Ideal.isCoprime_iff_exists.mpr
        ⟨x * y₀, Ideal.mul_mem_right y₀ _ (Ideal.mem_span_singleton_self x),
         1 - x * y₀, h_sub_mem, add_sub_cancel (x * y₀) 1⟩
    obtain ⟨x₀, hx₀⟩ := Ideal.Quotient.mk_surjective (u₀ : R_F ⧸ m₀)
    let M : ℕ := Ideal.absNorm m₀
    have hM_pos : 0 < M :=
      Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
        (mem_nonZeroDivisors_of_ne_zero (by rwa [Submodule.zero_eq_bot]))
    have hM_mem : (M : R_F) ∈ m₀ := Ideal.absNorm_mem m₀
    have hM_mk : Ideal.Quotient.mk m₀ (M : R_F) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hM_mem
    by_cases h_empty : IsEmpty W_real
    · let x : R_F := if x₀ = 0 then (M : R_F) else x₀
      have hx_ne : x ≠ 0 := by
        dsimp [x]
        split_ifs with hx₀_eq
        · exact Nat.cast_ne_zero.mpr hM_pos.ne'
        · exact hx₀_eq
      have hx_mk : Ideal.Quotient.mk m₀ x = (u₀ : R_F ⧸ m₀) := by
        dsimp [x]
        split_ifs with hx₀_eq
        · rw [hM_mk, ← hx₀, hx₀_eq, map_zero]
        · exact hx₀
      refine ⟨x, hx_ne, h_cop_of_mk x hx_mk, hx_mk, fun w => False.elim (h_empty.false w)⟩
    · obtain ⟨w_real⟩ := not_isEmpty_iff.mp h_empty
      have hM_ge_one : (1 : ℝ) ≤ (M : ℝ) := Nat.one_le_cast.mpr hM_pos
      have hM_nonneg : (0 : ℝ) ≤ (M : ℝ) := Nat.cast_nonneg M
      let ι := Module.Free.ChooseBasisIndex ℤ R_F
      let ω : Module.Basis ι ℤ R_F := NumberField.RingOfIntegers.basis F
      let B : Module.Basis ι ℝ (NumberField.mixedEmbedding.mixedSpace F) :=
        NumberField.mixedEmbedding.latticeBasis F
      let φ : ∀ w : W_real, F →+* ℝ :=
        fun w => NumberField.InfinitePlace.embedding_of_isReal w.2
      have hφ_re : ∀ (w : W_real) (y : F), (w.1.embedding y).re = φ w y := by
        intro w y
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply w.2 y, Complex.ofReal_re]
      have hB_fst : ∀ (i : ι) (w : W_real), (B i).1 w = φ w ((ω i : R_F) : F) := by
        intro i w
        rw [NumberField.mixedEmbedding.latticeBasis_apply F i,
          NumberField.integralBasis_apply F i,
          NumberField.mixedEmbedding.mixedEmbedding_apply_isReal F _ w]
      let v : NumberField.mixedEmbedding.mixedSpace F :=
        (fun w => if s₀ w = 1 then (1 : ℝ) else (-1 : ℝ), 0)
      have hv_repr : ∀ w : W_real,
          (∑ i : ι, (B.repr v i) * φ w ((ω i : R_F) : F)) = v.1 w := by
        intro w
        have h_sum := congrArg (fun m : NumberField.mixedEmbedding.mixedSpace F => m.1 w)
          (B.sum_repr v)
        dsimp only at h_sum
        rw [Prod.fst_sum, Finset.sum_apply] at h_sum
        simpa only [Prod.smul_fst, Pi.smul_apply, smul_eq_mul, hB_fst] using h_sum
      let C : ℝ := ∑ w : W_real, ∑ i : ι, |φ w ((ω i : R_F) : F)|
      let X₀ : ℝ := ∑ w : W_real, |φ w (x₀ : F)|
      have hC_nonneg : 0 ≤ C :=
        Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _))
      have hX₀_nonneg : 0 ≤ X₀ := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
      obtain ⟨R, hR⟩ := exists_nat_gt (X₀ + (M : ℝ) * C)
      have hR_nonneg : (0 : ℝ) ≤ (R : ℝ) := Nat.cast_nonneg R
      have hR_le_MR : (R : ℝ) ≤ (M : ℝ) * (R : ℝ) := by
        simpa only [one_mul] using mul_le_mul_of_nonneg_right hM_ge_one hR_nonneg
      have h_bound_lt : X₀ + (M : ℝ) * C < (M : ℝ) * (R : ℝ) := lt_of_lt_of_le hR hR_le_MR
      let z : ι → ℤ := fun i => ⌊(R : ℝ) * (B.repr v i)⌋
      let x : R_F := x₀ + (M : R_F) * ∑ i : ι, (z i : R_F) * ω i
      have hx_mk : Ideal.Quotient.mk m₀ x = (u₀ : R_F ⧸ m₀) := by
        dsimp [x]
        rw [map_add, map_mul, hM_mk, zero_mul, add_zero, hx₀]
      have hx_real : ∀ w : W_real,
          (if s₀ w = 1 then 0 < φ w (x : F) else φ w (x : F) < 0) ∧
          sgn x w = s₀ w := by
        intro w
        have h_cast : (x : F) = (x₀ : F) + (M : F) * ∑ i : ι, (z i : F) * ((ω i : R_F) : F) := by
          dsimp [x]
          push_cast
          rfl
        have hφ_x : φ w (x : F) =
            φ w (x₀ : F) + (M : ℝ) * ∑ i : ι, (z i : ℝ) * φ w ((ω i : R_F) : F) := by
          rw [h_cast, map_add, map_mul, map_natCast, map_sum]
          simp only [map_mul, map_intCast]
        have h_target : (M : ℝ) * (R : ℝ) * (v.1 w) =
            (M : ℝ) * ∑ i : ι, ((R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F) := by
          rw [mul_assoc, ← hv_repr w, Finset.mul_sum]
          congr 1
          refine Finset.sum_congr rfl (fun i _ => ?_)
          ring
        have h_diff : φ w (x : F) - (M : ℝ) * (R : ℝ) * (v.1 w) =
            φ w (x₀ : F) +
              (M : ℝ) * ∑ i : ι, ((z i : ℝ) - (R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F) := by
          rw [hφ_x, h_target]
          have h_sub_sum :
              (∑ i : ι, (z i : ℝ) * φ w ((ω i : R_F) : F)) -
              (∑ i : ι, ((R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F)) =
              ∑ i : ι, ((z i : ℝ) - (R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F) := by
            rw [← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            ring
          linarith [congrArg ((M : ℝ) * ·) h_sub_sum]
        have h_err_i : ∀ i : ι,
            |((z i : ℝ) - (R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F)| ≤
              |φ w ((ω i : R_F) : F)| := by
          intro i
          rw [abs_mul]
          have h_fl_le : (z i : ℝ) ≤ (R : ℝ) * (B.repr v i) := Int.floor_le _
          have h_lt_fl : (R : ℝ) * (B.repr v i) - 1 < (z i : ℝ) := Int.sub_one_lt_floor _
          have h_abs_le_one : |(z i : ℝ) - (R : ℝ) * (B.repr v i)| ≤ 1 :=
            abs_sub_le_iff.mpr ⟨by linarith, by linarith⟩
          simpa only [one_mul] using mul_le_mul_of_nonneg_right h_abs_le_one (abs_nonneg _)
        have h_sum_err :
            |∑ i : ι, ((z i : ℝ) - (R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F)| ≤
              ∑ i : ι, |φ w ((ω i : R_F) : F)| :=
          (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun i _ => h_err_i i))
        have h_w_X₀ : |φ w (x₀ : F)| ≤ X₀ :=
          Finset.single_le_sum (fun w' _ => abs_nonneg (φ w' (x₀ : F))) (Finset.mem_univ w)
        have h_w_C : (∑ i : ι, |φ w ((ω i : R_F) : F)|) ≤ C :=
          Finset.single_le_sum
            (fun w' _ => Finset.sum_nonneg (fun i _ => abs_nonneg (φ w' ((ω i : R_F) : F))))
            (Finset.mem_univ w)
        have h_abs_diff :
            |φ w (x : F) - (M : ℝ) * (R : ℝ) * (v.1 w)| < (M : ℝ) * (R : ℝ) := by
          rw [h_diff]
          have h1 := abs_add_le (φ w (x₀ : F))
            ((M : ℝ) * ∑ i : ι, ((z i : ℝ) - (R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F))
          rw [abs_mul, abs_of_nonneg hM_nonneg] at h1
          have h2 : (M : ℝ) * |∑ i : ι, ((z i : ℝ) - (R : ℝ) * (B.repr v i)) * φ w ((ω i : R_F) : F)| ≤
              (M : ℝ) * C :=
            mul_le_mul_of_nonneg_left (h_sum_err.trans h_w_C) hM_nonneg
          exact lt_of_le_of_lt (h1.trans (add_le_add h_w_X₀ h2)) h_bound_lt
        have h_ineq := abs_sub_lt_iff.mp h_abs_diff
        dsimp only [sgn, v] at h_ineq ⊢
        rw [hφ_re w (x : F)]
        by_cases hs : s₀ w = 1
        · rw [if_pos hs] at h_ineq ⊢
          have h_pos : 0 < φ w (x : F) := by linarith [h_ineq.2]
          exact ⟨h_pos, by rw [if_pos h_pos, hs]⟩
        · rw [if_neg hs] at h_ineq ⊢
          have hs_neg : s₀ w = -1 := (Int.units_eq_one_or (s₀ w)).resolve_left hs
          have h_neg : φ w (x : F) < 0 := by linarith [h_ineq.1]
          have h_not_pos : ¬ (0 < φ w (x : F)) := not_lt.mpr h_neg.le
          exact ⟨h_neg, by rw [if_neg h_not_pos, hs_neg]⟩
      have hx_ne : x ≠ 0 := by
        intro hx_zero
        have h_re_zero : φ w_real (x : F) = 0 := by
          simp [hx_zero]
        have h_w := (hx_real w_real).1
        rw [h_re_zero] at h_w
        split_ifs at h_w <;> exact lt_irrefl 0 h_w
      exact ⟨x, hx_ne, h_cop_of_mk x hx_mk, hx_mk, fun w => (hx_real w).2⟩
  have h_s2 : ∀ (x : R_F), x ≠ 0 → IsCoprime (Ideal.span {x}) m₀ →
      ∃ (j : Fin N_ray) (hj : (J_all j).IsPrincipal),
        ∀ g : R_F,
          J_all j = Ideal.span {g} →
          ∃ u : R_Fˣ,
            Ideal.Quotient.mk m₀ (x * g) = Ideal.Quotient.mk m₀ (u : R_F) ∧
            ∀ w : W_real, sgn x w * sgn g w = sgn (u : R_F) w := by
    intro x hx_ne hx_cop
    have hIx_ne : Ideal.span ({x} : Set R_F) ≠ ⊥ :=
      Ideal.span_singleton_eq_bot.not.mpr hx_ne
    obtain ⟨j, a, ha_m, ha_pos, h_span⟩ := hJ_cov (Ideal.span {x}) hIx_ne hx_cop
    have ha_le : Ideal.span ({a} : Set R_F) ≤ Ideal.span ({x} : Set R_F) := by
      rw [← h_span]
      exact Ideal.mul_le_right
    obtain ⟨y, hy⟩ := Ideal.span_singleton_le_span_singleton.mp ha_le
    have hJ_prin : (J_all j).IsPrincipal := by
      refine ⟨⟨y, ?_⟩⟩
      have h_mul_eq : Ideal.span ({x} : Set R_F) * J_all j =
          Ideal.span ({x} : Set R_F) * Ideal.span ({y} : Set R_F) := by
        rw [h_span, hy, Ideal.span_singleton_mul_span_singleton]
      exact mul_left_cancel₀ (by rwa [Submodule.zero_eq_bot]) h_mul_eq
    refine ⟨j, hJ_prin, fun g hg => ?_⟩
    have hg_ne : g ≠ 0 := by
      intro hg0
      apply (hJ_prop j).1
      rw [hg, hg0, Ideal.span_singleton_eq_bot]
    have h_span_eq : Ideal.span ({a} : Set R_F) = Ideal.span ({x * g} : Set R_F) := by
      rw [← h_span, hg, Ideal.span_singleton_mul_span_singleton]
    obtain ⟨u, hu_eq⟩ := Ideal.span_singleton_eq_span_singleton.mp h_span_eq
    have ha_mk : Ideal.Quotient.mk m₀ a = 1 := by
      have h1 : Ideal.Quotient.mk m₀ a = Ideal.Quotient.mk m₀ 1 :=
        Ideal.Quotient.eq.mpr ha_m
      rwa [map_one] at h1
    have hu_mk : Ideal.Quotient.mk m₀ (x * g) = Ideal.Quotient.mk m₀ (u : R_F) := by
      rw [← hu_eq, map_mul, ha_mk, one_mul]
    have h_real_sign_mul : ∀ (r₁ r₂ : ℝ), r₁ ≠ 0 → r₂ ≠ 0 →
        (if 0 < r₁ * r₂ then (1 : ℤˣ) else (-1 : ℤˣ)) =
        (if 0 < r₁ then (1 : ℤˣ) else (-1 : ℤˣ)) *
          (if 0 < r₂ then (1 : ℤˣ) else (-1 : ℤˣ)) := by
      intro r₁ r₂ hr₁ hr₂
      rcases lt_or_gt_of_ne hr₁ with h₁_neg | h₁_pos <;>
        rcases lt_or_gt_of_ne hr₂ with h₂_neg | h₂_pos
      · have h_pos : 0 < r₁ * r₂ := mul_pos_of_neg_of_neg h₁_neg h₂_neg
        rw [if_pos h_pos, if_neg (not_lt.mpr h₁_neg.le), if_neg (not_lt.mpr h₂_neg.le)]
        rfl
      · have h_neg : r₁ * r₂ < 0 := mul_neg_of_neg_of_pos h₁_neg h₂_pos
        rw [if_neg (not_lt.mpr h_neg.le), if_neg (not_lt.mpr h₁_neg.le), if_pos h₂_pos]
        rfl
      · have h_neg : r₁ * r₂ < 0 := mul_neg_of_pos_of_neg h₁_pos h₂_neg
        rw [if_neg (not_lt.mpr h_neg.le), if_pos h₁_pos, if_neg (not_lt.mpr h₂_neg.le)]
        rfl
      · have h_pos : 0 < r₁ * r₂ := mul_pos h₁_pos h₂_pos
        rw [if_pos h_pos, if_pos h₁_pos, if_pos h₂_pos, mul_one]
    refine ⟨u, hu_mk, fun w => ?_⟩
    let φ : F →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal w.2
    have hφ_re : ∀ z : F, (w.1.embedding z).re = φ z := by
      intro z
      rw [← NumberField.InfinitePlace.embedding_of_isReal_apply w.2 z, Complex.ofReal_re]
    have hφ_inj : Function.Injective (fun z : R_F => φ (z : F)) :=
      φ.injective.comp (FaithfulSMul.algebraMap_injective R_F F)
    have hφ_ne : ∀ {z : R_F}, z ≠ 0 → φ (z : F) ≠ 0 := by
      intro z hz h0
      apply hz
      apply hφ_inj
      simp [h0]
    have hφ_x_ne : φ (x : F) ≠ 0 := hφ_ne hx_ne
    have hφ_g_ne : φ (g : F) ≠ 0 := hφ_ne hg_ne
    have hφ_u_ne : φ ((u : R_F) : F) ≠ 0 := hφ_ne (Units.ne_zero u)
    have hφ_a_pos : 0 < φ (a : F) := by
      rw [← hφ_re (a : F)]
      exact ha_pos w.1 w.2
    have hφ_a_ne : φ (a : F) ≠ 0 := hφ_a_pos.ne'
    have hφ_eq : φ (x : F) * φ (g : F) = φ (a : F) * φ ((u : R_F) : F) := by
      have h_coe := congrArg (fun z : R_F => φ (z : F)) hu_eq.symm
      dsimp only at h_coe
      simpa only [Algebra.smul_def, RingHom.coe_coe, map_mul] using h_coe
    dsimp only [sgn]
    rw [hφ_re (x : F), hφ_re (g : F), hφ_re ((u : R_F) : F)]
    rw [← h_real_sign_mul (φ (x : F)) (φ (g : F)) hφ_x_ne hφ_g_ne,
      hφ_eq, h_real_sign_mul (φ (a : F)) (φ ((u : R_F) : F)) hφ_a_ne hφ_u_ne,
      if_pos hφ_a_pos, one_mul]
  have h_ex_g : ∀ p : S_prin,
      ∃ (g : R_F) (u_mod : (R_F ⧸ m₀)ˣ),
        J_all p.1 = Ideal.span {g} ∧
        (u_mod : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ g := by
    intro p
    rcases p.2 with ⟨⟨g, hg⟩⟩
    have hg' : J_all p.1 = Ideal.span {g} := hg
    have hg_cop : IsCoprime (Ideal.span {g}) m₀ := by
      rw [← hg']
      exact (hJ_prop p.1).2
    rcases Ideal.isCoprime_iff_exists.mp hg_cop with ⟨i, hi_g, y, hy_m, hiy⟩
    rcases Ideal.mem_span_singleton'.mp hi_g with ⟨r, rfl⟩
    have h_unit : IsUnit (Ideal.Quotient.mk m₀ g) := by
      refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk m₀ r, ?_⟩
      rw [← map_mul, mul_comm]
      have h_eq : r * g - 1 = -y := by linear_combination hiy
      exact Ideal.Quotient.eq.mpr (h_eq ▸ m₀.neg_mem hy_m)
    exact ⟨g, h_unit.unit, hg', h_unit.unit_spec⟩
  choose g_of u_mod_of hg_of hu_mod_of using h_ex_g
  let γ_of : S_prin → Γ := fun p => (u_mod_of p, sgn (g_of p))
  let F_prin : S_prin → Γ ⧸ U_mod := fun p => QuotientGroup.mk (γ_of p)
  have hF_surj : Function.Surjective F_prin := by
    intro q
    obtain ⟨⟨u₀, s₀⟩, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨x, hx_ne, hx_cop, hx_mk, hx_sgn⟩ := h_s1 u₀⁻¹ s₀⁻¹
    obtain ⟨j, hj, h_unit⟩ := h_s2 x hx_ne hx_cop
    let p : S_prin := ⟨j, hj⟩
    obtain ⟨u, hu_mk, hu_sgn⟩ := h_unit (g_of p) (hg_of p)
    refine ⟨p, (QuotientGroup.eq.mpr ?_).symm⟩
    apply Subgroup.subset_closure
    refine ⟨u, ?_, ?_⟩
    · apply Units.ext
      change ((u₀⁻¹ : (R_F ⧸ m₀)ˣ) : R_F ⧸ m₀) * (u_mod_of p : R_F ⧸ m₀) =
        Ideal.Quotient.mk m₀ (u : R_F)
      rw [← hx_mk, hu_mod_of p, ← map_mul, hu_mk]
    · funext w
      change (s₀⁻¹ w) * sgn (g_of p) w = sgn (u : R_F) w
      rw [← hx_sgn w]
      exact hu_sgn w
  haveI : Finite S_prin := Subtype.finite
  rw [Subgroup.index_eq_card]
  exact Nat.card_le_card_of_surjective F_prin hF_surj

theorem admissible_norm_sign_subgroup_index_and_unit_relIndex_le_of_nonzero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E]
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (h_norm_pos : ∀ (b : NumberField.RingOfIntegers E), b ≠ 0 →
      ∀ (w : NumberField.InfinitePlace F),
        w.IsReal →
        (∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal) →
        0 < (w.embedding ((Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b :
          NumberField.RingOfIntegers F) : F)).re) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ b : R_E,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
    let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
      ∃ b₁ b₂ : R_E,
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
    let U_mod : Subgroup ((R_F ⧸ m₀)ˣ × ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ)) :=
      Subgroup.closure { g | ∃ u : R_Fˣ,
        g.1 = Units.map (Ideal.Quotient.mk m₀ : R_F →* R_F ⧸ m₀) u ∧
        g.2 = fun w => if 0 < (w.1.embedding ((u : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ) }
    let P_ram : Subgroup ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ) :=
      Subgroup.closure { s | ∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
        (∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w.1 → ¬ w_E.IsReal) →
        s w = 1 }
    0 < Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) ∧
    (N_mod.prod P_ram).index =
      2 ^ (Nat.card { w : NumberField.InfinitePlace F //
        w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal }) *
        Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) ∧
    (N_mod.prod P_ram).relIndex U_mod ≤ Nat.card (R_Fˣ ⧸ H_unr) :=
by
  classical
  intro R_F R_E N_mod H_unr U_mod P_ram
  haveI : Finite (R_F ⧸ m₀) := Ideal.finiteQuotientOfFreeOfNeBot m₀ hm₀_ne
  have hQmod_pos : 0 < Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) := Nat.card_pos
  let W_real := { w : NumberField.InfinitePlace F // w.IsReal }
  let W_ram := { w : NumberField.InfinitePlace F //
    w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal }
  let res_ram : (W_real → ℤˣ) →* (W_ram → ℤˣ) :=
    { toFun := fun s w => s ⟨w.1, w.2.1⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have h_ker_set :
      { s : W_real → ℤˣ | ∀ w : W_real,
        (∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w.1 → ¬ w_E.IsReal) →
        s w = 1 } = (res_ram.ker : Set (W_real → ℤˣ)) := by
    ext s
    rw [Set.mem_setOf_eq, SetLike.mem_coe, MonoidHom.mem_ker]
    constructor
    · intro hs
      funext ⟨w, hw_real, hw_ram⟩
      exact hs ⟨w, hw_real⟩ hw_ram
    · intro hs ⟨w, hw_real⟩ hw_ram
      exact congrFun hs ⟨w, hw_real, hw_ram⟩
  have hP_ram_eq : P_ram = res_ram.ker := by
    dsimp [P_ram]
    rw [h_ker_set, Subgroup.closure_eq]
  have h_surj : Function.Surjective res_ram := by
    intro t
    refine ⟨fun w =>
      if h : ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w.1 → ¬ w_E.IsReal
      then t ⟨w.1, w.2, h⟩ else 1, ?_⟩
    funext ⟨w, hw_real, hw_ram⟩
    change (if h : ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal
      then t ⟨w, hw_real, h⟩ else 1) = t ⟨w, hw_real, hw_ram⟩
    exact dif_pos hw_ram
  have hP_idx : P_ram.index = 2 ^ Nat.card W_ram := by
    rw [hP_ram_eq, Subgroup.index_eq_card]
    have h_equiv : Nat.card ((W_real → ℤˣ) ⧸ res_ram.ker) = Nat.card (W_ram → ℤˣ) :=
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective res_ram h_surj).toEquiv
    rw [h_equiv, Nat.card_fun, Nat.card_eq_fintype_card (α := ℤˣ), Fintype.card_units_int]
  have h_prod_idx : (N_mod.prod P_ram).index =
      2 ^ Nat.card W_ram * Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) := by
    rw [Subgroup.index_prod, Subgroup.index_eq_card N_mod, hP_idx, mul_comm]
  let d := Module.finrank F E
  have hd_pos : 0 < d := Module.finrank_pos
  have hd_int_pos : (0 : ℤ) < (d : ℤ) := Nat.cast_pos.mpr hd_pos
  have h_top_cop : IsCoprime (⊤ : Ideal R_F) m₀ :=
    Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
  let ι_FE : R_Fˣ →* R_Eˣ := Units.map (algebraMap R_F R_E : R_F →* R_E)
  have h_pow_mem : ∀ v : R_Fˣ, v ^ d ∈ H_unr := by
    intro v
    have h_norm_v : Algebra.intNorm R_F R_E ((ι_FE v : R_Eˣ) : R_E) = ((v ^ d : R_Fˣ) : R_F) := by
      apply FaithfulSMul.algebraMap_injective R_F F
      change algebraMap R_F F (Algebra.intNorm R_F R_E (algebraMap R_F R_E (v : R_F))) =
        algebraMap R_F F (((v ^ d : R_Fˣ) : R_F))
      rw [Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E),
        ← IsScalarTower.algebraMap_apply R_F R_E E,
        IsScalarTower.algebraMap_apply R_F F E,
        Algebra.norm_algebraMap (L := E) (algebraMap R_F F (v : R_F)),
        Units.val_pow_eq_pow_val, map_pow]
    apply Subgroup.subset_closure
    refine ⟨1, ((ι_FE v : R_Eˣ) : R_E), one_ne_zero, Units.ne_zero (ι_FE v), ?_, ?_, ?_⟩
    · rw [map_one, Ideal.span_singleton_one]
      exact h_top_cop
    · rw [h_norm_v, Ideal.span_singleton_eq_top.mpr (v ^ d).isUnit]
      exact h_top_cop
    · rw [map_one, mul_one, h_norm_v]
  let r_F : ℕ := NumberField.Units.rank F
  let ε : Fin r_F → R_Fˣ := NumberField.Units.fundSystem F
  let Φ : NumberField.Units.torsion F × (Fin r_F → Fin d) → R_Fˣ ⧸ H_unr :=
    fun p => QuotientGroup.mk ((p.1 : R_Fˣ) * ∏ i : Fin r_F, (ε i) ^ ((p.2 i : ℕ) : ℤ))
  have hΦ_surj : Function.Surjective Φ := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨⟨ζ, g⟩, hx_eq, _⟩ := NumberField.Units.exist_unique_eq_mul_prod F x
    dsimp at hx_eq
    let r : Fin r_F → Fin d := fun i =>
      ⟨(g i % (d : ℤ)).toNat, by
        have h_nonneg : 0 ≤ g i % (d : ℤ) := Int.emod_nonneg (g i) hd_int_pos.ne'
        have h_lt : g i % (d : ℤ) < (d : ℤ) := Int.emod_lt_of_pos (g i) hd_int_pos
        zify
        rw [Int.toNat_of_nonneg h_nonneg]
        exact h_lt⟩
    let q_div : Fin r_F → ℤ := fun i => g i / (d : ℤ)
    refine ⟨(ζ, r), ?_⟩
    apply QuotientGroup.eq.mpr
    have h_decomp : ∀ i : Fin r_F,
        (ε i) ^ (g i) = (ε i) ^ ((r i : ℕ) : ℤ) * ((ε i) ^ (q_div i)) ^ d := by
      intro i
      have h_ri : ((r i : ℕ) : ℤ) = g i % (d : ℤ) :=
        Int.toNat_of_nonneg (Int.emod_nonneg (g i) hd_int_pos.ne')
      have h_gi : g i = ((r i : ℕ) : ℤ) + q_div i * (d : ℤ) := by
        have h_div := Int.mul_ediv_add_emod (g i) (d : ℤ)
        dsimp [q_div]
        linarith
      rw [h_gi, zpow_add, zpow_mul, zpow_natCast ((ε i) ^ (q_div i)) d]
    have h_prod_decomp : (∏ i : Fin r_F, (ε i) ^ (g i)) =
        (∏ i : Fin r_F, (ε i) ^ ((r i : ℕ) : ℤ)) * (∏ i : Fin r_F, (ε i) ^ (q_div i)) ^ d := by
      rw [← Finset.prod_pow, ← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun i _ => h_decomp i
    let w : R_Fˣ := ∏ i : Fin r_F, (ε i) ^ (q_div i)
    have hx_w : x = ((ζ : R_Fˣ) * ∏ i : Fin r_F, (ε i) ^ ((r i : ℕ) : ℤ)) * w ^ d := by
      rw [hx_eq, h_prod_decomp, mul_assoc]
    change ((ζ : R_Fˣ) * ∏ i : Fin r_F, (ε i) ^ ((r i : ℕ) : ℤ))⁻¹ * x ∈ H_unr
    rw [hx_w, inv_mul_cancel_left]
    exact h_pow_mem w
  haveI : Finite (R_Fˣ ⧸ H_unr) := Finite.of_surjective Φ hΦ_surj
  have hHunr_pos : 0 < Nat.card (R_Fˣ ⧸ H_unr) := Nat.card_pos
  have h_re : ∀ (w : W_real) (x : F),
      (w.1.embedding x).re = NumberField.InfinitePlace.embedding_of_isReal w.2 x := by
    intro w x
    have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply w.2 x
    have h2 := congrArg Complex.re h1.symm
    rw [Complex.ofReal_re] at h2
    exact h2
  have h_re_unit_ne : ∀ (w : W_real) (u : R_Fˣ),
      (w.1.embedding ((u : R_F) : F)).re ≠ 0 := by
    intro w u
    rw [h_re w]
    have hu_ne : ((u : R_F) : F) ≠ 0 :=
      (map_ne_zero_iff (algebraMap R_F F) (FaithfulSMul.algebraMap_injective R_F F)).mpr u.ne_zero
    exact (map_ne_zero_iff (NumberField.InfinitePlace.embedding_of_isReal w.2)
      (NumberField.InfinitePlace.embedding_of_isReal w.2).injective).mpr hu_ne
  let φ_mod : R_Fˣ →* (R_F ⧸ m₀)ˣ := Units.map (Ideal.Quotient.mk m₀ : R_F →* R_F ⧸ m₀)
  let φ_sgn : R_Fˣ →* (W_real → ℤˣ) :=
    { toFun := fun u w => if 0 < (w.1.embedding ((u : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)
      map_one' := by
        funext w
        change (if 0 < (w.1.embedding (((1 : R_Fˣ) : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) = 1
        push_cast
        rw [map_one, Complex.one_re, if_pos zero_lt_one]
      map_mul' := by
        intro u₁ u₂
        funext w
        change (if 0 < (w.1.embedding ((((u₁ * u₂ : R_Fˣ) : R_F) : F))).re then (1 : ℤˣ) else (-1 : ℤˣ)) =
          (if 0 < (w.1.embedding ((u₁ : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) *
          (if 0 < (w.1.embedding ((u₂ : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ))
        have h_mul_re : (w.1.embedding ((((u₁ * u₂ : R_Fˣ) : R_F) : F))).re =
            (w.1.embedding ((u₁ : R_F) : F)).re * (w.1.embedding ((u₂ : R_F) : F)).re := by
          push_cast
          rw [h_re w, map_mul, ← h_re w, ← h_re w]
        rw [h_mul_re]
        by_cases h1 : 0 < (w.1.embedding ((u₁ : R_F) : F)).re <;>
          by_cases h2 : 0 < (w.1.embedding ((u₂ : R_F) : F)).re
        · rw [if_pos h1, if_pos h2, if_pos (mul_pos h1 h2), mul_one]
        · have h2_neg : (w.1.embedding ((u₂ : R_F) : F)).re < 0 :=
            lt_of_le_of_ne (not_lt.mp h2) (h_re_unit_ne w u₂)
          rw [if_pos h1, if_neg h2, if_neg (not_lt.mpr (mul_neg_of_pos_of_neg h1 h2_neg).le), one_mul]
        · have h1_neg : (w.1.embedding ((u₁ : R_F) : F)).re < 0 :=
            lt_of_le_of_ne (not_lt.mp h1) (h_re_unit_ne w u₁)
          rw [if_neg h1, if_pos h2, if_neg (not_lt.mpr (mul_neg_of_neg_of_pos h1_neg h2).le), mul_one]
        · have h1_neg : (w.1.embedding ((u₁ : R_F) : F)).re < 0 :=
            lt_of_le_of_ne (not_lt.mp h1) (h_re_unit_ne w u₁)
          have h2_neg : (w.1.embedding ((u₂ : R_F) : F)).re < 0 :=
            lt_of_le_of_ne (not_lt.mp h2) (h_re_unit_ne w u₂)
          rw [if_neg h1, if_neg h2, if_pos (mul_pos_of_neg_of_neg h1_neg h2_neg)]
          decide }
  let ψ_F : R_Fˣ →* ((R_F ⧸ m₀)ˣ × (W_real → ℤˣ)) := MonoidHom.prod φ_mod φ_sgn
  have hU_set :
      { g : (R_F ⧸ m₀)ˣ × (W_real → ℤˣ) | ∃ u : R_Fˣ,
        g.1 = φ_mod u ∧ g.2 = φ_sgn u } = (ψ_F.range : Set ((R_F ⧸ m₀)ˣ × (W_real → ℤˣ))) := by
    ext ⟨g₁, g₂⟩
    simp only [Set.mem_setOf_eq, SetLike.mem_coe, MonoidHom.mem_range, Prod.ext_iff]
    constructor
    · rintro ⟨u, h1, h2⟩
      exact ⟨u, h1.symm, h2.symm⟩
    · rintro ⟨u, h1, h2⟩
      exact ⟨u, h1.symm, h2.symm⟩
  have hU_mod_eq : U_mod = ψ_F.range := by
    change Subgroup.closure { g : (R_F ⧸ m₀)ˣ × (W_real → ℤˣ) | ∃ u : R_Fˣ,
      g.1 = φ_mod u ∧ g.2 = φ_sgn u } = ψ_F.range
    rw [hU_set, Subgroup.closure_eq]
  have h_cop_norm : ∀ b : R_E,
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ →
      ∃ v ∈ N_mod, (v : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) := by
    intro b hb_cop
    obtain ⟨x, hx, y, hy, hxy⟩ := Ideal.isCoprime_iff_exists.mp hb_cop
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    have hy0 : Ideal.Quotient.mk m₀ y = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hy
    have h_mul1 : Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) * Ideal.Quotient.mk m₀ a = 1 := by
      calc
        Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) * Ideal.Quotient.mk m₀ a
            = Ideal.Quotient.mk m₀ (a * Algebra.intNorm R_F R_E b) + Ideal.Quotient.mk m₀ y := by
              rw [hy0, add_zero, ← map_mul, mul_comm]
        _ = Ideal.Quotient.mk m₀ (a * Algebra.intNorm R_F R_E b + y) := (map_add _ _ _).symm
        _ = 1 := by rw [hxy, map_one]
    have h_mul2 : Ideal.Quotient.mk m₀ a * Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) = 1 := by
      rw [mul_comm, h_mul1]
    let v : (R_F ⧸ m₀)ˣ := ⟨Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b),
      Ideal.Quotient.mk m₀ a, h_mul1, h_mul2⟩
    refine ⟨v, Subgroup.subset_closure ⟨b, rfl⟩, rfl⟩
  let K_pre : Subgroup R_Fˣ := Subgroup.comap ψ_F (N_mod.prod P_ram)
  have h_le : H_unr ≤ K_pre := by
    rw [Subgroup.closure_le]
    rintro u ⟨b₁, b₂, hb₁, hb₂, hb₁_cop, hb₂_cop, hu_eq⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.mem_prod]
    refine ⟨?_, ?_⟩
    · obtain ⟨v₁, hv₁_mem, hv₁_val⟩ := h_cop_norm b₁ hb₁_cop
      obtain ⟨v₂, hv₂_mem, hv₂_val⟩ := h_cop_norm b₂ hb₂_cop
      have h_uv : φ_mod u * v₁ = v₂ := by
        apply Units.ext
        change Ideal.Quotient.mk m₀ (u : R_F) * (v₁ : R_F ⧸ m₀) = (v₂ : R_F ⧸ m₀)
        rw [hv₁_val, hv₂_val, ← map_mul, hu_eq]
      have h_u_eq : φ_mod u = v₂ * v₁⁻¹ := eq_mul_inv_of_mul_eq h_uv
      change φ_mod u ∈ N_mod
      rw [h_u_eq]
      exact Subgroup.mul_mem N_mod hv₂_mem (Subgroup.inv_mem N_mod hv₁_mem)
    · apply Subgroup.subset_closure
      intro w hw_ram
      have hb₁_pos : 0 < (w.1.embedding ((Algebra.intNorm R_F R_E b₁ : R_F) : F)).re :=
        h_norm_pos b₁ hb₁ w.1 w.2 hw_ram
      have hb₂_pos : 0 < (w.1.embedding ((Algebra.intNorm R_F R_E b₂ : R_F) : F)).re :=
        h_norm_pos b₂ hb₂ w.1 w.2 hw_ram
      have h_eq_F : ((u : R_F) : F) * ((Algebra.intNorm R_F R_E b₁ : R_F) : F) =
          ((Algebra.intNorm R_F R_E b₂ : R_F) : F) := by
        exact_mod_cast congrArg (algebraMap R_F F) hu_eq
      have h_eq_re : (w.1.embedding ((u : R_F) : F)).re *
          (w.1.embedding ((Algebra.intNorm R_F R_E b₁ : R_F) : F)).re =
          (w.1.embedding ((Algebra.intNorm R_F R_E b₂ : R_F) : F)).re := by
        rw [h_re w, h_re w, h_re w, ← map_mul, h_eq_F]
      have h_prod_pos : 0 < (w.1.embedding ((u : R_F) : F)).re *
          (w.1.embedding ((Algebra.intNorm R_F R_E b₁ : R_F) : F)).re := by
        rwa [h_eq_re]
      have hu_pos : 0 < (w.1.embedding ((u : R_F) : F)).re :=
        pos_of_mul_pos_left h_prod_pos hb₁_pos.le
      change (if 0 < (w.1.embedding ((u : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) = 1
      exact if_pos hu_pos
  have h_dvd : ((N_mod.prod P_ram).relIndex U_mod) ∣ Nat.card (R_Fˣ ⧸ H_unr) := by
    have h_mul := Subgroup.relIndex_mul_index h_le
    change H_unr.relIndex K_pre * (Subgroup.comap ψ_F (N_mod.prod P_ram)).index = H_unr.index at h_mul
    rw [Subgroup.index_comap (N_mod.prod P_ram) ψ_F, ← hU_mod_eq, Subgroup.index_eq_card H_unr] at h_mul
    exact ⟨H_unr.relIndex K_pre, by rw [← h_mul, mul_comm]⟩
  exact ⟨hQmod_pos, h_prod_idx, Nat.le_of_dvd hHunr_pos h_dvd⟩

theorem pnorm_narrow_ray_cells_card_pos_and_le_relIndex {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E]
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ j : Fin N_ray,
        ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j = Ideal.span {a})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₁ = Ideal.span {a}) →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₂ = Ideal.span {a}) →
      j₁ = j₂)
    (h_norm_pos : ∀ (b : NumberField.RingOfIntegers E), b ≠ 0 →
      ∀ (w : NumberField.InfinitePlace F),
        w.IsReal →
        (∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal) →
        0 < (w.embedding ((Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b :
          NumberField.RingOfIntegers F) : F)).re) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ b : R_E,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
    let U_mod : Subgroup ((R_F ⧸ m₀)ˣ × ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ)) :=
      Subgroup.closure { g | ∃ u : R_Fˣ,
        g.1 = Units.map (Ideal.Quotient.mk m₀ : R_F →* R_F ⧸ m₀) u ∧
        g.2 = fun w => if 0 < (w.1.embedding ((u : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ) }
    let P_ram : Subgroup ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ) :=
      Subgroup.closure { s | ∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
        (∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w.1 → ¬ w_E.IsReal) →
        s w = 1 }
    let S_pnorm := { j : Fin N_ray //
      ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all j * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
          Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} }
    0 < Nat.card S_pnorm ∧
    Nat.card S_pnorm ≤ U_mod.relIndex (U_mod ⊔ (N_mod.prod P_ram)) :=
by
  classical
  intro R_F R_E N_mod U_mod P_ram S_pnorm
  
  have h_top_cop : IsCoprime (⊤ : Ideal R_F) m₀ :=
    Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
  obtain ⟨j₀, a₀, ha₀_m, ha₀_pos, h_top_J⟩ := hJ_cov ⊤ top_ne_bot h_top_cop
  rw [Ideal.top_mul] at h_top_J
  have ha₀_ne : a₀ ≠ 0 := by
    intro ha₀0
    apply (hJ_prop j₀).1
    rw [h_top_J, Ideal.span_singleton_eq_bot.mpr ha₀0]
  have h_norm_one_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (1 : R_E)}) m₀ := by
    rw [map_one, Ideal.span_singleton_one]
    exact h_top_cop
  have h_one_sub_mem : (1 : R_F) - 1 ∈ m₀ := by
    rw [sub_self]
    exact m₀.zero_mem
  have h_one_a₀_pos : ∀ w : NumberField.InfinitePlace F,
      w.IsReal → 0 < (w.embedding ((1 : R_F) : F)).re ∧ 0 < (w.embedding (a₀ : F)).re := by
    intro w hw
    refine ⟨?_, ha₀_pos w hw⟩
    change 0 < (w.embedding (algebraMap R_F F 1)).re
    simp only [map_one, Complex.one_re, zero_lt_one]
  have h_j₀_eq :
      J_all j₀ * Ideal.span {(1 : R_F)} * Ideal.span {Algebra.intNorm R_F R_E (1 : R_E)} =
        Ideal.span {a₀} * Ideal.span {Algebra.intNorm R_F R_E (1 : R_E)} := by
    rw [h_top_J, Ideal.span_singleton_one, Ideal.mul_top]
  let p₀ : S_pnorm :=
    ⟨j₀, 1, a₀, 1, 1, one_ne_zero, ha₀_ne, one_ne_zero, one_ne_zero,
      h_norm_one_cop, h_norm_one_cop, h_one_sub_mem, ha₀_m, h_one_a₀_pos, h_j₀_eq⟩
  haveI : Nonempty S_pnorm := ⟨p₀⟩
  haveI : Finite S_pnorm := Subtype.finite
  have hSpnorm_pos : 0 < Nat.card S_pnorm := Nat.card_pos
  
  let W_real := { w : NumberField.InfinitePlace F // w.IsReal }
  let Γ := (R_F ⧸ m₀)ˣ × (W_real → ℤˣ)
  let K_adm : Subgroup Γ := N_mod.prod P_ram
  let G_sup : Subgroup Γ := U_mod ⊔ K_adm
  have h_ex_inv : ∀ (x : R_F), IsCoprime (Ideal.span {x}) m₀ →
      ∃ r : R_F, Ideal.Quotient.mk m₀ x * Ideal.Quotient.mk m₀ r = 1 := by
    intro x hx
    have h_sup : Ideal.span {x} ⊔ m₀ = ⊤ := Ideal.isCoprime_iff_sup_eq.mp hx
    have h_one : (1 : R_F) ∈ Ideal.span {x} ⊔ m₀ := by
      rw [h_sup]
      exact Submodule.mem_top
    rcases Submodule.mem_sup.mp h_one with ⟨u, hu_x, v, hv_m, huv⟩
    rcases Ideal.mem_span_singleton'.mp hu_x with ⟨r, rfl⟩
    refine ⟨r, ?_⟩
    rw [← map_mul]
    change Ideal.Quotient.mk m₀ (x * r) = Ideal.Quotient.mk m₀ 1
    apply Ideal.Quotient.eq.mpr
    have h_eq : x * r - 1 = -v := by linear_combination huv
    rw [h_eq]
    exact m₀.neg_mem hv_m
  let u_mod : ∀ (x : R_F), IsCoprime (Ideal.span {x}) m₀ → (R_F ⧸ m₀)ˣ :=
    fun x hx =>
      let r := Classical.choose (h_ex_inv x hx)
      let hr := Classical.choose_spec (h_ex_inv x hx)
      ⟨Ideal.Quotient.mk m₀ x, Ideal.Quotient.mk m₀ r, hr, by rw [mul_comm, hr]⟩
  let sgn_of : R_F → (W_real → ℤˣ) :=
    fun x w => if 0 < (w.1.embedding (x : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)
  have h_inj_R : Function.Injective (algebraMap R_F F) :=
    FaithfulSMul.algebraMap_injective R_F F
  have h_sgn_mul : ∀ (x y : R_F), x ≠ 0 → y ≠ 0 → sgn_of (x * y) = sgn_of x * sgn_of y := by
    intro x y hx_ne hy_ne
    funext w
    change (if 0 < (w.1.embedding ((x * y : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) =
      (if 0 < (w.1.embedding (x : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) *
      (if 0 < (w.1.embedding (y : F)).re then (1 : ℤˣ) else (-1 : ℤˣ))
    let φ : F →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal w.2
    have hφ_re : ∀ z : R_F, (w.1.embedding (z : F)).re = φ (z : F) := by
      intro z
      rw [← NumberField.InfinitePlace.embedding_of_isReal_apply w.2 (z : F), Complex.ofReal_re]
    rw [hφ_re (x * y), hφ_re x, hφ_re y]
    have hφ_mul : φ ((x * y : R_F) : F) = φ (x : F) * φ (y : F) := by
      push_cast
      rw [map_mul]
    rw [hφ_mul]
    have hφx_ne : φ (x : F) ≠ 0 := by
      intro h0
      rw [← map_zero φ] at h0
      have hx_F0 : (x : F) = 0 := φ.injective h0
      rw [← map_zero (algebraMap R_F F)] at hx_F0
      exact hx_ne (h_inj_R hx_F0)
    have hφy_ne : φ (y : F) ≠ 0 := by
      intro h0
      rw [← map_zero φ] at h0
      have hy_F0 : (y : F) = 0 := φ.injective h0
      rw [← map_zero (algebraMap R_F F)] at hy_F0
      exact hy_ne (h_inj_R hy_F0)
    rcases lt_or_gt_of_ne hφx_ne with hx_neg | hx_pos
    · have hx_not_pos : ¬ (0 < φ (x : F)) := not_lt_of_gt hx_neg
      rcases lt_or_gt_of_ne hφy_ne with hy_neg | hy_pos
      · have hy_not_pos : ¬ (0 < φ (y : F)) := not_lt_of_gt hy_neg
        have hxy_pos : 0 < φ (x : F) * φ (y : F) := mul_pos_of_neg_of_neg hx_neg hy_neg
        rw [if_pos hxy_pos, if_neg hx_not_pos, if_neg hy_not_pos]
        rfl
      · have hxy_neg : φ (x : F) * φ (y : F) < 0 := mul_neg_of_neg_of_pos hx_neg hy_pos
        have hxy_not_pos : ¬ (0 < φ (x : F) * φ (y : F)) := not_lt_of_gt hxy_neg
        rw [if_neg hxy_not_pos, if_neg hx_not_pos, if_pos hy_pos]
        rfl
    · rcases lt_or_gt_of_ne hφy_ne with hy_neg | hy_pos
      · have hy_not_pos : ¬ (0 < φ (y : F)) := not_lt_of_gt hy_neg
        have hxy_neg : φ (x : F) * φ (y : F) < 0 := mul_neg_of_pos_of_neg hx_pos hy_neg
        have hxy_not_pos : ¬ (0 < φ (x : F) * φ (y : F)) := not_lt_of_gt hxy_neg
        rw [if_neg hxy_not_pos, if_pos hx_pos, if_neg hy_not_pos]
        rfl
      · have hxy_pos : 0 < φ (x : F) * φ (y : F) := mul_pos hx_pos hy_pos
        rw [if_pos hxy_pos, if_pos hx_pos, if_pos hy_pos]
        rfl
  let γ : ∀ (x : R_F), IsCoprime (Ideal.span {x}) m₀ → Γ :=
    fun x hx => (u_mod x hx, sgn_of x)
  have hγ_congr : ∀ (x y : R_F) (hx : IsCoprime (Ideal.span {x}) m₀)
      (hy : IsCoprime (Ideal.span {y}) m₀), x = y → γ x hx = γ y hy := by
    rintro x _ hx hy rfl
    rfl
  have hγ_mul : ∀ (x y : R_F) (hx_ne : x ≠ 0) (hy_ne : y ≠ 0)
      (hx : IsCoprime (Ideal.span {x}) m₀) (hy : IsCoprime (Ideal.span {y}) m₀)
      (hxy : IsCoprime (Ideal.span {x * y}) m₀),
      γ (x * y) hxy = γ x hx * γ y hy := by
    intro x y hx_ne hy_ne hx hy hxy
    exact Prod.ext (Units.ext (map_mul (Ideal.Quotient.mk m₀) x y)) (h_sgn_mul x y hx_ne hy_ne)
  have hγ_ray : ∀ (a : R_F) (ha_cop : IsCoprime (Ideal.span {a}) m₀),
      a - 1 ∈ m₀ →
      (∀ w : NumberField.InfinitePlace F, w.IsReal → 0 < (w.embedding (a : F)).re) →
      γ a ha_cop = 1 := by
    intro a ha_cop ha_m ha_pos
    refine Prod.ext (Units.ext ?_) (funext fun w => ?_)
    · change Ideal.Quotient.mk m₀ a = Ideal.Quotient.mk m₀ 1
      exact Ideal.Quotient.eq.mpr ha_m
    · change (if 0 < (w.1.embedding (a : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) = 1
      exact if_pos (ha_pos w.1 w.2)
  have hγ_norm : ∀ (b : R_E), b ≠ 0 →
      ∀ (hb_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀),
        γ (Algebra.intNorm R_F R_E b) hb_cop ∈ K_adm := by
    intro b hb_ne hb_cop
    refine Subgroup.mem_prod.mpr ⟨?_, ?_⟩
    · exact Subgroup.subset_closure ⟨b, rfl⟩
    · refine Subgroup.subset_closure (fun w hw_ram => ?_)
      change (if 0 < (w.1.embedding ((Algebra.intNorm R_F R_E b : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) = 1
      exact if_pos (h_norm_pos b hb_ne w.1 w.2 hw_ram)
  let ψ_F : R_Fˣ →* Γ :=
    { toFun := fun u => (Units.map (Ideal.Quotient.mk m₀ : R_F →* R_F ⧸ m₀) u, sgn_of (u : R_F))
      map_one' := Prod.ext rfl (funext fun w => by
        change (if 0 < (w.1.embedding (algebraMap R_F F 1)).re then (1 : ℤˣ) else (-1 : ℤˣ)) = 1
        simp only [map_one, Complex.one_re, zero_lt_one, ↓reduceIte])
      map_mul' := fun u₁ u₂ => Prod.ext (map_mul _ u₁ u₂)
        (h_sgn_mul (u₁ : R_F) (u₂ : R_F) (Units.ne_zero u₁) (Units.ne_zero u₂)) }
  have hU_mod_le : U_mod ≤ ψ_F.range := by
    refine (Subgroup.closure_le _).mpr ?_
    rintro g ⟨u, hg₁, hg₂⟩
    exact ⟨u, Prod.ext hg₁.symm hg₂.symm⟩
  
  have h_intNorm_ne_zero : ∀ b : R_E, b ≠ 0 → Algebra.intNorm R_F R_E b ≠ 0 := by
    intro b hb_ne h0
    have h_alg := Algebra.algebraMap_intNorm (A := R_F) (K := F) (L := E) (B := R_E) b
    rw [h0, map_zero] at h_alg
    have hb_E_ne : algebraMap R_E E b ≠ 0 := by
      intro hbE0
      rw [← map_zero (algebraMap R_E E)] at hbE0
      exact hb_ne (FaithfulSMul.algebraMap_injective R_E E hbE0)
    exact (Algebra.norm_ne_zero_iff.mpr hb_E_ne) h_alg.symm
  have h_cop_of_sub_one_mem : ∀ a : R_F, a - 1 ∈ m₀ → IsCoprime (Ideal.span {a}) m₀ := by
    intro a ha_m
    rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
    have ha_mem : a ∈ Ideal.span ({a} : Set R_F) := Ideal.subset_span (Set.mem_singleton a)
    have h_neg : 1 - a ∈ m₀ := by
      have h1 : -(a - 1) ∈ m₀ := m₀.neg_mem ha_m
      rwa [neg_sub] at h1
    have h_sum : a + (1 - a) ∈ Ideal.span {a} ⊔ m₀ := Submodule.add_mem_sup ha_mem h_neg
    rwa [add_sub_cancel] at h_sum
  have h_ex_gen : ∀ p : S_pnorm,
      ∃ (g : R_F) (hg_ne : g ≠ 0) (hg_cop : IsCoprime (Ideal.span {g}) m₀),
        J_all p.1 = Ideal.span {g} ∧ γ g hg_cop ∈ K_adm := by
    intro p
    rcases p.2 with ⟨a₁, a₂, b₁, b₂, ha₁_ne, ha₂_ne, hb₁_ne, hb₂_ne,
      hb₁_cop, hb₂_cop, ha₁_m, ha₂_m, ha_pos, h_ideal_eq⟩
    let n₁ : R_F := Algebra.intNorm R_F R_E b₁
    let n₂ : R_F := Algebra.intNorm R_F R_E b₂
    have hn₁_ne : n₁ ≠ 0 := h_intNorm_ne_zero b₁ hb₁_ne
    have hn₂_ne : n₂ ≠ 0 := h_intNorm_ne_zero b₂ hb₂_ne
    have h_span_eq : J_all p.1 * Ideal.span {a₁ * n₁} = Ideal.span {a₂ * n₂} := by
      rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton,
        ← mul_assoc]
      exact h_ideal_eq
    have h_le_span : Ideal.span {a₂ * n₂} ≤ Ideal.span {a₁ * n₁} := by
      rw [← h_span_eq]
      exact Ideal.mul_le_left
    rcases Ideal.span_singleton_le_span_singleton.mp h_le_span with ⟨g, hg_mul⟩
    have ha₁n₁_ne : a₁ * n₁ ≠ 0 := mul_ne_zero ha₁_ne hn₁_ne
    have ha₁n₁_span_ne_zero : Ideal.span ({a₁ * n₁} : Set R_F) ≠ 0 := by
      rw [Submodule.zero_eq_bot]
      exact Ideal.span_singleton_eq_bot.not.mpr ha₁n₁_ne
    have hJ_span : J_all p.1 = Ideal.span {g} := by
      apply mul_right_cancel₀ ha₁n₁_span_ne_zero
      rw [h_span_eq, hg_mul, mul_comm (a₁ * n₁) g, ← Ideal.span_singleton_mul_span_singleton]
    have hg_ne : g ≠ 0 := by
      intro hg0
      apply (hJ_prop p.1).1
      rw [hJ_span, Ideal.span_singleton_eq_bot.mpr hg0]
    have hg_cop : IsCoprime (Ideal.span {g}) m₀ := by
      rw [← hJ_span]
      exact (hJ_prop p.1).2
    have ha₁_cop : IsCoprime (Ideal.span {a₁}) m₀ := h_cop_of_sub_one_mem a₁ ha₁_m
    have ha₂_cop : IsCoprime (Ideal.span {a₂}) m₀ := h_cop_of_sub_one_mem a₂ ha₂_m
    have ha₁n₁_cop : IsCoprime (Ideal.span {a₁ * n₁}) m₀ := by
      rw [← Ideal.span_singleton_mul_span_singleton]
      exact IsCoprime.mul_left ha₁_cop hb₁_cop
    have ha₂n₂_cop : IsCoprime (Ideal.span {a₂ * n₂}) m₀ := by
      rw [← Ideal.span_singleton_mul_span_singleton]
      exact IsCoprime.mul_left ha₂_cop hb₂_cop
    have ha₁n₁g_cop : IsCoprime (Ideal.span {(a₁ * n₁) * g}) m₀ := by
      rw [← Ideal.span_singleton_mul_span_singleton]
      exact IsCoprime.mul_left ha₁n₁_cop hg_cop
    have hγ_lhs : γ ((a₁ * n₁) * g) ha₁n₁g_cop = γ n₁ hb₁_cop * γ g hg_cop := by
      rw [hγ_mul (a₁ * n₁) g ha₁n₁_ne hg_ne ha₁n₁_cop hg_cop ha₁n₁g_cop,
        hγ_mul a₁ n₁ ha₁_ne hn₁_ne ha₁_cop hb₁_cop ha₁n₁_cop,
        hγ_ray a₁ ha₁_cop ha₁_m (fun w hw => (ha_pos w hw).1),
        one_mul]
    have hγ_rhs : γ (a₂ * n₂) ha₂n₂_cop = γ n₂ hb₂_cop := by
      rw [hγ_mul a₂ n₂ ha₂_ne hn₂_ne ha₂_cop hb₂_cop ha₂n₂_cop,
        hγ_ray a₂ ha₂_cop ha₂_m (fun w hw => (ha_pos w hw).2),
        one_mul]
    have hγ_eq_both : γ ((a₁ * n₁) * g) ha₁n₁g_cop = γ (a₂ * n₂) ha₂n₂_cop :=
      hγ_congr ((a₁ * n₁) * g) (a₂ * n₂) ha₁n₁g_cop ha₂n₂_cop hg_mul.symm
    rw [hγ_lhs, hγ_rhs] at hγ_eq_both
    have hγ_g_eq : γ g hg_cop = (γ n₁ hb₁_cop)⁻¹ * γ n₂ hb₂_cop :=
      eq_inv_mul_of_mul_eq hγ_eq_both
    have hγ_g_mem : γ g hg_cop ∈ K_adm := by
      rw [hγ_g_eq]
      exact K_adm.mul_mem (K_adm.inv_mem (hγ_norm b₁ hb₁_ne hb₁_cop)) (hγ_norm b₂ hb₂_ne hb₂_cop)
    exact ⟨g, hg_ne, hg_cop, hJ_span, hγ_g_mem⟩
  
  choose g_of hg_ne hg_cop hJ_span hγ_mem using h_ex_gen
  let Φ : S_pnorm → G_sup ⧸ U_mod.subgroupOf G_sup :=
    fun p => QuotientGroup.mk ⟨γ (g_of p) (hg_cop p), Subgroup.mem_sup_right (hγ_mem p)⟩
  have hΦ_inj : Function.Injective Φ := by
    intro p₁ p₂ hΦ
    have h_quo : (⟨γ (g_of p₁) (hg_cop p₁), Subgroup.mem_sup_right (hγ_mem p₁)⟩ : G_sup)⁻¹ *
        ⟨γ (g_of p₂) (hg_cop p₂), Subgroup.mem_sup_right (hγ_mem p₂)⟩ ∈
        U_mod.subgroupOf G_sup :=
      QuotientGroup.eq.mp hΦ
    have h_in_U : (γ (g_of p₁) (hg_cop p₁))⁻¹ * γ (g_of p₂) (hg_cop p₂) ∈ U_mod :=
      Subgroup.mem_subgroupOf.mp h_quo
    rcases hU_mod_le h_in_U with ⟨u, hu_eq⟩
    let c₁ : R_F := g_of p₁ * (u : R_F)
    let c₂ : R_F := g_of p₂
    have hJ₁_span : J_all p₁.1 = Ideal.span {c₁} := by
      rw [hJ_span p₁, ← Ideal.span_singleton_mul_right_unit u.isUnit (g_of p₁)]
    have hJ₂_span : J_all p₂.1 = Ideal.span {c₂} := hJ_span p₂
    have hc₁_ne : c₁ ≠ 0 := mul_ne_zero (hg_ne p₁) (Units.ne_zero u)
    have hc₂_ne : c₂ ≠ 0 := hg_ne p₂
    have hc₁_cop : IsCoprime (Ideal.span {c₁}) m₀ := by
      rw [← hJ₁_span]
      exact (hJ_prop p₁.1).2
    have hu_cop : IsCoprime (Ideal.span {(u : R_F)}) m₀ := by
      rw [Ideal.span_singleton_eq_top.mpr u.isUnit]
      exact h_top_cop
    have hγ_u : γ (u : R_F) hu_cop = ψ_F u := by
      exact Prod.ext (Units.ext rfl) rfl
    have hγ_c₁_c₂ : γ c₂ (hg_cop p₂) = γ c₁ hc₁_cop := by
      have h1 : γ (g_of p₂) (hg_cop p₂) = γ (g_of p₁) (hg_cop p₁) * ψ_F u :=
        (eq_inv_mul_iff_mul_eq.mp hu_eq).symm
      rw [h1, ← hγ_u, ← hγ_mul (g_of p₁) (u : R_F) (hg_ne p₁) (Units.ne_zero u) (hg_cop p₁) hu_cop hc₁_cop]
    have h_mk_eq : Ideal.Quotient.mk m₀ c₂ = Ideal.Quotient.mk m₀ c₁ :=
      congrArg (fun g : Γ => (g.1 : R_F ⧸ m₀)) hγ_c₁_c₂
    have hc_sub : c₂ - c₁ ∈ m₀ := Ideal.Quotient.eq.mp h_mk_eq
    have h_sgn_eq : sgn_of c₂ = sgn_of c₁ := congrArg Prod.snd hγ_c₁_c₂
    have hc_sign : ∀ w : NumberField.InfinitePlace F,
        w.IsReal → (0 < (w.embedding (c₁ : F)).re ↔ 0 < (w.embedding (c₂ : F)).re) := by
      intro w hw
      have hw_eq : sgn_of c₁ ⟨w, hw⟩ = sgn_of c₂ ⟨w, hw⟩ :=
        congrFun h_sgn_eq.symm ⟨w, hw⟩
      change (if 0 < (w.embedding (c₁ : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) =
        (if 0 < (w.embedding (c₂ : F)).re then (1 : ℤˣ) else (-1 : ℤˣ)) at hw_eq
      constructor
      · intro h₁
        rw [if_pos h₁] at hw_eq
        by_contra h₂
        rw [if_neg h₂] at hw_eq
        exact absurd (congrArg Units.val hw_eq) (by decide : (1 : ℤ) ≠ -1)
      · intro h₂
        rw [if_pos h₂] at hw_eq
        by_contra h₁
        rw [if_neg h₁] at hw_eq
        exact absurd (congrArg Units.val hw_eq) (by decide : (-1 : ℤ) ≠ 1)
    have h_sup : Ideal.span {c₁} ⊔ m₀ = ⊤ := Ideal.isCoprime_iff_sup_eq.mp hc₁_cop
    have h_one : (1 : R_F) ∈ Ideal.span {c₁} ⊔ m₀ := by
      rw [h_sup]
      exact Submodule.mem_top
    rcases Submodule.mem_sup.mp h_one with ⟨a₀, ha₀_c₁, y₀, hy₀_m, ha₀_y₀⟩
    have ha₀_m : a₀ - 1 ∈ m₀ := by
      have h_eq : a₀ - 1 = -y₀ := by linear_combination ha₀_y₀
      rw [h_eq]
      exact m₀.neg_mem hy₀_m
    have hcm_ne : Ideal.span {c₁} * m₀ ≠ ⊥ := by
      have h1 : Ideal.span ({c₁} : Set R_F) ≠ 0 := by
        rw [Submodule.zero_eq_bot]
        exact Ideal.span_singleton_eq_bot.not.mpr hc₁_ne
      have h2 : m₀ ≠ 0 := by rwa [Submodule.zero_eq_bot]
      rw [← Submodule.zero_eq_bot]
      exact mul_ne_zero h1 h2
    let M : ℕ := Ideal.absNorm (Ideal.span {c₁} * m₀)
    have hM_pos : 0 < M :=
      Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
        (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact hcm_ne))
    have hM_one_le : (1 : ℝ) ≤ (M : ℝ) := Nat.one_le_cast.mpr hM_pos
    have hM_mem : (M : R_F) ∈ Ideal.span {c₁} * m₀ := Ideal.absNorm_mem (Ideal.span {c₁} * m₀)
    have hM_c₁ : (M : R_F) ∈ Ideal.span {c₁} := Ideal.mul_le_right hM_mem
    have hM_m : (M : R_F) ∈ m₀ := Ideal.mul_le_left hM_mem
    obtain ⟨t, ht⟩ := exists_nat_gt (∑ w : NumberField.InfinitePlace F, |(w.embedding (a₀ : F)).re|)
    let a₁' : R_F := a₀ + (t : R_F) * (M : R_F)
    have ha₁'_c₁ : a₁' ∈ Ideal.span {c₁} :=
      (Ideal.span {c₁}).add_mem ha₀_c₁ ((Ideal.span {c₁}).mul_mem_left (t : R_F) hM_c₁)
    have ha₁'_m : a₁' - 1 ∈ m₀ := by
      have h_eq : a₁' - 1 = (a₀ - 1) + (t : R_F) * (M : R_F) := by dsimp [a₁']; ring
      rw [h_eq]
      exact m₀.add_mem ha₀_m (m₀.mul_mem_left (t : R_F) hM_m)
    have ha₁'_pos_all : ∀ w₀ : NumberField.InfinitePlace F, 0 < (w₀.embedding (a₁' : F)).re := by
      intro w₀
      have h_le_sum : |(w₀.embedding (a₀ : F)).re| ≤
          ∑ w : NumberField.InfinitePlace F, |(w.embedding (a₀ : F)).re| :=
        Finset.single_le_sum (f := fun w : NumberField.InfinitePlace F => |(w.embedding (a₀ : F)).re|)
          (fun w _ => abs_nonneg _) (Finset.mem_univ w₀)
      have h_neg_le : -|(w₀.embedding (a₀ : F)).re| ≤ (w₀.embedding (a₀ : F)).re :=
        neg_abs_le _
      have ht_nonneg : (0 : ℝ) ≤ (t : ℝ) := Nat.cast_nonneg t
      have htM_ge : (t : ℝ) ≤ (t : ℝ) * (M : ℝ) := le_mul_of_one_le_right ht_nonneg hM_one_le
      have h_re_eq : (w₀.embedding (a₁' : F)).re =
          (w₀.embedding (a₀ : F)).re + (t : ℝ) * (M : ℝ) := by
        change (w₀.embedding (algebraMap R_F F (a₀ + (t : R_F) * (M : R_F)))).re = _
        simp only [map_add, map_mul, map_natCast, Complex.add_re, Complex.mul_re,
          Complex.natCast_re, Complex.natCast_im, mul_zero, sub_zero]
        rfl
      linarith
    have ha₁'_ne : a₁' ≠ 0 := by
      intro ha0
      obtain ⟨w₀⟩ := (inferInstance : Nonempty (NumberField.InfinitePlace F))
      have h_pos := ha₁'_pos_all w₀
      rw [ha0] at h_pos
      change 0 < (w₀.embedding (algebraMap R_F F 0)).re at h_pos
      simp only [map_zero, Complex.zero_re, lt_self_iff_false] at h_pos
    rcases Ideal.mem_span_singleton'.mp ha₁'_c₁ with ⟨d, hd_eq⟩
    have hd_ne : d ≠ 0 := by
      intro hd0
      rw [hd0, zero_mul] at hd_eq
      exact ha₁'_ne hd_eq.symm
    let I₀ : Ideal R_F := Ideal.span {d}
    have hI₀_ne : I₀ ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hd_ne
    let a₂' : R_F := d * c₂
    have hIJ₁ : I₀ * J_all p₁.1 = Ideal.span {a₁'} := by
      rw [hJ₁_span, Ideal.span_singleton_mul_span_singleton, hd_eq]
    have hIJ₂ : I₀ * J_all p₂.1 = Ideal.span {a₂'} := by
      rw [hJ₂_span, Ideal.span_singleton_mul_span_singleton]
    have ha₂'_m : a₂' - 1 ∈ m₀ := by
      have h_eq : a₂' - 1 = d * (c₂ - c₁) + (a₁' - 1) := by
        dsimp [a₂']
        linear_combination hd_eq
      rw [h_eq]
      exact m₀.add_mem (m₀.mul_mem_left d hc_sub) ha₁'_m
    have ha₂'_pos : ∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a₂' : F)).re := by
      intro w hw
      let φ : F →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have hφ_re : ∀ x : R_F, (w.embedding (x : F)).re = φ (x : F) := by
        intro x
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : F), Complex.ofReal_re]
      have hφ_c₁_ne : φ (c₁ : F) ≠ 0 := by
        intro h0
        rw [← map_zero φ] at h0
        have hc₁_F0 : (c₁ : F) = 0 := φ.injective h0
        rw [← map_zero (algebraMap R_F F)] at hc₁_F0
        exact hc₁_ne (h_inj_R hc₁_F0)
      have hφ_c₂_ne : φ (c₂ : F) ≠ 0 := by
        intro h0
        rw [← map_zero φ] at h0
        have hc₂_F0 : (c₂ : F) = 0 := φ.injective h0
        rw [← map_zero (algebraMap R_F F)] at hc₂_F0
        exact hc₂_ne (h_inj_R hc₂_F0)
      have h_sign_iff : 0 < φ (c₁ : F) ↔ 0 < φ (c₂ : F) := by
        rw [← hφ_re c₁, ← hφ_re c₂]
        exact hc_sign w hw
      have h_prod_c_pos : 0 < φ (c₁ : F) * φ (c₂ : F) := by
        rcases lt_or_gt_of_ne hφ_c₁_ne with hc₁_neg | hc₁_pos
        · have hc₂_not_pos : ¬ (0 < φ (c₂ : F)) := by
            intro hc₂_pos
            have hc₁_pos : 0 < φ (c₁ : F) := h_sign_iff.mpr hc₂_pos
            linarith
          have hc₂_neg : φ (c₂ : F) < 0 :=
            lt_of_le_of_ne (not_lt.mp hc₂_not_pos) hφ_c₂_ne
          exact mul_pos_of_neg_of_neg hc₁_neg hc₂_neg
        · have hc₂_pos : 0 < φ (c₂ : F) := h_sign_iff.mp hc₁_pos
          exact mul_pos hc₁_pos hc₂_pos
      have hφ_a₁'_pos : 0 < φ (a₁' : F) := by
        rw [← hφ_re a₁']
        exact ha₁'_pos_all w
      have h_eq_R : φ (a₁' : F) * φ (c₂ : F) = φ (c₁ : F) * φ (a₂' : F) := by
        have h_eq_RF : a₁' * c₂ = c₁ * a₂' := by
          dsimp [a₂']
          linear_combination -c₂ * hd_eq
        have h_eq_F : (a₁' : F) * (c₂ : F) = (c₁ : F) * (a₂' : F) := by
          exact_mod_cast h_eq_RF
        simpa only [map_mul] using congrArg φ h_eq_F
      have h_sq_eq : (φ (c₁ : F) * φ (c₁ : F)) * φ (a₂' : F) =
          φ (a₁' : F) * (φ (c₁ : F) * φ (c₂ : F)) := by
        linear_combination φ (c₁ : F) * h_eq_R.symm
      have h_rhs_pos : 0 < φ (a₁' : F) * (φ (c₁ : F) * φ (c₂ : F)) :=
        mul_pos hφ_a₁'_pos h_prod_c_pos
      have h_lhs_pos : 0 < (φ (c₁ : F) * φ (c₁ : F)) * φ (a₂' : F) := by
        rwa [h_sq_eq]
      have h_sq_nonneg : 0 ≤ φ (c₁ : F) * φ (c₁ : F) := mul_self_nonneg (φ (c₁ : F))
      have hφ_a₂'_pos : 0 < φ (a₂' : F) := pos_of_mul_pos_right h_lhs_pos h_sq_nonneg
      rwa [hφ_re a₂']
    have hp_eq : p₁.1 = p₂.1 :=
      hJ_inj I₀ p₁.1 p₂.1 hI₀_ne
        ⟨a₁', ha₁'_m, fun w _ => ha₁'_pos_all w, hIJ₁⟩
        ⟨a₂', ha₂'_m, ha₂'_pos, hIJ₂⟩
    exact Subtype.ext hp_eq
  haveI : Finite (R_F ⧸ m₀) := Ideal.finiteQuotientOfFreeOfNeBot m₀ hm₀_ne
  have h_card_le : Nat.card S_pnorm ≤ Nat.card (G_sup ⧸ U_mod.subgroupOf G_sup) :=
    Nat.card_le_card_of_injective Φ hΦ_inj
  have h_rel_eq : Nat.card (G_sup ⧸ U_mod.subgroupOf G_sup) = U_mod.relIndex G_sup := by
    rw [Subgroup.relIndex, Subgroup.index_eq_card]
  rw [h_rel_eq] at h_card_le
  exact ⟨hSpnorm_pos, h_card_le⟩

theorem principal_narrow_ray_norm_cells_card_bound_of_nonzero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E]
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ j : Fin N_ray,
        ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j = Ideal.span {a})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₁ = Ideal.span {a}) →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₂ = Ideal.span {a}) →
      j₁ = j₂) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let N_mod : Subgroup (R_F ⧸ m₀)ˣ := Subgroup.closure { u : (R_F ⧸ m₀)ˣ |
      ∃ b : R_E,
        (u : R_F ⧸ m₀) = Ideal.Quotient.mk m₀ (Algebra.intNorm R_F R_E b) }
    let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
      ∃ b₁ b₂ : R_E,
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
    let S_pnorm := { j : Fin N_ray //
      ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all j * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
          Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} }
    0 < Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) ∧
    0 < Nat.card S_pnorm ∧
    2 ^ (Nat.card { w : NumberField.InfinitePlace F //
      w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal }) *
      Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) *
      Nat.card S_pnorm ≤
    Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } *
      Nat.card (R_Fˣ ⧸ H_unr) :=
by
  intro R_F R_E N_mod H_unr S_pnorm
  have h_norm_pos : ∀ (b : R_E), b ≠ 0 →
      ∀ (w : NumberField.InfinitePlace F),
        w.IsReal →
        (∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal) →
        0 < (w.embedding ((Algebra.intNorm R_F R_E b : R_F) : F)).re :=
    fun b hb w hw h_ram => intNorm_pos_at_ramified_real_infinitePlace b hb w hw h_ram
  have h_s2 :=
    principal_narrow_ray_cells_card_ge_unit_mod_index m₀ hm₀_ne N_ray J_all hJ_prop hJ_cov
  obtain ⟨hQmod_pos, h_prod_idx, h_unit_rel⟩ :=
    admissible_norm_sign_subgroup_index_and_unit_relIndex_le_of_nonzero m₀ hm₀_ne h_norm_pos
  obtain ⟨hSpnorm_pos, h_pnorm_rel⟩ :=
    pnorm_narrow_ray_cells_card_pos_and_le_relIndex m₀ hm₀_ne N_ray J_all hJ_prop hJ_cov hJ_inj h_norm_pos
  let U_mod : Subgroup ((R_F ⧸ m₀)ˣ × ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ)) :=
    Subgroup.closure { g | ∃ u : R_Fˣ,
      g.1 = Units.map (Ideal.Quotient.mk m₀ : R_F →* R_F ⧸ m₀) u ∧
      g.2 = fun w => if 0 < (w.1.embedding ((u : R_F) : F)).re then (1 : ℤˣ) else (-1 : ℤˣ) }
  let P_ram : Subgroup ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ) :=
    Subgroup.closure { s | ∀ w : { w : NumberField.InfinitePlace F // w.IsReal },
      (∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w.1 → ¬ w_E.IsReal) →
      s w = 1 }
  let K_adm : Subgroup ((R_F ⧸ m₀)ˣ × ({ w : NumberField.InfinitePlace F // w.IsReal } → ℤˣ)) :=
    N_mod.prod P_ram
  change U_mod.index ≤ Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } at h_s2
  change K_adm.index =
    2 ^ (Nat.card { w : NumberField.InfinitePlace F //
      w.IsReal ∧ ∀ w_E : NumberField.InfinitePlace E, w_E.comap (algebraMap F E) = w → ¬ w_E.IsReal }) *
      Nat.card ((R_F ⧸ m₀)ˣ ⧸ N_mod) at h_prod_idx
  change K_adm.relIndex U_mod ≤ Nat.card (R_Fˣ ⧸ H_unr) at h_unit_rel
  change Nat.card S_pnorm ≤ U_mod.relIndex (U_mod ⊔ K_adm) at h_pnorm_rel
  have h_idx_U : U_mod.relIndex (U_mod ⊔ K_adm) * (U_mod ⊔ K_adm).index = U_mod.index :=
    Subgroup.relIndex_mul_index (le_sup_left : U_mod ≤ U_mod ⊔ K_adm)
  have h_idx_K : K_adm.relIndex U_mod * (U_mod ⊔ K_adm).index = K_adm.index := by
    rw [← Subgroup.relIndex_sup_right U_mod K_adm]
    exact Subgroup.relIndex_mul_index (le_sup_right : K_adm ≤ U_mod ⊔ K_adm)
  have h_diamond : K_adm.index * U_mod.relIndex (U_mod ⊔ K_adm) =
      U_mod.index * K_adm.relIndex U_mod := by
    calc
      K_adm.index * U_mod.relIndex (U_mod ⊔ K_adm)
          = (K_adm.relIndex U_mod * (U_mod ⊔ K_adm).index) * U_mod.relIndex (U_mod ⊔ K_adm) := by
              rw [h_idx_K]
      _ = (U_mod.relIndex (U_mod ⊔ K_adm) * (U_mod ⊔ K_adm).index) * K_adm.relIndex U_mod := by
              ring
      _ = U_mod.index * K_adm.relIndex U_mod := by
              rw [h_idx_U]
  refine ⟨hQmod_pos, hSpnorm_pos, ?_⟩
  rw [← h_prod_idx]
  calc
    K_adm.index * Nat.card S_pnorm
        ≤ K_adm.index * U_mod.relIndex (U_mod ⊔ K_adm) :=
          Nat.mul_le_mul_left K_adm.index h_pnorm_rel
    _ = U_mod.index * K_adm.relIndex U_mod := h_diamond
    _ ≤ Nat.card { j : Fin N_ray // (J_all j).IsPrincipal } * Nat.card (R_Fˣ ⧸ H_unr) :=
          Nat.mul_le_mul h_s2 h_unit_rel

theorem norm_ray_cells_card_le_classGroup_quotient_mul_pnorm {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (N_ray : ℕ)
    (J_all : Fin N_ray → Ideal (NumberField.RingOfIntegers F))
    (hJ_prop : ∀ j : Fin N_ray, J_all j ≠ ⊥ ∧ IsCoprime (J_all j) m₀)
    (hJ_cov : ∀ I : Ideal (NumberField.RingOfIntegers F),
      I ≠ ⊥ → IsCoprime I m₀ →
      ∃ j : Fin N_ray,
        ∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I * J_all j = Ideal.span {a})
    (hJ_inj : ∀ (I : Ideal (NumberField.RingOfIntegers F)) (j₁ j₂ : Fin N_ray),
      I ≠ ⊥ →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₁ = Ideal.span {a}) →
      (∃ a : NumberField.RingOfIntegers F,
        a - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        I * J_all j₂ = Ideal.span {a}) →
      j₁ = j₂) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let S_pnorm := { j : Fin N_ray //
      ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all j * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
          Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} }
    let S_norm := { j : Fin N_ray //
      ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all j * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
          Ideal.span {a₂} * Ideal.relNorm R_F B₂ }
    ∃ σ_Cl : ClassGroup R_E →* ClassGroup R_E,
      (∀ (B : Ideal R_E) (hB : B ∈ nonZeroDivisors (Ideal R_E))
          (hBσ : Ideal.map σ_int B ∈ nonZeroDivisors (Ideal R_E)),
        σ_Cl (ClassGroup.mk0 ⟨B, hB⟩) =
          ClassGroup.mk0 ⟨Ideal.map σ_int B, hBσ⟩) ∧
      (∀ c : ClassGroup R_E,
        ∃ (B : Ideal R_E) (hB : B ∈ nonZeroDivisors (Ideal R_E)),
          IsCoprime (Ideal.relNorm R_F B) m₀ ∧
          ClassGroup.mk0 ⟨B, hB⟩ = c) ∧
      (∀ (B₁ B₂ : Ideal R_E) (hB₁ : B₁ ∈ nonZeroDivisors (Ideal R_E))
          (hB₂ : B₂ ∈ nonZeroDivisors (Ideal R_E)),
        IsCoprime (Ideal.relNorm R_F B₁) m₀ →
        IsCoprime (Ideal.relNorm R_F B₂) m₀ →
        ClassGroup.mk0 ⟨B₁, hB₁⟩ = ClassGroup.mk0 ⟨B₂, hB₂⟩ →
        ∃ b₁ b₂ : R_E,
          b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
          B₁ * Ideal.span {b₁} = B₂ * Ideal.span {b₂}) ∧
      Nat.card S_norm ≤
        Nat.card (ClassGroup R_E ⧸ (MonoidHom.id (ClassGroup R_E) / σ_Cl).range) *
          Nat.card S_pnorm :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
  let S_pnorm := { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
      IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
        Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} }
  let S_norm := { j : Fin N_ray //
    ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      J_all j * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
        Ideal.span {a₂} * Ideal.relNorm R_F B₂ }
  
  have h_map_nzd : ∀ x : nonZeroDivisors (Ideal R_E),
      Ideal.map σ_int x.1 ∈ nonZeroDivisors (Ideal R_E) := by
    intro x
    apply mem_nonZeroDivisors_of_ne_zero
    rw [Submodule.zero_eq_bot]
    have hx_ne : x.1 ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot]
      exact nonZeroDivisors.ne_zero x.2
    exact (Ideal.map_eq_bot_iff_of_injective σ_int.injective).not.mpr hx_ne
  let f_σ : nonZeroDivisors (Ideal R_E) →* ClassGroup R_E :=
    { toFun := fun x => ClassGroup.mk0 ⟨Ideal.map σ_int x.1, h_map_nzd x⟩
      map_one' := by
        have h1 : (⟨Ideal.map σ_int (1 : nonZeroDivisors (Ideal R_E)).1, h_map_nzd 1⟩ : nonZeroDivisors (Ideal R_E)) = 1 := by
          apply Subtype.ext
          change Ideal.map σ_int (1 : Ideal R_E) = 1
          rw [Ideal.one_eq_top, Ideal.map_top]
        rw [h1, map_one]
      map_mul' := by
        intro x y
        have hmul : (⟨Ideal.map σ_int (x * y).1, h_map_nzd (x * y)⟩ : nonZeroDivisors (Ideal R_E)) =
            ⟨Ideal.map σ_int x.1, h_map_nzd x⟩ * ⟨Ideal.map σ_int y.1, h_map_nzd y⟩ := by
          apply Subtype.ext
          exact Ideal.map_mul σ_int x.1 y.1
        rw [hmul, map_mul] }
  have hf_eq : ∀ x y : nonZeroDivisors (Ideal R_E),
      ClassGroup.mk0 x = ClassGroup.mk0 y → f_σ x = f_σ y := by
    intro x y hxy
    rcases ClassGroup.mk0_eq_mk0_iff.mp hxy with ⟨a, b, ha, hb, hab⟩
    apply ClassGroup.mk0_eq_mk0_iff.mpr
    refine ⟨σ_int a, σ_int b,
      (map_ne_zero_iff σ_int σ_int.injective).mpr ha,
      (map_ne_zero_iff σ_int σ_int.injective).mpr hb, ?_⟩
    have hmap := congrArg (Ideal.map σ_int) hab
    simpa only [Ideal.map_mul, Ideal.map_span, Set.image_singleton] using hmap
  let σ_Cl_fun : ClassGroup R_E → ClassGroup R_E :=
    fun c => f_σ (Classical.choose (ClassGroup.mk0_surjective c))
  have hσ_Cl_mk0 : ∀ x : nonZeroDivisors (Ideal R_E),
      σ_Cl_fun (ClassGroup.mk0 x) = f_σ x := by
    intro x
    exact hf_eq _ x (Classical.choose_spec (ClassGroup.mk0_surjective (ClassGroup.mk0 x)))
  let σ_Cl : ClassGroup R_E →* ClassGroup R_E :=
    { toFun := σ_Cl_fun
      map_one' := by
        have h1 : σ_Cl_fun (ClassGroup.mk0 1) = f_σ 1 := hσ_Cl_mk0 1
        rw [map_one] at h1
        rw [h1, map_one]
      map_mul' := by
        intro c₁ c₂
        obtain ⟨x₁, rfl⟩ := ClassGroup.mk0_surjective c₁
        obtain ⟨x₂, rfl⟩ := ClassGroup.mk0_surjective c₂
        rw [← map_mul ClassGroup.mk0, hσ_Cl_mk0, hσ_Cl_mk0, hσ_Cl_mk0, map_mul] }
  have hσ_Cl : ∀ (B : Ideal R_E) (hB : B ∈ nonZeroDivisors (Ideal R_E))
      (hBσ : Ideal.map σ_int B ∈ nonZeroDivisors (Ideal R_E)),
      σ_Cl (ClassGroup.mk0 ⟨B, hB⟩) = ClassGroup.mk0 ⟨Ideal.map σ_int B, hBσ⟩ := by
    intro B hB hBσ
    exact hσ_Cl_mk0 ⟨B, hB⟩
  have h_cop_iff : ∀ (B : Ideal R_E) (I : Ideal R_F),
      IsCoprime (Ideal.relNorm R_F B) I ↔ IsCoprime B (Ideal.map (algebraMap R_F R_E) I) := by
    intro B I
    constructor
    · intro h_cop
      rw [Ideal.isCoprime_iff_sup_eq] at h_cop ⊢
      have h_map := congrArg (Ideal.map (algebraMap R_F R_E)) h_cop
      rw [Ideal.map_sup, Ideal.map_top] at h_map
      have h_le : Ideal.map (algebraMap R_F R_E) (Ideal.relNorm R_F B) ≤ B :=
        Ideal.map_le_iff_le_comap.mpr (Ideal.relNorm_le_comap R_F B)
      exact top_unique (h_map ▸ sup_le_sup_right h_le _)
    · intro h_cop
      let M_I : Ideal R_E := Ideal.map (algebraMap R_F R_E) I
      rcases Ideal.isCoprime_iff_exists.mp h_cop with ⟨x, hxB, y, hyM, hxy⟩
      have h_norm_prod : algebraMap R_F R_E (Algebra.intNorm R_F R_E x) =
          ∏ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ x := by
        apply FaithfulSMul.algebraMap_injective R_E E
        rw [← IsScalarTower.algebraMap_apply R_F R_E E,
          IsScalarTower.algebraMap_apply R_F F E,
          Algebra.algebraMap_intNorm (L := E),
          Algebra.norm_eq_prod_automorphisms, map_prod]
        congr 1
        ext ρ
        exact (algebraMap_galRestrict_apply R_F ρ x).symm
      have h_rho_one : ∀ ρ : E ≃ₐ[F] E,
          Ideal.Quotient.mk M_I (galRestrict R_F F E R_E ρ x) = 1 := by
        intro ρ
        let ρ_int := galRestrict R_F F E R_E ρ
        have h_comm : (ρ_int : R_E →+* R_E).comp (algebraMap R_F R_E) = algebraMap R_F R_E :=
          RingHom.ext (fun r => ρ_int.commutes r)
        have h_map_M : Ideal.map (ρ_int : R_E →+* R_E) M_I = M_I := by
          dsimp [M_I]
          rw [Ideal.map_map, h_comm]
        have hy_rho : ρ_int y ∈ M_I := by
          rw [← h_map_M]
          exact Ideal.mem_map_of_mem _ hyM
        have hxy_rho : ρ_int x + ρ_int y = 1 := by
          rw [← map_add, hxy, map_one]
        have hq : Ideal.Quotient.mk M_I (ρ_int x) + Ideal.Quotient.mk M_I (ρ_int y) = 1 := by
          rw [← map_add, hxy_rho, map_one]
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hy_rho, add_zero] at hq
        exact hq
      have h_norm_one : Ideal.Quotient.mk M_I (algebraMap R_F R_E (Algebra.intNorm R_F R_E x)) = 1 := by
        rw [h_norm_prod, map_prod]
        simp_rw [h_rho_one]
        exact Finset.prod_const_one
      have h_sub_mem : 1 - algebraMap R_F R_E (Algebra.intNorm R_F R_E x) ∈ M_I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, h_norm_one, sub_self]
      have hx_norm_mem : Algebra.intNorm R_F R_E x ∈ Ideal.relNorm R_F B := by
        rw [Ideal.relNorm_apply]
        exact Ideal.subset_span ⟨x, hxB, rfl⟩
      have h_alg_mem : algebraMap R_F R_E (Algebra.intNorm R_F R_E x) ∈
          Ideal.map (algebraMap R_F R_E) (Ideal.relNorm R_F B) :=
        Ideal.mem_map_of_mem _ hx_norm_mem
      have h_one_mem : (1 : R_E) ∈ Ideal.map (algebraMap R_F R_E) (Ideal.relNorm R_F B ⊔ I) := by
        rw [Ideal.map_sup]
        have h_add : (1 : R_E) = algebraMap R_F R_E (Algebra.intNorm R_F R_E x) +
            (1 - algebraMap R_F R_E (Algebra.intNorm R_F R_E x)) := by ring
        rw [h_add]
        exact Submodule.add_mem_sup h_alg_mem h_sub_mem
      have h_map_top : Ideal.map (algebraMap R_F R_E) (Ideal.relNorm R_F B ⊔ I) = ⊤ :=
        (Ideal.eq_top_iff_one _).mpr h_one_mem
      have h_sup_top : Ideal.relNorm R_F B ⊔ I = ⊤ :=
        (Ideal.map_eq_top_iff (algebraMap R_F R_E)
          (FaithfulSMul.algebraMap_injective R_F R_E)
          (algebraMap_isIntegral_iff.mpr inferInstance)).mp h_map_top
      exact Ideal.isCoprime_iff_sup_eq.mpr h_sup_top
  
  let M : Ideal R_E := Ideal.map (algebraMap R_F R_E) m₀
  have hM_ne : M ≠ ⊥ :=
    (Ideal.map_eq_bot_iff_of_injective (FaithfulSMul.algebraMap_injective R_F R_E)).not.mpr hm₀_ne
  have hM0 : M ≠ 0 := by rwa [Submodule.zero_eq_bot]
  have h_cop_inv : ∀ B : Ideal R_E,
      B ≠ ⊥ →
      ∃ (C : Ideal R_E) (b : R_E),
        C ≠ ⊥ ∧ b ≠ 0 ∧
        IsCoprime (Ideal.relNorm R_F C) m₀ ∧
        B * C = Ideal.span {b} := by
    intro B hB_ne
    have hB0 : B ≠ 0 := by rwa [Submodule.zero_eq_bot]
    by_cases hM_top : M = ⊤
    · obtain ⟨b, hbB, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hB_ne
      have hb_le : Ideal.span {b} ≤ B := (Ideal.span_singleton_le_iff_mem B).mpr hbB
      obtain ⟨C, hBC⟩ := Ideal.dvd_iff_le.mpr hb_le
      have hspan_ne : Ideal.span {b} ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hb0
      have hC_ne : C ≠ ⊥ := by
        intro hC_bot
        rw [hC_bot, ← Submodule.zero_eq_bot, mul_zero, Submodule.zero_eq_bot] at hBC
        exact hspan_ne hBC
      have hC_cop_M : IsCoprime C M := by
        rw [hM_top, Ideal.isCoprime_iff_sup_eq, sup_top_eq]
      exact ⟨C, b, hC_ne, hb0, (h_cop_iff C m₀).mpr hC_cop_M, hBC.symm⟩
    · have hBM0 : B * M ≠ 0 := mul_ne_zero hB0 hM0
      have hBM_le : B * M ≤ B := Ideal.mul_le_right
      obtain ⟨b, hb_sup⟩ := IsDedekindDomain.exists_sup_span_eq hBM_le hBM0
      have hb_le : Ideal.span {b} ≤ B := le_sup_right.trans hb_sup.le
      obtain ⟨C, hBC⟩ := Ideal.dvd_iff_le.mpr hb_le
      have h_mul_sup : B * (M ⊔ C) = B * ⊤ := by
        rw [Submodule.mul_sup, ← hBC, hb_sup, Ideal.mul_top]
      have h_sup_top : M ⊔ C = ⊤ := mul_left_cancel₀ hB0 h_mul_sup
      have hC_cop_M : IsCoprime C M := by
        rw [Ideal.isCoprime_iff_sup_eq, sup_comm]
        exact h_sup_top
      have hC_ne : C ≠ ⊥ := by
        intro hC_bot
        apply hM_top
        rw [hC_bot, sup_bot_eq] at h_sup_top
        exact h_sup_top
      have hC0 : C ≠ 0 := by rwa [Submodule.zero_eq_bot]
      have hBC_ne : B * C ≠ ⊥ := by
        rw [← Submodule.zero_eq_bot]
        exact mul_ne_zero hB0 hC0
      have hb0 : b ≠ 0 := by
        intro hb_z
        apply hBC_ne
        rw [← hBC, hb_z, Ideal.span_singleton_eq_bot.mpr rfl]
      exact ⟨C, b, hC_ne, hb0, (h_cop_iff C m₀).mpr hC_cop_M, hBC.symm⟩
  have h_cop_rep : ∀ c : ClassGroup R_E,
      ∃ (B : Ideal R_E) (hB : B ∈ nonZeroDivisors (Ideal R_E)),
        IsCoprime (Ideal.relNorm R_F B) m₀ ∧
        ClassGroup.mk0 ⟨B, hB⟩ = c := by
    intro c
    obtain ⟨J, hJ_mk⟩ := ClassGroup.mk0_surjective c⁻¹
    have hJ0 : J.1 ≠ 0 := nonZeroDivisors.ne_zero J.2
    have hJ_ne : J.1 ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    obtain ⟨B, b, hB_ne, _, hB_cop, hJB⟩ := h_cop_inv J.1 hJ_ne
    have hB0 : B ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hB_nzd : B ∈ nonZeroDivisors (Ideal R_E) := mem_nonZeroDivisors_of_ne_zero hB0
    have h_mul_one : ClassGroup.mk0 J * ClassGroup.mk0 ⟨B, hB_nzd⟩ = 1 := by
      rw [← map_mul]
      exact (ClassGroup.mk0_eq_one_iff _).mpr ⟨⟨b, hJB⟩⟩
    rw [hJ_mk] at h_mul_one
    exact ⟨B, hB_nzd, hB_cop, (mul_eq_one_iff_inv_eq.mp h_mul_one).symm.trans (inv_inv c)⟩
  have h_rep_eq : ∀ (B₁ B₂ : Ideal R_E) (hB₁ : B₁ ∈ nonZeroDivisors (Ideal R_E))
      (hB₂ : B₂ ∈ nonZeroDivisors (Ideal R_E)),
      IsCoprime (Ideal.relNorm R_F B₁) m₀ →
      IsCoprime (Ideal.relNorm R_F B₂) m₀ →
      ClassGroup.mk0 ⟨B₁, hB₁⟩ = ClassGroup.mk0 ⟨B₂, hB₂⟩ →
      ∃ b₁ b₂ : R_E,
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        B₁ * Ideal.span {b₁} = B₂ * Ideal.span {b₂} := by
    intro B₁ B₂ hB₁ hB₂ hB₁_cop hB₂_cop h_mk_eq
    have hB₁0 : B₁ ≠ 0 := nonZeroDivisors.ne_zero hB₁
    have hB₂0 : B₂ ≠ 0 := nonZeroDivisors.ne_zero hB₂
    have hB₁_ne : B₁ ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    obtain ⟨C, b₂, hC_ne, hb₂_ne, hC_cop, hB₁C⟩ := h_cop_inv B₁ hB₁_ne
    have hC0 : C ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hC_nzd : C ∈ nonZeroDivisors (Ideal R_E) := mem_nonZeroDivisors_of_ne_zero hC0
    have hB₁C_one : ClassGroup.mk0 (⟨B₁, hB₁⟩ * ⟨C, hC_nzd⟩) = 1 :=
      (ClassGroup.mk0_eq_one_iff _).mpr ⟨⟨b₂, hB₁C⟩⟩
    have hB₂C_one : ClassGroup.mk0 (⟨B₂, hB₂⟩ * ⟨C, hC_nzd⟩) = 1 := by
      rw [map_mul, ← h_mk_eq, ← map_mul, hB₁C_one]
    rcases (ClassGroup.mk0_eq_one_iff _).mp hB₂C_one with ⟨⟨b₁, hB₂C_raw⟩⟩
    have hB₂C : B₂ * C = Ideal.span {b₁} := hB₂C_raw
    have hB₂C_ne : B₂ * C ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot]
      exact mul_ne_zero hB₂0 hC0
    have hb₁_ne : b₁ ≠ 0 := by
      intro hb₁_z
      apply hB₂C_ne
      rw [hB₂C, hb₁_z, Ideal.span_singleton_eq_bot.mpr rfl]
    have hb₁_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ := by
      rw [← Ideal.relNorm_singleton]
      change IsCoprime (Ideal.relNorm R_F (Ideal.span {b₁})) m₀
      rw [← hB₂C, map_mul]
      exact IsCoprime.mul_left hB₂_cop hC_cop
    have hb₂_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ := by
      rw [← Ideal.relNorm_singleton]
      change IsCoprime (Ideal.relNorm R_F (Ideal.span {b₂})) m₀
      rw [← hB₁C, map_mul]
      exact IsCoprime.mul_left hB₁_cop hC_cop
    have h_eq_mul : (B₁ * Ideal.span {b₁}) * C = (B₂ * Ideal.span {b₂}) * C := by
      calc
        (B₁ * Ideal.span {b₁}) * C = B₁ * ((B₂ * C) * C) := by
          rw [mul_assoc, ← hB₂C]
        _ = B₂ * ((B₁ * C) * C) := by ring
        _ = (B₂ * Ideal.span {b₂}) * C := by
          rw [hB₁C, mul_assoc]
    exact ⟨b₁, b₂, hb₁_ne, hb₂_ne, hb₁_cop, hb₂_cop, mul_right_cancel₀ hC0 h_eq_mul⟩
  
  have h_split_nat : ∀ (n : ℕ) (B : Ideal R_E),
      Ideal.absNorm B = n → B ≠ ⊥ →
      ∃ (B_cop B_ram : Ideal R_E) (K : ℕ),
        B_cop ≠ ⊥ ∧ IsCoprime B_cop M ∧ B_ram ∣ M ^ K ∧ B = B_cop * B_ram := by
    intro n
    refine Nat.strong_induction_on n (fun n ih B hn hB_ne => ?_)
    by_cases h_cop : IsCoprime B M
    · exact ⟨B, 1, 0, hB_ne, h_cop, one_dvd _, (mul_one B).symm⟩
    · let D : Ideal R_E := B ⊔ M
      have hD_ne_top : D ≠ ⊤ := by
        intro h_top
        exact h_cop (Ideal.isCoprime_iff_sup_eq.mpr h_top)
      have hB_le_D : B ≤ D := le_sup_left
      obtain ⟨B', hDB'⟩ := Ideal.dvd_iff_le.mpr hB_le_D
      have hD_ne_bot : D ≠ ⊥ := by
        intro h_bot
        rw [h_bot, ← Submodule.zero_eq_bot, zero_mul, Submodule.zero_eq_bot] at hDB'
        exact hB_ne hDB'
      have hB'_ne_bot : B' ≠ ⊥ := by
        intro h_bot
        rw [h_bot, ← Submodule.zero_eq_bot, mul_zero, Submodule.zero_eq_bot] at hDB'
        exact hB_ne hDB'
      have hD_pos : 0 < Ideal.absNorm D :=
        Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
          (mem_nonZeroDivisors_of_ne_zero (by rwa [Submodule.zero_eq_bot]))
      have hB'_pos : 0 < Ideal.absNorm B' :=
        Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
          (mem_nonZeroDivisors_of_ne_zero (by rwa [Submodule.zero_eq_bot]))
      have hD_ne_one : Ideal.absNorm D ≠ 1 :=
        Ideal.absNorm_eq_one_iff.not.mpr hD_ne_top
      have hD_gt_one : 1 < Ideal.absNorm D := by omega
      have h_norm_lt : Ideal.absNorm B' < n := by
        rw [← hn, hDB', map_mul]
        nlinarith
      obtain ⟨B_cop, B_ram', K', hB_cop_ne, hB_cop_cop, hB_ram'_dvd, hB'_eq⟩ :=
        ih (Ideal.absNorm B') h_norm_lt B' rfl hB'_ne_bot
      have hD_dvd_M : D ∣ M := Ideal.dvd_iff_le.mpr le_sup_right
      have h_ram_dvd : D * B_ram' ∣ M ^ (K' + 1) := by
        rw [pow_succ']
        exact mul_dvd_mul hD_dvd_M hB_ram'_dvd
      refine ⟨B_cop, D * B_ram', K' + 1, hB_cop_ne, hB_cop_cop, h_ram_dvd, ?_⟩
      rw [hDB', hB'_eq]
      ring
  have h_ram_cop : ∀ (L : Ideal R_F) (B_ram : Ideal R_E) (K : ℕ),
      IsCoprime L m₀ → B_ram ∣ M ^ K → IsCoprime L (Ideal.relNorm R_F B_ram) := by
    intro L B_ram K hL_cop h_dvd
    apply IsCoprime.symm
    apply (h_cop_iff B_ram L).mpr
    have h_sup : m₀ ⊔ L = ⊤ := by
      rw [sup_comm, ← Ideal.isCoprime_iff_sup_eq]
      exact hL_cop
    have h_map := congrArg (Ideal.map (algebraMap R_F R_E)) h_sup
    rw [Ideal.map_sup, Ideal.map_top] at h_map
    have hM_cop : IsCoprime M (Ideal.map (algebraMap R_F R_E) L) :=
      Ideal.isCoprime_iff_sup_eq.mpr h_map
    have hMK_cop : IsCoprime (M ^ K) (Ideal.map (algebraMap R_F R_E) L) :=
      hM_cop.pow_left
    exact IsCoprime.of_isCoprime_of_dvd_left hMK_cop h_dvd
  have h_strip : ∀ (I₁ I₂ : Ideal R_F),
      IsCoprime I₁ m₀ → IsCoprime I₂ m₀ →
      ∀ (B₁ B₂ : Ideal R_E),
        B₁ ≠ ⊥ → B₂ ≠ ⊥ →
        I₁ * Ideal.relNorm R_F B₁ = I₂ * Ideal.relNorm R_F B₂ →
        ∃ (B : Ideal R_E) (b : R_E),
          B ≠ ⊥ ∧ b ≠ 0 ∧
          IsCoprime (Ideal.relNorm R_F B) m₀ ∧
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ ∧
          I₁ * Ideal.relNorm R_F B = I₂ * Ideal.span {Algebra.intNorm R_F R_E b} := by
    intro I₁ I₂ hI₁_cop hI₂_cop B₁ B₂ hB₁_ne hB₂_ne h_eq
    obtain ⟨B₁_cop, B₁_ram, K₁, hB₁_cop_ne, hB₁_cop_M, hB₁_ram_dvd, hB₁_eq⟩ :=
      h_split_nat (Ideal.absNorm B₁) B₁ rfl hB₁_ne
    obtain ⟨B₂_cop, B₂_ram, K₂, hB₂_cop_ne, hB₂_cop_M, hB₂_ram_dvd, hB₂_eq⟩ :=
      h_split_nat (Ideal.absNorm B₂) B₂ rfl hB₂_ne
    have hB₁_cop_m₀ : IsCoprime (Ideal.relNorm R_F B₁_cop) m₀ :=
      (h_cop_iff B₁_cop m₀).mpr hB₁_cop_M
    have hB₂_cop_m₀ : IsCoprime (Ideal.relNorm R_F B₂_cop) m₀ :=
      (h_cop_iff B₂_cop m₀).mpr hB₂_cop_M
    let L₁ : Ideal R_F := I₁ * Ideal.relNorm R_F B₁_cop
    let L₂ : Ideal R_F := I₂ * Ideal.relNorm R_F B₂_cop
    let R₁ : Ideal R_F := Ideal.relNorm R_F B₁_ram
    let R₂ : Ideal R_F := Ideal.relNorm R_F B₂_ram
    have hL₁_cop : IsCoprime L₁ m₀ := IsCoprime.mul_left hI₁_cop hB₁_cop_m₀
    have hL₂_cop : IsCoprime L₂ m₀ := IsCoprime.mul_left hI₂_cop hB₂_cop_m₀
    have hL₁R₂ : L₁ ⊔ R₂ = ⊤ :=
      Ideal.isCoprime_iff_sup_eq.mp (h_ram_cop L₁ B₂_ram K₂ hL₁_cop hB₂_ram_dvd)
    have hL₂R₁ : L₂ ⊔ R₁ = ⊤ :=
      Ideal.isCoprime_iff_sup_eq.mp (h_ram_cop L₂ B₁_ram K₁ hL₂_cop hB₁_ram_dvd)
    have hLR_eq : L₁ * R₁ = L₂ * R₂ := by
      dsimp [L₁, L₂, R₁, R₂]
      rw [mul_assoc, mul_assoc, ← map_mul, ← map_mul, ← hB₁_eq, ← hB₂_eq]
      exact h_eq
    have hL_eq : L₁ = L₂ := by
      calc
        L₁ = L₁ * ⊤ := (Ideal.mul_top L₁).symm
        _ = L₁ * (L₂ ⊔ R₁) := by rw [hL₂R₁]
        _ = L₁ * L₂ ⊔ L₁ * R₁ := by rw [Submodule.mul_sup]
        _ = L₂ * L₁ ⊔ L₂ * R₂ := by rw [mul_comm L₁ L₂, hLR_eq]
        _ = L₂ * (L₁ ⊔ R₂) := by rw [← Submodule.mul_sup]
        _ = L₂ * ⊤ := by rw [hL₁R₂]
        _ = L₂ := Ideal.mul_top L₂
    obtain ⟨C₂, b, hC₂_ne, hb_ne, hC₂_cop, hB₂C₂⟩ := h_cop_inv B₂_cop hB₂_cop_ne
    have hB₁_cop0 : B₁_cop ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hC₂0 : C₂ ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hBC₂_ne : B₁_cop * C₂ ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot]
      exact mul_ne_zero hB₁_cop0 hC₂0
    have hBC₂_cop : IsCoprime (Ideal.relNorm R_F (B₁_cop * C₂)) m₀ := by
      rw [map_mul]
      exact IsCoprime.mul_left hB₁_cop_m₀ hC₂_cop
    have hb_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ := by
      rw [← Ideal.relNorm_singleton]
      change IsCoprime (Ideal.relNorm R_F (Ideal.span {b})) m₀
      rw [← hB₂C₂, map_mul]
      exact IsCoprime.mul_left hB₂_cop_m₀ hC₂_cop
    refine ⟨B₁_cop * C₂, b, hBC₂_ne, hb_ne, hBC₂_cop, hb_cop, ?_⟩
    calc
      I₁ * Ideal.relNorm R_F (B₁_cop * C₂)
          = (I₁ * Ideal.relNorm R_F B₁_cop) * Ideal.relNorm R_F C₂ := by
            rw [map_mul, mul_assoc]
      _ = (I₂ * Ideal.relNorm R_F B₂_cop) * Ideal.relNorm R_F C₂ := by
            exact congrArg (· * Ideal.relNorm R_F C₂) hL_eq
      _ = I₂ * Ideal.relNorm R_F (B₂_cop * C₂) := by
            rw [mul_assoc, ← map_mul]
      _ = I₂ * Ideal.relNorm R_F (Ideal.span {b}) := by
            rw [hB₂C₂]
      _ = I₂ * Ideal.span {Algebra.intNorm R_F R_E b} := by
            rw [Ideal.relNorm_singleton]
  
  let InRayCell : Ideal R_F → Ideal R_F → Prop := fun I J =>
    ∃ a : R_F,
      a - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal → 0 < (w.embedding (a : F)).re) ∧
      I * J = Ideal.span {a}
  have hJ0 : ∀ j : Fin N_ray, J_all j ≠ 0 := by
    intro j
    rw [Submodule.zero_eq_bot]
    exact (hJ_prop j).1
  have h_cell_ne_zero : ∀ {I J : Ideal R_F} {a : R_F},
      I ≠ ⊥ → J ≠ ⊥ → I * J = Ideal.span {a} → a ≠ 0 := by
    intro I J a hI hJ hIJ ha0
    have hI0 : I ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hJ0' : J ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hIJ_ne : I * J ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot]
      exact mul_ne_zero hI0 hJ0'
    apply hIJ_ne
    rw [hIJ, ha0, Ideal.span_singleton_eq_bot.mpr rfl]
  have h_ray_sub_one : ∀ {a b : R_F}, a - 1 ∈ m₀ → b - 1 ∈ m₀ → a * b - 1 ∈ m₀ := by
    intro a b ha hb
    have h_eq : a * b - 1 = (a - 1) * b + (b - 1) := by ring
    rw [h_eq]
    exact m₀.add_mem (m₀.mul_mem_right b ha) hb
  have h_ray_pos_mul : ∀ {a b : R_F} (w : NumberField.InfinitePlace F),
      w.IsReal →
      0 < (w.embedding (a : F)).re →
      0 < (w.embedding (b : F)).re →
      0 < (w.embedding ((a * b : R_F) : F)).re := by
    intro a b w hw ha hb
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (a : F),
        Complex.ofReal_re] at ha
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (b : F),
        Complex.ofReal_re] at hb
    change 0 < (w.embedding (algebraMap R_F F (a * b))).re
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (algebraMap R_F F (a * b)),
        Complex.ofReal_re, map_mul, map_mul]
    exact mul_pos ha hb
  have h_ray_cop : ∀ {a : R_F}, a - 1 ∈ m₀ → IsCoprime (Ideal.span {a}) m₀ := by
    intro a ha
    refine Ideal.isCoprime_iff_exists.mpr ⟨a, Ideal.mem_span_singleton_self a, -(a - 1), m₀.neg_mem ha, ?_⟩
    ring
  have h_intNorm_ne_zero : ∀ {b : R_E}, b ≠ 0 → Algebra.intNorm R_F R_E b ≠ 0 := by
    intro b hb h0
    have halg : algebraMap R_E E b ≠ 0 :=
      (map_ne_zero_iff (algebraMap R_E E) (FaithfulSMul.algebraMap_injective R_E E)).mpr hb
    have hnorm : Algebra.norm F (algebraMap R_E E b) ≠ 0 :=
      Algebra.norm_ne_zero_iff.mpr halg
    apply hnorm
    rw [← Algebra.algebraMap_intNorm (A := R_F), h0, map_zero]
  have h_relNorm_ne_zero : ∀ {B : Ideal R_E}, B ≠ ⊥ → Ideal.relNorm R_F B ≠ 0 := by
    intro B hB_ne h_zero
    obtain ⟨x, hxB, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hB_ne
    have hx_norm : Algebra.intNorm R_F R_E x ∈ Ideal.relNorm R_F B := by
      rw [Ideal.relNorm_apply]
      exact Ideal.subset_span ⟨x, hxB, rfl⟩
    rw [h_zero, Submodule.zero_eq_bot, Submodule.mem_bot] at hx_norm
    exact h_intNorm_ne_zero hx0 hx_norm
  have h_norm_strip : ∀ s : S_norm,
      ∃ (a₁ a₂ : R_F) (B : Ideal R_E) (b : R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B ≠ ⊥ ∧ b ≠ 0 ∧
        IsCoprime (Ideal.relNorm R_F B) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all s.1 * Ideal.span {a₁} * Ideal.relNorm R_F B =
          Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b} := by
    intro s
    rcases s.2 with ⟨a₁, a₂, B₁, B₂, ha₁_ne, ha₂_ne, hB₁_ne, hB₂_ne, ha₁_m₀, ha₂_m₀, ha_pos, h_eq⟩
    have hI₁_cop : IsCoprime (J_all s.1 * Ideal.span {a₁}) m₀ :=
      IsCoprime.mul_left (hJ_prop s.1).2 (h_ray_cop ha₁_m₀)
    have hI₂_cop : IsCoprime (Ideal.span {a₂}) m₀ := h_ray_cop ha₂_m₀
    obtain ⟨B, b, hB_ne, hb_ne, hB_cop, hb_cop, h_eq'⟩ :=
      h_strip (J_all s.1 * Ideal.span {a₁}) (Ideal.span {a₂}) hI₁_cop hI₂_cop B₁ B₂ hB₁_ne hB₂_ne h_eq
    exact ⟨a₁, a₂, B, b, ha₁_ne, ha₂_ne, hB_ne, hb_ne, hB_cop, hb_cop, ha₁_m₀, ha₂_m₀, ha_pos, h_eq'⟩
  choose a₁_of a₂_of B_of b_of ha₁_ne ha₂_ne hB_ne hb_ne hB_cop hb_cop ha₁_m₀ ha₂_m₀ ha_pos h_norm_eq using h_norm_strip
  let δ_Cl : ClassGroup R_E →* ClassGroup R_E := MonoidHom.id (ClassGroup R_E) / σ_Cl
  let Q_Cl := ClassGroup R_E ⧸ δ_Cl.range
  have hB_nzd : ∀ s : S_norm, B_of s ∈ nonZeroDivisors (Ideal R_E) := by
    intro s
    apply mem_nonZeroDivisors_of_ne_zero
    rw [Submodule.zero_eq_bot]
    exact hB_ne s
  let cls_of : S_norm → ClassGroup R_E := fun s => ClassGroup.mk0 ⟨B_of s, hB_nzd s⟩
  let ψ : S_norm → Q_Cl := fun s => QuotientGroup.mk (cls_of s)
  let s₀ : Set.range ψ → S_norm := fun q => Classical.choose q.2
  have hs₀ : ∀ q : Set.range ψ, ψ (s₀ q) = q.1 := fun q => Classical.choose_spec q.2
  let base : S_norm → S_norm := fun s => s₀ ⟨ψ s, ⟨s, rfl⟩⟩
  have hbase_ψ : ∀ s : S_norm, ψ (base s) = ψ s := fun s => hs₀ ⟨ψ s, ⟨s, rfl⟩⟩
  have hbase_eq_of_ψ_eq : ∀ s₁ s₂ : S_norm, ψ s₁ = ψ s₂ → base s₁ = base s₂ := by
    intro s₁ s₂ h_eq
    have hq_eq : (⟨ψ s₁, ⟨s₁, rfl⟩⟩ : Set.range ψ) = ⟨ψ s₂, ⟨s₂, rfl⟩⟩ := Subtype.ext h_eq
    exact congrArg s₀ hq_eq
  have h_ex_d : ∀ s : S_norm,
      ∃ d₁ d₂ : R_E,
        d₁ ≠ 0 ∧ d₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E d₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E d₂}) m₀ ∧
        Ideal.relNorm R_F (B_of (base s)) * Ideal.span {Algebra.intNorm R_F R_E d₁} =
          Ideal.relNorm R_F (B_of s) * Ideal.span {Algebra.intNorm R_F R_E d₂} := by
    intro s
    have hq : QuotientGroup.mk (cls_of (base s)) = (QuotientGroup.mk (cls_of s) : Q_Cl) := hbase_ψ s
    have h_mem : (cls_of (base s))⁻¹ * cls_of s ∈ δ_Cl.range := QuotientGroup.eq.mp hq
    rcases h_mem with ⟨c, hc⟩
    have hc_div : c / σ_Cl c = (cls_of (base s))⁻¹ * cls_of s := hc
    have h_cls_eq : cls_of (base s) * c = cls_of s * σ_Cl c := by
      calc
        cls_of (base s) * c = cls_of (base s) * (c / σ_Cl c * σ_Cl c) := by
          rw [div_mul_cancel]
        _ = cls_of (base s) * ((cls_of (base s))⁻¹ * cls_of s * σ_Cl c) := by
          rw [hc_div]
        _ = (cls_of (base s) * (cls_of (base s))⁻¹) * cls_of s * σ_Cl c := by
          rw [← mul_assoc, ← mul_assoc]
        _ = cls_of s * σ_Cl c := by
          rw [mul_inv_cancel, one_mul]
    obtain ⟨C, hC, hC_cop, hC_mk⟩ := h_cop_rep c
    have hC0 : C ≠ 0 := nonZeroDivisors.ne_zero hC
    have hC_ne : C ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hCσ_ne : Ideal.map σ_int C ≠ ⊥ :=
      (Ideal.map_eq_bot_iff_of_injective σ_int.injective).not.mpr hC_ne
    have hCσ0 : Ideal.map σ_int C ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hCσ : Ideal.map σ_int C ∈ nonZeroDivisors (Ideal R_E) :=
      mem_nonZeroDivisors_of_ne_zero hCσ0
    have hCσ_mk : σ_Cl c = ClassGroup.mk0 ⟨Ideal.map σ_int C, hCσ⟩ := by
      rw [← hC_mk]
      exact hσ_Cl C hC hCσ
    have hCσ_cop : IsCoprime (Ideal.relNorm R_F (Ideal.map σ_int C)) m₀ := by
      rw [Ideal.relNorm_map_algEquiv]
      exact hC_cop
    have hB_base0 : B_of (base s) ≠ 0 := nonZeroDivisors.ne_zero (hB_nzd (base s))
    have hB_s0 : B_of s ≠ 0 := nonZeroDivisors.ne_zero (hB_nzd s)
    have hD₁ : B_of (base s) * C ∈ nonZeroDivisors (Ideal R_E) :=
      mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hB_base0 hC0)
    have hD₂ : B_of s * Ideal.map σ_int C ∈ nonZeroDivisors (Ideal R_E) :=
      mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hB_s0 hCσ0)
    have hD₁_cop : IsCoprime (Ideal.relNorm R_F (B_of (base s) * C)) m₀ := by
      rw [map_mul]
      exact IsCoprime.mul_left (hB_cop (base s)) hC_cop
    have hD₂_cop : IsCoprime (Ideal.relNorm R_F (B_of s * Ideal.map σ_int C)) m₀ := by
      rw [map_mul]
      exact IsCoprime.mul_left (hB_cop s) hCσ_cop
    have hD_mk_eq : ClassGroup.mk0 ⟨B_of (base s) * C, hD₁⟩ =
        ClassGroup.mk0 ⟨B_of s * Ideal.map σ_int C, hD₂⟩ := by
      change ClassGroup.mk0 (⟨B_of (base s), hB_nzd (base s)⟩ * ⟨C, hC⟩) =
        ClassGroup.mk0 (⟨B_of s, hB_nzd s⟩ * ⟨Ideal.map σ_int C, hCσ⟩)
      rw [map_mul, map_mul, hC_mk, ← hCσ_mk]
      exact h_cls_eq
    obtain ⟨d₁, d₂, hd₁_ne, hd₂_ne, hd₁_cop, hd₂_cop, hD_span_eq⟩ :=
      h_rep_eq (B_of (base s) * C) (B_of s * Ideal.map σ_int C) hD₁ hD₂ hD₁_cop hD₂_cop hD_mk_eq
    have h_rel_eq := congrArg (Ideal.relNorm R_F) hD_span_eq
    rw [map_mul, map_mul, map_mul, map_mul,
      Ideal.relNorm_singleton, Ideal.relNorm_singleton,
      Ideal.relNorm_map_algEquiv] at h_rel_eq
    have h_rel_assoc :
        (Ideal.relNorm R_F (B_of (base s)) * Ideal.span {Algebra.intNorm R_F R_E d₁}) * Ideal.relNorm R_F C =
        (Ideal.relNorm R_F (B_of s) * Ideal.span {Algebra.intNorm R_F R_E d₂}) * Ideal.relNorm R_F C := by
      calc
        (Ideal.relNorm R_F (B_of (base s)) * Ideal.span {Algebra.intNorm R_F R_E d₁}) * Ideal.relNorm R_F C
            = Ideal.relNorm R_F (B_of (base s)) * Ideal.relNorm R_F C * Ideal.span {Algebra.intNorm R_F R_E d₁} := by ring
        _ = Ideal.relNorm R_F (B_of s) * Ideal.relNorm R_F C * Ideal.span {Algebra.intNorm R_F R_E d₂} := h_rel_eq
        _ = (Ideal.relNorm R_F (B_of s) * Ideal.span {Algebra.intNorm R_F R_E d₂}) * Ideal.relNorm R_F C := by ring
    exact ⟨d₁, d₂, hd₁_ne, hd₂_ne, hd₁_cop, hd₂_cop,
      mul_right_cancel₀ (h_relNorm_ne_zero hC_ne) h_rel_assoc⟩
  choose d₁_of d₂_of hd₁_ne hd₂_ne hd₁_cop hd₂_cop hd_eq using h_ex_d
  have h_inv_u : ∀ j : Fin N_ray,
      ∃ u : Fin N_ray,
        ∃ e₀ : R_F,
          e₀ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (e₀ : F)).re) ∧
          J_all j * J_all u = Ideal.span {e₀} :=
    fun j => hJ_cov (J_all j) (hJ_prop j).1 (hJ_prop j).2
  choose u e₀_of he₀_m₀ he₀_pos he₀_eq using h_inv_u
  have hJJ_ne : ∀ j₁ j₂ : Fin N_ray, J_all j₁ * J_all j₂ ≠ ⊥ := by
    intro j₁ j₂
    rw [← Submodule.zero_eq_bot]
    exact mul_ne_zero (hJ0 j₁) (hJ0 j₂)
  have hJu_ne : ∀ s : S_norm, J_all s.1 * J_all (u (base s).1) ≠ ⊥ :=
    fun s => hJJ_ne s.1 (u (base s).1)
  have hJu_cop : ∀ s : S_norm, IsCoprime (J_all s.1 * J_all (u (base s).1)) m₀ :=
    fun s => IsCoprime.mul_left (hJ_prop s.1).2 (hJ_prop (u (base s).1)).2
  have h_inv_v : ∀ s : S_norm,
      ∃ v : Fin N_ray,
        ∃ e₁ : R_F,
          e₁ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (e₁ : F)).re) ∧
          (J_all s.1 * J_all (u (base s).1)) * J_all v = Ideal.span {e₁} :=
    fun s => hJ_cov (J_all s.1 * J_all (u (base s).1)) (hJu_ne s) (hJu_cop s)
  choose v e₁_of he₁_m₀ he₁_pos he₁_eq using h_inv_v
  have h_inv_t : ∀ s : S_norm,
      ∃ t : Fin N_ray,
        ∃ e₂ : R_F,
          e₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (e₂ : F)).re) ∧
          J_all (v s) * J_all t = Ideal.span {e₂} :=
    fun s => hJ_cov (J_all (v s)) (hJ_prop (v s)).1 (hJ_prop (v s)).2
  choose t e₂_of he₂_m₀ he₂_pos he₂_eq using h_inv_t
  have ht_mem : ∀ s : S_norm,
      ∃ (a₁ a₂ : R_F) (b₁ b₂ : R_E),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        J_all (t s) * Ideal.span {a₁} * Ideal.span {Algebra.intNorm R_F R_E b₁} =
          Ideal.span {a₂} * Ideal.span {Algebra.intNorm R_F R_E b₂} := by
    intro s
    have he₀_ne : e₀_of (base s).1 ≠ 0 :=
      h_cell_ne_zero (hJ_prop (base s).1).1 (hJ_prop (u (base s).1)).1 (he₀_eq (base s).1)
    have he₁_ne : e₁_of s ≠ 0 :=
      h_cell_ne_zero (hJu_ne s) (hJ_prop (v s)).1 (he₁_eq s)
    have he₂_ne : e₂_of s ≠ 0 :=
      h_cell_ne_zero (hJ_prop (v s)).1 (hJ_prop (t s)).1 (he₂_eq s)
    let A₁ : R_F := e₁_of s * a₁_of s * a₂_of (base s)
    let A₂ : R_F := e₀_of (base s).1 * e₂_of s * a₂_of s * a₁_of (base s)
    let β₁ : R_E := b_of (base s) * d₁_of s
    let β₂ : R_E := b_of s * d₂_of s
    have hA₁_ne : A₁ ≠ 0 :=
      mul_ne_zero (mul_ne_zero he₁_ne (ha₁_ne s)) (ha₂_ne (base s))
    have hA₂_ne : A₂ ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero he₀_ne he₂_ne) (ha₂_ne s)) (ha₁_ne (base s))
    have hβ₁_ne : β₁ ≠ 0 := mul_ne_zero (hb_ne (base s)) (hd₁_ne s)
    have hβ₂_ne : β₂ ≠ 0 := mul_ne_zero (hb_ne s) (hd₂_ne s)
    have hβ₁_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E β₁}) m₀ := by
      dsimp [β₁]
      rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
      exact IsCoprime.mul_left (hb_cop (base s)) (hd₁_cop s)
    have hβ₂_cop : IsCoprime (Ideal.span {Algebra.intNorm R_F R_E β₂}) m₀ := by
      dsimp [β₂]
      rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
      exact IsCoprime.mul_left (hb_cop s) (hd₂_cop s)
    have hA₁_m₀ : A₁ - 1 ∈ m₀ :=
      h_ray_sub_one (h_ray_sub_one (he₁_m₀ s) (ha₁_m₀ s)) (ha₂_m₀ (base s))
    have hA₂_m₀ : A₂ - 1 ∈ m₀ :=
      h_ray_sub_one (h_ray_sub_one (h_ray_sub_one (he₀_m₀ (base s).1) (he₂_m₀ s)) (ha₂_m₀ s)) (ha₁_m₀ (base s))
    have hA_pos : ∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (A₁ : F)).re ∧ 0 < (w.embedding (A₂ : F)).re := by
      intro w hw
      refine ⟨?_, ?_⟩
      · exact h_ray_pos_mul w hw
          (h_ray_pos_mul w hw (he₁_pos s w hw) (ha_pos s w hw).1)
          (ha_pos (base s) w hw).2
      · exact h_ray_pos_mul w hw
          (h_ray_pos_mul w hw
            (h_ray_pos_mul w hw (he₀_pos (base s).1 w hw) (he₂_pos s w hw))
            (ha_pos s w hw).2)
          (ha_pos (base s) w hw).1
    refine ⟨A₁, A₂, β₁, β₂, hA₁_ne, hA₂_ne, hβ₁_ne, hβ₂_ne, hβ₁_cop, hβ₂_cop, hA₁_m₀, hA₂_m₀, hA_pos, ?_⟩
    let K_cancel : Ideal R_F := J_all (base s).1 * J_all (v s) * Ideal.relNorm R_F (B_of s)
    have hK_cancel0 : K_cancel ≠ 0 :=
      mul_ne_zero (mul_ne_zero (hJ0 (base s).1) (hJ0 (v s))) (h_relNorm_ne_zero (hB_ne s))
    apply mul_right_cancel₀ hK_cancel0
    have hA₁_span : Ideal.span {A₁} =
        Ideal.span {e₁_of s} * Ideal.span {a₁_of s} * Ideal.span {a₂_of (base s)} := by
      dsimp [A₁]
      rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton]
    have hA₂_span : Ideal.span {A₂} =
        Ideal.span {e₀_of (base s).1} * Ideal.span {e₂_of s} * Ideal.span {a₂_of s} * Ideal.span {a₁_of (base s)} := by
      dsimp [A₂]
      rw [← Ideal.span_singleton_mul_span_singleton,
        ← Ideal.span_singleton_mul_span_singleton,
        ← Ideal.span_singleton_mul_span_singleton]
    have hβ₁_span : Ideal.span {Algebra.intNorm R_F R_E β₁} =
        Ideal.span {Algebra.intNorm R_F R_E (b_of (base s))} * Ideal.span {Algebra.intNorm R_F R_E (d₁_of s)} := by
      dsimp [β₁]
      rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
    have hβ₂_span : Ideal.span {Algebra.intNorm R_F R_E β₂} =
        Ideal.span {Algebra.intNorm R_F R_E (b_of s)} * Ideal.span {Algebra.intNorm R_F R_E (d₂_of s)} := by
      dsimp [β₂]
      rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
    calc
      (J_all (t s) * Ideal.span {A₁} * Ideal.span {Algebra.intNorm R_F R_E β₁}) * K_cancel
          = J_all (t s) * (Ideal.span {e₁_of s} * Ideal.span {a₁_of s} * Ideal.span {a₂_of (base s)}) *
              (Ideal.span {Algebra.intNorm R_F R_E (b_of (base s))} * Ideal.span {Algebra.intNorm R_F R_E (d₁_of s)}) *
              (J_all (base s).1 * J_all (v s) * Ideal.relNorm R_F (B_of s)) := by
            rw [hA₁_span, hβ₁_span]
      _ = J_all (t s) * (((J_all s.1 * J_all (u (base s).1)) * J_all (v s)) * Ideal.span {a₁_of s}) *
              (Ideal.span {a₂_of (base s)} * Ideal.span {Algebra.intNorm R_F R_E (b_of (base s))}) *
              Ideal.span {Algebra.intNorm R_F R_E (d₁_of s)} *
              (J_all (base s).1 * J_all (v s) * Ideal.relNorm R_F (B_of s)) := by
            rw [← he₁_eq s]
            ring
      _ = J_all (t s) * (((J_all s.1 * J_all (u (base s).1)) * J_all (v s)) * Ideal.span {a₁_of s}) *
              (J_all (base s).1 * Ideal.span {a₁_of (base s)} * Ideal.relNorm R_F (B_of (base s))) *
              Ideal.span {Algebra.intNorm R_F R_E (d₁_of s)} *
              (J_all (base s).1 * J_all (v s) * Ideal.relNorm R_F (B_of s)) := by
            rw [← h_norm_eq (base s)]
      _ = (J_all (base s).1 * J_all (u (base s).1)) * (J_all (v s) * J_all (t s)) *
              (J_all s.1 * Ideal.span {a₁_of s} * Ideal.relNorm R_F (B_of s)) *
              Ideal.span {a₁_of (base s)} *
              (Ideal.relNorm R_F (B_of (base s)) * Ideal.span {Algebra.intNorm R_F R_E (d₁_of s)}) *
              J_all (base s).1 * J_all (v s) := by
            ring
      _ = Ideal.span {e₀_of (base s).1} * Ideal.span {e₂_of s} *
              (Ideal.span {a₂_of s} * Ideal.span {Algebra.intNorm R_F R_E (b_of s)}) *
              Ideal.span {a₁_of (base s)} *
              (Ideal.relNorm R_F (B_of s) * Ideal.span {Algebra.intNorm R_F R_E (d₂_of s)}) *
              J_all (base s).1 * J_all (v s) := by
            rw [he₀_eq (base s).1, he₂_eq s, h_norm_eq s, hd_eq s]
      _ = ((Ideal.span {e₀_of (base s).1} * Ideal.span {e₂_of s} * Ideal.span {a₂_of s} * Ideal.span {a₁_of (base s)}) *
              (Ideal.span {Algebra.intNorm R_F R_E (b_of s)} * Ideal.span {Algebra.intNorm R_F R_E (d₂_of s)})) *
              (J_all (base s).1 * J_all (v s) * Ideal.relNorm R_F (B_of s)) := by
            ring
      _ = (Ideal.span {A₂} * Ideal.span {Algebra.intNorm R_F R_E β₂}) * K_cancel := by
            rw [← hA₂_span, ← hβ₂_span]
  let Ψ : S_norm → Q_Cl × S_pnorm := fun s => (ψ s, ⟨t s, ht_mem s⟩)
  have hΨ_inj : Function.Injective Ψ := by
    intro s₁ s₂ hΨ
    have hψ_eq : ψ s₁ = ψ s₂ := congrArg Prod.fst hΨ
    have ht_eq : t s₁ = t s₂ := congrArg (Subtype.val ∘ Prod.snd) hΨ
    have hbase_eq : base s₁ = base s₂ := hbase_eq_of_ψ_eq s₁ s₂ hψ_eq
    have h_v1 : InRayCell (J_all (t s₁)) (J_all (v s₁)) :=
      ⟨e₂_of s₁, he₂_m₀ s₁, he₂_pos s₁, by rw [mul_comm, he₂_eq s₁]⟩
    have h_v2 : InRayCell (J_all (t s₁)) (J_all (v s₂)) :=
      ⟨e₂_of s₂, he₂_m₀ s₂, he₂_pos s₂, by rw [ht_eq, mul_comm, he₂_eq s₂]⟩
    have hv_eq : v s₁ = v s₂ :=
      hJ_inj (J_all (t s₁)) (v s₁) (v s₂) (hJ_prop (t s₁)).1 h_v1 h_v2
    let I₀ : Ideal R_F := J_all (u (base s₁).1) * J_all (v s₁)
    have hI₀_ne : I₀ ≠ ⊥ := hJJ_ne (u (base s₁).1) (v s₁)
    have h_s1 : InRayCell I₀ (J_all s₁.1) := by
      refine ⟨e₁_of s₁, he₁_m₀ s₁, he₁_pos s₁, ?_⟩
      have h_comm : I₀ * J_all s₁.1 = (J_all s₁.1 * J_all (u (base s₁).1)) * J_all (v s₁) := by
        dsimp [I₀]
        ring
      rw [h_comm, he₁_eq s₁]
    have h_s2 : InRayCell I₀ (J_all s₂.1) := by
      refine ⟨e₁_of s₂, he₁_m₀ s₂, he₁_pos s₂, ?_⟩
      have h_comm : I₀ * J_all s₂.1 = (J_all s₂.1 * J_all (u (base s₂).1)) * J_all (v s₂) := by
        dsimp [I₀]
        rw [hbase_eq, hv_eq]
        ring
      rw [h_comm, he₁_eq s₂]
    exact Subtype.ext (hJ_inj I₀ s₁.1 s₂.1 hI₀_ne h_s1 h_s2)
  have h_card_le : Nat.card S_norm ≤ Nat.card (Q_Cl × S_pnorm) :=
    Nat.card_le_card_of_injective Ψ hΨ_inj
  rw [Nat.card_prod] at h_card_le
  exact ⟨σ_Cl, hσ_Cl, h_cop_rep, h_rep_eq, h_card_le⟩

theorem unramified_galRestrict_invariant_ideal_and_coboundary_descent {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_dvd : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₀ ↔ ¬ IsUnramifiedAtPrime F E q) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let σ_int : R_E ≃ₐ[R_F] R_E := galRestrict R_F F E R_E σ
    let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
      ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
    let B_cop : Subgroup Eˣ :=
      Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
    ∃ ext_Cl : ClassGroup R_F →* ClassGroup R_E,
      (∀ (A : Ideal R_F) (hA : A ∈ nonZeroDivisors (Ideal R_F))
          (hAE : Ideal.map (algebraMap R_F R_E) A ∈ nonZeroDivisors (Ideal R_E)),
        ext_Cl (ClassGroup.mk0 ⟨A, hA⟩) =
          ClassGroup.mk0 ⟨Ideal.map (algebraMap R_F R_E) A, hAE⟩) ∧
      (∀ z ∈ B_cop,
        ∃ b : R_E,
          b ≠ 0 ∧
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ ∧
          (z : E) * σ (algebraMap R_E E b) = algebraMap R_E E b) ∧
      (∀ B : Ideal R_E,
        B ≠ ⊥ →
        IsCoprime (Ideal.relNorm R_F B) m₀ →
        Ideal.map σ_int B = B →
        ∃ A : Ideal R_F,
          A ≠ ⊥ ∧
          IsCoprime A m₀ ∧
          B = Ideal.map (algebraMap R_F R_E) A) ∧
      (∀ A₁ A₂ : Ideal R_F,
        A₁ ≠ ⊥ → A₂ ≠ ⊥ →
        Ideal.map (algebraMap R_F R_E) A₁ = Ideal.map (algebraMap R_F R_E) A₂ →
        A₁ = A₂) :=
by
  classical
  intro R_F R_E σ_int E_cop B_cop
  have hinj : Function.Injective (algebraMap R_F R_E) :=
    FaithfulSMul.algebraMap_injective R_F R_E
  have hinj_E : Function.Injective (algebraMap R_E E) :=
    FaithfulSMul.algebraMap_injective R_E E
  have hmap_nzd : ∀ I : nonZeroDivisors (Ideal R_F),
      Ideal.map (algebraMap R_F R_E) I.1 ∈ nonZeroDivisors (Ideal R_E) := by
    intro I
    have hI_zero : I.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp I.2
    have hI_bot : I.1 ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
    have hmap_bot : Ideal.map (algebraMap R_F R_E) I.1 ≠ ⊥ :=
      (Ideal.map_eq_bot_iff_of_injective hinj).not.mpr hI_bot
    have hmap_zero : Ideal.map (algebraMap R_F R_E) I.1 ≠ 0 := by rwa [Submodule.zero_eq_bot]
    exact mem_nonZeroDivisors_of_ne_zero hmap_zero
  let f_ext : nonZeroDivisors (Ideal R_F) →* ClassGroup R_E :=
    { toFun := fun I => ClassGroup.mk0 ⟨Ideal.map (algebraMap R_F R_E) I.1, hmap_nzd I⟩
      map_one' := by
        have h1 : (⟨Ideal.map (algebraMap R_F R_E) (1 : nonZeroDivisors (Ideal R_F)).1,
            hmap_nzd 1⟩ : nonZeroDivisors (Ideal R_E)) = 1 := by
          apply Subtype.ext
          change Ideal.map (algebraMap R_F R_E) 1 = 1
          rw [Ideal.one_eq_top, Ideal.map_top, ← Ideal.one_eq_top]
        rw [h1, map_one]
      map_mul' := by
        intro I J
        have hmul : (⟨Ideal.map (algebraMap R_F R_E) (I * J).1,
            hmap_nzd (I * J)⟩ : nonZeroDivisors (Ideal R_E)) =
            ⟨Ideal.map (algebraMap R_F R_E) I.1, hmap_nzd I⟩ *
            ⟨Ideal.map (algebraMap R_F R_E) J.1, hmap_nzd J⟩ := by
          apply Subtype.ext
          exact Ideal.map_mul (algebraMap R_F R_E) I.1 J.1
        rw [hmul, map_mul] }
  have h_wd : ∀ I J : nonZeroDivisors (Ideal R_F),
      ClassGroup.mk0 I = ClassGroup.mk0 J → f_ext I = f_ext J := by
    intro I J h
    rcases ClassGroup.mk0_eq_mk0_iff.mp h with ⟨x, y, hx, hy, hxy⟩
    apply ClassGroup.mk0_eq_mk0_iff.mpr
    refine ⟨algebraMap R_F R_E x, algebraMap R_F R_E y,
      (map_ne_zero_iff (algebraMap R_F R_E) hinj).mpr hx,
      (map_ne_zero_iff (algebraMap R_F R_E) hinj).mpr hy, ?_⟩
    have hmap := congrArg (Ideal.map (algebraMap R_F R_E)) hxy
    simpa only [Ideal.map_mul, Ideal.map_span, Set.image_singleton] using hmap
  let rep : ClassGroup R_F → nonZeroDivisors (Ideal R_F) :=
    fun c => Classical.choose (ClassGroup.mk0_surjective c)
  have hrep : ∀ c : ClassGroup R_F, ClassGroup.mk0 (rep c) = c :=
    fun c => Classical.choose_spec (ClassGroup.mk0_surjective c)
  have hext_mk0 : ∀ I : nonZeroDivisors (Ideal R_F),
      f_ext (rep (ClassGroup.mk0 I)) = f_ext I :=
    fun I => h_wd (rep (ClassGroup.mk0 I)) I (hrep (ClassGroup.mk0 I))
  let ext_Cl : ClassGroup R_F →* ClassGroup R_E :=
    { toFun := fun c => f_ext (rep c)
      map_one' := by
        rw [← map_one ClassGroup.mk0, hext_mk0, map_one]
      map_mul' := by
        intro c₁ c₂
        obtain ⟨I₁, rfl⟩ := ClassGroup.mk0_surjective c₁
        obtain ⟨I₂, rfl⟩ := ClassGroup.mk0_surjective c₂
        rw [← map_mul ClassGroup.mk0, hext_mk0, hext_mk0, hext_mk0, map_mul] }
  refine ⟨ext_Cl, ?_, ?_, ?_, ?_⟩
  · intro A hA hAE
    exact hext_mk0 ⟨A, hA⟩
  · have h_intNorm_gal : ∀ (ρ : E ≃ₐ[F] E) (b : R_E),
        Algebra.intNorm R_F R_E (galRestrict R_F F E R_E ρ b) = Algebra.intNorm R_F R_E b := by
      intro ρ b
      apply FaithfulSMul.algebraMap_injective R_F F
      rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
        algebraMap_galRestrict_apply, Algebra.norm_eq_of_algEquiv]
    let c : R_E → R_E := fun b =>
      ∏ ρ ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase 1, galRestrict R_F F E R_E ρ b
    have hc_ne : ∀ b : R_E, b ≠ 0 → c b ≠ 0 := by
      intro b hb
      exact Finset.prod_ne_zero_iff.mpr fun ρ _ =>
        (map_ne_zero_iff (galRestrict R_F F E R_E ρ) (galRestrict R_F F E R_E ρ).injective).mpr hb
    have hc_cop : ∀ b : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ →
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E (c b)}) m₀ := by
      intro b hb_cop
      have h_norm_c : Algebra.intNorm R_F R_E (c b) =
          (Algebra.intNorm R_F R_E b) ^ ((Finset.univ : Finset (E ≃ₐ[F] E)).erase 1).card := by
        dsimp [c]
        rw [map_prod, Finset.prod_congr rfl (fun ρ _ => h_intNorm_gal ρ b), Finset.prod_const]
      rw [h_norm_c, ← Ideal.span_singleton_pow]
      exact hb_cop.pow_left
    have hc_fix : ∀ b : R_E,
        σ (algebraMap R_E E b) * σ (algebraMap R_E E (c b)) =
          (algebraMap R_E E b) * (algebraMap R_E E (c b)) := by
      intro b
      have h_prod : b * c b = ∏ ρ : E ≃ₐ[F] E, galRestrict R_F F E R_E ρ b := by
        dsimp [c]
        have h1 := Finset.mul_prod_erase (Finset.univ : Finset (E ≃ₐ[F] E))
          (fun ρ : E ≃ₐ[F] E => galRestrict R_F F E R_E ρ b) (Finset.mem_univ (1 : E ≃ₐ[F] E))
        dsimp only at h1
        rwa [map_one, AlgEquiv.one_apply] at h1
      have h_alg : (algebraMap R_E E b) * (algebraMap R_E E (c b)) =
          algebraMap F E (Algebra.norm F (algebraMap R_E E b)) := by
        rw [← map_mul, h_prod, map_prod]
        simp_rw [algebraMap_galRestrict_apply]
        exact (Algebra.norm_eq_prod_automorphisms F (algebraMap R_E E b)).symm
      rw [← map_mul σ, h_alg, σ.commutes]
    let S_B : Subgroup Eˣ :=
      { carrier := { z : Eˣ |
          ∃ b : R_E,
            b ≠ 0 ∧
            IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ ∧
            (z : E) * σ (algebraMap R_E E b) = algebraMap R_E E b }
        one_mem' := by
          refine ⟨1, one_ne_zero, ?_, ?_⟩
          · rw [map_one, Ideal.span_singleton_one]
            exact Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
          · rw [Units.val_one, one_mul, map_one, map_one]
        mul_mem' := by
          rintro z₁ z₂ ⟨b₁, hb₁_ne, hb₁_cop, hb₁_eq⟩ ⟨b₂, hb₂_ne, hb₂_cop, hb₂_eq⟩
          refine ⟨b₁ * b₂, mul_ne_zero hb₁_ne hb₂_ne, ?_, ?_⟩
          · rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
            exact IsCoprime.mul_left hb₁_cop hb₂_cop
          · rw [Units.val_mul, map_mul, map_mul]
            calc
              ((z₁ : E) * (z₂ : E)) * (σ (algebraMap R_E E b₁) * σ (algebraMap R_E E b₂))
                  = ((z₁ : E) * σ (algebraMap R_E E b₁)) *
                    ((z₂ : E) * σ (algebraMap R_E E b₂)) := by ring
              _ = algebraMap R_E E b₁ * algebraMap R_E E b₂ := by rw [hb₁_eq, hb₂_eq]
        inv_mem' := by
          rintro z ⟨b, hb_ne, hb_cop, hb_eq⟩
          refine ⟨c b, hc_ne b hb_ne, hc_cop b hb_cop, ?_⟩
          have hbE_ne : algebraMap R_E E b ≠ 0 :=
            (map_ne_zero_iff (algebraMap R_E E) hinj_E).mpr hb_ne
          apply mul_left_cancel₀ hbE_ne
          calc
            algebraMap R_E E b * ((↑z⁻¹ : E) * σ (algebraMap R_E E (c b)))
                = ((z : E) * σ (algebraMap R_E E b)) *
                  ((↑z⁻¹ : E) * σ (algebraMap R_E E (c b))) := by rw [hb_eq]
            _ = ((z : E) * (↑z⁻¹ : E)) *
                  (σ (algebraMap R_E E b) * σ (algebraMap R_E E (c b))) := by ring
            _ = 1 * (algebraMap R_E E b * algebraMap R_E E (c b)) := by
                rw [Units.mul_inv, hc_fix b]
            _ = algebraMap R_E E b * algebraMap R_E E (c b) := by rw [one_mul] }
    have hB_le : B_cop ≤ S_B := by
      rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
      rintro x ⟨b, hb_eq, hb_cop⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap]
      have hbE_ne : algebraMap R_E E b ≠ 0 := by
        rw [← hb_eq]
        exact x.ne_zero
      have hb_ne : b ≠ 0 := by
        intro hb0
        apply hbE_ne
        rw [hb0, map_zero]
      refine ⟨b, hb_ne, hb_cop, ?_⟩
      change (((MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) x : Eˣ) : E) *
        σ (algebraMap R_E E b) = algebraMap R_E E b
      have hδ : (((MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) x : Eˣ) : E) =
          (x : E) / σ (x : E) := by
        change ((x / Units.map (σ : E ≃* E).toMonoidHom x : Eˣ) : E) = (x : E) / σ (x : E)
        rw [Units.val_div_eq_div_val]
        rfl
      have hσ_ne : σ (algebraMap R_E E b) ≠ 0 :=
        (map_ne_zero_iff σ σ.injective).mpr hbE_ne
      rw [hδ, hb_eq, div_mul_cancel₀ _ hσ_ne]
    intro z hz
    exact hB_le hz
  · have h_map_one : ∀ I : Ideal R_E,
        Ideal.map (galRestrict R_F F E R_E (1 : E ≃ₐ[F] E)) I = I := by
      intro I
      rw [map_one]
      exact Ideal.map_id I
    have h_map_mul : ∀ (ρ₁ ρ₂ : E ≃ₐ[F] E) (I : Ideal R_E),
        Ideal.map (galRestrict R_F F E R_E (ρ₁ * ρ₂)) I =
          Ideal.map (galRestrict R_F F E R_E ρ₁) (Ideal.map (galRestrict R_F F E R_E ρ₂) I) := by
      intro ρ₁ ρ₂ I
      rw [map_mul]
      exact (Ideal.map_map (galRestrict R_F F E R_E ρ₂ : R_E →+* R_E)
        (galRestrict R_F F E R_E ρ₁ : R_E →+* R_E)).symm
    have h_gal_inv : ∀ (B : Ideal R_E), Ideal.map σ_int B = B →
        ∀ ρ : E ≃ₐ[F] E, Ideal.map (galRestrict R_F F E R_E ρ) B = B := by
      intro B hB_inv
      let H_B : Subgroup (E ≃ₐ[F] E) :=
        { carrier := { ρ : E ≃ₐ[F] E | Ideal.map (galRestrict R_F F E R_E ρ) B = B }
          one_mem' := h_map_one B
          mul_mem' := by
            intro ρ₁ ρ₂ h₁ h₂
            change Ideal.map (galRestrict R_F F E R_E (ρ₁ * ρ₂)) B = B
            rw [h_map_mul, h₂, h₁]
          inv_mem' := by
            intro ρ hρ
            change Ideal.map (galRestrict R_F F E R_E ρ⁻¹) B = B
            have h1 := congrArg (Ideal.map (galRestrict R_F F E R_E ρ⁻¹)) hρ
            rw [← h_map_mul, inv_mul_cancel, h_map_one] at h1
            exact h1.symm }
      have h_le : Subgroup.zpowers σ ≤ H_B := Subgroup.zpowers_le.mpr hB_inv
      intro ρ
      exact h_le (hCyclic ρ)
    have h_main : ∀ n : ℕ, ∀ B : Ideal R_E,
        Ideal.absNorm B = n →
        B ≠ ⊥ →
        IsCoprime (Ideal.relNorm R_F B) m₀ →
        Ideal.map σ_int B = B →
        ∃ A : Ideal R_F,
          A ≠ ⊥ ∧
          IsCoprime A m₀ ∧
          B = Ideal.map (algebraMap R_F R_E) A := by
      intro n
      refine Nat.strong_induction_on n ?_
      intro n ih B hn hB_ne hB_cop hB_inv
      by_cases hB_top : B = ⊤
      · refine ⟨⊤, top_ne_bot, Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀), ?_⟩
        rw [hB_top, Ideal.map_top]
      · obtain ⟨Q, hQ_max, hBQ⟩ := Ideal.exists_le_maximal B hB_top
        haveI : Q.IsMaximal := hQ_max
        have hQ_prime : Q.IsPrime := hQ_max.isPrime
        haveI : Q.IsPrime := hQ_prime
        have hQ_ne_bot : Q ≠ ⊥ := by
          intro hQ_bot
          exact hB_ne (le_bot_iff.mp (hQ_bot ▸ hBQ))
        let q₀ : Ideal R_F := Ideal.under R_F Q
        haveI : Q.LiesOver q₀ := ⟨rfl⟩
        haveI : q₀.IsMaximal := Ideal.IsMaximal.under R_F Q
        have hq₀_prime : q₀.IsPrime := Ideal.IsMaximal.isPrime inferInstance
        have hq₀_ne_bot : q₀ ≠ ⊥ := Ideal.under_ne_bot R_F hQ_ne_bot
        let q : IsDedekindDomain.HeightOneSpectrum R_F := ⟨q₀, hq₀_prime, hq₀_ne_bot⟩
        have hQ_dvd_B : Q ∣ B := Ideal.dvd_iff_le.mpr hBQ
        have hrel_dvd : Ideal.relNorm R_F Q ∣ Ideal.relNorm R_F B :=
          map_dvd (Ideal.relNorm R_F) hQ_dvd_B
        have hrel_Q : Ideal.relNorm R_F Q = q.asIdeal ^ (q.asIdeal.inertiaDeg Q) :=
          Ideal.relNorm_eq_pow_of_isMaximal Q q.asIdeal
        have hf_pos : 0 < q.asIdeal.inertiaDeg Q := Ideal.inertiaDeg_pos q.asIdeal Q
        have hf_ne : q.asIdeal.inertiaDeg Q ≠ 0 := hf_pos.ne'
        have hq_dvd_relQ : q.asIdeal ∣ Ideal.relNorm R_F Q := by
          rw [hrel_Q]
          exact dvd_pow_self q.asIdeal hf_ne
        have hq_dvd_relB : q.asIdeal ∣ Ideal.relNorm R_F B := dvd_trans hq_dvd_relQ hrel_dvd
        rcases hq_dvd_relB with ⟨C₀, hC₀⟩
        have hq_cop : IsCoprime q.asIdeal m₀ := by
          rw [hC₀] at hB_cop
          exact hB_cop.of_mul_left_left
        have hq_not_dvd_m₀ : ¬ (q.asIdeal ∣ m₀) := by
          intro hdvd
          have hm_le : m₀ ≤ q.asIdeal := Ideal.dvd_iff_le.mp hdvd
          have h_top : ⊤ ≤ q.asIdeal := by
            rw [← Ideal.isCoprime_iff_sup_eq.mp hq_cop]
            exact sup_le le_rfl hm_le
          exact q.isMaximal.ne_top (top_le_iff.mp h_top)
        have hq_unr : IsUnramifiedAtPrime F E q := by
          by_contra h_ram
          exact hq_not_dvd_m₀ ((hm₀_dvd q).mpr h_ram)
        let I_q : Ideal R_E := Ideal.map (algebraMap R_F R_E) q.asIdeal
        have hIq_ne : I_q ≠ ⊥ := (Ideal.map_eq_bot_iff_of_injective hinj).not.mpr q.ne_bot
        have hIq_zero : I_q ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have hB_zero : B ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have hIq_dvd_B : I_q ∣ B := by
          rw [UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hIq_zero hB_zero,
            Multiset.le_iff_count]
          intro Q'
          by_cases h_cnt : Multiset.count Q' (UniqueFactorizationMonoid.normalizedFactors I_q) = 0
          · rw [h_cnt]
            exact Nat.zero_le _
          · have hQ'_mem : Q' ∈ UniqueFactorizationMonoid.normalizedFactors I_q :=
              Multiset.count_ne_zero.mp h_cnt
            have hQ'_prime_elt : Prime Q' :=
              UniqueFactorizationMonoid.prime_of_normalized_factor Q' hQ'_mem
            have hQ'_prime : Q'.IsPrime := Ideal.isPrime_of_prime hQ'_prime_elt
            have hQ'_ne_bot : Q' ≠ ⊥ := by
              rw [← Submodule.zero_eq_bot]
              exact hQ'_prime_elt.ne_zero
            haveI : Q'.IsPrime := hQ'_prime
            haveI : Q'.IsMaximal := Ideal.IsPrime.isMaximal hQ'_prime hQ'_ne_bot
            have hQ'_dvd_Iq : Q' ∣ I_q :=
              UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hQ'_mem
            have hIq_le_Q' : I_q ≤ Q' := Ideal.dvd_iff_le.mp hQ'_dvd_Iq
            have hq_le_under : q.asIdeal ≤ Ideal.under R_F Q' :=
              Ideal.map_le_iff_le_comap.mp hIq_le_Q'
            have hQ'_under : Ideal.under R_F Q' = q.asIdeal :=
              (q.isMaximal.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hq_le_under).symm
            haveI : Q'.LiesOver q.asIdeal := ⟨hQ'_under.symm⟩
            have h_ram_one : Ideal.ramificationIdx (algebraMap R_F R_E) q.asIdeal Q' = 1 :=
              hq_unr Q' hQ'_prime hQ'_under
            have h_not_le2 : ¬ (I_q ≤ Q' ^ 2) :=
              (Ideal.ramificationIdx_ne_one_iff hIq_le_Q').not.mp (not_not.mpr h_ram_one)
            have h_cnt_le_one :
                Multiset.count Q' (UniqueFactorizationMonoid.normalizedFactors I_q) ≤ 1 := by
              by_contra h_gt
              have h2 : 2 ≤ Multiset.count Q' (UniqueFactorizationMonoid.normalizedFactors I_q) := by
                omega
              have h_rep : Multiset.replicate 2 Q' ≤
                  UniqueFactorizationMonoid.normalizedFactors I_q :=
                Multiset.le_count_iff_replicate_le.mp h2
              have h_prod_dvd : (Multiset.replicate 2 Q').prod ∣
                  (UniqueFactorizationMonoid.normalizedFactors I_q).prod :=
                Multiset.prod_dvd_prod_of_le h_rep
              rw [Multiset.prod_replicate, prod_normalizedFactors_eq_self hIq_ne,
                Ideal.dvd_iff_le] at h_prod_dvd
              exact h_not_le2 h_prod_dvd
            let P₁ : ↑(q.asIdeal.primesOver R_E) := Ideal.primesOver.mk q.asIdeal Q
            let P₂ : ↑(q.asIdeal.primesOver R_E) := Ideal.primesOver.mk q.asIdeal Q'
            obtain ⟨ρ, hρ⟩ :=
              (Ideal.isPretransitive_of_isGaloisGroup (B := R_E) q.asIdeal (E ≃ₐ[F] E)).exists_smul_eq P₁ P₂
            have hP₂ : (P₂ : Ideal R_E) = Q' := rfl
            have hval := ((Ideal.coe_smul_primesOver_mk ρ Q).symm.trans (congrArg Subtype.val hρ)).trans hP₂
            rw [Ideal.pointwise_smul_eq_comap, Ideal.comap_symm] at hval
            have hB_le_Q' : B ≤ Q' := by
              rw [← h_gal_inv B hB_inv ρ, Ideal.map_le_iff_le_comap]
              intro x hx
              change (galRestrict R_F F E R_E ρ) x ∈ Q'
              have h_eq : (galRestrict R_F F E R_E ρ) x =
                  ((MulSemiringAction.toRingAut (E ≃ₐ[F] E) R_E) ρ) x := by
                apply FaithfulSMul.algebraMap_injective R_E E
                rw [algebraMap_galRestrict_apply]
                rfl
              rw [h_eq, ← hval]
              exact Ideal.mem_map_of_mem _ (hBQ hx)
            have hQ'_mem_B : Q' ∈ UniqueFactorizationMonoid.normalizedFactors B :=
              (Ideal.mem_normalizedFactors_iff hB_ne).mpr ⟨hQ'_prime, hB_le_Q'⟩
            have h_cnt_B_pos :
                1 ≤ Multiset.count Q' (UniqueFactorizationMonoid.normalizedFactors B) :=
              Multiset.count_pos.mpr hQ'_mem_B
            exact h_cnt_le_one.trans h_cnt_B_pos
        rcases hIq_dvd_B with ⟨B', hB_eq⟩
        have hB'_ne : B' ≠ ⊥ := by
          intro hB'_bot
          apply hB_ne
          rw [hB_eq, hB'_bot, Ideal.mul_bot]
        have hB'_zero : B' ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have hB'_cop : IsCoprime (Ideal.relNorm R_F B') m₀ := by
          rw [hB_eq, map_mul] at hB_cop
          exact hB_cop.of_mul_left_right
        have hIq_inv : Ideal.map σ_int I_q = I_q := by
          apply le_antisymm
          · rw [Ideal.map_le_iff_le_comap]
            change Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ Ideal.comap σ_int I_q
            rw [Ideal.map_le_iff_le_comap]
            intro x hx
            change σ_int (algebraMap R_F R_E x) ∈ I_q
            rw [σ_int.commutes x]
            exact Ideal.mem_map_of_mem (algebraMap R_F R_E) hx
          · change Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ Ideal.map σ_int I_q
            rw [Ideal.map_le_iff_le_comap]
            intro x hx
            change algebraMap R_F R_E x ∈ Ideal.map σ_int I_q
            rw [← σ_int.commutes x]
            exact Ideal.mem_map_of_mem σ_int (Ideal.mem_map_of_mem (algebraMap R_F R_E) hx)
        have hB'_inv : Ideal.map σ_int B' = B' := by
          apply mul_left_cancel₀ hIq_zero
          calc
            I_q * Ideal.map σ_int B'
                = Ideal.map σ_int I_q * Ideal.map σ_int B' := by rw [hIq_inv]
            _ = Ideal.map σ_int (I_q * B') := (Ideal.map_mul _ I_q B').symm
            _ = Ideal.map σ_int B := by rw [← hB_eq]
            _ = B := hB_inv
            _ = I_q * B' := hB_eq
        have hIq_le_Q : I_q ≤ Q := Ideal.map_le_iff_le_comap.mpr le_rfl
        have hIq_ne_top : I_q ≠ ⊤ := by
          intro h_top
          exact hQ_max.ne_top (top_le_iff.mp (h_top ▸ hIq_le_Q))
        have hIq_norm_pos : 0 < Ideal.absNorm I_q :=
          Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr (mem_nonZeroDivisors_of_ne_zero hIq_zero)
        have hIq_norm_ne_one : Ideal.absNorm I_q ≠ 1 :=
          Ideal.absNorm_eq_one_iff.not.mpr hIq_ne_top
        have hIq_norm_gt : 1 < Ideal.absNorm I_q := by omega
        have hB'_norm_pos : 0 < Ideal.absNorm B' :=
          Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr (mem_nonZeroDivisors_of_ne_zero hB'_zero)
        have hB'_norm_lt : Ideal.absNorm B' < n := by
          rw [← hn, hB_eq, map_mul]
          exact lt_mul_of_one_lt_left hB'_norm_pos hIq_norm_gt
        obtain ⟨A', hA'_ne, hA'_cop, hB'_map⟩ :=
          ih (Ideal.absNorm B') hB'_norm_lt B' rfl hB'_ne hB'_cop hB'_inv
        have hq_zero : q.asIdeal ≠ 0 := by
          rw [Submodule.zero_eq_bot]
          exact q.ne_bot
        have hA'_zero : A' ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have hqA'_ne : q.asIdeal * A' ≠ ⊥ := by
          rw [← Submodule.zero_eq_bot]
          exact mul_ne_zero hq_zero hA'_zero
        refine ⟨q.asIdeal * A', hqA'_ne, IsCoprime.mul_left hq_cop hA'_cop, ?_⟩
        rw [hB_eq, hB'_map, Ideal.map_mul]
    intro B hB_ne hB_cop hB_inv
    exact h_main (Ideal.absNorm B) B rfl hB_ne hB_cop hB_inv
  · intro A₁ A₂ hA₁ hA₂ hmap
    have h_bot := Ideal.relNorm_algebraMap R_E (⊥ : Ideal R_F)
    rw [Ideal.map_bot, ← Submodule.zero_eq_bot, map_zero, Submodule.zero_eq_bot] at h_bot
    have hrel := congrArg (Ideal.relNorm R_F) hmap
    rw [Ideal.relNorm_algebraMap R_E A₁, Ideal.relNorm_algebraMap R_E A₂] at hrel
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hrel
    rw [UniqueFactorizationMonoid.normalizedFactors_pow,
      UniqueFactorizationMonoid.normalizedFactors_pow] at hnf
    have hnf_eq : UniqueFactorizationMonoid.normalizedFactors A₁ =
        UniqueFactorizationMonoid.normalizedFactors A₂ := by
      ext P
      have hcnt := congrArg (Multiset.count P) hnf
      rw [Multiset.count_nsmul, Multiset.count_nsmul] at hcnt
      refine Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero fun hd0 => ?_) hcnt
      rw [hd0, pow_zero, Ideal.one_eq_top] at h_bot
      exact bot_ne_top h_bot
    rw [← prod_normalizedFactors_eq_self hA₁, ← prod_normalizedFactors_eq_self hA₂, hnf_eq]

theorem unit_ker_inter_coboundary_card_le_and_finite_quotients {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (ext_Cl : ClassGroup (NumberField.RingOfIntegers F) →*
      ClassGroup (NumberField.RingOfIntegers E))
    (hext_Cl : ∀ (A : Ideal (NumberField.RingOfIntegers F))
        (hA : A ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)))
        (hAE : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) A ∈
          nonZeroDivisors (Ideal (NumberField.RingOfIntegers E))),
      ext_Cl (ClassGroup.mk0 ⟨A, hA⟩) =
        ClassGroup.mk0 ⟨Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) A, hAE⟩)
    (hB_cop_rep : ∀ z ∈ Subgroup.map
        (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom)
        (Subgroup.closure { x : Eˣ |
          ∃ b : NumberField.RingOfIntegers E,
            (x : E) = algebraMap (NumberField.RingOfIntegers E) E b ∧
            IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b}) m₀ }),
      ∃ b : NumberField.RingOfIntegers E,
        b ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b}) m₀ ∧
        (z : E) * σ (algebraMap (NumberField.RingOfIntegers E) E b) =
          algebraMap (NumberField.RingOfIntegers E) E b)
    (h_descent : ∀ B : Ideal (NumberField.RingOfIntegers E),
      B ≠ ⊥ →
      IsCoprime (Ideal.relNorm (NumberField.RingOfIntegers F) B) m₀ →
      Ideal.map (galRestrict (NumberField.RingOfIntegers F) F E (NumberField.RingOfIntegers E) σ) B = B →
      ∃ A : Ideal (NumberField.RingOfIntegers F),
        A ≠ ⊥ ∧
        IsCoprime A m₀ ∧
        B = Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) A)
    (h_rep_eq : ∀ (B₁ B₂ : Ideal (NumberField.RingOfIntegers E))
        (hB₁ : B₁ ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers E)))
        (hB₂ : B₂ ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers E))),
      IsCoprime (Ideal.relNorm (NumberField.RingOfIntegers F) B₁) m₀ →
      IsCoprime (Ideal.relNorm (NumberField.RingOfIntegers F) B₂) m₀ →
      ClassGroup.mk0 ⟨B₁, hB₁⟩ = ClassGroup.mk0 ⟨B₂, hB₂⟩ →
      ∃ b₁ b₂ : NumberField.RingOfIntegers E,
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b₂}) m₀ ∧
        B₁ * Ideal.span {b₁} = B₂ * Ideal.span {b₂}) :
    let R_F := NumberField.RingOfIntegers F
    let R_E := NumberField.RingOfIntegers E
    let ι : R_Eˣ →* Eˣ := Units.map (algebraMap R_E E : R_E →* E)
    let K_unit : Subgroup R_Eˣ := (Units.map (Algebra.intNorm R_F R_E)).ker
    let B_unit : Subgroup R_Eˣ :=
      (MonoidHom.id R_Eˣ /
        Units.map (galRestrict R_F F E R_E σ).toMonoidHom).range
    let E_cop : Subgroup Eˣ := Subgroup.closure { x : Eˣ |
      ∃ b : R_E, (x : E) = algebraMap R_E E b ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b}) m₀ }
    let K_cop : Subgroup Eˣ := E_cop ⊓ (Units.map (Algebra.norm F)).ker
    let B_cop : Subgroup Eˣ :=
      Subgroup.map (MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom) E_cop
    let H_unr : Subgroup R_Fˣ := Subgroup.closure { u : R_Fˣ |
      ∃ b₁ b₂ : R_E,
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        (u : R_F) * Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ }
    Nat.card (↥(K_unit ⊓ Subgroup.comap ι B_cop) ⧸
      B_unit.subgroupOf (K_unit ⊓ Subgroup.comap ι B_cop)) ≤
      Nat.card ↥ext_Cl.ker ∧
    Finite (H_unr ⧸ (Units.map (Algebra.intNorm R_F R_E)).range.subgroupOf H_unr) ∧
    Finite (K_cop ⧸ (Subgroup.map ι K_unit ⊔ B_cop).subgroupOf K_cop) :=
by
  classical
  intro R_F R_E ι K_unit B_unit E_cop K_cop B_cop H_unr
  let σ_int := galRestrict R_F F E R_E σ
  have h_top_cop : IsCoprime (⊤ : Ideal R_F) m₀ :=
    Ideal.isCoprime_iff_sup_eq.mpr (top_sup_eq m₀)
  let d := Nat.card (E ≃ₐ[F] E)
  have hd_pos : 0 < d := Nat.card_pos
  have h_ord : orderOf σ = d := orderOf_eq_card_of_forall_mem_zpowers hCyclic
  let e_gal : Fin d → (E ≃ₐ[F] E) := fun j => σ ^ (j : ℕ)
  have he_gal_inj : Function.Injective e_gal := by
    intro j₁ j₂ hj
    have h1 : (j₁ : ℕ) ∈ Set.Iio (orderOf σ) := by rw [Set.mem_Iio, h_ord]; exact j₁.2
    have h2 : (j₂ : ℕ) ∈ Set.Iio (orderOf σ) := by rw [Set.mem_Iio, h_ord]; exact j₂.2
    exact Fin.ext (pow_injOn_Iio_orderOf h1 h2 hj)
  have he_gal_bij : Function.Bijective e_gal := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨he_gal_inj, ?_⟩
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card]
  let e_equiv : Fin d ≃ (E ≃ₐ[F] E) := Equiv.ofBijective e_gal he_gal_bij
  have h_s2 : ∀ x ∈ K_cop,
      ∃ b₁ b₂ c : R_E,
        b₁ ≠ 0 ∧ b₂ ≠ 0 ∧ c ≠ 0 ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
        IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
        Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ ∧
        (x : E) * algebraMap R_E E b₁ = algebraMap R_E E b₂ ∧
        b₂ * σ_int c = b₁ * c := by
    let S_frac : Subgroup Eˣ :=
      { carrier := { y : Eˣ | ∃ b₁ b₂ : R_E,
          b₁ ≠ 0 ∧ b₂ ≠ 0 ∧
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₁}) m₀ ∧
          IsCoprime (Ideal.span {Algebra.intNorm R_F R_E b₂}) m₀ ∧
          (y : E) * algebraMap R_E E b₁ = algebraMap R_E E b₂ }
        one_mem' := ⟨1, 1, one_ne_zero, one_ne_zero,
          by rw [map_one, Ideal.span_singleton_one]; exact h_top_cop,
          by rw [map_one, Ideal.span_singleton_one]; exact h_top_cop,
          by simp⟩
        mul_mem' := by
          rintro y z ⟨by₁, by₂, hby₁, hby₂, hcy₁, hcy₂, hy⟩ ⟨bz₁, bz₂, hbz₁, hbz₂, hcz₁, hcz₂, hz⟩
          refine ⟨by₁ * bz₁, by₂ * bz₂, mul_ne_zero hby₁ hbz₁, mul_ne_zero hby₂ hbz₂, ?_, ?_, ?_⟩
          · rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
            exact hcy₁.mul_left hcz₁
          · rw [map_mul, ← Ideal.span_singleton_mul_span_singleton]
            exact hcy₂.mul_left hcz₂
          · simp only [Units.val_mul, map_mul]
            calc
              ((y : E) * (z : E)) * (algebraMap R_E E by₁ * algebraMap R_E E bz₁)
                  = ((y : E) * algebraMap R_E E by₁) * ((z : E) * algebraMap R_E E bz₁) := by ring
              _ = algebraMap R_E E by₂ * algebraMap R_E E bz₂ := by rw [hy, hz]
        inv_mem' := by
          rintro y ⟨b₁, b₂, hb₁, hb₂, hc₁, hc₂, hy⟩
          refine ⟨b₂, b₁, hb₂, hb₁, hc₂, hc₁, ?_⟩
          rw [Units.val_inv_eq_inv_val, ← hy, inv_mul_cancel_left₀ y.ne_zero] }
    have hE_le : E_cop ≤ S_frac := by
      rw [Subgroup.closure_le]
      rintro y ⟨b, hy_eq, hb_cop⟩
      have hb_ne : b ≠ 0 := by
        intro h0
        apply y.ne_zero
        rw [hy_eq, h0, map_zero]
      refine ⟨1, b, one_ne_zero, hb_ne, ?_, hb_cop, ?_⟩
      · rw [map_one, Ideal.span_singleton_one]; exact h_top_cop
      · rw [map_one, mul_one, hy_eq]
    have h_li_alg : LinearIndependent E (fun j : Fin d => (e_gal j).toAlgHom.toLinearMap) := by
      have h1 := linearIndependent_algHom_toLinearMap F E E
      exact h1.comp (fun j : Fin d => (e_gal j).toAlgHom)
        (AlgEquiv.coe_algHom_injective.comp he_gal_inj)
    intro x hx
    obtain ⟨b₁, b₂, hb₁, hb₂, hb₁_cop, hb₂_cop, hx_eq⟩ := hE_le hx.1
    have hx_norm : Algebra.norm F (x : E) = 1 := by
      have hk : Units.map (Algebra.norm F) x = 1 := hx.2
      exact congrArg Units.val hk
    have hnorm_eq : Algebra.intNorm R_F R_E b₁ = Algebra.intNorm R_F R_E b₂ := by
      apply FaithfulSMul.algebraMap_injective R_F F
      rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
        ← hx_eq, map_mul, hx_norm, one_mul]
    let a : ℕ → E := fun k => ∏ i ∈ Finset.range k, (σ ^ i) (x : E)
    have ha0 : a 0 = 1 := Finset.prod_range_zero _
    have ha_succ : ∀ k : ℕ, (x : E) * σ (a k) = a (k + 1) := by
      intro k
      dsimp [a]
      rw [map_prod, Finset.prod_range_succ', pow_zero, AlgEquiv.one_apply, mul_comm]
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [pow_succ', AlgEquiv.mul_apply]
    have had : a d = 1 := by
      dsimp [a]
      rw [← Fin.prod_univ_eq_prod_range]
      have h_prod_eq : (∏ j : Fin d, (σ ^ (j : ℕ)) (x : E)) = ∏ ρ : (E ≃ₐ[F] E), ρ (x : E) :=
        Equiv.prod_comp e_equiv (fun ρ => ρ (x : E))
      rw [h_prod_eq, ← Algebra.norm_eq_prod_automorphisms F (x : E), hx_norm, map_one]
    let W : E → E := fun θ => ∑ j : Fin d, a j.1 * (e_gal j) θ
    have hW_rel : ∀ θ : E, (x : E) * σ (W θ) = W θ := by
      intro θ
      have hW_range : W θ = ∑ j ∈ Finset.range d, a j * (σ ^ j) θ := by
        dsimp [W, e_gal]
        exact Fin.sum_univ_eq_sum_range (fun j => a j * (σ ^ j) θ) d
      rw [hW_range, map_sum, Finset.mul_sum]
      have h_term : ∀ j : ℕ, (x : E) * σ (a j * (σ ^ j) θ) = a (j + 1) * (σ ^ (j + 1)) θ := by
        intro j
        rw [map_mul, ← mul_assoc, ha_succ j, ← AlgEquiv.mul_apply, ← pow_succ']
      simp_rw [h_term]
      have hd_sub : d = (d - 1) + 1 := (Nat.sub_add_cancel hd_pos).symm
      have hσ_d : σ ^ d = 1 := by rw [← h_ord, pow_orderOf_eq_one]
      conv_lhs => rw [hd_sub, Finset.sum_range_succ, ← hd_sub, had, hσ_d, ← ha0, ← pow_zero σ]
      conv_rhs => rw [hd_sub, Finset.sum_range_succ']
    have h_ex_θ : ∃ θ : E, W θ ≠ 0 := by
      by_contra h_all
      push_neg at h_all
      have h_lin_zero : ∑ j : Fin d, a j.1 • (e_gal j).toAlgHom.toLinearMap = 0 := by
        ext θ
        simp only [LinearMap.sum_apply, LinearMap.smul_apply, AlgHom.toLinearMap_apply,
          AlgEquiv.toAlgHom_eq_coe, AlgHom.coe_coe, smul_eq_mul, LinearMap.zero_apply]
        exact h_all θ
      have ha0_zero : a (⟨0, hd_pos⟩ : Fin d).1 = 0 :=
        Fintype.linearIndependent_iff.mp h_li_alg (fun j => a j.1) h_lin_zero ⟨0, hd_pos⟩
      dsimp at ha0_zero
      rw [ha0] at ha0_zero
      exact one_ne_zero ha0_zero
    obtain ⟨θ, hθ_ne⟩ := h_ex_θ
    let y₀ : E := W θ
    obtain ⟨num, den, hden_mem, hy₀_div⟩ := IsFractionRing.div_surjective (A := R_E) y₀
    have hden_ne : (den : R_E) ≠ 0 := nonZeroDivisors.ne_zero hden_mem
    have hden_E_ne : algebraMap R_E E (den : R_E) ≠ 0 :=
      (map_ne_zero_iff (algebraMap R_E E) (FaithfulSMul.algebraMap_injective R_E E)).mpr hden_ne
    have hnum_eq : algebraMap R_E E num = y₀ * algebraMap R_E E (den : R_E) := by
      rw [← hy₀_div, div_mul_cancel₀ _ hden_E_ne]
    let cof : R_E := ∏ ρ ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase 1,
      galRestrict R_F F E R_E ρ (den : R_E)
    let c : R_E := num * cof
    let z_F : E := algebraMap F E (Algebra.norm F (algebraMap R_E E (den : R_E)))
    have hz_F_ne : z_F ≠ 0 :=
      (map_ne_zero_iff (algebraMap F E) (algebraMap F E).injective).mpr
        (Algebra.norm_ne_zero_iff.mpr hden_E_ne)
    have h_den_cof : algebraMap R_E E (den : R_E) * algebraMap R_E E cof = z_F := by
      dsimp [cof, z_F]
      rw [map_prod]
      simp_rw [algebraMap_galRestrict_apply]
      calc
        algebraMap R_E E (den : R_E) *
            ∏ x ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase 1, x (algebraMap R_E E (den : R_E))
            = (1 : E ≃ₐ[F] E) (algebraMap R_E E (den : R_E)) *
                ∏ x ∈ (Finset.univ : Finset (E ≃ₐ[F] E)).erase 1, x (algebraMap R_E E (den : R_E)) := by
              rw [AlgEquiv.one_apply]
        _ = ∏ x : E ≃ₐ[F] E, x (algebraMap R_E E (den : R_E)) :=
              Finset.mul_prod_erase Finset.univ
                (fun ρ : E ≃ₐ[F] E => ρ (algebraMap R_E E (den : R_E))) (Finset.mem_univ 1)
        _ = algebraMap F E (Algebra.norm F (algebraMap R_E E (den : R_E))) :=
              (Algebra.norm_eq_prod_automorphisms F (algebraMap R_E E (den : R_E))).symm
    have hc_E : algebraMap R_E E c = y₀ * z_F := by
      dsimp [c]
      rw [map_mul, hnum_eq, mul_assoc, h_den_cof]
    have hc_ne : c ≠ 0 := by
      intro hc0
      apply mul_ne_zero hθ_ne hz_F_ne
      rw [← hc_E, hc0, map_zero]
    have hσ_zF : σ z_F = z_F := AlgEquiv.commutes σ _
    have hc_rel_E : (x : E) * σ (algebraMap R_E E c) = algebraMap R_E E c := by
      rw [hc_E, map_mul, hσ_zF, ← mul_assoc, hW_rel θ]
    have hmul : b₂ * σ_int c = b₁ * c := by
      apply FaithfulSMul.algebraMap_injective R_E E
      rw [map_mul (algebraMap R_E E) b₂ (σ_int c), map_mul (algebraMap R_E E) b₁ c,
        algebraMap_galRestrict_apply, ← hx_eq]
      calc
        ((x : E) * algebraMap R_E E b₁) * σ (algebraMap R_E E c)
            = algebraMap R_E E b₁ * ((x : E) * σ (algebraMap R_E E c)) := by ring
        _ = algebraMap R_E E b₁ * algebraMap R_E E c := by rw [hc_rel_E]
    exact ⟨b₁, b₂, c, hb₁, hb₂, hc_ne, hb₁_cop, hb₂_cop, hnorm_eq, hx_eq, hmul⟩
  refine ⟨?_, ?_, ?_⟩
  · let G_amb : Subgroup R_Eˣ := K_unit ⊓ Subgroup.comap ι B_cop
    let Q_amb := ↥G_amb ⧸ B_unit.subgroupOf G_amb
    have h_wit : ∀ w : G_amb, ∃ (b : R_E) (A : Ideal R_F),
        b ≠ 0 ∧ A ≠ ⊥ ∧
        (w.1 : R_E) * σ_int b = b ∧
        Ideal.span {b} = Ideal.map (algebraMap R_F R_E) A := by
      intro w
      have hw_cop : ι w.1 ∈ B_cop := w.2.2
      obtain ⟨b, hb_ne, hb_cop, hb_eq⟩ := hB_cop_rep (ι w.1) hw_cop
      have hb_int : (w.1 : R_E) * σ_int b = b := by
        apply FaithfulSMul.algebraMap_injective R_E E
        rw [map_mul, algebraMap_galRestrict_apply R_F σ b]
        exact hb_eq
      have hB_ne : Ideal.span ({b} : Set R_E) ≠ ⊥ :=
        Ideal.span_singleton_eq_bot.not.mpr hb_ne
      have hB_cop : IsCoprime (Ideal.relNorm R_F (Ideal.span {b})) m₀ := by
        rwa [Ideal.relNorm_singleton]
      have hB_inv : Ideal.map σ_int (Ideal.span {b}) = Ideal.span {b} := by
        rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_eq_span_singleton]
        refine ⟨w.1, ?_⟩
        rw [mul_comm, hb_int]
