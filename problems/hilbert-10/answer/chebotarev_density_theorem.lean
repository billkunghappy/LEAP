            ∃ γ ∈ H, IsArithFrobAt (NumberField.RingOfIntegers L) γ Q) := by
      intro P hP
      have hP_not_I₁ : ¬ (P.asIdeal ∣ I₁) :=
        fun h => hP (dvd_trans h (dvd_mul_of_dvd_left (dvd_mul_right I₁ I₂) I₃))
      have hP_not_I₂ : ¬ (P.asIdeal ∣ I₂) :=
        fun h => hP (dvd_trans h (dvd_mul_of_dvd_left (dvd_mul_left I₂ I₁) I₃))
      have hP_not_I₃ : ¬ (P.asIdeal ∣ I₃) :=
        fun h => hP (dvd_trans h (dvd_mul_left I₃ (I₁ * I₂)))
      haveI : P.asIdeal.IsPrime := P.isPrime
      haveI : P.asIdeal.IsMaximal := P.isMaximal
      have hP_unr : IsUnramifiedAtPrime L M P := by
        by_contra h_ram_P
        rw [IsUnramifiedAtPrime] at h_ram_P
        push_neg at h_ram_P
        rcases h_ram_P with ⟨Q, hQ_prime, hQ_under, hQ_ram⟩
        haveI : Q.IsPrime := hQ_prime
        haveI : Q.LiesOver P.asIdeal := ⟨hQ_under.symm⟩
        haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q P.asIdeal
        have h_map :
            Ideal.map (algebraMap (NumberField.RingOfIntegers L) (NumberField.RingOfIntegers M))
