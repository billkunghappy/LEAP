        rw [IsUnramifiedAtPrime] at h_ram_p₀
        push_neg at h_ram_p₀
        rcases h_ram_p₀ with ⟨Q_E, hQE_prime, hQE_under, hQE_ram⟩
        haveI : Q_E.IsPrime := hQE_prime
        haveI : p₀.asIdeal.IsMaximal := p₀.isMaximal
        haveI : Q_E.LiesOver p₀.asIdeal := ⟨hQE_under.symm⟩
        haveI : Q_E.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q_E p₀.asIdeal
        have h_map :
            Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
              p₀.asIdeal ≤ Q_E :=
          Ideal.map_le_iff_le_comap.mpr hQE_under.symm.le
        have h_le2 :
            Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
