    letI : Fintype Ideal_le_n := Fintype.ofEquiv _ e_ideal
    have hCollapse :
        (∑ k ∈ Finset.Icc 1 n, (∑' f : F_fib k, A f.val)) =
          ∑ u : Ideal_le_n, ϕ u.val := by
      have h_tsum : ∀ k : ℕ, (∑' f : F_fib k, A f.val) = ∑ f : F_fib k, ϕ (I f.val) := by
        intro k
        rw [tsum_fintype]
        refine Finset.sum_congr rfl fun f _ => hA_eq_ϕ f.val
      simp_rw [h_tsum]
      have h_sigma :
          (∑ x : Finset.Icc 1 n, ∑ f : F_fib x.1, ϕ (I f.val)) =
            ∑ p : (k : Finset.Icc 1 n) × F_fib k.1, ϕ (I p.2.val) :=
        (Fintype.sum_sigma (f := fun p : (k : Finset.Icc 1 n) × F_fib k.1 => ϕ (I p.2.val))).symm
      rw [← Finset.sum_attach (Finset.Icc 1 n) (fun k => ∑ f : F_fib k, ϕ (I f.val)),
        ← Finset.univ_eq_attach, h_sigma]
      exact (Equiv.sum_comp e_le_n (fun f : F_le_n => ϕ (I f.val))).trans
        (Equiv.sum_comp e_ideal (fun u : Ideal_le_n => ϕ u.val))
    let InRayCell : Ideal R_K → Ideal R_K → Prop := fun I₀ J₀ =>
      ∃ α : R_K,
        α - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (α : K)).re) ∧
        I₀ * J₀ = Ideal.span {α}
    have h_cell_cop : ∀ (I₀ J₀ : Ideal R_K), InRayCell I₀ J₀ → IsCoprime I₀ 𝔪 := by
      rintro I₀ J₀ ⟨α, hα_m, _, hIJ⟩
      have h_cop_prod : IsCoprime (I₀ * J₀) 𝔪 := by
        rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
        have hα_mem : α ∈ I₀ * J₀ := by
          rw [hIJ]
          exact Ideal.subset_span (Set.mem_singleton α)
        have h_neg : 1 - α ∈ 𝔪 := by
          have h1 : -(α - 1) ∈ 𝔪 := 𝔪.neg_mem hα_m
          rwa [neg_sub] at h1
        have h_sum : α + (1 - α) ∈ (I₀ * J₀) ⊔ 𝔪 :=
          Submodule.add_mem_sup hα_mem h_neg
        rwa [add_sub_cancel] at h_sum
      exact IsCoprime.of_mul_left_left h_cop_prod
    have hϕ_expand : ∀ u : Ideal_le_n,
        ϕ u.val = ∑ j : Fin N_ray, (if InRayCell u.val (J_all j) then (ϕ (J_all j))⁻¹ else 0) := by
      intro u
      by_cases h_cop : IsCoprime u.val 𝔪
      · obtain ⟨j₀, hj₀⟩ := hJ_cov u.val u.2.1 h_cop
        have h_iff : ∀ j : Fin N_ray, InRayCell u.val (J_all j) ↔ j = j₀ :=
          fun j => ⟨fun hj => hJ_inj u.val j j₀ u.2.1 hj hj₀, fun h => h ▸ hj₀⟩
        simp only [h_iff, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
        exact hϕ_cell u.val j₀ u.2.1 hj₀
      · have h_not_cell : ∀ j : Fin N_ray, InRayCell u.val (J_all j) ↔ False :=
          fun j => ⟨fun hj => h_cop (h_cell_cop u.val (J_all j) hj), False.elim⟩
        simp only [h_not_cell, ↓reduceIte, Finset.sum_const_zero]
        exact hϕ_not_cop u.val h_cop
    have h_clear : ∀ (J₀ : Ideal R_K), J₀ ≠ ⊥ →
        Nat.card { I₀ : Ideal R_K //
          I₀ ≠ ⊥ ∧ InRayCell I₀ J₀ ∧ Ideal.absNorm I₀ ≤ n } =
        Nat.card { P : Ideal R_K //
          P ≠ ⊥ ∧
          (∃ a ∈ J₀,
            a - 1 ∈ 𝔪 ∧
            (∀ w : NumberField.InfinitePlace K,
              w.IsReal → 0 < (w.embedding (a : K)).re) ∧
            P = Ideal.span {a}) ∧
          Ideal.absNorm P ≤ n * Ideal.absNorm J₀ } := by
      intro J₀ hJ₀
      have hJ₀_pos : 0 < Ideal.absNorm J₀ :=
        Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
          (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact hJ₀))
      let L_sub := { I₀ : Ideal R_K // I₀ ≠ ⊥ ∧ InRayCell I₀ J₀ ∧ Ideal.absNorm I₀ ≤ n }
      let R_sub := { P : Ideal R_K //
          P ≠ ⊥ ∧
          (∃ a ∈ J₀,
            a - 1 ∈ 𝔪 ∧
            (∀ w : NumberField.InfinitePlace K,
              w.IsReal → 0 < (w.embedding (a : K)).re) ∧
            P = Ideal.span {a}) ∧
          Ideal.absNorm P ≤ n * Ideal.absNorm J₀ }
      let Φ_mul : L_sub → R_sub :=
        fun u =>
          ⟨u.1 * J₀,
            by
              let I₀ : Ideal R_K := u.1
              have hI_ne : I₀ ≠ ⊥ := u.2.1
              have hJ_ne : J₀ ≠ ⊥ := hJ₀
              change I₀ * J₀ ≠ ⊥
              rw [← Submodule.zero_eq_bot] at hI_ne hJ_ne ⊢
              exact mul_ne_zero hI_ne hJ_ne,
            by
              rcases u.2.2.1 with ⟨a, ha_m, ha_pos, hIJ_eq⟩
              refine ⟨a, ?_, ha_m, ha_pos, hIJ_eq⟩
              have ha_span : a ∈ Ideal.span {a} := Ideal.subset_span (Set.mem_singleton a)
              rw [← hIJ_eq] at ha_span
              exact Ideal.mul_le_left ha_span,
            by
              rw [map_mul]
              exact Nat.mul_le_mul_right (Ideal.absNorm J₀) u.2.2.2⟩
      have hΦ_mul_inj : Function.Injective Φ_mul := by
        intro x₁ x₂ h
        have h_val : x₁.1 * J₀ = x₂.1 * J₀ := congrArg Subtype.val h
        have hJ0 : J₀ ≠ 0 := by rw [Submodule.zero_eq_bot]; exact hJ₀
        exact Subtype.ext (mul_right_cancel₀ hJ0 h_val)
      have hΦ_mul_surj : Function.Surjective Φ_mul := by
        rintro ⟨P, hP_ne, ⟨a, ha_J, ha_m, ha_pos, hP_eq⟩, hP_le⟩
        have hP_le_J : P ≤ J₀ := by
          rw [hP_eq, Ideal.span_singleton_le_iff_mem]
          exact ha_J
        have hJ_dvd_P : J₀ ∣ P := Ideal.dvd_iff_le.mpr hP_le_J
        rcases hJ_dvd_P with ⟨I₀, hP_JI⟩
        have hIJ_P : I₀ * J₀ = P := by rw [mul_comm, ← hP_JI]
        have hI_ne : I₀ ≠ ⊥ := by
          intro hI_bot
          apply hP_ne
          rw [← hIJ_P, hI_bot, Ideal.bot_mul]
        have hI_le : Ideal.absNorm I₀ ≤ n := by
          apply Nat.le_of_mul_le_mul_right _ hJ₀_pos
          rw [← map_mul, hIJ_P]
          exact hP_le
        refine ⟨⟨I₀, hI_ne, ⟨a, ha_m, ha_pos, by rw [hIJ_P, hP_eq]⟩, hI_le⟩, Subtype.ext hIJ_P⟩
      exact Nat.card_congr (Equiv.ofBijective Φ_mul ⟨hΦ_mul_inj, hΦ_mul_surj⟩)
    change (∑ k ∈ Finset.Icc 1 n, (∑' f : F_fib k, A f.val)) = _
    rw [hCollapse]
    simp_rw [hϕ_expand]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    let Q_j : Ideal_le_n → Prop := fun u => InRayCell u.val (J_all j)
    change (∑ u : Ideal_le_n, if Q_j u then (ϕ (J_all j))⁻¹ else 0) = _
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul, mul_comm,
      ← Fintype.card_subtype Q_j, ← Nat.card_eq_fintype_card]
    let e_j : { u : Ideal_le_n // Q_j u } ≃
        { I₀ : Ideal R_K // I₀ ≠ ⊥ ∧ InRayCell I₀ (J_all j) ∧ Ideal.absNorm I₀ ≤ n } :=
      { toFun := fun ⟨⟨I₀, hI₀_ne, hI₀_le⟩, hI₀_cell⟩ => ⟨I₀, hI₀_ne, hI₀_cell, hI₀_le⟩
        invFun := fun ⟨I₀, hI₀_ne, hI₀_cell, hI₀_le⟩ => ⟨⟨I₀, hI₀_ne, hI₀_le⟩, hI₀_cell⟩
        left_inv := fun ⟨⟨_, _, _⟩, _⟩ => rfl
        right_inv := fun ⟨_, _, _, _⟩ => rfl }
    congr 2
    exact (Nat.card_congr e_j).trans (h_clear (J_all j) (hJ_prop j).1)
  
  have h_s5 : ∀ {s : ℝ}, 1 < s →
      Summable (fun P : ι => ((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s))) →
      Summable (fun P : ι => ((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-2 : ℝ))) →
      Summable (fun P : ι =>
        ϕ P.asIdeal * (((Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)) ∧
