          _ = (Ideal.span {b₁ q₁} * Ideal.span {b₂ q₂} * Ideal.span {d₂} * Ideal.span {σ_int d₁}) * K_prod := by
                dsimp [K_prod]; ring
      have h_span_cancel := mul_right_cancel₀ hK_ne h_ideal_comb
      simp only [Ideal.span_singleton_mul_span_singleton] at h_span_cancel
      rw [Ideal.span_singleton_eq_span_singleton] at h_span_cancel
      obtain ⟨u, hu⟩ := h_span_cancel
      have h_intNorm_σ : ∀ b : R_E, Algebra.intNorm R_F R_E (σ_int b) = Algebra.intNorm R_F R_E b := by
        intro b
        apply FaithfulSMul.algebraMap_injective R_F F
        rw [Algebra.algebraMap_intNorm (L := E), Algebra.algebraMap_intNorm (L := E),
          algebraMap_galRestrict_apply, Algebra.norm_eq_of_algEquiv]
      have h_norm_hu := congrArg (Algebra.intNorm R_F R_E) hu
      simp only [map_mul, h_intNorm_σ, ← hnorm_eq q₁, ← hnorm_eq q₂] at h_norm_hu
      have h_norm_Reorder :
          (Algebra.intNorm R_F R_E (b₁ q₁) * Algebra.intNorm R_F R_E (b₁ q₂) *
            Algebra.intNorm R_F R_E d₁ * Algebra.intNorm R_F R_E d₂) * Algebra.intNorm R_F R_E (u : R_E) =
          (Algebra.intNorm R_F R_E (b₁ q₁) * Algebra.intNorm R_F R_E (b₁ q₂) *
            Algebra.intNorm R_F R_E d₁ * Algebra.intNorm R_F R_E d₂) * 1 := by
        calc
          (Algebra.intNorm R_F R_E (b₁ q₁) * Algebra.intNorm R_F R_E (b₁ q₂) *
            Algebra.intNorm R_F R_E d₁ * Algebra.intNorm R_F R_E d₂) * Algebra.intNorm R_F R_E (u : R_E)
              = Algebra.intNorm R_F R_E (b₁ q₁) * Algebra.intNorm R_F R_E (b₁ q₂) *
                Algebra.intNorm R_F R_E d₂ * Algebra.intNorm R_F R_E d₁ := h_norm_hu
          _ = (Algebra.intNorm R_F R_E (b₁ q₁) * Algebra.intNorm R_F R_E (b₁ q₂) *
                Algebra.intNorm R_F R_E d₁ * Algebra.intNorm R_F R_E d₂) * 1 := by ring
      have h_intNorm_ne_zero : ∀ b : R_E, b ≠ 0 → Algebra.intNorm R_F R_E b ≠ 0 := by
        intro b hb h0
        apply hb
        apply FaithfulSMul.algebraMap_injective R_E E
        rw [map_zero]
        apply (Algebra.norm_eq_zero_iff (R := F)).mp
        rw [← Algebra.algebraMap_intNorm (A := R_F), h0, map_zero]
      have h_norm_prod_ne :
          Algebra.intNorm R_F R_E (b₁ q₁) * Algebra.intNorm R_F R_E (b₁ q₂) *
            Algebra.intNorm R_F R_E d₁ * Algebra.intNorm R_F R_E d₂ ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero
          (h_intNorm_ne_zero _ (hb₁ q₁)) (h_intNorm_ne_zero _ (hb₁ q₂)))
          (h_intNorm_ne_zero _ hd₁)) (h_intNorm_ne_zero _ hd₂)
      have hu_norm : Algebra.intNorm R_F R_E (u : R_E) = 1 :=
        mul_left_cancel₀ h_norm_prod_ne h_norm_Reorder
      have hu_ker : u ∈ K_unit := by
        change Units.map (Algebra.intNorm R_F R_E) u = 1
        apply Units.ext
        exact hu_norm
      have hd₁_E : algebraMap R_E E d₁ ≠ 0 :=
        (map_ne_zero_iff (algebraMap R_E E) (FaithfulSMul.algebraMap_injective R_E E)).mpr hd₁
      have hd₂_E : algebraMap R_E E d₂ ≠ 0 :=
        (map_ne_zero_iff (algebraMap R_E E) (FaithfulSMul.algebraMap_injective R_E E)).mpr hd₂
      let ud₁ : Eˣ := Units.mk0 (algebraMap R_E E d₁) hd₁_E
      let ud₂ : Eˣ := Units.mk0 (algebraMap R_E E d₂) hd₂_E
      have hud₁_mem : ud₁ ∈ E_cop := Subgroup.subset_closure ⟨d₁, rfl, hd₁_cop⟩
      have hud₂_mem : ud₂ ∈ E_cop := Subgroup.subset_closure ⟨d₂, rfl, hd₂_cop⟩
      let y_cop : Eˣ := ud₂ * ud₁⁻¹
      have hy_mem : y_cop ∈ E_cop := E_cop.mul_mem hud₂_mem (E_cop.inv_mem hud₁_mem)
      let δ_E : Eˣ →* Eˣ := MonoidHom.id Eˣ / Units.map (σ : E ≃* E).toMonoidHom
      have hz_mem : δ_E y_cop ∈ B_cop := ⟨y_cop, hy_mem, rfl⟩
      have h_u_mem : ι u ∈ Subgroup.map ι K_unit := ⟨u, hu_ker, rfl⟩
      have h_rel_E : ((x q₁).1)⁻¹ * (x q₂).1 = ι u * δ_E (y_cop⁻¹) := by
        have hb₁₁_E : algebraMap R_E E (b₁ q₁) ≠ 0 :=
          (map_ne_zero_iff (algebraMap R_E E) (FaithfulSMul.algebraMap_injective R_E E)).mpr (hb₁ q₁)
        have hb₁₂_E : algebraMap R_E E (b₁ q₂) ≠ 0 :=
          (map_ne_zero_iff (algebraMap R_E E) (FaithfulSMul.algebraMap_injective R_E E)).mpr (hb₁ q₂)
        have hσd₁_E : σ (algebraMap R_E E d₁) ≠ 0 :=
          (map_ne_zero_iff σ σ.injective).mpr hd₁_E
        have hσd₂_E : σ (algebraMap R_E E d₂) ≠ 0 :=
          (map_ne_zero_iff σ σ.injective).mpr hd₂_E
        have hu_E := congrArg (algebraMap R_E E) hu
        simp only [map_mul, σ_int, algebraMap_galRestrict_apply, ← hx_eq q₁, ← hx_eq q₂] at hu_E
        have hu_E_re :
            (algebraMap R_E E (b₁ q₁) * algebraMap R_E E (b₁ q₂)) *
              (((x q₁).1 : E) * algebraMap R_E E d₁ * σ (algebraMap R_E E d₂) * algebraMap R_E E (u : R_E)) =
            (algebraMap R_E E (b₁ q₁) * algebraMap R_E E (b₁ q₂)) *
              (((x q₂).1 : E) * algebraMap R_E E d₂ * σ (algebraMap R_E E d₁)) := by
          linear_combination hu_E
        have hu_E_cancel :
            ((x q₁).1 : E) * algebraMap R_E E d₁ * σ (algebraMap R_E E d₂) * algebraMap R_E E (u : R_E) =
            ((x q₂).1 : E) * algebraMap R_E E d₂ * σ (algebraMap R_E E d₁) :=
          mul_left_cancel₀ (mul_ne_zero hb₁₁_E hb₁₂_E) hu_E_re
        have hy_inv : y_cop⁻¹ = ud₁ * ud₂⁻¹ := by
          dsimp [y_cop]
          rw [mul_inv_rev, inv_inv]
        rw [hy_inv]
        apply Units.ext
        simp only [Units.val_mul, Units.val_inv_eq_inv_val, δ_E, MonoidHom.div_apply,
          MonoidHom.id_apply, Units.val_div_eq_div_val,
          map_mul (Units.map (σ : E ≃* E).toMonoidHom),
          map_inv (Units.map (σ : E ≃* E).toMonoidHom), ud₁, ud₂, Units.val_mk0]
        change ((x q₁).1 : E)⁻¹ * ((x q₂).1 : E) =
          (algebraMap R_E E (u : R_E)) *
            ((algebraMap R_E E d₁ * (algebraMap R_E E d₂)⁻¹) /
              (σ (algebraMap R_E E d₁) * (σ (algebraMap R_E E d₂))⁻¹))
        have hu_val_ne : algebraMap R_E E (u : R_E) ≠ 0 := (ι u).ne_zero
        have hx₁_val_ne : ((x q₁).1 : E) ≠ 0 := (x q₁).1.ne_zero
        field_simp [hd₁_E, hd₂_E, hσd₁_E, hσd₂_E, hu_val_ne, hx₁_val_ne]
        linear_combination (-(1 : E)) * hu_E_cancel
      have h_mem_sup : ((x q₁).1)⁻¹ * (x q₂).1 ∈ Subgroup.map ι K_unit ⊔ B_cop := by
        rw [h_rel_E]
        exact Subgroup.mul_mem_sup h_u_mem ⟨y_cop⁻¹, E_cop.inv_mem hy_mem, rfl⟩
      have h_q_eq : (QuotientGroup.mk (x q₁) : Q_K) = QuotientGroup.mk (x q₂) := by
        rw [QuotientGroup.eq]
        exact h_mem_sup
      rw [← hx_mk q₁, ← hx_mk q₂, h_q_eq]
    exact Finite.of_injective ψ hψ_inj

theorem ambiguous_classGroup_card_le_ext_range_mul_coprime_ker_mul_unit_sub_of_nonzero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (σ_Cl : ClassGroup (NumberField.RingOfIntegers E) →*
      ClassGroup (NumberField.RingOfIntegers E))
    (hσ_Cl : ∀ (B : Ideal (NumberField.RingOfIntegers E))
        (hB : B ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers E)))
