          change γ ((algebraMap (NumberField.RingOfIntegers K') (NumberField.RingOfIntegers M) y :
              NumberField.RingOfIntegers M) : M) =
            ((algebraMap (NumberField.RingOfIntegers K') (NumberField.RingOfIntegers M) y :
              NumberField.RingOfIntegers M) : M)
          rw [h1]
          exact (IntermediateField.mem_fixedField_iff H ((y : K') : M)).mp (y : K').2 γ hγ_mem
        have h_sub_mem :
            ∀ y : NumberField.RingOfIntegers K',
              y - y ^ (Nat.card (NumberField.RingOfIntegers L ⧸ P.asIdeal)) ∈ P' := by
          intro y
          have h2 :
              γ • (algebraMap (NumberField.RingOfIntegers K') (NumberField.RingOfIntegers M) y) -
                (algebraMap (NumberField.RingOfIntegers K') (NumberField.RingOfIntegers M) y) ^
                  Nat.card (NumberField.RingOfIntegers L ⧸ Ideal.under (NumberField.RingOfIntegers L) Q) ∈ Q :=
