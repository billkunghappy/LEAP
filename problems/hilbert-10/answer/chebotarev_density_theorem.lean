        intro P' hP'_prime hP'_over
        haveI : P'.IsPrime := hP'_prime
        haveI : P'.LiesOver P.asIdeal := hP'_over
        haveI : P'.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal P' P.asIdeal
        have hP'_under_L : Ideal.under (NumberField.RingOfIntegers L) P' = P.asIdeal :=
