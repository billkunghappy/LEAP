        ⟨q_Q, ⟨hq_s4, ⟨p, hq_under, hp_unram, hq_card⟩⟩, hq_under⟩
    have hΦ_inj : Function.Injective Φ := by
      rintro ⟨Q₁, hQ₁_prime, hQ₁_under, hQ₁_frob⟩ ⟨Q₂, hQ₂_prime, hQ₂_under, hQ₂_frob⟩ h_eq
      have h_under_eq :
          Ideal.under
            (NumberField.RingOfIntegers (IntermediateField.fixedField (Subgroup.zpowers σ))) Q₁ =
          Ideal.under
            (NumberField.RingOfIntegers (IntermediateField.fixedField (Subgroup.zpowers σ))) Q₂ :=
        congrArg (fun z => z.1.asIdeal) h_eq
      exact Subtype.ext (h_s5 Q₁ Q₂ hQ₁_prime hQ₂_prime hQ₁_frob h_under_eq)
    have hΦ_surj : Function.Surjective Φ := by
      rintro ⟨q, ⟨⟨hq_unram, hq_frob⟩, p', hp'_under, _, hp'_card⟩, hq_under⟩
      have hp'_eq : p' = p :=
        IsDedekindDomain.HeightOneSpectrum.ext (hp'_under.symm.trans hq_under)
      rw [hp'_eq] at hp'_card
      obtain ⟨Q, hQ_prime, hQ_under_F, hQ_under_K, hQ_frob, _⟩ :=
        h_s2 q p hq_unram hq_frob hq_under hp'_card
      refine ⟨⟨Q, hQ_prime, hQ_under_K, hQ_frob⟩, ?_⟩
      exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext hQ_under_F)
    exact (Nat.card_congr (Equiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩)).symm

theorem card_primesOver_with_arithFrobAt {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
    (σ : L ≃ₐ[K] L) :
    ∃ m : ℕ,
      m * Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } *
        Nat.card (Subgroup.zpowers σ) = Nat.card (L ≃ₐ[K] L) ∧
      ∀ p ∈ { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          IsUnramifiedAtPrime K L p ∧
          FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } },
        Nat.card { Q : Ideal (NumberField.RingOfIntegers L) |
          Q.IsPrime ∧
          Ideal.under (NumberField.RingOfIntegers K) Q = p.asIdeal ∧
          IsArithFrobAt (NumberField.RingOfIntegers K) σ Q } = m :=
by
  open scoped Pointwise in
  let R := NumberField.RingOfIntegers K
  let S := NumberField.RingOfIntegers L
  let G := L ≃ₐ[K] L
  let Zσ : Subgroup G := Subgroup.centralizer ({σ} : Set G)
  let Hσ : Subgroup G := Subgroup.zpowers σ
  let H' : Subgroup Zσ := Hσ.subgroupOf Zσ
  let m : ℕ := Nat.card (Zσ ⧸ H')
  let Cl : Set G := { ρ : G | ∃ τ : G, τ * σ * τ⁻¹ = ρ }
  have h_le : Hσ ≤ Zσ :=
    Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr rfl)
  have hH'_card : Nat.card H' = Nat.card Hσ :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe h_le).toEquiv
  have hZ_card : Nat.card Zσ = m * Nat.card Hσ := by
    rw [← hH'_card]
    exact Subgroup.card_eq_card_quotient_mul_card_subgroup H'
  have h_conj_iff : ∀ τ₁ τ₂ : G, τ₁⁻¹ * τ₂ ∈ Zσ ↔ τ₁ * σ * τ₁⁻¹ = τ₂ * σ * τ₂⁻¹ := by
    intro τ₁ τ₂
    rw [Subgroup.mem_centralizer_singleton_iff]
    constructor
    · intro h
      calc τ₁ * σ * τ₁⁻¹ = τ₁ * ((τ₁⁻¹ * τ₂) * σ) * τ₂⁻¹ := by rw [h]; group
        _ = τ₂ * σ * τ₂⁻¹ := by group
    · intro h
      calc (τ₁⁻¹ * τ₂) * σ = τ₁⁻¹ * (τ₂ * σ * τ₂⁻¹) * τ₂ := by group
        _ = τ₁⁻¹ * (τ₁ * σ * τ₁⁻¹) * τ₂ := by rw [← h]
        _ = σ * (τ₁⁻¹ * τ₂) := by group
  let f₀ : G → Cl := fun τ => ⟨τ * σ * τ⁻¹, ⟨τ, rfl⟩⟩
  let fbar : G ⧸ Zσ → Cl :=
    Quotient.lift f₀ (fun τ₁ τ₂ h =>
      Subtype.ext ((h_conj_iff τ₁ τ₂).mp (QuotientGroup.leftRel_apply.mp h)))
  have hfbar_inj : Function.Injective fbar := by
    intro x y hxy
    refine Quotient.inductionOn₂' x y (fun τ₁ τ₂ h => ?_) hxy
    exact QuotientGroup.eq.mpr ((h_conj_iff τ₁ τ₂).mpr (Subtype.ext_iff.mp h))
  have hfbar_surj : Function.Surjective fbar := by
    rintro ⟨ρ, τ, rfl⟩
    exact ⟨QuotientGroup.mk τ, rfl⟩
  have hCl_card : Nat.card (G ⧸ Zσ) = Nat.card Cl :=
    Nat.card_congr (Equiv.ofBijective fbar ⟨hfbar_inj, hfbar_surj⟩)
  have hG_card : Nat.card G = Nat.card (G ⧸ Zσ) * Nat.card Zσ :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup Zσ
  have hm_eq : m * Nat.card Cl * Nat.card Hσ = Nat.card G := by
    rw [hG_card, hCl_card, hZ_card]
    ring
  refine ⟨m, hm_eq, ?_⟩
  rintro p ⟨hp, hsub⟩
  haveI : p.asIdeal.IsPrime := p.isPrime
  haveI : p.asIdeal.IsMaximal := p.isMaximal
  letI := Ideal.Quotient.field p.asIdeal
  letI : Fintype (R ⧸ p.asIdeal) := Fintype.ofFinite (R ⧸ p.asIdeal)
  haveI : PerfectField (R ⧸ p.asIdeal) := PerfectField.ofFinite
  obtain ⟨Q, hQ_prime, hQ_over⟩ := Ideal.nonempty_primesOver (S := S) p.asIdeal
  haveI : Q.IsPrime := hQ_prime
  haveI : Q.LiesOver p.asIdeal := hQ_over
  haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q p.asIdeal
  obtain ⟨g₁, hg₁⟩ := IsArithFrobAt.exists_of_isInvariant R G Q
  have hg₁_mem : g₁ ∈ FrobeniusClassAt K L p := by
    refine ⟨Q, hQ_prime, hQ_over.over.symm, fun x z hxz => ?_⟩
    have hz : z = g₁ • x := Subtype.ext hxz
    rw [hz, hQ_over.over]
    exact hg₁ x
  obtain ⟨τ₀, hτ₀⟩ := hsub hg₁_mem
  let Q₀ : Ideal S := τ₀⁻¹ • Q
  have hQ₀_prime : Q₀.IsPrime := Ideal.IsPrime.smul τ₀⁻¹
  haveI : Q₀.IsPrime := hQ₀_prime
  haveI : Q₀.LiesOver p.asIdeal := Ideal.LiesOver.smul τ₀⁻¹
  have hQ₀_under : Ideal.under R Q₀ = p.asIdeal := Ideal.LiesOver.over.symm
  have hQ₀_frob : IsArithFrobAt R σ Q₀ := by
    have hconj := hg₁.conj τ₀⁻¹
    have h_eq : τ₀⁻¹ * g₁ * (τ₀⁻¹)⁻¹ = σ := by
      rw [← hτ₀]
      group
    rwa [h_eq] at hconj
  haveI : Q₀.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₀ p.asIdeal
  letI := Ideal.Quotient.field Q₀
  haveI : Algebra.IsSeparable (R ⧸ p.asIdeal) (S ⧸ Q₀) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  have hcomap : Ideal.comap (MulSemiringAction.toAlgHom R S σ) Q₀ = Q₀ :=
    AlgHom.IsArithFrobAt.comap_eq hQ₀_frob
  have hσ_inv_stab : σ⁻¹ ∈ MulAction.stabilizer G Q₀ := by
    rw [MulAction.mem_stabilizer_iff]
    ext x
    rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, inv_inv]
    exact SetLike.ext_iff.mp hcomap x
  have hσ_stab : σ ∈ MulAction.stabilizer G Q₀ := inv_mem_iff.mp hσ_inv_stab
  have h_zpow_le : Hσ ≤ MulAction.stabilizer G Q₀ := Subgroup.zpowers_le.mpr hσ_stab
  let φ := Ideal.Quotient.stabilizerHom Q₀ p.asIdeal G
  have hφ_surj : Function.Surjective φ :=
    Ideal.Quotient.stabilizerHom_surjective G p.asIdeal Q₀
  have h_inertia_card : Nat.card ((Submodule.toAddSubgroup Q₀).inertia G) = 1 := by
    rw [Ideal.card_inertia_eq_ramificationIdxIn p.asIdeal p.ne_bot Q₀,
        Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal Q₀ G]
    exact hp Q₀ hQ₀_prime hQ₀_under
  have h_inertia_bot : (Submodule.toAddSubgroup Q₀).inertia G = ⊥ :=
    Subgroup.card_eq_one.mp h_inertia_card
  have hφ_ker : φ.ker = ⊥ := by
    rw [Ideal.Quotient.ker_stabilizerHom Q₀ p.asIdeal G, h_inertia_bot, Subgroup.bot_subgroupOf]
  have hφ_inj : Function.Injective φ := (MonoidHom.ker_eq_bot_iff φ).mp hφ_ker
  let σ_tilde : MulAction.stabilizer G Q₀ := ⟨σ, hσ_stab⟩
  have hφ_σ : φ σ_tilde = FiniteField.frobeniusAlgEquivOfAlgebraic (R ⧸ p.asIdeal) (S ⧸ Q₀) := by
    ext x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.Quotient.stabilizerHom_apply]
    change Ideal.Quotient.mk Q₀ ((MulSemiringAction.toAlgHom R S σ) y) = _
    rw [AlgHom.IsArithFrobAt.mk_apply hQ₀_frob y, hQ₀_under,
        FiniteField.frobeniusAlgEquivOfAlgebraic_apply, Fintype.card_eq_nat_card]
  have h_card_stab : Nat.card (MulAction.stabilizer G Q₀) = Nat.card Hσ := by
    rw [Nat.card_zpowers σ, ← Subgroup.orderOf_mk σ hσ_stab, ← orderOf_injective φ hφ_inj σ_tilde,
        hφ_σ, FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic (R ⧸ p.asIdeal) (S ⧸ Q₀),
        ← IsGalois.card_aut_eq_finrank (R ⧸ p.asIdeal) (S ⧸ Q₀),
        Nat.card_congr (Equiv.ofBijective φ ⟨hφ_inj, hφ_surj⟩)]
  have hStab : MulAction.stabilizer G Q₀ = Hσ :=
    (Subgroup.eq_of_le_of_card_ge h_zpow_le (le_of_eq h_card_stab)).symm
  have h_smul_prime : ∀ τ : G, (τ • Q₀).IsPrime := fun τ => Ideal.IsPrime.smul τ
  have h_smul_under : ∀ τ : G, Ideal.under R (τ • Q₀) = p.asIdeal := by
    intro τ
    haveI : (τ • Q₀).LiesOver p.asIdeal := Ideal.LiesOver.smul τ
    exact Ideal.LiesOver.over.symm
  have h_smul_frob_iff : ∀ τ : G, IsArithFrobAt R σ (τ • Q₀) ↔ τ ∈ Zσ := by
    intro τ
    constructor
    · intro hfrob
      haveI : (τ • Q₀).IsPrime := h_smul_prime τ
      haveI : (τ • Q₀).LiesOver p.asIdeal := Ideal.LiesOver.smul τ
      haveI : (τ • Q₀).IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal (τ • Q₀) p.asIdeal
      letI := Ideal.Quotient.field (τ • Q₀)
      haveI : Algebra.IsSeparable (R ⧸ p.asIdeal) (S ⧸ (τ • Q₀)) :=
        Algebra.IsAlgebraic.isSeparable_of_perfectField
      have h_in : (τ * σ * τ⁻¹) * σ⁻¹ ∈ (Submodule.toAddSubgroup (τ • Q₀)).inertia G :=
        (hQ₀_frob.conj τ).mul_inv_mem_inertia hfrob
      have h_in_card : Nat.card ((Submodule.toAddSubgroup (τ • Q₀)).inertia G) = 1 := by
        rw [Ideal.card_inertia_eq_ramificationIdxIn p.asIdeal p.ne_bot (τ • Q₀),
            Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal (τ • Q₀) G]
        exact hp (τ • Q₀) (h_smul_prime τ) (h_smul_under τ)
      have h_in_bot : (Submodule.toAddSubgroup (τ • Q₀)).inertia G = ⊥ :=
        Subgroup.card_eq_one.mp h_in_card
      rw [h_in_bot, Subgroup.mem_bot] at h_in
      rw [Subgroup.mem_centralizer_singleton_iff]
      calc τ * σ = ((τ * σ * τ⁻¹) * σ⁻¹) * σ * τ := by group
        _ = 1 * σ * τ := by rw [h_in]
        _ = σ * τ := by group
    · intro hτ
      have hconj := hQ₀_frob.conj τ
      have h_eq : τ * σ * τ⁻¹ = σ := by
        have hcomm := Subgroup.mem_centralizer_singleton_iff.mp hτ
        calc τ * σ * τ⁻¹ = (τ * σ) * τ⁻¹ := by group
          _ = (σ * τ) * τ⁻¹ := by rw [← hcomm]
          _ = σ := by group
      rwa [h_eq] at hconj
  let Qset := { Q : Ideal S | Q.IsPrime ∧ Ideal.under R Q = p.asIdeal ∧ IsArithFrobAt R σ Q }
  let ψ₀ : Zσ → Qset := fun τ =>
    ⟨τ.1 • Q₀, h_smul_prime τ.1, h_smul_under τ.1, (h_smul_frob_iff τ.1).mpr τ.2⟩
  have h_rel_iff : ∀ τ₁ τ₂ : Zσ,
      (QuotientGroup.leftRel H') τ₁ τ₂ ↔ τ₁.1 • Q₀ = τ₂.1 • Q₀ := by
    intro τ₁ τ₂
    rw [QuotientGroup.leftRel_apply, Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_inv,
        ← hStab, MulAction.mem_stabilizer_iff, mul_smul, inv_smul_eq_iff]
    exact eq_comm
  let Ψ : Zσ ⧸ H' → Qset :=
    Quotient.lift ψ₀ (fun τ₁ τ₂ h => Subtype.ext ((h_rel_iff τ₁ τ₂).mp h))
  have hΨ_inj : Function.Injective Ψ := by
    intro x y hxy
    refine Quotient.inductionOn₂' x y (fun τ₁ τ₂ h => ?_) hxy
    exact QuotientGroup.eq.mpr (QuotientGroup.leftRel_apply.mp ((h_rel_iff τ₁ τ₂).mpr (Subtype.ext_iff.mp h)))
  have hΨ_surj : Function.Surjective Ψ := by
    rintro ⟨Q', hQ'_prime, hQ'_under, hQ'_frob⟩
    haveI : Q'.IsPrime := hQ'_prime
    haveI : Q'.LiesOver p.asIdeal := ⟨hQ'_under.symm⟩
    obtain ⟨τ, rfl⟩ := Ideal.exists_smul_eq_of_isGaloisGroup p.asIdeal Q₀ Q' G
    have hτ : τ ∈ Zσ := (h_smul_frob_iff τ).mp hQ'_frob
    exact ⟨QuotientGroup.mk ⟨τ, hτ⟩, rfl⟩
  exact (Nat.card_congr (Equiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩)).symm

theorem chebotarev_deuring_reduction {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
    (σ : L ≃ₐ[K] L)
    (hCyclic : ∀ σ' : L ≃ₐ[IntermediateField.fixedField (Subgroup.zpowers σ)] L,
      (∀ τ : L ≃ₐ[IntermediateField.fixedField (Subgroup.zpowers σ)] L, τ ∈ Subgroup.zpowers σ') →
      HasDirichletDensity
        { q : IsDedekindDomain.HeightOneSpectrum
            (NumberField.RingOfIntegers (IntermediateField.fixedField (Subgroup.zpowers σ))) |
            IsUnramifiedAtPrime (IntermediateField.fixedField (Subgroup.zpowers σ)) L q ∧
            FrobeniusClassAt (IntermediateField.fixedField (Subgroup.zpowers σ)) L q ⊆ {σ'} }
        (1 / (Nat.card (L ≃ₐ[IntermediateField.fixedField (Subgroup.zpowers σ)] L) : ℝ))) :
    HasDirichletDensity
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          IsUnramifiedAtPrime K L p ∧
          FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } }
      ((Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } : ℝ) /
        (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
by
  classical
  let H := Subgroup.zpowers σ
  let F := IntermediateField.fixedField H
  have hF : F.fixingSubgroup = H := IntermediateField.fixingSubgroup_fixedField H
  let e := IntermediateField.fixingSubgroupEquiv F
  have hσ_mem : σ ∈ F.fixingSubgroup := by
    rw [hF]
    exact Subgroup.mem_zpowers σ
  let σ₀ : F.fixingSubgroup := ⟨σ, hσ_mem⟩
  let σ' : L ≃ₐ[F] L := e σ₀
  have hσ'_pt : ∀ x : L, σ' x = σ x := fun _ => rfl
  have hσ'_gen : ∀ τ : L ≃ₐ[F] L, τ ∈ Subgroup.zpowers σ' := by
    intro τ
    have hτ : (e.symm τ : L ≃ₐ[K] L) ∈ H := by
      rw [← hF]
      exact (e.symm τ).2
    rcases Subgroup.mem_zpowers_iff.mp hτ with ⟨k, hk⟩
    rw [Subgroup.mem_zpowers_iff]
    refine ⟨k, ?_⟩
    have hk' : σ₀ ^ k = e.symm τ := by
      ext x
      exact DFunLike.congr_fun hk x
    calc
      σ' ^ k = e (σ₀ ^ k) := (map_zpow e σ₀ k).symm
      _ = e (e.symm τ) := by rw [hk']
      _ = τ := e.apply_symm_apply τ
  have hσ'_card : Nat.card (L ≃ₐ[F] L) = Nat.card H := by
    rw [Nat.card_congr e.symm.toEquiv, hF]
  have hT := hCyclic σ' hσ'_gen
  have hT₀ := hasDirichletDensity_degree_one_unramified_restriction (K := K) (F := F) (L := L)
    { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
        IsUnramifiedAtPrime F L q ∧ FrobeniusClassAt F L q ⊆ {σ'} }
    (1 / (Nat.card (L ≃ₐ[F] L) : ℝ)) hT
  obtain ⟨hOver, hBij⟩ := deuring_degree_one_fiber_eq_card_arithFrobAt σ σ' hσ'_pt
  obtain ⟨m, hm_eq, hm_card⟩ := card_primesOver_with_arithFrobAt σ
  let S : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        IsUnramifiedAtPrime K L p ∧
        FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } }
  let T₀ : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
    { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
        (IsUnramifiedAtPrime F L q ∧ FrobeniusClassAt F L q ⊆ {σ'}) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p.asIdeal ∧
          IsUnramifiedAtPrime K L p ∧
          Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) =
            Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) }
  have hFiber : ∀ p ∈ S,
      Nat.card { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
        q ∈ T₀ ∧ Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p.asIdeal } = m :=
    fun p hp => (hBij p hp).trans (hm_card p hp)
  have hG_pos : 0 < Nat.card (L ≃ₐ[K] L) := Nat.card_pos
  have h_prod_ne : m * Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } *
      Nat.card H ≠ 0 := by
    rw [hm_eq]
    exact ne_of_gt hG_pos
  have hm_ne : m ≠ 0 := left_ne_zero_of_mul (left_ne_zero_of_mul h_prod_ne)
  have hCl_ne : (Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } : ℝ) ≠ 0 := by
    exact_mod_cast right_ne_zero_of_mul (left_ne_zero_of_mul h_prod_ne)
  have hH_ne : (Nat.card H : ℝ) ≠ 0 := by
    exact_mod_cast right_ne_zero_of_mul h_prod_ne
  have hm_eq_real : (m : ℝ) * (Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } : ℝ) *
      (Nat.card H : ℝ) = (Nat.card (L ≃ₐ[K] L) : ℝ) := by
    exact_mod_cast hm_eq
  let d : ℝ := (Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } : ℝ) /
      (Nat.card (L ≃ₐ[K] L) : ℝ)
  have hd_eq : (1 / (Nat.card (L ≃ₐ[F] L) : ℝ)) = (m : ℝ) * d := by
    change (1 / (Nat.card (L ≃ₐ[F] L) : ℝ)) =
      (m : ℝ) * ((Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } : ℝ) /
        (Nat.card (L ≃ₐ[K] L) : ℝ))
    rw [hσ'_card, ← hm_eq_real]
    have hm_ne_real : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hm_ne
    field_simp [hH_ne, hCl_ne, hm_ne_real]
  rw [hd_eq] at hT₀
  let proj : T₀ → S := fun q =>
    ⟨(hOver q.1 q.2).choose, (hOver q.1 q.2).choose_spec.1⟩
  have hproj_under : ∀ q : T₀,
      Ideal.under (NumberField.RingOfIntegers K) q.1.asIdeal = (proj q).1.asIdeal :=
    fun q => (hOver q.1 q.2).choose_spec.2.1
  have hproj_card : ∀ q : T₀,
      Nat.card (NumberField.RingOfIntegers F ⧸ q.1.asIdeal) =
        Nat.card (NumberField.RingOfIntegers K ⧸ (proj q).1.asIdeal) :=
    fun q => (hOver q.1 q.2).choose_spec.2.2
  have hproj_iff : ∀ (q : T₀) (p : S),
      proj q = p ↔ Ideal.under (NumberField.RingOfIntegers K) q.1.asIdeal = p.1.asIdeal := by
    intro q p
    constructor
    · intro h
      rw [← h]
      exact hproj_under q
    · intro h
      ext1
      apply IsDedekindDomain.HeightOneSpectrum.ext
      rw [← h, hproj_under q]
  have h_quot : ∀ s : ℝ, dirichletQuot T₀ s = (m : ENNReal) * dirichletQuot S s := by
    intro s
    unfold dirichletQuot
    have h_sum :
        (∑' q : T₀, ENNReal.ofReal
          ((Nat.card (NumberField.RingOfIntegers F ⧸ q.1.asIdeal) : ℝ) ^ (-s))) =
        (m : ENNReal) * (∑' p : S, ENNReal.ofReal
          ((Nat.card (NumberField.RingOfIntegers K ⧸ p.1.asIdeal) : ℝ) ^ (-s))) := by
      rw [← (Equiv.sigmaFiberEquiv proj).tsum_eq]
      rw [ENNReal.tsum_sigma']
      rw [← ENNReal.tsum_mul_left]
      congr 1
      ext p
      have h_inner : ∀ x : { q : T₀ // proj q = p },
          ENNReal.ofReal ((Nat.card (NumberField.RingOfIntegers F ⧸
            ((Equiv.sigmaFiberEquiv proj ⟨p, x⟩).1.asIdeal)) : ℝ) ^ (-s)) =
          ENNReal.ofReal ((Nat.card (NumberField.RingOfIntegers K ⧸ p.1.asIdeal) : ℝ) ^ (-s)) := by
        intro x
        change ENNReal.ofReal ((Nat.card (NumberField.RingOfIntegers F ⧸ x.1.1.asIdeal) : ℝ) ^ (-s)) = _
        rw [hproj_card x.1, x.2]
      simp_rw [h_inner]
      rw [ENNReal.tsum_const]
      congr 1
      have e_fib : { q : T₀ // proj q = p } ≃
          { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            q ∈ T₀ ∧ Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p.1.asIdeal } :=
        { toFun := fun x => ⟨x.1.1, x.1.2, (hproj_iff x.1 p).mp x.2⟩
          invFun := fun y => ⟨⟨y.1, y.2.1⟩, (hproj_iff ⟨y.1, y.2.1⟩ p).mpr y.2.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl }
      have hcard_p : Nat.card { q : T₀ // proj q = p } = m := by
        rw [Nat.card_congr e_fib]
        exact hFiber p.1 p.2
      haveI : Finite { q : T₀ // proj q = p } :=
        Nat.finite_of_card_ne_zero (by rw [hcard_p]; exact hm_ne)
      rw [ENat.card_eq_coe_natCard, hcard_p]
      rfl
    rw [h_sum, mul_div_assoc]
  change HasDirichletDensity T₀ ((m : ℝ) * d) at hT₀
  change HasDirichletDensity S d
  unfold HasDirichletDensity at hT₀ ⊢
  have hm_enn_ne_zero : (m : ENNReal) ≠ 0 := Nat.cast_ne_zero.mpr hm_ne
  have hm_enn_ne_top : (m : ENNReal) ≠ ⊤ := ENNReal.natCast_ne_top m
  have h_inv_top : (m : ENNReal)⁻¹ ≠ ⊤ := ENNReal.inv_ne_top.mpr hm_enn_ne_zero
  have h_tendsto := ENNReal.Tendsto.const_mul hT₀ (Or.inr h_inv_top)
  have h_fun : (fun s => (m : ENNReal)⁻¹ * dirichletQuot T₀ s) = dirichletQuot S := by
    ext s
    rw [h_quot s, ← mul_assoc, ENNReal.inv_mul_cancel hm_enn_ne_zero hm_enn_ne_top, one_mul]
  have h_lim : (m : ENNReal)⁻¹ * ENNReal.ofReal ((m : ℝ) * d) = ENNReal.ofReal d := by
    rw [ENNReal.ofReal_mul (Nat.cast_nonneg m), ENNReal.ofReal_natCast,
        ← mul_assoc, ENNReal.inv_mul_cancel hm_enn_ne_zero hm_enn_ne_top, one_mul]
  rw [h_fun, h_lim] at h_tendsto
  exact h_tendsto

theorem hasDirichletDensity_of_tendsto_real {F : Type u} [Field F] [NumberField F]
    (S : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)))
    (d : ℝ)
    (h : Filter.Tendsto
      (fun s : ℝ =>
        (∑' q : S, ((Nat.card (NumberField.RingOfIntegers F ⧸
          (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds d)) :
    HasDirichletDensity S d :=
by
  classical
  unfold HasDirichletDensity
  have h_ofReal : Filter.Tendsto
      (fun s : ℝ => ENNReal.ofReal
        ((∑' q : S, ((Nat.card (NumberField.RingOfIntegers F ⧸
          (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) /
        Real.log (1 / (s - 1))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (ENNReal.ofReal d)) :=
    ENNReal.tendsto_ofReal h
  refine h_ofReal.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)] with s hs
  have hs1 : 1 < s := hs.1
  have hs2 : s < 2 := hs.2
  have hs_sub_pos : 0 < s - 1 := by linarith
  have hs_sub_lt_one : s - 1 < 1 := by linarith
  have h_one_lt_div : 1 < 1 / (s - 1) := one_lt_one_div hs_sub_pos hs_sub_lt_one
  have h_log_pos : 0 < Real.log (1 / (s - 1)) := Real.log_pos h_one_lt_div
  have hsum_univ : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) := by
    let R := NumberField.RingOfIntegers F
    let deg := Module.finrank ℚ F
    have hdeg_pos : 0 < deg := Module.finrank_pos
    have hp_max : ∀ q : IsDedekindDomain.HeightOneSpectrum R, (Ideal.under ℤ q.asIdeal).IsMaximal := by
      intro q
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      exact Ideal.IsMaximal.under ℤ q.asIdeal
    have hp_ne_bot : ∀ q : IsDedekindDomain.HeightOneSpectrum R, Ideal.under ℤ q.asIdeal ≠ ⊥ :=
      fun q => Ideal.under_ne_bot ℤ q.ne_bot
    let pset (P : Ideal ℤ) : Finset (Ideal R) := primesOverFinset P R
    have hq_mem : ∀ q : IsDedekindDomain.HeightOneSpectrum R,
        q.asIdeal ∈ pset (Ideal.under ℤ q.asIdeal) := by
      intro q
      dsimp [pset]
      letI := hp_max q
      rw [mem_primesOverFinset_iff (hp_ne_bot q) R]
      exact ⟨q.isPrime, ⟨rfl⟩⟩
    have hpset_card : ∀ q : IsDedekindDomain.HeightOneSpectrum R,
        (pset (Ideal.under ℤ q.asIdeal)).card ≤ deg := by
      intro q
      dsimp [pset]
      letI := hp_max q
      exact Ideal.card_primesOverFinset_le_finrank R ℚ F (hp_ne_bot q)
    let idx (P : Ideal ℤ) (Q : Ideal R) : ℕ :=
      if hmem : Q ∈ pset P then ((pset P).equivFin ⟨Q, hmem⟩ : ℕ) else 0
    have hidx_lt : ∀ q : IsDedekindDomain.HeightOneSpectrum R,
        idx (Ideal.under ℤ q.asIdeal) q.asIdeal < deg := by
      intro q
      dsimp [idx]
      rw [dif_pos (hq_mem q)]
      exact lt_of_lt_of_le (((pset (Ideal.under ℤ q.asIdeal)).equivFin ⟨q.asIdeal, hq_mem q⟩).isLt)
        (hpset_card q)
    let k : IsDedekindDomain.HeightOneSpectrum R → ℕ := fun q =>
      deg * Ideal.absNorm (Ideal.under ℤ q.asIdeal) + idx (Ideal.under ℤ q.asIdeal) q.asIdeal
    have hk_inj : Function.Injective k := by
      intro q₁ q₂ hkeq
      have hlt1 : idx (Ideal.under ℤ q₁.asIdeal) q₁.asIdeal < deg := hidx_lt q₁
      have hlt2 : idx (Ideal.under ℤ q₂.asIdeal) q₂.asIdeal < deg := hidx_lt q₂
      have hkeq' : deg * Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) + idx (Ideal.under ℤ q₁.asIdeal) q₁.asIdeal =
          deg * Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) + idx (Ideal.under ℤ q₂.asIdeal) q₂.asIdeal := hkeq
      have hm : Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) = Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) := by
        nlinarith
      have hidx : idx (Ideal.under ℤ q₁.asIdeal) q₁.asIdeal = idx (Ideal.under ℤ q₂.asIdeal) q₂.asIdeal := by
        nlinarith
      have hP : Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal := by
        rw [← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₁.asIdeal),
            ← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₂.asIdeal), hm]
      have h1 : q₁.asIdeal ∈ pset (Ideal.under ℤ q₂.asIdeal) := by
        rw [← hP]
        exact hq_mem q₁
      have h2 : q₂.asIdeal ∈ pset (Ideal.under ℤ q₂.asIdeal) := hq_mem q₂
      rw [hP] at hidx
      dsimp [idx] at hidx
      rw [dif_pos h1, dif_pos h2] at hidx
      have hfin := Fin.ext hidx
      have hsub := (pset (Ideal.under ℤ q₂.asIdeal)).equivFin.injective hfin
      have hQ : q₁.asIdeal = q₂.asIdeal := congrArg Subtype.val hsub
      exact IsDedekindDomain.HeightOneSpectrum.ext hQ
    have h_dom : ∀ q : IsDedekindDomain.HeightOneSpectrum R,
        ((Nat.card (R ⧸ q.asIdeal) : ℝ) ^ (-s)) ≤ ((2 * deg + 1 : ℝ) ^ s) * ((k q : ℝ) ^ (-s)) := by
      intro q
      have hN_eq : Ideal.absNorm q.asIdeal = Nat.card (R ⧸ q.asIdeal) := by
        rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
      have hN_gt1 : 1 < Nat.card (R ⧸ q.asIdeal) := by
        rw [← hN_eq]
        exact NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
      have hN_pos : 0 < Nat.card (R ⧸ q.asIdeal) := by omega
      have hm_dvd : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ∣ Nat.card (R ⧸ q.asIdeal) := by
        rw [← hN_eq]
        exact Int.absNorm_under_dvd_absNorm q.asIdeal
      have hm_pos : 0 < Ideal.absNorm (Ideal.under ℤ q.asIdeal) :=
        Nat.pos_of_dvd_of_pos hm_dvd hN_pos
      have hm_le : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ≤ Nat.card (R ⧸ q.asIdeal) :=
        Nat.le_of_dvd hN_pos hm_dvd
      have hidx_q : idx (Ideal.under ℤ q.asIdeal) q.asIdeal < deg := hidx_lt q
      have hk_pos_nat : 0 < k q := by
        dsimp [k]
        nlinarith
      have hk_le_nat : k q ≤ (2 * deg + 1) * Nat.card (R ⧸ q.asIdeal) := by
        dsimp [k]
        nlinarith
      have hk_pos : (0 : ℝ) < (k q : ℝ) := Nat.cast_pos.mpr hk_pos_nat
      have hk_le : (k q : ℝ) ≤ (2 * deg + 1 : ℝ) * (Nat.card (R ⧸ q.asIdeal) : ℝ) := by
        exact_mod_cast hk_le_nat
      have hd1_pos : (0 : ℝ) < (2 * deg + 1 : ℝ) := by positivity
      have hd1_nonneg : (0 : ℝ) ≤ (2 * deg + 1 : ℝ) := by positivity
      have hN_nonneg : (0 : ℝ) ≤ (Nat.card (R ⧸ q.asIdeal) : ℝ) := by positivity
      have hrpow_le : (((2 * deg + 1 : ℝ) * (Nat.card (R ⧸ q.asIdeal) : ℝ)) ^ (-s)) ≤ (k q : ℝ) ^ (-s) :=
        Real.rpow_le_rpow_of_nonpos hk_pos hk_le (by linarith)
      rw [Real.mul_rpow hd1_nonneg hN_nonneg] at hrpow_le
      have hmul := mul_le_mul_of_nonneg_left hrpow_le (Real.rpow_nonneg hd1_nonneg s)
      rw [← mul_assoc, ← Real.rpow_add hd1_pos, add_neg_cancel, Real.rpow_zero, one_mul] at hmul
      exact hmul
    have h_pseries : Summable (fun n : ℕ => (n : ℝ) ^ (-s)) :=
      Real.summable_nat_rpow.mpr (by linarith)
    have h_comp : Summable (fun q : IsDedekindDomain.HeightOneSpectrum R =>
        ((2 * deg + 1 : ℝ) ^ s) * ((k q : ℝ) ^ (-s))) :=
      (h_pseries.mul_left ((2 * deg + 1 : ℝ) ^ s)).comp_injective hk_inj
    exact Summable.of_nonneg_of_le (fun q => Real.rpow_nonneg (Nat.cast_nonneg _) (-s)) h_dom h_comp
  have hsum_S : Summable (fun q : S =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸
        (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) :=
    hsum_univ.subtype S
  dsimp only [dirichletQuot]
  rw [ENNReal.ofReal_div_of_pos h_log_pos,
      ENNReal.ofReal_tsum_of_nonneg (fun q : S => Real.rpow_nonneg (Nat.cast_nonneg _) (-s)) hsum_S]

theorem dedekindZeta_re_eq_tsum_ideal_absNorm_rpow {F : Type u} [Field F] [NumberField F] {s : ℝ} (hs : 1 < s) :
    Summable (fun I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } =>
      ((Ideal.absNorm I.val : ℝ) ^ (-s))) ∧
    (NumberField.dedekindZeta F (s : ℂ)).re =
      ∑' I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ },
        ((Ideal.absNorm I.val : ℝ) ^ (-s)) :=
by
  have hSum : ∀ n : ℕ,
      (∑ k ∈ Finset.Icc 1 n,
        Nat.card { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = k }) =
      Nat.card { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
        Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n } := by
    intro n
    let e : (k : Finset.Icc 1 n) × { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = k.1 } ≃
        { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
          Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) ≤ n } :=
      { toFun := fun ⟨⟨k, hk⟩, ⟨I, hI⟩⟩ =>
          ⟨⟨I, Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mp (by
              dsimp at hI
              have hk1 : 1 ≤ k := (Finset.mem_Icc.mp hk).1
              omega)⟩,
            by
              dsimp at hI ⊢
              rw [hI]
              exact (Finset.mem_Icc.mp hk).2⟩
        invFun := fun ⟨⟨I, hI_nzd⟩, hI_le⟩ =>
          ⟨⟨Ideal.absNorm I, Finset.mem_Icc.mpr ⟨by
              have hne : Ideal.absNorm I ≠ 0 :=
                Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors.mpr hI_nzd
              omega, hI_le⟩⟩,
            ⟨I, rfl⟩⟩
        left_inv := fun ⟨⟨k, hk⟩, ⟨I, hI⟩⟩ => by
          dsimp at hI ⊢
          subst hI
          rfl
        right_inv := fun ⟨⟨I, hI_nzd⟩, hI_le⟩ => rfl }
    haveI : ∀ a : Finset.Icc 1 n,
        Finite { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = a.1 } :=
      fun a => Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_eq a.1)
    rw [Nat.card_congr e.symm, Nat.card_sigma, Finset.univ_eq_attach]
    exact (Finset.sum_attach (Finset.Icc 1 n)
      (fun k => Nat.card { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = k })).symm
  let c : ℕ → ℕ := fun n =>
    Nat.card { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n }
  have hLSum : LSeriesSummable (fun n : ℕ => (c n : ℂ)) (s : ℂ) := by
    have hTendsto := (NumberField.Ideal.tendsto_norm_le_div_atTop₀ F).comp tendsto_natCast_atTop_atTop
    have hEqSum : (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, (c k : ℝ)) =
        (fun n : ℕ => (Nat.card { I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers F)) //
          (Ideal.absNorm (I : Ideal (NumberField.RingOfIntegers F)) : ℝ) ≤ (n : ℝ) } : ℝ)) := by
      ext n
      rw [← Nat.cast_sum, hSum n]
      simp only [Nat.cast_le]
    have hBigO : (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, (c k : ℝ)) =O[Filter.atTop]
        (fun n : ℕ => (n : ℝ) ^ (1 : ℝ)) := by
      have hBigO1 : (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, (c k : ℝ)) =O[Filter.atTop]
          (fun n : ℕ => (n : ℝ)) := by
        refine Asymptotics.isBigO_of_div_tendsto_nhds ?_ _
          (hTendsto.congr (fun n => by
            dsimp
            rw [← congr_fun hEqSum n]))
        refine Filter.Eventually.of_forall (fun n hn => ?_)
        have hn0 : n = 0 := Nat.cast_eq_zero.mp hn
        subst hn0
        simp
      simpa only [Real.rpow_one] using hBigO1
    have hSummable := LSeriesSummable_of_sum_norm_bigO_and_nonneg (s := (s : ℂ)) hBigO
      (fun n => Nat.cast_nonneg (c n)) (by norm_num : (0 : ℝ) ≤ 1)
      (by simpa [Complex.ofReal_re] using hs)
    simpa only [Complex.ofReal_natCast] using hSummable
  have hTermRe : ∀ n : ℕ,
      (LSeries.term (fun k : ℕ => (c k : ℂ)) (s : ℂ) n).re = (c n : ℝ) * ((n : ℝ) ^ (-s)) := by
    intro n
    rcases eq_or_ne n 0 with rfl | hn
    · rw [LSeries.term_zero, Complex.zero_re, Nat.cast_zero, Real.zero_rpow (by linarith), mul_zero]
    · rw [LSeries.term_of_ne_zero hn]
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_cpow : ((n : ℂ) ^ (s : ℂ)) = (((n : ℝ) ^ s : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg s]
      rw [h_cpow, div_eq_mul_inv, ← Complex.ofReal_inv, ← Real.rpow_neg hn_nonneg,
        ← Complex.ofReal_natCast, ← Complex.ofReal_mul, Complex.ofReal_re]
  have hNatSum : Summable (fun n : ℕ => (c n : ℝ) * ((n : ℝ) ^ (-s))) := by
    have hReSum := Complex.reCLM.summable hLSum
    exact hReSum.congr (fun n => hTermRe n)
  have hZetaEq : (NumberField.dedekindZeta F (s : ℂ)).re =
      ∑' n : ℕ, (c n : ℝ) * ((n : ℝ) ^ (-s)) := by
    rw [NumberField.dedekindZeta.eq_1 F (s : ℂ), LSeries, Complex.re_tsum hLSum]
    exact tsum_congr hTermRe
  let g : Ideal (NumberField.RingOfIntegers F) → ℝ :=
    fun I => ((Ideal.absNorm I : ℝ) ^ (-s))
  let e_fib : (n : ℕ) × { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } ≃
      Ideal (NumberField.RingOfIntegers F) :=
    Equiv.sigmaFiberEquiv Ideal.absNorm
  have hFibFin : ∀ n : ℕ,
      Finite { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } :=
    fun n => Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_eq n)
  have hFibTsum : ∀ n : ℕ,
      (∑' I : { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n },
        g (e_fib ⟨n, I⟩)) = (c n : ℝ) * ((n : ℝ) ^ (-s)) := by
    intro n
    haveI := hFibFin n
    have hConst : (fun I : { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } =>
        g (e_fib ⟨n, I⟩)) = (fun _ => ((n : ℝ) ^ (-s))) := by
      ext I
      dsimp [g, e_fib, Equiv.sigmaFiberEquiv]
      rw [I.2]
    rw [hConst, tsum_const, nsmul_eq_mul]
  have hSigmaSum : Summable (fun p : (n : ℕ) × { I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n } =>
      g (e_fib p)) := by
    refine (summable_sigma_of_nonneg (fun p => Real.rpow_nonneg (Nat.cast_nonneg _) _)).mpr ⟨?_, ?_⟩
    · intro n
      haveI := hFibFin n
      exact Summable.of_finite
    · exact hNatSum.congr (fun n => (hFibTsum n).symm)
  have hIdealAllSum : Summable g := (Equiv.summable_iff e_fib).mp hSigmaSum
  have hIdealAllEq : (∑' I : Ideal (NumberField.RingOfIntegers F), g I) =
      ∑' n : ℕ, (c n : ℝ) * ((n : ℝ) ^ (-s)) := by
    rw [← Equiv.tsum_eq e_fib g, hSigmaSum.tsum_sigma]
    exact tsum_congr hFibTsum
  have hSubSum : Summable (fun I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } =>
      ((Ideal.absNorm I.val : ℝ) ^ (-s))) :=
    hIdealAllSum.subtype { I : Ideal (NumberField.RingOfIntegers F) | I ≠ ⊥ }
  have hSupp : Function.support g ⊆ { I : Ideal (NumberField.RingOfIntegers F) | I ≠ ⊥ } := by
    rw [Function.support_subset_iff']
    intro I hI
    have hI_bot : I = ⊥ := not_not.mp hI
    subst hI_bot
    dsimp [g]
    rw [Ideal.absNorm_bot, Nat.cast_zero, Real.zero_rpow (by linarith)]
  have hSubEq : (∑' I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ },
      ((Ideal.absNorm I.val : ℝ) ^ (-s))) =
      ∑' I : Ideal (NumberField.RingOfIntegers F), g I :=
    tsum_subtype_eq_of_support_subset hSupp
  exact ⟨hSubSum, hZetaEq.trans (hIdealAllEq.symm.trans hSubEq.symm)⟩

theorem tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod {F : Type u} [Field F] [NumberField F] {s : ℝ}
    (hIdeal : Summable (fun I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } =>
      ((Ideal.absNorm I.val : ℝ) ^ (-s)))) :
    Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) ∧
    Summable (fun f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ =>
      f.prod (fun q k => (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ k))) ∧
    (∑' I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ },
      ((Ideal.absNorm I.val : ℝ) ^ (-s))) =
    (∑' f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      f.prod (fun q k => (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ k))) :=
by
  classical
  have hAbsNorm : ∀ I : Ideal (NumberField.RingOfIntegers F),
      Ideal.absNorm I = Nat.card (NumberField.RingOfIntegers F ⧸ I) := by
    intro I
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  have hPrime : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) := by
    let ι : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
        { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } :=
      fun q => ⟨q.asIdeal, q.ne_bot⟩
    have hι : Function.Injective ι := by
      intro q₁ q₂ h
      exact IsDedekindDomain.HeightOneSpectrum.ext (Subtype.mk.injEq _ _ _ _ ▸ h)
    refine (hIdeal.comp_injective hι).congr ?_
    intro q
    simp only [Function.comp_apply, ι, hAbsNorm]
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal :
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
          Ideal (NumberField.RingOfIntegers F)) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  have h_toMultiset_prod :
      ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod =
          f.prod (fun q k => q.asIdeal ^ k) := by
    intro f
    rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
      Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
  have h_prod_ne_bot :
      ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        f.prod (fun q k => q.asIdeal ^ k) ≠ ⊥ := by
    intro f
    rw [← h_toMultiset_prod f, ← Submodule.zero_eq_bot]
    apply Multiset.prod_ne_zero
    intro h0
    rw [Multiset.mem_map] at h0
    rcases h0 with ⟨q, _, hq0⟩
    rw [Submodule.zero_eq_bot] at hq0
    exact q.ne_bot hq0
  have h_normFactors :
      ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        UniqueFactorizationMonoid.normalizedFactors (f.prod (fun q k => q.asIdeal ^ k)) =
          Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f) := by
    intro f
    rw [← h_toMultiset_prod f]
    apply UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
    intro p hp
    rw [Multiset.mem_map] at hp
    rcases hp with ⟨q, _, rfl⟩
    exact q.prime
  let Φ : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) →
      { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } :=
    fun f => ⟨f.prod (fun q k => q.asIdeal ^ k), h_prod_ne_bot f⟩
  have hΦ_inj : Function.Injective Φ := by
    intro f₁ f₂ h
    have hval : f₁.prod (fun q k => q.asIdeal ^ k) = f₂.prod (fun q k => q.asIdeal ^ k) :=
      congrArg Subtype.val h
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hval
    rw [h_normFactors f₁, h_normFactors f₂] at hnf
    have htm : Finsupp.toMultiset f₁ = Finsupp.toMultiset f₂ :=
      Multiset.map_injective hasIdeal_inj hnf
    have htf := congrArg Multiset.toFinsupp htm
    simpa only [Finsupp.toMultiset_toFinsupp] using htf
  have hΦ_surj : Function.Surjective Φ := by
    rintro ⟨I, hI⟩
    let N := UniqueFactorizationMonoid.normalizedFactors I
    let m : Multiset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
      Multiset.pmap
        (fun (p : Ideal (NumberField.RingOfIntegers F)) (hp : Prime p) =>
          IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
        N
        (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
    let f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ :=
      Multiset.toFinsupp m
    refine ⟨f, Subtype.ext ?_⟩
    change f.prod (fun q k => q.asIdeal ^ k) = I
    rw [← h_toMultiset_prod f]
    have hfm : Finsupp.toMultiset f = m := Multiset.toFinsupp_toMultiset m
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m = N := by
      dsimp [m]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact prod_normalizedFactors_eq_self hI
  let e : (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ) ≃
      { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ } :=
    Equiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩
  have h_term : ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
      ((Ideal.absNorm (e f).val : ℝ) ^ (-s)) =
        f.prod (fun q k => (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ k)) := by
    intro f
    have hef : (e f).val = f.prod (fun q k => q.asIdeal ^ k) := rfl
    rw [hef]
    unfold Finsupp.prod
    rw [map_prod]
    simp only [map_pow]
    simp only [hAbsNorm]
    rw [Nat.cast_prod]
    simp only [Nat.cast_pow]
    rw [← Real.finset_prod_rpow _ _ (fun q _ => by positivity)]
    refine Finset.prod_congr rfl (fun q _ => ?_)
    rw [← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg _),
      mul_comm (f q : ℝ) (-s), Real.rpow_mul (Nat.cast_nonneg _), Real.rpow_natCast]
  have hProd : Summable (fun f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ =>
      f.prod (fun q k => (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ k))) := by
    refine ((Equiv.summable_iff e).mpr hIdeal).congr ?_
    intro f
    exact h_term f
  have hEq :
      (∑' I : { I : Ideal (NumberField.RingOfIntegers F) // I ≠ ⊥ },
        ((Ideal.absNorm I.val : ℝ) ^ (-s))) =
      (∑' f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        f.prod (fun q k => (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ k))) := by
    rw [← Equiv.tsum_eq e]
    exact tsum_congr h_term
  exact ⟨hPrime, hProd, hEq⟩

theorem tsum_finsupp_prod_pow_eq_rexp_tsum_neg_log_one_sub {ι : Type u} (x : ι → ℝ)
    (hx_nonneg : ∀ i : ι, 0 ≤ x i)
    (hx_lt_one : ∀ i : ι, x i < 1)
    (hSumLog : Summable (fun i : ι => -Real.log (1 - x i)))
    (hSumProd : Summable (fun f : ι →₀ ℕ => f.prod (fun i k => (x i) ^ k))) :
    (∑' f : ι →₀ ℕ, f.prod (fun i k => (x i) ^ k)) =
      Real.exp (∑' i : ι, -Real.log (1 - x i)) :=
by
  classical
  have hG_nonneg : ∀ f : ι →₀ ℕ, 0 ≤ f.prod (fun i k => (x i) ^ k) := by
    intro f
    exact Finset.prod_nonneg (fun i _ => pow_nonneg (hx_nonneg i) _)
  have hL_nonneg : ∀ i : ι, 0 ≤ -Real.log (1 - x i) := by
    intro i
    exact neg_nonneg.mpr (Real.log_nonpos (le_of_lt (sub_pos.mpr (hx_lt_one i))) (sub_le_self 1 (hx_nonneg i)))
  have hInsert : ∀ (a : ι) (S : Finset ι), a ∉ S →
      (∑' f : { f : ι →₀ ℕ // f.support ⊆ insert a S }, f.val.prod (fun i k => (x i) ^ k)) =
        (1 - x a)⁻¹ *
          (∑' g : { g : ι →₀ ℕ // g.support ⊆ S }, g.val.prod (fun i k => (x i) ^ k)) := by
    intro a S ha
    have h_equiv : ∃ e : ℕ × { g : ι →₀ ℕ // g.support ⊆ S } ≃ { f : ι →₀ ℕ // f.support ⊆ insert a S },
        ∀ p : ℕ × { g : ι →₀ ℕ // g.support ⊆ S }, (e p).val = Finsupp.single a p.1 + p.2.val := by
      refine ⟨{
        toFun := fun p =>
          ⟨Finsupp.single a p.1 + p.2.val, by
            intro i hi
            rcases Finset.mem_union.mp (Finsupp.support_add hi) with hi1 | hi2
            · exact Finset.mem_insert.mpr (Or.inl (Finset.mem_singleton.mp (Finsupp.support_single_subset hi1)))
            · exact Finset.mem_insert_of_mem (p.2.property hi2)⟩
        invFun := fun f =>
          (f.val a, ⟨Finsupp.erase a f.val, by
            rw [Finsupp.support_erase]
            exact Finset.subset_insert_iff.mp f.property⟩)
        left_inv := by
          rintro ⟨k, g⟩
          have hga : g.val a = 0 := by
            by_contra hne
            exact ha (g.property (Finsupp.mem_support_iff.mpr hne))
          refine Prod.ext ?_ (Subtype.ext (Finsupp.ext (fun i => ?_)))
          · simp [hga]
          · by_cases hia : i = a
            · subst hia
              simp [hga]
            · simp [Finsupp.erase_ne hia, Finsupp.single_eq_of_ne (Ne.symm hia)]
        right_inv := by
          intro f
          ext1
          exact Finsupp.single_add_erase a f.val
      }, fun _ => rfl⟩
    rcases h_equiv with ⟨e, he⟩
    rw [← Equiv.tsum_eq e]
    have h_factor : ∀ p : ℕ × { g : ι →₀ ℕ // g.support ⊆ S },
        (e p).val.prod (fun i k => (x i) ^ k) =
          (x a) ^ p.1 * p.2.val.prod (fun i k => (x i) ^ k) := by
      rintro ⟨k, g⟩
      rw [he]
      rw [Finsupp.prod_add_index' (fun i => pow_zero (x i)) (fun i b₁ b₂ => pow_add (x i) b₁ b₂),
        Finsupp.prod_single_index (h := fun i m => (x i) ^ m) (pow_zero (x a))]
    simp_rw [h_factor]
    have hSumGeom : Summable (fun k : ℕ => (x a) ^ k) :=
      summable_geometric_of_lt_one (hx_nonneg a) (hx_lt_one a)
    have hSumSub : Summable (fun g : { g : ι →₀ ℕ // g.support ⊆ S } => g.val.prod (fun i k => (x i) ^ k)) :=
      hSumProd.subtype { g : ι →₀ ℕ | g.support ⊆ S }
    have hSumMul : Summable (fun p : ℕ × { g : ι →₀ ℕ // g.support ⊆ S } =>
        (x a) ^ p.1 * p.2.val.prod (fun i k => (x i) ^ k)) :=
      Summable.mul_of_nonneg hSumGeom hSumSub (fun k => pow_nonneg (hx_nonneg a) k) (fun g => hG_nonneg g.val)
    rw [← hSumGeom.tsum_mul_tsum hSumSub hSumMul,
      tsum_geometric_of_lt_one (hx_nonneg a) (hx_lt_one a)]
  have hFin : ∀ S : Finset ι,
      (∑' f : { f : ι →₀ ℕ // f.support ⊆ S }, f.val.prod (fun i k => (x i) ^ k)) =
        Real.exp (∑ i ∈ S, -Real.log (1 - x i)) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      let z₀ : { f : ι →₀ ℕ // f.support ⊆ ∅ } := ⟨0, by simp⟩
      rw [tsum_eq_single z₀]
      · simp [z₀, Finsupp.prod_zero_index]
      · intro f hf
        exfalso
        apply hf
        ext1
        exact Finsupp.support_eq_empty.mp (Finset.subset_empty.mp f.property)
    | @insert a S ha ih =>
      rw [hInsert a S ha, ih, Finset.sum_insert ha, Real.exp_add, Real.exp_neg,
        Real.exp_log (sub_pos.mpr (hx_lt_one a))]
  apply le_antisymm
  · refine hSumProd.tsum_le_of_sum_le (fun T => ?_)
    let S_T : Finset ι := T.biUnion Finsupp.support
    have hT_sub : ∀ f ∈ T, f.support ⊆ S_T :=
      fun f hf => Finset.subset_biUnion_of_mem Finsupp.support hf
    have h_sum_eq : (∑ f ∈ T, f.prod (fun i k => (x i) ^ k)) =
        ∑ f ∈ T.subtype (fun f : ι →₀ ℕ => f.support ⊆ S_T), f.val.prod (fun i k => (x i) ^ k) :=
      (Finset.sum_subtype_of_mem (fun f : ι →₀ ℕ => f.prod (fun i k => (x i) ^ k)) hT_sub).symm
    rw [h_sum_eq]
    have h_le_sub : (∑ f ∈ T.subtype (fun f : ι →₀ ℕ => f.support ⊆ S_T), f.val.prod (fun i k => (x i) ^ k)) ≤
        ∑' f : { f : ι →₀ ℕ // f.support ⊆ S_T }, f.val.prod (fun i k => (x i) ^ k) :=
      (hSumProd.subtype { f : ι →₀ ℕ | f.support ⊆ S_T }).sum_le_tsum
        (T.subtype (fun f : ι →₀ ℕ => f.support ⊆ S_T)) (fun f _ => hG_nonneg f.val)
    refine h_le_sub.trans ?_
    rw [hFin S_T]
    exact Real.exp_le_exp.mpr (hSumLog.sum_le_tsum S_T (fun i _ => hL_nonneg i))
  · have h_sub_le : ∀ S : Finset ι,
        Real.exp (∑ i ∈ S, -Real.log (1 - x i)) ≤ ∑' f : ι →₀ ℕ, f.prod (fun i k => (x i) ^ k) := by
      intro S
      rw [← hFin S]
      exact Summable.tsum_subtype_le (fun f : ι →₀ ℕ => f.prod (fun i k => (x i) ^ k))
        { f : ι →₀ ℕ | f.support ⊆ S } hG_nonneg hSumProd
    have hA_pos : 0 < ∑' f : ι →₀ ℕ, f.prod (fun i k => (x i) ^ k) := by
      have h0 := h_sub_le ∅
      simp only [Finset.sum_empty, Real.exp_zero] at h0
      exact zero_lt_one.trans_le h0
    rw [← Real.le_log_iff_exp_le hA_pos]
    refine hSumLog.tsum_le_of_sum_le (fun S => ?_)
    exact (Real.le_log_iff_exp_le hA_pos).mpr (h_sub_le S)

theorem prime_rpow_neg_log_sub_tsum_bounds {F : Type u} [Field F] [NumberField F] {s : ℝ} (hs : 1 < s)
    (hPrime_s : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))))
    (hPrime_2 : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-2 : ℝ)))) :
    (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      0 ≤ ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ∧
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) < 1) ∧
    Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      -Real.log (1 - ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)))) ∧
    0 ≤ (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          -Real.log (1 - ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)))) -
        (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) ∧
    (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          -Real.log (1 - ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)))) -
        (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) ≤
      2 * (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-2 : ℝ))) :=
by
  have hs1 : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      0 ≤ ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ∧
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ≤ 1 / 2 ∧
      (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ 2) ≤
        ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-2 : ℝ)) := by
    intro q
    have h_norm_eq : Ideal.absNorm q.asIdeal = Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    have h_gt1 : 1 < Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
      rw [← h_norm_eq]
      exact NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
    have h_ge2_nat : 2 ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := h_gt1
    have h_2 : (2 : ℝ) ≤ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) := by
      exact_mod_cast h_ge2_nat
    have h_1 : (1 : ℝ) ≤ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) := by linarith
    have h_0 : (0 : ℝ) ≤ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) := by linarith
    refine ⟨Real.rpow_nonneg h_0 (-s), ?_, ?_⟩
    · have h_le_m1 : ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ≤
          ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-1 : ℝ)) :=
        Real.rpow_le_rpow_of_exponent_le h_1 (by linarith)
      have h_m1_le_half : ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-1 : ℝ)) ≤
          (2 : ℝ) ^ (-1 : ℝ) :=
        Real.rpow_le_rpow_of_nonpos (by norm_num) h_2 (by norm_num)
      exact h_le_m1.trans (h_m1_le_half.trans_eq (by norm_num))
    · calc (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ 2)
        _ = (((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ^ ((2 : ℕ) : ℝ)) := by
            rw [Real.rpow_natCast]
        _ = ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ ((-s) * ((2 : ℕ) : ℝ))) := by
            rw [← Real.rpow_mul h_0]
        _ ≤ ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-2 : ℝ)) :=
            Real.rpow_le_rpow_of_exponent_le h_1 (by push_cast; linarith)
  have hs2 : ∀ {x : ℝ}, 0 ≤ x → x ≤ 1 / 2 →
      0 ≤ -Real.log (1 - x) - x ∧ -Real.log (1 - x) - x ≤ 2 * x ^ 2 := by
    intro x hx0 hx1
    have h1mx : 0 < 1 - x := by linarith
    refine ⟨?_, ?_⟩
    · have hlog := Real.log_le_sub_one_of_pos h1mx
      linarith
    · have habs_lt : |x| < 1 := by rw [abs_of_nonneg hx0]; linarith
      have h_taylor := Real.abs_log_sub_add_sum_range_le habs_lt 1
      simp only [Finset.sum_range_one, Nat.cast_zero, zero_add, pow_one, div_one, abs_of_nonneg hx0] at h_taylor
      have h_neg := neg_le_abs (x + Real.log (1 - x))
      have h_div : x ^ 2 / (1 - x) ≤ 2 * x ^ 2 := by
        rw [div_le_iff₀ h1mx]
        have h_nonneg : 0 ≤ x ^ 2 * (1 - 2 * x) := mul_nonneg (sq_nonneg x) (by linarith)
        linarith
      linarith
  have h_pt : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      0 ≤ -Real.log (1 - ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) -
            ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ∧
      -Real.log (1 - ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) -
            ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) ≤
        2 * ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-2 : ℝ)) := by
    intro q
    obtain ⟨hq0, hq_half, hq_sq⟩ := hs1 q
    obtain ⟨h_diff_nonneg, h_diff_le⟩ := hs2 hq0 hq_half
    refine ⟨h_diff_nonneg, by linarith⟩
  have hSumLog : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      -Real.log (1 - ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)))) := by
    refine Summable.of_nonneg_of_le ?_ ?_ (hPrime_s.add (hPrime_2.mul_left 2))
    · intro q
      have h1 := (hs1 q).1
      have h2 := (h_pt q).1
      linarith
    · intro q
      have h2 := (h_pt q).2
      linarith
  refine ⟨?_, hSumLog, ?_, ?_⟩
  · intro q
    obtain ⟨hq0, hq_half, _⟩ := hs1 q
    exact ⟨hq0, by linarith⟩
  · rw [← Summable.tsum_sub hSumLog hPrime_s]
    exact tsum_nonneg (fun q => (h_pt q).1)
  · rw [← Summable.tsum_sub hSumLog hPrime_s, ← tsum_mul_left]
    exact Summable.tsum_le_tsum (fun q => (h_pt q).2) (hSumLog.sub hPrime_s) (hPrime_2.mul_left 2)

theorem tendsto_div_log_of_log_dedekindZeta_re_sub_bounded {F : Type u} [Field F] [NumberField F]
    (P : ℝ → ℝ) (C : ℝ)
    (hBound : ∀ s : ℝ, 1 < s →
      0 ≤ Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) - P s ∧
      Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) - P s ≤ C) :
    Filter.Tendsto
      (fun s : ℝ => P s / Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds 1) :=
by
  have hρ_pos : 0 < NumberField.dedekindZeta_residue F :=
    NumberField.dedekindZeta_residue_pos F
  have hρ_ne : NumberField.dedekindZeta_residue F ≠ 0 := ne_of_gt hρ_pos
  have hZetaC := NumberField.tendsto_sub_one_mul_dedekindZeta_nhdsGT F
  have hZetaRe : Filter.Tendsto
      (fun s : ℝ => (((s : ℂ) - 1) * NumberField.dedekindZeta F (s : ℂ)).re)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds ((NumberField.dedekindZeta_residue F : ℂ).re)) :=
    (Complex.continuous_re.tendsto (NumberField.dedekindZeta_residue F : ℂ)).comp hZetaC
  rw [Complex.ofReal_re] at hZetaRe
  have hZlim : Filter.Tendsto
      (fun s : ℝ => (s - 1) * (NumberField.dedekindZeta F (s : ℂ)).re)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (NumberField.dedekindZeta_residue F)) := by
    refine hZetaRe.congr (fun s => ?_)
    simp [Complex.mul_re, Complex.sub_re, Complex.ofReal_re, Complex.ofReal_im]
  have hLogZlim : Filter.Tendsto
      (fun s : ℝ => Real.log ((s - 1) * (NumberField.dedekindZeta F (s : ℂ)).re))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (Real.log (NumberField.dedekindZeta_residue F))) :=
    hZlim.log hρ_ne
  have hSub0 : Filter.Tendsto (fun s : ℝ => s - 1) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    have h : Filter.Tendsto (fun s : ℝ => s - 1) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds ((1 : ℝ) - 1)) :=
      ((continuous_id.sub continuous_const).tendsto (1 : ℝ)).mono_left nhdsWithin_le_nhds
    simpa [sub_self] using h
  have hSubIoi : ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1), s - 1 ∈ Set.Ioi (0 : ℝ) :=
    eventually_nhdsWithin_of_forall (fun s hs => Set.mem_Ioi.mpr (sub_pos.mpr hs))
  have hSub : Filter.Tendsto (fun s : ℝ => s - 1)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin (0 : ℝ) (Set.Ioi 0)) :=
    tendsto_nhdsWithin_iff.mpr ⟨hSub0, hSubIoi⟩
  have hInv : Filter.Tendsto (fun s : ℝ => 1 / (s - 1))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
    simpa [one_div] using Filter.Tendsto.inv_tendsto_nhdsGT_zero hSub
  have hL_atTop : Filter.Tendsto (fun s : ℝ => Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop :=
    Real.tendsto_log_atTop.comp hInv
  have hRatio0 : Filter.Tendsto
      (fun s : ℝ => Real.log ((s - 1) * (NumberField.dedekindZeta F (s : ℂ)).re) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) :=
    hLogZlim.div_atTop hL_atTop
  have hClim : Filter.Tendsto
      (fun s : ℝ => C / Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) :=
    tendsto_const_nhds.div_atTop hL_atTop
  have hIoo : ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1), s ∈ Set.Ioo (1 : ℝ) 2 :=
    Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)
  have hPos : ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
      0 < (s - 1) * (NumberField.dedekindZeta F (s : ℂ)).re :=
    hZlim.eventually (eventually_gt_nhds hρ_pos)
  have hOnePlus : Filter.Tendsto
      (fun s : ℝ => 1 + Real.log ((s - 1) * (NumberField.dedekindZeta F (s : ℂ)).re) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 1) := by
    simpa using (tendsto_const_nhds (x := (1 : ℝ))).add hRatio0
  have hLogZDiv : Filter.Tendsto
      (fun s : ℝ => Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 1) := by
    refine hOnePlus.congr' ((hIoo.and hPos).mono fun s ⟨hs, hZpos⟩ => ?_)
    dsimp only
    have hs1 : 0 < s - 1 := sub_pos.mpr hs.1
    have hs2 : s - 1 < 1 := by linarith [hs.2]
    have hInv_gt1 : 1 < 1 / (s - 1) := one_lt_one_div hs1 hs2
    have hL_pos : 0 < Real.log (1 / (s - 1)) := Real.log_pos hInv_gt1
    have hL_ne : Real.log (1 / (s - 1)) ≠ 0 := ne_of_gt hL_pos
    have hZ_ne : (NumberField.dedekindZeta F (s : ℂ)).re ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hZpos
      exact lt_irrefl 0 hZpos
    have hLogMul : Real.log ((s - 1) * (NumberField.dedekindZeta F (s : ℂ)).re) =
        Real.log (s - 1) + Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) :=
      Real.log_mul (ne_of_gt hs1) hZ_ne
    have hLogInv : Real.log (1 / (s - 1)) = -Real.log (s - 1) := by
      rw [one_div, Real.log_inv]
    have hNum : Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) =
        Real.log (1 / (s - 1)) +
          Real.log ((s - 1) * (NumberField.dedekindZeta F (s : ℂ)).re) := by
      linarith [hLogMul, hLogInv]
    rw [hNum, add_div, div_self hL_ne]
  have hDiffDiv : Filter.Tendsto
      (fun s : ℝ => (Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) - P s) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hClim
      (hIoo.mono fun s hs => ?_) (hIoo.mono fun s hs => ?_)
    · have hs1 : 0 < s - 1 := sub_pos.mpr hs.1
      have hs2 : s - 1 < 1 := by linarith [hs.2]
      have hL_nonneg : 0 ≤ Real.log (1 / (s - 1)) :=
        le_of_lt (Real.log_pos (one_lt_one_div hs1 hs2))
      exact div_nonneg (hBound s hs.1).1 hL_nonneg
    · have hs1 : 0 < s - 1 := sub_pos.mpr hs.1
      have hs2 : s - 1 < 1 := by linarith [hs.2]
      have hL_nonneg : 0 ≤ Real.log (1 / (s - 1)) :=
        le_of_lt (Real.log_pos (one_lt_one_div hs1 hs2))
      exact div_le_div_of_nonneg_right (hBound s hs.1).2 hL_nonneg
  have hSubLim : Filter.Tendsto
      (fun s : ℝ =>
        Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) / Real.log (1 / (s - 1)) -
        (Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) - P s) / Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 1) := by
    simpa using hLogZDiv.sub hDiffDiv
  refine hSubLim.congr (fun s => ?_)
  rw [← sub_div, sub_sub_cancel]

theorem tendsto_univ_prime_sum_div_log {F : Type u} [Field F] [NumberField F] :
    Filter.Tendsto
      (fun s : ℝ =>
        (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds 1) :=
by
  apply tendsto_div_log_of_log_dedekindZeta_re_sub_bounded (F := F)
    (fun s : ℝ =>
      ∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)))
    (2 * (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-2 : ℝ))))
  intro s hs
  obtain ⟨hIdeal_s, hZeta_s⟩ := dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := F) hs
  obtain ⟨hIdeal_2, _⟩ := dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := F) (by norm_num : (1 : ℝ) < 2)
  obtain ⟨hPrime_s, hProd_s, hEqProd_s⟩ := tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_s
  obtain ⟨hPrime_2, _, _⟩ := tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_2
  obtain ⟨hBounds_q, hSumLog, hDiff_nonneg, hDiff_le⟩ :=
    prime_rpow_neg_log_sub_tsum_bounds hs hPrime_s hPrime_2
  have hEuler := tsum_finsupp_prod_pow_eq_rexp_tsum_neg_log_one_sub
    (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)))
    (fun q => (hBounds_q q).1)
    (fun q => (hBounds_q q).2)
    hSumLog
    hProd_s
  have hLogZeta : Real.log ((NumberField.dedekindZeta F (s : ℂ)).re) =
      ∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        -Real.log (1 - ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) := by
    rw [hZeta_s, hEqProd_s, hEuler, Real.log_exp]
  rw [hLogZeta]
  exact ⟨hDiff_nonneg, hDiff_le⟩

theorem tendsto_unramified_prime_sum_div_log {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (hUniv : Filter.Tendsto
      (fun s : ℝ =>
        (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds 1)) :
    Filter.Tendsto
      (fun s : ℝ =>
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q },
          ((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds 1) :=
by
  let U : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
    { q | IsUnramifiedAtPrime F E q }
  let D : Ideal (NumberField.RingOfIntegers E) :=
    differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)
  have hD : D ≠ ⊥ := differentIdeal_ne_bot
  let T : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers E)) :=
    { v | v.asIdeal ∣ D }
  have hT : T.Finite := Ideal.finite_factors hD
  have h_ex : ∀ q : ↑Uᶜ, ∃ v : ↑T,
      Ideal.under (NumberField.RingOfIntegers F) v.1.asIdeal = q.1.asIdeal := by
    intro ⟨q, hq⟩
    change ¬ IsUnramifiedAtPrime F E q at hq
    rw [IsUnramifiedAtPrime] at hq
    push_neg at hq
    rcases hq with ⟨P, hP_prime, h_under, h_ram⟩
    haveI : P.IsPrime := hP_prime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    have h_map : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
        q.asIdeal ≤ P :=
      Ideal.map_le_iff_le_comap.mpr h_under.symm.le
    have h_le2 : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
        q.asIdeal ≤ P ^ 2 :=
      (Ideal.ramificationIdx_ne_one_iff h_map).mp h_ram
    have h_dvd2 : P ^ 2 ∣ Ideal.map
        (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal :=
      Ideal.dvd_iff_le.mpr h_le2
    have h_dvdD : P ∣ D := by
      simpa using pow_sub_one_dvd_differentIdeal (NumberField.RingOfIntegers F) P 2 q.ne_bot h_dvd2
    have hP_ne_bot : P ≠ ⊥ := by
      intro h_bot
      rw [h_bot, ← Submodule.zero_eq_bot, zero_dvd_iff, Submodule.zero_eq_bot] at h_dvdD
      exact hD h_dvdD
    exact ⟨⟨⟨P, hP_prime, hP_ne_bot⟩, h_dvdD⟩, h_under⟩
  choose φ hφ using h_ex
  have hφ_inj : Function.Injective φ := by
    intro q₁ q₂ hq
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    rw [← hφ q₁, hq, hφ q₂]
  haveI : Finite ↑T := hT.to_subtype
  haveI : Finite ↑Uᶜ := Finite.of_injective φ hφ_inj
  letI : Fintype ↑Uᶜ := Fintype.ofFinite ↑Uᶜ
  let f : ℝ → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℝ :=
    fun s q => (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)
  have h_num : Filter.Tendsto (fun s : ℝ => ∑' q : ↑Uᶜ, f s q.1)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (∑ q ∈ (Finset.univ : Finset ↑Uᶜ), f 1 q.1)) := by
    simp_rw [tsum_fintype]
    refine tendsto_finset_sum Finset.univ (fun q _ => ?_)
    haveI : q.1.asIdeal.IsMaximal := q.1.isMaximal
    have hc_pos : 0 < Nat.card (NumberField.RingOfIntegers F ⧸ q.1.asIdeal) := Nat.card_pos
    have hc_ne : (Nat.card (NumberField.RingOfIntegers F ⧸ q.1.asIdeal) : ℝ) ≠ 0 :=
      Nat.cast_ne_zero.mpr hc_pos.ne'
    exact tendsto_nhdsWithin_of_tendsto_nhds
      ((ContinuousAt.rpow continuousAt_const continuousAt_id.neg (Or.inl hc_ne)).tendsto)
  have h_sub : Filter.Tendsto (fun s : ℝ => s - 1)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin (0 : ℝ) (Set.Ioi 0)) := by
    refine tendsto_nhdsWithin_iff.mpr
      ⟨?_, eventually_nhdsWithin_of_forall (fun s hs => Set.mem_Ioi.mpr (sub_pos.mpr hs))⟩
    have h_c : ContinuousAt (fun s : ℝ => s - 1) 1 := continuousAt_id.sub continuousAt_const
    simpa [sub_self] using tendsto_nhdsWithin_of_tendsto_nhds h_c.tendsto
  have h_inv : Filter.Tendsto (fun s : ℝ => 1 / (s - 1))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
    simpa only [one_div] using tendsto_inv_nhdsGT_zero.comp h_sub
  have h_den : Filter.Tendsto (fun s : ℝ => Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop :=
    Real.tendsto_log_atTop.comp h_inv
  have h_ram : Filter.Tendsto
      (fun s : ℝ => (∑' q : ↑Uᶜ, f s q.1) / Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) :=
    Filter.Tendsto.div_atTop h_num h_den
  have h_diff : Filter.Tendsto
      (fun s : ℝ =>
        (∑' q, f s q) / Real.log (1 / (s - 1)) -
        (∑' q : ↑Uᶜ, f s q.1) / Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 1) := by
    simpa only [sub_zero] using hUniv.sub h_ram
  refine h_diff.congr' ?_
  filter_upwards [hUniv.eventually_ne one_ne_zero] with s hs_ne
  have h_tsum_ne : (∑' q, f s q) ≠ 0 := by
    intro h_zero
    apply hs_ne
    simp [f, h_zero]
  have h_sum : Summable (f s) := by
    by_contra h_not_sum
    exact h_tsum_ne (tsum_eq_zero_of_not_summable h_not_sum)
  have h_split := Summable.tsum_subtype_add_tsum_subtype_compl h_sum U
  dsimp only [U, f] at h_split ⊢
  rw [← sub_div, ← eq_sub_of_add_eq h_split]

theorem unramified_prime_sum_eq_sum_frob_singleton {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    {s : ℝ} (hs : 1 < s) :
    (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
        IsUnramifiedAtPrime F E q },
      ((Nat.card (NumberField.RingOfIntegers F ⧸
        (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) =
    ∑ τ : E ≃ₐ[F] E,
      (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
          IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {τ} },
        ((Nat.card (NumberField.RingOfIntegers F ⧸
          (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) :=
by
  have h_summable : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
      ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))) := by
    have h_exists_i :
        ∃ i : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
            Fin (Module.finrank ℚ F),
          ∀ q₁ q₂, Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal → i q₁ = i q₂ → q₁ = q₂ := by
      have hp_max (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
          (Ideal.under ℤ q.asIdeal).IsMaximal := by
        haveI : q.asIdeal.IsMaximal := q.isMaximal
        exact Ideal.IsMaximal.under ℤ q.asIdeal
      have hp_ne_bot (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
          Ideal.under ℤ q.asIdeal ≠ ⊥ :=
        Ideal.under_ne_bot ℤ q.ne_bot
      have h_over (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
          q.asIdeal ∈ (Ideal.under ℤ q.asIdeal).primesOver (NumberField.RingOfIntegers F) :=
        ⟨q.isPrime, ⟨rfl⟩⟩
      let idx (P : Ideal ℤ) (hP_max : P.IsMaximal) (hP_ne : P ≠ ⊥)
          (Q : Ideal (NumberField.RingOfIntegers F))
          (hQ : Q ∈ P.primesOver (NumberField.RingOfIntegers F)) : Fin (Module.finrank ℚ F) :=
        letI : P.IsMaximal := hP_max
        Fin.castLE (Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers F) ℚ F hP_ne)
          ((primesOverFinset P (NumberField.RingOfIntegers F)).equivFin
            ⟨Q, (mem_primesOverFinset_iff hP_ne (NumberField.RingOfIntegers F)).mpr hQ⟩)
      have h_idx_congr : ∀ {P₁ P₂ : Ideal ℤ} (hP : P₁ = P₂)
          (h₁_max : P₁.IsMaximal) (h₂_max : P₂.IsMaximal)
          (h₁_ne : P₁ ≠ ⊥) (h₂_ne : P₂ ≠ ⊥)
          (Q : Ideal (NumberField.RingOfIntegers F))
          (hQ₁ : Q ∈ P₁.primesOver (NumberField.RingOfIntegers F))
          (hQ₂ : Q ∈ P₂.primesOver (NumberField.RingOfIntegers F)),
          idx P₁ h₁_max h₁_ne Q hQ₁ = idx P₂ h₂_max h₂_ne Q hQ₂ := by
        rintro P₁ _ rfl _ _ _ _ Q _ _
        rfl
      refine ⟨fun q => idx (Ideal.under ℤ q.asIdeal) (hp_max q) (hp_ne_bot q) q.asIdeal (h_over q), ?_⟩
      intro q₁ q₂ hp_eq hi_eq
      have hQ₁_over₂ : q₁.asIdeal ∈ (Ideal.under ℤ q₂.asIdeal).primesOver (NumberField.RingOfIntegers F) :=
        hp_eq ▸ h_over q₁
      have h_idx_eq : idx (Ideal.under ℤ q₂.asIdeal) (hp_max q₂) (hp_ne_bot q₂) q₁.asIdeal hQ₁_over₂ =
          idx (Ideal.under ℤ q₂.asIdeal) (hp_max q₂) (hp_ne_bot q₂) q₂.asIdeal (h_over q₂) := by
        rw [← h_idx_congr hp_eq (hp_max q₁) (hp_max q₂) (hp_ne_bot q₁) (hp_ne_bot q₂)
          q₁.asIdeal (h_over q₁) hQ₁_over₂]
        exact hi_eq
      letI : (Ideal.under ℤ q₂.asIdeal).IsMaximal := hp_max q₂
      have h_equiv_eq := Fin.castLE_injective
        (Ideal.card_primesOverFinset_le_finrank (NumberField.RingOfIntegers F) ℚ F (hp_ne_bot q₂)) h_idx_eq
      have h_sub_eq := ((primesOverFinset (Ideal.under ℤ q₂.asIdeal) (NumberField.RingOfIntegers F)).equivFin).injective h_equiv_eq
      exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val h_sub_eq)
    rcases h_exists_i with ⟨i, hi_inj⟩
    have h_exists_k :
        ∃ k : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ,
          Function.Injective k ∧
          ∀ q, 0 < k q ∧
            k q ≤ (2 * Module.finrank ℚ F + 1) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
      refine ⟨fun q => Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) + (i q : ℕ), ?_, ?_⟩
      · intro q₁ q₂ h_eq
        dsimp only at h_eq
        have hi₁ : (i q₁ : ℕ) < Module.finrank ℚ F := (i q₁).isLt
        have hi₂ : (i q₂ : ℕ) < Module.finrank ℚ F := (i q₂).isLt
        have h_div₁ : (Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) + (i q₁ : ℕ)) / Module.finrank ℚ F =
            Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) := by
          rw [Nat.mul_add_div hi₁.pos, Nat.div_eq_of_lt hi₁, add_zero]
        have h_div₂ : (Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) + (i q₂ : ℕ)) / Module.finrank ℚ F =
            Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) := by
          rw [Nat.mul_add_div hi₂.pos, Nat.div_eq_of_lt hi₂, add_zero]
        have hm : Ideal.absNorm (Ideal.under ℤ q₁.asIdeal) = Ideal.absNorm (Ideal.under ℤ q₂.asIdeal) := by
          rw [← h_div₁, ← h_div₂, h_eq]
        have hi_val : (i q₁ : ℕ) = (i q₂ : ℕ) := by
          rw [hm] at h_eq
          exact Nat.add_left_cancel h_eq
        have hp_eq : Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal := by
          rw [← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₁.asIdeal),
              ← Int.ideal_span_absNorm_eq_self (Ideal.under ℤ q₂.asIdeal), hm]
        exact hi_inj q₁ q₂ hp_eq (Fin.ext hi_val)
      · intro q
        have h_card_eq : Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) = Ideal.absNorm q.asIdeal := by
          rw [← Submodule.cardQuot_apply, ← Ideal.absNorm_apply]
        have h_one_lt : 1 < Ideal.absNorm q.asIdeal :=
          NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
        have h_card_pos : 1 ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by omega
        have h_dvd : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ∣ Ideal.absNorm q.asIdeal :=
          Int.absNorm_under_dvd_absNorm q.asIdeal
        have hm_pos : 0 < Ideal.absNorm (Ideal.under ℤ q.asIdeal) :=
          Nat.pos_of_dvd_of_pos h_dvd (by omega)
        have hm_le : Ideal.absNorm (Ideal.under ℤ q.asIdeal) ≤ Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
          rw [h_card_eq]
          exact Nat.le_of_dvd (by omega) h_dvd
        have hi_lt : (i q : ℕ) < Module.finrank ℚ F := (i q).isLt
        constructor
        · exact Nat.add_pos_left (Nat.mul_pos hi_lt.pos hm_pos) (i q : ℕ)
        · have h1 : Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) ≤
              Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
            Nat.mul_le_mul_left _ hm_le
          have h2 : (i q : ℕ) ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
            calc (i q : ℕ) ≤ Module.finrank ℚ F := hi_lt.le
              _ = Module.finrank ℚ F * 1 := (Nat.mul_one _).symm
              _ ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
                Nat.mul_le_mul_left _ h_card_pos
          calc Module.finrank ℚ F * Ideal.absNorm (Ideal.under ℤ q.asIdeal) + (i q : ℕ)
              ≤ Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) +
                  Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) :=
                Nat.add_le_add h1 h2
            _ ≤ (2 * Module.finrank ℚ F + 1) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
                have : Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) +
                    Module.finrank ℚ F * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) =
                    (2 * Module.finrank ℚ F) * Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by ring
                rw [this]
                exact Nat.mul_le_mul_right _ (by omega)
    rcases h_exists_k with ⟨k, hk_inj, hk_bounds⟩
    let C : ℝ := 2 * (Module.finrank ℚ F : ℝ) + 1
    have hC_pos : 0 < C := by positivity
    have h_dom : Summable (fun q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
        (C ^ s) * ((k q : ℝ) ^ (-s))) := by
      have h_nat : Summable (fun n : ℕ => (n : ℝ) ^ (-s)) :=
        Real.summable_nat_rpow.mpr (by linarith)
      exact (h_nat.mul_left (C ^ s)).comp_injective hk_inj
    refine Summable.of_nonneg_of_le (fun q => by positivity) (fun q => ?_) h_dom
    obtain ⟨hk_pos, hk_le⟩ := hk_bounds q
    have h_card_pos : 0 < Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) := by
      by_contra h_zero
      have h0 : Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) = 0 := by omega
      rw [h0, mul_zero] at hk_le
      omega
    have hk_pos_real : (0 : ℝ) < (k q : ℝ) := Nat.cast_pos.mpr hk_pos
    have h_card_pos_real : (0 : ℝ) < (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) :=
      Nat.cast_pos.mpr h_card_pos
    have hk_le_real : (k q : ℝ) ≤ C * (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) := by
      dsimp only [C]
      exact_mod_cast hk_le
    have h_rpow_le : ((C * (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ)) ^ (-s)) ≤ (k q : ℝ) ^ (-s) :=
      Real.rpow_le_rpow_of_nonpos hk_pos_real hk_le_real (by linarith)
    rw [Real.mul_rpow hC_pos.le h_card_pos_real.le] at h_rpow_le
    have h_mul := mul_le_mul_of_nonneg_left h_rpow_le (Real.rpow_pos_of_pos hC_pos s).le
    rw [← mul_assoc, ← Real.rpow_add hC_pos, add_neg_cancel, Real.rpow_zero, one_mul] at h_mul
    exact h_mul
  have h_comm : ∀ ρ g : E ≃ₐ[F] E, ρ * g * ρ⁻¹ = g := by
    intro ρ g
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic ρ)
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic g)
    rw [← zpow_add, add_comm m n, zpow_add, mul_inv_cancel_right]
  have h_frob_singleton : ∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
      IsUnramifiedAtPrime F E q →
      ∃ g : E ≃ₐ[F] E, ∀ τ : E ≃ₐ[F] E, (FrobeniusClassAt F E q ⊆ {τ} ↔ g = τ) := by
    intro q hq
    have h_frob_iff : ∀ g : E ≃ₐ[F] E, g ∈ FrobeniusClassAt F E q ↔
        ∃ Q : Ideal (NumberField.RingOfIntegers E), Q.IsPrime ∧
          Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal ∧
          IsArithFrobAt (NumberField.RingOfIntegers F) g Q := by
      intro g
      simp only [FrobeniusClassAt, Set.mem_setOf_eq]
      refine exists_congr (fun Q => and_congr_right (fun _ => and_congr_right (fun h_under => ?_)))
      constructor
      · intro h x
        have hx := h x (g • x) rfl
        rwa [h_under]
      · intro h x z hz
        have hzx : z = g • x := Subtype.ext hz
        rw [hzx, ← h_under]
        exact h x
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    obtain ⟨Q₁, hQ₁⟩ := Ideal.nonempty_primesOver (S := NumberField.RingOfIntegers E) q.asIdeal
    have hQ₁_prime : Q₁.IsPrime := hQ₁.1
    have hQ₁_over : Q₁.LiesOver q.asIdeal := hQ₁.2
    have h_under₁ : Ideal.under (NumberField.RingOfIntegers F) Q₁ = q.asIdeal :=
      hQ₁_over.over.symm
    haveI : Q₁.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₁ q.asIdeal
    obtain ⟨g, hg₁⟩ := IsArithFrobAt.exists_of_isInvariant
      (NumberField.RingOfIntegers F) (E ≃ₐ[F] E) Q₁
    have hg_mem : g ∈ FrobeniusClassAt F E q :=
      (h_frob_iff g).mpr ⟨Q₁, hQ₁_prime, h_under₁, hg₁⟩
    refine ⟨g, fun τ => ⟨fun h_sub => Set.mem_singleton_iff.mp (h_sub hg_mem), ?_⟩⟩
    rintro rfl g₂ hg₂
    rw [h_frob_iff] at hg₂
    rcases hg₂ with ⟨Q₂, hQ₂_prime, h_under₂, hg₂⟩
    haveI : Q₂.LiesOver q.asIdeal := ⟨h_under₂.symm⟩
    obtain ⟨ρ, hρ⟩ := Ideal.exists_smul_eq_of_isGaloisGroup q.asIdeal Q₁ Q₂ (E ≃ₐ[F] E)
    have hg₁' : IsArithFrobAt (NumberField.RingOfIntegers F) (ρ * g * ρ⁻¹) Q₂ := by
      rw [← hρ]
      exact hg₁.conj ρ
    have h_mem := hg₁'.mul_inv_mem_inertia hg₂
    haveI : Q₂.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₂ q.asIdeal
    letI := Ideal.Quotient.field q.asIdeal
    letI := Ideal.Quotient.field Q₂
    haveI : PerfectField (NumberField.RingOfIntegers F ⧸ q.asIdeal) := PerfectField.ofFinite
    haveI : Algebra.IsSeparable (NumberField.RingOfIntegers F ⧸ q.asIdeal)
      (NumberField.RingOfIntegers E ⧸ Q₂) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    have h_card : Nat.card ((Submodule.toAddSubgroup Q₂).inertia (E ≃ₐ[F] E)) = 1 := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q₂,
        Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q₂ (E ≃ₐ[F] E)]
      exact hq Q₂ hQ₂_prime h_under₂
    have h_bot : (Submodule.toAddSubgroup Q₂).inertia (E ≃ₐ[F] E) = ⊥ :=
      Subgroup.card_eq_one.mp h_card
    rw [h_bot, Subgroup.mem_bot, mul_inv_eq_one, h_comm ρ g] at h_mem
    exact Set.mem_singleton_iff.mpr h_mem.symm
  let U : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
    { q | IsUnramifiedAtPrime F E q }
  let S (τ : E ≃ₐ[F] E) : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
    { q | IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {τ} }
  let f (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) : ℝ :=
    ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s))
  let π (x : U) : E ≃ₐ[F] E := (h_frob_singleton x.1 x.2).choose
  have h_π (x : U) (τ : E ≃ₐ[F] E) : FrobeniusClassAt F E x.1 ⊆ {τ} ↔ π x = τ :=
    (h_frob_singleton x.1 x.2).choose_spec τ
  let e₁ : (Σ τ : E ≃ₐ[F] E, { x : U // π x = τ }) ≃ U := Equiv.sigmaFiberEquiv π
  have h_sum_U : Summable (fun x : U => f x.1) := h_summable.subtype U
  have h_sum_sigma : Summable (fun p : (Σ τ : E ≃ₐ[F] E, { x : U // π x = τ }) => f (e₁ p).1) :=
    (Equiv.summable_iff e₁).mpr h_sum_U
  change (∑' x : U, f x.1) = ∑ τ : E ≃ₐ[F] E, (∑' z : S τ, f z.1)
  rw [← Equiv.tsum_eq e₁ (fun x : U => f x.1), Summable.tsum_sigma h_sum_sigma, tsum_fintype]
  refine Finset.sum_congr rfl (fun τ _ => ?_)
  let e₂ : { x : U // π x = τ } ≃ S τ :=
    { toFun := fun y => ⟨y.1.1, ⟨y.1.2, (h_π y.1 τ).mpr y.2⟩⟩
      invFun := fun z => ⟨⟨z.1, z.2.1⟩, (h_π ⟨z.1, z.2.1⟩ τ).mp z.2.2⟩
      left_inv := fun y => by ext; rfl
      right_inv := fun z => by ext; rfl }
  exact Equiv.tsum_eq e₂ (fun z : S τ => f z.1)

theorem tendsto_diff_div_of_tendsto_nontrivial_char_sum_zero {G : Type u} [Group G] [Fintype G]
    (σ : G)
    (hCyclic : ∀ τ : G, τ ∈ Subgroup.zpowers σ)
    (D : G → ℝ → ℝ) (L : ℝ → ℝ) (l : Filter ℝ)
    (hChar : ∀ χ : G →* ℂˣ, χ ≠ 1 →
      Filter.Tendsto
        (fun s : ℝ => (∑ ρ : G, (χ ρ : ℂ) * (D ρ s : ℂ)) / (L s : ℂ))
        l (nhds 0))
    (τ : G) :
    Filter.Tendsto
      (fun s : ℝ => (D σ s - D τ s) / L s)
      l (nhds 0) :=
by
  classical
  haveI : IsCyclic G :=
    isCyclic_iff_exists_zpowers_eq_top.mpr ⟨σ, (Subgroup.eq_top_iff' (Subgroup.zpowers σ)).mpr hCyclic⟩
  letI : CommGroup G := IsCyclic.commGroup
  let f : AddChar (Additive G) ℂ → (G →* ℂ) := fun ψ =>
    { toFun := fun g => ψ (Additive.ofMul g)
      map_one' := by rw [ofMul_one, AddChar.map_zero_eq_one]
      map_mul' := fun x y => by rw [ofMul_mul, AddChar.map_add_eq_mul] }
  let χ : AddChar (Additive G) ℂ → (G →* ℂˣ) := fun ψ => (f ψ).toHomUnits
  have hχ_val (ψ : AddChar (Additive G) ℂ) (ρ : G) :
      ((χ ψ ρ : ℂˣ) : ℂ) = ψ (Additive.ofMul ρ) :=
    MonoidHom.coe_toHomUnits (f ψ) ρ
  have hχ_ne_one (ψ : AddChar (Additive G) ℂ) (hψ : ψ ≠ 0) : χ ψ ≠ 1 := by
    intro h_eq
    apply hψ
    ext a
    have h1 : ((χ ψ (Additive.toMul a) : ℂˣ) : ℂ) = ((1 : G →* ℂˣ) (Additive.toMul a) : ℂ) := by
      rw [h_eq]
    rw [hχ_val, ofMul_toMul, MonoidHom.one_apply, Units.val_one] at h1
    simpa using h1
  let T : AddChar (Additive G) ℂ → ℝ → ℂ := fun ψ s =>
    (ψ (Additive.ofMul σ⁻¹) - ψ (Additive.ofMul τ⁻¹)) *
      ((∑ ρ : G, ψ (Additive.ofMul ρ) * (D ρ s : ℂ)) / (L s : ℂ))
  have hT_tendsto (ψ : AddChar (Additive G) ℂ) :
      Filter.Tendsto (fun s : ℝ => T ψ s) l (nhds 0) := by
    by_cases hψ : ψ = 0
    · subst hψ
      have h0 : (fun s : ℝ => T 0 s) = fun _ => 0 := by
        ext s
        simp [T]
      rw [h0]
      exact tendsto_const_nhds
    · have h1 := hChar (χ ψ) (hχ_ne_one ψ hψ)
      have h2 := h1.const_mul (ψ (Additive.ofMul σ⁻¹) - ψ (Additive.ofMul τ⁻¹))
      rw [mul_zero] at h2
      refine h2.congr (fun s => ?_)
      dsimp [T]
      simp_rw [hχ_val]
  have hSum_tendsto :
      Filter.Tendsto
        (fun s : ℝ => (Fintype.card (Additive G) : ℂ)⁻¹ * ∑ ψ : AddChar (Additive G) ℂ, T ψ s)
        l (nhds 0) := by
    have h1 : Filter.Tendsto (fun s : ℝ => ∑ ψ : AddChar (Additive G) ℂ, T ψ s) l
        (nhds (∑ _ψ : AddChar (Additive G) ℂ, (0 : ℂ))) :=
      tendsto_finset_sum Finset.univ (fun ψ _ => hT_tendsto ψ)
    rw [Finset.sum_const_zero] at h1
    have h2 := h1.const_mul (Fintype.card (Additive G) : ℂ)⁻¹
    rwa [mul_zero] at h2
  have hOrtho (γ ρ : G) :
      (∑ ψ : AddChar (Additive G) ℂ, ψ (Additive.ofMul γ⁻¹) * ψ (Additive.ofMul ρ)) =
        if γ = ρ then (Fintype.card (Additive G) : ℂ) else 0 := by
    have h_mul (ψ : AddChar (Additive G) ℂ) :
        ψ (Additive.ofMul γ⁻¹) * ψ (Additive.ofMul ρ) = ψ (Additive.ofMul (γ⁻¹ * ρ)) := by
      rw [ofMul_mul, AddChar.map_add_eq_mul]
    simp_rw [h_mul]
    rw [AddChar.sum_apply_eq_ite]
    have h_iff : Additive.ofMul (γ⁻¹ * ρ) = 0 ↔ γ = ρ := by
      rw [ofMul_eq_zero, inv_mul_eq_one]
    simp_rw [h_iff]
  have hEval (γ : G) (s : ℝ) :
      (∑ ψ : AddChar (Additive G) ℂ,
        ψ (Additive.ofMul γ⁻¹) * (∑ ρ : G, ψ (Additive.ofMul ρ) * (D ρ s : ℂ))) =
        (Fintype.card (Additive G) : ℂ) * (D γ s : ℂ) := by
    simp_rw [Finset.mul_sum, ← mul_assoc]
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_mul, hOrtho]
    simp
  have h_card : (Fintype.card (Additive G) : ℂ) ≠ 0 := by
    haveI : Nonempty (Additive G) := ⟨Additive.ofMul 1⟩
    exact Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  have hPointwise (s : ℝ) :
      (Fintype.card (Additive G) : ℂ)⁻¹ * (∑ ψ : AddChar (Additive G) ℂ, T ψ s) =
        (((D σ s - D τ s) / L s : ℝ) : ℂ) := by
    have hT_eq (ψ : AddChar (Additive G) ℂ) :
        T ψ s = (ψ (Additive.ofMul σ⁻¹) * (∑ ρ : G, ψ (Additive.ofMul ρ) * (D ρ s : ℂ)) -
          ψ (Additive.ofMul τ⁻¹) * (∑ ρ : G, ψ (Additive.ofMul ρ) * (D ρ s : ℂ))) / (L s : ℂ) := by
      dsimp [T]
      rw [← mul_div_assoc, sub_mul]
    simp_rw [hT_eq]
    rw [← Finset.sum_div, Finset.sum_sub_distrib, hEval, hEval, ← mul_sub, mul_div_assoc,
      inv_mul_cancel_left₀ h_card]
    push_cast
    rfl
  have hComplex_tendsto :
      Filter.Tendsto (fun s : ℝ => (((D σ s - D τ s) / L s : ℝ) : ℂ)) l (nhds 0) :=
    hSum_tendsto.congr hPointwise
  have hRe := (Complex.continuous_re.tendsto (0 : ℂ)).comp hComplex_tendsto
  rw [Complex.zero_re] at hRe
  exact hRe.congr (fun s => Complex.ofReal_re _)

theorem bdd_on_Ioo_log_euler_sub_prime_sum {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (χ : (E ≃ₐ[F] E) →* ℂˣ) :
    ∃ M₁ : ℝ, ∀ s ∈ Set.Ioo (1 : ℝ) 2,
      ‖∑ ρ : E ≃ₐ[F] E,
        ((∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
          -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ))) -
        (χ ρ : ℂ) * (((∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
          ((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) : ℝ) : ℂ))‖ ≤ M₁ :=
by
  have h_exists_i :
      ∃ i : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →
          Fin (Module.finrank ℚ F),
        ∀ q₁ q₂, Ideal.under ℤ q₁.asIdeal = Ideal.under ℤ q₂.asIdeal → i q₁ = i q₂ → q₁ = q₂ := by
    have hp_max (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :
        (Ideal.under ℤ q.asIdeal).IsMaximal := by
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      exact Ideal.IsMaximal.under ℤ q.asIdeal
