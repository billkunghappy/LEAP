          Nat.eq_one_of_mul_eq_one_right h_tower.symm
        obtain ⟨γ, hγ_mem, hγ_arith⟩ := hP_frob Q hQ_prime hQ_under_L
        have h_fix : ∀ y : NumberField.RingOfIntegers K',
