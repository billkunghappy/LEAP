      refine ⟨hP_unr, fun Q hQ_prime hQ_under => ?_⟩
      haveI : Q.IsPrime := hQ_prime
      haveI : Q.LiesOver P.asIdeal := ⟨hQ_under.symm⟩
      haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q P.asIdeal
      obtain ⟨γ, hγ_arith⟩ :=
        IsArithFrobAt.exists_of_isInvariant (NumberField.RingOfIntegers L) (M ≃ₐ[L] M) Q
      refine ⟨γ, ?_, hγ_arith⟩
      refine ⟨P.asIdeal, hP_good, ?_⟩
      have hm_not_Q : (m : NumberField.RingOfIntegers M) ∉ Q := by
        intro hm_Q
        have hm_P : (m : NumberField.RingOfIntegers L) ∈ P.asIdeal := by
          rw [← hQ_under]
          change algebraMap (NumberField.RingOfIntegers L) (NumberField.RingOfIntegers M)
