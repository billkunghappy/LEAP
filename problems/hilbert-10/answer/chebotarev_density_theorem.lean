        (∑' P : T₀, ((Nat.card (R_E ⧸ P.1.asIdeal) : ℝ) ^ (-s))) =
        ∑' P : ↑T₀ᶜ, ((Nat.card (R_E ⧸ P.1.asIdeal) : ℝ) ^ (-s)) := by
      have h_add := Summable.tsum_subtype_add_tsum_subtype_compl hPrime_E T₀
      linarith
    rw [h_compl_eq]
    have h_pt : ∀ P : IsDedekindDomain.HeightOneSpectrum R_E,
        ENNReal.ofReal ((Nat.card (R_E ⧸ P.asIdeal) : ℝ) ^ (-s)) ≤ ENNReal.ofReal (g P) := by
      intro P
      apply ENNReal.ofReal_le_ofReal
      have h_norm : 1 < Ideal.absNorm P.asIdeal :=
        NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm P
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply] at h_norm
      have h_one_le : (1 : ℝ) ≤ (Nat.card (R_E ⧸ P.asIdeal) : ℝ) := by exact_mod_cast h_norm.le
      calc
        (Nat.card (R_E ⧸ P.asIdeal) : ℝ) ^ (-s)
          ≤ (Nat.card (R_E ⧸ P.asIdeal) : ℝ) ^ (-1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le h_one_le (by linarith [hs.1])
        _ = g P := Real.rpow_neg_one _
    have h_enn_le :
        ENNReal.ofReal (∑' P : ↑T₀ᶜ, ((Nat.card (R_E ⧸ P.1.asIdeal) : ℝ) ^ (-s))) ≤
        ENNReal.ofReal C₂ := by
      rw [ENNReal.ofReal_tsum_of_nonneg (fun P => Real.rpow_nonneg (Nat.cast_nonneg _) _) (hPrime_E.subtype T₀ᶜ),
        ENNReal.ofReal_add (tsum_nonneg (fun _ => inv_nonneg.mpr (Nat.cast_nonneg _)))
          (tsum_nonneg (fun _ => inv_nonneg.mpr (Nat.cast_nonneg _))),
        ENNReal.ofReal_tsum_of_nonneg (fun _ => inv_nonneg.mpr (Nat.cast_nonneg _)) (hB₁.summable g),
        ENNReal.ofReal_tsum_of_nonneg (fun _ => inv_nonneg.mpr (Nat.cast_nonneg _)) hB₂]
      calc
        (∑' P : ↑T₀ᶜ, ENNReal.ofReal ((Nat.card (R_E ⧸ P.1.asIdeal) : ℝ) ^ (-s)))
          ≤ ∑' P : ↑T₀ᶜ, ENNReal.ofReal (g P.1) := ENNReal.tsum_le_tsum (fun P => h_pt P.1)
        _ ≤ ∑' P : ↑(B₁ ∪ B₂), ENNReal.ofReal (g P.1) :=
            ENNReal.tsum_mono_subtype (fun P => ENNReal.ofReal (g P)) hDiff
        _ ≤ (∑' P : ↑B₁, ENNReal.ofReal (g P.1)) + (∑' P : ↑B₂, ENNReal.ofReal (g P.1)) :=
            ENNReal.tsum_union_le (fun P => ENNReal.ofReal (g P)) B₁ B₂
    have h_toReal_le := ENNReal.toReal_mono ENNReal.ofReal_ne_top h_enn_le
    rwa [ENNReal.toReal_ofReal (tsum_nonneg (fun P => Real.rpow_nonneg (Nat.cast_nonneg _) _)),
      ENNReal.toReal_ofReal (add_nonneg (tsum_nonneg (fun _ => inv_nonneg.mpr (Nat.cast_nonneg _)))
        (tsum_nonneg (fun _ => inv_nonneg.mpr (Nat.cast_nonneg _))))] at h_toReal_le
  have h_s1 : ∀ (B : ℝ),
      (∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
        B ≤ (Nat.card (E ≃ₐ[F] E) : ℝ) *
          (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
              IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {(1 : E ≃ₐ[F] E)} },
            ((Nat.card (NumberField.RingOfIntegers F ⧸
              (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) -
          (∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)))) →
      w ≠ 0 := by
    intro B hB
    classical
    let G := E ≃ₐ[F] E
    haveI : IsCyclic G :=
      isCyclic_iff_exists_zpowers_eq_top.mpr ⟨σ, (Subgroup.eq_top_iff' (Subgroup.zpowers σ)).mpr hCyclic⟩
    letI : CommGroup G := IsCyclic.commGroup
    let f_hom : AddChar (Additive G) ℂ → (G →* ℂ) := fun ψ =>
      { toFun := fun g => ψ (Additive.ofMul g)
        map_one' := by rw [ofMul_one, AddChar.map_zero_eq_one]
        map_mul' := fun x y => by rw [ofMul_mul, AddChar.map_add_eq_mul] }
    let χ_of : AddChar (Additive G) ℂ → (G →* ℂˣ) := fun ψ => (f_hom ψ).toHomUnits
    have hχ_val (ψ : AddChar (Additive G) ℂ) (ρ : G) :
        ((χ_of ψ ρ : ℂˣ) : ℂ) = ψ (Additive.ofMul ρ) :=
      MonoidHom.coe_toHomUnits (f_hom ψ) ρ
    have hχ_ne_one (ψ : AddChar (Additive G) ℂ) (hψ : ψ ≠ 0) : χ_of ψ ≠ 1 := by
      intro h_eq
      apply hψ
      ext a
      have h1 : ((χ_of ψ (Additive.toMul a) : ℂˣ) : ℂ) = ((1 : G →* ℂˣ) (Additive.toMul a) : ℂ) := by
        rw [h_eq]
      rw [hχ_val, ofMul_toMul, MonoidHom.one_apply, Units.val_one] at h1
      simpa using h1
    let ψ₀ : AddChar (Additive G) ℂ :=
      { toFun := fun a => (χ (Additive.toMul a) : ℂ)
        map_zero_eq_one' := by rw [toMul_zero, map_one, Units.val_one]
        map_add_eq_mul' := fun a b => by rw [toMul_add, map_mul, Units.val_mul] }
    have hχ_ψ₀ : χ_of ψ₀ = χ := by
      ext g
      rw [hχ_val]
      exact congrArg (fun u : ℂˣ => (u : ℂ)) (congrArg χ (toMul_ofMul g))
    have hψ₀_ne : ψ₀ ≠ 0 := by
      intro h0
      apply hχ
      rw [← hχ_ψ₀, h0]
      ext g
      rw [hχ_val, AddChar.zero_apply, MonoidHom.one_apply, Units.val_one]
    let A : Finset (AddChar (Additive G) ℂ) := Finset.univ.erase 0
    have hψ₀_mem : ψ₀ ∈ A := Finset.mem_erase.mpr ⟨hψ₀_ne, Finset.mem_univ ψ₀⟩
    let E_sum (φ : G →* ℂˣ) (s : ℝ) : ℂ :=
      ∑ ρ : G,
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
          -Complex.log (1 - (φ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))
    let D (ρ : G) (s : ℝ) : ℝ :=
      ∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
          IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
        ((Nat.card (NumberField.RingOfIntegers F ⧸
          (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))
    let P_sum (ψ : AddChar (Additive G) ℂ) (s : ℝ) : ℂ :=
      ∑ ρ : G, ψ (Additive.ofMul ρ) * (D ρ s : ℂ)
    let W (ψ : AddChar (Additive G) ℂ) : ℂ :=
      if h : ψ = 0 then 1 else (hConv (χ_of ψ) (hχ_ne_one ψ h)).choose
    have hW_tendsto (ψ : AddChar (Additive G) ℂ) (hψ : ψ ∈ A) :
        Filter.Tendsto (fun s : ℝ => Complex.exp (E_sum (χ_of ψ) s))
          (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds (W ψ)) := by
      have h_ne : ψ ≠ 0 := (Finset.mem_erase.mp hψ).1
      dsimp [W]
      rw [dif_neg h_ne]
      exact (hConv (χ_of ψ) (hχ_ne_one ψ h_ne)).choose_spec
    haveI : (nhdsWithin (1 : ℝ) (Set.Ioi 1)).NeBot := nhdsWithin_Ioi_neBot le_rfl
    have hW_ψ₀ : W ψ₀ = w := by
      have h1 := hW_tendsto ψ₀ hψ₀_mem
      rw [hχ_ψ₀] at h1
      exact tendsto_nhds_unique h1 hw
    have hProd_norm : Filter.Tendsto
        (fun s : ℝ => Real.exp ((∑ ψ ∈ A, E_sum (χ_of ψ) s).re))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1))
        (nhds ‖∏ ψ ∈ A, W ψ‖) := by
      have h1 := (continuous_norm.tendsto (∏ ψ ∈ A, W ψ)).comp
        (tendsto_finset_prod A (fun ψ hψ => hW_tendsto ψ hψ))
      refine h1.congr (fun s => ?_)
      change ‖∏ ψ ∈ A, Complex.exp (E_sum (χ_of ψ) s)‖ =
        Real.exp ((∑ ψ ∈ A, E_sum (χ_of ψ) s).re)
      rw [← Complex.exp_sum, Complex.norm_exp]
    let M (ψ : AddChar (Additive G) ℂ) : ℝ :=
      (bdd_on_Ioo_log_euler_sub_prime_sum (F := F) (E := E) (χ_of ψ)).choose
    have hM_bound (ψ : AddChar (Additive G) ℂ) (s : ℝ) (hs : s ∈ Set.Ioo (1 : ℝ) 2) :
        (P_sum ψ s).re - M ψ ≤ (E_sum (χ_of ψ) s).re := by
      have h1 := (bdd_on_Ioo_log_euler_sub_prime_sum (F := F) (E := E) (χ_of ψ)).choose_spec s hs
      rw [Finset.sum_sub_distrib] at h1
      have h_eq_P : (∑ ρ : G, (χ_of ψ ρ : ℂ) * (D ρ s : ℂ)) = P_sum ψ s := by
        dsimp only [P_sum]
        simp_rw [hχ_val]
      change ‖E_sum (χ_of ψ) s - ∑ ρ : G, (χ_of ψ ρ : ℂ) * (D ρ s : ℂ)‖ ≤ M ψ at h1
      rw [h_eq_P] at h1
      have h_re := (abs_le.mp ( (Complex.abs_re_le_norm (E_sum (χ_of ψ) s - P_sum ψ s)).trans h1 )).1
      rw [Complex.sub_re] at h_re
      linarith
    have hOrtho (s : ℝ) :
        (∑ ψ : AddChar (Additive G) ℂ, P_sum ψ s) =
          (Nat.card G : ℂ) * (D 1 s : ℂ) := by
      dsimp only [P_sum]
      rw [Finset.sum_comm]
      simp_rw [← Finset.sum_mul, AddChar.sum_apply_eq_ite]
      have h_iff (ρ : G) : Additive.ofMul ρ = 0 ↔ ρ = 1 := ofMul_eq_zero
      simp_rw [h_iff, ite_mul, zero_mul]
      rw [Finset.sum_ite_eq' Finset.univ (1 : G)]
      simp only [Finset.mem_univ, ↓reduceIte]
      have h_card : Fintype.card (Additive G) = Nat.card G := by
        rw [Nat.card_eq_fintype_card]
        exact Fintype.card_congr Additive.toMul
      rw [h_card]
    have hP0 (s : ℝ) : P_sum 0 s = ∑ ρ : G, (D ρ s : ℂ) := by
      dsimp only [P_sum]
      simp only [AddChar.zero_apply, one_mul]
    have hSumP_re (s : ℝ) :
        (∑ ψ ∈ A, P_sum ψ s).re = (Nat.card G : ℝ) * D 1 s - ∑ ρ : G, D ρ s := by
      have h_erase : (∑ ψ ∈ A, P_sum ψ s) = (∑ ψ : AddChar (Additive G) ℂ, P_sum ψ s) - P_sum 0 s :=
        Finset.sum_erase_eq_sub (Finset.mem_univ (0 : AddChar (Additive G) ℂ))
      rw [h_erase, hOrtho, hP0, ← Complex.ofReal_natCast, ← Complex.ofReal_mul, ← Complex.ofReal_sum,
        ← Complex.ofReal_sub, Complex.ofReal_re]
    have hUnr_le (s : ℝ) (hs : 1 < s) :
        ∑ ρ : G, D ρ s ≤
          ∑' q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            ((Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) : ℝ) ^ (-s)) := by
      rw [← unramified_prime_sum_eq_sum_frob_singleton σ hCyclic hs]
      obtain ⟨hIdeal_F, _⟩ := dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := F) hs
      obtain ⟨hPrime_F, _, _⟩ := tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_F
      let U : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)) :=
        { q | IsUnramifiedAtPrime F E q }
      have h_add := Summable.tsum_subtype_add_tsum_subtype_compl hPrime_F U
      have h_compl_nonneg : 0 ≤ ∑' q : ↑Uᶜ,
          ((Nat.card (NumberField.RingOfIntegers F ⧸ q.1.asIdeal) : ℝ) ^ (-s)) :=
        tsum_nonneg (fun q => Real.rpow_nonneg (Nat.cast_nonneg _) _)
      linarith
    have hEv_exp : ∀ᶠ s : ℝ in nhdsWithin (1 : ℝ) (Set.Ioi 1),
        Real.exp (B - ∑ ψ ∈ A, M ψ) ≤ Real.exp ((∑ ψ ∈ A, E_sum (χ_of ψ) s).re) := by
      filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2), hB] with s hs hBs
      apply Real.exp_le_exp.mpr
      have h1 : B ≤ (Nat.card G : ℝ) * D 1 s - ∑ ρ : G, D ρ s :=
        hBs.trans (sub_le_sub_left (hUnr_le s hs.1) _)
      rw [← hSumP_re s, Complex.re_sum] at h1
      have h2 : B - ∑ ψ ∈ A, M ψ ≤ (∑ ψ ∈ A, (P_sum ψ s).re) - ∑ ψ ∈ A, M ψ :=
        sub_le_sub_right h1 _
      rw [← Finset.sum_sub_distrib] at h2
      have h3 : ∑ ψ ∈ A, ((P_sum ψ s).re - M ψ) ≤ ∑ ψ ∈ A, (E_sum (χ_of ψ) s).re :=
        Finset.sum_le_sum (fun ψ hψ => hM_bound ψ s hs)
      rw [Complex.re_sum]
      exact h2.trans h3
    have hNorm_ge : Real.exp (B - ∑ ψ ∈ A, M ψ) ≤ ‖∏ ψ ∈ A, W ψ‖ :=
      ge_of_tendsto hProd_norm hEv_exp
    have hExp_pos : 0 < Real.exp (B - ∑ ψ ∈ A, M ψ) := Real.exp_pos _
    intro hw0
    have hW0 : W ψ₀ = 0 := hW_ψ₀.trans hw0
    have hProd0 : (∏ ψ ∈ A, W ψ) = 0 := Finset.prod_eq_zero hψ₀_mem hW0
    rw [hProd0, norm_zero] at hNorm_ge
    exact not_le_of_gt hExp_pos hNorm_ge
  obtain ⟨C₂, hC₂⟩ := h_s3
  obtain ⟨C₃, hC₃⟩ := h_s4
  refine h_s1 (C₃ - C₂) ?_
  filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2), hC₃] with s hs_Ioo hs_C₃
  rw [← h_s2 hs_Ioo.1]
  have h2 := hC₂ s hs_Ioo
  linarith

theorem bdd_on_Ioo_nontrivial_char_log_euler_sum {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (χ : (E ≃ₐ[F] E) →* ℂˣ)
    (hχ : χ ≠ 1) :
    ∃ M₂ : ℝ, ∀ s ∈ Set.Ioo (1 : ℝ) 2,
      ‖∑ ρ : E ≃ₐ[F] E,
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
          -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))‖ ≤ M₂ :=
by
  rcases exists_tendsto_cexp_nontrivial_char_log_euler_sum σ hCyclic χ hχ with ⟨w, hw⟩
  have hw_ne : w ≠ 0 :=
    tendsto_cexp_nontrivial_char_log_euler_sum_ne_zero σ hCyclic
      (fun ψ hψ => exists_tendsto_cexp_nontrivial_char_log_euler_sum σ hCyclic ψ hψ)
      χ hχ hw
  exact bdd_on_Ioo_of_continuousOn_Ioc_and_tendsto_cexp_ne_zero
    (fun s : ℝ =>
      ∑ ρ : E ≃ₐ[F] E,
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
          -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ))))
    (continuousOn_Ioc_char_log_euler_sum χ)
    ⟨w, hw_ne, hw⟩

theorem tendsto_cyclic_frob_diff_div_log_zero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (τ : E ≃ₐ[F] E) :
    Filter.Tendsto
      (fun s : ℝ =>
        ((∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {σ} },
          ((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) -
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {τ} },
          ((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s)))) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds 0) :=
by
  refine tendsto_diff_div_of_tendsto_nontrivial_char_sum_zero σ hCyclic
    (fun ρ s => ∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
        IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
      ((Nat.card (NumberField.RingOfIntegers F ⧸
        (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s)))
    (fun s => Real.log (1 / (s - 1)))
    (nhdsWithin (1 : ℝ) (Set.Ioi 1)) ?_ τ
  intro χ hχ
  rcases bdd_on_Ioo_log_euler_sub_prime_sum (F := F) (E := E) χ with ⟨M₁, hM₁⟩
  rcases bdd_on_Ioo_nontrivial_char_log_euler_sum σ hCyclic χ hχ with ⟨M₂, hM₂⟩
  have hBdd : ∃ M : ℝ, ∀ s ∈ Set.Ioo (1 : ℝ) 2,
      ‖∑ ρ : E ≃ₐ[F] E, (χ ρ : ℂ) * (((∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
          IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
        ((Nat.card (NumberField.RingOfIntegers F ⧸
          (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) : ℝ) : ℂ)‖ ≤ M := by
    refine ⟨M₂ + M₁, fun s hs => ?_⟩
    have h1 := hM₁ s hs
    have h2 := hM₂ s hs
    rw [Finset.sum_sub_distrib] at h1
    have h_eq : (∑ ρ : E ≃ₐ[F] E, (χ ρ : ℂ) * (((∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
          IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
        ((Nat.card (NumberField.RingOfIntegers F ⧸
          (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) : ℝ) : ℂ)) =
      (∑ ρ : E ≃ₐ[F] E,
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
          -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))) -
      ((∑ ρ : E ≃ₐ[F] E,
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
          -Complex.log (1 - (χ ρ : ℂ) * (((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s) : ℝ) : ℂ)))) -
      (∑ ρ : E ≃ₐ[F] E, (χ ρ : ℂ) * (((∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
          IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {ρ} },
        ((Nat.card (NumberField.RingOfIntegers F ⧸
          (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) : ℝ) : ℂ))) :=
      (sub_sub_cancel _ _).symm
    rw [h_eq]
    exact (norm_sub_le _ _).trans (add_le_add h2 h1)
  rcases hBdd with ⟨M, hM⟩
  rw [tendsto_zero_iff_norm_tendsto_zero]
  have h_sub : Filter.Tendsto (fun s : ℝ => s - 1) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin 0 (Set.Ioi 0)) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · have h0 : Filter.Tendsto (fun s : ℝ => s - 1) (nhds (1 : ℝ)) (nhds ((1 : ℝ) - 1)) :=
        (continuous_id.tendsto (1 : ℝ)).sub_const (1 : ℝ)
      rw [sub_self] at h0
      exact h0.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact sub_pos.mpr (Set.mem_Ioi.mp hs)
  have h_inv : Filter.Tendsto (fun s : ℝ => 1 / (s - 1)) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
    simp only [one_div]
    exact tendsto_inv_nhdsGT_zero.comp h_sub
  have h_log : Filter.Tendsto (fun s : ℝ => Real.log (1 / (s - 1))) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop :=
    Real.tendsto_log_atTop.comp h_inv
  have h_lim : Filter.Tendsto (fun s : ℝ => max M 0 / Real.log (1 / (s - 1))) (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    have h1 := (tendsto_inv_atTop_zero.comp h_log).const_mul (max M 0)
    rw [mul_zero] at h1
    simp only [div_eq_mul_inv]
    exact h1
  refine squeeze_zero' (eventually_nhdsWithin_of_forall fun s _ => norm_nonneg _) ?_ h_lim
  filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)] with s hs
  have hs1 : 0 < s - 1 := sub_pos.mpr hs.1
  have hs2 : s - 1 < 1 := by linarith [hs.2]
  have h_one_lt : 1 < 1 / (s - 1) := (one_lt_div hs1).mpr hs2
  have h_log_pos : 0 < Real.log (1 / (s - 1)) := Real.log_pos h_one_lt
  rw [norm_div, Complex.norm_real, Real.norm_of_nonneg h_log_pos.le]
  exact div_le_div_of_nonneg_right ((hM s hs).trans (le_max_left M 0)) h_log_pos.le

theorem chebotarev_cyclic_singleton {F E : Type u} [Field F] [NumberField F]
    [Field E] [NumberField E] [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ) :
    HasDirichletDensity
      { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
          IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {σ} }
      (1 / (Nat.card (E ≃ₐ[F] E) : ℝ)) :=
by
  apply hasDirichletDensity_of_tendsto_real
  have h_unr : Filter.Tendsto
      (fun s : ℝ =>
        (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
            IsUnramifiedAtPrime F E q },
          ((Nat.card (NumberField.RingOfIntegers F ⧸
            (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) /
        Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds 1) :=
    tendsto_unramified_prime_sum_div_log tendsto_univ_prime_sum_div_log
  have h_sum : Filter.Tendsto
      (fun s : ℝ =>
        ∑ τ : E ≃ₐ[F] E,
          (((∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
              IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {σ} },
            ((Nat.card (NumberField.RingOfIntegers F ⧸
              (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s))) -
          (∑' q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
              IsUnramifiedAtPrime F E q ∧ FrobeniusClassAt F E q ⊆ {τ} },
            ((Nat.card (NumberField.RingOfIntegers F ⧸
              (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)).asIdeal) : ℝ) ^ (-s)))) /
          Real.log (1 / (s - 1))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (∑ _τ : E ≃ₐ[F] E, (0 : ℝ))) :=
    tendsto_finset_sum Finset.univ (fun τ _ => tendsto_cyclic_frob_diff_div_log_zero σ hCyclic τ)
  rw [Finset.sum_const_zero] at h_sum
  have h_comb := (h_sum.add h_unr).div_const (Nat.card (E ≃ₐ[F] E) : ℝ)
  rw [zero_add] at h_comb
  refine h_comb.congr' (eventually_nhdsWithin_of_forall fun s hs => ?_)
  dsimp only
  have hs1 : 1 < s := hs
  have h_part := unramified_prime_sum_eq_sum_frob_singleton σ hCyclic hs1
  have h_card_pos : 0 < Nat.card (E ≃ₐ[F] E) := Nat.card_pos
  have h_card_ne : (Nat.card (E ≃ₐ[F] E) : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr h_card_pos.ne'
  rw [← Finset.sum_div, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ,
    ← Nat.card_eq_fintype_card, nsmul_eq_mul, h_part, ← add_div, sub_add_cancel,
    mul_div_assoc, mul_div_cancel_left₀ _ h_card_ne]

theorem chebotarev_density_theorem {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
    (C : Set (L ≃ₐ[K] L))
    (hC : ∀ ρ ∈ C, ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C) :
    HasDirichletDensity
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C }
      ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
by
  exact hasDirichletDensity_of_conjClass_reduction C hC
    (fun p hp => frobeniusClassAt_nonempty_and_isConj p hp)
    (fun σ _ => chebotarev_deuring_reduction σ
      (fun σ' hσ' => chebotarev_cyclic_singleton σ' hσ'))
