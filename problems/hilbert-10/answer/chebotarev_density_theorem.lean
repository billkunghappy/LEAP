    let d : ℕ := Nat.card (E ≃ₐ[F] E)
    let α : NumberField.InfinitePlace E → NumberField.InfinitePlace E := fun w_E => σ⁻¹ • w_E
    let π : NumberField.InfinitePlace E → NumberField.InfinitePlace F :=
      fun w_E => w_E.comap (algebraMap F E)
