        exact hP_not_I₃ (Ideal.dvd_span_singleton.mpr hm_P)
      have hP_good : GoodIdeal P.asIdeal := by
        refine ⟨P.ne_bot, fun p hp_dvd => ?_⟩
        have h_rel_P :
