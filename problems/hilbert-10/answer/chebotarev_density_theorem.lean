    let z : ι → ℂ := fun P => ϕ P.asIdeal * (x P : ℂ)
    have hx_bounds : ∀ P : ι, 0 ≤ x P ∧ x P ≤ 1 / 2 ∧ (x P) ^ 2 ≤ y P := by
      intro P
      have h_norm_eq : Ideal.absNorm P.asIdeal = Nat.card (R_K ⧸ P.asIdeal) := by
        rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
      have h_gt1 : 1 < Nat.card (R_K ⧸ P.asIdeal) := by
        rw [← h_norm_eq]
        exact NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm P
      have h_ge2_nat : 2 ≤ Nat.card (R_K ⧸ P.asIdeal) := h_gt1
      have h_2 : (2 : ℝ) ≤ (Nat.card (R_K ⧸ P.asIdeal) : ℝ) := by
        exact_mod_cast h_ge2_nat
      have h_1 : (1 : ℝ) ≤ (Nat.card (R_K ⧸ P.asIdeal) : ℝ) := by linarith
      have h_0 : (0 : ℝ) ≤ (Nat.card (R_K ⧸ P.asIdeal) : ℝ) := by linarith
      refine ⟨Real.rpow_nonneg h_0 (-s), ?_, ?_⟩
      · have h_le_m1 : x P ≤ (Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le h_1 (by linarith)
        have h_m1_le_half : (Nat.card (R_K ⧸ P.asIdeal) : ℝ) ^ (-1 : ℝ) ≤
