    let I₁ : Ideal (NumberField.RingOfIntegers L) :=
      Ideal.relNorm (NumberField.RingOfIntegers L) D_ML
    have hI₁_ne : I₁ ≠ ⊥ :=
      (Ideal.relNorm_eq_bot_iff (R := NumberField.RingOfIntegers L)).not.mpr hD_ML
    let D_EF : Ideal (NumberField.RingOfIntegers E) :=
      differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)
    have hD_EF : D_EF ≠ ⊥ := differentIdeal_ne_bot
    let N_EF : Ideal (NumberField.RingOfIntegers F) :=
      Ideal.relNorm (NumberField.RingOfIntegers F) D_EF
    have hN_EF : N_EF ≠ ⊥ :=
      (Ideal.relNorm_eq_bot_iff (R := NumberField.RingOfIntegers F)).not.mpr hD_EF
    let I₂ : Ideal (NumberField.RingOfIntegers L) :=
      Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L)) N_EF
    have hI₂_ne : I₂ ≠ ⊥ :=
      (Ideal.map_eq_bot_iff_of_injective
        (FaithfulSMul.algebraMap_injective
          (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L))).not.mpr hN_EF
    let I₃ : Ideal (NumberField.RingOfIntegers L) :=
      Ideal.span {(m : NumberField.RingOfIntegers L)}
    have hm_ne_zero : (m : NumberField.RingOfIntegers L) ≠ 0 :=
      Nat.cast_ne_zero.mpr (by omega)
    have hI₃_ne : I₃ ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hm_ne_zero
    let 𝔅 : Ideal (NumberField.RingOfIntegers L) := I₁ * I₂ * I₃
    have h𝔅_ne : 𝔅 ≠ ⊥ := by
      change I₁ * I₂ * I₃ ≠ ⊥
      rw [← Submodule.zero_eq_bot] at hI₁_ne hI₂_ne hI₃_ne ⊢
      exact mul_ne_zero (mul_ne_zero hI₁_ne hI₂_ne) hI₃_ne
    have h𝔅_primes :
        ∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
