          (γ.restrictScalars F) • ζ - ζ ^ (Ideal.absNorm P.asIdeal) ∈ Q := by
        have h1 := hγ_arith ζ
        rw [hQ_under, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply] at h1
        exact h1
      exact (hΦ_frob_snd (γ.restrictScalars F) (Ideal.absNorm P.asIdeal) Q hQ_prime hm_not_Q h_frob_ζ).symm
    
    let K' := IntermediateField.fixedField H
    have h_s2 :
        ∀ (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)),
