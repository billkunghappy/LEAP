      intro P hP_not_dvd
      obtain ⟨hP_unram, hP_frob⟩ := h𝔅_primes P hP_not_dvd
      haveI : P.asIdeal.IsPrime := P.isPrime
      haveI : P.asIdeal.IsMaximal := P.isMaximal
      have h_local :
          ∀ (P' : Ideal (NumberField.RingOfIntegers K')),
            P'.IsPrime →
            P'.LiesOver P.asIdeal →
            Ideal.ramificationIdx
              (algebraMap (NumberField.RingOfIntegers L) (NumberField.RingOfIntegers K'))
