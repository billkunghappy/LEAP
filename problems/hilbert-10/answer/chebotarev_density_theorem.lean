      intro J hJ
      exact congrArg Subtype.val (e_ufm.apply_symm_apply ⟨J, hJ⟩)
    let F_fib : ℕ → Type u := fun k => { f : ι →₀ ℕ // N_prod f = k }
    have hFin_k : ∀ k : ℕ, Fintype (F_fib k) := by
