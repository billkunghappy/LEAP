    let d_K' : ℕ := Module.finrank L K'
    have hd_pos : 0 < d_K' := Module.finrank_pos
    have hd_ne : d_K' ≠ 0 := hd_pos.ne'
    let U : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) :=
