import Mathlib
import Hilbert10Defs
set_option maxHeartbeats 4000000

/-! ### Statement (originally `chebotarev_density_theorem.lean`) -/

/--
**Chebotarev density theorem.** Let `L/K` be a finite Galois extension of number
fields with group `G` and `C ⊆ G` stable under conjugation. The set of primes `𝔭` of
`K` unramified in `L` with `Frob_𝔭 ⊆ C` has Dirichlet density `#C / #G`.
-/

theorem frobeniusClassAt_nonempty_and_isConj {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hp : IsUnramifiedAtPrime K L p) :
    (FrobeniusClassAt K L p).Nonempty ∧
    ∀ g₁ ∈ FrobeniusClassAt K L p, ∀ g₂ : L ≃ₐ[K] L,
      (g₂ ∈ FrobeniusClassAt K L p ↔ ∃ τ : L ≃ₐ[K] L, τ * g₁ * τ⁻¹ = g₂) :=
by
  have h_frob_iff : ∀ g : L ≃ₐ[K] L, g ∈ FrobeniusClassAt K L p ↔
      ∃ Q : Ideal (NumberField.RingOfIntegers L), Q.IsPrime ∧
        Ideal.under (NumberField.RingOfIntegers K) Q = p.asIdeal ∧
        IsArithFrobAt (NumberField.RingOfIntegers K) g Q := by
    intro g
    simp only [FrobeniusClassAt, Set.mem_setOf_eq]
    refine exists_congr (fun Q => and_congr_right (fun _ => and_congr_right (fun h_under => ?_)))
    constructor
    · intro h x
      have hx := h x (g • x) rfl
      rwa [h_under]
    · intro h x z hz
      have hzx : z = g • x := Subtype.ext hz
      rw [hzx, ← h_under]
      exact h x
  haveI : p.asIdeal.IsPrime := p.isPrime
  haveI : p.asIdeal.IsMaximal := p.isMaximal
  refine ⟨?_, ?_⟩
  · obtain ⟨Q, hQ⟩ := Ideal.nonempty_primesOver (S := NumberField.RingOfIntegers L) p.asIdeal
    have hQ_prime : Q.IsPrime := hQ.1
    have hQ_over : Q.LiesOver p.asIdeal := hQ.2
    have h_under : Ideal.under (NumberField.RingOfIntegers K) Q = p.asIdeal :=
      hQ_over.over.symm
    haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q p.asIdeal
    obtain ⟨g, hg⟩ := IsArithFrobAt.exists_of_isInvariant
      (NumberField.RingOfIntegers K) (L ≃ₐ[K] L) Q
    exact ⟨g, (h_frob_iff g).mpr ⟨Q, hQ_prime, h_under, hg⟩⟩
  · intro g₁ hg₁ g₂
    rw [h_frob_iff] at hg₁ ⊢
    rcases hg₁ with ⟨Q₁, hQ₁_prime, h_under₁, hg₁⟩
    haveI : Q₁.LiesOver p.asIdeal := ⟨h_under₁.symm⟩
    constructor
    · rintro ⟨Q₂, hQ₂_prime, h_under₂, hg₂⟩
      haveI : Q₂.LiesOver p.asIdeal := ⟨h_under₂.symm⟩
      obtain ⟨τ, hτ⟩ := Ideal.exists_smul_eq_of_isGaloisGroup p.asIdeal Q₁ Q₂ (L ≃ₐ[K] L)
      have hg₁' : IsArithFrobAt (NumberField.RingOfIntegers K) (τ * g₁ * τ⁻¹) Q₂ := by
        rw [← hτ]
        exact hg₁.conj τ
      have h_mem := hg₁'.mul_inv_mem_inertia hg₂
      haveI : Q₂.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₂ p.asIdeal
      letI := Ideal.Quotient.field p.asIdeal
      letI := Ideal.Quotient.field Q₂
      haveI : PerfectField (NumberField.RingOfIntegers K ⧸ p.asIdeal) := PerfectField.ofFinite
      haveI : Algebra.IsSeparable (NumberField.RingOfIntegers K ⧸ p.asIdeal)
        (NumberField.RingOfIntegers L ⧸ Q₂) :=
        Algebra.IsAlgebraic.isSeparable_of_perfectField
      have h_card : Nat.card ((Submodule.toAddSubgroup Q₂).inertia (L ≃ₐ[K] L)) = 1 := by
        rw [Ideal.card_inertia_eq_ramificationIdxIn p.asIdeal p.ne_bot Q₂,
          Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal Q₂ (L ≃ₐ[K] L)]
        exact hp Q₂ hQ₂_prime h_under₂
      have h_bot : (Submodule.toAddSubgroup Q₂).inertia (L ≃ₐ[K] L) = ⊥ :=
        Subgroup.card_eq_one.mp h_card
      rw [h_bot, Subgroup.mem_bot, mul_inv_eq_one] at h_mem
      exact ⟨τ, h_mem⟩
    · rintro ⟨τ, rfl⟩
      open scoped Pointwise in
      exact ⟨τ • Q₁, Ideal.IsPrime.smul τ, (Ideal.LiesOver.smul τ).over.symm, hg₁.conj τ⟩

theorem hasDirichletDensity_of_conjClass_reduction {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
    (C : Set (L ≃ₐ[K] L))
    (hC : ∀ ρ ∈ C, ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C)
    (hFrob : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      IsUnramifiedAtPrime K L p →
        (FrobeniusClassAt K L p).Nonempty ∧
        ∀ g₁ ∈ FrobeniusClassAt K L p, ∀ g₂ : L ≃ₐ[K] L,
          (g₂ ∈ FrobeniusClassAt K L p ↔ ∃ τ : L ≃ₐ[K] L, τ * g₁ * τ⁻¹ = g₂))
    (hConj : ∀ σ ∈ C, HasDirichletDensity
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          IsUnramifiedAtPrime K L p ∧
          FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } }
      ((Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } : ℝ) /
        (Nat.card (L ≃ₐ[K] L) : ℝ))) :
    HasDirichletDensity
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C }
      ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
by
  have h_empty : HasDirichletDensity
      (∅ : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) 0 := by
    unfold HasDirichletDensity dirichletQuot
    simp only [tsum_empty, ENNReal.zero_div, ENNReal.ofReal_zero]
    exact tendsto_const_nhds
  have h_union : ∀ {S₁ S₂ : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))}
      {d₁ d₂ : ℝ}, Disjoint S₁ S₂ → 0 ≤ d₁ → 0 ≤ d₂ →
      HasDirichletDensity S₁ d₁ → HasDirichletDensity S₂ d₂ →
      HasDirichletDensity (S₁ ∪ S₂) (d₁ + d₂) := by
    intro S₁ S₂ d₁ d₂ hDisj hd₁ hd₂ h₁ h₂
    unfold HasDirichletDensity
    have h_eq : dirichletQuot (S₁ ∪ S₂) = fun s => dirichletQuot S₁ s + dirichletQuot S₂ s := by
      ext s
      unfold dirichletQuot
      let f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ENNReal :=
        fun p => ENNReal.ofReal
          ((Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) : ℝ) ^ (-s))
      have htsum : (∑' p : ↑(S₁ ∪ S₂), f p.1) = (∑' p : ↑S₁, f p.1) + (∑' p : ↑S₂, f p.1) :=
        Summable.tsum_union_disjoint hDisj ENNReal.summable ENNReal.summable
      change (∑' p : ↑(S₁ ∪ S₂), f p.1) / ENNReal.ofReal (Real.log (1 / (s - 1))) =
        (∑' p : ↑S₁, f p.1) / ENNReal.ofReal (Real.log (1 / (s - 1))) +
        (∑' p : ↑S₂, f p.1) / ENNReal.ofReal (Real.log (1 / (s - 1)))
      rw [htsum, ENNReal.add_div]
    rw [h_eq, ENNReal.ofReal_add hd₁ hd₂]
    exact Filter.Tendsto.add h₁ h₂
  suffices h_ind : ∀ (n : ℕ) (C : Set (L ≃ₐ[K] L)),
      Nat.card C = n →
      (∀ ρ ∈ C, ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C) →
      (∀ σ ∈ C, HasDirichletDensity
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧
            FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } }
        ((Nat.card { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } : ℝ) /
          (Nat.card (L ≃ₐ[K] L) : ℝ))) →
      HasDirichletDensity
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C }
        ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) by
    exact h_ind (Nat.card C) C rfl hC hConj
  intro n
  induction' n using Nat.strong_induction_on with n ih
  intro C hn hC_ind hConj_ind
  rcases Set.eq_empty_or_nonempty C with rfl | ⟨σ, hσ⟩
  · have hS_empty :
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧
            FrobeniusClassAt K L p ⊆ (∅ : Set (L ≃ₐ[K] L)) } = ∅ := by
      rw [Set.eq_empty_iff_forall_notMem]
      rintro p ⟨hp, hsub⟩
      obtain ⟨⟨g₁, hg₁⟩, _⟩ := hFrob p hp
      exact hsub hg₁
    have h_card_zero :
        ((Nat.card (∅ : Set (L ≃ₐ[K] L)) : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) = 0 := by
      simp
    rw [hS_empty, h_card_zero]
    exact h_empty
  · let Cl : Set (L ≃ₐ[K] L) := { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ }
    let C' : Set (L ≃ₐ[K] L) := C \ Cl
    have hCl_sub : Cl ⊆ C := by
      rintro ρ ⟨τ, rfl⟩
      exact hC_ind σ hσ τ
    have hσ_Cl : σ ∈ Cl := ⟨1, by group⟩
    have hC'_stable : ∀ ρ ∈ C', ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C' := by
      rintro ρ ⟨hρC, hρCl⟩ τ
      refine ⟨hC_ind ρ hρC τ, ?_⟩
      rintro ⟨τ₁, hτ₁⟩
      apply hρCl
      refine ⟨τ⁻¹ * τ₁, ?_⟩
      calc (τ⁻¹ * τ₁) * σ * (τ⁻¹ * τ₁)⁻¹
          = τ⁻¹ * (τ₁ * σ * τ₁⁻¹) * τ := by group
        _ = τ⁻¹ * (τ * ρ * τ⁻¹) * τ := by rw [hτ₁]
        _ = ρ := by group
    have h_union_eq : Cl ∪ C' = C := Set.union_diff_cancel hCl_sub
    have h_disj_Cl : Disjoint Cl C' := disjoint_sdiff_self_right
    have h_ncard : C.ncard = Cl.ncard + C'.ncard := by
      conv_lhs => rw [← h_union_eq]
      exact Set.ncard_union_eq h_disj_Cl (Set.toFinite _) (Set.toFinite _)
    have h_card_add : Nat.card C = Nat.card Cl + Nat.card C' := by
      simp only [Nat.card_coe_set_eq, h_ncard]
    have h_Cl_pos : 0 < Nat.card Cl := by
      haveI : Nonempty Cl := ⟨⟨σ, hσ_Cl⟩⟩
      exact Nat.card_pos
    have h_card_lt : Nat.card C' < n := by omega
    have hConj_C' : ∀ τ ∈ C', HasDirichletDensity
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧
            FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ γ : L ≃ₐ[K] L, γ * τ * γ⁻¹ = ρ } }
        ((Nat.card { ρ : L ≃ₐ[K] L | ∃ γ : L ≃ₐ[K] L, γ * τ * γ⁻¹ = ρ } : ℝ) /
          (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
      fun τ hτ => hConj_ind τ hτ.1
    have h_dens_C' : HasDirichletDensity
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C' }
        ((Nat.card C' : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
      ih (Nat.card C') h_card_lt C' rfl hC'_stable hConj_C'
    have h_dens_Cl : HasDirichletDensity
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ Cl }
        ((Nat.card Cl : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
      hConj_ind σ hσ
    have hS_union :
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C } =
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ Cl } ∪
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C' } := by
      ext p
      simp only [Set.mem_setOf_eq, Set.mem_union]
      constructor
      · rintro ⟨hp, hsub⟩
        obtain ⟨⟨g₁, hg₁⟩, hconj⟩ := hFrob p hp
        by_cases hg₁_Cl : g₁ ∈ Cl
        · rcases hg₁_Cl with ⟨τ₀, hτ₀⟩
          left
          refine ⟨hp, fun g₂ hg₂ => ?_⟩
          obtain ⟨τ₁, hτ₁⟩ := (hconj g₁ hg₁ g₂).mp hg₂
          refine ⟨τ₁ * τ₀, ?_⟩
          calc (τ₁ * τ₀) * σ * (τ₁ * τ₀)⁻¹
              = τ₁ * (τ₀ * σ * τ₀⁻¹) * τ₁⁻¹ := by group
            _ = τ₁ * g₁ * τ₁⁻¹ := by rw [hτ₀]
            _ = g₂ := hτ₁
        · right
          refine ⟨hp, fun g₂ hg₂ => ⟨hsub hg₂, ?_⟩⟩
          rintro ⟨τ₀, hτ₀⟩
          obtain ⟨τ₁, hτ₁⟩ := (hconj g₁ hg₁ g₂).mp hg₂
          apply hg₁_Cl
          refine ⟨τ₁⁻¹ * τ₀, ?_⟩
          calc (τ₁⁻¹ * τ₀) * σ * (τ₁⁻¹ * τ₀)⁻¹
              = τ₁⁻¹ * (τ₀ * σ * τ₀⁻¹) * τ₁ := by group
            _ = τ₁⁻¹ * (τ₁ * g₁ * τ₁⁻¹) * τ₁ := by rw [hτ₀, ← hτ₁]
            _ = g₁ := by group
      · rintro (⟨hp, hsub⟩ | ⟨hp, hsub⟩)
        · exact ⟨hp, Set.Subset.trans hsub hCl_sub⟩
        · exact ⟨hp, Set.Subset.trans hsub Set.diff_subset⟩
    have hS_disj : Disjoint
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ Cl }
        { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
            IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C' } := by
      rw [Set.disjoint_left]
      rintro p ⟨hp, hsub₁⟩ ⟨_, hsub₂⟩
      obtain ⟨⟨g₁, hg₁⟩, _⟩ := hFrob p hp
      exact (hsub₂ hg₁).2 (hsub₁ hg₁)
    have h_dens_sum := h_union hS_disj
      (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
      (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
      h_dens_Cl h_dens_C'
    have h_real_add :
        ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) =
        ((Nat.card Cl : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) +
        ((Nat.card C' : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) := by
      rw [← add_div, ← Nat.cast_add, ← h_card_add]
    rw [hS_union, h_real_add]
    exact h_dens_sum

theorem hasDirichletDensity_degree_one_unramified_restriction {K F L : Type u}
    [Field K] [NumberField K] [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra K F] [Algebra F L] [Algebra K L] [IsScalarTower K F L]
    (T : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)))
    (d : ℝ)
    (hT : HasDirichletDensity T d) :
    HasDirichletDensity
      { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) |
          q ∈ T ∧
          ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p.asIdeal ∧
            IsUnramifiedAtPrime K L p ∧
            Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal) =
              Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) }
      d :=
by
  classical
  let R_K := NumberField.RingOfIntegers K
  let R_F := NumberField.RingOfIntegers F
  let R_L := NumberField.RingOfIntegers L
  let T₀ : Set (IsDedekindDomain.HeightOneSpectrum R_F) :=
    { q : IsDedekindDomain.HeightOneSpectrum R_F |
        q ∈ T ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum R_K,
          Ideal.under R_K q.asIdeal = p.asIdeal ∧
          IsUnramifiedAtPrime K L p ∧
          Nat.card (R_F ⧸ q.asIdeal) = Nat.card (R_K ⧸ p.asIdeal) }
  let B₁ : Set (IsDedekindDomain.HeightOneSpectrum R_F) :=
    { q | ¬ ∃ p : IsDedekindDomain.HeightOneSpectrum R_K,
        Ideal.under R_K q.asIdeal = p.asIdeal ∧ IsUnramifiedAtPrime K L p }
  let B₂ : Set (IsDedekindDomain.HeightOneSpectrum R_F) :=
    { q | ∃ p : IsDedekindDomain.HeightOneSpectrum R_K,
        Ideal.under R_K q.asIdeal = p.asIdeal ∧
        Nat.card (R_F ⧸ q.asIdeal) ≠ Nat.card (R_K ⧸ p.asIdeal) }
  have hSub : T₀ ⊆ T := fun _ h => h.1
  have hDiff : T \ T₀ ⊆ B₁ ∪ B₂ := by
    intro q ⟨hq_T, hq_not⟩
    by_cases h : ∃ p : IsDedekindDomain.HeightOneSpectrum R_K,
        Ideal.under R_K q.asIdeal = p.asIdeal ∧ IsUnramifiedAtPrime K L p
    · rcases h with ⟨p, hp_under, hp_unr⟩
      exact Or.inr ⟨p, hp_under, fun h_card => hq_not ⟨hq_T, p, hp_under, hp_unr, h_card⟩⟩
    · exact Or.inl h
  have hB₁ : B₁.Finite := by
    let U : Set (IsDedekindDomain.HeightOneSpectrum R_K) := { p | IsUnramifiedAtPrime K L p }
    let D : Ideal R_L := differentIdeal R_K R_L
    have hD : D ≠ ⊥ := differentIdeal_ne_bot
    let S_D : Set (IsDedekindDomain.HeightOneSpectrum R_L) := { v | v.asIdeal ∣ D }
    have hS_D : S_D.Finite := Ideal.finite_factors hD
    have h_ex : ∀ p : ↑Uᶜ, ∃ v : ↑S_D, Ideal.under R_K v.1.asIdeal = p.1.asIdeal := by
      intro ⟨p, hp⟩
      change ¬ IsUnramifiedAtPrime K L p at hp
      rw [IsUnramifiedAtPrime] at hp
      push_neg at hp
      rcases hp with ⟨P, hP_prime, h_under, h_ram⟩
      haveI : P.IsPrime := hP_prime
      haveI : p.asIdeal.IsMaximal := p.isMaximal
      have h_map : Ideal.map (algebraMap R_K R_L) p.asIdeal ≤ P :=
        Ideal.map_le_iff_le_comap.mpr h_under.symm.le
      have h_le2 : Ideal.map (algebraMap R_K R_L) p.asIdeal ≤ P ^ 2 :=
        (Ideal.ramificationIdx_ne_one_iff h_map).mp h_ram
      have h_dvd2 : P ^ 2 ∣ Ideal.map (algebraMap R_K R_L) p.asIdeal :=
        Ideal.dvd_iff_le.mpr h_le2
      have h_dvdD : P ∣ D := by
        simpa using pow_sub_one_dvd_differentIdeal R_K P 2 p.ne_bot h_dvd2
      have hP_ne_bot : P ≠ ⊥ := by
        intro h_bot
        rw [h_bot, ← Submodule.zero_eq_bot, zero_dvd_iff, Submodule.zero_eq_bot] at h_dvdD
        exact hD h_dvdD
      exact ⟨⟨⟨P, hP_prime, hP_ne_bot⟩, h_dvdD⟩, h_under⟩
    choose φ hφ using h_ex
    have hφ_inj : Function.Injective φ := by
      intro p₁ p₂ hp
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      rw [← hφ p₁, hp, hφ p₂]
    haveI : Finite ↑S_D := hS_D.to_subtype
    haveI : Finite ↑Uᶜ := Finite.of_injective φ hφ_inj
    let π : IsDedekindDomain.HeightOneSpectrum R_F → IsDedekindDomain.HeightOneSpectrum R_K :=
      fun q =>
        haveI : q.asIdeal.IsPrime := q.isPrime
        ⟨Ideal.under R_K q.asIdeal, Ideal.IsPrime.under R_K q.asIdeal,
          Ideal.under_ne_bot R_K q.ne_bot⟩
    have hπ_ram : ∀ q : ↑B₁, π q.1 ∈ Uᶜ := by
      intro ⟨q, hq⟩ h_unr
      exact hq ⟨π q, rfl, h_unr⟩
    have hπ_over : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        haveI : (π q).asIdeal.IsMaximal := (π q).isMaximal
        q.asIdeal ∈ primesOverFinset (π q).asIdeal R_F := by
      intro q
      letI : (π q).asIdeal.IsMaximal := (π q).isMaximal
      rw [mem_primesOverFinset_iff (π q).ne_bot R_F]
      exact ⟨q.isPrime, ⟨rfl⟩⟩
    let Ψ : ↑B₁ → Σ x : ↑Uᶜ, ↑(
        haveI : x.1.asIdeal.IsMaximal := x.1.isMaximal
        primesOverFinset x.1.asIdeal R_F) :=
      fun q => ⟨⟨π q.1, hπ_ram q⟩, ⟨q.1.asIdeal, hπ_over q.1⟩⟩
    have hΨ_inj : Function.Injective Ψ := by
      intro q₁ q₂ h
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      have h2 : (Ψ q₁).2.1 = (Ψ q₂).2.1 := by
        rw [h]
      exact h2
    haveI : Finite ↑B₁ := Finite.of_injective Ψ hΨ_inj
    exact Set.finite_coe_iff.mp inferInstance
  have hB₂ : Summable (fun q : ↑B₂ => ((Nat.card (R_F ⧸ q.1.asIdeal) : ℝ)⁻¹)) := by
    let d_F : ℕ := Module.finrank ℚ F
    have hd_F_pos : 0 < d_F := Module.finrank_pos
    let π_Z : IsDedekindDomain.HeightOneSpectrum R_F → IsDedekindDomain.HeightOneSpectrum ℤ :=
      fun q =>
        haveI : q.asIdeal.IsPrime := q.isPrime
        ⟨Ideal.under ℤ q.asIdeal, Ideal.IsPrime.under ℤ q.asIdeal,
          Ideal.under_ne_bot ℤ q.ne_bot⟩
    let ℓ : IsDedekindDomain.HeightOneSpectrum R_F → ℕ :=
      fun q => Ideal.absNorm (π_Z q).asIdeal
    have h_mem_Z : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        q.asIdeal ∈ primesOverFinset (π_Z q).asIdeal R_F := by
      intro q
      letI : (π_Z q).asIdeal.IsMaximal := (π_Z q).isMaximal
      rw [mem_primesOverFinset_iff (π_Z q).ne_bot R_F]
      exact ⟨q.isPrime, ⟨rfl⟩⟩
    have h_card_Z : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        (primesOverFinset (π_Z q).asIdeal R_F).card ≤ d_F := by
      intro q
      letI : (π_Z q).asIdeal.IsMaximal := (π_Z q).isMaximal
      exact Ideal.card_primesOverFinset_le_finrank R_F ℚ F (π_Z q).ne_bot
    let fibIdx : Ideal ℤ → Ideal R_F → ℕ := fun I P =>
      if h : P ∈ primesOverFinset I R_F then ((primesOverFinset I R_F).equivFin ⟨P, h⟩).1 else 0
    have h_fibIdx_lt : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        fibIdx (π_Z q).asIdeal q.asIdeal < d_F := by
      intro q
      dsimp only [fibIdx]
      rw [dif_pos (h_mem_Z q)]
      exact lt_of_lt_of_le
        (((primesOverFinset (π_Z q).asIdeal R_F).equivFin ⟨q.asIdeal, h_mem_Z q⟩).2)
        (h_card_Z q)
    let idx : IsDedekindDomain.HeightOneSpectrum R_F → ℕ :=
      fun q => d_F * ℓ q + fibIdx (π_Z q).asIdeal q.asIdeal
    have h_idx_inj : Function.Injective idx := by
      intro q₁ q₂ h
      dsimp only [idx] at h
      have hi₁ : fibIdx (π_Z q₁).asIdeal q₁.asIdeal < d_F := h_fibIdx_lt q₁
      have hi₂ : fibIdx (π_Z q₂).asIdeal q₂.asIdeal < d_F := h_fibIdx_lt q₂
      have h_ell : ℓ q₁ = ℓ q₂ := by nlinarith
      have h_i_val : fibIdx (π_Z q₁).asIdeal q₁.asIdeal = fibIdx (π_Z q₂).asIdeal q₂.asIdeal := by
        nlinarith
      have h_pZ : (π_Z q₁).asIdeal = (π_Z q₂).asIdeal := by
        rw [← Int.ideal_span_absNorm_eq_self (π_Z q₁).asIdeal,
            ← Int.ideal_span_absNorm_eq_self (π_Z q₂).asIdeal]
        change Ideal.span {(ℓ q₁ : ℤ)} = Ideal.span {(ℓ q₂ : ℤ)}
        rw [h_ell]
      rw [← h_pZ] at h_i_val
      dsimp only [fibIdx] at h_i_val
      have h_mem₂ : q₂.asIdeal ∈ primesOverFinset (π_Z q₁).asIdeal R_F := h_pZ ▸ h_mem_Z q₂
      rw [dif_pos (h_mem_Z q₁), dif_pos h_mem₂] at h_i_val
      have h_fin_eq : ((primesOverFinset (π_Z q₁).asIdeal R_F).equivFin ⟨q₁.asIdeal, h_mem_Z q₁⟩) =
          ((primesOverFinset (π_Z q₁).asIdeal R_F).equivFin ⟨q₂.asIdeal, h_mem₂⟩) :=
        Fin.ext h_i_val
      have h_sub_eq := ((primesOverFinset (π_Z q₁).asIdeal R_F).equivFin).injective h_fin_eq
      apply IsDedekindDomain.HeightOneSpectrum.ext
      exact congrArg Subtype.val h_sub_eq
    have h_dom : Summable (fun x : ↑B₂ => ((d_F + d_F : ℝ) ^ 2) * (((idx x.1 : ℝ) ^ 2)⁻¹)) := by
      have h_base : Summable (fun n : ℕ => ((d_F + d_F : ℝ) ^ 2) * (((n : ℝ) ^ 2)⁻¹)) :=
        (Real.summable_nat_pow_inv.mpr one_lt_two).mul_left ((d_F + d_F : ℝ) ^ 2)
      exact h_base.comp_injective (h_idx_inj.comp Subtype.val_injective)
    refine Summable.of_nonneg_of_le (fun x => inv_nonneg.mpr (Nat.cast_nonneg _)) (fun x => ?_) h_dom
    rcases x with ⟨q, p, hp_under, h_ne⟩
    haveI : q.asIdeal.LiesOver p.asIdeal := ⟨hp_under.symm⟩
    haveI : p.asIdeal.IsMaximal := p.isMaximal
    haveI : q.asIdeal.IsPrime := q.isPrime
    have h_card_q : Nat.card (R_F ⧸ q.asIdeal) = Ideal.absNorm q.asIdeal := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    have h_card_p : Nat.card (R_K ⧸ p.asIdeal) = Ideal.absNorm p.asIdeal := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
    have h_pow : Ideal.absNorm q.asIdeal =
        (Ideal.absNorm p.asIdeal) ^ (p.asIdeal.inertiaDeg q.asIdeal) :=
      Ideal.absNorm_eq_pow_inertiaDeg_of_liesOver q.asIdeal p.asIdeal p.isPrime p.ne_bot
    have hf_pos : 0 < p.asIdeal.inertiaDeg q.asIdeal := Ideal.inertiaDeg_pos p.asIdeal q.asIdeal
    have hf_ne_one : p.asIdeal.inertiaDeg q.asIdeal ≠ 1 := by
      intro hf1
      apply h_ne
      rw [h_card_q, h_card_p, h_pow, hf1, pow_one]
    have hf_ge_two : 2 ≤ p.asIdeal.inertiaDeg q.asIdeal := by omega
    have hp_gt_one : 1 < Ideal.absNorm p.asIdeal :=
      NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm p
    have hp_sq_le : (Ideal.absNorm p.asIdeal) ^ 2 ≤ Ideal.absNorm q.asIdeal := by
      rw [h_pow]
      exact Nat.pow_le_pow_right hp_gt_one.le hf_ge_two
    have h_under_Z : (π_Z q).asIdeal = Ideal.under ℤ p.asIdeal := by
      change Ideal.under ℤ q.asIdeal = Ideal.under ℤ p.asIdeal
      rw [← hp_under, Ideal.under_under]
    have h_dvd : ℓ q ∣ Ideal.absNorm p.asIdeal := by
      dsimp only [ℓ]
      rw [h_under_Z]
      exact Int.absNorm_under_dvd_absNorm p.asIdeal
    have h_ell_le : ℓ q ≤ Ideal.absNorm p.asIdeal := Nat.le_of_dvd (by omega) h_dvd
    have h_ell_pos : 0 < ℓ q := Nat.pos_of_dvd_of_pos h_dvd (by omega)
    have h_ell_sq_le : (ℓ q) ^ 2 ≤ Nat.card (R_F ⧸ q.asIdeal) := by
      rw [h_card_q]
      exact le_trans (Nat.pow_le_pow_left h_ell_le 2) hp_sq_le
    have h_mul_pos : 0 < d_F * ℓ q := Nat.mul_pos hd_F_pos h_ell_pos
    have h_idx_pos : 0 < idx q := by
      dsimp only [idx]
      omega
    have h_dF_le_mul : d_F ≤ d_F * ℓ q := Nat.le_mul_of_pos_right d_F h_ell_pos
    have h_idx_le : idx q ≤ (d_F + d_F) * ℓ q := by
      dsimp only [idx]
      have hi := h_fibIdx_lt q
      rw [add_mul]
      omega
    have h_idx_sq_le : (idx q) ^ 2 ≤ (d_F + d_F) ^ 2 * Nat.card (R_F ⧸ q.asIdeal) := by
      calc
        (idx q) ^ 2 ≤ ((d_F + d_F) * ℓ q) ^ 2 := Nat.pow_le_pow_left h_idx_le 2
        _ = (d_F + d_F) ^ 2 * (ℓ q) ^ 2 := mul_pow (d_F + d_F) (ℓ q) 2
        _ ≤ (d_F + d_F) ^ 2 * Nat.card (R_F ⧸ q.asIdeal) :=
            Nat.mul_le_mul_left ((d_F + d_F) ^ 2) h_ell_sq_le
    have h_idx_sq_pos_real : (0 : ℝ) < ((idx q : ℝ) ^ 2) := by
      positivity
    have h_card_pos_real : (0 : ℝ) < (Nat.card (R_F ⧸ q.asIdeal) : ℝ) := by
      have : 0 < Nat.card (R_F ⧸ q.asIdeal) := by
        rw [h_card_q]
        exact lt_of_lt_of_le (by positivity) hp_sq_le
      exact_mod_cast this
    have h_real_le : ((idx q : ℝ) ^ 2) ≤ ((d_F + d_F : ℝ) ^ 2) * (Nat.card (R_F ⧸ q.asIdeal) : ℝ) := by
      exact_mod_cast h_idx_sq_le
    rw [← div_eq_mul_inv, le_div_iff₀ h_idx_sq_pos_real, inv_mul_le_iff₀ h_card_pos_real]
    linarith
  let f : ℝ → IsDedekindDomain.HeightOneSpectrum R_F → ENNReal :=
    fun s q => ENNReal.ofReal ((Nat.card (R_F ⧸ q.asIdeal) : ℝ) ^ (-s))
  let g : IsDedekindDomain.HeightOneSpectrum R_F → ℝ :=
    fun q => ((Nat.card (R_F ⧸ q.asIdeal) : ℝ)⁻¹)
  have h_add : ∀ s : ℝ, dirichletQuot T s = dirichletQuot T₀ s + dirichletQuot (T \ T₀) s := by
    intro s
    unfold dirichletQuot
    have h_union : (∑' q : ↑(T₀ ∪ (T \ T₀)), f s q.1) =
        (∑' q : ↑T₀, f s q.1) + (∑' q : ↑(T \ T₀), f s q.1) :=
      Summable.tsum_union_disjoint (f := f s) disjoint_sdiff_self_right
        ENNReal.summable ENNReal.summable
    rw [Set.union_diff_cancel hSub] at h_union
    dsimp only [f] at h_union
    rw [h_union, ENNReal.add_div]
  let M₁ : ENNReal := ∑' q : ↑B₁, ENNReal.ofReal (g q.1)
  let M₂ : ENNReal := ∑' q : ↑B₂, ENNReal.ofReal (g q.1)
  let M : ENNReal := M₁ + M₂
  have hM₁_eq : ENNReal.ofReal (∑' q : ↑B₁, g q.1) = M₁ :=
    ENNReal.ofReal_tsum_of_nonneg (fun q => inv_nonneg.mpr (Nat.cast_nonneg _)) (hB₁.summable g)
  have hM₂_eq : ENNReal.ofReal (∑' q : ↑B₂, g q.1) = M₂ :=
    ENNReal.ofReal_tsum_of_nonneg (fun q => inv_nonneg.mpr (Nat.cast_nonneg _)) hB₂
  have hM₁_ne_top : M₁ ≠ ⊤ := by rw [← hM₁_eq]; exact ENNReal.ofReal_ne_top
  have hM₂_ne_top : M₂ ≠ ⊤ := by rw [← hM₂_eq]; exact ENNReal.ofReal_ne_top
  have hM_ne_top : M ≠ ⊤ := ENNReal.add_ne_top.mpr ⟨hM₁_ne_top, hM₂_ne_top⟩
  have h_num_le : ∀ s : ℝ, 1 < s → (∑' q : ↑(T \ T₀), f s q.1) ≤ M := by
    intro s hs
    have h_pt : ∀ q : IsDedekindDomain.HeightOneSpectrum R_F,
        f s q ≤ ENNReal.ofReal (g q) := by
      intro q
      dsimp only [f, g]
      apply ENNReal.ofReal_le_ofReal
      have h_norm : 1 < Ideal.absNorm q.asIdeal :=
        NumberField.RingOfIntegers.HeightOneSpectrum.one_lt_absNorm q
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply] at h_norm
      have h_one_le : (1 : ℝ) ≤ (Nat.card (R_F ⧸ q.asIdeal) : ℝ) := by
        exact_mod_cast h_norm.le
      have h_exp : -s ≤ (-1 : ℝ) := by linarith
      calc
        (Nat.card (R_F ⧸ q.asIdeal) : ℝ) ^ (-s)
          ≤ (Nat.card (R_F ⧸ q.asIdeal) : ℝ) ^ (-1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le h_one_le h_exp
        _ = ((Nat.card (R_F ⧸ q.asIdeal) : ℝ)⁻¹) :=
            Real.rpow_neg_one _
    calc
      (∑' q : ↑(T \ T₀), f s q.1)
        ≤ ∑' q : ↑(T \ T₀), ENNReal.ofReal (g q.1) := ENNReal.tsum_le_tsum (fun q => h_pt q.1)
      _ ≤ ∑' q : ↑(B₁ ∪ B₂), ENNReal.ofReal (g q.1) :=
          ENNReal.tsum_mono_subtype (fun q => ENNReal.ofReal (g q)) hDiff
      _ ≤ (∑' q : ↑B₁, ENNReal.ofReal (g q.1)) + (∑' q : ↑B₂, ENNReal.ofReal (g q.1)) :=
          ENNReal.tsum_union_le (fun q => ENNReal.ofReal (g q)) B₁ B₂
      _ = M := rfl
  have h_sub_lim : Filter.Tendsto (fun s : ℝ => s - 1)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin (0 : ℝ) (Set.Ioi 0)) := by
    refine tendsto_nhdsWithin_iff.mpr
      ⟨?_, eventually_nhdsWithin_of_forall (fun s hs => Set.mem_Ioi.mpr (sub_pos.mpr hs))⟩
    have h_c : ContinuousAt (fun s : ℝ => s - 1) 1 := continuousAt_id.sub continuousAt_const
    simpa [sub_self] using tendsto_nhdsWithin_of_tendsto_nhds h_c.tendsto
  have h_inv_lim : Filter.Tendsto (fun s : ℝ => 1 / (s - 1))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
    simpa only [one_div] using tendsto_inv_nhdsGT_zero.comp h_sub_lim
  have h_log_lim : Filter.Tendsto (fun s : ℝ => Real.log (1 / (s - 1)))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop :=
    Real.tendsto_log_atTop.comp h_inv_lim
  have h_den_lim : Filter.Tendsto (fun s : ℝ => ENNReal.ofReal (Real.log (1 / (s - 1))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds ⊤) :=
    ENNReal.tendsto_ofReal_atTop.comp h_log_lim
  have h_upper_lim : Filter.Tendsto
      (fun s : ℝ => M / ENNReal.ofReal (Real.log (1 / (s - 1))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    simpa only [ENNReal.div_top] using ENNReal.Tendsto.const_div h_den_lim (Or.inr hM_ne_top)
  have h_rem_lim : Filter.Tendsto (dirichletQuot (T \ T₀))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds h_upper_lim
      (eventually_nhdsWithin_of_forall (fun _ _ => zero_le _))
      (eventually_nhdsWithin_of_forall (fun s hs => ?_))
    exact ENNReal.div_le_div_right (h_num_le s hs) _
  have h_diff_lim : Filter.Tendsto
      (fun s : ℝ => dirichletQuot T s - dirichletQuot (T \ T₀) s)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds (ENNReal.ofReal d)) := by
    simpa only [tsub_zero] using ENNReal.Tendsto.sub hT h_rem_lim (Or.inl ENNReal.ofReal_ne_top)
  change HasDirichletDensity T₀ d
  unfold HasDirichletDensity
  refine h_diff_lim.congr' ?_
  filter_upwards [h_rem_lim.eventually_ne ENNReal.zero_ne_top] with s hs_ne_top
  rw [h_add s, ENNReal.add_sub_cancel_right hs_ne_top]

theorem deuring_degree_one_fiber_eq_card_arithFrobAt {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [IsGalois K L]
    (σ : L ≃ₐ[K] L)
    (σ' : L ≃ₐ[IntermediateField.fixedField (Subgroup.zpowers σ)] L)
    (hσ' : ∀ x : L, σ' x = σ x) :
    (∀ q : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers (IntermediateField.fixedField (Subgroup.zpowers σ))),
      q ∈ { q : IsDedekindDomain.HeightOneSpectrum
              (NumberField.RingOfIntegers (IntermediateField.fixedField (Subgroup.zpowers σ))) |
            (IsUnramifiedAtPrime (IntermediateField.fixedField (Subgroup.zpowers σ)) L q ∧
              FrobeniusClassAt (IntermediateField.fixedField (Subgroup.zpowers σ)) L q ⊆ {σ'}) ∧
            ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p.asIdeal ∧
              IsUnramifiedAtPrime K L p ∧
              Nat.card (NumberField.RingOfIntegers
                  (IntermediateField.fixedField (Subgroup.zpowers σ)) ⧸ q.asIdeal) =
                Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) } →
      ∃ p ∈ { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          IsUnramifiedAtPrime K L p ∧
          FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } },
        Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p.asIdeal ∧
        Nat.card (NumberField.RingOfIntegers
            (IntermediateField.fixedField (Subgroup.zpowers σ)) ⧸ q.asIdeal) =
          Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal)) ∧
    (∀ p ∈ { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        IsUnramifiedAtPrime K L p ∧
        FrobeniusClassAt K L p ⊆ { ρ : L ≃ₐ[K] L | ∃ τ : L ≃ₐ[K] L, τ * σ * τ⁻¹ = ρ } },
      Nat.card { q : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers (IntermediateField.fixedField (Subgroup.zpowers σ))) |
        q ∈ { q : IsDedekindDomain.HeightOneSpectrum
                (NumberField.RingOfIntegers (IntermediateField.fixedField (Subgroup.zpowers σ))) |
              (IsUnramifiedAtPrime (IntermediateField.fixedField (Subgroup.zpowers σ)) L q ∧
                FrobeniusClassAt (IntermediateField.fixedField (Subgroup.zpowers σ)) L q ⊆ {σ'}) ∧
              ∃ p' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
                Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p'.asIdeal ∧
                IsUnramifiedAtPrime K L p' ∧
                Nat.card (NumberField.RingOfIntegers
                    (IntermediateField.fixedField (Subgroup.zpowers σ)) ⧸ q.asIdeal) =
                  Nat.card (NumberField.RingOfIntegers K ⧸ p'.asIdeal) } ∧
        Ideal.under (NumberField.RingOfIntegers K) q.asIdeal = p.asIdeal } =
      Nat.card { Q : Ideal (NumberField.RingOfIntegers L) |
        Q.IsPrime ∧
        Ideal.under (NumberField.RingOfIntegers K) Q = p.asIdeal ∧
        IsArithFrobAt (NumberField.RingOfIntegers K) σ Q }) :=
by
  open scoped Pointwise in
  have h_frob_class : ∀ {F E : Type u} [Field F] [NumberField F]
      [Field E] [NumberField E] [Algebra F E] [IsGalois F E]
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))
      (hp : IsUnramifiedAtPrime F E p),
      (FrobeniusClassAt F E p).Nonempty ∧
      ∀ g₁ ∈ FrobeniusClassAt F E p, ∀ g₂ : E ≃ₐ[F] E,
        (g₂ ∈ FrobeniusClassAt F E p ↔ ∃ τ : E ≃ₐ[F] E, τ * g₁ * τ⁻¹ = g₂) := by
    intro F E _ _ _ _ _ _ p hp
    have h_iff : ∀ (g : E ≃ₐ[F] E) (Q : Ideal (NumberField.RingOfIntegers E)),
        Ideal.under (NumberField.RingOfIntegers F) Q = p.asIdeal →
        ((∀ x z : NumberField.RingOfIntegers E, (z : E) = g (x : E) →
          z - x ^ (Nat.card (NumberField.RingOfIntegers F ⧸ p.asIdeal)) ∈ Q) ↔
          IsArithFrobAt (NumberField.RingOfIntegers F) g Q) := by
      intro g Q h_under
      constructor
      · intro h x
        have hx := h x (g • x) rfl
        rwa [h_under]
      · intro h x z hz
        have hzx : z = g • x := Subtype.ext hz
        rw [hzx, ← h_under]
        exact h x
    haveI : p.asIdeal.IsPrime := p.isPrime
    haveI : p.asIdeal.IsMaximal := p.isMaximal
    constructor
    · obtain ⟨⟨Q, hQ_prime, hQ_over⟩⟩ :=
        @Ideal.nonempty_primesOver (NumberField.RingOfIntegers F) _
          (NumberField.RingOfIntegers E) _ _ _ _ _ _ p.asIdeal p.isPrime
      have h_under : Ideal.under (NumberField.RingOfIntegers F) Q = p.asIdeal :=
        (Ideal.LiesOver.over (P := Q) (p := p.asIdeal)).symm
      haveI : Q.IsMaximal :=
        Ideal.IsMaximal.of_liesOver_isMaximal Q p.asIdeal
      obtain ⟨g, hg⟩ :=
        IsArithFrobAt.exists_of_isInvariant (NumberField.RingOfIntegers F) (E ≃ₐ[F] E) Q
      exact ⟨g, Q, hQ_prime, h_under, (h_iff g Q h_under).mpr hg⟩
    · intro g₁ hg₁ g₂
      rcases hg₁ with ⟨Q₁, hQ₁_prime, h_under₁, hg₁_cong⟩
      have hg₁_frob : IsArithFrobAt (NumberField.RingOfIntegers F) g₁ Q₁ :=
        (h_iff g₁ Q₁ h_under₁).mp hg₁_cong
      haveI : Q₁.IsPrime := hQ₁_prime
      haveI : Q₁.LiesOver p.asIdeal := ⟨h_under₁.symm⟩
      constructor
      · intro hg₂
        rcases hg₂ with ⟨Q₂, hQ₂_prime, h_under₂, hg₂_cong⟩
        have hg₂_frob : IsArithFrobAt (NumberField.RingOfIntegers F) g₂ Q₂ :=
          (h_iff g₂ Q₂ h_under₂).mp hg₂_cong
        haveI : Q₂.IsPrime := hQ₂_prime
