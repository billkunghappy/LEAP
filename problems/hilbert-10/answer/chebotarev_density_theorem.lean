    have h_good_tendsto :
        Filter.Tendsto
          (fun s : ℝ =>
            (∑' P : U,
              ((Nat.card (NumberField.RingOfIntegers L ⧸
                (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)).asIdeal) : ℝ) ^ (-s))) /
            Real.log (1 / (s - 1)))
          (nhdsWithin (1 : ℝ) (Set.Ioi 1))
          (nhds 1) := by
      have hUniv := tendsto_univ_prime_sum_div_log (F := L)
      have hUc_fin : Uᶜ.Finite := by
        refine (Ideal.finite_factors h𝔅_ne).subset (fun P hP => ?_)
        change ¬ ¬ (P.asIdeal ∣ 𝔅) at hP
        exact not_not.mp hP
      haveI : Finite ↑Uᶜ := hUc_fin.to_subtype
      letI : Fintype ↑Uᶜ := Fintype.ofFinite ↑Uᶜ
      let f : ℝ → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L) → ℝ :=
        fun s P => (Nat.card (NumberField.RingOfIntegers L ⧸ P.asIdeal) : ℝ) ^ (-s)
      have h_num : Filter.Tendsto (fun s : ℝ => ∑' P : ↑Uᶜ, f s P.1)
          (nhdsWithin (1 : ℝ) (Set.Ioi 1))
          (nhds (∑ P ∈ (Finset.univ : Finset ↑Uᶜ), f 1 P.1)) := by
        simp_rw [tsum_fintype]
        refine tendsto_finset_sum Finset.univ (fun P _ => ?_)
        haveI : P.1.asIdeal.IsMaximal := P.1.isMaximal
        have hc_pos : 0 < Nat.card (NumberField.RingOfIntegers L ⧸ P.1.asIdeal) := Nat.card_pos
        have hc_ne : (Nat.card (NumberField.RingOfIntegers L ⧸ P.1.asIdeal) : ℝ) ≠ 0 :=
          Nat.cast_ne_zero.mpr hc_pos.ne'
        exact tendsto_nhdsWithin_of_tendsto_nhds
          ((ContinuousAt.rpow continuousAt_const continuousAt_id.neg (Or.inl hc_ne)).tendsto)
      have h_sub : Filter.Tendsto (fun s : ℝ => s - 1)
          (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin (0 : ℝ) (Set.Ioi 0)) := by
        refine tendsto_nhdsWithin_iff.mpr
          ⟨?_, eventually_nhdsWithin_of_forall (fun s hs => Set.mem_Ioi.mpr (sub_pos.mpr hs))⟩
        have h_c : ContinuousAt (fun s : ℝ => s - 1) 1 := continuousAt_id.sub continuousAt_const
        simpa [sub_self] using tendsto_nhdsWithin_of_tendsto_nhds h_c.tendsto
      have h_inv : Filter.Tendsto (fun s : ℝ => 1 / (s - 1))
          (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
        simpa only [one_div] using tendsto_inv_nhdsGT_zero.comp h_sub
      have h_den : Filter.Tendsto (fun s : ℝ => Real.log (1 / (s - 1)))
          (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop :=
        Real.tendsto_log_atTop.comp h_inv
      have h_bad : Filter.Tendsto
          (fun s : ℝ => (∑' P : ↑Uᶜ, f s P.1) / Real.log (1 / (s - 1)))
          (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) :=
        Filter.Tendsto.div_atTop h_num h_den
      have h_diff : Filter.Tendsto
          (fun s : ℝ =>
            (∑' P, f s P) / Real.log (1 / (s - 1)) -
            (∑' P : ↑Uᶜ, f s P.1) / Real.log (1 / (s - 1)))
          (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 1) := by
        simpa only [sub_zero] using hUniv.sub h_bad
      refine h_diff.congr' ?_
      filter_upwards [hUniv.eventually_ne one_ne_zero] with s hs_ne
      have h_tsum_ne : (∑' P, f s P) ≠ 0 := by
        intro h_zero
        apply hs_ne
        simp [f, h_zero]
      have h_sum : Summable (f s) := by
        by_contra h_not_sum
        exact h_tsum_ne (tsum_eq_zero_of_not_summable h_not_sum)
      have h_split := Summable.tsum_subtype_add_tsum_subtype_compl h_sum U
      dsimp only [U, f] at h_split ⊢
      rw [← sub_div, ← eq_sub_of_add_eq h_split]
    have hd_le : d_K' ≤ 1 := by
      let π : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K') →
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L) :=
        fun P' =>
          haveI : P'.asIdeal.IsPrime := P'.isPrime
          ⟨Ideal.under (NumberField.RingOfIntegers L) P'.asIdeal,
            Ideal.IsPrime.under (NumberField.RingOfIntegers L) P'.asIdeal,
            Ideal.under_ne_bot (NumberField.RingOfIntegers L) P'.ne_bot⟩
      let T_K' : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K')) :=
        { P' | ¬ ((π P').asIdeal ∣ 𝔅) }
      let proj : T_K' → U := fun P' => ⟨π P'.1, P'.2⟩
      have h_fib_equiv : ∀ P : U,
          { x : T_K' // proj x = P } ≃
            { P' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K') //
              Ideal.under (NumberField.RingOfIntegers L) P'.asIdeal = P.1.asIdeal } :=
        fun P =>
          { toFun := fun x =>
              ⟨x.1.1, congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal (congrArg Subtype.val x.2)⟩
            invFun := fun y =>
              have h_pi : π y.1 = P.1 := IsDedekindDomain.HeightOneSpectrum.ext y.2
              have h_mem_T : y.1 ∈ T_K' := by
                change ¬ ((π y.1).asIdeal ∣ 𝔅)
                rw [h_pi]
                exact P.2
              ⟨⟨y.1, h_mem_T⟩, Subtype.ext h_pi⟩
            left_inv := fun _ => Subtype.ext (Subtype.ext rfl)
            right_inv := fun _ => Subtype.ext rfl }
      have h_fib_card : ∀ P : U, Nat.card { x : T_K' // proj x = P } = d_K' := by
        intro P
        rw [Nat.card_congr (h_fib_equiv P)]
        exact (h_s2 P.1 P.2).1
      have h_ineq_s : ∀ s : ℝ, 1 < s →
          (d_K' : ℝ) *
            (∑' P : U,
              ((Nat.card (NumberField.RingOfIntegers L ⧸ P.1.asIdeal) : ℝ) ^ (-s))) ≤
          ∑' P' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'),
            ((Nat.card (NumberField.RingOfIntegers K' ⧸ P'.asIdeal) : ℝ) ^ (-s)) := by
        intro s hs
        let f_s : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L) → ℝ :=
          fun P => (Nat.card (NumberField.RingOfIntegers L ⧸ P.asIdeal) : ℝ) ^ (-s)
        let g_s : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K') → ℝ :=
          fun P' => (Nat.card (NumberField.RingOfIntegers K' ⧸ P'.asIdeal) : ℝ) ^ (-s)
        have hIdeal_K' := (dedekindZeta_re_eq_tsum_ideal_absNorm_rpow (F := K') hs).1
        have h_sum_g : Summable g_s :=
          (tsum_ideal_absNorm_rpow_eq_tsum_finsupp_prod hIdeal_K').1
        have h_le_univ : (∑' x : T_K', g_s x.1) ≤ ∑' P', g_s P' :=
          Summable.tsum_subtype_le g_s T_K' (fun _ => Real.rpow_nonneg (Nat.cast_nonneg _) (-s)) h_sum_g
        have h_fib_fin : ∀ P : U, Finite { x : T_K' // proj x = P } := by
          intro P
          apply Nat.finite_of_card_ne_zero
          rw [h_fib_card P]
          exact hd_ne
        have h_sum_T : Summable (fun x : T_K' => g_s x.1) := h_sum_g.subtype T_K'
        have h_sum_sigma :
            Summable (fun u : (P : U) × { x : T_K' // proj x = P } => g_s u.2.1.1) := by
          change Summable ((fun x : T_K' => g_s x.1) ∘ (Equiv.sigmaFiberEquiv proj))
          exact h_sum_T.comp_injective (Equiv.sigmaFiberEquiv proj).injective
        have h_eq_T :
            (∑' x : T_K', g_s x.1) = (d_K' : ℝ) * ∑' P : U, f_s P.1 := by
          rw [← (Equiv.sigmaFiberEquiv proj).tsum_eq (fun x : T_K' => g_s x.1)]
          change (∑' u : (P : U) × { x : T_K' // proj x = P }, g_s u.2.1.1) =
            (d_K' : ℝ) * ∑' P : U, f_s P.1
          rw [Summable.tsum_sigma' (fun P => Summable.of_finite) h_sum_sigma]
          have h_inner : ∀ P : U,
              (∑' x : { x : T_K' // proj x = P }, g_s x.1.1) = (d_K' : ℝ) * f_s P.1 := by
            intro P
            haveI : Finite { x : T_K' // proj x = P } := h_fib_fin P
            letI : Fintype { x : T_K' // proj x = P } := Fintype.ofFinite _
            rw [tsum_fintype]
            have h_const : ∀ x : { x : T_K' // proj x = P }, g_s x.1.1 = f_s P.1 := by
              intro x
              dsimp [g_s, f_s]
              have h_under : Ideal.under (NumberField.RingOfIntegers L) x.1.1.asIdeal = P.1.asIdeal :=
                congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal (congrArg Subtype.val x.2)
              rw [(h_s2 P.1 P.2).2 x.1.1 h_under]
            simp_rw [h_const]
            rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
              h_fib_card P, nsmul_eq_mul]
          simp_rw [h_inner]
          exact tsum_mul_left
        linarith
      have h_lhs :
          Filter.Tendsto
            (fun s : ℝ =>
              (d_K' : ℝ) *
                ((∑' P : U,
                  ((Nat.card (NumberField.RingOfIntegers L ⧸ P.1.asIdeal) : ℝ) ^ (-s))) /
                Real.log (1 / (s - 1))))
            (nhdsWithin (1 : ℝ) (Set.Ioi 1))
            (nhds ((d_K' : ℝ) * 1)) :=
        h_good_tendsto.const_mul (d_K' : ℝ)
      rw [mul_one] at h_lhs
      have h_rhs := tendsto_univ_prime_sum_div_log (F := K')
      have h_real_le : (d_K' : ℝ) ≤ 1 := by
        refine le_of_tendsto_of_tendsto h_lhs h_rhs ?_
        filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1 : ℝ) < 2)] with s hs
        have hs1 : 0 < s - 1 := sub_pos.mpr hs.1
        have hs2 : s - 1 < 1 := by linarith [hs.2]
        have h_one_lt : 1 < 1 / (s - 1) := (one_lt_div hs1).mpr hs2
        have h_log_pos : 0 < Real.log (1 / (s - 1)) := Real.log_pos h_one_lt
        rw [← mul_div_assoc]
        exact div_le_div_of_nonneg_right (h_ineq_s s hs.1) h_log_pos.le
      exact_mod_cast h_real_le
    have hd_eq : d_K' = 1 := le_antisymm hd_le hd_pos
    have h_card_H : Nat.card H = Nat.card (M ≃ₐ[L] M) := by
      have h_mul := Module.finrank_mul_finrank L K' M
      change d_K' * Module.finrank K' M = Module.finrank L M at h_mul
      rw [hd_eq, one_mul, IntermediateField.finrank_fixedField_eq_card H,
        ← IsGalois.card_aut_eq_finrank L M] at h_mul
      exact h_mul
    have hH_top : H = ⊤ := Subgroup.eq_top_of_card_eq H h_card_H
    have hγ₀_mem : γ₀ ∈ H := by
      rw [hH_top]
      exact Subgroup.mem_top γ₀
    rcases hγ₀_mem with ⟨B, ⟨hB_ne, hB_good⟩, hB_norm⟩
    exact ⟨B, hB_ne, hB_good, hB_norm⟩
  
  let C_S : Subgroup (M ≃ₐ[F] M) := Subgroup.zpowers τ₀
  let K : IntermediateField F M := IntermediateField.fixedField C_S
  have hτ₀_fix : τ₀ ∈ K.fixingSubgroup := by
    rw [IntermediateField.fixingSubgroup_fixedField C_S]
    exact Subgroup.mem_zpowers τ₀
  let γ₀ : M ≃ₐ[K] M := K.fixingSubgroupEquiv ⟨τ₀, hτ₀_fix⟩
  have hγ₀_res : γ₀.restrictScalars F = τ₀ := by
    ext x
    rfl
  obtain ⟨B, hB_ne, hB_good, hB_norm⟩ := h_main_L K γ₀
  rw [hγ₀_res] at hB_norm
  let K₀ : Ideal (NumberField.RingOfIntegers F) :=
    Ideal.relNorm (NumberField.RingOfIntegers F) B
  have hK₀_ne : K₀ ≠ ⊥ :=
    (Ideal.relNorm_eq_bot_iff (R := NumberField.RingOfIntegers F)).not.mpr hB_ne
  have hK₀_norm : (Ideal.absNorm K₀ : ZMod m) = (((Φ τ₀).2 : (ZMod m)ˣ) : ZMod m) := by
    have h_abs : Ideal.absNorm K₀ = Ideal.absNorm B :=
      Ideal.absNorm_relNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K) B
    rw [h_abs, hB_norm]
  refine ⟨K₀, hK₀_ne, hB_good, hK₀_norm, fun D _ hτ₀_D => ?_⟩
  have h_le : IntermediateField.fixedField D ≤ K :=
    IntermediateField.fixedField_le (Subgroup.zpowers_le.mpr hτ₀_D)
  letI : Algebra (IntermediateField.fixedField D) K :=
    (IntermediateField.inclusion h_le).toAlgebra
  haveI : IsScalarTower F (IntermediateField.fixedField D) K :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let J₀ : Ideal (NumberField.RingOfIntegers (IntermediateField.fixedField D)) :=
    Ideal.relNorm (NumberField.RingOfIntegers (IntermediateField.fixedField D)) B
  have hJ₀_ne : J₀ ≠ ⊥ :=
    (Ideal.relNorm_eq_bot_iff
      (R := NumberField.RingOfIntegers (IntermediateField.fixedField D))).not.mpr hB_ne
  have hJ₀_rel : Ideal.relNorm (NumberField.RingOfIntegers F) J₀ = K₀ :=
    Ideal.relNorm_relNorm
      (NumberField.RingOfIntegers F)
      (NumberField.RingOfIntegers (IntermediateField.fixedField D)) B
  exact ⟨J₀, hJ₀_ne, hJ₀_rel⟩

theorem exists_prime_over_relNorm_eq_self_of_fixedField {F E M : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Field M] [NumberField M] [Algebra F E] [IsGalois F E]
    [Algebra F M] [IsGalois F M] [Algebra E M] [IsScalarTower F E M]
    (σ : E ≃ₐ[F] E)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_map : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ x : NumberField.RingOfIntegers E,
        (σ ^ (e q)) • x - x ^ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ∈
          Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal)
    (m : ℕ)
    (ζ : NumberField.RingOfIntegers M)
    (Φ : (M ≃ₐ[F] M) ≃* (E ≃ₐ[F] E) × (ZMod m)ˣ)
    (hΦ_fst : ∀ τ : M ≃ₐ[F] M, (Φ τ).1 = AlgEquiv.restrictNormalHom E τ)
    (hΦ_frob_snd : ∀ (τ : M ≃ₐ[F] M) (k : ℕ) (Q : Ideal (NumberField.RingOfIntegers M)),
      Q.IsPrime →
      (m : NumberField.RingOfIntegers M) ∉ Q →
      τ • ζ - ζ ^ k ∈ Q →
      (((Φ τ).2 : (ZMod m)ˣ) : ZMod m) = (k : ZMod m))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))
    (hq_unr : IsUnramifiedAtPrime F E q)
    (hq_m : (m : NumberField.RingOfIntegers F) ∉ q.asIdeal)
    (D : Subgroup (M ≃ₐ[F] M)) [D.Normal]
    (hD_frob : ∀ τ : M ≃ₐ[F] M,
      (Φ τ).1 = σ ^ (e q) →
      (((Φ τ).2 : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm q.asIdeal : ZMod m) →
      τ ∈ D) :
    ∃ P_q : Ideal (NumberField.RingOfIntegers (IntermediateField.fixedField D)),
      P_q ≠ ⊥ ∧
      Ideal.relNorm (NumberField.RingOfIntegers F) P_q = q.asIdeal :=
by
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let R_M := NumberField.RingOfIntegers M
  let K := IntermediateField.fixedField D
  let R_K := NumberField.RingOfIntegers K
  haveI : Normal F E := IsGalois.to_normal
  haveI : q.asIdeal.IsPrime := q.isPrime
  haveI : q.asIdeal.IsMaximal := q.isMaximal
  obtain ⟨Q, hQ_prime, hQ_over⟩ :=
    Ideal.nonempty_primesOver (R := R_F) (S := R_M) q.asIdeal
  haveI : Q.IsPrime := hQ_prime
  haveI : Q.LiesOver q.asIdeal := hQ_over
  haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q q.asIdeal
  have hQ_under : Ideal.under R_F Q = q.asIdeal :=
    (Ideal.LiesOver.over (P := Q) (p := q.asIdeal)).symm
  obtain ⟨τ, hτ_arith⟩ :=
    IsArithFrobAt.exists_of_isInvariant R_F (M ≃ₐ[F] M) Q
  have hτ_fst : (Φ τ).1 = σ ^ (e q) := by
    let Q_E : Ideal R_E := Ideal.under R_E Q
    have hQE_prime : Q_E.IsPrime := Ideal.IsPrime.under R_E Q
    haveI : Q_E.IsPrime := hQE_prime
    have hQE_under : Ideal.under R_F Q_E = q.asIdeal := by
      dsimp [Q_E]
      rw [Ideal.under_under (B := R_E) Q, hQ_under]
    haveI : Q_E.LiesOver q.asIdeal := ⟨hQE_under.symm⟩
    haveI : Q_E.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q_E q.asIdeal
    let ρ : E ≃ₐ[F] E := AlgEquiv.restrictNormalHom E τ
    have h_comm : ∀ x : R_E,
        τ • (algebraMap R_E R_M x) = algebraMap R_E R_M (ρ • x) := by
      intro x
      apply Subtype.ext
      have h1 : ((algebraMap R_E R_M x : R_M) : M) = algebraMap E M (x : E) := by
        change algebraMap R_M M (algebraMap R_E R_M x) = algebraMap E M (algebraMap R_E E x)
        rw [← IsScalarTower.algebraMap_apply R_E R_M M x,
            ← IsScalarTower.algebraMap_apply R_E E M x]
      have h2 : ((algebraMap R_E R_M (ρ • x) : R_M) : M) = algebraMap E M (ρ (x : E)) := by
        change algebraMap R_M M (algebraMap R_E R_M (ρ • x)) = algebraMap E M (algebraMap R_E E (ρ • x))
        rw [← IsScalarTower.algebraMap_apply R_E R_M M (ρ • x),
            ← IsScalarTower.algebraMap_apply R_E E M (ρ • x)]
      change τ ((algebraMap R_E R_M x : R_M) : M) = ((algebraMap R_E R_M (ρ • x) : R_M) : M)
      rw [h1, h2]
      exact (AlgEquiv.restrictNormal_commutes τ E (x : E)).symm
    have hρ_arith : IsArithFrobAt R_F ρ Q_E := by
      intro x
      have h_frob :
          τ • (algebraMap R_E R_M x) -
            (algebraMap R_E R_M x) ^ Nat.card (R_F ⧸ Ideal.under R_F Q) ∈ Q :=
        hτ_arith (algebraMap R_E R_M x)
      rw [h_comm x, hQ_under, ← hQE_under, ← map_pow, ← map_sub] at h_frob
      exact h_frob
    have hσ_arith : IsArithFrobAt R_F (σ ^ (e q)) Q_E := by
      intro x
      have h_mem_map := he_map q hq_unr x
      have h_map_le : Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ Q_E :=
        Ideal.map_le_iff_le_comap.mpr hQE_under.symm.le
      rw [hQE_under]
      exact h_map_le h_mem_map
    have h_mem_inertia := hρ_arith.mul_inv_mem_inertia hσ_arith
    have hρ_eq : ρ = σ ^ (e q) := by
      letI := Ideal.Quotient.field q.asIdeal
      letI := Ideal.Quotient.field Q_E
      haveI : PerfectField (R_F ⧸ q.asIdeal) := PerfectField.ofFinite
      haveI : Algebra.IsSeparable (R_F ⧸ q.asIdeal) (R_E ⧸ Q_E) :=
        Algebra.IsAlgebraic.isSeparable_of_perfectField
      have h_card : Nat.card ((Submodule.toAddSubgroup Q_E).inertia (E ≃ₐ[F] E)) = 1 := by
        rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q_E,
          Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q_E (E ≃ₐ[F] E)]
        exact hq_unr Q_E hQE_prime hQE_under
      have h_bot : (Submodule.toAddSubgroup Q_E).inertia (E ≃ₐ[F] E) = ⊥ :=
        Subgroup.card_eq_one.mp h_card
      rw [h_bot, Subgroup.mem_bot, mul_inv_eq_one] at h_mem_inertia
      exact h_mem_inertia
    rw [hΦ_fst τ]
    exact hρ_eq
  have hm_not_Q : (m : R_M) ∉ Q := by
    intro hm_Q
    have hm_q : (m : R_F) ∈ q.asIdeal := by
      rw [← hQ_under]
      change algebraMap R_F R_M (m : R_F) ∈ Q
      rwa [map_natCast]
    exact hq_m hm_q
  have h_frob_ζ : τ • ζ - ζ ^ (Ideal.absNorm q.asIdeal) ∈ Q := by
    have h1 := hτ_arith ζ
    rw [hQ_under, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply] at h1
    exact h1
  have hτ_snd : (((Φ τ).2 : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm q.asIdeal : ZMod m) :=
    hΦ_frob_snd τ (Ideal.absNorm q.asIdeal) Q hQ_prime hm_not_Q h_frob_ζ
  have hτ_D : τ ∈ D := hD_frob τ hτ_fst hτ_snd
  let P_q : Ideal (NumberField.RingOfIntegers (IntermediateField.fixedField D)) :=
    Ideal.under (NumberField.RingOfIntegers (IntermediateField.fixedField D)) Q
  haveI : P_q.IsPrime :=
    Ideal.IsPrime.under (NumberField.RingOfIntegers (IntermediateField.fixedField D)) Q
  have hPq_under : Ideal.under (NumberField.RingOfIntegers F) P_q = q.asIdeal := by
    dsimp [P_q]
    rw [Ideal.under_under
      (B := NumberField.RingOfIntegers (IntermediateField.fixedField D)) Q, hQ_under]
  haveI : P_q.LiesOver q.asIdeal := ⟨hPq_under.symm⟩
  haveI : P_q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal P_q q.asIdeal
  have hPq_ne_bot : P_q ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot q.ne_bot P_q
  have h_fix : ∀ y : NumberField.RingOfIntegers (IntermediateField.fixedField D),
      τ • (algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
        (NumberField.RingOfIntegers M) y) =
      algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
        (NumberField.RingOfIntegers M) y := by
    intro y
    apply Subtype.ext
    have h1 :
        ((algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
          (NumberField.RingOfIntegers M) y : NumberField.RingOfIntegers M) : M) =
        ((y : IntermediateField.fixedField D) : M) := by
      change algebraMap (NumberField.RingOfIntegers M) M
          (algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
            (NumberField.RingOfIntegers M) y) =
        algebraMap (IntermediateField.fixedField D) M
          (algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
            (IntermediateField.fixedField D) y)
      rw [← IsScalarTower.algebraMap_apply
            (NumberField.RingOfIntegers (IntermediateField.fixedField D))
            (NumberField.RingOfIntegers M) M y,
          ← IsScalarTower.algebraMap_apply
            (NumberField.RingOfIntegers (IntermediateField.fixedField D))
            (IntermediateField.fixedField D) M y]
    change τ ((algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
        (NumberField.RingOfIntegers M) y : NumberField.RingOfIntegers M) : M) =
      ((algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
        (NumberField.RingOfIntegers M) y : NumberField.RingOfIntegers M) : M)
    rw [h1]
    exact (IntermediateField.mem_fixedField_iff D
      ((y : IntermediateField.fixedField D) : M)).mp
      (y : IntermediateField.fixedField D).2 τ hτ_D
  have h_sub_mem : ∀ y : NumberField.RingOfIntegers (IntermediateField.fixedField D),
      y - y ^ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ∈ P_q := by
    intro y
    have h2 :
        τ • (algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
            (NumberField.RingOfIntegers M) y) -
          (algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
            (NumberField.RingOfIntegers M) y) ^
            Nat.card (NumberField.RingOfIntegers F ⧸ Ideal.under (NumberField.RingOfIntegers F) Q) ∈ Q :=
      hτ_arith (algebraMap (NumberField.RingOfIntegers (IntermediateField.fixedField D))
        (NumberField.RingOfIntegers M) y)
    rw [h_fix y, hQ_under, ← map_pow, ← map_sub] at h2
    exact h2
  have h_inertia : q.asIdeal.inertiaDeg P_q = 1 := by
    letI := Ideal.Quotient.field q.asIdeal
    letI := Ideal.Quotient.field P_q
    letI := Fintype.ofFinite (NumberField.RingOfIntegers F ⧸ q.asIdeal)
    letI := Fintype.ofFinite
      (NumberField.RingOfIntegers (IntermediateField.fixedField D) ⧸ P_q)
    have h_frob_one :
        FiniteField.frobeniusAlgEquivOfAlgebraic
          (NumberField.RingOfIntegers F ⧸ q.asIdeal)
          (NumberField.RingOfIntegers (IntermediateField.fixedField D) ⧸ P_q) = 1 := by
      ext ybar
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective ybar
      rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, AlgEquiv.one_apply,
        ← map_pow, ← Nat.card_eq_fintype_card]
      have h_neg := P_q.neg_mem (h_sub_mem y)
      rw [neg_sub] at h_neg
      exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr h_neg
    have h_finrank :
        Module.finrank (NumberField.RingOfIntegers F ⧸ q.asIdeal)
          (NumberField.RingOfIntegers (IntermediateField.fixedField D) ⧸ P_q) = 1 := by
      rw [← FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic
            (NumberField.RingOfIntegers F ⧸ q.asIdeal)
            (NumberField.RingOfIntegers (IntermediateField.fixedField D) ⧸ P_q),
          h_frob_one, orderOf_one]
    rw [Ideal.inertiaDeg_algebraMap q.asIdeal P_q, h_finrank]
  have hPq_rel : Ideal.relNorm (NumberField.RingOfIntegers F) P_q = q.asIdeal := by
    rw [Ideal.relNorm_eq_pow_of_isMaximal P_q q.asIdeal, h_inertia, pow_one]
  exact ⟨P_q, hPq_ne_bot, hPq_rel⟩

theorem exists_compositum_galois_equiv_and_frob_unit_of_fixedField_graph {F E M : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Field M] [NumberField M] [Algebra F E] [IsGalois F E]
    [Algebra F M] [IsGalois F M] [Algebra E M] [IsScalarTower F E M]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m : ℕ)
    (ζ : NumberField.RingOfIntegers M)
    (Φ : (M ≃ₐ[F] M) ≃* (E ≃ₐ[F] E) × (ZMod m)ˣ)
    (hΦ_fst : ∀ τ : M ≃ₐ[F] M, (Φ τ).1 = AlgEquiv.restrictNormalHom E τ)
    (hΦ_frob_snd : ∀ (τ : M ≃ₐ[F] M) (k : ℕ) (Q : Ideal (NumberField.RingOfIntegers M)),
      Q.IsPrime →
      (m : NumberField.RingOfIntegers M) ∉ Q →
      τ • ζ - ζ ^ k ∈ Q →
      (((Φ τ).2 : (ZMod m)ˣ) : ZMod m) = (k : ZMod m))
    (U₀ : Subgroup (ZMod m)ˣ)
    (Ψ₀ : U₀ →* (E ≃ₐ[F] E))
    (hΨ₀_surj : ∃ u_gen : U₀, Ψ₀ u_gen = σ)
    (D : Subgroup (M ≃ₐ[F] M)) [D.Normal]
    (hD_iff : ∀ τ : M ≃ₐ[F] M,
      τ ∈ D ↔ ∃ h : (Φ τ).2 ∈ U₀, Ψ₀ ⟨(Φ τ).2, h⟩ = (Φ τ).1)
    (P_goal : Prop)
    (hP : ∀ {L : Type u} [Field L] [NumberField L]
      [Algebra (IntermediateField.fixedField D) L]
      [IsGalois (IntermediateField.fixedField D) L]
      [Algebra E L] [Algebra F L]
      [IsScalarTower F (IntermediateField.fixedField D) L]
      [IsScalarTower F E L]
      (ι : (L ≃ₐ[IntermediateField.fixedField D] L) ≃* (E ≃ₐ[F] E)),
      (∀ ρ : L ≃ₐ[IntermediateField.fixedField D] L,
        ι ρ = AlgEquiv.restrictNormalHom E (ρ.restrictScalars F)) →
      (∀ P : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers (IntermediateField.fixedField D)),
        (m : NumberField.RingOfIntegers (IntermediateField.fixedField D)) ∉ P.asIdeal →
        ∃ (ρ_P : L ≃ₐ[IntermediateField.fixedField D] L) (u_P : U₀),
          ρ_P ∈ FrobeniusClassAt (IntermediateField.fixedField D) L P ∧
          (((u_P : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm P.asIdeal : ZMod m)) ∧
          ι ρ_P = Ψ₀ u_P) →
      P_goal) :
    P_goal :=
by
  let K := IntermediateField.fixedField D
  haveI : Normal F E := IsGalois.to_normal
  haveI : Normal K M := IsGalois.to_normal
  obtain ⟨u_gen, hu_gen⟩ := hΨ₀_surj
  let τ₀ : M ≃ₐ[F] M := Φ.symm (σ, (u_gen : (ZMod m)ˣ))
  have hΦ_τ₀ : Φ τ₀ = (σ, (u_gen : (ZMod m)ˣ)) := Φ.apply_symm_apply _
  have hΦ_τ₀_fst : (Φ τ₀).1 = σ := by rw [hΦ_τ₀]
  have hΦ_τ₀_snd : (Φ τ₀).2 = (u_gen : (ZMod m)ˣ) := by rw [hΦ_τ₀]
  have hτ₀_D : τ₀ ∈ D := by
    rw [hD_iff]
    have h₀ : (Φ τ₀).2 ∈ U₀ := by
      rw [hΦ_τ₀_snd]
      exact u_gen.2
    refine ⟨h₀, ?_⟩
    have h_sub : (⟨(Φ τ₀).2, h₀⟩ : U₀) = u_gen := Subtype.ext hΦ_τ₀_snd
    rw [h_sub, hu_gen, hΦ_τ₀_fst]
  let τ_gen : M ≃ₐ[K] M :=
    { toRingEquiv := τ₀.toRingEquiv
      commutes' := fun x => (IntermediateField.mem_fixedField_iff D x.1).mp x.2 τ₀ hτ₀_D }
  have hτ_gen_res : τ_gen.restrictScalars F = τ₀ := by
    ext x
    rfl
  have hτ_gen_E : AlgEquiv.restrictNormalHom E (τ_gen.restrictScalars F) = σ := by
    rw [hτ_gen_res, ← hΦ_fst τ₀, hΦ_τ₀_fst]
  have h_unit : ∀ τ : M ≃ₐ[K] M,
      ∃ u_τ : U₀,
        (((u_τ : (ZMod m)ˣ) : ZMod m) =
          (((Φ (τ.restrictScalars F)).2 : (ZMod m)ˣ) : ZMod m)) ∧
        Ψ₀ u_τ = AlgEquiv.restrictNormalHom E (τ.restrictScalars F) := by
    intro τ
    let τ_F : M ≃ₐ[F] M := τ.restrictScalars F
    have hτ_F_K : τ_F ∈ K.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro y hy
      exact τ.commutes ⟨y, hy⟩
    have hτ_F_D : τ_F ∈ D := by
      rwa [IntermediateField.fixingSubgroup_fixedField D] at hτ_F_K
    obtain ⟨h_u, hΨ_u⟩ := (hD_iff τ_F).mp hτ_F_D
    refine ⟨⟨(Φ τ_F).2, h_u⟩, rfl, ?_⟩
    rw [hΨ_u, hΦ_fst τ_F]
  let res_KF : (M ≃ₐ[K] M) →* (M ≃ₐ[F] M) :=
    { toFun := fun τ => τ.restrictScalars F
      map_one' := by ext x; rfl
      map_mul' := fun _ _ => by ext x; rfl }
  let π_E : (M ≃ₐ[K] M) →* (E ≃ₐ[F] E) :=
    (AlgEquiv.restrictNormalHom E).comp res_KF
  let N : Subgroup (M ≃ₐ[K] M) := π_E.ker
  haveI : N.Normal := MonoidHom.normal_ker π_E
  let L := IntermediateField.fixedField N
  haveI : Normal K L := IsGalois.to_normal
  have h_EL : ∀ x : E, algebraMap E M x ∈ L := by
    intro x
    rw [IntermediateField.mem_fixedField_iff]
    intro τ hτ
    have hτ_ker : AlgEquiv.restrictNormalHom E (τ.restrictScalars F) = 1 :=
      MonoidHom.mem_ker.mp hτ
    have h_comm := AlgEquiv.restrictNormal_commutes (τ.restrictScalars F) E x
    change (τ.restrictScalars F) (algebraMap E M x) = algebraMap E M x
    rw [← h_comm]
    change (algebraMap E M) ((AlgEquiv.restrictNormalHom E (τ.restrictScalars F)) x) =
      (algebraMap E M) x
    rw [hτ_ker, AlgEquiv.one_apply]
  let f_EL : E →+* L :=
    { toFun := fun x => ⟨algebraMap E M x, h_EL x⟩
      map_one' := Subtype.ext (map_one (algebraMap E M))
      map_mul' := fun x y => Subtype.ext (map_mul (algebraMap E M) x y)
      map_zero' := Subtype.ext (map_zero (algebraMap E M))
      map_add' := fun x y => Subtype.ext (map_add (algebraMap E M) x y) }
  letI : Algebra E L := RingHom.toAlgebra f_EL
  haveI : IsScalarTower E L M := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower F E L :=
    IsScalarTower.of_algebraMap_eq (fun x =>
      Subtype.ext (IsScalarTower.algebraMap_apply F E M x))
  let res_LF : (L ≃ₐ[K] L) →* (L ≃ₐ[F] L) :=
    { toFun := fun ρ => ρ.restrictScalars F
      map_one' := by ext x; rfl
      map_mul' := fun _ _ => by ext x; rfl }
  let ι₀ : (L ≃ₐ[K] L) →* (E ≃ₐ[F] E) :=
    (AlgEquiv.restrictNormalHom E).comp res_LF
  have hι_proj : ∀ τ : M ≃ₐ[K] M,
      ι₀ (AlgEquiv.restrictNormalHom L τ) = π_E τ := by
    intro τ
    let ρ : L ≃ₐ[K] L := AlgEquiv.restrictNormalHom L τ
    ext x
    apply FaithfulSMul.algebraMap_injective E M
    have h_lhs : algebraMap E M ((ι₀ ρ) x) = τ (algebraMap E M x) := by
      rw [IsScalarTower.algebraMap_apply E L M ((ι₀ ρ) x)]
      have h1 := AlgEquiv.restrictNormal_commutes (ρ.restrictScalars F) E x
      have h2 := AlgEquiv.restrictNormal_commutes τ L (algebraMap E L x)
      change algebraMap L M (algebraMap E L (((ρ.restrictScalars F).restrictNormal E) x)) =
        τ (algebraMap E M x)
      rw [h1]
      change algebraMap L M ((τ.restrictNormal L) (algebraMap E L x)) = τ (algebraMap E M x)
      rw [h2, ← IsScalarTower.algebraMap_apply E L M x]
    have h_rhs : algebraMap E M ((π_E τ) x) = τ (algebraMap E M x) :=
      AlgEquiv.restrictNormal_commutes (τ.restrictScalars F) E x
    exact h_lhs.trans h_rhs.symm
  have h_inj : Function.Injective ι₀ := by
    intro ρ₁ ρ₂ h_eq
    have h_one : ι₀ (ρ₁ * ρ₂⁻¹) = 1 := by
      rw [map_mul, map_inv, h_eq, mul_inv_cancel]
    let ρ := ρ₁ * ρ₂⁻¹
    obtain ⟨τ, hτ_L⟩ := AlgEquiv.restrictNormalHom_surjective M ρ
    have hτ_N : τ ∈ N := by
      rw [MonoidHom.mem_ker, ← hι_proj τ, hτ_L]
      exact h_one
    have hρ_one : ρ = 1 := by
      ext y
      rw [← hτ_L]
      have h_comm := AlgEquiv.restrictNormal_commutes τ L y
      change algebraMap L M ((τ.restrictNormal L) y) = y.1
      rw [h_comm]
      exact (IntermediateField.mem_fixedField_iff N y.1).mp y.2 τ hτ_N
    exact mul_inv_eq_one.mp hρ_one
  have h_surj_ι : Function.Surjective ι₀ := by
    intro g
    let ρ_gen : L ≃ₐ[K] L := AlgEquiv.restrictNormalHom L τ_gen
    have hρ_gen : ι₀ ρ_gen = σ := by
      rw [hι_proj τ_gen]
      exact hτ_gen_E
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic g) with ⟨k, rfl⟩
    refine ⟨ρ_gen ^ k, ?_⟩
    rw [map_zpow, hρ_gen]
  let ι : (L ≃ₐ[K] L) ≃* (E ≃ₐ[F] E) :=
    MulEquiv.ofBijective ι₀ ⟨h_inj, h_surj_ι⟩
  refine hP ι (fun _ => rfl) (fun P hP_m => ?_)
  let R_K := NumberField.RingOfIntegers K
  let R_L := NumberField.RingOfIntegers L
  let R_M := NumberField.RingOfIntegers M
  haveI : P.asIdeal.IsPrime := P.isPrime
  haveI : P.asIdeal.IsMaximal := P.isMaximal
  obtain ⟨Q_M, hQM_prime, hQM_over⟩ :=
    Ideal.nonempty_primesOver (R := R_K) (S := R_M) P.asIdeal
  haveI : Q_M.IsPrime := hQM_prime
  haveI : Q_M.LiesOver P.asIdeal := hQM_over
  haveI : Q_M.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q_M P.asIdeal
  have hQM_under : Ideal.under R_K Q_M = P.asIdeal :=
    (Ideal.LiesOver.over (P := Q_M) (p := P.asIdeal)).symm
  obtain ⟨τ, hτ_arith⟩ :=
    IsArithFrobAt.exists_of_isInvariant R_K (M ≃ₐ[K] M) Q_M
  let Q_L : Ideal R_L := Ideal.under R_L Q_M
  have hQL_prime : Q_L.IsPrime := Ideal.IsPrime.under R_L Q_M
  have hQL_under : Ideal.under R_K Q_L = P.asIdeal := by
    dsimp [Q_L]
    rw [Ideal.under_under (B := R_L) Q_M, hQM_under]
  let ρ_P : L ≃ₐ[K] L := AlgEquiv.restrictNormalHom L τ
  have hρ_frob : ρ_P ∈ FrobeniusClassAt K L P := by
    refine ⟨Q_L, hQL_prime, hQL_under, fun x z h_xz => ?_⟩
    have h_comm : algebraMap R_L R_M z = τ • (algebraMap R_L R_M x) := by
      apply Subtype.ext
      have h1 : ((algebraMap R_L R_M z : R_M) : M) = algebraMap L M (z : L) := by
        change algebraMap R_M M (algebraMap R_L R_M z) = algebraMap L M (algebraMap R_L L z)
        rw [← IsScalarTower.algebraMap_apply R_L R_M M z,
            ← IsScalarTower.algebraMap_apply R_L L M z]
      have h2 : ((algebraMap R_L R_M x : R_M) : M) = algebraMap L M (x : L) := by
        change algebraMap R_M M (algebraMap R_L R_M x) = algebraMap L M (algebraMap R_L L x)
        rw [← IsScalarTower.algebraMap_apply R_L R_M M x,
            ← IsScalarTower.algebraMap_apply R_L L M x]
      change ((algebraMap R_L R_M z : R_M) : M) = τ ((algebraMap R_L R_M x : R_M) : M)
      rw [h1, h2, h_xz]
      exact AlgEquiv.restrictNormal_commutes τ L (x : L)
    have h_frob :
        τ • (algebraMap R_L R_M x) -
          (algebraMap R_L R_M x) ^ Nat.card (R_K ⧸ Ideal.under R_K Q_M) ∈ Q_M :=
      hτ_arith (algebraMap R_L R_M x)
    rw [← h_comm, hQM_under, ← map_pow, ← map_sub] at h_frob
    exact h_frob
  have hm_not_QM : (m : R_M) ∉ Q_M := by
    intro hm_QM
    have hm_P : (m : R_K) ∈ P.asIdeal := by
      rw [← hQM_under]
      change algebraMap R_K R_M (m : R_K) ∈ Q_M
      rwa [map_natCast]
    exact hP_m hm_P
  have h_zeta : (τ.restrictScalars F) • ζ - ζ ^ (Ideal.absNorm P.asIdeal) ∈ Q_M := by
    have h1 := hτ_arith ζ
    rw [hQM_under, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply] at h1
    exact h1
  obtain ⟨u_P, hu_snd, hΨ_u⟩ := h_unit τ
  refine ⟨ρ_P, u_P, hρ_frob, ?_, ?_⟩
  · exact hu_snd.trans
      (hΦ_frob_snd (τ.restrictScalars F) (Ideal.absNorm P.asIdeal) Q_M hQM_prime hm_not_QM h_zeta)
  · exact (hι_proj τ).trans hΨ_u.symm

theorem isUnramifiedAtPrime_and_not_dvd_map_of_relNorm_primes {F E K L : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra F E] [IsGalois F E] [Algebra F K] [Algebra K L] [IsGalois K L]
    [Algebra E L] [Algebra F L] [IsScalarTower F K L] [IsScalarTower F E L]
    (h_res_inj : Function.Injective
      (fun ρ : L ≃ₐ[K] L => AlgEquiv.restrictNormalHom E (ρ.restrictScalars F)))
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q)
    (m : ℕ)
    (I : Ideal (NumberField.RingOfIntegers K))
    (hI_primes : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      p.asIdeal ∣ Ideal.relNorm (NumberField.RingOfIntegers F) I →
      IsUnramifiedAtPrime F E p ∧ (m : NumberField.RingOfIntegers F) ∉ p.asIdeal)
    (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hP_dvd : P.asIdeal ∣ I) :
    IsUnramifiedAtPrime K L P ∧
    (m : NumberField.RingOfIntegers K) ∉ P.asIdeal ∧
    ¬ (P.asIdeal ∣ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K)) m₀) :=
by
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let R_K := NumberField.RingOfIntegers K
  let R_L := NumberField.RingOfIntegers L
  haveI : Normal F E := IsGalois.to_normal
  haveI : P.asIdeal.IsPrime := P.isPrime
  haveI : P.asIdeal.IsMaximal := P.isMaximal
  let p₀ : Ideal R_F := Ideal.under R_F P.asIdeal
  haveI hp₀_max : p₀.IsMaximal := Ideal.IsMaximal.under R_F P.asIdeal
  have hp₀_prime : p₀.IsPrime := Ideal.IsMaximal.isPrime hp₀_max
  have hp₀_ne_bot : p₀ ≠ ⊥ := Ideal.under_ne_bot R_F P.ne_bot
  let p : IsDedekindDomain.HeightOneSpectrum R_F := ⟨p₀, hp₀_prime, hp₀_ne_bot⟩
  have hp_eq : p.asIdeal = Ideal.under R_F P.asIdeal := rfl
  have hp_dvd_rel : p.asIdeal ∣ Ideal.relNorm R_F I := by
    haveI : P.asIdeal.LiesOver p.asIdeal := ⟨rfl⟩
    haveI : p.asIdeal.IsMaximal := hp₀_max
    have h_rel_P : Ideal.relNorm R_F P.asIdeal = p.asIdeal ^ (p.asIdeal.inertiaDeg P.asIdeal) :=
      Ideal.relNorm_eq_pow_of_isMaximal P.asIdeal p.asIdeal
    have h_f_pos : 0 < p.asIdeal.inertiaDeg P.asIdeal :=
      Ideal.inertiaDeg_pos p.asIdeal P.asIdeal
    have hp_dvd_relP : p.asIdeal ∣ Ideal.relNorm R_F P.asIdeal := by
      rw [h_rel_P]
      exact dvd_pow_self p.asIdeal h_f_pos.ne'
    exact dvd_trans hp_dvd_relP (map_dvd (Ideal.relNorm R_F) hP_dvd)
  obtain ⟨hp_unr, hp_m⟩ := hI_primes p hp_dvd_rel
  have hp_m₀ : ¬ (p.asIdeal ∣ m₀) := fun hdvd => hm₀_ram p hdvd hp_unr
  have hP_m : (m : R_K) ∉ P.asIdeal := by
    intro hm_P
    apply hp_m
    rw [hp_eq]
    change algebraMap R_F R_K (m : R_F) ∈ P.asIdeal
    rwa [map_natCast]
  have hP_m₀ : ¬ (P.asIdeal ∣ Ideal.map (algebraMap R_F R_K) m₀) := by
    intro hdvd_map
    apply hp_m₀
    rw [Ideal.dvd_iff_le, hp_eq]
    exact Ideal.map_le_iff_le_comap.mp (Ideal.dvd_iff_le.mp hdvd_map)
  have hP_unr : IsUnramifiedAtPrime K L P := by
    intro Q_L hQL_prime hQL_under
    haveI : Q_L.IsPrime := hQL_prime
    let Q_E : Ideal R_E := Ideal.under R_E Q_L
    have hQE_prime : Q_E.IsPrime := Ideal.IsPrime.under R_E Q_L
    have hQE_under : Ideal.under R_F Q_E = p.asIdeal := by
      dsimp [Q_E]
      rw [Ideal.under_under (B := R_E) Q_L, ← Ideal.under_under (B := R_K) Q_L, hQL_under, ← hp_eq]
    have h_inertia_E_bot : (Submodule.toAddSubgroup Q_E).inertia (E ≃ₐ[F] E) = ⊥ := by
      haveI : Q_E.IsPrime := hQE_prime
      haveI : p.asIdeal.IsPrime := p.isPrime
      haveI : p.asIdeal.IsMaximal := p.isMaximal
      haveI : Q_E.LiesOver p.asIdeal := ⟨hQE_under.symm⟩
      haveI : Q_E.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q_E p.asIdeal
      letI := Ideal.Quotient.field p.asIdeal
      letI := Ideal.Quotient.field Q_E
      haveI : PerfectField (R_F ⧸ p.asIdeal) := PerfectField.ofFinite
      haveI : Algebra.IsSeparable (R_F ⧸ p.asIdeal) (R_E ⧸ Q_E) :=
        Algebra.IsAlgebraic.isSeparable_of_perfectField
      have h_card : Nat.card ((Submodule.toAddSubgroup Q_E).inertia (E ≃ₐ[F] E)) = 1 := by
        rw [Ideal.card_inertia_eq_ramificationIdxIn p.asIdeal p.ne_bot Q_E,
          Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal Q_E (E ≃ₐ[F] E)]
        exact hp_unr Q_E hQE_prime hQE_under
      exact Subgroup.card_eq_one.mp h_card
    have h_inertia_L_bot : (Submodule.toAddSubgroup Q_L).inertia (L ≃ₐ[K] L) = ⊥ := by
      rw [eq_bot_iff]
      intro ρ hρ
      let g : E ≃ₐ[F] E := AlgEquiv.restrictNormalHom E (ρ.restrictScalars F)
      have h_comm : ∀ y : R_E,
          ρ • (algebraMap R_E R_L y) = algebraMap R_E R_L (g • y) := by
        intro y
        apply Subtype.ext
        have h1 : ((algebraMap R_E R_L y : R_L) : L) = algebraMap E L (y : E) := by
          change algebraMap R_L L (algebraMap R_E R_L y) = algebraMap E L (algebraMap R_E E y)
          rw [← IsScalarTower.algebraMap_apply R_E R_L L y,
              ← IsScalarTower.algebraMap_apply R_E E L y]
        have h2 : ((algebraMap R_E R_L (g • y) : R_L) : L) = algebraMap E L (g (y : E)) := by
          change algebraMap R_L L (algebraMap R_E R_L (g • y)) = algebraMap E L (algebraMap R_E E (g • y))
          rw [← IsScalarTower.algebraMap_apply R_E R_L L (g • y),
              ← IsScalarTower.algebraMap_apply R_E E L (g • y)]
        change ρ ((algebraMap R_E R_L y : R_L) : L) = ((algebraMap R_E R_L (g • y) : R_L) : L)
        rw [h1, h2]
        exact (AlgEquiv.restrictNormal_commutes (ρ.restrictScalars F) E (y : E)).symm
      have hg_in : g ∈ (Submodule.toAddSubgroup Q_E).inertia (E ≃ₐ[F] E) := by
        rw [AddSubgroup.mem_inertia]
        intro y
        have h_mem_L : ρ • (algebraMap R_E R_L y) - algebraMap R_E R_L y ∈ Q_L :=
          AddSubgroup.mem_inertia.mp hρ (algebraMap R_E R_L y)
        rw [h_comm y, ← map_sub] at h_mem_L
        exact h_mem_L
      rw [h_inertia_E_bot, Subgroup.mem_bot] at hg_in
      rw [Subgroup.mem_bot]
      apply h_res_inj
      dsimp only
      change g = AlgEquiv.restrictNormalHom E ((1 : L ≃ₐ[K] L).restrictScalars F)
      rw [hg_in]
      exact (map_one (AlgEquiv.restrictNormalHom E)).symm
    haveI : Q_L.LiesOver P.asIdeal := ⟨hQL_under.symm⟩
    haveI : Q_L.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q_L P.asIdeal
    letI := Ideal.Quotient.field P.asIdeal
    letI := Ideal.Quotient.field Q_L
    haveI : PerfectField (R_K ⧸ P.asIdeal) := PerfectField.ofFinite
    haveI : Algebra.IsSeparable (R_K ⧸ P.asIdeal) (R_L ⧸ Q_L) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    have h_card_L : Nat.card ((Submodule.toAddSubgroup Q_L).inertia (L ≃ₐ[K] L)) =
        Ideal.ramificationIdx (algebraMap R_K R_L) P.asIdeal Q_L := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn P.asIdeal P.ne_bot Q_L,
        Ideal.ramificationIdxIn_eq_ramificationIdx P.asIdeal Q_L (L ≃ₐ[K] L)]
    rw [← h_card_L, h_inertia_L_bot, Subgroup.card_bot]
  exact ⟨hP_unr, hP_m, hP_m₀⟩

theorem exists_cyclic_artin_map_and_unit_hom_eq {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (σ_K : L ≃ₐ[K] L)
    (hCyclic_K : ∀ ρ : L ≃ₐ[K] L, ρ ∈ Subgroup.zpowers σ_K)
    (m : ℕ)
    (U₀ : Subgroup (ZMod m)ˣ)
    (Ψ'₀ : U₀ →* (L ≃ₐ[K] L))
    (h_frob_unit : ∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      IsUnramifiedAtPrime K L P →
      (m : NumberField.RingOfIntegers K) ∉ P.asIdeal →
      ∃ (ρ_P : L ≃ₐ[K] L) (u_P : U₀),
        ρ_P ∈ FrobeniusClassAt K L P ∧
        (((u_P : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm P.asIdeal : ZMod m)) ∧
        ρ_P = Ψ'₀ u_P) :
    ∃ θ : Ideal (NumberField.RingOfIntegers K) → (L ≃ₐ[K] L),
      θ ⊤ = 1 ∧
      (∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
        J₁ ≠ ⊥ → J₂ ≠ ⊥ → θ (J₁ * J₂) = θ J₁ * θ J₂) ∧
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        IsUnramifiedAtPrime K L P → FrobeniusClassAt K L P ⊆ {θ P.asIdeal}) ∧
      (∀ B : Ideal (NumberField.RingOfIntegers L),
        B ≠ ⊥ → θ (Ideal.relNorm (NumberField.RingOfIntegers K) B) = 1) ∧
      (∀ J : Ideal (NumberField.RingOfIntegers K),
        J ≠ ⊥ →
        (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          P.asIdeal ∣ J →
          IsUnramifiedAtPrime K L P ∧ (m : NumberField.RingOfIntegers K) ∉ P.asIdeal) →
        ∃ u_J : U₀,
          (((u_J : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm J : ZMod m)) ∧
          θ J = Ψ'₀ u_J) :=
by
  classical
  open scoped Pointwise in
  let R_K := NumberField.RingOfIntegers K
  let R_L := NumberField.RingOfIntegers L
  let ι := IsDedekindDomain.HeightOneSpectrum R_K
  let P_unr : ι → Prop := IsUnramifiedAtPrime K L
  let d := Module.finrank K L
  have h_comm : ∀ ρ g : L ≃ₐ[K] L, ρ * g * ρ⁻¹ = g := by
    intro ρ g
    obtain ⟨n₁, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic_K ρ)
    obtain ⟨n₂, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hCyclic_K g)
    rw [← zpow_add, add_comm n₁ n₂, zpow_add, mul_inv_cancel_right]
  have h_npow : ∀ g : L ≃ₐ[K] L, ∃ n : ℕ, σ_K ^ n = g := by
    intro g
    exact (Submonoid.mem_powers_iff g σ_K).mp (mem_powers_iff_mem_zpowers.mpr (hCyclic_K g))
  have h_ex : ∀ q : ι, P_unr q → ∃ n : ℕ, FrobeniusClassAt K L q ⊆ {σ_K ^ n} := by
    intro q hq
    have h_frob_iff : ∀ g : L ≃ₐ[K] L, g ∈ FrobeniusClassAt K L q ↔
        ∃ Q : Ideal R_L, Q.IsPrime ∧
          Ideal.under R_K Q = q.asIdeal ∧
          IsArithFrobAt R_K g Q := by
      intro g
      simp only [FrobeniusClassAt, Set.mem_setOf_eq]
      refine exists_congr (fun Q => and_congr_right (fun _ => and_congr_right (fun h_under => ?_)))
      constructor
      · intro h x
        have hx := h x (g • x) rfl
        rwa [h_under]
      · intro h x z hz
        have hzx : z = g • x := Subtype.ext hz
        rw [hzx, ← h_under]
        exact h x
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    obtain ⟨Q₁, hQ₁⟩ := Ideal.nonempty_primesOver (S := R_L) q.asIdeal
    have hQ₁_prime : Q₁.IsPrime := hQ₁.1
    have hQ₁_over : Q₁.LiesOver q.asIdeal := hQ₁.2
    have h_under₁ : Ideal.under R_K Q₁ = q.asIdeal := hQ₁_over.over.symm
    haveI : Q₁.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₁ q.asIdeal
    obtain ⟨g, hg₁⟩ := IsArithFrobAt.exists_of_isInvariant R_K (L ≃ₐ[K] L) Q₁
    obtain ⟨n, rfl⟩ := h_npow g
    refine ⟨n, fun g₂ hg₂ => ?_⟩
    rw [h_frob_iff] at hg₂
    rcases hg₂ with ⟨Q₂, hQ₂_prime, h_under₂, hg₂⟩
    haveI : Q₂.LiesOver q.asIdeal := ⟨h_under₂.symm⟩
    obtain ⟨ρ, hρ⟩ := Ideal.exists_smul_eq_of_isGaloisGroup q.asIdeal Q₁ Q₂ (L ≃ₐ[K] L)
    have hg₁' : IsArithFrobAt R_K (ρ * (σ_K ^ n) * ρ⁻¹) Q₂ := by
      rw [← hρ]
      exact hg₁.conj ρ
    have h_mem := hg₁'.mul_inv_mem_inertia hg₂
    haveI : Q₂.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q₂ q.asIdeal
    letI := Ideal.Quotient.field q.asIdeal
    letI := Ideal.Quotient.field Q₂
    haveI : PerfectField (R_K ⧸ q.asIdeal) := PerfectField.ofFinite
    haveI : Algebra.IsSeparable (R_K ⧸ q.asIdeal) (R_L ⧸ Q₂) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    have h_card : Nat.card ((Submodule.toAddSubgroup Q₂).inertia (L ≃ₐ[K] L)) = 1 := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q₂,
        Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q₂ (L ≃ₐ[K] L)]
      exact hq Q₂ hQ₂_prime h_under₂
    have h_bot : (Submodule.toAddSubgroup Q₂).inertia (L ≃ₐ[K] L) = ⊥ :=
      Subgroup.card_eq_one.mp h_card
    rw [h_bot, Subgroup.mem_bot, mul_inv_eq_one, h_comm ρ (σ_K ^ n)] at h_mem
    exact Set.mem_singleton_iff.mpr h_mem.symm
  let e : ι → ℕ := fun q => if hq : P_unr q then (h_ex q hq).choose else 0
  have he_frob : ∀ q : ι, P_unr q → FrobeniusClassAt K L q ⊆ {σ_K ^ (e q)} := by
    intro q hq
    dsimp only [e]
    rw [dif_pos hq]
    exact (h_ex q hq).choose_spec
  have he_arith : ∀ q : ι, P_unr q →
      ∀ Q : Ideal R_L, Q.IsPrime → Ideal.under R_K Q = q.asIdeal →
        IsArithFrobAt R_K (σ_K ^ (e q)) Q := by
    intro q hq Q hQ_prime hQ_under
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    haveI : Q.IsPrime := hQ_prime
    haveI : Q.LiesOver q.asIdeal := ⟨hQ_under.symm⟩
    haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q q.asIdeal
    obtain ⟨g, hg_arith⟩ := IsArithFrobAt.exists_of_isInvariant R_K (L ≃ₐ[K] L) Q
    have hg_mem : g ∈ FrobeniusClassAt K L q := by
      refine ⟨Q, hQ_prime, hQ_under, fun x z hz => ?_⟩
      have hzx : z = g • x := Subtype.ext hz
      rw [hzx, ← hQ_under]
      exact hg_arith x
    have hg_eq : g = σ_K ^ (e q) := Set.mem_singleton_iff.mp (he_frob q hq hg_mem)
    exact hg_eq ▸ hg_arith
  have h_inertia_zero : ∀ (q : ι), P_unr q →
      ∀ (Q : Ideal R_L), Q.IsPrime → Ideal.under R_K Q = q.asIdeal →
        ((e q * (q.asIdeal.inertiaDeg Q) : ℕ) : ZMod d) = 0 := by
    intro q hq Q hQ_prime hQ_under
    let G := L ≃ₐ[K] L
    let τ : G := σ_K ^ (e q)
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    letI := Ideal.Quotient.field q.asIdeal
    letI : Fintype (R_K ⧸ q.asIdeal) := Fintype.ofFinite (R_K ⧸ q.asIdeal)
    haveI : PerfectField (R_K ⧸ q.asIdeal) := PerfectField.ofFinite
    haveI : Q.IsPrime := hQ_prime
    haveI : Q.LiesOver q.asIdeal := ⟨hQ_under.symm⟩
    haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q q.asIdeal
    letI := Ideal.Quotient.field Q
    haveI : Algebra.IsSeparable (R_K ⧸ q.asIdeal) (R_L ⧸ Q) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    have hQ_frob : IsArithFrobAt R_K τ Q := he_arith q hq Q hQ_prime hQ_under
    have hcomap : Ideal.comap (MulSemiringAction.toAlgHom R_K R_L τ) Q = Q :=
      AlgHom.IsArithFrobAt.comap_eq hQ_frob
    have hτ_inv_stab : τ⁻¹ ∈ MulAction.stabilizer G Q := by
      rw [MulAction.mem_stabilizer_iff]
      ext x
      rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, inv_inv]
      exact SetLike.ext_iff.mp hcomap x
    have hτ_stab : τ ∈ MulAction.stabilizer G Q := inv_mem_iff.mp hτ_inv_stab
    let φ := Ideal.Quotient.stabilizerHom Q q.asIdeal G
    have h_inertia_card : Nat.card ((Submodule.toAddSubgroup Q).inertia G) = 1 := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q,
          Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q G]
      exact hq Q hQ_prime hQ_under
    have h_inertia_bot : (Submodule.toAddSubgroup Q).inertia G = ⊥ :=
      Subgroup.card_eq_one.mp h_inertia_card
    have hφ_ker : φ.ker = ⊥ := by
      rw [Ideal.Quotient.ker_stabilizerHom Q q.asIdeal G, h_inertia_bot, Subgroup.bot_subgroupOf]
    have hφ_inj : Function.Injective φ := (MonoidHom.ker_eq_bot_iff φ).mp hφ_ker
    let τ_tilde : MulAction.stabilizer G Q := ⟨τ, hτ_stab⟩
    have hφ_τ : φ τ_tilde = FiniteField.frobeniusAlgEquivOfAlgebraic (R_K ⧸ q.asIdeal) (R_L ⧸ Q) := by
      ext x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.Quotient.stabilizerHom_apply]
      change Ideal.Quotient.mk Q ((MulSemiringAction.toAlgHom R_K R_L τ) y) = _
      rw [AlgHom.IsArithFrobAt.mk_apply hQ_frob y, hQ_under,
          FiniteField.frobeniusAlgEquivOfAlgebraic_apply, Fintype.card_eq_nat_card]
    have h_ord_τ : orderOf τ = q.asIdeal.inertiaDeg Q := by
      rw [← Subgroup.orderOf_mk τ hτ_stab, ← orderOf_injective φ hφ_inj τ_tilde,
          hφ_τ, FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic (R_K ⧸ q.asIdeal) (R_L ⧸ Q),
          ← Ideal.inertiaDeg_algebraMap q.asIdeal Q]
    have h_pow_one : σ_K ^ (e q * (q.asIdeal.inertiaDeg Q)) = 1 := by
      rw [pow_mul, ← h_ord_τ]
      exact pow_orderOf_eq_one τ
    have h_ord_σ : orderOf σ_K = d := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hCyclic_K, IsGalois.card_aut_eq_finrank K L]
    have h_dvd : d ∣ e q * (q.asIdeal.inertiaDeg Q) := by
      rw [← h_ord_σ]
      exact orderOf_dvd_iff_pow_eq_one.mpr h_pow_one
    exact (ZMod.natCast_eq_zero_iff (e q * (q.asIdeal.inertiaDeg Q)) d).mpr h_dvd
  let N_ideal : Ideal R_K → ℕ := fun I =>
    ∑ᶠ q : { q : ι // P_unr q },
      e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I).factors
  let θ : Ideal R_K → (L ≃ₐ[K] L) := fun I => σ_K ^ (N_ideal I)
  have h_fin_supp_ideal : ∀ I : Ideal R_K, I ≠ ⊥ →
      (Function.support (fun q : { q : ι // P_unr q } =>
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I).factors)).Finite := by
    intro I hI
    have h_fac_fin : { q : ι | q.asIdeal ∣ I }.Finite := Ideal.finite_factors hI
    have h_sub_fin : (Subtype.val ⁻¹' { q : ι | q.asIdeal ∣ I } : Set { q : ι // P_unr q }).Finite :=
      h_fac_fin.preimage Subtype.val_injective.injOn
    refine h_sub_fin.subset (fun q hq => ?_)
    rw [Function.mem_support] at hq
    have h_cnt_ne : (Associates.mk q.1.asIdeal).count (Associates.mk I).factors ≠ 0 :=
      right_ne_zero_of_mul hq
    have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
      IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
    change q.1.asIdeal ∣ I
    by_contra h_not_dvd
    apply h_cnt_ne
    let M : Multiset (Ideal R_K) := UniqueFactorizationMonoid.normalizedFactors I
    have hM_prod : M.prod = I := prod_normalizedFactors_eq_self hI
    have hM_prime : ∀ Q ∈ M, Prime Q :=
      fun Q hQ => UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ
    have hM_ne : ∀ Q ∈ M, Q ≠ q.1.asIdeal := by
      intro Q hQ h_eq
      apply h_not_dvd
      rw [← h_eq]
      exact UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hQ
    rw [← hM_prod]
    have h_ind_cnt : ∀ (L_ms : Multiset (Ideal R_K)),
        (∀ Q ∈ L_ms, Prime Q) → (∀ Q ∈ L_ms, Q ≠ q.1.asIdeal) →
        (Associates.mk q.1.asIdeal).count (Associates.mk L_ms.prod).factors = 0 := by
      intro L_ms
      refine Multiset.induction_on L_ms ?_ ?_
      · intro _ _
        rw [Multiset.prod_zero, Associates.mk_one, Associates.factors_one, Associates.count_zero hq_irr]
      · intro Q L' ih hL_p hL_ne
        have hQ_p : Prime Q := hL_p Q (Multiset.mem_cons_self Q L')
        have hQ_ne_q : Q ≠ q.1.asIdeal := hL_ne Q (Multiset.mem_cons_self Q L')
        have hL'_p : ∀ P₀ ∈ L', Prime P₀ := fun P₀ hP₀ => hL_p P₀ (Multiset.mem_cons_of_mem hP₀)
        have hL'_ne : ∀ P₀ ∈ L', P₀ ≠ q.1.asIdeal := fun P₀ hP₀ => hL_ne P₀ (Multiset.mem_cons_of_mem hP₀)
        have hQ_ne_zero : Q ≠ 0 := hQ_p.ne_zero
        have hQ_ne_bot : Q ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
        have hL'_ne_zero : L'.prod ≠ 0 := by
          apply Multiset.prod_ne_zero
          intro h0
          exact not_prime_zero (hL'_p 0 h0)
        have hQ_isPrime : Q.IsPrime := Ideal.isPrime_of_prime hQ_p
        let q_Q : ι := ⟨Q, hQ_isPrime, hQ_ne_bot⟩
        have hqQ_irr : Irreducible (Associates.mk Q) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q_Q
        have h_mk_ne : Associates.mk q.1.asIdeal ≠ Associates.mk Q := by
          intro h_eq
          exact hQ_ne_q (Associates.mk_injective h_eq).symm
        rw [Multiset.prod_cons, ← Associates.mk_mul_mk,
          Associates.count_mul (Associates.mk_ne_zero.mpr hQ_ne_zero) (Associates.mk_ne_zero.mpr hL'_ne_zero) hq_irr,
          Associates.count_eq_zero_of_ne hq_irr hqQ_irr h_mk_ne,
          ih hL'_p hL'_ne, add_zero]
    exact h_ind_cnt M hM_prime hM_ne
  have hθ_top : θ ⊤ = 1 := by
    dsimp [θ, N_ideal]
    have h0 : (∑ᶠ q : { q : ι // P_unr q },
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk (⊤ : Ideal R_K)).factors) = 0 := by
      refine finsum_eq_zero_of_forall_eq_zero fun q => ?_
      have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
      rw [← Ideal.one_eq_top, Associates.mk_one, Associates.factors_one, Associates.count_zero hq_irr, mul_zero]
    rw [h0, pow_zero]
  have hθ_mul : ∀ I₁ I₂ : Ideal R_K, I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂ := by
    intro I₁ I₂ hI₁ hI₂
    dsimp [θ, N_ideal]
    have hI₁_zero : I₁ ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hI₂_zero : I₂ ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have h_term : ∀ q : { q : ι // P_unr q },
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk (I₁ * I₂)).factors =
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I₁).factors +
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I₂).factors := by
      intro q
      have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
      rw [← Associates.mk_mul_mk,
        Associates.count_mul (Associates.mk_ne_zero.mpr hI₁_zero) (Associates.mk_ne_zero.mpr hI₂_zero) hq_irr,
        Nat.mul_add]
    simp_rw [h_term]
    rw [finsum_add_distrib (h_fin_supp_ideal I₁ hI₁) (h_fin_supp_ideal I₂ hI₂), pow_add]
  have hθ_frob : ∀ q : ι, P_unr q → FrobeniusClassAt K L q ⊆ {θ q.asIdeal} := by
    intro q hq
    have hN_q : N_ideal q.asIdeal = e q := by
      dsimp [N_ideal]
      rw [finsum_eq_single _ ⟨q, hq⟩]
      · have hq_irr : Irreducible (Associates.mk q.asIdeal) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q
        rw [Associates.count_self hq_irr, mul_one]
      · rintro ⟨q', hq'⟩ h_ne
        have hq'_irr : Irreducible (Associates.mk q'.asIdeal) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q'
        have hq_irr : Irreducible (Associates.mk q.asIdeal) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q
        have h_mk_ne : Associates.mk q'.asIdeal ≠ Associates.mk q.asIdeal := by
          intro h_eq
          apply h_ne
          exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext (Associates.mk_injective h_eq))
        rw [Associates.count_eq_zero_of_ne hq'_irr hq_irr h_mk_ne, mul_zero]
    have hθ_q : θ q.asIdeal = σ_K ^ (e q) := by
      dsimp [θ]
      rw [hN_q]
    rw [hθ_q]
    exact he_frob q hq
  have hθ_relNorm : ∀ B : Ideal R_L, B ≠ ⊥ → θ (Ideal.relNorm R_K B) = 1 := by
    intro B hB_ne
    dsimp [θ]
    have hrel_ne : Ideal.relNorm R_K B ≠ ⊥ :=
      (Ideal.relNorm_eq_bot_iff (R := R_K)).not.mpr hB_ne
    let f_B : { q : ι // P_unr q } → ℕ := fun q =>
      e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk (Ideal.relNorm R_K B)).factors
    have h_term_zero : ∀ q : { q : ι // P_unr q }, ((f_B q : ℕ) : ZMod d) = 0 := by
      rintro ⟨q, hPq⟩
      dsimp [f_B]
      let M : Multiset (Ideal R_L) := UniqueFactorizationMonoid.normalizedFactors B
      have hM_prod : M.prod = B := prod_normalizedFactors_eq_self hB_ne
      have hM_prime : ∀ Q ∈ M, Prime Q :=
        fun Q hQ => UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ
      rw [← hM_prod]
      have hq_irr : Irreducible (Associates.mk q.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q
      have h_single : ∀ Q : Ideal R_L, Prime Q →
          ((e q * (Associates.mk q.asIdeal).count
            (Associates.mk (Ideal.relNorm R_K Q)).factors : ℕ) : ZMod d) = 0 := by
        intro Q hQ_prime_elt
        have hQ_isPrime : Q.IsPrime := Ideal.isPrime_of_prime hQ_prime_elt
        have hQ_ne_bot : Q ≠ ⊥ := by
          rw [← Submodule.zero_eq_bot]
          exact hQ_prime_elt.ne_zero
        haveI : Q.IsMaximal := Ideal.IsPrime.isMaximal hQ_isPrime hQ_ne_bot
        let p_Q : Ideal R_K := Ideal.under R_K Q
        haveI : Q.LiesOver p_Q := ⟨rfl⟩
        haveI : p_Q.IsMaximal := Ideal.IsMaximal.under R_K Q
        have hpQ_prime : p_Q.IsPrime := Ideal.IsMaximal.isPrime inferInstance
        have hpQ_ne_bot : p_Q ≠ ⊥ := Ideal.under_ne_bot R_K hQ_ne_bot
        have hpQ_ne_zero : p_Q ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have h_mk_pQ_ne : Associates.mk p_Q ≠ 0 := Associates.mk_ne_zero.mpr hpQ_ne_zero
        have h_rel_Q : Ideal.relNorm R_K Q = p_Q ^ (p_Q.inertiaDeg Q) :=
          Ideal.relNorm_eq_pow_of_isMaximal Q p_Q
        rw [h_rel_Q, Associates.mk_pow, Associates.count_pow h_mk_pQ_ne hq_irr]
        by_cases h_eq : p_Q = q.asIdeal
        · rw [h_eq, Associates.count_self hq_irr, mul_one]
          exact h_inertia_zero q hPq Q hQ_isPrime h_eq
        · let q_Q : ι := ⟨p_Q, hpQ_prime, hpQ_ne_bot⟩
          have hqQ_irr : Irreducible (Associates.mk p_Q) :=
            IsDedekindDomain.HeightOneSpectrum.associates_irreducible q_Q
          have h_mk_ne : Associates.mk q.asIdeal ≠ Associates.mk p_Q := by
            intro h_mk_eq
            exact h_eq (Associates.mk_injective h_mk_eq).symm
          rw [Associates.count_eq_zero_of_ne hq_irr hqQ_irr h_mk_ne, mul_zero, mul_zero, Nat.cast_zero]
      have h_ind : ∀ (L_ms : Multiset (Ideal R_L)), (∀ Q ∈ L_ms, Prime Q) →
          ((e q * (Associates.mk q.asIdeal).count
            (Associates.mk (Ideal.relNorm R_K L_ms.prod)).factors : ℕ) : ZMod d) = 0 := by
        intro L_ms
        refine Multiset.induction_on L_ms ?_ ?_
        · intro _
          rw [Multiset.prod_zero, map_one, Associates.mk_one, Associates.factors_one,
            Associates.count_zero hq_irr, mul_zero, Nat.cast_zero]
        · intro Q L' ih hL
          have hQ : Prime Q := hL Q (Multiset.mem_cons_self Q L')
          have hL' : ∀ P₀ ∈ L', Prime P₀ := fun P₀ hP₀ => hL P₀ (Multiset.mem_cons_of_mem hP₀)
          have hQ_ne_bot : Q ≠ ⊥ := by
            rw [← Submodule.zero_eq_bot]
            exact hQ.ne_zero
          have hL'_ne_zero : L'.prod ≠ 0 := by
            apply Multiset.prod_ne_zero
            intro h0
            exact not_prime_zero (hL' 0 h0)
          have hL'_ne_bot : L'.prod ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
          have h_rel_Q_ne : Ideal.relNorm R_K Q ≠ 0 := by
            rw [Submodule.zero_eq_bot]
            exact (Ideal.relNorm_eq_bot_iff (R := R_K)).not.mpr hQ_ne_bot
          have h_rel_L'_ne : Ideal.relNorm R_K L'.prod ≠ 0 := by
            rw [Submodule.zero_eq_bot]
            exact (Ideal.relNorm_eq_bot_iff (R := R_K)).not.mpr hL'_ne_bot
          have h_mk_Q : Associates.mk (Ideal.relNorm R_K Q) ≠ 0 :=
            Associates.mk_ne_zero.mpr h_rel_Q_ne
          have h_mk_L' : Associates.mk (Ideal.relNorm R_K L'.prod) ≠ 0 :=
            Associates.mk_ne_zero.mpr h_rel_L'_ne
          rw [Multiset.prod_cons, map_mul, ← Associates.mk_mul_mk,
            Associates.count_mul h_mk_Q h_mk_L' hq_irr,
            Nat.mul_add, Nat.cast_add, h_single Q hQ, ih hL', add_zero]
      exact h_ind M hM_prime
    let s := (h_fin_supp_ideal (Ideal.relNorm R_K B) hrel_ne).toFinset
    have hs1 : Function.support f_B ⊆ ↑s :=
      fun q hq => (Set.Finite.mem_toFinset (h_fin_supp_ideal (Ideal.relNorm R_K B) hrel_ne)).mpr hq
    have hs2 : Function.support (fun q => (f_B q : ZMod d)) ⊆ ↑s := by
      intro q hq
      apply hs1
      rw [Function.mem_support] at hq ⊢
      intro h0
      apply hq
      rw [h0, Nat.cast_zero]
    have h_cast_zero : ((N_ideal (Ideal.relNorm R_K B) : ℕ) : ZMod d) = 0 := by
      change ((∑ᶠ q : { q : ι // P_unr q }, f_B q : ℕ) : ZMod d) = 0
      rw [finsum_eq_sum_of_support_subset _ hs1, Nat.cast_sum,
        ← finsum_eq_sum_of_support_subset _ hs2]
      exact finsum_eq_zero_of_forall_eq_zero h_term_zero
    have hdvd : d ∣ N_ideal (Ideal.relNorm R_K B) :=
      (ZMod.natCast_eq_zero_iff (N_ideal (Ideal.relNorm R_K B)) d).mp h_cast_zero
    have h_ord_card : orderOf σ_K = Nat.card (L ≃ₐ[K] L) :=
      orderOf_eq_card_of_forall_mem_zpowers hCyclic_K
    have h_card_finrank : Nat.card (L ≃ₐ[K] L) = d :=
      IsGalois.card_aut_eq_finrank K L
    rw [← h_card_finrank, ← h_ord_card] at hdvd
    exact orderOf_dvd_iff_pow_eq_one.mp hdvd
  have hθ_unit : ∀ J : Ideal R_K, J ≠ ⊥ →
      (∀ P : ι, P.asIdeal ∣ J → P_unr P ∧ (m : R_K) ∉ P.asIdeal) →
      ∃ u_J : U₀,
        (((u_J : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm J : ZMod m)) ∧
        θ J = Ψ'₀ u_J := by
    intro J hJ_ne hJ_primes
    have h_prime_unit : ∀ P : ι, P_unr P → (m : R_K) ∉ P.asIdeal →
        ∃ u_P : U₀,
          (((u_P : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm P.asIdeal : ZMod m)) ∧
          θ P.asIdeal = Ψ'₀ u_P := by
      intro P hP_unr hP_m
      obtain ⟨ρ_P, u_P, hρ_frob, hu_val, hρ_eq⟩ := h_frob_unit P hP_unr hP_m
      have hρ_θ : ρ_P = θ P.asIdeal := Set.mem_singleton_iff.mp (hθ_frob P hP_unr hρ_frob)
      exact ⟨u_P, hu_val, hρ_θ ▸ hρ_eq⟩
    let M : Multiset (Ideal R_K) := UniqueFactorizationMonoid.normalizedFactors J
    have hM_prod : M.prod = J := prod_normalizedFactors_eq_self hJ_ne
    have hM_prime : ∀ Q ∈ M, Prime Q :=
      fun Q hQ => UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ
    rw [← hM_prod] at hJ_primes ⊢
    have h_ind_unit : ∀ (L_ms : Multiset (Ideal R_K)),
        (∀ Q ∈ L_ms, Prime Q) →
        (∀ P : ι, P.asIdeal ∣ L_ms.prod → P_unr P ∧ (m : R_K) ∉ P.asIdeal) →
        ∃ u : U₀,
          (((u : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm L_ms.prod : ZMod m)) ∧
          θ L_ms.prod = Ψ'₀ u := by
      intro L_ms
      refine Multiset.induction_on L_ms ?_ ?_
      · intro _ _
        refine ⟨1, ?_, ?_⟩
        · rw [Multiset.prod_zero, map_one, Nat.cast_one]
          rfl
        · rw [Multiset.prod_zero, Ideal.one_eq_top, hθ_top, map_one]
      · intro Q L' ih hL_p h_primes
        have hQ_p : Prime Q := hL_p Q (Multiset.mem_cons_self Q L')
        have hL'_p : ∀ P₀ ∈ L', Prime P₀ :=
          fun P₀ hP₀ => hL_p P₀ (Multiset.mem_cons_of_mem hP₀)
        have hQ_isPrime : Q.IsPrime := Ideal.isPrime_of_prime hQ_p
        have hQ_ne_bot : Q ≠ ⊥ := by
          rw [← Submodule.zero_eq_bot]
          exact hQ_p.ne_zero
        have hL'_ne_zero : L'.prod ≠ 0 := by
          apply Multiset.prod_ne_zero
          intro h0
          exact not_prime_zero (hL'_p 0 h0)
        have hL'_ne_bot : L'.prod ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
        let P_Q : ι := ⟨Q, hQ_isPrime, hQ_ne_bot⟩
        have hPQ_dvd : P_Q.asIdeal ∣ (Q ::ₘ L').prod := by
          rw [Multiset.prod_cons]
          exact dvd_mul_right Q L'.prod
        obtain ⟨hPQ_unr, hPQ_m⟩ := h_primes P_Q hPQ_dvd
        obtain ⟨u_Q, huQ_val, hθ_Q⟩ := h_prime_unit P_Q hPQ_unr hPQ_m
        have hL'_primes : ∀ P : ι, P.asIdeal ∣ L'.prod → P_unr P ∧ (m : R_K) ∉ P.asIdeal := by
          intro P hP_dvd
          apply h_primes P
          rw [Multiset.prod_cons]
          exact dvd_mul_of_dvd_right hP_dvd Q
        obtain ⟨u_L', huL'_val, hθ_L'⟩ := ih hL'_p hL'_primes
        refine ⟨u_Q * u_L', ?_, ?_⟩
        · rw [Multiset.prod_cons, map_mul, Nat.cast_mul, ← huQ_val, ← huL'_val]
          rfl
        · rw [Multiset.prod_cons, hθ_mul Q L'.prod hQ_ne_bot hL'_ne_bot, hθ_Q, hθ_L', map_mul]
    exact h_ind_unit M hM_prime hJ_primes
  exact ⟨θ, hθ_top, hθ_mul, hθ_frob, hθ_relNorm, hθ_unit⟩

theorem exists_modulus_and_principal_ray_ker_of_unit_hom_eq {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (𝔪₀ : Ideal (NumberField.RingOfIntegers K))
    (h𝔪₀_ne : 𝔪₀ ≠ ⊥)
    (m : ℕ) (hm_one : 1 ≤ m)
    (U₀ : Subgroup (ZMod m)ˣ)
    (Ψ'₀ : U₀ →* (L ≃ₐ[K] L))
    (θ : Ideal (NumberField.RingOfIntegers K) → (L ≃ₐ[K] L))
    (hθ_unit : ∀ J : Ideal (NumberField.RingOfIntegers K),
      J ≠ ⊥ →
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        P.asIdeal ∣ J →
        IsUnramifiedAtPrime K L P ∧ (m : NumberField.RingOfIntegers K) ∉ P.asIdeal) →
      ∃ u_J : U₀,
        (((u_J : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm J : ZMod m)) ∧
        θ J = Ψ'₀ u_J) :
    ∃ 𝔪 : Ideal (NumberField.RingOfIntegers K),
      𝔪 ≠ ⊥ ∧
      𝔪 ≤ 𝔪₀ ∧
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ¬ IsUnramifiedAtPrime K L P → P.asIdeal ∣ 𝔪) ∧
      (∀ J : Ideal (NumberField.RingOfIntegers K),
        J ≠ ⊥ →
        (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          P.asIdeal ∣ J →
          IsUnramifiedAtPrime K L P ∧
          (m : NumberField.RingOfIntegers K) ∉ P.asIdeal ∧
          ¬ (P.asIdeal ∣ 𝔪₀)) →
        IsCoprime J 𝔪) ∧
      (∀ α : NumberField.RingOfIntegers K,
        α ≠ 0 →
        α - 1 ∈ 𝔪 →
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal → 0 < (w.embedding (α : K)).re) →
        θ (Ideal.span {α}) = 1) :=
by
  classical
  let R_K := NumberField.RingOfIntegers K
  let R_L := NumberField.RingOfIntegers L
  let ι_K := IsDedekindDomain.HeightOneSpectrum R_K
  let S_unr : Set ι_K := { P | IsUnramifiedAtPrime K L P }
  have hS : S_unrᶜ.Finite := by
    let D : Ideal R_L := differentIdeal R_K R_L
    have hD : D ≠ ⊥ := differentIdeal_ne_bot
    let T_D : Set (IsDedekindDomain.HeightOneSpectrum R_L) := { v | v.asIdeal ∣ D }
    have hT_D : T_D.Finite := Ideal.finite_factors hD
    have h_ex : ∀ P : ↑S_unrᶜ, ∃ v : ↑T_D,
        Ideal.under R_K v.1.asIdeal = P.1.asIdeal := by
      intro ⟨P, hP⟩
      change ¬ IsUnramifiedAtPrime K L P at hP
      rw [IsUnramifiedAtPrime] at hP
      push_neg at hP
      rcases hP with ⟨Q, hQ_prime, h_under, h_ram⟩
      haveI : Q.IsPrime := hQ_prime
      haveI : P.asIdeal.IsMaximal := P.isMaximal
      have h_map : Ideal.map (algebraMap R_K R_L) P.asIdeal ≤ Q :=
        Ideal.map_le_iff_le_comap.mpr h_under.symm.le
      have h_le2 : Ideal.map (algebraMap R_K R_L) P.asIdeal ≤ Q ^ 2 :=
        (Ideal.ramificationIdx_ne_one_iff h_map).mp h_ram
      have h_dvd2 : Q ^ 2 ∣ Ideal.map (algebraMap R_K R_L) P.asIdeal :=
        Ideal.dvd_iff_le.mpr h_le2
      have h_dvdD : Q ∣ D := by
        simpa using pow_sub_one_dvd_differentIdeal R_K Q 2 P.ne_bot h_dvd2
      have hQ_ne_bot : Q ≠ ⊥ := by
        intro h_bot
        rw [h_bot, ← Submodule.zero_eq_bot, zero_dvd_iff, Submodule.zero_eq_bot] at h_dvdD
        exact hD h_dvdD
      exact ⟨⟨⟨Q, hQ_prime, hQ_ne_bot⟩, h_dvdD⟩, h_under⟩
    choose φ hφ using h_ex
    have hφ_inj : Function.Injective φ := by
      intro P₁ P₂ hP
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      rw [← hφ P₁, hP, hφ P₂]
    haveI : Finite ↑T_D := hT_D.to_subtype
    haveI : Finite ↑S_unrᶜ := Finite.of_injective φ hφ_inj
    exact Set.finite_coe_iff.mp inferInstance
  let r_K : Ideal R_K := ∏ P ∈ hS.toFinset, P.asIdeal
  have hr_ne_bot : r_K ≠ ⊥ := by
    change (∏ P ∈ hS.toFinset, P.asIdeal) ≠ ⊥
    rw [← Submodule.zero_eq_bot]
    apply Finset.prod_ne_zero_iff.mpr
    intro P _
    rw [Submodule.zero_eq_bot]
    exact P.ne_bot
  have hr_dvd : ∀ P : ι_K, P.asIdeal ∣ r_K ↔ ¬ IsUnramifiedAtPrime K L P := by
    intro P
    change P.asIdeal ∣ (∏ P' ∈ hS.toFinset, P'.asIdeal) ↔ ¬ IsUnramifiedAtPrime K L P
    rw [Prime.dvd_finset_prod_iff P.prime]
    constructor
    · rintro ⟨P', hP'_mem, hdvd⟩
      have hle : P'.asIdeal ≤ P.asIdeal := Ideal.dvd_iff_le.mp hdvd
      have heq_ideal : P'.asIdeal = P.asIdeal :=
        P'.isMaximal.eq_of_le P.isMaximal.ne_top hle
      have heq : P' = P := IsDedekindDomain.HeightOneSpectrum.ext heq_ideal
      subst heq
      exact (Set.Finite.mem_toFinset hS).mp hP'_mem
    · intro hP_ram
      refine ⟨P, (Set.Finite.mem_toFinset hS).mpr hP_ram, dvd_rfl⟩
  let I_m : Ideal R_K := Ideal.span {(m : R_K)}
  have hm_ne_zero : m ≠ 0 := Nat.one_le_iff_ne_zero.mp hm_one
  have hm_cast_ne_zero : (m : R_K) ≠ 0 := Nat.cast_ne_zero.mpr hm_ne_zero
  have hIm_ne_bot : I_m ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hm_cast_ne_zero
  let 𝔪 : Ideal R_K := 𝔪₀ * I_m * r_K
  have h𝔪_ne : 𝔪 ≠ ⊥ := by
    change 𝔪₀ * I_m * r_K ≠ ⊥
    rw [← Submodule.zero_eq_bot] at h𝔪₀_ne hIm_ne_bot hr_ne_bot ⊢
    exact mul_ne_zero (mul_ne_zero h𝔪₀_ne hIm_ne_bot) hr_ne_bot
  have h𝔪_le : 𝔪 ≤ 𝔪₀ := Ideal.mul_le_right.trans Ideal.mul_le_right
  have h𝔪_le_Im : 𝔪 ≤ I_m := Ideal.mul_le_right.trans Ideal.mul_le_left
  have h𝔪_ram : ∀ P : ι_K, ¬ IsUnramifiedAtPrime K L P → P.asIdeal ∣ 𝔪 := by
    intro P hP_ram
    exact dvd_mul_of_dvd_right ((hr_dvd P).mpr hP_ram) (𝔪₀ * I_m)
  have h𝔪_cop : ∀ J : Ideal R_K,
      J ≠ ⊥ →
      (∀ P : ι_K,
        P.asIdeal ∣ J →
        IsUnramifiedAtPrime K L P ∧
        (m : R_K) ∉ P.asIdeal ∧
        ¬ (P.asIdeal ∣ 𝔪₀)) →
      IsCoprime J 𝔪 := by
    intro J _ hJ_primes
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    obtain ⟨M, hM_max, h_le_M⟩ := Ideal.exists_le_maximal (J ⊔ 𝔪) h_ne_top
    have hJ_le_M : J ≤ M := le_sup_left.trans h_le_M
    have h𝔪_le_M : 𝔪 ≤ M := le_sup_right.trans h_le_M
    have hM_ne_bot : M ≠ ⊥ := by
      intro hM_bot
      apply h𝔪_ne
      exact le_bot_iff.mp (hM_bot ▸ h𝔪_le_M)
    let P_M : ι_K := ⟨M, hM_max.isPrime, hM_ne_bot⟩
    have hPM_dvd_J : P_M.asIdeal ∣ J := Ideal.dvd_iff_le.mpr hJ_le_M
    have hPM_dvd_m : P_M.asIdeal ∣ 𝔪 := Ideal.dvd_iff_le.mpr h𝔪_le_M
    obtain ⟨hPM_unr, hPM_m, hPM_m₀⟩ := hJ_primes P_M hPM_dvd_J
    change P_M.asIdeal ∣ (𝔪₀ * I_m) * r_K at hPM_dvd_m
    rcases P_M.prime.dvd_mul.mp hPM_dvd_m with h_dvd_left | h_dvd_r
    · rcases P_M.prime.dvd_mul.mp h_dvd_left with h_dvd_m₀ | h_dvd_Im
      · exact hPM_m₀ h_dvd_m₀
      · exact hPM_m (Ideal.dvd_span_singleton.mp h_dvd_Im)
    · exact ((hr_dvd P_M).mp h_dvd_r) hPM_unr
  refine ⟨𝔪, h𝔪_ne, h𝔪_le, h𝔪_ram, h𝔪_cop, fun α hα_ne hα_m hα_pos => ?_⟩
  have hJα_ne : Ideal.span ({α} : Set R_K) ≠ ⊥ :=
    Ideal.span_singleton_eq_bot.not.mpr hα_ne
  have hJα_primes : ∀ P : ι_K,
      P.asIdeal ∣ Ideal.span ({α} : Set R_K) →
      IsUnramifiedAtPrime K L P ∧ (m : R_K) ∉ P.asIdeal := by
    intro P hP_dvd_α
    have hα_mem_P : α ∈ P.asIdeal := Ideal.dvd_span_singleton.mp hP_dvd_α
    have hP_not_dvd_m : ¬ (P.asIdeal ∣ 𝔪) := by
      intro hP_dvd_m
      have hm_le_P : 𝔪 ≤ P.asIdeal := Ideal.dvd_iff_le.mp hP_dvd_m
      have hα1_mem_P : α - 1 ∈ P.asIdeal := hm_le_P hα_m
      have h_one_mem_P : (1 : R_K) ∈ P.asIdeal := by
        have h_sub : α - (α - 1) ∈ P.asIdeal := Submodule.sub_mem P.asIdeal hα_mem_P hα1_mem_P
        rwa [sub_sub_cancel] at h_sub
      exact P.isMaximal.ne_top ((Ideal.eq_top_iff_one P.asIdeal).mpr h_one_mem_P)
    refine ⟨?_, ?_⟩
    · by_contra hP_ram
      exact hP_not_dvd_m (h𝔪_ram P hP_ram)
    · intro hm_mem_P
      have hP_dvd_Im : P.asIdeal ∣ I_m := Ideal.dvd_span_singleton.mpr hm_mem_P
      have hIm_le_P : I_m ≤ P.asIdeal := Ideal.dvd_iff_le.mp hP_dvd_Im
      exact hP_not_dvd_m (Ideal.dvd_iff_le.mpr (h𝔪_le_Im.trans hIm_le_P))
  obtain ⟨u_α, hu_val, hθ_α⟩ := hθ_unit (Ideal.span {α}) hJα_ne hJα_primes
  have h_absNorm_eq_intNorm :
      (Ideal.absNorm (Ideal.span {α}) : ℤ) = Algebra.intNorm ℤ R_K α := by
    let x : K := (α : K)
    have hx_ne : x ≠ 0 := NumberField.RingOfIntegers.coe_eq_zero_iff.not.mpr hα_ne
    have h_intNorm_eq : Algebra.intNorm ℤ R_K α = Algebra.norm ℤ α := by
      rw [Algebra.intNorm_eq_norm]
    have h_coe_norm : ((Algebra.intNorm ℤ R_K α : ℤ) : ℚ) = Algebra.norm ℚ x := by
      rw [h_intNorm_eq]
      exact Algebra.coe_norm_int α
    have h_prod_alg : (algebraMap ℚ ℂ) (Algebra.norm ℚ x) = ∏ σ : K →ₐ[ℚ] ℂ, σ x :=
      Algebra.norm_eq_prod_embeddings ℚ ℂ x
    have h_prod_ring : ((Algebra.norm ℚ x : ℚ) : ℂ) = ∏ φ : K →+* ℂ, φ x := by
      have h_reindex : (∏ φ : K →+* ℂ, (RingHom.equivRatAlgHom φ) x) = ∏ σ : K →ₐ[ℚ] ℂ, σ x :=
        Equiv.prod_comp RingHom.equivRatAlgHom (fun σ : K →ₐ[ℚ] ℂ => σ x)
      have h_apply : ∀ φ : K →+* ℂ, (RingHom.equivRatAlgHom φ) x = φ x := by
        intro φ
        rw [RingHom.equivRatAlgHom_apply, RingHom.toRatAlgHom_apply]
      simp_rw [h_apply] at h_reindex
      rw [h_reindex, ← h_prod_alg]
      rfl
    have hφ_ne : ∀ φ : K →+* ℂ, φ x ≠ 0 :=
      fun φ => (map_ne_zero φ).mpr hx_ne
    have h_norm_pos : ∀ φ : K →+* ℂ, 0 < ‖φ x‖ :=
      fun φ => norm_pos_iff.mpr (hφ_ne φ)
    have h_norm_c_ne : ∀ φ : K →+* ℂ, (‖φ x‖ : ℂ) ≠ 0 :=
      fun φ => Complex.ofReal_ne_zero.mpr (h_norm_pos φ).ne'
    let u : (K →+* ℂ) → ℂ := fun φ => φ x / (‖φ x‖ : ℂ)
    have h_factor : ∀ φ : K →+* ℂ, φ x = u φ * (‖φ x‖ : ℂ) := by
      intro φ
      dsimp [u]
      exact (div_mul_cancel₀ (φ x) (h_norm_c_ne φ)).symm
    have h_prod_factor :
        (∏ φ : K →+* ℂ, φ x) =
          (∏ φ : K →+* ℂ, u φ) * ((∏ φ : K →+* ℂ, ‖φ x‖ : ℝ) : ℂ) := by
      calc
        (∏ φ : K →+* ℂ, φ x) = ∏ φ : K →+* ℂ, (u φ * (‖φ x‖ : ℂ)) := by
          refine Finset.prod_congr rfl (fun φ _ => h_factor φ)
        _ = (∏ φ : K →+* ℂ, u φ) * (∏ φ : K →+* ℂ, (‖φ x‖ : ℂ)) := Finset.prod_mul_distrib
        _ = (∏ φ : K →+* ℂ, u φ) * ((∏ φ : K →+* ℂ, ‖φ x‖ : ℝ) : ℂ) := by
          rw [Complex.ofReal_prod]
    have hu_real : ∀ φ : K →+* ℂ, NumberField.ComplexEmbedding.IsReal φ → u φ = 1 := by
      intro φ hφ
      let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
      have hw : w.IsReal := NumberField.InfinitePlace.isReal_mk_iff.mpr hφ
      have hw_emb : w.embedding = φ := NumberField.InfinitePlace.embedding_mk_eq_of_isReal hφ
      have h_re_pos : 0 < (φ x).re := by
        have h1 := hα_pos w hw
        rwa [hw_emb] at h1
      have h_conj_φ : NumberField.ComplexEmbedding.conjugate φ = φ :=
        NumberField.ComplexEmbedding.isReal_iff.mp hφ
      have h_conj_x : (starRingEnd ℂ) (φ x) = φ x := by
        rw [← NumberField.ComplexEmbedding.conjugate_coe_eq φ x, h_conj_φ]
      have h_re_eq : ((φ x).re : ℂ) = φ x := Complex.conj_eq_iff_re.mp h_conj_x
      have h_norm_eq : ‖φ x‖ = (φ x).re := by
        calc ‖φ x‖ = ‖((φ x).re : ℂ)‖ := congrArg norm h_re_eq.symm
        _ = ‖(φ x).re‖ := Complex.norm_real (φ x).re
        _ = (φ x).re := Real.norm_of_nonneg h_re_pos.le
      dsimp [u]
      rw [h_norm_eq, h_re_eq]
      exact div_self (hφ_ne φ)
    have h_prod_u : (∏ φ : K →+* ℂ, u φ) = 1 := by
      refine Finset.prod_involution
        (fun (φ : K →+* ℂ) _ => NumberField.ComplexEmbedding.conjugate φ)
        ?_ ?_ ?_ ?_
      · intro φ _
        dsimp [u]
        rw [Complex.norm_conj (φ x), div_mul_div_comm, Complex.mul_conj' (φ x), ← sq]
        exact div_self (pow_ne_zero 2 (h_norm_c_ne φ))
      · intro φ _ hu_ne h_conj_eq
        exact hu_ne (hu_real φ (NumberField.ComplexEmbedding.isReal_iff.mpr h_conj_eq))
      · intro φ _
        exact Finset.mem_univ _
      · intro φ _
        exact NumberField.ComplexEmbedding.involutive_conjugate K φ
    have h_norm_c_eq :
        ((Algebra.norm ℚ x : ℚ) : ℂ) = ((∏ φ : K →+* ℂ, ‖φ x‖ : ℝ) : ℂ) := by
      rw [h_prod_ring, h_prod_factor, h_prod_u, one_mul]
    have h_norm_r_eq :
        (Algebra.norm ℚ x : ℝ) = ∏ φ : K →+* ℂ, ‖φ x‖ := by
      have h_re := congrArg Complex.re h_norm_c_eq
      simpa only [Complex.ratCast_re, Complex.ofReal_re] using h_re
    have h_prod_pos : 0 < ∏ φ : K →+* ℂ, ‖φ x‖ :=
      Finset.prod_pos (fun φ _ => h_norm_pos φ)
    have h_norm_r_pos : (0 : ℝ) < (Algebra.norm ℚ x : ℝ) := by
      rw [h_norm_r_eq]
      exact h_prod_pos
    have h_norm_q_pos : 0 < Algebra.norm ℚ x := by
      exact_mod_cast h_norm_r_pos
    have h_intNorm_q_pos : (0 : ℚ) < ((Algebra.intNorm ℤ R_K α : ℤ) : ℚ) := by
      rw [h_coe_norm]
      exact h_norm_q_pos
    have h_intNorm_pos : 0 < Algebra.intNorm ℤ R_K α := by
      exact_mod_cast h_intNorm_q_pos
    rw [Ideal.absNorm_span_singleton α, ← h_intNorm_eq]
    exact Int.natAbs_of_nonneg h_intNorm_pos.le
  have hα_Im : α - 1 ∈ I_m := h𝔪_le_Im hα_m
  have h_intNorm_zmod_one : ((Algebra.intNorm ℤ R_K α : ℤ) : ZMod m) = 1 := by
    let ι_B := Module.Free.ChooseBasisIndex ℤ R_K
    let B : Module.Basis ι_B ℤ R_K := NumberField.RingOfIntegers.basis K
    let Φ : R_K →+* Matrix ι_B ι_B ℤ :=
      ((LinearMap.toMatrixAlgEquiv B).toAlgHom.comp (Algebra.lmul ℤ R_K)).toRingHom
    have hΦ_apply : ∀ x : R_K, Φ x = LinearMap.toMatrix B B (Algebra.lmul ℤ R_K x) := by
      intro x
      ext i j
      rfl
    have h_det : Algebra.intNorm ℤ R_K α = (Φ α).det := by
      rw [Algebra.intNorm_eq_norm ℤ R_K, Algebra.norm_apply ℤ α,
        ← LinearMap.det_toMatrix B (Algebra.lmul ℤ R_K α), hΦ_apply α]
    let π : ℤ →+* ZMod m := Int.castRingHom (ZMod m)
    let Ψ : R_K →+* Matrix ι_B ι_B (ZMod m) := (π.mapMatrix).comp Φ
    have h_zmod_det : ((Algebra.intNorm ℤ R_K α : ℤ) : ZMod m) = (Ψ α).det := by
      rw [h_det]
      change π ((Φ α).det) = (Ψ α).det
      exact RingHom.map_det π (Φ α)
    rcases Ideal.mem_span_singleton.mp hα_Im with ⟨r, hr⟩
    have hα_eq : α = 1 + (m : R_K) * r := by
      rw [← hr, add_sub_cancel]
    have hm_mat : (m : Matrix ι_B ι_B (ZMod m)) = 0 := by
      ext i j
      rw [Matrix.natCast_apply, Matrix.zero_apply]
      split_ifs with hij
      · exact ZMod.natCast_self m
      · exact Nat.cast_zero
    have hΨ_α : Ψ α = 1 := by
      calc
        Ψ α = Ψ (1 + (m : R_K) * r) := by rw [← hα_eq]
        _ = 1 + (m : Matrix ι_B ι_B (ZMod m)) * Ψ r := by
          rw [map_add, map_one, map_mul, map_natCast]
        _ = 1 := by rw [hm_mat, zero_mul, add_zero]
    rw [h_zmod_det, hΨ_α, Matrix.det_one]
  have h_absNorm_zmod_one : (Ideal.absNorm (Ideal.span {α}) : ZMod m) = 1 := by
    have h_cast := congrArg (Int.cast : ℤ → ZMod m) h_absNorm_eq_intNorm
    rwa [Int.cast_natCast, h_intNorm_zmod_one] at h_cast
  have hu_eq_one : u_α = 1 := by
    apply Subtype.ext
    apply Units.ext
    rw [hu_val, h_absNorm_zmod_one]
    rfl
  rw [hθ_α, hu_eq_one, map_one]

theorem narrow_ray_relNorm_eq_of_fixedField_graph_subgroup {F E M : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Field M] [NumberField M] [Algebra F E] [IsGalois F E]
    [Algebra F M] [IsGalois F M] [Algebra E M] [IsScalarTower F E M]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q)
    (m : ℕ) (hm_one : 1 ≤ m)
    (ζ : NumberField.RingOfIntegers M)
    (Φ : (M ≃ₐ[F] M) ≃* (E ≃ₐ[F] E) × (ZMod m)ˣ)
    (hΦ_fst : ∀ τ : M ≃ₐ[F] M, (Φ τ).1 = AlgEquiv.restrictNormalHom E τ)
    (hΦ_frob_snd : ∀ (τ : M ≃ₐ[F] M) (k : ℕ) (Q : Ideal (NumberField.RingOfIntegers M)),
      Q.IsPrime →
      (m : NumberField.RingOfIntegers M) ∉ Q →
      τ • ζ - ζ ^ k ∈ Q →
      (((Φ τ).2 : (ZMod m)ˣ) : ZMod m) = (k : ZMod m))
    (U₀ : Subgroup (ZMod m)ˣ)
    (Ψ₀ : U₀ →* (E ≃ₐ[F] E))
    (hΨ₀_surj : ∃ u_gen : U₀, Ψ₀ u_gen = σ)
    (D : Subgroup (M ≃ₐ[F] M)) [D.Normal]
    (hD_iff : ∀ τ : M ≃ₐ[F] M,
      τ ∈ D ↔ ∃ h : (Φ τ).2 ∈ U₀, Ψ₀ ⟨(Φ τ).2, h⟩ = (Φ τ).1)
    (h_ker : ∀ {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
      [Algebra K L] [IsGalois K L]
      (σ_K : L ≃ₐ[K] L),
      (∀ ρ : L ≃ₐ[K] L, ρ ∈ Subgroup.zpowers σ_K) →
      ∀ (θ : Ideal (NumberField.RingOfIntegers K) → (L ≃ₐ[K] L)),
      θ ⊤ = 1 →
      (∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
        J₁ ≠ ⊥ → J₂ ≠ ⊥ → θ (J₁ * J₂) = θ J₁ * θ J₂) →
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        IsUnramifiedAtPrime K L P → FrobeniusClassAt K L P ⊆ {θ P.asIdeal}) →
      (∀ B : Ideal (NumberField.RingOfIntegers L),
        B ≠ ⊥ → θ (Ideal.relNorm (NumberField.RingOfIntegers K) B) = 1) →
      ∀ (𝔪 : Ideal (NumberField.RingOfIntegers K)),
      𝔪 ≠ ⊥ →
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ¬ IsUnramifiedAtPrime K L P → P.asIdeal ∣ 𝔪) →
      (∀ α : NumberField.RingOfIntegers K,
        α ≠ 0 →
        α - 1 ∈ 𝔪 →
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (α : K)).re) →
        θ (Ideal.span {α}) = 1) →
      ∀ (I₁ I₂ : Ideal (NumberField.RingOfIntegers K)),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ →
      IsCoprime I₁ 𝔪 → IsCoprime I₂ 𝔪 →
      θ I₁ = θ I₂ →
      ∃ (α₁ α₂ : NumberField.RingOfIntegers K)
        (C₁ C₂ : Ideal (NumberField.RingOfIntegers L)),
        α₁ ≠ 0 ∧ α₂ ≠ 0 ∧ C₁ ≠ ⊥ ∧ C₂ ≠ ⊥ ∧
        α₁ - 1 ∈ 𝔪 ∧ α₂ - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal →
          0 < (w.embedding (α₁ : K)).re ∧ 0 < (w.embedding (α₂ : K)).re) ∧
        I₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
          I₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂)
    (h_tower : ∀ {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
      [Algebra F K] [IsGalois F K] [Algebra K L] [Algebra E L] [Algebra F L]
      [IsScalarTower F K L] [IsScalarTower F E L]
      (I₁ I₂ : Ideal (NumberField.RingOfIntegers K))
      (α₁ α₂ : NumberField.RingOfIntegers K)
      (C₁ C₂ : Ideal (NumberField.RingOfIntegers L)),
      α₁ ≠ 0 → α₂ ≠ 0 →
      C₁ ≠ ⊥ → C₂ ≠ ⊥ →
      α₁ - 1 ∈ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K)) m₀ →
      α₂ - 1 ∈ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K)) m₀ →
      (∀ w : NumberField.InfinitePlace K,
        w.IsReal →
        0 < (w.embedding (α₁ : K)).re ∧ 0 < (w.embedding (α₂ : K)).re) →
      I₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
        I₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂ →
      ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
        (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        Ideal.relNorm (NumberField.RingOfIntegers F) I₁ * Ideal.span {a₁} *
            Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
          Ideal.relNorm (NumberField.RingOfIntegers F) I₂ * Ideal.span {a₂} *
            Ideal.relNorm (NumberField.RingOfIntegers F) B₂)
    (I₁ I₂ : Ideal (NumberField.RingOfIntegers (IntermediateField.fixedField D)))
    (hI₁_ne : I₁ ≠ ⊥) (hI₂_ne : I₂ ≠ ⊥)
    (hI₁_primes : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      p.asIdeal ∣ Ideal.relNorm (NumberField.RingOfIntegers F) I₁ →
      IsUnramifiedAtPrime F E p ∧ (m : NumberField.RingOfIntegers F) ∉ p.asIdeal)
    (hI₂_primes : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      p.asIdeal ∣ Ideal.relNorm (NumberField.RingOfIntegers F) I₂ →
      IsUnramifiedAtPrime F E p ∧ (m : NumberField.RingOfIntegers F) ∉ p.asIdeal)
    (u₁ u₂ : U₀)
    (hu₁ : ((u₁ : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm I₁ : ZMod m))
    (hu₂ : ((u₂ : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm I₂ : ZMod m))
    (hΨ_eq : Ψ₀ u₁ = Ψ₀ u₂) :
    ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
      (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      Ideal.relNorm (NumberField.RingOfIntegers F) I₁ * Ideal.span {a₁} *
          Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
        Ideal.relNorm (NumberField.RingOfIntegers F) I₂ * Ideal.span {a₂} *
          Ideal.relNorm (NumberField.RingOfIntegers F) B₂ :=
by
  refine exists_compositum_galois_equiv_and_frob_unit_of_fixedField_graph
    σ hCyclic m ζ Φ hΦ_fst hΦ_frob_snd U₀ Ψ₀ hΨ₀_surj D hD_iff _ ?_
  intro L _ _ _ _ _ _ _ _ ι hι_res h_frob_unit
  let σ_K : L ≃ₐ[IntermediateField.fixedField D] L := ι.symm σ
  have hCyclic_K : ∀ ρ : L ≃ₐ[IntermediateField.fixedField D] L, ρ ∈ Subgroup.zpowers σ_K := by
    intro ρ
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic (ι ρ)) with ⟨k, hk⟩
    rw [Subgroup.mem_zpowers_iff]
    refine ⟨k, ?_⟩
    dsimp [σ_K]
    rw [← map_zpow, hk, ι.symm_apply_apply]
  let Ψ'₀ : U₀ →* (L ≃ₐ[IntermediateField.fixedField D] L) :=
    ι.symm.toMonoidHom.comp Ψ₀
  have h_frob_unit' : ∀ P : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers (IntermediateField.fixedField D)),
      IsUnramifiedAtPrime (IntermediateField.fixedField D) L P →
      (m : NumberField.RingOfIntegers (IntermediateField.fixedField D)) ∉ P.asIdeal →
      ∃ (ρ_P : L ≃ₐ[IntermediateField.fixedField D] L) (u_P : U₀),
        ρ_P ∈ FrobeniusClassAt (IntermediateField.fixedField D) L P ∧
        (((u_P : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm P.asIdeal : ZMod m)) ∧
        ρ_P = Ψ'₀ u_P := by
    intro P _ hP_m
    obtain ⟨ρ_P, u_P, hρ_frob, hu_val, hι_eq⟩ := h_frob_unit P hP_m
    refine ⟨ρ_P, u_P, hρ_frob, hu_val, ?_⟩
    change ρ_P = ι.symm (Ψ₀ u_P)
    rw [← hι_eq, ι.symm_apply_apply]
  obtain ⟨θ, hθ_top, hθ_mul, hθ_frob, hθ_relNorm, hθ_unit⟩ :=
    exists_cyclic_artin_map_and_unit_hom_eq σ_K hCyclic_K m U₀ Ψ'₀ h_frob_unit'
  let 𝔪₀ : Ideal (NumberField.RingOfIntegers (IntermediateField.fixedField D)) :=
    Ideal.map (algebraMap (NumberField.RingOfIntegers F)
      (NumberField.RingOfIntegers (IntermediateField.fixedField D))) m₀
  have h𝔪₀_ne : 𝔪₀ ≠ ⊥ :=
    (Ideal.map_eq_bot_iff_of_injective
      (FaithfulSMul.algebraMap_injective
        (NumberField.RingOfIntegers F)
        (NumberField.RingOfIntegers (IntermediateField.fixedField D)))).not.mpr hm₀_ne
  obtain ⟨𝔪, h𝔪_ne, h𝔪_le, h𝔪_ram, h𝔪_cop, h𝔪_ker⟩ :=
    exists_modulus_and_principal_ray_ker_of_unit_hom_eq 𝔪₀ h𝔪₀_ne m hm_one U₀ Ψ'₀ θ hθ_unit
  have h_res_inj : Function.Injective
      (fun ρ : L ≃ₐ[IntermediateField.fixedField D] L =>
        AlgEquiv.restrictNormalHom E (ρ.restrictScalars F)) := by
    intro ρ₁ ρ₂ h_eq
    apply ι.injective
    rw [hι_res ρ₁, hι_res ρ₂]
    exact h_eq
  have hI₁_transfer : ∀ P : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers (IntermediateField.fixedField D)),
      P.asIdeal ∣ I₁ →
      IsUnramifiedAtPrime (IntermediateField.fixedField D) L P ∧
      (m : NumberField.RingOfIntegers (IntermediateField.fixedField D)) ∉ P.asIdeal ∧
      ¬ (P.asIdeal ∣ 𝔪₀) :=
    fun P hP => isUnramifiedAtPrime_and_not_dvd_map_of_relNorm_primes
      h_res_inj m₀ hm₀_ram m I₁ hI₁_primes P hP
  have hI₂_transfer : ∀ P : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers (IntermediateField.fixedField D)),
      P.asIdeal ∣ I₂ →
      IsUnramifiedAtPrime (IntermediateField.fixedField D) L P ∧
      (m : NumberField.RingOfIntegers (IntermediateField.fixedField D)) ∉ P.asIdeal ∧
      ¬ (P.asIdeal ∣ 𝔪₀) :=
    fun P hP => isUnramifiedAtPrime_and_not_dvd_map_of_relNorm_primes
      h_res_inj m₀ hm₀_ram m I₂ hI₂_primes P hP
  have hI₁_cop : IsCoprime I₁ 𝔪 := h𝔪_cop I₁ hI₁_ne hI₁_transfer
  have hI₂_cop : IsCoprime I₂ 𝔪 := h𝔪_cop I₂ hI₂_ne hI₂_transfer
  obtain ⟨u'₁, hu'₁_val, hθ_I₁⟩ :=
    hθ_unit I₁ hI₁_ne (fun P hP => ⟨(hI₁_transfer P hP).1, (hI₁_transfer P hP).2.1⟩)
  obtain ⟨u'₂, hu'₂_val, hθ_I₂⟩ :=
    hθ_unit I₂ hI₂_ne (fun P hP => ⟨(hI₂_transfer P hP).1, (hI₂_transfer P hP).2.1⟩)
  have hu'₁_eq : u'₁ = u₁ := by
    apply Subtype.ext
    apply Units.ext
    exact hu'₁_val.trans hu₁.symm
  have hu'₂_eq : u'₂ = u₂ := by
    apply Subtype.ext
    apply Units.ext
    exact hu'₂_val.trans hu₂.symm
  have hθ_eq : θ I₁ = θ I₂ := by
    rw [hθ_I₁, hθ_I₂, hu'₁_eq, hu'₂_eq]
    change ι.symm (Ψ₀ u₁) = ι.symm (Ψ₀ u₂)
    rw [hΨ_eq]
  obtain ⟨α₁, α₂, C₁, C₂, hα₁_ne, hα₂_ne, hC₁_ne, hC₂_ne, hα₁_m, hα₂_m, hα_pos, h_rel_K⟩ :=
    h_ker σ_K hCyclic_K θ hθ_top hθ_mul hθ_frob hθ_relNorm
      𝔪 h𝔪_ne h𝔪_ram h𝔪_ker I₁ I₂ hI₁_ne hI₂_ne hI₁_cop hI₂_cop hθ_eq
  exact h_tower I₁ I₂ α₁ α₂ C₁ C₂ hα₁_ne hα₂_ne hC₁_ne hC₂_ne
    (h𝔪_le hα₁_m) (h𝔪_le hα₂_m) hα_pos h_rel_K

theorem exists_base_ideal_of_zmod_subgroups_and_tower_reduction {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_map : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ x : NumberField.RingOfIntegers E,
        (σ ^ (e q)) • x - x ^ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ∈
          Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q)
    (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)))
    (hS_unr : ∀ q ∈ S, IsUnramifiedAtPrime F E q)
    (m : ℕ)
    (u_S : (ZMod m)ˣ)
    (U : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → Subgroup (ZMod m)ˣ)
    (Ψ : ∀ q, U q →* (E ≃ₐ[F] E))
    (hm_one : 1 ≤ m)
    (hm_sq : Squarefree m)
    (hm_gt : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m →
      max (Ideal.absNorm m₀)
        (max (Ideal.absNorm (differentIdeal ℤ (NumberField.RingOfIntegers E)))
          (S.sup (fun q => Ideal.absNorm q.asIdeal))) < ℓ)
    (h_units : ∀ q ∈ S,
      (∃ u_q : U q,
        (((u_q : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm q.asIdeal : ZMod m)) ∧
        Ψ q u_q = σ ^ (e q)) ∧
      (∃ u_gen : U q, (u_gen : (ZMod m)ˣ) = u_S ∧ Ψ q u_gen = σ))
    (h_ker : ∀ {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
      [Algebra K L] [IsGalois K L]
      (σ_K : L ≃ₐ[K] L),
      (∀ ρ : L ≃ₐ[K] L, ρ ∈ Subgroup.zpowers σ_K) →
      ∀ (θ : Ideal (NumberField.RingOfIntegers K) → (L ≃ₐ[K] L)),
      θ ⊤ = 1 →
      (∀ J₁ J₂ : Ideal (NumberField.RingOfIntegers K),
        J₁ ≠ ⊥ → J₂ ≠ ⊥ → θ (J₁ * J₂) = θ J₁ * θ J₂) →
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        IsUnramifiedAtPrime K L P → FrobeniusClassAt K L P ⊆ {θ P.asIdeal}) →
      (∀ B : Ideal (NumberField.RingOfIntegers L),
        B ≠ ⊥ → θ (Ideal.relNorm (NumberField.RingOfIntegers K) B) = 1) →
      ∀ (𝔪 : Ideal (NumberField.RingOfIntegers K)),
      𝔪 ≠ ⊥ →
      (∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ¬ IsUnramifiedAtPrime K L P → P.asIdeal ∣ 𝔪) →
      (∀ α : NumberField.RingOfIntegers K,
        α ≠ 0 →
        α - 1 ∈ 𝔪 →
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (α : K)).re) →
        θ (Ideal.span {α}) = 1) →
      ∀ (I₁ I₂ : Ideal (NumberField.RingOfIntegers K)),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ →
      IsCoprime I₁ 𝔪 → IsCoprime I₂ 𝔪 →
      θ I₁ = θ I₂ →
      ∃ (α₁ α₂ : NumberField.RingOfIntegers K)
        (C₁ C₂ : Ideal (NumberField.RingOfIntegers L)),
        α₁ ≠ 0 ∧ α₂ ≠ 0 ∧ C₁ ≠ ⊥ ∧ C₂ ≠ ⊥ ∧
        α₁ - 1 ∈ 𝔪 ∧ α₂ - 1 ∈ 𝔪 ∧
        (∀ w : NumberField.InfinitePlace K,
          w.IsReal →
          0 < (w.embedding (α₁ : K)).re ∧ 0 < (w.embedding (α₂ : K)).re) ∧
        I₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
          I₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂)
    (h_tower : ∀ {K L : Type u} [Field K] [NumberField K] [Field L] [NumberField L]
      [Algebra F K] [IsGalois F K] [Algebra K L] [Algebra E L] [Algebra F L]
      [IsScalarTower F K L] [IsScalarTower F E L]
      (I₁ I₂ : Ideal (NumberField.RingOfIntegers K))
      (α₁ α₂ : NumberField.RingOfIntegers K)
      (C₁ C₂ : Ideal (NumberField.RingOfIntegers L)),
      α₁ ≠ 0 → α₂ ≠ 0 →
      C₁ ≠ ⊥ → C₂ ≠ ⊥ →
      α₁ - 1 ∈ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K)) m₀ →
      α₂ - 1 ∈ Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K)) m₀ →
      (∀ w : NumberField.InfinitePlace K,
        w.IsReal →
        0 < (w.embedding (α₁ : K)).re ∧ 0 < (w.embedding (α₂ : K)).re) →
      I₁ * Ideal.span {α₁} * Ideal.relNorm (NumberField.RingOfIntegers K) C₁ =
        I₂ * Ideal.span {α₂} * Ideal.relNorm (NumberField.RingOfIntegers K) C₂ →
      ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
        (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
        a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
        a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal →
          0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
        Ideal.relNorm (NumberField.RingOfIntegers F) I₁ * Ideal.span {a₁} *
            Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
          Ideal.relNorm (NumberField.RingOfIntegers F) I₂ * Ideal.span {a₂} *
            Ideal.relNorm (NumberField.RingOfIntegers F) B₂) :
    ∃ K₀ : Ideal (NumberField.RingOfIntegers F),
      K₀ ≠ ⊥ ∧
      ∀ q ∈ S,
        ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
          (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
          a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
          a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal →
            0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
          q.asIdeal * Ideal.span {a₁} * Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
            K₀ ^ (e q) * Ideal.span {a₂} * Ideal.relNorm (NumberField.RingOfIntegers F) B₂ :=
by
  have hm_unr : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ m →
      Ideal.absNorm (differentIdeal ℤ (NumberField.RingOfIntegers E)) < ℓ := by
    intro ℓ hℓ hℓm
    exact (le_max_of_le_right (le_max_left _ _)).trans_lt (hm_gt ℓ hℓ hℓm)
  refine exists_ambient_cyclotomic_galois_equiv_reduction (F := F) (E := E) m hm_one hm_sq hm_unr _ ?_
  intro M _ _ _ _ _ _ ζ Φ hΦ_fst hΦ_frob_snd
  have hE_comm : ∀ g₁ g₂ : E ≃ₐ[F] E, g₁ * g₂ = g₂ * g₁ := by
    intro g₁ g₂
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic g₁) with ⟨k₁, rfl⟩
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic g₂) with ⟨k₂, rfl⟩
    rw [← zpow_add, add_comm, zpow_add]
  have hM_comm : ∀ τ₁ τ₂ : M ≃ₐ[F] M, τ₁ * τ₂ = τ₂ * τ₁ := by
    intro τ₁ τ₂
    apply Φ.injective
    rw [map_mul, map_mul]
    exact Prod.ext (hE_comm (Φ τ₁).1 (Φ τ₂).1) (mul_comm (Φ τ₁).2 (Φ τ₂).2)
  let τ₀ : M ≃ₐ[F] M := Φ.symm (σ, u_S)
  have hΦ_τ₀ : Φ τ₀ = (σ, u_S) := Φ.apply_symm_apply (σ, u_S)
  obtain ⟨K₀, hK₀_ne, hK₀_primes, hK₀_norm, hK₀_lift⟩ :=
    exists_base_ideal_absNorm_zmod_and_relNorm_of_fixedField
      σ hCyclic m hm_one ζ Φ hΦ_frob_snd τ₀
  have hΦ_τ₀_fst : (Φ τ₀).1 = σ := by rw [hΦ_τ₀]
  have hΦ_τ₀_snd : (Φ τ₀).2 = u_S := by rw [hΦ_τ₀]
  rw [hΦ_τ₀_snd] at hK₀_norm
  refine ⟨K₀, hK₀_ne, fun q hqS => ?_⟩
  let D_q : Subgroup (M ≃ₐ[F] M) :=
    { carrier := { τ | ∃ h : (Φ τ).2 ∈ U q, Ψ q ⟨(Φ τ).2, h⟩ = (Φ τ).1 }
      one_mem' := by
        refine ⟨by rw [map_one]; exact (U q).one_mem, ?_⟩
        have h1 : (⟨(Φ 1).2, by rw [map_one]; exact (U q).one_mem⟩ : U q) = 1 := by
          apply Subtype.ext
          change (Φ 1).2 = 1
          rw [map_one]
          rfl
        rw [h1, map_one, map_one]
        rfl
      mul_mem' := by
        rintro τ₁ τ₂ ⟨h₁, hΨ₁⟩ ⟨h₂, hΨ₂⟩
        refine ⟨by rw [map_mul]; exact (U q).mul_mem h₁ h₂, ?_⟩
        have h_mul :
            (⟨(Φ (τ₁ * τ₂)).2, by rw [map_mul]; exact (U q).mul_mem h₁ h₂⟩ : U q) =
              ⟨(Φ τ₁).2, h₁⟩ * ⟨(Φ τ₂).2, h₂⟩ := by
          apply Subtype.ext
          change (Φ (τ₁ * τ₂)).2 = (Φ τ₁).2 * (Φ τ₂).2
          rw [map_mul]
          rfl
        rw [h_mul, map_mul, hΨ₁, hΨ₂, map_mul]
        rfl
      inv_mem' := by
        rintro τ ⟨h₁, hΨ₁⟩
        refine ⟨by rw [map_inv]; exact (U q).inv_mem h₁, ?_⟩
        have h_inv :
            (⟨(Φ τ⁻¹).2, by rw [map_inv]; exact (U q).inv_mem h₁⟩ : U q) =
              (⟨(Φ τ).2, h₁⟩)⁻¹ := by
          apply Subtype.ext
          change (Φ τ⁻¹).2 = ((Φ τ).2)⁻¹
          rw [map_inv]
          rfl
        rw [h_inv, map_inv, hΨ₁, map_inv]
        rfl }
  haveI hDq_norm : D_q.Normal :=
    ⟨fun n hn g => by
      have h_eq : g * n * g⁻¹ = n := by
        rw [hM_comm g n, mul_assoc, mul_inv_cancel, mul_one]
      rwa [h_eq]⟩
  have hD_iff : ∀ τ : M ≃ₐ[F] M,
      τ ∈ D_q ↔ ∃ h : (Φ τ).2 ∈ U q, Ψ q ⟨(Φ τ).2, h⟩ = (Φ τ).1 :=
    fun _ => Iff.rfl
  obtain ⟨⟨u_q, hu_q_val, hu_q_Ψ⟩, ⟨u_gen, hu_gen_val, hu_gen_Ψ⟩⟩ := h_units q hqS
  have hτ₀_in : τ₀ ∈ D_q := by
    rw [hD_iff]
    have h_mem : (Φ τ₀).2 ∈ U q := by
      rw [hΦ_τ₀_snd, ← hu_gen_val]
      exact u_gen.2
    refine ⟨h_mem, ?_⟩
    have h_sub_eq : (⟨(Φ τ₀).2, h_mem⟩ : U q) = u_gen := by
      apply Subtype.ext
      exact hΦ_τ₀_snd.trans hu_gen_val.symm
    rw [h_sub_eq, hu_gen_Ψ, hΦ_τ₀_fst]
  obtain ⟨J₀, hJ₀_ne, hJ₀_rel⟩ := hK₀_lift D_q hτ₀_in
  have hq_m : (m : NumberField.RingOfIntegers F) ∉ q.asIdeal := by
    intro hm_in
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    let k_q := NumberField.RingOfIntegers F ⧸ q.asIdeal
    letI : Field k_q := Ideal.Quotient.field q.asIdeal
    letI : Fintype k_q := Fintype.ofFinite k_q
    rcases CharP.exists k_q with ⟨p_char, hp_char⟩
    have hp_prime : p_char.Prime :=
      (CharP.char_is_prime_or_zero k_q p_char).resolve_right (CharP.char_ne_zero_of_finite k_q p_char)
    have hm_zero : (m : k_q) = 0 := by
      rw [← map_natCast (Ideal.Quotient.mk q.asIdeal)]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hm_in
    have hp_dvd_m : p_char ∣ m := (CharP.cast_eq_zero_iff k_q p_char m).mp hm_zero
    have h_card_eq : Ideal.absNorm q.asIdeal = Fintype.card k_q := by
      rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
    have h_norm_zero : (Ideal.absNorm q.asIdeal : k_q) = 0 := by
      rw [h_card_eq]
      exact Nat.cast_card_eq_zero k_q
    have hp_dvd_norm : p_char ∣ Ideal.absNorm q.asIdeal :=
      (CharP.cast_eq_zero_iff k_q p_char (Ideal.absNorm q.asIdeal)).mp h_norm_zero
    have h_norm_pos : 0 < Ideal.absNorm q.asIdeal := by
      rw [h_card_eq]
      exact Fintype.card_pos
    have hp_le_norm : p_char ≤ Ideal.absNorm q.asIdeal :=
      Nat.le_of_dvd h_norm_pos hp_dvd_norm
    have h_norm_le_sup :
        Ideal.absNorm q.asIdeal ≤ S.sup (fun q' => Ideal.absNorm q'.asIdeal) :=
      Finset.le_sup (f := fun q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) =>
        Ideal.absNorm q'.asIdeal) hqS
    have h_norm_lt_p : Ideal.absNorm q.asIdeal < p_char :=
      (h_norm_le_sup.trans (le_max_of_le_right (le_max_right _ _))).trans_lt
        (hm_gt p_char hp_prime hp_dvd_m)
    exact not_lt_of_ge hp_le_norm h_norm_lt_p
  have hD_frob : ∀ τ : M ≃ₐ[F] M,
      (Φ τ).1 = σ ^ (e q) →
      (((Φ τ).2 : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm q.asIdeal : ZMod m) →
      τ ∈ D_q := by
    intro τ hτ₁ hτ₂
    rw [hD_iff]
    have h_unit_eq : (Φ τ).2 = (u_q : (ZMod m)ˣ) := by
      apply Units.ext
      exact hτ₂.trans hu_q_val.symm
    have h_mem : (Φ τ).2 ∈ U q := by
      rw [h_unit_eq]
      exact u_q.2
    refine ⟨h_mem, ?_⟩
    have h_sub_eq : (⟨(Φ τ).2, h_mem⟩ : U q) = u_q := Subtype.ext h_unit_eq
    rw [h_sub_eq, hu_q_Ψ, hτ₁]
  obtain ⟨P_q, hPq_ne, hPq_rel⟩ :=
    exists_prime_over_relNorm_eq_self_of_fixedField
      σ e he_map m ζ Φ hΦ_fst hΦ_frob_snd q (hS_unr q hqS) hq_m D_q hD_frob
  let I₁ : Ideal (NumberField.RingOfIntegers (IntermediateField.fixedField D_q)) := P_q
  let I₂ : Ideal (NumberField.RingOfIntegers (IntermediateField.fixedField D_q)) := J₀ ^ (e q)
  have hI₂_ne : I₂ ≠ ⊥ := by
    change J₀ ^ (e q) ≠ ⊥
    rw [← Submodule.zero_eq_bot] at hJ₀_ne ⊢
    exact pow_ne_zero (e q) hJ₀_ne
  have hI₂_rel : Ideal.relNorm (NumberField.RingOfIntegers F) I₂ = K₀ ^ (e q) := by
    change Ideal.relNorm (NumberField.RingOfIntegers F) (J₀ ^ (e q)) = K₀ ^ (e q)
    rw [map_pow, hJ₀_rel]
  have hI₁_primes : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      p.asIdeal ∣ Ideal.relNorm (NumberField.RingOfIntegers F) I₁ →
      IsUnramifiedAtPrime F E p ∧ (m : NumberField.RingOfIntegers F) ∉ p.asIdeal := by
    intro p hp_dvd
    change p.asIdeal ∣ Ideal.relNorm (NumberField.RingOfIntegers F) P_q at hp_dvd
    rw [hPq_rel] at hp_dvd
    have hp_le : q.asIdeal ≤ p.asIdeal := Ideal.dvd_iff_le.mp hp_dvd
    have hp_eq_ideal : q.asIdeal = p.asIdeal :=
      q.isMaximal.eq_of_le p.isMaximal.ne_top hp_le
    have hp_eq : q = p := IsDedekindDomain.HeightOneSpectrum.ext hp_eq_ideal
    subst hp_eq
    exact ⟨hS_unr q hqS, hq_m⟩
  have hI₂_primes : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      p.asIdeal ∣ Ideal.relNorm (NumberField.RingOfIntegers F) I₂ →
      IsUnramifiedAtPrime F E p ∧ (m : NumberField.RingOfIntegers F) ∉ p.asIdeal := by
    intro p hp_dvd
    rw [hI₂_rel] at hp_dvd
    exact hK₀_primes p (p.prime.dvd_of_dvd_pow hp_dvd)
  have hu₁ : ((u_q : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm I₁ : ZMod m) := by
    have h_abs : Ideal.absNorm I₁ = Ideal.absNorm q.asIdeal := by
      have h1 := Ideal.absNorm_relNorm (NumberField.RingOfIntegers F)
        (NumberField.RingOfIntegers (IntermediateField.fixedField D_q)) P_q
      rw [hPq_rel] at h1
      exact h1.symm
    rw [h_abs]
    exact hu_q_val
  let u₂ : U q := u_gen ^ (e q)
  have hu₂ : ((u₂ : (ZMod m)ˣ) : ZMod m) = (Ideal.absNorm I₂ : ZMod m) := by
    have h_abs_J₀ : Ideal.absNorm J₀ = Ideal.absNorm K₀ := by
      have h1 := Ideal.absNorm_relNorm (NumberField.RingOfIntegers F)
        (NumberField.RingOfIntegers (IntermediateField.fixedField D_q)) J₀
      rw [hJ₀_rel] at h1
      exact h1.symm
    have h_abs : Ideal.absNorm I₂ = (Ideal.absNorm K₀) ^ (e q) := by
      change Ideal.absNorm (J₀ ^ (e q)) = (Ideal.absNorm K₀) ^ (e q)
      rw [map_pow, h_abs_J₀]
    have h_u₂_val : ((u₂ : (ZMod m)ˣ) : ZMod m) = ((u_gen : (ZMod m)ˣ) : ZMod m) ^ (e q) := rfl
    rw [h_u₂_val, hu_gen_val, ← hK₀_norm, ← Nat.cast_pow, ← h_abs]
  have hΨ_eq : Ψ q u_q = Ψ q u₂ := by
    dsimp [u₂]
    rw [hu_q_Ψ, map_pow, hu_gen_Ψ]
  obtain ⟨a₁, a₂, B₁, B₂, ha₁_ne, ha₂_ne, hB₁_ne, hB₂_ne, ha₁_m₀, ha₂_m₀, ha_pos, h_rel_eq⟩ :=
    narrow_ray_relNorm_eq_of_fixedField_graph_subgroup
      σ hCyclic m₀ hm₀_ne hm₀_ram m hm_one ζ Φ hΦ_fst hΦ_frob_snd
      (U q) (Ψ q) ⟨u_gen, hu_gen_Ψ⟩ D_q hD_iff h_ker h_tower
      I₁ I₂ hPq_ne hI₂_ne hI₁_primes hI₂_primes u_q u₂ hu₁ hu₂ hΨ_eq
  change Ideal.relNorm (NumberField.RingOfIntegers F) P_q * Ideal.span {a₁} *
      Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
    Ideal.relNorm (NumberField.RingOfIntegers F) I₂ * Ideal.span {a₂} *
      Ideal.relNorm (NumberField.RingOfIntegers F) B₂ at h_rel_eq
  rw [hPq_rel, hI₂_rel] at h_rel_eq
  exact ⟨a₁, a₂, B₁, B₂, ha₁_ne, ha₂_ne, hB₁_ne, hB₂_ne, ha₁_m₀, ha₂_m₀, ha_pos, h_rel_eq⟩

theorem exists_base_ideal_and_prime_narrow_ray_relNorm_eq {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_map : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ x : NumberField.RingOfIntegers E,
        (σ ^ (e q)) • x - x ^ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ∈
          Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal)
    (h_cyc_base : ∀ (m : ℕ), 1 ≤ m →
      ∀ (a' : NumberField.RingOfIntegers F),
        a' ≠ 0 →
        a' - 1 ∈ Ideal.span {(m : NumberField.RingOfIntegers F)} →
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ¬ IsUnramifiedAtPrime F E q → a' - 1 ∈ q.asIdeal) →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a' : F)).re) →
        Ideal.absNorm (Ideal.span {a'}) ≡ 1 [MOD m] ∧
        ∀ ζ : NumberField.RingOfIntegers E,
          ζ ^ m = 1 →
          (σ ^ (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) //
              IsUnramifiedAtPrime F E q },
            e q.1 * (-WithZero.log (q.1.intValuation a')).toNat)) • ζ = ζ)
    (h_artin_prime : ∀ (a v r₀ B : ℕ),
      2 ≤ a → v.Prime →
      ∃ (r ℓ : ℕ),
        r₀ ≤ r ∧ ℓ.Prime ∧ B < ℓ ∧ Nat.Coprime a ℓ ∧ orderOf (a : ZMod ℓ) = v ^ r)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q)
    (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)))
    (hS_unr : ∀ q ∈ S, IsUnramifiedAtPrime F E q) :
    ∃ K₀ : Ideal (NumberField.RingOfIntegers F),
      K₀ ≠ ⊥ ∧
      ∀ q ∈ S,
        ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
          (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
          a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
          a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal →
            0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
          q.asIdeal * Ideal.span {a₁} * Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
            K₀ ^ (e q) * Ideal.span {a₂} * Ideal.relNorm (NumberField.RingOfIntegers F) B₂ :=
by
  let B : ℕ :=
    max (Ideal.absNorm m₀)
      (max (Ideal.absNorm (differentIdeal ℤ (NumberField.RingOfIntegers E)))
        (S.sup (fun q => Ideal.absNorm q.asIdeal)))
  have ha_ge_two : ∀ q ∈ S, 2 ≤ Ideal.absNorm q.asIdeal := by
    intro q _
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    letI := Ideal.Quotient.field q.asIdeal
    letI := Fintype.ofFinite (NumberField.RingOfIntegers F ⧸ q.asIdeal)
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  obtain ⟨m, u_S, U, Ψ, hm_one, hm_sq, hm_gt, h_units⟩ :=
    exists_zmod_units_subgroups_and_homs_of_artin_prime
      σ hCyclic h_artin_prime B S (fun q => Ideal.absNorm q.asIdeal) e ha_ge_two
  exact exists_base_ideal_of_zmod_subgroups_and_tower_reduction
    σ hCyclic e he_map m₀ hm₀_ne hm₀_ram S hS_unr
    m u_S U Ψ hm_one hm_sq hm_gt h_units
    (fun σ_K hCyc_K θ htop hmul hfrob hrel 𝔪 h𝔪_ne h𝔪_ram h𝔪_ker I₁ I₂ hI₁ hI₂ hcop₁ hcop₂ hθ_eq =>
      narrow_ray_relNorm_eq_of_cyclic_principal_ray_ker
        σ_K hCyc_K θ htop hmul hfrob hrel 𝔪 h𝔪_ne h𝔪_ram h𝔪_ker I₁ I₂ hI₁ hI₂ hcop₁ hcop₂ hθ_eq)
    (fun I₁ I₂ α₁ α₂ C₁ C₂ hα₁ hα₂ hC₁ hC₂ hm₁ hm₂ hpos heq =>
      relNorm_narrow_ray_eq_of_isGalois_tower
        m₀ I₁ I₂ α₁ α₂ C₁ C₂ hα₁ hα₂ hC₁ hC₂ hm₁ hm₂ hpos heq)

theorem exists_narrow_ray_relNorm_eq_of_artin_eq_one {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_map : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ x : NumberField.RingOfIntegers E,
        (σ ^ (e q)) • x - x ^ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ∈
          Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal)
    (h_cyc_base : ∀ (m : ℕ), 1 ≤ m →
      ∀ (a' : NumberField.RingOfIntegers F),
        a' ≠ 0 →
        a' - 1 ∈ Ideal.span {(m : NumberField.RingOfIntegers F)} →
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ¬ IsUnramifiedAtPrime F E q → a' - 1 ∈ q.asIdeal) →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a' : F)).re) →
        Ideal.absNorm (Ideal.span {a'}) ≡ 1 [MOD m] ∧
        ∀ ζ : NumberField.RingOfIntegers E,
          ζ ^ m = 1 →
          (σ ^ (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) //
              IsUnramifiedAtPrime F E q },
            e q.1 * (-WithZero.log (q.1.intValuation a')).toNat)) • ζ = ζ)
    (θ : Ideal (NumberField.RingOfIntegers F) → (E ≃ₐ[F] E))
    (hθ_top : θ ⊤ = 1)
    (hθ_mul : ∀ I₁ I₂ : Ideal (NumberField.RingOfIntegers F),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂)
    (hθ_frob : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {θ q.asIdeal})
    (hθ_span : ∀ a : NumberField.RingOfIntegers F,
      a ≠ 0 →
      θ (Ideal.span {a}) =
        σ ^ (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) //
            IsUnramifiedAtPrime F E q },
          e q.1 * (-WithZero.log (q.1.intValuation a)).toNat))
    (hθ_relNorm : ∀ B : Ideal (NumberField.RingOfIntegers E),
      B ≠ ⊥ → θ (Ideal.relNorm (NumberField.RingOfIntegers F) B) = 1)
    (m₀ : Ideal (NumberField.RingOfIntegers F))
    (hm₀_ne : m₀ ≠ ⊥)
    (hm₀_ram : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q)
    (I : Ideal (NumberField.RingOfIntegers F))
    (hI_ne : I ≠ ⊥)
    (hI_unr : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      q.asIdeal ∣ I → IsUnramifiedAtPrime F E q)
    (hI_ker : θ I = 1) :
    ∃ (a₁ a₂ : NumberField.RingOfIntegers F)
      (B₁ B₂ : Ideal (NumberField.RingOfIntegers E)),
      a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
      a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
      (∀ w : NumberField.InfinitePlace F,
        w.IsReal →
        0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
      I * Ideal.span {a₁} * Ideal.relNorm (NumberField.RingOfIntegers F) B₁ =
        Ideal.span {a₂} * Ideal.relNorm (NumberField.RingOfIntegers F) B₂ :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  
  have he_θ : ∀ q : ι, IsUnramifiedAtPrime F E q → θ q.asIdeal = σ ^ (e q) := by
    intro q hq
    haveI : q.asIdeal.IsPrime := q.isPrime
    obtain ⟨⟨Q, hQ_mem⟩⟩ := Ideal.nonempty_primesOver (P := q.asIdeal) (S := R_E)
    have hQ_prime : Q.IsPrime := hQ_mem.1
    have hQ_under : Ideal.under R_F Q = q.asIdeal := hQ_mem.2.1.symm
    have h_map_le : Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ Q :=
      Ideal.map_le_iff_le_comap.mpr hQ_under.symm.le
    have h_in_frob : σ ^ (e q) ∈ FrobeniusClassAt F E q := by
      refine ⟨Q, hQ_prime, hQ_under, fun x z hz => ?_⟩
      have hzx : z = (σ ^ (e q)) • x := Subtype.ext hz
      rw [hzx]
      exact h_map_le (he_map q hq x)
    exact (Set.mem_singleton_iff.mp (hθ_frob q hq h_in_frob)).symm
  let P_prod : (ι →₀ ℕ) → Ideal R_F := fun f => f.prod (fun q m => q.asIdeal ^ m)
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal : ι → Ideal R_F) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  have h_toMultiset_prod :
      ∀ f : ι →₀ ℕ,
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod =
          P_prod f := by
    intro f
    unfold P_prod
    rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
      Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
  have h_pow_ne_bot : ∀ (q : ι) (m : ℕ), q.asIdeal ^ m ≠ ⊥ := by
    intro q m
    rw [← Submodule.zero_eq_bot]
    exact pow_ne_zero m (by rw [Submodule.zero_eq_bot]; exact q.ne_bot)
  have hθ_pow : ∀ (q : ι), IsUnramifiedAtPrime F E q → ∀ (m : ℕ), θ (q.asIdeal ^ m) = σ ^ (e q * m) := by
    intro q hq m
    induction m with
    | zero =>
      rw [pow_zero, Ideal.one_eq_top, hθ_top, mul_zero, pow_zero]
    | succ m ih =>
      rw [pow_succ, hθ_mul (q.asIdeal ^ m) q.asIdeal (h_pow_ne_bot q m) q.ne_bot,
        ih, he_θ q hq, mul_add, mul_one, pow_add]
  have h_finset_prod_ne_bot : ∀ (s : Finset ι) (g : ι → ℕ),
      (∏ q ∈ s, q.asIdeal ^ g q) ≠ ⊥ := by
    intro s g
    rw [← Submodule.zero_eq_bot]
    apply Finset.prod_ne_zero_iff.mpr
    intro q _
    rw [Submodule.zero_eq_bot]
    exact h_pow_ne_bot q (g q)
  have hθ_finset_prod : ∀ (s : Finset ι) (g : ι → ℕ),
      (∀ q ∈ s, IsUnramifiedAtPrime F E q) →
      θ (∏ q ∈ s, q.asIdeal ^ g q) = σ ^ (∑ q ∈ s, e q * g q) := by
    intro s g
    refine Finset.induction_on s ?_ ?_
    · intro _
      rw [Finset.prod_empty, Ideal.one_eq_top, hθ_top, Finset.sum_empty, pow_zero]
    · intro q s hq_not_mem ih hs_unr
      have hq_unr : IsUnramifiedAtPrime F E q := hs_unr q (Finset.mem_insert_self q s)
      have hs_unr' : ∀ q' ∈ s, IsUnramifiedAtPrime F E q' :=
        fun q' hq' => hs_unr q' (Finset.mem_insert_of_mem hq')
      rw [Finset.prod_insert hq_not_mem,
        hθ_mul (q.asIdeal ^ g q) (∏ q' ∈ s, q'.asIdeal ^ g q')
          (h_pow_ne_bot q (g q)) (h_finset_prod_ne_bot s g),
        hθ_pow q hq_unr (g q), ih hs_unr',
        Finset.sum_insert hq_not_mem, pow_add]
  let N := UniqueFactorizationMonoid.normalizedFactors I
  let m_ms : Multiset ι :=
    Multiset.pmap
      (fun (p : Ideal R_F) (hp : Prime p) =>
        IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
      N
      (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
  let f : ι →₀ ℕ := Multiset.toFinsupp m_ms
  have hIf : I = P_prod f := by
    rw [← h_toMultiset_prod f]
    have hfm : Finsupp.toMultiset f = m_ms := Multiset.toFinsupp_toMultiset m_ms
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m_ms = N := by
      dsimp [m_ms]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact (prod_normalizedFactors_eq_self hI_ne).symm
  have hf_supp : ∀ q ∈ f.support, IsUnramifiedAtPrime F E q := by
    intro q hq
    apply hI_unr q
    rw [hIf]
    unfold P_prod
    rw [Finsupp.prod]
    have h_dvd_pow : q.asIdeal ∣ q.asIdeal ^ f q :=
      dvd_pow_self _ (Finsupp.mem_support_iff.mp hq)
    exact dvd_trans h_dvd_pow (Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ f q') hq)
  have hf_dvd : Module.finrank F E ∣ f.sum (fun q m => e q * m) := by
    have hθ_I : θ I = σ ^ (f.sum (fun q m => e q * m)) := by
      rw [hIf]
      unfold P_prod
      rw [Finsupp.prod, Finsupp.sum]
      exact hθ_finset_prod f.support f hf_supp
    rw [hI_ker] at hθ_I
    have hdvd_ord : orderOf σ ∣ f.sum (fun q m => e q * m) :=
      orderOf_dvd_iff_pow_eq_one.mpr hθ_I.symm
    have h_ord_card : orderOf σ = Nat.card (E ≃ₐ[F] E) :=
      orderOf_eq_card_of_forall_mem_zpowers hCyclic
    have h_card_finrank : Nat.card (E ≃ₐ[F] E) = Module.finrank F E :=
      IsGalois.card_aut_eq_finrank F E
    rwa [h_ord_card, h_card_finrank] at hdvd_ord
  
  obtain ⟨K₀, hK₀_ne, hK₀_primes⟩ :=
    exists_base_ideal_and_prime_narrow_ray_relNorm_eq
      σ hCyclic e he_map h_cyc_base exists_prime_gt_and_orderOf_zmod_eq_prime_pow
      m₀ hm₀_ne hm₀_ram f.support hf_supp
  
  let IsNarrowRay : R_F → Prop := fun a =>
    a ≠ 0 ∧ a - 1 ∈ m₀ ∧
    ∀ w : NumberField.InfinitePlace F, w.IsReal → 0 < (w.embedding (a : F)).re
  have hNR_one : IsNarrowRay 1 := by
    refine ⟨one_ne_zero, by rw [sub_self]; exact m₀.zero_mem, fun w _ => ?_⟩
    simp
  have hNR_mul : ∀ {a b : R_F}, IsNarrowRay a → IsNarrowRay b → IsNarrowRay (a * b) := by
    rintro a b ⟨ha_ne, ha_m₀, ha_pos⟩ ⟨hb_ne, hb_m₀, hb_pos⟩
    refine ⟨mul_ne_zero ha_ne hb_ne, ?_, ?_⟩
    · have h_eq : a * b - 1 = (a - 1) * b + (b - 1) := by ring
      rw [h_eq]
      exact m₀.add_mem (Ideal.mul_mem_right b m₀ ha_m₀) hb_m₀
    · intro w hw
      push_cast
      rw [map_mul, Complex.mul_re]
      have him_a : (w.embedding (a : F)).im = 0 :=
        Complex.conj_eq_iff_im.mp (by
          exact congrFun (congrArg DFunLike.coe (NumberField.InfinitePlace.isReal_iff.mp hw)) (a : F))
      have him_b : (w.embedding (b : F)).im = 0 :=
        Complex.conj_eq_iff_im.mp (by
          exact congrFun (congrArg DFunLike.coe (NumberField.InfinitePlace.isReal_iff.mp hw)) (b : F))
      rw [him_a, him_b, mul_zero, sub_zero]
      exact mul_pos (ha_pos w hw) (hb_pos w hw)
  have hNR_pow : ∀ {a : R_F}, IsNarrowRay a → ∀ n : ℕ, IsNarrowRay (a ^ n) := by
    intro a ha n
    induction n with
    | zero => simpa using hNR_one
    | succ n ih =>
      rw [pow_succ]
      exact hNR_mul ih ha
  have h_ideal_mul_ne_bot : ∀ {B₁ B₂ : Ideal R_E}, B₁ ≠ ⊥ → B₂ ≠ ⊥ → B₁ * B₂ ≠ ⊥ := by
    intro B₁ B₂ h₁ h₂
    rw [← Submodule.zero_eq_bot] at h₁ h₂ ⊢
    exact mul_ne_zero h₁ h₂
  have h_ideal_pow_ne_bot : ∀ {B : Ideal R_E}, B ≠ ⊥ → ∀ n : ℕ, B ^ n ≠ ⊥ := by
    intro B hB n
    rw [← Submodule.zero_eq_bot] at hB ⊢
    exact pow_ne_zero n hB
  have h_finset_rel : ∀ (s : Finset ι),
      (∀ q ∈ s, q ∈ f.support) →
      ∃ (A₁ A₂ : R_F) (C₁ C₂ : Ideal R_E),
        IsNarrowRay A₁ ∧ IsNarrowRay A₂ ∧ C₁ ≠ ⊥ ∧ C₂ ≠ ⊥ ∧
        (∏ q ∈ s, q.asIdeal ^ f q) * Ideal.span {A₁} * Ideal.relNorm R_F C₁ =
          K₀ ^ (∑ q ∈ s, e q * f q) * Ideal.span {A₂} * Ideal.relNorm R_F C₂ := by
    intro s
    refine Finset.induction_on s ?_ ?_
    · intro _
      refine ⟨1, 1, ⊤, ⊤, hNR_one, hNR_one, top_ne_bot, top_ne_bot, ?_⟩
      rw [Finset.prod_empty, Finset.sum_empty, pow_zero]
    · intro q s hq_not_mem ih hs_sub
      have hq_supp : q ∈ f.support := hs_sub q (Finset.mem_insert_self q s)
      have hs_sub' : ∀ q' ∈ s, q' ∈ f.support :=
        fun q' hq' => hs_sub q' (Finset.mem_insert_of_mem hq')
      obtain ⟨a₁, a₂, B₁, B₂, ha₁_ne, ha₂_ne, hB₁_ne, hB₂_ne, ha₁_m₀, ha₂_m₀, ha_pos, h_q_eq⟩ :=
        hK₀_primes q hq_supp
      have ha₁_NR : IsNarrowRay a₁ := ⟨ha₁_ne, ha₁_m₀, fun w hw => (ha_pos w hw).1⟩
      have ha₂_NR : IsNarrowRay a₂ := ⟨ha₂_ne, ha₂_m₀, fun w hw => (ha_pos w hw).2⟩
      obtain ⟨A₁, A₂, C₁, C₂, hA₁_NR, hA₂_NR, hC₁_ne, hC₂_ne, h_s_eq⟩ := ih hs_sub'
      let m := f q
      have h_q_pow :
          q.asIdeal ^ m * Ideal.span {a₁ ^ m} * Ideal.relNorm R_F (B₁ ^ m) =
            K₀ ^ (e q * m) * Ideal.span {a₂ ^ m} * Ideal.relNorm R_F (B₂ ^ m) := by
        have h1 := congrArg (fun J : Ideal R_F => J ^ m) h_q_eq
        dsimp only at h1
        rw [mul_pow, mul_pow, mul_pow, mul_pow,
          Ideal.span_singleton_pow, Ideal.span_singleton_pow,
          ← map_pow, ← map_pow, ← pow_mul] at h1
        exact h1
      refine ⟨a₁ ^ m * A₁, a₂ ^ m * A₂, B₁ ^ m * C₁, B₂ ^ m * C₂,
        hNR_mul (hNR_pow ha₁_NR m) hA₁_NR,
        hNR_mul (hNR_pow ha₂_NR m) hA₂_NR,
        h_ideal_mul_ne_bot (h_ideal_pow_ne_bot hB₁_ne m) hC₁_ne,
        h_ideal_mul_ne_bot (h_ideal_pow_ne_bot hB₂_ne m) hC₂_ne, ?_⟩
      rw [Finset.prod_insert hq_not_mem, Finset.sum_insert hq_not_mem, pow_add,
        ← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton,
        map_mul, map_mul]
      calc
        (q.asIdeal ^ m * ∏ x ∈ s, x.asIdeal ^ f x) *
            (Ideal.span {a₁ ^ m} * Ideal.span {A₁}) *
            (Ideal.relNorm R_F (B₁ ^ m) * Ideal.relNorm R_F C₁)
          = (q.asIdeal ^ m * Ideal.span {a₁ ^ m} * Ideal.relNorm R_F (B₁ ^ m)) *
            ((∏ x ∈ s, x.asIdeal ^ f x) * Ideal.span {A₁} * Ideal.relNorm R_F C₁) := by ring
        _ = (K₀ ^ (e q * m) * Ideal.span {a₂ ^ m} * Ideal.relNorm R_F (B₂ ^ m)) *
            (K₀ ^ (∑ x ∈ s, e x * f x) * Ideal.span {A₂} * Ideal.relNorm R_F C₂) := by
          rw [h_q_pow, h_s_eq]
        _ = (K₀ ^ (e q * m) * K₀ ^ (∑ x ∈ s, e x * f x)) *
            (Ideal.span {a₂ ^ m} * Ideal.span {A₂}) *
            (Ideal.relNorm R_F (B₂ ^ m) * Ideal.relNorm R_F C₂) := by ring
  obtain ⟨A₁, A₂, C₁, C₂, hA₁_NR, hA₂_NR, hC₁_ne, hC₂_ne, h_prod_eq⟩ :=
    h_finset_rel f.support (fun _ h => h)
  rcases hf_dvd with ⟨k, hk⟩
  let B_K : Ideal R_E := Ideal.map (algebraMap R_F R_E) K₀
  have hBK_ne : B_K ≠ ⊥ :=
    (Ideal.map_eq_bot_iff_of_injective (FaithfulSMul.algebraMap_injective R_F R_E)).not.mpr hK₀_ne
  letI : Algebra (FractionRing R_F) (FractionRing R_E) :=
    FractionRing.liftAlgebra R_F (FractionRing R_E)
  have h_finrank_eq :
      Module.finrank (FractionRing R_F) (FractionRing R_E) = Module.finrank F E := by
    have h1 : Module.finrank (FractionRing R_F) (FractionRing R_E) = Module.finrank R_F R_E :=
      Algebra.IsAlgebraic.finrank_of_isFractionRing R_F (FractionRing R_F) R_E (FractionRing R_E)
    have h2 : Module.finrank F E = Module.finrank R_F R_E :=
      Algebra.IsAlgebraic.finrank_of_isFractionRing R_F F R_E E
    exact h1.trans h2.symm
  have h_relNorm_BK : Ideal.relNorm R_F B_K = K₀ ^ (Module.finrank F E) := by
    dsimp [B_K]
    rw [Ideal.relNorm_algebraMap R_E K₀, h_finrank_eq]
  have h_K₀_sum : K₀ ^ (∑ q ∈ f.support, e q * f q) = Ideal.relNorm R_F (B_K ^ k) := by
    have h_sum_eq : (∑ q ∈ f.support, e q * f q) = Module.finrank F E * k := by
      rw [← hk]
      rfl
    rw [h_sum_eq, pow_mul, ← h_relNorm_BK, map_pow]
  refine ⟨A₁, A₂, C₁, B_K ^ k * C₂,
    hA₁_NR.1, hA₂_NR.1, hC₁_ne,
    h_ideal_mul_ne_bot (h_ideal_pow_ne_bot hBK_ne k) hC₂_ne,
    hA₁_NR.2.1, hA₂_NR.2.1,
    fun w hw => ⟨hA₁_NR.2.2 w hw, hA₂_NR.2.2 w hw⟩, ?_⟩
  rw [hIf]
  change (∏ q ∈ f.support, q.asIdeal ^ f q) * Ideal.span {A₁} * Ideal.relNorm R_F C₁ =
    Ideal.span {A₂} * Ideal.relNorm R_F (B_K ^ k * C₂)
  rw [h_prod_eq, h_K₀_sum, map_mul]
  ring

theorem exists_narrow_ray_frob_subgroup_eq_bot_of_cyclotomic_base {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ ρ : E ≃ₐ[F] E, ρ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_map : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ x : NumberField.RingOfIntegers E,
        (σ ^ (e q)) • x - x ^ (Nat.card (NumberField.RingOfIntegers F ⧸ q.asIdeal)) ∈
          Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal)
    (h_cyc_base : ∀ (m : ℕ), 1 ≤ m →
      ∀ (a' : NumberField.RingOfIntegers F),
        a' ≠ 0 →
        a' - 1 ∈ Ideal.span {(m : NumberField.RingOfIntegers F)} →
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ¬ IsUnramifiedAtPrime F E q → a' - 1 ∈ q.asIdeal) →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a' : F)).re) →
        Ideal.absNorm (Ideal.span {a'}) ≡ 1 [MOD m] ∧
        ∀ ζ : NumberField.RingOfIntegers E,
          ζ ^ m = 1 →
          (σ ^ (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) //
              IsUnramifiedAtPrime F E q },
            e q.1 * (-WithZero.log (q.1.intValuation a')).toNat)) • ζ = ζ) :
    ∃ c₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ,
      ∀ H : Subgroup (E ≃ₐ[F] E),
        (∀ ρ ∈ H,
          ∃ a : NumberField.RingOfIntegers F,
            a ≠ 0 ∧
            (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
              ¬ IsUnramifiedAtPrime F E q → a - 1 ∈ q.asIdeal ^ (c₀ q)) ∧
            (∀ w : NumberField.InfinitePlace F,
              w.IsReal → 0 < (w.embedding (a : F)).re) ∧
            σ ^ (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) //
                IsUnramifiedAtPrime F E q },
              e q.1 * (-WithZero.log (q.1.intValuation a)).toNat) = ρ) →
        H = ⊥ :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  let P : ι → Prop := IsUnramifiedAtPrime F E
  let d := Module.finrank F E
  let N_ideal : Ideal R_F → ℕ := fun I =>
    ∑ᶠ q : { q : ι // P q },
      e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I).factors
  let θ : Ideal R_F → (E ≃ₐ[F] E) := fun I => σ ^ (N_ideal I)
  have h_fin_supp_ideal : ∀ I : Ideal R_F, I ≠ ⊥ →
      (Function.support (fun q : { q : ι // P q } =>
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I).factors)).Finite := by
    intro I hI
    have h_fac_fin : { q : ι | q.asIdeal ∣ I }.Finite := Ideal.finite_factors hI
    have h_sub_fin : (Subtype.val ⁻¹' { q : ι | q.asIdeal ∣ I } : Set { q : ι // P q }).Finite :=
      h_fac_fin.preimage Subtype.val_injective.injOn
    refine h_sub_fin.subset (fun q hq => ?_)
    rw [Function.mem_support] at hq
    have h_cnt_ne : (Associates.mk q.1.asIdeal).count (Associates.mk I).factors ≠ 0 :=
      right_ne_zero_of_mul hq
    have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
      IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
    change q.1.asIdeal ∣ I
    by_contra h_not_dvd
    apply h_cnt_ne
    let M : Multiset (Ideal R_F) := UniqueFactorizationMonoid.normalizedFactors I
    have hM_prod : M.prod = I := prod_normalizedFactors_eq_self hI
    have hM_prime : ∀ Q ∈ M, Prime Q :=
      fun Q hQ => UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ
    have hM_ne : ∀ Q ∈ M, Q ≠ q.1.asIdeal := by
      intro Q hQ h_eq
      apply h_not_dvd
      rw [← h_eq]
      exact UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hQ
    rw [← hM_prod]
    have h_ind_cnt : ∀ (L : Multiset (Ideal R_F)),
        (∀ Q ∈ L, Prime Q) → (∀ Q ∈ L, Q ≠ q.1.asIdeal) →
        (Associates.mk q.1.asIdeal).count (Associates.mk L.prod).factors = 0 := by
      intro L
      refine Multiset.induction_on L ?_ ?_
      · intro _ _
        rw [Multiset.prod_zero, Associates.mk_one, Associates.factors_one, Associates.count_zero hq_irr]
      · intro Q L' ih hL_p hL_ne
        have hQ_p : Prime Q := hL_p Q (Multiset.mem_cons_self Q L')
        have hQ_ne_q : Q ≠ q.1.asIdeal := hL_ne Q (Multiset.mem_cons_self Q L')
        have hL'_p : ∀ P₀ ∈ L', Prime P₀ := fun P₀ hP₀ => hL_p P₀ (Multiset.mem_cons_of_mem hP₀)
        have hL'_ne : ∀ P₀ ∈ L', P₀ ≠ q.1.asIdeal := fun P₀ hP₀ => hL_ne P₀ (Multiset.mem_cons_of_mem hP₀)
        have hQ_ne_zero : Q ≠ 0 := hQ_p.ne_zero
        have hQ_ne_bot : Q ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
        have hL'_ne_zero : L'.prod ≠ 0 := by
          apply Multiset.prod_ne_zero
          intro h0
          exact not_prime_zero (hL'_p 0 h0)
        have hQ_isPrime : Q.IsPrime := Ideal.isPrime_of_prime hQ_p
        let q_Q : ι := ⟨Q, hQ_isPrime, hQ_ne_bot⟩
        have hqQ_irr : Irreducible (Associates.mk Q) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q_Q
        have h_mk_ne : Associates.mk q.1.asIdeal ≠ Associates.mk Q := by
          intro h_eq
          exact hQ_ne_q (Associates.mk_injective h_eq).symm
        rw [Multiset.prod_cons, ← Associates.mk_mul_mk,
          Associates.count_mul (Associates.mk_ne_zero.mpr hQ_ne_zero) (Associates.mk_ne_zero.mpr hL'_ne_zero) hq_irr,
          Associates.count_eq_zero_of_ne hq_irr hqQ_irr h_mk_ne,
          ih hL'_p hL'_ne, add_zero]
    exact h_ind_cnt M hM_prime hM_ne
  have hθ_top : θ ⊤ = 1 := by
    dsimp [θ, N_ideal]
    have h0 : (∑ᶠ q : { q : ι // P q },
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk (⊤ : Ideal R_F)).factors) = 0 := by
      refine finsum_eq_zero_of_forall_eq_zero fun q => ?_
      have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
      rw [← Ideal.one_eq_top, Associates.mk_one, Associates.factors_one, Associates.count_zero hq_irr, mul_zero]
    rw [h0, pow_zero]
  have hθ_mul : ∀ I₁ I₂ : Ideal R_F, I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂ := by
    intro I₁ I₂ hI₁ hI₂
    dsimp [θ, N_ideal]
    have hI₁_zero : I₁ ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have hI₂_zero : I₂ ≠ 0 := by rwa [Submodule.zero_eq_bot]
    have h_term : ∀ q : { q : ι // P q },
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk (I₁ * I₂)).factors =
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I₁).factors +
        e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk I₂).factors := by
      intro q
      have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
      rw [← Associates.mk_mul_mk,
        Associates.count_mul (Associates.mk_ne_zero.mpr hI₁_zero) (Associates.mk_ne_zero.mpr hI₂_zero) hq_irr,
        Nat.mul_add]
    simp_rw [h_term]
    rw [finsum_add_distrib (h_fin_supp_ideal I₁ hI₁) (h_fin_supp_ideal I₂ hI₂), pow_add]
  have he_arith : ∀ q : ι, P q →
      ∀ Q : Ideal R_E, Q.IsPrime → Ideal.under R_F Q = q.asIdeal →
        IsArithFrobAt R_F (σ ^ (e q)) Q := by
    intro q hq Q hQ_prime hQ_under x
    have h_mem_map := he_map q hq x
    have h_map_le : Ideal.map (algebraMap R_F R_E) q.asIdeal ≤ Q :=
      Ideal.map_le_iff_le_comap.mpr hQ_under.symm.le
    rw [hQ_under]
    exact h_map_le h_mem_map
  have hθ_frob : ∀ q : ι, P q → FrobeniusClassAt F E q ⊆ {θ q.asIdeal} := by
    intro q hq g hg
    rw [Set.mem_singleton_iff]
    have hN_q : N_ideal q.asIdeal = e q := by
      dsimp [N_ideal]
      rw [finsum_eq_single _ ⟨q, hq⟩]
      · have hq_irr : Irreducible (Associates.mk q.asIdeal) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q
        rw [Associates.count_self hq_irr, mul_one]
      · rintro ⟨q', hq'⟩ h_ne
        have hq'_irr : Irreducible (Associates.mk q'.asIdeal) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q'
        have hq_irr : Irreducible (Associates.mk q.asIdeal) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q
        have h_mk_ne : Associates.mk q'.asIdeal ≠ Associates.mk q.asIdeal := by
          intro h_eq
          apply h_ne
          exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext (Associates.mk_injective h_eq))
        rw [Associates.count_eq_zero_of_ne hq'_irr hq_irr h_mk_ne, mul_zero]
    have hθ_q : θ q.asIdeal = σ ^ (e q) := by
      dsimp [θ]
      rw [hN_q]
    rw [hθ_q]
    rcases hg with ⟨Q, hQ_prime, hQ_under, hg_congr⟩
    have hg_arith : IsArithFrobAt R_F g Q := by
      intro x
      have hx := hg_congr x (g • x) rfl
      rwa [hQ_under]
    have hσ_arith : IsArithFrobAt R_F (σ ^ (e q)) Q := he_arith q hq Q hQ_prime hQ_under
    have h_mem := hg_arith.mul_inv_mem_inertia hσ_arith
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    haveI : Q.IsPrime := hQ_prime
    haveI : Q.LiesOver q.asIdeal := ⟨hQ_under.symm⟩
    haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q q.asIdeal
    letI := Ideal.Quotient.field q.asIdeal
    letI := Ideal.Quotient.field Q
    haveI : PerfectField (R_F ⧸ q.asIdeal) := PerfectField.ofFinite
    haveI : Algebra.IsSeparable (R_F ⧸ q.asIdeal) (R_E ⧸ Q) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    have h_card : Nat.card ((Submodule.toAddSubgroup Q).inertia (E ≃ₐ[F] E)) = 1 := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn q.asIdeal q.ne_bot Q,
        Ideal.ramificationIdxIn_eq_ramificationIdx q.asIdeal Q (E ≃ₐ[F] E)]
      exact hq Q hQ_prime hQ_under
    have h_bot : (Submodule.toAddSubgroup Q).inertia (E ≃ₐ[F] E) = ⊥ :=
      Subgroup.card_eq_one.mp h_card
    rw [h_bot, Subgroup.mem_bot, mul_inv_eq_one] at h_mem
    exact h_mem
  have hθ_span : ∀ a : R_F, a ≠ 0 →
      θ (Ideal.span {a}) =
        σ ^ (∑ᶠ q : { q : ι // P q }, e q.1 * (-WithZero.log (q.1.intValuation a)).toNat) := by
    intro a ha_ne
    dsimp [θ, N_ideal]
    congr 1
    refine finsum_congr fun q => ?_
    rw [IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg q.1 ha_ne,
      WithZero.log_exp, neg_neg, Int.toNat_natCast]
  have hθ_relNorm : ∀ B : Ideal R_E, B ≠ ⊥ → θ (Ideal.relNorm R_F B) = 1 := by
    intro B hB_ne
    dsimp [θ]
    have hrel_ne : Ideal.relNorm R_F B ≠ ⊥ :=
      (Ideal.relNorm_eq_bot_iff (R := R_F)).not.mpr hB_ne
    let f_B : { q : ι // P q } → ℕ := fun q =>
      e q.1 * (Associates.mk q.1.asIdeal).count (Associates.mk (Ideal.relNorm R_F B)).factors
    have h_term_zero : ∀ q : { q : ι // P q }, ((f_B q : ℕ) : ZMod d) = 0 := by
      rintro ⟨q, hPq⟩
      dsimp [f_B]
      let M : Multiset (Ideal R_E) := UniqueFactorizationMonoid.normalizedFactors B
      have hM_prod : M.prod = B := prod_normalizedFactors_eq_self hB_ne
      have hM_prime : ∀ Q ∈ M, Prime Q :=
        fun Q hQ => UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ
      rw [← hM_prod]
      have hq_irr : Irreducible (Associates.mk q.asIdeal) :=
        IsDedekindDomain.HeightOneSpectrum.associates_irreducible q
      have h_single : ∀ Q : Ideal R_E, Prime Q →
          ((e q * (Associates.mk q.asIdeal).count
            (Associates.mk (Ideal.relNorm R_F Q)).factors : ℕ) : ZMod d) = 0 := by
        intro Q hQ_prime_elt
        have hQ_isPrime : Q.IsPrime := Ideal.isPrime_of_prime hQ_prime_elt
        have hQ_ne_bot : Q ≠ ⊥ := by
          rw [← Submodule.zero_eq_bot]
          exact hQ_prime_elt.ne_zero
        haveI : Q.IsMaximal := Ideal.IsPrime.isMaximal hQ_isPrime hQ_ne_bot
        let p_Q : Ideal R_F := Ideal.under R_F Q
        haveI : Q.LiesOver p_Q := ⟨rfl⟩
        haveI : p_Q.IsMaximal := Ideal.IsMaximal.under R_F Q
        have hpQ_prime : p_Q.IsPrime := Ideal.IsMaximal.isPrime inferInstance
        have hpQ_ne_bot : p_Q ≠ ⊥ := Ideal.under_ne_bot R_F hQ_ne_bot
        have hpQ_ne_zero : p_Q ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have h_mk_pQ_ne : Associates.mk p_Q ≠ 0 := Associates.mk_ne_zero.mpr hpQ_ne_zero
        have h_rel_Q : Ideal.relNorm R_F Q = p_Q ^ (p_Q.inertiaDeg Q) :=
          Ideal.relNorm_eq_pow_of_isMaximal Q p_Q
        rw [h_rel_Q, Associates.mk_pow, Associates.count_pow h_mk_pQ_ne hq_irr]
        by_cases h_eq : p_Q = q.asIdeal
        · rw [h_eq, Associates.count_self hq_irr, mul_one]
          exact unramified_frob_exponent_mul_inertiaDeg_eq_zero σ hCyclic e he_arith q hPq Q hQ_isPrime h_eq
        · let q_Q : ι := ⟨p_Q, hpQ_prime, hpQ_ne_bot⟩
          have hqQ_irr : Irreducible (Associates.mk p_Q) :=
            IsDedekindDomain.HeightOneSpectrum.associates_irreducible q_Q
          have h_mk_ne : Associates.mk q.asIdeal ≠ Associates.mk p_Q := by
            intro h_mk_eq
            exact h_eq (Associates.mk_injective h_mk_eq).symm
          rw [Associates.count_eq_zero_of_ne hq_irr hqQ_irr h_mk_ne, mul_zero, mul_zero, Nat.cast_zero]
      have h_ind : ∀ (L : Multiset (Ideal R_E)), (∀ Q ∈ L, Prime Q) →
          ((e q * (Associates.mk q.asIdeal).count
            (Associates.mk (Ideal.relNorm R_F L.prod)).factors : ℕ) : ZMod d) = 0 := by
        intro L
        refine Multiset.induction_on L ?_ ?_
        · intro _
          rw [Multiset.prod_zero, map_one, Associates.mk_one, Associates.factors_one,
            Associates.count_zero hq_irr, mul_zero, Nat.cast_zero]
        · intro Q L' ih hL
          have hQ : Prime Q := hL Q (Multiset.mem_cons_self Q L')
          have hL' : ∀ P₀ ∈ L', Prime P₀ := fun P₀ hP₀ => hL P₀ (Multiset.mem_cons_of_mem hP₀)
          have hQ_ne_bot : Q ≠ ⊥ := by
            rw [← Submodule.zero_eq_bot]
            exact hQ.ne_zero
          have hL'_ne_zero : L'.prod ≠ 0 := by
            apply Multiset.prod_ne_zero
            intro h0
            exact not_prime_zero (hL' 0 h0)
          have hL'_ne_bot : L'.prod ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
          have h_rel_Q_ne : Ideal.relNorm R_F Q ≠ 0 := by
            rw [Submodule.zero_eq_bot]
            exact (Ideal.relNorm_eq_bot_iff (R := R_F)).not.mpr hQ_ne_bot
          have h_rel_L'_ne : Ideal.relNorm R_F L'.prod ≠ 0 := by
            rw [Submodule.zero_eq_bot]
            exact (Ideal.relNorm_eq_bot_iff (R := R_F)).not.mpr hL'_ne_bot
          have h_mk_Q : Associates.mk (Ideal.relNorm R_F Q) ≠ 0 :=
            Associates.mk_ne_zero.mpr h_rel_Q_ne
          have h_mk_L' : Associates.mk (Ideal.relNorm R_F L'.prod) ≠ 0 :=
            Associates.mk_ne_zero.mpr h_rel_L'_ne
          rw [Multiset.prod_cons, map_mul, ← Associates.mk_mul_mk,
            Associates.count_mul h_mk_Q h_mk_L' hq_irr,
            Nat.mul_add, Nat.cast_add, h_single Q hQ, ih hL', add_zero]
      exact h_ind M hM_prime
    let s := (h_fin_supp_ideal (Ideal.relNorm R_F B) hrel_ne).toFinset
    have hs1 : Function.support f_B ⊆ ↑s :=
      fun q hq => (Set.Finite.mem_toFinset (h_fin_supp_ideal (Ideal.relNorm R_F B) hrel_ne)).mpr hq
    have hs2 : Function.support (fun q => (f_B q : ZMod d)) ⊆ ↑s := by
      intro q hq
      apply hs1
      rw [Function.mem_support] at hq ⊢
      intro h0
      apply hq
      rw [h0, Nat.cast_zero]
    have h_cast_zero : ((N_ideal (Ideal.relNorm R_F B) : ℕ) : ZMod d) = 0 := by
      change ((∑ᶠ q : { q : ι // P q }, f_B q : ℕ) : ZMod d) = 0
      rw [finsum_eq_sum_of_support_subset _ hs1, Nat.cast_sum,
        ← finsum_eq_sum_of_support_subset _ hs2]
      exact finsum_eq_zero_of_forall_eq_zero h_term_zero
    have hdvd : d ∣ N_ideal (Ideal.relNorm R_F B) :=
      (ZMod.natCast_eq_zero_iff (N_ideal (Ideal.relNorm R_F B)) d).mp h_cast_zero
    have h_ord_card : orderOf σ = Nat.card (E ≃ₐ[F] E) :=
      orderOf_eq_card_of_forall_mem_zpowers hCyclic
    have h_card_finrank : Nat.card (E ≃ₐ[F] E) = d :=
      IsGalois.card_aut_eq_finrank F E
    rw [← h_card_finrank, ← h_ord_card] at hdvd
    exact orderOf_dvd_iff_pow_eq_one.mp hdvd
  obtain ⟨c₀, m₀, hm₀_ne, hm₀_ram, hc₀_pos, hm₀_mem, hm₀_index⟩ :=
    exists_ramified_modulus_narrow_ray_relNorm_index_ge_card σ hCyclic
  refine ⟨c₀, fun H hH => ?_⟩
  let Q_H := (E ≃ₐ[F] E) ⧸ H
  let k : ℕ := Fintype.card Q_H
  let e_Q : Fin k ≃ Q_H := (Fintype.equivFin Q_H).symm
  have h_surj_mk : ∀ i : Fin k, ∃ τ : E ≃ₐ[F] E, (QuotientGroup.mk τ : Q_H) = e_Q i :=
    fun i => QuotientGroup.mk_surjective (e_Q i)
  choose τ hτ using h_surj_mk
  have h_ex_K : ∀ i : Fin k, ∃ K : Ideal R_F,
      K ≠ ⊥ ∧ (∀ q : ι, q.asIdeal ∣ K → P q) ∧ θ K = (τ i)⁻¹ :=
    fun i => exists_unramified_ideal_artin_surjective σ hCyclic θ hθ_top hθ_mul hθ_frob (τ i)⁻¹
  choose K hK_ne hK_unr hK_θ using h_ex_K
  have h_comm : ∀ g₁ g₂ : E ≃ₐ[F] E, g₁ * g₂ = g₂ * g₁ := by
    intro g₁ g₂
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic g₁) with ⟨n₁, rfl⟩
    rcases Subgroup.mem_zpowers_iff.mp (hCyclic g₂) with ⟨n₂, rfl⟩
    rw [← zpow_add, add_comm, zpow_add]
  have h_cov : ∀ I : Ideal R_F, I ≠ ⊥ → (∀ q : ι, q.asIdeal ∣ I → P q) →
      ∃ i : Fin k,
        ∃ (a₁ a₂ : R_F) (B₁ B₂ : Ideal R_E),
          a₁ ≠ 0 ∧ a₂ ≠ 0 ∧ B₁ ≠ ⊥ ∧ B₂ ≠ ⊥ ∧
          a₁ - 1 ∈ m₀ ∧ a₂ - 1 ∈ m₀ ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a₁ : F)).re ∧ 0 < (w.embedding (a₂ : F)).re) ∧
          I * K i * Ideal.span {a₁} * Ideal.relNorm R_F B₁ =
            Ideal.span {a₂} * Ideal.relNorm R_F B₂ := by
    intro I hI_ne hI_unr
    let i : Fin k := e_Q.symm (QuotientGroup.mk (θ I))
    have h_mk_eq : (QuotientGroup.mk (θ I) : Q_H) = QuotientGroup.mk (τ i) := by
      rw [hτ i, e_Q.apply_symm_apply]
    have h_in_H : (θ I)⁻¹ * τ i ∈ H := QuotientGroup.eq.mp h_mk_eq
    have hIK_ne : I * K i ≠ ⊥ := by
      have h1 : I ≠ 0 := by rwa [Submodule.zero_eq_bot]
      have h2 : K i ≠ 0 := by
        rw [Submodule.zero_eq_bot]
        exact hK_ne i
      rw [← Submodule.zero_eq_bot]
      exact mul_ne_zero h1 h2
    have hIK_unr : ∀ q : ι, q.asIdeal ∣ I * K i → P q := by
      intro q hdvd
      rcases q.prime.dvd_or_dvd hdvd with h1 | h2
      · exact hI_unr q h1
      · exact hK_unr i q h2
    have hθ_IK_inv : (θ (I * K i))⁻¹ = (θ I)⁻¹ * τ i := by
      rw [hθ_mul I (K i) hI_ne (hK_ne i), hK_θ i, mul_inv_rev, inv_inv, h_comm (τ i) (θ I)⁻¹]
    let ρ : E ≃ₐ[F] E := (θ (I * K i))⁻¹
    have hρ_in_H : ρ ∈ H := by
      dsimp [ρ]
      rwa [hθ_IK_inv]
    obtain ⟨a₀, ha₀_ne, ha₀_ram, ha₀_pos, ha₀_frob⟩ := hH ρ hρ_in_H
    have ha₀_m₀ : a₀ - 1 ∈ m₀ := hm₀_mem a₀ ha₀_ram
    have hIa₀_ne : Ideal.span {a₀} ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr ha₀_ne
    have hIa₀_unr : ∀ q : ι, q.asIdeal ∣ Ideal.span {a₀} → P q := by
      intro q hdvd
      by_contra hq_ram
      have ha₀_in_q : a₀ ∈ q.asIdeal := Ideal.dvd_span_singleton.mp hdvd
      have hc₀_ne : c₀ q ≠ 0 := Nat.one_le_iff_ne_zero.mp (hc₀_pos q hq_ram)
      have ha₀_sub_in_q : a₀ - 1 ∈ q.asIdeal :=
        Ideal.pow_le_self hc₀_ne (ha₀_ram q hq_ram)
      have h1_in_q : (1 : R_F) ∈ q.asIdeal := by
        have h_sub : a₀ - (a₀ - 1) ∈ q.asIdeal := Submodule.sub_mem q.asIdeal ha₀_in_q ha₀_sub_in_q
        rwa [sub_sub_cancel] at h_sub
      exact q.isMaximal.ne_top ((Ideal.eq_top_iff_one q.asIdeal).mpr h1_in_q)
    have hθ_a₀ : θ (Ideal.span {a₀}) = ρ := by
      rw [hθ_span a₀ ha₀_ne]
      exact ha₀_frob
    let I' : Ideal R_F := I * K i * Ideal.span {a₀}
    have hI'_ne : I' ≠ ⊥ := by
      have h1 : I * K i ≠ 0 := by rwa [Submodule.zero_eq_bot]
      have h2 : Ideal.span {a₀} ≠ 0 := by rwa [Submodule.zero_eq_bot]
      change I * K i * Ideal.span {a₀} ≠ ⊥
      rw [← Submodule.zero_eq_bot]
      exact mul_ne_zero h1 h2
    have hI'_unr : ∀ q : ι, q.asIdeal ∣ I' → P q := by
      intro q hdvd
      rcases q.prime.dvd_or_dvd hdvd with h1 | h2
      · exact hIK_unr q h1
      · exact hIa₀_unr q h2
    have hI'_ker : θ I' = 1 := by
      dsimp [I']
      rw [hθ_mul (I * K i) (Ideal.span {a₀}) hIK_ne hIa₀_ne, hθ_a₀]
      exact mul_inv_cancel (θ (I * K i))
    obtain ⟨a₁, a₂, B₁, B₂, ha₁_ne, ha₂_ne, hB₁_ne, hB₂_ne, ha₁_m₀, ha₂_m₀, ha_pos, h_rel_eq⟩ :=
      exists_narrow_ray_relNorm_eq_of_artin_eq_one σ hCyclic e he_map h_cyc_base θ
        hθ_top hθ_mul hθ_frob hθ_span hθ_relNorm m₀ hm₀_ne hm₀_ram I' hI'_ne hI'_unr hI'_ker
    refine ⟨i, a₀ * a₁, a₂, B₁, B₂, mul_ne_zero ha₀_ne ha₁_ne, ha₂_ne, hB₁_ne, hB₂_ne, ?_, ha₂_m₀, ?_, ?_⟩
    · have h_decomp : a₀ * a₁ - 1 = (a₀ - 1) * a₁ + (a₁ - 1) := by ring
      rw [h_decomp]
      exact Submodule.add_mem m₀ (Ideal.mul_mem_right a₁ m₀ ha₀_m₀) ha₁_m₀
    · intro w hw
      refine ⟨?_, (ha_pos w hw).2⟩
      push_cast
      rw [map_mul, Complex.mul_re]
      have him₀ : (w.embedding (a₀ : F)).im = 0 :=
        Complex.conj_eq_iff_im.mp (by
          have h_conj := congrFun (congrArg DFunLike.coe (NumberField.InfinitePlace.isReal_iff.mp hw)) (a₀ : F)
          exact h_conj)
      have him₁ : (w.embedding (a₁ : F)).im = 0 :=
        Complex.conj_eq_iff_im.mp (by
          have h_conj := congrFun (congrArg DFunLike.coe (NumberField.InfinitePlace.isReal_iff.mp hw)) (a₁ : F)
          exact h_conj)
      rw [him₀, him₁, mul_zero, sub_zero]
      exact mul_pos (ha₀_pos w hw) (ha_pos w hw).1
    · rw [← Ideal.span_singleton_mul_span_singleton, ← mul_assoc]
      exact h_rel_eq
  have h_le_k : Nat.card (E ≃ₐ[F] E) ≤ k :=
    hm₀_index k K (fun i => ⟨hK_ne i, hK_unr i⟩) h_cov
  have h_k_eq : k = Nat.card Q_H := (Nat.card_eq_fintype_card).symm
  rw [h_k_eq] at h_le_k
  have h_lagrange : Nat.card (E ≃ₐ[F] E) = Nat.card Q_H * Nat.card H :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup H
  have h_card_pos : 0 < Nat.card (E ≃ₐ[F] E) := Nat.card_pos
  have h_card_H_pos : 0 < Nat.card H := Nat.card_pos
  have h_card_H_one : Nat.card H = 1 := by nlinarith
  exact Subgroup.card_eq_one.mp h_card_H_one

theorem exists_narrow_ray_unramified_frob_finsum_eq_intNorm {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_arith : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ Q : Ideal (NumberField.RingOfIntegers E),
        Q.IsPrime →
        Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal →
        IsArithFrobAt (NumberField.RingOfIntegers F) (σ ^ (e q)) Q) :
    ∃ (c : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ),
      ∀ (a : NumberField.RingOfIntegers F),
        a ≠ 0 →
        (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
          ¬ IsUnramifiedAtPrime F E q → a - 1 ∈ q.asIdeal ^ (c q)) →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) →
        ∃ (b : NumberField.RingOfIntegers E),
          b ≠ 0 ∧
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            q.asIdeal ∣ Ideal.span {Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b} →
            IsUnramifiedAtPrime F E q) ∧
          (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) //
              IsUnramifiedAtPrime F E q },
            ((e q.1 * (-WithZero.log (q.1.intValuation a)).toNat : ℕ) : ZMod (Module.finrank F E))) =
          (∑ᶠ q : { q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) //
              IsUnramifiedAtPrime F E q },
            ((e q.1 * (-WithZero.log (q.1.intValuation
              (Algebra.intNorm (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E) b))).toNat : ℕ) :
              ZMod (Module.finrank F E))) :=
by
  classical
  let R_F := NumberField.RingOfIntegers F
  let R_E := NumberField.RingOfIntegers E
  let ι := IsDedekindDomain.HeightOneSpectrum R_F
  let P : ι → Prop := IsUnramifiedAtPrime F E
  let d := Module.finrank F E
  have he_map : ∀ q : ι, P q → ∀ x : R_E,
      (σ ^ (e q)) • x - x ^ (Nat.card (R_F ⧸ q.asIdeal)) ∈
        Ideal.map (algebraMap R_F R_E) q.asIdeal := by
    intro q hq x
    let y : R_E := (σ ^ (e q)) • x - x ^ (Nat.card (R_F ⧸ q.asIdeal))
    let I_q : Ideal R_E := Ideal.map (algebraMap R_F R_E) q.asIdeal
    change y ∈ I_q
    by_cases hy : y = 0
    · rw [hy]
      exact Submodule.zero_mem I_q
    · rw [← Ideal.dvd_span_singleton]
      have hIy_ne : Ideal.span {y} ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hy
      have hIy_zero : Ideal.span {y} ≠ 0 := by rwa [Submodule.zero_eq_bot]
      have hIq_ne : I_q ≠ ⊥ :=
        (Ideal.map_eq_bot_iff_of_injective (FaithfulSMul.algebraMap_injective R_F R_E)).not.mpr q.ne_bot
      have hIq_zero : I_q ≠ 0 := by rwa [Submodule.zero_eq_bot]
      rw [UniqueFactorizationMonoid.dvd_iff_normalizedFactors_le_normalizedFactors hIq_zero hIy_zero,
          Multiset.le_iff_count]
      intro Q
      by_cases h_cnt : Multiset.count Q (UniqueFactorizationMonoid.normalizedFactors I_q) = 0
      · rw [h_cnt]
        exact Nat.zero_le _
      · have hQ_mem : Q ∈ UniqueFactorizationMonoid.normalizedFactors I_q :=
          Multiset.count_ne_zero.mp h_cnt
        have hQ_prime : Prime Q := UniqueFactorizationMonoid.prime_of_normalized_factor Q hQ_mem
        have hQ_isPrime : Q.IsPrime := Ideal.isPrime_of_prime hQ_prime
        have hQ_ne_bot : Q ≠ ⊥ := by
          rw [← Submodule.zero_eq_bot]
          exact hQ_prime.ne_zero
        haveI : Q.IsPrime := hQ_isPrime
        haveI : Q.IsMaximal := Ideal.IsPrime.isMaximal hQ_isPrime hQ_ne_bot
        haveI : q.asIdeal.IsMaximal := q.isMaximal
        have hQ_dvd_Iq : Q ∣ I_q := UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hQ_mem
        have hIq_le_Q : I_q ≤ Q := Ideal.dvd_iff_le.mp hQ_dvd_Iq
        have hq_le_under : q.asIdeal ≤ Ideal.under R_F Q :=
          Ideal.map_le_iff_le_comap.mp hIq_le_Q
        have hQ_under : Ideal.under R_F Q = q.asIdeal :=
          (q.isMaximal.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hq_le_under).symm
        have h_ram_one : Ideal.ramificationIdx (algebraMap R_F R_E) q.asIdeal Q = 1 :=
          hq Q hQ_isPrime hQ_under
        have h_not_le2 : ¬ (I_q ≤ Q ^ 2) :=
          (Ideal.ramificationIdx_ne_one_iff hIq_le_Q).not.mp (not_not.mpr h_ram_one)
        have h_cnt_le_one : Multiset.count Q (UniqueFactorizationMonoid.normalizedFactors I_q) ≤ 1 := by
          by_contra h_gt
          have h2 : 2 ≤ Multiset.count Q (UniqueFactorizationMonoid.normalizedFactors I_q) := by omega
          have h_rep : Multiset.replicate 2 Q ≤ UniqueFactorizationMonoid.normalizedFactors I_q :=
            Multiset.le_count_iff_replicate_le.mp h2
          have h_prod_dvd : (Multiset.replicate 2 Q).prod ∣ (UniqueFactorizationMonoid.normalizedFactors I_q).prod :=
            Multiset.prod_dvd_prod_of_le h_rep
          rw [Multiset.prod_replicate, prod_normalizedFactors_eq_self hIq_ne, Ideal.dvd_iff_le] at h_prod_dvd
          exact h_not_le2 h_prod_dvd
        have h_frob : IsArithFrobAt R_F (σ ^ (e q)) Q := he_arith q hq Q hQ_isPrime hQ_under
        have hy_mem_Q : y ∈ Q := by
          have h_mk := AlgHom.IsArithFrobAt.mk_apply h_frob x
          rw [hQ_under, ← map_pow] at h_mk
          exact Ideal.Quotient.eq.mp h_mk
        have hQ_dvd_Iy : Q ∣ Ideal.span {y} := Ideal.dvd_span_singleton.mpr hy_mem_Q
        have hQ_mem_Iy : Q ∈ UniqueFactorizationMonoid.normalizedFactors (Ideal.span {y}) := by
          rw [Ideal.mem_normalizedFactors_iff hIy_ne]
          exact ⟨hQ_isPrime, Ideal.dvd_iff_le.mp hQ_dvd_Iy⟩
        have h_cnt_Iy_pos : 1 ≤ Multiset.count Q (UniqueFactorizationMonoid.normalizedFactors (Ideal.span {y})) :=
          Multiset.count_pos.mpr hQ_mem_Iy
        exact h_cnt_le_one.trans h_cnt_Iy_pos
  have h_cyc_base : ∀ (m : ℕ), 1 ≤ m →
      ∀ (a' : R_F),
        a' ≠ 0 →
        a' - 1 ∈ Ideal.span {(m : R_F)} →
        (∀ q : ι, ¬ P q → a' - 1 ∈ q.asIdeal) →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a' : F)).re) →
        Ideal.absNorm (Ideal.span {a'}) ≡ 1 [MOD m] ∧
        ∀ ζ : R_E,
          ζ ^ m = 1 →
          (σ ^ (∑ᶠ q : { q : ι // P q },
            e q.1 * (-WithZero.log (q.1.intValuation a')).toNat)) • ζ = ζ := by
    intro m hm a' ha'_ne ha'_m ha'_ram ha'_pos
    have h_pos_eq :=
      absNorm_span_singleton_eq_intNorm_and_pos_of_isReal_re_pos a' ha'_ne ha'_pos
    have h_abs_mod :=
      (intNorm_eq_one_in_zmod_and_absNorm_modEq_one_of_sub_one_mem_span_natCast m a' ha'_m).2 h_pos_eq.2
    refine ⟨h_abs_mod, fun ζ hζ => ?_⟩
    exact unramified_frob_pow_finsum_smul_root_of_unity_eq_self
      σ P e he_map m hm a' ha'_ne ha'_m ha'_ram h_abs_mod ζ hζ
  obtain ⟨c₀, hc₀⟩ :=
    exists_narrow_ray_frob_subgroup_eq_bot_of_cyclotomic_base σ hCyclic e he_map h_cyc_base
  refine ⟨c₀, ?_⟩
  let N : R_F → ℕ := fun a =>
    ∑ᶠ q : { q : ι // P q }, e q.1 * (-WithZero.log (q.1.intValuation a)).toNat
  let S : Set (E ≃ₐ[F] E) :=
    { ρ | ∃ a : R_F,
        a ≠ 0 ∧
        (∀ q : ι, ¬ P q → a - 1 ∈ q.asIdeal ^ (c₀ q)) ∧
        (∀ w : NumberField.InfinitePlace F, w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        σ ^ (N a) = ρ }
  have h_fin_supp : ∀ x : R_F, x ≠ 0 →
      (Function.support (fun q : { q : ι // P q } =>
        e q.1 * (-WithZero.log (q.1.intValuation x)).toNat)).Finite := by
    intro x hx
    have hIx_ne : Ideal.span ({x} : Set R_F) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hx
    have h_fac_fin : { q : ι | q.asIdeal ∣ Ideal.span ({x} : Set R_F) }.Finite :=
      Ideal.finite_factors hIx_ne
    have h_sub_fin : (Subtype.val ⁻¹' { q : ι | q.asIdeal ∣ Ideal.span ({x} : Set R_F) } :
        Set { q : ι // P q }).Finite :=
      h_fac_fin.preimage Subtype.val_injective.injOn
    refine h_sub_fin.subset (fun q hq => ?_)
    rw [Function.mem_support] at hq
    have h_ne_one : q.1.intValuation x ≠ 1 := by
      intro h1
      apply hq
      rw [h1, ← WithZero.exp_zero, WithZero.log_exp, neg_zero, Int.toNat_zero, mul_zero]
    exact (q.1.intValuation_lt_one_iff_dvd x).mp (lt_of_le_of_ne (q.1.intValuation_le_one x) h_ne_one)
  have hN1 : N 1 = 0 := by
    refine finsum_eq_zero_of_forall_eq_zero fun q => ?_
    have h1 : q.1.intValuation 1 = WithZero.exp (0 : ℤ) := by
      rw [map_one, WithZero.exp_zero]
    rw [h1, WithZero.log_exp, neg_zero, Int.toNat_zero, mul_zero]
  have h_one : (1 : E ≃ₐ[F] E) ∈ S := by
    refine ⟨1, one_ne_zero, fun q _ => by rw [sub_self]; exact Submodule.zero_mem _,
      fun w _ => by simp, ?_⟩
    rw [hN1, pow_zero]
  have h_mul : ∀ {ρ₁ ρ₂ : E ≃ₐ[F] E}, ρ₁ ∈ S → ρ₂ ∈ S → ρ₁ * ρ₂ ∈ S := by
    rintro ρ₁ ρ₂ ⟨a₁, ha₁_ne, ha₁_ram, ha₁_pos, rfl⟩ ⟨a₂, ha₂_ne, ha₂_ram, ha₂_pos, rfl⟩
    refine ⟨a₁ * a₂, mul_ne_zero ha₁_ne ha₂_ne,
      fun q hq => by
        have h_decomp : a₁ * a₂ - 1 = (a₁ - 1) * a₂ + (a₂ - 1) := by ring
        rw [h_decomp]
        exact Submodule.add_mem _ (Ideal.mul_mem_right a₂ _ (ha₁_ram q hq)) (ha₂_ram q hq),
      fun w hw => by
        push_cast
        rw [map_mul, Complex.mul_re]
        have him₁ : (w.embedding (a₁ : F)).im = 0 :=
          Complex.conj_eq_iff_im.mp (by
            have h_conj := congrFun (congrArg DFunLike.coe (NumberField.InfinitePlace.isReal_iff.mp hw)) (a₁ : F)
            exact h_conj)
        have him₂ : (w.embedding (a₂ : F)).im = 0 :=
          Complex.conj_eq_iff_im.mp (by
            have h_conj := congrFun (congrArg DFunLike.coe (NumberField.InfinitePlace.isReal_iff.mp hw)) (a₂ : F)
            exact h_conj)
        rw [him₁, him₂, mul_zero, sub_zero]
        exact mul_pos (ha₁_pos w hw) (ha₂_pos w hw),
      ?_⟩
    have hN_mul : N (a₁ * a₂) = N a₁ + N a₂ := by
      dsimp [N]
      have h_term : ∀ q : { q : ι // P q },
          e q.1 * (-WithZero.log (q.1.intValuation (a₁ * a₂))).toNat =
          e q.1 * (-WithZero.log (q.1.intValuation a₁)).toNat +
          e q.1 * (-WithZero.log (q.1.intValuation a₂)).toNat := by
        intro q
        have ha₁₂_ne : a₁ * a₂ ≠ 0 := mul_ne_zero ha₁_ne ha₂_ne
        have hIa₁_ne : Ideal.span ({a₁} : Set R_F) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr ha₁_ne
        have hIa₂_ne : Ideal.span ({a₂} : Set R_F) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr ha₂_ne
        have hIa₁_zero : Ideal.span ({a₁} : Set R_F) ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have hIa₂_zero : Ideal.span ({a₂} : Set R_F) ≠ 0 := by rwa [Submodule.zero_eq_bot]
        have hq_irr : Irreducible (Associates.mk q.1.asIdeal) :=
          IsDedekindDomain.HeightOneSpectrum.associates_irreducible q.1
        rw [IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg q.1 ha₁₂_ne,
            IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg q.1 ha₁_ne,
            IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg q.1 ha₂_ne,
            WithZero.log_exp, WithZero.log_exp, WithZero.log_exp,
            neg_neg, neg_neg, neg_neg,
            Int.toNat_natCast, Int.toNat_natCast, Int.toNat_natCast,
            ← Ideal.span_singleton_mul_span_singleton,
            ← Associates.mk_mul_mk,
            Associates.count_mul (Associates.mk_ne_zero.mpr hIa₁_zero) (Associates.mk_ne_zero.mpr hIa₂_zero) hq_irr,
            Nat.mul_add]
      simp_rw [h_term]
      exact finsum_add_distrib (h_fin_supp a₁ ha₁_ne) (h_fin_supp a₂ ha₂_ne)
    rw [hN_mul, pow_add]
  have h_pow : ∀ (ρ : E ≃ₐ[F] E), ρ ∈ S → ∀ k : ℕ, ρ ^ k ∈ S := by
    intro ρ hρ k
    induction k with
    | zero => simpa using h_one
    | succ k ih =>
      rw [pow_succ]
      exact h_mul ih hρ
  have h_inv : ∀ {ρ : E ≃ₐ[F] E}, ρ ∈ S → ρ⁻¹ ∈ S := by
    intro ρ hρ
    have h_ord_pos : 0 < orderOf ρ := orderOf_pos ρ
    have h_inv_eq : ρ ^ (orderOf ρ - 1) = ρ⁻¹ := by
      apply mul_eq_one_iff_eq_inv.mp
      rw [← pow_succ, Nat.sub_add_cancel h_ord_pos, pow_orderOf_eq_one]
    rw [← h_inv_eq]
    exact h_pow ρ hρ (orderOf ρ - 1)
  let H : Subgroup (E ≃ₐ[F] E) :=
    { carrier := S, mul_mem' := h_mul, one_mem' := h_one, inv_mem' := h_inv }
  have hH_bot : H = ⊥ := hc₀ H (fun _ hρ => hρ)
  have h_cast_finsum : ∀ x : R_F, x ≠ 0 →
      (∑ᶠ q : { q : ι // P q },
        ((e q.1 * (-WithZero.log (q.1.intValuation x)).toNat : ℕ) : ZMod d)) =
      ((N x : ℕ) : ZMod d) := by
    intro x hx
    dsimp [N]
    let f : { q : ι // P q } → ℕ := fun q => e q.1 * (-WithZero.log (q.1.intValuation x)).toNat
    let s := (h_fin_supp x hx).toFinset
    have hs1 : Function.support f ⊆ ↑s := fun q hq => (Set.Finite.mem_toFinset (h_fin_supp x hx)).mpr hq
    have hs2 : Function.support (fun q => (f q : ZMod d)) ⊆ ↑s := by
      intro q hq
      apply hs1
      rw [Function.mem_support] at hq ⊢
      intro h0
      apply hq
      rw [h0, Nat.cast_zero]
    rw [finsum_eq_sum_of_support_subset _ hs2, finsum_eq_sum_of_support_subset _ hs1, Nat.cast_sum]
  intro a ha_ne ha_ram ha_pos
  have h_mem_H : σ ^ (N a) ∈ H := ⟨a, ha_ne, ha_ram, ha_pos, rfl⟩
  rw [hH_bot, Subgroup.mem_bot] at h_mem_H
  refine ⟨1, one_ne_zero, ?_, ?_⟩
  · intro q hdvd
    have h_one_mem : (1 : R_F) ∈ q.asIdeal :=
      Ideal.dvd_span_singleton.mp (by rwa [map_one] at hdvd)
    exact False.elim (q.isMaximal.ne_top ((Ideal.eq_top_iff_one q.asIdeal).mpr h_one_mem))
  · rw [map_one, h_cast_finsum a ha_ne, h_cast_finsum 1 one_ne_zero]
    have h_pow_eq : σ ^ (N a) = σ ^ (N 1) := by
      rw [h_mem_H, hN1, pow_zero]
    have h_ord_σ : orderOf σ = d := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hCyclic, IsGalois.card_aut_eq_finrank F E]
    have h_mod : N a ≡ N 1 [MOD d] := by
      rw [← h_ord_σ]
      exact pow_eq_pow_iff_modEq.mp h_pow_eq
    exact (ZMod.natCast_eq_natCast_iff _ _ d).mpr h_mod

theorem exists_local_artin_symbols_and_reciprocity_sum_eq_zero {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_arith : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q →
      ∀ Q : Ideal (NumberField.RingOfIntegers E),
        Q.IsPrime →
        Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal →
        IsArithFrobAt (NumberField.RingOfIntegers F) (σ ^ (e q)) Q) :
    ∃ (ψ_fin : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        q.adicCompletion F → ZMod (Module.finrank F E))
      (ψ_inf : ∀ w : NumberField.InfinitePlace F,
        w.Completion → ZMod (Module.finrank F E)),
      (∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
        IsUnramifiedAtPrime F E q →
        ∀ (x : q.adicCompletion F) (m : ℕ),
          Valued.v x = WithZero.exp (-(m : ℤ)) →
          ψ_fin q x = (e q * m : ZMod (Module.finrank F E))) ∧
      (∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)),
        ¬ IsUnramifiedAtPrime F E q →
        ∀ᶠ x : q.adicCompletion F in nhds 1, ψ_fin q x = 0) ∧
      (∀ (w : NumberField.InfinitePlace F) (x : w.Completion),
        IsSquare x → ψ_inf w x = 0) ∧
      (∀ (a : NumberField.RingOfIntegers F),
        a ≠ 0 →
        ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))),
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            Valued.v (algebraMap F (q.adicCompletion F) (a : F)) ≠ 1 →
            q ∈ S) →
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            ¬ IsUnramifiedAtPrime F E q → q ∈ S) →
          (∑ q ∈ S, ψ_fin q (algebraMap F (q.adicCompletion F) (a : F))) +
            (∑ w : NumberField.InfinitePlace F,
              ψ_inf w (algebraMap F w.Completion (a : F))) = 0) :=
by
  obtain ⟨c, hc_norm⟩ :=
    exists_narrow_ray_unramified_frob_finsum_eq_intNorm σ hCyclic e he_arith
  refine exists_local_completion_symbols_of_narrow_ray_finsum_eq_zero
    (IsUnramifiedAtPrime F E) (Module.finrank F E) e c (fun a ha_ne ha_ram ha_pos => ?_)
  obtain ⟨b, hb_ne, hb_unr, h_eq⟩ := hc_norm a ha_ne ha_ram ha_pos
  rw [h_eq]
  exact unramified_intNorm_finsum_eq_zero_of_inertiaDeg_mul_eq_zero
    (IsUnramifiedAtPrime F E) (Module.finrank F E) e
    (unramified_frob_exponent_mul_inertiaDeg_eq_zero σ hCyclic e he_arith)
    b hb_ne hb_unr

theorem exists_ramified_modulus_frob_finsupp_sum_eq_one_of_principal_ray {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he_frob : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {σ ^ (e q)}) :
    ∃ m₀ : Ideal (NumberField.RingOfIntegers F),
      m₀ ≠ ⊥ ∧
      (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q) ∧
      (∀ (a : NumberField.RingOfIntegers F),
        a ≠ 0 →
        a - 1 ∈ m₀ →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) →
        ∀ f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
          Ideal.span {a} = f.prod (fun q m => q.asIdeal ^ m) →
          (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) →
          σ ^ (f.sum (fun q m => e q * m)) = 1) :=
by
  classical
  let ι := IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)
  have he_arith : ∀ q : ι,
      IsUnramifiedAtPrime F E q →
      ∀ Q : Ideal (NumberField.RingOfIntegers E),
        Q.IsPrime →
        Ideal.under (NumberField.RingOfIntegers F) Q = q.asIdeal →
        IsArithFrobAt (NumberField.RingOfIntegers F) (σ ^ (e q)) Q := by
    intro q hq Q hQ_prime hQ_under
    haveI : q.asIdeal.IsPrime := q.isPrime
    haveI : q.asIdeal.IsMaximal := q.isMaximal
    haveI : Q.IsPrime := hQ_prime
    haveI : Q.LiesOver q.asIdeal := ⟨hQ_under.symm⟩
    haveI : Q.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal Q q.asIdeal
    obtain ⟨g, hg_arith⟩ :=
      IsArithFrobAt.exists_of_isInvariant (NumberField.RingOfIntegers F) (E ≃ₐ[F] E) Q
    have hg_mem : g ∈ FrobeniusClassAt F E q := by
      refine ⟨Q, hQ_prime, hQ_under, fun x z hz => ?_⟩
      have hzx : z = g • x := Subtype.ext hz
      rw [hzx, ← hQ_under]
      exact hg_arith x
    have hg_eq : g = σ ^ (e q) := Set.mem_singleton_iff.mp (he_frob q hq hg_mem)
    exact hg_eq ▸ hg_arith
  let S_unr : Set ι := { q | IsUnramifiedAtPrime F E q }
  have hS : S_unrᶜ.Finite := by
    let D : Ideal (NumberField.RingOfIntegers E) :=
      differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)
    have hD : D ≠ ⊥ := differentIdeal_ne_bot
    let T_D : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers E)) :=
      { v | v.asIdeal ∣ D }
    have hT_D : T_D.Finite := Ideal.finite_factors hD
    have h_ex : ∀ q : ↑S_unrᶜ, ∃ v : ↑T_D,
        Ideal.under (NumberField.RingOfIntegers F) v.1.asIdeal = q.1.asIdeal := by
      intro ⟨q, hq⟩
      change ¬ IsUnramifiedAtPrime F E q at hq
      rw [IsUnramifiedAtPrime] at hq
      push_neg at hq
      rcases hq with ⟨P, hP_prime, h_under, h_ram⟩
      haveI : P.IsPrime := hP_prime
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      have h_map : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
          q.asIdeal ≤ P :=
        Ideal.map_le_iff_le_comap.mpr h_under.symm.le
      have h_le2 : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
          q.asIdeal ≤ P ^ 2 :=
        (Ideal.ramificationIdx_ne_one_iff h_map).mp h_ram
      have h_dvd2 : P ^ 2 ∣ Ideal.map
          (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal :=
        Ideal.dvd_iff_le.mpr h_le2
      have h_dvdD : P ∣ D := by
        simpa using pow_sub_one_dvd_differentIdeal (NumberField.RingOfIntegers F) P 2 q.ne_bot h_dvd2
      have hP_ne_bot : P ≠ ⊥ := by
        intro h_bot
        rw [h_bot, ← Submodule.zero_eq_bot, zero_dvd_iff, Submodule.zero_eq_bot] at h_dvdD
        exact hD h_dvdD
      exact ⟨⟨⟨P, hP_prime, hP_ne_bot⟩, h_dvdD⟩, h_under⟩
    choose φ hφ using h_ex
    have hφ_inj : Function.Injective φ := by
      intro q₁ q₂ hq
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      rw [← hφ q₁, hq, hφ q₂]
    haveI : Finite ↑T_D := hT_D.to_subtype
    haveI : Finite ↑S_unrᶜ := Finite.of_injective φ hφ_inj
    exact Set.finite_coe_iff.mp inferInstance
  obtain ⟨ψ_fin, ψ_inf, hψ_unr, hψ_ram, hψ_inf, h_recip⟩ :=
    exists_local_artin_symbols_and_reciprocity_sum_eq_zero σ hCyclic e he_arith
  have h_ex_c : ∀ q : ι, ∃ c : ℕ,
      ¬ IsUnramifiedAtPrime F E q →
      ∀ a : NumberField.RingOfIntegers F,
        a - 1 ∈ q.asIdeal ^ c →
        ψ_fin q (algebraMap F (q.adicCompletion F) (a : F)) = 0 := by
    intro q
    by_cases hq : IsUnramifiedAtPrime F E q
    · exact ⟨0, fun h_not => False.elim (h_not hq)⟩
    · obtain ⟨c, hc⟩ :=
        exists_ideal_pow_mem_of_eventually_nhds_one_adicCompletion q (ψ_fin q) 0 (hψ_ram q hq)
      exact ⟨c, fun _ => hc⟩
  choose c hc_ker using h_ex_c
  let m₀ : Ideal (NumberField.RingOfIntegers F) := ∏ q ∈ hS.toFinset, q.asIdeal ^ (c q)
  have hm₀_ne_bot : m₀ ≠ ⊥ := by
    change (∏ q ∈ hS.toFinset, q.asIdeal ^ (c q)) ≠ ⊥
    rw [← Submodule.zero_eq_bot]
    apply Finset.prod_ne_zero_iff.mpr
    intro q _
    apply pow_ne_zero
    rw [Submodule.zero_eq_bot]
    exact q.ne_bot
  have hm₀_ram : ∀ q : ι, q.asIdeal ∣ m₀ → ¬ IsUnramifiedAtPrime F E q := by
    intro q hdvd
    change q.asIdeal ∣ (∏ q' ∈ hS.toFinset, q'.asIdeal ^ (c q')) at hdvd
    rw [Prime.dvd_finset_prod_iff q.prime] at hdvd
    rcases hdvd with ⟨q', hq'_mem, hdvd_pow⟩
    have hdvd_q' : q.asIdeal ∣ q'.asIdeal := q.prime.dvd_of_dvd_pow hdvd_pow
    have hle : q'.asIdeal ≤ q.asIdeal := Ideal.dvd_iff_le.mp hdvd_q'
    have heq_ideal : q'.asIdeal = q.asIdeal :=
      q'.isMaximal.eq_of_le q.isMaximal.ne_top hle
    have heq : q' = q := IsDedekindDomain.HeightOneSpectrum.ext heq_ideal
    subst heq
    exact (Set.Finite.mem_toFinset hS).mp hq'_mem
  have hm₀_le : ∀ q : ι, ¬ IsUnramifiedAtPrime F E q → m₀ ≤ q.asIdeal ^ (c q) := by
    intro q hq_ram
    have hq_mem : q ∈ hS.toFinset := (Set.Finite.mem_toFinset hS).mpr hq_ram
    have hdvd : q.asIdeal ^ (c q) ∣ m₀ :=
      Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ (c q')) hq_mem
    exact Ideal.dvd_iff_le.mp hdvd
  refine ⟨m₀, hm₀_ne_bot, hm₀_ram, fun a ha_ne ha_m₀ ha_pos f hf_prod hf_unr => ?_⟩
  let S : Finset ι := f.support ∪ hS.toFinset
  have h_disj : Disjoint f.support hS.toFinset := by
    rw [Finset.disjoint_left]
    intro q hq_supp hq_ram
    have h1 : IsUnramifiedAtPrime F E q := hf_unr q hq_supp
    have h2 : ¬ IsUnramifiedAtPrime F E q := (Set.Finite.mem_toFinset hS).mp hq_ram
    exact h2 h1
  have hS_val : ∀ q : ι,
      Valued.v (algebraMap F (q.adicCompletion F) (a : F)) ≠ 1 → q ∈ S := by
    intro q h_ne_one
    have h_val := valued_algebraMap_adicCompletion_eq_exp_neg_of_span_eq_finsupp_prod a ha_ne f hf_prod q
    have hfq_ne : f q ≠ 0 := by
      intro hfq0
      apply h_ne_one
      rw [h_val, hfq0, Nat.cast_zero, neg_zero, WithZero.exp_zero]
    exact Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr hfq_ne)
  have hS_ram : ∀ q : ι, ¬ IsUnramifiedAtPrime F E q → q ∈ S := by
    intro q hq_ram
    exact Finset.mem_union_right _ ((Set.Finite.mem_toFinset hS).mpr hq_ram)
  have h_sum_zero := h_recip a ha_ne S hS_val hS_ram
  rw [Finset.sum_union h_disj] at h_sum_zero
  have h_sum_supp :
      (∑ q ∈ f.support, ψ_fin q (algebraMap F (q.adicCompletion F) (a : F))) =
        ((f.sum (fun q m => e q * m) : ℕ) : ZMod (Module.finrank F E)) := by
    rw [Finsupp.sum, Nat.cast_sum]
    refine Finset.sum_congr rfl fun q hq => ?_
    rw [Nat.cast_mul]
    have h_val := valued_algebraMap_adicCompletion_eq_exp_neg_of_span_eq_finsupp_prod a ha_ne f hf_prod q
    exact hψ_unr q (hf_unr q hq) (algebraMap F (q.adicCompletion F) (a : F)) (f q) h_val
  have h_sum_ram :
      (∑ q ∈ hS.toFinset, ψ_fin q (algebraMap F (q.adicCompletion F) (a : F))) = 0 := by
    refine Finset.sum_eq_zero fun q hq => ?_
    have hq_ram : ¬ IsUnramifiedAtPrime F E q := (Set.Finite.mem_toFinset hS).mp hq
    exact hc_ker q hq_ram a (hm₀_le q hq_ram ha_m₀)
  have h_sum_inf :
      (∑ w : NumberField.InfinitePlace F, ψ_inf w (algebraMap F w.Completion (a : F))) = 0 := by
    refine Finset.sum_eq_zero fun w _ => ?_
    exact hψ_inf w (algebraMap F w.Completion (a : F))
      (isSquare_algebraMap_infinitePlace_completion_of_pos_re a ha_pos w)
  rw [h_sum_supp, h_sum_ram, h_sum_inf, add_zero, add_zero] at h_sum_zero
  have hdvd : Module.finrank F E ∣ f.sum (fun q m => e q * m) :=
    (ZMod.natCast_eq_zero_iff (f.sum (fun q m => e q * m)) (Module.finrank F E)).mp h_sum_zero
  have h_ord_card : orderOf σ = Nat.card (E ≃ₐ[F] E) :=
    orderOf_eq_card_of_forall_mem_zpowers hCyclic
  have h_card_finrank : Nat.card (E ≃ₐ[F] E) = Module.finrank F E :=
    IsGalois.card_aut_eq_finrank F E
  rw [← h_card_finrank, ← h_ord_card] at hdvd
  exact orderOf_dvd_iff_pow_eq_one.mp hdvd

theorem exists_artin_conductor_ideal_of_cyclic {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (θ : Ideal (NumberField.RingOfIntegers F) → (E ≃ₐ[F] E))
    (hθ_top : θ ⊤ = 1)
    (hθ_mul : ∀ I₁ I₂ : Ideal (NumberField.RingOfIntegers F),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂)
    (hθ_frob : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {θ q.asIdeal}) :
    ∃ m : Ideal (NumberField.RingOfIntegers F),
      m ≠ ⊥ ∧
      (∀ I : Ideal (NumberField.RingOfIntegers F), I ≠ ⊥ →
        ((∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) ↔
          IsCoprime I m)) ∧
      (∀ a : NumberField.RingOfIntegers F,
        a ≠ 0 →
        a - 1 ∈ m →
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) →
        θ (Ideal.span {a}) = 1) :=
by
  classical
  let ι := IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)
  let S : Set ι := { q | IsUnramifiedAtPrime F E q }
  have hS : Sᶜ.Finite := by
    let D : Ideal (NumberField.RingOfIntegers E) :=
      differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)
    have hD : D ≠ ⊥ := differentIdeal_ne_bot
    let T_D : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers E)) :=
      { v | v.asIdeal ∣ D }
    have hT_D : T_D.Finite := Ideal.finite_factors hD
    have h_ex : ∀ q : ↑Sᶜ, ∃ v : ↑T_D,
        Ideal.under (NumberField.RingOfIntegers F) v.1.asIdeal = q.1.asIdeal := by
      intro ⟨q, hq⟩
      change ¬ IsUnramifiedAtPrime F E q at hq
      rw [IsUnramifiedAtPrime] at hq
      push_neg at hq
      rcases hq with ⟨P, hP_prime, h_under, h_ram⟩
      haveI : P.IsPrime := hP_prime
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      have h_map : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
          q.asIdeal ≤ P :=
        Ideal.map_le_iff_le_comap.mpr h_under.symm.le
      have h_le2 : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
          q.asIdeal ≤ P ^ 2 :=
        (Ideal.ramificationIdx_ne_one_iff h_map).mp h_ram
      have h_dvd2 : P ^ 2 ∣ Ideal.map
          (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)) q.asIdeal :=
        Ideal.dvd_iff_le.mpr h_le2
      have h_dvdD : P ∣ D := by
        simpa using pow_sub_one_dvd_differentIdeal (NumberField.RingOfIntegers F) P 2 q.ne_bot h_dvd2
      have hP_ne_bot : P ≠ ⊥ := by
        intro h_bot
        rw [h_bot, ← Submodule.zero_eq_bot, zero_dvd_iff, Submodule.zero_eq_bot] at h_dvdD
        exact hD h_dvdD
      exact ⟨⟨⟨P, hP_prime, hP_ne_bot⟩, h_dvdD⟩, h_under⟩
    choose φ hφ using h_ex
    have hφ_inj : Function.Injective φ := by
      intro q₁ q₂ hq
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      rw [← hφ q₁, hq, hφ q₂]
    haveI : Finite ↑T_D := hT_D.to_subtype
    haveI : Finite ↑Sᶜ := Finite.of_injective φ hφ_inj
    exact Set.finite_coe_iff.mp inferInstance
  let r : Ideal (NumberField.RingOfIntegers F) := ∏ q ∈ hS.toFinset, q.asIdeal
  have hr_ne_bot : r ≠ ⊥ := by
    change (∏ q ∈ hS.toFinset, q.asIdeal) ≠ ⊥
    rw [← Submodule.zero_eq_bot]
    apply Finset.prod_ne_zero_iff.mpr
    intro q _
    rw [Submodule.zero_eq_bot]
    exact q.ne_bot
  have hr_dvd : ∀ q : ι, q.asIdeal ∣ r ↔ ¬ IsUnramifiedAtPrime F E q := by
    intro q
    change q.asIdeal ∣ (∏ q' ∈ hS.toFinset, q'.asIdeal) ↔ ¬ IsUnramifiedAtPrime F E q
    rw [Prime.dvd_finset_prod_iff q.prime]
    constructor
    · rintro ⟨q', hq'_mem, hdvd⟩
      have hle : q'.asIdeal ≤ q.asIdeal := Ideal.dvd_iff_le.mp hdvd
      have heq_ideal : q'.asIdeal = q.asIdeal :=
        q'.isMaximal.eq_of_le q.isMaximal.ne_top hle
      have heq : q' = q := IsDedekindDomain.HeightOneSpectrum.ext heq_ideal
      subst heq
      exact Set.Finite.mem_toFinset hS |>.mp hq'_mem
    · intro hq_ram
      refine ⟨q, (Set.Finite.mem_toFinset hS).mpr hq_ram, dvd_rfl⟩
  obtain ⟨e, he_frob, he_θ⟩ :=
    exists_frob_exponent_and_artin_map_eq_pow_finsupp_sum σ hCyclic θ hθ_top hθ_mul hθ_frob
  obtain ⟨m₀, hm₀_ne_bot, hm₀_ram, hm₀_ker⟩ :=
    exists_ramified_modulus_frob_finsupp_sum_eq_one_of_principal_ray σ hCyclic e he_frob
  let m : Ideal (NumberField.RingOfIntegers F) := m₀ * r
  have hm_ne_bot : m ≠ ⊥ := by
    change m₀ * r ≠ ⊥
    rw [← Submodule.zero_eq_bot] at hm₀_ne_bot hr_ne_bot ⊢
    exact mul_ne_zero hm₀_ne_bot hr_ne_bot
  have hm_dvd : ∀ q : ι, q.asIdeal ∣ m ↔ ¬ IsUnramifiedAtPrime F E q := by
    intro q
    change q.asIdeal ∣ m₀ * r ↔ ¬ IsUnramifiedAtPrime F E q
    rw [q.prime.dvd_mul, hr_dvd q]
    exact ⟨fun h => h.elim (hm₀_ram q) id, Or.inr⟩
  have hm_unram : ∀ I : Ideal (NumberField.RingOfIntegers F), I ≠ ⊥ →
      ((∀ q : ι, q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) ↔ IsCoprime I m) := by
    intro I _
    constructor
    · intro h_unr
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      obtain ⟨M, hM_max, h_le_M⟩ := Ideal.exists_le_maximal (I ⊔ m) h_ne_top
      have hI_le_M : I ≤ M := le_sup_left.trans h_le_M
      have hm_le_M : m ≤ M := le_sup_right.trans h_le_M
      have hM_ne_bot : M ≠ ⊥ := by
        intro hM_bot
        apply hm_ne_bot
        exact le_bot_iff.mp (hM_bot ▸ hm_le_M)
      let q_M : ι := ⟨M, hM_max.isPrime, hM_ne_bot⟩
      have hqM_dvd_I : q_M.asIdeal ∣ I := Ideal.dvd_iff_le.mpr hI_le_M
      have hqM_dvd_m : q_M.asIdeal ∣ m := Ideal.dvd_iff_le.mpr hm_le_M
      exact (hm_dvd q_M).mp hqM_dvd_m (h_unr q_M hqM_dvd_I)
    · intro h_cop q hq_I
      by_contra hq_ram
      have hq_m : q.asIdeal ∣ m := (hm_dvd q).mpr hq_ram
      have hI_le : I ≤ q.asIdeal := Ideal.dvd_iff_le.mp hq_I
      have hm_le : m ≤ q.asIdeal := Ideal.dvd_iff_le.mp hq_m
      have h_top_le : ⊤ ≤ q.asIdeal := by
        rw [← Ideal.isCoprime_iff_sup_eq.mp h_cop]
        exact sup_le hI_le hm_le
      exact q.isMaximal.ne_top (top_le_iff.mp h_top_le)
  refine ⟨m, hm_ne_bot, hm_unram, fun a ha_ne ha_m ha_pos => ?_⟩
  have h_span_ne : Ideal.span {a} ≠ ⊥ := by
    rwa [ne_eq, Ideal.span_singleton_eq_bot]
  have ha_m₀ : a - 1 ∈ m₀ := Ideal.mul_le_right ha_m
  have h_cop_span : IsCoprime (Ideal.span {a}) m := by
    rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
    have ha_mem : a ∈ Ideal.span {a} := Ideal.subset_span (Set.mem_singleton a)
    have h_neg : 1 - a ∈ m := by
      have h1 : -(a - 1) ∈ m := m.neg_mem ha_m
      rwa [neg_sub] at h1
    have h_sum : a + (1 - a) ∈ Ideal.span {a} ⊔ m :=
      Submodule.add_mem_sup ha_mem h_neg
    rwa [add_sub_cancel] at h_sum
  have h_span_unr : ∀ q : ι, q.asIdeal ∣ Ideal.span {a} → IsUnramifiedAtPrime F E q :=
    (hm_unram (Ideal.span {a}) h_span_ne).mpr h_cop_span
  obtain ⟨f, hf_prod, hf_supp, hf_θ⟩ := he_θ (Ideal.span {a}) h_span_ne h_span_unr
  rw [hf_θ]
  exact hm₀_ker a ha_ne ha_m₀ ha_pos f hf_prod hf_supp

theorem exists_ray_class_decomposition_of_cyclic_artin_map {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (θ : Ideal (NumberField.RingOfIntegers F) → (E ≃ₐ[F] E))
    (hθ_top : θ ⊤ = 1)
    (hθ_mul : ∀ I₁ I₂ : Ideal (NumberField.RingOfIntegers F),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂)
    (hθ_frob : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {θ q.asIdeal}) :
    ∃ (m : Ideal (NumberField.RingOfIntegers F)) (k : ℕ)
      (J : (E ≃ₐ[F] E) → Fin k → Ideal (NumberField.RingOfIntegers F)),
      m ≠ ⊥ ∧
      (∀ (ρ : E ≃ₐ[F] E) (i : Fin k), J ρ i ≠ ⊥ ∧ IsCoprime (J ρ i) m) ∧
      (∀ (ρ : E ≃ₐ[F] E) (n : ℕ),
        Nat.card { I : Ideal (NumberField.RingOfIntegers F) //
          I ≠ ⊥ ∧
          (∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
            q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) ∧
          θ I = ρ ∧
          Ideal.absNorm I ≤ n } =
        ∑ i : Fin k,
          Nat.card { I : Ideal (NumberField.RingOfIntegers F) //
            I ≠ ⊥ ∧
            (∃ a : NumberField.RingOfIntegers F,
              a - 1 ∈ m ∧
              (∀ w : NumberField.InfinitePlace F,
                w.IsReal → 0 < (w.embedding (a : F)).re) ∧
              I * J ρ i = Ideal.span {a}) ∧
            Ideal.absNorm I ≤ n }) :=
by
  classical
  let R := NumberField.RingOfIntegers F
  obtain ⟨m, hm_ne_bot, hm_unram, hm_ker⟩ :=
    exists_artin_conductor_ideal_of_cyclic σ hCyclic θ hθ_top hθ_mul hθ_frob
  have h_surj : ∀ τ : E ≃ₐ[F] E, ∃ K : Ideal R, K ≠ ⊥ ∧ IsCoprime K m ∧ θ K = τ := by
    intro τ
    obtain ⟨K, hK_ne, hK_unr, hK_θ⟩ :=
      exists_unramified_ideal_artin_surjective σ hCyclic θ hθ_top hθ_mul hθ_frob τ
    exact ⟨K, hK_ne, (hm_unram K hK_ne).mp hK_unr, hK_θ⟩
  choose K hK_ne hK_cop hK_θ using h_surj
  obtain ⟨N_ray, J_all, hJ_all_prop, hJ_all_cov, hJ_all_inj⟩ :=
    exists_finite_narrow_ray_class_partition m hm_ne_bot
  let InRayCell : Ideal R → Ideal R → Prop := fun I J₀ =>
    ∃ a : R,
      a - 1 ∈ m ∧
      (∀ w : NumberField.InfinitePlace F, w.IsReal → 0 < (w.embedding (a : F)).re) ∧
      I * J₀ = Ideal.span {a}
  have h_cell_prop : ∀ (I J₀ : Ideal R),
      I ≠ ⊥ → J₀ ≠ ⊥ → InRayCell I J₀ → IsCoprime I m ∧ θ I * θ J₀ = 1 := by
    rintro I J₀ hI hJ₀ ⟨a, ha_m, ha_pos, hIJ⟩
    have hIJ_ne : I * J₀ ≠ ⊥ := by
      rw [← Submodule.zero_eq_bot] at hI hJ₀ ⊢
      exact mul_ne_zero hI hJ₀
    have ha_ne : a ≠ 0 := by
      intro ha0
      apply hIJ_ne
      rw [hIJ, ha0, Ideal.span_singleton_eq_bot.mpr rfl]
    have h_cop_prod : IsCoprime (I * J₀) m := by
      rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
      have ha_mem : a ∈ I * J₀ := by
        rw [hIJ]
        exact Ideal.subset_span (Set.mem_singleton a)
      have h_neg : 1 - a ∈ m := by
        have h1 : -(a - 1) ∈ m := m.neg_mem ha_m
        have h2 : -(a - 1) = 1 - a := neg_sub a 1
        rwa [h2] at h1
      have h_sum : a + (1 - a) ∈ (I * J₀) ⊔ m :=
        Submodule.add_mem_sup ha_mem h_neg
      have h_eq1 : a + (1 - a) = 1 := add_sub_cancel a 1
      rwa [h_eq1] at h_sum
    have h_cop_I : IsCoprime I m := IsCoprime.of_mul_left_left h_cop_prod
    have h_θ_prod : θ I * θ J₀ = 1 := by
      rw [← hθ_mul I J₀ hI hJ₀, hIJ]
      exact hm_ker a ha_ne ha_m ha_pos
    exact ⟨h_cop_I, h_θ_prod⟩
  let T₁ := { j : Fin N_ray // θ (J_all j) = 1 }
  let k : ℕ := Fintype.card T₁
  let e_k : Fin k ≃ T₁ := (Fintype.equivFin T₁).symm
  let J₁ : Fin k → Ideal R := fun i => J_all (e_k i).1
  have hJ₁_ne : ∀ i : Fin k, J₁ i ≠ ⊥ := fun i => (hJ_all_prop (e_k i).1).1
  have hJ₁_cop : ∀ i : Fin k, IsCoprime (J₁ i) m := fun i => (hJ_all_prop (e_k i).1).2
  have hJ₁_θ : ∀ i : Fin k, θ (J₁ i) = 1 := fun i => (e_k i).2
  let J : (E ≃ₐ[F] E) → Fin k → Ideal R := fun ρ i => K (ρ⁻¹) * J₁ i
  have hJ_prop : ∀ (ρ : E ≃ₐ[F] E) (i : Fin k), J ρ i ≠ ⊥ ∧ IsCoprime (J ρ i) m := by
    intro ρ i
    refine ⟨?_, IsCoprime.mul_left (hK_cop (ρ⁻¹)) (hJ₁_cop i)⟩
    have h1 : K (ρ⁻¹) ≠ ⊥ := hK_ne (ρ⁻¹)
    have h2 : J₁ i ≠ ⊥ := hJ₁_ne i
    change K (ρ⁻¹) * J₁ i ≠ ⊥
    rw [← Submodule.zero_eq_bot] at h1 h2 ⊢
    exact mul_ne_zero h1 h2
  have h_cell_assoc : ∀ (I : Ideal R) (ρ : E ≃ₐ[F] E) (i : Fin k),
      InRayCell I (J ρ i) ↔ InRayCell (I * K (ρ⁻¹)) (J₁ i) := by
    intro I ρ i
    dsimp [InRayCell, J]
    simp only [mul_assoc]
  have h_sound : ∀ (I : Ideal R) (ρ : E ≃ₐ[F] E) (i : Fin k),
      I ≠ ⊥ → InRayCell I (J ρ i) →
      (∀ q : IsDedekindDomain.HeightOneSpectrum R, q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) ∧
      θ I = ρ := by
    intro I ρ i hI h_cell
    have h_cell' : InRayCell (I * K (ρ⁻¹)) (J₁ i) := (h_cell_assoc I ρ i).mp h_cell
    have hIK_ne : I * K (ρ⁻¹) ≠ ⊥ := by
      have h1 : I ≠ ⊥ := hI
      have h2 : K (ρ⁻¹) ≠ ⊥ := hK_ne (ρ⁻¹)
      rw [← Submodule.zero_eq_bot] at h1 h2 ⊢
      exact mul_ne_zero h1 h2
    obtain ⟨h_cop_IK, h_θ_IK⟩ := h_cell_prop (I * K (ρ⁻¹)) (J₁ i) hIK_ne (hJ₁_ne i) h_cell'
    have h_cop_I : IsCoprime I m := IsCoprime.of_mul_left_left h_cop_IK
    have h_unr : ∀ q : IsDedekindDomain.HeightOneSpectrum R, q.asIdeal ∣ I → IsUnramifiedAtPrime F E q :=
      (hm_unram I hI).mpr h_cop_I
    have h_θ_I : θ I = ρ := by
      rw [hJ₁_θ i, mul_one, hθ_mul I (K (ρ⁻¹)) hI (hK_ne (ρ⁻¹)), hK_θ (ρ⁻¹)] at h_θ_IK
      exact mul_inv_eq_one.mp h_θ_IK
    exact ⟨h_unr, h_θ_I⟩
  have h_comp : ∀ (I : Ideal R) (ρ : E ≃ₐ[F] E),
      I ≠ ⊥ →
      (∀ q : IsDedekindDomain.HeightOneSpectrum R, q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) →
      θ I = ρ →
      ∃ i : Fin k, InRayCell I (J ρ i) := by
    intro I ρ hI h_unr h_θ
    have h_cop_I : IsCoprime I m := (hm_unram I hI).mp h_unr
    let I' : Ideal R := I * K (ρ⁻¹)
    have hI'_ne : I' ≠ ⊥ := by
      have h1 : I ≠ ⊥ := hI
      have h2 : K (ρ⁻¹) ≠ ⊥ := hK_ne (ρ⁻¹)
      change I * K (ρ⁻¹) ≠ ⊥
      rw [← Submodule.zero_eq_bot] at h1 h2 ⊢
      exact mul_ne_zero h1 h2
    have hI'_cop : IsCoprime I' m := IsCoprime.mul_left h_cop_I (hK_cop (ρ⁻¹))
    have hI'_θ : θ I' = 1 := by
      change θ (I * K (ρ⁻¹)) = 1
      rw [hθ_mul I (K (ρ⁻¹)) hI (hK_ne (ρ⁻¹)), h_θ, hK_θ (ρ⁻¹), mul_inv_cancel]
    obtain ⟨j, hj_cell⟩ := hJ_all_cov I' hI'_ne hI'_cop
    obtain ⟨_, h_θ_prod⟩ := h_cell_prop I' (J_all j) hI'_ne (hJ_all_prop j).1 hj_cell
    rw [hI'_θ, one_mul] at h_θ_prod
    let i : Fin k := e_k.symm ⟨j, h_θ_prod⟩
    refine ⟨i, (h_cell_assoc I ρ i).mpr ?_⟩
    have hi_eq : (e_k i).1 = j := by
      dsimp [i]
      rw [e_k.apply_symm_apply]
    dsimp [J₁]
    rw [hi_eq]
    exact hj_cell
  have h_disj : ∀ (I : Ideal R) (ρ : E ≃ₐ[F] E) (i₁ i₂ : Fin k),
      I ≠ ⊥ → InRayCell I (J ρ i₁) → InRayCell I (J ρ i₂) → i₁ = i₂ := by
    intro I ρ i₁ i₂ hI h₁ h₂
    have hIK_ne : I * K (ρ⁻¹) ≠ ⊥ := by
      have h1 : I ≠ ⊥ := hI
      have h2 : K (ρ⁻¹) ≠ ⊥ := hK_ne (ρ⁻¹)
      rw [← Submodule.zero_eq_bot] at h1 h2 ⊢
      exact mul_ne_zero h1 h2
    have h₁' : InRayCell (I * K (ρ⁻¹)) (J_all (e_k i₁).1) := (h_cell_assoc I ρ i₁).mp h₁
    have h₂' : InRayCell (I * K (ρ⁻¹)) (J_all (e_k i₂).1) := (h_cell_assoc I ρ i₂).mp h₂
    have hj_eq : (e_k i₁).1 = (e_k i₂).1 :=
      hJ_all_inj (I * K (ρ⁻¹)) (e_k i₁).1 (e_k i₂).1 hIK_ne h₁' h₂'
    exact e_k.injective (Subtype.ext hj_eq)
  refine ⟨m, k, J, hm_ne_bot, hJ_prop, fun ρ n => ?_⟩
  let L_sub := { I : Ideal R //
    I ≠ ⊥ ∧
    (∀ q : IsDedekindDomain.HeightOneSpectrum R, q.asIdeal ∣ I → IsUnramifiedAtPrime F E q) ∧
    θ I = ρ ∧
    Ideal.absNorm I ≤ n }
  let R_sub : Fin k → Type _ := fun i =>
    { I : Ideal R // I ≠ ⊥ ∧ InRayCell I (J ρ i) ∧ Ideal.absNorm I ≤ n }
  haveI : Finite L_sub := by
    haveI : Finite { I : Ideal R // Ideal.absNorm I ≤ n } :=
      Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_le n)
    let ι_L : L_sub → { I : Ideal R // Ideal.absNorm I ≤ n } :=
      fun x => ⟨x.1, x.2.2.2.2⟩
    have hι_inj : Function.Injective ι_L := by
      intro x₁ x₂ h
      have h_val := congrArg (Subtype.val : { I : Ideal R // Ideal.absNorm I ≤ n } → Ideal R) h
      exact Subtype.ext h_val
    exact Finite.of_injective ι_L hι_inj
  letI : Fintype L_sub := Fintype.ofFinite L_sub
  let ψ : L_sub → Fin k := fun u => Classical.choose (h_comp u.1 ρ u.2.1 u.2.2.1 u.2.2.2.1)
  have hψ_spec : ∀ u : L_sub, InRayCell u.1 (J ρ (ψ u)) :=
    fun u => Classical.choose_spec (h_comp u.1 ρ u.2.1 u.2.2.1 u.2.2.2.1)
  have h_fib : ∀ i : Fin k, Nat.card (R_sub i) = Fintype.card { u : L_sub // ψ u = i } := by
    intro i
    rw [← Nat.card_eq_fintype_card]
    let e_i : R_sub i ≃ { u : L_sub // ψ u = i } :=
      { toFun := fun v =>
          let h_s := h_sound v.1 ρ i v.2.1 v.2.2.1
          let u : L_sub := ⟨v.1, v.2.1, h_s.1, h_s.2, v.2.2.2⟩
          ⟨u, h_disj v.1 ρ (ψ u) i v.2.1 (hψ_spec u) v.2.2.1⟩
        invFun := fun ⟨u, hu⟩ =>
          ⟨u.1, u.2.1, hu ▸ hψ_spec u, u.2.2.2.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun ⟨_, _⟩ => Subtype.ext (Subtype.ext rfl) }
    exact Nat.card_congr e_i
  change Nat.card L_sub = ∑ i : Fin k, Nat.card (R_sub i)
  simp_rw [h_fib]
  rw [← Fintype.card_sigma, ← Nat.card_eq_fintype_card]
  exact (Nat.card_congr (Equiv.sigmaFiberEquiv ψ)).symm

theorem frob_coset_natCard_sub_isBigO {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {σ ^ (e q)})
    (ρ τ : E ≃ₐ[F] E) :
    (fun n : ℕ =>
      (Nat.card { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
        (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
        σ ^ (f.sum (fun q m => e q * m)) = ρ ∧
        Ideal.absNorm (f.prod (fun q m => q.asIdeal ^ m)) ≤ n } : ℝ) -
      (Nat.card { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
        (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
        σ ^ (f.sum (fun q m => e q * m)) = τ ∧
        Ideal.absNorm (f.prod (fun q m => q.asIdeal ^ m)) ≤ n } : ℝ)) =O[Filter.atTop]
    (fun n : ℕ => (n : ℝ) ^ (1 - 1 / (Module.finrank ℚ F : ℝ))) :=
by
  classical
  let ι := IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)
  let I : (ι →₀ ℕ) → Ideal (NumberField.RingOfIntegers F) :=
    fun f => f.prod (fun q m => q.asIdeal ^ m)
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal :
        ι → Ideal (NumberField.RingOfIntegers F)) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  have h_toMultiset_prod :
      ∀ f : ι →₀ ℕ,
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod =
          I f := by
    intro f
    unfold I
    rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
      Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
  have h_prod_ne_bot : ∀ f : ι →₀ ℕ, I f ≠ ⊥ := by
    intro f
    rw [← h_toMultiset_prod f, ← Submodule.zero_eq_bot]
    apply Multiset.prod_ne_zero
    intro h0
    rw [Multiset.mem_map] at h0
    rcases h0 with ⟨q, _, hq0⟩
    rw [Submodule.zero_eq_bot] at hq0
    exact q.ne_bot hq0
  have h_normFactors :
      ∀ f : ι →₀ ℕ,
        UniqueFactorizationMonoid.normalizedFactors (I f) =
          Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f) := by
    intro f
    rw [← h_toMultiset_prod f]
    apply UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
    intro p hp
    rw [Multiset.mem_map] at hp
    rcases hp with ⟨q, _, rfl⟩
    exact q.prime
  have hI_inj : Function.Injective I := by
    intro f₁ f₂ hval
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hval
    rw [h_normFactors f₁, h_normFactors f₂] at hnf
    have htm : Finsupp.toMultiset f₁ = Finsupp.toMultiset f₂ :=
      Multiset.map_injective hasIdeal_inj hnf
    have htf := congrArg Multiset.toFinsupp htm
    simpa only [Finsupp.toMultiset_toFinsupp] using htf
  let Φ : (ι →₀ ℕ) → { J : Ideal (NumberField.RingOfIntegers F) // J ≠ ⊥ } :=
    fun f => ⟨I f, h_prod_ne_bot f⟩
  have hΦ_inj : Function.Injective Φ := by
    intro f₁ f₂ h
    exact hI_inj (congrArg Subtype.val h)
  have hΦ_surj : Function.Surjective Φ := by
    rintro ⟨J, hJ⟩
    let N := UniqueFactorizationMonoid.normalizedFactors J
    let m : Multiset ι :=
      Multiset.pmap
        (fun (p : Ideal (NumberField.RingOfIntegers F)) (hp : Prime p) =>
          IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
        N
        (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
    let f : ι →₀ ℕ := Multiset.toFinsupp m
    refine ⟨f, Subtype.ext ?_⟩
    change I f = J
    rw [← h_toMultiset_prod f]
    have hfm : Finsupp.toMultiset f = m := Multiset.toFinsupp_toMultiset m
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m = N := by
      dsimp [m]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact prod_normalizedFactors_eq_self hJ
  let e_ufm : (ι →₀ ℕ) ≃ { J : Ideal (NumberField.RingOfIntegers F) // J ≠ ⊥ } :=
    Equiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩
  have he_ufm_symm : ∀ (J : Ideal (NumberField.RingOfIntegers F)) (hJ : J ≠ ⊥),
      I (e_ufm.symm ⟨J, hJ⟩) = J := by
    intro J hJ
    exact congrArg Subtype.val (e_ufm.apply_symm_apply ⟨J, hJ⟩)
  let θ : Ideal (NumberField.RingOfIntegers F) → (E ≃ₐ[F] E) :=
    fun J => if hJ : J = ⊥ then 1 else σ ^ ((e_ufm.symm ⟨J, hJ⟩).sum (fun q m => e q * m))
  have hθ_of_I : ∀ f : ι →₀ ℕ, θ (I f) = σ ^ (f.sum (fun q m => e q * m)) := by
    intro f
    dsimp [θ]
    rw [dif_neg (h_prod_ne_bot f)]
    have h_eq : e_ufm.symm ⟨I f, h_prod_ne_bot f⟩ = f := e_ufm.symm_apply_apply f
    rw [h_eq]
  have hθ_top : θ ⊤ = 1 := by
    have hI0 : I 0 = ⊤ := by
      unfold I
      simp
    rw [← hI0, hθ_of_I 0, Finsupp.sum_zero_index, pow_zero]
  have hθ_mul : ∀ I₁ I₂ : Ideal (NumberField.RingOfIntegers F),
      I₁ ≠ ⊥ → I₂ ≠ ⊥ → θ (I₁ * I₂) = θ I₁ * θ I₂ := by
    intro I₁ I₂ hI₁ hI₂
    let f₁ := e_ufm.symm ⟨I₁, hI₁⟩
    let f₂ := e_ufm.symm ⟨I₂, hI₂⟩
    have hf₁ : I f₁ = I₁ := he_ufm_symm I₁ hI₁
    have hf₂ : I f₂ = I₂ := he_ufm_symm I₂ hI₂
    have hI_add : I (f₁ + f₂) = I f₁ * I f₂ := by
      unfold I
      exact Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)
    rw [← hf₁, ← hf₂, ← hI_add, hθ_of_I (f₁ + f₂), hθ_of_I f₁, hθ_of_I f₂,
      Finsupp.sum_add_index' (fun _ => mul_zero _) (fun _ _ _ => mul_add _ _ _), pow_add]
  have hθ_frob : ∀ q : ι,
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {θ q.asIdeal} := by
    intro q hq
    have h_prod_single : (Finsupp.single q 1 : ι →₀ ℕ).prod (fun q' m => q'.asIdeal ^ m) = q.asIdeal ^ 1 :=
      Finsupp.prod_single_index (pow_zero _)
    have hI_single : I (Finsupp.single q 1) = q.asIdeal := by
      unfold I
      rw [h_prod_single, pow_one]
    have h_sum_single : (Finsupp.single q 1 : ι →₀ ℕ).sum (fun q' m => e q' * m) = e q * 1 :=
      Finsupp.sum_single_index (mul_zero _)
    have hθ_q : θ q.asIdeal = σ ^ (e q) := by
      rw [← hI_single, hθ_of_I (Finsupp.single q 1), h_sum_single, mul_one]
    rw [hθ_q]
    exact he q hq
  have h_supp_iff_dvd : ∀ (f : ι →₀ ℕ) (q : ι),
      q ∈ f.support ↔ q.asIdeal ∣ I f := by
    intro f q
    constructor
    · intro hq
      unfold I
      rw [Finsupp.prod]
      have h_dvd_pow : q.asIdeal ∣ q.asIdeal ^ f q :=
        dvd_pow_self _ (Finsupp.mem_support_iff.mp hq)
      exact dvd_trans h_dvd_pow (Finset.dvd_prod_of_mem (fun q' => q'.asIdeal ^ f q') hq)
    · intro hdvd
      unfold I at hdvd
      rw [Finsupp.prod, Prime.dvd_finset_prod_iff q.prime] at hdvd
      rcases hdvd with ⟨q', hq'_supp, h_dvd_pow⟩
      have h_dvd_q' : q.asIdeal ∣ q'.asIdeal := q.prime.dvd_of_dvd_pow h_dvd_pow
      have h_le : q'.asIdeal ≤ q.asIdeal := Ideal.dvd_iff_le.mp h_dvd_q'
      have h_eq_ideal : q'.asIdeal = q.asIdeal :=
        q'.isMaximal.eq_of_le q.isMaximal.ne_top h_le
      have h_eq : q' = q := hasIdeal_inj h_eq_ideal
      exact h_eq ▸ hq'_supp
  have hθ_card : ∀ (γ : E ≃ₐ[F] E) (n : ℕ),
      Nat.card { f : ι →₀ ℕ //
        (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
        σ ^ (f.sum (fun q m => e q * m)) = γ ∧
        Ideal.absNorm (I f) ≤ n } =
      Nat.card { J : Ideal (NumberField.RingOfIntegers F) //
        J ≠ ⊥ ∧
        (∀ q : ι, q.asIdeal ∣ J → IsUnramifiedAtPrime F E q) ∧
        θ J = γ ∧
        Ideal.absNorm J ≤ n } := by
    intro γ n
    let e_sub : { f : ι →₀ ℕ //
        (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
        σ ^ (f.sum (fun q m => e q * m)) = γ ∧
        Ideal.absNorm (I f) ≤ n } ≃
      { J : Ideal (NumberField.RingOfIntegers F) //
        J ≠ ⊥ ∧
        (∀ q : ι, q.asIdeal ∣ J → IsUnramifiedAtPrime F E q) ∧
        θ J = γ ∧
        Ideal.absNorm J ≤ n } :=
      { toFun := fun u =>
          ⟨I u.1, h_prod_ne_bot u.1,
            fun q hq => u.2.1 q ((h_supp_iff_dvd u.1 q).mpr hq),
            by rw [hθ_of_I u.1, u.2.2.1],
            u.2.2.2⟩
        invFun := fun v =>
          ⟨e_ufm.symm ⟨v.1, v.2.1⟩,
            fun q hq => by
              have hdvd : q.asIdeal ∣ v.1 := by
                rw [← he_ufm_symm v.1 v.2.1]
                exact (h_supp_iff_dvd (e_ufm.symm ⟨v.1, v.2.1⟩) q).mp hq
              exact v.2.2.1 q hdvd,
            by
              have h1 := hθ_of_I (e_ufm.symm ⟨v.1, v.2.1⟩)
              rw [he_ufm_symm v.1 v.2.1] at h1
              rw [← h1, v.2.2.2.1],
            by
              rw [he_ufm_symm v.1 v.2.1]
              exact v.2.2.2.2⟩
        left_inv := fun u => Subtype.ext (e_ufm.symm_apply_apply u.1)
        right_inv := fun v => Subtype.ext (he_ufm_symm v.1 v.2.1) }
    exact Nat.card_congr e_sub
  obtain ⟨m, k, J, hm_ne_bot, hJ_prop, h_ray_part⟩ :=
    exists_ray_class_decomposition_of_cyclic_artin_map σ hCyclic θ hθ_top hθ_mul hθ_frob
  have h_clear : ∀ (J₀ : Ideal (NumberField.RingOfIntegers F)), J₀ ≠ ⊥ → ∀ (n : ℕ),
      Nat.card { I₀ : Ideal (NumberField.RingOfIntegers F) //
        I₀ ≠ ⊥ ∧
        (∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I₀ * J₀ = Ideal.span {a}) ∧
        Ideal.absNorm I₀ ≤ n } =
      Nat.card { P : Ideal (NumberField.RingOfIntegers F) //
        P ≠ ⊥ ∧
        (∃ a ∈ J₀,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          P = Ideal.span {a}) ∧
        Ideal.absNorm P ≤ n * Ideal.absNorm J₀ } := by
    intro J₀ hJ₀ n
    have hJ₀_pos : 0 < Ideal.absNorm J₀ :=
      Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr
        (mem_nonZeroDivisors_of_ne_zero (by rw [Submodule.zero_eq_bot]; exact hJ₀))
    let L_sub := { I₀ : Ideal (NumberField.RingOfIntegers F) //
        I₀ ≠ ⊥ ∧
        (∃ a : NumberField.RingOfIntegers F,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          I₀ * J₀ = Ideal.span {a}) ∧
        Ideal.absNorm I₀ ≤ n }
    let R_sub := { P : Ideal (NumberField.RingOfIntegers F) //
        P ≠ ⊥ ∧
        (∃ a ∈ J₀,
          a - 1 ∈ m ∧
          (∀ w : NumberField.InfinitePlace F,
            w.IsReal → 0 < (w.embedding (a : F)).re) ∧
          P = Ideal.span {a}) ∧
        Ideal.absNorm P ≤ n * Ideal.absNorm J₀ }
    let Φ_mul : L_sub → R_sub :=
      fun u =>
        ⟨u.1 * J₀,
          by
            let I₀ : Ideal (NumberField.RingOfIntegers F) := u.1
            have hI_ne : I₀ ≠ ⊥ := u.2.1
            have hJ_ne : J₀ ≠ ⊥ := hJ₀
            change I₀ * J₀ ≠ ⊥
            rw [← Submodule.zero_eq_bot] at hI_ne hJ_ne ⊢
            exact mul_ne_zero hI_ne hJ_ne,
          by
            rcases u.2.2.1 with ⟨a, ha_m, ha_pos, hIJ_eq⟩
            refine ⟨a, ?_, ha_m, ha_pos, hIJ_eq⟩
            have ha_span : a ∈ Ideal.span {a} := Ideal.subset_span (Set.mem_singleton a)
            rw [← hIJ_eq] at ha_span
            exact Ideal.mul_le_left ha_span,
          by
            rw [map_mul]
            exact Nat.mul_le_mul_right (Ideal.absNorm J₀) u.2.2.2⟩
    have hΦ_mul_inj : Function.Injective Φ_mul := by
      intro x₁ x₂ h
      have h_val : x₁.1 * J₀ = x₂.1 * J₀ := congrArg Subtype.val h
      have hJ0 : J₀ ≠ 0 := by rw [Submodule.zero_eq_bot]; exact hJ₀
      exact Subtype.ext (mul_right_cancel₀ hJ0 h_val)
    have hΦ_mul_surj : Function.Surjective Φ_mul := by
      rintro ⟨P, hP_ne, ⟨a, ha_J, ha_m, ha_pos, hP_eq⟩, hP_le⟩
      have hP_le_J : P ≤ J₀ := by
        rw [hP_eq, Ideal.span_singleton_le_iff_mem]
        exact ha_J
      have hJ_dvd_P : J₀ ∣ P := Ideal.dvd_iff_le.mpr hP_le_J
      rcases hJ_dvd_P with ⟨I₀, hP_JI⟩
      have hIJ_P : I₀ * J₀ = P := by rw [mul_comm, ← hP_JI]
      have hI_ne : I₀ ≠ ⊥ := by
        intro hI_bot
        apply hP_ne
        rw [← hIJ_P, hI_bot, Ideal.bot_mul]
      have hI_le : Ideal.absNorm I₀ ≤ n := by
        apply Nat.le_of_mul_le_mul_right _ hJ₀_pos
        rw [← map_mul, hIJ_P]
        exact hP_le
      refine ⟨⟨I₀, hI_ne, ⟨a, ha_m, ha_pos, by rw [hIJ_P, hP_eq]⟩, hI_le⟩, Subtype.ext hIJ_P⟩
    exact Nat.card_congr (Equiv.ofBijective Φ_mul ⟨hΦ_mul_inj, hΦ_mul_surj⟩)
  let PrinCount : Ideal (NumberField.RingOfIntegers F) → ℕ → ℕ := fun J₀ n =>
    Nat.card { P : Ideal (NumberField.RingOfIntegers F) //
      P ≠ ⊥ ∧
      (∃ a ∈ J₀,
        a - 1 ∈ m ∧
        (∀ w : NumberField.InfinitePlace F,
          w.IsReal → 0 < (w.embedding (a : F)).re) ∧
        P = Ideal.span {a}) ∧
      Ideal.absNorm P ≤ n * Ideal.absNorm J₀ }
  have h_sum_eq : ∀ (γ : E ≃ₐ[F] E) (n : ℕ),
      Nat.card { f : ι →₀ ℕ //
        (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
        σ ^ (f.sum (fun q m => e q * m)) = γ ∧
        Ideal.absNorm (I f) ≤ n } =
      ∑ i : Fin k, PrinCount (J γ i) n := by
    intro γ n
    rw [hθ_card γ n, h_ray_part γ n]
    refine Finset.sum_congr rfl fun i _ => ?_
    exact h_clear (J γ i) (hJ_prop γ i).1 n
  have h_diff_eq :
      (fun n : ℕ =>
        (Nat.card { f : ι →₀ ℕ //
          (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
          σ ^ (f.sum (fun q m => e q * m)) = ρ ∧
          Ideal.absNorm (I f) ≤ n } : ℝ) -
        (Nat.card { f : ι →₀ ℕ //
          (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
          σ ^ (f.sum (fun q m => e q * m)) = τ ∧
          Ideal.absNorm (I f) ≤ n } : ℝ)) =
      (fun n : ℕ =>
        ∑ i : Fin k, ((PrinCount (J ρ i) n : ℝ) - (PrinCount (J τ i) n : ℝ))) := by
    ext n
    rw [h_sum_eq ρ n, h_sum_eq τ n, Nat.cast_sum, Nat.cast_sum, ← Finset.sum_sub_distrib]
  change (fun n : ℕ =>
    (Nat.card { f : ι →₀ ℕ //
      (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
      σ ^ (f.sum (fun q m => e q * m)) = ρ ∧
      Ideal.absNorm (I f) ≤ n } : ℝ) -
    (Nat.card { f : ι →₀ ℕ //
      (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
      σ ^ (f.sum (fun q m => e q * m)) = τ ∧
      Ideal.absNorm (I f) ≤ n } : ℝ)) =O[Filter.atTop]
    (fun n : ℕ => (n : ℝ) ^ (1 - 1 / (Module.finrank ℚ F : ℝ)))
  rw [h_diff_eq]
  exact Asymptotics.IsBigO.sum fun i _ =>
    principal_ray_dvd_natCard_sub_isBigO m (J ρ i) (J τ i) hm_ne_bot
      (hJ_prop ρ i).1 (hJ_prop ρ i).2 (hJ_prop τ i).1 (hJ_prop τ i).2

theorem exists_unramified_frob_coset_natCard_sub_linear_isBigO {F E : Type u} [Field F] [NumberField F] [Field E] [NumberField E]
    [Algebra F E] [IsGalois F E]
    (σ : E ≃ₐ[F] E)
    (hCyclic : ∀ τ : E ≃ₐ[F] E, τ ∈ Subgroup.zpowers σ)
    (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) → ℕ)
    (he : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      IsUnramifiedAtPrime F E q → FrobeniusClassAt F E q ⊆ {σ ^ (e q)}) :
    ∃ κ : ℝ, ∀ ρ : E ≃ₐ[F] E,
      (fun n : ℕ =>
        (Nat.card { f : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ //
          (∀ q ∈ f.support, IsUnramifiedAtPrime F E q) ∧
          σ ^ (f.sum (fun q m => e q * m)) = ρ ∧
          Ideal.absNorm (f.prod (fun q m => q.asIdeal ^ m)) ≤ n } : ℝ) -
        κ * (n : ℝ)) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ (1 - 1 / (Module.finrank ℚ F : ℝ))) :=
by
  classical
  let ι := IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)
  let I : (ι →₀ ℕ) → Ideal (NumberField.RingOfIntegers F) :=
    fun f => f.prod (fun q m => q.asIdeal ^ m)
  have hasIdeal_inj : Function.Injective
      (IsDedekindDomain.HeightOneSpectrum.asIdeal :
        ι → Ideal (NumberField.RingOfIntegers F)) :=
    fun _ _ h => IsDedekindDomain.HeightOneSpectrum.ext h
  have h_toMultiset_prod :
      ∀ f : ι →₀ ℕ,
        (Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f)).prod =
          I f := by
    intro f
    unfold I
    rw [Finsupp.toMultiset_map, Finsupp.prod_toMultiset,
      Finsupp.prod_mapDomain_index_inj hasIdeal_inj]
  have h_prod_ne_bot : ∀ f : ι →₀ ℕ, I f ≠ ⊥ := by
    intro f
    rw [← h_toMultiset_prod f, ← Submodule.zero_eq_bot]
    apply Multiset.prod_ne_zero
    intro h0
    rw [Multiset.mem_map] at h0
    rcases h0 with ⟨q, _, hq0⟩
    rw [Submodule.zero_eq_bot] at hq0
    exact q.ne_bot hq0
  have h_normFactors :
      ∀ f : ι →₀ ℕ,
        UniqueFactorizationMonoid.normalizedFactors (I f) =
          Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal (Finsupp.toMultiset f) := by
    intro f
    rw [← h_toMultiset_prod f]
    apply UniqueFactorizationMonoid.normalizedFactors_prod_of_prime
    intro p hp
    rw [Multiset.mem_map] at hp
    rcases hp with ⟨q, _, rfl⟩
    exact q.prime
  have hI_inj : Function.Injective I := by
    intro f₁ f₂ hval
    have hnf := congrArg UniqueFactorizationMonoid.normalizedFactors hval
    rw [h_normFactors f₁, h_normFactors f₂] at hnf
    have htm : Finsupp.toMultiset f₁ = Finsupp.toMultiset f₂ :=
      Multiset.map_injective hasIdeal_inj hnf
    have htf := congrArg Multiset.toFinsupp htm
    simpa only [Finsupp.toMultiset_toFinsupp] using htf
  let Φ : (ι →₀ ℕ) → { J : Ideal (NumberField.RingOfIntegers F) // J ≠ ⊥ } :=
    fun f => ⟨I f, h_prod_ne_bot f⟩
  have hΦ_inj : Function.Injective Φ := by
    intro f₁ f₂ h
    exact hI_inj (congrArg Subtype.val h)
  have hΦ_surj : Function.Surjective Φ := by
    rintro ⟨J, hJ⟩
    let N := UniqueFactorizationMonoid.normalizedFactors J
    let m : Multiset ι :=
      Multiset.pmap
        (fun (p : Ideal (NumberField.RingOfIntegers F)) (hp : Prime p) =>
          IsDedekindDomain.HeightOneSpectrum.ofPrime hp)
        N
        (fun p hp => UniqueFactorizationMonoid.prime_of_normalized_factor p hp)
    let f : ι →₀ ℕ := Multiset.toFinsupp m
    refine ⟨f, Subtype.ext ?_⟩
    change I f = J
    rw [← h_toMultiset_prod f]
    have hfm : Finsupp.toMultiset f = m := Multiset.toFinsupp_toMultiset m
    rw [hfm]
    have hmap : Multiset.map IsDedekindDomain.HeightOneSpectrum.asIdeal m = N := by
      dsimp [m]
      rw [Multiset.map_pmap]
      simp only [IsDedekindDomain.HeightOneSpectrum.ofPrime_asIdeal,
        Multiset.pmap_eq_map, Multiset.map_id']
    rw [hmap]
    exact prod_normalizedFactors_eq_self hJ
  let e_ufm : (ι →₀ ℕ) ≃ { J : Ideal (NumberField.RingOfIntegers F) // J ≠ ⊥ } :=
    Equiv.ofBijective Φ ⟨hΦ_inj, hΦ_surj⟩
  have hFin_sub : ∀ (P : (ι →₀ ℕ) → Prop) (n : ℕ),
      Finite { f : ι →₀ ℕ // P f ∧ Ideal.absNorm (I f) ≤ n } := by
    intro P n
    haveI : Finite { J : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm J ≤ n } :=
      Set.Finite.to_subtype (Ideal.finite_setOf_absNorm_le n)
    let ι_n : { f : ι →₀ ℕ // P f ∧ Ideal.absNorm (I f) ≤ n } →
        { J : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm J ≤ n } :=
      fun x => ⟨I x.1, x.2.2⟩
    have hι_n_inj : Function.Injective ι_n := by
      intro x₁ x₂ h
      exact Subtype.ext (hI_inj (congrArg Subtype.val h))
    exact Finite.of_injective ι_n hι_n_inj
  
  let S : Set ι := { q | IsUnramifiedAtPrime F E q }
  have hS : Sᶜ.Finite := by
    let D : Ideal (NumberField.RingOfIntegers E) :=
      differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E)
    have hD : D ≠ ⊥ := differentIdeal_ne_bot
    let T_D : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers E)) :=
      { v | v.asIdeal ∣ D }
    have hT_D : T_D.Finite := Ideal.finite_factors hD
    have h_ex : ∀ q : ↑Sᶜ, ∃ v : ↑T_D,
        Ideal.under (NumberField.RingOfIntegers F) v.1.asIdeal = q.1.asIdeal := by
      intro ⟨q, hq⟩
      change ¬ IsUnramifiedAtPrime F E q at hq
      rw [IsUnramifiedAtPrime] at hq
      push_neg at hq
      rcases hq with ⟨P, hP_prime, h_under, h_ram⟩
      haveI : P.IsPrime := hP_prime
      haveI : q.asIdeal.IsMaximal := q.isMaximal
      have h_map : Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers E))
          q.asIdeal ≤ P :=
