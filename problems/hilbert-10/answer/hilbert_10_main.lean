      intro s hs
      rw [tsum_fintype]
      calc ∑ v : D, w v.1 s
        _ ≤ ∑ _v : D, (1 : ENNReal) := Finset.sum_le_sum (fun v _ => hw_le_one v.1 s hs)
        _ = (Fintype.card D : ENNReal) := by simp
