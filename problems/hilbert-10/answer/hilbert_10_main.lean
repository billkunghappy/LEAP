            algebraMap K (v₁.adicCompletion K) ((d₁ * w.1 : Kˣ) : K) *
            algebraMap K (v₁.adicCompletion K) ((d₂ * w.2 : Kˣ) : K) := by
          simp only [← map_pow, ← map_mul]
          congr 1
          dsimp [d₃₄, d₁, d₂, β_u, γ_u]
