      exact hmul.1 v r₁.1 r₁.2 r₂.1 r₂.2 (h1₁ v hv) (h1₂ v hv)
    · intro w
      exact hmul.2.1 w r₁.1 r₁.2 r₂.1 r₂.2 (h2₁ w) (h2₂ w)
    · intro v hv
      exact hmul.2.2 v (π v) r₁.1 r₁.2 r₂.1 r₂.2 (hπ v hv) (h3₁ v hv) (h3₂ v hv)
    · intro v hvT hvS
      exact ⟨heven_mul v r₁.1 r₂.1 (h4₁ v hvT hvS).1 (h4₂ v hvT hvS).1,
             heven_mul v r₁.2 r₂.2 (h4₁ v hvT hvS).2 (h4₂ v hvT hvS).2⟩
  have hV_mul : ∀ c₁ c₂ : SqCl K × SqCl K,
      c₁ ∈ selmerStruct K a₁ a₂ a₃ T S π →
      c₂ ∈ selmerStruct K a₁ a₂ a₃ T S π →
      c₁ * c₂ ∈ selmerStruct K a₁ a₂ a₃ T S π := by
    rintro c₁ c₂ ⟨r₁, hr₁, rfl⟩ ⟨r₂, hr₂, rfl⟩
    exact ⟨(r₁.1 * r₂.1, r₁.2 * r₂.2), hPreV_mul r₁ r₂ hr₁ hr₂, rfl⟩
  obtain ⟨p', hp'_mem, hp'_eq⟩ := hp
  obtain ⟨q', hq'_mem, hq'_eq⟩ := hq
  have hp'₁_eq : sqCl p'.1 = sqCl p.1 := congrArg Prod.fst hp'_eq
  have hp'₂_eq : sqCl p'.2 = sqCl p.2 := congrArg Prod.snd hp'_eq
  have hq'₁_eq : sqCl q'.1 = sqCl q.1 := congrArg Prod.fst hq'_eq
  have hq'₂_eq : sqCl q'.2 = sqCl q.2 := congrArg Prod.snd hq'_eq
  have hp'₁ : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (p'.1 : K)) :=
    fun h => hp₁ ((hsqCl_sq_iff p'.1 p.1 hp'₁_eq).mp h)
  have hp'₁₂_eq : sqCl (p'.1 * p'.2) = sqCl (p.1 * p.2) := by
    rw [hsqCl_mul, hsqCl_mul, hp'₁_eq, hp'₂_eq]
  have hp'₁₂ : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) ((p'.1 * p'.2 : Kˣ) : K)) :=
    fun h => hp₁₂ ((hsqCl_sq_iff (p'.1 * p'.2) (p.1 * p.2) hp'₁₂_eq).mp h)
  have hq'₂ : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (q'.2 : K)) :=
    fun h => hq₂ ((hsqCl_sq_iff q'.2 q.2 hq'₂_eq).mp h)
  have hp'_ev1 : EvenVal v₀ p'.1 := (hp'_mem.2.2.2 v₀ hv₀T hv₀S).1
  have hp'_ev2 : EvenVal v₀ p'.2 := (hp'_mem.2.2.2 v₀ hv₀T hv₀S).2
  have hq'_ev1 : EvenVal v₀ q'.1 := (hq'_mem.2.2.2 v₀ hv₀T hv₀S).1
  have hq'_ev2 : EvenVal v₀ q'.2 := (hq'_mem.2.2.2 v₀ hv₀T hv₀S).2
  have hp'₂ : IsSquare (algebraMap K (v₀.adicCompletion K) (p'.2 : K)) := by
    by_contra hp'₂_nonsq
    exact hp'₁₂ ((hnonsq_mul_iff p'.1 p'.2 hp'_ev1 hp'_ev2 hp'₁).mpr hp'₂_nonsq)
  have hu₂_ex : ∃ u₂ : Kˣ × Kˣ, u₂ ∈ PreV ∧
      EvenVal v₀ u₂.1 ∧ EvenVal v₀ u₂.2 ∧
      IsSquare (algebraMap K (v₀.adicCompletion K) (u₂.1 : K)) ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u₂.2 : K)) := by
    by_cases hq'₁ : IsSquare (algebraMap K (v₀.adicCompletion K) (q'.1 : K))
    · exact ⟨q', hq'_mem, hq'_ev1, hq'_ev2, hq'₁, hq'₂⟩
    · refine ⟨(p'.1 * q'.1, p'.2 * q'.2), hPreV_mul p' q' hp'_mem hq'_mem,
        heven_mul v₀ p'.1 q'.1 hp'_ev1 hq'_ev1,
        heven_mul v₀ p'.2 q'.2 hp'_ev2 hq'_ev2,
        hmul_nonsq p'.1 q'.1 hp'_ev1 hq'_ev1 hp'₁ hq'₁, ?_⟩
      intro hsq
      exact hq'₂ ((hsq_mul_iff p'.2 q'.2 hp'₂).mp hsq)
  obtain ⟨u₂, hu₂_mem, hu₂_ev1, hu₂_ev2, hu₂_sq1, hu₂_nonsq2⟩ := hu₂_ex
  set u₁ : Kˣ × Kˣ := p'
  have hu₁_mem : u₁ ∈ PreV := hp'_mem
  have hu₁_ev1 : EvenVal v₀ u₁.1 := hp'_ev1
  have hu₁_ev2 : EvenVal v₀ u₁.2 := hp'_ev2
  have hu₁_nonsq1 : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u₁.1 : K)) := hp'₁
  have hu₁_sq2 : IsSquare (algebraMap K (v₀.adicCompletion K) (u₁.2 : K)) := hp'₂
  set S' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    insert v₀ S
  set π' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v.adicCompletion K := Function.update π v₀ π₀
  have hS'T : Disjoint S' T := Finset.disjoint_insert_left.mpr ⟨hv₀T, hST⟩
  have hS'B : Disjoint S' B := Finset.disjoint_insert_left.mpr ⟨hv₀B, hSB⟩
  have hπ' : ∀ v ∈ S', IsLocalUnif v (π' v) := by
    intro v hv
    rcases Finset.mem_insert.mp hv with rfl | hvS
    · dsimp [π']; rw [Function.update_self]; exact hπ₀
    · have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
      dsimp [π']; rw [Function.update_of_ne hv_ne]; exact hπ v hvS
  refine ⟨S', π', hS'T, hS'B, hπ', ?_⟩
  let PreW : Set (Kˣ × Kˣ) :=
    { r : Kˣ × Kˣ |
      (∀ v ∈ T, IsDescentClass
            (algebraMap K (v.adicCompletion K) a₁)
            (algebraMap K (v.adicCompletion K) a₂)
            (algebraMap K (v.adicCompletion K) a₃)
            (algebraMap K (v.adicCompletion K) (r.1 : K))
            (algebraMap K (v.adicCompletion K) (r.2 : K))) ∧
      (∀ w : NumberField.InfinitePlace K, IsDescentClass
            (algebraMap K w.Completion a₁)
            (algebraMap K w.Completion a₂)
            (algebraMap K w.Completion a₃)
            (algebraMap K w.Completion (r.1 : K))
            (algebraMap K w.Completion (r.2 : K))) ∧
      (∀ v ∈ S', RamLocal a₁ a₂ a₃ v (π' v) r.1 r.2) ∧
      (∀ v, v ∉ T → v ∉ S' → EvenVal v r.1 ∧ EvenVal v r.2) }
  have hPreV_relax : ∀ r : Kˣ × Kˣ, r ∈ PreV →
      (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₀ := by
    rintro r ⟨h1, h2, h3, h4⟩
    exact ⟨r, ⟨h1, h2, h3, fun v hvT hvS _ => h4 v hvT hvS⟩, rfl⟩
  have hPreW_relax : ∀ r : Kˣ × Kˣ, r ∈ PreW →
      (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₀ := by
    rintro r ⟨h1, h2, h3, h4⟩
    refine ⟨r, ⟨h1, h2, ?_, ?_⟩, rfl⟩
    · intro v hvS
      have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
      have h3v := h3 v (Finset.mem_insert_of_mem hvS)
      dsimp [π'] at h3v
      rw [Function.update_of_ne hv_ne] at h3v
      exact h3v
    · intro v hvT hvS hv_ne
      exact h4 v hvT (fun hv => (Finset.mem_insert.mp hv).elim hv_ne hvS)
  have hhilb_sq_left : ∀ (u : Kˣ) (b : v₀.adicCompletion K),
      IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
      hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) (u : K)) b = 1 := by
    intro u b ⟨s, hs⟩
    have hs_ne : s ≠ 0 := by
      intro h0; rw [h0, mul_zero] at hs
      exact (algebraMap K (v₀.adicCompletion K)).injective.ne u.ne_zero hs
    unfold hilbLoc
    rw [if_pos]
    refine ⟨s⁻¹, 0, ?_⟩
    rw [hs]
    calc (s * s) * (s⁻¹) ^ 2 + b * 0 ^ 2
      _ = (s * s⁻¹) * (s * s⁻¹) := by ring
      _ = 1 := by rw [mul_inv_cancel₀ hs_ne, mul_one]
  have hPreW_even : ∀ r : Kˣ × Kˣ, r ∈ PreW → EvenVal v₀ r.1 ∧ EvenVal v₀ r.2 := by
    intro r hr
    have hr_rel := hPreW_relax r hr
    have hu₁1_ne : algebraMap K (v₀.adicCompletion K) (u₁.1 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₁.1.ne_zero
    have hu₁2_ne : algebraMap K (v₀.adicCompletion K) (u₁.2 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₁.2.ne_zero
    have hu₂1_ne : algebraMap K (v₀.adicCompletion K) (u₂.1 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₂.1.ne_zero
    have hu₂2_ne : algebraMap K (v₀.adicCompletion K) (u₂.2 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₂.2.ne_zero
    have horth₁ := (theorem_4_5 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ hint₁ hint₂ hint₃ T S hT hST π hπ
      v₀ hv₀T hv₀S
      (algebraMap K (v₀.adicCompletion K) (u₁.1 : K))
      (algebraMap K (v₀.adicCompletion K) (u₁.2 : K))
      hu₁1_ne hu₁2_ne).mpr
      ⟨u₁, hPreV_relax u₁ hu₁_mem,
       ⟨algebraMap K (v₀.adicCompletion K) (u₁.1 : K), rfl⟩,
       ⟨algebraMap K (v₀.adicCompletion K) (u₁.2 : K), rfl⟩⟩
      r hr_rel
    rw [hhilb_sq_left u₁.2 _ hu₁_sq2, mul_one] at horth₁
    have hr2_ev : EvenVal v₀ r.2 := hhilb_even u₁.1 r.2 hu₁_ev1 hu₁_nonsq1 horth₁
    have horth₂ := (theorem_4_5 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ hint₁ hint₂ hint₃ T S hT hST π hπ
      v₀ hv₀T hv₀S
      (algebraMap K (v₀.adicCompletion K) (u₂.1 : K))
      (algebraMap K (v₀.adicCompletion K) (u₂.2 : K))
      hu₂1_ne hu₂2_ne).mpr
      ⟨u₂, hPreV_relax u₂ hu₂_mem,
       ⟨algebraMap K (v₀.adicCompletion K) (u₂.1 : K), rfl⟩,
       ⟨algebraMap K (v₀.adicCompletion K) (u₂.2 : K), rfl⟩⟩
      r hr_rel
    rw [hhilb_sq_left u₂.1 _ hu₂_sq1, one_mul] at horth₂
    have hr1_ev : EvenVal v₀ r.1 := hhilb_even u₂.2 r.1 hu₂_ev2 hu₂_nonsq2 horth₂
    exact ⟨hr1_ev, hr2_ev⟩
  let P : SqCl K → Prop := fun c =>
    ∃ x : Kˣ, sqCl x = c ∧ IsSquare (algebraMap K (v₀.adicCompletion K) (x : K))
  have hP_iff : ∀ x : Kˣ, P (sqCl x) ↔ IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) := by
    intro x
    constructor
    · rintro ⟨y, hy_eq, hy_sq⟩
      exact (hsqCl_sq_iff y x hy_eq).mp hy_sq
    · intro hx_sq
      exact ⟨x, rfl, hx_sq⟩
  have hW_iff : ∀ c : SqCl K × SqCl K,
      c ∈ selmerStruct K a₁ a₂ a₃ T S' π' ↔
      c ∈ selmerStruct K a₁ a₂ a₃ T S π ∧ P c.1 ∧ P c.2 := by
    intro c
    constructor
    · rintro ⟨r, hr, rfl⟩
      obtain ⟨hr1_ev, hr2_ev⟩ := hPreW_even r hr
      have hr_V : r ∈ PreV := by
        refine ⟨hr.1, hr.2.1, ?_, ?_⟩
        · intro v hvS
          have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
          have h3v := hr.2.2.1 v (Finset.mem_insert_of_mem hvS)
          dsimp [π'] at h3v
          rw [Function.update_of_ne hv_ne] at h3v
          exact h3v
        · intro v hvT hvS
          by_cases hv0 : v = v₀
          · subst hv0; exact ⟨hr1_ev, hr2_ev⟩
          · exact hr.2.2.2 v hvT (fun hv => (Finset.mem_insert.mp hv).elim hv0 hvS)
      have hram0 : RamLocal a₁ a₂ a₃ v₀ π₀ r.1 r.2 := by
        have h30 := hr.2.2.1 v₀ (Finset.mem_insert_self v₀ S)
        dsimp [π'] at h30
        rw [Function.update_self] at h30
        exact h30
      obtain ⟨hsq1, hsq2⟩ := (hram_even r.1 r.2 hπ₀ hr1_ev hr2_ev).mp hram0
      exact ⟨⟨r, hr_V, rfl⟩, (hP_iff r.1).mpr hsq1, (hP_iff r.2).mpr hsq2⟩
    · rintro ⟨⟨r, hr_V, rfl⟩, hP1, hP2⟩
      have hsq1 : IsSquare (algebraMap K (v₀.adicCompletion K) (r.1 : K)) := (hP_iff r.1).mp hP1
      have hsq2 : IsSquare (algebraMap K (v₀.adicCompletion K) (r.2 : K)) := (hP_iff r.2).mp hP2
      refine ⟨r, ⟨hr_V.1, hr_V.2.1, ?_, ?_⟩, rfl⟩
      · intro v hvS'
        rcases Finset.mem_insert.mp hvS' with rfl | hvS
        · dsimp [π']; rw [Function.update_self]
          exact Or.inl ⟨hsq1, hsq2⟩
        · have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
          dsimp [π']; rw [Function.update_of_ne hv_ne]
          exact hr_V.2.2.1 v hvS
      · intro v hvT hvS'
        exact hr_V.2.2.2 v hvT (fun hvS => hvS' (Finset.mem_insert_of_mem hvS))
  have hV_even : ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π,
      (∃ x : Kˣ, sqCl x = c.1 ∧ EvenVal v₀ x) ∧
      (∃ y : Kˣ, sqCl y = c.2 ∧ EvenVal v₀ y) := by
    rintro c ⟨r, hr, rfl⟩
    exact ⟨⟨r.1, rfl, (hr.2.2.2 v₀ hv₀T hv₀S).1⟩,
           ⟨r.2, rfl, (hr.2.2.2 v₀ hv₀T hv₀S).2⟩⟩
  have hP_mul_sq : ∀ (u : Kˣ) (c : SqCl K),
      IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
      (P (sqCl u * c) ↔ P c) := by
    intro u c hu_sq
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective c
    change P (sqCl u * sqCl x) ↔ P (sqCl x)
    rw [← hsqCl_mul, hP_iff, hP_iff]
    exact hsq_mul_iff u x hu_sq
  have hP_mul_nonsq : ∀ (u : Kˣ) (c : SqCl K),
      EvenVal v₀ u →
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
      (∃ x : Kˣ, sqCl x = c ∧ EvenVal v₀ x) →
      (P (sqCl u * c) ↔ ¬ P c) := by
    rintro u c hu_ev hu_nonsq ⟨x, rfl, hx_ev⟩
    rw [← hsqCl_mul, hP_iff, hP_iff]
    exact hnonsq_mul_iff u x hu_ev hx_ev hu_nonsq
  refine h_coset_card (selmerStruct K a₁ a₂ a₃ T S π) (selmerStruct K a₁ a₂ a₃ T S' π') P
    (sqCl u₁.1, sqCl u₁.2) (sqCl u₂.1, sqCl u₂.2) hm hV_mul ⟨u₁, hu₁_mem, rfl⟩ ⟨u₂, hu₂_mem, rfl⟩
    hW_iff ?_ ?_
  · intro c hcV
    obtain ⟨hc1_ev, _⟩ := hV_even c hcV
    exact ⟨hP_mul_nonsq u₁.1 c.1 hu₁_ev1 hu₁_nonsq1 hc1_ev,
           hP_mul_sq u₁.2 c.2 hu₁_sq2⟩
  · intro c hcV
    obtain ⟨_, hc2_ev⟩ := hV_even c hcV
    exact ⟨hP_mul_sq u₂.1 c.1 hu₂_sq1,
           hP_mul_nonsq u₂.2 c.2 hu₂_ev2 hu₂_nonsq2 hc2_ev⟩

theorem exists_galois_aut_three_neg_of_not_isSquare (K : Type u) [Field K] [NumberField K]
    (a b c : Kˣ)
    (ha : ¬ IsSquare (a : K))
    (hb : ¬ IsSquare (b : K))
    (hc : ¬ IsSquare (c : K))
    (habc : ¬ IsSquare ((a * b * c : Kˣ) : K)) :
    ∃ (L : Type u) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : IsGalois K L)
      (α_a α_b α_c : L) (σ₀ : L ≃ₐ[K] L),
      α_a ^ 2 = algebraMap K L (a : K) ∧
      α_b ^ 2 = algebraMap K L (b : K) ∧
      α_c ^ 2 = algebraMap K L (c : K) ∧
      σ₀ α_a = -α_a ∧
      σ₀ α_b = -α_b ∧
      σ₀ α_c = -α_c :=
by
  have h_s1 :
      ∃ (L : Type u) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : IsGalois K L)
        (y_a y_b y_c : L),
        y_a ^ 2 = algebraMap K L (a : K) ∧
        y_b ^ 2 = algebraMap K L (b : K) ∧
        y_c ^ 2 = algebraMap K L (c : K) ∧
        ∀ (E : Type u) [Field E] [Algebra K E]
          (r_a r_b r_c : E) (σ_E : E ≃ₐ[K] E) (_ι : E →ₐ[K] L),
          r_a ^ 2 = algebraMap K E (a : K) →
          r_b ^ 2 = algebraMap K E (b : K) →
          r_c ^ 2 = algebraMap K E (c : K) →
          σ_E r_a = -r_a →
          σ_E r_b = -r_b →
          σ_E r_c = -r_c →
          ∃ (α_a α_b α_c : L) (σ₀ : L ≃ₐ[K] L),
            α_a ^ 2 = algebraMap K L (a : K) ∧
            α_b ^ 2 = algebraMap K L (b : K) ∧
            α_c ^ 2 = algebraMap K L (c : K) ∧
            σ₀ α_a = -α_a ∧
            σ₀ α_b = -α_b ∧
            σ₀ α_c = -α_c := by
    let pa : K[X] := X ^ 2 - C (a : K)
    let pb : K[X] := X ^ 2 - C (b : K)
    let pc : K[X] := X ^ 2 - C (c : K)
    let f : K[X] := pa * pb * pc
    let L := f.SplittingField
    have hGal : IsGalois K L := IsGalois.mk
    have hNF : NumberField L := @NumberField.mk L _ inferInstance (Module.Finite.trans K L)
    have h_root : ∀ (w : K), (X ^ 2 - C w) ∣ f → ∃ y : L, y ^ 2 = algebraMap K L w := by
      intro w h_dvd
      have hpa : pa ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (a : K)
      have hpb : pb ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (b : K)
      have hpc : pc ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (c : K)
      have hf0 : f ≠ 0 := mul_ne_zero (mul_ne_zero hpa hpb) hpc
      have h_splits_f : (Polynomial.map (algebraMap K L) f).Splits :=
        Polynomial.SplittingField.splits f
      have h_map_f0 : Polynomial.map (algebraMap K L) f ≠ 0 :=
        Polynomial.map_ne_zero hf0
      have h_dvd_map : Polynomial.map (algebraMap K L) (X ^ 2 - C w) ∣
          Polynomial.map (algebraMap K L) f :=
        Polynomial.map_dvd (algebraMap K L) h_dvd
      have h_splits_w : (Polynomial.map (algebraMap K L) (X ^ 2 - C w)).Splits :=
        h_splits_f.of_dvd h_map_f0 h_dvd_map
      have h_map_eq : Polynomial.map (algebraMap K L) (X ^ 2 - C w) =
          X ^ 2 - C (algebraMap K L w) := by
        simp
      rw [h_map_eq] at h_splits_w
      have h_deg : (X ^ 2 - C (algebraMap K L w)).degree ≠ 0 := by
        rw [Polynomial.degree_X_pow_sub_C (by decide : 0 < 2)]
        decide
      obtain ⟨y, hy⟩ := h_splits_w.exists_eval_eq_zero h_deg
      simp only [eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero] at hy
      exact ⟨y, hy⟩
    obtain ⟨y_a, hy_a⟩ := h_root (a : K) (dvd_mul_of_dvd_left (dvd_mul_right pa pb) pc)
    obtain ⟨y_b, hy_b⟩ := h_root (b : K) (dvd_mul_of_dvd_left (dvd_mul_left pb pa) pc)
    obtain ⟨y_c, hy_c⟩ := h_root (c : K) (dvd_mul_left pc (pa * pb))
    refine ⟨L, inferInstance, hNF, inferInstance, hGal, y_a, y_b, y_c, hy_a, hy_b, hy_c, ?_⟩
    intro E hFieldE hAlgKE r_a r_b r_c σ_E ι hra hrb hrc hσa hσb hσc
    letI : Algebra E L := ι.toRingHom.toAlgebra
    have h_tower_eq : ∀ x : K, (algebraMap E L) (algebraMap K E x) = algebraMap K L x :=
      fun x => ι.commutes x
    haveI : IsScalarTower K E L := IsScalarTower.of_algebraMap_eq (fun x => (h_tower_eq x).symm)
    let σ₀ : L ≃ₐ[K] L := AlgEquiv.liftNormal σ_E L
    refine ⟨algebraMap E L r_a, algebraMap E L r_b, algebraMap E L r_c, σ₀, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [← map_pow, hra, h_tower_eq]
    · rw [← map_pow, hrb, h_tower_eq]
    · rw [← map_pow, hrc, h_tower_eq]
    · rw [AlgEquiv.liftNormal_commutes, hσa, map_neg]
    · rw [AlgEquiv.liftNormal_commutes, hσb, map_neg]
    · rw [AlgEquiv.liftNormal_commutes, hσc, map_neg]
  have h_s2 :
      ∀ (L F : Type u) [Field L] [Algebra K L] [Field F] [CharZero F] [Algebra K F]
        (σ : F ≃ₐ[K] F) (_ι : F →ₐ[K] L)
        (d₀ : K), ¬ IsSquare (algebraMap K F d₀) →
        ∀ (y : L), y ^ 2 = algebraMap K L d₀ →
        ∃ (F' : Type u) (_ : Field F') (_ : CharZero F')
          (_ : Algebra K F') (_ : Algebra F F') (_ : IsScalarTower K F F')
          (ω : F') (σ' : F' ≃ₐ[K] F') (_ι' : F' →ₐ[K] L),
          ω ^ 2 = algebraMap K F' d₀ ∧
          σ' ω = -ω ∧
          (∀ u : F, σ' (algebraMap F F' u) = algebraMap F F' (σ u)) ∧
          (∀ x : F, ∀ z : F', z ^ 2 = algebraMap F F' x →
            (∃ u : F, u ^ 2 = x ∧ z = algebraMap F F' u) ∨
            (∃ v : F, algebraMap K F d₀ * v ^ 2 = x ∧ z = algebraMap F F' v * ω)) := by
    intro L F hFieldL hAlgKL hFieldF hCharF hAlgKF σ ι d₀ hd y hy
    let d : F := algebraMap K F d₀
    haveI : Fact (∀ r : F, r ^ 2 ≠ d + 0 * r) :=
      ⟨fun r hr => hd ⟨r, by linear_combination -hr⟩⟩
    haveI : CharZero (QuadraticAlgebra F d 0) :=
      charZero_of_injective_algebraMap (algebraMap F (QuadraticAlgebra F d 0)).injective
    let ω : QuadraticAlgebra F d 0 := ⟨0, 1⟩
    have hσd : σ d = d := σ.commutes d₀
    let σ' : QuadraticAlgebra F d 0 ≃ₐ[K] QuadraticAlgebra F d 0 :=
      { toFun := fun z => ⟨σ z.re, -σ z.im⟩
        invFun := fun z => ⟨σ.symm z.re, -σ.symm z.im⟩
        left_inv := fun z => by
          ext <;> simp
        right_inv := fun z => by
          ext <;> simp
        map_mul' := fun z₁ z₂ => by
          ext
          · change σ (z₁.re * z₂.re + d * z₁.im * z₂.im) =
              σ z₁.re * σ z₂.re + d * (-σ z₁.im) * (-σ z₂.im)
            simp only [map_add, map_mul, hσd]
            ring
          · change -σ (z₁.re * z₂.im + z₁.im * z₂.re + 0 * z₁.im * z₂.im) =
              σ z₁.re * (-σ z₂.im) + (-σ z₁.im) * σ z₂.re + 0 * (-σ z₁.im) * (-σ z₂.im)
            simp only [map_add, map_mul, map_zero]
            ring
        map_add' := fun z₁ z₂ => by
          ext
          · change σ (z₁.re + z₂.re) = σ z₁.re + σ z₂.re
            exact map_add σ z₁.re z₂.re
          · change -σ (z₁.im + z₂.im) = -σ z₁.im + -σ z₂.im
            rw [map_add, neg_add]
        commutes' := fun k => by
          ext
          · change σ (algebraMap K F k) = algebraMap K F k
            exact σ.commutes k
          · change -σ (0 : F) = 0
            simp }
    letI : Algebra F L := ι.toRingHom.toAlgebra
    haveI : IsScalarTower K F L :=
      IsScalarTower.of_algebraMap_eq (fun x => (ι.commutes x).symm)
    have hy_quad : y * y = d • (1 : L) + (0 : F) • y := by
      have h1 : y * y = algebraMap K L d₀ := by rw [← sq, hy]
      have h2 : d • (1 : L) = algebraMap K L d₀ := by
        rw [Algebra.smul_def, mul_one]
        exact ι.commutes d₀
      rw [h1, h2, zero_smul, add_zero]
    let ι_F : QuadraticAlgebra F d 0 →ₐ[F] L := QuadraticAlgebra.lift ⟨y, hy_quad⟩
    let ι' : QuadraticAlgebra F d 0 →ₐ[K] L := ι_F.restrictScalars K
    refine ⟨QuadraticAlgebra F d 0, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, ω, σ', ι', ?_, ?_, ?_, ?_⟩
    · rw [sq]
      ext
      · change (0 : F) * 0 + d * 1 * 1 = d
        ring
      · change (0 : F) * 1 + 1 * 0 + 0 * 1 * 1 = 0
        ring
    · ext
      · change σ 0 = -(0 : F)
        simp
      · change -σ 1 = -(1 : F)
        simp
    · intro u
      ext
      · change σ u = σ u
        rfl
      · change -σ 0 = 0
        simp
    · intro x z hz
      have h_re : z.re * z.re + d * z.im * z.im = x := by
        have := congrArg QuadraticAlgebra.re hz
        simpa [sq, QuadraticAlgebra.re_mul] using this
      have h_im : z.re * z.im + z.im * z.re + 0 * z.im * z.im = 0 := by
        have := congrArg QuadraticAlgebra.im hz
        simpa [sq, QuadraticAlgebra.im_mul] using this
      have h_prod : (2 : F) * z.re * z.im = 0 := by
        linear_combination h_im
      have h2 : (2 : F) ≠ 0 := two_ne_zero
      rcases mul_eq_zero.mp h_prod with h_2re | h_im0
      · have h_re0 : z.re = 0 := (mul_eq_zero.mp h_2re).resolve_left h2
        right
        refine ⟨z.im, ?_, ?_⟩
        · change d * z.im ^ 2 = x
          linear_combination h_re - z.re * h_re0
        · ext
          · change z.re = z.im * 0 + d * 0 * 1
            rw [h_re0]; ring
          · change z.im = z.im * 1 + 0 * 0 + 0 * 0 * 1
            ring
      · left
        refine ⟨z.re, ?_, ?_⟩
        · linear_combination h_re - d * z.im * h_im0
        · ext
          · rfl
          · exact h_im0
  have h_s3 :
      ∀ (K₁ : Type u) [Field K₁] [Algebra K K₁]
        (ω₁ : K₁) (σ₁ : K₁ ≃ₐ[K] K₁),
        σ₁ ω₁ = -ω₁ →
        (∀ x : K, ∀ z : K₁, z ^ 2 = algebraMap K K₁ x →
          (∃ u : K, u ^ 2 = x ∧ z = algebraMap K K₁ u) ∨
          (∃ v : K, (a : K) * v ^ 2 = x ∧ z = algebraMap K K₁ v * ω₁)) →
        (∀ w : K, ¬ IsSquare w → IsSquare (algebraMap K K₁ w) →
          ∃ z : K₁, z ^ 2 = algebraMap K K₁ w ∧ σ₁ z = -z) ∧
        (∀ (K₂ : Type u) [Field K₂] [Algebra K K₂] [Algebra K₁ K₂] [IsScalarTower K K₁ K₂]
          (ω₂ : K₂) (σ₂ : K₂ ≃ₐ[K] K₂),
          σ₂ ω₂ = -ω₂ →
          (∀ u : K₁, σ₂ (algebraMap K₁ K₂ u) = algebraMap K₁ K₂ (σ₁ u)) →
          (∀ x : K₁, ∀ z : K₂, z ^ 2 = algebraMap K₁ K₂ x →
            (∃ u : K₁, u ^ 2 = x ∧ z = algebraMap K₁ K₂ u) ∨
            (∃ v : K₁, algebraMap K K₁ (b : K) * v ^ 2 = x ∧ z = algebraMap K₁ K₂ v * ω₂)) →
          IsSquare (algebraMap K K₂ (c : K)) →
          ∃ z_c : K₂, z_c ^ 2 = algebraMap K K₂ (c : K) ∧ σ₂ z_c = -z_c) := by
    intro K₁ hFieldK₁ hAlgKK₁ ω₁ σ₁ hσ₁_ω₁ hdich₁
    have h_neg₁ : ∀ w : K, ¬ IsSquare w → ∀ z : K₁, z ^ 2 = algebraMap K K₁ w → σ₁ z = -z := by
      intro w hw z hz
      rcases hdich₁ w z hz with ⟨u, hu_sq, hz_eq⟩ | ⟨v, _, hz_eq⟩
      · exfalso
        apply hw
        exact ⟨u, by linear_combination -hu_sq⟩
      · rw [hz_eq, map_mul, σ₁.commutes, hσ₁_ω₁, mul_neg]
    refine ⟨?_, ?_⟩
    · intro w hw ⟨z, hz⟩
      have hz_sq : z ^ 2 = algebraMap K K₁ w := by linear_combination -hz
      exact ⟨z, hz_sq, h_neg₁ w hw z hz_sq⟩
    · intro K₂ hFieldK₂ hAlgKK₂ hAlgK₁K₂ hTowerK₁K₂ ω₂ σ₂ hσ₂_ω₂ hσ₂_alg hdich₂ ⟨z_c, hz_c⟩
      have hz_c_sq : z_c ^ 2 = algebraMap K K₂ (c : K) := by linear_combination -hz_c
      have hz_c_sq' : z_c ^ 2 = algebraMap K₁ K₂ (algebraMap K K₁ (c : K)) := by
        rw [hz_c_sq, IsScalarTower.algebraMap_apply K K₁ K₂]
      refine ⟨z_c, hz_c_sq, ?_⟩
      rcases hdich₂ (algebraMap K K₁ (c : K)) z_c hz_c_sq' with
        ⟨u₁, hu₁_sq, hzc_eq⟩ | ⟨v₁, hv₁_sq, hzc_eq⟩
      · have hσ₁_u₁ : σ₁ u₁ = -u₁ := h_neg₁ (c : K) hc u₁ hu₁_sq
        rw [hzc_eq, hσ₂_alg, hσ₁_u₁, map_neg]
      · let w₁ : K₁ := algebraMap K K₁ (b : K) * v₁
        have hw₁_sq : w₁ ^ 2 = algebraMap K K₁ ((b : K) * (c : K)) := by
          rw [map_mul]
          linear_combination (algebraMap K K₁ (b : K)) * hv₁_sq
        rcases hdich₁ ((b : K) * (c : K)) w₁ hw₁_sq with
          ⟨u₀, _, hw₁_eq⟩ | ⟨v₀, hv₀_sq, _⟩
        · have hσ₁_w₁ : σ₁ w₁ = w₁ := by
            rw [hw₁_eq, σ₁.commutes]
          have hσ₁_w₁' : σ₁ w₁ = algebraMap K K₁ (b : K) * σ₁ v₁ := by
            change σ₁ (algebraMap K K₁ (b : K) * v₁) = _
            rw [map_mul, σ₁.commutes]
          have hb₁_ne : algebraMap K K₁ (b : K) ≠ 0 := by
            simp [Units.ne_zero]
          have hσ₁_v₁ : σ₁ v₁ = v₁ :=
            mul_left_cancel₀ hb₁_ne (hσ₁_w₁'.symm.trans hσ₁_w₁)
          rw [hzc_eq, map_mul, hσ₂_alg, hσ₁_v₁, hσ₂_ω₂, mul_neg]
        · exfalso
          apply habc
          refine ⟨(a : K) * v₀, ?_⟩
          push_cast
          linear_combination -(a : K) * hv₀_sq
  obtain ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, y_a, y_b, y_c, hy_a, hy_b, hy_c, h_lift⟩ := h_s1
  letI : Field L := hFieldL
  letI : NumberField L := hNFL
  letI : Algebra K L := hAlgKL
  letI : IsGalois K L := hGalKL
  have ha_id : ¬ IsSquare (algebraMap K K (a : K)) := by simpa using ha
  obtain ⟨K₁, hFieldK₁, hCharK₁, hAlgKK₁, hAlgKK₁', hTowerKKK₁, ω₁, σ₁, ι₁,
      hω₁_sq, hσ₁_ω₁, _, hdich₁_raw⟩ :=
    h_s2 L K AlgEquiv.refl (Algebra.ofId K L) (a : K) ha_id y_a hy_a
  letI : Field K₁ := hFieldK₁
  letI : CharZero K₁ := hCharK₁
  letI : Algebra K K₁ := hAlgKK₁
  have h_alg_eq : ∀ x : K, @algebraMap K K₁ _ _ hAlgKK₁' x = algebraMap K K₁ x := by
    intro x
    have := @IsScalarTower.algebraMap_apply K K K₁ _ _ _ _ hAlgKK₁' hAlgKK₁ hTowerKKK₁ x
    simpa using this.symm
  have hdich₁ : ∀ x : K, ∀ z : K₁, z ^ 2 = algebraMap K K₁ x →
      (∃ u : K, u ^ 2 = x ∧ z = algebraMap K K₁ u) ∨
      (∃ v : K, (a : K) * v ^ 2 = x ∧ z = algebraMap K K₁ v * ω₁) := by
    intro x z hz
    rw [← h_alg_eq x] at hz
    rcases hdich₁_raw x z hz with ⟨u, hu_sq, hz_eq⟩ | ⟨v, hv_sq, hz_eq⟩
    · left
      rw [h_alg_eq u] at hz_eq
      exact ⟨u, hu_sq, hz_eq⟩
    · right
      rw [h_alg_eq v] at hz_eq
      have hv_sq' : (a : K) * v ^ 2 = x := by simpa using hv_sq
      exact ⟨v, hv_sq', hz_eq⟩
  obtain ⟨h_neg₁, h_neg₂⟩ := h_s3 K₁ ω₁ σ₁ hσ₁_ω₁ hdich₁
  refine ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, ?_⟩
  by_cases hb₁ : IsSquare (algebraMap K K₁ (b : K))
  · obtain ⟨z_b, hz_b_sq, hσ₁_zb⟩ := h_neg₁ (b : K) hb hb₁
    by_cases hc₁ : IsSquare (algebraMap K K₁ (c : K))
    · obtain ⟨z_c, hz_c_sq, hσ₁_zc⟩ := h_neg₁ (c : K) hc hc₁
      exact h_lift K₁ ω₁ z_b z_c σ₁ ι₁ hω₁_sq hz_b_sq hz_c_sq hσ₁_ω₁ hσ₁_zb hσ₁_zc
    · obtain ⟨K₂, hFieldK₂, _, hAlgKK₂, hAlgK₁K₂, hTowerK₁K₂, ω₂, σ₂, ι₂,
          hω₂_sq, hσ₂_ω₂, hσ₂_alg, _⟩ :=
        h_s2 L K₁ σ₁ ι₁ (c : K) hc₁ y_c hy_c
      letI : Field K₂ := hFieldK₂
      letI : Algebra K K₂ := hAlgKK₂
      letI : Algebra K₁ K₂ := hAlgK₁K₂
      letI : IsScalarTower K K₁ K₂ := hTowerK₁K₂
      have hra : (algebraMap K₁ K₂ ω₁) ^ 2 = algebraMap K K₂ (a : K) := by
        rw [← map_pow, hω₁_sq, ← IsScalarTower.algebraMap_apply K K₁ K₂]
      have hrb : (algebraMap K₁ K₂ z_b) ^ 2 = algebraMap K K₂ (b : K) := by
        rw [← map_pow, hz_b_sq, ← IsScalarTower.algebraMap_apply K K₁ K₂]
      have hσa : σ₂ (algebraMap K₁ K₂ ω₁) = -algebraMap K₁ K₂ ω₁ := by
        rw [hσ₂_alg, hσ₁_ω₁, map_neg]
      have hσb : σ₂ (algebraMap K₁ K₂ z_b) = -algebraMap K₁ K₂ z_b := by
        rw [hσ₂_alg, hσ₁_zb, map_neg]
      exact h_lift K₂ (algebraMap K₁ K₂ ω₁) (algebraMap K₁ K₂ z_b) ω₂ σ₂ ι₂
        hra hrb hω₂_sq hσa hσb hσ₂_ω₂
  · obtain ⟨K₂, hFieldK₂, hCharK₂, hAlgKK₂, hAlgK₁K₂, hTowerK₁K₂, ω₂, σ₂, ι₂,
        hω₂_sq, hσ₂_ω₂, hσ₂_alg, hdich₂⟩ :=
      h_s2 L K₁ σ₁ ι₁ (b : K) hb₁ y_b hy_b
    letI : Field K₂ := hFieldK₂
    letI : CharZero K₂ := hCharK₂
    letI : Algebra K K₂ := hAlgKK₂
    letI : Algebra K₁ K₂ := hAlgK₁K₂
    letI : IsScalarTower K K₁ K₂ := hTowerK₁K₂
    have hra₂ : (algebraMap K₁ K₂ ω₁) ^ 2 = algebraMap K K₂ (a : K) := by
      rw [← map_pow, hω₁_sq, ← IsScalarTower.algebraMap_apply K K₁ K₂]
    have hσa₂ : σ₂ (algebraMap K₁ K₂ ω₁) = -algebraMap K₁ K₂ ω₁ := by
      rw [hσ₂_alg, hσ₁_ω₁, map_neg]
    by_cases hc₂ : IsSquare (algebraMap K K₂ (c : K))
    · obtain ⟨z_c, hz_c_sq, hσ₂_zc⟩ :=
        h_neg₂ K₂ ω₂ σ₂ hσ₂_ω₂ hσ₂_alg hdich₂ hc₂
      exact h_lift K₂ (algebraMap K₁ K₂ ω₁) ω₂ z_c σ₂ ι₂
        hra₂ hω₂_sq hz_c_sq hσa₂ hσ₂_ω₂ hσ₂_zc
    · obtain ⟨K₃, hFieldK₃, _, hAlgKK₃, hAlgK₂K₃, hTowerK₂K₃, ω₃, σ₃, ι₃,
          hω₃_sq, hσ₃_ω₃, hσ₃_alg, _⟩ :=
        h_s2 L K₂ σ₂ ι₂ (c : K) hc₂ y_c hy_c
      letI : Field K₃ := hFieldK₃
      letI : Algebra K K₃ := hAlgKK₃
      letI : Algebra K₂ K₃ := hAlgK₂K₃
      letI : IsScalarTower K K₂ K₃ := hTowerK₂K₃
      have hra₃ : (algebraMap K₂ K₃ (algebraMap K₁ K₂ ω₁)) ^ 2 = algebraMap K K₃ (a : K) := by
        rw [← map_pow, hra₂, ← IsScalarTower.algebraMap_apply K K₂ K₃]
      have hrb₃ : (algebraMap K₂ K₃ ω₂) ^ 2 = algebraMap K K₃ (b : K) := by
        rw [← map_pow, hω₂_sq, ← IsScalarTower.algebraMap_apply K K₂ K₃]
      have hσa₃ : σ₃ (algebraMap K₂ K₃ (algebraMap K₁ K₂ ω₁)) =
          -algebraMap K₂ K₃ (algebraMap K₁ K₂ ω₁) := by
        rw [hσ₃_alg, hσa₂, map_neg]
      have hσb₃ : σ₃ (algebraMap K₂ K₃ ω₂) = -algebraMap K₂ K₃ ω₂ := by
        rw [hσ₃_alg, hσ₂_ω₂, map_neg]
      exact h_lift K₃ (algebraMap K₂ K₃ (algebraMap K₁ K₂ ω₁)) (algebraMap K₂ K₃ ω₂) ω₃ σ₃ ι₃
        hra₃ hrb₃ hω₃_sq hσa₃ hσb₃ hσ₃_ω₃

theorem infinite_primes_of_chebotarev_conjugacy_nonempty (K L : Type u) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [IsGalois K L]
    (C : Set (L ≃ₐ[K] L))
    (hC_nonempty : C.Nonempty)
    (hC_conj : ∀ ρ ∈ C, ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C) :
    { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        ∃ g ∈ C, g ∈ FrobeniusClassAt K L p }.Infinite :=
by
  let S_C : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    { p | IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ C }
  let S_empty : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    { p | IsUnramifiedAtPrime K L p ∧ FrobeniusClassAt K L p ⊆ (∅ : Set (L ≃ₐ[K] L)) }
  have h_sub : S_C \ S_empty ⊆
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        ∃ g ∈ C, g ∈ FrobeniusClassAt K L p } := by
    intro p ⟨hpC, hp0⟩
    have h_not_sub : ¬ (FrobeniusClassAt K L p ⊆ (∅ : Set (L ≃ₐ[K] L))) :=
      fun h => hp0 ⟨hpC.1, h⟩
    obtain ⟨g, hg_frob, _⟩ := Set.not_subset.mp h_not_sub
    exact ⟨g, hpC.2 hg_frob, hg_frob⟩
  apply Set.Infinite.mono h_sub
  have hCheb_C : Filter.Tendsto (dirichletQuot S_C)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (ENNReal.ofReal ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)))) :=
    chebotarev_density_theorem (K := K) (L := L) C hC_conj
  have hCheb_empty_raw : Filter.Tendsto (dirichletQuot S_empty)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1))
      (nhds (ENNReal.ofReal
        ((Nat.card (∅ : Set (L ≃ₐ[K] L)) : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)))) :=
    chebotarev_density_theorem (K := K) (L := L) (∅ : Set (L ≃ₐ[K] L))
      (by intro ρ hρ; exact False.elim hρ)
  have h_card_empty : Nat.card (∅ : Set (L ≃ₐ[K] L)) = 0 := by
    haveI : IsEmpty (∅ : Set (L ≃ₐ[K] L)) := Subtype.isEmpty_false
    exact Nat.card_of_isEmpty
  have hCheb_empty : Filter.Tendsto (dirichletQuot S_empty)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    have h0 : ENNReal.ofReal
        ((Nat.card (∅ : Set (L ≃ₐ[K] L)) : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) = 0 := by
      rw [h_card_empty, Nat.cast_zero, zero_div, ENNReal.ofReal_zero]
    rwa [h0] at hCheb_empty_raw
  haveI : IsScalarTower ℚ K L := IsScalarTower.of_algebraMap_eq' (RingHom.ext_rat _ _)
  haveI : FiniteDimensional K L := FiniteDimensional.right ℚ K L
  haveI : Fintype (L ≃ₐ[K] L) := AlgEquiv.fintype K L
  haveI : Finite (L ≃ₐ[K] L) := Finite.of_fintype (L ≃ₐ[K] L)
  haveI : Finite C := Subtype.finite
  haveI : Nonempty C := hC_nonempty.to_subtype
  haveI : Nonempty (L ≃ₐ[K] L) := ⟨AlgEquiv.refl⟩
  have hC_card_pos : (0 : ℝ) < (Nat.card C : ℝ) :=
    Nat.cast_pos.mpr (@Nat.card_pos C _ _)
  have hGal_card_pos : (0 : ℝ) < (Nat.card (L ≃ₐ[K] L) : ℝ) :=
    Nat.cast_pos.mpr (@Nat.card_pos (L ≃ₐ[K] L) _ _)
  have hd_pos : (0 : ENNReal) <
      ENNReal.ofReal ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
    ENNReal.ofReal_pos.mpr (div_pos hC_card_pos hGal_card_pos)
  by_contra hnot_inf
  have hfin : (S_C \ S_empty).Finite := Set.not_infinite.mp hnot_inf
  let D : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    S_C \ S_empty
  letI : Fintype D := hfin.fintype
  let w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℝ → ENNReal :=
    fun p s => ENNReal.ofReal
      ((Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) : ℝ) ^ (-s))
  have hw_le_one : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (s : ℝ), 1 < s → w p s ≤ 1 := by
    intro p s hs
    change ENNReal.ofReal
      ((Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) : ℝ) ^ (-s)) ≤ 1
    rw [ENNReal.ofReal_le_one]
    by_cases hn : Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) = 0
    · rw [hn, Nat.cast_zero, Real.zero_rpow (by linarith : -s ≠ 0)]
      exact zero_le_one
    · have hn1 : (1 : ℝ) ≤ (Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) : ℝ) :=
        Nat.one_le_cast.mpr (Nat.one_le_iff_ne_zero.mpr hn)
      exact Real.rpow_le_one_of_one_le_of_nonpos hn1 (by linarith)
  have hD_sum_le : ∀ s : ℝ, 1 < s →
      (∑' p : D, w p.1 s) ≤ (Fintype.card D : ENNReal) := by
    intro s hs
    rw [tsum_fintype]
    calc ∑ p : D, w p.1 s
      _ ≤ ∑ _p : D, (1 : ENNReal) := Finset.sum_le_sum (fun p _ => hw_le_one p.1 s hs)
      _ = (Fintype.card D : ENNReal) := by simp
  have h_ind_le : ∀ (s : ℝ)
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      S_C.indicator (fun q => w q s) p ≤
        S_empty.indicator (fun q => w q s) p + D.indicator (fun q => w q s) p := by
    intro s p
    by_cases hpC : p ∈ S_C
    · rw [Set.indicator_of_mem hpC]
      by_cases hp0 : p ∈ S_empty
      · rw [Set.indicator_of_mem hp0]
        exact le_self_add
      · have hpD : p ∈ D := ⟨hpC, hp0⟩
        rw [Set.indicator_of_notMem hp0, Set.indicator_of_mem hpD, zero_add]
    · rw [Set.indicator_of_notMem hpC]
      exact zero_le _
  have h_tsum_le : ∀ s : ℝ, 1 < s →
      (∑' p : S_C, w p.1 s) ≤ (∑' p : S_empty, w p.1 s) + (Fintype.card D : ENNReal) := by
    intro s hs
    have h1 : (∑' p : S_C, w p.1 s) = ∑' p, S_C.indicator (fun q => w q s) p :=
      tsum_subtype S_C (fun q => w q s)
    have h2 : (∑' p : S_empty, w p.1 s) = ∑' p, S_empty.indicator (fun q => w q s) p :=
      tsum_subtype S_empty (fun q => w q s)
    have h3 : (∑' p : D, w p.1 s) = ∑' p, D.indicator (fun q => w q s) p :=
      tsum_subtype D (fun q => w q s)
    calc (∑' p : S_C, w p.1 s)
      _ = ∑' p, S_C.indicator (fun q => w q s) p := h1
      _ ≤ ∑' p, (S_empty.indicator (fun q => w q s) p + D.indicator (fun q => w q s) p) :=
          ENNReal.tsum_le_tsum (h_ind_le s)
      _ = (∑' p, S_empty.indicator (fun q => w q s) p) + (∑' p, D.indicator (fun q => w q s) p) :=
          ENNReal.tsum_add
      _ = (∑' p : S_empty, w p.1 s) + (∑' p : D, w p.1 s) := by rw [← h2, ← h3]
      _ ≤ (∑' p : S_empty, w p.1 s) + (Fintype.card D : ENNReal) :=
          add_le_add_right (hD_sum_le s hs) _
  have h_quot_le : ∀ s ∈ Set.Ioi (1 : ℝ),
      dirichletQuot S_C s ≤
        dirichletQuot S_empty s +
          (Fintype.card D : ENNReal) / ENNReal.ofReal (Real.log (1 / (s - 1))) := by
    intro s hs
    dsimp [dirichletQuot]
    rw [← ENNReal.add_div]
    exact ENNReal.div_le_div_right (h_tsum_le s hs) _
  have h_sub_tendsto : Filter.Tendsto (fun s : ℝ => s - 1)
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin (0 : ℝ) (Set.Ioi 0)) := by
    apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
    · have hcont : Continuous (fun s : ℝ => s - 1) := continuous_id.sub continuous_const
      have ht := hcont.tendsto 1
      rw [sub_self] at ht
      exact tendsto_nhdsWithin_of_tendsto_nhds ht
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact Set.mem_Ioi.mpr (sub_pos.mpr (Set.mem_Ioi.mp hs))
  have h_inv_tendsto : Filter.Tendsto (fun s : ℝ => 1 / (s - 1))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
    have h_eq : (fun s : ℝ => 1 / (s - 1)) = (fun x : ℝ => x⁻¹) ∘ (fun s : ℝ => s - 1) := by
      ext s
      exact one_div (s - 1)
    rw [h_eq]
    exact tendsto_inv_nhdsGT_zero.comp h_sub_tendsto
  have h_denom_tendsto : Filter.Tendsto
      (fun s : ℝ => ENNReal.ofReal (Real.log (1 / (s - 1))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds ⊤) :=
    ENNReal.tendsto_ofReal_atTop.comp (Real.tendsto_log_atTop.comp h_inv_tendsto)
  have h_rem_tendsto : Filter.Tendsto
      (fun s : ℝ => (Fintype.card D : ENNReal) / ENNReal.ofReal (Real.log (1 / (s - 1))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    have h := ENNReal.Tendsto.const_div h_denom_tendsto
      (Or.inr (ENNReal.natCast_ne_top (Fintype.card D)))
    rwa [ENNReal.div_top] at h
  have h_rhs_tendsto : Filter.Tendsto
      (fun s : ℝ => dirichletQuot S_empty s +
        (Fintype.card D : ENNReal) / ENNReal.ofReal (Real.log (1 / (s - 1))))
      (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
    simpa using hCheb_empty.add h_rem_tendsto
  haveI : (nhdsWithin (1 : ℝ) (Set.Ioi 1)).NeBot := nhdsWithin_Ioi_neBot le_rfl
  have hd_le_zero :
      ENNReal.ofReal ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) ≤ 0 :=
    le_of_tendsto_of_tendsto hCheb_C h_rhs_tendsto
      (Filter.eventually_of_mem self_mem_nhdsWithin h_quot_le)
  exact (not_le.mpr hd_pos) hd_le_zero

theorem finite_primes_frob_neg_and_local_isSquare (K L : Type u) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L]
    (w : Kˣ) (α : L)
    (hα : α ^ 2 = algebraMap K L (w : K)) :
    { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        (∃ g : L ≃ₐ[K] L, g ∈ FrobeniusClassAt K L p ∧ g α = -α) ∧
        IsSquare (algebraMap K (p.adicCompletion K) (w : K)) }.Finite :=
by
  classical
  have hex_approx : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (u : v.adicCompletion K), Valued.v u = 1 →
      ∃ r : NumberField.RingOfIntegers K,
        r ∉ v.asIdeal ∧
        Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
    intro v u hu
    have h_nhds : {y : v.adicCompletion K | Valued.v (y - u) < (1 : WithZero (Multiplicative ℤ))} ∈ nhds u := by
      rw [Valued.mem_nhds]
      exact ⟨1, fun y hy => hy⟩
    obtain ⟨x : K, hx_lt⟩ := DenseRange.mem_nhds UniformSpace.Completion.denseRange_coe h_nhds
    change Valued.v (algebraMap K (v.adicCompletion K) x - u) < 1 at hx_lt
    have hu_x_lt : Valued.v (u - algebraMap K (v.adicCompletion K) x) < 1 := by
      rwa [Valuation.map_sub_swap]
    have hx_val_L : Valued.v (algebraMap K (v.adicCompletion K) x) = 1 := by
      have h1 : algebraMap K (v.adicCompletion K) x = u + (algebraMap K (v.adicCompletion K) x - u) := by ring
      have hdist : Valued.v u ≠ Valued.v (algebraMap K (v.adicCompletion K) x - u) := by
        rw [hu]
        exact ne_of_gt hx_lt
      rw [h1, Valuation.map_add_of_distinct_val _ hdist, hu, max_eq_left (le_of_lt hx_lt)]
    have hx_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v) x = 1 := by
      rw [← v.valuedAdicCompletion_eq_valuation' x]
      exact hx_val_L
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) x
    have hb0 : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
    have hb_val_ne : v.intValuation b ≠ 0 := v.intValuation_ne_zero' ⟨b, hb⟩
    have hab_val : v.intValuation a = v.intValuation b := by
      have hdiv : (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K a /
          algebraMap (NumberField.RingOfIntegers K) K b) = 1 := by
        rw [hab, hx_val]
      rw [Valuation.map_div, v.valuation_of_algebraMap, v.valuation_of_algebraMap] at hdiv
      exact (div_eq_one_iff_eq hb_val_ne).mp hdiv
    set k : ℕ := (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {b})).factors
    have hb_exp : v.intValuation b = WithZero.exp (-(k : ℤ)) := v.intValuation_if_neg hb0
    have ha_exp : v.intValuation a = WithZero.exp (-(k : ℤ)) := hab_val.trans hb_exp
    have ha_mem : a ∈ v.asIdeal ^ k := (v.intValuation_le_pow_iff_mem a k).mp (le_of_eq ha_exp)
    have hb_mem : b ∈ v.asIdeal ^ k := (v.intValuation_le_pow_iff_mem b k).mp (le_of_eq hb_exp)
    have hb_not_mem : b ∉ v.asIdeal ^ (k + 1) := by
      intro hmem
      have hle := (v.intValuation_le_pow_iff_mem b (k + 1)).mpr hmem
      rw [hb_exp, WithZero.exp_le_exp] at hle
      omega
    have hI_eq : Ideal.span {b} ⊔ v.asIdeal ^ (k + 1) = v.asIdeal ^ k := by
      set I : Ideal (NumberField.RingOfIntegers K) := Ideal.span {b} ⊔ v.asIdeal ^ (k + 1)
      have hI_le : I ≤ v.asIdeal ^ k :=
        sup_le ((Ideal.span_singleton_le_iff_mem (v.asIdeal ^ k)).mpr hb_mem)
          (Ideal.pow_le_pow_right (Nat.le_succ k))
      obtain ⟨J, hIJ⟩ := Ideal.dvd_iff_le.mpr hI_le
      obtain ⟨C, hIC⟩ := Ideal.dvd_iff_le.mpr (le_sup_right : v.asIdeal ^ (k + 1) ≤ I)
      have hvk_ne : (v.asIdeal ^ k : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := pow_ne_zero k v.ne_bot
      have hv_eq : v.asIdeal = J * C := by
        apply mul_left_cancel₀ hvk_ne
        calc v.asIdeal ^ k * v.asIdeal
          _ = v.asIdeal ^ (k + 1) := (pow_succ v.asIdeal k).symm
          _ = I * C := hIC
          _ = (v.asIdeal ^ k * J) * C := by rw [hIJ]
          _ = v.asIdeal ^ k * (J * C) := mul_assoc _ _ _
      have hvJ : v.asIdeal ≤ J := Ideal.dvd_iff_le.mp ⟨C, hv_eq⟩
      have hJ_top : J = ⊤ := by
        by_contra hJ
        have hvJ_eq : v.asIdeal = J := v.isMaximal.eq_of_le hJ hvJ
        have hI_k1 : I = v.asIdeal ^ (k + 1) := by
          rw [hIJ, ← hvJ_eq, ← pow_succ]
        have hb_in_I : b ∈ I := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton b))
        rw [hI_k1] at hb_in_I
        exact hb_not_mem hb_in_I
      rw [hIJ, hJ_top, Ideal.mul_top]
    have ha_in_sup : a ∈ Ideal.span {b} ⊔ v.asIdeal ^ (k + 1) := by
      rwa [hI_eq]
    obtain ⟨y, hy, m, hm, hym⟩ := Submodule.mem_sup.mp ha_in_sup
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hy
    have harb_mem : a - r * b ∈ v.asIdeal ^ (k + 1) := by
      have h_eq : a - r * b = m := by
        rw [← hym]
        ring
      rwa [h_eq]
    have harb_lt : v.intValuation (a - r * b) < v.intValuation b := by
      have hle := (v.intValuation_le_pow_iff_mem (a - r * b) (k + 1)).mpr harb_mem
      have hlt : WithZero.exp (-((k + 1 : ℕ) : ℤ)) < WithZero.exp (-(k : ℤ)) := by
        rw [WithZero.exp_lt_exp]
        omega
      rw [hb_exp]
      exact lt_of_le_of_lt hle hlt
    have hbK_ne : (algebraMap (NumberField.RingOfIntegers K) K b) ≠ 0 :=
      (map_ne_zero_iff (algebraMap (NumberField.RingOfIntegers K) K)
        (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hb0
    have hxr_eq : x - (r : K) =
        algebraMap (NumberField.RingOfIntegers K) K (a - r * b) /
        algebraMap (NumberField.RingOfIntegers K) K b := by
      change x - algebraMap (NumberField.RingOfIntegers K) K r = _
      rw [← hab, map_sub, map_mul, sub_div, mul_div_cancel_right₀ _ hbK_ne]
    have hxr_val_lt : (v.valuation K) (x - (r : K)) < 1 := by
      rw [hxr_eq, Valuation.map_div, v.valuation_of_algebraMap, v.valuation_of_algebraMap]
      have hb_pos : 0 < v.intValuation b := by
        rw [hb_exp]
        exact WithZero.exp_pos
      rw [div_lt_iff₀ hb_pos, one_mul]
      exact harb_lt
    have hxr_L_lt : Valued.v (algebraMap K (v.adicCompletion K) x - algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
      rw [← map_sub]
      erw [v.valuedAdicCompletion_eq_valuation' (x - (r : K))]
      exact hxr_val_lt
    have hur_lt : Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
      have h_add : u - algebraMap K (v.adicCompletion K) (r : K) =
          (u - algebraMap K (v.adicCompletion K) x) +
          (algebraMap K (v.adicCompletion K) x - algebraMap K (v.adicCompletion K) (r : K)) := by ring
      rw [h_add]
      exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hu_x_lt hxr_L_lt)
    have hr_not_mem : r ∉ v.asIdeal := by
      intro hr_mem
      have hr_int_lt : v.intValuation r < 1 := (v.intValuation_lt_one_iff_mem r).mpr hr_mem
      have hr_K_lt : (v.valuation K) (r : K) < 1 := by
        change (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K r) < 1
        rwa [v.valuation_of_algebraMap]
      have hr_L_lt : Valued.v (algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
        erw [v.valuedAdicCompletion_eq_valuation' (r : K)]
        exact hr_K_lt
      have hu_lt : Valued.v u < 1 := by
        have h_u : u = (u - algebraMap K (v.adicCompletion K) (r : K)) +
            algebraMap K (v.adicCompletion K) (r : K) := by ring
        calc Valued.v u
          _ = Valued.v ((u - algebraMap K (v.adicCompletion K) (r : K)) +
              algebraMap K (v.adicCompletion K) (r : K)) := by rw [← h_u]
          _ ≤ max (Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)))
              (Valued.v (algebraMap K (v.adicCompletion K) (r : K))) :=
              Valuation.map_add _ _ _
          _ < 1 := max_lt hur_lt hr_L_lt
      rw [hu] at hu_lt
      exact lt_irrefl 1 hu_lt
    exact ⟨r, hr_not_mem, hur_lt⟩
  obtain ⟨a₀, s, hs_nzd, has⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) (w : K)
  have hs0 : s ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs_nzd
  have hsK : (s : K) ≠ 0 :=
    (map_ne_zero_iff (algebraMap (NumberField.RingOfIntegers K) K)
      (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hs0
  have ha₀_eq : (a₀ : K) = (w : K) * (s : K) := by
    have has' : (a₀ : K) / (s : K) = (w : K) := has
    exact (div_eq_iff hsK).mp has'
  let b₀ : NumberField.RingOfIntegers K := a₀ * s
  have hb₀_K : (b₀ : K) = (w : K) * (s : K) ^ 2 := by
    change (a₀ : K) * (s : K) = (w : K) * (s : K) ^ 2
    rw [ha₀_eq]
    ring
  have hb₀_K_ne : (b₀ : K) ≠ 0 := by
    rw [hb₀_K]
    exact mul_ne_zero w.ne_zero (pow_ne_zero 2 hsK)
  have h2b₀_ne : (2 * b₀ : NumberField.RingOfIntegers K) ≠ 0 := by
    intro h0
    have h0K : (((2 * b₀ : NumberField.RingOfIntegers K) : K)) = 0 := by
      rw [h0]
      rfl
    push_cast at h0K
    exact mul_ne_zero two_ne_zero hb₀_K_ne h0K
  let β : L := α * algebraMap K L (s : K)
  have hβ_sq : β ^ 2 = algebraMap K L (b₀ : K) := by
    dsimp [β]
    rw [mul_pow, hα, hb₀_K, map_mul, map_pow]
  have hβ_int : IsIntegral ℤ β := by
    apply IsIntegral.of_pow zero_lt_two
    rw [hβ_sq]
    exact IsIntegral.algebraMap (NumberField.RingOfIntegers.isIntegral_coe b₀)
  let x₀ : NumberField.RingOfIntegers L := ⟨β, hβ_int⟩
  have hx₀_coe : (x₀ : L) = β := rfl
  have hx₀_sq : x₀ ^ 2 = algebraMap (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers L) b₀ := by
    apply NumberField.RingOfIntegers.ext
    change (x₀ : L) ^ 2 =
      algebraMap (NumberField.RingOfIntegers L) L
        (algebraMap (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers L) b₀)
    rw [hx₀_coe, hβ_sq,
      ← IsScalarTower.algebraMap_apply (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers L) L b₀,
      IsScalarTower.algebraMap_apply (NumberField.RingOfIntegers K) K L b₀]
  have hI_ne_bot : Ideal.span ({2 * b₀} : Set (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Submodule.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact h2b₀_ne
  have hfin_bad :
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          p.asIdeal ∣ Ideal.span ({2 * b₀} : Set (NumberField.RingOfIntegers K)) }.Finite :=
    Ideal.finite_factors hI_ne_bot
  refine hfin_bad.subset ?_
  intro p hp
  rcases hp with ⟨⟨g, hg_frob, hg_α⟩, ⟨u_w, hu_w⟩⟩
  change p.asIdeal ∣ Ideal.span ({2 * b₀} : Set (NumberField.RingOfIntegers K))
  rw [Ideal.dvd_span_singleton]
  by_contra h2b₀_notMem
  have hb₀_notMem : b₀ ∉ p.asIdeal :=
    fun hb => h2b₀_notMem (p.asIdeal.mul_mem_left 2 hb)
  have hv_eq : ∀ k : K, Valued.v (algebraMap K (p.adicCompletion K) k) =
      (IsDedekindDomain.HeightOneSpectrum.valuation K p) k :=
    fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' p k
  have hv_int : ∀ r : NumberField.RingOfIntegers K,
      Valued.v (algebraMap K (p.adicCompletion K) (r : K)) = p.intValuation r := by
    intro r
    rw [hv_eq]
    exact p.valuation_of_algebraMap r
  let u : p.adicCompletion K := u_w * algebraMap K (p.adicCompletion K) (s : K)
  have hu_sq : algebraMap K (p.adicCompletion K) (b₀ : K) = u * u := by
    dsimp [u]
    rw [hb₀_K, map_mul, map_pow, hu_w]
    ring
  have hvb₀ : Valued.v (algebraMap K (p.adicCompletion K) (b₀ : K)) = 1 := by
    rw [hv_int]
    exact p.intValuation_eq_one_iff.mpr hb₀_notMem
  have hvu_sq : Valued.v u * Valued.v u = 1 := by
    rw [← Valuation.map_mul, ← hu_sq, hvb₀]
  have hvu_ne : Valued.v u ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hvu_sq
    exact zero_ne_one hvu_sq
  obtain ⟨g_val, hg_val⟩ := WithZero.ne_zero_iff_exists.mp hvu_ne
  have hg_val1 : g_val = 1 := by
    rw [← hg_val, ← WithZero.coe_mul, ← WithZero.coe_one, WithZero.coe_inj] at hvu_sq
    have hadd : Multiplicative.toAdd (g_val * g_val) = Multiplicative.toAdd (1 : Multiplicative ℤ) :=
      congrArg Multiplicative.toAdd hvu_sq
    rw [toAdd_mul, toAdd_one] at hadd
    have hg0 : Multiplicative.toAdd g_val = 0 := by omega
    exact Multiplicative.toAdd.injective hg0
  have hvu : Valued.v u = 1 := by
    rw [← hg_val, hg_val1, WithZero.coe_one]
  obtain ⟨r, hr_notMem, hur⟩ := hex_approx p u hvu
  have hvr : Valued.v (algebraMap K (p.adicCompletion K) (r : K)) = 1 := by
    rw [hv_int]
    exact p.intValuation_eq_one_iff.mpr hr_notMem
  have hur_add : Valued.v (u + algebraMap K (p.adicCompletion K) (r : K)) ≤ 1 := by
    calc Valued.v (u + algebraMap K (p.adicCompletion K) (r : K))
      _ ≤ max (Valued.v u) (Valued.v (algebraMap K (p.adicCompletion K) (r : K))) :=
          Valuation.map_add Valued.v u _
      _ = 1 := by rw [hvu, hvr, max_self]
  have hdiff_eq : algebraMap K (p.adicCompletion K) (((b₀ - r ^ 2 : NumberField.RingOfIntegers K) : K)) =
      (u - algebraMap K (p.adicCompletion K) (r : K)) *
      (u + algebraMap K (p.adicCompletion K) (r : K)) := by
    push_cast
    linear_combination hu_sq
  have hval_diff : p.intValuation (b₀ - r ^ 2) < 1 := by
    rw [← hv_int, hdiff_eq, Valuation.map_mul]
    calc Valued.v (u - algebraMap K (p.adicCompletion K) (r : K)) *
          Valued.v (u + algebraMap K (p.adicCompletion K) (r : K))
      _ ≤ Valued.v (u - algebraMap K (p.adicCompletion K) (r : K)) * 1 :=
          mul_le_mul' le_rfl hur_add
      _ = Valued.v (u - algebraMap K (p.adicCompletion K) (r : K)) := mul_one _
      _ < 1 := hur
  have hb₀_sub_r2 : b₀ - r ^ 2 ∈ p.asIdeal :=
    (p.intValuation_lt_one_iff_mem (b₀ - r ^ 2)).mp hval_diff
  have hr2_sub_b₀ : r ^ 2 - b₀ ∈ p.asIdeal := by
    have hneg := p.asIdeal.neg_mem hb₀_sub_r2
    have heq : -(b₀ - r ^ 2) = r ^ 2 - b₀ := by ring
    rwa [heq] at hneg
  rcases hg_frob with ⟨Q, hQ_prime, hQ_under, hQ_frob⟩
  set N : ℕ := Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal)
  let ι := algebraMap (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers L)
  have hgx₀ : ((-x₀ : NumberField.RingOfIntegers L) : L) = g (x₀ : L) := by
    change -(x₀ : L) = g (x₀ : L)
    rw [hx₀_coe]
    dsimp [β]
    rw [map_mul, hg_α, AlgEquiv.commutes]
    ring
  have hfrob_mem : (-x₀) - x₀ ^ N ∈ Q := hQ_frob x₀ (-x₀) hgx₀
  have h_r2_Q : ι (r ^ 2 - b₀) ∈ Q := by
    have hunder : r ^ 2 - b₀ ∈ Ideal.under (NumberField.RingOfIntegers K) Q := by
      rwa [hQ_under]
    exact Ideal.mem_comap.mp hunder
  have h_prod_Q : (ι r - x₀) * (ι r + x₀) ∈ Q := by
    have h_eq : (ι r - x₀) * (ι r + x₀) = ι (r ^ 2 - b₀) := by
      have h1 : (ι r - x₀) * (ι r + x₀) = (ι r) ^ 2 - x₀ ^ 2 := by ring
      rw [h1, hx₀_sq, map_sub, map_pow]
    rwa [h_eq]
  have hex_t : ∃ t : NumberField.RingOfIntegers K, ι t - x₀ ∈ Q := by
    rcases hQ_prime.mul_mem_iff_mem_or_mem.mp h_prod_Q with h_minus | h_plus
    · exact ⟨r, h_minus⟩
    · refine ⟨-r, ?_⟩
      have hneg := Q.neg_mem h_plus
      have heq : -(ι r + x₀) = ι (-r) - x₀ := by
        rw [map_neg]
        ring
      rwa [heq] at hneg
  obtain ⟨t, ht_Q⟩ := hex_t
  have htN_x₀N_Q : (ι t) ^ N - x₀ ^ N ∈ Q := by
    rw [← Ideal.Quotient.eq_zero_iff_mem] at ht_Q ⊢
    have hmk_eq : Ideal.Quotient.mk Q (ι t) = Ideal.Quotient.mk Q x₀ :=
      sub_eq_zero.mp (by simpa [map_sub] using ht_Q)
    rw [map_sub, map_pow, map_pow, hmk_eq, sub_self]
  have htN_t_p : t ^ N - t ∈ p.asIdeal := by
    haveI : p.asIdeal.IsMaximal := p.isMaximal
    letI : Field (NumberField.RingOfIntegers K ⧸ p.asIdeal) := Ideal.Quotient.field p.asIdeal
    haveI : Finite (NumberField.RingOfIntegers K ⧸ p.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot p.asIdeal p.ne_bot
    letI : Fintype (NumberField.RingOfIntegers K ⧸ p.asIdeal) := Fintype.ofFinite _
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_pow]
    have hcard : N = Fintype.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) := by
      dsimp [N]
      exact (Fintype.card_eq_nat_card).symm
    rw [hcard, FiniteField.pow_card, sub_self]
  have htN_t_Q : (ι t) ^ N - ι t ∈ Q := by
    have hunder : t ^ N - t ∈ Ideal.under (NumberField.RingOfIntegers K) Q := by
      rwa [hQ_under]
    have hmem : ι (t ^ N - t) ∈ Q := Ideal.mem_comap.mp hunder
    rwa [map_sub, map_pow] at hmem
  have h2x₀_Q : 2 * x₀ ∈ Q := by
    have hcomb := Q.sub_mem (Q.sub_mem htN_x₀N_Q ht_Q) (Q.add_mem htN_t_Q hfrob_mem)
    have heq : (((ι t) ^ N - x₀ ^ N) - (ι t - x₀)) - (((ι t) ^ N - ι t) + ((-x₀) - x₀ ^ N)) = 2 * x₀ := by
      ring
    rwa [heq] at hcomb
  have h2b₀_Q : ι (2 * b₀) ∈ Q := by
    have hmul := Q.mul_mem_right x₀ h2x₀_Q
    have heq : (2 * x₀) * x₀ = ι (2 * b₀) := by
      calc (2 * x₀) * x₀ = 2 * x₀ ^ 2 := by ring
        _ = 2 * ι b₀ := by rw [hx₀_sq]
        _ = ι (2 * b₀) := by rw [← map_ofNat ι 2, ← map_mul]
    rwa [heq] at hmul
  have h2b₀_under : 2 * b₀ ∈ Ideal.under (NumberField.RingOfIntegers K) Q :=
    Ideal.mem_comap.mpr h2b₀_Q
  rw [hQ_under] at h2b₀_under
  exact h2b₀_notMem h2b₀_under

theorem exists_prime_three_not_isSquare (K : Type u) [Field K] [NumberField K]
    (a b c : Kˣ)
    (T B S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (ha : ¬ IsSquare (a : K))
    (hb : ¬ IsSquare (b : K))
    (hc : ¬ IsSquare (c : K))
    (habc : ¬ IsSquare ((a * b * c : Kˣ) : K)) :
    ∃ v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v₀ ∉ T ∧ v₀ ∉ B ∧ v₀ ∉ S ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (a : K)) ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (b : K)) ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (c : K)) :=
by
  obtain ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, α_a, α_b, α_c, σ₀,
      hα_a, hα_b, hα_c, hσ_a, hσ_b, hσ_c⟩ :=
    exists_galois_aut_three_neg_of_not_isSquare K a b c ha hb hc habc
  letI : Field L := hFieldL
  letI : NumberField L := hNFL
  letI : Algebra K L := hAlgKL
  letI : IsGalois K L := hGalKL
  have h_conj_one : ∀ (w : K) (α : L), α ^ 2 = algebraMap K L w →
      ∀ (ρ τ : L ≃ₐ[K] L), ρ α = -α → (τ * ρ * τ⁻¹) α = -α := by
    intro w α hα ρ τ hρ
    have hsq : (τ⁻¹ α) ^ 2 = α ^ 2 := by
      rw [← map_pow, hα, AlgEquiv.commutes]
    have h_app : (τ * ρ * τ⁻¹) α = τ (ρ (τ⁻¹ α)) := rfl
    rw [h_app]
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h1 | h1
    · rw [h1, hρ, map_neg]
      have h2 : τ α = α := by
        have := congrArg τ h1
        simpa using this.symm
      rw [h2]
    · rw [h1, map_neg, hρ, neg_neg]
      have h2 : -τ α = α := by
        have := congrArg τ h1
        simpa [map_neg] using this.symm
      exact neg_eq_iff_eq_neg.mp h2
  let C : Set (L ≃ₐ[K] L) :=
    { g | g α_a = -α_a ∧ g α_b = -α_b ∧ g α_c = -α_c }
  have hC_nonempty : C.Nonempty := ⟨σ₀, hσ_a, hσ_b, hσ_c⟩
  have hC_conj : ∀ ρ ∈ C, ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C := by
    rintro ρ ⟨hρ_a, hρ_b, hρ_c⟩ τ
    exact ⟨h_conj_one (a : K) α_a hα_a ρ τ hρ_a,
           h_conj_one (b : K) α_b hα_b ρ τ hρ_b,
           h_conj_one (c : K) α_c hα_c ρ τ hρ_c⟩
  have hCheb_inf := infinite_primes_of_chebotarev_conjugacy_nonempty K L C hC_nonempty hC_conj
  have hfin_a := finite_primes_frob_neg_and_local_isSquare K L a α_a hα_a
  have hfin_b := finite_primes_frob_neg_and_local_isSquare K L b α_b hα_b
  have hfin_c := finite_primes_frob_neg_and_local_isSquare K L c α_c hα_c
  have hinf1 := hCheb_inf.diff hfin_a
  have hinf2 := hinf1.diff hfin_b
  have hinf3 := hinf2.diff hfin_c
  have hinf4 := hinf3.diff T.finite_toSet
  have hinf5 := hinf4.diff B.finite_toSet
  have hinf6 := hinf5.diff S.finite_toSet
  obtain ⟨v₀, hv₀⟩ := hinf6.nonempty
  rcases hv₀ with ⟨⟨⟨⟨⟨⟨⟨g, ⟨hg_a, hg_b, hg_c⟩, hg_frob⟩, hva⟩, hvb⟩, hvc⟩, hvT⟩, hvB⟩, hvS⟩
  refine ⟨v₀, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact fun h => hvT (Finset.mem_coe.mpr h)
  · exact fun h => hvB (Finset.mem_coe.mpr h)
  · exact fun h => hvS (Finset.mem_coe.mpr h)
  · exact fun h => hva ⟨⟨g, hg_frob, hg_a⟩, h⟩
  · exact fun h => hvb ⟨⟨g, hg_frob, hg_b⟩, h⟩
  · exact fun h => hvc ⟨⟨g, hg_frob, hg_c⟩, h⟩

theorem selmerStruct_four_nonSquare_or_subset_kernel (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (m : ℕ)
    (hmul : IsLocalMulClosed K a₁ a₂ a₃)
    (hπ : ∀ v ∈ S, IsLocalUnif v (π v))
    (hm : (selmerStruct K a₁ a₂ a₃ T S π).encard = 4 ^ (m + 1)) :
    (∃ p q : Kˣ × Kˣ,
      (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S π ∧
      (sqCl q.1, sqCl q.2) ∈ selmerStruct K a₁ a₂ a₃ T S π ∧
      ¬ IsSquare (p.1 : K) ∧
      ¬ IsSquare ((p.1 * p.2 : Kˣ) : K) ∧
      ¬ IsSquare (q.2 : K) ∧
      ¬ IsSquare ((p.2 * q.2 : Kˣ) : K)) ∨
    (∃ x : Kˣ, ¬ IsSquare (x : K) ∧
      (((∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c.1 = 1) ∧
        (sqCl 1, sqCl x) ∈ selmerStruct K a₁ a₂ a₃ T S π) ∨
       ((∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c.2 = 1) ∧
        (sqCl x, sqCl 1) ∈ selmerStruct K a₁ a₂ a₃ T S π) ∨
       ((∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c.1 = c.2) ∧
        (sqCl x, sqCl x) ∈ selmerStruct K a₁ a₂ a₃ T S π))) :=
by
  classical
  letI : CommGroup (SqCl K) := QuotientGroup.Quotient.commGroup _
  letI : CommGroup (SqCl K × SqCl K) := Prod.instCommGroup
  have hsqCl_one : sqCl (1 : Kˣ) = 1 := rfl
  have hsqCl_mul : ∀ x y : Kˣ, sqCl (x * y) = sqCl x * sqCl y := fun _ _ => rfl
  have hsqCl_eq_one_iff : ∀ u : Kˣ, sqCl u = 1 ↔ IsSquare (u : K) := by
    intro u
    constructor
    · intro hu
      obtain ⟨r, hr⟩ := (QuotientGroup.eq_one_iff u).mp hu
      have hr' : (r : K) * (r : K) = (u : K) := by
        have h := congrArg Units.val hr
        simpa [powMonoidHom_apply, sq] using h
      exact ⟨(r : K), hr'.symm⟩
    · rintro ⟨s, hs⟩
      have hs0 : s ≠ 0 := by
        intro h0
        rw [h0, mul_zero] at hs
        exact u.ne_zero hs
      let r : Kˣ := Units.mk0 s hs0
      apply (QuotientGroup.eq_one_iff u).mpr
      refine ⟨r, ?_⟩
      ext
      simp [r, powMonoidHom_apply, sq, hs.symm]
  have hsqCl_self : ∀ c : SqCl K, c * c = 1 := by
    intro c
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective c
    change sqCl (x * x) = 1
    exact (QuotientGroup.eq_one_iff (x * x)).mpr ⟨x, sq x⟩
  have hsqCl_eq_iff_mul_eq_one : ∀ a b : SqCl K, a = b ↔ a * b = 1 := by
    intro a b
    constructor
    · rintro rfl
      exact hsqCl_self a
    · intro hab
      calc a = a * 1 := (mul_one a).symm
        _ = a * (b * b) := by rw [hsqCl_self b]
        _ = (a * b) * b := (mul_assoc a b b).symm
        _ = 1 * b := by rw [hab]
        _ = b := one_mul b
  have hsqCl_ne_iff : ∀ u v : Kˣ, sqCl u ≠ sqCl v ↔ ¬ IsSquare ((u * v : Kˣ) : K) := by
    intro u v
    rw [ne_eq, hsqCl_eq_iff_mul_eq_one, ← hsqCl_mul, hsqCl_eq_one_iff]
  set V : Set (SqCl K × SqCl K) := selmerStruct K a₁ a₂ a₃ T S π
  have heven_mul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), EvenVal v x → EvenVal v y → EvenVal v (x * y) := by
    intro v x y ⟨kx, hkx⟩ ⟨ky, hky⟩
    dsimp [EvenVal]
    rw [map_mul, toAdd_mul, hkx, hky]
    exact ⟨kx + ky, by omega⟩
  let PreV : Set (Kˣ × Kˣ) :=
    { r : Kˣ × Kˣ |
      (∀ v ∈ T, IsDescentClass
            (algebraMap K (v.adicCompletion K) a₁)
            (algebraMap K (v.adicCompletion K) a₂)
            (algebraMap K (v.adicCompletion K) a₃)
            (algebraMap K (v.adicCompletion K) (r.1 : K))
            (algebraMap K (v.adicCompletion K) (r.2 : K))) ∧
      (∀ w : NumberField.InfinitePlace K, IsDescentClass
            (algebraMap K w.Completion a₁)
            (algebraMap K w.Completion a₂)
            (algebraMap K w.Completion a₃)
            (algebraMap K w.Completion (r.1 : K))
            (algebraMap K w.Completion (r.2 : K))) ∧
      (∀ v ∈ S, RamLocal a₁ a₂ a₃ v (π v) r.1 r.2) ∧
      (∀ v, v ∉ T → v ∉ S → EvenVal v r.1 ∧ EvenVal v r.2) }
  have hPreV_mul : ∀ r₁ r₂ : Kˣ × Kˣ, r₁ ∈ PreV → r₂ ∈ PreV →
      (r₁.1 * r₂.1, r₁.2 * r₂.2) ∈ PreV := by
    rintro r₁ r₂ ⟨h1₁, h2₁, h3₁, h4₁⟩ ⟨h1₂, h2₂, h3₂, h4₂⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro v hv
      exact hmul.1 v r₁.1 r₁.2 r₂.1 r₂.2 (h1₁ v hv) (h1₂ v hv)
    · intro w
      exact hmul.2.1 w r₁.1 r₁.2 r₂.1 r₂.2 (h2₁ w) (h2₂ w)
    · intro v hv
      exact hmul.2.2 v (π v) r₁.1 r₁.2 r₂.1 r₂.2 (hπ v hv) (h3₁ v hv) (h3₂ v hv)
    · intro v hvT hvS
      exact ⟨heven_mul v r₁.1 r₂.1 (h4₁ v hvT hvS).1 (h4₂ v hvT hvS).1,
             heven_mul v r₁.2 r₂.2 (h4₁ v hvT hvS).2 (h4₂ v hvT hvS).2⟩
  have hV_mul : ∀ c₁ c₂ : SqCl K × SqCl K, c₁ ∈ V → c₂ ∈ V → c₁ * c₂ ∈ V := by
    rintro c₁ c₂ ⟨r₁, hr₁, rfl⟩ ⟨r₂, hr₂, rfl⟩
    exact ⟨(r₁.1 * r₂.1, r₁.2 * r₂.2), hPreV_mul r₁ r₂ hr₁ hr₂, rfl⟩
  have hV_avoid_two : ∀ a b : SqCl K × SqCl K, ∃ c ∈ V, c ≠ a ∧ c ≠ b := by
    intro a b
    by_contra h_not
    have hsub : V ⊆ ({a} : Set (SqCl K × SqCl K)) ∪ {b} := by
      intro c hcV
      by_contra hc_not
      simp only [Set.mem_union, Set.mem_singleton_iff, not_or] at hc_not
      exact h_not ⟨c, hcV, hc_not.1, hc_not.2⟩
    have hle2 : V.encard ≤ 2 := by
      calc V.encard
        _ ≤ (({a} : Set (SqCl K × SqCl K)) ∪ {b}).encard := Set.encard_le_encard hsub
        _ ≤ ({a} : Set (SqCl K × SqCl K)).encard + ({b} : Set (SqCl K × SqCl K)).encard :=
            Set.encard_union_le {a} {b}
        _ = 1 + 1 := by rw [Set.encard_singleton, Set.encard_singleton]
        _ = 2 := rfl
    have hle2' : ((4 ^ (m + 1) : ℕ) : ℕ∞) ≤ ((2 : ℕ) : ℕ∞) := by
      have hcoe : (4 : ℕ∞) ^ (m + 1) = ((4 ^ (m + 1) : ℕ) : ℕ∞) := by norm_cast
      rw [← hcoe, ← hm]
      exact hle2
    have hle2_nat : 4 ^ (m + 1) ≤ 2 := by exact_mod_cast hle2'
    have h1_le : 1 ≤ 4 ^ m := Nat.one_le_pow m 4 (by omega)
    have hpow : 4 ^ (m + 1) = 4 ^ m * 4 := pow_succ 4 m
    omega
  by_cases hker1 : ∀ c ∈ V, c.1 = 1
  · obtain ⟨c₀, hc₀V, hc₀_ne, _⟩ := hV_avoid_two (1, 1) (1, 1)
    obtain ⟨p, hp_mem, hp_eq⟩ := hc₀V
    have hc₀ : (sqCl p.1, sqCl p.2) ∈ V := ⟨p, hp_mem, rfl⟩
    have hp1 : sqCl p.1 = 1 := hker1 (sqCl p.1, sqCl p.2) hc₀
    have hp2_ne : sqCl p.2 ≠ 1 := by
      intro hp2
      apply hc₀_ne
      rw [← hp_eq]
      exact Prod.ext hp1 hp2
    have hx : ¬ IsSquare (p.2 : K) := fun h => hp2_ne ((hsqCl_eq_one_iff p.2).mpr h)
    refine Or.inr ⟨p.2, hx, Or.inl ⟨hker1, ?_⟩⟩
    have h1 : sqCl (1 : Kˣ) = sqCl p.1 := hp1.symm
    rw [h1]
    exact hc₀
  · by_cases hker2 : ∀ c ∈ V, c.2 = 1
    · obtain ⟨c₀, hc₀V, hc₀_ne, _⟩ := hV_avoid_two (1, 1) (1, 1)
      obtain ⟨p, hp_mem, hp_eq⟩ := hc₀V
      have hc₀ : (sqCl p.1, sqCl p.2) ∈ V := ⟨p, hp_mem, rfl⟩
      have hp2 : sqCl p.2 = 1 := hker2 (sqCl p.1, sqCl p.2) hc₀
      have hp1_ne : sqCl p.1 ≠ 1 := by
        intro hp1
        apply hc₀_ne
        rw [← hp_eq]
        exact Prod.ext hp1 hp2
      have hx : ¬ IsSquare (p.1 : K) := fun h => hp1_ne ((hsqCl_eq_one_iff p.1).mpr h)
      refine Or.inr ⟨p.1, hx, Or.inr (Or.inl ⟨hker2, ?_⟩)⟩
      have h2 : sqCl (1 : Kˣ) = sqCl p.2 := hp2.symm
      rw [h2]
      exact hc₀
    · by_cases hker3 : ∀ c ∈ V, c.1 = c.2
      · obtain ⟨c₀, hc₀V, hc₀_ne, _⟩ := hV_avoid_two (1, 1) (1, 1)
        obtain ⟨p, hp_mem, hp_eq⟩ := hc₀V
        have hc₀ : (sqCl p.1, sqCl p.2) ∈ V := ⟨p, hp_mem, rfl⟩
        have hp12 : sqCl p.1 = sqCl p.2 := hker3 (sqCl p.1, sqCl p.2) hc₀
        have hp1_ne : sqCl p.1 ≠ 1 := by
          intro hp1
          apply hc₀_ne
          rw [← hp_eq]
          exact Prod.ext hp1 (hp12.symm.trans hp1)
        have hx : ¬ IsSquare (p.1 : K) := fun h => hp1_ne ((hsqCl_eq_one_iff p.1).mpr h)
        refine Or.inr ⟨p.1, hx, Or.inr (Or.inr ⟨hker3, ?_⟩)⟩
        have h12 : (sqCl p.1, sqCl p.1) = (sqCl p.1, sqCl p.2) := Prod.ext rfl hp12
        rw [h12]
        exact hc₀
      · push_neg at hker1 hker2 hker3
        obtain ⟨cx, hcxV, hcx1⟩ := hker1
        obtain ⟨cy, hcyV, hcy2⟩ := hker2
        obtain ⟨cz, hczV, hcz12⟩ := hker3
        have h_cp : ∃ cp ∈ V, cp.1 ≠ 1 ∧ cp.1 ≠ cp.2 := by
          by_cases hcx12 : cx.1 = cx.2
          · by_cases hcz1 : cz.1 = 1
            · refine ⟨cx * cz, hV_mul cx cz hcxV hczV, ?_, ?_⟩
              · change cx.1 * cz.1 ≠ 1
                rw [hcz1, mul_one]
                exact hcx1
              · change cx.1 * cz.1 ≠ cx.2 * cz.2
                intro heq
                rw [hcx12] at heq
                exact hcz12 (mul_left_cancel heq)
            · exact ⟨cz, hczV, hcz1, hcz12⟩
          · exact ⟨cx, hcxV, hcx1, hcx12⟩
        obtain ⟨cp, hcpV, hcp1, hcp12⟩ := h_cp
        have h_c12 : ∃ c₁ ∈ V, ∃ c₂ ∈ V,
            c₁.1 ≠ 1 ∧ c₁.1 ≠ c₁.2 ∧ c₂.2 ≠ 1 ∧ c₁.2 ≠ c₂.2 := by
          by_cases hcp2 : cp.2 = 1
          · refine ⟨cp, hcpV, cy, hcyV, hcp1, hcp12, hcy2, ?_⟩
            rw [hcp2]
            exact hcy2.symm
          · by_cases hw_ex : ∃ w ∈ V, w.2 ≠ 1 ∧ w.2 ≠ cp.2
            · obtain ⟨w, hwV, hw2_ne1, hw2_ne_cp2⟩ := hw_ex
              exact ⟨cp, hcpV, w, hwV, hcp1, hcp12, hw2_ne1, hw2_ne_cp2.symm⟩
            · obtain ⟨u, huV, hu_ne1, hu_ne_cp⟩ := hV_avoid_two (1, 1) cp
              by_cases hu2 : u.2 = 1
              · have hu1 : u.1 ≠ 1 := by
                  intro h1
                  exact hu_ne1 (Prod.ext h1 hu2)
                refine ⟨u, huV, cp, hcpV, hu1, ?_, hcp2, ?_⟩
                · rw [hu2]; exact hu1
                · rw [hu2]; exact Ne.symm hcp2
              · have hu2_eq : u.2 = cp.2 := by
                  by_contra hu2_ne
                  exact hw_ex ⟨u, huV, hu2, hu2_ne⟩
                have hucp2 : (u * cp).2 = 1 := by
                  change u.2 * cp.2 = 1
                  rw [hu2_eq]
                  exact hsqCl_self cp.2
                have hucp1 : (u * cp).1 ≠ 1 := by
                  change u.1 * cp.1 ≠ 1
                  intro h1
                  have hu1_eq : u.1 = cp.1 := (hsqCl_eq_iff_mul_eq_one u.1 cp.1).mpr h1
                  exact hu_ne_cp (Prod.ext hu1_eq hu2_eq)
                refine ⟨u * cp, hV_mul u cp huV hcpV, cp, hcpV, hucp1, ?_, hcp2, ?_⟩
                · rw [hucp2]; exact hucp1
                · rw [hucp2]; exact Ne.symm hcp2
        obtain ⟨c₁, hc₁V, c₂, hc₂V, hc₁1, hc₁12, hc₂2, hc₁₂2⟩ := h_c12
        obtain ⟨p, hp_mem, hp_eq⟩ := hc₁V
        obtain ⟨q, hq_mem, hq_eq⟩ := hc₂V
        have hp1_eq : sqCl p.1 = c₁.1 := congrArg Prod.fst hp_eq
        have hp2_eq : sqCl p.2 = c₁.2 := congrArg Prod.snd hp_eq
        have hq2_eq : sqCl q.2 = c₂.2 := congrArg Prod.snd hq_eq
        refine Or.inl ⟨p, q, ⟨p, hp_mem, rfl⟩, ⟨q, hq_mem, rfl⟩, ?_, ?_, ?_, ?_⟩
        · rw [← hsqCl_eq_one_iff p.1, hp1_eq]
          exact hc₁1
        · rw [← hsqCl_ne_iff p.1 p.2, hp1_eq, hp2_eq]
          exact hc₁12
        · rw [← hsqCl_eq_one_iff q.2, hq2_eq]
          exact hc₂2
        · rw [← hsqCl_ne_iff p.2 q.2, hp2_eq, hq2_eq]
          exact hc₁₂2

theorem poonen_rains_single_hilbert_eq_one (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (v₁ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hST : Disjoint S T)
    (hπ : ∀ v ∈ S, IsLocalUnif v (π v))
    (hv₁T : v₁ ∉ T) (hv₁S : v₁ ∉ S)
    (hdesc_outside : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ p : Kˣ × Kˣ,
        IsDescentClass
          (algebraMap K (v.adicCompletion K) a₁)
          (algebraMap K (v.adicCompletion K) a₂)
          (algebraMap K (v.adicCompletion K) a₃)
          (algebraMap K (v.adicCompletion K) (p.1 : K))
          (algebraMap K (v.adicCompletion K) (p.2 : K)) ↔
        EvenVal v p.1 ∧ EvenVal v p.2)
    (r : Kˣ × Kˣ)
    (hr : (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₁) :
    hilbFin v₁ (-(a₁ - a₂) * (a₂ - a₃) * (r.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (r.1 : K)) = 1 :=
by
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  have h_div_sq : ∀ {F : Type u} [Field F] (A B N₁ N₂ D : F),
      D ≠ 0 → A * N₁ ^ 2 + B * N₂ ^ 2 = D ^ 2 →
      A * (N₁ / D) ^ 2 + B * (N₂ / D) ^ 2 = 1 := by
    intro F _ A B N₁ N₂ D hD h_eq
    calc A * (N₁ / D) ^ 2 + B * (N₂ / D) ^ 2
      _ = (A * N₁ ^ 2 + B * N₂ ^ 2) / D ^ 2 := by rw [div_pow, div_pow]; ring
      _ = D ^ 2 / D ^ 2 := by rw [h_eq]
      _ = 1 := div_self (pow_ne_zero 2 hD)
  have h_map_ne : ∀ {L : Type u} [Field L] [Algebra K L] (u : Kˣ),
      algebraMap K L (u : K) ≠ 0 := by
    intro L _ _ u h
    rw [← map_zero (algebraMap K L)] at h
    exact u.ne_zero ((algebraMap K L).injective h)
  have h_conic_desc : ∀ {F : Type u} [Field F] [CharZero F]
      (e₁ e₂ e₃ d₁ d₂ : F),
      e₁ ≠ e₂ → e₁ ≠ e₃ → e₂ ≠ e₃ →
      d₁ ≠ 0 → d₂ ≠ 0 →
      IsDescentClass e₁ e₂ e₃ d₁ d₂ →
      ∃ x y : F,
        (-(e₁ - e₂) * (e₂ - e₃) * d₂) * x ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * y ^ 2 = 1 := by
    intro F _ _ e₁ e₂ e₃ d₁ d₂ he₁₂ he₁₃ he₂₃ hd₁ hd₂ hdesc
    have hα : e₁ - e₂ ≠ 0 := sub_ne_zero.mpr he₁₂
    have hβ : e₁ - e₃ ≠ 0 := sub_ne_zero.mpr he₁₃
    have hγ : e₂ - e₃ ≠ 0 := sub_ne_zero.mpr he₂₃
    have h2 : (2 : F) ≠ 0 := two_ne_zero
    obtain ⟨z₀, z₁, z₂, z₃, hz_ne, heq1, heq2⟩ := hdesc
    by_cases hz₃ : z₃ = 0
    · have hz₀ : z₀ ≠ 0 := by
        intro hz₀
        have hz₁ : z₁ = 0 := by
          have hsq : d₁ * z₁ ^ 2 = 0 := by
            linear_combination heq2 + d₁ * d₂ * z₃ * hz₃ + (e₃ - e₁) * z₀ * hz₀
          rcases mul_eq_zero.mp hsq with h | h
          · exact False.elim (hd₁ h)
          · exact pow_eq_zero h
        have hz₂ : z₂ = 0 := by
          have hsq : d₂ * z₂ ^ 2 = 0 := by
            linear_combination -heq1 + d₁ * z₁ * hz₁ - (e₂ - e₁) * z₀ * hz₀
          rcases mul_eq_zero.mp hsq with h | h
          · exact False.elim (hd₂ h)
          · exact pow_eq_zero h
        exact hz_ne ⟨hz₀, hz₁, hz₂, hz₃⟩
      have heq2_0 : d₁ * z₁ ^ 2 = (e₃ - e₁) * z₀ ^ 2 := by
        linear_combination heq2 + d₁ * d₂ * z₃ * hz₃
      have hD₂ : 2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀ ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero h2 hα) hβ) hγ) hz₀
      have h_num2 : (-(e₁ - e₂) * (e₂ - e₃) * d₂) * ((e₁ - e₂ + 1) * (e₁ - e₃) * z₂) ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * ((e₁ - e₂ - 1) * (e₂ - e₃) * z₁) ^ 2 =
          (2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀) ^ 2 := by
        linear_combination
          ((e₁ - e₂) * (e₂ - e₃) * (e₁ - e₃) ^ 2 * (e₁ - e₂ + 1) ^ 2) * heq1 +
          ((e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) ^ 2 * (e₁ - e₂ - 1) ^ 2 -
           (e₁ - e₂) * (e₂ - e₃) * (e₁ - e₃) ^ 2 * (e₁ - e₂ + 1) ^ 2) * heq2_0
      exact ⟨((e₁ - e₂ + 1) * (e₁ - e₃) * z₂) / (2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀),
             ((e₁ - e₂ - 1) * (e₂ - e₃) * z₁) / (2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀),
             h_div_sq _ _ _ _ _ hD₂ h_num2⟩
    · have hD₁ : (e₁ - e₂) * d₁ * d₂ * z₃ ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero hα hd₁) hd₂) hz₃
      have h_num1 : (-(e₁ - e₂) * (e₂ - e₃) * d₂) * (d₁ * z₁) ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * (d₂ * z₂) ^ 2 =
          ((e₁ - e₂) * d₁ * d₂ * z₃) ^ 2 := by
        linear_combination -((e₁ - e₂) * (e₁ - e₃) * d₁ * d₂) * heq1 +
          ((e₁ - e₂) ^ 2 * d₁ * d₂) * heq2
      exact ⟨(d₁ * z₁) / ((e₁ - e₂) * d₁ * d₂ * z₃),
             (d₂ * z₂) / ((e₁ - e₂) * d₁ * d₂ * z₃),
             h_div_sq _ _ _ _ _ hD₁ h_num1⟩
  have h_conic_ram : ∀ {F : Type u} [Field F] [CharZero F]
      (e₁ e₂ e₃ d₁ d₂ π_v : F),
      e₁ ≠ e₂ → e₁ ≠ e₃ → e₂ ≠ e₃ →
      d₁ ≠ 0 → d₂ ≠ 0 → π_v ≠ 0 →
      ((IsSquare d₁ ∧ IsSquare d₂) ∨
       IsSquare (d₁ * (e₁ - e₂) * (e₁ - e₃)) ∨
       IsSquare (-(d₂ * (e₁ - e₂) * (e₂ - e₃))) ∨
       (IsSquare (-(π_v * (d₁ * (e₁ - e₃)))) ∧ IsSquare (-(π_v * (d₂ * (e₂ - e₃)))))) →
      ∃ x y : F,
        (-(e₁ - e₂) * (e₂ - e₃) * d₂) * x ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * y ^ 2 = 1 := by
    intro F _ _ e₁ e₂ e₃ d₁ d₂ π_v he₁₂ he₁₃ he₂₃ hd₁ hd₂ hπ_ne hram
    have hα : e₁ - e₂ ≠ 0 := sub_ne_zero.mpr he₁₂
    have hβ : e₁ - e₃ ≠ 0 := sub_ne_zero.mpr he₁₃
    have hγ : e₂ - e₃ ≠ 0 := sub_ne_zero.mpr he₂₃
    have h2 : (2 : F) ≠ 0 := two_ne_zero
    rcases hram with ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩ | ⟨r₁, hr₁⟩ | ⟨r₂, hr₂⟩ | ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩
    · have hr₁_ne : r₁ ≠ 0 := by rintro rfl; apply hd₁; linear_combination hr₁
      have hr₂_ne : r₂ ≠ 0 := by rintro rfl; apply hd₂; linear_combination hr₂
      have hD : (e₁ - e₂) * r₁ * r₂ ≠ 0 := mul_ne_zero (mul_ne_zero hα hr₁_ne) hr₂_ne
      have h_num : (-(e₁ - e₂) * (e₂ - e₃) * d₂) * r₁ ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * r₂ ^ 2 =
          ((e₁ - e₂) * r₁ * r₂) ^ 2 := by
        linear_combination -(e₁ - e₂) * (e₂ - e₃) * r₁ ^ 2 * hr₂ +
          (e₁ - e₂) * (e₁ - e₃) * r₂ ^ 2 * hr₁
      exact ⟨r₁ / ((e₁ - e₂) * r₁ * r₂), r₂ / ((e₁ - e₂) * r₁ * r₂),
             h_div_sq _ _ _ _ _ hD h_num⟩
    · have hr₁_ne : r₁ ≠ 0 := by
        rintro rfl
        apply mul_ne_zero (mul_ne_zero hd₁ hα) hβ
        linear_combination hr₁
      have h_num : (-(e₁ - e₂) * (e₂ - e₃) * d₂) * (0 : F) ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * (1 : F) ^ 2 = r₁ ^ 2 := by
        linear_combination hr₁
      exact ⟨0 / r₁, 1 / r₁, h_div_sq _ _ _ _ _ hr₁_ne h_num⟩
    · have hr₂_ne : r₂ ≠ 0 := by
        rintro rfl
        apply neg_ne_zero.mpr (mul_ne_zero (mul_ne_zero hd₂ hα) hγ)
        linear_combination hr₂
      have h_num : (-(e₁ - e₂) * (e₂ - e₃) * d₂) * (1 : F) ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * (0 : F) ^ 2 = r₂ ^ 2 := by
        linear_combination hr₂
      exact ⟨1 / r₂, 0 / r₂, h_div_sq _ _ _ _ _ hr₂_ne h_num⟩
    · have hr₁_ne : r₁ ≠ 0 := by
        rintro rfl
        apply neg_ne_zero.mpr (mul_ne_zero hπ_ne (mul_ne_zero hd₁ hβ))
        linear_combination hr₁
      have hA_ne : -(e₁ - e₂) * (e₂ - e₃) * d₂ ≠ 0 :=
        mul_ne_zero (mul_ne_zero (neg_ne_zero.mpr hα) hγ) hd₂
      have hD₄ : 2 * (-(e₁ - e₂) * (e₂ - e₃) * d₂) * r₁ ≠ 0 :=
        mul_ne_zero (mul_ne_zero h2 hA_ne) hr₁_ne
      have h_num : (-(e₁ - e₂) * (e₂ - e₃) * d₂) *
            (((-(e₁ - e₂) * (e₂ - e₃) * d₂) + 1) * r₁) ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) *
            (((-(e₁ - e₂) * (e₂ - e₃) * d₂) - 1) * r₂) ^ 2 =
          (2 * (-(e₁ - e₂) * (e₂ - e₃) * d₂) * r₁) ^ 2 := by
        linear_combination
          -(-(e₁ - e₂) * (e₂ - e₃) * d₂) * ((-(e₁ - e₂) * (e₂ - e₃) * d₂) - 1) ^ 2 * hr₁ -
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * ((-(e₁ - e₂) * (e₂ - e₃) * d₂) - 1) ^ 2 * hr₂
      exact ⟨(((-(e₁ - e₂) * (e₂ - e₃) * d₂) + 1) * r₁) / (2 * (-(e₁ - e₂) * (e₂ - e₃) * d₂) * r₁),
             (((-(e₁ - e₂) * (e₂ - e₃) * d₂) - 1) * r₂) / (2 * (-(e₁ - e₂) * (e₂ - e₃) * d₂) * r₁),
             h_div_sq _ _ _ _ _ hD₄ h_num⟩
  obtain ⟨p, ⟨hpT, hpInf, hpS, hpOut⟩, hp_eq⟩ := hr
  have h₁₂_sub : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr h₁₂
  have h₁₃_sub : a₁ - a₃ ≠ 0 := sub_ne_zero.mpr h₁₃
  have h₂₃_sub : a₂ - a₃ ≠ 0 := sub_ne_zero.mpr h₂₃
  have hAp_ne : -(a₁ - a₂) * (a₂ - a₃) * (p.2 : K) ≠ 0 :=
    mul_ne_zero (mul_ne_zero (neg_ne_zero.mpr h₁₂_sub) h₂₃_sub) p.2.ne_zero
  have hBp_ne : (a₁ - a₂) * (a₁ - a₃) * (p.1 : K) ≠ 0 :=
    mul_ne_zero (mul_ne_zero h₁₂_sub h₁₃_sub) p.1.ne_zero
  let A_u : Kˣ := Units.mk0 (-(a₁ - a₂) * (a₂ - a₃) * (p.2 : K)) hAp_ne
  let B_u : Kˣ := Units.mk0 ((a₁ - a₂) * (a₁ - a₃) * (p.1 : K)) hBp_ne
  have h_fin_desc : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (algebraMap K (v.adicCompletion K) (p.1 : K))
        (algebraMap K (v.adicCompletion K) (p.2 : K)) →
      hilbFin v (-(a₁ - a₂) * (a₂ - a₃) * (p.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (p.1 : K)) = 1 := by
    intro v hdesc
    haveI : CharZero (v.adicCompletion K) :=
      (RingHom.charZero_iff (algebraMap K (v.adicCompletion K)).injective).mp inferInstance
    have hinj := (algebraMap K (v.adicCompletion K)).injective
    obtain ⟨x, y, hxy⟩ := h_conic_desc
      (algebraMap K (v.adicCompletion K) a₁)
      (algebraMap K (v.adicCompletion K) a₂)
      (algebraMap K (v.adicCompletion K) a₃)
      (algebraMap K (v.adicCompletion K) (p.1 : K))
      (algebraMap K (v.adicCompletion K) (p.2 : K))
      (hinj.ne h₁₂) (hinj.ne h₁₃) (hinj.ne h₂₃)
      (h_map_ne p.1) (h_map_ne p.2)
      hdesc
    unfold hilbFin hilbLoc
    apply if_pos
    refine ⟨x, y, ?_⟩
    push_cast
    exact hxy
  have h_fin_other : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ≠ v₁ →
      hilbFin v (-(a₁ - a₂) * (a₂ - a₃) * (p.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (p.1 : K)) = 1 := by
    intro v hvv₁
    by_cases hvS : v ∈ S
    · haveI : CharZero (v.adicCompletion K) :=
        (RingHom.charZero_iff (algebraMap K (v.adicCompletion K)).injective).mp inferInstance
      have hinj := (algebraMap K (v.adicCompletion K)).injective
      obtain ⟨n, _, hπ_val⟩ := hπ v hvS
      have hπ_ne : π v ≠ 0 := by
        intro h0
        rw [h0, Valuation.map_zero] at hπ_val
        exact WithZero.coe_ne_zero hπ_val.symm
      have hram_v := hpS v hvS
      have hram_F :
          (IsSquare (algebraMap K (v.adicCompletion K) (p.1 : K)) ∧
           IsSquare (algebraMap K (v.adicCompletion K) (p.2 : K))) ∨
          IsSquare (algebraMap K (v.adicCompletion K) (p.1 : K) *
            (algebraMap K (v.adicCompletion K) a₁ - algebraMap K (v.adicCompletion K) a₂) *
            (algebraMap K (v.adicCompletion K) a₁ - algebraMap K (v.adicCompletion K) a₃)) ∨
          IsSquare (-(algebraMap K (v.adicCompletion K) (p.2 : K) *
            (algebraMap K (v.adicCompletion K) a₁ - algebraMap K (v.adicCompletion K) a₂) *
            (algebraMap K (v.adicCompletion K) a₂ - algebraMap K (v.adicCompletion K) a₃))) ∨
          (IsSquare (-(π v * (algebraMap K (v.adicCompletion K) (p.1 : K) *
            (algebraMap K (v.adicCompletion K) a₁ - algebraMap K (v.adicCompletion K) a₃)))) ∧
           IsSquare (-(π v * (algebraMap K (v.adicCompletion K) (p.2 : K) *
            (algebraMap K (v.adicCompletion K) a₂ - algebraMap K (v.adicCompletion K) a₃))))) := by
        rcases hram_v with h1 | ⟨h2, _⟩ | ⟨_, h3⟩ | ⟨h4a, h4b⟩
        · exact Or.inl h1
        · refine Or.inr (Or.inl ?_)
          push_cast at h2
          exact h2
        · refine Or.inr (Or.inr (Or.inl ?_))
          push_cast at h3
          exact h3
        · refine Or.inr (Or.inr (Or.inr ⟨?_, ?_⟩))
          · push_cast at h4a
            exact h4a
          · push_cast at h4b
            exact h4b
      obtain ⟨x, y, hxy⟩ := h_conic_ram
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (algebraMap K (v.adicCompletion K) (p.1 : K))
        (algebraMap K (v.adicCompletion K) (p.2 : K))
        (π v)
        (hinj.ne h₁₂) (hinj.ne h₁₃) (hinj.ne h₂₃)
        (h_map_ne p.1) (h_map_ne p.2)
        hπ_ne hram_F
      unfold hilbFin hilbLoc
      apply if_pos
      refine ⟨x, y, ?_⟩
      push_cast
      exact hxy
    · by_cases hvT : v ∈ T
      · exact h_fin_desc v (hpT v hvT)
      · exact h_fin_desc v ((hdesc_outside v hvT p).mpr (hpOut v hvT hvS hvv₁))
  have h_inf_all : ∀ w : NumberField.InfinitePlace K,
      hilbInf w (-(a₁ - a₂) * (a₂ - a₃) * (p.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (p.1 : K)) = 1 := by
    intro w
    haveI : CharZero w.Completion :=
      (RingHom.charZero_iff (algebraMap K w.Completion).injective).mp inferInstance
    have hinj := (algebraMap K w.Completion).injective
    obtain ⟨x, y, hxy⟩ := h_conic_desc
      (algebraMap K w.Completion a₁)
      (algebraMap K w.Completion a₂)
      (algebraMap K w.Completion a₃)
      (algebraMap K w.Completion (p.1 : K))
      (algebraMap K w.Completion (p.2 : K))
      (hinj.ne h₁₂) (hinj.ne h₁₃) (hinj.ne h₂₃)
      (h_map_ne p.1) (h_map_ne p.2)
      (hpInf w)
    unfold hilbInf hilbInfLoc
    apply if_pos
    refine ⟨x, y, ?_⟩
    push_cast
    exact hxy
  have h_recip := (hilbert_reciprocity A_u B_u).2
  change (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      hilbFin v (-(a₁ - a₂) * (a₂ - a₃) * (p.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (p.1 : K))) *
    (∏ w : NumberField.InfinitePlace K,
      hilbInf w (-(a₁ - a₂) * (a₂ - a₃) * (p.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (p.1 : K))) = 1 at h_recip
  rw [finprod_eq_single _ v₁ h_fin_other,
      Finset.prod_eq_one (fun w _ => h_inf_all w), mul_one] at h_recip
  have hp1_eq : sqCl p.1 = sqCl r.1 := (Prod.mk.injEq _ _ _ _).mp hp_eq |>.1
  have hp2_eq : sqCl p.2 = sqCl r.2 := (Prod.mk.injEq _ _ _ _).mp hp_eq |>.2
  obtain ⟨u₁, hu₁⟩ : ∃ u₁ : Kˣ, u₁ ^ 2 = p.1⁻¹ * r.1 :=
    MonoidHom.mem_range.mp (QuotientGroup.eq.mp hp1_eq)
  obtain ⟨u₂, hu₂⟩ : ∃ u₂ : Kˣ, u₂ ^ 2 = p.2⁻¹ * r.2 :=
    MonoidHom.mem_range.mp (QuotientGroup.eq.mp hp2_eq)
  have hr1_eq : (r.1 : K) = (p.1 : K) * (u₁ : K) ^ 2 := by
    have h_u : r.1 = p.1 * u₁ ^ 2 := by
      calc r.1 = p.1 * (p.1⁻¹ * r.1) := by group
        _ = p.1 * u₁ ^ 2 := by rw [← hu₁]
    exact_mod_cast congrArg (Units.val : Kˣ → K) h_u
  have hr2_eq : (r.2 : K) = (p.2 : K) * (u₂ : K) ^ 2 := by
    have h_u : r.2 = p.2 * u₂ ^ 2 := by
      calc r.2 = p.2 * (p.2⁻¹ * r.2) := by group
        _ = p.2 * u₂ ^ 2 := by rw [← hu₂]
    exact_mod_cast congrArg (Units.val : Kˣ → K) h_u
  unfold hilbFin hilbLoc at h_recip ⊢
  split_ifs at h_recip with hsol
  · obtain ⟨x, y, hxy⟩ := hsol
    apply if_pos
    have hu₁_ne : algebraMap K (v₁.adicCompletion K) (u₁ : K) ≠ 0 := h_map_ne u₁
    have hu₂_ne : algebraMap K (v₁.adicCompletion K) (u₂ : K) ≠ 0 := h_map_ne u₂
    refine ⟨x / algebraMap K (v₁.adicCompletion K) (u₂ : K),
            y / algebraMap K (v₁.adicCompletion K) (u₁ : K), ?_⟩
    rw [hr1_eq, hr2_eq]
    push_cast
    push_cast at hxy
    have h_scale :
        (-(algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₂) *
          (algebraMap K (v₁.adicCompletion K) a₂ - algebraMap K (v₁.adicCompletion K) a₃) *
          (algebraMap K (v₁.adicCompletion K) (p.2 : K) *
            algebraMap K (v₁.adicCompletion K) (u₂ : K) ^ 2)) *
          (x / algebraMap K (v₁.adicCompletion K) (u₂ : K)) ^ 2 +
        ((algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₂) *
          (algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₃) *
          (algebraMap K (v₁.adicCompletion K) (p.1 : K) *
            algebraMap K (v₁.adicCompletion K) (u₁ : K) ^ 2)) *
          (y / algebraMap K (v₁.adicCompletion K) (u₁ : K)) ^ 2 =
        (-(algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₂) *
          (algebraMap K (v₁.adicCompletion K) a₂ - algebraMap K (v₁.adicCompletion K) a₃) *
          algebraMap K (v₁.adicCompletion K) (p.2 : K)) *
          (algebraMap K (v₁.adicCompletion K) (u₂ : K) *
            (x / algebraMap K (v₁.adicCompletion K) (u₂ : K))) ^ 2 +
        ((algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₂) *
          (algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₃) *
          algebraMap K (v₁.adicCompletion K) (p.1 : K)) *
          (algebraMap K (v₁.adicCompletion K) (u₁ : K) *
            (y / algebraMap K (v₁.adicCompletion K) (u₁ : K))) ^ 2 := by ring
    rw [h_scale, mul_div_cancel₀ _ hu₂_ne, mul_div_cancel₀ _ hu₁_ne, hxy]
  · exfalso
    revert h_recip
    decide

theorem local_v1_hilbLoc_and_ramLocal_laws (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (v₁ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hv₁T : v₁ ∉ T)
    (hdesc_v₁ : ∀ p : Kˣ × Kˣ,
      IsDescentClass
        (algebraMap K (v₁.adicCompletion K) a₁)
        (algebraMap K (v₁.adicCompletion K) a₂)
        (algebraMap K (v₁.adicCompletion K) a₃)
        (algebraMap K (v₁.adicCompletion K) (p.1 : K))
        (algebraMap K (v₁.adicCompletion K) (p.2 : K)) ↔
      EvenVal v₁ p.1 ∧ EvenVal v₁ p.2) :
    ∃ π_u : Kˣ, IsLocalPivotUnif K a₁ a₂ a₃ v₁ π_u :=
by
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  have hint₁ : IsIntegral ℤ a₁ := hstart.2.2.2.2.2.2.1
  have hint₂ : IsIntegral ℤ a₂ := hstart.2.2.2.2.2.2.2.1
  have hint₃ : IsIntegral ℤ a₃ := hstart.2.2.2.2.2.2.2.2.1
  let A₁ : NumberField.RingOfIntegers K := ⟨a₁, hint₁⟩
  let A₂ : NumberField.RingOfIntegers K := ⟨a₂, hint₂⟩
  let A₃ : NumberField.RingOfIntegers K := ⟨a₃, hint₃⟩
  have hval2_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 2 ≤ 1 := by
    have := v₁.valuation_le_one (K := K) (2 : NumberField.RingOfIntegers K)
    simpa using this
  have hval3_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 3 ≤ 1 := by
    have := v₁.valuation_le_one (K := K) (3 : NumberField.RingOfIntegers K)
    simpa using this
  have hval6_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 6 ≤ 1 := by
    have := v₁.valuation_le_one (K := K) (6 : NumberField.RingOfIntegers K)
    simpa using this
  have hval12_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₂) ≤ 1 := by
    have := v₁.valuation_le_one (K := K) (A₁ - A₂)
    simpa [A₁, A₂] using this
  have hval13_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₃) ≤ 1 := by
    have := v₁.valuation_le_one (K := K) (A₁ - A₃)
    simpa [A₁, A₃] using this
  have hval23_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₂ - a₃) ≤ 1 := by
    have := v₁.valuation_le_one (K := K) (A₂ - A₃)
    simpa [A₂, A₃] using this
  have hgood : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁)
      (6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)) = 1 := by
    have := (hT v₁).not.mp hv₁T
    exact not_ne_iff.mp this
  rw [map_mul, map_mul, map_mul] at hgood
  have h_le_prod1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₂) ≤ 1 :=
    (mul_le_of_le_one_right' hval12_le).trans hval6_le
  have h_le_prod2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₂) *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₃) ≤ 1 :=
    (mul_le_of_le_one_right' hval13_le).trans h_le_prod1
  have hval23 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₂ - a₃) = 1 :=
    le_antisymm hval23_le (by rw [← hgood]; exact mul_le_of_le_one_left' h_le_prod2)
  have hgood2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₂) *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₃) = 1 := by
    rw [hval23, mul_one] at hgood; exact hgood
  have hval13 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₃) = 1 :=
    le_antisymm hval13_le (by rw [← hgood2]; exact mul_le_of_le_one_left' h_le_prod1)
  have hgood1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₂) = 1 := by
    rw [hval13, mul_one] at hgood2; exact hgood2
  have hval12 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (a₁ - a₂) = 1 :=
    le_antisymm hval12_le (by rw [← hgood1]; exact mul_le_of_le_one_left' hval6_le)
  have hval6 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 6 = 1 := by
    rw [hval12, mul_one] at hgood1; exact hgood1
  have h6_eq : (6 : K) = 2 * 3 := by norm_num
  rw [h6_eq, map_mul] at hval6
  have hval2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 2 = 1 :=
    le_antisymm hval2_le (by rw [← hval6]; exact mul_le_of_le_one_right' hval3_le)
  have hval_neg1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (-1 : K) = 1 := by
    rw [Valuation.map_neg, Valuation.map_one]
  have hv_eq : ∀ k : K, Valued.v (algebraMap K (v₁.adicCompletion K) k) =
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) k :=
    fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v₁ k
  have hv12 : Valued.v (algebraMap K (v₁.adicCompletion K) (a₁ - a₂)) = 1 := by
    rw [hv_eq, hval12]
  have hv13 : Valued.v (algebraMap K (v₁.adicCompletion K) (a₁ - a₃)) = 1 := by
    rw [hv_eq, hval13]
  have hv_unit : ∀ u : Kˣ, Valued.v (algebraMap K (v₁.adicCompletion K) (u : K)) =
      ((v₁.valuationOfNeZero u : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
    intro u
    rw [hv_eq, ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v₁ u]
  
  have h_isSquare_one_add : ∀ x : v₁.adicCompletion K, Valued.v x < 1 → IsSquare (1 + x) := by
    intro x hx
    have hv2 : Valued.v (2 : v₁.adicCompletion K) = 1 := by
      rw [← map_ofNat (algebraMap K (v₁.adicCompletion K)) 2]
      erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v₁ (2 : K)]
      exact hval2
    have hv4 : Valued.v (4 : v₁.adicCompletion K) = 1 := by
      have h42 : (4 : v₁.adicCompletion K) = 2 * 2 := by norm_num
      rw [h42, Valuation.map_mul, hv2, mul_one]
    have h4_ne : (4 : v₁.adicCompletion K) ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at hv4; exact zero_ne_one hv4
    let z : v₁.adicCompletion K := (4 : v₁.adicCompletion K)⁻¹ * x
    have h1x : 1 + x = 1 + 4 * z := by
      dsimp only [z]; rw [mul_inv_cancel_left₀ h4_ne]
    have hz_lt : Valued.v z < 1 := by
      dsimp only [z]; rw [Valuation.map_mul, Valuation.map_inv, hv4, inv_one, one_mul]; exact hx
    have hz_val : Valued.v z ≤ WithZero.exp (-1 : ℤ) := by
      by_cases hz0 : Valued.v z = 0
      · rw [hz0]; exact zero_le'
      · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hz0
        rw [← hg] at hz_lt ⊢
        have hg_exp : (g : WithZero (Multiplicative ℤ)) = WithZero.exp (Multiplicative.toAdd g) := by
          rw [← ofAdd_toAdd g]; rfl
        rw [hg_exp] at hz_lt ⊢
        rw [← WithZero.exp_zero] at hz_lt
        have hlt : Multiplicative.toAdd g < 0 := WithZero.exp_lt_exp.mp hz_lt
        exact WithZero.exp_le_exp.mpr (by omega)
    let e₁ : WithZero (Multiplicative ℤ) := WithZero.exp (-1 : ℤ)
    have he₁_le_one : e₁ ≤ 1 := by
      rw [← WithZero.exp_zero]; exact WithZero.exp_le_exp.mpr (by omega)
    have hw_le : ∀ n : ℕ, Valued.v (henselSeq z n) ≤ e₁ := by
      intro n
      induction n with
      | zero =>
        simp only [henselSeq, Valuation.map_zero]; exact zero_le'
      | succ n ih =>
        simp only [henselSeq]
        have hsq : Valued.v ((henselSeq z n) ^ 2) ≤ e₁ := by
          rw [sq, Valuation.map_mul]
          calc Valued.v (henselSeq z n) * Valued.v (henselSeq z n)
            _ ≤ e₁ * 1 := mul_le_mul' ih (le_trans ih he₁_le_one)
            _ = e₁ := mul_one e₁
        exact le_trans (Valuation.map_sub _ _ _) (max_le hz_val hsq)
    have hw_diff : ∀ n : ℕ, Valued.v (henselSeq z (n + 1) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
      intro n
      induction n with
      | zero =>
        have h0 : henselSeq z 1 - henselSeq z 0 = z := by simp [henselSeq]
        rw [h0]; simpa using hz_val
      | succ n ih =>
        have hstep : henselSeq z (n + 2) - henselSeq z (n + 1) =
            -(henselSeq z (n + 1) + henselSeq z n) * (henselSeq z (n + 1) - henselSeq z n) := by
          simp only [henselSeq]; ring
        have hsum : Valued.v (henselSeq z (n + 1) + henselSeq z n) ≤ e₁ :=
          le_trans (Valuation.map_add _ _ _) (max_le (hw_le (n + 1)) (hw_le n))
        rw [hstep, Valuation.map_mul, Valuation.map_neg]
        calc Valued.v (henselSeq z (n + 1) + henselSeq z n) * Valued.v (henselSeq z (n + 1) - henselSeq z n)
          _ ≤ WithZero.exp (-1 : ℤ) * WithZero.exp (-(n + 1 : ℤ)) := mul_le_mul' hsum ih
          _ = WithZero.exp ((-1 : ℤ) + -(n + 1 : ℤ)) := (WithZero.exp_add (-1 : ℤ) (-(n + 1 : ℤ))).symm
          _ = WithZero.exp (-((n + 1 : ℕ) + 1 : ℤ)) := by congr 1; push_cast; ring
    have hw_tele : ∀ n k : ℕ, Valued.v (henselSeq z (n + k) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
      intro n k
      induction k with
      | zero =>
        simp only [Nat.add_zero, sub_self, Valuation.map_zero]; exact zero_le'
      | succ k ih =>
        have hsplit : henselSeq z (n + (k + 1)) - henselSeq z n =
            (henselSeq z (n + k + 1) - henselSeq z (n + k)) + (henselSeq z (n + k) - henselSeq z n) := by
          have hidx : n + (k + 1) = n + k + 1 := by omega
          rw [hidx]; ring
        rw [hsplit]
        refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ih)
        refine le_trans (hw_diff (n + k)) ?_
        exact WithZero.exp_le_exp.mpr (by omega)
    have hw_symm : ∀ N a b : ℕ, N ≤ a → N ≤ b →
        Valued.v (henselSeq z b - henselSeq z a) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      intro N a b ha hb
      have ha' : Valued.v (henselSeq z a - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (a - N); rwa [Nat.add_sub_of_le ha] at h1
      have hb' : Valued.v (henselSeq z b - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (b - N); rwa [Nat.add_sub_of_le hb] at h1
      have hsub : henselSeq z b - henselSeq z a =
          (henselSeq z b - henselSeq z N) - (henselSeq z a - henselSeq z N) := by ring
      rw [hsub]
      exact le_trans (Valuation.map_sub _ _ _) (max_le hb' ha')
    have hcauchy : CauchySeq (henselSeq z) := by
      rw [CauchySeq, Valued.cauchy_iff]
      refine ⟨Filter.map_neBot, ?_⟩
      intro γ
      obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp (Units.ne_zero γ)
      let m : ℤ := Multiplicative.toAdd g
      let N : ℕ := (-m).toNat
      have hlt : WithZero.exp (-(N + 1 : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← hg]
        change WithZero.exp (-(N + 1 : ℤ)) < WithZero.exp m
        exact WithZero.exp_lt_exp.mpr (by omega)
      refine ⟨(henselSeq z) '' Set.Ici N, Filter.image_mem_map (Filter.mem_atTop N), ?_⟩
      rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      exact lt_of_le_of_lt (hw_symm N a b ha hb) hlt
    obtain ⟨w_inf, hw_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
    have hw_shift : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds w_inf) :=
      (Filter.tendsto_add_atTop_iff_nat 1).mpr hw_lim
    have hw_rhs : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds (z - w_inf ^ 2)) := by
      have hfun : (fun n => henselSeq z (n + 1)) = (fun n => z - (henselSeq z n) ^ 2) := rfl
      rw [hfun]; exact tendsto_const_nhds.sub (hw_lim.pow 2)
    have hw_eq : w_inf = z - w_inf ^ 2 := tendsto_nhds_unique hw_shift hw_rhs
    refine ⟨1 + 2 * w_inf, ?_⟩
    rw [h1x]
    linear_combination -4 * hw_eq
  
  have h_exists_nonSquare_unit_mod : ∃ ε : NumberField.RingOfIntegers K,
      ε ∉ v₁.asIdeal ∧
      (∀ s : NumberField.RingOfIntegers K, ε - s ^ 2 ∉ v₁.asIdeal) ∧
      (∀ r : NumberField.RingOfIntegers K, r ∉ v₁.asIdeal →
        (∃ s : NumberField.RingOfIntegers K, r - s ^ 2 ∈ v₁.asIdeal) ∨
        (∃ s : NumberField.RingOfIntegers K, r - ε * s ^ 2 ∈ v₁.asIdeal)) := by
    set R := NumberField.RingOfIntegers K
    set F := R ⧸ v₁.asIdeal
    haveI : v₁.asIdeal.IsMaximal := v₁.isMaximal
    letI : Field F := Ideal.Quotient.field v₁.asIdeal
    haveI : Finite F := Ideal.finiteQuotientOfFreeOfNeBot v₁.asIdeal v₁.ne_bot
    have h2_int : v₁.intValuation (2 : R) = 1 := by
      have hval : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (algebraMap R K (2 : R)) =
          v₁.intValuation (2 : R) := v₁.valuation_of_algebraMap (2 : R)
      rw [map_ofNat] at hval
      exact hval.symm.trans hval2
    have h2_notMem : (2 : R) ∉ v₁.asIdeal := v₁.intValuation_eq_one_iff.mp h2_int
    have h2F : (2 : F) ≠ 0 := by
      intro h0; apply h2_notMem; rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact (map_ofNat (Ideal.Quotient.mk v₁.asIdeal) 2).trans h0
    let φ : Fˣ →* Fˣ := powMonoidHom 2
    have hker_iff : ∀ u : Fˣ, u ∈ φ.ker ↔ u = 1 ∨ u = -1 := by
      intro u
      simp only [φ, MonoidHom.mem_ker, powMonoidHom_apply, Units.ext_iff, Units.val_pow_eq_pow_val,
        Units.val_one, sq_eq_one_iff, Units.val_neg]
    have hneg_mem : (-1 : Fˣ) ∈ φ.ker := (hker_iff (-1)).mpr (Or.inr rfl)
    let k_neg : ↥φ.ker := ⟨-1, hneg_mem⟩
    have hk_ne : k_neg ≠ 1 := by
      intro h
      have hval : ((-1 : Fˣ) : F) = ((1 : Fˣ) : F) :=
        congrArg (fun x : ↥φ.ker => ((x : Fˣ) : F)) h
      rw [Units.val_neg, Units.val_one] at hval
      apply h2F; linear_combination -hval
    have hk_uniq : ∀ y : ↥φ.ker, y ≠ 1 → y = k_neg := by
      intro y hy
      rcases (hker_iff y.1).mp y.2 with h1 | hneg
      · exfalso; apply hy; exact Subtype.ext h1
      · exact Subtype.ext hneg
    have hcard_ker : Nat.card ↥φ.ker = 2 :=
      (Nat.card_eq_two_iff' (1 : ↥φ.ker)).mpr ⟨k_neg, hk_ne, hk_uniq⟩
    have hlag1 : Nat.card Fˣ = Nat.card (Fˣ ⧸ φ.ker) * Nat.card ↥φ.ker :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
    have hiso : Nat.card (Fˣ ⧸ φ.ker) = Nat.card ↥φ.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
    have hlag2 : Nat.card Fˣ = Nat.card (Fˣ ⧸ φ.range) * Nat.card ↥φ.range :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup φ.range
    have hpos_range : 0 < Nat.card ↥φ.range := Nat.card_pos
