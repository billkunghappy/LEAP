      chebotarev_density_theorem (K := K) (L := L) (∅ : Set (L ≃ₐ[K] L))
        (by intro ρ hρ; exact False.elim hρ)
    have h_card_empty : Nat.card (∅ : Set (L ≃ₐ[K] L)) = 0 := by
      haveI : IsEmpty (∅ : Set (L ≃ₐ[K] L)) := Subtype.isEmpty_false
      exact Nat.card_of_isEmpty
    have hCheb_empty : Filter.Tendsto (dirichletQuot S_empty)
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
      have h0 : ENNReal.ofReal
          ((Nat.card (∅ : Set (L ≃ₐ[K] L)) : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) = 0 := by
        rw [h_card_empty, Nat.cast_zero, zero_div, ENNReal.ofReal_zero]
      rwa [h0] at hCheb_empty_raw
    haveI : IsScalarTower ℚ K L := IsScalarTower.of_algebraMap_eq' (RingHom.ext_rat _ _)
    haveI : FiniteDimensional K L := FiniteDimensional.right ℚ K L
    haveI : Fintype (L ≃ₐ[K] L) := AlgEquiv.fintype K L
    haveI : Finite (L ≃ₐ[K] L) := Finite.of_fintype (L ≃ₐ[K] L)
    haveI : Finite C := Subtype.finite
    haveI : Nonempty C := hC_nonempty.to_subtype
    haveI : Nonempty (L ≃ₐ[K] L) := ⟨AlgEquiv.refl⟩
    have hC_card_pos : (0 : ℝ) < (Nat.card C : ℝ) :=
      Nat.cast_pos.mpr (@Nat.card_pos C _ _)
    have hGal_card_pos : (0 : ℝ) < (Nat.card (L ≃ₐ[K] L) : ℝ) :=
      Nat.cast_pos.mpr (@Nat.card_pos (L ≃ₐ[K] L) _ _)
    have hd_pos : (0 : ENNReal) <
        ENNReal.ofReal ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) :=
      ENNReal.ofReal_pos.mpr (div_pos hC_card_pos hGal_card_pos)
    by_contra hnot_inf
    have hfin : (S_C \ S_empty).Finite := Set.not_infinite.mp hnot_inf
    let D : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
      S_C \ S_empty
    letI : Fintype D := hfin.fintype
    let w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℝ → ENNReal :=
      fun p s => ENNReal.ofReal
        ((Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) : ℝ) ^ (-s))
    have hw_le_one : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (s : ℝ), 1 < s → w p s ≤ 1 := by
      intro p s hs
      change ENNReal.ofReal
        ((Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) : ℝ) ^ (-s)) ≤ 1
      rw [ENNReal.ofReal_le_one]
      by_cases hn : Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) = 0
      · rw [hn, Nat.cast_zero, Real.zero_rpow (by linarith : -s ≠ 0)]
        exact zero_le_one
      · have hn1 : (1 : ℝ) ≤ (Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) : ℝ) :=
          Nat.one_le_cast.mpr (Nat.one_le_iff_ne_zero.mpr hn)
        exact Real.rpow_le_one_of_one_le_of_nonpos hn1 (by linarith)
    have hD_sum_le : ∀ s : ℝ, 1 < s →
        (∑' p : D, w p.1 s) ≤ (Fintype.card D : ENNReal) := by
      intro s hs
      rw [tsum_fintype]
      calc ∑ p : D, w p.1 s
        _ ≤ ∑ _p : D, (1 : ENNReal) := Finset.sum_le_sum (fun p _ => hw_le_one p.1 s hs)
        _ = (Fintype.card D : ENNReal) := by simp
    have h_ind_le : ∀ (s : ℝ)
        (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        S_C.indicator (fun q => w q s) p ≤
          S_empty.indicator (fun q => w q s) p + D.indicator (fun q => w q s) p := by
      intro s p
      by_cases hpC : p ∈ S_C
      · rw [Set.indicator_of_mem hpC]
        by_cases hp0 : p ∈ S_empty
        · rw [Set.indicator_of_mem hp0]
          exact le_self_add
        · have hpD : p ∈ D := ⟨hpC, hp0⟩
          rw [Set.indicator_of_notMem hp0, Set.indicator_of_mem hpD, zero_add]
      · rw [Set.indicator_of_notMem hpC]
        exact zero_le _
    have h_tsum_le : ∀ s : ℝ, 1 < s →
        (∑' p : S_C, w p.1 s) ≤ (∑' p : S_empty, w p.1 s) + (Fintype.card D : ENNReal) := by
      intro s hs
      have h1 : (∑' p : S_C, w p.1 s) = ∑' p, S_C.indicator (fun q => w q s) p :=
        tsum_subtype S_C (fun q => w q s)
      have h2 : (∑' p : S_empty, w p.1 s) = ∑' p, S_empty.indicator (fun q => w q s) p :=
        tsum_subtype S_empty (fun q => w q s)
      have h3 : (∑' p : D, w p.1 s) = ∑' p, D.indicator (fun q => w q s) p :=
        tsum_subtype D (fun q => w q s)
      calc (∑' p : S_C, w p.1 s)
        _ = ∑' p, S_C.indicator (fun q => w q s) p := h1
        _ ≤ ∑' p, (S_empty.indicator (fun q => w q s) p + D.indicator (fun q => w q s) p) :=
            ENNReal.tsum_le_tsum (h_ind_le s)
        _ = (∑' p, S_empty.indicator (fun q => w q s) p) + (∑' p, D.indicator (fun q => w q s) p) :=
            ENNReal.tsum_add
        _ = (∑' p : S_empty, w p.1 s) + (∑' p : D, w p.1 s) := by rw [← h2, ← h3]
        _ ≤ (∑' p : S_empty, w p.1 s) + (Fintype.card D : ENNReal) :=
            add_le_add_right (hD_sum_le s hs) _
    have h_quot_le : ∀ s ∈ Set.Ioi (1 : ℝ),
        dirichletQuot S_C s ≤
          dirichletQuot S_empty s +
            (Fintype.card D : ENNReal) / ENNReal.ofReal (Real.log (1 / (s - 1))) := by
      intro s hs
      dsimp [dirichletQuot]
      rw [← ENNReal.add_div]
      exact ENNReal.div_le_div_right (h_tsum_le s hs) _
    have h_sub_tendsto : Filter.Tendsto (fun s : ℝ => s - 1)
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhdsWithin (0 : ℝ) (Set.Ioi 0)) := by
      apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
      · have hcont : Continuous (fun s : ℝ => s - 1) := continuous_id.sub continuous_const
        have ht := hcont.tendsto 1
        rw [sub_self] at ht
        exact tendsto_nhdsWithin_of_tendsto_nhds ht
      · filter_upwards [self_mem_nhdsWithin] with s hs
        exact Set.mem_Ioi.mpr (sub_pos.mpr (Set.mem_Ioi.mp hs))
    have h_inv_tendsto : Filter.Tendsto (fun s : ℝ => 1 / (s - 1))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) Filter.atTop := by
      have h_eq : (fun s : ℝ => 1 / (s - 1)) = (fun x : ℝ => x⁻¹) ∘ (fun s : ℝ => s - 1) := by
        ext s
        exact one_div (s - 1)
      rw [h_eq]
      exact tendsto_inv_nhdsGT_zero.comp h_sub_tendsto
    have h_denom_tendsto : Filter.Tendsto
        (fun s : ℝ => ENNReal.ofReal (Real.log (1 / (s - 1))))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds ⊤) :=
      ENNReal.tendsto_ofReal_atTop.comp (Real.tendsto_log_atTop.comp h_inv_tendsto)
    have h_rem_tendsto : Filter.Tendsto
        (fun s : ℝ => (Fintype.card D : ENNReal) / ENNReal.ofReal (Real.log (1 / (s - 1))))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
      have h := ENNReal.Tendsto.const_div h_denom_tendsto
        (Or.inr (ENNReal.natCast_ne_top (Fintype.card D)))
      rwa [ENNReal.div_top] at h
    have h_rhs_tendsto : Filter.Tendsto
        (fun s : ℝ => dirichletQuot S_empty s +
          (Fintype.card D : ENNReal) / ENNReal.ofReal (Real.log (1 / (s - 1))))
        (nhdsWithin (1 : ℝ) (Set.Ioi 1)) (nhds 0) := by
      simpa using hCheb_empty.add h_rem_tendsto
    haveI : (nhdsWithin (1 : ℝ) (Set.Ioi 1)).NeBot := nhdsWithin_Ioi_neBot le_rfl
    have hd_le_zero :
        ENNReal.ofReal ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)) ≤ 0 :=
      le_of_tendsto_of_tendsto hCheb_C h_rhs_tendsto
        (Filter.eventually_of_mem self_mem_nhdsWithin h_quot_le)
    exact (not_le.mpr hd_pos) hd_le_zero
  have h_frob_local : ∀ (w : Kˣ) (α : L), α ^ 2 = algebraMap K L (w : K) →
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          (∃ g : L ≃ₐ[K] L, g ∈ FrobeniusClassAt K L p ∧ g α = -α) ∧
          IsSquare (algebraMap K (p.adicCompletion K) (w : K)) }.Finite := by
    intro w α hα
    classical
    have hex_approx : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (u : v.adicCompletion K), Valued.v u = 1 →
        ∃ r : NumberField.RingOfIntegers K,
          r ∉ v.asIdeal ∧
          Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
      intro v u hu
      have h_nhds : {y : v.adicCompletion K | Valued.v (y - u) < (1 : WithZero (Multiplicative ℤ))} ∈ nhds u := by
        rw [Valued.mem_nhds]
        exact ⟨1, fun y hy => hy⟩
      obtain ⟨x : K, hx_lt⟩ := DenseRange.mem_nhds UniformSpace.Completion.denseRange_coe h_nhds
      change Valued.v (algebraMap K (v.adicCompletion K) x - u) < 1 at hx_lt
      have hu_x_lt : Valued.v (u - algebraMap K (v.adicCompletion K) x) < 1 := by
        rwa [Valuation.map_sub_swap]
      have hx_val_L : Valued.v (algebraMap K (v.adicCompletion K) x) = 1 := by
        have h1 : algebraMap K (v.adicCompletion K) x = u + (algebraMap K (v.adicCompletion K) x - u) := by ring
        have hdist : Valued.v u ≠ Valued.v (algebraMap K (v.adicCompletion K) x - u) := by
          rw [hu]
          exact ne_of_gt hx_lt
        rw [h1, Valuation.map_add_of_distinct_val _ hdist, hu, max_eq_left (le_of_lt hx_lt)]
      have hx_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v) x = 1 := by
        rw [← v.valuedAdicCompletion_eq_valuation' x]
        exact hx_val_L
