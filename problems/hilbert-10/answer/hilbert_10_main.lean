open Polynomial

/-- The polynomial whose adjoined root is denoted by i. -/
noncomputable def gaussianPolynomial (K : Type u) [Ring K] : Polynomial K :=
  X ^ 2 + 1

/--
IsGaussianExtension K L means that L is obtained from K by adjoining
a specified root of X^2 + 1. Thus it is a model of the extension K(i)/K.
-/
abbrev IsGaussianExtension
    (K L : Type u)
    [Field K] [Field L] [Algebra K L] :=
  IsAdjoinRoot L (gaussianPolynomial K)

/--
The cardinal-valued rank of the abelian group of rational points of a
Weierstrass curve over a field.
-/
noncomputable def mordellWeilRank
    {F : Type u} [Field F]
    (E : WeierstrassCurve F) : Cardinal := by
  classical
  exact Module.rank ℤ E.toAffine.Point

noncomputable def realPlaceEmb {K : Type u} [Field K]
    (w : {w : NumberField.InfinitePlace K // w.IsReal}) : K →+* ℝ :=
  NumberField.InfinitePlace.embedding_of_isReal w.2

def selmerStruct (K : Type u) [Field K] [NumberField K] (a₁ a₂ a₃ : K)
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K) :
    Set (SqCl K × SqCl K) :=
  (fun p : Kˣ × Kˣ => (sqCl p.1, sqCl p.2)) ''
    { p : Kˣ × Kˣ |
      (∀ v ∈ T, IsDescentClass
            (algebraMap K (v.adicCompletion K) a₁)
            (algebraMap K (v.adicCompletion K) a₂)
            (algebraMap K (v.adicCompletion K) a₃)
            (algebraMap K (v.adicCompletion K) (p.1 : K))
            (algebraMap K (v.adicCompletion K) (p.2 : K))) ∧
      (∀ w : NumberField.InfinitePlace K, IsDescentClass
            (algebraMap K w.Completion a₁)
            (algebraMap K w.Completion a₂)
            (algebraMap K w.Completion a₃)
            (algebraMap K w.Completion (p.1 : K))
            (algebraMap K w.Completion (p.2 : K))) ∧
      (∀ v ∈ S, RamLocal a₁ a₂ a₃ v (π v) p.1 p.2) ∧
      (∀ v, v ∉ T → v ∉ S → EvenVal v p.1 ∧ EvenVal v p.2) }

def IsStartingTriple (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal}) : Prop :=
  a₁ ≠ a₂ ∧ a₁ ≠ a₃ ∧ a₂ ≠ a₃ ∧
  ¬ IsSquare ((a₁ - a₂) * (a₁ - a₃)) ∧
  ¬ IsSquare (-((a₁ - a₂) * (a₂ - a₃))) ∧
  ¬ IsSquare ((a₁ - a₃) * (a₂ - a₃)) ∧
  IsIntegral ℤ a₁ ∧ IsIntegral ℤ a₂ ∧ IsIntegral ℤ a₃ ∧
  (∀ e₀ e₁ e₂ e₃ : Fin 2,
    IsSquare ((-1 : K) ^ (e₀ : ℕ) * (a₁ - a₂) ^ (e₁ : ℕ) *
      (a₁ - a₃) ^ (e₂ : ℕ) * (a₂ - a₃) ^ (e₃ : ℕ)) →
    e₀ = 0 ∧ e₁ = 0 ∧ e₂ = 0 ∧ e₃ = 0) ∧
  Function.Injective τ ∧
  (realPlaceEmb (τ 0) a₂ < realPlaceEmb (τ 0) a₁ ∧ realPlaceEmb (τ 0) a₁ < realPlaceEmb (τ 0) a₃) ∧
  (realPlaceEmb (τ 1) a₁ < realPlaceEmb (τ 1) a₂ ∧ realPlaceEmb (τ 1) a₂ < realPlaceEmb (τ 1) a₃) ∧
  (realPlaceEmb (τ 2) a₂ < realPlaceEmb (τ 2) a₃ ∧ realPlaceEmb (τ 2) a₃ < realPlaceEmb (τ 2) a₁) ∧
  (realPlaceEmb (τ 3) a₁ < realPlaceEmb (τ 3) a₃ ∧ realPlaceEmb (τ 3) a₃ < realPlaceEmb (τ 3) a₂) ∧
  (realPlaceEmb (τ 4) a₂ < realPlaceEmb (τ 4) a₁ ∧ realPlaceEmb (τ 4) a₁ < realPlaceEmb (τ 4) a₃) ∧
  (realPlaceEmb (τ 5) a₁ < realPlaceEmb (τ 5) a₂ ∧ realPlaceEmb (τ 5) a₂ < realPlaceEmb (τ 5) a₃) ∧
  (realPlaceEmb (τ 6) a₂ < realPlaceEmb (τ 6) a₁ ∧ realPlaceEmb (τ 6) a₁ < realPlaceEmb (τ 6) a₃) ∧
  (realPlaceEmb (τ 7) a₁ < realPlaceEmb (τ 7) a₂ ∧ realPlaceEmb (τ 7) a₂ < realPlaceEmb (τ 7) a₃) ∧
  (realPlaceEmb (τ 8) a₂ < realPlaceEmb (τ 8) a₃ ∧ realPlaceEmb (τ 8) a₃ < realPlaceEmb (τ 8) a₁) ∧
  (realPlaceEmb (τ 9) a₁ < realPlaceEmb (τ 9) a₃ ∧ realPlaceEmb (τ 9) a₃ < realPlaceEmb (τ 9) a₂) ∧
  (realPlaceEmb (τ 10) a₂ < realPlaceEmb (τ 10) a₁ ∧ realPlaceEmb (τ 10) a₁ < realPlaceEmb (τ 10) a₃) ∧
  (realPlaceEmb (τ 11) a₁ < realPlaceEmb (τ 11) a₂ ∧ realPlaceEmb (τ 11) a₂ < realPlaceEmb (τ 11) a₃) ∧
  globalRootNumber (threeRootsCurve a₁ a₂ a₃) = 1

def IsAuxiliaryTwist (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) (z : Fin 6 → Kˣ × Kˣ) : Prop :=
  Disjoint S T ∧
  (∀ v ∈ S, IsLocalUnif v (π v)) ∧
  IsIntegral ℤ (κ : K) ∧
  (∀ v ∈ S, IsDedekindDomain.HeightOneSpectrum.valuation K v (κ : K) = WithZero.exp (-1 : ℤ)) ∧
  (∀ v, v ∉ S → IsDedekindDomain.HeightOneSpectrum.valuation K v (κ : K) = 1) ∧
  0 < realPlaceEmb (τ 0) (κ : K) ∧
  0 < realPlaceEmb (τ 1) (κ : K) ∧
  0 < realPlaceEmb (τ 2) (κ : K) ∧
  realPlaceEmb (τ 3) (κ : K) < 0 ∧
  realPlaceEmb (τ 4) (κ : K) < 0 ∧
  realPlaceEmb (τ 5) (κ : K) < 0 ∧
  (∀ k : Fin 6, (sqCl (z k).1, sqCl (z k).2) ∈ selmerStruct K a₁ a₂ a₃ T S π) ∧
  (∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S → EvenVal v (z k).1 ∧ EvenVal v (z k).2) ∧
  (∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π,
    ∃ I : Finset (Fin 6), c = ∏ k ∈ I, (sqCl (z k).1, sqCl (z k).2)) ∧
  (∀ k j : Fin 6, Even k.1 →
    (realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).1 : K) < 0 ↔ j = k) ∧
    0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).2 : K)) ∧
  (∀ k j : Fin 6, Odd k.1 →
    0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).1 : K) ∧
    (realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).2 : K) < 0 ↔ j = k))

def IsSuitableTwist (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (t : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  Disjoint S T ∧
  𝔮₁ ∉ T ∧ 𝔮₁ ∉ S ∧
  𝔮₂ ∉ T ∧ 𝔮₂ ∉ S ∧
  𝔮₃ ∉ T ∧ 𝔮₃ ∉ S ∧
  𝔮₄ ∉ T ∧ 𝔮₄ ∉ S ∧
  𝔮₁ ≠ 𝔮₂ ∧ 𝔮₁ ≠ 𝔮₃ ∧ 𝔮₁ ≠ 𝔮₄ ∧ 𝔮₂ ≠ 𝔮₃ ∧ 𝔮₂ ≠ 𝔮₄ ∧ 𝔮₃ ≠ 𝔮₄ ∧
  (∀ v ∈ T, IsSquare (algebraMap K (v.adicCompletion K) (t : K))) ∧
  (∀ w : NumberField.InfinitePlace K, IsSquare (algebraMap K w.Completion (t : K))) ∧
  (∀ v, (v ∈ S ∨ v = 𝔮₁ ∨ v = 𝔮₂ ∨ v = 𝔮₃ ∨ v = 𝔮₄) →
    IsLocalUnif v (algebraMap K (v.adicCompletion K) (t : K))) ∧
  (∀ v, v ∉ T → v ∉ S → v ≠ 𝔮₁ → v ≠ 𝔮₂ → v ≠ 𝔮₃ → v ≠ 𝔮₄ → EvenVal v t) ∧
  (∀ k : Fin 6,
    (sqCl (z k).1, sqCl (z k).2) ∈
      selmerStruct K a₁ a₂ a₃ T S (fun v => algebraMap K (v.adicCompletion K) (t : K))) ∧
  (∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S → EvenVal v (z k).1 ∧ EvenVal v (z k).2) ∧
  (∀ c ∈ selmerStruct K a₁ a₂ a₃ T S (fun v => algebraMap K (v.adicCompletion K) (t : K)),
    ∃ I : Finset (Fin 6), c = ∏ k ∈ I, (sqCl (z k).1, sqCl (z k).2)) ∧
  ¬ IsSquare (algebraMap K (𝔮₁.adicCompletion K) ((z 0).1 : K)) ∧
  IsSquare (algebraMap K (𝔮₁.adicCompletion K) ((z 0).2 : K)) ∧
  IsSquare (algebraMap K (𝔮₁.adicCompletion K) ((z 1).1 : K)) ∧
  ¬ IsSquare (algebraMap K (𝔮₁.adicCompletion K) ((z 1).2 : K)) ∧
  (∀ k : Fin 6, k ≠ 0 → k ≠ 1 →
    IsSquare (algebraMap K (𝔮₁.adicCompletion K) ((z k).1 : K)) ∧
    IsSquare (algebraMap K (𝔮₁.adicCompletion K) ((z k).2 : K))) ∧
  ¬ IsSquare (algebraMap K (𝔮₂.adicCompletion K) ((z 2).1 : K)) ∧
  IsSquare (algebraMap K (𝔮₂.adicCompletion K) ((z 2).2 : K)) ∧
  IsSquare (algebraMap K (𝔮₂.adicCompletion K) ((z 3).1 : K)) ∧
  ¬ IsSquare (algebraMap K (𝔮₂.adicCompletion K) ((z 3).2 : K)) ∧
  (∀ k : Fin 6, k ≠ 0 → k ≠ 1 → k ≠ 2 → k ≠ 3 →
    IsSquare (algebraMap K (𝔮₂.adicCompletion K) ((z k).1 : K)) ∧
    IsSquare (algebraMap K (𝔮₂.adicCompletion K) ((z k).2 : K))) ∧
  ¬ IsSquare (algebraMap K (𝔮₃.adicCompletion K) ((z 4).1 : K)) ∧
  IsSquare (algebraMap K (𝔮₃.adicCompletion K) ((z 4).2 : K)) ∧
  IsSquare (algebraMap K (𝔮₃.adicCompletion K) ((z 5).1 : K)) ∧
  ¬ IsSquare (algebraMap K (𝔮₃.adicCompletion K) ((z 5).2 : K))
def dupNum {F : Type*} [CommRing F] (a₁ a₂ a₃ u : F) : F :=
  let s₁ := a₁ + a₂ + a₃
  let s₂ := a₁ * a₂ + a₁ * a₃ + a₂ * a₃
  let s₃ := a₁ * a₂ * a₃
  u ^ 4 - 2 * s₂ * u ^ 2 - 8 * s₃ * u + s₂ ^ 2 - 4 * s₁ * s₃

def dupDen {F : Type*} [CommRing F] (a₁ a₂ a₃ u : F) : F :=
  4 * (u + a₁) * (u + a₂) * (u + a₃)

noncomputable def dupMap {F : Type*} [Field F] (a₁ a₂ a₃ u : F) : F :=
  dupNum a₁ a₂ a₃ u / dupDen a₁ a₂ a₃ u
noncomputable def kaiCoordX {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (z : Fin (2 * Module.finrank ℚ K) → ℤ) : NumberField.RingOfIntegers K :=
  ∑ r : Fin (Module.finrank ℚ K), z ⟨r.1, by omega⟩ • ω r

noncomputable def kaiCoordY {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (z : Fin (2 * Module.finrank ℚ K) → ℤ) : NumberField.RingOfIntegers K :=
  ∑ r : Fin (Module.finrank ℚ K), z ⟨Module.finrank ℚ K + r.1, by omega⟩ • ω r

def suitC0 {K : Type u} [Field K] [NumberField K]
    (a₁ a₂ a₃ μ l : NumberField.RingOfIntegers K) : Fin 4 → NumberField.RingOfIntegers K
  | ⟨0, _⟩ => 1 + a₁ * μ * l
  | ⟨1, _⟩ => 1 + a₂ * μ * l
  | ⟨2, _⟩ => 1 + a₃ * μ * l
  | ⟨3, _⟩ => l

noncomputable def suitC {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (a₁ a₂ a₃ μ : NumberField.RingOfIntegers K) :
    Fin 4 → Fin (2 * Module.finrank ℚ K) → NumberField.RingOfIntegers K
  | ⟨0, _⟩, k =>
      if h : k.1 < Module.finrank ℚ K then μ * ω ⟨k.1, h⟩
      else a₁ * μ ^ 2 * ω ⟨k.1 - Module.finrank ℚ K, by omega⟩
  | ⟨1, _⟩, k =>
      if h : k.1 < Module.finrank ℚ K then μ * ω ⟨k.1, h⟩
      else a₂ * μ ^ 2 * ω ⟨k.1 - Module.finrank ℚ K, by omega⟩
  | ⟨2, _⟩, k =>
      if h : k.1 < Module.finrank ℚ K then μ * ω ⟨k.1, h⟩
      else a₃ * μ ^ 2 * ω ⟨k.1 - Module.finrank ℚ K, by omega⟩
  | ⟨3, _⟩, k =>
      if h : k.1 < Module.finrank ℚ K then 0
      else μ * ω ⟨k.1 - Module.finrank ℚ K, by omega⟩

noncomputable def realAffEval {K : Type u} [Field K] [NumberField K] {d : ℕ}
    (w : {w : NumberField.InfinitePlace K // w.IsReal})
    (c₀ : NumberField.RingOfIntegers K) (c : Fin d → NumberField.RingOfIntegers K)
    (z : Fin d → ℝ) : ℝ :=
  realPlaceEmb w (c₀ : K) + ∑ k : Fin d, z k * realPlaceEmb w (c k : K)

def suitCone {K : Type u} [Field K] [NumberField K] {d : ℕ}
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal}) (κ : K)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) : Set (Fin d → ℝ) :=
  { z : Fin d → ℝ |
    (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (∀ j : Fin 6, w ≠ τ ⟨j.1, by omega⟩) →
        0 < realAffEval w (c₀ 0) (c 0) z ∧
        0 < realAffEval w (c₀ 1) (c 1) z ∧
        0 < realAffEval w (c₀ 2) (c 2) z ∧
        0 < realPlaceEmb w κ * realAffEval w (c₀ 3) (c 3) z) ∧
    (∀ j : Fin 6, 0 < realAffEval (τ ⟨j.1, by omega⟩) (c₀ 3) (c 3) z) ∧
    realAffEval (τ 0) (c₀ 0) (c 0) z < 0 ∧
    realAffEval (τ 0) (c₀ 1) (c 1) z < 0 ∧
    0 < realAffEval (τ 0) (c₀ 2) (c 2) z ∧
    realAffEval (τ 1) (c₀ 0) (c 0) z < 0 ∧
    realAffEval (τ 1) (c₀ 1) (c 1) z < 0 ∧
    0 < realAffEval (τ 1) (c₀ 2) (c 2) z ∧
    0 < realAffEval (τ 2) (c₀ 0) (c 0) z ∧
    realAffEval (τ 2) (c₀ 1) (c 1) z < 0 ∧
    realAffEval (τ 2) (c₀ 2) (c 2) z < 0 ∧
    0 < realAffEval (τ 3) (c₀ 0) (c 0) z ∧
    realAffEval (τ 3) (c₀ 1) (c 1) z < 0 ∧
    0 < realAffEval (τ 3) (c₀ 2) (c 2) z ∧
    0 < realAffEval (τ 4) (c₀ 0) (c 0) z ∧
    0 < realAffEval (τ 4) (c₀ 1) (c 1) z ∧
    realAffEval (τ 4) (c₀ 2) (c 2) z < 0 ∧
    0 < realAffEval (τ 5) (c₀ 0) (c 0) z ∧
    0 < realAffEval (τ 5) (c₀ 1) (c 1) z ∧
    realAffEval (τ 5) (c₀ 2) (c 2) z < 0 }

def IsTwistModulusAndOffset {K : Type u} [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) (bad : Set (SqCl K))
    (a₁_int a₂_int a₃_int κ_int m l : NumberField.RingOfIntegers K) : Prop :=
  (a₁_int : K) = a₁ ∧ (a₂_int : K) = a₂ ∧ (a₃_int : K) = a₃ ∧ (κ_int : K) = (κ : K) ∧
  (m : K) ≠ 0 ∧
  l * κ_int - 1 ∈ Ideal.span {m ^ 2} ∧
  (∀ v ∈ T, m ∈ v.asIdeal) ∧
  (∀ v ∈ S, m ∉ v.asIdeal ∧ l ∉ v.asIdeal) ∧
  (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    m ^ 2 * κ_int ∈ v.asIdeal → l ∉ v.asIdeal) ∧
  (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    m ^ 2 * κ_int ∉ v.asIdeal →
      (6 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧
      (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int) ∉ v.asIdeal) ∧
  (∀ u : NumberField.RingOfIntegers K, u - 1 ∈ Ideal.span {m ^ 2} →
    ∀ v ∈ T, IsSquare (algebraMap K (v.adicCompletion K) (u : K))) ∧
  (∀ u : NumberField.RingOfIntegers K, u - 1 ∈ Ideal.span {m ^ 2 * κ_int} →
    ∀ v ∈ S, IsSquare (algebraMap K (v.adicCompletion K) (u : K))) ∧
  (∀ u : NumberField.RingOfIntegers K, u - l ∈ Ideal.span {m ^ 2 * κ_int} →
    ∀ v ∈ S, IsSquare (π v * algebraMap K (v.adicCompletion K) ((κ : K) * (u : K)))) ∧
  (∀ b ∈ bad, ∃ u_b : Kˣ, sqCl u_b = b ∧
    ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      m ^ 2 * κ_int ∉ v.asIdeal → EvenVal v u_b)

def IsPrimeQuadrupleInCone {K : Type u} [Field K] [NumberField K] {d : ℕ}
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (Ω₀ : Set (Fin d → ℝ))
    (z_lat : Fin d → ℤ)
    (𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  (fun k => ((z_lat k : ℤ) : ℝ)) ∈ Ω₀ ∧
  Ideal.span {affEval (c₀ 0) (c 0) z_lat} = 𝔮₁.asIdeal ∧
  Ideal.span {affEval (c₀ 1) (c 1) z_lat} = 𝔮₂.asIdeal ∧
  Ideal.span {affEval (c₀ 2) (c 2) z_lat} = 𝔮₃.asIdeal ∧
  Ideal.span {affEval (c₀ 3) (c 3) z_lat} = 𝔮₄.asIdeal ∧
  𝔮₁ ≠ 𝔮₂ ∧ 𝔮₁ ≠ 𝔮₃ ∧ 𝔮₁ ≠ 𝔮₄ ∧ 𝔮₂ ≠ 𝔮₃ ∧ 𝔮₂ ≠ 𝔮₄ ∧ 𝔮₃ ≠ 𝔮₄
def IsPrincipalPrimeSet (K : Type u) [Field K] [NumberField K]
    (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (κ : Kˣ) : Prop :=
  IsIntegral ℤ (κ : K) ∧
  (∀ v ∈ S, IsDedekindDomain.HeightOneSpectrum.valuation K v (κ : K) = WithZero.exp (-1 : ℤ)) ∧
  (∀ v, v ∉ S → IsDedekindDomain.HeightOneSpectrum.valuation K v (κ : K) = 1)

def IsRankZeroSelmerState (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) : Prop :=
  Disjoint S T ∧
  (∀ v ∈ S, IsLocalUnif v (π v)) ∧
  IsPrincipalPrimeSet K S κ ∧
  (∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c = 1)

def IsCleanSelmerState (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) : Prop :=
  IsRankZeroSelmerState K a₁ a₂ a₃ T S π κ ∧
  (∀ x : Kˣ, (∀ v ∈ S, RamLocal a₁ a₂ a₃ v (π v) x x) →
    (∀ v, v ∉ T → v ∉ S → EvenVal v x) → sqCl x = 1) ∧
  (∀ x : Kˣ, (∀ v ∈ S, RamLocal a₁ a₂ a₃ v (π v) x 1) →
    (∀ v, v ∉ T → v ∉ S → EvenVal v x) → sqCl x = 1) ∧
  (∀ x : Kˣ, (∀ v ∈ S, RamLocal a₁ a₂ a₃ v (π v) 1 x) →
    (∀ v, v ∉ T → v ∉ S → EvenVal v x) → sqCl x = 1)

def IsAuxiliaryPrimeState (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  IsRankZeroSelmerState K a₁ a₂ a₃ T S π κ ∧
  Function.Injective 𝔭 ∧
  (∀ k : Fin 6, 𝔭 k ∈ S) ∧
  (∀ k : Fin 6, IsIntegral ℤ (p k : K)) ∧
  (∀ k : Fin 6, IsDedekindDomain.HeightOneSpectrum.valuation K (𝔭 k) (p k : K) = WithZero.exp (-1 : ℤ)) ∧
  (∀ k : Fin 6, ∀ v, v ≠ 𝔭 k → IsDedekindDomain.HeightOneSpectrum.valuation K v (p k : K) = 1) ∧
  (∀ k j : Fin 6, realPlaceEmb (τ ⟨j.1, by omega⟩) (p k : K) < 0 ↔ j = k) ∧
  (∀ k j : Fin 6, realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) (p k : K) < 0 ↔ j = k) ∧
  (∀ k : Fin 6, ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
    (∀ i : Fin 12, w ≠ τ i) → 0 < realPlaceEmb w (p k : K)) ∧
  (∀ k : Fin 6, ∀ v ∈ T, IsSquare (algebraMap K (v.adicCompletion K) (p k : K))) ∧
  (∀ k : Fin 6, ∀ v ∈ S, (∀ i : Fin 6, v ≠ 𝔭 i) →
    IsSquare (algebraMap K (v.adicCompletion K) (p k : K))) ∧
  (∀ i j : Fin 6, i ≠ j →
    (IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (p j : K)) ↔
      ¬ ((i.1 = 0 ∧ j.1 = 1) ∨ (i.1 = 1 ∧ j.1 = 0) ∨
         (i.1 = 2 ∧ j.1 = 3) ∨ (i.1 = 3 ∧ j.1 = 2) ∨
         (i.1 = 4 ∧ j.1 = 5) ∨ (i.1 = 5 ∧ j.1 = 4)))) ∧
  (∀ k : Fin 6, ∀ u : Kˣ,
    IsDedekindDomain.HeightOneSpectrum.valuation K (𝔭 k) (u : K) = 1 →
    ¬ IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (u : K)) →
    RamLocal a₁ a₂ a₃ (𝔭 k) (π (𝔭 k)) (p k * u) 1 ∧
    RamLocal a₁ a₂ a₃ (𝔭 k) (π (𝔭 k)) 1 (p k * u))
def HasStartingOrderings (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal}) : Prop :=
  (realPlaceEmb (τ 0) a₂ < realPlaceEmb (τ 0) a₁ ∧ realPlaceEmb (τ 0) a₁ < realPlaceEmb (τ 0) a₃) ∧
  (realPlaceEmb (τ 1) a₁ < realPlaceEmb (τ 1) a₂ ∧ realPlaceEmb (τ 1) a₂ < realPlaceEmb (τ 1) a₃) ∧
  (realPlaceEmb (τ 2) a₂ < realPlaceEmb (τ 2) a₃ ∧ realPlaceEmb (τ 2) a₃ < realPlaceEmb (τ 2) a₁) ∧
  (realPlaceEmb (τ 3) a₁ < realPlaceEmb (τ 3) a₃ ∧ realPlaceEmb (τ 3) a₃ < realPlaceEmb (τ 3) a₂) ∧
  (realPlaceEmb (τ 4) a₂ < realPlaceEmb (τ 4) a₁ ∧ realPlaceEmb (τ 4) a₁ < realPlaceEmb (τ 4) a₃) ∧
  (realPlaceEmb (τ 5) a₁ < realPlaceEmb (τ 5) a₂ ∧ realPlaceEmb (τ 5) a₂ < realPlaceEmb (τ 5) a₃) ∧
  (realPlaceEmb (τ 6) a₂ < realPlaceEmb (τ 6) a₁ ∧ realPlaceEmb (τ 6) a₁ < realPlaceEmb (τ 6) a₃) ∧
  (realPlaceEmb (τ 7) a₁ < realPlaceEmb (τ 7) a₂ ∧ realPlaceEmb (τ 7) a₂ < realPlaceEmb (τ 7) a₃) ∧
  (realPlaceEmb (τ 8) a₂ < realPlaceEmb (τ 8) a₃ ∧ realPlaceEmb (τ 8) a₃ < realPlaceEmb (τ 8) a₁) ∧
  (realPlaceEmb (τ 9) a₁ < realPlaceEmb (τ 9) a₃ ∧ realPlaceEmb (τ 9) a₃ < realPlaceEmb (τ 9) a₂) ∧
  (realPlaceEmb (τ 10) a₂ < realPlaceEmb (τ 10) a₁ ∧ realPlaceEmb (τ 10) a₁ < realPlaceEmb (τ 10) a₃) ∧
  (realPlaceEmb (τ 11) a₁ < realPlaceEmb (τ 11) a₂ ∧ realPlaceEmb (τ 11) a₂ < realPlaceEmb (τ 11) a₃)
def InStartingSpan (K : Type u) [Field K] (a₁ a₂ a₃ : K) (x : Kˣ) : Prop :=
  ∃ e₀ e₁ e₂ e₃ : Fin 2,
    IsSquare ((x : K) * (-1 : K) ^ (e₀ : ℕ) * (a₁ - a₂) ^ (e₁ : ℕ) *
      (a₁ - a₃) ^ (e₂ : ℕ) * (a₂ - a₃) ^ (e₃ : ℕ))

def SqClIndep4 (K : Type u) [Field K] (w₁ w₂ w₃ w₄ : Kˣ) : Prop :=
  ∀ e₁ e₂ e₃ e₄ : Fin 2,
    IsSquare ((w₁ : K) ^ (e₁ : ℕ) * (w₂ : K) ^ (e₂ : ℕ) *
      (w₃ : K) ^ (e₃ : ℕ) * (w₄ : K) ^ (e₄ : ℕ)) →
    e₁ = 0 ∧ e₂ = 0 ∧ e₃ = 0 ∧ e₄ = 0

def HasPrincipalNonSquareExtension (K : Type u) [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) : Prop :=
  ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (κ : Kˣ) (w₁ w₂ w₃ w₄ : Kˣ),
    Disjoint S T →
    IsPrincipalPrimeSet K S κ →
    SqClIndep4 K w₁ w₂ w₃ w₄ →
    ∃ (S' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (κ' : Kˣ)
      (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      S ⊆ S' ∧
      Disjoint S' T ∧
      IsPrincipalPrimeSet K S' κ' ∧
      v₀ ∈ S' ∧ v₀ ∉ S ∧
      (∀ v ∈ S', v ∉ S →
        ¬ IsSquare (algebraMap K (v.adicCompletion K) (w₁ : K)) ∧
        ¬ IsSquare (algebraMap K (v.adicCompletion K) (w₂ : K)) ∧
        ¬ IsSquare (algebraMap K (v.adicCompletion K) (w₃ : K)) ∧
        ¬ IsSquare (algebraMap K (v.adicCompletion K) (w₄ : K)))
def IsLocalMulClosed (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K) : Prop :=
  (∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
     (x₁ x₂ y₁ y₂ : Kˣ),
    IsDescentClass
      (algebraMap K (v.adicCompletion K) a₁)
      (algebraMap K (v.adicCompletion K) a₂)
      (algebraMap K (v.adicCompletion K) a₃)
      (algebraMap K (v.adicCompletion K) (x₁ : K))
      (algebraMap K (v.adicCompletion K) (x₂ : K)) →
    IsDescentClass
      (algebraMap K (v.adicCompletion K) a₁)
      (algebraMap K (v.adicCompletion K) a₂)
      (algebraMap K (v.adicCompletion K) a₃)
      (algebraMap K (v.adicCompletion K) (y₁ : K))
      (algebraMap K (v.adicCompletion K) (y₂ : K)) →
    IsDescentClass
      (algebraMap K (v.adicCompletion K) a₁)
      (algebraMap K (v.adicCompletion K) a₂)
      (algebraMap K (v.adicCompletion K) a₃)
      (algebraMap K (v.adicCompletion K) ((x₁ * y₁ : Kˣ) : K))
      (algebraMap K (v.adicCompletion K) ((x₂ * y₂ : Kˣ) : K))) ∧
  (∀ (w : NumberField.InfinitePlace K) (x₁ x₂ y₁ y₂ : Kˣ),
    IsDescentClass
      (algebraMap K w.Completion a₁)
      (algebraMap K w.Completion a₂)
      (algebraMap K w.Completion a₃)
      (algebraMap K w.Completion (x₁ : K))
      (algebraMap K w.Completion (x₂ : K)) →
    IsDescentClass
      (algebraMap K w.Completion a₁)
      (algebraMap K w.Completion a₂)
      (algebraMap K w.Completion a₃)
      (algebraMap K w.Completion (y₁ : K))
      (algebraMap K w.Completion (y₂ : K)) →
    IsDescentClass
      (algebraMap K w.Completion a₁)
      (algebraMap K w.Completion a₂)
      (algebraMap K w.Completion a₃)
      (algebraMap K w.Completion ((x₁ * y₁ : Kˣ) : K))
      (algebraMap K w.Completion ((x₂ * y₂ : Kˣ) : K))) ∧
  (∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
     (π_v : v.adicCompletion K) (x₁ x₂ y₁ y₂ : Kˣ),
    IsLocalUnif v π_v →
    RamLocal a₁ a₂ a₃ v π_v x₁ x₂ →
    RamLocal a₁ a₂ a₃ v π_v y₁ y₂ →
    RamLocal a₁ a₂ a₃ v π_v (x₁ * y₁) (x₂ * y₂))

def IsBasisPrimeTuple (K : Type u) [Field K] [NumberField K]
    (T S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : Fin 3 → Kˣ)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  Function.Injective 𝔮 ∧
  (∀ j : Fin 3, 𝔮 j ∉ T ∧ 𝔮 j ∉ S₃) ∧
  (∀ j : Fin 3, IsIntegral ℤ (q j : K)) ∧
  (∀ j : Fin 3, IsDedekindDomain.HeightOneSpectrum.valuation K (𝔮 j) (q j : K) = WithZero.exp (-1 : ℤ)) ∧
  (∀ j : Fin 3, ∀ v, v ≠ 𝔮 j → IsDedekindDomain.HeightOneSpectrum.valuation K v (q j : K) = 1) ∧
  (∀ j : Fin 3, ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, 0 < realPlaceEmb w (q j : K)) ∧
  (∀ j : Fin 3, ∀ v ∈ T, IsSquare (algebraMap K (v.adicCompletion K) (q j : K))) ∧
  (∀ j : Fin 3, ∀ v ∈ S₃, (∀ i : Fin 6, v ≠ 𝔭 i) →
    IsSquare (algebraMap K (v.adicCompletion K) (q j : K))) ∧
  (∀ i : Fin 6, ∀ j : Fin 3,
    (IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (q j : K)) ↔ i.1 / 2 ≠ j.1)) ∧
  (∀ j : Fin 3,
    IsSquare (algebraMap K ((𝔭 ⟨2 * j.1, by omega⟩).adicCompletion K)
      ((p ⟨2 * j.1 + 1, by omega⟩ : K) * (q j : K))) ∧
    IsSquare (algebraMap K ((𝔭 ⟨2 * j.1 + 1, by omega⟩).adicCompletion K)
      ((p ⟨2 * j.1, by omega⟩ : K) * (q j : K)))) ∧
  (∀ j₁ j₂ : Fin 3, j₁.1 < j₂.1 →
    IsSquare (algebraMap K ((𝔮 j₁).adicCompletion K) (q j₂ : K)))

def IsBasisPrimeReciprocity (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (p : Fin 6 → Kˣ)
    (q : Fin 3 → Kˣ)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  (∀ i : Fin 6, ∀ j : Fin 3,
    (IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (p i : K)) ↔ i.1 / 2 ≠ j.1)) ∧
  (∀ j : Fin 3,
    IsSquare (algebraMap K ((𝔮 j).adicCompletion K)
      ((p ⟨2 * j.1, by omega⟩ : K) * (p ⟨2 * j.1 + 1, by omega⟩ : K)))) ∧
  (∀ j₁ j₂ : Fin 3, j₁ ≠ j₂ →
    IsSquare (algebraMap K ((𝔮 j₁).adicCompletion K) (q j₂ : K))) ∧
  (∀ j : Fin 3,
    IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (-1 : K)) ∧
    IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (a₁ - a₂)) ∧
    IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (a₁ - a₃)) ∧
    IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (a₂ - a₃)))

def IsPreAuxiliaryTwist (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₄ : Kˣ) (z : Fin 6 → Kˣ × Kˣ) : Prop :=
  Disjoint S₄ T ∧
  (∀ v ∈ S₄, IsLocalUnif v (π₄ v)) ∧
  IsPrincipalPrimeSet K S₄ κ₄ ∧
  (∀ k : Fin 6, (sqCl (z k).1, sqCl (z k).2) ∈ selmerStruct K a₁ a₂ a₃ T S₄ π₄) ∧
  (∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S₄ →
    IsDedekindDomain.HeightOneSpectrum.valuation K v ((z k).1 : K) = 1 ∧
    IsDedekindDomain.HeightOneSpectrum.valuation K v ((z k).2 : K) = 1) ∧
  (∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S₄ → EvenVal v (z k).1 ∧ EvenVal v (z k).2) ∧
  (∀ c ∈ selmerStruct K a₁ a₂ a₃ T S₄ π₄,
    ∃ I : Finset (Fin 6), c = ∏ k ∈ I, (sqCl (z k).1, sqCl (z k).2)) ∧
  (∀ k j : Fin 6, Even k.1 →
    (realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).1 : K) < 0 ↔ j = k) ∧
    0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).2 : K) ∧
    (realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((z k).1 : K) < 0 ↔ j = k) ∧
    0 < realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((z k).2 : K)) ∧
  (∀ k j : Fin 6, Odd k.1 →
    0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).1 : K) ∧
    (realPlaceEmb (τ ⟨j.1, by omega⟩) ((z k).2 : K) < 0 ↔ j = k) ∧
    0 < realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((z k).1 : K) ∧
    (realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((z k).2 : K) < 0 ↔ j = k))

def IsFinalSignPrime (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (κ₄ : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (p_last : Kˣ)
    (𝔭_last : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  𝔭_last ∉ T ∧ 𝔭_last ∉ S₄ ∧
  IsIntegral ℤ (p_last : K) ∧
  (∃ π_int : NumberField.RingOfIntegers K, (π_int : K) = (p_last : K) ∧
    Ideal.span {π_int} = 𝔭_last.asIdeal) ∧
  IsDedekindDomain.HeightOneSpectrum.valuation K 𝔭_last (p_last : K) = WithZero.exp (-1 : ℤ) ∧
  (∀ v, v ≠ 𝔭_last → IsDedekindDomain.HeightOneSpectrum.valuation K v (p_last : K) = 1) ∧
  0 < realPlaceEmb (τ 0) ((κ₄ * p_last : Kˣ) : K) ∧
  0 < realPlaceEmb (τ 1) ((κ₄ * p_last : Kˣ) : K) ∧
  0 < realPlaceEmb (τ 2) ((κ₄ * p_last : Kˣ) : K) ∧
  realPlaceEmb (τ 3) ((κ₄ * p_last : Kˣ) : K) < 0 ∧
  realPlaceEmb (τ 4) ((κ₄ * p_last : Kˣ) : K) < 0 ∧
  realPlaceEmb (τ 5) ((κ₄ * p_last : Kˣ) : K) < 0 ∧
  (∀ k : Fin 6,
    IsSquare (algebraMap K (𝔭_last.adicCompletion K) ((z k).1 : K)) ∧
    IsSquare (algebraMap K (𝔭_last.adicCompletion K) ((z k).2 : K))) ∧
  IsSquare (algebraMap K (𝔭_last.adicCompletion K) (-1 : K)) ∧
  IsSquare (algebraMap K (𝔭_last.adicCompletion K) (a₁ - a₂)) ∧
  IsSquare (algebraMap K (𝔭_last.adicCompletion K) (a₁ - a₃)) ∧
  IsSquare (algebraMap K (𝔭_last.adicCompletion K) (a₂ - a₃))
def henselSeq {R : Type*} [Ring R] (z : R) : ℕ → R
  | 0 => 0
  | n + 1 => z - (henselSeq z n) ^ 2
noncomputable def kaiLift {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (X Y : NumberField.RingOfIntegers K) : Fin (2 * Module.finrank ℚ K) → ℤ :=
  fun k =>
    if h : k.1 < Module.finrank ℚ K then ω.repr X ⟨k.1, h⟩
    else ω.repr Y ⟨k.1 - Module.finrank ℚ K, by omega⟩
def IsLocalPivotUnif (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (v₁ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (π_u : Kˣ) : Prop :=
  IsLocalUnif v₁ (algebraMap K (v₁.adicCompletion K) (π_u : K)) ∧
  ¬ EvenVal v₁ π_u ∧
  (∀ u : Kˣ,
    ((u : K) = -1 ∨ (u : K) = a₁ - a₂ ∨ (u : K) = a₁ - a₃ ∨ (u : K) = a₂ - a₃) →
    EvenVal v₁ u) ∧
  (∀ z : Kˣ, IsSquare (algebraMap K (v₁.adicCompletion K) (z : K)) → EvenVal v₁ z) ∧
  (∀ x y : Kˣ, EvenVal v₁ (x * y) ↔ (EvenVal v₁ x ↔ EvenVal v₁ y)) ∧
  (∀ x₁ x₂ : Kˣ, EvenVal v₁ x₁ → EvenVal v₁ x₂ →
    (RamLocal a₁ a₂ a₃ v₁ (algebraMap K (v₁.adicCompletion K) (π_u : K)) x₁ x₂ ↔
      IsSquare (algebraMap K (v₁.adicCompletion K) (x₁ : K)) ∧
      IsSquare (algebraMap K (v₁.adicCompletion K) (x₂ : K)))) ∧
  (∀ x y : Kˣ, EvenVal v₁ x → EvenVal v₁ y →
    (IsSquare (algebraMap K (v₁.adicCompletion K) ((x * y : Kˣ) : K)) ↔
      (IsSquare (algebraMap K (v₁.adicCompletion K) (x : K)) ↔
       IsSquare (algebraMap K (v₁.adicCompletion K) (y : K))))) ∧
  (∀ a b : Kˣ, EvenVal v₁ a → EvenVal v₁ b →
    hilbFin v₁ (a : K) (b : K) = 1) ∧
  (∀ a b : Kˣ, EvenVal v₁ a → ¬ EvenVal v₁ b →
    (hilbFin v₁ (a : K) (b : K) = 1 ↔
      IsSquare (algebraMap K (v₁.adicCompletion K) (a : K))) ∧
    (hilbFin v₁ (b : K) (a : K) = 1 ↔
      IsSquare (algebraMap K (v₁.adicCompletion K) (a : K)))) ∧
  (∀ a b : Kˣ, ¬ EvenVal v₁ a → ¬ EvenVal v₁ b →
    (hilbFin v₁ (a : K) (b : K) = 1 ↔
      IsSquare (algebraMap K (v₁.adicCompletion K) ((-a * b : Kˣ) : K))))
def IsRawAuxiliaryPrimeTuple (K : Type u) [Field K] [NumberField K]
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  Function.Injective 𝔭 ∧
  (∀ k : Fin 6, 𝔭 k ∉ T ∧ 𝔭 k ∉ S₂) ∧
  (∀ k : Fin 6, IsIntegral ℤ (p k : K)) ∧
  (∀ k : Fin 6, IsDedekindDomain.HeightOneSpectrum.valuation K (𝔭 k) (p k : K) = WithZero.exp (-1 : ℤ)) ∧
  (∀ k : Fin 6, ∀ v, v ≠ 𝔭 k → IsDedekindDomain.HeightOneSpectrum.valuation K v (p k : K) = 1) ∧
  (∀ k j : Fin 6, realPlaceEmb (τ ⟨j.1, by omega⟩) (p k : K) < 0 ↔ j = k) ∧
  (∀ k j : Fin 6, realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) (p k : K) < 0 ↔ j = k) ∧
  (∀ k : Fin 6, ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
    (∀ i : Fin 12, w ≠ τ i) → 0 < realPlaceEmb w (p k : K)) ∧
  (∀ k : Fin 6, ∀ v ∈ T, IsSquare (algebraMap K (v.adicCompletion K) (p k : K))) ∧
  (∀ k : Fin 6, ∀ v ∈ S₂, IsSquare (algebraMap K (v.adicCompletion K) (p k : K))) ∧
  (∀ i j : Fin 6, i.1 < j.1 →
    (IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (p j : K)) ↔
      ¬ ((i.1 = 0 ∧ j.1 = 1) ∨ (i.1 = 2 ∧ j.1 = 3) ∨ (i.1 = 4 ∧ j.1 = 5))))

def IsAuxPrimeReciprocity (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  (∀ i j : Fin 6, i ≠ j →
    (IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (p j : K)) ↔
      ¬ ((i.1 = 0 ∧ j.1 = 1) ∨ (i.1 = 1 ∧ j.1 = 0) ∨
         (i.1 = 2 ∧ j.1 = 3) ∨ (i.1 = 3 ∧ j.1 = 2) ∨
         (i.1 = 4 ∧ j.1 = 5) ∨ (i.1 = 5 ∧ j.1 = 4)))) ∧
  (∀ k : Fin 6,
    IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (-1 : K)) ∧
    IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (a₁ - a₂)) ∧
    IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (a₁ - a₃)) ∧
    IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (a₂ - a₃)))

def NotInAuxSpan (K : Type u) [Field K] (p : Fin 6 → Kˣ) (u : Kˣ) : Prop :=
  ∀ c : Fin 6 → Fin 2,
    ¬ IsSquare ((u : K) * ∏ i : Fin 6, (p i : K) ^ (c i : ℕ))

def IsAdjoinedAuxPrimeState (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S₂ S'₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₂ π'₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ'₂ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  S₂ ⊆ S'₂ ∧
  (∀ k : Fin 6, 𝔭 k ∈ S'₂) ∧
  (∀ v ∈ S'₂, (∀ k : Fin 6, v ≠ 𝔭 k) → v ∈ S₂) ∧
  Disjoint S'₂ T ∧
  (∀ v ∈ S₂, π'₂ v = π₂ v) ∧
  (∀ v ∈ S'₂, IsLocalUnif v (π'₂ v)) ∧
  IsPrincipalPrimeSet K S'₂ κ'₂ ∧
  (∀ k : Fin 6, ∀ u : Kˣ,
    IsDedekindDomain.HeightOneSpectrum.valuation K (𝔭 k) (u : K) = 1 →
    ¬ IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (u : K)) →
    RamLocal a₁ a₂ a₃ (𝔭 k) (π'₂ (𝔭 k)) (p k * u) 1 ∧
    RamLocal a₁ a₂ a₃ (𝔭 k) (π'₂ (𝔭 k)) 1 (p k * u)) ∧
  (∀ k : Fin 6, ∀ x₁ x₂ : Kˣ,
    RamLocal a₁ a₂ a₃ (𝔭 k) (π'₂ (𝔭 k)) x₁ x₂ →
    (EvenVal (𝔭 k) x₁ → IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (x₁ : K))) ∧
    (EvenVal (𝔭 k) x₂ → IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (x₂ : K)))) ∧
  (∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
     (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
         v.adicCompletion K),
    (selmerStruct K a₁ a₂ a₃ T S π).encard = 1 →
    ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c = 1)

def HasPrincipalAuxSquareExtension (K : Type u) [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (p : Fin 6 → Kˣ) : Prop :=
  ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (κ : Kˣ) (a b c : Kˣ),
    Disjoint S T →
    IsPrincipalPrimeSet K S κ →
    NotInAuxSpan K p a →
    NotInAuxSpan K p b →
    NotInAuxSpan K p c →
    NotInAuxSpan K p (a * b * c) →
    ∃ (S' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (κ' : Kˣ)
      (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      S ⊆ S' ∧
      Disjoint S' T ∧
      IsPrincipalPrimeSet K S' κ' ∧
      v₀ ∈ S' ∧ v₀ ∉ S ∧
      (∀ k : Fin 6, ∀ v ∈ S', v ∉ S →
        IsSquare (algebraMap K (v.adicCompletion K) (p k : K))) ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (a : K)) ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (b : K)) ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (c : K))

def IsAuxDropLoopState (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S'₂ S_kill S_pad : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π'₂ π_kill : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ_pad : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (n : ℕ) : Prop :=
  S'₂ ⊆ S_kill ∧
  S_kill ⊆ S_pad ∧
  Disjoint S_pad T ∧
  IsPrincipalPrimeSet K S_pad κ_pad ∧
  (∀ k : Fin 6, ∀ v ∈ S_pad, (∀ i : Fin 6, v ≠ 𝔭 i) →
    IsSquare (algebraMap K (v.adicCompletion K) (p k : K))) ∧
  (∀ v ∈ S'₂, π_kill v = π'₂ v) ∧
  (∀ v ∈ S_kill, IsLocalUnif v (π_kill v)) ∧
  selmerStruct K a₁ a₂ a₃ T S_kill π_kill ⊆ selmerStruct K a₁ a₂ a₃ T S'₂ π'₂ ∧
  (selmerStruct K a₁ a₂ a₃ T S_kill π_kill).encard = 4 ^ n
def IsAuxLocalCond (K : Type u) [Field K] [NumberField K]
    (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (π_u x : Kˣ) : Prop :=
  IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) ∨
  IsSquare (algebraMap K (v₀.adicCompletion K) ((π_u * x : Kˣ) : K))

def IsIsotropicAuxUnif (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (p₀ ε₀ : Kˣ) : Prop :=
  IsLocalUnif v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) ∧
  (∀ u : Kˣ,
    IsDedekindDomain.HeightOneSpectrum.valuation K v₀ (u : K) = 1 →
    ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
    RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) (p₀ * u) 1 ∧
    RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) 1 (p₀ * u)) ∧
  (∀ x₁ x₂ : Kˣ,
    RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) x₁ x₂ →
    (EvenVal v₀ x₁ → IsSquare (algebraMap K (v₀.adicCompletion K) (x₁ : K))) ∧
    (EvenVal v₀ x₂ → IsSquare (algebraMap K (v₀.adicCompletion K) (x₂ : K)))) ∧
  (∀ x₁ x₂ : Kˣ,
    RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) x₁ x₂ ↔
      IsAuxLocalCond K v₀ (p₀ * ε₀) x₁ ∧ IsAuxLocalCond K v₀ (p₀ * ε₀) x₂) ∧
  (∀ x : Kˣ,
    (EvenVal v₀ x ∧ IsAuxLocalCond K v₀ (p₀ * ε₀) x) ↔
      IsSquare (algebraMap K (v₀.adicCompletion K) (x : K))) ∧
  (∀ x y : Kˣ, EvenVal v₀ (x * y) ↔ (EvenVal v₀ x ↔ EvenVal v₀ y)) ∧
  (∀ x y : Kˣ,
    IsAuxLocalCond K v₀ (p₀ * ε₀) (x * y) ↔
      (IsAuxLocalCond K v₀ (p₀ * ε₀) x ↔ IsAuxLocalCond K v₀ (p₀ * ε₀) y)) ∧
  EvenVal v₀ 1 ∧ IsAuxLocalCond K v₀ (p₀ * ε₀) 1 ∧
  EvenVal v₀ ε₀ ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) ε₀ ∧
  ¬ EvenVal v₀ (p₀ * ε₀) ∧ IsAuxLocalCond K v₀ (p₀ * ε₀) (p₀ * ε₀) ∧
  (∀ x y : Kˣ,
    hilbFin v₀ (x : K) (y : K) = 1 ↔
      ((¬ EvenVal v₀ x ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) y) ↔
       (¬ EvenVal v₀ y ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) x))) ∧
  (∀ r₁ r₂ : Kˣ,
    hilbFin v₀ (-(a₁ - a₂) * (a₂ - a₃) * (r₂ : K)) ((a₁ - a₂) * (a₁ - a₃) * (r₁ : K)) = 1 →
      ((¬ EvenVal v₀ r₁ ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) r₂) ↔
       (¬ EvenVal v₀ r₂ ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) r₁)))

def IsIsotropicLagrangianPair (K : Type u) [Field K]
    (R V W : Set (SqCl K × SqCl K)) : Prop :=
  (1 : SqCl K × SqCl K) ∈ R ∧
  (∀ c₁ c₂ : SqCl K × SqCl K, c₁ ∈ R → c₂ ∈ R → c₁ * c₂ ∈ R) ∧
  ∃ E L : SqCl K → Prop,
    E 1 ∧ L 1 ∧
    (∀ a b : SqCl K, E (a * b) ↔ (E a ↔ E b)) ∧
    (∀ a b : SqCl K, L (a * b) ↔ (L a ↔ L b)) ∧
    (∀ c : SqCl K × SqCl K, c ∈ V ↔ c ∈ R ∧ E c.1 ∧ E c.2) ∧
    (∀ c : SqCl K × SqCl K, c ∈ W ↔ c ∈ R ∧ L c.1 ∧ L c.2) ∧
    (∀ c ∈ R, (¬ E c.1 ∧ ¬ L c.2) ↔ (¬ E c.2 ∧ ¬ L c.1)) ∧
    (∀ b₁ b₂ : Prop,
      (∃ c ∈ V, (¬ L c.1 ↔ b₁) ∧ (¬ L c.2 ↔ b₂)) ↔
      (∀ c ∈ R, (b₁ ∧ ¬ E c.2) ↔ (b₂ ∧ ¬ E c.1))) ∧
    (∀ b₁ b₂ : Prop,
      (∃ c ∈ W, (¬ E c.1 ↔ b₁) ∧ (¬ E c.2 ↔ b₂)) ↔
      (∀ c ∈ R, (b₁ ∧ ¬ L c.2) ↔ (b₂ ∧ ¬ L c.1)))
def basisTwistPair {K : Type u} [Field K]
    (p : Fin 6 → Kˣ) (q : Fin 3 → Kˣ) (k : Fin 6) : Kˣ × Kˣ :=
  if k.1 % 2 = 0 then (p k * q ⟨k.1 / 2, by omega⟩, 1)
  else (1, p k * q ⟨k.1 / 2, by omega⟩)
noncomputable def realCoordX {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (w : {w : NumberField.InfinitePlace K // w.IsReal})
    (z : Fin (2 * Module.finrank ℚ K) → ℝ) : ℝ :=
  ∑ r : Fin (Module.finrank ℚ K), z ⟨r.1, by omega⟩ * realPlaceEmb w (ω r : K)

noncomputable def realCoordY {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (w : {w : NumberField.InfinitePlace K // w.IsReal})
    (z : Fin (2 * Module.finrank ℚ K) → ℝ) : ℝ :=
  ∑ r : Fin (Module.finrank ℚ K), z ⟨Module.finrank ℚ K + r.1, by omega⟩ * realPlaceEmb w (ω r : K)

noncomputable def realHomEval {K : Type u} [Field K] [NumberField K] {d : ℕ}
    (w : {w : NumberField.InfinitePlace K // w.IsReal})
    (c : Fin d → NumberField.RingOfIntegers K)
    (z : Fin d → ℝ) : ℝ :=
  ∑ k : Fin d, z k * realPlaceEmb w (c k : K)

def suitHomCone {K : Type u} [Field K] [NumberField K] {d : ℕ}
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal}) (κ : K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K)
    (ε : ℝ) : Set (Fin d → ℝ) :=
  { z : Fin d → ℝ |
    (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (∀ j : Fin 6, w ≠ τ ⟨j.1, by omega⟩) →
        ε < realHomEval w (c 0) z ∧
        ε < realHomEval w (c 1) z ∧
        ε < realHomEval w (c 2) z ∧
        ε < realPlaceEmb w κ * realHomEval w (c 3) z) ∧
    (∀ j : Fin 6, ε < realHomEval (τ ⟨j.1, by omega⟩) (c 3) z) ∧
    realHomEval (τ 0) (c 0) z < -ε ∧
    realHomEval (τ 0) (c 1) z < -ε ∧
    ε < realHomEval (τ 0) (c 2) z ∧
    realHomEval (τ 1) (c 0) z < -ε ∧
    realHomEval (τ 1) (c 1) z < -ε ∧
    ε < realHomEval (τ 1) (c 2) z ∧
    ε < realHomEval (τ 2) (c 0) z ∧
    realHomEval (τ 2) (c 1) z < -ε ∧
    realHomEval (τ 2) (c 2) z < -ε ∧
    ε < realHomEval (τ 3) (c 0) z ∧
    realHomEval (τ 3) (c 1) z < -ε ∧
    ε < realHomEval (τ 3) (c 2) z ∧
    ε < realHomEval (τ 4) (c 0) z ∧
    ε < realHomEval (τ 4) (c 1) z ∧
    realHomEval (τ 4) (c 2) z < -ε ∧
    ε < realHomEval (τ 5) (c 0) z ∧
    ε < realHomEval (τ 5) (c 1) z ∧
    realHomEval (τ 5) (c 2) z < -ε }

noncomputable def realCoordLiftSingle {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (x : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) :
    Fin (Module.finrank ℚ K) → ℝ :=
  fun r =>
    ∑ i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K),
      ((NumberField.mixedEmbedding.latticeBasis K).repr
        ((x, 0) : NumberField.mixedEmbedding.mixedSpace K) i) *
      ((ω.repr (NumberField.RingOfIntegers.basis K i) r : ℤ) : ℝ)

noncomputable def realCoordLift {K : Type u} [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (x y : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) :
    Fin (2 * Module.finrank ℚ K) → ℝ :=
  fun k =>
    if h : k.1 < Module.finrank ℚ K then realCoordLiftSingle ω x ⟨k.1, h⟩
    else realCoordLiftSingle ω y ⟨k.1 - Module.finrank ℚ K, by omega⟩

noncomputable def midpointPosXY (v t μw : ℝ) : ℝ × ℝ :=
  let Y := 1 + 2 / ((t - v) * μw)
  (-(1 / 2) * (v + t) * (μw * Y), Y)

noncomputable def midpointNegXY (v t μw : ℝ) : ℝ × ℝ :=
  let Y := 1 + 2 / ((t - v) * (-μw))
  (-(1 / 2) * (v + t) * (μw * Y), Y)

noncomputable def suitTargetScaledXY {K : Type u} [Field K] [NumberField K]
    [DecidableEq {w : NumberField.InfinitePlace K // w.IsReal}]
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (a₁ a₂ a₃ κ μ : K)
    (w : {w : NumberField.InfinitePlace K // w.IsReal}) : ℝ × ℝ :=
  let a₁w := realPlaceEmb w a₁
  let a₂w := realPlaceEmb w a₂
  let a₃w := realPlaceEmb w a₃
  let κw := realPlaceEmb w κ
  let μw := realPlaceEmb w μ
  if w = τ 0 then midpointPosXY a₁w a₃w μw
  else if w = τ 1 then midpointPosXY a₂w a₃w μw
  else if w = τ 2 then midpointPosXY a₃w a₁w μw
  else if w = τ 3 then midpointNegXY a₃w a₂w μw
  else if w = τ 4 then midpointNegXY a₁w a₃w μw
  else if w = τ 5 then midpointNegXY a₂w a₃w μw
  else
    let Y := 1 / κw
    (1 + |a₁w * (μw * Y)| + |a₂w * (μw * Y)| + |a₃w * (μw * Y)|, Y)

theorem threeRootsCurve_isElliptic (K : Type u) [Field K] [NumberField K]
    (e₁ e₂ e₃ : K) (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃) :
    (threeRootsCurve e₁ e₂ e₃).IsElliptic :=
by
  rw [WeierstrassCurve.isElliptic_iff, isUnit_iff_ne_zero]
  have hΔ : (threeRootsCurve e₁ e₂ e₃).Δ = 16 * (e₁ - e₂) ^ 2 * (e₁ - e₃) ^ 2 * (e₂ - e₃) ^ 2 := by
    dsimp [threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈]
    ring
  rw [hΔ]
  exact mul_ne_zero (mul_ne_zero (mul_ne_zero (OfNat.ofNat_ne_zero 16)
    (pow_ne_zero 2 (sub_ne_zero.mpr h₁₂)))
    (pow_ne_zero 2 (sub_ne_zero.mpr h₁₃)))
    (pow_ne_zero 2 (sub_ne_zero.mpr h₂₃))

theorem mordellWeilRank_baseChange_eq_of_twist_rank_zero (K L : Type u) [Field K] [NumberField K] [Field L] [Algebra K L]
    (hKi : IsGaussianExtension K L)
    (e₁ e₂ e₃ : K) (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃)
    (hrk0 : mordellWeilRank (threeRootsCurve e₁ e₂ e₃) = 0) :
    mordellWeilRank ((threeRootsCurve (-e₁) (-e₂) (-e₃)).baseChange L) =
      mordellWeilRank (threeRootsCurve (-e₁) (-e₂) (-e₃)) :=
by
  classical
  have h_aeval : aeval hKi.root (gaussianPolynomial K) = 0 := hKi.aeval_root_self
  simp only [gaussianPolynomial, map_add, map_pow, aeval_X, map_one] at h_aeval
  have hi : hKi.root ^ 2 = -1 := eq_neg_of_add_eq_zero_left h_aeval
  have h_aeval_neg : aeval (-hKi.root) (gaussianPolynomial K) = 0 := by
    simp only [gaussianPolynomial, map_add, map_pow, aeval_X, map_one, neg_sq, h_aeval]
  let σ : L →ₐ[K] L := hKi.liftHom (-hKi.root) h_aeval_neg
  have hσi : σ hKi.root = -hKi.root := hKi.liftHom_root h_aeval_neg
  have h_span : ∀ p : K[X], ∃ a b : K, hKi.map p = algebraMap K L a + algebraMap K L b * hKi.root := by
    intro p
    induction p using Polynomial.induction_on with
    | C a =>
      refine ⟨a, 0, ?_⟩
      rw [← hKi.algebraMap_apply, map_zero, zero_mul, add_zero]
    | add p q hp hq =>
      rcases hp with ⟨a₁, b₁, hp⟩
      rcases hq with ⟨a₂, b₂, hq⟩
      refine ⟨a₁ + a₂, b₁ + b₂, ?_⟩
      rw [map_add, hp, hq, map_add, map_add]
      ring
    | monomial n a ih =>
      rcases ih with ⟨a₁, b₁, ih⟩
      refine ⟨-b₁, a₁, ?_⟩
      have hX : C a * X ^ (n + 1) = (C a * X ^ n) * X := by ring
      rw [hX, map_mul, ih, hKi.map_X, map_neg]
      calc (algebraMap K L a₁ + algebraMap K L b₁ * hKi.root) * hKi.root
        _ = algebraMap K L a₁ * hKi.root + algebraMap K L b₁ * (hKi.root ^ 2) := by ring
        _ = -algebraMap K L b₁ + algebraMap K L a₁ * hKi.root := by rw [hi]; ring
  have h_decomp : ∀ z : L, ∃ a b : K, z = algebraMap K L a + algebraMap K L b * hKi.root := by
    intro z
    obtain ⟨p, rfl⟩ := hKi.map_surjective z
    exact h_span p
  have h2_ne : (2 : L) ≠ 0 := by
    have h2K : (2 : K) ≠ 0 := two_ne_zero
    intro h2L
    apply h2K
    apply (algebraMap K L).injective
    rw [map_ofNat, h2L, map_zero]
  have hσ_inv : ∀ z : L, σ (σ z) = z := by
    intro z
    obtain ⟨a, b, rfl⟩ := h_decomp z
    simp only [map_add, map_mul, AlgHom.commutes, hσi, map_neg, neg_neg]
  have hσ_fix : ∀ z : L, σ z = z → ∃ x : K, algebraMap K L x = z := by
    intro z hz
    obtain ⟨a, b, hzab⟩ := h_decomp z
    refine ⟨a, ?_⟩
    have hσz : σ z = algebraMap K L a - algebraMap K L b * hKi.root := by
      simp only [hzab, map_add, map_mul, AlgHom.commutes, hσi]; ring
    have h_sum : (2 : L) * algebraMap K L a = (2 : L) * z := by
      linear_combination -hzab - hσz + hz
    exact mul_left_cancel₀ h2_ne h_sum
  have hσ_anti : ∀ z : L, σ z = -z → ∃ y : K, hKi.root * algebraMap K L y = z := by
    intro z hz
    obtain ⟨a, b, hzab⟩ := h_decomp z
    refine ⟨b, ?_⟩
    have hσz : σ z = algebraMap K L a - algebraMap K L b * hKi.root := by
      simp only [hzab, map_add, map_mul, AlgHom.commutes, hσi]; ring
    have h_diff : (2 : L) * (hKi.root * algebraMap K L b) = (2 : L) * z := by
      linear_combination -hzab + hσz - hz
    exact mul_left_cancel₀ h2_ne h_diff
  let i : L := hKi.root
  let E := threeRootsCurve (-e₁) (-e₂) (-e₃)
  let E' := threeRootsCurve e₁ e₂ e₃
  let W₁ : WeierstrassCurve.Affine K := E'.toAffine
  let W₂ : WeierstrassCurve.Affine L := (E.baseChange L).toAffine
  let φ : K →+* L := algebraMap K L
  have hi0 : i ≠ 0 := by
    rintro h0
    have h0' : hKi.root = 0 := h0
    rw [h0'] at hi
    norm_num at hi
  have hW₁_a₁ : W₁.a₁ = 0 := rfl
  have hW₁_a₃ : W₁.a₃ = 0 := rfl
  have hW₂_a₁ : W₂.a₁ = 0 := by change φ 0 = 0; exact map_zero φ
  have hW₂_a₂ : W₂.a₂ = -φ W₁.a₂ := by
    change φ (-(-e₁ + -e₂ + -e₃)) = -φ (-(e₁ + e₂ + e₃))
    simp only [map_neg, map_add]; ring
  have hW₂_a₃ : W₂.a₃ = 0 := by change φ 0 = 0; exact map_zero φ
  have hW₂_a₄ : W₂.a₄ = φ W₁.a₄ := by
    change φ ((-e₁) * (-e₂) + (-e₁) * (-e₃) + (-e₂) * (-e₃)) = φ (e₁ * e₂ + e₁ * e₃ + e₂ * e₃)
    congr 1; ring
  have hW₂_a₆ : W₂.a₆ = -φ W₁.a₆ := by
    change φ (-((-e₁) * (-e₂) * (-e₃))) = -φ (-(e₁ * e₂ * e₃))
    simp only [map_neg, map_mul]; ring
  have h_eq : ∀ x y : K, W₂.Equation (-φ x) (i * φ y) ↔ W₁.Equation x y := by
    intro x y
    rw [WeierstrassCurve.Affine.equation_iff, WeierstrassCurve.Affine.equation_iff,
      hW₁_a₁, hW₁_a₃, hW₂_a₁, hW₂_a₂, hW₂_a₃, hW₂_a₄, hW₂_a₆]
    have hL : (i * φ y) ^ 2 + 0 * -φ x * (i * φ y) + 0 * (i * φ y) = -φ (y ^ 2) := by
      calc (i * φ y) ^ 2 + 0 * -φ x * (i * φ y) + 0 * (i * φ y)
        _ = i ^ 2 * (φ y) ^ 2 := by ring
        _ = -1 * (φ y) ^ 2 := by rw [hi]
        _ = -φ (y ^ 2) := by rw [map_pow]; ring
    have hR : (-φ x) ^ 3 + -φ W₁.a₂ * (-φ x) ^ 2 + φ W₁.a₄ * -φ x + -φ W₁.a₆ =
        -φ (x ^ 3 + W₁.a₂ * x ^ 2 + W₁.a₄ * x + W₁.a₆) := by
      simp only [map_add, map_mul, map_pow]; ring
    have hL1 : y ^ 2 + 0 * x * y + 0 * y = y ^ 2 := by ring
    rw [hL, hR, hL1, neg_inj, φ.injective.eq_iff]
  have h_ns : ∀ x y : K, W₂.Nonsingular (-φ x) (i * φ y) ↔ W₁.Nonsingular x y := by
    intro x y
    rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.nonsingular_iff,
      h_eq, hW₁_a₁, hW₁_a₃, hW₂_a₁, hW₂_a₂, hW₂_a₃, hW₂_a₄]
    have hdx : (0 * (i * φ y) ≠ 3 * (-φ x) ^ 2 + 2 * -φ W₁.a₂ * -φ x + φ W₁.a₄) ↔
        (0 * y ≠ 3 * x ^ 2 + 2 * W₁.a₂ * x + W₁.a₄) := by
      have h1 : 3 * (-φ x) ^ 2 + 2 * -φ W₁.a₂ * -φ x + φ W₁.a₄ =
          φ (3 * x ^ 2 + 2 * W₁.a₂ * x + W₁.a₄) := by
        simp only [map_add, map_mul, map_pow, map_ofNat]; ring
      rw [zero_mul, zero_mul, h1, ← map_zero φ, ne_eq, ne_eq, φ.injective.eq_iff]
    have hdy : (i * φ y ≠ -(i * φ y) - 0 * -φ x - 0) ↔ (y ≠ -y - 0 * x - 0) := by
      have h2 : -(i * φ y) - 0 * -φ x - 0 = i * φ (-y - 0 * x - 0) := by
        simp only [map_sub, map_neg, map_mul, map_zero]; ring
      rw [h2, ne_eq, ne_eq, mul_right_inj' hi0, φ.injective.eq_iff]
    rw [hdx, hdy]
  have h_negY₁ : ∀ x y : K, W₁.negY x y = -y := by
    intro x y; simp [WeierstrassCurve.Affine.negY, hW₁_a₁, hW₁_a₃]
  have h_negY₂ : ∀ X Y : L, W₂.negY X Y = -Y := by
    intro X Y; simp [WeierstrassCurve.Affine.negY, hW₂_a₁, hW₂_a₃]
  have h_negY : ∀ x y : K, W₂.negY (-φ x) (i * φ y) = i * φ (W₁.negY x y) := by
    intro x y
    rw [h_negY₂, h_negY₁, map_neg, mul_neg]
  have h_x_eq : ∀ x₁ x₂ : K, (-φ x₁ = -φ x₂) ↔ x₁ = x₂ := by
    intro x₁ x₂
    rw [neg_inj, φ.injective.eq_iff]
  have h_y_eq : ∀ x₂ y₁ y₂ : K, (i * φ y₁ = W₂.negY (-φ x₂) (i * φ y₂)) ↔ y₁ = W₁.negY x₂ y₂ := by
    intro x₂ y₁ y₂
    rw [h_negY, mul_right_inj' hi0, φ.injective.eq_iff]
  have h_slope : ∀ x₁ x₂ y₁ y₂ : K,
      W₂.slope (-φ x₁) (-φ x₂) (i * φ y₁) (i * φ y₂) = -i * φ (W₁.slope x₁ x₂ y₁ y₂) := by
    intro x₁ x₂ y₁ y₂
    by_cases hx : x₁ = x₂
    · by_cases hy : y₁ = W₁.negY x₂ y₂
      · have hx' : -φ x₁ = -φ x₂ := (h_x_eq x₁ x₂).mpr hx
        have hy' : i * φ y₁ = W₂.negY (-φ x₂) (i * φ y₂) := (h_y_eq x₂ y₁ y₂).mpr hy
        rw [WeierstrassCurve.Affine.slope_of_Y_eq hx' hy',
            WeierstrassCurve.Affine.slope_of_Y_eq hx hy, map_zero, mul_zero]
      · have hx' : -φ x₁ = -φ x₂ := (h_x_eq x₁ x₂).mpr hx
        have hy' : i * φ y₁ ≠ W₂.negY (-φ x₂) (i * φ y₂) := mt (h_y_eq x₂ y₁ y₂).mp hy
        rw [WeierstrassCurve.Affine.slope_of_Y_ne hx' hy',
            WeierstrassCurve.Affine.slope_of_Y_ne hx hy,
            hW₁_a₁, hW₂_a₁, hW₂_a₂, hW₂_a₄, h_negY]
        simp only [map_sub, map_add, map_mul, map_pow, map_ofNat, map_div₀, map_zero]
        calc (3 * (-φ x₁) ^ 2 + 2 * -φ W₁.a₂ * -φ x₁ + φ W₁.a₄ - 0 * (i * φ y₁)) /
              (i * φ y₁ - i * φ (W₁.negY x₁ y₁))
          _ = (-(i ^ 2)) * (3 * φ x₁ ^ 2 + 2 * φ W₁.a₂ * φ x₁ + φ W₁.a₄) /
              (i * (φ y₁ - φ (W₁.negY x₁ y₁))) := by change _ = (-(hKi.root ^ 2)) * _ / _; rw [hi]; ring
          _ = (i * (-i * (3 * φ x₁ ^ 2 + 2 * φ W₁.a₂ * φ x₁ + φ W₁.a₄))) /
              (i * (φ y₁ - φ (W₁.negY x₁ y₁))) := by ring
          _ = (-i * (3 * φ x₁ ^ 2 + 2 * φ W₁.a₂ * φ x₁ + φ W₁.a₄)) /
              (φ y₁ - φ (W₁.negY x₁ y₁)) := by rw [mul_div_mul_left _ _ hi0]
          _ = -i * ((3 * φ x₁ ^ 2 + 2 * φ W₁.a₂ * φ x₁ + φ W₁.a₄ - 0 * φ y₁) /
              (φ y₁ - φ (W₁.negY x₁ y₁))) := by ring
    · have hx' : -φ x₁ ≠ -φ x₂ := mt (h_x_eq x₁ x₂).mp hx
      rw [WeierstrassCurve.Affine.slope_of_X_ne hx',
          WeierstrassCurve.Affine.slope_of_X_ne hx]
      simp only [map_div₀, map_sub]
      have h_denom : -φ x₁ - -φ x₂ = -(φ x₁ - φ x₂) := by ring
      rw [h_denom, div_neg]
      ring
  have h_addX : ∀ x₁ x₂ l : K,
      W₂.addX (-φ x₁) (-φ x₂) (-i * φ l) = -φ (W₁.addX x₁ x₂ l) := by
    intro x₁ x₂ l
    simp only [WeierstrassCurve.Affine.addX, hW₁_a₁, hW₂_a₁, hW₂_a₂,
      map_sub, map_add, map_pow, map_mul, map_zero]
    calc (-i * φ l) ^ 2 + 0 * (-i * φ l) - -φ W₁.a₂ - -φ x₁ - -φ x₂
      _ = i ^ 2 * φ l ^ 2 + φ W₁.a₂ + φ x₁ + φ x₂ := by ring
      _ = -(φ l ^ 2 + 0 * φ l - φ W₁.a₂ - φ x₁ - φ x₂) := by
        change hKi.root ^ 2 * φ l ^ 2 + φ W₁.a₂ + φ x₁ + φ x₂ = _
        rw [hi]; ring
  have h_addY : ∀ x₁ x₂ y₁ l : K,
      W₂.addY (-φ x₁) (-φ x₂) (i * φ y₁) (-i * φ l) = i * φ (W₁.addY x₁ x₂ y₁ l) := by
    intro x₁ x₂ y₁ l
    simp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
      h_negY₂, h_negY₁, h_addX, map_neg, map_add, map_sub, map_mul]
    ring
  let ψ_fun : W₁.Point → W₂.Point
    | 0 => 0
    | WeierstrassCurve.Affine.Point.some h => WeierstrassCurve.Affine.Point.some ((h_ns _ _).mpr h)
  let ψ : W₁.Point →+ W₂.Point := {
    toFun := ψ_fun
    map_zero' := rfl
    map_add' := by
      intro P Q
      rcases P with _ | @⟨x₁, y₁, h₁⟩
      · rw [zero_add]; exact (zero_add (ψ_fun Q)).symm
      · rcases Q with _ | @⟨x₂, y₂, h₂⟩
        · rw [add_zero]; exact (add_zero _).symm
        · by_cases hxy : x₁ = x₂ ∧ y₁ = W₁.negY x₂ y₂
          · have hxy' : -φ x₁ = -φ x₂ ∧ i * φ y₁ = W₂.negY (-φ x₂) (i * φ y₂) :=
              ⟨(h_x_eq x₁ x₂).mpr hxy.1, (h_y_eq x₂ y₁ y₂).mpr hxy.2⟩
            rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2,
                show ψ_fun (WeierstrassCurve.Affine.Point.some h₁) =
                  WeierstrassCurve.Affine.Point.some ((h_ns x₁ y₁).mpr h₁) from rfl,
                show ψ_fun (WeierstrassCurve.Affine.Point.some h₂) =
                  WeierstrassCurve.Affine.Point.some ((h_ns x₂ y₂).mpr h₂) from rfl,
                WeierstrassCurve.Affine.Point.add_of_Y_eq hxy'.1 hxy'.2]
          · have hxy' : ¬(-φ x₁ = -φ x₂ ∧ i * φ y₁ = W₂.negY (-φ x₂) (i * φ y₂)) := by
              rintro ⟨hx', hy'⟩
              exact hxy ⟨(h_x_eq x₁ x₂).mp hx', (h_y_eq x₂ y₁ y₂).mp hy'⟩
            rw [WeierstrassCurve.Affine.Point.add_some hxy,
                show ψ_fun (WeierstrassCurve.Affine.Point.some h₁) =
                  WeierstrassCurve.Affine.Point.some ((h_ns x₁ y₁).mpr h₁) from rfl,
                show ψ_fun (WeierstrassCurve.Affine.Point.some h₂) =
                  WeierstrassCurve.Affine.Point.some ((h_ns x₂ y₂).mpr h₂) from rfl,
                WeierstrassCurve.Affine.Point.add_some hxy']
            change WeierstrassCurve.Affine.Point.some _ = WeierstrassCurve.Affine.Point.some _
            rw [WeierstrassCurve.Affine.Point.some.injEq]
            rw [h_slope, ← h_addX, ← h_addY]
            exact ⟨rfl, rfl⟩
  }
  have hψ_range : ∀ Q : W₂.Point,
      WeierstrassCurve.Affine.Point.map (W' := E.toAffine) σ Q = -Q → Q ∈ Set.range ψ := by
    intro Q hQ
    rcases Q with _ | @⟨X, Y, hXY⟩
    · exact ⟨0, rfl⟩
    · rw [WeierstrassCurve.Affine.Point.map_some, WeierstrassCurve.Affine.Point.neg_some,
          WeierstrassCurve.Affine.Point.some.injEq, h_negY₂] at hQ
      obtain ⟨x₀, hx₀⟩ := hσ_fix X hQ.1
      obtain ⟨y, hy⟩ := hσ_anti Y hQ.2
      have hx : -φ (-x₀) = X := by rw [map_neg, neg_neg, hx₀]
      have hXY' : W₂.Nonsingular (-φ (-x₀)) (i * φ y) := by
        rw [hx]; change W₂.Nonsingular X (hKi.root * φ y); rw [hy]; exact hXY
      have hxy : W₁.Nonsingular (-x₀) y := (h_ns (-x₀) y).mp hXY'
      refine ⟨WeierstrassCurve.Affine.Point.some hxy, ?_⟩
      change WeierstrassCurve.Affine.Point.some _ = WeierstrassCurve.Affine.Point.some _
      rw [WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨hx, hy⟩
  let ι := WeierstrassCurve.Affine.Point.map (W' := E.toAffine) (Algebra.ofId K L)
  let τ := WeierstrassCurve.Affine.Point.map (W' := E.toAffine) σ
  have hτ_inv : ∀ P : W₂.Point, τ (τ P) = P := by
    intro P
    rcases P with _ | @⟨X, Y, hXY⟩
    · rfl
    · change WeierstrassCurve.Affine.Point.map (W' := E.toAffine) σ
        (WeierstrassCurve.Affine.Point.map (W' := E.toAffine) σ
          (WeierstrassCurve.Affine.Point.some hXY)) =
        WeierstrassCurve.Affine.Point.some hXY
      rw [WeierstrassCurve.Affine.Point.map_some, WeierstrassCurve.Affine.Point.map_some,
          WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨hσ_inv X, hσ_inv Y⟩
  have h_plus : ∀ P : W₂.Point, P + τ P ∈ Set.range ι := by
    intro P
    have hP_fix : τ (P + τ P) = P + τ P := by
      rw [map_add, hτ_inv, add_comm]
    rcases hp : P + τ P with _ | @⟨X, Y, hXY⟩
    · exact ⟨0, WeierstrassCurve.Affine.Point.map_zero (Algebra.ofId K L)⟩
    · rw [hp] at hP_fix
      change WeierstrassCurve.Affine.Point.map (W' := E.toAffine) σ
        (WeierstrassCurve.Affine.Point.some hXY) =
        WeierstrassCurve.Affine.Point.some hXY at hP_fix
      rw [WeierstrassCurve.Affine.Point.map_some,
          WeierstrassCurve.Affine.Point.some.injEq] at hP_fix
      obtain ⟨x, rfl⟩ := hσ_fix X hP_fix.1
      obtain ⟨y, rfl⟩ := hσ_fix Y hP_fix.2
      have hxy : E.toAffine.Nonsingular x y :=
        (WeierstrassCurve.Affine.map_nonsingular (W := E.toAffine) (f := algebraMap K L) x y
          (algebraMap K L).injective).mp hXY
      refine ⟨WeierstrassCurve.Affine.Point.some hxy, ?_⟩
      change WeierstrassCurve.Affine.Point.map (W' := E.toAffine) (Algebra.ofId K L)
        (WeierstrassCurve.Affine.Point.some hxy) = _
      rw [WeierstrassCurve.Affine.Point.map_some, WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨rfl, rfl⟩
  have h_minus : ∀ P : W₂.Point, P - τ P ∈ Set.range ψ := by
    intro P
    apply hψ_range (P - τ P)
    change τ (P - τ P) = -(P - τ P)
    rw [map_sub, hτ_inv, neg_sub]
  let f : E.toAffine.Point →ₗ[ℤ] W₂.Point := ι.toIntLinearMap
  let N : Submodule ℤ W₂.Point := LinearMap.range f
  have hN_rk : Module.rank ℤ N = Module.rank ℤ E.toAffine.Point :=
    rank_range_of_injective f (WeierstrassCurve.Affine.Point.map_injective (Algebra.ofId K L))
  have h_quot_add : Module.rank ℤ (W₂.Point ⧸ N) + Module.rank ℤ N = Module.rank ℤ W₂.Point :=
    Submodule.rank_quotient_add_rank N
  have h_quot_zero : Module.rank ℤ (W₂.Point ⧸ N) = 0 := by
    rw [rank_eq_zero_iff]
    intro q
    obtain ⟨P, rfl⟩ := Submodule.Quotient.mk_surjective N q
    have hP_plus : P + τ P ∈ N := h_plus P
    obtain ⟨R, hR⟩ := h_minus P
    obtain ⟨n, hn0, hnR⟩ := rank_eq_zero_iff.mp hrk0 R
    have hn_minus : n • (P - τ P) = 0 := by
      rw [← hR, ← map_zsmul, hnR, map_zero]
    refine ⟨2 * n, mul_ne_zero two_ne_zero hn0, ?_⟩
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    have h2nP : (2 * n) • P = n • (P + τ P) := by
      have h2P : (2 : ℤ) • P = (P + τ P) + (P - τ P) := by
        rw [two_zsmul, add_add_sub_cancel]
      rw [mul_comm, mul_zsmul, h2P, zsmul_add, hn_minus, add_zero]
    rw [h2nP]
    exact Submodule.smul_mem N n hP_plus
  change Module.rank ℤ W₂.Point = Module.rank ℤ E.toAffine.Point
  rw [← h_quot_add, h_quot_zero, zero_add, hN_rk]

theorem mordellWeilRank_zero_of_twoSelmerSet_le_four (K : Type u) [Field K] [NumberField K]
    (e₁ e₂ e₃ : K) (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃)
    (hαβ : ¬ IsSquare ((e₁ - e₂) * (e₁ - e₃)))
    (hαγ : ¬ IsSquare (-((e₁ - e₂) * (e₂ - e₃))))
    (hβγ : ¬ IsSquare ((e₁ - e₃) * (e₂ - e₃)))
    (hsel : (twoSelmerSet K e₁ e₂ e₃).encard ≤ 4) :
    mordellWeilRank (threeRootsCurve e₁ e₂ e₃) = 0 :=
by
  classical
  change Module.rank ℤ (threeRootsCurve e₁ e₂ e₃).toAffine.Point = 0
  have h12 : e₁ - e₂ ≠ 0 := sub_ne_zero.mpr h₁₂
  have h13 : e₁ - e₃ ≠ 0 := sub_ne_zero.mpr h₁₃
  have h23 : e₂ - e₃ ≠ 0 := sub_ne_zero.mpr h₂₃
  have h21 : e₂ - e₁ ≠ 0 := sub_ne_zero.mpr h₁₂.symm
  have h31 : e₃ - e₁ ≠ 0 := sub_ne_zero.mpr h₁₃.symm
  have h32 : e₃ - e₂ ≠ 0 := sub_ne_zero.mpr h₂₃.symm
  have hEll : (threeRootsCurve e₁ e₂ e₃).IsElliptic := by
    rw [WeierstrassCurve.isElliptic_iff, isUnit_iff_ne_zero]
    have hΔ : (threeRootsCurve e₁ e₂ e₃).Δ =
        16 * (e₁ - e₂) ^ 2 * (e₁ - e₃) ^ 2 * (e₂ - e₃) ^ 2 := by
      dsimp [threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
        WeierstrassCurve.b₆, WeierstrassCurve.b₈]
      ring
    rw [hΔ]
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (OfNat.ofNat_ne_zero 16)
      (pow_ne_zero 2 h12)) (pow_ne_zero 2 h13)) (pow_ne_zero 2 h23)
  have hfg : AddGroup.FG (threeRootsCurve e₁ e₂ e₃).toAffine.Point :=
    mordell_weil (threeRootsCurve e₁ e₂ e₃) hEll
  have hmem_sel : ∀ u₁ u₂ : Kˣ, IsDescentClass e₁ e₂ e₃ (u₁ : K) (u₂ : K) →
      (sqCl u₁, sqCl u₂) ∈ twoSelmerSet K e₁ e₂ e₃ := by
    intro u₁ u₂ ⟨z₀, z₁, z₂, z₃, hnz, hq₁, hq₂⟩
    refine ⟨(u₁, u₂), ⟨fun v => ?_, fun w => ?_⟩, rfl⟩
    · let f := algebraMap K (v.adicCompletion K)
      refine ⟨f z₀, f z₁, f z₂, f z₃, ?_, ?_, ?_⟩
      · rintro ⟨h0, h1, h2, h3⟩
        exact hnz ⟨(map_eq_zero f).mp h0, (map_eq_zero f).mp h1,
          (map_eq_zero f).mp h2, (map_eq_zero f).mp h3⟩
      · simpa only [map_sub, map_mul, map_pow] using congrArg f hq₁
      · simpa only [map_sub, map_mul, map_pow] using congrArg f hq₂
    · let f := algebraMap K w.Completion
      refine ⟨f z₀, f z₁, f z₂, f z₃, ?_, ?_, ?_⟩
      · rintro ⟨h0, h1, h2, h3⟩
        exact hnz ⟨(map_eq_zero f).mp h0, (map_eq_zero f).mp h1,
          (map_eq_zero f).mp h2, (map_eq_zero f).mp h3⟩
      · simpa only [map_sub, map_mul, map_pow] using congrArg f hq₁
      · simpa only [map_sub, map_mul, map_pow] using congrArg f hq₂
  let u₁₁ : Kˣ := Units.mk0 ((e₁ - e₂) * (e₁ - e₃)) (mul_ne_zero h12 h13)
  let u₁₂ : Kˣ := Units.mk0 (e₁ - e₂) h12
  let u₂₁ : Kˣ := Units.mk0 (-(e₁ - e₂)) (neg_ne_zero.mpr h12)
  let u₂₂ : Kˣ := Units.mk0 (-((e₁ - e₂) * (e₂ - e₃))) (neg_ne_zero.mpr (mul_ne_zero h12 h23))
  let u₃₁ : Kˣ := Units.mk0 (e₃ - e₁) h31
  let u₃₂ : Kˣ := Units.mk0 (e₃ - e₂) h32
  have hu₁₁ : (u₁₁ : K) = (e₁ - e₂) * (e₁ - e₃) := rfl
  have hu₁₂ : (u₁₂ : K) = e₁ - e₂ := rfl
  have hu₂₁ : (u₂₁ : K) = -(e₁ - e₂) := rfl
  have hu₂₂ : (u₂₂ : K) = -((e₁ - e₂) * (e₂ - e₃)) := rfl
  have hu₃₁ : (u₃₁ : K) = e₃ - e₁ := rfl
  have hu₃₂ : (u₃₂ : K) = e₃ - e₂ := rfl
  have hns₁ : (threeRootsCurve e₁ e₂ e₃).toAffine.Nonsingular e₁ 0 := by
    rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
    refine ⟨by dsimp [threeRootsCurve]; ring, Or.inl ?_⟩
    dsimp [threeRootsCurve]
    intro h
    exact mul_ne_zero h12 h13 (by linear_combination -h)
  have hns₂ : (threeRootsCurve e₁ e₂ e₃).toAffine.Nonsingular e₂ 0 := by
    rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
    refine ⟨by dsimp [threeRootsCurve]; ring, Or.inl ?_⟩
    dsimp [threeRootsCurve]
    intro h
    exact mul_ne_zero h21 h23 (by linear_combination -h)
  have hns₃ : (threeRootsCurve e₁ e₂ e₃).toAffine.Nonsingular e₃ 0 := by
    rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
    refine ⟨by dsimp [threeRootsCurve]; ring, Or.inl ?_⟩
    dsimp [threeRootsCurve]
    intro h
    exact mul_ne_zero h31 h32 (by linear_combination -h)
