    have hd₂_ev : EvenVal v₁ d₂ := by
      rw [hneg_ev_iff, hloc_ev_mul]
      exact ⟨fun _ => hγ_ev, fun _ => hα_ev⟩
    have hd₂_val : (d₂ : K) = (δ : K) := hδ2.symm
    have hd₂_nsq : ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (d₂ : K)) := by
