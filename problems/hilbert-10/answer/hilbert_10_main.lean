        (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hb0
    have hxr_eq : x - (r : K) =
        algebraMap (NumberField.RingOfIntegers K) K (a - r * b) /
        algebraMap (NumberField.RingOfIntegers K) K b := by
      change x - algebraMap (NumberField.RingOfIntegers K) K r = _
      rw [← hab, map_sub, map_mul, sub_div, mul_div_cancel_right₀ _ hbK_ne]
    have hxr_val_lt : (v₀.valuation K) (x - (r : K)) < 1 := by
      rw [hxr_eq, Valuation.map_div, v₀.valuation_of_algebraMap, v₀.valuation_of_algebraMap]
      have hb_pos : 0 < v₀.intValuation b := by
        rw [hb_exp]
        exact WithZero.exp_pos
      rw [div_lt_iff₀ hb_pos, one_mul]
      exact harb_lt
    have hxr_L_lt : Valued.v (algebraMap K (v₀.adicCompletion K) x - algebraMap K (v₀.adicCompletion K) (r : K)) < 1 := by
      rw [← map_sub]
      erw [v₀.valuedAdicCompletion_eq_valuation' (x - (r : K))]
      exact hxr_val_lt
    have hur_lt : Valued.v (u - algebraMap K (v₀.adicCompletion K) (r : K)) < 1 := by
      have h_add : u - algebraMap K (v₀.adicCompletion K) (r : K) =
          (u - algebraMap K (v₀.adicCompletion K) x) +
          (algebraMap K (v₀.adicCompletion K) x - algebraMap K (v₀.adicCompletion K) (r : K)) := by ring
      rw [h_add]
      exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hu_x_lt hxr_L_lt)
    have hr_not_mem : r ∉ v₀.asIdeal := by
      intro hr_mem
      have hr_int_lt : v₀.intValuation r < 1 := (v₀.intValuation_lt_one_iff_mem r).mpr hr_mem
      have hr_K_lt : (v₀.valuation K) (r : K) < 1 := by
        change (v₀.valuation K) (algebraMap (NumberField.RingOfIntegers K) K r) < 1
        rwa [v₀.valuation_of_algebraMap]
      have hr_L_lt : Valued.v (algebraMap K (v₀.adicCompletion K) (r : K)) < 1 := by
        erw [v₀.valuedAdicCompletion_eq_valuation' (r : K)]
        exact hr_K_lt
      have hu_lt : Valued.v u < 1 := by
        have h_u : u = (u - algebraMap K (v₀.adicCompletion K) (r : K)) +
            algebraMap K (v₀.adicCompletion K) (r : K) := by ring
        calc Valued.v u
          _ = Valued.v ((u - algebraMap K (v₀.adicCompletion K) (r : K)) +
              algebraMap K (v₀.adicCompletion K) (r : K)) := by rw [← h_u]
          _ ≤ max (Valued.v (u - algebraMap K (v₀.adicCompletion K) (r : K)))
              (Valued.v (algebraMap K (v₀.adicCompletion K) (r : K))) :=
