      _ = (r₁ / r₂) * (r₁ / r₂) := by ring
  · intro hu_not_sq
    obtain ⟨r, hr_notMem, hur⟩ := happrox u hu
    have hvr : Valued.v (algebraMap K (v₀.adicCompletion K) (r : K)) = 1 := by
      rw [hv_int]
      exact v₀.intValuation_eq_one_iff.mpr hr_notMem
    obtain ⟨w₀, hw₀⟩ := hsq_of_sub_lt_one u (algebraMap K (v₀.adicCompletion K) (r : K)) hvr hur
    rcases hε_cases r hr_notMem with ⟨s, hs⟩ | ⟨s, hs⟩
    · exfalso
      have hs_notMem : s ∉ v₀.asIdeal := by
        intro hs_mem
        apply hr_notMem
        have hs2_mem : s ^ 2 ∈ v₀.asIdeal := by
          rw [sq]
          exact Ideal.mul_mem_left v₀.asIdeal s hs_mem
        have hadd := Ideal.add_mem v₀.asIdeal hs hs2_mem
        have hr_eq : r - s ^ 2 + s ^ 2 = r := sub_add_cancel r (s ^ 2)
        rwa [hr_eq] at hadd
      have hvs : Valued.v (algebraMap K (v₀.adicCompletion K) (s : K)) = 1 := by
        rw [hv_int]
        exact v₀.intValuation_eq_one_iff.mpr hs_notMem
      have hvs2 : Valued.v ((algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2) = 1 := by
        rw [sq, Valuation.map_mul, hvs, mul_one]
      have hsub_lt : Valued.v (algebraMap K (v₀.adicCompletion K) (r : K) -
          (algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2) < 1 := by
        have hsub_eq : algebraMap K (v₀.adicCompletion K) (r : K) -
            (algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2 =
            algebraMap K (v₀.adicCompletion K) (((r - s ^ 2 : NumberField.RingOfIntegers K) : K)) := by
          push_cast
          rfl
        rw [hsub_eq, hv_int]
        exact (v₀.intValuation_lt_one_iff_mem (r - s ^ 2)).mpr hs
      obtain ⟨w₁, hw₁⟩ := hsq_of_sub_lt_one
        (algebraMap K (v₀.adicCompletion K) (r : K))
        ((algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2) hvs2 hsub_lt
      apply hu_not_sq
      refine ⟨algebraMap K (v₀.adicCompletion K) (s : K) * w₁ * w₀, ?_⟩
      rw [← hw₀, ← hw₁]
      ring
    · have hs_notMem : s ∉ v₀.asIdeal := by
        intro hs_mem
        apply hr_notMem
        have hes2_mem : ε₀ * s ^ 2 ∈ v₀.asIdeal := by
          rw [sq, ← mul_assoc]
          exact Ideal.mul_mem_left v₀.asIdeal (ε₀ * s) hs_mem
        have hadd := Ideal.add_mem v₀.asIdeal hs hes2_mem
        have hr_eq : r - ε₀ * s ^ 2 + ε₀ * s ^ 2 = r := sub_add_cancel r (ε₀ * s ^ 2)
        rwa [hr_eq] at hadd
      have hvs : Valued.v (algebraMap K (v₀.adicCompletion K) (s : K)) = 1 := by
        rw [hv_int]
        exact v₀.intValuation_eq_one_iff.mpr hs_notMem
      have hves2 : Valued.v (ε * (algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2) = 1 := by
        rw [Valuation.map_mul, sq, Valuation.map_mul, hvε, hvs, mul_one, mul_one]
      have hsub_lt : Valued.v (algebraMap K (v₀.adicCompletion K) (r : K) -
          ε * (algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2) < 1 := by
        have hsub_eq : algebraMap K (v₀.adicCompletion K) (r : K) -
            ε * (algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2 =
            algebraMap K (v₀.adicCompletion K) (((r - ε₀ * s ^ 2 : NumberField.RingOfIntegers K) : K)) := by
          change algebraMap K (v₀.adicCompletion K) (r : K) -
            algebraMap K (v₀.adicCompletion K) (ε₀ : K) *
              (algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2 = _
          push_cast
          rfl
        rw [hsub_eq, hv_int]
        exact (v₀.intValuation_lt_one_iff_mem (r - ε₀ * s ^ 2)).mpr hs
      obtain ⟨w₁, hw₁⟩ := hsq_of_sub_lt_one
        (algebraMap K (v₀.adicCompletion K) (r : K))
        (ε * (algebraMap K (v₀.adicCompletion K) (s : K)) ^ 2) hves2 hsub_lt
      refine ⟨ε * algebraMap K (v₀.adicCompletion K) (s : K) * w₁ * w₀, ?_⟩
      rw [← hw₀, ← hw₁]
      ring

theorem hilbLoc_unit_odd_and_odd_odd_iff (K : Type u) [Field K] [NumberField K]
    (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 2 = 1) :
    (∀ d y r : v₀.adicCompletion K, r ≠ 0 →
      hilbLoc v₀ d (y * r ^ 2) = hilbLoc v₀ d y ∧
      hilbLoc v₀ (d * r ^ 2) y = hilbLoc v₀ d y) ∧
    (∀ u c : v₀.adicCompletion K, Valued.v u = 1 → IsLocalUnif v₀ c →
      (hilbLoc v₀ u c = 1 ↔ IsSquare u) ∧
      (hilbLoc v₀ c u = 1 ↔ IsSquare u)) ∧
    (∀ a b : v₀.adicCompletion K, IsLocalUnif v₀ a → IsLocalUnif v₀ b →
      (hilbLoc v₀ a b = 1 ↔ IsSquare (-a * b))) ∧
    (∀ a₁ a₂ a₃ : K, a₁ ≠ a₂ →
      hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) ((a₁ - a₂) * (a₁ - a₃)))
        (algebraMap K (v₀.adicCompletion K) (-((a₁ - a₂) * (a₂ - a₃)))) = 1 ∧
      hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) (-((a₁ - a₂) * (a₂ - a₃))))
        (algebraMap K (v₀.adicCompletion K) ((a₁ - a₂) * (a₁ - a₃))) = 1) :=
by
  classical
  have hv2 : Valued.v (2 : v₀.adicCompletion K) = 1 := by
    rw [← map_ofNat (algebraMap K (v₀.adicCompletion K)) 2]
    erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v₀ (2 : K)]
    exact h2
  have h2_ne : (2 : v₀.adicCompletion K) ≠ 0 := by
    intro h0
    rw [h0, Valuation.map_zero] at hv2
    exact zero_ne_one hv2
  have h_hensel : ∀ (x : v₀.adicCompletion K), Valued.v x < 1 → IsSquare (1 + x) := by
    intro x hx
    have hv4 : Valued.v (4 : v₀.adicCompletion K) = 1 := by
      have h42 : (4 : v₀.adicCompletion K) = 2 * 2 := by norm_num
      rw [h42, Valuation.map_mul, hv2, mul_one]
    have h4_ne : (4 : v₀.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at hv4
      exact zero_ne_one hv4
    let z : v₀.adicCompletion K := (4 : v₀.adicCompletion K)⁻¹ * x
    have h1x : 1 + x = 1 + 4 * z := by
      dsimp only [z]
      rw [mul_inv_cancel_left₀ h4_ne]
    have hz_lt : Valued.v z < 1 := by
      dsimp only [z]
      rw [Valuation.map_mul, map_inv₀, hv4, inv_one, one_mul]
      exact hx
    have hz_val : Valued.v z ≤ WithZero.exp (-1 : ℤ) := by
      by_cases hz0 : Valued.v z = 0
      · rw [hz0]
        exact zero_le'
      · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hz0
        rw [← hg] at hz_lt ⊢
        have hg_exp : (g : WithZero (Multiplicative ℤ)) = WithZero.exp (Multiplicative.toAdd g) := by
          rw [← ofAdd_toAdd g]
          rfl
        rw [hg_exp] at hz_lt ⊢
        rw [← WithZero.exp_zero] at hz_lt
        have hlt : Multiplicative.toAdd g < 0 := WithZero.exp_lt_exp.mp hz_lt
        exact WithZero.exp_le_exp.mpr (by omega)
    let e₁ : WithZero (Multiplicative ℤ) := WithZero.exp (-1 : ℤ)
    have he₁_le_one : e₁ ≤ 1 := by
      rw [← WithZero.exp_zero]
      exact WithZero.exp_le_exp.mpr (by omega)
    have hw_le : ∀ n : ℕ, Valued.v (henselSeq z n) ≤ e₁ := by
      intro n
      induction n with
      | zero =>
        simp only [henselSeq, Valuation.map_zero]
        exact zero_le'
      | succ n ih =>
        simp only [henselSeq]
        have hsq : Valued.v ((henselSeq z n) ^ 2) ≤ e₁ := by
          rw [sq, Valuation.map_mul]
          calc Valued.v (henselSeq z n) * Valued.v (henselSeq z n)
            _ ≤ e₁ * 1 := mul_le_mul' ih (le_trans ih he₁_le_one)
            _ = e₁ := mul_one e₁
        exact le_trans (Valuation.map_sub _ _ _) (max_le hz_val hsq)
    have hw_diff : ∀ n : ℕ, Valued.v (henselSeq z (n + 1) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
      intro n
      induction n with
      | zero =>
        have h0 : henselSeq z 1 - henselSeq z 0 = z := by
          simp [henselSeq]
        rw [h0]
        simpa using hz_val
      | succ n ih =>
        have hstep : henselSeq z (n + 2) - henselSeq z (n + 1) =
            -(henselSeq z (n + 1) + henselSeq z n) * (henselSeq z (n + 1) - henselSeq z n) := by
          simp only [henselSeq]
          ring
        have hsum : Valued.v (henselSeq z (n + 1) + henselSeq z n) ≤ e₁ :=
          le_trans (Valuation.map_add _ _ _) (max_le (hw_le (n + 1)) (hw_le n))
        rw [hstep, Valuation.map_mul, Valuation.map_neg]
        calc Valued.v (henselSeq z (n + 1) + henselSeq z n) * Valued.v (henselSeq z (n + 1) - henselSeq z n)
          _ ≤ WithZero.exp (-1 : ℤ) * WithZero.exp (-(n + 1 : ℤ)) := mul_le_mul' hsum ih
          _ = WithZero.exp ((-1 : ℤ) + -(n + 1 : ℤ)) := (WithZero.exp_add (-1 : ℤ) (-(n + 1 : ℤ))).symm
          _ = WithZero.exp (-((n + 1 : ℕ) + 1 : ℤ)) := by congr 1; push_cast; ring
    have hw_tele : ∀ n k : ℕ, Valued.v (henselSeq z (n + k) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
      intro n k
      induction k with
      | zero =>
        simp only [Nat.add_zero, sub_self, Valuation.map_zero]
        exact zero_le'
      | succ k ih =>
        have hsplit : henselSeq z (n + (k + 1)) - henselSeq z n =
            (henselSeq z (n + k + 1) - henselSeq z (n + k)) + (henselSeq z (n + k) - henselSeq z n) := by
          have hidx : n + (k + 1) = n + k + 1 := by omega
          rw [hidx]
          ring
        rw [hsplit]
        refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ih)
        refine le_trans (hw_diff (n + k)) ?_
        exact WithZero.exp_le_exp.mpr (by omega)
    have hw_symm : ∀ N a b : ℕ, N ≤ a → N ≤ b →
        Valued.v (henselSeq z b - henselSeq z a) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      intro N a b ha hb
      have ha' : Valued.v (henselSeq z a - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (a - N)
        rwa [Nat.add_sub_of_le ha] at h1
      have hb' : Valued.v (henselSeq z b - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (b - N)
        rwa [Nat.add_sub_of_le hb] at h1
      have hsub : henselSeq z b - henselSeq z a =
          (henselSeq z b - henselSeq z N) - (henselSeq z a - henselSeq z N) := by ring
      rw [hsub]
      exact le_trans (Valuation.map_sub _ _ _) (max_le hb' ha')
    have hcauchy : CauchySeq (henselSeq z) := by
      rw [CauchySeq, Valued.cauchy_iff]
      refine ⟨Filter.map_neBot, ?_⟩
      intro γ
      obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp (Units.ne_zero γ)
      let m : ℤ := Multiplicative.toAdd g
      let N : ℕ := (-m).toNat
      have hlt : WithZero.exp (-(N + 1 : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← hg]
        change WithZero.exp (-(N + 1 : ℤ)) < WithZero.exp m
        exact WithZero.exp_lt_exp.mpr (by omega)
      refine ⟨(henselSeq z) '' Set.Ici N, Filter.image_mem_map (Filter.mem_atTop N), ?_⟩
      rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      exact lt_of_le_of_lt (hw_symm N a b ha hb) hlt
    obtain ⟨w_inf, hw_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
    have hw_shift : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds w_inf) :=
      (Filter.tendsto_add_atTop_iff_nat 1).mpr hw_lim
    have hw_rhs : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds (z - w_inf ^ 2)) := by
      have hfun : (fun n => henselSeq z (n + 1)) = (fun n => z - (henselSeq z n) ^ 2) := rfl
      rw [hfun]
      exact tendsto_const_nhds.sub (hw_lim.pow 2)
    have hw_eq : w_inf = z - w_inf ^ 2 := tendsto_nhds_unique hw_shift hw_rhs
    refine ⟨1 + 2 * w_inf, ?_⟩
    rw [h1x]
    linear_combination -4 * hw_eq
  have h_hilb_comm : ∀ a b : v₀.adicCompletion K, hilbLoc v₀ a b = hilbLoc v₀ b a := by
    intro a b
    unfold hilbLoc
    exact if_congr ⟨fun ⟨x, y, h⟩ => ⟨y, x, by linear_combination h⟩,
      fun ⟨x, y, h⟩ => ⟨y, x, by linear_combination h⟩⟩ rfl rfl
  have h_hilb_one : ∀ a b : v₀.adicCompletion K,
      hilbLoc v₀ a b = 1 ↔ ∃ x y : v₀.adicCompletion K, a * x ^ 2 + b * y ^ 2 = 1 := by
    intro a b
    unfold hilbLoc
    split_ifs with h
    · simp [h]
    · constructor
      · intro h1
        exfalso
        revert h1; decide
      · intro h1
        exact absurd h1 h
  have h_sq_right : ∀ d y r : v₀.adicCompletion K, r ≠ 0 →
      hilbLoc v₀ d (y * r ^ 2) = hilbLoc v₀ d y := by
    intro d y r hr
    have hrr : r * r⁻¹ = 1 := mul_inv_cancel₀ hr
    unfold hilbLoc
    exact if_congr ⟨fun ⟨x, z, h⟩ => ⟨x, r * z, by linear_combination h⟩,
      fun ⟨x, z, h⟩ => ⟨x, z * r⁻¹, by linear_combination h + y * z ^ 2 * (r * r⁻¹ + 1) * hrr⟩⟩ rfl rfl
  have h_conj1 : ∀ d y r : v₀.adicCompletion K, r ≠ 0 →
      hilbLoc v₀ d (y * r ^ 2) = hilbLoc v₀ d y ∧
      hilbLoc v₀ (d * r ^ 2) y = hilbLoc v₀ d y := by
    intro d y r hr
    refine ⟨h_sq_right d y r hr, ?_⟩
    rw [h_hilb_comm (d * r ^ 2) y, h_sq_right y d r hr, h_hilb_comm y d]
  have h_unif_ne_zero : ∀ c : v₀.adicCompletion K, IsLocalUnif v₀ c → c ≠ 0 := by
    rintro c ⟨n, _, hc_val⟩ hc0
    rw [hc0, Valuation.map_zero] at hc_val
    exact WithZero.coe_ne_zero hc_val.symm
  have h_odd_sq_not_even : ∀ c z : v₀.adicCompletion K, IsLocalUnif v₀ c →
      ∀ g : Multiplicative ℤ,
        Valued.v (c * z ^ 2) = (g : WithZero (Multiplicative ℤ)) →
        ¬ Even (Multiplicative.toAdd g) := by
    rintro c z ⟨n, ⟨k, hk⟩, hc_val⟩ g hg ⟨m, hm⟩
    have hz_ne : Valued.v z ≠ 0 := by
      intro hz0
      rw [Valuation.map_mul, sq, Valuation.map_mul, hz0, mul_zero, mul_zero] at hg
      exact WithZero.coe_ne_zero hg.symm
    obtain ⟨gz, hgz⟩ := WithZero.ne_zero_iff_exists.mp hz_ne
    rw [Valuation.map_mul, sq, Valuation.map_mul, hc_val, ← hgz,
      ← WithZero.coe_mul, ← WithZero.coe_mul, WithZero.coe_inj] at hg
    have hg_add := congrArg Multiplicative.toAdd hg
    rw [toAdd_mul, toAdd_mul, toAdd_ofAdd] at hg_add
    omega
  have h_odd_sq_ne_one : ∀ c z : v₀.adicCompletion K, IsLocalUnif v₀ c →
      Valued.v (c * z ^ 2) ≠ 1 := by
    intro c z hc h1
    apply h_odd_sq_not_even c z hc 1 h1
    exact ⟨0, by rw [toAdd_one]; rfl⟩
  have h_conj2 : ∀ u c : v₀.adicCompletion K, Valued.v u = 1 → IsLocalUnif v₀ c →
      (hilbLoc v₀ u c = 1 ↔ IsSquare u) ∧
      (hilbLoc v₀ c u = 1 ↔ IsSquare u) := by
    intro u c hu hc
    have h_uc : hilbLoc v₀ u c = 1 ↔ IsSquare u := by
      rw [h_hilb_one u c]
      constructor
      · rintro ⟨x, y, hxy⟩
        let A : v₀.adicCompletion K := u * x ^ 2
        let B : v₀.adicCompletion K := c * y ^ 2
        have hAB_one : Valued.v (A + B) = 1 := by
          dsimp only [A, B]
          rw [hxy, Valuation.map_one]
        have hA_even : ∀ g : Multiplicative ℤ,
            Valued.v A = (g : WithZero (Multiplicative ℤ)) →
            Even (Multiplicative.toAdd g) := by
          intro g hg
          have hx_ne : Valued.v x ≠ 0 := by
            intro hx0
            dsimp only [A] at hg
            rw [Valuation.map_mul, sq, Valuation.map_mul, hx0, mul_zero, mul_zero] at hg
            exact WithZero.coe_ne_zero hg.symm
          obtain ⟨gx, hgx⟩ := WithZero.ne_zero_iff_exists.mp hx_ne
          dsimp only [A] at hg
          rw [Valuation.map_mul, sq, Valuation.map_mul, hu, one_mul, ← hgx,
            ← WithZero.coe_mul, WithZero.coe_inj] at hg
          have hg_add := congrArg Multiplicative.toAdd hg
          rw [toAdd_mul] at hg_add
          exact ⟨Multiplicative.toAdd gx, hg_add.symm⟩
        have hAB_ne : Valued.v A ≠ Valued.v B := by
          intro heq
          by_cases hA0 : Valued.v A = 0
          · have hB0 : Valued.v B = 0 := heq ▸ hA0
            have hle := Valuation.map_add Valued.v A B
            rw [hAB_one, hA0, hB0, max_self] at hle
            exact not_le_of_gt zero_lt_one hle
          · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hA0
            have h_ev : Even (Multiplicative.toAdd g) := hA_even g hg.symm
            have h_not_ev : ¬ Even (Multiplicative.toAdd g) :=
              h_odd_sq_not_even c y hc g (heq ▸ hg.symm)
            exact h_not_ev h_ev
        have hmax : max (Valued.v A) (Valued.v B) = 1 := by
          rw [← Valuation.map_add_of_distinct_val Valued.v hAB_ne, hAB_one]
        have hB_ne_one : Valued.v B ≠ 1 := h_odd_sq_ne_one c y hc
        have hA_one : Valued.v A = 1 := by
          rcases max_choice (Valued.v A) (Valued.v B) with hm | hm
          · rw [← hm, hmax]
          · exfalso
            rw [← hm, hmax] at hB_ne_one
            exact hB_ne_one rfl
        have hB_le_one : Valued.v B ≤ 1 := by
          rw [← hmax]
          exact le_max_right _ _
        have hB_lt_one : Valued.v (-B) < 1 := by
          rw [Valuation.map_neg]
          exact lt_of_le_of_ne hB_le_one hB_ne_one
        obtain ⟨s, hs⟩ := h_hensel (-B) hB_lt_one
        have hx_ne0 : x ≠ 0 := by
          intro hx0
          dsimp only [A] at hA_one
          rw [hx0, sq, mul_zero, mul_zero, Valuation.map_zero] at hA_one
          exact zero_ne_one hA_one
        have hxx : x * x⁻¹ = 1 := mul_inv_cancel₀ hx_ne0
        refine ⟨s * x⁻¹, ?_⟩
        dsimp only [B] at hs
        linear_combination (x⁻¹) ^ 2 * hxy + (x⁻¹) ^ 2 * hs - u * (x * x⁻¹ + 1) * hxx
      · rintro ⟨r, hr⟩
        have hr_ne : r ≠ 0 := by
          intro hr0
          rw [hr, hr0, mul_zero, Valuation.map_zero] at hu
          exact zero_ne_one hu
        have hrr : r * r⁻¹ = 1 := mul_inv_cancel₀ hr_ne
        refine ⟨r⁻¹, 0, ?_⟩
        linear_combination (r⁻¹) ^ 2 * hr + (r * r⁻¹ + 1) * hrr
    refine ⟨h_uc, ?_⟩
    rw [h_hilb_comm c u]
    exact h_uc
  have h_conj3 : ∀ a b : v₀.adicCompletion K, IsLocalUnif v₀ a → IsLocalUnif v₀ b →
      (hilbLoc v₀ a b = 1 ↔ IsSquare (-a * b)) := by
    intro a b ha hb
    have ha_ne : a ≠ 0 := h_unif_ne_zero a ha
    have hb_ne : b ≠ 0 := h_unif_ne_zero b hb
    rw [h_hilb_one a b]
    constructor
    · rintro ⟨x, y, hxy⟩
      let A : v₀.adicCompletion K := a * x ^ 2
      let B : v₀.adicCompletion K := b * y ^ 2
      have hA_ne_one : Valued.v A ≠ 1 := h_odd_sq_ne_one a x ha
      have hB_ne_one : Valued.v B ≠ 1 := h_odd_sq_ne_one b y hb
      have hA_gt_one : 1 < Valued.v A := by
        by_contra h_not_gt
        have hA_le : Valued.v A ≤ 1 := le_of_not_gt h_not_gt
        have hA_lt : Valued.v (-A) < Valued.v (1 : v₀.adicCompletion K) := by
          rw [Valuation.map_neg, Valuation.map_one]
          exact lt_of_le_of_ne hA_le hA_ne_one
        have h1A_eq_B : (1 : v₀.adicCompletion K) + -A = B := by
          dsimp only [A, B]
          linear_combination -hxy
        have hB_eq : Valued.v B = 1 := by
          rw [← h1A_eq_B, Valuation.map_add_eq_of_lt_left Valued.v hA_lt, Valuation.map_one]
        exact hB_ne_one hB_eq
      have hA_ne0 : A ≠ 0 := by
        intro h0
        rw [h0, Valuation.map_zero] at hA_gt_one
        exact not_lt_of_ge zero_le' hA_gt_one
      have hAinv_lt : Valued.v (-A⁻¹) < 1 := by
        rw [Valuation.map_neg, map_inv₀]
        exact inv_lt_one_of_one_lt₀ hA_gt_one
      obtain ⟨s, hs⟩ := h_hensel (-A⁻¹) hAinv_lt
      have hAA : (a * x ^ 2) * A⁻¹ = 1 := mul_inv_cancel₀ hA_ne0
      have hy_ne : y ≠ 0 := by
        intro hy0
        have hA1 : A = 1 := by
          dsimp only [A]
          rw [hy0] at hxy
          linear_combination hxy
        rw [hA1, Valuation.map_one] at hA_ne_one
        exact hA_ne_one rfl
      have hyy : y * y⁻¹ = 1 := mul_inv_cancel₀ hy_ne
      have h_prod_sq : (-a * b) * y ^ 2 = (a * x * s) ^ 2 := by
        linear_combination -a * hxy + a * hAA + a ^ 2 * x ^ 2 * hs
      refine ⟨(a * x * s) * y⁻¹, ?_⟩
      linear_combination (y⁻¹) ^ 2 * h_prod_sq - (-a * b) * (y * y⁻¹ + 1) * hyy
    · rintro ⟨r, hr⟩
      have hr_ne : r ≠ 0 := by
        intro hr0
        rw [hr0, mul_zero] at hr
        exact mul_ne_zero (neg_ne_zero.mpr ha_ne) hb_ne hr
      have h2a : 2 * a ≠ 0 := mul_ne_zero h2_ne ha_ne
      have h2r : 2 * r ≠ 0 := mul_ne_zero h2_ne hr_ne
      let x : v₀.adicCompletion K := (a + 1) / (2 * a)
      let y : v₀.adicCompletion K := (a - 1) / (2 * r)
      have hx : x * (2 * a) = a + 1 := div_mul_cancel₀ (a + 1) h2a
      have hy : y * (2 * r) = a - 1 := div_mul_cancel₀ (a - 1) h2r
      have h2ar_sq : (2 * a * r) ^ 2 ≠ 0 := pow_ne_zero 2 (mul_ne_zero h2a hr_ne)
      refine ⟨x, y, ?_⟩
      apply mul_right_cancel₀ h2ar_sq
      linear_combination
        a * r ^ 2 * (x * (2 * a) + (a + 1)) * hx +
        a ^ 2 * b * (y * (2 * r) + (a - 1)) * hy -
        a * (a - 1) ^ 2 * hr
  have h_conj4 : ∀ a₁ a₂ a₃ : K, a₁ ≠ a₂ →
      hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) ((a₁ - a₂) * (a₁ - a₃)))
        (algebraMap K (v₀.adicCompletion K) (-((a₁ - a₂) * (a₂ - a₃)))) = 1 ∧
      hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) (-((a₁ - a₂) * (a₂ - a₃))))
        (algebraMap K (v₀.adicCompletion K) ((a₁ - a₂) * (a₁ - a₃))) = 1 := by
    intro a₁ a₂ a₃ h₁₂
    let ι := algebraMap K (v₀.adicCompletion K)
    have h_first : hilbLoc v₀ (ι ((a₁ - a₂) * (a₁ - a₃))) (ι (-((a₁ - a₂) * (a₂ - a₃)))) = 1 := by
      rw [h_hilb_one]
      have hα : ι (a₁ - a₂) ≠ 0 := (map_ne_zero ι).mpr (sub_ne_zero.mpr h₁₂)
      have hα_inv : ι (a₁ - a₂) * (ι (a₁ - a₂))⁻¹ = 1 := mul_inv_cancel₀ hα
      refine ⟨(ι (a₁ - a₂))⁻¹, (ι (a₁ - a₂))⁻¹, ?_⟩
      have h1 : ι ((a₁ - a₂) * (a₁ - a₃)) = ι (a₁ - a₂) * ι (a₁ - a₃) := map_mul ι _ _
      have h2' : ι (-((a₁ - a₂) * (a₂ - a₃))) = -(ι (a₁ - a₂) * ι (a₂ - a₃)) := by
        rw [map_neg, map_mul]
      have h3 : ι (a₁ - a₃) - ι (a₂ - a₃) = ι (a₁ - a₂) := by
        rw [← map_sub]
        congr 1
        ring
      rw [h1, h2']
      linear_combination
        (ι (a₁ - a₂)) * ((ι (a₁ - a₂))⁻¹) ^ 2 * h3 +
        (ι (a₁ - a₂) * (ι (a₁ - a₂))⁻¹ + 1) * hα_inv
    refine ⟨h_first, ?_⟩
    rw [h_hilb_comm]
    exact h_first
  exact ⟨h_conj1, h_conj2, h_conj3, h_conj4⟩

theorem exists_non_growing_uniformizer_finset_of_selmer_trivial (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hSS₂ : S ⊆ S₂)
    (hdisj : Disjoint S₂ T)
    (hπ : ∀ v ∈ S, IsLocalUnif v (π v))
    (hsel : ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c = 1) :
    ∃ π₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K,
      (∀ v ∈ S, π₂ v = π v) ∧
      (∀ v ∈ S₂, IsLocalUnif v (π₂ v)) ∧
      (∀ c ∈ selmerStruct K a₁ a₂ a₃ T S₂ π₂, c = 1) :=
by
  classical
  have hmul : IsLocalMulClosed K a₁ a₂ a₃ := selmer_local_mul_closure K a₁ a₂ a₃ τ hstart
  have ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _⟩ := hstart
  have h_even_mul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), EvenVal v x → EvenVal v y → EvenVal v (x * y) := by
    intro v x y hx hy
    unfold EvenVal at *
    rw [map_mul, toAdd_mul]
    exact hx.add hy
  have h_even_sqCl : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), sqCl x = sqCl y → EvenVal v x → EvenVal v y := by
    intro v x y hxy hx
    unfold sqCl at hxy
    rw [QuotientGroup.eq] at hxy
    rcases hxy with ⟨u, hu⟩
    have hy : y = x * u ^ 2 := by
      calc y = x * (x⁻¹ * y) := by group
      _ = x * u ^ 2 := by rw [← hu]; rfl
    rw [hy]
    unfold EvenVal at *
    rw [map_mul, map_pow, toAdd_mul]
    refine hx.add ⟨Multiplicative.toAdd (v.valuationOfNeZero u), ?_⟩
    rw [sq, toAdd_mul]
  have h_sq_of_sqCl_one : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : Kˣ), sqCl x = 1 → IsSquare (algebraMap K (v.adicCompletion K) (x : K)) := by
    intro v x hx
    unfold sqCl at hx
    rw [QuotientGroup.eq_one_iff] at hx
    rcases hx with ⟨u, hu⟩
    have hx_eq : (x : K) = (u : K) * (u : K) := by
      have hu' : u ^ 2 = x := hu
      rw [← hu', Units.val_pow_eq_pow_val, sq]
    rw [hx_eq, map_mul]
    exact ⟨algebraMap K (v.adicCompletion K) (u : K), rfl⟩
  have h_even_of_sq_mul : ∀ (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (u : Kˣ) (c : v₀.adicCompletion K), Valued.v c = 1 →
      IsSquare (c * algebraMap K (v₀.adicCompletion K) (u : K)) → EvenVal v₀ u := by
    intro v₀ u c hc ⟨r, hr⟩
    have hval : Valued.v (c * algebraMap K (v₀.adicCompletion K) (u : K)) = Valued.v (r * r) := by
      rw [hr]
    have halg : Valued.v (algebraMap K (v₀.adicCompletion K) (u : K)) =
        (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) (u : K) :=
      v₀.valuedAdicCompletion_eq_valuation' (u : K)
    rw [Valuation.map_mul, Valuation.map_mul, hc, one_mul, halg,
      ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq] at hval
    have hr0 : Valued.v r ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hval
      exact WithZero.coe_ne_zero hval
    rcases WithZero.ne_zero_iff_exists.mp hr0 with ⟨g, hg⟩
    rw [← hg, ← WithZero.coe_mul, WithZero.coe_inj] at hval
    unfold EvenVal
    rw [hval, toAdd_mul]
    exact ⟨Multiplicative.toAdd g, rfl⟩
  have h_sq_cancel : ∀ {F : Type u} [Field F] (a r : F),
      r ≠ 0 → IsSquare (a * r ^ 2) → IsSquare a := by
    intro F _ a r hr ⟨s, hs⟩
    refine ⟨s / r, ?_⟩
    have : a * r ^ 2 / r ^ 2 = (s / r) * (s / r) := by
      rw [hs]
      ring
    rwa [mul_div_cancel_right₀ a (pow_ne_zero 2 hr)] at this
  have h_unif_mul : ∀ (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (c u : v₀.adicCompletion K), IsLocalUnif v₀ c → Valued.v u = 1 →
      IsLocalUnif v₀ (c * u) ∧ IsLocalUnif v₀ (-(c * u)) := by
    intro v₀ c u ⟨n, hn, hc⟩ hu
    have hcu : Valued.v (c * u) = ((Multiplicative.ofAdd n : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      rw [Valuation.map_mul, hc, hu, mul_one]
    refine ⟨⟨n, hn, hcu⟩, ⟨n, hn, ?_⟩⟩
    rw [Valuation.map_neg, hcu]
  have h_ne_of_unif : ∀ (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (c : v₀.adicCompletion K), IsLocalUnif v₀ c → c ≠ 0 := by
    intro v₀ c ⟨n, _, hc⟩ h0
    rw [h0, Valuation.map_zero] at hc
    exact WithZero.coe_ne_zero hc.symm
  have h_ne_of_val_one : ∀ (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (u : v₀.adicCompletion K), Valued.v u = 1 → u ≠ 0 := by
    intro v₀ u hu h0
    rw [h0, Valuation.map_zero] at hu
    exact zero_ne_one hu
  have h_units_iff : ∀ x y : ℤˣ, x * y = 1 → (x = 1 ↔ y = 1) := by decide
  have h_step : ∀ (S' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π₁ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K), v.adicCompletion K)
      (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      Disjoint S' T →
      (∀ v ∈ S', IsLocalUnif v (π₁ v)) →
      v₀ ∉ T →
      v₀ ∉ S' →
      (∀ c ∈ selmerStruct K a₁ a₂ a₃ T S' π₁, c = 1) →
      ∃ π₀ : v₀.adicCompletion K,
        IsLocalUnif v₀ π₀ ∧
        ∀ p : Kˣ × Kˣ,
          (sqCl p.1, sqCl p.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S' π₁ v₀ →
          RamLocal a₁ a₂ a₃ v₀ π₀ p.1 p.2 →
          sqCl p.1 = 1 ∧ sqCl p.2 = 1 := by
    intro S' π₁ v₀ hST hπ₁ hv₀T hv₀S' hsel₁
    obtain ⟨h2, hv12, hv13, hv23, π_a, ε, hπa, hπb, hε_val, hε_nonsq, h_dich⟩ :=
      exists_two_localUnif_and_unit_dichotomy K a₁ a₂ a₃ τ T hstart hT v₀ hv₀T
    obtain ⟨hhilb_sq, hhilb_uo, hhilb_oo, hhilb_id⟩ :=
      hilbLoc_unit_odd_and_odd_odd_iff K v₀ h2
    let ι := algebraMap K (v₀.adicCompletion K)
    have h_triv_of_even : ∀ p : Kˣ × Kˣ,
        (sqCl p.1, sqCl p.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S' π₁ v₀ →
        EvenVal v₀ p.1 → EvenVal v₀ p.2 → sqCl p.1 = 1 ∧ sqCl p.2 = 1 := by
      intro p hp hev1 hev2
      rcases hp with ⟨p', ⟨hp'T, hp'Inf, hp'Ram, hp'Even⟩, hp'_eq⟩
      have hsq1 : sqCl p'.1 = sqCl p.1 := congrArg Prod.fst hp'_eq
      have hsq2 : sqCl p'.2 = sqCl p.2 := congrArg Prod.snd hp'_eq
      have h_mem : (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S' π₁ := by
        refine ⟨p', ⟨hp'T, hp'Inf, hp'Ram, ?_⟩, hp'_eq⟩
        intro v hvT hvS'
        by_cases hvv₀ : v = v₀
        · subst hvv₀
          exact ⟨h_even_sqCl v p.1 p'.1 hsq1.symm hev1, h_even_sqCl v p.2 p'.2 hsq2.symm hev2⟩
        · exact hp'Even v hvT hvS' hvv₀
      have h1 : (sqCl p.1, sqCl p.2) = 1 := hsel₁ _ h_mem
      exact ⟨congrArg Prod.fst h1, congrArg Prod.snd h1⟩
    have h_relax_mul : ∀ p q : Kˣ × Kˣ,
        (sqCl p.1, sqCl p.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S' π₁ v₀ →
        (sqCl q.1, sqCl q.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S' π₁ v₀ →
        (sqCl (p.1 * q.1), sqCl (p.2 * q.2)) ∈ selmerStructRelax K a₁ a₂ a₃ T S' π₁ v₀ := by
      rintro p q ⟨p', ⟨hp'T, hp'Inf, hp'Ram, hp'Even⟩, hp'_eq⟩
        ⟨q', ⟨hq'T, hq'Inf, hq'Ram, hq'Even⟩, hq'_eq⟩
      refine ⟨(p'.1 * q'.1, p'.2 * q'.2), ⟨?_, ?_, ?_, ?_⟩, ?_⟩
      · intro v hvT
        exact hmul.1 v p'.1 p'.2 q'.1 q'.2 (hp'T v hvT) (hq'T v hvT)
      · intro w
        exact hmul.2.1 w p'.1 p'.2 q'.1 q'.2 (hp'Inf w) (hq'Inf w)
      · intro v hvS'
        exact hmul.2.2 v (π₁ v) p'.1 p'.2 q'.1 q'.2 (hπ₁ v hvS') (hp'Ram v hvS') (hq'Ram v hvS')
      · intro v hvT hvS' hvv₀
        exact ⟨h_even_mul v p'.1 q'.1 (hp'Even v hvT hvS' hvv₀).1 (hq'Even v hvT hvS' hvv₀).1,
               h_even_mul v p'.2 q'.2 (hp'Even v hvT hvS' hvv₀).2 (hq'Even v hvT hvS' hvv₀).2⟩
      · have hp1 : sqCl p'.1 = sqCl p.1 := congrArg Prod.fst hp'_eq
        have hp2 : sqCl p'.2 = sqCl p.2 := congrArg Prod.snd hp'_eq
        have hq1 : sqCl q'.1 = sqCl q.1 := congrArg Prod.fst hq'_eq
        have hq2 : sqCl q'.2 = sqCl q.2 := congrArg Prod.snd hq'_eq
        unfold sqCl at *
        ext <;> simp only [QuotientGroup.mk_mul, hp1, hp2, hq1, hq2]
    let u₁ : v₀.adicCompletion K := ι ((a₁ - a₂) * (a₁ - a₃))
    let u₂ : v₀.adicCompletion K := ι (-((a₁ - a₂) * (a₂ - a₃)))
    let c₁ : v₀.adicCompletion K → v₀.adicCompletion K := fun π₀ => π₀ * ι (a₁ - a₂)
    let c₂ : v₀.adicCompletion K → v₀.adicCompletion K := fun π₀ => -(π₀ * ι (a₁ - a₂))
    let c₃ : v₀.adicCompletion K → v₀.adicCompletion K := fun π₀ => -(π₀ * ι (a₁ - a₃))
    let c₄ : v₀.adicCompletion K → v₀.adicCompletion K := fun π₀ => -(π₀ * ι (a₂ - a₃))
    have hu₁_val : Valued.v u₁ = 1 := by
      change Valued.v (ι ((a₁ - a₂) * (a₁ - a₃))) = 1
      rw [map_mul, Valuation.map_mul, hv12, hv13, mul_one]
    have hu₂_val : Valued.v u₂ = 1 := by
      change Valued.v (ι (-((a₁ - a₂) * (a₂ - a₃)))) = 1
      rw [map_neg, map_mul, Valuation.map_neg, Valuation.map_mul, hv12, hv23, mul_one]
    have hc₁a : IsLocalUnif v₀ (c₁ π_a) := (h_unif_mul v₀ π_a (ι (a₁ - a₂)) hπa hv12).1
    have hc₂a : IsLocalUnif v₀ (c₂ π_a) := (h_unif_mul v₀ π_a (ι (a₁ - a₂)) hπa hv12).2
    have hc₃a : IsLocalUnif v₀ (c₃ π_a) := (h_unif_mul v₀ π_a (ι (a₁ - a₃)) hπa hv13).2
    have hc₄a : IsLocalUnif v₀ (c₄ π_a) := (h_unif_mul v₀ π_a (ι (a₂ - a₃)) hπa hv23).2
    have hc₁b : IsLocalUnif v₀ (c₁ (ε * π_a)) := (h_unif_mul v₀ (ε * π_a) (ι (a₁ - a₂)) hπb hv12).1
    have hc₂b : IsLocalUnif v₀ (c₂ (ε * π_a)) := (h_unif_mul v₀ (ε * π_a) (ι (a₁ - a₂)) hπb hv12).2
    have hc₃b : IsLocalUnif v₀ (c₃ (ε * π_a)) := (h_unif_mul v₀ (ε * π_a) (ι (a₁ - a₃)) hπb hv13).2
    have hc₄b : IsLocalUnif v₀ (c₄ (ε * π_a)) := (h_unif_mul v₀ (ε * π_a) (ι (a₂ - a₃)) hπb hv23).2
    have hπa_ne : π_a ≠ 0 := h_ne_of_unif v₀ π_a hπa
    have hu₁_ne : u₁ ≠ 0 := h_ne_of_val_one v₀ u₁ hu₁_val
    have hu₂_ne : u₂ ≠ 0 := h_ne_of_val_one v₀ u₂ hu₂_val
    have hc₁a_ne : c₁ π_a ≠ 0 := h_ne_of_unif v₀ (c₁ π_a) hc₁a
    have hc₂a_ne : c₂ π_a ≠ 0 := h_ne_of_unif v₀ (c₂ π_a) hc₂a
    have hc₃a_ne : c₃ π_a ≠ 0 := h_ne_of_unif v₀ (c₃ π_a) hc₃a
    have hc₄a_ne : c₄ π_a ≠ 0 := h_ne_of_unif v₀ (c₄ π_a) hc₄a
    have hc₁b_ne : c₁ (ε * π_a) ≠ 0 := h_ne_of_unif v₀ (c₁ (ε * π_a)) hc₁b
    have hc₂b_ne : c₂ (ε * π_a) ≠ 0 := h_ne_of_unif v₀ (c₂ (ε * π_a)) hc₂b
    have hc₃b_ne : c₃ (ε * π_a) ≠ 0 := h_ne_of_unif v₀ (c₃ (ε * π_a)) hc₃b
    have hc₄b_ne : c₄ (ε * π_a) ≠ 0 := h_ne_of_unif v₀ (c₄ (ε * π_a)) hc₄b
    have h_ram_norm : ∀ (π₀ : v₀.adicCompletion K) (p : Kˣ × Kˣ),
        (sqCl p.1, sqCl p.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S' π₁ v₀ →
        RamLocal a₁ a₂ a₃ v₀ π₀ p.1 p.2 →
        (sqCl p.1 = 1 → sqCl p.2 ≠ 1) →
        (IsSquare (u₁ * ι (p.1 : K)) ∧ IsSquare (c₁ π₀ * ι (p.2 : K))) ∨
        (IsSquare (c₂ π₀ * ι (p.1 : K)) ∧ IsSquare (u₂ * ι (p.2 : K))) ∨
        (IsSquare (c₃ π₀ * ι (p.1 : K)) ∧ IsSquare (c₄ π₀ * ι (p.2 : K))) := by
      intro π₀ p hp hram hnot
      rcases hram with ⟨h1, h2'⟩ | ⟨h1, h2'⟩ | ⟨h1, h2'⟩ | ⟨h1, h2'⟩
      · exfalso
        have htriv := h_triv_of_even p hp
          (h_even_of_sq_mul v₀ p.1 1 (Valuation.map_one _) (by simpa using h1))
          (h_even_of_sq_mul v₀ p.2 1 (Valuation.map_one _) (by simpa using h2'))
        exact hnot htriv.1 htriv.2
      · left
        refine ⟨?_, ?_⟩
        · convert h1 using 1; dsimp [u₁, ι]; push_cast; ring
        · convert h2' using 1; dsimp [c₁, ι]; push_cast; ring
      · right; left
        refine ⟨?_, ?_⟩
        · convert h1 using 1; dsimp [c₂, ι]; push_cast; ring
        · convert h2' using 1; dsimp [u₂, ι]; push_cast; ring
      · right; right
        refine ⟨?_, ?_⟩
        · convert h1 using 1; dsimp [c₃, ι]; push_cast; ring
        · convert h2' using 1; dsimp [c₄, ι]; push_cast; ring
    by_contra h_neither
    push_neg at h_neither
    rcases h_neither π_a hπa with ⟨p, hp_relax, hp_ram, hp_not⟩
    rcases h_neither (ε * π_a) hπb with ⟨q, hq_relax, hq_ram, hq_not⟩
    have hp_cases := h_ram_norm π_a p hp_relax hp_ram hp_not
    have hq_cases := h_ram_norm (ε * π_a) q hq_relax hq_ram hq_not
    have h_diag : ∀ (w₁ w₂ : v₀.adicCompletion K),
        Valued.v w₁ = 1 → Valued.v w₂ = 1 →
        IsSquare (w₁ * ι ((p.1 * q.1 : Kˣ) : K)) →
        IsSquare (w₂ * ι ((p.2 * q.2 : Kˣ) : K)) →
        (w₁ = ε ∨ w₂ = ε) → False := by
      intro w₁ w₂ hw₁ hw₂ hsq1 hsq2 hε_or
      have hpq_relax := h_relax_mul p q hp_relax hq_relax
      have hev1 : EvenVal v₀ (p.1 * q.1) := h_even_of_sq_mul v₀ (p.1 * q.1) w₁ hw₁ hsq1
      have hev2 : EvenVal v₀ (p.2 * q.2) := h_even_of_sq_mul v₀ (p.2 * q.2) w₂ hw₂ hsq2
      have hpq_triv := h_triv_of_even (p.1 * q.1, p.2 * q.2) hpq_relax hev1 hev2
      rcases h_sq_of_sqCl_one v₀ (p.1 * q.1) hpq_triv.1 with ⟨r₁, hr₁⟩
      rcases h_sq_of_sqCl_one v₀ (p.2 * q.2) hpq_triv.2 with ⟨r₂, hr₂⟩
      have hr₁_ne : r₁ ≠ 0 := by
        intro h0
        have : ι ((p.1 * q.1 : Kˣ) : K) = 0 := by rw [hr₁, h0, mul_zero]
        exact (map_ne_zero ι).mpr (p.1 * q.1).ne_zero this
      have hr₂_ne : r₂ ≠ 0 := by
        intro h0
        have : ι ((p.2 * q.2 : Kˣ) : K) = 0 := by rw [hr₂, h0, mul_zero]
        exact (map_ne_zero ι).mpr (p.2 * q.2).ne_zero this
      rcases hε_or with hw₁_eq | hw₂_eq
      · rw [hw₁_eq] at hsq1
        apply hε_nonsq
        apply h_sq_cancel ε r₁ hr₁_ne
        convert hsq1 using 1
        change ε * r₁ ^ 2 = ε * ι ((p.1 * q.1 : Kˣ) : K)
        rw [sq, ← hr₁]
      · rw [hw₂_eq] at hsq2
        apply hε_nonsq
        apply h_sq_cancel ε r₂ hr₂_ne
        convert hsq2 using 1
        change ε * r₂ ^ 2 = ε * ι ((p.2 * q.2 : Kˣ) : K)
        rw [sq, ← hr₂]
    have h_pt_pair : ∀ (d₁ d₂ e₁ e₂ : v₀.adicCompletion K),
        d₁ ≠ 0 → d₂ ≠ 0 → e₁ ≠ 0 → e₂ ≠ 0 →
        IsSquare (d₁ * ι (p.1 : K)) → IsSquare (d₂ * ι (p.2 : K)) →
        IsSquare (e₁ * ι (q.1 : K)) → IsSquare (e₂ * ι (q.2 : K)) →
        (hilbLoc v₀ d₁ e₂ = 1 ↔ hilbLoc v₀ d₂ e₁ = 1) := by
      intro d₁ d₂ e₁ e₂ hd₁ hd₂ he₁ he₂ hdp1 hdp2 heq1 heq2
      have hpt := (theorem_4_5 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ hint₁ hint₂ hint₃
        T S' hT hST π₁ hπ₁ v₀ hv₀T hv₀S' d₁ d₂ hd₁ hd₂).mpr
        ⟨p, hp_relax, hdp1, hdp2⟩ q hq_relax
      rcases heq1 with ⟨s₁, hs₁⟩
      rcases heq2 with ⟨s₂, hs₂⟩
      have hq1_ne : ι (q.1 : K) ≠ 0 := (map_ne_zero ι).mpr q.1.ne_zero
      have hq2_ne : ι (q.2 : K) ≠ 0 := (map_ne_zero ι).mpr q.2.ne_zero
      have hs₁_ne : s₁ ≠ 0 := by
        intro h0; rw [h0, mul_zero] at hs₁; exact mul_ne_zero he₁ hq1_ne hs₁
      have hs₂_ne : s₂ ≠ 0 := by
        intro h0; rw [h0, mul_zero] at hs₂; exact mul_ne_zero he₂ hq2_ne hs₂
      have he₁_eq : e₁ = ι (q.1 : K) * (s₁ / ι (q.1 : K)) ^ 2 := by
        apply mul_right_cancel₀ hq1_ne
        calc e₁ * ι (q.1 : K) = s₁ * s₁ := hs₁
        _ = (s₁ * s₁ / ι (q.1 : K) ^ 2) * ι (q.1 : K) ^ 2 :=
          (div_mul_cancel₀ _ (pow_ne_zero 2 hq1_ne)).symm
        _ = ι (q.1 : K) * (s₁ / ι (q.1 : K)) ^ 2 * ι (q.1 : K) := by
          rw [div_pow, sq s₁]; ring
      have he₂_eq : e₂ = ι (q.2 : K) * (s₂ / ι (q.2 : K)) ^ 2 := by
        apply mul_right_cancel₀ hq2_ne
        calc e₂ * ι (q.2 : K) = s₂ * s₂ := hs₂
        _ = (s₂ * s₂ / ι (q.2 : K) ^ 2) * ι (q.2 : K) ^ 2 :=
          (div_mul_cancel₀ _ (pow_ne_zero 2 hq2_ne)).symm
        _ = ι (q.2 : K) * (s₂ / ι (q.2 : K)) ^ 2 * ι (q.2 : K) := by
          rw [div_pow, sq s₂]; ring
      have h1 : hilbLoc v₀ d₁ e₂ = hilbLoc v₀ d₁ (ι (q.2 : K)) := by
        rw [he₂_eq]
        exact (hhilb_sq d₁ (ι (q.2 : K)) (s₂ / ι (q.2 : K)) (div_ne_zero hs₂_ne hq2_ne)).1
      have h2' : hilbLoc v₀ d₂ e₁ = hilbLoc v₀ d₂ (ι (q.1 : K)) := by
        rw [he₁_eq]
        exact (hhilb_sq d₂ (ι (q.1 : K)) (s₁ / ι (q.1 : K)) (div_ne_zero hs₁_ne hq1_ne)).1
      rw [h1, h2']
      exact h_units_iff _ _ hpt
    rcases hp_cases with ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩ <;>
      rcases hq_cases with ⟨hq1, hq2⟩ | ⟨hq1, hq2⟩ | ⟨hq1, hq2⟩
    · 
      apply h_diag 1 ε (Valuation.map_one _) hε_val _ _ (Or.inr rfl)
      · apply h_sq_cancel _ u₁ hu₁_ne
        convert hp1.mul hq1 using 1
        dsimp [ι]; push_cast; ring
      · apply h_sq_cancel _ (c₁ π_a) hc₁a_ne
        convert hp2.mul hq2 using 1
        dsimp [c₁, ι]; push_cast; ring
    · 
      have hiff := h_pt_pair u₁ (c₁ π_a) (c₂ (ε * π_a)) u₂ hu₁_ne hc₁a_ne hc₂b_ne hu₂_ne hp1 hp2 hq1 hq2
      have h_oo : hilbLoc v₀ (c₁ π_a) (c₂ (ε * π_a)) = 1 := hiff.mp (hhilb_id a₁ a₂ a₃ h₁₂).1
      have hsq : IsSquare (-(c₁ π_a) * c₂ (ε * π_a)) := (hhilb_oo _ _ hc₁a hc₂b).mp h_oo
      apply hε_nonsq
      apply h_sq_cancel ε (c₁ π_a) hc₁a_ne
      convert hsq using 1
      dsimp [c₁, c₂]; ring
    · 
      have hiff := h_pt_pair u₁ (c₁ π_a) (c₃ (ε * π_a)) (c₄ (ε * π_a)) hu₁_ne hc₁a_ne hc₃b_ne hc₄b_ne hp1 hp2 hq1 hq2
      rw [(hhilb_uo u₁ (c₄ (ε * π_a)) hu₁_val hc₄b).1, hhilb_oo (c₁ π_a) (c₃ (ε * π_a)) hc₁a hc₃b] at hiff
      have h_eq : -(c₁ π_a) * c₃ (ε * π_a) = (ε * u₁) * π_a ^ 2 := by
        dsimp [c₁, c₃, u₁, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₁) * π_a ^ 2) ↔ IsSquare (ε * u₁) :=
        ⟨h_sq_cancel (ε * u₁) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₁ hu₁_val] at hiff
      exact not_iff_self hiff.symm
    · 
      have hiff := h_pt_pair (c₂ π_a) u₂ u₁ (c₁ (ε * π_a)) hc₂a_ne hu₂_ne hu₁_ne hc₁b_ne hp1 hp2 hq1 hq2
      have h_oo : hilbLoc v₀ (c₂ π_a) (c₁ (ε * π_a)) = 1 := hiff.mpr (hhilb_id a₁ a₂ a₃ h₁₂).2
      have hsq : IsSquare (-(c₂ π_a) * c₁ (ε * π_a)) := (hhilb_oo _ _ hc₂a hc₁b).mp h_oo
      apply hε_nonsq
      apply h_sq_cancel ε (c₁ π_a) hc₁a_ne
      convert hsq using 1
      dsimp [c₁, c₂]; ring
    · 
      apply h_diag ε 1 hε_val (Valuation.map_one _) _ _ (Or.inl rfl)
      · apply h_sq_cancel _ (c₂ π_a) hc₂a_ne
        convert hp1.mul hq1 using 1
        dsimp [c₂, ι]; push_cast; ring
      · apply h_sq_cancel _ u₂ hu₂_ne
        convert hp2.mul hq2 using 1
        dsimp [ι]; push_cast; ring
    · 
      have hiff := h_pt_pair (c₂ π_a) u₂ (c₃ (ε * π_a)) (c₄ (ε * π_a)) hc₂a_ne hu₂_ne hc₃b_ne hc₄b_ne hp1 hp2 hq1 hq2
      rw [hhilb_oo (c₂ π_a) (c₄ (ε * π_a)) hc₂a hc₄b, (hhilb_uo u₂ (c₃ (ε * π_a)) hu₂_val hc₃b).1] at hiff
      have h_eq : -(c₂ π_a) * c₄ (ε * π_a) = (ε * u₂) * π_a ^ 2 := by
        dsimp [c₂, c₄, u₂, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₂) * π_a ^ 2) ↔ IsSquare (ε * u₂) :=
        ⟨h_sq_cancel (ε * u₂) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₂ hu₂_val] at hiff
      exact not_iff_self hiff
    · 
      have hiff := h_pt_pair (c₃ π_a) (c₄ π_a) u₁ (c₁ (ε * π_a)) hc₃a_ne hc₄a_ne hu₁_ne hc₁b_ne hp1 hp2 hq1 hq2
      rw [hhilb_oo (c₃ π_a) (c₁ (ε * π_a)) hc₃a hc₁b, (hhilb_uo u₁ (c₄ π_a) hu₁_val hc₄a).2] at hiff
      have h_eq : -(c₃ π_a) * c₁ (ε * π_a) = (ε * u₁) * π_a ^ 2 := by
        dsimp [c₁, c₃, u₁, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₁) * π_a ^ 2) ↔ IsSquare (ε * u₁) :=
        ⟨h_sq_cancel (ε * u₁) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₁ hu₁_val] at hiff
      exact not_iff_self hiff
    · 
      have hiff := h_pt_pair (c₃ π_a) (c₄ π_a) (c₂ (ε * π_a)) u₂ hc₃a_ne hc₄a_ne hc₂b_ne hu₂_ne hp1 hp2 hq1 hq2
      rw [(hhilb_uo u₂ (c₃ π_a) hu₂_val hc₃a).2, hhilb_oo (c₄ π_a) (c₂ (ε * π_a)) hc₄a hc₂b] at hiff
      have h_eq : -(c₄ π_a) * c₂ (ε * π_a) = (ε * u₂) * π_a ^ 2 := by
        dsimp [c₂, c₄, u₂, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₂) * π_a ^ 2) ↔ IsSquare (ε * u₂) :=
        ⟨h_sq_cancel (ε * u₂) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₂ hu₂_val] at hiff
      exact not_iff_self hiff.symm
    · 
      apply h_diag ε ε hε_val hε_val _ _ (Or.inl rfl)
      · apply h_sq_cancel _ (c₃ π_a) hc₃a_ne
        convert hp1.mul hq1 using 1
        dsimp [c₃, ι]; push_cast; ring
      · apply h_sq_cancel _ (c₄ π_a) hc₄a_ne
        convert hp2.mul hq2 using 1
        dsimp [c₄, ι]; push_cast; ring
  have h_ind : ∀ D : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      Disjoint D S → Disjoint D T →
      ∃ π₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K,
        (∀ v ∈ S, π₂ v = π v) ∧
        (∀ v ∈ S ∪ D, IsLocalUnif v (π₂ v)) ∧
        (∀ c ∈ selmerStruct K a₁ a₂ a₃ T (S ∪ D) π₂, c = 1) := by
    intro D
    induction D using Finset.induction with
    | empty =>
      intro _ _
      refine ⟨π, fun _ _ => rfl, ?_, ?_⟩
      · simpa using hπ
      · simpa using hsel
    | @insert v₀ D hv₀D ih =>
      intro hDS hDT
      rw [Finset.disjoint_insert_left] at hDS hDT
      rcases hDS with ⟨hv₀S, hDS⟩
      rcases hDT with ⟨hv₀T, hDT⟩
      obtain ⟨π₁, hπ₁_eq, hπ₁_unif, hsel₁⟩ := ih hDS hDT
      have hST_union : Disjoint (S ∪ D) T :=
        Finset.disjoint_union_left.mpr ⟨hdisj.mono_left hSS₂, hDT⟩
      have hv₀_not_union : v₀ ∉ S ∪ D :=
        Finset.notMem_union.mpr ⟨hv₀S, hv₀D⟩
      obtain ⟨π₀, hπ₀_unif, hstep₀⟩ :=
        h_step (S ∪ D) π₁ v₀ hST_union hπ₁_unif hv₀T hv₀_not_union hsel₁
      let π₂ := Function.update π₁ v₀ π₀
      refine ⟨π₂, ?_, ?_, ?_⟩
      · intro v hvS
        have hne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
        simpa [π₂, Function.update_of_ne hne] using hπ₁_eq v hvS
      · intro v hv
        by_cases hvv₀ : v = v₀
        · subst hvv₀
          simpa [π₂] using hπ₀_unif
        · have hv' : v ∈ S ∪ D := by
            rcases Finset.mem_union.mp hv with hvS | hvD
            · exact Finset.mem_union_left D hvS
            · exact Finset.mem_union_right S (Finset.mem_of_mem_insert_of_ne hvD hvv₀)
          simpa [π₂, Function.update_of_ne hvv₀] using hπ₁_unif v hv'
      · intro c hc
        rcases hc with ⟨p, ⟨hpT, hpInf, hpRam, hpEven⟩, rfl⟩
        have hp_relax : (sqCl p.1, sqCl p.2) ∈ selmerStructRelax K a₁ a₂ a₃ T (S ∪ D) π₁ v₀ := by
          refine ⟨p, ⟨hpT, hpInf, ?_, ?_⟩, rfl⟩
          · intro v hv
            have hne : v ≠ v₀ := fun h => hv₀_not_union (h ▸ hv)
            have hv_ins : v ∈ S ∪ insert v₀ D := by
              rcases Finset.mem_union.mp hv with hvS | hvD
              · exact Finset.mem_union_left _ hvS
              · exact Finset.mem_union_right _ (Finset.mem_insert_of_mem hvD)
            simpa [π₂, Function.update_of_ne hne] using hpRam v hv_ins
          · intro v hvT hvSD hne
            have hv_not_ins : v ∉ S ∪ insert v₀ D := by
              intro hv_ins
              rcases Finset.mem_union.mp hv_ins with hvS | hvD
              · exact hvSD (Finset.mem_union_left D hvS)
              · exact hvSD (Finset.mem_union_right S (Finset.mem_of_mem_insert_of_ne hvD hne))
            exact hpEven v hvT hv_not_ins
        have hp_ram₀ : RamLocal a₁ a₂ a₃ v₀ π₀ p.1 p.2 := by
          have hv₀_ins : v₀ ∈ S ∪ insert v₀ D :=
            Finset.mem_union_right S (Finset.mem_insert_self v₀ D)
          simpa [π₂] using hpRam v₀ hv₀_ins
        have htriv := hstep₀ p hp_relax hp_ram₀
        exact Prod.ext htriv.1 htriv.2
  have hDS : Disjoint (S₂ \ S) S := Finset.disjoint_sdiff.symm
  have hDT : Disjoint (S₂ \ S) T := hdisj.mono_left Finset.sdiff_subset
  obtain ⟨π₂, h1, h2', h3⟩ := h_ind (S₂ \ S) hDS hDT
  rw [Finset.union_sdiff_of_subset hSS₂] at h2' h3
  exact ⟨π₂, h1, h2', h3⟩

theorem selmerStruct_eq_one_of_encard_eq_one (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (hcard : (selmerStruct K a₁ a₂ a₃ T S π).encard = 1) :
    ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c = 1 :=
by
  have hone : (1 : SqCl K × SqCl K) ∈ selmerStruct K a₁ a₂ a₃ T S π := by
    refine ⟨(1, 1), ⟨?_, ?_, ?_, ?_⟩, ?_⟩
    · intro v _
      refine ⟨0, 1, 1, 1, ?_, ?_, ?_⟩
      · rintro ⟨_, h1, _, _⟩
        exact one_ne_zero h1
      · simp
      · simp
    · intro w
      refine ⟨0, 1, 1, 1, ?_, ?_, ?_⟩
      · rintro ⟨_, h1, _, _⟩
        exact one_ne_zero h1
      · simp
      · simp
    · intro v _
      left
      exact ⟨⟨1, by simp⟩, ⟨1, by simp⟩⟩
    · intro v _ _
      have hev : EvenVal v (1 : Kˣ) := by
        dsimp [EvenVal]
        simp
      exact ⟨hev, hev⟩
    · ext <;> rfl
  obtain ⟨x, hx⟩ := Set.encard_eq_one.mp hcard
  have hx1 : (1 : SqCl K × SqCl K) = x := by
    have hmem : (1 : SqCl K × SqCl K) ∈ ({x} : Set (SqCl K × SqCl K)) := hx ▸ hone
    exact Set.mem_singleton_iff.mp hmem
  intro c hc
  have hc_mem : c ∈ ({x} : Set (SqCl K × SqCl K)) := hx ▸ hc
  rw [Set.mem_singleton_iff.mp hc_mem, ← hx1]

theorem isPrincipalPrimeSet_of_span_eq_prod (K : Type u) [Field K] [NumberField K]
    (D : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π_D : NumberField.RingOfIntegers K)
    (hspan : Ideal.span {π_D} = ∏ w ∈ D, w.asIdeal) :
    ∃ κ_D : Kˣ, IsPrincipalPrimeSet K D κ_D :=
by
  have hprod_ne : (∏ w ∈ D, w.asIdeal) ≠ 0 := by
    rw [Finset.prod_ne_zero_iff]
    intro w _
    exact w.ne_bot
  have hπ_ne : π_D ≠ 0 := by
    intro h0
    apply hprod_ne
    rw [← hspan, h0, Ideal.span_singleton_eq_bot.mpr rfl]
    rfl
  have hπK_ne : (π_D : K) ≠ 0 := by
    intro h0
    exact hπ_ne (by exact_mod_cast h0)
  let κ_D : Kˣ := Units.mk0 (π_D : K) hπK_ne
  have h_not_dvd : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (E : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))),
      v ∉ E → ¬ (v.asIdeal ∣ ∏ w ∈ E, w.asIdeal) := by
    intro v E hvE hdvd
    obtain ⟨w, hwE, hvw⟩ := Prime.dvd_finset_prod_iff v.prime _ |>.mp hdvd
    have hle : w.asIdeal ≤ v.asIdeal := Ideal.dvd_iff_le.mp hvw
    have heq : w.asIdeal = v.asIdeal := w.isMaximal.eq_of_le v.isPrime.ne_top hle
    have hwv : w = v := IsDedekindDomain.HeightOneSpectrum.ext heq
    exact hvE (hwv ▸ hwE)
  refine ⟨κ_D, NumberField.RingOfIntegers.isIntegral_coe π_D, ?_, ?_⟩
  · intro v hv
    classical
    have hval_eq : IsDedekindDomain.HeightOneSpectrum.valuation K v (κ_D : K) =
        v.intValuation π_D :=
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap v π_D
    rw [hval_eq]
    have hprod_split : (∏ w ∈ D, w.asIdeal) = v.asIdeal * ∏ w ∈ D.erase v, w.asIdeal :=
      (Finset.mul_prod_erase D (fun w => w.asIdeal) hv).symm
    have hdvd1 : v.asIdeal ^ 1 ∣ Ideal.span {π_D} := by
      rw [pow_one, hspan, hprod_split]
      exact dvd_mul_right v.asIdeal _
    have hndvd2 : ¬ (v.asIdeal ^ 2 ∣ Ideal.span {π_D}) := by
      rw [sq, hspan, hprod_split, mul_dvd_mul_iff_left v.ne_bot]
      exact h_not_dvd v (D.erase v) (Finset.notMem_erase v D)
    have hle1 : v.intValuation π_D ≤ WithZero.exp (-(1 : ℕ) : ℤ) :=
      (v.intValuation_le_pow_iff_dvd π_D 1).mpr hdvd1
    have hnle2 : ¬ (v.intValuation π_D ≤ WithZero.exp (-(2 : ℕ) : ℤ)) :=
      mt (v.intValuation_le_pow_iff_dvd π_D 2).mp hndvd2
    have hne0 : v.intValuation π_D ≠ 0 := v.intValuation_ne_zero' ⟨π_D, mem_nonZeroDivisors_of_ne_zero hπ_ne⟩
    obtain ⟨z, hz⟩ := WithZero.ne_zero_iff_exists.mp hne0
    rw [← hz] at hle1 hnle2 ⊢
    change WithZero.exp (Multiplicative.toAdd z) ≤ WithZero.exp (-1 : ℤ) at hle1
    change ¬ (WithZero.exp (Multiplicative.toAdd z) ≤ WithZero.exp (-2 : ℤ)) at hnle2
    rw [WithZero.exp_le_exp] at hle1 hnle2
    have hz_eq : Multiplicative.toAdd z = -1 := by omega
    rw [← hz_eq]
    rfl
  · intro v hv
    have hval_eq : IsDedekindDomain.HeightOneSpectrum.valuation K v (κ_D : K) =
        v.intValuation π_D :=
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap v π_D
    rw [hval_eq]
    have hndvd : ¬ (v.asIdeal ∣ Ideal.span {π_D}) := by
      rw [hspan]
      exact h_not_dvd v D hv
    have hnlt : ¬ (v.intValuation π_D < 1) :=
      mt (v.intValuation_lt_one_iff_dvd π_D).mp hndvd
    exact le_antisymm (v.intValuation_le_one π_D) (not_lt.mp hnlt)

theorem exists_finite_bad_primes_and_span_eq_prod_of_notMem (K : Type u) [Field K] [NumberField K] :
    ∃ B : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))),
        v ∉ B →
        v ∉ F →
        ∃ (D : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
          (π_D : NumberField.RingOfIntegers K),
          v ∈ D ∧
          Disjoint D F ∧
          Ideal.span {π_D} = ∏ w ∈ D, w.asIdeal :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let idealNZD : IsDedekindDomain.HeightOneSpectrum R → nonZeroDivisors (Ideal R) :=
    fun w => ⟨w.asIdeal, mem_nonZeroDivisors_of_ne_zero w.ne_bot⟩
  let cl : IsDedekindDomain.HeightOneSpectrum R → ClassGroup R :=
    fun w => ClassGroup.mk0 (idealNZD w)
  let C_fin : Set (ClassGroup R) := { c | (cl ⁻¹' {c}).Finite }
  have hB_fin : (⋃ c ∈ C_fin, cl ⁻¹' {c}).Finite :=
    Set.Finite.biUnion (Set.toFinite C_fin) (fun c hc => hc)
  refine ⟨hB_fin.toFinset, ?_⟩
  intro v F hvB hvF
  have hv_inf : (cl ⁻¹' {cl v}).Infinite := by
    intro hfin
    apply hvB
    rw [Set.Finite.mem_toFinset]
    exact Set.mem_biUnion hfin rfl
  let P' : Set (IsDedekindDomain.HeightOneSpectrum R) :=
    (cl ⁻¹' {cl v}) \ ((F : Set (IsDedekindDomain.HeightOneSpectrum R)) ∪ {v})
  have hP'_inf : P'.Infinite :=
    hv_inf.diff (F.finite_toSet.union (Set.finite_singleton v))
  let h : ℕ := Fintype.card (ClassGroup R)
  have hh_pos : 0 < h := Fintype.card_pos
  obtain ⟨E, hE_sub, hE_card⟩ := hP'_inf.exists_subset_card_eq (h - 1)
  let D : Finset (IsDedekindDomain.HeightOneSpectrum R) := insert v E
  have hvE : v ∉ E := by
    intro hvE_mem
    have hmem : v ∈ P' := hE_sub hvE_mem
    exact hmem.2 (Or.inr (Set.mem_singleton v))
  have hD_card : D.card = h := by
    rw [Finset.card_insert_of_notMem hvE, hE_card, Nat.sub_add_cancel hh_pos]
  have hD_cl : ∀ w ∈ D, cl w = cl v := by
    intro w hw
    rcases Finset.mem_insert.mp hw with rfl | hwE
    · rfl
    · exact (hE_sub hwE).1
  have hD_disj : Disjoint D F := by
    rw [Finset.disjoint_left]
    intro w hw hwF
    rcases Finset.mem_insert.mp hw with rfl | hwE
    · exact hvF hwF
    · exact (hE_sub hwE).2 (Or.inl hwF)
  have hprod_cl : ClassGroup.mk0 (∏ w ∈ D, idealNZD w) = 1 := by
    rw [map_prod]
    calc ∏ w ∈ D, cl w
      _ = ∏ _w ∈ D, cl v := Finset.prod_congr rfl hD_cl
      _ = (cl v) ^ D.card := Finset.prod_const (cl v)
      _ = (cl v) ^ Fintype.card (ClassGroup R) := by rw [hD_card]
      _ = 1 := pow_card_eq_one
  have hprin : Submodule.IsPrincipal ((∏ w ∈ D, idealNZD w : nonZeroDivisors (Ideal R)) : Ideal R) :=
    (ClassGroup.mk0_eq_one_iff _).mp hprod_cl
  rw [Submonoid.coe_finset_prod] at hprin
  obtain ⟨π_D, hπ_D⟩ := hprin.principal
  exact ⟨D, π_D, Finset.mem_insert_self v E, hD_disj, hπ_D.symm⟩

theorem exists_finite_class_bad_primes_and_principalize (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T) :
    ∃ B : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      ∀ (S₀ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
        (π₀ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            v.adicCompletion K),
        Disjoint S₀ T →
        Disjoint S₀ B →
        (∀ v ∈ S₀, IsLocalUnif v (π₀ v)) →
        (selmerStruct K a₁ a₂ a₃ T S₀ π₀).encard = 1 →
        ∃ (S₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
          (π₁ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              v.adicCompletion K)
          (κ₁ : Kˣ),
          IsRankZeroSelmerState K a₁ a₂ a₃ T S₁ π₁ κ₁ :=
by
  obtain ⟨B, hB⟩ := exists_finite_bad_primes_and_span_eq_prod_of_notMem K
  refine ⟨B, ?_⟩
  intro S₀ π₀ hS₀T hS₀B hπ₀ hcard₀
  have h_span_superset :
      ∀ s : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        Disjoint s T →
        Disjoint s B →
        ∃ (S₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
          (π_int : NumberField.RingOfIntegers K),
          s ⊆ S₁ ∧
          Disjoint S₁ T ∧
          Ideal.span {π_int} = ∏ w ∈ S₁, w.asIdeal := by
    classical
    intro s
    induction s using Finset.induction with
    | empty =>
      intro _ _
      refine ⟨∅, 1, Finset.Subset.refl ∅, Finset.disjoint_empty_left T, ?_⟩
      rw [Finset.prod_empty, Ideal.span_singleton_one, Ideal.one_eq_top]
    | @insert v s hvs ih =>
      intro hsT hsB
      have hvT : v ∉ T := Finset.disjoint_left.mp hsT (Finset.mem_insert_self v s)
      have hvB : v ∉ B := Finset.disjoint_left.mp hsB (Finset.mem_insert_self v s)
      have hsT' : Disjoint s T := hsT.mono_left (Finset.subset_insert v s)
      have hsB' : Disjoint s B := hsB.mono_left (Finset.subset_insert v s)
      obtain ⟨S'₁, π'₁, hs_sub, hS'₁T, hspan'⟩ := ih hsT' hsB'
      by_cases hvS'₁ : v ∈ S'₁
      · exact ⟨S'₁, π'₁, Finset.insert_subset_iff.mpr ⟨hvS'₁, hs_sub⟩, hS'₁T, hspan'⟩
      · have hvF : v ∉ T ∪ S'₁ := by
          rw [Finset.mem_union, not_or]
          exact ⟨hvT, hvS'₁⟩
        obtain ⟨D, π_D, hvD, hDF, hspanD⟩ := hB v (T ∪ S'₁) hvB hvF
        have hDT : Disjoint D T := hDF.mono_right Finset.subset_union_left
        have hDS'₁ : Disjoint D S'₁ := hDF.mono_right Finset.subset_union_right
        refine ⟨S'₁ ∪ D, π'₁ * π_D, ?_, ?_, ?_⟩
        · rw [Finset.insert_subset_iff]
          exact ⟨Finset.mem_union_right S'₁ hvD, hs_sub.trans Finset.subset_union_left⟩
        · exact Finset.disjoint_union_left.mpr ⟨hS'₁T, hDT⟩
        · rw [Finset.prod_union hDS'₁.symm, ← hspan', ← hspanD,
            ← Ideal.span_singleton_mul_span_singleton]
  obtain ⟨S₁, π_int, hS₀S₁, hS₁T, hspan₁⟩ := h_span_superset S₀ hS₀T hS₀B
  obtain ⟨κ₁, hprin₁⟩ := isPrincipalPrimeSet_of_span_eq_prod K S₁ π_int hspan₁
  have hsel₀ : ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S₀ π₀, c = 1 :=
    selmerStruct_eq_one_of_encard_eq_one K a₁ a₂ a₃ T S₀ π₀ hcard₀
  obtain ⟨π₁, _, hπ₁, hsel₁⟩ :=
    exists_non_growing_uniformizer_finset_of_selmer_trivial K a₁ a₂ a₃ τ T S₀ S₁ π₀
      hstart hT hS₀S₁ hS₁T hπ₀ hsel₀
  exact ⟨S₁, π₁, κ₁, hS₁T, hπ₁, hprin₁, hsel₁⟩

theorem exists_selmer_rank_zero (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T) :
    ∃ (S₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π₁ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ₁ : Kˣ),
      IsRankZeroSelmerState K a₁ a₂ a₃ T S₁ π₁ κ₁ :=
by
  obtain ⟨B, hB⟩ := exists_finite_class_bad_primes_and_principalize K a₁ a₂ a₃ τ T hstart hT
  obtain ⟨m, hm⟩ := selmerStruct_empty_encard_eq_four_pow K a₁ a₂ a₃ τ T (fun _ => 0) hstart hT
  have hab_sq : ∀ x δ : Kˣ, ¬ IsSquare (δ : K) → ¬ IsSquare ((x * δ * x : Kˣ) : K) := by
    intro x δ hδ ⟨r, hr⟩
    apply hδ
    refine ⟨r / (x : K), ?_⟩
    have hx0 : (x : K) ≠ 0 := x.ne_zero
    have h1 : ((x * δ * x : Kˣ) : K) = (x : K) ^ 2 * (δ : K) := by
      push_cast
      ring
    rw [h1] at hr
    calc (δ : K)
      _ = ((x : K) ^ 2 * (δ : K)) / (x : K) ^ 2 := by
          rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 hx0)]
      _ = (r * r) / (x : K) ^ 2 := by rw [hr]
      _ = (r / (x : K)) * (r / (x : K)) := by ring
  have hpq_sq : ∀ p q : Kˣ × Kˣ,
      ¬ IsSquare ((p.2 * q.2 : Kˣ) : K) →
      ¬ IsSquare (((p.1 * p.2) * q.2 * p.1 : Kˣ) : K) := by
    intro p q hpq ⟨r, hr⟩
    apply hpq
    refine ⟨r / (p.1 : K), ?_⟩
    have hp0 : (p.1 : K) ≠ 0 := p.1.ne_zero
    have h1 : (((p.1 * p.2) * q.2 * p.1 : Kˣ) : K) =
        (p.1 : K) ^ 2 * ((p.2 * q.2 : Kˣ) : K) := by
      push_cast
      ring
    rw [h1] at hr
    calc ((p.2 * q.2 : Kˣ) : K)
      _ = ((p.1 : K) ^ 2 * ((p.2 * q.2 : Kˣ) : K)) / (p.1 : K) ^ 2 := by
          rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 hp0)]
      _ = (r * r) / (p.1 : K) ^ 2 := by rw [hr]
      _ = (r / (p.1 : K)) * (r / (p.1 : K)) := by ring
  have h_ind : ∀ (n : ℕ)
      (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K),
      Disjoint S T → Disjoint S B → (∀ v ∈ S, IsLocalUnif v (π v)) →
      (selmerStruct K a₁ a₂ a₃ T S π).encard = 4 ^ n →
      ∃ (S₀ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
        (π₀ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            v.adicCompletion K),
        Disjoint S₀ T ∧ Disjoint S₀ B ∧ (∀ v ∈ S₀, IsLocalUnif v (π₀ v)) ∧
        (selmerStruct K a₁ a₂ a₃ T S₀ π₀).encard = 1 := by
    intro n
    induction n with
    | zero =>
      intro S π hST hSB hπ hcard
      rw [pow_zero] at hcard
      exact ⟨S, π, hST, hSB, hπ, hcard⟩
    | succ n ih =>
      intro S π hST hSB hπ hcard
      have hpiv := selmerStruct_insert_pivot_of_subset_kernel K a₁ a₂ a₃ τ T B S π n
        hstart hT hST hSB hπ hcard
      have hstep : ∃ (S' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
          (π' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              v.adicCompletion K)
          (p q : Kˣ × Kˣ),
          Disjoint S' T ∧ Disjoint S' B ∧ (∀ v ∈ S', IsLocalUnif v (π' v)) ∧
          (selmerStruct K a₁ a₂ a₃ T S' π').encard = 4 ^ (n + 1) ∧
          (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S' π' ∧
          (sqCl q.1, sqCl q.2) ∈ selmerStruct K a₁ a₂ a₃ T S' π' ∧
          ¬ IsSquare (p.1 : K) ∧
          ¬ IsSquare ((p.1 * p.2 : Kˣ) : K) ∧
          ¬ IsSquare (q.2 : K) ∧
          ¬ IsSquare ((p.2 * q.2 : Kˣ) : K) := by
        rcases hpiv with ⟨p, q, hp, hq, hp₁, hp₁₂, hq₂, hp₂q₂⟩ | ⟨x, δ, hx, hδ, hv₁_all⟩
        · exact ⟨S, π, p, q, hST, hSB, hπ, hcard, hp, hq, hp₁, hp₁₂, hq₂, hp₂q₂⟩
        · obtain ⟨v₁, hv₁T, hv₁B, hv₁S, hv₁x, hv₁δ, _⟩ :=
            exists_prime_three_not_isSquare K x δ x T B S hx hδ hx (hab_sq x δ hδ)
          obtain ⟨S', π', hS'T, hS'B, hπ', hcard', p, q, hp, hq, hp₁, hp₁₂, hq₂, hp₂q₂⟩ :=
            hv₁_all v₁ hv₁T hv₁B hv₁S hv₁x hv₁δ
          exact ⟨S', π', p, q, hS'T, hS'B, hπ', hcard', hp, hq, hp₁, hp₁₂, hq₂, hp₂q₂⟩
      obtain ⟨S', π', p, q, hS'T, hS'B, hπ', hcard', hp, hq, hp₁, hp₁₂, hq₂, hp₂q₂⟩ := hstep
      obtain ⟨v₀, hv₀T, hv₀B, hv₀S', hv₀p₁₂, hv₀q₂, hv₀p₁⟩ :=
        exists_prime_three_not_isSquare K (p.1 * p.2) q.2 p.1 T B S'
          hp₁₂ hq₂ hp₁ (hpq_sq p q hp₂q₂)
      obtain ⟨S'', π'', hS''T, hS''B, hπ'', hcard''⟩ :=
        selmerStruct_insert_encard_of_unramified_basis K a₁ a₂ a₃ τ T B S' π' v₀ p q n
          hstart hT hS'T hS'B hπ' hv₀T hv₀B hv₀S' hcard' hp hq hv₀p₁ hv₀p₁₂ hv₀q₂
      exact ih S'' π'' hS''T hS''B hπ'' hcard''
  obtain ⟨S₀, π₀, hS₀T, hS₀B, hπ₀, hcard₀⟩ :=
    h_ind m ∅ (fun _ => 0) (Finset.disjoint_empty_left T) (Finset.disjoint_empty_left B)
      (by intro v hv; exact False.elim (Finset.notMem_empty v hv)) hm
  exact hB S₀ π₀ hS₀T hS₀B hπ₀ hcard₀

theorem ramLocal_iff_isSquare_of_evenVal_and_nonSquare (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hvT : v ∉ T)
    (π_v : v.adicCompletion K)
    (hπ_v : IsLocalUnif v π_v)
    (x : Kˣ) :
    (EvenVal v x →
      ((RamLocal a₁ a₂ a₃ v π_v x x ∨
        RamLocal a₁ a₂ a₃ v π_v x 1 ∨
        RamLocal a₁ a₂ a₃ v π_v 1 x) →
       IsSquare (algebraMap K (v.adicCompletion K) (x : K)))) ∧
    (¬ IsSquare (algebraMap K (v.adicCompletion K) ((a₁ - a₂) * (a₁ - a₃))) →
     ¬ IsSquare (algebraMap K (v.adicCompletion K) (-((a₁ - a₂) * (a₂ - a₃)))) →
     ¬ IsSquare (algebraMap K (v.adicCompletion K) ((a₁ - a₃) * (a₂ - a₃))) →
      ((RamLocal a₁ a₂ a₃ v π_v x x ∨
        RamLocal a₁ a₂ a₃ v π_v x 1 ∨
        RamLocal a₁ a₂ a₃ v π_v 1 x) →
       IsSquare (algebraMap K (v.adicCompletion K) (x : K)) ∧ EvenVal v x)) :=
by
  have hint₁ : IsIntegral ℤ a₁ := hstart.2.2.2.2.2.2.1
  have hint₂ : IsIntegral ℤ a₂ := hstart.2.2.2.2.2.2.2.1
  have hint₃ : IsIntegral ℤ a₃ := hstart.2.2.2.2.2.2.2.2.1
  let A₁ : NumberField.RingOfIntegers K := ⟨a₁, hint₁⟩
  let A₂ : NumberField.RingOfIntegers K := ⟨a₂, hint₂⟩
  let A₃ : NumberField.RingOfIntegers K := ⟨a₃, hint₃⟩
  have hval6 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 ≤ 1 := by
    have := v.valuation_le_one (K := K) (6 : NumberField.RingOfIntegers K)
    simpa using this
  have hval12_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 := by
    have := v.valuation_le_one (K := K) (A₁ - A₂)
    simpa [A₁, A₂] using this
  have hval13_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 := by
    have := v.valuation_le_one (K := K) (A₁ - A₃)
    simpa [A₁, A₃] using this
  have hval23_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) ≤ 1 := by
    have := v.valuation_le_one (K := K) (A₂ - A₃)
    simpa [A₂, A₃] using this
  have hgood : (IsDedekindDomain.HeightOneSpectrum.valuation K v)
      (6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)) = 1 := by
    have := (hT v).not.mp hvT
    exact not_ne_iff.mp this
  rw [map_mul, map_mul, map_mul] at hgood
  have h_le_prod1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 :=
    (mul_le_of_le_one_right' hval12_le).trans hval6
  have h_le_prod2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 :=
    (mul_le_of_le_one_right' hval13_le).trans h_le_prod1
  have hval23 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) = 1 :=
    le_antisymm hval23_le (by rw [← hgood]; exact mul_le_of_le_one_left' h_le_prod2)
  have hgood2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 := by
    rw [hval23, mul_one] at hgood
    exact hgood
  have hval13 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 :=
    le_antisymm hval13_le (by rw [← hgood2]; exact mul_le_of_le_one_left' h_le_prod1)
  have hgood1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 := by
    rw [hval13, mul_one] at hgood2
    exact hgood2
  have hval12 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 :=
    le_antisymm hval12_le (by rw [← hgood1]; exact mul_le_of_le_one_left' hval6)
  have hv_eq : ∀ k : K, Valued.v (algebraMap K (v.adicCompletion K) k) =
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) k :=
    fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v k
  have hv12 : Valued.v (algebraMap K (v.adicCompletion K) (a₁ - a₂)) = 1 := by
    rw [hv_eq, hval12]
  have hv13 : Valued.v (algebraMap K (v.adicCompletion K) (a₁ - a₃)) = 1 := by
    rw [hv_eq, hval13]
  have hv23 : Valued.v (algebraMap K (v.adicCompletion K) (a₂ - a₃)) = 1 := by
    rw [hv_eq, hval23]
  have hv_unit : ∀ u : Kˣ, Valued.v (algebraMap K (v.adicCompletion K) (u : K)) =
      ((v.valuationOfNeZero u : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
    intro u
    rw [hv_eq, ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v u]
  have heven_one : EvenVal v 1 := by
    dsimp [EvenVal]
    rw [map_one, toAdd_one]
    exact ⟨0, rfl⟩
  obtain ⟨n, hn_odd, hπ_val⟩ := hπ_v
  have h_even_of_sq_mul : ∀ (u : Kˣ) (c : v.adicCompletion K),
      Valued.v c = 1 →
      IsSquare (algebraMap K (v.adicCompletion K) (u : K) * c) →
      EvenVal v u := by
    intro u c hc ⟨r, hr⟩
    have h1 : Valued.v (algebraMap K (v.adicCompletion K) (u : K) * c) = Valued.v (r * r) :=
      congrArg Valued.v hr
    rw [map_mul, map_mul, hc, mul_one, hv_unit u] at h1
    have hr_ne : Valued.v r ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at h1
      exact WithZero.coe_ne_zero h1
    obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hr_ne
    rw [← hg, ← WithZero.coe_mul, WithZero.coe_inj] at h1
    have h2 := congrArg Multiplicative.toAdd h1
    rw [toAdd_mul] at h2
    exact ⟨Multiplicative.toAdd g, h2⟩
  have h_not_even_of_sq_pi_mul : ∀ (u : Kˣ) (c : v.adicCompletion K),
      Valued.v c = 1 →
      (∃ r : v.adicCompletion K,
        Valued.v (π_v * (algebraMap K (v.adicCompletion K) (u : K) * c)) = Valued.v (r * r)) →
      ¬ EvenVal v u := by
    intro u c hc ⟨r, h1⟩
    rw [map_mul, map_mul, map_mul, hπ_val, hv_unit u, hc, mul_one, ← WithZero.coe_mul] at h1
    have hr_ne : Valued.v r ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at h1
      exact WithZero.coe_ne_zero h1
    obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hr_ne
    rw [← hg, ← WithZero.coe_mul, WithZero.coe_inj] at h1
    have h2 := congrArg Multiplicative.toAdd h1
    rw [toAdd_mul, toAdd_mul, toAdd_ofAdd] at h2
    rintro ⟨d, hd⟩
    obtain ⟨l, hl⟩ := hn_odd
    omega
  have h_disj2_par : ∀ x₁ x₂ : Kˣ,
      IsSquare (algebraMap K (v.adicCompletion K) ((x₁ : K) * (a₁ - a₂) * (a₁ - a₃))) ∧
      IsSquare (π_v * algebraMap K (v.adicCompletion K) ((x₂ : K) * (a₁ - a₂))) →
      EvenVal v x₁ ∧ ¬ EvenVal v x₂ := by
    rintro x₁ x₂ ⟨h1, r, hr⟩
    refine ⟨?_, ?_⟩
    · apply h_even_of_sq_mul x₁
        (algebraMap K (v.adicCompletion K) (a₁ - a₂) * algebraMap K (v.adicCompletion K) (a₁ - a₃))
      · rw [map_mul, hv12, hv13, mul_one]
      · simpa [map_mul, mul_assoc] using h1
    · apply h_not_even_of_sq_pi_mul x₂ (algebraMap K (v.adicCompletion K) (a₁ - a₂)) hv12
      refine ⟨r, ?_⟩
      have := congrArg Valued.v hr
      simpa [map_mul] using this
  have h_disj3_par : ∀ x₁ x₂ : Kˣ,
      IsSquare (-(π_v * algebraMap K (v.adicCompletion K) ((x₁ : K) * (a₁ - a₂)))) ∧
      IsSquare (algebraMap K (v.adicCompletion K) (-((x₂ : K) * (a₁ - a₂) * (a₂ - a₃)))) →
      ¬ EvenVal v x₁ ∧ EvenVal v x₂ := by
    rintro x₁ x₂ ⟨⟨r, hr⟩, h2⟩
    refine ⟨?_, ?_⟩
    · apply h_not_even_of_sq_pi_mul x₁ (algebraMap K (v.adicCompletion K) (a₁ - a₂)) hv12
      refine ⟨r, ?_⟩
      have := congrArg Valued.v hr
      rw [Valuation.map_neg] at this
      simpa [map_mul] using this
    · apply h_even_of_sq_mul x₂
        (-(algebraMap K (v.adicCompletion K) (a₁ - a₂) * algebraMap K (v.adicCompletion K) (a₂ - a₃)))
      · rw [Valuation.map_neg, map_mul, hv12, hv23, mul_one]
      · have h2' : IsSquare (algebraMap K (v.adicCompletion K) (x₂ : K) *
            -(algebraMap K (v.adicCompletion K) (a₁ - a₂) * algebraMap K (v.adicCompletion K) (a₂ - a₃))) := by
          convert h2 using 1
          simp only [map_neg, map_mul]
          ring
        exact h2'
  have h_disj4_par : ∀ x₁ x₂ : Kˣ,
      IsSquare (-(π_v * algebraMap K (v.adicCompletion K) ((x₁ : K) * (a₁ - a₃)))) ∧
      IsSquare (-(π_v * algebraMap K (v.adicCompletion K) ((x₂ : K) * (a₂ - a₃)))) →
      ¬ EvenVal v x₁ ∧ ¬ EvenVal v x₂ := by
    rintro x₁ x₂ ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩
    refine ⟨?_, ?_⟩
    · apply h_not_even_of_sq_pi_mul x₁ (algebraMap K (v.adicCompletion K) (a₁ - a₃)) hv13
      refine ⟨r₁, ?_⟩
      have := congrArg Valued.v hr₁
      rw [Valuation.map_neg] at this
      simpa [map_mul] using this
    · apply h_not_even_of_sq_pi_mul x₂ (algebraMap K (v.adicCompletion K) (a₂ - a₃)) hv23
      refine ⟨r₂, ?_⟩
      have := congrArg Valued.v hr₂
      rw [Valuation.map_neg] at this
      simpa [map_mul] using this
  have h_part1_pair : ∀ x₁ x₂ : Kˣ,
      EvenVal v x₁ → EvenVal v x₂ → RamLocal a₁ a₂ a₃ v π_v x₁ x₂ →
      IsSquare (algebraMap K (v.adicCompletion K) (x₁ : K)) ∧
      IsSquare (algebraMap K (v.adicCompletion K) (x₂ : K)) := by
    intro x₁ x₂ hx₁ hx₂ hram
    rcases hram with h1 | h2 | h3 | h4
    · exact h1
    · exact False.elim ((h_disj2_par x₁ x₂ h2).2 hx₂)
    · exact False.elim ((h_disj3_par x₁ x₂ h3).1 hx₁)
    · exact False.elim ((h_disj4_par x₁ x₂ h4).1 hx₁)
  refine ⟨?_, ?_⟩
  · intro hx_even hram
    rcases hram with hxx | hx1 | h1x
    · exact (h_part1_pair x x hx_even hx_even hxx).1
    · exact (h_part1_pair x 1 hx_even heven_one hx1).1
    · exact (h_part1_pair 1 x heven_one hx_even h1x).2
  · intro hn₁ hn₂ hn₃ hram
    have hsq : IsSquare (algebraMap K (v.adicCompletion K) (x : K)) := by
      rcases hram with hxx | hx1 | h1x
      · rcases hxx with h1 | h2 | h3 | h4
        · exact h1.1
        · have hp := h_disj2_par x x h2
          exact False.elim (hp.2 hp.1)
        · have hp := h_disj3_par x x h3
          exact False.elim (hp.1 hp.2)
        · rcases h4 with ⟨⟨r₁, hr₁⟩, ⟨r₂, hr₂⟩⟩
          exfalso
          apply hn₃
          have hπ_ne : π_v ≠ 0 := by
            intro h0
            rw [h0, Valuation.map_zero] at hπ_val
            exact WithZero.coe_ne_zero hπ_val.symm
          have hx_ne : algebraMap K (v.adicCompletion K) (x : K) ≠ 0 :=
            (algebraMap K (v.adicCompletion K)).injective.ne x.ne_zero
          have hd_ne : π_v * algebraMap K (v.adicCompletion K) (x : K) ≠ 0 :=
            mul_ne_zero hπ_ne hx_ne
          refine ⟨(r₁ * r₂) / (π_v * algebraMap K (v.adicCompletion K) (x : K)), ?_⟩
          have hprod : (r₁ * r₁) * (r₂ * r₂) =
              (π_v * algebraMap K (v.adicCompletion K) (x : K)) ^ 2 *
                algebraMap K (v.adicCompletion K) ((a₁ - a₃) * (a₂ - a₃)) := by
            rw [← hr₁, ← hr₂]
            simp only [map_mul]
            ring
          calc algebraMap K (v.adicCompletion K) ((a₁ - a₃) * (a₂ - a₃))
            _ = ((π_v * algebraMap K (v.adicCompletion K) (x : K)) ^ 2 *
                  algebraMap K (v.adicCompletion K) ((a₁ - a₃) * (a₂ - a₃))) /
                (π_v * algebraMap K (v.adicCompletion K) (x : K)) ^ 2 := by
                rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 hd_ne)]
            _ = ((r₁ * r₁) * (r₂ * r₂)) /
                (π_v * algebraMap K (v.adicCompletion K) (x : K)) ^ 2 := by
                rw [hprod]
            _ = ((r₁ * r₂) / (π_v * algebraMap K (v.adicCompletion K) (x : K))) *
                ((r₁ * r₂) / (π_v * algebraMap K (v.adicCompletion K) (x : K))) := by
                ring
      · rcases hx1 with h1 | h2 | h3 | h4
        · exact h1.1
        · exact False.elim ((h_disj2_par x 1 h2).2 heven_one)
        · exfalso
          apply hn₂
          have h3' := h3.2
          rw [Units.val_one, one_mul] at h3'
          exact h3'
        · exact False.elim ((h_disj4_par x 1 h4).2 heven_one)
      · rcases h1x with h1 | h2 | h3 | h4
        · exact h1.2
        · exfalso
          apply hn₁
          have h2' := h2.1
          rw [Units.val_one, one_mul] at h2'
          exact h2'
        · exact False.elim ((h_disj3_par 1 x h3).1 heven_one)
        · exact False.elim ((h_disj4_par 1 x h4).1 heven_one)
    refine ⟨hsq, ?_⟩
    apply h_even_of_sq_mul x 1 (Valuation.map_one _)
    simpa using hsq

theorem hasPrincipalNonSquareExtension_of_chebotarev (K : Type u) [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
    HasPrincipalNonSquareExtension K T :=
by
  intro S κ w₁ w₂ w₃ w₄ hdisj hprin hind
  have h_galois :
      ∃ (L : Type u) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : IsGalois K L)
        (α₁ α₂ α₃ α₄ : L) (σ₀ : L ≃ₐ[K] L),
        α₁ ^ 2 = algebraMap K L (w₁ : K) ∧
        α₂ ^ 2 = algebraMap K L (w₂ : K) ∧
        α₃ ^ 2 = algebraMap K L (w₃ : K) ∧
        α₄ ^ 2 = algebraMap K L (w₄ : K) ∧
        σ₀ α₁ = -α₁ ∧
        σ₀ α₂ = -α₂ ∧
        σ₀ α₃ = -α₃ ∧
        σ₀ α₄ = -α₄ := by
    have h_s1 :
        ∃ (L : Type u) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : IsGalois K L)
          (y₁ y₂ y₃ y₄ : L),
          y₁ ^ 2 = algebraMap K L (w₁ : K) ∧
          y₂ ^ 2 = algebraMap K L (w₂ : K) ∧
          y₃ ^ 2 = algebraMap K L (w₃ : K) ∧
          y₄ ^ 2 = algebraMap K L (w₄ : K) ∧
          ∀ (E : Type u) [Field E] [Algebra K E]
            (r₁ r₂ r₃ r₄ : E) (σ_E : E ≃ₐ[K] E) (_ι : E →ₐ[K] L),
            r₁ ^ 2 = algebraMap K E (w₁ : K) →
            r₂ ^ 2 = algebraMap K E (w₂ : K) →
            r₃ ^ 2 = algebraMap K E (w₃ : K) →
            r₄ ^ 2 = algebraMap K E (w₄ : K) →
            σ_E r₁ = -r₁ →
            σ_E r₂ = -r₂ →
            σ_E r₃ = -r₃ →
            σ_E r₄ = -r₄ →
            ∃ (α₁ α₂ α₃ α₄ : L) (σ₀ : L ≃ₐ[K] L),
              α₁ ^ 2 = algebraMap K L (w₁ : K) ∧
              α₂ ^ 2 = algebraMap K L (w₂ : K) ∧
              α₃ ^ 2 = algebraMap K L (w₃ : K) ∧
              α₄ ^ 2 = algebraMap K L (w₄ : K) ∧
              σ₀ α₁ = -α₁ ∧
              σ₀ α₂ = -α₂ ∧
              σ₀ α₃ = -α₃ ∧
              σ₀ α₄ = -α₄ := by
      let p₁ : K[X] := X ^ 2 - C (w₁ : K)
      let p₂ : K[X] := X ^ 2 - C (w₂ : K)
      let p₃ : K[X] := X ^ 2 - C (w₃ : K)
      let p₄ : K[X] := X ^ 2 - C (w₄ : K)
      let f : K[X] := p₁ * p₂ * p₃ * p₄
      let L := f.SplittingField
      have hGal : IsGalois K L := IsGalois.mk
      have hNF : NumberField L := @NumberField.mk L _ inferInstance (Module.Finite.trans K L)
      have h_root : ∀ (w : K), (X ^ 2 - C w) ∣ f → ∃ y : L, y ^ 2 = algebraMap K L w := by
        intro w h_dvd
        have hp₁ : p₁ ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (w₁ : K)
        have hp₂ : p₂ ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (w₂ : K)
        have hp₃ : p₃ ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (w₃ : K)
        have hp₄ : p₄ ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (w₄ : K)
        have hf0 : f ≠ 0 := mul_ne_zero (mul_ne_zero (mul_ne_zero hp₁ hp₂) hp₃) hp₄
        have h_splits_f : (Polynomial.map (algebraMap K L) f).Splits :=
          Polynomial.SplittingField.splits f
        have h_map_f0 : Polynomial.map (algebraMap K L) f ≠ 0 :=
          Polynomial.map_ne_zero hf0
        have h_dvd_map : Polynomial.map (algebraMap K L) (X ^ 2 - C w) ∣
            Polynomial.map (algebraMap K L) f :=
          Polynomial.map_dvd (algebraMap K L) h_dvd
        have h_splits_w : (Polynomial.map (algebraMap K L) (X ^ 2 - C w)).Splits :=
          h_splits_f.of_dvd h_map_f0 h_dvd_map
        have h_map_eq : Polynomial.map (algebraMap K L) (X ^ 2 - C w) =
            X ^ 2 - C (algebraMap K L w) := by simp
        rw [h_map_eq] at h_splits_w
        have h_deg : (X ^ 2 - C (algebraMap K L w)).degree ≠ 0 := by
          rw [Polynomial.degree_X_pow_sub_C (by decide : 0 < 2)]
          decide
        obtain ⟨y, hy⟩ := h_splits_w.exists_eval_eq_zero h_deg
        simp only [eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero] at hy
        exact ⟨y, hy⟩
      obtain ⟨y₁, hy₁⟩ := h_root (w₁ : K)
        (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_right p₁ p₂) p₃) p₄)
      obtain ⟨y₂, hy₂⟩ := h_root (w₂ : K)
        (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_left p₂ p₁) p₃) p₄)
      obtain ⟨y₃, hy₃⟩ := h_root (w₃ : K)
        (dvd_mul_of_dvd_left (dvd_mul_left p₃ (p₁ * p₂)) p₄)
      obtain ⟨y₄, hy₄⟩ := h_root (w₄ : K)
        (dvd_mul_left p₄ (p₁ * p₂ * p₃))
      refine ⟨L, inferInstance, hNF, inferInstance, hGal, y₁, y₂, y₃, y₄, hy₁, hy₂, hy₃, hy₄, ?_⟩
      intro E hFieldE hAlgKE r₁ r₂ r₃ r₄ σ_E ι hr₁ hr₂ hr₃ hr₄ hσ₁ hσ₂ hσ₃ hσ₄
      letI : Algebra E L := ι.toRingHom.toAlgebra
      have h_tower_eq : ∀ x : K, (algebraMap E L) (algebraMap K E x) = algebraMap K L x :=
        fun x => ι.commutes x
      haveI : IsScalarTower K E L := IsScalarTower.of_algebraMap_eq (fun x => (h_tower_eq x).symm)
      let σ₀ : L ≃ₐ[K] L := AlgEquiv.liftNormal σ_E L
      refine ⟨algebraMap E L r₁, algebraMap E L r₂, algebraMap E L r₃, algebraMap E L r₄, σ₀,
        ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [← map_pow, hr₁, h_tower_eq]
      · rw [← map_pow, hr₂, h_tower_eq]
      · rw [← map_pow, hr₃, h_tower_eq]
      · rw [← map_pow, hr₄, h_tower_eq]
      · rw [AlgEquiv.liftNormal_commutes, hσ₁, map_neg]
      · rw [AlgEquiv.liftNormal_commutes, hσ₂, map_neg]
      · rw [AlgEquiv.liftNormal_commutes, hσ₃, map_neg]
      · rw [AlgEquiv.liftNormal_commutes, hσ₄, map_neg]
    have h_s2 :
        ∀ (L F : Type u) [Field L] [Algebra K L] [Field F] [CharZero F] [Algebra K F]
          (σ : F ≃ₐ[K] F) (_ι : F →ₐ[K] L)
          (d₀ : K), ¬ IsSquare (algebraMap K F d₀) →
          ∀ (y : L), y ^ 2 = algebraMap K L d₀ →
          ∃ (F' : Type u) (_ : Field F') (_ : CharZero F')
            (_ : Algebra K F') (j : F →+* F')
            (ω : F') (σ' : F' ≃ₐ[K] F') (_ι' : F' →ₐ[K] L),
            (∀ x : K, j (algebraMap K F x) = algebraMap K F' x) ∧
            ω ^ 2 = algebraMap K F' d₀ ∧
            σ' ω = -ω ∧
            (∀ u : F, σ' (j u) = j (σ u)) ∧
            (∀ x : K, IsSquare (algebraMap K F' x) →
              ∃ e : Fin 2, IsSquare (algebraMap K F (x * d₀ ^ (e : ℕ)))) := by
      intro L F hFieldL hAlgKL hFieldF hCharF hAlgKF σ ι d₀ hd y hy
      let d : F := algebraMap K F d₀
      haveI : Fact (∀ r : F, r ^ 2 ≠ d + 0 * r) :=
        ⟨fun r hr => hd ⟨r, by linear_combination -hr⟩⟩
      haveI : CharZero (QuadraticAlgebra F d 0) :=
        charZero_of_injective_algebraMap (algebraMap F (QuadraticAlgebra F d 0)).injective
      let ω : QuadraticAlgebra F d 0 := ⟨0, 1⟩
      have hσd : σ d = d := σ.commutes d₀
      let σ' : QuadraticAlgebra F d 0 ≃ₐ[K] QuadraticAlgebra F d 0 :=
        { toFun := fun z => ⟨σ z.re, -σ z.im⟩
          invFun := fun z => ⟨σ.symm z.re, -σ.symm z.im⟩
          left_inv := fun z => by ext <;> simp
          right_inv := fun z => by ext <;> simp
          map_mul' := fun z₁ z₂ => by
            ext
            · change σ (z₁.re * z₂.re + d * z₁.im * z₂.im) =
                σ z₁.re * σ z₂.re + d * (-σ z₁.im) * (-σ z₂.im)
              simp only [map_add, map_mul, hσd]
              ring
            · change -σ (z₁.re * z₂.im + z₁.im * z₂.re + 0 * z₁.im * z₂.im) =
                σ z₁.re * (-σ z₂.im) + (-σ z₁.im) * σ z₂.re + 0 * (-σ z₁.im) * (-σ z₂.im)
              simp only [map_add, map_mul, map_zero]
              ring
          map_add' := fun z₁ z₂ => by
            ext
            · exact map_add σ z₁.re z₂.re
            · change -σ (z₁.im + z₂.im) = -σ z₁.im + -σ z₂.im
              rw [map_add, neg_add]
          commutes' := fun k => by
            ext
            · exact σ.commutes k
            · change -σ (0 : F) = 0
              simp }
      letI : Algebra F L := ι.toRingHom.toAlgebra
      haveI : IsScalarTower K F L :=
        IsScalarTower.of_algebraMap_eq (fun x => (ι.commutes x).symm)
      have hy_quad : y * y = d • (1 : L) + (0 : F) • y := by
        have h1 : y * y = algebraMap K L d₀ := by rw [← sq, hy]
        have h2 : d • (1 : L) = algebraMap K L d₀ := by
          rw [Algebra.smul_def, mul_one]
          exact ι.commutes d₀
        rw [h1, h2, zero_smul, add_zero]
      let ι_F : QuadraticAlgebra F d 0 →ₐ[F] L := QuadraticAlgebra.lift ⟨y, hy_quad⟩
      let ι' : QuadraticAlgebra F d 0 →ₐ[K] L := ι_F.restrictScalars K
      refine ⟨QuadraticAlgebra F d 0, inferInstance, inferInstance, inferInstance,
        algebraMap F (QuadraticAlgebra F d 0), ω, σ', ι', ?_, ?_, ?_, ?_, ?_⟩
      · intro x
        rfl
      · rw [sq]
        ext
        · change (0 : F) * 0 + d * 1 * 1 = d
          ring
        · change (0 : F) * 1 + 1 * 0 + 0 * 1 * 1 = 0
          ring
      · ext
        · change σ 0 = -(0 : F)
          simp
        · change -σ 1 = -(1 : F)
          simp
      · intro u
        ext
        · rfl
        · change -σ 0 = 0
          simp
      · intro x ⟨z, hz⟩
        have h_re : z.re * z.re + d * z.im * z.im = algebraMap K F x := by
          have := congrArg QuadraticAlgebra.re hz.symm
          simpa [QuadraticAlgebra.re_mul] using this
        have h_im : z.re * z.im + z.im * z.re + 0 * z.im * z.im = 0 := by
          have := congrArg QuadraticAlgebra.im hz.symm
          simpa [QuadraticAlgebra.im_mul] using this
        have h_prod : (2 : F) * z.re * z.im = 0 := by linear_combination h_im
        have h2 : (2 : F) ≠ 0 := two_ne_zero
        rcases mul_eq_zero.mp h_prod with h_2re | h_im0
        · have h_re0 : z.re = 0 := (mul_eq_zero.mp h_2re).resolve_left h2
          refine ⟨1, d * z.im, ?_⟩
          change algebraMap K F (x * d₀ ^ 1) = (d * z.im) * (d * z.im)
          rw [pow_one, map_mul]
          change algebraMap K F x * d = (d * z.im) * (d * z.im)
          linear_combination -d * h_re + d * z.re * h_re0
        · refine ⟨0, z.re, ?_⟩
          change algebraMap K F (x * d₀ ^ 0) = z.re * z.re
          rw [pow_zero, mul_one]
          linear_combination -h_re + d * z.im * h_im0
    obtain ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, y₁, y₂, y₃, y₄, hy₁, hy₂, hy₃, hy₄, h_lift⟩ := h_s1
    letI : Field L := hFieldL
    letI : NumberField L := hNFL
    letI : Algebra K L := hAlgKL
    letI : IsGalois K L := hGalKL
    have hw₁_nsq : ¬ IsSquare (algebraMap K K (w₁ : K)) := by
      intro hsq
      have hsq' : IsSquare ((w₁ : K) ^ (1 : Fin 2).1 * (w₂ : K) ^ (0 : Fin 2).1 *
          (w₃ : K) ^ (0 : Fin 2).1 * (w₄ : K) ^ (0 : Fin 2).1) := by
        simpa using hsq
      exact (by decide : (1 : Fin 2) ≠ 0) (hind 1 0 0 0 hsq').1
    obtain ⟨K₁, hFieldK₁, hCharK₁, hAlgKK₁, _, ω₁, σ₁, ι₁, _, hω₁_sq, hσ₁_ω₁, _, h_desc₁⟩ :=
