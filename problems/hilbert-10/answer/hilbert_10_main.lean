      ring
    rw [hpow]
    exact mul_div_mul_left _ _ (pow_ne_zero 6 hπK_ne)
  let v_π : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    ⟨Ideal.span {π}, (Ideal.span_singleton_prime hπ_ne).mpr hπ_prime,
      Ideal.span_singleton_eq_bot.not.mpr hπ_ne⟩
  have hD₀_not_mem_v_π : D₀ ∉ v_π.asIdeal := by
    intro hD₀
    obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hπ_mod
    have hy' : π - 1 = D₀ * (4 * y) := by
