      have hc_u_eq : (sqCl u₁, sqCl u₁) = c_u := by
        ext
        · exact hsq_u₁
        · exact hsq_u₁.trans hc_u_diag
      have hu₁_ne_one : sqCl u₁ ≠ 1 := by
        intro h1
        apply hc_u_ne
        rw [← hc_u_eq, h1]
        rfl
      have hu₁_ev : EvenVal v₁ u₁ :=
        (hE_iff u₁).mp (hsq_u₁ ▸ (hV_E c_u hc_u_V).1)
      refine ⟨hW_card, w, (u₁, u₁), hw_W, hc_u_eq.symm ▸ hc_u_W, ?_, ?_, ?_, ?_⟩
      · exact hnot_sq_of_odd w.1 hw1_odd
      · exact hnot_sq_of_not_local_sq (w.1 * w.2) hw12_nsq
      · exact fun hsq => hu₁_ne_one ((hsqCl_eq_one_iff u₁).mpr hsq)
      · apply hnot_sq_of_odd (w.2 * u₁)
        rw [hloc_ev_mul]
        intro hiff
        exact hw2_odd (hiff.mpr hu₁_ev)
  
  rcases hker with ⟨hker1, hx1, hδ1⟩ | ⟨hker2, hx2, hδ2⟩ | ⟨hker3, hx3, hδ3⟩
