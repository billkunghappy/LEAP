        (nhds (ENNReal.ofReal ((Nat.card C : ℝ) / (Nat.card (L ≃ₐ[K] L) : ℝ)))) :=
      chebotarev_density_theorem (K := K) (L := L) C hC_conj
    have hCheb_empty_raw : Filter.Tendsto (dirichletQuot S_empty)
