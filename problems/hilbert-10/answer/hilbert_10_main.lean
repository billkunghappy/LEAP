        subst hk5; exact hz5_1
      · exact hd3.2.1
    have h5_not : (5 : Fin 6) ∉ I := by
      apply hnotMem (algebraMap K (𝔮₃.adicCompletion K)) I (fun k => (z k).2) 5 hz5_2
      · intro k hkI hk5
        have hk0 : k ≠ 0 := fun h => h0_not (h ▸ hkI)
        have hk1 : k ≠ 1 := fun h => h1_not (h ▸ hkI)
        have hk2 : k ≠ 2 := fun h => h2_not (h ▸ hkI)
        have hk3 : k ≠ 3 := fun h => h3_not (h ▸ hkI)
        have hk4 : k = 4 := by omega
        subst hk4; exact hz4_2
      · exact hd3.2.2
    have hI_empty : I = ∅ := by
      rw [Finset.eq_empty_iff_forall_notMem]
      intro k hkI
      have hk_cases : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 := by omega
      rcases hk_cases with rfl | rfl | rfl | rfl | rfl | rfl
      · exact h0_not hkI
      · exact h1_not hkI
      · exact h2_not hkI
      · exact h3_not hkI
      · exact h4_not hkI
      · exact h5_not hkI
    rw [← hcp₀, hI_raw, hI_empty, Finset.prod_empty]
  
  have isDescentClass_twist_g1 : ∀ {F : Type u} [Field F] (a₁ a₂ a₃ t d₁ d₂ : F),
      a₁ ≠ a₂ → t ≠ 0 → d₁ ≠ 0 →
      IsDescentClass (t * a₁) (t * a₂) (t * a₃) d₁ d₂ →
      IsDescentClass (t * a₁) (t * a₂) (t * a₃)
        (d₁ * (a₁ - a₂) * (a₁ - a₃)) (t * (d₂ * (a₁ - a₂))) := by
    intro F _ a₁ a₂ a₃ t d₁ d₂ h₁₂ ht hd₁ ⟨z₀, z₁, z₂, z₃, hnz, hq₁, hq₂⟩
    have hα : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr h₁₂
    refine ⟨(a₁ - a₂) * d₁ * z₁, t * (a₁ - a₂) * z₀, (a₁ - a₂) * d₁ * z₃, z₂, ?_, ?_, ?_⟩
    · rintro ⟨hw₀, hw₁, hw₂, hw₃⟩
      apply hnz
      have hz₁ : z₁ = 0 := (mul_eq_zero.mp hw₀).resolve_left (mul_ne_zero hα hd₁)
      have hz₀ : z₀ = 0 := (mul_eq_zero.mp hw₁).resolve_left (mul_ne_zero ht hα)
      have hz₃ : z₃ = 0 := (mul_eq_zero.mp hw₂).resolve_left (mul_ne_zero hα hd₁)
      exact ⟨hz₀, hz₁, hw₃, hz₃⟩
    · linear_combination d₁ * t * (a₁ - a₂) ^ 3 * hq₂
    · linear_combination d₁ * t * (a₁ - a₂) ^ 2 * (a₁ - a₃) * hq₁
  have isDescentClass_twist_g2 : ∀ {F : Type u} [Field F] (a₁ a₂ a₃ t d₁ d₂ : F),
      a₁ ≠ a₂ → t ≠ 0 → d₂ ≠ 0 →
      IsDescentClass (t * a₁) (t * a₂) (t * a₃) d₁ d₂ →
      IsDescentClass (t * a₁) (t * a₂) (t * a₃)
        (-(t * (d₁ * (a₁ - a₂)))) (-(d₂ * (a₁ - a₂) * (a₂ - a₃))) := by
    intro F _ a₁ a₂ a₃ t d₁ d₂ h₁₂ ht hd₂ ⟨z₀, z₁, z₂, z₃, hnz, hq₁, hq₂⟩
    have hα : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr h₁₂
    refine ⟨(a₁ - a₂) * d₂ * z₂, (a₁ - a₂) * d₂ * z₃, t * (a₁ - a₂) * z₀, z₁, ?_, ?_, ?_⟩
    · rintro ⟨hw₀, hw₁, hw₂, hw₃⟩
      apply hnz
      have hz₂ : z₂ = 0 := (mul_eq_zero.mp hw₀).resolve_left (mul_ne_zero hα hd₂)
      have hz₃ : z₃ = 0 := (mul_eq_zero.mp hw₁).resolve_left (mul_ne_zero hα hd₂)
      have hz₀ : z₀ = 0 := (mul_eq_zero.mp hw₂).resolve_left (mul_ne_zero ht hα)
      exact ⟨hz₀, hw₃, hz₂, hz₃⟩
    · linear_combination d₂ * t * (a₁ - a₂) ^ 3 * (hq₂ - hq₁)
    · linear_combination d₂ * t * (a₁ - a₂) ^ 3 * hq₂ - d₂ * t * (a₁ - a₂) ^ 2 * (a₁ - a₃) * hq₁
  have isDescentClass_twist_g3 : ∀ {F : Type u} [Field F] (a₁ a₂ a₃ t d₁ d₂ : F),
      d₁ ≠ 0 → d₂ ≠ 0 →
      IsDescentClass (t * a₁) (t * a₂) (t * a₃) d₁ d₂ →
      IsDescentClass (t * a₁) (t * a₂) (t * a₃)
        (-(t * (d₁ * (a₁ - a₃)))) (-(t * (d₂ * (a₂ - a₃)))) := by
    intro F _ a₁ a₂ a₃ t d₁ d₂ hd₁ hd₂ ⟨z₀, z₁, z₂, z₃, hnz, hq₁, hq₂⟩
    refine ⟨d₁ * d₂ * z₃, d₂ * z₂, d₁ * z₁, z₀, ?_, ?_, ?_⟩
    · rintro ⟨hw₀, hw₁, hw₂, hw₃⟩
      apply hnz
      have hz₃ : z₃ = 0 := (mul_eq_zero.mp hw₀).resolve_left (mul_ne_zero hd₁ hd₂)
      have hz₂ : z₂ = 0 := (mul_eq_zero.mp hw₁).resolve_left hd₂
      have hz₁ : z₁ = 0 := (mul_eq_zero.mp hw₂).resolve_left hd₁
      exact ⟨hw₃, hz₁, hz₂, hz₃⟩
    · linear_combination d₁ * d₂ * t * (a₁ - a₃) * hq₁ - d₁ * d₂ * t * (a₁ - a₂) * hq₂
    · linear_combination d₁ * d₂ * t * (a₁ - a₃) * (hq₁ - hq₂)
  have isDescentClass_untwist : ∀ {F : Type u} [Field F] (a₁ a₂ a₃ t d₁ d₂ : F),
      t ≠ 0 → IsSquare t →
      IsDescentClass (t * a₁) (t * a₂) (t * a₃) d₁ d₂ →
      IsDescentClass a₁ a₂ a₃ d₁ d₂ := by
    intro F _ a₁ a₂ a₃ t d₁ d₂ ht ⟨s, hs⟩ ⟨z₀, z₁, z₂, z₃, hnz, hq₁, hq₂⟩
    have hs0 : s ≠ 0 := by rintro rfl; rw [mul_zero] at hs; exact ht hs
    refine ⟨s * z₀, z₁, z₂, z₃, ?_, ?_, ?_⟩
    · rintro ⟨hw₀, hz₁, hz₂, hz₃⟩
      exact hnz ⟨(mul_eq_zero.mp hw₀).resolve_left hs0, hz₁, hz₂, hz₃⟩
    · rw [hs] at hq₁; linear_combination hq₁
    · rw [hs] at hq₂; linear_combination hq₂
  
  have hloc : ∀ v ∉ T, ∀ p : Kˣ × Kˣ,
      IsDescentClass
        (algebraMap K (v.adicCompletion K) ((t : K) * a₁))
        (algebraMap K (v.adicCompletion K) ((t : K) * a₂))
        (algebraMap K (v.adicCompletion K) ((t : K) * a₃))
        (algebraMap K (v.adicCompletion K) (p.1 : K))
        (algebraMap K (v.adicCompletion K) (p.2 : K)) →
      (EvenVal v t → EvenVal v p.1 ∧ EvenVal v p.2) ∧
      (IsLocalUnif v (algebraMap K (v.adicCompletion K) (t : K)) →
        RamLocal a₁ a₂ a₃ v (algebraMap K (v.adicCompletion K) (t : K)) p.1 p.2) := by
    intro v hvT p hdesc
    obtain ⟨hval2, hval12, hval13, hval23⟩ := h_good_vals v hvT
    have hv_eq : ∀ k : K, Valued.v (algebraMap K (v.adicCompletion K) k) =
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) k :=
      fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v k
    let f := algebraMap K (v.adicCompletion K)
    have hv12 : Valued.v (f (a₁ - a₂)) = 1 := by rw [hv_eq, hval12]
    have hv13 : Valued.v (f (a₁ - a₃)) = 1 := by rw [hv_eq, hval13]
    have hv23 : Valued.v (f (a₂ - a₃)) = 1 := by rw [hv_eq, hval23]
    have hv21 : Valued.v (f a₂ - f a₁) = 1 := by
      rw [← map_sub, show a₂ - a₁ = -(a₁ - a₂) by ring, map_neg, Valuation.map_neg, hv12]
    have hv31 : Valued.v (f a₃ - f a₁) = 1 := by
      rw [← map_sub, show a₃ - a₁ = -(a₁ - a₃) by ring, map_neg, Valuation.map_neg, hv13]
    have hv32 : Valued.v (f a₃ - f a₂) = 1 := by
      rw [← map_sub, show a₃ - a₂ = -(a₂ - a₃) by ring, map_neg, Valuation.map_neg, hv23]
    have heven_iff : ∀ x : Kˣ, EvenVal v x ↔ IsSquare (Valued.v (f (x : K))) := by
      intro x
      constructor
      · rintro ⟨k, hk⟩
        refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
        rw [hv_eq, ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v x,
          ← WithZero.coe_mul, WithZero.coe_inj, ← ofAdd_add, ← hk, ofAdd_toAdd]
      · rintro ⟨r, hr⟩
        rw [hv_eq, ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v x] at hr
        have hr_ne : r ≠ 0 := by
          rintro rfl; rw [mul_zero] at hr; exact WithZero.coe_ne_zero hr
        obtain ⟨g, rfl⟩ := WithZero.ne_zero_iff_exists.mp hr_ne
        rw [← WithZero.coe_mul, WithZero.coe_inj] at hr
        exact ⟨Multiplicative.toAdd g, by rw [hr, toAdd_mul]⟩
    have h_sq_mul_sq : ∀ (d z : v.adicCompletion K),
        IsSquare (Valued.v d) → IsSquare (Valued.v (d * z ^ 2)) := by
      rintro d z ⟨r, hr⟩
      refine ⟨r * Valued.v z, ?_⟩
      rw [map_mul, sq, map_mul, hr]; ac_rfl
    have h_zero_of_not_sq_mul_sq : ∀ (d z : v.adicCompletion K),
        ¬ IsSquare (Valued.v d) → IsSquare (Valued.v (d * z ^ 2)) → d * z ^ 2 = 0 := by
      intro d z hd ⟨r, hr⟩
      by_cases hz : z = 0
      · simp [hz]
      · exfalso
        have hzv : Valued.v z ≠ 0 := (Valuation.ne_zero_iff Valued.v).mpr hz
        have h1 : Valued.v d * (Valued.v z * Valued.v z) = r * r := by
          simpa [sq, map_mul] using hr
        have h2 : Valued.v d = (r * (Valued.v z)⁻¹) * (r * (Valued.v z)⁻¹) := by
          calc Valued.v d
            _ = Valued.v d * (Valued.v z * (Valued.v z)⁻¹) * (Valued.v z * (Valued.v z)⁻¹) := by
                rw [mul_inv_cancel₀ hzv, mul_one, mul_one]
            _ = (Valued.v d * (Valued.v z * Valued.v z)) * ((Valued.v z)⁻¹ * (Valued.v z)⁻¹) := by
                ac_rfl
            _ = (r * r) * ((Valued.v z)⁻¹ * (Valued.v z)⁻¹) := by rw [h1]
            _ = (r * (Valued.v z)⁻¹) * (r * (Valued.v z)⁻¹) := by ac_rfl
        exact hd ⟨r * (Valued.v z)⁻¹, h2⟩
    have h_not_sq_mul_of_not_sq_of_sq : ∀ (γ₁ γ₂ : WithZero (Multiplicative ℤ)),
        γ₂ ≠ 0 → ¬ IsSquare γ₁ → IsSquare γ₂ → ¬ IsSquare (γ₁ * γ₂) := by
      rintro γ₁ γ₂ hγ₂_ne h1 ⟨s, rfl⟩ ⟨r, hr⟩
      have hs_ne : s ≠ 0 := by rintro rfl; exact hγ₂_ne (mul_zero 0)
      have h2 : γ₁ = (r * s⁻¹) * (r * s⁻¹) := by
        calc γ₁
          _ = γ₁ * (s * s⁻¹) * (s * s⁻¹) := by rw [mul_inv_cancel₀ hs_ne, mul_one, mul_one]
          _ = (γ₁ * (s * s)) * (s⁻¹ * s⁻¹) := by ac_rfl
          _ = (r * r) * (s⁻¹ * s⁻¹) := by rw [hr]
          _ = (r * s⁻¹) * (r * s⁻¹) := by ac_rfl
      exact h1 ⟨r * s⁻¹, h2⟩
    have h_sq_mul_of_not_sq_of_not_sq : ∀ (γ₁ γ₂ : WithZero (Multiplicative ℤ)),
        γ₁ ≠ 0 → γ₂ ≠ 0 → ¬ IsSquare γ₁ → ¬ IsSquare γ₂ → IsSquare (γ₁ * γ₂) := by
      intro γ₁ γ₂ hγ₁_ne hγ₂_ne h1 h2
      obtain ⟨g₁, rfl⟩ := WithZero.ne_zero_iff_exists.mp hγ₁_ne
      obtain ⟨g₂, rfl⟩ := WithZero.ne_zero_iff_exists.mp hγ₂_ne
      have hn₁ : ¬ Even (Multiplicative.toAdd g₁) := by
        rintro ⟨k, hk⟩; apply h1
        refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
        rw [← WithZero.coe_mul, ← ofAdd_add, ← hk, ofAdd_toAdd]
      have hn₂ : ¬ Even (Multiplicative.toAdd g₂) := by
        rintro ⟨k, hk⟩; apply h2
        refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
        rw [← WithZero.coe_mul, ← ofAdd_add, ← hk, ofAdd_toAdd]
      have heven : Even (Multiplicative.toAdd g₁ + Multiplicative.toAdd g₂) := by
        rcases Int.even_or_odd (Multiplicative.toAdd g₁) with h | ⟨l₁, hl₁⟩
        · exact False.elim (hn₁ h)
        · rcases Int.even_or_odd (Multiplicative.toAdd g₂) with h | ⟨l₂, hl₂⟩
          · exact False.elim (hn₂ h)
          · exact ⟨l₁ + l₂ + 1, by omega⟩
      obtain ⟨k, hk⟩ := heven
      refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
      rw [← WithZero.coe_mul, ← WithZero.coe_mul, WithZero.coe_inj, ← ofAdd_add, ← hk,
        ofAdd_add, ofAdd_toAdd, ofAdd_toAdd]
    have h_lt_of_not_sq_diff : ∀ (X Y : v.adicCompletion K) (R : WithZero (Multiplicative ℤ)),
        (IsSquare (Valued.v X) → X = 0) →
        IsSquare (Valued.v Y) →
        IsSquare R →
        Valued.v (X - Y) = R →
        R ≠ 0 →
        Valued.v X < R := by
      intro X Y R hX hY hR hdY hR_ne
      have hXR : Valued.v X ≠ R := by
        intro h_eq; have hX0 : X = 0 := hX (h_eq ▸ hR)
        rw [hX0, Valuation.map_zero] at h_eq; exact hR_ne h_eq.symm
      have hXY : Valued.v X ≠ Valued.v (-Y) := by
        intro h_eq; rw [Valuation.map_neg] at h_eq
        have hX0 : X = 0 := hX (h_eq.symm ▸ hY)
        rw [hX0, Valuation.map_zero] at h_eq
        have hY0 : Y = 0 := (Valuation.zero_iff Valued.v).mp h_eq.symm
        rw [hX0, hY0, sub_self, Valuation.map_zero] at hdY
        exact hR_ne hdY.symm
      have hmax : R = max (Valued.v X) (Valued.v (-Y)) := by
        rw [← hdY, sub_eq_add_neg]; exact Valuation.map_add_of_distinct_val Valued.v hXY
      exact lt_of_le_of_ne (by rw [hmax]; exact le_max_left _ _) hXR
    have h_ultrametric_elim : ∀ (X₁ X₂ Y : v.adicCompletion K) (R : WithZero (Multiplicative ℤ)),
        (IsSquare (Valued.v X₁) → X₁ = 0) →
        (IsSquare (Valued.v X₂) → X₂ = 0) →
        IsSquare (Valued.v Y) →
        IsSquare R →
        Valued.v (X₁ - Y) = R →
        Valued.v (X₂ - Y) = R →
        Valued.v (X₁ - X₂) = R →
        R = 0 ∧ X₁ = 0 ∧ X₂ = 0 ∧ Y = 0 := by
      intro X₁ X₂ Y R hX₁ hX₂ hY hR hd₁Y hd₂Y hd₁₂
      have hR0 : R = 0 := by
        by_contra hR_ne
        have hlt₁ : Valued.v X₁ < R := h_lt_of_not_sq_diff X₁ Y R hX₁ hY hR hd₁Y hR_ne
        have hlt₂ : Valued.v X₂ < R := h_lt_of_not_sq_diff X₂ Y R hX₂ hY hR hd₂Y hR_ne
        have hle : R ≤ max (Valued.v X₁) (Valued.v X₂) := by
          rw [← hd₁₂]; exact Valuation.map_sub Valued.v X₁ X₂
        exact lt_irrefl R (lt_of_le_of_lt hle (max_lt hlt₁ hlt₂))
      have hX₁Y : X₁ = Y := sub_eq_zero.mp ((Valuation.zero_iff Valued.v).mp (hR0 ▸ hd₁Y))
      have hX₂Y : X₂ = Y := sub_eq_zero.mp ((Valuation.zero_iff Valued.v).mp (hR0 ▸ hd₂Y))
      have hX₁0 : X₁ = 0 := hX₁ (hX₁Y.symm ▸ hY)
      have hY0 : Y = 0 := hX₁Y.symm.trans hX₁0
      have hX₂0 : X₂ = 0 := hX₂Y.trans hY0
      exact ⟨hR0, hX₁0, hX₂0, hY0⟩
    have hft_ne : f (t : K) ≠ 0 := f.injective.ne t.ne_zero
    have hvt_ne : Valued.v (f (t : K)) ≠ 0 := (Valuation.ne_zero_iff Valued.v).mpr hft_ne
    have hfp1_ne : f (p.1 : K) ≠ 0 := f.injective.ne p.1.ne_zero
    have hfp2_ne : f (p.2 : K) ≠ 0 := f.injective.ne p.2.ne_zero
    have hvp1_ne : Valued.v (f (p.1 : K)) ≠ 0 := (Valuation.ne_zero_iff Valued.v).mpr hfp1_ne
    have hvp2_ne : Valued.v (f (p.2 : K)) ≠ 0 := (Valuation.ne_zero_iff Valued.v).mpr hfp2_ne
    constructor
    · intro ht_even
      rw [heven_iff, heven_iff]
      rcases hdesc with ⟨z₀, z₁, z₂, z₃, h_not_all_zero, heq₁, heq₂⟩
      let d₁ : v.adicCompletion K := f (p.1 : K)
      let d₂ : v.adicCompletion K := f (p.2 : K)
      let A₁ : v.adicCompletion K := d₁ * z₁ ^ 2
      let A₂ : v.adicCompletion K := d₂ * z₂ ^ 2
      let A₃ : v.adicCompletion K := (d₁ * d₂) * z₃ ^ 2
      let R : WithZero (Multiplicative ℤ) := Valued.v (f (t : K) * z₀ ^ 2)
      have hR : IsSquare R := by
        dsimp [R]; rw [map_mul]
        exact ((heven_iff t).mp ht_even).mul ⟨Valued.v z₀, by rw [sq, map_mul]⟩
      have heq₁' : A₁ - A₂ = (f a₂ - f a₁) * (f (t : K) * z₀ ^ 2) := by
        dsimp [A₁, A₂, d₁, d₂]; simp only [map_mul] at heq₁; linear_combination heq₁
      have heq₂' : A₁ - A₃ = (f a₃ - f a₁) * (f (t : K) * z₀ ^ 2) := by
        dsimp [A₁, A₃, d₁, d₂]; simp only [map_mul] at heq₂; linear_combination heq₂
      have heq₃' : A₂ - A₃ = (f a₃ - f a₂) * (f (t : K) * z₀ ^ 2) := by
        linear_combination heq₂' - heq₁'
      have hd12 : Valued.v (A₁ - A₂) = R := by rw [heq₁', map_mul, hv21, one_mul]
      have hd21 : Valued.v (A₂ - A₁) = R := by rw [Valuation.map_sub_swap, hd12]
      have hd13 : Valued.v (A₁ - A₃) = R := by rw [heq₂', map_mul, hv31, one_mul]
      have hd31 : Valued.v (A₃ - A₁) = R := by rw [Valuation.map_sub_swap, hd13]
      have hd23 : Valued.v (A₂ - A₃) = R := by rw [heq₃', map_mul, hv32, one_mul]
      have hd32 : Valued.v (A₃ - A₂) = R := by rw [Valuation.map_sub_swap, hd23]
      have h_contra_of_all_zero : R = 0 → A₁ = 0 → A₂ = 0 → A₃ = 0 → False := by
        intro hR0 hA₁0 hA₂0 hA₃0
        have hz₀0 : z₀ = 0 :=
          pow_eq_zero ((mul_eq_zero.mp ((Valuation.zero_iff Valued.v).mp hR0)).resolve_left hft_ne)
        have hz₁0 : z₁ = 0 := pow_eq_zero ((mul_eq_zero.mp hA₁0).resolve_left hfp1_ne)
        have hz₂0 : z₂ = 0 := pow_eq_zero ((mul_eq_zero.mp hA₂0).resolve_left hfp2_ne)
        have hz₃0 : z₃ = 0 :=
          pow_eq_zero ((mul_eq_zero.mp hA₃0).resolve_left (mul_ne_zero hfp1_ne hfp2_ne))
        exact h_not_all_zero ⟨hz₀0, hz₁0, hz₂0, hz₃0⟩
      by_cases hsq₁ : IsSquare (Valued.v d₁)
      · by_cases hsq₂ : IsSquare (Valued.v d₂)
        · exact ⟨hsq₁, hsq₂⟩
        · exfalso
          have hsq₁₂ : ¬ IsSquare (Valued.v (d₁ * d₂)) := by
            rw [map_mul, mul_comm]
            exact h_not_sq_mul_of_not_sq_of_sq _ _ hvp1_ne hsq₂ hsq₁
          obtain ⟨hR0, hA₂0, hA₃0, hA₁0⟩ :=
            h_ultrametric_elim A₂ A₃ A₁ R
              (h_zero_of_not_sq_mul_sq _ _ hsq₂)
              (h_zero_of_not_sq_mul_sq _ _ hsq₁₂)
              (h_sq_mul_sq _ _ hsq₁)
              hR hd21 hd31 hd23
          exact h_contra_of_all_zero hR0 hA₁0 hA₂0 hA₃0
      · by_cases hsq₂ : IsSquare (Valued.v d₂)
        · exfalso
          have hsq₁₂ : ¬ IsSquare (Valued.v (d₁ * d₂)) := by
            rw [map_mul]
            exact h_not_sq_mul_of_not_sq_of_sq _ _ hvp2_ne hsq₁ hsq₂
          obtain ⟨hR0, hA₁0, hA₃0, hA₂0⟩ :=
            h_ultrametric_elim A₁ A₃ A₂ R
              (h_zero_of_not_sq_mul_sq _ _ hsq₁)
              (h_zero_of_not_sq_mul_sq _ _ hsq₁₂)
              (h_sq_mul_sq _ _ hsq₂)
              hR hd12 hd32 hd13
          exact h_contra_of_all_zero hR0 hA₁0 hA₂0 hA₃0
        · exfalso
          have hsq₁₂ : IsSquare (Valued.v (d₁ * d₂)) := by
            rw [map_mul]
            exact h_sq_mul_of_not_sq_of_not_sq _ _ hvp1_ne hvp2_ne hsq₁ hsq₂
          obtain ⟨hR0, hA₁0, hA₂0, hA₃0⟩ :=
            h_ultrametric_elim A₁ A₂ A₃ R
              (h_zero_of_not_sq_mul_sq _ _ hsq₁)
              (h_zero_of_not_sq_mul_sq _ _ hsq₂)
              (h_sq_mul_sq _ _ hsq₁₂)
              hR hd13 hd23 hd12
          exact h_contra_of_all_zero hR0 hA₁0 hA₂0 hA₃0
    · intro h_unif
      have hvt_not_sq : ¬ IsSquare (Valued.v (f (t : K))) := by
        rcases h_unif with ⟨n, ⟨l, hl⟩, hvt⟩
        rintro ⟨r, hr⟩
        rw [hvt] at hr
        have hr_ne : r ≠ 0 := by rintro rfl; rw [mul_zero] at hr; exact WithZero.coe_ne_zero hr
        obtain ⟨g, rfl⟩ := WithZero.ne_zero_iff_exists.mp hr_ne
        rw [← WithZero.coe_mul, WithZero.coe_inj] at hr
        have hadd := congrArg Multiplicative.toAdd hr
        rw [toAdd_mul, toAdd_ofAdd] at hadd; omega
      have h_even_imp_sq : ∀ (d₁ d₂ : v.adicCompletion K),
          d₁ ≠ 0 → d₂ ≠ 0 →
          IsSquare (Valued.v d₁) → IsSquare (Valued.v d₂) →
          IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃)) d₁ d₂ →
          IsSquare d₁ ∧ IsSquare d₂ := by
        intro d₁ d₂ hd₁ hd₂ hsq₁ hsq₂ ⟨z₀, z₁, z₂, z₃, h_nz, heq₁, heq₂⟩
        by_cases hz₀ : z₀ = 0
        · subst hz₀
          have hz₃ : z₃ ≠ 0 := by
            rintro rfl
            have hz₁ : z₁ = 0 :=
              pow_eq_zero ((mul_eq_zero.mp (by linear_combination heq₂ : d₁ * z₁ ^ 2 = 0)).resolve_left hd₁)
            have hz₂ : z₂ = 0 :=
              pow_eq_zero ((mul_eq_zero.mp (by linear_combination heq₂ - heq₁ : d₂ * z₂ ^ 2 = 0)).resolve_left hd₂)
            exact h_nz ⟨rfl, hz₁, hz₂, rfl⟩
          have h1 : d₁ * z₃ ^ 2 = z₂ ^ 2 :=
            sub_eq_zero.mp ((mul_eq_zero.mp (by linear_combination heq₁ - heq₂ : d₂ * (d₁ * z₃ ^ 2 - z₂ ^ 2) = 0)).resolve_left hd₂)
          have h2 : d₂ * z₃ ^ 2 = z₁ ^ 2 :=
            sub_eq_zero.mp ((mul_eq_zero.mp (by linear_combination -heq₂ : d₁ * (d₂ * z₃ ^ 2 - z₁ ^ 2) = 0)).resolve_left hd₁)
          refine ⟨⟨z₂ / z₃, ?_⟩, ⟨z₁ / z₃, ?_⟩⟩
          · calc d₁ = (d₁ * z₃ ^ 2) / z₃ ^ 2 := by rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hz₃)]
              _ = z₂ ^ 2 / z₃ ^ 2 := by rw [h1]
              _ = (z₂ / z₃) * (z₂ / z₃) := by ring
          · calc d₂ = (d₂ * z₃ ^ 2) / z₃ ^ 2 := by rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hz₃)]
              _ = z₁ ^ 2 / z₃ ^ 2 := by rw [h2]
              _ = (z₁ / z₃) * (z₁ / z₃) := by ring
        · let A₁ : v.adicCompletion K := d₁ * z₁ ^ 2
          let A₂ : v.adicCompletion K := d₂ * z₂ ^ 2
          let A₃ : v.adicCompletion K := (d₁ * d₂) * z₃ ^ 2
          let R : WithZero (Multiplicative ℤ) := Valued.v (f (t : K) * z₀ ^ 2)
          have hR_not_sq : ¬ IsSquare R := by
            dsimp [R]; rw [map_mul]
            exact h_not_sq_mul_of_not_sq_of_sq _ _
              ((Valuation.ne_zero_iff Valued.v).mpr (pow_ne_zero 2 hz₀))
              hvt_not_sq ⟨Valued.v z₀, by rw [sq, map_mul]⟩
          have heq₁' : A₁ - A₂ = (f a₂ - f a₁) * (f (t : K) * z₀ ^ 2) := by
            dsimp [A₁, A₂]; simp only [map_mul] at heq₁; linear_combination heq₁
          have heq₂' : A₁ - A₃ = (f a₃ - f a₁) * (f (t : K) * z₀ ^ 2) := by
            dsimp [A₁, A₃]; simp only [map_mul] at heq₂; linear_combination heq₂
          have heq₃' : A₂ - A₃ = (f a₃ - f a₂) * (f (t : K) * z₀ ^ 2) := by
            linear_combination heq₂' - heq₁'
          have hd13 : Valued.v (A₁ - A₃) = R := by rw [heq₂', map_mul, hv31, one_mul]
          have hd23 : Valued.v (A₂ - A₃) = R := by rw [heq₃', map_mul, hv32, one_mul]
          have hsqA₁ : IsSquare (Valued.v A₁) := h_sq_mul_sq d₁ z₁ hsq₁
          have hsqA₂ : IsSquare (Valued.v A₂) := h_sq_mul_sq d₂ z₂ hsq₂
          have hsqA₃ : IsSquare (Valued.v A₃) :=
            h_sq_mul_sq (d₁ * d₂) z₃ (by rw [map_mul]; exact hsq₁.mul hsq₂)
          have h_lt_of_diff : ∀ (X : v.adicCompletion K),
              IsSquare (Valued.v X) → Valued.v (X - A₃) = R →
              Valued.v X = Valued.v A₃ ∧ R < Valued.v X := by
            intro X hsqX hdX
            have h_eq : Valued.v X = Valued.v A₃ := by
              by_contra hne
              have hne' : Valued.v X ≠ Valued.v (-A₃) := by rwa [Valuation.map_neg]
              have hmax : R = max (Valued.v X) (Valued.v (-A₃)) := by
                rw [← hdX, sub_eq_add_neg]
                exact Valuation.map_add_of_distinct_val Valued.v hne'
              rw [Valuation.map_neg] at hmax
              rcases max_choice (Valued.v X) (Valued.v A₃) with hm | hm
              · exact hR_not_sq ((hmax.trans hm).symm ▸ hsqX)
              · exact hR_not_sq ((hmax.trans hm).symm ▸ hsqA₃)
            refine ⟨h_eq, lt_of_le_of_ne ?_ (fun hr => hR_not_sq (hr ▸ hsqX))⟩
            rw [← hdX]
            refine le_trans (Valuation.map_sub Valued.v X A₃) ?_
            rw [h_eq, max_self]
          obtain ⟨hA₁_eq_A₃, hR_lt_A₁⟩ := h_lt_of_diff A₁ hsqA₁ hd13
          obtain ⟨hA₂_eq_A₃, hR_lt_A₂⟩ := h_lt_of_diff A₂ hsqA₂ hd23
          have hA₁_pos : 0 < Valued.v A₁ := lt_of_le_of_lt zero_le' hR_lt_A₁
          have hA₂_pos : 0 < Valued.v A₂ := lt_of_le_of_lt zero_le' hR_lt_A₂
          have hA₁_ne : A₁ ≠ 0 := (Valuation.ne_zero_iff Valued.v).mp (ne_of_gt hA₁_pos)
          have hA₂_ne : A₂ ≠ 0 := (Valuation.ne_zero_iff Valued.v).mp (ne_of_gt hA₂_pos)
          have hA₃_ne : A₃ ≠ 0 :=
            (Valuation.ne_zero_iff Valued.v).mp (ne_of_gt (hA₁_eq_A₃ ▸ hA₁_pos))
          have hz₁_ne : z₁ ≠ 0 := pow_ne_zero_iff two_ne_zero |>.mp (right_ne_zero_of_mul hA₁_ne)
          have hz₂_ne : z₂ ≠ 0 := pow_ne_zero_iff two_ne_zero |>.mp (right_ne_zero_of_mul hA₂_ne)
          have hz₃_ne : z₃ ≠ 0 := pow_ne_zero_iff two_ne_zero |>.mp (right_ne_zero_of_mul hA₃_ne)
          have hδ₁_lt : Valued.v (-(A₂ - A₃) / A₂) < 1 := by
            rw [Valuation.map_div, Valuation.map_neg, hd23, div_lt_iff₀ hA₂_pos, one_mul]
            exact hR_lt_A₂
          have hδ₂_lt : Valued.v (-(A₁ - A₃) / A₁) < 1 := by
            rw [Valuation.map_div, Valuation.map_neg, hd13, div_lt_iff₀ hA₁_pos, one_mul]
            exact hR_lt_A₁
          obtain ⟨s₁, hs₁⟩ := h_hensel v hval2 (-(A₂ - A₃) / A₂) hδ₁_lt
          obtain ⟨s₂, hs₂⟩ := h_hensel v hval2 (-(A₁ - A₃) / A₁) hδ₂_lt
          have hs₁_eq : A₂ * (s₁ * s₁) = A₃ := by
            rw [← hs₁]; field_simp [hA₂_ne]; ring
          have hs₂_eq : A₁ * (s₂ * s₂) = A₃ := by
            rw [← hs₂]; field_simp [hA₁_ne]; ring
          have hd₁_eq : d₁ * z₃ ^ 2 = (s₁ * z₂) ^ 2 :=
            mul_left_cancel₀ hd₂ (by dsimp [A₂, A₃] at hs₁_eq; linear_combination hs₁_eq.symm)
          have hd₂_eq : d₂ * z₃ ^ 2 = (s₂ * z₁) ^ 2 :=
            mul_left_cancel₀ hd₁ (by dsimp [A₁, A₃] at hs₂_eq; linear_combination hs₂_eq.symm)
          refine ⟨⟨s₁ * z₂ / z₃, ?_⟩, ⟨s₂ * z₁ / z₃, ?_⟩⟩
          · calc d₁ = (d₁ * z₃ ^ 2) / z₃ ^ 2 := by rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hz₃_ne)]
              _ = (s₁ * z₂) ^ 2 / z₃ ^ 2 := by rw [hd₁_eq]
              _ = (s₁ * z₂ / z₃) * (s₁ * z₂ / z₃) := by ring
          · calc d₂ = (d₂ * z₃ ^ 2) / z₃ ^ 2 := by rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hz₃_ne)]
              _ = (s₂ * z₁) ^ 2 / z₃ ^ 2 := by rw [hd₂_eq]
              _ = (s₂ * z₁ / z₃) * (s₂ * z₁ / z₃) := by ring
      have hf12 : f a₁ ≠ f a₂ := f.injective.ne h₁₂
      have hfα_ne : f (a₁ - a₂) ≠ 0 := (Valuation.ne_zero_iff Valued.v).mp (by rw [hv12]; exact one_ne_zero)
      have hfβ_ne : f (a₁ - a₃) ≠ 0 := (Valuation.ne_zero_iff Valued.v).mp (by rw [hv13]; exact one_ne_zero)
      have hfγ_ne : f (a₂ - a₃) ≠ 0 := (Valuation.ne_zero_iff Valued.v).mp (by rw [hv23]; exact one_ne_zero)
      have hdesc_f : IsDescentClass (f (t : K) * f a₁) (f (t : K) * f a₂) (f (t : K) * f a₃)
          (f (p.1 : K)) (f (p.2 : K)) := by
        simpa only [map_mul] using hdesc
      by_cases hsq₁ : IsSquare (Valued.v (f (p.1 : K)))
      · by_cases hsq₂ : IsSquare (Valued.v (f (p.2 : K)))
        · exact Or.inl (h_even_imp_sq (f (p.1 : K)) (f (p.2 : K)) hfp1_ne hfp2_ne hsq₁ hsq₂ hdesc)
        · refine Or.inr (Or.inl ?_)
          have hdesc1 := isDescentClass_twist_g1 (f a₁) (f a₂) (f a₃) (f (t : K))
            (f (p.1 : K)) (f (p.2 : K)) hf12 hft_ne hfp1_ne hdesc_f
          have hdesc1' : IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
              (f ((p.1 : K) * (a₁ - a₂) * (a₁ - a₃))) (f (t : K) * f ((p.2 : K) * (a₁ - a₂))) := by
            simpa only [map_mul, map_sub] using hdesc1
          refine h_even_imp_sq _ _ ?_ ?_ ?_ ?_ hdesc1'
          · rw [f.map_mul, f.map_mul]; exact mul_ne_zero (mul_ne_zero hfp1_ne hfα_ne) hfβ_ne
          · rw [f.map_mul]; exact mul_ne_zero hft_ne (mul_ne_zero hfp2_ne hfα_ne)
          · rw [f.map_mul, f.map_mul, Valuation.map_mul, Valuation.map_mul, hv12, hv13, mul_one, mul_one]
            exact hsq₁
          · rw [Valuation.map_mul, f.map_mul, Valuation.map_mul, hv12, mul_one]
            exact h_sq_mul_of_not_sq_of_not_sq _ _ hvt_ne hvp2_ne hvt_not_sq hsq₂
      · by_cases hsq₂ : IsSquare (Valued.v (f (p.2 : K)))
        · refine Or.inr (Or.inr (Or.inl ?_))
          have hdesc2 := isDescentClass_twist_g2 (f a₁) (f a₂) (f a₃) (f (t : K))
            (f (p.1 : K)) (f (p.2 : K)) hf12 hft_ne hfp2_ne hdesc_f
          have hdesc2' : IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
              (-(f (t : K) * f ((p.1 : K) * (a₁ - a₂)))) (f (-((p.2 : K) * (a₁ - a₂) * (a₂ - a₃)))) := by
            simpa only [map_mul, map_sub, map_neg] using hdesc2
          refine h_even_imp_sq _ _ ?_ ?_ ?_ ?_ hdesc2'
          · rw [f.map_mul]; exact neg_ne_zero.mpr (mul_ne_zero hft_ne (mul_ne_zero hfp1_ne hfα_ne))
          · rw [f.map_neg, f.map_mul, f.map_mul]
            exact neg_ne_zero.mpr (mul_ne_zero (mul_ne_zero hfp2_ne hfα_ne) hfγ_ne)
          · rw [Valuation.map_neg, Valuation.map_mul, f.map_mul, Valuation.map_mul, hv12, mul_one]
            exact h_sq_mul_of_not_sq_of_not_sq _ _ hvt_ne hvp1_ne hvt_not_sq hsq₁
          · rw [f.map_neg, Valuation.map_neg, f.map_mul, f.map_mul, Valuation.map_mul, Valuation.map_mul,
              hv12, hv23, mul_one, mul_one]
            exact hsq₂
        · refine Or.inr (Or.inr (Or.inr ?_))
          have hdesc3 := isDescentClass_twist_g3 (f a₁) (f a₂) (f a₃) (f (t : K))
            (f (p.1 : K)) (f (p.2 : K)) hfp1_ne hfp2_ne hdesc_f
          have hdesc3' : IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
              (-(f (t : K) * f ((p.1 : K) * (a₁ - a₃)))) (-(f (t : K) * f ((p.2 : K) * (a₂ - a₃)))) := by
            simpa only [map_mul, map_sub, map_neg] using hdesc3
          refine h_even_imp_sq _ _ ?_ ?_ ?_ ?_ hdesc3'
          · rw [f.map_mul]; exact neg_ne_zero.mpr (mul_ne_zero hft_ne (mul_ne_zero hfp1_ne hfβ_ne))
          · rw [f.map_mul]; exact neg_ne_zero.mpr (mul_ne_zero hft_ne (mul_ne_zero hfp2_ne hfγ_ne))
          · rw [Valuation.map_neg, Valuation.map_mul, f.map_mul, Valuation.map_mul, hv13, mul_one]
            exact h_sq_mul_of_not_sq_of_not_sq _ _ hvt_ne hvp1_ne hvt_not_sq hsq₁
          · rw [Valuation.map_neg, Valuation.map_mul, f.map_mul, Valuation.map_mul, hv23, mul_one]
            exact h_sq_mul_of_not_sq_of_not_sq _ _ hvt_ne hvp2_ne hvt_not_sq hsq₂
  
  letI : CommGroup (SqCl K) := QuotientGroup.Quotient.commGroup _
  rcases hsuit with ⟨hST, hq₁T, hq₁S, hq₂T, hq₂S, hq₃T, hq₃S, hq₄T, hq₄S,
    hq₁₂, hq₁₃, hq₁₄, hq₂₃, hq₂₄, hq₃₄, htT, htInf, htUnif, htEven, _⟩
  obtain ⟨_, hval12_4, hval13_4, hval23_4⟩ := h_good_vals 𝔮₄ hq₄T
  have h_even_of_val_one : ∀ u : Kˣ,
      (IsDedekindDomain.HeightOneSpectrum.valuation K 𝔮₄) (u : K) = 1 → EvenVal 𝔮₄ u := by
    intro u hu
    have h1 : ((𝔮₄.valuationOfNeZero u : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        ((1 : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq 𝔮₄ u, hu, WithZero.coe_one]
    have h2 : 𝔮₄.valuationOfNeZero u = 1 := WithZero.coe_inj.mp h1
    dsimp [EvenVal]; rw [h2, toAdd_one]; exact ⟨0, rfl⟩
  have hα_ne : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr h₁₂
  have hβ_ne : a₁ - a₃ ≠ 0 := sub_ne_zero.mpr h₁₃
  have hγ_ne : a₂ - a₃ ≠ 0 := sub_ne_zero.mpr h₂₃
  let u_α : Kˣ := Units.mk0 (a₁ - a₂) hα_ne
  let u_β : Kˣ := Units.mk0 (a₁ - a₃) hβ_ne
  let u_γ : Kˣ := Units.mk0 (a₂ - a₃) hγ_ne
  have hev_neg1 : EvenVal 𝔮₄ (-1 : Kˣ) :=
    h_even_of_val_one (-1) (by rw [Units.val_neg, Units.val_one, Valuation.map_neg, Valuation.map_one])
  have hev_α : EvenVal 𝔮₄ u_α := h_even_of_val_one u_α hval12_4
  have hev_β : EvenVal 𝔮₄ u_β := h_even_of_val_one u_β hval13_4
  have hev_γ : EvenVal 𝔮₄ u_γ := h_even_of_val_one u_γ hval23_4
  have hev_mul : ∀ x y : Kˣ, EvenVal 𝔮₄ (x * y) ↔ (EvenVal 𝔮₄ x ↔ EvenVal 𝔮₄ y) := by
    intro x y; dsimp [EvenVal]; rw [map_mul, toAdd_mul, Int.even_add]
  have hev_neg : ∀ x : Kˣ, EvenVal 𝔮₄ (-x) ↔ EvenVal 𝔮₄ x := by
    intro x
    rw [show (-x : Kˣ) = (-1 : Kˣ) * x by ext; simp, hev_mul]
    exact ⟨fun h => h.mp hev_neg1, fun h => ⟨fun _ => h, fun _ => hev_neg1⟩⟩
  have ht_not_ev : ¬ EvenVal 𝔮₄ t := by
    obtain ⟨n, ⟨l, hl⟩, hvt⟩ := htUnif 𝔮₄ (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
    have h1 := IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' 𝔮₄ (t : K)
    have h2 := IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq 𝔮₄ t
    have h3 : 𝔮₄.valuationOfNeZero t = Multiplicative.ofAdd n :=
      WithZero.coe_inj.mp (h2.trans (h1.symm.trans hvt))
    rintro ⟨k, hk⟩
    rw [h3, toAdd_ofAdd] at hk; omega
  let g₁ : Kˣ × Kˣ := (u_α * u_β, t * u_α)
  let g₂ : Kˣ × Kˣ := (-(t * u_α), -(u_α * u_γ))
  let g₃ : Kˣ × Kˣ := (-(t * u_β), -(t * u_γ))
  have hg₁_1 : EvenVal 𝔮₄ g₁.1 := (hev_mul u_α u_β).mpr ⟨fun _ => hev_β, fun _ => hev_α⟩
  have hg₁_2 : ¬ EvenVal 𝔮₄ g₁.2 := fun h => ht_not_ev ((hev_mul t u_α).mp h |>.mpr hev_α)
  have hg₂_1 : ¬ EvenVal 𝔮₄ g₂.1 :=
    fun h => ht_not_ev ((hev_mul t u_α).mp ((hev_neg (t * u_α)).mp h) |>.mpr hev_α)
  have hg₂_2 : EvenVal 𝔮₄ g₂.2 :=
    (hev_neg (u_α * u_γ)).mpr ((hev_mul u_α u_γ).mpr ⟨fun _ => hev_γ, fun _ => hev_α⟩)
  have hg₃_1 : ¬ EvenVal 𝔮₄ g₃.1 :=
    fun h => ht_not_ev ((hev_mul t u_β).mp ((hev_neg (t * u_β)).mp h) |>.mpr hev_β)
  have hg₃_2 : ¬ EvenVal 𝔮₄ g₃.2 :=
    fun h => ht_not_ev ((hev_mul t u_γ).mp ((hev_neg (t * u_γ)).mp h) |>.mpr hev_γ)
  let PreTwo : Set (Kˣ × Kˣ) :=
    { p : Kˣ × Kˣ |
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          IsDescentClass
            (algebraMap K (v.adicCompletion K) ((t : K) * a₁))
            (algebraMap K (v.adicCompletion K) ((t : K) * a₂))
            (algebraMap K (v.adicCompletion K) ((t : K) * a₃))
            (algebraMap K (v.adicCompletion K) (p.1 : K))
            (algebraMap K (v.adicCompletion K) (p.2 : K))) ∧
      (∀ w : NumberField.InfinitePlace K,
          IsDescentClass
            (algebraMap K w.Completion ((t : K) * a₁))
            (algebraMap K w.Completion ((t : K) * a₂))
            (algebraMap K w.Completion ((t : K) * a₃))
            (algebraMap K w.Completion (p.1 : K))
            (algebraMap K w.Completion (p.2 : K))) }
  have h_shift_g₁ : ∀ p ∈ PreTwo, (p.1 * g₁.1, p.2 * g₁.2) ∈ PreTwo := by
    rintro p ⟨hp_fin, hp_inf⟩
    refine ⟨fun v => ?_, fun w => ?_⟩
    · let f := algebraMap K (v.adicCompletion K)
      have h1 := isDescentClass_twist_g1 (f a₁) (f a₂) (f a₃) (f (t : K)) (f (p.1 : K)) (f (p.2 : K))
        (f.injective.ne h₁₂) (f.injective.ne t.ne_zero) (f.injective.ne p.1.ne_zero)
        (by simpa only [map_mul] using hp_fin v)
      have h1_eq : f ((p.1 * g₁.1 : Kˣ) : K) = f (p.1 : K) * (f a₁ - f a₂) * (f a₁ - f a₃) := by
        dsimp [g₁, u_α, u_β]; simp only [Units.val_mul, Units.val_mk0, map_mul, map_sub]; ring
      have h2_eq : f ((p.2 * g₁.2 : Kˣ) : K) = f (t : K) * (f (p.2 : K) * (f a₁ - f a₂)) := by
        dsimp [g₁, u_α]; simp only [Units.val_mul, Units.val_mk0, map_mul, map_sub]; ring
      change IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
        (f ((p.1 * g₁.1 : Kˣ) : K)) (f ((p.2 * g₁.2 : Kˣ) : K))
      rw [h1_eq, h2_eq]
      simpa only [map_mul] using h1
    · let f := algebraMap K w.Completion
      have h1 := isDescentClass_twist_g1 (f a₁) (f a₂) (f a₃) (f (t : K)) (f (p.1 : K)) (f (p.2 : K))
        (f.injective.ne h₁₂) (f.injective.ne t.ne_zero) (f.injective.ne p.1.ne_zero)
        (by simpa only [map_mul] using hp_inf w)
      have h1_eq : f ((p.1 * g₁.1 : Kˣ) : K) = f (p.1 : K) * (f a₁ - f a₂) * (f a₁ - f a₃) := by
        dsimp [g₁, u_α, u_β]; simp only [Units.val_mul, Units.val_mk0, map_mul, map_sub]; ring
      have h2_eq : f ((p.2 * g₁.2 : Kˣ) : K) = f (t : K) * (f (p.2 : K) * (f a₁ - f a₂)) := by
        dsimp [g₁, u_α]; simp only [Units.val_mul, Units.val_mk0, map_mul, map_sub]; ring
      change IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
        (f ((p.1 * g₁.1 : Kˣ) : K)) (f ((p.2 * g₁.2 : Kˣ) : K))
      rw [h1_eq, h2_eq]
      simpa only [map_mul] using h1
  have h_shift_g₂ : ∀ p ∈ PreTwo, (p.1 * g₂.1, p.2 * g₂.2) ∈ PreTwo := by
    rintro p ⟨hp_fin, hp_inf⟩
    refine ⟨fun v => ?_, fun w => ?_⟩
    · let f := algebraMap K (v.adicCompletion K)
      have h1 := isDescentClass_twist_g2 (f a₁) (f a₂) (f a₃) (f (t : K)) (f (p.1 : K)) (f (p.2 : K))
        (f.injective.ne h₁₂) (f.injective.ne t.ne_zero) (f.injective.ne p.2.ne_zero)
        (by simpa only [map_mul] using hp_fin v)
      have h1_eq : f ((p.1 * g₂.1 : Kˣ) : K) = -(f (t : K) * (f (p.1 : K) * (f a₁ - f a₂))) := by
        dsimp [g₂, u_α]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      have h2_eq : f ((p.2 * g₂.2 : Kˣ) : K) = -(f (p.2 : K) * (f a₁ - f a₂) * (f a₂ - f a₃)) := by
        dsimp [g₂, u_α, u_γ]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      change IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
        (f ((p.1 * g₂.1 : Kˣ) : K)) (f ((p.2 * g₂.2 : Kˣ) : K))
      rw [h1_eq, h2_eq]
      simpa only [map_mul] using h1
    · let f := algebraMap K w.Completion
      have h1 := isDescentClass_twist_g2 (f a₁) (f a₂) (f a₃) (f (t : K)) (f (p.1 : K)) (f (p.2 : K))
        (f.injective.ne h₁₂) (f.injective.ne t.ne_zero) (f.injective.ne p.2.ne_zero)
        (by simpa only [map_mul] using hp_inf w)
      have h1_eq : f ((p.1 * g₂.1 : Kˣ) : K) = -(f (t : K) * (f (p.1 : K) * (f a₁ - f a₂))) := by
        dsimp [g₂, u_α]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      have h2_eq : f ((p.2 * g₂.2 : Kˣ) : K) = -(f (p.2 : K) * (f a₁ - f a₂) * (f a₂ - f a₃)) := by
        dsimp [g₂, u_α, u_γ]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      change IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
        (f ((p.1 * g₂.1 : Kˣ) : K)) (f ((p.2 * g₂.2 : Kˣ) : K))
      rw [h1_eq, h2_eq]
      simpa only [map_mul] using h1
  have h_shift_g₃ : ∀ p ∈ PreTwo, (p.1 * g₃.1, p.2 * g₃.2) ∈ PreTwo := by
    rintro p ⟨hp_fin, hp_inf⟩
    refine ⟨fun v => ?_, fun w => ?_⟩
    · let f := algebraMap K (v.adicCompletion K)
      have h1 := isDescentClass_twist_g3 (f a₁) (f a₂) (f a₃) (f (t : K)) (f (p.1 : K)) (f (p.2 : K))
        (f.injective.ne p.1.ne_zero) (f.injective.ne p.2.ne_zero)
        (by simpa only [map_mul] using hp_fin v)
      have h1_eq : f ((p.1 * g₃.1 : Kˣ) : K) = -(f (t : K) * (f (p.1 : K) * (f a₁ - f a₃))) := by
        dsimp [g₃, u_β]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      have h2_eq : f ((p.2 * g₃.2 : Kˣ) : K) = -(f (t : K) * (f (p.2 : K) * (f a₂ - f a₃))) := by
        dsimp [g₃, u_γ]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      change IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
        (f ((p.1 * g₃.1 : Kˣ) : K)) (f ((p.2 * g₃.2 : Kˣ) : K))
      rw [h1_eq, h2_eq]
      simpa only [map_mul] using h1
    · let f := algebraMap K w.Completion
      have h1 := isDescentClass_twist_g3 (f a₁) (f a₂) (f a₃) (f (t : K)) (f (p.1 : K)) (f (p.2 : K))
        (f.injective.ne p.1.ne_zero) (f.injective.ne p.2.ne_zero)
        (by simpa only [map_mul] using hp_inf w)
      have h1_eq : f ((p.1 * g₃.1 : Kˣ) : K) = -(f (t : K) * (f (p.1 : K) * (f a₁ - f a₃))) := by
        dsimp [g₃, u_β]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      have h2_eq : f ((p.2 * g₃.2 : Kˣ) : K) = -(f (t : K) * (f (p.2 : K) * (f a₂ - f a₃))) := by
        dsimp [g₃, u_γ]; simp only [Units.val_mul, Units.val_neg, Units.val_mk0, map_mul, map_neg, map_sub]; ring
      change IsDescentClass (f ((t : K) * a₁)) (f ((t : K) * a₂)) (f ((t : K) * a₃))
        (f ((p.1 * g₃.1 : Kˣ) : K)) (f ((p.2 * g₃.2 : Kˣ) : K))
      rw [h1_eq, h2_eq]
      simpa only [map_mul] using h1
  have h_mem_selmer : ∀ q ∈ PreTwo, EvenVal 𝔮₄ q.1 → EvenVal 𝔮₄ q.2 →
      (sqCl q.1, sqCl q.2) = 1 := by
    rintro q ⟨hq_fin, hq_inf⟩ hq1 hq2
    apply htriv (sqCl q.1, sqCl q.2)
    refine ⟨q, ⟨?_, ?_, ?_, ?_⟩, rfl⟩
    · intro v hvT
      let f := algebraMap K (v.adicCompletion K)
      exact isDescentClass_untwist (f a₁) (f a₂) (f a₃) (f (t : K)) (f (q.1 : K)) (f (q.2 : K))
        (f.injective.ne t.ne_zero) (htT v hvT) (by simpa only [map_mul] using hq_fin v)
    · intro w
      let f := algebraMap K w.Completion
      exact isDescentClass_untwist (f a₁) (f a₂) (f a₃) (f (t : K)) (f (q.1 : K)) (f (q.2 : K))
        (f.injective.ne t.ne_zero) (htInf w) (by simpa only [map_mul] using hq_inf w)
    · intro v hvS₃
      have hv_cases := (hS₃ v).mp hvS₃
      have hvT : v ∉ T := by
        rcases hv_cases with hvS | rfl | rfl | rfl
        · exact Finset.disjoint_left.mp hST hvS
        · exact hq₁T
        · exact hq₂T
        · exact hq₃T
      have hv_unif : IsLocalUnif v (algebraMap K (v.adicCompletion K) (t : K)) := by
        apply htUnif v
        rcases hv_cases with hvS | rfl | rfl | rfl
        · exact Or.inl hvS
        · exact Or.inr (Or.inl rfl)
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
      exact (hloc v hvT q (hq_fin v)).2 hv_unif
    · intro v hvT hvS₃
      by_cases hv4 : v = 𝔮₄
      · subst hv4; exact ⟨hq1, hq2⟩
      · have hv_not : ¬ (v ∈ S ∨ v = 𝔮₁ ∨ v = 𝔮₂ ∨ v = 𝔮₃) := (hS₃ v).not.mp hvS₃
        push_neg at hv_not
        have ht_ev : EvenVal v t :=
          htEven v hvT hv_not.1 hv_not.2.1 hv_not.2.2.1 hv_not.2.2.2 hv4
        exact (hloc v hvT q (hq_fin v)).1 ht_ev
  have hsqCl_self : ∀ u : Kˣ, sqCl u * sqCl u = 1 := by
    intro u
    change sqCl (u * u) = 1
    exact (QuotientGroup.eq_one_iff (u * u)).mpr ⟨u, sq u⟩
  have h_eq_of_mul_eq_one : ∀ (p g : Kˣ × Kˣ),
      (sqCl (p.1 * g.1), sqCl (p.2 * g.2)) = 1 →
      (sqCl p.1, sqCl p.2) = (sqCl g.1, sqCl g.2) := by
    intro p g h
    have h1 : sqCl p.1 * sqCl g.1 = 1 := (Prod.mk.injEq _ _ _ _).mp h |>.1
    have h2 : sqCl p.2 * sqCl g.2 = 1 := (Prod.mk.injEq _ _ _ _).mp h |>.2
    ext
    · calc sqCl p.1 = sqCl p.1 * 1 := (mul_one _).symm
        _ = sqCl p.1 * (sqCl g.1 * sqCl g.1) := by rw [hsqCl_self g.1]
        _ = (sqCl p.1 * sqCl g.1) * sqCl g.1 := (mul_assoc _ _ _).symm
        _ = 1 * sqCl g.1 := by rw [h1]
        _ = sqCl g.1 := one_mul _
    · calc sqCl p.2 = sqCl p.2 * 1 := (mul_one _).symm
        _ = sqCl p.2 * (sqCl g.2 * sqCl g.2) := by rw [hsqCl_self g.2]
        _ = (sqCl p.2 * sqCl g.2) * sqCl g.2 := (mul_assoc _ _ _).symm
        _ = 1 * sqCl g.2 := by rw [h2]
        _ = sqCl g.2 := one_mul _
  let c₀ : SqCl K × SqCl K := 1
  let c₁ : SqCl K × SqCl K := (sqCl g₁.1, sqCl g₁.2)
  let c₂ : SqCl K × SqCl K := (sqCl g₂.1, sqCl g₂.2)
  let c₃ : SqCl K × SqCl K := (sqCl g₃.1, sqCl g₃.2)
  have h_sub : twoSelmerSet K ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃) ⊆ {c₀, c₁, c₂, c₃} := by
    rintro c ⟨p, hp, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    by_cases hp1 : EvenVal 𝔮₄ p.1
    · by_cases hp2 : EvenVal 𝔮₄ p.2
      · exact Or.inl (h_mem_selmer p hp hp1 hp2)
      · refine Or.inr (Or.inl (h_eq_of_mul_eq_one p g₁ (h_mem_selmer (p.1 * g₁.1, p.2 * g₁.2)
          (h_shift_g₁ p hp) ?_ ?_)))
        · exact (hev_mul p.1 g₁.1).mpr ⟨fun _ => hg₁_1, fun _ => hp1⟩
        · exact (hev_mul p.2 g₁.2).mpr ⟨fun h => False.elim (hp2 h), fun h => False.elim (hg₁_2 h)⟩
    · by_cases hp2 : EvenVal 𝔮₄ p.2
      · refine Or.inr (Or.inr (Or.inl (h_eq_of_mul_eq_one p g₂ (h_mem_selmer (p.1 * g₂.1, p.2 * g₂.2)
          (h_shift_g₂ p hp) ?_ ?_))))
        · exact (hev_mul p.1 g₂.1).mpr ⟨fun h => False.elim (hp1 h), fun h => False.elim (hg₂_1 h)⟩
        · exact (hev_mul p.2 g₂.2).mpr ⟨fun _ => hg₂_2, fun _ => hp2⟩
      · refine Or.inr (Or.inr (Or.inr (h_eq_of_mul_eq_one p g₃ (h_mem_selmer (p.1 * g₃.1, p.2 * g₃.2)
          (h_shift_g₃ p hp) ?_ ?_))))
        · exact (hev_mul p.1 g₃.1).mpr ⟨fun h => False.elim (hp1 h), fun h => False.elim (hg₃_1 h)⟩
        · exact (hev_mul p.2 g₃.2).mpr ⟨fun h => False.elim (hp2 h), fun h => False.elim (hg₃_2 h)⟩
  calc (twoSelmerSet K ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃)).encard
    _ ≤ ({c₀, c₁, c₂, c₃} : Set (SqCl K × SqCl K)).encard := Set.encard_le_encard h_sub
    _ ≤ ({c₁, c₂, c₃} : Set (SqCl K × SqCl K)).encard + 1 := Set.encard_insert_le _ _
    _ ≤ (({c₂, c₃} : Set (SqCl K × SqCl K)).encard + 1) + 1 :=
        add_le_add_left (Set.encard_insert_le _ _) 1
    _ ≤ ((({c₃} : Set (SqCl K × SqCl K)).encard + 1) + 1) + 1 :=
        add_le_add_left (add_le_add_left (Set.encard_insert_le _ _) 1) 1
    _ = 4 := by rw [Set.encard_singleton]; rfl

theorem exists_twist_twoSelmerSet_le_four (K : Type u) [Field K] [NumberField K]
    (hreal : 32 ≤ NumberField.InfinitePlace.nrRealPlaces K) :
    ∃ a₁ a₂ a₃ : K,
      a₁ ≠ a₂ ∧ a₁ ≠ a₃ ∧ a₂ ≠ a₃ ∧
      ¬ IsSquare ((a₁ - a₂) * (a₁ - a₃)) ∧
      ¬ IsSquare (-((a₁ - a₂) * (a₂ - a₃))) ∧
      ¬ IsSquare ((a₁ - a₃) * (a₂ - a₃)) ∧
      ∀ (bad : Set (SqCl K)), bad.Finite →
        ∃ (t : Kˣ) (c d m : K),
          sqCl t ∉ bad ∧
          (twoSelmerSet K ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃)).encard ≤ 4 ∧
          d ≠ 0 ∧ m ≠ 0 ∧
          (t : K) = m⁻¹ ^ 2 * d * (c + a₁ * d) * (c + a₂ * d) * (c + a₃ * d) :=
by
  obtain ⟨a₁, a₂, a₃, τ, T, hstart, hT⟩ := exists_starting_curve K hreal
  obtain ⟨S, π, κ, z, haux⟩ := exists_auxiliary_twist K a₁ a₂ a₃ τ T hstart hT
  refine ⟨a₁, a₂, a₃, hstart.1, hstart.2.1, hstart.2.2.1,
    hstart.2.2.2.1, hstart.2.2.2.2.1, hstart.2.2.2.2.2.1, ?_⟩
  intro bad hbad
  obtain ⟨t, c, d, m, 𝔮₁, 𝔮₂, 𝔮₃, 𝔮₄, ht_bad, hd, hm, ht_eq, hsuit⟩ :=
    exists_suitable_twist K hreal a₁ a₂ a₃ τ T S π κ z hstart hT haux bad hbad
  have hsel : (twoSelmerSet K ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃)).encard ≤ 4 :=
    twoSelmerSet_encard_le_four_of_suitable_twist K a₁ a₂ a₃ τ T S t z 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ hstart hT hsuit
  exact ⟨t, c, d, m, ht_bad, hsel, hd, hm, ht_eq⟩

theorem exists_ellipticCurve_rank_stable
    (K L : Type u)
    [Field K] [NumberField K]
    [Field L] [Algebra K L]
    (hreal : 32 ≤ NumberField.InfinitePlace.nrRealPlaces K)
    (hKi : IsGaussianExtension K L) :
    ∃ E : WeierstrassCurve K,
      E.IsElliptic ∧
      mordellWeilRank (E.baseChange L) = mordellWeilRank E ∧
      0 < mordellWeilRank E :=
by
  obtain ⟨a₁, a₂, a₃, h₁₂, h₁₃, h₂₃, hαβ, hαγ, hβγ, htwist⟩ :=
    exists_twist_twoSelmerSet_le_four K hreal
  obtain ⟨bad, hbad_fin, hrank_pos⟩ :=
    rank_pos_of_tautological_twist K a₁ a₂ a₃ h₁₂ h₁₃ h₂₃
  obtain ⟨t, c, d, m, ht_not_bad, hsel, hd, hm, ht_eq⟩ :=
    htwist bad hbad_fin
  have ht0 : (t : K) ≠ 0 := t.ne_zero
  have he₁₂ : (t : K) * a₁ ≠ (t : K) * a₂ := mul_right_injective₀ ht0 |>.ne h₁₂
  have he₁₃ : (t : K) * a₁ ≠ (t : K) * a₃ := mul_right_injective₀ ht0 |>.ne h₁₃
  have he₂₃ : (t : K) * a₂ ≠ (t : K) * a₃ := mul_right_injective₀ ht0 |>.ne h₂₃
  have hne₁₂ : -((t : K) * a₁) ≠ -((t : K) * a₂) := neg_injective.ne he₁₂
  have hne₁₃ : -((t : K) * a₁) ≠ -((t : K) * a₃) := neg_injective.ne he₁₃
  have hne₂₃ : -((t : K) * a₂) ≠ -((t : K) * a₃) := neg_injective.ne he₂₃
  have htαβ : ¬ IsSquare (((t : K) * a₁ - (t : K) * a₂) * ((t : K) * a₁ - (t : K) * a₃)) := by
    rintro ⟨r, hr⟩
    apply hαβ
    refine ⟨r / (t : K), ?_⟩
    have h1 : ((t : K) * a₁ - (t : K) * a₂) * ((t : K) * a₁ - (t : K) * a₃) =
        (t : K) ^ 2 * ((a₁ - a₂) * (a₁ - a₃)) := by ring
    rw [h1] at hr
    calc (a₁ - a₂) * (a₁ - a₃)
      _ = ((t : K) ^ 2 * ((a₁ - a₂) * (a₁ - a₃))) / (t : K) ^ 2 := by
          rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 ht0)]
      _ = (r * r) / (t : K) ^ 2 := by rw [hr]
      _ = (r / (t : K)) * (r / (t : K)) := by ring
  have htαγ : ¬ IsSquare (-(((t : K) * a₁ - (t : K) * a₂) * ((t : K) * a₂ - (t : K) * a₃))) := by
    rintro ⟨r, hr⟩
    apply hαγ
    refine ⟨r / (t : K), ?_⟩
    have h1 : -(((t : K) * a₁ - (t : K) * a₂) * ((t : K) * a₂ - (t : K) * a₃)) =
        (t : K) ^ 2 * (-((a₁ - a₂) * (a₂ - a₃))) := by ring
    rw [h1] at hr
    calc -((a₁ - a₂) * (a₂ - a₃))
      _ = ((t : K) ^ 2 * (-((a₁ - a₂) * (a₂ - a₃)))) / (t : K) ^ 2 := by
          rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 ht0)]
      _ = (r * r) / (t : K) ^ 2 := by rw [hr]
      _ = (r / (t : K)) * (r / (t : K)) := by ring
  have htβγ : ¬ IsSquare (((t : K) * a₁ - (t : K) * a₃) * ((t : K) * a₂ - (t : K) * a₃)) := by
    rintro ⟨r, hr⟩
    apply hβγ
    refine ⟨r / (t : K), ?_⟩
    have h1 : ((t : K) * a₁ - (t : K) * a₃) * ((t : K) * a₂ - (t : K) * a₃) =
        (t : K) ^ 2 * ((a₁ - a₃) * (a₂ - a₃)) := by ring
    rw [h1] at hr
    calc (a₁ - a₃) * (a₂ - a₃)
      _ = ((t : K) ^ 2 * ((a₁ - a₃) * (a₂ - a₃))) / (t : K) ^ 2 := by
          rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 ht0)]
      _ = (r * r) / (t : K) ^ 2 := by rw [hr]
      _ = (r / (t : K)) * (r / (t : K)) := by ring
  have hrk0 : mordellWeilRank (threeRootsCurve ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃)) = 0 :=
    mordellWeilRank_zero_of_twoSelmerSet_le_four K ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃)
      he₁₂ he₁₃ he₂₃ htαβ htαγ htβγ hsel
  refine ⟨threeRootsCurve (-((t : K) * a₁)) (-((t : K) * a₂)) (-((t : K) * a₃)), ?_, ?_, ?_⟩
  · exact threeRootsCurve_isElliptic K (-((t : K) * a₁)) (-((t : K) * a₂)) (-((t : K) * a₃))
      hne₁₂ hne₁₃ hne₂₃
  · exact mordellWeilRank_baseChange_eq_of_twist_rank_zero K L hKi
      ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃) he₁₂ he₁₃ he₂₃ hrk0
  · exact hrank_pos t ht_not_bad c d m hd hm ht_eq
