        · exact Or.inl (Or.inl ⟨hV, h1, h2⟩)
        · exact Or.inr (Or.inl ⟨hV, h1, h2⟩)
        · exact Or.inl (Or.inr ⟨hV, h1, h2⟩)
        · exact Or.inr (Or.inr ⟨hV, h1, h2⟩)
