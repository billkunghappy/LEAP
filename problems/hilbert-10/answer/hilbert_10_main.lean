    have hd₂_odd : ¬ EvenVal v₁ d₂ := by
      intro hd₂_ev
      rw [hneg_ev_iff, hloc_ev_mul] at hd₂_ev
      exact hπ_u_odd (hd₂_ev.mpr hγ_ev)
    have hd₃₄_ev : EvenVal v₁ d₃₄ := (hloc_ev_mul β_u γ_u).mpr ⟨fun _ => hγ_ev, fun _ => hβ_ev⟩
    have hd₃₄_val : (d₃₄ : K) = (δ : K) := hδ3.symm
    have hd₃₄_nsq : ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (d₃₄ : K)) := by
      rw [hd₃₄_val]; exact hv₁δ
    have horth3 : ∀ r : Kˣ × Kˣ,
