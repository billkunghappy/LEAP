      obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective b
      change P (sqCl y * sqCl z) ↔ (P (sqCl y) ↔ P (sqCl z))
      rw [← hsqCl_mul, hP_iff, hP_iff, hP_iff]
