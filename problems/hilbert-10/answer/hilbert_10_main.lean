      have h2 : ∑ k' : Fin d, basisSupNorm ω (c i k') ≤ W i := by
        have hc0 : 0 ≤ basisSupNorm ω (c₀ i) := h_bsn_nonneg (c₀ i)
        dsimp [W]
        linarith
      exact le_trans h1 (le_trans h2 (hW_le_M₀ i))
  let c_main : ℝ := C_vol * B / 2
  have hc_main : 0 < c_main := by positivity
  let M₁ : ℝ := Cerr / c_main
  have hCerr_nonneg : 0 ≤ Cerr := by linarith
  have hM₁_nonneg : 0 ≤ M₁ := div_nonneg hCerr_nonneg (le_of_lt hc_main)
  let L₀ : ℝ := max 1 (max (M₀ ^ e⁻¹) (M₁ ^ f⁻¹))
  have hL₀_ge_one : 1 ≤ L₀ := le_max_left _ _
  let N₁ : ℕ := max (N₀ + 1) (max (⌊Cerr⌋₊ + 1) (⌊Real.exp (Real.exp L₀)⌋₊ + 1))
  have hN₁_ge_one : 1 ≤ N₁ := by
    have : 1 ≤ N₀ + 1 := by omega
    exact le_trans this (le_max_left _ _)
  refine ⟨c_main, N₁, hc_main, hN₁_ge_one, ?_⟩
  intro N hN
  have hN₀ : N₀ ≤ N := by
    have h1 : N₀ + 1 ≤ N₁ := le_max_left _ _
    omega
  have hN_Cerr_nat : ⌊Cerr⌋₊ + 1 ≤ N :=
    le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hN)
  have hCerr_lt_N : Cerr < (N : ℝ) := by
    calc Cerr
      _ < (⌊Cerr⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one Cerr
      _ = ((⌊Cerr⌋₊ + 1 : ℕ) : ℝ) := by push_cast; ring
      _ ≤ (N : ℝ) := Nat.cast_le.mpr hN_Cerr_nat
  have hN1_real : (1 : ℝ) ≤ (N : ℝ) := by linarith
  have hN_pos : (0 : ℝ) < (N : ℝ) := by linarith
  have hN_exp_nat : ⌊Real.exp (Real.exp L₀)⌋₊ + 1 ≤ N :=
    le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hN)
  have hexp_le_N : Real.exp (Real.exp L₀) ≤ (N : ℝ) := by
    calc Real.exp (Real.exp L₀)
      _ ≤ (⌊Real.exp (Real.exp L₀)⌋₊ : ℝ) + 1 := le_of_lt (Nat.lt_floor_add_one _)
      _ = ((⌊Real.exp (Real.exp L₀)⌋₊ + 1 : ℕ) : ℝ) := by push_cast; ring
      _ ≤ (N : ℝ) := Nat.cast_le.mpr hN_exp_nat
  have hexp_le_logN : Real.exp L₀ ≤ Real.log (N : ℝ) :=
    (Real.le_log_iff_exp_le hN_pos).mpr hexp_le_N
  have hlogN_pos : 0 < Real.log (N : ℝ) :=
    lt_of_lt_of_le (Real.exp_pos L₀) hexp_le_logN
  have hL₀_le_L : L₀ ≤ Real.log (Real.log (N : ℝ)) :=
    (Real.le_log_iff_exp_le hlogN_pos).mpr hexp_le_logN
  let L : ℝ := Real.log (Real.log (N : ℝ))
  have hL_ge_one : 1 ≤ L := le_trans hL₀_ge_one hL₀_le_L
  have hL_pos : 0 < L := by linarith
  have hM₀_inv_le_L : M₀ ^ e⁻¹ ≤ L :=
    le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hL₀_le_L)
  have hM₀_le_Le : M₀ ≤ L ^ e := by
    calc M₀
      _ = (M₀ ^ e⁻¹) ^ e := (Real.rpow_inv_rpow hM₀_nonneg (ne_of_gt he_pos)).symm
      _ ≤ L ^ e := Real.rpow_le_rpow (Real.rpow_nonneg hM₀_nonneg e⁻¹) hM₀_inv_le_L (le_of_lt he_pos)
  have h_kfn : ∀ i : Fin 4, kaiFormNorm ω (c₀ i) (c i) (N : ℝ) ≤ L ^ e := by
    intro i
    exact le_trans (h_kfn_le_M₀ N hN1_real i) hM₀_le_Le
  have hM₁_inv_le_L : M₁ ^ f⁻¹ ≤ L :=
    le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hL₀_le_L)
  have hM₁_le_Lf : M₁ ≤ L ^ f := by
    calc M₁
      _ = (M₁ ^ f⁻¹) ^ f := (Real.rpow_inv_rpow hM₁_nonneg (ne_of_gt hf_pos)).symm
      _ ≤ L ^ f := Real.rpow_le_rpow (Real.rpow_nonneg hM₁_nonneg f⁻¹) hM₁_inv_le_L (le_of_lt hf_pos)
  have hLf_pos : 0 < L ^ f := Real.rpow_pos_of_pos hL_pos f
  have hCerr_le : Cerr ≤ c_main * L ^ f := by
    have h1 : Cerr / c_main ≤ L ^ f := hM₁_le_Lf
    have h2 : Cerr ≤ L ^ f * c_main := (div_le_iff₀ hc_main).mp h1
    linarith
  have h_err_le : Cerr * (N : ℝ) ^ d / L ^ f ≤ c_main * (N : ℝ) ^ d := by
    rw [div_le_iff₀ hLf_pos]
    have hNd_nonneg : 0 ≤ (N : ℝ) ^ d := pow_nonneg (le_of_lt hN_pos) d
    calc Cerr * (N : ℝ) ^ d
      _ ≤ (c_main * L ^ f) * (N : ℝ) ^ d := mul_le_mul_of_nonneg_right hCerr_le hNd_nonneg
      _ = c_main * (N : ℝ) ^ d * L ^ f := by ring
  let Ω := Ω₀ ∩ realBox d (N : ℝ)
  have h_est : |kaiSum c₀ c Ω N - (MeasureTheory.volume Ω).toReal * B| ≤ Cerr * (N : ℝ) ^ d / L ^ f :=
    h_a6 N Ω hCerr_lt_N (hΩ_meas N).1 (hΩ_meas N).2.1 (hΩ_meas N).2.2 h_kfn
  have h_diff_le : (MeasureTheory.volume Ω).toReal * B - kaiSum c₀ c Ω N ≤ c_main * (N : ℝ) ^ d :=
    le_trans (abs_sub_le_iff.mp h_est).2 h_err_le
  have h_vol_B : 2 * c_main * (N : ℝ) ^ d ≤ (MeasureTheory.volume Ω).toReal * B := by
    have hvol := hΩ_vol N hN₀
    have hmul : (C_vol * (N : ℝ) ^ d) * B ≤ (MeasureTheory.volume Ω).toReal * B :=
      mul_le_mul_of_nonneg_right hvol (le_of_lt hB_pos)
    have heq : 2 * c_main * (N : ℝ) ^ d = (C_vol * (N : ℝ) ^ d) * B := by
      dsimp [c_main]
      ring
    linarith
  linarith

theorem card_generators_of_canNorm_le (K : Type u) [Field K] [NumberField K] :
    ∃ C_gen : ℕ, 1 ≤ C_gen ∧
      ∀ (R : ℕ), 1 ≤ R →
      ∀ (I : Ideal (NumberField.RingOfIntegers K)), I ≠ ⊥ →
      ∀ (F : Finset (NumberField.RingOfIntegers K)),
        (∀ α ∈ F, Ideal.span {α} = I ∧ canNorm K (α : K) ≤ (R : ℝ)) →
        F.card ≤ C_gen * R :=
by
  open scoped Classical in
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let B_real := Module.Basis.ofZLatticeBasis ℝ
    (NumberField.Units.unitLattice K) (NumberField.Units.basisUnitLattice K)
  let reprCLM : NumberField.Units.dirichletUnitTheorem.logSpace K →L[ℝ] (Fin r → ℝ) :=
    LinearMap.toContinuousLinearMap B_real.equivFun.toLinearMap
  let C₀ : ℕ := max 1 ⌈‖reprCLM‖ * ((n * (n + 1) : ℕ) : ℝ)⌉₊
  let T_K : ℕ := Fintype.card (NumberField.Units.torsion K)
  let C₁ : ℕ := (2 * C₀) ^ r * r.factorial * ⌈Real.exp 1⌉₊
  let C_gen : ℕ := max 1 (T_K * C₁)
  refine ⟨C_gen, le_max_left 1 _, ?_⟩
  intro R hR I hI F hF
  have hR1 : (1 : ℝ) ≤ (R : ℝ) := Nat.one_le_cast.mpr hR
  have hR_pos : (0 : ℝ) < (R : ℝ) := by positivity
  have hR_nonneg : (0 : ℝ) ≤ (R : ℝ) := le_of_lt hR_pos
  
  have h_ub : ∀ (β : NumberField.RingOfIntegers K), canNorm K (β : K) ≤ (R : ℝ) →
      ∀ w : NumberField.InfinitePlace K, w (β : K) ≤ (R : ℝ) := by
    intro β hcan w
    exact le_trans
      (le_ciSup (Finite.bddAbove_range (fun v : NumberField.InfinitePlace K => v (β : K))) w)
      hcan
  have h_lb : ∀ (β : NumberField.RingOfIntegers K), β ≠ 0 → canNorm K (β : K) ≤ (R : ℝ) →
      ∀ w₀ : NumberField.InfinitePlace K, 1 ≤ w₀ (β : K) * (R : ℝ) ^ n := by
    intro β hβ hcan w₀
    have hnorm_ne : Algebra.norm ℤ β ≠ 0 := Algebra.norm_ne_zero_iff.mpr hβ
    have hnorm_ge1 : (1 : ℤ) ≤ |Algebra.norm ℤ β| := Int.one_le_abs hnorm_ne
    have hnorm_loc : Algebra.norm ℚ (β : K) = (Algebra.norm ℤ β : ℚ) := by
      rw [NumberField.RingOfIntegers.coe_eq_algebraMap]
      exact Algebra.norm_localization ℤ (nonZeroDivisors ℤ) β (Rₘ := ℚ) (Sₘ := K)
    have hprod_ge1 : (1 : ℝ) ≤ ∏ w : NumberField.InfinitePlace K, w (β : K) ^ w.mult := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm, hnorm_loc]
      exact_mod_cast hnorm_ge1
    have hsplit : w₀ (β : K) ^ w₀.mult *
        ∏ w ∈ Finset.univ.erase w₀, w (β : K) ^ w.mult =
        ∏ w : NumberField.InfinitePlace K, w (β : K) ^ w.mult :=
      Finset.mul_prod_erase Finset.univ (fun w : NumberField.InfinitePlace K => w (β : K) ^ w.mult)
        (Finset.mem_univ w₀)
    have herase_le : ∏ w ∈ Finset.univ.erase w₀, w (β : K) ^ w.mult ≤ (R : ℝ) ^ n := by
      calc ∏ w ∈ Finset.univ.erase w₀, w (β : K) ^ w.mult
        _ ≤ ∏ w ∈ Finset.univ.erase w₀, (R : ℝ) ^ w.mult := by
            apply Finset.prod_le_prod
            · intro w _
              exact pow_nonneg (apply_nonneg w (β : K)) w.mult
            · intro w _
              exact pow_le_pow_left₀ (apply_nonneg w (β : K)) (h_ub β hcan w) w.mult
        _ = (R : ℝ) ^ (∑ w ∈ Finset.univ.erase w₀, w.mult) := Finset.prod_pow_eq_pow_sum _ _ _
        _ ≤ (R : ℝ) ^ n := by
            apply pow_le_pow_right₀ hR1
            have hsum_le : ∑ w ∈ Finset.univ.erase w₀, w.mult ≤
                ∑ w : NumberField.InfinitePlace K, w.mult :=
              Finset.sum_le_univ_sum_of_nonneg (fun w => Nat.zero_le w.mult)
            rwa [NumberField.InfinitePlace.sum_mult_eq] at hsum_le
    have hmult_lb : (1 : ℝ) ≤ w₀ (β : K) ^ w₀.mult * (R : ℝ) ^ n := by
      calc (1 : ℝ)
        _ ≤ w₀ (β : K) ^ w₀.mult * ∏ w ∈ Finset.univ.erase w₀, w (β : K) ^ w.mult := by
            linarith [hprod_ge1, hsplit]
        _ ≤ w₀ (β : K) ^ w₀.mult * (R : ℝ) ^ n := by
            exact mul_le_mul_of_nonneg_left herase_le
              (pow_nonneg (apply_nonneg w₀ (β : K)) w₀.mult)
    by_cases hw₀1 : 1 ≤ w₀ (β : K)
    · have hRn1 : (1 : ℝ) ≤ (R : ℝ) ^ n := one_le_pow₀ hR1
      calc (1 : ℝ) = 1 * 1 := by ring
        _ ≤ w₀ (β : K) * (R : ℝ) ^ n :=
            mul_le_mul hw₀1 hRn1 zero_le_one (le_trans zero_le_one hw₀1)
    · have hw₀_le1 : w₀ (β : K) ≤ 1 := le_of_not_ge hw₀1
      have hpow_le : w₀ (β : K) ^ w₀.mult ≤ w₀ (β : K) :=
        pow_le_of_le_one (apply_nonneg w₀ (β : K)) hw₀_le1 NumberField.InfinitePlace.mult_ne_zero
      exact le_trans hmult_lb (mul_le_mul_of_nonneg_right hpow_le (by positivity))
  
  have h_unit_place : ∀ (β₁ β₂ : NumberField.RingOfIntegers K)
      (v : (NumberField.RingOfIntegers K)ˣ),
      β₁ ≠ 0 → canNorm K (β₁ : K) ≤ (R : ℝ) → canNorm K (β₂ : K) ≤ (R : ℝ) →
      β₁ * (v : NumberField.RingOfIntegers K) = β₂ →
      ∀ w : NumberField.InfinitePlace K, w ((v : NumberField.RingOfIntegers K) : K) ≤ (R : ℝ) ^ (n + 1) := by
    intro β₁ β₂ v hβ₁ hcan₁ hcan₂ hmul w
    have hmul_K : (β₁ : K) * ((v : NumberField.RingOfIntegers K) : K) = (β₂ : K) := by
      exact_mod_cast hmul
    have hw_mul : w (β₁ : K) * w ((v : NumberField.RingOfIntegers K) : K) ≤ (R : ℝ) := by
      rw [← map_mul w, hmul_K]
      exact h_ub β₂ hcan₂ w
    have hw_lb : 1 ≤ w (β₁ : K) * (R : ℝ) ^ n := h_lb β₁ hβ₁ hcan₁ w
    have hwv_nonneg : 0 ≤ w ((v : NumberField.RingOfIntegers K) : K) := apply_nonneg w _
    have hRn_nonneg : 0 ≤ (R : ℝ) ^ n := by positivity
    calc w ((v : NumberField.RingOfIntegers K) : K)
      _ = w ((v : NumberField.RingOfIntegers K) : K) * 1 := (mul_one _).symm
      _ ≤ w ((v : NumberField.RingOfIntegers K) : K) * (w (β₁ : K) * (R : ℝ) ^ n) :=
          mul_le_mul_of_nonneg_left hw_lb hwv_nonneg
      _ = (w (β₁ : K) * w ((v : NumberField.RingOfIntegers K) : K)) * (R : ℝ) ^ n := by ring
      _ ≤ (R : ℝ) * (R : ℝ) ^ n := mul_le_mul_of_nonneg_right hw_mul hRn_nonneg
      _ = (R : ℝ) ^ (n + 1) := by rw [pow_succ']
  have h_logEmb_bound : ∀ (α₀ α : NumberField.RingOfIntegers K)
      (u : (NumberField.RingOfIntegers K)ˣ),
      α₀ ≠ 0 → α ≠ 0 → canNorm K (α₀ : K) ≤ (R : ℝ) → canNorm K (α : K) ≤ (R : ℝ) →
      α₀ * (u : NumberField.RingOfIntegers K) = α →
      ‖NumberField.Units.logEmbedding K (Additive.ofMul u)‖ ≤
        ((n * (n + 1) : ℕ) : ℝ) * Real.log (R : ℝ) := by
    intro α₀ α u hα₀ hα hcan₀ hcan hmul
    have hmul_inv : α * ((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) = α₀ := by
      calc α * ((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)
        _ = (α₀ * (u : NumberField.RingOfIntegers K)) *
              ((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) := by rw [hmul]
        _ = α₀ * ((u : NumberField.RingOfIntegers K) *
              ((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)) := by ring
        _ = α₀ * 1 := by rw [Units.mul_inv]
        _ = α₀ := mul_one α₀
    have hlogR_nonneg : 0 ≤ Real.log (R : ℝ) := Real.log_nonneg hR1
    have hbound_nonneg : 0 ≤ ((n * (n + 1) : ℕ) : ℝ) * Real.log (R : ℝ) := by positivity
    rw [pi_norm_le_iff_of_nonneg hbound_nonneg]
    intro w
    rw [NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
    rw [← NumberField.RingOfIntegers.coe_eq_algebraMap]
    have hu_le : w.1 ((u : NumberField.RingOfIntegers K) : K) ≤ (R : ℝ) ^ (n + 1) :=
      h_unit_place α₀ α u hα₀ hcan₀ hcan hmul w.1
    have hu_inv_le : w.1 (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) ≤
        (R : ℝ) ^ (n + 1) :=
      h_unit_place α α₀ u⁻¹ hα hcan hcan₀ hmul_inv w.1
    have hu_ne : ((u : NumberField.RingOfIntegers K) : K) ≠ 0 := by
      exact_mod_cast u.ne_zero
    have hw_pos : 0 < w.1 ((u : NumberField.RingOfIntegers K) : K) :=
      (NumberField.InfinitePlace.pos_iff).mpr hu_ne
    have h_inv_eq : w.1 (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) =
        (w.1 ((u : NumberField.RingOfIntegers K) : K))⁻¹ := by
      have h1 : ((u : NumberField.RingOfIntegers K) : K) *
          (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1 := by
        exact_mod_cast Units.mul_inv u
      have h2 : w.1 ((u : NumberField.RingOfIntegers K) : K) *
          w.1 (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1 := by
        rw [← map_mul w.1, h1, map_one]
      exact eq_inv_of_mul_eq_one_right h2
    have hlog_upper : Real.log (w.1 ((u : NumberField.RingOfIntegers K) : K)) ≤
        ((n + 1 : ℕ) : ℝ) * Real.log (R : ℝ) := by
      calc Real.log (w.1 ((u : NumberField.RingOfIntegers K) : K))
        _ ≤ Real.log ((R : ℝ) ^ (n + 1)) := Real.log_le_log hw_pos hu_le
        _ = ((n + 1 : ℕ) : ℝ) * Real.log (R : ℝ) := Real.log_pow (R : ℝ) (n + 1)
    have hlog_lower : -(((n + 1 : ℕ) : ℝ) * Real.log (R : ℝ)) ≤
        Real.log (w.1 ((u : NumberField.RingOfIntegers K) : K)) := by
      have h_neg : -Real.log (w.1 ((u : NumberField.RingOfIntegers K) : K)) ≤
          ((n + 1 : ℕ) : ℝ) * Real.log (R : ℝ) := by
        rw [← Real.log_inv]
        rw [h_inv_eq] at hu_inv_le
        calc Real.log ((w.1 ((u : NumberField.RingOfIntegers K) : K))⁻¹)
          _ ≤ Real.log ((R : ℝ) ^ (n + 1)) := Real.log_le_log (inv_pos.mpr hw_pos) hu_inv_le
          _ = ((n + 1 : ℕ) : ℝ) * Real.log (R : ℝ) := Real.log_pow (R : ℝ) (n + 1)
      linarith
    have habs_log : |Real.log (w.1 ((u : NumberField.RingOfIntegers K) : K))| ≤
        ((n + 1 : ℕ) : ℝ) * Real.log (R : ℝ) :=
      abs_le.mpr ⟨hlog_lower, hlog_upper⟩
    have hmult_le_n : w.1.mult ≤ n := by
      have h1 : w.1.mult ≤ ∑ v : NumberField.InfinitePlace K, v.mult :=
        Finset.single_le_sum (fun v _ => Nat.zero_le v.mult) (Finset.mem_univ w.1)
      rwa [NumberField.InfinitePlace.sum_mult_eq] at h1
    have hmult_real : |(w.1.mult : ℝ)| ≤ (n : ℝ) := by
      rw [abs_of_nonneg (Nat.cast_nonneg _)]
      exact Nat.cast_le.mpr hmult_le_n
    rw [Real.norm_eq_abs, abs_mul]
    calc |(w.1.mult : ℝ)| * |Real.log (w.1 ((u : NumberField.RingOfIntegers K) : K))|
      _ ≤ (n : ℝ) * (((n + 1 : ℕ) : ℝ) * Real.log (R : ℝ)) :=
          mul_le_mul hmult_real habs_log (abs_nonneg _) (Nat.cast_nonneg n)
      _ = ((n * (n + 1) : ℕ) : ℝ) * Real.log (R : ℝ) := by push_cast; ring
  
  let L : ℕ := ⌊(C₀ : ℝ) * Real.log (R : ℝ)⌋₊
  let unitCoord : (NumberField.RingOfIntegers K)ˣ → (Fin r → ℤ) :=
    fun u i => (NumberField.Units.basisUnitLattice K).repr
      (NumberField.Units.logEmbeddingEquiv K (Additive.ofMul (QuotientGroup.mk u))) i
  have h_coord_natAbs : ∀ (u : (NumberField.RingOfIntegers K)ˣ) (i : Fin r),
      ‖NumberField.Units.logEmbedding K (Additive.ofMul u)‖ ≤
        ((n * (n + 1) : ℕ) : ℝ) * Real.log (R : ℝ) →
      (unitCoord u i).natAbs ≤ L := by
    intro u i hnorm
    apply Nat.le_floor
    let x_u := NumberField.Units.logEmbeddingEquiv K (Additive.ofMul (QuotientGroup.mk u))
    have h_repr : ((unitCoord u i : ℤ) : ℝ) =
        reprCLM (NumberField.Units.logEmbedding K (Additive.ofMul u)) i :=
      (Module.Basis.ofZLatticeBasis_repr_apply ℝ
        (NumberField.Units.unitLattice K) (NumberField.Units.basisUnitLattice K) x_u i).symm
    have h_natAbs : ((unitCoord u i).natAbs : ℝ) = |((unitCoord u i : ℤ) : ℝ)| := by
      rw [Nat.cast_natAbs, Int.cast_abs]
    rw [h_natAbs, h_repr, ← Real.norm_eq_abs]
    have h_pi : ‖reprCLM (NumberField.Units.logEmbedding K (Additive.ofMul u)) i‖ ≤
        ‖reprCLM‖ * ‖NumberField.Units.logEmbedding K (Additive.ofMul u)‖ :=
      (norm_le_pi_norm (reprCLM (NumberField.Units.logEmbedding K (Additive.ofMul u))) i).trans
        (reprCLM.le_opNorm (NumberField.Units.logEmbedding K (Additive.ofMul u)))
    have hC₀_ge : ‖reprCLM‖ * ((n * (n + 1) : ℕ) : ℝ) ≤ (C₀ : ℝ) := by
      calc ‖reprCLM‖ * ((n * (n + 1) : ℕ) : ℝ)
        _ ≤ (⌈‖reprCLM‖ * ((n * (n + 1) : ℕ) : ℝ)⌉₊ : ℝ) := Nat.le_ceil _
        _ ≤ (C₀ : ℝ) := by exact_mod_cast le_max_right 1 _
    calc ‖reprCLM (NumberField.Units.logEmbedding K (Additive.ofMul u)) i‖
      _ ≤ ‖reprCLM‖ * ‖NumberField.Units.logEmbedding K (Additive.ofMul u)‖ := h_pi
      _ ≤ ‖reprCLM‖ * (((n * (n + 1) : ℕ) : ℝ) * Real.log (R : ℝ)) :=
          mul_le_mul_of_nonneg_left hnorm (norm_nonneg reprCLM)
      _ = (‖reprCLM‖ * ((n * (n + 1) : ℕ) : ℝ)) * Real.log (R : ℝ) := by ring
      _ ≤ (C₀ : ℝ) * Real.log (R : ℝ) :=
          mul_le_mul_of_nonneg_right hC₀_ge (Real.log_nonneg hR1)
  have h_coord_mem : ∀ (u : (NumberField.RingOfIntegers K)ˣ),
      ‖NumberField.Units.logEmbedding K (Additive.ofMul u)‖ ≤
        ((n * (n + 1) : ℕ) : ℝ) * Real.log (R : ℝ) →
      unitCoord u ∈ intBox r L := by
    intro u hnorm
    rw [intBox, Finset.mem_Icc]
    refine ⟨fun i => ?_, fun i => ?_⟩
    · have h_le_L : (unitCoord u i).natAbs ≤ L := h_coord_natAbs u i hnorm
      change -(L : ℤ) ≤ unitCoord u i
      omega
    · have h_le_L : (unitCoord u i).natAbs ≤ L := h_coord_natAbs u i hnorm
      change unitCoord u i ≤ (L : ℤ)
      omega
  
  have h_card_F : F.card ≤ T_K * (2 * L + 1) ^ r := by
    by_cases hF_ne : F.Nonempty
    · let α₀ : NumberField.RingOfIntegers K := hF_ne.choose
      have hα₀_mem : α₀ ∈ F := hF_ne.choose_spec
      have h_ne_zero : ∀ α ∈ F, α ≠ 0 := by
        intro α hα h0
        apply hI
        rw [← (hF α hα).1, h0, Ideal.span_singleton_eq_bot]
      have hα₀_ne : α₀ ≠ 0 := h_ne_zero α₀ hα₀_mem
      have h_assoc : ∀ α ∈ F, Associated α₀ α := by
        intro α hα
        rw [← Ideal.span_singleton_eq_span_singleton, (hF α₀ hα₀_mem).1, (hF α hα).1]
      let u_of : NumberField.RingOfIntegers K → (NumberField.RingOfIntegers K)ˣ :=
        fun α => if h : Associated α₀ α then h.choose else 1
      have hu_of_spec : ∀ α ∈ F, α₀ * (u_of α : NumberField.RingOfIntegers K) = α := by
        intro α hα
        dsimp [u_of]
        rw [dif_pos (h_assoc α hα)]
        exact (h_assoc α hα).choose_spec
      let ϕ : NumberField.RingOfIntegers K → (Fin r → ℤ) := fun α => unitCoord (u_of α)
      have h_img_sub : Finset.image ϕ F ⊆ intBox r L := by
        rw [Finset.image_subset_iff]
        intro α hα
        apply h_coord_mem (u_of α)
        exact h_logEmb_bound α₀ α (u_of α) hα₀_ne (h_ne_zero α hα)
          (hF α₀ hα₀_mem).2 (hF α hα).2 (hu_of_spec α hα)
      have h_box_card : (intBox r L).card = (2 * L + 1) ^ r := by
        dsimp [intBox]
        rw [Pi.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        congr 1
        rw [Int.card_Icc]
        omega
      have h_img_card : (Finset.image ϕ F).card ≤ (2 * L + 1) ^ r := by
        rw [← h_box_card]
        exact Finset.card_le_card h_img_sub
      have h_fiber : ∀ b ∈ Finset.image ϕ F,
          ({α ∈ F | ϕ α = b}).card ≤ T_K := by
        intro b hb
        obtain ⟨α_b, hα_b_mem, hα_b_eq⟩ := Finset.mem_image.mp hb
        have h_tors : ∀ α ∈ F, ϕ α = b →
            (u_of α_b)⁻¹ * u_of α ∈ NumberField.Units.torsion K := by
          intro α hα hϕα
          have h_coord_eq : unitCoord (u_of α) = unitCoord (u_of α_b) := by
            change ϕ α = ϕ α_b
            rw [hϕα, hα_b_eq]
          have h_finsupp_eq :
              (NumberField.Units.basisUnitLattice K).repr
                (NumberField.Units.logEmbeddingEquiv K (Additive.ofMul (QuotientGroup.mk (u_of α)))) =
              (NumberField.Units.basisUnitLattice K).repr
                (NumberField.Units.logEmbeddingEquiv K (Additive.ofMul (QuotientGroup.mk (u_of α_b)))) := by
            ext i
            exact congr_fun h_coord_eq i
          have h_lat_eq := (NumberField.Units.basisUnitLattice K).repr.injective h_finsupp_eq
          have h_add_eq := (NumberField.Units.logEmbeddingEquiv K).injective h_lat_eq
          have h_quot_eq : (QuotientGroup.mk (u_of α) :
              (NumberField.RingOfIntegers K)ˣ ⧸ NumberField.Units.torsion K) =
              QuotientGroup.mk (u_of α_b) :=
            Additive.ofMul.injective h_add_eq
          exact QuotientGroup.eq.mp h_quot_eq.symm
        let g : NumberField.RingOfIntegers K → NumberField.Units.torsion K :=
          fun α => if h : (u_of α_b)⁻¹ * u_of α ∈ NumberField.Units.torsion K
            then ⟨(u_of α_b)⁻¹ * u_of α, h⟩ else 1
        have h_inj : Set.InjOn g ({α ∈ F | ϕ α = b} : Finset (NumberField.RingOfIntegers K)) := by
          intro α₁ hα₁ α₂ hα₂ hg
          rw [Finset.mem_coe, Finset.mem_filter] at hα₁ hα₂
          have ht₁ := h_tors α₁ hα₁.1 hα₁.2
          have ht₂ := h_tors α₂ hα₂.1 hα₂.2
          dsimp [g] at hg
          rw [dif_pos ht₁, dif_pos ht₂, Subtype.mk.injEq] at hg
          have hu_eq : u_of α₁ = u_of α₂ := mul_left_cancel hg
          rw [← hu_of_spec α₁ hα₁.1, ← hu_of_spec α₂ hα₂.1, hu_eq]
        have h_le_univ : ({α ∈ F | ϕ α = b}).card ≤
            (Finset.univ : Finset (NumberField.Units.torsion K)).card :=
          Finset.card_le_card_of_injOn g (fun _ _ => Finset.mem_univ _) h_inj
        rwa [Finset.card_univ] at h_le_univ
      calc F.card
        _ ≤ T_K * (Finset.image ϕ F).card := Finset.card_le_mul_card_image F T_K h_fiber
        _ ≤ T_K * (2 * L + 1) ^ r := Nat.mul_le_mul_left T_K h_img_card
    · rw [Finset.not_nonempty_iff_eq_empty.mp hF_ne, Finset.card_empty]
      exact Nat.zero_le _
  
  have h_box_le : (2 * L + 1) ^ r ≤ C₁ * R := by
    have hlogR_nonneg : 0 ≤ Real.log (R : ℝ) := Real.log_nonneg hR1
    have hL_le : (L : ℝ) ≤ (C₀ : ℝ) * Real.log (R : ℝ) :=
      Nat.floor_le (by positivity)
    have hC₀_ge1 : (1 : ℝ) ≤ (C₀ : ℝ) := by
      exact_mod_cast le_max_left 1 ⌈‖reprCLM‖ * ((n * (n + 1) : ℕ) : ℝ)⌉₊
    have h2L1_le : ((2 * L + 1 : ℕ) : ℝ) ≤ (2 * C₀ : ℝ) * (Real.log (R : ℝ) + 1) := by
      push_cast
      linarith
    have hpow_le : (((2 * L + 1) ^ r : ℕ) : ℝ) ≤
        ((2 * C₀) ^ r : ℝ) * (Real.log (R : ℝ) + 1) ^ r := by
      calc (((2 * L + 1) ^ r : ℕ) : ℝ)
        _ = ((2 * L + 1 : ℕ) : ℝ) ^ r := by push_cast; rfl
        _ ≤ ((2 * C₀ : ℝ) * (Real.log (R : ℝ) + 1)) ^ r :=
            pow_le_pow_left₀ (by positivity) h2L1_le r
        _ = ((2 * C₀) ^ r : ℝ) * (Real.log (R : ℝ) + 1) ^ r := by
            rw [mul_pow]
    have h_fact_exp : (Real.log (R : ℝ) + 1) ^ r ≤
        (r.factorial : ℝ) * (⌈Real.exp 1⌉₊ : ℝ) * (R : ℝ) := by
      have hx_nonneg : 0 ≤ Real.log (R : ℝ) + 1 := by positivity
      have h_taylor := Real.pow_div_factorial_le_exp (Real.log (R : ℝ) + 1) hx_nonneg r
      have hexp_eq : Real.exp (Real.log (R : ℝ) + 1) ≤ (R : ℝ) * (⌈Real.exp 1⌉₊ : ℝ) := by
        rw [Real.exp_add, Real.exp_log hR_pos]
        exact mul_le_mul_of_nonneg_left (Nat.le_ceil (Real.exp 1)) hR_nonneg
      have h_div_le : (Real.log (R : ℝ) + 1) ^ r / (r.factorial : ℝ) ≤
          (R : ℝ) * (⌈Real.exp 1⌉₊ : ℝ) := le_trans h_taylor hexp_eq
      have hrfact_pos : (0 : ℝ) < (r.factorial : ℝ) :=
        Nat.cast_pos.mpr (Nat.factorial_pos r)
      have h_mul := (div_le_iff₀ hrfact_pos).mp h_div_le
      linarith
    have h_real_ineq : (((2 * L + 1) ^ r : ℕ) : ℝ) ≤ ((C₁ * R : ℕ) : ℝ) := by
      calc (((2 * L + 1) ^ r : ℕ) : ℝ)
        _ ≤ ((2 * C₀) ^ r : ℝ) * (Real.log (R : ℝ) + 1) ^ r := hpow_le
        _ ≤ ((2 * C₀) ^ r : ℝ) * ((r.factorial : ℝ) * (⌈Real.exp 1⌉₊ : ℝ) * (R : ℝ)) :=
            mul_le_mul_of_nonneg_left h_fact_exp (by positivity)
        _ = ((C₁ * R : ℕ) : ℝ) := by
            dsimp [C₁]
            push_cast
            ring
    exact Nat.cast_le.mp h_real_ineq
  calc F.card
    _ ≤ T_K * (2 * L + 1) ^ r := h_card_F
    _ ≤ T_K * (C₁ * R) := Nat.mul_le_mul_left T_K h_box_le
    _ = (T_K * C₁) * R := by ring
    _ ≤ C_gen * R := Nat.mul_le_mul_right R (le_max_right 1 (T_K * C₁))

theorem card_primePowerIdeals_le (K : Type u) [Field K] [NumberField K]
    (hreal : 32 ≤ NumberField.InfinitePlace.nrRealPlaces K)
    (M : ℕ) (hM : 1 ≤ M)
    (ℐ : Finset (Ideal (NumberField.RingOfIntegers K)))
    (hℐ : ∀ I ∈ ℐ, Ideal.absNorm I ≤ M ^ (Module.finrank ℚ K) ∧
      ∃ (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
        2 ≤ m ∧ I = 𝔭.asIdeal ^ m) :
    ℐ.card ≤ (Module.finrank ℚ K) ^ 2 * M ^ (Module.finrank ℚ K - 6) :=
by
  open scoped Classical in
  let n := Module.finrank ℚ K
  have hn_real : NumberField.InfinitePlace.nrRealPlaces K ≤ n := by
    have h1 := NumberField.InfinitePlace.card_real_embeddings K
    have h2 := NumberField.Embeddings.card K ℂ
    have h3 := Fintype.card_subtype_le (fun φ : K →+* ℂ => NumberField.ComplexEmbedding.IsReal φ)
    omega
  have hn32 : 32 ≤ n := le_trans hreal hn_real
  have h_max_card : ∀ (k : ℕ), 2 ≤ k →
      ∀ (Ps : Finset (Ideal (NumberField.RingOfIntegers K))),
        (∀ Q ∈ Ps, Q.IsMaximal ∧ Ideal.absNorm Q = k) →
        Ps.card ≤ n := by
    intro k hk Ps hPs
    have h_span_norm : Ideal.absNorm (Ideal.span {(k : NumberField.RingOfIntegers K)}) = k ^ n := by
      rw [Ideal.absNorm_span_singleton]
      have hk_alg : (k : NumberField.RingOfIntegers K) =
          algebraMap ℤ (NumberField.RingOfIntegers K) (k : ℤ) := by simp
      rw [hk_alg, Algebra.norm_algebraMap_of_basis (NumberField.RingOfIntegers.basis K)]
      have h_card : Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) = n := by
        rw [← Module.finrank_eq_card_chooseBasisIndex, NumberField.RingOfIntegers.rank]
      rw [h_card, Int.natAbs_pow, Int.natAbs_natCast]
    have h_dvd : ∀ Q ∈ Ps, Q ∣ Ideal.span {(k : NumberField.RingOfIntegers K)} := by
      intro Q hQ
      rw [Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem, ← (hPs Q hQ).2]
      exact Ideal.absNorm_mem Q
    have h_coprime : (Ps : Set (Ideal (NumberField.RingOfIntegers K))).Pairwise IsCoprime := by
      intro Q₁ hQ₁ Q₂ hQ₂ hne
      haveI : Q₁.IsMaximal := (hPs Q₁ hQ₁).1
      haveI : Q₂.IsMaximal := (hPs Q₂ hQ₂).1
      exact Ideal.isCoprime_of_isMaximal hne
    have h_prod_dvd : (∏ Q ∈ Ps, Q) ∣ Ideal.span {(k : NumberField.RingOfIntegers K)} :=
      Finset.prod_dvd_of_coprime h_coprime h_dvd
    have h_norm_dvd : Ideal.absNorm (∏ Q ∈ Ps, Q) ∣
        Ideal.absNorm (Ideal.span {(k : NumberField.RingOfIntegers K)}) :=
      map_dvd Ideal.absNorm h_prod_dvd
    have h_prod_norm : Ideal.absNorm (∏ Q ∈ Ps, Q) = k ^ Ps.card := by
      rw [map_prod]
      have h_congr : (∏ Q ∈ Ps, Ideal.absNorm Q) = ∏ _Q ∈ Ps, k :=
        Finset.prod_congr rfl (fun Q hQ => (hPs Q hQ).2)
      rw [h_congr, Finset.prod_const]
    rw [h_prod_norm, h_span_norm] at h_norm_dvd
    have hk_pos : 0 < k ^ n := by positivity
    have h_le : k ^ Ps.card ≤ k ^ n := Nat.le_of_dvd hk_pos h_norm_dvd
    exact (Nat.pow_le_pow_iff_right (by omega : 1 < k)).mp h_le
  have h_km_bounds : ∀ (k m : ℕ), 2 ≤ k → 2 ≤ m → k ^ m ≤ M ^ n →
      (1 ≤ k ∧ k ≤ M ^ (n - 15)) ∧ (1 ≤ m ∧ m ≤ n * M) := by
    intro k m hk hm hkm
    refine ⟨⟨by omega, ?_⟩, ⟨by omega, ?_⟩⟩
    · have hk2 : k ^ 2 ≤ (M ^ (n - 15)) ^ 2 := by
        calc k ^ 2
          _ ≤ k ^ m := Nat.pow_le_pow_right (by omega) hm
          _ ≤ M ^ n := hkm
          _ ≤ M ^ (2 * (n - 15)) := Nat.pow_le_pow_right hM (by omega)
          _ = (M ^ (n - 15)) ^ 2 := by rw [pow_mul']
      exact (Nat.pow_le_pow_iff_left (by omega : 2 ≠ 0)).mp hk2
    · have hm2 : 2 ^ m ≤ 2 ^ (n * M) := by
        have hM2 : M ≤ 2 ^ M := le_of_lt (Nat.lt_two_pow_self)
        calc 2 ^ m
          _ ≤ k ^ m := Nat.pow_le_pow_left hk m
          _ ≤ M ^ n := hkm
          _ ≤ (2 ^ M) ^ n := Nat.pow_le_pow_left hM2 n
          _ = 2 ^ (n * M) := by rw [← pow_mul, mul_comm]
      exact (Nat.pow_le_pow_iff_right (by omega : 1 < 2)).mp hm2
  let P (I : Ideal (NumberField.RingOfIntegers K)) : Prop :=
    ∃ (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      2 ≤ m ∧ I = 𝔭.asIdeal ^ m
  let pOf (I : Ideal (NumberField.RingOfIntegers K)) : Ideal (NumberField.RingOfIntegers K) :=
    if h : P I then h.choose.asIdeal else ⊥
  let mOf (I : Ideal (NumberField.RingOfIntegers K)) : ℕ :=
    if h : P I then h.choose_spec.choose else 0
  let kOf (I : Ideal (NumberField.RingOfIntegers K)) : ℕ :=
    Ideal.absNorm (pOf I)
  let f (I : Ideal (NumberField.RingOfIntegers K)) : ℕ × ℕ := (kOf I, mOf I)
  have hI_props : ∀ I ∈ ℐ,
      (pOf I).IsMaximal ∧ 2 ≤ kOf I ∧ 2 ≤ mOf I ∧
      I = (pOf I) ^ (mOf I) ∧ (kOf I) ^ (mOf I) ≤ M ^ n := by
    intro I hI
    have hP : P I := (hℐ I hI).2
    let 𝔭 := hP.choose
    let m := hP.choose_spec.choose
    have hm : 2 ≤ m ∧ I = 𝔭.asIdeal ^ m := hP.choose_spec.choose_spec
    have hp_eq : pOf I = 𝔭.asIdeal := dif_pos hP
    have hm_eq : mOf I = m := dif_pos hP
    have hp_max : (pOf I).IsMaximal := by
      rw [hp_eq]
      exact 𝔭.isMaximal
    have hk_ge2 : 2 ≤ kOf I := by
      have hne0 : kOf I ≠ 0 := by
        intro h0
        have h0' : Ideal.absNorm 𝔭.asIdeal = 0 := by
          rw [← hp_eq]
          exact h0
        exact 𝔭.ne_bot (Ideal.absNorm_eq_zero_iff.mp h0')
      have hne1 : kOf I ≠ 1 := by
        intro h1
        have h1' : Ideal.absNorm 𝔭.asIdeal = 1 := by
          rw [← hp_eq]
          exact h1
        exact 𝔭.isPrime.ne_top (Ideal.absNorm_eq_one_iff.mp h1')
      omega
    have hm_ge2 : 2 ≤ mOf I := by
      rw [hm_eq]
      exact hm.1
    have hI_eq : I = (pOf I) ^ (mOf I) := by
      rw [hp_eq, hm_eq]
      exact hm.2
    have hkm_le : (kOf I) ^ (mOf I) ≤ M ^ n := by
      calc (kOf I) ^ (mOf I)
        _ = (Ideal.absNorm (pOf I)) ^ (mOf I) := rfl
        _ = Ideal.absNorm ((pOf I) ^ (mOf I)) := (map_pow Ideal.absNorm (pOf I) (mOf I)).symm
        _ = Ideal.absNorm I := by rw [← hI_eq]
        _ ≤ M ^ n := (hℐ I hI).1
    exact ⟨hp_max, hk_ge2, hm_ge2, hI_eq, hkm_le⟩
  let B : Finset (ℕ × ℕ) := Finset.Icc 1 (M ^ (n - 15)) ×ˢ Finset.Icc 1 (n * M)
  have h_img_sub : Finset.image f ℐ ⊆ B := by
    intro b hb
    rcases Finset.mem_image.mp hb with ⟨I, hI, rfl⟩
    obtain ⟨_, hk2, hm2, _, hkm⟩ := hI_props I hI
    obtain ⟨⟨hk_lo, hk_hi⟩, ⟨hm_lo, hm_hi⟩⟩ := h_km_bounds (kOf I) (mOf I) hk2 hm2 hkm
    exact Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨hk_lo, hk_hi⟩, Finset.mem_Icc.mpr ⟨hm_lo, hm_hi⟩⟩
  have h_fiber : ∀ b ∈ Finset.image f ℐ,
      ({I ∈ ℐ | f I = b} : Finset (Ideal (NumberField.RingOfIntegers K))).card ≤ n := by
    intro b hb
    rcases Finset.mem_image.mp hb with ⟨I₀, hI₀, hb_eq⟩
    have hk_ge2 : 2 ≤ b.1 := by
      have : b.1 = kOf I₀ := by rw [← hb_eq]
      rw [this]
      exact (hI_props I₀ hI₀).2.1
    let Fb := ({I ∈ ℐ | f I = b} : Finset (Ideal (NumberField.RingOfIntegers K)))
    let Ps_b := Finset.image pOf Fb
    have h_inj : Set.InjOn pOf (Fb : Set (Ideal (NumberField.RingOfIntegers K))) := by
      intro I₁ hI₁ I₂ hI₂ hp_eq
      have hI₁_mem : I₁ ∈ ℐ ∧ f I₁ = b := Finset.mem_filter.mp hI₁
      have hI₂_mem : I₂ ∈ ℐ ∧ f I₂ = b := Finset.mem_filter.mp hI₂
      have hm₁ : mOf I₁ = b.2 := congrArg Prod.snd hI₁_mem.2
      have hm₂ : mOf I₂ = b.2 := congrArg Prod.snd hI₂_mem.2
      calc I₁
        _ = (pOf I₁) ^ (mOf I₁) := (hI_props I₁ hI₁_mem.1).2.2.2.1
        _ = (pOf I₂) ^ (mOf I₂) := by rw [hp_eq, hm₁, hm₂]
        _ = I₂ := (hI_props I₂ hI₂_mem.1).2.2.2.1.symm
    have h_card_eq : Ps_b.card = Fb.card := Finset.card_image_of_injOn h_inj
    rw [← h_card_eq]
    apply h_max_card b.1 hk_ge2 Ps_b
    intro Q hQ
    rcases Finset.mem_image.mp hQ with ⟨I, hI_Fb, rfl⟩
    have hI_mem : I ∈ ℐ ∧ f I = b := Finset.mem_filter.mp hI_Fb
    refine ⟨(hI_props I hI_mem.1).1, ?_⟩
    exact congrArg Prod.fst hI_mem.2
  have h_card_le_img : ℐ.card ≤ n * (Finset.image f ℐ).card := by
    have h1 := Finset.card_le_mul_card_image ℐ n h_fiber
    omega
  have h_img_le_B : (Finset.image f ℐ).card ≤ B.card := Finset.card_le_card h_img_sub
  have h_B_card : B.card = n * M ^ ((n - 15) + 1) := by
    dsimp [B]
    rw [Finset.card_product, Nat.card_Icc, Nat.card_Icc]
    have h1 : M ^ (n - 15) + 1 - 1 = M ^ (n - 15) := by omega
    have h2 : n * M + 1 - 1 = n * M := by omega
    rw [h1, h2, pow_succ]
    ring
  have h_pow_le : M ^ ((n - 15) + 1) ≤ M ^ (n - 6) :=
    Nat.pow_le_pow_right hM (by omega)
  calc ℐ.card
    _ ≤ n * (Finset.image f ℐ).card := h_card_le_img
    _ ≤ n * B.card := Nat.mul_le_mul_left n h_img_le_B
    _ = n * (n * M ^ ((n - 15) + 1)) := by rw [h_B_card]
    _ = n ^ 2 * M ^ ((n - 15) + 1) := by ring
    _ ≤ n ^ 2 * M ^ (n - 6) := Nat.mul_le_mul_left (n ^ 2) h_pow_le

theorem affEval_norm_and_vonMangoldtO_bounds (K : Type u) [Field K] [NumberField K]
    (d : ℕ)
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω)
    (c₀ : Fin 4 → NumberField.RingOfIntegers K)
    (c : Fin 4 → Fin d → NumberField.RingOfIntegers K) :
    (∀ x : NumberField.RingOfIntegers K, 0 ≤ vonMangoldtO x) ∧
    ∃ B₁ : ℕ, 2 ≤ B₁ ∧
      ∀ (N : ℕ), 1 ≤ N → ∀ z ∈ intBox d N, ∀ i : Fin 4,
        canNorm K (affEval (c₀ i) (c i) z : K) ≤ ((B₁ * N : ℕ) : ℝ) ∧
        Ideal.absNorm (Ideal.span {affEval (c₀ i) (c i) z}) ≤ (B₁ * N) ^ (Module.finrank ℚ K) ∧
        vonMangoldtO (affEval (c₀ i) (c i) z) ≤ ((Module.finrank ℚ K * (B₁ * N) : ℕ) : ℝ) :=
by
  refine ⟨?_, ?_⟩
  · intro x
    dsimp [vonMangoldtO]
    split_ifs with h
    · apply Real.log_nonneg
      have hp : h.choose.asIdeal ≠ ⊥ := h.choose.ne_bot
      have hnorm_ne : Ideal.absNorm h.choose.asIdeal ≠ 0 :=
        Ideal.absNorm_eq_zero_iff.not.mpr hp
      have hnorm_ge : 1 ≤ Ideal.absNorm h.choose.asIdeal :=
        Nat.one_le_iff_ne_zero.mpr hnorm_ne
      exact Nat.one_le_cast.mpr hnorm_ge
    · exact le_rfl
  · let n := Module.finrank ℚ K
    have hn_pos : 0 < n := Module.finrank_pos
    haveI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hn_pos
    let W : Fin 4 → Fin n → ℝ := fun i j =>
      |((ω.repr (c₀ i) j : ℤ) : ℝ)| + ∑ k : Fin d, |((ω.repr (c i k) j : ℤ) : ℝ)|
    let M_coord : ℝ := ∑ i : Fin 4, ∑ j : Fin n, W i j
    let B₁ : ℕ := max 2 ⌈C * M_coord⌉₊
    refine ⟨B₁, le_max_left 2 ⌈C * M_coord⌉₊, ?_⟩
    intro N hN z hz i
    let q := affEval (c₀ i) (c i) z
    have hW_nonneg : ∀ (i' : Fin 4) (j' : Fin n), 0 ≤ W i' j' := by
      intro i' j'
      exact add_nonneg (abs_nonneg _) (Finset.sum_nonneg (fun _ _ => abs_nonneg _))
    have hW_le : ∀ j : Fin n, W i j ≤ M_coord := by
      intro j
      calc W i j
        _ ≤ ∑ j' : Fin n, W i j' :=
            Finset.single_le_sum (fun j' _ => hW_nonneg i j') (Finset.mem_univ j)
        _ ≤ ∑ i' : Fin 4, ∑ j' : Fin n, W i' j' :=
            Finset.single_le_sum
              (fun i' _ => Finset.sum_nonneg (fun j' _ => hW_nonneg i' j'))
              (Finset.mem_univ i)
    have hz_bound : ∀ k : Fin d, |((z k : ℤ) : ℝ)| ≤ (N : ℝ) := by
      intro k
      have hz' : (fun _ : Fin d => -(N : ℤ)) ≤ z ∧ z ≤ (fun _ : Fin d => (N : ℤ)) :=
        Finset.mem_Icc.mp hz
      have h1 : -(N : ℝ) ≤ ((z k : ℤ) : ℝ) := by
        have := hz'.1 k
        exact_mod_cast this
      have h2 : ((z k : ℤ) : ℝ) ≤ (N : ℝ) := by
        have := hz'.2 k
        exact_mod_cast this
      exact abs_le.mpr ⟨h1, h2⟩
    have hN_real : (1 : ℝ) ≤ (N : ℝ) := Nat.one_le_cast.mpr hN
    have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := by positivity
    have hq_coord : ∀ j : Fin n, |((ω.repr q j : ℤ) : ℝ)| ≤ M_coord * (N : ℝ) := by
      intro j
      have hrepr : ω.repr q j = ω.repr (c₀ i) j + ∑ k : Fin d, z k * ω.repr (c i k) j := by
        dsimp [q, affEval]
        rw [map_add, map_sum, Finsupp.add_apply, Finsupp.finset_sum_apply]
        congr 1
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [map_zsmul, Finsupp.smul_apply, smul_eq_mul]
      have hcast : ((ω.repr q j : ℤ) : ℝ) =
          ((ω.repr (c₀ i) j : ℤ) : ℝ) +
          ∑ k : Fin d, ((z k : ℤ) : ℝ) * ((ω.repr (c i k) j : ℤ) : ℝ) := by
        rw [hrepr]
        push_cast
        rfl
      rw [hcast]
      calc |((ω.repr (c₀ i) j : ℤ) : ℝ) +
            ∑ k : Fin d, ((z k : ℤ) : ℝ) * ((ω.repr (c i k) j : ℤ) : ℝ)|
        _ ≤ |((ω.repr (c₀ i) j : ℤ) : ℝ)| +
            |∑ k : Fin d, ((z k : ℤ) : ℝ) * ((ω.repr (c i k) j : ℤ) : ℝ)| :=
            abs_add_le _ _
        _ ≤ |((ω.repr (c₀ i) j : ℤ) : ℝ)| +
            ∑ k : Fin d, |((z k : ℤ) : ℝ) * ((ω.repr (c i k) j : ℤ) : ℝ)| := by
            gcongr
            exact Finset.abs_sum_le_sum_abs _ _
        _ = |((ω.repr (c₀ i) j : ℤ) : ℝ)| * 1 +
            ∑ k : Fin d, |((z k : ℤ) : ℝ)| * |((ω.repr (c i k) j : ℤ) : ℝ)| := by
            rw [mul_one]
            congr 1
            refine Finset.sum_congr rfl (fun k _ => abs_mul _ _)
        _ ≤ |((ω.repr (c₀ i) j : ℤ) : ℝ)| * (N : ℝ) +
            ∑ k : Fin d, (N : ℝ) * |((ω.repr (c i k) j : ℤ) : ℝ)| := by
            refine add_le_add ?_ ?_
            · exact mul_le_mul_of_nonneg_left hN_real (abs_nonneg _)
            · refine Finset.sum_le_sum (fun k _ => ?_)
              exact mul_le_mul_of_nonneg_right (hz_bound k) (abs_nonneg _)
        _ = W i j * (N : ℝ) := by
            dsimp [W]
            rw [← Finset.mul_sum]
            ring
        _ ≤ M_coord * (N : ℝ) :=
            mul_le_mul_of_nonneg_right (hW_le j) hN_nonneg
    have hbasis_le : basisSupNorm ω q ≤ M_coord * (N : ℝ) := by
      dsimp [basisSupNorm]
      exact ciSup_le hq_coord
    have hC_pos : 0 ≤ C := by
      have := hω.1
      linarith
    have hcan_le : canNorm K (q : K) ≤ ((B₁ * N : ℕ) : ℝ) := by
      have hcompat : canNorm K (q : K) ≤ C * basisSupNorm ω q := (hω.2 q).2
      have hceil : C * M_coord ≤ (⌈C * M_coord⌉₊ : ℝ) := Nat.le_ceil (C * M_coord)
      have hB₁_ge : (⌈C * M_coord⌉₊ : ℝ) ≤ (B₁ : ℝ) :=
        Nat.cast_le.mpr (le_max_right 2 ⌈C * M_coord⌉₊)
      calc canNorm K (q : K)
        _ ≤ C * basisSupNorm ω q := hcompat
        _ ≤ C * (M_coord * (N : ℝ)) := mul_le_mul_of_nonneg_left hbasis_le hC_pos
        _ = (C * M_coord) * (N : ℝ) := by ring
        _ ≤ (⌈C * M_coord⌉₊ : ℝ) * (N : ℝ) := mul_le_mul_of_nonneg_right hceil hN_nonneg
        _ ≤ (B₁ : ℝ) * (N : ℝ) := mul_le_mul_of_nonneg_right hB₁_ge hN_nonneg
        _ = ((B₁ * N : ℕ) : ℝ) := by push_cast; ring
    have habsNorm_le : Ideal.absNorm (Ideal.span {q}) ≤ (B₁ * N) ^ n := by
      let M : ℕ := B₁ * N
      have hprod_le : ∏ w : NumberField.InfinitePlace K, w (q : K) ^ w.mult ≤ (M : ℝ) ^ n := by
        calc ∏ w : NumberField.InfinitePlace K, w (q : K) ^ w.mult
          _ ≤ ∏ w : NumberField.InfinitePlace K, (M : ℝ) ^ w.mult := by
              refine Finset.prod_le_prod (fun w _ => pow_nonneg (apply_nonneg w (q : K)) _) ?_
              intro w _
              have hw_le : w (q : K) ≤ (M : ℝ) := by
                refine le_trans ?_ hcan_le
                dsimp [canNorm]
                exact le_ciSup (Finite.bddAbove_range (fun w' : NumberField.InfinitePlace K => w' (q : K))) w
              exact pow_le_pow_left₀ (apply_nonneg w (q : K)) hw_le w.mult
          _ = (M : ℝ) ^ (∑ w : NumberField.InfinitePlace K, w.mult) :=
              Finset.prod_pow_eq_pow_sum _ _ _
          _ = (M : ℝ) ^ n := by
              rw [NumberField.InfinitePlace.sum_mult_eq]
      have hprod_eq : ((Ideal.absNorm (Ideal.span {q}) : ℕ) : ℝ) =
          ∏ w : NumberField.InfinitePlace K, w (q : K) ^ w.mult := by
        rw [Ideal.absNorm_span_singleton q]
        rw [NumberField.InfinitePlace.prod_eq_abs_norm (q : K)]
        have hloc : Algebra.norm ℚ (q : K) = ((Algebra.norm ℤ q : ℤ) : ℚ) := by
          rw [← eq_intCast (algebraMap ℤ ℚ)]
          exact Algebra.norm_localization ℤ (nonZeroDivisors ℤ) q
        rw [hloc]
        push_cast
        rw [← Int.cast_abs, ← Nat.cast_natAbs]
      have hreal_le : ((Ideal.absNorm (Ideal.span {q}) : ℕ) : ℝ) ≤ ((M ^ n : ℕ) : ℝ) := by
        rw [hprod_eq]
        simpa [Nat.cast_pow] using hprod_le
      exact Nat.cast_le.mp hreal_le
    have hvm_le : vonMangoldtO q ≤ ((n * (B₁ * N) : ℕ) : ℝ) := by
      let M : ℕ := B₁ * N
      have hM_ge : 2 ≤ M := by
        have h2 : 2 ≤ B₁ := le_max_left 2 ⌈C * M_coord⌉₊
        calc 2 = 2 * 1 := by ring
          _ ≤ B₁ * N := Nat.mul_le_mul h2 hN
      have hM_pos : (0 : ℝ) < (M : ℝ) := by
        have : 0 < M := by omega
        exact Nat.cast_pos.mpr this
      dsimp [vonMangoldtO]
      split_ifs with h
      · obtain ⟨m, hm_pos, hspan⟩ := h.choose_spec
        let p := h.choose
        have hp_ne : p.asIdeal ≠ ⊥ := p.ne_bot
        have hp_norm_pos : 0 < Ideal.absNorm p.asIdeal :=
          Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hp_ne)
        have hp_norm_le : Ideal.absNorm p.asIdeal ≤ M ^ n := by
          calc Ideal.absNorm p.asIdeal
            _ = (Ideal.absNorm p.asIdeal) ^ 1 := (pow_one _).symm
            _ ≤ (Ideal.absNorm p.asIdeal) ^ m := Nat.pow_le_pow_right hp_norm_pos hm_pos
            _ = Ideal.absNorm (p.asIdeal ^ m) := (map_pow Ideal.absNorm p.asIdeal m).symm
            _ = Ideal.absNorm (Ideal.span {q}) := by rw [hspan]
            _ ≤ M ^ n := habsNorm_le
        have hp_real_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) :=
          Nat.cast_pos.mpr hp_norm_pos
        have hp_real_le : (Ideal.absNorm p.asIdeal : ℝ) ≤ (M : ℝ) ^ n := by
          simpa [Nat.cast_pow] using (Nat.cast_le.mpr hp_norm_le : (Ideal.absNorm p.asIdeal : ℝ) ≤ ((M ^ n : ℕ) : ℝ))
        have hlog_M : Real.log (M : ℝ) ≤ (M : ℝ) := by
          have h1 := Real.log_le_sub_one_of_pos hM_pos
          linarith
        calc Real.log (Ideal.absNorm p.asIdeal : ℝ)
          _ ≤ Real.log ((M : ℝ) ^ n) := Real.log_le_log hp_real_pos hp_real_le
          _ = (n : ℝ) * Real.log (M : ℝ) := Real.log_pow (M : ℝ) n
          _ ≤ (n : ℝ) * (M : ℝ) := mul_le_mul_of_nonneg_left hlog_M (Nat.cast_nonneg n)
          _ = ((n * (B₁ * N) : ℕ) : ℝ) := by dsimp [M]; push_cast; ring
      · exact Nat.cast_nonneg _
    exact ⟨hcan_le, habsNorm_le, hvm_le⟩

theorem exists_prime_quadruple_of_kaiSum_gt (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (a₁_int a₂_int a₃_int μ l : NumberField.RingOfIntegers K)
    (hμ : μ ≠ 0)
    (hdiff : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      μ ∉ v.asIdeal →
        (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int) ∉ v.asIdeal)
    (haff : ∀ z : Fin (2 * Module.finrank ℚ K) → ℤ,
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 0) (suitC ω a₁_int a₂_int a₃_int μ 0) z =
        1 + μ * kaiCoordX ω z + a₁_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 1) (suitC ω a₁_int a₂_int a₃_int μ 1) z =
        1 + μ * kaiCoordX ω z + a₂_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 2) (suitC ω a₁_int a₂_int a₃_int μ 2) z =
        1 + μ * kaiCoordX ω z + a₃_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 3) (suitC ω a₁_int a₂_int a₃_int μ 3) z =
        μ * kaiCoordY ω z + l)
    (Ω₀ : Set (Fin (2 * Module.finrank ℚ K) → ℝ))
    (N M_pp M_gen M_wt : ℕ) (hN : 1 ≤ N)
    (h_wt : ∀ z ∈ intBox (2 * Module.finrank ℚ K) N, ∀ i : Fin 4,
      0 ≤ vonMangoldtO (affEval (suitC0 a₁_int a₂_int a₃_int μ l i) (suitC ω a₁_int a₂_int a₃_int μ i) z) ∧
      vonMangoldtO (affEval (suitC0 a₁_int a₂_int a₃_int μ l i) (suitC ω a₁_int a₂_int a₃_int μ i) z) ≤ (M_wt : ℝ))
    (h_pp : ∀ i : Fin 4,
      ∀ ℐ : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ I ∈ ℐ, (∃ z ∈ intBox (2 * Module.finrank ℚ K) N,
            Ideal.span {affEval (suitC0 a₁_int a₂_int a₃_int μ l i) (suitC ω a₁_int a₂_int a₃_int μ i) z} = I) ∧
          ∃ (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
            2 ≤ m ∧ I = 𝔭.asIdeal ^ m) →
        ℐ.card ≤ M_pp)
    (h_gen : ∀ i : Fin 4, ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ ⊥ →
      ∀ F : Finset (NumberField.RingOfIntegers K),
        (∀ α ∈ F, (∃ z ∈ intBox (2 * Module.finrank ℚ K) N,
            affEval (suitC0 a₁_int a₂_int a₃_int μ l i) (suitC ω a₁_int a₂_int a₃_int μ i) z = α) ∧
          Ideal.span {α} = I) →
        F.card ≤ M_gen)
    (hkai : (((4 * (M_pp + 1) * M_gen * (3 * N) ^ (Module.finrank ℚ K) * M_wt ^ 4 : ℕ) : ℝ)) <
      kaiSum (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ)
        (Ω₀ ∩ realBox (2 * Module.finrank ℚ K) (N : ℝ)) N) :
    ∃ (z_lat : Fin (2 * Module.finrank ℚ K) → ℤ)
      (𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsPrimeQuadrupleInCone
        (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ)
        Ω₀ z_lat 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ :=
by
  open scoped Classical in
  let n := Module.finrank ℚ K
  let d := 2 * n
  let c₀ := suitC0 a₁_int a₂_int a₃_int μ l
  let c := suitC ω a₁_int a₂_int a₃_int μ
  let π_X : (Fin d → ℤ) → (Fin n → ℤ) := fun z r => z ⟨r.1, by omega⟩
  let π_Y : (Fin d → ℤ) → (Fin n → ℤ) := fun z r => z ⟨n + r.1, by omega⟩
  have h_pi_ext : ∀ z₁ z₂ : Fin d → ℤ, π_X z₁ = π_X z₂ → π_Y z₁ = π_Y z₂ → z₁ = z₂ := by
    intro z₁ z₂ hX hY
    ext k
    by_cases hk : k.1 < n
    · exact congr_fun hX ⟨k.1, hk⟩
    · have h_sub : n + (k.1 - n) = k.1 := by omega
      have hk_eq : k = ⟨n + (k.1 - n), by omega⟩ := by ext; exact h_sub.symm
      rw [hk_eq]
      exact congr_fun hY ⟨k.1 - n, by omega⟩
  have h_pi_X_mem : ∀ z ∈ intBox d N, π_X z ∈ intBox n N := by
    intro z hz
    simp only [intBox, Finset.mem_Icc, Pi.le_def] at hz ⊢
    exact ⟨fun r => hz.1 ⟨r.1, by omega⟩, fun r => hz.2 ⟨r.1, by omega⟩⟩
  have h_pi_Y_mem : ∀ z ∈ intBox d N, π_Y z ∈ intBox n N := by
    intro z hz
    simp only [intBox, Finset.mem_Icc, Pi.le_def] at hz ⊢
    exact ⟨fun r => hz.1 ⟨n + r.1, by omega⟩, fun r => hz.2 ⟨n + r.1, by omega⟩⟩
  have h_card_box : (intBox n N).card ≤ (3 * N) ^ n := by
    simp only [intBox, Pi.card_Icc, Int.card_Icc, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    have h_len : ((N : ℤ) + 1 - -(N : ℤ)).toNat ≤ 3 * N := by omega
    exact Nat.pow_le_pow_left h_len n
  have h_coordX_eq : ∀ z : Fin d → ℤ, kaiCoordX ω z = ω.equivFun.symm (π_X z) := by
    intro z
    rw [Module.Basis.equivFun_symm_apply]
    rfl
  have h_coordY_eq : ∀ z : Fin d → ℤ, kaiCoordY ω z = ω.equivFun.symm (π_Y z) := by
    intro z
    rw [Module.Basis.equivFun_symm_apply]
    rfl
  have h_coordX_inj : ∀ z₁ z₂ : Fin d → ℤ, kaiCoordX ω z₁ = kaiCoordX ω z₂ ↔ π_X z₁ = π_X z₂ := by
    intro z₁ z₂
    rw [h_coordX_eq, h_coordX_eq]
    exact ω.equivFun.symm.injective.eq_iff
  have h_coordY_inj : ∀ z₁ z₂ : Fin d → ℤ, kaiCoordY ω z₁ = kaiCoordY ω z₂ ↔ π_Y z₁ = π_Y z₂ := by
    intro z₁ z₂
    rw [h_coordY_eq, h_coordY_eq]
    exact ω.equivFun.symm.injective.eq_iff
  have h_inj_pi_Y : ∀ (i : Fin 4), i ≠ 3 → ∀ z₁ z₂ : Fin d → ℤ,
      π_Y z₁ = π_Y z₂ → affEval (c₀ i) (c i) z₁ = affEval (c₀ i) (c i) z₂ → z₁ = z₂ := by
    intro i hi z₁ z₂ hY heval
    have hY_coord : kaiCoordY ω z₁ = kaiCoordY ω z₂ := (h_coordY_inj z₁ z₂).mpr hY
    have hX_mul : μ * kaiCoordX ω z₁ = μ * kaiCoordX ω z₂ := by
      fin_cases i
      · have h1 := (haff z₁).1
        have h2 := (haff z₂).1
        change affEval (c₀ 0) (c 0) z₁ = _ at h1
        change affEval (c₀ 0) (c 0) z₂ = _ at h2
        change affEval (c₀ 0) (c 0) z₁ = affEval (c₀ 0) (c 0) z₂ at heval
        rw [h1, h2, hY_coord] at heval
        linear_combination heval
      · have h1 := (haff z₁).2.1
        have h2 := (haff z₂).2.1
        change affEval (c₀ 1) (c 1) z₁ = _ at h1
        change affEval (c₀ 1) (c 1) z₂ = _ at h2
        change affEval (c₀ 1) (c 1) z₁ = affEval (c₀ 1) (c 1) z₂ at heval
        rw [h1, h2, hY_coord] at heval
        linear_combination heval
      · have h1 := (haff z₁).2.2.1
        have h2 := (haff z₂).2.2.1
        change affEval (c₀ 2) (c 2) z₁ = _ at h1
        change affEval (c₀ 2) (c 2) z₂ = _ at h2
        change affEval (c₀ 2) (c 2) z₁ = affEval (c₀ 2) (c 2) z₂ at heval
        rw [h1, h2, hY_coord] at heval
        linear_combination heval
      · exact False.elim (hi rfl)
    have hX_coord : kaiCoordX ω z₁ = kaiCoordX ω z₂ := mul_left_cancel₀ hμ hX_mul
    exact h_pi_ext z₁ z₂ ((h_coordX_inj z₁ z₂).mp hX_coord) hY
  have h_fib : ∀ (i : Fin 4) (α : NumberField.RingOfIntegers K),
      ({z ∈ intBox d N | affEval (c₀ i) (c i) z = α}).card ≤ (3 * N) ^ n := by
    intro i α
    by_cases hi : i = 3
    · subst hi
      have h_le : ({z ∈ intBox d N | affEval (c₀ 3) (c 3) z = α}).card ≤ (intBox n N).card := by
        apply Finset.card_le_card_of_injOn π_X
        · intro z hz
          rw [Finset.mem_coe, Finset.mem_filter] at hz
          rw [Finset.mem_coe]
          exact h_pi_X_mem z hz.1
        · intro z₁ hz₁ z₂ hz₂ hX
          rw [Finset.mem_coe, Finset.mem_filter] at hz₁ hz₂
          have h1 := (haff z₁).2.2.2
          have h2 := (haff z₂).2.2.2
          change affEval (c₀ 3) (c 3) z₁ = _ at h1
          change affEval (c₀ 3) (c 3) z₂ = _ at h2
          have heq : μ * kaiCoordY ω z₁ + l = μ * kaiCoordY ω z₂ + l := by
            rw [← h1, ← h2, hz₁.2, hz₂.2]
          have hY_mul : μ * kaiCoordY ω z₁ = μ * kaiCoordY ω z₂ := by linear_combination heq
          have hY_coord : kaiCoordY ω z₁ = kaiCoordY ω z₂ := mul_left_cancel₀ hμ hY_mul
          exact h_pi_ext z₁ z₂ hX ((h_coordY_inj z₁ z₂).mp hY_coord)
      exact le_trans h_le h_card_box
    · have h_le : ({z ∈ intBox d N | affEval (c₀ i) (c i) z = α}).card ≤ (intBox n N).card := by
        apply Finset.card_le_card_of_injOn π_Y
        · intro z hz
          rw [Finset.mem_coe, Finset.mem_filter] at hz
          rw [Finset.mem_coe]
          exact h_pi_Y_mem z hz.1
        · intro z₁ hz₁ z₂ hz₂ hY
          rw [Finset.mem_coe, Finset.mem_filter] at hz₁ hz₂
          exact h_inj_pi_Y i hi z₁ z₂ hY (hz₁.2.trans hz₂.2.symm)
      exact le_trans h_le h_card_box
  have h_coinc : ∀ (i : Fin 4), i ≠ 3 →
      ({z ∈ intBox d N |
        Ideal.span {affEval (c₀ i) (c i) z} = Ideal.span {affEval (c₀ 3) (c 3) z} ∧
