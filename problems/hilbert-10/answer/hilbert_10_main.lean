            rw [hcast]
            calc algebraMap K (v₁.adicCompletion K) (r_z : K) *
                (1 + -(algebraMap K (v₁.adicCompletion K) (r_z : K) -
                  algebraMap K (v₁.adicCompletion K) (ε : K) *
                    (algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2) /
                  algebraMap K (v₁.adicCompletion K) (r_z : K))
              _ = algebraMap K (v₁.adicCompletion K) (r_z : K) +
                  algebraMap K (v₁.adicCompletion K) (r_z : K) *
                  (-(algebraMap K (v₁.adicCompletion K) (r_z : K) -
                    algebraMap K (v₁.adicCompletion K) (ε : K) *
                      (algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2) /
                    algebraMap K (v₁.adicCompletion K) (r_z : K)) := by ring
              _ = algebraMap K (v₁.adicCompletion K) (r_z : K) +
                  -(algebraMap K (v₁.adicCompletion K) (r_z : K) -
                    algebraMap K (v₁.adicCompletion K) (ε : K) *
                      (algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2) := by
                  rw [mul_div_cancel₀ _ hr_z_ne]
              _ = algebraMap K (v₁.adicCompletion K) (ε : K) *
                  (algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2 := by ring
          rw [← h1, hq₂, hr_z_eq]; ring
        have hwq_ne : w * q₁ * q₂ ≠ 0 := mul_ne_zero (mul_ne_zero hw_ne hq₁_ne) hq₂_ne
        refine ⟨(algebraMap K (v₁.adicCompletion K) (ε : K) *
