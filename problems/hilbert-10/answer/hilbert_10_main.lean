    have h_const : ∏ w ∈ B, ClassGroup.mk0 (I_nzd w) = ∏ _w ∈ B, c :=
      Finset.prod_congr rfl (fun w hw => (hB_sub hw).2)
    rw [h_const, Finset.prod_const, hB_card, pow_card_eq_one]
  have h_prin_B : (p_nzd : Ideal R).IsPrincipal :=
    (ClassGroup.mk0_eq_one_iff p_nzd.2).mp h_mk0
  obtain ⟨π_B, hπ_B_span⟩ := h_prin_B.principal
  have hspan : Ideal.span ({π_B} : Set R) = ∏ w ∈ B, w.asIdeal := by
    have h1 : (p_nzd : Ideal R) = ∏ w ∈ B, w.asIdeal :=
      Submonoid.coe_finset_prod (nonZeroDivisors (Ideal R)) I_nzd B
    exact hπ_B_span.symm.trans h1
  have hprod_ne : (∏ w ∈ B, w.asIdeal : Ideal R) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun w _ => w.ne_bot)
  have hπ_B_ne : π_B ≠ 0 := by
    intro h0
    apply hprod_ne
    rw [← hspan, h0, Set.singleton_zero, Ideal.span_zero, ← Submodule.zero_eq_bot]
  have hπ_B_K_ne : (π_B : K) ≠ 0 :=
    (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hπ_B_ne
  let κ_B : Kˣ := Units.mk0 (π_B : K) hπ_B_K_ne
  have h_not_dvd : ∀ (v : IsDedekindDomain.HeightOneSpectrum R)
      (E : Finset (IsDedekindDomain.HeightOneSpectrum R)),
      v ∉ E → ¬ (v.asIdeal ∣ ∏ w ∈ E, w.asIdeal) := by
    intro v E hvE hdvd
    obtain ⟨w, hwE, hvw⟩ := (Prime.dvd_finset_prod_iff v.prime _).mp hdvd
    have hle : w.asIdeal ≤ v.asIdeal := Ideal.dvd_iff_le.mp hvw
    have heq : w.asIdeal = v.asIdeal := w.isMaximal.eq_of_le v.isPrime.ne_top hle
    have hwv : w = v := IsDedekindDomain.HeightOneSpectrum.ext heq
    exact hvE (hwv ▸ hwE)
  have hval_B_out : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      v ∉ B → IsDedekindDomain.HeightOneSpectrum.valuation K v (κ_B : K) = 1 := by
    intro v hvB
    change (v.valuation K) (algebraMap R K π_B) = 1
    rw [v.valuation_of_algebraMap]
    have hndvd : ¬ (v.asIdeal ∣ Ideal.span ({π_B} : Set R)) := by
      rw [hspan]
      exact h_not_dvd v B hvB
    have hnot_lt : ¬ (v.intValuation π_B < 1) :=
      fun hlt => hndvd ((v.intValuation_lt_one_iff_dvd π_B).mp hlt)
    exact le_antisymm (v.intValuation_le_one π_B) (not_lt.mp hnot_lt)
  have hval_B_in : ∀ v ∈ B,
      IsDedekindDomain.HeightOneSpectrum.valuation K v (κ_B : K) = WithZero.exp (-1 : ℤ) := by
    intro v hvB
    change (v.valuation K) (algebraMap R K π_B) = WithZero.exp (-1 : ℤ)
    rw [v.valuation_of_algebraMap]
    have h_erase : (∏ w ∈ B, w.asIdeal) = v.asIdeal * ∏ w ∈ B.erase v, w.asIdeal :=
      (Finset.mul_prod_erase B (fun w => w.asIdeal) hvB).symm
    have hdvd1 : v.asIdeal ^ 1 ∣ Ideal.span ({π_B} : Set R) := by
      rw [pow_one, hspan, h_erase]
      exact dvd_mul_right v.asIdeal _
    have hndvd2 : ¬ (v.asIdeal ^ 2 ∣ Ideal.span ({π_B} : Set R)) := by
      intro hdvd2
      rw [sq, hspan, h_erase, mul_dvd_mul_iff_left v.ne_bot] at hdvd2
      exact h_not_dvd v (B.erase v) (Finset.notMem_erase v B) hdvd2
    have hle1 : v.intValuation π_B ≤ WithZero.exp (-((1 : ℕ) : ℤ)) :=
      (v.intValuation_le_pow_iff_dvd π_B 1).mpr hdvd1
    have hnle2 : ¬ (v.intValuation π_B ≤ WithZero.exp (-((2 : ℕ) : ℤ))) :=
      fun hle2 => hndvd2 ((v.intValuation_le_pow_iff_dvd π_B 2).mp hle2)
    set k : ℕ := (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {π_B})).factors
    have hexp : v.intValuation π_B = WithZero.exp (-(k : ℤ)) := v.intValuation_if_neg hπ_B_ne
    rw [hexp] at hle1 hnle2 ⊢
    rw [WithZero.exp_le_exp] at hle1 hnle2
    have hk1 : (k : ℤ) = 1 := by omega
    rw [hk1]
  let S' := S ∪ B
  let κ' : Kˣ := κ * κ_B
  have hB_not_S : ∀ v ∈ B, v ∉ S := fun v hv => (hB_sub hv).1.1.2
  have hB_not_T : ∀ v ∈ B, v ∉ T := fun v hv => (hB_sub hv).1.2
  have hB_in_P : ∀ v ∈ B, v ∈ P := fun v hv => (hB_sub hv).1.1.1
  refine ⟨S', κ', v₀, Finset.subset_union_left, ?_, ?_,
    Finset.mem_union_right S hv₀B, hB_not_S v₀ hv₀B, ?_⟩
  · rw [Finset.disjoint_union_left]
    exact ⟨hdisj, Finset.disjoint_left.mpr hB_not_T⟩
  · refine ⟨?_, ?_, ?_⟩
    · change IsIntegral ℤ ((κ : K) * (π_B : K))
      exact hprin.1.mul (NumberField.RingOfIntegers.isIntegral_coe π_B)
    · intro v hvS'
      change (v.valuation K) ((κ : K) * (κ_B : K)) = WithZero.exp (-1 : ℤ)
      rw [Valuation.map_mul]
      rcases Finset.mem_union.mp hvS' with hvS | hvB
      · have hvnotB : v ∉ B := fun h => hB_not_S v h hvS
        rw [hprin.2.1 v hvS, hval_B_out v hvnotB, mul_one]
      · have hvnotS : v ∉ S := hB_not_S v hvB
        rw [hprin.2.2 v hvnotS, hval_B_in v hvB, one_mul]
    · intro v hvnotS'
      have hvnotS : v ∉ S := fun h => hvnotS' (Finset.mem_union_left B h)
      have hvnotB : v ∉ B := fun h => hvnotS' (Finset.mem_union_right S h)
      change (v.valuation K) ((κ : K) * (κ_B : K)) = 1
      rw [Valuation.map_mul, hprin.2.2 v hvnotS, hval_B_out v hvnotB, mul_one]
  · intro v hvS' hvnotS
    rcases Finset.mem_union.mp hvS' with hvS | hvB
    · exact False.elim (hvnotS hvS)
    · exact hB_in_P v hvB

theorem exists_killing_primes_for_starting_span (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (κ₁ : Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hdisj₁ : Disjoint S₁ T)
    (hprin₁ : IsPrincipalPrimeSet K S₁ κ₁)
    (hext : HasPrincipalNonSquareExtension K T) :
    ∃ (S'₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (κ'₁ : Kˣ),
      S₁ ⊆ S'₁ ∧
      Disjoint S'₁ T ∧
      IsPrincipalPrimeSet K S'₁ κ'₁ ∧
      (∀ x : Kˣ, InStartingSpan K a₁ a₂ a₃ x → ∀ v, v ∉ T → EvenVal v x) ∧
      (∀ x : Kˣ, InStartingSpan K a₁ a₂ a₃ x →
        (∀ v ∈ S'₁, IsSquare (algebraMap K (v.adicCompletion K) (x : K))) →
        sqCl x = 1) :=
by
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  have hint₁ : IsIntegral ℤ a₁ := hstart.2.2.2.2.2.2.1
  have hint₂ : IsIntegral ℤ a₂ := hstart.2.2.2.2.2.2.2.1
  have hint₃ : IsIntegral ℤ a₃ := hstart.2.2.2.2.2.2.2.2.1
  have hindep₀ : ∀ e₀ e₁ e₂ e₃ : Fin 2,
      IsSquare ((-1 : K) ^ (e₀ : ℕ) * (a₁ - a₂) ^ (e₁ : ℕ) *
        (a₁ - a₃) ^ (e₂ : ℕ) * (a₂ - a₃) ^ (e₃ : ℕ)) →
      e₀ = 0 ∧ e₁ = 0 ∧ e₂ = 0 ∧ e₃ = 0 :=
    hstart.2.2.2.2.2.2.2.2.2.1
  have hspan_even : ∀ x : Kˣ, InStartingSpan K a₁ a₂ a₃ x → ∀ v, v ∉ T → EvenVal v x := by
    rintro x ⟨e₀, e₁, e₂, e₃, r, hr⟩ v hvT
    let A₁ : NumberField.RingOfIntegers K := ⟨a₁, hint₁⟩
    let A₂ : NumberField.RingOfIntegers K := ⟨a₂, hint₂⟩
    let A₃ : NumberField.RingOfIntegers K := ⟨a₃, hint₃⟩
    have hval6 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 ≤ 1 := by
      have := v.valuation_le_one (K := K) (6 : NumberField.RingOfIntegers K)
      simpa using this
    have hval12_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 := by
      have := v.valuation_le_one (K := K) (A₁ - A₂)
      simpa [A₁, A₂] using this
    have hval13_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 := by
      have := v.valuation_le_one (K := K) (A₁ - A₃)
      simpa [A₁, A₃] using this
    have hval23_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) ≤ 1 := by
      have := v.valuation_le_one (K := K) (A₂ - A₃)
      simpa [A₂, A₃] using this
    have hgood : (IsDedekindDomain.HeightOneSpectrum.valuation K v)
        (6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)) = 1 :=
      not_ne_iff.mp ((hT v).not.mp hvT)
    rw [map_mul, map_mul, map_mul] at hgood
    have h_le_prod1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 :=
      (mul_le_of_le_one_right' hval12_le).trans hval6
    have h_le_prod2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 :=
      (mul_le_of_le_one_right' hval13_le).trans h_le_prod1
    have hval23 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) = 1 :=
      le_antisymm hval23_le (by rw [← hgood]; exact mul_le_of_le_one_left' h_le_prod2)
    have hgood2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 := by
      rw [hval23, mul_one] at hgood; exact hgood
    have hval13 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 :=
      le_antisymm hval13_le (by rw [← hgood2]; exact mul_le_of_le_one_left' h_le_prod1)
    have hgood1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 := by
      rw [hval13, mul_one] at hgood2; exact hgood2
    have hval12 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 :=
      le_antisymm hval12_le (by rw [← hgood1]; exact mul_le_of_le_one_left' hval6)
    have hval_neg1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (-1 : K) = 1 := by
      rw [Valuation.map_neg, Valuation.map_one]
    have h1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v)
        ((x : K) * (-1 : K) ^ (e₀ : ℕ) * (a₁ - a₂) ^ (e₁ : ℕ) *
          (a₁ - a₃) ^ (e₂ : ℕ) * (a₂ - a₃) ^ (e₃ : ℕ)) =
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (r * r) :=
      congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) hr
    rw [map_mul, map_mul, map_mul, map_mul, map_pow, map_pow, map_pow, map_pow,
      hval_neg1, hval12, hval13, hval23, one_pow, one_pow, one_pow, one_pow,
      mul_one, mul_one, mul_one, mul_one,
      ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v x,
      map_mul] at h1
    have hr_ne : (IsDedekindDomain.HeightOneSpectrum.valuation K v) r ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at h1
      exact WithZero.coe_ne_zero h1
    obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hr_ne
    rw [← hg, ← WithZero.coe_mul, WithZero.coe_inj] at h1
    have h2 := congrArg Multiplicative.toAdd h1
    rw [toAdd_mul] at h2
    exact ⟨Multiplicative.toAdd g, h2⟩
  let u₀ : Kˣ := -1
  let u₁ : Kˣ := Units.mk0 (a₁ - a₂) (sub_ne_zero.mpr h₁₂)
  let u₂ : Kˣ := Units.mk0 (a₁ - a₃) (sub_ne_zero.mpr h₁₃)
  let u₃ : Kˣ := Units.mk0 (a₂ - a₃) (sub_ne_zero.mpr h₂₃)
  have hB₀ : SqClIndep4 K u₀ u₁ u₂ u₃ := by
    intro e₀ e₁ e₂ e₃ hsq
    apply hindep₀ e₀ e₁ e₂ e₃
    simpa [u₀, u₁, u₂, u₃] using hsq
  have h_swap12 : ∀ a b c d : Kˣ,
      SqClIndep4 K a b c d → SqClIndep4 K b a c d := by
    intro a b c d h e₁ e₂ e₃ e₄ hsq
    have hsq' : IsSquare ((a : K) ^ (e₂ : ℕ) * (b : K) ^ (e₁ : ℕ) *
        (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ)) := by
      convert hsq using 1; ring
    obtain ⟨he₂, he₁, he₃, he₄⟩ := h e₂ e₁ e₃ e₄ hsq'
    exact ⟨he₁, he₂, he₃, he₄⟩
  have h_rot : ∀ a b c d : Kˣ,
      SqClIndep4 K a b c d → SqClIndep4 K b c d a := by
    intro a b c d h e₁ e₂ e₃ e₄ hsq
    have hsq' : IsSquare ((a : K) ^ (e₄ : ℕ) * (b : K) ^ (e₁ : ℕ) *
        (c : K) ^ (e₂ : ℕ) * (d : K) ^ (e₃ : ℕ)) := by
      convert hsq using 1; ring
    obtain ⟨he₄, he₁, he₂, he₃⟩ := h e₄ e₁ e₂ e₃ hsq'
    exact ⟨he₁, he₂, he₃, he₄⟩
  have h_mul12 : ∀ a b c d : Kˣ,
      SqClIndep4 K a b c d → SqClIndep4 K (a * b) b c d := by
    intro a b c d h e₁ e₂ e₃ e₄ hsq
    fin_cases e₁ <;> fin_cases e₂
    · have hsq' : IsSquare ((a : K) ^ ((0 : Fin 2) : ℕ) * (b : K) ^ ((0 : Fin 2) : ℕ) *
          (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ)) := by
        convert hsq using 1; simp
      obtain ⟨_, _, he₃, he₄⟩ := h 0 0 e₃ e₄ hsq'
      exact ⟨rfl, rfl, he₃, he₄⟩
    · have hsq' : IsSquare ((a : K) ^ ((0 : Fin 2) : ℕ) * (b : K) ^ ((1 : Fin 2) : ℕ) *
          (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ)) := by
        convert hsq using 1; simp
      obtain ⟨_, h10, _, _⟩ := h 0 1 e₃ e₄ hsq'
      exact nomatch h10
    · have hsq' : IsSquare ((a : K) ^ ((1 : Fin 2) : ℕ) * (b : K) ^ ((1 : Fin 2) : ℕ) *
          (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ)) := by
        convert hsq using 1
        simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
          Units.val_mul]
        ring
      obtain ⟨h10, _, _, _⟩ := h 1 1 e₃ e₄ hsq'
      exact nomatch h10
    · rcases hsq with ⟨r, hr⟩
      have hb0 : (b : K) ≠ 0 := b.ne_zero
      have hsq' : IsSquare ((a : K) ^ ((1 : Fin 2) : ℕ) * (b : K) ^ ((0 : Fin 2) : ℕ) *
          (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ)) := by
        refine ⟨r / (b : K), ?_⟩
        have hprod : r * r = (b : K) ^ 2 *
            ((a : K) ^ ((1 : Fin 2) : ℕ) * (b : K) ^ ((0 : Fin 2) : ℕ) *
              (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ)) := by
          rw [← hr]
          simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
            Units.val_mul]
          ring
        calc (a : K) ^ ((1 : Fin 2) : ℕ) * (b : K) ^ ((0 : Fin 2) : ℕ) *
              (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ)
          _ = ((b : K) ^ 2 * ((a : K) ^ ((1 : Fin 2) : ℕ) * (b : K) ^ ((0 : Fin 2) : ℕ) *
                (c : K) ^ (e₃ : ℕ) * (d : K) ^ (e₄ : ℕ))) / (b : K) ^ 2 := by
              rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 hb0)]
          _ = (r * r) / (b : K) ^ 2 := by rw [hprod]
          _ = (r / (b : K)) * (r / (b : K)) := by ring
      obtain ⟨h10, _, _, _⟩ := h 1 0 e₃ e₄ hsq'
      exact nomatch h10
  have h_mul21 : ∀ a b c d : Kˣ,
      SqClIndep4 K a b c d → SqClIndep4 K a (b * a) c d :=
    fun a b c d h => h_swap12 (b * a) a c d (h_mul12 b a c d (h_swap12 a b c d h))
  have h_step_pre : ∀ a b c d : Kˣ,
      SqClIndep4 K a b c d →
      SqClIndep4 K (a * b) (b * c) (c * (a * b)) d := by
    intro a b c d h
    have s1 := h_mul12 _ _ _ _ h
    have s2 := h_rot _ _ _ _ s1
    have s3 := h_mul12 _ _ _ _ s2
    have s4 := h_rot _ _ _ _ s3
    have s5 := h_swap12 _ _ _ _ s4
    have s6 := h_rot _ _ _ _ s5
    have s7 := h_swap12 _ _ _ _ s6
    have s8 := h_mul21 _ _ _ _ s7
    have s9 := h_rot _ _ _ _ s8
    have s10 := h_swap12 _ _ _ _ s9
    have s11 := h_rot _ _ _ _ s10
    exact h_rot _ _ _ _ (h_rot _ _ _ _ s11)
  have h_step_F : ∀ a b c d : Kˣ,
      SqClIndep4 K a b c d →
      SqClIndep4 K (a * b) (b * c) (c * (a * b)) (d * (a * b)) := by
    intro a b c d h
    have s0 := h_step_pre a b c d h
    have s1 := h_rot _ _ _ _ (h_rot _ _ _ _ (h_rot _ _ _ _ s0))
    have s2 := h_swap12 _ _ _ _ s1
    have s3 := h_mul21 _ _ _ _ s2
    have s4 := h_rot _ _ _ _ s3
    have s5 := h_swap12 _ _ _ _ s4
    have s6 := h_rot _ _ _ _ s5
    have s7 := h_swap12 _ _ _ _ s6
    exact h_rot _ _ _ _ (h_rot _ _ _ _ s7)
  have h_step_4 : ∀ a b c d : Kˣ,
      SqClIndep4 K a b c d →
      SqClIndep4 K (a * b) (b * c) (c * (a * b)) (d * (c * (a * b))) := by
    intro a b c d h
    have s0 := h_step_pre a b c d h
    have s1 := h_rot _ _ _ _ (h_rot _ _ _ _ s0)
    have s2 := h_mul21 _ _ _ _ s1
    exact h_rot _ _ _ _ (h_rot _ _ _ _ s2)
  have hB₁ : SqClIndep4 K (u₀ * u₁) (u₁ * u₂) (u₂ * (u₀ * u₁)) (u₃ * (u₀ * u₁)) :=
    h_step_F u₀ u₁ u₂ u₃ hB₀
  have hp₂ : SqClIndep4 K u₁ u₃ u₀ u₂ :=
    h_rot _ _ _ _ (h_swap12 _ _ _ _ (h_rot _ _ _ _ hB₀))
  have hB₂ : SqClIndep4 K (u₁ * u₃) (u₃ * u₀) (u₀ * (u₁ * u₃)) (u₂ * (u₁ * u₃)) :=
    h_step_F u₁ u₃ u₀ u₂ hp₂
  have hp₃ : SqClIndep4 K u₀ u₂ u₃ u₁ :=
    h_rot _ _ _ _ (h_swap12 _ _ _ _ hB₀)
  have hB₃ : SqClIndep4 K (u₀ * u₂) (u₂ * u₃) (u₃ * (u₀ * u₂)) (u₁ * (u₃ * (u₀ * u₂))) :=
    h_step_4 u₀ u₂ u₃ u₁ hp₃
  obtain ⟨S_a, κ_a, v₀, hsub_a, hdisj_a, hprin_a, hv₀_in, hv₀_not, hnsq_0⟩ :=
    hext S₁ κ₁ u₀ u₁ u₂ u₃ hdisj₁ hprin₁ hB₀
  obtain ⟨S_b, κ_b, v₁, hsub_b, hdisj_b, hprin_b, hv₁_in, hv₁_not, hnsq_1⟩ :=
    hext S_a κ_a (u₀ * u₁) (u₁ * u₂) (u₂ * (u₀ * u₁)) (u₃ * (u₀ * u₁)) hdisj_a hprin_a hB₁
  obtain ⟨S_c, κ_c, v₂, hsub_c, hdisj_c, hprin_c, hv₂_in, hv₂_not, hnsq_2⟩ :=
    hext S_b κ_b (u₁ * u₃) (u₃ * u₀) (u₀ * (u₁ * u₃)) (u₂ * (u₁ * u₃)) hdisj_b hprin_b hB₂
  obtain ⟨S'₁, κ'₁, v₃, hsub_d, hdisj'₁, hprin'₁, hv₃_in, hv₃_not, hnsq_3⟩ :=
    hext S_c κ_c (u₀ * u₂) (u₂ * u₃) (u₃ * (u₀ * u₂)) (u₁ * (u₃ * (u₀ * u₂))) hdisj_c hprin_c hB₃
  have hv₀_S'₁ : v₀ ∈ S'₁ := hsub_d (hsub_c (hsub_b hv₀_in))
  have hv₁_S'₁ : v₁ ∈ S'₁ := hsub_d (hsub_c hv₁_in)
  have hv₂_S'₁ : v₂ ∈ S'₁ := hsub_d hv₂_in
  have hv₃_S'₁ : v₃ ∈ S'₁ := hv₃_in
  have h_kill_of_eq : ∀ (x w : Kˣ) (rhs : K)
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (x : K) * (w : K) = rhs →
      IsSquare rhs →
      IsSquare (algebraMap K (v.adicCompletion K) (x : K)) →
      ¬ IsSquare (algebraMap K (v.adicCompletion K) (w : K)) →
      False := by
    rintro x w rhs v heq ⟨r, hr⟩ ⟨s, hs⟩ hnw
    apply hnw
    have hx_ne : algebraMap K (v.adicCompletion K) (x : K) ≠ 0 :=
      (algebraMap K (v.adicCompletion K)).injective.ne x.ne_zero
    have hs_ne : s ≠ 0 := by
      rintro rfl; rw [mul_zero] at hs; exact hx_ne hs
    refine ⟨algebraMap K (v.adicCompletion K) r / s, ?_⟩
    have hprod : s ^ 2 * algebraMap K (v.adicCompletion K) (w : K) =
        algebraMap K (v.adicCompletion K) r * algebraMap K (v.adicCompletion K) r := by
      calc s ^ 2 * algebraMap K (v.adicCompletion K) (w : K)
        _ = (s * s) * algebraMap K (v.adicCompletion K) (w : K) := by ring
        _ = algebraMap K (v.adicCompletion K) ((x : K) * (w : K)) := by
            rw [← hs, map_mul]
        _ = algebraMap K (v.adicCompletion K) (r * r) := by rw [heq, hr]
        _ = algebraMap K (v.adicCompletion K) r * algebraMap K (v.adicCompletion K) r := by
            rw [map_mul]
    calc algebraMap K (v.adicCompletion K) (w : K)
      _ = (s ^ 2 * algebraMap K (v.adicCompletion K) (w : K)) / s ^ 2 := by
          rw [mul_div_cancel_left₀ _ (pow_ne_zero 2 hs_ne)]
      _ = (algebraMap K (v.adicCompletion K) r * algebraMap K (v.adicCompletion K) r) / s ^ 2 := by
          rw [hprod]
      _ = (algebraMap K (v.adicCompletion K) r / s) *
          (algebraMap K (v.adicCompletion K) r / s) := by ring
  refine ⟨S'₁, κ'₁, hsub_a.trans (hsub_b.trans (hsub_c.trans hsub_d)), hdisj'₁, hprin'₁,
    hspan_even, ?_⟩
  rintro x ⟨e₀, e₁, e₂, e₃, hsq⟩ hsq_all
  fin_cases e₀ <;> fin_cases e₁ <;> fin_cases e₂ <;> fin_cases e₃
  · simp only [Fin.zero_eta, Fin.val_zero, pow_zero, mul_one] at hsq
    rcases hsq with ⟨r, hr⟩
    have hr0 : r ≠ 0 := by
      rintro rfl; rw [mul_zero] at hr; exact x.ne_zero hr
    let u_r : Kˣ := Units.mk0 r hr0
    rw [sqCl, QuotientGroup.eq_one_iff, MonoidHom.mem_range]
    refine ⟨u_r, ?_⟩
    ext
    simp [u_r, powMonoidHom_apply, sq, ← hr]
  · exact False.elim (h_kill_of_eq x u₃ _ v₀
      (by simp [u₀, u₁, u₂, u₃]) hsq (hsq_all v₀ hv₀_S'₁) (hnsq_0 v₀ hv₀_in hv₀_not).2.2.2)
  · exact False.elim (h_kill_of_eq x u₂ _ v₀
      (by simp [u₀, u₁, u₂, u₃]) hsq (hsq_all v₀ hv₀_S'₁) (hnsq_0 v₀ hv₀_in hv₀_not).2.2.1)
  · exact False.elim (h_kill_of_eq x (u₂ * u₃) _ v₃
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₃ hv₃_S'₁) (hnsq_3 v₃ hv₃_in hv₃_not).2.1)
  · exact False.elim (h_kill_of_eq x u₁ _ v₀
      (by simp [u₀, u₁, u₂, u₃]) hsq (hsq_all v₀ hv₀_S'₁) (hnsq_0 v₀ hv₀_in hv₀_not).2.1)
  · exact False.elim (h_kill_of_eq x (u₁ * u₃) _ v₂
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₂ hv₂_S'₁) (hnsq_2 v₂ hv₂_in hv₂_not).1)
  · exact False.elim (h_kill_of_eq x (u₁ * u₂) _ v₁
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₁ hv₁_S'₁) (hnsq_1 v₁ hv₁_in hv₁_not).2.1)
  · exact False.elim (h_kill_of_eq x (u₂ * (u₁ * u₃)) _ v₂
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₂ hv₂_S'₁) (hnsq_2 v₂ hv₂_in hv₂_not).2.2.2)
  · exact False.elim (h_kill_of_eq x u₀ _ v₀
      (by simp [u₀, u₁, u₂, u₃]) hsq (hsq_all v₀ hv₀_S'₁) (hnsq_0 v₀ hv₀_in hv₀_not).1)
  · exact False.elim (h_kill_of_eq x (u₃ * u₀) _ v₂
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₂ hv₂_S'₁) (hnsq_2 v₂ hv₂_in hv₂_not).2.1)
  · exact False.elim (h_kill_of_eq x (u₀ * u₂) _ v₃
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₃ hv₃_S'₁) (hnsq_3 v₃ hv₃_in hv₃_not).1)
  · exact False.elim (h_kill_of_eq x (u₃ * (u₀ * u₂)) _ v₃
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₃ hv₃_S'₁) (hnsq_3 v₃ hv₃_in hv₃_not).2.2.1)
  · exact False.elim (h_kill_of_eq x (u₀ * u₁) _ v₁
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₁ hv₁_S'₁) (hnsq_1 v₁ hv₁_in hv₁_not).1)
  · exact False.elim (h_kill_of_eq x (u₃ * (u₀ * u₁)) _ v₁
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₁ hv₁_S'₁) (hnsq_1 v₁ hv₁_in hv₁_not).2.2.2)
  · exact False.elim (h_kill_of_eq x (u₂ * (u₀ * u₁)) _ v₁
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₁ hv₁_S'₁) (hnsq_1 v₁ hv₁_in hv₁_not).2.2.1)
  · exact False.elim (h_kill_of_eq x (u₁ * (u₃ * (u₀ * u₂))) _ v₃
      (by simp [u₀, u₁, u₂, u₃]; ring) hsq (hsq_all v₃ hv₃_S'₁) (hnsq_3 v₃ hv₃_in hv₃_not).2.2.2)

theorem exists_killing_primes_for_unramified_outside_span (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S'₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (κ'₁ : Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hdisj'₁ : Disjoint S'₁ T)
    (hprin'₁ : IsPrincipalPrimeSet K S'₁ κ'₁)
    (hext : HasPrincipalNonSquareExtension K T) :
    ∃ (S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (κ₂ : Kˣ),
      S'₁ ⊆ S₂ ∧
      Disjoint S₂ T ∧
      IsPrincipalPrimeSet K S₂ κ₂ ∧
      (∀ v ∈ S₂, v ∉ S'₁ →
        ¬ IsSquare (algebraMap K (v.adicCompletion K) ((a₁ - a₂) * (a₁ - a₃))) ∧
        ¬ IsSquare (algebraMap K (v.adicCompletion K) (-((a₁ - a₂) * (a₂ - a₃)))) ∧
        ¬ IsSquare (algebraMap K (v.adicCompletion K) ((a₁ - a₃) * (a₂ - a₃)))) ∧
      (∀ x : Kˣ,
        (∀ v, v ∉ T → v ∉ S'₁ → EvenVal v x) →
        (∀ v ∈ S₂, v ∉ S'₁ → IsSquare (algebraMap K (v.adicCompletion K) (x : K))) →
        InStartingSpan K a₁ a₂ a₃ x) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, _, _, _, hindep₀, _⟩
  have hw₁_ne : (a₁ - a₂) * (a₁ - a₃) ≠ 0 :=
    mul_ne_zero (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)
  have hw₂_ne : -((a₁ - a₂) * (a₂ - a₃)) ≠ 0 :=
    neg_ne_zero.mpr (mul_ne_zero (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₂₃))
  have hw₃_ne : (a₁ - a₃) * (a₂ - a₃) ≠ 0 :=
    mul_ne_zero (sub_ne_zero.mpr h₁₃) (sub_ne_zero.mpr h₂₃)
  let w₁ : Kˣ := Units.mk0 ((a₁ - a₂) * (a₁ - a₃)) hw₁_ne
  let w₂ : Kˣ := Units.mk0 (-((a₁ - a₂) * (a₂ - a₃))) hw₂_ne
  let w₃ : Kˣ := Units.mk0 ((a₁ - a₃) * (a₂ - a₃)) hw₃_ne
  
  have h_units_fin : (Set.range (fun u : Rˣ =>
      sqCl (Units.map (algebraMap R K).toMonoidHom u))).Finite := by
    let ψ : Rˣ → SqCl K :=
      fun u => sqCl (Units.map (algebraMap R K).toMonoidHom u)
    have hψ_one : ψ 1 = 1 := by
      simp [ψ, sqCl]
    have hψ_mul : ∀ u v : Rˣ, ψ (u * v) = ψ u * ψ v := by
      intro u v
      simp [ψ, sqCl, QuotientGroup.mk_mul]
    have hψ_sq : ∀ u : Rˣ, ψ u * ψ u = 1 := by
      intro u
      dsimp [ψ]
      rw [sqCl, ← QuotientGroup.mk_mul, QuotientGroup.eq_one_iff, MonoidHom.mem_range]
      exact ⟨Units.map (algebraMap R K).toMonoidHom u,
        by simp [powMonoidHom_apply, sq]⟩
    have hfg : Monoid.FG Rˣ := inferInstance
    obtain ⟨S, hS⟩ := Monoid.fg_def.mp hfg
    let P : Finset (SqCl K) := S.powerset.image (fun I => ∏ s ∈ I, ψ s)
    have hstep : ∀ s ∈ S, ∀ c ∈ P, ψ s * c ∈ P := by
      intro s hs c hc
      rcases Finset.mem_image.mp hc with ⟨I, hI, rfl⟩
      by_cases hsI : s ∈ I
      · refine Finset.mem_image.mpr ⟨I.erase s, Finset.mem_powerset.mpr
          ((Finset.erase_subset s I).trans (Finset.mem_powerset.mp hI)), ?_⟩
        rw [← Finset.mul_prod_erase I ψ hsI, ← mul_assoc, hψ_sq s]
        exact (one_mul (∏ x ∈ I.erase s, ψ x)).symm
      · refine Finset.mem_image.mpr ⟨insert s I, Finset.mem_powerset.mpr
          (Finset.insert_subset_iff.mpr ⟨hs, Finset.mem_powerset.mp hI⟩), ?_⟩
        rw [Finset.prod_insert hsI]
    have hclosure : ∀ u ∈ Submonoid.closure (S : Set Rˣ),
        ∀ c ∈ P, ψ u * c ∈ P := by
      intro u hu
      induction hu using Submonoid.closure_induction with
      | mem x hx => exact hstep x hx
      | one =>
          intro c hc
          rw [hψ_one]
          rwa [one_mul c]
      | mul x y _ _ ihx ihy =>
          intro c hc
          rw [hψ_mul, mul_assoc]
          exact ihx _ (ihy c hc)
    have h1P : (1 : SqCl K) ∈ P :=
      Finset.mem_image.mpr ⟨∅, Finset.mem_powerset.mpr (Finset.empty_subset S), Finset.prod_empty⟩
    refine P.finite_toSet.subset ?_
    rintro _ ⟨u, rfl⟩
    have hu_top : u ∈ (⊤ : Submonoid Rˣ) := Submonoid.mem_top u
    rw [← hS] at hu_top
    have hmem := hclosure u hu_top 1 h1P
    rwa [mul_one (ψ u)] at hmem
  
  have h_span_eq_prod_mul_sq : ∀ (x : Kˣ),
      (∀ v, v ∉ T → v ∉ S'₁ → EvenVal v x) →
      ∃ (y : R) (u_y : Kˣ) (A : Finset (IsDedekindDomain.HeightOneSpectrum R))
        (J : nonZeroDivisors (Ideal R)),
        (u_y : K) = (y : K) ∧
        sqCl u_y = sqCl x ∧
        (∀ v ∈ A, v ∈ T ∨ v ∈ S'₁) ∧
        Ideal.span {y} = (∏ v ∈ A, v.asIdeal) * (J : Ideal R) ^ 2 := by
    intro x heven
    obtain ⟨a, b, hb_nzd, hab⟩ := IsFractionRing.div_surjective (A := R) (x : K)
    have hb0 : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
    have hbK : (b : K) ≠ 0 := (IsFractionRing.injective R K).ne hb0
    have haK : (a : K) = (x : K) * (b : K) := (div_eq_iff hbK).mp hab
    let y : R := a * b
    have hyK_eq : (y : K) = (x : K) * (b : K) ^ 2 := by
      change (a : K) * (b : K) = (x : K) * (b : K) ^ 2
      rw [haK]; ring
    have hyK : (y : K) ≠ 0 := by
      rw [hyK_eq]; exact mul_ne_zero x.ne_zero (pow_ne_zero 2 hbK)
    have hy0 : y ≠ 0 := by
      intro h0; apply hyK; simp [h0]
    let u_y : Kˣ := Units.mk0 (y : K) hyK
    let u_b : Kˣ := Units.mk0 (b : K) hbK
    have hu_y_eq : u_y = x * u_b ^ 2 := by
      ext; exact hyK_eq
    have hsqCl : sqCl u_y = sqCl x := by
      symm
      rw [hu_y_eq, sqCl, sqCl, QuotientGroup.eq, inv_mul_cancel_left, MonoidHom.mem_range]
      exact ⟨u_b, by simp [powMonoidHom_apply]⟩
    let I : Ideal R := Ideal.span {y}
    have hI0 : I ≠ 0 := mt Ideal.span_singleton_eq_bot.mp hy0
    let e : IsDedekindDomain.HeightOneSpectrum R → ℕ :=
      fun v => (Associates.mk v.asIdeal).count (Associates.mk I).factors
    have he_even : ∀ v, v ∉ T → v ∉ S'₁ → e v % 2 = 0 := by
      intro v hvT hvS'₁
      rcases heven v hvT hvS'₁ with ⟨k, hk⟩
      have hval_mul : Multiplicative.toAdd (v.valuationOfNeZero u_y) =
          Multiplicative.toAdd (v.valuationOfNeZero x) +
          2 * Multiplicative.toAdd (v.valuationOfNeZero u_b) := by
        rw [hu_y_eq, map_mul, map_pow, toAdd_mul, toAdd_pow]
        ring
      have hval_int : ((v.valuationOfNeZero u_y : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
          WithZero.exp (-(e v : ℤ)) := by
        rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq,
          show (u_y : K) = algebraMap R K y from rfl,
          IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
          v.intValuation_if_neg hy0]
      have htoAdd : Multiplicative.toAdd (v.valuationOfNeZero u_y) = -(e v : ℤ) :=
        WithZero.coe_inj.mp hval_int
      omega
    let F : Finset (IsDedekindDomain.HeightOneSpectrum R) := T ∪ S'₁
    let M_y : Finset (IsDedekindDomain.HeightOneSpectrum R) :=
      (Ideal.finite_mulSupport hI0).toFinset ∪ F
    have hsupp : Function.mulSupport
        (fun v : IsDedekindDomain.HeightOneSpectrum R => v.maxPowDividing I) ⊆ ↑M_y := by
      intro v hv
      exact Finset.mem_coe.mpr (Finset.mem_union_left F ((Ideal.finite_mulSupport hI0).mem_toFinset.mpr hv))
    have hfact : ∏ v ∈ M_y, v.asIdeal ^ e v = I := by
      change ∏ v ∈ M_y, v.maxPowDividing I = I
      rw [← finprod_eq_prod_of_mulSupport_subset _ hsupp]
      exact Ideal.finprod_heightOneSpectrum_factorization hI0
    let A : Finset (IsDedekindDomain.HeightOneSpectrum R) := F.filter (fun v => e v % 2 = 1)
    let J₀ : Ideal R := ∏ v ∈ M_y, v.asIdeal ^ (e v / 2)
    have hI_split : I = (∏ v ∈ A, v.asIdeal) * J₀ ^ 2 := by
      have h1 : I = (∏ v ∈ M_y, v.asIdeal ^ (e v % 2)) * J₀ ^ 2 := by
        rw [← hfact, show J₀ ^ 2 = ∏ v ∈ M_y, (v.asIdeal ^ (e v / 2)) ^ 2 from
          (Finset.prod_pow _ _ _).symm, ← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl (fun v _ => ?_)
        conv_lhs => rw [← Nat.mod_add_div (e v) 2]
        rw [pow_add, pow_mul']
      rw [h1]
      congr 1
      have hA_sub : A ⊆ M_y :=
        (Finset.filter_subset _ F).trans (Finset.subset_union_right)
      rw [← Finset.prod_subset hA_sub]
      · refine Finset.prod_congr rfl (fun v hvA => ?_)
        rw [(Finset.mem_filter.mp hvA).2, pow_one]
      · intro v _ hvA
        have hmod0 : e v % 2 = 0 := by
          by_cases hvF : v ∈ F
          · have hnot1 : e v % 2 ≠ 1 := fun h1 => hvA (Finset.mem_filter.mpr ⟨hvF, h1⟩)
            omega
          · rw [Finset.mem_union, not_or] at hvF
            exact he_even v hvF.1 hvF.2
        rw [hmod0, pow_zero]
    have hJ₀_ne : J₀ ≠ 0 := by
      rintro h0
      apply hI0
      rw [hI_split, h0, zero_pow (by decide), mul_zero]
    refine ⟨y, u_y, A, ⟨J₀, mem_nonZeroDivisors_iff_ne_zero.mpr hJ₀_ne⟩, rfl, hsqCl, ?_, hI_split⟩
    intro v hvA
    exact Finset.mem_union.mp (Finset.mem_of_mem_filter v hvA)
  
  have h_unit_sqCl_eq : ∀ (y y₀ : R) (u_y u_y₀ : Kˣ) (P : Ideal R)
      (J J₀ : nonZeroDivisors (Ideal R)),
      (u_y : K) = (y : K) →
      (u_y₀ : K) = (y₀ : K) →
      Ideal.span {y} = P * (J : Ideal R) ^ 2 →
      Ideal.span {y₀} = P * (J₀ : Ideal R) ^ 2 →
      ClassGroup.mk0 J = ClassGroup.mk0 J₀ →
      ∃ u : Rˣ,
        sqCl u_y = sqCl (Units.map (algebraMap R K).toMonoidHom u) * sqCl u_y₀ := by
    intro y y₀ u_y u_y₀ P J J₀ hy hy₀ hspan hspan₀ hcl
    obtain ⟨H, hH⟩ := ClassGroup.mk0_surjective (ClassGroup.mk0 J₀)⁻¹
    have hJ₀H : ClassGroup.mk0 (J₀ * H) = 1 := by
      rw [map_mul, hH, mul_inv_cancel]
    have hJH : ClassGroup.mk0 (J * H) = 1 := by
      rw [map_mul, hcl, hH, mul_inv_cancel]
    obtain ⟨w₀, hw₀_span⟩ := ((ClassGroup.mk0_eq_one_iff (J₀ * H).2).mp hJ₀H).1
    obtain ⟨z, hz_span⟩ := ((ClassGroup.mk0_eq_one_iff (J * H).2).mp hJH).1
    have hw₀_ne : w₀ ≠ 0 := by
      intro h0
      have hbot : ((J₀ * H : nonZeroDivisors (Ideal R)) : Ideal R) = ⊥ := by
        rw [hw₀_span, h0, Ideal.submodule_span_eq, Ideal.span_singleton_eq_bot]
      exact mem_nonZeroDivisors_iff_ne_zero.mp (J₀ * H).2 hbot
    have hz_ne : z ≠ 0 := by
      intro h0
      have hbot : ((J * H : nonZeroDivisors (Ideal R)) : Ideal R) = ⊥ := by
        rw [hz_span, h0, Ideal.submodule_span_eq, Ideal.span_singleton_eq_bot]
      exact mem_nonZeroDivisors_iff_ne_zero.mp (J * H).2 hbot
    have hspan_eq : Ideal.span {y₀ * z ^ 2} = Ideal.span {y * w₀ ^ 2} := by
      calc Ideal.span {y₀ * z ^ 2}
        _ = Ideal.span {y₀} * (Ideal.span {z}) ^ 2 := by
            rw [← Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_pow]
        _ = (P * (J₀ : Ideal R) ^ 2) * ((J : Ideal R) * (H : Ideal R)) ^ 2 := by
            rw [hspan₀, ← Ideal.submodule_span_eq, ← hz_span, Submonoid.coe_mul]
        _ = (P * (J : Ideal R) ^ 2) * ((J₀ : Ideal R) * (H : Ideal R)) ^ 2 := by ring
        _ = Ideal.span {y} * (Ideal.span {w₀}) ^ 2 := by
            rw [hspan, ← Ideal.submodule_span_eq, ← hw₀_span, Submonoid.coe_mul]
        _ = Ideal.span {y * w₀ ^ 2} := by
            rw [← Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_pow]
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan_eq
    refine ⟨u, ?_⟩
    have hw₀K : (w₀ : K) ≠ 0 := (IsFractionRing.injective R K).ne hw₀_ne
    have hzK : (z : K) ≠ 0 := (IsFractionRing.injective R K).ne hz_ne
    let u_w₀ : Kˣ := Units.mk0 (w₀ : K) hw₀K
    let u_z : Kˣ := Units.mk0 (z : K) hzK
    let u_K : Kˣ := Units.map (algebraMap R K).toMonoidHom u
    have hu_units : u_y * u_w₀ ^ 2 = (u_K * u_y₀) * u_z ^ 2 := by
      ext
      have huK : (y₀ : K) * (z : K) ^ 2 * (u_K : K) = (y : K) * (w₀ : K) ^ 2 := by
        have := congrArg (algebraMap R K) hu
        simpa [map_mul, map_pow, u_K] using this
      simp only [Units.val_mul, Units.val_pow_eq_pow_val, hy, hy₀, u_w₀, u_z, Units.val_mk0]
      linear_combination -huK
    have h_sq_kill : ∀ (a b : Kˣ), sqCl (a * b ^ 2) = sqCl a := by
      intro a b
      symm
      rw [sqCl, sqCl, QuotientGroup.eq, inv_mul_cancel_left, MonoidHom.mem_range]
      exact ⟨b, by simp [powMonoidHom_apply]⟩
    calc sqCl u_y
      _ = sqCl (u_y * u_w₀ ^ 2) := (h_sq_kill u_y u_w₀).symm
      _ = sqCl ((u_K * u_y₀) * u_z ^ 2) := by rw [hu_units]
      _ = sqCl (u_K * u_y₀) := h_sq_kill (u_K * u_y₀) u_z
      _ = sqCl u_K * sqCl u_y₀ := by simp [sqCl, QuotientGroup.mk_mul]
  
  have h_sqClIndep4 : ∀ (x : Kˣ), ¬ InStartingSpan K a₁ a₂ a₃ x → SqClIndep4 K w₁ w₂ w₃ x := by
    intro x hx
    have h₁₂_sub : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr h₁₂
    have h₁₃_sub : a₁ - a₃ ≠ 0 := sub_ne_zero.mpr h₁₃
    have h₂₃_sub : a₂ - a₃ ≠ 0 := sub_ne_zero.mpr h₂₃
    intro e₁ e₂ e₃ e₄ ⟨r, hr⟩
    let f₀ : Fin 2 := e₂
    let f₁ : Fin 2 := ⟨((e₁ : ℕ) + (e₂ : ℕ)) % 2, Nat.mod_lt _ (by decide)⟩
    let f₂ : Fin 2 := ⟨((e₁ : ℕ) + (e₃ : ℕ)) % 2, Nat.mod_lt _ (by decide)⟩
    let f₃ : Fin 2 := ⟨((e₂ : ℕ) + (e₃ : ℕ)) % 2, Nat.mod_lt _ (by decide)⟩
    let s : K := (a₁ - a₂) ^ (((e₁ : ℕ) + (e₂ : ℕ)) / 2) *
      (a₁ - a₃) ^ (((e₁ : ℕ) + (e₃ : ℕ)) / 2) *
      (a₂ - a₃) ^ (((e₂ : ℕ) + (e₃ : ℕ)) / 2)
    have hs_ne : s ≠ 0 :=
      mul_ne_zero (mul_ne_zero (pow_ne_zero _ h₁₂_sub) (pow_ne_zero _ h₁₃_sub)) (pow_ne_zero _ h₂₃_sub)
    let P : K := (-1 : K) ^ (f₀ : ℕ) * (a₁ - a₂) ^ (f₁ : ℕ) *
      (a₁ - a₃) ^ (f₂ : ℕ) * (a₂ - a₃) ^ (f₃ : ℕ)
    have hid : (w₁ : K) ^ (e₁ : ℕ) * (w₂ : K) ^ (e₂ : ℕ) * (w₃ : K) ^ (e₃ : ℕ) = P * s ^ 2 := by
      fin_cases e₁ <;> fin_cases e₂ <;> fin_cases e₃ <;>
        simp only [P, s, f₀, f₁, f₂, f₃, w₁, w₂, w₃, Units.val_mk0] <;> ring
    rw [hid] at hr
    fin_cases e₄
    · change P * s ^ 2 * (x : K) ^ 0 = r * r at hr
      rw [pow_zero, mul_one] at hr
      have hP_sq : IsSquare P := by
        refine ⟨r / s, ?_⟩
        calc P = (P * s ^ 2) / s ^ 2 := by rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hs_ne)]
          _ = (r * r) / s ^ 2 := by rw [hr]
          _ = (r / s) * (r / s) := by ring
      have hf := hindep₀ f₀ f₁ f₂ f₃ hP_sq
      fin_cases e₁ <;> fin_cases e₂ <;> fin_cases e₃ <;> revert hf <;> decide
    · change P * s ^ 2 * (x : K) ^ 1 = r * r at hr
      rw [pow_one] at hr
      exfalso
      apply hx
      refine ⟨f₀, f₁, f₂, f₃, r / s, ?_⟩
      have h_assoc : (x : K) * (-1 : K) ^ (f₀ : ℕ) * (a₁ - a₂) ^ (f₁ : ℕ) *
          (a₁ - a₃) ^ (f₂ : ℕ) * (a₂ - a₃) ^ (f₃ : ℕ) = (x : K) * P := by
        dsimp [P]; ring
      rw [h_assoc]
      calc (x : K) * P
        _ = (P * s ^ 2 * (x : K)) / s ^ 2 := by
            have : P * s ^ 2 * (x : K) = ((x : K) * P) * s ^ 2 := by ring
            rw [this, mul_div_cancel_right₀ _ (pow_ne_zero 2 hs_ne)]
        _ = (r * r) / s ^ 2 := by rw [hr]
        _ = (r / s) * (r / s) := by ring
  
  let U : Set (SqCl K) :=
    { c : SqCl K | ∃ x : Kˣ, sqCl x = c ∧
      (∀ v, v ∉ T → v ∉ S'₁ → EvenVal v x) ∧
      ¬ InStartingSpan K a₁ a₂ a₃ x }
  let B : Finset (IsDedekindDomain.HeightOneSpectrum R) → ClassGroup R → Set (SqCl K) :=
    fun A g =>
      { c : SqCl K | ∃ (y : R) (u_y : Kˣ) (J : nonZeroDivisors (Ideal R)),
        (u_y : K) = (y : K) ∧
        sqCl u_y = c ∧
        ClassGroup.mk0 J = g ∧
        Ideal.span {y} = (∏ v ∈ A, v.asIdeal) * (J : Ideal R) ^ 2 }
  have hB_fin : ∀ (A : Finset (IsDedekindDomain.HeightOneSpectrum R)) (g : ClassGroup R),
      (B A g).Finite := by
    intro A g
    by_cases hne : (B A g).Nonempty
    · rcases hne with ⟨c₀, y₀, u_y₀, J₀, hy₀, rfl, rfl, hspan₀⟩
      refine (h_units_fin.image (fun d => d * sqCl u_y₀)).subset ?_
      rintro c ⟨y, u_y, J, hy, rfl, hcl, hspan⟩
      obtain ⟨u, hu⟩ := h_unit_sqCl_eq y y₀ u_y u_y₀ (∏ v ∈ A, v.asIdeal) J J₀ hy hy₀ hspan hspan₀ hcl
      exact ⟨_, ⟨u, rfl⟩, hu.symm⟩
    · rw [Set.not_nonempty_iff_eq_empty.mp hne]
      exact Set.finite_empty
  have hU_fin : U.Finite := by
    have hW_fin : (⋃ A ∈ (T ∪ S'₁).powerset, ⋃ g : ClassGroup R, B A g).Finite :=
      (T ∪ S'₁).powerset.finite_toSet.biUnion (fun A _ => Set.finite_iUnion (hB_fin A))
    refine hW_fin.subset ?_
    rintro c ⟨x, rfl, heven, _⟩
    obtain ⟨y, u_y, A, J, hy, hsqCl, hA_sub, hspan⟩ := h_span_eq_prod_mul_sq x heven
    have hA_mem : A ∈ (T ∪ S'₁).powerset :=
      Finset.mem_powerset.mpr (fun v hvA => Finset.mem_union.mpr (hA_sub v hvA))
    exact Set.mem_biUnion hA_mem (Set.mem_iUnion.mpr ⟨ClassGroup.mk0 J, ⟨y, u_y, J, hy, hsqCl, rfl, hspan⟩⟩)
  have hind : ∀ (C : Finset (SqCl K)), (∀ c ∈ C, c ∈ U) →
      ∃ (S₂ : Finset (IsDedekindDomain.HeightOneSpectrum R)) (κ₂ : Kˣ),
        S'₁ ⊆ S₂ ∧
        Disjoint S₂ T ∧
        IsPrincipalPrimeSet K S₂ κ₂ ∧
        (∀ v ∈ S₂, v ∉ S'₁ →
          ¬ IsSquare (algebraMap K (v.adicCompletion K) (w₁ : K)) ∧
          ¬ IsSquare (algebraMap K (v.adicCompletion K) (w₂ : K)) ∧
          ¬ IsSquare (algebraMap K (v.adicCompletion K) (w₃ : K))) ∧
        (∀ c ∈ C, ∃ v ∈ S₂, v ∉ S'₁ ∧
          ∀ x : Kˣ, sqCl x = c → ¬ IsSquare (algebraMap K (v.adicCompletion K) (x : K))) := by
    intro C
    induction C using Finset.induction with
    | empty =>
      intro _
      refine ⟨S'₁, κ'₁, Finset.Subset.refl _, hdisj'₁, hprin'₁, ?_, ?_⟩
      · intro v hv hv_not
        exact False.elim (hv_not hv)
      · intro c hc
        exact False.elim (Finset.notMem_empty c hc)
    | @insert c₀ C hc₀_not_mem ih =>
      intro hC
      have hc₀_U : c₀ ∈ U := hC c₀ (Finset.mem_insert_self c₀ C)
      have hC_sub : ∀ c ∈ C, c ∈ U := fun c hc => hC c (Finset.mem_insert_of_mem hc)
      obtain ⟨S, κ, hS_sub, hS_disj, hS_prin, hS_w, hS_kill⟩ := ih hC_sub
      rcases hc₀_U with ⟨x₀, rfl, _, hx₀_not_span⟩
      have hindep4 : SqClIndep4 K w₁ w₂ w₃ x₀ := h_sqClIndep4 x₀ hx₀_not_span
      obtain ⟨S', κ', v₀, hSS', hS'_disj, hS'_prin, hv₀_in, hv₀_not, hS'_nonsq⟩ :=
        hext S κ w₁ w₂ w₃ x₀ hS_disj hS_prin hindep4
      refine ⟨S', κ', hS_sub.trans hSS', hS'_disj, hS'_prin, ?_, ?_⟩
      · intro v hv hv_not_S'₁
        by_cases hvS : v ∈ S
        · exact hS_w v hvS hv_not_S'₁
        · obtain ⟨hn₁, hn₂, hn₃, _⟩ := hS'_nonsq v hv hvS
          exact ⟨hn₁, hn₂, hn₃⟩
      · intro c hc
        rcases Finset.mem_insert.mp hc with rfl | hcC
        · refine ⟨v₀, hv₀_in, fun hv₀_S'₁ => hv₀_not (hS_sub hv₀_S'₁), ?_⟩
          intro x hx_eq ⟨r, hr⟩
          have h_quot : x₀⁻¹ * x ∈ (powMonoidHom 2 : Kˣ →* Kˣ).range :=
            QuotientGroup.eq.mp hx_eq.symm
          rcases MonoidHom.mem_range.mp h_quot with ⟨u, hu⟩
          have hx_u : x = x₀ * u ^ 2 := by
            calc x = x₀ * (x₀⁻¹ * x) := (mul_inv_cancel_left x₀ x).symm
              _ = x₀ * u ^ 2 := by rw [← hu, powMonoidHom_apply]
          have hu_ne : algebraMap K (v₀.adicCompletion K) (u : K) ≠ 0 :=
            (RingHom.injective _).ne u.ne_zero
          apply (hS'_nonsq v₀ hv₀_in hv₀_not).2.2.2
          refine ⟨r / algebraMap K (v₀.adicCompletion K) (u : K), ?_⟩
          have hx_map : algebraMap K (v₀.adicCompletion K) (x : K) =
              algebraMap K (v₀.adicCompletion K) (x₀ : K) *
              (algebraMap K (v₀.adicCompletion K) (u : K)) ^ 2 := by
            have hval : (x : K) = (x₀ : K) * (u : K) ^ 2 := by
              exact_mod_cast congrArg Units.val hx_u
            rw [hval, map_mul, map_pow]
          calc algebraMap K (v₀.adicCompletion K) (x₀ : K)
            _ = (algebraMap K (v₀.adicCompletion K) (x₀ : K) *
                (algebraMap K (v₀.adicCompletion K) (u : K)) ^ 2) /
                (algebraMap K (v₀.adicCompletion K) (u : K)) ^ 2 := by
                rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hu_ne)]
            _ = (r * r) / (algebraMap K (v₀.adicCompletion K) (u : K)) ^ 2 := by
                rw [← hx_map, hr]
            _ = (r / algebraMap K (v₀.adicCompletion K) (u : K)) *
                (r / algebraMap K (v₀.adicCompletion K) (u : K)) := by ring
        · obtain ⟨v, hvS, hv_not_S'₁, hv_kill⟩ := hS_kill c hcC
          exact ⟨v, hSS' hvS, hv_not_S'₁, hv_kill⟩
  obtain ⟨S₂, κ₂, hS'₁_sub, hdisj₂, hprin₂, hw_nonsq, hkill⟩ :=
    hind hU_fin.toFinset (fun c hc => hU_fin.mem_toFinset.mp hc)
  refine ⟨S₂, κ₂, hS'₁_sub, hdisj₂, hprin₂, hw_nonsq, ?_⟩
  intro x heven hsq
  by_contra hnot
  have hxU : sqCl x ∈ hU_fin.toFinset :=
    hU_fin.mem_toFinset.mpr ⟨x, rfl, heven, hnot⟩
  obtain ⟨v, hvS₂, hv_not_S'₁, hv_kill⟩ := hkill (sqCl x) hxU
  exact hv_kill x rfl (hsq v hvS₂ hv_not_S'₁)

theorem exists_vanishing_auxiliary_spaces (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₁ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₁ : Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₁ : IsRankZeroSelmerState K a₁ a₂ a₃ T S₁ π₁ κ₁) :
    ∃ (S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ₂ : Kˣ),
      IsCleanSelmerState K a₁ a₂ a₃ T S₂ π₂ κ₂ :=
by
  rcases hS₁ with ⟨hdisj₁, hπ₁, hprin₁, hsel₁⟩
  have hext : HasPrincipalNonSquareExtension K T :=
    hasPrincipalNonSquareExtension_of_chebotarev K T
  obtain ⟨S'₁, κ'₁, hS₁_sub, hdisj'₁, hprin'₁, hspan_even, hspan_kill⟩ :=
    exists_killing_primes_for_starting_span K a₁ a₂ a₃ τ T S₁ κ₁ hstart hT hdisj₁ hprin₁ hext
  obtain ⟨S₂, κ₂, hS'₁_sub, hdisj₂, hprin₂, hdiff_nonsq, hout_kill⟩ :=
    exists_killing_primes_for_unramified_outside_span K a₁ a₂ a₃ τ T S'₁ κ'₁
      hstart hdisj'₁ hprin'₁ hext
  obtain ⟨π₂, _, hπ₂, hsel₂⟩ :=
    exists_non_growing_uniformizer_finset_of_selmer_trivial K a₁ a₂ a₃ τ T S₁ S₂ π₁
      hstart hT (hS₁_sub.trans hS'₁_sub) hdisj₂ hπ₁ hsel₁
  have h_vanish : ∀ x : Kˣ,
      (∀ v ∈ S₂,
        RamLocal a₁ a₂ a₃ v (π₂ v) x x ∨
        RamLocal a₁ a₂ a₃ v (π₂ v) x 1 ∨
        RamLocal a₁ a₂ a₃ v (π₂ v) 1 x) →
      (∀ v, v ∉ T → v ∉ S₂ → EvenVal v x) →
      sqCl x = 1 := by
    intro x hram heven
    have h_S₂_diff : ∀ v ∈ S₂, v ∉ S'₁ →
        IsSquare (algebraMap K (v.adicCompletion K) (x : K)) ∧ EvenVal v x := by
      intro v hv hv_not_S'₁
      have hvT : v ∉ T := Finset.disjoint_left.mp hdisj₂ hv
      obtain ⟨hn₁, hn₂, hn₃⟩ := hdiff_nonsq v hv hv_not_S'₁
      exact (ramLocal_iff_isSquare_of_evenVal_and_nonSquare
        K a₁ a₂ a₃ τ T hstart hT v hvT (π₂ v) (hπ₂ v hv) x).2
        hn₁ hn₂ hn₃ (hram v hv)
    have heven_S'₁ : ∀ v, v ∉ T → v ∉ S'₁ → EvenVal v x := by
      intro v hvT hv_not_S'₁
      by_cases hvS₂ : v ∈ S₂
      · exact (h_S₂_diff v hvS₂ hv_not_S'₁).2
      · exact heven v hvT hvS₂
    have hsq_S₂_diff : ∀ v ∈ S₂, v ∉ S'₁ →
        IsSquare (algebraMap K (v.adicCompletion K) (x : K)) := by
      intro v hv hv_not_S'₁
      exact (h_S₂_diff v hv hv_not_S'₁).1
    have hspan : InStartingSpan K a₁ a₂ a₃ x :=
      hout_kill x heven_S'₁ hsq_S₂_diff
    have hsq_S'₁ : ∀ v ∈ S'₁, IsSquare (algebraMap K (v.adicCompletion K) (x : K)) := by
      intro v hv
      have hvS₂ : v ∈ S₂ := hS'₁_sub hv
      have hvT : v ∉ T := Finset.disjoint_left.mp hdisj'₁ hv
      have hev : EvenVal v x := hspan_even x hspan v hvT
      exact (ramLocal_iff_isSquare_of_evenVal_and_nonSquare
        K a₁ a₂ a₃ τ T hstart hT v hvT (π₂ v) (hπ₂ v hvS₂) x).1
        hev (hram v hvS₂)
    exact hspan_kill x hspan hsq_S'₁
  refine ⟨S₂, π₂, κ₂, ⟨hdisj₂, hπ₂, hprin₂, hsel₂⟩, ?_, ?_, ?_⟩
  · intro x hram heven
    exact h_vanish x (fun v hv => Or.inl (hram v hv)) heven
  · intro x hram heven
    exact h_vanish x (fun v hv => Or.inr (Or.inl (hram v hv))) heven
  · intro x hram heven
    exact h_vanish x (fun v hv => Or.inr (Or.inr (hram v hv))) heven

theorem isSquare_one_add_four_mul_of_valuation_le (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (z : v.adicCompletion K)
    (hz : Valued.v z ≤ WithZero.exp (-1 : ℤ)) :
    IsSquare (1 + 4 * z) :=
by
  let e₁ : WithZero (Multiplicative ℤ) := WithZero.exp (-1 : ℤ)
  have he₁_le_one : e₁ ≤ 1 := by
    rw [← WithZero.exp_zero]
    exact WithZero.exp_le_exp.mpr (by omega)
  have hw_le : ∀ n : ℕ, Valued.v (henselSeq z n) ≤ e₁ := by
    intro n
    induction n with
    | zero =>
      simp only [henselSeq, Valuation.map_zero]
      exact zero_le'
    | succ n ih =>
      simp only [henselSeq]
      have hsq : Valued.v ((henselSeq z n) ^ 2) ≤ e₁ := by
        rw [sq, Valuation.map_mul]
        calc Valued.v (henselSeq z n) * Valued.v (henselSeq z n)
          _ ≤ e₁ * 1 := mul_le_mul' ih (le_trans ih he₁_le_one)
          _ = e₁ := mul_one e₁
      exact le_trans (Valuation.map_sub _ _ _) (max_le hz hsq)
  have hw_diff : ∀ n : ℕ, Valued.v (henselSeq z (n + 1) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
    intro n
    induction n with
    | zero =>
      have h0 : henselSeq z 1 - henselSeq z 0 = z := by
        simp [henselSeq]
      rw [h0]
      simpa using hz
    | succ n ih =>
      have hstep : henselSeq z (n + 2) - henselSeq z (n + 1) =
          -(henselSeq z (n + 1) + henselSeq z n) * (henselSeq z (n + 1) - henselSeq z n) := by
        simp only [henselSeq]
        ring
      have hsum : Valued.v (henselSeq z (n + 1) + henselSeq z n) ≤ e₁ :=
        le_trans (Valuation.map_add _ _ _) (max_le (hw_le (n + 1)) (hw_le n))
      rw [hstep, Valuation.map_mul, Valuation.map_neg]
      calc Valued.v (henselSeq z (n + 1) + henselSeq z n) * Valued.v (henselSeq z (n + 1) - henselSeq z n)
        _ ≤ WithZero.exp (-1 : ℤ) * WithZero.exp (-(n + 1 : ℤ)) := mul_le_mul' hsum ih
        _ = WithZero.exp ((-1 : ℤ) + -(n + 1 : ℤ)) := (WithZero.exp_add (-1 : ℤ) (-(n + 1 : ℤ))).symm
        _ = WithZero.exp (-((n + 1 : ℕ) + 1 : ℤ)) := by congr 1; push_cast; ring
  have hw_tele : ∀ n k : ℕ, Valued.v (henselSeq z (n + k) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
    intro n k
    induction k with
    | zero =>
      simp only [Nat.add_zero, sub_self, Valuation.map_zero]
      exact zero_le'
    | succ k ih =>
      have hsplit : henselSeq z (n + (k + 1)) - henselSeq z n =
          (henselSeq z (n + k + 1) - henselSeq z (n + k)) + (henselSeq z (n + k) - henselSeq z n) := by
        have hidx : n + (k + 1) = n + k + 1 := by omega
        rw [hidx]
        ring
      rw [hsplit]
      refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ih)
      refine le_trans (hw_diff (n + k)) ?_
      exact WithZero.exp_le_exp.mpr (by omega)
  have hw_symm : ∀ N a b : ℕ, N ≤ a → N ≤ b →
      Valued.v (henselSeq z b - henselSeq z a) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
    intro N a b ha hb
    have ha' : Valued.v (henselSeq z a - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      have h1 := hw_tele N (a - N)
      rwa [Nat.add_sub_of_le ha] at h1
    have hb' : Valued.v (henselSeq z b - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      have h1 := hw_tele N (b - N)
      rwa [Nat.add_sub_of_le hb] at h1
    have hsub : henselSeq z b - henselSeq z a =
        (henselSeq z b - henselSeq z N) - (henselSeq z a - henselSeq z N) := by ring
    rw [hsub]
    exact le_trans (Valuation.map_sub _ _ _) (max_le hb' ha')
  have hcauchy : CauchySeq (henselSeq z) := by
    rw [CauchySeq, Valued.cauchy_iff]
    refine ⟨Filter.map_neBot, ?_⟩
    intro γ
    obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp (Units.ne_zero γ)
    let m : ℤ := Multiplicative.toAdd g
    let N : ℕ := (-m).toNat
    have hlt : WithZero.exp (-(N + 1 : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
      rw [← hg]
      change WithZero.exp (-(N + 1 : ℤ)) < WithZero.exp m
      exact WithZero.exp_lt_exp.mpr (by omega)
    refine ⟨(henselSeq z) '' Set.Ici N, Filter.image_mem_map (Filter.mem_atTop N), ?_⟩
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    exact lt_of_le_of_lt (hw_symm N a b ha hb) hlt
  obtain ⟨w_inf, hw_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
  have hw_shift : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds w_inf) :=
    (Filter.tendsto_add_atTop_iff_nat 1).mpr hw_lim
  have hw_rhs : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds (z - w_inf ^ 2)) := by
    have hfun : (fun n => henselSeq z (n + 1)) = (fun n => z - (henselSeq z n) ^ 2) := rfl
    rw [hfun]
    exact tendsto_const_nhds.sub (hw_lim.pow 2)
  have hw_eq : w_inf = z - w_inf ^ 2 := tendsto_nhds_unique hw_shift hw_rhs
  refine ⟨1 + 2 * w_inf, ?_⟩
  linear_combination -4 * hw_eq

theorem exists_nonSquare_adicCompletion_target_mod_ideal (K : Type u) [Field K] [NumberField K]
    (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 2 = 1) :
    ∃ u₀ : NumberField.RingOfIntegers K,
      u₀ ∉ v₀.asIdeal ∧
      ∀ π : NumberField.RingOfIntegers K, π - u₀ ∈ v₀.asIdeal →
        ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (π : K)) :=
by
  classical
  have hval_adic : ∀ x : K,
      Valued.v (algebraMap K (v₀.adicCompletion K) x) =
        (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) x :=
    fun x => v₀.valuedAdicCompletion_eq_valuation' x
  have hval_int : ∀ r : NumberField.RingOfIntegers K,
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) (r : K) = v₀.intValuation r :=
    fun r => v₀.valuation_of_algebraMap r
  obtain ⟨u₀, hu₀_not_mem, hu₀_nsq⟩ :
      ∃ u₀ : NumberField.RingOfIntegers K,
        u₀ ∉ v₀.asIdeal ∧ ∀ s : NumberField.RingOfIntegers K, u₀ - s ^ 2 ∉ v₀.asIdeal := by
    set R := NumberField.RingOfIntegers K
    set F := R ⧸ v₀.asIdeal
    haveI : v₀.asIdeal.IsMaximal := v₀.isMaximal
    letI : Field F := Ideal.Quotient.field v₀.asIdeal
    haveI : Finite F := Ideal.finiteQuotientOfFreeOfNeBot v₀.asIdeal v₀.ne_bot
    have h2_int : v₀.intValuation (2 : R) = 1 := by
      have hval : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) (algebraMap R K (2 : R)) =
          v₀.intValuation (2 : R) := v₀.valuation_of_algebraMap (2 : R)
      rw [map_ofNat] at hval
      exact hval.symm.trans h2
    have h2_notMem : (2 : R) ∉ v₀.asIdeal := v₀.intValuation_eq_one_iff.mp h2_int
    have h2F : (2 : F) ≠ 0 := by
      intro h0
      apply h2_notMem
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact (map_ofNat (Ideal.Quotient.mk v₀.asIdeal) 2).trans h0
    let φ : Fˣ →* Fˣ := powMonoidHom 2
    have hker_iff : ∀ u : Fˣ, u ∈ φ.ker ↔ u = 1 ∨ u = -1 := by
      intro u
      simp only [φ, MonoidHom.mem_ker, powMonoidHom_apply, Units.ext_iff, Units.val_pow_eq_pow_val,
        Units.val_one, sq_eq_one_iff, Units.val_neg]
    have hneg_mem : (-1 : Fˣ) ∈ φ.ker := (hker_iff (-1)).mpr (Or.inr rfl)
    let k_neg : ↥φ.ker := ⟨-1, hneg_mem⟩
    have hk_ne : k_neg ≠ 1 := by
      intro h
      have hval : ((-1 : Fˣ) : F) = ((1 : Fˣ) : F) :=
        congrArg (fun x : ↥φ.ker => ((x : Fˣ) : F)) h
      rw [Units.val_neg, Units.val_one] at hval
      apply h2F
      linear_combination -hval
    have hk_uniq : ∀ y : ↥φ.ker, y ≠ 1 → y = k_neg := by
      intro y hy
      rcases (hker_iff y.1).mp y.2 with h1 | hneg
      · exfalso
        apply hy
        exact Subtype.ext h1
      · exact Subtype.ext hneg
    have hcard_ker : Nat.card ↥φ.ker = 2 :=
      (Nat.card_eq_two_iff' (1 : ↥φ.ker)).mpr ⟨k_neg, hk_ne, hk_uniq⟩
    have hlag1 : Nat.card Fˣ = Nat.card (Fˣ ⧸ φ.ker) * Nat.card ↥φ.ker :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
    have hiso : Nat.card (Fˣ ⧸ φ.ker) = Nat.card ↥φ.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
    have hlag2 : Nat.card Fˣ = Nat.card (Fˣ ⧸ φ.range) * Nat.card ↥φ.range :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup φ.range
    have hpos_range : 0 < Nat.card ↥φ.range := Nat.card_pos
    have hcard_quot : Nat.card (Fˣ ⧸ φ.range) = 2 := by
      have hmul : Nat.card (Fˣ ⧸ φ.range) * Nat.card ↥φ.range = 2 * Nat.card ↥φ.range := by
        calc Nat.card (Fˣ ⧸ φ.range) * Nat.card ↥φ.range
          _ = Nat.card Fˣ := hlag2.symm
          _ = Nat.card (Fˣ ⧸ φ.ker) * Nat.card ↥φ.ker := hlag1
          _ = Nat.card ↥φ.range * 2 := by rw [hiso, hcard_ker]
          _ = 2 * Nat.card ↥φ.range := Nat.mul_comm _ _
      exact Nat.eq_of_mul_eq_mul_right hpos_range hmul
    obtain ⟨q₁, hq₁_ne, _⟩ := (Nat.card_eq_two_iff' (1 : Fˣ ⧸ φ.range)).mp hcard_quot
    obtain ⟨u₁, hu₁⟩ := QuotientGroup.mk_surjective q₁
    obtain ⟨u₀, hu₀_mk⟩ := Ideal.Quotient.mk_surjective (I := v₀.asIdeal) (u₁ : F)
    have hu₀_not_mem : u₀ ∉ v₀.asIdeal := by
      intro hu₀_in
      have h0 : Ideal.Quotient.mk v₀.asIdeal u₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hu₀_in
      rw [hu₀_mk] at h0
      exact u₁.ne_zero h0
    have hu₀_nsq : ∀ s : R, u₀ - s ^ 2 ∉ v₀.asIdeal := by
      intro s hs_in
      have hs0 : Ideal.Quotient.mk v₀.asIdeal (u₀ - s ^ 2) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hs_in
      rw [map_sub, map_pow, hu₀_mk, sub_eq_zero] at hs0
      set sbar : F := Ideal.Quotient.mk v₀.asIdeal s
      have hsbar_ne : sbar ≠ 0 := by
        intro h
        apply u₁.ne_zero
        rw [hs0, h, sq, zero_mul]
      let w : Fˣ := Units.mk0 sbar hsbar_ne
      have hw : φ w = u₁ := by
        apply Units.ext
        rw [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, hs0]
      have hu₁_mem : u₁ ∈ φ.range := ⟨w, hw⟩
      have hq₁_eq_one : (QuotientGroup.mk u₁ : Fˣ ⧸ φ.range) = 1 :=
        (QuotientGroup.eq_one_iff u₁).mpr hu₁_mem
      rw [hu₁] at hq₁_eq_one
      exact hq₁_ne hq₁_eq_one
    exact ⟨u₀, hu₀_not_mem, hu₀_nsq⟩
  have happrox : ∀ (u : v₀.adicCompletion K), Valued.v u = 1 →
      ∃ r : NumberField.RingOfIntegers K,
        Valued.v (u - algebraMap K (v₀.adicCompletion K) (r : K)) < 1 := by
    intro u hu
    have h_nhds : {y : v₀.adicCompletion K | Valued.v (y - u) < (1 : WithZero (Multiplicative ℤ))} ∈ nhds u := by
      rw [Valued.mem_nhds]
      exact ⟨1, fun y hy => hy⟩
    obtain ⟨x : K, hx_lt⟩ := DenseRange.mem_nhds UniformSpace.Completion.denseRange_coe h_nhds
    change Valued.v (algebraMap K (v₀.adicCompletion K) x - u) < 1 at hx_lt
    have hu_x_lt : Valued.v (u - algebraMap K (v₀.adicCompletion K) x) < 1 := by
      rwa [Valuation.map_sub_swap]
    have hx_val_L : Valued.v (algebraMap K (v₀.adicCompletion K) x) = 1 := by
      have h1 : algebraMap K (v₀.adicCompletion K) x = u + (algebraMap K (v₀.adicCompletion K) x - u) := by ring
      have hdist : Valued.v u ≠ Valued.v (algebraMap K (v₀.adicCompletion K) x - u) := by
        rw [hu]
        exact ne_of_gt hx_lt
      rw [h1, Valuation.map_add_of_distinct_val _ hdist, hu, max_eq_left (le_of_lt hx_lt)]
    have hx_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) x = 1 := by
      rwa [← hval_adic x]
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) x
    have hb0 : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
    have hb_val_ne : v₀.intValuation b ≠ 0 := v₀.intValuation_ne_zero' ⟨b, hb⟩
    have hab_val : v₀.intValuation a = v₀.intValuation b := by
      have hdiv : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀)
          (algebraMap (NumberField.RingOfIntegers K) K a /
            algebraMap (NumberField.RingOfIntegers K) K b) = 1 := by
        rw [hab, hx_val]
      rw [Valuation.map_div, hval_int a, hval_int b] at hdiv
      exact (div_eq_one_iff_eq hb_val_ne).mp hdiv
    set k : ℕ := (Associates.mk v₀.asIdeal).count (Associates.mk (Ideal.span {b})).factors
    have hb_exp : v₀.intValuation b = WithZero.exp (-(k : ℤ)) := v₀.intValuation_if_neg hb0
    have ha_exp : v₀.intValuation a = WithZero.exp (-(k : ℤ)) := hab_val.trans hb_exp
    have ha_mem : a ∈ v₀.asIdeal ^ k := (v₀.intValuation_le_pow_iff_mem a k).mp (le_of_eq ha_exp)
    have hb_mem : b ∈ v₀.asIdeal ^ k := (v₀.intValuation_le_pow_iff_mem b k).mp (le_of_eq hb_exp)
    have hb_not_mem : b ∉ v₀.asIdeal ^ (k + 1) := by
      intro hmem
      have hle := (v₀.intValuation_le_pow_iff_mem b (k + 1)).mpr hmem
      rw [hb_exp, WithZero.exp_le_exp] at hle
      omega
    have hI_eq : Ideal.span {b} ⊔ v₀.asIdeal ^ (k + 1) = v₀.asIdeal ^ k := by
      set I : Ideal (NumberField.RingOfIntegers K) := Ideal.span {b} ⊔ v₀.asIdeal ^ (k + 1)
      have hI_le : I ≤ v₀.asIdeal ^ k :=
        sup_le ((Ideal.span_singleton_le_iff_mem (v₀.asIdeal ^ k)).mpr hb_mem)
          (Ideal.pow_le_pow_right (Nat.le_succ k))
      obtain ⟨J, hIJ⟩ := Ideal.dvd_iff_le.mpr hI_le
      obtain ⟨C, hIC⟩ := Ideal.dvd_iff_le.mpr (le_sup_right : v₀.asIdeal ^ (k + 1) ≤ I)
      have hvk_ne : (v₀.asIdeal ^ k : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := pow_ne_zero k v₀.ne_bot
      have hv_eq : v₀.asIdeal = J * C := by
        apply mul_left_cancel₀ hvk_ne
        calc v₀.asIdeal ^ k * v₀.asIdeal
          _ = v₀.asIdeal ^ (k + 1) := (pow_succ v₀.asIdeal k).symm
          _ = I * C := hIC
          _ = (v₀.asIdeal ^ k * J) * C := by rw [hIJ]
          _ = v₀.asIdeal ^ k * (J * C) := mul_assoc _ _ _
      have hvJ : v₀.asIdeal ≤ J := Ideal.dvd_iff_le.mp ⟨C, hv_eq⟩
      have hJ_top : J = ⊤ := by
        by_contra hJ
        have hvJ_eq : v₀.asIdeal = J := v₀.isMaximal.eq_of_le hJ hvJ
        have hI_k1 : I = v₀.asIdeal ^ (k + 1) := by
          rw [hIJ, ← hvJ_eq, ← pow_succ]
        have hb_in_I : b ∈ I := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton b))
        rw [hI_k1] at hb_in_I
        exact hb_not_mem hb_in_I
      rw [hIJ, hJ_top, Ideal.mul_top]
    have ha_in_sup : a ∈ Ideal.span {b} ⊔ v₀.asIdeal ^ (k + 1) := by
      rwa [hI_eq]
    obtain ⟨y, hy, m, hm, hym⟩ := Submodule.mem_sup.mp ha_in_sup
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hy
    have harb_mem : a - r * b ∈ v₀.asIdeal ^ (k + 1) := by
      have h_eq : a - r * b = m := by
        rw [← hym]
        ring
      rwa [h_eq]
    have harb_lt : v₀.intValuation (a - r * b) < v₀.intValuation b := by
      have hle := (v₀.intValuation_le_pow_iff_mem (a - r * b) (k + 1)).mpr harb_mem
      have hlt : WithZero.exp (-((k + 1 : ℕ) : ℤ)) < WithZero.exp (-(k : ℤ)) := by
        rw [WithZero.exp_lt_exp]
        omega
      rw [hb_exp]
      exact lt_of_le_of_lt hle hlt
    have hbK_ne : (algebraMap (NumberField.RingOfIntegers K) K b) ≠ 0 :=
      (map_ne_zero_iff (algebraMap (NumberField.RingOfIntegers K) K)
        (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hb0
    have hxr_eq : x - (r : K) =
        algebraMap (NumberField.RingOfIntegers K) K (a - r * b) /
        algebraMap (NumberField.RingOfIntegers K) K b := by
      change x - algebraMap (NumberField.RingOfIntegers K) K r = _
      rw [← hab, map_sub, map_mul, sub_div, mul_div_cancel_right₀ _ hbK_ne]
    have hxr_val_lt : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) (x - (r : K)) < 1 := by
      rw [hxr_eq, Valuation.map_div, hval_int (a - r * b), hval_int b]
      have hb_pos : 0 < v₀.intValuation b := by
        rw [hb_exp]
        exact WithZero.exp_pos
      rw [div_lt_iff₀ hb_pos, one_mul]
      exact harb_lt
    have hxr_L_lt : Valued.v (algebraMap K (v₀.adicCompletion K) x - algebraMap K (v₀.adicCompletion K) (r : K)) < 1 := by
      rw [← map_sub, hval_adic (x - (r : K))]
      exact hxr_val_lt
    have hur_lt : Valued.v (u - algebraMap K (v₀.adicCompletion K) (r : K)) < 1 := by
      have h_add : u - algebraMap K (v₀.adicCompletion K) (r : K) =
          (u - algebraMap K (v₀.adicCompletion K) x) +
          (algebraMap K (v₀.adicCompletion K) x - algebraMap K (v₀.adicCompletion K) (r : K)) := by ring
      rw [h_add]
      exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hu_x_lt hxr_L_lt)
    exact ⟨r, hur_lt⟩
  refine ⟨u₀, hu₀_not_mem, ?_⟩
  intro π hsub
  have hπ_not_mem : π ∉ v₀.asIdeal := by
    intro hπ_mem
    apply hu₀_not_mem
    have h_eq : u₀ = π - (π - u₀) := by ring
    rw [h_eq]
    exact v₀.asIdeal.sub_mem hπ_mem hsub
  have hπ_nsq_mod : ∀ s : NumberField.RingOfIntegers K, π - s ^ 2 ∉ v₀.asIdeal := by
    intro s hs_mem
    apply hu₀_nsq s
    have h_eq : u₀ - s ^ 2 = (π - s ^ 2) - (π - u₀) := by ring
    rw [h_eq]
    exact v₀.asIdeal.sub_mem hs_mem hsub
  rintro ⟨y, hy⟩
  have hπ_val : Valued.v (algebraMap K (v₀.adicCompletion K) (π : K)) = 1 := by
    rw [hval_adic (π : K), hval_int π]
    exact v₀.intValuation_eq_one_iff.mpr hπ_not_mem
  have hy_mul : Valued.v y * Valued.v y = 1 := by
    rw [← Valuation.map_mul, ← hy, hπ_val]
  have hy_ne : Valued.v y ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hy_mul
    exact zero_ne_one hy_mul
  obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hy_ne
  have hg_mul : g * g = 1 := by
    apply WithZero.coe_inj.mp
    rw [WithZero.coe_mul, hg, hy_mul, WithZero.coe_one]
  have hg_add : Multiplicative.toAdd g + Multiplicative.toAdd g = 0 := by
    have h1 := congrArg Multiplicative.toAdd hg_mul
    rwa [toAdd_mul, toAdd_one] at h1
  have hg_zero : Multiplicative.toAdd g = 0 := by omega
  have hg_one : g = 1 := Multiplicative.toAdd.injective (hg_zero.trans toAdd_one.symm)
  have hvy : Valued.v y = 1 := by
    rw [← hg, hg_one, WithZero.coe_one]
  obtain ⟨s, hs_lt⟩ := happrox y hvy
  have hs_val_le : Valued.v (algebraMap K (v₀.adicCompletion K) (s : K)) ≤ 1 := by
    rw [hval_adic (s : K)]
    exact v₀.valuation_le_one s
  have hplus_le : Valued.v (y + algebraMap K (v₀.adicCompletion K) (s : K)) ≤ 1 := by
    calc Valued.v (y + algebraMap K (v₀.adicCompletion K) (s : K))
      _ ≤ max (Valued.v y) (Valued.v (algebraMap K (v₀.adicCompletion K) (s : K))) :=
          Valuation.map_add _ _ _
      _ ≤ 1 := max_le (le_of_eq hvy) hs_val_le
  obtain ⟨d, hd⟩ : ∃ d : NumberField.RingOfIntegers K, d = π - s ^ 2 := ⟨π - s ^ 2, rfl⟩
  have hdiff_eq : algebraMap K (v₀.adicCompletion K) (d : K) =
      (y - algebraMap K (v₀.adicCompletion K) (s : K)) *
      (y + algebraMap K (v₀.adicCompletion K) (s : K)) := by
    have hcast : (d : K) = (π : K) - (s : K) ^ 2 := by rw [hd]; push_cast; rfl
    rw [hcast, map_sub, map_pow, hy]
    ring
  have hdiff_lt : Valued.v (algebraMap K (v₀.adicCompletion K) (d : K)) < 1 := by
    rw [hdiff_eq, Valuation.map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_right' hplus_le) hs_lt
  have hint_lt : v₀.intValuation d < 1 := by
    rwa [hval_adic (d : K), hval_int d] at hdiff_lt
  have hd_mem : d ∈ v₀.asIdeal :=
    (v₀.intValuation_lt_one_iff_mem d).mp hint_lt
  rw [hd] at hd_mem
  exact hπ_nsq_mod s hd_mem

theorem exists_crt_target_for_aux_prime (K : Type u) [Field K] [NumberField K]
    (F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
    (∃ q_even : Ideal (NumberField.RingOfIntegers K),
      q_even ≠ 0 ∧
      IsUnit (Ideal.Quotient.mk q_even (1 : NumberField.RingOfIntegers K)) ∧
      ∀ π : NumberField.RingOfIntegers K, π - 1 ∈ q_even →
        (∀ w ∈ F, ∃ z ∈ w.asIdeal, π = 1 + 4 * z) ∧
        (∀ w ∈ F, π ∉ w.asIdeal)) ∧
    (∀ (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
       (u₀ : NumberField.RingOfIntegers K),
      v₀ ∉ F →
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 2 = 1 →
      u₀ ∉ v₀.asIdeal →
      ∃ (q_odd : Ideal (NumberField.RingOfIntegers K))
        (α : NumberField.RingOfIntegers K),
        q_odd ≠ 0 ∧
        IsUnit (Ideal.Quotient.mk q_odd α) ∧
        ∀ π : NumberField.RingOfIntegers K, π - α ∈ q_odd →
          π - u₀ ∈ v₀.asIdeal ∧
          π ∉ v₀.asIdeal ∧
          (∀ w ∈ F, ∃ z ∈ w.asIdeal, π = 1 + 4 * z) ∧
          (∀ w ∈ F, π ∉ w.asIdeal)) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let I₂ : Ideal R := Ideal.span {(4 : R)} * ∏ w ∈ F, w.asIdeal
  have h4_ne : (4 : R) ≠ 0 := by norm_num
  have hspan4_ne : Ideal.span {(4 : R)} ≠ (0 : Ideal R) :=
    Ideal.span_singleton_eq_bot.not.mpr h4_ne
  have hprod_ne : (∏ w ∈ F, w.asIdeal) ≠ (0 : Ideal R) :=
    Finset.prod_ne_zero_iff.mpr (fun w _ => w.ne_bot)
  have hI₂_ne : I₂ ≠ 0 := mul_ne_zero hspan4_ne hprod_ne
  have hI₂_prop : ∀ π : R, π - 1 ∈ I₂ →
      (∀ w ∈ F, ∃ z ∈ w.asIdeal, π = 1 + 4 * z) ∧
      (∀ w ∈ F, π ∉ w.asIdeal) := by
    intro π hπ
    have h₁ : ∀ w ∈ F, ∃ z ∈ w.asIdeal, π = 1 + 4 * z := by
      intro w hw
      have hprod_le_w : (∏ v ∈ F, v.asIdeal) ≤ w.asIdeal :=
        Ideal.prod_le_inf.trans (Finset.inf_le hw)
      have hI₂_le_w : I₂ ≤ Ideal.span {(4 : R)} * w.asIdeal :=
        Ideal.mul_mono_right hprod_le_w
      obtain ⟨z, hz, hz_eq⟩ := Ideal.mem_span_singleton_mul.mp (hI₂_le_w hπ)
      exact ⟨z, hz, by linear_combination -hz_eq⟩
    refine ⟨h₁, ?_⟩
    intro w hw hπ_in_w
    obtain ⟨z, hz, hπ_eq⟩ := h₁ w hw
    have h4z_in_w : (4 : R) * z ∈ w.asIdeal := Ideal.mul_mem_left w.asIdeal 4 hz
    have h1_in_w : (1 : R) ∈ w.asIdeal := by
      have hsub : π - 4 * z ∈ w.asIdeal := Ideal.sub_mem w.asIdeal hπ_in_w h4z_in_w
      have h1_eq : (1 : R) = π - 4 * z := by linear_combination -hπ_eq
      rwa [← h1_eq] at hsub
    exact w.isPrime.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_in_w)
  have hcop_max_span : ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (x : R),
      x ∉ v.asIdeal → IsCoprime v.asIdeal (Ideal.span {x}) := by
    intro v x hx
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    have h_eq : v.asIdeal = v.asIdeal ⊔ Ideal.span {x} :=
      v.isMaximal.eq_of_le h_ne_top le_sup_left
    have h_le : Ideal.span {x} ≤ v.asIdeal := by
      rw [h_eq]
      exact le_sup_right
    exact hx (h_le (Ideal.mem_span_singleton_self x))
  refine ⟨⟨I₂, hI₂_ne, by rw [map_one]; exact isUnit_one, hI₂_prop⟩, ?_⟩
  intro v₀ u₀ hv₀F h2 hu₀
  let I₁ : Ideal R := v₀.asIdeal
  have h2_not_mem : (2 : R) ∉ I₁ := by
    have h2_coe : (2 : K) = ((2 : R) : K) := by push_cast; rfl
    rw [h2_coe, v₀.valuation_of_algebraMap, v₀.intValuation_eq_one_iff] at h2
    exact h2
  have h4_not_mem : (4 : R) ∉ I₁ := by
    intro h4_mem
    have h22 : (2 : R) * (2 : R) ∈ I₁ := by
      have heq : (2 : R) * (2 : R) = (4 : R) := by norm_num
      rwa [heq]
    rcases v₀.isPrime.mul_mem_iff_mem_or_mem.mp h22 with h | h <;> exact h2_not_mem h
  have hcop_4 : IsCoprime I₁ (Ideal.span {(4 : R)}) :=
    hcop_max_span v₀ (4 : R) h4_not_mem
  have hcop_prod : IsCoprime I₁ (∏ w ∈ F, w.asIdeal) := by
    apply IsCoprime.prod_right
    intro w hw
    have hv₀w : v₀ ≠ w := by
      rintro rfl
      exact hv₀F hw
    have hI₁w_ne : I₁ ≠ w.asIdeal :=
      fun h => hv₀w (IsDedekindDomain.HeightOneSpectrum.ext h)
    exact @Ideal.isCoprime_of_isMaximal _ _ _ _ v₀.isMaximal w.isMaximal hI₁w_ne
  have hcop_12 : IsCoprime I₁ I₂ := IsCoprime.mul_right hcop_4 hcop_prod
  let q_odd : Ideal R := I₁ * I₂
  have hq_odd_ne : q_odd ≠ 0 := mul_ne_zero v₀.ne_bot hI₂_ne
  obtain ⟨b₁, hb₁, b₂, hb₂, hb⟩ := Ideal.isCoprime_iff_exists.mp hcop_12
  let α : R := u₀ * b₂ + b₁
  have hα_1 : α - u₀ ∈ I₁ := by
    have heq : α - u₀ = (1 - u₀) * b₁ := by
      dsimp [α]
      linear_combination u₀ * hb
    rw [heq]
    exact Ideal.mul_mem_left I₁ (1 - u₀) hb₁
  have hα_2 : α - 1 ∈ I₂ := by
    have heq : α - 1 = (u₀ - 1) * b₂ := by
      dsimp [α]
      linear_combination hb
    rw [heq]
    exact Ideal.mul_mem_left I₂ (u₀ - 1) hb₂
  have hα_not_1 : α ∉ I₁ := by
    intro hα_in_1
    apply hu₀
    have heq : u₀ = α - (α - u₀) := by ring
    rw [heq]
    exact Ideal.sub_mem I₁ hα_in_1 hα_1
  have hcop_α1 : IsCoprime (Ideal.span {α}) I₁ :=
    (hcop_max_span v₀ α hα_not_1).symm
  have hcop_α2 : IsCoprime (Ideal.span {α}) I₂ := by
    rw [Ideal.isCoprime_iff_exists]
    refine ⟨α, Ideal.mem_span_singleton_self α, 1 - α, ?_, add_sub_cancel α 1⟩
    have heq : 1 - α = -(α - 1) := by ring
    rw [heq]
    exact Submodule.neg_mem I₂ hα_2
  have hcop_α_q : IsCoprime (Ideal.span {α}) q_odd :=
    IsCoprime.mul_right hcop_α1 hcop_α2
  have hunit : IsUnit (Ideal.Quotient.mk q_odd α) := by
    obtain ⟨x, hx, y, hy, hxy⟩ := Ideal.isCoprime_iff_exists.mp hcop_α_q
    obtain ⟨β, rfl⟩ := Ideal.mem_span_singleton.mp hx
    apply IsUnit.of_mul_eq_one (Ideal.Quotient.mk q_odd β)
    rw [← map_mul, ← map_one (Ideal.Quotient.mk q_odd), Ideal.Quotient.eq]
    have heq : α * β - 1 = -y := by linear_combination hxy
    rw [heq]
    exact Submodule.neg_mem q_odd hy
  refine ⟨q_odd, α, hq_odd_ne, hunit, ?_⟩
  intro π hπ
  have hq_le_1 : q_odd ≤ I₁ := Ideal.mul_le_right
  have hq_le_2 : q_odd ≤ I₂ := Ideal.mul_le_left
  have hπ_1 : π - u₀ ∈ I₁ := by
    have heq : π - u₀ = (π - α) + (α - u₀) := by ring
    rw [heq]
    exact Ideal.add_mem I₁ (hq_le_1 hπ) hα_1
  have hπ_not_1 : π ∉ I₁ := by
    intro hπ_in_1
    apply hu₀
    have heq : u₀ = π - (π - u₀) := by ring
    rw [heq]
    exact Ideal.sub_mem I₁ hπ_in_1 hπ_1
  have hπ_2 : π - 1 ∈ I₂ := by
    have heq : π - 1 = (π - α) + (α - 1) := by ring
    rw [heq]
    exact Ideal.add_mem I₂ (hq_le_2 hπ) hα_2
  obtain ⟨hπ_F_eq, hπ_F_not_mem⟩ := hI₂_prop π hπ_2
  exact ⟨hπ_1, hπ_not_1, hπ_F_eq, hπ_F_not_mem⟩

theorem exists_two_neg_real_prime_of_mitsui (K : Type u) [Field K] [NumberField K]
    (w₁ w₂ : {w : NumberField.InfinitePlace K // w.IsReal})
    (q_mod : Ideal (NumberField.RingOfIntegers K))
    (α : NumberField.RingOfIntegers K)
    (hq_mod : q_mod ≠ 0)
    (hunit : IsUnit (Ideal.Quotient.mk q_mod α)) :
    ∃ (π : NumberField.RingOfIntegers K)
      (p₀ : Kˣ)
      (𝔭₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      π - α ∈ q_mod ∧
      (π : K) = (p₀ : K) ∧
      IsIntegral ℤ (p₀ : K) ∧
      𝔭₀.asIdeal = Ideal.span {π} ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K 𝔭₀ (p₀ : K) = WithZero.exp (-1 : ℤ) ∧
      (∀ v, v ≠ 𝔭₀ → IsDedekindDomain.HeightOneSpectrum.valuation K v (p₀ : K) = 1) ∧
      realPlaceEmb w₁ (p₀ : K) < 0 ∧
      realPlaceEmb w₂ (p₀ : K) < 0 ∧
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        w ≠ w₁ → w ≠ w₂ → 0 < realPlaceEmb w (p₀ : K)) :=
by
  classical
  letI : MulAction ℝ (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.mulActionSet
  let C₁ : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    (Set.univ.pi (fun w =>
      if w = w₁ ∨ w = w₂ then Set.Ioo (-3 / 4 : ℝ) (-1 / 4 : ℝ)
      else Set.Ioo (1 / 4 : ℝ) (3 / 4 : ℝ))) ×ˢ
    (Set.univ.pi (fun _ => Metric.ball (0 : ℂ) (3 / 4 : ℝ)))
  have hconv : Convex ℝ C₁ := by
    apply Convex.prod
    · apply convex_pi
      intro w _
      split_ifs <;> exact convex_Ioo _ _
    · apply convex_pi
      intro w _
      exact convex_ball _ _
  have hopen : IsOpen C₁ := by
    apply IsOpen.prod
    · apply isOpen_set_pi (Set.toFinite Set.univ)
      intro w _
      split_ifs <;> exact isOpen_Ioo
    · apply isOpen_set_pi (Set.toFinite Set.univ)
      intro w _
      exact Metric.isOpen_ball
  have hbdd : Bornology.IsBounded C₁ := by
    apply Bornology.IsBounded.prod
    · rw [Bornology.isBounded_pi]
      right
      intro w
      split_ifs <;> exact Metric.isBounded_Ioo _ _
    · rw [Bornology.isBounded_pi]
      right
      intro w
      exact Metric.isBounded_ball
  have hne_C₁ : C₁.Nonempty := by
    refine ⟨(fun w => if w = w₁ ∨ w = w₂ then (-1 / 2 : ℝ) else (1 / 2 : ℝ),
      fun _ => (0 : ℂ)), ?_, ?_⟩
    · intro w _
      dsimp
      split_ifs <;> constructor <;> norm_num
    · intro w _
      exact Metric.mem_ball_self (by norm_num)
  have hv₀ : 0 < (MeasureTheory.volume C₁).toReal := by
    have hpos : 0 < MeasureTheory.volume C₁ :=
      IsOpen.measure_pos MeasureTheory.volume hopen hne_C₁
    have hlt : MeasureTheory.volume C₁ < ⊤ :=
      Bornology.IsBounded.measure_lt_top hbdd
    exact ENNReal.toReal_pos (ne_of_gt hpos) (ne_of_lt hlt)
  have hnorm1 : ∀ u ∈ C₁, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w u < 1 := by
    intro u hu w
    by_cases hw : w.IsReal
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw u]
      have hu1 := hu.1 ⟨w, hw⟩ (Set.mem_univ _)
      dsimp at hu1
      split_ifs at hu1 <;>
      · rw [Real.norm_eq_abs, abs_lt]
        exact ⟨by linarith [hu1.1], by linarith [hu1.2]⟩
    · have hwc : w.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hwc u]
      have hu2 := hu.2 ⟨w, hwc⟩ (Set.mem_univ _)
      dsimp at hu2
      rw [mem_ball_zero_iff] at hu2
      linarith
  have hC₁_scale : ∀ X : ℝ, 0 < X →
      Convex ℝ (X • C₁) ∧
      IsOpen (X • C₁) ∧
      (∀ z ∈ X • C₁, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X) ∧
      (MeasureTheory.volume (X • C₁)).toReal =
        X ^ (Module.finrank ℚ K) * (MeasureTheory.volume C₁).toReal := by
    intro X hX
    refine ⟨Convex.smul hconv X, IsOpen.smul₀ hopen (ne_of_gt hX), ?_, ?_⟩
    · intro z hz w
      rw [Set.mem_smul_set] at hz
      rcases hz with ⟨u, hu, rfl⟩
      rw [NumberField.mixedEmbedding.normAtPlace_smul w u X, abs_of_pos hX]
      exact mul_lt_of_lt_one_right hX (hnorm1 u hu w)
    · rw [MeasureTheory.Measure.addHaar_smul MeasureTheory.volume X C₁,
        NumberField.mixedEmbedding.finrank K]
      have hXpow : 0 < X ^ (Module.finrank ℚ K) := pow_pos hX _
      rw [abs_of_pos hXpow, ENNReal.toReal_mul, ENNReal.toReal_ofReal (le_of_lt hXpow)]
  have hC₁_sign : ∀ (X : ℝ) (x : K), 0 < X →
      NumberField.mixedEmbedding K x ∈ X • C₁ →
      realPlaceEmb w₁ x < 0 ∧
      realPlaceEmb w₂ x < 0 ∧
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        w ≠ w₁ → w ≠ w₂ → 0 < realPlaceEmb w x) := by
    intro X x hX hx
    rw [Set.mem_smul_set] at hx
    rcases hx with ⟨u, hu, hxu⟩
    have hreal : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        realPlaceEmb w x = X * u.1 w := by
      intro w
      have h1 : realPlaceEmb w x = (NumberField.mixedEmbedding K x).1 w :=
        (NumberField.mixedEmbedding.mixedEmbedding_apply_isReal K x w).symm
      rw [h1, ← hxu]
      rfl
    refine ⟨?_, ?_, ?_⟩
    · rw [hreal w₁]
      have huw₁ := hu.1 w₁ (Set.mem_univ _)
      dsimp at huw₁
      rw [if_pos (Or.inl rfl)] at huw₁
      exact mul_neg_of_pos_of_neg hX (by linarith [huw₁.2])
    · rw [hreal w₂]
      have huw₂ := hu.1 w₂ (Set.mem_univ _)
      dsimp at huw₂
      rw [if_pos (Or.inr rfl)] at huw₂
      exact mul_neg_of_pos_of_neg hX (by linarith [huw₂.2])
    · intro w hw₁ hw₂
      rw [hreal w]
      have huw := hu.1 w (Set.mem_univ _)
      dsimp at huw
      rw [if_neg (not_or.mpr ⟨hw₁, hw₂⟩)] at huw
      exact mul_pos hX (by linarith [huw.1])
  obtain ⟨κ, c, hc, hκ, hmitsui⟩ := mitsui_prime_ideal (K := K) 2 (by norm_num)
  have hκq : 0 < κ q_mod := hκ q_mod hq_mod
  let v₀ : ℝ := (MeasureTheory.volume C₁).toReal
  let Nq : ℝ := (Ideal.absNorm q_mod : ℝ)
  let t : ℝ := max 1 (max (Nq + 1) (2 * c ^ 2 / (κ q_mod * v₀) + 1))
  have ht1 : 1 ≤ t := le_max_left _ _
  have htNq : Nq + 1 ≤ t := le_trans (le_max_left _ _) (le_max_right _ _)
  have htc : 2 * c ^ 2 / (κ q_mod * v₀) + 1 ≤ t := le_trans (le_max_right _ _) (le_max_right _ _)
  have ht_pos : 0 < t := by linarith
  let X : ℝ := Real.exp (t ^ 2)
  have hX1 : 1 < X := Real.one_lt_exp_iff.mpr (by positivity)
  have hX_pos : 0 < X := by linarith
  have hlogX : Real.log X = t ^ 2 := Real.log_exp (t ^ 2)
  have hNq_lt : (Ideal.absNorm q_mod : ℝ) < Real.log X ^ (2 : ℕ) := by
    rw [hlogX]
    have ht2 : 1 ≤ t ^ 2 := by nlinarith [ht1]
    have ht_le_t4 : t ≤ (t ^ 2) ^ 2 := by nlinarith [ht1, ht2]
    linarith
  have hsqrt : Real.sqrt (Real.log X) = t := by
    rw [hlogX, Real.sqrt_sq (le_of_lt ht_pos)]
  have herr_small : c * Real.exp (-Real.sqrt (Real.log X) / c) < κ q_mod * v₀ / 2 := by
    rw [hsqrt, neg_div, Real.exp_neg]
    have hkv_pos : 0 < κ q_mod * v₀ := mul_pos hκq hv₀
    have hexp_pos : 0 < Real.exp (t / c) := Real.exp_pos (t / c)
    have h_div_lt : 2 * c ^ 2 / (κ q_mod * v₀) < t := by linarith
    have h_tc_gt : 2 * c / (κ q_mod * v₀) < t / c := by
      have h1 : 2 * c / (κ q_mod * v₀) * c < t := by
        calc 2 * c / (κ q_mod * v₀) * c = 2 * c ^ 2 / (κ q_mod * v₀) := by ring
        _ < t := h_div_lt
      exact (lt_div_iff₀ hc).mpr h1
    have hexp_gt : 2 * c / (κ q_mod * v₀) < Real.exp (t / c) := by
      have h_add := Real.add_one_le_exp (t / c)
      linarith
    have h_mul : c < (κ q_mod * v₀ / 2) * Real.exp (t / c) := by
      have h2 : (κ q_mod * v₀ / 2) * (2 * c / (κ q_mod * v₀)) < (κ q_mod * v₀ / 2) * Real.exp (t / c) :=
        mul_lt_mul_of_pos_left hexp_gt (by positivity)
      have hkv_ne : κ q_mod * v₀ ≠ 0 := ne_of_gt hkv_pos
      have h3 : (κ q_mod * v₀ / 2) * (2 * c / (κ q_mod * v₀)) = c := by
        calc (κ q_mod * v₀ / 2) * (2 * c / (κ q_mod * v₀))
          _ = c * ((κ q_mod * v₀) / (κ q_mod * v₀)) := by ring
          _ = c * 1 := by rw [div_self hkv_ne]
          _ = c := mul_one c
      linarith
    calc c * (Real.exp (t / c))⁻¹ = c / Real.exp (t / c) := div_eq_mul_inv c _ |>.symm
      _ < κ q_mod * v₀ / 2 := (div_lt_iff₀ hexp_pos).mpr h_mul
  obtain ⟨hconv_X, hopen_X, hnorm_X, hvol_X⟩ := hC₁_scale X hX_pos
  have hbound := hmitsui X hX1 (X • C₁) hconv_X hopen_X hnorm_X q_mod hq_mod hNq_lt α hunit
  let S_X := {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ X • C₁ ∧ π - α ∈ q_mod}
  let S_sum : ℝ := ∑' π : S_X,
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  change |S_sum - κ q_mod * (MeasureTheory.volume (X • C₁)).toReal| ≤
      c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) at hbound
  rw [hvol_X] at hbound
  have hXpow : 0 < X ^ (Module.finrank ℚ K) := pow_pos hX_pos _
  have hS_pos : 0 < S_sum := by
    have hlow := (abs_sub_le_iff.mp hbound).2
    have h_diff : c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) <
        (κ q_mod * v₀ / 2) * X ^ (Module.finrank ℚ K) := by
      calc c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c)
        _ = (c * Real.exp (-Real.sqrt (Real.log X) / c)) * X ^ (Module.finrank ℚ K) := by ring
        _ < (κ q_mod * v₀ / 2) * X ^ (Module.finrank ℚ K) := mul_lt_mul_of_pos_right herr_small hXpow
    have hmain_pos : 0 < (κ q_mod * v₀ / 2) * X ^ (Module.finrank ℚ K) := by positivity
    linarith
  have hne_S : Nonempty S_X := by
    by_contra hemp
    rw [not_nonempty_iff] at hemp
    have hzero : S_sum = 0 := by
      dsimp [S_sum]
      exact tsum_empty
    linarith
  obtain ⟨⟨π, hπ_prime, hπ_mem, hπ_mod⟩⟩ := hne_S
  have hπ_ne : π ≠ 0 := hπ_prime.ne_zero
  have hπK_ne : (π : K) ≠ 0 := by
    intro h0
    exact hπ_ne (by exact_mod_cast h0)
  let p₀ : Kˣ := Units.mk0 (π : K) hπK_ne
  have hπ_coe : (π : K) = (p₀ : K) := rfl
  have hp₀_int : IsIntegral ℤ (p₀ : K) := NumberField.RingOfIntegers.isIntegral_coe π
  let 𝔭₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    ⟨Ideal.span {π}, (Ideal.span_singleton_prime hπ_ne).mpr hπ_prime,
      Ideal.span_singleton_eq_bot.not.mpr hπ_ne⟩
  have h𝔭₀_span : 𝔭₀.asIdeal = Ideal.span {π} := rfl
  have hp₀_val_eq : IsDedekindDomain.HeightOneSpectrum.valuation K 𝔭₀ (p₀ : K) =
      WithZero.exp (-1 : ℤ) := by
    have hval_eq : IsDedekindDomain.HeightOneSpectrum.valuation K 𝔭₀ (p₀ : K) =
        𝔭₀.intValuation π :=
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap 𝔭₀ π
    rw [hval_eq]
    have hdvd1 : 𝔭₀.asIdeal ^ 1 ∣ Ideal.span {π} := by
      rw [pow_one, ← h𝔭₀_span]
    have hndvd2 : ¬ (𝔭₀.asIdeal ^ 2 ∣ Ideal.span {π}) := by
      rw [sq, ← h𝔭₀_span]
      intro hdvd
      have hdvd' : 𝔭₀.asIdeal * 𝔭₀.asIdeal ∣ 𝔭₀.asIdeal * 1 := by simpa using hdvd
      have h1 : 𝔭₀.asIdeal ∣ 1 := (mul_dvd_mul_iff_left 𝔭₀.ne_bot).mp hdvd'
      rw [Ideal.dvd_iff_le, Ideal.one_eq_top] at h1
      exact 𝔭₀.isPrime.ne_top (top_le_iff.mp h1)
    have hle1 : 𝔭₀.intValuation π ≤ WithZero.exp (-(1 : ℕ) : ℤ) :=
      (𝔭₀.intValuation_le_pow_iff_dvd π 1).mpr hdvd1
    have hnle2 : ¬ (𝔭₀.intValuation π ≤ WithZero.exp (-(2 : ℕ) : ℤ)) :=
      mt (𝔭₀.intValuation_le_pow_iff_dvd π 2).mp hndvd2
    have hne0 : 𝔭₀.intValuation π ≠ 0 :=
      𝔭₀.intValuation_ne_zero' ⟨π, mem_nonZeroDivisors_of_ne_zero hπ_ne⟩
    obtain ⟨z, hz⟩ := WithZero.ne_zero_iff_exists.mp hne0
    rw [← hz] at hle1 hnle2 ⊢
    change WithZero.exp (Multiplicative.toAdd z) ≤ WithZero.exp (-1 : ℤ) at hle1
    change ¬ (WithZero.exp (Multiplicative.toAdd z) ≤ WithZero.exp (-2 : ℤ)) at hnle2
    rw [WithZero.exp_le_exp] at hle1 hnle2
    have hz_eq : Multiplicative.toAdd z = -1 := by omega
    rw [← hz_eq]
    rfl
  have hp₀_val_ne : ∀ v, v ≠ 𝔭₀ →
      IsDedekindDomain.HeightOneSpectrum.valuation K v (p₀ : K) = 1 := by
    intro v hv
    have hval_eq : IsDedekindDomain.HeightOneSpectrum.valuation K v (p₀ : K) =
        v.intValuation π :=
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap v π
    rw [hval_eq]
    have hndvd : ¬ (v.asIdeal ∣ Ideal.span {π}) := by
      rw [← h𝔭₀_span, Ideal.dvd_iff_le]
      intro hle
      have heq : 𝔭₀.asIdeal = v.asIdeal := 𝔭₀.isMaximal.eq_of_le v.isPrime.ne_top hle
      exact hv (IsDedekindDomain.HeightOneSpectrum.ext heq).symm
    have hnlt : ¬ (v.intValuation π < 1) :=
      mt (v.intValuation_lt_one_iff_dvd π).mp hndvd
    exact le_antisymm (v.intValuation_le_one π) (not_lt.mp hnlt)
  obtain ⟨hw₁_neg, hw₂_neg, hw_pos⟩ := hC₁_sign X (π : K) hX_pos hπ_mem
  exact ⟨π, p₀, 𝔭₀, hπ_mod, hπ_coe, hp₀_int, h𝔭₀_span, hp₀_val_eq, hp₀_val_ne,
    hw₁_neg, hw₂_neg, hw_pos⟩

theorem exists_raw_auxiliary_primes (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hdisj₂ : Disjoint S₂ T) :
    ∃ (p : Fin 6 → Kˣ)
      (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsRawAuxiliaryPrimeTuple K τ T S₂ p 𝔭 :=
by
  classical
  rcases hstart with ⟨_, _, _, _, _, _, hint₁, hint₂, hint₃, _, hτ_inj, _⟩
  let a₁_int : NumberField.RingOfIntegers K := ⟨a₁, hint₁⟩
  let a₂_int : NumberField.RingOfIntegers K := ⟨a₂, hint₂⟩
  let a₃_int : NumberField.RingOfIntegers K := ⟨a₃, hint₃⟩
  let D₀ : NumberField.RingOfIntegers K :=
    6 * (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int)
  have hD₀_coe : (D₀ : K) = 6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃) := by
    dsimp [D₀]; push_cast; rfl
  have h2_val_eq_one : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∉ T → (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1 := by
    intro v hvT
    have hD₀_not_mem : D₀ ∉ v.asIdeal := by
      intro hmem
      apply hvT
      rw [hT v, ← hD₀_coe, v.valuation_of_algebraMap D₀, ne_eq, v.intValuation_eq_one_iff, not_not]
      exact hmem
    have h2_not_mem : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
      intro h2
      apply hD₀_not_mem
      have hD₀_eq : D₀ = 2 * (3 * (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int)) := by
        dsimp [D₀]; ring
      rw [hD₀_eq]
      exact Ideal.mul_mem_right _ v.asIdeal h2
    have h1 : (2 : K) = ((2 : NumberField.RingOfIntegers K) : K) := by push_cast; rfl
    rw [h1, v.valuation_of_algebraMap, v.intValuation_eq_one_iff]
    exact h2_not_mem
  have arch_signs_of_two_neg : ∀ (k : Fin 6) (x : K),
      realPlaceEmb (τ ⟨k.1, by omega⟩) x < 0 →
      realPlaceEmb (τ ⟨k.1 + 6, by omega⟩) x < 0 →
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        w ≠ τ ⟨k.1, by omega⟩ → w ≠ τ ⟨k.1 + 6, by omega⟩ → 0 < realPlaceEmb w x) →
      (∀ j : Fin 6, realPlaceEmb (τ ⟨j.1, by omega⟩) x < 0 ↔ j = k) ∧
      (∀ j : Fin 6, realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) x < 0 ↔ j = k) ∧
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (∀ i : Fin 12, w ≠ τ i) → 0 < realPlaceEmb w x) := by
    intro k x hw₁ hw₂ hpos
    refine ⟨?_, ?_, ?_⟩
    · intro j
      constructor
      · intro hj_neg
        by_contra hjk
        have hne₁ : τ ⟨j.1, by omega⟩ ≠ τ ⟨k.1, by omega⟩ := by
          intro h
          have hval := congr_arg Fin.val (hτ_inj h)
          dsimp at hval
          exact hjk (Fin.ext hval)
        have hne₂ : τ ⟨j.1, by omega⟩ ≠ τ ⟨k.1 + 6, by omega⟩ := by
          intro h
          have hval := congr_arg Fin.val (hτ_inj h)
          dsimp at hval
          omega
        have hj_pos := hpos (τ ⟨j.1, by omega⟩) hne₁ hne₂
        linarith
      · rintro rfl
        exact hw₁
    · intro j
      constructor
      · intro hj_neg
        by_contra hjk
        have hne₁ : τ ⟨j.1 + 6, by omega⟩ ≠ τ ⟨k.1, by omega⟩ := by
          intro h
          have hval := congr_arg Fin.val (hτ_inj h)
          dsimp at hval
          omega
        have hne₂ : τ ⟨j.1 + 6, by omega⟩ ≠ τ ⟨k.1 + 6, by omega⟩ := by
          intro h
          have hval := congr_arg Fin.val (hτ_inj h)
          dsimp at hval
          have hjk' : j.1 = k.1 := by omega
          exact hjk (Fin.ext hjk')
        have hj_pos := hpos (τ ⟨j.1 + 6, by omega⟩) hne₁ hne₂
        linarith
      · rintro rfl
        exact hw₂
    · intro w hw
      exact hpos w (hw ⟨k.1, by omega⟩) (hw ⟨k.1 + 6, by omega⟩)
  have isSquare_of_one_add_four_mul : ∀ (π : NumberField.RingOfIntegers K) (p₀ : Kˣ)
      (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (π : K) = (p₀ : K) →
      (∃ z ∈ w.asIdeal, π = 1 + 4 * z) →
      IsSquare (algebraMap K (w.adicCompletion K) (p₀ : K)) := by
    intro π p₀ w hπ_coe ⟨z, hz_mem, hπ_eq⟩
    have hz_val : Valued.v (algebraMap K (w.adicCompletion K) (z : K)) ≤ WithZero.exp (-1 : ℤ) := by
      have h1 : Valued.v (algebraMap K (w.adicCompletion K) (z : K)) =
          (IsDedekindDomain.HeightOneSpectrum.valuation K w) (z : K) :=
        w.valuedAdicCompletion_eq_valuation' (z : K)
      rw [h1, w.valuation_of_algebraMap z]
      have h2 := (w.intValuation_le_pow_iff_mem z 1).mpr (by simpa using hz_mem)
      simpa using h2
    have hp₀_adic : algebraMap K (w.adicCompletion K) (p₀ : K) =
        1 + 4 * algebraMap K (w.adicCompletion K) (z : K) := by
      have hp₀_K : (p₀ : K) = 1 + 4 * (z : K) := by
        rw [← hπ_coe, hπ_eq]; push_cast; rfl
      rw [hp₀_K, map_add, map_one, map_mul, map_ofNat]
    rw [hp₀_adic]
    exact isSquare_one_add_four_mul_of_valuation_le K w
      (algebraMap K (w.adicCompletion K) (z : K)) hz_val
  have exists_even_step : ∀ (k : Fin 6)
      (F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))),
      ∃ (p₀ : Kˣ)
        (𝔭₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        𝔭₀ ∉ F ∧
        IsIntegral ℤ (p₀ : K) ∧
        IsDedekindDomain.HeightOneSpectrum.valuation K 𝔭₀ (p₀ : K) = WithZero.exp (-1 : ℤ) ∧
        (∀ v, v ≠ 𝔭₀ → IsDedekindDomain.HeightOneSpectrum.valuation K v (p₀ : K) = 1) ∧
        (∀ j : Fin 6, realPlaceEmb (τ ⟨j.1, by omega⟩) (p₀ : K) < 0 ↔ j = k) ∧
        (∀ j : Fin 6, realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) (p₀ : K) < 0 ↔ j = k) ∧
        (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (∀ i : Fin 12, w ≠ τ i) → 0 < realPlaceEmb w (p₀ : K)) ∧
        (∀ w ∈ F, IsSquare (algebraMap K (w.adicCompletion K) (p₀ : K))) := by
    intro k F
    obtain ⟨q_even, hq_even, hunit, hcrt⟩ := (exists_crt_target_for_aux_prime K F).1
    obtain ⟨π, p₀, 𝔭₀, hπ_mod, hπ_coe, hp₀_int, h𝔭₀_span, hp₀_val_eq, hp₀_val_ne,
      hw₁, hw₂, hpos⟩ :=
      exists_two_neg_real_prime_of_mitsui K (τ ⟨k.1, by omega⟩) (τ ⟨k.1 + 6, by omega⟩)
        q_even 1 hq_even hunit
    obtain ⟨hπ_F, hπ_not_F⟩ := hcrt π hπ_mod
    have hπ_in_𝔭₀ : π ∈ 𝔭₀.asIdeal := by
      rw [h𝔭₀_span]
      exact Ideal.mem_span_singleton_self π
    have h𝔭₀_not_F : 𝔭₀ ∉ F := by
      intro hmem
      exact hπ_not_F 𝔭₀ hmem hπ_in_𝔭₀
    obtain ⟨hsign₁, hsign₂, hsign_other⟩ := arch_signs_of_two_neg k (p₀ : K) hw₁ hw₂ hpos
    refine ⟨p₀, 𝔭₀, h𝔭₀_not_F, hp₀_int, hp₀_val_eq, hp₀_val_ne,
      hsign₁, hsign₂, hsign_other, ?_⟩
    intro w hwF
    exact isSquare_of_one_add_four_mul π p₀ w hπ_coe (hπ_F w hwF)
  have exists_odd_step : ∀ (k : Fin 6)
      (F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      T ⊆ F →
      v₀ ∉ F →
      ∃ (p₀ : Kˣ)
        (𝔭₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        𝔭₀ ∉ F ∧
        𝔭₀ ≠ v₀ ∧
        IsIntegral ℤ (p₀ : K) ∧
        IsDedekindDomain.HeightOneSpectrum.valuation K 𝔭₀ (p₀ : K) = WithZero.exp (-1 : ℤ) ∧
        (∀ v, v ≠ 𝔭₀ → IsDedekindDomain.HeightOneSpectrum.valuation K v (p₀ : K) = 1) ∧
        (∀ j : Fin 6, realPlaceEmb (τ ⟨j.1, by omega⟩) (p₀ : K) < 0 ↔ j = k) ∧
        (∀ j : Fin 6, realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) (p₀ : K) < 0 ↔ j = k) ∧
        (∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (∀ i : Fin 12, w ≠ τ i) → 0 < realPlaceEmb w (p₀ : K)) ∧
        (∀ w ∈ F, IsSquare (algebraMap K (w.adicCompletion K) (p₀ : K))) ∧
        ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (p₀ : K)) := by
    intro k F v₀ hTF hv₀F
    have hv₀T : v₀ ∉ T := fun h => hv₀F (hTF h)
    have h2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 2 = 1 :=
      h2_val_eq_one v₀ hv₀T
    obtain ⟨u₀, hu₀_not_mem, hu₀_nsq⟩ :=
      exists_nonSquare_adicCompletion_target_mod_ideal K v₀ h2
    obtain ⟨q_odd, α, hq_odd, hunit, hcrt⟩ :=
      (exists_crt_target_for_aux_prime K F).2 v₀ u₀ hv₀F h2 hu₀_not_mem
    obtain ⟨π, p₀, 𝔭₀, hπ_mod, hπ_coe, hp₀_int, h𝔭₀_span, hp₀_val_eq, hp₀_val_ne,
      hw₁, hw₂, hpos⟩ :=
      exists_two_neg_real_prime_of_mitsui K (τ ⟨k.1, by omega⟩) (τ ⟨k.1 + 6, by omega⟩)
        q_odd α hq_odd hunit
    obtain ⟨hπ_u₀, hπ_not_v₀, hπ_F, hπ_not_F⟩ := hcrt π hπ_mod
    have hπ_in_𝔭₀ : π ∈ 𝔭₀.asIdeal := by
      rw [h𝔭₀_span]
      exact Ideal.mem_span_singleton_self π
    have h𝔭₀_not_F : 𝔭₀ ∉ F := by
      intro hmem
      exact hπ_not_F 𝔭₀ hmem hπ_in_𝔭₀
    have h𝔭₀_ne_v₀ : 𝔭₀ ≠ v₀ := by
      intro h_eq
      apply hπ_not_v₀
      rw [← h_eq]
      exact hπ_in_𝔭₀
    obtain ⟨hsign₁, hsign₂, hsign_other⟩ := arch_signs_of_two_neg k (p₀ : K) hw₁ hw₂ hpos
    have hnsq_v₀ : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (p₀ : K)) := by
      rw [← hπ_coe]
      exact hu₀_nsq π hπ_u₀
    refine ⟨p₀, 𝔭₀, h𝔭₀_not_F, h𝔭₀_ne_v₀, hp₀_int, hp₀_val_eq, hp₀_val_ne,
      hsign₁, hsign₂, hsign_other, ?_, hnsq_v₀⟩
    intro w hwF
    exact isSquare_of_one_add_four_mul π p₀ w hπ_coe (hπ_F w hwF)
  let F₀ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) := T ∪ S₂
  have hT_F₀ : T ⊆ F₀ := Finset.subset_union_left
  obtain ⟨p₀, 𝔭₀, h𝔭₀_F₀, hp₀_int, hp₀_val_eq, hp₀_val_ne,
    hp₀_sign₁, hp₀_sign₂, hp₀_sign_other, hp₀_sq_F₀⟩ :=
    exists_even_step 0 F₀
  obtain ⟨p₁, 𝔭₁, h𝔭₁_F₀, h𝔭₁_ne_0, hp₁_int, hp₁_val_eq, hp₁_val_ne,
    hp₁_sign₁, hp₁_sign₂, hp₁_sign_other, hp₁_sq_F₀, hp₁_nsq_0⟩ :=
    exists_odd_step 1 F₀ 𝔭₀ hT_F₀ h𝔭₀_F₀
  let F₁ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    insert 𝔭₁ (insert 𝔭₀ F₀)
  have hF₀_F₁ : F₀ ⊆ F₁ :=
    (Finset.subset_insert 𝔭₀ F₀).trans (Finset.subset_insert 𝔭₁ (insert 𝔭₀ F₀))
  have hT_F₁ : T ⊆ F₁ := hT_F₀.trans hF₀_F₁
  obtain ⟨p₂, 𝔭₂, h𝔭₂_F₁, hp₂_int, hp₂_val_eq, hp₂_val_ne,
    hp₂_sign₁, hp₂_sign₂, hp₂_sign_other, hp₂_sq_F₁⟩ :=
    exists_even_step 2 F₁
  obtain ⟨p₃, 𝔭₃, h𝔭₃_F₁, h𝔭₃_ne_2, hp₃_int, hp₃_val_eq, hp₃_val_ne,
    hp₃_sign₁, hp₃_sign₂, hp₃_sign_other, hp₃_sq_F₁, hp₃_nsq_2⟩ :=
    exists_odd_step 3 F₁ 𝔭₂ hT_F₁ h𝔭₂_F₁
  let F₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    insert 𝔭₃ (insert 𝔭₂ F₁)
  have hF₁_F₂ : F₁ ⊆ F₂ :=
    (Finset.subset_insert 𝔭₂ F₁).trans (Finset.subset_insert 𝔭₃ (insert 𝔭₂ F₁))
  have hF₀_F₂ : F₀ ⊆ F₂ := hF₀_F₁.trans hF₁_F₂
  have hT_F₂ : T ⊆ F₂ := hT_F₁.trans hF₁_F₂
  obtain ⟨p₄, 𝔭₄, h𝔭₄_F₂, hp₄_int, hp₄_val_eq, hp₄_val_ne,
    hp₄_sign₁, hp₄_sign₂, hp₄_sign_other, hp₄_sq_F₂⟩ :=
    exists_even_step 4 F₂
  obtain ⟨p₅, 𝔭₅, h𝔭₅_F₂, h𝔭₅_ne_4, hp₅_int, hp₅_val_eq, hp₅_val_ne,
    hp₅_sign₁, hp₅_sign₂, hp₅_sign_other, hp₅_sq_F₂, hp₅_nsq_4⟩ :=
    exists_odd_step 5 F₂ 𝔭₄ hT_F₂ h𝔭₄_F₂
  have h𝔭₀_F₁ : 𝔭₀ ∈ F₁ := Finset.mem_insert_of_mem (Finset.mem_insert_self 𝔭₀ F₀)
  have h𝔭₁_F₁ : 𝔭₁ ∈ F₁ := Finset.mem_insert_self 𝔭₁ (insert 𝔭₀ F₀)
  have h𝔭₀_F₂ : 𝔭₀ ∈ F₂ := hF₁_F₂ h𝔭₀_F₁
  have h𝔭₁_F₂ : 𝔭₁ ∈ F₂ := hF₁_F₂ h𝔭₁_F₁
  have h𝔭₂_F₂ : 𝔭₂ ∈ F₂ := Finset.mem_insert_of_mem (Finset.mem_insert_self 𝔭₂ F₁)
  have h𝔭₃_F₂ : 𝔭₃ ∈ F₂ := Finset.mem_insert_self 𝔭₃ (insert 𝔭₂ F₁)
  have h𝔭₂_F₀ : 𝔭₂ ∉ F₀ := fun h => h𝔭₂_F₁ (hF₀_F₁ h)
  have h𝔭₃_F₀ : 𝔭₃ ∉ F₀ := fun h => h𝔭₃_F₁ (hF₀_F₁ h)
  have h𝔭₄_F₀ : 𝔭₄ ∉ F₀ := fun h => h𝔭₄_F₂ (hF₀_F₂ h)
  have h𝔭₅_F₀ : 𝔭₅ ∉ F₀ := fun h => h𝔭₅_F₂ (hF₀_F₂ h)
  have h𝔭₂_ne_0 : 𝔭₂ ≠ 𝔭₀ := fun h => h𝔭₂_F₁ (h ▸ h𝔭₀_F₁)
  have h𝔭₂_ne_1 : 𝔭₂ ≠ 𝔭₁ := fun h => h𝔭₂_F₁ (h ▸ h𝔭₁_F₁)
  have h𝔭₃_ne_0 : 𝔭₃ ≠ 𝔭₀ := fun h => h𝔭₃_F₁ (h ▸ h𝔭₀_F₁)
  have h𝔭₃_ne_1 : 𝔭₃ ≠ 𝔭₁ := fun h => h𝔭₃_F₁ (h ▸ h𝔭₁_F₁)
  have h𝔭₄_ne_0 : 𝔭₄ ≠ 𝔭₀ := fun h => h𝔭₄_F₂ (h ▸ h𝔭₀_F₂)
  have h𝔭₄_ne_1 : 𝔭₄ ≠ 𝔭₁ := fun h => h𝔭₄_F₂ (h ▸ h𝔭₁_F₂)
  have h𝔭₄_ne_2 : 𝔭₄ ≠ 𝔭₂ := fun h => h𝔭₄_F₂ (h ▸ h𝔭₂_F₂)
  have h𝔭₄_ne_3 : 𝔭₄ ≠ 𝔭₃ := fun h => h𝔭₄_F₂ (h ▸ h𝔭₃_F₂)
  have h𝔭₅_ne_0 : 𝔭₅ ≠ 𝔭₀ := fun h => h𝔭₅_F₂ (h ▸ h𝔭₀_F₂)
  have h𝔭₅_ne_1 : 𝔭₅ ≠ 𝔭₁ := fun h => h𝔭₅_F₂ (h ▸ h𝔭₁_F₂)
  have h𝔭₅_ne_2 : 𝔭₅ ≠ 𝔭₂ := fun h => h𝔭₅_F₂ (h ▸ h𝔭₂_F₂)
  have h𝔭₅_ne_3 : 𝔭₅ ≠ 𝔭₃ := fun h => h𝔭₅_F₂ (h ▸ h𝔭₃_F₂)
  let p : Fin 6 → Kˣ := ![p₀, p₁, p₂, p₃, p₄, p₅]
  let 𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    ![𝔭₀, 𝔭₁, 𝔭₂, 𝔭₃, 𝔭₄, 𝔭₅]
  refine ⟨p, 𝔭, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i j h_eq
    fin_cases i <;> fin_cases j <;>
      simp only [𝔭, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one] at h_eq ⊢
    · exact (h𝔭₁_ne_0 h_eq.symm).elim
    · exact (h𝔭₂_ne_0 h_eq.symm).elim
    · exact (h𝔭₃_ne_0 h_eq.symm).elim
    · exact (h𝔭₄_ne_0 h_eq.symm).elim
    · exact (h𝔭₅_ne_0 h_eq.symm).elim
    · exact (h𝔭₁_ne_0 h_eq).elim
    · exact (h𝔭₂_ne_1 h_eq.symm).elim
    · exact (h𝔭₃_ne_1 h_eq.symm).elim
    · exact (h𝔭₄_ne_1 h_eq.symm).elim
    · exact (h𝔭₅_ne_1 h_eq.symm).elim
    · exact (h𝔭₂_ne_0 h_eq).elim
    · exact (h𝔭₂_ne_1 h_eq).elim
    · exact (h𝔭₃_ne_2 h_eq.symm).elim
    · exact (h𝔭₄_ne_2 h_eq.symm).elim
    · exact (h𝔭₅_ne_2 h_eq.symm).elim
    · exact (h𝔭₃_ne_0 h_eq).elim
    · exact (h𝔭₃_ne_1 h_eq).elim
    · exact (h𝔭₃_ne_2 h_eq).elim
    · exact (h𝔭₄_ne_3 h_eq.symm).elim
    · exact (h𝔭₅_ne_3 h_eq.symm).elim
    · exact (h𝔭₄_ne_0 h_eq).elim
    · exact (h𝔭₄_ne_1 h_eq).elim
    · exact (h𝔭₄_ne_2 h_eq).elim
    · exact (h𝔭₄_ne_3 h_eq).elim
    · exact (h𝔭₅_ne_4 h_eq.symm).elim
    · exact (h𝔭₅_ne_0 h_eq).elim
    · exact (h𝔭₅_ne_1 h_eq).elim
    · exact (h𝔭₅_ne_2 h_eq).elim
    · exact (h𝔭₅_ne_3 h_eq).elim
    · exact (h𝔭₅_ne_4 h_eq).elim
  · intro k
    have hk_not_F₀ : 𝔭 k ∉ F₀ := by
      fin_cases k <;>
        simp only [𝔭, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
          Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
          Matrix.cons_val_fin_one]
      · exact h𝔭₀_F₀
      · exact h𝔭₁_F₀
      · exact h𝔭₂_F₀
      · exact h𝔭₃_F₀
      · exact h𝔭₄_F₀
      · exact h𝔭₅_F₀
    exact ⟨fun h => hk_not_F₀ (Finset.mem_union_left S₂ h),
      fun h => hk_not_F₀ (Finset.mem_union_right T h)⟩
  · intro k
    fin_cases k <;>
      simp only [p, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact hp₀_int
    · exact hp₁_int
    · exact hp₂_int
    · exact hp₃_int
    · exact hp₄_int
    · exact hp₅_int
  · intro k
    fin_cases k <;>
      simp only [p, 𝔭, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact hp₀_val_eq
    · exact hp₁_val_eq
    · exact hp₂_val_eq
    · exact hp₃_val_eq
    · exact hp₄_val_eq
    · exact hp₅_val_eq
  · intro k v hv
    fin_cases k <;>
      simp only [p, 𝔭, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one] at hv ⊢
    · exact hp₀_val_ne v hv
    · exact hp₁_val_ne v hv
    · exact hp₂_val_ne v hv
    · exact hp₃_val_ne v hv
    · exact hp₄_val_ne v hv
    · exact hp₅_val_ne v hv
  · intro k j
    fin_cases k <;>
      simp only [p, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact hp₀_sign₁ j
    · exact hp₁_sign₁ j
    · exact hp₂_sign₁ j
    · exact hp₃_sign₁ j
    · exact hp₄_sign₁ j
    · exact hp₅_sign₁ j
  · intro k j
    fin_cases k <;>
      simp only [p, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact hp₀_sign₂ j
    · exact hp₁_sign₂ j
    · exact hp₂_sign₂ j
    · exact hp₃_sign₂ j
    · exact hp₄_sign₂ j
    · exact hp₅_sign₂ j
  · intro k w hw
    fin_cases k <;>
      simp only [p, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact hp₀_sign_other w hw
    · exact hp₁_sign_other w hw
    · exact hp₂_sign_other w hw
    · exact hp₃_sign_other w hw
    · exact hp₄_sign_other w hw
    · exact hp₅_sign_other w hw
  · intro k v hvT
    have hvF₀ : v ∈ F₀ := Finset.mem_union_left S₂ hvT
    fin_cases k <;>
      simp only [p, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact hp₀_sq_F₀ v hvF₀
    · exact hp₁_sq_F₀ v hvF₀
    · exact hp₂_sq_F₁ v (hF₀_F₁ hvF₀)
    · exact hp₃_sq_F₁ v (hF₀_F₁ hvF₀)
    · exact hp₄_sq_F₂ v (hF₀_F₂ hvF₀)
    · exact hp₅_sq_F₂ v (hF₀_F₂ hvF₀)
  · intro k v hvS₂
    have hvF₀ : v ∈ F₀ := Finset.mem_union_right T hvS₂
    fin_cases k <;>
      simp only [p, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact hp₀_sq_F₀ v hvF₀
    · exact hp₁_sq_F₀ v hvF₀
    · exact hp₂_sq_F₁ v (hF₀_F₁ hvF₀)
    · exact hp₃_sq_F₁ v (hF₀_F₁ hvF₀)
    · exact hp₄_sq_F₂ v (hF₀_F₂ hvF₀)
    · exact hp₅_sq_F₂ v (hF₀_F₂ hvF₀)
  · intro i j hij
    fin_cases i <;> fin_cases j <;>
      (try (exfalso; revert hij; decide)) <;>
      simp only [p, 𝔭, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four,
        Matrix.cons_val_fin_one]
    · exact iff_of_false hp₁_nsq_0 (by decide)
    · exact iff_of_true (hp₂_sq_F₁ 𝔭₀ h𝔭₀_F₁) (by decide)
    · exact iff_of_true (hp₃_sq_F₁ 𝔭₀ h𝔭₀_F₁) (by decide)
    · exact iff_of_true (hp₄_sq_F₂ 𝔭₀ h𝔭₀_F₂) (by decide)
    · exact iff_of_true (hp₅_sq_F₂ 𝔭₀ h𝔭₀_F₂) (by decide)
    · exact iff_of_true (hp₂_sq_F₁ 𝔭₁ h𝔭₁_F₁) (by decide)
    · exact iff_of_true (hp₃_sq_F₁ 𝔭₁ h𝔭₁_F₁) (by decide)
    · exact iff_of_true (hp₄_sq_F₂ 𝔭₁ h𝔭₁_F₂) (by decide)
    · exact iff_of_true (hp₅_sq_F₂ 𝔭₁ h𝔭₁_F₂) (by decide)
    · exact iff_of_false hp₃_nsq_2 (by decide)
    · exact iff_of_true (hp₄_sq_F₂ 𝔭₂ h𝔭₂_F₂) (by decide)
    · exact iff_of_true (hp₅_sq_F₂ 𝔭₂ h𝔭₂_F₂) (by decide)
    · exact iff_of_true (hp₄_sq_F₂ 𝔭₃ h𝔭₃_F₂) (by decide)
    · exact iff_of_true (hp₅_sq_F₂ 𝔭₃ h𝔭₃_F₂) (by decide)
    · exact iff_of_false hp₅_nsq_4 (by decide)

theorem reciprocity_of_auxiliary_primes (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hraw : IsRawAuxiliaryPrimeTuple K τ T S₂ p 𝔭) :
    IsAuxPrimeReciprocity K a₁ a₂ a₃ p 𝔭 :=
by
  classical
  have hdesc_outside : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ q : Kˣ × Kˣ,
        IsDescentClass
          (algebraMap K (v.adicCompletion K) a₁)
          (algebraMap K (v.adicCompletion K) a₂)
          (algebraMap K (v.adicCompletion K) a₃)
          (algebraMap K (v.adicCompletion K) (q.1 : K))
          (algebraMap K (v.adicCompletion K) (q.2 : K)) ↔
        EvenVal v q.1 ∧ EvenVal v q.2 := by
    rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _⟩
    intro v hvT q
    obtain ⟨h2, hdesc_even⟩ := local_descent_implies_evenVal K a₁ a₂ a₃ hint₁ hint₂ hint₃ T hT v hvT
    exact isDescentClass_iff_evenVal_of_notMem_T K a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ v h2
      (isSquare_one_add_of_valuation_lt_one K v h2)
      (exists_nonSquare_unit_mod_ideal K v h2)
      (exists_ringOfIntegers_sub_valuation_lt_one K v)
      hdesc_even q
  have h_piv : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∃ π_u : Kˣ, IsLocalPivotUnif K a₁ a₂ a₃ v π_u :=
    fun v hvT => local_v1_hilbLoc_and_ramLocal_laws K a₁ a₂ a₃ τ T v hstart hT hvT (hdesc_outside v hvT)
  have h_piv_u : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ u : Kˣ,
        ((u : K) = -1 ∨ (u : K) = a₁ - a₂ ∨ (u : K) = a₁ - a₃ ∨ (u : K) = a₂ - a₃) →
        EvenVal v u := by
    intro v hvT u hu
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.1 u hu
  have h_hilb_even_even : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ a b : Kˣ, EvenVal v a → EvenVal v b →
        hilbFin v (a : K) (b : K) = 1 := by
    intro v hvT a b ha hb
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.2.1 a b ha hb
  have h_hilb_even_odd : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ a b : Kˣ, EvenVal v a → ¬ EvenVal v b →
        (hilbFin v (a : K) (b : K) = 1 ↔
          IsSquare (algebraMap K (v.adicCompletion K) (a : K))) ∧
        (hilbFin v (b : K) (a : K) = 1 ↔
          IsSquare (algebraMap K (v.adicCompletion K) (a : K))) := by
    intro v hvT a b ha hb
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.2.2.1 a b ha hb
  rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, _, _, _, _, hτ_inj,
    hτ0, hτ1, hτ2, hτ3, hτ4, hτ5, hτ6, hτ7, hτ8, hτ9, hτ10, hτ11, _⟩
  rcases hraw with ⟨h𝔭_inj, h𝔭_notMem, hp_int, hp_val_𝔭, hp_val_ne,
    hp_sign1, hp_sign2, hp_sign_other, hp_sq_T, hp_sq_S₂, hp_upper⟩
  have hp_even_ne : ∀ (k : Fin 6)
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ≠ 𝔭 k → EvenVal v (p k) := by
    intro k v hv
    have hval := hp_val_ne k v hv
    rw [← v.valuationOfNeZero_eq (p k)] at hval
    have h1 : v.valuationOfNeZero (p k) = 1 := WithZero.coe_inj.mp hval
    dsimp [EvenVal]
    rw [h1, toAdd_one]
    exact Even.zero
  have hp_not_even_𝔭 : ∀ k : Fin 6, ¬ EvenVal (𝔭 k) (p k) := by
    intro k
    have hval := hp_val_𝔭 k
    rw [← (𝔭 k).valuationOfNeZero_eq (p k)] at hval
    have h1 : (𝔭 k).valuationOfNeZero (p k) = Multiplicative.ofAdd (-1 : ℤ) :=
      WithZero.coe_inj.mp hval
    dsimp [EvenVal]
    rw [h1, toAdd_ofAdd]
    decide
  have hilbFin_eq_one_of_isSquare_left :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (a : Kˣ) (b : K),
        IsSquare (algebraMap K (v.adicCompletion K) (a : K)) →
        hilbFin v (a : K) b = 1 := by
    rintro v a b ⟨r, hr⟩
    unfold hilbFin hilbLoc
    apply if_pos
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr
      exact a.ne_zero ((algebraMap K (v.adicCompletion K)).injective (hr.trans (map_zero _).symm))
    refine ⟨r⁻¹, 0, ?_⟩
    rw [hr]
    calc (r * r) * (r⁻¹) ^ 2 + algebraMap K (v.adicCompletion K) b * 0 ^ 2
      _ = (r * r⁻¹) ^ 2 := by ring
      _ = 1 ^ 2 := by rw [mul_inv_cancel₀ hr_ne]
      _ = 1 := one_pow 2
  have hilbInf_eq_one_of_isComplex :
      ∀ (w : NumberField.InfinitePlace K), w.IsComplex → ∀ (a b : Kˣ),
        hilbInf w (a : K) (b : K) = 1 := by
    intro w hw a b
    unfold hilbInf hilbInfLoc
    apply if_pos
    have hbij := NumberField.InfinitePlace.Completion.bijective_extensionEmbedding_of_isComplex hw
    set φ := NumberField.InfinitePlace.Completion.extensionEmbedding w
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_eq_mul_self (φ (algebraMap K w.Completion (a : K)))
    obtain ⟨r, hr⟩ := hbij.2 z
    have hr_sq : algebraMap K w.Completion (a : K) = r * r := by
      apply hbij.1
      rw [map_mul, hr, ← hz]
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr_sq
      exact a.ne_zero ((algebraMap K w.Completion).injective (hr_sq.trans (map_zero _).symm))
    refine ⟨r⁻¹, 0, ?_⟩
    rw [hr_sq]
    calc (r * r) * (r⁻¹) ^ 2 + algebraMap K w.Completion (b : K) * 0 ^ 2
      _ = (r * r⁻¹) ^ 2 := by ring
      _ = 1 ^ 2 := by rw [mul_inv_cancel₀ hr_ne]
      _ = 1 := one_pow 2
  have hilbInf_eq_one_of_pos_left :
      ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (a b : Kˣ),
        0 < realPlaceEmb ⟨w, hw⟩ (a : K) → hilbInf w (a : K) (b : K) = 1 := by
    intro w hw a b ha_pos
    unfold hilbInf hilbInfLoc
    apply if_pos
    have hbij := NumberField.InfinitePlace.Completion.bijective_extensionEmbeddingOfIsReal hw
    set ψ := NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal hw
    have hcoe : ψ (algebraMap K w.Completion (a : K)) = realPlaceEmb ⟨w, hw⟩ (a : K) :=
      NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw (a : K)
    obtain ⟨r, hr⟩ := hbij.2 (Real.sqrt (realPlaceEmb ⟨w, hw⟩ (a : K)))
    have hr_sq : algebraMap K w.Completion (a : K) = r * r := by
      apply hbij.1
      rw [map_mul, hr, Real.mul_self_sqrt (le_of_lt ha_pos), hcoe]
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr_sq
      exact a.ne_zero ((algebraMap K w.Completion).injective (hr_sq.trans (map_zero _).symm))
    refine ⟨r⁻¹, 0, ?_⟩
    rw [hr_sq]
    calc (r * r) * (r⁻¹) ^ 2 + algebraMap K w.Completion (b : K) * 0 ^ 2
      _ = (r * r⁻¹) ^ 2 := by ring
      _ = 1 ^ 2 := by rw [mul_inv_cancel₀ hr_ne]
      _ = 1 := one_pow 2
  have hilbInf_eq_one_of_pos_right :
      ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (a b : Kˣ),
        0 < realPlaceEmb ⟨w, hw⟩ (b : K) → hilbInf w (a : K) (b : K) = 1 := by
    intro w hw a b hb_pos
    unfold hilbInf hilbInfLoc
    apply if_pos
    have hbij := NumberField.InfinitePlace.Completion.bijective_extensionEmbeddingOfIsReal hw
    set ψ := NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal hw
    have hcoe : ψ (algebraMap K w.Completion (b : K)) = realPlaceEmb ⟨w, hw⟩ (b : K) :=
      NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw (b : K)
    obtain ⟨r, hr⟩ := hbij.2 (Real.sqrt (realPlaceEmb ⟨w, hw⟩ (b : K)))
    have hr_sq : algebraMap K w.Completion (b : K) = r * r := by
      apply hbij.1
      rw [map_mul, hr, Real.mul_self_sqrt (le_of_lt hb_pos), hcoe]
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr_sq
      exact b.ne_zero ((algebraMap K w.Completion).injective (hr_sq.trans (map_zero _).symm))
    refine ⟨0, r⁻¹, ?_⟩
    rw [hr_sq]
    calc algebraMap K w.Completion (a : K) * 0 ^ 2 + (r * r) * (r⁻¹) ^ 2
      _ = (r * r⁻¹) ^ 2 := by ring
      _ = 1 ^ 2 := by rw [mul_inv_cancel₀ hr_ne]
      _ = 1 := one_pow 2
  have hilbInf_eq_neg_one_of_neg_of_neg :
      ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (a b : Kˣ),
        realPlaceEmb ⟨w, hw⟩ (a : K) < 0 →
        realPlaceEmb ⟨w, hw⟩ (b : K) < 0 →
        hilbInf w (a : K) (b : K) = -1 := by
    intro w hw a b ha_neg hb_neg
    unfold hilbInf hilbInfLoc
    apply if_neg
    rintro ⟨x, y, hxy⟩
    set ψ := NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal hw
    have hcoe_a : ψ (algebraMap K w.Completion (a : K)) = realPlaceEmb ⟨w, hw⟩ (a : K) :=
      NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw (a : K)
    have hcoe_b : ψ (algebraMap K w.Completion (b : K)) = realPlaceEmb ⟨w, hw⟩ (b : K) :=
      NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw (b : K)
    have h_real := congrArg ψ hxy
    rw [map_add, map_mul, map_mul, map_pow, map_pow, map_one, hcoe_a, hcoe_b] at h_real
    have hx2 : 0 ≤ (ψ x) ^ 2 := sq_nonneg (ψ x)
    have hy2 : 0 ≤ (ψ y) ^ 2 := sq_nonneg (ψ y)
    nlinarith
  have hp_pos_of_ne_pair : ∀ (k : Fin 6)
      (w_sub : {w : NumberField.InfinitePlace K // w.IsReal}),
      w_sub ≠ τ ⟨k.1, by omega⟩ →
      w_sub ≠ τ ⟨k.1 + 6, by omega⟩ →
      0 < realPlaceEmb w_sub (p k : K) := by
    intro k w_sub hne1 hne2
    by_cases hex : ∃ i : Fin 12, w_sub = τ i
    · rcases hex with ⟨i, rfl⟩
      have hne0 : realPlaceEmb (τ i) (p k : K) ≠ 0 := by
        simpa using (realPlaceEmb (τ i)).injective.ne (p k).ne_zero
      by_cases hi6 : i.1 < 6
      · let j : Fin 6 := ⟨i.1, hi6⟩
        have hij : τ i = τ ⟨j.1, by omega⟩ := rfl
        have hjk : j ≠ k := by
          rintro rfl
          exact hne1 hij
        have hnot_neg : ¬ (realPlaceEmb (τ i) (p k : K) < 0) := by
          rw [hij]
          exact mt (hp_sign1 k j).mp hjk
        exact lt_of_le_of_ne (not_lt.mp hnot_neg) hne0.symm
      · let j : Fin 6 := ⟨i.1 - 6, by omega⟩
        have hij : i = ⟨j.1 + 6, by omega⟩ := by
          ext
          dsimp [j]
          omega
        have hjk : j ≠ k := by
          rintro rfl
          apply hne2
          rw [hij]
        have hnot_neg : ¬ (realPlaceEmb (τ i) (p k : K) < 0) := by
          rw [hij]
          exact mt (hp_sign2 k j).mp hjk
        exact lt_of_le_of_ne (not_lt.mp hnot_neg) hne0.symm
    · push_neg at hex
      exact hp_sign_other k w_sub hex
  have h_symm : ∀ i j : Fin 6, i ≠ j →
      (IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (p j : K)) ↔
       IsSquare (algebraMap K ((𝔭 j).adicCompletion K) (p i : K))) := by
    intro i j hij
    have h_inf_one : ∀ w : NumberField.InfinitePlace K, hilbInf w (p i : K) (p j : K) = 1 := by
      intro w
      rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
      · let w_sub : {w : NumberField.InfinitePlace K // w.IsReal} := ⟨w, hw⟩
        by_cases hwi : w_sub = τ ⟨i.1, by omega⟩ ∨ w_sub = τ ⟨i.1 + 6, by omega⟩
        · have hwj1 : w_sub ≠ τ ⟨j.1, by omega⟩ := by
            intro h
            rcases hwi with h1 | h1
            · have h_idx := hτ_inj (h1.symm.trans h)
              have h_val := congrArg Fin.val h_idx
              dsimp at h_val
              exact hij (Fin.ext h_val)
            · have h_idx := hτ_inj (h1.symm.trans h)
              have h_val := congrArg Fin.val h_idx
              dsimp at h_val
              omega
          have hwj2 : w_sub ≠ τ ⟨j.1 + 6, by omega⟩ := by
            intro h
            rcases hwi with h1 | h1
            · have h_idx := hτ_inj (h1.symm.trans h)
              have h_val := congrArg Fin.val h_idx
              dsimp at h_val
              omega
            · have h_idx := hτ_inj (h1.symm.trans h)
              have h_val := congrArg Fin.val h_idx
              dsimp at h_val
              exact hij (Fin.ext (by omega))
          exact hilbInf_eq_one_of_pos_right w hw (p i) (p j) (hp_pos_of_ne_pair j w_sub hwj1 hwj2)
        · push_neg at hwi
          exact hilbInf_eq_one_of_pos_left w hw (p i) (p j) (hp_pos_of_ne_pair i w_sub hwi.1 hwi.2)
      · exact hilbInf_eq_one_of_isComplex w hw (p i) (p j)
    have h_fin_outside : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v ≠ 𝔭 i → v ≠ 𝔭 j → hilbFin v (p i : K) (p j : K) = 1 := by
      intro v hvi hvj
      by_cases hvT : v ∈ T
      · exact hilbFin_eq_one_of_isSquare_left v (p i) (p j : K) (hp_sq_T i v hvT)
      · exact h_hilb_even_even v hvT (p i) (p j) (hp_even_ne i v hvi) (hp_even_ne j v hvj)
    have h_supp : Function.mulSupport
        (fun v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) =>
          hilbFin v (p i : K) (p j : K)) ⊆
        (({𝔭 i, 𝔭 j} : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
          Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) := by
      intro v hv
      rw [Function.mem_mulSupport] at hv
      by_contra hnot
      simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff, not_or] at hnot
      exact hv (h_fin_outside v hnot.1 hnot.2)
    have h_rec := (hilbert_reciprocity (p i) (p j)).2
    have h𝔭_ne : 𝔭 i ≠ 𝔭 j := h𝔭_inj.ne hij
    rw [finprod_eq_prod_of_mulSupport_subset _ h_supp,
        Finset.prod_pair h𝔭_ne,
        Finset.prod_eq_one (fun w _ => h_inf_one w), mul_one] at h_rec
    have h_hilb_eq_iff :
        hilbFin (𝔭 i) (p i : K) (p j : K) = 1 ↔
        hilbFin (𝔭 j) (p i : K) (p j : K) = 1 := by
      rcases Int.units_eq_one_or (hilbFin (𝔭 i) (p i : K) (p j : K)) with h1 | h1 <;>
      rcases Int.units_eq_one_or (hilbFin (𝔭 j) (p i : K) (p j : K)) with h2 | h2
      · simp [h1, h2]
      · exfalso; rw [h1, h2] at h_rec; revert h_rec; decide
      · exfalso; rw [h1, h2] at h_rec; revert h_rec; decide
      · simp [h1, h2]
    have h_at_i : hilbFin (𝔭 i) (p i : K) (p j : K) = 1 ↔
        IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (p j : K)) :=
      (h_hilb_even_odd (𝔭 i) (h𝔭_notMem i).1 (p j) (p i)
        (hp_even_ne j (𝔭 i) h𝔭_ne) (hp_not_even_𝔭 i)).2
    have h_at_j : hilbFin (𝔭 j) (p i : K) (p j : K) = 1 ↔
        IsSquare (algebraMap K ((𝔭 j).adicCompletion K) (p i : K)) :=
      (h_hilb_even_odd (𝔭 j) (h𝔭_notMem j).1 (p i) (p j)
        (hp_even_ne i (𝔭 j) h𝔭_ne.symm) (hp_not_even_𝔭 j)).1
    exact h_at_i.symm.trans (h_hilb_eq_iff.trans h_at_j)
  have isSquare_at_aux_prime_of_same_sign :
      ∀ (k : Fin 6) (u : Kˣ),
        ((u : K) = -1 ∨ (u : K) = a₁ - a₂ ∨ (u : K) = a₁ - a₃ ∨ (u : K) = a₂ - a₃) →
        ((0 < realPlaceEmb (τ ⟨k.1, by omega⟩) (u : K) ∧
          0 < realPlaceEmb (τ ⟨k.1 + 6, by omega⟩) (u : K)) ∨
         (realPlaceEmb (τ ⟨k.1, by omega⟩) (u : K) < 0 ∧
          realPlaceEmb (τ ⟨k.1 + 6, by omega⟩) (u : K) < 0)) →
        IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (u : K)) := by
    intro k u hu_case hu_sign
    let w₁ : NumberField.InfinitePlace K := (τ ⟨k.1, by omega⟩).1
    let w₂ : NumberField.InfinitePlace K := (τ ⟨k.1 + 6, by omega⟩).1
    have hw₁₂ : w₁ ≠ w₂ := by
      intro h
      have h_sub : τ ⟨k.1, by omega⟩ = τ ⟨k.1 + 6, by omega⟩ := Subtype.ext h
      have h_idx := hτ_inj h_sub
      have h_val := congrArg Fin.val h_idx
      dsimp at h_val
      omega
    have h_inf_other : ∀ w : NumberField.InfinitePlace K,
        w ≠ w₁ → w ≠ w₂ → hilbInf w (p k : K) (u : K) = 1 := by
      intro w hne1 hne2
      rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
      · let w_sub : {w : NumberField.InfinitePlace K // w.IsReal} := ⟨w, hw⟩
        have hsub1 : w_sub ≠ τ ⟨k.1, by omega⟩ := fun h => hne1 (congrArg Subtype.val h)
        have hsub2 : w_sub ≠ τ ⟨k.1 + 6, by omega⟩ := fun h => hne2 (congrArg Subtype.val h)
        exact hilbInf_eq_one_of_pos_left w hw (p k) u (hp_pos_of_ne_pair k w_sub hsub1 hsub2)
      · exact hilbInf_eq_one_of_isComplex w hw (p k) u
    have h_inf_prod : (∏ w : NumberField.InfinitePlace K, hilbInf w (p k : K) (u : K)) = 1 := by
      rcases hu_sign with ⟨hu1, hu2⟩ | ⟨hu1, hu2⟩
      · refine Finset.prod_eq_one (fun w _ => ?_)
        by_cases hw1 : w = w₁
        · subst hw1
          exact hilbInf_eq_one_of_pos_right w₁ (τ ⟨k.1, by omega⟩).2 (p k) u hu1
        · by_cases hw2 : w = w₂
          · subst hw2
            exact hilbInf_eq_one_of_pos_right w₂ (τ ⟨k.1 + 6, by omega⟩).2 (p k) u hu2
          · exact h_inf_other w hw1 hw2
      · have h_w1 : hilbInf w₁ (p k : K) (u : K) = -1 :=
          hilbInf_eq_neg_one_of_neg_of_neg w₁ (τ ⟨k.1, by omega⟩).2 (p k) u
            ((hp_sign1 k k).mpr rfl) hu1
        have h_w2 : hilbInf w₂ (p k : K) (u : K) = -1 :=
          hilbInf_eq_neg_one_of_neg_of_neg w₂ (τ ⟨k.1 + 6, by omega⟩).2 (p k) u
            ((hp_sign2 k k).mpr rfl) hu2
        rw [Finset.prod_eq_mul_of_mem w₁ w₂ (Finset.mem_univ w₁) (Finset.mem_univ w₂) hw₁₂
            (fun w _ hw => h_inf_other w hw.1 hw.2), h_w1, h_w2]
        decide
    have h_fin_other : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v ≠ 𝔭 k → hilbFin v (p k : K) (u : K) = 1 := by
      intro v hv
      by_cases hvT : v ∈ T
      · exact hilbFin_eq_one_of_isSquare_left v (p k) (u : K) (hp_sq_T k v hvT)
      · exact h_hilb_even_even v hvT (p k) u (hp_even_ne k v hv) (h_piv_u v hvT u hu_case)
    have h_rec := (hilbert_reciprocity (p k) u).2
    rw [finprod_eq_single _ (𝔭 k) h_fin_other, h_inf_prod, mul_one] at h_rec
    exact (h_hilb_even_odd (𝔭 k) (h𝔭_notMem k).1 u (p k)
      (h_piv_u (𝔭 k) (h𝔭_notMem k).1 u hu_case) (hp_not_even_𝔭 k)).2.mp h_rec
  refine ⟨?_, ?_⟩
  · intro i j hij
    have hij_val : i.1 ≠ j.1 := fun h => hij (Fin.ext h)
    rcases lt_or_gt_of_ne hij_val with hlt | hgt
    · rw [hp_upper i j hlt]
      omega
    · rw [h_symm i j hij, hp_upper j i hgt]
      omega
  · intro k
    let u_neg1 : Kˣ := -1
    let u_12 : Kˣ := Units.mk0 (a₁ - a₂) (sub_ne_zero.mpr h₁₂)
    let u_13 : Kˣ := Units.mk0 (a₁ - a₃) (sub_ne_zero.mpr h₁₃)
    let u_23 : Kˣ := Units.mk0 (a₂ - a₃) (sub_ne_zero.mpr h₂₃)
    have h_neg1 : IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (-1 : K)) := by
      change IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (u_neg1 : K))
      refine isSquare_at_aux_prime_of_same_sign k u_neg1 (Or.inl rfl) (Or.inr ⟨?_, ?_⟩)
      · change realPlaceEmb (τ ⟨k.1, by omega⟩) (-1 : K) < 0
        rw [map_neg, map_one]
        linarith
      · change realPlaceEmb (τ ⟨k.1 + 6, by omega⟩) (-1 : K) < 0
        rw [map_neg, map_one]
        linarith
    have h_rest :
        IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (a₁ - a₂)) ∧
        IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (a₁ - a₃)) ∧
        IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (a₂ - a₃)) := by
      change IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (u_12 : K)) ∧
             IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (u_13 : K)) ∧
             IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (u_23 : K))
      fin_cases k
      · refine ⟨isSquare_at_aux_prime_of_same_sign 0 u_12 (Or.inr (Or.inl rfl)) (Or.inl ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 0 u_13 (Or.inr (Or.inr (Or.inl rfl))) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 0 u_23 (Or.inr (Or.inr (Or.inr rfl))) (Or.inr ⟨?_, ?_⟩)⟩
        · change 0 < realPlaceEmb (τ 0) (a₁ - a₂); rw [map_sub]; linarith [hτ0.1]
        · change 0 < realPlaceEmb (τ 6) (a₁ - a₂); rw [map_sub]; linarith [hτ6.1]
        · change realPlaceEmb (τ 0) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ0.2]
        · change realPlaceEmb (τ 6) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ6.2]
        · change realPlaceEmb (τ 0) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ0.1, hτ0.2]
        · change realPlaceEmb (τ 6) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ6.1, hτ6.2]
      · refine ⟨isSquare_at_aux_prime_of_same_sign 1 u_12 (Or.inr (Or.inl rfl)) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 1 u_13 (Or.inr (Or.inr (Or.inl rfl))) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 1 u_23 (Or.inr (Or.inr (Or.inr rfl))) (Or.inr ⟨?_, ?_⟩)⟩
        · change realPlaceEmb (τ 1) (a₁ - a₂) < 0; rw [map_sub]; linarith [hτ1.1]
        · change realPlaceEmb (τ 7) (a₁ - a₂) < 0; rw [map_sub]; linarith [hτ7.1]
        · change realPlaceEmb (τ 1) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ1.1, hτ1.2]
        · change realPlaceEmb (τ 7) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ7.1, hτ7.2]
        · change realPlaceEmb (τ 1) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ1.2]
        · change realPlaceEmb (τ 7) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ7.2]
      · refine ⟨isSquare_at_aux_prime_of_same_sign 2 u_12 (Or.inr (Or.inl rfl)) (Or.inl ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 2 u_13 (Or.inr (Or.inr (Or.inl rfl))) (Or.inl ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 2 u_23 (Or.inr (Or.inr (Or.inr rfl))) (Or.inr ⟨?_, ?_⟩)⟩
        · change 0 < realPlaceEmb (τ 2) (a₁ - a₂); rw [map_sub]; linarith [hτ2.1, hτ2.2]
        · change 0 < realPlaceEmb (τ 8) (a₁ - a₂); rw [map_sub]; linarith [hτ8.1, hτ8.2]
        · change 0 < realPlaceEmb (τ 2) (a₁ - a₃); rw [map_sub]; linarith [hτ2.2]
        · change 0 < realPlaceEmb (τ 8) (a₁ - a₃); rw [map_sub]; linarith [hτ8.2]
        · change realPlaceEmb (τ 2) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ2.1]
        · change realPlaceEmb (τ 8) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ8.1]
      · refine ⟨isSquare_at_aux_prime_of_same_sign 3 u_12 (Or.inr (Or.inl rfl)) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 3 u_13 (Or.inr (Or.inr (Or.inl rfl))) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 3 u_23 (Or.inr (Or.inr (Or.inr rfl))) (Or.inl ⟨?_, ?_⟩)⟩
        · change realPlaceEmb (τ 3) (a₁ - a₂) < 0; rw [map_sub]; linarith [hτ3.1, hτ3.2]
        · change realPlaceEmb (τ 9) (a₁ - a₂) < 0; rw [map_sub]; linarith [hτ9.1, hτ9.2]
        · change realPlaceEmb (τ 3) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ3.1]
        · change realPlaceEmb (τ 9) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ9.1]
        · change 0 < realPlaceEmb (τ 3) (a₂ - a₃); rw [map_sub]; linarith [hτ3.2]
        · change 0 < realPlaceEmb (τ 9) (a₂ - a₃); rw [map_sub]; linarith [hτ9.2]
      · refine ⟨isSquare_at_aux_prime_of_same_sign 4 u_12 (Or.inr (Or.inl rfl)) (Or.inl ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 4 u_13 (Or.inr (Or.inr (Or.inl rfl))) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 4 u_23 (Or.inr (Or.inr (Or.inr rfl))) (Or.inr ⟨?_, ?_⟩)⟩
        · change 0 < realPlaceEmb (τ 4) (a₁ - a₂); rw [map_sub]; linarith [hτ4.1]
        · change 0 < realPlaceEmb (τ 10) (a₁ - a₂); rw [map_sub]; linarith [hτ10.1]
        · change realPlaceEmb (τ 4) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ4.2]
        · change realPlaceEmb (τ 10) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ10.2]
        · change realPlaceEmb (τ 4) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ4.1, hτ4.2]
        · change realPlaceEmb (τ 10) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ10.1, hτ10.2]
      · refine ⟨isSquare_at_aux_prime_of_same_sign 5 u_12 (Or.inr (Or.inl rfl)) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 5 u_13 (Or.inr (Or.inr (Or.inl rfl))) (Or.inr ⟨?_, ?_⟩),
                isSquare_at_aux_prime_of_same_sign 5 u_23 (Or.inr (Or.inr (Or.inr rfl))) (Or.inr ⟨?_, ?_⟩)⟩
        · change realPlaceEmb (τ 5) (a₁ - a₂) < 0; rw [map_sub]; linarith [hτ5.1]
        · change realPlaceEmb (τ 11) (a₁ - a₂) < 0; rw [map_sub]; linarith [hτ11.1]
        · change realPlaceEmb (τ 5) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ5.1, hτ5.2]
        · change realPlaceEmb (τ 11) (a₁ - a₃) < 0; rw [map_sub]; linarith [hτ11.1, hτ11.2]
        · change realPlaceEmb (τ 5) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ5.2]
        · change realPlaceEmb (τ 11) (a₂ - a₃) < 0; rw [map_sub]; linarith [hτ11.2]
    exact ⟨h_neg1, h_rest.1, h_rest.2.1, h_rest.2.2⟩

theorem local_isotropic_aux_prime_laws (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (p₀ ε₀ : Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hp₀_val : IsDedekindDomain.HeightOneSpectrum.valuation K v₀ (p₀ : K) = WithZero.exp (-1 : ℤ))
    (hε₀_val : IsDedekindDomain.HeightOneSpectrum.valuation K v₀ (ε₀ : K) = 1)
    (hε₀_nsq : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (ε₀ : K)))
    (hsq_neg1 : IsSquare (algebraMap K (v₀.adicCompletion K) (-1 : K)))
    (hsq_12 : IsSquare (algebraMap K (v₀.adicCompletion K) (a₁ - a₂)))
    (hsq_13 : IsSquare (algebraMap K (v₀.adicCompletion K) (a₁ - a₃)))
    (hsq_23 : IsSquare (algebraMap K (v₀.adicCompletion K) (a₂ - a₃)))
    (hpiv : ∃ π_u : Kˣ, IsLocalPivotUnif K a₁ a₂ a₃ v₀ π_u) :
    IsIsotropicAuxUnif K a₁ a₂ a₃ v₀ p₀ ε₀ :=
by
  classical
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  clear hstart
  rcases hpiv with ⟨_, -, -, -, hloc_sq_ev, hloc_ev_mul, -, hloc_sq_mul, hloc_ev_ev, hloc_ev_odd, hloc_odd_odd⟩
  have hπ_val : Valued.v (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) =
      ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
    refine (v₀.valuedAdicCompletion_eq_valuation' ((p₀ * ε₀ : Kˣ) : K)).trans ?_
    rw [Units.val_mul, map_mul, hp₀_val, hε₀_val, mul_one]
    rfl
  have h_unif : IsLocalUnif v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) :=
    ⟨-1, ⟨-1, by omega⟩, hπ_val⟩
  have h_even_of_val_one : ∀ u : Kˣ,
      IsDedekindDomain.HeightOneSpectrum.valuation K v₀ (u : K) = 1 → EvenVal v₀ u := by
    intro u hu
    have h1 : ((v₀.valuationOfNeZero u : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        ((1 : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v₀ u, hu, WithZero.coe_one]
    have h2 : v₀.valuationOfNeZero u = 1 := WithZero.coe_inj.mp h1
    dsimp [EvenVal]
    rw [h2, toAdd_one]
    exact ⟨0, rfl⟩
  have hev_1 : EvenVal v₀ 1 := h_even_of_val_one 1 (by simp)
  have hev_ε₀ : EvenVal v₀ ε₀ := h_even_of_val_one ε₀ hε₀_val
  have hn_ev_p₀ : ¬ EvenVal v₀ p₀ := by
    have h1 : ((v₀.valuationOfNeZero p₀ : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v₀ p₀, hp₀_val]
      rfl
    have h2 : v₀.valuationOfNeZero p₀ = Multiplicative.ofAdd (-1 : ℤ) := WithZero.coe_inj.mp h1
    dsimp [EvenVal]
    rw [h2, toAdd_ofAdd]
    rintro ⟨k, hk⟩
    omega
  have hn_ev_π : ¬ EvenVal v₀ (p₀ * ε₀) :=
    fun h => hn_ev_p₀ ((hloc_ev_mul p₀ ε₀).mp h |>.mpr hev_ε₀)
  have h_isSquare_mul_iff : ∀ (a c : v₀.adicCompletion K),
      c ≠ 0 → IsSquare c → (IsSquare (a * c) ↔ IsSquare a) := by
    intro a c hc0 ⟨r, hr⟩
    have hr0 : r ≠ 0 := by
      intro h0
      apply hc0
      rw [hr, h0, mul_zero]
    constructor
    · rintro ⟨s, hs⟩
      refine ⟨s / r, ?_⟩
      calc a = (a * (r * r)) / (r * r) := by
            rw [mul_div_cancel_right₀ a (mul_ne_zero hr0 hr0)]
        _ = (s * s) / (r * r) := by rw [← hr, hs]
        _ = (s / r) * (s / r) := by ring
    · rintro ⟨s, hs⟩
      exact ⟨s * r, by rw [hs, hr]; ring⟩
  have h_isSquare_neg_iff : ∀ (a : v₀.adicCompletion K),
      IsSquare (-a) ↔ IsSquare a := by
    intro a
    have hneg1_ne : algebraMap K (v₀.adicCompletion K) (-1 : K) ≠ 0 := by simp
    have h_eq : -a = a * algebraMap K (v₀.adicCompletion K) (-1 : K) := by simp
    rw [h_eq]
    exact h_isSquare_mul_iff a _ hneg1_ne hsq_neg1
  have hinj : Function.Injective (algebraMap K (v₀.adicCompletion K)) :=
    (algebraMap K (v₀.adicCompletion K)).injective
  have hα0 : algebraMap K (v₀.adicCompletion K) (a₁ - a₂) ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (sub_ne_zero.mpr h₁₂)
  have hβ0 : algebraMap K (v₀.adicCompletion K) (a₁ - a₃) ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (sub_ne_zero.mpr h₁₃)
  have hγ0 : algebraMap K (v₀.adicCompletion K) (a₂ - a₃) ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (sub_ne_zero.mpr h₂₃)
  have h_ram_iff : ∀ x₁ x₂ : Kˣ,
      RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) x₁ x₂ ↔
        IsAuxLocalCond K v₀ (p₀ * ε₀) x₁ ∧ IsAuxLocalCond K v₀ (p₀ * ε₀) x₂ := by
    intro x₁ x₂
    have h_d1 : IsSquare (algebraMap K (v₀.adicCompletion K) ((x₁ : K) * (a₁ - a₂) * (a₁ - a₃))) ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (x₁ : K)) := by
      simp only [map_mul]
      rw [h_isSquare_mul_iff _ _ hβ0 hsq_13, h_isSquare_mul_iff _ _ hα0 hsq_12]
    have h_d2 : IsSquare (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
          algebraMap K (v₀.adicCompletion K) ((x₂ : K) * (a₁ - a₂))) ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₂ : Kˣ) : K)) := by
      have heq : algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) ((x₂ : K) * (a₁ - a₂)) =
          algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₂ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) (a₁ - a₂) := by
        simp only [Units.val_mul, map_mul]
        ring
      rw [heq, h_isSquare_mul_iff _ _ hα0 hsq_12]
    have h_d3 : IsSquare (-(algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
          algebraMap K (v₀.adicCompletion K) ((x₁ : K) * (a₁ - a₂)))) ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₁ : Kˣ) : K)) := by
      rw [h_isSquare_neg_iff]
      have heq : algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) ((x₁ : K) * (a₁ - a₂)) =
          algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₁ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) (a₁ - a₂) := by
        simp only [Units.val_mul, map_mul]
        ring
      rw [heq, h_isSquare_mul_iff _ _ hα0 hsq_12]
    have h_d4 : IsSquare (algebraMap K (v₀.adicCompletion K) (-((x₂ : K) * (a₁ - a₂) * (a₂ - a₃)))) ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (x₂ : K)) := by
      rw [map_neg, h_isSquare_neg_iff]
      simp only [map_mul]
      rw [h_isSquare_mul_iff _ _ hγ0 hsq_23, h_isSquare_mul_iff _ _ hα0 hsq_12]
    have h_d5 : IsSquare (-(algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
          algebraMap K (v₀.adicCompletion K) ((x₁ : K) * (a₁ - a₃)))) ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₁ : Kˣ) : K)) := by
      rw [h_isSquare_neg_iff]
      have heq : algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) ((x₁ : K) * (a₁ - a₃)) =
          algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₁ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) (a₁ - a₃) := by
        simp only [Units.val_mul, map_mul]
        ring
      rw [heq, h_isSquare_mul_iff _ _ hβ0 hsq_13]
    have h_d6 : IsSquare (-(algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
          algebraMap K (v₀.adicCompletion K) ((x₂ : K) * (a₂ - a₃)))) ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₂ : Kˣ) : K)) := by
      rw [h_isSquare_neg_iff]
      have heq : algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) ((x₂ : K) * (a₂ - a₃)) =
          algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * x₂ : Kˣ) : K) *
            algebraMap K (v₀.adicCompletion K) (a₂ - a₃) := by
        simp only [Units.val_mul, map_mul]
        ring
      rw [heq, h_isSquare_mul_iff _ _ hγ0 hsq_23]
    unfold RamLocal IsAuxLocalCond
    rw [h_d1, h_d2, h_d3, h_d4, h_d5, h_d6]
    exact ⟨by rintro (⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩) <;>
              exact ⟨by first | exact Or.inl h1 | exact Or.inr h1,
                     by first | exact Or.inl h2 | exact Or.inr h2⟩,
           by rintro ⟨h1 | h1, h2 | h2⟩
              · exact Or.inl ⟨h1, h2⟩
              · exact Or.inr (Or.inl ⟨h1, h2⟩)
              · exact Or.inr (Or.inr (Or.inl ⟨h1, h2⟩))
              · exact Or.inr (Or.inr (Or.inr ⟨h1, h2⟩))⟩
  have h_ev_aux_iff : ∀ x : Kˣ,
      (EvenVal v₀ x ∧ IsAuxLocalCond K v₀ (p₀ * ε₀) x) ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) := by
    intro x
    constructor
    · rintro ⟨hx_ev, hx_sq | hπx_sq⟩
      · exact hx_sq
      · exfalso
        have h_ev_πx : EvenVal v₀ ((p₀ * ε₀) * x) := hloc_sq_ev ((p₀ * ε₀) * x) hπx_sq
        exact hn_ev_π ((hloc_ev_mul (p₀ * ε₀) x).mp h_ev_πx |>.mpr hx_ev)
    · intro hx_sq
      exact ⟨hloc_sq_ev x hx_sq, Or.inl hx_sq⟩
  have h_ram_ev_sq : ∀ x₁ x₂ : Kˣ,
      RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) x₁ x₂ →
      (EvenVal v₀ x₁ → IsSquare (algebraMap K (v₀.adicCompletion K) (x₁ : K))) ∧
      (EvenVal v₀ x₂ → IsSquare (algebraMap K (v₀.adicCompletion K) (x₂ : K))) := by
    intro x₁ x₂ hram
    rcases (h_ram_iff x₁ x₂).mp hram with ⟨hx₁, hx₂⟩
    exact ⟨fun hev₁ => (h_ev_aux_iff x₁).mp ⟨hev₁, hx₁⟩,
           fun hev₂ => (h_ev_aux_iff x₂).mp ⟨hev₂, hx₂⟩⟩
  have haux_1 : IsAuxLocalCond K v₀ (p₀ * ε₀) 1 := Or.inl ⟨1, by simp⟩
  have h_ram_u : ∀ u : Kˣ,
      IsDedekindDomain.HeightOneSpectrum.valuation K v₀ (u : K) = 1 →
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
      RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) (p₀ * u) 1 ∧
      RamLocal a₁ a₂ a₃ v₀ (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) 1 (p₀ * u) := by
    intro u hu_val hu_nsq
    have hu_ev : EvenVal v₀ u := h_even_of_val_one u hu_val
    have hεu_sq : IsSquare (algebraMap K (v₀.adicCompletion K) ((ε₀ * u : Kˣ) : K)) :=
      (hloc_sq_mul ε₀ u hev_ε₀ hu_ev).mpr (iff_of_false hε₀_nsq hu_nsq)
    rcases hεu_sq with ⟨r, hr⟩
    have hpu_aux : IsAuxLocalCond K v₀ (p₀ * ε₀) (p₀ * u) := by
      right
      refine ⟨r * algebraMap K (v₀.adicCompletion K) (p₀ : K), ?_⟩
      calc algebraMap K (v₀.adicCompletion K) (((p₀ * ε₀) * (p₀ * u) : Kˣ) : K)
        _ = algebraMap K (v₀.adicCompletion K) ((ε₀ * u : Kˣ) : K) *
              (algebraMap K (v₀.adicCompletion K) (p₀ : K) *
               algebraMap K (v₀.adicCompletion K) (p₀ : K)) := by
            simp only [Units.val_mul, map_mul]
            ring
        _ = (r * r) * (algebraMap K (v₀.adicCompletion K) (p₀ : K) *
              algebraMap K (v₀.adicCompletion K) (p₀ : K)) := by rw [hr]
        _ = (r * algebraMap K (v₀.adicCompletion K) (p₀ : K)) *
              (r * algebraMap K (v₀.adicCompletion K) (p₀ : K)) := by ring
    exact ⟨(h_ram_iff (p₀ * u) 1).mpr ⟨hpu_aux, haux_1⟩,
           (h_ram_iff 1 (p₀ * u)).mpr ⟨haux_1, hpu_aux⟩⟩
  let N : Kˣ → Kˣ := fun x => if EvenVal v₀ x then x else (p₀ * ε₀) * x
  have hN_ev : ∀ x : Kˣ, EvenVal v₀ (N x) := by
    intro x
    dsimp [N]
    split_ifs with hx
    · exact hx
    · exact (hloc_ev_mul (p₀ * ε₀) x).mpr (iff_of_false hn_ev_π hx)
  have hN_sq : ∀ x : Kˣ,
      IsAuxLocalCond K v₀ (p₀ * ε₀) x ↔
        IsSquare (algebraMap K (v₀.adicCompletion K) (N x : K)) := by
    intro x
    dsimp [N]
    split_ifs with hx
    · exact (and_iff_right hx).symm.trans (h_ev_aux_iff x)
    · have hnsq : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) :=
        fun h => hx (hloc_sq_ev x h)
      dsimp [IsAuxLocalCond]
      exact or_iff_right hnsq
  have h_aux_mul : ∀ x y : Kˣ,
      IsAuxLocalCond K v₀ (p₀ * ε₀) (x * y) ↔
        (IsAuxLocalCond K v₀ (p₀ * ε₀) x ↔ IsAuxLocalCond K v₀ (p₀ * ε₀) y) := by
    intro x y
    rw [hN_sq (x * y), hN_sq x, hN_sq y, ← hloc_sq_mul (N x) (N y) (hN_ev x) (hN_ev y)]
    by_cases hx : EvenVal v₀ x <;> by_cases hy : EvenVal v₀ y
    · have hxy : EvenVal v₀ (x * y) := (hloc_ev_mul x y).mpr (iff_of_true hx hy)
      have hNxy : N (x * y) = x * y := if_pos hxy
      have hNx : N x = x := if_pos hx
      have hNy : N y = y := if_pos hy
      rw [hNxy, hNx, hNy]
    · have hxy : ¬ EvenVal v₀ (x * y) := fun h => hy ((hloc_ev_mul x y).mp h |>.mp hx)
      have hNxy : N (x * y) = (p₀ * ε₀) * (x * y) := if_neg hxy
      have hNx : N x = x := if_pos hx
      have hNy : N y = (p₀ * ε₀) * y := if_neg hy
      rw [hNxy, hNx, hNy]
      have heq : (((p₀ * ε₀) * (x * y) : Kˣ) : K) = ((x * ((p₀ * ε₀) * y) : Kˣ) : K) := by
        simp only [Units.val_mul]
        ring
      rw [heq]
    · have hxy : ¬ EvenVal v₀ (x * y) := fun h => hx ((hloc_ev_mul x y).mp h |>.mpr hy)
      have hNxy : N (x * y) = (p₀ * ε₀) * (x * y) := if_neg hxy
      have hNx : N x = (p₀ * ε₀) * x := if_neg hx
      have hNy : N y = y := if_pos hy
      rw [hNxy, hNx, hNy]
      have heq : (((p₀ * ε₀) * (x * y) : Kˣ) : K) = ((((p₀ * ε₀) * x) * y : Kˣ) : K) := by
        simp only [Units.val_mul]
        ring
      rw [heq]
    · have hxy : EvenVal v₀ (x * y) := (hloc_ev_mul x y).mpr (iff_of_false hx hy)
      have hNxy : N (x * y) = x * y := if_pos hxy
      have hNx : N x = (p₀ * ε₀) * x := if_neg hx
      have hNy : N y = (p₀ * ε₀) * y := if_neg hy
      rw [hNxy, hNx, hNy]
      have hπ0 : algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) ≠ 0 :=
        (map_ne_zero_iff _ hinj).mpr (p₀ * ε₀).ne_zero
      have hπ2_ne : algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
          algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) ≠ 0 :=
        mul_ne_zero hπ0 hπ0
      have hπ2_sq : IsSquare (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
          algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) :=
        ⟨algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K), rfl⟩
      have heq : algebraMap K (v₀.adicCompletion K) ((((p₀ * ε₀) * x) * ((p₀ * ε₀) * y) : Kˣ) : K) =
          algebraMap K (v₀.adicCompletion K) ((x * y : Kˣ) : K) *
            (algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K) *
             algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K)) := by
        simp only [Units.val_mul, map_mul]
        ring
      rw [heq, h_isSquare_mul_iff _ _ hπ2_ne hπ2_sq]
  have hn_aux_ε₀ : ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) ε₀ :=
    fun h => hε₀_nsq ((h_ev_aux_iff ε₀).mp ⟨hev_ε₀, h⟩)
  have haux_π : IsAuxLocalCond K v₀ (p₀ * ε₀) (p₀ * ε₀) := by
    right
    exact ⟨algebraMap K (v₀.adicCompletion K) ((p₀ * ε₀ : Kˣ) : K), by simp⟩
  have h_hilb_iff : ∀ x y : Kˣ,
      hilbFin v₀ (x : K) (y : K) = 1 ↔
        ((¬ EvenVal v₀ x ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) y) ↔
         (¬ EvenVal v₀ y ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) x)) := by
    intro x y
    by_cases hx : EvenVal v₀ x <;> by_cases hy : EvenVal v₀ y
    · have h1 : hilbFin v₀ (x : K) (y : K) = 1 := hloc_ev_ev x y hx hy
      simp only [h1, hx, hy, not_true_eq_false, false_and]
    · have h_aux_x : IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) ↔
          IsAuxLocalCond K v₀ (p₀ * ε₀) x :=
        (h_ev_aux_iff x).symm.trans (and_iff_right hx)
      rw [(hloc_ev_odd x y hx hy).1, h_aux_x]
      simp only [hx, hy, not_true_eq_false, not_false_eq_true, false_and, true_and,
        false_iff, not_not]
    · have h_aux_y : IsSquare (algebraMap K (v₀.adicCompletion K) (y : K)) ↔
          IsAuxLocalCond K v₀ (p₀ * ε₀) y :=
        (h_ev_aux_iff y).symm.trans (and_iff_right hy)
      rw [(hloc_ev_odd y x hy hx).2, h_aux_y]
      simp only [hx, hy, not_true_eq_false, not_false_eq_true, false_and, true_and,
        iff_false, not_not]
    · rw [hloc_odd_odd x y hx hy]
      have heq : algebraMap K (v₀.adicCompletion K) ((-x * y : Kˣ) : K) =
          -(algebraMap K (v₀.adicCompletion K) ((x * y : Kˣ) : K)) := by
        simp only [Units.val_mul, Units.val_neg, map_mul, map_neg, neg_mul]
      have hxy_ev : EvenVal v₀ (x * y) := (hloc_ev_mul x y).mpr (iff_of_false hx hy)
      have h_aux_xy : IsSquare (algebraMap K (v₀.adicCompletion K) ((x * y : Kˣ) : K)) ↔
          (IsAuxLocalCond K v₀ (p₀ * ε₀) x ↔ IsAuxLocalCond K v₀ (p₀ * ε₀) y) :=
        (h_ev_aux_iff (x * y)).symm.trans ((and_iff_right hxy_ev).trans (h_aux_mul x y))
      rw [heq, h_isSquare_neg_iff, h_aux_xy]
      simp only [hx, hy, not_false_eq_true, true_and]
      exact ⟨fun h => ⟨mt h.mp, mt h.mpr⟩,
             fun h => ⟨fun hx' => Classical.byContradiction (fun hny => h.1 hny hx'),
                       fun hy' => Classical.byContradiction (fun hnx => h.2 hnx hy')⟩⟩
  have h_pr : ∀ r₁ r₂ : Kˣ,
      hilbFin v₀ (-(a₁ - a₂) * (a₂ - a₃) * (r₂ : K)) ((a₁ - a₂) * (a₁ - a₃) * (r₁ : K)) = 1 →
        ((¬ EvenVal v₀ r₁ ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) r₂) ↔
         (¬ EvenVal v₀ r₂ ∧ ¬ IsAuxLocalCond K v₀ (p₀ * ε₀) r₁)) := by
    intro r₁ r₂ hhilb
    have hA0 : -(a₁ - a₂) * (a₂ - a₃) ≠ 0 :=
      mul_ne_zero (neg_ne_zero.mpr (sub_ne_zero.mpr h₁₂)) (sub_ne_zero.mpr h₂₃)
    have hB0 : (a₁ - a₂) * (a₁ - a₃) ≠ 0 :=
      mul_ne_zero (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)
    let A_u : Kˣ := Units.mk0 (-(a₁ - a₂) * (a₂ - a₃)) hA0
    let B_u : Kˣ := Units.mk0 ((a₁ - a₂) * (a₁ - a₃)) hB0
    have hA_sq : IsSquare (algebraMap K (v₀.adicCompletion K) (A_u : K)) := by
      have heq : algebraMap K (v₀.adicCompletion K) (A_u : K) =
          algebraMap K (v₀.adicCompletion K) (-1 : K) *
            algebraMap K (v₀.adicCompletion K) (a₁ - a₂) *
            algebraMap K (v₀.adicCompletion K) (a₂ - a₃) := by
        simp [A_u]
      rw [heq]
      exact (hsq_neg1.mul hsq_12).mul hsq_23
    have hB_sq : IsSquare (algebraMap K (v₀.adicCompletion K) (B_u : K)) := by
      have heq : algebraMap K (v₀.adicCompletion K) (B_u : K) =
          algebraMap K (v₀.adicCompletion K) (a₁ - a₂) *
            algebraMap K (v₀.adicCompletion K) (a₁ - a₃) := by
        simp [B_u]
      rw [heq]
      exact hsq_12.mul hsq_13
    rcases (h_ev_aux_iff A_u).mpr hA_sq with ⟨hA_ev, hA_aux⟩
    rcases (h_ev_aux_iff B_u).mpr hB_sq with ⟨hB_ev, hB_aux⟩
    have hAr₂ : ((A_u * r₂ : Kˣ) : K) = -(a₁ - a₂) * (a₂ - a₃) * (r₂ : K) := by
      simp [A_u]
    have hBr₁ : ((B_u * r₁ : Kˣ) : K) = (a₁ - a₂) * (a₁ - a₃) * (r₁ : K) := by
      simp [B_u]
    rw [← hAr₂, ← hBr₁, h_hilb_iff (A_u * r₂) (B_u * r₁)] at hhilb
    have hev_Ar₂ : EvenVal v₀ (A_u * r₂) ↔ EvenVal v₀ r₂ := by
      rw [hloc_ev_mul A_u r₂]
      exact iff_true_left hA_ev
    have haux_Ar₂ : IsAuxLocalCond K v₀ (p₀ * ε₀) (A_u * r₂) ↔ IsAuxLocalCond K v₀ (p₀ * ε₀) r₂ := by
      rw [h_aux_mul A_u r₂]
      exact iff_true_left hA_aux
    have hev_Br₁ : EvenVal v₀ (B_u * r₁) ↔ EvenVal v₀ r₁ := by
      rw [hloc_ev_mul B_u r₁]
      exact iff_true_left hB_ev
    have haux_Br₁ : IsAuxLocalCond K v₀ (p₀ * ε₀) (B_u * r₁) ↔ IsAuxLocalCond K v₀ (p₀ * ε₀) r₁ := by
      rw [h_aux_mul B_u r₁]
      exact iff_true_left hB_aux
    rw [hev_Ar₂, haux_Br₁, hev_Br₁, haux_Ar₂] at hhilb
    exact hhilb.symm
  exact ⟨h_unif, h_ram_u, h_ram_ev_sq, h_ram_iff, h_ev_aux_iff, hloc_ev_mul, h_aux_mul,
    hev_1, haux_1, hev_ε₀, hn_aux_ε₀, hn_ev_π, haux_π, h_hilb_iff, h_pr⟩

theorem exists_adjoined_aux_prime_tuple_state (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₂ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₂_rk0 : IsRankZeroSelmerState K a₁ a₂ a₃ T S₂ π₂ κ₂)
    (hraw : IsRawAuxiliaryPrimeTuple K τ T S₂ p 𝔭)
    (hrec : IsAuxPrimeReciprocity K a₁ a₂ a₃ p 𝔭)
    (hcard_one : ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
       (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
           v.adicCompletion K),
      (selmerStruct K a₁ a₂ a₃ T S π).encard = 1 →
