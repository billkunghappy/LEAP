            _ = (s * algebraMap K (v₁.adicCompletion K) (π_u : K) /
                  algebraMap K (v₁.adicCompletion K) (α_u : K)) *
                (s * algebraMap K (v₁.adicCompletion K) (π_u : K) /
                  algebraMap K (v₁.adicCompletion K) (α_u : K)) := by ring
