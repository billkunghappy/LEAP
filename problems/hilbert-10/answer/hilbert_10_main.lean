          exact ⟨fun hd₁ => False.elim (hd₁_odd hd₁), fun hr2 => False.elim (hr2_odd hr2)⟩
        have hY_ev : EvenVal v₁ Y_u := by
          dsimp [Y_u]
          rw [hloc_ev_mul, hneg_ev_iff]
          exact ⟨fun hd₂ => False.elim (hd₂_odd hd₂), fun hr1 => False.elim (hr1_ev hr1)⟩
        have hA_odd : ¬ EvenVal v₁ (A_u r) := fun h => hr2_odd ((hA_u_ev r).mp h)
        have hB_odd : ¬ EvenVal v₁ (B_u r) := fun h => hr1_ev ((hB_u_ev r).mp h)
        obtain ⟨s, hs⟩ := (hloc_odd_odd (A_u r) (B_u r) hA_odd hB_odd).mp (hpr_units r hr_rel)
