    exact hunit_class u hu_val
  have hmem_odd_of_not_sq_val : ∀ d : (v.adicCompletion K)ˣ,
      ¬ IsSquare (Valued.v (d : v.adicCompletion K)) → sqCl d = e₂ ∨ sqCl d = e₃ := by
    intro d hnsq
    have hvd_ne : Valued.v (d : v.adicCompletion K) ≠ 0 :=
      (Valuation.ne_zero_iff Valued.v).mpr d.ne_zero
    obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hvd_ne
    let n : ℤ := Multiplicative.toAdd g
    have hvd : Valued.v (d : v.adicCompletion K) = WithZero.exp n := hg.symm
    rcases Int.even_or_odd n with ⟨k, hk⟩ | ⟨k, hk⟩
    · exfalso
      apply hnsq
      refine ⟨WithZero.exp k, ?_⟩
      rw [hvd, hk, WithZero.exp_add]
    · let u : (v.adicCompletion K)ˣ := d * ϖ * (ϖ ^ k) ^ 2
      have hu_val : Valued.v (u : v.adicCompletion K) = 1 := by
        change Valued.v ((d : v.adicCompletion K) * (ϖ : v.adicCompletion K) *
          (((ϖ ^ k : (v.adicCompletion K)ˣ) : v.adicCompletion K)) ^ 2) = 1
        rw [sq, Valuation.map_mul, Valuation.map_mul, Valuation.map_mul,
          hvd, hk, show Valued.v (ϖ : v.adicCompletion K) = WithZero.exp (-1 : ℤ) from hvπ,
          hv_zpow_ϖ k, ← WithZero.exp_add, ← WithZero.exp_add, ← WithZero.exp_add, ← WithZero.exp_zero]
        congr 1
        omega
      have hdu : sqCl (d * ϖ) = sqCl u := (hsqCl_mul_sq (d * ϖ) (ϖ ^ k)).symm
      rcases hunit_class u hu_val with hu1 | hue₁
      · left
        have hdϖ : sqCl (d * ϖ) = sqCl 1 := hdu.trans hu1
        have hd_eq : sqCl d = sqCl (1 * ϖ) := hsqCl_mul_right d 1 ϖ hdϖ
        rw [one_mul] at hd_eq
        exact hd_eq
      · right
        have hdϖ : sqCl (d * ϖ) = sqCl u_ε := hdu.trans hue₁
        exact hsqCl_mul_right d u_ε ϖ hdϖ
  have hmem_Unr_iff : ∀ d : (v.adicCompletion K)ˣ,
      sqCl d ∈ U_nr ↔ IsSquare (Valued.v (d : v.adicCompletion K)) := by
    intro d
    constructor
    · rintro (hd1 | hde₁)
      · have hd1' : sqCl d = sqCl 1 := hd1
        refine (hsq_val_of_sqCl_eq d 1 hd1').mpr ⟨1, ?_⟩
        simp
      · refine (hsq_val_of_sqCl_eq d u_ε hde₁).mpr ⟨1, ?_⟩
        change Valued.v (algebraMap K (v.adicCompletion K) (ε : K)) = 1 * 1
        rw [hvε, mul_one]
    · exact hmem_Unr_of_sq_val d
  have hnot_sq_exp_neg_one : ¬ IsSquare (WithZero.exp (-1 : ℤ)) := by
    rintro ⟨r, hr⟩
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr
      exact WithZero.coe_ne_zero hr
    obtain ⟨g, rfl⟩ := WithZero.ne_zero_iff_exists.mp hr_ne
    change WithZero.exp (-1 : ℤ) =
      WithZero.exp (Multiplicative.toAdd g) * WithZero.exp (Multiplicative.toAdd g) at hr
    rw [← WithZero.exp_add, WithZero.exp_inj] at hr
    omega
  have he₂_notMem : e₂ ∉ U_nr := by
    rw [hmem_Unr_iff ϖ]
    change ¬ IsSquare (Valued.v (algebraMap K (v.adicCompletion K) π_K))
    rw [hvπ]
    exact hnot_sq_exp_neg_one
  have he₃_notMem : e₃ ∉ U_nr := by
    rw [hmem_Unr_iff (u_ε * ϖ), Units.val_mul, Valuation.map_mul]
    change ¬ IsSquare (Valued.v (algebraMap K (v.adicCompletion K) (ε : K)) *
      Valued.v (algebraMap K (v.adicCompletion K) π_K))
    rw [hvε, hvπ, one_mul]
    exact hnot_sq_exp_neg_one
  have he₃_ne_e₂ : e₃ ≠ e₂ := by
    intro h_eq
    have h' : sqCl u_ε = sqCl (ϖ * ϖ) := hsqCl_mul_right u_ε ϖ ϖ h_eq
    have h'' : sqCl (ϖ * ϖ) = 1 := by
      rw [← sq]
      exact hsqCl_sq_eq_one ϖ
    exact h1_ne_e₁ (h'.trans h'').symm
  have hUnr_fin : U_nr.Finite := (Set.finite_singleton e₁).insert 1
  have hUnr_ncard : U_nr.ncard = 2 := Set.ncard_pair h1_ne_e₁
  have h_univ : (Set.univ : Set (SqCl (v.adicCompletion K))) = {e₃, e₂, 1, e₁} := by
    ext c
    simp only [Set.mem_univ, Set.mem_insert_iff, Set.mem_singleton_iff, true_iff]
    obtain ⟨d, rfl⟩ : ∃ d : (v.adicCompletion K)ˣ, sqCl d = c :=
      QuotientGroup.induction_on c (fun d => ⟨d, rfl⟩)
    by_cases hsq : IsSquare (Valued.v (d : v.adicCompletion K))
    · rcases hmem_Unr_of_sq_val d hsq with hd1 | hde₁
      · exact Or.inr (Or.inr (Or.inl hd1))
      · exact Or.inr (Or.inr (Or.inr hde₁))
    · rcases hmem_odd_of_not_sq_val d hsq with hde₂ | hde₃
      · exact Or.inr (Or.inl hde₂)
      · exact Or.inl hde₃
  have hSqCl_card : Nat.card (SqCl (v.adicCompletion K)) = 4 := by
    rw [← Set.ncard_univ, h_univ]
    have hfin2 : ({e₂, 1, e₁} : Set (SqCl (v.adicCompletion K))).Finite :=
      hUnr_fin.insert e₂
    have he₃_notMem2 : e₃ ∉ ({e₂, 1, e₁} : Set (SqCl (v.adicCompletion K))) := by
      rintro (h_eq | h_mem)
      · exact he₃_ne_e₂ h_eq
      · exact he₃_notMem h_mem
    rw [Set.ncard_insert_of_notMem he₃_notMem2 hfin2,
      Set.ncard_insert_of_notMem he₂_notMem hUnr_fin, hUnr_ncard]
  let D_v : Set (SqCl (v.adicCompletion K) × SqCl (v.adicCompletion K)) :=
    { c : SqCl (v.adicCompletion K) × SqCl (v.adicCompletion K) |
      ∃ d₁ d₂ : (v.adicCompletion K)ˣ,
        c = (sqCl d₁, sqCl d₂) ∧
        IsDescentClass
          (algebraMap K (v.adicCompletion K) a₁)
          (algebraMap K (v.adicCompletion K) a₂)
          (algebraMap K (v.adicCompletion K) a₃)
          (d₁ : v.adicCompletion K)
          (d₂ : v.adicCompletion K) }
  have hD_sub : D_v ⊆ U_nr ×ˢ U_nr := by
    rintro c ⟨d₁, d₂, rfl, hdesc⟩
    obtain ⟨hsq₁, hsq₂⟩ := hdesc_even d₁ d₂ hdesc
    exact ⟨(hmem_Unr_iff d₁).mpr hsq₁, (hmem_Unr_iff d₂).mpr hsq₂⟩
  have hprod_fin : (U_nr ×ˢ U_nr).Finite := hUnr_fin.prod hUnr_fin
  have hprod_ncard : (U_nr ×ˢ U_nr).ncard = 4 := by
    rw [Set.ncard_prod, hUnr_ncard]
  have hD_ncard : D_v.ncard = 4 := by
    have hprop := proposition_4_1 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ v
    change D_v.ncard = Nat.card (SqCl (v.adicCompletion K)) at hprop
    rw [hprop, hSqCl_card]
  have hD_eq : D_v = U_nr ×ˢ U_nr :=
    Set.eq_of_subset_of_ncard_le hD_sub (by omega) hprod_fin
  let d₁ : (v.adicCompletion K)ˣ := Units.map (algebraMap K (v.adicCompletion K) : K →* v.adicCompletion K) p.1
  let d₂ : (v.adicCompletion K)ˣ := Units.map (algebraMap K (v.adicCompletion K) : K →* v.adicCompletion K) p.2
  constructor
  · intro hdesc
    obtain ⟨hsq₁, hsq₂⟩ := hdesc_even d₁ d₂ hdesc
    exact ⟨(heven_iff p.1).mpr hsq₁, (heven_iff p.2).mpr hsq₂⟩
  · rintro ⟨hev₁, hev₂⟩
    have hmem_prod : (sqCl d₁, sqCl d₂) ∈ U_nr ×ˢ U_nr :=
      ⟨(hmem_Unr_iff d₁).mpr ((heven_iff p.1).mp hev₁),
       (hmem_Unr_iff d₂).mpr ((heven_iff p.2).mp hev₂)⟩
    rw [← hD_eq] at hmem_prod
    rcases hmem_prod with ⟨d₁', d₂', hpair_eq, hdesc'⟩
    obtain ⟨h₁, h₂⟩ := Prod.mk.injEq (sqCl d₁) (sqCl d₂) (sqCl d₁') (sqCl d₂') ▸ hpair_eq
    exact hdesc_of_sqCl_eq d₁' d₂' d₁ d₂ h₁.symm h₂.symm hdesc'

theorem local_descent_implies_evenVal (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (hint₁ : IsIntegral ℤ a₁) (hint₂ : IsIntegral ℤ a₂) (hint₃ : IsIntegral ℤ a₃)
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hT : IsGoodT a₁ a₂ a₃ T)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hvT : v ∉ T) :
    (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1 ∧
    ∀ d₁ d₂ : (v.adicCompletion K)ˣ,
      IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (d₁ : v.adicCompletion K)
        (d₂ : v.adicCompletion K) →
      IsSquare (Valued.v (d₁ : v.adicCompletion K)) ∧
      IsSquare (Valued.v (d₂ : v.adicCompletion K)) :=
by
  let A₁_int : NumberField.RingOfIntegers K := ⟨a₁, hint₁⟩
  let A₂_int : NumberField.RingOfIntegers K := ⟨a₂, hint₂⟩
  let A₃_int : NumberField.RingOfIntegers K := ⟨a₃, hint₃⟩
  have hval2_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 ≤ 1 := by
    have := v.valuation_le_one (K := K) (2 : NumberField.RingOfIntegers K)
    simpa using this
  have hval3_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 3 ≤ 1 := by
    have := v.valuation_le_one (K := K) (3 : NumberField.RingOfIntegers K)
    simpa using this
  have hval6_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 ≤ 1 := by
    have := v.valuation_le_one (K := K) (6 : NumberField.RingOfIntegers K)
    simpa using this
  have hval12_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 := by
    have := v.valuation_le_one (K := K) (A₁_int - A₂_int)
    simpa [A₁_int, A₂_int] using this
  have hval13_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 := by
    have := v.valuation_le_one (K := K) (A₁_int - A₃_int)
    simpa [A₁_int, A₃_int] using this
  have hval23_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) ≤ 1 := by
    have := v.valuation_le_one (K := K) (A₂_int - A₃_int)
    simpa [A₂_int, A₃_int] using this
  have hgood : (IsDedekindDomain.HeightOneSpectrum.valuation K v)
      (6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)) = 1 := by
    have := (hT v).not.mp hvT
    exact not_ne_iff.mp this
  rw [map_mul, map_mul, map_mul] at hgood
  have h_le_prod1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 :=
    (mul_le_of_le_one_right' hval12_le).trans hval6_le
  have h_le_prod2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 :=
    (mul_le_of_le_one_right' hval13_le).trans h_le_prod1
  have hval23 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) = 1 :=
    le_antisymm hval23_le (by rw [← hgood]; exact mul_le_of_le_one_left' h_le_prod2)
  have hgood2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 := by
    rw [hval23, mul_one] at hgood
    exact hgood
  have hval13 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 :=
    le_antisymm hval13_le (by rw [← hgood2]; exact mul_le_of_le_one_left' h_le_prod1)
  have hgood1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 := by
    rw [hval13, mul_one] at hgood2
    exact hgood2
  have hval12 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 :=
    le_antisymm hval12_le (by rw [← hgood1]; exact mul_le_of_le_one_left' hval6_le)
  have hval6 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 = 1 := by
    rw [hval12, mul_one] at hgood1
    exact hgood1
  have hval23_prod : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 *
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) 3 = 1 := by
    rw [← map_mul, show (2 : K) * 3 = 6 by norm_num, hval6]
  have hval2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1 :=
    le_antisymm hval2_le (by rw [← hval23_prod]; exact mul_le_of_le_one_right' hval3_le)
  have hv_eq : ∀ k : K, Valued.v (algebraMap K (v.adicCompletion K) k) =
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) k :=
    fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v k
  have hv21 : Valued.v (algebraMap K (v.adicCompletion K) a₂ -
      algebraMap K (v.adicCompletion K) a₁) = 1 := by
    rw [← map_sub, show a₂ - a₁ = -(a₁ - a₂) by ring, map_neg, Valuation.map_neg, hv_eq, hval12]
  have hv31 : Valued.v (algebraMap K (v.adicCompletion K) a₃ -
      algebraMap K (v.adicCompletion K) a₁) = 1 := by
    rw [← map_sub, show a₃ - a₁ = -(a₁ - a₃) by ring, map_neg, Valuation.map_neg, hv_eq, hval13]
  have hv32 : Valued.v (algebraMap K (v.adicCompletion K) a₃ -
      algebraMap K (v.adicCompletion K) a₂) = 1 := by
    rw [← map_sub, show a₃ - a₂ = -(a₂ - a₃) by ring, map_neg, Valuation.map_neg, hv_eq, hval23]
  have h_sq_mul_sq : ∀ (d z : v.adicCompletion K),
      IsSquare (Valued.v d) → IsSquare (Valued.v (d * z ^ 2)) := by
    rintro d z ⟨r, hr⟩
    refine ⟨r * Valued.v z, ?_⟩
    rw [map_mul, sq, map_mul, hr]
    ac_rfl
  have h_zero_of_not_sq_mul_sq : ∀ (d z : v.adicCompletion K),
      ¬ IsSquare (Valued.v d) → IsSquare (Valued.v (d * z ^ 2)) → d * z ^ 2 = 0 := by
    intro d z hd ⟨r, hr⟩
    by_cases hz : z = 0
    · simp [hz]
    · exfalso
      have hzv : Valued.v z ≠ 0 := (Valuation.ne_zero_iff Valued.v).mpr hz
      have h1 : Valued.v d * (Valued.v z * Valued.v z) = r * r := by
        simpa [sq, map_mul] using hr
      have h2 : Valued.v d = (r * (Valued.v z)⁻¹) * (r * (Valued.v z)⁻¹) := by
        calc Valued.v d
          _ = Valued.v d * (Valued.v z * (Valued.v z)⁻¹) * (Valued.v z * (Valued.v z)⁻¹) := by
              rw [mul_inv_cancel₀ hzv, mul_one, mul_one]
          _ = (Valued.v d * (Valued.v z * Valued.v z)) * ((Valued.v z)⁻¹ * (Valued.v z)⁻¹) := by
              ac_rfl
          _ = (r * r) * ((Valued.v z)⁻¹ * (Valued.v z)⁻¹) := by rw [h1]
          _ = (r * (Valued.v z)⁻¹) * (r * (Valued.v z)⁻¹) := by ac_rfl
      exact hd ⟨r * (Valued.v z)⁻¹, h2⟩
  have h_not_sq_mul_of_not_sq_of_sq : ∀ (γ₁ γ₂ : WithZero (Multiplicative ℤ)),
      γ₂ ≠ 0 → ¬ IsSquare γ₁ → IsSquare γ₂ → ¬ IsSquare (γ₁ * γ₂) := by
    rintro γ₁ γ₂ hγ₂_ne h1 ⟨s, rfl⟩ ⟨r, hr⟩
    have hs_ne : s ≠ 0 := by
      rintro rfl
      exact hγ₂_ne (mul_zero 0)
    have h2 : γ₁ = (r * s⁻¹) * (r * s⁻¹) := by
      calc γ₁
        _ = γ₁ * (s * s⁻¹) * (s * s⁻¹) := by rw [mul_inv_cancel₀ hs_ne, mul_one, mul_one]
        _ = (γ₁ * (s * s)) * (s⁻¹ * s⁻¹) := by ac_rfl
        _ = (r * r) * (s⁻¹ * s⁻¹) := by rw [hr]
        _ = (r * s⁻¹) * (r * s⁻¹) := by ac_rfl
    exact h1 ⟨r * s⁻¹, h2⟩
  have h_sq_mul_of_not_sq_of_not_sq : ∀ (γ₁ γ₂ : WithZero (Multiplicative ℤ)),
      γ₁ ≠ 0 → γ₂ ≠ 0 → ¬ IsSquare γ₁ → ¬ IsSquare γ₂ → IsSquare (γ₁ * γ₂) := by
    intro γ₁ γ₂ hγ₁_ne hγ₂_ne h1 h2
    obtain ⟨g₁, rfl⟩ := WithZero.ne_zero_iff_exists.mp hγ₁_ne
    obtain ⟨g₂, rfl⟩ := WithZero.ne_zero_iff_exists.mp hγ₂_ne
    have hn₁ : ¬ Even (Multiplicative.toAdd g₁) := by
      rintro ⟨k, hk⟩
      apply h1
      refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
      rw [← WithZero.coe_mul, ← ofAdd_add, ← hk, ofAdd_toAdd]
    have hn₂ : ¬ Even (Multiplicative.toAdd g₂) := by
      rintro ⟨k, hk⟩
      apply h2
      refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
      rw [← WithZero.coe_mul, ← ofAdd_add, ← hk, ofAdd_toAdd]
    have heven : Even (Multiplicative.toAdd g₁ + Multiplicative.toAdd g₂) := by
      rcases Int.even_or_odd (Multiplicative.toAdd g₁) with h | ⟨l₁, hl₁⟩
      · exact False.elim (hn₁ h)
      · rcases Int.even_or_odd (Multiplicative.toAdd g₂) with h | ⟨l₂, hl₂⟩
        · exact False.elim (hn₂ h)
        · exact ⟨l₁ + l₂ + 1, by omega⟩
    obtain ⟨k, hk⟩ := heven
    refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
    rw [← WithZero.coe_mul, ← WithZero.coe_mul, WithZero.coe_inj, ← ofAdd_add, ← hk,
      ofAdd_add, ofAdd_toAdd, ofAdd_toAdd]
  have h_lt_of_not_sq_diff : ∀ (X Y : v.adicCompletion K) (R : WithZero (Multiplicative ℤ)),
      (IsSquare (Valued.v X) → X = 0) →
      IsSquare (Valued.v Y) →
      IsSquare R →
      Valued.v (X - Y) = R →
      R ≠ 0 →
      Valued.v X < R := by
    intro X Y R hX hY hR hdY hR_ne
    have hXR : Valued.v X ≠ R := by
      intro h_eq
      have hX0 : X = 0 := hX (h_eq ▸ hR)
      rw [hX0, Valuation.map_zero] at h_eq
      exact hR_ne h_eq.symm
    have hXY : Valued.v X ≠ Valued.v (-Y) := by
      intro h_eq
      rw [Valuation.map_neg] at h_eq
      have hX0 : X = 0 := hX (h_eq.symm ▸ hY)
      rw [hX0, Valuation.map_zero] at h_eq
      have hY0 : Y = 0 := (Valuation.zero_iff Valued.v).mp h_eq.symm
      rw [hX0, hY0, sub_self, Valuation.map_zero] at hdY
      exact hR_ne hdY.symm
    have hmax : R = max (Valued.v X) (Valued.v (-Y)) := by
      rw [← hdY, sub_eq_add_neg]
      exact Valuation.map_add_of_distinct_val Valued.v hXY
    have hle : Valued.v X ≤ R := by
      rw [hmax]
      exact le_max_left _ _
    exact lt_of_le_of_ne hle hXR
  have h_ultrametric_elim : ∀ (X₁ X₂ Y : v.adicCompletion K) (R : WithZero (Multiplicative ℤ)),
      (IsSquare (Valued.v X₁) → X₁ = 0) →
      (IsSquare (Valued.v X₂) → X₂ = 0) →
      IsSquare (Valued.v Y) →
      IsSquare R →
      Valued.v (X₁ - Y) = R →
      Valued.v (X₂ - Y) = R →
      Valued.v (X₁ - X₂) = R →
      R = 0 ∧ X₁ = 0 ∧ X₂ = 0 ∧ Y = 0 := by
    intro X₁ X₂ Y R hX₁ hX₂ hY hR hd₁Y hd₂Y hd₁₂
    have hR0 : R = 0 := by
      by_contra hR_ne
      have hlt₁ : Valued.v X₁ < R := h_lt_of_not_sq_diff X₁ Y R hX₁ hY hR hd₁Y hR_ne
      have hlt₂ : Valued.v X₂ < R := h_lt_of_not_sq_diff X₂ Y R hX₂ hY hR hd₂Y hR_ne
      have hle : R ≤ max (Valued.v X₁) (Valued.v X₂) := by
        rw [← hd₁₂]
        exact Valuation.map_sub Valued.v X₁ X₂
      exact lt_irrefl R (lt_of_le_of_lt hle (max_lt hlt₁ hlt₂))
    have hX₁Y : X₁ = Y := by
      rw [hR0] at hd₁Y
      exact sub_eq_zero.mp ((Valuation.zero_iff Valued.v).mp hd₁Y)
    have hX₂Y : X₂ = Y := by
      rw [hR0] at hd₂Y
      exact sub_eq_zero.mp ((Valuation.zero_iff Valued.v).mp hd₂Y)
    have hX₁0 : X₁ = 0 := hX₁ (hX₁Y.symm ▸ hY)
    have hY0 : Y = 0 := hX₁Y.symm.trans hX₁0
    have hX₂0 : X₂ = 0 := hX₂Y.trans hY0
    exact ⟨hR0, hX₁0, hX₂0, hY0⟩
  refine ⟨hval2, ?_⟩
  rintro d₁ d₂ ⟨z₀, z₁, z₂, z₃, h_not_all_zero, heq₁, heq₂⟩
  let A₁ : v.adicCompletion K := (d₁ : v.adicCompletion K) * z₁ ^ 2
  let A₂ : v.adicCompletion K := (d₂ : v.adicCompletion K) * z₂ ^ 2
  let A₃ : v.adicCompletion K := ((d₁ : v.adicCompletion K) * (d₂ : v.adicCompletion K)) * z₃ ^ 2
  let R : WithZero (Multiplicative ℤ) := Valued.v (z₀ ^ 2)
  have hR : IsSquare R := ⟨Valued.v z₀, by dsimp [R]; rw [sq, map_mul]⟩
  have heq₃ : A₂ - A₃ =
      (algebraMap K (v.adicCompletion K) a₃ - algebraMap K (v.adicCompletion K) a₂) * z₀ ^ 2 := by
    dsimp [A₁, A₂, A₃] at heq₁ heq₂ ⊢
    linear_combination heq₂ - heq₁
  have hd12 : Valued.v (A₁ - A₂) = R := by
    dsimp [A₁, A₂, R]
    rw [heq₁, map_mul, hv21, one_mul]
  have hd21 : Valued.v (A₂ - A₁) = R := by
    rw [Valuation.map_sub_swap, hd12]
  have hd13 : Valued.v (A₁ - A₃) = R := by
    dsimp [A₁, A₃, R]
    rw [heq₂, map_mul, hv31, one_mul]
  have hd31 : Valued.v (A₃ - A₁) = R := by
    rw [Valuation.map_sub_swap, hd13]
  have hd23 : Valued.v (A₂ - A₃) = R := by
    dsimp [R]
    rw [heq₃, map_mul, hv32, one_mul]
  have hd32 : Valued.v (A₃ - A₂) = R := by
    rw [Valuation.map_sub_swap, hd23]
  have hd₁_ne : (d₁ : v.adicCompletion K) ≠ 0 := d₁.ne_zero
  have hd₂_ne : (d₂ : v.adicCompletion K) ≠ 0 := d₂.ne_zero
  have hd₁₂_ne : (d₁ : v.adicCompletion K) * (d₂ : v.adicCompletion K) ≠ 0 :=
    mul_ne_zero hd₁_ne hd₂_ne
  have hvd₁_ne : Valued.v (d₁ : v.adicCompletion K) ≠ 0 :=
    (Valuation.ne_zero_iff Valued.v).mpr hd₁_ne
  have hvd₂_ne : Valued.v (d₂ : v.adicCompletion K) ≠ 0 :=
    (Valuation.ne_zero_iff Valued.v).mpr hd₂_ne
  have h_contra_of_all_zero : R = 0 → A₁ = 0 → A₂ = 0 → A₃ = 0 → False := by
    intro hR0 hA₁0 hA₂0 hA₃0
    have hz₀0 : z₀ = 0 := by
      have hz₀2 : z₀ ^ 2 = 0 := (Valuation.zero_iff Valued.v).mp hR0
      exact pow_eq_zero hz₀2
    have hz₁0 : z₁ = 0 := by
      rcases mul_eq_zero.mp hA₁0 with h | h
      · exact False.elim (hd₁_ne h)
      · exact pow_eq_zero h
    have hz₂0 : z₂ = 0 := by
      rcases mul_eq_zero.mp hA₂0 with h | h
      · exact False.elim (hd₂_ne h)
      · exact pow_eq_zero h
    have hz₃0 : z₃ = 0 := by
      rcases mul_eq_zero.mp hA₃0 with h | h
      · exact False.elim (hd₁₂_ne h)
      · exact pow_eq_zero h
    exact h_not_all_zero ⟨hz₀0, hz₁0, hz₂0, hz₃0⟩
  by_cases hsq₁ : IsSquare (Valued.v (d₁ : v.adicCompletion K))
  · by_cases hsq₂ : IsSquare (Valued.v (d₂ : v.adicCompletion K))
    · exact ⟨hsq₁, hsq₂⟩
    · exfalso
      have hsq₁₂ : ¬ IsSquare (Valued.v ((d₁ : v.adicCompletion K) * (d₂ : v.adicCompletion K))) := by
        rw [map_mul, mul_comm]
        exact h_not_sq_mul_of_not_sq_of_sq _ _ hvd₁_ne hsq₂ hsq₁
      obtain ⟨hR0, hA₂0, hA₃0, hA₁0⟩ :=
        h_ultrametric_elim A₂ A₃ A₁ R
          (h_zero_of_not_sq_mul_sq _ _ hsq₂)
          (h_zero_of_not_sq_mul_sq _ _ hsq₁₂)
          (h_sq_mul_sq _ _ hsq₁)
          hR hd21 hd31 hd23
      exact h_contra_of_all_zero hR0 hA₁0 hA₂0 hA₃0
  · by_cases hsq₂ : IsSquare (Valued.v (d₂ : v.adicCompletion K))
    · exfalso
      have hsq₁₂ : ¬ IsSquare (Valued.v ((d₁ : v.adicCompletion K) * (d₂ : v.adicCompletion K))) := by
        rw [map_mul]
        exact h_not_sq_mul_of_not_sq_of_sq _ _ hvd₂_ne hsq₁ hsq₂
      obtain ⟨hR0, hA₁0, hA₃0, hA₂0⟩ :=
        h_ultrametric_elim A₁ A₃ A₂ R
          (h_zero_of_not_sq_mul_sq _ _ hsq₁)
          (h_zero_of_not_sq_mul_sq _ _ hsq₁₂)
          (h_sq_mul_sq _ _ hsq₂)
          hR hd12 hd32 hd13
      exact h_contra_of_all_zero hR0 hA₁0 hA₂0 hA₃0
    · exfalso
      have hsq₁₂ : IsSquare (Valued.v ((d₁ : v.adicCompletion K) * (d₂ : v.adicCompletion K))) := by
        rw [map_mul]
        exact h_sq_mul_of_not_sq_of_not_sq _ _ hvd₁_ne hvd₂_ne hsq₁ hsq₂
      obtain ⟨hR0, hA₁0, hA₂0, hA₃0⟩ :=
        h_ultrametric_elim A₁ A₂ A₃ R
          (h_zero_of_not_sq_mul_sq _ _ hsq₁)
          (h_zero_of_not_sq_mul_sq _ _ hsq₂)
          (h_sq_mul_sq _ _ hsq₁₂)
          hR hd13 hd23 hd12
      exact h_contra_of_all_zero hR0 hA₁0 hA₂0 hA₃0

theorem selmerStruct_empty_encard_eq_four_pow (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T) :
    ∃ m : ℕ, (selmerStruct K a₁ a₂ a₃ T ∅ π).encard = 4 ^ m :=
by
  rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _, _,
    _, _, _, _, _, _, _, _, _, _, _, _, hroot⟩
  have hloc_iff : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∉ T → ∀ p : Kˣ × Kˣ,
      IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (algebraMap K (v.adicCompletion K) (p.1 : K))
        (algebraMap K (v.adicCompletion K) (p.2 : K)) ↔
      EvenVal v p.1 ∧ EvenVal v p.2 := by
    intro v hvT p
    have hv := local_descent_implies_evenVal K a₁ a₂ a₃ hint₁ hint₂ hint₃ T hT v hvT
    exact isDescentClass_iff_evenVal_of_notMem_T K a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ v hv.1
      (isSquare_one_add_of_valuation_lt_one K v hv.1)
      (exists_nonSquare_unit_mod_ideal K v hv.1)
      (exists_ringOfIntegers_sub_valuation_lt_one K v)
      hv.2 p
  have hsel_eq : selmerStruct K a₁ a₂ a₃ T ∅ π = twoSelmerSet K a₁ a₂ a₃ := by
    unfold selmerStruct twoSelmerSet
    congr 1
    ext p
    simp only [Set.mem_setOf_eq]
    constructor
    · rintro ⟨h1, h2, _, h4⟩
      refine ⟨?_, h2⟩
      intro v
      by_cases hvT : v ∈ T
      · exact h1 v hvT
      · exact (hloc_iff v hvT p).mpr (h4 v hvT (Finset.notMem_empty v))
    · rintro ⟨h1, h2⟩
      refine ⟨fun v hvT => h1 v, h2,
        fun v hvS => False.elim (Finset.notMem_empty v hvS),
        fun v hvT _ => (hloc_iff v hvT p).mp (h1 v)⟩
  obtain ⟨d, hd_card, hd_sign⟩ := corollary_3_6 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃
  rw [hroot] at hd_sign
  rcases Nat.even_or_odd d with ⟨m, rfl⟩ | ⟨m, rfl⟩
  · refine ⟨m, ?_⟩
    rw [hsel_eq, hd_card, ← two_mul, pow_mul]
    rfl
  · exfalso
    have hpow : (-1 : ℤˣ) ^ (2 * m + 1) = -1 := by
      rw [pow_add, pow_mul, pow_one]
      have hsq : (-1 : ℤˣ) ^ 2 = 1 := by decide
      rw [hsq, one_pow, one_mul]
    rw [hpow] at hd_sign
    revert hd_sign
    decide

theorem selmer_local_mul_closure (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ) :
    IsLocalMulClosed K a₁ a₂ a₃ :=
by
  have sqCl_eq_of_eq_mul_sq : ∀ {F : Type u} [Field F] (u v : Fˣ) (r : F),
      (u : F) = (v : F) * r ^ 2 → sqCl u = sqCl v := by
    intro F _ u v r hr
    have hr0 : r ≠ 0 := by
      rintro rfl
      simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero] at hr
      exact u.ne_zero hr
    change QuotientGroup.mk u = QuotientGroup.mk v
    rw [QuotientGroup.eq]
    refine ⟨Units.mk0 r⁻¹ (inv_ne_zero hr0), ?_⟩
    ext
    have hu0 : (u : F) ≠ 0 := u.ne_zero
    have hv0 : (v : F) ≠ 0 := v.ne_zero
    simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_mul, Units.val_inv_eq_inv_val]
    field_simp
    linear_combination hr
  have isDescentClass_of_sqCl_eq : ∀ {F : Type u} [Field F] {e₁ e₂ e₃ : F}
      {u₁ u₂ d₁ d₂ : Fˣ}, sqCl u₁ = sqCl d₁ → sqCl u₂ = sqCl d₂ →
      IsDescentClass e₁ e₂ e₃ (u₁ : F) (u₂ : F) →
      IsDescentClass e₁ e₂ e₃ (d₁ : F) (d₂ : F) := by
    intro F _ e₁ e₂ e₃ u₁ u₂ d₁ d₂ h₁ h₂ hdesc
    change QuotientGroup.mk u₁ = QuotientGroup.mk d₁ at h₁
    rw [QuotientGroup.eq] at h₁
    rcases h₁ with ⟨s₁, hs₁⟩
    change s₁ ^ 2 = u₁⁻¹ * d₁ at hs₁
    have hs₁' : (d₁ : F) = (u₁ : F) * (s₁ : F) ^ 2 := by
      have h := congrArg (Units.val : Fˣ → F) hs₁
      have hu₁0 : (u₁ : F) ≠ 0 := u₁.ne_zero
      simp only [Units.val_pow_eq_pow_val, Units.val_mul, Units.val_inv_eq_inv_val] at h
      field_simp at h
      linear_combination -h
    change QuotientGroup.mk u₂ = QuotientGroup.mk d₂ at h₂
    rw [QuotientGroup.eq] at h₂
    rcases h₂ with ⟨s₂, hs₂⟩
    change s₂ ^ 2 = u₂⁻¹ * d₂ at hs₂
    have hs₂' : (d₂ : F) = (u₂ : F) * (s₂ : F) ^ 2 := by
      have h := congrArg (Units.val : Fˣ → F) hs₂
      have hu₂0 : (u₂ : F) ≠ 0 := u₂.ne_zero
      simp only [Units.val_pow_eq_pow_val, Units.val_mul, Units.val_inv_eq_inv_val] at h
      field_simp at h
      linear_combination -h
    rcases hdesc with ⟨z₀, z₁, z₂, z₃, hnz, hq₁, hq₂⟩
    have hs₁0 : (s₁ : F) ≠ 0 := s₁.ne_zero
    have hs₂0 : (s₂ : F) ≠ 0 := s₂.ne_zero
    refine ⟨z₀, z₁ / (s₁ : F), z₂ / (s₂ : F), z₃ / ((s₁ : F) * (s₂ : F)), ?_, ?_, ?_⟩
    · rintro ⟨hz₀, hz₁, hz₂, hz₃⟩
      rw [div_eq_zero_iff] at hz₁ hz₂ hz₃
      exact hnz ⟨hz₀, hz₁.resolve_right hs₁0, hz₂.resolve_right hs₂0,
        hz₃.resolve_right (mul_ne_zero hs₁0 hs₂0)⟩
    · rw [hs₁', hs₂']
      field_simp
      linear_combination hq₁
    · rw [hs₁', hs₂']
      field_simp
      linear_combination hq₂
  have isDescentClass_mul : ∀ {F : Type u} [Field F] [CharZero F]
      {e₁ e₂ e₃ : F}, e₁ ≠ e₂ → e₁ ≠ e₃ → e₂ ≠ e₃ →
      ∀ (x₁ x₂ y₁ y₂ : Fˣ),
      IsDescentClass e₁ e₂ e₃ (x₁ : F) (x₂ : F) →
      IsDescentClass e₁ e₂ e₃ (y₁ : F) (y₂ : F) →
      IsDescentClass e₁ e₂ e₃ ((x₁ * y₁ : Fˣ) : F) ((x₂ * y₂ : Fˣ) : F) := by
    intro F _ _ e₁ e₂ e₃ h₁₂ h₁₃ h₂₃ x₁ x₂ y₁ y₂ hx hy
    classical
    have h12 : e₁ - e₂ ≠ 0 := sub_ne_zero.mpr h₁₂
    have h13 : e₁ - e₃ ≠ 0 := sub_ne_zero.mpr h₁₃
    have h23 : e₂ - e₃ ≠ 0 := sub_ne_zero.mpr h₂₃
    have h21 : e₂ - e₁ ≠ 0 := sub_ne_zero.mpr h₁₂.symm
    have h31 : e₃ - e₁ ≠ 0 := sub_ne_zero.mpr h₁₃.symm
    have h32 : e₃ - e₂ ≠ 0 := sub_ne_zero.mpr h₂₃.symm
    let u₁₁ : Fˣ := Units.mk0 ((e₁ - e₂) * (e₁ - e₃)) (mul_ne_zero h12 h13)
    let u₁₂ : Fˣ := Units.mk0 (e₁ - e₂) h12
    let u₂₁ : Fˣ := Units.mk0 (-(e₁ - e₂)) (neg_ne_zero.mpr h12)
    let u₂₂ : Fˣ := Units.mk0 (-((e₁ - e₂) * (e₂ - e₃))) (neg_ne_zero.mpr (mul_ne_zero h12 h23))
    let u₃₁ : Fˣ := Units.mk0 (e₃ - e₁) h31
    let u₃₂ : Fˣ := Units.mk0 (e₃ - e₂) h32
    have hns₁ : (threeRootsCurve e₁ e₂ e₃).toAffine.Nonsingular e₁ 0 := by
      rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
      refine ⟨by dsimp [threeRootsCurve]; ring, Or.inl ?_⟩
      dsimp [threeRootsCurve]
      intro h
      exact mul_ne_zero h12 h13 (by linear_combination -h)
    have hns₂ : (threeRootsCurve e₁ e₂ e₃).toAffine.Nonsingular e₂ 0 := by
      rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
      refine ⟨by dsimp [threeRootsCurve]; ring, Or.inl ?_⟩
      dsimp [threeRootsCurve]
      intro h
      exact mul_ne_zero h21 h23 (by linear_combination -h)
    have hns₃ : (threeRootsCurve e₁ e₂ e₃).toAffine.Nonsingular e₃ 0 := by
      rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
      refine ⟨by dsimp [threeRootsCurve]; ring, Or.inl ?_⟩
      dsimp [threeRootsCurve]
      intro h
      exact mul_ne_zero h31 h32 (by linear_combination -h)
    let P₁ : (threeRootsCurve e₁ e₂ e₃).toAffine.Point := WeierstrassCurve.Affine.Point.some hns₁
    let P₂ : (threeRootsCurve e₁ e₂ e₃).toAffine.Point := WeierstrassCurve.Affine.Point.some hns₂
    let P₃ : (threeRootsCurve e₁ e₂ e₃).toAffine.Point := WeierstrassCurve.Affine.Point.some hns₃
    obtain ⟨δ, hδ_mul, hδ_ker, hδ_gen, hδ_e₁, hδ_e₂⟩ := lemma_3_1 e₁ e₂ e₃ h₁₂ h₁₃ h₂₃
    have hδ0 : δ 0 = (1, 1) := (hδ_ker 0).mpr ⟨0, (add_zero 0).symm⟩
    have hδ₁ : δ P₁ = (sqCl u₁₁, sqCl u₁₂) := hδ_e₁ hns₁ u₁₁ u₁₂ rfl rfl
    have hδ₂ : δ P₂ = (sqCl u₂₁, sqCl u₂₂) := hδ_e₂ hns₂ u₂₁ u₂₂ rfl rfl
    have hδ₃ : δ P₃ = (sqCl u₃₁, sqCl u₃₂) := hδ_gen e₃ 0 hns₃ u₃₁ u₃₂ h₁₃.symm h₂₃.symm rfl rfl
    have hrev : ∀ P, ∃ u₁ u₂ : Fˣ, δ P = (sqCl u₁, sqCl u₂) ∧ IsDescentClass e₁ e₂ e₃ (u₁ : F) (u₂ : F) := by
      intro P
      cases P with
      | zero =>
        refine ⟨1, 1, hδ0, 0, 1, 1, 1, ?_, by simp, by simp⟩
        rintro ⟨_, h1, _, _⟩; exact one_ne_zero h1
      | @some x y hns =>
        by_cases hx₁ : x = e₁
        · subst x
          have hy0 : y = 0 := by
            have heq := (WeierstrassCurve.Affine.equation_iff e₁ y).mp hns.1
            dsimp [threeRootsCurve] at heq
            exact eq_zero_of_pow_eq_zero (show y ^ 2 = 0 by linear_combination heq)
          subst y
          refine ⟨u₁₁, u₁₂, hδ_e₁ hns u₁₁ u₁₂ rfl rfl, 1, 0, 1, (e₁ - e₂)⁻¹, ?_, ?_, ?_⟩
          · rintro ⟨h0, _, _, _⟩; exact one_ne_zero h0
          · change ((e₁ - e₂) * (e₁ - e₃)) * 0 ^ 2 - (e₁ - e₂) * 1 ^ 2 = (e₂ - e₁) * 1 ^ 2
            ring
          · change ((e₁ - e₂) * (e₁ - e₃)) * 0 ^ 2 - ((e₁ - e₂) * (e₁ - e₃)) * (e₁ - e₂) * ((e₁ - e₂)⁻¹) ^ 2 = (e₃ - e₁) * 1 ^ 2
            field_simp; ring
        · by_cases hx₂ : x = e₂
          · subst x
            have hy0 : y = 0 := by
              have heq := (WeierstrassCurve.Affine.equation_iff e₂ y).mp hns.1
              dsimp [threeRootsCurve] at heq
              exact eq_zero_of_pow_eq_zero (show y ^ 2 = 0 by linear_combination heq)
            subst y
            refine ⟨u₂₁, u₂₂, hδ_e₂ hns u₂₁ u₂₂ rfl rfl, 1, 1, 0, (e₁ - e₂)⁻¹, ?_, ?_, ?_⟩
            · rintro ⟨h0, _, _, _⟩; exact one_ne_zero h0
            · change (-(e₁ - e₂)) * 1 ^ 2 - (-((e₁ - e₂) * (e₂ - e₃))) * 0 ^ 2 = (e₂ - e₁) * 1 ^ 2
              ring
            · change (-(e₁ - e₂)) * 1 ^ 2 - (-(e₁ - e₂)) * (-((e₁ - e₂) * (e₂ - e₃))) * ((e₁ - e₂)⁻¹) ^ 2 = (e₃ - e₁) * 1 ^ 2
              field_simp; ring
          · have hx1' : x - e₁ ≠ 0 := sub_ne_zero.mpr hx₁
            have hx2' : x - e₂ ≠ 0 := sub_ne_zero.mpr hx₂
            let u₁ : Fˣ := Units.mk0 (x - e₁) hx1'
            let u₂ : Fˣ := Units.mk0 (x - e₂) hx2'
            refine ⟨u₁, u₂, hδ_gen x y hns u₁ u₂ hx₁ hx₂ rfl rfl, 1, 1, 1, y / ((x - e₁) * (x - e₂)), ?_, ?_, ?_⟩
            · rintro ⟨h0, _, _, _⟩; exact one_ne_zero h0
            · change (x - e₁) * 1 ^ 2 - (x - e₂) * 1 ^ 2 = (e₂ - e₁) * 1 ^ 2
              ring
            · change (x - e₁) * 1 ^ 2 - (x - e₁) * (x - e₂) * (y / ((x - e₁) * (x - e₂))) ^ 2 = (e₃ - e₁) * 1 ^ 2
              have heq := (WeierstrassCurve.Affine.equation_iff x y).mp hns.1
              dsimp [threeRootsCurve] at heq
              field_simp
              linear_combination -heq
    have hfwd : ∀ d₁ d₂ : Fˣ, IsDescentClass e₁ e₂ e₃ (d₁ : F) (d₂ : F) → ∃ P, δ P = (sqCl d₁, sqCl d₂) := by
      rintro d₁ d₂ ⟨z₀, z₁, z₂, z₃, hnz, hq₁, hq₂⟩
      have hd₁0 : (d₁ : F) ≠ 0 := d₁.ne_zero
      have hd₂0 : (d₂ : F) ≠ 0 := d₂.ne_zero
      by_cases hz₀ : z₀ = 0
      · subst hz₀
        have hz₃ : z₃ ≠ 0 := by
          intro hz₃
          subst hz₃
          have hz₁ : z₁ = 0 := by
            have h : (d₁ : F) * z₁ ^ 2 = 0 := by linear_combination hq₂
            exact eq_zero_of_pow_eq_zero ((mul_eq_zero.mp h).resolve_left hd₁0)
          subst hz₁
          have hz₂ : z₂ = 0 := by
            have h : (d₂ : F) * z₂ ^ 2 = 0 := by linear_combination -hq₁
            exact eq_zero_of_pow_eq_zero ((mul_eq_zero.mp h).resolve_left hd₂0)
          exact hnz ⟨rfl, rfl, hz₂, rfl⟩
        have h1 : sqCl d₁ = sqCl 1 := by
          apply sqCl_eq_of_eq_mul_sq d₁ 1 (z₂ / z₃)
          simp only [Units.val_one, one_mul]
          have h : (d₂ : F) * ((d₁ : F) * z₃ ^ 2 - z₂ ^ 2) = 0 := by
            linear_combination hq₁ - hq₂
          have h' := (mul_eq_zero.mp h).resolve_left hd₂0
          field_simp
          linear_combination h'
        have h2 : sqCl d₂ = sqCl 1 := by
          apply sqCl_eq_of_eq_mul_sq d₂ 1 (z₁ / z₃)
          simp only [Units.val_one, one_mul]
          have h : (d₁ : F) * ((d₂ : F) * z₃ ^ 2 - z₁ ^ 2) = 0 := by
            linear_combination -hq₂
          have h' := (mul_eq_zero.mp h).resolve_left hd₁0
          field_simp
          linear_combination h'
        refine ⟨0, ?_⟩
        rw [hδ0, h1, h2]
        rfl
      · by_cases hz₁ : z₁ = 0
        · subst hz₁
          have hz₂ : z₂ ≠ 0 := by
            intro hz₂
            subst hz₂
            have h : (e₂ - e₁) * z₀ ^ 2 = 0 := by linear_combination -hq₁
            exact mul_ne_zero h21 (pow_ne_zero 2 hz₀) h
          have hz₃ : z₃ ≠ 0 := by
            intro hz₃
            subst hz₃
            have h : (e₃ - e₁) * z₀ ^ 2 = 0 := by linear_combination -hq₂
            exact mul_ne_zero h31 (pow_ne_zero 2 hz₀) h
          have h1 : sqCl d₁ = sqCl u₁₁ := by
            apply sqCl_eq_of_eq_mul_sq d₁ u₁₁ (z₂ / ((e₁ - e₂) * z₃))
            change (d₁ : F) = ((e₁ - e₂) * (e₁ - e₃)) * (z₂ / ((e₁ - e₂) * z₃)) ^ 2
            have h : (d₂ : F) * ((e₁ - e₂) * (d₁ : F) * z₃ ^ 2 - (e₁ - e₃) * z₂ ^ 2) = 0 := by
              linear_combination -(e₃ - e₁) * hq₁ + (e₂ - e₁) * hq₂
            have h' := (mul_eq_zero.mp h).resolve_left hd₂0
            field_simp
            linear_combination h'
          have h2 : sqCl d₂ = sqCl u₁₂ := by
            apply sqCl_eq_of_eq_mul_sq d₂ u₁₂ (z₀ / z₂)
            change (d₂ : F) = (e₁ - e₂) * (z₀ / z₂) ^ 2
            field_simp
            linear_combination -hq₁
          exact ⟨P₁, by rw [hδ₁, h1, h2]⟩
        · by_cases hz₂ : z₂ = 0
          · subst hz₂
            have hz₃ : z₃ ≠ 0 := by
              intro hz₃
              subst hz₃
              have h : (e₃ - e₂) * z₀ ^ 2 = 0 := by linear_combination hq₁ - hq₂
              exact mul_ne_zero h32 (pow_ne_zero 2 hz₀) h
            have h1 : sqCl d₁ = sqCl u₂₁ := by
              apply sqCl_eq_of_eq_mul_sq d₁ u₂₁ (z₀ / z₁)
              change (d₁ : F) = -(e₁ - e₂) * (z₀ / z₁) ^ 2
              field_simp
              linear_combination hq₁
            have h2 : sqCl d₂ = sqCl u₂₂ := by
              apply sqCl_eq_of_eq_mul_sq d₂ u₂₂ (z₁ / ((e₁ - e₂) * z₃))
              change (d₂ : F) = -((e₁ - e₂) * (e₂ - e₃)) * (z₁ / ((e₁ - e₂) * z₃)) ^ 2
              have h : (d₁ : F) * ((e₁ - e₂) * (d₂ : F) * z₃ ^ 2 + (e₂ - e₃) * z₁ ^ 2) = 0 := by
                linear_combination -(e₃ - e₁) * hq₁ + (e₂ - e₁) * hq₂
              have h' := (mul_eq_zero.mp h).resolve_left hd₁0
              field_simp
              linear_combination h'
            exact ⟨P₂, by rw [hδ₂, h1, h2]⟩
          · by_cases hz₃ : z₃ = 0
            · subst hz₃
              have h1 : sqCl d₁ = sqCl u₃₁ := by
                apply sqCl_eq_of_eq_mul_sq d₁ u₃₁ (z₀ / z₁)
                change (d₁ : F) = (e₃ - e₁) * (z₀ / z₁) ^ 2
                field_simp
                linear_combination hq₂
              have h2 : sqCl d₂ = sqCl u₃₂ := by
                apply sqCl_eq_of_eq_mul_sq d₂ u₃₂ (z₀ / z₂)
                change (d₂ : F) = (e₃ - e₂) * (z₀ / z₂) ^ 2
                field_simp
                linear_combination hq₂ - hq₁
              exact ⟨P₃, by rw [hδ₃, h1, h2]⟩
            · let x : F := (d₁ : F) * (z₁ / z₀) ^ 2 + e₁
              let y : F := (d₁ : F) * (d₂ : F) * z₁ * z₂ * z₃ / z₀ ^ 3
              have hx_e1 : x - e₁ = (d₁ : F) * (z₁ / z₀) ^ 2 := by dsimp [x]; ring
              have hx_e2 : x - e₂ = (d₂ : F) * (z₂ / z₀) ^ 2 := by
                dsimp [x]
                field_simp
                linear_combination hq₁
              have hx_e3 : x - e₃ = (d₁ : F) * (d₂ : F) * (z₃ / z₀) ^ 2 := by
                dsimp [x]
                field_simp
                linear_combination hq₂
              have hx₁_ne : x ≠ e₁ := by
                rw [← sub_ne_zero, hx_e1]
                exact mul_ne_zero hd₁0 (pow_ne_zero 2 (div_ne_zero hz₁ hz₀))
              have hx₂_ne : x ≠ e₂ := by
                rw [← sub_ne_zero, hx_e2]
                exact mul_ne_zero hd₂0 (pow_ne_zero 2 (div_ne_zero hz₂ hz₀))
              have hy_ne : y ≠ 0 := by
                dsimp [y]
                exact div_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero hd₁0 hd₂0) hz₁) hz₂) hz₃)
                  (pow_ne_zero 3 hz₀)
              have hns : (threeRootsCurve e₁ e₂ e₃).toAffine.Nonsingular x y := by
                rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
                refine ⟨?_, Or.inr ?_⟩
                · dsimp [threeRootsCurve]
                  have hprod : y ^ 2 = (x - e₁) * (x - e₂) * (x - e₃) := by
                    rw [hx_e1, hx_e2, hx_e3]
                    dsimp [y]
                    field_simp
                  linear_combination hprod
                · dsimp [threeRootsCurve]
                  intro hy_eq
                  exact mul_ne_zero two_ne_zero hy_ne (by linear_combination hy_eq)
              let u₁ : Fˣ := Units.mk0 (x - e₁) (sub_ne_zero.mpr hx₁_ne)
              let u₂ : Fˣ := Units.mk0 (x - e₂) (sub_ne_zero.mpr hx₂_ne)
              have hδP : δ (WeierstrassCurve.Affine.Point.some hns) = (sqCl u₁, sqCl u₂) :=
                hδ_gen x y hns u₁ u₂ hx₁_ne hx₂_ne rfl rfl
              have h1 : sqCl d₁ = sqCl u₁ := by
                apply sqCl_eq_of_eq_mul_sq d₁ u₁ (z₀ / z₁)
                change (d₁ : F) = (x - e₁) * (z₀ / z₁) ^ 2
                rw [hx_e1]
                field_simp
              have h2 : sqCl d₂ = sqCl u₂ := by
                apply sqCl_eq_of_eq_mul_sq d₂ u₂ (z₀ / z₂)
                change (d₂ : F) = (x - e₂) * (z₀ / z₂) ^ 2
                rw [hx_e2]
                field_simp
              exact ⟨WeierstrassCurve.Affine.Point.some hns, by rw [hδP, h1, h2]⟩
    obtain ⟨P, hP⟩ := hfwd x₁ x₂ hx
    obtain ⟨Q, hQ⟩ := hfwd y₁ y₂ hy
    obtain ⟨u₁, u₂, hPQ, hdesc⟩ := hrev (P + Q)
    have hmul : (sqCl u₁, sqCl u₂) = (sqCl (x₁ * y₁), sqCl (x₂ * y₂)) := by
      rw [← hPQ, hδ_mul, hP, hQ]
      rfl
    exact isDescentClass_of_sqCl_eq (Prod.ext_iff.mp hmul).1 (Prod.ext_iff.mp hmul).2 hdesc
  have isSquare_of_mul_eq_sq_mul : ∀ {F : Type u} [Field F] {P Q R : F} (C : F),
      IsSquare P → IsSquare Q → C ≠ 0 → P * Q = C ^ 2 * R → IsSquare R := by
    intro F _ P Q R C ⟨r, hr⟩ ⟨s, hs⟩ hC heq
    refine ⟨r * s / C, ?_⟩
    have h : C ^ 2 * R = (r * r) * (s * s) := by
      rw [← hr, ← hs, heq]
    field_simp
    linear_combination h
  refine ⟨?_, ?_, ?_⟩
  · intro v x₁ x₂ y₁ y₂ hx hy
    let F := v.adicCompletion K
    let ι := algebraMap K F
    haveI : CharZero F := (RingHom.charZero_iff ι.injective).mp inferInstance
    have h₁₂ : ι a₁ ≠ ι a₂ := ι.injective.ne hstart.1
    have h₁₃ : ι a₁ ≠ ι a₃ := ι.injective.ne hstart.2.1
    have h₂₃ : ι a₂ ≠ ι a₃ := ι.injective.ne hstart.2.2.1
    let X₁ : Fˣ := Units.map ι.toMonoidHom x₁
    let X₂ : Fˣ := Units.map ι.toMonoidHom x₂
    let Y₁ : Fˣ := Units.map ι.toMonoidHom y₁
    let Y₂ : Fˣ := Units.map ι.toMonoidHom y₂
    have hmul := isDescentClass_mul h₁₂ h₁₃ h₂₃ X₁ X₂ Y₁ Y₂ hx hy
    simpa only [Units.val_mul, map_mul] using hmul
  · intro w x₁ x₂ y₁ y₂ hx hy
    let F := w.Completion
    let ι := algebraMap K F
    haveI : CharZero F := (RingHom.charZero_iff ι.injective).mp inferInstance
    have h₁₂ : ι a₁ ≠ ι a₂ := ι.injective.ne hstart.1
    have h₁₃ : ι a₁ ≠ ι a₃ := ι.injective.ne hstart.2.1
    have h₂₃ : ι a₂ ≠ ι a₃ := ι.injective.ne hstart.2.2.1
    let X₁ : Fˣ := Units.map ι.toMonoidHom x₁
    let X₂ : Fˣ := Units.map ι.toMonoidHom x₂
    let Y₁ : Fˣ := Units.map ι.toMonoidHom y₁
    let Y₂ : Fˣ := Units.map ι.toMonoidHom y₂
    have hmul := isDescentClass_mul h₁₂ h₁₃ h₂₃ X₁ X₂ Y₁ Y₂ hx hy
    simpa only [Units.val_mul, map_mul] using hmul
  · intro v π_v x₁ x₂ y₁ y₂ hπ hx hy
    let L := v.adicCompletion K
    let ι := algebraMap K L
    let α : L := ι (a₁ - a₂)
    let β : L := ι (a₁ - a₃)
    let γ : L := ι (a₂ - a₃)
    have hα : α ≠ 0 := by
      rw [show α = ι a₁ - ι a₂ from map_sub ι a₁ a₂, sub_ne_zero]
      exact ι.injective.ne hstart.1
    have hβ : β ≠ 0 := by
      rw [show β = ι a₁ - ι a₃ from map_sub ι a₁ a₃, sub_ne_zero]
      exact ι.injective.ne hstart.2.1
    have hγ : γ ≠ 0 := by
      rw [show γ = ι a₂ - ι a₃ from map_sub ι a₂ a₃, sub_ne_zero]
      exact ι.injective.ne hstart.2.2.1
    have hπ0 : π_v ≠ 0 := by
      rcases hπ with ⟨n, _, hn⟩
      intro h0
      rw [h0, Valuation.map_zero] at hn
      exact WithZero.coe_ne_zero hn.symm
    rcases hx with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
    rcases hy with ⟨h3, h4⟩ | ⟨h3, h4⟩ | ⟨h3, h4⟩ | ⟨h3, h4⟩
    · refine Or.inl ⟨isSquare_of_mul_eq_sq_mul 1 h1 h3 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul 1 h2 h4 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩
    · refine Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul 1 h1 h3 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul 1 h2 h4 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩)
    · refine Or.inr (Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul 1 h1 h3 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul 1 h2 h4 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inr (Or.inr (Or.inr ⟨isSquare_of_mul_eq_sq_mul 1 h1 h3 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul 1 h2 h4 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul 1 h1 h3 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul 1 h2 h4 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩)
    · refine Or.inl ⟨isSquare_of_mul_eq_sq_mul (α * β) h1 h3 (mul_ne_zero hα hβ)
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul (π_v * α) h2 h4 (mul_ne_zero hπ0 hα)
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩
    · refine Or.inr (Or.inr (Or.inr ⟨isSquare_of_mul_eq_sq_mul α h1 h3 hα
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul α h2 h4 hα
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inr (Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul β h1 h3 hβ
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul π_v h2 h4 hπ0
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inr (Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul 1 h1 h3 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul 1 h2 h4 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inr (Or.inr (Or.inr ⟨isSquare_of_mul_eq_sq_mul α h1 h3 hα
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul α h2 h4 hα
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inl ⟨isSquare_of_mul_eq_sq_mul (π_v * α) h1 h3 (mul_ne_zero hπ0 hα)
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul (α * γ) h2 h4 (mul_ne_zero hα hγ)
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩
    · refine Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul π_v h1 h3 hπ0
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul γ h2 h4 hγ
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩)
    · refine Or.inr (Or.inr (Or.inr ⟨isSquare_of_mul_eq_sq_mul 1 h1 h3 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul 1 h2 h4 one_ne_zero
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inr (Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul β h1 h3 hβ
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul π_v h2 h4 hπ0
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩))
    · refine Or.inr (Or.inl ⟨isSquare_of_mul_eq_sq_mul π_v h1 h3 hπ0
        (by simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul γ h2 h4 hγ
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩)
    · refine Or.inl ⟨isSquare_of_mul_eq_sq_mul (π_v * β) h1 h3 (mul_ne_zero hπ0 hβ)
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring),
        isSquare_of_mul_eq_sq_mul (π_v * γ) h2 h4 (mul_ne_zero hπ0 hγ)
        (by dsimp only [α, β, γ, ι]; simp only [Units.val_mul, map_mul, map_sub, map_neg]; ring)⟩

theorem selmerStruct_insert_encard_of_unramified_basis (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T B S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (p q : Kˣ × Kˣ) (m : ℕ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hST : Disjoint S T)
    (hSB : Disjoint S B)
    (hπ : ∀ v ∈ S, IsLocalUnif v (π v))
    (hv₀T : v₀ ∉ T) (hv₀B : v₀ ∉ B) (hv₀S : v₀ ∉ S)
    (hm : (selmerStruct K a₁ a₂ a₃ T S π).encard = 4 ^ (m + 1))
    (hp : (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S π)
    (hq : (sqCl q.1, sqCl q.2) ∈ selmerStruct K a₁ a₂ a₃ T S π)
    (hp₁ : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (p.1 : K)))
    (hp₁₂ : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) ((p.1 * p.2 : Kˣ) : K)))
    (hq₂ : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (q.2 : K))) :
    ∃ (S' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K),
      Disjoint S' T ∧
      Disjoint S' B ∧
      (∀ v ∈ S', IsLocalUnif v (π' v)) ∧
      (selmerStruct K a₁ a₂ a₃ T S' π').encard = 4 ^ m :=
by
  have hmul : IsLocalMulClosed K a₁ a₂ a₃ := selmer_local_mul_closure K a₁ a₂ a₃ τ hstart
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  have hint₁ : IsIntegral ℤ a₁ := hstart.2.2.2.2.2.2.1
  have hint₂ : IsIntegral ℤ a₂ := hstart.2.2.2.2.2.2.2.1
  have hint₃ : IsIntegral ℤ a₃ := hstart.2.2.2.2.2.2.2.2.1
  
  have h_s5 :
      (∃ π₀ : v₀.adicCompletion K, IsLocalUnif v₀ π₀) ∧
      (∀ (π₀ : v₀.adicCompletion K) (x₁ x₂ : Kˣ),
        IsLocalUnif v₀ π₀ → EvenVal v₀ x₁ → EvenVal v₀ x₂ →
        (RamLocal a₁ a₂ a₃ v₀ π₀ x₁ x₂ ↔
          IsSquare (algebraMap K (v₀.adicCompletion K) (x₁ : K)) ∧
          IsSquare (algebraMap K (v₀.adicCompletion K) (x₂ : K)))) ∧
      (∀ u r : Kˣ, EvenVal v₀ u →
        ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
        hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) (u : K))
