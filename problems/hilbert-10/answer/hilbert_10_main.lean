  congr 1
  apply Quotient.sound
  exact ⟨C_v, hC_v⟩

theorem globalRootNumber_twist_of_prime_mod_four (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ π : NumberField.RingOfIntegers K)
    (h₁₂ : (a₁ : K) ≠ (a₂ : K)) (h₁₃ : (a₁ : K) ≠ (a₃ : K)) (h₂₃ : (a₂ : K) ≠ (a₃ : K))
    (hπ_prime : Prime π)
    (hπ_mod : π - 1 ∈ Ideal.span {4 * (6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃))})
    (hπ_norm : Ideal.absNorm (Ideal.span {π}) % 4 = 3)
    (hloc : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃) ∈ v.asIdeal →
      rootNumber ((threeRootsCurve ((π * a₁ : NumberField.RingOfIntegers K) : K)
          ((π * a₂ : NumberField.RingOfIntegers K) : K)
          ((π * a₃ : NumberField.RingOfIntegers K) : K)).baseChange (v.adicCompletion K)) =
        rootNumber ((threeRootsCurve (a₁ : K) (a₂ : K) (a₃ : K)).baseChange (v.adicCompletion K))) :
    globalRootNumber (threeRootsCurve ((π * a₁ : NumberField.RingOfIntegers K) : K)
        ((π * a₂ : NumberField.RingOfIntegers K) : K)
        ((π * a₃ : NumberField.RingOfIntegers K) : K)) =
      -globalRootNumber (threeRootsCurve (a₁ : K) (a₂ : K) (a₃ : K)) :=
by
  classical
  let E0 := threeRootsCurve (a₁ : K) (a₂ : K) (a₃ : K)
  let E := threeRootsCurve ((π * a₁ : NumberField.RingOfIntegers K) : K)
    ((π * a₂ : NumberField.RingOfIntegers K) : K)
    ((π * a₃ : NumberField.RingOfIntegers K) : K)
  let D₀ : NumberField.RingOfIntegers K := 6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)
  let Δ₀ : NumberField.RingOfIntegers K := 16 * (a₁ - a₂) ^ 2 * (a₁ - a₃) ^ 2 * (a₂ - a₃) ^ 2
  let c₄₀ : NumberField.RingOfIntegers K :=
