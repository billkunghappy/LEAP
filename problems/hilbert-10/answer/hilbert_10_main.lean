                    (algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2) /
                    algebraMap K (v₁.adicCompletion K) (r_z : K)) := by ring
              _ = algebraMap K (v₁.adicCompletion K) (r_z : K) +
                  -(algebraMap K (v₁.adicCompletion K) (r_z : K) -
                    (algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2) := by
                  rw [mul_div_cancel₀ _ hr_z_ne]
