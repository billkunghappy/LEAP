        letI : Algebra F₂ F₃ := hAlgF₂F₃
        letI : IsScalarTower K F₂ F₃ := hTowerKF₂F₃
        have h_rp₃ : ∀ k : Fin 6,
            (algebraMap F₂ F₃ (algebraMap F₁ F₂ (algebraMap F F₁ (β_F k)))) ^ 2 =
