theorem exists_suitable_twist (K : Type u) [Field K] [NumberField K]
    (hreal : 32 ≤ NumberField.InfinitePlace.nrRealPlaces K)
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (haux : IsAuxiliaryTwist K a₁ a₂ a₃ τ T S π κ z)
    (bad : Set (SqCl K)) (hbad : bad.Finite) :
    ∃ (t : Kˣ) (c d m : K)
      (𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      sqCl t ∉ bad ∧
      d ≠ 0 ∧ m ≠ 0 ∧
      (t : K) = m⁻¹ ^ 2 * d * (c + a₁ * d) * (c + a₂ * d) * (c + a₃ * d) ∧
      IsSuitableTwist K a₁ a₂ a₃ T S t z 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ :=
by
  obtain ⟨C, ω, hω⟩ := proposition_a_4 K
  obtain ⟨a₁_int, a₂_int, a₃_int, κ_int, m, l, hmod⟩ :=
    exists_twist_modulus_and_offset K a₁ a₂ a₃ τ T S π κ z hstart hT haux bad hbad
  have ⟨ha₁, ha₂, ha₃, hκ_int, hm_ne, _, _, _, hl_mu, h6_diff, _, _, _, _⟩ := hmod
  have h₁₂_int : a₁_int ≠ a₂_int := by
    intro h
    apply hstart.1
    rw [← ha₁, ← ha₂, h]
  have h₁₃_int : a₁_int ≠ a₃_int := by
    intro h
    apply hstart.2.1
    rw [← ha₁, ← ha₃, h]
  have h₂₃_int : a₂_int ≠ a₃_int := by
    intro h
    apply hstart.2.2.1
    rw [← ha₂, ← ha₃, h]
  have hμ_cast : ((m ^ 2 * κ_int : NumberField.RingOfIntegers K) : K) = (m : K) ^ 2 * (κ : K) := by
    change (m : K) ^ 2 * (κ_int : K) = (m : K) ^ 2 * (κ : K)
    rw [hκ_int]
  have hμ_ne : m ^ 2 * κ_int ≠ 0 := by
    intro h
    have h0 : ((m ^ 2 * κ_int : NumberField.RingOfIntegers K) : K) = 0 := by
      rw [h]
      rfl
    rw [hμ_cast] at h0
    exact mul_ne_zero (pow_ne_zero 2 hm_ne) κ.ne_zero h0
  have h6 : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      m ^ 2 * κ_int ∉ v.asIdeal → (6 : NumberField.RingOfIntegers K) ∉ v.asIdeal :=
    fun v hv => (h6_diff v hv).1
  have hdiff : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      m ^ 2 * κ_int ∉ v.asIdeal →
        (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int) ∉ v.asIdeal :=
    fun v hv => (h6_diff v hv).2
  obtain ⟨haff, hcok, hloc⟩ :=
    suitForms_cokernel_and_local_solvable K ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l
      h₁₂_int h₁₃_int h₂₃_int hμ_ne hl_mu h6
  obtain ⟨hΩ_meas, C_vol, hC_vol, N₀, hΩ_vol⟩ :=
    suitCone_volume_lower_bound K ω a₁ a₂ a₃ τ T S π κ z hstart haux
      a₁_int a₂_int a₃_int m (m ^ 2 * κ_int) l ha₁ ha₂ ha₃ hm_ne hμ_cast
  obtain ⟨z_lat, 𝔮₁, 𝔮₂, 𝔮₃, 𝔮₄, hquad⟩ :=
    exists_prime_quadruple_of_cone_volume K hreal C ω hω a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l
      hμ_ne hl_mu hdiff haff hcok hloc
      (suitCone τ (κ : K)
        (suitC0 a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l)
        (suitC ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int)))
      hΩ_meas C_vol hC_vol N₀ hΩ_vol
  obtain ⟨t, c, d, ht_bad, hd, ht_eq, hsuit⟩ :=
    suitable_twist_of_prime_quadruple K a₁ a₂ a₃ τ T S π κ z hstart hT haux bad
      ω a₁_int a₂_int a₃_int κ_int m l hmod haff z_lat 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ hquad
  exact ⟨t, c, d, (m : K), 𝔮₁, 𝔮₂, 𝔮₃, 𝔮₄, ht_bad, hd, hm_ne, ht_eq, hsuit⟩

theorem twoSelmerSet_encard_le_four_of_suitable_twist (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (t : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hsuit : IsSuitableTwist K a₁ a₂ a₃ T S t z 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄) :
    (twoSelmerSet K ((t : K) * a₁) ((t : K) * a₂) ((t : K) * a₃)).encard ≤ 4 :=
by
  classical
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  have hint₁ : IsIntegral ℤ a₁ := hstart.2.2.2.2.2.2.1
  have hint₂ : IsIntegral ℤ a₂ := hstart.2.2.2.2.2.2.2.1
  have hint₃ : IsIntegral ℤ a₃ := hstart.2.2.2.2.2.2.2.2.1
  
  have h_good_vals : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∉ T →
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1 ∧
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 ∧
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 ∧
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) = 1 := by
    intro v hvT
    let A₁_int : NumberField.RingOfIntegers K := ⟨a₁, hint₁⟩
    let A₂_int : NumberField.RingOfIntegers K := ⟨a₂, hint₂⟩
    let A₃_int : NumberField.RingOfIntegers K := ⟨a₃, hint₃⟩
    have hval2_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 ≤ 1 := by
      have := v.valuation_le_one (K := K) (2 : NumberField.RingOfIntegers K); simpa using this
    have hval3_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 3 ≤ 1 := by
      have := v.valuation_le_one (K := K) (3 : NumberField.RingOfIntegers K); simpa using this
    have hval6_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 ≤ 1 := by
      have := v.valuation_le_one (K := K) (6 : NumberField.RingOfIntegers K); simpa using this
    have hval12_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 := by
      have := v.valuation_le_one (K := K) (A₁_int - A₂_int); simpa [A₁_int, A₂_int] using this
    have hval13_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 := by
      have := v.valuation_le_one (K := K) (A₁_int - A₃_int); simpa [A₁_int, A₃_int] using this
    have hval23_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) ≤ 1 := by
      have := v.valuation_le_one (K := K) (A₂_int - A₃_int); simpa [A₂_int, A₃_int] using this
    have hgood : (IsDedekindDomain.HeightOneSpectrum.valuation K v)
        (6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)) = 1 :=
      not_ne_iff.mp ((hT v).not.mp hvT)
    rw [map_mul, map_mul, map_mul] at hgood
    have h_le_prod1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) ≤ 1 :=
      (mul_le_of_le_one_right' hval12_le).trans hval6_le
    have h_le_prod2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) ≤ 1 :=
      (mul_le_of_le_one_right' hval13_le).trans h_le_prod1
    have hval23 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₂ - a₃) = 1 :=
      le_antisymm hval23_le (by rw [← hgood]; exact mul_le_of_le_one_left' h_le_prod2)
    have hgood2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 := by
      rw [hval23, mul_one] at hgood; exact hgood
    have hval13 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₃) = 1 :=
      le_antisymm hval13_le (by rw [← hgood2]; exact mul_le_of_le_one_left' h_le_prod1)
    have hgood1 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 := by
      rw [hval13, mul_one] at hgood2; exact hgood2
    have hval12 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (a₁ - a₂) = 1 :=
      le_antisymm hval12_le (by rw [← hgood1]; exact mul_le_of_le_one_left' hval6_le)
    have hval6 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 6 = 1 := by
      rw [hval12, mul_one] at hgood1; exact hgood1
    have hval23_prod : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 *
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) 3 = 1 := by
      rw [← map_mul, show (2 : K) * 3 = 6 by norm_num, hval6]
    have hval2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1 :=
      le_antisymm hval2_le (by rw [← hval23_prod]; exact mul_le_of_le_one_right' hval3_le)
    exact ⟨hval2, hval12, hval13, hval23⟩
  
  have h_hensel : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1 →
      ∀ x : v.adicCompletion K, Valued.v x < 1 → IsSquare (1 + x) := by
    intro v h2 x hx
    have hv2 : Valued.v (2 : v.adicCompletion K) = 1 := by
      rw [← map_ofNat (algebraMap K (v.adicCompletion K)) 2]
      erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v (2 : K)]
      exact h2
    have hv4 : Valued.v (4 : v.adicCompletion K) = 1 := by
      have h42 : (4 : v.adicCompletion K) = 2 * 2 := by norm_num
      rw [h42, Valuation.map_mul, hv2, mul_one]
    have h4_ne : (4 : v.adicCompletion K) ≠ 0 := by
      intro h0; rw [h0, Valuation.map_zero] at hv4; exact zero_ne_one hv4
    let z0 : v.adicCompletion K := (4 : v.adicCompletion K)⁻¹ * x
    have h1x : 1 + x = 1 + 4 * z0 := by
      dsimp only [z0]; rw [mul_inv_cancel_left₀ h4_ne]
    have hz_lt : Valued.v z0 < 1 := by
      dsimp only [z0]; rw [Valuation.map_mul, Valuation.map_inv, hv4, inv_one, one_mul]; exact hx
    have hz_val : Valued.v z0 ≤ WithZero.exp (-1 : ℤ) := by
      by_cases hz0 : Valued.v z0 = 0
      · rw [hz0]; exact zero_le'
      · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hz0
        rw [← hg] at hz_lt ⊢
        have hg_exp : (g : WithZero (Multiplicative ℤ)) = WithZero.exp (Multiplicative.toAdd g) := by
          rw [← ofAdd_toAdd g]; rfl
        rw [hg_exp] at hz_lt ⊢
        rw [← WithZero.exp_zero] at hz_lt
        have hlt : Multiplicative.toAdd g < 0 := WithZero.exp_lt_exp.mp hz_lt
        exact WithZero.exp_le_exp.mpr (by omega)
    let e₁ : WithZero (Multiplicative ℤ) := WithZero.exp (-1 : ℤ)
    have he₁_le_one : e₁ ≤ 1 := by
      rw [← WithZero.exp_zero]; exact WithZero.exp_le_exp.mpr (by omega)
    have hw_le : ∀ k : ℕ, Valued.v (henselSeq z0 k) ≤ e₁ := by
      intro k
      induction k with
      | zero => simp only [henselSeq, Valuation.map_zero]; exact zero_le'
      | succ k ih =>
        simp only [henselSeq]
        have hsq : Valued.v ((henselSeq z0 k) ^ 2) ≤ e₁ := by
          rw [sq, Valuation.map_mul]
          calc Valued.v (henselSeq z0 k) * Valued.v (henselSeq z0 k)
            _ ≤ e₁ * 1 := mul_le_mul' ih (le_trans ih he₁_le_one)
            _ = e₁ := mul_one e₁
        exact le_trans (Valuation.map_sub _ _ _) (max_le hz_val hsq)
    have hw_diff : ∀ k : ℕ, Valued.v (henselSeq z0 (k + 1) - henselSeq z0 k) ≤ WithZero.exp (-(k + 1 : ℤ)) := by
      intro k
      induction k with
      | zero =>
        have h0 : henselSeq z0 1 - henselSeq z0 0 = z0 := by simp [henselSeq]
        rw [h0]; simpa using hz_val
      | succ k ih =>
        have hstep : henselSeq z0 (k + 2) - henselSeq z0 (k + 1) =
            -(henselSeq z0 (k + 1) + henselSeq z0 k) * (henselSeq z0 (k + 1) - henselSeq z0 k) := by
          simp only [henselSeq]; ring
        have hsum : Valued.v (henselSeq z0 (k + 1) + henselSeq z0 k) ≤ e₁ :=
          le_trans (Valuation.map_add _ _ _) (max_le (hw_le (k + 1)) (hw_le k))
        rw [hstep, Valuation.map_mul, Valuation.map_neg]
        calc Valued.v (henselSeq z0 (k + 1) + henselSeq z0 k) * Valued.v (henselSeq z0 (k + 1) - henselSeq z0 k)
          _ ≤ WithZero.exp (-1 : ℤ) * WithZero.exp (-(k + 1 : ℤ)) := mul_le_mul' hsum ih
          _ = WithZero.exp ((-1 : ℤ) + -(k + 1 : ℤ)) := (WithZero.exp_add (-1 : ℤ) (-(k + 1 : ℤ))).symm
          _ = WithZero.exp (-((k + 1 : ℕ) + 1 : ℤ)) := by congr 1; push_cast; ring
    have hw_tele : ∀ m k : ℕ, Valued.v (henselSeq z0 (m + k) - henselSeq z0 m) ≤ WithZero.exp (-(m + 1 : ℤ)) := by
      intro m k
      induction k with
      | zero => simp only [Nat.add_zero, sub_self, Valuation.map_zero]; exact zero_le'
      | succ k ih =>
        have hsplit : henselSeq z0 (m + (k + 1)) - henselSeq z0 m =
            (henselSeq z0 (m + k + 1) - henselSeq z0 (m + k)) + (henselSeq z0 (m + k) - henselSeq z0 m) := by
          have hidx : m + (k + 1) = m + k + 1 := by omega
          rw [hidx]; ring
        rw [hsplit]
        refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ih)
        refine le_trans (hw_diff (m + k)) ?_
        exact WithZero.exp_le_exp.mpr (by omega)
    have hw_symm : ∀ N a b : ℕ, N ≤ a → N ≤ b →
        Valued.v (henselSeq z0 b - henselSeq z0 a) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      intro N a b ha hb
      have ha' : Valued.v (henselSeq z0 a - henselSeq z0 N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (a - N); rwa [Nat.add_sub_of_le ha] at h1
      have hb' : Valued.v (henselSeq z0 b - henselSeq z0 N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (b - N); rwa [Nat.add_sub_of_le hb] at h1
      have hsub : henselSeq z0 b - henselSeq z0 a =
          (henselSeq z0 b - henselSeq z0 N) - (henselSeq z0 a - henselSeq z0 N) := by ring
      rw [hsub]
      exact le_trans (Valuation.map_sub _ _ _) (max_le hb' ha')
    have hcauchy : CauchySeq (henselSeq z0) := by
      rw [CauchySeq, Valued.cauchy_iff]
      refine ⟨Filter.map_neBot, ?_⟩
      intro γ
      obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp (Units.ne_zero γ)
      let m : ℤ := Multiplicative.toAdd g
      let N : ℕ := (-m).toNat
      have hlt : WithZero.exp (-(N + 1 : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← hg]
        change WithZero.exp (-(N + 1 : ℤ)) < WithZero.exp m
        exact WithZero.exp_lt_exp.mpr (by omega)
      refine ⟨(henselSeq z0) '' Set.Ici N, Filter.image_mem_map (Filter.mem_atTop N), ?_⟩
      rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      exact lt_of_le_of_lt (hw_symm N a b ha hb) hlt
    obtain ⟨w_inf, hw_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
    have hw_shift : Filter.Tendsto (fun k => henselSeq z0 (k + 1)) Filter.atTop (nhds w_inf) :=
      (Filter.tendsto_add_atTop_iff_nat 1).mpr hw_lim
    have hw_rhs : Filter.Tendsto (fun k => henselSeq z0 (k + 1)) Filter.atTop (nhds (z0 - w_inf ^ 2)) := by
      have hfun : (fun k => henselSeq z0 (k + 1)) = (fun k => z0 - (henselSeq z0 k) ^ 2) := rfl
      rw [hfun]; exact tendsto_const_nhds.sub (hw_lim.pow 2)
    have hw_eq : w_inf = z0 - w_inf ^ 2 := tendsto_nhds_unique hw_shift hw_rhs
    refine ⟨1 + 2 * w_inf, ?_⟩
    rw [h1x]
    linear_combination -4 * hw_eq
  
  have h_step_drop : ∀ (S₁ S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      Disjoint S₁ T → v₀ ∉ T → v₀ ∉ S₁ →
      (∀ v, v ∈ S₂ ↔ v ∈ S₁ ∨ v = v₀) →
      (∀ v ∈ S₁, IsLocalUnif v (algebraMap K (v.adicCompletion K) (t : K))) →
      IsLocalUnif v₀ (algebraMap K (v₀.adicCompletion K) (t : K)) →
      ∀ w₀ w₁ : Kˣ × Kˣ,
        (sqCl w₀.1, sqCl w₀.2) ∈ selmerStruct K a₁ a₂ a₃ T S₁
          (fun v => algebraMap K (v.adicCompletion K) (t : K)) →
        (sqCl w₁.1, sqCl w₁.2) ∈ selmerStruct K a₁ a₂ a₃ T S₁
          (fun v => algebraMap K (v.adicCompletion K) (t : K)) →
        ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (w₀.1 : K)) →
        IsSquare (algebraMap K (v₀.adicCompletion K) (w₀.2 : K)) →
        IsSquare (algebraMap K (v₀.adicCompletion K) (w₁.1 : K)) →
        ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (w₁.2 : K)) →
        (∀ p : Kˣ × Kˣ,
          (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S₁
            (fun v => algebraMap K (v.adicCompletion K) (t : K)) →
          IsSquare (algebraMap K (v₀.adicCompletion K) (p.1 : K)) →
          IsSquare (algebraMap K (v₀.adicCompletion K) (p.2 : K)) →
          (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S₂
            (fun v => algebraMap K (v.adicCompletion K) (t : K))) ∧
        (∀ p : Kˣ × Kˣ,
          (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S₂
            (fun v => algebraMap K (v.adicCompletion K) (t : K)) →
          (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S₁
            (fun v => algebraMap K (v.adicCompletion K) (t : K)) ∧
          IsSquare (algebraMap K (v₀.adicCompletion K) (p.1 : K)) ∧
          IsSquare (algebraMap K (v₀.adicCompletion K) (p.2 : K))) := by
    intro S₁ S₂ v₀ hSdisj hv₀T hv₀S hS' hπ hπ₀ w₀ w₁ hw₀_mem hw₁_mem hw₀_1 hw₀_2 hw₁_1 hw₁_2
    let π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K := fun v => algebraMap K (v.adicCompletion K) (t : K)
    obtain ⟨hval2, hval12, hval13, _⟩ := h_good_vals v₀ hv₀T
    have hv_eq : ∀ k : K, Valued.v (algebraMap K (v₀.adicCompletion K) k) =
        (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) k :=
      fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v₀ k
    have hv12 : Valued.v (algebraMap K (v₀.adicCompletion K) (a₁ - a₂)) = 1 := by rw [hv_eq, hval12]
    have hv13 : Valued.v (algebraMap K (v₀.adicCompletion K) (a₁ - a₃)) = 1 := by rw [hv_eq, hval13]
    have hv_unit : ∀ u : Kˣ, Valued.v (algebraMap K (v₀.adicCompletion K) (u : K)) =
        ((v₀.valuationOfNeZero u : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      intro u; rw [hv_eq, ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v₀ u]
    have hsqCl_sq_imp : ∀ x y : Kˣ, sqCl x = sqCl y →
        IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) →
        IsSquare (algebraMap K (v₀.adicCompletion K) (y : K)) := by
      intro x y hxy ⟨r, hr⟩
      obtain ⟨s, hs⟩ := QuotientGroup.eq.mp hxy
      have hy_eq : y = x * (s * s) := by
        have hs' : s * s = x⁻¹ * y := by simpa [powMonoidHom_apply, sq] using hs
        exact eq_mul_of_inv_mul_eq hs'.symm
      refine ⟨r * algebraMap K (v₀.adicCompletion K) (s : K), ?_⟩
      rw [hy_eq]; simp only [Units.val_mul, map_mul, hr]; ring
    have hsqCl_sq_iff : ∀ x y : Kˣ, sqCl x = sqCl y →
        (IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) ↔
         IsSquare (algebraMap K (v₀.adicCompletion K) (y : K))) :=
      fun x y hxy => ⟨hsqCl_sq_imp x y hxy, hsqCl_sq_imp y x hxy.symm⟩
    have hram_even : ∀ (x₁ x₂ : Kˣ), EvenVal v₀ x₁ → EvenVal v₀ x₂ →
        RamLocal a₁ a₂ a₃ v₀ (π v₀) x₁ x₂ →
        IsSquare (algebraMap K (v₀.adicCompletion K) (x₁ : K)) ∧
        IsSquare (algebraMap K (v₀.adicCompletion K) (x₂ : K)) := by
      intro x₁ x₂ hx₁ hx₂ hram
      obtain ⟨n_odd, hn_odd, hπ_val⟩ := hπ₀
      have h_not_even_of_sq_pi_mul : ∀ (u : Kˣ) (c : v₀.adicCompletion K),
          Valued.v c = 1 →
          (∃ r : v₀.adicCompletion K,
            Valued.v (π v₀ * (algebraMap K (v₀.adicCompletion K) (u : K) * c)) = Valued.v (r * r)) →
          ¬ EvenVal v₀ u := by
        intro u c hc ⟨r, h1⟩
        rw [map_mul, map_mul, map_mul, hπ_val, hv_unit u, hc, mul_one, ← WithZero.coe_mul] at h1
        have hr_ne : Valued.v r ≠ 0 := by
          intro h0; rw [h0, mul_zero] at h1; exact WithZero.coe_ne_zero h1
        obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hr_ne
        rw [← hg, ← WithZero.coe_mul, WithZero.coe_inj] at h1
        have h2 := congrArg Multiplicative.toAdd h1
        rw [toAdd_mul, toAdd_mul, toAdd_ofAdd] at h2
        rintro ⟨d, hd⟩; obtain ⟨l, hl⟩ := hn_odd; omega
      rcases hram with h1 | ⟨_, r, hr⟩ | ⟨⟨r, hr⟩, _⟩ | ⟨⟨r, hr⟩, _⟩
      · exact h1
      · exfalso
        apply h_not_even_of_sq_pi_mul x₂ (algebraMap K (v₀.adicCompletion K) (a₁ - a₂)) hv12
        · refine ⟨r, ?_⟩; have := congrArg Valued.v hr; simpa [map_mul] using this
