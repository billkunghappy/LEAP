      intro c
      rw [hcoset_mem, hW_char, hV_mul_iff g₂ c hg₂_V]
      constructor
      · rintro ⟨hcV, h1, h2⟩
        exact ⟨hcV, (hg₂_Q c hcV).1.mp h1, (hg₂_Q c hcV).2.mp h2⟩
      · rintro ⟨hcV, h1, h2⟩
        exact ⟨hcV, (hg₂_Q c hcV).1.mpr h1, (hg₂_Q c hcV).2.mpr h2⟩
    have hW₃_char : ∀ c : SqCl K × SqCl K, c ∈ W₃ ↔ c ∈ V ∧ ¬ Q c.1 ∧ ¬ Q c.2 := by
      intro c
      rw [hcoset_mem, hW_char, hV_mul_iff (g₁ * g₂) c hg₁₂_V]
      have hgc : (g₁ * g₂) * c = g₁ * (g₂ * c) := mul_assoc g₁ g₂ c
      rw [hgc]
      constructor
      · rintro ⟨hcV, h1, h2⟩
        have hg₂c_V : g₂ * c ∈ V := hV_mul_abs g₂ c hg₂_V hcV
        have h1' : ¬ Q (g₂.1 * c.1) := (hg₁_Q (g₂ * c) hg₂c_V).1.mp h1
        have h2' : Q (g₂.2 * c.2) := (hg₁_Q (g₂ * c) hg₂c_V).2.mp h2
