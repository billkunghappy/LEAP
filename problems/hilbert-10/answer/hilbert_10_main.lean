      have hkB : B < Height.logHeight₁ (u k) := ih.1
      have hne1 : u k ≠ -a₁ := by intro heq; rw [heq] at hkB; linarith
      have hne2 : u k ≠ -a₂ := by intro heq; rw [heq] at hkB; linarith
      have hne3 : u k ≠ -a₃ := by intro heq; rw [heq] at hkB; linarith
      have hstep : 4 * Height.logHeight₁ (u k) - C ≤ Height.logHeight₁ (u (k + 1)) := by
        rw [hu_succ k]
        exact hdup (u k) hne1 hne2 hne3
      have hC_le : C ≤ |C| := le_abs_self C
      have hC_nonneg : 0 ≤ |C| := abs_nonneg C
      have hlt : Height.logHeight₁ (u k) < Height.logHeight₁ (u (k + 1)) := by linarith
      refine ⟨by linarith, fun _ => hlt⟩
  have hstrict : StrictMono (fun k => Height.logHeight₁ (u k)) :=
    strictMono_nat_of_lt_succ (fun k => (hu_gt (k + 1)).2 (Nat.succ_pos k))
  let W := (threeRootsCurve (-((t : K) * a₁)) (-((t : K) * a₂)) (-((t : K) * a₃))).toAffine
  let P₀ : W.Point := WeierstrassCurve.Affine.Point.some h₀
  have hpt : ∀ k : ℕ, ∃ (Yk : K) (hk : W.Nonsingular ((t : K) * u k) Yk),
      Yk ≠ 0 ∧ (2 ^ k : ℕ) • P₀ = WeierstrassCurve.Affine.Point.some hk := by
    intro k
    induction k with
    | zero =>
      refine ⟨Y₀, h₀, hY₀, ?_⟩
      rw [pow_zero, one_nsmul]
    | succ k ih =>
      rcases ih with ⟨Yk, hk, hYk, hPk⟩
      have hk1B : B < Height.logHeight₁ (u (k + 1)) := (hu_gt (k + 1)).1
      have hne1 : dupMap a₁ a₂ a₃ (u k) ≠ -a₁ := by
        intro heq; rw [hu_succ k, heq] at hk1B; linarith
      have hne2 : dupMap a₁ a₂ a₃ (u k) ≠ -a₂ := by
        intro heq; rw [hu_succ k, heq] at hk1B; linarith
      have hne3 : dupMap a₁ a₂ a₃ (u k) ≠ -a₃ := by
        intro heq; rw [hu_succ k, heq] at hk1B; linarith
      rcases hdouble (u k) Yk hYk hk hne1 hne2 hne3 with ⟨Yk', hk', hYk', hadd⟩
      have hk'' : W.Nonsingular ((t : K) * u (k + 1)) Yk' := by
        rwa [hu_succ k]
      refine ⟨Yk', hk'', hYk', ?_⟩
      have hpow : (2 ^ (k + 1) : ℕ) = 2 ^ k + 2 ^ k := by ring
      rw [hpow, add_nsmul, hPk, hadd]
      congr 1
      rw [hu_succ k]
  let f : ℕ → W.Point := fun k => (2 ^ k : ℕ) • P₀
  have hinj : Function.Injective f := by
    intro i j hij
    rcases hpt i with ⟨Yi, hi, _, hPi⟩
    rcases hpt j with ⟨Yj, hj, _, hPj⟩
    have hsome : WeierstrassCurve.Affine.Point.some hi = WeierstrassCurve.Affine.Point.some hj := by
      rw [← hPi, ← hPj]; exact hij
    injection hsome with htu _
    have huij : u i = u j := mul_left_cancel₀ t.ne_zero htu
    exact hstrict.injective (congrArg Height.logHeight₁ huij)
  have hinf_range : (Set.range f).Infinite := Set.infinite_range_of_injective hinj
  have hsub : Set.range f ⊆ (AddSubgroup.zmultiples P₀ : Set W.Point) := by
    rintro _ ⟨k, rfl⟩
    rw [SetLike.mem_coe, AddSubgroup.mem_zmultiples_iff]
    exact ⟨(2 ^ k : ℕ), natCast_zsmul P₀ (2 ^ k)⟩
  have hnot_fin : ¬ IsOfFinAddOrder P₀ := by
    intro hfin
    exact hinf_range (hfin.finite_zmultiples.subset hsub)
  have h_no_zsmul : ∀ n : ℤ, n • P₀ = 0 → n = 0 := by
    intro n hn
    by_contra hne
    apply hnot_fin
    rw [isOfFinAddOrder_iff_zsmul_eq_zero]
    exact ⟨n, hne, hn⟩
  have hlin : LinearIndependent ℤ (fun (_ : PUnit.{u + 1}) => P₀) := by
    rw [linearIndependent_iff]
    intro l hl
    ext
    rw [Finsupp.linearCombination_unique] at hl
    exact h_no_zsmul (l PUnit.unit) hl
  have hcard := hlin.cardinal_le_rank
  rw [Cardinal.mk_punit] at hcard
  unfold mordellWeilRank
  convert Cardinal.one_le_iff_pos.mp hcard

theorem exists_initial_ordered_triple (K : Type u) [Field K] [NumberField K]
    (hreal : 32 ≤ NumberField.InfinitePlace.nrRealPlaces K) :
    ∃ (a'₁ a'₂ a'₃ : NumberField.RingOfIntegers K)
      (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
      (σ₁₂ : {w : NumberField.InfinitePlace K // w.IsReal}),
      Function.Injective τ ∧
      (∀ j : Fin 12, σ₁₂ ≠ τ j) ∧
      HasStartingOrderings K (a'₁ : K) (a'₂ : K) (a'₃ : K) τ :=
by
  classical
  have hcard : 32 ≤ Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} := by
    rw [NumberField.InfinitePlace.nrRealPlaces] at hreal
    convert hreal
  let e := Fintype.equivFin {w : NumberField.InfinitePlace K // w.IsReal}
  let τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal} :=
    fun j => e.symm ⟨j.1, by omega⟩
  let σ₁₂ : {w : NumberField.InfinitePlace K // w.IsReal} :=
    e.symm ⟨12, by omega⟩
  have hτ : Function.Injective τ := by
    intro i j hij
    have h1 := e.symm.injective hij
    ext
    exact Fin.mk.inj_iff.mp h1
  have hσ₁₂ : ∀ j : Fin 12, σ₁₂ ≠ τ j := by
    intro j hj
    have h1 := Fin.mk.inj_iff.mp (e.symm.injective hj)
    omega
  have heτ : ∀ j : Fin 12, (e (τ j)).1 = j.1 := by
    intro j
    change (e (e.symm ⟨j.1, _⟩)).1 = j.1
    rw [e.apply_symm_apply]
  let bℤ := NumberField.RingOfIntegers.basis K
  let bℝ := NumberField.mixedEmbedding.latticeBasis K
  have hb : ∀ i (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (bℝ i).1 w = realPlaceEmb w (bℤ i : K) := by
    intro i w
    change (NumberField.mixedEmbedding.latticeBasis K i).1 w =
      realPlaceEmb w (NumberField.RingOfIntegers.basis K i : K)
    rw [NumberField.mixedEmbedding.latticeBasis_apply, NumberField.integralBasis_apply,
      NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
    rfl
  let approxInt (f : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) (M : ℕ) :
      NumberField.RingOfIntegers K :=
    ∑ i, (⌊(M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i)⌋ :
      NumberField.RingOfIntegers K) * bℤ i
  have happrox_emb : ∀ (f : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) (M : ℕ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      realPlaceEmb w (approxInt f M : K) =
        ∑ i, (⌊(M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i)⌋ : ℝ) *
          (bℝ i).1 w := by
    intro f M w
    dsimp only [approxInt]
    push_cast
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [hb]
  have hf_exp : ∀ (f : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) (M : ℕ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      (M : ℝ) * f w =
        ∑ i, ((M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i)) *
          (bℝ i).1 w := by
    intro f M w
    have hsum := bℝ.sum_repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K)
    have h1 : (∑ i, bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i • bℝ i).1 w = f w := by
      rw [hsum]
    rw [← h1, Prod.fst_sum, Finset.sum_apply, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [mul_assoc]
  have happrox_err : ∀ (f : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) (M : ℕ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      |realPlaceEmb w (approxInt f M : K) - (M : ℝ) * f w| ≤ ∑ i, |(bℝ i).1 w| := by
    intro f M w
    rw [happrox_emb, hf_exp, ← Finset.sum_sub_distrib]
    have hsub : (∑ i, ((⌊(M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i)⌋ : ℝ) *
          (bℝ i).1 w -
        ((M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i)) * (bℝ i).1 w)) =
        ∑ i, ((⌊(M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i)⌋ : ℝ) -
          (M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i)) * (bℝ i).1 w := by
      refine Finset.sum_congr rfl fun i _ => by ring
    rw [hsub]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [abs_mul]
    refine mul_le_of_le_one_left (abs_nonneg _) ?_
    rw [abs_le]
    constructor
    · linarith [Int.sub_one_lt_floor ((M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i))]
    · linarith [Int.floor_le ((M : ℝ) * (bℝ.repr ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i))]
  let B : ℝ := 1 + ∑ w' : {w : NumberField.InfinitePlace K // w.IsReal}, ∑ i, |(bℝ i).1 w'|
  let M : ℕ := ⌈3 * B⌉₊
  have hB_ge : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (∑ i, |(bℝ i).1 w|) ≤ B - 1 := by
    intro w
    have hle : (∑ i, |(bℝ i).1 w|) ≤
        ∑ w' : {w : NumberField.InfinitePlace K // w.IsReal}, ∑ i, |(bℝ i).1 w'| :=
      Finset.single_le_sum (f := fun w' : {w : NumberField.InfinitePlace K // w.IsReal} => ∑ i, |(bℝ i).1 w'|)
        (fun w' _ => Finset.sum_nonneg fun i _ => abs_nonneg _) (Finset.mem_univ w)
    linarith
  have hB_pos : 1 ≤ B := by
    have hnonneg : 0 ≤ ∑ w' : {w : NumberField.InfinitePlace K // w.IsReal}, ∑ i, |(bℝ i).1 w'| :=
      Finset.sum_nonneg fun w' _ => Finset.sum_nonneg fun i _ => abs_nonneg _
    linarith
  have hM_ge : 3 * B ≤ (M : ℝ) := Nat.le_ceil (3 * B)
  have hstep : ∀ (f₁ f₂ : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}),
      f₁ w + 1 ≤ f₂ w →
      realPlaceEmb w (approxInt f₁ M : K) < realPlaceEmb w (approxInt f₂ M : K) := by
    intro f₁ f₂ w h12
    have herr1 := (happrox_err f₁ M w).trans (hB_ge w)
    have herr2 := (happrox_err f₂ M w).trans (hB_ge w)
    have h1 := (abs_le.mp herr1).2
    have h2 := (abs_le.mp herr2).1
    have hM_pos : 0 < (M : ℝ) := by linarith
    have hgap : (M : ℝ) * (f₁ w + 1) ≤ (M : ℝ) * f₂ w :=
      mul_le_mul_of_nonneg_left h12 (by linarith)
    linarith
  let val₁ : ℕ → ℝ := fun n =>
    if n = 0 ∨ n = 4 ∨ n = 6 ∨ n = 10 then 2
    else if n = 1 ∨ n = 5 ∨ n = 7 ∨ n = 11 ∨ n = 3 ∨ n = 9 then 1
    else if n = 2 ∨ n = 8 then 3
    else 0
  let val₂ : ℕ → ℝ := fun n =>
    if n = 0 ∨ n = 4 ∨ n = 6 ∨ n = 10 ∨ n = 2 ∨ n = 8 then 1
    else if n = 1 ∨ n = 5 ∨ n = 7 ∨ n = 11 then 2
    else if n = 3 ∨ n = 9 then 3
    else 0
  let val₃ : ℕ → ℝ := fun n =>
    if n = 0 ∨ n = 4 ∨ n = 6 ∨ n = 10 ∨ n = 1 ∨ n = 5 ∨ n = 7 ∨ n = 11 then 3
    else if n = 2 ∨ n = 8 ∨ n = 3 ∨ n = 9 then 2
    else 0
  let f₁ : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ := fun w => val₁ (e w).1
  let f₂ : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ := fun w => val₂ (e w).1
  let f₃ : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ := fun w => val₃ (e w).1
  refine ⟨approxInt f₁ M, approxInt f₂ M, approxInt f₃ M, τ, σ₁₂, hτ, hσ₁₂, ?_⟩
  refine ⟨⟨hstep f₂ f₁ (τ 0) ?_, hstep f₁ f₃ (τ 0) ?_⟩,
    ⟨hstep f₁ f₂ (τ 1) ?_, hstep f₂ f₃ (τ 1) ?_⟩,
    ⟨hstep f₂ f₃ (τ 2) ?_, hstep f₃ f₁ (τ 2) ?_⟩,
    ⟨hstep f₁ f₃ (τ 3) ?_, hstep f₃ f₂ (τ 3) ?_⟩,
    ⟨hstep f₂ f₁ (τ 4) ?_, hstep f₁ f₃ (τ 4) ?_⟩,
    ⟨hstep f₁ f₂ (τ 5) ?_, hstep f₂ f₃ (τ 5) ?_⟩,
    ⟨hstep f₂ f₁ (τ 6) ?_, hstep f₁ f₃ (τ 6) ?_⟩,
    ⟨hstep f₁ f₂ (τ 7) ?_, hstep f₂ f₃ (τ 7) ?_⟩,
    ⟨hstep f₂ f₃ (τ 8) ?_, hstep f₃ f₁ (τ 8) ?_⟩,
    ⟨hstep f₁ f₃ (τ 9) ?_, hstep f₃ f₂ (τ 9) ?_⟩,
    ⟨hstep f₂ f₁ (τ 10) ?_, hstep f₁ f₃ (τ 10) ?_⟩,
    ⟨hstep f₁ f₂ (τ 11) ?_, hstep f₂ f₃ (τ 11) ?_⟩⟩ <;>
  · dsimp only [f₁, f₂, f₃, val₁, val₂, val₃]
    rw [heτ]
    norm_num

theorem isStartingTriple_and_exists_goodT_of_orderings (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : NumberField.RingOfIntegers K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (hτ : Function.Injective τ)
    (hord : HasStartingOrderings K (a₁ : K) (a₂ : K) (a₃ : K) τ)
    (hroot : globalRootNumber (threeRootsCurve (a₁ : K) (a₂ : K) (a₃ : K)) = 1) :
    ∃ T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsStartingTriple K (a₁ : K) (a₂ : K) (a₃ : K) τ ∧
      IsGoodT (a₁ : K) (a₂ : K) (a₃ : K) T :=
by
  rcases hord with ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩
  have h₁₂ : (a₁ : K) ≠ (a₂ : K) := by
    intro h
    have h' : realPlaceEmb (τ 0) (a₁ : K) = realPlaceEmb (τ 0) (a₂ : K) := by rw [h]
    exact (ne_of_gt h0.1) h'
  have h₁₃ : (a₁ : K) ≠ (a₃ : K) := by
    intro h
    have h' : realPlaceEmb (τ 0) (a₁ : K) = realPlaceEmb (τ 0) (a₃ : K) := by rw [h]
    exact (ne_of_lt h0.2) h'
  have h₂₃ : (a₂ : K) ≠ (a₃ : K) := by
    intro h
    have h' : realPlaceEmb (τ 0) (a₂ : K) = realPlaceEmb (τ 0) (a₃ : K) := by rw [h]
    exact (ne_of_lt (lt_trans h0.1 h0.2)) h'
  have not_isSquare_of_neg : ∀ (j : Fin 12) (x : K),
      realPlaceEmb (τ j) x < 0 → ¬ IsSquare x := by
    intro j x hneg ⟨r, hr⟩
    rw [hr, map_mul] at hneg
    linarith [mul_self_nonneg (realPlaceEmb (τ j) r)]
  have h0α : 0 < realPlaceEmb (τ 0) ((a₁ : K) - (a₂ : K)) := by
    rw [map_sub]; linarith [h0.1]
  have h0β : realPlaceEmb (τ 0) ((a₁ : K) - (a₃ : K)) < 0 := by
    rw [map_sub]; linarith [h0.2]
  have h0γ : realPlaceEmb (τ 0) ((a₂ : K) - (a₃ : K)) < 0 := by
    rw [map_sub]; linarith [h0.1, h0.2]
  have h1α : realPlaceEmb (τ 1) ((a₁ : K) - (a₂ : K)) < 0 := by
    rw [map_sub]; linarith [h1.1]
  have h1β : realPlaceEmb (τ 1) ((a₁ : K) - (a₃ : K)) < 0 := by
    rw [map_sub]; linarith [h1.1, h1.2]
  have h1γ : realPlaceEmb (τ 1) ((a₂ : K) - (a₃ : K)) < 0 := by
    rw [map_sub]; linarith [h1.2]
  have h2α : 0 < realPlaceEmb (τ 2) ((a₁ : K) - (a₂ : K)) := by
    rw [map_sub]; linarith [h2.1, h2.2]
  have h2β : 0 < realPlaceEmb (τ 2) ((a₁ : K) - (a₃ : K)) := by
    rw [map_sub]; linarith [h2.2]
  have h2γ : realPlaceEmb (τ 2) ((a₂ : K) - (a₃ : K)) < 0 := by
    rw [map_sub]; linarith [h2.1]
  have h3α : realPlaceEmb (τ 3) ((a₁ : K) - (a₂ : K)) < 0 := by
    rw [map_sub]; linarith [h3.1, h3.2]
  have h3β : realPlaceEmb (τ 3) ((a₁ : K) - (a₃ : K)) < 0 := by
    rw [map_sub]; linarith [h3.1]
  have h3γ : 0 < realPlaceEmb (τ 3) ((a₂ : K) - (a₃ : K)) := by
    rw [map_sub]; linarith [h3.2]
  have hsq₁ : ¬ IsSquare (((a₁ : K) - (a₂ : K)) * ((a₁ : K) - (a₃ : K))) := by
    apply not_isSquare_of_neg 0
    rw [map_mul]
    exact mul_neg_of_pos_of_neg h0α h0β
  have hsq₂ : ¬ IsSquare (-(((a₁ : K) - (a₂ : K)) * ((a₂ : K) - (a₃ : K)))) := by
    apply not_isSquare_of_neg 1
    rw [map_neg, map_mul]
    linarith [mul_pos_of_neg_of_neg h1α h1γ]
  have hsq₃ : ¬ IsSquare (((a₁ : K) - (a₃ : K)) * ((a₂ : K) - (a₃ : K))) := by
    apply not_isSquare_of_neg 2
    rw [map_mul]
    exact mul_neg_of_pos_of_neg h2β h2γ
  have hind : ∀ e₀ e₁ e₂ e₃ : Fin 2,
      IsSquare ((-1 : K) ^ (e₀ : ℕ) * ((a₁ : K) - (a₂ : K)) ^ (e₁ : ℕ) *
        ((a₁ : K) - (a₃ : K)) ^ (e₂ : ℕ) * ((a₂ : K) - (a₃ : K)) ^ (e₃ : ℕ)) →
      e₀ = 0 ∧ e₁ = 0 ∧ e₂ = 0 ∧ e₃ = 0 := by
    intro e₀ e₁ e₂ e₃ hsq
    fin_cases e₀ <;> fin_cases e₁ <;> fin_cases e₂ <;> fin_cases e₃
    · exact ⟨rfl, rfl, rfl, rfl⟩
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one]
      exact h0γ
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one]
      exact h0β
    · exfalso; apply not_isSquare_of_neg 2 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, map_mul]
      exact mul_neg_of_pos_of_neg h2β h2γ
    · exfalso; apply not_isSquare_of_neg 1 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one]
      exact h1α
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, map_mul]
      exact mul_neg_of_pos_of_neg h0α h0γ
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, map_mul]
      exact mul_neg_of_pos_of_neg h0α h0β
    · exfalso; apply not_isSquare_of_neg 1 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, map_mul]
      exact mul_neg_of_pos_of_neg (mul_pos_of_neg_of_neg h1α h1β) h1γ
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, map_neg, map_one]
      linarith
    · exfalso; apply not_isSquare_of_neg 3 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, neg_mul, map_neg]
      linarith [h3γ]
    · exfalso; apply not_isSquare_of_neg 2 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, neg_mul, map_neg]
      linarith [h2β]
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, neg_mul, map_neg, map_mul]
      linarith [mul_pos_of_neg_of_neg h0β h0γ]
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, neg_mul, map_neg]
      linarith [h0α]
    · exfalso; apply not_isSquare_of_neg 1 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, neg_mul, map_neg, map_mul]
      linarith [mul_pos_of_neg_of_neg h1α h1γ]
    · exfalso; apply not_isSquare_of_neg 1 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, neg_mul, map_neg, map_mul]
      linarith [mul_pos_of_neg_of_neg h1α h1β]
    · exfalso; apply not_isSquare_of_neg 0 _ _ hsq
      simp only [Fin.zero_eta, Fin.mk_one, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
        one_mul, mul_one, neg_mul, map_neg, map_mul]
      linarith [mul_pos h0α (mul_pos_of_neg_of_neg h0β h0γ)]
  let D₀ : NumberField.RingOfIntegers K := 6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)
  have hD₀_coe : (D₀ : K) = 6 * ((a₁ : K) - (a₂ : K)) * ((a₁ : K) - (a₃ : K)) * ((a₂ : K) - (a₃ : K)) := by
    change ((6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃) : NumberField.RingOfIntegers K) : K) = _
    push_cast
    rfl
  have hD₀_ne : D₀ ≠ 0 := by
    intro h
    have hK : (D₀ : K) = 0 := by simp [h]
    rw [hD₀_coe] at hK
    have h6 : (6 : K) ≠ 0 := by norm_num
    have hne : (6 : K) * ((a₁ : K) - (a₂ : K)) * ((a₁ : K) - (a₃ : K)) * ((a₂ : K) - (a₃ : K)) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero h6 (sub_ne_zero.mpr h₁₂)) (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)
    exact hne hK
  have hI : Ideal.span ({D₀} : Set (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Submodule.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact hD₀_ne
  have hfin := Ideal.finite_factors hI
  refine ⟨hfin.toFinset, ?_, ?_⟩
  · exact ⟨h₁₂, h₁₃, h₂₃, hsq₁, hsq₂, hsq₃,
      NumberField.RingOfIntegers.isIntegral_coe a₁,
      NumberField.RingOfIntegers.isIntegral_coe a₂,
      NumberField.RingOfIntegers.isIntegral_coe a₃,
      hind, hτ, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, hroot⟩
  · intro v
    have hval : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (D₀ : K) = v.intValuation D₀ :=
      v.valuation_of_algebraMap D₀
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq, Ideal.dvd_span_singleton,
      ← hD₀_coe, hval, ne_eq, IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff, not_not]

theorem exists_sign_and_congruence_prime (K : Type u) [Field K] [NumberField K]
    (σ₁₂ : {w : NumberField.InfinitePlace K // w.IsReal})
    (m₀ : NumberField.RingOfIntegers K) (hm₀ : m₀ ≠ 0) :
    ∃ π : NumberField.RingOfIntegers K,
      Prime π ∧
      π - 1 ∈ Ideal.span {4 * m₀} ∧
      realPlaceEmb σ₁₂ (π : K) < 0 ∧
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, w ≠ σ₁₂ → 0 < realPlaceEmb w (π : K)) ∧
      Ideal.absNorm (Ideal.span {π}) % 4 = 3 :=
by
  classical
  letI : MulAction ℝ (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.mulActionSet
  let C₁ : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    (Set.univ.pi (fun w => if w = σ₁₂ then Set.Ioo (-3 / 4 : ℝ) (-1 / 4 : ℝ) else Set.Ioo (1 / 4 : ℝ) (3 / 4 : ℝ))) ×ˢ
    (Set.univ.pi (fun _ => Metric.ball (0 : ℂ) (3 / 4 : ℝ)))
  have hconv : Convex ℝ C₁ := by
    apply Convex.prod
    · apply convex_pi
      intro w _
      split_ifs <;> exact convex_Ioo _ _
    · apply convex_pi
      intro w _
      exact convex_ball _ _
  have hopen : IsOpen C₁ := by
    apply IsOpen.prod
    · apply isOpen_set_pi (Set.toFinite Set.univ)
      intro w _
      split_ifs <;> exact isOpen_Ioo
    · apply isOpen_set_pi (Set.toFinite Set.univ)
      intro w _
      exact Metric.isOpen_ball
  have hbdd : Bornology.IsBounded C₁ := by
    apply Bornology.IsBounded.prod
    · rw [Bornology.isBounded_pi]
      right
      intro w
      split_ifs <;> exact Metric.isBounded_Ioo _ _
    · rw [Bornology.isBounded_pi]
      right
      intro w
      exact Metric.isBounded_ball
  have hne_C₁ : C₁.Nonempty := by
    refine ⟨(fun w => if w = σ₁₂ then (-1 / 2 : ℝ) else (1 / 2 : ℝ), fun _ => (0 : ℂ)), ?_, ?_⟩
    · intro w _
      dsimp
      split_ifs <;> constructor <;> norm_num
    · intro w _
      exact Metric.mem_ball_self (by norm_num)
  have hv₀ : 0 < (MeasureTheory.volume C₁).toReal := by
    have hpos : 0 < MeasureTheory.volume C₁ :=
      IsOpen.measure_pos MeasureTheory.volume hopen hne_C₁
    have hlt : MeasureTheory.volume C₁ < ⊤ :=
      Bornology.IsBounded.measure_lt_top hbdd
    exact ENNReal.toReal_pos (ne_of_gt hpos) (ne_of_lt hlt)
  have hnorm1 : ∀ u ∈ C₁, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w u < 1 := by
    intro u hu w
    by_cases hw : w.IsReal
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw u]
      have hu1 := hu.1 ⟨w, hw⟩ (Set.mem_univ _)
      dsimp at hu1
      split_ifs at hu1 with hσ
      · rw [Real.norm_eq_abs, abs_lt]
        exact ⟨by linarith [hu1.1], by linarith [hu1.2]⟩
      · rw [Real.norm_eq_abs, abs_lt]
        exact ⟨by linarith [hu1.1], by linarith [hu1.2]⟩
    · have hwc : w.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hwc u]
      have hu2 := hu.2 ⟨w, hwc⟩ (Set.mem_univ _)
      dsimp at hu2
      rw [mem_ball_zero_iff] at hu2
      linarith
  have hC₁_scale : ∀ X : ℝ, 0 < X →
      Convex ℝ (X • C₁) ∧
      IsOpen (X • C₁) ∧
      (∀ z ∈ X • C₁, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X) ∧
      (MeasureTheory.volume (X • C₁)).toReal =
        X ^ (Module.finrank ℚ K) * (MeasureTheory.volume C₁).toReal := by
    intro X hX
    refine ⟨Convex.smul hconv X, IsOpen.smul₀ hopen (ne_of_gt hX), ?_, ?_⟩
    · intro z hz w
      rw [Set.mem_smul_set] at hz
      rcases hz with ⟨u, hu, rfl⟩
      rw [NumberField.mixedEmbedding.normAtPlace_smul w u X, abs_of_pos hX]
      exact mul_lt_of_lt_one_right hX (hnorm1 u hu w)
    · rw [MeasureTheory.Measure.addHaar_smul MeasureTheory.volume X C₁,
        NumberField.mixedEmbedding.finrank K]
      have hXpow : 0 < X ^ (Module.finrank ℚ K) := pow_pos hX _
      rw [abs_of_pos hXpow, ENNReal.toReal_mul, ENNReal.toReal_ofReal (le_of_lt hXpow)]
  have hC₁_sign : ∀ (X : ℝ) (x : K), 0 < X →
      NumberField.mixedEmbedding K x ∈ X • C₁ →
      realPlaceEmb σ₁₂ x < 0 ∧
      ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, w ≠ σ₁₂ → 0 < realPlaceEmb w x := by
    intro X x hX hx
    rw [Set.mem_smul_set] at hx
    rcases hx with ⟨u, hu, hxu⟩
    have hreal : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
        realPlaceEmb w x = X * u.1 w := by
      intro w
      have h1 : realPlaceEmb w x = (NumberField.mixedEmbedding K x).1 w :=
        (NumberField.mixedEmbedding.mixedEmbedding_apply_isReal K x w).symm
      rw [h1, ← hxu]
      rfl
    refine ⟨?_, ?_⟩
    · rw [hreal σ₁₂]
      have huσ := hu.1 σ₁₂ (Set.mem_univ _)
      dsimp at huσ
      rw [if_pos rfl] at huσ
      exact mul_neg_of_pos_of_neg hX (by linarith [huσ.2])
    · intro w hw
      rw [hreal w]
      have huw := hu.1 w (Set.mem_univ _)
      dsimp at huw
      rw [if_neg hw] at huw
      exact mul_pos hX (by linarith [huw.1])
  let q : Ideal (NumberField.RingOfIntegers K) := Ideal.span {4 * m₀}
  have h4m₀ : (4 * m₀ : NumberField.RingOfIntegers K) ≠ 0 :=
    mul_ne_zero (by norm_num) hm₀
  have hq0 : q ≠ 0 := by
    change Ideal.span {4 * m₀} ≠ ⊥
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact h4m₀
  have hunit : IsUnit (Ideal.Quotient.mk q (1 : NumberField.RingOfIntegers K)) := by
    rw [map_one]
    exact isUnit_one
  obtain ⟨κ, c, hc, hκ, hmitsui⟩ := mitsui_prime_ideal (K := K) 2 (by norm_num)
  have hκq : 0 < κ q := hκ q hq0
  let v₀ : ℝ := (MeasureTheory.volume C₁).toReal
  let Nq : ℝ := (Ideal.absNorm q : ℝ)
  let t : ℝ := max 1 (max (Nq + 1) (2 * c ^ 2 / (κ q * v₀) + 1))
  have ht1 : 1 ≤ t := le_max_left _ _
  have htNq : Nq + 1 ≤ t := le_trans (le_max_left _ _) (le_max_right _ _)
  have htc : 2 * c ^ 2 / (κ q * v₀) + 1 ≤ t := le_trans (le_max_right _ _) (le_max_right _ _)
  have ht_pos : 0 < t := by linarith
  let X : ℝ := Real.exp (t ^ 2)
  have hX1 : 1 < X := Real.one_lt_exp_iff.mpr (by positivity)
  have hX_pos : 0 < X := by linarith
  have hlogX : Real.log X = t ^ 2 := Real.log_exp (t ^ 2)
  have hNq_lt : (Ideal.absNorm q : ℝ) < Real.log X ^ (2 : ℕ) := by
    rw [hlogX]
    have ht2 : 1 ≤ t ^ 2 := by nlinarith [ht1]
    have ht_le_t4 : t ≤ (t ^ 2) ^ 2 := by nlinarith [ht1, ht2]
    linarith
  have hsqrt : Real.sqrt (Real.log X) = t := by
    rw [hlogX, Real.sqrt_sq (le_of_lt ht_pos)]
  have herr_small : c * Real.exp (-Real.sqrt (Real.log X) / c) < κ q * v₀ / 2 := by
    rw [hsqrt, neg_div, Real.exp_neg]
    have hkv_pos : 0 < κ q * v₀ := mul_pos hκq hv₀
    have hexp_pos : 0 < Real.exp (t / c) := Real.exp_pos (t / c)
    have h_div_lt : 2 * c ^ 2 / (κ q * v₀) < t := by linarith
    have h_tc_gt : 2 * c / (κ q * v₀) < t / c := by
      have h1 : 2 * c / (κ q * v₀) * c < t := by
        calc 2 * c / (κ q * v₀) * c = 2 * c ^ 2 / (κ q * v₀) := by ring
        _ < t := h_div_lt
      exact (lt_div_iff₀ hc).mpr h1
    have hexp_gt : 2 * c / (κ q * v₀) < Real.exp (t / c) := by
      have h_add := Real.add_one_le_exp (t / c)
      linarith
    have h_mul : c < (κ q * v₀ / 2) * Real.exp (t / c) := by
      have h2 : (κ q * v₀ / 2) * (2 * c / (κ q * v₀)) < (κ q * v₀ / 2) * Real.exp (t / c) :=
        mul_lt_mul_of_pos_left hexp_gt (by positivity)
      have hkv_ne : κ q * v₀ ≠ 0 := ne_of_gt hkv_pos
      have h3 : (κ q * v₀ / 2) * (2 * c / (κ q * v₀)) = c := by
        calc (κ q * v₀ / 2) * (2 * c / (κ q * v₀))
          _ = c * ((κ q * v₀) / (κ q * v₀)) := by ring
          _ = c * 1 := by rw [div_self hkv_ne]
          _ = c := mul_one c
      linarith
    calc c * (Real.exp (t / c))⁻¹ = c / Real.exp (t / c) := div_eq_mul_inv c _ |>.symm
      _ < κ q * v₀ / 2 := (div_lt_iff₀ hexp_pos).mpr h_mul
  obtain ⟨hconv_X, hopen_X, hnorm_X, hvol_X⟩ := hC₁_scale X hX_pos
  have hbound := hmitsui X hX1 (X • C₁) hconv_X hopen_X hnorm_X q hq0 hNq_lt 1 hunit
  let S_X := {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ X • C₁ ∧ π - 1 ∈ q}
  let S_sum : ℝ := ∑' π : S_X,
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  change |S_sum - κ q * (MeasureTheory.volume (X • C₁)).toReal| ≤
      c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) at hbound
  rw [hvol_X] at hbound
  have hXpow : 0 < X ^ (Module.finrank ℚ K) := pow_pos hX_pos _
  have hS_pos : 0 < S_sum := by
    have hlow := (abs_sub_le_iff.mp hbound).2
    have h_diff : c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) <
        (κ q * v₀ / 2) * X ^ (Module.finrank ℚ K) := by
      calc c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c)
        _ = (c * Real.exp (-Real.sqrt (Real.log X) / c)) * X ^ (Module.finrank ℚ K) := by ring
        _ < (κ q * v₀ / 2) * X ^ (Module.finrank ℚ K) := mul_lt_mul_of_pos_right herr_small hXpow
    have hmain_pos : 0 < (κ q * v₀ / 2) * X ^ (Module.finrank ℚ K) := by positivity
    linarith
  have hne_S : Nonempty S_X := by
    by_contra hemp
    rw [not_nonempty_iff] at hemp
    have hzero : S_sum = 0 := by
      dsimp [S_sum]
      exact tsum_empty
    linarith
  obtain ⟨⟨π, hπ_prime, hπ_mem, hπ_mod⟩⟩ := hne_S
  obtain ⟨hπ_neg, hπ_pos⟩ := hC₁_sign X (π : K) hX_pos hπ_mem
  have hnorm_mod : Algebra.norm ℤ π % 4 = 1 := by
    have hπ_span := hπ_mod
    rw [Ideal.mem_span_singleton] at hπ_span
    rcases hπ_span with ⟨k, hk⟩
    have hπ_eq : π = 1 + 4 * (m₀ * k) := by linear_combination hk
    let b := NumberField.RingOfIntegers.basis K
    let Φ := (LinearMap.toMatrixAlgEquiv b).toRingHom.comp
      (Algebra.lmul ℤ (NumberField.RingOfIntegers K)).toRingHom
    have hnorm : Algebra.norm ℤ π = (Φ π).det := by
      rw [Algebra.norm_apply, ← LinearMap.det_toMatrix b]
      rfl
    have hΦ : Φ π = 1 + 4 * Φ (m₀ * k) := by
      rw [hπ_eq, map_add, map_one, map_mul, map_ofNat]
    let f : ℤ →+* ZMod 4 := Int.castRingHom (ZMod 4)
    have hdet_mod : ((Algebra.norm ℤ π : ℤ) : ZMod 4) = ((1 : ℤ) : ZMod 4) := by
      change f (Algebra.norm ℤ π) = f 1
      rw [hnorm, RingHom.map_det f (Φ π), hΦ]
      have hmat : f.mapMatrix (1 + 4 * Φ (m₀ * k)) = 1 := by
        rw [map_add, map_one, map_mul, map_ofNat]
        let g := algebraMap (ZMod 4) (Matrix (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K))
          (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) (ZMod 4))
        have h4g : g 4 = 4 := map_ofNat g 4
        have h4z : (4 : ZMod 4) = 0 := rfl
        have h4 : (4 : Matrix (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K))
            (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) (ZMod 4)) = 0 := by
          rw [← h4g, h4z, map_zero]
        rw [h4, zero_mul, add_zero]
      rw [hmat, Matrix.det_one, map_one]
    exact (ZMod.intCast_eq_intCast_iff' (Algebra.norm ℤ π) 1 4).mp hdet_mod
  have hnorm_neg : Algebra.norm ℤ π < 0 := by
    let pFactor : NumberField.InfinitePlace K → ℝ :=
      fun w => if hw : w.IsReal then realPlaceEmb ⟨w, hw⟩ (π : K) else Complex.normSq (w.embedding (π : K))
    have hπ0 : (π : K) ≠ 0 := by
      intro h
      have : realPlaceEmb σ₁₂ (π : K) = 0 := by rw [h, map_zero]
      linarith
    have hfiber : ∀ w : NumberField.InfinitePlace K,
        ∏ φ ∈ Finset.univ.filter (fun φ : K →+* ℂ => NumberField.InfinitePlace.mk φ = w), φ (π : K) =
          (pFactor w : ℂ) := by
      intro w
      have hset : Finset.univ.filter (fun φ : K →+* ℂ => NumberField.InfinitePlace.mk φ = w) =
          {w.embedding, NumberField.ComplexEmbedding.conjugate w.embedding} := by
        ext φ
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Finset.mem_singleton]
        conv_lhs =>
          rw [← NumberField.InfinitePlace.mk_embedding w, eq_comm, NumberField.InfinitePlace.mk_eq_iff,
            eq_comm (a := w.embedding), eq_comm (a := NumberField.ComplexEmbedding.conjugate w.embedding)]
      rw [hset]
      dsimp [pFactor]
      split_ifs with hw
      · have hconj : NumberField.ComplexEmbedding.conjugate w.embedding = w.embedding :=
          NumberField.ComplexEmbedding.isReal_iff.mp (NumberField.InfinitePlace.isReal_iff.mp hw)
        rw [hconj, Finset.pair_eq_singleton, Finset.prod_singleton]
        exact (NumberField.InfinitePlace.embedding_of_isReal_apply hw (π : K)).symm
      · have hne : w.embedding ≠ NumberField.ComplexEmbedding.conjugate w.embedding := by
          intro h
          exact hw (NumberField.InfinitePlace.isReal_iff.mpr (NumberField.ComplexEmbedding.isReal_iff.mpr h.symm))
        rw [Finset.prod_pair hne, NumberField.ComplexEmbedding.conjugate_coe_eq, Complex.mul_conj]
    have hprod_C : ((Algebra.norm ℤ π : ℝ) : ℂ) =
        ((∏ w : NumberField.InfinitePlace K, pFactor w : ℝ) : ℂ) := by
      have hloc := Algebra.norm_localization ℤ (nonZeroDivisors ℤ) π (Rₘ := ℚ) (Sₘ := K)
      have hemb := Algebra.norm_eq_prod_embeddings ℚ ℂ (π : K)
      have h1 : ((Algebra.norm ℤ π : ℝ) : ℂ) = algebraMap ℚ ℂ (Algebra.norm ℚ (π : K)) := by
        change ((Algebra.norm ℤ π : ℝ) : ℂ) =
          algebraMap ℚ ℂ (Algebra.norm ℚ (algebraMap (NumberField.RingOfIntegers K) K π))
        rw [hloc]
        simp
      let e : (K →ₐ[ℚ] ℂ) ≃ (K →+* ℂ) :=
        { toFun := AlgHom.toRingHom
          invFun := RingHom.toRatAlgHom
          left_inv := fun σ => by ext x; rfl
          right_inv := fun φ => by ext x; rfl }
      have halg_to_ring : (∏ σ : K →ₐ[ℚ] ℂ, σ (π : K)) = ∏ φ : K →+* ℂ, φ (π : K) :=
        Fintype.prod_equiv e (fun σ => σ (π : K)) (fun φ => φ (π : K)) (fun _ => rfl)
      have hfib_prod := (Finset.prod_fiberwise Finset.univ (fun φ : K →+* ℂ => NumberField.InfinitePlace.mk φ)
        (fun φ : K →+* ℂ => φ (π : K))).symm
      rw [h1, hemb, halg_to_ring]
      refine Eq.trans hfib_prod ?_
      push_cast
      exact Finset.prod_congr rfl (fun w _ => hfiber w)
    have hprod_R : (Algebra.norm ℤ π : ℝ) = ∏ w : NumberField.InfinitePlace K, pFactor w :=
      Complex.ofReal_injective hprod_C
    rw [← Finset.mul_prod_erase Finset.univ pFactor (Finset.mem_univ σ₁₂.1)] at hprod_R
    have h_at_σ : pFactor σ₁₂.1 < 0 := by
      dsimp [pFactor]
      rw [dif_pos σ₁₂.2]
      exact hπ_neg
    have h_rest : 0 < ∏ w ∈ Finset.univ.erase σ₁₂.1, pFactor w := by
      apply Finset.prod_pos
      intro w hw_mem
      have hw_ne : w ≠ σ₁₂.1 := (Finset.mem_erase.mp hw_mem).1
      dsimp [pFactor]
      split_ifs with hw
      · apply hπ_pos ⟨w, hw⟩
        intro h_eq
        exact hw_ne (congrArg Subtype.val h_eq)
      · refine Complex.normSq_pos.mpr ?_
        intro h0
        exact hπ0 ((RingHom.injective w.embedding) (h0.trans (map_zero w.embedding).symm))
    have hneg_R : (Algebra.norm ℤ π : ℝ) < 0 := by
      rw [hprod_R]
      exact mul_neg_of_neg_of_pos h_at_σ h_rest
    exact Int.cast_lt_zero.mp hneg_R
  refine ⟨π, hπ_prime, hπ_mod, hπ_neg, hπ_pos, ?_⟩
  rw [Ideal.absNorm_span_singleton]
  omega

theorem rootNumber_threeRootsCurve_mul_eq_of_sub_one_mem (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ π d₀ : NumberField.RingOfIntegers K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hπ_mod : π - 1 ∈ Ideal.span {4 * d₀})
    (hd₀ : d₀ ∈ v.asIdeal) :
    rootNumber ((threeRootsCurve ((π * a₁ : NumberField.RingOfIntegers K) : K)
        ((π * a₂ : NumberField.RingOfIntegers K) : K)
        ((π * a₃ : NumberField.RingOfIntegers K) : K)).baseChange (v.adicCompletion K)) =
      rootNumber ((threeRootsCurve (a₁ : K) (a₂ : K) (a₃ : K)).baseChange (v.adicCompletion K)) :=
by
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton.mp hπ_mod
  let z₀ : NumberField.RingOfIntegers K := d₀ * y
  let z : v.adicCompletion K := algebraMap K (v.adicCompletion K) (z₀ : K)
  have hπ_eq_int : π = 1 + 4 * z₀ := by
    change π = 1 + 4 * (d₀ * y)
    linear_combination hy
  have hπ_eq_K : (π : K) = 1 + 4 * (z₀ : K) := by
    have h := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hπ_eq_int
    push_cast at h
    exact h
  have hπ_eq_L : algebraMap K (v.adicCompletion K) (π : K) = 1 + 4 * z := by
    change algebraMap K (v.adicCompletion K) (π : K) = 1 + 4 * algebraMap K (v.adicCompletion K) (z₀ : K)
    rw [hπ_eq_K, map_add, map_one, map_mul, map_ofNat]
  have hz₀_mem : z₀ ∈ v.asIdeal ^ 1 := by
    rw [pow_one]
    exact Ideal.mul_mem_right y v.asIdeal hd₀
  have hz₀_intVal : v.intValuation z₀ ≤ WithZero.exp (-1 : ℤ) :=
    (v.intValuation_le_pow_iff_mem z₀ 1).mpr hz₀_mem
  have hz_val_eq : Valued.v z = v.intValuation z₀ := by
    change Valued.v (algebraMap K (v.adicCompletion K) (z₀ : K)) = v.intValuation z₀
    erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v (z₀ : K)]
    exact v.valuation_of_algebraMap z₀
  have hz_val : Valued.v z ≤ WithZero.exp (-1 : ℤ) := by
    rw [hz_val_eq]
    exact hz₀_intVal
