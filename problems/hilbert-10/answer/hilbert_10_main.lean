    · have h : (threeRootsCurve (e₁ : K) (e₂ : K) (e₃ : K)).a₆ =
          ((-(e₁ * e₂ * e₃) : NumberField.RingOfIntegers K) : K) := by simp [threeRootsCurve]
      rw [h]; exact hval_int v _
  have hE0_Δ : E0.Δ = (Δ₀ : K) := by
    rw [hΔ₀_coe]
    simp only [E0, threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈]
    ring
  have hE_Δ : E.Δ = (π : K) ^ 6 * (Δ₀ : K) := by
    rw [hΔ₀_coe]
    simp only [E, threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈]
    push_cast
    ring
  have hE_c₄ : E.c₄ = (π : K) ^ 2 * (c₄₀ : K) := by
    have hc₄₀_coe : (c₄₀ : K) =
        16 * (((a₁ : K) + (a₂ : K) + (a₃ : K)) ^ 2 -
          3 * ((a₁ : K) * (a₂ : K) + (a₁ : K) * (a₃ : K) + (a₂ : K) * (a₃ : K))) := by
      change ((16 * ((a₁ + a₂ + a₃) ^ 2 - 3 * (a₁ * a₂ + a₁ * a₃ + a₂ * a₃)) :
        NumberField.RingOfIntegers K) : K) = _
      push_cast
      rfl
    rw [hc₄₀_coe]
    simp only [E, threeRootsCurve, WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
    push_cast
    ring
  have hE_c₄_coe : E.c₄ = ((π ^ 2 * c₄₀ : NumberField.RingOfIntegers K) : K) := by
    rw [hE_c₄]
