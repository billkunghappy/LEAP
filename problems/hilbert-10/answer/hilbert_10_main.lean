    have hunion : (W₀ ∪ W₁) ∪ (W₂ ∪ W₃) = V := by
      ext c
      simp only [Set.mem_union, hW_char, hW₁_char, hW₂_char, hW₃_char]
      constructor
      · rintro ((⟨hV, _, _⟩ | ⟨hV, _, _⟩) | (⟨hV, _, _⟩ | ⟨hV, _, _⟩)) <;> exact hV
