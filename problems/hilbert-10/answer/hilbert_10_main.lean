              (algebraMap K (v₁.adicCompletion K) (π_u : K)) ^ 2 := by
              rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hπ_ne)]
          _ = ((s₁ * s₁) * (s₂ * s₂)) /
              (algebraMap K (v₁.adicCompletion K) (π_u : K)) ^ 2 := by
              rw [hrel_w, hs₁, hs₂]
          _ = ((s₁ * s₂) / algebraMap K (v₁.adicCompletion K) (π_u : K)) *
              ((s₁ * s₂) / algebraMap K (v₁.adicCompletion K) (π_u : K)) := by ring
      exact hd₃₄_nsq (((hloc_sq_mul d₃₄ (w.1 * w.2) hd₃₄_ev hw12_ev).mp hprod_sq).mpr hw12_sq)
    have hw_ram : RamLocal a₁ a₂ a₃ v₁ (algebraMap K (v₁.adicCompletion K) (π_u : K)) w.1 w.2 := by
      refine Or.inr (Or.inr (Or.inr ⟨?_, ?_⟩))
      · obtain ⟨s, hs⟩ := hsq1
        refine ⟨s, ?_⟩
        calc -(algebraMap K (v₁.adicCompletion K) (π_u : K) *
