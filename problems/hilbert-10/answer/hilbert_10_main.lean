      have h2 : (∑' v : S_empty, w v.1 s) = ∑' v, S_empty.indicator (fun q => w q s) v :=
        tsum_subtype S_empty (fun q => w q s)
      have h3 : (∑' v : D, w v.1 s) = ∑' v, D.indicator (fun q => w q s) v :=
        tsum_subtype D (fun q => w q s)
      calc (∑' v : S_C, w v.1 s)
        _ = ∑' v, S_C.indicator (fun q => w q s) v := h1
        _ ≤ ∑' v, (S_empty.indicator (fun q => w q s) v + D.indicator (fun q => w q s) v) :=
