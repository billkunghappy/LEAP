        ((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ (-s))
    have hw_le_one : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
