      obtain ⟨g_V, hg_V, hnLg_V1, _⟩ := hV_11.mpr hPE12
      have hg_V_flip : ∀ c ∈ V, L (g_V * c).1 ↔ ¬ L c.1 :=
        fun c _ => iff_not_of_not (hL_mul g_V.1 c.1) hnLg_V1
      have hV_card : V.encard = K₀.encard + K₀.encard :=
        h_two_coset K₀ V (fun c => L c.1) g_V hV_mul hg_V hK₀_V1 hg_V_flip
      have hW_E12 : ∀ c ∈ W, E c.1 ↔ E c.2 := by
        intro c hcW
        constructor
        · intro hEc1
          by_contra hnEc2
          exact hnPL1 (hW_01.mp ⟨c, hcW, hEc1, hnEc2⟩)
        · intro hEc2
          by_contra hnEc1
          exact hnPL2 (hW_10.mp ⟨c, hcW, hnEc1, hEc2⟩)
      have hK₀_W1 : ∀ c, c ∈ K₀ ↔ c ∈ W ∧ E c.1 := by
        intro c
        rw [hK₀_W c]
        exact ⟨fun h => ⟨h.1, h.2.1⟩, fun h => ⟨h.1, h.2, (hW_E12 c h.1).mp h.2⟩⟩
      obtain ⟨g_W, hg_W, hnEg_W1, _⟩ := hW_11.mpr hPL12
      have hg_W_flip : ∀ c ∈ W, E (g_W * c).1 ↔ ¬ E c.1 :=
        fun c _ => iff_not_of_not (hE_mul g_W.1 c.1) hnEg_W1
      have hW_card : W.encard = K₀.encard + K₀.encard :=
        h_two_coset K₀ W (fun c => E c.1) g_W hW_mul hg_W hK₀_W1 hg_W_flip
      exact ⟨m, by rw [hW_card, ← hV_card, hm]⟩
    · 
      have hK₀_eq_V : K₀ = V := by
        ext c
        rw [hK₀_V c]
        refine ⟨fun h => h.1, fun hcV => ⟨hcV, ?_, ?_⟩⟩
        · by_contra hnLc1
          by_cases hLc2 : L c.2
          · exact hPE2 (hV_10.mp ⟨c, hcV, hnLc1, hLc2⟩)
          · exact hPE12 (hV_11.mp ⟨c, hcV, hnLc1, hLc2⟩)
        · by_contra hnLc2
          by_cases hLc1 : L c.1
          · exact hPE1 (hV_01.mp ⟨c, hcV, hLc1, hnLc2⟩)
          · exact hPE12 (hV_11.mp ⟨c, hcV, hLc1, hnLc2⟩)
      by_cases hPL1 : PL1 <;> by_cases hPL2 : PL2
      · 
        obtain ⟨g₁, hg₁W, hnEg₁1, hEg₁2⟩ := hW_10.mpr hPL2
        obtain ⟨g₂, hg₂W, hEg₂1, hnEg₂2⟩ := hW_01.mpr hPL1
        have hW_card : W.encard = (K₀.encard + K₀.encard) + (K₀.encard + K₀.encard) :=
          h_four_coset K₀ W E g₁ g₂ hW_mul hE_mul hg₁W hg₂W hK₀_W hnEg₁1 hEg₂1 hnEg₂2
        rw [hK₀_eq_V, hm] at hW_card
        refine ⟨m + 1, ?_⟩
        rw [hW_card]
        have hpow : (4 ^ m + 4 ^ m) + (4 ^ m + 4 ^ m) = 4 ^ (m + 1) := by
          rw [pow_succ']
          omega
        exact_mod_cast hpow
      · exact False.elim (hPE1 (h_ruleB_L ⟨hPL1, hPL2⟩).2)
      · exact False.elim (hPE2 (h_ruleC_L ⟨hPL1, hPL2⟩).2)
      · by_cases hPL12 : PL12
        · exact False.elim (hPE12 (h_ruleD_L ⟨hPL1, hPL2, hPL12⟩))
        · 
          have hK₀_eq_W : K₀ = W := by
            ext c
            rw [hK₀_W c]
            refine ⟨fun h => h.1, fun hcW => ⟨hcW, ?_, ?_⟩⟩
            · by_contra hnEc1
              by_cases hEc2 : E c.2
              · exact hPL2 (hW_10.mp ⟨c, hcW, hnEc1, hEc2⟩)
              · exact hPL12 (hW_11.mp ⟨c, hcW, hnEc1, hEc2⟩)
            · by_contra hnEc2
              by_cases hEc1 : E c.1
              · exact hPL1 (hW_01.mp ⟨c, hcW, hEc1, hnEc2⟩)
              · exact hPL12 (hW_11.mp ⟨c, hcW, hEc1, hnEc2⟩)
          refine ⟨m, ?_⟩
          rw [← hK₀_eq_W, hK₀_eq_V, hm]

theorem exists_adjoined_auxiliary_prime_state (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₂ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₂_rk0 : IsRankZeroSelmerState K a₁ a₂ a₃ T S₂ π₂ κ₂)
    (hraw : IsRawAuxiliaryPrimeTuple K τ T S₂ p 𝔭)
    (hrec : IsAuxPrimeReciprocity K a₁ a₂ a₃ p 𝔭) :
    ∃ (S'₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π'₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ'₂ : Kˣ) (m : ℕ),
      IsAdjoinedAuxPrimeState K a₁ a₂ a₃ T S₂ S'₂ π₂ π'₂ κ'₂ p 𝔭 ∧
      (selmerStruct K a₁ a₂ a₃ T S'₂ π'₂).encard = 4 ^ m :=
by
  classical
  have hmul : IsLocalMulClosed K a₁ a₂ a₃ :=
    selmer_local_mul_closure K a₁ a₂ a₃ τ hstart
  have hcard_one : ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K),
      (selmerStruct K a₁ a₂ a₃ T S π).encard = 1 →
      ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c = 1 := by
    intro S π hcard c hc
    rw [Set.encard_eq_one] at hcard
    rcases hcard with ⟨x, hx⟩
    have h1_mem : (1 : SqCl K × SqCl K) ∈ selmerStruct K a₁ a₂ a₃ T S π := by
      refine ⟨(1, 1), ⟨?_, ?_, ?_, ?_⟩, rfl⟩
      · intro v _
        exact ⟨0, 1, 1, 1, by simp, by simp, by simp⟩
      · intro w
        exact ⟨0, 1, 1, 1, by simp, by simp, by simp⟩
      · intro v _
        exact Or.inl ⟨⟨1, by simp⟩, ⟨1, by simp⟩⟩
      · intro v _ _
        have hev1 : EvenVal v (1 : Kˣ) := ⟨0, by simp [EvenVal]⟩
        exact ⟨hev1, hev1⟩
    rw [hx] at hc h1_mem
    rw [Set.mem_singleton_iff] at hc h1_mem
    exact hc.trans h1_mem.symm
  have hdesc_outside : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ q : Kˣ × Kˣ,
        IsDescentClass
          (algebraMap K (v.adicCompletion K) a₁)
          (algebraMap K (v.adicCompletion K) a₂)
          (algebraMap K (v.adicCompletion K) a₃)
          (algebraMap K (v.adicCompletion K) (q.1 : K))
          (algebraMap K (v.adicCompletion K) (q.2 : K)) ↔
        EvenVal v q.1 ∧ EvenVal v q.2 := by
    rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _⟩
    intro v hvT q
    obtain ⟨h2, hdesc_even⟩ := local_descent_implies_evenVal K a₁ a₂ a₃ hint₁ hint₂ hint₃ T hT v hvT
    exact isDescentClass_iff_evenVal_of_notMem_T K a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ v h2
      (isSquare_one_add_of_valuation_lt_one K v h2)
      (exists_nonSquare_unit_mod_ideal K v h2)
      (exists_ringOfIntegers_sub_valuation_lt_one K v)
      hdesc_even q
  have hiso_all : ∀ k : Fin 6, ∃ ε_k : Kˣ,
      IsIsotropicAuxUnif K a₁ a₂ a₃ (𝔭 k) (p k) ε_k := by
    intro k
    let partner : Fin 6 → Fin 6 := fun i =>
      if h : i.1 % 2 = 0 then ⟨i.1 + 1, by have := i.2; omega⟩
      else ⟨i.1 - 1, by have := i.2; omega⟩
    have hk_ne : k ≠ partner k := by
      revert k; decide
    have hpart_pair :
        (k.1 = 0 ∧ (partner k).1 = 1) ∨ (k.1 = 1 ∧ (partner k).1 = 0) ∨
        (k.1 = 2 ∧ (partner k).1 = 3) ∨ (k.1 = 3 ∧ (partner k).1 = 2) ∨
        (k.1 = 4 ∧ (partner k).1 = 5) ∨ (k.1 = 5 ∧ (partner k).1 = 4) := by
      clear hk_ne; revert k; decide
    have h𝔭_ne : 𝔭 k ≠ 𝔭 (partner k) := hraw.1.ne hk_ne
    have hp_val_k : IsDedekindDomain.HeightOneSpectrum.valuation K (𝔭 k) (p k : K) =
        WithZero.exp (-1 : ℤ) := hraw.2.2.2.1 k
    have hp_val_part : IsDedekindDomain.HeightOneSpectrum.valuation K (𝔭 k) (p (partner k) : K) = 1 :=
      hraw.2.2.2.2.1 (partner k) (𝔭 k) h𝔭_ne
    have hnsq_part : ¬ IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (p (partner k) : K)) := by
      intro hsq
      exact (hrec.1 k (partner k) hk_ne).mp hsq hpart_pair
    rcases hrec.2 k with ⟨hsq_neg1, hsq_12, hsq_13, hsq_23⟩
    have hpiv_k : ∃ π_u : Kˣ, IsLocalPivotUnif K a₁ a₂ a₃ (𝔭 k) π_u :=
      local_v1_hilbLoc_and_ramLocal_laws K a₁ a₂ a₃ τ T (𝔭 k)
        hstart hT (hraw.2.1 k).1 (hdesc_outside (𝔭 k) (hraw.2.1 k).1)
    exact ⟨p (partner k), local_isotropic_aux_prime_laws K a₁ a₂ a₃ τ (𝔭 k) (p k) (p (partner k))
      hstart hp_val_k hp_val_part hnsq_part hsq_neg1 hsq_12 hsq_13 hsq_23 hpiv_k⟩
  obtain ⟨S'₂, π'₂, κ'₂, hadj, hcard_S₂, hiso_S'₂⟩ :=
    exists_adjoined_aux_prime_tuple_state K a₁ a₂ a₃ τ T S₂ π₂ κ₂ p 𝔭
      hstart hT hS₂_rk0 hraw hrec hcard_one hiso_all
  have h_ind : ∀ D : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      D ⊆ S'₂ →
      ∃ m : ℕ, (selmerStruct K a₁ a₂ a₃ T (S₂ ∪ D) π'₂).encard = 4 ^ m := by
    intro D
    induction D using Finset.induction with
    | empty =>
      intro _
      rw [Finset.union_empty]
      exact ⟨0, hcard_S₂⟩
    | @insert v₀ D₀ hv₀D₀ ih =>
      intro hsub
      have hD₀_sub : D₀ ⊆ S'₂ := Finset.Subset.trans (Finset.subset_insert v₀ D₀) hsub
      have hv₀_S'₂ : v₀ ∈ S'₂ := hsub (Finset.mem_insert_self v₀ D₀)
      obtain ⟨m, hm⟩ := ih hD₀_sub
      have hunion : S₂ ∪ insert v₀ D₀ = insert v₀ (S₂ ∪ D₀) := by
        ext v
        simp [or_left_comm]
      rw [hunion]
      by_cases hv₀S : v₀ ∈ S₂ ∪ D₀
      · rw [Finset.insert_eq_of_mem hv₀S]
        exact ⟨m, hm⟩
      · have hv₀S₂ : v₀ ∉ S₂ := fun h => hv₀S (Finset.mem_union_left D₀ h)
        obtain ⟨p₀, ε₀, hiso_v₀, hπ'₂_v₀⟩ := hiso_S'₂ v₀ hv₀_S'₂ hv₀S₂
        have hS_sub : S₂ ∪ D₀ ⊆ S'₂ := Finset.union_subset hadj.1 hD₀_sub
        have hST : Disjoint (S₂ ∪ D₀) T := Finset.disjoint_of_subset_left hS_sub hadj.2.2.2.1
        have hπ_S : ∀ v ∈ S₂ ∪ D₀, IsLocalUnif v (π'₂ v) :=
          fun v hv => hadj.2.2.2.2.2.1 v (hS_sub hv)
        have hv₀T : v₀ ∉ T := Finset.disjoint_left.mp hadj.2.2.2.1 hv₀_S'₂
        have hpr : ∀ r : Kˣ × Kˣ,
            (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T (S₂ ∪ D₀) π'₂ v₀ →
            hilbFin v₀ (-(a₁ - a₂) * (a₂ - a₃) * (r.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (r.1 : K)) = 1 :=
          poonen_rains_single_hilbert_eq_one K a₁ a₂ a₃ τ T (S₂ ∪ D₀) π'₂ v₀
            hstart hT hST hπ_S hv₀T hv₀S hdesc_outside
        have hpair : IsIsotropicLagrangianPair K
            (selmerStructRelax K a₁ a₂ a₃ T (S₂ ∪ D₀) π'₂ v₀)
            (selmerStruct K a₁ a₂ a₃ T (S₂ ∪ D₀) π'₂)
            (selmerStruct K a₁ a₂ a₃ T (insert v₀ (S₂ ∪ D₀)) π'₂) :=
          selmerStructRelax_isotropic_duality_laws K a₁ a₂ a₃ τ T (S₂ ∪ D₀) π'₂ v₀ p₀ ε₀
            hstart hT hmul hST hπ_S hv₀T hv₀S hiso_v₀ hπ'₂_v₀ hpr
        exact isotropic_lagrangian_encard_four_pow K
          (selmerStructRelax K a₁ a₂ a₃ T (S₂ ∪ D₀) π'₂ v₀)
          (selmerStruct K a₁ a₂ a₃ T (S₂ ∪ D₀) π'₂)
          (selmerStruct K a₁ a₂ a₃ T (insert v₀ (S₂ ∪ D₀)) π'₂)
          m hpair hm
  obtain ⟨m, hm⟩ := h_ind S'₂ (Finset.Subset.refl S'₂)
  rw [Finset.union_eq_right.mpr hadj.1] at hm
  exact ⟨S'₂, π'₂, κ'₂, m, hadj, hm⟩

theorem notInAuxSpan_of_mem_selmerStruct_aux (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₂ S'₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₂ π'₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₂ κ'₂ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₂ : IsCleanSelmerState K a₁ a₂ a₃ T S₂ π₂ κ₂)
    (hraw : IsRawAuxiliaryPrimeTuple K τ T S₂ p 𝔭)
    (hrec : IsAuxPrimeReciprocity K a₁ a₂ a₃ p 𝔭)
    (hadj : IsAdjoinedAuxPrimeState K a₁ a₂ a₃ T S₂ S'₂ π₂ π'₂ κ'₂ p 𝔭)
    (hmul : IsLocalMulClosed K a₁ a₂ a₃)
    (x₁ x₂ : Kˣ)
    (hx : (sqCl x₁, sqCl x₂) ∈ selmerStruct K a₁ a₂ a₃ T S'₂ π'₂)
    (hne : (sqCl x₁, sqCl x₂) ≠ 1) :
    NotInAuxSpan K p x₁ ∧ NotInAuxSpan K p x₂ ∧ NotInAuxSpan K p (x₁ * x₂) :=
by
  have h_even_one : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      EvenVal v 1 := by
    intro v
    dsimp [EvenVal]
    rw [map_one, toAdd_one]
    exact Even.zero
  have h_even_mul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), EvenVal v (x * y) ↔ (EvenVal v x ↔ EvenVal v y) := by
    intro v x y
    dsimp [EvenVal]
    rw [map_mul, toAdd_mul]
    exact Int.even_add
  have h_even_of_sq : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (z : Kˣ), IsSquare (algebraMap K (v.adicCompletion K) (z : K)) → EvenVal v z := by
    rintro v z ⟨r, hr⟩
    have hv_eq : ((v.valuationOfNeZero z : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        Valued.v r * Valued.v r := by
      calc ((v.valuationOfNeZero z : Multiplicative ℤ) : WithZero (Multiplicative ℤ))
        _ = (IsDedekindDomain.HeightOneSpectrum.valuation K v) (z : K) :=
            v.valuationOfNeZero_eq z
        _ = Valued.v (algebraMap K (v.adicCompletion K) (z : K)) :=
            (v.valuedAdicCompletion_eq_valuation' (z : K)).symm
        _ = Valued.v (r * r) := by rw [hr]
        _ = Valued.v r * Valued.v r := Valuation.map_mul _ r r
    have hvr_ne : Valued.v r ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hv_eq
      exact WithZero.coe_ne_zero hv_eq
    obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hvr_ne
    rw [← hg, ← WithZero.coe_mul] at hv_eq
    have hz_eq : v.valuationOfNeZero z = g * g := WithZero.coe_inj.mp hv_eq
    dsimp [EvenVal]
    rw [hz_eq, toAdd_mul]
    exact ⟨Multiplicative.toAdd g, rfl⟩
  have h_sqCl_eq_iff : ∀ x y : Kˣ, sqCl x = sqCl y ↔ ∃ s : Kˣ, y = x * s ^ 2 := by
    intro x y
    change (QuotientGroup.mk x : SqCl K) = QuotientGroup.mk y ↔ _
    rw [QuotientGroup.eq]
    constructor
    · rintro ⟨s, hs⟩
      refine ⟨s, ?_⟩
      have hs' : s ^ 2 = x⁻¹ * y := hs
      rw [hs', mul_inv_cancel_left]
    · rintro ⟨s, rfl⟩
      exact ⟨s, by simp [powMonoidHom_apply]⟩
  have h_sqCl_eq_one_iff : ∀ x : Kˣ, sqCl x = 1 ↔ IsSquare (x : K) := by
    intro x
    change (QuotientGroup.mk x : SqCl K) = 1 ↔ _
    rw [QuotientGroup.eq_one_iff]
    constructor
    · rintro ⟨s, hs⟩
      refine ⟨(s : K), ?_⟩
      have hs' : (s ^ 2 : Kˣ) = x := hs
      have hval := congrArg (fun u : Kˣ => (u : K)) hs'
      simpa [sq] using hval.symm
    · rintro ⟨r, hr⟩
      have hr0 : r ≠ 0 := by
        intro h0
        apply x.ne_zero
        rw [hr, h0, mul_zero]
      refine ⟨Units.mk0 r hr0, ?_⟩
      apply Units.ext
      simp [powMonoidHom_apply, sq, hr.symm]
  have h_sqCl_sq : ∀ x : Kˣ, sqCl (x ^ 2) = 1 := by
    intro x
    exact (h_sqCl_eq_one_iff (x ^ 2)).mpr ⟨(x : K), by simp [sq]⟩
  have h_sqCl_self : ∀ c : SqCl K, c * c = 1 := by
    intro c
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective c
    change sqCl (x * x) = 1
    rw [← sq]
    exact h_sqCl_sq x
  have h_sqCl_mul_eq_one_iff : ∀ x y : Kˣ, sqCl (x * y) = 1 ↔ sqCl x = sqCl y := by
    intro x y
    change sqCl x * sqCl y = 1 ↔ sqCl x = sqCl y
    constructor
    · intro h
      calc sqCl x = sqCl x * 1 := (mul_one (sqCl x)).symm
        _ = sqCl x * (sqCl y * sqCl y) := by rw [h_sqCl_self (sqCl y)]
        _ = (sqCl x * sqCl y) * sqCl y := (mul_assoc (sqCl x) (sqCl y) (sqCl y)).symm
        _ = 1 * sqCl y := by rw [h]
        _ = sqCl y := one_mul (sqCl y)
    · intro h
      rw [h]
      exact h_sqCl_self (sqCl y)
  have h_desc_sq : ∀ (w : NumberField.InfinitePlace K) (s₁ s₂ : Kˣ),
      IsDescentClass (algebraMap K w.Completion a₁) (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃) (algebraMap K w.Completion ((s₁ ^ 2 : Kˣ) : K))
        (algebraMap K w.Completion ((s₂ ^ 2 : Kˣ) : K)) := by
    intro w s₁ s₂
    let f := algebraMap K w.Completion
    refine ⟨0, f (s₂ : K), f (s₁ : K), 1, ?_, ?_, ?_⟩
    · rintro ⟨_, _, _, h1⟩
      exact one_ne_zero h1
    · simp only [Units.val_pow_eq_pow_val, map_pow]
      ring
    · simp only [Units.val_pow_eq_pow_val, map_pow]
      ring
  have h_desc_inf_of_sqCl_eq : ∀ (w : NumberField.InfinitePlace K) (q₁ q₂ y₁ y₂ : Kˣ),
      sqCl q₁ = sqCl y₁ → sqCl q₂ = sqCl y₂ →
      IsDescentClass (algebraMap K w.Completion a₁) (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃) (algebraMap K w.Completion (q₁ : K))
        (algebraMap K w.Completion (q₂ : K)) →
      IsDescentClass (algebraMap K w.Completion a₁) (algebraMap K w.Completion a₂)
