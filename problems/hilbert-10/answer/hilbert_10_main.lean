        calc e₁ * ι (q.1 : K) = s₁ * s₁ := hs₁
        _ = (s₁ * s₁ / ι (q.1 : K) ^ 2) * ι (q.1 : K) ^ 2 :=
          (div_mul_cancel₀ _ (pow_ne_zero 2 hq1_ne)).symm
        _ = ι (q.1 : K) * (s₁ / ι (q.1 : K)) ^ 2 * ι (q.1 : K) := by
          rw [div_pow, sq s₁]; ring
      have he₂_eq : e₂ = ι (q.2 : K) * (s₂ / ι (q.2 : K)) ^ 2 := by
        apply mul_right_cancel₀ hq2_ne
        calc e₂ * ι (q.2 : K) = s₂ * s₂ := hs₂
        _ = (s₂ * s₂ / ι (q.2 : K) ^ 2) * ι (q.2 : K) ^ 2 :=
          (div_mul_cancel₀ _ (pow_ne_zero 2 hq2_ne)).symm
        _ = ι (q.2 : K) * (s₂ / ι (q.2 : K)) ^ 2 * ι (q.2 : K) := by
          rw [div_pow, sq s₂]; ring
      have h1 : hilbLoc v₀ d₁ e₂ = hilbLoc v₀ d₁ (ι (q.2 : K)) := by
        rw [he₂_eq]
        exact (hhilb_sq d₁ (ι (q.2 : K)) (s₂ / ι (q.2 : K)) (div_ne_zero hs₂_ne hq2_ne)).1
      have h2' : hilbLoc v₀ d₂ e₁ = hilbLoc v₀ d₂ (ι (q.1 : K)) := by
        rw [he₁_eq]
        exact (hhilb_sq d₂ (ι (q.1 : K)) (s₁ / ι (q.1 : K)) (div_ne_zero hs₁_ne hq1_ne)).1
      rw [h1, h2']
      exact h_units_iff _ _ hpt
    rcases hp_cases with ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩ <;>
      rcases hq_cases with ⟨hq1, hq2⟩ | ⟨hq1, hq2⟩ | ⟨hq1, hq2⟩
    · 
      apply h_diag 1 ε (Valuation.map_one _) hε_val _ _ (Or.inr rfl)
      · apply h_sq_cancel _ u₁ hu₁_ne
        convert hp1.mul hq1 using 1
        dsimp [ι]; push_cast; ring
      · apply h_sq_cancel _ (c₁ π_a) hc₁a_ne
        convert hp2.mul hq2 using 1
        dsimp [c₁, ι]; push_cast; ring
    · 
      have hiff := h_pt_pair u₁ (c₁ π_a) (c₂ (ε * π_a)) u₂ hu₁_ne hc₁a_ne hc₂b_ne hu₂_ne hp1 hp2 hq1 hq2
      have h_oo : hilbLoc v₀ (c₁ π_a) (c₂ (ε * π_a)) = 1 := hiff.mp (hhilb_id a₁ a₂ a₃ h₁₂).1
      have hsq : IsSquare (-(c₁ π_a) * c₂ (ε * π_a)) := (hhilb_oo _ _ hc₁a hc₂b).mp h_oo
      apply hε_nonsq
      apply h_sq_cancel ε (c₁ π_a) hc₁a_ne
      convert hsq using 1
      dsimp [c₁, c₂]; ring
    · 
      have hiff := h_pt_pair u₁ (c₁ π_a) (c₃ (ε * π_a)) (c₄ (ε * π_a)) hu₁_ne hc₁a_ne hc₃b_ne hc₄b_ne hp1 hp2 hq1 hq2
      rw [(hhilb_uo u₁ (c₄ (ε * π_a)) hu₁_val hc₄b).1, hhilb_oo (c₁ π_a) (c₃ (ε * π_a)) hc₁a hc₃b] at hiff
      have h_eq : -(c₁ π_a) * c₃ (ε * π_a) = (ε * u₁) * π_a ^ 2 := by
        dsimp [c₁, c₃, u₁, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₁) * π_a ^ 2) ↔ IsSquare (ε * u₁) :=
        ⟨h_sq_cancel (ε * u₁) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₁ hu₁_val] at hiff
      exact not_iff_self hiff.symm
    · 
      have hiff := h_pt_pair (c₂ π_a) u₂ u₁ (c₁ (ε * π_a)) hc₂a_ne hu₂_ne hu₁_ne hc₁b_ne hp1 hp2 hq1 hq2
      have h_oo : hilbLoc v₀ (c₂ π_a) (c₁ (ε * π_a)) = 1 := hiff.mpr (hhilb_id a₁ a₂ a₃ h₁₂).2
      have hsq : IsSquare (-(c₂ π_a) * c₁ (ε * π_a)) := (hhilb_oo _ _ hc₂a hc₁b).mp h_oo
      apply hε_nonsq
      apply h_sq_cancel ε (c₁ π_a) hc₁a_ne
      convert hsq using 1
      dsimp [c₁, c₂]; ring
    · 
      apply h_diag ε 1 hε_val (Valuation.map_one _) _ _ (Or.inl rfl)
      · apply h_sq_cancel _ (c₂ π_a) hc₂a_ne
        convert hp1.mul hq1 using 1
        dsimp [c₂, ι]; push_cast; ring
      · apply h_sq_cancel _ u₂ hu₂_ne
        convert hp2.mul hq2 using 1
        dsimp [ι]; push_cast; ring
    · 
      have hiff := h_pt_pair (c₂ π_a) u₂ (c₃ (ε * π_a)) (c₄ (ε * π_a)) hc₂a_ne hu₂_ne hc₃b_ne hc₄b_ne hp1 hp2 hq1 hq2
      rw [hhilb_oo (c₂ π_a) (c₄ (ε * π_a)) hc₂a hc₄b, (hhilb_uo u₂ (c₃ (ε * π_a)) hu₂_val hc₃b).1] at hiff
      have h_eq : -(c₂ π_a) * c₄ (ε * π_a) = (ε * u₂) * π_a ^ 2 := by
        dsimp [c₂, c₄, u₂, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₂) * π_a ^ 2) ↔ IsSquare (ε * u₂) :=
        ⟨h_sq_cancel (ε * u₂) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₂ hu₂_val] at hiff
      exact not_iff_self hiff
    · 
      have hiff := h_pt_pair (c₃ π_a) (c₄ π_a) u₁ (c₁ (ε * π_a)) hc₃a_ne hc₄a_ne hu₁_ne hc₁b_ne hp1 hp2 hq1 hq2
      rw [hhilb_oo (c₃ π_a) (c₁ (ε * π_a)) hc₃a hc₁b, (hhilb_uo u₁ (c₄ π_a) hu₁_val hc₄a).2] at hiff
      have h_eq : -(c₃ π_a) * c₁ (ε * π_a) = (ε * u₁) * π_a ^ 2 := by
        dsimp [c₁, c₃, u₁, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₁) * π_a ^ 2) ↔ IsSquare (ε * u₁) :=
        ⟨h_sq_cancel (ε * u₁) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₁ hu₁_val] at hiff
      exact not_iff_self hiff
    · 
      have hiff := h_pt_pair (c₃ π_a) (c₄ π_a) (c₂ (ε * π_a)) u₂ hc₃a_ne hc₄a_ne hc₂b_ne hu₂_ne hp1 hp2 hq1 hq2
      rw [(hhilb_uo u₂ (c₃ π_a) hu₂_val hc₃a).2, hhilb_oo (c₄ π_a) (c₂ (ε * π_a)) hc₄a hc₂b] at hiff
      have h_eq : -(c₄ π_a) * c₂ (ε * π_a) = (ε * u₂) * π_a ^ 2 := by
        dsimp [c₂, c₄, u₂, ι]; push_cast; ring
      rw [h_eq] at hiff
      have hsq_iff : IsSquare ((ε * u₂) * π_a ^ 2) ↔ IsSquare (ε * u₂) :=
        ⟨h_sq_cancel (ε * u₂) π_a hπa_ne, fun h => h.mul ⟨π_a, by ring⟩⟩
      rw [hsq_iff, h_dich u₂ hu₂_val] at hiff
      exact not_iff_self hiff.symm
    · 
      apply h_diag ε ε hε_val hε_val _ _ (Or.inl rfl)
      · apply h_sq_cancel _ (c₃ π_a) hc₃a_ne
        convert hp1.mul hq1 using 1
        dsimp [c₃, ι]; push_cast; ring
      · apply h_sq_cancel _ (c₄ π_a) hc₄a_ne
        convert hp2.mul hq2 using 1
        dsimp [c₄, ι]; push_cast; ring
  obtain ⟨π₀, hπ₀_unif, hstep₀⟩ := h_step
  let S := insert v₀ S₄
  let π := Function.update π₄ v₀ π₀
  let κ : Kˣ := κ₄ * p_last
  refine ⟨S, π, κ, z, ?_, ?_, ?_, ?_, ?_,
    hsign0, hsign1, hsign2, hsign3, hsign4, hsign5, ?_, ?_, ?_, ?_, ?_⟩
  · exact Finset.disjoint_insert_left.mpr ⟨hv₀T, hS₄T⟩
  · intro v hv
    by_cases hvv₀ : v = v₀
    · subst v
      simpa [π] using hπ₀_unif
    · have hv' : v ∈ S₄ := Finset.mem_of_mem_insert_of_ne hv hvv₀
      simpa [π, Function.update_of_ne hvv₀] using hπ₄ v hv'
  · rw [Units.val_mul]
    exact hκ₄_int.mul hp_int
  · intro v hv
    rw [Units.val_mul, Valuation.map_mul]
    rcases eq_or_ne v v₀ with rfl | hvv₀
    · rw [hκ₄_notS₄ v₀ hv₀S₄, hp_val_v₀, one_mul]
    · have hv' : v ∈ S₄ := Finset.mem_of_mem_insert_of_ne hv hvv₀
      rw [hκ₄_S₄ v hv', hp_val_ne v hvv₀, mul_one]
  · intro v hv
    have hvv₀ : v ≠ v₀ := by rintro rfl; exact hv (Finset.mem_insert_self v₀ S₄)
    have hvS₄ : v ∉ S₄ := fun h => hv (Finset.mem_insert_of_mem h)
    rw [Units.val_mul, Valuation.map_mul, hκ₄_notS₄ v hvS₄, hp_val_ne v hvv₀, mul_one]
  · intro k
    rcases hz_sel₄ k with ⟨p_k, ⟨hpT, hpInf, hpRam, hpEven⟩, hp_eq⟩
    refine ⟨p_k, ⟨hpT, hpInf, ?_, ?_⟩, hp_eq⟩
    · intro v hv
      rcases eq_or_ne v v₀ with rfl | hvv₀
      · left
        refine ⟨h_sq_of_sqCl_eq (z k).1 p_k.1 (congrArg Prod.fst hp_eq).symm (hz_sq_v₀ k).1,
                h_sq_of_sqCl_eq (z k).2 p_k.2 (congrArg Prod.snd hp_eq).symm (hz_sq_v₀ k).2⟩
      · have hv' : v ∈ S₄ := Finset.mem_of_mem_insert_of_ne hv hvv₀
        simpa [π, Function.update_of_ne hvv₀] using hpRam v hv'
    · intro v hvT hvS
      exact hpEven v hvT (fun h => hvS (Finset.mem_insert_of_mem h))
  · intro k v hvT hvS
    exact hz_even₄ k v hvT (fun h => hvS (Finset.mem_insert_of_mem h))
  · rintro c ⟨p, ⟨hpT, hpInf, hpRam, hpEven⟩, rfl⟩
    have hp_relax : (sqCl p.1, sqCl p.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S₄ π₄ v₀ := by
      refine ⟨p, ⟨hpT, hpInf, ?_, ?_⟩, rfl⟩
      · intro v hvS₄
        have hne : v ≠ v₀ := by rintro rfl; exact hv₀S₄ hvS₄
        simpa [π, Function.update_of_ne hne] using hpRam v (Finset.mem_insert_of_mem hvS₄)
      · intro v hvT hvS₄ hne
        have hv_not_ins : v ∉ S := by
          intro hmem
          rcases Finset.mem_insert.mp hmem with rfl | hmem'
          · exact hne rfl
          · exact hvS₄ hmem'
        exact hpEven v hvT hv_not_ins
    have hp_ram₀ : RamLocal a₁ a₂ a₃ v₀ π₀ p.1 p.2 := by
      have h := hpRam v₀ (Finset.mem_insert_self v₀ S₄)
      simpa [π] using h
    have hp_sel₄ : (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S₄ π₄ :=
      hstep₀ p hp_relax hp_ram₀
    exact hspan₄ (sqCl p.1, sqCl p.2) hp_sel₄
  · intro k j hk
    exact ⟨(hz_even_sign k j hk).1, (hz_even_sign k j hk).2.1⟩
  · intro k j hk
    exact ⟨(hz_odd_sign k j hk).1, (hz_odd_sign k j hk).2.1⟩

theorem exists_auxiliary_twist_of_auxiliary_primes (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₃ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₃ : IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭) :
    ∃ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ : Kˣ) (z : Fin 6 → Kˣ × Kˣ),
      IsAuxiliaryTwist K a₁ a₂ a₃ τ T S π κ z :=
by
  have hmul := selmer_local_mul_closure K a₁ a₂ a₃ τ hstart
  obtain ⟨q, 𝔮, hq⟩ := exists_basis_primes K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭 hstart hT hS₃
  have hrec := reciprocity_of_basis_primes K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭 q 𝔮 hstart hT hS₃ hq
  obtain ⟨S₄, π₄, κ₄, z, hpre⟩ :=
    exists_pre_auxiliary_twist_of_basis_primes K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭 q 𝔮
      hstart hT hS₃ hmul hq hrec
  obtain ⟨p_last, 𝔭_last, hlast⟩ :=
    exists_final_sign_prime K a₁ a₂ a₃ τ T S₄ π₄ κ₄ z hstart hT hpre
  exact exists_auxiliary_twist_of_final_sign_prime K a₁ a₂ a₃ τ T S₄ π₄ κ₄ z p_last 𝔭_last
    hstart hT hmul hpre hlast

theorem exists_auxiliary_twist (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T) :
    ∃ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ : Kˣ) (z : Fin 6 → Kˣ × Kˣ),
      IsAuxiliaryTwist K a₁ a₂ a₃ τ T S π κ z :=
by
  obtain ⟨S₁, π₁, κ₁, hS₁⟩ := exists_selmer_rank_zero K a₁ a₂ a₃ τ T hstart hT
  obtain ⟨S₂, π₂, κ₂, hS₂⟩ :=
    exists_vanishing_auxiliary_spaces K a₁ a₂ a₃ τ T S₁ π₁ κ₁ hstart hT hS₁
  obtain ⟨S₃, π₃, κ₃, p, 𝔭, hS₃⟩ :=
    exists_killed_auxiliary_primes K a₁ a₂ a₃ τ T S₂ π₂ κ₂ hstart hT hS₂
  exact exists_auxiliary_twist_of_auxiliary_primes K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭 hstart hT hS₃

theorem exists_bad_avoidance_element (K : Type u) [Field K] [NumberField K]
    (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (bad : Set (SqCl K)) (hbad : bad.Finite) :
    ∃ m_bad : NumberField.RingOfIntegers K,
      m_bad ≠ 0 ∧
      (∀ v ∈ S, m_bad ∉ v.asIdeal) ∧
      (∀ b ∈ bad, ∃ u_b : Kˣ, sqCl u_b = b ∧
        ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          m_bad ∉ v.asIdeal → v ∉ S → EvenVal v u_b) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  have hu_ex : ∀ b : SqCl K, ∃ u : Kˣ, sqCl u = b := by
    intro b
    exact QuotientGroup.mk_surjective b
  let u_of : SqCl K → Kˣ := fun b => (hu_ex b).choose
  have hu_of : ∀ b : SqCl K, sqCl (u_of b) = b := fun b => (hu_ex b).choose_spec
  have hdiv_ex : ∀ b : SqCl K,
      ∃ (x : R), ∃ y ∈ nonZeroDivisors R,
        algebraMap R K x / algebraMap R K y = (u_of b : K) := by
    intro b
    exact IsFractionRing.div_surjective (A := R) (u_of b : K)
  let x_of : SqCl K → R := fun b => (hdiv_ex b).choose
  let y_of : SqCl K → R := fun b => (hdiv_ex b).choose_spec.choose
  have hy_mem : ∀ b : SqCl K, y_of b ∈ nonZeroDivisors R :=
    fun b => (hdiv_ex b).choose_spec.choose_spec.1
  have hxy_eq : ∀ b : SqCl K,
      algebraMap R K (x_of b) / algebraMap R K (y_of b) = (u_of b : K) :=
    fun b => (hdiv_ex b).choose_spec.choose_spec.2
  have hy_ne : ∀ b : SqCl K, y_of b ≠ 0 :=
    fun b => nonZeroDivisors.ne_zero (hy_mem b)
  have hx_ne : ∀ b : SqCl K, x_of b ≠ 0 := by
    intro b hx0
    have h0 : (u_of b : K) = 0 := by
      rw [← hxy_eq b, hx0, map_zero, zero_div]
    exact (u_of b).ne_zero h0
  let w_of : SqCl K → R := fun b => x_of b * y_of b
  have hw_ne : ∀ b : SqCl K, w_of b ≠ 0 :=
    fun b => mul_ne_zero (hx_ne b) (hy_ne b)
  let W_bad : R := ∏ b ∈ hbad.toFinset, w_of b
  have hW_ne : W_bad ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun b _ => hw_ne b
  have hW_even : ∀ b ∈ bad,
      ∀ v : IsDedekindDomain.HeightOneSpectrum R,
        W_bad ∉ v.asIdeal → EvenVal v (u_of b) := by
    intro b hb v hW_not_mem
    have hb_fin : b ∈ hbad.toFinset := (Set.Finite.mem_toFinset hbad).mpr hb
    have hdvd : w_of b ∣ W_bad := Finset.dvd_prod_of_mem w_of hb_fin
    rcases hdvd with ⟨q, hq⟩
    have hw_not_mem : w_of b ∉ v.asIdeal := by
      intro hw_mem
      apply hW_not_mem
      rw [hq]
      exact Ideal.mul_mem_right q v.asIdeal hw_mem
    have hx_not_mem : x_of b ∉ v.asIdeal := by
      intro hx_mem
      apply hw_not_mem
      exact Ideal.mul_mem_right (y_of b) v.asIdeal hx_mem
    have hy_not_mem : y_of b ∉ v.asIdeal := by
      intro hy_mem_v
      apply hw_not_mem
      exact Ideal.mul_mem_left v.asIdeal (x_of b) hy_mem_v
    have hx_val_int : v.intValuation (x_of b) = 1 :=
      v.intValuation_eq_one_iff.mpr hx_not_mem
    have hy_val_int : v.intValuation (y_of b) = 1 :=
      v.intValuation_eq_one_iff.mpr hy_not_mem
    have hx_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (algebraMap R K (x_of b)) = 1 := by
      rw [v.valuation_of_algebraMap (x_of b), hx_val_int]
    have hy_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (algebraMap R K (y_of b)) = 1 := by
      rw [v.valuation_of_algebraMap (y_of b), hy_val_int]
    have hu_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (u_of b : K) = 1 := by
      rw [← hxy_eq b, Valuation.map_div, hx_val, hy_val, div_one]
    have hu_val_ne_zero : v.valuationOfNeZero (u_of b) = 1 := by
      have h1 := v.valuationOfNeZero_eq (u_of b)
      rw [hu_val, ← WithZero.coe_one] at h1
      exact WithZero.coe_inj.mp h1
    dsimp [EvenVal]
    rw [hu_val_ne_zero, toAdd_one]
    exact Even.zero
  have hI_ne : Ideal.span ({W_bad} : Set R) ≠ 0 := by
    change Ideal.span ({W_bad} : Set R) ≠ ⊥
    exact Ideal.span_singleton_eq_bot.not.mpr hW_ne
  have hF₀ : {v : IsDedekindDomain.HeightOneSpectrum R |
      v.asIdeal ∣ Ideal.span ({W_bad} : Set R)}.Finite :=
    Ideal.finite_factors hI_ne
  let B : Finset (IsDedekindDomain.HeightOneSpectrum R) := hF₀.toFinset \ S
  have hB_not_mem_W : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      v ∉ S → v ∉ B → W_bad ∉ v.asIdeal := by
    intro v hv_not_S hv_not_B hW_mem
    apply hv_not_B
    rw [Finset.mem_sdiff]
    refine ⟨(Set.Finite.mem_toFinset hF₀).mpr ?_, hv_not_S⟩
    exact Ideal.dvd_span_singleton.mpr hW_mem
  rcases S.eq_empty_or_nonempty with hS_empty | ⟨v₀, hv₀⟩
  · refine ⟨W_bad, hW_ne, ?_, ?_⟩
    · intro v hv
      rw [hS_empty] at hv
      exact False.elim (Finset.notMem_empty v hv)
    · intro b hb
      refine ⟨u_of b, hu_of b, ?_⟩
      intro v hW_not_mem _
      exact hW_even b hb v hW_not_mem
  · have hcop_pair : ∀ w ∈ B, ∀ v ∈ S, IsCoprime w.asIdeal v.asIdeal := by
      intro w hw v hv
      have hw_not_S : w ∉ S := (Finset.mem_sdiff.mp hw).2
      have hwv_ne : w ≠ v := by
        rintro rfl
        exact hw_not_S hv
      have hideal_ne : w.asIdeal ≠ v.asIdeal :=
        fun h => hwv_ne (IsDedekindDomain.HeightOneSpectrum.ext h)
      exact @Ideal.isCoprime_of_isMaximal _ _ _ _ w.isMaximal v.isMaximal hideal_ne
    have hcop_prod : IsCoprime (∏ w ∈ B, w.asIdeal) (∏ v ∈ S, v.asIdeal) :=
      IsCoprime.prod_left fun w hw => IsCoprime.prod_right fun v hv => hcop_pair w hw v hv
    obtain ⟨m_bad, hm_bad_B, y, hy_S, hmy⟩ := Ideal.isCoprime_iff_exists.mp hcop_prod
    have hm_in_B : ∀ w ∈ B, m_bad ∈ w.asIdeal := by
      intro w hw
      have hle : (∏ w' ∈ B, w'.asIdeal) ≤ w.asIdeal :=
        Ideal.prod_le_inf.trans (Finset.inf_le hw)
      exact hle hm_bad_B
    have hm_not_in_S : ∀ v ∈ S, m_bad ∉ v.asIdeal := by
      intro v hv hm_mem
      have hle : (∏ v' ∈ S, v'.asIdeal) ≤ v.asIdeal :=
        Ideal.prod_le_inf.trans (Finset.inf_le hv)
      have hy_mem_v : y ∈ v.asIdeal := hle hy_S
      have h1_mem : (1 : R) ∈ v.asIdeal := by
        rw [← hmy]
        exact Ideal.add_mem v.asIdeal hm_mem hy_mem_v
      exact v.isPrime.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1_mem)
    have hm_ne : m_bad ≠ 0 := by
      intro hm0
      apply hm_not_in_S v₀ hv₀
      rw [hm0]
      exact Submodule.zero_mem v₀.asIdeal
    refine ⟨m_bad, hm_ne, hm_not_in_S, ?_⟩
    intro b hb
    refine ⟨u_of b, hu_of b, ?_⟩
    intro v hm_not_v hv_not_S
    have hv_not_B : v ∉ B := fun hv_B => hm_not_v (hm_in_B v hv_B)
    exact hW_even b hb v (hB_not_mem_W v hv_not_S hv_not_B)

theorem exists_local_unit_offset_at_prime (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (π_v : v.adicCompletion K)
    (κ_int : NumberField.RingOfIntegers K)
    (h2 : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    (hπ : IsLocalUnif v π_v)
    (hκ : v.intValuation κ_int = WithZero.exp (-1 : ℤ)) :
    ∃ l_v : NumberField.RingOfIntegers K,
      l_v ∉ v.asIdeal ∧
      ∀ u : NumberField.RingOfIntegers K, u - l_v ∈ v.asIdeal →
        ∃ y z : v.adicCompletion K,
          Valued.v z ≤ WithZero.exp (-1 : ℤ) ∧
          π_v * algebraMap K (v.adicCompletion K) ((κ_int : K) * (u : K)) = y ^ 2 * (1 + 4 * z) :=
by
  classical
  rcases hπ with ⟨n, ⟨k, hn⟩, hval_π⟩
  change Valued.v π_v = WithZero.exp n at hval_π
  let κ_v : v.adicCompletion K := algebraMap K (v.adicCompletion K) (κ_int : K)
  have hval_κ : Valued.v κ_v = WithZero.exp (-1 : ℤ) := by
    change Valued.v (algebraMap K (v.adicCompletion K) (κ_int : K)) = WithZero.exp (-1 : ℤ)
    erw [v.valuedAdicCompletion_eq_valuation' (κ_int : K)]
    change (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K κ_int) = WithZero.exp (-1 : ℤ)
    rw [v.valuation_of_algebraMap κ_int, hκ]
  have hκ_ne : κ_v ≠ 0 := by
    apply (Valuation.ne_zero_iff Valued.v).mp
    rw [hval_κ]
    exact WithZero.exp_ne_zero
  let η_v : v.adicCompletion K := π_v * κ_v ^ n
  have hval_η : Valued.v η_v = 1 := by
    change Valued.v (π_v * κ_v ^ n) = 1
    rw [Valuation.map_mul, hval_π, map_zpow₀ _ κ_v n, hval_κ]
    rw [← WithZero.exp_zsmul n (-1 : ℤ), ← WithZero.exp_add]
    have h_zero : n + n • (-1 : ℤ) = 0 := by
      simp
    rw [h_zero, WithZero.exp_zero]
  have hη_ne : η_v ≠ 0 := by
    apply (Valuation.ne_zero_iff Valued.v).mp
    rw [hval_η]
    exact one_ne_zero
  have hval_η_inv : Valued.v η_v⁻¹ = 1 := by
    rw [Valuation.map_inv, hval_η, inv_one]
  let u₀ : v.adicCompletion K := η_v⁻¹
  have hu₀ : Valued.v u₀ = 1 := hval_η_inv
  have h_nhds : {y : v.adicCompletion K | Valued.v (y - u₀) < (1 : WithZero (Multiplicative ℤ))} ∈ nhds u₀ := by
    rw [Valued.mem_nhds]
    exact ⟨1, fun y hy => hy⟩
  obtain ⟨x : K, hx_lt⟩ := DenseRange.mem_nhds UniformSpace.Completion.denseRange_coe h_nhds
  change Valued.v (algebraMap K (v.adicCompletion K) x - u₀) < 1 at hx_lt
  have hu₀_x_lt : Valued.v (u₀ - algebraMap K (v.adicCompletion K) x) < 1 := by
    rwa [Valuation.map_sub_swap]
  have hx_val_L : Valued.v (algebraMap K (v.adicCompletion K) x) = 1 := by
    have h1 : algebraMap K (v.adicCompletion K) x = u₀ + (algebraMap K (v.adicCompletion K) x - u₀) := by ring
    have hdist : Valued.v u₀ ≠ Valued.v (algebraMap K (v.adicCompletion K) x - u₀) := by
      rw [hu₀]
      exact ne_of_gt hx_lt
    rw [h1, Valuation.map_add_of_distinct_val _ hdist, hu₀, max_eq_left (le_of_lt hx_lt)]
  have hx_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v) x = 1 := by
    rw [← v.valuedAdicCompletion_eq_valuation' x]
    exact hx_val_L
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) x
  have hb0 : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
  have hb_val_ne : v.intValuation b ≠ 0 := v.intValuation_ne_zero' ⟨b, hb⟩
  have hab_val : v.intValuation a = v.intValuation b := by
    have hdiv : (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K a /
        algebraMap (NumberField.RingOfIntegers K) K b) = 1 := by
      rw [hab, hx_val]
    rw [Valuation.map_div, v.valuation_of_algebraMap, v.valuation_of_algebraMap] at hdiv
    exact (div_eq_one_iff_eq hb_val_ne).mp hdiv
  set m : ℕ := (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {b})).factors
  have hb_exp : v.intValuation b = WithZero.exp (-(m : ℤ)) := v.intValuation_if_neg hb0
  have ha_exp : v.intValuation a = WithZero.exp (-(m : ℤ)) := hab_val.trans hb_exp
  have ha_mem : a ∈ v.asIdeal ^ m := (v.intValuation_le_pow_iff_mem a m).mp (le_of_eq ha_exp)
  have hb_mem : b ∈ v.asIdeal ^ m := (v.intValuation_le_pow_iff_mem b m).mp (le_of_eq hb_exp)
  have hb_not_mem : b ∉ v.asIdeal ^ (m + 1) := by
    intro hmem
    have hle := (v.intValuation_le_pow_iff_mem b (m + 1)).mpr hmem
    rw [hb_exp, WithZero.exp_le_exp] at hle
    omega
  have hI_eq : Ideal.span {b} ⊔ v.asIdeal ^ (m + 1) = v.asIdeal ^ m := by
    set I : Ideal (NumberField.RingOfIntegers K) := Ideal.span {b} ⊔ v.asIdeal ^ (m + 1)
    have hI_le : I ≤ v.asIdeal ^ m :=
      sup_le ((Ideal.span_singleton_le_iff_mem (v.asIdeal ^ m)).mpr hb_mem)
        (Ideal.pow_le_pow_right (Nat.le_succ m))
    obtain ⟨J, hIJ⟩ := Ideal.dvd_iff_le.mpr hI_le
    obtain ⟨C, hIC⟩ := Ideal.dvd_iff_le.mpr (le_sup_right : v.asIdeal ^ (m + 1) ≤ I)
    have hvm_ne : (v.asIdeal ^ m : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := pow_ne_zero m v.ne_bot
    have hv_eq : v.asIdeal = J * C := by
      apply mul_left_cancel₀ hvm_ne
      calc v.asIdeal ^ m * v.asIdeal
        _ = v.asIdeal ^ (m + 1) := (pow_succ v.asIdeal m).symm
        _ = I * C := hIC
        _ = (v.asIdeal ^ m * J) * C := by rw [hIJ]
        _ = v.asIdeal ^ m * (J * C) := mul_assoc _ _ _
    have hvJ : v.asIdeal ≤ J := Ideal.dvd_iff_le.mp ⟨C, hv_eq⟩
    have hJ_top : J = ⊤ := by
      by_contra hJ
      have hvJ_eq : v.asIdeal = J := v.isMaximal.eq_of_le hJ hvJ
      have hI_m1 : I = v.asIdeal ^ (m + 1) := by
        rw [hIJ, ← hvJ_eq, ← pow_succ]
      have hb_in_I : b ∈ I := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton b))
      rw [hI_m1] at hb_in_I
      exact hb_not_mem hb_in_I
    rw [hIJ, hJ_top, Ideal.mul_top]
  have ha_in_sup : a ∈ Ideal.span {b} ⊔ v.asIdeal ^ (m + 1) := by
    rwa [hI_eq]
  obtain ⟨y₀, hy₀, rem, hrem, hyrem⟩ := Submodule.mem_sup.mp ha_in_sup
  obtain ⟨l_v, rfl⟩ := Ideal.mem_span_singleton.mp hy₀
  have harb_mem : a - l_v * b ∈ v.asIdeal ^ (m + 1) := by
    have h_eq : a - l_v * b = rem := by
      rw [← hyrem]
      ring
    rwa [h_eq]
  have harb_lt : v.intValuation (a - l_v * b) < v.intValuation b := by
    have hle := (v.intValuation_le_pow_iff_mem (a - l_v * b) (m + 1)).mpr harb_mem
    have hlt : WithZero.exp (-((m + 1 : ℕ) : ℤ)) < WithZero.exp (-(m : ℤ)) := by
      rw [WithZero.exp_lt_exp]
      omega
    rw [hb_exp]
    exact lt_of_le_of_lt hle hlt
  have hbK_ne : (algebraMap (NumberField.RingOfIntegers K) K b) ≠ 0 :=
    (map_ne_zero_iff (algebraMap (NumberField.RingOfIntegers K) K)
      (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hb0
  have hxr_eq : x - (l_v : K) =
      algebraMap (NumberField.RingOfIntegers K) K (a - l_v * b) /
      algebraMap (NumberField.RingOfIntegers K) K b := by
    change x - algebraMap (NumberField.RingOfIntegers K) K l_v = _
    rw [← hab, map_sub, map_mul, sub_div, mul_div_cancel_right₀ _ hbK_ne]
  have hxr_val_lt : (v.valuation K) (x - (l_v : K)) < 1 := by
    rw [hxr_eq, Valuation.map_div, v.valuation_of_algebraMap, v.valuation_of_algebraMap]
    have hb_pos : 0 < v.intValuation b := by
      rw [hb_exp]
      exact WithZero.exp_pos
    rw [div_lt_iff₀ hb_pos, one_mul]
    exact harb_lt
  have hxr_L_lt : Valued.v (algebraMap K (v.adicCompletion K) x - algebraMap K (v.adicCompletion K) (l_v : K)) < 1 := by
    rw [← map_sub]
    erw [v.valuedAdicCompletion_eq_valuation' (x - (l_v : K))]
    exact hxr_val_lt
  have hur_lt : Valued.v (u₀ - algebraMap K (v.adicCompletion K) (l_v : K)) < 1 := by
    have h_add : u₀ - algebraMap K (v.adicCompletion K) (l_v : K) =
        (u₀ - algebraMap K (v.adicCompletion K) x) +
        (algebraMap K (v.adicCompletion K) x - algebraMap K (v.adicCompletion K) (l_v : K)) := by ring
    rw [h_add]
    exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hu₀_x_lt hxr_L_lt)
  have hl_not_mem : l_v ∉ v.asIdeal := by
    intro hr_mem
    have hr_int_lt : v.intValuation l_v < 1 := (v.intValuation_lt_one_iff_mem l_v).mpr hr_mem
    have hr_K_lt : (v.valuation K) (l_v : K) < 1 := by
      change (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K l_v) < 1
      rwa [v.valuation_of_algebraMap]
    have hr_L_lt : Valued.v (algebraMap K (v.adicCompletion K) (l_v : K)) < 1 := by
      erw [v.valuedAdicCompletion_eq_valuation' (l_v : K)]
      exact hr_K_lt
    have hu₀_lt : Valued.v u₀ < 1 := by
      have h_u : u₀ = (u₀ - algebraMap K (v.adicCompletion K) (l_v : K)) +
          algebraMap K (v.adicCompletion K) (l_v : K) := by ring
      calc Valued.v u₀
        _ = Valued.v ((u₀ - algebraMap K (v.adicCompletion K) (l_v : K)) +
            algebraMap K (v.adicCompletion K) (l_v : K)) := by rw [← h_u]
        _ ≤ max (Valued.v (u₀ - algebraMap K (v.adicCompletion K) (l_v : K)))
            (Valued.v (algebraMap K (v.adicCompletion K) (l_v : K))) :=
            Valuation.map_add _ _ _
        _ < 1 := max_lt hur_lt hr_L_lt
    rw [hu₀] at hu₀_lt
    exact lt_irrefl 1 hu₀_lt
  have h_eta_l_lt : Valued.v (η_v * algebraMap K (v.adicCompletion K) (l_v : K) - 1) < 1 := by
    have h_eq : η_v * algebraMap K (v.adicCompletion K) (l_v : K) - 1 =
        -η_v * (u₀ - algebraMap K (v.adicCompletion K) (l_v : K)) := by
      calc η_v * algebraMap K (v.adicCompletion K) (l_v : K) - 1
        _ = η_v * algebraMap K (v.adicCompletion K) (l_v : K) - η_v * u₀ := by
            rw [mul_inv_cancel₀ hη_ne]
        _ = -η_v * (u₀ - algebraMap K (v.adicCompletion K) (l_v : K)) := by ring
    rw [h_eq, Valuation.map_mul, Valuation.map_neg, hval_η, one_mul]
    exact hur_lt
  have h4_not_mem : (4 : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
    intro h4
    have h4_eq : (4 : NumberField.RingOfIntegers K) = 2 * 2 := by norm_num
    rw [h4_eq] at h4
    rcases v.isPrime.mul_mem_iff_mem_or_mem.mp h4 with h2' | h2'
    · exact h2 h2'
    · exact h2 h2'
  have hval_4 : Valued.v (4 : v.adicCompletion K) = 1 := by
    have h4_cast : (4 : v.adicCompletion K) =
        algebraMap K (v.adicCompletion K) ((4 : NumberField.RingOfIntegers K) : K) := by
      have h4_K : ((4 : NumberField.RingOfIntegers K) : K) = 4 := by norm_cast
      rw [h4_K, map_ofNat]
    rw [h4_cast]
    erw [v.valuedAdicCompletion_eq_valuation' ((4 : NumberField.RingOfIntegers K) : K)]
    change (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K 4) = 1
    rw [v.valuation_of_algebraMap]
    exact v.intValuation_eq_one_iff.mpr h4_not_mem
  have h4_ne : (4 : v.adicCompletion K) ≠ 0 := by
    apply (Valuation.ne_zero_iff Valued.v).mp
    rw [hval_4]
    exact one_ne_zero
  refine ⟨l_v, hl_not_mem, ?_⟩
  intro u hu
  have hu_l_lt : Valued.v (algebraMap K (v.adicCompletion K) (u : K) -
      algebraMap K (v.adicCompletion K) (l_v : K)) < 1 := by
    have h_sub : algebraMap K (v.adicCompletion K) (u : K) -
        algebraMap K (v.adicCompletion K) (l_v : K) =
        algebraMap K (v.adicCompletion K) ((u - l_v : NumberField.RingOfIntegers K) : K) := by
      have h_coe : ((u - l_v : NumberField.RingOfIntegers K) : K) = (u : K) - (l_v : K) := by
        push_cast; rfl
      rw [h_coe, map_sub]
    rw [h_sub]
    erw [v.valuedAdicCompletion_eq_valuation' ((u - l_v : NumberField.RingOfIntegers K) : K)]
    change (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K (u - l_v)) < 1
    rw [v.valuation_of_algebraMap]
    exact (v.intValuation_lt_one_iff_mem (u - l_v)).mpr hu
  have h_eta_u_lt : Valued.v (η_v * algebraMap K (v.adicCompletion K) (u : K) - 1) < 1 := by
    have h_decomp : η_v * algebraMap K (v.adicCompletion K) (u : K) - 1 =
        η_v * (algebraMap K (v.adicCompletion K) (u : K) -
          algebraMap K (v.adicCompletion K) (l_v : K)) +
        (η_v * algebraMap K (v.adicCompletion K) (l_v : K) - 1) := by ring
    have h_prod_lt : Valued.v (η_v * (algebraMap K (v.adicCompletion K) (u : K) -
        algebraMap K (v.adicCompletion K) (l_v : K))) < 1 := by
      rw [Valuation.map_mul, hval_η, one_mul]
      exact hu_l_lt
    rw [h_decomp]
    exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt h_prod_lt h_eta_l_lt)
  have h_eta_u_le : Valued.v (η_v * algebraMap K (v.adicCompletion K) (u : K) - 1) ≤
      WithZero.exp (-1 : ℤ) := by
    set w := Valued.v (η_v * algebraMap K (v.adicCompletion K) (u : K) - 1)
    rcases eq_or_ne w 0 with hw0 | hw_ne
    · rw [hw0]
      exact zero_le'
    · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hw_ne
      rw [← hg] at h_eta_u_lt ⊢
      change WithZero.exp (Multiplicative.toAdd g) < WithZero.exp (0 : ℤ) at h_eta_u_lt
      change WithZero.exp (Multiplicative.toAdd g) ≤ WithZero.exp (-1 : ℤ)
      rw [WithZero.exp_lt_exp] at h_eta_u_lt
      rw [WithZero.exp_le_exp]
      omega
  let y : v.adicCompletion K := κ_v ^ (-k)
  let z : v.adicCompletion K := (η_v * algebraMap K (v.adicCompletion K) (u : K) - 1) / 4
  refine ⟨y, z, ?_, ?_⟩
  · dsimp [z]
    rw [Valuation.map_div, hval_4, div_one]
    exact h_eta_u_le
  · have h14z : 1 + 4 * z = η_v * algebraMap K (v.adicCompletion K) (u : K) := by
      dsimp [z]
      rw [mul_div_cancel₀ _ h4_ne]
      ring
    have hexp : -k + (-k + n) = (1 : ℤ) := by omega
    have hκ_pow : κ_v ^ (-k) * (κ_v ^ (-k) * κ_v ^ n) = κ_v := by
      rw [← zpow_add₀ hκ_ne (-k) n, ← zpow_add₀ hκ_ne (-k) (-k + n), hexp, zpow_one]
    rw [h14z]
    calc π_v * algebraMap K (v.adicCompletion K) ((κ_int : K) * (u : K))
      _ = π_v * (κ_v * algebraMap K (v.adicCompletion K) (u : K)) := by
          rw [map_mul]
      _ = π_v * ((κ_v ^ (-k) * (κ_v ^ (-k) * κ_v ^ n)) *
            algebraMap K (v.adicCompletion K) (u : K)) := by
          rw [hκ_pow]
      _ = (κ_v ^ (-k)) ^ 2 * ((π_v * κ_v ^ n) *
            algebraMap K (v.adicCompletion K) (u : K)) := by
          ring
      _ = y ^ 2 * (η_v * algebraMap K (v.adicCompletion K) (u : K)) := rfl

theorem exists_global_offset_of_local_targets (K : Type u) [Field K] [NumberField K]
    (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (m κ_int : NumberField.RingOfIntegers K)
    (hκ_ne : κ_int ≠ 0)
    (hκ_not_S : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∉ S → κ_int ∉ v.asIdeal)
    (hm_S : ∀ v ∈ S, m ∉ v.asIdeal)
    (l_loc : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) →
      NumberField.RingOfIntegers K)
    (hl_loc : ∀ v ∈ S, l_loc v ∉ v.asIdeal) :
    ∃ l : NumberField.RingOfIntegers K,
      l * κ_int - 1 ∈ Ideal.span {m ^ 2} ∧
      (∀ v ∈ S, l - l_loc v ∈ v.asIdeal) ∧
      (∀ v ∈ S, l ∉ v.asIdeal) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        m ^ 2 * κ_int ∈ v.asIdeal → l ∉ v.asIdeal) :=
by
  classical
  have hcop_m_κ : IsCoprime (Ideal.span {m ^ 2}) (Ideal.span {κ_int}) := by
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    obtain ⟨M, hM_max, h_le⟩ := Ideal.exists_le_maximal _ h_ne_top
    have hm2_M : m ^ 2 ∈ M :=
      (le_trans le_sup_left h_le) (Ideal.subset_span (Set.mem_singleton (m ^ 2)))
    have hκ_M : κ_int ∈ M :=
      (le_trans le_sup_right h_le) (Ideal.subset_span (Set.mem_singleton κ_int))
    have hM_ne_bot : M ≠ ⊥ := by
      intro hbot
      apply hκ_ne
      exact (Submodule.mem_bot _).mp (hbot ▸ hκ_M)
    let v_M : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
      ⟨M, hM_max.isPrime, hM_ne_bot⟩
    have hv_M_S : v_M ∈ S := by
      by_contra hv_not_S
      exact hκ_not_S v_M hv_not_S hκ_M
    have hm_M : m ∈ v_M.asIdeal := v_M.isPrime.mem_of_pow_mem 2 hm2_M
    exact hm_S v_M hv_M_S hm_M
  obtain ⟨a, ha, b, hb, hab⟩ := Ideal.isCoprime_iff_exists.mp hcop_m_κ
  obtain ⟨l_0, hb_eq⟩ := Ideal.mem_span_singleton.mp hb
  have hl_0 : l_0 * κ_int - 1 ∈ Ideal.span {m ^ 2} := by
    have h_eq : l_0 * κ_int - 1 = -a := by linear_combination hab - hb_eq
    rw [h_eq]
    exact Submodule.neg_mem (Ideal.span {m ^ 2}) ha
  have hl_S_ex : ∃ l_S : NumberField.RingOfIntegers K,
      ∀ v ∈ S, l_S - l_loc v ∈ v.asIdeal := by
    refine Finset.induction_on S ?_ ?_
    · exact ⟨0, fun v hv => False.elim (Finset.notMem_empty v hv)⟩
    · intro w s hw ih
      obtain ⟨l_s, hl_s⟩ := ih
      have hcop_w_s : IsCoprime w.asIdeal (∏ v ∈ s, v.asIdeal) := by
        refine IsCoprime.prod_right fun v hv => ?_
        have hne : w ≠ v := by
          rintro rfl
          exact hw hv
        have hne_id : w.asIdeal ≠ v.asIdeal :=
          (IsDedekindDomain.HeightOneSpectrum.ext_iff.not).mp hne
        haveI := w.isMaximal
        haveI := v.isMaximal
        exact Ideal.isCoprime_of_isMaximal hne_id
      obtain ⟨a_w, ha_w, b_w, hb_w, hab_w⟩ := Ideal.isCoprime_iff_exists.mp hcop_w_s
      refine ⟨l_loc w * b_w + l_s * a_w, ?_⟩
      intro v hv
      rcases Finset.mem_insert.mp hv with rfl | hv_s
      · have h_eq : (l_loc v * b_w + l_s * a_w) - l_loc v = (l_s - l_loc v) * a_w := by
          linear_combination l_loc v * hab_w
        rw [h_eq]
        exact Ideal.mul_mem_left v.asIdeal (l_s - l_loc v) ha_w
      · have hb_v : b_w ∈ v.asIdeal := by
          have h_le : (∏ u ∈ s, u.asIdeal) ≤ v.asIdeal :=
            le_trans Ideal.prod_le_inf (Finset.inf_le hv_s)
          exact h_le hb_w
        have h_eq : (l_loc w * b_w + l_s * a_w) - l_loc v =
            (l_s - l_loc v) + (l_loc w - l_s) * b_w := by
          linear_combination l_s * hab_w
        rw [h_eq]
        exact Ideal.add_mem v.asIdeal (hl_s v hv_s)
          (Ideal.mul_mem_left v.asIdeal (l_loc w - l_s) hb_v)
  obtain ⟨l_S, hl_S⟩ := hl_S_ex
  have hcop_m_S : IsCoprime (Ideal.span {m ^ 2}) (∏ v ∈ S, v.asIdeal) := by
    refine IsCoprime.prod_right fun v hv => ?_
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    have h_eq : v.asIdeal = Ideal.span {m ^ 2} ⊔ v.asIdeal :=
      v.isMaximal.eq_of_le h_ne_top le_sup_right
    have hm2_v : m ^ 2 ∈ v.asIdeal := by
      have h_le : Ideal.span {m ^ 2} ≤ v.asIdeal := h_eq.symm ▸ le_sup_left
      exact h_le (Ideal.subset_span (Set.mem_singleton (m ^ 2)))
    have hm_v : m ∈ v.asIdeal := v.isPrime.mem_of_pow_mem 2 hm2_v
    exact hm_S v hv hm_v
  obtain ⟨e₁, he₁, e₂, he₂, he₁₂⟩ := Ideal.isCoprime_iff_exists.mp hcop_m_S
  let l : NumberField.RingOfIntegers K := l_0 * e₂ + l_S * e₁
  have hl_mod : l * κ_int - 1 ∈ Ideal.span {m ^ 2} := by
    have h_eq : l * κ_int - 1 = (l_0 * κ_int - 1) + ((l_S - l_0) * κ_int) * e₁ := by
      dsimp [l]
      linear_combination l_0 * κ_int * he₁₂
    rw [h_eq]
    exact Ideal.add_mem (Ideal.span {m ^ 2}) hl_0
      (Ideal.mul_mem_left (Ideal.span {m ^ 2}) ((l_S - l_0) * κ_int) he₁)
  have hl_congr : ∀ v ∈ S, l - l_loc v ∈ v.asIdeal := by
    intro v hv
    have he₂_v : e₂ ∈ v.asIdeal := by
      have h_le : (∏ u ∈ S, u.asIdeal) ≤ v.asIdeal :=
        le_trans Ideal.prod_le_inf (Finset.inf_le hv)
      exact h_le he₂
    have h_eq : l - l_loc v = (l_S - l_loc v) + (l_0 - l_S) * e₂ := by
      dsimp [l]
      linear_combination l_S * he₁₂
    rw [h_eq]
    exact Ideal.add_mem v.asIdeal (hl_S v hv)
      (Ideal.mul_mem_left v.asIdeal (l_0 - l_S) he₂_v)
  have hl_not_S : ∀ v ∈ S, l ∉ v.asIdeal := by
    intro v hv hl_v
    have h_mem : l - (l - l_loc v) ∈ v.asIdeal :=
      Ideal.sub_mem v.asIdeal hl_v (hl_congr v hv)
    have h_eq : l - (l - l_loc v) = l_loc v := by ring
    rw [h_eq] at h_mem
    exact hl_loc v hv h_mem
  refine ⟨l, hl_mod, hl_congr, hl_not_S, ?_⟩
  intro v hmκ
  rcases v.isPrime.mul_mem_iff_mem_or_mem.mp hmκ with hm2_v | hκ_v
  · intro hl_v
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hl_mod
    have hlκ_v : l * κ_int - 1 ∈ v.asIdeal := by
      rw [hq]
      exact Ideal.mul_mem_right q v.asIdeal hm2_v
    have h_one : (l * κ_int) - (l * κ_int - 1) ∈ v.asIdeal :=
      Ideal.sub_mem v.asIdeal (Ideal.mul_mem_right κ_int v.asIdeal hl_v) hlκ_v
    have h_eq : (l * κ_int) - (l * κ_int - 1) = 1 := by ring
    rw [h_eq] at h_one
    exact v.isPrime.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h_one)
  · have hv_S : v ∈ S := by
      by_contra hv_not_S
      exact hκ_not_S v hv_not_S hκ_v
    exact hl_not_S v hv_S

theorem exists_twist_modulus_and_offset (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (haux : IsAuxiliaryTwist K a₁ a₂ a₃ τ T S π κ z)
    (bad : Set (SqCl K)) (hbad : bad.Finite) :
    ∃ a₁_int a₂_int a₃_int κ_int m l : NumberField.RingOfIntegers K,
      IsTwistModulusAndOffset a₁ a₂ a₃ T S π κ bad a₁_int a₂_int a₃_int κ_int m l :=
by
  rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, ha₁_int, ha₂_int, ha₃_int, _⟩
  rcases haux with ⟨hST, hπ_S, hκ_int_z, hκ_val_S, hκ_val_not_S, _⟩
  let a₁_int : NumberField.RingOfIntegers K := ⟨a₁, ha₁_int⟩
  let a₂_int : NumberField.RingOfIntegers K := ⟨a₂, ha₂_int⟩
  let a₃_int : NumberField.RingOfIntegers K := ⟨a₃, ha₃_int⟩
  let κ_int : NumberField.RingOfIntegers K := ⟨(κ : K), hκ_int_z⟩
  have ha₁_coe : (a₁_int : K) = a₁ := rfl
  have ha₂_coe : (a₂_int : K) = a₂ := rfl
  have ha₃_coe : (a₃_int : K) = a₃ := rfl
  have hκ_coe : (κ_int : K) = (κ : K) := rfl
  have hκ_ne : κ_int ≠ 0 := by
    intro h
    have h0 : (κ_int : K) = 0 := by rw [h]; rfl
    exact κ.ne_zero (hκ_coe ▸ h0)
  have hval_coe : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : NumberField.RingOfIntegers K),
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) (x : K) = v.intValuation x := by
    intro v x
    exact v.valuation_of_algebraMap x
  have hadic_coe : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : NumberField.RingOfIntegers K),
      Valued.v (algebraMap K (v.adicCompletion K) (x : K)) = v.intValuation x := by
    intro v x
    have h1 : Valued.v (algebraMap K (v.adicCompletion K) (x : K)) =
        (IsDedekindDomain.HeightOneSpectrum.valuation K v) (x : K) :=
      v.valuedAdicCompletion_eq_valuation' (x : K)
    rw [h1]
    exact v.valuation_of_algebraMap x
  have hmem_iff_val : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : NumberField.RingOfIntegers K),
      x ∈ v.asIdeal ↔ v.intValuation x ≤ WithZero.exp (-1 : ℤ) := by
    intro v x
    have h := (v.intValuation_le_pow_iff_mem x 1).symm
    simpa using h
  let D₀ : NumberField.RingOfIntegers K :=
    6 * (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int)
  have hD₀_coe : (D₀ : K) = 6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃) := by
    dsimp [D₀]
    push_cast
    rfl
  have hD₀_ne_K : (D₀ : K) ≠ 0 := by
    rw [hD₀_coe]
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) (sub_ne_zero.mpr h₁₂))
      (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)
  have hT_iff_D₀ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∈ T ↔ D₀ ∈ v.asIdeal := by
    intro v
    rw [hT v, ← hD₀_coe, hval_coe v D₀, ne_eq, v.intValuation_eq_one_iff, not_not]
  have hD₀_not_S : ∀ v ∈ S, D₀ ∉ v.asIdeal := by
    intro v hv
    rw [← hT_iff_D₀ v]
    exact Finset.disjoint_left.mp hST hv
  have h2_not_S : ∀ v ∈ S, (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
    intro v hv h2
    apply hD₀_not_S v hv
    have hD₀_eq : D₀ = 2 * (3 * (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int)) := by
      dsimp [D₀]; ring
    rw [hD₀_eq]
    exact Ideal.mul_mem_right _ v.asIdeal h2
  have hκ_int_S : ∀ v ∈ S, v.intValuation κ_int = WithZero.exp (-1 : ℤ) := by
    intro v hv
    rw [← hval_coe v κ_int, hκ_coe]
    exact hκ_val_S v hv
  have hκ_mem_S : ∀ v ∈ S, κ_int ∈ v.asIdeal := by
    intro v hv
    rw [hmem_iff_val v κ_int, hκ_int_S v hv]
  have hκ_not_S : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∉ S → κ_int ∉ v.asIdeal := by
    intro v hv
    rw [← v.intValuation_eq_one_iff, ← hval_coe v κ_int, hκ_coe]
    exact hκ_val_not_S v hv
  obtain ⟨m_bad, hm_bad_ne, hm_bad_S, hbad_rep⟩ := exists_bad_avoidance_element K S bad hbad
  let m : NumberField.RingOfIntegers K := 2 * D₀ * m_bad
  have hm_ne_K : (m : K) ≠ 0 := by
    have hm_coe : (m : K) = 2 * (D₀ : K) * (m_bad : K) := by dsimp [m]; push_cast; rfl
    rw [hm_coe]
    have hm_bad_ne_K : (m_bad : K) ≠ 0 := by
      intro h
      apply hm_bad_ne
      exact Subtype.ext h
    exact mul_ne_zero (mul_ne_zero two_ne_zero hD₀_ne_K) hm_bad_ne_K
  have hm_T : ∀ v ∈ T, m ∈ v.asIdeal := by
    intro v hv
    have hm_eq : m = D₀ * (2 * m_bad) := by dsimp [m]; ring
    rw [hm_eq]
    exact Ideal.mul_mem_right _ v.asIdeal ((hT_iff_D₀ v).mp hv)
  have hm_S : ∀ v ∈ S, m ∉ v.asIdeal := by
    intro v hv hm_mem
    have h1 : 2 * D₀ ∈ v.asIdeal ∨ m_bad ∈ v.asIdeal :=
      v.isPrime.mul_mem_iff_mem_or_mem.mp hm_mem
    rcases h1 with h2D₀ | hm_bad_mem
    · have h2 : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal ∨ D₀ ∈ v.asIdeal :=
        v.isPrime.mul_mem_iff_mem_or_mem.mp h2D₀
      rcases h2 with h2_mem | hD₀_mem
      · exact h2_not_S v hv h2_mem
      · exact hD₀_not_S v hv hD₀_mem
    · exact hm_bad_S v hv hm_bad_mem
  classical
  have hloc_ex : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∈ S → ∃ l_v : NumberField.RingOfIntegers K,
        l_v ∉ v.asIdeal ∧
        ∀ u : NumberField.RingOfIntegers K, u - l_v ∈ v.asIdeal →
          ∃ y z : v.adicCompletion K,
            Valued.v z ≤ WithZero.exp (-1 : ℤ) ∧
            π v * algebraMap K (v.adicCompletion K) ((κ_int : K) * (u : K)) = y ^ 2 * (1 + 4 * z) := by
    intro v hv
    exact exists_local_unit_offset_at_prime K v (π v) κ_int
      (h2_not_S v hv) (hπ_S v hv) (hκ_int_S v hv)
  let l_loc : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) →
      NumberField.RingOfIntegers K :=
    fun v => if hv : v ∈ S then (hloc_ex v hv).choose else 1
  have hl_loc_not_mem : ∀ v ∈ S, l_loc v ∉ v.asIdeal := by
    intro v hv
    dsimp [l_loc]
    rw [dif_pos hv]
    exact (hloc_ex v hv).choose_spec.1
  have hl_loc_prop : ∀ v (hv : v ∈ S) (u : NumberField.RingOfIntegers K),
      u - l_loc v ∈ v.asIdeal →
      ∃ y z : v.adicCompletion K,
        Valued.v z ≤ WithZero.exp (-1 : ℤ) ∧
        π v * algebraMap K (v.adicCompletion K) ((κ_int : K) * (u : K)) = y ^ 2 * (1 + 4 * z) := by
    intro v hv u hu
    have h_eq : l_loc v = (hloc_ex v hv).choose := dif_pos hv
    rw [h_eq] at hu
    exact (hloc_ex v hv).choose_spec.2 u hu
  obtain ⟨l, hl_mod, hl_congr, hl_S, hl_mu⟩ :=
    exists_global_offset_of_local_targets K S m κ_int hκ_ne hκ_not_S hm_S l_loc hl_loc_not_mem
  refine ⟨a₁_int, a₂_int, a₃_int, κ_int, m, l,
    ha₁_coe, ha₂_coe, ha₃_coe, hκ_coe, hm_ne_K, hl_mod, hm_T, ?_, hl_mu, ?_, ?_, ?_, ?_, ?_⟩
  · intro v hv
    exact ⟨hm_S v hv, hl_S v hv⟩
  · intro v hnot_mem
    constructor
    · intro h6
      apply hnot_mem
      have h_eq : m ^ 2 * κ_int =
          6 * ((a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int) *
            (4 * D₀ * m_bad ^ 2 * κ_int)) := by
        dsimp [m, D₀]; ring
      rw [h_eq]
      exact Ideal.mul_mem_right _ v.asIdeal h6
    · intro hdiff
      apply hnot_mem
      have h_eq : m ^ 2 * κ_int =
          ((a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int)) *
            (24 * D₀ * m_bad ^ 2 * κ_int) := by
        dsimp [m, D₀]; ring
      rw [h_eq]
      exact Ideal.mul_mem_right _ v.asIdeal hdiff
  · intro u hu v hv
    rcases Ideal.mem_span_singleton.mp hu with ⟨q, hq⟩
    let z_int : NumberField.RingOfIntegers K := D₀ * (D₀ * m_bad ^ 2 * q)
    have hu_eq : u = 1 + 4 * z_int := by
      have h1 : u - 1 = 4 * z_int := by
        calc u - 1 = m ^ 2 * q := hq
          _ = 4 * z_int := by dsimp [m, z_int]; ring
      linear_combination h1
    have hz_mem : z_int ∈ v.asIdeal :=
      Ideal.mul_mem_right _ v.asIdeal ((hT_iff_D₀ v).mp hv)
    have hz_val : Valued.v (algebraMap K (v.adicCompletion K) (z_int : K)) ≤
        WithZero.exp (-1 : ℤ) := by
      rw [hadic_coe v z_int]
      exact (hmem_iff_val v z_int).mp hz_mem
    have hu_adic : algebraMap K (v.adicCompletion K) (u : K) =
        1 + 4 * algebraMap K (v.adicCompletion K) (z_int : K) := by
      have hu_K : (u : K) = 1 + 4 * (z_int : K) := by
        rw [hu_eq]; push_cast; rfl
      rw [hu_K, map_add, map_one, map_mul, map_ofNat]
    rw [hu_adic]
    exact isSquare_one_add_four_mul_of_valuation_le K v
      (algebraMap K (v.adicCompletion K) (z_int : K)) hz_val
  · intro u hu v hv
    rcases Ideal.mem_span_singleton.mp hu with ⟨q, hq⟩
    let z_int : NumberField.RingOfIntegers K := κ_int * (D₀ ^ 2 * m_bad ^ 2 * q)
    have hu_eq : u = 1 + 4 * z_int := by
      have h1 : u - 1 = 4 * z_int := by
        calc u - 1 = (m ^ 2 * κ_int) * q := hq
          _ = 4 * z_int := by dsimp [m, z_int]; ring
      linear_combination h1
    have hz_mem : z_int ∈ v.asIdeal :=
      Ideal.mul_mem_right _ v.asIdeal (hκ_mem_S v hv)
    have hz_val : Valued.v (algebraMap K (v.adicCompletion K) (z_int : K)) ≤
        WithZero.exp (-1 : ℤ) := by
      rw [hadic_coe v z_int]
      exact (hmem_iff_val v z_int).mp hz_mem
    have hu_adic : algebraMap K (v.adicCompletion K) (u : K) =
        1 + 4 * algebraMap K (v.adicCompletion K) (z_int : K) := by
      have hu_K : (u : K) = 1 + 4 * (z_int : K) := by
        rw [hu_eq]; push_cast; rfl
      rw [hu_K, map_add, map_one, map_mul, map_ofNat]
    rw [hu_adic]
    exact isSquare_one_add_four_mul_of_valuation_le K v
      (algebraMap K (v.adicCompletion K) (z_int : K)) hz_val
  · intro u hu v hv
    rcases Ideal.mem_span_singleton.mp hu with ⟨q, hq⟩
    have hul_mem : u - l ∈ v.asIdeal := by
      have h_eq : u - l = κ_int * (m ^ 2 * q) := by
        calc u - l = (m ^ 2 * κ_int) * q := hq
          _ = κ_int * (m ^ 2 * q) := by ring
      rw [h_eq]
      exact Ideal.mul_mem_right _ v.asIdeal (hκ_mem_S v hv)
    have hu_loc_mem : u - l_loc v ∈ v.asIdeal := by
      have h_eq : u - l_loc v = (u - l) + (l - l_loc v) := by ring
      rw [h_eq]
      exact Ideal.add_mem v.asIdeal hul_mem (hl_congr v hv)
    obtain ⟨y, z_adic, hz_val, hfac⟩ := hl_loc_prop v hv u hu_loc_mem
    rw [← hκ_coe, hfac]
    have hsq1 : IsSquare (y ^ 2) := ⟨y, sq y⟩
    have hsq2 : IsSquare (1 + 4 * z_adic) :=
      isSquare_one_add_four_mul_of_valuation_le K v z_adic hz_val
    exact hsq1.mul hsq2
  · intro b hb
    obtain ⟨u_b, hu_b_eq, hu_b_val⟩ := hbad_rep b hb
    refine ⟨u_b, hu_b_eq, ?_⟩
    intro v hnot_mem
    have hm_bad_not_mem : m_bad ∉ v.asIdeal := by
      intro hm_bad_mem
      apply hnot_mem
      have h_eq : m ^ 2 * κ_int = m_bad * (4 * D₀ ^ 2 * m_bad * κ_int) := by
        dsimp [m]; ring
      rw [h_eq]
      exact Ideal.mul_mem_right _ v.asIdeal hm_bad_mem
    have hv_not_S : v ∉ S := by
      intro hv_S
      apply hnot_mem
      exact Ideal.mul_mem_left v.asIdeal (m ^ 2) (hκ_mem_S v hv_S)
    exact hu_b_val v hm_bad_not_mem hv_not_S

theorem suitForms_cokernel_and_local_solvable (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (a₁_int a₂_int a₃_int μ l : NumberField.RingOfIntegers K)
    (h₁₂ : a₁_int ≠ a₂_int) (h₁₃ : a₁_int ≠ a₃_int) (h₂₃ : a₂_int ≠ a₃_int)
    (hμ : μ ≠ 0)
    (hl : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      μ ∈ v.asIdeal → l ∉ v.asIdeal)
    (h6 : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      μ ∉ v.asIdeal → (6 : NumberField.RingOfIntegers K) ∉ v.asIdeal) :
    (∀ z : Fin (2 * Module.finrank ℚ K) → ℤ,
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 0) (suitC ω a₁_int a₂_int a₃_int μ 0) z =
        1 + μ * kaiCoordX ω z + a₁_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 1) (suitC ω a₁_int a₂_int a₃_int μ 1) z =
        1 + μ * kaiCoordX ω z + a₂_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 2) (suitC ω a₁_int a₂_int a₃_int μ 2) z =
        1 + μ * kaiCoordX ω z + a₃_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 3) (suitC ω a₁_int a₂_int a₃_int μ 3) z =
        μ * kaiCoordY ω z + l) ∧
    (∀ i j : Fin 4, i ≠ j →
      Finite (NumberField.RingOfIntegers K ⧸
        Submodule.map (homMap (suitC ω a₁_int a₂_int a₃_int μ i))
          (LinearMap.ker (homMap (suitC ω a₁_int a₂_int a₃_int μ j))))) ∧
    KaiLocalSolvable (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ) :=
by
  have fin_two_mul_sum (n : ℕ) (f : Fin (2 * n) → NumberField.RingOfIntegers K) :
      ∑ k : Fin (2 * n), f k =
        (∑ r : Fin n, f ⟨r.1, by omega⟩) + (∑ r : Fin n, f ⟨n + r.1, by omega⟩) := by
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun k : Fin (2 * n) => k.1 < n) f]
    congr 1
    · refine (Finset.sum_bij (fun (r : Fin n) _ => (⟨r.1, by omega⟩ : Fin (2 * n)))
        ?_ ?_ ?_ ?_).symm
      · intro r _; simp [r.2]
      · intro r₁ _ r₂ _ h
        ext
        exact Fin.mk.inj_iff.mp h
      · intro k hk
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hk
        exact ⟨⟨k.1, hk⟩, Finset.mem_univ _, rfl⟩
      · intro r _; rfl
    · refine (Finset.sum_bij (fun (r : Fin n) _ => (⟨n + r.1, by omega⟩ : Fin (2 * n)))
        ?_ ?_ ?_ ?_).symm
      · intro r _; simp
      · intro r₁ _ r₂ _ h
        ext
        have h' := Fin.mk.inj_iff.mp h
        omega
      · intro k hk
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, not_lt] at hk
        refine ⟨⟨k.1 - n, by omega⟩, Finset.mem_univ _, ?_⟩
        ext
        dsimp
        omega
      · intro r _; rfl
  have kaiLift_spec (X Y : NumberField.RingOfIntegers K) :
      kaiCoordX ω (kaiLift ω X Y) = X ∧ kaiCoordY ω (kaiLift ω X Y) = Y := by
    constructor
    · unfold kaiCoordX kaiLift
      have h1 : ∀ r : Fin (Module.finrank ℚ K),
          (if h : r.1 < Module.finrank ℚ K then ω.repr X ⟨r.1, h⟩
           else ω.repr Y ⟨r.1 - Module.finrank ℚ K, by omega⟩) • ω r =
          (ω.repr X r) • ω r := by
        intro r
        rw [dif_pos r.2]
      simp_rw [h1]
      exact ω.sum_repr X
    · unfold kaiCoordY kaiLift
      have h2 : ∀ r : Fin (Module.finrank ℚ K),
          (if h : Module.finrank ℚ K + r.1 < Module.finrank ℚ K
           then ω.repr X ⟨Module.finrank ℚ K + r.1, h⟩
           else ω.repr Y ⟨Module.finrank ℚ K + r.1 - Module.finrank ℚ K, by omega⟩) • ω r =
          (ω.repr Y r) • ω r := by
        intro r
        have hnot : ¬ (Module.finrank ℚ K + r.1 < Module.finrank ℚ K) := by omega
        rw [dif_neg hnot]
        congr 2
        ext
        dsimp
        omega
      simp_rw [h2]
      exact ω.sum_repr Y
  have homMap_suitC_eq (z : Fin (2 * Module.finrank ℚ K) → ℤ) :
      homMap (suitC ω a₁_int a₂_int a₃_int μ 0) z =
        μ * kaiCoordX ω z + a₁_int * μ ^ 2 * kaiCoordY ω z ∧
      homMap (suitC ω a₁_int a₂_int a₃_int μ 1) z =
        μ * kaiCoordX ω z + a₂_int * μ ^ 2 * kaiCoordY ω z ∧
      homMap (suitC ω a₁_int a₂_int a₃_int μ 2) z =
        μ * kaiCoordX ω z + a₃_int * μ ^ 2 * kaiCoordY ω z ∧
      homMap (suitC ω a₁_int a₂_int a₃_int μ 3) z =
        μ * kaiCoordY ω z := by
    have hX (c : NumberField.RingOfIntegers K) :
        (∑ r : Fin (Module.finrank ℚ K), z ⟨r.1, by omega⟩ • (c * ω r)) =
          c * kaiCoordX ω z := by
      unfold kaiCoordX
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [zsmul_eq_mul, zsmul_eq_mul]
      ring
    have hY (c : NumberField.RingOfIntegers K) :
        (∑ r : Fin (Module.finrank ℚ K),
          z ⟨Module.finrank ℚ K + r.1, by omega⟩ •
            (c * ω ⟨Module.finrank ℚ K + r.1 - Module.finrank ℚ K, by omega⟩)) =
          c * kaiCoordY ω z := by
      unfold kaiCoordY
