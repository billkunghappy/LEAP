      exact (by decide : (1 : Fin 2) ≠ 0) (hind e₁ e₂ 1 0 hsq').2.2.1
    obtain ⟨K₃, hFieldK₃, hCharK₃, hAlgKK₃, j₂₃, ω₃, σ₃, ι₃, hj₂₃, hω₃_sq, hσ₃_ω₃, hσ₃_j, h_desc₃⟩ :=
      h_s2 L K₂ σ₂ ι₂ (w₃ : K) hw₃_nsq y₃ hy₃
    letI : Field K₃ := hFieldK₃
    letI : CharZero K₃ := hCharK₃
    letI : Algebra K K₃ := hAlgKK₃
    have hw₄_nsq : ¬ IsSquare (algebraMap K K₃ (w₄ : K)) := by
      intro hsq
      obtain ⟨e₃, he₃⟩ := h_desc₃ (w₄ : K) hsq
      obtain ⟨e₂, he₂⟩ := h_desc₂ ((w₄ : K) * (w₃ : K) ^ (e₃ : ℕ)) he₃
      obtain ⟨e₁, he₁⟩ := h_desc₁ ((w₄ : K) * (w₃ : K) ^ (e₃ : ℕ) * (w₂ : K) ^ (e₂ : ℕ)) he₂
      have hsq' : IsSquare ((w₁ : K) ^ (e₁ : ℕ) * (w₂ : K) ^ (e₂ : ℕ) *
          (w₃ : K) ^ (e₃ : ℕ) * (w₄ : K) ^ (1 : Fin 2).1) := by
        rcases he₁ with ⟨r, hr⟩
        refine ⟨r, ?_⟩
        change (w₁ : K) ^ (e₁ : ℕ) * (w₂ : K) ^ (e₂ : ℕ) * (w₃ : K) ^ (e₃ : ℕ) * (w₄ : K) ^ 1 = r * r
        have hr' : (w₄ : K) * (w₃ : K) ^ (e₃ : ℕ) * (w₂ : K) ^ (e₂ : ℕ) * (w₁ : K) ^ (e₁ : ℕ) = r * r := hr
        linear_combination hr'
      exact (by decide : (1 : Fin 2) ≠ 0) (hind e₁ e₂ e₃ 1 hsq').2.2.2
    obtain ⟨K₄, hFieldK₄, _, hAlgKK₄, j₃₄, ω₄, σ₄, ι₄, hj₃₄, hω₄_sq, hσ₄_ω₄, hσ₄_j, _⟩ :=
      h_s2 L K₃ σ₃ ι₃ (w₄ : K) hw₄_nsq y₄ hy₄
    letI : Field K₄ := hFieldK₄
    letI : Algebra K K₄ := hAlgKK₄
    let r₁ : K₄ := j₃₄ (j₂₃ (j₁₂ ω₁))
    let r₂ : K₄ := j₃₄ (j₂₃ ω₂)
    let r₃ : K₄ := j₃₄ ω₃
    let r₄ : K₄ := ω₄
    have hr₁_sq : r₁ ^ 2 = algebraMap K K₄ (w₁ : K) := by
      dsimp [r₁]
      rw [← map_pow, ← map_pow, ← map_pow, hω₁_sq, hj₁₂, hj₂₃, hj₃₄]
    have hr₂_sq : r₂ ^ 2 = algebraMap K K₄ (w₂ : K) := by
      dsimp [r₂]
      rw [← map_pow, ← map_pow, hω₂_sq, hj₂₃, hj₃₄]
    have hr₃_sq : r₃ ^ 2 = algebraMap K K₄ (w₃ : K) := by
      dsimp [r₃]
      rw [← map_pow, hω₃_sq, hj₃₄]
    have hσ₄_r₁ : σ₄ r₁ = -r₁ := by
      dsimp [r₁]
      rw [hσ₄_j, hσ₃_j, hσ₂_j, hσ₁_ω₁, map_neg, map_neg, map_neg]
    have hσ₄_r₂ : σ₄ r₂ = -r₂ := by
      dsimp [r₂]
      rw [hσ₄_j, hσ₃_j, hσ₂_ω₂, map_neg, map_neg]
    have hσ₄_r₃ : σ₄ r₃ = -r₃ := by
      dsimp [r₃]
      rw [hσ₄_j, hσ₃_ω₃, map_neg]
    exact ⟨L, hFieldL, hNFL, hAlgKL, hGalKL,
      h_lift K₄ r₁ r₂ r₃ r₄ σ₄ ι₄ hr₁_sq hr₂_sq hr₃_sq hω₄_sq hσ₄_r₁ hσ₄_r₂ hσ₄_r₃ hσ₄_ω₄⟩
  obtain ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, α₁, α₂, α₃, α₄, σ₀,
    hα₁, hα₂, hα₃, hα₄, hσ₁, hσ₂, hσ₃, hσ₄⟩ := h_galois
  letI : Field L := hFieldL
  letI : NumberField L := hNFL
  letI : Algebra K L := hAlgKL
  letI : IsGalois K L := hGalKL
  let C : Set (L ≃ₐ[K] L) :=
    { g | g α₁ = -α₁ ∧ g α₂ = -α₂ ∧ g α₃ = -α₃ ∧ g α₄ = -α₄ }
  have hC_nonempty : C.Nonempty := ⟨σ₀, hσ₁, hσ₂, hσ₃, hσ₄⟩
  have h_conj_single : ∀ (α : L) (w : K), α ^ 2 = algebraMap K L w →
      ∀ (ρ τ : L ≃ₐ[K] L), ρ α = -α → (τ * ρ * τ⁻¹) α = -α := by
    intro α w hα ρ τ hρ
    have hsq : (τ⁻¹ α) ^ 2 = α ^ 2 := by
      calc (τ⁻¹ α) ^ 2 = τ⁻¹ (α ^ 2) := (map_pow (τ⁻¹ : L ≃ₐ[K] L) α 2).symm
        _ = τ⁻¹ (algebraMap K L w) := by rw [hα]
        _ = algebraMap K L w := (τ⁻¹ : L ≃ₐ[K] L).commutes w
        _ = α ^ 2 := hα.symm
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h_pos | h_neg
    · change τ (ρ (τ⁻¹ α)) = -α
      rw [h_pos, hρ, map_neg]
      have hτ : τ (τ⁻¹ α) = α := (AlgEquiv.apply_symm_apply τ α)
      rw [h_pos] at hτ
      rw [hτ]
    · change τ (ρ (τ⁻¹ α)) = -α
      rw [h_neg, map_neg, hρ, neg_neg]
      have hτ : τ (τ⁻¹ α) = α := (AlgEquiv.apply_symm_apply τ α)
      rw [h_neg, map_neg] at hτ
      exact neg_eq_iff_eq_neg.mp hτ
  have hC_conj : ∀ ρ ∈ C, ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C := by
    intro ρ ⟨hρ₁, hρ₂, hρ₃, hρ₄⟩ τ
    exact ⟨h_conj_single α₁ (w₁ : K) hα₁ ρ τ hρ₁,
           h_conj_single α₂ (w₂ : K) hα₂ ρ τ hρ₂,
           h_conj_single α₃ (w₃ : K) hα₃ ρ τ hρ₃,
           h_conj_single α₄ (w₄ : K) hα₄ ρ τ hρ₄⟩
  have hCheb_inf :
      { p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          ∃ g ∈ C, g ∈ FrobeniusClassAt K L p }.Infinite := by
    let S_C : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
