        hv₁x hv₁δ (Or.inr (Or.inl ⟨hker2, hx2, rfl⟩))
    · let δ : Kˣ := Units.mk0 ((a₁ - a₃) * (a₂ - a₃)) (mul_ne_zero h₁₃_sub h₂₃_sub)
      refine ⟨x, δ, hx, hβγ, ?_⟩
      intro v₁ hv₁T hv₁B hv₁S hv₁x hv₁δ
