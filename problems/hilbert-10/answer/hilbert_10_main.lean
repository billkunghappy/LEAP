  rcases selmerStruct_four_nonSquare_or_subset_kernel K a₁ a₂ a₃ T S π m hmul hπ hm with
    hpair | ⟨x, hx, hker⟩
  · exact Or.inl hpair
  · refine Or.inr ?_
    have h₁₂_sub : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr h₁₂
    have h₁₃_sub : a₁ - a₃ ≠ 0 := sub_ne_zero.mpr h₁₃
    have h₂₃_sub : a₂ - a₃ ≠ 0 := sub_ne_zero.mpr h₂₃
    rcases hker with ⟨hker1, hx1⟩ | ⟨hker2, hx2⟩ | ⟨hker3, hx3⟩
    · let δ : Kˣ := Units.mk0 ((a₁ - a₂) * (a₁ - a₃)) (mul_ne_zero h₁₂_sub h₁₃_sub)
