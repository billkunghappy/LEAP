  have hC_conj : ∀ ρ ∈ C, ∀ τ : L ≃ₐ[K] L, τ * ρ * τ⁻¹ ∈ C := by
    intro ρ ⟨hρ_p, hρ_a, hρ_b, hρ_c⟩ τ
    exact ⟨fun k => h_conj_pos (β k) (p k : K) (hβ k).1 ρ τ (hρ_p k),
