        { v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          (∃ g : L ≃ₐ[K] L, g ∈ FrobeniusClassAt K L v ∧ g (β k) = β k) ∧
          ¬ IsSquare (algebraMap K (v.adicCompletion K) (p k : K)) }).Finite :=
    Set.finite_iUnion (fun k => h_frob_local_pos (p k) (β k) (hβ k).1)
  have hfin_a := h_frob_local_neg a α_a hα_a
  have hfin_b := h_frob_local_neg b α_b hα_b
  have hfin_c := h_frob_local_neg c α_c hα_c
  let P : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    { v | (∀ k : Fin 6, IsSquare (algebraMap K (v.adicCompletion K) (p k : K))) ∧
          ¬ IsSquare (algebraMap K (v.adicCompletion K) (a : K)) ∧
          ¬ IsSquare (algebraMap K (v.adicCompletion K) (b : K)) ∧
          ¬ IsSquare (algebraMap K (v.adicCompletion K) (c : K)) }
  have hP : P.Infinite := by
    have h_diff_inf := (((hCheb_inf.diff hfin_p_union).diff hfin_a).diff hfin_b).diff hfin_c
    refine h_diff_inf.mono ?_
    intro v ⟨⟨⟨⟨⟨g, ⟨hgp, hga, hgb, hgc⟩, hgfrob⟩, hnp⟩, hna⟩, hnb⟩, hnc⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro k
      by_contra hnsq_k
      exact hnp (Set.mem_iUnion.mpr ⟨k, ⟨g, hgfrob, hgp k⟩, hnsq_k⟩)
    · exact fun hsq_a => hna ⟨⟨g, hgfrob, hga⟩, hsq_a⟩
    · exact fun hsq_b => hnb ⟨⟨g, hgfrob, hgb⟩, hsq_b⟩
    · exact fun hsq_c => hnc ⟨⟨g, hgfrob, hgc⟩, hsq_c⟩
  classical
  let R := NumberField.RingOfIntegers K
  let P' : Set (IsDedekindDomain.HeightOneSpectrum R) := (P \ (S : Set _)) \ (T : Set _)
  have hP' : P'.Infinite := (hP.diff S.finite_toSet).diff T.finite_toSet
  haveI : Infinite P' := hP'.to_subtype
  let I_nzd : IsDedekindDomain.HeightOneSpectrum R → nonZeroDivisors (Ideal R) :=
    fun v => ⟨v.asIdeal, mem_nonZeroDivisors_of_ne_zero v.ne_bot⟩
  let cl : IsDedekindDomain.HeightOneSpectrum R → ClassGroup R :=
    fun v => ClassGroup.mk0 (I_nzd v)
  obtain ⟨c_cl, hc_inf⟩ := Finite.exists_infinite_fiber (fun x : P' => cl x.1)
  let P'_c : Set (IsDedekindDomain.HeightOneSpectrum R) := { v | v ∈ P' ∧ cl v = c_cl }
  have hP'_c : P'_c.Infinite := by
    rw [← Set.infinite_coe_iff]
    let f : (fun x : P' => cl x.1) ⁻¹' {c_cl} → P'_c :=
      fun x => ⟨x.1.1, x.1.2, x.2⟩
    have hf : Function.Injective f := by
      intro x y hxy
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (Subtype.val : P'_c → _) hxy
    exact Infinite.of_injective f hf
  let h : ℕ := Fintype.card (ClassGroup R)
  have hh_pos : 0 < h := Fintype.card_pos
  obtain ⟨B, hB_sub, hB_card⟩ := Set.Infinite.exists_subset_card_eq hP'_c h
  have hB_pos : 0 < B.card := by rwa [hB_card]
  obtain ⟨v₀, hv₀B⟩ := Finset.card_pos.mp hB_pos
  let p_nzd : nonZeroDivisors (Ideal R) := ∏ w ∈ B, I_nzd w
  have h_mk0 : ClassGroup.mk0 p_nzd = 1 := by
    dsimp [p_nzd]
    rw [map_prod]
    have h_const : ∏ w ∈ B, ClassGroup.mk0 (I_nzd w) = ∏ _w ∈ B, c_cl :=
      Finset.prod_congr rfl (fun w hw => (hB_sub hw).2)
    rw [h_const, Finset.prod_const, hB_card, pow_card_eq_one]
  have h_prin_B : (p_nzd : Ideal R).IsPrincipal :=
    (ClassGroup.mk0_eq_one_iff p_nzd.2).mp h_mk0
  obtain ⟨π_B, hπ_B_span⟩ := h_prin_B.principal
  have hspan : Ideal.span ({π_B} : Set R) = ∏ w ∈ B, w.asIdeal := by
    have h1 : (p_nzd : Ideal R) = ∏ w ∈ B, w.asIdeal :=
      Submonoid.coe_finset_prod (nonZeroDivisors (Ideal R)) I_nzd B
    exact hπ_B_span.symm.trans h1
  have hprod_ne : (∏ w ∈ B, w.asIdeal : Ideal R) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun w _ => w.ne_bot)
  have hπ_B_ne : π_B ≠ 0 := by
    intro h0
    apply hprod_ne
    rw [← hspan, h0, Set.singleton_zero, Ideal.span_zero, ← Submodule.zero_eq_bot]
  have hπ_B_K_ne : (π_B : K) ≠ 0 :=
    (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hπ_B_ne
  let κ_B : Kˣ := Units.mk0 (π_B : K) hπ_B_K_ne
  have h_not_dvd : ∀ (v : IsDedekindDomain.HeightOneSpectrum R)
      (E : Finset (IsDedekindDomain.HeightOneSpectrum R)),
      v ∉ E → ¬ (v.asIdeal ∣ ∏ w ∈ E, w.asIdeal) := by
    intro v E hvE hdvd
    obtain ⟨w, hwE, hvw⟩ := (Prime.dvd_finset_prod_iff v.prime _).mp hdvd
    have hle : w.asIdeal ≤ v.asIdeal := Ideal.dvd_iff_le.mp hvw
    have heq : w.asIdeal = v.asIdeal := w.isMaximal.eq_of_le v.isPrime.ne_top hle
    have hwv : w = v := IsDedekindDomain.HeightOneSpectrum.ext heq
    exact hvE (hwv ▸ hwE)
  have hval_B_out : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      v ∉ B → IsDedekindDomain.HeightOneSpectrum.valuation K v (κ_B : K) = 1 := by
    intro v hvB
    change (v.valuation K) (algebraMap R K π_B) = 1
    rw [v.valuation_of_algebraMap]
    have hndvd : ¬ (v.asIdeal ∣ Ideal.span ({π_B} : Set R)) := by
      rw [hspan]
      exact h_not_dvd v B hvB
    have hnot_lt : ¬ (v.intValuation π_B < 1) :=
      fun hlt => hndvd ((v.intValuation_lt_one_iff_dvd π_B).mp hlt)
    exact le_antisymm (v.intValuation_le_one π_B) (not_lt.mp hnot_lt)
  have hval_B_in : ∀ v ∈ B,
      IsDedekindDomain.HeightOneSpectrum.valuation K v (κ_B : K) = WithZero.exp (-1 : ℤ) := by
    intro v hvB
    change (v.valuation K) (algebraMap R K π_B) = WithZero.exp (-1 : ℤ)
    rw [v.valuation_of_algebraMap]
    have h_erase : (∏ w ∈ B, w.asIdeal) = v.asIdeal * ∏ w ∈ B.erase v, w.asIdeal :=
      (Finset.mul_prod_erase B (fun w => w.asIdeal) hvB).symm
    have hdvd1 : v.asIdeal ^ 1 ∣ Ideal.span ({π_B} : Set R) := by
      rw [pow_one, hspan, h_erase]
      exact dvd_mul_right v.asIdeal _
    have hndvd2 : ¬ (v.asIdeal ^ 2 ∣ Ideal.span ({π_B} : Set R)) := by
      intro hdvd2
      rw [sq, hspan, h_erase, mul_dvd_mul_iff_left v.ne_bot] at hdvd2
      exact h_not_dvd v (B.erase v) (Finset.notMem_erase v B) hdvd2
    have hle1 : v.intValuation π_B ≤ WithZero.exp (-((1 : ℕ) : ℤ)) :=
      (v.intValuation_le_pow_iff_dvd π_B 1).mpr hdvd1
    have hnle2 : ¬ (v.intValuation π_B ≤ WithZero.exp (-((2 : ℕ) : ℤ))) :=
      fun hle2 => hndvd2 ((v.intValuation_le_pow_iff_dvd π_B 2).mp hle2)
    set k : ℕ := (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {π_B})).factors
    have hexp : v.intValuation π_B = WithZero.exp (-(k : ℤ)) := v.intValuation_if_neg hπ_B_ne
    rw [hexp] at hle1 hnle2 ⊢
    rw [WithZero.exp_le_exp] at hle1 hnle2
    have hk1 : (k : ℤ) = 1 := by omega
    rw [hk1]
  let S' := S ∪ B
  let κ' : Kˣ := κ * κ_B
  have hB_not_S : ∀ v ∈ B, v ∉ S := fun v hv => (hB_sub hv).1.1.2
  have hB_not_T : ∀ v ∈ B, v ∉ T := fun v hv => (hB_sub hv).1.2
  have hB_in_P : ∀ v ∈ B, v ∈ P := fun v hv => (hB_sub hv).1.1.1
  have hv₀_in_P : v₀ ∈ P := hB_in_P v₀ hv₀B
  refine ⟨S', κ', v₀, Finset.subset_union_left, ?_, ?_,
    Finset.mem_union_right S hv₀B, hB_not_S v₀ hv₀B, ?_,
    hv₀_in_P.2.1, hv₀_in_P.2.2.1, hv₀_in_P.2.2.2⟩
  · rw [Finset.disjoint_union_left]
    exact ⟨hdisj, Finset.disjoint_left.mpr hB_not_T⟩
  · refine ⟨?_, ?_, ?_⟩
    · change IsIntegral ℤ ((κ : K) * (π_B : K))
      exact hprin.1.mul (NumberField.RingOfIntegers.isIntegral_coe π_B)
    · intro v hvS'
      change (v.valuation K) ((κ : K) * (κ_B : K)) = WithZero.exp (-1 : ℤ)
      rw [Valuation.map_mul]
      rcases Finset.mem_union.mp hvS' with hvS | hvB
      · have hvnotB : v ∉ B := fun h => hB_not_S v h hvS
        rw [hprin.2.1 v hvS, hval_B_out v hvnotB, mul_one]
      · have hvnotS : v ∉ S := hB_not_S v hvB
        rw [hprin.2.2 v hvnotS, hval_B_in v hvB, one_mul]
    · intro v hvnotS'
      have hvnotS : v ∉ S := fun h => hvnotS' (Finset.mem_union_left B h)
      have hvnotB : v ∉ B := fun h => hvnotS' (Finset.mem_union_right S h)
      change (v.valuation K) ((κ : K) * (κ_B : K)) = 1
      rw [Valuation.map_mul, hprin.2.2 v hvnotS, hval_B_out v hvnotB, mul_one]
  · intro k v hvS' hvnotS
    rcases Finset.mem_union.mp hvS' with hvS | hvB
    · exact False.elim (hvnotS hvS)
    · exact (hB_in_P v hvB).1 k

theorem selmerStruct_aux_drop_step (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S'₂ S_kill S_pad : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π'₂ π_kill : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ_pad : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (n : ℕ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hmul : IsLocalMulClosed K a₁ a₂ a₃)
    (hspan : ∀ x₁ x₂ : Kˣ,
      (sqCl x₁, sqCl x₂) ∈ selmerStruct K a₁ a₂ a₃ T S'₂ π'₂ →
      (sqCl x₁, sqCl x₂) ≠ 1 →
      NotInAuxSpan K p x₁ ∧ NotInAuxSpan K p x₂ ∧ NotInAuxSpan K p (x₁ * x₂))
    (hext : HasPrincipalAuxSquareExtension K T p)
    (hstate : IsAuxDropLoopState K a₁ a₂ a₃ T S'₂ S_kill S_pad π'₂ π_kill κ_pad p 𝔭 (n + 1)) :
    ∃ (S'_kill S'_pad : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π'_kill : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ'_pad : Kˣ),
      IsAuxDropLoopState K a₁ a₂ a₃ T S'₂ S'_kill S'_pad π'₂ π'_kill κ'_pad p 𝔭 n :=
by
  rcases hstate with ⟨hS'₂_kill, hkill_pad, hdisj_pad, hprin_pad, hsq_pad,
    hπ_eq, hπ_unif, hsel_sub, hcard⟩
  have hST : Disjoint S_kill T := hdisj_pad.mono_left hkill_pad
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  have hint₁ : IsIntegral ℤ a₁ := hstart.2.2.2.2.2.2.1
  have hint₂ : IsIntegral ℤ a₂ := hstart.2.2.2.2.2.2.2.1
  have hint₃ : IsIntegral ℤ a₃ := hstart.2.2.2.2.2.2.2.2.1
  classical
  letI : CommGroup (SqCl K) := QuotientGroup.Quotient.commGroup _
  letI : CommGroup (SqCl K × SqCl K) := Prod.instCommGroup
  have hsqCl_mul : ∀ x y : Kˣ, sqCl (x * y) = sqCl x * sqCl y := fun _ _ => rfl
  have hsqCl_self : ∀ c : SqCl K, c * c = 1 := by
    intro c
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective c
    change sqCl (x * x) = 1
    exact (QuotientGroup.eq_one_iff (x * x)).mpr ⟨x, sq x⟩
  have hprod_self : ∀ g : SqCl K × SqCl K, g * g = 1 := by
    rintro ⟨c₁, c₂⟩
    exact Prod.ext (hsqCl_self c₁) (hsqCl_self c₂)
  have heven_mul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), EvenVal v x → EvenVal v y → EvenVal v (x * y) := by
    intro v x y ⟨kx, hkx⟩ ⟨ky, hky⟩
    dsimp [EvenVal]
    rw [map_mul, toAdd_mul, hkx, hky]
    exact ⟨kx + ky, by omega⟩
  let PreV : Set (Kˣ × Kˣ) :=
    { r : Kˣ × Kˣ |
      (∀ v ∈ T, IsDescentClass
            (algebraMap K (v.adicCompletion K) a₁)
            (algebraMap K (v.adicCompletion K) a₂)
            (algebraMap K (v.adicCompletion K) a₃)
            (algebraMap K (v.adicCompletion K) (r.1 : K))
            (algebraMap K (v.adicCompletion K) (r.2 : K))) ∧
      (∀ w : NumberField.InfinitePlace K, IsDescentClass
            (algebraMap K w.Completion a₁)
            (algebraMap K w.Completion a₂)
            (algebraMap K w.Completion a₃)
            (algebraMap K w.Completion (r.1 : K))
            (algebraMap K w.Completion (r.2 : K))) ∧
      (∀ v ∈ S_kill, RamLocal a₁ a₂ a₃ v (π_kill v) r.1 r.2) ∧
      (∀ v, v ∉ T → v ∉ S_kill → EvenVal v r.1 ∧ EvenVal v r.2) }
  have hPreV_mul : ∀ r₁ r₂ : Kˣ × Kˣ, r₁ ∈ PreV → r₂ ∈ PreV →
      (r₁.1 * r₂.1, r₁.2 * r₂.2) ∈ PreV := by
    rintro r₁ r₂ ⟨h1₁, h2₁, h3₁, h4₁⟩ ⟨h1₂, h2₂, h3₂, h4₂⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro v hv
      exact hmul.1 v r₁.1 r₁.2 r₂.1 r₂.2 (h1₁ v hv) (h1₂ v hv)
    · intro w
      exact hmul.2.1 w r₁.1 r₁.2 r₂.1 r₂.2 (h2₁ w) (h2₂ w)
    · intro v hv
      exact hmul.2.2 v (π_kill v) r₁.1 r₁.2 r₂.1 r₂.2 (hπ_unif v hv) (h3₁ v hv) (h3₂ v hv)
    · intro v hvT hvS
      exact ⟨heven_mul v r₁.1 r₂.1 (h4₁ v hvT hvS).1 (h4₂ v hvT hvS).1,
             heven_mul v r₁.2 r₂.2 (h4₁ v hvT hvS).2 (h4₂ v hvT hvS).2⟩
  set V : Set (SqCl K × SqCl K) := selmerStruct K a₁ a₂ a₃ T S_kill π_kill
  have hV_mul : ∀ c₁ c₂ : SqCl K × SqCl K, c₁ ∈ V → c₂ ∈ V → c₁ * c₂ ∈ V := by
    rintro c₁ c₂ ⟨r₁, hr₁, rfl⟩ ⟨r₂, hr₂, rfl⟩
    exact ⟨(r₁.1 * r₂.1, r₁.2 * r₂.2), hPreV_mul r₁ r₂ hr₁ hr₂, rfl⟩
  have hV_avoid_two : ∀ a b : SqCl K × SqCl K, ∃ c ∈ V, c ≠ a ∧ c ≠ b := by
    intro a b
    by_contra h_not
    have hsub : V ⊆ ({a} : Set (SqCl K × SqCl K)) ∪ {b} := by
      intro c hcV
      by_contra hc_not
      simp only [Set.mem_union, Set.mem_singleton_iff, not_or] at hc_not
      exact h_not ⟨c, hcV, hc_not.1, hc_not.2⟩
    have hle2 : V.encard ≤ 2 := by
      calc V.encard
        _ ≤ (({a} : Set (SqCl K × SqCl K)) ∪ {b}).encard := Set.encard_le_encard hsub
        _ ≤ ({a} : Set (SqCl K × SqCl K)).encard + ({b} : Set (SqCl K × SqCl K)).encard :=
            Set.encard_union_le {a} {b}
        _ = 1 + 1 := by rw [Set.encard_singleton, Set.encard_singleton]
        _ = 2 := rfl
    have hle2' : ((4 ^ (n + 1) : ℕ) : ℕ∞) ≤ ((2 : ℕ) : ℕ∞) := by
      have hcoe : (4 : ℕ∞) ^ (n + 1) = ((4 ^ (n + 1) : ℕ) : ℕ∞) := by norm_cast
      rw [← hcoe, ← hcard]
      exact hle2
    have hle2_nat : 4 ^ (n + 1) ≤ 2 := by exact_mod_cast hle2'
    have h1_le : 1 ≤ 4 ^ n := Nat.one_le_pow n 4 (by omega)
    have hpow : 4 ^ (n + 1) = 4 ^ n * 4 := pow_succ 4 n
    omega
  obtain ⟨c₁, hc₁V, hc₁_ne1, _⟩ := hV_avoid_two 1 1
  obtain ⟨c₂, hc₂V, hc₂_ne1, hc₂_ne_c₁⟩ := hV_avoid_two 1 c₁
  obtain ⟨p', hp'_mem, hp'_eq⟩ := hc₁V
  obtain ⟨q', hq'_mem, hq'_eq⟩ := hc₂V
  change (sqCl p'.1, sqCl p'.2) = c₁ at hp'_eq
  change (sqCl q'.1, sqCl q'.2) = c₂ at hq'_eq
  have hp'_V : (sqCl p'.1, sqCl p'.2) ∈ V := ⟨p', hp'_mem, rfl⟩
  have hq'_V : (sqCl q'.1, sqCl q'.2) ∈ V := ⟨q', hq'_mem, rfl⟩
  have hpq'_mem : (p'.1 * q'.1, p'.2 * q'.2) ∈ PreV := hPreV_mul p' q' hp'_mem hq'_mem
  have hpq'_V : (sqCl (p'.1 * q'.1), sqCl (p'.2 * q'.2)) ∈ V :=
    ⟨(p'.1 * q'.1, p'.2 * q'.2), hpq'_mem, rfl⟩
  have hp'_ne1 : (sqCl p'.1, sqCl p'.2) ≠ 1 := by rw [hp'_eq]; exact hc₁_ne1
  have hq'_ne1 : (sqCl q'.1, sqCl q'.2) ≠ 1 := by rw [hq'_eq]; exact hc₂_ne1
  have hpq'_ne1 : (sqCl (p'.1 * q'.1), sqCl (p'.2 * q'.2)) ≠ 1 := by
    intro h1
    have hmul_eq : c₁ * c₂ = 1 := by
      rw [← hp'_eq, ← hq'_eq]
      exact h1
    apply hc₂_ne_c₁
    calc c₂ = 1 * c₂ := (one_mul c₂).symm
      _ = (c₁ * c₁) * c₂ := by rw [hprod_self c₁]
      _ = c₁ * (c₁ * c₂) := mul_assoc c₁ c₁ c₂
      _ = c₁ * 1 := by rw [hmul_eq]
      _ = c₁ := mul_one c₁
  obtain ⟨hp'₁_span, _, hp'₁₂_span⟩ := hspan p'.1 p'.2 (hsel_sub hp'_V) hp'_ne1
  obtain ⟨_, hq'₂_span, _⟩ := hspan q'.1 q'.2 (hsel_sub hq'_V) hq'_ne1
  obtain ⟨_, hpq'₂_span, _⟩ :=
    hspan (p'.1 * q'.1) (p'.2 * q'.2) (hsel_sub hpq'_V) hpq'_ne1
  have habc_span : NotInAuxSpan K p (p'.1 * (p'.1 * p'.2) * q'.2) := by
    intro c ⟨r, hr⟩
    apply hpq'₂_span c
    refine ⟨r / (p'.1 : K), ?_⟩
    have h1 : ((p'.1 * (p'.1 * p'.2) * q'.2 : Kˣ) : K) * ∏ i : Fin 6, (p i : K) ^ (c i : ℕ) =
        (((p'.2 * q'.2 : Kˣ) : K) * ∏ i : Fin 6, (p i : K) ^ (c i : ℕ)) * (p'.1 : K) ^ 2 := by
      simp only [Units.val_mul]
      ring
    rw [h1] at hr
    calc ((p'.2 * q'.2 : Kˣ) : K) * ∏ i : Fin 6, (p i : K) ^ (c i : ℕ)
      _ = ((((p'.2 * q'.2 : Kˣ) : K) * ∏ i : Fin 6, (p i : K) ^ (c i : ℕ)) *
            (p'.1 : K) ^ 2) / (p'.1 : K) ^ 2 := by
          rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 p'.1.ne_zero)]
      _ = (r * r) / (p'.1 : K) ^ 2 := by rw [hr]
      _ = (r / (p'.1 : K)) * (r / (p'.1 : K)) := by ring
  obtain ⟨S'_pad, κ'_pad, v₀, hpad_sub, hdisj'_pad, hprin'_pad, hv₀_mem, hv₀_notMem_pad,
    hsq_new, hp'₁, hp'₁₂, hq'₂⟩ :=
    hext S_pad κ_pad p'.1 (p'.1 * p'.2) q'.2 hdisj_pad hprin_pad
      hp'₁_span hp'₁₂_span hq'₂_span habc_span
  have hv₀T : v₀ ∉ T := Finset.disjoint_left.mp hdisj'_pad hv₀_mem
  have hv₀S : v₀ ∉ S_kill := fun hv₀_kill => hv₀_notMem_pad (hkill_pad hv₀_kill)
  have h_hensel : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1 →
      ∀ x : v.adicCompletion K, Valued.v x < 1 → IsSquare (1 + x) := by
    intro v h2 x hx
    have hv2 : Valued.v (2 : v.adicCompletion K) = 1 := by
      rw [← map_ofNat (algebraMap K (v.adicCompletion K)) 2]
      erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v (2 : K)]
      exact h2
    have hv4 : Valued.v (4 : v.adicCompletion K) = 1 := by
      have h42 : (4 : v.adicCompletion K) = 2 * 2 := by norm_num
      rw [h42, Valuation.map_mul, hv2, mul_one]
    have h4_ne : (4 : v.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at hv4
      exact zero_ne_one hv4
