        refine ⟨r, ?_⟩
        change (w₁ : K) ^ (e₁ : ℕ) * (w₂ : K) ^ 1 * (w₃ : K) ^ 0 * (w₄ : K) ^ 0 = r * r
        have hr' : (w₂ : K) * (w₁ : K) ^ (e₁ : ℕ) = r * r := hr
        linear_combination hr'
      exact (by decide : (1 : Fin 2) ≠ 0) (hind e₁ 1 0 0 hsq').2.1
    obtain ⟨K₂, hFieldK₂, hCharK₂, hAlgKK₂, j₁₂, ω₂, σ₂, ι₂, hj₁₂, hω₂_sq, hσ₂_ω₂, hσ₂_j, h_desc₂⟩ :=
