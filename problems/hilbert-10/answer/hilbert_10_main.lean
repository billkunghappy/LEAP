      ⟨p₀, hp₀_mem, rfl⟩
    have hc_S₂ := (hstep3.2 p₀ hc_S₃).1
    have hc_S₁ := (hstep2.2 p₀ hc_S₂).1
    have hc_S := (hstep1.2 p₀ hc_S₁).1
    obtain ⟨I, hI_raw⟩ := hz_span (sqCl p₀.1, sqCl p₀.2) hc_S
    have hI : (sqCl p₀.1, sqCl p₀.2) = (sqCl (∏ k ∈ I, (z k).1), sqCl (∏ k ∈ I, (z k).2)) := by
      rw [hI_raw, hprod_sqCl I]
    let pI : Kˣ × Kˣ := (∏ k ∈ I, (z k).1, ∏ k ∈ I, (z k).2)
    have hpI_S₃ : (sqCl pI.1, sqCl pI.2) ∈
