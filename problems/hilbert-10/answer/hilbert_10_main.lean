        · left
          refine ⟨z.re, ?_, ?_⟩
          · linear_combination h_re - d * z.im * h_im0
          · ext
            · rfl
            · exact h_im0
    obtain ⟨F₁, hFieldF₁, hCharF₁, hAlgKF₁, hAlgFF₁, hTowerKFF₁, ω₁, σ₁, ι₁,
        hω₁_sq, hσ₁_ω₁, hσ₁_alg, hdich₁⟩ :=
      h_s2 F (AlgEquiv.refl : F ≃ₐ[K] F) ι_F (a : K) ha_F y_a hy_a
    letI : Field F₁ := hFieldF₁
    letI : CharZero F₁ := hCharF₁
    letI : Algebra K F₁ := hAlgKF₁
    letI : Algebra F F₁ := hAlgFF₁
    letI : IsScalarTower K F F₁ := hTowerKFF₁
    have hσ₁_F : ∀ u : F, σ₁ (algebraMap F F₁ u) = algebraMap F F₁ u :=
      fun u => hσ₁_alg u
    have h_neg₁ : ∀ w : K, ¬ IsSquare (algebraMap K F w) →
        ∀ z : F₁, z ^ 2 = algebraMap K F₁ w → σ₁ z = -z := by
      intro w hw z hz
      have hz' : z ^ 2 = algebraMap F F₁ (algebraMap K F w) := by
        rw [hz, IsScalarTower.algebraMap_apply K F F₁]
      rcases hdich₁ (algebraMap K F w) z hz' with ⟨u, hu_sq, hz_eq⟩ | ⟨v, _, hz_eq⟩
      · exfalso
        apply hw
        exact ⟨u, by linear_combination -hu_sq⟩
      · rw [hz_eq, map_mul, hσ₁_F, hσ₁_ω₁, mul_neg]
    have h_neg₁_ex : ∀ w : K, ¬ IsSquare (algebraMap K F w) →
        IsSquare (algebraMap K F₁ w) →
        ∃ z : F₁, z ^ 2 = algebraMap K F₁ w ∧ σ₁ z = -z := by
      intro w hw ⟨z, hz⟩
      have hz_sq : z ^ 2 = algebraMap K F₁ w := by linear_combination -hz
      exact ⟨z, hz_sq, h_neg₁ w hw z hz_sq⟩
    refine ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, ?_⟩
    have h_rp₁ : ∀ k : Fin 6,
        (algebraMap F F₁ (β_F k)) ^ 2 = algebraMap K F₁ (p k : K) ∧
        σ₁ (algebraMap F F₁ (β_F k)) = algebraMap F F₁ (β_F k) := by
      intro k
      refine ⟨?_, hσ₁_F (β_F k)⟩
      rw [← map_pow, hβ_F k, ← IsScalarTower.algebraMap_apply K F F₁]
