        · rcases (hS₁_mem v).mp hv1 with hvS | hv_eq1
          · exact htUnif v (Or.inl hvS)
          · exact htUnif v (Or.inr (Or.inl hv_eq1))
        · exact htUnif v (Or.inr (Or.inr (Or.inl hv_eq))))
      (htUnif 𝔮₃ (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))
      (z 4) (z 5)
      (hz_mem_S₂ 4 (by decide) (by decide) (by decide) (by decide))
      (hz_mem_S₂ 5 (by decide) (by decide) (by decide) (by decide))
      hz4_1 hz4_2 hz5_1 hz5_2
    intro c hc
    rcases hc with ⟨p₀, hp₀_mem, hcp₀⟩
    change (sqCl p₀.1, sqCl p₀.2) = c at hcp₀
    have hc_S₃ : (sqCl p₀.1, sqCl p₀.2) ∈
