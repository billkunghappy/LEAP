        · subst hk1; exact hz1_1
        · exact (hz_q₁_other k hk0 hk1).1
      · exact hd1.2.1
    have h1_not : (1 : Fin 6) ∉ I := by
      apply hnotMem (algebraMap K (𝔮₁.adicCompletion K)) I (fun k => (z k).2) 1 hz1_2
      · intro k _ hk1
        by_cases hk0 : k = 0
        · subst hk0; exact hz0_2
        · exact (hz_q₁_other k hk0 hk1).2
      · exact hd1.2.2
    have h2_not : (2 : Fin 6) ∉ I := by
      apply hnotMem (algebraMap K (𝔮₂.adicCompletion K)) I (fun k => (z k).1) 2 hz2_1
      · intro k hkI hk2
        have hk0 : k ≠ 0 := fun h => h0_not (h ▸ hkI)
        have hk1 : k ≠ 1 := fun h => h1_not (h ▸ hkI)
        by_cases hk3 : k = 3
        · subst hk3; exact hz3_1
        · exact (hz_q₂_other k hk0 hk1 hk2 hk3).1
      · exact hd2.2.1
    have h3_not : (3 : Fin 6) ∉ I := by
      apply hnotMem (algebraMap K (𝔮₂.adicCompletion K)) I (fun k => (z k).2) 3 hz3_2
      · intro k hkI hk3
        have hk0 : k ≠ 0 := fun h => h0_not (h ▸ hkI)
        have hk1 : k ≠ 1 := fun h => h1_not (h ▸ hkI)
        by_cases hk2 : k = 2
        · subst hk2; exact hz2_2
        · exact (hz_q₂_other k hk0 hk1 hk2 hk3).2
      · exact hd2.2.2
    have h4_not : (4 : Fin 6) ∉ I := by
      apply hnotMem (algebraMap K (𝔮₃.adicCompletion K)) I (fun k => (z k).1) 4 hz4_1
      · intro k hkI hk4
        have hk0 : k ≠ 0 := fun h => h0_not (h ▸ hkI)
        have hk1 : k ≠ 1 := fun h => h1_not (h ▸ hkI)
        have hk2 : k ≠ 2 := fun h => h2_not (h ▸ hkI)
        have hk3 : k ≠ 3 := fun h => h3_not (h ▸ hkI)
