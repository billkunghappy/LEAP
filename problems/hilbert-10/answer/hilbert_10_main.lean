      obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective b
      change E (sqCl y * sqCl z) ↔ (E (sqCl y) ↔ E (sqCl z))
      rw [← hsqCl_mul, hE_iff, hE_iff, hE_iff]
