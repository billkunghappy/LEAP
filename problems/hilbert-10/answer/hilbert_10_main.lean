        have hA_eq : A_u r = d₂ * r.2 := rfl
        rw [hA_eq] at hA_sq
        exact hd₂_nsq (((hloc_sq_mul d₂ r.2 hd₂_ev hr2_ev).mp hA_sq).mpr hr2_sq)
      · intro hr1_ev
        have hr_V := h_mem_V_of_relax_even r hr_rel hr1_ev hr2_ev
        have hr2_one : sqCl r.2 = sqCl 1 := hker2 (sqCl r.1, sqCl r.2) hr_V
        exact (hsqCl_sq_iff r.2 1 hr2_one).mpr ⟨1, by simp⟩
    obtain ⟨w, hw_rel, hsq1, hsq2⟩ := h_witness_of_orth d₁ d₂ horth2
    have hw1_odd : ¬ EvenVal v₁ w.1 :=
      fun hw1_ev => hd₁_odd (((hloc_ev_mul d₁ w.1).mp (hloc_sq_ev (d₁ * w.1) hsq1)).mpr hw1_ev)
