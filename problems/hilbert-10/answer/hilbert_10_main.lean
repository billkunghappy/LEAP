    obtain ⟨w, hw_rel, hsq1, hsq2⟩ := h_witness_of_orth d₁ d₂ horth3
    have hw1_odd : ¬ EvenVal v₁ w.1 :=
      fun hw1_ev => hd₁_odd (((hloc_ev_mul d₁ w.1).mp (hloc_sq_ev (d₁ * w.1) hsq1)).mpr hw1_ev)
    have hw2_odd : ¬ EvenVal v₁ w.2 :=
      fun hw2_ev => hd₂_odd (((hloc_ev_mul d₂ w.2).mp (hloc_sq_ev (d₂ * w.2) hsq2)).mpr hw2_ev)
    have hw12_ev : EvenVal v₁ (w.1 * w.2) :=
      (hloc_ev_mul w.1 w.2).mpr ⟨fun h1 => False.elim (hw1_odd h1),
