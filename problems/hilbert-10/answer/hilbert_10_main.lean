  have h_coset_card : ∀ (V W : Set (SqCl K × SqCl K)) (Q : SqCl K → Prop)
      (g₁ g₂ : SqCl K × SqCl K),
      V.encard = 4 ^ (n + 1) →
      (∀ c₁ c₂, c₁ ∈ V → c₂ ∈ V → c₁ * c₂ ∈ V) →
      g₁ ∈ V → g₂ ∈ V →
      (∀ c, c ∈ W ↔ c ∈ V ∧ Q c.1 ∧ Q c.2) →
      (∀ c ∈ V, (Q (g₁.1 * c.1) ↔ ¬ Q c.1) ∧ (Q (g₁.2 * c.2) ↔ Q c.2)) →
      (∀ c ∈ V, (Q (g₂.1 * c.1) ↔ Q c.1) ∧ (Q (g₂.2 * c.2) ↔ ¬ Q c.2)) →
      W.encard = 4 ^ n := by
    intro V W Q g₁ g₂ hV_card hV_mul_abs hg₁_V hg₂_V hW_char hg₁_Q hg₂_Q
    have hcoset_mem : ∀ (g c : SqCl K × SqCl K),
        c ∈ (g * ·) '' W ↔ g * c ∈ W := by
      intro g c
      constructor
      · rintro ⟨w, hw, rfl⟩
        have hgg : g * (g * w) = w := by rw [← mul_assoc, hprod_self g, one_mul]
        rw [hgg]; exact hw
      · intro hgc
        refine ⟨g * c, hgc, ?_⟩
        dsimp
        rw [← mul_assoc, hprod_self g, one_mul]
    have hV_mul_iff : ∀ (g c : SqCl K × SqCl K), g ∈ V → (g * c ∈ V ↔ c ∈ V) := by
      intro g c hg
      constructor
      · intro hgc
        have h := hV_mul_abs g (g * c) hg hgc
        rw [← mul_assoc, hprod_self g, one_mul] at h
        exact h
      · intro hc
        exact hV_mul_abs g c hg hc
    have hg₁₂_V : g₁ * g₂ ∈ V := hV_mul_abs g₁ g₂ hg₁_V hg₂_V
    set W₀ : Set (SqCl K × SqCl K) := W
    set W₁ : Set (SqCl K × SqCl K) := (g₁ * ·) '' W
    set W₂ : Set (SqCl K × SqCl K) := (g₂ * ·) '' W
    set W₃ : Set (SqCl K × SqCl K) := ((g₁ * g₂) * ·) '' W
    have hW₁_char : ∀ c : SqCl K × SqCl K, c ∈ W₁ ↔ c ∈ V ∧ ¬ Q c.1 ∧ Q c.2 := by
      intro c
      rw [hcoset_mem, hW_char, hV_mul_iff g₁ c hg₁_V]
      constructor
      · rintro ⟨hcV, h1, h2⟩
