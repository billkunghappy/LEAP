          (algebraMap K (v₁.adicCompletion K) ((d₃₄ * (w.1 * w.2) : Kˣ) : K)) := by
        refine ⟨(s₁ * s₂) / algebraMap K (v₁.adicCompletion K) (π_u : K), ?_⟩
        have hrel_w : algebraMap K (v₁.adicCompletion K) ((d₃₄ * (w.1 * w.2) : Kˣ) : K) *
