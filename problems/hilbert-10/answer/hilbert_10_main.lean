    constructor
    · rintro ⟨r, hr, rfl⟩
      have hr0 := hr.2.2.2 v₀ hv₀T hv₀S
      exact ⟨⟨r, ⟨hr.1, hr.2.1, hr.2.2.1, fun v hvT hvS _ => hr.2.2.2 v hvT hvS⟩, rfl⟩,
             (hE_iff r.1).mpr hr0.1, (hE_iff r.2).mpr hr0.2⟩
    · rintro ⟨⟨r, hr, rfl⟩, hE1, hE2⟩
      have hr1_ev := (hE_iff r.1).mp hE1
      have hr2_ev := (hE_iff r.2).mp hE2
      refine ⟨r, ⟨hr.1, hr.2.1, hr.2.2.1, ?_⟩, rfl⟩
      intro v hvT hvS
      by_cases hv0 : v = v₀
      · subst hv0; exact ⟨hr1_ev, hr2_ev⟩
      · exact hr.2.2.2 v hvT hvS hv0
  have hW_iff : ∀ c : SqCl K × SqCl K, c ∈ W ↔ c ∈ R ∧ L c.1 ∧ L c.2 := by
    intro c
    constructor
    · rintro ⟨r, hr, rfl⟩
      have hram0 : RamLocal a₁ a₂ a₃ v₀ (π v₀) r.1 r.2 :=
        hr.2.2.1 v₀ (Finset.mem_insert_self v₀ S)
      rw [hπ_v₀] at hram0
      obtain ⟨haux1, haux2⟩ := (hram_iff r.1 r.2).mp hram0
      refine ⟨⟨r, ⟨hr.1, hr.2.1,
        fun v hvS => hr.2.2.1 v (Finset.mem_insert_of_mem hvS),
        fun v hvT hvS hv0 => hr.2.2.2 v hvT (fun hv => (Finset.mem_insert.mp hv).elim hv0 hvS)⟩, rfl⟩,
        (hL_iff r.1).mpr haux1, (hL_iff r.2).mpr haux2⟩
    · rintro ⟨⟨r, hr, rfl⟩, hL1, hL2⟩
      have haux1 := (hL_iff r.1).mp hL1
      have haux2 := (hL_iff r.2).mp hL2
      have hram0 : RamLocal a₁ a₂ a₃ v₀ (π v₀) r.1 r.2 := by
        rw [hπ_v₀]
        exact (hram_iff r.1 r.2).mpr ⟨haux1, haux2⟩
      refine ⟨r, ⟨hr.1, hr.2.1, ?_, ?_⟩, rfl⟩
      · intro v hv
        rcases Finset.mem_insert.mp hv with rfl | hvS
        · exact hram0
        · exact hr.2.2.1 v hvS
      · intro v hvT hv
        exact hr.2.2.2 v hvT
          (fun hvS => hv (Finset.mem_insert_of_mem hvS))
          (fun hv0 => hv (hv0 ▸ Finset.mem_insert_self v₀ S))
  have hLaw1 : ∀ c ∈ R, (¬ E c.1 ∧ ¬ L c.2) ↔ (¬ E c.2 ∧ ¬ L c.1) := by
    rintro c ⟨r, hr_set, rfl⟩
    have hr : (sqCl r.1, sqCl r.2) ∈ R := ⟨r, hr_set, rfl⟩
    have h1 := hpr_iff r.1 r.2 (hpr r hr)
    simpa only [hE_iff, hL_iff] using h1
  
  have hhilb_dichot : ∀ a b : K, hilbFin v₀ a b = 1 ∨ hilbFin v₀ a b = -1 := by
    intro a b
    unfold hilbFin hilbLoc
    split_ifs with h
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hhilb_mul_eq_one_iff : ∀ b₁ c₁ b₂ c₂ : K,
      hilbFin v₀ b₁ c₁ * hilbFin v₀ b₂ c₂ = 1 ↔
      (hilbFin v₀ b₁ c₁ = 1 ↔ hilbFin v₀ b₂ c₂ = 1) := by
    intro b₁ c₁ b₂ c₂
    rcases hhilb_dichot b₁ c₁ with h1 | h1 <;>
      rcases hhilb_dichot b₂ c₂ with h2 | h2 <;>
      rw [h1, h2] <;> decide
  have hsq_prod_iff : ∀ d u : Kˣ,
      IsSquare (algebraMap K (v₀.adicCompletion K) (d : K) *
        algebraMap K (v₀.adicCompletion K) (u : K)) ↔
      (E (sqCl u) ↔ E (sqCl d)) ∧ (L (sqCl u) ↔ L (sqCl d)) := by
    intro d u
    have hmap : algebraMap K (v₀.adicCompletion K) (d : K) *
        algebraMap K (v₀.adicCompletion K) (u : K) =
        algebraMap K (v₀.adicCompletion K) ((d * u : Kˣ) : K) := by
      simp [Units.val_mul, map_mul]
    rw [hmap, ← hev_aux_iff_sq (d * u), hev_mul d u, haux_mul d u,
        ← hE_iff d, ← hE_iff u, ← hL_iff d, ← hL_iff u]
    exact and_congr iff_comm iff_comm
  have hhilb_bool_iff : ∀ d u : Kˣ,
      hilbFin v₀ (d : K) (u : K) = 1 ↔
      ((¬ E (sqCl d) ∧ ¬ L (sqCl u)) ↔ (¬ E (sqCl u) ∧ ¬ L (sqCl d))) := by
    intro d u
    rw [hhilb_iff d u, ← hE_iff d, ← hE_iff u, ← hL_iff d, ← hL_iff u]
  have h_pt_duality : ∀ d₁ d₂ : Kˣ,
      (∃ c ∈ R,
        (E c.1 ↔ E (sqCl d₁)) ∧ (E c.2 ↔ E (sqCl d₂)) ∧
        (L c.1 ↔ L (sqCl d₁)) ∧ (L c.2 ↔ L (sqCl d₂))) ↔
      (∀ c ∈ R,
        (((¬ E (sqCl d₁) ∧ ¬ L c.2) ↔ (¬ E c.2 ∧ ¬ L (sqCl d₁))) ↔
         ((¬ E (sqCl d₂) ∧ ¬ L c.1) ↔ (¬ E c.1 ∧ ¬ L (sqCl d₂))))) := by
    intro d₁ d₂
    have hd₁_ne : algebraMap K (v₀.adicCompletion K) (d₁ : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne d₁.ne_zero
    have hd₂_ne : algebraMap K (v₀.adicCompletion K) (d₂ : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne d₂.ne_zero
    have hpt := theorem_4_5 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ hint₁ hint₂ hint₃ T S hT hST π hπ
      v₀ hv₀T hv₀S
      (algebraMap K (v₀.adicCompletion K) (d₁ : K))
      (algebraMap K (v₀.adicCompletion K) (d₂ : K))
      hd₁_ne hd₂_ne
    constructor
    · rintro ⟨c, hcR, hE1, hE2, hL1, hL2⟩
      obtain ⟨p, hp_set, rfl⟩ := hcR
      have hpR : (sqCl p.1, sqCl p.2) ∈ R := ⟨p, hp_set, rfl⟩
      have hsq1 : IsSquare (algebraMap K (v₀.adicCompletion K) (d₁ : K) *
          algebraMap K (v₀.adicCompletion K) (p.1 : K)) :=
        (hsq_prod_iff d₁ p.1).mpr ⟨hE1, hL1⟩
      have hsq2 : IsSquare (algebraMap K (v₀.adicCompletion K) (d₂ : K) *
          algebraMap K (v₀.adicCompletion K) (p.2 : K)) :=
        (hsq_prod_iff d₂ p.2).mpr ⟨hE2, hL2⟩
      have hall := hpt.mpr ⟨p, hpR, hsq1, hsq2⟩
      rintro c' ⟨r, hr_set, rfl⟩
      have hrR : (sqCl r.1, sqCl r.2) ∈ R := ⟨r, hr_set, rfl⟩
      have hmul1 : hilbFin v₀ (d₁ : K) (r.2 : K) * hilbFin v₀ (d₂ : K) (r.1 : K) = 1 :=
        hall r hrR
      have hiff := (hhilb_mul_eq_one_iff (d₁ : K) (r.2 : K) (d₂ : K) (r.1 : K)).mp hmul1
      simpa only [hhilb_bool_iff] using hiff
    · intro hall
      have hall_p : ∀ p : Kˣ × Kˣ, (sqCl p.1, sqCl p.2) ∈ R →
          hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) (d₁ : K))
            (algebraMap K (v₀.adicCompletion K) (p.2 : K)) *
          hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) (d₂ : K))
            (algebraMap K (v₀.adicCompletion K) (p.1 : K)) = 1 := by
        intro p hpR
        have hc := hall (sqCl p.1, sqCl p.2) hpR
        have hiff : hilbFin v₀ (d₁ : K) (p.2 : K) = 1 ↔ hilbFin v₀ (d₂ : K) (p.1 : K) = 1 := by
          simpa only [hhilb_bool_iff] using hc
        exact (hhilb_mul_eq_one_iff (d₁ : K) (p.2 : K) (d₂ : K) (p.1 : K)).mpr hiff
      obtain ⟨p, hpR, hsq1, hsq2⟩ := hpt.mp hall_p
      obtain ⟨hE1, hL1⟩ := (hsq_prod_iff d₁ p.1).mp hsq1
      obtain ⟨hE2, hL2⟩ := (hsq_prod_iff d₂ p.2).mp hsq2
      exact ⟨(sqCl p.1, sqCl p.2), hpR, hE1, hE2, hL1, hL2⟩
  
  have hLaw2 : ∀ b₁ b₂ : Prop,
      (∃ c ∈ V, (¬ L c.1 ↔ b₁) ∧ (¬ L c.2 ↔ b₂)) ↔
      (∀ c ∈ R, (b₁ ∧ ¬ E c.2) ↔ (b₂ ∧ ¬ E c.1)) := by
    intro b₁ b₂
    let d₁ : Kˣ := if b₁ then ε₀ else 1
    let d₂ : Kˣ := if b₂ then ε₀ else 1
    have hd₁_E : E (sqCl d₁) := by
      dsimp [d₁]; split_ifs
      · exact (hE_iff ε₀).mpr hev_ε₀
      · exact (hE_iff 1).mpr hev_1
    have hd₂_E : E (sqCl d₂) := by
      dsimp [d₂]; split_ifs
      · exact (hE_iff ε₀).mpr hev_ε₀
      · exact (hE_iff 1).mpr hev_1
    have hd₁_L : ¬ L (sqCl d₁) ↔ b₁ := by
      dsimp [d₁]; split_ifs with hb₁
      · have hnL : ¬ L (sqCl ε₀) := fun h => haux_ε₀ ((hL_iff ε₀).mp h)
        exact ⟨fun _ => hb₁, fun _ => hnL⟩
      · have hL : L (sqCl 1) := (hL_iff 1).mpr haux_1
        exact ⟨fun h => False.elim (h hL), fun h => False.elim (hb₁ h)⟩
    have hd₂_L : ¬ L (sqCl d₂) ↔ b₂ := by
      dsimp [d₂]; split_ifs with hb₂
      · have hnL : ¬ L (sqCl ε₀) := fun h => haux_ε₀ ((hL_iff ε₀).mp h)
        exact ⟨fun _ => hb₂, fun _ => hnL⟩
      · have hL : L (sqCl 1) := (hL_iff 1).mpr haux_1
        exact ⟨fun h => False.elim (h hL), fun h => False.elim (hb₂ h)⟩
    have h_lhs : (∃ c ∈ V, (¬ L c.1 ↔ b₁) ∧ (¬ L c.2 ↔ b₂)) ↔
        (∃ c ∈ R,
          (E c.1 ↔ E (sqCl d₁)) ∧ (E c.2 ↔ E (sqCl d₂)) ∧
          (L c.1 ↔ L (sqCl d₁)) ∧ (L c.2 ↔ L (sqCl d₂))) := by
      constructor
      · rintro ⟨c, hcV, hL1, hL2⟩
        obtain ⟨hcR, hE1, hE2⟩ := (hV_iff c).mp hcV
        exact ⟨c, hcR,
          ⟨fun _ => hd₁_E, fun _ => hE1⟩,
          ⟨fun _ => hd₂_E, fun _ => hE2⟩,
          not_iff_not.mp (hL1.trans hd₁_L.symm),
          not_iff_not.mp (hL2.trans hd₂_L.symm)⟩
      · rintro ⟨c, hcR, hE1, hE2, hL1, hL2⟩
        have hcV : c ∈ V := (hV_iff c).mpr ⟨hcR, hE1.mpr hd₁_E, hE2.mpr hd₂_E⟩
        exact ⟨c, hcV, (not_iff_not.mpr hL1).trans hd₁_L, (not_iff_not.mpr hL2).trans hd₂_L⟩
    have h_rhs : (∀ c ∈ R,
        (((¬ E (sqCl d₁) ∧ ¬ L c.2) ↔ (¬ E c.2 ∧ ¬ L (sqCl d₁))) ↔
         ((¬ E (sqCl d₂) ∧ ¬ L c.1) ↔ (¬ E c.1 ∧ ¬ L (sqCl d₂))))) ↔
        (∀ c ∈ R, (b₁ ∧ ¬ E c.2) ↔ (b₂ ∧ ¬ E c.1)) := by
      refine forall₂_congr (fun c _ => ?_)
      have h1 : (¬ E (sqCl d₁) ∧ ¬ L c.2) ↔ False := ⟨fun ⟨h, _⟩ => h hd₁_E, False.elim⟩
      have h2 : (¬ E c.2 ∧ ¬ L (sqCl d₁)) ↔ (b₁ ∧ ¬ E c.2) := by rw [hd₁_L, and_comm]
      have h3 : (¬ E (sqCl d₂) ∧ ¬ L c.1) ↔ False := ⟨fun ⟨h, _⟩ => h hd₂_E, False.elim⟩
      have h4 : (¬ E c.1 ∧ ¬ L (sqCl d₂)) ↔ (b₂ ∧ ¬ E c.1) := by rw [hd₂_L, and_comm]
      rw [h1, h2, h3, h4, false_iff, false_iff, not_iff_not]
    exact h_lhs.trans ((h_pt_duality d₁ d₂).trans h_rhs)
  have hLaw3 : ∀ b₁ b₂ : Prop,
      (∃ c ∈ W, (¬ E c.1 ↔ b₁) ∧ (¬ E c.2 ↔ b₂)) ↔
      (∀ c ∈ R, (b₁ ∧ ¬ L c.2) ↔ (b₂ ∧ ¬ L c.1)) := by
    intro b₁ b₂
    let d₁ : Kˣ := if b₁ then π_u else 1
    let d₂ : Kˣ := if b₂ then π_u else 1
    have hd₁_L : L (sqCl d₁) := by
      dsimp [d₁]; split_ifs
      · exact (hL_iff π_u).mpr haux_π_u
      · exact (hL_iff 1).mpr haux_1
    have hd₂_L : L (sqCl d₂) := by
      dsimp [d₂]; split_ifs
      · exact (hL_iff π_u).mpr haux_π_u
      · exact (hL_iff 1).mpr haux_1
    have hd₁_E : ¬ E (sqCl d₁) ↔ b₁ := by
      dsimp [d₁]; split_ifs with hb₁
      · have hnE : ¬ E (sqCl π_u) := fun h => hev_π_u ((hE_iff π_u).mp h)
        exact ⟨fun _ => hb₁, fun _ => hnE⟩
      · have hE : E (sqCl 1) := (hE_iff 1).mpr hev_1
        exact ⟨fun h => False.elim (h hE), fun h => False.elim (hb₁ h)⟩
    have hd₂_E : ¬ E (sqCl d₂) ↔ b₂ := by
      dsimp [d₂]; split_ifs with hb₂
      · have hnE : ¬ E (sqCl π_u) := fun h => hev_π_u ((hE_iff π_u).mp h)
        exact ⟨fun _ => hb₂, fun _ => hnE⟩
      · have hE : E (sqCl 1) := (hE_iff 1).mpr hev_1
        exact ⟨fun h => False.elim (h hE), fun h => False.elim (hb₂ h)⟩
    have h_lhs : (∃ c ∈ W, (¬ E c.1 ↔ b₁) ∧ (¬ E c.2 ↔ b₂)) ↔
        (∃ c ∈ R,
          (E c.1 ↔ E (sqCl d₁)) ∧ (E c.2 ↔ E (sqCl d₂)) ∧
          (L c.1 ↔ L (sqCl d₁)) ∧ (L c.2 ↔ L (sqCl d₂))) := by
      constructor
      · rintro ⟨c, hcW, hE1, hE2⟩
        obtain ⟨hcR, hL1, hL2⟩ := (hW_iff c).mp hcW
        exact ⟨c, hcR,
          not_iff_not.mp (hE1.trans hd₁_E.symm),
          not_iff_not.mp (hE2.trans hd₂_E.symm),
          ⟨fun _ => hd₁_L, fun _ => hL1⟩,
          ⟨fun _ => hd₂_L, fun _ => hL2⟩⟩
      · rintro ⟨c, hcR, hE1, hE2, hL1, hL2⟩
        have hcW : c ∈ W := (hW_iff c).mpr ⟨hcR, hL1.mpr hd₁_L, hL2.mpr hd₂_L⟩
        exact ⟨c, hcW, (not_iff_not.mpr hE1).trans hd₁_E, (not_iff_not.mpr hE2).trans hd₂_E⟩
    have h_rhs : (∀ c ∈ R,
        (((¬ E (sqCl d₁) ∧ ¬ L c.2) ↔ (¬ E c.2 ∧ ¬ L (sqCl d₁))) ↔
         ((¬ E (sqCl d₂) ∧ ¬ L c.1) ↔ (¬ E c.1 ∧ ¬ L (sqCl d₂))))) ↔
        (∀ c ∈ R, (b₁ ∧ ¬ L c.2) ↔ (b₂ ∧ ¬ L c.1)) := by
      refine forall₂_congr (fun c _ => ?_)
      have h1 : (¬ E (sqCl d₁) ∧ ¬ L c.2) ↔ (b₁ ∧ ¬ L c.2) := by rw [hd₁_E]
      have h2 : (¬ E c.2 ∧ ¬ L (sqCl d₁)) ↔ False := ⟨fun ⟨_, h⟩ => h hd₁_L, False.elim⟩
      have h3 : (¬ E (sqCl d₂) ∧ ¬ L c.1) ↔ (b₂ ∧ ¬ L c.1) := by rw [hd₂_E]
      have h4 : (¬ E c.1 ∧ ¬ L (sqCl d₂)) ↔ False := ⟨fun ⟨_, h⟩ => h hd₂_L, False.elim⟩
      rw [h1, h2, h3, h4, iff_false, iff_false, not_iff_not]
    exact h_lhs.trans ((h_pt_duality d₁ d₂).trans h_rhs)
  exact ⟨h1_R, hR_mul, E, L, hE_1, hL_1, hE_mul, hL_mul, hV_iff, hW_iff, hLaw1, hLaw2, hLaw3⟩

theorem isotropic_lagrangian_encard_four_pow (K : Type u) [Field K]
    (R V W : Set (SqCl K × SqCl K))
    (m : ℕ)
    (hpair : IsIsotropicLagrangianPair K R V W)
    (hm : V.encard = 4 ^ m) :
    ∃ m' : ℕ, W.encard = 4 ^ m' :=
by
  have iff_not_of_not : ∀ {X Y Z : Prop}, (X ↔ (Y ↔ Z)) → ¬ Y → (X ↔ ¬ Z) :=
    fun hiff hnY => ⟨fun hX hZ => hnY ((hiff.mp hX).mpr hZ),
      fun hnZ => hiff.mpr ⟨fun hY => False.elim (hnY hY), fun hZ => False.elim (hnZ hZ)⟩⟩
  rcases hpair with ⟨h1_R, hR_mul, E, L, hE1, hL1, hE_mul, hL_mul, hV_char, hW_char,
    hiso_R, hV_dual, hW_dual⟩
  have hsq_self : ∀ a : SqCl K, a * a = 1 := by
    intro a
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective a
    change QuotientGroup.mk (x * x) = 1
    rw [QuotientGroup.eq_one_iff]
    exact ⟨x, sq x⟩
  have hprod_self : ∀ g : SqCl K × SqCl K, g * g = 1 := by
    intro g
    ext
    · exact hsq_self g.1
    · exact hsq_self g.2
  let K₀ : Set (SqCl K × SqCl K) := V ∩ W
  have h1_W : (1 : SqCl K × SqCl K) ∈ W := (hW_char 1).mpr ⟨h1_R, hL1, hL1⟩
  have hV_mul : ∀ c₁ c₂, c₁ ∈ V → c₂ ∈ V → c₁ * c₂ ∈ V := by
    intro c₁ c₂ hc₁ hc₂
    rcases (hV_char c₁).mp hc₁ with ⟨hc₁R, hEc₁1, hEc₁2⟩
    rcases (hV_char c₂).mp hc₂ with ⟨hc₂R, hEc₂1, hEc₂2⟩
    refine (hV_char (c₁ * c₂)).mpr ⟨hR_mul c₁ c₂ hc₁R hc₂R, ?_, ?_⟩
    · exact (hE_mul c₁.1 c₂.1).mpr (iff_of_true hEc₁1 hEc₂1)
    · exact (hE_mul c₁.2 c₂.2).mpr (iff_of_true hEc₁2 hEc₂2)
  have hW_mul : ∀ c₁ c₂, c₁ ∈ W → c₂ ∈ W → c₁ * c₂ ∈ W := by
    intro c₁ c₂ hc₁ hc₂
    rcases (hW_char c₁).mp hc₁ with ⟨hc₁R, hLc₁1, hLc₁2⟩
    rcases (hW_char c₂).mp hc₂ with ⟨hc₂R, hLc₂1, hLc₂2⟩
    refine (hW_char (c₁ * c₂)).mpr ⟨hR_mul c₁ c₂ hc₁R hc₂R, ?_, ?_⟩
    · exact (hL_mul c₁.1 c₂.1).mpr (iff_of_true hLc₁1 hLc₂1)
    · exact (hL_mul c₁.2 c₂.2).mpr (iff_of_true hLc₁2 hLc₂2)
  have hK₀_V : ∀ c, c ∈ K₀ ↔ c ∈ V ∧ L c.1 ∧ L c.2 :=
    fun c => ⟨fun ⟨hcV, hcW⟩ => ⟨hcV, ((hW_char c).mp hcW).2⟩,
      fun ⟨hcV, hL12⟩ => ⟨hcV, (hW_char c).mpr ⟨((hV_char c).mp hcV).1, hL12⟩⟩⟩
  have hK₀_W : ∀ c, c ∈ K₀ ↔ c ∈ W ∧ E c.1 ∧ E c.2 :=
    fun c => ⟨fun ⟨hcV, hcW⟩ => ⟨hcW, ((hV_char c).mp hcV).2⟩,
      fun ⟨hcW, hE12⟩ => ⟨(hV_char c).mpr ⟨((hW_char c).mp hcW).1, hE12⟩, hcW⟩⟩
  have h_two_coset : ∀ (A B : Set (SqCl K × SqCl K)) (Q : SqCl K × SqCl K → Prop)
      (g : SqCl K × SqCl K),
      (∀ c₁ c₂, c₁ ∈ B → c₂ ∈ B → c₁ * c₂ ∈ B) →
      g ∈ B →
      (∀ c, c ∈ A ↔ c ∈ B ∧ Q c) →
      (∀ c ∈ B, Q (g * c) ↔ ¬ Q c) →
      B.encard = A.encard + A.encard := by
    intro A B Q g hB_mul hg_B hA_B hg_Q
    let A₁ : Set (SqCl K × SqCl K) := (fun x => g * x) '' A
    have hA₁_char : ∀ c, c ∈ A₁ ↔ c ∈ B ∧ ¬ Q c := by
      intro c
      constructor
      · rintro ⟨k, hkA, rfl⟩
        rcases (hA_B k).mp hkA with ⟨hkB, hQk⟩
