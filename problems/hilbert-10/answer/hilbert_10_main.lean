      exact hmul_nonsq x y hx_ev hy_ev hx_nonsq hy_nonsq
  have hp'_ev1 : EvenVal v₀ p'.1 := (hp'_mem.2.2.2 v₀ hv₀T hv₀S).1
  have hp'_ev2 : EvenVal v₀ p'.2 := (hp'_mem.2.2.2 v₀ hv₀T hv₀S).2
  have hq'_ev1 : EvenVal v₀ q'.1 := (hq'_mem.2.2.2 v₀ hv₀T hv₀S).1
  have hq'_ev2 : EvenVal v₀ q'.2 := (hq'_mem.2.2.2 v₀ hv₀T hv₀S).2
  have hp'₂ : IsSquare (algebraMap K (v₀.adicCompletion K) (p'.2 : K)) := by
    by_contra hp'₂_nonsq
    exact hp'₁₂ ((hnonsq_mul_iff p'.1 p'.2 hp'_ev1 hp'_ev2 hp'₁).mpr hp'₂_nonsq)
  have hu₂_ex : ∃ u₂ : Kˣ × Kˣ, u₂ ∈ PreV ∧
      EvenVal v₀ u₂.1 ∧ EvenVal v₀ u₂.2 ∧
      IsSquare (algebraMap K (v₀.adicCompletion K) (u₂.1 : K)) ∧
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u₂.2 : K)) := by
    by_cases hq'₁ : IsSquare (algebraMap K (v₀.adicCompletion K) (q'.1 : K))
    · exact ⟨q', hq'_mem, hq'_ev1, hq'_ev2, hq'₁, hq'₂⟩
    · refine ⟨(p'.1 * q'.1, p'.2 * q'.2), hpq'_mem,
        heven_mul v₀ p'.1 q'.1 hp'_ev1 hq'_ev1,
        heven_mul v₀ p'.2 q'.2 hp'_ev2 hq'_ev2,
        hmul_nonsq p'.1 q'.1 hp'_ev1 hq'_ev1 hp'₁ hq'₁, ?_⟩
      intro hsq
      exact hq'₂ ((hsq_mul_iff p'.2 q'.2 hp'₂).mp hsq)
  obtain ⟨u₂, hu₂_mem, hu₂_ev1, hu₂_ev2, hu₂_sq1, hu₂_nonsq2⟩ := hu₂_ex
  set u₁ : Kˣ × Kˣ := p'
  have hu₁_mem : u₁ ∈ PreV := hp'_mem
  have hu₁_ev1 : EvenVal v₀ u₁.1 := hp'_ev1
  have hu₁_ev2 : EvenVal v₀ u₁.2 := hp'_ev2
  have hu₁_nonsq1 : ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u₁.1 : K)) := hp'₁
  have hu₁_sq2 : IsSquare (algebraMap K (v₀.adicCompletion K) (u₁.2 : K)) := hp'₂
  set S'_kill : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    insert v₀ S_kill
  set π'_kill : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v.adicCompletion K := Function.update π_kill v₀ π₀
  have hπ' : ∀ v ∈ S'_kill, IsLocalUnif v (π'_kill v) := by
    intro v hv
    rcases Finset.mem_insert.mp hv with rfl | hvS
    · dsimp [π'_kill]; rw [Function.update_self]; exact hπ₀
    · have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
      dsimp [π'_kill]; rw [Function.update_of_ne hv_ne]; exact hπ_unif v hvS
  let PreW : Set (Kˣ × Kˣ) :=
    { r : Kˣ × Kˣ |
      (∀ v ∈ T, IsDescentClass
            (algebraMap K (v.adicCompletion K) a₁)
            (algebraMap K (v.adicCompletion K) a₂)
            (algebraMap K (v.adicCompletion K) a₃)
            (algebraMap K (v.adicCompletion K) (r.1 : K))
            (algebraMap K (v.adicCompletion K) (r.2 : K))) ∧
      (∀ w : NumberField.InfinitePlace K, IsDescentClass
            (algebraMap K w.Completion a₁)
            (algebraMap K w.Completion a₂)
            (algebraMap K w.Completion a₃)
            (algebraMap K w.Completion (r.1 : K))
            (algebraMap K w.Completion (r.2 : K))) ∧
      (∀ v ∈ S'_kill, RamLocal a₁ a₂ a₃ v (π'_kill v) r.1 r.2) ∧
      (∀ v, v ∉ T → v ∉ S'_kill → EvenVal v r.1 ∧ EvenVal v r.2) }
  have hPreV_relax : ∀ r : Kˣ × Kˣ, r ∈ PreV →
      (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S_kill π_kill v₀ := by
    rintro r ⟨h1, h2, h3, h4⟩
    exact ⟨r, ⟨h1, h2, h3, fun v hvT hvS _ => h4 v hvT hvS⟩, rfl⟩
  have hPreW_relax : ∀ r : Kˣ × Kˣ, r ∈ PreW →
      (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S_kill π_kill v₀ := by
    rintro r ⟨h1, h2, h3, h4⟩
    refine ⟨r, ⟨h1, h2, ?_, ?_⟩, rfl⟩
    · intro v hvS
      have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
      have h3v := h3 v (Finset.mem_insert_of_mem hvS)
      dsimp [π'_kill] at h3v
      rw [Function.update_of_ne hv_ne] at h3v
      exact h3v
    · intro v hvT hvS hv_ne
      exact h4 v hvT (fun hv => (Finset.mem_insert.mp hv).elim hv_ne hvS)
  have hhilb_sq_left : ∀ (u : Kˣ) (b : v₀.adicCompletion K),
      IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
      hilbLoc v₀ (algebraMap K (v₀.adicCompletion K) (u : K)) b = 1 := by
    intro u b ⟨s, hs⟩
    have hs_ne : s ≠ 0 := by
      intro h0; rw [h0, mul_zero] at hs
      exact (algebraMap K (v₀.adicCompletion K)).injective.ne u.ne_zero hs
    unfold hilbLoc
    rw [if_pos]
    refine ⟨s⁻¹, 0, ?_⟩
    rw [hs]
    calc (s * s) * (s⁻¹) ^ 2 + b * 0 ^ 2
      _ = (s * s⁻¹) * (s * s⁻¹) := by ring
      _ = 1 := by rw [mul_inv_cancel₀ hs_ne, mul_one]
  have hPreW_even : ∀ r : Kˣ × Kˣ, r ∈ PreW → EvenVal v₀ r.1 ∧ EvenVal v₀ r.2 := by
    intro r hr
    have hr_rel := hPreW_relax r hr
    have hu₁1_ne : algebraMap K (v₀.adicCompletion K) (u₁.1 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₁.1.ne_zero
    have hu₁2_ne : algebraMap K (v₀.adicCompletion K) (u₁.2 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₁.2.ne_zero
    have hu₂1_ne : algebraMap K (v₀.adicCompletion K) (u₂.1 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₂.1.ne_zero
    have hu₂2_ne : algebraMap K (v₀.adicCompletion K) (u₂.2 : K) ≠ 0 :=
      (algebraMap K (v₀.adicCompletion K)).injective.ne u₂.2.ne_zero
    have horth₁ := (theorem_4_5 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ hint₁ hint₂ hint₃ T S_kill hT hST π_kill hπ_unif
      v₀ hv₀T hv₀S
      (algebraMap K (v₀.adicCompletion K) (u₁.1 : K))
      (algebraMap K (v₀.adicCompletion K) (u₁.2 : K))
      hu₁1_ne hu₁2_ne).mpr
      ⟨u₁, hPreV_relax u₁ hu₁_mem,
       ⟨algebraMap K (v₀.adicCompletion K) (u₁.1 : K), rfl⟩,
       ⟨algebraMap K (v₀.adicCompletion K) (u₁.2 : K), rfl⟩⟩
      r hr_rel
    rw [hhilb_sq_left u₁.2 _ hu₁_sq2, mul_one] at horth₁
    have hr2_ev : EvenVal v₀ r.2 := hhilb_even u₁.1 r.2 hu₁_ev1 hu₁_nonsq1 horth₁
    have horth₂ := (theorem_4_5 a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ hint₁ hint₂ hint₃ T S_kill hT hST π_kill hπ_unif
      v₀ hv₀T hv₀S
      (algebraMap K (v₀.adicCompletion K) (u₂.1 : K))
      (algebraMap K (v₀.adicCompletion K) (u₂.2 : K))
      hu₂1_ne hu₂2_ne).mpr
      ⟨u₂, hPreV_relax u₂ hu₂_mem,
       ⟨algebraMap K (v₀.adicCompletion K) (u₂.1 : K), rfl⟩,
       ⟨algebraMap K (v₀.adicCompletion K) (u₂.2 : K), rfl⟩⟩
      r hr_rel
    rw [hhilb_sq_left u₂.1 _ hu₂_sq1, one_mul] at horth₂
    have hr1_ev : EvenVal v₀ r.1 := hhilb_even u₂.2 r.1 hu₂_ev2 hu₂_nonsq2 horth₂
    exact ⟨hr1_ev, hr2_ev⟩
  let P : SqCl K → Prop := fun c =>
    ∃ x : Kˣ, sqCl x = c ∧ IsSquare (algebraMap K (v₀.adicCompletion K) (x : K))
  have hP_iff : ∀ x : Kˣ, P (sqCl x) ↔ IsSquare (algebraMap K (v₀.adicCompletion K) (x : K)) := by
    intro x
    constructor
    · rintro ⟨y, hy_eq, hy_sq⟩
      exact (hsqCl_sq_iff y x hy_eq).mp hy_sq
    · intro hx_sq
      exact ⟨x, rfl, hx_sq⟩
  have hW_iff : ∀ c : SqCl K × SqCl K,
      c ∈ selmerStruct K a₁ a₂ a₃ T S'_kill π'_kill ↔
      c ∈ V ∧ P c.1 ∧ P c.2 := by
    intro c
    constructor
    · rintro ⟨r, hr, rfl⟩
      obtain ⟨hr1_ev, hr2_ev⟩ := hPreW_even r hr
      have hr_V : r ∈ PreV := by
        refine ⟨hr.1, hr.2.1, ?_, ?_⟩
        · intro v hvS
          have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
          have h3v := hr.2.2.1 v (Finset.mem_insert_of_mem hvS)
          dsimp [π'_kill] at h3v
          rw [Function.update_of_ne hv_ne] at h3v
          exact h3v
        · intro v hvT hvS
          by_cases hv0 : v = v₀
          · subst hv0; exact ⟨hr1_ev, hr2_ev⟩
          · exact hr.2.2.2 v hvT (fun hv => (Finset.mem_insert.mp hv).elim hv0 hvS)
      have hram0 : RamLocal a₁ a₂ a₃ v₀ π₀ r.1 r.2 := by
        have h30 := hr.2.2.1 v₀ (Finset.mem_insert_self v₀ S_kill)
        dsimp [π'_kill] at h30
        rw [Function.update_self] at h30
        exact h30
      obtain ⟨hsq1, hsq2⟩ := (hram_even r.1 r.2 hπ₀ hr1_ev hr2_ev).mp hram0
      exact ⟨⟨r, hr_V, rfl⟩, (hP_iff r.1).mpr hsq1, (hP_iff r.2).mpr hsq2⟩
    · rintro ⟨⟨r, hr_V, rfl⟩, hP1, hP2⟩
      have hsq1 : IsSquare (algebraMap K (v₀.adicCompletion K) (r.1 : K)) := (hP_iff r.1).mp hP1
      have hsq2 : IsSquare (algebraMap K (v₀.adicCompletion K) (r.2 : K)) := (hP_iff r.2).mp hP2
      refine ⟨r, ⟨hr_V.1, hr_V.2.1, ?_, ?_⟩, rfl⟩
      · intro v hvS'
        rcases Finset.mem_insert.mp hvS' with rfl | hvS
        · dsimp [π'_kill]; rw [Function.update_self]
          exact Or.inl ⟨hsq1, hsq2⟩
        · have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hvS)
          dsimp [π'_kill]; rw [Function.update_of_ne hv_ne]
          exact hr_V.2.2.1 v hvS
      · intro v hvT hvS'
        exact hr_V.2.2.2 v hvT (fun hvS => hvS' (Finset.mem_insert_of_mem hvS))
  have hV_even : ∀ c ∈ V,
      (∃ x : Kˣ, sqCl x = c.1 ∧ EvenVal v₀ x) ∧
      (∃ y : Kˣ, sqCl y = c.2 ∧ EvenVal v₀ y) := by
    rintro c ⟨r, hr, rfl⟩
    exact ⟨⟨r.1, rfl, (hr.2.2.2 v₀ hv₀T hv₀S).1⟩,
           ⟨r.2, rfl, (hr.2.2.2 v₀ hv₀T hv₀S).2⟩⟩
  have hP_mul_sq : ∀ (u : Kˣ) (c : SqCl K),
      IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
      (P (sqCl u * c) ↔ P c) := by
    intro u c hu_sq
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective c
    change P (sqCl u * sqCl x) ↔ P (sqCl x)
    rw [← hsqCl_mul, hP_iff, hP_iff]
    exact hsq_mul_iff u x hu_sq
  have hP_mul_nonsq : ∀ (u : Kˣ) (c : SqCl K),
      EvenVal v₀ u →
      ¬ IsSquare (algebraMap K (v₀.adicCompletion K) (u : K)) →
      (∃ x : Kˣ, sqCl x = c ∧ EvenVal v₀ x) →
      (P (sqCl u * c) ↔ ¬ P c) := by
    rintro u c hu_ev hu_nonsq ⟨x, rfl, hx_ev⟩
    rw [← hsqCl_mul, hP_iff, hP_iff]
    exact hnonsq_mul_iff u x hu_ev hx_ev hu_nonsq
  have hcard' : (selmerStruct K a₁ a₂ a₃ T S'_kill π'_kill).encard = 4 ^ n := by
    refine h_coset_card V (selmerStruct K a₁ a₂ a₃ T S'_kill π'_kill) P
      (sqCl u₁.1, sqCl u₁.2) (sqCl u₂.1, sqCl u₂.2) hcard hV_mul ⟨u₁, hu₁_mem, rfl⟩ ⟨u₂, hu₂_mem, rfl⟩
      hW_iff ?_ ?_
    · intro c hcV
      obtain ⟨hc1_ev, _⟩ := hV_even c hcV
      exact ⟨hP_mul_nonsq u₁.1 c.1 hu₁_ev1 hu₁_nonsq1 hc1_ev,
             hP_mul_sq u₁.2 c.2 hu₁_sq2⟩
    · intro c hcV
      obtain ⟨_, hc2_ev⟩ := hV_even c hcV
      exact ⟨hP_mul_sq u₂.1 c.1 hu₂_sq1,
             hP_mul_nonsq u₂.2 c.2 hu₂_ev2 hu₂_nonsq2 hc2_ev⟩
  refine ⟨S'_kill, S'_pad, π'_kill, κ'_pad,
    hS'₂_kill.trans (Finset.subset_insert v₀ S_kill),
    Finset.insert_subset_iff.mpr ⟨hv₀_mem, hkill_pad.trans hpad_sub⟩,
    hdisj'_pad, hprin'_pad, ?_, ?_, hπ', ?_, hcard'⟩
  · intro k v hv'_pad hv_ne
    by_cases hv_pad : v ∈ S_pad
    · exact hsq_pad k v hv_pad hv_ne
    · exact hsq_new k v hv'_pad hv_pad
  · intro v hvS'₂
    have hv_ne : v ≠ v₀ := fun h => hv₀S (h ▸ hS'₂_kill hvS'₂)
    dsimp [π'_kill]
    rw [Function.update_of_ne hv_ne]
    exact hπ_eq v hvS'₂
  · intro c hcW
    exact hsel_sub ((hW_iff c).mp hcW).1

theorem exists_killed_auxiliary_primes (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₂ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₂ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₂ : Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₂ : IsCleanSelmerState K a₁ a₂ a₃ T S₂ π₂ κ₂) :
    ∃ (S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π₃ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ₃ : Kˣ)
      (p : Fin 6 → Kˣ)
      (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭 :=
by
  have hmul : IsLocalMulClosed K a₁ a₂ a₃ := selmer_local_mul_closure K a₁ a₂ a₃ τ hstart
  obtain ⟨p, 𝔭, hraw⟩ := exists_raw_auxiliary_primes K a₁ a₂ a₃ τ T S₂ hstart hT hS₂.1.1
  have hrec : IsAuxPrimeReciprocity K a₁ a₂ a₃ p 𝔭 :=
    reciprocity_of_auxiliary_primes K a₁ a₂ a₃ τ T S₂ p 𝔭 hstart hT hraw
  obtain ⟨S'₂, π'₂, κ'₂, m, hadj, hm⟩ :=
    exists_adjoined_auxiliary_prime_state K a₁ a₂ a₃ τ T S₂ π₂ κ₂ p 𝔭 hstart hT hS₂.1 hraw hrec
  have hspan : ∀ x₁ x₂ : Kˣ,
      (sqCl x₁, sqCl x₂) ∈ selmerStruct K a₁ a₂ a₃ T S'₂ π'₂ →
      (sqCl x₁, sqCl x₂) ≠ 1 →
      NotInAuxSpan K p x₁ ∧ NotInAuxSpan K p x₂ ∧ NotInAuxSpan K p (x₁ * x₂) :=
    notInAuxSpan_of_mem_selmerStruct_aux K a₁ a₂ a₃ τ T S₂ S'₂ π₂ π'₂ κ₂ κ'₂ p 𝔭
      hstart hT hS₂ hraw hrec hadj hmul
  have hext : HasPrincipalAuxSquareExtension K T p :=
    hasPrincipalAuxSquareExtension_of_chebotarev K T p
  have h_ind : ∀ n : ℕ,
      (∃ S_kill S_pad π_kill κ_pad,
        IsAuxDropLoopState K a₁ a₂ a₃ T S'₂ S_kill S_pad π'₂ π_kill κ_pad p 𝔭 n) →
      ∃ S_kill S_pad π_kill κ_pad,
        IsAuxDropLoopState K a₁ a₂ a₃ T S'₂ S_kill S_pad π'₂ π_kill κ_pad p 𝔭 0 := by
    intro n
    induction n with
    | zero => exact id
    | succ n ih =>
      rintro ⟨S_kill, S_pad, π_kill, κ_pad, hstate⟩
      exact ih (selmerStruct_aux_drop_step K a₁ a₂ a₃ τ T S'₂ S_kill S_pad π'₂ π_kill κ_pad p 𝔭 n
        hstart hT hmul hspan hext hstate)
  have hstate_m : IsAuxDropLoopState K a₁ a₂ a₃ T S'₂ S'₂ S'₂ π'₂ π'₂ κ'₂ p 𝔭 m := by
    rcases hraw with ⟨_, _, _, _, _, _, _, _, _, hp_sq_S₂, _⟩
    rcases hadj with ⟨_, _, hS'₂_S₂, hdisj'₂, _, hπ'₂_unif, hprin'₂, _, _, _⟩
    refine ⟨Finset.Subset.refl S'₂, Finset.Subset.refl S'₂, hdisj'₂, hprin'₂,
      ?_, fun _ _ => rfl, hπ'₂_unif, Set.Subset.refl _, hm⟩
    intro k v hvS'₂ hvne
    exact hp_sq_S₂ k v (hS'₂_S₂ v hvS'₂ hvne)
  obtain ⟨S_kill, S₃, π_kill, κ₃, hstate₀⟩ := h_ind m ⟨S'₂, S'₂, π'₂, κ'₂, hstate_m⟩
  rcases hstate₀ with ⟨hS'₂_kill, hkill_pad, hdisj₃, hprin₃, hsq₃, hπ_kill_eq, hπ_kill_unif,
    _, hcard₀⟩
  rcases hraw with ⟨h𝔭_inj, _, hp_int, hp_val_𝔭, hp_val_ne, hp_sign1, hp_sign2,
    hp_sign_other, hp_sq_T, _, _⟩
  rcases hadj with ⟨_, h𝔭_S'₂, _, _, _, _, _, hram_u, _, hcard_one⟩
  rw [pow_zero] at hcard₀
  have hsel_kill : ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S_kill π_kill, c = 1 :=
    hcard_one S_kill π_kill hcard₀
  obtain ⟨π₃, hπ₃_eq, hπ₃_unif, hsel₃⟩ :=
    exists_non_growing_uniformizer_finset_of_selmer_trivial K a₁ a₂ a₃ τ T S_kill S₃ π_kill
      hstart hT hkill_pad hdisj₃ hπ_kill_unif hsel_kill
  refine ⟨S₃, π₃, κ₃, p, 𝔭, ⟨hdisj₃, hπ₃_unif, hprin₃, hsel₃⟩,
    h𝔭_inj, fun k => hkill_pad (hS'₂_kill (h𝔭_S'₂ k)),
    hp_int, hp_val_𝔭, hp_val_ne, hp_sign1, hp_sign2,
    hp_sign_other, hp_sq_T, hsq₃, hrec.1, ?_⟩
  intro k u hu hnsq
  have h_unif_eq : π₃ (𝔭 k) = π'₂ (𝔭 k) := by
    rw [hπ₃_eq (𝔭 k) (hS'₂_kill (h𝔭_S'₂ k)), hπ_kill_eq (𝔭 k) (h𝔭_S'₂ k)]
  rw [h_unif_eq]
  exact hram_u k u hu hnsq

theorem exists_crt_target_for_basis_prime (K : Type u) [Field K] [NumberField K]
    (v₁ v₂ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (u₁ u₂ : NumberField.RingOfIntegers K)
    (hv₁₂ : v₁ ≠ v₂)
    (hv₁F : v₁ ∉ F) (hv₂F : v₂ ∉ F)
    (h2₁ : (2 : NumberField.RingOfIntegers K) ∉ v₁.asIdeal)
    (h2₂ : (2 : NumberField.RingOfIntegers K) ∉ v₂.asIdeal)
    (hu₁ : u₁ ∉ v₁.asIdeal) (hu₂ : u₂ ∉ v₂.asIdeal) :
    ∃ (q_mod : Ideal (NumberField.RingOfIntegers K))
      (α : NumberField.RingOfIntegers K),
      q_mod ≠ 0 ∧
      IsUnit (Ideal.Quotient.mk q_mod α) ∧
      ∀ π : NumberField.RingOfIntegers K, π - α ∈ q_mod →
        π - u₁ ∈ v₁.asIdeal ∧
        π - u₂ ∈ v₂.asIdeal ∧
        (∀ w ∈ F, ∃ z ∈ w.asIdeal, π = 1 + 4 * z) ∧
        π ∉ v₁.asIdeal ∧
        π ∉ v₂.asIdeal ∧
        (∀ w ∈ F, π ∉ w.asIdeal) :=
by
  let I₁ : Ideal (NumberField.RingOfIntegers K) := v₁.asIdeal
  let I₂ : Ideal (NumberField.RingOfIntegers K) := v₂.asIdeal
  let I₃ : Ideal (NumberField.RingOfIntegers K) :=
    Ideal.span {(4 : NumberField.RingOfIntegers K)} * ∏ w ∈ F, w.asIdeal
  let q_mod : Ideal (NumberField.RingOfIntegers K) := I₁ * I₂ * I₃
  have hI₁_ne : I₁ ≠ 0 := v₁.ne_bot
  have hI₂_ne : I₂ ≠ 0 := v₂.ne_bot
  have h4_ne : (4 : NumberField.RingOfIntegers K) ≠ 0 := by norm_num
  have hspan4_ne : Ideal.span {(4 : NumberField.RingOfIntegers K)} ≠ 0 :=
    Ideal.span_singleton_eq_bot.not.mpr h4_ne
  have hprod_ne : (∏ w ∈ F, w.asIdeal) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun w _ => w.ne_bot)
  have hI₃_ne : I₃ ≠ 0 := mul_ne_zero hspan4_ne hprod_ne
  have hq_mod : q_mod ≠ 0 := mul_ne_zero (mul_ne_zero hI₁_ne hI₂_ne) hI₃_ne
  have hcop_max_span :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (x : NumberField.RingOfIntegers K),
        x ∉ v.asIdeal → IsCoprime v.asIdeal (Ideal.span {x}) := by
    intro v x hx
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    have h_eq : v.asIdeal = v.asIdeal ⊔ Ideal.span {x} :=
      v.isMaximal.eq_of_le h_ne_top le_sup_left
    have hx_le : Ideal.span {x} ≤ v.asIdeal := by
      calc Ideal.span {x} ≤ v.asIdeal ⊔ Ideal.span {x} := le_sup_right
        _ = v.asIdeal := h_eq.symm
    exact hx (hx_le (Ideal.mem_span_singleton_self x))
  have hI₁₂_ne : I₁ ≠ I₂ := fun h => hv₁₂ (IsDedekindDomain.HeightOneSpectrum.ext h)
  have hcop_12 : IsCoprime I₁ I₂ :=
    @Ideal.isCoprime_of_isMaximal _ _ _ _ v₁.isMaximal v₂.isMaximal hI₁₂_ne
  have h4₁ : (4 : NumberField.RingOfIntegers K) ∉ I₁ := by
    intro h4
    have h22 : (2 : NumberField.RingOfIntegers K) * 2 ∈ v₁.asIdeal := by
      have : (2 : NumberField.RingOfIntegers K) * 2 = 4 := by norm_num
      rw [this]
      exact h4
    rcases v₁.isPrime.mul_mem_iff_mem_or_mem.mp h22 with h | h <;> exact h2₁ h
  have h4₂ : (4 : NumberField.RingOfIntegers K) ∉ I₂ := by
    intro h4
    have h22 : (2 : NumberField.RingOfIntegers K) * 2 ∈ v₂.asIdeal := by
      have : (2 : NumberField.RingOfIntegers K) * 2 = 4 := by norm_num
      rw [this]
      exact h4
    rcases v₂.isPrime.mul_mem_iff_mem_or_mem.mp h22 with h | h <;> exact h2₂ h
  have hcop_1_span4 : IsCoprime I₁ (Ideal.span {(4 : NumberField.RingOfIntegers K)}) :=
    hcop_max_span v₁ 4 h4₁
  have hcop_2_span4 : IsCoprime I₂ (Ideal.span {(4 : NumberField.RingOfIntegers K)}) :=
    hcop_max_span v₂ 4 h4₂
  have hcop_1_prod : IsCoprime I₁ (∏ w ∈ F, w.asIdeal) := by
    apply IsCoprime.prod_right
    intro w hw
    have hv₁w : v₁ ≠ w := by rintro rfl; exact hv₁F hw
    have hIw : I₁ ≠ w.asIdeal := fun h => hv₁w (IsDedekindDomain.HeightOneSpectrum.ext h)
    exact @Ideal.isCoprime_of_isMaximal _ _ _ _ v₁.isMaximal w.isMaximal hIw
  have hcop_2_prod : IsCoprime I₂ (∏ w ∈ F, w.asIdeal) := by
    apply IsCoprime.prod_right
    intro w hw
    have hv₂w : v₂ ≠ w := by rintro rfl; exact hv₂F hw
    have hIw : I₂ ≠ w.asIdeal := fun h => hv₂w (IsDedekindDomain.HeightOneSpectrum.ext h)
    exact @Ideal.isCoprime_of_isMaximal _ _ _ _ v₂.isMaximal w.isMaximal hIw
  have hcop_13 : IsCoprime I₁ I₃ := hcop_1_span4.mul_right hcop_1_prod
  have hcop_23 : IsCoprime I₂ I₃ := hcop_2_span4.mul_right hcop_2_prod
  have hcop_12_3 : IsCoprime (I₁ * I₂) I₃ := hcop_13.mul_left hcop_23
  obtain ⟨a₁, ha₁, a₂, ha₂, ha₁₂⟩ := Ideal.isCoprime_iff_exists.mp hcop_12
  let α₁₂ : NumberField.RingOfIntegers K := u₁ * a₂ + u₂ * a₁
  have hα₁₂_1 : α₁₂ - u₁ ∈ I₁ := by
    have h_eq : α₁₂ - u₁ = (u₂ - u₁) * a₁ := by
      dsimp [α₁₂]; linear_combination u₁ * ha₁₂
    rw [h_eq]
    exact Ideal.mul_mem_left I₁ (u₂ - u₁) ha₁
  have hα₁₂_2 : α₁₂ - u₂ ∈ I₂ := by
    have h_eq : α₁₂ - u₂ = (u₁ - u₂) * a₂ := by
      dsimp [α₁₂]; linear_combination u₂ * ha₁₂
    rw [h_eq]
    exact Ideal.mul_mem_left I₂ (u₁ - u₂) ha₂
  obtain ⟨b₁₂, hb₁₂, b₃, hb₃, hb⟩ := Ideal.isCoprime_iff_exists.mp hcop_12_3
  let α : NumberField.RingOfIntegers K := α₁₂ * b₃ + b₁₂
  have hb₁₂_1 : b₁₂ ∈ I₁ := Ideal.mul_le_right hb₁₂
  have hb₁₂_2 : b₁₂ ∈ I₂ := Ideal.mul_le_left hb₁₂
  have hα_1 : α - u₁ ∈ I₁ := by
    have h_eq : α - u₁ = (α₁₂ - u₁) + (1 - α₁₂) * b₁₂ := by
      dsimp [α]; linear_combination α₁₂ * hb
    rw [h_eq]
    exact Ideal.add_mem I₁ hα₁₂_1 (Ideal.mul_mem_left I₁ (1 - α₁₂) hb₁₂_1)
  have hα_2 : α - u₂ ∈ I₂ := by
    have h_eq : α - u₂ = (α₁₂ - u₂) + (1 - α₁₂) * b₁₂ := by
      dsimp [α]; linear_combination α₁₂ * hb
    rw [h_eq]
    exact Ideal.add_mem I₂ hα₁₂_2 (Ideal.mul_mem_left I₂ (1 - α₁₂) hb₁₂_2)
  have hα_3 : α - 1 ∈ I₃ := by
    have h_eq : α - 1 = (α₁₂ - 1) * b₃ := by
      dsimp [α]; linear_combination hb
    rw [h_eq]
    exact Ideal.mul_mem_left I₃ (α₁₂ - 1) hb₃
  have hα_not_1 : α ∉ I₁ := by
    intro hα_in
    apply hu₁
    have h_eq : u₁ = α - (α - u₁) := by ring
    rw [h_eq]
    exact Ideal.sub_mem I₁ hα_in hα_1
  have hα_not_2 : α ∉ I₂ := by
    intro hα_in
    apply hu₂
    have h_eq : u₂ = α - (α - u₂) := by ring
    rw [h_eq]
    exact Ideal.sub_mem I₂ hα_in hα_2
  have hcop_α1 : IsCoprime (Ideal.span {α}) I₁ := (hcop_max_span v₁ α hα_not_1).symm
  have hcop_α2 : IsCoprime (Ideal.span {α}) I₂ := (hcop_max_span v₂ α hα_not_2).symm
  have hcop_α3 : IsCoprime (Ideal.span {α}) I₃ := by
    rw [Ideal.isCoprime_iff_exists]
    refine ⟨α, Ideal.mem_span_singleton_self α, 1 - α, ?_, add_sub_cancel α 1⟩
    have h_eq : 1 - α = -(α - 1) := by ring
    rw [h_eq]
    exact Submodule.neg_mem I₃ hα_3
  have hcop_α_q : IsCoprime (Ideal.span {α}) q_mod :=
    (hcop_α1.mul_right hcop_α2).mul_right hcop_α3
  have hunit : IsUnit (Ideal.Quotient.mk q_mod α) := by
    obtain ⟨x, hx, y, hy, hxy⟩ := Ideal.isCoprime_iff_exists.mp hcop_α_q
    obtain ⟨β, hx_eq⟩ := Ideal.mem_span_singleton.mp hx
    apply IsUnit.of_mul_eq_one (Ideal.Quotient.mk q_mod β)
    rw [← map_mul, ← map_one (Ideal.Quotient.mk q_mod), Ideal.Quotient.eq]
    have h_eq : α * β - 1 = -y := by linear_combination -hx_eq + hxy
    rw [h_eq]
    exact Submodule.neg_mem q_mod hy
  refine ⟨q_mod, α, hq_mod, hunit, ?_⟩
  intro π hπ
  have hq_le_12 : q_mod ≤ I₁ * I₂ := Ideal.mul_le_right
  have hq_le_1 : q_mod ≤ I₁ := hq_le_12.trans Ideal.mul_le_right
  have hq_le_2 : q_mod ≤ I₂ := hq_le_12.trans Ideal.mul_le_left
  have hq_le_3 : q_mod ≤ I₃ := Ideal.mul_le_left
  have hπ_1 : π - u₁ ∈ v₁.asIdeal := by
    have h_eq : π - u₁ = (π - α) + (α - u₁) := by ring
    rw [h_eq]
    exact Ideal.add_mem I₁ (hq_le_1 hπ) hα_1
  have hπ_2 : π - u₂ ∈ v₂.asIdeal := by
    have h_eq : π - u₂ = (π - α) + (α - u₂) := by ring
    rw [h_eq]
    exact Ideal.add_mem I₂ (hq_le_2 hπ) hα_2
  have hπ_3 : π - 1 ∈ I₃ := by
    have h_eq : π - 1 = (π - α) + (α - 1) := by ring
    rw [h_eq]
    exact Ideal.add_mem I₃ (hq_le_3 hπ) hα_3
  have hπ_F : ∀ w ∈ F, ∃ z ∈ w.asIdeal, π = 1 + 4 * z := by
    intro w hw
    have hprod_le_w : (∏ v ∈ F, v.asIdeal) ≤ w.asIdeal :=
      Ideal.prod_le_inf.trans (Finset.inf_le hw)
    have hI₃_le_w : I₃ ≤ Ideal.span {(4 : NumberField.RingOfIntegers K)} * w.asIdeal :=
      Ideal.mul_mono_right hprod_le_w
    obtain ⟨z, hz, hz_eq⟩ := Ideal.mem_span_singleton_mul.mp (hI₃_le_w hπ_3)
    refine ⟨z, hz, ?_⟩
    linear_combination -hz_eq
  have hπ_not_1 : π ∉ v₁.asIdeal := by
    intro hπ_in
    apply hu₁
    have h_eq : u₁ = π - (π - u₁) := by ring
    rw [h_eq]
    exact Ideal.sub_mem v₁.asIdeal hπ_in hπ_1
  have hπ_not_2 : π ∉ v₂.asIdeal := by
    intro hπ_in
    apply hu₂
    have h_eq : u₂ = π - (π - u₂) := by ring
    rw [h_eq]
    exact Ideal.sub_mem v₂.asIdeal hπ_in hπ_2
  have hπ_not_F : ∀ w ∈ F, π ∉ w.asIdeal := by
    intro w hw hπ_in_w
    obtain ⟨z, hz, hπ_eq⟩ := hπ_F w hw
    have h4z : 4 * z ∈ w.asIdeal := Ideal.mul_mem_left w.asIdeal 4 hz
    have h1_in : (1 : NumberField.RingOfIntegers K) ∈ w.asIdeal := by
      have h_eq : (1 : NumberField.RingOfIntegers K) = π - 4 * z := by
        linear_combination -hπ_eq
      rw [h_eq]
      exact Ideal.sub_mem w.asIdeal hπ_in_w h4z
    exact w.isPrime.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_in)
  exact ⟨hπ_1, hπ_2, hπ_F, hπ_not_1, hπ_not_2, hπ_not_F⟩

theorem exists_totally_positive_prime_of_mitsui (K : Type u) [Field K] [NumberField K]
    (q_mod : Ideal (NumberField.RingOfIntegers K))
    (α : NumberField.RingOfIntegers K)
    (hq_mod : q_mod ≠ 0)
    (hunit : IsUnit (Ideal.Quotient.mk q_mod α)) :
    ∃ (π : NumberField.RingOfIntegers K)
      (q₀ : Kˣ)
      (𝔮₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      π - α ∈ q_mod ∧
      (π : K) = (q₀ : K) ∧
      IsIntegral ℤ (q₀ : K) ∧
      𝔮₀.asIdeal = Ideal.span {π} ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K 𝔮₀ (q₀ : K) = WithZero.exp (-1 : ℤ) ∧
      (∀ v, v ≠ 𝔮₀ → IsDedekindDomain.HeightOneSpectrum.valuation K v (q₀ : K) = 1) ∧
      (∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, 0 < realPlaceEmb w (q₀ : K)) :=
by
  classical
  letI : MulAction ℝ (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.mulActionSet
  let C_pos : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    (Set.univ.pi (fun _ => Set.Ioo (1 / 4 : ℝ) (3 / 4 : ℝ))) ×ˢ
    (Set.univ.pi (fun _ => Metric.ball (0 : ℂ) (3 / 4 : ℝ)))
  have hconv : Convex ℝ C_pos := by
    apply Convex.prod
    · apply convex_pi
      intro w _
      exact convex_Ioo _ _
    · apply convex_pi
      intro w _
      exact convex_ball _ _
  have hopen : IsOpen C_pos := by
    apply IsOpen.prod
    · apply isOpen_set_pi (Set.toFinite Set.univ)
      intro w _
      exact isOpen_Ioo
    · apply isOpen_set_pi (Set.toFinite Set.univ)
      intro w _
      exact Metric.isOpen_ball
  have hbdd : Bornology.IsBounded C_pos := by
    apply Bornology.IsBounded.prod
    · rw [Bornology.isBounded_pi]
      right
      intro w
      exact Metric.isBounded_Ioo _ _
    · rw [Bornology.isBounded_pi]
      right
      intro w
      exact Metric.isBounded_ball
  have hne_C_pos : C_pos.Nonempty := by
    refine ⟨(fun _ => (1 / 2 : ℝ), fun _ => (0 : ℂ)), ?_, ?_⟩
    · intro w _
      dsimp
      constructor <;> norm_num
    · intro w _
      exact Metric.mem_ball_self (by norm_num)
  have hv₀ : 0 < (MeasureTheory.volume C_pos).toReal := by
    have hpos : 0 < MeasureTheory.volume C_pos :=
      IsOpen.measure_pos MeasureTheory.volume hopen hne_C_pos
    have hlt : MeasureTheory.volume C_pos < ⊤ :=
      Bornology.IsBounded.measure_lt_top hbdd
    exact ENNReal.toReal_pos (ne_of_gt hpos) (ne_of_lt hlt)
  have hnorm1 : ∀ u ∈ C_pos, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w u < 1 := by
    intro u hu w
    by_cases hw : w.IsReal
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw u]
      have hu1 := hu.1 ⟨w, hw⟩ (Set.mem_univ _)
      dsimp at hu1
      rw [Real.norm_eq_abs, abs_lt]
      exact ⟨by linarith [hu1.1], by linarith [hu1.2]⟩
    · have hwc : w.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw
      rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hwc u]
      have hu2 := hu.2 ⟨w, hwc⟩ (Set.mem_univ _)
      dsimp at hu2
      rw [mem_ball_zero_iff] at hu2
      linarith
  have hC_pos_scale : ∀ X : ℝ, 0 < X →
      Convex ℝ (X • C_pos) ∧
      IsOpen (X • C_pos) ∧
      (∀ z ∈ X • C_pos, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X) ∧
      (MeasureTheory.volume (X • C_pos)).toReal =
        X ^ (Module.finrank ℚ K) * (MeasureTheory.volume C_pos).toReal := by
    intro X hX
    refine ⟨Convex.smul hconv X, IsOpen.smul₀ hopen (ne_of_gt hX), ?_, ?_⟩
    · intro z hz w
      rw [Set.mem_smul_set] at hz
      rcases hz with ⟨u, hu, rfl⟩
      rw [NumberField.mixedEmbedding.normAtPlace_smul w u X, abs_of_pos hX]
      exact mul_lt_of_lt_one_right hX (hnorm1 u hu w)
    · rw [MeasureTheory.Measure.addHaar_smul MeasureTheory.volume X C_pos,
        NumberField.mixedEmbedding.finrank K]
      have hXpow : 0 < X ^ (Module.finrank ℚ K) := pow_pos hX _
      rw [abs_of_pos hXpow, ENNReal.toReal_mul, ENNReal.toReal_ofReal (le_of_lt hXpow)]
  have hC_pos_sign : ∀ (X : ℝ) (x : K), 0 < X →
      NumberField.mixedEmbedding K x ∈ X • C_pos →
      ∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, 0 < realPlaceEmb w x := by
    intro X x hX hx w
    rw [Set.mem_smul_set] at hx
    rcases hx with ⟨u, hu, hxu⟩
    have h1 : realPlaceEmb w x = (NumberField.mixedEmbedding K x).1 w :=
      (NumberField.mixedEmbedding.mixedEmbedding_apply_isReal K x w).symm
    have hreal : realPlaceEmb w x = X * u.1 w := by
      rw [h1, ← hxu]
      rfl
    rw [hreal]
    have huw := hu.1 w (Set.mem_univ _)
    dsimp at huw
    exact mul_pos hX (by linarith [huw.1])
  obtain ⟨κ, c, hc, hκ, hmitsui⟩ := mitsui_prime_ideal (K := K) 2 (by norm_num)
  have hκq : 0 < κ q_mod := hκ q_mod hq_mod
  let v₀ : ℝ := (MeasureTheory.volume C_pos).toReal
  let Nq : ℝ := (Ideal.absNorm q_mod : ℝ)
  let t : ℝ := max 1 (max (Nq + 1) (2 * c ^ 2 / (κ q_mod * v₀) + 1))
  have ht1 : 1 ≤ t := le_max_left _ _
  have htNq : Nq + 1 ≤ t := le_trans (le_max_left _ _) (le_max_right _ _)
  have htc : 2 * c ^ 2 / (κ q_mod * v₀) + 1 ≤ t := le_trans (le_max_right _ _) (le_max_right _ _)
  have ht_pos : 0 < t := by linarith
  let X : ℝ := Real.exp (t ^ 2)
  have hX1 : 1 < X := Real.one_lt_exp_iff.mpr (by positivity)
  have hX_pos : 0 < X := by linarith
  have hlogX : Real.log X = t ^ 2 := Real.log_exp (t ^ 2)
  have hNq_lt : (Ideal.absNorm q_mod : ℝ) < Real.log X ^ (2 : ℕ) := by
    rw [hlogX]
    have ht2 : 1 ≤ t ^ 2 := by nlinarith [ht1]
    have ht_le_t4 : t ≤ (t ^ 2) ^ 2 := by nlinarith [ht1, ht2]
    linarith
  have hsqrt : Real.sqrt (Real.log X) = t := by
    rw [hlogX, Real.sqrt_sq (le_of_lt ht_pos)]
  have herr_small : c * Real.exp (-Real.sqrt (Real.log X) / c) < κ q_mod * v₀ / 2 := by
    rw [hsqrt, neg_div, Real.exp_neg]
    have hkv_pos : 0 < κ q_mod * v₀ := mul_pos hκq hv₀
    have hexp_pos : 0 < Real.exp (t / c) := Real.exp_pos (t / c)
    have h_div_lt : 2 * c ^ 2 / (κ q_mod * v₀) < t := by linarith
    have h_tc_gt : 2 * c / (κ q_mod * v₀) < t / c := by
      have h1 : 2 * c / (κ q_mod * v₀) * c < t := by
        calc 2 * c / (κ q_mod * v₀) * c = 2 * c ^ 2 / (κ q_mod * v₀) := by ring
        _ < t := h_div_lt
      exact (lt_div_iff₀ hc).mpr h1
    have hexp_gt : 2 * c / (κ q_mod * v₀) < Real.exp (t / c) := by
      have h_add := Real.add_one_le_exp (t / c)
      linarith
    have h_mul : c < (κ q_mod * v₀ / 2) * Real.exp (t / c) := by
      have h2 : (κ q_mod * v₀ / 2) * (2 * c / (κ q_mod * v₀)) < (κ q_mod * v₀ / 2) * Real.exp (t / c) :=
        mul_lt_mul_of_pos_left hexp_gt (by positivity)
      have hkv_ne : κ q_mod * v₀ ≠ 0 := ne_of_gt hkv_pos
      have h3 : (κ q_mod * v₀ / 2) * (2 * c / (κ q_mod * v₀)) = c := by
        calc (κ q_mod * v₀ / 2) * (2 * c / (κ q_mod * v₀))
          _ = c * ((κ q_mod * v₀) / (κ q_mod * v₀)) := by ring
          _ = c * 1 := by rw [div_self hkv_ne]
          _ = c := mul_one c
      linarith
    calc c * (Real.exp (t / c))⁻¹ = c / Real.exp (t / c) := div_eq_mul_inv c _ |>.symm
      _ < κ q_mod * v₀ / 2 := (div_lt_iff₀ hexp_pos).mpr h_mul
  obtain ⟨hconv_X, hopen_X, hnorm_X, hvol_X⟩ := hC_pos_scale X hX_pos
  have hbound := hmitsui X hX1 (X • C_pos) hconv_X hopen_X hnorm_X q_mod hq_mod hNq_lt α hunit
  let S_X := {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ X • C_pos ∧ π - α ∈ q_mod}
  let S_sum : ℝ := ∑' π : S_X,
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  change |S_sum - κ q_mod * (MeasureTheory.volume (X • C_pos)).toReal| ≤
      c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) at hbound
  rw [hvol_X] at hbound
  have hXpow : 0 < X ^ (Module.finrank ℚ K) := pow_pos hX_pos _
  have hS_pos : 0 < S_sum := by
    have hlow := (abs_sub_le_iff.mp hbound).2
    have h_diff : c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) <
        (κ q_mod * v₀ / 2) * X ^ (Module.finrank ℚ K) := by
      calc c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c)
        _ = (c * Real.exp (-Real.sqrt (Real.log X) / c)) * X ^ (Module.finrank ℚ K) := by ring
        _ < (κ q_mod * v₀ / 2) * X ^ (Module.finrank ℚ K) := mul_lt_mul_of_pos_right herr_small hXpow
    have hmain_pos : 0 < (κ q_mod * v₀ / 2) * X ^ (Module.finrank ℚ K) := by positivity
    linarith
  have hne_S : Nonempty S_X := by
    by_contra hemp
    rw [not_nonempty_iff] at hemp
    have hzero : S_sum = 0 := by
      dsimp [S_sum]
      exact tsum_empty
    linarith
  obtain ⟨⟨π, hπ_prime, hπ_mem, hπ_mod⟩⟩ := hne_S
  have hπ_ne : π ≠ 0 := hπ_prime.ne_zero
  have hπK_ne : (π : K) ≠ 0 := by
    intro h0
    exact hπ_ne (by exact_mod_cast h0)
  let q₀ : Kˣ := Units.mk0 (π : K) hπK_ne
  have hπ_coe : (π : K) = (q₀ : K) := rfl
  have hq₀_int : IsIntegral ℤ (q₀ : K) := NumberField.RingOfIntegers.isIntegral_coe π
  let 𝔮₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    ⟨Ideal.span {π}, (Ideal.span_singleton_prime hπ_ne).mpr hπ_prime,
      Ideal.span_singleton_eq_bot.not.mpr hπ_ne⟩
  have h𝔮₀_span : 𝔮₀.asIdeal = Ideal.span {π} := rfl
  have hq₀_val_eq : IsDedekindDomain.HeightOneSpectrum.valuation K 𝔮₀ (q₀ : K) =
      WithZero.exp (-1 : ℤ) := by
    have hval_eq : IsDedekindDomain.HeightOneSpectrum.valuation K 𝔮₀ (q₀ : K) =
        𝔮₀.intValuation π :=
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap 𝔮₀ π
    rw [hval_eq]
    have hdvd1 : 𝔮₀.asIdeal ^ 1 ∣ Ideal.span {π} := by
      rw [pow_one, ← h𝔮₀_span]
    have hndvd2 : ¬ (𝔮₀.asIdeal ^ 2 ∣ Ideal.span {π}) := by
      rw [sq, ← h𝔮₀_span]
      intro hdvd
      have hdvd' : 𝔮₀.asIdeal * 𝔮₀.asIdeal ∣ 𝔮₀.asIdeal * 1 := by simpa using hdvd
      have h1 : 𝔮₀.asIdeal ∣ 1 := (mul_dvd_mul_iff_left 𝔮₀.ne_bot).mp hdvd'
      rw [Ideal.dvd_iff_le, Ideal.one_eq_top] at h1
      exact 𝔮₀.isPrime.ne_top (top_le_iff.mp h1)
    have hle1 : 𝔮₀.intValuation π ≤ WithZero.exp (-(1 : ℕ) : ℤ) :=
      (𝔮₀.intValuation_le_pow_iff_dvd π 1).mpr hdvd1
    have hnle2 : ¬ (𝔮₀.intValuation π ≤ WithZero.exp (-(2 : ℕ) : ℤ)) :=
      mt (𝔮₀.intValuation_le_pow_iff_dvd π 2).mp hndvd2
    have hne0 : 𝔮₀.intValuation π ≠ 0 :=
      𝔮₀.intValuation_ne_zero' ⟨π, mem_nonZeroDivisors_of_ne_zero hπ_ne⟩
    obtain ⟨z, hz⟩ := WithZero.ne_zero_iff_exists.mp hne0
    rw [← hz] at hle1 hnle2 ⊢
    change WithZero.exp (Multiplicative.toAdd z) ≤ WithZero.exp (-1 : ℤ) at hle1
    change ¬ (WithZero.exp (Multiplicative.toAdd z) ≤ WithZero.exp (-2 : ℤ)) at hnle2
    rw [WithZero.exp_le_exp] at hle1 hnle2
    have hz_eq : Multiplicative.toAdd z = -1 := by omega
    rw [← hz_eq]
    rfl
  have hq₀_val_ne : ∀ v, v ≠ 𝔮₀ →
      IsDedekindDomain.HeightOneSpectrum.valuation K v (q₀ : K) = 1 := by
    intro v hv
    have hval_eq : IsDedekindDomain.HeightOneSpectrum.valuation K v (q₀ : K) =
        v.intValuation π :=
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap v π
    rw [hval_eq]
    have hndvd : ¬ (v.asIdeal ∣ Ideal.span {π}) := by
      rw [← h𝔮₀_span, Ideal.dvd_iff_le]
      intro hle
      have heq : 𝔮₀.asIdeal = v.asIdeal := 𝔮₀.isMaximal.eq_of_le v.isPrime.ne_top hle
      exact hv (IsDedekindDomain.HeightOneSpectrum.ext heq).symm
    have hnlt : ¬ (v.intValuation π < 1) :=
      mt (v.intValuation_lt_one_iff_dvd π).mp hndvd
    exact le_antisymm (v.intValuation_le_one π) (not_lt.mp hnlt)
  have hq₀_pos : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      0 < realPlaceEmb w (q₀ : K) :=
    hC_pos_sign X (π : K) hX_pos hπ_mem
  exact ⟨π, q₀, 𝔮₀, hπ_mod, hπ_coe, hq₀_int, h𝔮₀_span, hq₀_val_eq, hq₀_val_ne, hq₀_pos⟩

theorem isSquare_mul_and_not_isSquare_of_sub_mem (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (u q₀ : Kˣ)
    (u_int π : NumberField.RingOfIntegers K)
    (h2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1)
    (hu_coe : (u_int : K) = (u : K))
    (hπ_coe : (π : K) = (q₀ : K))
    (hu_not_mem : u_int ∉ v.asIdeal)
    (hsub : π - u_int ∈ v.asIdeal)
    (hu_nsq : ¬ IsSquare (algebraMap K (v.adicCompletion K) (u : K))) :
    ¬ IsSquare (algebraMap K (v.adicCompletion K) (q₀ : K)) ∧
    IsSquare (algebraMap K (v.adicCompletion K) ((u : K) * (q₀ : K))) :=
by
  let d : NumberField.RingOfIntegers K := π - u_int
  let u_bar : v.adicCompletion K := algebraMap K (v.adicCompletion K) (u : K)
  let q_bar : v.adicCompletion K := algebraMap K (v.adicCompletion K) (q₀ : K)
  let d_bar : v.adicCompletion K := algebraMap K (v.adicCompletion K) (d : K)
  let x : v.adicCompletion K := d_bar / u_bar
  have hd_val : Valued.v d_bar < 1 := by
    dsimp only [d_bar]
    erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v (d : K)]
    rw [v.valuation_of_algebraMap d]
    exact (v.intValuation_lt_one_iff_dvd d).mpr (Ideal.dvd_span_singleton.mpr hsub)
  have hu_val : Valued.v u_bar = 1 := by
    dsimp only [u_bar]
    rw [← hu_coe]
    erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v (u_int : K)]
    rw [v.valuation_of_algebraMap u_int]
    exact v.intValuation_eq_one_iff.mpr hu_not_mem
  have hu_bar_ne : u_bar ≠ 0 := by
    intro h0
    rw [h0, Valuation.map_zero] at hu_val
    exact zero_ne_one hu_val
  have hx : Valued.v x < 1 := by
    dsimp only [x]
    rw [Valuation.map_div, hu_val, div_one]
    exact hd_val
  have h1x_sq : IsSquare (1 + x) := by
    have hv2 : Valued.v (2 : v.adicCompletion K) = 1 := by
      rw [← map_ofNat (algebraMap K (v.adicCompletion K)) 2]
      erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v (2 : K)]
      exact h2
    have hv4 : Valued.v (4 : v.adicCompletion K) = 1 := by
      have h42 : (4 : v.adicCompletion K) = 2 * 2 := by norm_num
      rw [h42, Valuation.map_mul, hv2, mul_one]
    have h4_ne : (4 : v.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at hv4
      exact zero_ne_one hv4
    let z : v.adicCompletion K := (4 : v.adicCompletion K)⁻¹ * x
    have h1x : 1 + x = 1 + 4 * z := by
      dsimp only [z]
      rw [mul_inv_cancel_left₀ h4_ne]
    have hz_lt : Valued.v z < 1 := by
      dsimp only [z]
      rw [Valuation.map_mul, Valuation.map_inv, hv4, inv_one, one_mul]
      exact hx
    have hz_val : Valued.v z ≤ WithZero.exp (-1 : ℤ) := by
      by_cases hz0 : Valued.v z = 0
      · rw [hz0]
        exact zero_le'
      · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hz0
        rw [← hg] at hz_lt ⊢
        have hg_exp : (g : WithZero (Multiplicative ℤ)) = WithZero.exp (Multiplicative.toAdd g) := by
          rw [← ofAdd_toAdd g]
          rfl
        rw [hg_exp] at hz_lt ⊢
        rw [← WithZero.exp_zero] at hz_lt
        have hlt : Multiplicative.toAdd g < 0 := WithZero.exp_lt_exp.mp hz_lt
        exact WithZero.exp_le_exp.mpr (by omega)
    let e₁ : WithZero (Multiplicative ℤ) := WithZero.exp (-1 : ℤ)
    have he₁_le_one : e₁ ≤ 1 := by
      rw [← WithZero.exp_zero]
      exact WithZero.exp_le_exp.mpr (by omega)
    have hw_le : ∀ n : ℕ, Valued.v (henselSeq z n) ≤ e₁ := by
      intro n
      induction n with
      | zero =>
        simp only [henselSeq, Valuation.map_zero]
        exact zero_le'
      | succ n ih =>
        simp only [henselSeq]
        have hsq : Valued.v ((henselSeq z n) ^ 2) ≤ e₁ := by
          rw [sq, Valuation.map_mul]
          calc Valued.v (henselSeq z n) * Valued.v (henselSeq z n)
            _ ≤ e₁ * 1 := mul_le_mul' ih (le_trans ih he₁_le_one)
            _ = e₁ := mul_one e₁
        exact le_trans (Valuation.map_sub _ _ _) (max_le hz_val hsq)
    have hw_diff : ∀ n : ℕ, Valued.v (henselSeq z (n + 1) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
      intro n
      induction n with
      | zero =>
        have h0 : henselSeq z 1 - henselSeq z 0 = z := by
          simp [henselSeq]
        rw [h0]
        simpa using hz_val
      | succ n ih =>
        have hstep : henselSeq z (n + 2) - henselSeq z (n + 1) =
            -(henselSeq z (n + 1) + henselSeq z n) * (henselSeq z (n + 1) - henselSeq z n) := by
          simp only [henselSeq]
          ring
        have hsum : Valued.v (henselSeq z (n + 1) + henselSeq z n) ≤ e₁ :=
          le_trans (Valuation.map_add _ _ _) (max_le (hw_le (n + 1)) (hw_le n))
        rw [hstep, Valuation.map_mul, Valuation.map_neg]
        calc Valued.v (henselSeq z (n + 1) + henselSeq z n) * Valued.v (henselSeq z (n + 1) - henselSeq z n)
          _ ≤ WithZero.exp (-1 : ℤ) * WithZero.exp (-(n + 1 : ℤ)) := mul_le_mul' hsum ih
          _ = WithZero.exp ((-1 : ℤ) + -(n + 1 : ℤ)) := (WithZero.exp_add (-1 : ℤ) (-(n + 1 : ℤ))).symm
          _ = WithZero.exp (-((n + 1 : ℕ) + 1 : ℤ)) := by congr 1; push_cast; ring
    have hw_tele : ∀ n k : ℕ, Valued.v (henselSeq z (n + k) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
      intro n k
      induction k with
      | zero =>
        simp only [Nat.add_zero, sub_self, Valuation.map_zero]
        exact zero_le'
      | succ k ih =>
        have hsplit : henselSeq z (n + (k + 1)) - henselSeq z n =
            (henselSeq z (n + k + 1) - henselSeq z (n + k)) + (henselSeq z (n + k) - henselSeq z n) := by
          have hidx : n + (k + 1) = n + k + 1 := by omega
          rw [hidx]
          ring
        rw [hsplit]
        refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ih)
        refine le_trans (hw_diff (n + k)) ?_
        exact WithZero.exp_le_exp.mpr (by omega)
    have hw_symm : ∀ N a b : ℕ, N ≤ a → N ≤ b →
        Valued.v (henselSeq z b - henselSeq z a) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      intro N a b ha hb
      have ha' : Valued.v (henselSeq z a - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (a - N)
        rwa [Nat.add_sub_of_le ha] at h1
      have hb' : Valued.v (henselSeq z b - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
        have h1 := hw_tele N (b - N)
        rwa [Nat.add_sub_of_le hb] at h1
      have hsub : henselSeq z b - henselSeq z a =
          (henselSeq z b - henselSeq z N) - (henselSeq z a - henselSeq z N) := by ring
      rw [hsub]
      exact le_trans (Valuation.map_sub _ _ _) (max_le hb' ha')
    have hcauchy : CauchySeq (henselSeq z) := by
      rw [CauchySeq, Valued.cauchy_iff]
      refine ⟨Filter.map_neBot, ?_⟩
      intro γ
      obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp (Units.ne_zero γ)
      let m : ℤ := Multiplicative.toAdd g
      let N : ℕ := (-m).toNat
      have hlt : WithZero.exp (-(N + 1 : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← hg]
        change WithZero.exp (-(N + 1 : ℤ)) < WithZero.exp m
        exact WithZero.exp_lt_exp.mpr (by omega)
      refine ⟨(henselSeq z) '' Set.Ici N, Filter.image_mem_map (Filter.mem_atTop N), ?_⟩
      rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      exact lt_of_le_of_lt (hw_symm N a b ha hb) hlt
    obtain ⟨w_inf, hw_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
    have hw_shift : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds w_inf) :=
      (Filter.tendsto_add_atTop_iff_nat 1).mpr hw_lim
    have hw_rhs : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds (z - w_inf ^ 2)) := by
      have hfun : (fun n => henselSeq z (n + 1)) = (fun n => z - (henselSeq z n) ^ 2) := rfl
      rw [hfun]
      exact tendsto_const_nhds.sub (hw_lim.pow 2)
    have hw_eq : w_inf = z - w_inf ^ 2 := tendsto_nhds_unique hw_shift hw_rhs
    refine ⟨1 + 2 * w_inf, ?_⟩
    rw [h1x]
    linear_combination -4 * hw_eq
  obtain ⟨r, hr⟩ := h1x_sq
  have hd_bar_eq : d_bar = q_bar - u_bar := by
    dsimp only [d_bar, q_bar, u_bar, d]
    have hd_coe : (π - u_int : K) = (q₀ : K) - (u : K) := by
      rw [hπ_coe, hu_coe]
    rw [← map_sub]
    congr 1
  have hq_eq : q_bar = u_bar * (r * r) := by
    rw [← hr]
    dsimp only [x]
    rw [hd_bar_eq]
    calc q_bar
      _ = u_bar + (q_bar - u_bar) := by ring
      _ = u_bar + u_bar * ((q_bar - u_bar) / u_bar) := by rw [mul_div_cancel₀ _ hu_bar_ne]
      _ = u_bar * (1 + (q_bar - u_bar) / u_bar) := by ring
  have hr_ne : r ≠ 0 := by
    intro hr0
    have hx_neg1 : x = -1 := by
      rw [hr0, mul_zero] at hr
      linear_combination hr
    have hval_x : Valued.v x = 1 := by
      rw [hx_neg1, Valuation.map_neg, Valuation.map_one]
    exact ne_of_lt hx hval_x
  refine ⟨?_, ?_⟩
  · rintro ⟨s, hs⟩
    have hs' : q_bar = s * s := hs
    apply hu_nsq
    refine ⟨s / r, ?_⟩
    have hrr_ne : r * r ≠ 0 := mul_ne_zero hr_ne hr_ne
    calc u_bar
      _ = (u_bar * (r * r)) / (r * r) := by rw [mul_div_cancel_right₀ _ hrr_ne]
      _ = (s * s) / (r * r) := by rw [← hq_eq, hs']
      _ = (s / r) * (s / r) := by ring
  · rw [map_mul]
    change IsSquare (u_bar * q_bar)
    refine ⟨u_bar * r, ?_⟩
    rw [hq_eq]
    ring

theorem exists_basis_primes (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₃ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₃ : IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭) :
    ∃ (q : Fin 3 → Kˣ)
      (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsBasisPrimeTuple K T S₃ p 𝔭 q 𝔮 :=
by
  classical
  rcases hstart with ⟨_, _, _, _, _, _, ha₁_int, ha₂_int, ha₃_int, _⟩
  rcases hS₃ with ⟨⟨hST, _, _, _⟩, h𝔭_inj, h𝔭_mem, hp_int, _, hp_val_ne,
    _, _, _, _, _, hp_sq, _⟩
  let a₁_int : NumberField.RingOfIntegers K := ⟨a₁, ha₁_int⟩
  let a₂_int : NumberField.RingOfIntegers K := ⟨a₂, ha₂_int⟩
  let a₃_int : NumberField.RingOfIntegers K := ⟨a₃, ha₃_int⟩
  let D₀ : NumberField.RingOfIntegers K :=
    6 * (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int)
  have hD₀_coe : (D₀ : K) = 6 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃) := by
    dsimp [D₀]; push_cast; rfl
  have hT_iff_D₀ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∈ T ↔ D₀ ∈ v.asIdeal := by
    intro v
    rw [hT v, ← hD₀_coe, v.valuation_of_algebraMap D₀, ne_eq, v.intValuation_eq_one_iff, not_not]
  have hD₀_not_S₃ : ∀ v ∈ S₃, D₀ ∉ v.asIdeal := by
    intro v hv
    rw [← hT_iff_D₀ v]
    exact Finset.disjoint_left.mp hST hv
  have h2_not_S₃ : ∀ v ∈ S₃, (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
    intro v hv h2
    apply hD₀_not_S₃ v hv
    have hD₀_eq : D₀ = 2 * (3 * (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int)) := by
      dsimp [D₀]; ring
    rw [hD₀_eq]
    exact Ideal.mul_mem_right _ v.asIdeal h2
  have exists_step : ∀ (j : Fin 3)
      (S_extra : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))),
      (∀ i : Fin 6, 𝔭 i ∉ S_extra) →
      ∃ (q_j : Kˣ)
        (𝔮_j : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        (𝔮_j ∉ T ∧ 𝔮_j ∉ S₃ ∧ 𝔮_j ∉ S_extra) ∧
        IsIntegral ℤ (q_j : K) ∧
        IsDedekindDomain.HeightOneSpectrum.valuation K 𝔮_j (q_j : K) = WithZero.exp (-1 : ℤ) ∧
        (∀ v, v ≠ 𝔮_j → IsDedekindDomain.HeightOneSpectrum.valuation K v (q_j : K) = 1) ∧
        (∀ w : {w : NumberField.InfinitePlace K // w.IsReal}, 0 < realPlaceEmb w (q_j : K)) ∧
        (∀ v ∈ T, IsSquare (algebraMap K (v.adicCompletion K) (q_j : K))) ∧
        (∀ v ∈ S₃, (∀ i : Fin 6, v ≠ 𝔭 i) →
          IsSquare (algebraMap K (v.adicCompletion K) (q_j : K))) ∧
        (∀ i : Fin 6,
          (IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (q_j : K)) ↔ i.1 / 2 ≠ j.1)) ∧
        (IsSquare (algebraMap K ((𝔭 ⟨2 * j.1, by omega⟩).adicCompletion K)
          ((p ⟨2 * j.1 + 1, by omega⟩ : K) * (q_j : K))) ∧
         IsSquare (algebraMap K ((𝔭 ⟨2 * j.1 + 1, by omega⟩).adicCompletion K)
          ((p ⟨2 * j.1, by omega⟩ : K) * (q_j : K)))) ∧
        (∀ v ∈ S_extra, IsSquare (algebraMap K (v.adicCompletion K) (q_j : K))) := by
    intro j S_extra hS_extra
    let i₁ : Fin 6 := ⟨2 * j.1, by omega⟩
    let i₂ : Fin 6 := ⟨2 * j.1 + 1, by omega⟩
    have hi₁₂ : i₁ ≠ i₂ := by
      intro h
      have hval := congr_arg Fin.val h
      dsimp [i₁, i₂] at hval
      omega
    let v₁ := 𝔭 i₁
    let v₂ := 𝔭 i₂
    have hv₁₂ : v₁ ≠ v₂ := h𝔭_inj.ne hi₁₂
    let F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
      ((T ∪ S₃ ∪ S_extra).erase v₁).erase v₂
    have hv₁F : v₁ ∉ F := by
      simp [F]
    have hv₂F : v₂ ∉ F := by
      simp [F]
    have h2₁ : (2 : NumberField.RingOfIntegers K) ∉ v₁.asIdeal := h2_not_S₃ v₁ (h𝔭_mem i₁)
    have h2₂ : (2 : NumberField.RingOfIntegers K) ∉ v₂.asIdeal := h2_not_S₃ v₂ (h𝔭_mem i₂)
    let u₁_int : NumberField.RingOfIntegers K := ⟨(p i₂ : K), hp_int i₂⟩
    let u₂_int : NumberField.RingOfIntegers K := ⟨(p i₁ : K), hp_int i₁⟩
    have hu₁ : u₁_int ∉ v₁.asIdeal := by
      have hval : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) (u₁_int : K) = v₁.intValuation u₁_int :=
        v₁.valuation_of_algebraMap u₁_int
      rw [← v₁.intValuation_eq_one_iff, ← hval]
      exact hp_val_ne i₂ v₁ hv₁₂
    have hu₂ : u₂_int ∉ v₂.asIdeal := by
      have hval : (IsDedekindDomain.HeightOneSpectrum.valuation K v₂) (u₂_int : K) = v₂.intValuation u₂_int :=
        v₂.valuation_of_algebraMap u₂_int
      rw [← v₂.intValuation_eq_one_iff, ← hval]
      exact hp_val_ne i₁ v₂ hv₁₂.symm
    obtain ⟨q_mod, α, hq_mod, hunit, hcrt⟩ :=
      exists_crt_target_for_basis_prime K v₁ v₂ F u₁_int u₂_int hv₁₂ hv₁F hv₂F h2₁ h2₂ hu₁ hu₂
    obtain ⟨π, q_j, 𝔮_j, hπ_mod, hπ_coe, hq_int, h𝔮_span, hq_val_eq, hq_val_ne, hq_pos⟩ :=
      exists_totally_positive_prime_of_mitsui K q_mod α hq_mod hunit
    obtain ⟨hπ_u₁, hπ_u₂, hπ_F, hπ_not_v₁, hπ_not_v₂, hπ_not_F⟩ := hcrt π hπ_mod
    have hπ_in_𝔮 : π ∈ 𝔮_j.asIdeal := by
      rw [h𝔮_span]
      exact Ideal.mem_span_singleton_self π
    have h𝔮_ne_of_not_mem : ∀ w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        π ∉ w.asIdeal → 𝔮_j ≠ w := by
      intro w hw h_eq
      apply hw
      rw [← h_eq]
      exact hπ_in_𝔮
    have h𝔮_ne_v₁ : 𝔮_j ≠ v₁ := h𝔮_ne_of_not_mem v₁ hπ_not_v₁
    have h𝔮_ne_v₂ : 𝔮_j ≠ v₂ := h𝔮_ne_of_not_mem v₂ hπ_not_v₂
    have h𝔮_not_F : 𝔮_j ∉ F := by
      intro hmem
      exact hπ_not_F 𝔮_j hmem hπ_in_𝔮
    have h𝔮_not_union : 𝔮_j ∉ T ∪ S₃ ∪ S_extra := by
      intro hmem
      apply h𝔮_not_F
      simp only [F, Finset.mem_erase]
      exact ⟨h𝔮_ne_v₂, h𝔮_ne_v₁, hmem⟩
    have h𝔮_not_T : 𝔮_j ∉ T := by
      intro hmem; apply h𝔮_not_union; simp [hmem]
    have h𝔮_not_S₃ : 𝔮_j ∉ S₃ := by
      intro hmem; apply h𝔮_not_union; simp [hmem]
    have h𝔮_not_extra : 𝔮_j ∉ S_extra := by
      intro hmem; apply h𝔮_not_union; simp [hmem]
    have hsq_F : ∀ w ∈ F, IsSquare (algebraMap K (w.adicCompletion K) (q_j : K)) := by
      intro w hw
      obtain ⟨z, hz_mem, hπ_eq⟩ := hπ_F w hw
      have hz_val : Valued.v (algebraMap K (w.adicCompletion K) (z : K)) ≤ WithZero.exp (-1 : ℤ) := by
        have h1 : Valued.v (algebraMap K (w.adicCompletion K) (z : K)) =
            (IsDedekindDomain.HeightOneSpectrum.valuation K w) (z : K) :=
          w.valuedAdicCompletion_eq_valuation' (z : K)
        rw [h1, w.valuation_of_algebraMap z]
        have h2 := (w.intValuation_le_pow_iff_mem z 1).mpr (by simpa using hz_mem)
        simpa using h2
      have hq_adic : algebraMap K (w.adicCompletion K) (q_j : K) =
          1 + 4 * algebraMap K (w.adicCompletion K) (z : K) := by
        have hq_K : (q_j : K) = 1 + 4 * (z : K) := by
          rw [← hπ_coe, hπ_eq]; push_cast; rfl
        rw [hq_K, map_add, map_one, map_mul, map_ofNat]
      rw [hq_adic]
      exact isSquare_one_add_four_mul_of_valuation_le K w
        (algebraMap K (w.adicCompletion K) (z : K)) hz_val
    have hval2₁ : (IsDedekindDomain.HeightOneSpectrum.valuation K v₁) 2 = 1 := by
      have h1 : (2 : K) = ((2 : NumberField.RingOfIntegers K) : K) := by push_cast; rfl
      rw [h1, v₁.valuation_of_algebraMap, v₁.intValuation_eq_one_iff]
      exact h2₁
    have hval2₂ : (IsDedekindDomain.HeightOneSpectrum.valuation K v₂) 2 = 1 := by
      have h1 : (2 : K) = ((2 : NumberField.RingOfIntegers K) : K) := by push_cast; rfl
      rw [h1, v₂.valuation_of_algebraMap, v₂.intValuation_eq_one_iff]
      exact h2₂
    have hu₁_nsq : ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (p i₂ : K)) := by
      rw [hp_sq i₁ i₂ hi₁₂, not_not]
      dsimp [i₁, i₂]
      omega
    have hu₂_nsq : ¬ IsSquare (algebraMap K (v₂.adicCompletion K) (p i₁ : K)) := by
      rw [hp_sq i₂ i₁ hi₁₂.symm, not_not]
      dsimp [i₁, i₂]
      omega
    obtain ⟨hq_nsq₁, hq_mul₁⟩ :=
      isSquare_mul_and_not_isSquare_of_sub_mem K v₁ (p i₂) q_j u₁_int π
        hval2₁ rfl hπ_coe hu₁ hπ_u₁ hu₁_nsq
    obtain ⟨hq_nsq₂, hq_mul₂⟩ :=
      isSquare_mul_and_not_isSquare_of_sub_mem K v₂ (p i₁) q_j u₂_int π
        hval2₂ rfl hπ_coe hu₂ hπ_u₂ hu₂_nsq
    refine ⟨q_j, 𝔮_j, ⟨h𝔮_not_T, h𝔮_not_S₃, h𝔮_not_extra⟩, hq_int, hq_val_eq, hq_val_ne,
      hq_pos, ?_, ?_, ?_, ⟨hq_mul₁, hq_mul₂⟩, ?_⟩
    · intro v hvT
      apply hsq_F v
      have hv_ne₁ : v ≠ v₁ := fun h => Finset.disjoint_left.mp hST (h ▸ h𝔭_mem i₁) hvT
      have hv_ne₂ : v ≠ v₂ := fun h => Finset.disjoint_left.mp hST (h ▸ h𝔭_mem i₂) hvT
      simp only [F, Finset.mem_erase, Finset.mem_union]
      exact ⟨hv_ne₂, hv_ne₁, Or.inl (Or.inl hvT)⟩
    · intro v hvS₃ hv_ne
      apply hsq_F v
      simp only [F, Finset.mem_erase, Finset.mem_union]
      exact ⟨hv_ne i₂, hv_ne i₁, Or.inl (Or.inr hvS₃)⟩
    · intro i
      constructor
      · intro hsq hdiv
        have hi_cases : i = i₁ ∨ i = i₂ := by
          have hval : i.1 = 2 * j.1 ∨ i.1 = 2 * j.1 + 1 := by omega
          rcases hval with h | h
          · left; exact Fin.ext h
          · right; exact Fin.ext h
        rcases hi_cases with rfl | rfl
        · exact hq_nsq₁ hsq
        · exact hq_nsq₂ hsq
      · intro hdiv
        have hi_ne₁ : i ≠ i₁ := by
          intro h; apply hdiv; have := congr_arg Fin.val h; dsimp [i₁] at this; omega
        have hi_ne₂ : i ≠ i₂ := by
          intro h; apply hdiv; have := congr_arg Fin.val h; dsimp [i₂] at this; omega
        apply hsq_F (𝔭 i)
        simp only [F, Finset.mem_erase, Finset.mem_union]
        exact ⟨h𝔭_inj.ne hi_ne₂, h𝔭_inj.ne hi_ne₁, Or.inl (Or.inr (h𝔭_mem i))⟩
    · intro v hv_extra
      apply hsq_F v
      have hv_ne₁ : v ≠ v₁ := by
        intro h; apply hS_extra i₁; dsimp [v₁] at h; rw [← h]; exact hv_extra
      have hv_ne₂ : v ≠ v₂ := by
        intro h; apply hS_extra i₂; dsimp [v₂] at h; rw [← h]; exact hv_extra
      simp only [F, Finset.mem_erase, Finset.mem_union]
      exact ⟨hv_ne₂, hv_ne₁, Or.inr hv_extra⟩
  obtain ⟨q₀, 𝔮₀, ⟨h𝔮₀_T, h𝔮₀_S₃, _⟩, hq₀_int, hq₀_val_eq, hq₀_val_ne,
    hq₀_pos, hq₀_sq_T, hq₀_sq_S₃, hq₀_sq_𝔭, hq₀_mul, _⟩ :=
    exists_step 0 ∅ (fun _ => Finset.notMem_empty _)
  have hS_extra₁ : ∀ i : Fin 6, 𝔭 i ∉ ({𝔮₀} : Finset _) := by
    intro i hmem
    rw [Finset.mem_singleton] at hmem
    exact h𝔮₀_S₃ (hmem ▸ h𝔭_mem i)
  obtain ⟨q₁, 𝔮₁, ⟨h𝔮₁_T, h𝔮₁_S₃, h𝔮₁_extra⟩, hq₁_int, hq₁_val_eq, hq₁_val_ne,
    hq₁_pos, hq₁_sq_T, hq₁_sq_S₃, hq₁_sq_𝔭, hq₁_mul, hq₁_sq_extra⟩ :=
    exists_step 1 {𝔮₀} hS_extra₁
  have hS_extra₂ : ∀ i : Fin 6, 𝔭 i ∉ ({𝔮₀, 𝔮₁} : Finset _) := by
    intro i hmem
    simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
    rcases hmem with h | h
    · exact h𝔮₀_S₃ (h ▸ h𝔭_mem i)
    · exact h𝔮₁_S₃ (h ▸ h𝔭_mem i)
  obtain ⟨q₂, 𝔮₂, ⟨h𝔮₂_T, h𝔮₂_S₃, h𝔮₂_extra⟩, hq₂_int, hq₂_val_eq, hq₂_val_ne,
    hq₂_pos, hq₂_sq_T, hq₂_sq_S₃, hq₂_sq_𝔭, hq₂_mul, hq₂_sq_extra⟩ :=
    exists_step 2 {𝔮₀, 𝔮₁} hS_extra₂
  have h𝔮₁₀ : 𝔮₁ ≠ 𝔮₀ := Finset.notMem_singleton.mp h𝔮₁_extra
  have h𝔮₂₀ : 𝔮₂ ≠ 𝔮₀ := by
    intro h; apply h𝔮₂_extra; simp [h]
  have h𝔮₂₁ : 𝔮₂ ≠ 𝔮₁ := by
    intro h; apply h𝔮₂_extra; simp [h]
  let q : Fin 3 → Kˣ := ![q₀, q₁, q₂]
  let 𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) := ![𝔮₀, 𝔮₁, 𝔮₂]
  refine ⟨q, 𝔮, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro j₁ j₂ h_eq
    fin_cases j₁ <;> fin_cases j₂ <;> simp only [𝔮, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons] at h_eq ⊢
    · exact (h𝔮₁₀ h_eq.symm).elim
    · exact (h𝔮₂₀ h_eq.symm).elim
    · exact (h𝔮₁₀ h_eq).elim
    · exact (h𝔮₂₁ h_eq.symm).elim
    · exact (h𝔮₂₀ h_eq).elim
    · exact (h𝔮₂₁ h_eq).elim
  · intro j
    fin_cases j <;> simp only [𝔮, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact ⟨h𝔮₀_T, h𝔮₀_S₃⟩
    · exact ⟨h𝔮₁_T, h𝔮₁_S₃⟩
    · exact ⟨h𝔮₂_T, h𝔮₂_S₃⟩
  · intro j
    fin_cases j <;> simp only [q, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact hq₀_int
    · exact hq₁_int
    · exact hq₂_int
  · intro j
    fin_cases j <;> simp only [q, 𝔮, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact hq₀_val_eq
    · exact hq₁_val_eq
    · exact hq₂_val_eq
  · intro j v hv
    fin_cases j <;> simp only [q, 𝔮, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at hv ⊢
    · exact hq₀_val_ne v hv
    · exact hq₁_val_ne v hv
    · exact hq₂_val_ne v hv
  · intro j w
    fin_cases j <;> simp only [q, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact hq₀_pos w
    · exact hq₁_pos w
    · exact hq₂_pos w
  · intro j v hv
    fin_cases j <;> simp only [q, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact hq₀_sq_T v hv
    · exact hq₁_sq_T v hv
    · exact hq₂_sq_T v hv
  · intro j v hvS₃ hv_ne
    fin_cases j <;> simp only [q, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact hq₀_sq_S₃ v hvS₃ hv_ne
    · exact hq₁_sq_S₃ v hvS₃ hv_ne
    · exact hq₂_sq_S₃ v hvS₃ hv_ne
  · intro i j
    fin_cases j <;> simp only [q, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact hq₀_sq_𝔭 i
    · exact hq₁_sq_𝔭 i
    · exact hq₂_sq_𝔭 i
  · intro j
    fin_cases j <;> simp only [q, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    · exact hq₀_mul
    · exact hq₁_mul
    · exact hq₂_mul
  · intro j₁ j₂
    fin_cases j₁ <;> fin_cases j₂ <;> intro hlt
    · simp at hlt
    · simp only [q, 𝔮, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      exact hq₁_sq_extra 𝔮₀ (Finset.mem_singleton_self 𝔮₀)
    · simp only [q, 𝔮, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      exact hq₂_sq_extra 𝔮₀ (by simp)
    · simp at hlt
    · simp at hlt
    · simp only [q, 𝔮, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      exact hq₂_sq_extra 𝔮₁ (by simp)
    · simp at hlt
    · simp at hlt
    · simp at hlt

theorem reciprocity_of_basis_primes (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₃ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : Fin 3 → Kˣ)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₃ : IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭)
    (hq : IsBasisPrimeTuple K T S₃ p 𝔭 q 𝔮) :
    IsBasisPrimeReciprocity K a₁ a₂ a₃ p q 𝔮 :=
by
  classical
  have hdesc_outside : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ r : Kˣ × Kˣ,
        IsDescentClass
          (algebraMap K (v.adicCompletion K) a₁)
          (algebraMap K (v.adicCompletion K) a₂)
          (algebraMap K (v.adicCompletion K) a₃)
          (algebraMap K (v.adicCompletion K) (r.1 : K))
          (algebraMap K (v.adicCompletion K) (r.2 : K)) ↔
        EvenVal v r.1 ∧ EvenVal v r.2 := by
    rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _⟩
    intro v hvT r
    obtain ⟨h2, hdesc_even⟩ := local_descent_implies_evenVal K a₁ a₂ a₃ hint₁ hint₂ hint₃ T hT v hvT
    exact isDescentClass_iff_evenVal_of_notMem_T K a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ v h2
      (isSquare_one_add_of_valuation_lt_one K v h2)
      (exists_nonSquare_unit_mod_ideal K v h2)
      (exists_ringOfIntegers_sub_valuation_lt_one K v)
      hdesc_even r
  have h_piv : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∃ π_u : Kˣ, IsLocalPivotUnif K a₁ a₂ a₃ v π_u :=
    fun v hvT => local_v1_hilbLoc_and_ramLocal_laws K a₁ a₂ a₃ τ T v hstart hT hvT (hdesc_outside v hvT)
  have h_piv_u : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ u : Kˣ,
        ((u : K) = -1 ∨ (u : K) = a₁ - a₂ ∨ (u : K) = a₁ - a₃ ∨ (u : K) = a₂ - a₃) →
        EvenVal v u := by
    intro v hvT u hu
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.1 u hu
  have h_piv_mul_sq : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ x y : Kˣ, EvenVal v x → EvenVal v y →
        (IsSquare (algebraMap K (v.adicCompletion K) ((x * y : Kˣ) : K)) ↔
          (IsSquare (algebraMap K (v.adicCompletion K) (x : K)) ↔
           IsSquare (algebraMap K (v.adicCompletion K) (y : K)))) := by
    intro v hvT x y hx hy
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.1 x y hx hy
  have h_hilb_even_even : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ a b : Kˣ, EvenVal v a → EvenVal v b →
        hilbFin v (a : K) (b : K) = 1 := by
    intro v hvT a b ha hb
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.2.1 a b ha hb
  have h_hilb_even_odd : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ a b : Kˣ, EvenVal v a → ¬ EvenVal v b →
        (hilbFin v (a : K) (b : K) = 1 ↔
          IsSquare (algebraMap K (v.adicCompletion K) (a : K))) ∧
        (hilbFin v (b : K) (a : K) = 1 ↔
          IsSquare (algebraMap K (v.adicCompletion K) (a : K))) := by
    intro v hvT a b ha hb
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.2.2.1 a b ha hb
  rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _⟩
  rcases hS₃ with ⟨⟨hS₃_disj_T, _⟩, h𝔭_inj, h𝔭_mem_S₃, hp_int, hp_val_𝔭, hp_val_ne, _⟩
  rcases hq with ⟨h𝔮_inj, h𝔮_notMem, hq_int, hq_val_𝔮, hq_val_ne, hq_pos,
    hq_sq_T, hq_sq_S₃, hq_sq_𝔭, hq_pair, hq_upper⟩
  have h𝔭_notMem_T : ∀ i : Fin 6, 𝔭 i ∉ T :=
    fun i => Finset.disjoint_left.mp hS₃_disj_T (h𝔭_mem_S₃ i)
  have h𝔭_ne_𝔮 : ∀ (i : Fin 6) (j : Fin 3), 𝔭 i ≠ 𝔮 j :=
    fun i j h => (h𝔮_notMem j).2 (h ▸ h𝔭_mem_S₃ i)
  have hp_even_ne : ∀ (i : Fin 6)
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ≠ 𝔭 i → EvenVal v (p i) := by
    intro i v hv
    have hval := hp_val_ne i v hv
    rw [← v.valuationOfNeZero_eq (p i)] at hval
    have h1 : v.valuationOfNeZero (p i) = 1 := WithZero.coe_inj.mp hval
    dsimp [EvenVal]
    rw [h1, toAdd_one]
    exact Even.zero
  have hp_not_even_𝔭 : ∀ i : Fin 6, ¬ EvenVal (𝔭 i) (p i) := by
    intro i
    have hval := hp_val_𝔭 i
    rw [← (𝔭 i).valuationOfNeZero_eq (p i)] at hval
    have h1 : (𝔭 i).valuationOfNeZero (p i) = Multiplicative.ofAdd (-1 : ℤ) :=
      WithZero.coe_inj.mp hval
    dsimp [EvenVal]
    rw [h1, toAdd_ofAdd]
    decide
  have hq_even_ne : ∀ (j : Fin 3)
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ≠ 𝔮 j → EvenVal v (q j) := by
    intro j v hv
    have hval := hq_val_ne j v hv
    rw [← v.valuationOfNeZero_eq (q j)] at hval
    have h1 : v.valuationOfNeZero (q j) = 1 := WithZero.coe_inj.mp hval
    dsimp [EvenVal]
    rw [h1, toAdd_one]
    exact Even.zero
  have hq_not_even_𝔮 : ∀ j : Fin 3, ¬ EvenVal (𝔮 j) (q j) := by
    intro j
    have hval := hq_val_𝔮 j
    rw [← (𝔮 j).valuationOfNeZero_eq (q j)] at hval
    have h1 : (𝔮 j).valuationOfNeZero (q j) = Multiplicative.ofAdd (-1 : ℤ) :=
      WithZero.coe_inj.mp hval
    dsimp [EvenVal]
    rw [h1, toAdd_ofAdd]
    decide
  have hilbFin_eq_one_of_isSquare_right :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (a : K) (b : Kˣ),
        IsSquare (algebraMap K (v.adicCompletion K) (b : K)) →
        hilbFin v a (b : K) = 1 := by
    rintro v a b ⟨r, hr⟩
    unfold hilbFin hilbLoc
    apply if_pos
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr
      exact b.ne_zero ((algebraMap K (v.adicCompletion K)).injective (hr.trans (map_zero _).symm))
    refine ⟨0, r⁻¹, ?_⟩
    rw [hr]
    calc algebraMap K (v.adicCompletion K) a * 0 ^ 2 + (r * r) * (r⁻¹) ^ 2
      _ = (r * r⁻¹) ^ 2 := by ring
      _ = 1 ^ 2 := by rw [mul_inv_cancel₀ hr_ne]
      _ = 1 := one_pow 2
  have hilbInf_eq_one_of_isComplex :
      ∀ (w : NumberField.InfinitePlace K), w.IsComplex → ∀ (a b : Kˣ),
        hilbInf w (a : K) (b : K) = 1 := by
    intro w hw a b
    unfold hilbInf hilbInfLoc
    apply if_pos
    have hbij := NumberField.InfinitePlace.Completion.bijective_extensionEmbedding_of_isComplex hw
    set φ := NumberField.InfinitePlace.Completion.extensionEmbedding w
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_eq_mul_self (φ (algebraMap K w.Completion (a : K)))
    obtain ⟨r, hr⟩ := hbij.2 z
    have hr_sq : algebraMap K w.Completion (a : K) = r * r := by
      apply hbij.1
      rw [map_mul, hr, ← hz]
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr_sq
      exact a.ne_zero ((algebraMap K w.Completion).injective (hr_sq.trans (map_zero _).symm))
    refine ⟨r⁻¹, 0, ?_⟩
    rw [hr_sq]
    calc (r * r) * (r⁻¹) ^ 2 + algebraMap K w.Completion (b : K) * 0 ^ 2
      _ = (r * r⁻¹) ^ 2 := by ring
      _ = 1 ^ 2 := by rw [mul_inv_cancel₀ hr_ne]
      _ = 1 := one_pow 2
  have hilbInf_eq_one_of_pos_right :
      ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (a b : Kˣ),
        0 < realPlaceEmb ⟨w, hw⟩ (b : K) → hilbInf w (a : K) (b : K) = 1 := by
    intro w hw a b hb_pos
    unfold hilbInf hilbInfLoc
    apply if_pos
    have hbij := NumberField.InfinitePlace.Completion.bijective_extensionEmbeddingOfIsReal hw
    set ψ := NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal hw
    have hcoe : ψ (algebraMap K w.Completion (b : K)) = realPlaceEmb ⟨w, hw⟩ (b : K) :=
      NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw (b : K)
    obtain ⟨r, hr⟩ := hbij.2 (Real.sqrt (realPlaceEmb ⟨w, hw⟩ (b : K)))
    have hr_sq : algebraMap K w.Completion (b : K) = r * r := by
      apply hbij.1
      rw [map_mul, hr, Real.mul_self_sqrt (le_of_lt hb_pos), hcoe]
    have hr_ne : r ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hr_sq
      exact b.ne_zero ((algebraMap K w.Completion).injective (hr_sq.trans (map_zero _).symm))
    refine ⟨0, r⁻¹, ?_⟩
    rw [hr_sq]
    calc algebraMap K w.Completion (a : K) * 0 ^ 2 + (r * r) * (r⁻¹) ^ 2
      _ = (r * r⁻¹) ^ 2 := by ring
      _ = 1 ^ 2 := by rw [mul_inv_cancel₀ hr_ne]
      _ = 1 := one_pow 2
  have hilbInf_prod_q_eq_one :
      ∀ (j : Fin 3) (a : Kˣ),
        (∏ w : NumberField.InfinitePlace K, hilbInf w (a : K) (q j : K)) = 1 := by
    intro j a
    refine Finset.prod_eq_one (fun w _ => ?_)
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · exact hilbInf_eq_one_of_pos_right w hw a (q j) (hq_pos j ⟨w, hw⟩)
    · exact hilbInf_eq_one_of_isComplex w hw a (q j)
  have isSquare_at_basis_prime_iff_of_single_odd_prime :
      ∀ (j : Fin 3) (x : Kˣ)
        (v_x : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        v_x ∉ T →
        v_x ≠ 𝔮 j →
        ¬ EvenVal v_x x →
        (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v ≠ v_x → EvenVal v x) →
        (IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (x : K)) ↔
         IsSquare (algebraMap K (v_x.adicCompletion K) (q j : K))) := by
    intro j x v_x hv_x_T hv_x_ne hx_odd hx_even
    have h_fin_outside : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v ≠ v_x → v ≠ 𝔮 j → hilbFin v (x : K) (q j : K) = 1 := by
      intro v hv_x hv_q
      by_cases hvT : v ∈ T
      · exact hilbFin_eq_one_of_isSquare_right v (x : K) (q j) (hq_sq_T j v hvT)
      · exact h_hilb_even_even v hvT x (q j) (hx_even v hv_x) (hq_even_ne j v hv_q)
    have h_supp : Function.mulSupport
        (fun v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) =>
          hilbFin v (x : K) (q j : K)) ⊆
        (({v_x, 𝔮 j} : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
          Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) := by
      intro v hv
      rw [Function.mem_mulSupport] at hv
      by_contra hnot
      simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff, not_or] at hnot
      exact hv (h_fin_outside v hnot.1 hnot.2)
    have h_rec := (hilbert_reciprocity x (q j)).2
    rw [finprod_eq_prod_of_mulSupport_subset _ h_supp,
        Finset.prod_pair hv_x_ne,
        hilbInf_prod_q_eq_one j x, mul_one] at h_rec
    have h_hilb_eq_iff :
        hilbFin (𝔮 j) (x : K) (q j : K) = 1 ↔
        hilbFin v_x (x : K) (q j : K) = 1 := by
      rcases Int.units_eq_one_or (hilbFin (𝔮 j) (x : K) (q j : K)) with h1 | h1 <;>
      rcases Int.units_eq_one_or (hilbFin v_x (x : K) (q j : K)) with h2 | h2
      · simp [h1, h2]
      · exfalso; rw [h1, h2] at h_rec; revert h_rec; decide
      · exfalso; rw [h1, h2] at h_rec; revert h_rec; decide
      · simp [h1, h2]
    have h_at_q : hilbFin (𝔮 j) (x : K) (q j : K) = 1 ↔
        IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (x : K)) :=
      (h_hilb_even_odd (𝔮 j) (h𝔮_notMem j).1 x (q j)
        (hx_even (𝔮 j) hv_x_ne.symm) (hq_not_even_𝔮 j)).1
    have h_at_vx : hilbFin v_x (x : K) (q j : K) = 1 ↔
        IsSquare (algebraMap K (v_x.adicCompletion K) (q j : K)) :=
      (h_hilb_even_odd v_x hv_x_T (q j) x
        (hq_even_ne j v_x hv_x_ne) hx_odd).2
    exact h_at_q.symm.trans (h_hilb_eq_iff.trans h_at_vx)
  have isSquare_at_basis_prime_of_root_diff :
      ∀ (j : Fin 3) (u : Kˣ),
        ((u : K) = -1 ∨ (u : K) = a₁ - a₂ ∨ (u : K) = a₁ - a₃ ∨ (u : K) = a₂ - a₃) →
        IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (u : K)) := by
    intro j u hu_case
    have h_fin_other : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v ≠ 𝔮 j → hilbFin v (u : K) (q j : K) = 1 := by
      intro v hv
      by_cases hvT : v ∈ T
      · exact hilbFin_eq_one_of_isSquare_right v (u : K) (q j) (hq_sq_T j v hvT)
      · exact h_hilb_even_even v hvT u (q j) (h_piv_u v hvT u hu_case) (hq_even_ne j v hv)
    have h_rec := (hilbert_reciprocity u (q j)).2
    rw [finprod_eq_single _ (𝔮 j) h_fin_other, hilbInf_prod_q_eq_one j u, mul_one] at h_rec
    exact (h_hilb_even_odd (𝔮 j) (h𝔮_notMem j).1 u (q j)
      (h_piv_u (𝔮 j) (h𝔮_notMem j).1 u hu_case) (hq_not_even_𝔮 j)).1.mp h_rec
  have h_conj1 : ∀ i : Fin 6, ∀ j : Fin 3,
      (IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (p i : K)) ↔ i.1 / 2 ≠ j.1) := by
    intro i j
    rw [isSquare_at_basis_prime_iff_of_single_odd_prime j (p i) (𝔭 i)
      (h𝔭_notMem_T i) (h𝔭_ne_𝔮 i j) (hp_not_even_𝔭 i) (hp_even_ne i), hq_sq_𝔭 i j]
  refine ⟨h_conj1, ?_, ?_, ?_⟩
  · intro j
    let i₀ : Fin 6 := ⟨2 * j.1, by omega⟩
    let i₁ : Fin 6 := ⟨2 * j.1 + 1, by omega⟩
    have h_even₀ : EvenVal (𝔮 j) (p i₀) := hp_even_ne i₀ (𝔮 j) (h𝔭_ne_𝔮 i₀ j).symm
    have h_even₁ : EvenVal (𝔮 j) (p i₁) := hp_even_ne i₁ (𝔮 j) (h𝔭_ne_𝔮 i₁ j).symm
    have h_nsq₀ : ¬ IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (p i₀ : K)) := by
      rw [h_conj1 i₀ j]
      dsimp [i₀]
      omega
    have h_nsq₁ : ¬ IsSquare (algebraMap K ((𝔮 j).adicCompletion K) (p i₁ : K)) := by
      rw [h_conj1 i₁ j]
      dsimp [i₁]
      omega
    have h_mul := (h_piv_mul_sq (𝔮 j) (h𝔮_notMem j).1 (p i₀) (p i₁) h_even₀ h_even₁).mpr
      (iff_of_false h_nsq₀ h_nsq₁)
    simpa only [Units.val_mul, map_mul] using h_mul
  · intro j₁ j₂ hj₁₂
    have hj_val : j₁.1 ≠ j₂.1 := fun h => hj₁₂ (Fin.ext h)
    rcases lt_or_gt_of_ne hj_val with hlt | hgt
    · exact hq_upper j₁ j₂ hlt
    · rw [isSquare_at_basis_prime_iff_of_single_odd_prime j₁ (q j₂) (𝔮 j₂)
        (h𝔮_notMem j₂).1 (h𝔮_inj.ne hj₁₂.symm) (hq_not_even_𝔮 j₂) (hq_even_ne j₂)]
      exact hq_upper j₂ j₁ hgt
  · intro j
    let u_neg1 : Kˣ := -1
    let u_12 : Kˣ := Units.mk0 (a₁ - a₂) (sub_ne_zero.mpr h₁₂)
    let u_13 : Kˣ := Units.mk0 (a₁ - a₃) (sub_ne_zero.mpr h₁₃)
    let u_23 : Kˣ := Units.mk0 (a₂ - a₃) (sub_ne_zero.mpr h₂₃)
    refine ⟨isSquare_at_basis_prime_of_root_diff j u_neg1 (Or.inl rfl),
            isSquare_at_basis_prime_of_root_diff j u_12 (Or.inr (Or.inl rfl)),
            isSquare_at_basis_prime_of_root_diff j u_13 (Or.inr (Or.inr (Or.inl rfl))),
            isSquare_at_basis_prime_of_root_diff j u_23 (Or.inr (Or.inr (Or.inr rfl)))⟩

theorem exists_basis_adjoined_state_and_evenVal (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₃ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : Fin 3 → Kˣ)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hS₃ : IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭)
    (hq : IsBasisPrimeTuple K T S₃ p 𝔭 q 𝔮) :
    ∃ (S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ₄ : Kˣ),
      S₃ ⊆ S₄ ∧
      (∀ j : Fin 3, 𝔮 j ∈ S₄) ∧
      (∀ v ∈ S₄, (∀ j : Fin 3, v ≠ 𝔮 j) → v ∈ S₃) ∧
      Disjoint S₄ T ∧
      (∀ v ∈ S₃, π₄ v = π₃ v) ∧
      (∀ j : Fin 3, π₄ (𝔮 j) =
        algebraMap K ((𝔮 j).adicCompletion K)
          ((p ⟨2 * j.1, by omega⟩ * q j : Kˣ) : K)) ∧
      (∀ v ∈ S₄, IsLocalUnif v (π₄ v)) ∧
      IsPrincipalPrimeSet K S₄ κ₄ ∧
      (∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S₄ →
        IsDedekindDomain.HeightOneSpectrum.valuation K v ((basisTwistPair p q k).1 : K) = 1 ∧
        IsDedekindDomain.HeightOneSpectrum.valuation K v ((basisTwistPair p q k).2 : K) = 1) ∧
      (∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S₄ →
        EvenVal v (basisTwistPair p q k).1 ∧ EvenVal v (basisTwistPair p q k).2) ∧
      (∀ m : Fin 3, ∀ k : Fin 6,
        (¬ EvenVal (𝔮 m) (basisTwistPair p q k).1 ↔ k = ⟨2 * m.1, by omega⟩) ∧
        (¬ EvenVal (𝔮 m) (basisTwistPair p q k).2 ↔ k = ⟨2 * m.1 + 1, by omega⟩)) :=
by
  classical
  rcases hS₃ with ⟨⟨hS₃_disj, hπ₃_unif, ⟨hκ₃_int, hκ₃_val_in, hκ₃_val_out⟩, _⟩,
    h𝔭_inj, h𝔭_mem, hp_int, hp_val_self, hp_val_other, _⟩
  rcases hq with ⟨h𝔮_inj, h𝔮_not_in, hq_int, hq_val_self, hq_val_other, _⟩
  let S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    S₃ ∪ Finset.univ.image 𝔮
  let κ₄ : Kˣ := κ₃ * ∏ j : Fin 3, q j
  let u_val : ∀ j : Fin 3, (𝔮 j).adicCompletion K :=
    fun j => algebraMap K ((𝔮 j).adicCompletion K)
      ((p ⟨2 * j.1, by omega⟩ * q j : Kˣ) : K)
  let π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v.adicCompletion K :=
    Function.update (Function.update (Function.update π₃
      (𝔮 0) (u_val 0))
      (𝔮 1) (u_val 1))
      (𝔮 2) (u_val 2)
  have hS₃_sub : S₃ ⊆ S₄ := Finset.subset_union_left
  have h𝔮_mem : ∀ j : Fin 3, 𝔮 j ∈ S₄ :=
    fun j => Finset.mem_union_right _ (Finset.mem_image_of_mem 𝔮 (Finset.mem_univ j))
  have hS₄_to_S₃ : ∀ v ∈ S₄, (∀ j : Fin 3, v ≠ 𝔮 j) → v ∈ S₃ := by
    intro v hv hne
    rcases Finset.mem_union.mp hv with hvS₃ | hv_img
    · exact hvS₃
    · rcases Finset.mem_image.mp hv_img with ⟨j, _, rfl⟩
      exact absurd rfl (hne j)
  have hdisj₄ : Disjoint S₄ T := by
    rw [Finset.disjoint_union_left]
    refine ⟨hS₃_disj, Finset.disjoint_left.mpr ?_⟩
    intro v hv_img
    rcases Finset.mem_image.mp hv_img with ⟨j, _, rfl⟩
    exact (h𝔮_not_in j).1
  have hπ₄_other : ∀ v, (∀ j : Fin 3, v ≠ 𝔮 j) → π₄ v = π₃ v := by
    intro v hv
    dsimp only [π₄]
    rw [Function.update_of_ne (hv 2),
        Function.update_of_ne (hv 1),
        Function.update_of_ne (hv 0)]
  have hπ₄_S₃ : ∀ v ∈ S₃, π₄ v = π₃ v := by
    intro v hv
    apply hπ₄_other v
    intro j hvj
    subst hvj
    exact (h𝔮_not_in j).2 hv
  have hj_cases : ∀ j : Fin 3, j = 0 ∨ j = 1 ∨ j = 2 := by decide
  have hπ₄_𝔮 : ∀ j : Fin 3, π₄ (𝔮 j) = u_val j := by
    intro j
    dsimp only [π₄]
    rcases hj_cases j with rfl | rfl | rfl
    · rw [Function.update_of_ne (h𝔮_inj.ne (by decide)),
          Function.update_of_ne (h𝔮_inj.ne (by decide)),
          Function.update_self]
    · rw [Function.update_of_ne (h𝔮_inj.ne (by decide)),
          Function.update_self]
    · rw [Function.update_self]
  have h𝔮_ne_𝔭 : ∀ (j : Fin 3) (k : Fin 6), 𝔮 j ≠ 𝔭 k := by
    intro j k hjk
    have h_in : 𝔮 j ∈ S₃ := hjk ▸ h𝔭_mem k
    exact (h𝔮_not_in j).2 h_in
  have hπ₄_unif : ∀ v ∈ S₄, IsLocalUnif v (π₄ v) := by
    intro v hv
    rcases Finset.mem_union.mp hv with hvS₃ | hv_img
    · rw [hπ₄_S₃ v hvS₃]
      exact hπ₃_unif v hvS₃
    · rcases Finset.mem_image.mp hv_img with ⟨j, _, rfl⟩
      rw [hπ₄_𝔮 j]
      have hval_u : Valued.v (u_val j) =
          ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
        refine ((𝔮 j).valuedAdicCompletion_eq_valuation'
          ((p ⟨2 * j.1, by omega⟩ * q j : Kˣ) : K)).trans ?_
        rw [Units.val_mul, map_mul,
            hp_val_other ⟨2 * j.1, by omega⟩ (𝔮 j) (h𝔮_ne_𝔭 j ⟨2 * j.1, by omega⟩),
            hq_val_self j, one_mul]
        rfl
      exact ⟨-1, ⟨-1, by omega⟩, hval_u⟩
  have hκ₄_coe : (κ₄ : K) = (κ₃ : K) * ((q 0 : K) * (q 1 : K) * (q 2 : K)) := by
    simp only [κ₄, Fin.prod_univ_three, Units.val_mul]
  have hprin₄ : IsPrincipalPrimeSet K S₄ κ₄ := by
    refine ⟨?_, ?_, ?_⟩
    · rw [hκ₄_coe]
      exact hκ₃_int.mul (((hq_int 0).mul (hq_int 1)).mul (hq_int 2))
    · intro v hv
      rw [hκ₄_coe]
      simp only [map_mul]
      rcases Finset.mem_union.mp hv with hvS₃ | hv_img
      · have hne : ∀ j : Fin 3, v ≠ 𝔮 j := by
          intro j hvj
          subst hvj
          exact (h𝔮_not_in j).2 hvS₃
        rw [hκ₃_val_in v hvS₃,
            hq_val_other 0 v (hne 0),
            hq_val_other 1 v (hne 1),
            hq_val_other 2 v (hne 2)]
        simp
      · rcases Finset.mem_image.mp hv_img with ⟨j, _, rfl⟩
        rw [hκ₃_val_out (𝔮 j) (h𝔮_not_in j).2, one_mul]
        rcases hj_cases j with rfl | rfl | rfl
        · rw [hq_val_self 0,
              hq_val_other 1 (𝔮 0) (h𝔮_inj.ne (by decide)),
              hq_val_other 2 (𝔮 0) (h𝔮_inj.ne (by decide))]
          simp
        · rw [hq_val_other 0 (𝔮 1) (h𝔮_inj.ne (by decide)),
              hq_val_self 1,
              hq_val_other 2 (𝔮 1) (h𝔮_inj.ne (by decide))]
          simp
        · rw [hq_val_other 0 (𝔮 2) (h𝔮_inj.ne (by decide)),
              hq_val_other 1 (𝔮 2) (h𝔮_inj.ne (by decide)),
              hq_val_self 2]
          simp
    · intro v hv
      have hvS₃ : v ∉ S₃ := fun h => hv (hS₃_sub h)
      have hne : ∀ j : Fin 3, v ≠ 𝔮 j := by
        intro j hvj
        subst hvj
        exact hv (h𝔮_mem j)
      rw [hκ₄_coe]
      simp only [map_mul]
      rw [hκ₃_val_out v hvS₃,
          hq_val_other 0 v (hne 0),
          hq_val_other 1 v (hne 1),
          hq_val_other 2 v (hne 2)]
      simp
  have h_even_of_val_one : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (u : Kˣ),
      IsDedekindDomain.HeightOneSpectrum.valuation K v (u : K) = 1 → EvenVal v u := by
    intro v u hu
    have h1 : ((v.valuationOfNeZero u : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        ((1 : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v u, hu, WithZero.coe_one]
    have h2 : v.valuationOfNeZero u = 1 := WithZero.coe_inj.mp h1
    dsimp [EvenVal]
    rw [h2, toAdd_one]
    exact ⟨0, rfl⟩
  have h_not_even_of_val_neg_one : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (u : Kˣ),
      IsDedekindDomain.HeightOneSpectrum.valuation K v (u : K) = WithZero.exp (-1 : ℤ) →
      ¬ EvenVal v u := by
    intro v u hu
    have h1 : ((v.valuationOfNeZero u : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v u, hu]
      rfl
    have h2 : v.valuationOfNeZero u = Multiplicative.ofAdd (-1 : ℤ) := WithZero.coe_inj.mp h1
    dsimp [EvenVal]
    rw [h2, toAdd_ofAdd]
    rintro ⟨r, hr⟩
    omega
  have hz_val_out : ∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S₄ →
      IsDedekindDomain.HeightOneSpectrum.valuation K v ((basisTwistPair p q k).1 : K) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v ((basisTwistPair p q k).2 : K) = 1 := by
    intro k v _ hvS₄
    have hv_ne_𝔭 : v ≠ 𝔭 k := by
      intro hvk
      subst hvk
      exact hvS₄ (hS₃_sub (h𝔭_mem k))
    have hv_ne_𝔮 : v ≠ 𝔮 ⟨k.1 / 2, by omega⟩ := by
      intro hvq
      subst hvq
      exact hvS₄ (h𝔮_mem ⟨k.1 / 2, by omega⟩)
    have h_val_prod :
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          ((p k * q ⟨k.1 / 2, by omega⟩ : Kˣ) : K) = 1 := by
      rw [Units.val_mul, map_mul,
          hp_val_other k v hv_ne_𝔭,
          hq_val_other ⟨k.1 / 2, by omega⟩ v hv_ne_𝔮,
          one_mul]
    have h_val_one :
        IsDedekindDomain.HeightOneSpectrum.valuation K v ((1 : Kˣ) : K) = 1 := by
      simp
    dsimp only [basisTwistPair]
    split_ifs with hk_ev
    · exact ⟨h_val_prod, h_val_one⟩
    · exact ⟨h_val_one, h_val_prod⟩
  have hz_even_out : ∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S₄ →
      EvenVal v (basisTwistPair p q k).1 ∧ EvenVal v (basisTwistPair p q k).2 := by
    intro k v hvT hvS₄
    obtain ⟨h1, h2⟩ := hz_val_out k v hvT hvS₄
    exact ⟨h_even_of_val_one v _ h1, h_even_of_val_one v _ h2⟩
  have hz_𝔮 : ∀ m : Fin 3, ∀ k : Fin 6,
      (¬ EvenVal (𝔮 m) (basisTwistPair p q k).1 ↔ k = ⟨2 * m.1, by omega⟩) ∧
      (¬ EvenVal (𝔮 m) (basisTwistPair p q k).2 ↔ k = ⟨2 * m.1 + 1, by omega⟩) := by
    intro m k
    have h_active_odd_iff :
        ¬ EvenVal (𝔮 m) (p k * q ⟨k.1 / 2, by omega⟩) ↔
          (⟨k.1 / 2, by omega⟩ : Fin 3) = m := by
      by_cases hjm : (⟨k.1 / 2, by omega⟩ : Fin 3) = m
      · rw [hjm]
        have h_val :
            IsDedekindDomain.HeightOneSpectrum.valuation K (𝔮 m)
              ((p k * q m : Kˣ) : K) = WithZero.exp (-1 : ℤ) := by
          rw [Units.val_mul, map_mul,
              hp_val_other k (𝔮 m) (h𝔮_ne_𝔭 m k),
              hq_val_self m, one_mul]
        exact iff_of_true (h_not_even_of_val_neg_one (𝔮 m) _ h_val) rfl
      · have h_ne_𝔮 : 𝔮 m ≠ 𝔮 ⟨k.1 / 2, by omega⟩ := h𝔮_inj.ne (Ne.symm hjm)
        have h_val :
            IsDedekindDomain.HeightOneSpectrum.valuation K (𝔮 m)
              ((p k * q ⟨k.1 / 2, by omega⟩ : Kˣ) : K) = 1 := by
          rw [Units.val_mul, map_mul,
              hp_val_other k (𝔮 m) (h𝔮_ne_𝔭 m k),
              hq_val_other ⟨k.1 / 2, by omega⟩ (𝔮 m) h_ne_𝔮,
              one_mul]
        have h_ev : EvenVal (𝔮 m) (p k * q ⟨k.1 / 2, by omega⟩) :=
          h_even_of_val_one (𝔮 m) _ h_val
        exact iff_of_false (not_not.mpr h_ev) hjm
    have hev_one : ¬ EvenVal (𝔮 m) 1 ↔ False := by
      have h1 : EvenVal (𝔮 m) 1 := h_even_of_val_one (𝔮 m) 1 (by simp)
      exact iff_of_false (not_not.mpr h1) id
    have h_fin_ev : ∀ (m₀ : Fin 3) (k₀ : Fin 6), k₀.1 % 2 = 0 →
        ((⟨k₀.1 / 2, by omega⟩ : Fin 3) = m₀ ↔ k₀ = ⟨2 * m₀.1, by omega⟩) ∧
        (False ↔ k₀ = ⟨2 * m₀.1 + 1, by omega⟩) := by decide
    have h_fin_odd : ∀ (m₀ : Fin 3) (k₀ : Fin 6), ¬ (k₀.1 % 2 = 0) →
        (False ↔ k₀ = ⟨2 * m₀.1, by omega⟩) ∧
        ((⟨k₀.1 / 2, by omega⟩ : Fin 3) = m₀ ↔ k₀ = ⟨2 * m₀.1 + 1, by omega⟩) := by decide
    dsimp only [basisTwistPair]
    split_ifs with hk_ev
    · rw [h_active_odd_iff, hev_one]
      exact h_fin_ev m k hk_ev
    · rw [hev_one, h_active_odd_iff]
      exact h_fin_odd m k hk_ev
  exact ⟨S₄, π₄, κ₄, hS₃_sub, h𝔮_mem, hS₄_to_S₃, hdisj₄, hπ₄_S₃, hπ₄_𝔮, hπ₄_unif,
    hprin₄, hz_val_out, hz_even_out, hz_𝔮⟩

theorem isDescentClass_and_realSigns_of_basisTwistPair (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₃ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : Fin 3 → Kˣ)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hS₃ : IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭)
    (hq : IsBasisPrimeTuple K T S₃ p 𝔭 q 𝔮) :
    (∀ k : Fin 6, ∀ v ∈ T,
      IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (algebraMap K (v.adicCompletion K) ((basisTwistPair p q k).1 : K))
        (algebraMap K (v.adicCompletion K) ((basisTwistPair p q k).2 : K))) ∧
    (∀ k : Fin 6, ∀ w : NumberField.InfinitePlace K,
      IsDescentClass
        (algebraMap K w.Completion a₁)
        (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃)
        (algebraMap K w.Completion ((basisTwistPair p q k).1 : K))
        (algebraMap K w.Completion ((basisTwistPair p q k).2 : K))) ∧
    (∀ k j : Fin 6, Even k.1 →
      (realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).1 : K) < 0 ↔ j = k) ∧
      0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).2 : K) ∧
      (realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).1 : K) < 0 ↔ j = k) ∧
      0 < realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).2 : K)) ∧
    (∀ k j : Fin 6, Odd k.1 →
      0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).1 : K) ∧
      (realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).2 : K) < 0 ↔ j = k) ∧
      0 < realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).1 : K) ∧
      (realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).2 : K) < 0 ↔ j = k)) :=
by
  rcases hstart with ⟨_, _, _, _, _, _, _, _, _, _, _,
    hord0, hord1, hord2, hord3, hord4, hord5,
    hord6, hord7, hord8, hord9, hord10, hord11, _⟩
  rcases hS₃ with ⟨_, _, _, _, _, _, hp_sign1, hp_sign2, hp_sign_out, hp_sq_T, _, _, _⟩
  rcases hq with ⟨_, _, _, _, _, hq_pos, hq_sq_T, _, _, _, _⟩
  have hdesc_of_sq : ∀ {F : Type u} [Field F] (e₁ e₂ e₃ d₁ d₂ : F),
      IsSquare d₁ → IsSquare d₂ → IsDescentClass e₁ e₂ e₃ d₁ d₂ := by
    intro F _ e₁ e₂ e₃ d₁ d₂ ⟨r₁, hr₁⟩ ⟨r₂, hr₂⟩
    refine ⟨0, r₂, r₁, 1, ?_, ?_, ?_⟩
    · rintro ⟨_, _, _, h1⟩
      exact one_ne_zero h1
    · rw [hr₁, hr₂]; ring
    · rw [hr₁, hr₂]; ring
  have hz_T : ∀ k : Fin 6, ∀ v ∈ T,
      IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (algebraMap K (v.adicCompletion K) ((basisTwistPair p q k).1 : K))
        (algebraMap K (v.adicCompletion K) ((basisTwistPair p q k).2 : K)) := by
    intro k v hv
    let m : Fin 3 := ⟨k.1 / 2, by omega⟩
    have hw_sq : IsSquare (algebraMap K (v.adicCompletion K) ((p k * q m : Kˣ) : K)) := by
      rw [Units.val_mul, map_mul]
      exact (hp_sq_T k v hv).mul (hq_sq_T m v hv)
    have h1_sq : IsSquare (algebraMap K (v.adicCompletion K) ((1 : Kˣ) : K)) := by
      rw [Units.val_one, map_one]
      exact IsSquare.one
    by_cases hk : k.1 % 2 = 0 <;> simp only [basisTwistPair, hk, ↓reduceIte]
    · exact hdesc_of_sq _ _ _ _ _ hw_sq h1_sq
    · exact hdesc_of_sq _ _ _ _ _ h1_sq hw_sq
  have h_mul_q_neg : ∀ (w_r : {w : NumberField.InfinitePlace K // w.IsReal}) (k : Fin 6),
      realPlaceEmb w_r ((p k * q ⟨k.1 / 2, by omega⟩ : Kˣ) : K) < 0 ↔
        realPlaceEmb w_r (p k : K) < 0 := by
    intro w_r k
    rw [Units.val_mul, map_mul]
    have hq_pos_w := hq_pos ⟨k.1 / 2, by omega⟩ w_r
    constructor <;> intro h <;> nlinarith
  have h_one_pos : ∀ (w_r : {w : NumberField.InfinitePlace K // w.IsReal}),
      0 < realPlaceEmb w_r ((1 : Kˣ) : K) := by
    intro w_r
    rw [Units.val_one, map_one]
    exact zero_lt_one
  have hz_sign_even : ∀ k j : Fin 6, Even k.1 →
      (realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).1 : K) < 0 ↔ j = k) ∧
      0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).2 : K) ∧
      (realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).1 : K) < 0 ↔ j = k) ∧
      0 < realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).2 : K) := by
    intro k j hk
    have hk0 : k.1 % 2 = 0 := Nat.even_iff.mp hk
    simp only [basisTwistPair, hk0, ↓reduceIte]
    refine ⟨?_, h_one_pos (τ ⟨j.1, by omega⟩), ?_, h_one_pos (τ ⟨j.1 + 6, by omega⟩)⟩
    · rw [h_mul_q_neg]
      exact hp_sign1 k j
    · rw [h_mul_q_neg]
      exact hp_sign2 k j
  have hz_sign_odd : ∀ k j : Fin 6, Odd k.1 →
      0 < realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).1 : K) ∧
      (realPlaceEmb (τ ⟨j.1, by omega⟩) ((basisTwistPair p q k).2 : K) < 0 ↔ j = k) ∧
      0 < realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).1 : K) ∧
      (realPlaceEmb (τ ⟨j.1 + 6, by omega⟩) ((basisTwistPair p q k).2 : K) < 0 ↔ j = k) := by
    intro k j hk
    have hk1 : k.1 % 2 = 1 := Nat.odd_iff.mp hk
    have hk0 : ¬ (k.1 % 2 = 0) := by omega
    simp only [basisTwistPair, hk0, ↓reduceIte]
    refine ⟨h_one_pos (τ ⟨j.1, by omega⟩), ?_, h_one_pos (τ ⟨j.1 + 6, by omega⟩), ?_⟩
    · rw [h_mul_q_neg]
      exact hp_sign1 k j
    · rw [h_mul_q_neg]
      exact hp_sign2 k j
  have h_complex_sq : ∀ (w : NumberField.InfinitePlace K),
      w.IsComplex → ∀ y : w.Completion, IsSquare y := by
    intro w hw y
    obtain ⟨hf_inj, hf_surj⟩ :=
      NumberField.InfinitePlace.Completion.bijective_extensionEmbedding_of_isComplex hw
    obtain ⟨c, hc⟩ :=
      IsAlgClosed.exists_eq_mul_self (NumberField.InfinitePlace.Completion.extensionEmbedding w y)
    obtain ⟨z, hz⟩ := hf_surj c
    refine ⟨z, hf_inj ?_⟩
    rw [hc, ← hz, ← map_mul]
  have h_real_sq : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (x : K),
      0 ≤ realPlaceEmb ⟨w, hw⟩ x → IsSquare (algebraMap K w.Completion x) := by
    intro w hw x hx
    obtain ⟨hf_inj, hf_surj⟩ :=
      NumberField.InfinitePlace.Completion.bijective_extensionEmbeddingOfIsReal hw
    obtain ⟨z, hz⟩ := hf_surj (Real.sqrt (realPlaceEmb ⟨w, hw⟩ x))
    refine ⟨z, hf_inj ?_⟩
    rw [map_mul, hz, Real.mul_self_sqrt hx]
    exact NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe hw x
  have hdesc_real_even : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (u : Kˣ),
      realPlaceEmb ⟨w, hw⟩ (u : K) < 0 →
      realPlaceEmb ⟨w, hw⟩ a₂ < realPlaceEmb ⟨w, hw⟩ a₁ →
      realPlaceEmb ⟨w, hw⟩ a₂ < realPlaceEmb ⟨w, hw⟩ a₃ →
      IsDescentClass
        (algebraMap K w.Completion a₁)
        (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃)
        (algebraMap K w.Completion (u : K))
        (algebraMap K w.Completion ((1 : Kˣ) : K)) := by
    intro w hw u hu_neg ha₂₁ ha₂₃
    let x₁ : K := (a₂ - a₁) / (u : K)
    let x₃ : K := (a₃ - a₂) / -(u : K)
    have hx₁_nonneg : 0 ≤ realPlaceEmb ⟨w, hw⟩ x₁ := by
      dsimp [x₁]
      rw [map_div₀, map_sub]
      exact le_of_lt (div_pos_of_neg_of_neg (sub_neg.mpr ha₂₁) hu_neg)
    have hx₃_nonneg : 0 ≤ realPlaceEmb ⟨w, hw⟩ x₃ := by
      dsimp [x₃]
      rw [map_div₀, map_sub, map_neg]
      exact le_of_lt (div_pos (sub_pos.mpr ha₂₃) (neg_pos.mpr hu_neg))
    obtain ⟨z₁, hz₁⟩ := h_real_sq w hw x₁ hx₁_nonneg
    obtain ⟨z₃, hz₃⟩ := h_real_sq w hw x₃ hx₃_nonneg
    have hx₁_mul : (u : K) * x₁ = a₂ - a₁ := mul_div_cancel₀ _ u.ne_zero
    have hx₃_mul : (u : K) * x₃ = -(a₃ - a₂) := by
      dsimp [x₃]
      rw [div_neg, mul_neg, mul_div_cancel₀ _ u.ne_zero]
    have hz₁_sq : algebraMap K w.Completion (u : K) * z₁ ^ 2 =
        algebraMap K w.Completion a₂ - algebraMap K w.Completion a₁ := by
      rw [sq, ← hz₁, ← map_mul, hx₁_mul, map_sub]
    have hz₃_sq : algebraMap K w.Completion (u : K) *
        algebraMap K w.Completion ((1 : Kˣ) : K) * z₃ ^ 2 =
        -(algebraMap K w.Completion a₃ - algebraMap K w.Completion a₂) := by
      rw [Units.val_one, map_one, mul_one, sq, ← hz₃, ← map_mul, hx₃_mul, map_neg, map_sub]
    refine ⟨1, z₁, 0, z₃, ?_, ?_, ?_⟩
    · rintro ⟨h1, _, _, _⟩
      exact one_ne_zero h1
    · rw [hz₁_sq]; ring
    · rw [hz₁_sq, hz₃_sq]; ring
  have hdesc_real_odd : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (u : Kˣ),
      realPlaceEmb ⟨w, hw⟩ (u : K) < 0 →
      realPlaceEmb ⟨w, hw⟩ a₁ < realPlaceEmb ⟨w, hw⟩ a₂ →
      realPlaceEmb ⟨w, hw⟩ a₁ < realPlaceEmb ⟨w, hw⟩ a₃ →
      IsDescentClass
        (algebraMap K w.Completion a₁)
        (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃)
        (algebraMap K w.Completion ((1 : Kˣ) : K))
        (algebraMap K w.Completion (u : K)) := by
    intro w hw u hu_neg ha₁₂ ha₁₃
    let x₂ : K := (a₂ - a₁) / -(u : K)
    let x₃ : K := (a₃ - a₁) / -(u : K)
    have hx₂_nonneg : 0 ≤ realPlaceEmb ⟨w, hw⟩ x₂ := by
      dsimp [x₂]
      rw [map_div₀, map_sub, map_neg]
      exact le_of_lt (div_pos (sub_pos.mpr ha₁₂) (neg_pos.mpr hu_neg))
    have hx₃_nonneg : 0 ≤ realPlaceEmb ⟨w, hw⟩ x₃ := by
      dsimp [x₃]
      rw [map_div₀, map_sub, map_neg]
      exact le_of_lt (div_pos (sub_pos.mpr ha₁₃) (neg_pos.mpr hu_neg))
    obtain ⟨z₂, hz₂⟩ := h_real_sq w hw x₂ hx₂_nonneg
    obtain ⟨z₃, hz₃⟩ := h_real_sq w hw x₃ hx₃_nonneg
    have hx₂_mul : (u : K) * x₂ = -(a₂ - a₁) := by
      dsimp [x₂]
      rw [div_neg, mul_neg, mul_div_cancel₀ _ u.ne_zero]
    have hx₃_mul : (u : K) * x₃ = -(a₃ - a₁) := by
      dsimp [x₃]
      rw [div_neg, mul_neg, mul_div_cancel₀ _ u.ne_zero]
    have hz₂_sq : algebraMap K w.Completion (u : K) * z₂ ^ 2 =
        -(algebraMap K w.Completion a₂ - algebraMap K w.Completion a₁) := by
      rw [sq, ← hz₂, ← map_mul, hx₂_mul, map_neg, map_sub]
    have hz₃_sq : algebraMap K w.Completion ((1 : Kˣ) : K) *
        algebraMap K w.Completion (u : K) * z₃ ^ 2 =
        -(algebraMap K w.Completion a₃ - algebraMap K w.Completion a₁) := by
      rw [Units.val_one, map_one, one_mul, sq, ← hz₃, ← map_mul, hx₃_mul, map_neg, map_sub]
    refine ⟨1, 0, z₂, z₃, ?_, ?_, ?_⟩
    · rintro ⟨h1, _, _, _⟩
      exact one_ne_zero h1
    · rw [hz₂_sq]; ring
    · rw [hz₃_sq]; ring
  have hz_inf : ∀ k : Fin 6, ∀ w : NumberField.InfinitePlace K,
      IsDescentClass
        (algebraMap K w.Completion a₁)
        (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃)
        (algebraMap K w.Completion ((basisTwistPair p q k).1 : K))
        (algebraMap K w.Completion ((basisTwistPair p q k).2 : K)) := by
    intro k w
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · let w_r : {w : NumberField.InfinitePlace K // w.IsReal} := ⟨w, hw⟩
      let m : Fin 3 := ⟨k.1 / 2, by omega⟩
      let u : Kˣ := p k * q m
      rcases le_or_gt 0 (realPlaceEmb w_r (p k : K)) with hp_nonneg | hp_neg
      · have hu_nonneg : 0 ≤ realPlaceEmb w_r (u : K) := by
          rw [show (u : K) = (p k : K) * (q m : K) from Units.val_mul _ _, map_mul]
          exact mul_nonneg hp_nonneg (le_of_lt (hq_pos m w_r))
        have hu_sq : IsSquare (algebraMap K w.Completion (u : K)) :=
          h_real_sq w hw (u : K) hu_nonneg
        have h1_sq : IsSquare (algebraMap K w.Completion ((1 : Kˣ) : K)) := by
          rw [Units.val_one, map_one]
          exact IsSquare.one
        by_cases hk : k.1 % 2 = 0 <;> simp only [basisTwistPair, hk, ↓reduceIte]
        · exact hdesc_of_sq _ _ _ _ _ hu_sq h1_sq
        · exact hdesc_of_sq _ _ _ _ _ h1_sq hu_sq
      · have hw_r_eq : (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) = τ ⟨k.1, by omega⟩ ∨
            (⟨w, hw⟩ : {w : NumberField.InfinitePlace K // w.IsReal}) = τ ⟨k.1 + 6, by omega⟩ := by
          by_contra h_not
          push_neg at h_not
          have h_not_tau : ∀ i : Fin 12, w_r ≠ τ i := by
            intro i hi
            by_cases h6 : i.1 < 6
            · let j : Fin 6 := ⟨i.1, h6⟩
              have hi_eq : i = ⟨j.1, by omega⟩ := Fin.ext rfl
              rw [hi_eq] at hi
              have hjk : j = k := (hp_sign1 k j).mp (by rw [← hi]; exact hp_neg)
              subst hjk
              exact h_not.1 hi
            · let j : Fin 6 := ⟨i.1 - 6, by omega⟩
              have hi_eq : i = ⟨j.1 + 6, by omega⟩ := by ext; dsimp [j]; omega
              rw [hi_eq] at hi
              have hjk : j = k := (hp_sign2 k j).mp (by rw [← hi]; exact hp_neg)
              subst hjk
              exact h_not.2 hi
          have hp_pos := hp_sign_out k w_r h_not_tau
          linarith
        have hu_neg : realPlaceEmb w_r (u : K) < 0 := (h_mul_q_neg w_r k).mpr hp_neg
        fin_cases k
        · change IsDescentClass _ _ _
            (algebraMap K w.Completion ((p 0 * q 0 : Kˣ) : K))
            (algebraMap K w.Completion ((1 : Kˣ) : K))
          rcases hw_r_eq with h_tau | h_tau
          · exact hdesc_real_even w hw (p 0 * q 0) hu_neg
              (by rw [h_tau]; exact hord0.1)
              (by rw [h_tau]; exact lt_trans hord0.1 hord0.2)
          · exact hdesc_real_even w hw (p 0 * q 0) hu_neg
              (by rw [h_tau]; exact hord6.1)
              (by rw [h_tau]; exact lt_trans hord6.1 hord6.2)
        · change IsDescentClass _ _ _
            (algebraMap K w.Completion ((1 : Kˣ) : K))
            (algebraMap K w.Completion ((p 1 * q 0 : Kˣ) : K))
          rcases hw_r_eq with h_tau | h_tau
          · exact hdesc_real_odd w hw (p 1 * q 0) hu_neg
              (by rw [h_tau]; exact hord1.1)
              (by rw [h_tau]; exact lt_trans hord1.1 hord1.2)
          · exact hdesc_real_odd w hw (p 1 * q 0) hu_neg
              (by rw [h_tau]; exact hord7.1)
              (by rw [h_tau]; exact lt_trans hord7.1 hord7.2)
        · change IsDescentClass _ _ _
            (algebraMap K w.Completion ((p 2 * q 1 : Kˣ) : K))
            (algebraMap K w.Completion ((1 : Kˣ) : K))
          rcases hw_r_eq with h_tau | h_tau
          · exact hdesc_real_even w hw (p 2 * q 1) hu_neg
              (by rw [h_tau]; exact lt_trans hord2.1 hord2.2)
              (by rw [h_tau]; exact hord2.1)
          · exact hdesc_real_even w hw (p 2 * q 1) hu_neg
              (by rw [h_tau]; exact lt_trans hord8.1 hord8.2)
              (by rw [h_tau]; exact hord8.1)
        · change IsDescentClass _ _ _
            (algebraMap K w.Completion ((1 : Kˣ) : K))
            (algebraMap K w.Completion ((p 3 * q 1 : Kˣ) : K))
          rcases hw_r_eq with h_tau | h_tau
          · exact hdesc_real_odd w hw (p 3 * q 1) hu_neg
              (by rw [h_tau]; exact lt_trans hord3.1 hord3.2)
              (by rw [h_tau]; exact hord3.1)
          · exact hdesc_real_odd w hw (p 3 * q 1) hu_neg
              (by rw [h_tau]; exact lt_trans hord9.1 hord9.2)
              (by rw [h_tau]; exact hord9.1)
        · change IsDescentClass _ _ _
            (algebraMap K w.Completion ((p 4 * q 2 : Kˣ) : K))
            (algebraMap K w.Completion ((1 : Kˣ) : K))
          rcases hw_r_eq with h_tau | h_tau
          · exact hdesc_real_even w hw (p 4 * q 2) hu_neg
              (by rw [h_tau]; exact hord4.1)
              (by rw [h_tau]; exact lt_trans hord4.1 hord4.2)
          · exact hdesc_real_even w hw (p 4 * q 2) hu_neg
              (by rw [h_tau]; exact hord10.1)
              (by rw [h_tau]; exact lt_trans hord10.1 hord10.2)
        · change IsDescentClass _ _ _
            (algebraMap K w.Completion ((1 : Kˣ) : K))
            (algebraMap K w.Completion ((p 5 * q 2 : Kˣ) : K))
          rcases hw_r_eq with h_tau | h_tau
          · exact hdesc_real_odd w hw (p 5 * q 2) hu_neg
              (by rw [h_tau]; exact hord5.1)
              (by rw [h_tau]; exact lt_trans hord5.1 hord5.2)
          · exact hdesc_real_odd w hw (p 5 * q 2) hu_neg
              (by rw [h_tau]; exact hord11.1)
              (by rw [h_tau]; exact lt_trans hord11.1 hord11.2)
    · exact hdesc_of_sq _ _ _ _ _ (h_complex_sq w hw _) (h_complex_sq w hw _)
  exact ⟨hz_T, hz_inf, hz_sign_even, hz_sign_odd⟩

theorem ramLocal_of_basisTwistPair (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₃ S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₃ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : Fin 3 → Kˣ)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hS₃ : IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭)
    (hq : IsBasisPrimeTuple K T S₃ p 𝔭 q 𝔮)
    (hrec : IsBasisPrimeReciprocity K a₁ a₂ a₃ p q 𝔮)
    (hS₄_to_S₃ : ∀ v ∈ S₄, (∀ j : Fin 3, v ≠ 𝔮 j) → v ∈ S₃)
    (hπ₄_S₃ : ∀ v ∈ S₃, π₄ v = π₃ v)
    (hπ₄_𝔮 : ∀ j : Fin 3, π₄ (𝔮 j) =
      algebraMap K ((𝔮 j).adicCompletion K)
        ((p ⟨2 * j.1, by omega⟩ * q j : Kˣ) : K)) :
    ∀ k : Fin 6, ∀ v ∈ S₄,
      RamLocal a₁ a₂ a₃ v (π₄ v) (basisTwistPair p q k).1 (basisTwistPair p q k).2 :=
by
  have h_ram_of_sq : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (π_v : v.adicCompletion K) (k : Fin 6),
      IsSquare (algebraMap K (v.adicCompletion K) ((p k * q ⟨k.1 / 2, by omega⟩ : Kˣ) : K)) →
      RamLocal a₁ a₂ a₃ v π_v (basisTwistPair p q k).1 (basisTwistPair p q k).2 := by
    intro v π_v k hsq
    apply Or.inl
    dsimp [basisTwistPair]
    have h1 : IsSquare (algebraMap K (v.adicCompletion K) ((1 : Kˣ) : K)) := by
      rw [Units.val_one, map_one]
      exact IsSquare.one
    split_ifs with hk
    · exact ⟨hsq, h1⟩
    · exact ⟨h1, hsq⟩
  rcases hS₃ with ⟨_hS₃_rk0, _h𝔭_inj, h𝔭_mem_S₃, _hp_int, _hp_val_self, _hp_val_ne,
    _hp_sign1, _hp_sign2, _hp_sign_out, _hp_sq_T, hp_sq_S₃, hp_sq_𝔭, hS₃_ram⟩
  rcases hq with ⟨_h𝔮_inj, h𝔮_not_mem, _hq_int, _hq_val_self, hq_val_ne,
    _hq_pos, _hq_sq_T, hq_sq_S₃, hq_sq_𝔭, hq_partner, _hq_sq_lt⟩
  rcases hrec with ⟨hrec_p_sq, hrec_p_prod, hrec_q_sq, hrec_roots⟩
  have hj0 : ∀ j : Fin 3, 2 * j.1 < 6 := by omega
  have hj1 : ∀ j : Fin 3, 2 * j.1 + 1 < 6 := by omega
  have h_case_S₃ : ∀ (k : Fin 6) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∈ S₃ →
      RamLocal a₁ a₂ a₃ v (π₃ v) (basisTwistPair p q k).1 (basisTwistPair p q k).2 := by
    intro k v hvS₃
    obtain ⟨j, hj_eq⟩ : ∃ j : Fin 3, (⟨k.1 / 2, by omega⟩ : Fin 3) = j := ⟨_, rfl⟩
    have hj_val : k.1 / 2 = j.1 := congrArg Fin.val hj_eq
    rcases Classical.em (∃ i : Fin 6, v = 𝔭 i) with ⟨i, rfl⟩ | hno
    · rcases Classical.em (i = k) with rfl | hi_ne
      · have h𝔭k_ne_𝔮j : 𝔭 i ≠ 𝔮 j := fun h => (h𝔮_not_mem j).2 (h ▸ h𝔭_mem_S₃ i)
        have hq_val_1 : IsDedekindDomain.HeightOneSpectrum.valuation K (𝔭 i) (q j : K) = 1 :=
          hq_val_ne j (𝔭 i) h𝔭k_ne_𝔮j
        have hq_nsq : ¬ IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (q j : K)) :=
          fun h => (hq_sq_𝔭 i j).mp h hj_val
        have hram_both := hS₃_ram i (q j) hq_val_1 hq_nsq
        dsimp [basisTwistPair]
        rw [hj_eq]
        split_ifs with hk
        · exact hram_both.1
        · exact hram_both.2
      · rcases Classical.em (i.1 / 2 = k.1 / 2) with hik_div | hik_ndiv
        · have hik_cases : (i.1 = 2 * j.1 ∧ k.1 = 2 * j.1 + 1) ∨ (i.1 = 2 * j.1 + 1 ∧ k.1 = 2 * j.1) := by
            have hik_val_ne : i.1 ≠ k.1 := fun h => hi_ne (Fin.ext h)
            omega
          rcases hik_cases with ⟨hi_val, hk_val⟩ | ⟨hi_val, hk_val⟩
          · have hi_eq : i = ⟨2 * j.1, hj0 j⟩ := Fin.ext hi_val
            have hk_eq : k = ⟨2 * j.1 + 1, hj1 j⟩ := Fin.ext hk_val
            apply h_ram_of_sq (𝔭 i) (π₃ (𝔭 i)) k
            rw [hj_eq, Units.val_mul, hi_eq, hk_eq]
            exact (hq_partner j).1
          · have hi_eq : i = ⟨2 * j.1 + 1, hj1 j⟩ := Fin.ext hi_val
            have hk_eq : k = ⟨2 * j.1, hj0 j⟩ := Fin.ext hk_val
            apply h_ram_of_sq (𝔭 i) (π₃ (𝔭 i)) k
            rw [hj_eq, Units.val_mul, hi_eq, hk_eq]
            exact (hq_partner j).2
        · have h_not_pair : ¬ ((i.1 = 0 ∧ k.1 = 1) ∨ (i.1 = 1 ∧ k.1 = 0) ∨
              (i.1 = 2 ∧ k.1 = 3) ∨ (i.1 = 3 ∧ k.1 = 2) ∨
              (i.1 = 4 ∧ k.1 = 5) ∨ (i.1 = 5 ∧ k.1 = 4)) := by omega
          have hp_sq : IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (p k : K)) :=
            (hp_sq_𝔭 i k hi_ne).mpr h_not_pair
          have hq_sq : IsSquare (algebraMap K ((𝔭 i).adicCompletion K) (q j : K)) :=
            (hq_sq_𝔭 i j).mpr (by omega)
          apply h_ram_of_sq (𝔭 i) (π₃ (𝔭 i)) k
          rw [hj_eq, Units.val_mul, map_mul]
          exact hp_sq.mul hq_sq
    · have hv_ne : ∀ i : Fin 6, v ≠ 𝔭 i := fun i hi => hno ⟨i, hi⟩
      have hp_sq : IsSquare (algebraMap K (v.adicCompletion K) (p k : K)) :=
        hp_sq_S₃ k v hvS₃ hv_ne
      have hq_sq : IsSquare (algebraMap K (v.adicCompletion K) (q j : K)) :=
        hq_sq_S₃ j v hvS₃ hv_ne
      apply h_ram_of_sq v (π₃ v) k
      rw [hj_eq, Units.val_mul, map_mul]
      exact hp_sq.mul hq_sq
  have h_case_𝔮 : ∀ (k : Fin 6) (m : Fin 3),
      RamLocal a₁ a₂ a₃ (𝔮 m) (π₄ (𝔮 m)) (basisTwistPair p q k).1 (basisTwistPair p q k).2 := by
    intro k m
    obtain ⟨j, hj_eq⟩ : ∃ j : Fin 3, (⟨k.1 / 2, by omega⟩ : Fin 3) = j := ⟨_, rfl⟩
    have hj_val : k.1 / 2 = j.1 := congrArg Fin.val hj_eq
    rcases Classical.em (k.1 / 2 = m.1) with hkm_eq | hkm_ne
    · rcases hrec_roots m with ⟨⟨r_neg1, hr_neg1⟩, ⟨r_12, hr_12⟩, ⟨r_13, hr_13⟩, ⟨r_23, hr_23⟩⟩
      have hjm_eq : (⟨k.1 / 2, by omega⟩ : Fin 3) = m := Fin.ext hkm_eq
      by_cases hk_ev : k.1 % 2 = 0
      · have hk_eq : k = ⟨2 * m.1, by omega⟩ := by
          ext; dsimp; omega
        dsimp [basisTwistPair]
        rw [if_pos hk_ev, hjm_eq, hk_eq, hπ₄_𝔮 m]
        apply Or.inr
        apply Or.inr
        apply Or.inl
        have h_neg1 : -(1 : (𝔮 m).adicCompletion K) = r_neg1 * r_neg1 := by
          simpa [map_neg, map_one] using hr_neg1
        refine ⟨?_, ?_⟩
        · refine ⟨r_neg1 * r_12 * algebraMap K ((𝔮 m).adicCompletion K) ((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K), ?_⟩
          calc -(algebraMap K ((𝔮 m).adicCompletion K) ((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K) *
                  algebraMap K ((𝔮 m).adicCompletion K) (((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K) * (a₁ - a₂)))
            _ = -(1 : (𝔮 m).adicCompletion K) *
                  algebraMap K ((𝔮 m).adicCompletion K) (a₁ - a₂) *
                  algebraMap K ((𝔮 m).adicCompletion K) ((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K) *
                  algebraMap K ((𝔮 m).adicCompletion K) ((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K) := by
                rw [map_mul]; ring
            _ = (r_neg1 * r_12 * algebraMap K ((𝔮 m).adicCompletion K) ((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K)) *
                (r_neg1 * r_12 * algebraMap K ((𝔮 m).adicCompletion K) ((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K)) := by
                rw [h_neg1, hr_12]; ring
        · refine ⟨r_neg1 * r_12 * r_23, ?_⟩
          calc algebraMap K ((𝔮 m).adicCompletion K) (-(((1 : Kˣ) : K) * (a₁ - a₂) * (a₂ - a₃)))
            _ = -(1 : (𝔮 m).adicCompletion K) *
                  algebraMap K ((𝔮 m).adicCompletion K) (a₁ - a₂) *
                  algebraMap K ((𝔮 m).adicCompletion K) (a₂ - a₃) := by
                simp only [Units.val_one, map_neg, map_mul, map_one]; ring
            _ = (r_neg1 * r_12 * r_23) * (r_neg1 * r_12 * r_23) := by
                rw [h_neg1, hr_12, hr_23]; ring
      · have hk_eq : k = ⟨2 * m.1 + 1, by omega⟩ := by
          ext; dsimp; omega
        rcases hrec_p_prod m with ⟨r_p, hr_p⟩
        dsimp [basisTwistPair]
        rw [if_neg hk_ev, hjm_eq, hk_eq, hπ₄_𝔮 m]
        apply Or.inr
        apply Or.inl
        refine ⟨?_, ?_⟩
        · refine ⟨r_12 * r_13, ?_⟩
          calc algebraMap K ((𝔮 m).adicCompletion K) (((1 : Kˣ) : K) * (a₁ - a₂) * (a₁ - a₃))
            _ = algebraMap K ((𝔮 m).adicCompletion K) (a₁ - a₂) *
                  algebraMap K ((𝔮 m).adicCompletion K) (a₁ - a₃) := by
                simp only [Units.val_one, map_mul, map_one]; ring
            _ = (r_12 * r_13) * (r_12 * r_13) := by
                rw [hr_12, hr_13]; ring
        · refine ⟨r_p * r_12 * algebraMap K ((𝔮 m).adicCompletion K) (q m : K), ?_⟩
          have hr_p' : algebraMap K ((𝔮 m).adicCompletion K) (p ⟨2 * m.1, by omega⟩ : K) *
              algebraMap K ((𝔮 m).adicCompletion K) (p ⟨2 * m.1 + 1, by omega⟩ : K) = r_p * r_p := by
            simpa [map_mul] using hr_p
          calc algebraMap K ((𝔮 m).adicCompletion K) ((p ⟨2 * m.1, by omega⟩ * q m : Kˣ) : K) *
                algebraMap K ((𝔮 m).adicCompletion K) (((p ⟨2 * m.1 + 1, by omega⟩ * q m : Kˣ) : K) * (a₁ - a₂))
            _ = (algebraMap K ((𝔮 m).adicCompletion K) (p ⟨2 * m.1, by omega⟩ : K) *
                  algebraMap K ((𝔮 m).adicCompletion K) (p ⟨2 * m.1 + 1, by omega⟩ : K)) *
                algebraMap K ((𝔮 m).adicCompletion K) (a₁ - a₂) *
                algebraMap K ((𝔮 m).adicCompletion K) (q m : K) *
                algebraMap K ((𝔮 m).adicCompletion K) (q m : K) := by
                simp only [Units.val_mul, map_mul]; ring
            _ = (r_p * r_12 * algebraMap K ((𝔮 m).adicCompletion K) (q m : K)) *
                (r_p * r_12 * algebraMap K ((𝔮 m).adicCompletion K) (q m : K)) := by
                rw [hr_p', hr_12]; ring
    · have hp_sq : IsSquare (algebraMap K ((𝔮 m).adicCompletion K) (p k : K)) :=
        (hrec_p_sq k m).mpr hkm_ne
      have hmj_ne : m ≠ j := fun h => hkm_ne (by rw [hj_val, h])
      have hq_sq : IsSquare (algebraMap K ((𝔮 m).adicCompletion K) (q j : K)) :=
        hrec_q_sq m j hmj_ne
      apply h_ram_of_sq (𝔮 m) (π₄ (𝔮 m)) k
      rw [hj_eq, Units.val_mul, map_mul]
      exact hp_sq.mul hq_sq
  intro k v hvS₄
  rcases Classical.em (∃ m : Fin 3, v = 𝔮 m) with ⟨m, rfl⟩ | hno_𝔮
  · exact h_case_𝔮 k m
  · have hvS₃ : v ∈ S₃ := hS₄_to_S₃ v hvS₄ (fun m hm => hno_𝔮 ⟨m, hm⟩)
    rw [hπ₄_S₃ v hvS₃]
    exact h_case_S₃ k v hvS₃

theorem selmerStruct_span_of_basis_prime_stripping (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (T S₃ S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (z : Fin 6 → Kˣ × Kˣ)
    (hmul : IsLocalMulClosed K a₁ a₂ a₃)
    (hS₃_sub : S₃ ⊆ S₄)
    (hS₄_to_S₃ : ∀ v ∈ S₄, (∀ j : Fin 3, v ≠ 𝔮 j) → v ∈ S₃)
    (hπ₄_S₃ : ∀ v ∈ S₃, π₄ v = π₃ v)
    (hπ₄_unif : ∀ v ∈ S₄, IsLocalUnif v (π₄ v))
    (hsel₃_triv : ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S₃ π₃, c = 1)
    (hz_T : ∀ k : Fin 6, ∀ v ∈ T,
      IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (algebraMap K (v.adicCompletion K) ((z k).1 : K))
        (algebraMap K (v.adicCompletion K) ((z k).2 : K)))
    (hz_inf : ∀ k : Fin 6, ∀ w : NumberField.InfinitePlace K,
      IsDescentClass
        (algebraMap K w.Completion a₁)
        (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃)
        (algebraMap K w.Completion ((z k).1 : K))
        (algebraMap K w.Completion ((z k).2 : K)))
    (hz_ram : ∀ k : Fin 6, ∀ v ∈ S₄, RamLocal a₁ a₂ a₃ v (π₄ v) (z k).1 (z k).2)
    (hz_even : ∀ k : Fin 6, ∀ v, v ∉ T → v ∉ S₄ → EvenVal v (z k).1 ∧ EvenVal v (z k).2)
    (hz_𝔮 : ∀ m : Fin 3, ∀ k : Fin 6,
      (¬ EvenVal (𝔮 m) (z k).1 ↔ k = ⟨2 * m.1, by omega⟩) ∧
      (¬ EvenVal (𝔮 m) (z k).2 ↔ k = ⟨2 * m.1 + 1, by omega⟩)) :
    ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S₄ π₄,
      ∃ I : Finset (Fin 6), c = ∏ k ∈ I, (sqCl (z k).1, sqCl (z k).2) :=
by
  classical
  have h_even_one : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      EvenVal v (1 : Kˣ) := by
    intro v
    change Even (Multiplicative.toAdd (v.valuationOfNeZero (1 : Kˣ)))
    rw [map_one, toAdd_one]
    exact Even.zero
  have h_even_mul_iff : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), EvenVal v (x * y) ↔ (EvenVal v x ↔ EvenVal v y) := by
    intro v x y
    change Even (Multiplicative.toAdd (v.valuationOfNeZero (x * y))) ↔
      (Even (Multiplicative.toAdd (v.valuationOfNeZero x)) ↔
       Even (Multiplicative.toAdd (v.valuationOfNeZero y)))
    rw [map_mul, toAdd_mul]
    exact Int.even_add
  have h_even_mul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), EvenVal v x → EvenVal v y → EvenVal v (x * y) := by
    intro v x y hx hy
    exact (h_even_mul_iff v x y).mpr (iff_of_true hx hy)
  have h_even_of_not_iff : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), (¬ EvenVal v x ↔ ¬ EvenVal v y) → EvenVal v (x * y) := by
    intro v x y h
    rw [h_even_mul_iff v x y]
    tauto
  have h_even_prod : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (J : Finset (Fin 6)) (f : Fin 6 → Kˣ),
      (∀ k ∈ J, EvenVal v (f k)) → EvenVal v (∏ k ∈ J, f k) := by
    intro v J f
    induction J using Finset.induction with
    | empty =>
      intro _
      rw [Finset.prod_empty]
      exact h_even_one v
    | insert a J ha ih =>
      intro hJ
      rw [Finset.prod_insert ha]
      exact h_even_mul v (f a) (∏ k ∈ J, f k)
        (hJ a (Finset.mem_insert_self a J))
        (ih (fun k hk => hJ k (Finset.mem_insert_of_mem hk)))
  have h_not_even_prod_iff :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (f : Fin 6 → Kˣ) (k₀ : Fin 6),
        (∀ k : Fin 6, ¬ EvenVal v (f k) ↔ k = k₀) →
        ∀ I : Finset (Fin 6), ¬ EvenVal v (∏ k ∈ I, f k) ↔ k₀ ∈ I := by
    intro v f k₀ h_char I
    have h_k₀_odd : ¬ EvenVal v (f k₀) := (h_char k₀).mpr rfl
    have h_ne_even : ∀ k : Fin 6, k ≠ k₀ → EvenVal v (f k) := by
      intro k hne
      have h1 : ¬ ¬ EvenVal v (f k) := mt (h_char k).mp hne
      exact not_not.mp h1
    by_cases hk₀ : k₀ ∈ I
    · rw [← Finset.mul_prod_erase I f hk₀]
      have h_er_ev : EvenVal v (∏ k ∈ I.erase k₀, f k) := by
        apply h_even_prod v (I.erase k₀) f
        intro k hk
        exact h_ne_even k (Finset.mem_erase.mp hk).1
      constructor
      · intro _
        exact hk₀
      · intro _ h_prod_ev
        have h_iff := (h_even_mul_iff v (f k₀) (∏ k ∈ I.erase k₀, f k)).mp h_prod_ev
        exact h_k₀_odd (h_iff.mpr h_er_ev)
    · have h_all_ev : EvenVal v (∏ k ∈ I, f k) := by
        apply h_even_prod v I f
        intro k hk
        apply h_ne_even k
        rintro rfl
        exact hk₀ hk
      constructor
      · intro h_odd
        exact False.elim (h_odd h_all_ev)
      · intro hk₀_in
        exact False.elim (hk₀ hk₀_in)
  have h_desc_one : ∀ (F : Type u) [Field F] (e₁ e₂ e₃ : F), IsDescentClass e₁ e₂ e₃ 1 1 := by
    intro F _ e₁ e₂ e₃
    refine ⟨0, 1, 1, 1, ?_, by ring, by ring⟩
    rintro ⟨_, h1, _, _⟩
    exact one_ne_zero h1
  have h_ram_one : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (π_v : v.adicCompletion K), RamLocal a₁ a₂ a₃ v π_v 1 1 := by
    intro v π_v
    exact Or.inl ⟨⟨1, by simp⟩, ⟨1, by simp⟩⟩
  let Z₁ : Finset (Fin 6) → Kˣ := fun I => ∏ k ∈ I, (z k).1
  let Z₂ : Finset (Fin 6) → Kˣ := fun I => ∏ k ∈ I, (z k).2
  have hZ_local : ∀ I : Finset (Fin 6),
      (∀ v ∈ T, IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (algebraMap K (v.adicCompletion K) (Z₁ I : K))
        (algebraMap K (v.adicCompletion K) (Z₂ I : K))) ∧
      (∀ w : NumberField.InfinitePlace K, IsDescentClass
        (algebraMap K w.Completion a₁)
        (algebraMap K w.Completion a₂)
        (algebraMap K w.Completion a₃)
        (algebraMap K w.Completion (Z₁ I : K))
        (algebraMap K w.Completion (Z₂ I : K))) ∧
      (∀ v ∈ S₄, RamLocal a₁ a₂ a₃ v (π₄ v) (Z₁ I) (Z₂ I)) ∧
      (∀ v, v ∉ T → v ∉ S₄ → EvenVal v (Z₁ I) ∧ EvenVal v (Z₂ I)) := by
    intro I
    induction I using Finset.induction with
    | empty =>
      have hZ₁_empty : Z₁ ∅ = 1 := Finset.prod_empty
      have hZ₂_empty : Z₂ ∅ = 1 := Finset.prod_empty
      rw [hZ₁_empty, hZ₂_empty]
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro v _
        simp only [Units.val_one, map_one]
        exact h_desc_one (v.adicCompletion K) _ _ _
      · intro w
        simp only [Units.val_one, map_one]
        exact h_desc_one w.Completion _ _ _
      · intro v _
        exact h_ram_one v (π₄ v)
      · intro v _ _
        exact ⟨h_even_one v, h_even_one v⟩
    | insert a I ha ih =>
      have hZ₁_ins : Z₁ (insert a I) = (z a).1 * Z₁ I := Finset.prod_insert ha
      have hZ₂_ins : Z₂ (insert a I) = (z a).2 * Z₂ I := Finset.prod_insert ha
      rw [hZ₁_ins, hZ₂_ins]
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro v hv
        exact hmul.1 v (z a).1 (z a).2 (Z₁ I) (Z₂ I) (hz_T a v hv) (ih.1 v hv)
      · intro w
        exact hmul.2.1 w (z a).1 (z a).2 (Z₁ I) (Z₂ I) (hz_inf a w) (ih.2.1 w)
      · intro v hv
        exact hmul.2.2 v (π₄ v) (z a).1 (z a).2 (Z₁ I) (Z₂ I) (hπ₄_unif v hv)
          (hz_ram a v hv) (ih.2.2.1 v hv)
      · intro v hvT hvS₄
        exact ⟨h_even_mul v (z a).1 (Z₁ I) (hz_even a v hvT hvS₄).1 (ih.2.2.2 v hvT hvS₄).1,
               h_even_mul v (z a).2 (Z₂ I) (hz_even a v hvT hvS₄).2 (ih.2.2.2 v hvT hvS₄).2⟩
  have hZ_sqCl_prod : ∀ I : Finset (Fin 6),
      (sqCl (Z₁ I), sqCl (Z₂ I)) = ∏ k ∈ I, (sqCl (z k).1, sqCl (z k).2) := by
    intro I
    induction I using Finset.induction with
    | empty =>
      have hZ₁_empty : Z₁ ∅ = 1 := Finset.prod_empty
      have hZ₂_empty : Z₂ ∅ = 1 := Finset.prod_empty
      rw [hZ₁_empty, hZ₂_empty, Finset.prod_empty]
      ext <;> simp [sqCl]
    | insert a I ha ih =>
      have hZ₁_ins : Z₁ (insert a I) = (z a).1 * Z₁ I := Finset.prod_insert ha
      have hZ₂_ins : Z₂ (insert a I) = (z a).2 * Z₂ I := Finset.prod_insert ha
      rw [hZ₁_ins, hZ₂_ins, Finset.prod_insert ha, ← ih]
      ext <;> simp [sqCl, QuotientGroup.mk_mul]
  have h_sqCl_eq_of_mul_eq_one : ∀ a b : Kˣ, sqCl (a * b) = 1 → sqCl a = sqCl b := by
    intro a b hab
    change QuotientGroup.mk (a * b) = (1 : SqCl K) at hab
    rw [QuotientGroup.eq_one_iff] at hab
    rcases hab with ⟨u, hu⟩
    change QuotientGroup.mk a = (QuotientGroup.mk b : SqCl K)
    rw [QuotientGroup.eq]
    refine ⟨a⁻¹ * u, ?_⟩
    simp only [powMonoidHom_apply] at hu ⊢
    rw [mul_pow, hu]
    group
  intro c hc
  rcases hc with ⟨⟨x₁, x₂⟩, ⟨hx_T, hx_inf, hx_ram, hx_even⟩, rfl⟩
  let I : Finset (Fin 6) :=
    Finset.univ.filter (fun k : Fin 6 =>
      if k.1 % 2 = 0 then ¬ EvenVal (𝔮 ⟨k.1 / 2, by omega⟩) x₁
      else ¬ EvenVal (𝔮 ⟨k.1 / 2, by omega⟩) x₂)
  refine ⟨I, ?_⟩
  let y₁ : Kˣ := x₁ * Z₁ I
  let y₂ : Kˣ := x₂ * Z₂ I
  have hy_mem : (sqCl y₁, sqCl y₂) ∈ selmerStruct K a₁ a₂ a₃ T S₃ π₃ := by
    refine ⟨(y₁, y₂), ⟨?_, ?_, ?_, ?_⟩, rfl⟩
    · intro v hv
      exact hmul.1 v x₁ x₂ (Z₁ I) (Z₂ I) (hx_T v hv) ((hZ_local I).1 v hv)
    · intro w
      exact hmul.2.1 w x₁ x₂ (Z₁ I) (Z₂ I) (hx_inf w) ((hZ_local I).2.1 w)
    · intro v hvS₃
      have hvS₄ : v ∈ S₄ := hS₃_sub hvS₃
      have hram₄ : RamLocal a₁ a₂ a₃ v (π₄ v) y₁ y₂ :=
        hmul.2.2 v (π₄ v) x₁ x₂ (Z₁ I) (Z₂ I) (hπ₄_unif v hvS₄)
          (hx_ram v hvS₄) ((hZ_local I).2.2.1 v hvS₄)
      rwa [hπ₄_S₃ v hvS₃] at hram₄
    · intro v hvT hvS₃
      by_cases hq_mem : ∃ m : Fin 3, v = 𝔮 m
      · rcases hq_mem with ⟨m, rfl⟩
        let k_ev : Fin 6 := ⟨2 * m.1, by omega⟩
        let k_odd : Fin 6 := ⟨2 * m.1 + 1, by omega⟩
        have hm_ev_div : (⟨k_ev.1 / 2, by omega⟩ : Fin 3) = m := by
          ext; change (2 * m.1) / 2 = m.1; omega
        have hm_ev_mod : k_ev.1 % 2 = 0 := by
          change (2 * m.1) % 2 = 0; omega
        have hk_ev_mem : k_ev ∈ I ↔ ¬ EvenVal (𝔮 m) x₁ := by
          simp only [I, Finset.mem_filter, Finset.mem_univ, true_and, hm_ev_mod, ↓reduceIte, hm_ev_div]
        have hZ₁_odd : ¬ EvenVal (𝔮 m) (Z₁ I) ↔ k_ev ∈ I :=
          h_not_even_prod_iff (𝔮 m) (fun k => (z k).1) k_ev (fun k => (hz_𝔮 m k).1) I
        have hy₁_ev : EvenVal (𝔮 m) y₁ := by
          apply h_even_of_not_iff (𝔮 m) x₁ (Z₁ I)
          exact hk_ev_mem.symm.trans hZ₁_odd.symm
        have hm_odd_div : (⟨k_odd.1 / 2, by omega⟩ : Fin 3) = m := by
          ext; change (2 * m.1 + 1) / 2 = m.1; omega
        have hm_odd_mod : ¬ (k_odd.1 % 2 = 0) := by
          change ¬ ((2 * m.1 + 1) % 2 = 0); omega
        have hk_odd_mem : k_odd ∈ I ↔ ¬ EvenVal (𝔮 m) x₂ := by
          simp only [I, Finset.mem_filter, Finset.mem_univ, true_and, hm_odd_mod, ↓reduceIte, hm_odd_div]
        have hZ₂_odd : ¬ EvenVal (𝔮 m) (Z₂ I) ↔ k_odd ∈ I :=
          h_not_even_prod_iff (𝔮 m) (fun k => (z k).2) k_odd (fun k => (hz_𝔮 m k).2) I
        have hy₂_ev : EvenVal (𝔮 m) y₂ := by
          apply h_even_of_not_iff (𝔮 m) x₂ (Z₂ I)
          exact hk_odd_mem.symm.trans hZ₂_odd.symm
        exact ⟨hy₁_ev, hy₂_ev⟩
      · have hv_ne_q : ∀ j : Fin 3, v ≠ 𝔮 j := fun j hj => hq_mem ⟨j, hj⟩
        have hvS₄ : v ∉ S₄ := fun hv_in => hvS₃ (hS₄_to_S₃ v hv_in hv_ne_q)
        exact ⟨h_even_mul v x₁ (Z₁ I) (hx_even v hvT hvS₄).1 ((hZ_local I).2.2.2 v hvT hvS₄).1,
               h_even_mul v x₂ (Z₂ I) (hx_even v hvT hvS₄).2 ((hZ_local I).2.2.2 v hvT hvS₄).2⟩
  have hy_one : (sqCl y₁, sqCl y₂) = 1 := hsel₃_triv (sqCl y₁, sqCl y₂) hy_mem
  have hy₁_one : sqCl y₁ = 1 := congrArg Prod.fst hy_one
  have hy₂_one : sqCl y₂ = 1 := congrArg Prod.snd hy_one
  have hx₁_eq : sqCl x₁ = sqCl (Z₁ I) := h_sqCl_eq_of_mul_eq_one x₁ (Z₁ I) hy₁_one
  have hx₂_eq : sqCl x₂ = sqCl (Z₂ I) := h_sqCl_eq_of_mul_eq_one x₂ (Z₂ I) hy₂_one
  dsimp only
  rw [hx₁_eq, hx₂_eq, hZ_sqCl_prod I]

theorem exists_pre_auxiliary_twist_of_basis_primes (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₃ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₃ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₃ : Kˣ)
    (p : Fin 6 → Kˣ)
    (𝔭 : Fin 6 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : Fin 3 → Kˣ)
    (𝔮 : Fin 3 → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hS₃ : IsAuxiliaryPrimeState K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭)
    (hmul : IsLocalMulClosed K a₁ a₂ a₃)
    (hq : IsBasisPrimeTuple K T S₃ p 𝔭 q 𝔮)
    (hrec : IsBasisPrimeReciprocity K a₁ a₂ a₃ p q 𝔮) :
    ∃ (S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ₄ : Kˣ) (z : Fin 6 → Kˣ × Kˣ),
      IsPreAuxiliaryTwist K a₁ a₂ a₃ τ T S₄ π₄ κ₄ z :=
by
  obtain ⟨S₄, π₄, κ₄, hS₃_sub, h𝔮_mem, hS₄_to_S₃, hdisj₄, hπ₄_S₃, hπ₄_𝔮, hπ₄_unif,
    hprin₄, hz_val_out, hz_even_out, hz_𝔮⟩ :=
    exists_basis_adjoined_state_and_evenVal K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭 q 𝔮 hS₃ hq
  obtain ⟨hz_T, hz_inf, hz_sign_even, hz_sign_odd⟩ :=
    isDescentClass_and_realSigns_of_basisTwistPair K a₁ a₂ a₃ τ T S₃ π₃ κ₃ p 𝔭 q 𝔮 hstart hS₃ hq
  have hz_ram : ∀ k : Fin 6, ∀ v ∈ S₄,
      RamLocal a₁ a₂ a₃ v (π₄ v) (basisTwistPair p q k).1 (basisTwistPair p q k).2 :=
    ramLocal_of_basisTwistPair K a₁ a₂ a₃ τ T S₃ S₄ π₃ π₄ κ₃ p 𝔭 q 𝔮
      hS₃ hq hrec hS₄_to_S₃ hπ₄_S₃ hπ₄_𝔮
  have hz_mem : ∀ k : Fin 6,
      (sqCl (basisTwistPair p q k).1, sqCl (basisTwistPair p q k).2) ∈
        selmerStruct K a₁ a₂ a₃ T S₄ π₄ :=
    fun k => ⟨basisTwistPair p q k, ⟨hz_T k, hz_inf k, hz_ram k, hz_even_out k⟩, rfl⟩
  have hz_span : ∀ c ∈ selmerStruct K a₁ a₂ a₃ T S₄ π₄,
      ∃ I : Finset (Fin 6), c = ∏ k ∈ I, (sqCl (basisTwistPair p q k).1, sqCl (basisTwistPair p q k).2) :=
    selmerStruct_span_of_basis_prime_stripping K a₁ a₂ a₃ T S₃ S₄ π₃ π₄ 𝔮 (basisTwistPair p q)
      hmul hS₃_sub hS₄_to_S₃ hπ₄_S₃ hπ₄_unif hS₃.1.2.2.2 hz_T hz_inf hz_ram hz_even_out hz_𝔮
  exact ⟨S₄, π₄, κ₄, basisTwistPair p q,
    hdisj₄, hπ₄_unif, hprin₄, hz_mem, hz_val_out, hz_even_out, hz_span, hz_sign_even, hz_sign_odd⟩

theorem exists_final_sign_prime (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₄ : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hpre : IsPreAuxiliaryTwist K a₁ a₂ a₃ τ T S₄ π₄ κ₄ z) :
    ∃ (p_last : Kˣ)
      (𝔭_last : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsFinalSignPrime K a₁ a₂ a₃ τ T S₄ κ₄ z p_last 𝔭_last :=
by
  classical
  
  have hdesc_outside : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ q : Kˣ × Kˣ,
        IsDescentClass
          (algebraMap K (v.adicCompletion K) a₁)
          (algebraMap K (v.adicCompletion K) a₂)
          (algebraMap K (v.adicCompletion K) a₃)
          (algebraMap K (v.adicCompletion K) (q.1 : K))
          (algebraMap K (v.adicCompletion K) (q.2 : K)) ↔
        EvenVal v q.1 ∧ EvenVal v q.2 := by
    rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _⟩
    intro v hvT q
    obtain ⟨h2, hdesc_even⟩ := local_descent_implies_evenVal K a₁ a₂ a₃ hint₁ hint₂ hint₃ T hT v hvT
    exact isDescentClass_iff_evenVal_of_notMem_T K a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ v h2
      (isSquare_one_add_of_valuation_lt_one K v h2)
      (exists_nonSquare_unit_mod_ideal K v h2)
      (exists_ringOfIntegers_sub_valuation_lt_one K v)
      hdesc_even q
  have h_piv : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∃ π_u : Kˣ, IsLocalPivotUnif K a₁ a₂ a₃ v π_u :=
    fun v hvT => local_v1_hilbLoc_and_ramLocal_laws K a₁ a₂ a₃ τ T v hstart hT hvT (hdesc_outside v hvT)
  have h_piv_u : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ u : Kˣ,
        ((u : K) = -1 ∨ (u : K) = a₁ - a₂ ∨ (u : K) = a₁ - a₃ ∨ (u : K) = a₂ - a₃) →
        EvenVal v u := by
    intro v hvT u hu
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.1 u hu
  have h_hilb_even_even : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ a b : Kˣ, EvenVal v a → EvenVal v b →
        hilbFin v (a : K) (b : K) = 1 := by
    intro v hvT a b ha hb
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.2.1 a b ha hb
  have h_hilb_even_odd : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ a b : Kˣ, EvenVal v a → ¬ EvenVal v b →
        (hilbFin v (a : K) (b : K) = 1 ↔
          IsSquare (algebraMap K (v.adicCompletion K) (a : K))) ∧
        (hilbFin v (b : K) (a : K) = 1 ↔
          IsSquare (algebraMap K (v.adicCompletion K) (a : K))) := by
    intro v hvT a b ha hb
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.2.2.1 a b ha hb
  rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, _, _, _, _, hτ_inj,
    hτ0, hτ1, hτ2, hτ3, hτ4, hτ5, hτ6, hτ7, hτ8, hτ9, hτ10, hτ11, _⟩
  
  let F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) := T ∪ S₄
  let negIdx : Fin 6 → Prop := fun j =>
    (j.1 < 3 ∧ realPlaceEmb (τ ⟨j.1, by omega⟩) (κ₄ : K) < 0) ∨
    (3 ≤ j.1 ∧ 0 < realPlaceEmb (τ ⟨j.1, by omega⟩) (κ₄ : K))
  let negAt : {w : NumberField.InfinitePlace K // w.IsReal} → Prop := fun w =>
    ∃ j : Fin 6, negIdx j ∧ (w = τ ⟨j.1, by omega⟩ ∨ w = τ ⟨j.1 + 6, by omega⟩)
  have hnegAt_first : ∀ j : Fin 6, negAt (τ ⟨j.1, by omega⟩) ↔ negIdx j := by
    intro j
    constructor
    · rintro ⟨j', hj', h_eq | h_eq⟩
      · have h_idx := hτ_inj h_eq
        have h_val := congrArg Fin.val h_idx
        dsimp at h_val
        have hjj' : j = j' := Fin.ext h_val
        rwa [hjj']
      · have h_idx := hτ_inj h_eq
        have h_val := congrArg Fin.val h_idx
        dsimp at h_val
        omega
    · intro hj
      exact ⟨j, hj, Or.inl rfl⟩
  have hnegAt_second : ∀ j : Fin 6, negAt (τ ⟨j.1 + 6, by omega⟩) ↔ negIdx j := by
    intro j
    constructor
    · rintro ⟨j', hj', h_eq | h_eq⟩
      · have h_idx := hτ_inj h_eq
        have h_val := congrArg Fin.val h_idx
        dsimp at h_val
        omega
      · have h_idx := hτ_inj h_eq
        have h_val := congrArg Fin.val h_idx
        dsimp at h_val
        have hjj' : j = j' := Fin.ext (by omega)
        rwa [hjj']
    · intro hj
      exact ⟨j, hj, Or.inr rfl⟩
  have hnegAt_other : ∀ w : {w : NumberField.InfinitePlace K // w.IsReal},
      (∀ i : Fin 12, w ≠ τ i) → ¬ negAt w := by
    rintro w hw ⟨j, _, rfl | rfl⟩
    · exact hw ⟨j.1, by omega⟩ rfl
    · exact hw ⟨j.1 + 6, by omega⟩ rfl
  letI : MulAction ℝ (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.mulActionSet
  let C₁ : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    (Set.univ.pi (fun w => if negAt w then Set.Ioo (-3 / 4 : ℝ) (-1 / 4 : ℝ) else Set.Ioo (1 / 4 : ℝ) (3 / 4 : ℝ))) ×ˢ
    (Set.univ.pi (fun _ => Metric.ball (0 : ℂ) (3 / 4 : ℝ)))
  have hconv : Convex ℝ C₁ := by
    apply Convex.prod
    · apply convex_pi
      intro w _
