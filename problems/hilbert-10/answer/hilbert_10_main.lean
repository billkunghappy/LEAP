      intro v s hs
      change ENNReal.ofReal
        ((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ (-s)) ≤ 1
      rw [ENNReal.ofReal_le_one]
      by_cases hn : Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) = 0
      · rw [hn, Nat.cast_zero, Real.zero_rpow (by linarith : -s ≠ 0)]
        exact zero_le_one
      · have hn1 : (1 : ℝ) ≤ (Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) :=
