              rw [← map_mul, ← map_neg]; congr 1; dsimp [d₁, β_u]; push_cast; ring
          _ = s * s := hs
      · obtain ⟨s, hs⟩ := hsq2
        refine ⟨s, ?_⟩
        calc -(algebraMap K (v₁.adicCompletion K) (π_u : K) *
