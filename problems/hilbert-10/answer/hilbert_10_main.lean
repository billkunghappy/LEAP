    have horth2 : ∀ r : Kˣ × Kˣ,
        (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₁ →
        (hilbFin v₁ (d₁ : K) (r.2 : K) = 1 ↔ hilbFin v₁ (d₂ : K) (r.1 : K) = 1) := by
      intro r hr_rel
