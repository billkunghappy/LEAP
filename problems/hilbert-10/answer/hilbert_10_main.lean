        _ = (K₀ ∪ U₁).encard := by rw [← hunion]
        _ = K₀.encard + U₁.encard := Set.encard_union_eq hdisj
        _ = K₀.encard + K₀.encard := by rw [hcard₁]
    have h_two_coset : ∀ (Q_V Q_W : SqCl K × SqCl K → Prop) (g_x g_w : SqCl K × SqCl K),
