              (algebraMap K (v₁.adicCompletion K) (s : K))) ^ 2 := by
          calc (algebraMap K (v₁.adicCompletion K) (z : K) *
              algebraMap K (v₁.adicCompletion K) (ε : K)) * (w * q₁ * q₂) ^ 2
            _ = algebraMap K (v₁.adicCompletion K) (ε : K) *
                (algebraMap K (v₁.adicCompletion K) (z : K) * (w * q₁ * q₂) ^ 2) := by ring
            _ = algebraMap K (v₁.adicCompletion K) (ε : K) *
                (algebraMap K (v₁.adicCompletion K) (ε : K) *
                  (algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2) := by rw [← hs_eq]
            _ = (algebraMap K (v₁.adicCompletion K) (ε : K) *
                algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2 := by ring
        calc algebraMap K (v₁.adicCompletion K) (z : K) *
            algebraMap K (v₁.adicCompletion K) (ε : K)
          _ = ((algebraMap K (v₁.adicCompletion K) (z : K) *
                algebraMap K (v₁.adicCompletion K) (ε : K)) * (w * q₁ * q₂) ^ 2) /
              (w * q₁ * q₂) ^ 2 := by
              rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hwq_ne)]
          _ = (algebraMap K (v₁.adicCompletion K) (ε : K) *
                algebraMap K (v₁.adicCompletion K) (s : K)) ^ 2 / (w * q₁ * q₂) ^ 2 := by
              rw [hprod]
          _ = ((algebraMap K (v₁.adicCompletion K) (ε : K) *
                algebraMap K (v₁.adicCompletion K) (s : K)) / (w * q₁ * q₂)) *
              ((algebraMap K (v₁.adicCompletion K) (ε : K) *
                algebraMap K (v₁.adicCompletion K) (s : K)) / (w * q₁ * q₂)) := by ring
    intro x y hx_even hy_even hx_nonsq hy_nonsq
    obtain ⟨tx, htx⟩ := h_mul_eps_sq x hx_even hx_nonsq
    obtain ⟨ty, hty⟩ := h_mul_eps_sq y hy_even hy_nonsq
    refine ⟨(tx * ty) / algebraMap K (v₁.adicCompletion K) (ε : K), ?_⟩
    have hxy : algebraMap K (v₁.adicCompletion K) ((x * y : Kˣ) : K) *
        (algebraMap K (v₁.adicCompletion K) (ε : K)) ^ 2 = (tx * ty) ^ 2 := by
      simp only [Units.val_mul, map_mul]
      calc algebraMap K (v₁.adicCompletion K) (x : K) *
          algebraMap K (v₁.adicCompletion K) (y : K) *
          (algebraMap K (v₁.adicCompletion K) (ε : K)) ^ 2
        _ = (algebraMap K (v₁.adicCompletion K) (x : K) *
              algebraMap K (v₁.adicCompletion K) (ε : K)) *
            (algebraMap K (v₁.adicCompletion K) (y : K) *
              algebraMap K (v₁.adicCompletion K) (ε : K)) := by ring
        _ = (tx * tx) * (ty * ty) := by rw [htx, hty]
        _ = (tx * ty) ^ 2 := by ring
    calc algebraMap K (v₁.adicCompletion K) ((x * y : Kˣ) : K)
      _ = (algebraMap K (v₁.adicCompletion K) ((x * y : Kˣ) : K) *
            (algebraMap K (v₁.adicCompletion K) (ε : K)) ^ 2) /
          (algebraMap K (v₁.adicCompletion K) (ε : K)) ^ 2 := by
          rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hε_ne)]
      _ = (tx * ty) ^ 2 / (algebraMap K (v₁.adicCompletion K) (ε : K)) ^ 2 := by
          rw [hxy]
      _ = ((tx * ty) / algebraMap K (v₁.adicCompletion K) (ε : K)) *
          ((tx * ty) / algebraMap K (v₁.adicCompletion K) (ε : K)) := by ring
  have hsq_mul_iff : ∀ x y : Kˣ,
      IsSquare (algebraMap K (v₁.adicCompletion K) (x : K)) →
      (IsSquare (algebraMap K (v₁.adicCompletion K) ((x * y : Kˣ) : K)) ↔
       IsSquare (algebraMap K (v₁.adicCompletion K) (y : K))) := by
    intro x y ⟨rx, hrx⟩
    constructor
    · rintro ⟨rxy, hrxy⟩
      have hrx_ne : rx ≠ 0 := by
        intro h0; rw [h0, mul_zero] at hrx
        exact (algebraMap K (v₁.adicCompletion K)).injective.ne x.ne_zero hrx
      refine ⟨rxy / rx, ?_⟩
      have h1 : (rx * rx) * algebraMap K (v₁.adicCompletion K) (y : K) = rxy * rxy := by
        rw [← hrx, ← hrxy]; simp only [Units.val_mul, map_mul]
      calc algebraMap K (v₁.adicCompletion K) (y : K)
        _ = ((rx * rx) * algebraMap K (v₁.adicCompletion K) (y : K)) / (rx * rx) := by
            rw [mul_div_cancel_left₀ _ (mul_ne_zero hrx_ne hrx_ne)]
        _ = (rxy * rxy) / (rx * rx) := by rw [h1]
        _ = (rxy / rx) * (rxy / rx) := by ring
    · rintro ⟨ry, hry⟩
      refine ⟨rx * ry, ?_⟩
      simp only [Units.val_mul, map_mul, hrx, hry]; ring
  have hnonsq_mul_iff : ∀ x y : Kˣ, EvenVal v₁ x → EvenVal v₁ y →
      ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (x : K)) →
      (IsSquare (algebraMap K (v₁.adicCompletion K) ((x * y : Kˣ) : K)) ↔
       ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (y : K))) := by
    intro x y hx_ev hy_ev hx_nonsq
    constructor
    · intro hxy_sq hy_sq
      have hx_sq : IsSquare (algebraMap K (v₁.adicCompletion K) (x : K)) := by
        obtain ⟨ry, hry⟩ := hy_sq
        obtain ⟨rxy, hrxy⟩ := hxy_sq
        have hry_ne : ry ≠ 0 := by
          intro h0; rw [h0, mul_zero] at hry
          exact (algebraMap K (v₁.adicCompletion K)).injective.ne y.ne_zero hry
        refine ⟨rxy / ry, ?_⟩
        have h1 : algebraMap K (v₁.adicCompletion K) (x : K) * (ry * ry) = rxy * rxy := by
          rw [← hry, ← hrxy]; simp only [Units.val_mul, map_mul]
        calc algebraMap K (v₁.adicCompletion K) (x : K)
          _ = (algebraMap K (v₁.adicCompletion K) (x : K) * (ry * ry)) / (ry * ry) := by
              rw [mul_div_cancel_right₀ _ (mul_ne_zero hry_ne hry_ne)]
          _ = (rxy * rxy) / (ry * ry) := by rw [h1]
          _ = (rxy / ry) * (rxy / ry) := by ring
      exact hx_nonsq hx_sq
    · intro hy_nonsq
      exact hmul_nonsq x y hx_ev hy_ev hx_nonsq hy_nonsq
  have h_clause7 : ∀ x y : Kˣ, EvenVal v₁ x → EvenVal v₁ y →
      (IsSquare (algebraMap K (v₁.adicCompletion K) ((x * y : Kˣ) : K)) ↔
        (IsSquare (algebraMap K (v₁.adicCompletion K) (x : K)) ↔
         IsSquare (algebraMap K (v₁.adicCompletion K) (y : K)))) := by
    intro x y hx_ev hy_ev
    by_cases hx_sq : IsSquare (algebraMap K (v₁.adicCompletion K) (x : K))
    · rw [hsq_mul_iff x y hx_sq]
      tauto
    · rw [hnonsq_mul_iff x y hx_ev hy_ev hx_sq]
      tauto
  
  have h_div_sq : ∀ {F : Type u} [Field F] (A B N₁ N₂ D : F),
      D ≠ 0 → A * N₁ ^ 2 + B * N₂ ^ 2 = D ^ 2 →
      A * (N₁ / D) ^ 2 + B * (N₂ / D) ^ 2 = 1 := by
    intro F _ A B N₁ N₂ D hD h_eq
    calc A * (N₁ / D) ^ 2 + B * (N₂ / D) ^ 2
      _ = (A * N₁ ^ 2 + B * N₂ ^ 2) / D ^ 2 := by rw [div_pow, div_pow]; ring
      _ = D ^ 2 / D ^ 2 := by rw [h_eq]
      _ = 1 := div_self (pow_ne_zero 2 hD)
  have h_map_ne : ∀ (u : Kˣ), algebraMap K (v₁.adicCompletion K) (u : K) ≠ 0 := by
    intro u h
    rw [← map_zero (algebraMap K (v₁.adicCompletion K))] at h
    exact u.ne_zero ((algebraMap K (v₁.adicCompletion K)).injective h)
  have h_conic_desc : ∀ {F : Type u} [Field F] [CharZero F]
      (e₁ e₂ e₃ d₁ d₂ : F),
      e₁ ≠ e₂ → e₁ ≠ e₃ → e₂ ≠ e₃ →
      d₁ ≠ 0 → d₂ ≠ 0 →
      IsDescentClass e₁ e₂ e₃ d₁ d₂ →
      ∃ x y : F,
        (-(e₁ - e₂) * (e₂ - e₃) * d₂) * x ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * y ^ 2 = 1 := by
    intro F _ _ e₁ e₂ e₃ d₁ d₂ he₁₂ he₁₃ he₂₃ hd₁ hd₂ hdesc
    have hα : e₁ - e₂ ≠ 0 := sub_ne_zero.mpr he₁₂
    have hβ : e₁ - e₃ ≠ 0 := sub_ne_zero.mpr he₁₃
    have hγ : e₂ - e₃ ≠ 0 := sub_ne_zero.mpr he₂₃
    have h2 : (2 : F) ≠ 0 := two_ne_zero
    obtain ⟨z₀, z₁, z₂, z₃, hz_ne, heq1, heq2⟩ := hdesc
    by_cases hz₃ : z₃ = 0
    · have hz₀ : z₀ ≠ 0 := by
        intro hz₀
        have hz₁ : z₁ = 0 := by
          have hsq : d₁ * z₁ ^ 2 = 0 := by
            linear_combination heq2 + d₁ * d₂ * z₃ * hz₃ + (e₃ - e₁) * z₀ * hz₀
          rcases mul_eq_zero.mp hsq with h | h
          · exact False.elim (hd₁ h)
          · exact pow_eq_zero h
        have hz₂ : z₂ = 0 := by
          have hsq : d₂ * z₂ ^ 2 = 0 := by
            linear_combination -heq1 + d₁ * z₁ * hz₁ - (e₂ - e₁) * z₀ * hz₀
          rcases mul_eq_zero.mp hsq with h | h
          · exact False.elim (hd₂ h)
          · exact pow_eq_zero h
        exact hz_ne ⟨hz₀, hz₁, hz₂, hz₃⟩
      have heq2_0 : d₁ * z₁ ^ 2 = (e₃ - e₁) * z₀ ^ 2 := by
        linear_combination heq2 + d₁ * d₂ * z₃ * hz₃
      have hD₂ : 2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀ ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero h2 hα) hβ) hγ) hz₀
      have h_num2 : (-(e₁ - e₂) * (e₂ - e₃) * d₂) * ((e₁ - e₂ + 1) * (e₁ - e₃) * z₂) ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * ((e₁ - e₂ - 1) * (e₂ - e₃) * z₁) ^ 2 =
          (2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀) ^ 2 := by
        linear_combination
          ((e₁ - e₂) * (e₂ - e₃) * (e₁ - e₃) ^ 2 * (e₁ - e₂ + 1) ^ 2) * heq1 +
          ((e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) ^ 2 * (e₁ - e₂ - 1) ^ 2 -
           (e₁ - e₂) * (e₂ - e₃) * (e₁ - e₃) ^ 2 * (e₁ - e₂ + 1) ^ 2) * heq2_0
      exact ⟨((e₁ - e₂ + 1) * (e₁ - e₃) * z₂) / (2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀),
             ((e₁ - e₂ - 1) * (e₂ - e₃) * z₁) / (2 * (e₁ - e₂) * (e₁ - e₃) * (e₂ - e₃) * z₀),
             h_div_sq _ _ _ _ _ hD₂ h_num2⟩
    · have hD₁ : (e₁ - e₂) * d₁ * d₂ * z₃ ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero hα hd₁) hd₂) hz₃
      have h_num1 : (-(e₁ - e₂) * (e₂ - e₃) * d₂) * (d₁ * z₁) ^ 2 +
          ((e₁ - e₂) * (e₁ - e₃) * d₁) * (d₂ * z₂) ^ 2 =
          ((e₁ - e₂) * d₁ * d₂ * z₃) ^ 2 := by
        linear_combination -((e₁ - e₂) * (e₁ - e₃) * d₁ * d₂) * heq1 +
          ((e₁ - e₂) ^ 2 * d₁ * d₂) * heq2
      exact ⟨(d₁ * z₁) / ((e₁ - e₂) * d₁ * d₂ * z₃),
             (d₂ * z₂) / ((e₁ - e₂) * d₁ * d₂ * z₃),
             h_div_sq _ _ _ _ _ hD₁ h_num1⟩
  have h_even_inv : ∀ u : Kˣ, EvenVal v₁ u → EvenVal v₁ u⁻¹ := by
    intro u hu
    dsimp [EvenVal] at hu ⊢
    rw [map_inv, toAdd_inv, even_neg]
    exact hu
  have h_clause8 : ∀ a b : Kˣ, EvenVal v₁ a → EvenVal v₁ b →
      hilbFin v₁ (a : K) (b : K) = 1 := by
    intro a b ha hb
    have h₁₂_sub : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr h₁₂
    have h₁₃_sub : a₁ - a₃ ≠ 0 := sub_ne_zero.mpr h₁₃
    have h₂₃_sub : a₂ - a₃ ≠ 0 := sub_ne_zero.mpr h₂₃
    let α_u : Kˣ := Units.mk0 (a₁ - a₂) h₁₂_sub
    let β_u : Kˣ := Units.mk0 (a₁ - a₃) h₁₃_sub
    let γ_u : Kˣ := Units.mk0 (a₂ - a₃) h₂₃_sub
    let neg_one_u : Kˣ := -1
    have hα_ev : EvenVal v₁ α_u := h_clause3 α_u (Or.inr (Or.inl rfl))
    have hβ_ev : EvenVal v₁ β_u := h_clause3 β_u (Or.inr (Or.inr (Or.inl rfl)))
    have hγ_ev : EvenVal v₁ γ_u := h_clause3 γ_u (Or.inr (Or.inr (Or.inr rfl)))
    have hneg_ev : EvenVal v₁ neg_one_u := h_clause3 neg_one_u (Or.inl rfl)
    let r₁ : Kˣ := (α_u * β_u)⁻¹ * b
    let r₂ : Kˣ := (neg_one_u * α_u * γ_u)⁻¹ * a
    have hr₁_ev : EvenVal v₁ r₁ := by
      have h_ab : EvenVal v₁ (α_u * β_u) := (h_clause5 α_u β_u).mpr (iff_of_true hα_ev hβ_ev)
      exact (h_clause5 (α_u * β_u)⁻¹ b).mpr (iff_of_true (h_even_inv _ h_ab) hb)
    have hr₂_ev : EvenVal v₁ r₂ := by
      have h_na : EvenVal v₁ (neg_one_u * α_u) := (h_clause5 neg_one_u α_u).mpr (iff_of_true hneg_ev hα_ev)
      have h_nag : EvenVal v₁ (neg_one_u * α_u * γ_u) := (h_clause5 _ γ_u).mpr (iff_of_true h_na hγ_ev)
      exact (h_clause5 (neg_one_u * α_u * γ_u)⁻¹ a).mpr (iff_of_true (h_even_inv _ h_nag) ha)
    have hdesc := (hdesc_v₁ (r₁, r₂)).mpr ⟨hr₁_ev, hr₂_ev⟩
    haveI : CharZero (v₁.adicCompletion K) :=
      (RingHom.charZero_iff (algebraMap K (v₁.adicCompletion K)).injective).mp inferInstance
    have hinj := (algebraMap K (v₁.adicCompletion K)).injective
    obtain ⟨x, y, hxy⟩ := h_conic_desc
      (algebraMap K (v₁.adicCompletion K) a₁)
      (algebraMap K (v₁.adicCompletion K) a₂)
      (algebraMap K (v₁.adicCompletion K) a₃)
      (algebraMap K (v₁.adicCompletion K) (r₁ : K))
      (algebraMap K (v₁.adicCompletion K) (r₂ : K))
      (hinj.ne h₁₂) (hinj.ne h₁₃) (hinj.ne h₂₃)
      (h_map_ne r₁) (h_map_ne r₂)
      hdesc
    have hr₁_K : (a₁ - a₂) * (a₁ - a₃) * (r₁ : K) = (b : K) := by
      have h1 : α_u * β_u * r₁ = b := mul_inv_cancel_left (α_u * β_u) b
      have h2 := congrArg (Units.val : Kˣ → K) h1
      simpa [α_u, β_u, Units.val_mul] using h2
    have hr₂_K : -(a₁ - a₂) * (a₂ - a₃) * (r₂ : K) = (a : K) := by
      have h1 : (neg_one_u * α_u * γ_u) * r₂ = a := mul_inv_cancel_left (neg_one_u * α_u * γ_u) a
      have h2 := congrArg (Units.val : Kˣ → K) h1
      simp only [neg_one_u, α_u, γ_u, Units.val_mul, Units.val_neg, Units.val_one, Units.val_mk0] at h2
      linear_combination h2
    unfold hilbFin hilbLoc
    apply if_pos
    refine ⟨x, y, ?_⟩
    have hA_eq : -(algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₂) *
        (algebraMap K (v₁.adicCompletion K) a₂ - algebraMap K (v₁.adicCompletion K) a₃) *
        algebraMap K (v₁.adicCompletion K) (r₂ : K) =
        algebraMap K (v₁.adicCompletion K) (a : K) := by
      rw [← hr₂_K]; push_cast; ring
    have hB_eq : (algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₂) *
        (algebraMap K (v₁.adicCompletion K) a₁ - algebraMap K (v₁.adicCompletion K) a₃) *
        algebraMap K (v₁.adicCompletion K) (r₁ : K) =
        algebraMap K (v₁.adicCompletion K) (b : K) := by
      rw [← hr₁_K]; push_cast; ring
    rw [← hA_eq, ← hB_eq]
    exact hxy
  
  have h_val_even_mul_sq : ∀ (u : Kˣ) (x : v₁.adicCompletion K) (g : Multiplicative ℤ),
      EvenVal v₁ u →
      Valued.v (algebraMap K (v₁.adicCompletion K) (u : K) * x ^ 2) =
        (g : WithZero (Multiplicative ℤ)) →
      Even (Multiplicative.toAdd g) := by
    intro u x g hu_even hg
    have hx_ne : Valued.v x ≠ 0 := by
      intro hx0
      have hA0 : Valued.v (algebraMap K (v₁.adicCompletion K) (u : K) * x ^ 2) = 0 := by
        rw [map_mul, sq, map_mul, hx0, mul_zero, mul_zero]
      rw [hA0] at hg
      exact WithZero.coe_ne_zero hg.symm
    obtain ⟨gx, hgx⟩ := WithZero.ne_zero_iff_exists.mp hx_ne
    rw [map_mul, sq, map_mul, hv_unit u, ← hgx, ← WithZero.coe_mul, ← WithZero.coe_mul,
      WithZero.coe_inj] at hg
    have h1 := congrArg Multiplicative.toAdd hg
    rw [toAdd_mul, toAdd_mul] at h1
    obtain ⟨ku, hku⟩ := hu_even
    exact ⟨ku + Multiplicative.toAdd gx, by omega⟩
  have h_val_odd_mul_sq : ∀ (r : Kˣ) (y : v₁.adicCompletion K) (g : Multiplicative ℤ),
      ¬ EvenVal v₁ r →
      Valued.v (algebraMap K (v₁.adicCompletion K) (r : K) * y ^ 2) =
        (g : WithZero (Multiplicative ℤ)) →
      ¬ Even (Multiplicative.toAdd g) := by
    intro r y g hr_not_even hg h_ev
    apply hr_not_even
    have hy_ne : Valued.v y ≠ 0 := by
      intro hy0
      have hB0 : Valued.v (algebraMap K (v₁.adicCompletion K) (r : K) * y ^ 2) = 0 := by
        rw [map_mul, sq, map_mul, hy0, mul_zero, mul_zero]
      rw [hB0] at hg
      exact WithZero.coe_ne_zero hg.symm
    obtain ⟨gy, hgy⟩ := WithZero.ne_zero_iff_exists.mp hy_ne
    rw [map_mul, sq, map_mul, hv_unit r, ← hgy, ← WithZero.coe_mul, ← WithZero.coe_mul,
      WithZero.coe_inj] at hg
    have h1 := congrArg Multiplicative.toAdd hg
    rw [toAdd_mul, toAdd_mul] at h1
    obtain ⟨kg, hkg⟩ := h_ev
    exact ⟨kg - Multiplicative.toAdd gy, by omega⟩
  
  have hilbFin_comm : ∀ c d : K, hilbFin v₁ c d = hilbFin v₁ d c := by
    intro c d
    unfold hilbFin hilbLoc
    congr 1
    exact propext ⟨fun ⟨x, y, h⟩ => ⟨y, x, by linear_combination h⟩,
                   fun ⟨x, y, h⟩ => ⟨y, x, by linear_combination h⟩⟩
  have h_clause9_left : ∀ a b : Kˣ, EvenVal v₁ a → ¬ EvenVal v₁ b →
      (hilbFin v₁ (a : K) (b : K) = 1 ↔
        IsSquare (algebraMap K (v₁.adicCompletion K) (a : K))) := by
    intro a b ha_even hb_not_even
    constructor
    · intro hhilb
      have hxy : ∃ x y : v₁.adicCompletion K,
          algebraMap K (v₁.adicCompletion K) (a : K) * x ^ 2 +
            algebraMap K (v₁.adicCompletion K) (b : K) * y ^ 2 = 1 := by
        unfold hilbFin hilbLoc at hhilb
        split_ifs at hhilb with h
        · exact h
        · exfalso; revert hhilb; decide
      obtain ⟨x, y, hxy_eq⟩ := hxy
      set A := algebraMap K (v₁.adicCompletion K) (a : K) * x ^ 2
      set B := algebraMap K (v₁.adicCompletion K) (b : K) * y ^ 2
      have hAB_one : Valued.v (A + B) = 1 := by
        rw [hxy_eq, Valuation.map_one]
      have hAB_ne : Valued.v A ≠ Valued.v B := by
        intro heq
        by_cases hA0 : Valued.v A = 0
        · have hB0 : Valued.v B = 0 := heq.symm.trans hA0
          have h1 := Valuation.map_add Valued.v A B
          rw [hAB_one, hA0, hB0, max_self] at h1
          exact zero_ne_one (le_antisymm zero_le_one h1)
        · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hA0
          exact h_val_odd_mul_sq b y g hb_not_even (heq.symm.trans hg.symm)
            (h_val_even_mul_sq a x g ha_even hg.symm)
      have hmax : max (Valued.v A) (Valued.v B) = 1 := by
        rw [← Valuation.map_add_of_distinct_val Valued.v hAB_ne, hAB_one]
      have hB_ne_one : Valued.v B ≠ 1 := by
        intro hB1
        exact h_val_odd_mul_sq b y 1 hb_not_even hB1 ⟨0, by rw [toAdd_one]; rfl⟩
      have hA_one : Valued.v A = 1 := by
        rcases max_choice (Valued.v A) (Valued.v B) with hm | hm
        · exact hm.symm.trans hmax
        · exact False.elim (hB_ne_one (hm.symm.trans hmax))
      have hB_le_one : Valued.v B ≤ 1 := by
        rw [← hmax]; exact le_max_right _ _
      have hB_lt_one : Valued.v (-B) < 1 := by
        rw [Valuation.map_neg]
        exact lt_of_le_of_ne hB_le_one hB_ne_one
      have hsqA : IsSquare (1 + -B) := h_isSquare_one_add (-B) hB_lt_one
      have h1B : 1 + -B = A := by
        calc 1 + -B = (A + B) + -B := by rw [hxy_eq]
          _ = A := by ring
      rw [h1B] at hsqA
      obtain ⟨s, hs⟩ := hsqA
      have hx_ne0 : x ≠ 0 := by
        intro hx0
        have hA0 : Valued.v A = 0 := by
          dsimp [A]; rw [hx0, sq, mul_zero, mul_zero, Valuation.map_zero]
        rw [hA0] at hA_one
        exact zero_ne_one hA_one
      refine ⟨s / x, ?_⟩
      have hux : algebraMap K (v₁.adicCompletion K) (a : K) * x ^ 2 = s * s := hs
      calc algebraMap K (v₁.adicCompletion K) (a : K)
        _ = (algebraMap K (v₁.adicCompletion K) (a : K) * x ^ 2) / x ^ 2 := by
            rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hx_ne0)]
        _ = (s * s) / x ^ 2 := by rw [hux]
        _ = (s / x) * (s / x) := by ring
    · rintro ⟨s, hs⟩
      have hs_ne : s ≠ 0 := by
        intro h0; rw [h0, mul_zero] at hs
        exact h_map_ne a hs
      unfold hilbFin hilbLoc
      apply if_pos
      refine ⟨1 / s, 0, ?_⟩
      rw [hs]
      calc (s * s) * (1 / s) ^ 2 + algebraMap K (v₁.adicCompletion K) (b : K) * 0 ^ 2
        _ = s ^ 2 / s ^ 2 := by ring
        _ = 1 := div_self (pow_ne_zero 2 hs_ne)
  have h_clause9 : ∀ a b : Kˣ, EvenVal v₁ a → ¬ EvenVal v₁ b →
      (hilbFin v₁ (a : K) (b : K) = 1 ↔
        IsSquare (algebraMap K (v₁.adicCompletion K) (a : K))) ∧
      (hilbFin v₁ (b : K) (a : K) = 1 ↔
        IsSquare (algebraMap K (v₁.adicCompletion K) (a : K))) := by
    intro a b ha hb
    refine ⟨h_clause9_left a b ha hb, ?_⟩
    rw [hilbFin_comm (b : K) (a : K)]
    exact h_clause9_left a b ha hb
  
  have h_clause10 : ∀ a b : Kˣ, ¬ EvenVal v₁ a → ¬ EvenVal v₁ b →
      (hilbFin v₁ (a : K) (b : K) = 1 ↔
        IsSquare (algebraMap K (v₁.adicCompletion K) ((-a * b : Kˣ) : K))) := by
    intro a b ha_odd hb_odd
    set A₀ := algebraMap K (v₁.adicCompletion K) (a : K)
    set B₀ := algebraMap K (v₁.adicCompletion K) (b : K)
    have hA₀_ne : A₀ ≠ 0 := h_map_ne a
    have hB₀_ne : B₀ ≠ 0 := h_map_ne b
    have h_neg_ab : algebraMap K (v₁.adicCompletion K) ((-a * b : Kˣ) : K) = -A₀ * B₀ := by
      simp only [A₀, B₀, Units.val_mul, Units.val_neg, map_mul, map_neg]
    constructor
    · intro hhilb
      have hxy : ∃ x y : v₁.adicCompletion K, A₀ * x ^ 2 + B₀ * y ^ 2 = 1 := by
        unfold hilbFin hilbLoc at hhilb
        split_ifs at hhilb with h
        · exact h
        · exfalso; revert hhilb; decide
      obtain ⟨x, y, hxy_eq⟩ := hxy
      set A := A₀ * x ^ 2
      set B := B₀ * y ^ 2
      have hA_ne_one : Valued.v A ≠ 1 := by
        intro hA1
        exact h_val_odd_mul_sq a x 1 ha_odd hA1 ⟨0, by rw [toAdd_one]; rfl⟩
      have hB_ne_one : Valued.v B ≠ 1 := by
        intro hB1
        exact h_val_odd_mul_sq b y 1 hb_odd hB1 ⟨0, by rw [toAdd_one]; rfl⟩
      have hA_gt_one : 1 < Valued.v A := by
        by_contra h_not_gt
        have h_le : Valued.v A ≤ 1 := not_lt.mp h_not_gt
        have hA_lt_one : Valued.v A < 1 := lt_of_le_of_ne h_le hA_ne_one
        have h1A_ne : Valued.v (1 : v₁.adicCompletion K) ≠ Valued.v (-A) := by
          rw [Valuation.map_one, Valuation.map_neg]
          exact ne_of_gt hA_lt_one
        have hB_eq_1A : B = 1 + -A := by
          calc B = (A + B) + -A := by ring
            _ = 1 + -A := by rw [hxy_eq]
        have hB_val : Valued.v B = 1 := by
          rw [hB_eq_1A, Valuation.map_add_of_distinct_val Valued.v h1A_ne,
              Valuation.map_one, Valuation.map_neg, max_eq_left (le_of_lt hA_lt_one)]
        exact hB_ne_one hB_val
      have hA_ne0 : A ≠ 0 := by
        intro h0
        rw [h0, Valuation.map_zero] at hA_gt_one
        exact not_lt_of_ge zero_le_one hA_gt_one
      have hy_ne0 : y ≠ 0 := by
        intro hy0
        have hA_eq1 : A = 1 := by
          dsimp [A, B] at hxy_eq ⊢
          linear_combination hxy_eq - B₀ * y * hy0
        rw [hA_eq1, Valuation.map_one] at hA_ne_one
        exact hA_ne_one rfl
      set δ : v₁.adicCompletion K := -(1 / A)
      have hδ_lt : Valued.v δ < 1 := by
        dsimp [δ]
        rw [Valuation.map_neg, one_div, Valuation.map_inv]
        exact inv_lt_one_of_one_lt₀ hA_gt_one
      obtain ⟨q, hq⟩ := h_isSquare_one_add δ hδ_lt
      have hAq : A * (q * q) = A - 1 := by
        dsimp [δ] at hq
        calc A * (q * q)
          _ = A * (1 + -(1 / A)) := by rw [← hq]
          _ = A - A / A := by ring
          _ = A - 1 := by rw [div_self hA_ne0]
      have h_prod : (-A₀ * B₀) * y ^ 2 = (A₀ * x * q) ^ 2 := by
        dsimp [A, B] at hxy_eq hAq
        linear_combination -A₀ * hxy_eq - A₀ * hAq
      rw [h_neg_ab]
      refine ⟨(A₀ * x * q) / y, ?_⟩
      calc -A₀ * B₀
        _ = ((-A₀ * B₀) * y ^ 2) / y ^ 2 := by
            rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hy_ne0)]
        _ = (A₀ * x * q) ^ 2 / y ^ 2 := by rw [h_prod]
        _ = ((A₀ * x * q) / y) * ((A₀ * x * q) / y) := by ring
    · rintro ⟨s, hs⟩
      rw [h_neg_ab] at hs
      haveI : CharZero (v₁.adicCompletion K) :=
        (RingHom.charZero_iff (algebraMap K (v₁.adicCompletion K)).injective).mp inferInstance
      have h2_ne : (2 : v₁.adicCompletion K) ≠ 0 := two_ne_zero
      set N₁ : v₁.adicCompletion K := (A₀ + 1) * B₀
      set N₂ : v₁.adicCompletion K := (A₀ - 1) * s
      set D : v₁.adicCompletion K := 2 * A₀ * B₀
      have hD_ne : D ≠ 0 := mul_ne_zero (mul_ne_zero h2_ne hA₀_ne) hB₀_ne
      have h_num : A₀ * N₁ ^ 2 + B₀ * N₂ ^ 2 = D ^ 2 := by
        dsimp [N₁, N₂, D]
        linear_combination B₀ * (A₀ - 1) ^ 2 * hs.symm
      unfold hilbFin hilbLoc
      apply if_pos
      exact ⟨N₁ / D, N₂ / D, h_div_sq A₀ B₀ N₁ N₂ D hD_ne h_num⟩
  exact ⟨π_u, h_clause1, h_clause2, h_clause3, h_clause4, h_clause5,
    h_clause6, h_clause7, h_clause8, h_clause9, h_clause10⟩

theorem selmerStruct_pivot_at_prime_of_kernel_case (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T B S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (m : ℕ)
    (v₁ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (π_u x δ : Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hST : Disjoint S T)
    (hSB : Disjoint S B)
    (hπ : ∀ v ∈ S, IsLocalUnif v (π v))
    (hm : (selmerStruct K a₁ a₂ a₃ T S π).encard = 4 ^ (m + 1))
    (hmul : IsLocalMulClosed K a₁ a₂ a₃)
    (hv₁T : v₁ ∉ T) (hv₁B : v₁ ∉ B) (hv₁S : v₁ ∉ S)
    (hloc : IsLocalPivotUnif K a₁ a₂ a₃ v₁ π_u)
    (hpr : ∀ r : Kˣ × Kˣ,
      (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₁ →
      hilbFin v₁ (-(a₁ - a₂) * (a₂ - a₃) * (r.2 : K)) ((a₁ - a₂) * (a₁ - a₃) * (r.1 : K)) = 1)
    (hv₁x : ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (x : K)))
    (hv₁δ : ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (δ : K)))
    (hker :
      ((∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c.1 = 1) ∧
       (sqCl 1, sqCl x) ∈ selmerStruct K a₁ a₂ a₃ T S π ∧
       (δ : K) = (a₁ - a₂) * (a₁ - a₃)) ∨
      ((∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c.2 = 1) ∧
       (sqCl x, sqCl 1) ∈ selmerStruct K a₁ a₂ a₃ T S π ∧
       (δ : K) = -((a₁ - a₂) * (a₂ - a₃))) ∨
      ((∀ c ∈ selmerStruct K a₁ a₂ a₃ T S π, c.1 = c.2) ∧
       (sqCl x, sqCl x) ∈ selmerStruct K a₁ a₂ a₃ T S π ∧
       (δ : K) = (a₁ - a₃) * (a₂ - a₃))) :
    ∃ (S' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K),
      Disjoint S' T ∧
      Disjoint S' B ∧
      (∀ v ∈ S', IsLocalUnif v (π' v)) ∧
      (selmerStruct K a₁ a₂ a₃ T S' π').encard = 4 ^ (m + 1) ∧
      ∃ p q : Kˣ × Kˣ,
        (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S' π' ∧
        (sqCl q.1, sqCl q.2) ∈ selmerStruct K a₁ a₂ a₃ T S' π' ∧
        ¬ IsSquare (p.1 : K) ∧
        ¬ IsSquare ((p.1 * p.2 : Kˣ) : K) ∧
        ¬ IsSquare (q.2 : K) ∧
        ¬ IsSquare ((p.2 * q.2 : Kˣ) : K) :=
by
  classical
  have h₁₂ : a₁ ≠ a₂ := hstart.1
  have h₁₃ : a₁ ≠ a₃ := hstart.2.1
  have h₂₃ : a₂ ≠ a₃ := hstart.2.2.1
  have hint₁ : IsIntegral ℤ a₁ := hstart.2.2.2.2.2.2.1
  have hint₂ : IsIntegral ℤ a₂ := hstart.2.2.2.2.2.2.2.1
  have hint₃ : IsIntegral ℤ a₃ := hstart.2.2.2.2.2.2.2.2.1
  obtain ⟨hπ_u_unif, hπ_u_odd, hloc_units, hloc_sq_ev, hloc_ev_mul,
          hloc_ram_ev, hloc_sq_mul, hloc_ev_ev, hloc_ev_odd, hloc_odd_odd⟩ := hloc
  let α_u : Kˣ := Units.mk0 (a₁ - a₂) (sub_ne_zero.mpr h₁₂)
  let β_u : Kˣ := Units.mk0 (a₁ - a₃) (sub_ne_zero.mpr h₁₃)
  let γ_u : Kˣ := Units.mk0 (a₂ - a₃) (sub_ne_zero.mpr h₂₃)
  have hα_ev : EvenVal v₁ α_u := hloc_units α_u (Or.inr (Or.inl rfl))
  have hβ_ev : EvenVal v₁ β_u := hloc_units β_u (Or.inr (Or.inr (Or.inl rfl)))
