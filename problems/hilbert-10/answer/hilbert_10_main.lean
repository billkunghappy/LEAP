    have hcard₂ : W₂.encard = W.encard :=
      ((mul_right_injective g₂).injOn).encard_image
    have hcard₃ : W₃.encard = W.encard :=
      ((mul_right_injective (g₁ * g₂)).injOn).encard_image
    have hsum : (W.encard + W.encard) + (W.encard + W.encard) = 4 ^ (n + 1) := by
