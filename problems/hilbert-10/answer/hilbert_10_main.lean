    let f : Fin 12 → ℤˣ := fun i => hilbInf (τ i).1 (u : K) (p_last : K)
    have hf_pair : ∀ j : Fin 6, f ⟨j.1 + 6, by omega⟩ = f ⟨j.1, by omega⟩ := by
      intro j
      let i₁ : Fin 12 := ⟨j.1, by omega⟩
      let i₂ : Fin 12 := ⟨j.1 + 6, by omega⟩
      rcases hp_pair j with ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩
      · have h1 : f i₁ = 1 := hilbInf_eq_one_of_pos_right (τ i₁).1 (τ i₁).2 u p_last hp1
        have h2 : f i₂ = 1 := hilbInf_eq_one_of_pos_right (τ i₂).1 (τ i₂).2 u p_last hp2
        rw [h1, h2]
