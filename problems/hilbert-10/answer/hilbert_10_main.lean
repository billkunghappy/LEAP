          _ = algebraMap K (v₁.adicCompletion K) ((d₂ * w.2 : Kˣ) : K) := by
              rw [← map_mul, ← map_neg]; congr 1; dsimp [d₂, γ_u]; push_cast; ring
          _ = s * s := hs
    exact h_s4 w hw_rel hw_ram
      (Or.inr (Or.inr ⟨hker3, hx3, hr_ev, hw1_odd, hw2_odd, hw12_nsq⟩))

theorem selmerStruct_insert_pivot_of_subset_kernel (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T B S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (m : ℕ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hST : Disjoint S T)
    (hSB : Disjoint S B)
    (hπ : ∀ v ∈ S, IsLocalUnif v (π v))
    (hm : (selmerStruct K a₁ a₂ a₃ T S π).encard = 4 ^ (m + 1)) :
    (∃ p q : Kˣ × Kˣ,
      (sqCl p.1, sqCl p.2) ∈ selmerStruct K a₁ a₂ a₃ T S π ∧
