    exact h_s4 w hw_rel hw_ram (Or.inl ⟨hker1, hx1, hr_ev, hw1_ev, hw1_nsq, hw2_odd⟩)
  · 
    have hx_ev : EvenVal v₁ x := (hV_mem_relax_and_ev x 1 hx2).2.1
    have hr_ev : ∀ r : Kˣ × Kˣ,
        (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₁ → EvenVal v₁ r.2 := by
      intro r hr_rel
      have h1 : hilbFin v₁ ((1 : Kˣ) : K) (r.1 : K) = 1 :=
