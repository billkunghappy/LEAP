    exact (h_hilb_even_odd 𝔭_last h𝔭T u p_last (hu_even 𝔭_last h𝔭T h𝔭S₄) hp_not_even_𝔭).1.mp h_glob
  
  rcases hpre with ⟨_, _, _, _, _, hz_even, _, hz_even_sign, hz_odd_sign⟩
