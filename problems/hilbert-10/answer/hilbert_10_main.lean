  obtain ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, β, α_a, α_b, α_c, σ₀,
    hβ, hα_a, hα_b, hα_c, hσ_a, hσ_b, hσ_c⟩ := h_galois
  letI : Field L := hFieldL
  letI : NumberField L := hNFL
  letI : Algebra K L := hAlgKL
  letI : IsGalois K L := hGalKL
  let C : Set (L ≃ₐ[K] L) :=
    { g | (∀ k : Fin 6, g (β k) = β k) ∧ g α_a = -α_a ∧ g α_b = -α_b ∧ g α_c = -α_c }
  have hC_nonempty : C.Nonempty := ⟨σ₀, fun k => (hβ k).2, hσ_a, hσ_b, hσ_c⟩
  have h_conj_pos : ∀ (γ : L) (w : K), γ ^ 2 = algebraMap K L w →
      ∀ (ρ τ : L ≃ₐ[K] L), ρ γ = γ → (τ * ρ * τ⁻¹) γ = γ := by
    intro γ w hγ ρ τ hρ
    have hsq : (τ⁻¹ γ) ^ 2 = γ ^ 2 := by
      calc (τ⁻¹ γ) ^ 2 = τ⁻¹ (γ ^ 2) := (map_pow (τ⁻¹ : L ≃ₐ[K] L) γ 2).symm
        _ = τ⁻¹ (algebraMap K L w) := by rw [hγ]
        _ = algebraMap K L w := (τ⁻¹ : L ≃ₐ[K] L).commutes w
        _ = γ ^ 2 := hγ.symm
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h_pos | h_neg
    · change τ (ρ (τ⁻¹ γ)) = γ
      rw [h_pos, hρ]
      have hτ : τ (τ⁻¹ γ) = γ := AlgEquiv.apply_symm_apply τ γ
      rwa [h_pos] at hτ
    · change τ (ρ (τ⁻¹ γ)) = γ
      rw [h_neg, map_neg, hρ]
      have hτ : τ (τ⁻¹ γ) = γ := AlgEquiv.apply_symm_apply τ γ
      rwa [h_neg] at hτ
  have h_conj_neg : ∀ (α : L) (w : K), α ^ 2 = algebraMap K L w →
      ∀ (ρ τ : L ≃ₐ[K] L), ρ α = -α → (τ * ρ * τ⁻¹) α = -α := by
    intro α w hα ρ τ hρ
    have hsq : (τ⁻¹ α) ^ 2 = α ^ 2 := by
      calc (τ⁻¹ α) ^ 2 = τ⁻¹ (α ^ 2) := (map_pow (τ⁻¹ : L ≃ₐ[K] L) α 2).symm
        _ = τ⁻¹ (algebraMap K L w) := by rw [hα]
        _ = algebraMap K L w := (τ⁻¹ : L ≃ₐ[K] L).commutes w
        _ = α ^ 2 := hα.symm
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h_pos | h_neg
    · change τ (ρ (τ⁻¹ α)) = -α
      rw [h_pos, hρ, map_neg]
      have hτ : τ (τ⁻¹ α) = α := AlgEquiv.apply_symm_apply τ α
      rw [h_pos] at hτ
      rw [hτ]
    · change τ (ρ (τ⁻¹ α)) = -α
      rw [h_neg, map_neg, hρ, neg_neg]
