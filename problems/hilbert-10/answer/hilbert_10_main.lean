    have hd₁_val : (d₁ : K) = (δ : K) := hδ1.symm
    have hd₁_nsq : ¬ IsSquare (algebraMap K (v₁.adicCompletion K) (d₁ : K)) := by
      rw [hd₁_val]; exact hv₁δ
    have hd₂_odd : ¬ EvenVal v₁ d₂ := by
      intro hd₂_ev
      exact hπ_u_odd (((hloc_ev_mul π_u α_u).mp hd₂_ev).mpr hα_ev)
    have horth1 : ∀ r : Kˣ × Kˣ,
        (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₁ →
        (hilbFin v₁ (d₁ : K) (r.2 : K) = 1 ↔ hilbFin v₁ (d₂ : K) (r.1 : K) = 1) := by
      intro r hr_rel
      have hr1_ev : EvenVal v₁ r.1 := hr_ev r hr_rel
      rw [hhilb_nonsq_even_iff d₁ r.2 hd₁_ev hd₁_nsq,
          (hloc_ev_odd r.1 d₂ hr1_ev hd₂_odd).2]
      constructor
      · intro hr2_ev
        have hr_V := h_mem_V_of_relax_even r hr_rel hr1_ev hr2_ev
        have hr1_one : sqCl r.1 = sqCl 1 := hker1 (sqCl r.1, sqCl r.2) hr_V
        exact (hsqCl_sq_iff r.1 1 hr1_one).mpr ⟨1, by simp⟩
      · intro hr1_sq
        by_contra hr2_odd
