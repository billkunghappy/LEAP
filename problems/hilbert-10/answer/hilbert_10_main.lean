        simp only [Set.mem_union, hK₀_U, hU₁_char]
        constructor
        · rintro (⟨hcU, _⟩ | ⟨hcU, _⟩) <;> exact hcU
        · intro hcU
          by_cases hQc : Q c
          · exact Or.inl ⟨hcU, hQc⟩
          · exact Or.inr ⟨hcU, hQc⟩
