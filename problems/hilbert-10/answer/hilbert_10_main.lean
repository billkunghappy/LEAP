  obtain ⟨w_inf, hw_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
  have hw_shift : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds w_inf) :=
    (Filter.tendsto_add_atTop_iff_nat 1).mpr hw_lim
  have hw_rhs : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds (z - w_inf ^ 2)) := by
    have hfun : (fun n => henselSeq z (n + 1)) = (fun n => z - (henselSeq z n) ^ 2) := rfl
    rw [hfun]
    exact tendsto_const_nhds.sub (hw_lim.pow 2)
  have hw_eq : w_inf = z - w_inf ^ 2 := tendsto_nhds_unique hw_shift hw_rhs
  let r : v.adicCompletion K := 1 + 2 * w_inf
  have hr_sq : r ^ 2 = algebraMap K (v.adicCompletion K) (π : K) := by
    rw [hπ_eq_L]
    change (1 + 2 * w_inf) ^ 2 = 1 + 4 * z
    linear_combination 4 * hw_eq
  have hU_nhds : {y : v.adicCompletion K | Valued.v (y - w_inf) < ((1 : (WithZero (Multiplicative ℤ))ˣ) : WithZero (Multiplicative ℤ))} ∈ nhds w_inf := by
    rw [Valued.mem_nhds]
    exact ⟨1, Set.Subset.rfl⟩
  obtain ⟨N, hN⟩ := (Filter.tendsto_atTop'.mp hw_lim) _ hU_nhds
  have hwN_diff : Valued.v (w_inf - henselSeq z N) < 1 := by
    rw [Valuation.map_sub_swap]
    exact hN N le_rfl
  have hwN_lt : Valued.v (henselSeq z N) < 1 := by
    refine lt_of_le_of_lt (hw_le N) ?_
    rw [← WithZero.exp_zero]
    exact WithZero.exp_lt_exp.mpr (by omega)
  have hwinf_lt : Valued.v w_inf < 1 := by
    have hsplit : w_inf = (w_inf - henselSeq z N) + henselSeq z N := by ring
    rw [hsplit]
    exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hwN_diff hwN_lt)
  have h2winf_lt : Valued.v (2 * w_inf) < 1 := by
    rw [two_mul]
    exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hwinf_lt hwinf_lt)
  have hr_ne_zero : r ≠ 0 := by
    intro hr0
    have h2w : 2 * w_inf = -1 := by
      change 1 + 2 * w_inf = 0 at hr0
      linear_combination hr0
    have hval1 : Valued.v (2 * w_inf) = 1 := by
      rw [h2w, Valuation.map_neg, Valuation.map_one]
    exact (ne_of_lt h2winf_lt) hval1
  let u_v : (v.adicCompletion K)ˣ := Units.mk0 r hr_ne_zero
  let C_v : WeierstrassCurve.VariableChange (v.adicCompletion K) := ⟨u_v⁻¹, 0, 0, 0⟩
  have hCu_inv : ((C_v.u⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) = r := by
    change (((u_v⁻¹)⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) = r
    rw [inv_inv]
    rfl
  have hC_v : C_v • ((threeRootsCurve (a₁ : K) (a₂ : K) (a₃ : K)).baseChange (v.adicCompletion K)) =
      (threeRootsCurve ((π * a₁ : NumberField.RingOfIntegers K) : K)
        ((π * a₂ : NumberField.RingOfIntegers K) : K)
        ((π * a₃ : NumberField.RingOfIntegers K) : K)).baseChange (v.adicCompletion K) := by
    ext
    · simp only [WeierstrassCurve.variableChange_a₁, WeierstrassCurve.baseChange,
        WeierstrassCurve.map_a₁, threeRootsCurve, hCu_inv, C_v, map_zero, mul_zero, add_zero]
    · simp only [WeierstrassCurve.variableChange_a₂, WeierstrassCurve.baseChange, WeierstrassCurve.map_a₁,
        WeierstrassCurve.map_a₂, threeRootsCurve, hCu_inv, C_v]
      push_cast
      linear_combination -(algebraMap K (v.adicCompletion K) (a₁ : K) +
        algebraMap K (v.adicCompletion K) (a₂ : K) +
        algebraMap K (v.adicCompletion K) (a₃ : K)) * hr_sq
    · simp only [WeierstrassCurve.variableChange_a₃, WeierstrassCurve.baseChange,
        WeierstrassCurve.map_a₁, WeierstrassCurve.map_a₃, threeRootsCurve, hCu_inv, C_v, map_zero, mul_zero, add_zero]
    · simp only [WeierstrassCurve.variableChange_a₄, WeierstrassCurve.baseChange, WeierstrassCurve.map_a₁,
        WeierstrassCurve.map_a₂, WeierstrassCurve.map_a₃, WeierstrassCurve.map_a₄, threeRootsCurve, hCu_inv, C_v]
      push_cast
      linear_combination (algebraMap K (v.adicCompletion K) (a₁ : K) * algebraMap K (v.adicCompletion K) (a₂ : K) +
        algebraMap K (v.adicCompletion K) (a₁ : K) * algebraMap K (v.adicCompletion K) (a₃ : K) +
        algebraMap K (v.adicCompletion K) (a₂ : K) * algebraMap K (v.adicCompletion K) (a₃ : K)) *
