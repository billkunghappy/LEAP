      refine ⟨x, δ, hx, hαγ, ?_⟩
      intro v₁ hv₁T hv₁B hv₁S hv₁x hv₁δ
      obtain ⟨π_u, hloc⟩ :=
        local_v1_hilbLoc_and_ramLocal_laws K a₁ a₂ a₃ τ T v₁ hstart hT hv₁T (hdesc_outside v₁ hv₁T)
      exact selmerStruct_pivot_at_prime_of_kernel_case K a₁ a₂ a₃ τ T B S π m v₁ π_u x δ
