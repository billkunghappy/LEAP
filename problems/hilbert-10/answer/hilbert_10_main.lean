      rw [h]; exact hval_int v _
    · have h : (threeRootsCurve (e₁ : K) (e₂ : K) (e₃ : K)).a₃ =
          ((0 : NumberField.RingOfIntegers K) : K) := by simp [threeRootsCurve]
      rw [h]; exact hval_int v _
    · have h : (threeRootsCurve (e₁ : K) (e₂ : K) (e₃ : K)).a₄ =
