    exact h_s4 w hw_rel hw_ram
      (Or.inr (Or.inl ⟨hker2, hx2, hr_ev, hw1_odd, hw2_ev, hw2_nsq⟩))
  · 
    have hx_ev : EvenVal v₁ x := (hV_mem_relax_and_ev x x hx3).2.1
    have hr_ev : ∀ r : Kˣ × Kˣ,
        (sqCl r.1, sqCl r.2) ∈ selmerStructRelax K a₁ a₂ a₃ T S π v₁ →
