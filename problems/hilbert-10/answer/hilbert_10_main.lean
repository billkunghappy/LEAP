    have hπ_mem : π ∈ v_π.asIdeal := Ideal.subset_span (Set.mem_singleton π)
    have hone_mem : (1 : NumberField.RingOfIntegers K) ∈ v_π.asIdeal := by
      have h1 : (1 : NumberField.RingOfIntegers K) = π - (π - 1) := by ring
      rw [h1]
      exact v_π.asIdeal.sub_mem hπ_mem hsub_mem
    exact v_π.isPrime.ne_top ((Ideal.eq_top_iff_one v_π.asIdeal).mpr hone_mem)
  have hcoprime_of_not_mem : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      D₀ ∉ v.asIdeal →
      Δ₀ ∉ v.asIdeal ∧
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧
      (3 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v E0.Δ = 1 := by
    intro v hD₀
    have hΔ₀_not : Δ₀ ∉ v.asIdeal := by
      intro hΔ₀
      have hid : D₀ ^ 4 = Δ₀ * (81 * (a₁ - a₂) ^ 2 * (a₁ - a₃) ^ 2 * (a₂ - a₃) ^ 2) := by
        dsimp [D₀, Δ₀]; ring
      have hpow_mem : D₀ ^ 4 ∈ v.asIdeal := by
        rw [hid]
        exact Ideal.mul_mem_right _ v.asIdeal hΔ₀
      exact hD₀ (v.isPrime.mem_of_pow_mem 4 hpow_mem)
    have h2_not : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
      intro h2
      have hid : D₀ = 2 * (3 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)) := by
        dsimp [D₀]; ring
      apply hD₀
      rw [hid]
      exact Ideal.mul_mem_right _ v.asIdeal h2
    have h3_not : (3 : NumberField.RingOfIntegers K) ∉ v.asIdeal := by
      intro h3
      have hid : D₀ = 3 * (2 * (a₁ - a₂) * (a₁ - a₃) * (a₂ - a₃)) := by
        dsimp [D₀]; ring
      apply hD₀
      rw [hid]
      exact Ideal.mul_mem_right _ v.asIdeal h3
    have hval_Δ : IsDedekindDomain.HeightOneSpectrum.valuation K v E0.Δ = 1 := by
      rw [hE0_Δ, v.valuation_of_algebraMap Δ₀,
        IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff]
      exact hΔ₀_not
    exact ⟨hΔ₀_not, h2_not, h3_not, hval_Δ⟩
  have hroot_E0_of_not_mem : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      D₀ ∉ v.asIdeal →
      rootNumber (E0.baseChange (v.adicCompletion K)) = 1 := by
    intro v hD₀
    obtain ⟨ha₁, ha₂, ha₃, ha₄, ha₆⟩ := hcurve_a_le a₁ a₂ a₃ v
    have hval_Δ := (hcoprime_of_not_mem v hD₀).2.2.2
    exact (theorem_3_4 K).1 E0 v ha₁ ha₂ ha₃ ha₄ ha₆ hval_Δ
  have hroot_E_of_not_mem_ne : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      D₀ ∉ v.asIdeal → v ≠ v_π →
      rootNumber (E.baseChange (v.adicCompletion K)) = 1 := by
    intro v hD₀ hne
    have hπ_not : π ∉ v.asIdeal := by
      intro hπ_v
      have hle : v_π.asIdeal ≤ v.asIdeal :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_v)
      have heq : v_π.asIdeal = v.asIdeal := v_π.isMaximal.eq_of_le v.isPrime.ne_top hle
      exact hne (IsDedekindDomain.HeightOneSpectrum.ext heq).symm
    have hval_π : IsDedekindDomain.HeightOneSpectrum.valuation K v (π : K) = 1 := by
      rw [v.valuation_of_algebraMap π,
        IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff]
      exact hπ_not
    have hval_Δ₀ : IsDedekindDomain.HeightOneSpectrum.valuation K v (Δ₀ : K) = 1 := by
      rw [← hE0_Δ]
      exact (hcoprime_of_not_mem v hD₀).2.2.2
    have hval_EΔ : IsDedekindDomain.HeightOneSpectrum.valuation K v E.Δ = 1 := by
      rw [hE_Δ, Valuation.map_mul, Valuation.map_pow, hval_π, hval_Δ₀, one_pow, mul_one]
    obtain ⟨ha₁, ha₂, ha₃, ha₄, ha₆⟩ := hcurve_a_le (π * a₁) (π * a₂) (π * a₃) v
    exact (theorem_3_4 K).1 E v ha₁ ha₂ ha₃ ha₄ ha₆ hval_EΔ
  have hroot_E0_v_π : rootNumber (E0.baseChange (v_π.adicCompletion K)) = 1 :=
    hroot_E0_of_not_mem v_π hD₀_not_mem_v_π
  have hroot_E_v_π : rootNumber (E.baseChange (v_π.adicCompletion K)) = -1 := by
    obtain ⟨ha₁, ha₂, ha₃, ha₄, ha₆⟩ := hcurve_a_le (π * a₁) (π * a₂) (π * a₃) v_π
    obtain ⟨_, h2_not, h3_not, hval_E0Δ⟩ := hcoprime_of_not_mem v_π hD₀_not_mem_v_π
    have hval_π : IsDedekindDomain.HeightOneSpectrum.valuation K v_π (π : K) =
        WithZero.exp (-1 : ℤ) := by
      rw [v_π.valuation_of_algebraMap π]
      exact v_π.intValuation_singleton hπ_ne rfl
    have hval_Δ₀ : IsDedekindDomain.HeightOneSpectrum.valuation K v_π (Δ₀ : K) = 1 := by
      rw [← hE0_Δ]
      exact hval_E0Δ
    have hval_EΔ : IsDedekindDomain.HeightOneSpectrum.valuation K v_π E.Δ =
        WithZero.exp (-((6 : ℕ) : ℤ)) := by
      rw [hE_Δ, Valuation.map_mul, Valuation.map_pow, hval_π, hval_Δ₀, mul_one,
        ← WithZero.exp_nsmul]
      rfl
    have hval_Ec₄ : IsDedekindDomain.HeightOneSpectrum.valuation K v_π E.c₄ < 1 := by
      rw [hE_c₄_coe, v_π.valuation_of_algebraMap (π ^ 2 * c₄₀),
        IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_dvd,
        Ideal.dvd_span_singleton]
      have hπ_mem : π ∈ v_π.asIdeal := Ideal.subset_span (Set.mem_singleton π)
      have hid : π ^ 2 * c₄₀ = π * (π * c₄₀) := by ring
      rw [hid]
      exact Ideal.mul_mem_right (π * c₄₀) v_π.asIdeal hπ_mem
    have hval_Ej : IsDedekindDomain.HeightOneSpectrum.valuation K v_π (E.c₄ ^ 3 / E.Δ) ≤ 1 := by
      rw [hE_j, Valuation.map_div, hval_Δ₀, div_one]
      exact hval_int v_π (c₄₀ ^ 3)
    have hthm := (theorem_3_4 K).2.1 E v_π 6 ha₁ ha₂ ha₃ ha₄ ha₆ (by omega) (by omega)
      hval_EΔ hval_Ec₄ hval_Ej h2_not h3_not
    rw [hthm]
    have hodd : Odd (6 * Ideal.absNorm v_π.asIdeal / 12) := by
      change Odd (6 * Ideal.absNorm (Ideal.span {π}) / 12)
      exact ⟨Ideal.absNorm (Ideal.span {π}) / 4, by omega⟩
    exact hodd.neg_one_pow
  have hI_D₀ : Ideal.span ({D₀} : Set (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Submodule.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact hD₀_ne
  let hfin := Ideal.finite_factors hI_D₀
  let T' : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    hfin.toFinset
  have hmem_T' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v ∈ T' ↔ D₀ ∈ v.asIdeal := by
    intro v
    rw [Set.Finite.mem_toFinset, Set.mem_setOf_eq, Ideal.dvd_span_singleton]
  have hv_π_not_T' : v_π ∉ T' := by
    rw [hmem_T']
    exact hD₀_not_mem_v_π
  let S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    insert v_π T'
  have hsupp_E : Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K) => rootNumber (E.baseChange (v.adicCompletion K))) ⊆ ↑S := by
    intro v hv
    rw [Function.mem_mulSupport] at hv
    by_contra hvS
    rw [Finset.mem_coe, Finset.mem_insert, hmem_T', not_or] at hvS
    exact hv (hroot_E_of_not_mem_ne v hvS.2 hvS.1)
  have hsupp_E0 : Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K) => rootNumber (E0.baseChange (v.adicCompletion K))) ⊆ ↑S := by
    intro v hv
    rw [Function.mem_mulSupport] at hv
    by_contra hvS
    rw [Finset.mem_coe, Finset.mem_insert, hmem_T', not_or] at hvS
    exact hv (hroot_E0_of_not_mem v hvS.2)
  have hprod_T' : (∏ v ∈ T', rootNumber (E.baseChange (v.adicCompletion K))) =
      ∏ v ∈ T', rootNumber (E0.baseChange (v.adicCompletion K)) := by
    apply Finset.prod_congr rfl
    intro v hv
    exact hloc v ((hmem_T' v).mp hv)
  have hfinprod_E : (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      rootNumber (E.baseChange (v.adicCompletion K))) =
      -(∏ v ∈ T', rootNumber (E0.baseChange (v.adicCompletion K))) := by
    rw [finprod_eq_prod_of_mulSupport_subset _ hsupp_E, Finset.prod_insert hv_π_not_T',
      hroot_E_v_π, hprod_T', neg_one_mul]
  have hfinprod_E0 : (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      rootNumber (E0.baseChange (v.adicCompletion K))) =
      ∏ v ∈ T', rootNumber (E0.baseChange (v.adicCompletion K)) := by
    rw [finprod_eq_prod_of_mulSupport_subset _ hsupp_E0, Finset.prod_insert hv_π_not_T',
      hroot_E0_v_π, one_mul]
  have hE0_Δ_ne : E0.Δ ≠ 0 := by
    rw [hE0_Δ]
    exact hΔ₀K_ne
  have hE_Δ_ne : E.Δ ≠ 0 := by
    rw [hE_Δ]
    exact mul_ne_zero (pow_ne_zero 6 hπK_ne) hΔ₀K_ne
  have hinf : (∏ w : NumberField.InfinitePlace K, rootNumber (E.baseChange w.Completion)) =
      ∏ w : NumberField.InfinitePlace K, rootNumber (E0.baseChange w.Completion) := by
    apply Finset.prod_congr rfl
    intro w _
    rw [(theorem_3_4 K).2.2 E w hE_Δ_ne, (theorem_3_4 K).2.2 E0 w hE0_Δ_ne]
  dsimp only [globalRootNumber]
  change (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      rootNumber (E.baseChange (v.adicCompletion K))) *
      (∏ w : NumberField.InfinitePlace K, rootNumber (E.baseChange w.Completion)) =
    -((∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      rootNumber (E0.baseChange (v.adicCompletion K))) *
      (∏ w : NumberField.InfinitePlace K, rootNumber (E0.baseChange w.Completion)))
  rw [hfinprod_E, hfinprod_E0, hinf, neg_mul]

theorem exists_starting_curve (K : Type u) [Field K] [NumberField K]
    (hreal : 32 ≤ NumberField.InfinitePlace.nrRealPlaces K) :
    ∃ (a₁ a₂ a₃ : K)
      (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
      (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))),
      IsStartingTriple K a₁ a₂ a₃ τ ∧ IsGoodT a₁ a₂ a₃ T :=
by
  obtain ⟨a'₁, a'₂, a'₃, τ, σ₁₂, hτ, hσ₁₂, hord⟩ := exists_initial_ordered_triple K hreal
  rcases Int.units_eq_one_or (globalRootNumber (threeRootsCurve (a'₁ : K) (a'₂ : K) (a'₃ : K))) with hroot | hroot
  · obtain ⟨T, hstart, hT⟩ :=
      isStartingTriple_and_exists_goodT_of_orderings K a'₁ a'₂ a'₃ τ hτ hord hroot
    exact ⟨(a'₁ : K), (a'₂ : K), (a'₃ : K), τ, T, hstart, hT⟩
  · have h₁₂ : (a'₁ : K) ≠ (a'₂ : K) := by
      intro h
      have h' : realPlaceEmb (τ 0) (a'₁ : K) = realPlaceEmb (τ 0) (a'₂ : K) := by rw [h]
      exact (ne_of_gt hord.1.1) h'
    have h₁₃ : (a'₁ : K) ≠ (a'₃ : K) := by
      intro h
      have h' : realPlaceEmb (τ 0) (a'₁ : K) = realPlaceEmb (τ 0) (a'₃ : K) := by rw [h]
      exact (ne_of_lt hord.1.2) h'
    have h₂₃ : (a'₂ : K) ≠ (a'₃ : K) := by
      intro h
      have h' : realPlaceEmb (τ 0) (a'₂ : K) = realPlaceEmb (τ 0) (a'₃ : K) := by rw [h]
      exact (ne_of_lt (lt_trans hord.1.1 hord.1.2)) h'
    let m₀ : NumberField.RingOfIntegers K := 6 * (a'₁ - a'₂) * (a'₁ - a'₃) * (a'₂ - a'₃)
    have hm₀ : m₀ ≠ 0 := by
      intro hm
      have hmK : ((m₀ : NumberField.RingOfIntegers K) : K) = 0 := by simp [hm]
      change ((6 * (a'₁ - a'₂) * (a'₁ - a'₃) * (a'₂ - a'₃) : NumberField.RingOfIntegers K) : K) = 0 at hmK
      push_cast at hmK
      have h6 : (6 : K) ≠ 0 := by norm_num
      have hne : (6 : K) * ((a'₁ : K) - (a'₂ : K)) * ((a'₁ : K) - (a'₃ : K)) * ((a'₂ : K) - (a'₃ : K)) ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero h6 (sub_ne_zero.mpr h₁₂)) (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)
      exact hne hmK
    obtain ⟨π, hπ_prime, hπ_mod, hπ_neg, hπ_pos, hπ_norm⟩ :=
      exists_sign_and_congruence_prime K σ₁₂ m₀ hm₀
    have hmul_lt : ∀ (j : Fin 12) (x y : NumberField.RingOfIntegers K),
        realPlaceEmb (τ j) (x : K) < realPlaceEmb (τ j) (y : K) →
        realPlaceEmb (τ j) ((π * x : NumberField.RingOfIntegers K) : K) <
          realPlaceEmb (τ j) ((π * y : NumberField.RingOfIntegers K) : K) := by
      intro j x y hxy
      have hpos : 0 < realPlaceEmb (τ j) (π : K) := hπ_pos (τ j) (hσ₁₂ j).symm
      push_cast
      rw [map_mul, map_mul]
      exact mul_lt_mul_of_pos_left hxy hpos
    rcases hord with ⟨⟨h0a, h0b⟩, ⟨h1a, h1b⟩, ⟨h2a, h2b⟩, ⟨h3a, h3b⟩, ⟨h4a, h4b⟩, ⟨h5a, h5b⟩,
      ⟨h6a, h6b⟩, ⟨h7a, h7b⟩, ⟨h8a, h8b⟩, ⟨h9a, h9b⟩, ⟨h10a, h10b⟩, ⟨h11a, h11b⟩⟩
    have hord' : HasStartingOrderings K ((π * a'₁ : NumberField.RingOfIntegers K) : K)
        ((π * a'₂ : NumberField.RingOfIntegers K) : K)
        ((π * a'₃ : NumberField.RingOfIntegers K) : K) τ :=
      ⟨⟨hmul_lt 0 _ _ h0a, hmul_lt 0 _ _ h0b⟩,
       ⟨hmul_lt 1 _ _ h1a, hmul_lt 1 _ _ h1b⟩,
       ⟨hmul_lt 2 _ _ h2a, hmul_lt 2 _ _ h2b⟩,
       ⟨hmul_lt 3 _ _ h3a, hmul_lt 3 _ _ h3b⟩,
       ⟨hmul_lt 4 _ _ h4a, hmul_lt 4 _ _ h4b⟩,
       ⟨hmul_lt 5 _ _ h5a, hmul_lt 5 _ _ h5b⟩,
       ⟨hmul_lt 6 _ _ h6a, hmul_lt 6 _ _ h6b⟩,
       ⟨hmul_lt 7 _ _ h7a, hmul_lt 7 _ _ h7b⟩,
       ⟨hmul_lt 8 _ _ h8a, hmul_lt 8 _ _ h8b⟩,
       ⟨hmul_lt 9 _ _ h9a, hmul_lt 9 _ _ h9b⟩,
       ⟨hmul_lt 10 _ _ h10a, hmul_lt 10 _ _ h10b⟩,
       ⟨hmul_lt 11 _ _ h11a, hmul_lt 11 _ _ h11b⟩⟩
    have hloc : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        m₀ ∈ v.asIdeal →
        rootNumber ((threeRootsCurve ((π * a'₁ : NumberField.RingOfIntegers K) : K)
            ((π * a'₂ : NumberField.RingOfIntegers K) : K)
            ((π * a'₃ : NumberField.RingOfIntegers K) : K)).baseChange (v.adicCompletion K)) =
          rootNumber ((threeRootsCurve (a'₁ : K) (a'₂ : K) (a'₃ : K)).baseChange (v.adicCompletion K)) :=
      fun v hv => rootNumber_threeRootsCurve_mul_eq_of_sub_one_mem K a'₁ a'₂ a'₃ π m₀ v hπ_mod hv
    have hflip := globalRootNumber_twist_of_prime_mod_four K a'₁ a'₂ a'₃ π h₁₂ h₁₃ h₂₃
      hπ_prime hπ_mod hπ_norm hloc
    have hroot' : globalRootNumber (threeRootsCurve ((π * a'₁ : NumberField.RingOfIntegers K) : K)
        ((π * a'₂ : NumberField.RingOfIntegers K) : K)
        ((π * a'₃ : NumberField.RingOfIntegers K) : K)) = 1 := by
      rw [hflip, hroot, neg_neg]
    obtain ⟨T, hstart, hT⟩ :=
      isStartingTriple_and_exists_goodT_of_orderings K (π * a'₁) (π * a'₂) (π * a'₃) τ hτ hord' hroot'
    exact ⟨((π * a'₁ : NumberField.RingOfIntegers K) : K),
      ((π * a'₂ : NumberField.RingOfIntegers K) : K),
      ((π * a'₃ : NumberField.RingOfIntegers K) : K), τ, T, hstart, hT⟩

theorem isSquare_one_add_of_valuation_lt_one (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1)
    (x : v.adicCompletion K) (hx : Valued.v x < 1) :
    IsSquare (1 + x) :=
by
  have hv2 : Valued.v (2 : v.adicCompletion K) = 1 := by
    rw [← map_ofNat (algebraMap K (v.adicCompletion K)) 2]
    erw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v (2 : K)]
    exact h2
  have hv4 : Valued.v (4 : v.adicCompletion K) = 1 := by
    have h42 : (4 : v.adicCompletion K) = 2 * 2 := by norm_num
    rw [h42, Valuation.map_mul, hv2, mul_one]
  have h4_ne : (4 : v.adicCompletion K) ≠ 0 := by
    intro h0
    rw [h0, Valuation.map_zero] at hv4
    exact zero_ne_one hv4
  let z : v.adicCompletion K := (4 : v.adicCompletion K)⁻¹ * x
  have h1x : 1 + x = 1 + 4 * z := by
    dsimp only [z]
    rw [mul_inv_cancel_left₀ h4_ne]
  have hz_lt : Valued.v z < 1 := by
    dsimp only [z]
    rw [Valuation.map_mul, Valuation.map_inv, hv4, inv_one, one_mul]
    exact hx
  have hz_val : Valued.v z ≤ WithZero.exp (-1 : ℤ) := by
    by_cases hz0 : Valued.v z = 0
    · rw [hz0]
      exact zero_le'
    · obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp hz0
      rw [← hg] at hz_lt ⊢
      have hg_exp : (g : WithZero (Multiplicative ℤ)) = WithZero.exp (Multiplicative.toAdd g) := by
        rw [← ofAdd_toAdd g]
        rfl
      rw [hg_exp] at hz_lt ⊢
      rw [← WithZero.exp_zero] at hz_lt
      have hlt : Multiplicative.toAdd g < 0 := WithZero.exp_lt_exp.mp hz_lt
      exact WithZero.exp_le_exp.mpr (by omega)
  let e₁ : WithZero (Multiplicative ℤ) := WithZero.exp (-1 : ℤ)
  have he₁_le_one : e₁ ≤ 1 := by
    rw [← WithZero.exp_zero]
    exact WithZero.exp_le_exp.mpr (by omega)
  have hw_le : ∀ n : ℕ, Valued.v (henselSeq z n) ≤ e₁ := by
    intro n
    induction n with
    | zero =>
      simp only [henselSeq, Valuation.map_zero]
      exact zero_le'
    | succ n ih =>
      simp only [henselSeq]
      have hsq : Valued.v ((henselSeq z n) ^ 2) ≤ e₁ := by
        rw [sq, Valuation.map_mul]
        calc Valued.v (henselSeq z n) * Valued.v (henselSeq z n)
          _ ≤ e₁ * 1 := mul_le_mul' ih (le_trans ih he₁_le_one)
          _ = e₁ := mul_one e₁
      exact le_trans (Valuation.map_sub _ _ _) (max_le hz_val hsq)
  have hw_diff : ∀ n : ℕ, Valued.v (henselSeq z (n + 1) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
    intro n
    induction n with
    | zero =>
      have h0 : henselSeq z 1 - henselSeq z 0 = z := by
        simp [henselSeq]
      rw [h0]
      simpa using hz_val
    | succ n ih =>
      have hstep : henselSeq z (n + 2) - henselSeq z (n + 1) =
          -(henselSeq z (n + 1) + henselSeq z n) * (henselSeq z (n + 1) - henselSeq z n) := by
        simp only [henselSeq]
        ring
      have hsum : Valued.v (henselSeq z (n + 1) + henselSeq z n) ≤ e₁ :=
        le_trans (Valuation.map_add _ _ _) (max_le (hw_le (n + 1)) (hw_le n))
      rw [hstep, Valuation.map_mul, Valuation.map_neg]
      calc Valued.v (henselSeq z (n + 1) + henselSeq z n) * Valued.v (henselSeq z (n + 1) - henselSeq z n)
        _ ≤ WithZero.exp (-1 : ℤ) * WithZero.exp (-(n + 1 : ℤ)) := mul_le_mul' hsum ih
        _ = WithZero.exp ((-1 : ℤ) + -(n + 1 : ℤ)) := (WithZero.exp_add (-1 : ℤ) (-(n + 1 : ℤ))).symm
        _ = WithZero.exp (-((n + 1 : ℕ) + 1 : ℤ)) := by congr 1; push_cast; ring
  have hw_tele : ∀ n k : ℕ, Valued.v (henselSeq z (n + k) - henselSeq z n) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
    intro n k
    induction k with
    | zero =>
      simp only [Nat.add_zero, sub_self, Valuation.map_zero]
      exact zero_le'
    | succ k ih =>
      have hsplit : henselSeq z (n + (k + 1)) - henselSeq z n =
          (henselSeq z (n + k + 1) - henselSeq z (n + k)) + (henselSeq z (n + k) - henselSeq z n) := by
        have hidx : n + (k + 1) = n + k + 1 := by omega
        rw [hidx]
        ring
      rw [hsplit]
      refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ih)
      refine le_trans (hw_diff (n + k)) ?_
      exact WithZero.exp_le_exp.mpr (by omega)
  have hw_symm : ∀ N a b : ℕ, N ≤ a → N ≤ b →
      Valued.v (henselSeq z b - henselSeq z a) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
    intro N a b ha hb
    have ha' : Valued.v (henselSeq z a - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      have h1 := hw_tele N (a - N)
      rwa [Nat.add_sub_of_le ha] at h1
    have hb' : Valued.v (henselSeq z b - henselSeq z N) ≤ WithZero.exp (-(N + 1 : ℤ)) := by
      have h1 := hw_tele N (b - N)
      rwa [Nat.add_sub_of_le hb] at h1
    have hsub : henselSeq z b - henselSeq z a =
        (henselSeq z b - henselSeq z N) - (henselSeq z a - henselSeq z N) := by ring
    rw [hsub]
    exact le_trans (Valuation.map_sub _ _ _) (max_le hb' ha')
  have hcauchy : CauchySeq (henselSeq z) := by
    rw [CauchySeq, Valued.cauchy_iff]
    refine ⟨Filter.map_neBot, ?_⟩
    intro γ
    obtain ⟨g, hg⟩ := WithZero.ne_zero_iff_exists.mp (Units.ne_zero γ)
    let m : ℤ := Multiplicative.toAdd g
    let N : ℕ := (-m).toNat
    have hlt : WithZero.exp (-(N + 1 : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
      rw [← hg]
      change WithZero.exp (-(N + 1 : ℤ)) < WithZero.exp m
      exact WithZero.exp_lt_exp.mpr (by omega)
    refine ⟨(henselSeq z) '' Set.Ici N, Filter.image_mem_map (Filter.mem_atTop N), ?_⟩
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    exact lt_of_le_of_lt (hw_symm N a b ha hb) hlt
  obtain ⟨w_inf, hw_lim⟩ := cauchySeq_tendsto_of_complete hcauchy
  have hw_shift : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds w_inf) :=
    (Filter.tendsto_add_atTop_iff_nat 1).mpr hw_lim
  have hw_rhs : Filter.Tendsto (fun n => henselSeq z (n + 1)) Filter.atTop (nhds (z - w_inf ^ 2)) := by
    have hfun : (fun n => henselSeq z (n + 1)) = (fun n => z - (henselSeq z n) ^ 2) := rfl
    rw [hfun]
    exact tendsto_const_nhds.sub (hw_lim.pow 2)
  have hw_eq : w_inf = z - w_inf ^ 2 := tendsto_nhds_unique hw_shift hw_rhs
  refine ⟨1 + 2 * w_inf, ?_⟩
  rw [h1x]
  linear_combination -4 * hw_eq

theorem exists_nonSquare_unit_mod_ideal (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1) :
    ∃ ε : NumberField.RingOfIntegers K,
      ε ∉ v.asIdeal ∧
      (∀ s : NumberField.RingOfIntegers K, ε - s ^ 2 ∉ v.asIdeal) ∧
      (∀ r : NumberField.RingOfIntegers K, r ∉ v.asIdeal →
        (∃ s : NumberField.RingOfIntegers K, r - s ^ 2 ∈ v.asIdeal) ∨
        (∃ s : NumberField.RingOfIntegers K, r - ε * s ^ 2 ∈ v.asIdeal)) :=
by
  set R := NumberField.RingOfIntegers K
  set F := R ⧸ v.asIdeal
  haveI : v.asIdeal.IsMaximal := v.isMaximal
  letI : Field F := Ideal.Quotient.field v.asIdeal
  haveI : Finite F := Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  have h2_int : v.intValuation (2 : R) = 1 := by
    have hval : (IsDedekindDomain.HeightOneSpectrum.valuation K v) (algebraMap R K (2 : R)) =
        v.intValuation (2 : R) := v.valuation_of_algebraMap (2 : R)
    rw [map_ofNat] at hval
    exact hval.symm.trans h2
  have h2_notMem : (2 : R) ∉ v.asIdeal := v.intValuation_eq_one_iff.mp h2_int
  have h2F : (2 : F) ≠ 0 := by
    intro h0
    apply h2_notMem
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact (map_ofNat (Ideal.Quotient.mk v.asIdeal) 2).trans h0
  let φ : Fˣ →* Fˣ := powMonoidHom 2
  have hker_iff : ∀ u : Fˣ, u ∈ φ.ker ↔ u = 1 ∨ u = -1 := by
    intro u
    simp only [φ, MonoidHom.mem_ker, powMonoidHom_apply, Units.ext_iff, Units.val_pow_eq_pow_val,
      Units.val_one, sq_eq_one_iff, Units.val_neg]
  have hneg_mem : (-1 : Fˣ) ∈ φ.ker := (hker_iff (-1)).mpr (Or.inr rfl)
  let k_neg : ↥φ.ker := ⟨-1, hneg_mem⟩
  have hk_ne : k_neg ≠ 1 := by
    intro h
    have hval : ((-1 : Fˣ) : F) = ((1 : Fˣ) : F) :=
      congrArg (fun x : ↥φ.ker => ((x : Fˣ) : F)) h
    rw [Units.val_neg, Units.val_one] at hval
    apply h2F
    linear_combination -hval
  have hk_uniq : ∀ y : ↥φ.ker, y ≠ 1 → y = k_neg := by
    intro y hy
    rcases (hker_iff y.1).mp y.2 with h1 | hneg
    · exfalso
      apply hy
      exact Subtype.ext h1
    · exact Subtype.ext hneg
  have hcard_ker : Nat.card ↥φ.ker = 2 :=
    (Nat.card_eq_two_iff' (1 : ↥φ.ker)).mpr ⟨k_neg, hk_ne, hk_uniq⟩
  have hlag1 : Nat.card Fˣ = Nat.card (Fˣ ⧸ φ.ker) * Nat.card ↥φ.ker :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
  have hiso : Nat.card (Fˣ ⧸ φ.ker) = Nat.card ↥φ.range :=
    Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
  have hlag2 : Nat.card Fˣ = Nat.card (Fˣ ⧸ φ.range) * Nat.card ↥φ.range :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup φ.range
  have hpos_range : 0 < Nat.card ↥φ.range := Nat.card_pos
  have hcard_quot : Nat.card (Fˣ ⧸ φ.range) = 2 := by
    have hmul : Nat.card (Fˣ ⧸ φ.range) * Nat.card ↥φ.range = 2 * Nat.card ↥φ.range := by
      calc Nat.card (Fˣ ⧸ φ.range) * Nat.card ↥φ.range
        _ = Nat.card Fˣ := hlag2.symm
        _ = Nat.card (Fˣ ⧸ φ.ker) * Nat.card ↥φ.ker := hlag1
        _ = Nat.card ↥φ.range * 2 := by rw [hiso, hcard_ker]
        _ = 2 * Nat.card ↥φ.range := Nat.mul_comm _ _
    exact Nat.eq_of_mul_eq_mul_right hpos_range hmul
  obtain ⟨q₁, hq₁_ne, hq₁_uniq⟩ := (Nat.card_eq_two_iff' (1 : Fˣ ⧸ φ.range)).mp hcard_quot
  obtain ⟨u₁, hu₁⟩ := QuotientGroup.mk_surjective q₁
  obtain ⟨ε, hε_mk⟩ := Ideal.Quotient.mk_surjective (I := v.asIdeal) (u₁ : F)
  refine ⟨ε, ?_, ?_, ?_⟩
  · intro hε_in
    have h0 : Ideal.Quotient.mk v.asIdeal ε = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hε_in
    rw [hε_mk] at h0
    exact u₁.ne_zero h0
  · intro s hs_in
    have hs0 : Ideal.Quotient.mk v.asIdeal (ε - s ^ 2) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hs_in
    rw [map_sub, map_pow, hε_mk, sub_eq_zero] at hs0
    set sbar : F := Ideal.Quotient.mk v.asIdeal s
    have hsbar_ne : sbar ≠ 0 := by
      intro h
      apply u₁.ne_zero
      rw [hs0, h, sq, zero_mul]
    let w : Fˣ := Units.mk0 sbar hsbar_ne
    have hw : φ w = u₁ := by
      apply Units.ext
      rw [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, hs0]
    have hu₁_mem : u₁ ∈ φ.range := ⟨w, hw⟩
    have hq₁_eq_one : (QuotientGroup.mk u₁ : Fˣ ⧸ φ.range) = 1 :=
      (QuotientGroup.eq_one_iff u₁).mpr hu₁_mem
    rw [hu₁] at hq₁_eq_one
    exact hq₁_ne hq₁_eq_one
  · intro r hr_notMem
    set rbar : F := Ideal.Quotient.mk v.asIdeal r
    have hrbar_ne : rbar ≠ 0 := by
      intro h
      exact hr_notMem (Ideal.Quotient.eq_zero_iff_mem.mp h)
    let u_r : Fˣ := Units.mk0 rbar hrbar_ne
    by_cases hq_r : (QuotientGroup.mk u_r : Fˣ ⧸ φ.range) = 1
    · have hu_r_mem : u_r ∈ φ.range := (QuotientGroup.eq_one_iff u_r).mp hq_r
      obtain ⟨w, hw⟩ := hu_r_mem
      obtain ⟨s, hs_mk⟩ := Ideal.Quotient.mk_surjective (I := v.asIdeal) (w : F)
      left
      refine ⟨s, Ideal.Quotient.eq_zero_iff_mem.mp ?_⟩
      have hw_val : (w : F) ^ 2 = rbar := by
        have h1 := congrArg (fun x : Fˣ => (x : F)) hw
        simpa [φ, powMonoidHom_apply, Units.val_pow_eq_pow_val] using h1
      calc Ideal.Quotient.mk v.asIdeal (r - s ^ 2)
        _ = rbar - (Ideal.Quotient.mk v.asIdeal s) ^ 2 := by rw [map_sub, map_pow]
        _ = rbar - (w : F) ^ 2 := by rw [hs_mk]
        _ = 0 := by rw [hw_val, sub_self]
    · have hq_eq : (QuotientGroup.mk u₁ : Fˣ ⧸ φ.range) = QuotientGroup.mk u_r := by
        rw [hu₁, (hq₁_uniq _ hq_r).symm]
      have hmem : u₁⁻¹ * u_r ∈ φ.range := QuotientGroup.eq.mp hq_eq
      obtain ⟨w, hw⟩ := hmem
      obtain ⟨s, hs_mk⟩ := Ideal.Quotient.mk_surjective (I := v.asIdeal) (w : F)
      right
      refine ⟨s, Ideal.Quotient.eq_zero_iff_mem.mp ?_⟩
      have hw_mul : u₁ * φ w = u_r := by
        rw [hw, mul_inv_cancel_left]
      have hw_val : (u₁ : F) * (w : F) ^ 2 = rbar := by
        have h1 := congrArg (fun x : Fˣ => (x : F)) hw_mul
        simpa [φ, powMonoidHom_apply, Units.val_pow_eq_pow_val] using h1
      calc Ideal.Quotient.mk v.asIdeal (r - ε * s ^ 2)
        _ = rbar - (Ideal.Quotient.mk v.asIdeal ε) * (Ideal.Quotient.mk v.asIdeal s) ^ 2 := by
            rw [map_sub, map_mul, map_pow]
        _ = rbar - (u₁ : F) * (w : F) ^ 2 := by rw [hε_mk, hs_mk]
        _ = 0 := by rw [hw_val, sub_self]

theorem exists_ringOfIntegers_sub_valuation_lt_one (K : Type u) [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (u : v.adicCompletion K) (hu : Valued.v u = 1) :
    ∃ r : NumberField.RingOfIntegers K,
      r ∉ v.asIdeal ∧
      Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)) < 1 :=
by
  classical
  have h_nhds : {y : v.adicCompletion K | Valued.v (y - u) < (1 : WithZero (Multiplicative ℤ))} ∈ nhds u := by
    rw [Valued.mem_nhds]
    exact ⟨1, fun y hy => hy⟩
  obtain ⟨x : K, hx_lt⟩ := DenseRange.mem_nhds UniformSpace.Completion.denseRange_coe h_nhds
  change Valued.v (algebraMap K (v.adicCompletion K) x - u) < 1 at hx_lt
  have hu_x_lt : Valued.v (u - algebraMap K (v.adicCompletion K) x) < 1 := by
    rwa [Valuation.map_sub_swap]
  have hx_val_L : Valued.v (algebraMap K (v.adicCompletion K) x) = 1 := by
    have h1 : algebraMap K (v.adicCompletion K) x = u + (algebraMap K (v.adicCompletion K) x - u) := by ring
    have hdist : Valued.v u ≠ Valued.v (algebraMap K (v.adicCompletion K) x - u) := by
      rw [hu]
      exact ne_of_gt hx_lt
    rw [h1, Valuation.map_add_of_distinct_val _ hdist, hu, max_eq_left (le_of_lt hx_lt)]
  have hx_val : (IsDedekindDomain.HeightOneSpectrum.valuation K v) x = 1 := by
    rw [← v.valuedAdicCompletion_eq_valuation' x]
    exact hx_val_L
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) x
  have hb0 : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
  have hb_val_ne : v.intValuation b ≠ 0 := v.intValuation_ne_zero' ⟨b, hb⟩
  have hab_val : v.intValuation a = v.intValuation b := by
    have hdiv : (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K a /
        algebraMap (NumberField.RingOfIntegers K) K b) = 1 := by
      rw [hab, hx_val]
    rw [Valuation.map_div, v.valuation_of_algebraMap, v.valuation_of_algebraMap] at hdiv
    exact (div_eq_one_iff_eq hb_val_ne).mp hdiv
  set k : ℕ := (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {b})).factors
  have hb_exp : v.intValuation b = WithZero.exp (-(k : ℤ)) := v.intValuation_if_neg hb0
  have ha_exp : v.intValuation a = WithZero.exp (-(k : ℤ)) := hab_val.trans hb_exp
  have ha_mem : a ∈ v.asIdeal ^ k := (v.intValuation_le_pow_iff_mem a k).mp (le_of_eq ha_exp)
  have hb_mem : b ∈ v.asIdeal ^ k := (v.intValuation_le_pow_iff_mem b k).mp (le_of_eq hb_exp)
  have hb_not_mem : b ∉ v.asIdeal ^ (k + 1) := by
    intro hmem
    have hle := (v.intValuation_le_pow_iff_mem b (k + 1)).mpr hmem
    rw [hb_exp, WithZero.exp_le_exp] at hle
    omega
  have hI_eq : Ideal.span {b} ⊔ v.asIdeal ^ (k + 1) = v.asIdeal ^ k := by
    set I : Ideal (NumberField.RingOfIntegers K) := Ideal.span {b} ⊔ v.asIdeal ^ (k + 1)
    have hI_le : I ≤ v.asIdeal ^ k :=
      sup_le ((Ideal.span_singleton_le_iff_mem (v.asIdeal ^ k)).mpr hb_mem)
        (Ideal.pow_le_pow_right (Nat.le_succ k))
    obtain ⟨J, hIJ⟩ := Ideal.dvd_iff_le.mpr hI_le
    obtain ⟨C, hIC⟩ := Ideal.dvd_iff_le.mpr (le_sup_right : v.asIdeal ^ (k + 1) ≤ I)
    have hvk_ne : (v.asIdeal ^ k : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := pow_ne_zero k v.ne_bot
    have hv_eq : v.asIdeal = J * C := by
      apply mul_left_cancel₀ hvk_ne
      calc v.asIdeal ^ k * v.asIdeal
        _ = v.asIdeal ^ (k + 1) := (pow_succ v.asIdeal k).symm
        _ = I * C := hIC
        _ = (v.asIdeal ^ k * J) * C := by rw [hIJ]
        _ = v.asIdeal ^ k * (J * C) := mul_assoc _ _ _
    have hvJ : v.asIdeal ≤ J := Ideal.dvd_iff_le.mp ⟨C, hv_eq⟩
    have hJ_top : J = ⊤ := by
      by_contra hJ
      have hvJ_eq : v.asIdeal = J := v.isMaximal.eq_of_le hJ hvJ
      have hI_k1 : I = v.asIdeal ^ (k + 1) := by
        rw [hIJ, ← hvJ_eq, ← pow_succ]
      have hb_in_I : b ∈ I := Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton b))
      rw [hI_k1] at hb_in_I
      exact hb_not_mem hb_in_I
    rw [hIJ, hJ_top, Ideal.mul_top]
  have ha_in_sup : a ∈ Ideal.span {b} ⊔ v.asIdeal ^ (k + 1) := by
    rwa [hI_eq]
  obtain ⟨y, hy, m, hm, hym⟩ := Submodule.mem_sup.mp ha_in_sup
  obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hy
  have harb_mem : a - r * b ∈ v.asIdeal ^ (k + 1) := by
    have h_eq : a - r * b = m := by
      rw [← hym]
      ring
    rwa [h_eq]
  have harb_lt : v.intValuation (a - r * b) < v.intValuation b := by
    have hle := (v.intValuation_le_pow_iff_mem (a - r * b) (k + 1)).mpr harb_mem
    have hlt : WithZero.exp (-((k + 1 : ℕ) : ℤ)) < WithZero.exp (-(k : ℤ)) := by
      rw [WithZero.exp_lt_exp]
      omega
    rw [hb_exp]
    exact lt_of_le_of_lt hle hlt
  have hbK_ne : (algebraMap (NumberField.RingOfIntegers K) K b) ≠ 0 :=
    (map_ne_zero_iff (algebraMap (NumberField.RingOfIntegers K) K)
      (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hb0
  have hxr_eq : x - (r : K) =
      algebraMap (NumberField.RingOfIntegers K) K (a - r * b) /
      algebraMap (NumberField.RingOfIntegers K) K b := by
    change x - algebraMap (NumberField.RingOfIntegers K) K r = _
    rw [← hab, map_sub, map_mul, sub_div, mul_div_cancel_right₀ _ hbK_ne]
  have hxr_val_lt : (v.valuation K) (x - (r : K)) < 1 := by
    rw [hxr_eq, Valuation.map_div, v.valuation_of_algebraMap, v.valuation_of_algebraMap]
    have hb_pos : 0 < v.intValuation b := by
      rw [hb_exp]
      exact WithZero.exp_pos
    rw [div_lt_iff₀ hb_pos, one_mul]
    exact harb_lt
  have hxr_L_lt : Valued.v (algebraMap K (v.adicCompletion K) x - algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
    rw [← map_sub]
    erw [v.valuedAdicCompletion_eq_valuation' (x - (r : K))]
    exact hxr_val_lt
  have hur_lt : Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
    have h_add : u - algebraMap K (v.adicCompletion K) (r : K) =
        (u - algebraMap K (v.adicCompletion K) x) +
        (algebraMap K (v.adicCompletion K) x - algebraMap K (v.adicCompletion K) (r : K)) := by ring
    rw [h_add]
    exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hu_x_lt hxr_L_lt)
  have hr_not_mem : r ∉ v.asIdeal := by
    intro hr_mem
    have hr_int_lt : v.intValuation r < 1 := (v.intValuation_lt_one_iff_mem r).mpr hr_mem
    have hr_K_lt : (v.valuation K) (r : K) < 1 := by
      change (v.valuation K) (algebraMap (NumberField.RingOfIntegers K) K r) < 1
      rwa [v.valuation_of_algebraMap]
    have hr_L_lt : Valued.v (algebraMap K (v.adicCompletion K) (r : K)) < 1 := by
      erw [v.valuedAdicCompletion_eq_valuation' (r : K)]
      exact hr_K_lt
    have hu_lt : Valued.v u < 1 := by
      have h_u : u = (u - algebraMap K (v.adicCompletion K) (r : K)) +
          algebraMap K (v.adicCompletion K) (r : K) := by ring
      calc Valued.v u
        _ = Valued.v ((u - algebraMap K (v.adicCompletion K) (r : K)) +
            algebraMap K (v.adicCompletion K) (r : K)) := by rw [← h_u]
        _ ≤ max (Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)))
            (Valued.v (algebraMap K (v.adicCompletion K) (r : K))) :=
            Valuation.map_add _ _ _
        _ < 1 := max_lt hur_lt hr_L_lt
    rw [hu] at hu_lt
    exact lt_irrefl 1 hu_lt
  exact ⟨r, hr_not_mem, hur_lt⟩

theorem isDescentClass_iff_evenVal_of_notMem_T (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (h₁₂ : a₁ ≠ a₂) (h₁₃ : a₁ ≠ a₃) (h₂₃ : a₂ ≠ a₃)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : (IsDedekindDomain.HeightOneSpectrum.valuation K v) 2 = 1)
    (hhensel : ∀ x : v.adicCompletion K, Valued.v x < 1 → IsSquare (1 + x))
    (hmod : ∃ ε : NumberField.RingOfIntegers K,
      ε ∉ v.asIdeal ∧
      (∀ s : NumberField.RingOfIntegers K, ε - s ^ 2 ∉ v.asIdeal) ∧
      (∀ r : NumberField.RingOfIntegers K, r ∉ v.asIdeal →
        (∃ s : NumberField.RingOfIntegers K, r - s ^ 2 ∈ v.asIdeal) ∨
        (∃ s : NumberField.RingOfIntegers K, r - ε * s ^ 2 ∈ v.asIdeal)))
    (happrox : ∀ u : v.adicCompletion K, Valued.v u = 1 →
      ∃ r : NumberField.RingOfIntegers K,
        r ∉ v.asIdeal ∧
        Valued.v (u - algebraMap K (v.adicCompletion K) (r : K)) < 1)
    (hdesc_even : ∀ d₁ d₂ : (v.adicCompletion K)ˣ,
      IsDescentClass
        (algebraMap K (v.adicCompletion K) a₁)
        (algebraMap K (v.adicCompletion K) a₂)
        (algebraMap K (v.adicCompletion K) a₃)
        (d₁ : v.adicCompletion K)
        (d₂ : v.adicCompletion K) →
      IsSquare (Valued.v (d₁ : v.adicCompletion K)) ∧
      IsSquare (Valued.v (d₂ : v.adicCompletion K)))
    (p : Kˣ × Kˣ) :
    IsDescentClass
      (algebraMap K (v.adicCompletion K) a₁)
      (algebraMap K (v.adicCompletion K) a₂)
      (algebraMap K (v.adicCompletion K) a₃)
      (algebraMap K (v.adicCompletion K) (p.1 : K))
      (algebraMap K (v.adicCompletion K) (p.2 : K)) ↔
    EvenVal v p.1 ∧ EvenVal v p.2 :=
by
  have hv_eq : ∀ k : K, Valued.v (algebraMap K (v.adicCompletion K) k) =
      (IsDedekindDomain.HeightOneSpectrum.valuation K v) k :=
    fun k => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v k
  have hv_int : ∀ r : NumberField.RingOfIntegers K,
      Valued.v (algebraMap K (v.adicCompletion K) (r : K)) = v.intValuation r := by
    intro r
    rw [hv_eq]
    exact v.valuation_of_algebraMap r
  have heven_iff : ∀ x : Kˣ,
      EvenVal v x ↔ IsSquare (Valued.v (algebraMap K (v.adicCompletion K) (x : K))) := by
    intro x
    constructor
    · rintro ⟨k, hk⟩
      refine ⟨((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)), ?_⟩
      rw [hv_eq, ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v x,
        ← WithZero.coe_mul, WithZero.coe_inj, ← ofAdd_add, ← hk, ofAdd_toAdd]
    · rintro ⟨r, hr⟩
