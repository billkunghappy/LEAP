    choose X_loc Y_loc hX₁ hX₂ hX₃ hY_loc using hloc
    let e := Ideal.quotientInfRingEquivPiQuotient (fun q : S_p => q.1.asIdeal) hcop
    obtain ⟨X, hX⟩ := Ideal.Quotient.mk_surjective
      (e.symm (fun q : S_p => Ideal.Quotient.mk q.1.asIdeal (X_loc q.1)))
    obtain ⟨Y, hY⟩ := Ideal.Quotient.mk_surjective
      (e.symm (fun q : S_p => Ideal.Quotient.mk q.1.asIdeal (Y_loc q.1)))
    have hX_mem (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (h𝔭 : (p : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal) :
        X - X_loc 𝔭 ∈ 𝔭.asIdeal := by
      let q : S_p := ⟨𝔭, (hmem_Sp 𝔭).mpr h𝔭⟩
      have hq := congr_arg (fun u => e u q) hX
      dsimp only at hq
      rw [e.apply_symm_apply] at hq
      exact Ideal.Quotient.eq.mp hq
    have hY_mem (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (h𝔭 : (p : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal) :
        Y - Y_loc 𝔭 ∈ 𝔭.asIdeal := by
      let q : S_p := ⟨𝔭, (hmem_Sp 𝔭).mpr h𝔭⟩
      have hq := congr_arg (fun u => e u q) hY
      dsimp only at hq
      rw [e.apply_symm_apply] at hq
      exact Ideal.Quotient.eq.mp hq
    refine ⟨kaiLift ω X Y, fun i 𝔭 h𝔭 => ?_⟩
    have haff := affEval_suitC_eq (kaiLift ω X Y)
    have hXY := kaiLift_spec X Y
    have hXm := hX_mem 𝔭 h𝔭
    have hYm := hY_mem 𝔭 h𝔭
    fin_cases i
    · change affEval (suitC0 a₁_int a₂_int a₃_int μ l 0) (suitC ω a₁_int a₂_int a₃_int μ 0) (kaiLift ω X Y) ∉ 𝔭.asIdeal
      intro hmem
      apply hX₁ 𝔭
      rw [haff.1, hXY.1, hXY.2] at hmem
      have h1 : 1 + μ * X_loc 𝔭 + a₁_int * μ * (μ * Y_loc 𝔭 + l) =
          (1 + μ * X + a₁_int * μ * (μ * Y + l)) -
          μ * (X - X_loc 𝔭) - (a₁_int * μ ^ 2) * (Y - Y_loc 𝔭) := by ring
      rw [h1]
      exact 𝔭.asIdeal.sub_mem
        (𝔭.asIdeal.sub_mem hmem (𝔭.asIdeal.mul_mem_left _ hXm))
        (𝔭.asIdeal.mul_mem_left _ hYm)
    · change affEval (suitC0 a₁_int a₂_int a₃_int μ l 1) (suitC ω a₁_int a₂_int a₃_int μ 1) (kaiLift ω X Y) ∉ 𝔭.asIdeal
      intro hmem
      apply hX₂ 𝔭
      rw [haff.2.1, hXY.1, hXY.2] at hmem
      have h1 : 1 + μ * X_loc 𝔭 + a₂_int * μ * (μ * Y_loc 𝔭 + l) =
          (1 + μ * X + a₂_int * μ * (μ * Y + l)) -
          μ * (X - X_loc 𝔭) - (a₂_int * μ ^ 2) * (Y - Y_loc 𝔭) := by ring
      rw [h1]
      exact 𝔭.asIdeal.sub_mem
        (𝔭.asIdeal.sub_mem hmem (𝔭.asIdeal.mul_mem_left _ hXm))
        (𝔭.asIdeal.mul_mem_left _ hYm)
    · change affEval (suitC0 a₁_int a₂_int a₃_int μ l 2) (suitC ω a₁_int a₂_int a₃_int μ 2) (kaiLift ω X Y) ∉ 𝔭.asIdeal
      intro hmem
      apply hX₃ 𝔭
      rw [haff.2.2.1, hXY.1, hXY.2] at hmem
      have h1 : 1 + μ * X_loc 𝔭 + a₃_int * μ * (μ * Y_loc 𝔭 + l) =
          (1 + μ * X + a₃_int * μ * (μ * Y + l)) -
          μ * (X - X_loc 𝔭) - (a₃_int * μ ^ 2) * (Y - Y_loc 𝔭) := by ring
      rw [h1]
      exact 𝔭.asIdeal.sub_mem
        (𝔭.asIdeal.sub_mem hmem (𝔭.asIdeal.mul_mem_left _ hXm))
        (𝔭.asIdeal.mul_mem_left _ hYm)
    · change affEval (suitC0 a₁_int a₂_int a₃_int μ l 3) (suitC ω a₁_int a₂_int a₃_int μ 3) (kaiLift ω X Y) ∉ 𝔭.asIdeal
      intro hmem
      apply hY_loc 𝔭
      rw [haff.2.2.2, hXY.2] at hmem
      have h1 : μ * Y_loc 𝔭 + l = (μ * Y + l) - μ * (Y - Y_loc 𝔭) := by ring
      rw [h1]
      exact 𝔭.asIdeal.sub_mem hmem (𝔭.asIdeal.mul_mem_left _ hYm)

theorem suitCone_volume_lower_bound (K : Type u) [Field K] [NumberField K]
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (haux : IsAuxiliaryTwist K a₁ a₂ a₃ τ T S π κ z)
    (a₁_int a₂_int a₃_int m μ l : NumberField.RingOfIntegers K)
    (ha₁ : (a₁_int : K) = a₁) (ha₂ : (a₂_int : K) = a₂) (ha₃ : (a₃_int : K) = a₃)
    (hm : (m : K) ≠ 0) (hμ : (μ : K) = (m : K) ^ 2 * (κ : K)) :
    (∀ N : ℕ,
      MeasurableSet (suitCone τ (κ : K) (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ) ∩
        realBox (2 * Module.finrank ℚ K) (N : ℝ)) ∧
      Convex ℝ (suitCone τ (κ : K) (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ) ∩
        realBox (2 * Module.finrank ℚ K) (N : ℝ)) ∧
      suitCone τ (κ : K) (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ) ∩
        realBox (2 * Module.finrank ℚ K) (N : ℝ) ⊆ realBox (2 * Module.finrank ℚ K) (N : ℝ)) ∧
    ∃ C_vol : ℝ, 0 < C_vol ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
      C_vol * (N : ℝ) ^ (2 * Module.finrank ℚ K) ≤
        (MeasureTheory.volume
          (suitCone τ (κ : K) (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ) ∩
            realBox (2 * Module.finrank ℚ K) (N : ℝ))).toReal :=
by
  classical
  let d : ℕ := 2 * Module.finrank ℚ K
  let c₀ : Fin 4 → NumberField.RingOfIntegers K := suitC0 a₁_int a₂_int a₃_int μ l
  let c : Fin 4 → Fin d → NumberField.RingOfIntegers K := suitC ω a₁_int a₂_int a₃_int μ
  
  have hcont_hom (w : {w : NumberField.InfinitePlace K // w.IsReal})
      (ci : Fin d → NumberField.RingOfIntegers K) :
      Continuous (realHomEval w ci) := by
    unfold realHomEval
    exact continuous_finset_sum Finset.univ (fun k _ => (continuous_apply k).mul continuous_const)
  have hcont_aff (w : {w : NumberField.InfinitePlace K // w.IsReal})
      (c0i : NumberField.RingOfIntegers K)
      (ci : Fin d → NumberField.RingOfIntegers K) :
      Continuous (realAffEval w c0i ci) := by
    unfold realAffEval
    exact continuous_const.add (hcont_hom w ci)
  have hopen_hom (ε : ℝ) : IsOpen (suitHomCone τ (κ : K) c ε) := by
    unfold suitHomCone
    simp only [Set.setOf_and, Set.setOf_forall]
    refine IsOpen.inter ?_ (IsOpen.inter ?_ ?_)
    · refine isOpen_iInter_of_finite (fun w => isOpen_iInter_of_finite (fun _ => ?_))
      exact (isOpen_lt continuous_const (hcont_hom w (c 0))).inter
        ((isOpen_lt continuous_const (hcont_hom w (c 1))).inter
          ((isOpen_lt continuous_const (hcont_hom w (c 2))).inter
            (isOpen_lt continuous_const (continuous_const.mul (hcont_hom w (c 3))))))
    · exact isOpen_iInter_of_finite (fun j => isOpen_lt continuous_const (hcont_hom _ (c 3)))
    · repeat' refine IsOpen.inter ?_ ?_
      all_goals first
        | exact isOpen_lt (hcont_hom _ _) continuous_const
        | exact isOpen_lt continuous_const (hcont_hom _ _)
  have hopen_cone : IsOpen (suitCone τ (κ : K) c₀ c) := by
    unfold suitCone
    simp only [Set.setOf_and, Set.setOf_forall]
    refine IsOpen.inter ?_ (IsOpen.inter ?_ ?_)
    · refine isOpen_iInter_of_finite (fun w => isOpen_iInter_of_finite (fun _ => ?_))
      exact (isOpen_lt continuous_const (hcont_aff w (c₀ 0) (c 0))).inter
        ((isOpen_lt continuous_const (hcont_aff w (c₀ 1) (c 1))).inter
          ((isOpen_lt continuous_const (hcont_aff w (c₀ 2) (c 2))).inter
            (isOpen_lt continuous_const (continuous_const.mul (hcont_aff w (c₀ 3) (c 3))))))
    · exact isOpen_iInter_of_finite (fun j => isOpen_lt continuous_const (hcont_aff _ (c₀ 3) (c 3)))
    · repeat' refine IsOpen.inter ?_ ?_
      all_goals first
        | exact isOpen_lt (hcont_aff _ _ _) continuous_const
        | exact isOpen_lt continuous_const (hcont_aff _ _ _)
  have haff_comb (w : {w : NumberField.InfinitePlace K // w.IsReal})
      (c0i : NumberField.RingOfIntegers K)
      (ci : Fin d → NumberField.RingOfIntegers K)
      (x y : Fin d → ℝ) {a b : ℝ} (hab : a + b = 1) :
      realAffEval w c0i ci (a • x + b • y) =
        a * realAffEval w c0i ci x + b * realAffEval w c0i ci y := by
    unfold realAffEval
    have hsum : (∑ k : Fin d, (a • x + b • y) k * realPlaceEmb w (ci k : K)) =
        a * (∑ k : Fin d, x k * realPlaceEmb w (ci k : K)) +
        b * (∑ k : Fin d, y k * realPlaceEmb w (ci k : K)) := by
      calc (∑ k : Fin d, (a • x + b • y) k * realPlaceEmb w (ci k : K))
        _ = ∑ k : Fin d, (a * (x k * realPlaceEmb w (ci k : K)) +
              b * (y k * realPlaceEmb w (ci k : K))) := by
            refine Finset.sum_congr rfl fun k _ => ?_
            simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
            ring
        _ = (∑ k : Fin d, a * (x k * realPlaceEmb w (ci k : K))) +
              (∑ k : Fin d, b * (y k * realPlaceEmb w (ci k : K))) := Finset.sum_add_distrib
        _ = a * (∑ k : Fin d, x k * realPlaceEmb w (ci k : K)) +
              b * (∑ k : Fin d, y k * realPlaceEmb w (ci k : K)) := by
            rw [← Finset.mul_sum, ← Finset.mul_sum]
    rw [hsum]
    calc realPlaceEmb w (c0i : K) +
          (a * ∑ k : Fin d, x k * realPlaceEmb w (ci k : K) +
           b * ∑ k : Fin d, y k * realPlaceEmb w (ci k : K))
      _ = (a + b) * realPlaceEmb w (c0i : K) +
          (a * ∑ k : Fin d, x k * realPlaceEmb w (ci k : K) +
           b * ∑ k : Fin d, y k * realPlaceEmb w (ci k : K)) := by rw [hab, one_mul]
      _ = a * (realPlaceEmb w (c0i : K) + ∑ k : Fin d, x k * realPlaceEmb w (ci k : K)) +
          b * (realPlaceEmb w (c0i : K) + ∑ k : Fin d, y k * realPlaceEmb w (ci k : K)) := by ring
  have hpos_comb {a b u v : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1)
      (hu : 0 < u) (hv : 0 < v) : 0 < a * u + b * v := by
    rcases eq_or_lt_of_le ha with rfl | ha'
    · simp only [zero_mul, zero_add] at hab ⊢
      rw [hab, one_mul]
      exact hv
    · exact add_pos_of_pos_of_nonneg (mul_pos ha' hu) (mul_nonneg hb (le_of_lt hv))
  have hneg_comb {a b u v : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1)
      (hu : u < 0) (hv : v < 0) : a * u + b * v < 0 := by
    have := hpos_comb ha hb hab (neg_pos.mpr hu) (neg_pos.mpr hv)
    linarith
  have hconv_cone : Convex ℝ (suitCone τ (κ : K) c₀ c) := by
    intro x hx y hy a b ha hb hab
    rcases hx with ⟨hx_w, hx_j, hx00, hx01, hx02, hx10, hx11, hx12, hx20, hx21, hx22,
      hx30, hx31, hx32, hx40, hx41, hx42, hx50, hx51, hx52⟩
    rcases hy with ⟨hy_w, hy_j, hy00, hy01, hy02, hy10, hy11, hy12, hy20, hy21, hy22,
      hy30, hy31, hy32, hy40, hy41, hy42, hy50, hy51, hy52⟩
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro w hw
      have hxw := hx_w w hw
      have hyw := hy_w w hw
      refine ⟨?_, ?_, ?_, ?_⟩
      · rw [haff_comb w (c₀ 0) (c 0) x y hab]
        exact hpos_comb ha hb hab hxw.1 hyw.1
      · rw [haff_comb w (c₀ 1) (c 1) x y hab]
        exact hpos_comb ha hb hab hxw.2.1 hyw.2.1
      · rw [haff_comb w (c₀ 2) (c 2) x y hab]
        exact hpos_comb ha hb hab hxw.2.2.1 hyw.2.2.1
      · rw [haff_comb w (c₀ 3) (c 3) x y hab]
        have hmul : realPlaceEmb w (κ : K) *
            (a * realAffEval w (c₀ 3) (c 3) x + b * realAffEval w (c₀ 3) (c 3) y) =
            a * (realPlaceEmb w (κ : K) * realAffEval w (c₀ 3) (c 3) x) +
            b * (realPlaceEmb w (κ : K) * realAffEval w (c₀ 3) (c 3) y) := by ring
        rw [hmul]
        exact hpos_comb ha hb hab hxw.2.2.2 hyw.2.2.2
    · intro j
      rw [haff_comb _ (c₀ 3) (c 3) x y hab]
      exact hpos_comb ha hb hab (hx_j j) (hy_j j)
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx00 hy00
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx01 hy01
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx02 hy02
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx10 hy10
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx11 hy11
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx12 hy12
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx20 hy20
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx21 hy21
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx22 hy22
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx30 hy30
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx31 hy31
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx32 hy32
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx40 hy40
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx41 hy41
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx42 hy42
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx50 hy50
    · rw [haff_comb _ _ _ x y hab]; exact hpos_comb ha hb hab hx51 hy51
    · rw [haff_comb _ _ _ x y hab]; exact hneg_comb ha hb hab hx52 hy52
  have hmeas_conv (N : ℕ) :
      MeasurableSet (suitCone τ (κ : K) c₀ c ∩ realBox d (N : ℝ)) ∧
      Convex ℝ (suitCone τ (κ : K) c₀ c ∩ realBox d (N : ℝ)) ∧
      suitCone τ (κ : K) c₀ c ∩ realBox d (N : ℝ) ⊆ realBox d (N : ℝ) := by
    have hclosed_box : IsClosed (realBox d (N : ℝ)) := by
      unfold realBox
      rw [Set.setOf_forall]
      exact isClosed_iInter (fun k => isClosed_le (continuous_abs.comp (continuous_apply k)) continuous_const)
    have hconv_box : Convex ℝ (realBox d (N : ℝ)) := by
      intro x hx y hy a b ha hb hab k
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      calc |a * x k + b * y k|
        _ ≤ |a * x k| + |b * y k| := abs_add_le _ _
        _ = a * |x k| + b * |y k| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ ≤ a * (N : ℝ) + b * (N : ℝ) :=
            add_le_add (mul_le_mul_of_nonneg_left (hx k) ha) (mul_le_mul_of_nonneg_left (hy k) hb)
        _ = (a + b) * (N : ℝ) := by ring
        _ = (N : ℝ) := by rw [hab, one_mul]
    exact ⟨hopen_cone.measurableSet.inter hclosed_box.measurableSet,
      hconv_cone.inter hconv_box, Set.inter_subset_right⟩
  
  rcases hstart with ⟨_, _, _, _, _, _, _, _, _, _, hτ_inj, hτ0, hτ1, hτ2, hτ3, hτ4, hτ5, _⟩
  rcases haux with ⟨_, _, _, _, _, hκ0, hκ1, hκ2, hκ3, hκ4, hκ5, _⟩
  have realCoordLift_spec (x y : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ)
      (w : {w : NumberField.InfinitePlace K // w.IsReal}) :
      realCoordX ω w (realCoordLift ω x y) = x w ∧
      realCoordY ω w (realCoordLift ω x y) = y w := by
    have hSingle (f : {w : NumberField.InfinitePlace K // w.IsReal} → ℝ) :
        (∑ r : Fin (Module.finrank ℚ K),
          realCoordLiftSingle ω f r * realPlaceEmb w (ω r : K)) = f w := by
      let φ : NumberField.RingOfIntegers K →+* ℝ :=
        (realPlaceEmb w).comp (algebraMap (NumberField.RingOfIntegers K) K)
      have hBi (i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) :
          (∑ r : Fin (Module.finrank ℚ K),
            ((ω.repr (NumberField.RingOfIntegers.basis K i) r : ℤ) : ℝ) * realPlaceEmb w (ω r : K)) =
          (NumberField.mixedEmbedding.latticeBasis K i).1 w := by
        have h1 := congr_arg φ (ω.sum_repr (NumberField.RingOfIntegers.basis K i))
        simp only [map_sum, zsmul_eq_mul, map_mul, map_intCast, φ, RingHom.comp_apply] at h1
        change (∑ r : Fin (Module.finrank ℚ K),
            ((ω.repr (NumberField.RingOfIntegers.basis K i) r : ℤ) : ℝ) * realPlaceEmb w (ω r : K)) =
          realPlaceEmb w (NumberField.RingOfIntegers.basis K i : K) at h1
        rw [h1, NumberField.mixedEmbedding.latticeBasis_apply, NumberField.integralBasis_apply]
        rfl
      calc (∑ r : Fin (Module.finrank ℚ K),
            realCoordLiftSingle ω f r * realPlaceEmb w (ω r : K))
        _ = ∑ r : Fin (Module.finrank ℚ K),
              ∑ i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K),
                ((NumberField.mixedEmbedding.latticeBasis K).repr
                  ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i) *
                (((ω.repr (NumberField.RingOfIntegers.basis K i) r : ℤ) : ℝ) *
                  realPlaceEmb w (ω r : K)) := by
            refine Finset.sum_congr rfl fun r _ => ?_
            unfold realCoordLiftSingle
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun i _ => ?_
            ring
        _ = ∑ i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K),
              ∑ r : Fin (Module.finrank ℚ K),
                ((NumberField.mixedEmbedding.latticeBasis K).repr
                  ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i) *
                (((ω.repr (NumberField.RingOfIntegers.basis K i) r : ℤ) : ℝ) *
                  realPlaceEmb w (ω r : K)) := Finset.sum_comm
        _ = ∑ i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K),
              ((NumberField.mixedEmbedding.latticeBasis K).repr
                ((f, 0) : NumberField.mixedEmbedding.mixedSpace K) i) *
              (NumberField.mixedEmbedding.latticeBasis K i).1 w := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [← Finset.mul_sum, hBi i]
        _ = f w := by
            have h2 := congr_arg (fun m : NumberField.mixedEmbedding.mixedSpace K => m.1 w)
              ((NumberField.mixedEmbedding.latticeBasis K).sum_repr
                ((f, 0) : NumberField.mixedEmbedding.mixedSpace K))
            simpa [Prod.fst_sum, Finset.sum_apply, smul_eq_mul] using h2
    constructor
    · unfold realCoordX realCoordLift
      have h1 : ∀ r : Fin (Module.finrank ℚ K),
          (if h : r.1 < Module.finrank ℚ K then realCoordLiftSingle ω x ⟨r.1, h⟩
           else realCoordLiftSingle ω y ⟨r.1 - Module.finrank ℚ K, by omega⟩) *
            realPlaceEmb w (ω r : K) =
          realCoordLiftSingle ω x r * realPlaceEmb w (ω r : K) := by
        intro r
        rw [dif_pos r.2]
      simp_rw [h1]
      exact hSingle x
    · unfold realCoordY realCoordLift
      have h2 : ∀ r : Fin (Module.finrank ℚ K),
          (if h : Module.finrank ℚ K + r.1 < Module.finrank ℚ K
