theorem exists_auxiliary_twist_of_final_sign_prime (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S₄ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π₄ : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ₄ : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (p_last : Kˣ)
    (𝔭_last : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (hmul : IsLocalMulClosed K a₁ a₂ a₃)
    (hpre : IsPreAuxiliaryTwist K a₁ a₂ a₃ τ T S₄ π₄ κ₄ z)
    (hlast : IsFinalSignPrime K a₁ a₂ a₃ τ T S₄ κ₄ z p_last 𝔭_last) :
    ∃ (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.adicCompletion K)
      (κ : Kˣ) (z' : Fin 6 → Kˣ × Kˣ),
      IsAuxiliaryTwist K a₁ a₂ a₃ τ T S π κ z' :=
by
  classical
  let v₀ := 𝔭_last
  let ι := algebraMap K (v₀.adicCompletion K)
  have ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _⟩ := hstart
  rcases hpre with ⟨hS₄T, hπ₄, ⟨hκ₄_int, hκ₄_S₄, hκ₄_notS₄⟩,
    hz_sel₄, hz_val₄, hz_even₄, hspan₄, hz_even_sign, hz_odd_sign⟩
  rcases hlast with ⟨hv₀T, hv₀S₄, hp_int, _, hp_val_v₀, hp_val_ne,
    hsign0, hsign1, hsign2, hsign3, hsign4, hsign5, hz_sq_v₀, _⟩
  have h_two_unif :
      (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 2 = 1 ∧
      Valued.v (algebraMap K (v₀.adicCompletion K) (a₁ - a₂)) = 1 ∧
      Valued.v (algebraMap K (v₀.adicCompletion K) (a₁ - a₃)) = 1 ∧
      Valued.v (algebraMap K (v₀.adicCompletion K) (a₂ - a₃)) = 1 ∧
      ∃ π_a ε : v₀.adicCompletion K,
        IsLocalUnif v₀ π_a ∧
        IsLocalUnif v₀ (ε * π_a) ∧
        Valued.v ε = 1 ∧
        ¬ IsSquare ε ∧
        ∀ u : v₀.adicCompletion K, Valued.v u = 1 → (IsSquare (ε * u) ↔ ¬ IsSquare u) := by
    let A₁_int : NumberField.RingOfIntegers K := ⟨a₁, hint₁⟩
    let A₂_int : NumberField.RingOfIntegers K := ⟨a₂, hint₂⟩
    let A₃_int : NumberField.RingOfIntegers K := ⟨a₃, hint₃⟩
    have hval2_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 2 ≤ 1 := by
      have := v₀.valuation_le_one (K := K) (2 : NumberField.RingOfIntegers K)
      simpa using this
    have hval3_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 3 ≤ 1 := by
      have := v₀.valuation_le_one (K := K) (3 : NumberField.RingOfIntegers K)
      simpa using this
    have hval6_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) 6 ≤ 1 := by
      have := v₀.valuation_le_one (K := K) (6 : NumberField.RingOfIntegers K)
      simpa using this
    have hval12_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) (a₁ - a₂) ≤ 1 := by
      have := v₀.valuation_le_one (K := K) (A₁_int - A₂_int)
      simpa [A₁_int, A₂_int] using this
    have hval13_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) (a₁ - a₃) ≤ 1 := by
      have := v₀.valuation_le_one (K := K) (A₁_int - A₃_int)
      simpa [A₁_int, A₃_int] using this
    have hval23_le : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀) (a₂ - a₃) ≤ 1 := by
      have := v₀.valuation_le_one (K := K) (A₂_int - A₃_int)
      simpa [A₂_int, A₃_int] using this
    have hgood : (IsDedekindDomain.HeightOneSpectrum.valuation K v₀)
