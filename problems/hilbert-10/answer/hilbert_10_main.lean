    intro j g hpos
    let w := τ ⟨j.1, by omega⟩
    rw [h_coe_auxProd g, ← Finset.mul_prod_erase Finset.univ (fun i : Fin 6 => (p i : K) ^ (g i : ℕ)) (Finset.mem_univ j),
        map_mul, map_prod] at hpos
    have hrest_pos : 0 < ∏ i ∈ Finset.univ.erase j, realPlaceEmb w ((p i : K) ^ (g i : ℕ)) := by
      refine Finset.prod_pos (fun i hi => ?_)
      have hij : i ≠ j := Finset.ne_of_mem_erase hi
      have hnot_neg : ¬ (realPlaceEmb w (p i : K) < 0) :=
        mt (hp_sign1 i j).mp (Ne.symm hij)
      have hne0 : realPlaceEmb w (p i : K) ≠ 0 := by
        simpa using (realPlaceEmb w).injective.ne (p i).ne_zero
      have hpi_pos : 0 < realPlaceEmb w (p i : K) :=
        lt_of_le_of_ne (not_lt.mp hnot_neg) hne0.symm
      rw [map_pow]
      exact pow_pos hpi_pos (g i : ℕ)
    by_contra hgj
    have hgj1 : g j = 1 := by
      revert hgj
      generalize g j = m
      fin_cases m <;> decide
    rw [hgj1] at hpos
    have hpj_neg : realPlaceEmb w ((p j : K) ^ (1 : ℕ)) < 0 := by
      simpa using (hp_sign1 j j).mpr rfl
    have hprod_neg : realPlaceEmb w ((p j : K) ^ (1 : ℕ)) *
        (∏ i ∈ Finset.univ.erase j, realPlaceEmb w ((p i : K) ^ (g i : ℕ))) < 0 :=
      mul_neg_of_neg_of_pos hpj_neg hrest_pos
    exact lt_asymm hpos hprod_neg
  let partner : Fin 6 → Fin 6 := fun k =>
    if h : k.1 % 2 = 0 then ⟨k.1 + 1, by have := k.2; omega⟩ else ⟨k.1 - 1, by have := k.2; omega⟩
  have h_partner_ne : ∀ k : Fin 6, k ≠ partner k := by
    intro k
    revert k
    decide
  have h_partner_cond : ∀ k : Fin 6,
      (k.1 = 0 ∧ (partner k).1 = 1) ∨ (k.1 = 1 ∧ (partner k).1 = 0) ∨
      (k.1 = 2 ∧ (partner k).1 = 3) ∨ (k.1 = 3 ∧ (partner k).1 = 2) ∨
      (k.1 = 4 ∧ (partner k).1 = 5) ∨ (k.1 = 5 ∧ (partner k).1 = 4) := by
    intro k
    revert k
    decide
  have h_nonpartner_cond : ∀ k i : Fin 6, i ≠ k → i ≠ partner k →
      ¬ ((k.1 = 0 ∧ i.1 = 1) ∨ (k.1 = 1 ∧ i.1 = 0) ∨
         (k.1 = 2 ∧ i.1 = 3) ∨ (k.1 = 3 ∧ i.1 = 2) ∨
         (k.1 = 4 ∧ i.1 = 5) ∨ (k.1 = 5 ∧ i.1 = 4)) := by
    intro k i
    revert i k
    decide
  have h_partner_exp_zero : ∀ (k : Fin 6) (g : Fin 6 → Fin 2),
      g k = 0 →
      IsSquare (algebraMap K ((𝔭 k).adicCompletion K) (auxProd g : K)) →
      g (partner k) = 0 := by
    intro k g hgk hsq_all
    let k' := partner k
    let ι := algebraMap K ((𝔭 k).adicCompletion K)
    let U_rest : Kˣ := ∏ i ∈ Finset.univ.erase k', (p i) ^ (g i : ℕ)
    have hsplit : auxProd g = (p k') ^ (g k' : ℕ) * U_rest :=
      (Finset.mul_prod_erase Finset.univ (fun i : Fin 6 => (p i) ^ (g i : ℕ)) (Finset.mem_univ k')).symm
    have hsq_rest : IsSquare (ι (U_rest : K)) := by
      dsimp [U_rest]
      rw [Units.coe_prod, map_prod]
      refine Finset.prod_induction (fun i : Fin 6 => ι (((p i) ^ (g i : ℕ) : Kˣ) : K)) IsSquare
        (fun a b ha hb => ha.mul hb) IsSquare.one ?_
      intro i hi
      dsimp only
      have hik' : i ≠ k' := Finset.ne_of_mem_erase hi
      rw [Units.val_pow_eq_pow_val, map_pow]
      by_cases hik : i = k
      · subst hik
        rw [hgk]
        exact IsSquare.one
      · have hpi_sq : IsSquare (ι (p i : K)) :=
          (hrec.1 k i (Ne.symm hik)).mpr (h_nonpartner_cond k i hik hik')
        exact hpi_sq.pow (g i : ℕ)
    obtain ⟨r, hr⟩ := hsq_all
    obtain ⟨s, hs⟩ := hsq_rest
    have hs_ne : s ≠ 0 := by
      intro h0
      have hU0 : ι (U_rest : K) = 0 := by rw [hs, h0, mul_zero]
      have hU_ne : ι (U_rest : K) ≠ 0 := by simpa using ι.injective.ne U_rest.ne_zero
      exact hU_ne hU0
    have hsq_k' : IsSquare (ι (((p k') ^ (g k' : ℕ) : Kˣ) : K)) := by
      refine ⟨r / s, ?_⟩
      have hmul_eq : ι (((p k') ^ (g k' : ℕ) : Kˣ) : K) * (s * s) = r * r := by
        rw [← hs, ← map_mul, ← Units.val_mul, ← hsplit, hr]
      calc ι (((p k') ^ (g k' : ℕ) : Kˣ) : K)
        _ = (ι (((p k') ^ (g k' : ℕ) : Kˣ) : K) * s ^ 2) / s ^ 2 := by
            rw [mul_div_cancel_right₀ _ (pow_ne_zero 2 hs_ne)]
        _ = (r * r) / s ^ 2 := by rw [sq, hmul_eq]
        _ = (r / s) * (r / s) := by ring
    by_contra hgk'
    have hgk'1 : g k' = 1 := by
      revert hgk'
      generalize g k' = m
      fin_cases m <;> decide
    rw [hgk'1] at hsq_k'
    have hsq_pk' : IsSquare (ι (p k' : K)) := by simpa using hsq_k'
    have hnot_cond := (hrec.1 k k' (h_partner_ne k)).mp hsq_pk'
    exact hnot_cond (h_partner_cond k)
  have h_auxProd_eq_one : ∀ e f : Fin 6 → Fin 2,
      (∀ w : NumberField.InfinitePlace K,
        IsDescentClass (algebraMap K w.Completion a₁) (algebraMap K w.Completion a₂)
          (algebraMap K w.Completion a₃) (algebraMap K w.Completion (auxProd e : K))
          (algebraMap K w.Completion (auxProd f : K))) →
      (∀ k : Fin 6, RamLocal a₁ a₂ a₃ (𝔭 k) (π'₂ (𝔭 k)) (auxProd e) (auxProd f)) →
      auxProd e = 1 ∧ auxProd f = 1 := by
    intro e f h_inf h_ram
    rcases hstart with ⟨_, _, _, _, _, _, _, _, _, _, _,
      hτ0, hτ1, hτ2, hτ3, hτ4, hτ5, _, _, _, _, _, _, _⟩
    have hf0 : f 0 = 0 := h_exp_zero_of_real_pos 0 f
      (h_real_pos_right (τ 0) (auxProd e) (auxProd f) hτ0.1 (lt_trans hτ0.1 hτ0.2) (h_inf (τ 0).1))
    have he1 : e 1 = 0 := h_exp_zero_of_real_pos 1 e
      (h_real_pos_left (τ 1) (auxProd e) (auxProd f) hτ1.1 (lt_trans hτ1.1 hτ1.2) (h_inf (τ 1).1))
    have hf2 : f 2 = 0 := h_exp_zero_of_real_pos 2 f
      (h_real_pos_right (τ 2) (auxProd e) (auxProd f) (lt_trans hτ2.1 hτ2.2) hτ2.1 (h_inf (τ 2).1))
    have he3 : e 3 = 0 := h_exp_zero_of_real_pos 3 e
      (h_real_pos_left (τ 3) (auxProd e) (auxProd f) (lt_trans hτ3.1 hτ3.2) hτ3.1 (h_inf (τ 3).1))
    have hf4 : f 4 = 0 := h_exp_zero_of_real_pos 4 f
      (h_real_pos_right (τ 4) (auxProd e) (auxProd f) hτ4.1 (lt_trans hτ4.1 hτ4.2) (h_inf (τ 4).1))
    have he5 : e 5 = 0 := h_exp_zero_of_real_pos 5 e
      (h_real_pos_left (τ 5) (auxProd e) (auxProd f) hτ5.1 (lt_trans hτ5.1 hτ5.2) (h_inf (τ 5).1))
    have hf1 : f 1 = 0 := h_partner_exp_zero 0 f hf0
      ((hram_even_sq 0 (auxProd e) (auxProd f) (h_ram 0)).2 ((h_even_auxProd_𝔭_iff 0 f).mpr hf0))
    have hf3 : f 3 = 0 := h_partner_exp_zero 2 f hf2
      ((hram_even_sq 2 (auxProd e) (auxProd f) (h_ram 2)).2 ((h_even_auxProd_𝔭_iff 2 f).mpr hf2))
    have hf5 : f 5 = 0 := h_partner_exp_zero 4 f hf4
      ((hram_even_sq 4 (auxProd e) (auxProd f) (h_ram 4)).2 ((h_even_auxProd_𝔭_iff 4 f).mpr hf4))
    have he0 : e 0 = 0 := h_partner_exp_zero 1 e he1
      ((hram_even_sq 1 (auxProd e) (auxProd f) (h_ram 1)).1 ((h_even_auxProd_𝔭_iff 1 e).mpr he1))
    have he2 : e 2 = 0 := h_partner_exp_zero 3 e he3
      ((hram_even_sq 3 (auxProd e) (auxProd f) (h_ram 3)).1 ((h_even_auxProd_𝔭_iff 3 e).mpr he3))
    have he4 : e 4 = 0 := h_partner_exp_zero 5 e he5
      ((hram_even_sq 5 (auxProd e) (auxProd f) (h_ram 5)).1 ((h_even_auxProd_𝔭_iff 5 e).mpr he5))
    have he_all : ∀ i : Fin 6, e i = 0 := by
      intro i
      fin_cases i <;> assumption
    have hf_all : ∀ i : Fin 6, f i = 0 := by
      intro i
      fin_cases i <;> assumption
    refine ⟨?_, ?_⟩
    · dsimp [auxProd]
      exact Finset.prod_eq_one (fun i _ => by rw [he_all i]; simp)
    · dsimp [auxProd]
      exact Finset.prod_eq_one (fun i _ => by rw [hf_all i]; simp)
  classical
  let e : Fin 6 → Fin 2 := fun k => if EvenVal (𝔭 k) x₁ then 0 else 1
  let f : Fin 6 → Fin 2 := fun k => if EvenVal (𝔭 k) x₂ then 0 else 1
  let a : Kˣ := x₁ * auxProd e
  let b : Kˣ := x₂ * auxProd f
  have he_iff : ∀ k : Fin 6, e k = 0 ↔ EvenVal (𝔭 k) x₁ := by
    intro k
    dsimp [e]
    split_ifs with h <;> simp [h]
  have hf_iff : ∀ k : Fin 6, f k = 0 ↔ EvenVal (𝔭 k) x₂ := by
    intro k
    dsimp [f]
    split_ifs with h <;> simp [h]
  have ha_even_𝔭 : ∀ k : Fin 6, EvenVal (𝔭 k) a := by
    intro k
    dsimp [a]
    rw [h_even_mul (𝔭 k), h_even_auxProd_𝔭_iff k e, he_iff k]
  have hb_even_𝔭 : ∀ k : Fin 6, EvenVal (𝔭 k) b := by
    intro k
    dsimp [b]
    rw [h_even_mul (𝔭 k), h_even_auxProd_𝔭_iff k f, hf_iff k]
  have ha_even_outside : ∀ v, v ∉ T → v ∉ S₂ → EvenVal v a := by
    intro v hvT hvS₂
    by_cases h_ex : ∃ k : Fin 6, v = 𝔭 k
    · rcases h_ex with ⟨k, rfl⟩
      exact ha_even_𝔭 k
    · push_neg at h_ex
      have hvS'₂ : v ∉ S'₂ := fun hv => hvS₂ (hS'₂_to_S₂ v hv h_ex)
      have hx₁_ev : EvenVal v x₁ := (hx_even v hvT hvS'₂).1
      have he_ev : EvenVal v (auxProd e) := h_even_auxProd_of_ne v e h_ex
      exact (h_even_mul v x₁ (auxProd e)).mpr (iff_of_true hx₁_ev he_ev)
  have hb_even_outside : ∀ v, v ∉ T → v ∉ S₂ → EvenVal v b := by
    intro v hvT hvS₂
    by_cases h_ex : ∃ k : Fin 6, v = 𝔭 k
    · rcases h_ex with ⟨k, rfl⟩
      exact hb_even_𝔭 k
    · push_neg at h_ex
      have hvS'₂ : v ∉ S'₂ := fun hv => hvS₂ (hS'₂_to_S₂ v hv h_ex)
      have hx₂_ev : EvenVal v x₂ := (hx_even v hvT hvS'₂).2
      have hf_ev : EvenVal v (auxProd f) := h_even_auxProd_of_ne v f h_ex
      exact (h_even_mul v x₂ (auxProd f)).mpr (iff_of_true hx₂_ev hf_ev)
  have h_sq_auxProd_S₂ : ∀ v ∈ S₂, ∀ g : Fin 6 → Fin 2,
      IsSquare (algebraMap K (v.adicCompletion K) (auxProd g : K)) := by
    intro v hv g
    rw [h_coe_auxProd g, map_prod]
    refine Finset.prod_induction (fun i : Fin 6 => algebraMap K (v.adicCompletion K) ((p i : K) ^ (g i : ℕ)))
      IsSquare (fun x y hx hy => hx.mul hy) IsSquare.one ?_
    intro i _
    dsimp only
    rw [map_pow]
    exact (hp_sq_S₂ i v hv).pow (g i : ℕ)
  have hab_ram_S₂ : ∀ v ∈ S₂, RamLocal a₁ a₂ a₃ v (π₂ v) a b := by
    intro v hv
    have hx_v : RamLocal a₁ a₂ a₃ v (π₂ v) x₁ x₂ := by
      rw [← hπ'₂_eq_π₂ v hv]
      exact hx_ram v (hS₂_sub hv)
    have haux_v : RamLocal a₁ a₂ a₃ v (π₂ v) (auxProd e) (auxProd f) :=
      Or.inl ⟨h_sq_auxProd_S₂ v hv e, h_sq_auxProd_S₂ v hv f⟩
    exact hmul.2.2 v (π₂ v) x₁ x₂ (auxProd e) (auxProd f) (hS₂.1.2.1 v hv) hx_v haux_v
  have hab_not_one : ¬ (sqCl a = 1 ∧ sqCl b = 1) := by
    rintro ⟨ha1, hb1⟩
    have hx₁_eq : sqCl x₁ = sqCl (auxProd e) :=
      (h_sqCl_mul_eq_one_iff x₁ (auxProd e)).mp ha1
    have hx₂_eq : sqCl x₂ = sqCl (auxProd f) :=
      (h_sqCl_mul_eq_one_iff x₂ (auxProd f)).mp hb1
    have h_ef_inf : ∀ w : NumberField.InfinitePlace K,
        IsDescentClass (algebraMap K w.Completion a₁) (algebraMap K w.Completion a₂)
          (algebraMap K w.Completion a₃) (algebraMap K w.Completion (auxProd e : K))
          (algebraMap K w.Completion (auxProd f : K)) :=
      fun w => h_desc_inf_of_sqCl_eq w x₁ x₂ (auxProd e) (auxProd f) hx₁_eq hx₂_eq (hx_inf w)
    have h_ef_ram : ∀ k : Fin 6, RamLocal a₁ a₂ a₃ (𝔭 k) (π'₂ (𝔭 k)) (auxProd e) (auxProd f) :=
      fun k => h_ram_of_sqCl_eq (𝔭 k) (π'₂ (𝔭 k)) x₁ x₂ (auxProd e) (auxProd f)
        (hπ'₂_unif (𝔭 k) (h𝔭_mem_S'₂ k)) hx₁_eq hx₂_eq (hx_ram (𝔭 k) (h𝔭_mem_S'₂ k))
    obtain ⟨he1, hf1⟩ := h_auxProd_eq_one e f h_ef_inf h_ef_ram
    apply hne
    apply Prod.ext
    · rw [hx₁_eq, he1]
      exact (h_sqCl_eq_one_iff 1).mpr IsSquare.one
    · rw [hx₂_eq, hf1]
      exact (h_sqCl_eq_one_iff 1).mpr IsSquare.one
  have ha_ne_one : sqCl a ≠ 1 := by
    intro ha1
    have ha1' : sqCl a = sqCl 1 := ha1.trans ((h_sqCl_eq_one_iff 1).mpr IsSquare.one).symm
    have h1b_ram : ∀ v ∈ S₂, RamLocal a₁ a₂ a₃ v (π₂ v) 1 b :=
      fun v hv => h_ram_of_sqCl_eq v (π₂ v) a b 1 b (hS₂.1.2.1 v hv) ha1' rfl (hab_ram_S₂ v hv)
    have hb1 : sqCl b = 1 := hS₂.2.2.2 b h1b_ram hb_even_outside
    exact hab_not_one ⟨ha1, hb1⟩
  have hb_ne_one : sqCl b ≠ 1 := by
    intro hb1
    have hb1' : sqCl b = sqCl 1 := hb1.trans ((h_sqCl_eq_one_iff 1).mpr IsSquare.one).symm
    have ha1_ram : ∀ v ∈ S₂, RamLocal a₁ a₂ a₃ v (π₂ v) a 1 :=
      fun v hv => h_ram_of_sqCl_eq v (π₂ v) a b a 1 (hS₂.1.2.1 v hv) rfl hb1' (hab_ram_S₂ v hv)
    have ha1 : sqCl a = 1 := hS₂.2.2.1 a ha1_ram ha_even_outside
    exact hab_not_one ⟨ha1, hb1⟩
  have hab_mul_ne_one : sqCl (a * b) ≠ 1 := by
    intro hab1
    have hba : sqCl b = sqCl a := ((h_sqCl_mul_eq_one_iff a b).mp hab1).symm
    have haa_ram : ∀ v ∈ S₂, RamLocal a₁ a₂ a₃ v (π₂ v) a a :=
      fun v hv => h_ram_of_sqCl_eq v (π₂ v) a b a a (hS₂.1.2.1 v hv) rfl hba (hab_ram_S₂ v hv)
    have ha1 : sqCl a = 1 := hS₂.2.1 a haa_ram ha_even_outside
    exact ha_ne_one ha1
  refine ⟨?_, ?_, ?_⟩
  · intro c hsq
    rw [← h_coe_auxProd c, ← Units.val_mul] at hsq
    have hce : c = e := by
      ext k
      have hk_ev : EvenVal (𝔭 k) (x₁ * auxProd c) :=
        h_even_of_sq (𝔭 k) (x₁ * auxProd c) (hsq.map (algebraMap K ((𝔭 k).adicCompletion K)))
      rw [h_even_mul (𝔭 k), h_even_auxProd_𝔭_iff k c, ← he_iff k] at hk_ev
      revert hk_ev
      generalize c k = m₁
      generalize e k = m₂
      fin_cases m₁ <;> fin_cases m₂ <;> decide
    rw [hce] at hsq
    exact ha_ne_one ((h_sqCl_eq_one_iff a).mpr hsq)
  · intro c hsq
    rw [← h_coe_auxProd c, ← Units.val_mul] at hsq
    have hcf : c = f := by
      ext k
      have hk_ev : EvenVal (𝔭 k) (x₂ * auxProd c) :=
        h_even_of_sq (𝔭 k) (x₂ * auxProd c) (hsq.map (algebraMap K ((𝔭 k).adicCompletion K)))
      rw [h_even_mul (𝔭 k), h_even_auxProd_𝔭_iff k c, ← hf_iff k] at hk_ev
      revert hk_ev
      generalize c k = m₁
      generalize f k = m₂
      fin_cases m₁ <;> fin_cases m₂ <;> decide
    rw [hcf] at hsq
    exact hb_ne_one ((h_sqCl_eq_one_iff b).mpr hsq)
  · intro c hsq
    rw [← h_coe_auxProd c, ← Units.val_mul] at hsq
    have hefc_sq : sqCl (auxProd e * auxProd f * auxProd c) = 1 := by
      have hprod_eq : auxProd e * auxProd f * auxProd c =
          ∏ i : Fin 6, ((p i) ^ (e i : ℕ) * (p i) ^ (f i : ℕ) * (p i) ^ (c i : ℕ)) := by
        dsimp [auxProd]
        rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
      rw [hprod_eq]
      refine Finset.prod_induction
        (fun i : Fin 6 => (p i) ^ (e i : ℕ) * (p i) ^ (f i : ℕ) * (p i) ^ (c i : ℕ))
        (fun u : Kˣ => sqCl u = 1)
        (fun u v hu hv => by
          dsimp only at hu hv ⊢
          change sqCl u * sqCl v = 1
          rw [hu, hv, mul_one (1 : SqCl K)])
        ((h_sqCl_eq_one_iff 1).mpr IsSquare.one) ?_
      intro k _
      have hk_ev : EvenVal (𝔭 k) (x₁ * x₂ * auxProd c) :=
        h_even_of_sq (𝔭 k) (x₁ * x₂ * auxProd c) (hsq.map (algebraMap K ((𝔭 k).adicCompletion K)))
      rw [h_even_mul (𝔭 k), h_even_mul (𝔭 k), h_even_auxProd_𝔭_iff k c,
          ← he_iff k, ← hf_iff k] at hk_ev
      have h_factor_sq : ∃ s : Kˣ,
          (p k) ^ (e k : ℕ) * (p k) ^ (f k : ℕ) * (p k) ^ (c k : ℕ) = s ^ 2 := by
        revert hk_ev
        generalize e k = m₁
        generalize f k = m₂
        generalize c k = m₃
        fin_cases m₁ <;> fin_cases m₂ <;> fin_cases m₃
        · intro _; exact ⟨1, by simp⟩
        · intro h; exfalso; revert h; decide
        · intro h; exfalso; revert h; decide
        · intro _; exact ⟨p k, by simp [sq]⟩
        · intro h; exfalso; revert h; decide
        · intro _; exact ⟨p k, by simp [sq]⟩
        · intro _; exact ⟨p k, by simp [sq]⟩
        · intro h; exfalso; revert h; decide
      obtain ⟨s, hs⟩ := h_factor_sq
      dsimp only
      rw [hs]
      exact h_sqCl_sq s
    have hxc_sq : sqCl (x₁ * x₂ * auxProd c) = 1 :=
      (h_sqCl_eq_one_iff (x₁ * x₂ * auxProd c)).mpr hsq
    have hab_mul_eq : (a * b) * (x₁ * x₂ * auxProd c) =
        (auxProd e * auxProd f * auxProd c) * (x₁ * x₂) ^ 2 := by
      dsimp [a, b]
      ext
      simp only [Units.val_mul, Units.val_pow_eq_pow_val]
      ring
    apply hab_mul_ne_one
    calc sqCl (a * b)
      _ = sqCl (a * b) * 1 := (mul_one (sqCl (a * b))).symm
      _ = sqCl (a * b) * sqCl (x₁ * x₂ * auxProd c) := by rw [hxc_sq]
      _ = sqCl ((a * b) * (x₁ * x₂ * auxProd c)) := rfl
      _ = sqCl ((auxProd e * auxProd f * auxProd c) * (x₁ * x₂) ^ 2) := by rw [hab_mul_eq]
      _ = sqCl (auxProd e * auxProd f * auxProd c) * sqCl ((x₁ * x₂) ^ 2) := rfl
      _ = 1 * 1 := by rw [hefc_sq, h_sqCl_sq (x₁ * x₂)]
      _ = 1 := mul_one (1 : SqCl K)

theorem hasPrincipalAuxSquareExtension_of_chebotarev (K : Type u) [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (p : Fin 6 → Kˣ) :
    HasPrincipalAuxSquareExtension K T p :=
by
  intro S κ a b c hdisj hprin ha hb hc habc
  have h_galois :
      ∃ (L : Type u) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : IsGalois K L)
        (β : Fin 6 → L) (α_a α_b α_c : L) (σ₀ : L ≃ₐ[K] L),
        (∀ k : Fin 6, (β k) ^ 2 = algebraMap K L (p k : K) ∧ σ₀ (β k) = β k) ∧
        α_a ^ 2 = algebraMap K L (a : K) ∧
        α_b ^ 2 = algebraMap K L (b : K) ∧
        α_c ^ 2 = algebraMap K L (c : K) ∧
        σ₀ α_a = -α_a ∧
        σ₀ α_b = -α_b ∧
        σ₀ α_c = -α_c := by
    have h_s1 :
        ∃ (L : Type u) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : IsGalois K L)
          (y : Fin 6 → L) (y_a y_b y_c : L),
          (∀ k : Fin 6, (y k) ^ 2 = algebraMap K L (p k : K)) ∧
          y_a ^ 2 = algebraMap K L (a : K) ∧
          y_b ^ 2 = algebraMap K L (b : K) ∧
          y_c ^ 2 = algebraMap K L (c : K) ∧
          ∀ (E : Type u) [Field E] [Algebra K E]
            (r_p : Fin 6 → E) (r_a r_b r_c : E) (σ_E : E ≃ₐ[K] E) (_ι : E →ₐ[K] L),
            (∀ k : Fin 6, (r_p k) ^ 2 = algebraMap K E (p k : K) ∧ σ_E (r_p k) = r_p k) →
            r_a ^ 2 = algebraMap K E (a : K) →
            r_b ^ 2 = algebraMap K E (b : K) →
            r_c ^ 2 = algebraMap K E (c : K) →
            σ_E r_a = -r_a →
            σ_E r_b = -r_b →
            σ_E r_c = -r_c →
            ∃ (β : Fin 6 → L) (α_a α_b α_c : L) (σ₀ : L ≃ₐ[K] L),
              (∀ k : Fin 6, (β k) ^ 2 = algebraMap K L (p k : K) ∧ σ₀ (β k) = β k) ∧
              α_a ^ 2 = algebraMap K L (a : K) ∧
              α_b ^ 2 = algebraMap K L (b : K) ∧
              α_c ^ 2 = algebraMap K L (c : K) ∧
              σ₀ α_a = -α_a ∧
              σ₀ α_b = -α_b ∧
              σ₀ α_c = -α_c := by
      let qp : K[X] := ∏ k : Fin 6, (X ^ 2 - C (p k : K))
      let pa : K[X] := X ^ 2 - C (a : K)
      let pb : K[X] := X ^ 2 - C (b : K)
      let pc : K[X] := X ^ 2 - C (c : K)
      let f : K[X] := qp * pa * pb * pc
      let L := f.SplittingField
      have hGal : IsGalois K L := IsGalois.mk
      have hNF : NumberField L := @NumberField.mk L _ inferInstance (Module.Finite.trans K L)
      have h_root : ∀ (w : K), (X ^ 2 - C w) ∣ f → ∃ y : L, y ^ 2 = algebraMap K L w := by
        intro w h_dvd
        have hqp : qp ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun k _ =>
          Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (p k : K))
        have hpa : pa ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (a : K)
        have hpb : pb ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (b : K)
        have hpc : pc ≠ 0 := Polynomial.X_pow_sub_C_ne_zero (by decide : 0 < 2) (c : K)
        have hf0 : f ≠ 0 := mul_ne_zero (mul_ne_zero (mul_ne_zero hqp hpa) hpb) hpc
        have h_splits_f : (Polynomial.map (algebraMap K L) f).Splits :=
          Polynomial.SplittingField.splits f
        have h_map_f0 : Polynomial.map (algebraMap K L) f ≠ 0 :=
          Polynomial.map_ne_zero hf0
        have h_dvd_map : Polynomial.map (algebraMap K L) (X ^ 2 - C w) ∣
            Polynomial.map (algebraMap K L) f :=
          Polynomial.map_dvd (algebraMap K L) h_dvd
        have h_splits_w : (Polynomial.map (algebraMap K L) (X ^ 2 - C w)).Splits :=
          h_splits_f.of_dvd h_map_f0 h_dvd_map
        have h_map_eq : Polynomial.map (algebraMap K L) (X ^ 2 - C w) =
            X ^ 2 - C (algebraMap K L w) := by simp
        rw [h_map_eq] at h_splits_w
        have h_deg : (X ^ 2 - C (algebraMap K L w)).degree ≠ 0 := by
          rw [Polynomial.degree_X_pow_sub_C (by decide : 0 < 2)]
          decide
        obtain ⟨y, hy⟩ := h_splits_w.exists_eval_eq_zero h_deg
        simp only [eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero] at hy
        exact ⟨y, hy⟩
      have hy_ex : ∀ k : Fin 6, ∃ y : L, y ^ 2 = algebraMap K L (p k : K) := by
        intro k
        apply h_root (p k : K)
        have hdvd_qp : (X ^ 2 - C (p k : K)) ∣ qp :=
          Finset.dvd_prod_of_mem _ (Finset.mem_univ k)
        exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left hdvd_qp pa) pb) pc
      choose y hy using hy_ex
      obtain ⟨y_a, hy_a⟩ := h_root (a : K)
        (dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_left pa qp) pb) pc)
      obtain ⟨y_b, hy_b⟩ := h_root (b : K)
        (dvd_mul_of_dvd_left (dvd_mul_left pb (qp * pa)) pc)
      obtain ⟨y_c, hy_c⟩ := h_root (c : K)
        (dvd_mul_left pc (qp * pa * pb))
      refine ⟨L, inferInstance, hNF, inferInstance, hGal, y, y_a, y_b, y_c, hy, hy_a, hy_b, hy_c, ?_⟩
      intro E hFieldE hAlgKE r_p r_a r_b r_c σ_E ι hrp hra hrb hrc hσa hσb hσc
      letI : Algebra E L := ι.toRingHom.toAlgebra
      have h_tower_eq : ∀ x : K, (algebraMap E L) (algebraMap K E x) = algebraMap K L x :=
        fun x => ι.commutes x
      haveI : IsScalarTower K E L := IsScalarTower.of_algebraMap_eq (fun x => (h_tower_eq x).symm)
      let σ₀ : L ≃ₐ[K] L := AlgEquiv.liftNormal σ_E L
      refine ⟨fun k => algebraMap E L (r_p k),
        algebraMap E L r_a, algebraMap E L r_b, algebraMap E L r_c, σ₀,
        ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro k
        refine ⟨?_, ?_⟩
        · rw [← map_pow, (hrp k).1, h_tower_eq]
        · rw [AlgEquiv.liftNormal_commutes, (hrp k).2]
      · rw [← map_pow, hra, h_tower_eq]
      · rw [← map_pow, hrb, h_tower_eq]
      · rw [← map_pow, hrc, h_tower_eq]
      · rw [AlgEquiv.liftNormal_commutes, hσa, map_neg]
      · rw [AlgEquiv.liftNormal_commutes, hσb, map_neg]
      · rw [AlgEquiv.liftNormal_commutes, hσc, map_neg]
    obtain ⟨L, hFieldL, hNFL, hAlgKL, hGalKL, y, y_a, y_b, y_c, hy, hy_a, hy_b, hy_c, h_lift⟩ := h_s1
    letI : Field L := hFieldL
    letI : NumberField L := hNFL
    letI : Algebra K L := hAlgKL
    letI : IsGalois K L := hGalKL
    have h_pos_step :
        ∀ (E : Type u) [Field E] [CharZero E] [Algebra K E]
          (_ι : E →ₐ[K] L) (d₀ : K) (y₀ : L),
          y₀ ^ 2 = algebraMap K L d₀ →
          ∃ (E' : Type u) (_ : Field E') (_ : CharZero E') (_ : Algebra K E')
            (j : E →+* E') (ω : E') (_ι' : E' →ₐ[K] L),
            (∀ x : K, j (algebraMap K E x) = algebraMap K E' x) ∧
            ω ^ 2 = algebraMap K E' d₀ ∧
            (∀ x : K, IsSquare (algebraMap K E' x) →
              ∃ e : Fin 2, IsSquare (algebraMap K E (x * d₀ ^ (e : ℕ)))) := by
      intro E hFieldE hCharE hAlgKE ι d₀ y₀ hy₀
      by_cases hd : IsSquare (algebraMap K E d₀)
      · rcases hd with ⟨ω₀, hω₀⟩
        refine ⟨E, hFieldE, hCharE, hAlgKE, RingHom.id E, ω₀, ι,
          fun _ => rfl, by rw [sq, ← hω₀], ?_⟩
        intro x hx
        refine ⟨0, ?_⟩
        simpa using hx
      · let d : E := algebraMap K E d₀
        haveI : Fact (∀ r : E, r ^ 2 ≠ d + 0 * r) :=
          ⟨fun r hr => hd ⟨r, by linear_combination -hr⟩⟩
        haveI : CharZero (QuadraticAlgebra E d 0) :=
          charZero_of_injective_algebraMap (algebraMap E (QuadraticAlgebra E d 0)).injective
        let ω : QuadraticAlgebra E d 0 := ⟨0, 1⟩
        letI : Algebra E L := ι.toRingHom.toAlgebra
        haveI : IsScalarTower K E L :=
          IsScalarTower.of_algebraMap_eq (fun x => (ι.commutes x).symm)
        have hy_quad : y₀ * y₀ = d • (1 : L) + (0 : E) • y₀ := by
          have h1 : y₀ * y₀ = algebraMap K L d₀ := by rw [← sq, hy₀]
          have h2 : d • (1 : L) = algebraMap K L d₀ := by
            rw [Algebra.smul_def, mul_one]
            exact ι.commutes d₀
          rw [h1, h2, zero_smul, add_zero]
        let ι_E : QuadraticAlgebra E d 0 →ₐ[E] L := QuadraticAlgebra.lift ⟨y₀, hy_quad⟩
        let ι' : QuadraticAlgebra E d 0 →ₐ[K] L := ι_E.restrictScalars K
        refine ⟨QuadraticAlgebra E d 0, inferInstance, inferInstance, inferInstance,
          algebraMap E (QuadraticAlgebra E d 0), ω, ι', fun _ => rfl, ?_, ?_⟩
        · rw [sq]
          ext
          · change (0 : E) * 0 + d * 1 * 1 = d
            ring
          · change (0 : E) * 1 + 1 * 0 + 0 * 1 * 1 = 0
            ring
        · intro x ⟨z, hz⟩
          have h_re : z.re * z.re + d * z.im * z.im = algebraMap K E x := by
            have := congrArg QuadraticAlgebra.re hz.symm
            simpa [QuadraticAlgebra.re_mul] using this
          have h_im : z.re * z.im + z.im * z.re + 0 * z.im * z.im = 0 := by
            have := congrArg QuadraticAlgebra.im hz.symm
            simpa [QuadraticAlgebra.im_mul] using this
          have h_prod : (2 : E) * z.re * z.im = 0 := by linear_combination h_im
          have h2 : (2 : E) ≠ 0 := two_ne_zero
          rcases mul_eq_zero.mp h_prod with h_2re | h_im0
          · have h_re0 : z.re = 0 := (mul_eq_zero.mp h_2re).resolve_left h2
            refine ⟨1, d * z.im, ?_⟩
            change algebraMap K E (x * d₀ ^ 1) = (d * z.im) * (d * z.im)
            rw [pow_one, map_mul]
            change algebraMap K E x * d = (d * z.im) * (d * z.im)
            linear_combination -d * h_re + d * z.re * h_re0
          · refine ⟨0, z.re, ?_⟩
            change algebraMap K E (x * d₀ ^ 0) = z.re * z.re
            rw [pow_zero, mul_one]
            linear_combination -h_re + d * z.im * h_im0
    have h_pos_tower :
        ∀ (n : ℕ) (v : Fin n → K) (yv : Fin n → L),
          (∀ i : Fin n, (yv i) ^ 2 = algebraMap K L (v i)) →
          ∃ (F : Type u) (_ : Field F) (_ : CharZero F) (_ : Algebra K F)
            (_ι_F : F →ₐ[K] L) (β_F : Fin n → F),
            (∀ i : Fin n, (β_F i) ^ 2 = algebraMap K F (v i)) ∧
            (∀ x : K, IsSquare (algebraMap K F x) →
              ∃ c : Fin n → Fin 2, IsSquare (x * ∏ i : Fin n, (v i) ^ (c i : ℕ))) := by
      intro n
      induction n with
      | zero =>
        intro v yv _
        refine ⟨K, inferInstance, inferInstance, inferInstance, Algebra.ofId K L,
          Fin.elim0, fun i => Fin.elim0 i, ?_⟩
        intro x hx
        refine ⟨Fin.elim0, ?_⟩
        simpa using hx
      | succ n ih =>
        intro v yv hyv
        obtain ⟨E, hFieldE, hCharE, hAlgKE, ι_E, β_E, hβ_E, hdesc_E⟩ :=
          ih (fun i => v i.castSucc) (fun i => yv i.castSucc) (fun i => hyv i.castSucc)
        letI : Field E := hFieldE
        letI : CharZero E := hCharE
        letI : Algebra K E := hAlgKE
        obtain ⟨E', hFieldE', hCharE', hAlgKE', j, ω, ι', hj, hω, hdesc'⟩ :=
          h_pos_step E ι_E (v (Fin.last n)) (yv (Fin.last n)) (hyv (Fin.last n))
        letI : Field E' := hFieldE'
        letI : CharZero E' := hCharE'
        letI : Algebra K E' := hAlgKE'
        refine ⟨E', hFieldE', hCharE', hAlgKE', ι', Fin.snoc (fun i => j (β_E i)) ω, ?_, ?_⟩
        · intro i
          refine Fin.lastCases ?_ ?_ i
          · simpa [Fin.snoc_last] using hω
          · intro i₀
            simp only [Fin.snoc_castSucc]
            rw [← map_pow, hβ_E i₀, hj]
        · intro x hx
          obtain ⟨e_last, he_last⟩ := hdesc' x hx
          obtain ⟨c_init, hc_init⟩ := hdesc_E (x * (v (Fin.last n)) ^ (e_last : ℕ)) he_last
          refine ⟨Fin.snoc c_init e_last, ?_⟩
          rw [Fin.prod_univ_castSucc]
          simp only [Fin.snoc_castSucc, Fin.snoc_last]
          rcases hc_init with ⟨r, hr⟩
          refine ⟨r, ?_⟩
          linear_combination hr
    obtain ⟨F, hFieldF, hCharF, hAlgKF, ι_F, β_F, hβ_F, hdesc_F⟩ :=
      h_pos_tower 6 (fun k => (p k : K)) y hy
    letI : Field F := hFieldF
    letI : CharZero F := hCharF
    letI : Algebra K F := hAlgKF
    have h_not_sq_F : ∀ u : Kˣ, NotInAuxSpan K p u → ¬ IsSquare (algebraMap K F (u : K)) := by
      intro u hu hsq
      obtain ⟨c_vec, hc_sq⟩ := hdesc_F (u : K) hsq
      exact hu c_vec hc_sq
    have ha_F : ¬ IsSquare (algebraMap K F (a : K)) := h_not_sq_F a ha
    have hb_F : ¬ IsSquare (algebraMap K F (b : K)) := h_not_sq_F b hb
    have hc_F : ¬ IsSquare (algebraMap K F (c : K)) := h_not_sq_F c hc
    have habc_F : ¬ IsSquare (algebraMap K F ((a * b * c : Kˣ) : K)) := h_not_sq_F (a * b * c) habc
    have h_s2 :
        ∀ (E : Type u) [Field E] [CharZero E] [Algebra K E]
          (σ : E ≃ₐ[K] E) (_ι : E →ₐ[K] L)
          (d₀ : K), ¬ IsSquare (algebraMap K E d₀) →
          ∀ (y₀ : L), y₀ ^ 2 = algebraMap K L d₀ →
          ∃ (E' : Type u) (_ : Field E') (_ : CharZero E')
            (_ : Algebra K E') (_ : Algebra E E') (_ : IsScalarTower K E E')
            (ω : E') (σ' : E' ≃ₐ[K] E') (_ι' : E' →ₐ[K] L),
            ω ^ 2 = algebraMap K E' d₀ ∧
            σ' ω = -ω ∧
            (∀ u : E, σ' (algebraMap E E' u) = algebraMap E E' (σ u)) ∧
            (∀ x : E, ∀ z : E', z ^ 2 = algebraMap E E' x →
              (∃ u : E, u ^ 2 = x ∧ z = algebraMap E E' u) ∨
              (∃ v : E, algebraMap K E d₀ * v ^ 2 = x ∧ z = algebraMap E E' v * ω)) := by
      intro E hFieldE hCharE hAlgKE σ ι d₀ hd y₀ hy₀
      let d : E := algebraMap K E d₀
      haveI : Fact (∀ r : E, r ^ 2 ≠ d + 0 * r) :=
        ⟨fun r hr => hd ⟨r, by linear_combination -hr⟩⟩
      haveI : CharZero (QuadraticAlgebra E d 0) :=
        charZero_of_injective_algebraMap (algebraMap E (QuadraticAlgebra E d 0)).injective
      let ω : QuadraticAlgebra E d 0 := ⟨0, 1⟩
      have hσd : σ d = d := σ.commutes d₀
      let σ' : QuadraticAlgebra E d 0 ≃ₐ[K] QuadraticAlgebra E d 0 :=
        { toFun := fun z => ⟨σ z.re, -σ z.im⟩
          invFun := fun z => ⟨σ.symm z.re, -σ.symm z.im⟩
          left_inv := fun z => by ext <;> simp
          right_inv := fun z => by ext <;> simp
          map_mul' := fun z₁ z₂ => by
            ext
            · change σ (z₁.re * z₂.re + d * z₁.im * z₂.im) =
                σ z₁.re * σ z₂.re + d * (-σ z₁.im) * (-σ z₂.im)
              simp only [map_add, map_mul, hσd]
              ring
            · change -σ (z₁.re * z₂.im + z₁.im * z₂.re + 0 * z₁.im * z₂.im) =
                σ z₁.re * (-σ z₂.im) + (-σ z₁.im) * σ z₂.re + 0 * (-σ z₁.im) * (-σ z₂.im)
              simp only [map_add, map_mul, map_zero]
              ring
          map_add' := fun z₁ z₂ => by
            ext
            · exact map_add σ z₁.re z₂.re
            · change -σ (z₁.im + z₂.im) = -σ z₁.im + -σ z₂.im
              rw [map_add, neg_add]
          commutes' := fun k => by
            ext
            · exact σ.commutes k
            · change -σ (0 : E) = 0
              simp }
      letI : Algebra E L := ι.toRingHom.toAlgebra
      haveI : IsScalarTower K E L :=
        IsScalarTower.of_algebraMap_eq (fun x => (ι.commutes x).symm)
      have hy_quad : y₀ * y₀ = d • (1 : L) + (0 : E) • y₀ := by
        have h1 : y₀ * y₀ = algebraMap K L d₀ := by rw [← sq, hy₀]
        have h2 : d • (1 : L) = algebraMap K L d₀ := by
          rw [Algebra.smul_def, mul_one]
          exact ι.commutes d₀
        rw [h1, h2, zero_smul, add_zero]
      let ι_E : QuadraticAlgebra E d 0 →ₐ[E] L := QuadraticAlgebra.lift ⟨y₀, hy_quad⟩
      let ι' : QuadraticAlgebra E d 0 →ₐ[K] L := ι_E.restrictScalars K
      refine ⟨QuadraticAlgebra E d 0, inferInstance, inferInstance, inferInstance,
        inferInstance, inferInstance, ω, σ', ι', ?_, ?_, ?_, ?_⟩
      · rw [sq]
        ext
        · change (0 : E) * 0 + d * 1 * 1 = d
          ring
        · change (0 : E) * 1 + 1 * 0 + 0 * 1 * 1 = 0
          ring
      · ext
        · change σ 0 = -(0 : E)
          simp
        · change -σ 1 = -(1 : E)
          simp
      · intro u
        ext
        · rfl
        · change -σ 0 = 0
          simp
      · intro x z hz
        have h_re : z.re * z.re + d * z.im * z.im = x := by
          have := congrArg QuadraticAlgebra.re hz
          simpa [sq, QuadraticAlgebra.re_mul] using this
        have h_im : z.re * z.im + z.im * z.re + 0 * z.im * z.im = 0 := by
          have := congrArg QuadraticAlgebra.im hz
          simpa [sq, QuadraticAlgebra.im_mul] using this
        have h_prod : (2 : E) * z.re * z.im = 0 := by linear_combination h_im
        have h2 : (2 : E) ≠ 0 := two_ne_zero
        rcases mul_eq_zero.mp h_prod with h_2re | h_im0
        · have h_re0 : z.re = 0 := (mul_eq_zero.mp h_2re).resolve_left h2
          right
          refine ⟨z.im, ?_, ?_⟩
          · change d * z.im ^ 2 = x
            linear_combination h_re - z.re * h_re0
          · ext
            · change z.re = z.im * 0 + d * 0 * 1
