      ∃ z : Kˣ, sqCl z = a ∧ EvenVal v₁ z
    have hP_iff : ∀ z : Kˣ, P (sqCl z) ↔ IsSquare (algebraMap K (v₁.adicCompletion K) (z : K)) :=
      fun z => ⟨fun ⟨y, hy, hsq⟩ => (hsqCl_sq_iff y z hy).mp hsq, fun hsq => ⟨z, rfl, hsq⟩⟩
    have hE_iff : ∀ z : Kˣ, E (sqCl z) ↔ EvenVal v₁ z :=
