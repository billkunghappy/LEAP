    have h_inf_prod : (∏ w : NumberField.InfinitePlace K, hilbInf w (u : K) (p_last : K)) = 1 := by
      rw [← Finset.prod_subset (Finset.subset_univ (Finset.univ.map ψ)) h_inf_outside,
