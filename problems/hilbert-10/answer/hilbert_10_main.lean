    rw [hD₀_coe]
    have h6 : (6 : K) ≠ 0 := by norm_num
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero h6 (sub_ne_zero.mpr h₁₂)) (sub_ne_zero.mpr h₁₃))
      (sub_ne_zero.mpr h₂₃)
  have hD₀_ne : D₀ ≠ 0 := by
    intro h
    apply hD₀K_ne
    simp [h]
  have hΔ₀_coe : (Δ₀ : K) =
      16 * ((a₁ : K) - (a₂ : K)) ^ 2 * ((a₁ : K) - (a₃ : K)) ^ 2 * ((a₂ : K) - (a₃ : K)) ^ 2 := by
    change ((16 * (a₁ - a₂) ^ 2 * (a₁ - a₃) ^ 2 * (a₂ - a₃) ^ 2 :
