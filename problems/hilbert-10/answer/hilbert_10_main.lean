    have hle : 𝔮₄.asIdeal ≤ 𝔮₁.asIdeal := by
      rw [← h𝔮₄, Ideal.span_singleton_le_iff_mem]
      exact hq3_in
    have heq_id : 𝔮₄.asIdeal = 𝔮₁.asIdeal := 𝔮₄.isMaximal.eq_of_le 𝔮₁.isPrime.ne_top hle
    apply h_not_coinc0
    rw [Finset.mem_filter]
    refine ⟨hz_box, ?_, hq3_ne_bot⟩
    rw [h𝔮₁, h𝔮₄, heq_id]
  have h13 : 𝔮₁ ≠ 𝔮₃ := by
    intro heq
    have hq0_in : affEval (c₀ 0) (c 0) z_lat ∈ 𝔮₁.asIdeal := by
      rw [← h𝔮₁]; exact Ideal.mem_span_singleton_self _
    have hq2_in : affEval (c₀ 2) (c 2) z_lat ∈ 𝔮₁.asIdeal := by
      rw [heq, ← h𝔮₃]; exact Ideal.mem_span_singleton_self _
    have hdiff_eq : affEval (c₀ 0) (c 0) z_lat - affEval (c₀ 2) (c 2) z_lat =
        (a₁_int - a₃_int) * μ * affEval (c₀ 3) (c 3) z_lat := by
      have h0 := (haff z_lat).1
      have h2 := (haff z_lat).2.2.1
      have h3 := (haff z_lat).2.2.2
      change affEval (c₀ 0) (c 0) z_lat = _ at h0
      change affEval (c₀ 2) (c 2) z_lat = _ at h2
      change affEval (c₀ 3) (c 3) z_lat = _ at h3
      rw [h0, h2, h3]
      ring
    have hprod_in : (a₁_int - a₃_int) * μ * affEval (c₀ 3) (c 3) z_lat ∈ 𝔮₁.asIdeal := by
      rw [← hdiff_eq]
      exact Ideal.sub_mem _ hq0_in hq2_in
    have ha13_not : a₁_int - a₃_int ∉ 𝔮₁.asIdeal := by
      intro ha_in
      exact hdiff 𝔮₁ hμ_not_q1 (Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ ha_in))
    have hq3_in : affEval (c₀ 3) (c 3) z_lat ∈ 𝔮₁.asIdeal := by
      rcases 𝔮₁.isPrime.mem_or_mem hprod_in with h_left | hq3_in
      · rcases 𝔮₁.isPrime.mem_or_mem h_left with ha_in | hμ_in
        · exact False.elim (ha13_not ha_in)
        · exact False.elim (hμ_not_q1 hμ_in)
      · exact hq3_in
    have hle : 𝔮₄.asIdeal ≤ 𝔮₁.asIdeal := by
      rw [← h𝔮₄, Ideal.span_singleton_le_iff_mem]
      exact hq3_in
    have heq_id : 𝔮₄.asIdeal = 𝔮₁.asIdeal := 𝔮₄.isMaximal.eq_of_le 𝔮₁.isPrime.ne_top hle
    apply h_not_coinc0
    rw [Finset.mem_filter]
    refine ⟨hz_box, ?_, hq3_ne_bot⟩
    rw [h𝔮₁, h𝔮₄, heq_id]
  have h23 : 𝔮₂ ≠ 𝔮₃ := by
    intro heq
    have hq1_in : affEval (c₀ 1) (c 1) z_lat ∈ 𝔮₂.asIdeal := by
      rw [← h𝔮₂]; exact Ideal.mem_span_singleton_self _
    have hq2_in : affEval (c₀ 2) (c 2) z_lat ∈ 𝔮₂.asIdeal := by
      rw [heq, ← h𝔮₃]; exact Ideal.mem_span_singleton_self _
    have hdiff_eq : affEval (c₀ 1) (c 1) z_lat - affEval (c₀ 2) (c 2) z_lat =
        (a₂_int - a₃_int) * μ * affEval (c₀ 3) (c 3) z_lat := by
      have h1 := (haff z_lat).2.1
      have h2 := (haff z_lat).2.2.1
      have h3 := (haff z_lat).2.2.2
      change affEval (c₀ 1) (c 1) z_lat = _ at h1
      change affEval (c₀ 2) (c 2) z_lat = _ at h2
      change affEval (c₀ 3) (c 3) z_lat = _ at h3
      rw [h1, h2, h3]
      ring
    have hprod_in : (a₂_int - a₃_int) * μ * affEval (c₀ 3) (c 3) z_lat ∈ 𝔮₂.asIdeal := by
      rw [← hdiff_eq]
      exact Ideal.sub_mem _ hq1_in hq2_in
    have ha23_not : a₂_int - a₃_int ∉ 𝔮₂.asIdeal := by
      intro ha_in
      exact hdiff 𝔮₂ hμ_not_q2 (Ideal.mul_mem_left _ _ ha_in)
    have hq3_in : affEval (c₀ 3) (c 3) z_lat ∈ 𝔮₂.asIdeal := by
      rcases 𝔮₂.isPrime.mem_or_mem hprod_in with h_left | hq3_in
      · rcases 𝔮₂.isPrime.mem_or_mem h_left with ha_in | hμ_in
        · exact False.elim (ha23_not ha_in)
        · exact False.elim (hμ_not_q2 hμ_in)
      · exact hq3_in
    have hle : 𝔮₄.asIdeal ≤ 𝔮₂.asIdeal := by
      rw [← h𝔮₄, Ideal.span_singleton_le_iff_mem]
      exact hq3_in
    have heq_id : 𝔮₄.asIdeal = 𝔮₂.asIdeal := 𝔮₄.isMaximal.eq_of_le 𝔮₂.isPrime.ne_top hle
    apply h_not_coinc1
    rw [Finset.mem_filter]
    refine ⟨hz_box, ?_, hq3_ne_bot⟩
    rw [h𝔮₂, h𝔮₄, heq_id]
  exact ⟨z_lat, 𝔮₁, 𝔮₂, 𝔮₃, 𝔮₄, hz_cone, h𝔮₁, h𝔮₂, h𝔮₃, h𝔮₄, h12, h13, h14, h23, h24, h34⟩

theorem exists_prime_quadruple_of_cone_volume (K : Type u) [Field K] [NumberField K]
    (hreal : 32 ≤ NumberField.InfinitePlace.nrRealPlaces K)
    (C : ℝ) (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (hω : IsNormLengthCompatible C ω)
    (a₁_int a₂_int a₃_int μ l : NumberField.RingOfIntegers K)
    (hμ : μ ≠ 0)
    (hl : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      μ ∈ v.asIdeal → l ∉ v.asIdeal)
    (hdiff : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      μ ∉ v.asIdeal →
        (a₁_int - a₂_int) * (a₁_int - a₃_int) * (a₂_int - a₃_int) ∉ v.asIdeal)
    (haff : ∀ z : Fin (2 * Module.finrank ℚ K) → ℤ,
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 0) (suitC ω a₁_int a₂_int a₃_int μ 0) z =
        1 + μ * kaiCoordX ω z + a₁_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 1) (suitC ω a₁_int a₂_int a₃_int μ 1) z =
        1 + μ * kaiCoordX ω z + a₂_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 2) (suitC ω a₁_int a₂_int a₃_int μ 2) z =
        1 + μ * kaiCoordX ω z + a₃_int * μ * (μ * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int μ l 3) (suitC ω a₁_int a₂_int a₃_int μ 3) z =
        μ * kaiCoordY ω z + l)
    (hcok : ∀ i j : Fin 4, i ≠ j →
      Finite (NumberField.RingOfIntegers K ⧸
        Submodule.map (homMap (suitC ω a₁_int a₂_int a₃_int μ i))
          (LinearMap.ker (homMap (suitC ω a₁_int a₂_int a₃_int μ j)))))
    (hloc : KaiLocalSolvable (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ))
    (Ω₀ : Set (Fin (2 * Module.finrank ℚ K) → ℝ))
    (hΩ_meas : ∀ N : ℕ,
      MeasurableSet (Ω₀ ∩ realBox (2 * Module.finrank ℚ K) (N : ℝ)) ∧
      Convex ℝ (Ω₀ ∩ realBox (2 * Module.finrank ℚ K) (N : ℝ)) ∧
      Ω₀ ∩ realBox (2 * Module.finrank ℚ K) (N : ℝ) ⊆ realBox (2 * Module.finrank ℚ K) (N : ℝ))
    (C_vol : ℝ) (hC_vol : 0 < C_vol) (N₀ : ℕ)
    (hΩ_vol : ∀ N : ℕ, N₀ ≤ N →
      C_vol * (N : ℝ) ^ (2 * Module.finrank ℚ K) ≤
        (MeasureTheory.volume (Ω₀ ∩ realBox (2 * Module.finrank ℚ K) (N : ℝ))).toReal) :
    ∃ (z_lat : Fin (2 * Module.finrank ℚ K) → ℤ)
      (𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsPrimeQuadrupleInCone
        (suitC0 a₁_int a₂_int a₃_int μ l) (suitC ω a₁_int a₂_int a₃_int μ)
        Ω₀ z_lat 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ :=
by
  open scoped Classical in
  let n := Module.finrank ℚ K
  have hn_real : NumberField.InfinitePlace.nrRealPlaces K ≤ n := by
    have h1 := NumberField.InfinitePlace.card_real_embeddings K
    have h2 := NumberField.Embeddings.card K ℂ
    have h3 := Fintype.card_subtype_le (fun φ : K →+* ℂ => NumberField.ComplexEmbedding.IsReal φ)
    omega
  have hn32 : 32 ≤ n := le_trans hreal hn_real
  have hd : 1 ≤ 2 * n := by omega
  let c₀ := suitC0 a₁_int a₂_int a₃_int μ l
  let c := suitC ω a₁_int a₂_int a₃_int μ
  obtain ⟨c_main, N₁, hc_main, hN₁, hkai_lb⟩ :=
    kaiSum_lower_bound_of_cone_volume K (2 * n) hd C ω hω c₀ c hcok hloc Ω₀ hΩ_meas C_vol hC_vol N₀ hΩ_vol
  obtain ⟨C_gen, hC_gen, hgen⟩ := card_generators_of_canNorm_le K
  obtain ⟨h_vm_nonneg, B₁, hB₁, hbounds⟩ :=
    affEval_norm_and_vonMangoldtO_bounds K (2 * n) C ω hω c₀ c
  let C_bad : ℕ := 8 * n ^ 6 * C_gen * B₁ ^ (n - 1) * 3 ^ n
  let N : ℕ := max N₁ (⌊(C_bad : ℝ) / c_main⌋₊ + 1)
  have hN₁_le : N₁ ≤ N := le_max_left _ _
  have hN : 1 ≤ N := le_trans hN₁ hN₁_le
  have hN_gt : ⌊(C_bad : ℝ) / c_main⌋₊ + 1 ≤ N := le_max_right _ _
  have hC_bad_lt : (C_bad : ℝ) < c_main * (N : ℝ) := by
    have hdiv : (C_bad : ℝ) / c_main < (N : ℝ) := by
      calc (C_bad : ℝ) / c_main
        _ < (⌊(C_bad : ℝ) / c_main⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one _
        _ = ((⌊(C_bad : ℝ) / c_main⌋₊ + 1 : ℕ) : ℝ) := by push_cast; ring
        _ ≤ (N : ℝ) := Nat.cast_le.mpr hN_gt
    have hmul := (div_lt_iff₀ hc_main).mp hdiv
    linarith
  let M : ℕ := B₁ * N
  have hM : 1 ≤ M := by
    have : 1 * 1 ≤ B₁ * N := Nat.mul_le_mul (by omega) hN
    omega
  let M_pp : ℕ := n ^ 2 * M ^ (n - 6)
  let M_gen : ℕ := C_gen * M
  let M_wt : ℕ := n * M
  have h_wt : ∀ z ∈ intBox (2 * n) N, ∀ i : Fin 4,
      0 ≤ vonMangoldtO (affEval (c₀ i) (c i) z) ∧
      vonMangoldtO (affEval (c₀ i) (c i) z) ≤ (M_wt : ℝ) := by
    intro z hz i
    exact ⟨h_vm_nonneg _, (hbounds N hN z hz i).2.2⟩
  have h_pp : ∀ i : Fin 4,
      ∀ ℐ : Finset (Ideal (NumberField.RingOfIntegers K)),
        (∀ I ∈ ℐ, (∃ z ∈ intBox (2 * n) N,
            Ideal.span {affEval (c₀ i) (c i) z} = I) ∧
          ∃ (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
            2 ≤ m ∧ I = 𝔭.asIdeal ^ m) →
        ℐ.card ≤ M_pp := by
    intro i ℐ hℐ
    apply card_primePowerIdeals_le K hreal M hM ℐ
    intro I hI
    obtain ⟨⟨z, hz, rfl⟩, hpow⟩ := hℐ I hI
    exact ⟨(hbounds N hN z hz i).2.1, hpow⟩
  have h_gen : ∀ i : Fin 4, ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ ⊥ →
      ∀ F : Finset (NumberField.RingOfIntegers K),
        (∀ α ∈ F, (∃ z ∈ intBox (2 * n) N,
            affEval (c₀ i) (c i) z = α) ∧
          Ideal.span {α} = I) →
        F.card ≤ M_gen := by
    intro i I hI F hF
    apply hgen M hM I hI F
    intro α hα
    obtain ⟨⟨z, hz, rfl⟩, hspan⟩ := hF α hα
    exact ⟨hspan, (hbounds N hN z hz i).1⟩
  have hM_pp_pos : 1 ≤ M_pp := by
    have hn2 : 1 ≤ n ^ 2 := by
      have : 1 * 1 ≤ n * n := Nat.mul_le_mul (by omega) (by omega)
      simpa [sq] using this
    have hMpow : 1 ≤ M ^ (n - 6) := Nat.one_le_pow _ _ hM
    simpa [M_pp] using Nat.mul_le_mul hn2 hMpow
  have h_nat_ineq : 4 * (M_pp + 1) * M_gen * (3 * N) ^ n * M_wt ^ 4 ≤ C_bad * N ^ (2 * n - 1) := by
    have hstep1 : 4 * (M_pp + 1) * M_gen * (3 * N) ^ n * M_wt ^ 4 ≤
        4 * (2 * M_pp) * M_gen * (3 * N) ^ n * M_wt ^ 4 := by
      have : M_pp + 1 ≤ 2 * M_pp := by omega
      gcongr
    refine le_trans hstep1 (le_of_eq ?_)
    let k := n - 6
    have hk_n : n = k + 6 := by omega
    have hk_n1 : n - 1 = k + 5 := by omega
    have hk_2n1 : 2 * n - 1 = 2 * k + 11 := by omega
    dsimp [M_pp, M_gen, M_wt, M, C_bad]
    rw [hk_n1, hk_2n1]
    conv_lhs => rw [show (3 * N) ^ n = (3 * N) ^ (k + 6) by rw [hk_n]]
    conv_rhs => rw [show 3 ^ n = 3 ^ (k + 6) by rw [hk_n]]
    change 4 * (2 * (n ^ 2 * (B₁ * N) ^ k)) * (C_gen * (B₁ * N)) * (3 * N) ^ (k + 6) * (n * (B₁ * N)) ^ 4 =
      8 * n ^ 6 * C_gen * B₁ ^ (k + 5) * 3 ^ (k + 6) * N ^ (2 * k + 11)
    simp only [mul_pow, pow_add, pow_mul]
    ring
  have hkai : (((4 * (M_pp + 1) * M_gen * (3 * N) ^ n * M_wt ^ 4 : ℕ) : ℝ)) <
      kaiSum c₀ c (Ω₀ ∩ realBox (2 * n) (N : ℝ)) N := by
    have hN_pos : (0 : ℝ) < (N : ℝ) := by positivity
    have hN_pow_pos : (0 : ℝ) < (N : ℝ) ^ (2 * n - 1) := by positivity
    have h2n_eq : 2 * n - 1 + 1 = 2 * n := by omega
    calc (((4 * (M_pp + 1) * M_gen * (3 * N) ^ n * M_wt ^ 4 : ℕ) : ℝ))
      _ ≤ ((C_bad * N ^ (2 * n - 1) : ℕ) : ℝ) := Nat.cast_le.mpr h_nat_ineq
      _ = (C_bad : ℝ) * (N : ℝ) ^ (2 * n - 1) := by push_cast; ring
      _ < (c_main * (N : ℝ)) * (N : ℝ) ^ (2 * n - 1) :=
          mul_lt_mul_of_pos_right hC_bad_lt hN_pow_pos
      _ = c_main * ((N : ℝ) ^ (2 * n - 1) * (N : ℝ) ^ 1) := by ring
      _ = c_main * (N : ℝ) ^ (2 * n) := by
          rw [← pow_add, h2n_eq]
      _ ≤ kaiSum c₀ c (Ω₀ ∩ realBox (2 * n) (N : ℝ)) N := hkai_lb N hN₁_le
  exact exists_prime_quadruple_of_kaiSum_gt K ω a₁_int a₂_int a₃_int μ l hμ hdiff haff
    Ω₀ N M_pp M_gen M_wt hN h_wt h_pp h_gen hkai

theorem suitable_twist_of_prime_quadruple (K : Type u) [Field K] [NumberField K]
    (a₁ a₂ a₃ : K)
    (τ : Fin 12 → {w : NumberField.InfinitePlace K // w.IsReal})
    (T S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (π : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.adicCompletion K)
    (κ : Kˣ) (z : Fin 6 → Kˣ × Kˣ)
    (hstart : IsStartingTriple K a₁ a₂ a₃ τ)
    (hT : IsGoodT a₁ a₂ a₃ T)
    (haux : IsAuxiliaryTwist K a₁ a₂ a₃ τ T S π κ z)
    (bad : Set (SqCl K))
    (ω : Module.Basis (Fin (Module.finrank ℚ K)) ℤ (NumberField.RingOfIntegers K))
    (a₁_int a₂_int a₃_int κ_int m l : NumberField.RingOfIntegers K)
    (hmod : IsTwistModulusAndOffset a₁ a₂ a₃ T S π κ bad a₁_int a₂_int a₃_int κ_int m l)
    (haff : ∀ z : Fin (2 * Module.finrank ℚ K) → ℤ,
      affEval (suitC0 a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l 0)
        (suitC ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int) 0) z =
        1 + (m ^ 2 * κ_int) * kaiCoordX ω z +
          a₁_int * (m ^ 2 * κ_int) * ((m ^ 2 * κ_int) * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l 1)
        (suitC ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int) 1) z =
        1 + (m ^ 2 * κ_int) * kaiCoordX ω z +
          a₂_int * (m ^ 2 * κ_int) * ((m ^ 2 * κ_int) * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l 2)
        (suitC ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int) 2) z =
        1 + (m ^ 2 * κ_int) * kaiCoordX ω z +
          a₃_int * (m ^ 2 * κ_int) * ((m ^ 2 * κ_int) * kaiCoordY ω z + l) ∧
      affEval (suitC0 a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l 3)
        (suitC ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int) 3) z =
        (m ^ 2 * κ_int) * kaiCoordY ω z + l)
    (z_lat : Fin (2 * Module.finrank ℚ K) → ℤ)
    (𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hquad : IsPrimeQuadrupleInCone
      (suitC0 a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l)
      (suitC ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int))
      (suitCone τ (κ : K)
        (suitC0 a₁_int a₂_int a₃_int (m ^ 2 * κ_int) l)
        (suitC ω a₁_int a₂_int a₃_int (m ^ 2 * κ_int)))
      z_lat 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄) :
    ∃ (t : Kˣ) (c d : K),
      sqCl t ∉ bad ∧
      d ≠ 0 ∧
      (t : K) = (m : K)⁻¹ ^ 2 * d * (c + a₁ * d) * (c + a₂ * d) * (c + a₃ * d) ∧
      IsSuitableTwist K a₁ a₂ a₃ T S t z 𝔮₁ 𝔮₂ 𝔮₃ 𝔮₄ :=
by
  classical
  
  have hdesc_outside : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ r : Kˣ × Kˣ,
        IsDescentClass
          (algebraMap K (v.adicCompletion K) a₁)
          (algebraMap K (v.adicCompletion K) a₂)
          (algebraMap K (v.adicCompletion K) a₃)
          (algebraMap K (v.adicCompletion K) (r.1 : K))
          (algebraMap K (v.adicCompletion K) (r.2 : K)) ↔
        EvenVal v r.1 ∧ EvenVal v r.2 := by
    rcases hstart with ⟨h₁₂, h₁₃, h₂₃, _, _, _, hint₁, hint₂, hint₃, _⟩
    intro v hvT r
    obtain ⟨h2, hdesc_even⟩ := local_descent_implies_evenVal K a₁ a₂ a₃ hint₁ hint₂ hint₃ T hT v hvT
    exact isDescentClass_iff_evenVal_of_notMem_T K a₁ a₂ a₃ h₁₂ h₁₃ h₂₃ v h2
      (isSquare_one_add_of_valuation_lt_one K v h2)
      (exists_nonSquare_unit_mod_ideal K v h2)
      (exists_ringOfIntegers_sub_valuation_lt_one K v)
      hdesc_even r
  have h_piv : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∃ π_u : Kˣ, IsLocalPivotUnif K a₁ a₂ a₃ v π_u :=
    fun v hvT => local_v1_hilbLoc_and_ramLocal_laws K a₁ a₂ a₃ τ T v hstart hT hvT (hdesc_outside v hvT)
  have h_hilb_even_even : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v ∉ T → ∀ a b : Kˣ, EvenVal v a → EvenVal v b →
        hilbFin v (a : K) (b : K) = 1 := by
    intro v hvT a b ha hb
    obtain ⟨π_u, hpiv⟩ := h_piv v hvT
    exact hpiv.2.2.2.2.2.2.2.1 a b ha hb
