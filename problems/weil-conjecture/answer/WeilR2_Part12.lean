            rw [← Scheme.Opens.range_ι] at hvy
            obtain ⟨a, ha⟩ := hvy
            obtain ⟨t, -, ht⟩ := hpts hpb a y ha
            exact ⟨t, ht⟩
        obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iW ℓ
        obtain ⟨θ, hθ⟩ := wc_et_punct_supp_boundary_lift iW gV hrange ℓ D k α
        have hkill : ∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W) (g : Z' ⟶ ZW),
            IsPullback g iW' iW (𝟙 W) → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData (𝟙 W) ℓ)
            (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)),
            wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) →
            wcEtSuppRestr D Ef D' γ (k + 1) θ = 0 := by
          intro Z' iW' g hp D' Ef γ _
          haveI : IsClosedImmersion iW' :=
            MorphismProperty.of_isPullback (P := @IsClosedImmersion) hp inferInstance
          haveI : Etale g := MorphismProperty.of_isPullback (P := @Etale) hp.flip inferInstance
          have hiW' : iW' = g ≫ iW := (Category.comp_id iW').symm.trans hp.w.symm
          haveI : SmoothOfRelativeDimension (n - c') (iW' ≫ v ≫ pY) := by
