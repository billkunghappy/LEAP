        (c : W ⟶ (wcEtToProEt X).obj V₁) (t : G.obj.obj (Opposite.op V₁)),
        (H.obj.map g.op).hom s = (H.obj.map c.op).hom ((θ.hom.app (Opposite.op V₁)).hom t))
        ∈ Scheme.ProEt.topology X T)
    (hinj : ∀ (V₁ : X.Etale) (t : G.obj.obj (Opposite.op V₁)) (T : X.ProEt)
      (a : T ⟶ (wcEtToProEt X).obj V₁),
      (H.obj.map a.op).hom ((θ.hom.app (Opposite.op V₁)).hom t) = 0 →
      Sieve.generate (fun (W : X.ProEt) (g : W ⟶ T) => ∃ (V₂ : X.Etale) (b : V₂ ⟶ V₁)
        (a' : W ⟶ (wcEtToProEt X).obj V₂),
        a' ≫ (wcEtToProEt X).map b = g ≫ a ∧ (G.obj.map b.op).hom t = 0)
        ∈ Scheme.ProEt.topology X T) :
    Nonempty ((wcEpsInv X).obj G ≅ H) :=
by
  classical

  have hcomp : ∀ V : X.Etale,
      ((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt X) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)).unit.app G).hom.app (Opposite.op V) =
      ((wcEtToProEt X).op.lanUnit.app G.obj).app (Opposite.op V) ≫
        (toSheafify (Scheme.ProEt.topology X) ((wcEtToProEt X).op.lan.obj G.obj)).app
          (Opposite.op ((wcEtToProEt X).obj V)) := by
    intro V
    have h1 := Adjunction.map_restrictFullyFaithful_unit_app
      (((wcEtToProEt X).op.lanAdjunction AddCommGrpCat.{u+1}).comp
        (sheafificationAdjunction (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}))
      (fullyFaithfulSheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (Functor.FullyFaithful.id _)
      (L := Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt X) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X))
      (R := (wcEtToProEt X).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X))
      (Iso.refl _) (Iso.refl _) G
    rw [Adjunction.comp_unit_app, Functor.lanAdjunction_unit, sheafificationAdjunction_unit_app] at h1
    have h2 := congrArg (fun f => NatTrans.app f (Opposite.op V)) h1
    refine h2.trans ?_
    ext x
    rfl

  have hrep : ∀ (T : X.ProEt) (x : ((wcEtToProEt X).op.lan.obj G.obj).obj (Opposite.op T)),
      ∃ (V₁ : X.Etale) (a : T ⟶ (wcEtToProEt X).obj V₁) (w : G.obj.obj (Opposite.op V₁)),
        x = (((wcEtToProEt X).op.lan.obj G.obj).map a.op).hom
          ((((wcEtToProEt X).op.lanUnit.app G.obj).app (Opposite.op V₁)).hom w) := by
    intro T x
    haveI : Limits.PreservesFiniteLimits (wcEtToProEt X) :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt X)
        (Scheme.ProEt.forget X)
        (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget X))) inferInstance
    haveI : RepresentablyFlat (wcEtToProEt X) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow T (wcEtToProEt X)) := RepresentablyFlat.cofiltered T
    haveI : IsFiltered (CostructuredArrow (wcEtToProEt X).op (Opposite.op T)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtToProEt X) T)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtToProEt X).op (Opposite.op T))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (wcEtToProEt X).op (Opposite.op T))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((wcEtToProEt X).op.leftKanExtension G.obj)
      ((wcEtToProEt X).op.leftKanExtensionUnit G.obj)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op T)) :=
      (wcEtToProEt X).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit G.obj (Opposite.op T)
    obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ hc x
    exact ⟨j.left.unop, j.hom.unop, y, hy.symm⟩

  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt X)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)
  let L := (wcEtToProEt X).op.lan.obj G.obj
  let η := (wcEtToProEt X).op.lanUnit.app G.obj
  let σ := toSheafify (Scheme.ProEt.topology X) L
  let Φ := (adj.homEquiv G H).symm θ

  have hθ : ∀ (V : X.Etale) (t : G.obj.obj (Opposite.op V)),
      (θ.hom.app (Opposite.op V)).hom t =
        (Φ.hom.app (Opposite.op ((wcEtToProEt X).obj V))).hom
          ((σ.app (Opposite.op ((wcEtToProEt X).obj V))).hom ((η.app (Opposite.op V)).hom t)) := by
    intro V t
    have e1 : adj.unit.app G ≫ ((wcEtToProEt X).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)).map Φ = θ :=
      (adj.homEquiv_unit G H Φ).symm.trans (Equiv.apply_symm_apply (adj.homEquiv G H) θ)
    have e2 : θ.hom.app (Opposite.op V) = η.app (Opposite.op V) ≫
        σ.app (Opposite.op ((wcEtToProEt X).obj V)) ≫
          Φ.hom.app (Opposite.op ((wcEtToProEt X).obj V)) := by
      rw [← e1]
      exact (congrArg (· ≫ Φ.hom.app (Opposite.op ((wcEtToProEt X).obj V))) (hcomp V)).trans
        (Category.assoc _ _ _)
    rw [e2]
    rfl

  have hKF : ∀ (V : X.Etale) (T : X.ProEt) (a : T ⟶ (wcEtToProEt X).obj V)
      (t : G.obj.obj (Opposite.op V)),
      (Φ.hom.app (Opposite.op T)).hom ((σ.app (Opposite.op T)).hom
        ((L.map a.op).hom ((η.app (Opposite.op V)).hom t))) =
        (H.obj.map a.op).hom ((θ.hom.app (Opposite.op V)).hom t) := by
    intro V T a t
    have n1 := NatTrans.naturality_apply σ a.op ((η.app (Opposite.op V)).hom t)
    have n2 := NatTrans.naturality_apply Φ.hom a.op
      ((σ.app (Opposite.op ((wcEtToProEt X).obj V))).hom ((η.app (Opposite.op V)).hom t))
    rw [hθ V t]
    exact (congrArg (Φ.hom.app (Opposite.op T)).hom n1).trans n2

  haveI hΨs : Presheaf.IsLocallySurjective (Scheme.ProEt.topology X) (σ ≫ Φ.hom) := by
    constructor
    intro T s
    refine (Scheme.ProEt.topology X).superset_covering ?_ (hsurj T s)
    rw [Sieve.generate_le_iff]
    intro W g hg
    obtain ⟨V₁, c, t, hst⟩ := hg
    rw [Presheaf.imageSieve_apply]
    exact ⟨(L.map c.op).hom ((η.app (Opposite.op V₁)).hom t), (hKF V₁ W c t).trans hst.symm⟩

  haveI hΨi : Presheaf.IsLocallyInjective (Scheme.ProEt.topology X) (σ ≫ Φ.hom) := by
    constructor
    intro T' x y hxy
