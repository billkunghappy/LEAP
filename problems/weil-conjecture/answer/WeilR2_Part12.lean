    exact ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) adj
      (wcFreeSheaf S U) (L.obj (wcFreeSheaf S U)) (adj.unit.app (wcFreeSheaf S U)) hb
