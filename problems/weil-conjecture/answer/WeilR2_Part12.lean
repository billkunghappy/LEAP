        (Abelian.Ext.mk₀ Df'.μ.hom) (add_zero n)) (zero_add n) =
        (Abelian.Ext.mk₀ (γ₂ ≫ Df'.Φ.map γ₁)).comp
          ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
            (Abelian.Ext.mk₀ (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)) (add_zero n)) (zero_add n) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
    rw [hL, hR]
    have hwψ : w ≫ ψ.hom.app (wcIntSuppObj D) =
        (γ₂ ≫ Df'.Φ.map γ₁) ≫ m.app ((Df.Φ ⋙ Df'.Φ).obj (wcIntSuppObj D)) := by
      rw [hw]
      simp only [Category.assoc, Iso.inv_hom_id_app]
      exact congrArg (fun t => γ₂ ≫ Df'.Φ.map γ₁ ≫ t) (Category.comp_id _)
    have key : (Abelian.Ext.mk₀ (m.app ((Df.Φ ⋙ Df'.Φ).obj (wcIntSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (ψ.inv.app (SheafOfModules.unit (wcIntRingSheaf V ℓ)) ≫ Dk.μ.hom))
          (add_zero n)) (zero_add n) =
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
          (Abelian.Ext.mk₀ (Df'.Φ.map Df.μ.hom ≫ Df'.μ.hom)) (add_zero n) := by
      rw [← h4, hcen m, h3]
      exact congrArg (fun p => (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Df'.Φ) θ).comp
        (Abelian.Ext.mk₀ p) (add_zero n)) hU
    rw [hwψ]
    exact (h2 _ _ _).symm.trans (congrArg (fun t => (Abelian.Ext.mk₀ (γ₂ ≫ Df'.Φ.map γ₁)).comp t
      (zero_add n)) key)

theorem wc_wcontr_int_supp_thom_reference (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV)) :
    ∃ τ : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) _ _ (HasExt.standard _)
        (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r),
      ∀ z : V.left, IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
      ∀ (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (_ : Epi (wcSuppUnitMap Dz))
        (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ) (_ : wcIntPullCanonical DΛz)
        (γΛz : wcIntSuppObj Dz ⟶ DΛz.Φ.obj (wcIntSuppObj DV)),
        wcIntSuppπ Dz ≫ γΛz = DΛz.μ.inv ≫ DΛz.Φ.map (wcIntSuppπ DV) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        ∀ w : Abelian.Ext (wcIntSuppObj Dz) (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
          ∃ e : ℤ_[ℓ], w =
            ((Abelian.Ext.mk₀ γΛz).comp (wcIntSuppPullExt DV DΛz (2 * r) τ) (zero_add _)).comp
              (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z)) ℓ
                (ContinuousMap.const _ (ULift.up e)))) (add_zero _) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _
  haveI : WeaklyEtale V.hom := V.prop

  have hK0 : ∀ S : Scheme.{u}, wcHMConst S ℓ 0 = 0 := by
    intro S
    have h := (wc_hm_const_ring S ℓ).2.2 0 0
    rw [add_zero] at h
    calc wcHMConst S ℓ 0 = (wcHMConst S ℓ 0 + wcHMConst S ℓ 0) - wcHMConst S ℓ 0 :=
          (add_sub_cancel_right _ _).symm
      _ = wcHMConst S ℓ 0 - wcHMConst S ℓ 0 := by rw [← h]
      _ = 0 := sub_self _
  have hcm : ∀ (S : Scheme.{u}) {A : SheafOfModules.{u+1} (wcRingSheaf S ℓ)},
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
      ∀ (X : Abelian.Ext A (SheafOfModules.unit (wcRingSheaf S ℓ)) (2 * r)) (a b : ℚ_[ℓ]),
      (X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ a)) (add_zero _)).comp
          (Abelian.Ext.mk₀ (wcHMConst S ℓ b)) (add_zero _) =
        X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ (a * b))) (add_zero _) := by
    intro S A X a b
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      ← (wc_hm_const_ring S ℓ).2.1]
  have hca : ∀ (S : Scheme.{u}) {A : SheafOfModules.{u+1} (wcRingSheaf S ℓ)},
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
      ∀ (X : Abelian.Ext A (SheafOfModules.unit (wcRingSheaf S ℓ)) (2 * r)) (a b : ℚ_[ℓ]),
      X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ (a + b))) (add_zero _) =
        X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ a)) (add_zero _) +
          X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ b)) (add_zero _) := by
    intro S A X a b
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    rw [(wc_hm_const_ring S ℓ).2.2, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have hc1 : ∀ (S : Scheme.{u}) {A : SheafOfModules.{u+1} (wcRingSheaf S ℓ)},
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
      ∀ (X : Abelian.Ext A (SheafOfModules.unit (wcRingSheaf S ℓ)) (2 * r)),
      X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ 1)) (add_zero _) = X := by
    intro S A X
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    rw [(wc_hm_const_ring S ℓ).1, Abelian.Ext.comp_mk₀_id]
  have hc0 : ∀ (S : Scheme.{u}) {A : SheafOfModules.{u+1} (wcRingSheaf S ℓ)},
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
      ∀ (X : Abelian.Ext A (SheafOfModules.unit (wcRingSheaf S ℓ)) (2 * r)),
      X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ 0)) (add_zero _) = 0 := by
    intro S A X
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    rw [hK0 S, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  have hns : ∀ (S : Scheme.{u}) {A : SheafOfModules.{u+1} (wcRingSheaf S ℓ)},
      letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
      ∀ (X : Abelian.Ext A (SheafOfModules.unit (wcRingSheaf S ℓ)) (2 * r)) (k : ℕ),
      k • X = X.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ (k : ℚ_[ℓ]))) (add_zero _) := by
    intro S A X k
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    induction k with
    | zero => rw [zero_nsmul, Nat.cast_zero, hc0]
    | succ k ih => rw [succ_nsmul, ih, Nat.cast_succ, hca, hc1]

  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  obtain ⟨θ1, hθ1⟩ := wc_smooth_pair_zmod_thom_strict_nonzero K pY n m r hmr i ℓ hℓ Di hDi
  obtain ⟨θ, hθ⟩ := wc_smooth_pair_int_supp_red_surj K pY n m r hmr i ℓ hℓ Di hDi θ1
  obtain ⟨DΛv, hDΛv⟩ := wc_int_pull_data_exists V.hom ℓ
  obtain ⟨γΛV, hγΛV⟩ := wc_closed_int_supp_bc_exists i V.hom Di hDi DΛv hDΛv DV hDV hepi
  refine ⟨(Abelian.Ext.mk₀ γΛV).comp (wcIntSuppPullExt Di DΛv (2 * r) θ) (zero_add _), ?_⟩
  intro z hz hzr Dz hDz hepiz DΛz hDΛz γΛz hγΛz
  letI : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  intro w

  haveI : HenselianLocalRing (V.left.presheaf.stalk z) := (h5 z hz).1
  haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := (h5 z hz).2
  haveI : WeaklyEtale (V.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale V.left z
  have hk : WeaklyEtale (V.left.fromSpecStalk z ≫ V.hom) := inferInstance
  have hP : IsPullback
      (Limits.pullback.snd (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i) ≫
        Limits.pullback.snd V.hom i)
      (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i))
      i (V.left.fromSpecStalk z ≫ V.hom) :=
    (IsPullback.of_hasPullback (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)).flip.paste_horiz
      (IsPullback.of_hasPullback V.hom i).flip
  have hzY : (V.left.fromSpecStalk z ≫ V.hom)
      (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) ∈ Set.range i := by
    obtain ⟨w, hw⟩ := hzr
    refine ⟨Limits.pullback.snd V.hom i w, ?_⟩
    have hc : (Limits.pullback.fst V.hom i ≫ V.hom) w = (Limits.pullback.snd V.hom i ≫ i) w := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hc
    have hcp : V.left.fromSpecStalk z (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) = z :=
      Scheme.fromSpecStalk_closedPoint
    calc i (Limits.pullback.snd V.hom i w) = V.hom (Limits.pullback.fst V.hom i w) := hc.symm
      _ = V.hom z := congrArg _ hw
      _ = V.hom (V.left.fromSpecStalk z (IsLocalRing.closedPoint (V.left.presheaf.stalk z))) :=
          congrArg _ hcp.symm
      _ = (V.left.fromSpecStalk z ≫ V.hom) (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) :=
          (Scheme.Hom.comp_apply _ _ _).symm

  obtain ⟨DΛk, hDΛk⟩ := wc_int_pull_data_exists (V.left.fromSpecStalk z ≫ V.hom) ℓ
  obtain ⟨γ₁₂, hγ₁₂, hcomp⟩ := wc_int_supp_pull_comp_exists V.hom (V.left.fromSpecStalk z)
    (V.left.fromSpecStalk z ≫ V.hom) rfl Di DV Dz DΛv hDΛv DΛz hDΛz DΛk hDΛk γΛV hγΛV γΛz hγΛz
  rw [← hcomp (2 * r) θ]
  have hnz := hθ1 θ hθ (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) hk hzY _ _ _
    hP Dz hDz hepiz DΛk hDΛk γ₁₂ hγ₁₂
  generalize (Abelian.Ext.mk₀ γ₁₂).comp (wcIntSuppPullExt Di DΛk (2 * r) θ) (zero_add _) = t
    at hnz ⊢
  have hcomp_nsmul : ∀ (N : ℕ)
      {A B C' : SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)}
      (x : Abelian.Ext A B (2 * r)) (g : B ⟶ C'),
      (N • x).comp (Abelian.Ext.mk₀ g) (add_zero _) =
        x.comp (Abelian.Ext.mk₀ (N • g)) (add_zero _) := by
    intro N A B C' x g
    induction N with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    | succ N ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih, Abelian.Ext.mk₀_add,
        Abelian.Ext.comp_add]
  have hπ : (ℓ ^ 1 : ℕ) • Limits.cokernel.π ((ℓ ^ 1 : ℕ) •
      𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ)) = 0 := by
    have h := Limits.cokernel.condition ((ℓ ^ 1 : ℕ) •
      𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ))
    rwa [Preadditive.nsmul_comp, Category.id_comp] at h
  have hP1 : ∀ y : Abelian.Ext (wcIntSuppObj Dz) (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ)
      (2 * r), t ≠ (ℓ ^ 1 : ℕ) • y := by
    intro y hty
    apply hnz
    rw [hty, hcomp_nsmul, hπ, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨E', hE'⟩ := wc_int_rat_data_exists (Spec (V.left.presheaf.stalk z)) ℓ
  obtain ⟨εR, hεi, hεR⟩ := wc_int_supp_rat_eps ℓ Dz hepiz E' hE'
  have inj := wc_wcontr_stalk_int_rat_injective K pY n m r hmr i ℓ hℓ V h1 h2 h3 h4 h5
    DV hDV hepi z hz hzr Dz hDz hepiz E' hE' εR hεi hεR
  have hinj : ∀ x x' : Abelian.Ext (wcIntSuppObj Dz)
      (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
      wcIntSuppRat Dz E' εR (2 * r) x = wcIntSuppRat Dz E' εR (2 * r) x' → x = x' := by
    intro x x' h
    exact sub_eq_zero.mp (inj _ (by rw [map_sub, h, sub_self]))
  have hC : ∀ (x : Abelian.Ext (wcIntSuppObj Dz)
      (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r)) (a : ℤ_[ℓ]),
      wcIntSuppRat Dz E' εR (2 * r) (x.comp (Abelian.Ext.mk₀
        (wcIntFun (Spec (V.left.presheaf.stalk z)) ℓ (ContinuousMap.const _ (ULift.up a))))
          (add_zero _)) =
      (wcIntSuppRat Dz E' εR (2 * r) x).comp
        (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (a : ℚ_[ℓ])))
        (add_zero _) :=
    fun x a => wc_int_supp_const_rat_compat ℓ Dz E' hE' εR (2 * r) x a
  have ht0 : wcIntSuppRat Dz E' εR (2 * r) t ≠ 0 := by
    intro h
    exact hP1 0 (by rw [smul_zero]; exact inj t h)

  obtain ⟨c, hc⟩ := wc_smooth_pair_strict_local_supp_line K pY n m r hmr i ℓ hℓ
    (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) hk _ _ _ hP Dz hDz hepiz
    (wcIntSuppRat Dz E' εR (2 * r) t) (wcIntSuppRat Dz E' εR (2 * r) w) ht0
  rcases le_or_gt ‖c‖ 1 with hle | hlt
  ·
    refine ⟨⟨c, hle⟩, hinj _ _ ?_⟩
    rw [hc]
    exact (hC t ⟨c, hle⟩).symm
  ·
    exfalso
    have hc0' : c ≠ 0 := by
      rintro rfl
      rw [norm_zero] at hlt
      exact absurd hlt (by norm_num)
    have hd : ‖c⁻¹‖ < 1 := by
      rw [norm_inv]
      exact inv_lt_one_of_one_lt₀ hlt
    let d' : ℤ_[ℓ] := ⟨c⁻¹, hd.le⟩
    have hd' : ‖d'‖ < 1 := by
      rw [← PadicInt.padic_norm_e_of_padicInt]
      exact hd
    obtain ⟨b, hb⟩ := (PadicInt.norm_lt_one_iff_dvd d').mp hd'
    have hb' : c⁻¹ = (ℓ : ℚ_[ℓ]) * (b : ℚ_[ℓ]) := by
      have h := congrArg (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ])) hb
      simp only [PadicInt.coe_mul, PadicInt.coe_natCast] at h
      exact h
    have hcb : c * ((b : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ])) = 1 := by
      rw [mul_comm (b : ℚ_[ℓ]), ← hb', mul_inv_cancel₀ hc0']
    have hcb' : c * (b : ℚ_[ℓ]) * ((ℓ ^ 1 : ℕ) : ℚ_[ℓ]) = 1 := by
      rw [Nat.cast_pow, pow_one, mul_assoc, hcb]
    have hcb'' : c * ((b : ℚ_[ℓ]) * ((ℓ ^ 1 : ℕ) : ℚ_[ℓ])) = 1 := by
      rw [Nat.cast_pow, pow_one, hcb]
    apply hP1 (w.comp (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z)) ℓ
      (ContinuousMap.const _ (ULift.up b)))) (add_zero _))
    apply hinj
    rw [map_nsmul, hC, hc, hns, hcm, hcm]
    first
      | rw [hcb', hc1]
      | rw [hcb'', hc1]

theorem wc_wcontr_supp_top_coord_small_near_zero (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (t : wcSuppExt DV (2 * r))
    (H0 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      ∃ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) ∧
        Epi (wcSuppUnitMap Dz))
    (H1 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        ∀ y : wcSuppExt Dz (2 * r), ∃! c : ℚ_[ℓ],
          y = ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
            (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c)) (add_zero _))
    (y : wcSuppExt DV (2 * r)) (z₀ : V.left) (hz₀ : IsClosed ({z₀} : Set V.left))
    (hz₀r : z₀ ∈ Set.range ⇑(Limits.pullback.fst V.hom i))
