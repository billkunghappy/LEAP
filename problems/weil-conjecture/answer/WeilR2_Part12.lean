          have h1 : ∀ x : wcEtZModExt (k ⁻¹ᵁ U).toScheme ℓ 0, x = 0 := by
            intro x
            rw [← Abelian.Ext.mk₀_id_comp x, hz.eq_zero_of_src (𝟙 _), Abelian.Ext.mk₀_zero,
              Abelian.Ext.zero_comp]
          haveI : Subsingleton (wcEtZModExt (k ⁻¹ᵁ U).toScheme ℓ 0) :=
            ⟨fun a b => by rw [h1 a, h1 b]⟩
          haveI : Finite (wcEtZModExt (k ⁻¹ᵁ U).toScheme ℓ 0) := Finite.of_subsingleton
          exact Finite.of_equiv _ e
      · by_cases hj2 : j + 2 + 2 * m ≤ 2 * n
        · haveI := wc_smooth_pair_compl_strict_stalk_et_low_vanish K pY n m i ℓ hℓ U hU R k hk
            (k ∣_ U) (k ⁻¹ᵁ U).ι hPU j hj hj2
          exact Finite.of_subsingleton
        · by_cases hj3 : j + 1 + 2 * m = 2 * n
          · exact (wc_smooth_pair_compl_strict_stalk_et_top_card_le K pY n m i ℓ hℓ U hU R k hk
              (k ∣_ U) (k ⁻¹ᵁ U).ι hPU j hj hj3).1
          · haveI := wc_smooth_pair_compl_strict_stalk_et_vanish K pY n m i ℓ hℓ U hU R k hk
              (k ∣_ U) (k ⁻¹ᵁ U).ι hPU j hj (by omega)
            exact Finite.of_subsingleton
    obtain ⟨η, hηinj, hηlin⟩ := wc_hm_line_of_et_tors_qcsep (k ⁻¹ᵁ U).toScheme ℓ (2 * r - 1)
      hfin htop.2

    obtain ⟨av, hav⟩ := hsurj v
    obtain ⟨aw, haw⟩ := hsurj w
    have hav0 : η av ≠ 0 := by
      intro h0
      apply hv
      have h00 : av = 0 := hηinj (h0.trans (map_zero η).symm)
      rw [← hav, h00, map_zero]
    obtain ⟨c, hc⟩ : ∃ c : ℚ_[ℓ], c = η aw / η av := ⟨_, rfl⟩
