    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (z : V.left) (hz : IsClosed ({z} : Set V.left))
    (hzr : z ∈ Set.range ⇑(Limits.pullback.fst V.hom i))
    (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
      (Limits.pullback.fst V.hom i)) ℓ) (hDz : wcHMPullCanonical Dz)
    (hepiz : Epi (wcSuppUnitMap Dz))
    (E' : wcIntRatData (Spec (V.left.presheaf.stalk z)) ℓ)
    (hE' : E'.adj.homEquiv _ _ E'.μ.hom =
      wcUnitRestrict (wcIntRatRingSheafMap (Spec (V.left.presheaf.stalk z)) ℓ))
    (εR : wcSuppObj Dz ⟶ E'.L.obj (wcIntSuppObj Dz)) (hεi : IsIso εR)
    (hεR : wcSuppUnitMap Dz ≫ εR = E'.μ.inv ≫ E'.L.map (wcIntSuppπ Dz)) :
    ∀ w : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ))
        _ _ (HasExt.standard _) (wcIntSuppObj Dz)
        (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
      wcIntSuppRat Dz E' εR (2 * r) w = 0 → w = 0 :=
by
  classical
  intro w hw
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  haveI := hεi
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : WeaklyEtale (V.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale V.left z
  haveI : HenselianLocalRing (V.left.presheaf.stalk z) := (h5 z hz).1
  haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := (h5 z hz).2

  have h0 : (Abelian.Ext.mk₀ εR).comp (wcIntRatExt E' (wcIntSuppObj Dz) (2 * r) w)
      (zero_add _) = 0 := hw
  have hX : wcIntRatExt E' (wcIntSuppObj Dz) (2 * r) w = 0 := by
    have h1 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (inv εR))
      (Abelian.Ext.mk₀ εR) (wcIntRatExt E' (wcIntSuppObj Dz) (2 * r) w) (zero_add (2 * r))
    rw [Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp, h0] at h1
    rw [h1, Abelian.Ext.comp_zero]
  have hj := (wc_int_rat_ext_eq_zero_iff (Spec (V.left.presheaf.stalk z)) ℓ E' hE'
    (wcIntSuppObj Dz) (2 * r) w).mp hX

  have hP : IsPullback
      (Limits.pullback.snd (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i) ≫
        Limits.pullback.snd V.hom i)
      (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) i
      (V.left.fromSpecStalk z ≫ V.hom) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback _ _).flip
      (IsPullback.of_hasPullback _ _).flip

  have hcp : (V.left.fromSpecStalk z ≫ V.hom)
      (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) ∈ Set.range i := by
    obtain ⟨zt, hzt⟩ := hzr
    refine ⟨Limits.pullback.snd V.hom i zt, ?_⟩
    have h2 := Scheme.Hom.comp_apply (Limits.pullback.snd V.hom i) i zt
    rw [← Limits.pullback.condition, Scheme.Hom.comp_apply, hzt] at h2
    refine h2.symm.trans ?_
    refine (congrArg (fun x => V.hom x)
      (Scheme.fromSpecStalk_closedPoint (X := V.left) (x := z)).symm).trans ?_
    exact (Scheme.Hom.comp_apply (V.left.fromSpecStalk z) V.hom _).symm

  have hrangeT : Set.range
      (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) =
      (V.left.fromSpecStalk z ≫ V.hom) ⁻¹' Set.range i := by
    ext x
    simp only [Scheme.Pullback.range_fst, Set.mem_preimage, Scheme.Hom.comp_apply]

  have hrc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ := ⟨⟨_, hrc.isOpen_compl⟩, rfl⟩
  have hWo : (((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U :
      (Spec (V.left.presheaf.stalk z)).Opens) : Set (Spec (V.left.presheaf.stalk z))) =
      (Set.range
        (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)))ᶜ := by
    rw [hrangeT, Scheme.Hom.coe_preimage, hU, Set.preimage_compl]
  have hPU := isPullback_morphismRestrict (V.left.fromSpecStalk z ≫ V.hom) U
  have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Spec (V.left.presheaf.stalk z)),
      ∃ (N : ℕ) (f : Fin N → Γ(W, ⊤)), ∀ x : ↥W,
        (p x ∉ Set.range
          (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) ↔
          ∃ a, x ∈ W.basicOpen (f a)) := by
    intro W _ p
    obtain ⟨N, f, hf⟩ :=
      wc_affine_complement_basicOpen_cover i W (p ≫ V.left.fromSpecStalk z ≫ V.hom)
    refine ⟨N, f, fun x => ?_⟩
    rw [← hf x, hrangeT, Set.mem_preimage]
    simp only [Scheme.Hom.comp_apply]
  haveI : QuasiCompact U.ι :=
    instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion (X := Y) (f := U.ι)
  haveI : QuasiCompact ((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U).ι :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hPU inferInstance
  have hOc : CompactSpace ↥((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U).toScheme :=
    QuasiCompact.compactSpace_of_compactSpace ((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U).ι
  obtain ⟨e, he⟩ := wc_int_supp_unit_restrict_ker_torsion_qc
    (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) hqc
    ((V.left.fromSpecStalk z ≫ V.hom) ⁻¹ᵁ U) hWo hOc ℓ Dz hDz (2 * r) w hj

  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  have tf := wc_smooth_pair_int_supp_local_torsion_free K pY n m r hmr i ℓ hℓ Di hDi
    (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) inferInstance hcp _ _ _ hP
    Dz hDz hepiz
  have claim : ∀ e : ℕ, ∀ y : Abelian.Ext (wcIntSuppObj Dz)
      (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
      (ℓ ^ e : ℕ) • y = 0 → y = 0 := by
    intro e
    induction e with
    | zero => intro y hy; simpa using hy
    | succ e ih =>
      intro y hy
      apply tf
      apply ih
      rw [← mul_nsmul', ← pow_succ]
      exact hy
  exact claim e w he

theorem wc_wcontr_int_tors_unit_ext_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (k j : ℕ) (hj : 1 ≤ j) :
    (letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
     ∀ x : Abelian.Ext (wcIntUnit V.left ℓ) (wcIntTors V.left ℓ k) j, x = 0) ∧
    ∀ z : V.left, IsClosed ({z} : Set V.left) →
      letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
      ∀ x : Abelian.Ext (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ)
        (wcIntTors (Spec (V.left.presheaf.stalk z)) ℓ k) j, x = 0 :=
by
  obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
  refine ⟨?_, ?_⟩
  · letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
    rcases k with _ | n
    · intro x
      have hepi : Epi ((ℓ ^ 0 : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) := by
        rw [pow_zero, one_smul]; infer_instance
      have hZ : Limits.IsZero (wcIntTors V.left ℓ 0) := Limits.isZero_cokernel_of_epi _
      rw [← Abelian.Ext.comp_mk₀_id x, hZ.eq_of_src (𝟙 _) 0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    · haveI := h1
      have e1 := wc_wstrictly_local_affine_et_vanish K ℓ hℓ (V.hom ≫ pY) ⟨h1, h2, h3, h4, h5⟩ j'
      have e2 := wc_et_coh_zmod_prime_pow_of_prime V.left ℓ (Fact.out) (j' + 1) e1 n
      exact wc_int_tors_ext_vanish_of_et_qcsep V.left ℓ (n + 1) (j' + 1) e2
  · intro z hz
    obtain ⟨hH, hS⟩ := h5 z hz
    haveI := hH
    haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := hS
    exact wc_strictHensel_int_unit_tors_ext_vanish (V.left.presheaf.stalk z) ℓ k j'

theorem wc_int_supp_pull_off_zero {X S O : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {i : X ⟶ S} (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (jO : O ⟶ S) [IsOpenImmersion jO]
    (hdisj : ∀ x : O, jO x ∉ Set.range i)
    (Do : wcIntPullData jO ℓ) (hDo : wcIntPullCanonical Do) :
    Do.μ.inv ≫ Do.Φ.map (wcIntSuppπ D) = 0 :=
by
  classical
  letI := Do.cont
  haveI := Do.additive
  haveI := Do.presLim
  haveI := Do.presColim
  let U : S.ProEt := MorphismProperty.Over.mk ⊤ jO inferInstance

  have hempty : ∀ z : ↥(Limits.pullback U.hom i), False := by
    intro z
    have e : (Limits.pullback.fst U.hom i ≫ U.hom) z = (Limits.pullback.snd U.hom i ≫ i) z := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
    exact hdisj (Limits.pullback.fst U.hom i z) ⟨Limits.pullback.snd U.hom i z, e.symm⟩
  have hz : ((wcIntSuppMap D).val.app (Opposite.op U)).hom
      (1 : C(↥U.left, ULift.{u+1} ℤ_[ℓ])) = 0 := by
    change (((wcIntSuppMap D).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℤ_[ℓ])) :
      C(↥(Limits.pullback U.hom i), ULift.{u+1} ℚ_[ℓ])) = 0
    exact ContinuousMap.ext (fun z => (hempty z).elim)

  have htr : Do.adj.homEquiv _ _ Do.μ.hom ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC jO) _ _ Do.cont Do.φ).map
        (Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)) =
      wcIntSuppMap D ≫ Do.adj.unit.app _ := by
    refine (Adjunction.homEquiv_naturality_right _ _ _).symm.trans ?_
    rw [Iso.hom_inv_id_assoc, Adjunction.homEquiv_unit]
    exact Do.adj.unit_naturality (wcIntSuppMap D)

  let u0 := SheafOfModules.unitToPushforwardObjUnit Do.φ
  let ψ₁ := (Do.adj.homEquiv _ _).symm u0
  have hfac : u0 = Do.adj.homEquiv _ _ Do.μ.hom ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC jO) _ _ Do.cont Do.φ).map
        (Do.μ.inv ≫ ψ₁) := by
    calc u0 = Do.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
      _ = Do.adj.homEquiv _ _ (Do.μ.hom ≫ Do.μ.inv ≫ ψ₁) := by rw [Iso.hom_inv_id_assoc]
      _ = _ := Adjunction.homEquiv_naturality_right _ _ _
  let c : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ]) :=
    ((Do.adj.homEquiv _ _ Do.μ.hom).val.app (Opposite.op U)).hom
      (1 : C(↥U.left, ULift.{u+1} ℤ_[ℓ]))
  let a : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ]) :=
    ((Do.μ.inv ≫ ψ₁).val.app (Opposite.op ((wcProEtBC jO).obj U))).hom
      (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ]))
  have hu1 : (u0.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℤ_[ℓ])) =
      (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ])) :=
    (Do.φ.hom.app (Opposite.op U)).hom.map_one
  have hev : (u0.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℤ_[ℓ])) =
      ((Do.μ.inv ≫ ψ₁).val.app (Opposite.op ((wcProEtBC jO).obj U))).hom c := by
    rw [hfac]
    rfl
  have hlin : ∀ x : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ]),
      ((Do.μ.inv ≫ ψ₁).val.app (Opposite.op ((wcProEtBC jO).obj U))).hom x = x * a := by
    intro x
    have e := ((Do.μ.inv ≫ ψ₁).val.app (Opposite.op ((wcProEtBC jO).obj U))).hom.map_smul x
      (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ]))
    have e2 : ((Do.μ.inv ≫ ψ₁).val.app (Opposite.op ((wcProEtBC jO).obj U))).hom x =
        ((Do.μ.inv ≫ ψ₁).val.app (Opposite.op ((wcProEtBC jO).obj U))).hom (x * 1) :=
      congrArg (fun y => ((Do.μ.inv ≫ ψ₁).val.app (Opposite.op ((wcProEtBC jO).obj U))).hom y)
        (mul_one x).symm
    exact e2.trans e
  have key : c * a = 1 := by
    rw [← hlin c, ← hev, hu1]

  have hvc : ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
        (Opposite.op ((wcProEtBC jO).obj U))).hom c = 0 := by
    refine (congrArg (fun φ => (φ.val.app (Opposite.op U)).hom
      (1 : C(↥U.left, ULift.{u+1} ℤ_[ℓ]))) htr).trans ?_
    change ((Do.adj.unit.app _).val.app (Opposite.op U)).hom
      (((wcIntSuppMap D).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℤ_[ℓ]))) = 0
    rw [hz]
    exact map_zero _
  have hW1 : ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
        (Opposite.op ((wcProEtBC jO).obj U))).hom
      (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ])) = 0 := by
    have e1 : (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ])) = a * c := by
      rw [mul_comm, key]
    have e2 : ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
          (Opposite.op ((wcProEtBC jO).obj U))).hom
        (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ])) =
        ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
          (Opposite.op ((wcProEtBC jO).obj U))).hom (a * c) :=
      congrArg (fun y => ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
          (Opposite.op ((wcProEtBC jO).obj U))).hom y) e1
    have hsm := ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
          (Opposite.op ((wcProEtBC jO).obj U))).hom.map_smul a c
    refine (e2.trans hsm).trans ?_
    rw [hvc]
    exact smul_zero _

  have hV : ∀ V : O.ProEt, ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
      (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ])) = 0 := by
    intro V
    let p : V.left ⟶ Limits.pullback U.hom jO := Limits.pullback.lift V.hom V.hom rfl
    have hp : p ≫ Limits.pullback.snd U.hom jO = V.hom := Limits.pullback.lift_snd _ _ _
    let af : V ⟶ (wcProEtBC jO).obj U := MorphismProperty.Over.homMk p hp trivial
    have h1 : ((SheafOfModules.unit (wcIntRingSheaf O ℓ)).val.map af.op).hom
        (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ])) =
        (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ])) := by
      first
        | exact PresheafOfModules.unit_map_one _ af.op
        | (change (1 : C(↥(Limits.pullback U.hom jO), ULift.{u+1} ℤ_[ℓ])).comp
              af.left.base.hom = 1
           exact ContinuousMap.one_comp _)
    refine (congrArg (fun y => ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app
      (Opposite.op V)).hom y) h1.symm).trans ?_
    refine (PresheafOfModules.naturality_apply
      (Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val af.op _).trans ?_
    exact (congrArg (fun y => ((Do.Φ.obj _).val.map af.op).hom y) hW1).trans (map_zero _)

  have hmain : Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D) = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro Xo
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    let r : (wcIntRingSheaf O ℓ).obj.obj Xo := x
    have e1 : x = r • (show (SheafOfModules.unit (wcIntRingSheaf O ℓ)).val.obj Xo from
        (1 : (wcIntRingSheaf O ℓ).obj.obj Xo)) := (mul_one r).symm
    have e2 : ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app Xo).hom x = 0 := by
      refine (congrArg (fun y => ((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app Xo).hom y)
        e1).trans ?_
      refine (((Do.μ.inv ≫ Do.Φ.map (wcIntSuppMap D)).val.app Xo).hom.map_smul r _).trans ?_
      refine (congrArg (fun y => r • y) (hV Xo.unop)).trans ?_
      exact smul_zero _
    exact e2

  haveI : Mono (Do.Φ.map (Limits.image.ι (wcIntSuppMap D))) := Functor.map_mono _ _
  apply (cancel_mono (Do.Φ.map (Limits.image.ι (wcIntSuppMap D)))).1
  rw [Category.assoc, ← Functor.map_comp, Limits.zero_comp]
  show Do.μ.inv ≫ Do.Φ.map (Limits.factorThruImage (wcIntSuppMap D) ≫
    Limits.image.ι (wcIntSuppMap D)) = 0
  rw [Limits.image.fac]
  exact hmain

theorem wc_int_pull_data_comp_Phi_iso {S S' S'' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (f : S' ⟶ S) (g : S'' ⟶ S') (k : S'' ⟶ S) (hk : g ≫ f = k)
    (Df : wcIntPullData f ℓ) (hDf : wcIntPullCanonical Df)
    (Dg : wcIntPullData g ℓ) (hDg : wcIntPullCanonical Dg)
    (Dk : wcIntPullData k ℓ) (hDk : wcIntPullCanonical Dk) :
    Nonempty (Dk.Φ ≅ Df.Φ ⋙ Dg.Φ) :=
by
  classical
  subst hk
  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {W W' : B.ProEt} (u : W ⟶ W'),
      ((wcProEtBC h).map u).left ≫ Limits.pullback.fst W'.hom h =
        Limits.pullback.fst W.hom h ≫ u.left ∧
      ((wcProEtBC h).map u).left ≫ Limits.pullback.snd W'.hom h = Limits.pullback.snd W.hom h := by
    intro A B h W W' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ W : S.ProEt, (Limits.pullbackLeftPullbackSndIso W.hom f g).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd W.hom f) g =
        Limits.pullback.snd W.hom (g ≫ f) := by
    intro W
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun W : S.ProEt =>
    (⟨MorphismProperty.Over.isoMk (A := (wcProEtBC (g ≫ f)).obj W)
        (B := (wcProEtBC f ⋙ wcProEtBC g).obj W)
        (Limits.pullbackLeftPullbackSndIso W.hom f g).symm (hsnd W),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcProEtBC (g ≫ f)).obj W ≅ (wcProEtBC f ⋙ wcProEtBC g).obj W,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso W.hom f g).inv)
  have nat : ∀ {W W' : S.ProEt} (u : W ⟶ W'),
      (wcProEtBC (g ≫ f)).map u ≫ (c W').hom =
        (c W).hom ≫ (wcProEtBC f ⋙ wcProEtBC g).map u := by
    intro W W' u
    have key : ∀ (L : Limits.pullback W.hom (g ≫ f) ⟶ Limits.pullback W'.hom (g ≫ f))
        (M1 : Limits.pullback W.hom f ⟶ Limits.pullback W'.hom f)
        (M2 : Limits.pullback (Limits.pullback.snd W.hom f) g ⟶
          Limits.pullback (Limits.pullback.snd W'.hom f) g),
        L ≫ Limits.pullback.fst W'.hom (g ≫ f) = Limits.pullback.fst W.hom (g ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd W'.hom (g ≫ f) = Limits.pullback.snd W.hom (g ≫ f) →
        M1 ≫ Limits.pullback.fst W'.hom f = Limits.pullback.fst W.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd W'.hom f = Limits.pullback.snd W.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd W'.hom f) g =
          Limits.pullback.fst (Limits.pullback.snd W.hom f) g ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd W'.hom f) g =
          Limits.pullback.snd (Limits.pullback.snd W.hom f) g →
        L ≫ (Limits.pullbackLeftPullbackSndIso W'.hom f g).inv =
          (Limits.pullbackLeftPullbackSndIso W.hom f g).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst W.hom f g)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcProEtBC (g ≫ f)).map u).left ≫ (c W').hom.left =
      (c W).hom.left ≫ ((wcProEtBC g).map ((wcProEtBC f).map u)).left
    rw [hc W, hc W']
    exact key _ _ _ (hmap (g ≫ f) u).1 (hmap (g ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap g ((wcProEtBC f).map u)).1 (hmap g ((wcProEtBC f).map u)).2
  let α : wcProEtBC (g ≫ f) ≅ wcProEtBC f ⋙ wcProEtBC g := NatIso.ofComponents c nat
  have hα : ∀ (W : S.ProEt) (z : ↥((wcProEtBC (g ≫ f)).obj W).left),
      (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
        ((α.hom.app W).left z)) = (Limits.pullback.fst W.hom (g ≫ f)) z := by
    intro W z
    change (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
      ((c W).hom.left z)) = _
    rw [hc W]
    have key : ∀ z' : ↥(Limits.pullback W.hom (g ≫ f)),
        (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
          ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv z')) =
        (Limits.pullback.fst W.hom (g ≫ f)) z' := by
      intro z'
      calc (Limits.pullback.fst W.hom f) ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g)
            ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv z'))
          = ((Limits.pullbackLeftPullbackSndIso W.hom f g).inv ≫
              Limits.pullback.fst (Limits.pullback.snd W.hom f) g ≫
                Limits.pullback.fst W.hom f) z' := rfl
        _ = (Limits.pullback.fst W.hom (g ≫ f)) z' := by
          rw [Limits.pullbackLeftPullbackSndIso_inv_fst]
    exact key z
  haveI := Df.cont
  haveI := Dg.cont
  haveI := Dk.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC g).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).app (wcIntRingSheaf S'' ℓ)
  let φfg : wcIntRingSheaf S ℓ ⟶ ((wcProEtBC f ⋙ wcProEtBC g).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).obj
        (wcIntRingSheaf S'' ℓ) :=
    Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dg.φ
  have hcompat : φfg ≫ τ = Dk.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext W
    induction W using Opposite.rec with
    | op W =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rw [hDk W s]
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun h : C(↥(Limits.pullback (Limits.pullback.snd W.hom f) g),
        ULift.{u+1} ℤ_[ℓ]) => h ((α.hom.app W).left.base z))
      (hDg ((wcProEtBC f).obj W) ((Df.φ.hom.app (Opposite.op W)).hom s :
        C(↥(Limits.pullback W.hom f), ULift.{u+1} ℤ_[ℓ])))).trans ?_
    refine (congrArg (fun h : C(↥(Limits.pullback W.hom f), ULift.{u+1} ℤ_[ℓ]) =>
        h ((Limits.pullback.fst (Limits.pullback.snd W.hom f) g).base
          ((α.hom.app W).left.base z))) (hDf W s)).trans ?_
    let s' : C(↥W.left, ULift.{u+1} ℤ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα W z)
  let ιc : SheafOfModules.pushforward Dg.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Dg.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  exact ⟨Dk.adj.leftAdjointUniq ((Df.adj.comp Dg.adj).ofNatIsoRight ιc)⟩

theorem wc_int_open_kernel_tors_transfer_natural {S S' O O' : Scheme.{u}} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    {jO : O ⟶ S} {jO' : O' ⟶ S'} {f : S' ⟶ S} {fO : O' ⟶ O}
    (Do : wcIntPullData jO ℓ) (Do' : wcIntPullData jO' ℓ)
    (Df : wcIntPullData f ℓ) (DfO : wcIntPullData fO ℓ)
    (θ : Df.Φ ⋙ Do'.Φ ≅ Do.Φ ⋙ DfO.Φ)
    (K : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (ιK : K ⟶ wcIntUnit S ℓ) [Mono ιK]
    (K' : SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)) (ιK' : K' ⟶ wcIntUnit S' ℓ)
    (ε : wcIntUnit O ℓ ⟶ Do.Φ.obj K) (hε : ε ≫ Do.Φ.map ιK = Do.μ.inv)
    (ε' : wcIntUnit O' ℓ ⟶ Do'.Φ.obj K') (hε' : ε' ≫ Do'.Φ.map ιK' = Do'.μ.inv)
    (τ₁ : K' ⟶ Df.Φ.obj K) (hτ : τ₁ ≫ Df.Φ.map ιK = ιK' ≫ Df.μ.inv) (k p : ℕ)
    (νo : Do.Φ.obj (wcIntTors S ℓ k) ⟶ wcIntTors O ℓ k)
    (hνo : Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫ νo =
      Do.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ)))
    (νo' : Do'.Φ.obj (wcIntTors S' ℓ k) ⟶ wcIntTors O' ℓ k)
    (hνo' : Do'.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S' ℓ))) ≫ νo' =
      Do'.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O' ℓ)))
    (νf : Df.Φ.obj (wcIntTors S ℓ k) ⟶ wcIntTors S' ℓ k)
    (hνf : Df.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫ νf =
      Df.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S' ℓ)))
    (νfO : DfO.Φ.obj (wcIntTors O ℓ k) ⟶ wcIntTors O' ℓ k)
    (hνfO : DfO.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ))) ≫ νfO =
      DfO.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O' ℓ))) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)) := HasExt.standard _
    haveI := Df.additive; haveI := Df.presLim; haveI := Df.presColim
    haveI := Do.additive; haveI := Do.presLim; haveI := Do.presColim
    haveI := Do'.additive; haveI := Do'.presLim; haveI := Do'.presColim
    haveI := DfO.additive; haveI := DfO.presLim; haveI := DfO.presColim
    ∀ β : Abelian.Ext K (wcIntTors S ℓ k) p,
      (Abelian.Ext.mk₀ ε').comp ((Abelian.Ext.mapExactFunctor Do'.Φ
          ((Abelian.Ext.mk₀ τ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ β).comp
            (Abelian.Ext.mk₀ νf) (add_zero p)) (zero_add p))).comp
          (Abelian.Ext.mk₀ νo') (add_zero p)) (zero_add p) =
        (Abelian.Ext.mk₀ DfO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DfO.Φ
          ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
            (Abelian.Ext.mk₀ νo) (add_zero p)) (zero_add p))).comp
          (Abelian.Ext.mk₀ νfO) (add_zero p)) (zero_add p) :=
by
  classical
  letI iS : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI iS' : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S' ℓ)) := HasExt.standard _
  letI iO : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) := HasExt.standard _
  letI iO' : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := Do.additive
  haveI := Do.presLim
  haveI := Do.presColim
  haveI := Do'.additive
  haveI := Do'.presLim
  haveI := Do'.presColim
  haveI := DfO.additive
  haveI := DfO.presLim
  haveI := DfO.presColim
  intro β

  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)} {a : ℕ}
      (p : A ⟶ B) (q : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ p).comp ((Abelian.Ext.mk₀ q).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (p ≫ q)).comp z (zero_add a) := by
    intro A B C' D' a p q z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (p : B ⟶ C') (q : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ p) (add_zero a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero a) := by
    intro A B C' D' a z p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)} {a : ℕ}
      (p : A ⟶ B) (z : Abelian.Ext B C' a) (q : C' ⟶ D'),
      ((Abelian.Ext.mk₀ p).comp z (zero_add a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        (Abelian.Ext.mk₀ p).comp (z.comp (Abelian.Ext.mk₀ q) (add_zero a)) (zero_add a) := by
    intro A B C' D' a p z q
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have hcomm : ∀ (X : (O'.ProEt)ᵒᵖ) (a b : (wcIntRingSheaf O' ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℤ_[ℓ]) _ a b
  have hext : ∀ (e : SheafOfModules.unit (wcIntRingSheaf O' ℓ) ⟶
      SheafOfModules.unit (wcIntRingSheaf O' ℓ)),
      ∃ m : 𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)),
      m.app (SheafOfModules.unit (wcIntRingSheaf O' ℓ)) = e := by
    intro e
    let R := wcIntRingSheaf O' ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (O'.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (O'.ProEt)ᵒᵖ} (g : X ⟶ Y), (R.obj.map g).hom (σ X) = σ Y :=
      fun g => PresheafOfModules.sections_property s g
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (O'.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y g
        ext x
        show σ Y • (M.val.map g).hom x = (M.val.map g).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]
  have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)))
      {A B : SheafOfModules.{u+1} (wcIntRingSheaf O' ℓ)} (z : Abelian.Ext A B p),
      (Abelian.Ext.mk₀ (m.app A)).comp z (zero_add p) =
        z.comp (Abelian.Ext.mk₀ (m.app B)) (add_zero p) := by
    intro m A B z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm

  have hR : (Abelian.Ext.mk₀ ε').comp ((Abelian.Ext.mapExactFunctor Do'.Φ
          ((Abelian.Ext.mk₀ τ₁).comp ((Abelian.Ext.mapExactFunctor Df.Φ β).comp
            (Abelian.Ext.mk₀ νf) (add_zero p)) (zero_add p))).comp
          (Abelian.Ext.mk₀ νo') (add_zero p)) (zero_add p) =
      (Abelian.Ext.mk₀ (ε' ≫ Do'.Φ.map τ₁)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) β).comp
          (Abelian.Ext.mk₀ (Do'.Φ.map νf ≫ νo')) (add_zero p)) (zero_add p) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]

  have hL : (Abelian.Ext.mk₀ DfO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DfO.Φ
          ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
            (Abelian.Ext.mk₀ νo) (add_zero p)) (zero_add p))).comp
          (Abelian.Ext.mk₀ νfO) (add_zero p)) (zero_add p) =
      (Abelian.Ext.mk₀ (DfO.μ.inv ≫ DfO.Φ.map ε)).comp
        ((Abelian.Ext.mapExactFunctor (Do.Φ ⋙ DfO.Φ) β).comp
          (Abelian.Ext.mk₀ (DfO.Φ.map νo ≫ νfO)) (add_zero p)) (zero_add p) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]

  have nat' : (Abelian.Ext.mapExactFunctor (Do.Φ ⋙ DfO.Φ) β).comp
      (Abelian.Ext.mk₀ (θ.inv.app (wcIntTors S ℓ k))) (add_zero p) =
      (Abelian.Ext.mk₀ (θ.inv.app K)).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) β) (zero_add p) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β θ.inv
  have step1 : (Abelian.Ext.mapExactFunctor (Do.Φ ⋙ DfO.Φ) β).comp
      (Abelian.Ext.mk₀ (DfO.Φ.map νo ≫ νfO)) (add_zero p) =
      ((Abelian.Ext.mk₀ (θ.inv.app K)).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) β) (zero_add p)).comp
        (Abelian.Ext.mk₀ (θ.hom.app (wcIntTors S ℓ k) ≫ DfO.Φ.map νo ≫ νfO)) (add_zero p) := by
    rw [← nat', h3, Iso.inv_hom_id_app_assoc]

  obtain ⟨m, hm⟩ := hext ((Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) ≫
    θ.hom.app (wcIntUnit S ℓ) ≫ DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom)
  have hBh : (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) = 𝟙 _ := by
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Functor.map_comp, Iso.hom_inv_id, CategoryTheory.Functor.map_id]
  have hbb : (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ m.app (wcIntUnit O' ℓ) =
      θ.hom.app (wcIntUnit S ℓ) ≫ DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom := by
    rw [hm]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Functor.map_comp_assoc, Iso.hom_inv_id, CategoryTheory.Functor.map_id, Category.id_comp]

  have hT : θ.hom.app (wcIntTors S ℓ k) ≫ DfO.Φ.map νo ≫ νfO =
      (Do'.Φ.map νf ≫ νo') ≫ m.app (wcIntTors O' ℓ k) := by
    haveI : Epi (Do'.Φ.map (Df.Φ.map
        (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))))) := inferInstance
    rw [← cancel_epi (Do'.Φ.map (Df.Φ.map
        (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))))]
    have nθ := θ.hom.naturality (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))
    simp only [Functor.comp_map] at nθ
    have nm := m.naturality (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O' ℓ)))
    simp only [Functor.id_map, Functor.id_obj] at nm
    calc Do'.Φ.map (Df.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))) ≫
          θ.hom.app (wcIntTors S ℓ k) ≫ DfO.Φ.map νo ≫ νfO
        = θ.hom.app (wcIntUnit S ℓ) ≫
            DfO.Φ.map (Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫ νo) ≫
              νfO := by
          rw [reassoc_of% nθ, Functor.map_comp_assoc]
      _ = θ.hom.app (wcIntUnit S ℓ) ≫ DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom ≫
            Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O' ℓ)) := by
          rw [hνo, Functor.map_comp_assoc, hνfO]
      _ = ((Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ m.app (wcIntUnit O' ℓ)) ≫
            Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O' ℓ)) := by
          rw [hbb]
          simp only [Category.assoc]
      _ = Do'.Φ.map (Df.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))) ≫
            (Do'.Φ.map νf ≫ νo') ≫ m.app (wcIntTors O' ℓ k) := by
          simp only [Category.assoc]
          rw [← Functor.map_comp_assoc, hνf, Functor.map_comp_assoc, reassoc_of% hνo', nm]
  have hmove : (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) β).comp
      (Abelian.Ext.mk₀ (θ.hom.app (wcIntTors S ℓ k) ≫ DfO.Φ.map νo ≫ νfO)) (add_zero p) =
      (Abelian.Ext.mk₀ (m.app (Do'.Φ.obj (Df.Φ.obj K)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) β).comp
          (Abelian.Ext.mk₀ (Do'.Φ.map νf ≫ νo')) (add_zero p)) (zero_add p) := by
    rw [hT]
    exact (h3 (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) β) (Do'.Φ.map νf ≫ νo')
      (m.app (wcIntTors O' ℓ k))).symm.trans (hcen m _).symm

  haveI : Mono (Do'.Φ.map (Df.Φ.map ιK)) := inferInstance
  have n1 : Do'.Φ.map (Df.Φ.map ιK) ≫ m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ))) =
      m.app (Do'.Φ.obj (Df.Φ.obj K)) ≫ Do'.Φ.map (Df.Φ.map ιK) :=
    m.naturality (Do'.Φ.map (Df.Φ.map ιK))
  have n2 : DfO.Φ.map (Do.Φ.map ιK) ≫ θ.inv.app (wcIntUnit S ℓ) =
      θ.inv.app K ≫ Do'.Φ.map (Df.Φ.map ιK) := θ.inv.naturality ιK
  have n3 : (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ m.app (wcIntUnit O' ℓ) =
      m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ))) ≫
        (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) :=
    m.naturality (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)
  have hmF1 : m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ))) =
      θ.hom.app (wcIntUnit S ℓ) ≫ (DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom) ≫
        (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by
    calc m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ)))
        = (m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ))) ≫
            (Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom)) ≫ (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by
          rw [Category.assoc, hBh]
          exact (Category.comp_id _).symm
      _ = ((Do'.Φ.map Df.μ.hom ≫ Do'.μ.hom) ≫ m.app (wcIntUnit O' ℓ)) ≫
            (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by rw [← n3]
      _ = (θ.hom.app (wcIntUnit S ℓ) ≫
            DfO.Φ.map Do.μ.hom ≫ DfO.μ.hom) ≫ (Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv) := by rw [hbb]
      _ = _ := Category.assoc _ _ _
  have hRP : (ε' ≫ Do'.Φ.map τ₁) ≫ Do'.Φ.map (Df.Φ.map ιK) =
      Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv := by
    rw [Category.assoc, ← Functor.map_comp, hτ, Functor.map_comp, ← Category.assoc, hε']
  have hmor : ((DfO.μ.inv ≫ DfO.Φ.map ε) ≫ θ.inv.app K) ≫ m.app (Do'.Φ.obj (Df.Φ.obj K)) =
      ε' ≫ Do'.Φ.map τ₁ := by
    rw [← cancel_mono (Do'.Φ.map (Df.Φ.map ιK)), hRP]
    calc (((DfO.μ.inv ≫ DfO.Φ.map ε) ≫ θ.inv.app K) ≫ m.app (Do'.Φ.obj (Df.Φ.obj K))) ≫
          Do'.Φ.map (Df.Φ.map ιK)
        = DfO.μ.inv ≫ DfO.Φ.map ε ≫ θ.inv.app K ≫ Do'.Φ.map (Df.Φ.map ιK) ≫
            m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ))) := by
          simp only [Category.assoc]
          rw [n1]
      _ = DfO.μ.inv ≫ DfO.Φ.map ε ≫ DfO.Φ.map (Do.Φ.map ιK) ≫
            θ.inv.app (wcIntUnit S ℓ) ≫
            m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ))) := by
          rw [reassoc_of% n2]
      _ = DfO.μ.inv ≫ DfO.Φ.map Do.μ.inv ≫
            θ.inv.app (wcIntUnit S ℓ) ≫
            m.app (Do'.Φ.obj (Df.Φ.obj (wcIntUnit S ℓ))) := by
          rw [← Functor.map_comp_assoc, hε]
      _ = Do'.μ.inv ≫ Do'.Φ.map Df.μ.inv := by
          rw [hmF1]
          simp only [Category.assoc, Iso.inv_hom_id_app_assoc]
          rw [← Functor.map_comp_assoc, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
            Category.id_comp, Iso.inv_hom_id_assoc]
  have hRHS : (Abelian.Ext.mk₀ DfO.μ.inv).comp ((Abelian.Ext.mapExactFunctor DfO.Φ
          ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
            (Abelian.Ext.mk₀ νo) (add_zero p)) (zero_add p))).comp
          (Abelian.Ext.mk₀ νfO) (add_zero p)) (zero_add p) =
      (Abelian.Ext.mk₀ (ε' ≫ Do'.Φ.map τ₁)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Do'.Φ) β).comp
          (Abelian.Ext.mk₀ (Do'.Φ.map νf ≫ νo')) (add_zero p)) (zero_add p) := by
    rw [hL, step1, h4, hmove, h2, h2]
    simp only [Category.assoc] at hmor ⊢
    rw [hmor]
  exact hR.trans hRHS.symm

theorem wc_int_open_transfer_fun_compat {S O : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (jO : O ⟶ S) (Do : wcIntPullData jO ℓ) (hDo : wcIntPullCanonical Do)
    {A : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (ε : wcIntUnit O ℓ ⟶ Do.Φ.obj A) (k p : ℕ)
    (ν : Do.Φ.obj (wcIntTors S ℓ k) ⟶ wcIntTors O ℓ k)
    (hν : Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫ ν =
      Do.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ)))
    (χ : C(↥S, ULift.{u+1} ℤ_[ℓ])) (χb : wcIntTors S ℓ k ⟶ wcIntTors S ℓ k)
    (hχb : Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ χb =
      wcIntFun S ℓ χ ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) := HasExt.standard _
    haveI := Do.additive; haveI := Do.presLim; haveI := Do.presColim
    ∀ β : Abelian.Ext A (wcIntTors S ℓ k) p,
      (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ
          (β.comp (Abelian.Ext.mk₀ χb) (add_zero p))).comp (Abelian.Ext.mk₀ ν) (add_zero p))
          (zero_add p) =
        (Abelian.Ext.mk₀ (wcIntFun O ℓ (χ.comp jO.base.hom))).comp
          ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
            (Abelian.Ext.mk₀ ν) (add_zero p)) (zero_add p)) (zero_add p) :=
by
  intro β
  letI iS : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI iO : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) := HasExt.standard _
  haveI := Do.additive
  haveI := Do.presLim
  haveI := Do.presColim

  have F2 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcIntPullData f ℓ)
      (hD : wcIntPullCanonical D) (g : C(↥S, ULift.{u+1} ℤ_[ℓ])),
      D.Φ.map (wcIntFun S ℓ g) ≫ D.μ.hom = D.μ.hom ≫ wcIntFun S' ℓ (g.comp f.base.hom) := by
    intro S S' f D hD g
    have key : ∀ h : SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcIntRingSheaf S' ℓ)),
        wcIntFun S ℓ g ≫ h =
          h ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
            (wcIntFun S' ℓ (g.comp f.base.hom)) := by
      intro h
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro X
      cases X with
      | op W =>
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      obtain ⟨a', b', hab, ha1, ha2⟩ : ∃ (a' : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))
          (b' : ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))),
          @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
            ((D.φ.hom.app (Opposite.op W)).hom a') b' ∧
          (∀ r' : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)),
            @Eq ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))
              (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom r') (r' * a')) ∧
          (∀ r' : ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))),
            @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
              (((wcIntFun S' ℓ (g.comp f.base.hom)).val.app
                (Opposite.op ((wcProEtBC f).obj W))).hom r') (r' * b')) :=
        ⟨(g.comp W.hom.base.hom : C(↥W.left, ULift.{u+1} ℤ_[ℓ])),
          ((g.comp f.base.hom).comp ((wcProEtBC f).obj W).hom.base.hom :
            C(↥((wcProEtBC f).obj W).left, ULift.{u+1} ℤ_[ℓ])),
          (hD W _).trans (ContinuousMap.ext fun t =>
            congrArg (fun q => g (q.base t)) (Limits.pullback.condition (f := W.hom) (g := f))),
          fun r' => rfl, fun r' => rfl⟩
      change (h.val.app (Opposite.op W)).hom (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))))) =
          ((wcIntFun S' ℓ (g.comp f.base.hom)).val.app (Opposite.op ((wcProEtBC f).obj W))).hom
            ((h.val.app (Opposite.op W)).hom
              (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
                (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))))
      have e1 : ((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) =
          a' • (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) := by
        have h' := ha1 1
        change @Eq ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))
          (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))))
          (a' * 1)
        rw [h', one_mul, mul_one]
      rw [e1, LinearMap.map_smul]
      generalize (h.val.app (Opposite.op W)).hom
        (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
          (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) = y
      have h2 := ha2 y
      refine Eq.trans ?_ h2.symm
      change @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
        (@HMul.hMul ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))) instHMul
          ((D.φ.hom.app (Opposite.op W)).hom a') y)
        (@HMul.hMul ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))) instHMul y b')
      rw [hab]
      exact @mul_comm C(↥(Limits.pullback W.hom f), ULift.{u+1} ℤ_[ℓ]) _ b' y
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _

  have hcomm : ∀ (X : (O.ProEt)ᵒᵖ) (a b : (wcIntRingSheaf O ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℤ_[ℓ]) _ a b
  have hext : ∀ (e : SheafOfModules.unit (wcIntRingSheaf O ℓ) ⟶
      SheafOfModules.unit (wcIntRingSheaf O ℓ)), ∃ m : 𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)),
      m.app (SheafOfModules.unit (wcIntRingSheaf O ℓ)) = e := by
    intro e
    let R := wcIntRingSheaf O ℓ
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ X : (O.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
    have hσ : ∀ {X Y : (O.ProEt)ᵒᵖ} (g : X ⟶ Y), (R.obj.map g).hom (σ X) = σ Y :=
      fun g => PresheafOfModules.sections_property s g
    let L : ∀ (M : SheafOfModules.{u+1} R) (X : (O.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
      fun M X => ModuleCat.ofHom
        { toFun := fun x => σ X • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm X] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro X Y g
        ext x
        show σ Y • (M.val.map g).hom x = (M.val.map g).hom (σ X • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      ext x
      show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
      exact ((g.val.app X).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ X • (1 : R.obj.obj X) = s.1 X
      rw [smul_eq_mul, mul_one]

  have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) ⟶
      𝟭 (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)))
      {A B : SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)} {a : ℕ} (z : Abelian.Ext A B a),
      (Abelian.Ext.mk₀ (m.app A)).comp z (zero_add a) =
        z.comp (Abelian.Ext.mk₀ (m.app B)) (add_zero a) := by
    intro m A B a z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (p : B ⟶ C') (q : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ p) (add_zero a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (p ≫ q)) (add_zero a) := by
    intro A B C' D' a z p q
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)} {a : ℕ}
      (p : A ⟶ B) (z : Abelian.Ext B C' a) (q : C' ⟶ D'),
      ((Abelian.Ext.mk₀ p).comp z (zero_add a)).comp (Abelian.Ext.mk₀ q) (add_zero a) =
        (Abelian.Ext.mk₀ p).comp (z.comp (Abelian.Ext.mk₀ q) (add_zero a)) (zero_add a) := by
    intro A B C' D' a p z q
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  obtain ⟨m, hm⟩ := hext (wcIntFun O ℓ (χ.comp jO.base.hom))
  have hstar : Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ)) ≫ m.app (wcIntTors O ℓ k) =
      wcIntFun O ℓ (χ.comp jO.base.hom) ≫
        Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ)) := by
    have h := m.naturality (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ)))
    simp only [Functor.id_map, Functor.id_obj] at h
    rw [← hm]
    exact h

  have hepi : Epi (Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))) := by
    haveI : Do.Φ.IsLeftAdjoint := Do.adj.isLeftAdjoint
    infer_instance
  have hint : Do.Φ.map χb ≫ ν = ν ≫ m.app (wcIntTors O ℓ k) := by
    rw [← cancel_epi (Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))))]
    rw [← Functor.map_comp_assoc, hχb, Functor.map_comp_assoc, hν,
      reassoc_of% (F2 Do hDo χ), reassoc_of% hν, hstar]

  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, h3, hint,
    ← h3 (Abelian.Ext.mapExactFunctor Do.Φ β) ν (m.app (wcIntTors O ℓ k)), ← hm, hcen m, h4]

theorem wc_int_open_kernel_free_corep_data {S T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (j : T ⟶ S) (D : wcHMPullData j ℓ) (hD : wcHMPullCanonical D)
    (O : S.Opens) (hO : (O : Set S) = (Set.range j)ᶜ) :
    ∃ (P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (jP : P ⟶ Limits.kernel (wcIntSuppπ D))
      (ev : ∀ M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ),
        (P ⟶ M) ≃ M.val.obj (Opposite.op (Scheme.ProEt.mk O.ι))),
      Mono jP ∧ (∀ k : ℕ, IsIso ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel jP))) ∧
      (∀ (M N : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op (Scheme.ProEt.mk O.ι))).hom (ev M g)) ∧
      ev (wcIntUnit S ℓ) (jP ≫ Limits.kernel.ι (wcIntSuppπ D)) =
        (show (wcIntUnit S ℓ).val.obj (Opposite.op (Scheme.ProEt.mk O.ι)) from
          (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk O.ι)))) :=
by
  classical

  have htfΛ : ∀ (V : (S.ProEt)ᵒᵖ) (m : ℕ)
      (r : ↑((wcIntRingSheaf S ℓ).obj.obj V)), m ≠ 0 → m • r = 0 → r = 0 := by
    intro V m r hm hr
    have key : ∀ (T : Type u) [TopologicalSpace T] (s : C(T, ULift.{u+1} ℤ_[ℓ])),
        m • s = 0 → s = 0 := by
      intro T _ s hs
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      let g : C(T, ULift.{u+1} ℤ_[ℓ]) →+ ℤ_[ℓ] := AddEquiv.ulift.toAddMonoidHom.comp
        ((Pi.evalAddMonoidHom (fun _ : T => ULift.{u+1} ℤ_[ℓ]) t).comp
          ContinuousMap.coeFnAddMonoidHom)
      have h1 : m • g s = 0 := ((map_nsmul g m s).symm.trans (congrArg g hs)).trans (map_zero g)
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hm)
    exact key ↥((Opposite.unop V).left) r hr
  obtain ⟨L, adj, hLA, hLL, hLC⟩ :=
