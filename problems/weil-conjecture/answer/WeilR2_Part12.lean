      Abelian.Ext (wcFreeSheaf S U)
        ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj
          ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).obj
