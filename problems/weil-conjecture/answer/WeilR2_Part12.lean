    (Limits.pullback (D₀.obj l₃).hom U.ι) (D₀.map (t₃₂ ≫ t₂₁)).left
    (Limits.pullback.snd i (D₀.obj l₃).hom) gZ (Limits.pullback.fst (D₀.obj l₃).hom U.ι)
    (wt ≫ w₂₁) hsq hu₃ hr₃ hw₃ D₃ Et γ₃ hγ₃ Dw₃ Dg₃).2 ⟨wcEtPull Et₃₂ M y, hwit⟩
  exact ⟨l₃, t₃₂ ≫ t₂₁, D₃, Et, γ₃, hγ₃, h3⟩

theorem wc_et_supp_strict_local_limit_kill : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] (k : Spec R ⟶ Y), WeaklyEtale k → ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z), IsPullback g iT i k → ∀ (D : wcEtPullData i ℓ) (DT : wcEtPullData iT ℓ) (Ek : wcEtPullData k ℓ) (γ : wcEtSuppObj DT ⟶ Ek.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DT ≫ γ = Ek.μ.inv ≫ Ek.Φ.map (wcEtSuppUnitMap D) → ∀ (q : ℕ) (θ : wcEtSuppExt D q), wcEtSuppRestr D Ek DT γ q θ = 0 → ∃ (W : Scheme.{u}) (v : W ⟶ Y) (w : Spec R ⟶ W), Etale v ∧ IsAffine W ∧ w ≫ v = k ∧ ∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i v → ∀ (DW : wcEtPullData iW ℓ) (Ev : wcEtPullData v ℓ) (γW : wcEtSuppObj DW ⟶ Ev.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DW ≫ γW = Ev.μ.inv ≫ Ev.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ev DW γW q θ = 0 :=
by
  classical
  intro Y Z i _ _ ℓ _ R _ _ k hk T iT g hP D DT Ek γ hγ q θ hθ0

  have s1 : ∀ {X₀ Y₀ Y₀' X₀' : Scheme.{u}} {i₀ : X₀ ⟶ Y₀} {f₀ : Y₀' ⟶ Y₀} {i₀' : X₀' ⟶ Y₀'}
      {n : ℕ} (D₀' : wcEtPullData i₀ n) (Df : wcEtPullData f₀ n) (D' : wcEtPullData i₀' n)
      (γ₀ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D₀')),
      wcEtSuppUnitMap D' ≫ γ₀ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D₀') →
      ∀ (m : ℕ) (θ₀ : wcEtSuppExt D₀' m),
        wcEtSuppClass D' m (wcEtSuppRestr D₀' Df D' γ₀ m θ₀) =
          wcEtPull Df m (wcEtSuppClass D₀' m θ₀) := by
    intro X₀ Y₀ Y₀' X₀' i₀ f₀ i₀' n D₀' Df D' γ₀ hγ₀ m θ₀
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y₀ n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y₀' n)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap D')).comp ((Abelian.Ext.mk₀ γ₀).comp
        ((Abelian.Ext.mapExactFunctor Df.Φ θ₀).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero m))
        (zero_add m)) (zero_add m) =
      (Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ
        ((Abelian.Ext.mk₀ (wcEtSuppUnitMap D₀')).comp θ₀ (zero_add m))).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero m)) (zero_add m)
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hγ₀, ← Abelian.Ext.mk₀_comp_mk₀_assoc,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero]

  have s3 : ∀ {X₀ Y₀ W₀ Z₁ Z₂ : Scheme.{u}} {n : ℕ} (i₀ : X₀ ⟶ Y₀) [IsClosedImmersion i₀]
      (v : W₀ ⟶ Y₀) (i₁ : Z₁ ⟶ W₀) (g₁ : Z₁ ⟶ X₀) (i₂ : Z₂ ⟶ W₀) (g₂ : Z₂ ⟶ X₀),
      IsPullback g₁ i₁ i₀ v → IsPullback g₂ i₂ i₀ v →
      ∀ (D₀' : wcEtPullData i₀ n) (D₁ : wcEtPullData i₁ n) (E₁ : wcEtPullData v n)
        (γ₁ : wcEtSuppObj D₁ ⟶ E₁.Φ.obj (wcEtSuppObj D₀')) (D₂ : wcEtPullData i₂ n)
        (E₂ : wcEtPullData v n) (γ₂ : wcEtSuppObj D₂ ⟶ E₂.Φ.obj (wcEtSuppObj D₀')),
        wcEtSuppUnitMap D₁ ≫ γ₁ = E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D₀') →
        wcEtSuppUnitMap D₂ ≫ γ₂ = E₂.μ.inv ≫ E₂.Φ.map (wcEtSuppUnitMap D₀') →
        ∀ (m : ℕ) (θ₀ : wcEtSuppExt D₀' m), wcEtSuppRestr D₀' E₁ D₁ γ₁ m θ₀ = 0 →
          wcEtSuppRestr D₀' E₂ D₂ γ₂ m θ₀ = 0 := by
    intro X₀ Y₀ W₀ Z₁ Z₂ n i₀ _ v i₁ g₁ i₂ g₂ h₁ h₂ D₀' D₁ E₁ γ₁ D₂ E₂ γ₂ hγ₁ hγ₂ m θ₀ h0
    haveI : IsClosedImmersion i₁ :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) h₁ inferInstance
    obtain ⟨e, he1, he2⟩ : ∃ e : Z₂ ⟶ Z₁, e ≫ g₁ = g₂ ∧ e ≫ i₁ = i₂ :=
      ⟨h₁.lift g₂ i₂ h₂.w, h₁.lift_fst _ _ _, h₁.lift_snd _ _ _⟩
    have hsq : IsPullback e i₂ i₁ (𝟙 W₀) := by
      refine IsPullback.of_right ?_ ?_ h₁
      · rw [he1, Category.id_comp]; exact h₂
      · rw [he2, Category.comp_id]
    obtain ⟨E₁₁⟩ := wc_et_zmod_pull_data_exists (𝟙 W₀) n
    obtain ⟨γ', hγ', hepi⟩ := wc_et_closed_supp_base_change i₁ (𝟙 W₀) i₂ e hsq D₁ E₁₁ D₂
    rw [wc_et_supp_restr_comp v (𝟙 W₀) v (Category.id_comp v) D₀' D₁ D₂ E₁ E₁₁ E₂ γ₁ γ' γ₂
      hγ₁ hγ' hγ₂ hepi m θ₀, h0, map_zero]

  obtain ⟨Λ, _, _, D₀, φ, hAff, hφc, hφa, hlim⟩ :=
    wc_weaklyEtale_strictHensel_prosystem (R : Type u) k hk
  have hc : ∀ l, CompactSpace (D₀.obj l).left := fun l => by haveI := hAff l; infer_instance
  have hqs : ∀ l, QuasiSeparatedSpace (D₀.obj l).left := fun l => by
    haveI := hAff l; infer_instance
  have haff : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D₀.map t).left := by
    intro l l' t
    haveI := hAff l
    haveI := hAff l'
    exact isAffineHom_of_isAffine _

  have hxR : wcEtPull Ek q (wcEtSuppClass D q θ) = 0 := by
    rw [← s1 D Ek DT γ hγ q θ, hθ0]
    first
      | exact Abelian.Ext.comp_zero _ _ _ _ _
      | exact Abelian.Ext.comp_zero _ _ _ _
      | simp [wcEtSuppClass]
  obtain ⟨l₁, hl₁⟩ : ∃ l₁ : Λ, ∀ E' : wcEtPullData (D₀.obj l₁).hom ℓ,
      wcEtPull E' q (wcEtSuppClass D q θ) = 0 := by
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    obtain ⟨E₀⟩ := wc_et_zmod_pull_data_exists (D₀.obj l₀).hom ℓ
    obtain ⟨Eπ⟩ := wc_et_zmod_pull_data_exists (φ l₀) ℓ
    have h₀ : wcEtPull Eπ q (wcEtPull E₀ q (wcEtSuppClass D q θ)) = 0 := by
      rw [← wc_et_pull_comp (D₀.obj l₀).hom (φ l₀) k (hφa l₀) E₀ Eπ Ek q _]
      exact hxR
    obtain ⟨l', t, E'', hE''⟩ := wc_et_limit_pull_kill_qcqs_all k Λ D₀ φ hφa hφc hlim hc hqs
      haff inferInstance inferInstance ℓ q l₀ _ Eπ h₀
    refine ⟨l', fun E' => ?_⟩
    rw [wc_et_pull_comp (D₀.obj l₀).hom (D₀.map t).left (D₀.obj l').hom
      (MorphismProperty.Over.w (D₀.map t)) E₀ E'' E' q _]
    exact hE''

  have sq₁ := IsPullback.of_hasPullback i (D₀.obj l₁).hom
  haveI : IsClosedImmersion (Limits.pullback.snd i (D₀.obj l₁).hom) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) sq₁ inferInstance
  obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i (D₀.obj l₁).hom) ℓ
  obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists (D₀.obj l₁).hom ℓ
  obtain ⟨γ₁, hγ₁, hepi₁⟩ := wc_et_closed_supp_base_change i (D₀.obj l₁).hom
    (Limits.pullback.snd i (D₀.obj l₁).hom) (Limits.pullback.fst i (D₀.obj l₁).hom) sq₁ D E₁ D₁
  have hθ₁ : wcEtSuppClass D₁ q (wcEtSuppRestr D E₁ D₁ γ₁ q θ) = 0 := by
    rw [s1 D E₁ D₁ γ₁ hγ₁ q θ]
    exact hl₁ E₁
  have hw₁ : g ≫ i = (iT ≫ φ l₁) ≫ (D₀.obj l₁).hom := by
    rw [Category.assoc, hφa]
    exact hP.w
  obtain ⟨gT, hgT1, hgT2⟩ : ∃ gT : T ⟶ Limits.pullback i (D₀.obj l₁).hom,
      gT ≫ Limits.pullback.fst i (D₀.obj l₁).hom = g ∧
        gT ≫ Limits.pullback.snd i (D₀.obj l₁).hom = iT ≫ φ l₁ :=
    ⟨Limits.pullback.lift g (iT ≫ φ l₁) hw₁, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hTsq : IsPullback gT iT (Limits.pullback.snd i (D₀.obj l₁).hom) (φ l₁) := by
    refine IsPullback.of_right ?_ ?_ sq₁
    · rw [hgT1, hφa]
      exact hP
    · exact hgT2
  obtain ⟨Eφ⟩ := wc_et_zmod_pull_data_exists (φ l₁) ℓ
  obtain ⟨γT, hγT, hepiT⟩ := wc_et_closed_supp_base_change
    (Limits.pullback.snd i (D₀.obj l₁).hom) (φ l₁) iT gT hTsq D₁ Eφ DT
  have hR : wcEtSuppRestr D₁ Eφ DT γT q (wcEtSuppRestr D E₁ D₁ γ₁ q θ) = 0 := by
    rw [← wc_et_supp_restr_comp (D₀.obj l₁).hom (φ l₁) k (hφa l₁) D D₁ DT E₁ Eφ Ek γ₁ γT γ
      hγ₁ hγT hγ hepiT q θ]
    exact hθ0

  obtain ⟨l, Dl, El, γl, hγl, hzero⟩ : ∃ (l : Λ)
      (Dl : wcEtPullData (Limits.pullback.snd i (D₀.obj l).hom) ℓ)
      (El : wcEtPullData (D₀.obj l).hom ℓ) (γl : wcEtSuppObj Dl ⟶ El.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap Dl ≫ γl = El.μ.inv ≫ El.Φ.map (wcEtSuppUnitMap D) ∧
        wcEtSuppRestr D El Dl γl q θ = 0 := by
    cases q with
    | zero =>
      refine ⟨l₁, D₁, E₁, γ₁, hγ₁, ?_⟩
      haveI := hepi₁
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (D₀.obj l₁).left ℓ)) := HasExt.standard _
      apply Abelian.Ext.precomp_mk₀_injective_of_epi
        (SheafOfModules.unit (wcEtZModRing (D₀.obj l₁).left ℓ)) (wcEtSuppUnitMap D₁)
      rw [map_zero]
      exact hθ₁
    | succ M =>
      obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ :=
        ⟨⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
      have hrl : Set.range (Limits.pullback.fst (D₀.obj l₁).hom U.ι) =
          (Set.range (Limits.pullback.snd i (D₀.obj l₁).hom))ᶜ := by
        rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι, hU, Set.preimage_compl,
          Scheme.Pullback.range_snd]
      haveI : IsOpenImmersion (Limits.pullback.fst (D₀.obj l₁).hom U.ι) := by
        first
          | infer_instance
          | exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
              (IsPullback.of_hasPullback (D₀.obj l₁).hom U.ι).flip inferInstance
      obtain ⟨a, ha⟩ := wc_et_supp_boundary_open_transport
        (Limits.pullback.snd i (D₀.obj l₁).hom) (Limits.pullback.fst (D₀.obj l₁).hom U.ι) hrl
        ℓ D₁ M _ hθ₁
      obtain ⟨l₃, t, D₃, Et, γ₃, hγ₃, h3⟩ := wc_et_supp_boundary_level_descent i ℓ U hU R k Λ
        D₀ φ hAff hφc hφa hlim l₁ D₁ M _ a ha T iT gT hTsq DT Eφ γT hγT hR
      haveI : IsClosedImmersion (Limits.pullback.snd i (D₀.obj l₃).hom) :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion)
          (IsPullback.of_hasPullback i (D₀.obj l₃).hom) inferInstance
      obtain ⟨E₃⟩ := wc_et_zmod_pull_data_exists (D₀.obj l₃).hom ℓ
      obtain ⟨γ₃', hγ₃', hepi₃⟩ := wc_et_closed_supp_base_change i (D₀.obj l₃).hom
        (Limits.pullback.snd i (D₀.obj l₃).hom) (Limits.pullback.fst i (D₀.obj l₃).hom)
        (IsPullback.of_hasPullback i (D₀.obj l₃).hom) D E₃ D₃
      refine ⟨l₃, D₃, E₃, γ₃', hγ₃', ?_⟩
      rw [wc_et_supp_restr_comp (D₀.obj l₁).hom (D₀.map t).left (D₀.obj l₃).hom
        (MorphismProperty.Over.w (D₀.map t)) D D₁ D₃ E₁ Et E₃ γ₁ γ₃ γ₃' hγ₁ hγ₃ hγ₃' hepi₃
        (M + 1) θ]
      exact h3

  refine ⟨(D₀.obj l).left, (D₀.obj l).hom, φ l, (D₀.obj l).prop, hAff l, hφa l, ?_⟩
  intro ZW iW gW hsq DW Ev γW hγW
  exact s3 i (D₀.obj l).hom (Limits.pullback.snd i (D₀.obj l).hom)
    (Limits.pullback.fst i (D₀.obj l).hom) iW gW (IsPullback.of_hasPullback _ _) hsq D Dl El γl
    DW Ev γW hγl hγW q θ hzero

theorem wc_smooth_pair_zmod_thom_strict_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∃ θ1 : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r),
      ∀ θ : Abelian.Ext (wcIntSuppObj Di) (wcIntUnit Y ℓ) (2 * r),
        θ.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
          (add_zero _) = θ1 →
      ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec R ⟶ Y), WeaklyEtale k → k (IsLocalRing.closedPoint R) ∈ Set.range i →
        ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z), IsPullback g iT i k →
        ∀ (DT : wcHMPullData iT ℓ), wcHMPullCanonical DT → Epi (wcSuppUnitMap DT) →
        ∀ (DΛ : wcIntPullData k ℓ) (_ : wcIntPullCanonical DΛ)
          (γΛ : wcIntSuppObj DT ⟶ DΛ.Φ.obj (wcIntSuppObj Di)),
          wcIntSuppπ DT ≫ γΛ = DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ Di) →
          letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
          ((Abelian.Ext.mk₀ γΛ).comp (wcIntSuppPullExt Di DΛ (2 * r) θ) (zero_add _)).comp
            (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit (Spec R) ℓ))))
            (add_zero _) ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated pY
  have hrn : r ≤ n := by omega
  haveI : SmoothOfRelativeDimension (n - r) (i ≫ pY) := by
    have e : n - r = m := by omega
    rw [e]; infer_instance

  obtain ⟨Tt, hGL, hNat, hPt⟩ := wc_et_kummer_local_thom K ℓ hℓ
  obtain ⟨De⟩ := wc_et_zmod_pull_data_exists i ℓ
  obtain ⟨θe, hθe⟩ := wc_et_thom_class_glue K ℓ hℓ Tt hGL hNat Y Z pY n r i hrn De

  obtain ⟨Θ, hsurj, hnat⟩ := wc_int_supp_zmod_et_transport ℓ (2 * r)
  obtain ⟨θ1, hθ1⟩ := hsurj i Di hDi De θe
  refine ⟨θ1, ?_⟩
  intro θ hθ R _ _ k hk hz T iT g hP DT hDT hepi DΛ hDΛ γΛ hγΛ
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
  intro h0

  obtain ⟨ν, hν, hcomp⟩ := wc_int_red_supp_pull_compat Di DΛ (2 * r)
  have hred : wcIntSuppRedRestr Di DΛ γΛ ν (2 * r) θ1 = 0 := by
    have h1 := hcomp _ γΛ θ
    rw [hθ] at h1
    rw [← h1]
    exact h0
  obtain ⟨Ek⟩ := wc_et_zmod_pull_data_exists k ℓ
  obtain ⟨DTe⟩ := wc_et_zmod_pull_data_exists iT ℓ
  obtain ⟨γe, hγe, -⟩ := wc_et_closed_supp_base_change i k iT g hP De Ek DTe
  have E0 : wcEtSuppRestr De Ek DTe γe (2 * r) θe = 0 := by
    have h1 := hnat i k iT g hP inferInstance inferInstance inferInstance inferInstance
      Di hDi DT hDT hepi DΛ hDΛ γΛ hγΛ ν hν De DTe Ek γe hγe θ1
    rw [hred, map_zero, hθ1] at h1
    exact h1.symm

  obtain ⟨W, v, w, hv, hWa, hwv, hkill⟩ :=
    wc_et_supp_strict_local_limit_kill i ℓ R k hk T iT g hP De DTe Ek γe hγe (2 * r) θe E0
  haveI : Etale v := hv
  haveI : IsAffine W := hWa
  have hZ : IsPullback (Limits.pullback.fst i v) (Limits.pullback.snd i v) i v :=
    IsPullback.of_hasPullback i v
  obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i v) ℓ
  obtain ⟨Ev⟩ := wc_et_zmod_pull_data_exists v ℓ
  obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i v (Limits.pullback.snd i v)
    (Limits.pullback.fst i v) hZ De Ev DW
  have hW0 := hkill _ (Limits.pullback.snd i v) (Limits.pullback.fst i v) hZ DW Ev γW hγW
  haveI : SmoothOfRelativeDimension n (v ≫ pY) := by
    have h : SmoothOfRelativeDimension (0 + n) (v ≫ pY) := inferInstance
    simpa using h
  have e : Limits.pullback.snd i v ≫ v ≫ pY = Limits.pullback.fst i v ≫ i ≫ pY := by
    rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc]
  haveI : SmoothOfRelativeDimension (n - r) (Limits.pullback.snd i v ≫ v ≫ pY) := by
    rw [e]
    have h : SmoothOfRelativeDimension (0 + (n - r)) (Limits.pullback.fst i v ≫ i ≫ pY) :=
      inferInstance
    simpa using h
  have hThom := wc_et_thom_class_restrict K ℓ hℓ Tt hGL hNat pY (v ≫ pY) v rfl n n r i
    (Limits.pullback.snd i v) hrn hrn (Limits.pullback.fst i v) hZ De Ev DW γW hγW θe hθe
  obtain ⟨z0, hz0⟩ := hz
  obtain ⟨t, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := i) (g := v) z0
    (w (IsLocalRing.closedPoint R)) (by
      rw [hz0, ← hwv]
      first
        | rfl
        | exact Scheme.Hom.comp_apply _ _ _
        | simp)
  obtain ⟨zK, hzK⟩ := wc_alg_closed_lft_section K (Limits.pullback i v)
    (Limits.pullback.snd i v ≫ v ≫ pY) ⟨t⟩
  exact wc_et_thom_ne_zero_of_point K ℓ hℓ Tt hGL hNat hPt W (Limits.pullback i v) (v ≫ pY) n r
    (Limits.pullback.snd i v) hrn DW _ hThom zK hzK hW0

theorem wc_smooth_pair_ladic_thom_strict_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    ∃ τ : wcSuppExt Di (2 * r),
      ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec R ⟶ Y), WeaklyEtale k → k (IsLocalRing.closedPoint R) ∈ Set.range i →
        ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z), IsPullback g iT i k →
        ∀ (Dk : wcHMPullData k ℓ) (_ : wcHMPullCanonical Dk)
          (DT : wcHMPullData iT ℓ) (_ : wcHMPullCanonical DT), Epi (wcSuppUnitMap DT) →
        ∀ (γ : wcSuppObj DT ⟶ Dk.Φ.obj (wcSuppObj Di)),
          wcSuppUnitMap DT ≫ γ = Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap Di) →
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
          (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Di Dk (2 * r) τ) (zero_add _) ≠ 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  obtain ⟨ratY, hrat⟩ := wc_smooth_pair_int_supp_rat_restrict K pY n m r hmr i ℓ hℓ Di hDi
  obtain ⟨θ1, hθ1⟩ := wc_smooth_pair_zmod_thom_strict_nonzero K pY n m r hmr i ℓ hℓ Di hDi
  obtain ⟨θ, hθ⟩ := wc_smooth_pair_int_supp_red_surj K pY n m r hmr i ℓ hℓ Di hDi θ1
  refine ⟨ratY θ, ?_⟩
  intro R _ _ k hk hz T iT g hP Dk hDk DT hDT hepi γ hγ
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
  obtain ⟨DΛ, hDΛ, γΛ, hγΛ⟩ := wc_smooth_pair_int_supp_base_change K pY n m r hmr i ℓ hℓ Di hDi
    R k hk hz T iT g hP DT hDT hepi
  obtain ⟨ratR, htors, hcomm⟩ := hrat R k hk hz T iT g hP Dk hDk DT hDT hepi γ hγ DΛ hDΛ γΛ hγΛ
  have htf := wc_smooth_pair_int_supp_local_torsion_free K pY n m r hmr i ℓ hℓ Di hDi
    R k hk hz T iT g hP DT hDT hepi
  have key : ∀ e : ℕ, ∀ z : Abelian.Ext (wcIntSuppObj DT) (wcIntUnit (Spec R) ℓ) (2 * r),
      (ℓ ^ e : ℕ) • z = 0 → z = 0 := by
    intro e
    induction e with
    | zero =>
      intro z hz
      simpa using hz
    | succ e ih =>
      intro z hz
      apply ih
      apply htf
      rw [smul_smul, ← pow_succ']
      exact hz
  intro h0
  have hry : ratR ((Abelian.Ext.mk₀ γΛ).comp (wcIntSuppPullExt Di DΛ (2 * r) θ)
      (zero_add _)) = 0 := by
    rw [hcomm θ]
    exact h0
  obtain ⟨e, he⟩ := htors _ hry
  have hy0 := key e _ he
  apply hθ1 θ hθ R k hk hz T iT g hP DT hDT hepi DΛ hDΛ γΛ hγΛ
  rw [hy0, Abelian.Ext.zero_comp]

theorem wc_smooth_pair_ladic_thom_wcontr_stalk_gen (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    ∃ τ : wcSuppExt Di (2 * r), ∀ V : Y.ProEt,
      IsAffine V.left → IsClosed {x : V.left | IsClosed ({x} : Set V.left)} →
      (∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y) →
      ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)} →
      (∀ x : V.left, IsClosed ({x} : Set V.left) →
        HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x)) →
      ∀ (Dv : wcHMPullData V.hom ℓ) (_ : wcHMPullCanonical Dv)
        (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (_ : wcHMPullCanonical DV)
        (γ : wcSuppObj DV ⟶ Dv.Φ.obj (wcSuppObj Di)),
        wcSuppUnitMap DV ≫ γ = Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di) →
        Epi (wcSuppUnitMap DV) →
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
        letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
          HasExt.standard _
        ∀ z : V.left, IsClosed ({z} : Set V.left) →
          z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
          ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
            (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
              (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
            (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
            wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
            Epi (wcSuppUnitMap Dz) →
            letI : HasExt (SheafOfModules.{u+1}
              (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
            ∀ y : wcSuppExt Dz (2 * r), ∃! c : ℚ_[ℓ],
              y = ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r)
                ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Di Dv (2 * r) τ) (zero_add _)))
                  (zero_add _)).comp
                (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c))
                (add_zero _) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  obtain ⟨τ, hτ⟩ := wc_smooth_pair_ladic_thom_strict_nonzero K pY n m r hmr i ℓ hℓ Di hDi
  refine ⟨τ, ?_⟩
  intro V h1 h2 h3 h4 h5 Dv hDv DV hDV γ hγ hepi
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _
  intro z hz hzr Ez hEz Dz hDz γz hγz hepiz
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  intro y
  haveI : HenselianLocalRing (V.left.presheaf.stalk z) := (h5 z hz).1
  haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := (h5 z hz).2
  haveI : WeaklyEtale V.hom := V.prop
  haveI : WeaklyEtale (V.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale V.left z
  have hk : WeaklyEtale (V.left.fromSpecStalk z ≫ V.hom) := inferInstance
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (V.left.fromSpecStalk z ≫ V.hom) ℓ
  obtain ⟨γ₁₂, hγ₁₂, hcomp⟩ := wc_supp_pull_comp_exists V.hom (V.left.fromSpecStalk z)
    (V.left.fromSpecStalk z ≫ V.hom) rfl Di DV Dz Dv hDv Ez hEz Dk hDk γ hγ γz hγz
  rw [← hcomp (2 * r) τ]

  have hP : IsPullback
      (Limits.pullback.snd (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i) ≫
        Limits.pullback.snd V.hom i)
      (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i))
      i (V.left.fromSpecStalk z ≫ V.hom) :=
    (IsPullback.of_hasPullback (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)).flip.paste_horiz
      (IsPullback.of_hasPullback V.hom i).flip

  have hzY : (V.left.fromSpecStalk z ≫ V.hom)
      (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) ∈ Set.range i := by
    obtain ⟨w, hw⟩ := hzr
    refine ⟨Limits.pullback.snd V.hom i w, ?_⟩
    have hc : (Limits.pullback.fst V.hom i ≫ V.hom) w = (Limits.pullback.snd V.hom i ≫ i) w := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hc
    have hcp : V.left.fromSpecStalk z (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) = z :=
      Scheme.fromSpecStalk_closedPoint
    calc i (Limits.pullback.snd V.hom i w) = V.hom (Limits.pullback.fst V.hom i w) := hc.symm
      _ = V.hom z := congrArg _ hw
      _ = V.hom (V.left.fromSpecStalk z (IsLocalRing.closedPoint (V.left.presheaf.stalk z))) :=
          congrArg _ hcp.symm
      _ = (V.left.fromSpecStalk z ≫ V.hom) (IsLocalRing.closedPoint (V.left.presheaf.stalk z)) :=
          (Scheme.Hom.comp_apply _ _ _).symm
  have ht := hτ (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) hk hzY _ _ _ hP
    Dk hDk Dz hDz hepiz γ₁₂ hγ₁₂
  have hline := wc_smooth_pair_strict_local_supp_line K pY n m r hmr i ℓ hℓ
    (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) hk _ _ _ hP Dz hDz hepiz
  generalize (Abelian.Ext.mk₀ γ₁₂).comp (wcSuppPullExt Di Dk (2 * r) τ) (zero_add _) = t at ht hline ⊢
  obtain ⟨c, hc⟩ := hline t y ht
  refine ⟨c, hc, ?_⟩
  intro c' hc'
  obtain ⟨hC1, hCmul, hCadd⟩ := wc_hm_const_ring (Spec (V.left.presheaf.stalk z)) ℓ
  by_contra hne
  have hd : c' - c ≠ 0 := sub_ne_zero.mpr hne
  have hsplit : t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c'))
        (add_zero _) =
      t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c)) (add_zero _) +
      t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)))
        (add_zero _) := by
    rw [← Abelian.Ext.comp_add, ← Abelian.Ext.mk₀_add, ← hCadd, add_sub_cancel]
  rw [← hc', ← hc] at hsplit
  have hzero : t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)))
      (add_zero _) = 0 := by
    have h2 : y + t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)))
        (add_zero _) = y + 0 := by
      rw [add_zero]; exact hsplit.symm
    exact add_left_cancel h2
  apply ht
  calc t = t.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id t).symm
    _ = t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ
          ((c' - c) * (c' - c)⁻¹))) (add_zero _) := by rw [mul_inv_cancel₀ hd, hC1]
    _ = t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c) ≫
          wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)⁻¹)) (add_zero _) := by
        rw [hCmul]
    _ = (t.comp (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)))
          (add_zero _)).comp
          (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c)⁻¹))
          (add_zero _) := by
        rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    _ = 0 := by rw [hzero, Abelian.Ext.zero_comp]

theorem wc_closed_supp_bc_fun_natural {X Y Y' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) [WeaklyEtale f]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (D' : wcHMPullData (Limits.pullback.fst f i) ℓ) (hD' : wcHMPullCanonical D')
    (γ : wcSuppObj D' ⟶ Df.Φ.obj (wcSuppObj D))
    (hγ : wcSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap D))
    (hepi : Epi (wcSuppUnitMap D')) (a : C(↥X, ULift.{u+1} ℚ_[ℓ])) :
    γ ≫ Df.Φ.map ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
        (wcHMFun X ℓ a)) =
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst f i)) _ _
          D'.cont D'.φ).map
        (wcHMFun (Limits.pullback f i) ℓ (a.comp (Limits.pullback.snd f i).base.hom)) ≫ γ :=
by
  classical

  have hs2 : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} (Dg : wcHMPullData g ℓ),
      wcHMPullCanonical Dg → ∀ (r : C(↥S', ULift.{u+1} ℚ_[ℓ])) (W : S.ProEt)
      (t : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
      t.comp (Limits.pullback.fst W.hom g).base.hom =
        r.comp (Limits.pullback.snd W.hom g).base.hom →
      ∀ x : ↑((wcSuppObj Dg).val.obj (Opposite.op W)),
      (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map
          (wcHMFun S' ℓ r)).val.app (Opposite.op W)).hom x =
        (fun (c' : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op W)))
            (x' : ↑((wcSuppObj Dg).val.obj (Opposite.op W))) => c' • x') t x := by
    intro S S' g Dg hDg r W t ht x
    have e1 : @Eq C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])
        ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map
          (wcHMFun S' ℓ r)).val.app (Opposite.op W)).hom x)
        ((@id C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ]) x) *
          r.comp (Limits.pullback.snd W.hom g).base.hom) := rfl
    have e2 : @Eq C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])
        ((fun (c' : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op W)))
            (x' : ↑((wcSuppObj Dg).val.obj (Opposite.op W))) => c' • x') t x)
        ((@id C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])
          ((Dg.φ.hom.app (Opposite.op W)).hom t)) *
          (@id C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ]) x)) := rfl
    have e3 : (@id C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])
          ((Dg.φ.hom.app (Opposite.op W)).hom t)) =
        t.comp (Limits.pullback.fst W.hom g).base.hom := hDg W t
    refine e1.trans (Eq.trans ?_ e2.symm)
    rw [e3, ht]
    exact mul_comm _ _

  have hpaste : ∀ (W : Y'.ProEt) (t : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
      t.comp (Limits.pullback.fst W.hom (Limits.pullback.fst f i)).base.hom =
        (a.comp (Limits.pullback.snd f i).base.hom).comp
          (Limits.pullback.snd W.hom (Limits.pullback.fst f i)).base.hom →
      t.comp (Limits.pullback.fst (W.hom ≫ f) i).base.hom =
        a.comp (Limits.pullback.snd (W.hom ≫ f) i).base.hom := by
    intro W t ht
    refine ContinuousMap.ext fun z => ?_
    obtain ⟨w, rfl⟩ : ∃ w, (Limits.pullbackRightPullbackFstIso f i W.hom).hom.base w = z :=
      ⟨(Limits.pullbackRightPullbackFstIso f i W.hom).inv.base z, by
        rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl⟩
    have hf := congrArg (fun k => t (k.base w))
      (Limits.pullbackRightPullbackFstIso_hom_fst f i W.hom)
    have hs := congrArg (fun k => a (k.base w))
      (Limits.pullbackRightPullbackFstIso_hom_snd f i W.hom)
    have h1 := congrArg (fun φ => φ w) ht
    exact hf.trans (h1.trans hs.symm)

  let V : Y.ProEt := MorphismProperty.Over.mk ⊤ f inferInstance
  obtain ⟨hc, -, -⟩ := wc_lpsc_site Y V
  haveI := hc
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Y ℓ V Df hDf
  have hnat : Df.Φ.map ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
        (wcHMFun X ℓ a)) =
      θ.hom.app _ ≫ (wcSliceRes Y ℓ V).map
        ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
          (wcHMFun X ℓ a)) ≫ θ.inv.app _ := by
    rw [← Category.assoc, ← θ.hom.naturality, Category.assoc, Iso.hom_inv_id_app,
      Category.comp_id]
  have hs3 : ∀ (W : Y'.ProEt) (t : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
      t.comp (Limits.pullback.fst W.hom (Limits.pullback.fst f i)).base.hom =
        (a.comp (Limits.pullback.snd f i).base.hom).comp
          (Limits.pullback.snd W.hom (Limits.pullback.fst f i)).base.hom →
      ∀ y : ↑((Df.Φ.obj (wcSuppObj D)).val.obj (Opposite.op W)),
      ((Df.Φ.map ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
          (wcHMFun X ℓ a))).val.app (Opposite.op W)).hom y =
        (fun (c' : ↑((wcRingSheaf Y' ℓ).obj.obj (Opposite.op W)))
            (y' : ↑((Df.Φ.obj (wcSuppObj D)).val.obj (Opposite.op W))) => c' • y') t y := by
    intro W t ht y
    have hR := hs2 D hD a ((wcSliceFunctor Y V).obj W) t (hpaste W t ht)
      (((θ.hom.app (wcSuppObj D)).val.app (Opposite.op W)).hom y)
    have hid : ((θ.inv.app (wcSuppObj D)).val.app (Opposite.op W)).hom
        (((θ.hom.app (wcSuppObj D)).val.app (Opposite.op W)).hom y) = y :=
      congrArg (fun φ => (φ.val.app (Opposite.op W)).hom y) (θ.hom_inv_id_app (wcSuppObj D))
    have hsm := ((θ.inv.app (wcSuppObj D)).val.app (Opposite.op W)).hom.map_smul t
      (((θ.hom.app (wcSuppObj D)).val.app (Opposite.op W)).hom y)
    rw [hnat]
    exact (congrArg ((θ.inv.app (wcSuppObj D)).val.app (Opposite.op W)).hom hR).trans
      (hsm.trans (congrArg (fun z => (fun (c' : ↑((wcRingSheaf Y' ℓ).obj.obj (Opposite.op W)))
        (y' : ↑((Df.Φ.obj (wcSuppObj D)).val.obj (Opposite.op W))) => c' • y') t z) hid))

  letI := D'.cont
  have hEpi : Epi ((SheafOfModules.toSheaf (wcRingSheaf Y' ℓ)).map
      (SheafOfModules.unitToPushforwardObjUnit D'.φ)) := by
    apply wc_proet_epi_of_affine_lift
    intro U hU y
    obtain ⟨W, g, t, hW, hg, ht⟩ :=
      wc_fibre_function_local_extension (Limits.pullback.fst f i) ℓ U hU y
    exact ⟨W, g, t, hW, hg, (hD' W t).trans ht⟩
  haveI := hEpi

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W0
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  induction W0 using Opposite.rec with
  | op W0 =>
  have hS := wc_sheaf_epi_locallySurjective (Scheme.ProEt.topology Y')
    ((SheafOfModules.toSheaf (wcRingSheaf Y' ℓ)).map
      (SheafOfModules.unitToPushforwardObjUnit D'.φ)) W0
    ((a.comp (Limits.pullback.snd f i).base.hom).comp
      (Limits.pullback.snd W0.hom (Limits.pullback.fst f i)).base.hom)
  refine Sheaf.isSeparated ((SheafOfModules.toSheaf (wcRingSheaf Y' ℓ)).obj
    (Df.Φ.obj (wcSuppObj D))) W0 _ hS _ _ ?_
  intro W h hh
  obtain ⟨c, hcW⟩ := hh
  let c' : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) := c
  have hres : @Eq C(↥(Limits.pullback W.hom (Limits.pullback.fst f i)), ULift.{u+1} ℚ_[ℓ])
      (((a.comp (Limits.pullback.snd f i).base.hom).comp
        (Limits.pullback.snd W0.hom (Limits.pullback.fst f i)).base.hom).comp
          ((wcProEtBC (Limits.pullback.fst f i)).map h).left.base.hom)
      ((a.comp (Limits.pullback.snd f i).base.hom).comp
        (Limits.pullback.snd W.hom (Limits.pullback.fst f i)).base.hom) :=
    ContinuousMap.ext fun z =>
      congrArg (fun k => (a.comp (Limits.pullback.snd f i).base.hom) (k.base z))
        (MorphismProperty.Over.w ((wcProEtBC (Limits.pullback.fst f i)).map h))
  have hgood : c'.comp (Limits.pullback.fst W.hom (Limits.pullback.fst f i)).base.hom =
      (a.comp (Limits.pullback.snd f i).base.hom).comp
        (Limits.pullback.snd W.hom (Limits.pullback.fst f i)).base.hom :=
    (hD' W c').symm.trans (hcW.trans hres)
  have hL := hs3 W c' hgood ((γ.val.app (Opposite.op W)).hom
    (((wcSuppObj D').val.map h.op).hom x))
  have hR := hs2 D' hD' (a.comp (Limits.pullback.snd f i).base.hom) W c' hgood
    (((wcSuppObj D').val.map h.op).hom x)
  have hsm := (γ.val.app (Opposite.op W)).hom.map_smul c' (((wcSuppObj D').val.map h.op).hom x)
  have mid : ((γ ≫ Df.Φ.map ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _
        D.cont D.φ).map (wcHMFun X ℓ a))).val.app (Opposite.op W)).hom
        (((wcSuppObj D').val.map h.op).hom x) =
      (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst f i)) _ _
          D'.cont D'.φ).map
        (wcHMFun (Limits.pullback f i) ℓ (a.comp (Limits.pullback.snd f i).base.hom)) ≫ γ).val.app
          (Opposite.op W)).hom (((wcSuppObj D').val.map h.op).hom x) :=
    hL.trans (hsm.symm.trans (congrArg (γ.val.app (Opposite.op W)).hom hR.symm))
  exact (PresheafOfModules.naturality_apply (γ ≫ Df.Φ.map
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map
        (wcHMFun X ℓ a))).val h.op x).symm.trans
    (mid.trans (PresheafOfModules.naturality_apply
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst f i)) _ _
          D'.cont D'.φ).map
        (wcHMFun (Limits.pullback f i) ℓ (a.comp (Limits.pullback.snd f i).base.hom)) ≫ γ).val
        h.op x))

theorem wc_wcontr_supp_top_stalk_separation_deg0 (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (H0 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      ∃ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
