      obtain ⟨hz, hS⟩ := wc_contSheaf_shortExact E ((wcTowerCast ℓ k).ker.subtype)
        continuous_subtype_val (wcTowerCast ℓ k) continuous_of_discreteTopology
        Topology.IsEmbedding.subtypeVal
        (fun b => ⟨fun hb => ⟨⟨b, hb⟩, rfl⟩, by rintro ⟨a, rfl⟩; exact a.2⟩)
