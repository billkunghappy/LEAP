theorem wc_et_punct_supp_boundary_hom : ∀ {W ZW YO : Scheme.{u}} (iW : ZW ⟶ W) [IsClosedImmersion iW] (gO : YO ⟶ W) [IsOpenImmersion gO], Set.range gO = (Set.range iW)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData iW ℓ) (k : ℕ), ∃ δ : wcEtZModExt YO ℓ k →+ wcEtSuppExt D (k + 1), ∀ (α : wcEtZModExt YO ℓ k) (W' : Scheme.{u}) (f : W' ⟶ W), Etale f → (∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW), IsPullback g iW' iW f → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ef D' γ (k + 1) (δ α) = 0) → ∀ (YO' : Scheme.{u}) (gO' : YO' ⟶ W') (w : YO' ⟶ YO), IsPullback w gO' gO f → ∃ β : wcEtZModExt W' ℓ k, ∀ (Dw : wcEtPullData w ℓ) (Dg : wcEtPullData gO' ℓ), wcEtPull Dw k α = wcEtPull Dg k β :=
by
  classical
  intro W ZW YO iW _ gO _ hrange ℓ _ D k
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO ℓ)) := HasExt.standard _
  obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gO ℓ
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  obtain ⟨c, hc, hT⟩ := wc_et_open_compl_ker_transfer iW gO hrange ℓ D Dg
  haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi iW D
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ

  let t : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D)) (SheafOfModules.unit (wcEtZModRing W ℓ)) k →
      wcEtZModExt YO ℓ k := fun x =>
    (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k)
  have hadd : ∀ x y, t (x + y) = t x + t y := by
    intro x y
    show (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ (x + y)).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k) +
      (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ y).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k)
    rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add]
  let T := AddMonoidHom.mk' t hadd
  have hTb : Function.Bijective T := hT k
  let e := AddEquiv.ofBijective T hTb

  let δ : wcEtZModExt YO ℓ k →+ wcEtSuppExt D (k + 1) :=
    AddMonoidHom.mk' (fun α => hS.extClass.comp (e.symm α) (add_comm 1 k)) (fun a b => by
      rw [map_add, Abelian.Ext.comp_add])
  refine ⟨δ, ?_⟩
  intro α W' f _ hkill YO' gO' w hpb
  obtain ⟨x₀, hx₀def⟩ : ∃ x₀, x₀ = e.symm α := ⟨_, rfl⟩
  have hx₀ : (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x₀).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k) = α := by
    rw [hx₀def]
    exact AddEquiv.ofBijective_apply_symm_apply T hTb
  have hδα : δ α = hS.extClass.comp x₀ (add_comm 1 k) := by
    rw [hx₀def]
    rfl
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)) := HasExt.standard _

  have hsq := IsPullback.of_hasPullback iW f
  haveI : IsClosedImmersion (Limits.pullback.snd iW f) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
  obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd iW f) ℓ
  obtain ⟨Ef⟩ := wc_et_zmod_pull_data_exists f ℓ
  haveI := Ef.additive
  haveI := Ef.presLim
  haveI := Ef.presColim
  obtain ⟨γ, hγ, hπ'⟩ := wc_et_closed_supp_base_change iW f (Limits.pullback.snd iW f)
    (Limits.pullback.fst iW f) hsq D Ef D'
  have h0 := hkill _ (Limits.pullback.snd iW f) (Limits.pullback.fst iW f) hsq D' Ef γ hγ
  rw [hδα] at h0

  obtain ⟨κ, hκ, hnat⟩ := wc_et_supp_restr_extclass_kernel iW (Limits.pullback.snd iW f) f
    D Ef D' γ hγ
  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D')) (wcEtSuppUnitMap D')
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hπ'
  have h1 := hnat hS hS' k x₀
  have h2 := h1.symm.trans h0
  obtain ⟨β, hβ⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS'
    (SheafOfModules.unit (wcEtZModRing W' ℓ)) _ (add_comm 1 k) h2
  refine ⟨β, fun Dw Dg' => ?_⟩

  haveI : IsOpenImmersion gO' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb inferInstance
  have hptw : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      fst ≫ f = snd ≫ g → ∀ t : P, f (fst t) = g (snd t) := by
    intro P A B S fst snd f g h t
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h]
  have hpts : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      IsPullback fst snd f g → ∀ (a : A) (b : B), f a = g b → ∃ t : P, fst t = a ∧ snd t = b := by
    intro P A B S fst snd f g h a b hab
    obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
    refine ⟨h.isoPullback.inv t, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2
  have hrange' : Set.range gO' = (Set.range (Limits.pullback.snd iW f))ᶜ := by
    ext y
    constructor
    · rintro ⟨t, rfl⟩ ⟨s, hs⟩
      have h1 : gO (w t) ∈ (Set.range iW)ᶜ := by rw [← hrange]; exact ⟨_, rfl⟩
      apply h1
      refine ⟨Limits.pullback.fst iW f s, ?_⟩
      rw [hptw hsq.w s, hs, ← hptw hpb.w t]
    · intro hy
      have hvy : f y ∈ (Set.range iW)ᶜ := by
        rintro ⟨z, hz⟩
        obtain ⟨s, -, hs⟩ := hpts hsq z y hz
        exact hy ⟨s, hs⟩
      rw [← hrange] at hvy
      obtain ⟨a, ha⟩ := hvy
