theorem wc_int_zmod_supp_kappa_exists {X S : Scheme.{u}} (i : X ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dh : wcHMPullData i ℓ) (hDh : wcHMPullCanonical Dh)
    (Dz : wcZModPullData i (ℓ ^ 1)) (hDz : wcZModPullCanonical Dz) :
    ∃ κ : wcIntSuppObj Dh ⟶
        (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ 1)).obj (wcZModSuppObj Dz),
      wcIntSuppπ Dh ≫ κ = wcUnitRestrict (wcIntZModRingSheafMap S ℓ 1) ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ 1)).map
          (wcZModSuppUnitMap Dz) :=
by
  classical



  suffices kg : ∀ {A B : Scheme.{u}} (i : A ⟶ B) (D : wcHMPullData i ℓ)
      (hD : wcHMPullCanonical D) (V : B.ProEt) (f : (wcIntUnit B ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι (wcIntSuppπ D)).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z ∈ Set.range i →
          (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0 by

    have h0 : Limits.kernel.ι (wcIntSuppπ Dh) ≫ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ 1) ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ 1)).map
          (wcZModSuppUnitMap Dz)) = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      induction W using Opposite.rec with
      | op V =>
      change ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom
        (((wcUnitRestrict (wcIntZModRingSheafMap S ℓ 1)).val.app (Opposite.op V)).hom
          (((Limits.kernel.ι (wcIntSuppπ Dh)).val.app (Opposite.op V)).hom x)) = 0
      generalize hkx : ((Limits.kernel.ι (wcIntSuppπ Dh)).val.app (Opposite.op V)).hom x = kx
      have hv := (kg i Dh hDh V kx).mp ⟨x, hkx⟩

      let ψ := ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ 1)).val.app (Opposite.op V)).hom
      have hψ1 : (show C(↥V.left, ULift.{u+1} (ZMod (ℓ ^ 1))) from
          ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = 1 := by
        have e : (show C(↥V.left, ULift.{u+1} (ZMod (ℓ ^ 1))) from (SheafOfModules.unitHomEquiv _
            (wcUnitRestrict (wcIntZModRingSheafMap S ℓ 1))).1 (Opposite.op V)) = 1 := by
          unfold wcUnitRestrict
          rw [Equiv.apply_symm_apply]
          rfl
        exact (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans e
      have hψ : (show C(↥V.left, ULift.{u+1} (ZMod (ℓ ^ 1))) from ψ kx) =
          ((wcIntZModRingSheafMap S ℓ 1).hom.app (Opposite.op V)).hom kx := by
        have hs := ψ.map_smul (kx : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op V))
          (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
        have e1 := (congrArg ψ (mul_one (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from kx)).symm).trans hs
        refine e1.trans ?_
        show (show C(↥V.left, ULift.{u+1} (ZMod (ℓ ^ 1))) from
            ((wcIntZModRingSheafMap S ℓ 1).hom.app (Opposite.op V)).hom kx) *
          (show C(↥V.left, ULift.{u+1} (ZMod (ℓ ^ 1))) from
            ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = _
        rw [hψ1, mul_one]

      obtain ⟨s, hs⟩ : ∃ s : C(↥V.left, ULift.{u+1} (ZMod (ℓ ^ 1))),
          s = ((wcIntZModRingSheafMap S ℓ 1).hom.app (Opposite.op V)).hom kx := ⟨_, rfl⟩
      have hsz : s.comp (Limits.pullback.fst V.hom i).base.hom = 0 := by
        apply ContinuousMap.ext
        intro p
        have hp : V.hom (Limits.pullback.fst V.hom i p) ∈ Set.range i := by
          refine ⟨Limits.pullback.snd V.hom i p, ?_⟩
          have e : V.hom (Limits.pullback.fst V.hom i p) = i (Limits.pullback.snd V.hom i p) := by
            rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
          exact e.symm
        have h2 : ((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from kx)
            (Limits.pullback.fst V.hom i p)).down = 0 := congrArg ULift.down (hv _ hp)
        rw [ContinuousMap.zero_apply, ContinuousMap.comp_apply, hs]
        change ULift.up (PadicInt.toZModPow (p := ℓ) 1
          ((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from kx) (Limits.pullback.fst V.hom i p)).down) = 0
        rw [h2, map_zero]
        rfl

      have hu : (show C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod (ℓ ^ 1))) from
          ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom s) = 0 := by
        let m1 : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod (ℓ ^ 1))) :=
          ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom
            (1 : C(↥V.left, ULift.{u+1} (ZMod (ℓ ^ 1))))
        let φs : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod (ℓ ^ 1))) :=
          (Dz.φ.hom.app (Opposite.op V)).hom s
        have hφ : φs = s.comp (Limits.pullback.fst V.hom i).base.hom := hDz V s
        have h := ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom.map_smul s
