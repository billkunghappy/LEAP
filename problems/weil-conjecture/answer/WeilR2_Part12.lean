theorem ext_ses_coeff_kernel_torsion {C : Type*} [Category C] [Abelian C] [HasExt C]
    {S : ShortComplex C} (hS : S.ShortExact) {Y Y' : C} (g : Y ⟶ Y') (ℓ n : ℕ)
    (k₂ : ∀ x : Abelian.Ext S.X₂ Y n, x.comp (Abelian.Ext.mk₀ g) (add_zero n) = 0 →
      ∃ e : ℕ, (ℓ ^ e : ℕ) • x = 0)
    (k₁ : ∀ n₀ : ℕ, n₀ + 1 = n → ∀ x : Abelian.Ext S.X₁ Y n₀,
      x.comp (Abelian.Ext.mk₀ g) (add_zero n₀) = 0 → ∃ e : ℕ, (ℓ ^ e : ℕ) • x = 0)
    (q₂ : ∀ n₀ : ℕ, n₀ + 1 = n → ∀ w : Abelian.Ext S.X₂ Y' n₀,
      ∃ (b : ℕ) (w₀ : Abelian.Ext S.X₂ Y n₀),
        (ℓ ^ b : ℕ) • w = w₀.comp (Abelian.Ext.mk₀ g) (add_zero n₀)) :
    ∀ y : Abelian.Ext S.X₃ Y n, y.comp (Abelian.Ext.mk₀ g) (add_zero n) = 0 →
      ∃ e : ℕ, (ℓ ^ e : ℕ) • y = 0 :=
by
  have cnsmul : ∀ {A B Z : C} {p q r : ℕ} (α : Abelian.Ext A B p) (β : Abelian.Ext B Z q)
      (h : p + q = r) (N : ℕ), α.comp (N • β) h = N • α.comp β h :=
    fun α β h N => map_nsmul (α.precomp _ h) N β
  have nsmulc : ∀ {A B Z : C} {p q r : ℕ} (α : Abelian.Ext A B p) (β : Abelian.Ext B Z q)
      (h : p + q = r) (N : ℕ), (N • α).comp β h = N • α.comp β h :=
    fun α β h N => map_nsmul (β.postcomp _ h) N α
  have csub : ∀ {A B Z : C} {p q r : ℕ} (α : Abelian.Ext A B p) (β β' : Abelian.Ext B Z q)
      (h : p + q = r), α.comp (β - β') h = α.comp β h - α.comp β' h :=
    fun α β β' h => map_sub (α.precomp _ h) β β'
  have subc : ∀ {A B Z : C} {p q r : ℕ} (α α' : Abelian.Ext A B p) (β : Abelian.Ext B Z q)
      (h : p + q = r), (α - α').comp β h = α.comp β h - α'.comp β h :=
    fun α α' β h => map_sub (β.postcomp _ h) α α'
  intro y hy
  have hx : ((Abelian.Ext.mk₀ S.g).comp y (zero_add n)).comp (Abelian.Ext.mk₀ g)
      (add_zero n) = 0 := by
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hy, Abelian.Ext.comp_zero]
  obtain ⟨a, ha⟩ := k₂ _ hx
  have h2 : (Abelian.Ext.mk₀ S.g).comp ((ℓ ^ a : ℕ) • y) (zero_add n) = 0 := by
    rw [cnsmul]; exact ha
  cases n with
  | zero =>
    refine ⟨a, ?_⟩
    have := hS.epi_g
    apply Abelian.Ext.precomp_mk₀_injective_of_epi Y S.g
    rw [map_zero]
    exact h2
  | succ n₀ =>
    have hn : 1 + n₀ = n₀ + 1 := by omega
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS Y _ h2 hn
    have h5 : hS.extClass.comp (x₁.comp (Abelian.Ext.mk₀ g) (add_zero n₀)) hn = 0 := by
      rw [← Abelian.Ext.comp_assoc_of_third_deg_zero, hx₁, nsmulc, hy, smul_zero]
    obtain ⟨w, hw⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS Y' _ hn h5
    obtain ⟨b, w₀, hw₀⟩ := q₂ n₀ rfl w
    obtain ⟨x₁', hx₁'⟩ : ∃ z : Abelian.Ext S.X₁ Y n₀,
        z = (ℓ ^ b : ℕ) • x₁ - (Abelian.Ext.mk₀ S.f).comp w₀ (zero_add n₀) := ⟨_, rfl⟩
    have h7 : x₁'.comp (Abelian.Ext.mk₀ g) (add_zero n₀) = 0 := by
      rw [hx₁', subc, nsmulc, ← hw, ← cnsmul, hw₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, sub_self]
    obtain ⟨c, hc⟩ := k₁ n₀ rfl x₁' h7
    have h9 : hS.extClass.comp x₁' hn = (ℓ ^ b : ℕ) • ((ℓ ^ a : ℕ) • y) := by
      rw [hx₁', csub, cnsmul, hx₁, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
        hS.extClass_comp, Abelian.Ext.zero_comp, sub_zero]
    refine ⟨a + b + c, ?_⟩
    have e : (ℓ ^ (a + b + c) : ℕ) • y = (ℓ ^ c : ℕ) • ((ℓ ^ b : ℕ) • ((ℓ ^ a : ℕ) • y)) := by
      rw [smul_smul, smul_smul]
      congr 1
      ring
    rw [e, ← h9, ← cnsmul, hc, Abelian.Ext.comp_zero]

theorem wc_int_supp_unit_restrict_ker_torsion_qc {S T : Scheme.{u}} (iT : T ⟶ S)
    [IsClosedImmersion iT] [CompactSpace S] [QuasiSeparatedSpace S]
    (hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ S), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range iT ↔ ∃ k, x ∈ W.basicOpen (f k)))
    (O : S.Opens) (hO : (O : Set S) = (Set.range iT)ᶜ) (hOc : CompactSpace ↥O.toScheme)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (DT : wcHMPullData iT ℓ) (hDT : wcHMPullCanonical DT) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    ∀ y : Abelian.Ext (wcIntSuppObj DT) (wcIntUnit S ℓ) n,
      y.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n) = 0 →
      ∃ e : ℕ, (ℓ ^ e : ℕ) • y = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  intro y hy

  have htfΛ : ∀ (V : (S.ProEt)ᵒᵖ) (m : ℕ)
      (r : ↑((wcIntRingSheaf S ℓ).obj.obj V)), m ≠ 0 → m • r = 0 → r = 0 := by
    intro V m r hm hr
    have key : ∀ (T' : Type u) [TopologicalSpace T'] (s : C(T', ULift.{u+1} ℤ_[ℓ])),
        m • s = 0 → s = 0 := by
      intro T' _ s hs
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      let g : C(T', ULift.{u+1} ℤ_[ℓ]) →+ ℤ_[ℓ] := AddEquiv.ulift.toAddMonoidHom.comp
        ((Pi.evalAddMonoidHom (fun _ : T' => ULift.{u+1} ℤ_[ℓ]) t).comp
          ContinuousMap.coeFnAddMonoidHom)
      have h1 : m • g s = 0 := ((map_nsmul g m s).symm.trans (congrArg g hs)).trans (map_zero g)
      rw [nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hm)
    exact key ↥((Opposite.unop V).left) r hr
  obtain ⟨LAb, adjΛ, hLA, hLL, hLC⟩ :=
    sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree
      (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ) htfΛ
  haveI := hLA
  haveI := hLL
  haveI := hLC

  have hK := fun V f => wc_int_supp_kernel_sections_gen ℓ iT DT hDT V f
  have hcov := fun U k W g hW =>
    wc_int_kernel_section_local_cover_qc iT ℓ hqc (wcIntSuppπ DT) hK U k W g hW
  obtain ⟨ε₀, h, hex⟩ :=
    wc_int_kernel_free_of_local_cover ℓ (Set.range iT) (wcIntSuppπ DT) hK hcov LAb adjΛ O hO
  haveI hm1 : Mono (wcFreeSheafMap S (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
      Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S))) :=
    wc_free_sheaf_map_mono S _ _ _ (show Mono O.ι by infer_instance)
  have hmono : Mono (LAb.map (wcFreeSheafMap S (MorphismProperty.Over.homMk O.ι
      (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S))) ≫ ε₀.hom) :=
    inferInstance
  have hepi : Epi (wcIntSuppπ DT) := by
    unfold wcIntSuppπ
    infer_instance
  have hSC := ShortComplex.ShortExact.mk' hex hmono hepi

  haveI : CompactSpace (Scheme.ProEt.mk O.ι).left := hOc
  haveI : QuasiSeparatedSpace (Scheme.ProEt.mk O.ι).left :=
    QuasiSeparatedSpace.of_isOpenEmbedding O.ι.isOpenEmbedding
  haveI : CompactSpace (Scheme.ProEt.mk (𝟙 S)).left := ‹CompactSpace S›
  haveI : QuasiSeparatedSpace (Scheme.ProEt.mk (𝟙 S)).left := ‹QuasiSeparatedSpace S›

  have hback : ∀ {M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} {m : ℕ}
      (z : Abelian.Ext (wcIntUnit S ℓ) M m),
      (Abelian.Ext.mk₀ ε₀.inv).comp ((Abelian.Ext.mk₀ ε₀.hom).comp z (zero_add m)) (zero_add m) =
        z := by
    intro M m z
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]
  have hsm : ∀ {M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} {m : ℕ} (c : ℕ)
      (z : Abelian.Ext (wcIntUnit S ℓ) M m),
      (Abelian.Ext.mk₀ ε₀.hom).comp (c • z) (zero_add m) =
        c • (Abelian.Ext.mk₀ ε₀.hom).comp z (zero_add m) := by
    intro M m c z
    exact map_nsmul ((Abelian.Ext.mk₀ ε₀.hom).precomp M (zero_add m)) c z
  have k₂ : ∀ x : Abelian.Ext (wcIntUnit S ℓ) (wcIntUnit S ℓ) n,
      x.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n) = 0 →
      ∃ e : ℕ, (ℓ ^ e : ℕ) • x = 0 := by
    intro x hx
    have hx' : ((Abelian.Ext.mk₀ ε₀.hom).comp x (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n) = 0 := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, hx, Abelian.Ext.comp_zero]
    obtain ⟨e, he⟩ := (wc_int_free_qcqs_unit_restrict_rational S (Scheme.ProEt.mk (𝟙 S)) ℓ
      LAb adjΛ n).2 _ hx'
    refine ⟨e, ?_⟩
    rw [← hback ((ℓ ^ e : ℕ) • x), hsm, he, Abelian.Ext.comp_zero]
  have q₂ : ∀ n₀ : ℕ, n₀ + 1 = n → ∀ w : Abelian.Ext (wcIntUnit S ℓ)
      ((SheafOfModules.restrictScalars (wcIntRatRingSheafMap S ℓ)).obj
        (SheafOfModules.unit (wcRingSheaf S ℓ))) n₀,
      ∃ (b : ℕ) (w₀ : Abelian.Ext (wcIntUnit S ℓ) (wcIntUnit S ℓ) n₀),
        (ℓ ^ b : ℕ) • w = w₀.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)))
          (add_zero n₀) := by
    intro n₀ _ w
    obtain ⟨b, w₀', hw⟩ := (wc_int_free_qcqs_unit_restrict_rational S (Scheme.ProEt.mk (𝟙 S)) ℓ
      LAb adjΛ n₀).1 ((Abelian.Ext.mk₀ ε₀.hom).comp w (zero_add n₀))
    refine ⟨b, (Abelian.Ext.mk₀ ε₀.inv).comp w₀' (zero_add n₀), ?_⟩
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, ← hw, ← hsm, hback]
  have k₁ : ∀ n₀ : ℕ, n₀ + 1 = n →
      ∀ x : Abelian.Ext (LAb.obj (wcFreeSheaf S (Scheme.ProEt.mk O.ι))) (wcIntUnit S ℓ) n₀,
      x.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n₀) = 0 →
      ∃ e : ℕ, (ℓ ^ e : ℕ) • x = 0 := fun n₀ _ x hx =>
    (wc_int_free_qcqs_unit_restrict_rational S (Scheme.ProEt.mk O.ι) ℓ LAb adjΛ n₀).2 x hx

  exact ext_ses_coeff_kernel_torsion hSC (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)) ℓ n
    k₂ k₁ q₂ y hy

theorem wc_smooth_pair_int_supp_rat_restrict (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∃ ratY : Abelian.Ext (wcIntSuppObj Di) (wcIntUnit Y ℓ) (2 * r) →+ wcSuppExt Di (2 * r),
      ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
        (k : Spec R ⟶ Y), WeaklyEtale k → k (IsLocalRing.closedPoint R) ∈ Set.range i →
        ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z), IsPullback g iT i k →
        ∀ (Dk : wcHMPullData k ℓ) (_ : wcHMPullCanonical Dk)
          (DT : wcHMPullData iT ℓ) (_ : wcHMPullCanonical DT), Epi (wcSuppUnitMap DT) →
        ∀ (γ : wcSuppObj DT ⟶ Dk.Φ.obj (wcSuppObj Di)),
          wcSuppUnitMap DT ≫ γ = Dk.μ.inv ≫ Dk.Φ.map (wcSuppUnitMap Di) →
        ∀ (DΛ : wcIntPullData k ℓ) (_ : wcIntPullCanonical DΛ)
          (γΛ : wcIntSuppObj DT ⟶ DΛ.Φ.obj (wcIntSuppObj Di)),
          wcIntSuppπ DT ≫ γΛ = DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ Di) →
          letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
          letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
          ∃ ratR : Abelian.Ext (wcIntSuppObj DT) (wcIntUnit (Spec R) ℓ) (2 * r) →+
              wcSuppExt DT (2 * r),
            (∀ y, ratR y = 0 → ∃ e : ℕ, (ℓ ^ e : ℕ) • y = 0) ∧
            ∀ θ : Abelian.Ext (wcIntSuppObj Di) (wcIntUnit Y ℓ) (2 * r),
              ratR ((Abelian.Ext.mk₀ γΛ).comp (wcIntSuppPullExt Di DΛ (2 * r) θ) (zero_add _)) =
                (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Di Dk (2 * r) (ratY θ)) (zero_add _) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  obtain ⟨EY, hEY⟩ := wc_int_rat_data_exists Y ℓ
  have hepiY : Epi (wcSuppUnitMap Di) := wc_supp_unit_epi_of_closed i ℓ Di hDi
  obtain ⟨εY, -, hεY⟩ := wc_int_supp_rat_eps ℓ Di hepiY EY hEY
  refine ⟨wcIntSuppRat Di EY εY (2 * r), ?_⟩
  intro R _ _ k hk hz T iT g hP Dk hDk DT hDT hepi γ hγ DΛ hDΛ γΛ hγΛ
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
  obtain ⟨ER, hER⟩ := wc_int_rat_data_exists (Spec R) ℓ
  obtain ⟨εR, hεRi, hεR⟩ := wc_int_supp_rat_eps ℓ DT hepi ER hER
  haveI := hεRi
  refine ⟨wcIntSuppRat DT ER εR (2 * r), ?_, ?_⟩
  ·
    intro y hy
    have h0 : (Abelian.Ext.mk₀ εR).comp (wcIntRatExt ER (wcIntSuppObj DT) (2 * r) y)
        (zero_add _) = 0 := hy
    have hw : wcIntRatExt ER (wcIntSuppObj DT) (2 * r) y = 0 := by
      have h1 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (inv εR))
        (Abelian.Ext.mk₀ εR) (wcIntRatExt ER (wcIntSuppObj DT) (2 * r) y) (zero_add (2 * r))
      rw [Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp, h0] at h1
      rw [h1, Abelian.Ext.comp_zero]
    have hyj := (wc_int_rat_ext_eq_zero_iff (Spec R) ℓ ER hER (wcIntSuppObj DT) (2 * r) y).mp hw
    haveI : IsClosedImmersion iT :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP inferInstance
    have hrc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
    obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ := ⟨⟨_, hrc.isOpen_compl⟩, rfl⟩
    have hrangeT : Set.range iT = k ⁻¹' Set.range i := by
      rw [← Scheme.Pullback.range_snd i k]
      ext x
      constructor
      · rintro ⟨t, rfl⟩
        refine ⟨hP.isoPullback.hom t, ?_⟩
        have h := Scheme.Hom.comp_apply hP.isoPullback.hom (Limits.pullback.snd i k) t
        rw [hP.isoPullback_hom_snd] at h
        exact h.symm
      · rintro ⟨t, rfl⟩
        refine ⟨hP.isoPullback.inv t, ?_⟩
        have h := Scheme.Hom.comp_apply hP.isoPullback.inv iT t
        rw [hP.isoPullback_inv_snd] at h
        exact h.symm
    have hWo : ((k ⁻¹ᵁ U : (Spec R).Opens) : Set (Spec R)) = (Set.range iT)ᶜ := by
      rw [hrangeT, Scheme.Hom.coe_preimage, hU, Set.preimage_compl]
    have hPU := isPullback_morphismRestrict k U
    have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Spec R), ∃ (N : ℕ) (f : Fin N → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range iT ↔ ∃ a, x ∈ W.basicOpen (f a)) := by
      intro W _ p
      obtain ⟨N, f, hf⟩ := wc_affine_complement_basicOpen_cover i W (p ≫ k)
      refine ⟨N, f, fun x => ?_⟩
      rw [← hf x, hrangeT, Set.mem_preimage, Scheme.Hom.comp_apply]
    haveI : QuasiCompact (k ⁻¹ᵁ U).ι :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) hPU inferInstance
    have hOc : CompactSpace ↥(k ⁻¹ᵁ U).toScheme :=
      QuasiCompact.compactSpace_of_compactSpace (k ⁻¹ᵁ U).ι
    exact wc_int_supp_unit_restrict_ker_torsion_qc iT hqc (k ⁻¹ᵁ U) hWo hOc ℓ DT hDT (2 * r) y hyj
  ·
    obtain ⟨ν⟩ := wc_int_rat_pull_left_adjoint_iso ℓ k Dk hDk DΛ hDΛ EY ER
    exact fun θ => wc_int_supp_rat_pull_square ℓ Di DT Dk DΛ EY ER εY hεY εR hεR hepi γ hγ γΛ hγΛ
      ν (wc_ring_unit_end_natTrans (Spec R) ℓ) (2 * r) θ

theorem wc_smooth_pair_int_supp_base_change (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    ∀ (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
      (k : Spec R ⟶ Y), WeaklyEtale k → k (IsLocalRing.closedPoint R) ∈ Set.range i →
      ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z), IsPullback g iT i k →
      ∀ (DT : wcHMPullData iT ℓ), wcHMPullCanonical DT → Epi (wcSuppUnitMap DT) →
      ∃ (DΛ : wcIntPullData k ℓ) (_ : wcIntPullCanonical DΛ)
        (γΛ : wcIntSuppObj DT ⟶ DΛ.Φ.obj (wcIntSuppObj Di)),
        wcIntSuppπ DT ≫ γΛ = DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ Di) :=
by
  classical
  intro R _ _ k hk hz T iT g hP DT hDT hepi
  obtain ⟨DΛ, hDΛ⟩ := wc_int_pull_data_exists k ℓ
  let V : Y.ProEt := MorphismProperty.Over.mk ⊤ k hk
  obtain ⟨hc, -, -⟩ := wc_lpsc_site Y V
  haveI := hc

  have hiso : Nonempty (DΛ.Φ ≅ wcIntSliceRes Y ℓ V) := by
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong V.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    let adj₀ : wcSliceFunctor Y V ⊣ wcProEtBC V.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ V.left Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ V.hom _ _ _ V.prop trivial
    have hc' : ∀ W : Y.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom V.hom :=
      fun W => rfl
    have hu : ∀ W' : V.left.ProEt, (adj₀.unit.app W').left ≫
        Limits.pullback.fst ((wcSliceFunctor Y V).obj W').hom V.hom = 𝟙 W'.left :=
      fun W' => Limits.pullback.lift_fst _ _ _
    have hj : (wcSliceFunctor Y V).IsContinuous (Scheme.ProEt.topology V.left)
        (Scheme.ProEt.topology Y) := inferInstance
    letI := DΛ.cont
    have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcIntRingSheaf Y ℓ).obj =
        DΛ.φ.hom ≫ (wcProEtBC V.hom).op.whiskerLeft
          (𝟙 (wcIntRingSheaf V.left ℓ) : wcIntRingSheaf V.left ℓ ⟶
            ((wcSliceFunctor Y V).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology Y)).obj
              (wcIntRingSheaf Y ℓ)).hom := by
      ext V' s
      obtain ⟨W⟩ := V'
      show s.comp (adj₀.counit.app W).left.base.hom = (DΛ.φ.hom.app (Opposite.op W)).hom s
      rw [hDΛ W s, hc' W]
      try rfl
    have H2 : (𝟙 (wcIntRingSheaf V.left ℓ) : wcIntRingSheaf V.left ℓ ⟶
            ((wcSliceFunctor Y V).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology Y)).obj
              (wcIntRingSheaf Y ℓ)).hom ≫
        (wcSliceFunctor Y V).op.whiskerLeft DΛ.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj₀.unit) (wcIntRingSheaf V.left ℓ).obj =
        𝟙 (wcIntRingSheaf V.left ℓ).obj := by
      ext V' t
      obtain ⟨W'⟩ := V'
      show ((DΛ.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W'))).hom t).comp
          (adj₀.unit.app W').left.base.hom = t
      refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
        (hDΛ ((wcSliceFunctor Y V).obj W') t)).trans ?_
      have key : ∀ t : C(↥W'.left, ULift.{u+1} ℤ_[ℓ]),
          ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
            ((wcSliceFunctor Y V).obj W').hom V.hom).base.hom)
            (adj₀.unit.app W').left.base.hom = t := by
        intro t
        first
        | (rw [ContinuousMap.comp_assoc, ← TopCat.hom_comp, ← Scheme.Hom.comp_base, hu W',
            Scheme.Hom.id_base, TopCat.hom_id, ContinuousMap.comp_id])
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
           simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
      exact key t
    exact ⟨Adjunction.leftAdjointUniq DΛ.adj
      (@SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hj DΛ.cont adj₀ _ DΛ.φ H1 H2)⟩
  obtain ⟨θ⟩ := hiso

  have hgval : ∀ {A B : Scheme.{u}} {j : A ⟶ B} (D : wcHMPullData j ℓ), wcHMPullCanonical D →
      ∀ (W : B.ProEt) (f : (wcIntUnit B ℓ).val.obj (Opposite.op W))
        (p : ↥(Limits.pullback W.hom j)),
      (show C(↥(Limits.pullback W.hom j), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap D).val.app (Opposite.op W)).hom f) p =
      ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from f)
          (Limits.pullback.fst W.hom j p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
        wcSuppTwist (wcSuppUnitMap D) (Limits.pullback.snd W.hom j p) := by
    intro A B j D hD W f p
    let ψ := ((wcUnitRestrict (wcIntRatRingSheafMap B ℓ)).val.app (Opposite.op W)).hom
    have hψ1 : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
        ψ (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))) = 1 := by
      have e : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from (SheafOfModules.unitHomEquiv _
          (wcUnitRestrict (wcIntRatRingSheafMap B ℓ))).1 (Opposite.op W)) = 1 := by
        unfold wcUnitRestrict
        rw [Equiv.apply_symm_apply]
        rfl
      exact (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans e
    have hψ : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from ψ f) =
        ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op W)).hom f := by
      have hs := ψ.map_smul (f : (wcIntRingSheaf B ℓ).obj.obj (Opposite.op W))
        (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))
      have e1 := (congrArg ψ (mul_one (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from f)).symm).trans hs
      refine e1.trans ?_
      show (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
          ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op W)).hom f) *
        (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from ψ (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))) = _
      rw [hψ1, mul_one]
    have e : (show C(↥(Limits.pullback W.hom j), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap D).val.app (Opposite.op W)).hom f) =
        (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
          ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op W)).hom f).comp
            (Limits.pullback.fst W.hom j).base.hom *
          (wcSuppTwist (wcSuppUnitMap D)).comp (Limits.pullback.snd W.hom j).base.hom := by
      refine (wc_supp_hom_twist_formula D hD (wcSuppUnitMap D) W
        (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from ψ f)).trans ?_
      rw [hψ]
    rw [e]
    rfl

  have hvan : ∀ (W : (Spec R).ProEt) (t : (wcIntUnit (Spec R) ℓ).val.obj (Opposite.op W)),
      ((wcIntSuppMap DT).val.app (Opposite.op W)).hom t = 0 →
      ∀ w : ↥W.left, W.hom w ∈ Set.range iT →
        (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t) w = 0 := by
    intro W t h0 w hw
    have hw' : w ∈ Set.range (Limits.pullback.fst W.hom iT) := by
      rw [Scheme.Pullback.range_fst]; exact hw
    obtain ⟨p, rfl⟩ := hw'
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit DT
    have h1 := hgval DT hDT W t p
    rw [h0] at h1
    have h2 := congrArg (fun φ : C(↥T, ULift.{u+1} ℚ_[ℓ]) => φ (Limits.pullback.snd W.hom iT p)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.one_apply] at h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          (Limits.pullback.fst W.hom iT p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
        wcSuppTwist (wcSuppUnitMap DT) (Limits.pullback.snd W.hom iT p) := h1
    have h3 : ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          (Limits.pullback.fst W.hom iT p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) = (0 : ULift.{u+1} ℚ_[ℓ]) := by
      linear_combination (-(c' (Limits.pullback.snd W.hom iT p))) * h1' -
        (ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          (Limits.pullback.fst W.hom iT p)).down : ℤ_[ℓ]) : ℚ_[ℓ])) * h2
    exact ULift.ext _ _ (PadicInt.coe_eq_zero.mp (congrArg ULift.down h3))

  have hT : ∀ y : ↥(Spec R), k y ∈ Set.range i → y ∈ Set.range iT := by
    rintro y ⟨x, hx⟩
    obtain ⟨p, -, hp⟩ := Scheme.Pullback.exists_preimage_pullback (f := i) (g := k) x y hx
    refine ⟨hP.isoPullback.inv p, ?_⟩
    rw [← Scheme.Hom.comp_apply hP.isoPullback.inv iT p, IsPullback.isoPullback_inv_snd]
    exact hp

  have hsec : ∀ (μ' : wcIntUnit V.left ℓ ⟶ (wcIntSliceRes Y ℓ V).obj (wcIntUnit Y ℓ))
      (W : V.left.ProEt) (t : C(↥W.left, ULift.{u+1} ℤ_[ℓ])),
      ((wcIntSuppMap DT).val.app (Opposite.op W)).hom t = 0 →
      (((wcIntSliceRes Y ℓ V).map (wcIntSuppMap Di)).val.app (Opposite.op W)).hom
        ((μ'.val.app (Opposite.op W)).hom t) = 0 := by
    intro μ' W t h0
    have hsm1 := (μ'.val.app (Opposite.op W)).hom.map_smul t
      (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))
    have hsm2 := (((wcIntSliceRes Y ℓ V).map (wcIntSuppMap Di)).val.app (Opposite.op W)).hom.map_smul t
      ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ])))
    refine ((congrArg (((wcIntSliceRes Y ℓ V).map (wcIntSuppMap Di)).val.app (Opposite.op W)).hom
      ((congrArg (μ'.val.app (Opposite.op W)).hom (mul_one t).symm).trans hsm1)).trans
        hsm2).trans ?_
    have hφ : (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
        ((Di.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom
          (((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t))) =
        0 := by
      refine (hDi ((wcSliceFunctor Y V).obj W) _).trans (ContinuousMap.ext fun z => ?_)
      have hz : W.hom ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z) ∈
          Set.range iT := by
        apply hT
        exact ⟨(Limits.pullback.snd ((wcSliceFunctor Y V).obj W).hom i).base z,
          (congrArg (fun φ => φ.base z)
            (Limits.pullback.condition (f := ((wcSliceFunctor Y V).obj W).hom) (g := i))).symm⟩
      have htw : (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z) = 0 :=
        hvan W t h0 _ hz
      show ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z)).down : ℤ_[ℓ]) :
            ℚ_[ℓ]) = 0
      rw [htw]
      rfl
    calc _ = (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((Di.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom
            (((wcIntRatRingSheafMap Y ℓ).hom.app
              (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t))) *
        (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((((wcIntSliceRes Y ℓ V).map (wcIntSuppMap Di)).val.app (Opposite.op W)).hom
            ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))))) := rfl
      _ = 0 := by rw [hφ, zero_mul]

  have gen : ∀ {G : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ) ⥤
        SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)} (θ' : DΛ.Φ ≅ G)
      {A B : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} (f : A ⟶ B)
      {X : SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)} (κ : X ⟶ DΛ.Φ.obj A),
      κ ≫ θ'.hom.app A ≫ G.map f = 0 → κ ≫ DΛ.Φ.map f = 0 := by
    intro G θ' A B f X κ h
    calc κ ≫ DΛ.Φ.map f = (κ ≫ θ'.hom.app A ≫ G.map f) ≫ θ'.inv.app B := by
          rw [Category.assoc, Category.assoc, NatIso.naturality_2]
      _ = 0 := by rw [h, Limits.zero_comp]
  have hKT : Limits.kernel.ι (wcIntSuppπ DT) ≫ wcIntSuppMap DT = 0 :=
    (congrArg (fun h => Limits.kernel.ι (wcIntSuppπ DT) ≫ h)
      (Limits.image.fac (wcIntSuppMap DT))).symm.trans
      ((Limits.kernel.condition_assoc _ _).trans Limits.zero_comp)
  have hK1 : Limits.kernel.ι (wcIntSuppπ DT) ≫ DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppMap Di) = 0 := by
    rw [← Category.assoc]
    refine gen θ (wcIntSuppMap Di) (Limits.kernel.ι (wcIntSuppπ DT) ≫ DΛ.μ.inv) ?_
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction W using Opposite.rec with
    | op W =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom x) hKT
    change ((wcIntSuppMap DT).val.app (Opposite.op W)).hom
      (((Limits.kernel.ι (wcIntSuppπ DT)).val.app (Opposite.op W)).hom x) = 0 at hk
    have h1 := hsec (DΛ.μ.inv ≫ θ.hom.app (wcIntUnit Y ℓ)) W _ hk
    refine Eq.trans h1 ?_
    first
      | rfl
      | (simp only [SheafOfModules.zero_val, PresheafOfModules.zero_app, ModuleCat.hom_zero,
          LinearMap.zero_apply]; done)
      | (rw [SheafOfModules.zero_val]; rfl)
      | simp
      | exact (LinearMap.zero_apply x).symm
  haveI := DΛ.additive
  haveI := DΛ.presLim
  haveI hm : Mono (DΛ.Φ.map (Limits.image.ι (wcIntSuppMap Di))) := inferInstance
  have hK : Limits.kernel.ι (wcIntSuppπ DT) ≫ DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ Di) = 0 := by
    apply (cancel_mono (DΛ.Φ.map (Limits.image.ι (wcIntSuppMap Di)))).mp
    rw [Limits.zero_comp, Category.assoc, Category.assoc, ← Functor.map_comp, Limits.image.fac]
    exact hK1
  haveI : Epi (wcIntSuppπ DT) := inferInstance
  exact ⟨DΛ, hDΛ, Abelian.epiDesc (wcIntSuppπ DT) (DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ Di)) hK,
    Abelian.comp_epiDesc _ _ _⟩

theorem wc_int_open_part_divisible_gen {S : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Tset : Set S) {P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (π : wcIntUnit S ℓ ⟶ P)
    (hK : ∀ (V : S.ProEt) (f : (wcIntUnit S ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι π).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z ∈ Tset → (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (VU : S.ProEt) (hVUo : IsOpenImmersion VU.hom) (hVU : Set.range VU.hom = Tsetᶜ)
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf S ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] :
    ∃ j : L.obj (wcFreeSheaf S VU) ⟶ Limits.kernel π,
      Mono j ∧ ∀ k : ℕ, IsIso ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) :=
by
  classical

  have hEpi : ∀ (Jm : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
      (j : Jm ⟶ Limits.kernel π)
      (hloc : ∀ (W : S.ProEt) (a : W ⟶ VU)
          (f : (wcIntUnit S ℓ).val.obj (Opposite.op W)),
        ∃ t : Jm.val.obj (Opposite.op W),
          ((Limits.kernel.ι π).val.app (Opposite.op W)).hom
            ((j.val.app (Opposite.op W)).hom t) = f)
      (k : ℕ), Epi ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) := by
    intro Jm j hloc k

    have s3 : ∀ n : ℕ, (∀ (W : S.ProEt)
        (y : (Limits.kernel π).val.obj (Opposite.op W)),
        ∃ (y' : (Limits.kernel π).val.obj (Opposite.op W)) (Sv : Sieve W),
          Sv ∈ Scheme.ProEt.topology S W ∧
          ∀ (W' : S.ProEt) (e : W' ⟶ W), Sv.arrows e →
            ∃ t : Jm.val.obj (Opposite.op W'),
              (j.val.app (Opposite.op W')).hom t =
                ((Limits.kernel π).val.map e.op).hom (y - n • y')) →
        Epi (n • 𝟙 (Limits.cokernel j)) := by
      intro n h
      have hnsmul : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (f : A ⟶ B)
          (n : ℕ) (W : (S.ProEt)ᵒᵖ) (x : A.val.obj W),
          ((n • f).val.app W).hom x = n • (f.val.app W).hom x := by
        intro A B f n W x
        induction n with
        | zero => rw [zero_nsmul, zero_nsmul]; rfl
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app,
            ModuleCat.hom_add, LinearMap.add_apply, ih]
      apply Preadditive.epi_of_cancel_zero
      intro T g hg
      rw [Preadditive.nsmul_comp, Category.id_comp] at hg
      have hng : ∀ (W : (S.ProEt)ᵒᵖ) (q : (Limits.cokernel j).val.obj W),
          n • (g.val.app W).hom q = 0 := by
        intro W q
        rw [← hnsmul, hg]
        rfl
      set φ := Limits.cokernel.π j ≫ g with hφdef
      have hjφ : j ≫ φ = 0 := by rw [hφdef, Limits.cokernel.condition_assoc, Limits.zero_comp]
      have hsep := T.isSheaf.isSeparated
      have hφ : φ = 0 := by
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro Xo
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro y
        obtain ⟨y', Sv, hSv, hlift⟩ := h Xo.unop y
        have hd : (φ.val.app Xo).hom (y - n • y') = 0 := by
          apply hsep Xo.unop Sv hSv
          intro Y f hf
          obtain ⟨t, ht⟩ := hlift Y f hf
          change (T.val.map f.op).hom ((φ.val.app Xo).hom (y - n • y')) =
            (T.val.map f.op).hom 0
          rw [map_zero, ← PresheafOfModules.naturality_apply, ← ht]
          change ((j ≫ φ).val.app (Opposite.op Y)).hom t = 0
          rw [hjφ]
          rfl
        have hy' : (φ.val.app Xo).hom (n • y') = 0 := by
          rw [map_nsmul]
          exact hng Xo _
        have hyy : y = (y - n • y') + n • y' := by abel
        change (φ.val.app Xo).hom y = 0
        rw [hyy, map_add, hd, hy', add_zero]
      exact (cancel_epi (Limits.cokernel.π j)).1 (by rw [← hφdef, hφ, Limits.comp_zero])

    have inj : ∀ V : S.ProEt,
        Function.Injective ((Limits.kernel.ι π).val.app (Opposite.op V)).hom := by
      intro V
      haveI := adj.isRightAdjoint
      have h1 : Mono ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map
          (Limits.kernel.ι π)) := Functor.map_mono _ _
      have h2 : Mono ((sheafToPresheaf _ _).map ((SheafOfModules.toSheaf
          (wcIntRingSheaf S ℓ)).map (Limits.kernel.ι π))) :=
        Functor.map_mono _ _
      have h3 := (NatTrans.mono_iff_mono_app _).1 h2 (Opposite.op V)
      exact (AddCommGrpCat.mono_iff_injective _).1 h3

    have s1 : ∀ {Y : Type u} [TopologicalSpace Y] (f : C(Y, ULift.{u+1} ℤ_[ℓ])),
        ∃ (A : Set Y) (g : C(Y, ULift.{u+1} ℤ_[ℓ])), IsClopen A ∧
          (∀ z, (f z).down = 0 → z ∈ A) ∧ (∀ z, (f z).down = 0 → (g z).down = 0) ∧
          (∀ z ∈ A, (f z).down = (ℓ : ℤ_[ℓ]) ^ k * (g z).down) ∧
          (∀ z, z ∉ A → (g z).down = 0) := by
      intro Y _ f
      set r : ℝ := (ℓ : ℝ) ^ (-(k : ℤ)) with hr
      have hℓpos : (0 : ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
      have hrpos : 0 < r := zpow_pos hℓpos _
      set B : Set ℤ_[ℓ] := Metric.closedBall 0 r with hB
      have hBc : IsClopen B := IsUltrametricDist.isClopen_closedBall 0 hrpos.ne'
      have hmemB : ∀ x : ℤ_[ℓ], x ∈ B ↔ x ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k} := by
        intro x
        rw [hB, mem_closedBall_zero_iff, hr]
        exact PadicInt.norm_le_pow_iff_mem_span_pow x k
      let D : ℤ_[ℓ] → ℤ_[ℓ] := fun x =>
        if h : x ∈ B then Classical.choose (Ideal.mem_span_singleton'.1 ((hmemB x).1 h)) else 0
      have hDspec : ∀ x ∈ B, D x * (ℓ : ℤ_[ℓ]) ^ k = x := by
        intro x hx
        simp only [D, dif_pos hx]
        exact Classical.choose_spec (Ideal.mem_span_singleton'.1 ((hmemB x).1 hx))
      have hDoff : ∀ x, x ∉ B → D x = 0 := by
        intro x hx
        simp only [D, dif_neg hx]
      have hℓk0 : ((ℓ : ℤ_[ℓ]) ^ k) ≠ 0 :=
        pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
      have hnormℓk : ‖((ℓ : ℤ_[ℓ]) ^ k)‖ = ((ℓ : ℝ) ^ k)⁻¹ := by
        rw [PadicInt.norm_p_pow, zpow_neg, zpow_natCast]
      have hLip : LipschitzOnWith ((ℓ : NNReal) ^ k) D B := by
        apply LipschitzOnWith.of_dist_le_mul
        intro x hx y hy
        rw [dist_eq_norm, dist_eq_norm]
        have e : x - y = (D x - D y) * (ℓ : ℤ_[ℓ]) ^ k := by
          rw [sub_mul, hDspec x hx, hDspec y hy]
        have e2 : ‖x - y‖ = ‖D x - D y‖ * ((ℓ : ℝ) ^ k)⁻¹ := by
