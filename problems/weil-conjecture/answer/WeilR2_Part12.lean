    have hTerm : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 E)) := by
      refine Limits.IsTerminal.ofUniqueHom
        (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial) ?_
      intro V g
      apply MorphismProperty.Over.Hom.ext
