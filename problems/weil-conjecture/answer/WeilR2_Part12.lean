      intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
      subst e
      rfl
    have hTn : ∀ k, wcContSheafMap E (wcTowerShift ℓ) hcont_shift ≫
        wcContSheafMap E (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ k)) k) (continuous_apply k) =
        wcContSheafMap E (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ k)) k) (continuous_apply k) -
        wcContSheafMap E (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ k)) (k + 1))
          (continuous_apply (k + 1)) ≫
        wcContSheafMap E (wcTowerCast ℓ k) continuous_of_discreteTopology := by
      intro k
      have e1 := (wc_contSheafMap_comp_sub E (wcTowerShift ℓ) (wcTowerShift ℓ) hcont_shift
        hcont_shift (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ k)) k) (continuous_apply k)).1
      have e2 := (wc_contSheafMap_comp_sub E
