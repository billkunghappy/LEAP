  obtain ⟨Dk, hDk⟩ := wc_zmod_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z) g) (ℓ ^ k)
  obtain ⟨ν, hν⟩ := wc_int_zmod_pull_restrict_iso ℓ (Limits.pullback.snd (W₀.fromSpecStalk z) g)
