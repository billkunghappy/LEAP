      (IsPullback.of_hasPullback (D₀.obj l).hom V.ι).flip
    obtain ⟨W', v', hv', ⟨w₀, hw₀⟩, kill⟩ := L1 (D₀.obj l).left (D₀.obj l).hom (D₀.obj l).prop
      (Limits.pullback (D₀.obj l).hom V.ι) (Limits.pullback.fst (D₀.obj l).hom V.ι)
