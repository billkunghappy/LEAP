        (zero_add q) =
      (Θ (Scheme.ProEt.mk O.ι) (βH (wcEtPull Dj q v))).comp (Abelian.Ext.mk₀ χ.hom) (add_zero q)
  rw [← Abelian.Ext.comp_assoc_of_third_deg_zero, hkey]

theorem wc_smooth_pair_local_zmod_codim_card_le_of_et (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ)
    (hD : ∀ D : wcEtPullData i ℓ,
      Finite (wcEtSuppExt D (2 * r)) ∧ Nat.card (wcEtSuppExt D (2 * r)) ≤ ℓ) :
    Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ 1)) (2 * r)) ∧
    Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ 1)) (2 * r)) ≤ ℓ :=
by
  classical
  let ιO : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  haveI hYln : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI hYc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI hYqs : QuasiSeparatedSpace Y := IsLocallyNoetherian.quasiSeparatedSpace
  haveI hOc : CompactSpace O.toScheme := QuasiCompact.compactSpace_of_compactSpace O.ι
  haveI hOln : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
  haveI hOqs : QuasiSeparatedSpace O.toScheme := IsLocallyNoetherian.quasiSeparatedSpace
  have hmono : Mono (wcFreeSheafMap Y ιO) :=
    wc_free_sheaf_map_mono Y _ _ ιO (IsOpenImmersion.mono O.ι)
  have hS₀ : (ShortComplex.mk (wcFreeSheafMap Y ιO) (Limits.cokernel.π (wcFreeSheafMap Y ιO))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  rw [pow_one]
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  obtain ⟨D₀⟩ := wc_et_zmod_pull_data_exists i ℓ
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists O.ι ℓ
  obtain ⟨L1, L2, L3⟩ := wc_et_supp_open_les i O hO ℓ D₀ Dj

  have A1 : ∀ (s k : ℕ) (h : 1 + s = k)
      (a : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι)) (wcZModSheaf Y ℓ) s),
      hS₀.extClass.comp a h = 0 ↔
        ∃ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y ℓ) s,
          (Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)).comp x (zero_add s) = a := by
    intro s k h a
    constructor
    · intro ha
      exact Abelian.Ext.contravariant_sequence_exact₁ hS₀ _ a h ha
    · rintro ⟨x, rfl⟩
      have hc : hS₀.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)) (add_zero 1) = 0 :=
        hS₀.extClass_comp
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hc, Abelian.Ext.zero_comp]
  have A2 : ∀ (s k : ℕ) (h : 1 + s = k)
      (t : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO)) (wcZModSheaf Y ℓ) k),
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).comp t (zero_add k) = 0 ↔
        ∃ a : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι)) (wcZModSheaf Y ℓ) s,
          hS₀.extClass.comp a h = t := by
    intro s k h t
    constructor
    · intro ht
      exact Abelian.Ext.contravariant_sequence_exact₃ hS₀ _ t ht h
    · rintro ⟨a, rfl⟩
      have hc : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).comp hS₀.extClass
          (zero_add 1) = 0 :=
        hS₀.comp_extClass
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) h (by omega), hc, Abelian.Ext.zero_comp]
  have A3 : ∀ (k : ℕ)
      (y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y ℓ) k),
      (Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)).comp y (zero_add k) = 0 ↔
        ∃ t : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO)) (wcZModSheaf Y ℓ) k,
          (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).comp t (zero_add k) = y := by
    intro k y
    constructor
    · intro hy
      exact Abelian.Ext.contravariant_sequence_exact₂ hS₀ _ y hy
    · rintro ⟨t, rfl⟩
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Limits.cokernel.condition, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
  have A0 : ∀ t : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO)) (wcZModSheaf Y ℓ) 0,
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).comp t (zero_add 0) = 0 →
        t = 0 := by
    intro t ht
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 t
    have h1 : Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO) ≫ g) =
        Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO) ≫ 0) := by
      rw [Limits.comp_zero, Abelian.Ext.mk₀_zero, ← Abelian.Ext.mk₀_comp_mk₀]
      exact ht
    have h2 := (Abelian.Ext.mk₀_bijective _ _).1 h1
    rw [cancel_epi] at h2
    rw [h2, Abelian.Ext.mk₀_zero]
  by_cases hr0 : r = 0
  ·
    have e : 2 * r = 0 := by omega
    rw [e] at hD ⊢
    obtain ⟨hfinE, hcardE⟩ := hD D₀
    haveI := hfinE
    obtain ⟨FY₂, FO₂, hc₂⟩ := wc_proet_open_restr_et_model Y O ℓ 0 Dj
    have hA1 : ∀ a : PUnit.{1},
        (0 : PUnit.{1} →+ Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO))
          (wcZModSheaf Y ℓ) 0) a = 0 ↔
        ∃ x : PUnit.{1}, (0 : PUnit.{1} →+ PUnit.{1}) x = a := by
      intro a
      exact ⟨fun _ => ⟨PUnit.unit, Subsingleton.elim _ _⟩, fun _ => AddMonoidHom.zero_apply _⟩
    have hA2 : ∀ t : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO)) (wcZModSheaf Y ℓ) 0,
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).precomp
          (wcZModSheaf Y ℓ) (zero_add 0) t = 0 ↔
        ∃ a : PUnit.{1}, (0 : PUnit.{1} →+ Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO))
          (wcZModSheaf Y ℓ) 0) a = t := by
      intro t
      constructor
      · intro ht
        refine ⟨PUnit.unit, ?_⟩
        rw [AddMonoidHom.zero_apply]
        exact (A0 t ht).symm
      · rintro ⟨a, rfl⟩
        rw [AddMonoidHom.zero_apply, map_zero]
    have hB1 : ∀ b : PUnit.{1}, (0 : PUnit.{1} →+ wcEtSuppExt D₀ 0) b = 0 ↔
        ∃ x : PUnit.{1}, (0 : PUnit.{1} →+ PUnit.{1}) x = b := by
      intro b
      exact ⟨fun _ => ⟨PUnit.unit, Subsingleton.elim _ _⟩, fun _ => AddMonoidHom.zero_apply _⟩
    have hB2 : ∀ x : wcEtSuppExt D₀ 0,
        (Abelian.Ext.mk₀ (wcEtSuppUnitMap D₀)).precomp
          (SheafOfModules.unit (wcEtZModRing Y ℓ)) (zero_add 0) x = 0 ↔
        ∃ b : PUnit.{1}, (0 : PUnit.{1} →+ wcEtSuppExt D₀ 0) b = x := by
      intro x
      constructor
      · intro hx
        refine ⟨PUnit.unit, ?_⟩
        rw [AddMonoidHom.zero_apply]
        exact (L2 x hx).symm
      · rintro ⟨b, rfl⟩
        rw [AddMonoidHom.zero_apply, map_zero]
    have hf2 : Function.Surjective (0 : PUnit.{1} →+ PUnit.{1}) :=
      fun b => ⟨PUnit.unit, Subsingleton.elim _ _⟩
    obtain ⟨hT, hTE⟩ := wc_addgroup_card_le_of_five_ladder
      (0 : PUnit.{1} →+ PUnit.{1})
      (0 : PUnit.{1} →+ Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y ιO)) (wcZModSheaf Y ℓ) 0)
      ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).precomp
        (wcZModSheaf Y ℓ) (zero_add 0))
      ((Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)).precomp (wcZModSheaf Y ℓ) (zero_add 0))
      (0 : PUnit.{1} →+ PUnit.{1}) (0 : PUnit.{1} →+ wcEtSuppExt D₀ 0)
      ((Abelian.Ext.mk₀ (wcEtSuppUnitMap D₀)).precomp
        (SheafOfModules.unit (wcEtZModRing Y ℓ)) (zero_add 0))
      (wcEtPull Dj 0)
      (0 : PUnit.{1} →+ PUnit.{1}) (0 : PUnit.{1} →+ PUnit.{1})
      FY₂.toAddMonoidHom FO₂.toAddMonoidHom
      hA1 hA2 (fun y => A3 0 y) hB1 hB2 (fun y => L1 0 y)
      (fun _ => rfl) (fun y => hc₂ y)
      hf2 FY₂.surjective FO₂.injective
    exact ⟨hT, hTE.trans hcardE⟩
  · obtain ⟨hfinE, hcardE⟩ := hD D₀
    haveI := hfinE
    obtain ⟨s, hs⟩ : ∃ s, 1 + s = 2 * r := ⟨2 * r - 1, by omega⟩
    obtain ⟨FY₁, FO₁, hc₁⟩ := wc_proet_open_restr_et_model Y O ℓ s Dj
    obtain ⟨FY₂, FO₂, hc₂⟩ := wc_proet_open_restr_et_model Y O ℓ (2 * r) Dj
    obtain ⟨δB, hB2, hB1⟩ := L3 s (2 * r) hs
    obtain ⟨hT, hTE⟩ := wc_addgroup_card_le_of_five_ladder
      ((Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)).precomp (wcZModSheaf Y ℓ) (zero_add s))
      (hS₀.extClass.precomp (wcZModSheaf Y ℓ) hs)
      ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap Y ιO))).precomp
        (wcZModSheaf Y ℓ) (zero_add (2 * r)))
      ((Abelian.Ext.mk₀ (wcFreeSheafMap Y ιO)).precomp (wcZModSheaf Y ℓ) (zero_add (2 * r)))
      (wcEtPull Dj s) δB
      ((Abelian.Ext.mk₀ (wcEtSuppUnitMap D₀)).precomp
        (SheafOfModules.unit (wcEtZModRing Y ℓ)) (zero_add (2 * r)))
      (wcEtPull Dj (2 * r))
      FY₁.toAddMonoidHom FO₁.toAddMonoidHom FY₂.toAddMonoidHom FO₂.toAddMonoidHom
      (fun a => A1 s (2 * r) hs a) (fun t => A2 s (2 * r) hs t) (fun y => A3 (2 * r) y)
      hB1 hB2 (fun y => L1 (2 * r) y)
      (fun x => (hc₁ x).symm) (fun y => hc₂ y)
      FO₁.surjective FY₂.surjective FO₂.injective
    exact ⟨hT, hTE.trans hcardE⟩

theorem wc_smooth_pair_local_zmod_codim_card_le (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
