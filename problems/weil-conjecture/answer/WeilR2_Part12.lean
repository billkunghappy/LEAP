    rw [show (fun z : Abelian.Ext A B q => Abelian.Ext.mapExactFunctor (wcEtInv (𝟙 Y)) z) =
      (fun z => (Abelian.Ext.mk₀ (θ.hom.app A)).comp
        (z.comp (Abelian.Ext.mk₀ (θ.inv.app B)) (add_zero q)) (zero_add q)) from funext hform]
    refine Function.bijective_iff_has_inverse.mpr ⟨fun w => (Abelian.Ext.mk₀ (θ.inv.app A)).comp
      (w.comp (Abelian.Ext.mk₀ (θ.hom.app B)) (add_zero q)) (zero_add q), ?_, ?_⟩
    · intro z
      simp only [hY4, hY2, hY3, Iso.inv_hom_id_app, Iso.hom_inv_id_app, Abelian.Ext.comp_mk₀_id,
        Abelian.Ext.mk₀_id_comp]
      try exact Abelian.Ext.comp_mk₀_id z
    · intro w
      simp only [hY4, hY2, hY3, Iso.inv_hom_id_app, Iso.hom_inv_id_app, Abelian.Ext.comp_mk₀_id,
        Abelian.Ext.mk₀_id_comp]
      try exact Abelian.Ext.comp_mk₀_id w

  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hcont
  obtain ⟨χ⟩ : Nonempty ((wcEpsInv Y).obj
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) ≅ wcZModSheaf Y ℓ) :=
    ⟨(wc_epsInv_const Y _).some ≪≫ (wc_zmod_sheaf_const Y ℓ).some.symm⟩
  obtain ⟨Θ, hbijΘ, hnat⟩ := wc_etale_proet_comparison Y
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q
  have hχ : ∀ W : Y.ProEt, Function.Bijective (fun x : Abelian.Ext (wcFreeSheaf Y W)
      ((wcEpsInv Y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) q =>
      x.comp (Abelian.Ext.mk₀ χ.hom) (add_zero q)) := by
    intro W
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun y => y.comp (Abelian.Ext.mk₀ χ.inv) (add_zero q), ?_, ?_⟩
    · intro x
      show (x.comp (Abelian.Ext.mk₀ χ.hom) (add_zero q)).comp (Abelian.Ext.mk₀ χ.inv)
        (add_zero q) = x
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · intro y
      show (y.comp (Abelian.Ext.mk₀ χ.inv) (add_zero q)).comp (Abelian.Ext.mk₀ χ.hom)
        (add_zero q) = y
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]

  let XH : wcEtZModExt Y ℓ q →+ Abelian.Ext (wcEtUnitSheaf Y)
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q :=
    ((Abelian.Ext.mk₀ p).precomp
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (zero_add q)).comp
      (((Abelian.Ext.mk₀ ιY.hom).postcomp
          ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).obj
            (SheafOfModules.unit (wcEtZModRing Y ℓ))) (add_zero q)).comp
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).mapExtAddHom
          (SheafOfModules.unit (wcEtZModRing Y ℓ)) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q))
  let MH := (wcEtInv (𝟙 Y)).mapExtAddHom (wcEtUnitSheaf Y)
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q
  let βH : wcEtZModExt O.toScheme ℓ q →+ Abelian.Ext ((wcEtInv O.ι).obj (wcEtUnitSheaf Y))
      ((wcEtInv O.ι).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) q :=
    ((Abelian.Ext.mk₀ q'.hom).postcomp ((wcEtInv O.ι).obj (wcEtUnitSheaf Y)) (add_zero q)).comp
      (((Abelian.Ext.mk₀ ((wcEtInv O.ι).map p ≫ k'.hom)).precomp
          ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).obj
            (SheafOfModules.unit (wcEtZModRing O.toScheme ℓ))) (zero_add q)).comp
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)).mapExtAddHom
          (SheafOfModules.unit (wcEtZModRing O.toScheme ℓ))
          (SheafOfModules.unit (wcEtZModRing O.toScheme ℓ)) q))
  let FYH : wcEtZModExt Y ℓ q →+
      Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y ℓ) q :=
    ((Abelian.Ext.mk₀ χ.hom).postcomp (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (add_zero q)).comp
      ((Θ (Scheme.ProEt.mk (𝟙 Y))).comp (MH.comp XH))
  let FOH : wcEtZModExt O.toScheme ℓ q →+
      Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι)) (wcZModSheaf Y ℓ) q :=
    ((Abelian.Ext.mk₀ χ.hom).postcomp (wcFreeSheaf Y (Scheme.ProEt.mk O.ι)) (add_zero q)).comp
      ((Θ (Scheme.ProEt.mk O.ι)).comp βH)
  have hFY : Function.Bijective FYH :=
    (hχ (Scheme.ProEt.mk (𝟙 Y))).comp ((hbijΘ (Scheme.ProEt.mk (𝟙 Y)) hYc hYqs).comp
      ((hMbij _ _).comp hXbij))
  have hFO : Function.Bijective FOH :=
    (hχ (Scheme.ProEt.mk O.ι)).comp ((hbijΘ (Scheme.ProEt.mk O.ι) hOc hOqs).comp hβbij)
  refine ⟨AddEquiv.ofBijective FYH hFY, AddEquiv.ofBijective FOH hFO, fun v => ?_⟩
  have hkey : (Abelian.Ext.mk₀ (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))).comp
        (Θ (Scheme.ProEt.mk (𝟙 Y)) (MH (XH v))) (zero_add q) =
      Θ (Scheme.ProEt.mk O.ι) (βH (wcEtPull Dj q v)) :=
    (hnat (Scheme.ProEt.mk (𝟙 Y)) (Scheme.ProEt.mk O.ι)
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)) hYc hYqs hOc hOqs (MH (XH v))).symm.trans
      (congrArg (Θ (Scheme.ProEt.mk O.ι)) (hXβ v))
  show (Abelian.Ext.mk₀ (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))).comp
