theorem wc_et_smooth_pair_punct_top_local_relation : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n e : ℕ) [SmoothOfRelativeDimension n fX] (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension e (i ≫ fX)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (V : X.Opens), (V : Set X) = (Set.range i)ᶜ → ∀ (k : ℕ), 1 ≤ k → k + 1 + 2 * e = 2 * n → ∀ (W : Scheme.{u}) (v : W ⟶ X), Etale v → ∀ (YV : Scheme.{u}) (gV : YV ⟶ W) (w : YV ⟶ (V : Scheme.{u})), IsPullback w gV V.ι v → ∀ (α₁ α₂ : wcEtZModExt YV ℓ k) (x : W), ∃ (a b : ℤ), ¬ ((ℓ : ℤ) ∣ a ∧ (ℓ : ℤ) ∣ b) ∧ ∃ (W' : Scheme.{u}) (v' : W' ⟶ W), Etale v' ∧ x ∈ Set.range v' ∧ ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ W') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' → ∀ (Dw' : wcEtPullData w' ℓ), wcEtPull Dw' k (a • α₁ + b • α₂) = 0 :=
