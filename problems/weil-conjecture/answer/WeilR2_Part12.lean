theorem wc_int_supp_rat_eps {X S : Scheme.{u}} {i : X ⟶ S} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (hepi : Epi (wcSuppUnitMap D)) (E : wcIntRatData S ℓ)
    (hE : E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap S ℓ)) :
    ∃ ε : wcSuppObj D ⟶ E.L.obj (wcIntSuppObj D), IsIso ε ∧
      wcSuppUnitMap D ≫ ε = E.μ.inv ≫ E.L.map (wcIntSuppπ D) :=
by
  obtain ⟨hU1, -, hLoc⟩ := wc_int_rat_ring_localization_data S ℓ
  have hU := sheafOfModules_unitRestrict_hom_bijective (wcIntRingSheaf S ℓ) (wcRingSheaf S ℓ)
    (wcIntRatRingSheafMap S ℓ)
  have hκ := sheafOfModules_unitRestrict_image_hom_bijective (Scheme.ProEt.topology S)
    (wcIntRingSheaf S ℓ) (wcRingSheaf S ℓ) (wcIntRatRingSheafMap S ℓ) ℓ hU1 hLoc hU
    (wcSuppObj D) (wcSuppUnitMap D) hepi
  let κ' : E.L.obj (wcIntSuppObj D) ⟶ wcSuppObj D :=
    (E.adj.homEquiv (wcIntSuppObj D) (wcSuppObj D)).symm (Limits.image.ι (wcIntSuppMap D))
  have hiso : IsIso κ' := by
    apply isIso_of_coyoneda_map_bijective
    intro Y
    have hfun : (fun x : wcSuppObj D ⟶ Y => κ' ≫ x) =
        (E.adj.homEquiv (wcIntSuppObj D) Y).symm ∘
          (fun x : wcSuppObj D ⟶ Y => Limits.image.ι (wcIntSuppMap D) ≫
            (SheafOfModules.restrictScalars (wcIntRatRingSheafMap S ℓ)).map x) := by
      funext x
      exact (Adjunction.homEquiv_naturality_right_symm E.adj _ x).symm
    rw [hfun]
    exact (E.adj.homEquiv _ _).symm.bijective.comp (hκ Y)
  have h1 : E.L.map (wcIntSuppπ D) ≫ κ' = E.μ.hom ≫ wcSuppUnitMap D := by
    calc E.L.map (wcIntSuppπ D) ≫ κ'
        = (E.adj.homEquiv _ _).symm (wcIntSuppπ D ≫ Limits.image.ι (wcIntSuppMap D)) :=
          (Adjunction.homEquiv_naturality_left_symm E.adj _ _).symm
      _ = (E.adj.homEquiv _ _).symm (wcUnitRestrict (wcIntRatRingSheafMap S ℓ) ≫
            (SheafOfModules.restrictScalars (wcIntRatRingSheafMap S ℓ)).map (wcSuppUnitMap D)) := by
          congr 1
          exact Limits.image.fac _
      _ = (E.adj.homEquiv _ _).symm (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)) ≫
            wcSuppUnitMap D :=
          Adjunction.homEquiv_naturality_right_symm E.adj _ _
      _ = E.μ.hom ≫ wcSuppUnitMap D := by
          rw [← hE, Equiv.symm_apply_apply]
  refine ⟨inv κ', inferInstance, ?_⟩
  calc wcSuppUnitMap D ≫ inv κ' = E.μ.inv ≫ (E.μ.hom ≫ wcSuppUnitMap D) ≫ inv κ' := by
        simp
    _ = E.μ.inv ≫ (E.L.map (wcIntSuppπ D) ≫ κ') ≫ inv κ' := by rw [h1]
    _ = E.μ.inv ≫ E.L.map (wcIntSuppπ D) := by simp

theorem wc_ring_unit_end_natTrans (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ)) :
    ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ⟶ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
      m.app (SheafOfModules.unit (wcRingSheaf S ℓ)) = e :=
by
  have hcomm : ∀ (X : (S.ProEt)ᵒᵖ) (a b : (wcRingSheaf S ℓ).obj.obj X), a * b = b * a := by
    intro X a b
    exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
  let R := wcRingSheaf S ℓ
  let s := (SheafOfModules.unit R).unitHomEquiv e
  let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
  have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
    fun f => PresheafOfModules.sections_property s f
  let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
    fun M X => ModuleCat.ofHom
      { toFun := fun x => σ X • x
        map_add' := fun x y => smul_add _ _ _
        map_smul' := fun r x => by
          simp only [RingHom.id_apply, smul_smul]
          rw [hcomm X] }
  let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
    ⟨PresheafOfModules.Hom.mk (L M) (by
      intro X Y f
      ext x
      show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
      rw [PresheafOfModules.map_smul, hσ])⟩
  refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
  · intro M N g
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    ext x
    show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
    exact ((g.val.app X).hom.map_smul _ _).symm
  · apply (SheafOfModules.unit R).unitHomEquiv.injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    show σ X • (1 : R.obj.obj X) = s.1 X
    rw [smul_eq_mul, mul_one]

theorem wc_int_rat_pull_left_adjoint_iso {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (p : T ⟶ Y)
    (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D) (DΛ : wcIntPullData p ℓ)
    (hDΛ : wcIntPullCanonical DΛ) (EY : wcIntRatData Y ℓ) (ET : wcIntRatData T ℓ) :
    Nonempty (DΛ.Φ ⋙ ET.L ≅ EY.L ⋙ D.Φ) :=
by
  classical
  haveI hc : (wcProEtBC p).IsContinuous (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T) :=
    DΛ.cont
  have hsq : wcIntRatRingSheafMap Y ℓ ≫ D.φ =
      DΛ.φ ≫ ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).map (wcIntRatRingSheafMap T ℓ) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    have e1 : (D.φ.hom.app (Opposite.op V)).hom
        (((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom s) =
        ((((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom s :
          C(↥V.left, ULift.{u+1} ℚ_[ℓ])).comp (Limits.pullback.fst V.hom p).base.hom) :=
      hD V _
    have e2 : (DΛ.φ.hom.app (Opposite.op V)).hom s =
        ((s : C(↥V.left, ULift.{u+1} ℤ_[ℓ])).comp (Limits.pullback.fst V.hom p).base.hom) :=
      hDΛ V s
    change (D.φ.hom.app (Opposite.op V)).hom
        (((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op V)).hom s) =
      ((wcIntRatRingSheafMap T ℓ).hom.app (Opposite.op ((wcProEtBC p).obj V))).hom
        ((DΛ.φ.hom.app (Opposite.op V)).hom s)
    rw [e2]
    refine e1.trans ?_
    apply ContinuousMap.ext
    intro z
    rfl
  have hring : ∀ U : (Y.ProEt)ᵒᵖ,
      (D.φ.hom.app U).hom.comp ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom =
        ((((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).map
            (wcIntRatRingSheafMap T ℓ)).hom.app U).hom.comp (DΛ.φ.hom.app U).hom := by
    intro U
    have h := congrArg (fun f : wcIntRingSheaf Y ℓ ⟶
      ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).obj (wcRingSheaf T ℓ) =>
          (f.hom.app U).hom) hsq
    exact h
  let ι : SheafOfModules.pushforward.{u+1} D.φ ⋙
        SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap Y ℓ) ≅
      SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap T ℓ) ⋙
        SheafOfModules.pushforward.{u+1} DΛ.φ :=
    NatIso.ofComponents (fun M => (SheafOfModules.fullyFaithfulForget _).preimageIso
      (PresheafOfModules.isoMk (fun U =>
        (ModuleCat.restrictScalarsComp'App ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom
          (D.φ.hom.app U).hom
          ((D.φ.hom.app U).hom.comp ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom) rfl
          (M.val.obj (Opposite.op ((wcProEtBC p).obj U.unop)))).symm ≪≫
        ModuleCat.restrictScalarsComp'App (DΛ.φ.hom.app U).hom
          ((((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology Y) (Scheme.ProEt.topology T)).map
              (wcIntRatRingSheafMap T ℓ)).hom.app U).hom
          ((D.φ.hom.app U).hom.comp ((wcIntRatRingSheafMap Y ℓ).hom.app U).hom) (hring U)
          (M.val.obj (Opposite.op ((wcProEtBC p).obj U.unop))))
        (by intro U V f; ext x; rfl)))
      (by
        intro M M' g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro U
        ext x
        rfl)
  exact ⟨(DΛ.adj.comp ET.adj).leftAdjointUniq ((EY.adj.comp D.adj).ofNatIsoRight ι)⟩

theorem wc_int_rat_ext_eq_zero_iff (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (E : wcIntRatData S ℓ)
    (hE : E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap S ℓ))
    (X : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    ∀ z : Abelian.Ext X (wcIntUnit S ℓ) n,
      wcIntRatExt E X n z = 0 ↔
        z.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n) = 0 :=
by
  letI hΛ : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI hR : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  haveI := E.additive
