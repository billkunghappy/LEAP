          ∀ x, Θ Dh' De' (wcIntSuppRedRestr Dh DΛ γΛ ν q x) =
            wcEtSuppRestr De Ef De' γe q (Θ Dh De x)) :=
by
  classical
  obtain ⟨Ψ2, hΨ2b, hΨ2n⟩ := wc_zmod_et_proet_supp_transport.{u} ℓ q
  obtain ⟨Ψ1, hΨ1b, hΨ1n⟩ := wc_int_zmod_supp_coeff_transport.{u} ℓ q
  let Dz : ∀ {X S : Scheme.{u}} (i : X ⟶ S), wcZModPullData i ℓ :=
    fun i => Classical.choose (wc_zmod_pull_data_exists i ℓ)
  have hDz : ∀ {X S : Scheme.{u}} (i : X ⟶ S), wcZModPullCanonical (Dz i) :=
    fun i => Classical.choose_spec (wc_zmod_pull_data_exists i ℓ)
  let Ψ : ∀ {X S : Scheme.{u}} {i : X ⟶ S} (Dh : wcHMPullData i ℓ) (De : wcEtPullData i ℓ),
      wcEtSuppExt De q →+
        @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) _ _ (HasExt.standard _)
          (wcIntSuppObj Dh) (wcIntTors S ℓ 1) q :=
    fun {_ _ i} Dh De => (Ψ1 Dh (Dz i)).comp (Ψ2 (Dz i) De)
  let Θ : ∀ {X S : Scheme.{u}} {i : X ⟶ S} (Dh : wcHMPullData i ℓ) (De : wcEtPullData i ℓ),
      @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) _ _ (HasExt.standard _)
          (wcIntSuppObj Dh) (wcIntTors S ℓ 1) q →+ wcEtSuppExt De q :=
    fun Dh De => if h : Function.Bijective (Ψ Dh De) then
      (AddEquiv.ofBijective (Ψ Dh De) h).symm.toAddMonoidHom else 0
  have key : ∀ {X S : Scheme.{u}} {i : X ⟶ S} (Dh : wcHMPullData i ℓ) (De : wcEtPullData i ℓ)
      (h : Function.Bijective (Ψ Dh De)) y, Ψ Dh De (Θ Dh De y) = y := by
    intro X S i Dh De h y
    have e : Θ Dh De y = (AddEquiv.ofBijective (Ψ Dh De) h).symm y := by
      simp only [Θ, dif_pos h]
      rfl
    rw [e]
    exact (AddEquiv.ofBijective (Ψ Dh De) h).apply_symm_apply y
  have bij : ∀ {X S : Scheme.{u}} (i : X ⟶ S) [IsClosedImmersion i] [CompactSpace S]
      [QuasiSeparatedSpace S] (Dh : wcHMPullData i ℓ), wcHMPullCanonical Dh →
      ∀ De : wcEtPullData i ℓ, Function.Bijective (Ψ Dh De) := by
    intro X S i _ _ _ Dh hDh De
    exact (hΨ1b i Dh hDh (Dz i) (hDz i)).comp (hΨ2b i (Dz i) (hDz i) De)
  refine ⟨Θ, ?_, ?_⟩
  · intro X S i _ _ _ Dh hDh De x
    have hb := bij i Dh hDh De
    exact ⟨Ψ Dh De x, hb.1 (key Dh De hb _)⟩
  · intro X S X' S' i _ f i' g hP hcS hqS hcS' hqS' Dh hDh Dh' hDh' hepi DΛ hDΛ γΛ hγΛ ν hν
      De De' Ef γe hγe x
    haveI : CompactSpace S := hcS
    haveI : QuasiSeparatedSpace S := hqS
    haveI : CompactSpace S' := hcS'
    haveI : QuasiSeparatedSpace S' := hqS'
    haveI : IsClosedImmersion i' :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP ‹IsClosedImmersion i›
    obtain ⟨Dzf, hDzf⟩ := wc_zmod_pull_data_exists f ℓ
    obtain ⟨γz, hγz⟩ := wc_zmod_closed_supp_base_change i f i' g hP (Dz i) (hDz i) Dzf hDzf
      (Dz i') (hDz i')
    have hb := bij i Dh hDh De
    have hb' := bij i' Dh' hDh' De'
    have hnat : ∀ y, Ψ Dh' De' (wcEtSuppRestr De Ef De' γe q y) =
        wcIntSuppRedRestr Dh DΛ γΛ ν q (Ψ Dh De y) := by
      intro y
      show Ψ1 Dh' (Dz i') (Ψ2 (Dz i') De' (wcEtSuppRestr De Ef De' γe q y)) =
        wcIntSuppRedRestr Dh DΛ γΛ ν q (Ψ1 Dh (Dz i) (Ψ2 (Dz i) De y))
      rw [hΨ2n i f i' g hP hcS hqS hcS' hqS' (Dz i) (hDz i) (Dz i') (hDz i') Dzf hDzf γz hγz
        De De' Ef γe hγe y]
      exact hΨ1n i f i' g hP hcS hqS hcS' hqS' Dh hDh Dh' hDh' hepi DΛ hDΛ γΛ hγΛ ν hν
        (Dz i) (hDz i) (Dz i') (hDz i') Dzf hDzf γz hγz (Ψ2 (Dz i) De y)
    apply hb'.1
    rw [key Dh' De' hb', hnat, key Dh De hb]

theorem wc_et_thom_ne_zero_of_point : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomGL T → wcEtThomNat T → wcEtThomPt T → ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i ℓ) (θ : wcEtSuppExt D (2 * c)), wcEtIsThom T fX D c θ → ∀ (z : Spec (.of K) ⟶ Z), z ≫ i ≫ fX = 𝟙 _ → θ ≠ 0 :=
by
  intro K _ _ ℓ _ hℓ T hGL hNat hPt X Z fX n c _ i _ _ hc D θ hθ z hz h0
  obtain ⟨W, -, hzW, h, hcut⟩ :=
    wc_smooth_pair_local_cutout K X Z fX n c i hc (z (IsLocalRing.closedPoint K))
  have sq : IsPullback (i ⁻¹ᵁ W).ι (i ∣_ W) i W.ι := (isPullback_morphismRestrict i W).flip
  obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (i ∣_ W) ℓ
  obtain ⟨EW⟩ := wc_et_zmod_pull_data_exists W.ι ℓ
  obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change i W.ι (i ∣_ W) (i ⁻¹ᵁ W).ι sq D EW DW
  have hθW := hθ W _ (i ∣_ W) (i ⁻¹ᵁ W).ι sq DW EW γ hγ h hcut
  haveI hsmW : SmoothOfRelativeDimension n (W.ι ≫ fX) := by
    have := smoothOfRelativeDimension_comp 0 n W.ι fX
    rwa [Nat.zero_add] at this
  have e : (i ∣_ W) ≫ W.ι ≫ fX = (i ⁻¹ᵁ W).ι ≫ i ≫ fX := by
    rw [← Category.assoc, morphismRestrict_ι, Category.assoc]
  haveI hsmZW : SmoothOfRelativeDimension (n - c) ((i ∣_ W) ≫ W.ι ≫ fX) := by
    rw [e]
    have := smoothOfRelativeDimension_comp 0 (n - c) (i ⁻¹ᵁ W).ι (i ≫ fX)
    rwa [Nat.zero_add] at this
  have hneW : Nonempty (i ⁻¹ᵁ W).toScheme := ⟨⟨_, hzW⟩⟩
  haveI hlft : LocallyOfFiniteType ((i ∣_ W) ≫ W.ι ≫ fX) := by
    first
      | (haveI : Smooth ((i ∣_ W) ≫ W.ι ≫ fX) :=
          SmoothOfRelativeDimension.smooth (n := n - c) (f := (i ∣_ W) ≫ W.ι ≫ fX)
         infer_instance)
      | (haveI : Smooth ((i ∣_ W) ≫ W.ι ≫ fX) :=
          SmoothOfRelativeDimension.smooth (n - c) ((i ∣_ W) ≫ W.ι ≫ fX)
         infer_instance)
      | (haveI : IsSmooth ((i ∣_ W) ≫ W.ι ≫ fX) :=
          IsSmoothOfRelativeDimension.isSmooth (n - c) ((i ∣_ W) ≫ W.ι ≫ fX)
         infer_instance)
      | (haveI : Smooth fX := SmoothOfRelativeDimension.smooth (n := n) (f := fX)
         haveI : IsClosedImmersion (i ∣_ W) := inferInstance
         infer_instance)
      | (haveI : Smooth fX := SmoothOfRelativeDimension.smooth n fX
         haveI : IsClosedImmersion (i ∣_ W) := inferInstance
         infer_instance)
  obtain ⟨zK, hzK⟩ := wc_alg_closed_lft_section K (i ⁻¹ᵁ W).toScheme
    ((i ∣_ W) ≫ W.ι ≫ fX) hneW
  obtain ⟨S, ZS, f, iS, g, hSaff, hpb, hsm, hsm0, hne⟩ :=
    wc_smooth_cutout_transversal_slice K (W.ι ≫ fX) n c (i ∣_ W) h hc hcut zK hzK
  obtain ⟨Df⟩ := wc_et_zmod_pull_data_exists f ℓ
  obtain ⟨DS⟩ := wc_et_zmod_pull_data_exists iS ℓ
  obtain ⟨γf, hγf, -⟩ := wc_et_closed_supp_base_change (i ∣_ W) f iS g hpb DW Df DS
  have hcutS := wc_et_cutout_base_change (i ∣_ W) h f iS g hcut hSaff hpb
  have hgoodW : wcEtGoodChart K (W.ι ≫ fX) (i ∣_ W) c h := ⟨n, hc, hsmW, hsmZW, hcut⟩
  have hgoodS : wcEtGoodChart K (f ≫ W.ι ≫ fX) iS c (fun j => f.appTop.hom (h j)) :=
    ⟨c, le_rfl, hsm, by rw [Nat.sub_self]; exact hsm0, hcutS⟩
  have hNatS := hNat (W.ι ≫ fX) (f ≫ W.ι ≫ fX) f rfl (i ∣_ W) iS g hpb DW Df DS γf hγf c h
    hgoodW hgoodS
  have hPtS := hPt (f ≫ W.ι ≫ fX) iS DS c (fun j => f.appTop.hom (h j)) hsm hsm0 hcutS hne
  apply hPtS
  have e1 := hNatS.symm.trans
    (congrArg (wcEtSuppRestr DW Df DS γf (2 * c)) hθW.symm)
  refine e1.trans ?_
  rw [h0, map_zero, map_zero]

theorem wc_et_supp_boundary_open_transport : ∀ {W ZW YO : Scheme.{u}} (iW : ZW ⟶ W) [IsClosedImmersion iW] (gO : YO ⟶ W) [IsOpenImmersion gO], Set.range gO = (Set.range iW)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData iW ℓ) (M : ℕ) (θ : wcEtSuppExt D (M + 1)), wcEtSuppClass D (M + 1) θ = 0 → ∃ a : wcEtZModExt YO ℓ M, ∀ (W' Z' YO' : Scheme.{u}) (f : W' ⟶ W) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW) (gO' : YO' ⟶ W') (w : YO' ⟶ YO), IsPullback g iW' iW f → IsOpenImmersion gO' → Set.range gO' = (Set.range iW')ᶜ → w ≫ gO = gO' ≫ f → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → ∀ (Dw : wcEtPullData w ℓ) (Dg' : wcEtPullData gO' ℓ), (wcEtSuppRestr D Ef D' γ (M + 1) θ = 0 ↔ ∃ y : wcEtZModExt W' ℓ M, wcEtPull Dw M a = wcEtPull Dg' M y) :=
by
  classical
  intro W ZW YO iW _ gO _ hrange ℓ _ D M θ hθ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO ℓ)) := HasExt.standard _
  obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gO ℓ
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  obtain ⟨c, hc, -⟩ := wc_et_open_compl_ker_transfer iW gO hrange ℓ D Dg
  haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi iW D
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ
  have hθ' : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp θ (zero_add (M + 1)) = 0 := hθ
  obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
    (SheafOfModules.unit (wcEtZModRing W ℓ)) θ hθ' (add_comm 1 M)
  refine ⟨(Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
    (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero M)) (zero_add M), ?_⟩
  intro W' Z' YO' f iW' g gO' w hZ hO hr' hw D' Ef γ hγ Dw Dg'
  haveI : IsClosedImmersion iW' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hZ inferInstance
  haveI := hO
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)) := HasExt.standard _
  haveI := Ef.additive
  haveI := Ef.presLim
  haveI := Ef.presColim
  haveI := Dg'.additive
  haveI := Dg'.presLim
  haveI := Dg'.presColim
  haveI hπ' : Epi (wcEtSuppUnitMap D') := wc_et_supp_unit_epi iW' D'
  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D')) (wcEtSuppUnitMap D')
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hπ'
  obtain ⟨κ, hκ, hK⟩ := wc_et_supp_restr_extclass_kernel iW iW' f D Ef D' γ hγ
  have E1 := hK hS hS' M x
  rw [hx] at E1
  obtain ⟨c', hc', hT'⟩ := wc_et_open_compl_ker_transfer iW' gO' hr' ℓ D' Dg'
  have NAT := wc_et_open_compl_transfer_natural gO gO' f w hw ℓ D D' Ef Dg Dg' Dw κ c c'
    hκ hc hc' M x
  have UR : ∀ y : wcEtZModExt W' ℓ M,
      (Abelian.Ext.mk₀ c').comp ((Abelian.Ext.mapExactFunctor Dg'.Φ
        ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D'))).comp y (zero_add M))).comp
        (Abelian.Ext.mk₀ Dg'.μ.hom) (add_zero M)) (zero_add M) = wcEtPull Dg' M y := by
    intro y
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, hc']
    rfl
  constructor
  · intro h0
    have h2 := E1.symm.trans h0
    obtain ⟨y, hy⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS'
      (SheafOfModules.unit (wcEtZModRing W' ℓ)) _ (add_comm 1 M) h2
    refine ⟨y, ?_⟩
    rw [← NAT, ← hy]
    exact UR y
  · rintro ⟨y, hy⟩
    have hTT := NAT.trans (hy.trans (UR y).symm)
    have hκy := (hT' M).1 hTT
    rw [E1, hκy]
    first
      | rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, ShortComplex.ShortExact.extClass_comp,
          Abelian.Ext.zero_comp]
      | (rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, ShortComplex.ShortExact.extClass_comp]
         simp)
      | (rw [← Abelian.Ext.comp_assoc_of_second_deg_zero]; simp)

theorem wc_et_supp_boundary_level_descent : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.Opens), (U : Set Y) = (Set.range i)ᶜ → ∀ (R : CommRingCat.{u}) (k : Spec R ⟶ Y) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D₀ : Λ ⥤ Y.Etale) (φ : ∀ l, Spec R ⟶ (D₀.obj l).left), (∀ l, IsAffine (D₀.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (D₀.map t).left = φ l') → (∀ l, φ l ≫ (D₀.obj l).hom = k) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D₀.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D₀.map t).left = z l') → ∃! z₀ : T ⟶ Spec R, ∀ l, z₀ ≫ φ l = z l) → ∀ (l₁ : Λ) (D₁ : wcEtPullData (Limits.pullback.snd i (D₀.obj l₁).hom) ℓ) (M : ℕ) (θ₁ : wcEtSuppExt D₁ (M + 1)) (a : wcEtZModExt (Limits.pullback (D₀.obj l₁).hom U.ι) ℓ M), (∀ (W' Z' YO' : Scheme.{u}) (f : W' ⟶ (D₀.obj l₁).left) (iW' : Z' ⟶ W') (g : Z' ⟶ Limits.pullback i (D₀.obj l₁).hom) (gO' : YO' ⟶ W') (w : YO' ⟶ Limits.pullback (D₀.obj l₁).hom U.ι), IsPullback g iW' (Limits.pullback.snd i (D₀.obj l₁).hom) f → IsOpenImmersion gO' → Set.range gO' = (Set.range iW')ᶜ → w ≫ Limits.pullback.fst (D₀.obj l₁).hom U.ι = gO' ≫ f → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D₁)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D₁) → ∀ (Dw : wcEtPullData w ℓ) (Dg' : wcEtPullData gO' ℓ), (wcEtSuppRestr D₁ Ef D' γ (M + 1) θ₁ = 0 ↔ ∃ y : wcEtZModExt W' ℓ M, wcEtPull Dw M a = wcEtPull Dg' M y)) → ∀ (T : Scheme.{u}) (iT : T ⟶ Spec R) (gT : T ⟶ Limits.pullback i (D₀.obj l₁).hom), IsPullback gT iT (Limits.pullback.snd i (D₀.obj l₁).hom) (φ l₁) → ∀ (DT : wcEtPullData iT ℓ) (Eφ : wcEtPullData (φ l₁) ℓ) (γT : wcEtSuppObj DT ⟶ Eφ.Φ.obj (wcEtSuppObj D₁)), wcEtSuppUnitMap DT ≫ γT = Eφ.μ.inv ≫ Eφ.Φ.map (wcEtSuppUnitMap D₁) → wcEtSuppRestr D₁ Eφ DT γT (M + 1) θ₁ = 0 → ∃ (l₃ : Λ) (t : l₃ ⟶ l₁) (D₃ : wcEtPullData (Limits.pullback.snd i (D₀.obj l₃).hom) ℓ) (Et : wcEtPullData (D₀.map t).left ℓ) (γ₃ : wcEtSuppObj D₃ ⟶ Et.Φ.obj (wcEtSuppObj D₁)), wcEtSuppUnitMap D₃ ≫ γ₃ = Et.μ.inv ≫ Et.Φ.map (wcEtSuppUnitMap D₁) ∧ wcEtSuppRestr D₁ Et D₃ γ₃ (M + 1) θ₁ = 0 :=
by
  classical
  intro Y Z i _ _ ℓ _ U hU R k Λ _ _ D₀ φ hAff hφc hφa hlim l₁ D₁ M θ₁ a ha T iT gT hTsq DT Eφ γT
    hγT hR

  haveI hjR : IsOpenImmersion (Limits.pullback.snd U.ι k) := by
    first
      | infer_instance
      | exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
          (IsPullback.of_hasPullback U.ι k) inferInstance
  have hrT : Set.range iT = k ⁻¹' Set.range i := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨Limits.pullback.fst i (D₀.obj l₁).hom (gT y), ?_⟩
      have e : gT ≫ Limits.pullback.fst i (D₀.obj l₁).hom ≫ i = iT ≫ k := by
        rw [Limits.pullback.condition, ← Category.assoc, hTsq.w, Category.assoc, hφa]
      have e2 : (gT ≫ Limits.pullback.fst i (D₀.obj l₁).hom ≫ i) y = (iT ≫ k) y := by rw [e]
      simpa only [Scheme.Hom.comp_apply] using e2
    · intro hx
      have h1 : φ l₁ x ∈ Set.range (Limits.pullback.snd i (D₀.obj l₁).hom) := by
        rw [Scheme.Pullback.range_snd]
        show (D₀.obj l₁).hom (φ l₁ x) ∈ Set.range i
        have e3 : (φ l₁ ≫ (D₀.obj l₁).hom) x = k x := by rw [hφa]
        rw [Scheme.Hom.comp_apply] at e3
        rw [e3]
        exact hx
      have h2 : x ∈ Set.range
          (Limits.pullback.snd (Limits.pullback.snd i (D₀.obj l₁).hom) (φ l₁)) := by
        rw [Scheme.Pullback.range_snd]
        exact h1
      obtain ⟨q, hq⟩ := h2
      refine ⟨hTsq.isoPullback.inv q, ?_⟩
      have e4 : (hTsq.isoPullback.inv ≫ iT) q =
          (Limits.pullback.snd (Limits.pullback.snd i (D₀.obj l₁).hom) (φ l₁)) q := by
        rw [IsPullback.isoPullback_inv_snd]
      rw [Scheme.Hom.comp_apply] at e4
      rw [e4, hq]
  have hrR : Set.range (Limits.pullback.snd U.ι k) = (Set.range iT)ᶜ := by
    rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι, hU, Set.preimage_compl, hrT]
  obtain ⟨w₁, hw₁, hw₁b⟩ : ∃ w₁ : Limits.pullback U.ι k ⟶ Limits.pullback (D₀.obj l₁).hom U.ι,
      w₁ ≫ Limits.pullback.fst (D₀.obj l₁).hom U.ι = Limits.pullback.snd U.ι k ≫ φ l₁ ∧
      w₁ ≫ Limits.pullback.snd (D₀.obj l₁).hom U.ι = Limits.pullback.fst U.ι k :=
    ⟨Limits.pullback.lift (Limits.pullback.snd U.ι k ≫ φ l₁) (Limits.pullback.fst U.ι k)
      (by rw [Category.assoc, hφa]; exact Limits.pullback.condition.symm),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  obtain ⟨Dw₁⟩ := wc_et_zmod_pull_data_exists w₁ ℓ
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd U.ι k) ℓ
