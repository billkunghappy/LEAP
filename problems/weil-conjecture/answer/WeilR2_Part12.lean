theorem wc_int_supp_obj_ell_mono {X S : Scheme.{u}} {i : X ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) : Mono ((ℓ : ℕ) • 𝟙 (wcIntSuppObj D)) :=
by
  have hN : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
      Mono ((ℓ : ℕ) • 𝟙 ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).obj M)) := by
    intro M
    apply Functor.mono_of_mono_map (SheafOfModules.forget (wcIntRingSheaf S ℓ))
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply PresheafOfModules.mono_of_injective
    intro U x y hxy
    have e : ((ℓ : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf S ℓ)).obj
        ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).obj M))).app U =
        (ℓ : ℕ) • 𝟙 _ := by
      rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
        PresheafOfModules.id_app]
      rfl
    rw [e] at hxy
    simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply] at hxy
    let x' : M.val.obj U := x
    let y' : M.val.obj U := y
    have hxy' : (ℓ : ℕ) • x' = (ℓ : ℕ) • y' := hxy
    show x' = y'
    have hu : IsUnit ((ℓ : ℕ) : (wcRingSheaf S ℓ).obj.obj U) := by
      show IsUnit ((ℓ : ℕ) : C(↥(Opposite.unop U).left, ULift.{u+1} ℚ_[ℓ]))
      have hl : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero
      refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((ℓ : ℚ_[ℓ])⁻¹)), ?_⟩
      ext t
      first
        | simp [hl]
        | (simp only [ContinuousMap.mul_apply, ContinuousMap.natCast_apply, ContinuousMap.const_apply,
            ContinuousMap.one_apply, ULift.mul_down, ULift.natCast_down, ULift.one_down]
           exact mul_inv_cancel₀ hl)
    obtain ⟨c, hc⟩ := hu.exists_left_inv
    calc x' = (c * ((ℓ : ℕ) : (wcRingSheaf S ℓ).obj.obj U)) • x' := by rw [hc, one_smul]
      _ = c • ((ℓ : ℕ) • x') := by rw [mul_smul, Nat.cast_smul_eq_nsmul]
      _ = c • ((ℓ : ℕ) • y') := by rw [hxy']
      _ = y' := by rw [← Nat.cast_smul_eq_nsmul ((wcRingSheaf S ℓ).obj.obj U), ← mul_smul, hc,
          one_smul]
  haveI := hN (wcSuppObj D)
  have h : ((ℓ : ℕ) • 𝟙 (wcIntSuppObj D)) ≫ Limits.image.ι (wcIntSuppMap D) =
      Limits.image.ι (wcIntSuppMap D) ≫ ((ℓ : ℕ) • 𝟙 _) := by
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
  haveI : Mono (((ℓ : ℕ) • 𝟙 (wcIntSuppObj D)) ≫ Limits.image.ι (wcIntSuppMap D)) := by
    rw [h]; infer_instance
  exact mono_of_mono _ (Limits.image.ι (wcIntSuppMap D))

theorem wc_int_tors_res_ext_vanish (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (hP : Mono ((ℓ : ℕ) • 𝟙 P))
    (I : SheafOfModules.{u+1} (wcZModRingSheaf S (ℓ ^ 1))) [Injective I] (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    ∀ e : Abelian.Ext P
      ((SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ 1)).obj I) (n + 1),
