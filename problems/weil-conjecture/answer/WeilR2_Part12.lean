    let G1 := (SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ)).obj
      (SheafOfModules.unit (wcRingSheaf E ℓ))
    let eV : ∀ V : (E.ProEt)ᵒᵖ, G1.obj.obj V ≅ (wcLadicSheaf E ℓ).obj.obj V := fun V =>
      { hom := AddCommGrpCat.ofHom
          { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
