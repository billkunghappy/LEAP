theorem wc_wcontr_int_supp_tors_clopen_kill_deg0 (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV)) (hr : r = 0)
    (x : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) _ _ (HasExt.standard _)
      (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r))
    (k : ℕ) (z₀ : V.left) (hz₀ : IsClosed ({z₀} : Set V.left))
    (hz₀r : z₀ ∈ Set.range ⇑(Limits.pullback.fst V.hom i))
    (D₀ : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z₀)
      (Limits.pullback.fst V.hom i)) ℓ) (hD₀ : wcHMPullCanonical D₀)
    (hepi₀ : Epi (wcSuppUnitMap D₀))
    (DΛ₀ : wcIntPullData (V.left.fromSpecStalk z₀) ℓ) (hDΛ₀ : wcIntPullCanonical DΛ₀)
    (γΛ₀ : wcIntSuppObj D₀ ⟶ DΛ₀.Φ.obj (wcIntSuppObj DV))
    (hγΛ₀ : wcIntSuppπ D₀ ≫ γΛ₀ = DΛ₀.μ.inv ≫ DΛ₀.Φ.map (wcIntSuppπ DV))
    (h0 : letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) := HasExt.standard _
      ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x) (zero_add _)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π
          ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)))) (add_zero _) = 0) :
    ∃ (C : Set V.left) (hC : IsClopen C), z₀ ∈ C ∧
      letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
      (x.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
          (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap)) (add_zero _)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)))) (add_zero _) = 0 :=
by
  subst hr
  letI iV : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
  letI iV' : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _
  letI i0 : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) := HasExt.standard _

  have F2 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcIntPullData f ℓ)
      (hD : wcIntPullCanonical D) (g : C(↥S, ULift.{u+1} ℤ_[ℓ])),
      D.Φ.map (wcIntFun S ℓ g) ≫ D.μ.hom = D.μ.hom ≫ wcIntFun S' ℓ (g.comp f.base.hom) := by
    intro S S' f D hD g
    have key : ∀ h : SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcIntRingSheaf S' ℓ)),
        wcIntFun S ℓ g ≫ h =
          h ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
            (wcIntFun S' ℓ (g.comp f.base.hom)) := by
      intro h
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro X
      cases X with
      | op W =>
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      obtain ⟨a', b', hab, ha1, ha2⟩ : ∃ (a' : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))
          (b' : ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))),
          @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
            ((D.φ.hom.app (Opposite.op W)).hom a') b' ∧
          (∀ r' : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)),
            @Eq ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))
              (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom r') (r' * a')) ∧
          (∀ r' : ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))),
            @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
              (((wcIntFun S' ℓ (g.comp f.base.hom)).val.app
                (Opposite.op ((wcProEtBC f).obj W))).hom r') (r' * b')) :=
        ⟨(g.comp W.hom.base.hom : C(↥W.left, ULift.{u+1} ℤ_[ℓ])),
          ((g.comp f.base.hom).comp ((wcProEtBC f).obj W).hom.base.hom :
            C(↥((wcProEtBC f).obj W).left, ULift.{u+1} ℤ_[ℓ])),
          (hD W _).trans (ContinuousMap.ext fun t =>
            congrArg (fun q => g (q.base t)) (Limits.pullback.condition (f := W.hom) (g := f))),
          fun r' => rfl, fun r' => rfl⟩
      change (h.val.app (Opposite.op W)).hom (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))))) =
          ((wcIntFun S' ℓ (g.comp f.base.hom)).val.app (Opposite.op ((wcProEtBC f).obj W))).hom
            ((h.val.app (Opposite.op W)).hom
              (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
                (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))))
      have e1 : ((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) =
          a' • (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) := by
        have h' := ha1 1
        change @Eq ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))
          (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))))
          (a' * 1)
        rw [h', one_mul, mul_one]
      rw [e1, LinearMap.map_smul]
      generalize (h.val.app (Opposite.op W)).hom
        (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
          (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) = y
      have h2 := ha2 y
      refine Eq.trans ?_ h2.symm
      change @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
        (@HMul.hMul ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))) instHMul
          ((D.φ.hom.app (Opposite.op W)).hom a') y)
        (@HMul.hMul ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))) instHMul y b')
      rw [hab]
      exact @mul_comm C(↥(Limits.pullback W.hom f), ULift.{u+1} ℤ_[ℓ]) _ b' y
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _

  have hval : ∀ (S : Scheme.{u}) (c : C(↥S, ULift.{u+1} ℤ_[ℓ])) (W : (S.ProEt)ᵒᵖ),
      ((SheafOfModules.unitHomEquiv _) (wcIntFun S ℓ c)).1 W =
      (c.comp (Opposite.unop W).hom.base.hom :
        C(↥((Opposite.unop W).left), ULift.{u+1} ℤ_[ℓ])) := by
    intro S c W
    simp only [wcIntFun, Equiv.apply_symm_apply]
    rfl

  let TT : ∀ S : Scheme.{u}, S.ProEt := fun S =>
    MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))

  have hclass : ∀ (S : Scheme.{u}) (e : wcIntUnit S ℓ ⟶ wcIntUnit S ℓ),
      ∃ a : C(↥S, ULift.{u+1} ℤ_[ℓ]), e = wcIntFun S ℓ a := by
    intro S e
    let σ := SheafOfModules.unitHomEquiv _ e
    let a : C(↥S, ULift.{u+1} ℤ_[ℓ]) := σ.1 (Opposite.op (TT S))
    refine ⟨a, ?_⟩
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    cases X with
    | op W =>
    rw [hval]
    let τ : W ⟶ TT S := MorphismProperty.Over.homMk (B := TT S) W.hom (Category.comp_id _) trivial
    exact (PresheafOfModules.sections_property σ τ.op).symm
  have evFun : ∀ (S : Scheme.{u}) (a : C(↥S, ULift.{u+1} ℤ_[ℓ])),
      ((SheafOfModules.unitHomEquiv _ (wcIntFun S ℓ a)).1 (Opposite.op (TT S)) :
        C(↥S, ULift.{u+1} ℤ_[ℓ])) = a := by
    intro S a
    rw [hval]
    rfl

  have hmval : ∀ (S : Scheme.{u}) (W : (S.ProEt)ᵒᵖ)
      (y : ↑((wcIntUnit S ℓ).val.obj W)),
      (((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)).val.app W).hom y = (ℓ ^ k : ℕ) • y := by
    intro S W y
    have e : ((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf S ℓ)).obj
        (wcIntUnit S ℓ))).app W = (ℓ ^ k : ℕ) • 𝟙 _ := by
      rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
        PresheafOfModules.id_app]
      rfl
    have e2 : (SheafOfModules.forget (wcIntRingSheaf S ℓ)).map ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) =
        (ℓ ^ k : ℕ) • 𝟙 _ := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have e4 := congrArg (fun t => (PresheafOfModules.Hom.app t W).hom y) e2
    have e5 : ∀ (y' : ↑(((SheafOfModules.forget (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ)).obj W)),
        (((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf S ℓ)).obj
          (wcIntUnit S ℓ))).app W).hom y' = (ℓ ^ k : ℕ) • y' := by
      intro y'
      rw [e]
      first
      | (simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
          LinearMap.id_apply]; done)
      | rfl
      | (rw [ModuleCat.hom_nsmul]; rfl)
    exact e4.trans (e5 y)
  have evM : ∀ (S : Scheme.{u}) (e : wcIntUnit S ℓ ⟶ wcIntUnit S ℓ),
      ((SheafOfModules.unitHomEquiv _ (e ≫ ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))).1
          (Opposite.op (TT S)) : C(↥S, ULift.{u+1} ℤ_[ℓ])) =
        (ℓ ^ k : ℕ) • ((SheafOfModules.unitHomEquiv _ e).1 (Opposite.op (TT S)) :
          C(↥S, ULift.{u+1} ℤ_[ℓ])) := by
    intro S e
    show (((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)).val.app (Opposite.op (TT S))).hom
      ((SheafOfModules.unitHomEquiv _ e).1 (Opposite.op (TT S))) = _
    exact hmval S _ _

  have hmonoS : ∀ S : Scheme.{u}, Mono ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
    intro S
    have hN : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
    have hc : ((ℓ ^ k : ℕ) : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hN
    have key : ∀ {T : Type u} [TopologicalSpace T] (a b : C(T, ULift.{u+1} ℤ_[ℓ])),
        (ℓ ^ k : ℕ) • a = (ℓ ^ k : ℕ) • b → a = b := by
      intro T _ a b h
      ext t
      have h1 : (ℓ ^ k : ℕ) • (a t).down = (ℓ ^ k : ℕ) • (b t).down :=
        congrArg (fun g : C(T, ULift.{u+1} ℤ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul, nsmul_eq_mul] at h1
      exact mul_left_cancel₀ hc h1
    apply Functor.mono_of_mono_map (SheafOfModules.forget (wcIntRingSheaf S ℓ))
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply PresheafOfModules.mono_of_injective
    intro X x₁ x₂ hxy
    have e : ((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf S ℓ)).obj
        (wcIntUnit S ℓ))).app X = (ℓ ^ k : ℕ) • 𝟙 _ := by
      rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
        PresheafOfModules.id_app]
      rfl
    rw [e] at hxy
    simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply] at hxy
    exact key (T := ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop X)))
      x₁ x₂ hxy

  have hdivS : ∀ (S : Scheme.{u}) (a' : C(↥S, ULift.{u+1} ℤ_[ℓ])),
      wcIntFun S ℓ a' ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) = 0 →
      ∃ c : C(↥S, ULift.{u+1} ℤ_[ℓ]), a' = (ℓ ^ k : ℕ) • c := by
    intro S a' ha
    haveI := hmonoS S
    have hex := ShortComplex.exact_cokernel ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))
    obtain ⟨c, hc⟩ := hclass S (hex.lift _ ha)
    refine ⟨c, ?_⟩
    have H3 : wcIntFun S ℓ a' = hex.lift _ ha ≫ ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) :=
      (hex.lift_f _ ha).symm
    have := evM S (hex.lift _ ha)
    rw [← H3, evFun, hc, evFun] at this
    exact this

  have mk0inj : ∀ {S : Scheme.{u}} {A B : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (f : A ⟶ B),
      @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ f = 0 → f = 0 := by
    intro S A B f hf
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    have e1 : ∀ f' : A ⟶ B, Abelian.Ext.homEquiv₀ (Abelian.Ext.mk₀ f') = f' := fun f' =>
      Abelian.Ext.homEquiv₀.apply_symm_apply f'
    calc f = Abelian.Ext.homEquiv₀ (Abelian.Ext.mk₀ f) := (e1 f).symm
      _ = Abelian.Ext.homEquiv₀ (Abelian.Ext.mk₀ (0 : A ⟶ B)) := by rw [hf, Abelian.Ext.mk₀_zero]
      _ = 0 := e1 0

  obtain ⟨g, rfl⟩ : ∃ g : wcIntSuppObj DV ⟶ wcIntUnit V.left ℓ, Abelian.Ext.mk₀ g = x :=
    ⟨Abelian.Ext.homEquiv₀ x, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
  obtain ⟨a, hε⟩ := hclass V.left (wcIntSuppπ DV ≫ g)
  have hpull : wcIntSuppPullExt DV DΛ₀ 0 (Abelian.Ext.mk₀ g) =
      Abelian.Ext.mk₀ (DΛ₀.Φ.map g ≫ DΛ₀.μ.hom) := by
    haveI := DΛ₀.additive
    haveI := DΛ₀.presLim
    haveI := DΛ₀.presColim
    unfold wcIntSuppPullExt
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
  have h0' : ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ 0 (Abelian.Ext.mk₀ g))
      (zero_add 0)).comp (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)))) (add_zero 0) = 0 := h0
  rw [hpull, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀] at h0'
  have H0 := mk0inj _ h0'
  have H1 : DΛ₀.μ.inv ≫ DΛ₀.Φ.map (wcIntSuppπ DV ≫ g) ≫ DΛ₀.μ.hom ≫
      Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)) = 0 := by
    calc _ = (wcIntSuppπ D₀ ≫ γΛ₀) ≫ DΛ₀.Φ.map g ≫ DΛ₀.μ.hom ≫
          Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)) := by
            rw [hγΛ₀, Functor.map_comp]; simp only [Category.assoc]
      _ = wcIntSuppπ D₀ ≫ ((γΛ₀ ≫ DΛ₀.Φ.map g ≫ DΛ₀.μ.hom) ≫
          Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ))) := by
            simp only [Category.assoc]
      _ = 0 := by rw [H0, Limits.comp_zero]
  rw [hε, ← Category.assoc (DΛ₀.Φ.map _), F2 DΛ₀ hDΛ₀ a, Category.assoc,
    Iso.inv_hom_id_assoc] at H1
  obtain ⟨c, hc⟩ := hdivS _ _ H1
  have hz : ∃ c' : ℤ_[ℓ], (a z₀).down = ((ℓ ^ k : ℕ) : ℤ_[ℓ]) * c' := by
    refine ⟨(c (IsLocalRing.closedPoint (V.left.presheaf.stalk z₀))).down, ?_⟩
    have e : (a (V.left.fromSpecStalk z₀ (IsLocalRing.closedPoint (V.left.presheaf.stalk z₀)))).down =
        (ℓ ^ k : ℕ) • (c (IsLocalRing.closedPoint (V.left.presheaf.stalk z₀))).down :=
      congrArg (fun f : C(↥(Spec (V.left.presheaf.stalk z₀)), ULift.{u+1} ℤ_[ℓ]) =>
        (f (IsLocalRing.closedPoint (V.left.presheaf.stalk z₀))).down) hc
    rw [Scheme.fromSpecStalk_closedPoint, nsmul_eq_mul] at e
    exact e

  have hcont : Continuous (fun x : ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) k x) := by
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro x hx
    have hℓ : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
    refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos hℓ _, fun y hy => ?_⟩
    have h1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
      rw [Metric.mem_ball, dist_eq_norm] at hy
      exact hy.le
    have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow (y - x) k).mp h1
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h2
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
    rw [h2]
    exact hx
  let C : Set V.left := (fun p => PadicInt.toZModPow (p := ℓ) k (a p).down) ⁻¹' {0}
  have hC : IsClopen C :=
    (isClopen_discrete ({0} : Set (ZMod (ℓ ^ k)))).preimage
      (hcont.comp (continuous_uliftDown.comp a.continuous))
  have hCmem : ∀ p : V.left, p ∈ C ↔ ∃ c' : ℤ_[ℓ], (a p).down = ((ℓ ^ k : ℕ) : ℤ_[ℓ]) * c' := by
    intro p
    show PadicInt.toZModPow (p := ℓ) k (a p).down = 0 ↔ _
    rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, Ideal.mem_span_singleton']
    constructor
    · rintro ⟨c', hc'⟩
      exact ⟨c', by rw [← hc', Nat.cast_pow, mul_comm]⟩
    · rintro ⟨c', hc'⟩
      exact ⟨c', by rw [hc', Nat.cast_pow, mul_comm]⟩
  obtain ⟨χ, hχ⟩ : ∃ χ : LocallyConstant V.left (ULift.{u+1} ℤ_[ℓ]),
      χ = LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC := ⟨_, rfl⟩
  have hℓQ : (ℓ : ℚ_[ℓ]) ≠ 0 := by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero
  obtain ⟨β, hβdef⟩ : ∃ β : V.left → ℚ_[ℓ], β = fun p =>
      (((χ p).down : ℤ_[ℓ]) : ℚ_[ℓ]) * (((a p).down : ℤ_[ℓ]) : ℚ_[ℓ]) * ((ℓ : ℚ_[ℓ]) ^ k)⁻¹ :=
    ⟨_, rfl⟩
  have hβc : Continuous β := by
    rw [hβdef]
    exact ((continuous_subtype_val.comp (continuous_uliftDown.comp χ.continuous)).mul
      (continuous_subtype_val.comp (continuous_uliftDown.comp a.continuous))).mul continuous_const
  have hβ : ∀ p, ‖β p‖ ≤ 1 := by
    intro p
    by_cases hp : p ∈ C
    · obtain ⟨c', hc'⟩ := (hCmem p).mp hp
      have h1 : χ p = 1 := by rw [hχ, LocallyConstant.charFn_eq_one]; exact hp
      have e : β p = (c' : ℚ_[ℓ]) := by
        simp only [hβdef, h1, hc', ULift.one_down, PadicInt.coe_one, PadicInt.coe_mul,
          PadicInt.coe_natCast, Nat.cast_pow, PadicInt.coe_pow, one_mul]
        field_simp
        try ring
      rw [e, PadicInt.padic_norm_e_of_padicInt]
      exact PadicInt.norm_le_one _
    · have h1 : χ p = 0 := by rw [hχ, LocallyConstant.charFn_eq_zero]; exact hp
      simp only [hβdef, h1, ULift.zero_down, PadicInt.coe_zero, zero_mul, norm_zero]
      exact zero_le_one
  let b : C(↥V.left, ULift.{u+1} ℤ_[ℓ]) :=
    ⟨fun p => ULift.up ⟨β p, hβ p⟩, continuous_uliftUp.comp (Continuous.subtype_mk hβc hβ)⟩
  have hkey : ∀ q, (a q).down * (χ q).down = ((ℓ ^ k : ℕ) : ℤ_[ℓ]) * (b q).down := by
    intro q
    apply Subtype.ext
    rw [PadicInt.coe_mul, PadicInt.coe_mul, PadicInt.coe_natCast, Nat.cast_pow]
    show _ = _ * β q
    simp only [hβdef]
    field_simp
    try ring
  have hfac : wcIntFun V.left ℓ a ≫ wcIntFun V.left ℓ χ.toContinuousMap =
      wcIntFun V.left ℓ b ≫ ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    cases X with
    | op W =>
    show ((wcIntFun V.left ℓ χ.toContinuousMap).val.app (Opposite.op W)).hom
        ((SheafOfModules.unitHomEquiv _ (wcIntFun V.left ℓ a)).1 (Opposite.op W)) =
      (((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)).val.app (Opposite.op W)).hom
        ((SheafOfModules.unitHomEquiv _ (wcIntFun V.left ℓ b)).1 (Opposite.op W))
    rw [hval, hval]
    refine Eq.trans ?_ (hmval V.left (Opposite.op W) _).symm
    change _ = ((ℓ ^ k : ℕ) • (b.comp W.hom.base.hom) : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    change (a _).down * (χ _).down = (ℓ ^ k : ℕ) • (b _).down
    rw [nsmul_eq_mul]
    exact hkey _
  haveI hπepi : Epi (wcIntSuppπ DV) := inferInstanceAs (Epi (Limits.factorThruImage _))
  refine ⟨C, hC, (hCmem z₀).mpr hz, ?_⟩
  show ((Abelian.Ext.mk₀ g).comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
          (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap)) (add_zero 0)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)))) (add_zero 0) = 0
  rw [← hχ, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
  have hhom : (g ≫ wcIntFun V.left ℓ χ.toContinuousMap) ≫
      Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) = 0 := by
    rw [← cancel_epi (wcIntSuppπ DV), Limits.comp_zero, ← Category.assoc, ← Category.assoc, hε,
      hfac, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  rw [hhom, Abelian.Ext.mk₀_zero]

theorem wc_wcontr_int_supp_stalk_divisible_near (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (x τ' : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) _ _ (HasExt.standard _)
      (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r)) (a : ℤ_[ℓ])
    (k : ℕ) (z₀ : V.left) (hz₀ : IsClosed ({z₀} : Set V.left))
    (hz₀r : z₀ ∈ Set.range ⇑(Limits.pullback.fst V.hom i))
    (D₀ : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z₀)
      (Limits.pullback.fst V.hom i)) ℓ) (hD₀ : wcHMPullCanonical D₀)
    (hepi₀ : Epi (wcSuppUnitMap D₀))
    (DΛ₀ : wcIntPullData (V.left.fromSpecStalk z₀) ℓ) (hDΛ₀ : wcIntPullCanonical DΛ₀)
    (γΛ₀ : wcIntSuppObj D₀ ⟶ DΛ₀.Φ.obj (wcIntSuppObj DV))
    (hγΛ₀ : wcIntSuppπ D₀ ≫ γΛ₀ = DΛ₀.μ.inv ≫ DΛ₀.Φ.map (wcIntSuppπ DV))
    (w₀ : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ))
      _ _ (HasExt.standard _) (wcIntSuppObj D₀)
      (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ) (2 * r))
    (hx₀ : letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x) (zero_add _) =
        ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) τ') (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z₀)) ℓ
            (ContinuousMap.const _ (ULift.up a)))) (add_zero _) + (ℓ ^ k : ℕ) • w₀) :
    ∃ W : Set V.left, IsOpen W ∧ z₀ ∈ W ∧
      ∀ z : V.left, z ∈ W → IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
      ∀ (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (_ : Epi (wcSuppUnitMap Dz))
        (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ) (_ : wcIntPullCanonical DΛz)
        (γΛz : wcIntSuppObj Dz ⟶ DΛz.Φ.obj (wcIntSuppObj DV)),
        wcIntSuppπ Dz ≫ γΛz = DΛz.μ.inv ≫ DΛz.Φ.map (wcIntSuppπ DV) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        ∃ w : Abelian.Ext (wcIntSuppObj Dz) (wcIntUnit (Spec (V.left.presheaf.stalk z)) ℓ) (2 * r),
          (Abelian.Ext.mk₀ γΛz).comp (wcIntSuppPullExt DV DΛz (2 * r) x) (zero_add _) =
            ((Abelian.Ext.mk₀ γΛz).comp (wcIntSuppPullExt DV DΛz (2 * r) τ') (zero_add _)).comp
              (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z)) ℓ
                (ContinuousMap.const _ (ULift.up a)))) (add_zero _) + (ℓ ^ k : ℕ) • w :=
by
  letI iV : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
  letI iV' : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _
  letI i0 : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Spec (V.left.presheaf.stalk z₀)) ℓ)) := HasExt.standard _

  have F1 : ∀ S : Scheme.{u}, wcIntFun S ℓ 1 = 𝟙 _ := by
    intro S
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext W
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcIntFun, Equiv.apply_symm_apply]
    rfl

  have F2 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcIntPullData f ℓ)
      (hD : wcIntPullCanonical D) (g : C(↥S, ULift.{u+1} ℤ_[ℓ])),
      D.Φ.map (wcIntFun S ℓ g) ≫ D.μ.hom = D.μ.hom ≫ wcIntFun S' ℓ (g.comp f.base.hom) := by
    intro S S' f D hD g
    have key : ∀ h : SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcIntRingSheaf S' ℓ)),
        wcIntFun S ℓ g ≫ h =
          h ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
            (wcIntFun S' ℓ (g.comp f.base.hom)) := by
      intro h
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro X
      cases X with
      | op W =>
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      obtain ⟨a', b', hab, ha1, ha2⟩ : ∃ (a' : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))
          (b' : ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))),
          @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
            ((D.φ.hom.app (Opposite.op W)).hom a') b' ∧
          (∀ r' : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)),
            @Eq ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))
              (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom r') (r' * a')) ∧
          (∀ r' : ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))),
            @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
              (((wcIntFun S' ℓ (g.comp f.base.hom)).val.app
                (Opposite.op ((wcProEtBC f).obj W))).hom r') (r' * b')) :=
        ⟨(g.comp W.hom.base.hom : C(↥W.left, ULift.{u+1} ℤ_[ℓ])),
          ((g.comp f.base.hom).comp ((wcProEtBC f).obj W).hom.base.hom :
            C(↥((wcProEtBC f).obj W).left, ULift.{u+1} ℤ_[ℓ])),
          (hD W _).trans (ContinuousMap.ext fun t =>
            congrArg (fun q => g (q.base t)) (Limits.pullback.condition (f := W.hom) (g := f))),
          fun r' => rfl, fun r' => rfl⟩
      change (h.val.app (Opposite.op W)).hom (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))))) =
          ((wcIntFun S' ℓ (g.comp f.base.hom)).val.app (Opposite.op ((wcProEtBC f).obj W))).hom
            ((h.val.app (Opposite.op W)).hom
              (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
                (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))))
      have e1 : ((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) =
          a' • (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
              (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) := by
        have h' := ha1 1
        change @Eq ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))
          (((wcIntFun S ℓ g).val.app (Opposite.op W)).hom
            (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W))))
          (a' * 1)
        rw [h', one_mul, mul_one]
      rw [e1, LinearMap.map_smul]
      generalize (h.val.app (Opposite.op W)).hom
        (@id ↑((SheafOfModules.unit (wcIntRingSheaf S ℓ)).val.obj (Opposite.op W))
          (1 : ↑((wcIntRingSheaf S ℓ).val.obj (Opposite.op W)))) = y
      have h2 := ha2 y
      refine Eq.trans ?_ h2.symm
      change @Eq ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
        (@HMul.hMul ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))) instHMul
          ((D.φ.hom.app (Opposite.op W)).hom a') y)
        (@HMul.hMul ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W)))
          ↑((wcIntRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj W))) instHMul y b')
      rw [hab]
      exact @mul_comm C(↥(Limits.pullback W.hom f), ULift.{u+1} ℤ_[ℓ]) _ b' y
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _

  have hmono : Mono ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)) := by
    have hN : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
    have hc : ((ℓ ^ k : ℕ) : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hN
    have key : ∀ {T : Type u} [TopologicalSpace T] (a b : C(T, ULift.{u+1} ℤ_[ℓ])),
        (ℓ ^ k : ℕ) • a = (ℓ ^ k : ℕ) • b → a = b := by
      intro T _ a b h
      ext t
      have h1 : (ℓ ^ k : ℕ) • (a t).down = (ℓ ^ k : ℕ) • (b t).down :=
        congrArg (fun g : C(T, ULift.{u+1} ℤ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul, nsmul_eq_mul] at h1
      exact mul_left_cancel₀ hc h1
    apply Functor.mono_of_mono_map (SheafOfModules.forget (wcIntRingSheaf V.left ℓ))
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply PresheafOfModules.mono_of_injective
    intro X x₁ x₂ hxy
    have e : ((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf V.left ℓ)).obj
        (wcIntUnit V.left ℓ))).app X = (ℓ ^ k : ℕ) • 𝟙 _ := by
      rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
        PresheafOfModules.id_app]
      rfl
    rw [e] at hxy
    simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply] at hxy
    exact key (T := ↥((Scheme.ProEt.forget V.left ⋙ Over.forget V.left).obj (Opposite.unop X)))
      x₁ x₂ hxy

  have hns : ∀ (S : Scheme.{u}) {A : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)},
      letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
      ∀ (X : Abelian.Ext A (wcIntUnit S ℓ) (2 * r)) (N : ℕ),
      N • X = X.comp (Abelian.Ext.mk₀ ((N : ℕ) • 𝟙 (wcIntUnit S ℓ))) (add_zero _) := by
    intro S A X N
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    induction N with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]

  have Padd : ∀ (z : V.left) (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ)
      {P' : SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)}
      (γ : P' ⟶ DΛz.Φ.obj (wcIntSuppObj DV))
      (θ₁ θ₂ : Abelian.Ext (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r)),
      letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) (θ₁ + θ₂)) (zero_add _) =
        (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) θ₁) (zero_add _) +
        (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) θ₂) (zero_add _) := by
    intro z DΛz P' γ θ₁ θ₂
    letI : HasExt (SheafOfModules.{u+1}
      (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
    haveI := DΛz.additive
    haveI := DΛz.presLim
    haveI := DΛz.presColim
    unfold wcIntSuppPullExt
    rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add]
  have Pns : ∀ (z : V.left) (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ)
      {P' : SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)}
      (γ : P' ⟶ DΛz.Φ.obj (wcIntSuppObj DV))
      (θ : Abelian.Ext (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r)) (N : ℕ),
      letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) (N • θ)) (zero_add _) =
        N • (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) θ) (zero_add _) := by
    intro z DΛz P' γ θ N
    letI : HasExt (SheafOfModules.{u+1}
      (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
    exact map_nsmul (AddMonoidHom.mk' (fun θ' =>
      (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) θ') (zero_add _))
      (Padd z DΛz γ)) N θ

  have Prho : ∀ (z : V.left) (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ)
      (hDΛz : wcIntPullCanonical DΛz)
      {P' : SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)}
      (γ : P' ⟶ DΛz.Φ.obj (wcIntSuppObj DV))
      (θ : Abelian.Ext (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r))
      (g : C(↥V.left, ULift.{u+1} ℤ_[ℓ])),
      letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r)
          (θ.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ g)) (add_zero _))) (zero_add _) =
        ((Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) θ) (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z)) ℓ
            (g.comp (V.left.fromSpecStalk z).base.hom))) (add_zero _) := by
    intro z DΛz hDΛz P' γ θ g
    letI : HasExt (SheafOfModules.{u+1}
      (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
    haveI := DΛz.additive
    haveI := DΛz.presLim
    haveI := DΛz.presColim
    have hin : wcIntSuppPullExt DV DΛz (2 * r)
          (θ.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ g)) (add_zero _)) =
        (wcIntSuppPullExt DV DΛz (2 * r) θ).comp
          (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z)) ℓ
            (g.comp (V.left.fromSpecStalk z).base.hom))) (add_zero _) := by
      unfold wcIntSuppPullExt
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, F2 DΛz hDΛz g]
    rw [hin, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hconst : ∀ z : V.left,
      (ContinuousMap.const (↥V.left) (ULift.up.{u+1} a)).comp (V.left.fromSpecStalk z).base.hom =
        ContinuousMap.const _ (ULift.up.{u+1} a) := fun z => rfl

  obtain ⟨x', hx'⟩ : ∃ x' : Abelian.Ext (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r),
      x' = x - τ'.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
        (ContinuousMap.const _ (ULift.up a)))) (add_zero _) := ⟨_, rfl⟩
  have hdecomp : ∀ (z : V.left) (DΛz : wcIntPullData (V.left.fromSpecStalk z) ℓ)
      (hDΛz : wcIntPullCanonical DΛz)
      {P' : SheafOfModules.{u+1} (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)}
      (γ : P' ⟶ DΛz.Φ.obj (wcIntSuppObj DV)),
      letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) x) (zero_add _) =
        (Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) x') (zero_add _) +
        ((Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt DV DΛz (2 * r) τ') (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcIntFun (Spec (V.left.presheaf.stalk z)) ℓ
            (ContinuousMap.const _ (ULift.up a)))) (add_zero _) := by
    intro z DΛz hDΛz P' γ
    letI : HasExt (SheafOfModules.{u+1}
      (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
    have e := Prho z DΛz hDΛz γ τ' (ContinuousMap.const _ (ULift.up a))
    rw [hconst z] at e
    rw [← e, ← Padd z DΛz γ, hx', sub_add_cancel]

  have hρ0 : (Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x') (zero_add _) =
      (ℓ ^ k : ℕ) • w₀ := by
    have e1 := hdecomp z₀ DΛ₀ hDΛ₀ γΛ₀
    have e2 := hx₀
    rw [e1] at e2
    exact add_right_cancel (e2.trans (add_comm _ _))
  have h0 : ((Abelian.Ext.mk₀ γΛ₀).comp (wcIntSuppPullExt DV DΛ₀ (2 * r) x') (zero_add _)).comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (Spec (V.left.presheaf.stalk z₀)) ℓ)))) (add_zero _) = 0 := by
    rw [hρ0, hns (Spec (V.left.presheaf.stalk z₀)) w₀ (ℓ ^ k),
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Limits.cokernel.condition, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have hcrux : ∃ (C : Set V.left) (hC : IsClopen C), z₀ ∈ C ∧
      (x'.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
          (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap)) (add_zero _)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))))
          (add_zero _) = 0 := by
    rcases Nat.eq_zero_or_pos r with hr | hr
    · exact wc_wcontr_int_supp_tors_clopen_kill_deg0 K pY n m r hmr i ℓ hℓ V h1 h2 h3 h4 h5
        DV hDV hepi hr x' k z₀ hz₀ hz₀r D₀ hD₀ hepi₀ DΛ₀ hDΛ₀ γΛ₀ hγΛ₀ h0
    · exact wc_wcontr_int_supp_tors_clopen_kill K pY n m r hmr i ℓ hℓ V h1 h2 h3 h4 h5
        DV hDV hepi (by omega) x' k z₀ hz₀ hz₀r D₀ hD₀ hepi₀ DΛ₀ hDΛ₀ γΛ₀ hγΛ₀ h0
  obtain ⟨C, hC, hz₀C, hkill⟩ := hcrux

  have hSE : (ShortComplex.mk ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))
      (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)))
      (Limits.cokernel.condition _)).ShortExact := by
    haveI := hmono
    have hex : (ShortComplex.mk ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))
        (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ)))
        (Limits.cokernel.condition _)).Exact :=
      ShortComplex.exact_cokernel ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit V.left ℓ))
    exact { exact := hex, mono_f := hmono, epi_g := inferInstance }
  obtain ⟨wV, hwV⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSE
    (x'.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
      (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap)) (add_zero _)) hkill
  have hdiv : x'.comp (Abelian.Ext.mk₀ (wcIntFun V.left ℓ
      (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap)) (add_zero _) =
      (ℓ ^ k : ℕ) • wV := by
    rw [hns V.left wV (ℓ ^ k)]
    exact hwV.symm

  refine ⟨C, hC.isOpen, hz₀C, ?_⟩
  intro z hzC hz hzr Dz hDz hepiz DΛz hDΛz γΛz hγΛz
  letI : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  refine ⟨(Abelian.Ext.mk₀ γΛz).comp (wcIntSuppPullExt DV DΛz (2 * r) wV) (zero_add _), ?_⟩
  have hχ : (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap.comp
      (V.left.fromSpecStalk z).base.hom = 1 := by
    apply ContinuousMap.ext
    intro p
    have hp : V.left.fromSpecStalk z p ⤳ z := by
      have h := (IsLocalRing.specializes_closedPoint
        (R := ↑(V.left.presheaf.stalk z)) p).map (V.left.fromSpecStalk z).continuous
      rwa [Scheme.fromSpecStalk_closedPoint] at h
    have hmem : V.left.fromSpecStalk z p ∈ C := hp.mem_open hC.isOpen hzC
    show (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC) (V.left.fromSpecStalk z p) = 1
    rw [LocallyConstant.charFn_eq_one]
    exact hmem
  have e1 := Prho z DΛz hDΛz γΛz x'
    (LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hC).toContinuousMap
  rw [hχ, F1, Abelian.Ext.comp_mk₀_id, hdiv, Pns z DΛz γΛz] at e1
  rw [hdecomp z DΛz hDΛz γΛz, ← e1, add_comm]

theorem wc_int_supp_pull_comp_exists {T V T' V' T'' V'' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {i : T ⟶ V} {i' : T' ⟶ V'} {i'' : T'' ⟶ V''}
    (f : V' ⟶ V) (f' : V'' ⟶ V') (k : V'' ⟶ V) (hk : f' ≫ f = k)
    (D : wcHMPullData i ℓ) (D' : wcHMPullData i' ℓ) (D'' : wcHMPullData i'' ℓ)
    (Df : wcIntPullData f ℓ) (hDf : wcIntPullCanonical Df)
    (Df' : wcIntPullData f' ℓ) (hDf' : wcIntPullCanonical Df')
    (Dk : wcIntPullData k ℓ) (hDk : wcIntPullCanonical Dk)
    (γ₁ : wcIntSuppObj D' ⟶ Df.Φ.obj (wcIntSuppObj D))
    (hγ₁ : wcIntSuppπ D' ≫ γ₁ = Df.μ.inv ≫ Df.Φ.map (wcIntSuppπ D))
    (γ₂ : wcIntSuppObj D'' ⟶ Df'.Φ.obj (wcIntSuppObj D'))
