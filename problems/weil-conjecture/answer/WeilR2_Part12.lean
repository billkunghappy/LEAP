    obtain ⟨ε₀, hε⟩ := (s1 (Scheme.ProEt.mk (𝟙 E)) ((SheafOfModules.toSheaf.{u+1}
      (wcRingSheaf E ℓ)).obj (SheafOfModules.unit (wcRingSheaf E ℓ)))).2
      (1 : (wcRingSheaf E ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk (𝟙 E))))
    let ε : wcFreeSheaf E (Scheme.ProEt.mk (𝟙 E)) ⟶ (SheafOfModules.toSheaf.{u+1}
      (wcRingSheaf E ℓ)).obj (SheafOfModules.unit (wcRingSheaf E ℓ)) := ε₀
    have Hε : ∀ M : SheafOfModules.{u+1} (wcRingSheaf E ℓ),
