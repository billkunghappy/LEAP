theorem wc_ext_ladder_middle_injective : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] {D : Type*} [Category D] [Abelian D] [HasExt D] (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] (S : ShortComplex C) (hS : S.ShortExact) (T : ShortComplex D) (hT : T.ShortExact) (φ : T ⟶ S.map F) (M : C) (M' : D) (e : F.obj M ⟶ M'), (∀ k : ℕ, Function.Bijective (fun β : Abelian.Ext S.X₂ M k => (Abelian.Ext.mk₀ φ.τ₂).comp ((Abelian.Ext.mapExactFunctor F β).comp (Abelian.Ext.mk₀ e) (add_zero k)) (zero_add k))) → (∀ k : ℕ, Function.Injective (fun β : Abelian.Ext S.X₁ M k => (Abelian.Ext.mk₀ φ.τ₁).comp ((Abelian.Ext.mapExactFunctor F β).comp (Abelian.Ext.mk₀ e) (add_zero k)) (zero_add k))) → ∀ q : ℕ, Function.Injective (fun β : Abelian.Ext S.X₃ M q => (Abelian.Ext.mk₀ φ.τ₃).comp ((Abelian.Ext.mapExactFunctor F β).comp (Abelian.Ext.mk₀ e) (add_zero q)) (zero_add q)) :=
by
  intro C _ _ _ D _ _ _ F _ _ _ S hS T hT φ M M' e h2 h1 q

  have s1 : ∀ {A B : C} (u : A ⟶ B) {P Q : D} (a : P ⟶ F.obj A) (b : Q ⟶ F.obj B) (c : P ⟶ Q),
      a ≫ F.map u = c ≫ b → ∀ (k : ℕ) (x : Abelian.Ext B M k),
      (Abelian.Ext.mk₀ a).comp ((Abelian.Ext.mapExactFunctor F
          ((Abelian.Ext.mk₀ u).comp x (zero_add k))).comp (Abelian.Ext.mk₀ e) (add_zero k))
          (zero_add k) =
        (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mk₀ b).comp ((Abelian.Ext.mapExactFunctor F x).comp
          (Abelian.Ext.mk₀ e) (add_zero k)) (zero_add k)) (zero_add k) := by
    intro A B u P Q a b c hcomm k x
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc, hcomm,
      ← Abelian.Ext.mk₀_comp_mk₀_assoc]

  have s2 : ∀ (n₀ n₁ : ℕ) (h : 1 + n₀ = n₁) (x₁ : Abelian.Ext S.X₁ M n₀),
      (Abelian.Ext.mk₀ φ.τ₃).comp ((Abelian.Ext.mapExactFunctor F (hS.extClass.comp x₁ h)).comp
          (Abelian.Ext.mk₀ e) (add_zero n₁)) (zero_add n₁) =
        hT.extClass.comp ((Abelian.Ext.mk₀ φ.τ₁).comp ((Abelian.Ext.mapExactFunctor F x₁).comp
          (Abelian.Ext.mk₀ e) (add_zero n₀)) (zero_add n₀)) h := by
    intro n₀ n₁ h x₁
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ φ.τ₃) _ _ (zero_add 1) h (by omega),
      ← ShortComplex.ShortExact.extClass_naturality hT (hS.map_of_exact F) φ,
      Abelian.Ext.comp_assoc_of_second_deg_zero]

  let Ψ : Abelian.Ext S.X₃ M q →+ Abelian.Ext T.X₃ M' q :=
    ((Abelian.Ext.mk₀ φ.τ₃).precomp M' (zero_add q)).comp
      (((Abelian.Ext.mk₀ e).postcomp (F.obj S.X₃) (add_zero q)).comp (F.mapExtAddHom S.X₃ M q))
  have hΨ : ∀ x, Ψ x = (Abelian.Ext.mk₀ φ.τ₃).comp ((Abelian.Ext.mapExactFunctor F x).comp
      (Abelian.Ext.mk₀ e) (add_zero q)) (zero_add q) := fun x => rfl
  have hker : ∀ x : Abelian.Ext S.X₃ M q, (Abelian.Ext.mk₀ φ.τ₃).comp
      ((Abelian.Ext.mapExactFunctor F x).comp (Abelian.Ext.mk₀ e) (add_zero q)) (zero_add q) = 0 →
      x = 0 := by
    intro x hx

    have hy : (Abelian.Ext.mk₀ S.g).comp x (zero_add q) = 0 := by
      apply (h2 q).1
      beta_reduce
      rw [s1 S.g φ.τ₂ φ.τ₃ T.g φ.comm₂₃ q x, hx, Abelian.Ext.comp_zero,
        Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
    cases q with
    | zero =>
      haveI := hS.epi_g
      apply Abelian.Ext.precomp_mk₀_injective_of_epi M S.g
      rw [map_zero]
      exact hy
    | succ n₀ =>
      have hn : 1 + n₀ = n₀ + 1 := by omega
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS M x hy hn
      subst hx₁
      have hd := (s2 n₀ (n₀ + 1) hn x₁).symm.trans hx
      obtain ⟨y₂, hy₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hT M' _ hn hd
      obtain ⟨z₂, hz₂⟩ := (h2 n₀).2 y₂
      beta_reduce at hz₂
      have hz : (Abelian.Ext.mk₀ S.f).comp z₂ (zero_add n₀) = x₁ := by
        apply h1 n₀
        beta_reduce
        rw [s1 S.f φ.τ₁ φ.τ₂ T.f φ.comm₁₂ n₀ z₂, hz₂, hy₂]
      rw [← hz]
      first
        | exact ShortComplex.ShortExact.extClass_comp_assoc hS z₂
        | simp [ShortComplex.ShortExact.extClass_comp_assoc]
  have key : Function.Injective Ψ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [hΨ] at hx
    exact hker x hx
  exact key

theorem wc_proet_open_free_zmod_inj_vanish : ∀ {Y T : Scheme.{u}} (g : T ⟶ Y) [IsOpenImmersion g] [CompactSpace T] [QuasiSeparatedSpace T] (N : ℕ), 0 < N → ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Y N)) [Injective I] (n : ℕ) (e : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk g)) ((wcEpsInv Y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj I)) (n + 1)), e = 0 :=
