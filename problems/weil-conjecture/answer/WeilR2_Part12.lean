theorem wc_ldpi_oai_proj_gen (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1))
    (x : Γ(wcProjK K n, wcSgD K n J)) :
    x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
      (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) :=
by
