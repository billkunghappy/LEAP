        obtain ⟨β, hβ⟩ := hθ W (𝟙 W) inferInstance hkill (Limits.pullback gV (𝟙 W))
          (Limits.pullback.snd gV (𝟙 W)) (Limits.pullback.fst gV (𝟙 W))
          (IsPullback.of_hasPullback gV (𝟙 W))
        obtain ⟨S'', s'', hs'', hxs'', hdie⟩ := wc_et_zmodext_pos_locally_zero W ℓ hℓ0 k hk1 β x
        haveI : Etale s'' := hs''
        refine ⟨S'', s'' ≫ 𝟙 W, inferInstance, ?_, ?_⟩
        · obtain ⟨y, hy⟩ := hxs''
