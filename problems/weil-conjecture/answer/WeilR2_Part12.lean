      have hx : ∀ t, PadicInt.toZModPow m (f t).down = 0 := by
        intro t
        have := congrArg
          (fun z : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m))) => (z t).down) hr
        exact this
      obtain ⟨c, hc⟩ := hdiv _ ⟨fun t => (f t).down, continuous_uliftDown.comp f.continuous⟩ hx
      let s : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) :=
