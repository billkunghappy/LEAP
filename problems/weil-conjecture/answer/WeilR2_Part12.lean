          ((Abelian.Ext.mapExactFunctor Dz.Φ (Abelian.Ext.mapExactFunctor
              (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap T ℓ k)) a)).comp
            (Abelian.Ext.mk₀ (ν.hom.app (SheafOfModules.unit (wcZModRingSheaf T (ℓ ^ k)))))
            (add_zero q)) (zero_add q) := by
      rw [hnat, Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id_app, Abelian.Ext.mk₀_id_comp]
    have hdeg : wcUnitRestrict
          (wcIntZModRingSheafMap (Limits.pullback (W₀.fromSpecStalk z) g) ℓ k) ≫
        (SheafOfModules.restrictScalars.{u+1}
          (wcIntZModRingSheafMap (Limits.pullback (W₀.fromSpecStalk z) g) ℓ k)).map Dk.μ.inv ≫
