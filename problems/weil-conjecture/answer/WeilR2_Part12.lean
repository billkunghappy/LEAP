  rcases Nat.eq_zero_or_pos r with hr | hr
  ·
    subst hr
    have key : ∀ v w : wcSuppExt DT 0, v ≠ 0 →
        ∃ c : ℚ_[ℓ], w = v.comp (Abelian.Ext.mk₀ (wcHMConst (Spec R) ℓ c)) (add_zero 0) := by
      intro v w hv
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 v
      obtain ⟨f', rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 w
      obtain ⟨a, ha⟩ := wc_hm_unit_end_const (Spec R) ℓ (wcSuppUnitMap DT ≫ f)
      obtain ⟨b, hb⟩ := wc_hm_unit_end_const (Spec R) ℓ (wcSuppUnitMap DT ≫ f')
      have ha0 : a ≠ 0 := by
        rintro rfl
        apply hv
        have hf0 : f = 0 := by
          rw [← cancel_epi (wcSuppUnitMap DT), ha, hC0, Limits.comp_zero]
        rw [hf0, Abelian.Ext.mk₀_zero]
      refine ⟨b / a, ?_⟩
      rw [Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [← cancel_epi (wcSuppUnitMap DT), hb, ← Category.assoc, ha, ← hCmul,
        mul_div_cancel₀ _ ha0]
    exact key v w hv
  ·
    have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
    have hrc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
    obtain ⟨U, hU⟩ : ∃ U : Y.Opens, (U : Set Y) = (Set.range i)ᶜ := ⟨⟨_, hrc.isOpen_compl⟩, rfl⟩
    haveI : IsClosedImmersion iT :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP inferInstance
    have hrangeT : Set.range iT = k ⁻¹' Set.range i := by
      rw [← Scheme.Pullback.range_snd i k]
      ext x
      constructor
      · rintro ⟨t, rfl⟩
        refine ⟨hP.isoPullback.hom t, ?_⟩
        have h := Scheme.Hom.comp_apply hP.isoPullback.hom (Limits.pullback.snd i k) t
        rw [hP.isoPullback_hom_snd] at h
        exact h.symm
      · rintro ⟨t, rfl⟩
        refine ⟨hP.isoPullback.inv t, ?_⟩
        have h := Scheme.Hom.comp_apply hP.isoPullback.inv iT t
        rw [hP.isoPullback_inv_snd] at h
        exact h.symm
    have hWo : ((k ⁻¹ᵁ U : (Spec R).Opens) : Set (Spec R)) = (Set.range iT)ᶜ := by
      rw [hrangeT, Scheme.Hom.coe_preimage, hU, Set.preimage_compl]
    have hPU := isPullback_morphismRestrict k U
    have hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Spec R), ∃ (N : ℕ) (f : Fin N → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range iT ↔ ∃ a, x ∈ W.basicOpen (f a)) := by
      intro W _ p
      obtain ⟨N, f, hf⟩ := wc_affine_complement_basicOpen_cover i W (p ≫ k)
      refine ⟨N, f, fun x => ?_⟩
      rw [← hf x, hrangeT, Set.mem_preimage, Scheme.Hom.comp_apply]
    obtain ⟨Dw, hDw⟩ := wc_hm_pull_data_exists (k ⁻¹ᵁ U).ι ℓ
    obtain ⟨δ, hlift, -, hlin⟩ := wc_supp_les_open_boundary_scalar iT DT hDT hepi
      (fun U' kk W g hW => wc_supp_kernel_section_local_cover_qc iT hqc DT hDT U' kk W g hW)
      (k ⁻¹ᵁ U) hWo Dw hDw (2 * r - 1) (2 * r) (by omega)

    have hvanR : ∀ q : ℕ, ∀ x : wcHM (Spec R) ℓ (q + 1), x = 0 := by
      intro q x
      obtain ⟨Θ, -⟩ := wc_hm_ladic_bridge (Spec R) ℓ (q + 1)
      haveI : Projective (wcFreeSheaf (Spec R) (Scheme.ProEt.mk (𝟙 (Spec R)))) :=
