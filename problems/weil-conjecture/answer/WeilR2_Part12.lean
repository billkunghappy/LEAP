  have hinj : ∀ T : S.ProEt, Function.Injective (ι.hom.app (Opposite.op T)).hom := by
    intro T
    have h1 : Mono (ι.hom.app (Opposite.op T)) :=
      (NatTrans.mono_iff_mono_app ι.hom).1 hmono (Opposite.op T)
    exact (AddCommGrpCat.mono_iff_injective _).1 h1
  have s2 : ∀ (U : V.left.Etale) (y : (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n).obj (Opposite.op U)),
      ∃ k, (ι.hom.app (Opposite.op ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)))).hom k =
        (ContinuousMap.const _ y.1 :
          C(↥((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)).left, ULift.{u+1} (ZMod n))) := by
    intro U y
    refine (hF _ _).2 ?_
    intro z hz
    show y.1 = 0
    have hz' : V.hom (U.hom z) ∈ C := by
      first
        | exact hz
        | (rw [← Scheme.Hom.comp_apply]; exact hz)
        | (rw [← Scheme.comp_base_apply]; exact hz)
    have hp : ¬ (∀ x : ↥((𝟭 Scheme).obj U.left), U.hom x ∈ (V.hom ⁻¹' C)ᶜ) :=
      fun h => h z hz'
    have key : ∀ a : ULift.{u+1} (ZMod n),
        a ∈ wcSuppSub n (∀ x : ↥((𝟭 Scheme).obj U.left), U.hom x ∈ (V.hom ⁻¹' C)ᶜ) → a = 0 := by
      intro a ha
      have hbot : wcSuppSub n (∀ x : ↥((𝟭 Scheme).obj U.left), U.hom x ∈ (V.hom ⁻¹' C)ᶜ) = ⊥ :=
        iSup_neg hp
      rw [hbot] at ha
      exact (AddSubgroup.mem_bot).1 ha
    exact key y.1 y.2
  choose k hk using s2
  have hadd : ∀ (U : V.left.Etale) (a b : (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n).obj (Opposite.op U)),
      k U (a + b) = k U a + k U b := by
    intro U a b
    apply hinj
    rw [map_add, hk U a, hk U b, hk U (a + b)]
    all_goals exact ContinuousMap.ext fun z => rfl
  let θpre : wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n ⟶
      (((wcEtToProEt V.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology V.left) (Scheme.ProEt.topology V.left)).obj
            ((wcLpscG S V).obj F)).obj :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk' (k U.unop) (hadd U.unop))
      naturality := by
        intro U U' f
        ext y
        apply hinj ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U'.unop))
        have hnat := congrArg (fun φ => φ.hom (k U.unop y))
          (ι.hom.naturality ((wcSliceFunctor S V).map ((wcEtToProEt V.left).map f.unop)).op)
        simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hnat
        rw [hk] at hnat
        refine (hk U'.unop (((wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n).map f).hom y)).trans
          (Eq.trans ?_ hnat.symm)
        exact ContinuousMap.ext fun z => rfl }
  refine ⟨ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology V.left) θpre
    (((wcEtToProEt V.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology V.left) (Scheme.ProEt.topology V.left)).obj
        ((wcLpscG S V).obj F)).property), ?_⟩
  intro U y z
  have e := congrArg (fun φ => (φ.app (Opposite.op U)).hom y)
    (toSheafify_sheafifyLift (Scheme.smallEtaleTopology V.left) θpre
      (((wcEtToProEt V.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology V.left) (Scheme.ProEt.topology V.left)).obj
          ((wcLpscG S V).obj F)).property)
  simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at e
  have e3 := (congrArg (ι.hom.app (Opposite.op
    ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)))).hom e).trans (hk U y)
  exact congrArg (fun w : C(↥((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)).left,
    ULift.{u+1} (ZMod n)) => w z) e3

theorem wc_slice_vanSub_theta_locSurj (S : Scheme.{u}) (V : S.ProEt) (C : Set S) (hC : IsClosed C) (n : ℕ)
    (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ι : F ⟶ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n)).obj (SheafOfModules.unit (wcZModRingSheaf S n)))
    (hm : Mono ι)
    (hF : ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n)).obj (SheafOfModules.unit (wcZModRingSheaf S n))).obj.obj (Opposite.op T)),
      (∃ k, (ι.hom.app (Opposite.op T)).hom k = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} (ZMod n)) from f) z = 0)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcEtToProEt V.left).IsContinuous (Scheme.smallEtaleTopology V.left) (Scheme.ProEt.topology V.left)]
    (θ : wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n ⟶
        ((wcEtToProEt V.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology V.left) (Scheme.ProEt.topology V.left)).obj ((wcLpscG S V).obj F))
    (hθ : ∀ (U : V.left.Etale) (y : (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n).obj (Opposite.op U))
        (z : ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)).left),
        (show C(↥((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)).left, ULift.{u+1} (ZMod n)) from
          (ι.hom.app (Opposite.op ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)))).hom
            ((θ.hom.app (Opposite.op U)).hom
              (((toSheafify (Scheme.smallEtaleTopology V.left) (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n)).app
                (Opposite.op U)).hom y))) z = y.1) :
    ∀ (T : V.left.ProEt) (s : ((wcLpscG S V).obj F).obj.obj (Opposite.op T)),
      Sieve.generate (fun (W : V.left.ProEt) (g : W ⟶ T) => ∃ (V₁ : V.left.Etale)
        (c : W ⟶ (wcEtToProEt V.left).obj V₁) (t : (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n).obj.obj (Opposite.op V₁)),
        (((wcLpscG S V).obj F).obj.map g.op).hom s =
          (((wcLpscG S V).obj F).obj.map c.op).hom ((θ.hom.app (Opposite.op V₁)).hom t))
        ∈ Scheme.ProEt.topology V.left T :=
by
  intro T s

  haveI := hm
  have hinj : ∀ T' : S.ProEt, Function.Injective (ι.hom.app (Opposite.op T')).hom := by
    intro T'
    have h1 : Mono (ι.hom.app (Opposite.op T')) :=
      Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op T')) ι
    exact (AddCommGrpCat.mono_iff_injective _).mp h1

  let f : C(↥T.left, ULift.{u+1} (ZMod n)) :=
    (ι.hom.app (Opposite.op ((wcSliceFunctor S V).obj T))).hom s
  have hvan : ∀ z : ↥T.left, V.hom (T.hom z) ∈ C → f z = 0 := by
    intro z hz
    refine (hF ((wcSliceFunctor S V).obj T) _).mp ⟨s, rfl⟩ z ?_
    show (T.hom ≫ V.hom) z ∈ C
    rw [Scheme.Hom.comp_apply]
    exact hz

  let O : ULift.{u+1} (ZMod n) → T.left.Opens := fun a =>
    ⟨f ⁻¹' {a}, f.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
  have hfib : ∀ (a : ULift.{u+1} (ZMod n)) (w : ↥(O a)), f ((O a).ι w) = a := by
    intro a w
    rw [Scheme.Opens.ι_apply]
    exact w.2
  haveI := T.prop
  let Wp : ULift.{u+1} (ZMod n) → V.left.ProEt := fun a => Scheme.ProEt.mk ((O a).ι ≫ T.hom)
  let g : ∀ a, Wp a ⟶ T := fun a => MorphismProperty.Over.homMk (O a).ι rfl trivial

  have hcov : ∀ x : ↥T.left, ∃ (i : ULift.{u+1} (ZMod n)) (y : ↥(O i).toScheme),
      (O i).ι y = x := fun x =>
    ⟨f x, ⟨x, rfl⟩, Scheme.Opens.ι_apply _ _⟩
  let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T.left :=
    Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} (ZMod n))
      (fun i => (O i).toScheme) (fun i => (O i).ι) hcov (fun i => inferInstance)
  have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
    @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
      (fun i => (Scheme.Hom.isOpenEmbedding (O i).ι).isOpenMap)
  have hR : Presieve.ofArrows (fun i : ULift.{u+1} (ZMod n) => (O i).toScheme)
      (fun i => (O i).ι) ∈ Scheme.proetalePrecoverage.coverings T.left :=
    Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
  have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget V.left ⋙ Over.forget V.left)
    (Y := Wp) g
  have hR' : Presieve.ofArrows Wp g ∈ (Scheme.ProEt.precoverage V.left).coverings T :=
    Precoverage.mem_comap_iff.mpr (e ▸ hR)
  have hRJ : Sieve.generate (Presieve.ofArrows Wp g) ∈ (Scheme.ProEt.topology V.left) T :=
    Precoverage.generate_mem_toGrothendieck hR'

  refine (Scheme.ProEt.topology V.left).superset_covering ?_ hRJ
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨a⟩
  apply Sieve.le_generate

  have key : ∀ (V₁ : V.left.Etale) (c : Wp a ⟶ (wcEtToProEt V.left).obj V₁)
      (y : (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n).obj (Opposite.op V₁)), y.1 = a →
      ∃ (V₁ : V.left.Etale) (c : Wp a ⟶ (wcEtToProEt V.left).obj V₁)
        (t : (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n).obj.obj (Opposite.op V₁)),
        (((wcLpscG S V).obj F).obj.map (g a).op).hom s =
          (((wcLpscG S V).obj F).obj.map c.op).hom ((θ.hom.app (Opposite.op V₁)).hom t) := by
    intro V₁ c y hy
    refine ⟨V₁, c, ((toSheafify (Scheme.smallEtaleTopology V.left)
      (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n)).app (Opposite.op V₁)).hom y, ?_⟩
    apply hinj ((wcSliceFunctor S V).obj (Wp a))
    have n1 := NatTrans.naturality_apply ι.hom ((wcSliceFunctor S V).map (g a)).op s
    have n2 := NatTrans.naturality_apply ι.hom ((wcSliceFunctor S V).map c).op
      ((θ.hom.app (Opposite.op V₁)).hom (((toSheafify (Scheme.smallEtaleTopology V.left)
        (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n)).app (Opposite.op V₁)).hom y))
    refine n1.trans (Eq.trans ?_ n2.symm)
    have hfun : ∀ (x y : C(↥(Wp a).left, ULift.{u+1} (ZMod n))), (∀ w, x w = y w) → x = y :=
      fun x y h => ContinuousMap.ext h
    refine hfun _ _ (fun w => ?_)
    have hr := hθ V₁ y (c.left w)
    exact (hfib a w).trans (hy.symm.trans hr.symm)
  by_cases ha : a = 0

  · refine key (Scheme.Etale.mk (𝟙 V.left))
      (MorphismProperty.Over.homMk (Wp a).hom (Category.comp_id _) trivial) 0 ?_
    exact ha.symm

  · let U₀ : V.left.Opens :=
      ⟨(V.hom ⁻¹' C)ᶜ, isOpen_compl_iff.mpr (hC.preimage V.hom.continuous)⟩
    have hrange : Set.range (Wp a).hom ⊆ Set.range U₀.ι := by
      rintro _ ⟨w, rfl⟩
      rw [Scheme.Opens.range_ι]
      intro hmem
      apply ha
      rw [← hfib a w]
      apply hvan
      exact hmem
    have hp : ∀ x, (Scheme.Etale.mk U₀.ι).hom x ∈ (V.hom ⁻¹' C)ᶜ := fun x => by
      have hx : U₀.ι (show ↥U₀ from x) ∈ (V.hom ⁻¹' C)ᶜ := by
        rw [Scheme.Opens.ι_apply]
        exact (show ↥U₀ from x).2
      exact hx
    have mem : a ∈ wcSuppSub.{u} n (∀ x, (Scheme.Etale.mk U₀.ι).hom x ∈ (V.hom ⁻¹' C)ᶜ) := by
      unfold wcSuppSub
      exact AddSubgroup.mem_iSup_of_mem hp (AddSubgroup.mem_top a)
    haveI hU₀ : IsOpenImmersion U₀.ι := inferInstance
    let c₀ : (Wp a).left ⟶ U₀.toScheme := IsOpenImmersion.lift U₀.ι (Wp a).hom hrange
    have hc₀ : c₀ ≫ U₀.ι = (Wp a).hom := IsOpenImmersion.lift_fac _ _ hrange
    exact key (Scheme.Etale.mk U₀.ι)
      (MorphismProperty.Over.homMk c₀ hc₀ trivial)
      (⟨a, mem⟩ : ↥(wcSuppSub.{u} n (∀ x, (Scheme.Etale.mk U₀.ι).hom x ∈ (V.hom ⁻¹' C)ᶜ))) rfl

theorem wc_slice_vanSub_theta_locInj (S : Scheme.{u}) (V : S.ProEt) (C : Set S) (n : ℕ)
    (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ι : F ⟶ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n)).obj (SheafOfModules.unit (wcZModRingSheaf S n)))
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcEtToProEt V.left).IsContinuous (Scheme.smallEtaleTopology V.left) (Scheme.ProEt.topology V.left)]
    (θ : wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n ⟶
        ((wcEtToProEt V.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology V.left) (Scheme.ProEt.topology V.left)).obj ((wcLpscG S V).obj F))
    (hθ : ∀ (U : V.left.Etale) (y : (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n).obj (Opposite.op U))
        (z : ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)).left),
        (show C(↥((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)).left, ULift.{u+1} (ZMod n)) from
          (ι.hom.app (Opposite.op ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj U)))).hom
            ((θ.hom.app (Opposite.op U)).hom
              (((toSheafify (Scheme.smallEtaleTopology V.left) (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n)).app
                (Opposite.op U)).hom y))) z = y.1) :
    ∀ (V₁ : V.left.Etale) (t : (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n).obj.obj (Opposite.op V₁))
      (T : V.left.ProEt) (a : T ⟶ (wcEtToProEt V.left).obj V₁),
      (((wcLpscG S V).obj F).obj.map a.op).hom ((θ.hom.app (Opposite.op V₁)).hom t) = 0 →
      Sieve.generate (fun (W : V.left.ProEt) (g : W ⟶ T) => ∃ (V₂ : V.left.Etale) (b : V₂ ⟶ V₁)
        (a' : W ⟶ (wcEtToProEt V.left).obj V₂),
        a' ≫ (wcEtToProEt V.left).map b = g ≫ a ∧
          ((wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n).obj.map b.op).hom t = 0)
        ∈ Scheme.ProEt.topology V.left T :=
by
  intro V₁ t T a ha
  classical
  haveI hls := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology V.left)
    (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n)
  have hR := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology V.left)
    (toSheafify (Scheme.smallEtaleTopology V.left) (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n))
    (U := Opposite.op V₁) t
  have hP := (Scheme.ProEt.topology V.left).pullback_stable a
    ((CoverPreserving.of_isContinuous (wcEtToProEt V.left) (Scheme.smallEtaleTopology V.left)
      (Scheme.ProEt.topology V.left)).cover_preserve hR)
  refine (Scheme.ProEt.topology V.left).transitive hP _ ?_
  intro W g hg
  rw [Sieve.pullback_apply, Sieve.functorPushforward_apply, Presieve.functorPushforward.eq_1] at hg
  obtain ⟨V₂, r, h, hr, hga⟩ := hg
  obtain ⟨b, hb⟩ := Eq.mp (Presheaf.imageSieve_apply _ t V₂ r) hr
  rcases isEmpty_or_nonempty W.left with hW | ⟨⟨w₀⟩⟩
  · exact (Scheme.ProEt.topology V.left).superset_covering bot_le
      (Scheme.ProEt.bot_mem_topology W)
  · apply (Scheme.ProEt.topology V.left).covering_of_eq_top
    apply Sieve.pullback_eq_top_of_mem
    apply Sieve.le_generate
    refine ⟨V₂, r, h, hga.symm, ?_⟩
    have hgoal : ((wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n).obj.map r.op).hom t =
        ((toSheafify (Scheme.smallEtaleTopology V.left)
          (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n)).app (Opposite.op V₂)).hom b := hb.symm
    have hθnat := NatTrans.naturality_apply θ.hom r.op t
    set x := (θ.hom.app (Opposite.op V₂)).hom
      (((toSheafify (Scheme.smallEtaleTopology V.left)
        (wcEtExtZeroPre V.left (V.hom ⁻¹' C)ᶜ n)).app (Opposite.op V₂)).hom b) with hxdef
    have hx : x = (((wcLpscG S V).obj F).obj.map ((wcEtToProEt V.left).map r).op).hom
        ((θ.hom.app (Opposite.op V₁)).hom t) := by
      rw [hxdef, ← hgoal]
      exact hθnat
    have hkill : (((wcLpscG S V).obj F).obj.map h.op).hom x = 0 := by
      rw [hx]
      change ((((wcLpscG S V).obj F).obj.map ((wcEtToProEt V.left).map r).op ≫
        ((wcLpscG S V).obj F).obj.map h.op).hom) _ = 0
      rw [← Functor.map_comp, ← op_comp, ← hga, op_comp, Functor.map_comp,
        AddCommGrpCat.hom_comp]
      exact (congrArg (AddCommGrpCat.Hom.hom (((wcLpscG S V).obj F).obj.map g.op)) ha).trans
        (map_zero _)
    have hι := NatTrans.naturality_apply ι.hom ((wcSliceFunctor S V).map h).op x
    have e2 : ((((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n)).obj
        (SheafOfModules.unit (wcZModRingSheaf S n))).obj.map ((wcSliceFunctor S V).map h).op).hom
        ((ι.hom.app (Opposite.op ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj V₂)))).hom x))
        = 0 := by
      refine hι.symm.trans ?_
      change (ι.hom.app (Opposite.op ((wcSliceFunctor S V).obj W))).hom
        ((F.obj.map ((wcSliceFunctor S V).map h).op).hom x) = 0
      rw [show (F.obj.map ((wcSliceFunctor S V).map h).op).hom x = 0 from hkill, map_zero]
    have e3 : (show C(↥((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj V₂)).left,
        ULift.{u+1} (ZMod n)) from
        (ι.hom.app (Opposite.op ((wcSliceFunctor S V).obj ((wcEtToProEt V.left).obj V₂)))).hom x)
        (h.left w₀) = 0 := by
      have := congrArg (fun s => (show C(↥((wcSliceFunctor S V).obj W).left,
        ULift.{u+1} (ZMod n)) from s) w₀) e2
      exact this
    have hθb := hθ V₂ b (h.left w₀)
    have hb0 : b = 0 := by
      apply Subtype.ext
      rw [← hθb]
      exact e3
    rw [hgoal, hb0]
    exact map_zero _

theorem wc_proet_vanishing_subsheaf_zmod_of_et (S : Scheme.{u}) (V : S.ProEt) [CompactSpace V.left]
    [IsSeparated (Limits.terminal.from V.left)] (C : Set S) (hC : IsClosed C) (n : ℕ) (hn : 0 < n)
    (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ι : F ⟶ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n)).obj (SheafOfModules.unit (wcZModRingSheaf S n)))
    (hm : Mono ι)
    (hF : ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n)).obj (SheafOfModules.unit (wcZModRingSheaf S n))).obj.obj (Opposite.op T)),
      (∃ k, (ι.hom.app (Opposite.op T)).hom k = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} (ZMod n)) from f) z = 0)
    (het : ∀ q : ℕ, Subsingleton (wcEtExt V.left (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n) (q + 1))) :
    ∀ (j : ℕ) (y : Abelian.Ext (wcFreeSheaf S V) F (j + 1)), y = 0 :=
by
  classical
  intro j y
  obtain ⟨hsc, -, -⟩ := wc_lpsc_site S V
  haveI := hsc
  obtain ⟨-, hεc⟩ := wc_etToProEt_flat_cont V.left
  haveI := hεc
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology V.left) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E₁⟩ := wc_ext_free_slice_sheaf S V F (j + 1)
  obtain ⟨θ, hθ⟩ := wc_slice_vanSub_extZero_theta_exists S V C n F ι hm hF
  have hs := wc_slice_vanSub_theta_locSurj S V C hC n F ι hm hF θ hθ
  have hi := wc_slice_vanSub_theta_locInj S V C n F ι θ hθ
  obtain ⟨e⟩ := wc_epsInv_iso_of_lan_criterion V.left (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n)
    ((wcLpscG S V).obj F) θ hs hi
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B (j + 1) ≃ Abelian.Ext A B' (j + 1)) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero (j + 1))
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (j + 1))
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j + 1)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (j + 1)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf V.left (Scheme.ProEt.mk (𝟙 V.left))) e.symm
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep V.left
    (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n) (j + 1)
  let E : Abelian.Ext (wcFreeSheaf S V) F (j + 1) ≃
      wcEtExt V.left (wcEtExtZero V.left (V.hom ⁻¹' C)ᶜ n) (j + 1) :=
    (E₁.trans E₂).trans E₀
  haveI := het j
  apply E.injective
  exact Subsingleton.elim _ _

theorem wc_et_wstrictly_local_vanish (Δ : Scheme.{u}) (hA : IsAffine Δ)
    (hc : IsClosed {x : Δ | IsClosed ({x} : Set Δ)})
    (hu : ∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y)
    (he : ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)})
    (hs : ∀ x : Δ, IsClosed ({x} : Set Δ) → HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x))
    (F : Sheaf (Scheme.smallEtaleTopology Δ) AddCommGrpCat.{u+1}) (q : ℕ) :
    Subsingleton (wcEtExt Δ F (q + 1)) :=
by
  classical
  haveI := hA
  have hret := wc_wlocal_strictHensel_retraction Δ hA hc hu he hs
  let T : Δ.Etale := Scheme.Etale.mk (𝟙 Δ)
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  have href : ∀ R : Sieve T, R ∈ (Scheme.smallEtaleTopology Δ) T →
      ∃ (n : ℕ) (O : Fin n → Δ.Opens), (∀ i j, i ≠ j → ∀ y : Δ, y ∈ O i → y ∈ O j → False) ∧
        (∀ y : Δ, ∃ i, y ∈ O i) ∧ ∀ i, ∃ g : Scheme.Etale.mk (O i).ι ⟶ T, R.arrows g := by
    intro R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Δ T at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Δ
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Δ
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ T R).mp hR
    have hloc : ∀ x : Δ, ∃ (P : Δ.Etale) (c : P ⟶ T), R.arrows c ∧ IsAffine P.left ∧
        x ∈ Set.range P.hom := by
      intro x
      obtain ⟨Y₁, f, y, hf, -, hy⟩ := hR' x
      obtain ⟨a, ha⟩ := Y₁.left.affineCover.covers y
      haveI : Etale Y₁.hom := Y₁.prop
      let V' : Δ.Etale := MorphismProperty.Over.mk ⊤
        (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) ≫ Y₁.hom)
        (inferInstance : Etale (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) ≫ Y₁.hom))
      let h : V' ⟶ Y₁ := MorphismProperty.Over.homMk
        (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y)) rfl trivial
      refine ⟨V', h ≫ f, R.downward_closed hf h, ?_, a, ?_⟩
      · show IsAffine (Y₁.left.affineCover.X (Y₁.left.affineCover.idx y))
        infer_instance
      · have hw : f.left = Y₁.hom :=
          (Category.comp_id f.left).symm.trans (MorphismProperty.Over.w f)
        have hy' : Y₁.hom y = x := (congrArg (fun g => g y) hw).symm.trans hy
        change Y₁.hom (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) a) = x
        rw [ha]
        exact hy'
    choose P c hcR hPA hxP using hloc
    have hopen : ∀ x : Δ, IsOpen (Set.range (P x).hom) := by
      intro x
      haveI : Etale (P x).hom := (P x).prop
      exact (P x).hom.isOpenMap.isOpen_range
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => Set.range (P x).hom) hopen
      (fun x _ => Set.mem_iUnion.2 ⟨x, hxP x⟩)
    let e := t.equivFin
    let n := t.card
    let Q : Fin n → Δ.Etale := fun k => P (e.symm k).1
    have hQcov : ∀ x : Δ, ∃ k, x ∈ Set.range (Q k).hom := by
      intro x
      have hx := ht (Set.mem_univ x)
      rw [Set.mem_iUnion₂] at hx
      obtain ⟨i, hi, hx⟩ := hx
      refine ⟨e ⟨i, hi⟩, ?_⟩
      show x ∈ Set.range (P (e.symm (e ⟨i, hi⟩)).1).hom
      rw [Equiv.symm_apply_apply]
      exact hx
    have hQA : ∀ k, IsAffine (Q k).left := fun k => hPA _
    have hWE : ∀ k, WeaklyEtale (Q k).hom := by
      intro k
      haveI : Etale (Q k).hom := (Q k).prop
      infer_instance
    have hpWE : WeaklyEtale (Limits.Sigma.desc (fun k => (Q k).hom)) :=
      IsZariskiLocalAtSource.sigmaDesc (P := @WeaklyEtale) hWE
    have hpS : Surjective (Limits.Sigma.desc (fun k => (Q k).hom)) := by
      constructor
      intro x
      obtain ⟨k, y, hy⟩ := hQcov x
      refine ⟨Limits.Sigma.ι (fun k => (Q k).left) k y, ?_⟩
      rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
      exact hy
    obtain ⟨σ, hσ⟩ := hret (∐ fun k => (Q k).left) (Limits.Sigma.desc (fun k => (Q k).hom))
      inferInstance hpWE hpS
    obtain ⟨O, hmemO⟩ : ∃ O : Fin n → Δ.Opens, ∀ k (x : Δ), x ∈ O k ↔
        σ x ∈ Set.range ⇑(Limits.Sigma.ι (fun k => (Q k).left) k) := by
      refine ⟨fun k => σ ⁻¹ᵁ (Limits.Sigma.ι (fun k => (Q k).left) k).opensRange, ?_⟩
      intro k x
      rw [← Scheme.Hom.coe_opensRange]
      exact Scheme.Hom.mem_preimage σ
    have hfac : ∀ k, ∃ h : (O k).toScheme ⟶ (Q k).left, h ≫ (Q k).hom = (O k).ι := by
      intro k
      have H' : Set.range ⇑((O k).ι ≫ σ) ⊆
          Set.range ⇑(Limits.Sigma.ι (fun k => (Q k).left) k) := by
        rintro _ ⟨z, rfl⟩
        have h2 := (hmemO k z.1).1 z.2
        have e' : ((O k).ι ≫ σ) z = σ z.1 := by
          rw [Scheme.Hom.comp_apply]
          rfl
        rw [e']
        exact h2
      have hιd : Limits.Sigma.ι (fun k => (Q k).left) k ≫ Limits.Sigma.desc (fun k => (Q k).hom) =
          (Q k).hom := Limits.Sigma.ι_comp_desc _ _
      have hl := IsOpenImmersion.lift_fac (Limits.Sigma.ι (fun k => (Q k).left) k) ((O k).ι ≫ σ) H'
      refine ⟨IsOpenImmersion.lift (Limits.Sigma.ι (fun k => (Q k).left) k) ((O k).ι ≫ σ) H', ?_⟩
      calc IsOpenImmersion.lift (Limits.Sigma.ι (fun k => (Q k).left) k) ((O k).ι ≫ σ) H' ≫ (Q k).hom
          = IsOpenImmersion.lift (Limits.Sigma.ι (fun k => (Q k).left) k) ((O k).ι ≫ σ) H' ≫
              (Limits.Sigma.ι (fun k => (Q k).left) k ≫ Limits.Sigma.desc (fun k => (Q k).hom)) := by
            rw [hιd]
        _ = (IsOpenImmersion.lift (Limits.Sigma.ι (fun k => (Q k).left) k) ((O k).ι ≫ σ) H' ≫
              Limits.Sigma.ι (fun k => (Q k).left) k) ≫ Limits.Sigma.desc (fun k => (Q k).hom) :=
            (Category.assoc _ _ _).symm
        _ = ((O k).ι ≫ σ) ≫ Limits.Sigma.desc (fun k => (Q k).hom) := by rw [hl]
        _ = (O k).ι := by rw [Category.assoc, hσ, Category.comp_id]
    have hcov : ∀ x : Δ, ∃ k, x ∈ O k := by
      intro x
      obtain ⟨i, y, hy⟩ := (sigmaOpenCover (fun k => (Q k).left)).exists_eq (σ x)
      exact ⟨i, (hmemO i x).2 ⟨y, hy⟩⟩
    have huniq : ∀ (x : Δ) (j k : Fin n), x ∈ O j → x ∈ O k → j = k := by
      intro x j k hj hk
      obtain ⟨y, hy⟩ := (hmemO j x).1 hj
      obtain ⟨y', hy'⟩ := (hmemO k x).1 hk
      have := (sigmaι_eq_iff (fun k => (Q k).left) j k y y').1 (hy.trans hy'.symm)
      exact congrArg Sigma.fst this
    refine ⟨n, O, fun i j hij y hi hj => hij (huniq y i j hi hj), hcov, fun k => ?_⟩
    obtain ⟨h₀, hh₀⟩ := hfac k
    let b : Scheme.Etale.mk (O k).ι ⟶ Q k :=
      MorphismProperty.Over.homMk (A := Scheme.Etale.mk (O k).ι) (B := Q k) h₀ hh₀ trivial
    exact ⟨b ≫ c (e.symm k).1, R.downward_closed (hcR (e.symm k).1) b⟩

  have hsurjT : ∀ {F₁ G₁ : Sheaf (Scheme.smallEtaleTopology Δ) AddCommGrpCat.{u+1}} (φ : F₁ ⟶ G₁),
      Epi φ → Function.Surjective (φ.hom.app (Opposite.op T)).hom := by
    intro F₁ G₁ φ hφ s
    have h1 : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Δ) φ.hom := h1
    have h2 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Δ) φ.hom s
    obtain ⟨n, O, hdis, hcov, hR⟩ := href _ h2
    choose g hg using hR
    have hpre : ∀ i, ∃ r : F₁.obj.obj (Opposite.op (Scheme.Etale.mk (O i).ι)),
        (φ.hom.app (Opposite.op (Scheme.Etale.mk (O i).ι))).hom r = (G₁.obj.map (g i).op).hom s := by
      intro i
      have h := hg i
      rw [Presheaf.imageSieve_apply] at h
      obtain ⟨r, hr⟩ := h
      exact ⟨r, by first | exact hr | simpa using hr⟩
    choose r hr using hpre
    obtain ⟨b, hb⟩ := wc_et_disjoint_open_cover_coboundary Δ F₁ G₁ φ n O hdis hcov s r
      (fun i g' => by rw [hT.hom_ext g' (g i)]; exact hr i)
    exact ⟨b, hb⟩

  haveI : ((sheafSections (Scheme.smallEtaleTopology Δ) AddCommGrpCat.{u+1}).obj
      (Opposite.op T)).PreservesEpimorphisms := by
    constructor
    intro F₁ G₁ φ hφ
    exact (AddCommGrpCat.epi_iff_surjective _).mpr (hsurjT φ hφ)
  have hP : Projective (AddCommGrpCat.of (ULift.{u+1} ℤ)) := by
    refine ⟨fun {E X} f e he => ?_⟩
    have hs := (AddCommGrpCat.epi_iff_surjective e).mp he
    obtain ⟨y, hy⟩ := hs (f ⟨1⟩)
    refine ⟨AddCommGrpCat.ofHom ((zmultiplesHom E y).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
    ext ⟨n⟩
    have h1 : (⟨n⟩ : ULift.{u+1} ℤ) = n • (⟨1⟩ : ULift.{u+1} ℤ) := by
      ext; simp
    change e (n • y) = f ⟨n⟩
    rw [h1, map_zsmul, map_zsmul, hy]
  have adj := constantSheafAdj (Scheme.smallEtaleTopology Δ) AddCommGrpCat.{u+1} hT
  haveI hproj := adj.map_projective _ hP
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Δ) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  unfold wcEtExt
  exact Abelian.Ext.subsingleton_of_projective _ _ q

theorem wc_hm_kernel_push_acyclic (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z E : Scheme.{u}} (h : Y ⟶ Z) [IsProper h] (sZ : Z ⟶ Spec (.of K)) [IsProper sZ]
    (i : E ⟶ Z) [IsClosedImmersion i]
    (hiso : ∀ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ → IsIso (h ∣_ U))
    (hUZ : ∃ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ ∧ IsAffineOpen U)
    (hUY : ∃ U : Y.Opens, (U : Set ↥Y) = (Set.range (Limits.pullback.fst h i))ᶜ ∧ IsAffineOpen U)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Dh : wcHMPullData h ℓ) (hDh : wcHMPullCanonical Dh)
    (Di' : wcHMPullData (Limits.pullback.fst h i) ℓ) (hDi' : wcHMPullCanonical Di')
    (I : InjectiveResolution (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ))) :
    haveI := Dh.additive
    haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).Additive :=
      Dh.adj.right_adjoint_additive
    ∀ q : ℕ, 1 ≤ q → Limits.IsZero
      ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical
  haveI := Dh.additive
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).Additive :=
    Dh.adj.right_adjoint_additive
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  haveI := Dh.cont
  intro q hq

  obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
  have hCY : IsClosed (Set.range (Limits.pullback.fst h i)) :=
    (Limits.pullback.fst h i).isClosedEmbedding.isClosed_range
  obtain ⟨UZ, hUZs⟩ : ∃ UZ : Z.Opens, (UZ : Set ↥Z) = (Set.range i)ᶜ :=
    ⟨⟨_, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  have hUZiso : IsIso (h ∣_ UZ) := hiso UZ hUZs

  have hisoW : ∀ W' : Z.ProEt, ∀ U : W'.left.Opens,
      (U : Set ↥W'.left) = (Set.range (Limits.pullback.fst W'.hom i))ᶜ →
      IsIso ((Limits.pullback.fst W'.hom h) ∣_ U) := by
    intro W' U hU
    have hUeq : U = W'.hom ⁻¹ᵁ UZ := by
      apply TopologicalSpace.Opens.ext
      ext x
      rw [hU, Scheme.Pullback.range_fst]
      first
        | (change x ∈ (W'.hom ⁻¹' Set.range i)ᶜ ↔ W'.hom x ∈ (UZ : Set ↥Z)
           rw [hUZs]; rfl)
        | simp [hUZs]
    rw [hUeq]
    exact wc_isIso_restrict_pullback_fst W'.hom h UZ hUZiso

  have hset : ∀ W' : Z.ProEt,
      Set.range (Limits.pullback.fst (Limits.pullback.fst W'.hom h) (Limits.pullback.fst W'.hom i)) =
        (Limits.pullback.snd W'.hom h) ⁻¹' Set.range (Limits.pullback.fst h i) := by
    intro W'
    ext x
    simp only [Scheme.Pullback.range_fst, Set.mem_preimage]
    have hx : W'.hom ((Limits.pullback.fst W'.hom h) x) = h ((Limits.pullback.snd W'.hom h) x) := by
      first
        | exact congrArg (fun φ : Limits.pullback W'.hom h ⟶ Z => φ x)
            (Limits.pullback.condition (f := W'.hom) (g := h))
        | rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
        | rw [← Scheme.comp_base_apply, Limits.pullback.condition, Scheme.comp_base_apply]
    rw [hx]

  obtain ⟨ιQ, hQm, hQ⟩ := wc_hm_kernel_toSheaf_vanSub (Limits.pullback.fst h i) ℓ Di' hDi'
  obtain ⟨⟨FZ, ιZ, hZm, hZ⟩, hK⟩ := wc_proet_vanishing_subsheaf_exists (Limits.pullback.fst h i) ℓ
  choose FK ιK hKm hK' using fun k : ℕ => hK (ℓ ^ (k + 1))

  have hvanV : ∀ W' : Z.ProEt, IsAffine W'.left →
      (IsClosed {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
        (∀ x : W'.left, ∃! y : W'.left, IsClosed ({y} : Set W'.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
        (∀ x : W'.left, IsClosed ({x} : Set W'.left) →
          HenselianLocalRing (W'.left.presheaf.stalk x) ∧ IsSepClosed (W'.left.residueField x))) →
      ∀ y : Abelian.Ext (wcFreeSheaf Y ((wcProEtBC h).obj W'))
        ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf Y ℓ)).obj
          (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ))) (j + 1), y = 0 := by
    intro W' hA hQW
    obtain ⟨hc, hu, he, hs⟩ := hQW
    haveI := hA
    haveI hA' : IsAffine ((𝟭 Scheme).obj W'.left) := hA
    haveI hPg : IsProper (Limits.pullback.fst W'.hom h) := by
      first
        | infer_instance
        | exact MorphismProperty.pullback_fst (P := @IsProper) _ _ ‹IsProper h›
    haveI : QuasiCompact (Limits.pullback.fst W'.hom h) := inferInstance
    haveI : QuasiSeparated (Limits.pullback.fst W'.hom h) := inferInstance
    haveI : IsSeparated (Limits.pullback.fst W'.hom h) := inferInstance
    haveI : IsSeparated (Limits.terminal.from W'.left) := inferInstance

    haveI hcpt0 : CompactSpace ↥(Limits.pullback W'.hom h) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst W'.hom h)
    haveI hqs0 : QuasiSeparatedSpace ↥(Limits.pullback W'.hom h) :=
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst W'.hom h)
    haveI hcpt : CompactSpace ↥((wcProEtBC h).obj W').left := hcpt0
    haveI hqs : QuasiSeparatedSpace ↥((wcProEtBC h).obj W').left := hqs0
    haveI hsep : IsSeparated (Limits.terminal.from ((wcProEtBC h).obj W').left) := by
      have e : Limits.terminal.from (Limits.pullback W'.hom h) =
          Limits.pullback.fst W'.hom h ≫ Limits.terminal.from W'.left :=
        Limits.terminal.hom_ext _ _
      show IsSeparated (Limits.terminal.from (Limits.pullback W'.hom h))
      rw [e]
      infer_instance

    have het : ∀ k q : ℕ, Subsingleton (wcEtExt ((wcProEtBC h).obj W').left
        (wcEtExtZero ((wcProEtBC h).obj W').left
          (((wcProEtBC h).obj W').hom ⁻¹' Set.range (Limits.pullback.fst h i))ᶜ (ℓ ^ (k + 1)))
        (q + 1)) := by
      intro k q
      have hm : ℓ ^ (k + 1) ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
      obtain ⟨e⟩ := wc_et_proper_excision W'.left (Limits.pullback W'.hom h)
        (Limits.pullback W'.hom i) (Limits.pullback.fst W'.hom h) (Limits.pullback.fst W'.hom i)
        (hisoW W') (ℓ ^ (k + 1)) hm wc_et_henselian_proper_vanishing (q + 1)
      haveI := wc_et_wstrictly_local_vanish W'.left hA hc hu he hs
        (wcEtExtZero W'.left (Set.range (Limits.pullback.fst W'.hom i))ᶜ (ℓ ^ (k + 1))) q
      have h2 := e.symm.subsingleton
      rw [hset W'] at h2
      exact h2

    have htor : ∀ (k j' : ℕ) (y : Abelian.Ext (wcFreeSheaf Y ((wcProEtBC h).obj W')) (FK k) (j' + 1)),
        y = 0 := fun k j' y =>
      wc_proet_vanishing_subsheaf_zmod_of_et Y ((wcProEtBC h).obj W')
        (Set.range (Limits.pullback.fst h i)) hCY (ℓ ^ (k + 1))
        (pow_pos (Fact.out : ℓ.Prime).pos _) (FK k) (ιK k) (hKm k) (hK' k) (het k) j' y
    have hint := wc_proet_kernel_int_ext_vanish_of_zmod Y ((wcProEtBC h).obj W')
      (Set.range (Limits.pullback.fst h i)) ℓ FZ ιZ hZm hZ FK ιK hKm hK' htor
    exact wc_proet_kernel_rat_ext_vanish_of_int Y ((wcProEtBC h).obj W')
      (Set.range (Limits.pullback.fst h i)) ℓ _ ιQ hQm hQ FZ ιZ hZm hZ hint j

  refine (fun key => ?_) (pushforward_homology_local_basis (wcProEtBC h)
    (wcRingSheaf Z ℓ) (wcRingSheaf Y ℓ) Dh.φ I.cocomplex (j + 1) 0 (fun a => a.elim0)
    (fun a => a.elim0) ?_ ?_)
  · obtain ⟨ι, hinj, hloc⟩ := key
    obtain ⟨ρ, -, hsum⟩ := sheafOfModules_split_of_local_basis _ _ 0 ι hinj hloc
    rw [Fin.sum_univ_zero] at hsum
    exact (Limits.IsZero.iff_id_eq_zero _).2 hsum.symm
  ·
    intro W s hs
    have hcov := wc_proet_cover_of_affine_local
      (fun Δ : Scheme.{u} => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
      (fun V hV => by
        obtain ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩ := wc_exists_wcontractible_cover V hV
        exact ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩) W
    refine (Scheme.ProEt.topology Z).superset_covering ((Sieve.generate_le_iff _ _).2 ?_) hcov
    intro W' g hg
    obtain ⟨hA, hQW⟩ := hg
    refine ⟨W', 𝟙 _, g, ?_, Category.id_comp g⟩
    have hds' : ((I.cocomplex.d (j + 1) (j + 1 + 1)).val.app
        (Opposite.op ((wcProEtBC h).obj W'))).hom
        (((I.cocomplex.X (j + 1)).val.map ((wcProEtBC h).map g).op).hom s) = 0 := by
      erw [PresheafOfModules.naturality_apply, hs, map_zero]
      all_goals rfl
    obtain ⟨P, ev, hnat, hevadd⟩ := sheafOfModules_free_yoneda
      (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ) ((wcProEtBC h).obj W')
    have hev0 : ∀ M, ev M 0 = 0 := fun M => by
      have h0 := hevadd M 0 0
      rw [add_zero] at h0
      exact add_left_cancel (h0.symm.trans (add_zero _).symm)
    obtain ⟨fP, hfPdef⟩ : ∃ fP : P ⟶ I.cocomplex.X (j + 1), ev _ fP =
        ((I.cocomplex.X (j + 1)).val.map ((wcProEtBC h).map g).op).hom s :=
      ⟨(ev _).symm _, Equiv.apply_symm_apply _ _⟩
    have hfP : fP ≫ I.cocomplex.d (j + 1) (j + 1 + 1) = 0 := by
      apply (ev _).injective
      rw [hnat, hfPdef, hds', hev0]
    have hext0 : I.extMk fP (j + 1 + 1) rfl hfP = 0 :=
      wc_proet_module_free_ext_vanish_of_toSheaf Y ℓ ((wcProEtBC h).obj W') P ev hnat _ j
        (hvanV W' hA hQW) _
    obtain ⟨κ, hκ⟩ := injectiveResolution_coboundary_of_extMk_eq_sum I (j + 1) 0 fP hfP
      (fun a => a.elim0) (fun a => a.elim0) (by rw [hext0]; simp)
    refine ⟨fun a => a.elim0, ev _ κ, ?_⟩
    rw [Fin.sum_univ_zero, zero_add, ← hnat, ← hfPdef, hκ, Fin.sum_univ_zero, zero_add]
  ·
    intro W c y _
    refine (Scheme.ProEt.topology Z).superset_covering ?_ ((Scheme.ProEt.topology Z).top_mem W)
    intro W' g _
    exact ⟨W', 𝟙 _, g, fun a => a.elim0, Category.id_comp g⟩

theorem wc_hm_proper_excision_injective (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z E : Scheme.{u}} (h : Y ⟶ Z) [IsProper h] (sZ : Z ⟶ Spec (.of K)) [IsProper sZ]
    (i : E ⟶ Z) [IsClosedImmersion i]
    (hiso : ∀ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ → IsIso (h ∣_ U))
    (hUZ : ∃ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ ∧ IsAffineOpen U)
    (hUY : ∃ U : Y.Opens, (U : Set ↥Y) = (Set.range (Limits.pullback.fst h i))ᶜ ∧ IsAffineOpen U)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Dh : wcHMPullData h ℓ) (hDh : wcHMPullCanonical Dh)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData (Limits.pullback.fst h i) ℓ) (hDi' : wcHMPullCanonical Di')
    (κ : Dh.Φ.obj (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC i) _ _ Di.cont Di.φ)) ⟶
        Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ))
    (hκ : κ ≫ Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ) =
        Dh.Φ.map (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC i) _ _ Di.cont Di.φ)) ≫ Dh.μ.hom)
    (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    haveI := Dh.additive
    haveI := Dh.presLim
    haveI := Dh.presColim
    ∀ c : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Z ℓ))
        (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC i) _ _ Di.cont Di.φ)) n,
      (Abelian.Ext.mk₀ Dh.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor Dh.Φ c).comp (Abelian.Ext.mk₀ κ) (add_zero n))
          (zero_add n) = 0 → c = 0 :=
by
  intro c hc
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  haveI := Dh.additive
  haveI := Dh.presLim
  haveI := Dh.presColim
  haveI hPA : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).Additive :=
    Dh.adj.right_adjoint_additive
  haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)

  have hI := wc_hm_kernel_push_acyclic K h sZ i hiso hUZ hUY ℓ hℓ Dh hDh Di' hDi'
    (injectiveResolution _)

  have hτ := wc_ext_counit_transfer_bijective_of_acyclic Dh.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ) Dh.adj
    (SheafOfModules.unit (wcRingSheaf Z ℓ)) _ (injectiveResolution _) hI n

  have hκ' : Dh.Φ.map (Dh.adj.homEquiv _ _ κ) ≫ Dh.adj.counit.app _ = κ := by
    have e0 := Dh.adj.homEquiv_counit (g := Dh.adj.homEquiv _ _ κ)
    rw [Equiv.symm_apply_apply] at e0
    exact e0.symm

  have key : (Abelian.Ext.mapExactFunctor Dh.Φ
      (c.comp (Abelian.Ext.mk₀ (Dh.adj.homEquiv _ _ κ)) (add_zero n))).comp
        (Abelian.Ext.mk₀ (Dh.adj.counit.app _)) (add_zero n) =
      (Abelian.Ext.mapExactFunctor Dh.Φ c).comp (Abelian.Ext.mk₀ κ) (add_zero n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hκ']

  have h1 : (Abelian.Ext.mapExactFunctor Dh.Φ c).comp (Abelian.Ext.mk₀ κ) (add_zero n) = 0 := by
    have e : (Abelian.Ext.mapExactFunctor Dh.Φ c).comp (Abelian.Ext.mk₀ κ) (add_zero n) =
        (Abelian.Ext.mk₀ Dh.μ.hom).comp ((Abelian.Ext.mk₀ Dh.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor Dh.Φ c).comp (Abelian.Ext.mk₀ κ) (add_zero n))
          (zero_add n)) (zero_add n) := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [e, hc, Abelian.Ext.comp_zero]

  have h2 : c.comp (Abelian.Ext.mk₀ (Dh.adj.homEquiv _ _ κ)) (add_zero n) = 0 := by
    apply hτ.1
    beta_reduce
    rw [key, h1, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp]

  haveI := wc_hm_kernel_adjoint_iso h i hiso ℓ Dh hDh Di hDi Di' hDi' κ hκ
  have e : c = (c.comp (Abelian.Ext.mk₀ (Dh.adj.homEquiv _ _ κ)) (add_zero n)).comp
      (Abelian.Ext.mk₀ (inv (Dh.adj.homEquiv _ _ κ))) (add_zero n) := by
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id,
      Abelian.Ext.comp_mk₀_id]
  rw [e, h2, Abelian.Ext.zero_comp]

theorem wc_hm_birational_top_injective (F' : Type u) [Field F'] [Finite F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom]
    (d : ℕ) [SmoothOfRelativeDimension d Y.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (h : wcXbar F' Y ⟶ Z) [IsProper h]
    (hs : Surjective h) (hW : ∃ W : Z.Opens, W ≠ ⊥ ∧ IsIso (h ∣_ W))
    (sZ : Z ⟶ Spec (.of (AlgebraicClosure F'))) [IsProper sZ] (hsZ : h ≫ sZ = wcPi2 F' Y)
    (Dh : wcHMPullData h ℓ) (hDh : wcHMPullCanonical Dh) :
    Function.Injective (wcHMPull Dh (2 * d)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F' Y) ℓ)) := HasExt.standard _
  haveI := Dh.additive
  haveI := Dh.presLim
  haveI := Dh.presColim
  haveI := hs

  obtain ⟨W, hW0, hWiso⟩ := hW
  haveI := hWiso
  obtain ⟨z, hzW⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp hW0
  obtain ⟨W₀, hW₀aff, hzW₀, hW₀W⟩ := exists_isAffineOpen_mem_and_subset hzW
  have hW₀le : W₀ ≤ W := hW₀W
  have hiso₀ : IsIso (h ∣_ W₀) := by
    have h1 : IsIso (h ∣_ W ∣_ (W.ι ⁻¹ᵁ W₀)) := inferInstance
    have h2 := (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
      (morphismRestrictRestrict h W (W.ι ⁻¹ᵁ W₀))).mp h1
    have h3 : W.ι ''ᵁ (W.ι ⁻¹ᵁ W₀) = W₀ := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hW₀le
    rw [h3] at h2
    exact h2
  haveI := hiso₀

  obtain ⟨E, i, hi, hrange_i⟩ : ∃ (E : Scheme.{u}) (i : E ⟶ Z), IsClosedImmersion i ∧
      Set.range i = (W₀ : Set Z)ᶜ :=
    ⟨_, (Scheme.IdealSheafData.vanishingIdeal ⟨(W₀ : Set Z)ᶜ, W₀.isOpen.isClosed_compl⟩).subschemeι,
      inferInstance, by
        rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
        rfl⟩
  haveI := hi
  have hUZ : ∃ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ ∧ IsAffineOpen U :=
    ⟨W₀, by rw [hrange_i, compl_compl], hW₀aff⟩
  have hUY : ∃ U : (wcXbar F' Y).Opens,
      (U : Set ↥(wcXbar F' Y)) = (Set.range (Limits.pullback.fst h i))ᶜ ∧ IsAffineOpen U := by
    refine ⟨h ⁻¹ᵁ W₀, ?_, IsAffine.of_isIso (h ∣_ W₀) (h := hW₀aff)⟩
    rw [Scheme.Pullback.range_fst, hrange_i, Set.preimage_compl, compl_compl]
    rfl
  have hiso : ∀ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ → IsIso (h ∣_ U) := by
    intro U hU
    have hUW : U = W₀ := by
      apply TopologicalSpace.Opens.ext
      rw [hU, hrange_i, compl_compl]
    rw [hUW]
    exact hiso₀

  haveI hQSZ : QuasiSeparatedSpace ↥Z := quasiSeparatedSpace_of_quasiSeparated sZ
  haveI hQSY : QuasiSeparatedSpace ↥(wcXbar F' Y) := quasiSeparatedSpace_of_quasiSeparated (h ≫ sZ)
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F') ≠ 0 := by
    intro h0
    have h1 : ((ℓ : ℕ) : F') = 0 := by
      apply (algebraMap F' (AlgebraicClosure F')).injective
      rw [map_natCast, map_zero]
      exact h0
    letI := Fintype.ofFinite F'
    haveI := ringChar.charP F'
    have h2 : ((Fintype.card F' : ℕ) : F') = 0 := FiniteField.cast_card_eq_zero F'
    have hp : (ringChar F').Prime := CharP.char_is_prime F' (ringChar F')
    have h3 : ringChar F' ∣ ℓ := ringChar.dvd h1
    have h4 : ringChar F' ∣ Fintype.card F' := ringChar.dvd h2
    have h5 : ringChar F' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out)).mp h3
    apply hℓ
    rw [← h5, Nat.card_eq_fintype_card]
    exact h4

  haveI hsmY : SmoothOfRelativeDimension d (wcPi2 F' Y) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) ‹_›
  have hdimY : topologicalKrullDim ↥(wcXbar F' Y) ≤ (d : WithBot ℕ∞) :=
    wc_smooth_alg_closed_dim_le (AlgebraicClosure F') (wcXbar F' Y) (wcPi2 F' Y) d
  have hdimZ : topologicalKrullDim ↥Z ≤ (d : WithBot ℕ∞) := by
    have h1 := wc_dim_range_closed_map_le (↥(wcXbar F' Y)) (↥Z) h h.continuous h.isClosedMap
    have h2 : topologicalKrullDim ↥Z ≤ topologicalKrullDim ↥(Set.range ⇑h) :=
      Topology.IsInducing.topologicalKrullDim_le
        (Topology.IsInducing.of_comp (f := fun x : ↥Z => (⟨x, h.surjective x⟩ : Set.range ⇑h))
          (continuous_id.subtype_mk _) continuous_subtype_val Topology.IsInducing.id)
    exact h2.trans (h1.trans hdimY)
  have hdrop : ∀ (S T : Scheme.{u}) (j : T ⟶ S) [IsClosedImmersion j] [IrreducibleSpace ↥S],
      topologicalKrullDim ↥S ≤ (d : WithBot ℕ∞) → (∃ s : ↥S, s ∉ Set.range j) →
      topologicalKrullDim ↥T < (d : WithBot ℕ∞) := by
    intro S T j _ _ hS hex
    obtain ⟨s, hs'⟩ := hex
    have hT : topologicalKrullDim ↥T ≤ topologicalKrullDim ↥(Set.range ⇑j) :=
      Topology.IsInducing.topologicalKrullDim_le
        ((j.isClosedEmbedding.isInducing).codRestrict (fun x => Set.mem_range_self x))
    refine lt_of_le_of_lt hT ?_
    by_contra hcon
    have h1 := wc_dim_succ_le_of_proper_closed_subset (↥S) Set.univ (Set.range ⇑j)
      (IrreducibleSpace.isIrreducible_univ _) j.isClosedEmbedding.isClosed_range
      (Set.subset_univ _) (fun he => hs' (by rw [he]; exact Set.mem_univ s)) d (not_lt.mp hcon)
    have h2 : topologicalKrullDim ↥(Set.univ : Set ↥S) ≤ topologicalKrullDim ↥S :=
      topologicalKrullDim_subspace_le _ _
    have h3 := h1.trans (h2.trans hS)
    norm_cast at h3
    omega
  haveI hirrY : IrreducibleSpace ↥(wcXbar F' Y) :=
    (geometrically_iff_of_isClosedUnderIsomorphisms.mp ((geometricallyIrreducible_iff Y.hom).mp ‹_›))
      (AlgebraicClosure F') (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
  have dimE : topologicalKrullDim ↥E < (d : WithBot ℕ∞) :=
    hdrop Z E i hdimZ ⟨z, by rw [hrange_i]; exact fun hc => hc hzW₀⟩
  obtain ⟨y, hy⟩ := h.surjective z
  have dimE' : topologicalKrullDim ↥(Limits.pullback h i) < (d : WithBot ℕ∞) :=
    hdrop (wcXbar F' Y) (Limits.pullback h i) (Limits.pullback.fst h i) hdimY
      ⟨y, by rw [Scheme.Pullback.range_fst, hrange_i]; exact fun hc => hc (hy.symm ▸ hzW₀)⟩

  have hvanE : ∀ x : wcHM E ℓ (2 * d), x = 0 := fun x =>
    wc_hm_proper_cd_vanishing (AlgebraicClosure F') E (i ≫ sZ) d dimE ℓ hℓK (2 * d) (by omega) x
  have hvanE' : ∀ m : ℕ, m + 1 = 2 * d → ∀ x : wcHM (Limits.pullback h i) ℓ m, x = 0 :=
    fun m hm x => wc_hm_proper_cd_vanishing (AlgebraicClosure F') (Limits.pullback h i)
      (Limits.pullback.fst h i ≫ h ≫ sZ) d dimE' ℓ hℓK m (by omega) x

  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  obtain ⟨Di', hDi'⟩ := wc_hm_pull_data_exists (Limits.pullback.fst h i) ℓ
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology Z)
    (wcRingSheaf Z ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology (wcXbar F' Y))
    (wcRingSheaf (wcXbar F' Y) ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology E)
    (wcRingSheaf E ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology (Limits.pullback h i)) (wcRingSheaf (Limits.pullback h i) ℓ)
  haveI := Di.cont
  haveI := Di'.cont
  obtain ⟨hLi, hCi⟩ := wc_proet_closed_push_exact i hUZ Di.cont
  haveI := hLi
  haveI := hCi
  obtain ⟨hPAi, hPLi, hPCi⟩ := sheafOfModules_pushforward_exact (wcProEtBC i)
    (wcRingSheaf Z ℓ) (wcRingSheaf E ℓ) Di.φ
  obtain ⟨hLi', hCi'⟩ := wc_proet_closed_push_exact (Limits.pullback.fst h i) hUY Di'.cont
  haveI := hLi'
  haveI := hCi'
  obtain ⟨hPAi', hPLi', hPCi'⟩ := sheafOfModules_pushforward_exact
    (wcProEtBC (Limits.pullback.fst h i))
    (wcRingSheaf (wcXbar F' Y) ℓ) (wcRingSheaf (Limits.pullback h i) ℓ) Di'.φ

  have hpushvan : ∀ {S T : Scheme.{u}} (f : T ⟶ S) (D : wcHMPullData f ℓ),
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).Additive →
      Limits.PreservesFiniteLimits
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) →
      Limits.PreservesFiniteColimits
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) →
      ∀ n : ℕ, (∀ x : wcHM T ℓ n, x = 0) →
      ∀ yy : @Abelian.Ext (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) _ _ (HasExt.standard _)
        (SheafOfModules.unit (wcRingSheaf S ℓ))
        ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcRingSheaf T ℓ))) n, yy = 0 := by
    intro S T f D hA hL hC n hT yy
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    haveI := hA
    haveI := hL
    haveI := hC
    haveI := D.presLim
    haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology T) (wcRingSheaf T ℓ)
    obtain ⟨e, he⟩ := (wc_ext_adjoint_transfer D.Φ _ D.adj (SheafOfModules.unit (wcRingSheaf S ℓ))
      (SheafOfModules.unit (wcRingSheaf T ℓ)) n).2 yy
    beta_reduce at he
    have he0 : e = 0 := by
      have h1 := hT ((Abelian.Ext.mk₀ D.μ.inv).comp e (zero_add n))
      have h2 : e = (Abelian.Ext.mk₀ D.μ.hom).comp
          ((Abelian.Ext.mk₀ D.μ.inv).comp e (zero_add n)) (zero_add n) := by
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      rw [h2, h1, Abelian.Ext.comp_zero]
    rw [← he, he0, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]

  haveI hepi_i : Epi (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
      Di.cont Di.φ) := wc_proet_closed_unit_restriction_epi i hUZ ℓ Di hDi
  haveI hepi_i' : Epi (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ) :=
    wc_proet_closed_unit_restriction_epi (Limits.pullback.fst h i) hUY ℓ Di' hDi'
  have hSi : (ShortComplex.mk
      (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
        Di.cont Di.φ))
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi_i
  have hSi' : (ShortComplex.mk
      (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ))
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi_i'

  have hlift : ∀ x : wcHM Z ℓ (2 * d), ∃ c : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Z ℓ))
      (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
        Di.cont Di.φ)) (2 * d),
      c.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC i) _ _ Di.cont Di.φ))) (add_zero _) = x := by
    intro x
    have h0 : x.comp (Abelian.Ext.mk₀ (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC i) _ _ Di.cont Di.φ)) (add_zero _) = 0 :=
      hpushvan i Di hPAi hPLi hPCi (2 * d) hvanE _
    exact Abelian.Ext.covariant_sequence_exact₂ _ hSi x h0

  have hinjY : ∀ (n : ℕ) (c' : Abelian.Ext (SheafOfModules.unit (wcRingSheaf (wcXbar F' Y) ℓ))
      (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ)) n),
      (∀ m : ℕ, m + 1 = n → ∀ x : wcHM (Limits.pullback h i) ℓ m, x = 0) →
      c'.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit
        _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ))) (add_zero n) = 0 →
      c' = 0 := by
    intro n c' hvan hc'
    cases n with
    | zero =>
      have e2 : Abelian.Ext.homEquiv₀ c' ≫ Limits.kernel.ι
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ) = 0 := by
        apply (Abelian.Ext.mk₀_bijective _ _).1
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply, Abelian.Ext.mk₀_zero]
        exact hc'
      have e3 : Abelian.Ext.homEquiv₀ c' = 0 := by
        rw [← cancel_mono (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ)), e2, Limits.zero_comp]
      rw [← Abelian.Ext.mk₀_homEquiv₀_apply c', e3, Abelian.Ext.mk₀_zero]
    | succ m =>
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hSi' c' hc' (rfl : m + 1 = m + 1)
      rw [← hx₃, hpushvan (Limits.pullback.fst h i) Di' hPAi' hPLi' hPCi' m (hvan m rfl) x₃,
        Abelian.Ext.zero_comp]

  have hcompat := wc_hm_kernel_pull_compat h i ℓ Dh hDh Di hDi Di' hDi'
  obtain ⟨κ, hκ⟩ : ∃ κ : Dh.Φ.obj (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit
        _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ)) ⟶
      Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ),
      κ ≫ Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ) =
        Dh.Φ.map (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC i) _ _ Di.cont Di.φ)) ≫ Dh.μ.hom :=
    ⟨Limits.kernel.lift _ _ (by rw [Category.assoc]; exact hcompat), Limits.kernel.lift_ι _ _ _⟩
  have htrans : ∀ c : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Z ℓ))
      (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
        Di.cont Di.φ)) (2 * d),
      wcHMPull Dh (2 * d) (c.comp (Abelian.Ext.mk₀ (Limits.kernel.ι
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
          Di.cont Di.φ))) (add_zero _)) =
      ((Abelian.Ext.mk₀ Dh.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dh.Φ c).comp
        (Abelian.Ext.mk₀ κ) (add_zero _)) (zero_add _)).comp
        (Abelian.Ext.mk₀ (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ))) (add_zero _) := by
    intro c
    show (Abelian.Ext.mk₀ Dh.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dh.Φ
        (c.comp (Abelian.Ext.mk₀ (Limits.kernel.ι
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
            Di.cont Di.φ))) (add_zero _))).comp (Abelian.Ext.mk₀ Dh.μ.hom) (add_zero _))
        (zero_add _) = _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor Dh.Φ c)
        (Abelian.Ext.mk₀ (Dh.Φ.map (Limits.kernel.ι
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _
            Di.cont Di.φ)))),
      Abelian.Ext.mk₀_comp_mk₀, ← hκ, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ Dh.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor Dh.Φ c)
        (Abelian.Ext.mk₀ κ)]

  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨c, rfl⟩ := hlift x
  rw [htrans c] at hx
  have hc' := hinjY (2 * d) _ hvanE' hx
  have hc0 := wc_hm_proper_excision_injective (AlgebraicClosure F') h sZ i hiso hUZ hUY ℓ hℓK
    Dh hDh Di hDi Di' hDi' κ hκ (2 * d) c hc'
  rw [hc0, Abelian.Ext.zero_comp]

theorem wc_hm_pull_top_nonzero (F' : Type u) [Field F'] [Finite F']
    (X' : Over (Spec (.of F')))
    [GeometricallyIrreducible X'.hom] [IsProper X'.hom] (d : ℕ) [SmoothOfRelativeDimension d X'.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom]
    [SmoothOfRelativeDimension d Y.hom]
    (π : Y.left ⟶ X'.left) (hπ : π ≫ X'.hom = Y.hom) (hsurj : Surjective π)
    (hgf : ∃ V : X'.left.Opens, V ≠ ⊥ ∧ IsFinite (π ∣_ V))
    (πb : wcXbar F' Y ⟶ wcXbar F' X')
    (hπb₁ : πb ≫ Limits.pullback.fst X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
      Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ π)
    (hπb₂ : πb ≫ Limits.pullback.snd X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
      Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
    (D : wcHMPullData πb ℓ) (hD : wcHMPullCanonical D) :
    ∃ ω : wcHM (wcXbar F' X') ℓ (2 * d), wcHMPull D (2 * d) ω ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F' X') ℓ)) := HasExt.standard _
  have hX' : WeaklyEtale (Limits.pullback.fst X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F')

  obtain ⟨x₀, hx₀⟩ := wc_top_coh_nonzero F' X' d ℓ hℓ hX'
  obtain ⟨T, -, -⟩ := wc_hm_comparison F' X' hX' ℓ
  have hω : T (2 * d) x₀ ≠ 0 := fun h0 =>
    hx₀ ((T (2 * d)).injective (h0.trans (map_zero (T (2 * d))).symm))

  obtain ⟨Z, g, h, hhg, hgfin, hgs, hZint, hhp, hhs, hgp, hcomp, hW⟩ :=
    wc_hm_stein_factor F' X' d Y π hπ hsurj hgf πb hπb₁ hπb₂
  haveI := hgfin
  haveI := hZint
  haveI := hhp
  haveI := hgp
  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists g ℓ
  obtain ⟨Dh, hDh⟩ := wc_hm_pull_data_exists h ℓ

  have hex := wc_finite_pushforward_exact F' X' Z g ℓ Dg hDg
  obtain ⟨r, hr⟩ := wc_finite_surj_unit_split F' X' d Z g hgs ℓ Dg hDg

  have hg0 : wcHMPull Dg (2 * d) (T (2 * d) x₀) ≠ 0 := by
    intro h0
    have h1 := wc_closed_supp_class_restriction_zero_of_exact g ℓ Dg hex 0 (2 * d) (2 * d)
      (add_zero _) (Abelian.Ext.mk₀ r) (T (2 * d) x₀) h0
    have e : wcSuppClass Dg 0 (Abelian.Ext.mk₀ r) = Abelian.Ext.mk₀ (𝟙 _) := by
      show (Abelian.Ext.mk₀ (wcSuppUnitMap Dg)).comp (Abelian.Ext.mk₀ r) (zero_add 0) = _
      rw [Abelian.Ext.mk₀_comp_mk₀, hr]
    rw [e] at h1
    have e2 : wcHMCup (wcXbar F' X') ℓ (2 * d) 0 (2 * d) (add_zero _) (T (2 * d) x₀)
        (Abelian.Ext.mk₀ (𝟙 _)) = T (2 * d) x₀ := by
      show (T (2 * d) x₀).comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) = _
      exact Abelian.Ext.comp_mk₀_id _
    exact hω (e2.symm.trans h1)

  refine ⟨T (2 * d) x₀, ?_⟩
  rw [wc_hm_pull_comp g h πb hhg Dg hDg Dh hDh D hD (2 * d) (T (2 * d) x₀)]
  intro h0
  exact hg0 ((wc_hm_birational_top_injective F' Y d ℓ hℓ Z h hhs hW (g ≫ wcPi2 F' X') hcomp
    Dh hDh) (h0.trans (map_zero _).symm))

theorem wc_hm_pull_top_injective (F' : Type u) [Field F'] [Finite F']
    (X' : Over (Spec (.of F')))
    [GeometricallyIrreducible X'.hom] [IsProper X'.hom] (d : ℕ) [SmoothOfRelativeDimension d X'.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom]
    [SmoothOfRelativeDimension d Y.hom]
    (π : Y.left ⟶ X'.left) (hπ : π ≫ X'.hom = Y.hom) (hsurj : Surjective π)
    (hgf : ∃ V : X'.left.Opens, V ≠ ⊥ ∧ IsFinite (π ∣_ V))
    (πb : wcXbar F' Y ⟶ wcXbar F' X')
    (hπb₁ : πb ≫ Limits.pullback.fst X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
      Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ π)
    (hπb₂ : πb ≫ Limits.pullback.snd X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
      Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
    (D : wcHMPullData πb ℓ) (hD : wcHMPullCanonical D) :
    Function.Injective (wcHMPull D (2 * d)) :=
by
  classical

  have hscal : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ)
      (hD : wcHMPullCanonical D) (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hc := wc_hm_pull_const D hD c
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero n)
    rw [← hc, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  have hX' : WeaklyEtale (Limits.pullback.fst X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F')
  have hY' : WeaklyEtale (Limits.pullback.fst Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F')

  have htr : ∀ (Z : Over (Spec (.of F'))) [GeometricallyIrreducible Z.hom] [IsProper Z.hom]
      [SmoothOfRelativeDimension d Z.hom]
      (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))),
      ∃ η : wcHM (wcXbar F' Z) ℓ (2 * d) →+ ℚ_[ℓ],
        (∀ (c : ℚ_[ℓ]) (w : wcHM (wcXbar F' Z) ℓ (2 * d)),
          η (wcHMScalar (wcXbar F' Z) ℓ (2 * d) c w) = c * η w) ∧ Function.Injective η := by
    intro Z _ _ _ hZ
    obtain ⟨η₀, hη₀c, hη₀i⟩ := wc_top_coh_trace_injective F' Z d ℓ hℓ hZ
    obtain ⟨T, hTs, _⟩ := wc_hm_comparison F' Z hZ ℓ
    refine ⟨η₀.comp (T (2 * d)).symm.toAddMonoidHom, ?_, hη₀i.comp (T (2 * d)).symm.injective⟩
    intro c w
    have h1 : (T (2 * d)).symm (wcHMScalar (wcXbar F' Z) ℓ (2 * d) c w) =
        wcCohScalar F' Z hZ ℓ (2 * d) c ((T (2 * d)).symm w) := by
      apply (T (2 * d)).injective
      rw [hTs, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
    rw [h1, hη₀c]
  obtain ⟨ηX, hηXc, hηXi⟩ := htr X' hX'
  obtain ⟨ηY, hηYc, hηYi⟩ := htr Y hY'

  obtain ⟨ω, hω⟩ := wc_hm_pull_top_nonzero F' X' d ℓ hℓ Y π hπ hsurj hgf πb hπb₁ hπb₂ D hD

  rw [injective_iff_map_eq_zero]
  intro z hz
  have hω0 : ω ≠ 0 := fun h => hω (by rw [h, map_zero])
  have hηω : ηX ω ≠ 0 := fun h => hω0 (hηXi (h.trans (map_zero ηX).symm))
  have hηPω : ηY (wcHMPull D (2 * d) ω) ≠ 0 := fun h => hω (hηYi (h.trans (map_zero ηY).symm))
  obtain ⟨c, hc⟩ : ∃ c : ℚ_[ℓ], c = ηX z / ηX ω := ⟨_, rfl⟩
  have hzc : z = wcHMScalar (wcXbar F' X') ℓ (2 * d) c ω := by
    apply hηXi
    rw [hηXc, hc, div_mul_cancel₀ _ hηω]
  have h0 : c * ηY (wcHMPull D (2 * d) ω) = 0 := by
    rw [← hηYc, ← hscal D hD, ← hzc, hz, map_zero]
  have hc0 : c = 0 := (mul_eq_zero.mp h0).resolve_right hηPω
  have hz0 : ηX z = 0 := by
    rw [hzc, hηXc, hc0, zero_mul]
  exact hηXi (hz0.trans (map_zero ηX).symm)

theorem wc_pullback_injective_same_field (F' : Type u) [Field F'] [Finite F']
    (X' : Over (Spec (.of F')))
    [GeometricallyIrreducible X'.hom] [IsProper X'.hom] (d : ℕ) [SmoothOfRelativeDimension d X'.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (hX' : WeaklyEtale (Limits.pullback.fst X'.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom]
    [SmoothOfRelativeDimension d Y.hom]
    (π : Y.left ⟶ X'.left) (hπ : π ≫ X'.hom = Y.hom) (hsurj : Surjective π)
    (hgf : ∃ V : X'.left.Opens, V ≠ ⊥ ∧ IsFinite (π ∣_ V))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) (i : ℕ) :
    ∃ ψ : wcCoh F' X' hX' ℓ i →+ wcCoh F' Y hY ℓ i,
      Function.Injective ψ ∧
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' X' hX' ℓ i),
        ψ (wcCohScalar F' X' hX' ℓ i c x) = wcCohScalar F' Y hY ℓ i c (ψ x)) ∧
      ∀ x : wcCoh F' X' hX' ℓ i, ψ (wcCohFrob F' X' hX' ℓ i x) = wcCohFrob F' Y hY ℓ i (ψ x) :=
by
  classical

  have hscal : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ)
      (hD : wcHMPullCanonical D) (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hc := wc_hm_pull_const D hD c
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero n)
    rw [← hc, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  have hcup : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (a b k : ℕ)
      (hk : a + b = k) (x : wcHM S ℓ a) (y : wcHM S ℓ b),
      wcHMPull D k (wcHMCup S ℓ a b k hk x y) =
        wcHMCup S' ℓ a b k hk (wcHMPull D a x) (wcHMPull D b y) := by
    intro S S' f D a b k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero a)) (zero_add a)).comp
        ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero b)) (zero_add b)) hk
    rw [Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.comp_assoc _ _ _ (zero_add a) hk (by omega),
      Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x),
      Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]

  obtain ⟨πb, hπb₁, hπb₂⟩ : ∃ πb : wcXbar F' Y ⟶ wcXbar F' X',
      πb ≫ Limits.pullback.fst X'.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ π ∧
      πb ≫ Limits.pullback.snd X'.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.snd Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) :=
    ⟨Limits.pullback.lift (Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ π)
      (Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
      (by rw [Category.assoc, hπ, Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hgf₁ : ∀ (Z : Over (Spec (.of F')))
      (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))),
      wcGeomFrobX F' Z hZ ≫ Limits.pullback.fst Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.fst Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) := by
    intro Z hZ
    unfold wcGeomFrobX wcGeomFrob
    exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hgs : ∀ (Z : Over (Spec (.of F')))
      (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))),
      wcGeomFrobX F' Z hZ ≫ Limits.pullback.snd Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.snd Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F' _
            (Fintype.ofFinite F') (AlgebraicClosure F') _ _ _).symm :
              AlgebraicClosure F' →+* AlgebraicClosure F')) := by
    intro Z hZ
    unfold wcGeomFrobX wcGeomFrob
    exact Limits.pullback.lift_snd _ _ _
  have hcomm : wcGeomFrobX F' Y hY ≫ πb = πb ≫ wcGeomFrobX F' X' hX' := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hgf₁ X' hX', hπb₁, ← Category.assoc, hgf₁ Y hY]
    · simp only [Category.assoc]
      rw [hπb₂, hgs X' hX', ← Category.assoc, hπb₂, hgs Y hY]

  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists πb ℓ
  obtain ⟨DX, hDX⟩ := wc_hm_pull_data_exists (wcGeomFrobX F' X' hX') ℓ
  obtain ⟨DY, hDY⟩ := wc_hm_pull_data_exists (wcGeomFrobX F' Y hY) ℓ
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (πb ≫ wcGeomFrobX F' X' hX') ℓ
  obtain ⟨TX, hTXs, hTXF⟩ := wc_hm_comparison F' X' hX' ℓ
  obtain ⟨TY, hTYs, hTYF⟩ := wc_hm_comparison F' Y hY ℓ
  refine ⟨(TY i).symm.toAddMonoidHom.comp ((wcHMPull Dπ i).comp (TX i).toAddMonoidHom),
    ?_, ?_, ?_⟩
  ·
    by_cases hi : i ≤ 2 * d
    · have hP : Function.Injective (wcHMPull Dπ i) := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        have hcupz : ∀ y : wcHM (wcXbar F' X') ℓ (2 * d - i),
            wcHMCup (wcXbar F' X') ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) z y = 0 := by
          intro y
          apply wc_hm_pull_top_injective F' X' d ℓ hℓ Y π hπ hsurj hgf πb hπb₁ hπb₂ Dπ hDπ
          simp only [hcup, hz, map_zero, AddMonoidHom.zero_apply]
        obtain ⟨Θ, hΘ⟩ := wc_modcoh_hm_cup_iso F' X' hX' ℓ
        have hz' : (Θ i).symm z = 0 := by
          apply (wc_modcup_perfect F' X' d ℓ hℓ hX' i hi).1
          intro y'
          apply (Θ (2 * d)).injective
          rw [hΘ, AddEquiv.apply_symm_apply, hcupz, map_zero]
        rw [← AddEquiv.apply_symm_apply (Θ i) z, hz', map_zero]
      exact (TY i).symm.injective.comp (hP.comp (TX i).injective)
    · intro a b _
      rw [wc_coh_vanishing F' X' d ℓ hℓ hX' i (by omega) a,
        wc_coh_vanishing F' X' d ℓ hℓ hX' i (by omega) b]
  ·
    intro c x
    have h1 : ∀ w : wcHM (wcXbar F' Y) ℓ i, (TY i).symm (wcHMScalar (wcXbar F' Y) ℓ i c w) =
        wcCohScalar F' Y hY ℓ i c ((TY i).symm w) := by
      intro w
      apply (TY i).injective
      rw [hTYs, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    show (TY i).symm (wcHMPull Dπ i (TX i (wcCohScalar F' X' hX' ℓ i c x))) =
      wcCohScalar F' Y hY ℓ i c ((TY i).symm (wcHMPull Dπ i (TX i x)))
    rw [hTXs, hscal Dπ hDπ, h1]
  ·
    intro x
    have h2 : ∀ w : wcHM (wcXbar F' Y) ℓ i, (TY i).symm (wcHMPull DY i w) =
        wcCohFrob F' Y hY ℓ i ((TY i).symm w) := by
      intro w
      apply (TY i).injective
      rw [hTYF DY hDY, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    show (TY i).symm (wcHMPull Dπ i (TX i (wcCohFrob F' X' hX' ℓ i x))) =
      wcCohFrob F' Y hY ℓ i ((TY i).symm (wcHMPull Dπ i (TX i x)))
    rw [hTXF DX hDX,
      ← wc_hm_pull_comp (wcGeomFrobX F' X' hX') πb _ rfl DX hDX Dπ hDπ Dk hDk,
      wc_hm_pull_comp πb (wcGeomFrobX F' Y hY) _ hcomm Dπ hDπ DY hDY Dk hDk, h2]

theorem wc_pullback_injective (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (F' : Type u) [Field F'] [Finite F'] [Algebra F F'] [FiniteDimensional F F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom]
    [SmoothOfRelativeDimension d Y.hom]
    (π : Y.left ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))
    (hπ : π ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) = Y.hom)
    (hsurj : Surjective π)
    (hgf : ∃ V : (Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F')))).Opens,
        V ≠ ⊥ ∧ IsFinite (π ∣_ V))
    (h' : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) :
    ∀ i : ℕ, ∃ ψ : wcCoh F X h ℓ i →+ wcCoh F' Y h' ℓ i,
      Function.Injective ψ ∧
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i),
        ψ (wcCohScalar F X h ℓ i c x) = wcCohScalar F' Y h' ℓ i c (ψ x)) ∧
      ∀ x : wcCoh F X h ℓ i,
        ψ ((⇑(wcCohFrob F X h ℓ i))^[Module.finrank F F'] x) = wcCohFrob F' Y h' ℓ i (ψ x) :=
by
  intro i
  classical
  haveI : IsProper (Over.mk (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F F'))))).hom :=
    inferInstanceAs (IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F F')))))
  haveI : GeometricallyIrreducible (Over.mk (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F F'))))).hom :=
    inferInstanceAs (GeometricallyIrreducible (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F F')))))
  haveI : SmoothOfRelativeDimension d (Over.mk (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F F'))))).hom :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))
      ‹SmoothOfRelativeDimension d X.hom›
  have hX' : WeaklyEtale (Limits.pullback.fst
      (Over.mk (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F')
  have hq' : Nat.card F' = Nat.card F ^ Module.finrank F F' := Module.natCard_eq_pow_finrank
  have hℓ' : ¬ ℓ ∣ Nat.card F' := by
    rw [hq']
    intro hd
    exact hℓ ((Fact.out : ℓ.Prime).dvd_of_dvd_pow hd)
  obtain ⟨Θ, hΘs, hΘΦ⟩ := wc_coh_base_change_frob F X h F' hX' ℓ i
  obtain ⟨ψ₀, hψ₀, hψ₀s, hψ₀Φ⟩ := wc_pullback_injective_same_field F'
    (Over.mk (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))) d ℓ hℓ'
    hX' Y π hπ hsurj hgf h' i
  refine ⟨ψ₀.comp Θ.toAddMonoidHom, ?_, ?_, ?_⟩
  · exact hψ₀.comp Θ.injective
  · intro c x
    simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
    rw [hΘs, hψ₀s]
  · intro x
    simp only [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom]
    rw [hΘΦ, hψ₀Φ]

theorem wc_ldpi_principal_subscheme (P : Scheme.{u}) (I : Type) [Finite I] (W : I → P.Opens)
    (hW : ∀ i, IsAffineOpen (W i)) (hcov : (⨆ i, W i) = ⊤) (h : ∀ i, Γ(P, W i))
    (hu : ∀ i j, ∃ u : Γ(P, W i ⊓ W j), IsUnit u ∧
      P.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op (h j) =
        u * P.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op (h i)) :
    ∃ (Z : Scheme.{u}) (g : Z ⟶ P), IsClosedImmersion g ∧
      (∀ (i : I) (O : P.Opens), IsAffineOpen O → ∀ (hOW : O ≤ W i),
        Function.Surjective (g.app O).hom ∧
        RingHom.ker (g.app O).hom = Ideal.span {P.presheaf.map (homOfLE hOW).op (h i)}) ∧
      (∀ p : P, p ∈ Set.range g ↔ ∀ (i : I) (hp : p ∈ W i),
        (P.presheaf.germ (W i) p hp).hom (h i) ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk p)) ∧
      (∀ (z : Z) (i : I) (hz : g z ∈ W i), Function.Surjective (g.stalkMap z).hom ∧
        RingHom.ker (g.stalkMap z).hom = Ideal.span {(P.presheaf.germ (W i) (g z) hz).hom (h i)}) :=
by
  classical

  have A1 : ∀ (O : P.Opens) (hO : IsAffineOpen O) (h' s : Γ(P, O)),
      (∀ (x : P) (hx : x ∈ O), (P.presheaf.germ O x hx).hom s ∈
        Ideal.span {(P.presheaf.germ O x hx).hom h'}) → s ∈ Ideal.span {h'} := by
    intro O hO h' s H
    obtain ⟨C, hC⟩ : ∃ C : Ideal Γ(P, O), ∀ r, r ∈ C ↔ r * s ∈ Ideal.span {h'} :=
      ⟨{ carrier := {r | r * s ∈ Ideal.span {h'}}
         add_mem' := fun {a b} ha hb => by
           simp only [Set.mem_setOf_eq] at *
           rw [add_mul]; exact Ideal.add_mem _ ha hb
         zero_mem' := by simp
         smul_mem' := fun c r hr => by
           simp only [Set.mem_setOf_eq, smul_eq_mul] at *
           rw [mul_assoc]; exact Ideal.mul_mem_left _ _ hr }, fun r => Iff.rfl⟩
    by_contra hs
    have hCt : C ≠ ⊤ := by
      intro e
      apply hs
      have := (hC 1).1 (e ▸ Submodule.mem_top)
      simpa using this
    obtain ⟨M, hM, hCM⟩ := Ideal.exists_le_maximal C hCt
    let y : Spec Γ(P, O) := ⟨M, hM.isPrime⟩
    have hx : hO.fromSpec y ∈ O := by
      have : hO.fromSpec y ∈ (O : Set P) := hO.range_fromSpec ▸ ⟨y, rfl⟩
      exact this
    letI : Algebra Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) :=
      (P.presheaf.germ O (hO.fromSpec y) hx).hom.toAlgebra
    haveI : IsLocalization.AtPrime (P.presheaf.stalk (hO.fromSpec y)) y.asIdeal :=
      hO.isLocalization_stalk' y hx
    have hal : algebraMap Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) =
        (P.presheaf.germ O (hO.fromSpec y) hx).hom := rfl
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (H _ hx)
    obtain ⟨⟨z1, z2⟩, hz⟩ := IsLocalization.surj y.asIdeal.primeCompl a
    simp only at hz
    have e1 : algebraMap Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) (z2 * s) =
        algebraMap Γ(P, O) (P.presheaf.stalk (hO.fromSpec y)) (z1 * h') := by
      rw [map_mul, map_mul, ← hz, hal, ← ha]; ring
    obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := y.asIdeal.primeCompl) e1
    have hmem : ((c : Γ(P, O)) * (z2 : Γ(P, O))) ∈ C := by
      rw [hC, mul_assoc, hc]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl))
    have := hCM hmem
    rcases hM.isPrime.mem_or_mem this with h1 | h1
    · exact c.2 h1
    · exact z2.2 h1

  have hIDX : ∀ (x : P) (i j : I) (hi : x ∈ W i) (hj : x ∈ W j),
      (P.presheaf.germ (W i) x hi).hom (h i) ∈
        Ideal.span {(P.presheaf.germ (W j) x hj).hom (h j)} := by
    intro x i j hi hj
    obtain ⟨u, -, hu'⟩ := hu j i
    have hx : x ∈ W j ⊓ W i := ⟨hj, hi⟩
    have e := congrArg (P.presheaf.germ (W j ⊓ W i) x hx).hom hu'
    rw [TopCat.Presheaf.germ_res_apply, map_mul, TopCat.Presheaf.germ_res_apply] at e
    rw [e]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

  obtain ⟨J, hJ⟩ : ∃ J : ∀ U : P.Opens, Ideal Γ(P, U), ∀ U s, s ∈ J U ↔
      ∀ (x : P) (hx : x ∈ U) (i : I) (hi : x ∈ W i),
        (P.presheaf.germ U x hx).hom s ∈ Ideal.span {(P.presheaf.germ (W i) x hi).hom (h i)} :=
    ⟨fun U =>
      { carrier := {s | ∀ (x : P) (hx : x ∈ U) (i : I) (hi : x ∈ W i),
          (P.presheaf.germ U x hx).hom s ∈ Ideal.span {(P.presheaf.germ (W i) x hi).hom (h i)}}
        add_mem' := fun {a b} ha hb x hx i hi => by
          rw [map_add]; exact Ideal.add_mem _ (ha x hx i hi) (hb x hx i hi)
        zero_mem' := fun x hx i hi => by
          rw [map_zero]; exact Ideal.zero_mem _
        smul_mem' := fun c s hs x hx i hi => by
          rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ (hs x hx i hi) },
      fun U s => Iff.rfl⟩
  have hres : ∀ (U V : P.Opens) (hVU : V ≤ U) (s : Γ(P, U)), s ∈ J U →
      (P.presheaf.map (homOfLE hVU).op).hom s ∈ J V := by
    intro U V hVU s hs
    rw [hJ] at hs ⊢
    intro x hx i hi
    rw [TopCat.Presheaf.germ_res_apply]
    exact hs x (hVU hx) i hi

  have hA : ∀ (i : I) (O : P.Opens) (hO : IsAffineOpen O) (hOW : O ≤ W i) (s : Γ(P, O)),
      s ∈ J O ↔ s ∈ Ideal.span {(P.presheaf.map (homOfLE hOW).op).hom (h i)} := by
    intro i O hO hOW s
    constructor
    · intro hs
      apply A1 O hO
      intro x hx
      rw [TopCat.Presheaf.germ_res_apply]
      exact (hJ O s).1 hs x hx i (hOW hx)
    · intro hs
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hs
      rw [hJ]
      intro x hx j hj
      rw [map_mul, TopCat.Presheaf.germ_res_apply]
      exact Ideal.mul_mem_left _ _ (hIDX x i j (hOW hx) hj)

  have hrr : ∀ (U V W' : P.Opens) (h1 : V ≤ U) (h2 : W' ≤ V) (h3 : W' ≤ U) (s : Γ(P, U)),
      (P.presheaf.map (homOfLE h2).op).hom ((P.presheaf.map (homOfLE h1).op).hom s) =
        (P.presheaf.map (homOfLE h3).op).hom s := by
    intro U V W' h1 h2 h3 s
    have e : (homOfLE h3).op = (homOfLE h1).op ≫ (homOfLE h2).op := rfl
    rw [e, P.presheaf.map_comp]
    rfl

  have hB : ∀ (U : P.Opens) (hU : IsAffineOpen U) (f : Γ(P, U)) (hle : P.basicOpen f ≤ U),
      Ideal.map (P.presheaf.map (homOfLE hle).op).hom (J U) = J (P.basicOpen f) := by
    intro U hU f hle
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro s hs
      exact hres U _ hle s hs
    · intro t ht
      haveI := hU.isLocalization_basicOpen f
      obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj f t
      have hna' : t * ((P.presheaf.map (homOfLE hle).op).hom f) ^ n =
          (P.presheaf.map (homOfLE hle).op).hom a := hna
      have hfu : IsUnit ((P.presheaf.map (homOfLE hle).op).hom f) :=
        IsLocalization.Away.algebraMap_isUnit f

      have haV : (P.presheaf.map (homOfLE hle).op).hom a ∈ J (P.basicOpen f) := by
        rw [← hna']; exact Ideal.mul_mem_right _ _ ht

      obtain ⟨Om, hOm⟩ : ∃ Om : ℕ → Set P, ∀ M y, y ∈ Om M ↔ ∃ (G : P.Opens) (hG : G ≤ U),
          y ∈ G ∧ (P.presheaf.map (homOfLE hG).op).hom (f ^ M * a) ∈ J G :=
        ⟨fun M => {y | ∃ (G : P.Opens) (hG : G ≤ U),
          y ∈ G ∧ (P.presheaf.map (homOfLE hG).op).hom (f ^ M * a) ∈ J G}, fun M y => Iff.rfl⟩
      have hOpen : ∀ M, IsOpen (Om M) := by
        intro M
        rw [isOpen_iff_forall_mem_open]
        intro y hy
        obtain ⟨G, hG, hyG, hGJ⟩ := (hOm M y).1 hy
        exact ⟨G, fun y' hy' => (hOm M y').2 ⟨G, hG, hy', hGJ⟩, G.2, hyG⟩
      have hMono : Monotone Om := by
        intro M M' hMM' y hy
        obtain ⟨G, hG, hyG, hGJ⟩ := (hOm M y).1 hy
        refine (hOm M' y).2 ⟨G, hG, hyG, ?_⟩
        have e : f ^ M' * a = f ^ (M' - M) * (f ^ M * a) := by
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hMM']
        rw [e, map_mul]
        exact Ideal.mul_mem_left _ _ hGJ
      have hCover : (U : Set P) ⊆ ⋃ M, Om M := by
        intro y hyU
        have hytop : y ∈ (⨆ i, W i) := by rw [hcov]; trivial
        obtain ⟨i, hyi⟩ := TopologicalSpace.Opens.mem_iSup.mp hytop
        obtain ⟨c, hcle, hyc⟩ := hU.exists_basicOpen_le (V := U ⊓ W i) ⟨y, hyU, hyi⟩ hyU
        obtain ⟨D, hDdef⟩ : ∃ D, D = P.basicOpen c := ⟨_, rfl⟩
        have hDaff : IsAffineOpen D := hDdef ▸ hU.basicOpen c
        have hDU : D ≤ U := hDdef ▸ (hcle.trans inf_le_left)
        have hDW : D ≤ W i := hDdef ▸ (hcle.trans inf_le_right)
        have hyD : y ∈ D := hDdef ▸ hyc
        obtain ⟨fk, hfk⟩ : ∃ fk, fk = (P.presheaf.map (homOfLE hDU).op).hom f := ⟨_, rfl⟩
        have hD'eq : P.basicOpen fk = D ⊓ P.basicOpen f := by
          rw [hfk]; exact Scheme.basicOpen_res P f (homOfLE hDU).op
        have hD'D : P.basicOpen fk ≤ D := P.basicOpen_le fk
        have hD'V : P.basicOpen fk ≤ P.basicOpen f := hD'eq ▸ inf_le_right
        have hD'U : P.basicOpen fk ≤ U := hD'D.trans hDU
        have hD'W : P.basicOpen fk ≤ W i := hD'D.trans hDW
        have hD'aff : IsAffineOpen (P.basicOpen fk) := hDaff.basicOpen fk
        have haD' : (P.presheaf.map (homOfLE hD'U).op).hom a ∈ J (P.basicOpen fk) := by
          rw [hJ]
          intro x hx j hj
          have := (hJ _ _).1 haV x (hD'V hx) j hj
          rw [TopCat.Presheaf.germ_res_apply] at this ⊢
          exact this
        obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ((hA i _ hD'aff hD'W _).1 haD')
        haveI := hDaff.isLocalization_basicOpen fk
        obtain ⟨n', b0, hb0⟩ := IsLocalization.Away.surj fk b
        have hb0' : b * ((P.presheaf.map (homOfLE hD'D).op).hom fk) ^ n' =
            (P.presheaf.map (homOfLE hD'D).op).hom b0 := hb0
        have e1 : algebraMap Γ(P, D) Γ(P, P.basicOpen fk)
              (fk ^ n' * (P.presheaf.map (homOfLE hDU).op).hom a) =
            algebraMap Γ(P, D) Γ(P, P.basicOpen fk)
              (b0 * (P.presheaf.map (homOfLE hDW).op).hom (h i)) := by
          show (P.presheaf.map (homOfLE hD'D).op).hom
              (fk ^ n' * (P.presheaf.map (homOfLE hDU).op).hom a) =
            (P.presheaf.map (homOfLE hD'D).op).hom
              (b0 * (P.presheaf.map (homOfLE hDW).op).hom (h i))
          rw [map_mul, map_mul, map_pow, hrr _ _ _ hDU hD'D hD'U, hrr _ _ _ hDW hD'D hD'W,
            ← hb0', ← hb]
          ring
        obtain ⟨⟨cc, m', rfl⟩, hc⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers fk) e1
        simp only at hc
        rw [Set.mem_iUnion]
        refine ⟨m' + n', (hOm _ y).2 ⟨D, hDU, hyD, ?_⟩⟩
        rw [hA i D hDaff hDW]
        have e2 : (P.presheaf.map (homOfLE hDU).op).hom (f ^ (m' + n') * a) =
            fk ^ m' * b0 * (P.presheaf.map (homOfLE hDW).op).hom (h i) := by
          rw [map_mul, map_pow, ← hfk, pow_add, mul_assoc, hc, mul_assoc]
        rw [e2]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      obtain ⟨M, hM⟩ := hU.isCompact.elim_directed_cover Om hOpen hCover hMono.directed_le
      have hfa : f ^ M * a ∈ J U := by
        rw [hJ]
        intro x hx j hj
        obtain ⟨G, hGU, hxG, hG⟩ := (hOm M x).1 (hM hx)
        have := (hJ G _).1 hG x hxG j hj
        rw [TopCat.Presheaf.germ_res_apply] at this
        exact this
      have hmem : t * ((P.presheaf.map (homOfLE hle).op).hom f) ^ (n + M) ∈
          Ideal.map (P.presheaf.map (homOfLE hle).op).hom (J U) := by
        have e3 : t * ((P.presheaf.map (homOfLE hle).op).hom f) ^ (n + M) =
            (P.presheaf.map (homOfLE hle).op).hom (f ^ M * a) := by
          rw [map_mul, map_pow, ← hna', pow_add]; ring
        rw [e3]
        exact Ideal.mem_map_of_mem _ hfa
      exact (Ideal.mul_unit_mem_iff_mem _ (hfu.pow _)).mp hmem

  obtain ⟨𝓘, h𝓘⟩ : ∃ 𝓘 : P.IdealSheafData, ∀ U, 𝓘.ideal U = J U.1 :=
    ⟨⟨fun U => J U.1, fun U f => hB U.1 U.2 f (P.basicOpen_le f),
      ⋂ U : P.affineOpens, P.zeroLocus (J U.1 : Set Γ(P, U.1)), rfl⟩, fun U => rfl⟩

  have hii : ∀ (i : I) (O : P.Opens), IsAffineOpen O → ∀ (hOW : O ≤ W i),
      Function.Surjective (𝓘.subschemeι.app O).hom ∧
      RingHom.ker (𝓘.subschemeι.app O).hom = Ideal.span {P.presheaf.map (homOfLE hOW).op (h i)} := by
    intro i O hO hOW
    refine ⟨𝓘.subschemeι_app_surjective ⟨O, hO⟩, ?_⟩
    rw [𝓘.ker_subschemeι_app ⟨O, hO⟩, h𝓘]
    ext s
    exact hA i O hO hOW s

  have S2 : ∀ (Z : Scheme.{u}) (g : Z ⟶ P) [IsClosedImmersion g] (W : P.Opens)
      (hW : IsAffineOpen W) (h : Γ(P, W))
      (hsurj : ∀ (O : P.Opens), IsAffineOpen O → O ≤ W → Function.Surjective (g.app O).hom)
      (hker : ∀ (O : P.Opens), IsAffineOpen O → ∀ (hOW : O ≤ W),
        RingHom.ker (g.app O).hom = Ideal.span {P.presheaf.map (homOfLE hOW).op h})
      (z : Z) (hz : g z ∈ W),
      RingHom.ker (g.stalkMap z).hom = Ideal.span {(P.presheaf.germ W (g z) hz).hom h} := by
    intro Z g _ W hW h hsurj hker z hz
    apply le_antisymm
    · intro α hα
      rw [RingHom.mem_ker] at hα
      obtain ⟨V, hpV, s, hs⟩ := TopCat.Presheaf.germ_exist P.presheaf α
      obtain ⟨f, hfle, hpf⟩ := hW.exists_basicOpen_le (V := V ⊓ W) ⟨g z, hpV, hz⟩ hz
      obtain ⟨O, hOdef⟩ : ∃ O, O = P.basicOpen f := ⟨_, rfl⟩
      have hOaff : IsAffineOpen O := hOdef ▸ hW.basicOpen f
      have hOV : O ≤ V := hOdef ▸ (hfle.trans inf_le_left)
      have hOW : O ≤ W := hOdef ▸ (hfle.trans inf_le_right)
      have hpO : g z ∈ O := hOdef ▸ hpf
      obtain ⟨s', hs'⟩ : ∃ s', s' = P.presheaf.map (homOfLE hOV).op s := ⟨_, rfl⟩
      have hα' : α = (P.presheaf.germ O (g z) hpO).hom s' := by
        rw [hs', TopCat.Presheaf.germ_res_apply, hs]
      have h0 : (Z.presheaf.germ (g ⁻¹ᵁ O) z hpO).hom ((g.app O).hom s') = 0 := by
        rw [← Scheme.Hom.germ_stalkMap_apply, ← hα', hα]
      have hO' : IsAffineOpen (g ⁻¹ᵁ O) := hOaff.preimage g
      have hzO : z ∈ g ⁻¹ᵁ O := hpO
      letI : Algebra Γ(Z, g ⁻¹ᵁ O) (Z.presheaf.stalk z) :=
        (Z.presheaf.germ (g ⁻¹ᵁ O) z hzO).hom.toAlgebra
      haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hO'.primeIdealOf ⟨z, hzO⟩).asIdeal :=
        hO'.isLocalization_stalk ⟨z, hzO⟩
      have hal : algebraMap Γ(Z, g ⁻¹ᵁ O) (Z.presheaf.stalk z) =
          (Z.presheaf.germ (g ⁻¹ᵁ O) z hpO).hom := rfl
      rw [← hal] at h0
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff
        (hO'.primeIdealOf ⟨z, hpO⟩).asIdeal.primeCompl (Z.presheaf.stalk z) _).mp h0
      have hmu : IsUnit ((Z.presheaf.germ (g ⁻¹ᵁ O) z hpO).hom (m : Γ(Z, g ⁻¹ᵁ O))) := by
        rw [← hal]; exact IsLocalization.map_units (Z.presheaf.stalk z) m
      obtain ⟨m0, hm0⟩ := hsurj O hOaff hOW (m : Γ(Z, g ⁻¹ᵁ O))
      have hker0 : m0 * s' ∈ RingHom.ker (g.app O).hom := by
        rw [RingHom.mem_ker, map_mul, hm0, hm]
      rw [hker O hOaff hOW] at hker0
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hker0
      have hu0 : IsUnit ((P.presheaf.germ O (g z) hpO).hom m0) := by
        apply isUnit_of_map_unit (g.stalkMap z).hom
        rw [Scheme.Hom.germ_stalkMap_apply, hm0]; exact hmu
      have e2 : (P.presheaf.germ O (g z) hpO).hom m0 * α =
          (P.presheaf.germ O (g z) hpO).hom c * (P.presheaf.germ W (g z) hz).hom h := by
        rw [hα', ← map_mul, ← hc, map_mul, TopCat.Presheaf.germ_res_apply]
      have : (P.presheaf.germ O (g z) hpO).hom m0 * α ∈
          Ideal.span {(P.presheaf.germ W (g z) hz).hom h} := by
        rw [e2]; exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      exact (Ideal.unit_mul_mem_iff_mem _ hu0).mp this
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        Scheme.Hom.germ_stalkMap_apply]
      have : h ∈ RingHom.ker (g.app W).hom := by
        rw [hker W hW le_rfl]
        apply Ideal.subset_span
        simp
      rw [RingHom.mem_ker] at this
      rw [this, map_zero]
  refine ⟨𝓘.subscheme, 𝓘.subschemeι, inferInstance, hii, ?_, ?_⟩
  ·
    intro p
    rw [𝓘.range_subschemeι]
    have hJW : ∀ i, J (W i) = Ideal.span {h i} := by
      intro i
      ext s
      rw [hA i (W i) (hW i) le_rfl s]
      have e : (P.presheaf.map (homOfLE (le_refl (W i))).op).hom (h i) = h i := by
        have e0 : (homOfLE (le_refl (W i))).op = 𝟙 (Opposite.op (W i)) := rfl
        rw [e0, P.presheaf.map_id]; rfl
      rw [e]
    have key : ∀ i (hp : p ∈ W i), p ∈ 𝓘.support ↔
        (P.presheaf.germ (W i) p hp).hom (h i) ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk p) := by
      intro i hp
      rw [𝓘.mem_support_iff_of_mem (U := ⟨W i, hW i⟩) hp, h𝓘]
      show p ∈ P.zeroLocus (J (W i) : Set Γ(P, W i)) ↔ _
      rw [hJW, Scheme.zeroLocus_span, Scheme.mem_zeroLocus_iff]
      simp only [Set.mem_singleton_iff, forall_eq]
      rw [Scheme.mem_basicOpen _ _ _ hp, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro hp' i hp
      exact (key i hp).1 hp'
    · intro H
      have hptop : p ∈ (⨆ i, W i) := by rw [hcov]; trivial
      obtain ⟨i, hp⟩ := TopologicalSpace.Opens.mem_iSup.mp hptop
      exact (key i hp).2 (H i hp)
  ·
    intro z i hz
    refine ⟨𝓘.subschemeι.stalkMap_surjective z, ?_⟩
    exact S2 𝓘.subscheme 𝓘.subschemeι (W i) (hW i) (h i)
      (fun O hO hOW => (hii i O hO hOW).1) (fun O hO hOW => (hii i O hO hOW).2) z hz

theorem wc_pp_proper : ∀ (K : Type u) [Field K] (m : ℕ), IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)))) :=
by
  intro K _ m
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
    MvPolynomial.gradedAlgebra
  have hcoe : ∀ c : K, ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c :
      ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) : MvPolynomial (Fin (m + 1)) K) =
      algebraMap K (MvPolynomial (Fin (m + 1)) K) c := fun c =>
    SetLike.GradeZero.coe_algebraMap _ c
  haveI hT : IsScalarTower K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)
      (MvPolynomial (Fin (m + 1)) K) := by
    refine ⟨fun x y z => ?_⟩
    rw [Algebra.smul_def (x • y) z, Algebra.smul_def y z, SetLike.GradeZero.algebraMap_apply,
      SetLike.GradeZero.algebraMap_apply, Submodule.coe_smul, smul_mul_assoc]
  haveI hFT : Algebra.FiniteType ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)
      (MvPolynomial (Fin (m + 1)) K) :=
    Algebra.FiniteType.of_restrictScalars_finiteType K _ _
  haveI hP1 : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)) :=
    inferInstance
  have hbij : Function.Bijective
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) := by
    constructor
    · intro x y hxy
      have h1 := congrArg Subtype.val hxy
      have h2 := hcoe x
      have h3 := hcoe y
      rw [MvPolynomial.algebraMap_eq] at h2 h3
      exact MvPolynomial.C_injective (Fin (m + 1)) K (h2.symm.trans (h1.trans h3))
    · intro z
      have hz : (z : MvPolynomial (Fin (m + 1)) K) ∈ (1 : Submodule K (MvPolynomial (Fin (m + 1)) K)) := by
        rw [← MvPolynomial.homogeneousSubmodule_zero (Fin (m + 1))]
        exact z.2
      obtain ⟨y, hy⟩ := Submodule.mem_one.mp hz
      exact ⟨y, Subtype.ext ((hcoe y).trans hy)⟩
  haveI hiso1 : IsIso (CommRingCat.ofHom
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0))) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hiso2 : IsIso (Spec.map (CommRingCat.ofHom
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)))) := inferInstance
  infer_instance

theorem wc_segre_proj_closed_immersion (F' : Type u) [Field F'] (N₁ N₂ : ℕ) :
    ∃ (N' : ℕ) (σ : Limits.pullback
        (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) F')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) F' 0))))
        (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) F')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N₂ + 1)) F' 0)))) ⟶
        @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F')
          MvPolynomial.gradedAlgebra),
      IsClosedImmersion σ ∧
      σ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' 0))) =
        Limits.pullback.fst _ _ ≫
          (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) F')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N₁ + 1)) F' 0)))) :=
by
  obtain ⟨N', σ, h1, h2⟩ := wc_pp_segre F' N₁ N₂
  exact ⟨N', σ, h1, h2⟩

theorem wc_ldpi_chart_data (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
    (∀ p, IsAffineOpen (wcLdpW E N X ι p)) ∧ (⨆ p, wcLdpW E N X ι p) = ⊤ ∧
    ∀ p q, ∃ u : Γ(Limits.pullback X.hom (wcProjKStr E 1), wcLdpW E N X ι p ⊓ wcLdpW E N X ι q),
      IsUnit u ∧
      (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
          (homOfLE (inf_le_right : wcLdpW E N X ι p ⊓ wcLdpW E N X ι q ≤ wcLdpW E N X ι q)).op
          (wcLdpH E N X ι G₀ G₁ q) =
        u * (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
          (homOfLE (inf_le_left : wcLdpW E N X ι p ⊓ wcLdpW E N X ι q ≤ wcLdpW E N X ι p)).op
          (wcLdpH E N X ι G₀ G₁ p) :=
by
  classical
  haveI : IsClosedImmersion ι := hι

  have haff : ∀ (n : ℕ) (J : Fin (n + 1)), IsAffineOpen (wcSgD E n J) := by
    intro n J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) Nat.one_pos
  have hX : ∀ (n : ℕ) (k : Fin (n + 1)), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) E) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E 1 := fun n k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)

  have GL1 : ∀ {A B C : Scheme.{u}} (g : A ⟶ B) (k : B ⟶ C) (U U' : C.Opens) (hU' : U' ≤ U)
      (V V' : A.Opens) (hV : V ≤ V') (e' : V' ≤ g ⁻¹ᵁ (k ⁻¹ᵁ U)) (e : V ≤ (g ≫ k) ⁻¹ᵁ U')
      (s : Γ(C, U)),
      (A.presheaf.map (homOfLE hV).op).hom ((g.appLE (k ⁻¹ᵁ U) V' e').hom ((k.app U).hom s)) =
        ((g ≫ k).appLE U' V e).hom ((C.presheaf.map (homOfLE hU').op).hom s) := by
    intro A B C g k U U' hU' V V' hV e' e s
    have h1 := Scheme.Hom.appLE_map g e' (homOfLE hV).op
    have h2 := Scheme.Hom.map_appLE (g ≫ k) e (homOfLE hU').op
    have h3 := Scheme.Hom.comp_appLE g k U V (le_trans hV e')
    show ((k.app U ≫ g.appLE (k ⁻¹ᵁ U) V' e') ≫ A.presheaf.map (homOfLE hV).op).hom s =
      (C.presheaf.map (homOfLE hU').op ≫ (g ≫ k).appLE U' V e).hom s
    rw [Category.assoc, h1, h2, h3]
  have GL2 : ∀ {A B : Scheme.{u}} (g : A ⟶ B) (U : B.Opens) (V V' : A.Opens) (hV : V ≤ V')
      (e' : V' ≤ g ⁻¹ᵁ U) (e : V ≤ g ⁻¹ᵁ U) (s : Γ(B, U)),
      (A.presheaf.map (homOfLE hV).op).hom ((g.appLE U V' e').hom s) = (g.appLE U V e).hom s := by
    intro A B g U V V' hV e' e s
    exact congrArg (fun φ => CommRingCat.Hom.hom φ s) (Scheme.Hom.appLE_map g e' (homOfLE hV).op)
  have GL3 : ∀ {A B : Scheme.{u}} (g : A ⟶ B) (U U' : B.Opens) (V : A.Opens) (hU' : U' ≤ U)
      (e : V ≤ g ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U') (s : Γ(B, U)),
      (g.appLE U' V e').hom ((B.presheaf.map (homOfLE hU').op).hom s) = (g.appLE U V e).hom s := by
    intro A B g U U' V hU' e e' s
    exact congrArg (fun φ => CommRingCat.Hom.hom φ s) (Scheme.Hom.map_appLE g e' (homOfLE hU').op)

  have T0 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g G : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hG : G ∈ 𝒜 (2 • 1)),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 2 G hG)) =
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) ^ 2 *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
            Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 G hG)) := by
    intro σ A _ _ _ 𝒜 _ f g G hf hg hG
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 2 G hG)) =
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) ^ 2 *
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 2 G hG)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e2, e2, e1, ← map_pow, ← map_mul]
      congr 1
      rw [sq, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul]
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have I0 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e1, e2, ← map_mul]
      have h1 : HomogeneousLocalization.awayMap 𝒜 hg (rfl : f * g = f * g)
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) *
          HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g)
            (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf) = 1 := by
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_mul, Localization.mk_eq_mk_iff,
          Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul, mul_one]
        ring
      rw [h1, map_one]
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  have Tw : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (a b : Fin (N + 1)),
      ((wcProjK E N).presheaf.map (homOfLE (inf_le_right :
          wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N b)).op).hom (wcLdpSec E N G b) =
        ((wcProjK E N).presheaf.map (homOfLE (inf_le_right :
          wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N b)).op).hom (wcSgE E N b a) ^ 2 *
        ((wcProjK E N).presheaf.map (homOfLE (inf_le_left :
          wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N a)).op).hom (wcLdpSec E N G a) := by
    intro G a b
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact T0 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)
      (MvPolynomial.X b) (G : MvPolynomial (Fin (N + 1)) E) (hX N a) (hX N b) G.2
  have Iw : ∀ (n : ℕ) (J L : Fin (n + 1)),
      ((wcProjK E n).presheaf.map (homOfLE (inf_le_left :
          wcSgD E n J ⊓ wcSgD E n L ≤ wcSgD E n J)).op).hom (wcSgE E n J L) *
        ((wcProjK E n).presheaf.map (homOfLE (inf_le_right :
          wcSgD E n J ⊓ wcSgD E n L ≤ wcSgD E n L)).op).hom (wcSgE E n L J) = 1 := by
    intro n J L
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact I0 (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) (MvPolynomial.X J)
      (MvPolynomial.X L) (hX n J) (hX n L)

  have EX0 : ∀ {R : Type u} [CommRing R] (x y s w w' : R), w' * w = 1 →
      ∃ v : R, IsUnit v ∧ w ^ 2 * x - s * (w ^ 2 * y) = v * (x - s * y) := by
    intro R _ x y s w w' hw
    exact ⟨w ^ 2, (IsUnit.of_mul_eq_one w' (by rw [mul_comm]; exact hw)).pow 2, by ring⟩
  have EX1 : ∀ {R : Type u} [CommRing R] (x y s s' w w' : R), w' * w = 1 → s * s' = 1 →
      ∃ v : R, IsUnit v ∧ w ^ 2 * x - s' * (w ^ 2 * y) = v * (y - s * x) := by
    intro R _ x y s s' w w' hw hs
    refine ⟨-(s' * w ^ 2), ((IsUnit.of_mul_eq_one s (by rw [mul_comm]; exact hs)).mul
      ((IsUnit.of_mul_eq_one w' (by rw [mul_comm]; exact hw)).pow 2)).neg, ?_⟩
    linear_combination (-(w ^ 2 * x)) * hs
  have hfin : ∀ i j : Fin 2, j ≠ i → j = i + 1 ∧ j + 1 = i := by decide

  have MAIN : ∀ (P : Scheme.{u}) (p1 : P ⟶ X.left) (p2 : P ⟶ wcProjK E 1) (a b : Fin (N + 1))
      (i j : Fin 2) (Wp Wq : P.Opens) (hWa : Wp ≤ p1 ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N a))
      (hWi : Wp ≤ p2 ⁻¹ᵁ wcSgD E 1 i) (hWb : Wq ≤ p1 ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N b))
      (hWj : Wq ≤ p2 ⁻¹ᵁ wcSgD E 1 j),
      ∃ u : Γ(P, Wp ⊓ Wq), IsUnit u ∧
        (P.presheaf.map (homOfLE (inf_le_right : Wp ⊓ Wq ≤ Wq)).op).hom
          ((p1.appLE (ι ⁻¹ᵁ wcSgD E N b) Wq hWb).hom
              ((ι.app (wcSgD E N b)).hom (wcLdpSec E N (![G₀, G₁] (j + 1)) b)) -
            (p2.appLE (wcSgD E 1 j) Wq hWj).hom (wcSgE E 1 j (j + 1)) *
            (p1.appLE (ι ⁻¹ᵁ wcSgD E N b) Wq hWb).hom
              ((ι.app (wcSgD E N b)).hom (wcLdpSec E N (![G₀, G₁] j) b))) =
        u * (P.presheaf.map (homOfLE (inf_le_left : Wp ⊓ Wq ≤ Wp)).op).hom
          ((p1.appLE (ι ⁻¹ᵁ wcSgD E N a) Wp hWa).hom
              ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] (i + 1)) a)) -
            (p2.appLE (wcSgD E 1 i) Wp hWi).hom (wcSgE E 1 i (i + 1)) *
            (p1.appLE (ι ⁻¹ᵁ wcSgD E N a) Wp hWa).hom
              ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] i) a))) := by
    intro P p1 p2 a b i j Wp Wq hWa hWi hWb hWj
    have hOX : Wp ⊓ Wq ≤ (p1 ≫ ι) ⁻¹ᵁ (wcSgD E N a ⊓ wcSgD E N b) :=
      fun x hx => ⟨hWa hx.1, hWb hx.2⟩
    have hOP : Wp ⊓ Wq ≤ p2 ⁻¹ᵁ (wcSgD E 1 i ⊓ wcSgD E 1 j) :=
      fun x hx => ⟨hWi hx.1, hWj hx.2⟩
    have hOi : Wp ⊓ Wq ≤ p2 ⁻¹ᵁ wcSgD E 1 i := le_trans inf_le_left hWi
    have hOj : Wp ⊓ Wq ≤ p2 ⁻¹ᵁ wcSgD E 1 j := le_trans inf_le_right hWj
    have hw : ((p1 ≫ ι).appLE (wcSgD E N a ⊓ wcSgD E N b) (Wp ⊓ Wq) hOX).hom
          (((wcProjK E N).presheaf.map (homOfLE (inf_le_left :
            wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N a)).op).hom (wcSgE E N a b)) *
        ((p1 ≫ ι).appLE (wcSgD E N a ⊓ wcSgD E N b) (Wp ⊓ Wq) hOX).hom
          (((wcProjK E N).presheaf.map (homOfLE (inf_le_right :
            wcSgD E N a ⊓ wcSgD E N b ≤ wcSgD E N b)).op).hom (wcSgE E N b a)) = 1 := by
      rw [← map_mul, Iw N a b, map_one]
    simp only [map_sub, map_mul]
    rw [GL1 p1 ι (wcSgD E N b) (wcSgD E N a ⊓ wcSgD E N b) inf_le_right (Wp ⊓ Wq) Wq
        inf_le_right hWb hOX,
      GL1 p1 ι (wcSgD E N b) (wcSgD E N a ⊓ wcSgD E N b) inf_le_right (Wp ⊓ Wq) Wq
        inf_le_right hWb hOX,
      GL1 p1 ι (wcSgD E N a) (wcSgD E N a ⊓ wcSgD E N b) inf_le_left (Wp ⊓ Wq) Wp
        inf_le_left hWa hOX,
      GL1 p1 ι (wcSgD E N a) (wcSgD E N a ⊓ wcSgD E N b) inf_le_left (Wp ⊓ Wq) Wp
        inf_le_left hWa hOX,
      GL2 p2 (wcSgD E 1 j) (Wp ⊓ Wq) Wq inf_le_right hWj hOj,
      GL2 p2 (wcSgD E 1 i) (Wp ⊓ Wq) Wp inf_le_left hWi hOi,
      Tw, Tw]
    simp only [map_mul, map_pow]
    by_cases hij : j = i
    · subst hij
      exact EX0 _ _ _ _ _ hw
    · obtain ⟨hj1, hj2⟩ := hfin i j hij
      rw [hj2, ← hj1]
      have hss : (p2.appLE (wcSgD E 1 i) (Wp ⊓ Wq) hOi).hom (wcSgE E 1 i j) *
          (p2.appLE (wcSgD E 1 j) (Wp ⊓ Wq) hOj).hom (wcSgE E 1 j i) = 1 := by
        rw [← GL3 p2 (wcSgD E 1 i) (wcSgD E 1 i ⊓ wcSgD E 1 j) (Wp ⊓ Wq) inf_le_left hOi hOP,
          ← GL3 p2 (wcSgD E 1 j) (wcSgD E 1 i ⊓ wcSgD E 1 j) (Wp ⊓ Wq) inf_le_right hOj hOP,
          ← map_mul, Iw 1 i j, map_one]
      exact EX1 _ _ _ _ _ _ hw hss

  have AFF : ∀ (S X Y : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S) (U : X.Opens)
      (C : Y.Opens), IsAffineOpen U → IsAffineOpen C →
      IsAffineOpen ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C) := by
    intro S X Y _ f g U C hU hC
    have hP : IsPullback
        ((Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left)
        ((Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right)
        (U.ι ≫ f) (C.ι ≫ g) := by
      have comm : (Limits.pullback.fst f g).resLE U ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_left ≫ (U.ι ≫ f) =
          (Limits.pullback.snd f g).resLE C ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓
          (Limits.pullback.snd f g) ⁻¹ᵁ C) inf_le_right ≫ (C.ι ≫ g) := by
        rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
          Category.assoc, Category.assoc, Limits.pullback.condition]
      have hc : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          (s.fst ≫ U.ι) ≫ f = (s.snd ≫ C.ι) ≫ g := by
        intro s
        rw [Category.assoc, Category.assoc]
        exact s.condition
      have hrange : ∀ (s : Limits.PullbackCone (U.ι ≫ f) (C.ι ≫ g)),
          Set.range (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s)) ⊆
            Set.range ((Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (Limits.pullback.snd f g) ⁻¹ᵁ C).ι := by
        intro s
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        refine ⟨?_, ?_⟩
        · show (Limits.pullback.fst f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ U
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
          have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
        · show (Limits.pullback.snd f g) (Limits.pullback.lift (s.fst ≫ U.ι) (s.snd ≫ C.ι) (hc s) x) ∈ C
          rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, Scheme.Hom.comp_apply]
          have h : C.ι (s.snd x) ∈ Set.range C.ι := ⟨_, rfl⟩
          rwa [Scheme.Opens.range_ι] at h
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
      refine Limits.PullbackCone.IsLimit.mk comm
        (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
      · intro s
        rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_fst]
      · intro s
        rw [← cancel_mono C.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
          IsOpenImmersion.lift_fac, Limits.pullback.lift_snd]
      · intro s m h1 h2
        apply IsOpenImmersion.lift_uniq
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
        · rw [Limits.pullback.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
    haveI : IsAffine (U : Scheme.{u}) := hU
    haveI : IsAffine (C : Scheme.{u}) := hC
    exact IsAffine.of_isIso hP.isoPullback.hom

  have COV : ∀ (m : ℕ), (⨆ a : Fin (m + 1), wcSgD E m a) = ⊤ := by
    intro m
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) E) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  refine ⟨?_, ?_, ?_⟩
  ·
    rintro ⟨a, e⟩
    exact AFF (Spec (.of E)) X.left (wcProjK E 1) X.hom (wcProjKStr E 1)
      (ι ⁻¹ᵁ wcSgD E N a) (wcSgD E 1 e) ((haff N a).preimage ι) (haff 1 e)
  ·
    rw [eq_top_iff]
    intro x _
    have hc1 : (⨆ a : Fin (N + 1), wcSgD E N a) = ⊤ := COV N
    have hc2 : (⨆ e : Fin (1 + 1), wcSgD E 1 e) = ⊤ := COV 1
    have h1 : ι (Limits.pullback.fst X.hom (wcProjKStr E 1) x) ∈
        (⨆ a : Fin (N + 1), wcSgD E N a) := by
      rw [hc1]; trivial
    have h2 : Limits.pullback.snd X.hom (wcProjKStr E 1) x ∈ (⨆ e : Fin (1 + 1), wcSgD E 1 e) := by
      rw [hc2]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp h1
    obtain ⟨e, he⟩ := TopologicalSpace.Opens.mem_iSup.mp h2
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨(a, e), ⟨ha, he⟩⟩
  ·
    rintro ⟨a, i⟩ ⟨b, j⟩
    exact MAIN _ (Limits.pullback.fst X.hom (wcProjKStr E 1))
      (Limits.pullback.snd X.hom (wcProjKStr E 1)) a b i j
      (wcLdpW E N X ι (a, i)) (wcLdpW E N X ι (b, j)) inf_le_left inf_le_right inf_le_left
      inf_le_right

theorem wc_ldpi_oai_sgE_facts (K : Type u) [Field K] (n : ℕ) (J L : Fin (n + 1)) :
    wcSgE K n J J = 1 ∧ (wcProjK K n).basicOpen (wcSgE K n J L) = wcSgD K n J ⊓ wcSgD K n L :=
by
  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  refine ⟨?_, ?_⟩
  · have h1 : HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J) 1
        (MvPolynomial.X J) (hX J) = 1 := by
