      (wcEtBaseChange (𝟙 Y)).map u ≫ (c V').hom = (c V).hom ≫ (𝟭 Y.Etale).map u := by
    intro V V' u
    apply MorphismProperty.Over.Hom.ext
    change ((wcEtBaseChange (𝟙 Y)).map u).left ≫ (c V').hom.left = (c V).hom.left ≫ u.left
    rw [hc V, hc V']
    exact Limits.pullback.lift_fst _ _ _
  obtain ⟨β⟩ : Nonempty (wcEtBaseChange (𝟙 Y) ≅ 𝟭 Y.Etale) := ⟨NatIso.ofComponents c nat⟩
  obtain ⟨θ⟩ : Nonempty (wcEtInv (𝟙 Y) ≅ 𝟭 (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})) :=
    ⟨(Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtBaseChange (𝟙 Y))
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y) :
        wcEtInv (𝟙 Y) ⊣ _).leftAdjointUniq
      (Adjunction.id.ofNatIsoRight
        (Functor.sheafPushforwardContinuousIso β AddCommGrpCat.{u+1} _ _ ≪≫
          Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} _).symm)⟩
  have hMbij : ∀ A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      Function.Bijective (fun z : Abelian.Ext A B q =>
        Abelian.Ext.mapExactFunctor (wcEtInv (𝟙 Y)) z) := by
    intro A B
    have hform : ∀ z : Abelian.Ext A B q, Abelian.Ext.mapExactFunctor (wcEtInv (𝟙 Y)) z =
        (Abelian.Ext.mk₀ (θ.hom.app A)).comp
          (z.comp (Abelian.Ext.mk₀ (θ.inv.app B)) (add_zero q)) (zero_add q) := by
      intro z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z θ.hom
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      have e1 : Abelian.Ext.mapExactFunctor (wcEtInv (𝟙 Y)) z =
          ((Abelian.Ext.mapExactFunctor (wcEtInv (𝟙 Y)) z).comp
            (Abelian.Ext.mk₀ (θ.hom.app B)) (add_zero q)).comp
