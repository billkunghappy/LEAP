          (wcGeomFrob F' (Over.mk (Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F F'))))) hX') ≫ E :=
      MorphismProperty.Over.Hom.ext hfr.symm
    show Ψ P' ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left E)).comp
        ((⇑(wcCohFrob F X h ℓ i))^[Module.finrank F F'] x) (zero_add i)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap U.left (wcGeomFrob F' (Over.mk (Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F F'))))) hX'))).comp
        (Ψ P' ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left E)).comp x (zero_add i))) (zero_add i)
    rw [h7, Abelian.Ext.mk₀_comp_mk₀_assoc, ← L4.1, key, L4.1, ← Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact hΨn P' P' _ _

theorem wc_sf_pullback_restrict_finite : ∀ {P X Y Q : Scheme.{u}} (fst : P ⟶ Y) (snd : P ⟶ X) (f : Y ⟶ Q) (g : X ⟶ Q), IsPullback fst snd f g → ∀ (V : Q.Opens), IsFinite (f ∣_ V) → ∀ (U : X.Opens), U ≤ g ⁻¹ᵁ V → IsFinite (snd ∣_ U) :=
by
  intro P X Y Q fst snd f g H V hV U hU
  have A0 := isPullback_morphismRestrict snd U
  have t := (isPullback_morphismRestrict f V).flip
  have s0 := A0.flip.paste_horiz H
  have s : IsPullback ((snd ⁻¹ᵁ U).ι ≫ fst) (snd ∣_ U) f (g.resLE V U hU ≫ V.ι) := by
    rw [Scheme.Hom.resLE_comp_ι]; exact s0
  exact MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_right' s t) hV

theorem wc_sf_function_field_finite : ∀ (S T : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral T] (f : T ⟶ S) (hgen : f (genericPoint T) ⤳ genericPoint S) (U₀ : S.Opens), IsAffineOpen U₀ → U₀ ≠ ⊥ → IsFinite (f ∣_ U₀) → letI : Algebra S.functionField T.functionField := (S.presheaf.stalkSpecializes hgen ≫ f.stalkMap (genericPoint T)).hom.toAlgebra; FiniteDimensional S.functionField T.functionField :=
by
  intro S T _ _ f hgen U₀ hU₀ hne hfin

  have s2 : ∀ (A B K L : Type u) [CommRing A] [CommRing B] [Field K] [Field L] [Algebra B L]
      [IsFractionRing B L] [Algebra K L] (φ : A →+* B) (ψ : A →+* K), φ.Finite →
      (∀ a : A, algebraMap B L (φ a) = algebraMap K L (ψ a)) → FiniteDimensional K L := by
    intro A B K L _ _ _ _ _ _ _ φ ψ hφ hc
    letI : Algebra A B := φ.toAlgebra
    haveI : Module.Finite A B := hφ
    obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := A) (M := B)
    have hint : ∀ i, IsIntegral K (algebraMap B L (b i)) := by
      intro i
      have h1 : IsIntegral A (b i) := IsIntegral.of_finite A (b i)
      exact IsIntegral.map_of_comp_eq ψ (algebraMap B L) (RingHom.ext fun a => (hc a).symm) h1
    set R : Subalgebra K L := Algebra.adjoin K (Set.range (fun i => algebraMap B L (b i))) with hR
    have hRfin : Module.Finite K R := by
      apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _)
      rintro _ ⟨i, rfl⟩
      exact hint i
    have hB : ∀ x : B, algebraMap B L x ∈ R := by
      intro x
      have hx : x ∈ Submodule.span A (Set.range b) := by rw [hb]; trivial
      obtain ⟨c, hc'⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hx
      rw [← hc', map_sum]
      refine Subalgebra.sum_mem _ fun i _ => ?_
      rw [Algebra.smul_def, map_mul]
      have e : algebraMap B L (algebraMap A B (c i)) = algebraMap K L (ψ (c i)) := hc (c i)
      rw [e]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Algebra.subset_adjoin ⟨i, rfl⟩)
    have hinv : ∀ z ∈ R, z⁻¹ ∈ R := by
      intro z hz
      have hfg : (Subalgebra.toSubmodule R).FG := Module.Finite.iff_fg.mp hRfin
      have hzi : IsIntegral K z := IsIntegral.of_mem_of_fg R hfg z hz
      exact hzi.inv_mem hz
    have htop : ∀ z : L, z ∈ R := by
      intro z
      obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := B) z
      rw [div_eq_mul_inv]
      exact R.mul_mem (hB x) (hinv _ (hB y))
    exact Module.Finite.of_surjective R.val.toLinearMap (fun z => ⟨⟨z, htop z⟩, rfl⟩)
  letI : Algebra S.functionField T.functionField :=
    (S.presheaf.stalkSpecializes hgen ≫ f.stalkMap (genericPoint T)).hom.toAlgebra
  obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mp hne
  have hS : genericPoint S ∈ U₀ := (genericPoint_specializes u).mem_open U₀.isOpen hu
  have hT : genericPoint T ∈ f ⁻¹ᵁ U₀ := hgen.mem_open U₀.isOpen hS
  haveI : Nonempty U₀ := ⟨⟨_, hS⟩⟩
  haveI : Nonempty (f ⁻¹ᵁ U₀) := ⟨⟨_, hT⟩⟩
  haveI := hfin
  haveI : IsAffine (U₀ : Scheme) := hU₀

  have hAff : IsAffineOpen (f ⁻¹ᵁ U₀) := isAffine_of_isAffineHom (f ∣_ U₀)
  have hφ : (f.app U₀).hom.Finite := by
    have h1 : ((f ∣_ U₀).app ⊤).hom.Finite :=
      IsFinite.finite_app (f ∣_ U₀) ⊤ (isAffineOpen_top _)
    rw [morphismRestrict_app] at h1
    have gen : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (g : R₁ ⟶ R₂) (e : R₂ ⟶ R₃) [IsIso e],
        (g ≫ e).hom.Finite → g.hom.Finite := by
      intro R₁ R₂ R₃ g e _ h
      have h2 : (inv e).hom.Finite :=
        RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (inv e)).2
      have e1 : g = (g ≫ e) ≫ inv e := by simp
      rw [e1, CommRingCat.hom_comp]
      exact RingHom.Finite.comp h2 h
    have h2 := @gen _ _ _ _ _ (Functor.map_isIso _ _) h1
    have h3 : ∀ V : S.Opens, (f.app V).hom.Finite → V = U₀ → (f.app U₀).hom.Finite := by
      rintro V h rfl
      exact h
    exact h3 _ h2 (Scheme.Opens.ι_image_top U₀)
  haveI := functionField_isFractionRing_of_isAffineOpen T (f ⁻¹ᵁ U₀) hAff

  have hcomp : ∀ a : Γ(S, U₀), algebraMap Γ(T, f ⁻¹ᵁ U₀) T.functionField ((f.app U₀).hom a) =
      algebraMap S.functionField T.functionField (algebraMap Γ(S, U₀) S.functionField a) := by
    intro a
    have e : S.presheaf.germ U₀ (genericPoint S) hS ≫ S.presheaf.stalkSpecializes hgen ≫
        f.stalkMap (genericPoint T) = f.app U₀ ≫ T.presheaf.germ (f ⁻¹ᵁ U₀) (genericPoint T) hT := by
      rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap]
    exact (congrArg (fun φ => φ.hom a) e).symm
  exact s2 Γ(S, U₀) Γ(T, f ⁻¹ᵁ U₀) S.functionField T.functionField (f.app U₀).hom
    (algebraMap Γ(S, U₀) S.functionField) hφ hcomp

theorem wc_sf_fromNormalization_finite : ∀ (k : Type u) [Field k] [PerfectField k] (S T : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral T] (sS : S ⟶ Spec (.of k)) [LocallyOfFiniteType sS] (f : T ⟶ S) [QuasiCompact f] [QuasiSeparated f] (hgen : f (genericPoint T) ⤳ genericPoint S), (∀ (k : Type u) [Field k] [PerfectField k] (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (B : Type u) [CommRing B] [Algebra A B] (ι : B →ₐ[A] L), Function.Injective ι → Module.Finite A (integralClosure A B)) → (letI : Algebra S.functionField T.functionField := (S.presheaf.stalkSpecializes hgen ≫ f.stalkMap (genericPoint T)).hom.toAlgebra; FiniteDimensional S.functionField T.functionField) → IsFinite f.fromNormalization :=
by
  intro k _ _ S T _ _ sS _ f _ _ hgen hL6 hFD
  rw [isFinite_iff]
  refine ⟨inferInstance, fun U hU => ?_⟩
  letI : Algebra Γ(S, U) Γ(T, f ⁻¹ᵁ U) := (f.app U).hom.toAlgebra
  have hM : Module.Finite Γ(S, U) (integralClosure Γ(S, U) Γ(T, f ⁻¹ᵁ U)) := by
    by_cases hU0 : U = ⊥
    · subst hU0
      haveI : Subsingleton Γ(S, ⊥) :=
        CommRingCat.subsingleton_of_isTerminal (S.sheaf.isTerminalOfEmpty)
      haveI : Subsingleton (integralClosure Γ(S, ⊥) Γ(T, f ⁻¹ᵁ ⊥)) :=
        Module.subsingleton Γ(S, ⊥) _
      exact ⟨⟨∅, Subsingleton.elim _ _⟩⟩
    · obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0
      have hS : genericPoint S ∈ U := (genericPoint_specializes u).mem_open U.isOpen hu
      have hT : genericPoint T ∈ f ⁻¹ᵁ U := hgen.mem_open U.isOpen hS
      haveI : Nonempty U := ⟨⟨_, hS⟩⟩
      have hFT : ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          sS.appLE ⊤ U (by simp)).hom.FiniteType := by
        have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType sS inferInstance
          ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ (by simp)
        have h2 : (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom.FiniteType :=
          RingHom.FiniteType.of_surjective _ (ConcreteCategory.bijective_of_isIso _).2
        rw [CommRingCat.hom_comp]
        exact h1.comp h2
      have hcomm : f.app U ≫ T.presheaf.germ (f ⁻¹ᵁ U) (genericPoint T) hT =
          S.presheaf.germ U (genericPoint S) hS ≫ S.presheaf.stalkSpecializes hgen ≫
            f.stalkMap (genericPoint T) := by
        rw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap]
      letI : Algebra k Γ(S, U) :=
        ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ sS.appLE ⊤ U (by simp)).hom.toAlgebra
      haveI : Algebra.FiniteType k Γ(S, U) := hFT
      haveI : IsFractionRing Γ(S, U) S.functionField :=
        functionField_isFractionRing_of_isAffineOpen S U hU
      letI : Algebra S.functionField T.functionField :=
        (S.presheaf.stalkSpecializes hgen ≫ f.stalkMap (genericPoint T)).hom.toAlgebra
      haveI : FiniteDimensional S.functionField T.functionField := hFD
      letI : Algebra Γ(S, U) T.functionField :=
        ((algebraMap S.functionField T.functionField).comp
          (algebraMap Γ(S, U) S.functionField)).toAlgebra
      haveI : IsScalarTower Γ(S, U) S.functionField T.functionField :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      let ι : Γ(T, f ⁻¹ᵁ U) →ₐ[Γ(S, U)] T.functionField :=
        { toRingHom := (T.presheaf.germ (f ⁻¹ᵁ U) (genericPoint T) hT).hom
          commutes' := fun a => by
            have h := congrArg (fun φ => φ.hom a) hcomm
            simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
            exact h }
      have hι : Function.Injective ι := germ_injective_of_isIntegral T (genericPoint T) hT
      exact hL6 k Γ(S, U) S.functionField T.functionField Γ(T, f ⁻¹ᵁ U) ι hι
  rw [Scheme.Hom.fromNormalization_app f hU, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
  refine RingHom.Finite.comp ?_ ?_
  · exact RingHom.Finite.of_surjective _
      (ConcreteCategory.bijective_of_isIso (f.normalizationObjIso hU).inv).2
  · exact RingHom.finite_algebraMap.mpr hM

theorem wc_sf_toNormalization_iso_over_finite : ∀ (X Y : Scheme.{u}) (ε : X ⟶ Y) [QuasiCompact ε] [QuasiSeparated ε] (OY : Y.Opens), IsAffineOpen OY → IsFinite (ε ∣_ OY) → IsIso (ε.toNormalization ∣_ (ε.fromNormalization ⁻¹ᵁ OY)) :=
by
  intro X Y ε _ _ OY hOY hεfin
  haveI := hεfin
  haveI : IsAffine (OY : Scheme.{u}) := hOY

  have hsurj : ∀ {A B : Scheme.{u}} (g : A ⟶ B), IsIso g → Function.Surjective g := by
    intro A B g hg b
    exact ⟨(asIso g).inv b, Scheme.inv_hom_apply (asIso g) b⟩
  have hrange : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C), Function.Surjective f →
      Set.range (f ≫ g) = Set.range g := by
    intro A B C f g hf
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨f a, (Scheme.Hom.comp_apply f g a).symm⟩
    · rintro ⟨b, rfl⟩
      obtain ⟨a, rfl⟩ := hf b
      exact ⟨a, Scheme.Hom.comp_apply f g a⟩

  have s3 : ∀ (X' Z' : Scheme.{u}) (N : X' ⟶ Z') (W : Z'.Opens) (U : X'.Opens), N ⁻¹ᵁ W = U →
      IsOpenImmersion (U.ι ≫ N) → Set.range (U.ι ≫ N) = (W : Set Z') → IsIso (N ∣_ W) := by
    intro X' Z' N W U e hOI hR
    subst e
    rw [← morphismRestrict_ι] at hOI hR
    haveI := hOI
    haveI : IsOpenImmersion (N ∣_ W) := IsOpenImmersion.of_comp (N ∣_ W) W.ι
    have hs : Function.Surjective (N ∣_ W) := by
      intro w
      have hw : W.ι w ∈ Set.range (N ∣_ W ≫ W.ι) := by
        rw [hR, ← Scheme.Opens.range_ι]
        exact ⟨w, rfl⟩
      obtain ⟨x, hx⟩ := hw
      refine ⟨x, W.ι.isOpenEmbedding.injective ?_⟩
      rw [← Scheme.Hom.comp_apply]
      exact hx
    exact (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, ⟨hs⟩⟩

  haveI hAffX : IsAffine (ε ⁻¹ᵁ OY : Scheme.{u}) := isAffine_of_isAffineHom (ε ∣_ OY)
  have hAff : IsAffineOpen (ε ⁻¹ᵁ OY) := hAffX
  have hfin : (ε.app OY).hom.Finite := by
    have h : IsAffineOpen (OY.ι ⁻¹ᵁ OY) := by
      rw [Scheme.Opens.ι_preimage_self]; exact isAffineOpen_top _
    have h1 : ((ε ∣_ OY).app (OY.ι ⁻¹ᵁ OY)).hom.Finite := IsFinite.finite_app _ _ h
    haveI := Scheme.Hom.isIso_app OY.ι OY (Scheme.Opens.opensRange_ι OY).ge
    have h2 : (OY.ι.app OY).hom.Finite :=
      RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (OY.ι.app OY)).2
    have h3 := RingHom.Finite.comp h1 h2
    have h4 : ((ε ∣_ OY ≫ OY.ι).app OY).hom.Finite := by
      rw [Scheme.Hom.comp_app]; exact h3
    rw [morphismRestrict_ι, Scheme.Hom.comp_app] at h4
    haveI he := Scheme.Hom.isIso_app (ε ⁻¹ᵁ OY).ι (ε ⁻¹ᵁ OY)
      (Scheme.Opens.opensRange_ι (ε ⁻¹ᵁ OY)).ge
    have h5 : (inv ((ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY))).hom.Finite :=
      RingHom.Finite.of_surjective _
        (ConcreteCategory.bijective_of_isIso (inv ((ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY)))).2
    have e : ε.app OY = (ε.app OY ≫ (ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY)) ≫
        inv ((ε ⁻¹ᵁ OY).ι.app (ε ⁻¹ᵁ OY)) := by
      rw [Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    rw [e, CommRingCat.hom_comp]
    exact RingHom.Finite.comp h5 h4

  letI : Algebra Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) := (ε.app OY).hom.toAlgebra
  haveI hModA : Module.Finite Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) := hfin
  have hint : Algebra.IsIntegral Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) :=
    algebraMap_isIntegral_iff.mp hfin.to_isIntegral
  have htopI : integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) = ⊤ :=
    integralClosure_eq_top_iff.mpr hint
  have hbij : Function.Bijective (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val := by
    refine ⟨Subtype.val_injective, fun a => ⟨⟨a, ?_⟩, rfl⟩⟩
    rw [htopI]; trivial
  haveI hσ : IsIso (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr hbij

  have key : (ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization = (ε ⁻¹ᵁ OY).toSpecΓ ≫
      Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩ :=
    Scheme.Hom.ι_toNormalization ε ⟨OY, hOY⟩
  haveI hT : IsIso (ε ⁻¹ᵁ OY).toSpecΓ := by
    rw [← hAff.isoSpec_hom]; infer_instance
  have hc : IsOpenImmersion (ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
    ε.normalizationOpenCover.map_prop _
  have hS : IsIso (Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := by
    first
    | infer_instance
    | exact Functor.map_isIso Scheme.Spec _
  have hS' : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := IsOpenImmersion.of_isIso _
  have hT' : IsOpenImmersion (ε ⁻¹ᵁ OY).toSpecΓ := IsOpenImmersion.of_isIso _
  have h2 : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
    MorphismProperty.comp_mem @IsOpenImmersion _ _ hS' hc
  have h3 : IsOpenImmersion ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
    MorphismProperty.comp_mem @IsOpenImmersion _ _ hT' h2
  have hOI : IsOpenImmersion ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) := by
    rw [key]; exact h3
  have hrng : Set.range ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) =
      ε.fromNormalization ⁻¹' (OY : Set Y) := by
    have e2 := hrange (ε ⁻¹ᵁ OY).toSpecΓ (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hT)
    have e3 := hrange (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom))
      (ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hS)
    have e4 : Set.range (ε.normalizationOpenCover.f ⟨OY, hOY⟩) =
        ε.fromNormalization ⁻¹' (OY : Set Y) := by
      have h := congrArg (fun U : ε.normalization.Opens => (U : Set ε.normalization))
        (Scheme.Hom.fromNormalization_preimage ε ⟨OY, hOY⟩)
      exact h.symm
    have e5 : Set.range ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) =
        Set.range ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
          ε.normalizationOpenCover.f ⟨OY, hOY⟩) := by
      rw [key]
    exact e5.trans (e2.trans (e3.trans e4))

  have hpre : ε.toNormalization ⁻¹ᵁ (ε.fromNormalization ⁻¹ᵁ OY) = ε ⁻¹ᵁ OY := by
    rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization]
  exact s3 X ε.normalization ε.toNormalization (ε.fromNormalization ⁻¹ᵁ OY) (ε ⁻¹ᵁ OY)
    hpre hOI hrng

theorem wc_hm_stein_factor (F' : Type u) [Field F'] [Finite F']
    (X' : Over (Spec (.of F')))
    [GeometricallyIrreducible X'.hom] [IsProper X'.hom] (d : ℕ) [SmoothOfRelativeDimension d X'.hom]
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom]
    [SmoothOfRelativeDimension d Y.hom]
    (π : Y.left ⟶ X'.left) (hπ : π ≫ X'.hom = Y.hom) (hsurj : Surjective π)
    (hgf : ∃ V : X'.left.Opens, V ≠ ⊥ ∧ IsFinite (π ∣_ V))
    (πb : wcXbar F' Y ⟶ wcXbar F' X')
    (hπb₁ : πb ≫ Limits.pullback.fst X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
      Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫ π)
    (hπb₂ : πb ≫ Limits.pullback.snd X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
      Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :
    ∃ (Z : Scheme.{u}) (g : Z ⟶ wcXbar F' X') (h : wcXbar F' Y ⟶ Z),
      h ≫ g = πb ∧ IsFinite g ∧ Surjective g ∧ AlgebraicGeometry.IsIntegral Z ∧
      IsProper h ∧ Surjective h ∧ IsProper (g ≫ wcPi2 F' X') ∧
      h ≫ (g ≫ wcPi2 F' X') = wcPi2 F' Y ∧
      ∃ W : Z.Opens, W ≠ ⊥ ∧ IsIso (h ∣_ W) :=
by
  classical

  have hInt : ∀ (Z : Over (Spec (.of F'))) [GeometricallyIrreducible Z.hom]
      [SmoothOfRelativeDimension d Z.hom], AlgebraicGeometry.IsIntegral (wcXbar F' Z) := by
    intro Z _ _
    haveI hsm : SmoothOfRelativeDimension d (Limits.pullback.snd Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
        (IsPullback.of_hasPullback Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) ‹_›
    haveI hirr : IrreducibleSpace (wcXbar F' Z) :=
      ‹GeometricallyIrreducible Z.hom›.geometrically_irreducibleSpace
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
        (Limits.pullback.fst _ _) (Limits.pullback.snd _ _)
        (IsPullback.of_hasPullback Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
    haveI : ∀ z : wcXbar F' Z, _root_.IsReduced ((wcXbar F' Z).presheaf.stalk z) := fun z => by
      haveI := wcpa_smooth_stalk_isDomain (AlgebraicClosure F') (wcXbar F' Z)
        (Limits.pullback.snd Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) d z
      infer_instance
    haveI : AlgebraicGeometry.IsReduced (wcXbar F' Z) := isReduced_of_isReduced_stalk _
    exact isIntegral_of_irreducibleSpace_of_isReduced _
  haveI hXI : AlgebraicGeometry.IsIntegral (wcXbar F' X') := hInt X'
  haveI hYI : AlgebraicGeometry.IsIntegral (wcXbar F' Y) := hInt Y

  haveI : IsProper (π ≫ X'.hom) := by rw [hπ]; infer_instance
  haveI hπp : IsProper π := IsProper.of_comp π X'.hom

  have Q : IsPullback πb
      (Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
      (Limits.pullback.fst X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) π := by
    refine IsPullback.of_right ?_ hπb₁ (IsPullback.of_hasPullback X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).flip
    rw [hπb₂, hπ]
    exact (IsPullback.of_hasPullback Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).flip

  haveI hπbp : IsProper πb := MorphismProperty.of_isPullback (P := @IsProper) Q.flip hπp
  have hπbs : Surjective πb := MorphismProperty.of_isPullback (P := @Surjective) Q.flip hsurj

  haveI hp2 : IsProper (wcPi2 F' X') :=
    MorphismProperty.of_isPullback (P := @IsProper)
      (IsPullback.of_hasPullback X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) ‹_›

  have hgen : πb (genericPoint (wcXbar F' Y)) ⤳ genericPoint (wcXbar F' X') := by
    obtain ⟨t, ht⟩ := hπbs.surj (genericPoint (wcXbar F' X'))
    have h1 := (genericPoint_specializes t).map πb.continuous
    rw [ht] at h1
    exact h1

  obtain ⟨V, hV0, hVfin⟩ := hgf
  obtain ⟨v, hv⟩ : ∃ v, v ∈ V := by
    by_contra hne
    push_neg at hne
    apply hV0
    ext x
    simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
    exact hne x
  have hσ : Surjective (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) :=
    ⟨fun y => ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (AlgebraicClosure F')),
      Subsingleton.elim (α := PrimeSpectrum F') _ _⟩⟩
  have hfst : Surjective (Limits.pullback.fst X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).flip hσ
  obtain ⟨s, hs⟩ := hfst.surj v
  have hsV : s ∈ Limits.pullback.fst X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ⁻¹ᵁ V := by
    show _ ∈ V
    rw [hs]
    exact hv
  obtain ⟨OY, hOY, hsOY, hOYsub⟩ := exists_isAffineOpen_mem_and_subset hsV
  have hOYle : OY ≤ Limits.pullback.fst X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ⁻¹ᵁ V :=
    fun x hx => hOYsub hx
  have hOY0 : OY ≠ ⊥ := by
    rintro rfl
    exact hsOY
  have hOYfin : IsFinite (πb ∣_ OY) :=
    wc_sf_pullback_restrict_finite _ _ _ _ Q.flip V hVfin OY hOYle

  have hFD := wc_sf_function_field_finite (wcXbar F' X') (wcXbar F' Y) πb hgen OY hOY hOY0 hOYfin
  have hL6 : ∀ (k : Type u) [Field k] [PerfectField k] (A : Type u) [CommRing A] [IsDomain A]
      [Algebra k A] [Algebra.FiniteType k A] (K : Type u) [Field K] [Algebra A K]
      [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L]
      [IsScalarTower A K L] [FiniteDimensional K L] (B : Type u) [CommRing B] [Algebra A B]
      (ι : B →ₐ[A] L), Function.Injective ι → Module.Finite A (integralClosure A B) := by
    intro k _ _ A _ _ _ _ K _ _ _ L _ _ _ _ _ B _ _ ι hι
    exact wc_sf_integralClosure_finite_of_embedding k A K L B ι hι noether_integralClosure_finite
  haveI hgfin : IsFinite πb.fromNormalization :=
    wc_sf_fromNormalization_finite (AlgebraicClosure F') (wcXbar F' X') (wcXbar F' Y)
      (wcPi2 F' X') πb hgen hL6 hFD

  have hhg : πb.toNormalization ≫ πb.fromNormalization = πb :=
    Scheme.Hom.toNormalization_fromNormalization πb
  haveI : Surjective (πb.toNormalization ≫ πb.fromNormalization) := by rw [hhg]; exact hπbs
  haveI : IsProper (πb.toNormalization ≫ πb.fromNormalization) := by rw [hhg]; infer_instance
  haveI hhp : IsProper πb.toNormalization := IsProper.of_comp _ πb.fromNormalization
  have hhs : Surjective πb.toNormalization := by
    have hd := Scheme.Hom.denseRange πb.toNormalization
    have hc : IsClosed (Set.range πb.toNormalization) := by
      rw [← Set.image_univ]
      exact Scheme.Hom.isClosedMap _ _ isClosed_univ
    refine ⟨fun z => ?_⟩
    have hz : z ∈ closure (Set.range πb.toNormalization) := hd z
    rw [hc.closure_eq] at hz
    exact hz
  refine ⟨πb.normalization, πb.fromNormalization, πb.toNormalization, hhg, hgfin,
    Surjective.of_comp πb.toNormalization πb.fromNormalization, inferInstance, hhp, hhs,
    inferInstance, ?_, πb.fromNormalization ⁻¹ᵁ OY, ?_,
    wc_sf_toNormalization_iso_over_finite _ _ πb OY hOY hOYfin⟩
  · rw [← Category.assoc, hhg]
    exact hπb₂
  · obtain ⟨t, ht⟩ := hπbs.surj s
    have hmem : πb.toNormalization t ∈ πb.fromNormalization ⁻¹ᵁ OY := by
      show πb.fromNormalization (πb.toNormalization t) ∈ OY
      rw [← Scheme.Hom.comp_apply, hhg, ht]
      exact hsOY
    intro hW
    rw [hW] at hmem
    exact hmem

theorem wc_finite_pushforward_exact (F' : Type u) [Field F'] [Finite F']
    (X' : Over (Spec (.of F'))) [IsProper X'.hom]
    (Z : Scheme.{u}) (g : Z ⟶ wcXbar F' X') [IsFinite g]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg) :
    Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ) :=
by
  classical
  haveI hcont := Dg.cont
  haveI hlfp : LocallyOfFinitePresentation g := inferInstance

  have hsplit : ∀ (V : (wcXbar F' X').ProEt) (T : Sieve ((wcProEtBC g).obj V)),
      T ∈ Scheme.ProEt.topology Z ((wcProEtBC g).obj V) →
      ∃ R : Presieve V, Sieve.generate R ∈ Scheme.ProEt.topology (wcXbar F' X') V ∧
        ∀ ⦃W : (wcXbar F' X').ProEt⦄ (f : W ⟶ V), R f →
          ∃ (n : ℕ) (P : Fin n → Z.ProEt) (ι : ∀ k, P k ⟶ (wcProEtBC g).obj W),
            (∀ k, IsOpenImmersion (ι k).left) ∧
            (∀ x : ((wcProEtBC g).obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
            ∀ k, T (ι k ≫ (wcProEtBC g).map f) := by
    intro V T hT
    refine ⟨fun (W : (wcXbar F' X').ProEt) (_ : W ⟶ V) => IsAffine W.left ∧
        (IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, IsClosed ({x} : Set W.left) →
          HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))),
      wc_proet_cover_of_affine_local (fun Δ => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
        (fun V₀ hV₀ => wc_exists_wcontractible_cover V₀ hV₀) V, ?_⟩
    intro W f hRf
    obtain ⟨hWa, q1, q2, q3, q4⟩ := hRf
    haveI : IsAffine W.left := hWa
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hWa

    have hUa : IsAffine (Limits.pullback W.hom g) :=
      isAffine_of_isAffineHom (Limits.pullback.fst W.hom g)
    obtain ⟨r1, r2, r3, r4⟩ :=
      wc_wlocal_strictHensel_finite_stable (Limits.pullback.fst W.hom g) hWa q1 q2 q3 q4
    have hRET := wc_wlocal_strictHensel_retraction (Limits.pullback W.hom g) hUa r1 r2 r3 r4
    have hT' : T.pullback ((wcProEtBC g).map f) ∈
        Scheme.ProEt.topology Z ((wcProEtBC g).obj W) :=
      (Scheme.ProEt.topology Z).pullback_stable _ hT
    obtain ⟨n, P, fk, hPa, hTfk, hsurj⟩ :=
      wc_proet_cover_affine_finite_refine ((wcProEtBC g).obj W) hUa _ hT'
    obtain ⟨m, Q, ι, hopen, huniq, hfac⟩ :=
      wc_ret_disjoint_open_refine ((wcProEtBC g).obj W) hUa hRET n P fk hPa hsurj
    refine ⟨m, Q, ι, hopen, huniq, fun j => ?_⟩
    obtain ⟨k, h, hh⟩ := hfac j
    have hj := (T.pullback ((wcProEtBC g).map f)).downward_closed (hTfk k) h
    rw [hh] at hj
    exact hj

  haveI hepi := wc_sheafPushforward_preservesEpi_of_split (wcProEtBC g) hsplit

  haveI hlim : Limits.PreservesFiniteLimits ((wcProEtBC g).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology (wcXbar F' X')) (Scheme.ProEt.topology Z)) :=
    inferInstance
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology (wcXbar F' X')) (Scheme.ProEt.topology Z)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology (wcXbar F' X')) (Scheme.ProEt.topology Z)).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : ((wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology (wcXbar F' X')) (Scheme.ProEt.topology Z)).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hcolim : Limits.PreservesFiniteColimits ((wcProEtBC g).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology (wcXbar F' X')) (Scheme.ProEt.topology Z)) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology (wcXbar F' X')) (wcRingSheaf (wcXbar F' X') ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ)
  exact (sheafOfModules_pushforward_exact (wcProEtBC g) (wcRingSheaf (wcXbar F' X') ℓ)
    (wcRingSheaf Z ℓ) Dg.φ).2.2

theorem wc_fsus_alg_geom_transitive : ∀ (k A B G Ω : Type u) [Field k] [Infinite k] [CommRing A]
    [CommRing B] [Algebra k A] [Algebra A B] [Algebra k B] [IsScalarTower k A B] [Group G]
    [Fintype G] [MulSemiringAction G B] [SMulCommClass G A B] [Field Ω] (q : ℕ)
    (_hfix : ∀ b : B, (∀ g : G, g • b = b) → ∃ (n : ℕ) (a : A), algebraMap A B a = b ^ q ^ n)
    (_hfrob : ∀ (x y : Ω) (n : ℕ), x ^ q ^ n = y ^ q ^ n → x = y)
    (φ₁ φ₂ : B →+* Ω), φ₁.comp (algebraMap A B) = φ₂.comp (algebraMap A B) →
    ∃ g : G, ∀ b : B, φ₁ (g • b) = φ₂ b :=
by
  intro k A B G Ω _ _ _ _ _ _ _ _ _ _ _ _ _ q hfix hfrob φ₁ φ₂ h
  classical
  have hA : ∀ a : A, φ₁ (algebraMap A B a) = φ₂ (algebraMap A B a) := fun a => by
    have := RingHom.congr_fun h a
    simpa using this
  have hfixed : ∀ c : B, (∀ g : G, g • c = c) → φ₁ c = φ₂ c := by
    intro c hc
    obtain ⟨n, a, ha⟩ := hfix c hc
    apply hfrob _ _ n
    rw [← map_pow, ← map_pow, ← ha, hA]
  have hpt : ∀ b : B, ∃ g : G, φ₁ (g • b) = φ₂ b := by
    intro b
    have hmap : (prodXSubSMul G B b).map φ₁ = (prodXSubSMul G B b).map φ₂ := by
      ext n
      rw [Polynomial.coeff_map, Polynomial.coeff_map]
      exact hfixed _ (fun g => prodXSubSMul.coeff G B b g n)
    have h0 : ((prodXSubSMul G B b).map φ₁).eval (φ₂ b) = 0 := by
      rw [hmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, prodXSubSMul.eval, map_zero]
    rw [Polynomial.eval_map, prodXSubSMul, Polynomial.eval₂_finsetProd] at h0
    obtain ⟨ω, -, hω⟩ := Finset.prod_eq_zero_iff.mp h0
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C, sub_eq_zero] at hω
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective ω
    refine ⟨g, ?_⟩
    rw [← MulAction.ofQuotientStabilizer_mk G b g]
    exact hω.symm
  have hk : ∀ c : k, φ₁ (algebraMap k B c) = φ₂ (algebraMap k B c) := fun c => by
    rw [IsScalarTower.algebraMap_apply k A B c]
    exact hA _
  have hG : ∀ (g : G) (c : k), g • algebraMap k B c = algebraMap k B c := fun g c => by
    rw [IsScalarTower.algebraMap_apply k A B c, Algebra.algebraMap_eq_smul_one,
      smul_comm g (algebraMap k A c) (1 : B), smul_one]
  let V : G → Submodule k B := fun g =>
    { carrier := {b | φ₁ (g • b) = φ₂ b}
      add_mem' := by
        intro x y hx hy
        simp only [Set.mem_setOf_eq] at *
        rw [smul_add, map_add, map_add, hx, hy]
      zero_mem' := by simp
      smul_mem' := by
        intro c x hx
        simp only [Set.mem_setOf_eq] at *
        rw [Algebra.smul_def, smul_mul', hG, map_mul, map_mul, hx, hk] }
  have hcover : ⋃ g, (V g : Set B) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro b
    obtain ⟨g, hg⟩ := hpt b
    exact Set.mem_iUnion.mpr ⟨g, hg⟩
  obtain ⟨g, hg⟩ := Subspace.exists_eq_top_of_iUnion_eq_univ hcover
  refine ⟨g, fun b => ?_⟩
  have hb : b ∈ V g := by rw [hg]; exact Submodule.mem_top
  exact hb

theorem wc_fsus_fixed_pow_mem : ∀ (A K M : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [Field K] [Algebra A K] [IsFractionRing A K] [Field M] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] [FiniteDimensional K M] [Normal K M] (x : M),
    IsIntegral A x → (∀ σ : M ≃ₐ[K] M, σ x = x) →
    ∃ (n : ℕ) (a : A), algebraMap A M a = x ^ (ringExpChar K) ^ n :=
by
  intro A K M _ _ _ _ _ _ _ _ _ _ _ _ x hint hfix
  classical
  have hK : IsIntegral K x := Algebra.IsIntegral.isIntegral x
  have hf0 : minpoly K x ≠ 0 := minpoly.ne_zero hK
  have hroots : ∀ y ∈ (minpoly K x).aroots M, y = x := by
    intro y hy
    rw [Polynomial.mem_aroots] at hy
    obtain ⟨_, hy⟩ := hy
    have h1 : minpoly K x = minpoly K y :=
      minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hK) hy (minpoly.monic hK)
    have h3 := (Normal.minpoly_eq_iff_mem_orbit M).mp h1.symm
    obtain ⟨σ, hσ⟩ := MulAction.mem_orbit_iff.mp h3
    rw [← hσ, AlgEquiv.smul_def, hfix σ]
  have hx : x ∈ (minpoly K x).aroots M := Polynomial.mem_aroots.mpr ⟨hf0, minpoly.aeval K x⟩
  have hcard : ((minpoly K x).aroots M).toFinset = {x} := by
    ext z
    simp only [Multiset.mem_toFinset, Finset.mem_singleton]
    exact ⟨hroots z, fun h => h ▸ hx⟩
  have hsep : (minpoly K x).natSepDegree = 1 := by
    rw [Polynomial.natSepDegree_eq_of_splits (minpoly K x) (Normal.splits inferInstance x), hcard,
      Finset.card_singleton]
  have : ExpChar K (ringExpChar K) := ringExpChar.expChar K
  obtain ⟨n, hn⟩ := (minpoly.natSepDegree_eq_one_iff_pow_mem (ringExpChar K)).mp hsep
  obtain ⟨k, hk⟩ := hn
  have hkint : IsIntegral A k := by
    have : IsIntegral A (algebraMap K M k) := by rw [hk]; exact hint.pow _
    exact IsIntegral.tower_bot (algebraMap K M).injective this
  obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hkint
  exact ⟨n, a, by rw [IsScalarTower.algebraMap_apply A K M, ha, hk]⟩

theorem wc_fsus_intclosure_geom_transitive : ∀ (_hL1 : ∀ (k A B G Ω : Type u) [Field k] [Infinite k] [CommRing A]
        [CommRing B] [Algebra k A] [Algebra A B] [Algebra k B] [IsScalarTower k A B] [Group G]
        [Fintype G] [MulSemiringAction G B] [SMulCommClass G A B] [Field Ω] (q : ℕ)
        (_hfix : ∀ b : B, (∀ g : G, g • b = b) → ∃ (n : ℕ) (a : A), algebraMap A B a = b ^ q ^ n)
        (_hfrob : ∀ (x y : Ω) (n : ℕ), x ^ q ^ n = y ^ q ^ n → x = y)
        (φ₁ φ₂ : B →+* Ω), φ₁.comp (algebraMap A B) = φ₂.comp (algebraMap A B) →
        ∃ g : G, ∀ b : B, φ₁ (g • b) = φ₂ b)
      (_hL2 : ∀ (A K M : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
        [Field K] [Algebra A K] [IsFractionRing A K] [Field M] [Algebra K M] [Algebra A M]
        [IsScalarTower A K M] [FiniteDimensional K M] [Normal K M] (x : M),
        IsIntegral A x → (∀ σ : M ≃ₐ[K] M, σ x = x) →
        ∃ (n : ℕ) (a : A), algebraMap A M a = x ^ (ringExpChar K) ^ n)
      (k A K M B Ω : Type u) [Field k] [Infinite k] [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
      [Algebra k A] [Field K] [Algebra A K] [IsFractionRing A K] [Field M] [Algebra K M] [Algebra A M]
      [IsScalarTower A K M] [FiniteDimensional K M] [Normal K M] [CommRing B] [Algebra A B]
      [Algebra B M] [IsScalarTower A B M] [IsIntegralClosure B A M] [Field Ω] (φ₁ φ₂ : B →+* Ω),
      φ₁.comp (algebraMap A B) = φ₂.comp (algebraMap A B) →
      ∃ σ : M ≃ₐ[K] M, ∀ b b' : B, algebraMap B M b' = σ (algebraMap B M b) → φ₁ b' = φ₂ b :=
by
  intro hL1 hL2 k A K M B Ω _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ φ₁ φ₂ hφ
  classical
  letI : MulSemiringAction (M ≃ₐ[K] M) B := IsIntegralClosure.MulSemiringAction A K M B
  have hact : ∀ (σ : M ≃ₐ[K] M) (b : B), algebraMap B M (σ • b) = σ (algebraMap B M b) :=
    fun σ b => algebraMap_galRestrict_apply A σ b
  have hinj : Function.Injective (algebraMap B M) := IsIntegralClosure.algebraMap_injective B A M
  have hfixA : ∀ (σ : M ≃ₐ[K] M) (a : A), σ • algebraMap A B a = algebraMap A B a := by
    intro σ a
    apply hinj
    rw [hact, ← IsScalarTower.algebraMap_apply A B M, IsScalarTower.algebraMap_apply A K M,
      AlgEquiv.commutes]
  letI : SMulCommClass (M ≃ₐ[K] M) A B := ⟨fun σ a b => by
    rw [Algebra.smul_def a b, Algebra.smul_def a (σ • b), smul_mul', hfixA]⟩
  letI : Algebra k B := ((algebraMap A B).comp (algebraMap k A)).toAlgebra
  haveI : IsScalarTower k A B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hfix : ∀ b : B, (∀ g : M ≃ₐ[K] M, g • b = b) →
      ∃ (n : ℕ) (a : A), algebraMap A B a = b ^ (ringExpChar K) ^ n := by
    intro b hb
    have hint : IsIntegral A (algebraMap B M b) :=
      (IsIntegralClosure.isIntegral_iff (A := B) (R := A) (B := M)).mpr ⟨b, rfl⟩
    have hinv : ∀ σ : M ≃ₐ[K] M, σ (algebraMap B M b) = algebraMap B M b := fun σ => by
      rw [← hact, hb]
    obtain ⟨n, a, ha⟩ := hL2 A K M (algebraMap B M b) hint hinv
    refine ⟨n, a, hinj ?_⟩
    rw [← IsScalarTower.algebraMap_apply A B M, ha, map_pow]
  have hfrob : ∀ (x y : Ω) (n : ℕ), x ^ (ringExpChar K) ^ n = y ^ (ringExpChar K) ^ n → x = y := by
    intro x y n hxy
    have hE : ExpChar K (ringExpChar K) := ringExpChar.expChar K
    generalize ringExpChar K = q at hxy hE
    cases hE with
    | zero => simpa using hxy
    | prime hp =>
      have hK : ((q : ℕ) : K) = 0 := CharP.cast_eq_zero K q
      have hB : ((q : ℕ) : B) = 0 := by
        apply hinj
        rw [map_natCast, map_zero, ← map_natCast (algebraMap K M), hK, map_zero]
      have hΩ : ((q : ℕ) : Ω) = 0 := by
        rw [← map_natCast φ₁, hB, map_zero]
      haveI : CharP Ω q := (CharP.charP_iff_prime_eq_zero hp).mpr hΩ
      haveI : Fact q.Prime := ⟨hp⟩
      have h0 : (x - y) ^ q ^ n = 0 := by
        rw [sub_pow_char_pow, hxy, sub_self]
      exact sub_eq_zero.mp ((pow_eq_zero_iff (pow_ne_zero n hp.ne_zero)).mp h0)
  obtain ⟨g, hg⟩ := hL1 k A B (M ≃ₐ[K] M) Ω (ringExpChar K) hfix hfrob φ₁ φ₂ hφ
  refine ⟨g, fun b b' hbb' => ?_⟩
  have hb' : b' = g • b := hinj (by rw [hbb', hact])
  rw [hb', hg]

theorem wc_fsus_affine_sections_intclosed : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S],
    (∀ x : S, IsIntegrallyClosed (S.presheaf.stalk x)) →
    ∀ (U : S.Opens), IsAffineOpen U → Nonempty U → IsIntegrallyClosed Γ(S, U) :=
by
  intro S _ hst U hU hne
  haveI := hne
  have key : ∀ q : PrimeSpectrum Γ(S, U),
      IsIntegrallyClosed (Localization.AtPrime q.asIdeal) := by
    intro q
    have hqU' : hU.fromSpec q ∈ (U : Set S) := by
      rw [← hU.range_fromSpec]
      exact Set.mem_range_self q
    have hqU : hU.fromSpec q ∈ U := hqU'
    obtain ⟨x, hx⟩ : ∃ x : U, (x : S) = hU.fromSpec q := ⟨⟨_, hqU⟩, rfl⟩
    have hpx : hU.primeIdealOf x = q := by
      apply (Scheme.Hom.isOpenEmbedding hU.fromSpec).injective
      rw [hU.fromSpec_primeIdealOf x, hx]
    haveI := hU.isLocalization_stalk x
    haveI := hst (x : S)
    have h6 : IsIntegrallyClosed (Localization.AtPrime (hU.primeIdealOf x).asIdeal) :=
      IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv (hU.primeIdealOf x).asIdeal.primeCompl
        (S.presheaf.stalk (x : S)) (Localization.AtPrime (hU.primeIdealOf x).asIdeal)).toRingEquiv
    subst hpx
    exact h6
  apply IsIntegrallyClosed.of_localization_maximal
  intro p _ hmax
  exact key ⟨p, hmax.isPrime⟩

theorem wc_fsus_normalization_geom_transitive : ∀ (_hL3 : ∀ (k A K M B Ω : Type u) [Field k] [Infinite k] [CommRing A] [IsDomain A]
        [IsIntegrallyClosed A] [Algebra k A] [Field K] [Algebra A K] [IsFractionRing A K] [Field M]
        [Algebra K M] [Algebra A M] [IsScalarTower A K M] [FiniteDimensional K M] [Normal K M]
        [CommRing B] [Algebra A B] [Algebra B M] [IsScalarTower A B M] [IsIntegralClosure B A M]
        [Field Ω] (φ₁ φ₂ : B →+* Ω),
        φ₁.comp (algebraMap A B) = φ₂.comp (algebraMap A B) →
        ∃ σ : M ≃ₐ[K] M, ∀ b b' : B, algebraMap B M b' = σ (algebraMap B M b) → φ₁ b' = φ₂ b)
      (k : Type u) [Field k] [Infinite k] (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S]
      (_sk : S ⟶ Spec (.of k))
      (_hA : ∀ (U : S.Opens), IsAffineOpen U → Nonempty U → IsIntegrallyClosed Γ(S, U))
      (M : Type u) [Field M] [Algebra S.functionField M] [FiniteDimensional S.functionField M]
      [Normal S.functionField M] (f : Spec (.of M) ⟶ S) [QuasiCompact f] [QuasiSeparated f]
      (_hf : f = Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫
        S.fromSpecStalk (genericPoint S))
      (act : (M ≃ₐ[S.functionField] M) → (f.normalization ⟶ f.normalization))
      (_hact₁ : ∀ σ, f.toNormalization ≫ act σ =
        Spec.map (CommRingCat.ofHom (σ : M →+* M)) ≫ f.toNormalization)
      (_hact₂ : ∀ σ, act σ ≫ f.fromNormalization = f.fromNormalization)
      (Ω : Type u) [Field Ω] (z₁ z₂ : Spec (.of Ω) ⟶ f.normalization),
      z₁ ≫ f.fromNormalization = z₂ ≫ f.fromNormalization → ∃ σ, z₁ ≫ act σ = z₂ :=
by
  intro _hL3 k _ _ S _ _sk _hA M _ _ _ _ f _ _ _hf act _hact₁ _hact₂ Ω _ z₁ z₂ h
  classical

  have T_La : ∀ (R : CommRingCat.{u}) (X : Scheme.{u}) (V : X.Opens) (_ : IsAffineOpen V)
      (g₁ g₂ : Spec R ⟶ X) (h₁ : ⊤ ≤ g₁ ⁻¹ᵁ V) (h₂ : ⊤ ≤ g₂ ⁻¹ᵁ V),
      g₁.appLE V ⊤ h₁ = g₂.appLE V ⊤ h₂ → g₁ = g₂ := by
    intro R X V hV g₁ g₂ h₁ h₂ h
    have hT := isAffineOpen_top (Spec R)
    have e1 := IsAffineOpen.SpecMap_appLE_fromSpec g₁ hV hT h₁
    have e2 := IsAffineOpen.SpecMap_appLE_fromSpec g₂ hV hT h₂
    rw [h] at e1
    have e3 : hT.fromSpec ≫ g₁ = hT.fromSpec ≫ g₂ := e1.symm.trans e2
    rw [IsAffineOpen.fromSpec_top] at e3
    exact (cancel_epi _).mp e3
  have T_top : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (e : ⊤ ≤ g ⁻¹ᵁ ⊤),
      g.appLE ⊤ ⊤ e = g.appTop := fun g _ => Scheme.Hom.appLE_eq_app g (U := ⊤)
  have T_thin : ∀ {X : Scheme.{u}} {A B : X.Opens} (i j : Opposite.op A ⟶ Opposite.op B),
      i = j := fun _ _ => Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have T_cong : ∀ {X Y : Scheme.{u}} (g g' : X ⟶ Y) (_ : g = g') (U : Y.Opens) (W : X.Opens)
      (e : W ≤ g ⁻¹ᵁ U) (e' : W ≤ g' ⁻¹ᵁ U), g.appLE U W e = g'.appLE U W e' := by
    intro X Y g g' hg U W e e'
    subst hg; rfl
  have T_Ld : ∀ (R : CommRingCat.{u}) (Z : Scheme.{u}) (ι : Spec R ⟶ Z) (ψ : Z ⟶ Z) (τ : R ⟶ R)
      (_ : ι ≫ ψ = Spec.map τ ≫ ι) (V : Z.Opens) (h₀ : V ≤ ψ ⁻¹ᵁ V) (h : ⊤ ≤ ι ⁻¹ᵁ V),
      ψ.appLE V V h₀ ≫ ι.appLE V ⊤ h ≫ (Scheme.ΓSpecIso R).hom =
        ι.appLE V ⊤ h ≫ (Scheme.ΓSpecIso R).hom ≫ τ := by
    intro R Z ι ψ τ hψ V h₀ h
    have e₂ : (⊤ : (Spec R).Opens) ≤ Spec.map τ ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]
    have e₃ : (⊤ : (Spec R).Opens) ≤ (Spec.map τ ≫ ι) ⁻¹ᵁ V := fun x _ => by
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage]
      exact h trivial
    rw [← Category.assoc, Scheme.Hom.appLE_comp_appLE, T_cong _ _ hψ V ⊤ _ e₃,
      ← Scheme.Hom.appLE_comp_appLE _ _ V ⊤ ⊤ h e₂, T_top, Category.assoc,
      Scheme.ΓSpecIso_naturality]

  obtain ⟨U, hU, hUne, hz₁, hz₂⟩ : ∃ U : S.Opens, IsAffineOpen U ∧ Nonempty U ∧
      ⊤ ≤ z₁ ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U) ∧ ⊤ ≤ z₂ ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U) := by
    let x₀ : Spec (.of Ω) := default
    obtain ⟨U, hU, hpU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens S))
        (show f.fromNormalization (z₁ x₀) ∈ (⊤ : S.Opens) from trivial)
    refine ⟨U, hU, ⟨⟨_, hpU⟩⟩, ?_, ?_⟩
    · intro x _
      rw [Subsingleton.elim x x₀]
      exact hpU
    · intro x _
      rw [Subsingleton.elim x x₀]
      show f.fromNormalization (z₂ x₀) ∈ U
      rw [← Scheme.Hom.comp_apply, ← h, Scheme.Hom.comp_apply]
      exact hpU
  haveI := hUne

  obtain ⟨h₁, hα⟩ : ∃ h₁ : ⊤ ≤ f ⁻¹ᵁ U, f.appLE U ⊤ h₁ ≫ (Scheme.ΓSpecIso (.of M)).hom =
      S.germToFunctionField U ≫ CommRingCat.ofHom (algebraMap S.functionField M) := by
    have hηU : genericPoint S ∈ U := by
      obtain ⟨⟨x, hx⟩⟩ := hUne
      exact ((genericPoint_spec S).mem_open_set_iff U.isOpen).mpr ⟨x, trivial, hx⟩
    have e₁ : ⊤ ≤ S.fromSpecStalk (genericPoint S) ⁻¹ᵁ U := by
      intro y _
      have hy : S.fromSpecStalk (genericPoint S) y ⤳ genericPoint S := by
        have : S.fromSpecStalk (genericPoint S) y ∈
            Set.range (S.fromSpecStalk (genericPoint S)) := ⟨y, rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      exact hy.mem_open U.isOpen hηU
    have e₂ : (⊤ : (Spec (.of M)).Opens) ≤
        Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ⁻¹ᵁ ⊤ := by
      rw [Scheme.Hom.preimage_top]
    have h : ⊤ ≤ f ⁻¹ᵁ U := by
      rw [_hf, Scheme.Hom.comp_preimage]
      exact le_trans e₂ (Scheme.Hom.preimage_mono _ e₁)
    refine ⟨h, ?_⟩
    rw [T_cong _ _ _hf U ⊤ h (by rw [← _hf]; exact h),
      ← Scheme.Hom.appLE_comp_appLE _ _ U ⊤ ⊤ e₁ e₂, T_top, Category.assoc,
      Scheme.ΓSpecIso_naturality, Scheme.Hom.appLE, Scheme.fromSpecStalk_app hηU]
    simp only [Category.assoc]
    rw [← Functor.map_comp_assoc, T_thin (_ ≫ _) (𝟙 _), CategoryTheory.Functor.map_id,
      Category.id_comp]
    erw [Iso.inv_hom_id_assoc]
    rfl
  have hV : IsAffineOpen (f.fromNormalization ⁻¹ᵁ U) := hU.preimage _
  have h₂ : ⊤ ≤ f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U) := by
    rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization]
    exact h₁

  obtain ⟨hinj, hint⟩ : Function.Injective (f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U)
        ⊤ h₂ ≫ (Scheme.ΓSpecIso (.of M)).hom).hom ∧
      ∀ x : M, (f.appLE U ⊤ h₁ ≫ (Scheme.ΓSpecIso (.of M)).hom).hom.IsIntegralElem x ↔
        ∃ b, (f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ h₂ ≫
          (Scheme.ΓSpecIso (.of M)).hom).hom b = x := by
    letI := (f.app U).hom.toAlgebra
    have key := Scheme.Hom.toNormalization_app_preimage f ⟨U, hU⟩
    dsimp only at key
    let ρ : Γ(Spec (.of M), f ⁻¹ᵁ U) ⟶ CommRingCat.of M :=
      (Spec (.of M)).presheaf.map (homOfLE h₁).op ≫ (Scheme.ΓSpecIso (.of M)).hom
    have hρiso : IsIso ρ := by
      have : IsIso (homOfLE h₁) := by
        have he : (⊤ : (Spec (.of M)).Opens) = f ⁻¹ᵁ U := le_antisymm h₁ le_top
        rw [show homOfLE h₁ = eqToHom he from Subsingleton.elim _ _]
        infer_instance
      infer_instance
    let e : Γ(Spec (.of M), f ⁻¹ᵁ U) ≃+* CommRingCat.of M := (asIso ρ).commRingCatIsoToRingEquiv
    let eN := (Scheme.Hom.normalizationObjIso f hU).commRingCatIsoToRingEquiv
    have hβ' : ∀ b, (f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ h₂ ≫
        (Scheme.ΓSpecIso (.of M)).hom).hom b = e ((eN b).1) := by
      intro b
      rw [Scheme.Hom.appLE, key]
      simp only [Category.assoc]
      rw [← Functor.map_comp_assoc, T_thin (_ ≫ _) (homOfLE h₁).op]
      rfl
    have hα' : (f.appLE U ⊤ h₁ ≫ (Scheme.ΓSpecIso (.of M)).hom).hom =
        e.toRingHom.comp (f.app U).hom := by
      rw [Scheme.Hom.appLE, Category.assoc]
      rfl
    refine ⟨fun a b hab => ?_, fun x => ⟨fun hx => ?_, ?_⟩⟩
    · rw [hβ', hβ'] at hab
      exact eN.injective (Subtype.val_injective (e.injective hab))
    · have h1 := hx.map e.symm.toRingHom
      have hc : e.symm.toRingHom.comp (f.appLE U ⊤ h₁ ≫ (Scheme.ΓSpecIso (.of M)).hom).hom =
          (f.app U).hom := by
        rw [hα']
        ext y
        simp
      rw [hc] at h1
      have hy : e.symm x ∈ integralClosure Γ(S, U) Γ(Spec (.of M), f ⁻¹ᵁ U) := h1
      refine ⟨eN.symm ⟨_, hy⟩, ?_⟩
      rw [hβ', RingEquiv.apply_symm_apply]
      exact e.apply_symm_apply x
    · rintro ⟨b, rfl⟩
      rw [hβ', hα']
      have h1 : (f.app U).hom.IsIntegralElem (eN b).1 := (eN b).2
      exact h1.map e.toRingHom

  haveI : IsIntegrallyClosed Γ(S, U) := _hA U hU hUne
  haveI : IsFractionRing Γ(S, U) S.functionField :=
    functionField_isFractionRing_of_isAffineOpen S U hU
  have hk : U ≤ _sk ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  letI : Algebra k Γ(S, U) := ((Scheme.ΓSpecIso (.of k)).inv ≫ _sk.appLE ⊤ U hk).hom.toAlgebra
  letI : Algebra Γ(S, U) M :=
    ((algebraMap S.functionField M).comp (algebraMap Γ(S, U) S.functionField)).toAlgebra
  haveI : IsScalarTower Γ(S, U) S.functionField M :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI : Algebra Γ(S, U) Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) :=
    (f.fromNormalization.app U).hom.toAlgebra
  letI : Algebra Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) M :=
    ((f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ h₂ ≫
      (Scheme.ΓSpecIso (.of M)).hom).hom : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) →+* M).toAlgebra
  have hstar : f.fromNormalization.app U ≫ f.toNormalization.appLE (f.fromNormalization ⁻¹ᵁ U)
      ⊤ h₂ ≫ (Scheme.ΓSpecIso (.of M)).hom = f.appLE U ⊤ h₁ ≫ (Scheme.ΓSpecIso (.of M)).hom := by
    rw [← Category.assoc, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    exact congrArg (· ≫ (Scheme.ΓSpecIso (.of M)).hom)
      (T_cong _ _ (Scheme.Hom.toNormalization_fromNormalization f) U ⊤ _ h₁)
  have hαeq : (f.appLE U ⊤ h₁ ≫ (Scheme.ΓSpecIso (.of M)).hom).hom =
      algebraMap Γ(S, U) M := by
    rw [hα]; rfl
  haveI : IsScalarTower Γ(S, U) Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) M :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      rw [← hαeq, ← hstar]
      rfl)
  haveI : IsIntegralClosure Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) Γ(S, U) M :=
    IsIntegralClosure.mk hinj (fun {x} => by
      show (algebraMap Γ(S, U) M).IsIntegralElem x ↔ _
      rw [← hαeq]
      exact hint x)

  let φ₁ : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) →+* Ω :=
    (z₁.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ hz₁ ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom
  let φ₂ : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) →+* Ω :=
    (z₂.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ hz₂ ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom
  have hpre : ∀ (z : Spec (.of Ω) ⟶ f.normalization)
      (hz : ⊤ ≤ z ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U)),
      ⊤ ≤ (z ≫ f.fromNormalization) ⁻¹ᵁ U := fun z hz => by
    rw [Scheme.Hom.comp_preimage]; exact hz
  have hcomp : ∀ (z : Spec (.of Ω) ⟶ f.normalization)
      (hz : ⊤ ≤ z ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U)),
      f.fromNormalization.app U ≫ z.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ hz =
        (z ≫ f.fromNormalization).appLE U ⊤ (hpre z hz) := fun z hz => by
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
  have hφ : φ₁.comp (algebraMap Γ(S, U) Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U)) =
      φ₂.comp (algebraMap Γ(S, U) Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U)) := by
    ext x
    have := congrArg (fun g => (g ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom x)
      ((hcomp z₁ hz₁).trans ((T_cong _ _ h U ⊤ (hpre z₁ hz₁) (hpre z₂ hz₂)).trans
        (hcomp z₂ hz₂).symm))
    exact this

  obtain ⟨σ, hσ⟩ := _hL3 k Γ(S, U) S.functionField M Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U)
    Ω φ₁ φ₂ hφ

  have h₀ : f.fromNormalization ⁻¹ᵁ U ≤ act σ ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ U) := by
    rw [← Scheme.Hom.comp_preimage, _hact₂]
  have hLd := T_Ld (.of M) f.normalization f.toNormalization (act σ)
    (CommRingCat.ofHom (σ : M →+* M)) (_hact₁ σ) _ h₀ h₂
  have hfin : (act σ).appLE _ _ h₀ ≫ z₁.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ hz₁ ≫
      (Scheme.ΓSpecIso (.of Ω)).hom =
      z₂.appLE (f.fromNormalization ⁻¹ᵁ U) ⊤ hz₂ ≫ (Scheme.ΓSpecIso (.of Ω)).hom := by
    ext b
    exact hσ b _ (congrArg (fun g => g.hom b) hLd)
  rw [← Category.assoc, Scheme.Hom.appLE_comp_appLE, Iso.cancel_iso_hom_right] at hfin
  exact ⟨σ, T_La _ _ _ hV _ _ _ hz₂ hfin⟩

theorem wc_fsus_galois_cover : ∀ {S Z : Scheme.{u}} [AlgebraicGeometry.IsIntegral S]
    [QuasiSeparatedSpace S] (g : Z ⟶ S) [IsFinite g] (M : Type u) [Field M]
    [Algebra S.functionField M] [FiniteDimensional S.functionField M] [Normal S.functionField M]
    (e : Spec (.of M) ⟶ Z)
    (_he : e ≫ g = Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫
      S.fromSpecStalk (genericPoint S))
    (_H : ∀ (f : Spec (.of M) ⟶ S) [QuasiCompact f] [QuasiSeparated f],
      f = Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫
        S.fromSpecStalk (genericPoint S) →
      ∀ (act : (M ≃ₐ[S.functionField] M) → (f.normalization ⟶ f.normalization)),
        (∀ σ, f.toNormalization ≫ act σ =
          Spec.map (CommRingCat.ofHom (σ : M →+* M)) ≫ f.toNormalization) →
        (∀ σ, act σ ≫ f.fromNormalization = f.fromNormalization) →
        ∀ (Ω : Type u) [Field Ω] (z₁ z₂ : Spec (.of Ω) ⟶ f.normalization),
          z₁ ≫ f.fromNormalization = z₂ ≫ f.fromNormalization → ∃ σ, z₁ ≫ act σ = z₂),
    ∃ (Zt : Scheme.{u}) (πt : Zt ⟶ S) (q : Zt ⟶ Z) (G : Type u) (_ : Group G) (_ : Fintype G)
      (act : G → (Zt ⟶ Zt)),
      q ≫ g = πt ∧ UniversallyClosed πt ∧ Surjective πt ∧ (∀ σ, act σ ≫ πt = πt) ∧
      (∀ σ τ, act σ ≫ act τ = act (σ * τ)) ∧
      ∀ (Ω : Type u) [Field Ω] (z₁ z₂ : Spec (.of Ω) ⟶ Zt),
        z₁ ≫ πt = z₂ ≫ πt → ∃ σ, z₁ ≫ act σ = z₂ :=
by
  intro S Z _ _ g _ M _ _ _ _ e he H
  have hs : ∀ σ : M ≃ₐ[S.functionField] M,
      Spec.map (CommRingCat.ofHom (σ : M →+* M)) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫
          S.fromSpecStalk (genericPoint S)) =
        Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫
          S.fromSpecStalk (genericPoint S) := by
    intro σ
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 3
    ext x
    exact σ.commutes x
  have hmul : ∀ σ τ : M ≃ₐ[S.functionField] M,
      Spec.map (CommRingCat.ofHom (σ : M →+* M)) ≫ Spec.map (CommRingCat.ofHom (τ : M →+* M)) =
      Spec.map (CommRingCat.ofHom ((σ * τ : M ≃ₐ[S.functionField] M) : M →+* M)) := by
    intro σ τ
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  generalize hf : Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫
      S.fromSpecStalk (genericPoint S) = f at he hs
  have : QuasiCompact f := by subst hf; infer_instance
  have : QuasiSeparated f := by subst hf; infer_instance
  let act : (M ≃ₐ[S.functionField] M) → (f.normalization ⟶ f.normalization) := fun σ =>
    f.normalizationDesc (Spec.map (CommRingCat.ofHom (σ : M →+* M)) ≫ f.toNormalization)
      f.fromNormalization
      (by rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, hs])
  have h₁ : ∀ σ, f.toNormalization ≫ act σ =
      Spec.map (CommRingCat.ofHom (σ : M →+* M)) ≫ f.toNormalization := fun σ =>
    Scheme.Hom.toNormalization_normalizationDesc _ _ _ _
  have h₂ : ∀ σ, act σ ≫ f.fromNormalization = f.fromNormalization := fun σ =>
    Scheme.Hom.normalizationDesc_comp _ _ _ _
  have h₃ : ∀ σ τ, act σ ≫ act τ = act (σ * τ) := by
    intro σ τ
    apply Scheme.Hom.normalization.hom_ext f _ _ f.fromNormalization
    · rw [reassoc_of% (h₁ σ), h₁ τ, h₁ (σ * τ), ← Category.assoc, hmul]
    · rw [Category.assoc, h₂, h₂]
    · exact h₂ _
  have hsurj : Surjective f.fromNormalization := by
    constructor
    have hcl : IsClosed (Set.range f.fromNormalization) :=
      f.fromNormalization.isClosedMap.isClosed_range
    obtain ⟨pt⟩ : Nonempty (Spec (.of M)) := inferInstance
    have hy : f.fromNormalization (f.toNormalization pt) ⤳ genericPoint S := by
      have e1 : f.fromNormalization (f.toNormalization pt) = f pt := by
        rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
      rw [e1, ← hf, Scheme.Hom.comp_apply]
      have hmem : S.fromSpecStalk (genericPoint S)
          (Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) pt) ∈
          Set.range (S.fromSpecStalk (genericPoint S)) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hmem
      exact hmem
    have hη : genericPoint S ∈ Set.range f.fromNormalization := hy.mem_closed hcl ⟨_, rfl⟩
    have hsub := ((genericPoint_spec S).mem_closed_set_iff hcl).mp hη
    exact Set.range_eq_univ.mp (Set.eq_univ_of_univ_subset hsub)
  refine ⟨f.normalization, f.fromNormalization, f.normalizationDesc e g he.symm,
    M ≃ₐ[S.functionField] M, inferInstance, AlgEquiv.fintype _ _, act,
    Scheme.Hom.normalizationDesc_comp _ _ _ _, inferInstance, hsurj, h₂, h₃, ?_⟩
  intro Ω _ z₁ z₂ h
  exact H f hf.symm act h₁ h₂ Ω z₁ z₂ h

theorem wc_fsus_point_transitive : ∀ {S Zt : Scheme.{u}} (πt : Zt ⟶ S) (G : Type u)
    (act : G → (Zt ⟶ Zt)) (hact : ∀ σ, act σ ≫ πt = πt)
    (_htr : ∀ (Ω : Type u) [Field Ω] (z₁ z₂ : Spec (.of Ω) ⟶ Zt),
      z₁ ≫ πt = z₂ ≫ πt → ∃ σ, z₁ ≫ act σ = z₂)
    {T : Scheme.{u}} (v : T ⟶ S) (w₁ w₂ : ↥(Limits.pullback v πt)),
    Limits.pullback.fst v πt w₁ = Limits.pullback.fst v πt w₂ →
    ∃ σ : G, (Limits.pullback.lift (Limits.pullback.fst v πt) (Limits.pullback.snd v πt ≫ act σ)
      (by rw [Category.assoc, hact σ, Limits.pullback.condition])) w₁ = w₂ :=
by
  intro S Zt πt G act hact _htr T v w₁ w₂ h
  classical
  let e₁ := (Limits.pullback v πt).fromSpecResidueField w₁
  let e₂ := (Limits.pullback v πt).fromSpecResidueField w₂
  let f₁ := e₁ ≫ Limits.pullback.fst v πt
  let f₂ := e₂ ≫ Limits.pullback.fst v πt
  obtain ⟨s₁⟩ : Nonempty (Spec ((Limits.pullback v πt).residueField w₁)) := inferInstance
  obtain ⟨s₂⟩ : Nonempty (Spec ((Limits.pullback v πt).residueField w₂)) := inferInstance
  have hf : f₁ s₁ = f₂ s₂ := by
    simp only [f₁, f₂, e₁, e₂, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply, h]
  obtain ⟨q, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f₁) (g := f₂) s₁ s₂ hf
  let c := (Limits.pullback f₁ f₂).fromSpecResidueField q
  let a₁ := c ≫ Limits.pullback.fst f₁ f₂ ≫ e₁
  let a₂ := c ≫ Limits.pullback.snd f₁ f₂ ≫ e₂
  have hcond : Limits.pullback.fst f₁ f₂ ≫ e₁ ≫ Limits.pullback.fst v πt =
      Limits.pullback.snd f₁ f₂ ≫ e₂ ≫ Limits.pullback.fst v πt := Limits.pullback.condition
  have h1 : a₁ ≫ Limits.pullback.fst v πt = a₂ ≫ Limits.pullback.fst v πt := by
    simp only [a₁, a₂, Category.assoc, hcond]
  obtain ⟨o⟩ : Nonempty (Spec ((Limits.pullback f₁ f₂).residueField q)) := inferInstance
  have ha₁ : a₁ o = w₁ := by
    simp only [a₁, e₁, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  have ha₂ : a₂ o = w₂ := by
    simp only [a₂, e₂, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  have hz : (a₁ ≫ Limits.pullback.snd v πt) ≫ πt = (a₂ ≫ Limits.pullback.snd v πt) ≫ πt := by
    have := congrArg (· ≫ v) h1
    simpa only [Category.assoc, Limits.pullback.condition] using this
  obtain ⟨σ, hσ⟩ := _htr ((Limits.pullback f₁ f₂).residueField q) _ _ hz
  refine ⟨σ, ?_⟩
  have key : a₁ ≫ Limits.pullback.lift (Limits.pullback.fst v πt)
      (Limits.pullback.snd v πt ≫ act σ)
      (by rw [Category.assoc, hact σ, Limits.pullback.condition]) = a₂ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, h1]
    · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc, hσ]
  calc _ = (a₁ ≫ Limits.pullback.lift (Limits.pullback.fst v πt)
        (Limits.pullback.snd v πt ≫ act σ)
        (by rw [Category.assoc, hact σ, Limits.pullback.condition])) o := by
          rw [Scheme.Hom.comp_apply, ha₁]
    _ = a₂ o := by rw [key]
    _ = w₂ := ha₂

theorem wc_fsus_galois_average : ∀ {S Z Zt : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (g : Z ⟶ S)
    (πt : Zt ⟶ S) (q : Zt ⟶ Z) (_hq : q ≫ g = πt) [UniversallyClosed πt] [Surjective πt]
    (G : Type u) [Group G] [Fintype G] (act : G → (Zt ⟶ Zt)) (hact : ∀ σ, act σ ≫ πt = πt)
    (_hmul : ∀ σ τ, act σ ≫ act τ = act (σ * τ))
    (_htr : ∀ {T : Scheme.{u}} (v : T ⟶ S) (w₁ w₂ : ↥(Limits.pullback v πt)),
      Limits.pullback.fst v πt w₁ = Limits.pullback.fst v πt w₂ →
      ∃ σ : G, (Limits.pullback.lift (Limits.pullback.fst v πt)
        (Limits.pullback.snd v πt ≫ act σ)
        (by rw [Category.assoc, hact σ, Limits.pullback.condition])) w₁ = w₂),
    ∃ T : ∀ (V : Scheme.{u}) (v : V ⟶ S), C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ]) →
        C(↥V, ULift.{u+1} ℚ_[ℓ]),
      (∀ (V : Scheme.{u}) (v : V ⟶ S) (f h : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ])),
        T V v (f + h) = T V v f + T V v h) ∧
      (∀ (V : Scheme.{u}) (v : V ⟶ S) (s : C(↥V, ULift.{u+1} ℚ_[ℓ]))
        (f : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ])),
        T V v ((s.comp (Limits.pullback.fst v g).base.hom) * f) = s * T V v f) ∧
      (∀ (V V' : Scheme.{u}) (v : V ⟶ S) (v' : V' ⟶ S) (e : V' ⟶ V), e ≫ v = v' →
        ∀ (β : Limits.pullback v' g ⟶ Limits.pullback v g),
          β ≫ Limits.pullback.fst v g = Limits.pullback.fst v' g ≫ e →
          β ≫ Limits.pullback.snd v g = Limits.pullback.snd v' g →
          ∀ f : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ]),
            T V' v' (f.comp β.base.hom) = (T V v f).comp e.base.hom) ∧
      (∀ (V : Scheme.{u}) (v : V ⟶ S) (s : C(↥V, ULift.{u+1} ℚ_[ℓ])),
        T V v (s.comp (Limits.pullback.fst v g).base.hom) = s) :=
by
  intro S Z Zt ℓ _ g πt q hq _ _ G _ _ act hact hmul htr
  classical

  have hquot : ∀ {T : Scheme.{u}} (v : T ⟶ S),
      Topology.IsQuotientMap (Limits.pullback.fst v πt).base.hom := by
    intro T v
    haveI : UniversallyClosed (Limits.pullback.fst v πt) :=
      MorphismProperty.of_isPullback (P := @UniversallyClosed)
        (IsPullback.of_hasPullback v πt).flip inferInstance
    haveI : Surjective (Limits.pullback.fst v πt) :=
      MorphismProperty.of_isPullback (P := @Surjective)
        (IsPullback.of_hasPullback v πt).flip inferInstance
    exact IsClosedMap.isQuotientMap (Limits.pullback.fst v πt).isClosedMap
      (Limits.pullback.fst v πt).continuous (Limits.pullback.fst v πt).surjective
  have hsurj : ∀ (V : Scheme.{u}) (v : V ⟶ S),
      Function.Surjective (Limits.pullback.fst v πt).base.hom := fun V v => (hquot v).surjective

  obtain ⟨b, hb1₀, hb2₀⟩ : ∃ b : ∀ (V : Scheme.{u}) (v : V ⟶ S) (_σ : G),
      Limits.pullback v πt ⟶ Limits.pullback v g,
      (∀ (V : Scheme.{u}) (v : V ⟶ S) (σ : G),
        b V v σ ≫ Limits.pullback.fst v g = Limits.pullback.fst v πt) ∧
      (∀ (V : Scheme.{u}) (v : V ⟶ S) (σ : G),
        b V v σ ≫ Limits.pullback.snd v g = Limits.pullback.snd v πt ≫ act σ ≫ q) :=
    ⟨fun V v σ => Limits.pullback.lift (Limits.pullback.fst v πt)
      (Limits.pullback.snd v πt ≫ act σ ≫ q)
      (by rw [Limits.pullback.condition]; simp only [Category.assoc, hq, hact]),
      fun V v σ => Limits.pullback.lift_fst _ _ _, fun V v σ => Limits.pullback.lift_snd _ _ _⟩
  have hfst : ∀ (V : Scheme.{u}) (v : V ⟶ S) (σ : G) (x : ↥(Limits.pullback v πt)),
      (Limits.pullback.fst v g).base.hom ((b V v σ).base.hom x) =
        (Limits.pullback.fst v πt).base.hom x :=
    fun V v σ x => congrArg (fun h => h.base.hom x) (hb1₀ V v σ)
  set c : ULift.{u+1} ℚ_[ℓ] := ULift.up ((Fintype.card G : ℚ_[ℓ])⁻¹) with hc

  have key : ∀ (V : Scheme.{u}) (v : V ⟶ S), ∃ A : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ]) →
      C(↥V, ULift.{u+1} ℚ_[ℓ]),
      ∀ (f : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ])) (x : ↥(Limits.pullback v πt)),
        A f ((Limits.pullback.fst v πt).base.hom x) = c * ∑ σ : G, f ((b V v σ).base.hom x) := by
    intro V v
    obtain ⟨Ff, hev⟩ : ∃ Ff : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ]) →
        C(↥(Limits.pullback v πt), ULift.{u+1} ℚ_[ℓ]),
        ∀ (f : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ])) (z : ↥(Limits.pullback v πt)),
          Ff f z = c * ∑ σ : G, f ((b V v σ).base.hom z) :=
      ⟨fun f => ContinuousMap.const (↥(Limits.pullback v πt)) c *
          ∑ σ : G, f.comp (b V v σ).base.hom, fun f z => by
        simp only [ContinuousMap.mul_apply, ContinuousMap.const_apply, ContinuousMap.sum_apply,
          ContinuousMap.comp_apply]⟩
    have hfac : ∀ f : C(↥(Limits.pullback v g), ULift.{u+1} ℚ_[ℓ]),
        Function.FactorsThrough (⇑(Ff f)) ⇑(Limits.pullback.fst v πt).base.hom := by
      intro f x y hxy
      rw [hev, hev]
      obtain ⟨τ, hτ⟩ := htr v x y hxy
      have hm : ∀ σ : G, Limits.pullback.lift (Limits.pullback.fst v πt)
          (Limits.pullback.snd v πt ≫ act τ)
          (by rw [Category.assoc, hact τ, Limits.pullback.condition]) ≫ b V v σ =
            b V v (τ * σ) := by
        intro σ
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hb1₀, hb1₀, Limits.pullback.lift_fst]
        · rw [Category.assoc, hb2₀, hb2₀, Limits.pullback.lift_snd_assoc, ← hmul τ σ]
          simp only [Category.assoc]
      subst hτ
      have hpt : ∀ σ : G, (b V v σ).base.hom ((Limits.pullback.lift (Limits.pullback.fst v πt)
          (Limits.pullback.snd v πt ≫ act τ)
          (by rw [Category.assoc, hact τ, Limits.pullback.condition])) x) =
            (b V v (τ * σ)).base.hom x :=
        fun σ => congrArg (fun h => h.base.hom x) (hm σ)
      congr 1
      exact (Fintype.sum_equiv (Equiv.mulLeft τ) _ (fun σ => f ((b V v σ).base.hom x))
        (fun σ => by rw [hpt σ]; rfl)).symm
    refine ⟨fun f => (hquot v).lift (Ff f) (hfac f), fun f x => ?_⟩
    have h1 := congrArg (fun h : C(↥(Limits.pullback v πt), ULift.{u+1} ℚ_[ℓ]) => h x)
      ((hquot v).lift_comp (Ff f) (hfac f))
    exact h1.trans (hev f x)
  choose A hA using key
  refine ⟨A, ?_, ?_, ?_, ?_⟩
  ·
    intro V v f h
    refine ContinuousMap.ext fun y => ?_
    obtain ⟨x, rfl⟩ := hsurj V v y
    rw [ContinuousMap.add_apply, hA, hA, hA]
    simp only [ContinuousMap.add_apply, Finset.sum_add_distrib, mul_add]
  ·
    intro V v s f
    refine ContinuousMap.ext fun y => ?_
    obtain ⟨x, rfl⟩ := hsurj V v y
    rw [ContinuousMap.mul_apply, hA, hA]
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, hfst]
    rw [← Finset.mul_sum]
    ring
  ·
    intro V V' v v' e he β hβ1 hβ2 f
    refine ContinuousMap.ext fun y => ?_
    obtain ⟨x, rfl⟩ := hsurj V' v' y
    obtain ⟨γ, hγf, hγs⟩ : ∃ γ : Limits.pullback v' πt ⟶ Limits.pullback v πt,
        γ ≫ Limits.pullback.fst v πt = Limits.pullback.fst v' πt ≫ e ∧
          γ ≫ Limits.pullback.snd v πt = Limits.pullback.snd v' πt :=
      ⟨Limits.pullback.lift (Limits.pullback.fst v' πt ≫ e) (Limits.pullback.snd v' πt)
        (by rw [Category.assoc, he, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hγ1 : (Limits.pullback.fst v πt).base.hom (γ.base.hom x) =
        e.base.hom ((Limits.pullback.fst v' πt).base.hom x) :=
      congrArg (fun h => h.base.hom x) hγf
    have hγ2 : ∀ σ : G, β.base.hom ((b V' v' σ).base.hom x) =
        (b V v σ).base.hom (γ.base.hom x) := by
      intro σ
      have hm : b V' v' σ ≫ β = γ ≫ b V v σ := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Category.assoc, hβ1, hb1₀, ← Category.assoc, hb1₀, hγf]
        · rw [Category.assoc, Category.assoc, hβ2, hb2₀, hb2₀]
          simp only [← Category.assoc, hγs]
      exact congrArg (fun h => h.base.hom x) hm
    rw [ContinuousMap.comp_apply, ← hγ1, hA, hA]
    simp only [ContinuousMap.comp_apply, hγ2]
  ·
    intro V v s
    refine ContinuousMap.ext fun y => ?_
    obtain ⟨x, rfl⟩ := hsurj V v y
    rw [hA]
    simp only [ContinuousMap.comp_apply, hfst]
    rw [Finset.sum_const, Finset.card_univ]
    have hG : (Fintype.card G : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    apply ULift.ext
    rw [nsmul_eq_mul, ULift.mul_down, ULift.mul_down, ULift.down_natCast, hc]
    exact inv_mul_cancel_left₀ hG _

theorem wc_fsus_xbar_integral_normal : ∀ (_hSN : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [IsNoetherianRing A]
        (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [Smooth f] (x : X),
        IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x))
      (F' : Type u) [Field F'] [Finite F'] (X' : Over (Spec (.of F')))
      [GeometricallyIrreducible X'.hom] [IsProper X'.hom] (d : ℕ)
      [SmoothOfRelativeDimension d X'.hom],
      AlgebraicGeometry.IsIntegral (Limits.pullback X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) ∧
      (∀ x : ↥(Limits.pullback X'.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))),
        IsIntegrallyClosed ((Limits.pullback X'.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).presheaf.stalk x)) ∧
      QuasiSeparatedSpace ↥(Limits.pullback X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
by
  intro _hSN F' _ _ X' _ _ d _
  have hP := IsPullback.of_hasPullback X'.hom
    (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
  haveI hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d) hP
      ‹SmoothOfRelativeDimension d X'.hom›
  haveI : Smooth (Limits.pullback.snd X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    SmoothOfRelativeDimension.smooth d _
  have hst := fun x => _hSN (AlgebraicClosure F') _ (Limits.pullback.snd X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) x
  haveI : ∀ x : ↥(Limits.pullback X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))),
      _root_.IsReduced ((Limits.pullback X'.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).presheaf.stalk x) :=
    fun x => by haveI := (hst x).1; infer_instance
  haveI : AlgebraicGeometry.IsReduced (Limits.pullback X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    isReduced_of_isReduced_stalk _
  haveI : IrreducibleSpace ↥(Limits.pullback X'.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X'.hom) _ _ _ hP
  refine ⟨isIntegral_of_irreducibleSpace_of_isReduced _, fun x => (hst x).2, inferInstance⟩

theorem wc_fsus_normal_closure_point : ∀ {S Z : Scheme.{u}} [AlgebraicGeometry.IsIntegral S]
    [AlgebraicGeometry.IsIntegral Z] (g : Z ⟶ S) [IsFinite g] (_hg : Surjective g),
    ∃ (M : Type u) (_ : Field M) (_ : Algebra S.functionField M)
      (_ : FiniteDimensional S.functionField M) (_ : Normal S.functionField M)
      (e : Spec (.of M) ⟶ Z),
      e ≫ g = Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫
        S.fromSpecStalk (genericPoint S) :=
by
  intro S Z _ _ g _ hg

  have hgen : g (genericPoint Z) ⤳ genericPoint S := by
    rw [specializes_iff_mem_closure]
    obtain ⟨z, hz⟩ := hg.surj (genericPoint S)
    have hz' : z ∈ closure ({genericPoint Z} : Set Z) := by
      rw [genericPoint_closure]; exact Set.mem_univ _
    have h1 := image_closure_subset_closure_image g.continuous ⟨z, hz', rfl⟩
    rw [Set.image_singleton] at h1
    rw [← hz]
    exact h1
  letI : Algebra S.functionField Z.functionField :=
    (S.presheaf.stalkSpecializes hgen ≫ g.stalkMap (genericPoint Z)).hom.toAlgebra

  have hfd : FiniteDimensional S.functionField Z.functionField := by
    have s2 : ∀ (A B K L : Type u) [CommRing A] [CommRing B] [Field K] [Field L] [Algebra B L]
        [IsFractionRing B L] [Algebra K L] (φ : A →+* B) (ψ : A →+* K), φ.Finite →
        (∀ a : A, algebraMap B L (φ a) = algebraMap K L (ψ a)) → FiniteDimensional K L := by
      intro A B K L _ _ _ _ _ _ _ φ ψ hφ hc
      letI : Algebra A B := φ.toAlgebra
      haveI : Module.Finite A B := hφ
      obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := A) (M := B)
      have hint : ∀ i, IsIntegral K (algebraMap B L (b i)) := by
        intro i
        have h1 : IsIntegral A (b i) := IsIntegral.of_finite A (b i)
        exact IsIntegral.map_of_comp_eq ψ (algebraMap B L) (RingHom.ext fun a => (hc a).symm) h1
      set R : Subalgebra K L := Algebra.adjoin K (Set.range (fun i => algebraMap B L (b i))) with hR
      have hRfin : Module.Finite K R := by
        apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _)
        rintro _ ⟨i, rfl⟩
        exact hint i
      have hB : ∀ x : B, algebraMap B L x ∈ R := by
        intro x
        have hx : x ∈ Submodule.span A (Set.range b) := by rw [hb]; trivial
        obtain ⟨c, hc'⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hx
        rw [← hc', map_sum]
        refine Subalgebra.sum_mem _ fun i _ => ?_
        rw [Algebra.smul_def, map_mul]
        have e : algebraMap B L (algebraMap A B (c i)) = algebraMap K L (ψ (c i)) := hc (c i)
        rw [e]
        exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
          (Algebra.subset_adjoin ⟨i, rfl⟩)
      have hinv : ∀ z ∈ R, z⁻¹ ∈ R := by
        intro z hz
        have hfg : (Subalgebra.toSubmodule R).FG := Module.Finite.iff_fg.mp hRfin
        have hzi : IsIntegral K z := IsIntegral.of_mem_of_fg R hfg z hz
        exact hzi.inv_mem hz
      have htop : ∀ z : L, z ∈ R := by
        intro z
        obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := B) z
        rw [div_eq_mul_inv]
        exact R.mul_mem (hB x) (hinv _ (hB y))
      exact Module.Finite.of_surjective R.val.toLinearMap (fun z => ⟨⟨z, htop z⟩, rfl⟩)
    obtain ⟨U₀, hU₀, hS, -⟩ := exists_isAffineOpen_mem_and_subset (x := genericPoint S)
      (U := ⊤) (TopologicalSpace.Opens.mem_top _)
    have hT : genericPoint Z ∈ g ⁻¹ᵁ U₀ := hgen.mem_open U₀.isOpen hS
    haveI : Nonempty U₀ := ⟨⟨_, hS⟩⟩
    haveI : Nonempty (g ⁻¹ᵁ U₀) := ⟨⟨_, hT⟩⟩
    haveI : IsFinite (g ∣_ U₀) := inferInstance
    haveI : IsAffine (U₀ : Scheme) := hU₀
    have hAff : IsAffineOpen (g ⁻¹ᵁ U₀) := isAffine_of_isAffineHom (g ∣_ U₀)
    have hφ : (g.app U₀).hom.Finite := by
      have h1 : ((g ∣_ U₀).app ⊤).hom.Finite :=
        IsFinite.finite_app (g ∣_ U₀) ⊤ (isAffineOpen_top _)
      rw [morphismRestrict_app] at h1
      have gen : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (f : R₁ ⟶ R₂) (e : R₂ ⟶ R₃) [IsIso e],
          (f ≫ e).hom.Finite → f.hom.Finite := by
        intro R₁ R₂ R₃ f e _ h
        have h2 : (inv e).hom.Finite :=
          RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (inv e)).2
        have e1 : f = (f ≫ e) ≫ inv e := by simp
        rw [e1, CommRingCat.hom_comp]
        exact RingHom.Finite.comp h2 h
      have h2 := @gen _ _ _ _ _ (Functor.map_isIso _ _) h1
      have h3 : ∀ V : S.Opens, (g.app V).hom.Finite → V = U₀ → (g.app U₀).hom.Finite := by
        rintro V h rfl
        exact h
      exact h3 _ h2 (Scheme.Opens.ι_image_top U₀)
    haveI := functionField_isFractionRing_of_isAffineOpen Z (g ⁻¹ᵁ U₀) hAff
    have hcomp : ∀ a : Γ(S, U₀), algebraMap Γ(Z, g ⁻¹ᵁ U₀) Z.functionField ((g.app U₀).hom a) =
        algebraMap S.functionField Z.functionField (algebraMap Γ(S, U₀) S.functionField a) := by
      intro a
      have e : S.presheaf.germ U₀ (genericPoint S) hS ≫ S.presheaf.stalkSpecializes hgen ≫
          g.stalkMap (genericPoint Z) = g.app U₀ ≫ Z.presheaf.germ (g ⁻¹ᵁ U₀) (genericPoint Z) hT := by
        rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap]
      exact (congrArg (fun φ => φ.hom a) e).symm
    exact s2 Γ(S, U₀) Γ(Z, g ⁻¹ᵁ U₀) S.functionField Z.functionField (g.app U₀).hom
      (algebraMap Γ(S, U₀) S.functionField) hφ hcomp

  haveI : Normal S.functionField (AlgebraicClosure S.functionField) :=
    IsAlgClosure.normal S.functionField (AlgebraicClosure S.functionField)
  let ι : Z.functionField →ₐ[S.functionField] AlgebraicClosure S.functionField := IsAlgClosed.lift
  let N := IntermediateField.normalClosure S.functionField Z.functionField
    (AlgebraicClosure S.functionField)
  have hmem : ∀ x, ι x ∈ N := fun x =>
    AlgHom.fieldRange_le_normalClosure ι (AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩)
  let ψ : Z.functionField →+* N :=
    { toFun := fun x => ⟨ι x, hmem x⟩
      map_one' := Subtype.ext (map_one ι)
      map_mul' := fun x y => Subtype.ext (map_mul ι x y)
      map_zero' := Subtype.ext (map_zero ι)
      map_add' := fun x y => Subtype.ext (map_add ι x y) }
  have hψ : ∀ a, ψ (algebraMap S.functionField Z.functionField a) = algebraMap S.functionField N a :=
    fun a => Subtype.ext (ι.commutes a)

  let ψc : Z.functionField ⟶ CommRingCat.of N := CommRingCat.ofHom ψ
  refine ⟨N, inferInstance, inferInstance, inferInstance, inferInstance,
    Spec.map ψc ≫ Z.fromSpecStalk (genericPoint Z), ?_⟩
  have hφ : (S.presheaf.stalkSpecializes hgen ≫ g.stalkMap (genericPoint Z)) ≫ ψc
      = CommRingCat.ofHom (algebraMap S.functionField N) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    exact hψ a
  have hsp : Spec.map ((S.presheaf.stalkSpecializes hgen ≫ g.stalkMap (genericPoint Z)) ≫ ψc) =
      Spec.map ψc ≫ Spec.map (g.stalkMap (genericPoint Z)) ≫
        Spec.map (S.presheaf.stalkSpecializes hgen) := by
    rw [Spec.map_comp, Spec.map_comp]
  rw [Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
    ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgen, ← hφ, hsp]
  simp only [Category.assoc]

theorem wc_finite_surj_unit_split (F' : Type u) [Field F'] [Finite F']
    (X' : Over (Spec (.of F')))
    [GeometricallyIrreducible X'.hom] [IsProper X'.hom] (d : ℕ) [SmoothOfRelativeDimension d X'.hom]
    (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (g : Z ⟶ wcXbar F' X') [IsFinite g]
    (hg : Surjective g)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg) :
    ∃ r : wcSuppObj Dg ⟶ SheafOfModules.unit (wcRingSheaf (wcXbar F' X') ℓ),
      wcSuppUnitMap Dg ≫ r = 𝟙 _ :=
by
  classical

  obtain ⟨hSi, hSn, hSq⟩ := wc_fsus_xbar_integral_normal wc_fntame_smooth_stalk_normal F' X' d
  haveI := hSi
  haveI := hSq

  have hA := wc_fsus_affine_sections_intclosed (wcXbar F' X') hSn

  obtain ⟨M, _, _, _, _, e, he⟩ := wc_fsus_normal_closure_point g hg

  have hL3 := wc_fsus_intclosure_geom_transitive wc_fsus_alg_geom_transitive wc_fsus_fixed_pow_mem

  obtain ⟨Zt, πt, q, G, _, _, act, hq, hUC, hS, hact, hmul, htr⟩ :=
    wc_fsus_galois_cover g M e he (by
      intro f _ _ hf act' h₁ h₂ Ω _ z₁ z₂ h
      exact wc_fsus_normalization_geom_transitive hL3 (AlgebraicClosure F') (wcXbar F' X')
        (wcPi2 F' X') hA M f hf act' h₁ h₂ Ω z₁ z₂ h)
  haveI := hUC
  haveI := hS

  obtain ⟨T, hTa, hTl, hTn, hT1⟩ := wc_fsus_galois_average ℓ g πt q hq G act hact hmul
    (fun v w₁ w₂ h => wc_fsus_point_transitive πt G act hact htr v w₁ w₂ h)

  obtain ⟨u, hu, hσ⟩ := wc_supp_unit_section Dg hDg
  obtain ⟨w, hw⟩ : ∃ w : C(↥Z, ULift.{u+1} ℚ_[ℓ]), ∀ x, u x * w x = 1 :=
    ⟨_, fun x => DFunLike.congr_fun hu.mul_val_inv x⟩

  obtain ⟨T', hT'⟩ : ∃ T' : ∀ V : (wcXbar F' X').ProEt,
      C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ]) → C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
      ∀ V f, T' V f = T V.left V.hom (f * w.comp (Limits.pullback.snd V.hom g).base.hom) :=
    ⟨_, fun _ _ => rfl⟩
  have hadd : ∀ (V : (wcXbar F' X').ProEt) (f h : C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])),
      T' V (f + h) = T' V f + T' V h := by
    intro V f h
    rw [hT', hT', hT', add_mul, hTa]
  have hlin : ∀ (V : (wcXbar F' X').ProEt) (s : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
      (f : C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])),
      T' V ((s.comp (Limits.pullback.fst V.hom g).base.hom) * f) = s * T' V f := by
    intro V s f
    rw [hT', hT', mul_assoc, hTl]
  have hnat : ∀ {W V : (wcXbar F' X').ProEt} (e : W ⟶ V)
      (f : C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])),
      T' W (f.comp ((wcProEtBC g).map e).left.base.hom) = (T' V f).comp e.left.base.hom := by
    intro W V e f
    have hβs : ((wcProEtBC g).map e).left ≫ Limits.pullback.snd V.hom g =
        Limits.pullback.snd W.hom g := Limits.pullback.lift_snd _ _ _
    have hβf : ((wcProEtBC g).map e).left ≫ Limits.pullback.fst V.hom g =
        Limits.pullback.fst W.hom g ≫ e.left := Limits.pullback.lift_fst _ _ _
    have key : ((f.comp ((wcProEtBC g).map e).left.base.hom :
          C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])) *
          w.comp (Limits.pullback.snd W.hom g).base.hom :
          C(↥(Limits.pullback W.hom g), ULift.{u+1} ℚ_[ℓ])) =
        (f * w.comp (Limits.pullback.snd V.hom g).base.hom).comp
          ((wcProEtBC g).map e).left.base.hom := by
      refine ContinuousMap.ext fun x => ?_
      have hpt : (Limits.pullback.snd V.hom g).base.hom
          (((wcProEtBC g).map e).left.base.hom x) = (Limits.pullback.snd W.hom g).base.hom x :=
        congrArg (fun h => h.base.hom x) hβs
      show f (((wcProEtBC g).map e).left.base.hom x) * w ((Limits.pullback.snd W.hom g).base.hom x) =
        f (((wcProEtBC g).map e).left.base.hom x) *
          w ((Limits.pullback.snd V.hom g).base.hom (((wcProEtBC g).map e).left.base.hom x))
      rw [hpt]
    refine (hT' W _).trans ?_
    refine (congrArg (T W.left W.hom) key).trans ?_
    refine Eq.trans ?_ (congrArg (fun t => t.comp e.left.base.hom) (hT' V f)).symm
    exact hTn V.left W.left V.hom W.hom e.left (MorphismProperty.Over.w e) _ hβf hβs _

  refine ⟨⟨PresheafOfModules.homMk
    { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (T' X.unop) (hadd X.unop))
      naturality := fun X X' e => by
        ext x
        exact hnat e.unop x } ?_⟩, ?_⟩
  · intro X r x
    have h1 := hlin X.unop r x
    rw [← hDg X.unop r] at h1
    exact h1
  · apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext X
    obtain ⟨V⟩ := X
    show T' V ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap Dg)).1 (Opposite.op V) :
        C(↥(Limits.pullback V.hom g), ULift.{u+1} ℚ_[ℓ])) = (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 : u.comp (Limits.pullback.snd V.hom g).base.hom *
          w.comp (Limits.pullback.snd V.hom g).base.hom =
        (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])).comp (Limits.pullback.fst V.hom g).base.hom := by
      refine ContinuousMap.ext fun x => ?_
      simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply, ContinuousMap.one_apply]
      exact hw _
    refine (congrArg (T' V) (hσ V)).trans ?_
    refine (hT' V _).trans ?_
    refine (congrArg (T V.left V.hom) e1).trans ?_
    exact hT1 V.left V.hom 1

theorem wc_proet_closed_push_exact : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) [IsClosedImmersion f]
    [QuasiSeparatedSpace ↥S],
    (∃ U : S.Opens, (U : Set ↥S) = (Set.range f)ᶜ ∧ IsAffineOpen U) →
    ∀ (hc : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')),
    Limits.PreservesFiniteLimits (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC f)
        AddCommGrpCat.{u+1} _ (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') hc) ∧
    Limits.PreservesFiniteColimits (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC f)
        AddCommGrpCat.{u+1} _ (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') hc) :=
by
  intro S S' f _ _ hU₀ hc
  haveI := hc
  obtain ⟨O, hO, hOaff⟩ := hU₀

  have hL : Limits.PreservesFiniteLimits ((wcProEtBC f).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')) := inferInstance
  refine ⟨hL, ?_⟩

  haveI hAdd : ((wcProEtBC f).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).Additive :=
    ⟨fun {P Q} φ ψ => by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      rw [Sheaf.Hom.add_app]
      exact Sheaf.Hom.add_app φ ψ _⟩
  haveI : ((wcProEtBC f).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_additive _

  have affine_local : ∀ (U : S.ProEt) (R : Sieve U),
      (∀ (V : S.ProEt) (e : V ⟶ U), IsAffine V.left → R.pullback e ∈ Scheme.ProEt.topology S V) →
      R ∈ Scheme.ProEt.topology S U := by
    intro U R hR
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) R ?_
    intro Y g hg
    obtain ⟨Y', h, g', hg', rfl⟩ := hg
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hR (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))

  haveI hEpi : ((wcProEtBC f).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).PreservesEpimorphisms := by
    refine ⟨fun {G H} α hα => ?_⟩
    refine (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp ⟨fun {U} y => ?_⟩
    apply affine_local U
    intro V e hV
    haveI : IsAffine V.left := hV
    haveI hVw : WeaklyEtale V.hom := V.prop

    haveI : IsAffine ((𝟭 Scheme).obj V.left) := hV
    have hBV : IsAffine ((wcProEtBC f).obj V).left :=
      (IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst V.hom f)).1
    haveI hVqc : QuasiCompact V.hom := by
      haveI : QuasiSeparatedSpace ↥((Functor.fromPUnit S).obj V.right) := ‹QuasiSeparatedSpace ↥S›
      exact quasiCompact_of_compactSpace _
    obtain ⟨V', g, x', hV', hg, hx⟩ := wc_proet_epi_affine_lift S' α hα ((wcProEtBC f).obj V) hBV
      (H.obj.map ((wcProEtBC f).map e).op y)
    obtain ⟨W, w, a, hW, haw, hcov⟩ := wc_closed_proet_cover_extension_affine f V V' g hV' hg
      wc_weaklyEtale_cover_lift_along_surjection

    have hQc : IsCompact ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set V.left) :=
      V.hom.isCompact_preimage hOaff.isCompact
    obtain ⟨s, hsfin, hQ⟩ := (TopologicalSpace.Opens.IsBasis.isCompact_open_iff_eq_finite_iUnion
      (V.left.basicOpen : Γ(V.left, ⊤) → V.left.Opens) (isBasis_basicOpen V.left)
      (fun r => isCompact_basicOpen V.left (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ) r)
      _).mp ⟨hQc, (V.hom ⁻¹ᵁ O).isOpen⟩
    obtain ⟨n, r, -, hr⟩ := hsfin.fin_param
    let Wj : Fin n → S.ProEt := fun j =>
      MorphismProperty.Over.mk ⊤ ((V.left.basicOpen (r j)).ι ≫ V.hom) inferInstance
    let ej : ∀ j, Wj j ⟶ V := fun j =>
      MorphismProperty.Over.homMk (V.left.basicOpen (r j)).ι rfl trivial
    have hsub : ∀ j (t : V.left), t ∈ V.left.basicOpen (r j) → V.hom t ∈ (O : Set S) := by
      intro j t ht
      have hmem : t ∈ ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set V.left) := by
        rw [hQ]
        exact Set.mem_biUnion (by rw [← hr]; exact Set.mem_range_self j) ht
      exact hmem
    have hempty : ∀ j, IsEmpty ((wcProEtBC f).obj (Wj j)).left := by
      intro j
      refine Scheme.isEmpty_pullback _ _ (Set.disjoint_left.mpr ?_)
      rintro z ⟨t, rfl⟩ hzf
      have ht : (V.left.basicOpen (r j)).ι t ∈ V.left.basicOpen (r j) := by
        have h1 : (V.left.basicOpen (r j)).ι t ∈ Set.range (V.left.basicOpen (r j)).ι := ⟨t, rfl⟩
        rwa [Scheme.Opens.range_ι] at h1
      have h2 := hsub j _ ht
      rw [hO] at h2
      exact h2 hzf
    have hzero : ∀ j (z : H.obj.obj (Opposite.op ((wcProEtBC f).obj (Wj j)))), z = 0 := by
      intro j z
      haveI := hempty j
      have hT := Sheaf.isTerminalOfBotCover H ((wcProEtBC f).obj (Wj j))
        (Scheme.ProEt.bot_mem_topology _)
      have h := hT.hom_ext (𝟙 _) 0
      have := ConcreteCategory.congr_hom h z
      simpa using this

    let Ws : Fin (n + 1) → S.ProEt := Fin.cons W Wj
    let es : ∀ i, Ws i ⟶ V := @Fin.cons n (fun i => Ws i ⟶ V) w (fun j => ej j)
    have hAff : ∀ i, IsAffine (Ws i).left := by
      intro i
      induction i using Fin.cases with
      | zero => exact hW
      | succ j => exact (isAffineOpen_top V.left).basicOpen (r j)
    have hJS : ∀ z : V.left, ∃ i, z ∈ Set.range (es i).left := by
      intro z
      by_cases hz : V.hom z ∈ Set.range f
      · refine ⟨0, ?_⟩
        exact hcov z (by rw [Scheme.Pullback.range_fst]; exact hz)
      · have hzO : V.hom z ∈ (O : Set S) := by rw [hO]; exact hz
        have hzQ : z ∈ ((V.hom ⁻¹ᵁ O : V.left.Opens) : Set V.left) := hzO
        rw [hQ, Set.mem_iUnion₂] at hzQ
        obtain ⟨i, hi, hzi⟩ := hzQ
        rw [← hr] at hi
        obtain ⟨j, rfl⟩ := hi
        refine ⟨j.succ, ?_⟩
        show z ∈ Set.range (V.left.basicOpen (r j)).ι
        rw [Scheme.Opens.range_ι]
        exact hzi
    refine GrothendieckTopology.superset_covering _ ?_
      (proet_finite_affine_jointly_surjective_covers S V (n + 1) Ws es hAff hJS)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    induction i using Fin.cases with
    | zero =>
      show ∃ t, (((wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map α).hom.app (Opposite.op W) t =
        (((wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).obj H).obj.map (w ≫ e).op y
      refine ⟨G.obj.map a.op x', ?_⟩
      change α.hom.app (Opposite.op ((wcProEtBC f).obj W)) (G.obj.map a.op x') =
        H.obj.map ((wcProEtBC f).map (w ≫ e)).op y
      have hcomp : (wcProEtBC f).map (w ≫ e) = a ≫ g ≫ (wcProEtBC f).map e := by
        rw [Functor.map_comp, ← haw, Category.assoc]
      rw [NatTrans.naturality_apply, hx, hcomp, op_comp, op_comp, Functor.map_comp,
        Functor.map_comp]
      rfl
    | succ j =>
      show ∃ t, (((wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map α).hom.app (Opposite.op (Wj j)) t =
        (((wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).obj H).obj.map (ej j ≫ e).op y
      exact ⟨0, (hzero j _).trans (hzero j _).symm⟩

  haveI : ((wcProEtBC f).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  exact Functor.preservesFiniteColimits_of_preservesHomology _

theorem wc_closed_contfun_extend_affine : ∀ {T Z : Scheme.{u}} (i : Z ⟶ T) [IsClosedImmersion i]
    [IsAffine T], IsCompact (Set.range i)ᶜ →
    ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (y : C(↥Z, ULift.{u+1} ℚ_[ℓ])),
    ∃ (V : Scheme.{u}) (v : V ⟶ T) (x : C(↥V, ULift.{u+1} ℚ_[ℓ])),
      IsAffine V ∧ WeaklyEtale v ∧ Surjective v ∧
      ∀ (a : ↥V) (z : ↥Z), v a = i z → x a = y z :=
by

  have wc_affine_lc_cover : ∀ (T : Scheme.{u}) [IsAffine T] (K : Type) [TopologicalSpace K]
      [CompactSpace K] [T2Space K] [TotallyDisconnectedSpace K],
      ∃ (P : Scheme.{u}) (p : P ⟶ T) (π : C(↥P, K)), IsAffine P ∧ WeaklyEtale p ∧
        (∀ (t : ↥T) (k : K), ∃ q : ↥P, p q = t ∧ π q = k) ∧
        ∀ (W : Set K), IsClopen W → ∃ E : Γ(P, ⊤), IsIdempotentElem E ∧
          ∀ q : ↥P, q ∈ P.basicOpen E ↔ π q ∈ W := by
    intro T _ K _ _ _ _
    classical
    let L := LocallyConstant K (ULift.{u} ℤ)
    let σ := Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) L))
    let τ : T ⟶ Spec (CommRingCat.of (ULift.{u} ℤ)) := specULiftZIsTerminal.from T
    haveI : WeaklyEtale σ := wc_lc_spec_weaklyEtale K
    obtain ⟨π0, hπ0⟩ := wc_lc_spec_pi0.{u} K
    let sn := Limits.pullback.snd τ σ
    let π : C(↥(Limits.pullback τ σ), K) := π0.comp sn.base.hom
    have hev : ∀ (W : Set K) (hW : IsClopen W) (k : K),
        LocallyConstant.evalRingHom k (LocallyConstant.charFn (ULift.{u} ℤ) hW) =
          if k ∈ W then 1 else 0 := by
      intro W hW k
      show (LocallyConstant.charFn (ULift.{u} ℤ) hW) k = _
      rw [LocallyConstant.coe_charFn, Set.indicator_apply]
      rfl
    refine ⟨Limits.pullback τ σ, Limits.pullback.fst τ σ, π, inferInstance, inferInstance, ?_, ?_⟩
    · intro t k
      let q₀ : ↥(Spec (CommRingCat.of L)) :=
        (PrimeSpectrum.comap (LocallyConstant.evalRingHom k) (τ t) : PrimeSpectrum L)
      have hσ : τ t = σ q₀ := by
        refine Eq.symm ((Spec.map_apply _ q₀).trans ?_)
        apply PrimeSpectrum.ext
        ext c
        exact Iff.rfl
      obtain ⟨q, hq1, hq2⟩ := Scheme.Pullback.exists_preimage_pullback t q₀ hσ
      refine ⟨q, hq1, ?_⟩
      have hπq : π q = π0 q₀ := by
        show π0 (sn q) = π0 q₀
        rw [hq2]
      rw [hπq]
      by_contra hne
      obtain ⟨W, hWc, hW1, hW2⟩ := exists_isClopen_of_totally_separated hne
      have h1 := (hπ0 W hWc q₀).mp hW1
      rw [PrimeSpectrum.mem_basicOpen] at h1
      apply h1
      show LocallyConstant.evalRingHom k (LocallyConstant.charFn (ULift.{u} ℤ) hWc) ∈ (τ t).asIdeal
      rw [hev, if_neg hW2]
      exact Ideal.zero_mem _
    · intro W hW
      have hidem : IsIdempotentElem (LocallyConstant.charFn (ULift.{u} ℤ) hW) := by
        refine LocallyConstant.ext fun x => ?_
        simp only [LocallyConstant.coe_mul, Pi.mul_apply, LocallyConstant.coe_charFn,
          Set.indicator_apply]
        split_ifs <;> simp
      refine ⟨sn.appTop ((Scheme.ΓSpecIso (CommRingCat.of L)).inv
        (LocallyConstant.charFn (ULift.{u} ℤ) hW)),
        (hidem.map (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom).map sn.appTop.hom, fun q => ?_⟩
      rw [← Scheme.preimage_basicOpen_top]
      show sn q ∈ (Spec (CommRingCat.of L)).basicOpen _ ↔ π0 (sn q) ∈ W
      rw [basicOpen_eq_of_affine]
      exact (hπ0 W hW (sn q)).symm

  have wc_affine_compact_open_basicOpens : ∀ (T : Scheme.{u}) [IsAffine T] (O : Set ↥T),
      IsOpen O → IsCompact O → ∃ (r : ℕ) (h : Fin r → Γ(T, ⊤)),
        ∀ t : ↥T, t ∈ O ↔ ∃ j, t ∈ T.basicOpen (h j) := by
    intro T _ O hOo hOc
    have : ∀ t : O, ∃ c : Γ(T, ⊤), (t : T) ∈ T.basicOpen c ∧ (T.basicOpen c : Set T) ⊆ O := by
      intro t
      obtain ⟨U', ⟨c, rfl⟩, ht, hle⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (isBasis_basicOpen T) (U := ⟨O, hOo⟩) (x := t.1) t.2
      exact ⟨c, ht, fun x hx => hle hx⟩
    choose c hc hcO using this
    obtain ⟨s, hs⟩ := hOc.elim_finite_subcover (fun t : O => (T.basicOpen (c t) : Set T))
      (fun t => (T.basicOpen (c t)).isOpen) (fun t ht => Set.mem_iUnion.mpr ⟨⟨t, ht⟩, hc _⟩)
    refine ⟨s.card, fun j => c (s.equivFin.symm j), fun t => ⟨fun ht => ?_, ?_⟩⟩
    · obtain ⟨u, hu, htu⟩ := Set.mem_iUnion₂.mp (hs ht)
      refine ⟨s.equivFin ⟨u, hu⟩, ?_⟩
      simpa using htu
    · rintro ⟨j, hj⟩
      exact hcO _ hj

  have wc_closed_immersion_clopen_lift : ∀ {Z T : Scheme.{u}} (i : Z ⟶ T) [IsClosedImmersion i]
      [IsAffine T] (W : Set ↥Z), IsClopen W →
      ∃ g : Γ(T, ⊤), ∀ z : ↥Z, i z ∈ T.basicOpen g ↔ z ∈ W := by
    intro Z T i _ _ W hW
    obtain ⟨θ, -, hθ⟩ := wc_scheme_lc_to_global Z
    obtain ⟨g, hg⟩ := (IsClosedImmersion.isAffine_surjective_of_isAffine i).2
      (θ (LocallyConstant.charFn (ULift.{u} ℤ) hW))
    refine ⟨g, fun z => ?_⟩
    rw [← hθ W hW z, ← hg, ← Scheme.preimage_basicOpen_top]
    rfl

  have wc_affine_localize_basicOpens : ∀ (P : Scheme.{u}) [IsAffine P] (M : Set Γ(P, ⊤)),
      ∃ (V : Scheme.{u}) (j : V ⟶ P), IsAffine V ∧ WeaklyEtale j ∧
        Set.range j = {q : ↥P | ∀ s ∈ M, q ∈ P.basicOpen s} := by
    intro P _ M
    let N := Submonoid.closure M
    let φ := CommRingCat.ofHom (algebraMap Γ(P, ⊤) (Localization N))
    have hflat : Flat (Spec.map φ) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat _ N)
    have hmono : Mono (Spec.map φ) := (inferInstance : Mono (Scheme.Spec.map φ.op))
    have hW : WeaklyEtale (Spec.map φ) := WeaklyEtale.mk hflat inferInstance
    refine ⟨Spec (CommRingCat.of (Localization N)), Spec.map φ ≫ P.isoSpec.inv, inferInstance,
      inferInstance, ?_⟩
    have hrange : ∀ p : PrimeSpectrum Γ(P, ⊤), (∃ w, Spec.map φ w = p) ↔
        Disjoint (N : Set Γ(P, ⊤)) p.asIdeal := by
      intro p
      have h := Set.ext_iff.mp (PrimeSpectrum.localization_comap_range (Localization N) N) p
      refine Iff.trans ?_ h
      constructor
      · rintro ⟨w, hw⟩
        exact ⟨w, (Spec.map_apply φ w).symm.trans hw⟩
      · rintro ⟨w, hw⟩
        exact ⟨w, (Spec.map_apply φ w).trans hw⟩
    have hdisj : ∀ p : PrimeSpectrum Γ(P, ⊤), Disjoint (N : Set Γ(P, ⊤)) p.asIdeal ↔
        ∀ s ∈ M, s ∉ p.asIdeal := by
      intro p
      rw [Set.disjoint_left]
      constructor
      · intro H s hs
        exact H (Submonoid.subset_closure hs)
      · intro H a ha
        induction ha using Submonoid.closure_induction with
        | mem x hx => exact H x hx
        | one => exact (Ideal.ne_top_iff_one _).mp p.isPrime.ne_top
        | mul x y _ _ hx hy =>
          intro hxy
          rcases (p.isPrime.mul_mem_iff_mem_or_mem).mp hxy with h | h
          · exact hx h
          · exact hy h
    have hbo : ∀ (q : P) (s : Γ(P, ⊤)), q ∈ P.basicOpen s ↔ s ∉ (P.isoSpec.hom q).asIdeal := by
      intro q s
      rw [Scheme.isoSpec_hom, ← Scheme.toSpecΓ_preimage_basicOpen]
      exact PrimeSpectrum.mem_basicOpen _ _
    ext q
    show q ∈ Set.range _ ↔ ∀ s ∈ M, q ∈ P.basicOpen s
    constructor
    · rintro ⟨w, rfl⟩ s hs
      rw [hbo]
      have e : P.isoSpec.hom ((Spec.map φ ≫ P.isoSpec.inv) w) = Spec.map φ w := by
        rw [← Scheme.Hom.comp_apply, Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact (hdisj _).mp ((hrange _).mp ⟨w, rfl⟩) s hs
    · intro H
      obtain ⟨w, hw⟩ := (hrange (P.isoSpec.hom q)).mpr
        ((hdisj _).mpr (fun s hs => (hbo q s).mp (H s hs)))
      refine ⟨w, ?_⟩
      rw [Scheme.Hom.comp_apply, hw, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl

  have wc_basicOpen_one_sub_add_mul : ∀ (P : Scheme.{u}) (E c : Γ(P, ⊤)), IsIdempotentElem E →
      ∀ q : ↥P, q ∈ P.basicOpen (1 - E + E * c) ↔ (q ∈ P.basicOpen E → q ∈ P.basicOpen c) := by
    intro P E c hE q
    simp only [← Scheme.evaluation_ne_zero_iff_mem_basicOpen P q (U := ⊤) trivial, map_add,
      map_sub, map_one, map_mul]
    rcases IsIdempotentElem.iff_eq_zero_or_one.mp
        (hE.map (ConcreteCategory.hom (P.evaluation ⊤ q trivial))) with h0 | h1
    · rw [h0]; simp
    · rw [h1]; simp
  intro T Z i _ _ hO ℓ _ y
  classical
  haveI : IsAffine Z := (IsClosedImmersion.isAffine_surjective_of_isAffine i).1

  obtain ⟨K, _, _, _, _, y', hy', ι, hι, hιy⟩ : ∃ (K : Type) (_ : TopologicalSpace K)
      (_ : CompactSpace K) (_ : T2Space K) (_ : TotallyDisconnectedSpace K) (y' : ↥Z → K),
      Continuous y' ∧ ∃ ι : K → ULift.{u+1} ℚ_[ℓ], Continuous ι ∧ ∀ z, ι (y' z) = y z := by
    have hy₀ : Continuous (fun z => (y z).down) := Homeomorph.ulift.continuous.comp y.continuous
    haveI : CompactSpace (Set.range (fun z => (y z).down)) :=
      isCompact_iff_compactSpace.mp (isCompact_range hy₀)
    exact ⟨Set.range (fun z => (y z).down), inferInstance, inferInstance, inferInstance,
      inferInstance, Set.rangeFactorization (fun z => (y z).down), hy₀.rangeFactorization,
      fun k => ULift.up k.1, Homeomorph.ulift.symm.continuous.comp continuous_subtype_val,
      fun z => rfl⟩

  have hOopen : IsOpen (Set.range i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
  obtain ⟨r, h, hH⟩ := wc_affine_compact_open_basicOpens T _ hOopen hO

  obtain ⟨P, p, π, hPaff, hpW, hpts, hidem⟩ := wc_affine_lc_cover T (K ⊕ Fin r)
  haveI := hPaff
  haveI := hpW
  choose E hE hEb using hidem

  have hcl : ∀ W : Set K, IsClopen W → IsClopen (Sum.inl '' W : Set (K ⊕ Fin r)) :=
    fun W hW => ⟨Topology.IsClosedEmbedding.inl.isClosedMap _ hW.1,
      Topology.IsOpenEmbedding.inl.isOpenMap _ hW.2⟩
  have hcr : ∀ j : Fin r, IsClopen ({Sum.inr j} : Set (K ⊕ Fin r)) := by
    intro j
    rw [← Set.image_singleton]
    exact ⟨Topology.IsClosedEmbedding.inr.isClosedMap _ (isClopen_discrete _).1,
      Topology.IsOpenEmbedding.inr.isOpenMap _ (isClopen_discrete _).2⟩
  choose g hg using fun (W : {W : Set K // IsClopen W}) =>
    wc_closed_immersion_clopen_lift i (y' ⁻¹' W.1) (W.2.preimage hy')
  let a : {W : Set K // IsClopen W} → Γ(P, ⊤) := fun W =>
    1 - E _ (hcl W.1 W.2) + E _ (hcl W.1 W.2) * p.appTop (g W)
  let b : Fin r → Γ(P, ⊤) := fun j =>
    1 - E _ (hcr j) + E _ (hcr j) * p.appTop (h j)

  obtain ⟨V, jV, hVaff, hjW, hrange⟩ :=
    wc_affine_localize_basicOpens P (Set.range a ∪ Set.range b)
  haveI := hjW

  have hmemP : ∀ (q : ↥P) (c : Γ(T, ⊤)), q ∈ P.basicOpen (p.appTop c) ↔ p q ∈ T.basicOpen c := by
    intro q c
    rw [← Scheme.preimage_basicOpen_top]
    rfl
  have hR : ∀ q : ↥P, q ∈ Set.range jV ↔
      (∀ W : {W : Set K // IsClopen W}, π q ∈ (Sum.inl '' W.1 : Set (K ⊕ Fin r)) →
        p q ∈ T.basicOpen (g W)) ∧
      (∀ j, π q = Sum.inr j → p q ∈ T.basicOpen (h j)) := by
    intro q
    rw [hrange]
    constructor
    · intro H
      refine ⟨fun W hW => ?_, fun j hj => ?_⟩
      · have h1 := (wc_basicOpen_one_sub_add_mul P _ _ (hE _ (hcl W.1 W.2)) q).mp
          (H (a W) (Or.inl ⟨W, rfl⟩))
        exact (hmemP q (g W)).mp (h1 ((hEb _ _ q).mpr hW))
      · have h1 := (wc_basicOpen_one_sub_add_mul P _ _ (hE _ (hcr j)) q).mp
          (H (b j) (Or.inr ⟨j, rfl⟩))
        exact (hmemP q (h j)).mp (h1 ((hEb _ _ q).mpr (Set.mem_singleton_iff.mpr hj)))
    · rintro ⟨H1, H2⟩ s hs
      rcases hs with ⟨W, rfl⟩ | ⟨j, rfl⟩
      · refine (wc_basicOpen_one_sub_add_mul P _ _ (hE _ (hcl W.1 W.2)) q).mpr ?_
        intro hq
        exact (hmemP q (g W)).mpr (H1 W ((hEb _ _ q).mp hq))
      · refine (wc_basicOpen_one_sub_add_mul P _ _ (hE _ (hcr j)) q).mpr ?_
        intro hq
        exact (hmemP q (h j)).mpr (H2 j (Set.mem_singleton_iff.mp ((hEb _ _ q).mp hq)))

  let ιp : K ⊕ Fin r → ULift.{u+1} ℚ_[ℓ] := Sum.elim ι (fun _ => ULift.up 0)
  have hιp : Continuous ιp := hι.sumElim continuous_const
  let x : C(↥V, ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun a => ιp (π (jV a)), hιp.comp (π.continuous.comp jV.continuous)⟩

  have hsurj : Function.Surjective (jV ≫ p) := by
    intro t
    by_cases ht : t ∈ Set.range i
    · obtain ⟨z, rfl⟩ := ht
      obtain ⟨q, hpq, hπq⟩ := hpts (i z) (Sum.inl (y' z))
      have hcond : (∀ W : {W : Set K // IsClopen W}, π q ∈ (Sum.inl '' W.1 : Set (K ⊕ Fin r)) →
            p q ∈ T.basicOpen (g W)) ∧
          (∀ j, π q = Sum.inr j → p q ∈ T.basicOpen (h j)) := by
        refine ⟨fun W hW => ?_, fun j hj => ?_⟩
        · rw [hπq] at hW
          obtain ⟨k, hk, hkeq⟩ := hW
          have hk' : k = y' z := Sum.inl_injective hkeq
          rw [hpq]
          subst hk'
          exact (hg W z).mpr hk
        · rw [hπq] at hj
          exact absurd hj Sum.inl_ne_inr
      obtain ⟨a', ha'⟩ := (hR q).mpr hcond
      exact ⟨a', by rw [Scheme.Hom.comp_apply, ha', hpq]⟩
    · have hto : t ∈ (Set.range i)ᶜ := ht
      obtain ⟨j, hj⟩ := (hH t).mp hto
      obtain ⟨q, hpq, hπq⟩ := hpts t (Sum.inr j)
      have hcond : (∀ W : {W : Set K // IsClopen W}, π q ∈ (Sum.inl '' W.1 : Set (K ⊕ Fin r)) →
            p q ∈ T.basicOpen (g W)) ∧
          (∀ j', π q = Sum.inr j' → p q ∈ T.basicOpen (h j')) := by
        refine ⟨fun W hW => ?_, fun j' hj' => ?_⟩
        · rw [hπq] at hW
          obtain ⟨k, _, hk⟩ := hW
          exact absurd hk Sum.inl_ne_inr
        · rw [hπq] at hj'
          have hjj : j = j' := Sum.inr_injective hj'
          rw [hpq, ← hjj]
          exact hj
      obtain ⟨a', ha'⟩ := (hR q).mpr hcond
      exact ⟨a', by rw [Scheme.Hom.comp_apply, ha', hpq]⟩
  refine ⟨V, jV ≫ p, x, hVaff, inferInstance, ⟨hsurj⟩, ?_⟩

  intro a' z hvz
  obtain ⟨H1, H2⟩ := (hR (jV a')).mp ⟨a', rfl⟩
  have hpq : p (jV a') = i z := by
    rw [← Scheme.Hom.comp_apply]
    exact hvz
  show ιp (π (jV a')) = y z
  rcases hπ : π (jV a') with k | j
  · have hk : k = y' z := by
      by_contra hk
      obtain ⟨W, hWc, hkW, hzW⟩ := exists_isClopen_of_totally_separated hk
      have h1 := H1 ⟨W, hWc⟩ (by rw [hπ]; exact ⟨k, hkW, rfl⟩)
      rw [hpq] at h1
      exact hzW ((hg ⟨W, hWc⟩ z).mp h1)
    rw [hk]
    exact hιy z
  · exfalso
    have h1 := H2 j hπ
    rw [hpq] at h1
    have h2 : i z ∈ (Set.range i)ᶜ := (hH _).mpr ⟨j, h1⟩
    exact h2 ⟨z, rfl⟩

theorem wc_proet_closed_unit_restriction_epi : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S)
    [IsClosedImmersion f] [QuasiSeparatedSpace ↥S],
    (∃ U : S.Opens, (U : Set ↥S) = (Set.range f)ᶜ ∧ IsAffineOpen U) →
    ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcHMPullData f ℓ), wcHMPullCanonical D →
    Epi (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ) :=
by
  intro S S' f _ _ hU ℓ _ D hD
  haveI := D.cont
  haveI := Functor.reflectsEpimorphisms_of_faithful (SheafOfModules.toSheaf (wcRingSheaf S ℓ))
  apply (SheafOfModules.toSheaf (wcRingSheaf S ℓ)).epi_of_epi_map
  apply wc_proet_epi_of_affine_lift S
  intro U hUaff y
  haveI : IsAffine U.left := hUaff
  haveI : IsAffine ((𝟭 Scheme.{u}).obj U.left) := hUaff
  haveI : WeaklyEtale U.hom := U.prop
  let y' : C(↥(Limits.pullback U.hom f), ULift.{u+1} ℚ_[ℓ]) := y
  have hO : IsCompact (Set.range (Limits.pullback.fst U.hom f))ᶜ := by
    obtain ⟨O, hOset, hOaff⟩ := hU
    rw [Scheme.Pullback.range_fst, ← Set.preimage_compl, ← hOset]
    haveI : QuasiSeparatedSpace ↥((Functor.fromPUnit S).obj U.right) :=
      inferInstanceAs (QuasiSeparatedSpace ↥S)
    haveI := quasiCompact_of_compactSpace U.hom
    exact QuasiCompact.isCompact_preimage _ O.isOpen hOaff.isCompact
  obtain ⟨V₀, v, x, hV₀, hvW, hvS, heq⟩ :=
    wc_closed_contfun_extend_affine (Limits.pullback.fst U.hom f) hO ℓ y'
  haveI := hvW
  let V : S.ProEt := MorphismProperty.Over.mk ⊤ (v ≫ U.hom) inferInstance
  let g : V ⟶ U := MorphismProperty.Over.homMk v rfl trivial
  refine ⟨V, g, x, hV₀, hvS, ?_⟩
  have h2 := hD V x
  let m := ((wcProEtBC f).map g).left
  have hm : m ≫ Limits.pullback.fst U.hom f = Limits.pullback.fst (v ≫ U.hom) f ≫ v := by
    show ((wcProEtBC f).map g).left ≫ _ = _
    unfold wcProEtBC
    erw [MorphismProperty.Over.pullback_map_left]
    exact Limits.pullback.lift_fst _ _ _
  change (D.φ.hom.app (Opposite.op V)).hom x = _
  refine h2.trans ?_
  change x.comp (Limits.pullback.fst (v ≫ U.hom) f).base.hom = y'.comp m.base.hom
  refine ContinuousMap.ext fun w => ?_
  have hpt : v (Limits.pullback.fst (v ≫ U.hom) f w) = Limits.pullback.fst U.hom f (m w) := by
    rw [← Scheme.Hom.comp_apply, ← hm]
    rfl
  exact heq _ _ hpt

theorem wc_hm_proper_cd_vanishing (K : Type u) [Field K] [IsAlgClosed K] (E : Scheme.{u})
    (f : E ⟶ Spec (.of K)) [IsProper f] (n : ℕ)
    (hdim : topologicalKrullDim E < (n : WithBot ℕ∞))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (q : ℕ) (hq : 2 * n < q + 2)
    (x : wcHM E ℓ q) : x = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf E ℓ)) := HasExt.standard _

  have hcases : (n = 0 ∧ IsEmpty ↥E) ∨
      ∃ m : ℕ, n = m + 1 ∧ topologicalKrullDim ↥E ≤ (m : WithBot ℕ∞) := by
    rcases n with _ | m
    · left
      refine ⟨rfl, ⟨fun x => ?_⟩⟩
      have hne : Nonempty (TopologicalSpace.IrreducibleCloseds ↥E) :=
        ⟨⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥E := by
        rw [topologicalKrullDim]; exact Order.krullDim_nonneg
      rw [Nat.cast_zero] at hdim
      exact absurd hdim (not_lt.mpr h0)
    · right
      refine ⟨m, rfl, ?_⟩
      generalize topologicalKrullDim ↥E = t at hdim ⊢
      induction t using WithBot.recBotCoe with
      | bot => exact bot_le
      | coe y =>
        have h' : y < ((m + 1 : ℕ) : ℕ∞) := by
          rw [← WithBot.coe_natCast] at hdim
          exact WithBot.coe_lt_coe.mp hdim
        have h'' : y ≤ (m : ℕ∞) := by
          rw [Nat.cast_succ] at h'
          exact (ENat.lt_add_one_iff (ENat.coe_ne_top m)).mp h'
        rw [← WithBot.coe_natCast]
        exact WithBot.coe_le_coe.mpr h''
  rcases hcases with ⟨rfl, hE⟩ | ⟨m, rfl, hdim'⟩
  ·
    have hsub : ∀ V : (E.ProEt)ᵒᵖ, Subsingleton ((wcRingSheaf E ℓ).obj.obj V) := by
      intro V
      haveI : IsEmpty ↥(V.unop.left) := ⟨fun y => hE.false (V.unop.hom y)⟩
      change Subsingleton C(↥(V.unop.left), ULift.{u+1} ℚ_[ℓ])
