        (Abelian.Ext.mk₀ νz) (add_zero q)) (zero_add q) = 0) :
    ∃ (V : Set W₀) (hV : IsClopen V), z ∈ V ∧
      (letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf T ℓ)) := HasExt.standard _
      (Abelian.Ext.mk₀ (wcIntFun T ℓ ((LocallyConstant.charFn (ULift.{u+1} ℤ_[ℓ]) hV).toContinuousMap.comp
        g.base.hom))).comp x (zero_add q) = 0) :=
by
  classical
  letI iT : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf T ℓ)) := HasExt.standard _
  letI iU : HasExt (SheafOfModules.{u+1}
    (wcIntRingSheaf (Limits.pullback (W₀.fromSpecStalk z) g) ℓ)) := HasExt.standard _
  letI zT : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T (ℓ ^ k))) := HasExt.standard _
  letI zU : HasExt (SheafOfModules.{u+1}
    (wcZModRingSheaf (Limits.pullback (W₀.fromSpecStalk z) g) (ℓ ^ k))) := HasExt.standard _
  haveI := Dz.additive
  haveI := Dz.presLim
  haveI := Dz.presColim



  have hexact : ∀ (S : Scheme.{u}) (R R' : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1})
      (φ : R ⟶ R'),
      (SheafOfModules.restrictScalars.{u+1} φ).Additive ∧
        Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ) ∧
        Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ) := by
    intro S R R' φ
    have hGlim : ∀ (R₀ : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}) (K : Type)
