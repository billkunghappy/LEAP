theorem wc_wcontr_supp_top_boundary_transfer (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (H0 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      ∃ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) ∧
        Epi (wcSuppUnitMap Dz))
    (hr : 1 ≤ r) (O : V.left.Opens)
    (hO : (O : Set ↥V.left) = (Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ)
    (y : wcSuppExt DV (2 * r))
    (hy : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) y) (zero_add _) = 0) :
    ∃ α : wcHM O.toScheme ℓ (2 * r - 1), (α = 0 → y = 0) ∧
      ∀ z : V.left, IsClosed ({z} : Set V.left) →
        ∀ (Dα : wcHMPullData (Limits.pullback.snd (V.left.fromSpecStalk z) O.ι) ℓ),
          wcHMPullCanonical Dα → wcHMPull Dα (2 * r - 1) α = 0 :=
by
  classical
  letI iV : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  haveI : IsAffine V.left := h1
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY

  have hqcgen : ∀ {S T' : Scheme.{u}} (g : S ⟶ Y) (jg : T' ⟶ S),
      Set.range jg = g ⁻¹' Set.range i →
      ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ S), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
        ∀ x : ↥W, (p x ∉ Set.range jg ↔ ∃ k, x ∈ W.basicOpen (f k)) := by
    intro S T' g jg hrg W _ p
    obtain ⟨n, f, hf⟩ := wc_affine_complement_basicOpen_cover i W (p ≫ g)
    refine ⟨n, f, fun x => ?_⟩
    rw [hrg, Set.mem_preimage, ← Scheme.Hom.comp_apply]
    exact hf x

  have hvan : ∀ (S : Scheme.{u}) [IsAffine S] (q : ℕ), Subsingleton (wcEtCoh S ℓ (q + 1)) →
      ∀ x : wcHM S ℓ (q + 1), x = 0 := by
    intro S _ q h
    apply wc_hm_vanish_of_int_ext_vanish S ℓ q
    apply wc_proet_int_ext_vanish_of_zmod_deg S ℓ _ q
    intro k
    exact wc_proet_zmod_ext_vanish_of_et S (ℓ ^ (k + 1)) q
      (wc_et_coh_zmod_prime_pow_of_prime S ℓ (Fact.out) (q + 1) h k)

  have hker := fun (U : V.left.ProEt)
      (k : (Limits.kernel (wcSuppUnitMap DV)).val.obj (Opposite.op U))
      (W : V.left.ProEt) (g : W ⟶ U) (hW : IsAffine W.left) =>
    wc_supp_kernel_section_local_cover_qc (Limits.pullback.fst V.hom i)
      (hqcgen V.hom (Limits.pullback.fst V.hom i) (Scheme.Pullback.range_fst V.hom i))
      DV hDV U k W g hW
  have hd : 2 * r - 1 + 1 = 2 * r := by omega
  obtain ⟨δ, hsurj, hnat⟩ := wc_supp_les_boundary_natural_qc (Limits.pullback.fst V.hom i)
    DV hDV hepi hker O hO (2 * r - 1) (2 * r) hd

  have hvanV : ∀ x : wcHM V.left ℓ (2 * r), x = 0 := by
    have h0 := hvan V.left (2 * r - 1)
      (wc_wstrictly_local_affine_et_vanish K ℓ hℓ (V.hom ≫ pY) ⟨h1, h2, h3, h4, h5⟩ (2 * r - 1))
    rw [hd] at h0
    exact h0
  obtain ⟨α, hα⟩ := hsurj y (hvanV _)
  refine ⟨α, fun h0 => by rw [← hα, h0, map_zero], ?_⟩

  intro z hz Dα hDα
  haveI hwe : WeaklyEtale (V.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale V.left z
  obtain ⟨Ez, hEz⟩ := wc_hm_pull_data_exists (V.left.fromSpecStalk z) ℓ
  obtain ⟨Dz, hDz, γz, hγz, hepiz⟩ := wc_closed_supp_base_change_weaklyEtale_affine
    (Limits.pullback.fst V.hom i) (V.left.fromSpecStalk z) DV hDV Ez hEz
  have hrfz : Set.range ⇑(Limits.pullback.fst (V.left.fromSpecStalk z)
      (Limits.pullback.fst V.hom i)) =
      ⇑(V.left.fromSpecStalk z) ⁻¹' Set.range ⇑(Limits.pullback.fst V.hom i) :=
    Scheme.Pullback.range_fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)
  have hO' : (((V.left.fromSpecStalk z) ⁻¹ᵁ O : (Spec (V.left.presheaf.stalk z)).Opens) :
      Set ↥(Spec (V.left.presheaf.stalk z))) =
      (Set.range ⇑(Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)))ᶜ := by
    rw [hrfz, Scheme.Hom.coe_preimage, hO, Set.preimage_compl]
  have hr' : Set.range ⇑(Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) =
      ⇑(V.left.fromSpecStalk z ≫ V.hom) ⁻¹' Set.range ⇑i := by
    rw [hrfz, Scheme.Pullback.range_fst V.hom i]
    ext x
    simp only [Set.mem_preimage, Scheme.Hom.comp_apply]
  have hker' := fun (U : (Spec (V.left.presheaf.stalk z)).ProEt)
      (k : (Limits.kernel (wcSuppUnitMap Dz)).val.obj (Opposite.op U))
      (W : (Spec (V.left.presheaf.stalk z)).ProEt) (g : W ⟶ U) (hW : IsAffine W.left) =>
    wc_supp_kernel_section_local_cover_qc
      (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i))
      (hqcgen (V.left.fromSpecStalk z ≫ V.hom) _ hr') Dz hDz U k W g hW
  obtain ⟨Dw', hDw'⟩ := wc_hm_pull_data_exists ((V.left.fromSpecStalk z) ⁻¹ᵁ O).ι ℓ
  obtain ⟨DfO, hDfO⟩ := wc_hm_pull_data_exists ((V.left.fromSpecStalk z) ∣_ O) ℓ
  obtain ⟨δ', hkerδ', hnatz⟩ := hnat
    (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i))
    (V.left.fromSpecStalk z) Dz hDz hepiz hker' ((V.left.fromSpecStalk z) ⁻¹ᵁ O) hO'
    ((V.left.fromSpecStalk z) ∣_ O) (morphismRestrict_ι _ _) Ez hEz γz hγz Dw' hDw' DfO hDfO

  letI iS : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
  have hρ : (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) y) (zero_add _) = 0 := by
    by_cases hzr : z ∈ Set.range ⇑(Limits.pullback.fst V.hom i)
    · exact hy z hz hzr Ez hEz Dz hDz γz hγz hepiz
    · have hempty : IsEmpty ↥(Limits.pullback (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) := by
        refine ⟨fun q => hzr ?_⟩
        have hq : V.left.fromSpecStalk z ((Limits.pullback.fst (V.left.fromSpecStalk z)
            (Limits.pullback.fst V.hom i)) q) ⤳ z := by
          have h := (IsLocalRing.specializes_closedPoint
            (R := ↑(V.left.presheaf.stalk z))
            ((Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) q)).map
              (V.left.fromSpecStalk z).continuous
          rwa [Scheme.fromSpecStalk_closedPoint] at h
        have hpc : V.left.fromSpecStalk z ((Limits.pullback.fst (V.left.fromSpecStalk z)
            (Limits.pullback.fst V.hom i)) q) =
            (Limits.pullback.fst V.hom i) ((Limits.pullback.snd (V.left.fromSpecStalk z)
              (Limits.pullback.fst V.hom i)) q) := by
          rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
        rw [hpc] at hq
        exact hq.mem_closed (Limits.pullback.fst V.hom i).isClosedEmbedding.isClosed_range
          ⟨_, rfl⟩
      have hV' : ∀ W' : (Limits.pullback (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)).ProEt, IsEmpty ↥W'.left :=
        fun W' => ⟨fun a => hempty.false (W'.hom a)⟩
      have hzero : Limits.IsZero (SheafOfModules.unit (wcRingSheaf (Limits.pullback
          (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) ℓ)) := by
        rw [Limits.IsZero.iff_id_eq_zero]
        apply (SheafOfModules.unitHomEquiv _).injective
        apply Subtype.ext
        funext W'
        haveI := hV' (Opposite.unop W')
        have hsub : Subsingleton C(↥(Opposite.unop W').left, ULift.{u+1} ℚ_[ℓ]) :=
          ⟨fun a b => ContinuousMap.ext (fun x => isEmptyElim x)⟩
        exact @Subsingleton.elim _ hsub _ _
      have hP : Limits.IsZero (wcSuppObj Dz) := by
        haveI := Dz.adj.isRightAdjoint
        exact Functor.map_isZero
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC _) _ _ Dz.cont Dz.φ) hzero
      calc (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) y) (zero_add _)
          = (Abelian.Ext.mk₀ (𝟙 (wcSuppObj Dz))).comp ((Abelian.Ext.mk₀ γz).comp
              (wcSuppPullExt DV Ez (2 * r) y) (zero_add _)) (zero_add _) :=
            (Abelian.Ext.mk₀_id_comp _).symm
        _ = 0 := by
          rw [hP.eq_of_src (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]

  have hβ0 : δ' (wcHMPull DfO (2 * r - 1) α) = 0 := by
    rw [hnatz, hα]
    exact hρ
  obtain ⟨x, hx⟩ := hkerδ' _ hβ0
  have he : 2 * r - 1 = 2 * r - 2 + 1 := by omega
  have hx0 : x = 0 := by
    haveI := (h5 z hz).1
    haveI : IsSepClosed (IsLocalRing.ResidueField ↑(V.left.presheaf.stalk z)) := (h5 z hz).2
    have hs0 := wc_et_strictly_local_ext_vanishing (↑(V.left.presheaf.stalk z))
      ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of ↑(V.left.presheaf.stalk z))))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (2 * r - 2)
    have hs : Subsingleton (wcEtCoh (Spec (V.left.presheaf.stalk z)) ℓ (2 * r - 2 + 1)) := hs0
    have h0 := hvan (Spec (V.left.presheaf.stalk z)) (2 * r - 2) hs
    rw [← he] at h0
    exact h0 x
  have hβ : wcHMPull DfO (2 * r - 1) α = 0 := by
    rw [← hx, hx0, map_zero]

  obtain ⟨De, hDe⟩ := wc_hm_pull_data_exists
    (pullbackRestrictIsoRestrict (V.left.fromSpecStalk z) O).hom ℓ
  rw [wc_hm_pull_comp ((V.left.fromSpecStalk z) ∣_ O)
    (pullbackRestrictIsoRestrict (V.left.fromSpecStalk z) O).hom
    (Limits.pullback.snd (V.left.fromSpecStalk z) O.ι)
    (pullbackRestrictIsoRestrict_hom_morphismRestrict _ _) DfO hDfO De hDe Dα hDα (2 * r - 1) α,
    hβ, map_zero]

theorem wc_wlocal_open_zmod_closed_stalk_separation {W₀ : Scheme.{u}} (haff : IsAffine W₀)
    (hc : IsClosed {x : W₀ | IsClosed ({x} : Set W₀)})
    (hu : ∀ x : W₀, ∃! y : W₀, IsClosed ({y} : Set W₀) ∧ x ⤳ y)
    (O : W₀.Opens) (hOc : IsCompact (O : Set W₀)) (n j : ℕ)
    (h : wcZModProEtExt O.toScheme n j)
    (h0 : ∀ z : W₀, IsClosed ({z} : Set W₀) →
      ∀ Dz : wcZModPullData (Limits.pullback.snd (W₀.fromSpecStalk z) O.ι) n,
        wcZModPullCanonical Dz → wcZModPull Dz j h = 0) :
    h = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf O.toScheme n)) := HasExt.standard _
  haveI := haff
  haveI : CompactSpace O.toScheme := isCompact_iff_compactSpace.mp hOc
  have hqc : QuasiCompact O.ι := quasiCompact_of_compactSpace O.ι
  have hqs : QuasiSeparated O.ι := inferInstance

  have hone : ∀ S : Scheme.{u}, wcZModFun S n 1 = 𝟙 _ := by
    intro S
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hmul : ∀ (S : Scheme.{u}) (r r' : C(↥S, ULift.{u+1} (ZMod n))),
      wcZModFun S n (r * r') = wcZModFun S n r ≫ wcZModFun S n r' := by
    intro S r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod n)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S n c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod n))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    show _ = ((wcZModFun S n r').val.app V).hom
      (((SheafOfModules.unitHomEquiv _) (wcZModFun S n r)).1 V)
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hadd : ∀ (S : Scheme.{u}) (f f' : C(↥S, ULift.{u+1} (ZMod n))),
      wcZModFun S n (f + f') = wcZModFun S n f + wcZModFun S n f' := by
    intro S f f'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ (h : C(↥S, ULift.{u+1} (ZMod n))),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S n h)).1 V =
        h.comp (Opposite.unop V).hom.base.hom := by
      intro h
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun S n f)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun S n f')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl

  obtain ⟨K, hK⟩ : ∃ K : C(↥O.toScheme, ULift.{u+1} (ZMod n)) → Prop, ∀ r, K r ↔
      (Abelian.Ext.mk₀ (wcZModFun O.toScheme n r)).comp h (zero_add j) = 0 :=
    ⟨_, fun _ => Iff.rfl⟩
  have hF0 : wcZModFun O.toScheme n 0 = 0 := by
    have h1 := hadd O.toScheme 0 0
    rw [add_zero] at h1
    calc wcZModFun O.toScheme n 0
        = wcZModFun O.toScheme n 0 + wcZModFun O.toScheme n 0 - wcZModFun O.toScheme n 0 :=
          (add_sub_cancel_right _ _).symm
      _ = wcZModFun O.toScheme n 0 - wcZModFun O.toScheme n 0 := by rw [← h1]
      _ = 0 := sub_self _
  have K0 : K 0 := by
    rw [hK, hF0, Abelian.Ext.mk₀_zero]
    first
      | exact Abelian.Ext.zero_comp _ _
      | exact Abelian.Ext.zero_comp _
      | simp
  have Kadd : ∀ a b, K a → K b → K (a + b) := by
    intro a b ha hb
    rw [hK] at ha hb ⊢
    rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, ha, hb, add_zero]
  have Kmul : ∀ a b, K b → K (a * b) := by
    intro a b hb
    rw [hK] at hb ⊢
    have e : (Abelian.Ext.mk₀ (wcZModFun O.toScheme n a)).comp
        ((Abelian.Ext.mk₀ (wcZModFun O.toScheme n b)).comp h (zero_add j)) (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun O.toScheme n a ≫ wcZModFun O.toScheme n b)).comp h
          (zero_add j) := by
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    rw [hmul, ← e, hb]
    first
      | exact Abelian.Ext.comp_zero _ _
      | exact Abelian.Ext.comp_zero _
      | simp

  have hcov : ∀ x : W₀, ∃ (V : Set W₀) (hV : IsClopen V), x ∈ V ∧
      K ((LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hV).toContinuousMap.comp
        O.ι.base.hom) := by
    intro x
    obtain ⟨z, ⟨hzc, hxz⟩, -⟩ := hu x
    obtain ⟨Dz, hDz⟩ := wc_zmod_pull_data_exists (Limits.pullback.snd (W₀.fromSpecStalk z) O.ι) n
    obtain ⟨V, hV, hzV, hk⟩ := wc_zmod_wlocal_closed_point_continuity haff hc hu O.ι hqc hqs n j
      z hzc Dz hDz h (h0 z hzc Dz hDz)
    exact ⟨V, hV, hxz.mem_open hV.isOpen hzV, (hK _).mpr hk⟩
  choose V hV hxV hk using hcov
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover V (fun x => (hV x).isOpen)
    (fun x _ => Set.mem_iUnion.2 ⟨x, hxV x⟩)
  obtain ⟨e, he⟩ : ∃ e : W₀ → C(↥O.toScheme, ULift.{u+1} (ZMod n)), ∀ x,
      e x = (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) (hV x)).toContinuousMap.comp
        O.ι.base.hom := ⟨_, fun _ => rfl⟩
  have hke : ∀ x, K (e x) := fun x => by rw [he]; exact hk x
  have hep : ∀ x (p : ↥O.toScheme), (e x) p = (V x).indicator 1 (O.ι.base.hom p) := by
    intro x p
    rw [he]
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) (hV x)) (O.ι.base.hom p) = _
    rw [LocallyConstant.coe_charFn]
  have hind : ∀ s : Finset W₀, K (1 - ∏ x ∈ s, (1 - e x)) := by
    intro s
    induction s using Finset.induction_on with
    | empty => rw [Finset.prod_empty, sub_self]; exact K0
    | insert a s has ih =>
      rw [Finset.prod_insert has]
      have hr : (1 : C(↥O.toScheme, ULift.{u+1} (ZMod n))) - (1 - e a) * ∏ x ∈ s, (1 - e x) =
          (1 - ∏ x ∈ s, (1 - e x)) + (∏ x ∈ s, (1 - e x)) * e a := by ring
      rw [hr]
      exact Kadd _ _ ih (Kmul _ _ (hke a))
  have hprod : ∏ x ∈ t, (1 - e x) = 0 := by
    apply ContinuousMap.ext
    intro p
    rw [ContinuousMap.prod_apply]
    obtain ⟨x, hxt, hpx⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ (O.ι.base.hom p)))
    rw [Finset.prod_eq_zero hxt]
    · rfl
    · rw [ContinuousMap.sub_apply, ContinuousMap.one_apply, hep, Set.indicator_of_mem hpx,
        Pi.one_apply, sub_self]
  have h1 := hind t
  rw [hprod, sub_zero, hK, hone] at h1
  rw [Abelian.Ext.mk₀_id_comp] at h1
  exact h1

theorem wc_qcqs_ladic_local_separation (O : Scheme.{u}) [CompactSpace O] [QuasiSeparatedSpace O]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ) (hq : 1 ≤ q) {ι : Type u} (U : ι → Scheme.{u})
    (g : ∀ a, U a ⟶ O) [∀ a, CompactSpace (U a)] [∀ a, QuasiSeparatedSpace (U a)]
    (hloc : ∀ a (y : wcIntExt (U a) ℓ q), ℓ • y = 0 → y = 0)
    (hmod : ∀ k : ℕ, 1 ≤ k → ∀ h : wcZModProEtExt O (ℓ ^ k) q,
      (∀ a (D : wcZModPullData (g a) (ℓ ^ k)), wcZModPullCanonical D → wcZModPull D q h = 0) →
        h = 0)
    (hlim : @wcLim1Zero (fun k => wcZModProEtExt O (ℓ ^ k) (q - 1)) (fun _ => inferInstance)
      (fun k => wcIntRedTau O ℓ k (q - 1)))
    (α : wcHM O ℓ q)
    (hα : ∀ a (D : wcHMPullData (g a) ℓ), wcHMPullCanonical D → wcHMPull D q α = 0) :
    α = 0 :=
by
  classical

  obtain ⟨EO, hEO⟩ := wc_int_rat_data_exists O ℓ
  obtain ⟨N, y, hy⟩ := (wc_int_rat_rationalization O ℓ EO hEO q).1 α
  have hy' : wcIntRho EO q y = (ℓ ^ N : ℕ) • α := by
    rw [← hy, (wc_hmScalar_laws O ℓ q).2.2.2 (ℓ ^ N) α, Nat.cast_pow]

  have hlocal : ∀ a (DΛ : wcIntPullData (g a) ℓ), wcIntPullCanonical DΛ →
      wcIntPull DΛ q y = 0 := by
    intro a DΛ hDΛ
    obtain ⟨D, hD⟩ := wc_hm_pull_data_exists (g a) ℓ
    obtain ⟨Ea, hEa⟩ := wc_int_rat_data_exists (U a) ℓ
    have h0 : wcIntRho Ea q (wcIntPull DΛ q y) = 0 := by
      rw [wc_int_rat_pull_compat ℓ (g a) D hD DΛ hDΛ EO hEO Ea hEa q y, hy', map_nsmul,
        hα a D hD, smul_zero]
    obtain ⟨s, hs⟩ := (wc_int_rat_rationalization (U a) ℓ Ea hEa q).2 _ h0
    have T : ∀ s : ℕ, ∀ b : wcIntExt (U a) ℓ q, (ℓ ^ s : ℕ) • b = 0 → b = 0 := by
      intro s
      induction s with
      | zero => intro b hb; simpa using hb
      | succ s ih =>
        intro b hb
        apply hloc a b
        apply ih
        rw [smul_smul, ← pow_succ]
        exact hb
    exact T s _ hs

  obtain ⟨hTrO, htO⟩ := wc_int_red_transfer O ℓ
  have hred : ∀ k, 1 ≤ k → wcIntRed O ℓ k q y = 0 := by
    intro k hk
    apply hmod k hk
    intro a D hD
    obtain ⟨hTra, hta⟩ := wc_int_red_transfer (U a) ℓ
    obtain ⟨DΛ, hDΛ⟩ := wc_int_pull_data_exists (g a) ℓ
    let Dch : ∀ k' : ℕ, wcZModPullData (g a) (ℓ ^ k') :=
      fun k' => Classical.choose (wc_zmod_pull_data_exists (g a) (ℓ ^ k'))
    let Dk : ∀ k' : ℕ, wcZModPullData (g a) (ℓ ^ k') := Function.update Dch k D
    have hDk : ∀ k', wcZModPullCanonical (Dk k') := by
      intro k'
      by_cases h : k' = k
      · subst h
        simp only [Dk, Function.update_self]
        exact hD
      · simp only [Dk, Function.update_of_ne h]
        exact Classical.choose_spec (wc_zmod_pull_data_exists (g a) (ℓ ^ k'))
    have hν := fun k' => wc_int_zmod_pull_restrict_iso ℓ (g a) k' DΛ hDΛ (Dk k') (hDk k')
    have hc := (wc_int_red_pull_compat ℓ (g a) DΛ Dk hTrO htO hTra hta hν q).1 k y
    have hDkk : Dk k = D := Function.update_self k D Dch
    rw [hlocal a DΛ hDΛ, map_zero, hDkk] at hc
    exact hc.symm

  have hy0 : y = 0 := (wc_int_red_milnor O ℓ hTrO htO q).2.2.1 hlim y hred

  have hc0 : wcHMScalar O ℓ q ((ℓ : ℚ_[ℓ]) ^ N) α = 0 := by rw [hy, hy0, map_zero]
  have hne : ((ℓ : ℚ_[ℓ]) ^ N) ≠ 0 :=
    pow_ne_zero N (Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero)
  obtain ⟨hmul, hone, -, -⟩ := wc_hmScalar_laws O ℓ q
  calc α = wcHMScalar O ℓ q 1 α := (hone α).symm
    _ = wcHMScalar O ℓ q (((ℓ : ℚ_[ℓ]) ^ N) * ((ℓ : ℚ_[ℓ]) ^ N)⁻¹) α := by
        rw [mul_inv_cancel₀ hne]
    _ = wcHMScalar O ℓ q (((ℓ : ℚ_[ℓ]) ^ N)⁻¹) (wcHMScalar O ℓ q ((ℓ : ℚ_[ℓ]) ^ N) α) :=
        (hmul _ _ α).symm
    _ = 0 := by rw [hc0, map_zero]

theorem wc_int_unitRestrict_hom_lift (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) :
    ∀ χ : wcIntUnit S ℓ ⟶ wcIntResUnit S ℓ k, ∃ ψ : wcIntUnit S ℓ ⟶ wcIntUnit S ℓ,
      ψ ≫ wcUnitRestrict (wcIntZModRingSheafMap S ℓ k) = χ :=
by
  intro χ
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero⟩

  have hu1 : ∀ W : (S.ProEt)ᵒᵖ,
      ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app W).hom
        (1 : (wcIntRingSheaf S ℓ).obj.obj W) = (1 : (wcZModRingSheaf S (ℓ ^ k)).obj.obj W) := by
    intro W
    have h := SheafOfModules.unitHomEquiv_apply_coe (wcIntResUnit S ℓ k)
      (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)) W
    unfold wcUnitRestrict at h
    rw [Equiv.apply_symm_apply] at h
    exact h.symm

  have hlin : ∀ (W : (S.ProEt)ᵒᵖ) (r : (wcIntRingSheaf S ℓ).obj.obj W),
      ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app W).hom r =
        ((wcIntZModRingSheafMap S ℓ k).hom.app W).hom r := by
    intro W r
    have e1 := ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app W).hom.map_smul r
      (1 : (wcIntRingSheaf S ℓ).obj.obj W)
    have eA := congrArg (fun z : (wcIntRingSheaf S ℓ).obj.obj W =>
      ((wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)).val.app W).hom z) (mul_one r).symm
    have eC := congrArg (fun m => r • m) (hu1 W)
    exact ((eA.trans e1).trans eC).trans (mul_one (((wcIntZModRingSheafMap S ℓ k).hom.app W).hom r))

  let t := (wcIntResUnit S ℓ k).unitHomEquiv χ
  let tf : ∀ W : (S.ProEt)ᵒᵖ, C(↥(Opposite.unop W).left, ULift.{u+1} (ZMod (ℓ ^ k))) :=
    fun W => t.1 W

  let σc : C(ULift.{u+1} (ZMod (ℓ ^ k)), ULift.{u+1} ℤ_[ℓ]) :=
    ⟨fun b => ULift.up (((b.down).val : ℕ) : ℤ_[ℓ]), continuous_of_discreteTopology⟩
  let s : ∀ W : (S.ProEt)ᵒᵖ, (wcIntUnit S ℓ).val.obj W := fun W =>
    (σc.comp (tf W) : C(↥(Opposite.unop W).left, ULift.{u+1} ℤ_[ℓ]))
  have hs : ∀ ⦃X Y : (S.ProEt)ᵒᵖ⦄ (f : X ⟶ Y),
      ((wcIntUnit S ℓ).val.map f).hom (s X) = s Y := by
    intro X Y f
    have h1 := PresheafOfModules.sections_property t f
    have h2 := congrArg
      (fun z : C(↥(Opposite.unop Y).left, ULift.{u+1} (ZMod (ℓ ^ k))) => σc.comp z) h1
    exact h2

  have hred : ∀ W : (S.ProEt)ᵒᵖ,
      ((wcIntZModRingSheafMap S ℓ k).hom.app W).hom (s W) = tf W := by
    intro W
    change (_ : C(↥(Opposite.unop W).left, ULift.{u+1} (ZMod (ℓ ^ k)))) = tf W
    apply ContinuousMap.ext
    intro x
    apply ULift.ext
    change PadicInt.toZModPow k ((((tf W) x).down.val : ℕ) : ℤ_[ℓ]) = ((tf W) x).down
    rw [map_natCast, ZMod.natCast_zmod_val]

  refine ⟨(wcIntUnit S ℓ).unitHomEquiv.symm (PresheafOfModules.sectionsMk s hs), ?_⟩
  apply (wcIntResUnit S ℓ k).unitHomEquiv.injective
  rw [SheafOfModules.unitHomEquiv_comp_apply, Equiv.apply_symm_apply]
  apply PresheafOfModules.sections_ext
  intro W
  rw [PresheafOfModules.sectionsMap_coe, PresheafOfModules.sectionsMk_coe]
  exact (hlin W (s W)).trans (hred W)

theorem wc_int_tors_ext_vanish_of_et_qcsep (S : Scheme.{u}) [CompactSpace S]
    [IsSeparated (Limits.terminal.from S)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m j : ℕ)
    (h : Subsingleton (wcEtCoh S (ℓ ^ m) j)) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    ∀ x : Abelian.Ext (wcIntUnit S ℓ) (wcIntTors S ℓ m) j, x = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  intro x
  haveI hc : CompactSpace (Scheme.ProEt.mk (𝟙 S)).left := ‹CompactSpace S›
  haveI hs : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk (𝟙 S)).left) :=
    ‹IsSeparated (Limits.terminal.from S)›
  have h0 := wc_proet_free_zmod_ext_vanish_of_et_qcsep S (Scheme.ProEt.mk (𝟙 S)) (ℓ ^ m) j h
  obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod S ℓ m
  have hmid : ∀ y : Abelian.Ext (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)))
      ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntTors S ℓ m)) j,
      y = 0 := by
    intro y
    calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id y).symm
      _ = y.comp (Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (add_zero _) := by rw [Iso.hom_inv_id]
      _ = y.comp ((Abelian.Ext.mk₀ e.hom).comp (Abelian.Ext.mk₀ e.inv) (add_zero 0))
            (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
      _ = (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv)
            (add_zero _) := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero _) (by omega)).symm
      _ = 0 := by rw [h0 (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)), Abelian.Ext.zero_comp]
  obtain ⟨E⟩ := wc_int_unit_ext_free_equiv S ℓ (wcIntTors S ℓ m) j
  apply E.injective
  rw [hmid (E x), hmid (E 0)]

theorem wc_wcontr_punct_stalk_geom (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (O : V.left.Opens)
    (hO : (O : Set ↥V.left) = (Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ)
    (z : V.left) (hz : IsClosed ({z} : Set V.left)) :
    CompactSpace ↥(Limits.pullback (V.left.fromSpecStalk z) O.ι : Scheme.{u}) ∧
      IsSeparated (Limits.terminal.from (Limits.pullback (V.left.fromSpecStalk z) O.ι : Scheme.{u})) ∧
      ∀ k : ℕ, 1 ≤ k → k + 2 ≤ 2 * r →
        Subsingleton (wcEtCoh (Limits.pullback (V.left.fromSpecStalk z) O.ι) ℓ k) :=
by
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : HenselianLocalRing (V.left.presheaf.stalk z) := (h5 z hz).1
  haveI : IsSepClosed (IsLocalRing.ResidueField (V.left.presheaf.stalk z)) := (h5 z hz).2
  haveI : WeaklyEtale (V.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale V.left z
  haveI : WeaklyEtale V.hom := V.prop
  have hc : WeaklyEtale (V.left.fromSpecStalk z ≫ V.hom) := inferInstance
  obtain ⟨V', hV'⟩ : ∃ V' : Y.Opens, (V' : Set Y) = (Set.range i)ᶜ :=
    ⟨⟨_, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  have hOeq : V.hom ⁻¹ᵁ V' = O := TopologicalSpace.Opens.ext (by
    rw [Scheme.Hom.coe_preimage, hV', Set.preimage_compl, ← Scheme.Pullback.range_fst, hO])
  subst hOeq
  have hP : IsPullback
      (Limits.pullback.snd (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι ≫ (V.hom ∣_ V'))
      (Limits.pullback.fst (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι) V'.ι
      (V.left.fromSpecStalk z ≫ V.hom) :=
    (IsPullback.of_hasPullback (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι).flip.paste_horiz
      (isPullback_morphismRestrict V.hom V')
  haveI : QuasiCompact V'.ι := inferInstance
  haveI : QuasiCompact (Limits.pullback.fst (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hP inferInstance
  haveI : IsOpenImmersion (Limits.pullback.fst (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι) :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hP inferInstance
  refine ⟨QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.fst (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι), ?_, ?_⟩
  · have e : Limits.terminal.from (Limits.pullback (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι) =
        Limits.pullback.fst (V.left.fromSpecStalk z) (V.hom ⁻¹ᵁ V').ι ≫
          Limits.terminal.from (Spec (V.left.presheaf.stalk z)) := Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance
  · intro k hk1 hk2
    exact wc_smooth_pair_compl_strict_stalk_et_low_vanish K pY n m i ℓ hℓ V' hV'
      (V.left.presheaf.stalk z) (V.left.fromSpecStalk z ≫ V.hom) hc _ _ hP k hk1 (by omega)

theorem wc_wcontr_punct_stalk_int_torsion_free (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (hr : 1 ≤ r) (O : V.left.Opens)
    (hO : (O : Set ↥V.left) = (Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ)
    (z : V.left) (hz : IsClosed ({z} : Set V.left)) :
    ∀ y : wcIntExt (Limits.pullback (V.left.fromSpecStalk z) O.ι) ℓ (2 * r - 1),
      ℓ • y = 0 → y = 0 :=
by
  obtain ⟨hUc, hUs, hUet⟩ := wc_wcontr_punct_stalk_geom K pY n m r hmr i ℓ hℓ V
    h1 h2 h3 h4 h5 O hO z hz
  have core : ∀ (U : Scheme.{u}), CompactSpace U → IsSeparated (Limits.terminal.from U) →
      (∀ k : ℕ, 1 ≤ k → k + 2 ≤ 2 * r → Subsingleton (wcEtCoh U ℓ k)) →
      ∀ y : wcIntExt U ℓ (2 * r - 1), ℓ • y = 0 → y = 0 := by
    intro U hUc' hUs' hUet' y hy
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf U ℓ)) := HasExt.standard _
    have hmk : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf U ℓ)} (f : A ⟶ B) (c : ℕ),
        Abelian.Ext.mk₀ (c • f) = c • Abelian.Ext.mk₀ f := by
      intro A B f c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
    have hR' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf U ℓ)} {p q s : ℕ}
        (a : Abelian.Ext A B p) (b : Abelian.Ext B C q) (h : p + q = s) (c : ℕ),
        a.comp (c • b) h = c • a.comp b h := by
      intro A B C p q s a b h c
      induction c with
      | zero => rw [zero_nsmul, zero_nsmul]; exact Abelian.Ext.comp_zero _ _ _ _ _
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
    haveI hmono := wc_int_unit_pow_mono U ℓ 1
    have hS₁ : (ShortComplex.mk ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))
        (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ)))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
    have hy' : y.comp (Abelian.Ext.mk₀ ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))) (add_zero _) = 0 := by
      rw [hmk, hR', Abelian.Ext.comp_mk₀_id, pow_one]
      exact hy
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS₁ y hy'
      (n₀ := 2 * r - 2) (by omega)
    have hfac : ∃ x₂ : Abelian.Ext (wcIntUnit U ℓ) (wcIntUnit U ℓ) (2 * r - 2),
        x₂.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))))
          (add_zero _) = x₃ := by
      rcases Nat.lt_or_ge r 2 with hr1 | hr2
      · have key1 : ∀ (N : ℕ), N = 0 →
            ∀ x : Abelian.Ext (wcIntUnit U ℓ)
              (Limits.cokernel ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))) N,
            ∃ x₂ : Abelian.Ext (wcIntUnit U ℓ) (wcIntUnit U ℓ) N,
              x₂.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))))
                (add_zero N) = x := by
          intro N hN x
          subst hN
          obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
          obtain ⟨w, ⟨hq⟩⟩ := wc_int_unitRestrict_tors_cokernel U ℓ 1
          let e := (Limits.cokernelIsCokernel ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))).coconePointUniqueUpToIso hq
          have he : Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ)) ≫ e.hom =
              wcUnitRestrict (wcIntZModRingSheafMap U ℓ 1) := by
            have he0 := Limits.IsColimit.comp_coconePointUniqueUpToIso_hom
              (Limits.cokernelIsCokernel ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ))) hq
              Limits.WalkingParallelPair.one
            first
              | exact he0
              | simpa [Limits.Cofork.ofπ, Limits.CokernelCofork.ofπ] using he0
          obtain ⟨ψ, hψ⟩ := wc_int_unitRestrict_hom_lift U ℓ 1 (φ ≫ e.hom)
          have hψπ : ψ ≫ Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit U ℓ)) = φ := by
            rw [← cancel_mono e.hom, Category.assoc, he, hψ]
          exact ⟨Abelian.Ext.mk₀ ψ, by rw [Abelian.Ext.mk₀_comp_mk₀, hψπ]⟩
        exact key1 (2 * r - 2) (by omega) x₃
      · haveI := hUc'
        haveI := hUs'
        have h10 := hUet' (2 * r - 2) (by omega) (by omega)
        have hx0 : x₃ = 0 := wc_int_tors_ext_vanish_of_et_qcsep U ℓ 1 (2 * r - 2)
          (by rw [pow_one]; exact h10) x₃
        exact ⟨0, by rw [Abelian.Ext.zero_comp, hx0]⟩
    obtain ⟨x₂, hx₂⟩ := hfac
    rw [← hx₃, ← hx₂, Abelian.Ext.comp_assoc x₂ _ _ (add_zero _) (zero_add 1) (by omega),
      hS₁.comp_extClass, Abelian.Ext.comp_zero]
  exact core _ hUc hUs hUet

theorem wc_wcontr_punct_qcqs (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (O : V.left.Opens)
    (hO : (O : Set ↥V.left) = (Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ) :
    IsCompact (O : Set ↥V.left) ∧ CompactSpace O.toScheme ∧ QuasiSeparatedSpace O.toScheme ∧
      ∀ z : V.left,
        CompactSpace ↥(Limits.pullback (V.left.fromSpecStalk z) O.ι : Scheme.{u}) ∧
        QuasiSeparatedSpace ↥(Limits.pullback (V.left.fromSpecStalk z) O.ι : Scheme.{u}) :=
by
  haveI : IsAffine V.left := h1
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated pY
  let f : V.left ⟶ Y := V.hom
  haveI : QuasiCompact f := quasiCompact_of_compactSpace f
  have hW : IsOpen (Set.range ⇑i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
  have hWc : IsCompact (Set.range ⇑i)ᶜ := TopologicalSpace.NoetherianSpace.isCompact _
  have hOc : IsCompact (O : Set ↥V.left) := by
    rw [hO, Scheme.Pullback.range_fst, ← Set.preimage_compl]
    exact QuasiCompact.isCompact_preimage (f := f) _ hW hWc
  haveI : CompactSpace O.toScheme := isCompact_iff_compactSpace.mp hOc
  haveI : QuasiSeparatedSpace O.toScheme := quasiSeparatedSpace_of_quasiSeparated O.ι
  haveI : QuasiCompact O.ι := quasiCompact_of_compactSpace O.ι
  refine ⟨hOc, inferInstance, inferInstance, fun z => ⟨?_, ?_⟩⟩
  · exact QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.fst (V.left.fromSpecStalk z) O.ι)
  · exact quasiSeparatedSpace_of_quasiSeparated
      (Limits.pullback.fst (V.left.fromSpecStalk z) O.ι)

theorem wc_wcontr_punct_lim1 (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (hr : 1 ≤ r) (O : V.left.Opens)
    (hO : (O : Set ↥V.left) = (Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ) :
    @wcLim1Zero (fun k => wcZModProEtExt O.toScheme (ℓ ^ k) (2 * r - 1 - 1))
      (fun _ => inferInstance) (fun k => wcIntRedTau O.toScheme ℓ k (2 * r - 1 - 1)) :=
by
  classical
  rcases Nat.lt_or_ge r 2 with hlt | hge
  ·
    obtain rfl : r = 1 := by omega

    have hGlim : ∀ (S : Scheme.{u}) (R₀ : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1})
        (K' : Type) [SmallCategory K'] [FinCategory K'],
        Limits.PreservesLimitsOfShape K' (SheafOfModules.toSheaf.{u+1} R₀) := by
      intro S R₀ K' _ _
      haveI : Limits.PreservesLimitsOfShape K'
          (SheafOfModules.forget.{u+1} R₀ ⋙ PresheafOfModules.toPresheaf.{u+1} R₀.obj) :=
        inferInstance
      haveI : Limits.PreservesLimitsOfShape K'
          (SheafOfModules.toSheaf.{u+1} R₀ ⋙
            sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
        Limits.preservesLimitsOfShape_of_natIso
          (Iso.refl _ : SheafOfModules.forget.{u+1} R₀ ⋙ PresheafOfModules.toPresheaf.{u+1} R₀.obj ≅ _)
      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
        (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    have hexact : ∀ (S : Scheme.{u}) (R R' : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1})
        (φ : R ⟶ R'),
        (SheafOfModules.restrictScalars.{u+1} φ).Additive ∧
          Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ) ∧
          Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ) := by
      intro S R R' φ
      haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) :=
        sheafOfModules_toSheaf_preservesFiniteColimits _ R
      haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R') :=
        sheafOfModules_toSheaf_preservesFiniteColimits _ R'
      haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsMonomorphisms :=
        Functor.reflectsMonomorphisms_of_faithful _
      haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsEpimorphisms :=
        Functor.reflectsEpimorphisms_of_faithful _
      haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsIsomorphisms :=
        reflectsIsomorphisms_of_reflectsMonomorphisms_of_reflectsEpimorphisms _
      let θ : SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R ≅
          SheafOfModules.toSheaf.{u+1} R' := Iso.refl _
      refine ⟨inferInstance, ⟨fun K' _ _ => ?_⟩, ⟨fun K' _ _ => ?_⟩⟩
      · haveI := hGlim S R K'
        haveI := hGlim S R' K'
        haveI : Limits.ReflectsLimitsOfShape K' (SheafOfModules.toSheaf.{u+1} R) :=
          Limits.reflectsLimitsOfShape_of_reflectsIsomorphisms
        haveI : Limits.PreservesLimitsOfShape K'
            (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
          Limits.preservesLimitsOfShape_of_natIso θ.symm
        exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
          (SheafOfModules.toSheaf.{u+1} R)
      · haveI : Limits.ReflectsColimitsOfShape K' (SheafOfModules.toSheaf.{u+1} R) :=
          Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
        haveI : Limits.PreservesColimitsOfShape K'
            (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
          Limits.preservesColimitsOfShape_of_natIso θ.symm
        exact Limits.preservesColimitsOfShape_of_reflects_of_preserves _
          (SheafOfModules.toSheaf.{u+1} R)

    have hsurjAll : ∀ (S : Scheme.{u}) (k : ℕ), Function.Surjective (wcIntRedTau S ℓ k 0) := by
      intro S
      letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
      letI hZ : ∀ N : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S N)) :=
        fun N => HasExt.standard _

      have hEnd : ∀ (N : ℕ) (e : SheafOfModules.unit (wcZModRingSheaf S N) ⟶
          SheafOfModules.unit (wcZModRingSheaf S N)),
          ∃ r0 : C(↥S, ULift.{u+1} (ZMod N)), e = wcZModFun S N r0 := by
        intro N e
        let T : S.ProEt := Scheme.ProEt.mk (𝟙 S)
        let s := SheafOfModules.unitHomEquiv _ e
        refine ⟨s.1 (Opposite.op T), ?_⟩
        apply (SheafOfModules.unitHomEquiv _).injective
        apply PresheafOfModules.sections_ext
        intro W
        let g : W.unop ⟶ T := MorphismProperty.Over.homMk W.unop.hom (Category.comp_id _) trivial
        have hg : ((SheafOfModules.unitHomEquiv _) (wcZModFun S N (s.1 (Opposite.op T)))).1 W =
            ((s.1 (Opposite.op T) : C(↥S, ULift.{u+1} (ZMod N))).comp
              (Opposite.unop W).hom.base.hom :
              C(↥((Opposite.unop W).left), ULift.{u+1} (ZMod N))) := by
          simp only [wcZModFun, Equiv.apply_symm_apply]
          rfl
        rw [hg]
        refine (PresheafOfModules.sections_property s g.op).symm.trans ?_
        rfl
      obtain ⟨hTr, ht⟩ := wc_int_red_transfer S ℓ
      have hTau : ∀ (k j : ℕ) (b : wcZModProEtExt S (ℓ ^ (k + 1)) j), wcIntRedTau S ℓ k j b =
          (AddEquiv.ofBijective (wcIntRedTr S ℓ k j) (hTr k j)).symm
            ((wcIntRedTr S ℓ (k + 1) j b).comp (Abelian.Ext.mk₀ (Classical.choose (ht k)))
              (add_zero j)) := by
        intro k j b
        rw [wcIntRedTau, dif_pos ⟨hTr k j, ht k⟩]
        rfl

      have hTr1 : ∀ k : ℕ, wcIntRedTr S ℓ k 0 (Abelian.Ext.mk₀ (𝟙 _)) =
          Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)) := by
        intro k
        have hX : wcIntResExact S ℓ k := hexact S _ _ (wcIntZModRingSheafMap S ℓ k)
        haveI := hX.1
        haveI := hX.2.1
        haveI := hX.2.2
        have hT : wcIntRedTr S ℓ k 0 (Abelian.Ext.mk₀ (𝟙 _)) =
            (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).comp
              (Abelian.Ext.mapExactFunctor
                (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k))
                (Abelian.Ext.mk₀ (𝟙 _))) (zero_add 0) := by
          rw [wcIntRedTr, dif_pos hX]
          rfl
        rw [hT, Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id,
          Abelian.Ext.mk₀_comp_mk₀, Category.comp_id]

      have hτ1 : ∀ k : ℕ, wcIntRedTau S ℓ k 0 (Abelian.Ext.mk₀ (𝟙 _)) =
          Abelian.Ext.mk₀ (𝟙 _) := by
        intro k
        rw [hTau, AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply, hTr1, hTr1,
          Abelian.Ext.mk₀_comp_mk₀, Classical.choose_spec (ht k)]
      intro k a
      obtain ⟨e₀, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 a
      obtain ⟨r₀, rfl⟩ := hEnd (ℓ ^ k) e₀
      let r₁ : C(↥S, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) :=
        ⟨fun t => ULift.up (((r₀ t).down.val : ℕ) : ZMod (ℓ ^ (k + 1))),
          continuous_uliftUp.comp ((continuous_of_discreteTopology
            (f := fun a : ZMod (ℓ ^ k) => ((a.val : ℕ) : ZMod (ℓ ^ (k + 1))))).comp
            (continuous_uliftDown.comp r₀.continuous))⟩
      have hc : ∀ t, (r₀ t).down =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (r₁ t).down := by
        intro t
        show _ = ZMod.castHom _ _ (((r₀ t).down.val : ℕ) : ZMod (ℓ ^ (k + 1)))
        rw [map_natCast, ZMod.natCast_zmod_val]
      refine ⟨Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ (k + 1)) r₁), ?_⟩
      have h3' := (wc_int_red_act S ℓ hTr ht 0).2.2 k 0 r₁ r₀ hc (Abelian.Ext.mk₀ (𝟙 _))
      rw [Abelian.Ext.mk₀_comp_mk₀, Category.comp_id, hτ1, Abelian.Ext.mk₀_comp_mk₀,
        Category.comp_id] at h3'
      exact h3'

    show @wcLim1Zero (fun k => wcZModProEtExt O.toScheme (ℓ ^ k) 0)
      (fun _ => inferInstance) (fun k => wcIntRedTau O.toScheme ℓ k 0)
    have hsurj := hsurjAll O.toScheme
    intro β
    let f : ∀ q : ℕ, wcZModProEtExt O.toScheme (ℓ ^ (q + 1)) 0 := fun q =>
      Nat.rec (motive := fun q => wcZModProEtExt O.toScheme (ℓ ^ (q + 1)) 0) 0
        (fun q fq => Function.surjInv (hsurj (q + 1)) (fq - β (q + 1))) q
    refine ⟨fun k => Nat.casesOn (motive := fun k => wcZModProEtExt O.toScheme (ℓ ^ k) 0) k 0
      (fun q => f q), fun k hk => ?_⟩
    cases k with
    | zero => omega
    | succ q =>
      show β (q + 1) = f q - wcIntRedTau O.toScheme ℓ (q + 1) 0 (f (q + 1))
      have hq : wcIntRedTau O.toScheme ℓ (q + 1) 0 (f (q + 1)) = f q - β (q + 1) :=
        Function.surjInv_eq (hsurj (q + 1)) _
      rw [hq, sub_sub_cancel]
  ·
    intro β
    refine ⟨β, fun k hk => ?_⟩
    obtain ⟨p, rfl⟩ : ∃ p, k = p + 1 := ⟨k - 1, by omega⟩
    have hj1 : 1 ≤ 2 * r - 1 - 1 := by omega
    have hj2 : 2 * r - 1 - 1 + 2 ≤ 2 * r := by omega
    have e1 := wc_smooth_pair_wcontr_compl_et_low_vanish K pY n m r hmr i ℓ hℓ V
      ⟨h1, h2, h3, h4, h5⟩ O hO _ hj1 hj2
    have e2 := wc_et_coh_zmod_prime_pow_of_prime O.toScheme ℓ (Fact.out) _ e1 p
    obtain ⟨E⟩ := wc_et_zmodext_coh_equiv O.toScheme (ℓ ^ (p + 1)) (2 * r - 1 - 1)
    haveI : Subsingleton (wcEtZModExt O.toScheme (ℓ ^ (p + 1)) (2 * r - 1 - 1)) :=
      E.subsingleton
    obtain ⟨_, hc, hqs, _⟩ := wc_wcontr_punct_qcqs K pY n m r hmr i ℓ hℓ V h1 h2 h3 h4 h5 O hO
    obtain ⟨Θ, hΘ, _⟩ := wc_zmod_et_proet_natural_comparison_all.{u} (ℓ ^ (p + 1)) (2 * r - 1 - 1)
    haveI : Subsingleton (wcZModProEtExt O.toScheme (ℓ ^ (p + 1)) (2 * r - 1 - 1)) :=
      (hΘ O.toScheme hc hqs).2.subsingleton
    exact Subsingleton.elim _ _

theorem wc_wcontr_supp_top_stalk_separation (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (H0 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      ∃ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) ∧
        Epi (wcSuppUnitMap Dz))
    (y : wcSuppExt DV (2 * r))
    (hy : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) y) (zero_add _) = 0) :
    y = 0 :=
by
  rcases Nat.eq_zero_or_pos r with hr0 | hr1
  · exact wc_wcontr_supp_top_stalk_separation_deg0 K pY n m r hmr i ℓ hℓ V h1 h2 h3 h4 h5
      DV hDV hepi H0 y hy hr0
  · have hr : 1 ≤ r := by omega
    have hjc : IsClosed (Set.range ⇑(Limits.pullback.fst V.hom i)) :=
      (Limits.pullback.fst V.hom i).isClosedEmbedding.isClosed_range
    let O : V.left.Opens := ⟨(Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ, hjc.isOpen_compl⟩
    have hO : (O : Set ↥V.left) = (Set.range ⇑(Limits.pullback.fst V.hom i))ᶜ := rfl
    obtain ⟨α, hα0, hαz⟩ := wc_wcontr_supp_top_boundary_transfer K pY n m r hmr i ℓ hℓ V
      h1 h2 h3 h4 h5 DV hDV hepi H0 hr O hO y hy
    obtain ⟨hOc, hOcs, hOqs, hUz⟩ := wc_wcontr_punct_qcqs K pY n m r hmr i ℓ hℓ V
      h1 h2 h3 h4 h5 O hO
    let ι := {z : V.left // IsClosed ({z} : Set V.left)}
    let U : ι → Scheme.{u} := fun a => Limits.pullback (V.left.fromSpecStalk a.1) O.ι
    let g : ∀ a, U a ⟶ O.toScheme := fun a => Limits.pullback.snd (V.left.fromSpecStalk a.1) O.ι
    have hUc : ∀ a, CompactSpace (U a) := fun a => (hUz a.1).1
    have hUq : ∀ a, QuasiSeparatedSpace (U a) := fun a => (hUz a.1).2
    have hlim := wc_wcontr_punct_lim1 K pY n m r hmr i ℓ hℓ V h1 h2 h3 h4 h5 hr O hO
    have hα : α = 0 := @wc_qcqs_ladic_local_separation O.toScheme hOcs hOqs ℓ _ (2 * r - 1)
      (by omega) ι U g hUc hUq
      (fun a y' hy' => wc_wcontr_punct_stalk_int_torsion_free K pY n m r hmr i ℓ hℓ V
        h1 h2 h3 h4 h5 hr O hO a.1 a.2 y' hy')
      (fun k _ h hh => wc_wlocal_open_zmod_closed_stalk_separation h1 h2 h3 O hOc (ℓ ^ k)
        (2 * r - 1) h (fun z hz Dz hDz => hh ⟨z, hz⟩ Dz hDz))
      hlim α (fun a D hD => hαz a.1 a.2 D hD)
    exact hα0 hα

theorem wc_closed_int_supp_bc_exists {X Y Y' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) [WeaklyEtale f]
    (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (DΛ : wcIntPullData f ℓ) (hDΛ : wcIntPullCanonical DΛ)
    (D' : wcHMPullData (Limits.pullback.fst f i) ℓ) (hD' : wcHMPullCanonical D')
    (hepi' : Epi (wcSuppUnitMap D')) :
    ∃ γΛ : wcIntSuppObj D' ⟶ DΛ.Φ.obj (wcIntSuppObj D),
      wcIntSuppπ D' ≫ γΛ = DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ D) :=
by
  classical
  let V : Y.ProEt := MorphismProperty.Over.mk ⊤ f ‹WeaklyEtale f›
  obtain ⟨hc, -, -⟩ := wc_lpsc_site Y V
  haveI := hc

  have hiso : Nonempty (DΛ.Φ ≅ wcIntSliceRes Y ℓ V) := by
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong V.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    let adj₀ : wcSliceFunctor Y V ⊣ wcProEtBC V.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ V.left Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ V.hom _ _ _ V.prop trivial
    have hc' : ∀ W : Y.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom V.hom :=
      fun W => rfl
    have hu : ∀ W' : V.left.ProEt, (adj₀.unit.app W').left ≫
        Limits.pullback.fst ((wcSliceFunctor Y V).obj W').hom V.hom = 𝟙 W'.left :=
      fun W' => Limits.pullback.lift_fst _ _ _
    have hj : (wcSliceFunctor Y V).IsContinuous (Scheme.ProEt.topology V.left)
        (Scheme.ProEt.topology Y) := inferInstance
    letI := DΛ.cont
    have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcIntRingSheaf Y ℓ).obj =
        DΛ.φ.hom ≫ (wcProEtBC V.hom).op.whiskerLeft
          (𝟙 (wcIntRingSheaf V.left ℓ) : wcIntRingSheaf V.left ℓ ⟶
            ((wcSliceFunctor Y V).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology Y)).obj
              (wcIntRingSheaf Y ℓ)).hom := by
      ext V' s
      obtain ⟨W⟩ := V'
      show s.comp (adj₀.counit.app W).left.base.hom = (DΛ.φ.hom.app (Opposite.op W)).hom s
      rw [hDΛ W s, hc' W]
      try rfl
    have H2 : (𝟙 (wcIntRingSheaf V.left ℓ) : wcIntRingSheaf V.left ℓ ⟶
            ((wcSliceFunctor Y V).sheafPushforwardContinuous RingCat.{u+1}
              (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology Y)).obj
              (wcIntRingSheaf Y ℓ)).hom ≫
        (wcSliceFunctor Y V).op.whiskerLeft DΛ.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj₀.unit) (wcIntRingSheaf V.left ℓ).obj =
        𝟙 (wcIntRingSheaf V.left ℓ).obj := by
      ext V' t
      obtain ⟨W'⟩ := V'
      show ((DΛ.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W'))).hom t).comp
          (adj₀.unit.app W').left.base.hom = t
      refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
        (hDΛ ((wcSliceFunctor Y V).obj W') t)).trans ?_
      have key : ∀ t : C(↥W'.left, ULift.{u+1} ℤ_[ℓ]),
          ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
            ((wcSliceFunctor Y V).obj W').hom V.hom).base.hom)
            (adj₀.unit.app W').left.base.hom = t := by
        intro t
        first
        | (rw [ContinuousMap.comp_assoc, ← TopCat.hom_comp, ← Scheme.Hom.comp_base, hu W',
            Scheme.Hom.id_base, TopCat.hom_id, ContinuousMap.comp_id])
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
        | (refine ContinuousMap.ext fun x => ?_
           change t _ = t x
           congr 1
           have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
           simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
      exact key t
    exact ⟨Adjunction.leftAdjointUniq DΛ.adj
      (@SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hj DΛ.cont adj₀ _ DΛ.φ H1 H2)⟩
  obtain ⟨θ⟩ := hiso

  have hgval : ∀ {A B : Scheme.{u}} {j : A ⟶ B} (E : wcHMPullData j ℓ), wcHMPullCanonical E →
      ∀ (W : B.ProEt) (g : (wcIntUnit B ℓ).val.obj (Opposite.op W))
        (p : ↥(Limits.pullback W.hom j)),
      (show C(↥(Limits.pullback W.hom j), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap E).val.app (Opposite.op W)).hom g) p =
      ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from g)
          (Limits.pullback.fst W.hom j p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
        wcSuppTwist (wcSuppUnitMap E) (Limits.pullback.snd W.hom j p) := by
    intro A B j E hE W g p
    let ψ := ((wcUnitRestrict (wcIntRatRingSheafMap B ℓ)).val.app (Opposite.op W)).hom
    have hψ1 : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
        ψ (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))) = 1 := by
      have e : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from (SheafOfModules.unitHomEquiv _
          (wcUnitRestrict (wcIntRatRingSheafMap B ℓ))).1 (Opposite.op W)) = 1 := by
        unfold wcUnitRestrict
        rw [Equiv.apply_symm_apply]
        rfl
      exact (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans e
    have hψ : (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from ψ g) =
        ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op W)).hom g := by
      have hs := ψ.map_smul (g : (wcIntRingSheaf B ℓ).obj.obj (Opposite.op W))
        (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))
      have e1 := (congrArg ψ (mul_one (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from g)).symm).trans hs
      refine e1.trans ?_
      show (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
          ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op W)).hom g) *
        (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from ψ (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))) = _
      rw [hψ1, mul_one]
    have e : (show C(↥(Limits.pullback W.hom j), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap E).val.app (Opposite.op W)).hom g) =
        (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from
          ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op W)).hom g).comp
            (Limits.pullback.fst W.hom j).base.hom *
          (wcSuppTwist (wcSuppUnitMap E)).comp (Limits.pullback.snd W.hom j).base.hom := by
      refine (wc_supp_hom_twist_formula E hE (wcSuppUnitMap E) W
        (show C(↥W.left, ULift.{u+1} ℚ_[ℓ]) from ψ g)).trans ?_
      rw [hψ]
    rw [e]
    rfl

  have hvan : ∀ (W : Y'.ProEt) (t : (wcIntUnit Y' ℓ).val.obj (Opposite.op W)),
      ((wcIntSuppMap D').val.app (Opposite.op W)).hom t = 0 →
      ∀ w : ↥W.left, W.hom w ∈ Set.range (Limits.pullback.fst f i) →
        (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t) w = 0 := by
    intro W t h0 w hw
    have hw' : w ∈ Set.range (Limits.pullback.fst W.hom (Limits.pullback.fst f i)) := by
      rw [Scheme.Pullback.range_fst]; exact hw
    obtain ⟨p, rfl⟩ := hw'
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D'
    have h1 := hgval D' hD' W t p
    rw [h0] at h1
    have h2 := congrArg (fun φ : C(↥(Limits.pullback f i), ULift.{u+1} ℚ_[ℓ]) =>
      φ (Limits.pullback.snd W.hom (Limits.pullback.fst f i) p)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.one_apply] at h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          (Limits.pullback.fst W.hom (Limits.pullback.fst f i) p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
        wcSuppTwist (wcSuppUnitMap D') (Limits.pullback.snd W.hom (Limits.pullback.fst f i) p) := h1
    have h3 : ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          (Limits.pullback.fst W.hom (Limits.pullback.fst f i) p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) =
          (0 : ULift.{u+1} ℚ_[ℓ]) := by
      linear_combination (-(c' (Limits.pullback.snd W.hom (Limits.pullback.fst f i) p))) * h1' -
        (ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          (Limits.pullback.fst W.hom (Limits.pullback.fst f i) p)).down : ℤ_[ℓ]) : ℚ_[ℓ])) * h2
    exact ULift.ext _ _ (PadicInt.coe_eq_zero.mp (congrArg ULift.down h3))

  have hT : ∀ y : ↥Y', f y ∈ Set.range i → y ∈ Set.range (Limits.pullback.fst f i) := by
    intro y hy
    rw [Scheme.Pullback.range_fst]
    exact hy

  have hsec : ∀ (μ' : wcIntUnit V.left ℓ ⟶ (wcIntSliceRes Y ℓ V).obj (wcIntUnit Y ℓ))
      (W : V.left.ProEt) (t : C(↥W.left, ULift.{u+1} ℤ_[ℓ])),
      ((wcIntSuppMap D').val.app (Opposite.op W)).hom t = 0 →
      (((wcIntSliceRes Y ℓ V).map (wcIntSuppMap D)).val.app (Opposite.op W)).hom
        ((μ'.val.app (Opposite.op W)).hom t) = 0 := by
    intro μ' W t h0
    have hsm1 := (μ'.val.app (Opposite.op W)).hom.map_smul t
      (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))
    have hsm2 := (((wcIntSliceRes Y ℓ V).map (wcIntSuppMap D)).val.app (Opposite.op W)).hom.map_smul t
      ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ])))
    refine ((congrArg (((wcIntSliceRes Y ℓ V).map (wcIntSuppMap D)).val.app (Opposite.op W)).hom
      ((congrArg (μ'.val.app (Opposite.op W)).hom (mul_one t).symm).trans hsm1)).trans
        hsm2).trans ?_
    have hφ : (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
        ((D.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom
          (((wcIntRatRingSheafMap Y ℓ).hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t))) =
        0 := by
      refine (hD ((wcSliceFunctor Y V).obj W) _).trans (ContinuousMap.ext fun z => ?_)
      have hz : W.hom ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z) ∈
          Set.range (Limits.pullback.fst f i) := by
        apply hT
        exact ⟨(Limits.pullback.snd ((wcSliceFunctor Y V).obj W).hom i).base z,
          (congrArg (fun φ => φ.base z)
            (Limits.pullback.condition (f := ((wcSliceFunctor Y V).obj W).hom) (g := i))).symm⟩
      have htw : (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z) = 0 :=
        hvan W t h0 _ hz
      show ULift.up ((((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from t)
          ((Limits.pullback.fst ((wcSliceFunctor Y V).obj W).hom i).base z)).down : ℤ_[ℓ]) :
            ℚ_[ℓ]) = 0
      rw [htw]
      rfl
    calc _ = (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((D.φ.hom.app (Opposite.op ((wcSliceFunctor Y V).obj W))).hom
            (((wcIntRatRingSheafMap Y ℓ).hom.app
              (Opposite.op ((wcSliceFunctor Y V).obj W))).hom t))) *
        (@id C(↥(Limits.pullback ((wcSliceFunctor Y V).obj W).hom i), ULift.{u+1} ℚ_[ℓ])
          ((((wcIntSliceRes Y ℓ V).map (wcIntSuppMap D)).val.app (Opposite.op W)).hom
            ((μ'.val.app (Opposite.op W)).hom (1 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]))))) := rfl
      _ = 0 := by rw [hφ, zero_mul]

  have gen : ∀ {G : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ) ⥤
        SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)} (θ' : DΛ.Φ ≅ G)
      {A B : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} (g : A ⟶ B)
      {Q : SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)} (κ : Q ⟶ DΛ.Φ.obj A),
      κ ≫ θ'.hom.app A ≫ G.map g = 0 → κ ≫ DΛ.Φ.map g = 0 := by
    intro G θ' A B g Q κ h
    calc κ ≫ DΛ.Φ.map g = (κ ≫ θ'.hom.app A ≫ G.map g) ≫ θ'.inv.app B := by
          rw [Category.assoc, Category.assoc, NatIso.naturality_2]
      _ = 0 := by rw [h, Limits.zero_comp]
  have hKT : Limits.kernel.ι (wcIntSuppπ D') ≫ wcIntSuppMap D' = 0 :=
    (congrArg (fun h => Limits.kernel.ι (wcIntSuppπ D') ≫ h)
      (Limits.image.fac (wcIntSuppMap D'))).symm.trans
      ((Limits.kernel.condition_assoc _ _).trans Limits.zero_comp)
  have hK1 : Limits.kernel.ι (wcIntSuppπ D') ≫ DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppMap D) = 0 := by
    rw [← Category.assoc]
    refine gen θ (wcIntSuppMap D) (Limits.kernel.ι (wcIntSuppπ D') ≫ DΛ.μ.inv) ?_
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction W using Opposite.rec with
    | op W =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom x) hKT
    change ((wcIntSuppMap D').val.app (Opposite.op W)).hom
      (((Limits.kernel.ι (wcIntSuppπ D')).val.app (Opposite.op W)).hom x) = 0 at hk
    have h1 := hsec (DΛ.μ.inv ≫ θ.hom.app (wcIntUnit Y ℓ)) W _ hk
    refine Eq.trans h1 ?_
    first
      | rfl
      | (simp only [SheafOfModules.zero_val, PresheafOfModules.zero_app, ModuleCat.hom_zero,
          LinearMap.zero_apply]; done)
      | (rw [SheafOfModules.zero_val]; rfl)
      | simp
      | exact (LinearMap.zero_apply x).symm
  haveI := DΛ.additive
  haveI := DΛ.presLim
  haveI hm : Mono (DΛ.Φ.map (Limits.image.ι (wcIntSuppMap D))) := inferInstance
  have hK : Limits.kernel.ι (wcIntSuppπ D') ≫ DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ D) = 0 := by
    apply (cancel_mono (DΛ.Φ.map (Limits.image.ι (wcIntSuppMap D)))).mp
    rw [Limits.zero_comp, Category.assoc, Category.assoc, ← Functor.map_comp, Limits.image.fac]
    exact hK1
  haveI : Epi (wcIntSuppπ D') := inferInstance
  exact ⟨Abelian.epiDesc (wcIntSuppπ D') (DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ D)) hK,
    Abelian.comp_epiDesc _ _ _⟩

theorem wc_int_supp_const_rat_compat {X S : Scheme.{u}} {i : X ⟶ S} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) (E : wcIntRatData S ℓ)
    (hE : E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap S ℓ))
    (ε : wcSuppObj D ⟶ E.L.obj (wcIntSuppObj D)) (n : ℕ)
    (θ : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) _ _ (HasExt.standard _)
      (wcIntSuppObj D) (wcIntUnit S ℓ) n) (a : ℤ_[ℓ]) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    wcIntSuppRat D E ε n (θ.comp (Abelian.Ext.mk₀
        (wcIntFun S ℓ (ContinuousMap.const _ (ULift.up a)))) (add_zero n)) =
      (wcIntSuppRat D E ε n θ).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ (a : ℚ_[ℓ]))) (add_zero n) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim

  have s1 : wcIntFun S ℓ (ContinuousMap.const _ (ULift.up a)) ≫
        wcUnitRestrict (wcIntRatRingSheafMap S ℓ) =
      wcUnitRestrict (wcIntRatRingSheafMap S ℓ) ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map
          (wcHMConst S ℓ (a : ℚ_[ℓ])) := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro V
    have hu : ∀ x, ((wcUnitRestrict (wcIntRatRingSheafMap S ℓ)).val.app V).hom x =
        ((wcIntRatRingSheafMap S ℓ).hom.app V).hom x := by
      intro x
      have h0 : ((wcUnitRestrict (wcIntRatRingSheafMap S ℓ)).val.app V).hom x =
          ((wcIntRatRingSheafMap S ℓ).hom.app V).hom x * (1 : (wcRingSheaf S ℓ).obj.obj V) := rfl
      rw [h0, mul_one]
    have hf : ((SheafOfModules.unitHomEquiv _)
        (wcIntFun S ℓ (ContinuousMap.const _ (ULift.up a)))).1 V =
        ((ContinuousMap.const _ (ULift.up a) : C(↥S, ULift.{u+1} ℤ_[ℓ])).comp
          (Opposite.unop V).hom.base.hom :
            C(↥((Opposite.unop V).left), ULift.{u+1} ℤ_[ℓ])) := by
      simp only [wcIntFun, Equiv.apply_symm_apply]
      rfl
    have hg : ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ (a : ℚ_[ℓ]))).1 V =
        (ContinuousMap.const _ (ULift.up (a : ℚ_[ℓ])) :
          C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
      simp only [wcHMConst, Equiv.apply_symm_apply]
      rfl
    have hU1 : ((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))).1 V =
        (1 : (wcRingSheaf S ℓ).obj.obj V) := by
      simp only [wcUnitRestrict, Equiv.apply_symm_apply]
      rfl
    have e2 : (((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map
        (wcHMConst S ℓ (a : ℚ_[ℓ]))).val.app V).hom
          (((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))).1 V) =
        ((SheafOfModules.unitHomEquiv _) (wcHMConst S ℓ (a : ℚ_[ℓ]))).1 V := by
      rw [hU1, SheafOfModules.unitHomEquiv_apply_coe]
      rfl
    rw [SheafOfModules.unitHomEquiv_comp_apply, SheafOfModules.unitHomEquiv_comp_apply]
    show ((wcUnitRestrict (wcIntRatRingSheafMap S ℓ)).val.app V).hom
        (((SheafOfModules.unitHomEquiv _)
          (wcIntFun S ℓ (ContinuousMap.const _ (ULift.up a)))).1 V) =
      (((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map
        (wcHMConst S ℓ (a : ℚ_[ℓ]))).val.app V).hom
          (((SheafOfModules.unitHomEquiv _) (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))).1 V)
    rw [e2]
    refine (hu _).trans (Eq.trans ?_ hg.symm)
    refine (congrArg (fun x => ((wcIntRatRingSheafMap S ℓ).hom.app V).hom x) hf).trans ?_
    exact ContinuousMap.ext (fun p => ULift.ext _ _ rfl)

  have s2 : E.L.map (wcIntFun S ℓ (ContinuousMap.const _ (ULift.up a))) ≫ E.μ.hom =
      E.μ.hom ≫ wcHMConst S ℓ (a : ℚ_[ℓ]) := by
    apply (E.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right, hE]
    exact s1

  have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (z : Abelian.Ext A B n)
      (g : B ⟶ C') (h : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ g) (add_zero n)).comp (Abelian.Ext.mk₀ h) (add_zero n) =
        z.comp (Abelian.Ext.mk₀ (g ≫ h)) (add_zero n) := by
    intro A B C' D' z g h
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  show (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor E.L
      (θ.comp (Abelian.Ext.mk₀ (wcIntFun S ℓ (ContinuousMap.const _ (ULift.up a)))) (add_zero n))).comp
      (Abelian.Ext.mk₀ E.μ.hom) (add_zero n)) (zero_add n) =
    ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor E.L θ).comp
      (Abelian.Ext.mk₀ E.μ.hom) (add_zero n)) (zero_add n)).comp
      (Abelian.Ext.mk₀ (wcHMConst S ℓ (a : ℚ_[ℓ]))) (add_zero n)
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, s2, ← e2]
  exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm

theorem wc_wcontr_int_supp_rat_up_to_pow (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV)) (E : wcIntRatData V.left ℓ)
    (hE : E.adj.homEquiv _ _ E.μ.hom = wcUnitRestrict (wcIntRatRingSheafMap V.left ℓ))
    (ε : wcSuppObj DV ⟶ E.L.obj (wcIntSuppObj DV)) (hεi : IsIso ε)
    (hε : wcSuppUnitMap DV ≫ ε = E.μ.inv ≫ E.L.map (wcIntSuppπ DV)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
      HasExt.standard _
    ∀ w : wcSuppExt DV (2 * r), ∃ (N : ℕ)
      (x : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) _ _ (HasExt.standard _)
        (wcIntSuppObj DV) (wcIntUnit V.left ℓ) (2 * r)),
      wcIntSuppRat DV E ε (2 * r) x =
        w.comp (Abelian.Ext.mk₀ (wcHMConst ((𝟭 Scheme).obj V.left) ℓ ((ℓ : ℚ_[ℓ]) ^ N)))
          (add_zero _) :=
by
  letI hΛ : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf V.left ℓ)) := HasExt.standard _
  letI hR : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _

  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim
  have hGΛC := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology V.left) (wcIntRingSheaf V.left ℓ)
  have hGRC := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology V.left) (wcRingSheaf V.left ℓ)
  haveI hρL : Limits.PreservesFiniteLimits
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ)) := by
    haveI : Limits.PreservesFiniteLimits
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ) ⋙
          SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf V.left ℓ)) :=
      inferInstanceAs
        (Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf V.left ℓ)))
    haveI : Limits.ReflectsFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf V.left ℓ)) :=
      Limits.reflectsFiniteLimits_of_reflectsIsomorphisms _
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves _
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf V.left ℓ))
  haveI hρC : Limits.PreservesFiniteColimits
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ)) := by
    haveI : Limits.PreservesFiniteColimits
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap V.left ℓ) ⋙
          SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf V.left ℓ)) :=
      inferInstanceAs
