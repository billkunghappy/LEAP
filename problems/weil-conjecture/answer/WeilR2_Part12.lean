          change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
              (MvPolynomial.X a)).topIso.inv
            ((Proj.awayToSection _ (MvPolynomial.X a))
              ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
          rw [Iso.inv_hom_id_apply]
    have e4 := e2.trans (hi _)
    rw [hιt] at e4
    have hinj : ∀ b b' : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E),
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)),
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)).topIso.inv b =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (MvPolynomial.X a)).topIso.inv b' → b = b' := by
      intro b b' h
      have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule
