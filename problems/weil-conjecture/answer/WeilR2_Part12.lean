    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
