    have hfin : ∀ j : ℕ, Finite (wcEtCoh (k ⁻¹ᵁ U).toScheme ℓ j) := by
      intro j
      rcases Nat.eq_zero_or_pos j with hj | hj
      · subst hj
        by_cases hne : Nonempty ↥(k ⁻¹ᵁ U).toScheme
        · haveI := hne
