    haveI := wc_proet_products_exact E
    obtain ⟨hcont_incl, hemb, hcont_shift, hker, hsec⟩ := wc_padic_tower_facts ℓ
    obtain ⟨hz2, hS2⟩ := wc_contSheaf_shortExact E (wcTowerIncl ℓ) hcont_incl
