  intro Y T g _ hTc hTq N hN I hI n e
  classical
  letI instT : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  obtain ⟨Θ, hbij, -⟩ := wc_etale_proet_comparison Y
    ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj I) (n + 1)
  have hb : Function.Bijective (Θ (Scheme.ProEt.mk g)) := hbij (Scheme.ProEt.mk g) hTc hTq
  suffices key : ∀ x : Abelian.Ext ((wcEtInv g).obj (wcEtUnitSheaf Y))
      ((wcEtInv g).obj ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj I)) (n + 1), x = 0 by
    obtain ⟨e', rfl⟩ := hb.2 e
    have he' : e' = 0 := key e'
    rw [he', map_zero]
  intro e'

  obtain ⟨eP⟩ := wc_etInv_unit_const g
  obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists g N
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := Dg.cont
  obtain ⟨κ₀⟩ := wc_et_pull_data_toSheaf_iso Dg
