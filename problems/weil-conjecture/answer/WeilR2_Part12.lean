        (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ k)) (k + 1)) (continuous_apply (k + 1))
        (continuous_apply (k + 1)) (wcTowerCast ℓ k) continuous_of_discreteTopology).1
      have e3 := (wc_contSheafMap_comp_sub E
        (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ k)) k)
        ((wcTowerCast ℓ k).comp (Pi.evalAddMonoidHom (fun k => ZMod (ℓ ^ k)) (k + 1)))
        (continuous_apply k)
        ((continuous_of_discreteTopology (f := ⇑(wcTowerCast ℓ k))).comp (continuous_apply (k + 1)))
