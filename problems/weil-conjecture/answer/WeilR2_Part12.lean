      linarith
    let h0 : C(↥W.left, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun z => ULift.up ⟨(ℓ : ℚ_[ℓ]) ^ n * gd z, hbd z⟩,
        continuous_uliftUp.comp ((continuous_const.mul gd.continuous).subtype_mk _)⟩
    obtain ⟨k, hk⟩ := (hZ W h0).mpr (fun z hz => by
      have hg : g0 z = 0 := (hQ W _).mp ⟨_, rfl⟩ z hz
      apply ULift.ext
      apply PadicInt.ext
      change (ℓ : ℚ_[ℓ]) ^ n * (g0 z).down = ((0 : ℤ_[ℓ]) : ℚ_[ℓ])
      rw [hg]
      simp)
    refine ⟨n, k, ?_⟩
    apply hinj ιQ hQm (Opposite.op W)
    have e1 : (ιQ.hom.app (Opposite.op W)).hom (((κ₀ n).hom.app (Opposite.op W)).hom k) =
        ((κ₀ n ≫ ιQ).hom.app (Opposite.op W)).hom k := rfl
    rw [e1, hκ₀ n]
    change ((ψ (((ℓ : ℚ_[ℓ]) ^ n)⁻¹)).hom.app (Opposite.op W)).hom
      ((ιZ.hom.app (Opposite.op W)).hom k) = _
    rw [hk]
    apply extQ
    intro z
    apply ULift.ext
    exact inv_mul_cancel_left₀ (pow_ne_zero n hℓ0) (gd z)

  have affine_sieve : ∀ (V : S.ProEt) (R : Sieve V),
      (∀ (W : S.ProEt) (f : W ⟶ V), IsAffine W.left → R.arrows f) →
      R ∈ Scheme.ProEt.topology S V := by
    intro V R hR
    have hV : WeaklyEtale V.hom := V.prop
    let W : V.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (V.left.affineCover.f i ≫ V.hom) inferInstance
    let g : ∀ i, W i ⟶ V := fun i => MorphismProperty.Over.homMk (V.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S).coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change V.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
        V.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR (W i) (g i) (show IsAffine (V.left.affineCover.X i) by infer_instance)

  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (κ : G ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc G (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T G κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc G (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc G (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit G).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit G)⟩

  have hepi : Epi (Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t))
      (Limits.Cocone.mk FQ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
        (Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t))
          (Limits.Cocone.mk FQ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W f hW
      obtain ⟨n, k, hk⟩ := hsurj V W f s hW
      refine ⟨(Limits.colimit.ι (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t)) n).hom.app
        (Opposite.op W) k, ?_⟩
      change (Limits.colimit.ι (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t)) n ≫
        Limits.colimit.desc (Functor.ofSequence (X := fun _ : ℕ => FZ) (fun _ => t))
          (Limits.Cocone.mk FQ κ)).hom.app (Opposite.op W) k = _
      rw [Limits.colimit.ι_desc]
      change (κ.app n).hom.app (Opposite.op W) k = _
      rw [hκapp n]
      exact hk
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls
  have hcol : Limits.IsColimit (Limits.Cocone.mk FQ κ) := (crit FQ _ κ hmono hepi).some

  have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (c : Limits.Cocone G), Limits.IsColimit c →
      ∀ g : wcFreeSheaf S V ⟶ c.pt, ∃ (n : ℕ) (g' : wcFreeSheaf S V ⟶ G.obj n),
        g = g' ≫ c.ι.app n :=
    fun G c hc => (proet_free_hom_seq_colimit S V G c hc).1
  have H1 : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (α : G ⟶ I),
        Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S V) c.pt (k + 1)), x = 0 := by
    intro G
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
    exact ⟨I, α, hα, fun c hc k x => proet_ext_colimit_injectives_vanish S V I hI c hc k x⟩
  obtain ⟨n, y, hy⟩ := ext_seq_colimit_lift_of_acyclic
    (wcFreeSheaf S V) H0 H1 (j + 1) _ (Limits.Cocone.mk FQ κ) hcol x
  have hy0 : y = 0 := h j y
  rw [hy, hy0, Abelian.Ext.zero_comp]

theorem wc_vanish_tower_reduction_maps (S : Scheme.{u}) (C : Set S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (FZ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιZ : FZ ⟶ (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)))
    (hZm : Mono ιZ)
    (hZ : ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ))).obj.obj (Opposite.op T)),
      (∃ k, (ιZ.hom.app (Opposite.op T)).hom k = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (FK : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιK : ∀ k, FK k ⟶ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
      (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1)))))
    (hKm : ∀ k, Mono (ιK k))
    (hK : ∀ (k : ℕ) (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1))))).obj.obj (Opposite.op T)),
      (∃ x, ((ιK k).hom.app (Opposite.op T)).hom x = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from f) z = 0) :
    ∃ (r : ∀ n, FZ ⟶ FK n) (c : ∀ n, FK (n + 1) ⟶ FK n),
      (∀ (n : ℕ) (T : S.ProEt) (x : FZ.obj.obj (Opposite.op T)) (z : T.left),
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
          ((ιK n).hom.app (Opposite.op T)).hom (((r n).hom.app (Opposite.op T)).hom x)) z).down =
        PadicInt.toZModPow (n + 1) ((show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from
          (ιZ.hom.app (Opposite.op T)).hom x) z).down) ∧
      (∀ (n : ℕ) (T : S.ProEt) (x : (FK (n + 1)).obj.obj (Opposite.op T)) (z : T.left),
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
          ((ιK n).hom.app (Opposite.op T)).hom (((c n).hom.app (Opposite.op T)).hom x)) z).down =
        wcTowerCast ℓ (n + 1) ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) from
          ((ιK (n + 1)).hom.app (Opposite.op T)).hom x) z).down) ∧
      (∀ (n : ℕ) (T : S.ProEt) (s : (FK n).obj.obj (Opposite.op T)),
        ∃ s' : (FK (n + 1)).obj.obj (Opposite.op T), ((c n).hom.app (Opposite.op T)).hom s' = s) :=
by
  classical

  have hmono : ∀ {F G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (ι : F ⟶ G), Mono ι →
      ∀ T : S.ProEt, Function.Injective (ι.hom.app (Opposite.op T)).hom := by
    intro F G ι hι T
    haveI := hι
    haveI h1 : Mono ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map ι) :=
      Functor.map_mono _ ι
    haveI h2 : Mono (ι.hom.app (Opposite.op T)) :=
      (NatTrans.mono_iff_mono_app ((sheafToPresheaf (Scheme.ProEt.topology S)
        AddCommGrpCat.{u+1}).map ι)).mp h1 (Opposite.op T)
    exact (AddCommGrpCat.mono_iff_injective _).mp h2

  have hlift : ∀ (F G B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ι : G ⟶ B),
      (∀ T : S.ProEt, Function.Injective (ι.hom.app (Opposite.op T)).hom) →
      ∀ (φ : F ⟶ B), (∀ (T : S.ProEt) (x : F.obj.obj (Opposite.op T)),
        ∃ y : G.obj.obj (Opposite.op T),
          (ι.hom.app (Opposite.op T)).hom y = (φ.hom.app (Opposite.op T)).hom x) →
      ∃ ψ : F ⟶ G, ψ ≫ ι = φ := by
    intro F G B ι hι φ him
    have hι' : ∀ U : (S.ProEt)ᵒᵖ, Function.Injective (ι.hom.app U).hom := fun U => hι U.unop
    let app : ∀ U : (S.ProEt)ᵒᵖ, F.obj.obj U → G.obj.obj U := fun U x =>
      Classical.choose (him U.unop x)
    have hspec : ∀ (U : (S.ProEt)ᵒᵖ) (x : F.obj.obj U),
        (ι.hom.app U).hom (app U x) = (φ.hom.app U).hom x := fun U x =>
      Classical.choose_spec (him U.unop x)
    let η : F.obj ⟶ G.obj :=
      { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk' (app U) (fun a b => hι' U (by
            simp only [map_add, hspec])))
        naturality := fun U V t => by
          apply AddCommGrpCat.hom_ext
          ext x
          apply hι' V
          have e1 := congrArg (fun h => AddCommGrpCat.Hom.hom h x) (φ.hom.naturality t)
          have e2 := congrArg (fun h => AddCommGrpCat.Hom.hom h (app U x)) (ι.hom.naturality t)
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at e1 e2
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
            AddMonoidHom.mk'_apply]
          rw [hspec, e1, e2, hspec] }
    refine ⟨ObjectProperty.homMk η, Sheaf.hom_ext ?_⟩
    ext U x
    exact hspec U x

  have hcont : ∀ k : ℕ, Continuous (fun x : ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) k x) := by
    intro k
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro x hx
    have hℓ : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
    refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos hℓ _, fun y hy => ?_⟩
    have h1 : ‖y - x‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
      rw [Metric.mem_ball, dist_eq_norm] at hy
      exact hy.le
    have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow (y - x) k).mp h1
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h2
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
    rw [h2]
    exact hx
  have hρ : ∀ n : ℕ, ∃ ρ : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj
        (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (n + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (n + 1)))),
      ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj
          (SheafOfModules.unit (wcIntRingSheaf S ℓ))).obj.obj (Opposite.op T)) (z : T.left),
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
          (ρ.hom.app (Opposite.op T)).hom f) z).down =
          PadicInt.toZModPow (n + 1) ((show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from f) z).down := by
    intro n
    let g : C(ULift.{u+1} ℤ_[ℓ], ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) :=
      ⟨fun a => ULift.up (PadicInt.toZModPow (n + 1) a.down),
        continuous_uliftUp.comp ((hcont (n + 1)).comp continuous_uliftDown)⟩
    refine ⟨ObjectProperty.homMk
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := fun f => g.comp f
            map_zero' := ContinuousMap.ext fun _ =>
              ULift.ext _ _ (map_zero (PadicInt.toZModPow (p := ℓ) (n + 1)))
            map_add' := fun a b => ContinuousMap.ext fun _ =>
              ULift.ext _ _ (map_add (PadicInt.toZModPow (p := ℓ) (n + 1)) _ _) }
        naturality := fun _ _ _ => rfl }, fun T f z => rfl⟩

  have hκ : ∀ n : ℕ, ∃ κ : (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (n + 1 + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (n + 1 + 1)))) ⟶
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (n + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (n + 1)))),
      ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (n + 1 + 1)))).obj
          (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (n + 1 + 1))))).obj.obj (Opposite.op T))
        (z : T.left),
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
          (κ.hom.app (Opposite.op T)).hom f) z).down =
          wcTowerCast ℓ (n + 1)
            ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) from f) z).down := by
    intro n
    let g : C(ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1))), ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) :=
      ⟨fun a => ULift.up (wcTowerCast ℓ (n + 1) a.down), continuous_of_discreteTopology⟩
    refine ⟨ObjectProperty.homMk
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := fun f => g.comp f
            map_zero' := ContinuousMap.ext fun _ =>
              ULift.ext _ _ (map_zero (wcTowerCast ℓ (n + 1)))
            map_add' := fun a b => ContinuousMap.ext fun _ =>
              ULift.ext _ _ (map_add (wcTowerCast ℓ (n + 1)) _ _) }
        naturality := fun _ _ _ => rfl }, fun T f z => rfl⟩
  choose ρ hρ' using hρ
  choose κ hκ' using hκ
  have hKi : ∀ (k : ℕ) (T : S.ProEt), Function.Injective ((ιK k).hom.app (Opposite.op T)).hom :=
    fun k T => hmono (ιK k) (hKm k) T

  have hrex : ∀ n, ∃ ψ : FZ ⟶ FK n, ψ ≫ ιK n = ιZ ≫ ρ n := fun n =>
    hlift FZ (FK n) _ (ιK n) (hKi n) (ιZ ≫ ρ n) (fun T x => by
      refine (hK n T _).mpr ?_
      intro z hz
      have h0 : (show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from (ιZ.hom.app (Opposite.op T)).hom x) z = 0 :=
        (hZ T _).mp ⟨x, rfl⟩ z hz
      have h1 := congrArg (fun a : ULift.{u+1} ℤ_[ℓ] => PadicInt.toZModPow (p := ℓ) (n + 1) a.down) h0
      apply ULift.ext
      exact (hρ' n T ((ιZ.hom.app (Opposite.op T)).hom x) z).trans (h1.trans (map_zero _)))

  have hcex : ∀ n, ∃ ψ : FK (n + 1) ⟶ FK n, ψ ≫ ιK n = ιK (n + 1) ≫ κ n := fun n =>
    hlift (FK (n + 1)) (FK n) _ (ιK n) (hKi n) (ιK (n + 1) ≫ κ n) (fun T x => by
      refine (hK n T _).mpr ?_
      intro z hz
      have h0 : (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) from
          ((ιK (n + 1)).hom.app (Opposite.op T)).hom x) z = 0 :=
        (hK (n + 1) T _).mp ⟨x, rfl⟩ z hz
      have h1 := congrArg (fun a : ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1))) =>
        wcTowerCast ℓ (n + 1) a.down) h0
      apply ULift.ext
      exact (hκ' n T (((ιK (n + 1)).hom.app (Opposite.op T)).hom x) z).trans (h1.trans (map_zero _)))
  choose r hr' using hrex
  choose c hc' using hcex

  have hrf : ∀ (n : ℕ) (T : S.ProEt) (x : FZ.obj.obj (Opposite.op T)) (z : T.left),
      ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
        ((ιK n).hom.app (Opposite.op T)).hom (((r n).hom.app (Opposite.op T)).hom x)) z).down =
      PadicInt.toZModPow (n + 1) ((show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from
        (ιZ.hom.app (Opposite.op T)).hom x) z).down := by
    intro n T x z
    have e : ((ιK n).hom.app (Opposite.op T)).hom (((r n).hom.app (Opposite.op T)).hom x) =
        ((ρ n).hom.app (Opposite.op T)).hom ((ιZ.hom.app (Opposite.op T)).hom x) :=
      congrArg (fun φ => (φ.hom.app (Opposite.op T)).hom x) (hr' n)
    exact (congrArg (fun f => ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from f) z).down)
      e).trans (hρ' n T _ z)

  have hcf : ∀ (n : ℕ) (T : S.ProEt) (x : (FK (n + 1)).obj.obj (Opposite.op T)) (z : T.left),
      ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
        ((ιK n).hom.app (Opposite.op T)).hom (((c n).hom.app (Opposite.op T)).hom x)) z).down =
      wcTowerCast ℓ (n + 1) ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) from
        ((ιK (n + 1)).hom.app (Opposite.op T)).hom x) z).down := by
    intro n T x z
    have e : ((ιK n).hom.app (Opposite.op T)).hom (((c n).hom.app (Opposite.op T)).hom x) =
        ((κ n).hom.app (Opposite.op T)).hom (((ιK (n + 1)).hom.app (Opposite.op T)).hom x) :=
      congrArg (fun φ => (φ.hom.app (Opposite.op T)).hom x) (hc' n)
    exact (congrArg (fun f => ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from f) z).down)
      e).trans (hκ' n T _ z)

  have hsu : ∀ (n : ℕ) (T : S.ProEt) (s : (FK n).obj.obj (Opposite.op T)),
      ∃ s' : (FK (n + 1)).obj.obj (Opposite.op T), ((c n).hom.app (Opposite.op T)).hom s' = s := by
    intro n T s
    have hgC : ∀ z : T.left, T.hom z ∈ C →
        (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
          ((ιK n).hom.app (Opposite.op T)).hom s) z = 0 :=
      (hK n T _).mp ⟨s, rfl⟩
    let σ : C(ULift.{u+1} (ZMod (ℓ ^ (n + 1))), ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) :=
      ⟨fun a => ULift.up ((a.down.val : ℕ) : ZMod (ℓ ^ (n + 1 + 1))), continuous_of_discreteTopology⟩
    let g' : C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) :=
      σ.comp (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
        ((ιK n).hom.app (Opposite.op T)).hom s)
    obtain ⟨s', hs'⟩ := (hK (n + 1) T g').mpr (fun z hz => by
      apply ULift.ext
      show (((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
          ((ιK n).hom.app (Opposite.op T)).hom s) z).down.val : ZMod (ℓ ^ (n + 1 + 1))) = 0
      rw [hgC z hz]
      simp)
    refine ⟨s', hKi n T ?_⟩
    show (_ : C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1))))) = _
    refine ContinuousMap.ext fun z => ?_
    apply ULift.ext
    have e3 : ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) from
        ((ιK (n + 1)).hom.app (Opposite.op T)).hom s') z).down =
        ((((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
          ((ιK n).hom.app (Opposite.op T)).hom s) z).down.val : ℕ) : ZMod (ℓ ^ (n + 1 + 1))) := by
      rw [hs']
      rfl
    have e4 : ∀ a : ZMod (ℓ ^ (n + 1)),
        wcTowerCast ℓ (n + 1) ((a.val : ℕ) : ZMod (ℓ ^ (n + 1 + 1))) = a := by
      intro a
      show (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (n + 1))) (ZMod (ℓ ^ (n + 1))))
        ((a.val : ℕ) : ZMod (ℓ ^ (n + 1 + 1))) = a
      rw [ZMod.castHom_apply, ZMod.cast_natCast (pow_dvd_pow ℓ (Nat.le_succ (n + 1))),
        ZMod.natCast_zmod_val]
    exact (hcf n T s' z).trans ((congrArg (wcTowerCast ℓ (n + 1)) e3).trans (e4 _))
  exact ⟨r, c, hrf, hcf, hsu⟩

theorem wc_vanish_tower_shortExact (S : Scheme.{u}) (C : Set S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (FZ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιZ : FZ ⟶ (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)))
    (hZm : Mono ιZ)
    (hZ : ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ))).obj.obj (Opposite.op T)),
      (∃ k, (ιZ.hom.app (Opposite.op T)).hom k = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (FK : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιK : ∀ k, FK k ⟶ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
      (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1)))))
    (hKm : ∀ k, Mono (ιK k))
    (hK : ∀ (k : ℕ) (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1))))).obj.obj (Opposite.op T)),
      (∃ x, ((ιK k).hom.app (Opposite.op T)).hom x = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from f) z = 0)
    (r : ∀ n, FZ ⟶ FK n) (c : ∀ n, FK (n + 1) ⟶ FK n)
    (hr : ∀ (n : ℕ) (T : S.ProEt) (x : FZ.obj.obj (Opposite.op T)) (z : T.left),
      ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
        ((ιK n).hom.app (Opposite.op T)).hom (((r n).hom.app (Opposite.op T)).hom x)) z).down =
      PadicInt.toZModPow (n + 1) ((show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from
        (ιZ.hom.app (Opposite.op T)).hom x) z).down)
    (hc : ∀ (n : ℕ) (T : S.ProEt) (x : (FK (n + 1)).obj.obj (Opposite.op T)) (z : T.left),
      ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
        ((ιK n).hom.app (Opposite.op T)).hom (((c n).hom.app (Opposite.op T)).hom x)) z).down =
      wcTowerCast ℓ (n + 1) ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1 + 1)))) from
        ((ιK (n + 1)).hom.app (Opposite.op T)).hom x) z).down)
    (hcs : ∀ (n : ℕ) (T : S.ProEt) (s : (FK n).obj.obj (Opposite.op T)),
      ∃ s' : (FK (n + 1)).obj.obj (Opposite.op T), ((c n).hom.app (Opposite.op T)).hom s' = s) :
    ∃ hzero : Limits.Pi.lift r ≫ Limits.Pi.lift (fun n => Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n) = 0,
      (ShortComplex.mk _ _ hzero).ShortExact :=
by
  classical

  have crit : ∀ {F G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : F ⟶ G)
      (g : G ⟶ H),
      (∀ U (x : F.obj.obj U), g.hom.app U (f.hom.app U x) = 0) →
      (∀ U, Function.Injective (f.hom.app U)) →
      (∀ U, Function.Surjective (g.hom.app U)) →
      (∀ U (x : G.obj.obj U), g.hom.app U x = 0 → ∃ y, f.hom.app U y = x) →
      ∃ hzero : f ≫ g = 0, (ShortComplex.mk f g hzero).ShortExact := by
    intro F G H f g h1 h0 h2 h3
    have hzero : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (U : S.ProEtᵒᵖ)
        (y : X.obj.obj U), (0 : X ⟶ Y).hom.app U y = 0 := by
      intro X Y U y
      rfl
    have hcomp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p : X ⟶ Y)
        (q : Y ⟶ Z) (U : S.ProEtᵒᵖ) (y : X.obj.obj U),
        (p ≫ q).hom.app U y = q.hom.app U (p.hom.app U y) := by
      intro X Y Z p q U y
      rfl
    have w : f ≫ g = 0 := by
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp, hzero, h1]
    haveI : Epi g := by
      haveI : ∀ U, Epi (g.hom.app U) := fun U => (AddCommGrpCat.epi_iff_surjective _).mpr (h2 U)
      haveI : Epi g.hom := NatTrans.epi_of_epi_app _
      exact Sheaf.Hom.epi_of_presheaf_epi _ _ _
    haveI : Mono f := by
      haveI : ∀ U, Mono (f.hom.app U) := fun U => (AddCommGrpCat.mono_iff_injective _).mpr (h0 U)
      haveI : Mono f.hom := NatTrans.mono_of_mono_app _
      exact Sheaf.Hom.mono_of_presheaf_mono _ _ _
    have fac : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (k : G ⟶ A),
        f ≫ k = 0 → {l : H ⟶ A // g ≫ l = k} := by
      intro A k hk
      have hk' : ∀ U (y : F.obj.obj U), k.hom.app U (f.hom.app U y) = 0 := by
        intro U y
        have := congrArg (fun φ => φ.hom.app U y) hk
        simp only at this
        rw [hcomp, hzero] at this
        exact this
      have hd : ∀ U (x x' : G.obj.obj U), g.hom.app U x = g.hom.app U x' →
          k.hom.app U x = k.hom.app U x' := by
        intro U x x' hxx
        obtain ⟨y, hy⟩ := h3 U (x - x') (by rw [map_sub, hxx, sub_self])
        have := hk' U y
        rw [hy, map_sub, sub_eq_zero] at this
        exact this
      let σ : ∀ U, H.obj.obj U → G.obj.obj U := fun U => Function.surjInv (h2 U)
      have hσ : ∀ U φ, g.hom.app U (σ U φ) = φ := fun U φ => Function.surjInv_eq (h2 U) φ
      let lU : ∀ U, H.obj.obj U ⟶ A.obj.obj U := fun U => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun φ => k.hom.app U (σ U φ)) (by
          intro φ ψ
          rw [← map_add]
          apply hd
          rw [map_add, hσ, hσ, hσ]))
      have hlU : ∀ U φ, lU U φ = k.hom.app U (σ U φ) := fun U φ => rfl
      let l : H ⟶ A := ObjectProperty.homMk
        { app := lU
          naturality := by
            intro U V r
            ext φ
            rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hlU, hlU,
              ← NatTrans.naturality_apply]
            apply hd
            rw [hσ, NatTrans.naturality_apply, hσ] }
      refine ⟨l, ?_⟩
      apply Sheaf.hom_ext
      ext U x
      rw [hcomp]
      change lU U (g.hom.app U x) = k.hom.app U x
      rw [hlU]
      apply hd
      rw [hσ]
    refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
    exact ShortComplex.exact_of_g_is_cokernel _ (Limits.CokernelCofork.IsColimit.ofπ' g w fac)

  have hsub : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (p q : X ⟶ Y)
      (U : S.ProEtᵒᵖ) (z : X.obj.obj U),
      (p - q).hom.app U z = p.hom.app U z - q.hom.app U z := by
    intro X Y p q U z
    have h := Sheaf.Hom.add_app (p - q) q U
    rw [sub_add_cancel] at h
    rw [h, AddCommGrpCat.hom_add_apply, add_sub_cancel_right]

  have hC1 : ∀ (U : S.ProEtᵒᵖ) (n : ℕ) (x : FZ.obj.obj U),
      (Limits.Pi.π FK n).hom.app U ((Limits.Pi.lift r).hom.app U x) = (r n).hom.app U x := by
    intro U n x
    exact congrArg (fun φ => φ.hom.app U x) (Limits.Pi.lift_comp_π r n)
  have hC2 : ∀ (U : S.ProEtᵒᵖ) (n : ℕ) (y : (∏ᶜ FK).obj.obj U),
      (Limits.Pi.π FK n).hom.app U
          ((Limits.Pi.lift (fun n => Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n)).hom.app U y) =
        (Limits.Pi.π FK n).hom.app U y - (c n).hom.app U ((Limits.Pi.π FK (n + 1)).hom.app U y) := by
    intro U n y
    have h := congrArg (fun φ => φ.hom.app U y)
      (Limits.Pi.lift_comp_π (fun n => Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n) n)
    exact h.trans (hsub _ _ U y)

  have hsec : ∀ (U : S.ProEtᵒᵖ),
      (∀ y y' : (∏ᶜ FK).obj.obj U,
        (∀ n, (Limits.Pi.π FK n).hom.app U y = (Limits.Pi.π FK n).hom.app U y') → y = y') ∧
      (∀ a : ∀ n, (FK n).obj.obj U, ∃ y : (∏ᶜ FK).obj.obj U,
        ∀ n, (Limits.Pi.π FK n).hom.app U y = a n) := by
    intro U
    have hL := Limits.isLimitOfPreserves
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation (S.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj U ⋙ forget AddCommGrpCat.{u+1})
      (Limits.productIsProduct FK)
    have hap : ∀ (n : ℕ) (y : (∏ᶜ FK).obj.obj U),
        ((Limits.Types.isLimitEquivSections hL) y).1 ⟨n⟩ = (Limits.Pi.π FK n).hom.app U y := by
      intro n y
      rw [Limits.Types.isLimitEquivSections_apply]
      rfl
    refine ⟨fun y y' h => (Limits.Types.isLimitEquivSections hL).injective
      (Subtype.ext (funext fun j => ?_)), fun a => ?_⟩
    · obtain ⟨n⟩ := j
      rw [hap, hap]
      exact h n
    · refine ⟨(Limits.Types.isLimitEquivSections hL).symm ⟨fun j => a j.as, ?_⟩, fun n => ?_⟩
      · intro j j' f
        have h : j = j' := Discrete.ext (Discrete.eq_of_hom f)
        subst h
        have hf : f = 𝟙 j := by
          first
            | exact Subsingleton.elim _ _
            | rfl
            | exact ULift.ext _ _ (PLift.ext rfl)
        rw [hf, CategoryTheory.Functor.map_id]
        first
          | rfl
          | simp
      · exact Limits.Types.isLimitEquivSections_symm_apply hL _ ⟨n⟩

  have hinjK : ∀ (k : ℕ) (T : S.ProEt), Function.Injective ((ιK k).hom.app (Opposite.op T)) := by
    intro k T
    haveI := hKm k
    exact (AddCommGrpCat.mono_iff_injective _).mp (Functor.map_mono
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation (S.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T)) (ιK k))
  have hinjZ : ∀ (T : S.ProEt), Function.Injective (ιZ.hom.app (Opposite.op T)) := by
    intro T
    haveI := hZm
    exact (AddCommGrpCat.mono_iff_injective _).mp (Functor.map_mono
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation (S.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T)) ιZ)

  have extK : ∀ (k : ℕ) (T : S.ProEt) (s s' : (FK k).obj.obj (Opposite.op T)),
      (∀ z : T.left,
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
          ((ιK k).hom.app (Opposite.op T)).hom s) z).down =
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
          ((ιK k).hom.app (Opposite.op T)).hom s') z).down) → s = s' := by
    intro k T s s' h
    apply hinjK k T
    change (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
        ((ιK k).hom.app (Opposite.op T)).hom s) =
      (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
        ((ιK k).hom.app (Opposite.op T)).hom s')
    apply ContinuousMap.ext
    intro z
    apply ULift.ext
    exact h z
  have evsub : ∀ (k : ℕ) (T : S.ProEt) (s s' : (FK k).obj.obj (Opposite.op T)) (z : T.left),
      ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
          ((ιK k).hom.app (Opposite.op T)).hom (s - s')) z).down =
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
          ((ιK k).hom.app (Opposite.op T)).hom s) z).down -
        ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
          ((ιK k).hom.app (Opposite.op T)).hom s') z).down := by
    intro k T s s' z
    rw [map_sub]
    rfl
  have evzero : ∀ (k : ℕ) (T : S.ProEt) (z : T.left),
      ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from
          ((ιK k).hom.app (Opposite.op T)).hom 0) z).down = 0 := by
    intro k T z
    rw [map_zero]
    rfl

  have hT : ∀ n : ℕ, Continuous (PadicInt.toZModPow (p := ℓ) n) := by
    intro n
    have hzero : ∀ᶠ x in nhds (0 : ℤ_[ℓ]), PadicInt.toZModPow (p := ℓ) n x = 0 := by
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ (-(n : ℤ)) := by
        apply zpow_pos
        exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
      filter_upwards [Metric.closedBall_mem_nhds (0 : ℤ_[ℓ]) hpos] with x hx
      rw [Metric.mem_closedBall, dist_zero_right] at hx
      have h1 := (PadicInt.norm_le_pow_iff_mem_span_pow x n).mp hx
      rw [← PadicInt.ker_toZModPow] at h1
      exact (RingHom.mem_ker).mp h1
    apply continuous_of_continuousAt_zero (PadicInt.toZModPow (p := ℓ) n)
    rw [ContinuousAt, map_zero, nhds_discrete (ZMod (ℓ ^ n)), Filter.tendsto_pure]
    exact hzero
  have hincl : Continuous (wcTowerIncl ℓ) := continuous_pi fun n => hT n
  have hinj : Function.Injective (wcTowerIncl ℓ) := by
    intro x y hxy
    apply PadicInt.ext_of_toZModPow.mp
    intro n
    exact congrFun hxy n
  have hemb : Topology.IsEmbedding (wcTowerIncl ℓ) := (hincl.isClosedEmbedding hinj).isEmbedding
  have hker : ∀ b : (n : ℕ) → ZMod (ℓ ^ n),
      (∀ N, b N = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ N)) (ZMod (ℓ ^ N)) (b (N + 1))) →
      ∃ a, wcTowerIncl ℓ a = b := by
    intro b hC
    have hA : ∀ n N (h : n ≤ N), ZMod.castHom (pow_dvd_pow ℓ h) (ZMod (ℓ ^ n)) (b N) = b n := by
      intro n N h
      induction N, h using Nat.le_induction with
      | base => rw [ZMod.castHom_apply, ZMod.cast_id]
      | succ N hnN ih =>
        rw [← ih, hC N]
        exact (RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow ℓ hnN)
          (pow_dvd_pow ℓ (Nat.le_succ N))) (b (N + 1))).symm
    have hB : ∀ n N, n ≤ N → PadicInt.toZModPow n (((b N).val : ℕ) : ℤ_[ℓ]) = b n := by
      intro n N h
      rw [map_natCast, ← hA n N h, ZMod.castHom_apply, ZMod.cast_eq_val]
    have hclosed : IsClosed (Set.range (wcTowerIncl ℓ)) := (isCompact_range hincl).isClosed
    have hlim : Filter.Tendsto (fun N => wcTowerIncl ℓ (((b N).val : ℕ) : ℤ_[ℓ])) Filter.atTop
        (nhds b) := by
      rw [tendsto_pi_nhds]
      intro n
      rw [nhds_discrete (ZMod (ℓ ^ n)), Filter.tendsto_pure, Filter.eventually_atTop]
      exact ⟨n, fun N hN => hB n N hN⟩
    exact hclosed.mem_of_tendsto hlim (Filter.Eventually.of_forall fun N => ⟨_, rfl⟩)
  have hlift : ∀ (X : Type u) [TopologicalSpace X] (g : ∀ n : ℕ, X → ZMod (ℓ ^ (n + 1))),
      (∀ n, Continuous (g n)) → (∀ n z, wcTowerCast ℓ (n + 1) (g (n + 1) z) = g n z) →
      ∃ a : X → ℤ_[ℓ], Continuous a ∧ ∀ n z, PadicInt.toZModPow (n + 1) (a z) = g n z := by
    intro X _ g hg hcomp
    let bf : X → (m : ℕ) → ZMod (ℓ ^ m) := fun z m =>
      Nat.casesOn (motive := fun m => ZMod (ℓ ^ m)) m 0 (fun n => g n z)
    have hbc : ∀ z N, bf z N =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ N)) (ZMod (ℓ ^ N)) (bf z (N + 1)) := by
      intro z N
      cases N with
      | zero =>
        haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
        exact Subsingleton.elim _ _
      | succ n => exact (hcomp n z).symm
    choose a ha using fun z => hker (bf z) (hbc z)
    refine ⟨a, ?_, fun n z => congrFun (ha z) (n + 1)⟩
    rw [hemb.continuous_iff]
    have e : (⇑(wcTowerIncl ℓ) ∘ a) = fun z => bf z := funext ha
    rw [e]
    apply continuous_pi
    intro m
    cases m with
    | zero => exact continuous_const
    | succ n => exact hg n

  have hfam_i : ∀ (T : S.ProEt) (n : ℕ) (x : FZ.obj.obj (Opposite.op T)),
      ((r n).hom.app (Opposite.op T)).hom x -
        ((c n).hom.app (Opposite.op T)).hom (((r (n + 1)).hom.app (Opposite.op T)).hom x) = 0 := by
    intro T n x
    apply extK n T
    intro z
    rw [evsub, hr n T x, hc n T, hr (n + 1) T x, evzero]
    show PadicInt.toZModPow (n + 1) _ - ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (n + 1)))
      (ZMod (ℓ ^ (n + 1))) (PadicInt.toZModPow (n + 1 + 1) _) = 0
    rw [ZMod.castHom_apply, PadicInt.cast_toZModPow (n + 1) (n + 1 + 1) (Nat.le_succ _), sub_self]
  have hfam_ii : ∀ (T : S.ProEt) (x : FZ.obj.obj (Opposite.op T)),
      (∀ n, ((r n).hom.app (Opposite.op T)).hom x = 0) → x = 0 := by
    intro T x hx
    apply hinjZ T
    change (show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from (ιZ.hom.app (Opposite.op T)).hom x) =
      (show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from (ιZ.hom.app (Opposite.op T)).hom 0)
    apply ContinuousMap.ext
    intro z
    apply ULift.ext
    rw [map_zero]
    apply PadicInt.ext_of_toZModPow.mp
    intro m
    cases m with
    | zero =>
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      exact Subsingleton.elim _ _
    | succ n =>
      rw [← hr n T x z, hx n, evzero]
      exact (map_zero (PadicInt.toZModPow (p := ℓ) (n + 1))).symm
  have hfam_iii : ∀ (T : S.ProEt) (b : ∀ n, (FK n).obj.obj (Opposite.op T)),
      ∃ A : ∀ n, (FK n).obj.obj (Opposite.op T),
        ∀ n, A n - ((c n).hom.app (Opposite.op T)).hom (A (n + 1)) = b n := by
    intro T b
    let A : ∀ n, (FK n).obj.obj (Opposite.op T) := fun n =>
      Nat.rec (motive := fun n => (FK n).obj.obj (Opposite.op T)) 0
        (fun n a => Classical.choose (hcs n T (a - b n))) n
    refine ⟨A, fun n => ?_⟩
    have h : ((c n).hom.app (Opposite.op T)).hom (A (n + 1)) = A n - b n :=
      Classical.choose_spec (hcs n T (A n - b n))
    rw [h, sub_sub_cancel]
  have hfam_iv : ∀ (T : S.ProEt) (y : ∀ n, (FK n).obj.obj (Opposite.op T)),
      (∀ n, y n = ((c n).hom.app (Opposite.op T)).hom (y (n + 1))) →
      ∃ x : FZ.obj.obj (Opposite.op T), ∀ n, ((r n).hom.app (Opposite.op T)).hom x = y n := by
    intro T y hy
    obtain ⟨a, hac, hred⟩ := hlift T.left
      (fun n z => ((show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
        ((ιK n).hom.app (Opposite.op T)).hom (y n)) z).down)
      (fun n => continuous_uliftDown.comp (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (n + 1)))) from
        ((ιK n).hom.app (Opposite.op T)).hom (y n)).continuous)
      (fun n z => by
        have h := hc n T (y (n + 1)) z
        rw [← hy n] at h
        exact h.symm)
    have hvan : ∀ z : T.left, T.hom z ∈ C → a z = 0 := by
      intro z hz
      apply PadicInt.ext_of_toZModPow.mp
      intro m
      cases m with
      | zero =>
        haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
        exact Subsingleton.elim _ _
      | succ n =>
        have h := (hK n T (((ιK n).hom.app (Opposite.op T)).hom (y n))).mp ⟨y n, rfl⟩ z hz
        exact (hred n z).trans ((congrArg ULift.down h).trans
          (map_zero (PadicInt.toZModPow (p := ℓ) (n + 1))).symm)
    obtain ⟨x, hx⟩ := (hZ T (⟨fun z => ULift.up (a z), continuous_uliftUp.comp hac⟩ :
      C(↥T.left, ULift.{u+1} ℤ_[ℓ]))).mpr (by
        intro z hz
        apply ULift.ext
        exact hvan z hz)
    refine ⟨x, fun n => extK n T _ _ (fun z => ?_)⟩
    rw [hr n T x z, hx]
    exact hred n z

  refine crit (Limits.Pi.lift r)
    (Limits.Pi.lift (fun n => Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n)) ?_ ?_ ?_ ?_
  · intro U x
    obtain ⟨T⟩ := U
    apply (hsec (Opposite.op T)).1
    intro n
    rw [hC2, hC1, hC1, map_zero]
    exact hfam_i T n x
  · intro U
    obtain ⟨T⟩ := U
    intro x x' hxx
    have hd : x - x' = 0 := by
      apply hfam_ii T (x - x')
      intro n
      have h : (Limits.Pi.π FK n).hom.app (Opposite.op T) ((Limits.Pi.lift r).hom.app (Opposite.op T) x) =
          (Limits.Pi.π FK n).hom.app (Opposite.op T) ((Limits.Pi.lift r).hom.app (Opposite.op T) x') := by
        rw [hxx]
      rw [hC1, hC1] at h
      rw [map_sub]
      exact sub_eq_zero.mpr h
    exact sub_eq_zero.mp hd
  · intro U
    obtain ⟨T⟩ := U
    intro w
    obtain ⟨A, hA⟩ := hfam_iii T (fun n => (Limits.Pi.π FK n).hom.app (Opposite.op T) w)
    obtain ⟨y, hy⟩ := (hsec (Opposite.op T)).2 A
    refine ⟨y, (hsec (Opposite.op T)).1 _ _ (fun n => ?_)⟩
    rw [hC2, hy, hy]
    exact hA n
  · intro U
    obtain ⟨T⟩ := U
    intro y hy0
    have hcompat : ∀ n, (Limits.Pi.π FK n).hom.app (Opposite.op T) y =
        ((c n).hom.app (Opposite.op T)).hom ((Limits.Pi.π FK (n + 1)).hom.app (Opposite.op T) y) := by
      intro n
      have h : (Limits.Pi.π FK n).hom.app (Opposite.op T)
          ((Limits.Pi.lift (fun n => Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n)).hom.app
            (Opposite.op T) y) = (Limits.Pi.π FK n).hom.app (Opposite.op T) 0 := by
        rw [hy0]
      rw [hC2, map_zero] at h
      exact sub_eq_zero.mp h
    obtain ⟨x, hx⟩ := hfam_iv T (fun n => (Limits.Pi.π FK n).hom.app (Opposite.op T) y) hcompat
    refine ⟨x, (hsec (Opposite.op T)).1 _ _ (fun n => ?_)⟩
    rw [hC1]
    exact hx n

theorem wc_proet_kernel_int_ext_vanish_of_zmod (S : Scheme.{u}) (V : S.ProEt) (C : Set S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (FZ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιZ : FZ ⟶ (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)))
    (hZm : Mono ιZ)
    (hZ : ∀ (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ))).obj.obj (Opposite.op T)),
      (∃ k, (ιZ.hom.app (Opposite.op T)).hom k = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (FK : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ιK : ∀ k, FK k ⟶ (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
      (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1)))))
    (hKm : ∀ k, Mono (ιK k))
    (hK : ∀ (k : ℕ) (T : S.ProEt) (f : ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S (ℓ ^ (k + 1)))).obj
        (SheafOfModules.unit (wcZModRingSheaf S (ℓ ^ (k + 1))))).obj.obj (Opposite.op T)),
      (∃ x, ((ιK k).hom.app (Opposite.op T)).hom x = f) ↔
        ∀ z : T.left, T.hom z ∈ C → (show C(↥T.left, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) from f) z = 0)
    (h : ∀ (k j : ℕ) (y : Abelian.Ext (wcFreeSheaf S V) (FK k) (j + 1)), y = 0) :
    ∀ (j : ℕ) (y : Abelian.Ext (wcFreeSheaf S V) FZ (j + 1)), y = 0 :=
by
  classical

  haveI := wc_proet_products_exact S

  obtain ⟨r, c, hr, hc, hcs⟩ := wc_vanish_tower_reduction_maps S C ℓ FZ ιZ hZm hZ FK ιK hKm hK
  obtain ⟨hzero, hS⟩ := wc_vanish_tower_shortExact S C ℓ FZ ιZ hZm hZ FK ιK hKm hK r c hr hc hcs

  have hT : ∀ n, Limits.Pi.lift (fun n => Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n) ≫
      Limits.Pi.π FK n = Limits.Pi.π FK n - Limits.Pi.π FK (n + 1) ≫ c n := fun n =>
    Limits.Pi.lift_comp_π _ n

  have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf S V) (∏ᶜ FK) FK (Limits.Pi.π FK)
    (Limits.productIsProduct FK) N

  have hB : ∀ (n i : ℕ), 0 < i → ∀ x : Abelian.Ext (wcFreeSheaf S V) (FK n) i, x = 0 := by
    intro n i hi x
    obtain ⟨j', rfl⟩ : ∃ j', i = j' + 1 := ⟨i - 1, by omega⟩
    exact h n j' x

  have hc0 : ∀ (n : ℕ) (y : Abelian.Ext (wcFreeSheaf S V) (FK n) 0),
      ∃ z : Abelian.Ext (wcFreeSheaf S V) (FK (n + 1)) 0,
        z.comp (Abelian.Ext.mk₀ (c n)) (add_zero 0) = y := by
    intro n y
    obtain ⟨e, hnat, -⟩ := proet_free_sheaf_hom_equiv S V
    obtain ⟨s', hs'⟩ := hcs n V (e (FK n) (Abelian.Ext.homEquiv₀ y))
    have hg : (e (FK (n + 1))).symm s' ≫ c n = Abelian.Ext.homEquiv₀ y := by
      apply (e (FK n)).injective
      rw [hnat, Equiv.apply_symm_apply]
      exact hs'
    refine ⟨Abelian.Ext.mk₀ ((e (FK (n + 1))).symm s'), ?_⟩
    rw [Abelian.Ext.mk₀_comp_mk₀, hg, Abelian.Ext.mk₀_homEquiv₀_apply]

  have hvan := wc_ext_tower_vanishing (wcFreeSheaf S V) FZ (∏ᶜ FK) FK (Limits.Pi.π FK) c _ hT
    _ hzero hS 0 (fun N => (hprod N).1) (fun N => (hprod N).2) hB hc0
  intro j y
  exact hvan (j + 1) (Nat.succ_pos j) y

theorem wc_ext_free_slice_sheaf (S : Scheme.{u}) (U : S.ProEt)
    [(wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)]
    (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (i : ℕ) :
    Nonempty (Abelian.Ext (wcFreeSheaf S U) Y i ≃
      Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ((wcLpscG S U).obj Y) i) :=
by

  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl

  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e

  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcSliceFunctor S U).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key

  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
