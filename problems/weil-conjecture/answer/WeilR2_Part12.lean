import WeilR2_Part11
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_closed_free_ext_slice_supp_transfer_noeth {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) (V : Y.ProEt)
    (P : SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ),
      (P ⟶ M) ≃ M.val.obj (Opposite.op ((wcProEtBC i).obj V)))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op ((wcProEtBC i).obj V))).hom (ev M g))
    (hadd : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (g g' : P ⟶ M),
      ev M (g + g') = ev M g + ev M g')
    (Dv : wcHMPullData V.hom ℓ) (hDv : wcHMPullCanonical Dv)
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (γ : wcSuppObj DV ⟶ Dv.Φ.obj (wcSuppObj Di))
    (hγ : wcSuppUnitMap DV ≫ γ = Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di))
    (hepi : Epi (wcSuppUnitMap DV)) (q : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
      HasExt.standard _
    ∃ (Θ : Abelian.Ext
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)
        (SheafOfModules.unit (wcRingSheaf Y ℓ)) q ≃ wcSuppExt DV q)
      (κ : (SheafOfModules.unit (wcRingSheaf Z ℓ)).val.obj (Opposite.op ((wcProEtBC i).obj V)) ≃
        C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])),
      ∀ (τ : wcSuppExt Di q)
        (a : (SheafOfModules.unit (wcRingSheaf Z ℓ)).val.obj (Opposite.op ((wcProEtBC i).obj V))),
        Θ ((Abelian.Ext.mk₀
            ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
              ((ev (SheafOfModules.unit (wcRingSheaf Z ℓ))).symm a))).comp τ (zero_add q)) =
          (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
              (wcProEtBC (Limits.pullback.fst V.hom i)) _ _ DV.cont DV.φ).map
                (wcHMFun (Limits.pullback V.hom i) ℓ (κ a)))).comp
            ((Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Di Dv q τ) (zero_add q)) (zero_add q) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((Functor.fromPUnit Y).obj V.right) ℓ)) :=
    HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _
  haveI hσ : (wcSliceToOver Y V).IsContinuous (Scheme.ProEt.topology V.left)
      ((Scheme.ProEt.topology Y).over V) := (wc_slice_over_sites_cont Y V).1
  haveI hj : (wcSliceFunctor Y V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology Y) := by
    have h := Functor.isContinuous_comp (wcSliceToOver Y V) (Over.forget V)
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology Y).over V) (Scheme.ProEt.topology Y)
    exact h
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Y ℓ V Dv hDv
  haveI := Dv.additive
  haveI := Dv.presLim
  haveI := Dv.presColim
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  haveI : EnoughInjectives
      (SheafOfModules.{u+1} (wcRingSheaf ((Functor.fromPUnit Y).obj V.right) ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  haveI := wc_proet_closed_push_isLeftAdjoint i ℓ Di hDi
  obtain ⟨Rs, ⟨adj⟩⟩ : ∃ Rs : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) ⥤
      SheafOfModules.{u+1} (wcRingSheaf Z ℓ),
      Nonempty (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ ⊣ Rs) :=
    ⟨_, ⟨Adjunction.ofIsLeftAdjoint _⟩⟩

  have hb1 := wc_closed_push_free_hom_supported i ℓ Di hDi Rs adj V P ev hnat hadd
  obtain ⟨κS, hκnat, hκinj, hκim⟩ := wc_supp_slice_hom_supported i ℓ V DV hDV
  have he : wcClosedSuppSec i ℓ
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P) V
      (ev P (𝟙 P)) :=
    ((hb1 ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)).2
      (ev P (𝟙 P))).1 ⟨𝟙 _, rfl⟩
  obtain ⟨ε, hε⟩ := (hκim
    ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)
    (ev P (𝟙 P))).2 he
  have hcomp : ∀ (T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
      (f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P ⟶ T),
      κS T (ε ≫ (wcSliceRes Y ℓ V).map f) = (f.val.app (Opposite.op V)).hom (ev P (𝟙 P)) := by
    intro T f
    rw [hκnat, hε]
  have hhom : ∀ T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), Function.Bijective
      (fun f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P
        ⟶ T => ε ≫ (wcSliceRes Y ℓ V).map f) := by
    intro T
    refine ⟨fun f f' h => ?_, fun φ => ?_⟩
    · have h' : κS T (ε ≫ (wcSliceRes Y ℓ V).map f) = κS T (ε ≫ (wcSliceRes Y ℓ V).map f') :=
        congrArg (κS T) h
      rw [hcomp, hcomp] at h'
      exact (hb1 T).1 f f' h'
    · obtain ⟨f, hf⟩ := ((hb1 T).2 (κS T φ)).2 ((hκim T (κS T φ)).1 ⟨φ, rfl⟩)
      refine ⟨f, hκinj T ?_⟩
      show κS T (ε ≫ (wcSliceRes Y ℓ V).map f) = κS T φ
      rw [hcomp, hf]

  obtain ⟨ε', hε'⟩ : ∃ ε' : wcSuppObj DV ⟶ Dv.Φ.obj
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P),
      ε' = ε ≫ θ.inv.app _ := ⟨_, rfl⟩
  have hhom' : ∀ T : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), Function.Bijective
      (fun f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P
        ⟶ T => ε' ≫ Dv.Φ.map f) := by
    intro T
    have e1 : (fun f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
          Di.cont Di.φ).obj P ⟶ T => ε' ≫ Dv.Φ.map f) =
        (fun g : wcSuppObj DV ⟶ (wcSliceRes Y ℓ V).obj T => g ≫ θ.inv.app T) ∘
          (fun f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _
            Di.cont Di.φ).obj P ⟶ T => ε ≫ (wcSliceRes Y ℓ V).map f) := by
      funext f
      simp only [Function.comp_apply, hε', Category.assoc, NatTrans.naturality]
    have hb2 : Function.Bijective
        (fun g : wcSuppObj DV ⟶ (wcSliceRes Y ℓ V).obj T => g ≫ θ.inv.app T) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun g' => g' ≫ θ.hom.app T, fun g => ?_, fun g' => ?_⟩
      · simp only [Category.assoc, Iso.inv_hom_id_app, Category.comp_id]
      · simp only [Category.assoc, Iso.hom_inv_id_app, Category.comp_id]
    rw [e1]
    exact hb2.comp (hhom T)
  have hvan' : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) [Injective I] (n : ℕ)
      (e : Abelian.Ext (wcSuppObj DV) (Dv.Φ.obj I) (n + 1)), e = 0 := by
    intro I _ n e
    haveI := wc_slice_res_preserves_injective Y ℓ V I
    haveI : Injective (Dv.Φ.obj I) := Injective.of_iso (θ.app I).symm inferInstance
    exact Abelian.Ext.eq_zero_of_injective e
  have hbij := ext_transfer_of_corep Dv.Φ
    ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)
    (wcSuppObj DV) ε' hhom' hvan' (SheafOfModules.unit (wcRingSheaf Y ℓ)) q
  have hpost : Function.Bijective (fun x : Abelian.Ext (wcSuppObj DV)
      (Dv.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ))) q =>
        x.comp (Abelian.Ext.mk₀ Dv.μ.hom) (add_zero q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun z => z.comp (Abelian.Ext.mk₀ Dv.μ.inv) (add_zero q), fun x => ?_, fun z => ?_⟩
    · show (x.comp (Abelian.Ext.mk₀ Dv.μ.hom) (add_zero q)).comp (Abelian.Ext.mk₀ Dv.μ.inv)
        (add_zero q) = x
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · show (z.comp (Abelian.Ext.mk₀ Dv.μ.inv) (add_zero q)).comp (Abelian.Ext.mk₀ Dv.μ.hom)
        (add_zero q) = z
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
  have hΘbij := hpost.comp hbij

  have hE : ∀ a : (SheafOfModules.unit (wcRingSheaf Z ℓ)).val.obj
      (Opposite.op ((wcProEtBC i).obj V)),
      (((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
        ((ev (SheafOfModules.unit (wcRingSheaf Z ℓ))).symm a)).val.app (Opposite.op V)).hom
          (ev P (𝟙 P)) = a := by
    intro a
    have h := hnat P (SheafOfModules.unit (wcRingSheaf Z ℓ))
      ((ev (SheafOfModules.unit (wcRingSheaf Z ℓ))).symm a) (𝟙 P)
    rw [Category.id_comp, Equiv.apply_symm_apply] at h
    exact h.symm
  have hpa : Function.Bijective (fun a : (SheafOfModules.unit (wcRingSheaf Z ℓ)).val.obj
      (Opposite.op ((wcProEtBC i).obj V)) =>
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
        ((ev (SheafOfModules.unit (wcRingSheaf Z ℓ))).symm a) :
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P ⟶
          wcSuppObj Di)) := by
    refine ⟨fun a a' h => ?_, fun f => ?_⟩
    · exact (hE a).symm.trans ((congrArg (fun f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcProEtBC i) _ _ Di.cont Di.φ).obj P ⟶ wcSuppObj Di =>
            (f.val.app (Opposite.op V)).hom (ev P (𝟙 P))) h).trans (hE a'))
    · exact ⟨(f.val.app (Opposite.op V)).hom (ev P (𝟙 P)), (hb1 (wcSuppObj Di)).1 _ _ (hE _)⟩
  have hA := (hhom' (wcSuppObj Di)).comp hpa

  have hv : Epi (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)) := by
    haveI := wc_supp_unit_epi_of_noetherian i ℓ Di hDi
    haveI : Dv.Φ.IsLeftAdjoint := Dv.adj.isLeftAdjoint
    haveI := Functor.preservesEpimorphisms_of_isLeftAdjoint Dv.Φ
    infer_instance
  haveI := hv
  haveI := hepi
  have h0 : Limits.kernel.ι (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)) ≫ wcSuppUnitMap DV = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    obtain ⟨W⟩ := X
    ext x
    have hk0 : ((Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op W)).hom
        (((Limits.kernel.ι (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di))).val.app
          (Opposite.op W)).hom x) = 0 :=
      congrArg (fun f => (f.val.app (Opposite.op W)).hom x)
        (Limits.kernel.condition (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)))
    have hk := wc_closed_supp_bc_unit_ker_le i ℓ Di hDi V Dv hDv DV hDV W _ hk0
    have hz : ((0 : Limits.kernel (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)) ⟶
        wcSuppObj DV).val.app (Opposite.op W)).hom x = 0 := rfl
    refine Eq.trans ?_ hz.symm
    exact hk
  have hδ := Abelian.comp_epiDesc (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)) (wcSuppUnitMap DV) h0
  have hγiso : IsIso γ := by
    refine ⟨⟨Abelian.epiDesc (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)) (wcSuppUnitMap DV) h0,
      ?_, ?_⟩⟩
    · rw [← cancel_epi (wcSuppUnitMap DV), ← Category.assoc, hγ, hδ, Category.comp_id]
    · rw [← cancel_epi (Dv.μ.inv ≫ Dv.Φ.map (wcSuppUnitMap Di)), ← Category.assoc, hδ, hγ,
        Category.comp_id]
  haveI := hγiso

  have hs4 := wc_supp_obj_fun_end_bijective (Limits.pullback.fst V.hom i) ℓ DV hDV hepi
  have hpostγ : Function.Bijective (fun φ : wcSuppObj DV ⟶ wcSuppObj DV => φ ≫ γ) := by
    refine Function.bijective_iff_has_inverse.mpr ⟨fun φ' => φ' ≫ inv γ, fun φ => ?_, fun φ' => ?_⟩
    · simp only [Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    · simp only [Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  have hB := hpostγ.comp hs4

  obtain ⟨κ, hκ⟩ : ∃ κ : (SheafOfModules.unit (wcRingSheaf Z ℓ)).val.obj
        (Opposite.op ((wcProEtBC i).obj V)) ≃ C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]),
      ∀ a, ε' ≫ Dv.Φ.map
          ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
            ((ev (SheafOfModules.unit (wcRingSheaf Z ℓ))).symm a)) =
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst V.hom i)) _ _ DV.cont DV.φ).map
            (wcHMFun (Limits.pullback V.hom i) ℓ (κ a)) ≫ γ :=
    ⟨(Equiv.ofBijective _ hA).trans (Equiv.ofBijective _ hB).symm,
      fun a => (Equiv.ofBijective_apply_symm_apply _ hB _).symm⟩
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : Abelian.Ext
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P)
        (SheafOfModules.unit (wcRingSheaf Y ℓ)) q ≃ wcSuppExt DV q,
      ∀ β, Θ β = ((Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor Dv.Φ β) (zero_add q)).comp
        (Abelian.Ext.mk₀ Dv.μ.hom) (add_zero q) :=
    ⟨Equiv.ofBijective _ hΘbij, fun β => rfl⟩
  have hfin : ∀ (β : Abelian.Ext (Dv.Φ.obj (wcSuppObj Di))
      (Dv.Φ.obj (SheafOfModules.unit (wcRingSheaf Y ℓ))) q)
      (g : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).obj P ⟶
        wcSuppObj Di) (p : wcSuppObj DV ⟶ wcSuppObj DV) (hg : ε' ≫ Dv.Φ.map g = p ≫ γ),
      ((Abelian.Ext.mk₀ ε').comp ((Abelian.Ext.mk₀ (Dv.Φ.map g)).comp β (zero_add q))
        (zero_add q)).comp (Abelian.Ext.mk₀ Dv.μ.hom) (add_zero q) =
      (Abelian.Ext.mk₀ p).comp ((Abelian.Ext.mk₀ γ).comp
        (β.comp (Abelian.Ext.mk₀ Dv.μ.hom) (add_zero q)) (zero_add q)) (zero_add q) := by
    intro β g p hg
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hg, ← Abelian.Ext.mk₀_comp_mk₀_assoc,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero]
  refine ⟨Θ, κ, fun τ a => ?_⟩
  have h1 : Abelian.Ext.mapExactFunctor Dv.Φ ((Abelian.Ext.mk₀
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
        ((ev (SheafOfModules.unit (wcRingSheaf Z ℓ))).symm a))).comp τ (zero_add q)) =
      (Abelian.Ext.mk₀ (Dv.Φ.map
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
          ((ev (SheafOfModules.unit (wcRingSheaf Z ℓ))).symm a)))).comp
        (Abelian.Ext.mapExactFunctor Dv.Φ τ) (zero_add q) := by
    first
      | (erw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]; done)
      | exact (Abelian.Ext.mapExactFunctor_comp _ _ _).trans
          (congrArg (fun x => Abelian.Ext.comp x _ (zero_add q)) (Abelian.Ext.mapExactFunctor_mk₀ _))
      | exact (Abelian.Ext.mapExactFunctor_comp _ _ _ _).trans
          (congrArg (fun x => Abelian.Ext.comp x _ (zero_add q)) (Abelian.Ext.mapExactFunctor_mk₀ _ _))
      | (simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]; done)
  have h2 := congrArg (fun x => ((Abelian.Ext.mk₀ ε').comp x (zero_add q)).comp
    (Abelian.Ext.mk₀ Dv.μ.hom) (add_zero q)) h1
  exact (hΘ _).trans (h2.trans (hfin _ _ _ (hκ a)))

theorem wc_henselian_sepClosed_transfer : (∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) → HenselianLocalRing R → HenselianLocalRing S) ∧ (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) :=
by
  refine ⟨fun R S _ _ e hR => ?_, fun K L _ _ e hK => ?_⟩
  · haveI : IsLocalRing S := e.isLocalRing
    have hmem : ∀ {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (φ : A ≃+* B) (x : A),
        φ x ∈ IsLocalRing.maximalIdeal B ↔ x ∈ IsLocalRing.maximalIdeal A := by
      intro A B _ _ _ _ φ x
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        mem_nonunits_iff, MulEquiv.isUnit_map]
    have hev : ∀ (p : Polynomial S) (a : S),
        (p.map (e.symm : S →+* R)).eval (e.symm a) = e.symm (p.eval a) := by
      intro p a
      rw [Polynomial.eval_map]
      exact Polynomial.eval₂_at_apply (e.symm : S →+* R) a
    have hround : ∀ p : Polynomial S, (p.map (e.symm : S →+* R)).map (e : R →+* S) = p := by
      intro p
      rw [Polynomial.map_map]
      have hc : (e : R →+* S).comp (e.symm : S →+* R) = RingHom.id S := by
        ext x; simp
      rw [hc, Polynomial.map_id]
    refine { toIsLocalRing := this, is_henselian := ?_ }
    intro f hf a₀ h₁ h₂
    have hgm : (f.map (e.symm : S →+* R)).Monic := hf.map _
    have hb₁ : (f.map (e.symm : S →+* R)).eval (e.symm a₀) ∈ IsLocalRing.maximalIdeal R := by
      rw [hev]
      exact (hmem e.symm _).mpr h₁
    have hb₂ : IsUnit ((Polynomial.derivative (f.map (e.symm : S →+* R))).eval (e.symm a₀)) := by
      rw [Polynomial.derivative_map, hev, MulEquiv.isUnit_map]
      exact h₂
    obtain ⟨b, hbroot, hbclose⟩ := hR.is_henselian _ hgm (e.symm a₀) hb₁ hb₂
    refine ⟨e b, ?_, ?_⟩
    · have h3 : (Polynomial.map (e : R →+* S) (f.map (e.symm : S →+* R))).eval (e b)
          = e ((f.map (e.symm : S →+* R)).eval b) := by
        rw [Polynomial.eval_map]
        exact Polynomial.eval₂_at_apply (e : R →+* S) b
      rw [hround] at h3
      show f.eval (e b) = 0
      rw [h3, hbroot.eq_zero, map_zero]
    · have h4 : e b - a₀ = e (b - e.symm a₀) := by
        rw [map_sub, RingEquiv.apply_symm_apply]
      rw [h4]
      exact (hmem e _).mpr hbclose
  · haveI := hK
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    obtain ⟨y, hy⟩ := IsSepClosed.exists_eval₂_eq_zero_of_injective (e.symm : L →+* K)
      e.symm.injective p (Polynomial.degree_pos_of_irreducible hirr).ne' hsep
    refine ⟨e y, ?_⟩
    have h5 := Polynomial.hom_eval₂ p (e.symm : L →+* K) (e : K →+* L) y
    have hc : (e : K →+* L).comp (e.symm : L →+* K) = RingHom.id L := by
      ext x; simp
    rw [hy, map_zero, hc, Polynomial.eval₂_id] at h5
    exact h5.symm

theorem wc_supp_les_open_boundary_scalar {T V : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (j : T ⟶ V) [IsClosedImmersion j] (Dj : wcHMPullData j ℓ) (hDj : wcHMPullCanonical Dj)
    (hepi : Epi (wcSuppUnitMap Dj))
    (hker : ∀ (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Dj)).val.obj (Opposite.op U))
      (W : V.ProEt) (g : W ⟶ U), IsAffine W.left →
      ∃ (n : ℕ) (W' : Fin n → V.ProEt) (e : ∀ a, W' a ⟶ W),
        (∀ a, IsAffine (W' a).left) ∧ (∀ x : ↥W.left, ∃ a, x ∈ Set.range (e a).left) ∧
        ∀ a, (∀ x : ↥(W' a).left, (W' a).hom x ∉ Set.range j) ∨
          ((Limits.kernel (wcSuppUnitMap Dj)).val.map (e a ≫ g).op).hom k = 0)
    (Wo : V.Opens) (hW : (Wo : Set ↥V) = (Set.range j)ᶜ)
    (Dw : wcHMPullData Wo.ι ℓ) (hDw : wcHMPullCanonical Dw) (n₀ n₁ : ℕ) (hn : n₀ + 1 = n₁) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
    ∃ δ : wcHM Wo.toScheme ℓ n₀ →+ wcSuppExt Dj n₁,
      (∀ θ : wcSuppExt Dj n₁, wcSuppClass Dj n₁ θ = 0 → ∃ α : wcHM Wo.toScheme ℓ n₀, δ α = θ) ∧
      (∀ x : wcHM V ℓ n₀, δ (wcHMPull Dw n₀ x) = 0) ∧
      (∀ (c : ℚ_[ℓ]) (α : wcHM Wo.toScheme ℓ n₀),
        δ (wcHMScalar Wo.toScheme ℓ n₀ c α) =
          (δ α).comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n₁)) :=
by
  classical
  letI instV : HasExt (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) := HasExt.standard _
  letI instW : HasExt (SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)) := HasExt.standard _
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim

  have hdisj : ∀ (t : ↥Wo.toScheme) (z : ↥T), Wo.ι t ≠ j z := by
    intro t z h
    have h1 : Wo.ι t ∈ (Wo : Set ↥V) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨t, rfl⟩
    rw [hW, h] at h1
    exact h1 ⟨z, rfl⟩
  have hempty : IsEmpty ↥(Limits.pullback Wo.ι j) := by
    refine ⟨fun q => hdisj ((Limits.pullback.fst Wo.ι j) q) ((Limits.pullback.snd Wo.ι j) q) ?_⟩
    have h : (Limits.pullback.fst Wo.ι j ≫ Wo.ι) q = (Limits.pullback.snd Wo.ι j ≫ j) q := by
      rw [Limits.pullback.condition]
    rwa [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h

  have hkey : Dw.μ.inv ≫ Dw.Φ.map (wcSuppUnitMap Dj) = 0 := by
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have h7 := wc_supp_pull_unit_vanish_off j Wo.ι (Limits.pullback.fst Wo.ι j)
      (Limits.pullback.snd Wo.ι j) (IsPullback.of_hasPullback Wo.ι j) ℓ Dj Dw (Opposite.unop X)
      (fun x hx => by
        obtain ⟨q, _⟩ := hx
        exact hempty.false q)
    refine Eq.trans h7 ?_
    first
      | rfl
      | simp

  obtain ⟨ε, hε⟩ : ∃ ε : SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ) ⟶
      Dw.Φ.obj (Limits.kernel (wcSuppUnitMap Dj)),
      ε ≫ Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) = Dw.μ.inv := by
    obtain ⟨ε0, hε0⟩ := Limits.KernelFork.IsLimit.lift'
      (Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcSuppUnitMap Dj)) Dw.Φ)
      Dw.μ.inv hkey
    exact ⟨ε0, hε0⟩
  haveI hmonoΦι : Mono (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj))) := inferInstance
  have h1 : ε ≫ (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) = 𝟙 _ := by
    rw [← Category.assoc, hε, Iso.inv_hom_id]
  have h2 : (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ ε = 𝟙 _ := by
    rw [← cancel_mono (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)))]
    simp only [Category.assoc, hε, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
  haveI hεiso : IsIso ε := ⟨⟨_, h1, h2⟩⟩
  let Vo : V.ProEt := Scheme.ProEt.mk Wo.ι
  haveI hVo : IsOpenImmersion Vo.hom := (inferInstance : IsOpenImmersion Wo.ι)
  haveI hG : (wcSliceFunctor V Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
      (Scheme.ProEt.topology V) := by
    haveI h1' := (wc_slice_over_sites_cont V Vo).1
    haveI h0 : (Over.forget Vo).IsContinuous ((Scheme.ProEt.topology V).over Vo)
        (Scheme.ProEt.topology V) := inferInstance
    have h3 : (wcSliceToOver V Vo ⋙ Over.forget Vo).IsContinuous (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology V) :=
      Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology V).over Vo) _
    exact h3
  have hVorange : Set.range Vo.hom = (Set.range j)ᶜ := by
    show Set.range Wo.ι = _
    rw [Scheme.Opens.range_ι, hW]
  obtain ⟨Φiso⟩ := wc_hm_pull_Phi_slice_iso V ℓ Vo Dw hDw

  have fin_covers : ∀ (U : V.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → V.ProEt)
      (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
      (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology V U := by
    intro U _ n W h hA hJ
    have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hq : ∀ i, QuasiCompact (h i).left := fun i => by
      haveI := hA i
      exact quasiCompact_of_compactSpace _
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (h i)]
        exact (W i).prop
      haveI := U.prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
  have affine_local : ∀ (U : V.ProEt) (T' : Sieve U),
      (∀ (V' : V.ProEt) (f : V' ⟶ U), IsAffine V'.left →
        T'.pullback f ∈ Scheme.ProEt.topology V V') →
      T' ∈ Scheme.ProEt.topology V U := by
    intro U T' hT
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → V.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i =>
      MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage V).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget V ⋙ Over.forget V)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T' ?_
    intro Y₀ f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
  have hcov : ∀ (U : V.ProEt) (k : (Limits.kernel (wcSuppUnitMap Dj)).val.obj (Opposite.op U))
      (R : Sieve U), (∀ (U' : V.ProEt) (a : U' ⟶ U),
        ((∀ x : ↥U'.left, U'.hom x ∉ Set.range j) ∨
          ((Limits.kernel (wcSuppUnitMap Dj)).val.map a.op).hom k = 0) → R.arrows a) →
      R ∈ Scheme.ProEt.topology V U := by
    intro U k R hR
    apply affine_local U R
    intro W' g hW'
    obtain ⟨n, W'', e, haff, hsurj, hdis⟩ := hker U k W' g hW'
    haveI : IsAffine W'.left := hW'
    refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W' n W'' e haff hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨m⟩
    exact hR _ _ (hdis m)

  have hhom : ∀ N : SheafOfModules.{u+1} (wcRingSheaf V ℓ),
      Function.Bijective (fun φ : Limits.kernel (wcSuppUnitMap Dj) ⟶ N => ε ≫ Dw.Φ.map φ) := by
    intro N
    obtain ⟨hinj, hsurj⟩ := wc_supp_kernel_open_res_bijective j Dj Vo hVorange hcov N
    have e : ∀ φ : Limits.kernel (wcSuppUnitMap Dj) ⟶ N, (wcSliceRes V ℓ Vo).map φ =
        Φiso.inv.app _ ≫ Dw.Φ.map φ ≫ Φiso.hom.app N :=
      fun φ => (NatIso.naturality_1 Φiso φ).symm
    refine ⟨fun φ₁ φ₂ h => hinj ?_, fun g => ?_⟩
    · have h' : Dw.Φ.map φ₁ = Dw.Φ.map φ₂ := (cancel_epi ε).mp h
      show (wcSliceRes V ℓ Vo).map φ₁ = (wcSliceRes V ℓ Vo).map φ₂
      rw [e, e, h']
    · obtain ⟨φ, hφ⟩ := hsurj (Φiso.inv.app _ ≫
        ((Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g) ≫ Φiso.hom.app N)
      refine ⟨φ, ?_⟩
      have hφ' : (wcSliceRes V ℓ Vo).map φ = Φiso.inv.app _ ≫
          ((Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g) ≫
            Φiso.hom.app N := hφ
      have k0 := (e φ).symm.trans hφ'
      have k : Dw.Φ.map φ =
          (Dw.Φ.map (Limits.kernel.ι (wcSuppUnitMap Dj)) ≫ Dw.μ.hom) ≫ g :=
        (cancel_mono (Φiso.hom.app N)).mp ((cancel_epi (Φiso.inv.app _)).mp k0)
      show ε ≫ Dw.Φ.map φ = g
      rw [k, ← Category.assoc, h1, Category.id_comp]
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf V ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ)) (Dw.Φ.obj I) (k + 1)),
      e = 0 := by
    intro I hI k e
    have hRI : Injective ((wcSliceRes V ℓ Vo).obj I) :=
      @wc_open_slice_res_preserves_injective V ℓ _ Vo hVo hG I hI
    haveI : Injective (Dw.Φ.obj I) := Injective.of_iso (Φiso.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective e
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf V ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology V) (wcRingSheaf V ℓ)
  have hT := ext_transfer_of_corep Dw.Φ (Limits.kernel (wcSuppUnitMap Dj))
    (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ)) ε hhom hvan
    (SheafOfModules.unit (wcRingSheaf V ℓ)) n₀
  have hP : Function.Bijective
      (fun x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Wo.toScheme ℓ))
          (Dw.Φ.obj (SheafOfModules.unit (wcRingSheaf V ℓ))) n₀ =>
        x.comp (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) := by
    refine ⟨fun x y h => ?_, fun y => ⟨y.comp (Abelian.Ext.mk₀ Dw.μ.inv) (add_zero n₀), ?_⟩⟩
    · have h' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ Dw.μ.inv) (add_zero n₀)) h
      simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at h'
      exact h'
    · simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  have h10 : 1 + n₀ = n₁ := by omega
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcSuppUnitMap Dj)) (wcSuppUnitMap Dj)
      (Limits.kernel.condition (wcSuppUnitMap Dj))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcSuppUnitMap Dj)) inferInstance hepi
  let Ψh : Abelian.Ext (Limits.kernel (wcSuppUnitMap Dj)) (SheafOfModules.unit (wcRingSheaf V ℓ)) n₀ →+
      wcHM Wo.toScheme ℓ n₀ :=
    ((Abelian.Ext.mk₀ ε).precomp _ (zero_add n₀)).comp
      (((Abelian.Ext.mk₀ Dw.μ.hom).postcomp _ (add_zero n₀)).comp (Dw.Φ.mapExtAddHom _ _ n₀))
  have hΨb : Function.Bijective Ψh := by
    show Function.Bijective _
    convert hP.comp hT using 1
    funext x
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
  let Ψe := AddEquiv.ofBijective Ψh hΨb
  have hfree : ∀ x : wcHM V ℓ n₀,
      Ψe ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap Dj))).comp x (zero_add n₀)) =
        wcHMPull Dw n₀ x := by
    intro x
    show (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Dw.Φ
        ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap Dj))).comp x (zero_add n₀))).comp
        (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) (zero_add n₀) =
      (Abelian.Ext.mk₀ Dw.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp
        (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) (zero_add n₀)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, ← hε, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero]
  let δ : wcHM Wo.toScheme ℓ n₀ →+ wcSuppExt Dj n₁ :=
    (hS.extClass.precomp (SheafOfModules.unit (wcRingSheaf V ℓ)) h10).comp
      Ψe.symm.toAddMonoidHom
  refine ⟨δ, ?_, ?_, ?_⟩
  · intro θ hθ
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
      (SheafOfModules.unit (wcRingSheaf V ℓ)) θ hθ h10
    refine ⟨Ψe x₁, ?_⟩
    show hS.extClass.comp (Ψe.symm (Ψe x₁)) h10 = θ
    rw [AddEquiv.symm_apply_apply]
    exact hx₁
  · intro x
    have hc : hS.extClass.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (wcSuppUnitMap Dj)))
        (add_zero 1) = 0 := hS.extClass_comp
    show hS.extClass.comp (Ψe.symm (wcHMPull Dw n₀ x)) h10 = 0
    rw [← hfree x, AddEquiv.symm_apply_apply, ← Abelian.Ext.comp_assoc_of_second_deg_zero, hc,
      Abelian.Ext.zero_comp]
  ·
    intro c α
    have hk : Dw.Φ.map (wcHMConst V ℓ c) ≫ Dw.μ.hom =
        Dw.μ.hom ≫ wcHMConst Wo.toScheme ℓ c := by
      rw [← wc_hm_pull_const Dw hDw c, Iso.hom_inv_id_assoc]
    have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf Wo.toScheme ℓ)}
        (z : Abelian.Ext A B n₀) (a : B ⟶ C') (b : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero n₀)).comp (Abelian.Ext.mk₀ b) (add_zero n₀) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero n₀) := by
      intro A B C' D' z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have hΨc : ∀ x : Abelian.Ext (Limits.kernel (wcSuppUnitMap Dj))
        (SheafOfModules.unit (wcRingSheaf V ℓ)) n₀,
        Ψh (x.comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n₀)) =
          (Ψh x).comp (Abelian.Ext.mk₀ (wcHMConst Wo.toScheme ℓ c)) (add_zero n₀) := by
      intro x
      have e3 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ ε)
        ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀))
        (Abelian.Ext.mk₀ (wcHMConst Wo.toScheme ℓ c)) (zero_add n₀)
      show (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Dw.Φ
          (x.comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n₀))).comp
          (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) (zero_add n₀) =
        ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp
          (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero n₀)) (zero_add n₀)).comp
          (Abelian.Ext.mk₀ (wcHMConst Wo.toScheme ℓ c)) (add_zero n₀)
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e3, e2, hk]
    have hsym : ∀ a : wcHM Wo.toScheme ℓ n₀,
        Ψe.symm (a.comp (Abelian.Ext.mk₀ (wcHMConst Wo.toScheme ℓ c)) (add_zero n₀)) =
          (Ψe.symm a).comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n₀) := by
      intro a
      have h' : Ψh (Ψe.symm a) = a := Ψe.apply_symm_apply a
      apply Ψe.injective
      rw [AddEquiv.apply_symm_apply]
      change _ = Ψh ((Ψe.symm a).comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n₀))
      rw [hΨc, h']
    show hS.extClass.comp (Ψe.symm (α.comp (Abelian.Ext.mk₀ (wcHMConst Wo.toScheme ℓ c))
        (add_zero n₀))) h10 =
      (hS.extClass.comp (Ψe.symm α) h10).comp (Abelian.Ext.mk₀ (wcHMConst V ℓ c)) (add_zero n₁)
    rw [hsym]
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm

theorem wc_hm_line_of_et_tors_qcsep (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y]
    [IsSeparated (Limits.terminal.from Y)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ)
    (hfin : ∀ j : ℕ, Finite (wcEtCoh Y ℓ j)) (hcard : Nat.card (wcEtCoh Y ℓ i) ≤ ℓ) :
    ∃ η : wcHM Y ℓ i →+ ℚ_[ℓ], Function.Injective η ∧
      ∀ (c : ℚ_[ℓ]) (x : wcHM Y ℓ i), η (wcHMScalar Y ℓ i c x) = c * η x :=
by
  classical
  have hfinall : ∀ k j : ℕ, Finite (wcEtCoh Y (ℓ ^ k) j) := by
    intro k j
    refine wc_et_coh_coeff_devissage Y (ℓ ^ k)
      (pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)) ?_ j
    intro p hp hpd i'
    have hpl : p = ℓ := (Nat.prime_dvd_prime_iff_eq hp Fact.out).mp (hp.dvd_of_dvd_pow hpd)
    rw [hpl]
    exact hfin i'
  have hE : ∀ m i' : ℕ, Nonempty (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcZModSheaf Y m) i' ≃ wcEtCoh Y m i') := by
    intro m i
    obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y
    haveI := hcont
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep Y
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) i
    let χ : (wcEpsInv Y).obj ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅
        wcZModSheaf Y m :=
      (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).some ≪≫
        (wc_zmod_sheaf_const Y m).some.symm
    let E₂ : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          (wcZModSheaf Y m) i ≃
        Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          ((wcEpsInv Y).obj ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) i :=
      { toFun := fun y => y.comp (Abelian.Ext.mk₀ χ.inv) (add_zero i)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ χ.hom) (add_zero i)
        left_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] }
    let E : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (wcZModSheaf Y m) i ≃ wcEtCoh Y m i := E₂.trans E₀
    exact ⟨E⟩
  have hfinZ : ∀ e j : ℕ, Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcContSheaf Y (ZMod (ℓ ^ e))) j) := by
    intro e j
    obtain ⟨E⟩ := hE (ℓ ^ e) j
    haveI := hfinall e j
    have h : Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (wcZModSheaf Y (ℓ ^ e)) j) := Finite.of_equiv _ E.symm
    exact h
  have hsep := wc_int_ext_separated_of_finite Y
    (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) ℓ hfinZ i
  have hG : Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i) ∧
      Nat.card (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i) ≤ ℓ := by
    have e0 := wc_int_coker_zmod Y ℓ 1 (ℓ : ℤ_[ℓ]) (pow_one _).symm
    rw [pow_one] at e0
    obtain ⟨e⟩ := e0
    let E₁ : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i ≃
        Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          (wcZModSheaf Y ℓ) i :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    obtain ⟨E₃⟩ := hE ℓ i
    let E := E₁.trans E₃
    haveI := hfin i
    refine ⟨Finite.of_equiv _ E.symm, ?_⟩
    rw [Nat.card_congr E]
    exact hcard
  haveI hcpt : CompactSpace ↥(Scheme.ProEt.mk (𝟙 Y)).left :=
    (inferInstance : CompactSpace ↥Y)
  haveI hqs : QuasiSeparatedSpace ↥(Scheme.ProEt.mk (𝟙 Y)).left :=
    (inferInstance : QuasiSeparatedSpace ↥Y)
  have hden := (proet_qcqs_ladic_rationalization Y (Scheme.ProEt.mk (𝟙 Y)) ℓ i).1
  have descent : ∀ i : ℕ,
      Finite (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i) →
      Nat.card (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ]))) i) ≤ ℓ →
      (∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          (wcIntSheaf Y ℓ) i,
        (∀ e : ℕ, x.comp (Abelian.Ext.mk₀
          (Limits.cokernel.π (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e)))) (add_zero i) = 0) →
          x = 0) →
      (∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          (wcLadicSheaf Y ℓ) i,
        ∃ (e : ℕ) (y : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
            (wcIntSheaf Y ℓ) i),
          ℓ ^ e • x = y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero i)) →
      ∃ ηV : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          (wcLadicSheaf Y ℓ) i →+ ℚ_[ℓ],
        Function.Injective ηV ∧
        ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
            (wcLadicSheaf Y ℓ) i),
          ηV (x.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ c)) (add_zero i)) = c * ηV x := by
    intro i hGfin hGcard hsepi hdeni
    haveI := hGfin
    have s4 : ∀ (R : Type) [Ring R] (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
        (s : R → (G ⟶ G)), s 1 = 𝟙 G → (∀ a b, s (a * b) = s b ≫ s a) →
        (∀ a b, s (a + b) = s a + s b) →
        (∀ x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) G i,
            x.comp (Abelian.Ext.mk₀ (s 1)) (add_zero i) = x) ∧
        (∀ a b (x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) G i),
            x.comp (Abelian.Ext.mk₀ (s (a * b))) (add_zero i) =
            (x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)).comp (Abelian.Ext.mk₀ (s a))
              (add_zero i)) ∧
        (∀ a b (x : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) G i),
            x.comp (Abelian.Ext.mk₀ (s (a + b))) (add_zero i) =
            x.comp (Abelian.Ext.mk₀ (s a)) (add_zero i) +
              x.comp (Abelian.Ext.mk₀ (s b)) (add_zero i)) := by
      intro R _ G s h1 hmul hadd
      refine ⟨fun x => ?_, fun a b x => ?_, fun a b x => ?_⟩
      · rw [h1, Abelian.Ext.comp_mk₀_id]
      · rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero i)
          (add_zero 0) (by omega)]
      · rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
    obtain ⟨hs1, hsmul, hsadd, hscomm⟩ := wc_int_scalar_ring Y ℓ
    obtain ⟨hq1, hqmul, hqadd⟩ := wc_ladic_scalar_ring Y ℓ
    let M := Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcIntSheaf Y ℓ) i
    letI smulM : SMul ℤ_[ℓ] M :=
      ⟨fun a m => m.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ a)) (add_zero i)⟩
    obtain ⟨A1, Amul, Aadd⟩ := s4 ℤ_[ℓ] (wcIntSheaf Y ℓ) (wcIntScalar Y ℓ)
      hs1 hsmul hsadd
    letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
      (fun a x y => Abelian.Ext.add_comp x y _ _)
      (fun a b x => Aadd a b x)
      (fun a b x => Amul a b x)
      (fun x => A1 x)
    let V := Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (wcLadicSheaf Y ℓ) i
    letI smulV : SMul ℚ_[ℓ] V :=
      ⟨fun c x => x.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ c)) (add_zero i)⟩
    obtain ⟨B1, Bmul, Badd⟩ := s4 ℚ_[ℓ] (wcLadicSheaf Y ℓ) (wcLadicScalar Y ℓ)
      hq1 hqmul hqadd
    letI modV : Module ℚ_[ℓ] V := Module.ofMinimalAxioms
      (fun a x y => Abelian.Ext.add_comp x y _ _)
      (fun a b x => Badd a b x)
      (fun a b x => Bmul a b x)
      (fun x => B1 x)
    haveI hmono : Mono (wcIntScalar Y ℓ (ℓ : ℤ_[ℓ])) := wc_int_scalar_ell_mono Y ℓ
    let f := wcIntScalar Y ℓ (ℓ : ℤ_[ℓ])
    let S : ShortComplex (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hmono inferInstance
    let β : M →+ Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
        (Limits.cokernel f) i :=
      (Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
        (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (add_zero i)
    have hβtors : ∀ m : M, ℓ • β m = 0 := by
      intro m
      rw [← map_nsmul, ← Nat.cast_smul_eq_nsmul ℤ_[ℓ] ℓ m]
      change ((m.comp (Abelian.Ext.mk₀ f) (add_zero i)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero i)) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    obtain ⟨m₀, hm₀⟩ : ∃ m₀ : M, ∀ m, ∃ k : ℤ, β m = k • β m₀ := by
      by_cases hall : ∀ m, β m = 0
      · exact ⟨0, fun m => ⟨0, by rw [hall m, zero_zsmul]⟩⟩
      · push_neg at hall
        obtain ⟨m₀, hm₀⟩ := hall
        refine ⟨m₀, fun m => ?_⟩
        have hord : addOrderOf (β m₀) = ℓ := addOrderOf_eq_prime (hβtors m₀) hm₀
        have htop' : AddSubgroup.zmultiples (β m₀) = ⊤ := by
          apply AddSubgroup.eq_top_of_le_card
          rw [Nat.card_zmultiples, hord]
          exact hGcard
        have hmem : β m ∈ AddSubgroup.zmultiples (β m₀) := by
          rw [htop']; exact AddSubgroup.mem_top _
        obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
        exact ⟨k, hk.symm⟩
    have hdecomp : ∀ m : M, ∃ (k : ℤ) (m' : M), m = k • m₀ + (ℓ : ℤ_[ℓ]) • m' := by
      intro m
      obtain ⟨k, hk⟩ := hm₀ m
      have h0 : (m - k • m₀).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
        change β (m - k • m₀) = 0
        rw [map_sub, map_zsmul, hk, sub_self]
      obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - k • m₀) h0
      refine ⟨k, m', ?_⟩
      change m = k • m₀ + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
      rw [hm']
      abel
    have hT : ∃ T : Finset M, ∀ m : M, ∃ t ∈ T, ∃ m' : M, m = t + (ℓ : ℤ_[ℓ]) • m' := by
      have hfr : (Set.range β).Finite := Set.toFinite _
      let pre : Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
          (Limits.cokernel f) i → M :=
        fun y => if hy : ∃ m, β m = y then hy.choose else 0
      refine ⟨hfr.toFinset.image pre, fun m => ?_⟩
      refine ⟨pre (β m), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨m, rfl⟩), ?_⟩
      have hpre : β (pre (β m)) = β m := by
        have hy : ∃ m', β m' = β m := ⟨m, rfl⟩
        simp only [pre, dif_pos hy]
        exact hy.choose_spec
      have h0 : (m - pre (β m)).comp (Abelian.Ext.mk₀ S.g) (add_zero i) = 0 := by
        change β (m - pre (β m)) = 0
        rw [map_sub, hpre, sub_self]
      obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS (m - pre (β m)) h0
      refine ⟨m', ?_⟩
      change m = pre (β m) + m'.comp (Abelian.Ext.mk₀ S.f) (add_zero i)
      rw [hm']
      abel
    have hD : ∀ w : ℕ → M, (∀ e, w e = (ℓ : ℤ_[ℓ]) • w (e + 1)) → w 0 = 0 := by
      intro w hw
      have hpw : ∀ e : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ e) • w e := by
        intro e
        induction e with
        | zero => rw [pow_zero, one_smul]
        | succ e ih => rw [ih, hw e, ← mul_smul, ← pow_succ]
      apply hsepi (w 0)
      intro e
      rw [hpw e]
      change ((w e).comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e)))
        (add_zero i)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar Y ℓ ((ℓ : ℤ_[ℓ]) ^ e))))
          (add_zero i) = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    haveI hMfin : Module.Finite ℤ_[ℓ] M := padic_fg_of_mod_ell_reps ℓ M hT hD
    have hcycM : ∀ m : M, ∃ a : ℤ_[ℓ], m = a • m₀ := by
      have hle : (⊤ : Submodule ℤ_[ℓ] M) ≤ Submodule.span ℤ_[ℓ] {m₀} := by
        apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal ℤ_[ℓ])
          Module.Finite.fg_top (IsLocalRing.maximalIdeal_le_jacobson ⊥)
        intro m _
        obtain ⟨k, m', hm⟩ := hdecomp m
        rw [hm]
        have h1 : k • m₀ ∈ Submodule.span ℤ_[ℓ] {m₀} := by
          rw [← Int.cast_smul_eq_zsmul ℤ_[ℓ] k m₀]
          exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self m₀)
        have h2 : (ℓ : ℤ_[ℓ]) • m' ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] • (⊤ : Submodule ℤ_[ℓ] M) := by
          apply Submodule.smul_mem_smul
          · rw [PadicInt.maximalIdeal_eq_span_p]
            exact Ideal.mem_span_singleton_self _
          · exact Submodule.mem_top
        exact Submodule.mem_sup.mpr ⟨_, h1, _, h2, rfl⟩
      intro m
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hle Submodule.mem_top)
      exact ⟨a, ha.symm⟩
    let φ : M →+ V := (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)).postcomp
      (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (add_zero i)
    have hφ : ∀ (a : ℤ_[ℓ]) (m : M), φ (a • m) = (a : ℚ_[ℓ]) • φ m := by
      intro a m
      change ((m.comp (Abelian.Ext.mk₀ (wcIntScalar Y ℓ a)) (add_zero i)).comp
          (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero i)) =
        (m.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero i)).comp
          (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ (a : ℚ_[ℓ]))) (add_zero i)
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hscomm]
    have hcycV : ∀ x : V, ∃ c : ℚ_[ℓ], x = c • φ m₀ := by
      intro x
      obtain ⟨e, y, hy⟩ := hdeni x
      have hy' : (ℓ : ℚ_[ℓ]) ^ e • x = φ y := by
        rw [← Nat.cast_pow, Nat.cast_smul_eq_nsmul ℚ_[ℓ]]
        exact hy
      obtain ⟨a, rfl⟩ := hcycM y
      have hl : (ℓ : ℚ_[ℓ]) ^ e ≠ 0 :=
        pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
      refine ⟨((ℓ : ℚ_[ℓ]) ^ e)⁻¹ * (a : ℚ_[ℓ]), ?_⟩
      rw [mul_smul, ← hφ, ← hy', inv_smul_smul₀ hl]
    by_cases hv : φ m₀ = 0
    · refine ⟨0, fun x y _ => ?_, fun c x => by simp⟩
      obtain ⟨c, hc⟩ := hcycV x
      obtain ⟨c', hc'⟩ := hcycV y
      rw [hc, hc', hv, smul_zero, smul_zero]
    · have huniq : ∀ c c' : ℚ_[ℓ], c • φ m₀ = c' • φ m₀ → c = c' := by
        intro c c' hcc
        by_contra hne
        have h1 : (c - c') • φ m₀ = 0 := by rw [sub_smul, hcc, sub_self]
        apply hv
        rw [← inv_smul_smul₀ (sub_ne_zero.mpr hne) (φ m₀), h1, smul_zero]
      choose γ hγ using hcycV
      refine ⟨AddMonoidHom.mk' γ (fun x y => huniq _ _ (by
          rw [add_smul, ← hγ x, ← hγ y, ← hγ (x + y)])), fun x y hxy => ?_, fun c x => ?_⟩
      · have h' : γ x = γ y := hxy
        calc x = γ x • φ m₀ := hγ x
          _ = γ y • φ m₀ := by rw [h']
          _ = y := (hγ y).symm
      · show γ (c • x) = c * γ x
        exact huniq _ _ (by rw [mul_smul, ← hγ x, ← hγ (c • x)])
  obtain ⟨ηV, hVinj, hVlin⟩ := descent i hG.1 hG.2 hsep hden
  obtain ⟨Θ, hΘ⟩ := wc_hm_ladic_bridge Y ℓ i
  refine ⟨ηV.comp Θ.toAddMonoidHom, fun a b hab => Θ.injective (hVinj hab), fun c x => ?_⟩
  show ηV (Θ (wcHMScalar Y ℓ i c x)) = c * ηV (Θ x)
  rw [hΘ, hVlin]

theorem wc_smooth_pair_compl_strict_stalk_et_low_vanish (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) (n m : ℕ) [SmoothOfRelativeDimension n pY]
    [IsLocallyNoetherian Y]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (V : Y.Opens) (hV : (V : Set Y) = (Set.range i)ᶜ)
    (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (c : Spec R ⟶ Y) (hc : WeaklyEtale c) {Pq : Scheme.{u}} (q : Pq ⟶ (V : Scheme.{u}))
    (t : Pq ⟶ Spec R) (hP : IsPullback q t V.ι c)
    (k : ℕ) (hk1 : 1 ≤ k) (hk2 : k + 2 + 2 * m ≤ 2 * n) :
    Subsingleton (wcEtCoh Pq ℓ k) :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero

  have L1 : ∀ (W : Scheme.{u}) (v : W ⟶ Y), Etale v → ∀ (YV : Scheme.{u}) (gV : YV ⟶ W)
      (w : YV ⟶ (V : Scheme.{u})), IsPullback w gV V.ι v → ∀ (α : wcEtZModExt YV ℓ k) (x : W),
      ∃ (W' : Scheme.{u}) (v' : W' ⟶ W), Etale v' ∧ x ∈ Set.range v' ∧
        ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ W') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' →
          ∀ (Dw' : wcEtPullData w' ℓ), wcEtPull Dw' k α = 0 := by
    intro W v hv YV gV w hpb α x
    haveI : Etale v := hv
    haveI hgVo : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb inferInstance
    have hptw : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
        fst ≫ f = snd ≫ g → ∀ t : P, f (fst t) = g (snd t) := by
      intro P A B S fst snd f g h t
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h]
    have hpts : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
        IsPullback fst snd f g → ∀ (a : A) (b : B), f a = g b → ∃ t : P, fst t = a ∧ snd t = b := by
      intro P A B S fst snd f g h a b hab
      obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
      refine ⟨h.isoPullback.inv t, ?_, ?_⟩
      · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
      · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2
    by_cases hx : v x ∈ Set.range i
    · obtain ⟨z0, hz0⟩ := hx
      obtain ⟨hlt, -⟩ := wc_smooth_closed_reldim_cases K Y pY n m Z i
      rcases lt_trichotomy m n with hen | hen | hen
      ·
        obtain ⟨c', hc'⟩ : ∃ c', c' = n - m := ⟨_, rfl⟩
        have hcn : c' ≤ n := by omega
        have hnce : n - c' = m := by omega
        have hkc : k + 1 < 2 * c' := by omega
        obtain ⟨ZW, gZ, iW, hZpb⟩ : ∃ (ZW : Scheme.{u}) (gZ : ZW ⟶ Z) (iW : ZW ⟶ W),
            IsPullback gZ iW i v := ⟨_, _, _, IsPullback.of_hasPullback i v⟩
