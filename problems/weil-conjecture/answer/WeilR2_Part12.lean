  have hsec : wcLdpSec E N (c • G - d • G') a =
      ((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
          ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom c)) *
        wcLdpSec E N G a -
      ((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
          ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom d)) *
        wcLdpSec E N G' a := by
    show (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (MvPolynomial.X a)).hom
      (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (hXa a) 2 ((c • G - d • G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
          MvPolynomial (Fin (N + 1)) E) (c • G - d • G').2) = _
    rw [hA, map_sub, map_mul, map_mul, hconst, hconst]
    rfl

  have hk : ∀ r : E, (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom ((ι.app (wcSgD E N a)).hom
      (((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
        ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)))) =
      wcLdpConst E (ι ≫ wcProjKStr E N) x r := by
    intro r
    have f1 := Scheme.Hom.germ_stalkMap_apply ι (wcSgD E N a) x hx
      (((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
        ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)))
    have f2 := TopCat.Presheaf.germ_res_apply (wcProjK E N).presheaf
      (homOfLE (le_top : wcSgD E N a ≤ ⊤)) (ι x) hx
      ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r))
    rw [hcc]
    exact f1.symm.trans (congrArg (ι.stalkMap x).hom f2)
  show (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom
      ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (c • G - d • G') a)) =
    wcLdpConst E (ι ≫ wcProjKStr E N) x c * (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom
      ((ι.app (wcSgD E N a)).hom (wcLdpSec E N G a)) -
    wcLdpConst E (ι ≫ wcProjKStr E N) x d * (X.presheaf.germ (ι ⁻¹ᵁ wcSgD E N a) x hx).hom
      ((ι.app (wcSgD E N a)).hom (wcLdpSec E N G' a))
  rw [hsec]
  simp only [map_sub, map_mul]
  rw [hk, hk]

theorem wc_ldpi_sgE_inv (K : Type u) [Field K] (n : ℕ) (J L : Fin (n + 1)) :
    (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op
        (wcSgE K n J L) *
      (wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n L)).op
        (wcSgE K n L J) = 1 :=
by
  have I0 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
      (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1),
      (Proj 𝒜).presheaf.map (homOfLE (inf_le_left :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op
          (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
        (Proj 𝒜).presheaf.map (homOfLE (inf_le_right :
          Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op
          (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf)) = 1 := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a).symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        exact (ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b).symm
      rw [e1, e2, ← map_mul]
      have h1 : HomogeneousLocalization.awayMap 𝒜 hg (rfl : f * g = f * g)
            (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) *
          HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g)
            (HomogeneousLocalization.Away.mk 𝒜 hg 1 f hf) = 1 := by
        rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_mul, Localization.mk_eq_mk_iff,
          Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul, mul_one]
        ring
      rw [h1, map_one]
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _
  have hX : ∀ k : Fin (n + 1),
      (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K k)
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
    MvPolynomial.gradedAlgebra
  exact I0 (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
    (MvPolynomial.X L) (hX J) (hX L)

theorem wc_ldpi_fibre_homeo (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Z : Scheme.{u}) (g : Z ⟶ Limits.pullback X.hom (wcProjKStr E 1)) (hg : IsClosedImmersion g)
    (hrange : ∀ p : ↥(Limits.pullback X.hom (wcProjKStr E 1)), p ∈ Set.range g ↔
      ∀ (i : Fin (N + 1) × Fin 2) (hp : p ∈ wcLdpW E N X ι i),
        ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ (wcLdpW E N X ι i) p hp).hom
            (wcLdpH E N X ι G₀ G₁ i) ∈
          IsLocalRing.maximalIdeal ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk p)) :
    ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ wcProjK E 1),
      ∃ (W : Scheme.{u}) (q : W ⟶ X.left) (r : W ⟶ Spec (.of Ω)) (κ : W ⟶ wcProjK Ω N)
        (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 2),
        IsPullback q r X.hom (t ≫ wcProjKStr E 1) ∧ IsClosedImmersion κ ∧
        κ ≫ wcProjKStr Ω N = r ∧
        Nonempty (↥(Limits.pullback (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t) ≃ₜ
          ↥{w : W | wcLdpZero Ω N κ H w}) :=
by
  classical
  intro Ω _ _ t

  have Gt : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) (f : B ⟶ C) (U : C.Opens) (V : B.Opens)
      (hVU : V ≤ f ⁻¹ᵁ U) (s : Γ(C, U)) (w : A) (hw : w ∈ ψ ⁻¹ᵁ V) (hw' : w ∈ (ψ ≫ f) ⁻¹ᵁ U),
      (A.presheaf.germ (ψ ⁻¹ᵁ V) w hw).hom ((ψ.app V).hom ((f.appLE U V hVU).hom s)) =
        (A.presheaf.germ ((ψ ≫ f) ⁻¹ᵁ U) w hw').hom (((ψ ≫ f).app U).hom s) := by
    intros
    simp [Scheme.Hom.appLE, Scheme.Hom.comp_app] <;> rfl
  have Gφ : ∀ {A C : Scheme.{u}} (φ φ' : A ⟶ C) (h : φ = φ') (U : C.Opens) (s : Γ(C, U)) (w : A)
      (hw : w ∈ φ ⁻¹ᵁ U) (hw' : w ∈ φ' ⁻¹ᵁ U),
      (A.presheaf.germ (φ ⁻¹ᵁ U) w hw).hom ((φ.app U).hom s) =
        (A.presheaf.germ (φ' ⁻¹ᵁ U) w hw').hom ((φ'.app U).hom s) := by
    intro A C φ φ' h U s w hw hw'
    subst h
    rfl
  have Gc : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g' : B ⟶ C) (U : C.Opens) (s : Γ(C, U)) (w : A)
      (hw : w ∈ f ⁻¹ᵁ (g' ⁻¹ᵁ U)) (hw' : w ∈ (f ≫ g') ⁻¹ᵁ U),
      (A.presheaf.germ (f ⁻¹ᵁ (g' ⁻¹ᵁ U)) w hw).hom ((f.app (g' ⁻¹ᵁ U)).hom ((g'.app U).hom s)) =
        (A.presheaf.germ ((f ≫ g') ⁻¹ᵁ U) w hw').hom (((f ≫ g').app U).hom s) := by
    intros
    first
      | rfl
      | (rw [Scheme.Hom.comp_app]; rfl)
      | rw [Scheme.Hom.comp_app]
  have GS : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U : B.Opens) (x : A) (hx : f x ∈ U) (y : Γ(B, U)),
      (f.stalkMap x).hom ((B.presheaf.germ U (f x) hx).hom y) =
        (A.presheaf.germ (f ⁻¹ᵁ U) x hx).hom ((f.app U).hom y) :=
    fun f U x hx y => Scheme.Hom.germ_stalkMap_apply f U x hx y
  have hinv : ∀ y : Γ(Spec (CommRingCat.of Ω), ⊤),
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y) = y := by
    intro y
    simp
  have hpp : ∀ x : Fin 2, x + 1 + 1 = x := by decide
  have hne : ∀ x : Fin 2, x + 1 ≠ x := by decide
  have hother : ∀ x y : Fin 2, y = x ∨ y = x + 1 := by decide

  have slope : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (C : Ω →+* R) (v : Fin 2 → R)
      (e : Fin 2) (c : Fin 2 → Ω), c e = 1 →
      (C (c 1) * v 0 - C (c 0) * v 1 ∈ IsLocalRing.maximalIdeal R ↔
        v (e + 1) - C (c (e + 1)) * v e ∈ IsLocalRing.maximalIdeal R) := by
    intro R _ _ C v e c hce
    have h01 : ∀ x : Fin 2, x = 0 ∨ x = 1 := by decide
    rcases h01 e with rfl | rfl
    · have h1 : (0 : Fin 2) + 1 = 1 := by decide
      rw [h1, hce, map_one]
      have : C (c 1) * v 0 - 1 * v 1 = -(v 1 - C (c 1) * v 0) := by ring
      rw [this, neg_mem_iff]
    · have h2 : (1 : Fin 2) + 1 = 0 := by decide
      rw [h2, hce, map_one, one_mul]
  have slope2 : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (C : Ω →+* R) (x y : R) (τ τ' : Ω),
      τ * τ' = 1 → y - C τ * x ∈ IsLocalRing.maximalIdeal R →
        x - C τ' * y ∈ IsLocalRing.maximalIdeal R := by
    intro R _ _ C x y τ τ' h hm
    have hC : C τ' * C τ = 1 := by rw [← map_mul, mul_comm, h, map_one]
    have : x - C τ' * y = -(C τ') * (y - C τ * x) := by linear_combination (-x) * hC
    rw [this]
    exact Ideal.mul_mem_left _ _ hm

  letI : Algebra E Ω := (Spec.preimage (t ≫ wcProjKStr E 1)).hom.toAlgebra
  have hφ : Spec.map (CommRingCat.ofHom (algebraMap E Ω)) = t ≫ wcProjKStr E 1 := by
    rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
  obtain ⟨pm, hpre, hPi, hsec⟩ := wc_ldpi_fh_proj_base_change_sections E Ω N
  rw [hφ] at hPi

  obtain ⟨W, q, r, hW⟩ : ∃ (W : Scheme.{u}) (q : W ⟶ X.left) (r : W ⟶ Spec (.of Ω)),
      IsPullback q r X.hom (t ≫ wcProjKStr E 1) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hcond : (q ≫ ι) ≫ wcProjKStr E N = r ≫ (t ≫ wcProjKStr E 1) := by
    rw [Category.assoc, hιX]; exact hW.w
  obtain ⟨κ, hkPi, hκr⟩ : ∃ κ : W ⟶ wcProjK Ω N, κ ≫ pm = q ≫ ι ∧ κ ≫ wcProjKStr Ω N = r :=
    ⟨hPi.lift (q ≫ ι) r hcond, hPi.lift_fst _ _ _, hPi.lift_snd _ _ _⟩
  have hbig : IsPullback q (κ ≫ wcProjKStr Ω N) (ι ≫ wcProjKStr E N) (t ≫ wcProjKStr E 1) := by
    rw [hκr, hιX]; exact hW
  have hsq : IsPullback q κ ι pm := IsPullback.of_bot hbig hkPi.symm hPi
  have hκ : IsClosedImmersion κ := MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq hι

  have hchart : ∀ (e' : Fin 2) (y : Spec (.of Ω)), t y ∈ wcSgD E 1 e' →
      ⊤ ≤ t ⁻¹ᵁ wcSgD E 1 e' := by
    intro e' y hy z _
    rw [Subsingleton.elim z y]
    exact hy
  have hpt : t (IsLocalRing.closedPoint Ω) ∈ (⨆ a : Fin (1 + 1), wcSgD E 1 a) := by
    rw [wc_pp_basicOpen_cover E 1]; trivial
  obtain ⟨e, he0⟩ : ∃ e : Fin 2, t (IsLocalRing.closedPoint Ω) ∈ wcSgD E 1 e :=
    TopologicalSpace.Opens.mem_iSup.mp hpt
  have he : ⊤ ≤ t ⁻¹ᵁ wcSgD E 1 e := hchart e _ he0
  obtain ⟨c, hce, hce1⟩ : ∃ c : Fin 2 → Ω, c e = 1 ∧ c (e + 1) =
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom
        ((t.appLE (wcSgD E 1 e) ⊤ he).hom (wcSgE E 1 e (e + 1))) :=
    ⟨fun k => if k = e then 1 else (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom
        ((t.appLE (wcSgD E 1 e) ⊤ he).hom (wcSgE E 1 e (e + 1))), if_pos rfl, if_neg (hne e)⟩

  have hinvT : ∀ (e₁ e₂ : Fin 2) (h₁ : ⊤ ≤ t ⁻¹ᵁ wcSgD E 1 e₁) (h₂ : ⊤ ≤ t ⁻¹ᵁ wcSgD E 1 e₂),
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom
          ((t.appLE (wcSgD E 1 e₁) ⊤ h₁).hom (wcSgE E 1 e₁ e₂)) *
        (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom
          ((t.appLE (wcSgD E 1 e₂) ⊤ h₂).hom (wcSgE E 1 e₂ e₁)) = 1 := by
    intro e₁ e₂ h₁ h₂
    have h12 : (⊤ : (Spec (CommRingCat.of Ω)).Opens) ≤ t ⁻¹ᵁ (wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂) :=
      fun z hz => by
        show t z ∈ wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂
        exact TopologicalSpace.Opens.mem_inf.mpr ⟨h₁ hz, h₂ hz⟩
    have k1 : (t.appLE (wcSgD E 1 e₁) ⊤ h₁).hom (wcSgE E 1 e₁ e₂) =
        (t.appLE (wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂) ⊤ h12).hom
          ((wcProjK E 1).presheaf.map (homOfLE (inf_le_left :
            wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂ ≤ wcSgD E 1 e₁)).op (wcSgE E 1 e₁ e₂)) := by
      have := Scheme.Hom.map_appLE t h12 (homOfLE (inf_le_left :
            wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂ ≤ wcSgD E 1 e₁)).op
      rw [← this]
      rfl
    have k2 : (t.appLE (wcSgD E 1 e₂) ⊤ h₂).hom (wcSgE E 1 e₂ e₁) =
        (t.appLE (wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂) ⊤ h12).hom
          ((wcProjK E 1).presheaf.map (homOfLE (inf_le_right :
            wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂ ≤ wcSgD E 1 e₂)).op (wcSgE E 1 e₂ e₁)) := by
      have := Scheme.Hom.map_appLE t h12 (homOfLE (inf_le_right :
            wcSgD E 1 e₁ ⊓ wcSgD E 1 e₂ ≤ wcSgD E 1 e₂)).op
      rw [← this]
      rfl
    rw [k1, k2, ← map_mul, ← map_mul, wc_ldpi_sgE_inv E 1 e₁ e₂, map_one, map_one]

  obtain ⟨ψ, hψ1, hψ2⟩ : ∃ ψ : W ⟶ Limits.pullback X.hom (wcProjKStr E 1),
      ψ ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = q ∧
        ψ ≫ Limits.pullback.snd X.hom (wcProjKStr E 1) = r ≫ t :=
    ⟨Limits.pullback.lift q (r ≫ t) (by rw [Category.assoc]; exact hW.w),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have Hψ : IsPullback ψ r (Limits.pullback.snd X.hom (wcProjKStr E 1)) t :=
    IsPullback.of_right (by rw [hψ1]; exact hW) hψ2 (IsPullback.of_hasPullback _ _)

  have hloc : ∀ (w : W) (y : (Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (ψ w)),
      (ψ.stalkMap w).hom y ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk w) ↔
        y ∈ IsLocalRing.maximalIdeal
          ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.stalk (ψ w)) := by
    intro w y
    simp only [IsLocalRing.mem_maximalIdeal]
    exact map_mem_nonunits_iff (ψ.stalkMap w).hom y

  have hfstT : ∀ (w : W) (a : Fin (N + 1)) (U' : (Limits.pullback X.hom (wcProjKStr E 1)).Opens)
      (hU' : U' ≤ Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N a))
      (hw : w ∈ ψ ⁻¹ᵁ U') (hwa : w ∈ κ ⁻¹ᵁ wcSgD Ω N a)
      (Gp : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2),
      (W.presheaf.germ (ψ ⁻¹ᵁ U') w hw).hom ((ψ.app U').hom
        (((Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE (ι ⁻¹ᵁ wcSgD E N a) U' hU').hom
          ((ι.app (wcSgD E N a)).hom (wcLdpSec E N Gp a)))) =
      wcLdpGerm Ω N κ (wcLdpMapQ E Ω N Gp) a w hwa := by
    intro w a U' hU' hw hwa Gp
    have m1 : w ∈ (ψ ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N a) :=
      hU' hw
    have m2 : w ∈ q ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N a) := by rw [← hψ1]; exact m1
    have m3 : w ∈ (q ≫ ι) ⁻¹ᵁ wcSgD E N a := m2
    have m4 : w ∈ (κ ≫ pm) ⁻¹ᵁ wcSgD E N a := by rw [hkPi]; exact m3
    rw [Gt ψ _ _ _ hU' _ w hw m1, Gφ _ q hψ1 _ _ w m1 m2, Gc q ι _ _ w m2 m3,
      ← Gφ _ _ hkPi _ _ w m4 m3]
    unfold wcLdpGerm
    rw [← hsec a Gp, Gt κ pm _ _ (hpre a).ge _ w hwa m4]

  have hsndT : ∀ (w : W) (e' : Fin 2) (U' : (Limits.pullback X.hom (wcProjKStr E 1)).Opens)
      (hU' : U' ≤ Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 e')
      (hw : w ∈ ψ ⁻¹ᵁ U') (he' : ⊤ ≤ t ⁻¹ᵁ wcSgD E 1 e'),
      (W.presheaf.germ (ψ ⁻¹ᵁ U') w hw).hom ((ψ.app U').hom
        (((Limits.pullback.snd X.hom (wcProjKStr E 1)).appLE (wcSgD E 1 e') U' hU').hom
          (wcSgE E 1 e' (e' + 1)))) =
      wcLdpConst Ω r w ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom
        ((t.appLE (wcSgD E 1 e') ⊤ he').hom (wcSgE E 1 e' (e' + 1)))) := by
    intro w e' U' hU' hw he'
    have m1 : w ∈ (ψ ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ⁻¹ᵁ wcSgD E 1 e' := hU' hw
    have m2 : w ∈ (r ≫ t) ⁻¹ᵁ wcSgD E 1 e' := by rw [← hψ2]; exact m1
    rw [Gt ψ _ _ _ hU' _ w hw m1, Gφ _ _ hψ2 _ _ w m1 m2,
      ← Gt r t (wcSgD E 1 e') ⊤ he' (wcSgE E 1 e' (e' + 1)) w trivial m2,
      wcLdpConst, RingHom.comp_apply, RingHom.comp_apply, hinv]
    rfl

  have hgerm : ∀ (w : W) (a : Fin (N + 1)) (e' : Fin 2) (hp : ψ w ∈ wcLdpW E N X ι (a, e'))
      (hx : w ∈ κ ⁻¹ᵁ wcSgD Ω N a) (he' : ⊤ ≤ t ⁻¹ᵁ wcSgD E 1 e'),
      (ψ.stalkMap w).hom (((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ
          (wcLdpW E N X ι (a, e')) (ψ w) hp).hom (wcLdpH E N X ι G₀ G₁ (a, e'))) =
        wcLdpGerm Ω N κ (wcLdpMapQ E Ω N (![G₀, G₁] (e' + 1))) a w hx -
          wcLdpConst Ω r w ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom
            ((t.appLE (wcSgD E 1 e') ⊤ he').hom (wcSgE E 1 e' (e' + 1)))) *
          wcLdpGerm Ω N κ (wcLdpMapQ E Ω N (![G₀, G₁] e')) a w hx := by
    intro w a e' hp hx he'
    rw [GS, wcLdpH]
    dsimp only
    rw [map_sub, map_sub, map_mul, map_mul]
    have e1 := hfstT w a (wcLdpW E N X ι (a, e')) inf_le_left hp hx (![G₀, G₁] (e' + 1))
    have e2 := hfstT w a (wcLdpW E N X ι (a, e')) inf_le_left hp hx (![G₀, G₁] e')
    have e3 := hsndT w e' (wcLdpW E N X ι (a, e')) inf_le_right hp he'
    first
      | (rw [e1, e2, e3])
      | (erw [e1, e2, e3])

  have hkey : ∀ w : W, ψ w ∈ Set.range g ↔
      wcLdpZero Ω N κ (c 1 • wcLdpMapQ E Ω N G₀ - c 0 • wcLdpMapQ E Ω N G₁) w := by
    intro w
    have hPL : ∀ (a : Fin (N + 1)) (hx : w ∈ κ ⁻¹ᵁ wcSgD Ω N a),
        wcLdpGerm Ω N κ (c 1 • wcLdpMapQ E Ω N G₀ - c 0 • wcLdpMapQ E Ω N G₁) a w hx =
          wcLdpConst Ω r w (c 1) * wcLdpGerm Ω N κ (wcLdpMapQ E Ω N (![G₀, G₁] 0)) a w hx -
          wcLdpConst Ω r w (c 0) * wcLdpGerm Ω N κ (wcLdpMapQ E Ω N (![G₀, G₁] 1)) a w hx := by
      intro a hx
      rw [wc_ldpi_germ_pencil_linear, hκr] <;> rfl
    constructor
    · intro hψ a hx
      have mA : w ∈ (κ ≫ pm) ⁻¹ᵁ wcSgD E N a := by
        show κ w ∈ pm ⁻¹ᵁ wcSgD E N a
        rw [hpre a]; exact hx
      have mB : w ∈ ((ψ ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ≫ ι) ⁻¹ᵁ wcSgD E N a := by
        rw [hψ1, ← hkPi]; exact mA
      have mS : w ∈ (ψ ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ⁻¹ᵁ wcSgD E 1 e := by
        rw [hψ2]; exact he (show r w ∈ (⊤ : (Spec (.of Ω)).Opens) from trivial)
      have hp : ψ w ∈ wcLdpW E N X ι (a, e) := TopologicalSpace.Opens.mem_inf.mpr ⟨mB, mS⟩
      have h1 := (hloc w _).mpr ((hrange (ψ w)).mp hψ (a, e) hp)
      rw [hgerm w a e hp hx he] at h1
      rw [hPL a hx]
      refine (slope (wcLdpConst Ω r w)
        (fun k => wcLdpGerm Ω N κ (wcLdpMapQ E Ω N (![G₀, G₁] k)) a w hx) e c hce).mpr ?_
      rw [hce1]
      exact h1
    · intro hZ
      refine (hrange (ψ w)).mpr ?_
      rintro ⟨a, e'⟩ hp
      have mB : w ∈ ((ψ ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ≫ ι) ⁻¹ᵁ wcSgD E N a :=
        (TopologicalSpace.Opens.mem_inf.mp hp).1
      have mA : w ∈ (κ ≫ pm) ⁻¹ᵁ wcSgD E N a := by rw [hkPi, ← hψ1]; exact mB
      have hx : w ∈ κ ⁻¹ᵁ wcSgD Ω N a := by
        show κ w ∈ wcSgD Ω N a
        rw [← hpre a]; exact mA
      have mS' : w ∈ (ψ ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ⁻¹ᵁ wcSgD E 1 e' :=
        (TopologicalSpace.Opens.mem_inf.mp hp).2
      have mS : w ∈ (r ≫ t) ⁻¹ᵁ wcSgD E 1 e' := by rw [← hψ2]; exact mS'
      have he' := hchart e' (r w) mS
      have h0 := hZ a hx
      rw [hPL a hx] at h0
      have hstar := (slope (wcLdpConst Ω r w)
        (fun k => wcLdpGerm Ω N κ (wcLdpMapQ E Ω N (![G₀, G₁] k)) a w hx) e c hce).mp h0
      rw [hce1] at hstar
      rw [← hloc w, hgerm w a e' hp hx he']
      rcases hother e e' with h | h
      · subst h
        exact hstar
      · subst h
        rw [hpp e]
        exact slope2 (wcLdpConst Ω r w) _ _ _ _ (hinvT e (e + 1) he he') hstar

  obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t ⟶ W,
      m ≫ ψ = Limits.pullback.fst (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t ≫ g ∧
        m ≫ r = Limits.pullback.snd (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t :=
    ⟨Hψ.lift (Limits.pullback.fst (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t ≫ g)
        (Limits.pullback.snd (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t)
        (by rw [Category.assoc]; exact Limits.pullback.condition),
      Hψ.lift_fst _ _ _, Hψ.lift_snd _ _ _⟩
  have Hq : IsPullback (Limits.pullback.fst (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t)
      m g ψ :=
    IsPullback.of_bot (by rw [hm2]; exact IsPullback.of_hasPullback _ _) hm1.symm Hψ
  have hmc : IsClosedImmersion m := MorphismProperty.of_isPullback (P := @IsClosedImmersion) Hq hg
  have hrng : Set.range m = {w | ψ w ∈ Set.range g} := by
    ext w
    constructor
    · rintro ⟨x, rfl⟩
      refine ⟨Limits.pullback.fst (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) t x, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hm1]
    · intro hw
      have hw' : w ∈ Set.range (Limits.pullback.snd g ψ) := by
        rw [Scheme.Pullback.range_snd]; exact hw
      obtain ⟨y, rfl⟩ := hw'
      refine ⟨Hq.isoPullback.inv y, ?_⟩
      rw [← Scheme.Hom.comp_apply, Hq.isoPullback_inv_snd]
  haveI := hmc
  have hemb := (Scheme.Hom.isClosedEmbedding m).isEmbedding
  exact ⟨W, q, r, κ, c 1 • wcLdpMapQ E Ω N G₀ - c 0 • wcLdpMapQ E Ω N G₁, hW, hκ, hκr,
    ⟨hemb.toHomeomorph.trans (Homeomorph.setCongr (hrng.trans (Set.ext fun w => hkey w)))⟩⟩

theorem wcpa_proj_base_change : ∀ (F F' : Type u) [Field F] [Field F'] [Algebra F F'] (N : ℕ),
  ∃ e : Limits.pullback (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ⟶
      @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') MvPolynomial.gradedAlgebra,
    IsIso e ∧
    e ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) =
      Limits.pullback.snd _ _ :=
by

  have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
      (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
      [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
      (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
      (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
      (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
    intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
    have hc : ∀ x : X, ∃ i y, j i y = x := by
      intro x
      have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
      exact ⟨i, y, hy⟩
    refine Scheme.isPullback_of_openCover φ p' p g
      (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
    intro i
    have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
      (hcomm i) (hpre i)).flip
    refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
      rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
    · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
      rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
    · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
      rw [Category.comp_id, Category.id_comp]
    · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
      rw [Category.comp_id, Category.id_comp]
  intro F F' _ _ _ N

  have s2 : ∀ (K : Type u) [Field K] (a : Fin (N + 1)),
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
      ∀ (s : MvPolynomial (Fin (N + 1)) K), s = MvPolynomial.X a →
      ∃ e : MvPolynomial (Fin N) K ≃+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s,
      (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers s)
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
      ∀ j : Fin N, (e (MvPolynomial.X j)).val =
        Localization.mk (MvPolynomial.X (a.succAbove j)) ⟨s, Submonoid.mem_powers s⟩ := by
    intro K _ a
    letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
    intro s hs
    subst hs

    have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
        (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
        MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
      intro S _ φ x t n F hF
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : Finsupp.degree d = n := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
        simp only [mul_pow]
        rw [Finsupp.prod_mul]
        congr 1
        rw [← hdeg, Finsupp.degree_apply]
        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
    have hg : ∀ i : Fin N, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)

    obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin N) K →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a),
        (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
        (∀ i : Fin N, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX 1
          (MvPolynomial.X (a.succAbove i)) (hg i)) :=
      ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
        (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
        fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
        fun i => by rw [MvPolynomial.eval₂Hom_X']⟩

    obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin N) K,
        (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
        (∀ i : Fin N, ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin N) K) a 1 MvPolynomial.X),
        fun c => by rw [MvPolynomial.eval₂Hom_C],
        by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
        fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
    have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
    have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.X a) = 1 := by
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))

    obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) →+*
        MvPolynomial (Fin N) K,
        (∀ z y, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) z =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) y → ρ z = ρt y) ∧
        (∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K)
          (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)),
          ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hX n F hF) = ρt F) := by
      refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
            MvPolynomial (Fin N) K).comp (algebraMap _ _), ?_, ?_⟩
      · intro z y hzy
        rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
      · intro n F hF
        rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk]
        have hs := IsLocalization.mk'_spec
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F
          (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
            Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
        rw [← Localization.mk_eq_mk'_apply] at hs
        have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
            MvPolynomial (Fin N) K) hs
        rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
        simp only [map_pow, hρa, one_pow, mul_one] at hs2
        exact hs2
    have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
          (ψ (MvPolynomial.C c)) =
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.C c) := by
      intro c
      rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
      have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    have hΨX : ∀ i : Fin N, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
          (ψ (MvPolynomial.X i)) =
        (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
          (MvPolynomial.X (a.succAbove i)) := by
      intro i
      rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      congr 1
      ext
      simp
    have hcomp : ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp ψ).comp ρt =
        MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
          (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X j)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
          RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
        rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
        · subst h
          rw [hρa, map_one, map_one, hu1]
        · subst h
          rw [hρs, hΨX]
    have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X j)) =
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X']
    have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
        algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (ψ (ρt F)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (MvPolynomial.X a ^ n) =
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by
      intro n F hF
      have h1 := RingHom.congr_fun hcomp F
      rw [RingHom.comp_apply, RingHom.comp_apply] at h1
      rw [h1, MvPolynomial.coe_eval₂Hom]
      have hs := scale ((algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
        (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X j))
        (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
      rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
      calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) ^ n *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X a) ^ n
          = ((Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X a)) ^ n *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by ring
        _ = _ := by rw [hu1, one_pow, one_mul]
    have h1 : ψ.comp ρ = RingHom.id _ := by
      apply RingHom.ext
      intro z
      obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX z
      rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
      have hFh : F.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at hF
        exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
      apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
      rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
        Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
      exact key n F hFh
    have h2 : ρ.comp ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
      · intro i
        rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
    refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun c => ?_, fun j => ?_⟩
    · rw [RingEquiv.ofRingHom_apply, hψC]
    · rw [RingEquiv.ofRingHom_apply, hψX, HomogeneousLocalization.Away.val_mk]
      congr 1
      ext
      simp

  have hspan : ∀ (K : Type u) [Field K],
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal ≤
        Ideal.span (Set.range MvPolynomial.X) := by
    intro K _
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩

  have V0 : ∀ (K : Type u) [Field K],
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
      ∀ (s : MvPolynomial (Fin (N + 1)) K) (c : K),
      (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (Submonoid.powers s)
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := by
    intro K _
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
    intro s c
    have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
        MvPolynomial.C c := by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    rw [← h1]
    rfl
  letI iF : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) :=
    MvPolynomial.gradedAlgebra
  letI iF' : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') :=
    MvPolynomial.gradedAlgebra
  obtain ⟨f, hfmap⟩ : ∃ f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F',
      ∀ p, f p = MvPolynomial.map (algebraMap F F') p :=
    ⟨⟨MvPolynomial.map (algebraMap F F'), fun {i} {x} hx =>
      (MvPolynomial.mem_homogeneousSubmodule i _).mpr
        (((MvPolynomial.mem_homogeneousSubmodule i x).mp hx).map (algebraMap F F'))⟩,
      fun p => rfl⟩
  have hX : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) F) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X F a)
  have hfX : ∀ a : Fin (N + 1), f (MvPolynomial.X a) = MvPolynomial.X a := fun a => by
    rw [hfmap, MvPolynomial.map_X]

  have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≤
      HomogeneousIdeal.map f
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)) := by
    intro p hp
    have hp' : p ∈ Ideal.span (Set.range (MvPolynomial.X :
        Fin (N + 1) → MvPolynomial (Fin (N + 1)) F')) := hspan F' hp
    change p ∈ (HomogeneousIdeal.map f _).toIdeal
    rw [HomogeneousIdeal.toIdeal_map]
    refine (Ideal.span_le.mpr ?_) hp'
    rintro _ ⟨i, rfl⟩
    rw [← hfX i]
    apply Ideal.mem_map_of_mem
    change MvPolynomial.X i ∈ HomogeneousIdeal.irrelevant _
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_ne _ (hX i) one_ne_zero

  have s3 : ∀ {P : Submonoid (MvPolynomial (Fin (N + 1)) F)}
      {Q : Submonoid (MvPolynomial (Fin (N + 1)) F')} (comap_le : P ≤ Submonoid.comap f Q)
      (z : HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) P)
      (n : MvPolynomial (Fin (N + 1)) F) (d : P), z.val = Localization.mk n d →
      (HomogeneousLocalization.map f comap_le z).val =
        Localization.mk (f n) ⟨f d, comap_le d.2⟩ := by
    intro P Q comap_le z n d h
    obtain ⟨x, rfl⟩ := HomogeneousLocalization.mk_surjective z
    rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
    rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h
    obtain ⟨c, hc⟩ := h
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨⟨f c, comap_le c.2⟩, ?_⟩
    have := congrArg f hc
    simp only [map_mul] at this
    exact this

  have hchart : ∀ a : Fin (N + 1), IsPullback
      (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))))
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
          Nat.one_pos ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))))
      (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    intro a
    obtain ⟨e, heC, heX⟩ := s2 F a (MvPolynomial.X a) rfl
    obtain ⟨e', he'C, he'X⟩ := s2 F' a (f (MvPolynomial.X a)) (hfX a)

    have hcompat : ∀ p : MvPolynomial (Fin N) F,
        HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e p) =
          e' (MvPolynomial.map (algebraMap F F') p) := by
      have key : (HomogeneousLocalization.Away.map f (MvPolynomial.X a)).comp e.toRingHom =
          e'.toRingHom.comp (MvPolynomial.map (algebraMap F F')) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.C c)) =
            e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.C c))
          rw [MvPolynomial.map_C, heC, he'C]
          apply HomogeneousLocalization.val_injective _
          rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ (MvPolynomial.C c) 1 (V0 F _ c),
            V0 F' _ (algebraMap F F' c)]
          congr 1
          · rw [hfmap, MvPolynomial.map_C]
          · ext
            simp
        · intro j
          show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.X j)) =
            e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.X j))
          rw [MvPolynomial.map_X]
          apply HomogeneousLocalization.val_injective _
          rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ _ _ (heX j), he'X j]
          congr 1
          rw [hfmap, MvPolynomial.map_X]
      intro p
      exact RingHom.congr_fun key p

    have P : IsPushout
        (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
        (CommRingCat.ofHom (algebraMap F F'))
        (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a)))
        (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          (Submonoid.powers (f (MvPolynomial.X a)))).comp
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
      letI := (MvPolynomial.algebraMvPolynomial :
        Algebra (MvPolynomial (Fin N) F) (MvPolynomial (Fin N) F'))
      have P0 := CommRingCat.isPushout_of_isPushout F (MvPolynomial (Fin N) F) F'
        (MvPolynomial (Fin N) F')
      refine IsPushout.of_iso P0 (Iso.refl _) e.toCommRingCatIso (Iso.refl _) e'.toCommRingCatIso
        ?_ ?_ ?_ ?_
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact heC c
      · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        exact (hcompat p).symm
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        exact he'C c
    have hj : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
          Nat.one_pos ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) =
        Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) := by
      rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hj' : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos ≫
        (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) =
        Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          (Submonoid.powers (f (MvPolynomial.X a)))).comp
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
      rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hj, hj']
    exact isPullback_SpecMap_of_isPushout _ _ _ _ P
  have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
      (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
    simp only [Proj.opensRange_awayι]
    exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
  have hcomm : ∀ a : Fin (N + 1),
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
        Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos := fun a =>
    Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
  have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
        Nat.one_pos).opensRange =
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
    rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
  have H := s6 (Proj.map f hf)
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
    (Spec.map (CommRingCat.ofHom (algebraMap F F')))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
      (hX a) Nat.one_pos)
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
      (f.map_mem (hX a)) Nat.one_pos)
    (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
    hcov hcomm hpre hchart
  exact ⟨H.isoPullback.inv, inferInstance, H.isoPullback_inv_snd⟩

theorem wc_ldp_base_change_embedded (F' : Type u) [Field F'] (Y : Over (Spec (.of F'))) (N : ℕ)
    (j : Y.left ⟶ wcProjK F' N) (hj : IsClosedImmersion j) (hjY : j ≫ wcProjKStr F' N = Y.hom)
    (E : Type u) [Field E] [Algebra F' E] :
    ∃ jE : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ⟶ wcProjK E N,
      IsClosedImmersion jE ∧
      jE ≫ wcProjKStr E N = Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) :=
by
  obtain ⟨e₀, he, he₂⟩ := wcpa_proj_base_change F' E N
  let ψ : Spec (.of E) ⟶ Spec (.of F') := Spec.map (CommRingCat.ofHom (algebraMap F' E))
  let e : Limits.pullback (wcProjKStr F' N) ψ ⟶ wcProjK E N := e₀
  haveI : IsIso e := he
  have he₂' : e ≫ wcProjKStr E N = Limits.pullback.snd (wcProjKStr F' N) ψ := he₂
  let m : Limits.pullback Y.hom ψ ⟶ Limits.pullback (wcProjKStr F' N) ψ :=
    Limits.pullback.map Y.hom ψ (wcProjKStr F' N) ψ j (𝟙 _) (𝟙 _)
      (by rw [Category.comp_id, hjY]) (by rw [Category.comp_id, Category.id_comp])
  have m1 : m ≫ Limits.pullback.fst (wcProjKStr F' N) ψ = Limits.pullback.fst Y.hom ψ ≫ j :=
    Limits.pullback.lift_fst _ _ _
  have m2 : m ≫ Limits.pullback.snd (wcProjKStr F' N) ψ = Limits.pullback.snd Y.hom ψ :=
    (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  have hO : IsPullback (m ≫ Limits.pullback.snd (wcProjKStr F' N) ψ) (Limits.pullback.fst Y.hom ψ)
      ψ (j ≫ wcProjKStr F' N) := by
    rw [m2, hjY]
    exact (IsPullback.of_hasPullback _ _).flip
  have L : IsPullback m (Limits.pullback.fst Y.hom ψ) (Limits.pullback.fst (wcProjKStr F' N) ψ) j :=
    IsPullback.of_right hO m1 (IsPullback.of_hasPullback (wcProjKStr F' N) ψ).flip
  have hm : IsClosedImmersion m :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) L.flip hj
  refine ⟨m ≫ e, ?_, ?_⟩
  · haveI := hm
    haveI := he
    infer_instance
  · rw [Category.assoc, he₂', m2]

theorem wc_ldp_dgp_embed (F' K : Type u) [Field F'] [Field K] [Algebra F' K]
    (Y : Over (Spec (.of F'))) (N : ℕ) (j : Y.left ⟶ wcProjK F' N) (hj : IsClosedImmersion j)
    (hjY : j ≫ wcProjKStr F' N = Y.hom) :
    ∃ jK : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ⟶ wcProjK K N,
      IsClosedImmersion jK ∧
      jK ≫ wcProjKStr K N =
        Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ∧
      ∀ (E : Type u) [Field E] [Algebra F' E] [Algebra E K] [IsScalarTower F' E K],
        ∃ jE : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ⟶
            wcProjK E N,
          IsClosedImmersion jE ∧
          jE ≫ wcProjKStr E N =
            Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ∧
          (∀ (w : ↥(Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))))
              (a : Fin (N + 1)),
            w ∈ jK ⁻¹ᵁ wcSgD K N a ↔ wcLdpRho F' E K Y w ∈ jE ⁻¹ᵁ wcSgD E N a) ∧
          ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
            (w : ↥(Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))))
            (a : Fin (N + 1)) (hw : w ∈ jK ⁻¹ᵁ wcSgD K N a)
            (hρw : wcLdpRho F' E K Y w ∈ jE ⁻¹ᵁ wcSgD E N a),
            ((wcLdpRho F' E K Y).stalkMap w).hom (wcLdpGerm E N jE G a _ hρw) =
              wcLdpGerm K N jK (wcLdpMapQ E K N G) a w hw :=
by
  classical

  have PB : ∀ (F F' : Type u) [Field F] [Field F'] [Algebra F F'],
      IsPullback (wcLdpProjMap F F' N) (wcProjKStr F' N) (wcProjKStr F N)
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
        (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
        [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
        (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
        (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
        (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
      intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
      have hc : ∀ x : X, ∃ i y, j i y = x := by
        intro x
        have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
        exact ⟨i, y, hy⟩
      refine Scheme.isPullback_of_openCover φ p' p g
        (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
      intro i
      have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
        (hcomm i) (hpre i)).flip
      refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
        rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
      · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
        rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
      · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
        rw [Category.comp_id, Category.id_comp]
      · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
        rw [Category.comp_id, Category.id_comp]
    intro F F' _ _ _

    have s2 : ∀ (K : Type u) [Field K] (a : Fin (N + 1)),
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K), s = MvPolynomial.X a →
        ∃ e : MvPolynomial (Fin N) K ≃+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s,
        (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
        ∀ j : Fin N, (e (MvPolynomial.X j)).val =
          Localization.mk (MvPolynomial.X (a.succAbove j)) ⟨s, Submonoid.mem_powers s⟩ := by
      intro K _ a
      letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s hs
      subst hs

      have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
          (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
        intro S _ φ x t n F hF
        conv_lhs => rw [F.as_sum]
        conv_rhs => rw [F.as_sum]
        rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d hd => ?_)
        have hdeg : Finsupp.degree d = n := by
          by_contra h
          exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
        rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
        have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
          simp only [mul_pow]
          rw [Finsupp.prod_mul]
          congr 1
          rw [← hdeg, Finsupp.degree_apply]
          unfold Finsupp.prod
          rw [Finset.prod_pow_eq_pow_sum]
        rw [hp]
        ring
      have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
      have hg : ∀ i : Fin N, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := fun i =>
        (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)

      obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin N) K →+*
          HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (MvPolynomial.X a),
          (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
          (∀ i : Fin N, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX 1
            (MvPolynomial.X (a.succAbove i)) (hg i)) :=
        ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
          (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
          fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
          fun i => by rw [MvPolynomial.eval₂Hom_X']⟩

      obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin N) K,
          (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
          (∀ i : Fin N, ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) :=
        ⟨MvPolynomial.eval₂Hom MvPolynomial.C
            (Fin.insertNth (α := fun _ => MvPolynomial (Fin N) K) a 1 MvPolynomial.X),
          fun c => by rw [MvPolynomial.eval₂Hom_C],
          by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
          fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
      have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
      have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.X a) = 1 := by
        rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))

      obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a) →+*
          MvPolynomial (Fin N) K,
          (∀ z y, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) z =
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) y → ρ z = ρt y) ∧
          (∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K)
            (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (n • 1)),
            ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              hX n F hF) = ρt F) := by
        refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K).comp (algebraMap _ _), ?_, ?_⟩
        · intro z y hzy
          rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
        · intro n F hF
          rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk]
          have hs := IsLocalization.mk'_spec
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F
            (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
              Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
          rw [← Localization.mk_eq_mk'_apply] at hs
          have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) →+*
              MvPolynomial (Fin N) K) hs
          rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
          simp only [map_pow, hρa, one_pow, mul_one] at hs2
          exact hs2
      have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.C c)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.C c) := by
        intro c
        rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
        have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
            MvPolynomial.C c := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← h1]
        rfl
      have hΨX : ∀ i : Fin N, algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (ψ (MvPolynomial.X i)) =
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
            (MvPolynomial.X (a.succAbove i)) := by
        intro i
        rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
          ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
        congr 1
        ext
        simp
      have hcomp : ((algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp ψ).comp ρt =
          MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
            RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
          rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
          · subst h
            rw [hρa, map_one, map_one, hu1]
          · subst h
            rw [hρs, hΨX]
      have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
            (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j)) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        · intro j
          rw [MvPolynomial.eval₂Hom_X']
      have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
          algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X a))
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (ψ (ρt F)) *
            algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
              (MvPolynomial.X a ^ n) =
          algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by
        intro n F hF
        have h1 := RingHom.congr_fun hcomp F
        rw [RingHom.comp_apply, RingHom.comp_apply] at h1
        rw [h1, MvPolynomial.coe_eval₂Hom]
        have hs := scale ((algebraMap (MvPolynomial (Fin (N + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X j))
          (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
        rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
        calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) ^ n *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X a) ^ n
            = ((Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
              Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K))
                (MvPolynomial.X a)) ^ n *
              algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) F := by ring
          _ = _ := by rw [hu1, one_pow, one_mul]
      have h1 : ψ.comp ρ = RingHom.id _ := by
        apply RingHom.ext
        intro z
        obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX z
        rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
        have hFh : F.IsHomogeneous n := by
          rw [smul_eq_mul, mul_one] at hF
          exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
        apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
        rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
          Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
        exact key n F hFh
      have h2 : ρ.comp ψ = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro c
          rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
        · intro i
          rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
      refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun c => ?_, fun j => ?_⟩
      · rw [RingEquiv.ofRingHom_apply, hψC]
      · rw [RingEquiv.ofRingHom_apply, hψX, HomogeneousLocalization.Away.val_mk]
        congr 1
        ext
        simp

    have hspan : ∀ (K : Type u) [Field K],
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal ≤
          Ideal.span (Set.range MvPolynomial.X) := by
      intro K _
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro p hp
      have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          p).mp hp
      have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0 p =
          MvPolynomial.homogeneousComponent 0 p :=
        (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
      rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro e he
      rw [MvPolynomial.mem_support_iff] at he
      have hne : e ≠ 0 := by
        rintro rfl
        exact he h0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩

    have V0 : ∀ (K : Type u) [Field K],
        letI := (MvPolynomial.gradedAlgebra :
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
        ∀ (s : MvPolynomial (Fin (N + 1)) K) (c : K),
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers s)
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := by
      intro K _
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
      intro s c
      have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) : MvPolynomial (Fin (N + 1)) K) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    letI iF : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) :=
      MvPolynomial.gradedAlgebra
    letI iF' : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') :=
      MvPolynomial.gradedAlgebra
    obtain ⟨f, hfmap, hfdef⟩ : ∃ f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F',
        (∀ p, f p = MvPolynomial.map (algebraMap F F') p) ∧ f = wcLdpGrHom F F' N :=
      ⟨wcLdpGrHom F F' N, fun p => rfl, rfl⟩
    have hX : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) F) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 1 := fun a =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X F a)
    have hfX : ∀ a : Fin (N + 1), f (MvPolynomial.X a) = MvPolynomial.X a := fun a => by
      rw [hfmap, MvPolynomial.map_X]

    have hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≤
        HomogeneousIdeal.map f
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)) := by
      intro p hp
      have hp' : p ∈ Ideal.span (Set.range (MvPolynomial.X :
          Fin (N + 1) → MvPolynomial (Fin (N + 1)) F')) := hspan F' hp
      change p ∈ (HomogeneousIdeal.map f _).toIdeal
      rw [HomogeneousIdeal.toIdeal_map]
      refine (Ideal.span_le.mpr ?_) hp'
      rintro _ ⟨i, rfl⟩
      rw [← hfX i]
      apply Ideal.mem_map_of_mem
      change MvPolynomial.X i ∈ HomogeneousIdeal.irrelevant _
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne _ (hX i) one_ne_zero

    have s3 : ∀ {P : Submonoid (MvPolynomial (Fin (N + 1)) F)}
        {Q : Submonoid (MvPolynomial (Fin (N + 1)) F')} (comap_le : P ≤ Submonoid.comap f Q)
        (z : HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) P)
        (n : MvPolynomial (Fin (N + 1)) F) (d : P), z.val = Localization.mk n d →
        (HomogeneousLocalization.map f comap_le z).val =
          Localization.mk (f n) ⟨f d, comap_le d.2⟩ := by
      intro P Q comap_le z n d h
      obtain ⟨x, rfl⟩ := HomogeneousLocalization.mk_surjective z
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      rw [HomogeneousLocalization.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h
      obtain ⟨c, hc⟩ := h
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨⟨f c, comap_le c.2⟩, ?_⟩
      have := congrArg f hc
      simp only [map_mul] at this
      exact this

    have hchart : ∀ a : Fin (N + 1), IsPullback
        (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))))
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))))
        (Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
      intro a
      obtain ⟨e, heC, heX⟩ := s2 F a (MvPolynomial.X a) rfl
      obtain ⟨e', he'C, he'X⟩ := s2 F' a (f (MvPolynomial.X a)) (hfX a)

      have hcompat : ∀ p : MvPolynomial (Fin N) F,
          HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e p) =
            e' (MvPolynomial.map (algebraMap F F') p) := by
        have key : (HomogeneousLocalization.Away.map f (MvPolynomial.X a)).comp e.toRingHom =
            e'.toRingHom.comp (MvPolynomial.map (algebraMap F F')) := by
          apply MvPolynomial.ringHom_ext
          · intro c
            show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.C c)) =
              e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.C c))
            rw [MvPolynomial.map_C, heC, he'C]
            apply HomogeneousLocalization.val_injective _
            rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ (MvPolynomial.C c) 1 (V0 F _ c),
              V0 F' _ (algebraMap F F' c)]
            congr 1
            · rw [hfmap, MvPolynomial.map_C]
            · ext
              simp
          · intro j
            show HomogeneousLocalization.Away.map f (MvPolynomial.X a) (e (MvPolynomial.X j)) =
              e' (MvPolynomial.map (algebraMap F F') (MvPolynomial.X j))
            rw [MvPolynomial.map_X]
            apply HomogeneousLocalization.val_injective _
            rw [HomogeneousLocalization.Away.map.eq_1, s3 _ _ _ _ (heX j), he'X j]
            congr 1
            rw [hfmap, MvPolynomial.map_X]
        intro p
        exact RingHom.congr_fun key p

      have P : IsPushout
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
          (CommRingCat.ofHom (algebraMap F F'))
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a)))
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
        letI := (MvPolynomial.algebraMvPolynomial :
          Algebra (MvPolynomial (Fin N) F) (MvPolynomial (Fin N) F'))
        have P0 := CommRingCat.isPushout_of_isPushout F (MvPolynomial (Fin N) F) F'
          (MvPolynomial (Fin N) F')
        refine IsPushout.of_iso P0 (Iso.refl _) e.toCommRingCatIso (Iso.refl _) e'.toCommRingCatIso
          ?_ ?_ ?_ ?_
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact heC c
        · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro p
          exact (hcompat p).symm
        · apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          exact he'C c
      have hj : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hj' : Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) =
          Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            (Submonoid.powers (f (MvPolynomial.X a)))).comp
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
        rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hj, hj']
      exact isPullback_SpecMap_of_isPushout _ _ _ _ P
    have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
        (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
      simp only [Proj.opensRange_awayι]
      exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
    have hcomm : ∀ a : Fin (N + 1),
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
          Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
              Nat.one_pos := fun a =>
      Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
    have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
          Nat.one_pos).opensRange =
        (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
            (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
      rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
    have H := s6 (Proj.map f hf)
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
            (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
      (Spec.map (CommRingCat.ofHom (algebraMap F F')))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
      (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
        (hX a) Nat.one_pos)
      (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
        (f.map_mem (hX a)) Nat.one_pos)
      (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
      hcov hcomm hpre hchart
    subst hfdef
    exact H

  have COMP : ∀ (A B C : Type u) [Field A] [Field B] [Field C] [Algebra A B] [Algebra B C]
      [Algebra A C] [IsScalarTower A B C],
      wcLdpProjMap B C N ≫ wcLdpProjMap A B N = wcLdpProjMap A C N := by
    intro A B C _ _ _ _ _ _ _
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C))
    have hgf : (wcLdpGrHom B C N).comp (wcLdpGrHom A B N) = wcLdpGrHom A C N := by
      apply GradedRingHom.ext
      intro p
      show MvPolynomial.map (algebraMap B C) (MvPolynomial.map (algebraMap A B) p) =
        MvPolynomial.map (algebraMap A C) p
      rw [MvPolynomial.map_map, ← IsScalarTower.algebraMap_eq]
    have key : ∀ (f₁ f₂ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C)
        (h₁ : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C) ≤
          HomogeneousIdeal.map f₁
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)))
        (h₂ : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) C) ≤
          HomogeneousIdeal.map f₂
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))),
        f₁ = f₂ → Proj.map f₁ h₁ = Proj.map f₂ h₂ := by
      intro f₁ f₂ h₁ h₂ e
      subst e
      rfl
    obtain ⟨hAB, eAB⟩ : ∃ h, wcLdpProjMap A B N = Proj.map (wcLdpGrHom A B N) h := ⟨_, rfl⟩
    obtain ⟨hBC, eBC⟩ : ∃ h, wcLdpProjMap B C N = Proj.map (wcLdpGrHom B C N) h := ⟨_, rfl⟩
    obtain ⟨hAC, eAC⟩ : ∃ h, wcLdpProjMap A C N = Proj.map (wcLdpGrHom A C N) h := ⟨_, rfl⟩
    rw [eAB, eBC, eAC, ← Proj.map_comp]
    exact key _ _ _ _ hgf

  have PRE : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B] (a : Fin (N + 1)),
      wcLdpProjMap A B N ⁻¹ᵁ wcSgD A N a = wcSgD B N a := by
    intro A B _ _ _ a
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
    obtain ⟨hf, ehf⟩ : ∃ h, wcLdpProjMap A B N = Proj.map (wcLdpGrHom A B N) h := ⟨_, rfl⟩
    have h1 : Proj.map (wcLdpGrHom A B N) hf ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (MvPolynomial.X a) =
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B)
          (wcLdpGrHom A B N (MvPolynomial.X a)) :=
      Proj.map_preimage_basicOpen _ _ _
    have h2 : wcLdpGrHom A B N (MvPolynomial.X a) = MvPolynomial.X a :=
      MvPolynomial.map_X (algebraMap A B) a
    rw [h2] at h1
    rw [ehf]
    exact h1

  have SEC : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B]
      (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A 2) (a : Fin (N + 1))
      (h : wcSgD B N a ≤ wcLdpProjMap A B N ⁻¹ᵁ wcSgD A N a),
      ((wcLdpProjMap A B N).appLE (wcSgD A N a) (wcSgD B N a) h).hom (wcLdpSec A N G a) =
        wcLdpSec B N (wcLdpMapQ A B N G) a := by
    intro A B _ _ _ G a h
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
    obtain ⟨hf, -⟩ : ∃ h, wcLdpProjMap A B N = Proj.map (wcLdpGrHom A B N) h := ⟨_, rfl⟩
    have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A a)
    have STAR : ∀ (s' : MvPolynomial (Fin (N + 1)) B)
        (hs : wcLdpGrHom A B N (MvPolynomial.X a) = s')
        (hs1 : s' ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B 1)
        (h' : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) s' ≤
          Proj.map (wcLdpGrHom A B N) hf ⁻¹ᵁ
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (MvPolynomial.X a)),
        ((Proj.map (wcLdpGrHom A B N) hf).appLE
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) (MvPolynomial.X a))
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) s') h').hom
          ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)
            (MvPolynomial.X a)).hom
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) hX 2
              (G : MvPolynomial (Fin (N + 1)) A) G.2)) =
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) s').hom
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) hs1 2
            (wcLdpGrHom A B N (G : MvPolynomial (Fin (N + 1)) A))
            ((wcLdpGrHom A B N).map_mem G.2)) := by
      intro s' hs hs1 h'
      subst hs
      have e2 := congrArg (fun φ => CommRingCat.Hom.hom φ
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) hX 2
              (G : MvPolynomial (Fin (N + 1)) A) G.2))
        (Proj.awayToSection_comp_appLE (wcLdpGrHom A B N) hf hX)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom,
        HomogeneousLocalization.Away.map_mk] at e2
      exact e2
    exact STAR (MvPolynomial.X a) (MvPolynomial.map_X (algebraMap A B) a)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X B a)) h

  have GERM : ∀ {X X' P P' : Scheme.{u}} (ρ : X ⟶ X') (jK : X ⟶ P) (jE : X' ⟶ P')
      (β : P ⟶ P') (hcomm : jK ≫ β = ρ ≫ jE) (D : P.Opens) (D' : P'.Opens) (h : D ≤ β ⁻¹ᵁ D')
      (s : Γ(P', D')) (w : X) (hw : w ∈ jK ⁻¹ᵁ D) (hρw : ρ w ∈ jE ⁻¹ᵁ D'),
      (ρ.stalkMap w).hom ((X'.presheaf.germ (jE ⁻¹ᵁ D') (ρ w) hρw).hom ((jE.app D').hom s)) =
        (X.presheaf.germ (jK ⁻¹ᵁ D) w hw).hom ((jK.app D).hom ((β.appLE D' D h).hom s)) := by
    intro X X' P P' ρ jK jE β hcomm D D' h s w hw hρw
    have T : ∀ (g₁ g₂ : X ⟶ P') (e : g₁ = g₂) (hx₁ : w ∈ g₁ ⁻¹ᵁ D') (hx₂ : w ∈ g₂ ⁻¹ᵁ D'),
        g₁.app D' ≫ X.presheaf.germ (g₁ ⁻¹ᵁ D') w hx₁ =
          g₂.app D' ≫ X.presheaf.germ (g₂ ⁻¹ᵁ D') w hx₂ := by
      intro g₁ g₂ e hx₁ hx₂
      subst e
      rfl
    have hx1 : w ∈ (ρ ≫ jE) ⁻¹ᵁ D' := hρw
    have hx2 : w ∈ (jK ≫ β) ⁻¹ᵁ D' := h hw
    have e1 : jE.app D' ≫ X'.presheaf.germ (jE ⁻¹ᵁ D') (ρ w) hρw ≫ ρ.stalkMap w =
        (ρ ≫ jE).app D' ≫ X.presheaf.germ ((ρ ≫ jE) ⁻¹ᵁ D') w hx1 := by
      rw [Scheme.Hom.germ_stalkMap ρ (jE ⁻¹ᵁ D') w hρw, Scheme.Hom.comp_app]
      all_goals exact (Category.assoc _ _ _).symm
    have hw' : jK w ∈ D := hw
    have r1 : P.presheaf.map (homOfLE h).op ≫ P.presheaf.germ D (jK w) hw' =
        P.presheaf.germ (β ⁻¹ᵁ D') (jK w) (h hw') := TopCat.Presheaf.germ_res _ _ _ _
    have r2 := Scheme.Hom.germ_stalkMap jK D w hw'
    have r3 := Scheme.Hom.germ_stalkMap jK (β ⁻¹ᵁ D') w (h hw')
    have e2 : β.appLE D' D h ≫ jK.app D ≫ X.presheaf.germ (jK ⁻¹ᵁ D) w hw =
        (jK ≫ β).app D' ≫ X.presheaf.germ ((jK ≫ β) ⁻¹ᵁ D') w hx2 := by
      rw [Scheme.Hom.appLE.eq_1, Category.assoc, ← r2, reassoc_of% r1, r3, Scheme.Hom.comp_app]
      all_goals exact (Category.assoc _ _ _).symm
    have key : jE.app D' ≫ X'.presheaf.germ (jE ⁻¹ᵁ D') (ρ w) hρw ≫ ρ.stalkMap w =
        β.appLE D' D h ≫ jK.app D ≫ X.presheaf.germ (jK ⁻¹ᵁ D) w hw := by
      rw [e1, e2]
      exact T _ _ hcomm.symm hx1 hx2
    exact congrArg (fun φ => CommRingCat.Hom.hom φ s) key

  have CONS : ∀ (L : Type u) [Field L] [Algebra F' L],
      ∃ jL : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))) ⟶ wcProjK L N,
        IsClosedImmersion jL ∧
        jL ≫ wcProjKStr L N =
          Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))) ∧
        jL ≫ wcLdpProjMap F' L N =
          Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))) ≫ j := by
    intro L _ _
    have PBL := PB F' L
    have wL : (Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))) ≫ j) ≫
        wcProjKStr F' N =
        Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap F' L)) := by
      rw [Category.assoc, hjY, Limits.pullback.condition]
    refine ⟨PBL.lift _ _ wL, ?_, PBL.lift_snd _ _ wL, PBL.lift_fst _ _ wL⟩
    have hO : IsPullback (PBL.lift _ _ wL ≫ wcProjKStr L N)
        (Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' L))))
        (Spec.map (CommRingCat.ofHom (algebraMap F' L))) (j ≫ wcProjKStr F' N) := by
      rw [PBL.lift_snd, hjY]
      exact (IsPullback.of_hasPullback _ _).flip
    have Lsq := IsPullback.of_right hO (PBL.lift_fst _ _ wL) PBL.flip
    exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) Lsq.flip hj
  obtain ⟨jK, hjK, hjKs, hjKf⟩ := CONS K
  refine ⟨jK, hjK, hjKs, ?_⟩
  intro E _ _ _ _
  obtain ⟨jE, hjE, hjEs, hjEf⟩ := CONS E
  have ρ1 : wcLdpRho F' E K Y ≫
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) :=
    Limits.pullback.lift_fst _ _ _
  have ρ2 : wcLdpRho F' E K Y ≫
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap E K)) :=
    Limits.pullback.lift_snd _ _ _

  have SQ : jK ≫ wcLdpProjMap E K N = wcLdpRho F' E K Y ≫ jE := by
    apply (PB F' E).hom_ext
    · calc (jK ≫ wcLdpProjMap E K N) ≫ wcLdpProjMap F' E N = jK ≫ wcLdpProjMap F' K N := by
            rw [Category.assoc, COMP F' E K]
        _ = Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ≫ j := hjKf
        _ = (wcLdpRho F' E K Y ≫
              Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))) ≫ j := by
            rw [ρ1]
        _ = (wcLdpRho F' E K Y ≫ jE) ≫ wcLdpProjMap F' E N := by
            rw [Category.assoc, Category.assoc, hjEf]
    · calc (jK ≫ wcLdpProjMap E K N) ≫ wcProjKStr E N =
            (jK ≫ wcProjKStr K N) ≫ Spec.map (CommRingCat.ofHom (algebraMap E K)) := by
            rw [Category.assoc, (PB E K).toCommSq.w]
            all_goals exact (Category.assoc _ _ _).symm
        _ = Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ≫
              Spec.map (CommRingCat.ofHom (algebraMap E K)) := by rw [hjKs]
        _ = wcLdpRho F' E K Y ≫
              Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) := ρ2.symm
        _ = (wcLdpRho F' E K Y ≫ jE) ≫ wcProjKStr E N := by rw [Category.assoc, hjEs]
  refine ⟨jE, hjE, hjEs, ?_, ?_⟩
  · intro w a
    have e : wcLdpProjMap E K N (jK w) = jE (wcLdpRho F' E K Y w) := by
      change (jK ≫ wcLdpProjMap E K N) w = (wcLdpRho F' E K Y ≫ jE) w
      rw [SQ]
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, ← PRE E K a, Scheme.Hom.mem_preimage, e]
  · intro G w a hw hρw
    have hle : wcSgD K N a ≤ wcLdpProjMap E K N ⁻¹ᵁ wcSgD E N a := (PRE E K a).symm.le
    have H := GERM (wcLdpRho F' E K Y) jK jE (wcLdpProjMap E K N) SQ (wcSgD K N a) (wcSgD E N a)
      hle (wcLdpSec E N G a) w hw hρw
    rw [SEC E K G a hle] at H
    exact H

theorem wc_ldp_dgp_rho_flat (F' E K : Type u) [Field F'] [Field E] [Field K] [Algebra F' E]
    [Algebra F' K] [Algebra E K] [IsScalarTower F' E K] (Y : Over (Spec (.of F'))) :
    Function.Surjective (wcLdpRho F' E K Y) ∧
      ∀ w, ((wcLdpRho F' E K Y).stalkMap w).hom.Flat :=
by
  classical
  have hfst : wcLdpRho F' E K Y ≫
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) :=
    Limits.pullback.lift_fst _ _ _
  have hsnd : wcLdpRho F' E K Y ≫
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap E K)) :=
    Limits.pullback.lift_snd _ _ _
  have hφ : Spec.map (CommRingCat.ofHom (algebraMap E K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F' E)) =
      Spec.map (CommRingCat.ofHom (algebraMap F' K)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
  have hout : IsPullback (wcLdpRho F' E K Y ≫
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
      (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))) Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap E K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F' E))) := by
    rw [hfst, hφ]
    exact IsPullback.of_hasPullback _ _
  have hpb := IsPullback.of_right hout hsnd
    (IsPullback.of_hasPullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
  have hFlat : Flat (wcLdpRho F' E K Y) :=
    MorphismProperty.of_isPullback (P := @Flat) hpb.flip inferInstance
  have hSurj : Surjective (wcLdpRho F' E K Y) :=
    MorphismProperty.of_isPullback (P := @Surjective) hpb.flip inferInstance
  refine ⟨hSurj.surj, fun w => ?_⟩
  haveI := hFlat
  exact Flat.stalkMap (wcLdpRho F' E K Y) w

theorem wc_ldp_dgp_rho_maxideal (F' E K : Type u) [Field F'] [Field E] [Field K] [Algebra F' E]
    [Algebra F' K] [Algebra E K] [IsScalarTower F' E K] [PerfectField E]
    [Algebra.IsAlgebraic E K] (Y : Over (Spec (.of F'))) [LocallyOfFiniteType Y.hom] :
    ∀ w, Ideal.map ((wcLdpRho F' E K Y).stalkMap w).hom (IsLocalRing.maximalIdeal _) =
      IsLocalRing.maximalIdeal _ :=
by
  classical

  have s1 : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra E D],
      IsReduced (TensorProduct E D K) := by
    intro D _ _ _
    let L := FractionRing D
    haveI : Module.Flat E K := Module.Flat.of_free
    haveI : Module.Flat E L := @Module.Flat.of_free _ _ _ _ _ (Module.Free.of_divisionRing E L)
    haveI : Algebra.IsIntegral E K := Algebra.IsAlgebraic.isIntegral
    haveI : Algebra.IsSeparable E K := Algebra.IsAlgebraic.isSeparable_of_perfectField
    have hLK : IsReduced (TensorProduct E L K) := by
      apply IsReduced.tensorProduct_of_flat_of_forall_fg
      intro B hB
      obtain ⟨t, htf, rfl⟩ := Subalgebra.fg_def.mp hB
      haveI : Finite t := htf.to_subtype
      let B' := IntermediateField.adjoin E t
      haveI : FiniteDimensional E B' :=
        IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
      haveI : Algebra.IsSeparable E B' := IntermediateField.isSeparable_tower_bot E B'
      haveI : Algebra.FormallyUnramified E B' := Algebra.FormallyUnramified.of_isSeparable E B'
      haveI : Algebra.FormallyUnramified L (TensorProduct E L B') :=
        Algebra.FormallyUnramified.base_change L
      haveI : Module.Finite L (TensorProduct E L B') := Module.Finite.base_change E L B'
      haveI : Algebra.EssFiniteType L (TensorProduct E L B') := inferInstance
      haveI : IsReduced (TensorProduct E L B') :=
        Algebra.FormallyUnramified.isReduced_of_field L (TensorProduct E L B')
      let ι : ↥(Algebra.adjoin E t) →ₐ[E] ↥B' :=
        { toFun := fun x => ⟨x.1, IntermediateField.algebra_adjoin_le_adjoin E t x.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl }
      have hι : Function.Injective ι := fun a b h =>
        Subtype.ext (congrArg (fun x : B' => (x : K)) h)
      let Ψ := Algebra.TensorProduct.map (AlgHom.id E L) ι
      have hΨ : Function.Injective Ψ :=
        Module.Flat.lTensor_preserves_injective_linearMap (M := L) ι.toLinearMap hι
      exact isReduced_of_injective Ψ hΨ
    let j : D →ₐ[E] L := IsScalarTower.toAlgHom E D L
    have hj : Function.Injective j := IsFractionRing.injective D L
    let Φ := Algebra.TensorProduct.map j (AlgHom.id E K)
    have hΦ : Function.Injective Φ :=
      Module.Flat.rTensor_preserves_injective_linearMap (M := K) j.toLinearMap hj
    exact isReduced_of_injective Φ hΦ

  have s2 : ∀ (D R : Type u) [CommRing D] [CommRing R] [Algebra D R]
      [Algebra.IsIntegral D R] [IsReduced R] (Q : Ideal R) [Q.IsPrime],
      Ideal.comap (algebraMap D R) Q = ⊥ → ∀ x ∈ Q, ∃ s ∉ Q, s * x = 0 := by
    intro D R _ _ _ _ _ Q _ hQ
    have hmin : Q ∈ minimalPrimes R := by
      refine ⟨⟨inferInstance, bot_le⟩, fun r hr hrQ => ?_⟩
      haveI := hr.1
      by_contra hne
      obtain ⟨x, hxQ, hxr⟩ := Set.not_subset.mp hne
      have h := Ideal.under_lt_under_of_integral_mem_sdiff (R := D) hrQ ⟨hxQ, hxr⟩
        (Algebra.IsIntegral.isIntegral x)
      rw [Ideal.under, Ideal.under, hQ] at h
      exact not_lt_bot h
    intro x hx
    haveI := Ring.KrullDimLE.of_isLocalization Q hmin (Localization.AtPrime Q)
    haveI : IsReduced (Localization.AtPrime Q) :=
      isReduced_localizationPreserves Q.primeCompl (Localization.AtPrime Q) ‹_›
    have hf := Ring.KrullDimLE.isField_of_isReduced (R := Localization.AtPrime Q)
    have hm := IsLocalRing.isField_iff_maximalIdeal_eq.mp hf
    have h1 : algebraMap R (Localization.AtPrime Q) x ∈ IsLocalRing.maximalIdeal _ :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q x).mpr hx
    rw [hm, Ideal.mem_bot] at h1
    obtain ⟨m, hm⟩ :=
      (IsLocalization.map_eq_zero_iff Q.primeCompl (Localization.AtPrime Q) x).mp h1
    exact ⟨m, m.2, hm⟩

  have hann : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra E D]
      (Q : Ideal (TensorProduct E D K)) [Q.IsPrime],
      Ideal.comap (Algebra.TensorProduct.includeLeftRingHom : D →+* TensorProduct E D K) Q = ⊥ →
      ∀ x ∈ Q, ∃ s ∉ Q, s * x = 0 := by
    intro D _ _ _ Q _ hQ
    haveI := s1 D
    haveI : Algebra.IsIntegral E K := Algebra.IsAlgebraic.isIntegral
    haveI : Algebra.IsIntegral D (TensorProduct E D K) := Algebra.IsIntegral.tensorProduct E D K
    have hal : algebraMap D (TensorProduct E D K) =
        (Algebra.TensorProduct.includeLeftRingHom : D →+* TensorProduct E D K) :=
      RingHom.ext fun d => by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.includeLeftRingHom_apply]
        rfl
    refine s2 D (TensorProduct E D K) Q ?_
    rw [hal]
    exact hQ

  have hloc : ∀ (A : Type u) [CommRing A] [Algebra E A] (q : Ideal (TensorProduct E A K))
      [q.IsPrime],
      Ideal.map (Localization.localRingHom
          (Ideal.comap (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct E A K) q) q
          Algebra.TensorProduct.includeLeftRingHom rfl) (IsLocalRing.maximalIdeal _) =
        IsLocalRing.maximalIdeal _ := by
    intro A _ _ q _
    set f : A →+* TensorProduct E A K := Algebra.TensorProduct.includeLeftRingHom with hf
    set p := Ideal.comap f q with hp
    haveI : p.IsPrime := Ideal.IsPrime.comap f
    let π : TensorProduct E A K →ₐ[E] TensorProduct E (A ⧸ p) K :=
      Algebra.TensorProduct.map (Ideal.Quotient.mkₐ E p) (AlgHom.id E K)
    have hπs : Function.Surjective π :=
      TensorProduct.map_surjective (Ideal.Quotient.mkₐ_surjective E p) Function.surjective_id
    have hker : RingHom.ker π = Ideal.map f p := by
      have := Algebra.TensorProduct.rTensor_ker (R := E) (S := E) (C := K)
        (Ideal.Quotient.mkₐ E p) (Ideal.Quotient.mkₐ_surjective E p)
      have h2 : RingHom.ker (Ideal.Quotient.mkₐ E p) = p := by
        ext a
        rw [RingHom.mem_ker, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      rw [this, h2]
      rfl
    have hpq : Ideal.map f p ≤ q := Ideal.map_le_iff_le_comap.mpr le_rfl
    haveI hQp : (Ideal.map π q).IsPrime := Ideal.map_isPrime_of_surjective hπs (hker ▸ hpq)
    have hcomapQ : Ideal.comap π (Ideal.map π q) = q := by
      rw [Ideal.comap_map_of_surjective' π hπs, hker]
      exact sup_eq_left.mpr hpq
    have hQbot : Ideal.comap (Algebra.TensorProduct.includeLeftRingHom :
        (A ⧸ p) →+* TensorProduct E (A ⧸ p) K) (Ideal.map π q) = ⊥ := by
      rw [eq_bot_iff]
      intro d hd
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective d
      rw [Ideal.mem_comap] at hd
      have h1 : π (f a) = Algebra.TensorProduct.includeLeftRingHom (Ideal.Quotient.mk p a) := by
        simp [π, hf, Algebra.TensorProduct.includeLeftRingHom_apply]
      have h2 : f a ∈ q := by
        rw [← hcomapQ, Ideal.mem_comap, h1]
        exact hd
      rw [Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
      exact h2
    have hx : ∀ x ∈ q, ∃ s ∉ q, s * x ∈ Ideal.map f p := by
      intro x hxq
      obtain ⟨s', hs'Q, hs'⟩ :=
        hann (A ⧸ p) (Ideal.map π q) hQbot (π x) (Ideal.mem_map_of_mem π hxq)
      obtain ⟨s, rfl⟩ := hπs s'
      refine ⟨s, fun hs => hs'Q (Ideal.mem_map_of_mem π hs), ?_⟩
      rw [← hker, RingHom.mem_ker, map_mul, hs']
    have hmapq : Ideal.map (algebraMap _ (Localization.AtPrime q)) q ≤
        Ideal.map (algebraMap _ (Localization.AtPrime q)) (Ideal.map f p) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hxq
      obtain ⟨s, hs, hsx⟩ := hx x hxq
      rw [Ideal.mem_comap]
      have hu : IsUnit (algebraMap _ (Localization.AtPrime q) s) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q s).mpr hs
      have : algebraMap _ (Localization.AtPrime q) x =
          (↑hu.unit⁻¹ : Localization.AtPrime q) * algebraMap _ (Localization.AtPrime q) (s * x) := by
        rw [map_mul, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hsx)
    have hTq : Ideal.map (algebraMap _ (Localization.AtPrime q)) (Ideal.map f p) =
        IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
      apply le_antisymm
      · rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact Ideal.map_mono hpq
      · rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact hmapq
    have hcomp : (Localization.localRingHom p q f rfl).comp (algebraMap A (Localization.AtPrime p)) =
        (algebraMap _ (Localization.AtPrime q)).comp f :=
      RingHom.ext fun a => Localization.localRingHom_to_map p q f rfl a
    rw [← Localization.AtPrime.map_eq_maximalIdeal (I := p), Ideal.map_map, hcomp,
      ← Ideal.map_map, hTq]

  let P : ∀ {R S : Type u} [CommRing R] [CommRing S], (R →+* S) → Prop :=
    fun {R S} _ _ f => ∀ (hR : IsLocalRing R) (hS : IsLocalRing S),
      Ideal.map f (@IsLocalRing.maximalIdeal R _ hR) = @IsLocalRing.maximalIdeal S _ hS
  have hP : RingHom.RespectsIso P := by
    constructor
    · intro R S T _ _ _ f e hf hR hT
      letI := hR
      letI := hT
      letI hS : IsLocalRing S := e.symm.isLocalRing
      have h1 := hf hR hS
      show Ideal.map (e.toRingHom.comp f) _ = _
      rw [← Ideal.map_map, h1]
      haveI : (IsLocalRing.maximalIdeal S).IsMaximal := IsLocalRing.maximalIdeal.isMaximal S
      exact IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv e)
    · intro R S T _ _ _ f e hf hR hT
      letI := hR
      letI := hT
      letI hS : IsLocalRing S := e.isLocalRing
      show Ideal.map (f.comp e.toRingHom) _ = _
      rw [← Ideal.map_map]
      have h2 : Ideal.map e.toRingHom (IsLocalRing.maximalIdeal R) =
          IsLocalRing.maximalIdeal S := by
        haveI : (IsLocalRing.maximalIdeal R).IsMaximal := IsLocalRing.maximalIdeal.isMaximal R
        exact IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv e)
      rw [h2]
      exact hf hS hT
  haveI := stalkwiseIsZariskiLocalAtTarget_of_respectsIso hP
  haveI := stalkwise_respectsIso hP
  haveI := HasRingHomProperty.stalkwise hP
  set ρ := wcLdpRho F' E K Y with hρ
  set sK := Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))
  set sE := Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))
  set φ := Spec.map (CommRingCat.ofHom (algebraMap E K))
  have hsq : IsPullback ρ sK sE φ := by
    refine IsPullback.of_right (h₁₂ := Limits.pullback.fst Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' E))))
      (h₂₂ := Spec.map (CommRingCat.ofHom (algebraMap F' E))) (v₁₃ := Y.hom) ?_
      (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback _ _)
    have e1 : ρ ≫ Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
        Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) :=
      Limits.pullback.lift_fst _ _ _
    have e2 : φ ≫ Spec.map (CommRingCat.ofHom (algebraMap F' E)) =
        Spec.map (CommRingCat.ofHom (algebraMap F' K)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    rw [e1, e2]
    exact IsPullback.of_hasPullback _ _
  have key : ∀ (R : CommRingCat.{u})
      (g : Spec R ⟶ Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))),
      stalkwise P (Limits.pullback.snd ρ g) := by
    intro R g
    letI : Algebra E R := (Spec.preimage (g ≫ sE)).hom.toAlgebra
    have hg : g ≫ sE = Spec.map (CommRingCat.ofHom (algebraMap E R)) := by
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
    have h1 := (IsPullback.of_hasPullback ρ g).flip.paste_vert hsq
    rw [hg] at h1
    have h2 := isPullback_SpecMap_of_isPushout _ _ _ _ (CommRingCat.isPushout_tensorProduct E R K)
    let e := IsPullback.isoIsPullback _ _ h1 h2
    have he : e.hom ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
        Limits.pullback.snd ρ g := IsPullback.isoIsPullback_hom_fst _ _ h1 h2
    have harr : Arrow.mk (Limits.pullback.snd ρ g) ≅
        Arrow.mk (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct E R K))) :=
      Arrow.isoMk e (Iso.refl _) (by simp [he])
    refine (MorphismProperty.arrow_mk_iso_iff (stalkwise P) harr).mpr ?_
    refine (HasRingHomProperty.Spec_iff (P := stalkwise P)).mpr ?_
    intro p hp hR hS
    exact hloc R p
  have hρP : stalkwise P ρ := by
    let 𝒰 :=
      (Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))).affineOpenCover
    apply IsZariskiLocalAtTarget.of_openCover 𝒰.openCover
    intro i
    rw [Scheme.Cover.pullbackHom.eq_1]
    exact key (𝒰.X i) (𝒰.f i)
  intro w
  exact hρP w inferInstance inferInstance

theorem wc_ldp_dgp_points (F' K : Type u) [Field F'] [Field K] [Algebra F' K]
    (Y : Over (Spec (.of F'))) [LocallyOfFiniteType Y.hom]
    (y : Spec (.of K) ⟶ Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))))
    (hy : y ≫ Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) = 𝟙 _) :
    ∃ T : Finset K, ∀ (E : Type u) [Field E] [Algebra F' E] [Algebra E K] [IsScalarTower F' E K],
      (↑T : Set K) ⊆ Set.range (algebraMap E K) →
      ∃ yE : Spec (.of E) ⟶ Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))),
        yE ≫ Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) = 𝟙 _ ∧
        wcLdpRho F' E K Y (y (IsLocalRing.closedPoint K)) = yE (IsLocalRing.closedPoint E) :=
by
  classical

  have halg : ∀ {A : Type u} [CommRing A] (ψ : F' →+* A) (_ : ψ.FiniteType) (φ : A →+* K)
      (_ : φ.comp ψ = algebraMap F' K),
      ∃ T : Finset K, ∀ (E : Type u) [Field E] [Algebra F' E] [Algebra E K] [IsScalarTower F' E K],
        (↑T : Set K) ⊆ Set.range (algebraMap E K) →
        ∃ φE : A →+* E, (algebraMap E K).comp φE = φ ∧ φE.comp ψ = algebraMap F' E := by
    intro A _ ψ hψ φ hφ
    letI := ψ.toAlgebra
    obtain ⟨t, ht⟩ := hψ.out
    refine ⟨t.image φ, ?_⟩
    intro E _ _ _ _ hT
    have hmem : ∀ a : A, φ a ∈ (algebraMap E K).range := by
      intro a
      have ha : a ∈ Algebra.adjoin F' (t : Set A) := by rw [ht]; exact Algebra.mem_top
      induction ha using Algebra.adjoin_induction with
      | mem x hx =>
        exact RingHom.mem_range.mpr (hT (Finset.mem_coe.mpr (Finset.mem_image_of_mem φ hx)))
      | algebraMap r =>
        refine RingHom.mem_range.mpr ⟨algebraMap F' E r, ?_⟩
        rw [← IsScalarTower.algebraMap_apply, ← hφ]
        rfl
      | add x y _ _ hx hy => rw [map_add]; exact Subring.add_mem _ hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact Subring.mul_mem _ hx hy
    have hinj : Function.Injective (algebraMap E K) := (algebraMap E K).injective
    let e : E ≃+* (algebraMap E K).range := RingEquiv.ofBijective (algebraMap E K).rangeRestrict
      ⟨fun a b h => hinj (by
          have h2 := congrArg Subtype.val h
          rwa [RingHom.coe_rangeRestrict, RingHom.coe_rangeRestrict] at h2),
        (algebraMap E K).rangeRestrict_surjective⟩
    let φE : A →+* E := e.symm.toRingHom.comp (φ.codRestrict _ hmem)
    have hc : (algebraMap E K).comp φE = φ := by
      ext a
      rw [RingHom.comp_apply, ← RingHom.coe_rangeRestrict]
      show ((e (e.symm (φ.codRestrict _ hmem a))) : K) = _
      rw [RingEquiv.apply_symm_apply, RingHom.codRestrict_apply]
    refine ⟨φE, hc, ?_⟩
    ext r
    apply hinj
    rw [RingHom.comp_apply, ← RingHom.comp_apply (algebraMap E K) φE, hc,
      ← IsScalarTower.algebraMap_apply, ← hφ]
    rfl

  have hu : (y ≫ Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K)))) ≫
      Y.hom = Spec.map (CommRingCat.ofHom (algebraMap F' K)) := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hy, Category.id_comp]
  obtain ⟨W, hW, hpW, -⟩ := exists_isAffineOpen_mem_and_subset (X := Y.left)
    (x := (y ≫ Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))))
      (IsLocalRing.closedPoint K)) (U := ⊤) trivial
  have hrange : Set.range (y ≫ Limits.pullback.fst Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' K)))) ⊆ Set.range hW.fromSpec := by
    rintro _ ⟨z, rfl⟩
    rw [hW.range_fromSpec, Subsingleton.elim z (IsLocalRing.closedPoint K)]
    exact hpW
  obtain ⟨v, hv⟩ : ∃ v, v ≫ hW.fromSpec = y ≫ Limits.pullback.fst Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' K))) :=
    ⟨IsOpenImmersion.lift hW.fromSpec _ hrange, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨ψ, hψS⟩ : ∃ ψ, Spec.map ψ = hW.fromSpec ≫ Y.hom := ⟨Spec.preimage _, Spec.map_preimage _⟩
  obtain ⟨φ, hφS⟩ : ∃ φ, Spec.map φ = v := ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hft : ψ.hom.FiniteType := by
    have : LocallyOfFiniteType (Spec.map ψ) := by rw [hψS]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
  have hcomp : ψ ≫ φ = CommRingCat.ofHom (algebraMap F' K) := by
    apply Spec.map_injective
    rw [Spec.map_comp, hφS, hψS, ← Category.assoc, hv, hu]
  have hφ : φ.hom.comp ψ.hom = algebraMap F' K := by
    rw [← CommRingCat.hom_comp, hcomp, CommRingCat.hom_ofHom]
  obtain ⟨T, hT⟩ := halg ψ.hom hft φ.hom hφ
  refine ⟨T, ?_⟩
  intro E _ _ _ _ hTE
  obtain ⟨φE, hc, hd⟩ := hT E hTE
  have hψE : ψ ≫ CommRingCat.ofHom φE = CommRingCat.ofHom (algebraMap F' E) := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom, hd]
  have hg : (Spec.map (CommRingCat.ofHom φE) ≫ hW.fromSpec) ≫ Y.hom =
      Spec.map (CommRingCat.ofHom (algebraMap F' E)) := by
    rw [Category.assoc, ← hψS, ← Spec.map_comp, hψE]
  obtain ⟨yE, hyE1, hyE2⟩ : ∃ yE : Spec (.of E) ⟶
      Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))),
      yE ≫ Limits.pullback.fst _ _ = Spec.map (CommRingCat.ofHom φE) ≫ hW.fromSpec ∧
      yE ≫ Limits.pullback.snd _ _ = 𝟙 _ :=
    ⟨Limits.pullback.lift _ (𝟙 _) (by rw [hg, Category.id_comp]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  refine ⟨yE, hyE2, ?_⟩
  have hρ1 : wcLdpRho F' E K Y ≫
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) :=
    Limits.pullback.lift_fst _ _ _
  have hρ2 : wcLdpRho F' E K Y ≫
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) =
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' K))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap E K)) :=
    Limits.pullback.lift_snd _ _ _
  have hmor : y ≫ wcLdpRho F' E K Y = Spec.map (CommRingCat.ofHom (algebraMap E K)) ≫ yE := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hρ1, hyE1, ← Category.assoc, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, hc, CommRingCat.ofHom_hom, hφS, hv]
    · rw [Category.assoc, Category.assoc, hρ2, hyE2, ← Category.assoc, hy, Category.id_comp,
        Category.comp_id]
  have h1 : (y ≫ wcLdpRho F' E K Y) (IsLocalRing.closedPoint K) =
      (Spec.map (CommRingCat.ofHom (algebraMap E K)) ≫ yE) (IsLocalRing.closedPoint K) := by
    rw [hmor]
  exact (Scheme.Hom.comp_apply _ _ _).symm.trans
    (h1.trans ((Scheme.Hom.comp_apply _ _ _).trans (congrArg yE (Subsingleton.elim _ _))))

theorem wc_ldp_dgp_flat_indep {R S : Type u} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsLocalRing S] (f : R →+* S) [IsLocalHom f] (hf : f.Flat) (I : Ideal R) (r : ℕ)
    (v : Fin r → R)
    (hv : ∀ a : Fin r → R, ∑ j, a j * v j ∈ I → ∀ j, a j ∈ IsLocalRing.maximalIdeal R) :
    ∀ s : Fin r → S, ∑ j, s j * f (v j) ∈ I.map f → ∀ j, s j ∈ IsLocalRing.maximalIdeal S :=
by
  intro s hs j₀
  letI := f.toAlgebra
  have : Module.Flat R S := hf
  have hs' : ∑ j, s j * f (v j) ∈ Submodule.span S (f '' (I : Set R)) := hs
  obtain ⟨m, t, g, hg⟩ := Submodule.mem_span_set'.mp hs'
  choose x hxI hfx using fun k => (g k).2
  have E1 : ∑ j, s j * f (v j) = ∑ k, t k * f (x k) := by
    rw [← hg]
    simp only [smul_eq_mul, hfx]
  let c : Fin r ⊕ Fin m → R := Sum.elim v (fun k => - x k)
  let y : Fin r ⊕ Fin m → S := Sum.elim s t
  have hrel : ∑ i, c i • y i = 0 := by
    rw [Fintype.sum_sum_type]
    simp only [c, y, Sum.elim_inl, Sum.elim_inr, Algebra.smul_def, RingHom.algebraMap_toAlgebra,
      map_neg, neg_mul, Finset.sum_neg_distrib]
    rw [← sub_eq_add_neg, sub_eq_zero]
    calc ∑ j, f (v j) * s j = ∑ j, s j * f (v j) :=
          Finset.sum_congr rfl (fun j _ => mul_comm _ _)
      _ = ∑ k, t k * f (x k) := E1
      _ = ∑ k, f (x k) * t k := Finset.sum_congr rfl (fun k _ => mul_comm _ _)
  have htriv : Module.IsTrivialRelation c y :=
    Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
  obtain ⟨K, a, z, hy, hca⟩ := htriv
  have hcol : ∀ l, ∀ j, a (Sum.inl j) l ∈ IsLocalRing.maximalIdeal R := by
    intro l
    apply hv (fun j => a (Sum.inl j) l)
    have h := hca l
    rw [Fintype.sum_sum_type] at h
    simp only [c, Sum.elim_inl, Sum.elim_inr, neg_mul, Finset.sum_neg_distrib] at h
    have h1 := add_neg_eq_zero.mp h
    have h2 : ∑ j, a (Sum.inl j) l * v j = ∑ k, x k * a (Sum.inr k) l := by
      rw [← h1]
      exact Finset.sum_congr rfl (fun j _ => mul_comm _ _)
    rw [h2]
    exact Ideal.sum_mem _ (fun k _ => Ideal.mul_mem_right _ _ (hxI k))
  have hyj := hy (Sum.inl j₀)
  simp only [y, Sum.elim_inl] at hyj
  rw [hyj]
  apply Ideal.sum_mem
  intro l _
  rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
  exact Ideal.mul_mem_right _ _ (map_nonunit f _ (hcol l j₀))

theorem wc_ldp_dgp_gen_descend {R S : Type u} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsLocalRing S] [IsNoetherianRing R] (f : R →+* S) [IsLocalHom f]
    (hm : Ideal.map f (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S)
    (hind : ∀ (r : ℕ) (v : Fin r → R),
      (∀ a : Fin r → R, ∑ j, a j * v j ∈ IsLocalRing.maximalIdeal R ^ 2 →
        ∀ j, a j ∈ IsLocalRing.maximalIdeal R) →
      ∀ s : Fin r → S, ∑ j, s j * f (v j) ∈ IsLocalRing.maximalIdeal S ^ 2 →
        ∀ j, s j ∈ IsLocalRing.maximalIdeal S)
    (g₀ g₁ : R) (k : ℕ) (t' : Fin k → S)
    (h : IsLocalRing.maximalIdeal S = Ideal.span (insert (f g₀) (insert (f g₁) (Set.range t')))) :
    ∃ t : Fin k → R,
      IsLocalRing.maximalIdeal R = Ideal.span (insert g₀ (insert g₁ (Set.range t))) :=
by
  classical

  have hid : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ) (a : Fin n → A)
      (v : Fin n → IsLocalRing.maximalIdeal A),
      ((IsLocalRing.maximalIdeal A).toCotangent (∑ i, a i • v i) : IsLocalRing.CotangentSpace A) =
        ∑ i, IsLocalRing.residue A (a i) •
          ((IsLocalRing.maximalIdeal A).toCotangent (v i) : IsLocalRing.CotangentSpace A) ∧
      ((∑ i, a i • v i : IsLocalRing.maximalIdeal A) : A) = ∑ i, a i * (v i : A) := by
    intro A _ _ n a v
    refine ⟨?_, ?_⟩
    · rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_smul, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
    · simp [smul_eq_mul]

  have hG : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ)
      (z : Fin n → IsLocalRing.maximalIdeal A) (x : IsLocalRing.maximalIdeal A) (a : Fin n → A),
      (x : A) - ∑ i, a i * (z i : A) ∈ IsLocalRing.maximalIdeal A ^ 2 →
      ((IsLocalRing.maximalIdeal A).toCotangent x : IsLocalRing.CotangentSpace A) ∈
        Submodule.span (IsLocalRing.ResidueField A)
          (Set.range (fun i => ((IsLocalRing.maximalIdeal A).toCotangent (z i) :
            IsLocalRing.CotangentSpace A))) := by
    intro A _ _ n z x a hx
    obtain ⟨h1, h2⟩ := hid A n a z
    have e1 : ((IsLocalRing.maximalIdeal A).toCotangent x : IsLocalRing.CotangentSpace A) =
        (IsLocalRing.maximalIdeal A).toCotangent (∑ i, a i • z i) := by
      rw [Ideal.toCotangent_eq, h2]; exact hx
    rw [e1, h1]
    exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))

  have hL : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ)
      (z : Fin n → IsLocalRing.maximalIdeal A) (x : IsLocalRing.maximalIdeal A),
      ((IsLocalRing.maximalIdeal A).toCotangent x : IsLocalRing.CotangentSpace A) ∈
        Submodule.span (IsLocalRing.ResidueField A)
          (Set.range (fun i => ((IsLocalRing.maximalIdeal A).toCotangent (z i) :
            IsLocalRing.CotangentSpace A))) →
      ∃ a : Fin n → A, (x : A) - ∑ i, a i * (z i : A) ∈ IsLocalRing.maximalIdeal A ^ 2 := by
    intro A _ _ n z x hx
    obtain ⟨β, hβ⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
    choose a ha using fun i => IsLocalRing.residue_surjective (β i)
    refine ⟨a, ?_⟩
    obtain ⟨h1, h2⟩ := hid A n a z
    rw [← h2, ← Ideal.toCotangent_eq, h1]
    simp only [ha]
    exact hβ.symm

  have hs1 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (n : ℕ)
      (v : Fin n → IsLocalRing.maximalIdeal A),
      (∀ a : Fin n → A, ∑ j, a j * (v j : A) ∈ IsLocalRing.maximalIdeal A ^ 2 →
          ∀ j, a j ∈ IsLocalRing.maximalIdeal A) ↔
        LinearIndependent (IsLocalRing.ResidueField A)
          (fun j => ((IsLocalRing.maximalIdeal A).toCotangent (v j) :
            IsLocalRing.CotangentSpace A)) := by
    intro A _ _ n v
    rw [Fintype.linearIndependent_iff]
    constructor
    · intro H g hg i
      choose a ha using fun i => IsLocalRing.residue_surjective (g i)
      obtain ⟨h1, h2⟩ := hid A n a v
      have hmem : ∑ j, a j * (v j : A) ∈ IsLocalRing.maximalIdeal A ^ 2 := by
        rw [← h2, ← Ideal.toCotangent_eq_zero, h1]
        simp only [ha]
        exact hg
      rw [← ha i]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr (H a hmem i)
    · intro H a ha j
      obtain ⟨h1, h2⟩ := hid A n a v
      rw [← h2, ← Ideal.toCotangent_eq_zero, h1] at ha
      exact (IsLocalRing.residue_eq_zero_iff _).mp (H _ ha j)

  have hgS : ∀ y ∈ insert (f g₀) (insert (f g₁) (Set.range t')),
      y ∈ IsLocalRing.maximalIdeal S := by
    intro y hy
    rw [h]
    exact Ideal.subset_span hy
  have hgR : ∀ g : R, f g ∈ IsLocalRing.maximalIdeal S → g ∈ IsLocalRing.maximalIdeal R := by
    intro g hg
    by_contra hn
    exact IsLocalRing.notMem_maximalIdeal.mpr ((IsLocalRing.notMem_maximalIdeal.mp hn).map f) hg
  have hg₀S : f g₀ ∈ IsLocalRing.maximalIdeal S := hgS _ (Set.mem_insert _ _)
  have hg₁S : f g₁ ∈ IsLocalRing.maximalIdeal S :=
    hgS _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
  have hg₀ : g₀ ∈ IsLocalRing.maximalIdeal R := hgR _ hg₀S
  have hg₁ : g₁ ∈ IsLocalRing.maximalIdeal R := hgR _ hg₁S
  have ht'm : ∀ l, t' l ∈ IsLocalRing.maximalIdeal S := fun l =>
    hgS _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨l, rfl⟩))

  obtain ⟨W, hWdef⟩ : ∃ W : Submodule (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R),
      W = Submodule.span (IsLocalRing.ResidueField R)
        {((IsLocalRing.maximalIdeal R).toCotangent ⟨g₀, hg₀⟩ : IsLocalRing.CotangentSpace R),
         ((IsLocalRing.maximalIdeal R).toCotangent ⟨g₁, hg₁⟩ : IsLocalRing.CotangentSpace R)} :=
    ⟨_, rfl⟩
  have hW₀ : ((IsLocalRing.maximalIdeal R).toCotangent ⟨g₀, hg₀⟩ : IsLocalRing.CotangentSpace R)
      ∈ W := by
    rw [hWdef]; exact Submodule.subset_span (Set.mem_insert _ _)
  have hW₁ : ((IsLocalRing.maximalIdeal R).toCotangent ⟨g₁, hg₁⟩ : IsLocalRing.CotangentSpace R)
      ∈ W := by
    rw [hWdef]; exact Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  obtain ⟨e, ⟨bW⟩⟩ : ∃ e : ℕ, Nonempty (Module.Basis (Fin e) (IsLocalRing.ResidueField R) W) :=
    ⟨_, ⟨Module.finBasis _ _⟩⟩
  obtain ⟨c, ⟨bQ⟩⟩ : ∃ c : ℕ, Nonempty (Module.Basis (Fin c) (IsLocalRing.ResidueField R)
      (IsLocalRing.CotangentSpace R ⧸ W)) :=
    ⟨_, ⟨Module.finBasis _ _⟩⟩
  choose q hq using fun i : Fin e =>
    (IsLocalRing.maximalIdeal R).toCotangent_surjective (bW i : IsLocalRing.CotangentSpace R)
  have hsurjQ : ∀ y : IsLocalRing.CotangentSpace R ⧸ W, ∃ x : IsLocalRing.maximalIdeal R,
      W.mkQ ((IsLocalRing.maximalIdeal R).toCotangent x) = y := by
    intro y
    obtain ⟨v, rfl⟩ := W.mkQ_surjective y
    obtain ⟨x, rfl⟩ := (IsLocalRing.maximalIdeal R).toCotangent_surjective v
    exact ⟨x, rfl⟩
  choose u hu using fun j : Fin c => hsurjQ (bQ j)

  have hlinR : LinearIndependent (IsLocalRing.ResidueField R)
      (fun j => ((IsLocalRing.maximalIdeal R).toCotangent (Fin.append q u j) :
        IsLocalRing.CotangentSpace R)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    rw [Fin.sum_univ_add] at hg
    simp only [Fin.append_left, Fin.append_right, hq] at hg
    have h0 : ∀ i, W.mkQ (bW i : IsLocalRing.CotangentSpace R) = 0 := fun i =>
      (Submodule.Quotient.mk_eq_zero W).mpr (bW i).2
    have h2 : ∀ j, g (Fin.natAdd e j) = 0 := by
      have hh := congrArg W.mkQ hg
      simp only [map_add, map_sum, map_smul, hu, h0, smul_zero, Finset.sum_const_zero,
        zero_add, map_zero] at hh
      exact Fintype.linearIndependent_iff.mp bQ.linearIndependent _ hh
    have h1 : ∀ i, g (Fin.castAdd c i) = 0 := by
      simp only [h2, zero_smul, Finset.sum_const_zero, add_zero] at hg
      have hh : ∑ i, g (Fin.castAdd c i) • bW i = 0 := by
        apply Subtype.ext
        simp only [Submodule.coe_sum, Submodule.coe_smul, Submodule.coe_zero]
        exact hg
      exact Fintype.linearIndependent_iff.mp bW.linearIndependent _ hh
    intro i
    exact Fin.addCases (motive := fun i => g i = 0) h1 h2 i

  have hindR := (hs1 R (e + c) (Fin.append q u)).mpr hlinR
  have hS := hind (e + c) (fun j => ((Fin.append q u j : IsLocalRing.maximalIdeal R) : R)) hindR
  let w : Fin (e + c) → IsLocalRing.maximalIdeal S := fun j =>
    ⟨f ((Fin.append q u j : IsLocalRing.maximalIdeal R) : R), map_nonunit f _ (Fin.append q u j).2⟩
  have hlinS := (hs1 S (e + c) w).mp hS
  have hw : ∀ i, ((w (Fin.castAdd c i) : IsLocalRing.maximalIdeal S) : S) = f (q i) := by
    intro i
    simp [w, Fin.append_left]

  let t'' : Fin k → IsLocalRing.maximalIdeal S := fun l => ⟨t' l, ht'm l⟩
  let z : Fin (e + k) → IsLocalRing.maximalIdeal S :=
    Fin.append (fun i => w (Fin.castAdd c i)) t''
  have hE1 : ∀ (g : R) (hg : g ∈ IsLocalRing.maximalIdeal R) (hgS' : f g ∈ IsLocalRing.maximalIdeal S),
      ((IsLocalRing.maximalIdeal R).toCotangent ⟨g, hg⟩ : IsLocalRing.CotangentSpace R) ∈ W →
      ((IsLocalRing.maximalIdeal S).toCotangent ⟨f g, hgS'⟩ : IsLocalRing.CotangentSpace S) ∈
        Submodule.span (IsLocalRing.ResidueField S)
          (Set.range (fun j => ((IsLocalRing.maximalIdeal S).toCotangent (z j) :
            IsLocalRing.CotangentSpace S))) := by
    intro g hg hgS' hgW
    have e1 := congrArg (fun x : W => (x : IsLocalRing.CotangentSpace R)) (bW.sum_repr ⟨_, hgW⟩)
    simp only [Submodule.coe_sum, Submodule.coe_smul] at e1
    obtain ⟨a, ha⟩ := hL R e q ⟨g, hg⟩ (by
      rw [← e1]
      refine Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ ?_)
      rw [← hq]
      exact Submodule.subset_span ⟨i, rfl⟩)
    have hfa := Ideal.mem_map_of_mem f ha
    rw [Ideal.map_pow, hm, map_sub, map_sum] at hfa
    simp only [map_mul] at hfa
    have hfa' : ((⟨f g, hgS'⟩ : IsLocalRing.maximalIdeal S) : S) -
        ∑ i, f (a i) * ((w (Fin.castAdd c i) : IsLocalRing.maximalIdeal S) : S) ∈
          IsLocalRing.maximalIdeal S ^ 2 := by
      simp only [hw]
      exact hfa
    refine Submodule.span_mono ?_ (hG S e (fun i => w (Fin.castAdd c i)) ⟨f g, hgS'⟩ _ hfa')
    rintro _ ⟨i, rfl⟩
    exact ⟨Fin.castAdd k i, by simp [z, Fin.append_left]⟩
  have hspanS : Submodule.span (IsLocalRing.ResidueField S)
      (Set.range (fun j => ((IsLocalRing.maximalIdeal S).toCotangent (z j) :
        IsLocalRing.CotangentSpace S))) = ⊤ := by
    rw [eq_top_iff]
    rintro x -
    obtain ⟨⟨x, hx⟩, rfl⟩ := (IsLocalRing.maximalIdeal S).toCotangent_surjective x
    have hx' := hx
    rw [h] at hx'
    refine Submodule.span_induction
      (p := fun y _ => ∀ hy' : y ∈ IsLocalRing.maximalIdeal S,
        ((IsLocalRing.maximalIdeal S).toCotangent ⟨y, hy'⟩ : IsLocalRing.CotangentSpace S) ∈
          Submodule.span (IsLocalRing.ResidueField S)
            (Set.range (fun j => ((IsLocalRing.maximalIdeal S).toCotangent (z j) :
              IsLocalRing.CotangentSpace S)))) ?_ ?_ ?_ ?_ hx' hx
    · intro y hy hy'
      rcases hy with rfl | rfl | ⟨l, rfl⟩
      · exact hE1 g₀ hg₀ hy' hW₀
      · exact hE1 g₁ hg₁ hy' hW₁
      · exact Submodule.subset_span ⟨Fin.natAdd e l, by simp [z, Fin.append_right, t'']⟩
    · intro hy'
      have e0 : (⟨0, hy'⟩ : IsLocalRing.maximalIdeal S) = 0 := rfl
      rw [e0, map_zero]
      exact Submodule.zero_mem _
    · intro x y hx hy ihx ihy hxy'
      have hx2 : x ∈ IsLocalRing.maximalIdeal S := by rw [h]; exact hx
      have hy2 : y ∈ IsLocalRing.maximalIdeal S := by rw [h]; exact hy
      have e0 : (⟨x + y, hxy'⟩ : IsLocalRing.maximalIdeal S) = ⟨x, hx2⟩ + ⟨y, hy2⟩ := rfl
      rw [e0, map_add]
      exact Submodule.add_mem _ (ihx hx2) (ihy hy2)
    · intro a x hx ih hax'
      have hx2 : x ∈ IsLocalRing.maximalIdeal S := by rw [h]; exact hx
      have e0 : (⟨a • x, hax'⟩ : IsLocalRing.maximalIdeal S) = a • ⟨x, hx2⟩ := rfl
      rw [e0, map_smul, ← algebraMap_smul (IsLocalRing.ResidueField S) a]
      exact Submodule.smul_mem _ _ (ih hx2)

  have : Module.Finite (IsLocalRing.ResidueField S) (IsLocalRing.CotangentSpace S) :=
    ⟨Submodule.fg_def.mpr ⟨_, Set.finite_range _, hspanS⟩⟩
  have hc1 := hlinS.fintype_card_le_finrank
  have hc2 := finrank_le_of_span_eq_top hspanS
  simp only [Fintype.card_fin] at hc1 hc2
  have hck : c ≤ k := by omega

  let tR : Fin k → IsLocalRing.maximalIdeal R := fun i =>
    if hi : (i : ℕ) < c then u ⟨i, hi⟩ else 0
  refine ⟨fun i => (tR i : R), ?_⟩
  let s : Set (IsLocalRing.maximalIdeal R) := insert ⟨g₀, hg₀⟩ (insert ⟨g₁, hg₁⟩ (Set.range tR))
  have hspanR : Submodule.span (IsLocalRing.ResidueField R)
      ((IsLocalRing.maximalIdeal R).toCotangent '' s) = ⊤ := by
    rw [eq_top_iff]
    rintro x -
    have e1 := bQ.sum_repr (W.mkQ x)
    have hy : ∑ j, bQ.repr (W.mkQ x) j •
        ((IsLocalRing.maximalIdeal R).toCotangent (u j) : IsLocalRing.CotangentSpace R) ∈
        Submodule.span (IsLocalRing.ResidueField R)
          ((IsLocalRing.maximalIdeal R).toCotangent '' s) := by
      refine Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
      refine ⟨tR ⟨j, lt_of_lt_of_le j.2 hck⟩,
        Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨_, rfl⟩), ?_⟩
      simp [tR]
    have hxy : x - ∑ j, bQ.repr (W.mkQ x) j •
        ((IsLocalRing.maximalIdeal R).toCotangent (u j) : IsLocalRing.CotangentSpace R) ∈ W := by
      rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, map_sub, map_sum]
      simp only [map_smul, hu]
      rw [e1, sub_self]
    have hWle : W ≤ Submodule.span (IsLocalRing.ResidueField R)
        ((IsLocalRing.maximalIdeal R).toCotangent '' s) := by
      rw [hWdef, Submodule.span_le]
      rintro _ (rfl | rfl)
      · exact Submodule.subset_span ⟨_, Set.mem_insert _ _, rfl⟩
      · exact Submodule.subset_span ⟨_, Set.mem_insert_of_mem _ (Set.mem_insert _ _), rfl⟩
    have := Submodule.add_mem _ (hWle hxy) hy
    rwa [sub_add_cancel] at this
  have hR := (IsLocalRing.CotangentSpace.span_image_eq_top_iff).mp hspanR
  have hmap := congrArg (Submodule.map (IsLocalRing.maximalIdeal R).subtype) hR
  rw [Submodule.map_span, Submodule.map_subtype_top] at hmap
  refine hmap.symm.trans ?_
  unfold Ideal.span
  congr 1
  simp only [s, Set.image_insert_eq, Submodule.subtype_apply]
  rw [← Set.range_comp]
  rfl

theorem wc_ldp_dgp_dim_eq {R S : Type u} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsLocalRing S] [IsNoetherianRing R] [IsNoetherianRing S] (f : R →+* S) [IsLocalHom f]
    (hf : f.Flat) (hm : Ideal.map f (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S) :
    ringKrullDim R = ringKrullDim S :=
by
  letI : Algebra R S := f.toAlgebra
  haveI : Module.Flat R S := hf
  haveI : (IsLocalRing.maximalIdeal S).LiesOver (IsLocalRing.maximalIdeal R) :=
    ⟨by rw [Ideal.under_def]; exact (IsLocalRing.maximalIdeal_comap f).symm⟩
  have h := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
    (IsLocalRing.maximalIdeal R) (IsLocalRing.maximalIdeal S)
  have hJ : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ≠ ⊤ := by
    change Ideal.map f (IsLocalRing.maximalIdeal R) ≠ ⊤
    rw [hm]
    exact (IsLocalRing.maximalIdeal.isMaximal S).ne_top
  haveI := Ideal.Quotient.nontrivial_iff.mpr hJ
  have hbot : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S)
      (IsLocalRing.maximalIdeal R))) (IsLocalRing.maximalIdeal S) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
    change IsLocalRing.maximalIdeal S ≤ Ideal.map f (IsLocalRing.maximalIdeal R)
    rw [hm]
  rw [hbot, Ideal.height_bot, add_zero] at h
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
    ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h]

theorem wc_ldp_dgp_odp_descend {R S : Type u} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsLocalRing S] [IsNoetherianRing R] (f : R →+* S) [IsLocalHom f]
    (hm : Ideal.map f (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S)
    (hind₂ : ∀ (r : ℕ) (v : Fin r → R),
      (∀ a : Fin r → R, ∑ j, a j * v j ∈ IsLocalRing.maximalIdeal R ^ 2 →
        ∀ j, a j ∈ IsLocalRing.maximalIdeal R) →
      ∀ s : Fin r → S, ∑ j, s j * f (v j) ∈ IsLocalRing.maximalIdeal S ^ 2 →
        ∀ j, s j ∈ IsLocalRing.maximalIdeal S)
    (hind₃ : ∀ (r : ℕ) (v : Fin r → R),
      (∀ a : Fin r → R, ∑ j, a j * v j ∈ IsLocalRing.maximalIdeal R ^ 3 →
        ∀ j, a j ∈ IsLocalRing.maximalIdeal R) →
      ∀ s : Fin r → S, ∑ j, s j * f (v j) ∈ IsLocalRing.maximalIdeal S ^ 3 →
        ∀ j, s j ∈ IsLocalRing.maximalIdeal S)
    (L : Type u) [Field L] [Finite L] (φ : L →+* R) (n : ℕ) (hn : n < Nat.card L)
    (h : R) (t' : Fin n → S) (A' : Matrix (Fin n) (Fin n) S)
    (ht' : IsLocalRing.maximalIdeal S = Ideal.span (Set.range t'))
    (hh : f h - ∑ k, ∑ l, A' k l * t' k * t' l ∈ IsLocalRing.maximalIdeal S ^ 3)
    (hA' : IsUnit (A' + A'.transpose).det) :
    ∃ (t : Fin n → R) (A : Matrix (Fin n) (Fin n) R),
      IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) ∧
      h - ∑ k, ∑ l, A k l * t k * t l ∈ IsLocalRing.maximalIdeal R ^ 3 ∧
      IsUnit (A + A.transpose).det :=
by
  classical

  have wc_odp_min_gen_exists : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (J : Ideal R),
      J.FG → ∃ (d : ℕ) (w : Fin d → R), J = Ideal.span (Set.range w) ∧
        ∀ a : Fin d → R, ∑ j, a j * w j ∈ IsLocalRing.maximalIdeal R * J →
          ∀ j, a j ∈ IsLocalRing.maximalIdeal R := by
    intro R _ _ J hJ
    have hex : ∃ d, ∃ w : Fin d → R, J = Ideal.span (Set.range w) := by
      obtain ⟨d, w, hw⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hJ
      exact ⟨d, w, hw.symm⟩
    have key : ∀ (d : ℕ) (w : Fin d → R), J = Ideal.span (Set.range w) →
        (∀ d' < d, ¬ ∃ w' : Fin d' → R, J = Ideal.span (Set.range w')) →
        ∀ a : Fin d → R, ∑ j, a j * w j ∈ IsLocalRing.maximalIdeal R * J →
          ∀ j, a j ∈ IsLocalRing.maximalIdeal R := by
      intro d
      cases d with
      | zero => intro w _ _ a _ j; exact j.elim0
      | succ d' =>
        intro w hw hmin a ha j₀
        by_contra hj
        have hunit : IsUnit (a j₀) := by
          by_contra hnu
          exact hj ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
        set w' : Fin d' → R := fun i => w (j₀.succAbove i) with hw'
        set N : Ideal R := Ideal.span (Set.range w') with hN
        have hJN : J ≤ N := by
          apply Submodule.le_of_le_smul_of_le_jacobson_bot hJ
            (IsLocalRing.maximalIdeal_le_jacobson ⊥)
          conv_lhs => rw [hw]
          rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          rcases Fin.eq_self_or_eq_succAbove j₀ j with hj' | ⟨i, rfl⟩
          · rw [hj']
            have hmem : a j₀ * w j₀ ∈ N ⊔ IsLocalRing.maximalIdeal R • J := by
              have e : a j₀ * w j₀ = ∑ j, a j * w j - ∑ i, a (j₀.succAbove i) * w' i := by
                rw [Fin.sum_univ_succAbove _ j₀]
                ring
              rw [e]
              refine Submodule.sub_mem _ ?_ ?_
              · apply Submodule.mem_sup_right
                rw [Ideal.smul_eq_mul]
                exact ha
              · apply Submodule.mem_sup_left
                refine Ideal.sum_mem _ fun i _ => ?_
                exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
            have e2 : w j₀ = ↑hunit.unit⁻¹ * (a j₀ * w j₀) := by
              rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
            rw [SetLike.mem_coe, e2]
            exact Submodule.smul_mem _ _ hmem
          · apply Submodule.mem_sup_left
            exact Ideal.subset_span ⟨i, rfl⟩
        have hNJ : N ≤ J := by
          rw [hN, Ideal.span_le]
          rintro _ ⟨i, rfl⟩
          rw [hw]
          exact Ideal.subset_span ⟨_, rfl⟩
        exact hmin d' (Nat.lt_succ_self d') ⟨w', le_antisymm hJN hNJ⟩
    obtain ⟨w, hw⟩ := Nat.find_spec hex
    refine ⟨_, w, hw, key _ w hw ?_⟩
    intro d' hd' hex'
    exact Nat.find_min hex hd' hex'

  have wc_odp_kprime_point : ∀ {S : Type u} [CommRing S] [IsLocalRing S] (n d r : ℕ)
      (t' : Fin n → S) (A' : Matrix (Fin n) (Fin n) S),
      IsLocalRing.maximalIdeal S = Ideal.span (Set.range t') →
      IsUnit (A' + A'.transpose).det →
      ∀ (v : Fin d → S), IsLocalRing.maximalIdeal S = Ideal.span (Set.range v) →
      (∀ s : Fin d → S, ∑ j, s j * v j ∈ IsLocalRing.maximalIdeal S ^ 2 →
        ∀ j, s j ∈ IsLocalRing.maximalIdeal S) →
      ∀ (z : Fin r → S),
      (∀ s : Fin r → S, ∑ l, s l * z l ∈ IsLocalRing.maximalIdeal S ^ 3 →
        ∀ l, s l ∈ IsLocalRing.maximalIdeal S) →
      ∀ (Gs : Fin d → Fin d → Fin r → S), (∀ i j, v i * v j = ∑ l, Gs i j l * z l) →
      ∀ (Bs : Matrix (Fin d) (Fin d) S),
      ∑ i, ∑ j, Bs i j * v i * v j - ∑ k, ∑ l, A' k l * t' k * t' l ∈
        IsLocalRing.maximalIdeal S ^ 3 →
      ∃ (hdn : d ≤ n) (Y : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField S)),
        (∀ l : Fin r, ∑ i, ∑ j, (Y (Fin.castLE hdn i) (Fin.castLE hdn j) -
            IsLocalRing.residue S (Bs i j)) * IsLocalRing.residue S (Gs i j l) = 0) ∧
        (Y + Y.transpose).det ≠ 0 := by
    intro S _ _ n d r t' A' ht' hA' v hv hv2 z hz3 Gs hGs Bs hB
    have hP0 : ∀ k, ∃ p : Fin d → S, ∑ i, p i * v i = t' k := by
      intro k
      have h1 : t' k ∈ IsLocalRing.maximalIdeal S := by
        rw [ht']; exact Ideal.subset_span ⟨k, rfl⟩
      rw [hv] at h1
      exact Ideal.mem_span_range_iff_exists_fun.mp h1
    choose P hP using hP0
    have hQ0 : ∀ i, ∃ q : Fin n → S, ∑ k, q k * t' k = v i := by
      intro i
      have h1 : v i ∈ IsLocalRing.maximalIdeal S := by
        rw [hv]; exact Ideal.subset_span ⟨i, rfl⟩
      rw [ht'] at h1
      exact Ideal.mem_span_range_iff_exists_fun.mp h1
    choose Q hQ using hQ0
    have hQPm : ∀ i j, ∑ k, Q i k * P k j - (if j = i then 1 else 0) ∈
        IsLocalRing.maximalIdeal S := by
      intro i
      apply hv2
      have e1 : ∑ j, (∑ k, Q i k * P k j) * v j = v i := by
        rw [← hQ i]
        simp only [← hP, Finset.mul_sum, Finset.sum_mul]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => by ring
      have e2 : ∑ j, (∑ k, Q i k * P k j - (if j = i then 1 else 0)) * v j = 0 := by
        simp only [sub_mul, Finset.sum_sub_distrib, e1, ite_mul, one_mul, zero_mul,
          Finset.sum_ite_eq', Finset.mem_univ, if_true, sub_self]
      rw [e2]
      exact Ideal.zero_mem _
    set res := IsLocalRing.residue S with hres
    set Pb : Matrix (Fin n) (Fin d) (IsLocalRing.ResidueField S) :=
      Matrix.of fun k i => res (P k i) with hPb
    set Qb : Matrix (Fin d) (Fin n) (IsLocalRing.ResidueField S) :=
      Matrix.of fun i k => res (Q i k) with hQb
    have hQP : Qb * Pb = 1 := by
      ext i j
      have h1 := hQPm i j
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero, map_sum] at h1
      rw [Matrix.mul_apply, Matrix.one_apply]
      simp only [hQb, hPb, Matrix.of_apply, ← map_mul]
      rw [h1]
      by_cases hij : i = j
      · subst hij; simp
      · rw [if_neg (Ne.symm hij), if_neg hij, map_zero]
    obtain ⟨hdn, G, hGdet, hGc⟩ : ∃ hdn : d ≤ n,
        ∃ G : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField S),
        G.det ≠ 0 ∧ ∀ a i, G a (Fin.castLE hdn i) = Pb a i := by
      set Lq := Matrix.toLin' Qb with hLq
      have hsurj : LinearMap.range Lq = ⊤ := by
        rw [LinearMap.range_eq_top]
        intro y
        refine ⟨Pb.mulVec y, ?_⟩
        rw [hLq, Matrix.toLin'_apply, Matrix.mulVec_mulVec, hQP, Matrix.one_mulVec]
      have hrn := LinearMap.finrank_range_add_finrank_ker Lq
      rw [hsurj, finrank_top, Module.finrank_fin_fun, Module.finrank_fin_fun] at hrn
      have hdn : d ≤ n := by omega
      have hker : Module.finrank (IsLocalRing.ResidueField S) (LinearMap.ker Lq) = n - d := by
        omega
      have hnd : n = d + (n - d) := by omega
      set κb := Module.finBasisOfFinrankEq (IsLocalRing.ResidueField S) (LinearMap.ker Lq) hker
        with hκb
      have hκ0 : ∀ s, Qb.mulVec (κb s : Fin n → IsLocalRing.ResidueField S) = 0 := by
        intro s
        have h : Lq (κb s : Fin n → IsLocalRing.ResidueField S) = 0 :=
          LinearMap.mem_ker.mp (κb s).2
        exact (Matrix.toLin'_apply Qb _).symm.trans h
      set G' : Matrix (Fin n) (Fin (d + (n - d))) (IsLocalRing.ResidueField S) :=
        Matrix.of fun a => Fin.addCases (motive := fun _ => IsLocalRing.ResidueField S)
          (fun i => Pb a i) (fun s => (κb s : Fin n → IsLocalRing.ResidueField S) a) with hG'
      refine ⟨hdn, Matrix.of fun a j => G' a (finCongr hnd j), ?_, ?_⟩
      · intro hdet
        obtain ⟨x, hx0, hx⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
        apply hx0
        set y : Fin (d + (n - d)) → IsLocalRing.ResidueField S :=
          fun j => x ((finCongr hnd).symm j) with hy
        set y₁ : Fin d → IsLocalRing.ResidueField S := fun i => y (Fin.castAdd (n - d) i)
          with hy₁
        set y₂ : Fin (n - d) → IsLocalRing.ResidueField S := fun s => y (Fin.natAdd d s)
          with hy₂
        have hV : Pb.mulVec y₁ + ∑ s, y₂ s • (κb s : Fin n → IsLocalRing.ResidueField S) = 0 := by
          funext a
          have h1 := congrFun hx a
          have e1 : (Matrix.of fun a j => G' a (finCongr hnd j)).mulVec x a =
              ∑ j', G' a j' * y j' := by
            rw [← Equiv.sum_comp (finCongr hnd)]
            simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, hy, Equiv.symm_apply_apply]
          rw [e1, Fin.sum_univ_add] at h1
          simp only [hG', Matrix.of_apply, Fin.addCases_left, Fin.addCases_right] at h1
          simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply,
            Matrix.mulVec, dotProduct, hy₁, hy₂]
          convert h1 using 2
          exact Finset.sum_congr rfl fun s _ => mul_comm _ _
        have hy1 : y₁ = 0 := by
          have h2 := congrArg Qb.mulVec hV
          rw [Matrix.mulVec_add, Matrix.mulVec_mulVec, hQP, Matrix.one_mulVec, Matrix.mulVec_sum,
            Matrix.mulVec_zero] at h2
          simp only [Matrix.mulVec_smul, hκ0, smul_zero, Finset.sum_const_zero, add_zero] at h2
          exact h2
        have hy2 : y₂ = 0 := by
          rw [hy1, Matrix.mulVec_zero, zero_add] at hV
          have h3 : ∑ s, y₂ s • κb s = 0 := by
            apply Subtype.ext
            simp only [Submodule.coe_sum, Submodule.coe_smul, Submodule.coe_zero]
            exact hV
          funext s
          exact Fintype.linearIndependent_iff.mp κb.linearIndependent y₂ h3 s
        have hy0 : ∀ j', y j' = 0 := by
          intro j'
          refine Fin.addCases (motive := fun j' => y j' = 0) (fun i => ?_) (fun s => ?_) j'
          · exact congrFun hy1 i
          · exact congrFun hy2 s
        funext j
        have := hy0 (finCongr hnd j)
        simp only [hy, Equiv.symm_apply_apply] at this
        exact this
      · intro a i
        have e : finCongr hnd (Fin.castLE hdn i) = Fin.castAdd (n - d) i := Fin.ext rfl
        simp only [Matrix.of_apply, e, hG', Fin.addCases_left]
    set Ab : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField S) := A'.map res with hAb
    set Y := G.transpose * Ab * G with hY
    have hYe : ∀ x y, Y x y = ∑ a, ∑ b, G a x * Ab a b * G b y := by
      intro x y
      simp only [hY, Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      exact Finset.sum_comm
    refine ⟨hdn, Y, ?_, ?_⟩
    · set C' : Fin d → Fin d → S := fun i j => ∑ a, ∑ b, P a i * A' a b * P b j with hC'
      have e1 : ∀ (f : Fin n → Fin n → Fin d → Fin d → S),
          ∑ k, ∑ l, ∑ i, ∑ j, f k l i j = ∑ i, ∑ j, ∑ k, ∑ l, f k l i j := by
        intro f
        calc ∑ k, ∑ l, ∑ i, ∑ j, f k l i j = ∑ k, ∑ i, ∑ l, ∑ j, f k l i j :=
              Finset.sum_congr rfl fun k _ => Finset.sum_comm
          _ = ∑ k, ∑ i, ∑ j, ∑ l, f k l i j :=
              Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun i _ => Finset.sum_comm
          _ = ∑ i, ∑ k, ∑ j, ∑ l, f k l i j := Finset.sum_comm
          _ = ∑ i, ∑ j, ∑ k, ∑ l, f k l i j := Finset.sum_congr rfl fun i _ => Finset.sum_comm
      have hquad : ∑ k, ∑ l, A' k l * t' k * t' l = ∑ i, ∑ j, C' i j * v i * v j := by
        calc ∑ k, ∑ l, A' k l * t' k * t' l
            = ∑ k, ∑ l, ∑ i, ∑ j, A' k l * (P k i * v i) * (P l j * v j) := by
              refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
              rw [← hP k, ← hP l, mul_assoc, Finset.sum_mul_sum, Finset.mul_sum]
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl fun j _ => by ring
          _ = ∑ i, ∑ j, ∑ k, ∑ l, A' k l * (P k i * v i) * (P l j * v j) := e1 _
          _ = ∑ i, ∑ j, C' i j * v i * v j := by
              refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
              simp only [hC', Finset.sum_mul]
              exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => by ring
      set D : Fin r → S := fun l => ∑ i, ∑ j, (C' i j - Bs i j) * Gs i j l with hD
      have hDz : ∑ l, D l * z l = ∑ i, ∑ j, (C' i j - Bs i j) * (v i * v j) := by
        simp only [hD, Finset.sum_mul]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [hGs i j, Finset.mul_sum]
        exact Finset.sum_congr rfl fun l _ => by ring
      have hsplit : ∑ i, ∑ j, (C' i j - Bs i j) * (v i * v j) =
          ∑ i, ∑ j, C' i j * v i * v j - ∑ i, ∑ j, Bs i j * v i * v j := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun j _ => by ring
      have hmem : ∑ l, D l * z l ∈ IsLocalRing.maximalIdeal S ^ 3 := by
        rw [hDz, hsplit, ← hquad]
        have e : ∑ k, ∑ l, A' k l * t' k * t' l - ∑ i, ∑ j, Bs i j * v i * v j =
            -(∑ i, ∑ j, Bs i j * v i * v j - ∑ k, ∑ l, A' k l * t' k * t' l) := by ring
        rw [e]
        exact (Submodule.neg_mem_iff _).mpr hB
      have hYc : ∀ i j, Y (Fin.castLE hdn i) (Fin.castLE hdn j) = res (C' i j) := by
        intro i j
        rw [hYe]
        simp only [hGc, hPb, hAb, hC', Matrix.of_apply, Matrix.map_apply, map_sum, map_mul]
      intro l
      have hDl := hz3 D hmem l
      rw [← IsLocalRing.residue_eq_zero_iff] at hDl
      calc ∑ i, ∑ j, (Y (Fin.castLE hdn i) (Fin.castLE hdn j) - res (Bs i j)) * res (Gs i j l)
          = res (D l) := by
            simp only [hD, map_sum, map_mul, map_sub, hYc]
        _ = 0 := hDl
    · have hsym : Y + Y.transpose = G.transpose * (Ab + Ab.transpose) * G := by
        simp only [hY, Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_add,
          Matrix.add_mul, Matrix.mul_assoc]
      have hAb0 : (Ab + Ab.transpose).det ≠ 0 := by
        have h1 := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hA'
        rw [RingHom.map_det] at h1
        convert h1 using 2
        ext a b
        simp [hAb, hres, RingHom.mapMatrix_apply, Matrix.map_apply]
      rw [hsym, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
      exact mul_ne_zero (mul_ne_zero hGdet hAb0) hGdet

  have wc_odp_retract_decomp : ∀ {k k' : Type u} [Field k] [Field k'] (ι : k →+* k') (n d r : ℕ)
      (hdn : d ≤ n) (g : Fin d → Fin d → Fin r → k) (β : Matrix (Fin d) (Fin d) k)
      (Y : Matrix (Fin n) (Fin n) k'),
      (∀ l, ∑ i, ∑ j, (Y (Fin.castLE hdn i) (Fin.castLE hdn j) - ι (β i j)) * ι (g i j l) = 0) →
      ∃ (m : ℕ) (X₀ : Matrix (Fin n) (Fin n) k) (X : Fin m → Matrix (Fin n) (Fin n) k)
        (e : Fin m → k'),
        Y = X₀.map ι + ∑ s, e s • (X s).map ι ∧
        (∀ l, ∑ i, ∑ j, (X₀ (Fin.castLE hdn i) (Fin.castLE hdn j) - β i j) * g i j l = 0) ∧
        ∀ s l, ∑ i, ∑ j, X s (Fin.castLE hdn i) (Fin.castLE hdn j) * g i j l = 0 := by
    intro k k' _ _ ι n d r hdn g β Y hY
    letI := ι.toAlgebra
    have halg : ∀ x : k, algebraMap k k' x = ι x := fun x => rfl
    have hinj : LinearMap.ker (Algebra.linearMap k k') = ⊥ :=
      LinearMap.ker_eq_bot.mpr ι.injective
    obtain ⟨ρ, hρ⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap k k') hinj
    have hρι : ∀ x, ρ (ι x) = x := fun x => LinearMap.congr_fun hρ x
    have hρsmul : ∀ a y, ρ (ι a * y) = a * ρ y := fun a y => by
      have := ρ.map_smul a y
      rw [Algebra.smul_def, halg] at this
      rw [this, smul_eq_mul]
    set X₀ : Matrix (Fin n) (Fin n) k := Y.map ρ with hX₀
    have hX₀c : ∀ l, ∑ i, ∑ j, (X₀ (Fin.castLE hdn i) (Fin.castLE hdn j) - β i j) * g i j l = 0 := by
      intro l
      have := congrArg ρ (hY l)
      rw [map_zero, map_sum] at this
      rw [← this]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [mul_comm (Y _ _ - _), hρsmul, map_sub, hρι, hX₀, Matrix.map_apply]
      ring
    set Z : Matrix (Fin n) (Fin n) k' := Y - X₀.map ι with hZ
    set U : Submodule k k' := Submodule.span k (Set.range fun p : Fin n × Fin n => Z p.1 p.2)
      with hU
    haveI : FiniteDimensional k U := FiniteDimensional.span_of_finite k (Set.finite_range _)
    set b := Module.finBasis k U with hb
    have hZU : ∀ a c, Z a c ∈ U := fun a c => Submodule.subset_span ⟨(a, c), rfl⟩
    set zz : Fin n → Fin n → U := fun a c => ⟨Z a c, hZU a c⟩ with hzz
    refine ⟨Module.finrank k U, X₀, fun s => Matrix.of fun a c => b.repr (zz a c) s,
      fun s => (b s : k'), ?_, hX₀c, ?_⟩
    · ext a c
      have h1 := congrArg (fun x : U => (x : k')) (b.sum_repr (zz a c))
      simp only [Submodule.coe_sum, Submodule.coe_smul, hzz] at h1
      simp only [Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply, Matrix.map_apply,
        Matrix.of_apply, smul_eq_mul]
      have h2 : Y a c = X₀.map ι a c + Z a c := by rw [hZ]; simp
      rw [h2, Matrix.map_apply, ← h1]
      congr 1
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [Algebra.smul_def, halg, mul_comm]
    · intro s l
      have hzero : ∑ i, ∑ j, g i j l • zz (Fin.castLE hdn i) (Fin.castLE hdn j) = 0 := by
        apply Subtype.ext
        simp only [Submodule.coe_sum, Submodule.coe_smul, hzz, Submodule.coe_zero,
          Algebra.smul_def, halg]
        have e : ∀ i j, ι (g i j l) * Z (Fin.castLE hdn i) (Fin.castLE hdn j) =
            (Y (Fin.castLE hdn i) (Fin.castLE hdn j) - ι (β i j)) * ι (g i j l) -
              ι ((X₀ (Fin.castLE hdn i) (Fin.castLE hdn j) - β i j) * g i j l) := by
          intro i j
          rw [hZ]
          simp only [Matrix.sub_apply, Matrix.map_apply, map_mul, map_sub]
          ring
        simp only [e, Finset.sum_sub_distrib, ← map_sum, hY l, hX₀c l, map_zero, sub_zero]
      have := congrArg (fun x => b.repr x s) hzero
      simp only [map_sum, map_smul, Finsupp.coe_finset_sum, Finset.sum_apply, Finsupp.smul_apply,
        smul_eq_mul, map_zero, Finsupp.coe_zero, Pi.zero_apply] at this
      rw [← this]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      simp only [Matrix.of_apply]
      ring

  have wc_odp_poly_nonvanish : ∀ {k k' : Type u} [Field k] [Field k'] (ι : k →+* k') (n m : ℕ)
      (T : Finset k), n < T.card →
      ∀ (X₀ : Matrix (Fin n) (Fin n) k) (X : Fin m → Matrix (Fin n) (Fin n) k) (e : Fin m → k'),
      (X₀.map ι + ∑ s, e s • (X s).map ι +
          (X₀.map ι + ∑ s, e s • (X s).map ι).transpose).det ≠ 0 →
      ∃ c : Fin m → k, (X₀ + ∑ s, c s • X s + (X₀ + ∑ s, c s • X s).transpose).det ≠ 0 := by
    intro k k' _ _ ι n m T hT X₀ X e he
    set M : Matrix (Fin n) (Fin n) (MvPolynomial (Fin m) k) := Matrix.of fun a b =>
      MvPolynomial.C (X₀ a b + X₀ b a) +
        ∑ s, MvPolynomial.C (X s a b + X s b a) * MvPolynomial.X s with hM
    set Φ := M.det with hΦ
    have hK : (MvPolynomial.eval₂Hom ι e) Φ = (X₀.map ι + ∑ s, e s • (X s).map ι +
          (X₀.map ι + ∑ s, e s • (X s).map ι).transpose).det := by
      rw [hΦ, RingHom.map_det]
      congr 1
      ext a b
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, hM, Matrix.of_apply, map_add, map_sum,
        map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply, Matrix.transpose_apply, smul_eq_mul]
      have : ∀ s, (ι (X s a b) + ι (X s b a)) * e s = e s * ι (X s a b) + e s * ι (X s b a) :=
        fun s => by ring
      simp only [this, Finset.sum_add_distrib]
      ring
    have hk : ∀ c : Fin m → k, (MvPolynomial.eval c) Φ =
        (X₀ + ∑ s, c s • X s + (X₀ + ∑ s, c s • X s).transpose).det := by
      intro c
      rw [hΦ, RingHom.map_det]
      congr 1
      ext a b
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, hM, Matrix.of_apply, map_add, map_sum,
        map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
        Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply, Matrix.transpose_apply, smul_eq_mul]
      have : ∀ s, (X s a b + X s b a) * c s = c s * X s a b + c s * X s b a :=
        fun s => by ring
      simp only [this, Finset.sum_add_distrib]
      ring
    have hΦ0 : Φ ≠ 0 := by
      intro h0
      apply he
      rw [← hK, h0, map_zero]
    have hentry : ∀ a b, (M a b).totalDegree ≤ 1 := by
      intro a b
      simp only [hM, Matrix.of_apply]
      refine (MvPolynomial.totalDegree_add _ _).trans (max_le ?_ ?_)
      · rw [MvPolynomial.totalDegree_C]; exact zero_le_one
      · refine (MvPolynomial.totalDegree_finsetSum _ _).trans (Finset.sup_le fun s _ => ?_)
        refine (MvPolynomial.totalDegree_mul _ _).trans ?_
        rw [MvPolynomial.totalDegree_C, MvPolynomial.totalDegree_X]
    have hdeg : Φ.totalDegree ≤ n := by
      rw [hΦ, Matrix.det_apply]
      refine (MvPolynomial.totalDegree_finsetSum _ _).trans (Finset.sup_le fun σ _ => ?_)
      have hsm : ∀ (u : ℤˣ) (p : MvPolynomial (Fin m) k), (u • p).totalDegree ≤ p.totalDegree := by
        intro u p
        rcases Int.units_eq_one_or u with hu | hu
        · rw [hu, one_smul]
        · rw [hu, Units.neg_smul, one_smul, MvPolynomial.totalDegree_neg]
      refine (hsm _ _).trans ?_
      refine (MvPolynomial.totalDegree_finsetProd _ _).trans ?_
      calc ∑ i, (M (σ i) i).totalDegree ≤ ∑ _i : Fin n, 1 :=
            Finset.sum_le_sum fun i _ => hentry _ _
        _ = n := by simp
    by_contra hall
    push_neg at hall
    apply hΦ0
    refine MvPolynomial.eq_zero_of_eval_zero_at_prod_finset Φ (fun _ => T) (fun i => ?_) ?_
    · exact lt_of_le_of_lt ((MvPolynomial.degreeOf_le_totalDegree Φ i).trans hdeg) hT
    · intro x _
      rw [hk x]
      exact hall x

  have wc_odp_lift_finish : ∀ {R : Type u} [CommRing R] [IsLocalRing R] (n d r : ℕ) (hdn : d ≤ n)
      (u : Fin d → R), IsLocalRing.maximalIdeal R = Ideal.span (Set.range u) →
      ∀ (w : Fin r → R), (∀ l, w l ∈ IsLocalRing.maximalIdeal R ^ 2) →
      ∀ (G : Fin d → Fin d → Fin r → R), (∀ i j, u i * u j = ∑ l, G i j l * w l) →
      ∀ (h : R) (B : Matrix (Fin d) (Fin d) R), h = ∑ i, ∑ j, B i j * u i * u j →
      ∀ (X : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField R)),
      (∀ l, ∑ i, ∑ j, (X (Fin.castLE hdn i) (Fin.castLE hdn j) - IsLocalRing.residue R (B i j)) *
        IsLocalRing.residue R (G i j l) = 0) →
      (X + X.transpose).det ≠ 0 →
      ∃ (t : Fin n → R) (A : Matrix (Fin n) (Fin n) R),
        IsLocalRing.maximalIdeal R = Ideal.span (Set.range t) ∧
        h - ∑ k, ∑ l, A k l * t k * t l ∈ IsLocalRing.maximalIdeal R ^ 3 ∧
        IsUnit (A + A.transpose).det := by
    intro R _ _ n d r hdn u hu w hw G hG h B hB X hX hdet
    set t : Fin n → R := fun k => if hk : k.val < d then u ⟨k.val, hk⟩ else 0 with ht
    set A : Matrix (Fin n) (Fin n) R :=
      Matrix.of fun a b => Function.surjInv (IsLocalRing.residue_surjective (R := R)) (X a b)
      with hA
    have hAres : ∀ a b, IsLocalRing.residue R (A a b) = X a b := fun a b =>
      Function.surjInv_eq (IsLocalRing.residue_surjective (R := R)) (X a b)
    have htc : ∀ i, t (Fin.castLE hdn i) = u i := by
      intro i
      simp only [ht, Fin.val_castLE, i.isLt, dite_true]
    have htz : ∀ k ∉ Set.range (Fin.castLE hdn), t k = 0 := by
      intro k hk
      have hkd : ¬ k.val < d := by
        intro hlt
        exact hk ⟨⟨k.val, hlt⟩, Fin.ext (by simp)⟩
      simp only [ht, hkd, dite_false]
    refine ⟨t, A, ?_, ?_, ?_⟩
    · rw [hu]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        rw [← htc i]
        exact Ideal.subset_span ⟨_, rfl⟩
      · rw [Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        by_cases hk : k ∈ Set.range (Fin.castLE hdn)
        · obtain ⟨i, rfl⟩ := hk
          rw [htc i]
          exact Ideal.subset_span ⟨i, rfl⟩
        · rw [htz k hk]
          exact Ideal.zero_mem _
    · have hq : ∑ k, ∑ l, A k l * t k * t l =
          ∑ i, ∑ j, A (Fin.castLE hdn i) (Fin.castLE hdn j) * u i * u j := by
        symm
        refine Fintype.sum_of_injective (Fin.castLE hdn) (Fin.castLE_injective hdn) _ _ ?_ ?_
        · intro k hk
          refine Finset.sum_eq_zero fun l _ => ?_
          rw [htz k hk]; ring
        · intro i
          refine Fintype.sum_of_injective (Fin.castLE hdn) (Fin.castLE_injective hdn) _ _ ?_ ?_
          · intro l hl
            rw [htz l hl]; ring
          · intro j
            rw [htc i, htc j]
      set κ : Fin r → R := fun l => ∑ i, ∑ j, (B i j - A (Fin.castLE hdn i) (Fin.castLE hdn j)) *
        G i j l with hκ
      have hsum : h - ∑ k, ∑ l, A k l * t k * t l = ∑ l, κ l * w l := by
        rw [hq, hB, ← Finset.sum_sub_distrib]
        simp only [hκ, Finset.sum_mul]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← Finset.sum_sub_distrib, Finset.sum_comm]
        refine Finset.sum_congr rfl fun j _ => ?_
        have e : B i j * u i * u j - A (Fin.castLE hdn i) (Fin.castLE hdn j) * u i * u j =
            (B i j - A (Fin.castLE hdn i) (Fin.castLE hdn j)) * (u i * u j) := by ring
        rw [e, hG i j, Finset.mul_sum]
        refine Finset.sum_congr rfl fun l _ => ?_
        ring
      rw [hsum]
      refine Ideal.sum_mem _ fun l _ => ?_
      have hκm : κ l ∈ IsLocalRing.maximalIdeal R := by
        rw [← IsLocalRing.residue_eq_zero_iff]
        have e : IsLocalRing.residue R (κ l) =
            -(∑ i, ∑ j, (X (Fin.castLE hdn i) (Fin.castLE hdn j) -
              IsLocalRing.residue R (B i j)) * IsLocalRing.residue R (G i j l)) := by
          simp only [hκ, map_sum, map_mul, map_sub, hAres, ← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          ring
        rw [e, hX l, neg_zero]
      rw [pow_succ']
      exact Ideal.mul_mem_mul hκm (hw l)
    · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, RingHom.map_det]
      convert hdet using 2
      ext a b
      simp [RingHom.mapMatrix_apply, Matrix.map_apply, hAres]

  have hmFG : (IsLocalRing.maximalIdeal R).FG := IsNoetherian.noetherian _
  have hm2FG : (IsLocalRing.maximalIdeal R ^ 2).FG := IsNoetherian.noetherian _
  obtain ⟨d, u, hu, hu'⟩ := wc_odp_min_gen_exists (IsLocalRing.maximalIdeal R) hmFG
  obtain ⟨r, w, hw, hw'⟩ := wc_odp_min_gen_exists (IsLocalRing.maximalIdeal R ^ 2) hm2FG
  have hu2 : ∀ a : Fin d → R, ∑ j, a j * u j ∈ IsLocalRing.maximalIdeal R ^ 2 →
      ∀ j, a j ∈ IsLocalRing.maximalIdeal R := by
    intro a ha
    rw [pow_two] at ha
    exact hu' a ha
  have hw3 : ∀ a : Fin r → R, ∑ j, a j * w j ∈ IsLocalRing.maximalIdeal R ^ 3 →
      ∀ j, a j ∈ IsLocalRing.maximalIdeal R := by
    intro a ha
    rw [pow_succ'] at ha
    exact hw' a ha
  have hv2 := hind₂ d u hu2
  have hz3 := hind₃ r w hw3
  have hum : ∀ i, u i ∈ IsLocalRing.maximalIdeal R := fun i => by
    rw [hu]; exact Ideal.subset_span ⟨i, rfl⟩
  have hwm : ∀ l, w l ∈ IsLocalRing.maximalIdeal R ^ 2 := fun l => by
    rw [hw]; exact Ideal.subset_span ⟨l, rfl⟩
  have hv : IsLocalRing.maximalIdeal S = Ideal.span (Set.range (fun j => f (u j))) := by
    rw [← hm, hu, Ideal.map_span, ← Set.range_comp]
    rfl
  have hG0 : ∀ i j, ∃ g : Fin r → R, ∑ l, g l * w l = u i * u j := by
    intro i j
    have h1 : u i * u j ∈ IsLocalRing.maximalIdeal R ^ 2 := by
      rw [pow_two]; exact Ideal.mul_mem_mul (hum i) (hum j)
    rw [hw] at h1
    exact (Ideal.mem_span_range_iff_exists_fun).mp h1
  choose G hG using hG0

  have hloc : ∀ x : R, f x ∈ IsLocalRing.maximalIdeal S → x ∈ IsLocalRing.maximalIdeal R := by
    intro x hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    exact fun hxu => hx (hxu.map f)
  have ht'm : ∀ k, t' k ∈ IsLocalRing.maximalIdeal S := fun k => by
    rw [ht']; exact Ideal.subset_span ⟨k, rfl⟩
  have hQ : ∑ k, ∑ l, A' k l * t' k * t' l ∈ IsLocalRing.maximalIdeal S ^ 2 := by
    refine Ideal.sum_mem _ fun k _ => Ideal.sum_mem _ fun l _ => ?_
    rw [pow_two]
    exact Ideal.mul_mem_mul (Ideal.mul_mem_left _ _ (ht'm k)) (ht'm l)
  have hfh : f h ∈ IsLocalRing.maximalIdeal S ^ 2 := by
    have e : f h = (f h - ∑ k, ∑ l, A' k l * t' k * t' l) + ∑ k, ∑ l, A' k l * t' k * t' l := by
      ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.pow_le_pow_right (by norm_num) hh) hQ
  have hhm : h ∈ IsLocalRing.maximalIdeal R :=
    hloc h (Ideal.pow_le_self two_ne_zero hfh)
  rw [hu] at hhm
  obtain ⟨a, ha⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hhm
  have ham : ∀ j, a j ∈ IsLocalRing.maximalIdeal R := by
    intro j
    apply hloc
    refine hv2 (fun j => f (a j)) ?_ j
    have e : ∑ j, f (a j) * f (u j) = f h := by
      rw [← ha, map_sum]
      simp only [map_mul]
    rw [e]
    exact hfh
  have hc0 : ∀ j, ∃ c : Fin d → R, ∑ i, c i * u i = a j := by
    intro j
    have h1 := ham j
    rw [hu] at h1
    exact (Ideal.mem_span_range_iff_exists_fun).mp h1
  choose c hc using hc0
  obtain ⟨B, hB⟩ : ∃ B : Matrix (Fin d) (Fin d) R, h = ∑ i, ∑ j, B i j * u i * u j := by
    refine ⟨Matrix.of fun i j => c j i, ?_⟩
    rw [← ha]
    simp only [Matrix.of_apply]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← hc j, Finset.sum_mul]

  have hGs : ∀ i j, f (u i) * f (u j) = ∑ l, f (G i j l) * f (w l) := by
    intro i j
    rw [← map_mul, ← hG i j, map_sum]
    simp only [map_mul]
  have hBs : ∑ i, ∑ j, (B.map f) i j * f (u i) * f (u j) - ∑ k, ∑ l, A' k l * t' k * t' l ∈
      IsLocalRing.maximalIdeal S ^ 3 := by
    have e : ∑ i, ∑ j, (B.map f) i j * f (u i) * f (u j) = f h := by
      rw [hB]
      simp only [map_sum, map_mul, Matrix.map_apply]
    rw [e]
    exact hh
  obtain ⟨hdn, Y, hYc, hYdet⟩ := wc_odp_kprime_point n d r t' A' ht' hA' (fun j => f (u j)) hv
    hv2 (fun l => f (w l)) hz3 (fun i j l => f (G i j l)) hGs (B.map f) hBs
  set ι := IsLocalRing.ResidueField.map f with hι
  have hY' : ∀ l, ∑ i, ∑ j, (Y (Fin.castLE hdn i) (Fin.castLE hdn j) -
      ι ((B.map (IsLocalRing.residue R)) i j)) *
        ι ((fun i j l => IsLocalRing.residue R (G i j l)) i j l) = 0 := by
    intro l
    simpa [hι, IsLocalRing.ResidueField.map_residue] using hYc l

  obtain ⟨M, X₀, X, e, hYdec, hX₀, hXs⟩ := wc_odp_retract_decomp ι n d r hdn
    (fun i j l => IsLocalRing.residue R (G i j l)) (B.map (IsLocalRing.residue R)) Y hY'
  haveI : Fintype L := Fintype.ofFinite L
  have hinj : Function.Injective (fun x : L => IsLocalRing.residue R (φ x)) :=
    ((IsLocalRing.residue R).comp φ).injective
  have hT : n < (Finset.univ.image (fun x : L => IsLocalRing.residue R (φ x))).card := by
    rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, ← Nat.card_eq_fintype_card]
    exact hn
  rw [hYdec] at hYdet
  obtain ⟨cc, hcc⟩ := wc_odp_poly_nonvanish ι n M _ hT X₀ X e hYdet
  have hZ : ∀ l, ∑ i, ∑ j, ((X₀ + ∑ s, cc s • X s) (Fin.castLE hdn i) (Fin.castLE hdn j) -
      IsLocalRing.residue R (B i j)) * IsLocalRing.residue R (G i j l) = 0 := by
    intro l
    have e1 := hX₀ l
    have e2 : ∀ s, ∑ i, ∑ j, X s (Fin.castLE hdn i) (Fin.castLE hdn j) *
        IsLocalRing.residue R (G i j l) = 0 := fun s => hXs s l
    have key : ∑ i, ∑ j, ((X₀ + ∑ s, cc s • X s) (Fin.castLE hdn i) (Fin.castLE hdn j) -
        IsLocalRing.residue R (B i j)) * IsLocalRing.residue R (G i j l) =
        ∑ i, ∑ j, (X₀ (Fin.castLE hdn i) (Fin.castLE hdn j) - IsLocalRing.residue R (B i j)) *
          IsLocalRing.residue R (G i j l) +
        ∑ s, cc s * ∑ i, ∑ j, X s (Fin.castLE hdn i) (Fin.castLE hdn j) *
          IsLocalRing.residue R (G i j l) := by
      have e3 : ∑ s, cc s * ∑ i, ∑ j, X s (Fin.castLE hdn i) (Fin.castLE hdn j) *
          IsLocalRing.residue R (G i j l) =
          ∑ i, ∑ j, ∑ s, cc s * (X s (Fin.castLE hdn i) (Fin.castLE hdn j) *
            IsLocalRing.residue R (G i j l)) := by
        simp_rw [Finset.mul_sum]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun i _ => Finset.sum_comm
      rw [e3, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]
      rw [add_sub_right_comm, add_mul, Finset.sum_mul]
      congr 1
      exact Finset.sum_congr rfl fun s _ => by ring
    rw [key]
    have e1' : ∑ i, ∑ j, (X₀ (Fin.castLE hdn i) (Fin.castLE hdn j) -
        IsLocalRing.residue R (B i j)) * IsLocalRing.residue R (G i j l) = 0 := e1
    rw [e1', Finset.sum_eq_zero (fun s _ => by rw [e2 s, mul_zero]), add_zero]

  exact wc_odp_lift_finish n d r hdn u hu w hwm G (fun i j => (hG i j).symm) h B hB _ hZ hcc

theorem wc_ldp_dgp_submersive (E K : Type u) [Field E] [Field K] [Algebra E K]
    {XE XK : Scheme.{u}} (sE : XE ⟶ Spec (.of E)) (sK : XK ⟶ Spec (.of K)) (ρ : XK ⟶ XE)
    (hρ : ρ ≫ sE = sK ≫ Spec.map (CommRingCat.ofHom (algebraMap E K))) (w : XK)
    (g₀ g₁ : XE.presheaf.stalk (ρ w))
    (h : wcLdpSubmersive K sK w ((ρ.stalkMap w).hom g₀) ((ρ.stalkMap w).hom g₁)) :
    wcLdpSubmersive E sE (ρ w) g₀ g₁ :=
by
  classical

  have hcomm : (ρ.stalkMap w).hom.comp (wcLdpConst E sE (ρ w)) =
      (wcLdpConst K sK w).comp (algebraMap E K) := by
    ext e
    have h1 : ∀ y, (ρ.stalkMap w).hom ((XE.presheaf.germ ⊤ (ρ w) trivial).hom y) =
        (XK.presheaf.germ ⊤ w trivial).hom (ρ.appTop.hom y) := fun y =>
      Scheme.Hom.germ_stalkMap_apply ρ ⊤ w trivial y
    have h2 : ∀ z, ρ.appTop.hom (sE.appTop.hom z) =
        sK.appTop.hom ((Spec.map (CommRingCat.ofHom (algebraMap E K))).appTop.hom z) := by
      intro z
      have := congrArg (fun g => g.appTop.hom z) hρ
      simp only [Scheme.Hom.comp_appTop] at this
      exact this
    have h3 : (Spec.map (CommRingCat.ofHom (algebraMap E K))).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom e) =
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom (algebraMap E K e) := by
      have := congrArg (fun g => g.hom e)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap E K)))
      exact this.symm
    show (ρ.stalkMap w).hom ((XE.presheaf.germ ⊤ (ρ w) trivial).hom
        (sE.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom e))) =
      (XK.presheaf.germ ⊤ w trivial).hom
        (sK.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom (algebraMap E K e)))
    rw [h1, h2, h3]

  have key : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (iA : E →+* A) (iB : K →+* B) (f : A →+* B) [IsLocalHom f]
      (_ : f.comp iA = iB.comp (algebraMap E K)) (g₀ g₁ : A),
      (letI := iB.toAlgebra;
        f g₀ • KaehlerDifferential.D K B (f g₁) - f g₁ • KaehlerDifferential.D K B (f g₀) ∉
          (IsLocalRing.maximalIdeal B) • (⊤ : Submodule B (KaehlerDifferential K B))) →
      (letI := iA.toAlgebra;
        g₀ • KaehlerDifferential.D E A g₁ - g₁ • KaehlerDifferential.D E A g₀ ∉
          (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A (KaehlerDifferential E A))) := by
    intro A B _ _ _ _ iA iB f _ hc g₀ g₁ hB
    letI : Algebra E A := iA.toAlgebra
    letI : Algebra K B := iB.toAlgebra
    letI : Algebra A B := f.toAlgebra
    letI : Algebra E B := (f.comp iA).toAlgebra
    haveI : IsScalarTower E A B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower E K B :=
      IsScalarTower.of_algebraMap_eq (fun x => (congrArg (fun g => g x) hc : _))
    haveI : SMulCommClass K A B :=
      ⟨fun k a b => by simp only [Algebra.smul_def]; ring⟩
    haveI : IsScalarTower A B (KaehlerDifferential K B) :=
      KaehlerDifferential.isScalarTower_of_tower K B
    set L := KaehlerDifferential.map E K A B with hL
    intro hA
    apply hB
    have hω : L (g₀ • KaehlerDifferential.D E A g₁ - g₁ • KaehlerDifferential.D E A g₀) =
        f g₀ • KaehlerDifferential.D K B (f g₁) - f g₁ • KaehlerDifferential.D K B (f g₀) := by
      rw [map_sub, LinearMap.map_smul, LinearMap.map_smul, KaehlerDifferential.map_D,
        KaehlerDifferential.map_D, ← algebraMap_smul B g₀, ← algebraMap_smul B g₁]
      rfl
    rw [← hω]
    have hmap : ∀ x, x ∈ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A (KaehlerDifferential E A)) →
        L x ∈ (IsLocalRing.maximalIdeal B) • (⊤ : Submodule B (KaehlerDifferential K B)) := by
      intro x hx
      refine Submodule.smul_induction_on hx ?_ ?_
      · intro r hr n _
        rw [LinearMap.map_smul, ← algebraMap_smul B r (L n)]
        exact Submodule.smul_mem_smul
          ((IsLocalRing.mem_maximalIdeal _).mpr
            (map_nonunit f r ((IsLocalRing.mem_maximalIdeal _).mp hr))) Submodule.mem_top
      · intro x y hx hy
        rw [map_add]
        exact Submodule.add_mem _ hx hy
    exact hmap _ hA
  unfold wcLdpSubmersive at h ⊢
  exact key _ _ (wcLdpConst E sE (ρ w)) (wcLdpConst K sK w) (ρ.stalkMap w).hom hcomm g₀ g₁ h

theorem wc_ldp_descend_good_pencil (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom]
    (N : ℕ) (j : Y.left ⟶ wcProjK F' N) (hj : IsClosedImmersion j)
    (hjY : j ≫ wcProjKStr F' N = Y.hom)
    (hK : ∀ jK : Limits.pullback Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ⟶
          wcProjK (AlgebraicClosure F') N,
      IsClosedImmersion jK →
      jK ≫ wcProjKStr (AlgebraicClosure F') N =
        Limits.pullback.snd Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) →
      ∃ (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (AlgebraicClosure F') 2) (m : ℕ)
        (y : Fin m → (Spec (.of (AlgebraicClosure F')) ⟶ Limits.pullback Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
        (c : Fin m → Fin 2 → AlgebraicClosure F'),
        wcLdpGoodPencil (AlgebraicClosure F') N n
          (Over.mk (Limits.pullback.snd Y.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
          jK G₀ G₁ m y c) :
    ∃ (E : Type u) (_ : Field E) (_ : Finite E) (_ : Algebra F' E)
      (jE : Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ⟶ wcProjK E N),
      IsClosedImmersion jE ∧
      jE ≫ wcProjKStr E N =
        Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E))) ∧
      ∃ (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (m : ℕ)
        (y : Fin m → (Spec (.of E) ⟶
          Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))))
        (c : Fin m → Fin 2 → E),
        wcLdpGoodPencil E N n
          (Over.mk (Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E)))))
          jE G₀ G₁ m y c :=
by
  classical
  obtain ⟨jK, hjK, hjKY, hfam⟩ :=
    wc_ldp_dgp_embed F' (AlgebraicClosure F') Y N j hj hjY
  obtain ⟨G₀, G₁, m, y, c, hP⟩ := hK jK hjK hjKY
  obtain ⟨hP0, hP1, hsec, hoff, hc0, hnp, hS, hodp⟩ := hP
  choose Tp hTp using fun i => wc_ldp_dgp_points F' (AlgebraicClosure F') Y (y i) (hsec i)
  obtain ⟨Tb, hTbc⟩ := Infinite.exists_subset_card_eq (AlgebraicClosure F') (n + 1)
  obtain ⟨T, hT0, hT1, hTc, hTy, hTb⟩ : ∃ T : Finset (AlgebraicClosure F'),
      (∀ x ∈ (G₀ : MvPolynomial (Fin (N + 1)) (AlgebraicClosure F')).coeffs, x ∈ T) ∧
      (∀ x ∈ (G₁ : MvPolynomial (Fin (N + 1)) (AlgebraicClosure F')).coeffs, x ∈ T) ∧
      (∀ i k, c i k ∈ T) ∧ (∀ i, Tp i ⊆ T) ∧ Tb ⊆ T := by
    refine ⟨(G₀ : MvPolynomial (Fin (N + 1)) (AlgebraicClosure F')).coeffs ∪
      (G₁ : MvPolynomial (Fin (N + 1)) (AlgebraicClosure F')).coeffs ∪
      Finset.univ.biUnion (fun i => Finset.univ.image (c i)) ∪ Finset.univ.biUnion Tp ∪ Tb,
      ?_, ?_, ?_, ?_, ?_⟩
    · intro x hx
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_union_left _ hx)))
    · intro x hx
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_union_right _ hx)))
    · intro i k
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _,
          Finset.mem_image.mpr ⟨k, Finset.mem_univ _, rfl⟩⟩)))
    · intro i x hx
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hx⟩))
    · intro x hx
      exact Finset.mem_union_right _ hx
  obtain ⟨E', hTE, hfd⟩ : ∃ E' : IntermediateField F' (AlgebraicClosure F'),
      (∀ x ∈ T, x ∈ E') ∧ FiniteDimensional F' E' :=
    ⟨IntermediateField.adjoin F' (T : Set (AlgebraicClosure F')),
      fun x hx => IntermediateField.subset_adjoin F' _ (Finset.mem_coe.mpr hx),
      IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)⟩
  haveI := hfd
  haveI : Finite E' := Module.finite_of_finite F'
  have hrange : ∀ x ∈ T, x ∈ Set.range (algebraMap E' (AlgebraicClosure F')) :=
    fun x hx => ⟨⟨x, hTE x hx⟩, rfl⟩
  have hcard : n < Nat.card E' := by
    have h1 : Nat.card Tb ≤ Nat.card E' :=
      Nat.card_le_card_of_injective (fun x : Tb => (⟨x.1, hTE _ (hTb x.2)⟩ : E'))
        (fun a b hab => Subtype.ext (congrArg (fun z : E' => (z : AlgebraicClosure F')) hab))
    rw [Nat.card_eq_finsetCard, hTbc] at h1
    omega

  have hdesc : ∀ G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (AlgebraicClosure F') 2,
      (∀ x ∈ (G : MvPolynomial (Fin (N + 1)) (AlgebraicClosure F')).coeffs, x ∈ T) →
      ∃ GE, wcLdpMapQ E' (AlgebraicClosure F') N GE = G := by
    intro G hG
    obtain ⟨p, hp⟩ : (G : MvPolynomial (Fin (N + 1)) (AlgebraicClosure F')) ∈
        Set.range (MvPolynomial.map (algebraMap E' (AlgebraicClosure F'))) := by
      rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
      intro x hx
      exact hrange x (hG x hx)
    have hph : p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E' 2 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      intro d hd
      apply (MvPolynomial.mem_homogeneousSubmodule 2 _).mp G.2
      rw [← hp, MvPolynomial.coeff_map]
      intro h0
      apply hd
      exact (algebraMap E' (AlgebraicClosure F')).injective (by rw [h0, map_zero])
    exact ⟨⟨p, hph⟩, Subtype.ext hp⟩
  obtain ⟨GE₀, rfl⟩ := hdesc G₀ hT0
  obtain ⟨GE₁, rfl⟩ := hdesc G₁ hT1
  have hcm : ∀ i k, c i k ∈ E' := fun i k => hTE _ (hTc i k)
  obtain ⟨cE, rfl⟩ : ∃ cE : Fin m → Fin 2 → E',
      (fun i k => algebraMap E' (AlgebraicClosure F') (cE i k)) = c :=
    ⟨fun i k => ⟨c i k, hcm i k⟩, rfl⟩
  choose yE hyEsec hyEpt using fun i => hTp i E' (fun x hx => hrange x (hTy i hx))
  have hρc : wcLdpRho F' E' (AlgebraicClosure F') Y ≫
      Limits.pullback.snd Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E'))) =
      Limits.pullback.snd Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap E' (AlgebraicClosure F'))) :=
    Limits.pullback.lift_snd _ _ _
  obtain ⟨jE, hjE, hjEY, hchart, hgerm⟩ := hfam E'
  obtain ⟨hsurj, hflat⟩ := wc_ldp_dgp_rho_flat F' E' (AlgebraicClosure F') Y
  have hmax := wc_ldp_dgp_rho_maxideal F' E' (AlgebraicClosure F') Y
  generalize wcLdpRho F' E' (AlgebraicClosure F') Y = ρ at hρc hchart hgerm hsurj hflat hmax hyEpt
  have hmem : ∀ w (g : (Limits.pullback Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' E')))).presheaf.stalk (ρ w)),
      (ρ.stalkMap w).hom g ∈ IsLocalRing.maximalIdeal _ ↔ g ∈ IsLocalRing.maximalIdeal _ := by
    intro w g
    simp only [IsLocalRing.mem_maximalIdeal]
    exact map_mem_nonunits_iff _ g
  have hind : ∀ (w) (e r : ℕ) (v : Fin r → (Limits.pullback Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' E')))).presheaf.stalk (ρ w)),
      (∀ a : Fin r → (Limits.pullback Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' E')))).presheaf.stalk (ρ w),
        ∑ j, a j * v j ∈ IsLocalRing.maximalIdeal _ ^ e →
          ∀ j, a j ∈ IsLocalRing.maximalIdeal _) →
      ∀ s : Fin r → (Limits.pullback Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).presheaf.stalk w,
        ∑ j, s j * (ρ.stalkMap w).hom (v j) ∈ IsLocalRing.maximalIdeal _ ^ e →
          ∀ j, s j ∈ IsLocalRing.maximalIdeal _ := by
    intro w e r v hv s hs
    refine wc_ldp_dgp_flat_indep (ρ.stalkMap w).hom (hflat w) _ r v hv s ?_
    rw [Ideal.map_pow, hmax w]
    exact hs
  have haxis : ∀ w, wcLdpOnAxis E' N jE GE₀ GE₁ (ρ w) ↔
      wcLdpOnAxis (AlgebraicClosure F') N jK (wcLdpMapQ E' (AlgebraicClosure F') N GE₀)
        (wcLdpMapQ E' (AlgebraicClosure F') N GE₁) w := by
    intro w
    constructor
    · intro h a hw
      have hρw := (hchart w a).mp hw
      obtain ⟨h0, h1⟩ := h a hρw
      rw [← hgerm GE₀ w a hw hρw, ← hgerm GE₁ w a hw hρw, hmem, hmem]
      exact ⟨h0, h1⟩
    · intro h a hρw
      have hw := (hchart w a).mpr hρw
      obtain ⟨h0, h1⟩ := h a hw
      rw [← hgerm GE₀ w a hw hρw, hmem] at h0
      rw [← hgerm GE₁ w a hw hρw, hmem] at h1
      exact ⟨h0, h1⟩
  have hmemb : ∀ (E : Type u) [Field E] [Algebra E (AlgebraicClosure F')] (a b : E)
      (G G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2),
      wcLdpMapQ E (AlgebraicClosure F') N (a • G - b • G') =
        algebraMap E (AlgebraicClosure F') a • wcLdpMapQ E (AlgebraicClosure F') N G -
          algebraMap E (AlgebraicClosure F') b • wcLdpMapQ E (AlgebraicClosure F') N G' := by
    intro E _ _ a b G G'
    apply Subtype.ext
    simp only [wcLdpMapQ, Submodule.coe_sub, Submodule.coe_smul, MvPolynomial.smul_eq_C_mul,
      map_sub, map_mul, MvPolynomial.map_C]
  have hODP : ∀ (x : ↥(Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F' E')))))
      (w : ↥(Limits.pullback Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (hxw : ρ w = x) (H : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E' 2)
      (Hk : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (AlgebraicClosure F') 2)
      (hHk : wcLdpMapQ E' (AlgebraicClosure F') N H = Hk) (a : Fin (N + 1))
      (hw : w ∈ jK ⁻¹ᵁ wcSgD (AlgebraicClosure F') N a) (hx : x ∈ jE ⁻¹ᵁ wcSgD E' N a),
      (∃ (t' : Fin n → (Limits.pullback Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).presheaf.stalk w)
        (A' : Matrix (Fin n) (Fin n) ((Limits.pullback Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))).presheaf.stalk w)),
        IsLocalRing.maximalIdeal _ = Ideal.span (Set.range t') ∧
        wcLdpGerm (AlgebraicClosure F') N jK Hk a w hw - ∑ k, ∑ l, A' k l * t' k * t' l ∈
          IsLocalRing.maximalIdeal _ ^ 3 ∧
        IsUnit (A' + A'.transpose).det) →
      ∃ (t : Fin n → (Limits.pullback Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' E')))).presheaf.stalk x)
        (A : Matrix (Fin n) (Fin n) ((Limits.pullback Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' E')))).presheaf.stalk x)),
        IsLocalRing.maximalIdeal _ = Ideal.span (Set.range t) ∧
        wcLdpGerm E' N jE H a x hx - ∑ k, ∑ l, A k l * t k * t l ∈
          IsLocalRing.maximalIdeal _ ^ 3 ∧
        IsUnit (A + A.transpose).det := by
    intro x w hxw H Hk hHk a hw hx hK'
    subst hxw
    subst hHk
    obtain ⟨t', A', ht', hh', hA'⟩ := hK'
    have hh'' : (ρ.stalkMap w).hom (wcLdpGerm E' N jE H a _ hx) -
        ∑ k, ∑ l, A' k l * t' k * t' l ∈ IsLocalRing.maximalIdeal _ ^ 3 := by
      rw [hgerm H w a hw hx]
      exact hh'
    exact wc_ldp_dgp_odp_descend (ρ.stalkMap w).hom (hmax w) (hind w 2) (hind w 3) E'
      (wcLdpConst E' (Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' E')))) (ρ w))
      n hcard (wcLdpGerm E' N jE H a _ hx) t' A' ht' hh'' hA'
  refine ⟨E', inferInstance, inferInstance, inferInstance, jE, hjE, hjEY, GE₀, GE₁, m, yE, cE,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    obtain ⟨x₀, hx₀⟩ := hP0
    exact ⟨ρ x₀, fun h => hx₀ ((haxis x₀).mp h)⟩
  ·
    intro x a hx hax
    obtain ⟨w, rfl⟩ := hsurj x
    have hw := (hchart w a).mpr hx
    obtain ⟨k, t', ht', hdim⟩ := hP1 w a hw ((haxis w).mp hax)
    have ht'' : IsLocalRing.maximalIdeal _ = Ideal.span
        (insert ((ρ.stalkMap w).hom (wcLdpGerm E' N jE GE₀ a (ρ w) hx))
          (insert ((ρ.stalkMap w).hom (wcLdpGerm E' N jE GE₁ a (ρ w) hx)) (Set.range t'))) := by
      rw [hgerm GE₀ w a hw hx, hgerm GE₁ w a hw hx]
      exact ht'
    obtain ⟨t, ht⟩ :=
      wc_ldp_dgp_gen_descend (ρ.stalkMap w).hom (hmax w) (hind w 2) _ _ k t' ht''
    refine ⟨k, t, ht, ?_⟩
    rw [hdim]
    exact (wc_ldp_dgp_dim_eq (ρ.stalkMap w).hom (hflat w) (hmax w)).symm
  ·
    intro i
    exact hyEsec i
  ·
    intro i h
    apply hoff i
    rw [← hyEpt i] at h
    exact (haxis _).mp h
  ·
    intro i h
    apply hc0 i
    funext k
    simp [h]
  ·
    intro i i' hii' h
    apply hnp i i' hii'
    have := congrArg (algebraMap E' (AlgebraicClosure F')) h
    simpa using this
  ·
    intro x a hx hax hne
    obtain ⟨w, rfl⟩ := hsurj x
    have hw := (hchart w a).mpr hx
    have hneK : ∀ i, w ≠ y i (IsLocalRing.closedPoint (AlgebraicClosure F')) := by
      intro i h
      apply hne i
      rw [h]
      exact hyEpt i
    have h1 := hS w a hw (fun h => hax ((haxis w).mpr h)) hneK
    have h2 : wcLdpSubmersive (AlgebraicClosure F') (Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) w
        ((ρ.stalkMap w).hom (wcLdpGerm E' N jE GE₀ a (ρ w) hx))
        ((ρ.stalkMap w).hom (wcLdpGerm E' N jE GE₁ a (ρ w) hx)) := by
      rw [hgerm GE₀ w a hw hx, hgerm GE₁ w a hw hx]
      exact h1
    exact wc_ldp_dgp_submersive E' (AlgebraicClosure F') _ _ ρ hρc w _ _ h2
  ·
    intro i a hx
    have hw : y i (IsLocalRing.closedPoint (AlgebraicClosure F')) ∈
        jK ⁻¹ᵁ wcSgD (AlgebraicClosure F') N a := by
      apply (hchart _ a).mpr
      rw [hyEpt i]
      exact hx
    exact hODP _ _ (hyEpt i) _ _ (hmemb E' (cE i 1) (cE i 0) GE₀ GE₁) a hw hx (hodp i a hw)

theorem wc_ldp_alg_dependence (K : Type*) [Field K] {σ : Type*} [Fintype σ] (A : Type*)
    [CommRing A] [Algebra K A] [Algebra.FiniteType K A] (φ : MvPolynomial σ K →ₐ[K] A)
    (hdim : ringKrullDim A < (Fintype.card σ : WithBot ℕ∞)) :
    ∃ Φ : MvPolynomial σ K, Φ ≠ 0 ∧ φ Φ = 0 :=
by
  classical
  by_contra hcon
  push_neg at hcon
  have hφ : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    exact hcon a hne ha
  obtain ⟨P, hP, -, hPdisj⟩ := Ideal.exists_le_prime_disjoint (⊥ : Ideal A)
      (Submonoid.map φ (nonZeroDivisors (MvPolynomial σ K))) (by
        rw [Set.disjoint_left]
        rintro a ha ⟨x, hx, rfl⟩
        have h0 : φ x = 0 := (Submodule.mem_bot K).mp ha
        have hx0 : x = 0 := (injective_iff_map_eq_zero φ).mp hφ x h0
        rw [hx0] at hx
        exact zero_notMem_nonZeroDivisors hx)
  haveI := hP
  set ψ : MvPolynomial σ K →ₐ[K] A ⧸ P := (Ideal.Quotient.mkₐ K P).comp φ with hψdef
  have hψ : Function.Injective ψ := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    have h1 : φ a ∈ P := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact ha
    have h2 : φ a ∈ Submonoid.map φ (nonZeroDivisors (MvPolynomial σ K)) :=
      ⟨a, mem_nonZeroDivisors_of_ne_zero hne, rfl⟩
    exact Set.disjoint_left.mp hPdisj h1 h2
  obtain ⟨r, g, hg, hgi⟩ := exists_integral_inj_algHom_of_fg K (A ⧸ P)
  have hx : AlgebraicIndependent K (fun i => ψ (MvPolynomial.X i)) := by
    rw [algebraicIndependent_iff_injective_aeval]
    have : (MvPolynomial.aeval (fun i => ψ (MvPolynomial.X i))) = ψ :=
      (MvPolynomial.aeval_unique ψ).symm
    rw [this]
    exact hψ
  have hy : AlgebraicIndependent K (fun i => g (MvPolynomial.X i)) := by
    rw [algebraicIndependent_iff_injective_aeval]
    have : (MvPolynomial.aeval (fun i => g (MvPolynomial.X i))) = g :=
      (MvPolynomial.aeval_unique g).symm
    rw [this]
    exact hg
  set B := Algebra.adjoin K (Set.range (fun i => g (MvPolynomial.X i))) with hBdef
  let g' : MvPolynomial (Fin r) K →ₐ[K] B :=
    MvPolynomial.aeval (fun i => (⟨g (MvPolynomial.X i), Algebra.subset_adjoin ⟨i, rfl⟩⟩ : B))
  have hg' : (algebraMap B (A ⧸ P)).comp (g' : MvPolynomial (Fin r) K →+* B) =
      (g : MvPolynomial (Fin r) K →+* A ⧸ P) := by
    have : B.val.comp g' = g := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [g']
    exact congrArg AlgHom.toRingHom this
  have halg : Algebra.IsAlgebraic B (A ⧸ P) := by
    constructor
    intro d
    apply _root_.IsIntegral.isAlgebraic
    obtain ⟨p, hpm, hp⟩ := hgi d
    refine ⟨p.map (g' : MvPolynomial (Fin r) K →+* B), hpm.map _, ?_⟩
    rw [Polynomial.eval₂_map, hg']
    exact hp
  have hbasis : IsTranscendenceBasis K (fun i => g (MvPolynomial.X i)) :=
    isTranscendenceBasis_iff_algebraicIndependent_isAlgebraic.mpr ⟨hy, halg⟩
  have htr : Algebra.trdeg K (A ⧸ P) = r := by
    have h := hbasis.lift_cardinalMk_eq_trdeg
    rw [Cardinal.mk_fin, Cardinal.lift_natCast] at h
    exact Cardinal.lift_eq_nat_iff.mp h.symm
  have hcard : Fintype.card σ ≤ r := by
    have h1 := hx.lift_cardinalMk_le_trdeg
    rw [htr, Cardinal.mk_fintype, Cardinal.lift_natCast, Cardinal.lift_natCast] at h1
    exact_mod_cast h1
  have hdimD : ringKrullDim (MvPolynomial (Fin r) K) ≤ ringKrullDim (A ⧸ P) := by
    letI : Algebra (MvPolynomial (Fin r) K) (A ⧸ P) :=
      (g : MvPolynomial (Fin r) K →+* A ⧸ P).toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial (Fin r) K) (A ⧸ P) := ⟨fun x => hgi x⟩
    have hinj : Function.Injective (algebraMap (MvPolynomial (Fin r) K) (A ⧸ P)) := hg
    have lift : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum (MvPolynomial (Fin r) K))),
        p.length = n → ∃ q : LTSeries (PrimeSpectrum (A ⧸ P)), q.length = n ∧
          Ideal.comap (algebraMap (MvPolynomial (Fin r) K) (A ⧸ P)) q.last.asIdeal =
            p.last.asIdeal := by
      intro n
      induction n with
      | zero =>
        intro p _
        obtain ⟨Q, -, hQ, hQc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal
          (⊥ : Ideal (A ⧸ P)) (show Ideal.comap (algebraMap _ _) ⊥ ≤ _ by
            rw [Ideal.comap_bot_of_injective _ hinj]; exact bot_le)
        exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQc⟩
      | succ n ih =>
        intro p hp
        obtain ⟨q', hq'l, hq'c⟩ := ih p.eraseLast (by rw [RelSeries.eraseLast_length, hp]; rfl)
        have hlt : p.eraseLast.last < p.last := RelSeries.eraseLast_last_rel_last p (by omega)
        obtain ⟨Q, hQI, hQ, hQc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p.last.asIdeal
          q'.last.asIdeal (show Ideal.comap (algebraMap _ _) q'.last.asIdeal ≤ _ by
            rw [hq'c]; exact hlt.le)
        have hlt' : q'.last < (⟨Q, hQ⟩ : PrimeSpectrum (A ⧸ P)) := by
          refine lt_of_le_of_ne (show q'.last ≤ ⟨Q, hQ⟩ from hQI) ?_
          intro heq
          apply hlt.ne
          apply PrimeSpectrum.ext
          rw [← hq'c, heq]
          exact hQc
        refine ⟨q'.snoc ⟨Q, hQ⟩ hlt', ?_, ?_⟩
        · rw [RelSeries.snoc_length, hq'l]
        · rw [RelSeries.last_snoc]
          exact hQc
    show Order.krullDim _ ≤ Order.krullDim _
    refine iSup_le fun p => ?_
    obtain ⟨q, hq, -⟩ := lift p.length p rfl
    rw [← hq]
    exact Order.LTSeries.length_le_krullDim q
  have hpoly : ringKrullDim (MvPolynomial (Fin r) K) = (r : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
    simp
  have hc : ((Fintype.card σ : ℕ) : WithBot ℕ∞) ≤ (r : WithBot ℕ∞) := by exact_mod_cast hcard
  have hfinal : ((Fintype.card σ : ℕ) : WithBot ℕ∞) ≤ ringKrullDim A :=
    hc.trans (hpoly ▸ hdimD |>.trans (ringKrullDim_quotient_le P))
  exact lt_irrefl _ (hfinal.trans_lt hdim)

