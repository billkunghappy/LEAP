      intro V k hk
      have hk' : (k : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
      change IsUnit (k : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ]))
      refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((k : ℚ_[ℓ])⁻¹)), ?_⟩
      refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
      simp [hk']
    obtain ⟨L, adj, hLA, hLL, hLC⟩ := sheafOfModules_toSheaf_exact_left_adjoint
      (Scheme.ProEt.topology E) (wcRingSheaf E ℓ) hunit

    have s1 : ∀ (T : E.ProEt) (Fs : Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}),
        Function.Bijective (fun φ : (presheafToSheaf (Scheme.ProEt.topology E)
            AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙
              AddCommGrpCat.free) ⟶ Fs =>
          φ.hom.app (Opposite.op T)
            ((toSheafify (Scheme.ProEt.topology E)
              (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
              (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) := by
      intro T Fs
      let e2 : ∀ G : (E.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃
            G.obj (Opposite.op T) :=
        fun G => ((Adjunction.whiskerRight (E.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G).trans
            (uliftYonedaEquiv.{u+1} (X := T) (F := G ⋙ forget AddCommGrpCat.{u+1}))
      have he2 : ∀ (G : (E.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
          (ψ : yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
          e2 G ψ = ψ.app (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))) := by
        intro G ψ
        rfl
      let e : ((presheafToSheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}).obj
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs) ≃
            Fs.obj.obj (Opposite.op T) :=
        ((sheafificationAdjunction (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs).trans (e2 Fs.obj)
      have he : ∀ φ, e φ = φ.hom.app (Opposite.op T)
            ((toSheafify (Scheme.ProEt.topology E)
              (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
              (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
        intro φ
        show e2 Fs.obj ((sheafificationAdjunction (Scheme.ProEt.topology E)
            AddCommGrpCat.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs φ) = _
        rw [he2, Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
        rfl
      have hfun : (fun φ : (presheafToSheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}).obj
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
          φ.hom.app (Opposite.op T)
            ((toSheafify (Scheme.ProEt.topology E)
              (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
              (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) = ⇑e :=
        funext fun φ => (he φ).symm
      rw [hfun]
      exact e.bijective
    have s3 : ∀ (T : E.ProEt), Limits.IsTerminal T →
        ∀ M : SheafOfModules.{u+1} (wcRingSheaf E ℓ),
        Function.Bijective (fun g : SheafOfModules.unit (wcRingSheaf E ℓ) ⟶ M =>
          g.val.app (Opposite.op T) (1 : (wcRingSheaf E ℓ).obj.obj (Opposite.op T))) := by
      intro T hT M
      have hev : Function.Bijective (fun s : M.val.sections =>
          (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) := by
        constructor
        · intro s s' hss
          apply Subtype.ext
          funext X
          have e1 := s.2 (hT.from X.unop).op
          have e2 := s'.2 (hT.from X.unop).op
          simp only at hss
          rw [← e1, ← e2, hss]
        · intro w
          refine ⟨PresheafOfModules.sectionsMk (fun X => M.val.map (hT.from X.unop).op w) ?_, ?_⟩
          · intro X Y g
            rw [← PresheafOfModules.map_comp_apply]
            exact PresheafOfModules.congr_map_apply M.val
              (Quiver.Hom.unop_inj (hT.hom_ext _ _)) w
          · change M.val.map (hT.from T).op w = w
            rw [show hT.from T = 𝟙 T from hT.hom_ext _ _]
            simp only [op_id, PresheafOfModules.map_id]
            rfl
      have hfun : (fun g : SheafOfModules.unit (wcRingSheaf E ℓ) ⟶ M =>
          g.val.app (Opposite.op T) (1 : (wcRingSheaf E ℓ).obj.obj (Opposite.op T))) =
          (fun s : M.val.sections =>
            (show M.val.obj (Opposite.op T) from s.1 (Opposite.op T))) ∘
              ⇑(SheafOfModules.unitHomEquiv M) := by
        funext g
        simp [SheafOfModules.unitHomEquiv_apply_coe]
      rw [hfun]
      exact hev.comp (SheafOfModules.unitHomEquiv M).bijective
    have bij_help : ∀ {α β γ : Type (u+1)} (ev : β → γ) (Θ : α → β) (e : α → γ),
