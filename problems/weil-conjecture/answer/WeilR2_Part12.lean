        exact congrArg (fun z => i ≫ z) (Equiv.apply_symm_apply (adj.homEquiv _ _) ε)
      rw [hh]
      have h1 : ((sheafifyMap (Scheme.ProEt.topology S) w).app (Opposite.op VU)).hom gVU =
          ((toSheafify (Scheme.ProEt.topology S) (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app (Opposite.op VU)).hom
            ((w.app (Opposite.op VU)).hom (FreeAbelianGroup.of (ULift.up (𝟙 VU)))) :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op VU))
            (toSheafify_naturality (Scheme.ProEt.topology S) w)) _).symm
      change (ε.hom.app (Opposite.op VU)).hom
        (((sheafifyMap (Scheme.ProEt.topology S) w).app (Opposite.op VU)).hom gVU) = _
      rw [h1, hwof]
      exact hεval _ _

    have hloc : ∀ (W : S.ProEt) (a' : W ⟶ VU) (f : (wcIntUnit S ℓ).val.obj (Opposite.op W)),
        ∃ t : (L.obj (wcFreeSheaf S VU)).val.obj (Opposite.op W),
          (ιJ.val.app (Opposite.op W)).hom t = f := by
      intro W a' f
      let sW := ((L.obj (wcFreeSheaf S VU)).val.map a'.op).hom s
      have hsW : (ιJ.val.app (Opposite.op W)).hom sW =
          (show (wcIntUnit S ℓ).val.obj (Opposite.op W) from
            (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op W))) := by
        have hn : (ιJ.val.app (Opposite.op W)).hom sW =
            ((wcIntUnit S ℓ).val.map a'.op).hom ((ιJ.val.app (Opposite.op VU)).hom s) :=
          PresheafOfModules.naturality_apply ιJ.val a'.op s
        rw [hn, hι1]
        exact PresheafOfModules.unit_map_one _ a'.op
      let r : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op W) := f
      refine ⟨r • sW, ?_⟩
      have e1 := (ιJ.val.app (Opposite.op W)).hom.map_smul r sW
      exact e1.trans ((congrArg (fun z => r • z) hsW).trans (mul_one r))

    have htf : ∀ k : ℕ, Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) := by
      intro k
      have hn : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero
      have tf : ∀ {α : Type (u+1)} (y : FreeAbelianGroup α), (ℓ ^ k : ℕ) • y = 0 → y = 0 := by
        intro α y h
        apply (FreeAbelianGroup.equivFinsupp α).injective
        rw [map_zero]
        ext t
        have h' : (FreeAbelianGroup.equivFinsupp α ((ℓ ^ k : ℕ) • y)) t = 0 := by
          rw [h, map_zero, Finsupp.zero_apply]
        rw [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at h'
        rw [Finsupp.zero_apply]
        exact (mul_eq_zero.mp h').resolve_left (by exact_mod_cast hn)
      have hsat : ∀ (X : (S.ProEt)ᵒᵖ) (y : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ T))),
          (ℓ ^ k : ℕ) • y ∈ (w.app X).hom.range → y ∈ (w.app X).hom.range := by
        intro X y hy
        by_cases hne : Nonempty (X.unop ⟶ VU)
        · obtain ⟨b⟩ := hne
          clear hy
          induction y using FreeAbelianGroup.induction_on with
          | zero => exact zero_mem _
          | of t =>
            refine AddMonoidHom.mem_range.mpr ⟨FreeAbelianGroup.of (ULift.up b), ?_⟩
            exact (hwof X (ULift.up b)).trans
              (congrArg FreeAbelianGroup.of (ULift.ext _ _ (huniqT _ _ _)))
          | neg t ht => exact neg_mem ht
          | add x y hx hy => exact add_mem hx hy
        · obtain ⟨z, hz⟩ := AddMonoidHom.mem_range.mp hy
          have hz0 : ∀ z' : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ VU)), z' = 0 := by
            intro z'
            induction z' using FreeAbelianGroup.induction_on with
            | zero => rfl
            | of t => exact absurd ⟨t.down⟩ hne
            | neg t ht => rw [ht, neg_zero]
            | add x y hx hy => rw [hx, hy, add_zero]
          have hwz : (w.app X).hom z = 0 := by
            rw [hz0 z]
            exact map_zero _
          rw [tf y (hz.symm.trans hwz)]
          exact zero_mem _
      have T1 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w)) := by
        have happ : ∀ X, Mono (((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w)).app X) := by
          intro X
          rw [NatTrans.app_nsmul, NatTrans.id_app]
          let E := Limits.PreservesCokernel.iso ((evaluation (S.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj X) w ≪≫
            AddCommGrpCat.cokernelIsoQuotient (w.app X)
          have hq : Mono ((ℓ ^ k : ℕ) • 𝟙 (AddCommGrpCat.of
              (↑((yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj X) ⧸
                (w.app X).hom.range))) := by
            rw [AddCommGrpCat.mono_iff_injective]
            have hsm : ∀ z, (ConcreteCategory.hom ((ℓ ^ k : ℕ) • 𝟙 (AddCommGrpCat.of
                (↑((yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj X) ⧸
                  (w.app X).hom.range)))) z = (ℓ ^ k : ℕ) • z := by
              intro z
              show (AddCommGrpCat.Hom.hom ((ℓ ^ k : ℕ) • 𝟙 _)) z = _
              rw [AddCommGrpCat.hom_nsmul]
              rfl
            intro x y hxy
            rw [hsm, hsm] at hxy
            have h0 : (ℓ ^ k : ℕ) • (x - y) = 0 := by rw [smul_sub, hxy, sub_self]
            rw [← sub_eq_zero]
            obtain ⟨z, hz⟩ := QuotientAddGroup.mk_surjective (x - y)
            rw [← hz] at h0 ⊢
            rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff] at h0
            rw [QuotientAddGroup.eq_zero_iff]
            exact hsat X z h0
          have hc : ((ℓ ^ k : ℕ) • 𝟙 ((Limits.cokernel w).obj X)) =
              E.hom ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ E.inv := by
            rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, E.hom_inv_id]
            try rfl
          rw [hc]
          exact @mono_comp _ _ _ _ _ E.hom inferInstance _ (@mono_comp _ _ _ _ _ _ hq E.inv inferInstance)
        exact NatTrans.mono_of_mono_app _
      have T2 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) := by
        haveI := T1
        have h0 : Mono ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
            ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w))) :=
          Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) _
        have h1 : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
            ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w)) = (ℓ ^ k : ℕ) • 𝟙
              ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
                (Limits.cokernel w)) := by
          rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
        rw [h1] at h0
        let e := Limits.PreservesCokernel.iso
          (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) w
        have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) =
            e.inv ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ e.hom := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, e.inv_hom_id]
          try rfl
        rw [hc]
        exact @mono_comp _ _ _ _ _ e.inv inferInstance _ (@mono_comp _ _ _ _ _ _ h0 e.hom inferInstance)
      have T3 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel (L.map i))) := by
        haveI := T2
        have h0 : Mono (L.map ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i))) := Functor.map_mono L _
        have h1 : L.map ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) =
            (ℓ ^ k : ℕ) • 𝟙 (L.obj (Limits.cokernel i)) := by
          rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
        rw [h1] at h0
        let e := Limits.PreservesCokernel.iso L i
        have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel (L.map i))) =
            e.inv ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ e.hom := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, e.inv_hom_id]
          try rfl
        rw [hc]
        exact @mono_comp _ _ _ _ _ e.inv inferInstance _ (@mono_comp _ _ _ _ _ _ h0 e.hom inferInstance)
      haveI := T3
      let c := Limits.cokernelCompIsIso (L.map i) φ
      have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) = c.hom ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ c.inv := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, c.hom_inv_id]
      rw [hc]
      infer_instance
    exact ⟨ιJ, s, inferInstance, htf, hiii, hloc⟩

  obtain ⟨ιJ, s, hmono, htf, hinj, hloc⟩ :=
    hdata S VU hVUo L adj inferInstance inferInstance inferInstance

  have hJ : ιJ ≫ π = 0 := by
    apply hinj
    obtain ⟨k₀, hk₀⟩ := (hK VU ((ιJ.val.app (Opposite.op VU)).hom s)).2 (by
      intro z hz
      exfalso
      have h1 : VU.hom z ∈ Set.range VU.hom := ⟨z, rfl⟩
      rw [hVU] at h1
      exact h1 hz)
    have e1 : ((ιJ ≫ π).val.app (Opposite.op VU)).hom s =
        (π.val.app (Opposite.op VU)).hom ((ιJ.val.app (Opposite.op VU)).hom s) := rfl
    have e2 : ((Limits.kernel.ι π ≫ π).val.app (Opposite.op VU)).hom k₀ =
        (π.val.app (Opposite.op VU)).hom
          (((Limits.kernel.ι π).val.app (Opposite.op VU)).hom k₀) := rfl
    rw [e1, ← hk₀, ← e2, Limits.kernel.condition]
    rfl

  refine ⟨Limits.kernel.lift π ιJ hJ, ?_, ?_⟩
  · have hfac : Limits.kernel.lift π ιJ hJ ≫ Limits.kernel.ι π = ιJ :=
      Limits.kernel.lift_ι _ _ _
    haveI : Mono (Limits.kernel.lift π ιJ hJ ≫ Limits.kernel.ι π) := by
      rw [hfac]; exact hmono
    exact mono_of_mono _ (Limits.kernel.ι π)
  · intro k
    set j := Limits.kernel.lift π ιJ hJ with hjdef
    set ιK := Limits.kernel.ι π with hιK
    have hfac : j ≫ ιK = ιJ := Limits.kernel.lift_ι _ _ _

    have hmonoK : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) := by
      have hw : j ≫ (ιK ≫ Limits.cokernel.π ιJ) = 0 := by
        rw [← Category.assoc, hfac, Limits.cokernel.condition]
      let m : Limits.cokernel j ⟶ Limits.cokernel ιJ := Limits.cokernel.desc j _ hw
      have hm : Limits.cokernel.π j ≫ m = ιK ≫ Limits.cokernel.π ιJ := Limits.cokernel.π_desc _ _ _
      haveI hmm : Mono m := by
        apply Preadditive.mono_of_cancel_zero
        intro Q g hg
        obtain ⟨A', π₁, hπ₁, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π j) g
        have h1 : (y ≫ ιK) ≫ Limits.cokernel.π ιJ = 0 := by
          rw [Category.assoc, ← hm, ← Category.assoc, ← hy, Category.assoc, hg, Limits.comp_zero]
        obtain ⟨A'', π₂, hπ₂, z, hz⟩ :=
          (ShortComplex.exact_cokernel ιJ).exact_up_to_refinements (y ≫ ιK) h1
        have hz' : π₂ ≫ y ≫ ιK = z ≫ ιJ := hz
        haveI := hπ₁
        haveI := hπ₂
        have h2 : π₂ ≫ y = z ≫ j := by
          rw [← cancel_mono ιK, Category.assoc, Category.assoc, hfac]
          exact hz'
        have h3 : (π₂ ≫ π₁) ≫ g = 0 := by
          rw [Category.assoc, hy, ← Category.assoc, h2, Category.assoc, Limits.cokernel.condition,
            Limits.comp_zero]
        exact (cancel_epi (π₂ ≫ π₁)).1 (h3.trans Limits.comp_zero.symm)
      haveI : Mono (((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) ≫ m) := by
        have e : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) ≫ m =
            m ≫ ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
        rw [e]
        haveI := htf k
        infer_instance
      exact mono_of_mono _ m

    have hloc' : ∀ (W : S.ProEt) (a : W ⟶ VU)
        (f : (wcIntUnit S ℓ).val.obj (Opposite.op W)),
        ∃ t : (L.obj (wcFreeSheaf S VU)).val.obj (Opposite.op W),
          (ιK.val.app (Opposite.op W)).hom ((j.val.app (Opposite.op W)).hom t) = f := by
      intro W a f
      obtain ⟨t, ht⟩ := hloc W a f
      refine ⟨t, ?_⟩
      rw [← ht, ← hfac]
      rfl
    have hepi := hEpi (L.obj (wcFreeSheaf S VU)) j hloc' k
    exact isIso_of_mono_of_epi _

theorem wc_proet_free_zmod_ext_vanish_of_et_qcsep (S : Scheme.{u}) (VU : S.ProEt)
    [CompactSpace VU.left] [IsSeparated (Limits.terminal.from VU.left)] (m q : ℕ)
    (h : Subsingleton (wcEtCoh VU.left m q)) :
    ∀ x : Abelian.Ext (wcFreeSheaf S VU) (wcZModSheaf S m) q, x = 0 :=
by
  classical
  intro x
  obtain ⟨E₁⟩ := wc_ext_free_slice_zmod S VU m q
  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont VU.left
  haveI := hcont
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep VU.left
    ((constantSheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q
  let χ : (wcEpsInv VU.left).obj ((constantSheaf (Scheme.smallEtaleTopology VU.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅
      wcZModSheaf VU.left m :=
    (wc_epsInv_const VU.left (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).some ≪≫
      (wc_zmod_sheaf_const VU.left m).some.symm
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology VU.left) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B q ≃ Abelian.Ext A B' q) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf VU.left (Scheme.ProEt.mk (𝟙 VU.left))) χ.symm
  let E : Abelian.Ext (wcFreeSheaf S VU) (wcZModSheaf S m) q ≃
      wcEtCoh VU.left m q := E₁.trans (E₂.trans E₀)
  apply E.injective
  exact Subsingleton.elim _ _

theorem wc_strictHensel_weaklyEtale_smooth_isDomain (K : Type u) [Field K] {Y : Scheme.{u}}
    (pY : Y ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n pY]
    (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (k : Spec R ⟶ Y) (hk : WeaklyEtale k) : IsDomain R :=
by
  classical

  have hL1 : ∀ (C R : Type u) [CommRing C] [IsDomain C] [IsIntegrallyClosed C] [CommRing R]
      [IsLocalRing R] (σ : C →+* R), wcIndEtale σ → IsDomain R := by
    intro C R _ _ _ _ _ σ hσ
    letI : Algebra C R := σ.toAlgebra
    have hnzd : NoZeroDivisors R := by
      refine ⟨fun {a b} hab => ?_⟩
      let I : Ideal (MvPolynomial (Fin 2) C) :=
        Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) C)}
      haveI : Algebra.FinitePresentation C (MvPolynomial (Fin 2) C ⧸ I) :=
        Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton _)
      have hI : ∀ p ∈ I, MvPolynomial.aeval ![a, b] p = 0 := by
        intro p hp
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
        simp [hab]
      obtain ⟨E, _, _, hEt, α, β, hβα⟩ :=
        hσ (MvPolynomial (Fin 2) C ⧸ I) (Ideal.Quotient.liftₐ I (MvPolynomial.aeval ![a, b]) hI)
      have hX0 : Ideal.Quotient.liftₐ I (MvPolynomial.aeval ![a, b]) hI
          (Ideal.Quotient.mk I (MvPolynomial.X 0)) = a := by
        show MvPolynomial.aeval ![a, b] (MvPolynomial.X 0) = a
        simp
      have hX1 : Ideal.Quotient.liftₐ I (MvPolynomial.aeval ![a, b]) hI
          (Ideal.Quotient.mk I (MvPolynomial.X 1)) = b := by
        show MvPolynomial.aeval ![a, b] (MvPolynomial.X 1) = b
        simp
      have hab' : α (Ideal.Quotient.mk I (MvPolynomial.X 0)) *
          α (Ideal.Quotient.mk I (MvPolynomial.X 1)) = 0 := by
        rw [← map_mul, ← map_mul,
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
      let q : Ideal E := Ideal.comap β (IsLocalRing.maximalIdeal R)
      haveI : q.IsPrime := Ideal.comap_isPrime _ _
      haveI : IsDomain (Localization.AtPrime q) := wc_ring_etale_localization_isDomain C E q
      have hunit : ∀ s : q.primeCompl, IsUnit ((β : E →+* R) (s : E)) := by
        intro s
        exact IsLocalRing.notMem_maximalIdeal.mp
          (fun hm => (Ideal.mem_primeCompl_iff.mp s.2) (Ideal.mem_comap.mpr hm))
      have hβ' : ∀ e : E, IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q)
          hunit (algebraMap E (Localization.AtPrime q) e) = β e :=
        fun e => IsLocalization.lift_eq hunit e
      have hprod : algebraMap E (Localization.AtPrime q) (α (Ideal.Quotient.mk I (MvPolynomial.X 0))) *
          algebraMap E (Localization.AtPrime q) (α (Ideal.Quotient.mk I (MvPolynomial.X 1))) = 0 := by
        rw [← map_mul, hab', map_zero]
      rcases mul_eq_zero.mp hprod with h0 | h0
      · left
        rw [← hX0, ← hβα, AlgHom.comp_apply, ← hβ', h0, map_zero]
      · right
        rw [← hX1, ← hβα, AlgHom.comp_apply, ← hβ', h0, map_zero]
    exact NoZeroDivisors.to_isDomain R

  have h1 := wc_lfi_fromSpecStalk_weaklyEtale Y (k (IsLocalRing.closedPoint R))
  have h3 : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo k) ≫
      Y.fromSpecStalk (k (IsLocalRing.closedPoint R))) := by
    rw [Scheme.Spec_stalkClosedPointTo_fromSpecStalk]; exact hk
  have h4 : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo k)) :=
    WeaklyEtale.of_comp _ (Y.fromSpecStalk (k (IsLocalRing.closedPoint R)))

  letI algCR : Algebra (Y.presheaf.stalk (k (IsLocalRing.closedPoint R))) R :=
    (Scheme.stalkClosedPointTo k).hom.toAlgebra
  have hWE_CB : Algebra.WeaklyEtale (Y.presheaf.stalk (k (IsLocalRing.closedPoint R))) R :=
    wc_lpkt_specMap_weaklyEtale_ring _ _ (Scheme.stalkClosedPointTo k).hom h4

  haveI : Smooth pY := SmoothOfRelativeDimension.smooth n pY
  haveI hKdom : IsDomain K := DivisionRing.isDomain
  haveI hKic : IsIntegrallyClosed K := inferInstance
  haveI hKnoeth : IsNoetherianRing K := inferInstance
  obtain ⟨hCdom, hCic⟩ :=
    @wc_fntame_smooth_stalk_normal K _ hKdom hKic hKnoeth Y pY _ (k (IsLocalRing.closedPoint R))

  have hsep : IsSepClosed (IsLocalRing.ResidueField R) := inferInstance
  obtain ⟨R', _, σ, ρ, _, hρσ, hRh, hRsep, hρloc, hσ⟩ :=
    wc_strict_hull (Y.presheaf.stalk (k (IsLocalRing.closedPoint R))) R hsep
  letI : Algebra (Y.presheaf.stalk (k (IsLocalRing.closedPoint R))) R' := σ.toAlgebra
  letI : Algebra R' R := ρ.toAlgebra
  haveI : IsScalarTower (Y.presheaf.stalk (k (IsLocalRing.closedPoint R))) R' R :=
    IsScalarTower.of_algebraMap_eq' hρσ.symm
  have hWE_CR : Algebra.WeaklyEtale (Y.presheaf.stalk (k (IsLocalRing.closedPoint R))) R' :=
    wc_indEtale_weaklyEtale σ hσ
  have hWE_RB : Algebra.WeaklyEtale R' R :=
    wc_weaklyEtale_cancel _ _ _ hWE_CR hWE_CB
  have hbij : Function.Bijective ρ :=
    wc_olivier R' R hRh hRsep hρloc hWE_RB
  haveI : IsDomain R' := hL1 _ R' σ hσ
  exact MulEquiv.isDomain R' (RingEquiv.ofBijective ρ hbij).symm.toMulEquiv

theorem wc_strictHensel_int_unit_tors_ext_vanish (R : CommRingCat.{u}) [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m j : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
    ∀ x : Abelian.Ext (wcIntUnit (Spec R) ℓ) (wcIntTors (Spec R) ℓ m) (j + 1), x = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (Spec R) ℓ)) := HasExt.standard _
  intro x
  have hEt : Subsingleton (wcEtCoh (Spec R) (ℓ ^ m) (j + 1)) := by
    have hR := wc_et_strictly_local_ext_vanishing (↑R)
      ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of ↑R))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) j
    exact hR
  have h0 := wc_proet_zmod_ext_vanish_of_et (Spec R) (ℓ ^ m) j hEt
  obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod (Spec R) ℓ m
  have hmid : ∀ y : Abelian.Ext (wcFreeSheaf (Spec R) (Scheme.ProEt.mk (𝟙 (Spec R))))
      ((SheafOfModules.toSheaf (wcIntRingSheaf (Spec R) ℓ)).obj (wcIntTors (Spec R) ℓ m)) (j + 1),
      y = 0 := by
    intro y
    calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id y).symm
      _ = y.comp (Abelian.Ext.mk₀ (e.hom ≫ e.inv)) (add_zero _) := by rw [Iso.hom_inv_id]
      _ = y.comp ((Abelian.Ext.mk₀ e.hom).comp (Abelian.Ext.mk₀ e.inv) (add_zero 0))
            (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
      _ = (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv)
            (add_zero _) := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero _) (by omega)).symm
      _ = 0 := by rw [h0 (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)), Abelian.Ext.zero_comp]
  obtain ⟨E⟩ := wc_int_unit_ext_free_equiv (Spec R) ℓ (wcIntTors (Spec R) ℓ m) (j + 1)
  apply E.injective
  rw [hmid (E x), hmid (E 0)]

theorem wc_int_kernel_tors_ext_vanish_of_open (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (VU : S.ProEt) (Kz : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf S ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (j : L.obj (wcFreeSheaf S VU) ⟶ Kz) (hj : Mono j)
    (hiso : ∀ k : ℕ, IsIso ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)))
    (m q : ℕ) (h : ∀ x : Abelian.Ext (wcFreeSheaf S VU) (wcZModSheaf S (ℓ ^ m)) q, x = 0) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    ∀ y : Abelian.Ext Kz (wcIntTors S ℓ m) q, y = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  intro y
  haveI := hj

  haveI : (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  have hbij := ext_transfer_of_hom_bijective L
    (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)) adj (wcFreeSheaf S VU)
    (L.obj (wcFreeSheaf S VU)) (adj.unit.app (wcFreeSheaf S VU)) (by
      intro Z
      have e : (fun f : L.obj (wcFreeSheaf S VU) ⟶ Z =>
          adj.unit.app (wcFreeSheaf S VU) ≫
            (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map f) =
          adj.homEquiv (wcFreeSheaf S VU) Z :=
        funext fun f => (adj.homEquiv_unit _ _ f).symm
      rw [e]
      exact (adj.homEquiv _ Z).bijective)

  obtain ⟨e⟩ := wc_int_tors_toSheaf_zmod S ℓ m
  have hvanP : ∀ w : Abelian.Ext (wcFreeSheaf S VU)
      ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntTors S ℓ m)) q, w = 0 := by
    intro w
    have h0 := h (w.comp (Abelian.Ext.mk₀ e.hom) (add_zero _))
    calc w = (w.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv)
          (add_zero _) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h0]; exact Abelian.Ext.zero_comp _ _ _ _ _
  have hvanJ : ∀ w : Abelian.Ext (L.obj (wcFreeSheaf S VU)) (wcIntTors S ℓ m) q, w = 0 := by
    intro w
    exact (hbij (wcIntTors S ℓ m) q).1 ((hvanP _).trans (hvanP _).symm)

  have hS : (ShortComplex.mk j (Limits.cokernel.π j) (Limits.cokernel.condition j)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel j) hj inferInstance
  obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS (wcIntTors S ℓ m) y
    (hvanJ _)

  have hmk : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (f : A ⟶ B) (k : ℕ),
      Abelian.Ext.mk₀ (k • f) = k • Abelian.Ext.mk₀ f := by
    intro A B f k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hL' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} {p q r : ℕ}
      (a : Abelian.Ext A B p) (b : Abelian.Ext B C q) (h : p + q = r) (k : ℕ),
      (k • a).comp b h = k • a.comp b h := by
    intro A B C p q r a b h k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul]; exact Abelian.Ext.zero_comp _ _ _ _ _
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have hR' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} {p q r : ℕ}
      (a : Abelian.Ext A B p) (b : Abelian.Ext B C q) (h : p + q = r) (k : ℕ),
      a.comp (k • b) h = k • a.comp b h := by
    intro A B C p q r a b h k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul]; exact Abelian.Ext.comp_zero _ _ _ _ _
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
  have hΛ : (ℓ ^ m : ℕ) • 𝟙 (wcIntTors S ℓ m) = 0 := by
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit S ℓ)))).1
    have e1 : (ℓ ^ m : ℕ) • Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit S ℓ)) =
        ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
          Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
      rw [Preadditive.nsmul_comp, Category.id_comp]
    rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero, e1, Limits.cokernel.condition]
  haveI hψ := hiso m
  have h1 : (Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add q) = 0 := by
    calc (Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add q)
        = (ℓ ^ m : ℕ) • (Abelian.Ext.mk₀ (𝟙 (Limits.cokernel j))).comp x (zero_add q) := by
          rw [hmk, hL']
      _ = (ℓ ^ m : ℕ) • x := by rw [Abelian.Ext.mk₀_id_comp]
      _ = (ℓ ^ m : ℕ) • x.comp (Abelian.Ext.mk₀ (𝟙 (wcIntTors S ℓ m))) (add_zero q) := by
          rw [Abelian.Ext.comp_mk₀_id]
      _ = x.comp (Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (wcIntTors S ℓ m))) (add_zero q) := by
          rw [hmk, hR']
      _ = 0 := by rw [hΛ, Abelian.Ext.mk₀_zero]; exact Abelian.Ext.comp_zero _ _ _ _ _
  have hx0 : x = 0 := by
    calc x = (Abelian.Ext.mk₀ (inv ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j)))).comp
          ((Abelian.Ext.mk₀ ((ℓ ^ m : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add q))
          (zero_add q) := by
          rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      _ = 0 := by rw [h1]; exact Abelian.Ext.comp_zero _ _ _ _ _

  rw [← hx, hx0]
  exact Abelian.Ext.comp_zero _ _ _ _ _

theorem wc_int_kernel_tors_hom_extend {S : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Tset : Set S) {P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (π : wcIntUnit S ℓ ⟶ P)
    (hK : ∀ (V : S.ProEt) (f : (wcIntUnit S ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι π).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z ∈ Tset → (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (VU : S.ProEt) (hVUo : IsOpenImmersion VU.hom) (hVU : Set.range VU.hom = Tsetᶜ)
    (hconn : PreconnectedSpace VU.left) :
    ∀ φ : Limits.kernel π ⟶ wcIntTors S ℓ 1,
      ∃ ψ : wcIntUnit S ℓ ⟶ wcIntTors S ℓ 1, Limits.kernel.ι π ≫ ψ = φ :=
by
  classical
  intro φ
  set ιK := Limits.kernel.ι π with hιK

  obtain ⟨u₀, hu₀⟩ := (hK VU (show (wcIntUnit S ℓ).val.obj (Opposite.op VU) from
      (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op VU)))).2 (by
    intro z hz
    exfalso
    have h1 : VU.hom z ∈ Set.range VU.hom := ⟨z, rfl⟩
    rw [hVU] at h1
    exact h1 hz)

  have hΛ : (ℓ ^ 1 : ℕ) • 𝟙 (wcIntTors S ℓ 1) = 0 := by
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)))).1
    have e1 : (ℓ ^ 1 : ℕ) • Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) =
        ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫
          Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit S ℓ)) := by
      rw [Preadditive.nsmul_comp, Category.id_comp]
    rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero, e1, Limits.cokernel.condition]

  have hnsmul : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (f : A ⟶ B)
      (n : ℕ) (W : (S.ProEt)ᵒᵖ) (x : A.val.obj W),
      ((n • f).val.app W).hom x = n • (f.val.app W).hom x := by
    intro A B f n W x
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app,
        ModuleCat.hom_add, LinearMap.add_apply, ih]

  have inj : ∀ V : S.ProEt,
      Function.Injective (ιK.val.app (Opposite.op V)).hom := by
    intro V
    haveI : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)) :=
      inferInstance
    haveI : (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).PreservesMonomorphisms :=
      preservesMonomorphisms_of_preservesLimitsOfShape _
    have h1 : Mono ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map ιK) :=
      Functor.map_mono _ _
    have h2 : Mono ((sheafToPresheaf _ _).map ((SheafOfModules.toSheaf
        (wcIntRingSheaf S ℓ)).map ιK)) :=
      Functor.map_mono _ _
    have h3 := (NatTrans.mono_iff_mono_app _).1 h2 (Opposite.op V)
    exact (AddCommGrpCat.mono_iff_injective _).1 h3

  have s1 : ∀ (k : ℕ) {Y : Type u} [TopologicalSpace Y] (f : C(Y, ULift.{u+1} ℤ_[ℓ])),
      ∃ (A : Set Y) (g : C(Y, ULift.{u+1} ℤ_[ℓ])), IsClopen A ∧
        (∀ z, (f z).down = 0 → z ∈ A) ∧ (∀ z, (f z).down = 0 → (g z).down = 0) ∧
        (∀ z ∈ A, (f z).down = (ℓ : ℤ_[ℓ]) ^ k * (g z).down) ∧
        (∀ z, z ∉ A → (g z).down = 0) := by
    intro k Y _ f
    set r : ℝ := (ℓ : ℝ) ^ (-(k : ℤ)) with hr
    have hℓpos : (0 : ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
    have hrpos : 0 < r := zpow_pos hℓpos _
    set B : Set ℤ_[ℓ] := Metric.closedBall 0 r with hB
    have hBc : IsClopen B := IsUltrametricDist.isClopen_closedBall 0 hrpos.ne'
    have hmemB : ∀ x : ℤ_[ℓ], x ∈ B ↔ x ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k} := by
      intro x
      rw [hB, mem_closedBall_zero_iff, hr]
      exact PadicInt.norm_le_pow_iff_mem_span_pow x k
    let D : ℤ_[ℓ] → ℤ_[ℓ] := fun x =>
      if h : x ∈ B then Classical.choose (Ideal.mem_span_singleton'.1 ((hmemB x).1 h)) else 0
    have hDspec : ∀ x ∈ B, D x * (ℓ : ℤ_[ℓ]) ^ k = x := by
      intro x hx
      simp only [D, dif_pos hx]
      exact Classical.choose_spec (Ideal.mem_span_singleton'.1 ((hmemB x).1 hx))
    have hDoff : ∀ x, x ∉ B → D x = 0 := by
      intro x hx
      simp only [D, dif_neg hx]
    have hℓk0 : ((ℓ : ℤ_[ℓ]) ^ k) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    have hnormℓk : ‖((ℓ : ℤ_[ℓ]) ^ k)‖ = ((ℓ : ℝ) ^ k)⁻¹ := by
      rw [PadicInt.norm_p_pow, zpow_neg, zpow_natCast]
    have hLip : LipschitzOnWith ((ℓ : NNReal) ^ k) D B := by
      apply LipschitzOnWith.of_dist_le_mul
      intro x hx y hy
      rw [dist_eq_norm, dist_eq_norm]
      have e : x - y = (D x - D y) * (ℓ : ℤ_[ℓ]) ^ k := by
        rw [sub_mul, hDspec x hx, hDspec y hy]
      have e2 : ‖x - y‖ = ‖D x - D y‖ * ((ℓ : ℝ) ^ k)⁻¹ := by
        rw [e, norm_mul, hnormℓk]
      have hpk : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos hℓpos k
      rw [e2, NNReal.coe_pow, NNReal.coe_natCast]
      rw [mul_comm ‖D x - D y‖, ← mul_assoc, mul_inv_cancel₀ hpk.ne', one_mul]
    have hDcont : Continuous D := by
      rw [continuous_iff_continuousAt]
      intro x
      by_cases hx : x ∈ B
      · exact hLip.continuousOn.continuousAt (hBc.isOpen.mem_nhds hx)
      · have hc : ContinuousOn D Bᶜ :=
          (continuousOn_const (c := (0 : ℤ_[ℓ]))).congr (fun z hz => hDoff z hz)
        exact hc.continuousAt (hBc.compl.isOpen.mem_nhds hx)
    have hD0 : D 0 = 0 := by
      have h0B : (0 : ℤ_[ℓ]) ∈ B := Metric.mem_closedBall_self hrpos.le
      have := hDspec 0 h0B
      exact (mul_eq_zero.mp this).resolve_right hℓk0
    set φ' : Y → ℤ_[ℓ] := fun z => (f z).down with hφ'
    have hφc : Continuous φ' := continuous_uliftDown.comp f.continuous
    refine ⟨φ' ⁻¹' B, ⟨fun z => ULift.up (D (φ' z)),
      continuous_uliftUp.comp (hDcont.comp hφc)⟩, hBc.preimage hφc, ?_, ?_, ?_, ?_⟩
    · intro z hz
      show φ' z ∈ B
      rw [show φ' z = 0 from hz]
      exact Metric.mem_closedBall_self hrpos.le
    · intro z hz
      show D (φ' z) = 0
      rw [show φ' z = 0 from hz, hD0]
    · intro z hz
      show φ' z = (ℓ : ℤ_[ℓ]) ^ k * D (φ' z)
      rw [mul_comm, hDspec _ hz]
    · intro z hz
      exact hDoff _ hz

  have s2 : ∀ (W : S.ProEt) (A : Set W.left), IsClopen A →
      ∃ Sv : Sieve W, Sv ∈ Scheme.ProEt.topology S W ∧
        ∀ (W' : S.ProEt) (e : W' ⟶ W), Sv.arrows e →
          Set.range e.left ⊆ A ∨ Set.range e.left ⊆ Aᶜ := by
    intro W A hA
    let O : ULift.{u+1} W.left → W.left.Opens := fun i =>
      if i.down ∈ A then ⟨A, hA.isOpen⟩ else ⟨Aᶜ, hA.compl.isOpen⟩
    have hOmem : ∀ i : ULift.{u+1} W.left, i.down ∈ O i := by
      intro i
      by_cases hi : i.down ∈ A
      · simp only [O, if_pos hi]; exact hi
      · simp only [O, if_neg hi]; exact hi
    have hOcases : ∀ i : ULift.{u+1} W.left,
        (O i : Set W.left) ⊆ A ∨ (O i : Set W.left) ⊆ Aᶜ := by
      intro i
      by_cases hi : i.down ∈ A
      · left; simp only [O, if_pos hi]; exact fun _ h => h
      · right; simp only [O, if_neg hi]; exact fun _ h => h
    haveI := W.prop
    let W' : ULift.{u+1} W.left → S.ProEt := fun i =>
      Scheme.ProEt.mk ((O i).ι ≫ W.hom)
    let f : ∀ i, W' i ⟶ W := fun i => MorphismProperty.Over.homMk (O i).ι rfl trivial
    have hcov : ∀ x : ↥W.left, ∃ (i : ULift.{u+1} W.left) (y : ↥(O i).toScheme),
        (O i).ι y = x := fun x =>
      ⟨ULift.up x, ⟨x, hOmem (ULift.up x)⟩, Scheme.Opens.ι_apply _ _⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) W.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} W.left)
        (fun i => (O i).toScheme) (fun i => (O i).ι) hcov (fun i => inferInstance)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun i => (Scheme.Hom.isOpenEmbedding (O i).ι).isOpenMap)
    have hRb : Presieve.ofArrows (fun i : ULift.{u+1} W.left => (O i).toScheme)
        (fun i => (O i).ι) ∈ Scheme.proetalePrecoverage.coverings W.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙
      Over.forget S) (Y := W') f
    have hR' : Presieve.ofArrows W' f ∈ (Scheme.ProEt.precoverage S).coverings W :=
      Precoverage.mem_comap_iff.mpr (e ▸ hRb)
    have hRJ : Sieve.generate (Presieve.ofArrows W' f) ∈ (Scheme.ProEt.topology S) W :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine ⟨Sieve.generate (Presieve.ofArrows W' f), hRJ, ?_⟩
    rintro T' _ ⟨Y', h', _, ⟨i⟩, rfl⟩
    have hsub : Set.range (h' ≫ f i).left ⊆ (O i : Set W.left) := by
      rintro _ ⟨z, rfl⟩
      have hr := Scheme.Opens.range_ι (O i)
      change (O i).ι (h'.left z) ∈ (O i : Set W.left)
      rw [← hr]
      exact ⟨_, rfl⟩
    rcases hOcases i with hc | hc
    · exact Or.inl (hsub.trans hc)
    · exact Or.inr (hsub.trans hc)

  have hA : ∀ δ₁ δ₂ : Limits.kernel π ⟶ wcIntTors S ℓ 1,
      (δ₁.val.app (Opposite.op VU)).hom u₀ = (δ₂.val.app (Opposite.op VU)).hom u₀ →
      δ₁ = δ₂ := by
    intro δ₁ δ₂ h
    have hsep := (wcIntTors S ℓ 1).isSheaf.isSeparated
    have hkill : ∀ (δ : Limits.kernel π ⟶ wcIntTors S ℓ 1) (W' : S.ProEt)
        (x : (Limits.kernel π).val.obj (Opposite.op W')),
        (δ.val.app (Opposite.op W')).hom ((ℓ ^ 1 : ℕ) • x) = 0 := by
      intro δ W' x
      have h0 : (ℓ ^ 1 : ℕ) • δ = 0 := by
        rw [← Category.comp_id δ, ← Preadditive.comp_nsmul, hΛ, Limits.comp_zero]
      rw [map_nsmul, ← hnsmul δ (ℓ ^ 1) _ x, h0]
      rfl
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro Xo
    obtain ⟨W⟩ := Xo
    apply ModuleCat.hom_ext
