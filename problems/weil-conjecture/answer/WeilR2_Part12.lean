    have hab := RingHom.ext_zmod (a.comp e) (b.comp e)
    exact congrArg (fun h => h x.down) hab
  have hρ : φX ≫ D'.φ = D.φ ≫
      ((wcEtBaseChange i).sheafPushforwardContinuous RingCat.{u+1} _ _).map φZ := huniq _ _ _
  let eA : (SheafOfModules.restrictScalars.{u+1} φX).obj (wcEtSuppObj D') ≅
      (SheafOfModules.pushforward.{u+1} (φX ≫ D'.φ)).obj
        (SheafOfModules.unit (wcEtZModRing Z n)) :=
    (SheafOfModules.fullyFaithfulForget _).preimageIso (Iso.refl _)
  let eB : (SheafOfModules.pushforward.{u+1} (D.φ ≫
      ((wcEtBaseChange i).sheafPushforwardContinuous RingCat.{u+1} _ _).map φZ)).obj
        (SheafOfModules.unit (wcEtZModRing Z n)) ≅
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
        ((SheafOfModules.restrictScalars.{u+1} φZ).obj (SheafOfModules.unit (wcEtZModRing Z n))) :=
    (SheafOfModules.fullyFaithfulForget _).preimageIso (Iso.refl _)
  exact ⟨eA ≪≫ (SheafOfModules.pushforwardCongr hρ).app _ ≪≫ eB⟩

theorem wc_et_supp_push_restrict_unit_coker_iso : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ), 1 ≤ m → ∀ (D : wcEtPullData i (ℓ ^ m)) (φZ : wcEtZModRing Z (ℓ ^ m) ⟶ wcEtZModRing Z ℓ), Nonempty ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj ((SheafOfModules.restrictScalars.{u+1} φZ).obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≅ Limits.cokernel ((ℓ ^ 1) • 𝟙 (wcEtSuppObj D))) :=
by
  intro X Z i _ ℓ _ m hm D φZ
  have hℓp : ℓ.Prime := Fact.out
  have hdvd : ℓ ∣ ℓ ^ m := dvd_pow_self ℓ (by omega)
  let c : RingCat.of (ULift.{u+1} (ZMod (ℓ ^ m))) ⟶ RingCat.of (ULift.{u+1} (ZMod ℓ)) :=
    RingCat.ofHom ((ULift.ringEquiv.symm.toRingHom).comp ((ZMod.castHom hdvd (ZMod ℓ)).comp
      (ULift.ringEquiv.toRingHom)))
  let φ : wcEtZModRing Z (ℓ ^ m) ⟶ wcEtZModRing Z ℓ :=
    (constantSheaf (Scheme.smallEtaleTopology Z) RingCat.{u+1}).map c

  have huniq : ∀ (S : Sheaf (Scheme.smallEtaleTopology Z) RingCat.{u+1})
      (a b : wcEtZModRing Z (ℓ ^ m) ⟶ S), a = b := by
    intro S a b
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Z) RingCat.{u+1}).homEquiv
      ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) S).injective
    apply NatTrans.ext
    funext W
    apply RingCat.hom_ext
    have key : ∀ f g : ULift.{u+1} (ZMod (ℓ ^ m)) →+* (S.obj.obj W), f = g := by
      intro f g
      have h0 := RingHom.ext_zmod
        (f.comp (ULift.ringEquiv.{0, u+1} (R := ZMod (ℓ ^ m))).symm.toRingHom)
        (g.comp (ULift.ringEquiv.{0, u+1} (R := ZMod (ℓ ^ m))).symm.toRingHom)
      ext x
      exact congrArg (fun k => k x.down) h0
    exact key _ _
  have hφ : φZ = φ := huniq _ _ _
  subst hφ

  let αA : (Functor.const (Z.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod (ℓ ^ m)))) ⟶
      (wcEtZModRing Z (ℓ ^ m)).obj :=
    toSheafify (Scheme.smallEtaleTopology Z)
      ((Functor.const (Z.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod (ℓ ^ m)))))
  let αB : (Functor.const (Z.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))) ⟶
      (wcEtZModRing Z ℓ).obj :=
    toSheafify (Scheme.smallEtaleTopology Z)
      ((Functor.const (Z.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))))
  have hAinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Z) αA :=
    Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Z) _
  have hAsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) αA :=
    Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Z) _
  have hBinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Z) αB :=
    Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Z) _
  have hBsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) αB :=
    Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Z) _
  have hsq : αA ≫ φ.hom = (Functor.const (Z.Etale)ᵒᵖ).map c ≫ αB :=
    (toSheafify_naturality (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).map c)).symm
  have hcsurj : Function.Surjective c.hom := by
    intro b
    haveI : NeZero ℓ := ⟨hℓp.ne_zero⟩
    refine ⟨ULift.up ((b.down.val : ℕ) : ZMod (ℓ ^ m)), ?_⟩
    apply ULift.ext
    show ZMod.castHom hdvd (ZMod ℓ) ((b.down.val : ℕ) : ZMod (ℓ ^ m)) = b.down
    rw [map_natCast, ZMod.natCast_zmod_val]
  have hcker : ∀ a : RingCat.of (ULift.{u+1} (ZMod (ℓ ^ m))), c.hom a = 0 →
      ∃ b : RingCat.of (ULift.{u+1} (ZMod (ℓ ^ m))), a = (ℓ ^ 1) • b := by
    intro a ha
    haveI : NeZero (ℓ ^ m) := ⟨pow_ne_zero _ hℓp.ne_zero⟩
    have h1 : ZMod.castHom hdvd (ZMod ℓ) a.down = 0 := congrArg ULift.down ha
    rw [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.natCast_eq_zero_iff] at h1
    obtain ⟨k, hk⟩ := h1
    refine ⟨ULift.up (k : ZMod (ℓ ^ m)), ?_⟩
    apply ULift.ext
    show a.down = (ℓ ^ 1) • (k : ZMod (ℓ ^ m))
    rw [← ZMod.natCast_zmod_val a.down, hk, pow_one, nsmul_eq_mul, Nat.cast_mul]
  have hsurj := wc_const_sheafify_ringHom_sections_surj (Scheme.smallEtaleTopology Z) _ _ c
    (wcEtZModRing Z (ℓ ^ m)) (wcEtZModRing Z ℓ) αA αB φ hBinj hBsurj hsq hcsurj
  have hker := wc_const_sheafify_ringHom_ker_nsmul (Scheme.smallEtaleTopology Z) _ _ c
    (wcEtZModRing Z (ℓ ^ m)) (wcEtZModRing Z ℓ) αA αB φ (ℓ ^ 1) hAinj hAsurj hBinj hsq hcker
  have hR1 : ∀ V, ((ℓ : ℕ) : ↑((wcEtZModRing Z ℓ).obj.obj V)) = 0 := by
    intro V
    have h0 : ((ℓ : ℕ) : ULift.{u+1} (ZMod ℓ)) = 0 :=
      ULift.ext _ _ (by rw [ULift.down_natCast, ZMod.natCast_self, ULift.zero_down])
    have h1 := map_natCast (αB.app V).hom ℓ
    have h2 : (αB.app V).hom ((ℓ : ℕ) : ULift.{u+1} (ZMod ℓ)) = 0 := by
      rw [h0]; exact map_zero _
    exact h1.symm.trans h2
  have hn1 : ∀ V : (Z.Etale)ᵒᵖ, ((ℓ ^ 1 : ℕ) : (wcEtZModRing Z ℓ).obj.obj V) = 0 := by
    intro V
    rw [pow_one]
    exact hR1 V
  obtain ⟨q, w, ⟨hcolim⟩, -⟩ := sheafOfModules_restrictScalars_unit_cokernel
    (Scheme.smallEtaleTopology Z) (wcEtZModRing Z (ℓ ^ m)) (wcEtZModRing Z ℓ) φ (ℓ ^ 1)
    hsurj hker hn1

  haveI := D.additive
  haveI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) :=
    wc_et_finite_push_modules_exact i (ℓ ^ m) D
  have hG := Limits.CokernelCofork.mapIsColimit (Limits.CokernelCofork.ofπ q w) hcolim
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ)
  have hmap : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).map
      ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (ℓ ^ m)))) =
      (ℓ ^ 1) • 𝟙 (wcEtSuppObj D) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  exact ⟨hG.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _) ≪≫
    Limits.cokernelIsoOfEq hmap⟩

theorem wc_et_supp_obj_pow_exact : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (ℓ m : ℕ), 0 < ℓ → ∀ (D : wcEtPullData i (ℓ ^ m)), (ℓ ^ m) • 𝟙 (wcEtSuppObj D) = 0 ∧ ∀ k : ℕ, 1 ≤ k → k < m → ∀ {W : SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ m))} (z : W ⟶ wcEtSuppObj D), z ≫ ((ℓ ^ k) • 𝟙 (wcEtSuppObj D)) = 0 → ∃ (W' : SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ m))) (π : W' ⟶ W) (_ : Epi π) (t : W' ⟶ wcEtSuppObj D), π ≫ z = t ≫ ((ℓ ^ (m - k)) • 𝟙 (wcEtSuppObj D)) :=
by
  intro X Z i _ ℓ m hℓ D
  haveI := D.additive
  haveI hPadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
      D.cont D.φ).Additive :=
    Adjunction.right_adjoint_additive D.adj
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) := by
    haveI := D.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI : IsFinite i := inferInstance
  haveI : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) :=
    wc_et_finite_push_modules_exact i (ℓ ^ m) D
  obtain ⟨P1, P2⟩ := wc_et_zmod_unit_pow_exact Z ℓ m hℓ
  have hmap : ∀ j : ℕ, (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
      D.cont D.φ).map (j • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (ℓ ^ m)))) =
        j • 𝟙 (wcEtSuppObj D) := by
    intro j
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  refine ⟨?_, ?_⟩
  · rw [← hmap, P1, Functor.map_zero]
    first | rfl | simp | (unfold wcEtSuppObj; rfl)
  · intro k hk1 hkm W z hz
    have h : ((ℓ ^ (m - k)) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (ℓ ^ m)))) ≫
        ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (ℓ ^ m)))) = 0 := by
      rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add,
        Nat.add_sub_cancel' hkm.le, P1]
    let T := ShortComplex.mk _ _ h
    have hT : T.Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      exact P2 k hk1 hkm x₂ hx₂
    have hT' : (T.map (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
        D.cont D.φ)).Exact := hT.map _
    have hz' : (z : W ⟶ (T.map (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcEtBaseChange i) _ _ D.cont D.φ)).X₂) ≫ (T.map (@SheafOfModules.pushforward.{u+1}
          _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ)).g = 0 := by
      show z ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
        D.cont D.φ).map ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (ℓ ^ m)))) = 0
      rw [hmap]
      exact hz
    obtain ⟨W', π, hπ, x₁, hx⟩ := hT'.exact_up_to_refinements _ hz'
    refine ⟨W', π, hπ, x₁, ?_⟩
    refine hx.trans ?_
    show x₁ ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _
        D.cont D.φ).map ((ℓ ^ (m - k)) • 𝟙 (SheafOfModules.unit (wcEtZModRing Z (ℓ ^ m)))) = _
    rw [hmap]
    rfl

theorem wc_et_supp_semipurity_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (D : wcEtPullData i (ℓ ^ k)) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0 :=
by
  intro K _ _ X Z fX n c _ i _ _ hc ℓ _ hℓ k hk D q hq θ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ k))) := HasExt.standard _
  have hℓp : ℓ.Prime := Fact.out
  have hdvd : ℓ ∣ ℓ ^ k := dvd_pow_self ℓ (by omega)

  let cR : RingCat.of (ULift.{u+1} (ZMod (ℓ ^ k))) ⟶ RingCat.of (ULift.{u+1} (ZMod ℓ)) :=
    RingCat.ofHom ((ULift.ringEquiv.symm.toRingHom).comp ((ZMod.castHom hdvd (ZMod ℓ)).comp
      (ULift.ringEquiv.toRingHom)))
  let φX : wcEtZModRing X (ℓ ^ k) ⟶ wcEtZModRing X ℓ :=
    (constantSheaf (Scheme.smallEtaleTopology X) RingCat.{u+1}).map cR
  let φZ : wcEtZModRing Z (ℓ ^ k) ⟶ wcEtZModRing Z ℓ :=
    (constantSheaf (Scheme.smallEtaleTopology Z) RingCat.{u+1}).map cR
  obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists i ℓ

  obtain ⟨h0, hpe⟩ := wc_et_supp_obj_pow_exact i ℓ k hℓp.pos D

  have base : ∀ x : Abelian.Ext (Limits.cokernel ((ℓ ^ 1) • 𝟙 (wcEtSuppObj D)))
      (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q, x = 0 := by
    intro x
    let e : (SheafOfModules.restrictScalars.{u+1} φX).obj (wcEtSuppObj D₁) ≅
        Limits.cokernel ((ℓ ^ 1) • 𝟙 (wcEtSuppObj D)) :=
      (wc_et_supp_obj_restrictScalars_iso i (ℓ ^ k) ℓ D D₁ φX φZ).some ≪≫
        (wc_et_supp_push_restrict_unit_coker_iso i ℓ k hk D φZ).some
    obtain ⟨E⟩ := wc_et_zmod_restrict_ext_equiv_gen X ℓ k hk φX (wcEtSuppObj D₁) q
    have h1 := wc_et_supp_semipurity K X Z fX n c i hc ℓ hℓ D₁ q hq
    have hy : (Abelian.Ext.mk₀ e.hom).comp x (zero_add q) = 0 := by
      apply E.injective
      exact (h1 _).trans (h1 _).symm
    calc x = (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp x (zero_add q))
          (zero_add q) := by
          rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e.inv) (Abelian.Ext.mk₀ e.hom) x
            (zero_add 0) (zero_add q) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
            Abelian.Ext.mk₀_id_comp]
      _ = 0 := by rw [hy, Abelian.Ext.comp_zero]

  have step : ∀ j : ℕ, 1 ≤ j → j ≤ k → ∀ x : Abelian.Ext
      (Limits.cokernel ((ℓ ^ j) • 𝟙 (wcEtSuppObj D)))
      (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q, x = 0 := by
    intro j hj
    induction j, hj using Nat.le_induction with
    | base => intro _ x; exact base x
    | succ j hj ih =>
      intro hjk x₂
      obtain ⟨f, g, w, hS⟩ := wc_coker_pow_ses (wcEtSuppObj D) ℓ k h0 hpe j hj (by omega)
      have h1 : (Abelian.Ext.mk₀ f).comp x₂ (zero_add q) = 0 := base _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) x₂ h1
      rw [← hx₁, ih (by omega) x₁, Abelian.Ext.comp_zero]

  have hfin := step k hk le_rfl
  let e' : Limits.cokernel ((ℓ ^ k) • 𝟙 (wcEtSuppObj D)) ≅ wcEtSuppObj D :=
    Limits.cokernelIsoOfEq h0 ≪≫ Limits.cokernelZeroIsoTarget
  have hz : (Abelian.Ext.mk₀ e'.hom).comp θ (zero_add q) = 0 := hfin _
  calc θ = (Abelian.Ext.mk₀ e'.inv).comp ((Abelian.Ext.mk₀ e'.hom).comp θ (zero_add q))
        (zero_add q) := by
        rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e'.inv) (Abelian.Ext.mk₀ e'.hom) θ
          (zero_add 0) (zero_add q) (by omega), Abelian.Ext.mk₀_comp_mk₀, e'.inv_hom_id,
          Abelian.Ext.mk₀_id_comp]
    _ = 0 := by rw [hz, Abelian.Ext.comp_zero]

theorem wc_et_affine_origin_supp_ext_exact_order_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (c : ℕ) (D0 : wcEtPullData (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (ℓ ^ k)), ∃ ω : wcEtSuppExt D0 (2 * c), ℓ ^ (k - 1) • ω ≠ 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ k hk
  have hp : ℓ.Prime := Fact.out
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  intro c D0
  simp only [Nat.add_sub_cancel]

  obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv K c 0
  obtain ⟨φ, hφ⟩ := wc_pp_chart_iso K c 0 e he
  let ψ : AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ⟶ wcProjK K c :=
    φ.inv ≫ (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (c + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X (0 : Fin (c + 1)))).ι
  haveI hψo : IsOpenImmersion ψ := by dsimp only [ψ]; infer_instance
  haveI hψe : Etale ψ := inferInstance
  haveI hψm : Mono ψ := inferInstance
  have hψ : ψ ≫ wcProjKStr K c = AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) := by
    dsimp only [ψ]
    rw [Category.assoc]
    erw [hφ]
    rw [Iso.inv_hom_id_assoc]
  let z := AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
  let x₀ : Spec (.of K) ⟶ wcProjK K c := z ≫ ψ
  have hx₀ : x₀ ≫ wcProjKStr K c = 𝟙 _ := by
    dsimp only [x₀]
    rw [Category.assoc, hψ]
    exact AffineSpace.homOfVector_over _ _
  haveI := wc_proj_space_isProper K c
  haveI : IsClosedImmersion (x₀ ≫ wcProjKStr K c) := by rw [hx₀]; infer_instance
  haveI hx₀ci : IsClosedImmersion x₀ := IsClosedImmersion.of_comp x₀ (wcProjKStr K c)
  have hsq : IsPullback (𝟙 (Spec (.of K))) z x₀ ψ := by
    have h1 : IsPullback (𝟙 (Spec (.of K))) z z (𝟙 _) := IsPullback.of_id_fst
    have h2 : IsPullback (𝟙 _) (𝟙 _) ψ ψ := (mono_iff_isPullback ψ).mp inferInstance
    have h3 := h1.paste_vert h2
    rw [Category.comp_id] at h3
    exact h3

  obtain ⟨Dx⟩ := wc_et_zmod_pull_data_exists x₀ (ℓ ^ (j + 1))
  obtain ⟨Eψ⟩ := wc_et_zmod_pull_data_exists ψ (ℓ ^ (j + 1))
  obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change x₀ ψ z (𝟙 _) hsq Dx Eψ D0
  have hinj := wc_et_supp_restr_etale_excision_injective ψ x₀ z (𝟙 _) hsq inferInstance
    Dx Eψ D0 γ hγ (2 * c)

  have hPnz : ∃ v : wcEtSuppExt Dx (2 * c), ℓ ^ j • v ≠ 0 := by
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (wcProjK K c) (ℓ ^ (j + 1)))) :=
      HasExt.standard _
    haveI := wc_proj_space_smooth K c
    haveI := wc_proj_space_irreducible K c
    obtain ⟨g, hg⟩ := wc_et_zmodext_top_exact_order K (wcProjK K c) (wcProjKStr K c) c ℓ hℓ
      (j + 1) (by omega)
    rw [Nat.add_sub_cancel] at hg
    have hcl : IsClosed (Set.range x₀) := x₀.isClosedEmbedding.isClosed_range
    obtain ⟨U, hU⟩ : ∃ U : (wcProjK K c).Opens,
        (U : Set (wcProjK K c)) = (Set.range x₀)ᶜ :=
      ⟨⟨(Set.range x₀)ᶜ, hcl.isOpen_compl⟩, rfl⟩
    have hepi : Epi (wcEtSuppUnitMap Dx) := wc_et_supp_unit_epi x₀ Dx
    obtain ⟨iso⟩ := wc_et_supp_unit_ker_extZero_iso x₀ (ℓ ^ (j + 1)) Dx
    rw [← hU] at iso
    obtain ⟨eU⟩ := wc_et_extzero_module_ext_open_coh (wcProjK K c) U (ℓ ^ (j + 1))
      (pow_pos hp.pos _) (Limits.kernel (wcEtSuppUnitMap Dx)) ⟨iso⟩ (2 * c)
    have h1 : Subsingleton (wcEtCoh U ℓ (2 * c)) :=
      wc_et_proj_punctured_top_vanishing K c ℓ hp hℓ x₀ hx₀ U hU
    have h2 : Subsingleton (wcEtCoh U (ℓ ^ (j + 1)) (2 * c)) :=
      wc_et_coh_zmod_prime_pow_of_prime U ℓ hp (2 * c) h1 j
    haveI := h2
    haveI := eU.subsingleton
    have hzero : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap Dx))).comp g
        (zero_add _) = 0 := Subsingleton.elim _ _
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap Dx)) (wcEtSuppUnitMap Dx)
        (Limits.kernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS _ g hzero
    refine ⟨x₃, ?_⟩
    intro h0
    apply hg
    have hadd : ∀ n : ℕ, (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp (n • x₃) (zero_add _) =
        n • (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp x₃ (zero_add _) := by
      intro n
      induction n with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.comp_zero]
      | succ n ih => rw [succ_nsmul, Abelian.Ext.comp_add, ih, succ_nsmul]
    rw [← hx₃]
    show ℓ ^ j • (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp x₃ (zero_add _) = 0
    rw [← hadd, h0, Abelian.Ext.comp_zero]
  obtain ⟨v, hv⟩ := hPnz
  refine ⟨wcEtSuppRestr Dx Eψ D0 γ (2 * c) v, fun h => hv (hinj ?_)⟩
  rw [map_nsmul, h, map_zero]

theorem wc_et_affine_bundle_zero_supp_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) [IsAffine B] [IrreducibleSpace B] [Smooth qB] (b : Spec (.of K) ⟶ B), b ≫ qB = 𝟙 _ → ∀ (c : ℕ) (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) ℓ), Finite (wcEtSuppExt DB (2 * c)) ∧ Nat.card (wcEtSuppExt DB (2 * c)) ≤ ℓ :=
by
  intro K _ _ ℓ _ hℓ B qB _ _ _ b hb c DB
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hzs : IsClosedImmersion
      (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) := by
    have h1 : AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) B ↘ B) = 𝟙 B := AffineSpace.homOfVector_over _ _
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)
  haveI := hzs
  rcases Nat.eq_zero_or_pos c with hc | hc
  · subst hc
    exact wc_et_affine_bundle_zero_supp_card_le_rank_zero B ℓ hℓpos.ne' DB
  · let U : (AffineSpace (ULift.{u} (Fin c)) B).Opens :=
      ⟨(Set.range (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))))ᶜ,
        (IsClosedImmersion.isClosedEmbedding _).isClosed_range.isOpen_compl⟩
    have hU : (U : Set (AffineSpace (ULift.{u} (Fin c)) B)) =
        (Set.range (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))))ᶜ := rfl
    obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists U.ι ℓ
    have h2c : 2 * c = (2 * c - 1) + 1 := by omega
    have hinj := wc_et_affine_bundle_punct_restr_injective K ℓ hℓ B qB c hc U hU Dj
      ((2 * c - 1) + 1)
    have hT := wc_et_affine_bundle_punct_coker_card K ℓ hℓ B qB b hb c hc U hU Dj
    have hres := wc_et_supp_card_of_restr
      (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) U.ι
      (by rw [Scheme.Opens.range_ι]; exact hU) ℓ hℓpos DB Dj (2 * c - 1) ℓ hinj hT
    rw [h2c]
    exact hres

theorem wc_et_supp_ext_card_pow_of_prime : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ), 1 ≤ k → ∀ (q M : ℕ), (∀ D₁ : wcEtPullData i ℓ, Finite (wcEtSuppExt D₁ q) ∧ Nat.card (wcEtSuppExt D₁ q) ≤ M) → ∀ (D : wcEtPullData i (ℓ ^ k)), Finite (wcEtSuppExt D q) ∧ Nat.card (wcEtSuppExt D q) ≤ M ^ k :=
by
  classical
  intro X Z i _ ℓ _ k hk q M hM D
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ k))) := HasExt.standard _
  have hℓp : ℓ.Prime := Fact.out
  have hdvd : ℓ ∣ ℓ ^ k := dvd_pow_self ℓ (by omega)
  let cR : RingCat.of (ULift.{u+1} (ZMod (ℓ ^ k))) ⟶ RingCat.of (ULift.{u+1} (ZMod ℓ)) :=
    RingCat.ofHom ((ULift.ringEquiv.symm.toRingHom).comp ((ZMod.castHom hdvd (ZMod ℓ)).comp
      (ULift.ringEquiv.toRingHom)))
  let φX : wcEtZModRing X (ℓ ^ k) ⟶ wcEtZModRing X ℓ :=
    (constantSheaf (Scheme.smallEtaleTopology X) RingCat.{u+1}).map cR
  let φZ : wcEtZModRing Z (ℓ ^ k) ⟶ wcEtZModRing Z ℓ :=
    (constantSheaf (Scheme.smallEtaleTopology Z) RingCat.{u+1}).map cR
  obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists i ℓ
  obtain ⟨h0, hpe⟩ := wc_et_supp_obj_pow_exact i ℓ k hℓp.pos D

  have transport : ∀ {P P' : SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ k))} (_ : P ≅ P'),
      Nonempty (Abelian.Ext P' (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q ≃
        Abelian.Ext P (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) := by
    intro P P' e
    exact ⟨{ toFun := fun x => (Abelian.Ext.mk₀ e.hom).comp x (zero_add q)
             invFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add q)
             left_inv := fun x => by
               show (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp x (zero_add q))
                 (zero_add q) = x
               rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e.inv) (Abelian.Ext.mk₀ e.hom) x
                 (zero_add 0) (zero_add q) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
                 Abelian.Ext.mk₀_id_comp]
             right_inv := fun y => by
               show (Abelian.Ext.mk₀ e.hom).comp ((Abelian.Ext.mk₀ e.inv).comp y (zero_add q))
                 (zero_add q) = y
               rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ e.hom) (Abelian.Ext.mk₀ e.inv) y
                 (zero_add 0) (zero_add q) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
                 Abelian.Ext.mk₀_id_comp] }⟩

  have s2 : ∀ (S : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing X (ℓ ^ k)))), S.ShortExact →
      ∀ (a b : ℕ),
      (Finite (Abelian.Ext S.X₁ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ∧
        Nat.card (Abelian.Ext S.X₁ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ≤ a) →
      (Finite (Abelian.Ext S.X₃ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ∧
        Nat.card (Abelian.Ext S.X₃ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ≤ b) →
      Finite (Abelian.Ext S.X₂ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ∧
        Nat.card (Abelian.Ext S.X₂ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ≤ b * a := by
    intro S hS a b h1 h3
    obtain ⟨hf1, hc1⟩ := h1
    obtain ⟨hf3, hc3⟩ := h3
    let F : Abelian.Ext S.X₂ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q →
        Abelian.Ext S.X₁ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q :=
      fun x => (Abelian.Ext.mk₀ S.f).comp x (zero_add q)
    let G : Abelian.Ext S.X₃ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q →
        Abelian.Ext S.X₂ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q :=
      fun y => (Abelian.Ext.mk₀ S.g).comp y (zero_add q)
    have hFsub : ∀ x x', F (x - x') = F x - F x' := by
      intro x x'
      show (Abelian.Ext.mk₀ S.f).comp (x - x') (zero_add q) =
        (Abelian.Ext.mk₀ S.f).comp x (zero_add q) - (Abelian.Ext.mk₀ S.f).comp x' (zero_add q)
      rw [eq_sub_iff_add_eq, ← Abelian.Ext.comp_add, sub_add_cancel]
    let Φ : Abelian.Ext S.X₃ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q × Set.range F →
        Abelian.Ext S.X₂ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q :=
      fun p => G p.1 + Classical.choose p.2.2
    have hΦ : Function.Surjective Φ := by
      intro x
      have hx : F x ∈ Set.range F := ⟨x, rfl⟩
      have hFx' : F (Classical.choose hx) = F x := Classical.choose_spec hx
      have hz : F (x - Classical.choose hx) = 0 := by rw [hFsub, hFx', sub_self]
      obtain ⟨y, hy⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) (x - Classical.choose hx) hz
      refine ⟨(y, ⟨F x, hx⟩), ?_⟩
      have hGy : G y = x - Classical.choose hx := hy
      show G y + Classical.choose hx = x
      rw [hGy, sub_add_cancel]
    haveI := hf1
    haveI := hf3
    haveI : Finite (Set.range F) := Subtype.finite
    haveI : Finite (Abelian.Ext S.X₃ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q ×
      Set.range F) := inferInstance
    haveI hf2 : Finite (Abelian.Ext S.X₂ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) :=
      Finite.of_surjective Φ hΦ
    refine ⟨hf2, ?_⟩
    calc Nat.card (Abelian.Ext S.X₂ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q)
        ≤ Nat.card (Abelian.Ext S.X₃ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q ×
            Set.range F) := Nat.card_le_card_of_surjective Φ hΦ
      _ = Nat.card (Abelian.Ext S.X₃ (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) *
            Nat.card (Set.range F) := Nat.card_prod _ _
      _ ≤ b * a := Nat.mul_le_mul hc3
            ((Nat.card_le_card_of_injective Subtype.val Subtype.val_injective).trans hc1)

  have hbase : Finite (Abelian.Ext (Limits.cokernel ((ℓ ^ 1) • 𝟙 (wcEtSuppObj D)))
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ∧
      Nat.card (Abelian.Ext (Limits.cokernel ((ℓ ^ 1) • 𝟙 (wcEtSuppObj D)))
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ≤ M := by
    let e : (SheafOfModules.restrictScalars.{u+1} φX).obj (wcEtSuppObj D₁) ≅
        Limits.cokernel ((ℓ ^ 1) • 𝟙 (wcEtSuppObj D)) :=
      (wc_et_supp_obj_restrictScalars_iso i (ℓ ^ k) ℓ D D₁ φX φZ).some ≪≫
        (wc_et_supp_push_restrict_unit_coker_iso i ℓ k hk D φZ).some
    obtain ⟨E⟩ := wc_et_zmod_restrict_ext_equiv_gen X ℓ k hk φX (wcEtSuppObj D₁) q
    obtain ⟨T⟩ := transport e
    obtain ⟨hf, hc⟩ := hM D₁
    have E' : Abelian.Ext (Limits.cokernel ((ℓ ^ 1) • 𝟙 (wcEtSuppObj D)))
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q ≃ wcEtSuppExt D₁ q := T.trans E
    haveI := hf
    refine ⟨Finite.of_equiv _ E'.symm, ?_⟩
    exact (Nat.card_congr E').trans_le hc

  have step : ∀ j : ℕ, 1 ≤ j → j ≤ k →
      Finite (Abelian.Ext (Limits.cokernel ((ℓ ^ j) • 𝟙 (wcEtSuppObj D)))
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ∧
      Nat.card (Abelian.Ext (Limits.cokernel ((ℓ ^ j) • 𝟙 (wcEtSuppObj D)))
        (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q) ≤ M ^ j := by
    intro j hj
    induction j, hj using Nat.le_induction with
    | base => intro _; exact ⟨hbase.1, hbase.2.trans (pow_one M).symm.le⟩
    | succ j hj ih =>
      intro hjk
      obtain ⟨f, g, w, hS⟩ := wc_coker_pow_ses (wcEtSuppObj D) ℓ k h0 hpe j hj (by omega)
      have key := s2 (ShortComplex.mk f g w) hS M (M ^ j) hbase (ih (by omega))
      exact ⟨key.1, key.2.trans (pow_succ M j).symm.le⟩

  obtain ⟨hfk, hck⟩ := step k hk le_rfl
  let e' : Limits.cokernel ((ℓ ^ k) • 𝟙 (wcEtSuppObj D)) ≅ wcEtSuppObj D :=
    Limits.cokernelIsoOfEq h0 ≪≫ Limits.cokernelZeroIsoTarget
  obtain ⟨T'⟩ := transport e'
  have E'' : wcEtSuppExt D q ≃ Abelian.Ext (Limits.cokernel ((ℓ ^ k) • 𝟙 (wcEtSuppObj D)))
      (SheafOfModules.unit (wcEtZModRing X (ℓ ^ k))) q := T'
  haveI := hfk
  exact ⟨Finite.of_equiv _ E''.symm, (Nat.card_congr E'').trans_le hck⟩

theorem wc_et_affine_bundle_slice_injective_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) (b : Spec (.of K) ⟶ B), b ≫ qB = 𝟙 _ → ∀ (c : ℕ) (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) (ℓ ^ k)) (Dσ : wcEtPullData (AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ b) (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j)) (ℓ ^ k)) (DK : wcEtPullData (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (ℓ ^ k)) (γ : wcEtSuppObj DK ⟶ Dσ.Φ.obj (wcEtSuppObj DB)), wcEtSuppUnitMap DK ≫ γ = Dσ.μ.inv ≫ Dσ.Φ.map (wcEtSuppUnitMap DB) → (Finite (wcEtSuppExt DB (2 * c)) ∧ Nat.card (wcEtSuppExt DB (2 * c)) ≤ ℓ ^ k) → (∃ ω : wcEtSuppExt DK (2 * c), ℓ ^ (k - 1) • ω ≠ 0) → Function.Injective (wcEtSuppRestr DB Dσ DK γ (2 * c)) :=
by
  classical
  intro K _ _ ℓ _ hℓ k hk B qB b hb c DB Dσ DK γ hγ hcard hω'
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hzs : ∀ (S : Scheme.{u}),
      IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤))) := by
    intro S
    have h1 : AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S) = 𝟙 S := AffineSpace.homOfVector_over _ _
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)
  haveI := hzs B
  haveI := hzs (Spec (.of K))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) :=
    HasExt.standard _
  have e1 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)),
      ConcreteCategory.hom (f ≫ g).appTop x =
        ConcreteCategory.hom f.appTop (ConcreteCategory.hom g.appTop x) := by
    intro X Y Z f g x
    rw [Scheme.Hom.comp_appTop]
    rfl
  have e2 : ∀ {X : Scheme.{u}} (x : Γ(X, ⊤)), ConcreteCategory.hom (𝟙 X : X ⟶ X).appTop x = x := by
    intro X x
    simp

  have hsq : IsPullback qB (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)))
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
      (AffineSpace.map (ULift.{u} (Fin c)) qB) := by
    have hcomm : qB ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K)))
          (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)) =
        AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫
          AffineSpace.map (ULift.{u} (Fin c)) qB := by
      apply AffineSpace.hom_ext
      · rw [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id, Category.assoc,
          AffineSpace.map_over, ← Category.assoc, AffineSpace.homOfVector_over, Category.id_comp]
      · intro i
        simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
          Pi.zero_apply, map_zero]
    have hcoord : ∀ (s : Limits.PullbackCone (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
          (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (AffineSpace.map (ULift.{u} (Fin c)) qB)),
        (s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) ≫
          AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) = s.snd := by
      intro s
      apply AffineSpace.hom_ext
      · rw [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
      · intro i
        have h1 := congrArg (fun φ => ConcreteCategory.hom (Scheme.Hom.appTop φ)
          (AffineSpace.coord (Spec (.of K)) i)) s.condition
        simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
          Pi.zero_apply, map_zero] at h1 ⊢
        first
          | exact h1
          | exact h1.symm
    refine IsPullback.mk ⟨hcomm⟩
      ⟨Limits.PullbackCone.IsLimit.mk hcomm
        (fun s => s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) ?_ ?_ ?_⟩
    · intro s
      show (s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) ≫ qB = s.fst
      rw [Category.assoc, ← AffineSpace.map_over, ← Category.assoc, ← s.condition,
        Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
    · intro s
      exact hcoord s
    · intro s m _ hm2
      show m = s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)
      rw [← hm2, Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]

  have hσpr : AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ b)
      (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j) ≫
        AffineSpace.map (ULift.{u} (Fin c)) qB = 𝟙 _ := by
    apply AffineSpace.hom_ext
    · rw [Category.assoc, AffineSpace.map_over, ← Category.assoc, AffineSpace.homOfVector_over,
        Category.assoc, hb, Category.comp_id, Category.id_comp]
    · intro i
      rw [e1, AffineSpace.map_appTop_coord, AffineSpace.homOfVector_appTop_coord, e2]

  obtain ⟨ω, hω⟩ := hω'
  obtain ⟨Epr⟩ := wc_et_zmod_pull_data_exists (AffineSpace.map (ULift.{u} (Fin c)) qB) (ℓ ^ k)
  obtain ⟨Eid⟩ := wc_et_zmod_pull_data_exists
    (𝟙 (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)))) (ℓ ^ k)
  obtain ⟨γpr, hγpr, -⟩ := wc_et_closed_supp_base_change _ (AffineSpace.map (ULift.{u} (Fin c)) qB)
    _ qB hsq DK Epr DB
  obtain ⟨γid, hγid, hepK⟩ := wc_et_closed_supp_base_change _ _ _ _
    (IsPullback.id_horiz (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))) DK Eid DK
  have hcomp : ∀ θ, wcEtSuppRestr DK Eid DK γid (2 * c) θ =
      wcEtSuppRestr DB Dσ DK γ (2 * c) (wcEtSuppRestr DK Epr DB γpr (2 * c) θ) :=
    wc_et_supp_restr_comp (AffineSpace.map (ULift.{u} (Fin c)) qB) _ _ hσpr DK DB DK
      Epr Dσ Eid γpr γ γid hγpr hγ hγid hepK (2 * c)
  have hinjid := wc_et_supp_restr_etale_excision_injective (𝟙 _) _ _ (𝟙 _)
    (IsPullback.id_horiz (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))) inferInstance DK Eid DK γid hγid (2 * c)
  set R := wcEtSuppRestr DB Dσ DK γ (2 * c) with hR
  set t := wcEtSuppRestr DK Epr DB γpr (2 * c) ω with ht
  have hA : ¬ ℓ ^ (k - 1) • R t = 0 := by
    intro h0
    apply hω
    apply hinjid
    rw [hcomp, map_nsmul, map_nsmul, h0, map_zero]

  have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit
        (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))) =
      m • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit
        (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))) :
        Abelian.Ext
          (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))
          (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) 0) := by
    intro m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have hzero : (ℓ ^ k) • 𝟙 (SheafOfModules.unit
      (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) = 0 :=
    (wc_et_zmod_unit_pow_exact (AffineSpace (ULift.{u} (Fin c)) B) ℓ k hℓpos).1
  have htor : ∀ e : wcEtSuppExt DB (2 * c), (ℓ ^ k) • e = 0 := by
    intro e
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k))) :=
      HasExt.standard _
    have hlin := map_nsmul (Abelian.Ext.bilinearComp (wcEtSuppObj DB)
      (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))
      (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))
      (2 * c) 0 (2 * c) (add_zero _) e) (ℓ ^ k)
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit
        (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) (ℓ ^ k)))))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [← hlin, ← hmk, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have hkk : k - 1 + 1 = k := Nat.sub_add_cancel hk
  have ht1 : ¬ ℓ ^ (k - 1) • t = 0 := by
    intro h0
    apply hA
    rw [← map_nsmul, h0, map_zero]
  have ht2 : ℓ ^ (k - 1 + 1) • t = 0 := by
    rw [hkk]; exact htor t
  have hRt2 : ℓ ^ (k - 1 + 1) • R t = 0 := by
    rw [← map_nsmul, ht2, map_zero]
  have hordt : addOrderOf t = ℓ ^ (k - 1 + 1) := addOrderOf_eq_prime_pow ht1 ht2
  have hordR : addOrderOf (R t) = ℓ ^ (k - 1 + 1) := addOrderOf_eq_prime_pow hA hRt2

  obtain ⟨hfin, hle⟩ := hcard
  haveI := hfin
  have htop : AddSubgroup.zmultiples t = ⊤ :=
    AddSubgroup.eq_top_of_le_card _ (by rw [Nat.card_zmultiples, hordt, hkk]; exact hle)

  refine (injective_iff_map_eq_zero _).mpr ?_
  intro x hx
  have hmem : x ∈ AddSubgroup.zmultiples t := by
    rw [htop]; exact AddSubgroup.mem_top _
  obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
  have hmR : m • R t = 0 := by
    rw [← map_zsmul, hm, hx]
  have hd : ((addOrderOf (R t) : ℕ) : ℤ) ∣ m := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hmR
  rw [hordR, ← hordt] at hd
  rw [← hm]
  exact addOrderOf_dvd_iff_zsmul_eq_zero.mp hd

theorem wc_et_kummer_local_thom_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (k : ℕ), 1 ≤ k → ∃ T : wcEtLocThom K (ℓ ^ k), wcEtThomGL T ∧ wcEtThomNat T ∧ ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W) (D : wcEtPullData i (ℓ ^ k)) (c : ℕ) (h : Fin c → Γ(W, ⊤)), SmoothOfRelativeDimension c fW → SmoothOfRelativeDimension 0 (i ≫ fW) → wcEtCutOut i h → Nonempty Z → ℓ ^ (k - 1) • T fW i D c h ≠ 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ k hk

  have hzs : ∀ (S : Scheme.{u}) (c : ℕ),
      IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤))) := by
    intro S c
    have h1 : AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S) = 𝟙 S := AffineSpace.homOfVector_over _ _
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)

  obtain ⟨D0, ω, hω⟩ : ∃ (D0 : ∀ c : ℕ, wcEtPullData (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (ℓ ^ k)) (ω : ∀ c, wcEtSuppExt (D0 c) (2 * c)),
      ∀ c, ℓ ^ (k - 1) • ω c ≠ 0 :=
    ⟨fun c => Classical.choice (wc_et_zmod_pull_data_exists _ (ℓ ^ k)),
      fun c => Classical.choose (wc_et_affine_origin_supp_ext_exact_order_pow K ℓ hℓ k hk c _),
      fun c => Classical.choose_spec (wc_et_affine_origin_supp_ext_exact_order_pow K ℓ hℓ k hk c _)⟩

  obtain ⟨T, hT⟩ : ∃ T : wcEtLocThom K (ℓ ^ k), ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K))
      (i : Z ⟶ W) (D : wcEtPullData i (ℓ ^ k)) (c : ℕ) (h : Fin c → Γ(W, ⊤)), wcEtCutOut i h →
      ∃ (E : wcEtPullData (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) (ℓ ^ k))
        (γ : wcEtSuppObj D ⟶ E.Φ.obj (wcEtSuppObj (D0 c))),
        wcEtSuppUnitMap D ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap (D0 c)) ∧
        Epi (wcEtSuppUnitMap D) ∧ T fW i D c h = wcEtSuppRestr (D0 c) E D γ (2 * c) (ω c) := by
    refine ⟨fun {W Z} fW i D c h => if hc : wcEtCutOut i h then
      wcEtSuppRestr (D0 c) (Classical.choice (wc_et_zmod_pull_data_exists
          (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) (ℓ ^ k))) D
        (Classical.choose (@wc_et_closed_supp_base_change _ _ _ _ _ _ (hzs _ c)
          (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) i (i ≫ fW)
          (wc_et_zero_section_cutout_pullback K fW i h hc) (D0 c)
          (Classical.choice (wc_et_zmod_pull_data_exists
            (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) (ℓ ^ k))) D))
        (2 * c) (ω c) else 0, ?_⟩
    intro W Z fW i D c h hc
    have hs := Classical.choose_spec (@wc_et_closed_supp_base_change _ _ _ _ _ _ (hzs _ c)
          (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) i (i ≫ fW)
          (wc_et_zero_section_cutout_pullback K fW i h hc) (D0 c)
          (Classical.choice (wc_et_zmod_pull_data_exists
            (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) (ℓ ^ k))) D)
    refine ⟨_, _, hs.1, hs.2, ?_⟩
    exact dif_pos hc

  have hle : ∀ {R : Type u} [CommRing R] {c : ℕ} (B : Matrix (Fin c) (Fin c) R) (v : Fin c → R),
      Ideal.span (Set.range (B.mulVec v)) ≤ Ideal.span (Set.range v) := by
    intro R _ c B v
    rw [Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    simp only [Matrix.mulVec, dotProduct]
    exact Ideal.sum_mem _ (fun b _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨b, rfl⟩))
  refine ⟨T, ?_, ?_, ?_⟩
  ·
    intro W Z fW i D c h A hA hgood
    obtain ⟨n, _, _, _, hc⟩ := hgood
    have hspan : Ideal.span (Set.range (A.mulVec h)) = Ideal.span (Set.range h) := by
      apply le_antisymm (hle A h)
      have hh : h = A⁻¹.mulVec (A.mulVec h) := by
        rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul A hA, Matrix.one_mulVec]
      calc Ideal.span (Set.range h) = Ideal.span (Set.range (A⁻¹.mulVec (A.mulVec h))) := by
            rw [← hh]
        _ ≤ _ := hle _ _
    have hc' : wcEtCutOut i (A.mulVec h) := ⟨hc.1, hc.2.1, hc.2.2.trans hspan.symm⟩
    obtain ⟨G, qG, e, act, pr, hGa, hGi, hGs, he, hact, hpr, hσa, hσp, hσ, huniv⟩ :=
      wc_gl_universal_chart K c
    obtain ⟨ψ, gψ, hψa, hψp, hψ⟩ := huniv fW i h A hA hc
    obtain ⟨E1, γ1, hγ1, hep, hT1⟩ := hT fW i D c _ hc'
    obtain ⟨E2, γ2, hγ2, -, hT2⟩ := hT fW i D c h hc
    change T fW i D c (A.mulVec h) = T fW i D c h
    rw [hT1, hT2]
    haveI := hzs (Spec (.of K)) c
    haveI := hzs G c
    haveI := hc.2.1
    obtain ⟨DG⟩ := wc_et_zmod_pull_data_exists
      (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤))) (ℓ ^ k)
    obtain ⟨Eψ⟩ := wc_et_zmod_pull_data_exists ψ (ℓ ^ k)
    obtain ⟨Eact⟩ := wc_et_zmod_pull_data_exists act (ℓ ^ k)
    obtain ⟨Epr⟩ := wc_et_zmod_pull_data_exists pr (ℓ ^ k)
    obtain ⟨γψ, hγψ, -⟩ := wc_et_closed_supp_base_change _ ψ i gψ hψ DG Eψ D
    obtain ⟨γa, hγa, -⟩ := wc_et_closed_supp_base_change _ act _ qG hact (D0 c) Eact DG
    obtain ⟨γp, hγp, -⟩ := wc_et_closed_supp_base_change _ pr _ qG hpr (D0 c) Epr DG
    rw [wc_et_supp_restr_comp act ψ _ hψa (D0 c) DG D Eact Eψ E1 γa γψ γ1 hγa hγψ hγ1 hep
        (2 * c) (ω c),
      wc_et_supp_restr_comp pr ψ _ hψp (D0 c) DG D Epr Eψ E2 γp γψ γ2 hγp hγψ hγ2 hep
        (2 * c) (ω c)]
    refine congrArg (wcEtSuppRestr DG Eψ D γψ (2 * c)) ?_
    obtain ⟨Eσ⟩ := wc_et_zmod_pull_data_exists
      (AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ e)
        (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j)) (ℓ ^ k)
    obtain ⟨Eid⟩ := wc_et_zmod_pull_data_exists
      (𝟙 (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)))) (ℓ ^ k)
    obtain ⟨γσ, hγσ, hepK⟩ := wc_et_closed_supp_base_change _ _ _ e hσ DG Eσ (D0 c)
    obtain ⟨γid, hγid, -⟩ := wc_et_closed_supp_base_change _ _ _ _
      (IsPullback.id_horiz (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
        (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))) (D0 c) Eid (D0 c)
    have h1 := wc_et_supp_restr_comp act _ _ hσa (D0 c) DG (D0 c) Eact Eσ Eid γa γσ γid hγa hγσ hγid
      hepK (2 * c) (ω c)
    have h2 := wc_et_supp_restr_comp pr _ _ hσp (D0 c) DG (D0 c) Epr Eσ Eid γp γσ γid hγp hγσ hγid
      hepK (2 * c) (ω c)
    haveI := hGa
    haveI := hGi
    haveI := hGs
    have hcardG := wc_et_supp_ext_card_pow_of_prime
      (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤))) ℓ k hk (2 * c) ℓ
      (fun D₁ => wc_et_affine_bundle_zero_supp_card_le K ℓ hℓ G qG e he c D₁) DG
    exact wc_et_affine_bundle_slice_injective_pow K ℓ hℓ k hk G qG e he c DG Eσ (D0 c) γσ hγσ
      hcardG ⟨ω c, hω c⟩ (h1.symm.trans h2)
  ·
    intro W Z W' Z' fW fW' f hf i i' g hsq D Df D' γ hγ c h hgood hgood'
    obtain ⟨n, _, _, _, hc⟩ := hgood
    obtain ⟨n', _, _, _, hc'⟩ := hgood'
    obtain ⟨E, γ1, hγ1, -, hT1⟩ := hT fW i D c h hc
    obtain ⟨E', γ12, hγ12, hep', hT2⟩ := hT fW' i' D' c _ hc'
    change wcEtSuppRestr D Df D' γ (2 * c) (T fW i D c h) =
      T fW' i' D' c (fun j => f.appTop.hom (h j))
    rw [hT1, hT2]
    have hcomp : f ≫ AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down) =
        AffineSpace.homOfVector fW' (fun j : ULift.{u} (Fin c) => f.appTop.hom (h j.down)) := by
      rw [AffineSpace.comp_homOfVector, hf]
      rfl
    exact (wc_et_supp_restr_comp _ f _ hcomp (D0 c) D D' E Df E' γ1 γ γ12 hγ1 hγ hγ12 hep'
      (2 * c) (ω c)).symm
  ·
    intro W Z fW i D c h hsm hsm0 hc hne hzero
    obtain ⟨z⟩ := hne
    obtain ⟨V, -, het, hiso⟩ := wc_smooth_cutout_point_etale_nbhd K fW i c h hsm hsm0 hc z
    obtain ⟨E, γ1, hγ1, -, hT1⟩ := hT fW i D c h hc
    haveI := hc.2.1
    haveI := hzs (Spec (.of K)) c
    have sq1 : IsPullback (i ⁻¹ᵁ V).ι (i ∣_ V) i V.ι := (isPullback_morphismRestrict i V).flip
    have sq3 := sq1.paste_horiz (wc_et_zero_section_cutout_pullback K fW i h hc)
    obtain ⟨D2⟩ := wc_et_zmod_pull_data_exists (i ∣_ V) (ℓ ^ k)
    obtain ⟨EV⟩ := wc_et_zmod_pull_data_exists V.ι (ℓ ^ k)
    obtain ⟨EVφ⟩ := wc_et_zmod_pull_data_exists
      (V.ι ≫ AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) (ℓ ^ k)
    obtain ⟨γ2, hγ2, hep2⟩ := wc_et_closed_supp_base_change i V.ι (i ∣_ V) (i ⁻¹ᵁ V).ι sq1 D EV D2
    obtain ⟨γ12, hγ12, -⟩ := wc_et_closed_supp_base_change _ _ (i ∣_ V) _ sq3 (D0 c) EVφ D2
    have hcomp := wc_et_supp_restr_comp
      (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) V.ι _ rfl
      (D0 c) D D2 E EV EVφ γ1 γ2 γ12 hγ1 hγ2 hγ12 hep2 (2 * c) (ω c)
    have hzero' : ℓ ^ (k - 1) • T fW i D c h = 0 := hzero
    have hkey : wcEtSuppRestr (D0 c) EVφ D2 γ12 (2 * c) (ℓ ^ (k - 1) • ω c) = 0 := by
      rw [map_nsmul, hcomp, ← hT1, ← map_nsmul (wcEtSuppRestr D EV D2 γ2 (2 * c)), hzero',
        map_zero]
    haveI := het
    have hinj := wc_et_supp_restr_etale_excision_injective
      (V.ι ≫ AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down))
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
      (i ∣_ V) _ sq3 hiso (D0 c) EVφ D2 γ12 hγ12 (2 * c)
    exact hω c (hinj (hkey.trans (map_zero _).symm))

theorem wc_et_thom_open_restrict_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ) (T : wcEtLocThom K N), wcEtThomNat T → ∀ {X Z X' Z' : Scheme.{u}} (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (f : X' ⟶ X) [IsOpenImmersion f] (i' : Z' ⟶ X') (g : Z' ⟶ Z), IsPullback g i' i f → ∀ (D : wcEtPullData i N) (Df : wcEtPullData f N) (D' : wcEtPullData i' N) (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) → ∀ θ : wcEtSuppExt D (2 * c), wcEtIsThom T fX D c θ → wcEtIsThom T (f ≫ fX) D' c (wcEtSuppRestr D Df D' γ (2 * c) θ) :=
by
  classical
  intro K _ _ N T hNat X Z X' Z' fX n c _ i _ _ hcn f _ i' g hsq2 D Df D' γ hγ θ hθ
  unfold wcEtIsThom at hθ ⊢
  unfold wcEtThomNat at hNat
  intro W'' ZW iW gW hsq1 DW EW γ'' adm'' h cut

  haveI : IsClosedImmersion iW := cut.2.1
  haveI hWaff : IsAffine (W'' : Scheme.{u}) := cut.1
  obtain ⟨W₁, e, he⟩ : ∃ (W₁ : X.Opens) (e : (W'' : Scheme.{u}) ≅ (W₁ : Scheme.{u})),
      e.hom ≫ W₁.ι = W''.ι ≫ f :=
    ⟨f ''ᵁ W'', f.isoImage W'', Scheme.Hom.isoImage_hom_ι f W''⟩
  haveI : IsAffine (W₁ : Scheme.{u}) := IsAffine.of_isIso e.inv
  haveI : IsOpenImmersion gW :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq1.flip inferInstance
  haveI : IsOpenImmersion g :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq2.flip inferInstance

  have SF : IsPullback (gW ≫ g) iW i (W''.ι ≫ f) := hsq1.paste_horiz hsq2
  have S1 : IsPullback (gW ≫ g) (iW ≫ e.hom) i W₁.ι :=
    SF.of_iso (Iso.refl _) (Iso.refl _) e (Iso.refl _)
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Category.id_comp])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Category.comp_id, he])
  have Se : IsPullback (𝟙 ZW) iW (iW ≫ e.hom) e.hom :=
    IsPullback.of_horiz_isIso ⟨Category.id_comp _⟩
  have Sinv : IsPullback (𝟙 ZW) (iW ≫ e.hom) iW e.inv :=
    IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]⟩

  have hmor : iW ≫ W''.ι ≫ f ≫ fX = (gW ≫ g) ≫ i ≫ fX := by
    calc iW ≫ W''.ι ≫ f ≫ fX = (iW ≫ W''.ι ≫ f) ≫ fX := by simp only [Category.assoc]
      _ = ((gW ≫ g) ≫ i) ≫ fX := by rw [SF.w]
      _ = (gW ≫ g) ≫ i ≫ fX := Category.assoc _ _ _
  have hmor₁ : (iW ≫ e.hom) ≫ W₁.ι ≫ fX = (gW ≫ g) ≫ i ≫ fX := by
    rw [Category.assoc, ← Category.assoc e.hom, he]
    simpa only [Category.assoc] using hmor
  have hcomm : e.hom ≫ W₁.ι ≫ fX = W''.ι ≫ f ≫ fX := by
    rw [← Category.assoc, he, Category.assoc]

  have sm0 : ∀ {A B : Scheme.{u}} (j : A ⟶ B) [IsOpenImmersion j] (m : ℕ)
      (q : B ⟶ Spec (.of K)) [SmoothOfRelativeDimension m q],
      SmoothOfRelativeDimension m (j ≫ q) := by
    intro A B j _ m q _
    have h0 : SmoothOfRelativeDimension (0 + m) (j ≫ q) := inferInstance
    rwa [zero_add] at h0

  have cut₁ : wcEtCutOut (iW ≫ e.hom) (fun k => e.inv.appTop.hom (h k)) :=
    wc_et_cutout_base_change iW h e.inv (iW ≫ e.hom) (𝟙 ZW) cut inferInstance Sinv
  have hid : e.inv.appTop ≫ e.hom.appTop = 𝟙 _ := by
    rw [← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
  have hh : (fun j => e.hom.appTop.hom (e.inv.appTop.hom (h j))) = h := by
    funext j
    exact congrArg (fun φ => φ.hom (h j)) hid

  obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists (iW ≫ e.hom) N
  obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists W₁.ι N
  obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists e.hom N
  obtain ⟨EF⟩ := wc_et_zmod_pull_data_exists (W''.ι ≫ f) N
  obtain ⟨γF, admF, epiW⟩ :=
    wc_et_closed_supp_base_change i (W''.ι ≫ f) iW (gW ≫ g) SF D EF DW
  obtain ⟨γ₁, adm₁, -⟩ :=
    wc_et_closed_supp_base_change i W₁.ι (iW ≫ e.hom) (gW ≫ g) S1 D E₁ D₁
  obtain ⟨γe, adme, -⟩ :=
    wc_et_closed_supp_base_change (iW ≫ e.hom) e.hom iW (𝟙 ZW) Se D₁ Ee DW

  have R1 := wc_et_supp_restr_comp f W''.ι (W''.ι ≫ f) rfl D D' DW Df EW EF γ γ'' γF
    hγ adm'' admF epiW (2 * c) θ
  have R2 := wc_et_supp_restr_comp W₁.ι e.hom (W''.ι ≫ f) he D D₁ DW E₁ Ee EF γ₁ γe γF
    adm₁ adme admF epiW (2 * c) θ

  have R3 := hθ W₁ ZW (iW ≫ e.hom) (gW ≫ g) S1 D₁ E₁ γ₁ adm₁ _ cut₁

  have chart1 : wcEtGoodChart K (W₁.ι ≫ fX) (iW ≫ e.hom) c
      (fun k => e.inv.appTop.hom (h k)) := by
    refine ⟨n, hcn, sm0 W₁.ι n fX, ?_, cut₁⟩
    rw [hmor₁]
    exact sm0 (gW ≫ g) (n - c) (i ≫ fX)
  have chart2 : wcEtGoodChart K (W''.ι ≫ (f ≫ fX)) iW c
      (fun j => e.hom.appTop.hom (e.inv.appTop.hom (h j))) := by
    haveI : SmoothOfRelativeDimension n (f ≫ fX) := sm0 f n fX
    refine ⟨n, hcn, sm0 W''.ι n (f ≫ fX), ?_, ?_⟩
    · rw [hmor]
      exact sm0 (gW ≫ g) (n - c) (i ≫ fX)
    · rw [hh]
      exact cut
  have R4 := hNat (W₁.ι ≫ fX) (W''.ι ≫ (f ≫ fX)) e.hom hcomm (iW ≫ e.hom) iW (𝟙 ZW) Se
    D₁ Ee DW γe adme c (fun k => e.inv.appTop.hom (h k)) chart1 chart2
  exact R1.symm.trans (R2.trans ((congrArg (wcEtSuppRestr D₁ Ee DW γe (2 * c)) R3).trans
    (R4.trans (congrArg (T (W''.ι ≫ (f ≫ fX)) iW DW c) hh))))

theorem wc_et_thom_class_unique_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ), (∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0) → ∀ (T : wcEtLocThom K N) (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] [CompactSpace ↥X] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N) (θ₁ θ₂ : wcEtSuppExt D (2 * c)), wcEtIsThom T fX D c θ₁ → wcEtIsThom T fX D c θ₂ → θ₁ = θ₂ :=
by
  classical
  intro K _ _ N hsp T X Z fX n c _ _ i _ _ hcn D θ₁ θ₂ h₁ h₂
  rw [← sub_eq_zero]
  have hO1 : ∀ {V : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j],
      SmoothOfRelativeDimension n (j ≫ fX) := by
    intro V j _
    have h0 : SmoothOfRelativeDimension (0 + n) (j ≫ fX) := inferInstance
    rwa [zero_add] at h0
  have hO2 : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
    intro V ZV j _ iV gV hsq
    haveI : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    have h0 : SmoothOfRelativeDimension (0 + (n - c)) (gV ≫ i ≫ fX) := inferInstance
    rw [zero_add] at h0
    have e : iV ≫ j ≫ fX = gV ≫ i ≫ fX := by
      rw [← Category.assoc, ← hsq.w, Category.assoc]
    rw [e]
    exact h0
  have hvan : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → ∀ (DV : wcEtPullData iV N) (q' : ℕ), q' + 1 = 2 * c →
        ∀ t : wcEtSuppExt DV q', t = 0 := by
    intro V ZV j _ iV gV hsq DV q' hq' t
    haveI := hO1 j
    haveI : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    haveI := hO2 j iV gV hsq
    exact hsp V ZV (j ≫ fX) n c iV hcn DV q' (by omega) t
  have hloc : ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W ∧
      ((∃ h : Fin c → Γ(↑W, ⊤), wcEtCutOut (i ∣_ W) h) ∨ ((W : Set X) ⊆ (Set.range i)ᶜ)) := by
    intro x
    by_cases hx : x ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hx
      obtain ⟨W, hWa, hzW, h, hcut⟩ := wc_smooth_pair_local_cutout K X Z fX n c i hcn z
      exact ⟨W, hWa, hzW, Or.inl ⟨h, hcut⟩⟩
    · have hopen : IsOpen (Set.range i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
      obtain ⟨W, hWa, hxW, hWsub⟩ :=
        exists_isAffineOpen_mem_and_subset (U := ⟨(Set.range i)ᶜ, hopen⟩) (x := x) hx
      exact ⟨W, hWa, hxW, Or.inr (show (W : Set X) ⊆ (Set.range i)ᶜ from hWsub)⟩
  choose W hWa hxW hGood using hloc
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
    (fun x => (W x).isOpen.mem_nhds (hxW x))
  have hcov : ∀ x : X, ∃ k : Fin t.card, x ∈ Set.range (W (t.equivFin.symm k).1).ι := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (W y : Set X) := by
      rw [ht]
      exact Set.mem_univ x
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
    rw [Scheme.Opens.range_ι, Equiv.symm_apply_apply]
    exact hxy
  refine wc_et_supp_finite_cover_injective i D (2 * c) hvan t.card
    (fun k => ((W (t.equivFin.symm k).1 : X.Opens) : Scheme.{u}))
    (fun k => (W (t.equivFin.symm k).1).ι) hcov (θ₁ - θ₂) ?_
  intro k Zk ik gk hsq Dk Ek γ hγ
  rw [map_sub, sub_eq_zero]
  rcases hGood (t.equivFin.symm k).1 with ⟨h, hcut⟩ | hsub
  · have can := (isPullback_morphismRestrict i (W (t.equivFin.symm k).1)).flip
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ, κ ≫ (i ⁻¹ᵁ (W (t.equivFin.symm k).1)).ι = gk ∧
        κ ≫ (i ∣_ (W (t.equivFin.symm k).1)) = ik :=
      ⟨can.lift gk ik hsq.w, can.lift_fst _ _ _, can.lift_snd _ _ _⟩
    have sq : IsPullback κ ik (i ∣_ (W (t.equivFin.symm k).1)) (𝟙 _) := by
      refine IsPullback.of_right ?_ ?_ can
      · rw [hκ1, Category.id_comp]
        exact hsq
      · rw [hκ2, Category.comp_id]
    have hcut' := wc_et_cutout_base_change (i ∣_ (W (t.equivFin.symm k).1)) h (𝟙 _) ik κ hcut
      (hWa _) sq
    rw [h₁ _ Zk ik gk hsq Dk Ek γ hγ _ hcut', h₂ _ Zk ik gk hsq Dk Ek γ hγ _ hcut']
  · haveI hE : IsEmpty Zk := by
      apply Scheme.isEmpty_of_commSq hsq.toCommSq
      rw [Scheme.Opens.range_ι]
      exact Set.subset_compl_iff_disjoint_left.mp hsub
    haveI := wc_et_supp_ext_empty ik N Dk hE (2 * c)
    exact Subsingleton.elim _ _

theorem wc_et_thom_chart_class_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ), (∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0) → ∀ (T : wcEtLocThom K N), wcEtThomGL T → wcEtThomNat T → ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW] (i : Z ⟶ W) [SmoothOfRelativeDimension (n - c) (i ≫ fW)], c ≤ n → ∀ (D : wcEtPullData i N) (h : Fin c → Γ(W, ⊤)), wcEtCutOut i h → wcEtIsThom T fW D c (T fW i D c h) :=
by
  classical
  intro K _ _ N hsp T hGL hNat W Z fW n c _ i _ hcn D h hcut
  haveI : IsAffine W := hcut.1
  haveI : IsClosedImmersion i := hcut.2.1

  have hsm0 : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) [IsOpenImmersion ψ] (φ : B ⟶ C) (k : ℕ)
      [SmoothOfRelativeDimension k φ], SmoothOfRelativeDimension k (ψ ≫ φ) := by
    intro A B C ψ _ φ k _
    have := smoothOfRelativeDimension_comp 0 k ψ φ
    rwa [Nat.zero_add] at this

  have G2 : ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX]
      [CompactSpace ↥X] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)],
      c ≤ n → ∀ (D : wcEtPullData i N) (θ : wcEtSuppExt D (2 * c)), (∀ z : Z, ∃ (V : Scheme.{u})
      (j : V ⟶ X), IsOpenImmersion j ∧ i z ∈ Set.range j ∧ ∀ (ZV : Scheme.{u}) (iV : ZV ⟶ V)
      (gV : ZV ⟶ Z), IsPullback gV iV i j → ∀ (DV : wcEtPullData iV N) (Ej : wcEtPullData j N)
      (γ : wcEtSuppObj DV ⟶ Ej.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DV ≫ γ =
      Ej.μ.inv ≫ Ej.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ej DV γ (2 * c) θ = 0) → θ = 0 := by
    intro X Z fX n c _ _ i _ _ hcn D θ hloc
    have hdeg : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
        IsPullback gV iV i j → ∀ (DV : wcEtPullData iV N) (q' : ℕ), q' + 1 = 2 * c →
        ∀ t : wcEtSuppExt DV q', t = 0 := by
      intro V ZV j _ iV gV hV DV q' hq' t
      haveI : IsClosedImmersion iV :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
      haveI : IsOpenImmersion gV :=
        MorphismProperty.of_isPullback (P := @IsOpenImmersion) hV.flip inferInstance
      haveI : SmoothOfRelativeDimension n (j ≫ fX) := hsm0 j fX n
      haveI : SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
        have e : gV ≫ i ≫ fX = iV ≫ j ≫ fX := by rw [reassoc_of% hV.w]
        rw [← e]
        exact hsm0 gV (i ≫ fX) (n - c)
      exact hsp V ZV (j ≫ fX) n c iV hcn DV q' (by omega) t
    have hlift : ∀ {P Q ZW₀ Z₀ W₀ X₀ : Scheme.{u}} {gW₀ : ZW₀ ⟶ Z₀} {iW₀ : ZW₀ ⟶ W₀}
        {i₀ : Z₀ ⟶ X₀} {ι₀ : W₀ ⟶ X₀}, IsPullback gW₀ iW₀ i₀ ι₀ → ∀ {a : P ⟶ Z₀} {b : P ⟶ Q}
        {k : Q ⟶ X₀}, IsPullback a b i₀ k → ∀ (φ : Q ⟶ W₀), φ ≫ ι₀ = k →
        ∃ a' : P ⟶ ZW₀, IsPullback a' b iW₀ φ := by
      intro P Q ZW₀ Z₀ W₀ X₀ gW₀ iW₀ i₀ ι₀ hR a b k hO φ hφ
      refine ⟨hR.lift a (b ≫ φ) (by rw [hO.w, Category.assoc, hφ]), ?_⟩
      refine IsPullback.of_right ?_ (hR.lift_snd _ _ _) hR
      rw [hR.lift_fst, hφ]
      exact hO
    have hvanO : ∀ x : X, ∃ O : X.Opens, x ∈ O ∧ ∀ (ZU : Scheme.{u}) (iU : ZU ⟶ (O : Scheme.{u}))
        (gU : ZU ⟶ Z), IsPullback gU iU i O.ι → ∀ (DU : wcEtPullData iU N) (EU : wcEtPullData O.ι N)
        (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)),
        wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) →
        wcEtSuppRestr D EU DU γ (2 * c) θ = 0 := by
      intro x
      by_cases hx : x ∈ Set.range i
      · obtain ⟨z, rfl⟩ := hx
        obtain ⟨V, j, hj, hz, H⟩ := hloc z
        haveI := hj
        refine ⟨j.opensRange, ?_, ?_⟩
        · rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
          exact hz
        · intro ZU iU gU hO DU EU γ hγ
          have hrange : Set.range j.opensRange.ι ⊆ Set.range j := by
            intro y hy
            rwa [Scheme.Opens.range_ι, Scheme.Hom.coe_opensRange] at hy
          obtain ⟨e, he⟩ : ∃ e : (j.opensRange : Scheme.{u}) ⟶ V, e ≫ j = j.opensRange.ι :=
            ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
          have hV := IsPullback.of_hasPullback i j
          haveI : IsClosedImmersion (Limits.pullback.snd i j) :=
            MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
          obtain ⟨g₂, h₂⟩ := hlift hV hO e he
          obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i j) N
          obtain ⟨Ej⟩ := wc_et_zmod_pull_data_exists j N
          obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists e N
          obtain ⟨γj, hγj, -⟩ := wc_et_closed_supp_base_change i j _ _ hV D Ej DV
          obtain ⟨γe, hγe, hepi⟩ := wc_et_closed_supp_base_change _ e iU g₂ h₂ DV Ee DU
          rw [wc_et_supp_restr_comp j e j.opensRange.ι he D DV DU Ej Ee EU γj γe γ hγj hγe hγ hepi
            (2 * c) θ, H _ _ _ hV DV Ej γj hγj, map_zero]
      · refine ⟨⟨(Set.range i)ᶜ, isOpen_compl_iff.mpr i.isClosedEmbedding.isClosed_range⟩, hx, ?_⟩
        intro ZU iU gU hO DU EU γ hγ
        haveI : IsEmpty ZU := Scheme.isEmpty_of_commSq hO.toCommSq (by
          rw [Scheme.Opens.range_ι]
          exact disjoint_compl_right)
        haveI := wc_et_supp_ext_empty iU N DU inferInstance (2 * c)
        exact Subsingleton.elim _ _
    choose O hxO hO using hvanO
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (O x : Set X))
      (fun x => (O x).isOpen.mem_nhds (hxO x))
    refine wc_et_supp_opens_cover_injective i D (2 * c) hdeg t.card
      (fun k => O (t.equivFin.symm k).1) ?_ θ ?_
    · intro y
      have hy : y ∈ ⋃ x ∈ t, (O x : Set X) := by
        rw [ht]
        trivial
      obtain ⟨x, hxt, hyx⟩ := Set.mem_iUnion₂.mp hy
      refine ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
      show y ∈ O (t.equivFin.symm (t.equivFin ⟨x, hxt⟩)).1
      rw [Equiv.symm_apply_apply]
      exact hyx
    · intro k
      exact hO _
  have gcW : wcEtGoodChart K fW i c h := ⟨n, hcn, ‹_›, ‹_›, hcut⟩

  intro W'' ZW'' iW'' gW'' hsq'' DW'' EW'' γ'' hadm'' h'' hcut''
  haveI hW''aff : IsAffine (W'' : Scheme.{u}) := hcut''.1
  haveI : IsClosedImmersion iW'' := hcut''.2.1
  haveI : IsOpenImmersion gW'' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq''.flip inferInstance
  haveI S1 : SmoothOfRelativeDimension n (W''.ι ≫ fW) := hsm0 W''.ι fW n
  haveI S2 : SmoothOfRelativeDimension (n - c) (iW'' ≫ W''.ι ≫ fW) := by
    have e : gW'' ≫ i ≫ fW = iW'' ≫ W''.ι ≫ fW := by rw [reassoc_of% hsq''.w]
    rw [← e]
    exact hsm0 gW'' (i ≫ fW) (n - c)
  have hsmV : ∀ {V ZV : Scheme.{u}} (ψ : V ⟶ (W'' : Scheme.{u})) [IsOpenImmersion ψ]
      (a : ZV ⟶ ZW'') (b : ZV ⟶ V), IsPullback a b iW'' ψ →
      SmoothOfRelativeDimension (n - c) (b ≫ ψ ≫ W''.ι ≫ fW) := by
    intro V ZV ψ _ a b hab
    haveI : IsOpenImmersion a :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hab.flip inferInstance
    have e : a ≫ iW'' ≫ W''.ι ≫ fW = b ≫ ψ ≫ W''.ι ≫ fW := by rw [reassoc_of% hab.w]
    rw [← e]
    exact hsm0 a (iW'' ≫ W''.ι ≫ fW) (n - c)
  have gcW'' : wcEtGoodChart K (W''.ι ≫ fW) iW'' c h'' := ⟨n, hcn, S1, S2, hcut''⟩

  have hcutA : wcEtCutOut iW'' (fun k => W''.ι.appTop.hom (h k)) :=
    wc_et_cutout_base_change i h W''.ι iW'' gW'' hcut hW''aff hsq''
  have gcA : wcEtGoodChart K (W''.ι ≫ fW) iW'' c (fun k => W''.ι.appTop.hom (h k)) :=
    ⟨n, hcn, S1, S2, hcutA⟩

  rw [← sub_eq_zero]
  refine G2 _ _ (W''.ι ≫ fW) n c iW'' hcn DW'' _ ?_
  intro z''

  obtain ⟨V, jV, hjV, hVaff, hmemV, B, hB, hrel⟩ :=
    wc_smooth_pair_tuples_locally_GL K (W''.ι ≫ fW) iW'' c _ _ gcA hcut'' z''
  haveI := hjV
  haveI := hVaff
  refine ⟨V, jV, hjV, hmemV, ?_⟩

  intro ZV iV gV hV DV Ej γj hadmj
  rw [map_sub, sub_eq_zero]
  have Q := hV.paste_horiz hsq''
  obtain ⟨Ec⟩ := wc_et_zmod_pull_data_exists (jV ≫ W''.ι) N
  obtain ⟨γc, hγc, hepi⟩ := wc_et_closed_supp_base_change i (jV ≫ W''.ι) iV (gV ≫ gW'') Q D Ec DV
  have hca : (fun k => (jV ≫ W''.ι).appTop.hom (h k)) =
      fun k => jV.appTop.hom (W''.ι.appTop.hom (h k)) := by
    funext k
    rw [Scheme.Hom.comp_appTop]
    rfl
  have hcutV1 : wcEtCutOut iV (fun k => jV.appTop.hom (h'' k)) :=
    wc_et_cutout_base_change iW'' h'' jV iV gV hcut'' hVaff hV
  have hcutV2 : wcEtCutOut iV (fun k => (jV ≫ W''.ι).appTop.hom (h k)) :=
    wc_et_cutout_base_change i h (jV ≫ W''.ι) iV (gV ≫ gW'') hcut hVaff Q
  have SV1 : SmoothOfRelativeDimension n (jV ≫ W''.ι ≫ fW) := hsm0 jV (W''.ι ≫ fW) n
  have SV2 : SmoothOfRelativeDimension (n - c) (iV ≫ jV ≫ W''.ι ≫ fW) := hsmV jV gV iV hV
  have gcV1 : wcEtGoodChart K (jV ≫ W''.ι ≫ fW) iV c (fun k => jV.appTop.hom (h'' k)) :=
    ⟨n, hcn, SV1, SV2, hcutV1⟩
  have gcV2 : wcEtGoodChart K (jV ≫ W''.ι ≫ fW) iV c
      (fun k => (jV ≫ W''.ι).appTop.hom (h k)) := ⟨n, hcn, SV1, SV2, hcutV2⟩
  have L6 := wc_et_supp_restr_comp W''.ι jV (jV ≫ W''.ι) rfl D DW'' DV EW'' Ej Ec γ'' γj γc
    hadm'' hadmj hγc hepi (2 * c) (T fW i D c h)
  have NA := hNat fW (jV ≫ W''.ι ≫ fW) (jV ≫ W''.ι) (Category.assoc _ _ _) i iV (gV ≫ gW'') Q
    D Ec DV γc hγc c h gcW gcV2
  have NB := hNat (W''.ι ≫ fW) (jV ≫ W''.ι ≫ fW) jV rfl iW'' iV gV hV DW'' Ej DV γj hadmj c h''
    gcW'' gcV1
  have key : (fun k => jV.appTop.hom (h'' k)) =
      B.mulVec (fun k => (jV ≫ W''.ι).appTop.hom (h k)) :=
    hrel.trans (congrArg B.mulVec hca.symm)
  rw [← L6, NA, NB]
  exact (hGL _ iV DV c _ B hB gcV2).symm.trans
    (congrArg (T (jV ≫ W''.ι ≫ fW) iV DV c) key.symm)

theorem wc_et_thom_local_of_cover_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ), (∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0) → ∀ (T : wcEtLocThom K N), wcEtThomGL T → wcEtThomNat T → ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] [IsSeparated fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N) (M : ℕ) (U : Fin M → X.Opens), (∀ k, IsAffineOpen (U k)) → (∀ x : X, ∃ k, x ∈ U k) → ∀ (DU : ∀ k, wcEtPullData (i ∣_ U k) N) (θ : wcEtSuppExt D (2 * c)), (∀ (k : Fin M) (E : wcEtPullData (U k).ι N) (γ : wcEtSuppObj (DU k) ⟶ E.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap (DU k) ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) → wcEtIsThom T ((U k).ι ≫ fX) (DU k) c (wcEtSuppRestr D E (DU k) γ (2 * c) θ)) → wcEtIsThom T fX D c θ :=
by
  classical
  intro K _ _ N hsp T hGL hNat X Z fX n c _ _ i _ _ hcn D M U hUa hcov DU θ hH

  have hO1 : ∀ {V : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j],
      SmoothOfRelativeDimension n (j ≫ fX) := by
    intro V j _
    have h0 : SmoothOfRelativeDimension (0 + n) (j ≫ fX) := inferInstance
    rwa [zero_add] at h0

  have hO2 : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
    intro V ZV j _ iV gV hsq
    haveI : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    have h0 : SmoothOfRelativeDimension (0 + (n - c)) (gV ≫ i ≫ fX) := inferInstance
    rw [zero_add] at h0
    have e : iV ≫ j ≫ fX = gV ≫ i ≫ fX := by
      rw [← Category.assoc, ← hsq.w, Category.assoc]
    rw [e]
    exact h0
  haveI hqs : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated fX

  intro W ZW iW gW hW DW EW γ hγ h hcut
  haveI : IsClosedImmersion iW := hcut.2.1
  haveI := hO1 W.ι
  haveI := hO2 W.ι iW gW hW

  have hτ : wcEtIsThom T (W.ι ≫ fX) DW c (T (W.ι ≫ fX) iW DW c h) :=
    wc_et_thom_chart_class_gen K N hsp T hGL hNat (W.ι ≫ fX) n c iW hcn DW h hcut

  have hkey : ∀ (k : Fin M) (ZP : Scheme.{u})
      (iP : ZP ⟶ ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u})) (gP : ZP ⟶ ZW),
      IsPullback gP iP iW (W.ι ⁻¹ᵁ U k).ι → ∀ (DP : wcEtPullData iP N)
      (EP : wcEtPullData (W.ι ⁻¹ᵁ U k).ι N) (γP : wcEtSuppObj DP ⟶ EP.Φ.obj (wcEtSuppObj DW)),
      wcEtSuppUnitMap DP ≫ γP = EP.μ.inv ≫ EP.Φ.map (wcEtSuppUnitMap DW) →
      wcEtSuppRestr DW EP DP γP (2 * c) (wcEtSuppRestr D EW DW γ (2 * c) θ) =
        wcEtSuppRestr DW EP DP γP (2 * c) (T (W.ι ≫ fX) iW DW c h) := by
    intro k ZP iP gP hP DP EP γP hγP
    haveI : IsClosedImmersion iP :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP inferInstance
    have hO : IsPullback (gP ≫ gW) iP i ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) := hP.paste_horiz hW

    have hrange : Set.range ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) ⊆ Set.range (U k).ι := by
      rintro _ ⟨y, rfl⟩
      rw [Scheme.Opens.range_ι]
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]
      exact y.2
    obtain ⟨m, hmo, hm⟩ : ∃ m : ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u}) ⟶
        (U k : Scheme.{u}), IsOpenImmersion m ∧ m ≫ (U k).ι = (W.ι ⁻¹ᵁ U k).ι ≫ W.ι :=
      ⟨IsOpenImmersion.lift (U k).ι _ hrange, inferInstance, IsOpenImmersion.lift_fac _ _ _⟩
    haveI := hmo
    have R := (isPullback_morphismRestrict i (U k)).flip
    have hw : (gP ≫ gW) ≫ i = (iP ≫ m) ≫ (U k).ι := by
      rw [hO.w, Category.assoc, hm]
    obtain ⟨g'', hg1, hg2⟩ : ∃ g'' : ZP ⟶ ((i ⁻¹ᵁ U k : Z.Opens) : Scheme.{u}),
        g'' ≫ (i ⁻¹ᵁ U k).ι = gP ≫ gW ∧ g'' ≫ (i ∣_ U k) = iP ≫ m :=
      ⟨R.lift _ _ hw, R.lift_fst _ _ _, R.lift_snd _ _ _⟩
    have hk' : IsPullback g'' iP (i ∣_ U k) m := by
      refine IsPullback.of_right ?_ hg2 R
      rw [hg1, hm]
      exact hO

    obtain ⟨Es⟩ := wc_et_zmod_pull_data_exists ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) N
    obtain ⟨γs, hγs, _⟩ :=
      wc_et_closed_supp_base_change i ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) iP (gP ≫ gW) hO D Es DP
    obtain ⟨EU⟩ := wc_et_zmod_pull_data_exists (U k).ι N
    obtain ⟨γU, hγU, _⟩ :=
      wc_et_closed_supp_base_change i (U k).ι (i ∣_ U k) (i ⁻¹ᵁ U k).ι R D EU (DU k)
    obtain ⟨Fk⟩ := wc_et_zmod_pull_data_exists m N
    obtain ⟨γ', hγ', _⟩ := wc_et_closed_supp_base_change (i ∣_ U k) m iP g'' hk' (DU k) Fk DP
    have hepi : Epi (wcEtSuppUnitMap DP) := wc_et_supp_unit_epi iP DP

    have e1 := wc_et_supp_restr_comp W.ι (W.ι ⁻¹ᵁ U k).ι ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) rfl
      D DW DP EW EP Es γ γP γs hγ hγP hγs hepi (2 * c) θ
    have e2 := wc_et_supp_restr_comp (U k).ι m ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) hm
      D (DU k) DP EU Fk Es γU γ' γs hγU hγ' hγs hepi (2 * c) θ

    haveI := hO1 (U k).ι
    haveI := hO2 (U k).ι (i ∣_ U k) (i ⁻¹ᵁ U k).ι R
    have hB := wc_et_thom_open_restrict_gen K N T hNat ((U k).ι ≫ fX) n c (i ∣_ U k) hcn m iP g''
      hk' (DU k) Fk DP γ' hγ' _ (hH k EU γU hγU)
    have hA := wc_et_thom_open_restrict_gen K N T hNat (W.ι ≫ fX) n c iW hcn (W.ι ⁻¹ᵁ U k).ι iP gP
      hP DW EP DP γP hγP _ hτ
    have hmf : m ≫ (U k).ι ≫ fX = (W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX := by
      rw [← Category.assoc, hm, Category.assoc]
    rw [hmf] at hB

    have hs1 : SmoothOfRelativeDimension n ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX) := by
      have h0 := hO1 ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι)
      rwa [Category.assoc] at h0
    have hs2 : SmoothOfRelativeDimension (n - c) (iP ≫ (W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX) := by
      have h0 := hO2 ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) iP (gP ≫ gW) hO
      rwa [Category.assoc] at h0
    have hcpt : IsCompact ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Set (W : Scheme.{u})) := by
      rw [W.ι.isOpenEmbedding.isEmbedding.isCompact_iff]
      have e : ⇑W.ι '' ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Set (W : Scheme.{u})) =
          (W : Set X) ∩ (U k : Set X) := by
        show ⇑W.ι '' (⇑W.ι ⁻¹' (U k : Set X)) = _
        rw [Set.image_preimage_eq_range_inter, Scheme.Opens.range_ι]
      rw [e]
      exact QuasiSeparatedSpace.inter_isCompact _ _ W.isOpen
        (show IsAffineOpen W from hcut.1).isCompact (U k).isOpen (hUa k).isCompact
    haveI : CompactSpace ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u}) :=
      isCompact_iff_compactSpace.mp hcpt
    have huniq := wc_et_thom_class_unique_gen K N hsp T
      ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u}) ZP
      ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX) n c iP hcn DP _ _ hB hA
    rw [← e1, e2]
    exact huniq

  have hvan : ∀ {V ZV : Scheme.{u}} (j : V ⟶ (W : Scheme.{u})) [IsOpenImmersion j] (iV : ZV ⟶ V)
      (gV : ZV ⟶ ZW), IsPullback gV iV iW j → ∀ (DV : wcEtPullData iV N) (q' : ℕ),
      q' + 1 = 2 * c → ∀ t : wcEtSuppExt DV q', t = 0 := by
    intro V ZV j _ iV gV hsq DV q' hq' t
    have hsq' : IsPullback (gV ≫ gW) iV i (j ≫ W.ι) := hsq.paste_horiz hW
    haveI : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    haveI := hO1 (j ≫ W.ι)
    haveI := hO2 (j ≫ W.ι) iV (gV ≫ gW) hsq'
    exact hsp V ZV ((j ≫ W.ι) ≫ fX) n c iV hcn DV q' (by omega) t

  have hδ := wc_et_supp_opens_cover_injective iW DW (2 * c) hvan M (fun k => W.ι ⁻¹ᵁ U k)
    (by
      intro x
      obtain ⟨k, hk⟩ := hcov (W.ι x)
      exact ⟨k, hk⟩)
    (wcEtSuppRestr D EW DW γ (2 * c) θ - T (W.ι ≫ fX) iW DW c h)
    (by
      intro k ZP iP gP hP DP EP γP hγP
      rw [map_sub, sub_eq_zero]
      exact hkey k ZP iP gP hP DP EP γP hγP)
  exact sub_eq_zero.mp hδ

theorem wc_et_thom_class_glue_pow : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ), (∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0) → ∀ (T : wcEtLocThom K N), wcEtThomGL T → wcEtThomNat T → ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] [CompactSpace ↥X] [IsSeparated fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i N), ∃ θ : wcEtSuppExt D (2 * c), wcEtIsThom T fX D c θ :=
by
  classical
  intro K _ _ N hsp T hGL hNat X Z fX n c _ _ _ i _ _ hcn D

  have hO1 : ∀ {V : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j],
      SmoothOfRelativeDimension n (j ≫ fX) := by
    intro V j _
    have h0 : SmoothOfRelativeDimension (0 + n) (j ≫ fX) := inferInstance
    rwa [zero_add] at h0

  have hO2 : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
    intro V ZV j _ iV gV hsq
    haveI : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    have h0 : SmoothOfRelativeDimension (0 + (n - c)) (gV ≫ i ≫ fX) := inferInstance
    rw [zero_add] at h0
    have e : iV ≫ j ≫ fX = gV ≫ i ≫ fX := by
      rw [← Category.assoc, ← hsq.w, Category.assoc]
    rw [e]
    exact h0

  have hvan : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → ∀ (DV : wcEtPullData iV N) (q' : ℕ), q' + 1 = 2 * c →
        ∀ t : wcEtSuppExt DV q', t = 0 := by
    intro V ZV j _ iV gV hsq DV q' hq' t
    haveI := hO1 j
    haveI : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    haveI := hO2 j iV gV hsq
    exact hsp V ZV (j ≫ fX) n c iV hcn DV q' (by omega) t

  have hloc : ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W ∧
      ∀ DW : wcEtPullData (i ∣_ W) N, ∃ θW : wcEtSuppExt DW (2 * c),
        wcEtIsThom T (W.ι ≫ fX) DW c θW := by
    intro x
    by_cases hx : x ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hx
      obtain ⟨W, hWa, hzW, h, hcut⟩ := wc_smooth_pair_local_cutout K X Z fX n c i hcn z
      refine ⟨W, hWa, hzW, fun DW => ⟨T (W.ι ≫ fX) (i ∣_ W) DW c h, ?_⟩⟩
      haveI := hO1 W.ι
      haveI := hO2 W.ι (i ∣_ W) (i ⁻¹ᵁ W).ι (isPullback_morphismRestrict i W).flip
      exact wc_et_thom_chart_class_gen K N hsp T hGL hNat (W.ι ≫ fX) n c (i ∣_ W) hcn DW h hcut
    · have hopen : IsOpen (Set.range i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
      obtain ⟨W, hWa, hxW, hWsub⟩ :=
        exists_isAffineOpen_mem_and_subset (U := ⟨(Set.range i)ᶜ, hopen⟩) (x := x) hx
      refine ⟨W, hWa, hxW, fun DW => ⟨0, ?_⟩⟩
      have hE : IsEmpty (i ⁻¹ᵁ W : Scheme.{u}) := by
        apply Scheme.isEmpty_of_commSq (isPullback_morphismRestrict i W).flip.toCommSq
        rw [Scheme.Opens.range_ι]
        exact Set.subset_compl_iff_disjoint_left.mp (show (W : Set X) ⊆ (Set.range i)ᶜ from hWsub)
      intro W' ZW' iW' gW' _ DW' EW' γ _ h' _
      haveI : IsEmpty ZW' := ⟨fun z => hE.false (gW' z)⟩
      haveI := wc_et_supp_ext_empty iW' N DW' inferInstance (2 * c)
      exact Subsingleton.elim _ _

  choose W hWa hxW hθW using hloc
  choose θW hθW' using hθW
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
    (fun x => (W x).isOpen.mem_nhds (hxW x))
  let e := t.equivFin
  let U : Fin t.card → X.Opens := fun k => W (e.symm k).1
  have hUa : ∀ k, IsAffineOpen (U k) := fun k => hWa _
  have hcov : ∀ x : X, ∃ k, x ∈ U k := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (W y : Set X) := by
      rw [ht]
      exact Set.mem_univ x
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨e ⟨y, hy⟩, ?_⟩
    show x ∈ W (e.symm (e ⟨y, hy⟩)).1
    rw [Equiv.symm_apply_apply]
    exact hxy
  let DU : ∀ k, wcEtPullData (i ∣_ U k) N := fun k => (wc_et_zmod_pull_data_exists _ N).some
  let θU : ∀ k, wcEtSuppExt (DU k) (2 * c) := fun k => θW _ (DU k)
  have hθU : ∀ k, wcEtIsThom T ((U k).ι ≫ fX) (DU k) c (θU k) := fun k => hθW' _ (DU k)

  haveI hqs : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated fX

  obtain ⟨θ, hθ⟩ := wc_et_supp_opens_cover_glue i D (2 * c) hvan t.card U hcov DU θU (by
    intro k l ZP iP gk gl hk hl DP Ek El γk γl hγk hγl
    have hkk : IsPullback (gk ≫ (i ⁻¹ᵁ U k).ι) iP i (U k ⊓ U l).ι := by
      have h1 := hk.paste_horiz (isPullback_morphismRestrict i (U k)).flip
      rwa [Scheme.homOfLE_ι] at h1
    haveI := hO1 (U k ⊓ U l).ι
    haveI := hO2 (U k ⊓ U l).ι iP _ hkk
    haveI : IsClosedImmersion iP :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hkk inferInstance
    have hcpt : IsCompact ((U k ⊓ U l : X.Opens) : Set X) := by
      rw [TopologicalSpace.Opens.coe_inf]
      exact QuasiSeparatedSpace.inter_isCompact _ _ (U k).isOpen (hUa k).isCompact
        (U l).isOpen (hUa l).isCompact
    haveI : CompactSpace ↥((U k ⊓ U l : X.Opens) : Scheme.{u}) :=
      isCompact_iff_compactSpace.mp hcpt
    have hTk : wcEtIsThom T ((U k ⊓ U l).ι ≫ fX) DP c
        (wcEtSuppRestr (DU k) Ek DP γk (2 * c) (θU k)) := by
      haveI := hO1 (U k).ι
      haveI := hO2 (U k).ι (i ∣_ U k) (i ⁻¹ᵁ U k).ι (isPullback_morphismRestrict i (U k)).flip
      have h1 := wc_et_thom_open_restrict_gen K N T hNat ((U k).ι ≫ fX) n c (i ∣_ U k) hcn
        (X.homOfLE (inf_le_left : U k ⊓ U l ≤ U k)) iP gk hk (DU k) Ek DP γk hγk (θU k) (hθU k)
      have e1 : X.homOfLE (inf_le_left : U k ⊓ U l ≤ U k) ≫ (U k).ι ≫ fX =
          (U k ⊓ U l).ι ≫ fX := by
        rw [← Category.assoc, Scheme.homOfLE_ι]
      rw [e1] at h1
      exact h1
    have hTl : wcEtIsThom T ((U k ⊓ U l).ι ≫ fX) DP c
        (wcEtSuppRestr (DU l) El DP γl (2 * c) (θU l)) := by
      haveI := hO1 (U l).ι
      haveI := hO2 (U l).ι (i ∣_ U l) (i ⁻¹ᵁ U l).ι (isPullback_morphismRestrict i (U l)).flip
      have h1 := wc_et_thom_open_restrict_gen K N T hNat ((U l).ι ≫ fX) n c (i ∣_ U l) hcn
        (X.homOfLE (inf_le_right : U k ⊓ U l ≤ U l)) iP gl hl (DU l) El DP γl hγl (θU l) (hθU l)
      have e1 : X.homOfLE (inf_le_right : U k ⊓ U l ≤ U l) ≫ (U l).ι ≫ fX =
          (U k ⊓ U l).ι ≫ fX := by
        rw [← Category.assoc, Scheme.homOfLE_ι]
      rw [e1] at h1
      exact h1
    exact wc_et_thom_class_unique_gen K N hsp T (U k ⊓ U l : X.Opens) ZP ((U k ⊓ U l).ι ≫ fX) n c
      iP hcn DP _ _ hTk hTl)

  refine ⟨θ, wc_et_thom_local_of_cover_gen K N hsp T hGL hNat X Z fX n c i hcn D t.card U hUa
    hcov DU θ ?_⟩
  intro k E γ hγ
  rw [hθ k E γ hγ]
  exact hθU k

theorem wc_smooth_cutout_transversal_slice : ∀ (K : Type u) [Field K] [IsAlgClosed K] {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW] (i : Z ⟶ W) [SmoothOfRelativeDimension (n - c) (i ≫ fW)] (h : Fin c → Γ(W, ⊤)), c ≤ n → wcEtCutOut i h → ∀ z : Spec (.of K) ⟶ Z, z ≫ i ≫ fW = 𝟙 _ → ∃ (S ZS : Scheme.{u}) (f : S ⟶ W) (iS : ZS ⟶ S) (g : ZS ⟶ Z), IsAffine S ∧ IsPullback g iS i f ∧ SmoothOfRelativeDimension c (f ≫ fW) ∧ SmoothOfRelativeDimension 0 (iS ≫ f ≫ fW) ∧ Nonempty ZS :=
by
  classical

  have s2 : ∀ (R R' A : Type u) [CommRing R] [CommRing R'] [CommRing A] (φ : R →+* A) (ρ : R →+* R') (J : Ideal A), φ.Etale → Function.Surjective ρ → Ideal.map φ (RingHom.ker ρ) = J → ∀ β : R' →+* A ⧸ J, β.comp ρ = (Ideal.Quotient.mk J).comp φ → β.Etale := by
    intro R R' A _ _ _ φ ρ J hφ hρ hJ β hβ
    letI := φ.toAlgebra
    have h1 := RingHom.Etale.isStableUnderBaseChange.tensorProduct (R ⧸ RingHom.ker ρ)
      (show (algebraMap R A).Etale from hφ)
    let e₁ : R' ≃+* R ⧸ RingHom.ker ρ := (RingHom.quotientKerEquivOfSurjective hρ).symm
    let e₂ : TensorProduct R (R ⧸ RingHom.ker ρ) A ≃+* A ⧸ J :=
      ((Algebra.TensorProduct.comm R (R ⧸ RingHom.ker ρ) A).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (RingHom.ker ρ)).symm.toRingEquiv).trans
        (Ideal.quotEquivOfEq hJ)
    have h2 := RingHom.Etale.respectsIso.2 _ e₁ (RingHom.Etale.respectsIso.1 _ e₂ h1)
    convert h2 using 1
    ext1 y
    obtain ⟨r, rfl⟩ := hρ y
    have he1 : e₁ (ρ r) = Ideal.Quotient.mk (RingHom.ker ρ) r := by
      show (RingHom.quotientKerEquivOfSurjective hρ).symm (ρ r) = _
      rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
    have hT : (1 : A) ⊗ₜ[R] (Ideal.Quotient.mk (RingHom.ker ρ) r) = (φ r) ⊗ₜ[R] (1 : R ⧸ RingHom.ker ρ) := by
      rw [← Ideal.Quotient.algebraMap_eq, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul,
        Algebra.smul_def, mul_one]
      rfl
    have he2 : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (RingHom.ker ρ)).symm
        ((φ r) ⊗ₜ[R] (1 : R ⧸ RingHom.ker ρ)) = Ideal.Quotient.mk _ (φ r) := by
      rw [AlgEquiv.symm_apply_eq, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    rw [← RingHom.comp_apply β ρ, hβ, RingHom.comp_apply]
    show _ = e₂ (algebraMap (R ⧸ RingHom.ker ρ) (TensorProduct R (R ⧸ RingHom.ker ρ) A) (e₁ (ρ r)))
    rw [he1, Algebra.TensorProduct.algebraMap_apply]
    show _ = Ideal.quotEquivOfEq hJ
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (RingHom.ker ρ)).symm
        ((Algebra.TensorProduct.comm R (R ⧸ RingHom.ker ρ) A)
          ((algebraMap (R ⧸ RingHom.ker ρ) (R ⧸ RingHom.ker ρ)) (Ideal.Quotient.mk (RingHom.ker ρ) r) ⊗ₜ[R] (1 : A))))
    rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply, hT, he2]
    rfl

  have s5 : ∀ (R B : Type u) [CommRing R] [CommRing B] (φ : R →+* B) (c m : ℕ) (h : Fin c → B) (g : Fin m → B) (a : Fin m → R) (J : Ideal B), J = Ideal.span (Set.range (fun k => g k - φ (a k))) → (MvPolynomial.eval₂Hom φ (Sum.elim h g)).Etale → (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk J).comp φ) (fun j : ULift.{u} (Fin c) => Ideal.Quotient.mk J (h j.down))).Etale := by
    intro R B _ _ φ c m h g a J hJ hΨ
    set Ψ := MvPolynomial.eval₂Hom φ (Sum.elim h g) with hΨdef
    set ρ : MvPolynomial (Fin c ⊕ Fin m) R →+* MvPolynomial (ULift.{u} (Fin c)) R :=
      MvPolynomial.eval₂Hom MvPolynomial.C
        (Sum.elim (fun j : Fin c => (MvPolynomial.X (ULift.up j) : MvPolynomial (ULift.{u} (Fin c)) R))
          (fun k => MvPolynomial.C (a k))) with hρ
    set σ : MvPolynomial (ULift.{u} (Fin c)) R →ₐ[R] MvPolynomial (Fin c ⊕ Fin m) R :=
      MvPolynomial.rename (fun j : ULift.{u} (Fin c) => (Sum.inl j.down : Fin c ⊕ Fin m)) with hσ
    have hr : ∀ q, ρ (σ q) = q := by
      intro q
      rw [hρ, hσ, MvPolynomial.eval₂Hom_rename]
      have : (Sum.elim (fun j : Fin c => (MvPolynomial.X (ULift.up j) : MvPolynomial (ULift.{u} (Fin c)) R))
          (fun k => MvPolynomial.C (a k)) ∘
          (fun j : ULift.{u} (Fin c) => (Sum.inl j.down : Fin c ⊕ Fin m))) = MvPolynomial.X := by
        funext j; rfl
      rw [this]
      exact MvPolynomial.eval₂_eta q
    set I := Ideal.span (Set.range (fun k : Fin m =>
      (MvPolynomial.X (Sum.inr k) - MvPolynomial.C (a k) : MvPolynomial (Fin c ⊕ Fin m) R))) with hI
    have key : ∀ p, p - σ (ρ p) ∈ I := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C r => simp [ρ, σ]
      | add p q hp hq =>
        rw [map_add, map_add]
        convert add_mem hp hq using 1
        ring
      | mul_X p n hp =>
        rw [map_mul, map_mul]
        have e : p * MvPolynomial.X n - σ (ρ p) * σ (ρ (MvPolynomial.X n)) =
            (p - σ (ρ p)) * MvPolynomial.X n +
              σ (ρ p) * (MvPolynomial.X n - σ (ρ (MvPolynomial.X n))) := by ring
        rw [e]
        refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
        cases n with
        | inl j => simp [ρ, σ]
        | inr k =>
          have h1 : σ (ρ (MvPolynomial.X (Sum.inr k))) = MvPolynomial.C (a k) := by simp [ρ, σ]
          rw [h1]
          exact Ideal.subset_span ⟨k, rfl⟩
    have hker : RingHom.ker ρ = I := by
      apply le_antisymm
      · intro p hp
        have := key p
        rw [RingHom.mem_ker.mp hp, map_zero, sub_zero] at this
        exact this
      · rw [hI, Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        show _ ∈ RingHom.ker ρ
        rw [RingHom.mem_ker]
        simp [ρ]
    have hmapI : Ideal.map Ψ (RingHom.ker ρ) = J := by
      rw [hker, hI, Ideal.map_span, ← Set.range_comp, hJ]
      congr 2
      funext k
      simp [Ψ]
    have hβρ : (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk J).comp φ)
        (fun j : ULift.{u} (Fin c) => Ideal.Quotient.mk J (h j.down))).comp ρ =
        (Ideal.Quotient.mk J).comp Ψ := by
      refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
      · simp [ρ, Ψ]
      · cases i with
        | inl j => simp [ρ, Ψ]
        | inr k =>
          have hmem : g k - φ (a k) ∈ J := by rw [hJ]; exact Ideal.subset_span ⟨k, rfl⟩
          have hq : Ideal.Quotient.mk J (g k) = Ideal.Quotient.mk J (φ (a k)) :=
            Ideal.Quotient.eq.mpr hmem
          simp [ρ, Ψ, hq]
    exact s2 _ _ _ Ψ ρ J hΨ (fun q => ⟨σ q, hr q⟩) hmapI _ hβρ

  have s6 : ∀ {X S : Scheme.{u}} [IsAffine X] [IsAffine S] (fX : X ⟶ S) {ι : Type u} (v : ι → Γ(X, ⊤)), (MvPolynomial.eval₂Hom fX.appTop.hom v).Etale → Etale (AffineSpace.homOfVector fX v) := by
    intro X S _ _ fX ι v hE
    rw [HasRingHomProperty.iff_of_isAffine (P := @Etale)]
    set ψ : MvPolynomial ι Γ(S, ⊤) →+* Γ(AffineSpace ι S, ⊤) :=
      MvPolynomial.eval₂Hom (AffineSpace ι S ↘ S).appTop.hom (AffineSpace.coord S) with hψ
    have hiso : IsIso (CommRingCat.ofHom ψ) := by
      have h1 := AffineSpace.isoOfIsAffine_hom_appTop (n := ι) S
      haveI : IsIso (Scheme.Hom.appTop (AffineSpace.isoOfIsAffine ι S).hom) :=
        (Scheme.Γ.mapIso (AffineSpace.isoOfIsAffine ι S).op).isIso_hom
      have : IsIso ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial ι Γ(S, ⊤)))).hom ≫
          CommRingCat.ofHom ψ) := by
        rw [← h1]; infer_instance
      exact IsIso.of_isIso_comp_left (Scheme.ΓSpecIso _).hom _
    have hbij : Function.Bijective ψ := ConcreteCategory.bijective_of_isIso (CommRingCat.ofHom ψ)
    let e : MvPolynomial ι Γ(S, ⊤) ≃+* Γ(AffineSpace ι S, ⊤) := RingEquiv.ofBijective ψ hbij
    have hπ : ∀ r, (AffineSpace.homOfVector fX v).appTop.hom ((AffineSpace ι S ↘ S).appTop.hom r) =
        fX.appTop.hom r := by
      intro r
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, AffineSpace.homOfVector_over]
    have hcomp : ((AffineSpace.homOfVector fX v).appTop.hom).comp ψ =
        MvPolynomial.eval₂Hom fX.appTop.hom v := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [hψ, RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval₂Hom_C]
        rw [hπ]
      · intro j
        simp only [hψ, RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [AffineSpace.homOfVector_appTop_coord]
    have h2 := RingHom.Etale.respectsIso.2 _ e.symm hE
    rw [← hcomp] at h2
    convert h2 using 1
    ext x
    simp only [RingHom.coe_comp, Function.comp_apply]
    congr 1
    exact (e.apply_symm_apply x).symm

  intro K _ _ W Z fW n c _ i _ h hcn hcut z hz
  obtain ⟨hWa, hci, -⟩ := hcut
  haveI := hWa
  haveI := hci
  obtain ⟨z₀, hz₀⟩ : ∃ z₀ : Z, z₀ = z (IsLocalRing.closedPoint K) := ⟨_, rfl⟩

  obtain ⟨W₁, hzW₁, h₁, -, hW₁a, hcut₁, hstdA, hstdB, hker₁⟩ :=
    wc_tube_chart K W Z fW n c i hcn ⊤ z₀ trivial
  letI : Algebra Γ(Spec (.of K), ⊤) Γ(W₁, ⊤) := (W₁.ι ≫ fW).appTop.hom.toAlgebra
  haveI : IsDomain ((W₁ : Scheme.{u}).residueField ⟨i z₀, hzW₁⟩) := by
    exact @Field.isDomain _ (Scheme.instFieldCarrierResidueField _ _)
  haveI hqp : (RingHom.ker ((W₁ : Scheme.{u}).evaluation ⊤ ⟨i z₀, hzW₁⟩ trivial).hom).IsPrime :=
    RingHom.ker_isPrime _
  obtain ⟨g₁, hg₁⟩ := wc_tube_complementary_coords Γ(Spec (.of K), ⊤) Γ(W₁, ⊤) (n - c) c h₁ hstdB
    (RingHom.ker ((W₁ : Scheme.{u}).evaluation ⊤ ⟨i z₀, hzW₁⟩ trivial).hom) hker₁
  obtain ⟨s, hsq, het⟩ := wc_tube_jacobian_etale Γ(Spec (.of K), ⊤) Γ(W₁, ⊤) n
    (Fin c ⊕ Fin (n - c)) (Sum.elim h₁ g₁) hstdA
    (by simp only [Fintype.card_sum, Fintype.card_fin]; omega)
    (RingHom.ker ((W₁ : Scheme.{u}).evaluation ⊤ ⟨i z₀, hzW₁⟩ trivial).hom) hg₁
  obtain ⟨W', -, hzW', h', g', hcut', hetW'⟩ := wc_tube_shrink_basicOpen fW i W₁ (i z₀) hzW₁ c
    (n - c) h₁ g₁ s hW₁a (fun h0 => hsq (RingHom.mem_ker.mpr h0)) hcut₁ het

  have sqW : IsPullback (i ⁻¹ᵁ W').ι (i ∣_ W') i W'.ι := (isPullback_morphismRestrict i W').flip
  have hcutW : wcEtCutOut (i ∣_ W') h' := hcut' _ (i ∣_ W') _ sqW
  have hcutW2 := hcutW
  obtain ⟨hW'a, hiWc, -⟩ := hcutW2
  haveI := hW'a
  haveI := hiWc

  have hrange : Set.range z ⊆ Set.range (i ⁻¹ᵁ W').ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    rw [Subsingleton.elim p (IsLocalRing.closedPoint K), ← hz₀]
    exact hzW'
  obtain ⟨zW, hzW⟩ : ∃ zW : Spec (.of K) ⟶ (i ⁻¹ᵁ W' : Scheme.{u}), zW ≫ (i ⁻¹ᵁ W').ι = z :=
    ⟨IsOpenImmersion.lift (i ⁻¹ᵁ W').ι z hrange, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨w', hw'def⟩ : ∃ w' : Spec (.of K) ⟶ (W' : Scheme.{u}), w' = zW ≫ (i ∣_ W') := ⟨_, rfl⟩
  have hw' : w' ≫ W'.ι = z ≫ i := by
    rw [hw'def, Category.assoc, morphismRestrict_ι, ← Category.assoc, hzW]
  have heφ : ∀ r, w'.appTop.hom ((W'.ι ≫ fW).appTop.hom r) = r := by
    intro r
    have h1 : w' ≫ (W'.ι ≫ fW) = 𝟙 _ := by rw [← Category.assoc, hw', Category.assoc, hz]
    have h2 : (Scheme.Hom.appTop (w' ≫ (W'.ι ≫ fW))).hom r =
        (Scheme.Hom.appTop (𝟙 (Spec (.of K)))).hom r := by rw [h1]
    rw [Scheme.Hom.comp_appTop w' (W'.ι ≫ fW), Scheme.Hom.id_appTop] at h2
    exact h2

  obtain ⟨J, hJdef⟩ : ∃ J : Ideal Γ(W', ⊤), J = Ideal.span (Set.range (fun k =>
      g' k - (W'.ι ≫ fW).appTop.hom (w'.appTop.hom (g' k)))) := ⟨_, rfl⟩
  have hJe : J ≤ RingHom.ker w'.appTop.hom := by
    rw [hJdef, Ideal.span_le]
    rintro _ ⟨k, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker]
    rw [map_sub, heφ]
    exact sub_self _

  obtain ⟨f', hf'def⟩ : ∃ f' : Spec (.of (Γ(W', ⊤) ⧸ J)) ⟶ (W' : Scheme.{u}),
      f' = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫ (W' : Scheme.{u}).isoSpec.inv :=
    ⟨_, rfl⟩
  have hpb : IsPullback (Limits.pullback.fst (i ∣_ W') f' ≫ (i ⁻¹ᵁ W').ι)
      (Limits.pullback.snd (i ∣_ W') f') i (f' ≫ W'.ι) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback (i ∣_ W') f') sqW

  have hinv : (W' : Scheme.{u}).isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(W', ⊤)).inv := by
    rw [← Iso.comp_hom_eq_id, ← Scheme.toSpecΓ_appTop, ← Scheme.isoSpec_hom,
      ← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
  have hf'top : f'.appTop = CommRingCat.ofHom (Ideal.Quotient.mk J) ≫
      (Scheme.ΓSpecIso (CommRingCat.of (Γ(W', ⊤) ⧸ J))).inv := by
    rw [hf'def, Scheme.Hom.comp_appTop, hinv]
    exact (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (Ideal.Quotient.mk J))).symm
  have hf'app : ∀ x, f'.appTop.hom x =
      (Scheme.ΓSpecIso (CommRingCat.of (Γ(W', ⊤) ⧸ J))).inv.hom (Ideal.Quotient.mk J x) := by
    intro x; rw [hf'top]; rfl
  have hfSapp : ∀ r, (f' ≫ W'.ι ≫ fW).appTop.hom r = f'.appTop.hom ((W'.ι ≫ fW).appTop.hom r) := by
    intro r; rw [Scheme.Hom.comp_appTop f' (W'.ι ≫ fW)]; rfl
  let eJ : (Γ(W', ⊤) ⧸ J) ≃+* Γ(Spec (.of (Γ(W', ⊤) ⧸ J)), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of (Γ(W', ⊤) ⧸ J))).symm.commRingCatIsoToRingEquiv
  have hβ := s5 Γ(Spec (.of K), ⊤) Γ(W', ⊤) ((W'.ι ≫ fW).appTop.hom) c (n - c) h' g'
    (fun k => w'.appTop.hom (g' k)) J hJdef hetW'
  have hEv : (MvPolynomial.eval₂Hom (f' ≫ W'.ι ≫ fW).appTop.hom
      (fun j : ULift.{u} (Fin c) => f'.appTop.hom (h' j.down))).Etale := by
    have h1 := RingHom.Etale.respectsIso.1 _ eJ hβ
    have heq : MvPolynomial.eval₂Hom (f' ≫ W'.ι ≫ fW).appTop.hom
        (fun j : ULift.{u} (Fin c) => f'.appTop.hom (h' j.down)) =
        eJ.toRingHom.comp (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk J).comp (W'.ι ≫ fW).appTop.hom)
          (fun j : ULift.{u} (Fin c) => Ideal.Quotient.mk J (h' j.down))) := by
      refine MvPolynomial.ringHom_ext (fun r => ?_) (fun j => ?_)
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        rw [hfSapp, hf'app]; rfl
      · simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [hf'app]; rfl
    rw [heq]; exact h1
  haveI hEt : Etale (AffineSpace.homOfVector (f' ≫ W'.ι ≫ fW)
      (fun j : ULift.{u} (Fin c) => f'.appTop.hom (h' j.down))) := s6 _ _ hEv

  obtain ⟨q, hq, -⟩ := wc_affine_space_ulift_mvpoly_zero_pullback K (Spec (.of K)) (𝟙 _) c
  haveI hsmK := wc_mvpoly_spec_smooth_reldim K c
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange c
  haveI hpr : SmoothOfRelativeDimension c
      (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension c) hq.flip hsmK
  haveI hEt0 : SmoothOfRelativeDimension 0 (AffineSpace.homOfVector (f' ≫ W'.ι ≫ fW)
      (fun j : ULift.{u} (Fin c) => f'.appTop.hom (h' j.down))) :=
    (Etale.iff_smoothOfRelativeDimension_zero _).mp hEt
  have hsmc : SmoothOfRelativeDimension c (f' ≫ W'.ι ≫ fW) := by
    have := smoothOfRelativeDimension_comp 0 c (AffineSpace.homOfVector (f' ≫ W'.ι ≫ fW)
      (fun j : ULift.{u} (Fin c) => f'.appTop.hom (h' j.down)))
      (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K))
    rw [Nat.zero_add, AffineSpace.homOfVector_over] at this
    exact this

  have hcutS := wc_et_cutout_base_change (i ∣_ W') h' f' (Limits.pullback.snd (i ∣_ W') f')
    (Limits.pullback.fst (i ∣_ W') f') hcutW inferInstance (IsPullback.of_hasPullback (i ∣_ W') f')
  have hzp := wc_et_zero_section_cutout_pullback K (f' ≫ W'.ι ≫ fW)
    (Limits.pullback.snd (i ∣_ W') f') (fun k => f'.appTop.hom (h' k)) hcutS
  have hEtZ : Etale (Limits.pullback.snd (i ∣_ W') f' ≫ f' ≫ W'.ι ≫ fW) :=
    MorphismProperty.of_isPullback (P := @Etale) hzp.flip hEt

  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : Γ(W', ⊤) ⧸ J →+* Γ(Spec (.of K), ⊤),
      ℓ.comp (Ideal.Quotient.mk J) = w'.appTop.hom :=
    ⟨Ideal.Quotient.lift J (w'.appTop.hom : Γ(W', ⊤) →+* Γ(Spec (.of K), ⊤)) (fun x hx => hJe hx),
      Ideal.Quotient.lift_comp_mk _ _ _⟩
  obtain ⟨s₀, hs₀def⟩ : ∃ s₀ : Spec (.of K) ⟶ Spec (.of (Γ(W', ⊤) ⧸ J)),
      s₀ = Spec.map (CommRingCat.ofHom ((Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom.comp ℓ)) :=
    ⟨_, rfl⟩
  have hs₀ : s₀ ≫ f' = w' := by
    have e1 : CommRingCat.ofHom (Ideal.Quotient.mk J) ≫
        CommRingCat.ofHom ((Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom.comp ℓ) =
        w'.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom := by
      ext x
      change (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom (ℓ (Ideal.Quotient.mk J x)) =
        (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom (w'.appTop.hom x)
      rw [← RingHom.comp_apply ℓ, hℓ]
    rw [hs₀def, hf'def, ← Category.assoc, ← Spec.map_comp, e1, Spec.map_comp,
      ← Scheme.isoSpec_Spec_hom, Scheme.isoSpec_hom_naturality, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  have hcomm : zW ≫ (i ∣_ W') = s₀ ≫ f' := by rw [hs₀, hw'def]
  refine ⟨Spec (.of (Γ(W', ⊤) ⧸ J)), Limits.pullback (i ∣_ W') f', f' ≫ W'.ι,
    Limits.pullback.snd (i ∣_ W') f', Limits.pullback.fst (i ∣_ W') f' ≫ (i ⁻¹ᵁ W').ι,
    inferInstance, hpb, ?_, ?_, ⟨(Limits.pullback.lift zW s₀ hcomm) (IsLocalRing.closedPoint K)⟩⟩
  · rw [Category.assoc]; exact hsmc
  · rw [Category.assoc]; exact (Etale.iff_smoothOfRelativeDimension_zero _).mp hEtZ

theorem wc_smooth_pair_local_zmod_codim_card_ge (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) :
    ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * r)) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * r)) :=
by
  intro k hk hfin

  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  have hrn : r ≤ n := by omega
  have hm' : m = n - r := by omega
  subst hm'
  have hNpos : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  have hzero : (ℓ ^ k) • 𝟙 (wcZModSheaf Y (ℓ ^ k)) = 0 := by
    apply Sheaf.hom_ext
    ext U x
    show ((sheafToPresheaf _ _).map ((ℓ ^ k) • 𝟙 (wcZModSheaf Y (ℓ ^ k)))).app U x = 0
    rw [Functor.map_nsmul, NatTrans.app_nsmul, CategoryTheory.Functor.map_id, NatTrans.id_app]
    show ((ℓ ^ k) • AddMonoidHom.id _) x = 0
    rw [AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
    have key : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, ZMod (ℓ ^ k))), (ℓ ^ k) • g = 0 := by
      intro T _ g
      ext t
      first
        | (simp only [ContinuousMap.coe_nsmul, Pi.smul_apply, ContinuousMap.zero_apply, nsmul_eq_mul]
           rw [ZMod.natCast_self, zero_mul])
        | (simp
           rw [← Nat.cast_pow, ZMod.natCast_self, zero_mul])
    obtain ⟨f⟩ := x
    apply ULift.ext
    exact key _ f
  have htors : ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
      (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
        Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y (ℓ ^ k)) (2 * r),
      (ℓ ^ k) • x = 0 := by
    intro x
    have key : ∀ j : ℕ,
        x.comp (Abelian.Ext.mk₀ (j • 𝟙 (wcZModSheaf Y (ℓ ^ k)))) (add_zero (2 * r)) = j • x := by
      intro j
      induction j with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ j ih =>
        rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
          succ_nsmul]
    rw [← key (ℓ ^ k), hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i (ℓ ^ k)
  have hsp : ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ)
      [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i]
      [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n →
      ∀ (D : wcEtPullData i (ℓ ^ k)) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0 := by
    intro X Z fX n c _ i _ _ hc D q hq θ
    exact wc_et_supp_semipurity_pow K X Z fX n c i hc ℓ hℓ k hk D q hq θ
  obtain ⟨T, hGL, hNat, hPt⟩ := wc_et_kummer_local_thom_pow K ℓ hℓ k hk
  obtain ⟨θ, hθ⟩ := wc_et_thom_class_glue_pow K (ℓ ^ k) hsp T hGL hNat Y Z pY n r i hrn D

  have hθne : ℓ ^ (k - 1) • θ ≠ 0 := by
    obtain ⟨z⟩ : Nonempty Z := inferInstance
    obtain ⟨W, -, hzW, h, hcut⟩ := wc_smooth_pair_local_cutout K Y Z pY n r i hrn z
    have sq : IsPullback (i ⁻¹ᵁ W).ι (i ∣_ W) i W.ι := (isPullback_morphismRestrict i W).flip
    obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (i ∣_ W) (ℓ ^ k)
    obtain ⟨EW⟩ := wc_et_zmod_pull_data_exists W.ι (ℓ ^ k)
    obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change i W.ι (i ∣_ W) (i ⁻¹ᵁ W).ι sq D EW DW
    have hθW := hθ W _ (i ∣_ W) (i ⁻¹ᵁ W).ι sq DW EW γ hγ h hcut
    haveI hsmW : SmoothOfRelativeDimension n (W.ι ≫ pY) := by
      have := smoothOfRelativeDimension_comp 0 n W.ι pY
      rwa [Nat.zero_add] at this
    have e : (i ∣_ W) ≫ W.ι ≫ pY = (i ⁻¹ᵁ W).ι ≫ i ≫ pY := by
      rw [← Category.assoc, morphismRestrict_ι, Category.assoc]
    haveI hsmZW : SmoothOfRelativeDimension (n - r) ((i ∣_ W) ≫ W.ι ≫ pY) := by
      rw [e]
      have := smoothOfRelativeDimension_comp 0 (n - r) (i ⁻¹ᵁ W).ι (i ≫ pY)
      rwa [Nat.zero_add] at this
    have hneW : Nonempty (i ⁻¹ᵁ W).toScheme := ⟨⟨z, hzW⟩⟩
    obtain ⟨zK, hzK⟩ := wc_alg_closed_lft_section K (i ⁻¹ᵁ W).toScheme
      ((i ∣_ W) ≫ W.ι ≫ pY) hneW
    obtain ⟨S, ZS, f, iS, g, hSaff, hpb, hsm, hsm0, hne⟩ :=
      wc_smooth_cutout_transversal_slice K (W.ι ≫ pY) n r (i ∣_ W) h hrn hcut zK hzK
    obtain ⟨Df⟩ := wc_et_zmod_pull_data_exists f (ℓ ^ k)
    obtain ⟨DS⟩ := wc_et_zmod_pull_data_exists iS (ℓ ^ k)
    obtain ⟨γf, hγf, -⟩ := wc_et_closed_supp_base_change (i ∣_ W) f iS g hpb DW Df DS
    have hcutS := wc_et_cutout_base_change (i ∣_ W) h f iS g hcut hSaff hpb
    have hgoodW : wcEtGoodChart K (W.ι ≫ pY) (i ∣_ W) r h := ⟨n, hrn, hsmW, hsmZW, hcut⟩
    have hgoodS : wcEtGoodChart K (f ≫ W.ι ≫ pY) iS r (fun j => f.appTop.hom (h j)) :=
      ⟨r, le_rfl, hsm, by rw [Nat.sub_self]; exact hsm0, hcutS⟩
    have hNatS := hNat (W.ι ≫ pY) (f ≫ W.ι ≫ pY) f rfl (i ∣_ W) iS g hpb DW Df DS γf hγf r h
      hgoodW hgoodS
    have hPtS := hPt (f ≫ W.ι ≫ pY) iS DS r (fun j => f.appTop.hom (h j)) hsm hsm0 hcutS hne
    intro h0
    apply hPtS
    have key : ℓ ^ (k - 1) • T (f ≫ W.ι ≫ pY) iS DS r (fun j => f.appTop.hom (h j)) =
        wcEtSuppRestr DW Df DS γf (2 * r) (wcEtSuppRestr D EW DW γ (2 * r) (ℓ ^ (k - 1) • θ)) := by
      rw [map_nsmul, map_nsmul]
      exact congrArg (fun x => ℓ ^ (k - 1) • x)
        ((congrArg (wcEtSuppRestr DW Df DS γf (2 * r)) hθW).trans hNatS).symm
    rw [key, h0, map_zero, map_zero]

  obtain ⟨Ψ, hΨ⟩ := wc_et_proet_free_coker_supp_ext_inj i O hO (ℓ ^ k) hNpos D (2 * r)
  have hx1 : ¬ ℓ ^ (k - 1) • Ψ θ = 0 := by
    rw [← map_nsmul]
    intro h0
    exact hθne (hΨ (h0.trans (map_zero Ψ).symm))
  have hx2 : ℓ ^ (k - 1 + 1) • Ψ θ = 0 := by
    rw [Nat.sub_add_cancel hk]
    exact htors _

  have hord := addOrderOf_eq_prime_pow hx1 hx2
  haveI := hfin
  calc ℓ ^ k = ℓ ^ (k - 1 + 1) := by rw [Nat.sub_add_cancel hk]
    _ = addOrderOf (Ψ θ) := hord.symm
    _ ≤ _ := addOrderOf_le_card

theorem wc_smooth_pair_int_supp_red_surj (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ θ1 : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r),
      ∃ θ : Abelian.Ext (wcIntSuppObj Di) (wcIntUnit Y ℓ) (2 * r),
        θ.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
          (add_zero _) = θ1 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  intro θ1
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  have hℓ2 : 2 ≤ ℓ := (Fact.out : ℓ.Prime).two_le
  have hℓpos : 0 < ℓ := by omega
  let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hO : (O : Set Y) = (Set.range i)ᶜ := rfl

  obtain ⟨hf1', hle1'⟩ := wc_smooth_pair_local_zmod_codim_card_le K pY n m r hmr i ℓ hℓ O hO
  obtain ⟨E1⟩ := wc_closed_int_supp_tors_ext_equiv i ℓ Di hDi O hO 1 (2 * r) le_rfl
  have hfin1 : Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) :=
    Finite.of_equiv _ E1.symm
  have hle1 : Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) ≤ ℓ := by
    rw [Nat.card_congr E1]; exact hle1'
  have hge : ∀ k : ℕ, 1 ≤ k → Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) →
      ℓ ^ k ≤ Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) := by
    intro k hk hf
    obtain ⟨Ek⟩ := wc_closed_int_supp_tors_ext_equiv i ℓ Di hDi O hO k (2 * r) hk
    rw [Nat.card_congr Ek]
    exact wc_smooth_pair_local_zmod_codim_card_ge K pY n m r hmr i ℓ hℓ O hO k hk
      (Finite.of_equiv _ Ek)

  have hmono : ∀ k : ℕ, Mono ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) := by
    intro k
    have hN : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
    have hc : ((ℓ ^ k : ℕ) : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hN
    have key : ∀ {T : Type u} [TopologicalSpace T] (a b : C(T, ULift.{u+1} ℤ_[ℓ])),
        (ℓ ^ k : ℕ) • a = (ℓ ^ k : ℕ) • b → a = b := by
      intro T _ a b h
      ext t
      have h1 : (ℓ ^ k : ℕ) • (a t).down = (ℓ ^ k : ℕ) • (b t).down :=
        congrArg (fun g : C(T, ULift.{u+1} ℤ_[ℓ]) => (g t).down) h
      rw [nsmul_eq_mul, nsmul_eq_mul] at h1
      exact mul_left_cancel₀ hc h1
    apply Functor.mono_of_mono_map (SheafOfModules.forget (wcIntRingSheaf Y ℓ))
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply PresheafOfModules.mono_of_injective
    intro X x y hxy
    have e : ((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf Y ℓ)).obj
        (wcIntUnit Y ℓ))).app X = (ℓ ^ k : ℕ) • 𝟙 _ := by
      rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
        PresheafOfModules.id_app]
      rfl
    rw [e] at hxy
    simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
      LinearMap.id_apply] at hxy
    exact key (T := ↥((Scheme.ProEt.forget Y ⋙ Over.forget Y).obj (Opposite.unop X))) x y hxy

  have tors : ∀ (U : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) (nn : ℕ → (U ⟶ U)),
      (∀ k, Mono (nn k)) → (∀ a b, nn a ≫ nn b = nn (a + b)) → ∀ k : ℕ,
      ∃ (ι : Limits.cokernel (nn 1) ⟶ Limits.cokernel (nn (k + 1)))
        (t₀ : Limits.cokernel (nn (k + 1)) ⟶ Limits.cokernel (nn k)) (w : ι ≫ t₀ = 0),
        Limits.cokernel.π (nn (k + 1)) ≫ t₀ = Limits.cokernel.π (nn k) ∧
        Limits.cokernel.π (nn 1) ≫ ι = nn k ≫ Limits.cokernel.π (nn (k + 1)) ∧
          (ShortComplex.mk ι t₀ w).ShortExact := by
    intro U nn hmono hnn k
    have E1 : nn (k + 1) ≫ Limits.cokernel.π (nn k) = 0 := by
      rw [show k + 1 = 1 + k by omega, ← hnn, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have E2 : nn 1 ≫ (nn k ≫ Limits.cokernel.π (nn (k + 1))) = 0 := by
      rw [← Category.assoc, hnn, show 1 + k = k + 1 by omega, Limits.cokernel.condition]
    obtain ⟨t₀, F1⟩ : ∃ t₀ : Limits.cokernel (nn (k + 1)) ⟶ Limits.cokernel (nn k),
        Limits.cokernel.π (nn (k + 1)) ≫ t₀ = Limits.cokernel.π (nn k) :=
      ⟨Limits.cokernel.desc _ _ E1, Limits.cokernel.π_desc _ _ _⟩
    obtain ⟨ι, F2⟩ : ∃ ι : Limits.cokernel (nn 1) ⟶ Limits.cokernel (nn (k + 1)),
        Limits.cokernel.π (nn 1) ≫ ι = nn k ≫ Limits.cokernel.π (nn (k + 1)) :=
      ⟨Limits.cokernel.desc _ _ E2, Limits.cokernel.π_desc _ _ _⟩
    have F3 : ι ≫ t₀ = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (nn 1)), Limits.comp_zero, reassoc_of% F2, F1,
        Limits.cokernel.condition]
    haveI : Epi t₀ := epi_of_epi_fac F1
    haveI : Mono ι := by
      apply Preadditive.mono_of_cancel_zero
      intro P g hg
      obtain ⟨A', π, hπ, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π (nn 1)) g
      have h1 : (y ≫ nn k) ≫ Limits.cokernel.π (nn (k + 1)) = 0 := by
        simp only [Category.assoc]
        rw [← F2, ← reassoc_of% hy, hg, Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (nn (k + 1))).exact_up_to_refinements (y ≫ nn k) h1
      have hz' : π' ≫ y ≫ nn k = z ≫ nn (k + 1) := hz
      haveI := hπ
      haveI := hπ'
      haveI := hmono k
      have h2 : π' ≫ y = z ≫ nn 1 := by
        rw [← cancel_mono (nn k)]
        simp only [Category.assoc]
        rw [hnn, show 1 + k = k + 1 by omega]
        exact hz'
      have h3 : (π' ≫ π) ≫ g = 0 := by
        simp only [Category.assoc]
        rw [hy, reassoc_of% h2, Limits.cokernel.condition, Limits.comp_zero]
      exact (cancel_epi (π' ≫ π)).1 (h3.trans Limits.comp_zero.symm)
    have hexact : (ShortComplex.mk ι t₀ F3).Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      have hx₂' : x₂ ≫ t₀ = 0 := hx₂
      obtain ⟨A', π, hπ, y, hy⟩ :=
        surjective_up_to_refinements_of_epi (Limits.cokernel.π (nn (k + 1))) x₂
      have h1 : y ≫ Limits.cokernel.π (nn k) = 0 := by
        rw [← F1, ← reassoc_of% hy, hx₂', Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (nn k)).exact_up_to_refinements y h1
      have hz' : π' ≫ y = z ≫ nn k := hz
      haveI := hπ
      haveI := hπ'
      refine ⟨A'', π' ≫ π, inferInstance, z ≫ Limits.cokernel.π (nn 1), ?_⟩
      show (π' ≫ π) ≫ x₂ = (z ≫ Limits.cokernel.π (nn 1)) ≫ ι
      simp only [Category.assoc]
      rw [F2, hy, reassoc_of% hz']
    exact ⟨ι, t₀, F3, F1, F2, ShortComplex.ShortExact.mk' hexact inferInstance inferInstance⟩
  have hnn : ∀ a b : ℕ, ((ℓ ^ a : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫
      ((ℓ ^ b : ℕ) • 𝟙 (wcIntUnit Y ℓ)) =
        ((ℓ ^ (a + b) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) := by
    intro a b
    rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add, Nat.add_comm b a]
  have hk : ∀ k : ℕ, ∃ (ι : wcIntTors Y ℓ 1 ⟶ wcIntTors Y ℓ (k + 1))
      (t : wcIntTors Y ℓ (k + 1) ⟶ wcIntTors Y ℓ k) (w : ι ≫ t = 0),
      Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t =
        Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ∧
      Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ ι =
        ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫
          Limits.cokernel.π ((ℓ ^ (k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ∧
      (ShortComplex.mk ι t w).ShortExact :=
    fun k => tors (wcIntUnit Y ℓ) (fun k => (ℓ ^ k : ℕ) • 𝟙 (wcIntUnit Y ℓ)) hmono hnn k
  choose ι t w F1 F2 hS using hk

  have hker : ∀ (k : ℕ) (y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)),
      y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) = 0 →
      ∃ a : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r),
        a.comp (Abelian.Ext.mk₀ (ι k)) (add_zero (2 * r)) = y := by
    intro k y hy
    exact Abelian.Ext.covariant_sequence_exact₂ (wcIntSuppObj Di) (hS k) y hy
  have hsubc : ∀ (k : ℕ) (y y' : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)),
      (y - y').comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) =
        y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) -
          y'.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) := by
    intro k y y'
    rw [eq_sub_iff_add_eq, ← Abelian.Ext.add_comp, sub_add_cancel]

  have hA : ∀ k : ℕ, Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) →
      Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)) ∧
      Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)) ≤
        Nat.card (Set.range (fun y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r) =>
          y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)))) * ℓ := by
    intro k hfk
    haveI := hfk
    haveI := hfin1
    let T := fun y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r) =>
      y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))
    let Φ : Set.range T × Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r) →
        Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r) :=
      fun q => Classical.choose q.1.2 + q.2.comp (Abelian.Ext.mk₀ (ι k)) (add_zero (2 * r))
    have hΦ : Function.Surjective Φ := by
      intro b
      have hTs : T (Classical.choose (⟨T b, b, rfl⟩ : Set.range T).2) = T b :=
        Classical.choose_spec (⟨T b, b, rfl⟩ : Set.range T).2
      have h0 : (b - Classical.choose (⟨T b, b, rfl⟩ : Set.range T).2).comp
          (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) = 0 := by
        rw [hsubc]
        exact sub_eq_zero.mpr hTs.symm
      obtain ⟨a, ha⟩ := hker k _ h0
      refine ⟨(⟨T b, b, rfl⟩, a), ?_⟩
      show Classical.choose (⟨T b, b, rfl⟩ : Set.range T).2 +
        a.comp (Abelian.Ext.mk₀ (ι k)) (add_zero (2 * r)) = b
      rw [ha]
      abel
    haveI : Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r)) :=
      Finite.of_surjective Φ hΦ
    refine ⟨inferInstance, ?_⟩
    calc Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r))
        ≤ Nat.card (Set.range T × Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) :=
          Nat.card_le_card_of_surjective Φ hΦ
      _ = Nat.card (Set.range T) *
            Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ 1) (2 * r)) := Nat.card_prod _ _
      _ ≤ Nat.card (Set.range T) * ℓ := Nat.mul_le_mul_left _ hle1

  have hcard : ∀ k : ℕ, 1 ≤ k →
      Finite (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) ∧
      Nat.card (Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) ≤ ℓ ^ k := by
    intro k hk
    induction k, hk using Nat.le_induction with
    | base => exact ⟨hfin1, by rw [pow_one]; exact hle1⟩
    | succ k hk ih =>
      obtain ⟨hfk, hck⟩ := ih
      haveI := hfk
      obtain ⟨hfk1, hck1⟩ := hA k hfk
      refine ⟨hfk1, ?_⟩
      have hR := Nat.card_le_card_of_injective
        (Subtype.val : Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))) →
          Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) Subtype.val_injective
      calc _ ≤ _ := hck1
        _ ≤ ℓ ^ k * ℓ := Nat.mul_le_mul_right _ (hR.trans hck)
        _ = ℓ ^ (k + 1) := (pow_succ ℓ k).symm

  have hsurj : ∀ k : ℕ, 1 ≤ k →
      ∀ x : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r),
      ∃ y : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (k + 1)) (2 * r),
        y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r)) = x := by
    intro k hk x
    obtain ⟨hfk, hck⟩ := hcard k hk
    haveI := hfk
    obtain ⟨hfk1, hck1⟩ := hA k hfk
    have hg := hge (k + 1) (by omega) hfk1
    have hR := Nat.card_le_card_of_injective
      (Subtype.val : Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))) →
        Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r))
      Subtype.val_injective
    have h1 : ℓ ^ k * ℓ ≤ Nat.card (Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))))
          * ℓ := by
      rw [← pow_succ]; exact hg.trans hck1
    have h2 := Nat.le_of_mul_le_mul_right h1 hℓpos
    have hinj : Function.Injective
      (Subtype.val : Set.range (fun y : Abelian.Ext (wcIntSuppObj Di)
          (wcIntTors Y ℓ (k + 1)) (2 * r) => y.comp (Abelian.Ext.mk₀ (t k)) (add_zero (2 * r))) →
        Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ k) (2 * r)) := Subtype.val_injective
    have hbij := hinj.bijective_of_nat_card_le (hck.trans h2)
    obtain ⟨⟨z, hz⟩, hzx⟩ := hbij.2 x
    obtain ⟨y, hy⟩ := hz
    exact ⟨y, hy.trans hzx⟩

  have hlift : ∀ (mm : ℕ), 1 ≤ mm →
      ∀ a : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ mm) (2 * r),
      ∃ a' : Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (mm + 1)) (2 * r),
        ∀ t' : wcIntTors Y ℓ (mm + 1) ⟶ wcIntTors Y ℓ mm,
          Limits.cokernel.π ((ℓ ^ (mm + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t' =
            Limits.cokernel.π ((ℓ ^ mm : ℕ) • 𝟙 (wcIntUnit Y ℓ)) →
          a'.comp (Abelian.Ext.mk₀ t') (add_zero (2 * r)) = a := by
    intro mm hmm a
    obtain ⟨a', ha'⟩ := hsurj mm hmm a
    refine ⟨a', fun t' ht' => ?_⟩
    have htt : t' = t mm := (cancel_epi _).1 (ht'.trans (F1 mm).symm)
    rw [htt]
    exact ha'
  choose f hf using hlift

  let a : ∀ k : ℕ, Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (1 + k)) (2 * r) :=
    fun k => Nat.rec (motive := fun k =>
      Abelian.Ext (wcIntSuppObj Di) (wcIntTors Y ℓ (1 + k)) (2 * r))
      θ1 (fun k ak => f (1 + k) (by omega) ak) k
  have ha : ∀ (k : ℕ) (t' : wcIntTors Y ℓ (1 + k + 1) ⟶ wcIntTors Y ℓ (1 + k)),
      Limits.cokernel.π ((ℓ ^ (1 + k + 1) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫ t' =
        Limits.cokernel.π ((ℓ ^ (1 + k) : ℕ) • 𝟙 (wcIntUnit Y ℓ)) →
      (a (k + 1)).comp (Abelian.Ext.mk₀ t') (add_zero (2 * r)) = a k := by
    intro k t' ht'
    exact hf (1 + k) (by omega) (a k) t' ht'
  obtain ⟨θz, hθz⟩ := wc_int_ext_tower_milnor Y ℓ (wcIntSuppObj Di) (2 * r) 1 a ha
  exact ⟨θz, hθz 0⟩

theorem wc_int_red_supp_pull_compat {X Y Y' : Scheme.{u}} {i : X ⟶ Y} {f : Y' ⟶ Y} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] (D : wcHMPullData i ℓ) (DΛ : wcIntPullData f ℓ) (q : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)) := HasExt.standard _
    ∃ ν : DΛ.Φ.obj (wcIntTors Y ℓ 1) ⟶ wcIntTors Y' ℓ 1,
      DΛ.Φ.map (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))) ≫ ν =
        DΛ.μ.hom ≫ Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ)) ∧
      ∀ (P' : SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)) (γ : P' ⟶ DΛ.Φ.obj (wcIntSuppObj D))
        (θ : Abelian.Ext (wcIntSuppObj D) (wcIntUnit Y ℓ) q),
        ((Abelian.Ext.mk₀ γ).comp (wcIntSuppPullExt D DΛ q θ) (zero_add _)).comp
            (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ)))) (add_zero _) =
          wcIntSuppRedRestr D DΛ γ ν q
            (θ.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
              (add_zero _)) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)) := HasExt.standard _
  haveI := DΛ.additive
  haveI := DΛ.presLim
  haveI := DΛ.presColim

  have h1 : DΛ.Φ.map ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ)) =
      (ℓ ^ 1 : ℕ) • 𝟙 (DΛ.Φ.obj (wcIntUnit Y ℓ)) := by
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
  have h2 : (ℓ ^ 1 : ℕ) • Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ)) =
      ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ)) ≫
        Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ)) := by
    rw [Preadditive.nsmul_comp, Category.id_comp]
  have w : DΛ.Φ.map ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ)) ≫
      (DΛ.μ.hom ≫ Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ))) = 0 := by
    rw [h1, Preadditive.nsmul_comp, Category.id_comp, ← Preadditive.comp_nsmul, h2,
      Limits.cokernel.condition, Limits.comp_zero]

  obtain ⟨ν, hA⟩ : ∃ ν : DΛ.Φ.obj (wcIntTors Y ℓ 1) ⟶ wcIntTors Y' ℓ 1,
      DΛ.Φ.map (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))) ≫ ν =
        DΛ.μ.hom ≫ Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ)) := by
    refine ⟨(Limits.PreservesCokernel.iso DΛ.Φ ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))).hom ≫
      Limits.cokernel.desc _ _ w, ?_⟩
    have he : DΛ.Φ.map (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))) ≫
        (Limits.PreservesCokernel.iso DΛ.Φ ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))).hom =
        Limits.cokernel.π (DΛ.Φ.map ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))) := by
      rw [← Iso.eq_comp_inv, Limits.PreservesCokernel.iso_inv,
        Limits.π_comp_cokernelComparison]
    rw [← Category.assoc, he, Limits.cokernel.π_desc]
  refine ⟨ν, hA, ?_⟩

  intro P' γ θ
  have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)} (z : Abelian.Ext A B q)
      (a : B ⟶ C') (b : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ a) (add_zero q)).comp (Abelian.Ext.mk₀ b) (add_zero q) =
        z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero q) := by
    intro A B C' D' z a b
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  show ((Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor DΛ.Φ θ).comp
      (Abelian.Ext.mk₀ DΛ.μ.hom) (add_zero q)) (zero_add q)).comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y' ℓ)))) (add_zero q) =
    (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor DΛ.Φ
      (θ.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
        (add_zero q))).comp (Abelian.Ext.mk₀ ν) (add_zero q)) (zero_add q)
  rw [Abelian.Ext.comp_assoc_of_third_deg_zero, e2, Abelian.Ext.mapExactFunctor_comp,
    Abelian.Ext.mapExactFunctor_mk₀, e2, hA]

theorem wc_zmod_supp_unit_epi {X' Y' : Scheme.{u}} (i' : X' ⟶ Y') [IsClosedImmersion i']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D' : wcZModPullData i' ℓ) (hD' : wcZModPullCanonical D') :
    Epi (wcZModSuppUnitMap D') :=
by
  classical
  let σ : ∀ V : Y'.ProEt, C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)) := fun V =>
    ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
  let ρf : ∀ V : Y'.ProEt, C(↥V.left, ULift.{u+1} (ZMod ℓ)) →
      C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)) := fun V t =>
    ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom t

  have hunit : ∀ V : Y'.ProEt, ∃ c : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)),
      σ V * c = 1 := by
    intro V
    letI := D'.cont
    let u := SheafOfModules.unitToPushforwardObjUnit D'.φ
    let ψ₁ := (D'.adj.homEquiv _ _).symm u
    let h : SheafOfModules.unit (wcZModRingSheaf X' ℓ) ⟶ SheafOfModules.unit (wcZModRingSheaf X' ℓ) :=
      D'.μ.inv ≫ ψ₁
    have hfac : u = wcZModSuppUnitMap D' ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i') _ _ D'.cont D'.φ).map h := by
      have e1 : D'.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u = D'.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = D'.adj.homEquiv _ _ (D'.μ.hom ≫ h) := by rw [e1]
        _ = D'.adj.homEquiv _ _ D'.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i') _ _ D'.cont D'.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcZModSuppUnitMap D' ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i') _ _ D'.cont D'.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let cV : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)) :=
      ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
    let a : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)) :=
      (h.val.app (Opposite.op ((wcProEtBC i').obj V))).hom
        (1 : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)))
    have hu1 : (u.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ))) =
        (1 : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ))) :=
      (D'.φ.hom.app (Opposite.op V)).hom.map_one
    have hev : (u.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ))) =
        (h.val.app (Opposite.op ((wcProEtBC i').obj V))).hom cV := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)),
        (h.val.app (Opposite.op ((wcProEtBC i').obj V))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC i').obj V))).hom.map_smul x
        (1 : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC i').obj V))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC i').obj V))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC i').obj V))).hom y) (mul_one x).symm
      exact e2.trans e
    have key : cV * a = 1 := by
      rw [← hlin cV, ← hev, hu1]
    exact ⟨a, key⟩

  have hlinρ : ∀ (V : Y'.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod ℓ))),
      ρf V t = t.comp (Limits.pullback.fst V.hom i').base.hom * σ V := by
    intro V t
    let mt : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)) := ρf V t
    let φt : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)) :=
      (D'.φ.hom.app (Opposite.op V)).hom t
    have hφ : φt = t.comp (Limits.pullback.fst V.hom i').base.hom := hD' V t
    have h := ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom.map_smul t
      (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
    let mt1 : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod ℓ)) :=
      ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom (t * 1)
    have h' : mt1 = φt * σ V := h
    rw [hφ] at h'
    have h0 : mt1 = mt :=
      congrArg (fun x => ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom x) (mul_one t)
    exact h0.symm.trans h'

  haveI : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩
  let r₀ : ℚ_[ℓ] → ZMod ℓ := fun q =>
    if hq : ‖q‖ ≤ 1 then PadicInt.toZMod (Subtype.mk q hq : ℤ_[ℓ]) else 0
  have hA : ∀ q q' : ℚ_[ℓ], ‖q' - q‖ < 1 → r₀ q' = r₀ q := by
    intro q q' hqq
    by_cases hq : ‖q‖ ≤ 1
    · have hq' : ‖q'‖ ≤ 1 := by
        have h1 := Padic.nonarchimedean (q' - q) q
        rw [sub_add_cancel] at h1
        exact h1.trans (max_le hqq.le hq)
      let z' : ℤ_[ℓ] := ⟨q', hq'⟩
      let z : ℤ_[ℓ] := ⟨q, hq⟩
      have hmem : z' - z ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] := by
        rw [IsLocalRing.mem_maximalIdeal, PadicInt.mem_nonunits, PadicInt.norm_def,
          PadicInt.coe_sub]
        exact hqq
      rw [← PadicInt.ker_toZMod, RingHom.mem_ker, map_sub, sub_eq_zero] at hmem
      simp only [r₀, dif_pos hq, dif_pos hq']
      exact hmem
    · have hq' : ¬ ‖q'‖ ≤ 1 := by
        intro hq'
        apply hq
        have h1 := Padic.nonarchimedean (q - q') q'
        rw [sub_add_cancel] at h1
        exact h1.trans (max_le (by rw [norm_sub_rev]; exact hqq.le) hq')
      simp only [r₀, dif_neg hq, dif_neg hq']
  have hr₀ : Continuous r₀ := by
    apply IsLocallyConstant.continuous
    rw [IsLocallyConstant.iff_eventually_eq]
    intro q
    filter_upwards [Metric.ball_mem_nhds q one_pos] with q' hq'
    apply hA
    rw [Metric.mem_ball, dist_eq_norm] at hq'
    exact hq'
  have hB : ∀ a : ZMod ℓ, r₀ ((a.val : ℕ) : ℚ_[ℓ]) = a := by
    intro a
    have e : ((a.val : ℕ) : ℚ_[ℓ]) = (((a.val : ℕ) : ℤ_[ℓ]) : ℚ_[ℓ]) :=
      (PadicInt.coe_natCast _).symm
    have hn : ‖((a.val : ℕ) : ℚ_[ℓ])‖ ≤ 1 := by
      rw [e]
      exact PadicInt.norm_le_one _
    simp only [r₀, dif_pos hn]
    have e2 : @Eq ℤ_[ℓ] ⟨((a.val : ℕ) : ℚ_[ℓ]), hn⟩ ((a.val : ℕ) : ℤ_[ℓ]) :=
      Subtype.ext e
    rw [e2, map_natCast, ZMod.natCast_zmod_val]
  let r : C(ULift.{u+1} ℚ_[ℓ], ULift.{u+1} (ZMod ℓ)) :=
    ⟨fun q => ULift.up (r₀ q.down), continuous_uliftUp.comp (hr₀.comp continuous_uliftDown)⟩
  let ι : C(ULift.{u+1} (ZMod ℓ), ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun a => ULift.up ((a.down.val : ℕ) : ℚ_[ℓ]),
      continuous_uliftUp.comp ((continuous_of_discreteTopology
        (f := fun a : ZMod ℓ => ((a.val : ℕ) : ℚ_[ℓ]))).comp continuous_uliftDown)⟩
  have hrι : ∀ a : ULift.{u+1} (ZMod ℓ), r (ι a) = a := by
    intro a
    show ULift.up (r₀ ((a.down.val : ℕ) : ℚ_[ℓ])) = a
    rw [hB]

  have : (SheafOfModules.toSheaf (wcZModRingSheaf Y' ℓ)).ReflectsEpimorphisms :=
    Functor.reflectsEpimorphisms_of_faithful _
  apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcZModRingSheaf Y' ℓ))
  apply wc_proet_epi_of_affine_lift Y'
  intro U hU y
  let y' : C(↥(Limits.pullback U.hom i'), ULift.{u+1} (ZMod ℓ)) := y
  obtain ⟨c, hc⟩ := hunit U

  obtain ⟨W, g, t, hW, hg, ht⟩ := wc_fibre_function_local_extension i' ℓ U hU (ι.comp (y' * c))
  refine ⟨W, g, r.comp t, hW, hg, ?_⟩
  change ρf W (r.comp t) = y'.comp ((wcProEtBC i').map g).left.base.hom
  have hnat : σ W = (σ U).comp ((wcProEtBC i').map g).left.base.hom :=
    PresheafOfModules.naturality_apply (wcZModSuppUnitMap D').val g.op
      (1 : C(↥U.left, ULift.{u+1} (ZMod ℓ)))
  rw [hlinρ W (r.comp t), hnat]
  refine ContinuousMap.ext fun w => ?_
  have e1 : t ((Limits.pullback.fst W.hom i').base.hom w) =
      ι ((y' * c) (((wcProEtBC i').map g).left.base.hom w)) :=
    congrArg (fun φ => φ w) ht
  have e2 : σ U (((wcProEtBC i').map g).left.base.hom w) *
      c (((wcProEtBC i').map g).left.base.hom w) = 1 :=
    congrArg (fun φ => φ (((wcProEtBC i').map g).left.base.hom w)) hc
  show r (t ((Limits.pullback.fst W.hom i').base.hom w)) *
      σ U (((wcProEtBC i').map g).left.base.hom w) =
    y' (((wcProEtBC i').map g).left.base.hom w)
  rw [e1, hrι]
  show y' (((wcProEtBC i').map g).left.base.hom w) * c (((wcProEtBC i').map g).left.base.hom w) *
      σ U (((wcProEtBC i').map g).left.base.hom w) =
    y' (((wcProEtBC i').map g).left.base.hom w)
  linear_combination (y' (((wcProEtBC i').map g).left.base.hom w)) * e2

theorem wc_zmod_supp_kernel_kill {X Y Y' X' : Scheme.{u}} {n : ℕ} (i : X ⟶ Y) [IsClosedImmersion i]
    (f : Y' ⟶ Y) (i' : X' ⟶ Y') (g : X' ⟶ X) (hP : IsPullback g i' i f)
    (D : wcZModPullData i n) (Df : wcZModPullData f n) (D' : wcZModPullData i' n)
    (hD' : wcZModPullCanonical D') :
    Limits.kernel.ι (wcZModSuppUnitMap D') ≫ Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D) = 0 :=
by
  classical

  have clop : ∀ (Xa : Scheme.{u}) [IsAffine Xa] (U : Set Xa), IsClopen U →
      ∃ e : Γ(Xa, ⊤), (Xa.basicOpen e : Set Xa) = U := by
    intro Xa _ U hU
    let V : Set (PrimeSpectrum Γ(Xa, ⊤)) := (Xa.isoSpec.inv : Spec Γ(Xa, ⊤) ⟶ Xa) ⁻¹' U
    have hV : IsClopen V := hU.preimage (Xa.isoSpec.inv).continuous
    let e₀ := (PrimeSpectrum.isIdempotentElemEquivClopens (R := Γ(Xa, ⊤))).symm ⟨V, hV⟩
    have hBV : (PrimeSpectrum.basicOpen (e₀ : Γ(Xa, ⊤)) : Set (PrimeSpectrum Γ(Xa, ⊤))) = V := by
      rw [← PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens]
      simp [e₀]
    refine ⟨(e₀ : Γ(Xa, ⊤)), ?_⟩
    rw [← Scheme.toSpecΓ_preimage_basicOpen]
    ext x
    change Xa.toSpecΓ x ∈ (PrimeSpectrum.basicOpen (e₀ : Γ(Xa, ⊤)) : Set (PrimeSpectrum Γ(Xa, ⊤))) ↔
      x ∈ U
    rw [hBV]
    change Xa.isoSpec.inv (Xa.toSpecΓ x) ∈ U ↔ x ∈ U
    rw [← Scheme.isoSpec_hom, Scheme.hom_inv_apply]

  have sep : ∀ {S : Scheme.{u}} {R : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}}
      (M : SheafOfModules.{u+1} R) (V : S.ProEt) (m : M.val.obj (Opposite.op V))
      (_ : ∀ (W : S.ProEt) (g : W ⟶ V), IsAffine W.left →
        ∃ (n : ℕ) (W' : Fin n → S.ProEt) (e : ∀ k, W' k ⟶ W),
          (∀ k, IsAffine (W' k).left) ∧ (∀ x : ↥W.left, ∃ k, x ∈ Set.range (e k).left) ∧
          ∀ k, (M.val.map (e k ≫ g).op).hom m = 0), m = 0 := by
    intro S R M V m h
    have fin_covers : ∀ (U : S.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → S.ProEt)
        (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
        (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
        Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S U := by
      intro U _ n W h hA hJ
      have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
        intro x
        obtain ⟨j, y, hy⟩ := hJ x
        exact ⟨j, y, hy⟩
      have hq : ∀ i, QuasiCompact (h i).left := fun i => by
        haveI := hA i
        exact quasiCompact_of_compactSpace _
      have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
        have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
          rw [MorphismProperty.Over.w (h i)]
          exact (W i).prop
        haveI := U.prop
        exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
      have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
          Scheme.proetalePrecoverage.coverings U.left :=
        ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
          (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
            hs (fun _ => trivial)) _ hq
            (inferInstanceAs (Finite (Fin n)))),
          (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
            ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
      exact Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
    have affine_local : ∀ (U : S.ProEt) (T : Sieve U),
        (∀ (V : S.ProEt) (f : V ⟶ U), IsAffine V.left → T.pullback f ∈ Scheme.ProEt.topology S V) →
        T ∈ Scheme.ProEt.topology S U := by
      intro U T hT
      have hU : WeaklyEtale U.hom := U.prop
      let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
        MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
      let e : ∀ i, W i ⟶ U := fun i =>
        MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
      have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
        show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
          Scheme.proetalePrecoverage).coverings U
        rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
        change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
        exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
          U.left.affineCover.mem₀.1,
          MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
      refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
      intro Y f hf
      obtain ⟨Y', h, g', hg', rfl⟩ := hf
      rcases hg' with ⟨i⟩
      rw [Sieve.pullback_comp]
      exact GrothendieckTopology.pullback_stable _ h
        (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
    let T0 : Sieve V :=
      { arrows := fun _ f => (M.val.map f.op).hom m = 0
        downward_closed := by
          intro Y Z f hf g
          have hf' : (M.val.map f.op).hom m = 0 := hf
          show (M.val.map (g ≫ f).op).hom m = 0
          rw [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, hf',
            map_zero] }
    have hT0 : T0 ∈ Scheme.ProEt.topology S V := by
      apply affine_local V T0
      intro W f hW
      obtain ⟨n, W', e, haff, hsurj, hzero⟩ := h W f hW
      haveI : IsAffine W.left := hW
      refine GrothendieckTopology.superset_covering _ ?_
        (fin_covers W n W' e haff hsurj)
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨k⟩
      show (M.val.map (e k ≫ f).op).hom m = 0
      exact hzero k
    refine M.isSheaf.isSeparated V T0 hT0 m (0 : M.val.obj (Opposite.op V)) ?_
    intro Y f hf
    have hf' : (M.val.map f.op).hom m = 0 := hf
    change (M.val.map f.op).hom m = (M.val.map f.op).hom 0
    rw [map_zero]
    exact hf'

  have twist : ∀ {S S' : Scheme.{u}} {q : S' ⟶ S} (Dq : wcZModPullData q n) (V : S.ProEt)
      (cV0 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n))),
      cV0 = ((wcZModSuppUnitMap Dq).val.app (Opposite.op V)).hom
        (1 : C(↥V.left, ULift.{u+1} (ZMod n))) →
      ∃ c : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n)), cV0 * c = 1 := by
    intro S S' q Dq V cV0 hcV0
    letI := Dq.cont
    let u0 := SheafOfModules.unitToPushforwardObjUnit Dq.φ
    let ψ₁ := (Dq.adj.homEquiv _ _).symm u0
    let h : SheafOfModules.unit (wcZModRingSheaf S' n) ⟶ SheafOfModules.unit (wcZModRingSheaf S' n) :=
      Dq.μ.inv ≫ ψ₁
    have hfac : u0 = wcZModSuppUnitMap Dq ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map h := by
      have e1 : Dq.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u0 = Dq.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = Dq.adj.homEquiv _ _ (Dq.μ.hom ≫ h) := by rw [e1]
        _ = Dq.adj.homEquiv _ _ Dq.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcZModSuppUnitMap Dq ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let cV : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap Dq).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n)))
    let a : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n)) :=
      (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom
        (1 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n)))
    have hu1 : (u0.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n))) =
        (1 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n))) :=
      (Dq.φ.hom.app (Opposite.op V)).hom.map_one
    have hev : (u0.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n))) =
        (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom cV := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n)),
        (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom.map_smul x
        (1 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod n)))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom y) (mul_one x).symm
      exact e2.trans e
    have hcv : cV0 = cV := hcV0
    refine ⟨a, ?_⟩
    rw [hcv]
    exact (hlin cV).symm.trans (hev.symm.trans hu1)

  have formula : ∀ (V : Y'.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod n)))
      (m1 mt : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n))),
      m1 = ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom
        (1 : C(↥V.left, ULift.{u+1} (ZMod n))) →
      mt = ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom t →
      mt = t.comp (Limits.pullback.fst V.hom i').base.hom * m1 := by
    intro V t m1 mt hm1 hmt
    let m1' : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n)))
    let mt' : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom t
    let φt : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n)) :=
      (D'.φ.hom.app (Opposite.op V)).hom t
    have hφ : φt = t.comp (Limits.pullback.fst V.hom i').base.hom := hD' V t
    have hm1' : m1 = m1' := hm1
    have hmt' : mt = mt' := hmt
    rw [hm1', hmt']
    have h := ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom.map_smul t
      (1 : C(↥V.left, ULift.{u+1} (ZMod n)))
    have h' : (((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom (t * 1) :
          C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n))) = φt * m1' := h
    rw [hφ] at h'
    have h0 : (((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom
          (t * 1 : C(↥V.left, ULift.{u+1} (ZMod n))) :
        C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n))) = mt' :=
      congrArg (fun x => ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom x) (mul_one t)
    exact h0.symm.trans h'

  have hrange : ∀ y : ↥Y', f y ∈ Set.range i → y ∈ Set.range i' := by
    intro y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst f i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨w, rfl⟩ := hy'
    refine ⟨hP.flip.isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, hP.flip.isoPullback_inv_fst]

  have voff : ∀ (V : Y'.ProEt), (∀ x : ↥V.left, f (V.hom x) ∉ Set.range i) →
      ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app (Opposite.op V)).hom
        (1 : C(↥V.left, ULift.{u+1} (ZMod n))) = 0 := by
    intro V hV
    letI := Df.cont
    let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    let U : Y.ProEt := MorphismProperty.Over.mk ⊤ O.ι inferInstance
    have hU : ∀ x : ↥U.left, U.hom x ∉ Set.range i := by
      intro x
      have hx : O.ι x ∈ (O : Set Y) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
      exact hx
    have hVO : Set.range (V.hom ≫ f) ⊆ Set.range O.ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      refine fun hx => hV x ?_
      rw [← Scheme.Hom.comp_apply]
      exact hx
    let l := IsOpenImmersion.lift O.ι (V.hom ≫ f) hVO
    have hl : l ≫ O.ι = V.hom ≫ f := IsOpenImmersion.lift_fac _ _ _
    let p : V.left ⟶ Limits.pullback U.hom f := Limits.pullback.lift l V.hom hl
    have hp : p ≫ Limits.pullback.snd U.hom f = V.hom := Limits.pullback.lift_snd l V.hom hl
    let af : V ⟶ (wcProEtBC f).obj U := MorphismProperty.Over.homMk p hp trivial
    have htr : wcZModSuppUnitMap Df ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ).map
          (Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)) =
        wcZModSuppUnitMap D ≫ Df.adj.unit.app (wcZModSuppObj D) := by
      have e1 : wcZModSuppUnitMap Df = Df.adj.homEquiv _ _ Df.μ.hom := by
        rw [Adjunction.homEquiv_unit]; rfl
      rw [e1]
      refine (Adjunction.homEquiv_naturality_right _ _ _).symm.trans ?_
      rw [Iso.hom_inv_id_assoc, Adjunction.homEquiv_unit]
      exact Df.adj.unit_naturality (wcZModSuppUnitMap D)
    let c : C(↥(Limits.pullback U.hom f), ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap Df).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} (ZMod n)))
    obtain ⟨a, key'⟩ := twist Df U c rfl
    have hz : ((wcZModSuppUnitMap D).val.app (Opposite.op U)).hom
        (1 : C(↥U.left, ULift.{u+1} (ZMod n))) = 0 := by
      have hempty : ∀ z : ↥(Limits.pullback U.hom i), False := by
        intro z
        have e : (Limits.pullback.fst U.hom i ≫ U.hom) z =
            (Limits.pullback.snd U.hom i ≫ i) z := by
          rw [Limits.pullback.condition]
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
        exact hU (Limits.pullback.fst U.hom i z) ⟨Limits.pullback.snd U.hom i z, e.symm⟩
      change (((wcZModSuppUnitMap D).val.app (Opposite.op U)).hom
          (1 : C(↥U.left, ULift.{u+1} (ZMod n))) :
        C(↥(Limits.pullback U.hom i), ULift.{u+1} (ZMod n))) = 0
      exact ContinuousMap.ext (fun z => (hempty z).elim)
    have hT : ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
          (Opposite.op ((wcProEtBC f).obj U))).hom c =
        ((Df.adj.unit.app (wcZModSuppObj D)).val.app (Opposite.op U)).hom
          (((wcZModSuppUnitMap D).val.app (Opposite.op U)).hom
            (1 : C(↥U.left, ULift.{u+1} (ZMod n)))) :=
      congrArg (fun φ => (φ.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} (ZMod n)))) htr
    have hvc : ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
          (Opposite.op ((wcProEtBC f).obj U))).hom c = 0 := by
      rw [hT, hz]
      exact map_zero _
    have hW1 : ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
          (Opposite.op ((wcProEtBC f).obj U))).hom
        (1 : C(↥(Limits.pullback U.hom f), ULift.{u+1} (ZMod n))) = 0 := by
      have e1 : (1 : C(↥(Limits.pullback U.hom f), ULift.{u+1} (ZMod n))) = a * c := by
        rw [mul_comm, key']
      have e2 : ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
            (Opposite.op ((wcProEtBC f).obj U))).hom
          (1 : C(↥(Limits.pullback U.hom f), ULift.{u+1} (ZMod n))) =
          ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
            (Opposite.op ((wcProEtBC f).obj U))).hom (a * c) :=
        congrArg (fun y => ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
            (Opposite.op ((wcProEtBC f).obj U))).hom y) e1
      have hsm := ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
            (Opposite.op ((wcProEtBC f).obj U))).hom.map_smul a c
      refine (e2.trans hsm).trans ?_
      rw [hvc]
      exact smul_zero _
    have h1 : ((SheafOfModules.unit (wcZModRingSheaf Y' n)).val.map af.op).hom
        (1 : C(↥(Limits.pullback U.hom f), ULift.{u+1} (ZMod n))) =
        (1 : C(↥V.left, ULift.{u+1} (ZMod n))) := by
      change (1 : C(↥(Limits.pullback U.hom f), ULift.{u+1} (ZMod n))).comp af.left.base.hom = 1
      exact ContinuousMap.one_comp _
    refine (congrArg (fun y => ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
      (Opposite.op V)).hom y) h1.symm).trans ?_
    refine (PresheafOfModules.naturality_apply
      (Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val af.op _).trans ?_
    exact (congrArg (fun y => ((Df.Φ.obj (wcZModSuppObj D)).val.map af.op).hom y) hW1).trans
      (map_zero _)

  have vanish : ∀ (V : Y'.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod n))),
      ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom t = 0 →
      ∀ y : ↥V.left, V.hom y ∈ Set.range i' → t y = 0 := by
    intro V t h0 y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst V.hom i') := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    let s : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod n)))
    let mt : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n)) :=
      ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom t
    have hmt0 : mt = 0 := h0
    obtain ⟨c, hc⟩ := twist D' V s rfl
    have htw := formula V t s mt rfl rfl
    rw [hmt0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n)) => φ z) htw
    have h2 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i'), ULift.{u+1} (ZMod n)) => φ z) hc
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply, ContinuousMap.zero_apply] at h1 h2
    show t ((Limits.pullback.fst V.hom i').base.hom z) = 0
    linear_combination (-(c z)) * h1 - (t ((Limits.pullback.fst V.hom i').base.hom z)) * h2

  have key : ∀ (V : Y'.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod n))),
      (∀ y : ↥V.left, V.hom y ∈ Set.range i' → t y = 0) →
      ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app (Opposite.op V)).hom t = 0 := by
    intro V t ht
    apply sep (Df.Φ.obj (wcZModSuppObj D)) V
    intro W gW hWaff
    haveI : IsAffine W.left := hWaff
    haveI : WeaklyEtale W.hom := W.prop
    have htW : ∀ w : ↥W.left, W.hom w ∈ Set.range i' → (t.comp gW.left.base.hom) w = 0 := by
      intro w hw
      apply ht
      have e : V.hom (gW.left w) = W.hom w := by
        rw [← MorphismProperty.Over.w gW]; rfl
      rw [e]; exact hw
    let τ : C(↥W.left, ULift.{u+1} (ZMod n)) := t.comp gW.left.base.hom
    have hA : IsClopen (τ ⁻¹' {0}) := (isClopen_discrete {0}).preimage τ.continuous
    obtain ⟨e₀, he₀⟩ := clop W.left (τ ⁻¹' {0}) hA
    obtain ⟨e₁, he₁⟩ := clop W.left (τ ⁻¹' {0})ᶜ hA.compl
    let ε : Fin 2 → Γ(W.left, ⊤) := ![e₀, e₁]
    let W' : Fin 2 → Y'.ProEt := fun k =>
      MorphismProperty.Over.mk ⊤ ((W.left.basicOpen (ε k)).ι ≫ W.hom) inferInstance
    let e : ∀ k, W' k ⟶ W := fun k =>
      MorphismProperty.Over.homMk (W.left.basicOpen (ε k)).ι rfl trivial
    refine ⟨2, W', e, fun k => (isAffineOpen_top W.left).basicOpen (ε k), ?_, ?_⟩
    · intro x
      by_cases hx : τ x = 0
      · refine ⟨0, ?_⟩
        show x ∈ Set.range (W.left.basicOpen e₀).ι
        rw [Scheme.Opens.range_ι, he₀]
        exact hx
      · refine ⟨1, ?_⟩
        show x ∈ Set.range (W.left.basicOpen e₁).ι
        rw [Scheme.Opens.range_ι, he₁]
        exact hx
    · intro k
      refine (PresheafOfModules.naturality_apply
        (Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val (e k ≫ gW).op t).symm.trans ?_
      fin_cases k
      · have h0 : (t.comp ((e 0 ≫ gW).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} (ZMod n))) =
            0 := by
          refine ContinuousMap.ext fun w => ?_
          have hw : (W.left.basicOpen e₀).ι w ∈ (W.left.basicOpen e₀ : Set ↥W.left) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨w, rfl⟩
          rw [he₀] at hw
          rw [ContinuousMap.zero_apply]
          exact hw
        change ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app (Opposite.op (W' 0))).hom
          (t.comp ((e 0 ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
          (Opposite.op (W' 0))).hom s) h0).trans ?_
        exact map_zero _
      · have hV1 : ∀ x : ↥(W' 1).left, f ((W' 1).hom x) ∉ Set.range i := by
          intro x hx
          have hι : (W.left.basicOpen e₁).ι x ∈ (W.left.basicOpen e₁ : Set ↥W.left) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
          rw [he₁] at hι
          have hc : (W' 1).hom x = W.hom ((W.left.basicOpen e₁).ι x) :=
            Scheme.Hom.comp_apply _ _ _
          have hr : W.hom ((W.left.basicOpen e₁).ι x) ∈ Set.range i' := by
            rw [← hc]; exact hrange _ hx
          exact hι (show τ ((W.left.basicOpen e₁).ι x) = 0 from htW _ hr)
        have hs4 := voff (W' 1) hV1
        have hsm := ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
          (Opposite.op (W' 1))).hom.map_smul (t.comp ((e 1 ≫ gW).left.base.hom))
          (1 : C(↥(W' 1).left, ULift.{u+1} (ZMod n)))
        change ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app (Opposite.op (W' 1))).hom
          (t.comp ((e 1 ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app
          (Opposite.op (W' 1))).hom s)
          (mul_one (t.comp ((e 1 ≫ gW).left.base.hom))).symm).trans ?_
        refine hsm.trans ?_
        rw [hs4]
        exact smul_zero _

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  induction X using Opposite.rec with
  | op V =>
  have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom x)
    (Limits.kernel.condition (wcZModSuppUnitMap D'))
  change ((wcZModSuppUnitMap D').val.app (Opposite.op V)).hom
    (((Limits.kernel.ι (wcZModSuppUnitMap D')).val.app (Opposite.op V)).hom x) = 0 at hk
  change ((Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)).val.app (Opposite.op V)).hom
    (((Limits.kernel.ι (wcZModSuppUnitMap D')).val.app (Opposite.op V)).hom x) = 0
  exact key V _ (vanish V _ hk)

theorem wc_zmod_closed_supp_base_change {X Y Y' X' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) (i' : X' ⟶ Y') (g : X' ⟶ X)
    (hP : IsPullback g i' i f) (D : wcZModPullData i ℓ) (hD : wcZModPullCanonical D)
    (Df : wcZModPullData f ℓ) (hDf : wcZModPullCanonical Df)
    (D' : wcZModPullData i' ℓ) (hD' : wcZModPullCanonical D') :
    ∃ γ : wcZModSuppObj D' ⟶ Df.Φ.obj (wcZModSuppObj D),
      wcZModSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D) :=
by
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP ‹IsClosedImmersion i›
  haveI hE : Epi (wcZModSuppUnitMap D') := wc_zmod_supp_unit_epi i' ℓ D' hD'
  have hK := wc_zmod_supp_kernel_kill i f i' g hP D Df D' hD'
  exact ⟨Abelian.epiDesc (wcZModSuppUnitMap D') (Df.μ.inv ≫ Df.Φ.map (wcZModSuppUnitMap D)) hK,
    Abelian.comp_epiDesc _ _ _⟩

theorem wc_zmod_et_supp_obj_iso : ∀ {X S : Scheme.{u}} (i : X ⟶ S) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : SheafOfModules.{u+1} (wcEtZModRing S ℓ) ⥤ SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) [N.Additive] [Limits.PreservesFiniteLimits N] [Limits.PreservesFiniteColimits N] (e : N.obj (SheafOfModules.unit (wcEtZModRing S ℓ)) ≅ SheafOfModules.unit (wcZModRingSheaf S ℓ)), Nonempty (N ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ) ≅ SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ) ⋙ wcEpsInv S) → ∀ (Dz : wcZModPullData i ℓ), wcZModPullCanonical Dz → ∀ (De : wcEtPullData i ℓ), ∃ σ : wcZModSuppObj Dz ⟶ N.obj (wcEtSuppObj De), IsIso σ ∧ wcZModSuppUnitMap Dz ≫ σ = e.inv ≫ N.map (wcEtSuppUnitMap De) :=
by
  classical
  intro X S i _ ℓ _ N _ _ _ e hθ Dz hDz De
  obtain ⟨θ⟩ := hθ
  obtain ⟨_, hcont⟩ := wc_etToProEt_flat_cont S
  haveI := hcont
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  obtain ⟨w, hw⟩ : ∃ w : SheafOfModules.unit (wcZModRingSheaf S ℓ) ⟶ N.obj (wcEtSuppObj De),
      w = e.inv ≫ N.map (wcEtSuppUnitMap De) := ⟨_, rfl⟩

  haveI hbE : Epi (wcZModSuppUnitMap Dz) := wc_zmod_supp_unit_epi i ℓ Dz hDz
  haveI : Epi (wcEtSuppUnitMap De) := wc_et_supp_unit_epi i De
  haveI : N.PreservesEpimorphisms := by
    first
      | infer_instance
      | exact CategoryTheory.preservesEpimorphisms_of_preservesColimitsOfShape _
  haveI hwE : Epi w := by rw [hw]; infer_instance

  let O : S.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let Uet : S.Etale := MorphismProperty.Over.mk ⊤ O.ι inferInstance
  have hUet : ∀ x : ↥Uet.left, Uet.hom x ∉ Set.range i := by
    intro x
    have hx : O.ι x ∈ (O : Set S) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
    exact hx

  have hsubN : Subsingleton
      ↑((N.obj (wcEtSuppObj De)).val.obj (Opposite.op ((wcEtToProEt S).obj Uet))) := by
    have hE : Subsingleton ↑((wcEtSuppObj De).val.obj (Opposite.op Uet)) :=
      wc_et_closed_supp_obj_vanish i ℓ De Uet hUet
    let G := (SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ)).obj (wcEtSuppObj De)
    haveI hη : IsIso (adj.unit.app G) := wc_epsInv_unit_iso S G
    let ηU := ((sheafToPresheaf _ _).mapIso (asIso (adj.unit.app G))).app (Opposite.op Uet)
    have h2 := @Function.Surjective.subsingleton _ _ _ hE ηU.addCommGroupIsoToAddEquiv.surjective
    let θU := ((sheafToPresheaf _ _).mapIso (θ.app (wcEtSuppObj De))).app
      (Opposite.op ((wcEtToProEt S).obj Uet))
    exact @Function.Injective.subsingleton _ _ _ θU.addCommGroupIsoToAddEquiv.injective h2

  have hvoff : ∀ T : S.ProEt, (∀ x : ↥T.left, T.hom x ∉ Set.range i) →
      (w.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} (ZMod ℓ))) = 0 := by
    intro T hT
    have hTO : Set.range T.hom ⊆ Set.range O.ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact hT x
    let l := IsOpenImmersion.lift O.ι T.hom hTO
    have hl : l ≫ O.ι = T.hom := IsOpenImmersion.lift_fac _ _ _
    let g : T ⟶ (wcEtToProEt S).obj Uet := MorphismProperty.Over.homMk l hl trivial
    have h1 : ((SheafOfModules.unit (wcZModRingSheaf S ℓ)).val.map g.op).hom
        (1 : C(↥((wcEtToProEt S).obj Uet).left, ULift.{u+1} (ZMod ℓ))) =
        (1 : C(↥T.left, ULift.{u+1} (ZMod ℓ))) := by
      change (1 : C(↥((wcEtToProEt S).obj Uet).left, ULift.{u+1} (ZMod ℓ))).comp
        g.left.base.hom = 1
      exact ContinuousMap.one_comp _
    have hz : (w.val.app (Opposite.op ((wcEtToProEt S).obj Uet))).hom
        (1 : C(↥((wcEtToProEt S).obj Uet).left, ULift.{u+1} (ZMod ℓ))) = 0 :=
      @Subsingleton.elim _ hsubN _ _
    refine (congrArg (fun y => (w.val.app (Opposite.op T)).hom y) h1.symm).trans ?_
    refine (PresheafOfModules.naturality_apply w.val g.op _).trans ?_
    exact (congrArg (fun y => ((N.obj (wcEtSuppObj De)).val.map g.op).hom y) hz).trans
      (map_zero _)

  have clop : ∀ (Xa : Scheme.{u}) [IsAffine Xa] (U : Set Xa), IsClopen U →
      ∃ e : Γ(Xa, ⊤), (Xa.basicOpen e : Set Xa) = U := by
    intro Xa _ U hU
    let V : Set (PrimeSpectrum Γ(Xa, ⊤)) := (Xa.isoSpec.inv : Spec Γ(Xa, ⊤) ⟶ Xa) ⁻¹' U
    have hV : IsClopen V := hU.preimage (Xa.isoSpec.inv).continuous
    let e₀ := (PrimeSpectrum.isIdempotentElemEquivClopens (R := Γ(Xa, ⊤))).symm ⟨V, hV⟩
    have hBV : (PrimeSpectrum.basicOpen (e₀ : Γ(Xa, ⊤)) : Set (PrimeSpectrum Γ(Xa, ⊤))) = V := by
      rw [← PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens]
      simp [e₀]
    refine ⟨(e₀ : Γ(Xa, ⊤)), ?_⟩
    rw [← Scheme.toSpecΓ_preimage_basicOpen]
    ext x
    change Xa.toSpecΓ x ∈ (PrimeSpectrum.basicOpen (e₀ : Γ(Xa, ⊤)) : Set (PrimeSpectrum Γ(Xa, ⊤))) ↔
      x ∈ U
    rw [hBV]
    change Xa.isoSpec.inv (Xa.toSpecΓ x) ∈ U ↔ x ∈ U
    rw [← Scheme.isoSpec_hom, Scheme.hom_inv_apply]
  have sep : ∀ {S : Scheme.{u}} {R : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}}
      (M : SheafOfModules.{u+1} R) (V : S.ProEt) (m : M.val.obj (Opposite.op V))
      (_ : ∀ (W : S.ProEt) (g : W ⟶ V), IsAffine W.left →
        ∃ (n : ℕ) (W' : Fin n → S.ProEt) (e : ∀ k, W' k ⟶ W),
          (∀ k, IsAffine (W' k).left) ∧ (∀ x : ↥W.left, ∃ k, x ∈ Set.range (e k).left) ∧
          ∀ k, (M.val.map (e k ≫ g).op).hom m = 0), m = 0 := by
    intro S R M V m h
    have fin_covers : ∀ (U : S.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → S.ProEt)
        (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
        (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
        Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S U := by
      intro U _ n W h hA hJ
      have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
        intro x
        obtain ⟨j, y, hy⟩ := hJ x
        exact ⟨j, y, hy⟩
      have hq : ∀ i, QuasiCompact (h i).left := fun i => by
        haveI := hA i
        exact quasiCompact_of_compactSpace _
      have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
        have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
          rw [MorphismProperty.Over.w (h i)]
          exact (W i).prop
        haveI := U.prop
        exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
      have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
          Scheme.proetalePrecoverage.coverings U.left :=
        ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
          (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
            hs (fun _ => trivial)) _ hq
            (inferInstanceAs (Finite (Fin n)))),
          (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
            ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
      exact Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
    have affine_local : ∀ (U : S.ProEt) (T : Sieve U),
        (∀ (V : S.ProEt) (f : V ⟶ U), IsAffine V.left → T.pullback f ∈ Scheme.ProEt.topology S V) →
        T ∈ Scheme.ProEt.topology S U := by
      intro U T hT
      have hU : WeaklyEtale U.hom := U.prop
      let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
        MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
      let e : ∀ i, W i ⟶ U := fun i =>
        MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
      have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
        show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
          Scheme.proetalePrecoverage).coverings U
        rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
        change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
        exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
          U.left.affineCover.mem₀.1,
          MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
      refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
      intro Y f hf
      obtain ⟨Y', h, g', hg', rfl⟩ := hf
      rcases hg' with ⟨i⟩
      rw [Sieve.pullback_comp]
      exact GrothendieckTopology.pullback_stable _ h
        (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
    let T0 : Sieve V :=
      { arrows := fun _ f => (M.val.map f.op).hom m = 0
        downward_closed := by
          intro Y Z f hf g
          have hf' : (M.val.map f.op).hom m = 0 := hf
          show (M.val.map (g ≫ f).op).hom m = 0
          rw [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, hf',
            map_zero] }
    have hT0 : T0 ∈ Scheme.ProEt.topology S V := by
      apply affine_local V T0
      intro W f hW
      obtain ⟨n, W', e, haff, hsurj, hzero⟩ := h W f hW
      haveI : IsAffine W.left := hW
      refine GrothendieckTopology.superset_covering _ ?_
        (fin_covers W n W' e haff hsurj)
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨k⟩
      show (M.val.map (e k ≫ f).op).hom m = 0
      exact hzero k
    refine M.isSheaf.isSeparated V T0 hT0 m (0 : M.val.obj (Opposite.op V)) ?_
    intro Y f hf
    have hf' : (M.val.map f.op).hom m = 0 := hf
    change (M.val.map f.op).hom m = (M.val.map f.op).hom 0
    rw [map_zero]
    exact hf'
  have twist : ∀ {S S' : Scheme.{u}} {q : S' ⟶ S} (Dq : wcZModPullData q ℓ) (V : S.ProEt)
      (cV0 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ))),
      cV0 = ((wcZModSuppUnitMap Dq).val.app (Opposite.op V)).hom
        (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ))) →
      ∃ c : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ)), cV0 * c = 1 := by
    intro S S' q Dq V cV0 hcV0
    letI := Dq.cont
    let u0 := SheafOfModules.unitToPushforwardObjUnit Dq.φ
    let ψ₁ := (Dq.adj.homEquiv _ _).symm u0
    let h : SheafOfModules.unit (wcZModRingSheaf S' ℓ) ⟶ SheafOfModules.unit (wcZModRingSheaf S' ℓ) :=
      Dq.μ.inv ≫ ψ₁
    have hfac : u0 = wcZModSuppUnitMap Dq ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map h := by
      have e1 : Dq.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
      calc u0 = Dq.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
        _ = Dq.adj.homEquiv _ _ (Dq.μ.hom ≫ h) := by rw [e1]
        _ = Dq.adj.homEquiv _ _ Dq.μ.hom ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map h :=
          Adjunction.homEquiv_naturality_right _ _ _
        _ = wcZModSuppUnitMap Dq ≫
            (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q) _ _ Dq.cont Dq.φ).map h := by
          rw [Adjunction.homEquiv_unit]; rfl
    let cV : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ)) :=
      ((wcZModSuppUnitMap Dq).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
    let a : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ)) :=
      (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom
        (1 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ)))
    have hu1 : (u0.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ))) =
        (1 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ))) :=
      (Dq.φ.hom.app (Opposite.op V)).hom.map_one
    have hev : (u0.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ))) =
        (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom cV := by
      rw [hfac]
      rfl
    have hlin : ∀ x : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ)),
        (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom x = x * a := by
      intro x
      have e := (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom.map_smul x
        (1 : C(↥(Limits.pullback V.hom q), ULift.{u+1} (ZMod ℓ)))
      have e2 : (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom x =
          (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom (x * 1) :=
        congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC q).obj V))).hom y) (mul_one x).symm
      exact e2.trans e
    have hcv : cV0 = cV := hcV0
    refine ⟨a, ?_⟩
    rw [hcv]
    exact (hlin cV).symm.trans (hev.symm.trans hu1)
  have formula : ∀ (V : S.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
      (m1 mt : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ))),
      m1 = ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom
        (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ))) →
      mt = ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom t →
      mt = t.comp (Limits.pullback.fst V.hom i).base.hom * m1 := by
    intro V t m1 mt hm1 hmt
    let m1' : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ)) :=
      ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
    let mt' : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ)) :=
      ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom t
    let φt : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ)) :=
      (Dz.φ.hom.app (Opposite.op V)).hom t
    have hφ : φt = t.comp (Limits.pullback.fst V.hom i).base.hom := hDz V t
    have hm1' : m1 = m1' := hm1
    have hmt' : mt = mt' := hmt
    rw [hm1', hmt']
    have h := ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom.map_smul t
      (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
    have h' : (((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom (t * 1) :
          C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ))) = φt * m1' := h
    rw [hφ] at h'
    have h0 : (((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom
          (t * 1 : C(↥V.left, ULift.{u+1} (ZMod ℓ))) :
        C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ))) = mt' :=
      congrArg (fun x => ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom x) (mul_one t)
    exact h0.symm.trans h'
  have vanish : ∀ (V : S.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod ℓ))),
      ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom t = 0 →
      ∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0 := by
    intro V t h0 y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst V.hom i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    let s : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ)) :=
      ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} (ZMod ℓ)))
    let mt : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ)) :=
      ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom t
    have hmt0 : mt = 0 := h0
    obtain ⟨c, hc⟩ := twist Dz V s rfl
    have htw := formula V t s mt rfl rfl
    rw [hmt0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ)) => φ z) htw
    have h2 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod ℓ)) => φ z) hc
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply, ContinuousMap.zero_apply] at h1 h2
    show t ((Limits.pullback.fst V.hom i).base.hom z) = 0
    linear_combination (-(c z)) * h1 - (t ((Limits.pullback.fst V.hom i).base.hom z)) * h2
  have key : ∀ (V : S.ProEt) (t : C(↥V.left, ULift.{u+1} (ZMod ℓ))),
      (∀ y : ↥V.left, V.hom y ∈ Set.range i → t y = 0) →
      (w.val.app (Opposite.op V)).hom t = 0 := by
    intro V t ht
    apply sep (N.obj (wcEtSuppObj De)) V
    intro W gW hWaff
    haveI : IsAffine W.left := hWaff
    haveI : WeaklyEtale W.hom := W.prop
    have htW : ∀ x : ↥W.left, W.hom x ∈ Set.range i → (t.comp gW.left.base.hom) x = 0 := by
      intro x hx
      apply ht
      have e : V.hom (gW.left x) = W.hom x := by
        rw [← MorphismProperty.Over.w gW]; rfl
      rw [e]; exact hx
    let τ : C(↥W.left, ULift.{u+1} (ZMod ℓ)) := t.comp gW.left.base.hom
    have hA : IsClopen (τ ⁻¹' {0}) := (isClopen_discrete {0}).preimage τ.continuous
    obtain ⟨e₀, he₀⟩ := clop W.left (τ ⁻¹' {0}) hA
    obtain ⟨e₁, he₁⟩ := clop W.left (τ ⁻¹' {0})ᶜ hA.compl
    let ε : Fin 2 → Γ(W.left, ⊤) := ![e₀, e₁]
    let W' : Fin 2 → S.ProEt := fun k =>
      MorphismProperty.Over.mk ⊤ ((W.left.basicOpen (ε k)).ι ≫ W.hom) inferInstance
    let e : ∀ k, W' k ⟶ W := fun k =>
      MorphismProperty.Over.homMk (W.left.basicOpen (ε k)).ι rfl trivial
    refine ⟨2, W', e, fun k => (isAffineOpen_top W.left).basicOpen (ε k), ?_, ?_⟩
    · intro x
      by_cases hx : τ x = 0
      · refine ⟨0, ?_⟩
        show x ∈ Set.range (W.left.basicOpen e₀).ι
        rw [Scheme.Opens.range_ι, he₀]
        exact hx
      · refine ⟨1, ?_⟩
        show x ∈ Set.range (W.left.basicOpen e₁).ι
        rw [Scheme.Opens.range_ι, he₁]
        exact hx
    · intro k
      refine (PresheafOfModules.naturality_apply w.val (e k ≫ gW).op t).symm.trans ?_
      fin_cases k
      · have h0 : (t.comp ((e 0 ≫ gW).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} (ZMod ℓ))) =
            0 := by
          refine ContinuousMap.ext fun x => ?_
          have hx : (W.left.basicOpen e₀).ι x ∈ (W.left.basicOpen e₀ : Set ↥W.left) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
          rw [he₀] at hx
          rw [ContinuousMap.zero_apply]
          exact hx
        change (w.val.app (Opposite.op (W' 0))).hom (t.comp ((e 0 ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => (w.val.app (Opposite.op (W' 0))).hom s) h0).trans ?_
        exact map_zero _
      · have hV1 : ∀ x : ↥(W' 1).left, (W' 1).hom x ∉ Set.range i := by
          intro x hx
          have hι : (W.left.basicOpen e₁).ι x ∈ (W.left.basicOpen e₁ : Set ↥W.left) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
          rw [he₁] at hι
          have hc : (W' 1).hom x = W.hom ((W.left.basicOpen e₁).ι x) :=
            Scheme.Hom.comp_apply _ _ _
          have hr : W.hom ((W.left.basicOpen e₁).ι x) ∈ Set.range i := by
            rw [← hc]; exact hx
          exact hι (show τ ((W.left.basicOpen e₁).ι x) = 0 from htW _ hr)
        have hs4 := hvoff (W' 1) hV1
        have hsm := (w.val.app (Opposite.op (W' 1))).hom.map_smul
          (t.comp ((e 1 ≫ gW).left.base.hom)) (1 : C(↥(W' 1).left, ULift.{u+1} (ZMod ℓ)))
        change (w.val.app (Opposite.op (W' 1))).hom (t.comp ((e 1 ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => (w.val.app (Opposite.op (W' 1))).hom s)
          (mul_one (t.comp ((e 1 ≫ gW).left.base.hom))).symm).trans ?_
        refine hsm.trans ?_
        rw [hs4]
        exact smul_zero _
  have hK2 : Limits.kernel.ι (wcZModSuppUnitMap Dz) ≫ w = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro Xo
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction Xo using Opposite.rec with
    | op V =>
    have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom x)
      (Limits.kernel.condition (wcZModSuppUnitMap Dz))
    change ((wcZModSuppUnitMap Dz).val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcZModSuppUnitMap Dz)).val.app (Opposite.op V)).hom x) = 0 at hk
    change (w.val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcZModSuppUnitMap Dz)).val.app (Opposite.op V)).hom x) = 0
    exact key V _ (vanish V _ hk)

  have s3 : ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}),
      wcSuppIn S (Set.range i)ᶜ G →
      ∀ Ψ : (wcEpsInv S).obj G ⟶
        (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).obj (wcZModSuppObj Dz), Ψ = 0 := by
    intro G hG Ψ
    let H := (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).obj (wcZModSuppObj Dz)
    let P := ((wcEtToProEt S).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)).obj H
    let φ : G ⟶ P := adj.homEquiv G H Ψ
    have hφ : φ = 0 := by
      have hsec : ∀ (V : S.Etale) (s : G.obj.obj (Opposite.op V)),
          (φ.hom.app (Opposite.op V)).hom s = 0 := by
        intro V s
        set x := (φ.hom.app (Opposite.op V)).hom s with hx
        let T : Sieve V :=
          { arrows := fun V' g => (P.obj.map g.op).hom x = 0
            downward_closed := by
              intro V₁ V₂ g hg h
              show (P.obj.map (h ≫ g).op).hom x = 0
              rw [op_comp, Functor.map_comp]
              change (P.obj.map h.op).hom ((P.obj.map g.op).hom x) = 0
              rw [hg, map_zero] }
        have hT : T ∈ Scheme.smallEtaleTopology S V := by
          refine GrothendieckTopology.superset_covering _ ?_ (hG V s)
          rw [Sieve.generate_le_iff]
          intro V' g hg
          rcases hg with h0 | hWV
          · show (P.obj.map g.op).hom x = 0
            have h1 : (φ.hom.app (Opposite.op V')).hom ((G.obj.map g.op).hom s) =
                (P.obj.map g.op).hom ((φ.hom.app (Opposite.op V)).hom s) :=
              NatTrans.naturality_apply φ.hom g.op s
            have h0' : (G.obj.map g.op).hom s = 0 := h0
            rw [hx, ← h1, h0', map_zero]
          · show (P.obj.map g.op).hom x = 0
            have hempty : ∀ z : ↥(Limits.pullback V'.hom i), False := by
              intro z
              have e : (Limits.pullback.fst V'.hom i ≫ V'.hom) z =
                  (Limits.pullback.snd V'.hom i ≫ i) z := by
                rw [Limits.pullback.condition]
              rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
              exact hWV (Limits.pullback.fst V'.hom i z) ⟨Limits.pullback.snd V'.hom i z, e.symm⟩
            have hss : ∀ a b : C(↥(Limits.pullback V'.hom i), ULift.{u+1} (ZMod ℓ)), a = b :=
              fun a b => ContinuousMap.ext (fun z => (hempty z).elim)
            exact hss _ _
        refine P.isSeparated V T hT x 0 (fun V' g hg => ?_)
        rw [map_zero]
        exact hg
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro s
      exact hsec V.unop s
    have hΨ : Ψ = (adj.homEquiv G H).symm φ := (Equiv.symm_apply_apply _ _).symm
    haveI : (Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt S) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)).IsLeftAdjoint := adj.isLeftAdjoint
    haveI : (Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt S) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    rw [hΨ, hφ, Adjunction.homEquiv_counit, Functor.map_zero]
    exact Limits.zero_comp

  have hK1 : Limits.kernel.ι w ≫ wcZModSuppUnitMap Dz = 0 := by
    have hΦ : N.map (Limits.kernel.ι (wcEtSuppUnitMap De)) ≫ e.hom ≫ wcZModSuppUnitMap Dz = 0 := by
      apply (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).map_injective
      rw [Functor.map_zero]
      have hz := s3 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ)).obj
          (Limits.kernel (wcEtSuppUnitMap De))) (wc_et_supp_unit_ker_suppIn i ℓ De)
        (θ.inv.app (Limits.kernel (wcEtSuppUnitMap De)) ≫
          (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).map
            (N.map (Limits.kernel.ι (wcEtSuppUnitMap De)) ≫ e.hom ≫ wcZModSuppUnitMap Dz))
      calc (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).map
            (N.map (Limits.kernel.ι (wcEtSuppUnitMap De)) ≫ e.hom ≫ wcZModSuppUnitMap Dz)
          = θ.hom.app (Limits.kernel (wcEtSuppUnitMap De)) ≫
              (θ.inv.app (Limits.kernel (wcEtSuppUnitMap De)) ≫
              (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).map
                (N.map (Limits.kernel.ι (wcEtSuppUnitMap De)) ≫ e.hom ≫
                  wcZModSuppUnitMap Dz)) := (Iso.hom_inv_id_app_assoc θ _ _).symm
        _ = 0 := by rw [hz, Limits.comp_zero]
    have h0 : (Limits.kernel.ι w ≫ e.inv) ≫ N.map (wcEtSuppUnitMap De) = 0 := by
      rw [Category.assoc, ← hw]
      exact Limits.kernel.condition w
    have hL : Limits.kernel.lift (N.map (wcEtSuppUnitMap De)) (Limits.kernel.ι w ≫ e.inv) h0 ≫
        Limits.kernel.ι (N.map (wcEtSuppUnitMap De)) = Limits.kernel.ι w ≫ e.inv :=
      Limits.kernel.lift_ι _ _ _
    have hP : (Limits.PreservesKernel.iso N (wcEtSuppUnitMap De)).inv ≫
        N.map (Limits.kernel.ι (wcEtSuppUnitMap De)) =
        Limits.kernel.ι (N.map (wcEtSuppUnitMap De)) := Limits.PreservesKernel.iso_inv_ι N _
    calc Limits.kernel.ι w ≫ wcZModSuppUnitMap Dz
        = (Limits.kernel.ι w ≫ e.inv) ≫ e.hom ≫ wcZModSuppUnitMap Dz := by
          simp only [Category.assoc, Iso.inv_hom_id_assoc]
      _ = Limits.kernel.lift (N.map (wcEtSuppUnitMap De)) (Limits.kernel.ι w ≫ e.inv) h0 ≫
            (Limits.PreservesKernel.iso N (wcEtSuppUnitMap De)).inv ≫
            (N.map (Limits.kernel.ι (wcEtSuppUnitMap De)) ≫ e.hom ≫ wcZModSuppUnitMap Dz) := by
          rw [← Category.assoc (Limits.PreservesKernel.iso N (wcEtSuppUnitMap De)).inv, hP,
            ← Category.assoc (Limits.kernel.lift (N.map (wcEtSuppUnitMap De))
              (Limits.kernel.ι w ≫ e.inv) h0), hL]
      _ = 0 := by rw [hΦ, Limits.comp_zero, Limits.comp_zero]

  have hσ : wcZModSuppUnitMap Dz ≫ Abelian.epiDesc (wcZModSuppUnitMap Dz) w hK2 = w :=
    Abelian.comp_epiDesc _ _ _
  have hτ : w ≫ Abelian.epiDesc w (wcZModSuppUnitMap Dz) hK1 = wcZModSuppUnitMap Dz :=
    Abelian.comp_epiDesc _ _ _
  refine ⟨Abelian.epiDesc (wcZModSuppUnitMap Dz) w hK2,
    ⟨Abelian.epiDesc w (wcZModSuppUnitMap Dz) hK1, ?_, ?_⟩, hσ.trans hw⟩
  · rw [← cancel_epi (wcZModSuppUnitMap Dz), ← Category.assoc, hσ, hτ, Category.comp_id]
  · rw [← cancel_epi w, ← Category.assoc, hτ, hσ, Category.comp_id]

theorem wc_zmod_mod_right_adjoint_exists : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] [(wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)], ∃ R : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing S ℓ), Nonempty (R ⋙ SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ) ≅ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ) ⋙ (wcEtToProEt S).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)) :=
by
  intro S ℓ _ _
  have hℓ : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  obtain ⟨αe, he1, he2, -⟩ := wc_et_zmod_ring_locbij S ℓ
  obtain ⟨hFe, hEe⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology S)
    (wcEtZModRing S ℓ) ℓ αe he1 he2
  haveI := hFe
  obtain ⟨_, -, -, hp3⟩ := wc_proet_zmod_ring_locbij S ℓ hℓ
  have hG : ∀ Y : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ),
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ)).essImage
        ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ) ⋙
          (wcEtToProEt S).sheafPushforwardContinuous AddCommGrpCat.{u+1}
            (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)).obj Y) := by
    intro Y
    apply hEe
    apply (sheafToPresheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map_injective
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero]
    ext W m
    have key : ∀ m' : (Y.val.obj (Opposite.op ((wcEtToProEt S).obj W.unop)) : Type _),
        ℓ • m' = 0 := fun m' => by
      rw [← Nat.cast_smul_eq_nsmul
        ((wcZModRingSheaf S ℓ).obj.obj (Opposite.op ((wcEtToProEt S).obj W.unop))) ℓ m',
        hp3 _, zero_smul]
    simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
      AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
    exact key m
  exact ⟨Functor.essImage.liftFunctor _ _ hG, ⟨Functor.essImage.liftFunctorCompIso _ _ hG⟩⟩

theorem sheaf_free_yoneda_nsmul_mono : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (U : C) (n : ℕ), 0 < n → Mono (n • 𝟙 ((presheafToSheaf J AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
by
  classical
  intro C _ J _ _ U n hn
  have tf : ∀ (X : Type (u+1)) (a b : FreeAbelianGroup X), n • a = n • b → a = b := by
    intro X a b hab
    apply (FreeAbelianGroup.equivFinsupp X).injective
    ext x
    have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp X z x) hab
    simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
    exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
  have hmono : Mono (n • 𝟙 (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    have : ∀ V, Mono ((n • 𝟙 (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app V) := by
      intro V
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
      intro a b hab
      simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
        AddMonoidHom.id_apply] at hab
      exact tf _ a b hab
    exact NatTrans.mono_of_mono_app _
  have := Functor.map_mono (presheafToSheaf J AddCommGrpCat.{u+1})
    (n • 𝟙 (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id] at this
  exact this

theorem sheaf_injective_nsmul_epi : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (E : Sheaf J AddCommGrpCat.{u+1}) [Injective E] (n : ℕ), 0 < n → Epi (n • 𝟙 E) :=
by
  intro C _ J _ _ E _ n hn
  classical
  have hP : Injective ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E) :=
    Injective.injective_of_adjoint (sheafificationAdjunction J AddCommGrpCat.{u+1}) E
  have hdiv : ∀ (U : C) (s : ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E).obj (Opposite.op U)),
      ∃ t, n • t = s := by
    intro U s
    let P := (sheafToPresheaf J AddCommGrpCat.{u+1}).obj E
    let G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let φ : G ⟶ P :=
      { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
        naturality := by
          intro V W h
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro f
          show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
              ((G.map h).hom (FreeAbelianGroup.of f)) =
            (P.map h).hom ((FreeAbelianGroup.lift
              (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
          have hG : (G.map h).hom (FreeAbelianGroup.of f) =
              FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
          rw [hG]
          erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
          show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
          rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
          rfl }
    have tf : ∀ (X : Type (u+1)) (a b : FreeAbelianGroup X), n • a = n • b → a = b := by
      intro X a b hab
      apply (FreeAbelianGroup.equivFinsupp X).injective
      ext x
      have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp X z x) hab
      simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
      exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
    have hmono : Mono (n • 𝟙 G) := by
      have : ∀ V, Mono ((n • 𝟙 G).app V) := by
        intro V
        rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
        intro a b hab
        simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
          AddMonoidHom.id_apply] at hab
        exact tf _ a b hab
      exact NatTrans.mono_of_mono_app _
    let g := Injective.factorThru φ (n • 𝟙 G)
    have hg : (n • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (n • 𝟙 G)
    rw [Preadditive.nsmul_comp, Category.id_comp] at hg
    refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
    have h1 := congrArg (fun α : G ⟶ P =>
      (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
    have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
      show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
        (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
      rw [FreeAbelianGroup.lift_apply_of]
      simp
    rw [← h2, ← h1]
    simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
    rfl
  have hmap : (sheafToPresheaf J AddCommGrpCat.{u+1}).map (n • 𝟙 E) =
      n • 𝟙 ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E) := by
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
  apply Functor.epi_of_epi_map (sheafToPresheaf J AddCommGrpCat.{u+1})
  rw [hmap]
  have : ∀ V, Epi ((n • 𝟙 ((sheafToPresheaf J AddCommGrpCat.{u+1}).obj E)).app V) := by
    intro V
    rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
    intro s
    obtain ⟨t, ht⟩ := hdiv V.unop s
    exact ⟨t, by simpa using ht⟩
  exact NatTrans.epi_of_epi_app _

theorem sheafOfModules_torsion_injective_retract : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] [EnoughInjectives (Sheaf J AddCommGrpCat.{u+1})] (R : Sheaf J RingCat.{u+1}) [(SheafOfModules.toSheaf.{u+1} R).Full] (n : ℕ), (∀ V, ((n : ℕ) : ↑(R.obj.obj V)) = 0) → (∀ G : Sheaf J AddCommGrpCat.{u+1}, n • 𝟙 G = 0 → (SheafOfModules.toSheaf.{u+1} R).essImage G) → ∀ (I : SheafOfModules.{u+1} R) [Injective I], ∃ (E : Sheaf J AddCommGrpCat.{u+1}) (_ : Injective E) (j : (SheafOfModules.toSheaf.{u+1} R).obj I ⟶ Limits.kernel (n • 𝟙 E)) (ρ : Limits.kernel (n • 𝟙 E) ⟶ (SheafOfModules.toSheaf.{u+1} R).obj I), j ≫ ρ = 𝟙 _ :=
by
  intro C _ J _ _ _ R _ n hn hess I _
  set U := SheafOfModules.toSheaf.{u+1} R with hU

  have s2 : n • 𝟙 (U.obj I) = 0 := by
    have h1 : n • 𝟙 (U.obj I) = U.map (n • 𝟙 I) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have hz : ∀ (V : Cᵒᵖ) (x : I.val.obj V), (((0 : I ⟶ I).val).app V).hom x = 0 := by
      intro V x
      first
        | rfl
        | simp
        | (rw [show ((0 : I ⟶ I).val) = 0 from (SheafOfModules.forget R).map_zero I I,
            PresheafOfModules.zero_app]; rfl)
    have key : ∀ (k : ℕ) (V : Cᵒᵖ) (x : I.val.obj V), ((k • 𝟙 I).val.app V).hom x = k • x := by
      intro k V x
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul, hz]
      | succ k ih => simp [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ih]
    have h2 : n • 𝟙 I = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      ext x
      rw [key n V x, ← Nat.cast_smul_eq_nsmul (R.obj.obj V), hn V, zero_smul, hz]
    rw [h1, h2, Functor.map_zero]
  let A := U.obj I
  let E := Injective.under A
  let ι : A ⟶ E := Injective.ι A
  have hι : ι ≫ (n • 𝟙 E) = 0 := by
    rw [Preadditive.comp_nsmul, Category.comp_id, ← Category.id_comp ι, ← Preadditive.nsmul_comp,
      s2, Limits.zero_comp]
  let j : A ⟶ Limits.kernel (n • 𝟙 E) := Limits.kernel.lift (n • 𝟙 E) ι hι
  have : Mono j := mono_of_mono_fac (Limits.kernel.lift_ι (n • 𝟙 E) ι hι)
  have s4 : n • 𝟙 (Limits.kernel (n • 𝟙 E)) = 0 := by
    rw [← cancel_mono (Limits.kernel.ι (n • 𝟙 E)), Preadditive.nsmul_comp, Category.id_comp,
      Limits.zero_comp, ← Category.comp_id (Limits.kernel.ι (n • 𝟙 E)), ← Preadditive.comp_nsmul,
      Limits.kernel.condition]
  have h := hess _ s4
  let M := h.witness
  let e : U.obj M ≅ Limits.kernel (n • 𝟙 E) := h.getIso
  let f : I ⟶ M := U.preimage (j ≫ e.inv)
  have hf : U.map f = j ≫ e.inv := U.map_preimage _
  have hmono : Mono (U.map f) := by rw [hf]; infer_instance
  have : Mono f := U.mono_of_mono_map hmono
  let g : M ⟶ I := Injective.factorThru (𝟙 I) f
  have hfg : f ≫ g = 𝟙 I := Injective.comp_factorThru (𝟙 I) f
  refine ⟨E, inferInstance, j, e.inv ≫ U.map g, ?_⟩
  rw [← Category.assoc, ← hf, ← U.map_comp, hfg, CategoryTheory.Functor.map_id]

theorem wc_exact_kernel_nsmul_ext_vanish : ∀ {C : Type*} [Category C] [Abelian C] {D : Type*} [Category D] [Abelian D] [HasExt D] (Φ : C ⥤ D) [Φ.Additive] [Φ.Full] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ] (F : D) (X₀ : C) (ψ : F ≅ Φ.obj X₀) (n : ℕ), Mono (n • 𝟙 X₀) → ∀ (E : C) [Injective E], Epi (n • 𝟙 E) → (∀ (k : ℕ) (x : Abelian.Ext F (Φ.obj E) (k + 1)), x = 0) → ∀ (k : ℕ) (x : Abelian.Ext F (Φ.obj (Limits.kernel (n • 𝟙 E))) (k + 1)), x = 0 :=
by
  intro C _ _ D _ _ _ Φ _ _ _ _ F X₀ ψ n hmono E _ hepi hE k x
  let S₀ : ShortComplex C :=
    ShortComplex.mk (Limits.kernel.ι (n • 𝟙 E)) (n • 𝟙 E) (Limits.kernel.condition _)
  have hS₀ : S₀.ShortExact := by
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · exact ShortComplex.exact_of_f_is_kernel S₀ (Limits.kernelIsKernel _)
    · dsimp [S₀]; infer_instance
    · exact hepi
  have hS := hS₀.map_of_exact Φ
  have h0 : x.comp (Abelian.Ext.mk₀ (S₀.map Φ).f) (add_zero _) = 0 := hE k _
  obtain ⟨x₃, hx⟩ := Abelian.Ext.covariant_sequence_exact₁ F hS x h0 (n₀ := k) rfl
  subst hx
  rcases k with _ | m
  · obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective F (Φ.obj E)).2 x₃
    have := hmono
    let g₀ : X₀ ⟶ E := Φ.preimage (ψ.inv ≫ h)
    let t : X₀ ⟶ E := Injective.factorThru g₀ (n • 𝟙 X₀)
    have ht : (n • 𝟙 X₀) ≫ t = g₀ := Injective.comp_factorThru _ _
    have hdiv : (ψ.hom ≫ Φ.map t) ≫ (S₀.map Φ).g = h := by
      show (ψ.hom ≫ Φ.map t) ≫ Φ.map (n • 𝟙 E) = h
      rw [Category.assoc, ← Φ.map_comp, Preadditive.comp_nsmul, Category.comp_id]
      rw [Preadditive.nsmul_comp, Category.id_comp] at ht
      rw [ht, Functor.map_preimage, Iso.hom_inv_id_assoc]
    rw [← hdiv, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
      hS.comp_extClass, Abelian.Ext.comp_zero]
  · rw [hE m x₃, Abelian.Ext.zero_comp]

theorem wc_proet_push_epsInv_injective_affine_vanishing : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsProper g] (A : B.Opens), IsAffineOpen A → ∀ (T : B.ProEt), wcAffIndEt B A T → ∀ (I : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ) (e : Abelian.Ext (wcFreeSheaf X ((wcProEtBaseChange g).obj T)) ((wcEpsInv X).obj I) (n + 1)), e = 0 :=
by

  have hflat : ∀ (Y : Scheme.{u}), Limits.PreservesFiniteLimits (wcEtToProEt Y) ∧
      (wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) := by
    intro Y
    haveI h1 : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
        (Scheme.ProEt.forget Y)
        (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
    have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
        (wcEtToProEt Y) := by
      refine ⟨fun {V} {R} hR => ?_⟩
      obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
      have hP : Presieve.map (wcEtToProEt Y) (@Scheme.Cover.toPresieveOverProp _ _ _ _ _ 𝒰 h₁ h) ∈
          (Scheme.ProEt.precoverage Y).coverings ((wcEtToProEt Y).obj V) :=
        Precoverage.mem_comap_iff.2
          ((congrArg (· ∈ Scheme.proetalePrecoverage.coverings V.left)
              ((congrArg (Presieve.map (Scheme.ProEt.forget Y ⋙ Over.forget Y))
                (Presieve.map_ofArrows (F := wcEtToProEt Y) _)).trans
                (Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) _))).mpr
            (Scheme.etalePrecoverage_le_proetalePrecoverage _ 𝒰.mem₀))
      have hgen := Precoverage.generate_mem_toGrothendieck hP
      refine GrothendieckTopology.superset_covering _ ?_ hgen
      rw [Sieve.generate_le_iff]
      intro W f hf
      cases hf with
      | of hg => exact ⟨_, _, 𝟙 _, (by apply hle; exact hg), (Category.id_comp _).symm⟩
    haveI := flat_of_preservesFiniteLimits (wcEtToProEt Y)
    exact ⟨h1, Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.ProEt.topology Y) (wcEtToProEt Y)) hcov⟩
  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e
  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc
  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
