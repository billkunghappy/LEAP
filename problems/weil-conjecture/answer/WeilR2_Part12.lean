      (Scheme.smallEtaleTopology T) ≅ wcEtInv g :=
    Adjunction.leftAdjointUniq
      ((wcEtBaseChange g).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology T))
      (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtBaseChange g)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology T) :
        wcEtInv g ⊣ _)
  let κ : Dg.Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcEtZModRing T N) ≅
      SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y N) ⋙ wcEtInv g :=
    κ₀ ≪≫ Functor.isoWhiskerLeft (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y N)) ν
  let k : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing T N)).obj (Dg.Φ.obj I) ≅
      (wcEtInv g).obj ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y N)).obj I) := κ.app I

  haveI hI' : Injective (Dg.Φ.obj I) := wc_et_open_pull_preserves_injective g N Dg I hI
  obtain ⟨α, hα1, hα2, hR⟩ := wc_et_zmod_ring_locbij T N
  obtain ⟨hFull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv
    (Scheme.smallEtaleTopology T) (wcEtZModRing T N) N α hα1 hα2
  haveI := hFull
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives T
  have h0 : (Abelian.Ext.mk₀ eP.inv).comp (e'.comp (Abelian.Ext.mk₀ k.inv) (add_zero (n + 1)))
      (zero_add (n + 1)) = 0 :=
    sheafOfModules_torsion_injective_acyclic (Scheme.smallEtaleTopology T)
      (wcEtZModRing T N) N hN hR hess (Dg.Φ.obj I) n _

  have hback : e' = (Abelian.Ext.mk₀ eP.hom).comp
      (((Abelian.Ext.mk₀ eP.inv).comp (e'.comp (Abelian.Ext.mk₀ k.inv) (add_zero (n + 1)))
        (zero_add (n + 1))).comp (Abelian.Ext.mk₀ k.hom) (add_zero (n + 1)))
      (zero_add (n + 1)) := by
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp]
  rw [hback, h0, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]

theorem wc_et_proet_unit_free_corep : ∀ (Y : Scheme.{u}) (N : ℕ), ∃ b : wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) ⟶ (wcEpsInv Y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj (SheafOfModules.unit (wcEtZModRing Y N))), ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N), Function.Bijective (fun f : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M => b ≫ (wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f)) :=
by
  intro Y N
  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hcont
  have huniq : ∀ (V : Y.Etale) (f g : V ⟶ (wcZarToEt Y).obj ⊤), f = g := by
    intro V f g
    haveI : Mono ((wcZarToEt Y).obj ⊤).hom :=
      show Mono (⊤ : Y.Opens).ι from (inferInstance : Mono (⊤ : Y.Opens).ι)
    apply MorphismProperty.Over.Hom.ext
    rw [← cancel_mono ((wcZarToEt Y).obj ⊤).hom, MorphismProperty.Over.w f,
      MorphismProperty.Over.w g]
  have hT : Limits.IsTerminal ((wcZarToEt Y).obj ⊤) :=
    Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk (V.hom ≫ Y.topIso.inv)
        (by
          change (V.hom ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι = V.hom
          rw [← Scheme.topIso_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]) trivial)
      (fun V g => huniq V g _)
  obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
    (Scheme.smallEtaleTopology Y) (wcEtZModRing Y N) ((wcZarToEt Y).obj ⊤) hT
  let θ := (wc_et_free_top_iso_const Y).some
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  haveI : ∀ G', IsIso (adj.unit.app G') := fun G' => wc_epsInv_unit_iso Y G'
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  have ha : ∀ (A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : A ⟶ B => (wcEpsInv Y).map g) :=
    fun A B => (adj.fullyFaithfulLOfIsIsoUnit).map_bijective A B
  let ψ : wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) ≅
      (wcEpsInv Y).obj ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj ((wcZarToEt Y).obj ⊤) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    (wc_free_terminal_const Y).some ≪≫
      (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} ℤ))).some.symm ≪≫
      (wcEpsInv Y).mapIso θ.symm
  refine ⟨ψ.hom ≫ (wcEpsInv Y).map ε, fun M => ?_⟩
  have key : ∀ f : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M,
      (ψ.hom ≫ (wcEpsInv Y).map ε) ≫
        (wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f) =
      ψ.hom ≫ (wcEpsInv Y).map (ε ≫ (SheafOfModules.toSheaf (wcEtZModRing Y N)).map f) := by
    intro f
    rw [Functor.map_comp, Category.assoc]
  refine ⟨fun f₁ f₂ h => ?_, fun h => ?_⟩
  · have h' : ψ.hom ≫ (wcEpsInv Y).map (ε ≫ (SheafOfModules.toSheaf (wcEtZModRing Y N)).map f₁) =
        ψ.hom ≫ (wcEpsInv Y).map (ε ≫ (SheafOfModules.toSheaf (wcEtZModRing Y N)).map f₂) := by
      rw [← key, ← key]
      exact h
    rw [cancel_epi] at h'
    exact (hε M).1 ((ha _ _).1 h')
  · obtain ⟨g, hg⟩ := (ha _ _).2 (ψ.inv ≫ h)
    obtain ⟨f, hf⟩ := (hε M).2 g
    refine ⟨f, ?_⟩
    show (ψ.hom ≫ (wcEpsInv Y).map ε) ≫
        (wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f) = h
    rw [key]
    simp only at hf hg
    rw [hf, hg, Iso.hom_inv_id_assoc]

theorem wc_et_zmod_unit_hom_eval_terminal_bij : ∀ (Y : Scheme.{u}) (N : ℕ) (T : Y.Etale), Limits.IsTerminal T → ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y N)), Function.Bijective (fun g : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M => (g.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Y N).obj.obj (Opposite.op T))) :=
by
  intro Y N T hT M
  have huniq : ∀ (X : (Y.Etale)ᵒᵖ) (a b : Opposite.op T ⟶ X), a = b := fun X a b =>
    Quiver.Hom.unop_inj (hT.hom_ext _ _)
  let evT : M.sections → M.val.obj (Opposite.op T) := fun s => s.1 (Opposite.op T)
  have hfac : (fun g : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M =>
      (g.val.app (Opposite.op T)).hom (1 : (wcEtZModRing Y N).obj.obj (Opposite.op T))) =
      evT ∘ M.unitHomEquiv := by
    funext g
    first
      | exact (SheafOfModules.unitHomEquiv_apply_coe M g (Opposite.op T)).symm
      | exact (SheafOfModules.unitHomEquiv_apply_coe g (Opposite.op T)).symm
      | simp [evT, SheafOfModules.unitHomEquiv_apply_coe]
  rw [hfac]
  refine Function.Bijective.comp ⟨?_, ?_⟩ M.unitHomEquiv.bijective
  · intro s t hst
    apply PresheafOfModules.sections_ext
    intro X
    have hs := PresheafOfModules.sections_property s (hT.from X.unop).op
    have ht := PresheafOfModules.sections_property t (hT.from X.unop).op
    rw [← hs, ← ht]
    exact congrArg _ hst
  · intro m
    refine ⟨PresheafOfModules.sectionsMk
      (fun X => (M.val.map (hT.from X.unop).op).hom m) ?_, ?_⟩
    · intro X X' f
      have e : (hT.from X'.unop).op = (hT.from X.unop).op ≫ f :=
        huniq X' (hT.from X'.unop).op ((hT.from X.unop).op ≫ f)
      first
        | (rw [e, PresheafOfModules.map_comp]; rfl)
        | (simp only [e, PresheafOfModules.map_comp]; rfl)
        | (rw [e]; simp [PresheafOfModules.map_comp])
        | (rw [e]; simp)
    · have e : (hT.from (Opposite.unop (Opposite.op T))).op = 𝟙 (Opposite.op T) :=
        huniq _ _ _
      show (PresheafOfModules.sectionsMk _ _).1 (Opposite.op T) = m
      first
        | (simp only [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
        | (rw [PresheafOfModules.sectionsMk_coe, e, PresheafOfModules.map_id]; rfl)
        | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom m = m
           rw [e, PresheafOfModules.map_id]; rfl)
        | (show (M.val.map (hT.from (Opposite.unop (Opposite.op T))).op).hom m = m
           rw [e]; simp)

theorem wc_et_supp_ker_open_section_corep : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (O : Y.Opens), (O : Set Y) = (Set.range i)ᶜ → ∀ (N : ℕ), 0 < N → ∀ (D : wcEtPullData i N), ∃ κ : (Limits.kernel (wcEtSuppUnitMap D)).val.obj (Opposite.op (Scheme.Etale.mk O.ι)), ((Limits.kernel.ι (wcEtSuppUnitMap D)).val.app (Opposite.op (Scheme.Etale.mk O.ι))).hom κ = (1 : (wcEtZModRing Y N).obj.obj (Opposite.op (Scheme.Etale.mk O.ι))) ∧ ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N), Function.Bijective (fun f : Limits.kernel (wcEtSuppUnitMap D) ⟶ M => (f.val.app (Opposite.op (Scheme.Etale.mk O.ι))).hom κ) :=
by
  intro Y Z i _ O hO N hN D
  classical

  let Tj : Y.Etale := Scheme.Etale.mk O.ι
  haveI : IsOpenImmersion Tj.hom := (inferInstance : IsOpenImmersion O.ι)
  have hrange : Set.range Tj.hom = (Set.range i)ᶜ := by
    show Set.range O.ι = _
    rw [Scheme.Opens.range_ι]
    exact hO
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists (S := Y) (S' := Tj.left) Tj.hom N

  have hdisj : ∀ w : Tj.left, Tj.hom w ∉ Set.range i := by
    intro w hw
    have hw' : Tj.hom w ∈ Set.range Tj.hom := ⟨w, rfl⟩
    rw [hrange] at hw'
    exact hw' hw

  have hbij : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N),
      Function.Bijective (fun f : Limits.kernel (wcEtSuppUnitMap D) ⟶ M => Dj.Φ.map f) := by
    intro M
    have h := wc_et_open_restr_ker_corep i Tj.hom hrange N hN D Dj M
    simpa only [Category.id_comp] using h

  obtain ⟨θ, hθ1, -, hθ3⟩ := wc_et_etale_pull_sections_dict Tj N Dj
  have hsub : ∀ U : Tj.left.Etale,
      Subsingleton ((Dj.Φ.obj (wcEtSuppObj D)).val.obj (Opposite.op U)) := by
    intro U
    haveI := wc_et_closed_supp_obj_vanish i N D ((wcEtSlice Tj).obj U) (by
      intro w hw
      exact hdisj (U.hom w) hw)
    exact ⟨fun x y => (θ _ U).injective (Subsingleton.elim _ _)⟩
  have hZ : Limits.IsZero (Dj.Φ.obj (wcEtSuppObj D)) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    obtain ⟨U⟩ := X
    ext x
    haveI := hsub U
    exact Subsingleton.elim _ _
  have hρ0 : Dj.Φ.map (wcEtSuppUnitMap D) = 0 := hZ.eq_of_tgt _ _
  haveI := Dj.additive
  haveI := Dj.presLim
  have hlim := Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (wcEtSuppUnitMap D)) Dj.Φ
  have hiso : IsIso (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
    Limits.KernelFork.IsLimit.isIso_ι _ hlim hρ0

  let top : Tj.left.Etale := wcEtTop Tj.left
  have htop : Limits.IsTerminal top :=
    Limits.IsTerminal.ofUniqueHom
      (fun V => (MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial : V ⟶ top))
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  let ψ : Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)) ⟶
      SheafOfModules.unit (wcEtZModRing Tj.left N) :=
    Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) ≫ Dj.μ.hom
  haveI : IsIso ψ := by dsimp only [ψ]; infer_instance
  let κ₀ := ((inv ψ).val.app (Opposite.op top)).hom
    (1 : (wcEtZModRing Tj.left N).obj.obj (Opposite.op top))
  have hκ₀ : ∀ (P : SheafOfModules.{u+1} (wcEtZModRing Tj.left N))
      (h : Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)) ⟶ P),
      (h.val.app (Opposite.op top)).hom κ₀ = ((inv ψ ≫ h).val.app (Opposite.op top)).hom
        (1 : (wcEtZModRing Tj.left N).obj.obj (Opposite.op top)) := fun P h => rfl
  have hev : ∀ P : SheafOfModules.{u+1} (wcEtZModRing Tj.left N), Function.Bijective
      (fun h : Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)) ⟶ P =>
        (h.val.app (Opposite.op top)).hom κ₀) := by
    intro P
    have h1 : Function.Bijective
        (fun h : Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)) ⟶ P => inv ψ ≫ h) := by
      refine Function.bijective_iff_has_inverse.mpr ⟨fun k => ψ ≫ k, fun h => ?_, fun k => ?_⟩
      · show ψ ≫ inv ψ ≫ h = h
        rw [IsIso.hom_inv_id_assoc]
      · show inv ψ ≫ ψ ≫ k = k
        rw [IsIso.inv_hom_id_assoc]
    have h2 := (wc_et_zmod_unit_hom_eval_terminal_bij Tj.left N top htop P).comp h1
    convert h2 using 1
    funext h
    exact hκ₀ P h
  have hBf : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N), Function.Bijective
      (fun f : Limits.kernel (wcEtSuppUnitMap D) ⟶ M =>
        ((Dj.Φ.map f).val.app (Opposite.op top)).hom κ₀) :=
    fun M => (hev (Dj.Φ.obj M)).comp (hbij M)
  let T' : Y.Etale := (wcEtSlice Tj).obj top
  let κ₁ : (Limits.kernel (wcEtSuppUnitMap D)).val.obj (Opposite.op T') :=
    θ (Limits.kernel (wcEtSuppUnitMap D)) top κ₀
  have hbij₁ : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N), Function.Bijective
      (fun f : Limits.kernel (wcEtSuppUnitMap D) ⟶ M => (f.val.app (Opposite.op T')).hom κ₁) := by
    intro M
    have h := (θ M top).bijective.comp (hBf M)
    convert h using 1
    funext f
    exact (hθ1 _ M f top κ₀).symm
  have hinv : inv ψ ≫ Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = Dj.μ.inv := by
    rw [← cancel_mono Dj.μ.hom, Category.assoc, Iso.inv_hom_id]
    exact IsIso.inv_hom_id ψ
  have hκ₁ : ((Limits.kernel.ι (wcEtSuppUnitMap D)).val.app (Opposite.op T')).hom κ₁ =
      (1 : (wcEtZModRing Y N).obj.obj (Opposite.op T')) := by
    rw [← hθ1 _ _ (Limits.kernel.ι (wcEtSuppUnitMap D)) top κ₀, hκ₀, hinv]
    exact hθ3 top

  let h : Tj ⟶ T' := MorphismProperty.Over.homMk (𝟙 Tj.left)
    (by first
      | (show 𝟙 _ ≫ (𝟙 _ ≫ Tj.hom) = Tj.hom; simp)
      | simp [T', top, Tj]) trivial
  let h' : T' ⟶ Tj := MorphismProperty.Over.homMk (𝟙 Tj.left)
    (by first
      | (show 𝟙 _ ≫ Tj.hom = 𝟙 _ ≫ Tj.hom; rfl)
      | simp [T', top, Tj]) trivial
  have hhh' : h ≫ h' = 𝟙 Tj := MorphismProperty.Over.Hom.ext (by exact Category.comp_id _)
  have hh'h : h' ≫ h = 𝟙 T' := MorphismProperty.Over.Hom.ext (by exact Category.comp_id _)
  haveI : IsIso h := ⟨⟨h', hhh', hh'h⟩⟩
  have hr : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N),
      Function.Bijective (M.val.map h.op).hom := by
    intro M
    have := ConcreteCategory.bijective_of_isIso
      (((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj M).obj.map h.op)
    exact this
  refine ⟨((Limits.kernel (wcEtSuppUnitMap D)).val.map h.op).hom κ₁, ?_, ?_⟩
  · rw [PresheafOfModules.naturality_apply, hκ₁]
    exact PresheafOfModules.unit_map_one _ _
  · intro M
    have hc := (hr M).comp (hbij₁ M)
    have nat : ∀ f : Limits.kernel (wcEtSuppUnitMap D) ⟶ M,
        (f.val.app (Opposite.op Tj)).hom
          (((Limits.kernel (wcEtSuppUnitMap D)).val.map h.op).hom κ₁) =
          (M.val.map h.op).hom ((f.val.app (Opposite.op T')).hom κ₁) :=
      fun f => PresheafOfModules.naturality_apply f.val h.op κ₁
    refine ⟨fun f g hfg => hc.1 ((nat f).symm.trans (hfg.trans (nat g))), fun m => ?_⟩
    obtain ⟨f, hf⟩ := hc.2 m
    exact ⟨f, (nat f).trans hf⟩

theorem wc_et_proet_supp_ker_free_corep : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (O : Y.Opens), (O : Set Y) = (Set.range i)ᶜ → ∀ (N : ℕ), 0 < N → ∀ (D : wcEtPullData i N) (b : wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) ⟶ (wcEpsInv Y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj (SheafOfModules.unit (wcEtZModRing Y N)))), (∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N), Function.Bijective (fun f : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M => b ≫ (wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f))) → ∃ a : wcFreeSheaf Y (Scheme.ProEt.mk O.ι) ⟶ (wcEpsInv Y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj (Limits.kernel (wcEtSuppUnitMap D))), a ≫ (wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map (Limits.kernel.ι (wcEtSuppUnitMap D))) = wcFreeSheafMap Y (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)) ≫ b ∧ ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y N), Function.Bijective (fun f : Limits.kernel (wcEtSuppUnitMap D) ⟶ M => a ≫ (wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f)) :=
by
  intro Y Z i _ O hO N hN D b hb
  classical
  haveI := (wc_etToProEt_flat_cont Y).2
  obtain ⟨gen, hgen, hgenmap⟩ := wc_proet_free_sheaf_yoneda Y

  let adj : wcEpsInv Y ⊣ (wcEtToProEt Y).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  let θ : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale),
      H.obj.obj (Opposite.op V) →
        ((wcEpsInv Y).obj H).obj.obj (Opposite.op ((wcEtToProEt Y).obj V)) :=
    fun H V x => ((adj.unit.app H).hom.app (Opposite.op V)).hom x
  have hθbij : ∀ H V, Function.Bijective (θ H V) := by
    intro H V
    haveI hiso : IsIso (adj.unit.app H) := wc_epsInv_unit_iso Y H
    haveI : IsIso (adj.unit.app H).hom := (sheafToPresheaf _ _).map_isIso (adj.unit.app H)
    exact ConcreteCategory.bijective_of_isIso ((adj.unit.app H).hom.app (Opposite.op V))
  have hθH : ∀ {H H' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (φ : H ⟶ H')
      (V : Y.Etale) (x : H.obj.obj (Opposite.op V)),
      (((wcEpsInv Y).map φ).hom.app (Opposite.op ((wcEtToProEt Y).obj V))).hom (θ H V x) =
        θ H' V ((φ.hom.app (Opposite.op V)).hom x) := by
    intro H H' φ V x
    exact congrArg (fun k => (k.hom.app (Opposite.op V)).hom x) (adj.unit_naturality φ)
  have hθV : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) {V V' : Y.Etale}
      (h : V' ⟶ V) (x : H.obj.obj (Opposite.op V)),
      θ H V' ((H.obj.map h.op).hom x) =
        (((wcEpsInv Y).obj H).obj.map ((wcEtToProEt Y).map h).op).hom (θ H V x) := by
    intro H V V' h x
    exact ConcreteCategory.congr_hom ((adj.unit.app H).hom.naturality h.op) x
  have hev : ∀ (T : Y.ProEt) (H : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : wcFreeSheaf Y T ⟶ H => (g.hom.app (Opposite.op T)).hom (gen T)) := by
    intro T H
    refine ⟨fun g g' hgg => ?_, fun s => (hgen T H s).exists⟩
    exact (hgen T H ((g'.hom.app (Opposite.op T)).hom (gen T))).unique hgg rfl
  have hTet : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom
      (fun V => (MorphismProperty.Over.homMk V.hom : V ⟶ Scheme.Etale.mk (𝟙 Y)))
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  obtain ⟨u, hu⟩ : ∃ u : (wcEtZModRing Y N).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
      θ ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj (SheafOfModules.unit (wcEtZModRing Y N)))
        (Scheme.Etale.mk (𝟙 Y)) u =
        (b.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 Y)))).hom (gen (Scheme.ProEt.mk (𝟙 Y))) := by
    obtain ⟨x, hx⟩ := (hθbij ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj
      (SheafOfModules.unit (wcEtZModRing Y N))) (Scheme.Etale.mk (𝟙 Y))).2
      ((b.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 Y)))).hom (gen (Scheme.ProEt.mk (𝟙 Y))))
    exact ⟨x, hx⟩
  have hb' : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y N))
      (f : SheafOfModules.unit (wcEtZModRing Y N) ⟶ M),
      ((b ≫ (wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f)).hom.app
          (Opposite.op (Scheme.ProEt.mk (𝟙 Y)))).hom (gen (Scheme.ProEt.mk (𝟙 Y))) =
        θ ((SheafOfModules.toSheaf (wcEtZModRing Y N)).obj M) (Scheme.Etale.mk (𝟙 Y))
          ((f.val.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom u) := by
    intro M f
    refine Eq.trans ?_ (hθH ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f)
      (Scheme.Etale.mk (𝟙 Y)) u)
    show (((wcEpsInv Y).map ((SheafOfModules.toSheaf (wcEtZModRing Y N)).map f)).hom.app
        (Opposite.op (Scheme.ProEt.mk (𝟙 Y)))).hom
        ((b.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 Y)))).hom (gen (Scheme.ProEt.mk (𝟙 Y)))) = _
    rw [← hu]
