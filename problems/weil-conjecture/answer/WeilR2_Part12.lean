    have hΨz : (Φ.hom.app T').hom ((σ.app T').hom (x - y)) = 0 := hΨz0
    have h0 : (H.obj.map a.op).hom ((θ.hom.app (Opposite.op V₁)).hom w) = 0 := by
      rw [← hKF V₁ T'.unop a w]
      have hz' : (L.map a.op).hom ((η.app (Opposite.op V₁)).hom w) = x - y := hz.symm
      rw [hz']
      exact hΨz
    refine (Scheme.ProEt.topology X).superset_covering ?_ (hinj V₁ w T'.unop a h0)
    rw [Sieve.generate_le_iff]
    intro W g hg
    obtain ⟨V₂, b, a', hcomm, hb⟩ := hg
    have hc' : a.op ≫ g.op = ((wcEtToProEt X).map b).op ≫ a'.op := by
      rw [← op_comp, ← op_comp, hcomm]
    have e1 : (L.map g.op).hom ((L.map a.op).hom ((η.app (Opposite.op V₁)).hom w)) =
        (L.map a'.op).hom ((L.map ((wcEtToProEt X).map b).op).hom
          ((η.app (Opposite.op V₁)).hom w)) := by
      have := congrArg (fun f => (L.map f).hom ((η.app (Opposite.op V₁)).hom w)) hc'
      simp only [Functor.map_comp] at this
      exact this
    have n : (L.map ((wcEtToProEt X).map b).op).hom ((η.app (Opposite.op V₁)).hom w) =
        (η.app (Opposite.op V₂)).hom ((G.obj.map b.op).hom w) :=
      (NatTrans.naturality_apply η b.op w).symm
    have key : (L.map g.op).hom (x - y) = 0 := by
      rw [hz, e1, n, hb, map_zero, map_zero]
    rw [map_sub, sub_eq_zero] at key
    exact key

  haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology X) σ :=
    Presheaf.isLocallySurjective_toSheafify' (Scheme.ProEt.topology X) L
  haveI h1 : Presheaf.IsLocallySurjective (Scheme.ProEt.topology X) Φ.hom :=
    Presheaf.isLocallySurjective_of_isLocallySurjective (Scheme.ProEt.topology X) σ Φ.hom
  haveI h2 : Presheaf.IsLocallyInjective (Scheme.ProEt.topology X) Φ.hom :=
    Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective
      (Scheme.ProEt.topology X) σ Φ.hom
  have hiso : IsIso Φ := (Sheaf.isLocallyBijective_iff_isIso Φ).mp ⟨h2, h1⟩
  exact ⟨@asIso _ _ _ _ Φ hiso⟩

theorem wc_slice_vanSub_extZero_theta_exists (S : Scheme.{u}) (V : S.ProEt) (C : Set S) (n : ℕ)
