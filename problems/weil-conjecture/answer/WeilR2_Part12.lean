      (wcIntUnit T ℓ) (wcIntTors T ℓ k) q)
    (h0 : letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf T ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1}
        (wcIntRingSheaf (Limits.pullback (W₀.fromSpecStalk z) g) ℓ)) := HasExt.standard _
      haveI := Dz.additive; haveI := Dz.presLim; haveI := Dz.presColim
