            m ≫ ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
        rw [e]
        haveI := htf k
        infer_instance
      exact mono_of_mono _ m
    have hloc' : ∀ (W : S.ProEt) (a : W ⟶ VU)
        (f : (wcIntUnit S ℓ).val.obj (Opposite.op W)),
        ∃ t : (L.obj (wcFreeSheaf S VU)).val.obj (Opposite.op W),
          (ιK.val.app (Opposite.op W)).hom ((jj.val.app (Opposite.op W)).hom t) = f := by
      intro W a f
      obtain ⟨t, ht⟩ := hloc W a f
      refine ⟨t, ?_⟩
      rw [← ht, ← hfac]
      rfl
    have hepi := hEpi (L.obj (wcFreeSheaf S VU)) jj hloc' k
    exact isIso_of_mono_of_epi _
  · intro M N ψ g
    rw [hevv, hevv]
    rfl
  · rw [hfac0, hevv]
    exact hι1

theorem wc_int_slice_res_free_corep (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ), (P ⟶ M) ≃ M.val.obj (Opposite.op V))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (ev M g)) :
    ∃ ε : SheafOfModules.unit (wcIntRingSheaf V.left ℓ) ⟶ (wcIntSliceRes S ℓ V).obj P,
      (∀ Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ),
        Function.Bijective (fun f : P ⟶ Y => ε ≫ (wcIntSliceRes S ℓ V).map f)) ∧
      IsIso (ε ≫ (wcIntSliceRes S ℓ V).map ((ev (wcIntUnit S ℓ)).symm
          (show (wcIntUnit S ℓ).val.obj (Opposite.op V) from
            (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op V))))) :=
by
  classical

  have hu : IsIso (SheafOfModules.unitToPushforwardObjUnit (F := wcSliceFunctor S V)
      (S := wcIntRingSheaf V.left ℓ) (R := wcIntRingSheaf S ℓ) (𝟙 (wcIntRingSheaf V.left ℓ)) :
      SheafOfModules.unit (wcIntRingSheaf V.left ℓ) ⟶ (wcIntSliceRes S ℓ V).obj (wcIntUnit S ℓ)) := by
    let u : SheafOfModules.unit (wcIntRingSheaf V.left ℓ) ⟶
        (wcIntSliceRes S ℓ V).obj (wcIntUnit S ℓ) :=
      SheafOfModules.unitToPushforwardObjUnit (F := wcSliceFunctor S V)
        (S := wcIntRingSheaf V.left ℓ) (R := wcIntRingSheaf S ℓ) (𝟙 (wcIntRingSheaf V.left ℓ))
    show IsIso u
    have hU : ∀ U, IsIso (((PresheafOfModules.toPresheaf _).map
        ((SheafOfModules.forget _).map u)).app U) := by
      intro U
      have hb : Function.Bijective
          (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map
            ((SheafOfModules.forget _).map u)).app U)) := by
        first
          | exact ConcreteCategory.bijective_of_isIso ((𝟙 (wcIntRingSheaf V.left ℓ)).hom.app U)
          | (have hid : (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map
                ((SheafOfModules.forget _).map u)).app U) : _ → _) = id := by
                funext a
                rfl
             rw [hid]
             exact Function.bijective_id)
      have h2 : IsIso ((forget AddCommGrpCat.{u+1}).map (((PresheafOfModules.toPresheaf _).map
            ((SheafOfModules.forget _).map u)).app U)) :=
        (isIso_iff_bijective _).mpr hb
      exact isIso_of_reflects_iso _ (forget AddCommGrpCat.{u+1})
    have h3 : IsIso ((PresheafOfModules.toPresheaf _).map
        ((SheafOfModules.forget _).map u)) := NatIso.isIso_of_isIso_app _
    have h4 : IsIso ((SheafOfModules.forget _).map u) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf _)
    exact isIso_of_reflects_iso u (SheafOfModules.forget _)

  let h : ∀ W' : V.left.ProEt, (wcSliceFunctor S V).obj W' ⟶ V := fun W' =>
    MorphismProperty.Over.homMk W'.hom rfl trivial
  have hcompat : ∀ {W₁ W₂ : V.left.ProEt} (g : W₁ ⟶ W₂),
      (wcSliceFunctor S V).map g ≫ h W₂ = h W₁ := fun g =>
    MorphismProperty.Over.Hom.ext (MorphismProperty.Over.w g)

  let ρ : ∀ Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ), Y.val.obj (Opposite.op V) →
      ((wcIntSliceRes S ℓ V).obj Y).sections := fun Y s =>
    PresheafOfModules.sectionsMk (fun W' => (Y.val.map (h W'.unop).op).hom s) (by
      intro X X' f
      have e := (PresheafOfModules.map_comp_apply Y.val (h X.unop).op
        ((wcSliceFunctor S V).map f.unop).op s).symm
      rw [← op_comp, hcompat f.unop] at e
      exact e)

  have hρnat : ∀ (M N : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (ψ : M ⟶ N)
      (s : M.val.obj (Opposite.op V)),
      PresheafOfModules.sectionsMap ((wcIntSliceRes S ℓ V).map ψ).val (ρ M s) =
        ρ N ((ψ.val.app (Opposite.op V)).hom s) := by
    intro M N ψ s
    apply PresheafOfModules.sections_ext
    intro W'
    refine (PresheafOfModules.sectionsMap_coe _ _ _).trans ?_
    exact PresheafOfModules.naturality_apply ψ.val (h W'.unop).op s

  have hev : ∀ (Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (f : P ⟶ Y),
      ev Y f = (f.val.app (Opposite.op V)).hom (ev P (𝟙 P)) := by
    intro Y f
    rw [← hnat P Y f (𝟙 P), Category.id_comp]
  obtain ⟨ε, hε⟩ : ∃ ε : SheafOfModules.unit (wcIntRingSheaf V.left ℓ) ⟶ (wcIntSliceRes S ℓ V).obj P,
      ε = ((wcIntSliceRes S ℓ V).obj P).unitHomEquiv.symm (ρ P (ev P (𝟙 P))) := ⟨_, rfl⟩
  have hfac : ∀ (Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (f : P ⟶ Y),
      ((wcIntSliceRes S ℓ V).obj Y).unitHomEquiv (ε ≫ (wcIntSliceRes S ℓ V).map f) =
        ρ Y (ev Y f) := by
    intro Y f
    rw [SheafOfModules.unitHomEquiv_comp_apply, hε, Equiv.apply_symm_apply, hev Y f]
    exact hρnat P Y f _

  have hρbij : ∀ Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ), Function.Bijective (ρ Y) := by
    intro Y
    let t : V.left.ProEt := Scheme.ProEt.mk (𝟙 V.left)
    let e' : V ⟶ (wcSliceFunctor S V).obj t :=
      MorphismProperty.Over.homMk (𝟙 V.left)
        (by
          first
            | exact (Category.id_comp (𝟙 V.left ≫ V.hom)).trans (Category.id_comp V.hom)
            | simp [t, wcSliceFunctor, MorphismProperty.Over.map_obj_hom, Scheme.ProEt.mk_hom])
        trivial
    have hee : e' ≫ h t = 𝟙 V :=
      MorphismProperty.Over.Hom.ext (Category.id_comp (𝟙 V.left) : _)
    let bang : ∀ W' : V.left.ProEt, W' ⟶ t := fun W' =>
      MorphismProperty.Over.homMk W'.hom (Category.comp_id W'.hom : _) trivial
    have hW' : ∀ W' : V.left.ProEt, h W' ≫ e' = (wcSliceFunctor S V).map (bang W') := fun W' =>
      MorphismProperty.Over.Hom.ext (Category.comp_id W'.hom : _)
    have hinv : ∀ s : Y.val.obj (Opposite.op V),
        (Y.val.map e'.op).hom ((Y.val.map (h t).op).hom s) = s := by
      intro s
      have e1 := (PresheafOfModules.map_comp_apply Y.val (h t).op e'.op s).symm
      rw [← op_comp, hee, op_id] at e1
      have e2 : ConcreteCategory.hom (Y.val.map (𝟙 (Opposite.op V))) s = s := by
        rw [← PresheafOfModules.presheaf_map_apply_coe]
        first
          | (rw [Y.val.presheaf.map_id]; rfl)
          | simp
          | (erw [CategoryTheory.Functor.map_id]; rfl)
      exact e1.trans e2
    refine ⟨fun s s' hss => ?_, fun σ => ?_⟩
    · have h1 : (Y.val.map (h t).op).hom s = (Y.val.map (h t).op).hom s' := by
        have := congrArg (fun σ : ((wcIntSliceRes S ℓ V).obj Y).sections => σ.1 (Opposite.op t)) hss
        exact this
      exact (hinv s).symm.trans ((congrArg (fun x => (Y.val.map e'.op).hom x) h1).trans (hinv s'))
    · refine ⟨(Y.val.map e'.op).hom (σ.1 (Opposite.op t)), ?_⟩
      apply PresheafOfModules.sections_ext
      intro W'
      have e1 := (PresheafOfModules.map_comp_apply Y.val e'.op (h W'.unop).op
        (σ.1 (Opposite.op t))).symm
      rw [← op_comp, hW'] at e1
      exact e1.trans (PresheafOfModules.sections_property σ (bang W'.unop).op)
  refine ⟨ε, fun Y => ?_, ?_⟩
  ·
    have hfun : (fun f : P ⟶ Y => ε ≫ (wcIntSliceRes S ℓ V).map f) =
        ((wcIntSliceRes S ℓ V).obj Y).unitHomEquiv.symm ∘ ρ Y ∘ ev Y := by
      funext f
      apply ((wcIntSliceRes S ℓ V).obj Y).unitHomEquiv.injective
      simp only [Function.comp_apply, Equiv.apply_symm_apply]
      exact hfac Y f
    rw [hfun]
    exact (Equiv.bijective _).comp ((hρbij Y).comp (Equiv.bijective _))
  ·
    obtain ⟨g, hg⟩ : ∃ g, g = (ev (wcIntUnit S ℓ)).symm
        (show (wcIntUnit S ℓ).val.obj (Opposite.op V) from
          (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op V))) := ⟨_, rfl⟩
    have hr : ev (wcIntUnit S ℓ) g = (show (wcIntUnit S ℓ).val.obj (Opposite.op V) from
          (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op V))) := by
      rw [hg]; exact Equiv.apply_symm_apply _ _
    rw [← hg]
    have hval : ε ≫ (wcIntSliceRes S ℓ V).map g =
        (SheafOfModules.unitToPushforwardObjUnit (F := wcSliceFunctor S V)
          (S := wcIntRingSheaf V.left ℓ) (R := wcIntRingSheaf S ℓ) (𝟙 (wcIntRingSheaf V.left ℓ)) :
          SheafOfModules.unit (wcIntRingSheaf V.left ℓ) ⟶
            (wcIntSliceRes S ℓ V).obj (wcIntUnit S ℓ)) := by
      apply ((wcIntSliceRes S ℓ V).obj (wcIntUnit S ℓ)).unitHomEquiv.injective
      refine (hfac _ g).trans ((congrArg (ρ _) hr).trans ?_)
      apply PresheafOfModules.sections_ext
      intro W'
      first
        | rfl
        | exact ContinuousMap.ext (fun x => rfl)
        | (rw [SheafOfModules.unitHomEquiv_apply_coe,
              SheafOfModules.unitToPushforwardObjUnit_val_app_apply]; rfl)
        | (rw [SheafOfModules.unitHomEquiv_apply_coe]; rfl)
    rw [hval]
    exact hu

theorem wc_int_pull_Phi_slice_iso (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (DV : wcIntPullData V.hom ℓ) (hDV : wcIntPullCanonical DV) :
    Nonempty (DV.Φ ≅ wcIntSliceRes S ℓ V) :=
by
  classical
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
    (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong V.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  let adj₀ : wcSliceFunctor S V ⊣ wcProEtBC V.hom :=
    @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ V.left S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ V.hom _ _ _ V.prop trivial
  have hc' : ∀ W : S.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom V.hom :=
    fun W => rfl
  have hu : ∀ W' : V.left.ProEt, (adj₀.unit.app W').left ≫
      Limits.pullback.fst ((wcSliceFunctor S V).obj W').hom V.hom = 𝟙 W'.left :=
    fun W' => Limits.pullback.lift_fst _ _ _
  have hj : (wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology S) := inferInstance
  letI := DV.cont
  have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcIntRingSheaf S ℓ).obj =
      DV.φ.hom ≫ (wcProEtBC V.hom).op.whiskerLeft
        (𝟙 (wcIntRingSheaf V.left ℓ) : wcIntRingSheaf V.left ℓ ⟶
          ((wcSliceFunctor S V).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj
            (wcIntRingSheaf S ℓ)).hom := by
    ext V' s
    obtain ⟨W⟩ := V'
    show s.comp (adj₀.counit.app W).left.base.hom = (DV.φ.hom.app (Opposite.op W)).hom s
    rw [hDV W s, hc' W]
    try rfl
  have H2 : (𝟙 (wcIntRingSheaf V.left ℓ) : wcIntRingSheaf V.left ℓ ⟶
          ((wcSliceFunctor S V).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj
            (wcIntRingSheaf S ℓ)).hom ≫
      (wcSliceFunctor S V).op.whiskerLeft DV.φ.hom ≫
      Functor.whiskerRight (NatTrans.op adj₀.unit) (wcIntRingSheaf V.left ℓ).obj =
      𝟙 (wcIntRingSheaf V.left ℓ).obj := by
    ext V' t
    obtain ⟨W'⟩ := V'
    show ((DV.φ.hom.app (Opposite.op ((wcSliceFunctor S V).obj W'))).hom t).comp
        (adj₀.unit.app W').left.base.hom = t
    refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
      (hDV ((wcSliceFunctor S V).obj W') t)).trans ?_
    have key : ∀ t : C(↥W'.left, ULift.{u+1} ℤ_[ℓ]),
        ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
          ((wcSliceFunctor S V).obj W').hom V.hom).base.hom)
          (adj₀.unit.app W').left.base.hom = t := by
      intro t
      first
      | (rw [ContinuousMap.comp_assoc, ← TopCat.hom_comp, ← Scheme.Hom.comp_base, hu W',
          Scheme.Hom.id_base, TopCat.hom_id, ContinuousMap.comp_id])
      | (refine ContinuousMap.ext fun x => ?_
         change t _ = t x
         congr 1
         exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
      | (refine ContinuousMap.ext fun x => ?_
         change t _ = t x
         congr 1
         have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
         simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
    exact key t
  exact ⟨Adjunction.leftAdjointUniq DV.adj
    (@SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hj DV.cont adj₀ _ DV.φ H1 H2)⟩

theorem wc_int_slice_res_preserves_injective (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (I : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) [Injective I] :
    Injective ((wcIntSliceRes S ℓ V).obj I) :=
by
  classical
  let j := wcSliceFunctor S V
  let RS := (wcIntRingSheaf S ℓ).obj
  let RT := (wcIntRingSheaf V.left ℓ).obj
  let φs : wcIntRingSheaf V.left ℓ ⟶ (j.sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj (wcIntRingSheaf S ℓ) := 𝟙 _
  let Rp := PresheafOfModules.pushforward.{u+1} (F := j) φs.hom

  have key : ∀ (A : PresheafOfModules.{u+1} RT) {Y : S.ProEt} {Z : V.left.ProEt}
      (b b' : Y ⟶ V) (_ : b = b') (m : wcXzObj S V b ⟶ Z) (m' : wcXzObj S V b' ⟶ Z)
      (_ : m.left = m'.left) (x : A.obj (Opposite.op Z)),
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b
        ((A.map m.op).hom x) =
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) b'
        ((A.map m'.op).hom x) := by
    intro A Y Z b b' hb m m' hm x
    subst hb
    obtain rfl : m = m' := MorphismProperty.Over.Hom.ext hm
    rfl
  have hof : ∀ (A : PresheafOfModules.{u+1} RT) {X Y : S.ProEt} (g : Y ⟶ X) (a : X ⟶ V)
      (y : A.obj (Opposite.op (wcXzObj S V a))),
      wcIntXzMap S ℓ V A g
        (DirectSum.of (fun c : X ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a y) =
      DirectSum.of (fun c : Y ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (g ≫ a)
        ((A.map (wcXzRes S V g a).op).hom y) :=
    fun A X Y g a y => DirectSum.toAddMonoid_of _ _ _
  have hca : ∀ {X : S.ProEt} (a : X ⟶ V), wcXzC S V a ≫ wcXzPt S V (wcXzObj S V a) = a :=
    fun a => MorphismProperty.Over.Hom.ext (by exact Category.id_comp _)
  have hcpt : ∀ W : V.left.ProEt, wcXzC S V (wcXzPt S V W) = 𝟙 _ :=
    fun W => MorphismProperty.Over.Hom.ext rfl
  let sharpApp : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M) (X : (S.ProEt)ᵒᵖ), wcIntXzSum S ℓ V A X.unop →+ M.obj X :=
    fun A M θ X => DirectSum.toAddMonoid (fun a =>
      (M.map (wcXzC S V a).op).hom.toAddMonoidHom.comp
        (θ.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)
  have sharp_of : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M) (X : (S.ProEt)ᵒᵖ) (a : X.unop ⟶ V)
      (y : A.obj (Opposite.op (wcXzObj S V a))),
      sharpApp A M θ X
        (DirectSum.of (fun c : X.unop ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a y) =
      (M.map (wcXzC S V a).op).hom ((θ.app (Opposite.op (wcXzObj S V a))).hom y) :=
    fun A M θ X a y => DirectSum.toAddMonoid_of _ _ _
  let sharpHom : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (A ⟶ Rp.obj M) → (wcIntXzLp0 S ℓ V A ⟶ M) := fun A M θ =>
    PresheafOfModules.homMk
      { app := fun X => AddCommGrpCat.ofHom (sharpApp A M θ X)
        naturality := fun X Y f => by
          apply AddCommGrpCat.hom_ext
          apply DirectSum.addHom_ext
          intro a y
          show sharpApp A M θ Y (wcIntXzMap S ℓ V A f.unop (DirectSum.of _ a y)) =
            (M.map f).hom (sharpApp A M θ X (DirectSum.of _ a y))
          have hcc0 : wcXzC S V (f.unop ≫ a) ≫ j.map (wcXzRes S V f.unop a) =
              f.unop ≫ wcXzC S V a :=
            MorphismProperty.Over.Hom.ext
              (by exact (Category.id_comp _).trans (Category.comp_id _).symm)
          have hcc : (j.map (wcXzRes S V f.unop a)).op ≫ (wcXzC S V (f.unop ≫ a)).op =
              (wcXzC S V a).op ≫ f := by
            rw [← op_comp, hcc0, op_comp, Quiver.Hom.op_unop]
          rw [hof]
          refine (sharp_of A M θ Y (f.unop ≫ a) _).trans ?_
          refine Eq.trans ?_ (congrArg (M.map f).hom (sharp_of A M θ X a y)).symm
          refine (congrArg (M.map (wcXzC S V (f.unop ≫ a)).op).hom
            (PresheafOfModules.naturality_apply θ (wcXzRes S V f.unop a).op y)).trans ?_
          refine (PresheafOfModules.map_comp_apply M (j.map (wcXzRes S V f.unop a)).op
            (wcXzC S V (f.unop ≫ a)).op _).symm.trans ?_
          refine Eq.trans ?_ (PresheafOfModules.map_comp_apply M (wcXzC S V a).op f _)
          rw [hcc] }
      (by
        intro X r
        letI := wcIntXzSMod S ℓ V A X.unop
        show ∀ m : wcIntXzSum S ℓ V A X.unop, sharpApp A M θ X (r • m) = r • sharpApp A M θ X m
        intro m
        induction m using DirectSum.induction_on with
        | zero => rw [smul_zero, map_zero, smul_zero]
        | of a y =>
          have h2 : (r • DirectSum.of (fun b : X.unop ⟶ V =>
                (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a y : wcIntXzSum S ℓ V A X.unop) =
              DirectSum.of (fun b : X.unop ⟶ V =>
                (A.obj (Opposite.op (wcXzObj S V b)) : Type (u+1))) a (r • y) :=
            (DirectSum.of_smul _ _ _ _).symm
          rw [h2, sharp_of, sharp_of]
          have h1 := (θ.app (Opposite.op (wcXzObj S V a))).hom.map_smul r y
          have h3 := PresheafOfModules.map_smul M (wcXzC S V a).op r
            ((θ.app (Opposite.op (wcXzObj S V a))).hom y)
          exact (congrArg (M.map (wcXzC S V a).op).hom h1).trans h3
        | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add])
  let flatHom : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (wcIntXzLp0 S ℓ V A ⟶ M) → (A ⟶ Rp.obj M) := fun A M φ =>
    PresheafOfModules.homMk
      { app := fun W => AddCommGrpCat.ofHom
          ((φ.app (Opposite.op (j.obj W.unop))).hom.toAddMonoidHom.comp
            (DirectSum.of (fun c : j.obj W.unop ⟶ V =>
              (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (wcXzPt S V W.unop)))
        naturality := fun W1 W2 g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro y
          show (φ.app (Opposite.op (j.obj W2.unop))).hom
              (DirectSum.of _ (wcXzPt S V W2.unop) ((A.map g).hom y)) =
            (M.map (j.map g.unop).op).hom ((φ.app (Opposite.op (j.obj W1.unop))).hom
              (DirectSum.of _ (wcXzPt S V W1.unop) y))
          refine Eq.trans ?_ (PresheafOfModules.naturality_apply φ (j.map g.unop).op _)
          refine congrArg (φ.app (Opposite.op (j.obj W2.unop))).hom ?_
          refine Eq.symm ((hof A (j.map g.unop) (wcXzPt S V W1.unop) y).trans ?_)
          have hb : j.map g.unop ≫ wcXzPt S V W1.unop = wcXzPt S V W2.unop :=
            MorphismProperty.Over.Hom.ext (by exact MorphismProperty.Over.w g.unop)
          exact key A (Z := W1.unop) _ _ hb (wcXzRes S V (j.map g.unop) (wcXzPt S V W1.unop))
            g.unop rfl y }
      (by
        intro W r y
        letI := wcIntXzSMod S ℓ V A (j.obj W.unop)
        exact (congrArg (φ.app (Opposite.op (j.obj W.unop))).hom
          (DirectSum.of_smul _ _ _ _)).trans
          ((φ.app (Opposite.op (j.obj W.unop))).hom.map_smul r _))
  have hmidM : ∀ (M : PresheafOfModules.{u+1} RS) {X : S.ProEt} (m : X ⟶ X), m = 𝟙 X →
      ∀ z : M.obj (Opposite.op X), (M.map m.op).hom z = z := by
    intro M X m hm z
    subst hm
    rw [op_id, ← PresheafOfModules.presheaf_map_apply_coe, M.presheaf.map_id]
    rfl
  have hmidA : ∀ (A : PresheafOfModules.{u+1} RT) {W : V.left.ProEt} (m : W ⟶ W), m = 𝟙 W →
      ∀ z : A.obj (Opposite.op W), (A.map m.op).hom z = z := by
    intro A W m hm z
    subst hm
    rw [op_id, ← PresheafOfModules.presheaf_map_apply_coe, A.presheaf.map_id]
    rfl
  have hcomp : ∀ (A : PresheafOfModules.{u+1} RT) {X : S.ProEt} (a : X ⟶ V)
      (z : A.obj (Opposite.op (wcXzObj S V a))),
      wcIntXzMap S ℓ V A (wcXzC S V a)
        (DirectSum.of (fun c : j.obj (wcXzObj S V a) ⟶ V =>
          (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) (wcXzPt S V (wcXzObj S V a)) z) =
      DirectSum.of (fun c : X ⟶ V => (A.obj (Opposite.op (wcXzObj S V c)) : Type (u+1))) a z := by
    intro A X a z
    refine (hof A (wcXzC S V a) (wcXzPt S V (wcXzObj S V a)) z).trans ?_
    refine (key A (Z := wcXzObj S V a) _ _ (hca a)
      (wcXzRes S V (wcXzC S V a) (wcXzPt S V (wcXzObj S V a))) (𝟙 (wcXzObj S V a)) rfl z).trans ?_
    exact congrArg _ (hmidA A (𝟙 _) rfl z)
  have hls : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (φ : wcIntXzLp0 S ℓ V A ⟶ M), sharpHom A M (flatHom A M φ) = φ := by
    intro A M φ
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.toAddMonoidHom_injective
    apply DirectSum.addHom_ext
    intro a y
    show sharpApp A M (flatHom A M φ) X (DirectSum.of _ a y) = (φ.app X).hom (DirectSum.of _ a y)
    refine (sharp_of A M (flatHom A M φ) X a y).trans ?_
    show (M.map (wcXzC S V a).op).hom ((φ.app (Opposite.op (j.obj (wcXzObj S V a)))).hom
      (DirectSum.of _ (wcXzPt S V (wcXzObj S V a)) y)) = _
    refine (PresheafOfModules.naturality_apply φ (wcXzC S V a).op _).symm.trans ?_
    exact congrArg (φ.app X).hom (hcomp A a y)
  have hrs : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS)
      (θ : A ⟶ Rp.obj M), flatHom A M (sharpHom A M θ) = θ := by
    intro A M θ
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    show sharpApp A M θ (Opposite.op (j.obj W.unop)) (DirectSum.of _ (wcXzPt S V W.unop) y) =
      (θ.app W).hom y
    refine (sharp_of A M θ (Opposite.op (j.obj W.unop)) (wcXzPt S V W.unop) y).trans ?_
    exact hmidM M (X := j.obj W.unop) (wcXzC S V (wcXzPt S V W.unop)) (hcpt W.unop) _
  let e : ∀ (A : PresheafOfModules.{u+1} RT) (M : PresheafOfModules.{u+1} RS),
      (wcIntXzLp0 S ℓ V A ⟶ M) ≃ (A ⟶ Rp.obj M) := fun A M =>
    { toFun := flatHom A M
      invFun := sharpHom A M
      left_inv := hls A M
      right_inv := hrs A M }
  have he : ∀ (A : PresheafOfModules.{u+1} RT) (M M' : PresheafOfModules.{u+1} RS)
      (g : M ⟶ M') (h : wcIntXzLp0 S ℓ V A ⟶ M), e A M' (h ≫ g) = e A M h ≫ Rp.map g := by
    intro A M M' g h
    apply PresheafOfModules.hom_ext
    intro W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    rfl
  let Lp := Adjunction.leftAdjointOfEquiv (G := Rp) (F_obj := wcIntXzLp0 S ℓ V) e he
  let adjP : Lp ⊣ Rp := Adjunction.adjunctionOfEquivLeft e he
  haveI hmono : Lp.PreservesMonomorphisms := ⟨fun {A A'} f hf => by
    have hf' := (PresheafOfModules.mono_iff_surjective f).1 hf
    apply PresheafOfModules.mono_of_injective
    intro X
    have hLmap : Lp.map f = sharpHom A (wcIntXzLp0 S ℓ V A')
        (f ≫ flatHom A' (wcIntXzLp0 S ℓ V A') (𝟙 _)) :=
      Adjunction.leftAdjointOfEquiv_map e he f
    have hEq : ((Lp.map f).app X).hom.toAddMonoidHom =
        DirectSum.map (fun a : X.unop ⟶ V =>
          (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom) := by
      apply DirectSum.addHom_ext
      intro a y
      refine Eq.trans ?_ (DirectSum.map_of (fun a : X.unop ⟶ V =>
          (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom) a y).symm
      rw [hLmap]
      show sharpApp A (wcIntXzLp0 S ℓ V A') (f ≫ flatHom A' (wcIntXzLp0 S ℓ V A') (𝟙 _)) X
        (DirectSum.of _ a y) = _
      refine (sharp_of A _ _ X a y).trans ?_
      exact hcomp A' a ((f.app (Opposite.op (wcXzObj S V a))).hom y)
    intro x y hxy
    have h2 : (DirectSum.map (fun a : X.unop ⟶ V =>
        (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)) x =
        (DirectSum.map (fun a : X.unop ⟶ V =>
        (f.app (Opposite.op (wcXzObj S V a))).hom.toAddMonoidHom)) y := by
      rw [← hEq]
      exact hxy
    exact (DirectSum.map_injective _).2 (fun a => hf' (X := Opposite.op (wcXzObj S V a))) h2⟩

  have s1 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C)
      (K : GrothendieckTopology D) [HasSheafify K AddCommGrpCat.{u+1}]
      [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (F : C ⥤ D) [F.IsContinuous J K]
      (S₀ : Sheaf J RingCat.{u+1}) (R₀ : Sheaf K RingCat.{u+1})
      (φ : S₀ ⟶ (F.sheafPushforwardContinuous RingCat.{u+1} J K).obj R₀)
      (L₀ : PresheafOfModules.{u+1} S₀.obj ⥤ PresheafOfModules.{u+1} R₀.obj)
      (_ : L₀ ⊣ PresheafOfModules.pushforward.{u+1} (F := F) φ.hom) [L₀.PreservesMonomorphisms]
      (I₀ : SheafOfModules.{u+1} R₀) [Injective I₀],
      Injective ((SheafOfModules.pushforward.{u+1} φ).obj I₀) := by
    intro C D _ _ J K _ _ F _ S₀ R₀ φ L₀ adj₀ _ I₀ _
    let adjS := adj₀.comp (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R₀.obj))
    let adjL := Adjunction.restrictFullyFaithful
      (iC := SheafOfModules.forget S₀) (iD := 𝟭 (SheafOfModules.{u+1} R₀))
      (L := SheafOfModules.forget S₀ ⋙ L₀ ⋙ PresheafOfModules.sheafification.{u+1} (𝟙 R₀.obj))
      (R := SheafOfModules.pushforward.{u+1} φ)
      adjS (SheafOfModules.fullyFaithfulForget _) (Functor.FullyFaithful.id _)
      (Iso.refl _) (Iso.refl _)
    exact Injective.injective_of_adjoint adjL I₀
  exact s1 (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S) j
    (wcIntRingSheaf V.left ℓ) (wcIntRingSheaf S ℓ) φs Lp adjP I

theorem wc_int_open_kernel_tors_restrict_injective {S T : Scheme.{u}} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    (j : T ⟶ S) [IsClosedImmersion j] (D : wcHMPullData j ℓ) (hD : wcHMPullCanonical D)
    (O : S.Opens) (hO : (O : Set S) = (Set.range j)ᶜ)
    (Do : wcIntPullData O.ι ℓ) (hDo : wcIntPullCanonical Do)
    (ε : wcIntUnit O ℓ ⟶ Do.Φ.obj (Limits.kernel (wcIntSuppπ D)))
    (hε : ε ≫ Do.Φ.map (Limits.kernel.ι (wcIntSuppπ D)) = Do.μ.inv) (k p : ℕ)
    (ν : Do.Φ.obj (wcIntTors S ℓ k) ⟶ wcIntTors O ℓ k)
    (hν : Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫ ν =
      Do.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ))) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) := HasExt.standard _
    haveI := Do.additive; haveI := Do.presLim; haveI := Do.presColim
    Function.Injective (fun β : Abelian.Ext (Limits.kernel (wcIntSuppπ D)) (wcIntTors S ℓ k) p =>
      (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
        (Abelian.Ext.mk₀ ν) (add_zero p)) (zero_add p)) :=
by
  classical
  letI instS : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  letI instO : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf O ℓ)) := HasExt.standard _
  haveI := Do.additive
  haveI := Do.presLim
  haveI := Do.presColim
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ)

  obtain ⟨hc, -, -⟩ := wc_lpsc_site S (Scheme.ProEt.mk O.ι)
  haveI := hc
  obtain ⟨P, jP, ev, hmono, hiso, hnat, hone⟩ := wc_int_open_kernel_free_corep_data ℓ j D hD O hO
  obtain ⟨εs, hbij, hval⟩ := wc_int_slice_res_free_corep S ℓ (Scheme.ProEt.mk O.ι) P ev hnat
  obtain ⟨θ⟩ := wc_int_pull_Phi_slice_iso S ℓ (Scheme.ProEt.mk O.ι) Do hDo

  have hg1 : jP ≫ Limits.kernel.ι (wcIntSuppπ D) = (ev (wcIntUnit S ℓ)).symm
      (show (wcIntUnit S ℓ).val.obj (Opposite.op (Scheme.ProEt.mk O.ι)) from
        (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk O.ι)))) :=
    (Equiv.eq_symm_apply _).mpr hone
  have hisoR : IsIso (εs ≫ (wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).map
      (jP ≫ Limits.kernel.ι (wcIntSuppπ D))) := by
    rw [hg1]; exact hval
  have hnatε : ∀ {Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (f : P ⟶ Y),
      (εs ≫ θ.inv.app P) ≫ Do.Φ.map f =
        (εs ≫ (wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).map f) ≫ θ.inv.app Y := by
    intro Y f
    exact (Category.assoc _ _ _).trans ((congrArg (εs ≫ ·) (θ.inv.naturality f).symm).trans
      (Category.assoc _ _ _).symm)
  haveI := hisoR
  let aIso := asIso (εs ≫ (wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).map
      (jP ≫ Limits.kernel.ι (wcIntSuppπ D))) ≪≫ (θ.app (wcIntUnit S ℓ)).symm
  have haIso' : aIso.hom = (εs ≫ (wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).map
      (jP ≫ Limits.kernel.ι (wcIntSuppπ D))) ≫ θ.inv.app (wcIntUnit S ℓ) := rfl
  have haIso : (εs ≫ θ.inv.app P) ≫ Do.Φ.map (jP ≫ Limits.kernel.ι (wcIntSuppπ D)) =
      aIso.hom := (hnatε _).trans haIso'.symm
  let cIso := Do.μ.symm ≪≫ aIso.symm
  obtain ⟨ε'', hε''def⟩ : ∃ x : wcIntUnit O ℓ ⟶ Do.Φ.obj P,
      x = cIso.hom ≫ (εs ≫ θ.inv.app P) := ⟨_, rfl⟩
  have hε''1 : ε'' ≫ Do.Φ.map (jP ≫ Limits.kernel.ι (wcIntSuppπ D)) = Do.μ.inv := by
    calc ε'' ≫ Do.Φ.map (jP ≫ Limits.kernel.ι (wcIntSuppπ D))
        = (cIso.hom ≫ (εs ≫ θ.inv.app P)) ≫ Do.Φ.map (jP ≫ Limits.kernel.ι (wcIntSuppπ D)) :=
          congrArg (· ≫ Do.Φ.map (jP ≫ Limits.kernel.ι (wcIntSuppπ D))) hε''def
      _ = cIso.hom ≫ ((εs ≫ θ.inv.app P) ≫ Do.Φ.map (jP ≫ Limits.kernel.ι (wcIntSuppπ D))) :=
          Category.assoc _ _ _
      _ = cIso.hom ≫ aIso.hom := congrArg (cIso.hom ≫ ·) haIso
      _ = Do.μ.inv ≫ (aIso.inv ≫ aIso.hom) := Category.assoc Do.μ.inv aIso.inv aIso.hom
      _ = Do.μ.inv ≫ 𝟙 _ := congrArg (Do.μ.inv ≫ ·) aIso.inv_hom_id
      _ = Do.μ.inv := Category.comp_id _
  haveI hm : Mono (Do.Φ.map (Limits.kernel.ι (wcIntSuppπ D))) := inferInstance
  have hε'' : ε'' ≫ Do.Φ.map jP = ε := by
    apply (cancel_mono (Do.Φ.map (Limits.kernel.ι (wcIntSuppπ D)))).mp
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (ε'' ≫ ·) (Do.Φ.map_comp jP (Limits.kernel.ι (wcIntSuppπ D))).symm).trans ?_
    exact hε''1.trans hε.symm
  have hhom : ∀ Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ),
      Function.Bijective (fun f : P ⟶ Y => ε'' ≫ Do.Φ.map f) := by
    intro Y
    have hpc := (Iso.homCongr cIso.symm (θ.app Y).symm).bijective
    have heq : (fun f : P ⟶ Y => ε'' ≫ Do.Φ.map f) =
        (Iso.homCongr cIso.symm (θ.app Y).symm) ∘
          (fun f : P ⟶ Y => εs ≫ (wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).map f) := by
      funext f
      show ε'' ≫ Do.Φ.map f =
        cIso.hom ≫ (εs ≫ (wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).map f) ≫ θ.inv.app Y
      calc ε'' ≫ Do.Φ.map f = (cIso.hom ≫ (εs ≫ θ.inv.app P)) ≫ Do.Φ.map f :=
            congrArg (· ≫ Do.Φ.map f) hε''def
        _ = cIso.hom ≫ ((εs ≫ θ.inv.app P) ≫ Do.Φ.map f) := Category.assoc _ _ _
        _ = cIso.hom ≫ ((εs ≫ (wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).map f) ≫
              θ.inv.app Y) := congrArg (cIso.hom ≫ ·) (hnatε f)
    rw [heq]
    exact hpc.comp (hbij Y)

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) [Injective I] (n : ℕ)
      (e : Abelian.Ext (wcIntUnit O ℓ) (Do.Φ.obj I) (n + 1)), e = 0 := by
    intro I hI n e
    have hRI : Injective ((wcIntSliceRes S ℓ (Scheme.ProEt.mk O.ι)).obj I) :=
      wc_int_slice_res_preserves_injective S ℓ (Scheme.ProEt.mk O.ι) I
    haveI : Injective (Do.Φ.obj I) := Injective.of_iso (θ.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective e
  have hT := ext_transfer_of_corep Do.Φ P (wcIntUnit O ℓ) ε'' hhom hvan (wcIntTors S ℓ k) p

  have hnπ : (ℓ ^ k : ℕ) • Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) = 0 := by
    have h0 := Limits.cokernel.condition ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))
    rwa [Preadditive.nsmul_comp, Category.id_comp] at h0
  have hw : ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ)) ≫
      (Do.μ.inv ≫ Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))) = 0 := by
    rw [Preadditive.nsmul_comp, Category.id_comp, ← Preadditive.comp_nsmul, ← Functor.map_nsmul,
      hnπ, Functor.map_zero, Limits.comp_zero]
  obtain ⟨ν', hν'def⟩ : ∃ x, x = Limits.cokernel.desc ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit O ℓ))
      (Do.μ.inv ≫ Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))) hw := ⟨_, rfl⟩
  haveI hepi : Epi (Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))) :=
    inferInstance
  have hνν' : ν ≫ ν' = 𝟙 _ := by
    apply (cancel_epi (Do.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ))))).mp
    rw [← Category.assoc, hν, Category.assoc, hν'def, Limits.cokernel.π_desc,
      Iso.hom_inv_id_assoc, Category.comp_id]
  have hpost : Function.Injective
      (fun z : Abelian.Ext (wcIntUnit O ℓ) (Do.Φ.obj (wcIntTors S ℓ k)) p =>
        z.comp (Abelian.Ext.mk₀ ν) (add_zero p)) := by
    intro z₁ z₂ h
    have h' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ ν') (add_zero p)) h
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hνν',
      Abelian.Ext.comp_mk₀_id] at h'
    exact h'

  have hY : (ℓ ^ k : ℕ) • 𝟙 (wcIntTors S ℓ k) = 0 := by
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)))).mp
    rw [Preadditive.comp_nsmul, Category.comp_id, hnπ, Limits.comp_zero]
  have hscal : ∀ (n : ℕ) (z : Abelian.Ext (Limits.cokernel jP) (wcIntTors S ℓ k) p),
      (Abelian.Ext.mk₀ (n • 𝟙 (Limits.cokernel jP))).comp z (zero_add p) =
        z.comp (Abelian.Ext.mk₀ (n • 𝟙 (wcIntTors S ℓ k))) (add_zero p) := by
    intro n z
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.mk₀_zero,
        Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp,
        Abelian.Ext.comp_add, ih, Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_mk₀_id]
  have hQ0 : ∀ z : Abelian.Ext (Limits.cokernel jP) (wcIntTors S ℓ k) p, z = 0 := by
    intro z
    haveI : IsIso ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel jP)) := hiso k
    have h1 : (Abelian.Ext.mk₀ ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel jP))).comp z (zero_add p) = 0 := by
      rw [hscal, hY, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    calc z = (Abelian.Ext.mk₀ (inv ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel jP)) ≫
          ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel jP)))).comp z (zero_add p) := by
          rw [IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      _ = (Abelian.Ext.mk₀ (inv ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel jP)))).comp
            ((Abelian.Ext.mk₀ ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel jP))).comp z (zero_add p))
            (zero_add p) := by
          rw [← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add p) (by omega : 0 + 0 + p = p)]
      _ = 0 := by rw [h1, Abelian.Ext.comp_zero]
  have hpre : Function.Injective
      (fun β : Abelian.Ext (Limits.kernel (wcIntSuppπ D)) (wcIntTors S ℓ k) p =>
        (Abelian.Ext.mk₀ jP).comp β (zero_add p)) := by
    let SC : ShortComplex (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) :=
      ShortComplex.mk jP (Limits.cokernel.π jP) (Limits.cokernel.condition jP)
    have hS : SC.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel jP) inferInstance inferInstance
    have hker : ∀ β : Abelian.Ext (Limits.kernel (wcIntSuppπ D)) (wcIntTors S ℓ k) p,
        (Abelian.Ext.mk₀ jP).comp β (zero_add p) = 0 → β = 0 := by
      intro β hβ
      obtain ⟨y, hy⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS (wcIntTors S ℓ k) β hβ
      have hy0 : y = 0 := hQ0 y
      rw [← hy, hy0, Abelian.Ext.comp_zero]
    let Φh : Abelian.Ext (Limits.kernel (wcIntSuppπ D)) (wcIntTors S ℓ k) p →+
        Abelian.Ext P (wcIntTors S ℓ k) p :=
      AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ jP).comp β (zero_add p))
        (fun a b => Abelian.Ext.comp_add _ _ _ _)
    exact (injective_iff_map_eq_zero Φh).mpr hker

  have hfac : (fun β : Abelian.Ext (Limits.kernel (wcIntSuppπ D)) (wcIntTors S ℓ k) p =>
      (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
        (Abelian.Ext.mk₀ ν) (add_zero p)) (zero_add p)) =
      (fun z : Abelian.Ext (wcIntUnit O ℓ) (Do.Φ.obj (wcIntTors S ℓ k)) p =>
        z.comp (Abelian.Ext.mk₀ ν) (add_zero p)) ∘
      (fun β' : Abelian.Ext P (wcIntTors S ℓ k) p =>
        (Abelian.Ext.mk₀ ε'').comp (Abelian.Ext.mapExactFunctor Do.Φ β') (zero_add p)) ∘
      (fun β : Abelian.Ext (Limits.kernel (wcIntSuppπ D)) (wcIntTors S ℓ k) p =>
        (Abelian.Ext.mk₀ jP).comp β (zero_add p)) := by
    funext β
    have e0 : Abelian.Ext.mapExactFunctor Do.Φ ((Abelian.Ext.mk₀ jP).comp β (zero_add p)) =
        (Abelian.Ext.mk₀ (Do.Φ.map jP)).comp (Abelian.Ext.mapExactFunctor Do.Φ β) (zero_add p) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e1 : (Abelian.Ext.mk₀ ε'').comp ((Abelian.Ext.mk₀ (Do.Φ.map jP)).comp
        (Abelian.Ext.mapExactFunctor Do.Φ β) (zero_add p)) (zero_add p) =
        (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor Do.Φ β) (zero_add p) := by
      have e2 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ε'') (Abelian.Ext.mk₀ (Do.Φ.map jP))
        (Abelian.Ext.mapExactFunctor Do.Φ β) (zero_add 0) (zero_add p) (by omega : 0 + 0 + p = p)
      refine e2.symm.trans ?_
      rw [Abelian.Ext.mk₀_comp_mk₀, hε'']
    show (Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor Do.Φ β).comp
        (Abelian.Ext.mk₀ ν) (add_zero p)) (zero_add p) =
      ((Abelian.Ext.mk₀ ε'').comp (Abelian.Ext.mapExactFunctor Do.Φ
        ((Abelian.Ext.mk₀ jP).comp β (zero_add p))) (zero_add p)).comp
        (Abelian.Ext.mk₀ ν) (add_zero p)
    rw [e0]
    refine (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm.trans ?_
    exact congrArg (fun z => z.comp (Abelian.Ext.mk₀ ν) (add_zero p)) e1.symm
  rw [hfac]
  exact hpost.comp (hT.1.comp hpre)

theorem wc_int_tors_wlocal_closed_point_continuity {W₀ T : Scheme.{u}} (haff : IsAffine W₀)
    (hc : IsClosed {x : W₀ | IsClosed ({x} : Set W₀)})
    (hu : ∀ x : W₀, ∃! y : W₀, IsClosed ({y} : Set W₀) ∧ x ⤳ y)
    (g : T ⟶ W₀) (hqc : QuasiCompact g) (hqs : QuasiSeparated g) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (k q : ℕ) (z : W₀) (hz : IsClosed ({z} : Set W₀))
    (Dz : wcIntPullData (Limits.pullback.snd (W₀.fromSpecStalk z) g) ℓ)
    (hDz : wcIntPullCanonical Dz)
    (νz : Dz.Φ.obj (wcIntTors T ℓ k) ⟶
      wcIntTors (Limits.pullback (W₀.fromSpecStalk z) g) ℓ k)
    (hνz : Dz.Φ.map (Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit T ℓ))) ≫ νz =
      Dz.μ.hom ≫ Limits.cokernel.π ((ℓ ^ k : ℕ) • 𝟙
