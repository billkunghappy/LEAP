  have hET : wcIntResExact T ℓ k := hexact T _ _ _
  have hEU : wcIntResExact (Limits.pullback (W₀.fromSpecStalk z) g) ℓ k := hexact _ _ _ _



  obtain ⟨wT, ⟨HT⟩⟩ := wc_int_unitRestrict_tors_cokernel T ℓ k
