    change (h.val.app (Opposite.op V)).hom
      (((Limits.kernel.ι (wcZModSuppUnitMap Dz)).val.app (Opposite.op V)).hom x) = 0
    generalize ((Limits.kernel.ι (wcZModSuppUnitMap Dz)).val.app (Opposite.op V)).hom x = s at hk ⊢
    have hs := hvan V s hk
