  obtain ⟨hTrT, -⟩ := wc_int_red_transfer T ℓ
  obtain ⟨hTrU, -⟩ := wc_int_red_transfer (Limits.pullback (W₀.fromSpecStalk z) g) ℓ
  let eT := AddEquiv.ofBijective (wcIntRedTr T ℓ k q) (hTrT k q)
  let h := eT.symm (x.comp (Abelian.Ext.mk₀ cT) (add_zero q))
  have hTh : wcIntRedTr T ℓ k q h = x.comp (Abelian.Ext.mk₀ cT) (add_zero q) :=
