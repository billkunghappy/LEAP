            (𝟙 R₀.obj)).mapCocone c₀) :=
        Limits.isColimitOfPreserves _ h₀
      have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R₀).mapCocone
          ((PresheafOfModules.sheafification (J := Scheme.ProEt.topology S)
            (𝟙 R₀.obj)).mapCocone c₀)) :=
        Limits.IsColimit.ofIsoColimit
          (Limits.isColimitOfPreserves
            (PresheafOfModules.sheafification (J := Scheme.ProEt.topology S) (𝟙 R₀.obj) ⋙
