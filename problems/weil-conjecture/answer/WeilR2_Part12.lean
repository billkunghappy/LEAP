        (wcProEtBC (Limits.pullback.fst (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)))
        _ _ Dz.cont Dz.φ).map
          (wcHMFun (Limits.pullback (V.left.fromSpecStalk z) (Limits.pullback.fst V.hom i)) ℓ
            (a.comp (Limits.pullback.snd (V.left.fromSpecStalk z)
              (Limits.pullback.fst V.hom i)).base.hom))) γz
        (wcSuppPullExt DV Ez (2 * r) w)).symm
    refine hA.trans (hB.trans (hC.trans ?_))
    rw [hspec z zt hzt a, hfc]
    exact wc_supp_ext_scalar_central _ ℓ Dz hDz (2 * r) _ (a zt).down

  have hρsub : ∀ (z : V.left) (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ)
      (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ)
      (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
      letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
      ∀ (y w : wcSuppExt DV (2 * r)),
      (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) (y - w)) (zero_add _) =
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) y) (zero_add _) -
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) w) (zero_add _) := by
    intro z Ez Dz γz y w
    letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
    haveI := Ez.additive
    haveI := Ez.presLim
    haveI := Ez.presColim
    have hadd : ∀ (y' w' : wcSuppExt DV (2 * r)),
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) (y' + w')) (zero_add _) =
          (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) y') (zero_add _) +
          (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) w') (zero_add _) := by
      intro y' w'
      unfold wcSuppPullExt
      rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add]
    rw [eq_sub_iff_add_eq, ← hadd, sub_add_cancel]

  have Sh : ∀ (z : V.left) (zt : ↥(Limits.pullback V.hom i)),
      (Limits.pullback.fst V.hom i) zt = z →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        ∀ (c' c₀ : ℚ_[ℓ]),
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) x) (zero_add _) =
          ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
            (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c')) (add_zero _) →
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r)
          (@HSub.hSub (wcSuppExt DV (2 * r)) (wcSuppExt DV (2 * r)) (wcSuppExt DV (2 * r))
            instHSub x
            ((Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst V.hom i)) _ _ DV.cont DV.φ).map
              (wcHMFun (Limits.pullback V.hom i) ℓ
                (ContinuousMap.const _ (ULift.up c₀))))).comp t (zero_add (2 * r)))))
          (zero_add _) =
          ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
            (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c₀)))
            (add_zero _) := by
    intro z zt hzt Ez hEz Dz hDz γz hγz hepiz c' c₀ hx
    letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
    have h2 := F z zt hzt Ez hEz Dz hDz γz hγz hepiz
      (ContinuousMap.const _ (ULift.up c₀)) t
    have hK : wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c' =
        wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c₀) +
          wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c₀ := by
      rw [← (wc_hm_const_ring _ ℓ).2.2, sub_add_cancel]
    have hfin : ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c')) (add_zero _) -
        ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c₀)) (add_zero _) =
        ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (c' - c₀)))
          (add_zero _) := by
      rw [hK, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
      exact add_sub_cancel_right _ _
    exact (hρsub z Ez Dz γz x _).trans
      ((congrArg₂ (fun a b => a - b) hx h2).trans hfin)

  have key : ∀ zt : ↥(Limits.pullback V.hom i), ∃ c : ℚ_[ℓ],
      IsClosed ({(Limits.pullback.fst V.hom i) zt} : Set V.left) →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt)) ℓ)
        (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst
          (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt))
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk ((Limits.pullback.fst V.hom i) zt))) ℓ)) :=
          HasExt.standard _
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) x) (zero_add _) =
          ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
            (Abelian.Ext.mk₀ (wcHMConst
              (Spec (V.left.presheaf.stalk ((Limits.pullback.fst V.hom i) zt))) ℓ c))
            (add_zero _) := by
    intro zt
    by_cases hcl : IsClosed ({(Limits.pullback.fst V.hom i) zt} : Set V.left)
    · obtain ⟨E₀, hE₀, D₀, hD₀, γ₀, hγ₀, hepi₀⟩ := H0 _ hcl
      letI : HasExt (SheafOfModules.{u+1}
        (wcRingSheaf (Spec (V.left.presheaf.stalk ((Limits.pullback.fst V.hom i) zt))) ℓ)) :=
        HasExt.standard _
      obtain ⟨c₀, hc₀, -⟩ := H1 _ hcl ⟨zt, rfl⟩ E₀ hE₀ D₀ hD₀ γ₀ hγ₀ hepi₀
        ((Abelian.Ext.mk₀ γ₀).comp (wcSuppPullExt DV E₀ (2 * r) x) (zero_add _))
      have hy0 := Sh _ zt rfl E₀ hE₀ D₀ hD₀ γ₀ hγ₀ hepi₀ c₀ c₀ hc₀
      rw [show c₀ - c₀ = (0 : ℚ_[ℓ]) from sub_self c₀, hK0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero] at hy0
      refine ⟨c₀, fun _ Ez hEz Dz hDz γz hγz hepiz => ?_⟩
      obtain ⟨c', hc', -⟩ := H1 _ hcl ⟨zt, rfl⟩ Ez hEz Dz hDz γz hγz hepiz
        ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) x) (zero_add _))
      have hshift := Sh _ zt rfl Ez hEz Dz hDz γz hγz hepiz c' c₀ hc'
      have hcc : c' = c₀ := by
        by_contra hne
        have hpos : 0 < ‖c' - c₀‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
        obtain ⟨W, -, hzW, hW⟩ := wc_wcontr_supp_top_coord_small_near_zero K pY n m r hmr i ℓ hℓ
          V h1 h2 h3 h4 h5 DV hDV hepi t H0 H1 _ _ hcl ⟨zt, rfl⟩ E₀ hE₀ D₀ hD₀ γ₀ hγ₀ hepi₀
          hy0 _ hpos
        exact lt_irrefl _ (hW _ hzW hcl ⟨zt, rfl⟩ Ez hEz Dz hDz γz hγz hepiz _ hshift)
      rw [hcc] at hc'
      exact hc'
    · exact ⟨0, fun h => absurd h hcl⟩
  choose c hc using key

  have hr : ∀ p : ↥(Limits.pullback V.hom i), ∃ q : ↥(Limits.pullback V.hom i),
      p ⤳ q ∧ IsClosed ({(Limits.pullback.fst V.hom i) q} : Set V.left) := by
    intro p
    obtain ⟨y, ⟨hyc, hpy⟩, -⟩ := h3 ((Limits.pullback.fst V.hom i) p)
    obtain ⟨q, hq⟩ : y ∈ Set.range ⇑(Limits.pullback.fst V.hom i) :=
      hpy.mem_closed (Limits.pullback.fst V.hom i).isClosedEmbedding.isClosed_range ⟨p, rfl⟩
    refine ⟨q, ?_, ?_⟩
    · apply (Limits.pullback.fst V.hom i).isClosedEmbedding.isInducing.specializes_iff.mp
      rw [hq]
      exact hpy
    · rw [hq]
      exact hyc
  choose rr hrr using hr
  have hfix : ∀ zt : ↥(Limits.pullback V.hom i),
      IsClosed ({(Limits.pullback.fst V.hom i) zt} : Set V.left) → rr zt = zt := by
    intro zt hcl
    have h' := ((hrr zt).1.map (Limits.pullback.fst V.hom i).continuous).mem_closed hcl
      (Set.mem_singleton _)
    exact (Limits.pullback.fst V.hom i).isClosedEmbedding.injective h'

  have hcont : Continuous (fun p => c (rr p)) := by
    rw [continuous_iff_continuousAt]
    intro p₀
    rw [ContinuousAt, Metric.tendsto_nhds]
    intro ε hε
    have hcl₀ := (hrr p₀).2
    obtain ⟨E₀, hE₀, D₀, hD₀, γ₀, hγ₀, hepi₀⟩ := H0 _ hcl₀
    letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Spec (V.left.presheaf.stalk ((Limits.pullback.fst V.hom i) (rr p₀)))) ℓ)) :=
      HasExt.standard _
    have hy0 := Sh _ (rr p₀) rfl E₀ hE₀ D₀ hD₀ γ₀ hγ₀ hepi₀ (c (rr p₀)) (c (rr p₀))
      (hc (rr p₀) hcl₀ E₀ hE₀ D₀ hD₀ γ₀ hγ₀ hepi₀)
    rw [show c (rr p₀) - c (rr p₀) = (0 : ℚ_[ℓ]) from sub_self _, hK0, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero] at hy0
    obtain ⟨W, hWo, hzW, hW⟩ := wc_wcontr_supp_top_coord_small_near_zero K pY n m r hmr i ℓ hℓ
      V h1 h2 h3 h4 h5 DV hDV hepi t H0 H1 _ _ hcl₀ ⟨rr p₀, rfl⟩ E₀ hE₀ D₀ hD₀ γ₀ hγ₀ hepi₀
      hy0 ε hε
    obtain ⟨C, hCc, hzC, hCW⟩ := wc_wlocal_clopen_nbhd_in_open V.left h2 h3 _ hcl₀ W hWo hzW
    refine Filter.eventually_of_mem
      ((hCc.isOpen.preimage (Limits.pullback.fst V.hom i).continuous).mem_nhds
        (((hrr p₀).1.map (Limits.pullback.fst V.hom i).continuous).mem_open hCc.isOpen hzC)) ?_
    intro p hp
    have hpC : (Limits.pullback.fst V.hom i) (rr p) ∈ C :=
      ((hrr p).1.map (Limits.pullback.fst V.hom i).continuous).mem_closed hCc.isClosed hp
    obtain ⟨E, hE, D, hD, γ, hγ, hep⟩ := H0 _ (hrr p).2
    letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Spec (V.left.presheaf.stalk ((Limits.pullback.fst V.hom i) (rr p)))) ℓ)) :=
      HasExt.standard _
    have hsh := Sh _ (rr p) rfl E hE D hD γ hγ hep (c (rr p)) (c (rr p₀))
      (hc (rr p) (hrr p).2 E hE D hD γ hγ hep)
    rw [dist_eq_norm]
    exact hW _ (hCW hpC) (hrr p).2 ⟨rr p, rfl⟩ E hE D hD γ hγ hep _ hsh

  refine ⟨⟨fun p => ULift.up (c (rr p)), continuous_uliftUp.comp hcont⟩, ?_⟩
  intro z hz zt hzt Ez hEz Dz hDz γz hγz hepiz
  subst hzt
  letI : HasExt (SheafOfModules.{u+1}
    (wcRingSheaf (Spec (V.left.presheaf.stalk ((Limits.pullback.fst V.hom i) zt))) ℓ)) :=
    HasExt.standard _
  have hcz := hc zt hz Ez hEz Dz hDz γz hγz hepiz
  rw [show c zt = c (rr zt) by rw [hfix zt hz]] at hcz
  exact hcz

theorem wc_smooth_pair_wcontr_supp_top_free_of_stalk_gen (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (V : Y.ProEt)
    (h1 : IsAffine V.left) (h2 : IsClosed {x : V.left | IsClosed ({x} : Set V.left)})
    (h3 : ∀ x : V.left, ∃! y : V.left, IsClosed ({y} : Set V.left) ∧ x ⤳ y)
    (h4 : ExtremallyDisconnected {x : V.left | IsClosed ({x} : Set V.left)})
    (h5 : ∀ x : V.left, IsClosed ({x} : Set V.left) →
      HenselianLocalRing (V.left.presheaf.stalk x) ∧ IsSepClosed (V.left.residueField x))
    (DV : wcHMPullData (Limits.pullback.fst V.hom i) ℓ) (hDV : wcHMPullCanonical DV)
    (hepi : Epi (wcSuppUnitMap DV))
    (t : wcSuppExt DV (2 * r))
    (H0 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      ∃ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) ∧
        Epi (wcSuppUnitMap Dz))
    (H1 : ∀ z : V.left, IsClosed ({z} : Set V.left) →
      z ∈ Set.range ⇑(Limits.pullback.fst V.hom i) →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        ∀ y : wcSuppExt Dz (2 * r), ∃! c : ℚ_[ℓ],
          y = ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) t) (zero_add _)).comp
            (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ c)) (add_zero _)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
      HasExt.standard _
    Function.Bijective (fun a : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) =>
      (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
        (wcProEtBC (Limits.pullback.fst V.hom i)) _ _ DV.cont DV.φ).map
          (wcHMFun (Limits.pullback V.hom i) ℓ a))).comp t (zero_add (2 * r))) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _

  have hfc : ∀ (S : Scheme.{u}) (c : ULift.{u+1} ℚ_[ℓ]),
      wcHMFun S ℓ (ContinuousMap.const ↥S c) = wcHMConst S ℓ c.down := fun S c => rfl

  have hspec : ∀ (z : V.left) (zt : ↥(Limits.pullback V.hom i)),
      (Limits.pullback.fst V.hom i) zt = z →
      ∀ (a : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])),
      a.comp (Limits.pullback.snd (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)).base.hom =
        ContinuousMap.const _ (a zt) := by
    intro z zt hzt a
    subst hzt
    apply ContinuousMap.ext
    intro p
    change a ((Limits.pullback.snd (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt))
      (Limits.pullback.fst V.hom i)) p) = a zt
    have hq : V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt)
        ((Limits.pullback.fst (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt))
          (Limits.pullback.fst V.hom i)) p) ⤳ (Limits.pullback.fst V.hom i) zt := by
      have h := (IsLocalRing.specializes_closedPoint
        (R := ↑(V.left.presheaf.stalk ((Limits.pullback.fst V.hom i) zt)))
        ((Limits.pullback.fst (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt))
          (Limits.pullback.fst V.hom i)) p)).map
          (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt)).continuous
      rwa [Scheme.fromSpecStalk_closedPoint] at h
    have hpc : V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt)
        ((Limits.pullback.fst (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt))
          (Limits.pullback.fst V.hom i)) p) =
        (Limits.pullback.fst V.hom i)
          ((Limits.pullback.snd (V.left.fromSpecStalk ((Limits.pullback.fst V.hom i) zt))
            (Limits.pullback.fst V.hom i)) p) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    rw [hpc] at hq
    have hs := (Limits.pullback.fst V.hom i).isClosedEmbedding.isInducing.specializes_iff.mp hq
    exact (hs.map a.continuous).eq

  have F : ∀ (z : V.left) (zt : ↥(Limits.pullback V.hom i)),
      (Limits.pullback.fst V.hom i) zt = z →
      ∀ (Ez : wcHMPullData (V.left.fromSpecStalk z) ℓ) (_ : wcHMPullCanonical Ez)
        (Dz : wcHMPullData (Limits.pullback.fst (V.left.fromSpecStalk z)
          (Limits.pullback.fst V.hom i)) ℓ) (_ : wcHMPullCanonical Dz)
        (γz : wcSuppObj Dz ⟶ Ez.Φ.obj (wcSuppObj DV)),
        wcSuppUnitMap Dz ≫ γz = Ez.μ.inv ≫ Ez.Φ.map (wcSuppUnitMap DV) →
        Epi (wcSuppUnitMap Dz) →
        letI : HasExt (SheafOfModules.{u+1}
          (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
        ∀ (a : C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ])) (w : wcSuppExt DV (2 * r)),
        (Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r)
          ((Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst V.hom i)) _ _ DV.cont DV.φ).map
              (wcHMFun (Limits.pullback V.hom i) ℓ a))).comp w (zero_add (2 * r))))
          (zero_add _) =
        ((Abelian.Ext.mk₀ γz).comp (wcSuppPullExt DV Ez (2 * r) w) (zero_add _)).comp
          (Abelian.Ext.mk₀ (wcHMConst (Spec (V.left.presheaf.stalk z)) ℓ (a zt).down))
          (add_zero _) := by
    intro z zt hzt Ez hEz Dz hDz γz hγz hepiz a w
    letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Spec (V.left.presheaf.stalk z)) ℓ)) := HasExt.standard _
    haveI := Ez.additive
    haveI := Ez.presLim
    haveI := Ez.presColim
    haveI : WeaklyEtale (V.left.fromSpecStalk z) := wc_fromSpecStalk_weaklyEtale V.left z
    have e1 : ∀ (g : wcSuppObj DV ⟶ wcSuppObj DV) (w' : wcSuppExt DV (2 * r)),
        wcSuppPullExt DV Ez (2 * r) ((Abelian.Ext.mk₀ g).comp w' (zero_add (2 * r))) =
          (Abelian.Ext.mk₀ (Ez.Φ.map g)).comp (wcSuppPullExt DV Ez (2 * r) w')
            (zero_add (2 * r)) := by
      intro g w'
      unfold wcSuppPullExt
