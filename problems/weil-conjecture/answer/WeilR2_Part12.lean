                ULift.{u+1} C(↥V.unop.left, ℚ_[ℓ]))
            map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
            map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
        inv := AddCommGrpCat.ofHom
          { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
                (w.down : C(↥V.unop.left, ℚ_[ℓ])) : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))
            map_zero' := ContinuousMap.ext fun _ => rfl
            map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
        hom_inv_id := by
          apply AddCommGrpCat.ext
          intro r
          rfl
        inv_hom_id := by
          apply AddCommGrpCat.ext
          intro w
          rfl }
    let NI : G1.obj ≅ (wcLadicSheaf E ℓ).obj := NatIso.ofComponents eV (fun {V W} g => by
      apply AddCommGrpCat.ext
      intro r
      rfl)
    let ι : G1 ≅ wcLadicSheaf E ℓ := ObjectProperty.isoMk _ NI

    have hB := ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ))
      adj (wcFreeSheaf E (Scheme.ProEt.mk (𝟙 E))) (SheafOfModules.unit (wcRingSheaf E ℓ)) ε Hε
      (SheafOfModules.unit (wcRingSheaf E ℓ)) q
    have hΦx : (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ)) x) (zero_add q) = 0 := by
      have hy := hQ (((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ)) x) (zero_add q)).comp
          (Abelian.Ext.mk₀ ι.hom) (add_zero q))
      calc (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
            (SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ)) x) (zero_add q)
          = ((((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
            (SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ)) x) (zero_add q)).comp
              (Abelian.Ext.mk₀ ι.hom) (add_zero q))).comp (Abelian.Ext.mk₀ ι.inv)
              (add_zero q) := by
            rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
              Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        _ = 0 := by rw [hy, Abelian.Ext.zero_comp]
    have hΦ0 : (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ)) (0 : wcHM E ℓ q)) (zero_add q) = 0 := by
      rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
    exact hB.1 (hΦx.trans hΦ0.symm)

theorem wc_hm_kernel_pull_compat {Y Z E : Scheme.{u}} (h : Y ⟶ Z) (i : E ⟶ Z)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dh : wcHMPullData h ℓ) (hDh : wcHMPullCanonical Dh)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData (Limits.pullback.fst h i) ℓ) (hDi' : wcHMPullCanonical Di') :
    Dh.Φ.map (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC i) _ _ Di.cont Di.φ)) ≫ Dh.μ.hom ≫
      @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ = 0 :=
by
  classical
  haveI := Dh.additive
  haveI := Dh.cont
  haveI := Di.cont
  haveI := Di'.cont

  have hzero : ∀ {S : Scheme.{u}} {P Q : SheafOfModules.{u+1} (wcRingSheaf S ℓ)}
      (X : (S.ProEt)ᵒᵖ) (x : P.val.obj X), ((0 : P ⟶ Q).val.app X).hom x = 0 := by
    intro S P Q X x
    rw [← SheafOfModules.forget_map, Functor.map_zero, PresheafOfModules.zero_app]
    rfl

  have hker : ∀ (X : (Z.ProEt)ᵒᵖ) (m : (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit
      _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ)).val.obj X),
      (Di.φ.hom.app X).hom ((Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit
        _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ)).val.app X |>.hom m) = 0 := by
    intro X m
    have h1 := congrArg (fun f => (f.val.app X).hom m) (Limits.kernel.condition
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ))
    simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply] at h1
    rw [hzero] at h1
    erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply] at h1
    exact h1

  have hsq : ∀ {V : Scheme.{u}} (t : V ⟶ Z) (a : C(↥V, ULift.{u+1} ℚ_[ℓ])),
      a.comp (Limits.pullback.fst t i).base.hom = 0 →
      (a.comp (Limits.pullback.fst t h).base.hom).comp
        (Limits.pullback.fst (Limits.pullback.snd t h) (Limits.pullback.fst h i)).base.hom = 0 := by
    intro V t a ha
    have sq : (Limits.pullback.fst (Limits.pullback.snd t h) (Limits.pullback.fst h i) ≫
        Limits.pullback.fst t h) ≫ t =
        (Limits.pullback.snd (Limits.pullback.snd t h) (Limits.pullback.fst h i) ≫
          Limits.pullback.snd h i) ≫ i := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition, Limits.pullback.condition_assoc, Limits.pullback.condition]
    have hq := Limits.pullback.lift_fst _ _ sq
    rw [ContinuousMap.comp_assoc, ← TopCat.hom_comp, ← Scheme.Hom.comp_base, ← hq,
      Scheme.Hom.comp_base, TopCat.hom_comp, ← ContinuousMap.comp_assoc, ha]
    rfl
  obtain ⟨g, hg⟩ : ∃ g, g = Dh.μ.hom ≫ @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ := ⟨_, rfl⟩
  rw [← hg]
  have key : Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC i) _ _ Di.cont Di.φ) ≫ Dh.adj.homEquiv _ _ g = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro m
    rw [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply, hzero]
    have hk := hker X m
    generalize ((Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC i) _ _ Di.cont Di.φ)).val.app X).hom m = r at hk ⊢
    generalize Dh.adj.homEquiv _ _ g = τ
    have hr0 : r.comp (Limits.pullback.fst X.unop.hom i).base.hom = 0 :=
      (hDi X.unop r).symm.trans hk
    have e3 : (Di'.φ.hom.app (Opposite.op ((wcProEtBC h).obj X.unop))).hom
        ((Dh.φ.hom.app X).hom r) = 0 := by
      refine (congrArg (fun s => (Di'.φ.hom.app (Opposite.op ((wcProEtBC h).obj X.unop))).hom s)
        (hDh X.unop r)).trans ((hDi' ((wcProEtBC h).obj X.unop) _).trans ?_)
      exact hsq X.unop.hom r hr0
    have e1 : (show ↑((wcRingSheaf Z ℓ).obj.obj X) from r) •
        (show ↑((SheafOfModules.unit (wcRingSheaf Z ℓ)).val.obj X) from
          (1 : ↑((wcRingSheaf Z ℓ).obj.obj X))) = r :=
      mul_one (show ↑((wcRingSheaf Z ℓ).obj.obj X) from r)
    rw [← e1, LinearMap.map_smul]
    erw [ModuleCat.restrictScalars.smul_def, ModuleCat.restrictScalars.smul_def]
    erw [e3]
    change (0 : ↑((wcRingSheaf (Limits.pullback h i) ℓ).obj.obj
        (Opposite.op ((wcProEtBC (Limits.pullback.fst h i)).obj ((wcProEtBC h).obj X.unop))))) *
        _ = 0
    exact zero_mul _
  have h2 : Dh.adj.homEquiv _ _ (Dh.Φ.map (Limits.kernel.ι
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC i) _ _ Di.cont Di.φ)) ≫ g) = 0 := by
    rw [Adjunction.homEquiv_naturality_left, key]
  have h3 : Dh.Φ.map (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC i) _ _ Di.cont Di.φ)) ≫ g = (Dh.adj.homEquiv _ _).symm 0 := by
    rw [← h2, Equiv.symm_apply_apply]
  rw [h3, Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp]

theorem wc_ext_counit_transfer_bijective_of_acyclic : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : D) (B : C) (I : InjectiveResolution B), (∀ q : ℕ, 1 ≤ q → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) → letI := HasExt.standard C; letI := HasExt.standard D; ∀ n : ℕ, Function.Bijective (fun α : Abelian.Ext A (R.obj B) n => (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app B)) (add_zero n)) :=
by
  intro C D _ _ _ _ L R _ _ _ _ adj A B I hI
  letI := HasExt.standard C
  letI := HasExt.standard D
  intro n
  haveI hRlim : Limits.PreservesLimitsOfSize.{0, 0} R := adj.rightAdjoint_preservesLimits
  haveI : Limits.PreservesFiniteLimits R := Limits.PreservesLimitsOfSize.preservesFiniteLimits R
  haveI := adj.isRightAdjoint
  haveI : R.PreservesMonomorphisms := inferInstance
  haveI : L.PreservesMonomorphisms := inferInstance

  have hP2 : ∀ {Y Y' : C} (u : Y ⟶ Y') {m : ℕ} (α : Abelian.Ext A (R.obj Y) m),
      (Abelian.Ext.mapExactFunctor L (α.comp (Abelian.Ext.mk₀ (R.map u)) (add_zero m))).comp
          (Abelian.Ext.mk₀ (adj.counit.app Y')) (add_zero m) =
        ((Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
          (add_zero m)).comp (Abelian.Ext.mk₀ u) (add_zero m) := by
    intro Y Y' u m α
    have e : L.map (R.map u) ≫ adj.counit.app Y' = adj.counit.app Y ≫ u :=
      adj.counit_naturality u
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, e]

  have hadd : ∀ (Y : C) (m : ℕ) (a b : Abelian.Ext A (R.obj Y) m),
      (Abelian.Ext.mapExactFunctor L (a + b)).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero m) =
        (Abelian.Ext.mapExactFunctor L a).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero m) +
        (Abelian.Ext.mapExactFunctor L b).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero m) := by
    intro Y m a b
    rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp]
  have hinj_of : ∀ (Y : C) (m : ℕ), (∀ α : Abelian.Ext A (R.obj Y) m,
      (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero m) = 0 →
        α = 0) →
      Function.Injective (fun α : Abelian.Ext A (R.obj Y) m =>
        (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero m)) := by
    intro Y m h
    exact (injective_iff_map_eq_zero (AddMonoidHom.mk' (fun α : Abelian.Ext A (R.obj Y) m =>
        (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero m))
        (hadd Y m))).2 h

  have hP4 : ∀ Y : C, Function.Bijective (fun α : Abelian.Ext A (R.obj Y) 0 =>
      (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero 0)) := by
    intro Y
    have e : (fun α : Abelian.Ext A (R.obj Y) 0 =>
        (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero 0)) =
        (fun α => Abelian.Ext.mk₀ ((adj.homEquiv A Y).symm (Abelian.Ext.homEquiv₀ α))) := by
      funext α
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply α]
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, adj.homEquiv_counit]
    rw [e]
    exact (Abelian.Ext.mk₀_bijective _ _).comp
      ((adj.homEquiv A Y).symm.bijective.comp Abelian.Ext.homEquiv₀.bijective)

  have hP5 : ∀ (Y : C) [Injective Y] (m : ℕ), Function.Surjective (fun α : Abelian.Ext A (R.obj Y) m =>
      (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y)) (add_zero m)) := by
    intro Y _ m
    cases m with
    | zero => exact (hP4 Y).2
    | succ m =>
      intro β
      refine ⟨0, ?_⟩
      rw [Abelian.Ext.eq_zero_of_injective β]
      beta_reduce
      rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp]

  have hP3 : ∀ (S : ShortComplex C) (hS : S.ShortExact) (hRS : (S.map R).ShortExact) {m : ℕ}
      (α : Abelian.Ext A (R.obj S.X₃) m),
      (Abelian.Ext.mapExactFunctor L (α.comp hRS.extClass rfl)).comp
          (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero (m + 1)) =
        ((Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₃))
          (add_zero m)).comp hS.extClass rfl := by
    intro S hS hRS m α
    let φ : (S.map R).map L ⟶ S :=
      { τ₁ := adj.counit.app S.X₁
        τ₂ := adj.counit.app S.X₂
        τ₃ := adj.counit.app S.X₃
        comm₁₂ := (adj.counit_naturality S.f).symm
        comm₂₃ := (adj.counit_naturality S.g).symm }
    have hnat : (hRS.map_of_exact L).extClass.comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁))
        (add_zero 1) = (Abelian.Ext.mk₀ (adj.counit.app S.X₃)).comp hS.extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality (hRS.map_of_exact L) hS φ
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
    erw [hnat]
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero]

  have hw : ∀ k, I.cocomplex.iCycles k ≫ I.cocomplex.toCycles k (k + 1) = 0 := by
    intro k
    rw [← cancel_mono (I.cocomplex.iCycles (k + 1)), Category.assoc, HomologicalComplex.toCycles_i,
      HomologicalComplex.iCycles_d, Limits.zero_comp]
  have hS : ∀ k, (ShortComplex.mk (I.cocomplex.iCycles k) (I.cocomplex.toCycles k (k + 1))
      (hw k)).ShortExact := by
    intro k
    have hepi : Epi (I.cocomplex.toCycles k (k + 1)) :=
      Preadditive.epi_of_isZero_cokernel' _
        (I.cocomplex.homologyIsCokernel k (k + 1) (CochainComplex.prev_nat_succ k))
        ((I.cocomplex.exactAt_iff_isZero_homology (k + 1)).1 (I.cocomplex_exactAt_succ k))
    refine ShortComplex.ShortExact.mk' ?_ (show Mono (I.cocomplex.iCycles k) by infer_instance) hepi
    exact ShortComplex.exact_of_f_is_kernel _
      (Limits.isKernelOfComp (I.cocomplex.iCycles (k + 1)) (I.cocomplex.d k (k + 1))
        (I.cocomplex.cyclesIsKernel k (k + 1) (CochainComplex.next ℕ k)) (hw k)
        (I.cocomplex.toCycles_i k (k + 1)))
  have hRS : ∀ k, ((ShortComplex.mk (I.cocomplex.iCycles k) (I.cocomplex.toCycles k (k + 1))
      (hw k)).map R).ShortExact := by
    intro k
    have hex : ((ShortComplex.mk (I.cocomplex.iCycles k) (I.cocomplex.toCycles k (k + 1))
        (hw k)).map R).Exact :=
      (hS k).exact.map_of_mono_of_preservesKernel R (hS k).mono_f inferInstance
    refine ShortComplex.ShortExact.mk' hex
      (show Mono (R.map (I.cocomplex.iCycles k)) by infer_instance) ?_
    show Epi (R.map (I.cocomplex.toCycles k (k + 1)))
    have hd : R.map (I.cocomplex.iCycles (k + 1)) ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d (k + 1) (k + 1 + 1) = 0 := by
      rw [Functor.mapHomologicalComplex_obj_d, ← R.map_comp, HomologicalComplex.iCycles_d,
        R.map_zero]
    let u := ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
      (R.map (I.cocomplex.iCycles (k + 1))) (k + 1 + 1) (CochainComplex.next ℕ (k + 1)) hd
    have hu : u ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles (k + 1) =
        R.map (I.cocomplex.iCycles (k + 1)) := HomologicalComplex.liftCycles_i _ _ _ _ _
    have hfac : R.map (I.cocomplex.toCycles k (k + 1)) ≫ u =
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles k (k + 1) := by
      rw [← cancel_mono (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
          (k + 1)), Category.assoc, hu, ← R.map_comp, HomologicalComplex.toCycles_i,
        HomologicalComplex.toCycles_i, Functor.mapHomologicalComplex_obj_d]
    haveI hMepi : Epi (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles k
        (k + 1)) :=
      Preadditive.epi_of_isZero_cokernel' _
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyIsCokernel k (k + 1)
          (CochainComplex.prev_nat_succ k)) (hI (k + 1) (by omega))
    haveI : Epi u := epi_of_epi_fac hfac
    haveI : Mono u := mono_of_mono_fac hu
    haveI : IsIso u := isIso_of_mono_of_epi u
    have e : R.map (I.cocomplex.toCycles k (k + 1)) =
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles k (k + 1) ≫ inv u := by
      rw [← hfac, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    rw [e]
    exact epi_comp _ _

  have hchase : ∀ m k, Function.Bijective (fun α : Abelian.Ext A (R.obj (I.cocomplex.cycles k)) m =>
      (Abelian.Ext.mapExactFunctor L α).comp
        (Abelian.Ext.mk₀ (adj.counit.app (I.cocomplex.cycles k))) (add_zero m)) := by
    intro m
    induction m with
    | zero => intro k; exact hP4 _
    | succ m ih =>
      intro k
      haveI : Injective (R.obj (I.cocomplex.X k)) := adj.map_injective _ inferInstance
      constructor
      · apply hinj_of
        intro α hα
        have h0 : α.comp (Abelian.Ext.mk₀ (R.map (I.cocomplex.iCycles k))) (add_zero (m + 1)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨w', hw'⟩ := Abelian.Ext.covariant_sequence_exact₁ A (hRS k) α h0 (rfl : m + 1 = m + 1)
        have h1 := (hP3 _ (hS k) (hRS k) w').symm.trans
          ((congrArg (fun x : Abelian.Ext A (R.obj (I.cocomplex.cycles k)) (m + 1) =>
            (Abelian.Ext.mapExactFunctor L x).comp
              (Abelian.Ext.mk₀ (adj.counit.app (I.cocomplex.cycles k))) (add_zero (m + 1))) hw').trans hα)
        obtain ⟨v', hv'⟩ := Abelian.Ext.covariant_sequence_exact₃ (L.obj A) (hS k) _ rfl h1
        obtain ⟨v, rfl⟩ := hP5 (I.cocomplex.X k) m v'
        have h2 : w' = v.comp (Abelian.Ext.mk₀ (R.map (I.cocomplex.toCycles k (k + 1))))
            (add_zero m) := by
          apply (ih (k + 1)).1
          beta_reduce
          rw [hP2]
          exact hv'.symm
        rw [← hw', h2, Abelian.Ext.comp_assoc_of_second_deg_zero]
        erw [(hRS k).comp_extClass]
        rw [Abelian.Ext.comp_zero]
      · intro β
        have h0 : β.comp (Abelian.Ext.mk₀ (I.cocomplex.iCycles k)) (add_zero (m + 1)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨w'', hw''⟩ := Abelian.Ext.covariant_sequence_exact₁ (L.obj A) (hS k) β h0
          (rfl : m + 1 = m + 1)
        obtain ⟨w', rfl⟩ := (ih (k + 1)).2 w''
        exact ⟨w'.comp (hRS k).extClass rfl, (hP3 _ (hS k) (hRS k) w').trans hw''⟩

  obtain ⟨θ⟩ : Nonempty (I.cocomplex.cycles 0 ≅ B) := by
    have hB := I.exact₀.fIsKernel
    have hZ := I.cocomplex.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)
    exact ⟨hZ.conePointUniqueUpToIso hB ≪≫ HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 B⟩

  have hpostD : ∀ {X Y Y' : D} (e : Y ≅ Y') (m : ℕ),
      Function.Bijective (fun α : Abelian.Ext X Y m => α.comp (Abelian.Ext.mk₀ e.hom) (add_zero m)) := by
    intro X Y Y' e m
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun β => β.comp (Abelian.Ext.mk₀ e.inv) (add_zero m), fun α => ?_, fun β => ?_⟩
    · beta_reduce
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · beta_reduce
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
  have hpostC : ∀ {X Y Y' : C} (e : Y ≅ Y') (m : ℕ),
      Function.Bijective (fun α : Abelian.Ext X Y m => α.comp (Abelian.Ext.mk₀ e.hom) (add_zero m)) := by
    intro X Y Y' e m
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun β => β.comp (Abelian.Ext.mk₀ e.inv) (add_zero m), fun α => ?_, fun β => ?_⟩
    · beta_reduce
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · beta_reduce
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
  have ha := @hpostD A _ _ (R.mapIso θ) n
  have hb := @hpostC (L.obj A) _ _ θ n
  have hcomm : (fun α : Abelian.Ext A (R.obj B) n => (Abelian.Ext.mapExactFunctor L α).comp
        (Abelian.Ext.mk₀ (adj.counit.app B)) (add_zero n)) ∘
      (fun α : Abelian.Ext A (R.obj (I.cocomplex.cycles 0)) n =>
        α.comp (Abelian.Ext.mk₀ (R.mapIso θ).hom) (add_zero n)) =
      (fun β : Abelian.Ext (L.obj A) (I.cocomplex.cycles 0) n =>
        β.comp (Abelian.Ext.mk₀ θ.hom) (add_zero n)) ∘
      (fun α : Abelian.Ext A (R.obj (I.cocomplex.cycles 0)) n =>
        (Abelian.Ext.mapExactFunctor L α).comp
          (Abelian.Ext.mk₀ (adj.counit.app (I.cocomplex.cycles 0))) (add_zero n)) := by
    funext α
    exact hP2 θ.hom α
  have hfin := hb.comp (hchase n 0)
  rw [← hcomm] at hfin
  exact (Function.Bijective.of_comp_iff _ ha).mp hfin

theorem wc_hm_kernel_adjoint_iso {Y Z E : Scheme.{u}} (h : Y ⟶ Z) [IsProper h]
    (i : E ⟶ Z) [IsClosedImmersion i]
    (hiso : ∀ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ → IsIso (h ∣_ U))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dh : wcHMPullData h ℓ) (hDh : wcHMPullCanonical Dh)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData (Limits.pullback.fst h i) ℓ) (hDi' : wcHMPullCanonical Di')
    (κ : Dh.Φ.obj (Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC i) _ _ Di.cont Di.φ)) ⟶
        Limits.kernel (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ))
    (hκ : κ ≫ Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst h i)) _ _ Di'.cont Di'.φ) =
        Dh.Φ.map (Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC i) _ _ Di.cont Di.φ)) ≫ Dh.μ.hom) :
    IsIso (Dh.adj.homEquiv _ _ κ) :=
by
  classical

  have s1 : ∀ {M N : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)} (α : M ⟶ N),
      (∀ X : (Z.ProEt)ᵒᵖ, Function.Bijective (α.val.app X).hom) → IsIso α := by
    intro M N α hα
    have h1 : IsIso ((PresheafOfModules.toPresheaf (wcRingSheaf Z ℓ).obj).map α.val) := by
      have : ∀ X, IsIso (((PresheafOfModules.toPresheaf (wcRingSheaf Z ℓ).obj).map α.val).app X) := by
        intro X
        rw [ConcreteCategory.isIso_iff_bijective]
        exact hα X
      exact NatIso.isIso_of_isIso_app _
    have h2 : IsIso α.val :=
      isIso_of_reflects_iso α.val (PresheafOfModules.toPresheaf (wcRingSheaf Z ℓ).obj)
    have h3 : IsIso ((SheafOfModules.forget (wcRingSheaf Z ℓ)).map α) := h2
    exact (SheafOfModules.fullyFaithfulForget _).isIso_of_isIso_map α

  have s2 : ∀ {C : Type (u+1)} [Category.{u} C]
      {J : GrothendieckTopology C} [HasSheafify J AddCommGrpCat.{u+1}]
      [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] {R : Sheaf J RingCat.{u+1}}
      {M N : SheafOfModules.{u+1} R} (f : M ⟶ N) (X : Cᵒᵖ),
      Function.Injective ((Limits.kernel.ι f).val.app X).hom ∧
      ∀ m : M.val.obj X, (f.val.app X).hom m = 0 →
        ∃ k, ((Limits.kernel.ι f).val.app X).hom k = m := by
    intro C _ J _ _ R M N f X
    have hG : ∀ {A B : SheafOfModules.{u+1} R} (φ : A ⟶ B),
        (SheafOfModules.evaluation R X).map φ = φ.val.app X := fun _ => rfl
    constructor
    · have : Mono ((SheafOfModules.evaluation R X).map (Limits.kernel.ι f)) :=
        inferInstance
      rw [hG] at this
      exact (ModuleCat.mono_iff_injective _).mp this
    · have hS := (ShortComplex.exact_kernel f).map_of_mono_of_preservesKernel
        (SheafOfModules.evaluation R X) (by dsimp; infer_instance)
        (by dsimp; infer_instance)
      rw [ShortComplex.moduleCat_exact_iff] at hS
      exact hS

  have s3 : ∀ {P T : Type u} [TopologicalSpace P] [TopologicalSpace T]
      (p : C(P, T)) (F : Set T), IsClosedMap p → IsClosed F → (∀ x, x ∉ F → ∃! a, p a = x) →
      ∀ w : C(P, ULift.{u+1} ℚ_[ℓ]), IsUnit w →
        (∀ f : C(T, ULift.{u+1} ℚ_[ℓ]), (∀ x ∈ F, f x = 0) → (f.comp p) * w = 0 → f = 0) ∧
        ∀ g : C(P, ULift.{u+1} ℚ_[ℓ]), (∀ a, p a ∈ F → g a = 0) →
          ∃ f : C(T, ULift.{u+1} ℚ_[ℓ]), (∀ x ∈ F, f x = 0) ∧ (f.comp p) * w = g := by
    intro P T _ _ p F hp hF hu w hw
    obtain ⟨w', hw'⟩ : ∃ w' : C(P, ULift.{u+1} ℚ_[ℓ]), w' * w = 1 :=
      ⟨↑hw.unit⁻¹, hw.val_inv_mul⟩
    have hw'a : ∀ a, w' a * w a = 1 := fun a => by
      have := congrArg (fun k : C(P, ULift.{u+1} ℚ_[ℓ]) => k a) hw'
      simpa using this
    constructor
    · intro f hfF hf
      have h0 : ∀ a, f (p a) = 0 := by
        intro a
        have h1 := congrArg (fun k : C(P, ULift.{u+1} ℚ_[ℓ]) => k a) hf
        simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
          ContinuousMap.zero_apply] at h1
        calc f (p a) = f (p a) * w a * w' a := by
              rw [mul_assoc, mul_comm (w a), hw'a, mul_one]
          _ = 0 := by rw [h1, zero_mul]
      refine ContinuousMap.ext fun x => ?_
      by_cases hx : x ∈ F
      · exact hfF x hx
      · obtain ⟨a, ha, -⟩ := hu x hx
        rw [← ha]
        exact h0 a
    · intro g hg
      set g' : C(P, ULift.{u+1} ℚ_[ℓ]) := g * w' with hg'def
      have hg' : ∀ a, p a ∈ F → g' a = 0 := fun a ha => by simp [g', hg a ha]
      let f₀ : T → ULift.{u+1} ℚ_[ℓ] := fun x =>
        if hx : x ∈ F then 0 else g' (hu x hx).exists.choose
      have hf₀F : ∀ x ∈ F, f₀ x = 0 := fun x hx => by simp [f₀, hx]
      have hf₀n : ∀ x (hx : x ∉ F), f₀ x = g' (hu x hx).exists.choose := fun x hx => by
        simp [f₀, hx]
      have hf₀p : ∀ a, f₀ (p a) = g' a := by
        intro a
        by_cases ha : p a ∈ F
        · rw [hf₀F _ ha, hg' a ha]
        · rw [hf₀n _ ha]
          congr 1
          exact (hu (p a) ha).unique (hu (p a) ha).exists.choose_spec rfl
      have hcont : Continuous f₀ := by
        rw [continuous_iff_isClosed]
        intro C hC
        have e : f₀ ⁻¹' C = p '' (g' ⁻¹' C) ∪ {x | x ∈ F ∧ (0 : ULift.{u+1} ℚ_[ℓ]) ∈ C} := by
          ext x
          constructor
          · intro hx
            by_cases hxF : x ∈ F
            · right
              refine ⟨hxF, ?_⟩
              have : f₀ x ∈ C := hx
              rwa [hf₀F x hxF] at this
            · left
              refine ⟨(hu x hxF).exists.choose, ?_, (hu x hxF).exists.choose_spec⟩
              have : f₀ x ∈ C := hx
              rwa [hf₀n x hxF] at this
          · rintro (⟨a, ha, rfl⟩ | ⟨hxF, h0⟩)
            · show f₀ (p a) ∈ C
              rw [hf₀p]
              exact ha
            · show f₀ x ∈ C
              rw [hf₀F x hxF]
              exact h0
        rw [e]
        refine (hp _ (hC.preimage g'.continuous)).union ?_
        by_cases h0 : (0 : ULift.{u+1} ℚ_[ℓ]) ∈ C
        · simpa [h0] using hF
        · simp [h0]
      refine ⟨⟨f₀, hcont⟩, hf₀F, ?_⟩
      refine ContinuousMap.ext fun a => ?_
      show f₀ (p a) * w a = g a
      rw [hf₀p]
      show g a * w' a * w a = g a
      rw [mul_assoc, hw'a, mul_one]

  have s4 : ∀ {T : Scheme.{u}} (f : T ⟶ Z) (x : ↥T), f x ∉ Set.range i →
      ∃! a : ↥(Limits.pullback f h), Limits.pullback.fst f h a = x := by
    intro T f x hx
    obtain ⟨U, hUdef⟩ : ∃ U : Z.Opens, (U : Set ↥Z) = (Set.range i)ᶜ :=
      ⟨⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
    have : IsIso (h ∣_ U) := hiso U hUdef
    have heq : (f ⁻¹ᵁ U).ι ≫ f = (f ∣_ U ≫ inv (h ∣_ U) ≫ (h ⁻¹ᵁ U).ι) ≫ h := by
      rw [Category.assoc, Category.assoc, ← morphismRestrict_ι h U, IsIso.inv_hom_id_assoc,
        morphismRestrict_ι]
    obtain ⟨s, hs1, hs2⟩ : ∃ s : (f ⁻¹ᵁ U : Scheme) ⟶ Limits.pullback f h,
        s ≫ Limits.pullback.fst f h = (f ⁻¹ᵁ U).ι ∧
        s ≫ Limits.pullback.snd f h = f ∣_ U ≫ inv (h ∣_ U) ≫ (h ⁻¹ᵁ U).ι :=
      ⟨Limits.pullback.lift _ _ heq, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨O, hOdef⟩ : ∃ O : (Limits.pullback f h).Opens,
        O = Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U) := ⟨_, rfl⟩
    subst hOdef
    have ht : Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U) ≫ (f ⁻¹ᵁ U).ι =
        (Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ Limits.pullback.fst f h :=
      morphismRestrict_ι _ _
    have hkey : (Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ Limits.pullback.snd f h ≫ h =
        Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U) ≫ f ∣_ U ≫ U.ι := by
      rw [morphismRestrict_ι f U, ← Category.assoc (Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U)), ht,
        Category.assoc, Limits.pullback.condition]
    have hrng : Set.range ((Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫
        Limits.pullback.snd f h) ⊆ Set.range (h ⁻¹ᵁ U).ι := by
      rintro _ ⟨b, rfl⟩
      rw [Scheme.Opens.range_ι]
      show h (((Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ Limits.pullback.snd f h) b) ∈ U
      rw [← Scheme.Hom.comp_apply, Category.assoc, hkey, Scheme.Hom.comp_apply,
        Scheme.Hom.comp_apply]
      have := Set.mem_range_self (f := U.ι) ((f ∣_ U) ((Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U)) b))
      rwa [Scheme.Opens.range_ι] at this
    obtain ⟨g, hg⟩ : ∃ g, g ≫ (h ⁻¹ᵁ U).ι =
        (Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ Limits.pullback.snd f h :=
      ⟨IsOpenImmersion.lift _ _ hrng, IsOpenImmersion.lift_fac _ _ _⟩
    have hg2 : g = Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U) ≫ f ∣_ U ≫ inv (h ∣_ U) := by
      rw [← cancel_mono (h ∣_ U), Category.assoc, Category.assoc, IsIso.inv_hom_id,
        Category.comp_id, ← cancel_mono U.ι, Category.assoc, Category.assoc, morphismRestrict_ι,
        ← Category.assoc, hg, Category.assoc, hkey]
    have hO : (Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι =
        Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U) ≫ s := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hs1, ht]
      · rw [Category.assoc, hs2, ← hg, hg2]
        simp only [Category.assoc]
    have hxU : x ∈ Set.range (f ⁻¹ᵁ U).ι := by
      rw [Scheme.Opens.range_ι]
      show f x ∈ U
      rw [← SetLike.mem_coe, hUdef]
      exact hx
    obtain ⟨x₀, hx₀⟩ := hxU
    refine ⟨s x₀, ?_, ?_⟩
    · show Limits.pullback.fst f h (s x₀) = x
      rw [← Scheme.Hom.comp_apply, hs1, hx₀]
    · intro a ha
      have haO : a ∈ Set.range (Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι := by
        rw [Scheme.Opens.range_ι]
        show Limits.pullback.fst f h a ∈ f ⁻¹ᵁ U
        rw [ha, ← hx₀]
        have := Set.mem_range_self (f := (f ⁻¹ᵁ U).ι) x₀
        rwa [Scheme.Opens.range_ι] at this
      obtain ⟨a₀, rfl⟩ := haO
      have e1 : (Limits.pullback.fst f h ⁻¹ᵁ (f ⁻¹ᵁ U)).ι a₀ =
          s ((Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U)) a₀) := by
        rw [← Scheme.Hom.comp_apply, ← hO]
      have e2 : (Limits.pullback.fst f h ∣_ (f ⁻¹ᵁ U)) a₀ = x₀ := by
        apply (f ⁻¹ᵁ U).ι.isOpenEmbedding.injective
        rw [← Scheme.Hom.comp_apply, ht, Scheme.Hom.comp_apply, hx₀]
        exact ha
      rw [e1, e2]

  have s6 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (D : wcHMPullData f ℓ), wcHMPullCanonical D →
      ∀ (V : S.ProEt) (s : (SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC f) _ _ D.cont D.φ)).val.app (Opposite.op V)).hom k = s) ↔
        ∀ z : V.left, V.hom z ∈ Set.range f →
          (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) z = 0 := by
    intro S S' f D hD V s
    haveI := D.cont
    have hρ : ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC f) _ _ D.cont D.φ).val.app (Opposite.op V)).hom s = 0 ↔
        ∀ z : V.left, V.hom z ∈ Set.range f →
          (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s) z = 0 := by
      have e : ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC f) _ _ D.cont D.φ).val.app (Opposite.op V)).hom s =
          (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from s).comp
            (Limits.pullback.fst V.hom f).base.hom :=
        (SheafOfModules.unitToPushforwardObjUnit_val_app_apply D.φ s).trans (hD V s)
      rw [e]
      constructor
      · intro h0 z hz
        have hz' : z ∈ Set.range (Limits.pullback.fst V.hom f) := by
          rw [Scheme.Pullback.range_fst]; exact hz
        obtain ⟨a, rfl⟩ := hz'
        exact congrArg (fun g : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) => g a) h0
      · intro hz
        apply ContinuousMap.ext
        intro a
        exact hz _ (by
          have : Limits.pullback.fst V.hom f a ∈ Set.range (Limits.pullback.fst V.hom f) :=
            ⟨a, rfl⟩
          rw [Scheme.Pullback.range_fst] at this
          exact this)
    rw [← hρ]
    constructor
    · rintro ⟨k, rfl⟩
      have hc : ((Limits.kernel.ι (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC f) _ _ D.cont D.φ) ≫ (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC f) _ _ D.cont D.φ)).val.app (Opposite.op V)).hom k = 0 := by
        rw [Limits.kernel.condition]
        rfl
      exact hc
    · intro h0
      exact (s2 _ (Opposite.op V)).2 s h0

  obtain ⟨u0, hu0, hform0⟩ : ∃ u : C(↥Y, ULift.{u+1} ℚ_[ℓ]), IsUnit u ∧ ∀ V : Z.ProEt,
      ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap Dh)).1 (Opposite.op V) :
          C(↥(Limits.pullback V.hom h), ULift.{u+1} ℚ_[ℓ])) =
        u.comp (Limits.pullback.snd V.hom h).base.hom := by
    haveI := Dh.cont
    let T0 : Z.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 Z) (inferInstance : WeaklyEtale (𝟙 Z))
    let σ := SheafOfModules.unitHomEquiv (wcSuppObj Dh) (wcSuppUnitMap Dh)
    let v0 : C(↥(Limits.pullback (𝟙 Z) h), ULift.{u+1} ℚ_[ℓ]) := σ.1 (Opposite.op T0)
    let u1 : C(↥Y, ULift.{u+1} ℚ_[ℓ]) := v0.comp (inv (Limits.pullback.snd (𝟙 Z) h)).base.hom
    have hfac : ∀ V : Z.ProEt,
        (σ.1 (Opposite.op V) : C(↥(Limits.pullback V.hom h), ULift.{u+1} ℚ_[ℓ])) =
          u1.comp (Limits.pullback.snd V.hom h).base.hom := by
      intro V
      let τ : V ⟶ T0 := MorphismProperty.Over.homMk (B := T0) V.hom (Category.comp_id _) trivial
      have h1 : (v0.comp ((wcProEtBC h).map τ).left.base.hom :
          C(↥(Limits.pullback V.hom h), ULift.{u+1} ℚ_[ℓ])) =
          (σ.1 (Opposite.op V) : C(↥(Limits.pullback V.hom h), ULift.{u+1} ℚ_[ℓ])) :=
        PresheafOfModules.sections_property σ τ.op
      have hw : ((wcProEtBC h).map τ).left ≫ Limits.pullback.snd (𝟙 Z) h =
          Limits.pullback.snd V.hom h :=
        MorphismProperty.Over.w ((wcProEtBC h).map τ)
      have key : ((wcProEtBC h).map τ).left =
          Limits.pullback.snd V.hom h ≫ inv (Limits.pullback.snd (𝟙 Z) h) :=
        (IsIso.eq_comp_inv (Limits.pullback.snd (𝟙 Z) h)).mpr hw
      refine h1.symm.trans ?_
      apply ContinuousMap.ext
      intro p
      exact congrArg (fun f : Limits.pullback V.hom h ⟶ Limits.pullback (𝟙 Z) h => v0 (f.base p))
        key
    let ones : (wcSuppObj Dh).val.sections :=
      PresheafOfModules.sectionsMk (M := (wcSuppObj Dh).val)
        (fun W => (1 : C(↥(Limits.pullback W.unop.hom h), ULift.{u+1} ℚ_[ℓ])))
        (fun _ _ _ => rfl)
    let ρ₁ : SheafOfModules.unit (wcRingSheaf Z ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).obj
          (SheafOfModules.unit (wcRingSheaf Y ℓ)) :=
      (SheafOfModules.unitHomEquiv (wcSuppObj Dh)).symm ones
    let c0 : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶ SheafOfModules.unit (wcRingSheaf Y ℓ) :=
      Dh.μ.inv ≫ (Dh.adj.homEquiv _ _).symm ρ₁
    have h2 : wcSuppUnitMap Dh = Dh.adj.homEquiv _ _ Dh.μ.hom :=
      (Dh.adj.homEquiv_unit _ _ _).symm
    have hc : wcSuppUnitMap Dh ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC h) _ _ Dh.cont Dh.φ).map c0 = ρ₁ := by
      rw [h2]
      refine (Dh.adj.homEquiv_naturality_right Dh.μ.hom c0).symm.trans ?_
      have e3 : Dh.μ.hom ≫ c0 = (Dh.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
      rw [e3, Equiv.apply_symm_apply]
    let W0 : Y.ProEt := (wcProEtBC h).obj T0
    let hh0 : C(↥(Limits.pullback (𝟙 Z) h), ULift.{u+1} ℚ_[ℓ]) :=
      (c0.val.app (Opposite.op W0)).hom (1 : C(↥(Limits.pullback (𝟙 Z) h), ULift.{u+1} ℚ_[ℓ]))
    have eR : (SheafOfModules.unitHomEquiv (wcSuppObj Dh) ρ₁).1 (Opposite.op T0) =
        (1 : C(↥(Limits.pullback (𝟙 Z) h), ULift.{u+1} ℚ_[ℓ])) := by
      show (SheafOfModules.unitHomEquiv (wcSuppObj Dh)
        ((SheafOfModules.unitHomEquiv (wcSuppObj Dh)).symm ones)).1 (Opposite.op T0) = _
      rw [Equiv.apply_symm_apply]
      rfl
    have eL : (SheafOfModules.unitHomEquiv (wcSuppObj Dh) (wcSuppUnitMap Dh ≫
