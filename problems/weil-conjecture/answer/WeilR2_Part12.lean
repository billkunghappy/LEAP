theorem wc_epsInv_iso_of_lan_criterion (X : Scheme.{u})
    [(wcEtToProEt X).IsContinuous (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)]
    (G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (H : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (θ : G ⟶ ((wcEtToProEt X).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology X) (Scheme.ProEt.topology X)).obj H)
    (hsurj : ∀ (T : X.ProEt) (s : H.obj.obj (Opposite.op T)),
