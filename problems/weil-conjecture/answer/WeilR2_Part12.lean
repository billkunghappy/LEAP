      ∃! z₀ : W ⟶ Spec (.of Γ(T.left, ⊤)), ∀ l, z₀ ≫ φ' l = z l := by
    intro W z hz
    obtain ⟨h, hh, hu⟩ := P.limU W z hz
    refine ⟨h ≫ σ.hom, fun l => ?_, fun z₁ hz₁ => ?_⟩
    · show (h ≫ σ.hom) ≫ σ.inv ≫ (P.φ l).left = z l
      rw [Category.assoc, Iso.hom_inv_id_assoc]
      exact hh l
    · have h2 : z₁ ≫ σ.inv = h := hu _ (fun l => by
        rw [Category.assoc]
        exact hz₁ l)
      rw [← h2, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hsq : IsPullback (Limits.pullback.snd T.hom g) (Limits.pullback.fst T.hom g ≫ σ.hom) g a :=
    IsPullback.of_iso (IsPullback.of_hasPullback T.hom g).flip (Iso.refl _) (Iso.refl _) σ
      (Iso.refl _) (by simp) (by simp) (by simp) (by simp [a])
  obtain ⟨π, hπ, hc, hu, hcpt, hqs, haff, hY1, hY2, hY3⟩ :=
    wc_et_baseChange_limit_presentation g Γ(T.left, ⊤) P.Λ P.U' φ' a P.affU hcompat hover huniv
      (Limits.pullback T.hom g) (Limits.pullback.snd T.hom g)
      (Limits.pullback.fst T.hom g ≫ σ.hom) hsq

  have hsub : Subsingleton (wcEtExt ((wcProEtBaseChange g).obj T).left (L.obj I) (n + 1)) :=
    wc_et_pullback_injective_limit_acyclic ((wcProEtBaseChange g).obj T).hom L ⟨adj⟩ P.Λ
      (P.U' ⋙ wcEtBaseChange g) π hπ hc hu hcpt hqs haff hY1 hY2 hY3 I n

  obtain ⟨E₁⟩ := hslice X ((wcProEtBaseChange g).obj T) L adj I (n + 1)
  haveI : CompactSpace ((wcProEtBaseChange g).obj T).left := hY1
  haveI : ((wcProEtBaseChange g).obj T).left.IsSeparated := hY3
  haveI : IsSeparated (Limits.terminal.from ((wcProEtBaseChange g).obj T).left) := inferInstance
  obtain ⟨E₂⟩ := wc_proet_etale_comparison_epsInv_qcsep ((wcProEtBaseChange g).obj T).left
    (L.obj I) (n + 1)
  apply E₁.injective
  apply E₂.injective
  exact @Subsingleton.elim _ hsub _ _

theorem wc_epsInv_injective_etale_affine_vanishing : ∀ (S : Scheme.{u}) (A : S.Opens), IsAffineOpen A → ∀ (W : S.Etale), IsAffine W.left → (∃ g : W.left ⟶ (A : Scheme.{u}), g ≫ A.ι = W.hom) → ∀ (E : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) [Injective E] (n : ℕ) (e : Abelian.Ext (wcFreeSheaf S ((wcEtToProEt S).obj W)) ((wcEpsInv S).obj E) (n + 1)), e = 0 :=
by
  intro S A hA W hW hgex E _ n e
  obtain ⟨g, hg⟩ := hgex

  have hind : wcIndEtale g.appTop.hom := by
    haveI : IsAffine W.left := hW
    haveI : IsAffine (A : Scheme.{u}) := hA
    have hWe : Etale W.hom := W.prop
    rw [← hg] at hWe
    haveI : Etale (g ≫ A.ι) := hWe
    haveI : Etale g := Etale.of_comp g A.ι
    have hφ : RingHom.Etale g.appTop.hom :=
      (HasRingHomProperty.iff_of_isAffine (P := @Etale) (Q := @RingHom.Etale)).mp inferInstance
    dsimp only [wcIndEtale]
    intro P _ _ _ h
    letI := g.appTop.hom.toAlgebra
    exact ⟨Γ(W.left, ⊤), inferInstance, g.appTop.hom.toAlgebra, hφ, h,
      AlgHom.id _ _, AlgHom.id_comp h⟩
  have hT : wcAffIndEt S A ((wcEtToProEt S).obj W) := ⟨hW, g, hg, hind⟩
  revert e
  generalize (wcEtToProEt S).obj W = T at hT
  intro e

  have wa : Limits.pullback.fst T.hom (𝟙 S) ≫ T.hom =
      ((wcProEtBaseChange (𝟙 S)).obj T).hom := by
    show Limits.pullback.fst T.hom (𝟙 S) ≫ T.hom = Limits.pullback.snd T.hom (𝟙 S)
    rw [Limits.pullback.condition, Category.comp_id]
  let a₀ : (wcProEtBaseChange (𝟙 S)).obj T ⟶ T :=
    MorphismProperty.Over.homMk (Limits.pullback.fst T.hom (𝟙 S)) wa trivial
  have wl : 𝟙 T.left ≫ T.hom = T.hom ≫ 𝟙 S :=
    (Category.id_comp _).trans (Category.comp_id _).symm
  have wb : Limits.pullback.lift (𝟙 T.left) T.hom wl ≫ ((wcProEtBaseChange (𝟙 S)).obj T).hom =
      T.hom := by
    show Limits.pullback.lift (𝟙 T.left) T.hom wl ≫ Limits.pullback.snd T.hom (𝟙 S) = T.hom
    exact Limits.pullback.lift_snd _ _ _
  let b₀ : T ⟶ (wcProEtBaseChange (𝟙 S)).obj T :=
    MorphismProperty.Over.homMk (Limits.pullback.lift (𝟙 T.left) T.hom wl) wb trivial
  have hleft : (b₀ ≫ a₀).left = (𝟙 T : T ⟶ T).left := by
    first
      | exact Limits.pullback.lift_fst (𝟙 T.left) T.hom wl
      | (show Limits.pullback.lift (𝟙 T.left) T.hom wl ≫ Limits.pullback.fst T.hom (𝟙 S) = 𝟙 T.left
         exact Limits.pullback.lift_fst _ _ _)
      | simp [a₀, b₀]
  have hba0 : b₀ ≫ a₀ = 𝟙 T := by
    first
      | exact MorphismProperty.Over.Hom.ext hleft
      | exact MorphismProperty.Comma.Hom.ext hleft (Subsingleton.elim _ _)
      | exact MorphismProperty.Comma.Hom.ext _ _ hleft (Subsingleton.elim _ _)
      | (apply MorphismProperty.Comma.Hom.ext <;>
          first | exact hleft | exact Subsingleton.elim _ _ | rfl)
      | (apply MorphismProperty.Comma.Hom.ext
         apply CommaMorphism.ext
         · exact hleft
         · exact Subsingleton.elim _ _)
      | (ext; exact hleft)
  have hba : wcFreeSheafMap S b₀ ≫ wcFreeSheafMap S a₀ = 𝟙 (wcFreeSheaf S T) := by
    unfold wcFreeSheafMap wcFreeSheaf
    rw [← CategoryTheory.Functor.map_comp, ← Functor.whiskerRight_comp,
      ← CategoryTheory.Functor.map_comp, hba0]
    first
      | rw [CategoryTheory.Functor.map_id, Functor.whiskerRight_id', CategoryTheory.Functor.map_id]
      | simp

  have hz := wc_proet_push_epsInv_injective_affine_vanishing (𝟙 S) A hA T hT E n
    ((Abelian.Ext.mk₀ (wcFreeSheafMap S a₀)).comp e (zero_add (n + 1)))
  calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
    _ = (Abelian.Ext.mk₀ (wcFreeSheafMap S b₀ ≫ wcFreeSheafMap S a₀)).comp e (zero_add (n + 1)) := by
        rw [hba]
    _ = ((Abelian.Ext.mk₀ (wcFreeSheafMap S b₀)).comp (Abelian.Ext.mk₀ (wcFreeSheafMap S a₀))
          (zero_add 0)).comp e (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀]
    _ = (Abelian.Ext.mk₀ (wcFreeSheafMap S b₀)).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap S a₀)).comp e (zero_add (n + 1))) (zero_add (n + 1)) :=
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add (n + 1)) (by omega)
    _ = 0 := by rw [hz, Abelian.Ext.comp_zero]

theorem wc_proet_mod_corep_ext_transfer : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt) (Q : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) (Φ : ∀ Y : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ), (Q ⟶ Y) ≃ Y.val.obj (Opposite.op V)), (∀ (Y Y' : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) (ψ : Y ⟶ Y') (g : Q ⟶ Y), Φ Y' (g ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (Φ Y g)) → (∀ (J : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) [Injective J] (m : ℕ) (z : Abelian.Ext (wcFreeSheaf S V) ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).obj J) (m + 1)), z = 0) → ∀ (Y : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) (k : ℕ), (∀ z : Abelian.Ext (wcFreeSheaf S V) ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)).obj Y) k, z = 0) → letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) := HasExt.standard _; ∀ x : Abelian.Ext Q Y k, x = 0 :=
by
  intro S ℓ _ V Q Φ hnat hJ Y k hY
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) := HasExt.standard _
  intro x
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  obtain ⟨eF, heF, -⟩ := proet_free_sheaf_hom_equiv S V
  let U := SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ)
  let s₀ : (U.obj Q).obj.obj (Opposite.op V) := Φ Q (𝟙 Q)
  let ε : wcFreeSheaf S V ⟶ U.obj Q := (eF (U.obj Q)).symm s₀
  have key : ∀ (Y' : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) (f : Q ⟶ Y'),
      eF (U.obj Y') (ε ≫ U.map f) = Φ Y' f := by
    intro Y' f
    rw [heF, Equiv.apply_symm_apply]
    have h := hnat Q Y' f (𝟙 Q)
    rw [Category.id_comp] at h
    rw [h]
    rfl
  have hhom : ∀ Y' : SheafOfModules.{u+1} (wcZModRingSheaf S ℓ),
      Function.Bijective (fun f : Q ⟶ Y' => ε ≫ U.map f) := by
    intro Y'
    have hfun : (fun f : Q ⟶ Y' => ε ≫ U.map f) = (eF (U.obj Y')).symm ∘ (Φ Y') := by
      funext f
      apply (eF (U.obj Y')).injective
      exact (key Y' f).trans ((eF (U.obj Y')).apply_symm_apply (Φ Y' f)).symm
    rw [hfun]
    exact (eF (U.obj Y')).symm.bijective.comp (Φ Y').bijective
  have hT := ext_transfer_of_corep U Q (wcFreeSheaf S V) ε hhom hJ Y k
  have h1 := hY ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor U x) (zero_add k))
  have h2 := hY ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor U 0) (zero_add k))
  exact hT.1 (h1.trans h2.symm)

theorem wc_sheafPullback_free_natIso {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
    (Φ : C ⥤ D) [Φ.IsContinuous J K]
    (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
    (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) :
    ∃ θ : ∀ X : C, L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
        (presheafToSheaf K AddCommGrpCat.{u+1}).obj
          (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
      ∀ {X X' : C} (g : X ⟶ X'),
        L.map ((presheafToSheaf J AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
          (θ X').hom =
        (θ X).hom ≫ (presheafToSheaf K AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map (Φ.map g)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
by

  have s1 : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] {Y Y' : E} (g : Y ⟶ Y')
      (G : Sheaf J' AddCommGrpCat.{u+1})
      (φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
        (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G),
      uliftYonedaEquiv ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G
            ((presheafToSheaf J' AddCommGrpCat.{u+1}).map
              (Functor.whiskerRight (yoneda.map g)
                (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ φ))) =
        ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1}).map g.op
          (uliftYonedaEquiv ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
            (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
            ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ))) := by
    intro E _ J' _ Y Y' g G φ
    have e1 := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_naturality_left
      (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) φ
    have e2 := (Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv_naturality_left
      (uliftYoneda.{u+1}.map g) ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)
    have e3 := uliftYonedaEquiv_naturality
      (F := (sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G ⋙ forget AddCommGrpCat.{u+1})
      ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
        (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G)
        ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G φ)) g.op
    refine Eq.trans ?_ e3.symm
    refine Eq.trans ?_ (congrArg uliftYonedaEquiv e2)
    exact congrArg (fun t => uliftYonedaEquiv ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj G) t))
      e1

  have s2 : ∀ (F F' : Sheaf K AddCommGrpCat.{u+1} ⥤ Type (u+1)) (τ : F' ⟶ F)
      {A A' B B' : Sheaf K AddCommGrpCat.{u+1}}
      (rA : F.CorepresentableBy A) (rA' : F'.CorepresentableBy A')
      (rB : F.CorepresentableBy B) (rB' : F'.CorepresentableBy B')
      (a : A ⟶ A') (b : B ⟶ B'),
      (∀ {G : Sheaf K AddCommGrpCat.{u+1}} (φ : A' ⟶ G),
        rA.homEquiv (a ≫ φ) = τ.app G (rA'.homEquiv φ)) →
      (∀ {G : Sheaf K AddCommGrpCat.{u+1}} (φ : B' ⟶ G),
        rB.homEquiv (b ≫ φ) = τ.app G (rB'.homEquiv φ)) →
      a ≫ (rA'.uniqueUpToIso rB').hom = (rA.uniqueUpToIso rB).hom ≫ b := by
    intro F F' τ A A' B B' rA rA' rB rB' a b ha hb
    show a ≫ rA'.homEquiv.symm (rB'.homEquiv (𝟙 _)) = rA.homEquiv.symm (rB.homEquiv (𝟙 _)) ≫ b
    apply rA.homEquiv.injective
    have hb1 := hb (𝟙 _)
    rw [Category.comp_id] at hb1
    rw [ha, Equiv.apply_symm_apply, rA.homEquiv_comp, Equiv.apply_symm_apply, ← rB.homEquiv_comp,
      Category.id_comp, hb1]

  let rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (Y : E),
      (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    fun {E} _ J' _ Y =>
      { homEquiv := fun {G} =>
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
            (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
        homEquiv_comp := fun {G G'} f g => by
          simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
          rfl }
  let r3 : ∀ X : C, (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
        (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
        (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := fun X =>
    { homEquiv := fun {G} => (adj.homEquiv _ G).trans (rep J X).homEquiv
      homEquiv_comp := fun {G G'} f g => by
        show (rep J X).homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
        rw [Adjunction.homEquiv_naturality_right, (rep J X).homEquiv_comp]
        rfl }
  refine ⟨fun X => (r3 X).uniqueUpToIso (rep K (Φ.obj X)), ?_⟩
  intro X X' g
  refine s2 _ _ (Functor.whiskerLeft (sheafToPresheaf K AddCommGrpCat.{u+1})
      (Functor.whiskerRight ((evaluation Dᵒᵖ AddCommGrpCat.{u+1}).map (Φ.map g).op)
        (forget AddCommGrpCat.{u+1})))
    (r3 X) (r3 X') (rep K (Φ.obj X)) (rep K (Φ.obj X')) _ _ ?_ ?_
  · intro G φ
    show (rep J X).homEquiv (adj.homEquiv _ G (L.map _ ≫ φ)) = _
    rw [Adjunction.homEquiv_naturality_left]
    exact s1 J g ((Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).obj G)
      (adj.homEquiv _ G φ)
  · intro G φ
    exact s1 K (Φ.map g) G φ

theorem wc_zmod_et_proet_mod_ext_vanish : ∀ (S : Scheme.{u}) [CompactSpace S] [QuasiSeparatedSpace S] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : SheafOfModules.{u+1} (wcEtZModRing S ℓ) ⥤ SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) [N.Additive] [Limits.PreservesFiniteLimits N] [Limits.PreservesFiniteColimits N] (e : N.obj (SheafOfModules.unit (wcEtZModRing S ℓ)) ≅ SheafOfModules.unit (wcZModRingSheaf S ℓ)), (∀ M : SheafOfModules.{u+1} (wcEtZModRing S ℓ), Function.Bijective (fun g : SheafOfModules.unit (wcEtZModRing S ℓ) ⟶ M => e.inv ≫ N.map g)) → Nonempty (N ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S ℓ) ≅ SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ) ⋙ wcEpsInv S) → ∀ (M I : SheafOfModules.{u+1} (wcEtZModRing S ℓ)) [Injective I] (n : ℕ), letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) := HasExt.standard _; ∀ x : Abelian.Ext (N.obj M) (N.obj I) (n + 1), x = 0 :=
by
  intro S _ _ ℓ _ N _ _ _ e hbij hθ M I _ n x
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S ℓ)) := HasExt.standard _
  obtain ⟨θ⟩ := hθ
  have hℓ : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  obtain ⟨_, hcont⟩ := wc_etToProEt_flat_cont S
  haveI := hcont
  let adjε := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  haveI : ∀ G, IsIso (adjε.unit.app G) := fun G => wc_epsInv_unit_iso S G
  haveI : IsIso adjε.unit := NatIso.isIso_of_isIso_app _
  let hεFF : (wcEpsInv S).FullyFaithful := adjε.fullyFaithfulLOfIsIsoUnit
  haveI : (wcEpsInv S).Full := hεFF.full
  obtain ⟨hε0, hεl, hεc⟩ := wc_epsInv_exact S
  haveI := hε0
  haveI := hεl
  haveI := hεc
  haveI : (wcEpsInv S).Additive := Functor.additive_of_preserves_binary_products _
  obtain ⟨αe, he1, he2, he3⟩ := wc_et_zmod_ring_locbij S ℓ
  obtain ⟨αp, hp1, hp2, hp3⟩ := wc_proet_zmod_ring_locbij S ℓ hℓ
  obtain ⟨hFe, hEe⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology S)
    (wcEtZModRing S ℓ) ℓ αe he1 he2
  obtain ⟨hFp, hEp⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.ProEt.topology S)
    (wcZModRingSheaf S ℓ) ℓ αp hp1 hp2
