  haveI := E.presColim
  have hGΛC := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ)
  have hGRC := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  haveI hρL : Limits.PreservesFiniteLimits
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)) := by
    haveI : Limits.PreservesFiniteLimits
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ) ⋙
          SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
      inferInstanceAs (Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)))
    haveI : Limits.ReflectsFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
      Limits.reflectsFiniteLimits_of_reflectsIsomorphisms _
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves _
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ))
  haveI hρC : Limits.PreservesFiniteColimits
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)) := by
    haveI : Limits.PreservesFiniteColimits
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ) ⋙
          SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
      inferInstanceAs (Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)))
    haveI : Limits.ReflectsFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
      { reflects := fun J _ _ => by
          haveI hfc : Limits.HasFiniteColimits (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) :=
            inferInstance
          haveI : Limits.HasColimitsOfShape J (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) :=
            Limits.HasFiniteColimits.out J
          haveI : Limits.PreservesColimitsOfShape J
              (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
            Limits.PreservesFiniteColimits.preservesFiniteColimits J
          exact Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms }
    exact Limits.preservesFiniteColimits_of_reflects_of_preserves _
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ))

  have hhom : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun f : E.L.obj X ⟶ Y => E.adj.unit.app X ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map f) := by
    intro Y
    have e : (fun f : E.L.obj X ⟶ Y => E.adj.unit.app X ≫
        (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map f) =
        ⇑(E.adj.homEquiv X Y) := by
      funext f
      exact (E.adj.homEquiv_unit X Y f).symm
    rw [e]
    exact (E.adj.homEquiv X Y).bijective
  have hΦ := ext_transfer_of_hom_bijective E.L
    (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)) E.adj
    X (E.L.obj X) (E.adj.unit.app X) hhom (SheafOfModules.unit (wcRingSheaf S ℓ)) n
  have hinj := hΦ.1
  have map0 : (Abelian.Ext.mk₀ (E.adj.unit.app X)).comp (Abelian.Ext.mapExactFunctor
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ))
      (0 : Abelian.Ext (E.L.obj X) (SheafOfModules.unit (wcRingSheaf S ℓ)) n)) (zero_add n) = 0 := by
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
  intro z

  have hunfold : wcIntRatExt E X n z =
      (Abelian.Ext.mapExactFunctor E.L z).comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero n) := rfl
  have hstar : z.comp (Abelian.Ext.mk₀ (E.adj.unit.app (wcIntUnit S ℓ))) (add_zero n) =
      (Abelian.Ext.mk₀ (E.adj.unit.app X)).comp
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ))
          (Abelian.Ext.mapExactFunctor E.L z)) (zero_add n) := by
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z E.adj.unit
    rw [Abelian.Ext.id_mapExactFunctor, Abelian.Ext.comp_mapExactFunctor] at h
    exact h
  have hj : E.adj.unit.app (wcIntUnit S ℓ) ≫
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).map E.μ.hom =
      wcUnitRestrict (wcIntRatRingSheafMap S ℓ) := by
    rw [← hE, Adjunction.homEquiv_unit]
  have key : (Abelian.Ext.mk₀ (E.adj.unit.app X)).comp (Abelian.Ext.mapExactFunctor
      (SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ))
      (wcIntRatExt E X n z)) (zero_add n) =
      z.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n) := by
    rw [hunfold, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, ← hstar, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, hj]
  constructor
  · intro h
    rw [← key, h, map0]
  · intro h
    apply hinj
    exact key.trans (h.trans map0.symm)

theorem wc_int_supp_rat_pull_square {X Y X' Y' : Scheme.{u}} {i : X ⟶ Y} {i' : X' ⟶ Y'}
    {f : Y' ⟶ Y} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (Di' : wcHMPullData i' ℓ) (Df : wcHMPullData f ℓ)
    (DΛ : wcIntPullData f ℓ) (EY : wcIntRatData Y ℓ) (EY' : wcIntRatData Y' ℓ)
    (εY : wcSuppObj Di ⟶ EY.L.obj (wcIntSuppObj Di))
    (hεY : wcSuppUnitMap Di ≫ εY = EY.μ.inv ≫ EY.L.map (wcIntSuppπ Di))
    (εR : wcSuppObj Di' ⟶ EY'.L.obj (wcIntSuppObj Di'))
    (hεR : wcSuppUnitMap Di' ≫ εR = EY'.μ.inv ≫ EY'.L.map (wcIntSuppπ Di'))
    (hepi : Epi (wcSuppUnitMap Di'))
    (γ : wcSuppObj Di' ⟶ Df.Φ.obj (wcSuppObj Di))
    (hγ : wcSuppUnitMap Di' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcSuppUnitMap Di))
    (γΛ : wcIntSuppObj Di' ⟶ DΛ.Φ.obj (wcIntSuppObj Di))
    (hγΛ : wcIntSuppπ Di' ≫ γΛ = DΛ.μ.inv ≫ DΛ.Φ.map (wcIntSuppπ Di))
    (ν : DΛ.Φ ⋙ EY'.L ≅ EY.L ⋙ Df.Φ)
    (hcen : ∀ e : SheafOfModules.unit (wcRingSheaf Y' ℓ) ⟶ SheafOfModules.unit (wcRingSheaf Y' ℓ),
      ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) ⟶ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)),
        m.app (SheafOfModules.unit (wcRingSheaf Y' ℓ)) = e)
    (n : ℕ) (θ : @Abelian.Ext (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) _ _ (HasExt.standard _)
      (wcIntSuppObj Di) (wcIntUnit Y ℓ) n) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)) := HasExt.standard _
    wcIntSuppRat Di' EY' εR n ((Abelian.Ext.mk₀ γΛ).comp (wcIntSuppPullExt Di DΛ n θ) (zero_add n)) =
      (Abelian.Ext.mk₀ γ).comp (wcSuppPullExt Di Df n (wcIntSuppRat Di EY εY n θ)) (zero_add n) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := DΛ.additive
  haveI := DΛ.presLim
  haveI := DΛ.presColim
  haveI := EY.additive
  haveI := EY.presLim
  haveI := EY.presColim
  haveI := EY'.additive
  haveI := EY'.presLim
  haveI := EY'.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have cancel : ∀ {Q A B : SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)}
      (σ : SheafOfModules.unit (wcRingSheaf Y' ℓ) ⟶ Q), Epi σ →
      ∀ (g : B ⟶ A) (a a' : Q ⟶ A) (b b' : B ⟶ SheafOfModules.unit (wcRingSheaf Y' ℓ))
        (binv b'inv : SheafOfModules.unit (wcRingSheaf Y' ℓ) ⟶ B),
        σ ≫ a = binv ≫ g → σ ≫ a' = b'inv ≫ g → b ≫ binv = 𝟙 B → b'inv ≫ b' = 𝟙 _ →
        ∀ (Z : Abelian.Ext A B n),
        (Abelian.Ext.mk₀ a).comp (Z.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n) =
          (Abelian.Ext.mk₀ a').comp (Z.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n) := by
    intro Q A B σ hσ g a a' b b' binv b'inv ha ha' hb hb' Z
    obtain ⟨m, hm⟩ := hcen (b'inv ≫ b)
    have hnat : σ ≫ m.app Q = (b'inv ≫ b) ≫ σ := by
      have h := m.naturality σ
      simp only [Functor.id_map] at h
      rw [h, hm]
    have ea' : a' = m.app Q ≫ a := by
      apply (cancel_epi σ).1
      rw [ha', ← Category.assoc, hnat, Category.assoc, Category.assoc, ha,
        ← Category.assoc b, hb, Category.id_comp]
    have eb' : b' = b ≫ (binv ≫ b') := by
      rw [← Category.assoc, hb, Category.id_comp]
    have ef : (b'inv ≫ b) ≫ (binv ≫ b') = 𝟙 _ := by
      rw [Category.assoc, ← Category.assoc b, hb, Category.id_comp, hb']
    have hc : ∀ (W : Abelian.Ext Q (SheafOfModules.unit (wcRingSheaf Y' ℓ)) n),
        (Abelian.Ext.mk₀ (m.app Q)).comp W (zero_add n) =
          W.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf Y' ℓ)))) (add_zero n) := by
      intro W
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp W m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    calc (Abelian.Ext.mk₀ a).comp (Z.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n)
        = (((Abelian.Ext.mk₀ a).comp (Z.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n)).comp
            (Abelian.Ext.mk₀ (b'inv ≫ b)) (add_zero n)).comp
            (Abelian.Ext.mk₀ (binv ≫ b')) (add_zero n) := by
          rw [h3 ((Abelian.Ext.mk₀ a).comp (Z.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n))
            (b'inv ≫ b) (binv ≫ b'), ef, Abelian.Ext.comp_mk₀_id]
      _ = ((Abelian.Ext.mk₀ (m.app Q)).comp
            ((Abelian.Ext.mk₀ a).comp (Z.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n))
            (zero_add n)).comp (Abelian.Ext.mk₀ (binv ≫ b')) (add_zero n) := by
          rw [hc, hm]
      _ = (Abelian.Ext.mk₀ a').comp (Z.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n) := by
          rw [h4, h4, h3, h2, ← eb', ← ea']

  show (Abelian.Ext.mk₀ εR).comp ((Abelian.Ext.mapExactFunctor EY'.L
      ((Abelian.Ext.mk₀ γΛ).comp ((Abelian.Ext.mapExactFunctor DΛ.Φ θ).comp
        (Abelian.Ext.mk₀ DΛ.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ EY'.μ.hom) (add_zero n)) (zero_add n) =
    (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Df.Φ
      ((Abelian.Ext.mk₀ εY).comp ((Abelian.Ext.mapExactFunctor EY.L θ).comp
        (Abelian.Ext.mk₀ EY.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n)

  have hL : (Abelian.Ext.mk₀ εR).comp ((Abelian.Ext.mapExactFunctor EY'.L
      ((Abelian.Ext.mk₀ γΛ).comp ((Abelian.Ext.mapExactFunctor DΛ.Φ θ).comp
        (Abelian.Ext.mk₀ DΛ.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ EY'.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (εR ≫ EY'.L.map γΛ)).comp
        ((Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ EY'.L) θ).comp
          (Abelian.Ext.mk₀ (EY'.L.map DΛ.μ.hom ≫ EY'.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  have hR : (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Df.Φ
      ((Abelian.Ext.mk₀ εY).comp ((Abelian.Ext.mapExactFunctor EY.L θ).comp
        (Abelian.Ext.mk₀ EY.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (γ ≫ Df.Φ.map εY)).comp
        ((Abelian.Ext.mapExactFunctor (EY.L ⋙ Df.Φ) θ).comp
          (Abelian.Ext.mk₀ (Df.Φ.map EY.μ.hom ≫ Df.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]

  have nat' : (Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ EY'.L) θ).comp
      (Abelian.Ext.mk₀ (ν.hom.app (wcIntUnit Y ℓ))) (add_zero n) =
      (Abelian.Ext.mk₀ (ν.hom.app (wcIntSuppObj Di))).comp
        (Abelian.Ext.mapExactFunctor (EY.L ⋙ Df.Φ) θ) (zero_add n) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp θ ν.hom
  have step1 : (Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ EY'.L) θ).comp
      (Abelian.Ext.mk₀ (EY'.L.map DΛ.μ.hom ≫ EY'.μ.hom)) (add_zero n) =
      ((Abelian.Ext.mk₀ (ν.hom.app (wcIntSuppObj Di))).comp
        (Abelian.Ext.mapExactFunctor (EY.L ⋙ Df.Φ) θ) (zero_add n)).comp
        (Abelian.Ext.mk₀ (ν.inv.app (wcIntUnit Y ℓ) ≫
          EY'.L.map DΛ.μ.hom ≫ EY'.μ.hom)) (add_zero n) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL' : (Abelian.Ext.mk₀ (εR ≫ EY'.L.map γΛ)).comp
        ((Abelian.Ext.mapExactFunctor (DΛ.Φ ⋙ EY'.L) θ).comp
          (Abelian.Ext.mk₀ (EY'.L.map DΛ.μ.hom ≫ EY'.μ.hom)) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ ((εR ≫ EY'.L.map γΛ) ≫ ν.hom.app (wcIntSuppObj Di))).comp
        ((Abelian.Ext.mapExactFunctor (EY.L ⋙ Df.Φ) θ).comp
          (Abelian.Ext.mk₀ (ν.inv.app (wcIntUnit Y ℓ) ≫
            EY'.L.map DΛ.μ.hom ≫ EY'.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [step1, h4, h2]
  rw [hL, hL', hR]

  have hnatπ := ν.hom.naturality (wcIntSuppπ Di)
  simp only [Functor.comp_map] at hnatπ
  have ha : wcSuppUnitMap Di' ≫ ((εR ≫ EY'.L.map γΛ) ≫ ν.hom.app (wcIntSuppObj Di)) =
      (EY'.μ.inv ≫ EY'.L.map DΛ.μ.inv ≫ ν.hom.app (wcIntUnit Y ℓ)) ≫
        Df.Φ.map (EY.L.map (wcIntSuppπ Di)) := by
    simp only [Category.assoc]
    rw [reassoc_of% hεR, ← Functor.map_comp_assoc EY'.L (wcIntSuppπ Di') γΛ, hγΛ,
      Functor.map_comp_assoc, hnatπ]
  have ha' : wcSuppUnitMap Di' ≫ (γ ≫ Df.Φ.map εY) =
      (Df.μ.inv ≫ Df.Φ.map EY.μ.inv) ≫ Df.Φ.map (EY.L.map (wcIntSuppπ Di)) := by
    simp only [Category.assoc]
    rw [reassoc_of% hγ, ← Df.Φ.map_comp (wcSuppUnitMap Di) εY, hεY, Df.Φ.map_comp]
  have hb : (ν.inv.app (wcIntUnit Y ℓ) ≫ EY'.L.map DΛ.μ.hom ≫ EY'.μ.hom) ≫
      (EY'.μ.inv ≫ EY'.L.map DΛ.μ.inv ≫ ν.hom.app (wcIntUnit Y ℓ)) = 𝟙 _ := by
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← CategoryTheory.Functor.map_comp_assoc, Iso.hom_inv_id, CategoryTheory.Functor.map_id,
      Category.id_comp, Iso.inv_hom_id_app]
  have hb' : (Df.μ.inv ≫ Df.Φ.map EY.μ.inv) ≫ (Df.Φ.map EY.μ.hom ≫ Df.μ.hom) = 𝟙 _ := by
    simp only [Category.assoc]
    rw [← CategoryTheory.Functor.map_comp_assoc, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
      Category.id_comp, Iso.inv_hom_id]

  exact cancel (wcSuppUnitMap Di') hepi _ _ _ _ _ _ _ ha ha' hb hb' _

theorem wc_int_supp_kernel_sections_gen {A B : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (i : A ⟶ B) (D : wcHMPullData i ℓ) (hD : wcHMPullCanonical D)
    (V : B.ProEt) (f : (wcIntUnit B ℓ).val.obj (Opposite.op V)) :
    (∃ k, ((Limits.kernel.ι (wcIntSuppπ D)).val.app (Opposite.op V)).hom k = f) ↔
      ∀ z : V.left, V.hom z ∈ Set.range i →
        (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0 :=
by
  classical

  have s1 : ∀ {M N : SheafOfModules.{u+1} (wcIntRingSheaf B ℓ)} (g : M ⟶ N)
      (W : (B.ProEt)ᵒᵖ) (s : M.val.obj W),
      (∃ k, ((Limits.kernel.ι (Limits.factorThruImage g)).val.app W).hom k = s) ↔
        (g.val.app W).hom s = 0 := by
    intro M N g W s
    let G : SheafOfModules.{u+1} (wcIntRingSheaf B ℓ) ⥤
        ModuleCat.{u+1} ((wcIntRingSheaf B ℓ).obj.obj W) :=
      SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ W
    constructor
    · rintro ⟨k, rfl⟩
      have e : Limits.kernel.ι (Limits.factorThruImage g) ≫ g = 0 :=
        (congrArg (fun h => Limits.kernel.ι (Limits.factorThruImage g) ≫ h)
          (Limits.image.fac g)).symm.trans
          ((Limits.kernel.condition_assoc _ _).trans Limits.zero_comp)
      have e2 : G.map (Limits.kernel.ι (Limits.factorThruImage g)) ≫ G.map g = 0 := by
        rw [← G.map_comp, e, G.map_zero]
      have e3 := congrArg (fun h => h.hom k) e2
      simp only [ModuleCat.hom_comp, ModuleCat.hom_zero] at e3
      exact e3
    · intro hs
      have : Mono (G.map (Limits.image.ι g)) := Functor.map_mono G _
      have hinj := (ModuleCat.mono_iff_injective (G.map (Limits.image.ι g))).mp this
      have hfac : G.map (Limits.factorThruImage g) ≫ G.map (Limits.image.ι g) = G.map g := by
        rw [← G.map_comp, Limits.image.fac]
      have hπ : (G.map (Limits.factorThruImage g)).hom s = 0 := by
        apply hinj
        have h2 := congrArg (fun h => h.hom s) hfac
        simp only [ModuleCat.hom_comp] at h2
        refine h2.trans (hs.trans ?_)
        exact (map_zero _).symm
      let k' : ModuleCat.of ((wcIntRingSheaf B ℓ).obj.obj W)
          ((wcIntRingSheaf B ℓ).obj.obj W) ⟶ G.obj M :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton _ _ s)
      have hk1 : k'.hom 1 = s := one_smul _ s
      have hk' : k' ≫ G.map (Limits.factorThruImage g) = 0 := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext_ring
        show (G.map (Limits.factorThruImage g)).hom (k'.hom 1) = 0
        rw [hk1]
        exact hπ
      let hl := Limits.KernelFork.IsLimit.lift'
        (Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (Limits.factorThruImage g)) G) k' hk'
      refine ⟨hl.1.hom 1, ?_⟩
      have h3 := congrArg (fun h => h.hom (1 : (wcIntRingSheaf B ℓ).obj.obj W)) hl.2
      exact h3.trans hk1

  have s3 : ∀ (g : V.left ⟶ B) (φ : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
      (w : C(↥A, ULift.{u+1} ℚ_[ℓ])), IsUnit w →
      ((∀ p : ↥(Limits.pullback g i),
        ULift.up (((φ (Limits.pullback.fst g i p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
          w (Limits.pullback.snd g i p) = 0) ↔
      ∀ z : ↥V.left, g z ∈ Set.range i → φ z = 0) := by
    intro g φ w hw
    obtain ⟨v, hv⟩ := hw.exists_right_inv
    have hne : ∀ q, w q ≠ 0 := by
      intro q h0
      have h1 := congrArg (fun G : C(↥A, ULift.{u+1} ℚ_[ℓ]) => G q) hv
      simp only [ContinuousMap.mul_apply, ContinuousMap.one_apply, h0, zero_mul] at h1
      exact zero_ne_one h1
    have hred : ∀ (a : ℤ_[ℓ]) (b : ULift.{u+1} ℚ_[ℓ]), b ≠ 0 →
        (ULift.up (a : ℚ_[ℓ]) * b = 0 ↔ ULift.up a = (0 : ULift.{u+1} ℤ_[ℓ])) := by
      intro a b hb
      rw [mul_eq_zero, or_iff_left hb]
      constructor
      · intro h
        exact ULift.ext _ _ (PadicInt.coe_eq_zero.mp (congrArg ULift.down h))
      · intro h
        have h' : a = 0 := congrArg ULift.down h
        rw [h']
        rfl
    constructor
    · intro H z hz
      have hz' : z ∈ Set.range (Limits.pullback.fst g i) := by
        rw [Scheme.Pullback.range_fst]
        exact hz
      obtain ⟨p, rfl⟩ := hz'
      exact (hred _ _ (hne _)).mp (H p)
    · intro H p
      have hp : g (Limits.pullback.fst g i p) ∈ Set.range i := by
        refine ⟨Limits.pullback.snd g i p, ?_⟩
        have e : g (Limits.pullback.fst g i p) = i (Limits.pullback.snd g i p) := by
          rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
        exact e.symm
      exact (hred _ _ (hne _)).mpr (H _ hp)

  have hsec : ∀ {A B : Scheme.{u}} {i : A ⟶ B} (D : wcHMPullData i ℓ),
      ∃ u : C(↥A, ULift.{u+1} ℚ_[ℓ]), IsUnit u ∧ ∀ W : B.ProEt,
        ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap D)).1 (Opposite.op W) :
            C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
    intro A B i D
    haveI := D.cont
    let T : B.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 B) (inferInstance : WeaklyEtale (𝟙 B))
    let σ := SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D)
    let v : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) := σ.1 (Opposite.op T)
    let u : C(↥A, ULift.{u+1} ℚ_[ℓ]) := v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom
    have hfac : ∀ W : B.ProEt,
        (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
      intro W
      let τ : W ⟶ T := MorphismProperty.Over.homMk (B := T) W.hom (Category.comp_id _) trivial
      have h1 : (v.comp ((wcProEtBC i).map τ).left.base.hom :
          C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) :=
        PresheafOfModules.sections_property σ τ.op
      have hw : ((wcProEtBC i).map τ).left ≫ Limits.pullback.snd (𝟙 B) i =
          Limits.pullback.snd W.hom i :=
        MorphismProperty.Over.w ((wcProEtBC i).map τ)
      have key : ((wcProEtBC i).map τ).left =
          Limits.pullback.snd W.hom i ≫ inv (Limits.pullback.snd (𝟙 B) i) :=
        (IsIso.eq_comp_inv (Limits.pullback.snd (𝟙 B) i)).mpr hw
      refine h1.symm.trans ?_
      apply ContinuousMap.ext
      intro p
      exact congrArg (fun f : Limits.pullback W.hom i ⟶ Limits.pullback (𝟙 B) i => v (f.base p)) key
    let ones : (wcSuppObj D).val.sections :=
      PresheafOfModules.sectionsMk (M := (wcSuppObj D).val)
        (fun W => (1 : C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ])))
        (fun _ _ _ => rfl)
    let ρ₁ : SheafOfModules.unit (wcRingSheaf B ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcRingSheaf A ℓ)) :=
      (SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones
    let c : SheafOfModules.unit (wcRingSheaf A ℓ) ⟶ SheafOfModules.unit (wcRingSheaf A ℓ) :=
      D.μ.inv ≫ (D.adj.homEquiv _ _).symm ρ₁
    have h2 : wcSuppUnitMap D = D.adj.homEquiv _ _ D.μ.hom :=
      (D.adj.homEquiv_unit _ _ _).symm
    have hc : wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c = ρ₁ := by
      rw [h2]
      refine (D.adj.homEquiv_naturality_right D.μ.hom c).symm.trans ?_
      have e3 : D.μ.hom ≫ c = (D.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
      rw [e3, Equiv.apply_symm_apply]
    let W : A.ProEt := (wcProEtBC i).obj T
    let h : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) :=
      (c.val.app (Opposite.op W)).hom (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
    have eR : (SheafOfModules.unitHomEquiv (wcSuppObj D) ρ₁).1 (Opposite.op T) =
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ])) := by
      show (SheafOfModules.unitHomEquiv (wcSuppObj D)
        ((SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones)).1 (Opposite.op T) = _
      rw [Equiv.apply_symm_apply]
      rfl
    have eL : (SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c)).1
          (Opposite.op T) = (c.val.app (Opposite.op W)).hom v := rfl
    have eLin : (c.val.app (Opposite.op W)).hom v = v * h := by
      have hs := (c.val.app (Opposite.op W)).hom.map_smul
        (v : (wcRingSheaf A ℓ).obj.obj (Opposite.op W))
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
      exact (congrArg (fun x => (c.val.app (Opposite.op W)).hom x) (mul_one v).symm).trans hs
    have hvh : v * h = 1 :=
      eLin.symm.trans (eL.symm.trans ((congrArg
        (fun f => (SheafOfModules.unitHomEquiv (wcSuppObj D) f).1 (Opposite.op T)) hc).trans eR))
    refine ⟨u, ?_, hfac⟩
    refine isUnit_iff_exists_inv.mpr
      ⟨h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom, ?_⟩
    show v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom *
      h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom = 1
    rw [← ContinuousMap.mul_comp, hvh, ContinuousMap.one_comp]

  obtain ⟨uu, huu, hsecV⟩ := hsec D
  let Φ := ((wcSuppUnitMap D).val.app (Opposite.op V)).hom
  have hΦ1 : (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
      Φ (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) =
      uu.comp (Limits.pullback.snd V.hom i).base.hom :=
    (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans (hsecV V)
  have hΦ : ∀ w : C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
      (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from Φ w) =
        w.comp (Limits.pullback.fst V.hom i).base.hom *
          uu.comp (Limits.pullback.snd V.hom i).base.hom := by
    intro w
    have hs := Φ.map_smul (w : (wcRingSheaf B ℓ).obj.obj (Opposite.op V))
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 := (congrArg Φ (mul_one w).symm).trans hs
    refine e1.trans ?_
    show (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        (D.φ.hom.app (Opposite.op V)).hom w) *
      (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        Φ (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) = _
    rw [hD V w, hΦ1]
  let ψ := ((wcUnitRestrict (wcIntRatRingSheafMap B ℓ)).val.app (Opposite.op V)).hom
  have hψ1 : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
      ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = 1 := by
    have e : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from (SheafOfModules.unitHomEquiv _
        (wcUnitRestrict (wcIntRatRingSheafMap B ℓ))).1 (Opposite.op V)) = 1 := by
      unfold wcUnitRestrict
      rw [Equiv.apply_symm_apply]
      rfl
    exact (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans e
  have hψ : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ f) =
      ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op V)).hom f := by
    have hs := ψ.map_smul (f : (wcIntRingSheaf B ℓ).obj.obj (Opposite.op V))
      (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
    have e1 := (congrArg ψ (mul_one (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)).symm).trans hs
    refine e1.trans ?_
    show (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op V)).hom f) *
      (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = _
    rw [hψ1, mul_one]
  have hgval : ∀ p : ↥(Limits.pullback V.hom i),
      (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap D).val.app (Opposite.op V)).hom f) p =
      ULift.up ((((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)
          (Limits.pullback.fst V.hom i p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
        uu (Limits.pullback.snd V.hom i p) := by
    intro p
    have e : (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap D).val.app (Opposite.op V)).hom f) =
        (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
          ((wcIntRatRingSheafMap B ℓ).hom.app (Opposite.op V)).hom f).comp
            (Limits.pullback.fst V.hom i).base.hom *
          uu.comp (Limits.pullback.snd V.hom i).base.hom := by
      refine (hΦ (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ f)).trans ?_
      rw [hψ]
    rw [e]
    rfl
  have hzero : ((wcIntSuppMap D).val.app (Opposite.op V)).hom f = 0 ↔
      ∀ p : ↥(Limits.pullback V.hom i),
        ULift.up ((((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)
            (Limits.pullback.fst V.hom i p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
          uu (Limits.pullback.snd V.hom i p) = 0 := by
    show (show C(↥(Limits.pullback V.hom i), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap D).val.app (Opposite.op V)).hom f) = 0 ↔ _
    rw [ContinuousMap.ext_iff]
    simp only [ContinuousMap.zero_apply, hgval]
  exact ((s1 (wcIntSuppMap D) (Opposite.op V) f).trans hzero).trans
    (s3 V.hom (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) uu huu)

theorem wc_int_kernel_section_local_cover_qc {S T : Scheme.{u}} (iT : T ⟶ S) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)]
    (hqc : ∀ (W : Scheme.{u}) [IsAffine W] (p : W ⟶ S), ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range iT ↔ ∃ k, x ∈ W.basicOpen (f k)))
    {P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (π : wcIntUnit S ℓ ⟶ P)
    (hK : ∀ (V : S.ProEt) (f : (wcIntUnit S ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι π).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z ∈ Set.range iT →
          (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (U : S.ProEt) (k : (Limits.kernel π).val.obj (Opposite.op U))
    (W : S.ProEt) (g : W ⟶ U) (hW : IsAffine W.left) :
    ∃ (n : ℕ) (W' : Fin n → S.ProEt) (e : ∀ j, W' j ⟶ W),
      (∀ j, IsAffine (W' j).left) ∧ (∀ x : ↥W.left, ∃ j, x ∈ Set.range (e j).left) ∧
      ∀ j, (∀ x : ↥(W' j).left, (W' j).hom x ∉ Set.range iT) ∨
        ((Limits.kernel π).val.map (e j ≫ g).op).hom k = 0 :=
by
  classical
  haveI : IsAffine W.left := hW
  haveI : WeaklyEtale W.hom := W.prop
  let f : C(↥U.left, ULift.{u+1} ℤ_[ℓ]) := ((Limits.kernel.ι π).val.app (Opposite.op U)).hom k
  have vanish : ∀ y : ↥U.left, U.hom y ∈ Set.range iT → f y = 0 :=
    fun y hy => (hK U f).mp ⟨k, rfl⟩ y hy
  have htW : ∀ x : ↥W.left, W.hom x ∈ Set.range iT → (f.comp g.left.base.hom) x = 0 := by
    intro x hx
    apply vanish
    have e : U.hom (g.left x) = W.hom x := by
      rw [← MorphismProperty.Over.w g]; rfl
    rw [e]; exact hx
  let tQ : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun x => ULift.up (((f.comp g.left.base.hom) x).down : ℚ_[ℓ]),
      continuous_uliftUp.comp (continuous_subtype_val.comp
        (continuous_uliftDown.comp (f.comp g.left.base.hom).continuous))⟩
  have htQ : ∀ x : ↥W.left, tQ x = 0 ↔ (f.comp g.left.base.hom) x = 0 := by
    intro x
    constructor
    · intro h
      apply ULift.ext
      have h' : (((f.comp g.left.base.hom) x).down : ℚ_[ℓ]) = 0 := congrArg ULift.down h
      exact PadicInt.coe_eq_zero.mp h'
    · intro h
      apply ULift.ext
      show (((f.comp g.left.base.hom) x).down : ℚ_[ℓ]) = 0
      rw [h]
      exact PadicInt.coe_zero
  obtain ⟨W₀, q, hW₀, hq, hq0, hqr⟩ := wc_affine_zero_locus_weaklyEtale W.left ℓ tQ
  obtain ⟨n, fb, hf⟩ := hqc W.left W.hom
  haveI := hq
  let W' : Fin (n + 1) → S.ProEt :=
    Fin.cases (MorphismProperty.Over.mk ⊤ (q ≫ W.hom) inferInstance)
      (fun k => MorphismProperty.Over.mk ⊤ ((W.left.basicOpen (fb k)).ι ≫ W.hom) inferInstance)
  let e : ∀ k, W' k ⟶ W := Fin.cases (motive := fun k => W' k ⟶ W)
    (MorphismProperty.Over.homMk q rfl trivial)
    (fun k => MorphismProperty.Over.homMk (W.left.basicOpen (fb k)).ι rfl trivial)
  refine ⟨n + 1, W', e, ?_, ?_, ?_⟩
  · intro j
    induction j using Fin.cases with
    | zero => exact hW₀
    | succ j => exact (isAffineOpen_top W.left).basicOpen (fb j)
  · intro x
    by_cases hx : W.hom x ∈ Set.range iT
    · exact ⟨0, hqr x ((htQ x).mpr (htW x hx))⟩
    · obtain ⟨j, hj⟩ := (hf x).mp hx
      refine ⟨j.succ, ?_⟩
      show x ∈ Set.range (W.left.basicOpen (fb j)).ι
      rw [Scheme.Opens.range_ι]
      exact hj
  · intro j
    induction j using Fin.cases with
    | zero =>
      right
      let G := SheafOfModules.forget (wcIntRingSheaf S ℓ) ⋙
        PresheafOfModules.evaluation _ (Opposite.op (W' 0))
      have hmono : Mono (G.map (Limits.kernel.ι π)) := Functor.map_mono G _
      have hinj := (ModuleCat.mono_iff_injective _).mp hmono
      apply hinj
      have hn := PresheafOfModules.naturality_apply (Limits.kernel.ι π).val (e 0 ≫ g).op k
      have h0 : (f.comp ((e 0 ≫ g).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} ℤ_[ℓ])) = 0 := by
        ext w
        exact congrArg ULift.down ((htQ (q w)).mp (hq0 w))
      refine (hn.trans ?_).trans (map_zero _).symm
      change f.comp ((e 0 ≫ g).left.base.hom) = 0
      exact h0
    | succ j =>
      left
      intro x
      have hx : (W.left.basicOpen (fb j)).ι x ∈ (W.left.basicOpen (fb j) : Set ↥W.left) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
      exact (hf _).mpr ⟨j, hx⟩

theorem wc_int_kernel_free_of_local_cover {S : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Tset : Set S) {P : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)} (π : wcIntUnit S ℓ ⟶ P)
    (hK : ∀ (V : S.ProEt) (f : (wcIntUnit S ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι π).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z ∈ Tset → (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (hcov : ∀ (U : S.ProEt) (k : (Limits.kernel π).val.obj (Opposite.op U))
      (W : S.ProEt) (g : W ⟶ U), IsAffine W.left →
      ∃ (n : ℕ) (W' : Fin n → S.ProEt) (e : ∀ j, W' j ⟶ W),
        (∀ j, IsAffine (W' j).left) ∧ (∀ x : ↥W.left, ∃ j, x ∈ Set.range (e j).left) ∧
        ∀ j, (∀ x : ↥(W' j).left, (W' j).hom x ∉ Tset) ∨
          ((Limits.kernel π).val.map (e j ≫ g).op).hom k = 0)
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf S ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (O : S.Opens) (hO : (O : Set S) = Tsetᶜ) :
    ∃ (ε : L.obj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) ≅ wcIntUnit S ℓ)
      (h : (L.map (wcFreeSheafMap S (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S))) ≫ ε.hom) ≫ π = 0),
      (ShortComplex.mk (L.map (wcFreeSheafMap S (MorphismProperty.Over.homMk O.ι
          (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 S))) ≫ ε.hom)
        π h).Exact :=
by
  classical
  let T : S.ProEt := Scheme.ProEt.mk (𝟙 S)
  let O' : S.ProEt := Scheme.ProEt.mk O.ι
  let ι : O' ⟶ T := MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom
      (fun Y' => MorphismProperty.Over.homMk Y'.hom (Category.comp_id _) trivial)
      (fun Y' m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id _).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨ε', hε'⟩ : ∃ ε' : wcFreeSheaf S T ⟶
      (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ),
      ∀ M : SheafOfModules (wcIntRingSheaf S ℓ),
