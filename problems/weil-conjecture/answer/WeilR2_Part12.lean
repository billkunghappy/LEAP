      calc (Abelian.Ext.mk₀ ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add n)
          = (ℓ ^ k : ℕ) • (Abelian.Ext.mk₀ (𝟙 (Limits.cokernel j))).comp x (zero_add n) := by
            rw [hmk, hL']
        _ = (ℓ ^ k : ℕ) • x := by rw [Abelian.Ext.mk₀_id_comp]
        _ = (ℓ ^ k : ℕ) • x.comp (Abelian.Ext.mk₀ (𝟙 (wcIntTors Y ℓ k))) (add_zero n) := by
            rw [Abelian.Ext.comp_mk₀_id]
        _ = x.comp (Abelian.Ext.mk₀ ((ℓ ^ k : ℕ) • 𝟙 (wcIntTors Y ℓ k))) (add_zero n) := by
            rw [hmk, hR']
        _ = 0 := by rw [hΛ, Abelian.Ext.mk₀_zero]; exact Abelian.Ext.comp_zero _ _ _ _ _
    calc x = (Abelian.Ext.mk₀ (inv ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)))).comp
          ((Abelian.Ext.mk₀ ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j))).comp x (zero_add n))
          (zero_add n) := by
          rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      _ = 0 := by rw [h1]; exact Abelian.Ext.comp_zero _ _ _ _ _

  obtain ⟨ρ, -, hρ⟩ := c3 (wcIntSuppπ Di) inferInstance j hQ

  let Ec : L.obj (Limits.cokernel w) ≅ Limits.cokernel (j ≫ Limits.kernel.ι (wcIntSuppπ Di)) :=
    Limits.PreservesCokernel.iso L w ≪≫ (Limits.cokernelCompIsIso (L.map w) φ).symm ≪≫
      Limits.cokernelIsoOfEq hfac.symm

  have hE2 : Function.Bijective (fun x : Abelian.Ext
      (Limits.cokernel (j ≫ Limits.kernel.ι (wcIntSuppπ Di))) (wcIntTors Y ℓ k) q =>
        (Abelian.Ext.mk₀ Ec.hom).comp x (zero_add q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun y => (Abelian.Ext.mk₀ Ec.inv).comp y (zero_add q), ?_, ?_⟩
    · intro β
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · intro γ
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]

  have hbij := ext_transfer_of_hom_bijective L
    (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) adj (Limits.cokernel w)
    (L.obj (Limits.cokernel w)) (adj.unit.app (Limits.cokernel w)) (by
      intro Z'
      have e : (fun f : L.obj (Limits.cokernel w) ⟶ Z' =>
          adj.unit.app (Limits.cokernel w) ≫
            (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).map f) =
          adj.homEquiv (Limits.cokernel w) Z' :=
        funext fun f => (adj.homEquiv_unit _ _ f).symm
      rw [e]
      exact (adj.homEquiv _ Z').bijective)

  obtain ⟨eΛ⟩ := wc_int_tors_toSheaf_zmod Y ℓ k
  have hE4 : Function.Bijective (fun x : Abelian.Ext (Limits.cokernel w)
      ((SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)).obj (wcIntTors Y ℓ k)) q =>
      x.comp (Abelian.Ext.mk₀ eΛ.hom) (add_zero q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun y => y.comp (Abelian.Ext.mk₀ eΛ.inv) (add_zero q), ?_, ?_⟩
    · intro x
      simp only
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · intro y
      simp only
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]

  exact ⟨(Equiv.ofBijective _ (hρ q)).trans ((Equiv.ofBijective _ hE2).trans
    ((Equiv.ofBijective _ (hbij (wcIntTors Y ℓ k) q)).trans (Equiv.ofBijective _ hE4)))⟩

theorem wc_et_closed_rightAdj_low_homology_zero (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) (n m r : ℕ) (hmr : m + r = n)
    [SmoothOfRelativeDimension n pY] (i : Z ⟶ Y) [IsClosedImmersion i]
    [SmoothOfRelativeDimension m (i ≫ pY)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (D : wcEtPullData i ℓ)
    (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ))
    [R.Additive] (adj : @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R)
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (q : ℕ) (hq : q < 2 * r) :
    Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  have hrn : r ≤ n := by omega
  have hnr : n - r = m := by omega
  have hk : (0 : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).X q) ≫
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d q (q + 1) = 0 :=
    Limits.zero_comp
  have hE := wc_et_mod_homology_epi_of_local_gen Z (wcEtZModRing Z ℓ)
    ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) q 0 hk ?_
  · have h0 : ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
        (0 : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
          ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).X q) (q + 1)
        (by simp) hk = 0 := by
      rw [← cancel_mono (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles q),
        HomologicalComplex.liftCycles_i, Limits.zero_comp]
    rw [h0, Limits.zero_comp] at hE
    exact @Limits.IsZero.of_epi_zero _ _ _ _ _ hE
  · intro V s hs v
    have hs' : ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op V)).hom s = 0 := hs
    obtain ⟨W, hV, x, hx⟩ : ∃ (W : Y.Etale) (hV : (wcEtBaseChange i).obj W ⟶ V)
        (x : ((wcEtBaseChange i).obj W).left), hV.left x = v := by
      have : Etale V.hom := V.prop
      obtain ⟨V', e, he, h, x', hh, hx'⟩ :=
        wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg i V.hom v
      exact ⟨MorphismProperty.Over.mk ⊤ e he, MorphismProperty.Over.homMk h hh trivial, x', hx'⟩
    obtain ⟨s₁, hs₁def⟩ : ∃ s₁ : (R.obj (I.cocomplex.X q)).val.obj
        (Opposite.op ((wcEtBaseChange i).obj W)),
        s₁ = ((R.obj (I.cocomplex.X q)).val.map hV.op).hom s := ⟨_, rfl⟩
    have hs₁ : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom s₁ = 0 := by
      rw [hs₁def, PresheafOfModules.naturality_apply, hs']; exact map_zero _
    let DW : ∀ W : Y.Etale, wcEtPullData (Limits.pullback.fst W.hom i) ℓ :=
      fun W => (wc_et_zmod_pull_data_exists (Limits.pullback.fst W.hom i) ℓ).some
    obtain ⟨cl, -, P2, -, -⟩ := wc_et_closed_rightAdj_cycle_class i ℓ D R adj I q DW
    haveI : Etale W.hom := W.prop
    haveI hWsm : SmoothOfRelativeDimension n (W.hom ≫ pY) := by
      have := smoothOfRelativeDimension_comp 0 n W.hom pY
      rwa [Nat.zero_add] at this
    haveI hZWsm : SmoothOfRelativeDimension (n - r)
        (Limits.pullback.fst W.hom i ≫ W.hom ≫ pY) := by
      rw [← Category.assoc, Limits.pullback.condition, Category.assoc, hnr]
      have := smoothOfRelativeDimension_comp 0 m (Limits.pullback.snd W.hom i) (i ≫ pY)
      rwa [Nat.zero_add] at this
    have hsemi := wc_et_supp_semipurity K W.left (Limits.pullback W.hom i) (W.hom ≫ pY) n r
      (Limits.pullback.fst W.hom i) hrn ℓ hℓ (DW W) q hq
    have hcl : cl W s₁ = cl W 0 := (hsemi _).trans (hsemi _).symm
    obtain ⟨e, he⟩ := P2 W s₁ 0 hs₁ (map_zero _) hcl
    refine ⟨(wcEtBaseChange i).obj W, hV, x, 0, e, hx, ?_⟩
    have hfin : ((R.obj (I.cocomplex.X q)).val.map hV.op).hom s =
        ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app
          (Opposite.op ((wcEtBaseChange i).obj W))).hom e := by
      rw [he, sub_zero, hs₁def]
    first
      | (rw [zero_nsmul, zero_add]; exact hfin)
      | (convert hfin using 1; simp)
      | simpa using hfin

theorem wc_et_closed_rightAdj_cycle_class_bdry : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive] (adj : @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (q : ℕ) (DW : ∀ W : Y.Etale, wcEtPullData (Limits.pullback.fst W.hom i) ℓ), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; ∃ cl : ∀ W : Y.Etale, (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) → wcEtSuppExt (DW W) q, (∀ (W : Y.Etale) (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))) (k : ℕ), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → cl W (k • x) = k • cl W x) ∧ (∀ (W : Y.Etale) (x y : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 → cl W x = cl W y → ∃ e : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom e = x - y) ∧ (∀ (W W₂ : Y.Etale) (h : W₂ ⟶ W) (Eh : wcEtPullData h.left ℓ) (γ : wcEtSuppObj (DW W₂) ⟶ Eh.Φ.obj (wcEtSuppObj (DW W))), wcEtSuppUnitMap (DW W₂) ≫ γ = Eh.μ.inv ≫ Eh.Φ.map (wcEtSuppUnitMap (DW W)) → ∀ x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)), ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 → wcEtSuppRestr (DW W) Eh (DW W₂) γ q (cl W x) = cl W₂ (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x)) ∧ (∀ (W : Y.Etale) (EW : wcEtPullData W.hom ℓ) (γ : wcEtSuppObj (DW W) ⟶ EW.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap (DW W) ≫ γ = EW.μ.inv ≫ EW.Φ.map (wcEtSuppUnitMap D) → ∀ (c : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj (SheafOfModules.unit (wcEtZModRing Z ℓ)) ⟶ I.cocomplex.X q) (hc : c ≫ I.cocomplex.d q (q + 1) = 0), cl W (((adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X q) c).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W)))) = wcEtSuppRestr D EW (DW W) γ q (I.extMk c (q + 1) rfl hc)) ∧ (∀ (W : Y.Etale) (e : (R.obj (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).val.obj (Opposite.op ((wcEtBaseChange i).obj W))), cl W (((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom e) = 0) :=
by
  intro Y Z i _ ℓ _ D R _ adj I q DW
  classical
  letI hExt : ∀ (S : Scheme.{u}), HasExt (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) :=
    fun S => HasExt.standard _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Y) (wcEtZModRing Y ℓ)
  obtain ⟨EW⟩ : Nonempty (∀ W : Y.Etale, wcEtPullData W.hom ℓ) :=
    ⟨fun W => (wc_et_zmod_pull_data_exists W.hom ℓ).some⟩
  haveI hEa : ∀ W : Y.Etale, (EW W).Φ.Additive := fun W => (EW W).additive
  haveI hEl : ∀ W : Y.Etale, Limits.PreservesFiniteLimits (EW W).Φ := fun W => (EW W).presLim
  haveI hEc : ∀ W : Y.Etale, Limits.PreservesFiniteColimits (EW W).Φ := fun W => (EW W).presColim
  obtain ⟨A, a, ε, Hnat, Hadd, Hbij, H4, H3⟩ :=
    wc_et_closed_rightAdj_supp_hom_dict i ℓ D R adj DW EW

  let aH : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      (A W ⟶ M) →+ (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) :=
    fun W M => AddMonoidHom.mk' (a W M) (Hadd W M)
  have ha0 : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), a W M 0 = 0 := by
    intro W M
    have h := map_zero (aH W M)
    simpa [aH] using h
  have hsub : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (x y : (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W))),
      (a W M).symm (x - y) = (a W M).symm x - (a W M).symm y := by
    intro W M x y
    apply (a W M).injective
    have h := map_sub (aH W M) ((a W M).symm x) ((a W M).symm y)
    simp only [aH, AddMonoidHom.mk'_apply, Equiv.apply_symm_apply] at h
    rw [Equiv.apply_symm_apply, h]
  have hnsmul : ∀ (W : Y.Etale) (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (x : (R.obj M).val.obj (Opposite.op ((wcEtBaseChange i).obj W))) (k : ℕ),
      (a W M).symm (k • x) = k • (a W M).symm x := by
    intro W M x k
    apply (a W M).injective
    have h := map_nsmul (aH W M) k ((a W M).symm x)
    simp only [aH, AddMonoidHom.mk'_apply, Equiv.apply_symm_apply] at h
    rw [Equiv.apply_symm_apply, h]

  have hcyc : ∀ (W : Y.Etale)
      (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W))),
      ((R.map (I.cocomplex.d q (q + 1))).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 →
      (a W (I.cocomplex.X q)).symm x ≫ I.cocomplex.d q (q + 1) = 0 := by
    intro W x hx
    apply (a W _).injective
    rw [Hnat, Equiv.apply_symm_apply, hx, ha0]

  have hextcongr : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f g : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hg : g ≫ I.cocomplex.d q (q + 1) = 0),
      f = g → I.extMk f (q + 1) rfl hf = I.extMk g (q + 1) rfl hg := by
    intro P f g hf hg hfg
    subst hfg
    rfl
  have hext_add : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f g : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hg : g ≫ I.cocomplex.d q (q + 1) = 0)
      (hfg : (f + g) ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk (f + g) (q + 1) rfl hfg = I.extMk f (q + 1) rfl hf + I.extMk g (q + 1) rfl hg :=
    fun f g hf hg _ => (I.add_extMk f g (q + 1) rfl hf hg).symm
  have hext_nsmul : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (k : ℕ)
      (hk : (k • f) ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk (k • f) (q + 1) rfl hk = k • I.extMk f (q + 1) rfl hf := by
    intro P f hf k
    induction k with
    | zero =>
      intro hk
      rw [hextcongr (0 • f) 0 hk Limits.zero_comp (zero_smul ℕ f),
        InjectiveResolution.extMk_zero, zero_smul]
    | succ k ih =>
      intro hk
      have hk' : (k • f) ≫ I.cocomplex.d q (q + 1) = 0 := by
        rw [Preadditive.nsmul_comp, hf, smul_zero]
      rw [hextcongr ((k + 1) • f) (k • f + f) hk
          (by rw [Preadditive.add_comp, hk', hf, add_zero]) (succ_nsmul f k),
        hext_add _ _ hk' hf, ih hk', succ_nsmul]
  have hext_sub : ∀ {P : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f g : P ⟶ I.cocomplex.X q)
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hg : g ≫ I.cocomplex.d q (q + 1) = 0)
      (hfg : (f - g) ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk (f - g) (q + 1) rfl hfg = I.extMk f (q + 1) rfl hf - I.extMk g (q + 1) rfl hg := by
    intro P f g hf hg hfg
    have h := I.add_extMk g (f - g) (q + 1) rfl hg hfg
    rw [hextcongr (g + (f - g)) f
      (by rw [Preadditive.add_comp, Preadditive.sub_comp, hf, hg, sub_zero, add_zero]) hf
      (by abel)] at h
    exact eq_sub_of_add_eq' h

  let Θ : ∀ (W : Y.Etale), Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q →
      wcEtSuppExt (DW W) q := fun W β =>
    (Abelian.Ext.mk₀ (ε W)).comp ((Abelian.Ext.mapExactFunctor (EW W).Φ β).comp
      (Abelian.Ext.mk₀ (EW W).μ.hom) (add_zero q)) (zero_add q)
  have hΘadd : ∀ (W : Y.Etale) (β₁ β₂ : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q),
      Θ W (β₁ + β₂) = Θ W β₁ + Θ W β₂ := by
    intro W β₁ β₂
    simp only [Θ, Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add]
  have hΘzero : ∀ (W : Y.Etale), Θ W 0 = 0 := by
    intro W
    simp only [Θ, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
  have hΘnsmul : ∀ (W : Y.Etale) (β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q)
      (k : ℕ), Θ W (k • β) = k • Θ W β := by
    intro W β k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, hΘzero]
    | succ k ih => rw [succ_nsmul, hΘadd, ih, succ_nsmul]
  have hΘmk : ∀ (W : Y.Etale) {M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (p : A W ⟶ M)
      (β : Abelian.Ext M (SheafOfModules.unit (wcEtZModRing Y ℓ)) q),
      Θ W ((Abelian.Ext.mk₀ p).comp β (zero_add q)) =
        (Abelian.Ext.mk₀ (ε W ≫ (EW W).Φ.map p)).comp
          ((Abelian.Ext.mapExactFunctor (EW W).Φ β).comp (Abelian.Ext.mk₀ (EW W).μ.hom)
            (add_zero q)) (zero_add q) := by
    intro W M p β
    simp only [Θ]
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc]

  have hinjΦ : ∀ (W : Y.Etale) (J : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      Injective J → Injective ((EW W).Φ.obj J) := by
    intro W J hJ
    haveI := (wc_et_slice_continuous W).1
    haveI := (wc_et_slice_continuous W).2
    obtain ⟨ψ, ⟨θ⟩⟩ := wc_et_etale_pull_restrict_iso W ℓ (EW W)
    have hJ' := wc_et_slice_module_restrict_injective W ℓ ψ J hJ
    exact Injective.of_iso (θ.app J).symm hJ'

  have hΘinj : ∀ (W : Y.Etale), Function.Injective (Θ W) := by
    intro W β₁ β₂ h
    haveI : EnoughInjectives (SheafOfModules.{u+1}
        (wcEtZModRing ((Functor.fromPUnit Y).obj W.right) ℓ)) :=
      sheafOfModules_enoughInjectives _ _
    have hinj := (ext_transfer_of_corep (EW W).Φ (A W) (wcEtSuppObj (DW W)) (ε W) (Hbij W)
      (by
        intro J hJ m x
        have hJ' : Injective ((EW W).Φ.obj J) := hinjΦ W J hJ
        exact @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ' x)
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) q).1
    apply hinj
    have e : ∀ β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
        (Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (EW W).Φ β) (zero_add q) =
        (Θ W β).comp (Abelian.Ext.mk₀ (EW W).μ.inv) (add_zero q) := by
      intro β
      simp only [Θ]
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    change (Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (EW W).Φ β₁) (zero_add q) =
      (Abelian.Ext.mk₀ (ε W)).comp (Abelian.Ext.mapExactFunctor (EW W).Φ β₂) (zero_add q)
    rw [e, e, h]

  let cl : ∀ W : Y.Etale, (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) →
      wcEtSuppExt (DW W) q := fun W x =>
    if hx : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0 then
      Θ W (I.extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx)) else 0
  have hcl : ∀ (W : Y.Etale)
      (x : (R.obj (I.cocomplex.X q)).val.obj (Opposite.op ((wcEtBaseChange i).obj W)))
      (hx : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom x = 0),
      cl W x = Θ W (I.extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx)) :=
    fun W x hx => dif_pos hx
  refine ⟨cl, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro W x k hx
    have hkx : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom (k • x) = 0 := by
      rw [map_nsmul, hx, smul_zero]
    rw [hcl W _ hkx, hcl W x hx]
    have hf : (k • (a W (I.cocomplex.X q)).symm x) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Preadditive.nsmul_comp, hcyc W x hx, smul_zero]
    rw [hextcongr _ _ (hcyc W _ hkx) hf (hnsmul W _ x k),
      hext_nsmul _ (hcyc W x hx) k hf, hΘnsmul]
  ·
    intro W x y hx hy hxy
    rw [hcl W x hx, hcl W y hy] at hxy
    have hβ := hΘinj W hxy
    have hfd : ((a W (I.cocomplex.X q)).symm x - (a W (I.cocomplex.X q)).symm y) ≫
        I.cocomplex.d q (q + 1) = 0 := by
      rw [Preadditive.sub_comp, hcyc W x hx, hcyc W y hy, sub_zero]
    have h0 : I.extMk ((a W (I.cocomplex.X q)).symm x - (a W (I.cocomplex.X q)).symm y)
        (q + 1) rfl hfd = 0 := by
      rw [hext_sub _ _ (hcyc W x hx) (hcyc W y hy) hfd, hβ, sub_self]
    rcases Nat.eq_zero_or_pos q with hq | hq
    · have hz := inj_res_extMk_deg_zero_injective I _ (q + 1) rfl hfd hq h0
      refine ⟨0, ?_⟩
      rw [map_zero]
      have h1 : (a W (I.cocomplex.X q)).symm (x - y) = 0 := by rw [hsub, hz]
      have h2 := congrArg (a W (I.cocomplex.X q)) h1
      rw [Equiv.apply_symm_apply, ha0] at h2
      exact h2.symm
    · obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 := ⟨q - 1, by omega⟩
      obtain ⟨g, hg⟩ := (I.extMk_eq_zero_iff _ (p + 1 + 1) rfl hfd p rfl).mp h0
      rw [CochainComplex.prev_nat_succ]
      refine ⟨a W (I.cocomplex.X p) g, ?_⟩
      rw [← Hnat, hg, ← hsub, Equiv.apply_symm_apply]
  ·
    intro W W₂ h Eh γ hγ x hx
    haveI := Eh.additive
    haveI := Eh.presLim
    haveI := Eh.presColim
    obtain ⟨r, τ, hr, hμ, hε⟩ := H3 W W₂ h Eh γ hγ
    have hx₂ : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W₂))).hom
        (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x) = 0 := by
      rw [PresheafOfModules.naturality_apply, hx]
      exact map_zero _
    rw [hcl W x hx, hcl W₂ _ hx₂]
    have hrs : (a W₂ (I.cocomplex.X q)).symm
        (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x) =
        r ≫ (a W (I.cocomplex.X q)).symm x := by
      apply (a W₂ _).injective
      refine ((a W₂ (I.cocomplex.X q)).apply_symm_apply _).trans ?_
      refine Eq.trans ?_ (hr (I.cocomplex.X q) ((a W (I.cocomplex.X q)).symm x)).symm
      exact congrArg _ ((a W (I.cocomplex.X q)).apply_symm_apply x).symm
    have hβ : I.extMk ((a W₂ (I.cocomplex.X q)).symm
        (((R.obj (I.cocomplex.X q)).val.map ((wcEtBaseChange i).map h).op).hom x)) (q + 1) rfl
        (hcyc W₂ _ hx₂) = (Abelian.Ext.mk₀ r).comp
          (I.extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx)) (zero_add q) := by
      exact (hextcongr _ _ _ _ hrs).trans
        (I.mk₀_comp_extMk ((a W (I.cocomplex.X q)).symm x) (q + 1) rfl (hcyc W x hx) r).symm
    have h2 : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1} (wcEtZModRing W₂.left ℓ)} {n : ℕ}
        (f : A₁ ⟶ B₁) (g : B₁ ⟶ C₁) (z : Abelian.Ext C₁ D₁ n),
        (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add n)) (zero_add n) =
          (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add n) := by
      intro A₁ B₁ C₁ D₁ n f g z
      exact Abelian.Ext.mk₀_comp_mk₀_assoc f g z
    have h3 : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1} (wcEtZModRing W₂.left ℓ)} {n : ℕ}
        (z : Abelian.Ext A₁ B₁ n) (f : B₁ ⟶ C₁) (g : C₁ ⟶ D₁),
        (z.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
      intro A₁ B₁ C₁ D₁ n z f g
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have h4 : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1} (wcEtZModRing W₂.left ℓ)} {n : ℕ}
        (f : A₁ ⟶ B₁) (z : Abelian.Ext B₁ C₁ n) (g : C₁ ⟶ D₁),
        ((Abelian.Ext.mk₀ f).comp z (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero n)) (zero_add n) := by
      intro A₁ B₁ C₁ D₁ n f z g
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    have hL : ∀ β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
        wcEtSuppRestr (DW W) Eh (DW W₂) γ q (Θ W β) =
        (Abelian.Ext.mk₀ (γ ≫ Eh.Φ.map (ε W))).comp
          ((Abelian.Ext.mapExactFunctor Eh.Φ (Abelian.Ext.mapExactFunctor (EW W).Φ β)).comp
            (Abelian.Ext.mk₀ (Eh.Φ.map (EW W).μ.hom ≫ Eh.μ.hom)) (add_zero q)) (zero_add q) := by
      intro β
      show (Abelian.Ext.mk₀ γ).comp ((Abelian.Ext.mapExactFunctor Eh.Φ (Θ W β)).comp
        (Abelian.Ext.mk₀ Eh.μ.hom) (add_zero q)) (zero_add q) = _
      simp only [Θ]
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀, h4, h3, h2]
    have hR : ∀ β : Abelian.Ext (A W) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
        Θ W₂ ((Abelian.Ext.mk₀ r).comp β (zero_add q)) =
        (Abelian.Ext.mk₀ (ε W₂ ≫ (EW W₂).Φ.map r ≫ τ.hom.app (A W))).comp
          ((Abelian.Ext.mapExactFunctor Eh.Φ (Abelian.Ext.mapExactFunctor (EW W).Φ β)).comp
            (Abelian.Ext.mk₀ (Eh.Φ.map (EW W).μ.hom ≫ Eh.μ.hom)) (add_zero q)) (zero_add q) := by
      intro β
      have hnat := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β τ.hom
      rw [Abelian.Ext.comp_mapExactFunctor] at hnat
      simp only [Θ]
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, hμ,
        ← h3 ((Abelian.Ext.mk₀ ((EW W₂).Φ.map r)).comp
          (Abelian.Ext.mapExactFunctor (EW W₂).Φ β) (zero_add q))
          (τ.hom.app (SheafOfModules.unit (wcEtZModRing Y ℓ)))
          (Eh.Φ.map (EW W).μ.hom ≫ Eh.μ.hom),
        h4, hnat, h2, h4, h2]
    rw [hβ, hL, hR, hε]
  ·
    intro W EW' γ' hγ' c hc
    obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i W.hom (Limits.pullback.fst W.hom i)
      (Limits.pullback.snd W.hom i) (IsPullback.of_hasPullback W.hom i).flip D (EW W) (DW W)

    have hindep : ∀ (E E' : wcEtPullData W.hom ℓ)
        (g₁ : wcEtSuppObj (DW W) ⟶ E.Φ.obj (wcEtSuppObj D))
        (g₂ : wcEtSuppObj (DW W) ⟶ E'.Φ.obj (wcEtSuppObj D)),
        wcEtSuppUnitMap (DW W) ≫ g₁ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) →
        wcEtSuppUnitMap (DW W) ≫ g₂ = E'.μ.inv ≫ E'.Φ.map (wcEtSuppUnitMap D) →
        ∀ θ : wcEtSuppExt D q,
          wcEtSuppRestr D E (DW W) g₁ q θ = wcEtSuppRestr D E' (DW W) g₂ q θ := by
      intro E E' g₁ g₂ hg₁ hg₂ θ
      obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (𝟙 W.left) ℓ
      obtain ⟨γ₂, hγ₂, hep⟩ := wc_et_closed_supp_base_change (Limits.pullback.fst W.hom i)
        (𝟙 W.left) (Limits.pullback.fst W.hom i) (𝟙 _) IsPullback.of_id_fst (DW W) E₂ (DW W)
      have ha := wc_et_supp_restr_comp W.hom (𝟙 W.left) W.hom (Category.id_comp _) D (DW W) (DW W)
        E E₂ E' g₁ γ₂ g₂ hg₁ hγ₂ hg₂ hep q θ
      have hb := wc_et_supp_restr_comp W.hom (𝟙 W.left) W.hom (Category.id_comp _) D (DW W) (DW W)
        E E₂ E g₁ γ₂ g₁ hg₁ hγ₂ hg₁ hep q θ
      exact hb.trans ha.symm
    let P0 : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) :=
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing Z ℓ))
    let u1 : (R.obj P0).val.obj (Opposite.op ((wcEtBaseChange i).obj W)) :=
      ((adj.unit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))).val.app
          (Opposite.op ((wcEtBaseChange i).obj W))).hom
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W)))
    let π : A W ⟶ P0 := (a W P0).symm u1
    have H4' : ε W ≫ (EW W).Φ.map π = γW := H4 W γW hγW
    have hπ : a W P0 π = u1 := (a W P0).apply_symm_apply u1
    obtain ⟨y, hydef⟩ : ∃ y : (R.obj (I.cocomplex.X q)).val.obj
        (Opposite.op ((wcEtBaseChange i).obj W)),
        y = ((adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X q) c).val.app
          (Opposite.op ((wcEtBaseChange i).obj W))).hom
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W))) := ⟨_, rfl⟩
    rw [← hydef]
    have e1 := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ R.obj (I.cocomplex.X q) =>
      (φ.val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom
        (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op ((wcEtBaseChange i).obj W))))
      (adj.homEquiv_unit (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X q) c)
    have hy : y = a W (I.cocomplex.X q) (π ≫ c) :=
      hydef.trans (e1.trans ((Hnat W P0 (I.cocomplex.X q) π c).trans
        (congrArg (fun z => ((R.map c).val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom z)
          hπ)).symm)
    have hπc : (π ≫ c) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Category.assoc, hc, Limits.comp_zero]
    have hyc : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom y = 0 := by
      rw [hy]
      refine (Hnat W _ _ (π ≫ c) (I.cocomplex.d q (q + 1))).symm.trans ?_
      rw [hπc]
      exact ha0 W _
    have hsy : (a W (I.cocomplex.X q)).symm y = π ≫ c := by
      rw [hy]
      exact (a W (I.cocomplex.X q)).symm_apply_apply _
    have hβ : I.extMk ((a W (I.cocomplex.X q)).symm y) (q + 1) rfl (hcyc W y hyc) =
        (Abelian.Ext.mk₀ π).comp (I.extMk c (q + 1) rfl hc) (zero_add q) :=
      (hextcongr _ _ _ _ hsy).trans (I.mk₀_comp_extMk c (q + 1) rfl hc π).symm
    rw [hcl W y hyc, hβ, hΘmk W π, H4']
    refine Eq.trans ?_ (hindep (EW W) EW' γW γ' hγW hγ' _)
    rfl
  ·
    intro W e
    have hgen : ∀ (g : A W ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev q))
        (hf : (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) ≫ I.cocomplex.d q (q + 1) = 0),
        I.extMk (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) (q + 1) rfl hf = 0 := by
      intro g hf
      rcases Nat.eq_zero_or_pos q with hq | hq
      · subst hq
        have hd : I.cocomplex.d ((ComplexShape.up ℕ).prev 0) 0 = 0 :=
          I.cocomplex.shape _ _ (by rw [ComplexShape.up_Rel]; omega)
        rw [hextcongr _ 0 hf Limits.zero_comp (by rw [hd, Limits.comp_zero]),
          InjectiveResolution.extMk_zero]
      · obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 := ⟨q - 1, by omega⟩
        refine (I.extMk_eq_zero_iff _ (p + 1 + 1) rfl hf p rfl).mpr
          ⟨g ≫ (I.cocomplex.XIsoOfEq (CochainComplex.prev_nat_succ p)).hom, ?_⟩
        rw [Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d]
    obtain ⟨g, rfl⟩ := (a W (I.cocomplex.X ((ComplexShape.up ℕ).prev q))).surjective e
    have hf : (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) ≫ I.cocomplex.d q (q + 1) = 0 := by
      rw [Category.assoc, HomologicalComplex.d_comp_d, Limits.comp_zero]
    have hx' : ((R.map (I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom
          (a W (I.cocomplex.X ((ComplexShape.up ℕ).prev q)) g) =
        a W (I.cocomplex.X q) (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q) :=
      (Hnat W _ _ g _).symm
    have hxc : ((R.map (I.cocomplex.d q (q + 1))).val.app
        (Opposite.op ((wcEtBaseChange i).obj W))).hom
        (a W (I.cocomplex.X q) (g ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q)) = 0 := by
      rw [← Hnat, hf, ha0]
    rw [hx', hcl W _ hxc, hextcongr _ _ (hcyc W _ hxc) hf ((a W _).symm_apply_apply _),
      hgen g hf, hΘzero]

theorem wc_et_mod_homology_mono_of_local_dvd (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Kc : CochainComplex (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) ℕ) (n : ℕ)
    (k : SheafOfModules.unit (wcEtZModRing S ℓ) ⟶ Kc.X n) (hk : k ≫ Kc.d n (n + 1) = 0)
    (hloc : ∀ (T : S.Etale) (a : ℕ)
      (e : (Kc.X ((ComplexShape.up ℕ).prev n)).val.obj (Opposite.op T)),
      ((Kc.d ((ComplexShape.up ℕ).prev n) n).val.app (Opposite.op T)).hom e =
        a • (k.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op T)) →
      Nonempty T.left → ℓ ∣ a) :
    Mono (Kc.liftCycles k (n + 1) (by simp) hk ≫ Kc.homologyπ n) :=
by
  classical
  have hp : Nat.Prime ℓ := Fact.out
  haveI : NeZero ℓ := ⟨hp.ne_zero⟩

  have hchar : ∀ W : S.Etale, ℓ • (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) = 0 := by
    intro W
    have h := (wc_et_zmod_unit_pow_exact S ℓ 1 hp.pos).1
    rw [pow_one] at h
    let ev : (SheafOfModules.unit (wcEtZModRing S ℓ) ⟶ SheafOfModules.unit (wcEtZModRing S ℓ)) →+
        (SheafOfModules.unit (wcEtZModRing S ℓ)).val.obj (Opposite.op W) :=
      AddMonoidHom.mk' (fun f => (f.val.app (Opposite.op W)).hom
          (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W))) (fun f g => by
        first
        | rfl
        | simp only [SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
            LinearMap.add_apply])
    have h3 := congrArg ev h
    rw [map_nsmul, map_zero] at h3
    have h1 : ev (𝟙 (SheafOfModules.unit (wcEtZModRing S ℓ))) =
        (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) := by
      first
      | rfl
      | simp [ev]
    rw [h1] at h3
    first
    | exact h3
    | (convert h3 using 1)
  have hcharC : ∀ W : S.Etale, ((ℓ : ℕ) : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) = 0 := by
    intro W
    rw [← nsmul_one]
    exact hchar W
  obtain ⟨φ, hφ⟩ : ∃ φ : SheafOfModules.unit (wcEtZModRing S ℓ) ⟶ Kc.homology n,
      φ = Kc.liftCycles k (n + 1) (by simp) hk ≫ Kc.homologyπ n := ⟨_, rfl⟩
  rw [← hφ]

  have hdvd : ∀ (W : S.Etale) (w : W.left) (a : ℕ),
      a • (φ.val.app (Opposite.op W)).hom (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) = 0 →
      ℓ ∣ a := by
    intro W w a ha
    have hne : (φ.val.app (Opposite.op W)).hom
        (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) ≠ 0 := by
      intro h0
      have h0' : ((Kc.liftCycles k (n + 1) (by simp) hk ≫ Kc.homologyπ n).val.app
          (Opposite.op W)).hom (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) = 0 := by
        rw [← hφ]; exact h0
      obtain ⟨T, h, t, e, -, he⟩ :=
        wc_et_mod_homology_local_boundary S (wcEtZModRing S ℓ) Kc n k hk W w h0'
      have h1 := hloc T 1 e (by rw [he, one_nsmul]) ⟨t⟩
      exact hp.not_dvd_one h1
    have htor : ℓ • (φ.val.app (Opposite.op W)).hom
        (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) = 0 := by
      calc ℓ • (φ.val.app (Opposite.op W)).hom (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W))
          = (φ.val.app (Opposite.op W)).hom
              (ℓ • (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W))) := (map_nsmul _ _ _).symm
        _ = (φ.val.app (Opposite.op W)).hom
              (0 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W)) := congrArg _ (hchar W)
        _ = 0 := map_zero _
    have hord : addOrderOf ((φ.val.app (Opposite.op W)).hom
        (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op W))) = ℓ := by
      rcases hp.eq_one_or_self_of_dvd _ (addOrderOf_dvd_of_nsmul_eq_zero htor) with h | h
      · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hne
      · exact h
    rw [← hord]
    exact addOrderOf_dvd_of_nsmul_eq_zero ha

  have s1 : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S ℓ)) (V : S.Etale)
      (x : M.val.obj (Opposite.op V)),
      (∀ v : V.left, ∃ (T : S.Etale) (h : T ⟶ V) (t : T.left), h.left t = v ∧
        (M.val.map h.op).hom x = 0) → x = 0 := by
    intro M V x H
    let Sv : Sieve V :=
      { arrows := fun T f => (M.val.map f.op).hom x = 0
        downward_closed := by
          intro T Z f hf g
          show (M.val.map (g ≫ f).op).hom x = 0
          rw [op_comp, PresheafOfModules.map_comp_apply]
          rw [show (M.val.map f.op).hom x = 0 from hf]
          exact map_zero _ }
    have hcov : Sv ∈ Scheme.smallEtaleTopology S V := by
      have h1 := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V Sv).mpr
        (fun v => by
          obtain ⟨T, h, t, ht, hx⟩ := H v
          exact ⟨T, h, t, hx, inferInstance, ht⟩)
      rw [← @Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at h1
      exact h1
    exact Sheaf.isSeparated ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ)).obj M) V Sv hcov x 0
      (fun T f hf => by
        change (M.val.map f.op).hom x = (M.val.map f.op).hom 0
        rw [map_zero]
        exact hf)

  apply Preadditive.mono_of_cancel_zero
  intro P g hg
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X
  obtain ⟨V⟩ := X
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro c
  change (g.val.app (Opposite.op V)).hom c = 0
  have hs : (φ.val.app (Opposite.op V)).hom ((g.val.app (Opposite.op V)).hom c) = 0 :=
    congrArg (fun f : P ⟶ Kc.homology n => (f.val.app (Opposite.op V)).hom c) hg
  generalize (g.val.app (Opposite.op V)).hom c = s at hs ⊢
  apply s1 (SheafOfModules.unit (wcEtZModRing S ℓ)) V s
  intro v
  have hS0 := wc_et_zmod_section_locally_nat S ℓ V s
  have hS : Sieve.generate (fun (W' : S.Etale) (g' : W' ⟶ V) => ∃ a : ℕ,
      ((wcEtZModRing S ℓ).obj.map g'.op).hom s =
        ((a : ℕ) : ↑((wcEtZModRing S ℓ).obj.obj (Opposite.op W')))) ∈
      Scheme.smallGrothendieckTopology @Etale S V := hS0
  have hpt := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V _).mp
    ((@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl) ▸ hS)
  obtain ⟨T, Y', g₂, g', a, ha, t, ht⟩ : ∃ (T Y' : S.Etale) (g₂ : T ⟶ Y') (g' : Y' ⟶ V) (a : ℕ),
      ((wcEtZModRing S ℓ).obj.map g'.op).hom s =
        ((a : ℕ) : (wcEtZModRing S ℓ).obj.obj (Opposite.op Y')) ∧
      ∃ t : T.left, (g₂ ≫ g').left t = v := by
    obtain ⟨T, f, t, hmem, -, ht⟩ := hpt v
    obtain ⟨Y', g₂, g', ⟨a, ha⟩, rfl⟩ := hmem
    exact ⟨T, Y', g₂, g', a, ha, t, ht⟩
  refine ⟨T, g₂ ≫ g', t, ht, ?_⟩
  have hRa : ((wcEtZModRing S ℓ).obj.map (g₂ ≫ g').op).hom s =
      ((a : ℕ) : (wcEtZModRing S ℓ).obj.obj (Opposite.op T)) := by
    have hcomp : ((wcEtZModRing S ℓ).obj.map (g₂ ≫ g').op).hom s =
        ((wcEtZModRing S ℓ).obj.map g₂.op).hom (((wcEtZModRing S ℓ).obj.map g'.op).hom s) := by
      rw [op_comp, Functor.map_comp]
      rfl
    exact hcomp.trans ((congrArg (fun z => ((wcEtZModRing S ℓ).obj.map g₂.op).hom z) ha).trans
      (map_natCast _ _))
  have hnat : (φ.val.app (Opposite.op T)).hom
      (((SheafOfModules.unit (wcEtZModRing S ℓ)).val.map (g₂ ≫ g').op).hom s) =
      ((Kc.homology n).val.map (g₂ ≫ g').op).hom ((φ.val.app (Opposite.op V)).hom s) :=
    PresheafOfModules.naturality_apply φ.val (g₂ ≫ g').op s
  rw [hs, map_zero] at hnat
  have e2 : (a • (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op T))) =
      ((SheafOfModules.unit (wcEtZModRing S ℓ)).val.map (g₂ ≫ g').op).hom s := by
    rw [nsmul_one]
    exact hRa.symm
  have ha' : a • (φ.val.app (Opposite.op T)).hom
      (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op T)) = 0 := by
    calc a • (φ.val.app (Opposite.op T)).hom (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op T))
        = (φ.val.app (Opposite.op T)).hom
            (a • (1 : (wcEtZModRing S ℓ).obj.obj (Opposite.op T))) := (map_nsmul _ _ _).symm
      _ = (φ.val.app (Opposite.op T)).hom
            (((SheafOfModules.unit (wcEtZModRing S ℓ)).val.map (g₂ ≫ g').op).hom s) :=
          congrArg _ e2
      _ = 0 := hnat
  obtain ⟨c', rfl⟩ := hdvd T t a ha'
  change ((wcEtZModRing S ℓ).obj.map (g₂ ≫ g').op).hom s = 0
  rw [hRa, Nat.cast_mul, hcharC T, zero_mul]

theorem wc_smooth_pair_transversal_point_slice (K : Type u) [Field K] [IsAlgClosed K]
    (W ZW : Scheme.{u}) (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW]
    (iW : ZW ⟶ W) [IsClosedImmersion iW] [SmoothOfRelativeDimension (n - c) (iW ≫ fW)]
    (hcn : c ≤ n) (hZ : Nonempty ZW) :
    ∃ (N : Scheme.{u}) (fN : N ⟶ Spec (.of K)) (f : N ⟶ W) (x : Spec (.of K) ⟶ N)
      (g : Spec (.of K) ⟶ ZW),
      SmoothOfRelativeDimension c fN ∧ IsSeparated fN ∧ f ≫ fW = fN ∧ x ≫ fN = 𝟙 _ ∧
      IsPullback g x iW f :=
by
  classical

  have hsm0 : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) [Etale ψ] (φ : B ⟶ C) (k : ℕ)
      [SmoothOfRelativeDimension k φ], SmoothOfRelativeDimension k (ψ ≫ φ) := by
    intro A B C ψ _ φ k _
    have := smoothOfRelativeDimension_comp 0 k ψ φ
    rwa [Nat.zero_add] at this

  have hsma : SmoothOfRelativeDimension c
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension c), CommRingCat.hom_ofHom]
    apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have h := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin c)
    rwa [Nat.card_fin] at h
  have hoa0 : Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
    simp

  haveI : Smooth (iW ≫ fW) := SmoothOfRelativeDimension.smooth (n - c) _
  obtain ⟨y₀, hy₀⟩ := wc_alg_closed_lft_section K ZW (iW ≫ fW) hZ
  let pt : (Spec (.of K) : Scheme.{u}) := IsLocalRing.closedPoint K
  obtain ⟨W₁, -, hzW₁, htube⟩ :=
    wc_smooth_pair_etale_tube_over_base K W ZW fW n c iW hcn ⊤ (y₀ pt) trivial
  obtain ⟨ZW₁, gW₁, iW₁, hZ1⟩ : ∃ (ZW₁ : Scheme.{u}) (gW₁ : ZW₁ ⟶ ZW) (iW₁ : ZW₁ ⟶ W₁),
      IsPullback gW₁ iW₁ iW W₁.ι := ⟨_, _, _, IsPullback.of_hasPullback iW W₁.ι⟩
  have hr : Set.range (y₀ ≫ iW) ⊆ Set.range W₁.ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply, Subsingleton.elim y pt]
    exact hzW₁
  obtain ⟨w₀, hw₀⟩ : ∃ w₀ : Spec (.of K) ⟶ (W₁ : Scheme.{u}), w₀ ≫ W₁.ι = y₀ ≫ iW :=
    ⟨IsOpenImmersion.lift W₁.ι (y₀ ≫ iW) hr, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨z₁, hz₁g, hz₁i⟩ : ∃ z₁ : Spec (.of K) ⟶ ZW₁, z₁ ≫ gW₁ = y₀ ∧ z₁ ≫ iW₁ = w₀ :=
    ⟨hZ1.lift y₀ w₀ hw₀.symm, hZ1.lift_fst _ _ _, hZ1.lift_snd _ _ _⟩
  obtain ⟨qB, hqB⟩ : ∃ qB : ZW₁ ⟶ Spec (.of K), qB = iW₁ ≫ W₁.ι ≫ fW := ⟨_, rfl⟩
  have hz₁ : z₁ ≫ qB = 𝟙 _ := by
    rw [hqB, reassoc_of% hz₁i, reassoc_of% hw₀]
    exact hy₀

  obtain ⟨a, ha⟩ : ∃ a : Spec (.of (MvPolynomial (Fin c) K)) ⟶ Spec (.of K),
      a = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) := ⟨_, rfl⟩
  obtain ⟨o, ho⟩ : ∃ o : Spec (.of K) ⟶ Spec (.of (MvPolynomial (Fin c) K)),
      o = Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) := ⟨_, rfl⟩
  have hoa : o ≫ a = 𝟙 _ := by rw [ho, ha]; exact hoa0
  haveI : SmoothOfRelativeDimension c a := by rw [ha]; exact hsma
  obtain ⟨P, p, q, hP⟩ : ∃ (P : Scheme.{u}) (p : P ⟶ ZW₁)
      (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))), IsPullback p q qB a :=
    ⟨_, _, _, IsPullback.of_hasPullback qB a⟩
  obtain ⟨z0, hz0p, hz0q⟩ : ∃ z0 : ZW₁ ⟶ P, z0 ≫ p = 𝟙 ZW₁ ∧ z0 ≫ q = qB ≫ o :=
    ⟨hP.lift (𝟙 ZW₁) (qB ≫ o) (by rw [Category.id_comp, Category.assoc, hoa, Category.comp_id]),
      hP.lift_fst _ _ _, hP.lift_snd _ _ _⟩
  obtain ⟨s, hsp, hsq⟩ : ∃ s : Spec (.of (MvPolynomial (Fin c) K)) ⟶ P,
      s ≫ p = a ≫ z₁ ∧ s ≫ q = 𝟙 _ :=
    ⟨hP.lift (a ≫ z₁) (𝟙 _) (by rw [Category.assoc, hz₁, Category.comp_id, Category.id_comp]),
      hP.lift_fst _ _ _, hP.lift_snd _ _ _⟩
  have hP' : IsPullback p q (iW₁ ≫ W₁.ι ≫ fW)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) := by
    rw [← hqB, ← ha]; exact hP
  have hz0q' : z0 ≫ q = (iW₁ ≫ W₁.ι ≫ fW) ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) := by
    rw [← hqB, ← ho]; exact hz0q
  obtain ⟨-, V', π, σ, e, hπe, hσe, hπ, hσ, hcompat⟩ :=
    htube ZW₁ iW₁ gW₁ hZ1 P p q z0 hP' hz0p hz0q'
  haveI := hπe
  haveI := hσe
  have hcompat' : σ ≫ p ≫ qB = π ≫ W₁.ι ≫ fW := by rw [hqB]; exact hcompat

  have hslice : IsPullback z₁ o z0 s := by
    have comm : z₁ ≫ z0 = o ≫ s := by
      apply hP.hom_ext
      · simp only [Category.assoc, hz0p, hsp, reassoc_of% hoa, Category.comp_id,
          Category.id_comp]
      · simp only [Category.assoc, hz0q, hsq, reassoc_of% hz₁, Category.comp_id,
          Category.id_comp]
    refine IsPullback.mk ⟨comm⟩
      ⟨Limits.PullbackCone.IsLimit.mk comm (fun T => T.snd ≫ a) ?_ ?_ ?_⟩
    · intro T
      have h := congrArg (fun k => k ≫ p) T.condition
      simp only [Category.assoc, hz0p, hsp, Category.comp_id] at h
      show (T.snd ≫ a) ≫ z₁ = T.fst
      rw [Category.assoc]; exact h.symm
    · intro T
      have h1 := congrArg (fun k => k ≫ p) T.condition
      have h2 := congrArg (fun k => k ≫ q) T.condition
      simp only [Category.assoc, hz0p, hsp, Category.comp_id] at h1
      simp only [Category.assoc, hz0q, hsq, Category.comp_id] at h2
      show (T.snd ≫ a) ≫ o = T.snd
      calc (T.snd ≫ a) ≫ o = T.snd ≫ a ≫ (z₁ ≫ qB) ≫ o := by
            rw [hz₁, Category.id_comp, Category.assoc]
        _ = T.fst ≫ qB ≫ o := by rw [h1]; simp only [Category.assoc]
        _ = T.snd := h2
    · intro T m _ hm2
      show m = T.snd ≫ a
      rw [← hm2, Category.assoc, hoa, Category.comp_id]

  obtain ⟨N', σ', t, hN⟩ : ∃ (N' : Scheme.{u}) (σ' : N' ⟶ V')
      (t : N' ⟶ Spec (.of (MvPolynomial (Fin c) K))), IsPullback σ' t σ s :=
    ⟨_, _, _, IsPullback.of_hasPullback σ s⟩
  haveI : Etale t := MorphismProperty.of_isPullback (P := @Etale) hN hσe
  have heσ : e ≫ σ = z0 := hσ.w.symm.trans (Category.id_comp _)
  have hx : (z₁ ≫ e) ≫ σ = o ≫ s := by rw [Category.assoc, heσ]; exact hslice.w
  obtain ⟨x', hx'σ, hx't⟩ : ∃ x' : Spec (.of K) ⟶ N', x' ≫ σ' = z₁ ≫ e ∧ x' ≫ t = o :=
    ⟨hN.lift (z₁ ≫ e) o hx, hN.lift_fst _ _ _, hN.lift_snd _ _ _⟩
  have hA : IsPullback z₁ x' e σ' := by
    refine IsPullback.of_bot ?_ hx'σ.symm hN
    rw [hx't, heσ]; exact hslice

  have hF : IsPullback gW₁ e iW (π ≫ W₁.ι) := by
    have h := hπ.paste_horiz hZ1
    rwa [Category.id_comp] at h
  have hfib : IsPullback (z₁ ≫ gW₁) x' iW (σ' ≫ π ≫ W₁.ι) := hA.paste_horiz hF
  have hfN : σ' ≫ π ≫ W₁.ι ≫ fW = t ≫ a := by
    rw [← hcompat', ← Category.assoc σ' σ, hN.w, Category.assoc, reassoc_of% hsp, hz₁,
      Category.comp_id]

  obtain ⟨U, hUa, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := x' pt) (U := (⊤ : N'.Opens)) trivial
  have hrU : Set.range x' ⊆ Set.range U.ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι, Subsingleton.elim y pt]
    exact hxU
  obtain ⟨xU, hxU'⟩ : ∃ xU : Spec (.of K) ⟶ (U : Scheme.{u}), xU ≫ U.ι = x' :=
    ⟨IsOpenImmersion.lift U.ι x' hrU, IsOpenImmersion.lift_fac _ _ _⟩
  have hleft : IsPullback (𝟙 _) xU x' U.ι :=
    IsPullback.of_horiz_isIso_mono ⟨by rw [Category.id_comp, hxU']⟩
  have hfinal : IsPullback (z₁ ≫ gW₁) xU iW (U.ι ≫ σ' ≫ π ≫ W₁.ι) := by
    have h := hleft.paste_horiz hfib
    rwa [Category.id_comp] at h
  haveI : IsAffine (U : Scheme.{u}) := hUa
  haveI : SmoothOfRelativeDimension c (t ≫ a) := hsm0 t a c
  refine ⟨U, U.ι ≫ t ≫ a, U.ι ≫ σ' ≫ π ≫ W₁.ι, xU, z₁ ≫ gW₁, hsm0 U.ι (t ≫ a) c,
    inferInstance, ?_, ?_, hfinal⟩
  · simp only [Category.assoc]
    rw [hfN]
  · rw [reassoc_of% hxU', reassoc_of% hx't, hoa]

theorem wc_et_closed_rightAdj_top_homology_unit_iso (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0) (D : wcEtPullData i ℓ)
    (R : SheafOfModules.{u+1} (wcEtZModRing Y ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ))
    [R.Additive] (adj : @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R)
    (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
    ∃ φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (2 * r),
      IsIso φ :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace pY
  have hrn : r ≤ n := by omega
  have hnr : n - r = m := by omega
  haveI hsm : SmoothOfRelativeDimension (n - r) (i ≫ pY) := by rw [hnr]; infer_instance
  obtain ⟨T, hGL, hNat, hPt⟩ := wc_et_kummer_local_thom K ℓ hℓ
  obtain ⟨θ, hθ⟩ := wc_et_thom_class_glue K ℓ hℓ T hGL hNat Y Z pY n r i hrn D
  obtain ⟨c₀, hc₀, hcθ₀⟩ := I.extMk_surjective θ (2 * r + 1) rfl
  obtain ⟨c, hc, hcθ⟩ : ∃ (c : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _
      D.cont D.φ).obj (SheafOfModules.unit (wcEtZModRing Z ℓ)) ⟶ I.cocomplex.X (2 * r))
      (hc : c ≫ I.cocomplex.d (2 * r) (2 * r + 1) = 0), I.extMk c (2 * r + 1) rfl hc = θ :=
    ⟨c₀, hc₀, hcθ₀⟩
  obtain ⟨cb, hcb⟩ : ∃ cb : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ R.obj (I.cocomplex.X (2 * r)),
      cb = adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X (2 * r)) c :=
    ⟨_, rfl⟩
  have hk' : cb ≫ R.map (I.cocomplex.d (2 * r) (2 * r + 1)) = 0 := by
    have e := adj.homEquiv_naturality_right c (I.cocomplex.d (2 * r) (2 * r + 1))
    have hz : adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z ℓ)) (I.cocomplex.X (2 * r + 1))
        (0 : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcEtZModRing Z ℓ)) ⟶ I.cocomplex.X (2 * r + 1)) = 0 := by
      simp [Adjunction.homEquiv_unit]
    rw [hc, hz] at e
    rw [hcb]; exact e.symm
  have hk : cb ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d (2 * r)
      (2 * r + 1) = 0 := hk'
  have hy0 : ∀ X : (Z.Etale)ᵒᵖ, ((R.map (I.cocomplex.d (2 * r) (2 * r + 1))).val.app X).hom
      ((cb.val.app X).hom (1 : (wcEtZModRing Z ℓ).obj.obj X)) = 0 := by
    intro X
    have h := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶
        R.obj (I.cocomplex.X (2 * r + 1)) =>
      (φ.val.app X).hom (1 : (wcEtZModRing Z ℓ).obj.obj X)) hk'
    exact h

  let DW : ∀ W : Y.Etale, wcEtPullData (Limits.pullback.fst W.hom i) ℓ :=
    fun W => (wc_et_zmod_pull_data_exists (Limits.pullback.fst W.hom i) ℓ).some
  obtain ⟨cl, P1, P2, P3, P4, P5⟩ :=
    wc_et_closed_rightAdj_cycle_class_bdry i ℓ D R adj I (2 * r) DW
  have hWsm : ∀ W : Y.Etale, SmoothOfRelativeDimension n (W.hom ≫ pY) := by
    intro W
    haveI : Etale W.hom := W.prop
    have := smoothOfRelativeDimension_comp 0 n W.hom pY
    rwa [Nat.zero_add] at this
  have hZWsm : ∀ W : Y.Etale,
      SmoothOfRelativeDimension (n - r) (Limits.pullback.fst W.hom i ≫ W.hom ≫ pY) := by
    intro W
    haveI : Etale W.hom := W.prop
    rw [← Category.assoc, Limits.pullback.condition, Category.assoc, hnr]
    have := smoothOfRelativeDimension_comp 0 m (Limits.pullback.snd W.hom i) (i ≫ pY)
    rwa [Nat.zero_add] at this
  have hThomW : ∀ W : Y.Etale, ∃ (EW : wcEtPullData W.hom ℓ)
      (γW : wcEtSuppObj (DW W) ⟶ EW.Φ.obj (wcEtSuppObj D)),
      wcEtIsThom T (W.hom ≫ pY) (DW W) r (wcEtSuppRestr D EW (DW W) γW (2 * r) θ) ∧
      cl W ((cb.val.app (Opposite.op ((wcEtBaseChange i).obj W))).hom
