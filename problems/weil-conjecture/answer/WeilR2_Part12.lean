    ⟨_, ⟨Adjunction.ofIsLeftAdjoint _⟩⟩
  haveI : Rs.Additive := Adjunction.right_adjoint_additive adj
  let I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf Y ℓ)) := InjectiveResolution.of _

  have hvan : ∀ q : ℕ, q ≠ 2 * r →
      Limits.IsZero (((Rs.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) := by
    intro q hq
    rcases Nat.lt_or_gt_of_ne hq with h | h
    · exact wc_smooth_pair_proet_shriek_low_vanish K pY n m r hmr i ℓ hℓ Di hDi Rs adj I q h
    · exact wc_smooth_pair_proet_shriek_high_vanish K pY n m r hmr i ℓ hℓ Di hDi Rs adj I q h

  obtain ⟨ψ, hψ⟩ := wc_smooth_pair_proet_shriek_top_trivial K pY n m r hmr i ℓ hℓ Di hDi Rs adj I
  haveI := hψ

  obtain ⟨τ, hτ⟩ := ext_shifted_degenerate_leray_injective
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) Rs adj
    (SheafOfModules.unit (wcRingSheaf Y ℓ)) I (SheafOfModules.unit (wcRingSheaf Z ℓ)) (2 * r)
    ψ hvan
  refine ⟨τ, wcSuppClass Dz (2 * m) θz, fun h0 => hθz ?_⟩
  exact hτ (2 * m) N hkN (wcSuppClass Dz (2 * m) θz) h0

theorem wc_smooth_pair_gysin_top_surj (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (hex : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ))
    (k k' N : ℕ) (hk : k = 2 * r) (hk' : k' = 2 * m) (hkN : k' + k = N) (hN : N = 2 * n) :
    ∃ τ : wcSuppExt Di k, ∀ θ : wcSuppExt Di N, ∃ b : wcHM Z ℓ k',
      wcSuppGysin Di hex k' k N hkN b τ = θ :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  haveI := Di.additive
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
    Adjunction.right_adjoint_additive Di.adj
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) := by
    haveI := Di.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI := hex
  obtain ⟨τ, b₀, hne⟩ :=
    wc_smooth_pair_gysin_top_nonzero K pY n m r hmr i ℓ hℓ Di hDi hex k k' N hk hk' hkN hN
  refine ⟨τ, fun θ => ?_⟩
  obtain ⟨c, hc⟩ := wc_smooth_pair_supp_top_line K pY n m r hmr i ℓ hℓ Di hDi N hN _ θ hne
  refine ⟨b₀.comp (Abelian.Ext.mk₀ (wcHMConst Z ℓ c)) (add_zero k'), ?_⟩
  rw [hc]
  have hcen := wc_supp_ext_scalar_central i ℓ Di hDi k τ c
  show (Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ)
      (b₀.comp (Abelian.Ext.mk₀ (wcHMConst Z ℓ c)) (add_zero k'))).comp τ hkN =
    ((Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) b₀).comp
        τ hkN).comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) (add_zero N)
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
  have a := Abelian.Ext.comp_assoc_of_second_deg_zero
    (Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) b₀)
    (Abelian.Ext.mk₀
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
        (wcHMConst Z ℓ c))) τ hkN
  have b := congrArg (fun t => Abelian.Ext.comp
    (Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) b₀) t hkN) hcen
  have d := (Abelian.Ext.comp_assoc_of_third_deg_zero
    (Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) b₀)
    τ (Abelian.Ext.mk₀ (wcHMConst Y ℓ c)) hkN).symm
  exact a.trans (b.trans d)

theorem wc_smooth_pair_gysin_point_nonzero (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (hex : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ))
    (k k' N : ℕ) (hk : k = 2 * r) (hk' : k' = 2 * m) (hkN : k' + k = N) (hN : N = 2 * n) :
    ∃ (τ : wcSuppExt Di k) (b₀ : wcHM Z ℓ k'),
      wcSuppClass Di N (wcSuppGysin Di hex k' k N hkN b₀ τ) ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  haveI : IsProper (i ≫ pY) := inferInstance
  haveI : LocallyOfFiniteType (i ≫ pY) := inferInstance
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY

  obtain ⟨z₀, hz₀⟩ := wc_alg_closed_lft_section K Z (i ≫ pY) (IrreducibleSpace.toNonempty)
  have hy₀ : (z₀ ≫ i) ≫ pY = 𝟙 _ := by rw [Category.assoc]; exact hz₀

  obtain ⟨Dy, hDy⟩ := wc_hm_pull_data_exists (z₀ ≫ i) ℓ

  obtain ⟨θy, hθy⟩ := wc_alg_closed_point_supp_class_nonzero K pY n ℓ hℓ (z₀ ≫ i) hy₀ Dy hDy

  obtain ⟨q, hq⟩ := wc_closed_supp_point_restriction K i z₀ ℓ Di hDi Dy hDy

  obtain ⟨τ, hτ⟩ := wc_smooth_pair_gysin_top_surj K pY n m r hmr i ℓ hℓ Di hDi hex
    k k' N hk hk' hkN hN
  subst hN

  obtain ⟨b₀, hb₀⟩ := hτ ((Abelian.Ext.mk₀ q).comp θy (zero_add _))
  refine ⟨τ, b₀, ?_⟩
  rw [hb₀]
  intro h0
  apply hθy
  have e := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mk₀ (wcSuppUnitMap Di))
    (Abelian.Ext.mk₀ q) θy (zero_add (2 * n))
  rw [Abelian.Ext.mk₀_comp_mk₀, hq] at e
  exact e.trans h0

theorem wc_smooth_pair_gysin_detect (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (k k' N : ℕ) (hk : k = 2 * r) (hk' : k' = 2 * m) (hkN : k' + k = N) (hN : N = 2 * n) :
    ∃ τ : wcSuppExt Di k, ∀ z : wcHM Y ℓ k',
      wcHMPull Di k' z ≠ 0 → wcHMCup Y ℓ k' k N hkN z (wcSuppClass Di k τ) ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : IsProper (i ≫ pY) := inferInstance
  haveI := Di.additive
  haveI := Di.presLim
  haveI := Di.presColim
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).Additive :=
    Adjunction.right_adjoint_additive Di.adj
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ) := by
    haveI := Di.adj.rightAdjoint_preservesLimits
    infer_instance
  have hex := wc_closed_pushforward_exact_of_noetherian i ℓ Di
  haveI := hex
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := by
    have encl : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
        [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
        (R : Sheaf J RingCat.{u+1}), EnoughInjectives (SheafOfModules.{u+1} R) := by
      intro C _ J _ _ R
      have s2 : HasSeparator (PresheafOfModules.{u+1} R.obj) := by
        let G : C → PresheafOfModules.{u+1} R.obj := fun X =>
          (PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj X)
        have key : ∀ (X : C) (M N : PresheafOfModules.{u+1} R.obj) (φ : M ⟶ N) (h : G X ⟶ M),
            uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N (h ≫ φ)) =
              φ.app (Opposite.op X) (uliftYonedaEquiv.{u+1}
                ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M h)) := by
          intro X M N φ h
          rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
          rfl
        have hsep : (ObjectProperty.ofObj G).IsSeparating := by
          intro M N f g hfg
          apply PresheafOfModules.hom_ext
          intro Y
          obtain ⟨X⟩ := Y
          ext m
          let e := ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv
            (uliftYoneda.{u+1}.obj X) M).trans uliftYonedaEquiv.{u+1}
          have h1 := hfg _ (ObjectProperty.ofObj_apply G X) (e.symm m)
          have h2 := congrArg (fun k => uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N k)) h1
          rw [key, key] at h2
          have h3 : uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M (e.symm m)) = m :=
            e.apply_symm_apply m
          rw [h3] at h2
          exact h2
        exact HasSeparator.mk ⟨_, hsep.isSeparator_coproduct⟩
      have h5 : AB5OfSize.{u+1, u+1} (SheafOfModules.{u+1} R) :=
        ⟨fun K _ _ =>
          haveI := HasExactColimitsOfShape.domain_of_functor K
            (PresheafOfModules.toPresheaf.{u+1} R.obj)
          (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)).hasExactColimitsOfShape K⟩
      have hs : HasSeparator (SheafOfModules.{u+1} R) :=
        HasSeparator.of_adjunction (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj))
      exact @IsGrothendieckAbelian.enoughInjectives _ _ _
        (IsGrothendieckAbelian.mk.{u+1} (C := SheafOfModules.{u+1} R) inferInstance inferInstance
          h5 hs)
    exact encl (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)

  have hassoc : ∀ (S : Scheme.{u}) (a₁ a₂ a₃ a₁₂ a₂₃ a : ℕ) (h₁₂ : a₁ + a₂ = a₁₂)
      (h₂₃ : a₂ + a₃ = a₂₃) (h1 : a₁₂ + a₃ = a) (h2 : a₁ + a₂₃ = a)
      (x : wcHM S ℓ a₁) (y : wcHM S ℓ a₂) (z : wcHM S ℓ a₃),
      wcHMCup S ℓ a₁₂ a₃ a h1 (wcHMCup S ℓ a₁ a₂ a₁₂ h₁₂ x y) z =
        wcHMCup S ℓ a₁ a₂₃ a h2 x (wcHMCup S ℓ a₂ a₃ a₂₃ h₂₃ y z) := by
    intro S a₁ a₂ a₃ a₁₂ a₂₃ a h₁₂ h₂₃ h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_assoc x y z h₁₂ h₂₃ (by omega)
  have hscR : ∀ (S : Scheme.{u}) (p q s : ℕ) (h : p + q = s) (x : wcHM S ℓ p) (w : wcHM S ℓ q)
      (t : ℚ_[ℓ]), wcHMCup S ℓ p q s h x (wcHMScalar S ℓ q t w) =
        wcHMScalar S ℓ s t (wcHMCup S ℓ p q s h x w) := by
    intro S p q s h x w t
    exact (hassoc S p q 0 s q s h (add_zero q) (add_zero s) h x w
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t))).symm
  have hscL : ∀ (S : Scheme.{u}) (p q s : ℕ) (h : p + q = s) (x : wcHM S ℓ p) (w : wcHM S ℓ q)
      (t : ℚ_[ℓ]), wcHMCup S ℓ p q s h (wcHMScalar S ℓ p t x) w =
        wcHMScalar S ℓ s t (wcHMCup S ℓ p q s h x w) := by
    intro S p q s h x w t
    have e1 := hassoc S p 0 q p q s (add_zero p) (zero_add q) h h x
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t)) w
    have e2 : wcHMCup S ℓ 0 q q (zero_add q)
        (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t)) w =
        wcHMScalar S ℓ q t w := wc_hm_unit_end_central S ℓ (wcHMConst S ℓ t) q w
    rw [e2, hscR] at e1
    exact e1
  have F1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (n : ℕ) (t : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n t x) = wcHMScalar S' ℓ n t (wcHMPull D n x) := by
    intro S S' f D hD n t x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hk : D.Φ.map (wcHMConst S ℓ t) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ t := by
      rw [← wc_hm_pull_const D hD t, Iso.hom_inv_id_assoc]
    have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)} (z : Abelian.Ext A B n)
        (a : B ⟶ C') (b : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero n)).comp (Abelian.Ext.mk₀ b) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero n) := by
      intro A B C' D' z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have e3 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero n))
      (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (zero_add n)
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (add_zero n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e3, e2, hk]

  have s1 : ∀ (Φ' : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
      (G' : SheafOfModules.{u+1} (wcRingSheaf Z ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
      [Φ'.Additive] [Limits.PreservesFiniteLimits Φ'] [Limits.PreservesFiniteColimits Φ']
      [G'.Additive] [Limits.PreservesFiniteLimits G'] [Limits.PreservesFiniteColimits G']
      (α : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) ⟶ Φ' ⋙ G')
      (A : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (p : ℕ)
      (B : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (x : Abelian.Ext A B p),
      x.comp (Abelian.Ext.mk₀ (α.app B)) (add_zero p) =
        (Abelian.Ext.mk₀ (α.app A)).comp
          (Abelian.Ext.mapExactFunctor G' (Abelian.Ext.mapExactFunctor Φ' x)) (zero_add p) := by
    intro Φ' G' _ _ _ _ _ _ α A p
    induction p with
    | zero =>
      intro B x
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective A B).2 x
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      exact congrArg Abelian.Ext.mk₀ (α.naturality f)
    | succ p IH =>
      have step : ∀ (S : ShortComplex (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)))
          (hS : S.ShortExact) (hI : Injective S.X₂) (x : Abelian.Ext A S.X₁ (p + 1)),
          x.comp (Abelian.Ext.mk₀ (α.app S.X₁)) (add_zero (p + 1)) =
            (Abelian.Ext.mk₀ (α.app A)).comp
              (Abelian.Ext.mapExactFunctor G' (Abelian.Ext.mapExactFunctor Φ' x))
              (zero_add (p + 1)) := by
        intro S hS hI x
        haveI := hI
        obtain ⟨x', hx'⟩ := Abelian.Ext.covariant_sequence_exact₁ A hS x
          (Abelian.Ext.eq_zero_of_injective _) (rfl : p + 1 = p + 1)
        have hGΦ := (hS.map_of_exact Φ').map_of_exact G'
        have nat : hS.extClass.comp (Abelian.Ext.mk₀ (α.app S.X₁)) (add_zero 1) =
            (Abelian.Ext.mk₀ (α.app S.X₃)).comp hGΦ.extClass (zero_add 1) :=
          hS.extClass_naturality hGΦ (ShortComplex.homMk (α.app S.X₁) (α.app S.X₂) (α.app S.X₃)
            (α.naturality S.f).symm (α.naturality S.g).symm)
        subst hx'
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.comp_assoc_of_third_deg_zero, nat,
          ← Abelian.Ext.comp_assoc_of_second_deg_zero, IH]
        exact Abelian.Ext.comp_assoc _ _ _ (zero_add p) rfl (by omega)
      intro B
      exact step (ShortComplex.mk (Injective.ι B) (Limits.cokernel.π (Injective.ι B))
          (Limits.cokernel.condition _))
        (ShortComplex.ShortExact.mk'
          (ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel (Injective.ι B)))
          (Injective.ι_mono B) inferInstance)
        (show Injective (Injective.under B) from inferInstance)

  have eρ : (Di.adj.unit.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) ≫
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map
        Di.μ.hom) ≫
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ).map Di.μ.inv =
      Di.adj.unit.app (SheafOfModules.unit (wcRingSheaf Y ℓ)) := by
    rw [Category.assoc, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
    exact Category.comp_id _
  have PF : ∀ (τ : wcSuppExt Di k) (x : wcHM Y ℓ k'),
      wcHMCup Y ℓ k' k N hkN x (wcSuppClass Di k τ) =
        wcSuppClass Di N (wcSuppGysin Di hex k' k N hkN (wcHMPull Di k' x) τ) := by
    intro τ x
