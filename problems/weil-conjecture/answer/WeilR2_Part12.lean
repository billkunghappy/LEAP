theorem wc_int_free_qcqs_unit_restrict_rational (S : Scheme.{u}) (U : S.ProEt)
    [CompactSpace U.left] [QuasiSeparatedSpace U.left] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf S ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
