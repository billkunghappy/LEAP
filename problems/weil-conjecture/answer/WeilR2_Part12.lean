        (ℓ ^ b : ℕ) • w = w₀.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)))
          (add_zero n)) ∧
    (∀ z : Abelian.Ext (L.obj (wcFreeSheaf S U)) (wcIntUnit S ℓ) n,
      z.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n) = 0 →
        ∃ e : ℕ, (ℓ ^ e : ℕ) • z = 0) :=
by
  letI hΛ : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
  haveI hGC := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ)
  obtain ⟨ιZ, ιQ, hι⟩ := wc_proet_int_unit_isos S ℓ
  obtain ⟨ιQ', hι'⟩ : ∃ ιQ' : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj
        ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).obj
          (SheafOfModules.unit (wcRingSheaf S ℓ))) ≅ wcLadicSheaf S ℓ,
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).map
          (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)) ≫ ιQ'.hom =
        ιZ.hom ≫ wcIntToLadic S ℓ := ⟨ιQ, hι⟩
  have hb : ∀ Y : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ),
      Function.Bijective (fun f : L.obj (wcFreeSheaf S U) ⟶ Y =>
        adj.unit.app (wcFreeSheaf S U) ≫ (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map f) := by
    intro Y
    have e : (fun f : L.obj (wcFreeSheaf S U) ⟶ Y =>
        adj.unit.app (wcFreeSheaf S U) ≫ (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map f) =
        ⇑(adj.homEquiv (wcFreeSheaf S U) Y) :=
      funext fun f => (adj.homEquiv_unit (wcFreeSheaf S U) Y f).symm
    rw [e]
    exact (adj.homEquiv (wcFreeSheaf S U) Y).bijective

  obtain ⟨TZ, hTZ⟩ : ∃ T : Abelian.Ext (L.obj (wcFreeSheaf S U)) (wcIntUnit S ℓ) n →+
      Abelian.Ext (wcFreeSheaf S U)
        ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ)) n,
      ∀ a, T a = (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf S U))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) a)
        (zero_add n) :=
    ⟨AddMonoidHom.mk' (fun a => (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf S U))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) a)
        (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ => rfl⟩
  obtain ⟨TQ, hTQ⟩ : ∃ T : Abelian.Ext (L.obj (wcFreeSheaf S U))
        ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).obj
