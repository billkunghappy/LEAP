  have hTQb : Function.Bijective TQ := by
    have e : (⇑TQ) = fun a => (Abelian.Ext.mk₀ (adj.unit.app (wcFreeSheaf S U))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) a)
