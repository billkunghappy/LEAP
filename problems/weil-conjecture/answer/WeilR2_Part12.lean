    have hY := (wc_contSheaf_pi_isLimit E (fun k => ZMod (ℓ ^ k))).some
    have hprod := fun N => wc_ext_prod_bijective (wcFreeSheaf E (Scheme.ProEt.mk (𝟙 E)))
