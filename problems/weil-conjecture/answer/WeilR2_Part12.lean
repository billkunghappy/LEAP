theorem wc_et_smooth_pair_supp_top_pair_relation_cpt : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (W ZW : Scheme.{u}) (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW] [CompactSpace ↥W] [IsSeparated fW] (iW : ZW ⟶ W) [IsClosedImmersion iW] [SmoothOfRelativeDimension (n - c) (iW ≫ fW)], c ≤ n → ∀ (D : wcEtPullData iW ℓ) (N : ℕ), N = 2 * c → ∀ (β₁ β₂ : wcEtSuppExt D N) (z : ZW), ∃ (a b : ℤ), ¬ ((ℓ : ℤ) ∣ a ∧ (ℓ : ℤ) ∣ b) ∧ ∃ (W' : Scheme.{u}) (f : W' ⟶ W), Etale f ∧ iW z ∈ Set.range f ∧ ∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW), IsPullback g iW' iW f → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ef D' γ N (a • β₁ + b • β₂) = 0 :=
