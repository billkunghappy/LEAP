  obtain ⟨a, b, c⟩ := hring
  obtain ⟨q, wq, ⟨hq⟩, hQ⟩ := sheafOfModules_restrictScalars_unit_cokernel
    (Scheme.ProEt.topology S) _ _ (wcIntZModRingSheafMap S ℓ m) (ℓ ^ m) a b c
  have hU := sheafOfModules_unitRestrict_hom_bijective (wcIntRingSheaf S ℓ)
    (wcZModRingSheaf S (ℓ ^ m)) (wcIntZModRingSheafMap S ℓ m)
