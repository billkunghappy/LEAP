      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro r
      exact @Subsingleton.elim _ (hsub V) _ _
    rw [← Abelian.Ext.mk₀_id_comp x, hid, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
  · have hq' : 2 * m < q := by omega

    have hmK : ∀ k : ℕ, ((ℓ ^ k : ℕ) : K) ≠ 0 := by
      intro k
      rw [Nat.cast_pow]
      exact pow_ne_zero k hℓ
    have hcpt : CompactSpace ↥E := QuasiCompact.compactSpace_of_compactSpace f
    have hqs : QuasiSeparatedSpace ↥E := quasiSeparatedSpace_of_quasiSeparated f
    have hT0 : ∀ (A : Type) [AddCommGroup A] [TopologicalSpace A] [DiscreteTopology A]
        [IsTopologicalAddGroup A], (∀ a : A, ∃ k : ℕ, ℓ ^ k • a = 0) →
        ∀ i : ℕ, 2 * m < i → ∀ z : Abelian.Ext (wcFreeSheaf E (Scheme.ProEt.mk (𝟙 E)))
          (wcContSheaf E A) i, z = 0 := by
      intro A _ _ _ _ hA i hi z
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}) := HasExt.standard _
      have het : ∀ ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology E)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            ((constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} A))) i, ξ = 0 := by
        intro ξ
        obtain ⟨k, B, φ, y, htor, hy⟩ := wc_et_ext_torsion_colim_lift E hcpt hqs ℓ A hA i ξ
        have hy0 : y = 0 :=
