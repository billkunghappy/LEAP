    exact (congrArg (wcEtPull Dρ k) (kill _ _ _ hsq' Dw')).trans (map_zero _)
  haveI : Subsingleton (wcEtZModExt Pq ℓ k) := ⟨fun a b => (g4 a).trans (g4 b).symm⟩
  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Pq ℓ k
