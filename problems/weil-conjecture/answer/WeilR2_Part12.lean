theorem wc_addgroup_card_le_of_five_ladder {T E A1 A2 A4 A5 B1 B2 B4 B5 : Type*}
    [AddCommGroup T] [AddCommGroup E] [AddCommGroup A1] [AddCommGroup A2]
    [AddCommGroup A4] [AddCommGroup A5] [AddCommGroup B1] [AddCommGroup B2]
    [AddCommGroup B4] [AddCommGroup B5]
    (resA : A1 →+ A2) (δA : A2 →+ T) (πA : T →+ A4) (ρA : A4 →+ A5)
    (resB : B1 →+ B2) (δB : B2 →+ E) (πB : E →+ B4) (ρB : B4 →+ B5)
    (f1 : B1 →+ A1) (f2 : B2 →+ A2) (f4 : B4 →+ A4) (f5 : B5 →+ A5)
    (hA1 : ∀ a, δA a = 0 ↔ ∃ x, resA x = a) (hA2 : ∀ t, πA t = 0 ↔ ∃ a, δA a = t)
    (hA3 : ∀ y, ρA y = 0 ↔ ∃ t, πA t = y)
    (hB1 : ∀ b, δB b = 0 ↔ ∃ x, resB x = b) (hB2 : ∀ e, πB e = 0 ↔ ∃ b, δB b = e)
    (hB3 : ∀ y, ρB y = 0 ↔ ∃ e, πB e = y)
    (h12 : ∀ x, f2 (resB x) = resA (f1 x)) (h45 : ∀ y, ρA (f4 y) = f5 (ρB y))
    (hf2 : Function.Surjective f2) (hf4 : Function.Surjective f4)
    (hf5 : Function.Injective f5) [Finite E] :
    Finite T ∧ Nat.card T ≤ Nat.card E :=
by
  classical

  have W : ∀ b b' : B2, δB b = δB b' → δA (f2 b) = δA (f2 b') := by
    intro b b' hbb
    have h0 : δB (b - b') = 0 := by rw [map_sub, hbb, sub_self]
    obtain ⟨x, hx⟩ := (hB1 _).mp h0
    have h1 : δA (f2 (b - b')) = 0 := by
      rw [← hx, h12]
      exact (hA1 _).mpr ⟨f1 x, rfl⟩
    rw [map_sub, map_sub, sub_eq_zero] at h1
    exact h1
  have hβ : ∀ e : πB.ker, ∃ b, δB b = (e : E) :=
    fun e => (hB2 e.1).mp (AddMonoidHom.mem_ker.mp e.2)
  choose β hβ' using hβ
  let g : πB.ker → πA.ker := fun e =>
    ⟨δA (f2 (β e)), AddMonoidHom.mem_ker.mpr ((hA2 _).mpr ⟨f2 (β e), rfl⟩)⟩
  have hg : Function.Surjective g := by
    rintro ⟨t, ht⟩
    obtain ⟨a, rfl⟩ := (hA2 t).mp (AddMonoidHom.mem_ker.mp ht)
    obtain ⟨b, rfl⟩ := hf2 a
    refine ⟨⟨δB b, AddMonoidHom.mem_ker.mpr ((hB2 _).mpr ⟨b, rfl⟩)⟩, ?_⟩
    apply Subtype.ext
    exact W _ _ (hβ' _)
  haveI : Finite πB.ker := inferInstance
  haveI hKA : Finite πA.ker := Finite.of_surjective g hg
  have hKle : Nat.card πA.ker ≤ Nat.card πB.ker := by first | exact Nat.card_le_card_of_surjective g hg | exact Nat.card_le_card_of_injective (Function.surjInv hg) (Function.injective_surjInv hg)

  let h : πB.range → πA.range := fun y => ⟨f4 y.1, by
      obtain ⟨e, he⟩ := AddMonoidHom.mem_range.mp y.2
      have h1 : ρB y.1 = 0 := (hB3 _).mpr ⟨e, he⟩
      have h2 : ρA (f4 y.1) = 0 := by rw [h45, h1, map_zero]
      exact AddMonoidHom.mem_range.mpr ((hA3 _).mp h2)⟩
  have hh : Function.Surjective h := by
    rintro ⟨z, hz⟩
    obtain ⟨t, rfl⟩ := AddMonoidHom.mem_range.mp hz
    obtain ⟨y, hy⟩ := hf4 (πA t)
    have h1 : ρA (πA t) = 0 := (hA3 _).mpr ⟨t, rfl⟩
    have h2 : ρB y = 0 := by
      apply hf5
      rw [← h45, hy, h1, map_zero]
    refine ⟨⟨y, AddMonoidHom.mem_range.mpr ((hB3 y).mp h2)⟩, ?_⟩
    exact Subtype.ext hy
  have hsurjB : Function.Surjective
      (fun e : E => (⟨πB e, AddMonoidHom.mem_range.mpr ⟨e, rfl⟩⟩ : πB.range)) := by
    rintro ⟨y, hy⟩
    obtain ⟨e, rfl⟩ := AddMonoidHom.mem_range.mp hy
    exact ⟨e, rfl⟩
  haveI : Finite πB.range := Finite.of_surjective _ hsurjB
  haveI hRA : Finite πA.range := Finite.of_surjective h hh
  have hRle : Nat.card πA.range ≤ Nat.card πB.range := by first | exact Nat.card_le_card_of_surjective h hh | exact Nat.card_le_card_of_injective (Function.surjInv hh) (Function.injective_surjInv hh)

  haveI : Finite (T ⧸ πA.ker) :=
    Finite.of_equiv _ (QuotientAddGroup.quotientKerEquivRange πA).symm.toEquiv
  have hT : Finite T := Finite.of_addSubgroup_quotient πA.ker
  refine ⟨hT, ?_⟩
  have cT : Nat.card T = Nat.card (T ⧸ πA.ker) * Nat.card πA.ker :=
    AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup πA.ker
  have cE : Nat.card E = Nat.card (E ⧸ πB.ker) * Nat.card πB.ker :=
    AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup πB.ker
  have qT : Nat.card (T ⧸ πA.ker) = Nat.card πA.range :=
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange πA).toEquiv
  have qE : Nat.card (E ⧸ πB.ker) = Nat.card πB.range :=
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange πB).toEquiv
  rw [cT, cE, qT, qE]
  exact Nat.mul_le_mul hRle hKle

theorem wc_et_supp_open_les {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (O : Y.Opens) (hO : (O : Set Y) = (Set.range i)ᶜ) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcEtPullData i ℓ) (Dj : wcEtPullData O.ι ℓ) :
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
    (∀ (k : ℕ) (y : wcEtZModExt Y ℓ k), wcEtPull Dj k y = 0 ↔
        ∃ x : wcEtSuppExt D k, (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp x (zero_add k) = y) ∧
    (∀ x : wcEtSuppExt D 0,
        (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp x (zero_add 0) = 0 → x = 0) ∧
    (∀ s k : ℕ, 1 + s = k → ∃ δ : wcEtZModExt O.toScheme ℓ s →+ wcEtSuppExt D k,
      (∀ x : wcEtSuppExt D k, (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp x (zero_add k) = 0 ↔
        ∃ b, δ b = x) ∧
      (∀ b, δ b = 0 ↔ ∃ v : wcEtZModExt Y ℓ s, wcEtPull Dj s v = b)) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing O.toScheme ℓ)) := HasExt.standard _
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim
  haveI hepi : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
  have hrange : Set.range O.ι = (Set.range i)ᶜ := by
    rw [Scheme.Opens.range_ι, hO]
  obtain ⟨c, hc1, hbij⟩ := wc_et_open_compl_ker_transfer i O.ι hrange ℓ D Dj

  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D))
      (show Mono (Limits.kernel.ι (wcEtSuppUnitMap D)) from inferInstance)
      (show Epi (wcEtSuppUnitMap D) from hepi)

  let Ψ : ∀ k : ℕ, Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) k →+ wcEtZModExt O.toScheme ℓ k := fun k =>
    ((Abelian.Ext.mk₀ c).precomp (SheafOfModules.unit (wcEtZModRing O.toScheme ℓ))
      (zero_add k)).comp
      (((Abelian.Ext.mk₀ Dj.μ.hom).postcomp (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D)))
        (add_zero k)).comp
        (Dj.Φ.mapExtAddHom (Limits.kernel (wcEtSuppUnitMap D))
          (SheafOfModules.unit (wcEtZModRing Y ℓ)) k))
  have hΨapp : ∀ (k : ℕ) (x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) k),
      Ψ k x = (Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp
        (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k) := fun k x => rfl
  have hΨ : ∀ k : ℕ, Function.Bijective (Ψ k) := by
    intro k
    have hb := hbij k
    have hfun : (Ψ k : _ → _) = (fun x : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
        (SheafOfModules.unit (wcEtZModRing Y ℓ)) k => (Abelian.Ext.mk₀ c).comp
          ((Abelian.Ext.mapExactFunctor Dj.Φ x).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
          (zero_add k)) := funext (hΨapp k)
    rw [hfun]
    exact hb
  let Ψe : ∀ k : ℕ, Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) k ≃+ wcEtZModExt O.toScheme ℓ k :=
    fun k => AddEquiv.ofBijective (Ψ k) (hΨ k)
  have hΨe : ∀ k x, Ψe k x = Ψ k x := fun k x => rfl

  have KI : ∀ (k : ℕ) (w : wcEtZModExt Y ℓ k),
      Ψ k ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add k)) =
        wcEtPull Dj k w := by
    intro k w
    have hpull : wcEtPull Dj k w = (Abelian.Ext.mk₀ Dj.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor Dj.Φ w).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
        (zero_add k) := rfl
    rw [hpull, hΨapp, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc, hc1]
  have KIinj : ∀ (k : ℕ) (w : wcEtZModExt Y ℓ k), wcEtPull Dj k w = 0 ↔
      (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add k) = 0 := by
    intro k w
    rw [← KI]
    constructor
    · intro h
      exact (hΨ k).1 (h.trans (map_zero (Ψ k)).symm)
    · intro h
      rw [h, map_zero]
  refine ⟨fun k y => ?_, fun x hx => ?_, fun s k h => ?_⟩
  ·
    rw [KIinj]
    constructor
    · intro hy
      exact Abelian.Ext.contravariant_sequence_exact₂ hS _ y hy
    · rintro ⟨x, rfl⟩
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Limits.kernel.condition, Abelian.Ext.mk₀_zero,
        Abelian.Ext.zero_comp]
  ·
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    have h1 : Abelian.Ext.mk₀ (wcEtSuppUnitMap D ≫ g) =
        Abelian.Ext.mk₀ (wcEtSuppUnitMap D ≫ 0) := by
      rw [Limits.comp_zero, Abelian.Ext.mk₀_zero, ← Abelian.Ext.mk₀_comp_mk₀]
      exact hx
    have h2 := (Abelian.Ext.mk₀_bijective _ _).1 h1
    rw [cancel_epi] at h2
    rw [h2, Abelian.Ext.mk₀_zero]
  ·
    let δ : wcEtZModExt O.toScheme ℓ s →+ wcEtSuppExt D k :=
      (hS.extClass.precomp (SheafOfModules.unit (wcEtZModRing Y ℓ)) h).comp
        (Ψe s).symm.toAddMonoidHom
    have hδ : ∀ b, δ b = hS.extClass.comp ((Ψe s).symm b) h := fun b => rfl
    refine ⟨δ, fun x => ?_, fun b => ?_⟩
    · constructor
      · intro hx
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS _ x hx h
        refine ⟨Ψe s x₁, ?_⟩
        rw [hδ, AddEquiv.symm_apply_apply]
        exact hx₁
      · rintro ⟨b, rfl⟩
        rw [hδ, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) h (by omega)]
        have hc : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp hS.extClass (zero_add 1) = 0 :=
          hS.comp_extClass
        rw [hc, Abelian.Ext.zero_comp]
    · rw [hδ]
      constructor
      · intro hb
        obtain ⟨v, hv⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS _ ((Ψe s).symm b) h hb
        refine ⟨v, ?_⟩
        have hv' : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp v (zero_add s) =
            (Ψe s).symm b := hv
        rw [← KI, hv', ← hΨe]
        exact (Ψe s).apply_symm_apply b
      · rintro ⟨v, rfl⟩
        have e : (Ψe s).symm (wcEtPull Dj s v) =
            (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp v (zero_add s) := by
          rw [← KI, ← hΨe]
          exact (Ψe s).symm_apply_apply _
        rw [e]
        have hc : hS.extClass.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D)))
            (add_zero 1) = 0 := hS.extClass_comp
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hc, Abelian.Ext.zero_comp]

theorem wc_proet_open_restr_et_model (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y]
    (O : Y.Opens) [CompactSpace O.toScheme] [QuasiSeparatedSpace O.toScheme]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ) (Dj : wcEtPullData O.ι ℓ) :
    ∃ (FY : wcEtZModExt Y ℓ q ≃+
          Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y ℓ) q)
      (FO : wcEtZModExt O.toScheme ℓ q ≃+
          Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk O.ι)) (wcZModSheaf Y ℓ) q),
      ∀ v : wcEtZModExt Y ℓ q,
        (Abelian.Ext.mk₀ (wcFreeSheafMap Y
            (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
              Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))).comp (FY v) (zero_add q) =
          FO (wcEtPull Dj q v) :=
by
  classical

  have c3 : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] [Preadditive C]
      [Preadditive D] (F : C ⥤ D) [F.Additive]
      [Limits.PreservesColimitsOfShape Limits.WalkingParallelPair F] {P Q : C}
      (a : P ⟶ Q) (w : (ℓ • 𝟙 P) ≫ a = 0) (ha : Limits.IsColimit (Limits.CokernelCofork.ofπ a w))
      {Q' : D} (k : F.obj Q ≅ Q'),
      ∃ w' : (ℓ • 𝟙 (F.obj P)) ≫ (F.map a ≫ k.hom) = 0,
        Nonempty (Limits.IsColimit (Limits.CokernelCofork.ofπ (F.map a ≫ k.hom) w')) := by
    intro C D _ _ _ _ F _ _ P Q a w ha Q' k
    have hF : F.map (ℓ • 𝟙 P) = ℓ • 𝟙 (F.obj P) := by rw [Functor.map_nsmul, F.map_id]
    have w' : (ℓ • 𝟙 (F.obj P)) ≫ (F.map a ≫ k.hom) = 0 := by
      rw [← hF, ← Category.assoc, ← F.map_comp, w, F.map_zero, Limits.zero_comp]
    refine ⟨w', ⟨?_⟩⟩
    let hc := Limits.CokernelCofork.mapIsColimit _ ha F
    have hd : ∀ {W : D} (g : F.obj P ⟶ W), (ℓ • 𝟙 (F.obj P)) ≫ g = 0 →
        F.map (ℓ • 𝟙 P) ≫ g = 0 := by
      intro W g hg; rw [hF]; exact hg
    refine Limits.CokernelCofork.IsColimit.ofπ _ _
      (fun {W} g hg => k.inv ≫ (Limits.CokernelCofork.IsColimit.desc' hc g (hd g hg)).1) ?_ ?_
    · intro W g hg
      have e := (Limits.CokernelCofork.IsColimit.desc' hc g (hd g hg)).2
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      exact e
    · intro W g hg m hm
      have e := (Limits.CokernelCofork.IsColimit.desc' hc g (hd g hg)).2
      have e2 : k.hom ≫ m = (Limits.CokernelCofork.IsColimit.desc' hc g (hd g hg)).1 := by
        apply Limits.Cofork.IsColimit.hom_ext hc
        refine Eq.trans ?_ e.symm
        rw [← hm, Category.assoc]
        rfl
      rw [← e2, Iso.inv_hom_id_assoc]
  have key : ∀ y : ZMod ℓ, ℓ • y = 0 := fun y => by
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have c4 : ∃ (π : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))
      (w : (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ π = 0),
      Nonempty (Limits.IsColimit (Limits.CokernelCofork.ofπ π w)) := by
    let π0 : ULift.{u+1} ℤ →+ ULift.{u+1} (ZMod ℓ) :=
      AddEquiv.ulift.symm.toAddMonoidHom.comp
        ((Int.castAddHom (ZMod ℓ)).comp AddEquiv.ulift.toAddMonoidHom)
    have hcomp : ∀ {W : AddCommGrpCat.{u+1}} (g : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W)
        (x : ULift.{u+1} ℤ), ((ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g) x = g (ℓ • x) := by
      intro W g x
      rfl
    have w : (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ AddCommGrpCat.ofHom π0 = 0 := by
      apply AddCommGrpCat.ext
      intro x
      rw [hcomp]
      show π0 (ℓ • x) = 0
      rw [map_nsmul]
      exact ULift.ext _ _ (key _)
    have hg0 : ∀ {W : AddCommGrpCat.{u+1}} (g : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W),
        (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g = 0 →
        (g.hom.comp (AddEquiv.ulift.symm.toAddMonoidHom : ℤ →+ ULift.{u+1} ℤ)) (ℓ : ℤ) = 0 := by
      intro W g hg
      have h1 : (ULift.up (ℓ : ℤ) : ULift.{u+1} ℤ) = ℓ • (ULift.up (1 : ℤ)) :=
        ULift.ext _ _ (by show (ℓ : ℤ) = ℓ • (1 : ℤ); rw [nsmul_eq_mul, mul_one])
      have h2 := congrArg (fun φ : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W => φ (ULift.up (1 : ℤ))) hg
      simp only at h2
      rw [hcomp] at h2
      show g (ULift.up (ℓ : ℤ)) = 0
      rw [h1, h2]
      rfl
    let desc : ∀ {W : AddCommGrpCat.{u+1}} (g : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W),
        (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g = 0 →
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)) ⟶ W) := fun {W} g hg =>
      AddCommGrpCat.ofHom ((ZMod.lift ℓ ⟨g.hom.comp AddEquiv.ulift.symm.toAddMonoidHom, hg0 g hg⟩).comp
        AddEquiv.ulift.toAddMonoidHom)
    have fac : ∀ {W : AddCommGrpCat.{u+1}} (g : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W)
        (hg : (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ g = 0),
        AddCommGrpCat.ofHom π0 ≫ desc g hg = g := by
      intro W g hg
      apply AddCommGrpCat.ext
      intro x
      show (ZMod.lift ℓ ⟨g.hom.comp AddEquiv.ulift.symm.toAddMonoidHom, hg0 g hg⟩)
        ((x.down : ℤ) : ZMod ℓ) = g x
      rw [ZMod.lift_coe]
      rfl
    refine ⟨AddCommGrpCat.ofHom π0, w, ⟨Limits.CokernelCofork.IsColimit.ofπ _ _
      (fun {W} g hg => desc g hg) (fun {W} g hg => fac g hg) ?_⟩⟩
    intro W g hg m hm
    apply AddCommGrpCat.ext
    intro y
    obtain ⟨k, hk⟩ := ZMod.intCast_surjective y.down
    have hy : y = π0 (ULift.up k) := ULift.ext _ _ hk.symm
    rw [hy]
    have e1 := congrArg (fun φ : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W => φ (ULift.up k)) hm
    have e2 := congrArg (fun φ : AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ W => φ (ULift.up k)) (fac g hg)
    exact e1.trans e2.symm
  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      (R : Sheaf J RingCat.{u+1}) (m : ℕ), (∀ V, ((m : ℕ) : ↑(R.obj.obj V)) = 0) →
      ∀ M : SheafOfModules.{u+1} R, m • 𝟙 ((SheafOfModules.toSheaf.{u+1} R).obj M) = 0 := by
    intro C _ J R m hm M
    have key : ∀ (X : Cᵒᵖ) (x : M.val.obj X), m • x = 0 := fun X x => by
      rw [← Nat.cast_smul_eq_nsmul (R.obj.obj X), hm X, zero_smul]
    apply (sheafToPresheaf J AddCommGrpCat.{u+1}).map_injective
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Functor.map_zero]
    ext X x
    simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
      AddMonoidHom.zero_apply]
    exact key X x

  letI instY : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  letI instO : HasExt (Sheaf (Scheme.smallEtaleTopology O.toScheme) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  letI instMY : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI instMO : HasExt (SheafOfModules.{u+1} (wcEtZModRing O.toScheme ℓ)) := HasExt.standard _
  obtain ⟨hjA, hjL, hjC⟩ := wc_etInv_exact O.ι
  obtain ⟨h1A, h1L, h1C⟩ := wc_etInv_exact (𝟙 Y)
  haveI := hjA
  haveI := hjL
  haveI := hjC
  haveI := h1A
  haveI := h1L
  haveI := h1C
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  haveI : Limits.PreservesFiniteColimits
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing O.toScheme ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  have hℓ : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hYc : CompactSpace Y := inferInstance
  have hYqs : QuasiSeparatedSpace Y := inferInstance
  have hOc : CompactSpace O.toScheme := inferInstance
  have hOqs : QuasiSeparatedSpace O.toScheme := inferInstance

  have hT : ∀ x : Abelian.Ext ((wcEtInv (𝟙 Y)).obj (wcEtUnitSheaf Y))
      ((wcEtInv (𝟙 Y)).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) q,
      wcEtInvExtPull O.ι (𝟙 Y) O.ι (Category.comp_id _) (wcEtUnitSheaf Y)
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q x =
      ((Abelian.Ext.mk₀ (wcEtInvCompInv O.ι (𝟙 Y) O.ι (Category.comp_id _) (wcEtUnitSheaf Y))).comp
        (Abelian.Ext.mapExactFunctor (wcEtInv O.ι) x) (zero_add q)).comp
        (Abelian.Ext.mk₀ (wcEtInvComp O.ι (𝟙 Y) O.ι (Category.comp_id _)
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))))) (add_zero q) := by
    intro x
    unfold wcEtInvExtPull
    split
    · rfl
    · rename_i hneg
      exact (hneg ⟨hjA, hjL, hjC⟩).elim
  have hid : ∀ z : Abelian.Ext (wcEtUnitSheaf Y)
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q,
      wcEtInvExtPull O.ι (𝟙 Y) O.ι (Category.comp_id _) (wcEtUnitSheaf Y)
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q
        (Abelian.Ext.mapExactFunctor (wcEtInv (𝟙 Y)) z) =
      Abelian.Ext.mapExactFunctor (wcEtInv O.ι) z := by
    intro z
    rw [hT]
    let σ : wcEtInv (𝟙 Y) ⋙ wcEtInv O.ι ⟶ wcEtInv O.ι :=
      { app := fun B => wcEtInvComp O.ι (𝟙 Y) O.ι (Category.comp_id _) B
