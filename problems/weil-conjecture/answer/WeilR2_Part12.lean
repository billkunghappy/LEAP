      ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).obj
        (SheafOfModules.unit (wcRingSheaf S ℓ))) n

  have K2 : ∀ z : Abelian.Ext (L.obj (wcFreeSheaf S U)) (wcIntUnit S ℓ) n,
      (TZ z).comp (Abelian.Ext.mk₀
        ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).map
          (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)))) (add_zero n) =
      TQ (z.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n)) := by
    intro z
    rw [hTZ, hTQ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have KS : ∀ z : Abelian.Ext (L.obj (wcFreeSheaf S U)) (wcIntUnit S ℓ) n,
      ((TZ z).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n)).comp
        (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero n) =
      (TQ (z.comp (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ))) (add_zero n))).comp
        (Abelian.Ext.mk₀ ιQ'.hom) (add_zero n) := by
    intro z
    rw [← K2, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hι']
  have hcancelZ : ∀ (a b : Abelian.Ext (wcFreeSheaf S U)
        ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ)) n),
      a.comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n) =
        b.comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero n) → a = b := by
    intro a b hab
    have := congrArg (fun w => w.comp (Abelian.Ext.mk₀ ιZ.inv) (add_zero n)) hab
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.comp_mk₀_id] at this
    exact this
  have hcancelQ : ∀ (a b : Abelian.Ext (wcFreeSheaf S U)
        ((SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj
          ((SheafOfModules.restrictScalars.{u+1} (wcIntRatRingSheafMap S ℓ)).obj
            (SheafOfModules.unit (wcRingSheaf S ℓ)))) n),
