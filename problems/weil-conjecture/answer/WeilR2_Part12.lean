        · intro YV' gV' w' hpb' Dw'
          have hu : w' ≫ gV = (gV' ≫ s'') ≫ 𝟙 W := by rw [hpb'.w, Category.assoc]
          obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst gV (𝟙 W)) ℓ
          obtain ⟨Dsnd⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd gV (𝟙 W)) ℓ
          obtain ⟨Du⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift w' (gV' ≫ s'') hu) ℓ
          obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gV' ℓ
          obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists s'' ℓ
          obtain ⟨Dgs⟩ := wc_et_zmod_pull_data_exists (gV' ≫ s'') ℓ
          rw [wc_et_pull_comp (Limits.pullback.fst gV (𝟙 W)) (Limits.pullback.lift w' (gV' ≫ s'') hu) w'
