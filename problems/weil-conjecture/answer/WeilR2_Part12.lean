    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2
  by_cases hx : v x ∈ Set.range i
  · obtain ⟨z0, hz0⟩ := hx
    obtain ⟨hlt, heq⟩ := wc_smooth_closed_reldim_cases K X fX n e Z i
    rcases lt_trichotomy e n with hen | hen | hen
    ·
      obtain ⟨c, hc⟩ : ∃ c, c = n - e := ⟨_, rfl⟩
      have hcn : c ≤ n := by omega
      have hnce : n - c = e := by omega
      have hN : k + 1 = 2 * c := by omega
      obtain ⟨ZW, gZ, iW, hZpb⟩ : ∃ (ZW : Scheme.{u}) (gZ : ZW ⟶ Z) (iW : ZW ⟶ W),
          IsPullback gZ iW i v := ⟨_, _, _, IsPullback.of_hasPullback i v⟩
      haveI : IsClosedImmersion iW :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hZpb inferInstance
      haveI : Etale gZ := MorphismProperty.of_isPullback (P := @Etale) hZpb.flip inferInstance
      haveI hsmW : SmoothOfRelativeDimension n (v ≫ fX) := by
        have h : SmoothOfRelativeDimension (0 + n) (v ≫ fX) := inferInstance
        rwa [Nat.zero_add] at h
      haveI hsmZ : SmoothOfRelativeDimension (n - c) (iW ≫ v ≫ fX) := by
        have h : SmoothOfRelativeDimension (0 + e) (gZ ≫ i ≫ fX) := inferInstance
        rw [Nat.zero_add, ← Category.assoc, hZpb.w, Category.assoc] at h
        rw [hnce]; exact h
      have hrange : Set.range gV = (Set.range iW)ᶜ := by
        ext y
        constructor
        · rintro ⟨t, rfl⟩ ⟨s, hs⟩
          have h1 : V.ι (w t) ∈ (V : Set X) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
          rw [hV] at h1
          apply h1
          refine ⟨gZ s, ?_⟩
          rw [hptw hZpb.w s, hs, ← hptw hpb.w t]
        · intro hy
          have hvy : v y ∈ (V : Set X) := by
            rw [hV]
            rintro ⟨z, hz⟩
            obtain ⟨s, -, hs⟩ := hpts hZpb z y hz
            exact hy ⟨s, hs⟩
          rw [← Scheme.Opens.range_ι] at hvy
          obtain ⟨a, ha⟩ := hvy
          obtain ⟨t, -, ht⟩ := hpts hpb a y ha
          exact ⟨t, ht⟩
      obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iW ℓ
      obtain ⟨δ, hδ⟩ := wc_et_punct_supp_boundary_hom iW gV hrange ℓ D k
      obtain ⟨z, -, hz2⟩ := hpts hZpb z0 x hz0
      obtain ⟨a, b, hab, W', f, hf, hzf, hkill⟩ :=
        wc_et_smooth_pair_supp_top_pair_relation_of_cpt K ℓ
          (wc_et_smooth_pair_supp_top_pair_relation_cpt K ℓ hℓK) W ZW (v ≫ fX) n c iW hcn D
          (k + 1) hN (δ α₁) (δ α₂) z
      have hδα : δ (a • α₁ + b • α₂) = a • δ α₁ + b • δ α₂ := by
        rw [map_add, map_zsmul, map_zsmul]
      haveI : Etale f := hf
      obtain ⟨β, hβ⟩ := hδ (a • α₁ + b • α₂) W' f hf
        (fun Z' iW' g h D' Ef γ hγ => by rw [hδα]; exact hkill Z' iW' g h D' Ef γ hγ)
        (Limits.pullback gV f) (Limits.pullback.snd gV f)
        (Limits.pullback.fst gV f) (IsPullback.of_hasPullback gV f)
      refine ⟨a, b, hab, ?_⟩
      obtain ⟨x', hx'⟩ := hzf
      obtain ⟨S'', s'', hs'', hxs'', hdie⟩ := wc_et_zmodext_pos_locally_zero W' ℓ hℓ0 k hk1 β x'
      haveI : Etale s'' := hs''
      refine ⟨S'', s'' ≫ f, inferInstance, ?_, ?_⟩
      · obtain ⟨y, hy⟩ := hxs''
        exact ⟨y, by rw [Scheme.Hom.comp_apply, hy, hx', hz2]⟩
      · intro YV' gV' w' hpb' Dw'
        have hu : w' ≫ gV = (gV' ≫ s'') ≫ f := by rw [hpb'.w, Category.assoc]
        obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst gV f) ℓ
        obtain ⟨Dsnd⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd gV f) ℓ
        obtain ⟨Du⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift w' (gV' ≫ s'') hu) ℓ
        obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gV' ℓ
        obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists s'' ℓ
        obtain ⟨Dgs⟩ := wc_et_zmod_pull_data_exists (gV' ≫ s'') ℓ
        rw [wc_et_pull_comp (Limits.pullback.fst gV f) (Limits.pullback.lift w' (gV' ≫ s'') hu) w'
            (Limits.pullback.lift_fst _ _ _) Dfst Du Dw' k (a • α₁ + b • α₂),
          hβ Dfst Dsnd,
          ← wc_et_pull_comp (Limits.pullback.snd gV f) (Limits.pullback.lift w' (gV' ≫ s'') hu)
            (gV' ≫ s'') (Limits.pullback.lift_snd _ _ _) Dsnd Du Dgs k β,
          wc_et_pull_comp s'' gV' (gV' ≫ s'') rfl Ds Dg Dgs k β, hdie Ds, map_zero]
    ·
      exact absurd hk2 (by omega)
    · exact ((hlt hen).false z0).elim
  ·
    refine ⟨1, 0, hab₁₀, ?_⟩
    rw [one_zsmul, zero_zsmul, add_zero]
    have hxV : v x ∈ (V : Set X) := by rw [hV]; exact hx
    let O : W.Opens := v ⁻¹ᵁ V
    have hxO : x ∈ O := hxV
    let ρ : (O : Scheme.{u}) ⟶ YV := hpb.lift (v ∣_ V) O.ι (morphismRestrict_ι v V)
    have hρ : ρ ≫ gV = O.ι := hpb.lift_snd _ _ _
    obtain ⟨Dρ⟩ := wc_et_zmod_pull_data_exists ρ ℓ
    obtain ⟨S', s', hs', hxs', hdie⟩ :=
      wc_et_zmodext_pos_locally_zero (O : Scheme.{u}) ℓ hℓ0 k hk1 (wcEtPull Dρ k α₁) ⟨x, hxO⟩
    haveI : Etale s' := hs'
    refine ⟨S', s' ≫ O.ι, inferInstance, ?_, ?_⟩
    · obtain ⟨y, hy⟩ := hxs'
      exact ⟨y, by rw [Scheme.Hom.comp_apply, hy]; rfl⟩
    · intro YV' gV' w' hpb' Dw'
      have hw' : gV' ≫ s' ≫ ρ = w' := by
        rw [← cancel_mono gV, hpb'.w]
        simp only [Category.assoc, hρ]
      obtain ⟨Ds'⟩ := wc_et_zmod_pull_data_exists s' ℓ
      obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gV' ℓ
      obtain ⟨Dsρ⟩ := wc_et_zmod_pull_data_exists (s' ≫ ρ) ℓ
      rw [wc_et_pull_comp (s' ≫ ρ) gV' w' hw' Dsρ Dg Dw' k α₁,
        wc_et_pull_comp ρ s' (s' ≫ ρ) rfl Dρ Ds' Dsρ k α₁, hdie Ds', map_zero]

theorem wc_smooth_pair_compl_strict_stalk_et_top_card_le (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) (n m : ℕ) [SmoothOfRelativeDimension n pY]
    [IsLocallyNoetherian Y]
    (i : Z ⟶ Y) [IsClosedImmersion i] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (V : Y.Opens) (hV : (V : Set Y) = (Set.range i)ᶜ)
    (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (c : Spec R ⟶ Y) (hc : WeaklyEtale c) {Pq : Scheme.{u}} (q : Pq ⟶ (V : Scheme.{u}))
    (t : Pq ⟶ Spec R) (hP : IsPullback q t V.ι c)
    (k : ℕ) (hk1 : 1 ≤ k) (hk2 : k + 1 + 2 * m = 2 * n) :
    Finite (wcEtCoh Pq ℓ k) ∧ Nat.card (wcEtCoh Pq ℓ k) ≤ ℓ :=
by
  classical
  have hp : Nat.Prime ℓ := Fact.out

  obtain ⟨Λ, _, _, D₀, φ, hAff, hφc, hφa, hlim⟩ :=
    wc_weaklyEtale_strictHensel_prosystem (R : Type u) c hc

  obtain ⟨π, hπ1, hπ2, hπ3, hπ4⟩ :=
    wc_et_baseChange_limit_cone V.ι (R : Type u) Λ D₀ φ c hφc hφa hlim Pq q t hP

  haveI : QuasiCompact V.ι := inferInstance
  have hfstQC : ∀ l, QuasiCompact (Limits.pullback.fst (D₀.obj l).hom V.ι) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiCompact)
      (IsPullback.of_hasPullback (D₀.obj l).hom V.ι).flip inferInstance
  have hfstQS : ∀ l, QuasiSeparated (Limits.pullback.fst (D₀.obj l).hom V.ι) := fun l =>
    MorphismProperty.of_isPullback (P := @QuasiSeparated)
      (IsPullback.of_hasPullback (D₀.obj l).hom V.ι).flip inferInstance
  have hLc : ∀ l, CompactSpace ((D₀ ⋙ wcEtBaseChange V.ι).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
    haveI : IsAffine (D₀.obj l).left := hAff l
    exact @QuasiCompact.compactSpace_of_compactSpace _ _
      (Limits.pullback.fst (D₀.obj l).hom V.ι) (hfstQC l) inferInstance
  have hLq : ∀ l, QuasiSeparatedSpace ((D₀ ⋙ wcEtBaseChange V.ι).obj l).left := fun l => by
    haveI : IsAffine ((𝟭 Scheme.{u}).obj (D₀.obj l).left) := hAff l
    haveI : IsAffine (D₀.obj l).left := hAff l
    exact @quasiSeparatedSpace_of_quasiSeparated _ _
      (Limits.pullback.fst (D₀.obj l).hom V.ι) inferInstance (hfstQS l)
  have M1 : ∀ {l l' : Λ} (t' : l ⟶ l'),
      ((D₀ ⋙ wcEtBaseChange V.ι).map t').left ≫ Limits.pullback.fst (D₀.obj l').hom V.ι =
        Limits.pullback.fst (D₀.obj l).hom V.ι ≫ (D₀.map t').left := by
    intro l l' t'
    exact Limits.pullback.lift_fst _ _ _
  have M2 : ∀ {l l' : Λ} (t' : l ⟶ l'),
      ((D₀ ⋙ wcEtBaseChange V.ι).map t').left ≫ Limits.pullback.snd (D₀.obj l').hom V.ι =
        Limits.pullback.snd (D₀.obj l).hom V.ι := by
    intro l l' t'
    exact Limits.pullback.lift_snd _ _ _
  have C6 : ∀ {l l' : Λ} (t' : l ⟶ l'), IsAffineHom ((D₀ ⋙ wcEtBaseChange V.ι).map t').left := by
    intro l l' t'
    have := hAff l
    have := hAff l'
    have Rr : IsPullback (Limits.pullback.snd (D₀.obj l').hom V.ι)
        (Limits.pullback.fst (D₀.obj l').hom V.ι) V.ι (D₀.obj l').hom :=
      (IsPullback.of_hasPullback (D₀.obj l').hom V.ι).flip
    have O : IsPullback (((D₀ ⋙ wcEtBaseChange V.ι).map t').left ≫
        Limits.pullback.snd (D₀.obj l').hom V.ι) (Limits.pullback.fst (D₀.obj l).hom V.ι) V.ι
        ((D₀.map t').left ≫ (D₀.obj l').hom) := by
      rw [M2 t', MorphismProperty.Over.w (D₀.map t')]
      exact (IsPullback.of_hasPullback (D₀.obj l).hom V.ι).flip
    have L : IsPullback ((D₀ ⋙ wcEtBaseChange V.ι).map t').left
        (Limits.pullback.fst (D₀.obj l).hom V.ι) (Limits.pullback.fst (D₀.obj l').hom V.ι)
        (D₀.map t').left :=
      IsPullback.of_right O (M1 t') Rr
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) L.flip
      (isAffineHom_of_isAffine (D₀.map t').left)
  haveI : QuasiCompact t := MorphismProperty.of_isPullback (P := @QuasiCompact) hP inferInstance
  haveI : QuasiSeparated t :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) hP inferInstance
  have hPc : CompactSpace Pq := QuasiCompact.compactSpace_of_compactSpace t
  have hPs : QuasiSeparatedSpace Pq := quasiSeparatedSpace_of_quasiSeparated t

  have hrel : ∀ y₁ y₂ : wcEtZModExt Pq ℓ k, ∃ a b : ℤ, ¬ ((ℓ : ℤ) ∣ a ∧ (ℓ : ℤ) ∣ b) ∧
      a • y₁ + b • y₂ = 0 := by
    intro y₁ y₂
    obtain ⟨l₁, x₁, hx₁⟩ := wc_et_limit_pull_surj_qcqs_all q Λ (D₀ ⋙ wcEtBaseChange V.ι) π hπ1
      hπ3 hπ4 hLc hLq C6 hPc hPs ℓ k y₁
    obtain ⟨l₂, x₂, hx₂⟩ := wc_et_limit_pull_surj_qcqs_all q Λ (D₀ ⋙ wcEtBaseChange V.ι) π hπ1
      hπ3 hπ4 hLc hLq C6 hPc hPs ℓ k y₂
    let l : Λ := IsCofiltered.min l₁ l₂
    let t₁ : l ⟶ l₁ := IsCofiltered.minToLeft l₁ l₂
    let t₂ : l ⟶ l₂ := IsCofiltered.minToRight l₁ l₂
    have hy : ∀ (l' : Λ) (τ : l ⟶ l')
        (x : wcEtZModExt ((D₀ ⋙ wcEtBaseChange V.ι).obj l').left ℓ k)
        (y : wcEtZModExt Pq ℓ k), (∀ E : wcEtPullData (π l') ℓ, wcEtPull E k x = y) →
        ∃ x' : wcEtZModExt ((D₀ ⋙ wcEtBaseChange V.ι).obj l).left ℓ k,
          ∀ E : wcEtPullData (π l) ℓ, wcEtPull E k x' = y := by
      intro l' τ x y hx
      obtain ⟨Eτ⟩ := wc_et_zmod_pull_data_exists ((D₀ ⋙ wcEtBaseChange V.ι).map τ).left ℓ
      obtain ⟨E'⟩ := wc_et_zmod_pull_data_exists (π l') ℓ
      refine ⟨wcEtPull Eτ k x, fun E => ?_⟩
      rw [← wc_et_pull_comp _ (π l) (π l') (hπ3 τ) Eτ E E' k x]
      exact hx E'
    obtain ⟨x₁', hx₁'⟩ := hy l₁ t₁ x₁ y₁ hx₁
    obtain ⟨x₂', hx₂'⟩ := hy l₂ t₂ x₂ y₂ hx₂
    have hsq : IsPullback (Limits.pullback.snd (D₀.obj l).hom V.ι)
        (Limits.pullback.fst (D₀.obj l).hom V.ι) V.ι (D₀.obj l).hom :=
      (IsPullback.of_hasPullback (D₀.obj l).hom V.ι).flip
    obtain ⟨a, b, hab, W', v', hv', ⟨w₀, hw₀⟩, kill⟩ :=
      wc_et_smooth_pair_punct_top_local_relation K Y pY n m Z i ℓ hℓ V hV k hk1 hk2
        (D₀.obj l).left (D₀.obj l).hom (D₀.obj l).prop
        (Limits.pullback (D₀.obj l).hom V.ι) (Limits.pullback.fst (D₀.obj l).hom V.ι)
        (Limits.pullback.snd (D₀.obj l).hom V.ι) hsq x₁' x₂'
        (φ l (IsLocalRing.closedPoint (R : Type u)))
    refine ⟨a, b, hab, ?_⟩
    haveI := hv'
    obtain ⟨σ, hσ⟩ := wc_strictHensel_etale_point_lift (R : Type u) (φ l) v' w₀ hw₀
    have h₀ : π l ≫ Limits.pullback.fst (D₀.obj l).hom V.ι = (t ≫ σ) ≫ v' := by
      rw [hπ2 l, Category.assoc, hσ]
    let ρ : Pq ⟶ Limits.pullback (Limits.pullback.fst (D₀.obj l).hom V.ι) v' :=
      Limits.pullback.lift (f := Limits.pullback.fst (D₀.obj l).hom V.ι) (g := v') (π l)
        (t ≫ σ) h₀
    have hρ : ρ ≫ Limits.pullback.fst (Limits.pullback.fst (D₀.obj l).hom V.ι) v' = π l :=
      Limits.pullback.lift_fst _ _ _
    have hsq' := IsPullback.of_hasPullback (Limits.pullback.fst (D₀.obj l).hom V.ι) v'
    obtain ⟨Dw'⟩ := wc_et_zmod_pull_data_exists
      (Limits.pullback.fst (Limits.pullback.fst (D₀.obj l).hom V.ι) v') ℓ
    obtain ⟨Dρ⟩ := wc_et_zmod_pull_data_exists ρ ℓ
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists (π l) ℓ
    rw [← hx₁' E, ← hx₂' E, ← map_zsmul (wcEtPull E k), ← map_zsmul (wcEtPull E k),
      ← map_add, wc_et_pull_comp _ ρ (π l) hρ Dw' Dρ E k]
    exact (congrArg (wcEtPull Dρ k) (kill _ _ _ hsq' Dw')).trans (map_zero _)

  have htors : ∀ y : wcEtZModExt Pq ℓ k, ℓ • y = 0 := by
    intro y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Pq ℓ)) := HasExt.standard _
    have h1 : ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Pq ℓ)) = 0 := by
      apply (SheafOfModules.toSheaf (wcEtZModRing Pq ℓ)).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      exact wc_et_zmod_toSheaf_nsmul_zero Pq ℓ _
    let Φ : (SheafOfModules.unit (wcEtZModRing Pq ℓ) ⟶ SheafOfModules.unit (wcEtZModRing Pq ℓ))
        →+ wcEtZModExt Pq ℓ k :=
      AddMonoidHom.mk' (fun f => y.comp (Abelian.Ext.mk₀ f) (add_zero k)) (fun f g => by
        simp only [Abelian.Ext.mk₀_add, Abelian.Ext.comp_add])
    have hΦ : Φ (𝟙 _) = y := Abelian.Ext.comp_mk₀_id y
    calc ℓ • y = ℓ • Φ (𝟙 _) := by rw [hΦ]
      _ = Φ (ℓ • 𝟙 _) := (map_nsmul Φ ℓ _).symm
      _ = 0 := by rw [h1, map_zero]

  have hfc : Finite (wcEtZModExt Pq ℓ k) ∧ Nat.card (wcEtZModExt Pq ℓ k) ≤ ℓ := by
    by_cases hall : ∀ y : wcEtZModExt Pq ℓ k, y = 0
    · haveI : Subsingleton (wcEtZModExt Pq ℓ k) := ⟨fun a b => (hall a).trans (hall b).symm⟩
      refine ⟨Finite.of_subsingleton, ?_⟩
      rw [Nat.card_of_subsingleton (0 : wcEtZModExt Pq ℓ k)]
      exact hp.one_lt.le
    · push_neg at hall
      obtain ⟨y₀, hy₀⟩ := hall
      have hord : addOrderOf y₀ = ℓ := addOrderOf_eq_prime (htors y₀) hy₀
      have hzℓ : ∀ N : ℤ, (ℓ : ℤ) ∣ N → N • y₀ = 0 := by
        intro N hN
        rw [← addOrderOf_dvd_iff_zsmul_eq_zero, hord]
        exact hN
      have hmul : ∀ y : wcEtZModExt Pq ℓ k, ∃ N : ℤ, y = N • y₀ := by
        intro y
        obtain ⟨a, b, hab, h⟩ := hrel y₀ y
        have hyℓ : (ℓ : ℤ) • y = 0 := by rw [natCast_zsmul]; exact htors y
        have hb : ¬ (ℓ : ℤ) ∣ b := by
          rintro ⟨b', rfl⟩
          apply hab
          refine ⟨?_, ⟨b', rfl⟩⟩
          have ha : a • y₀ = 0 := by
            rw [mul_comm, mul_zsmul, hyℓ, zsmul_zero, add_zero] at h
            exact h
          have hd := (addOrderOf_dvd_iff_zsmul_eq_zero (x := y₀) (i := a)).mpr ha
          rwa [hord] at hd
        have hcop : IsCoprime (ℓ : ℤ) b :=
          (Prime.coprime_iff_not_dvd (Nat.prime_iff_prime_int.mp hp)).mpr hb
        obtain ⟨u', v', huv⟩ := hcop
        have hby : b • y = -(a • y₀) := eq_neg_of_add_eq_zero_right h
        refine ⟨-(v' * a), ?_⟩
        calc y = (u' * (ℓ : ℤ) + v' * b) • y := by rw [huv, one_zsmul]
          _ = u' • ((ℓ : ℤ) • y) + v' • (b • y) := by rw [add_zsmul, mul_zsmul, mul_zsmul]
          _ = (-(v' * a)) • y₀ := by
            rw [hyℓ, zsmul_zero, zero_add, hby, zsmul_neg, neg_zsmul, mul_zsmul]
      haveI : NeZero ℓ := ⟨hp.ne_zero⟩
      let f : ZMod ℓ → wcEtZModExt Pq ℓ k := fun r => ((r.val : ℕ) : ℤ) • y₀
      have hf : Function.Surjective f := by
        intro y
        obtain ⟨N, rfl⟩ := hmul y
        refine ⟨(N : ZMod ℓ), ?_⟩
        show (((N : ZMod ℓ).val : ℕ) : ℤ) • y₀ = N • y₀
        rw [ZMod.val_intCast, Int.emod_def, sub_zsmul, hzℓ _ (dvd_mul_right _ _), neg_zero,
          add_zero]
      exact ⟨Finite.of_surjective f hf,
        (Nat.card_le_card_of_surjective f hf).trans (Nat.card_zmod ℓ).le⟩

  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Pq ℓ k
  haveI := hfc.1
  exact ⟨Finite.of_equiv _ E, (Nat.card_congr E).symm.le.trans hfc.2⟩

theorem wc_smooth_pair_strict_local_supp_line (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (R : CommRingCat.{u}) [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (k : Spec R ⟶ Y) (hk : WeaklyEtale k)
    (T : Scheme.{u}) (iT : T ⟶ Spec R) (g : T ⟶ Z) (hP : IsPullback g iT i k)
    (DT : wcHMPullData iT ℓ) (hDT : wcHMPullCanonical DT) (hepi : Epi (wcSuppUnitMap DT)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
    ∀ v w : wcSuppExt DT (2 * r), v ≠ 0 →
      ∃ c : ℚ_[ℓ], w = v.comp (Abelian.Ext.mk₀ (wcHMConst (Spec R) ℓ c)) (add_zero (2 * r)) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (Spec R) ℓ)) := HasExt.standard _
  intro v w hv
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : WeaklyEtale k := hk

  have hdom : IsDomain R := by
    let e := stalkClosedPointIso R
    have h1 : HenselianLocalRing ((Spec R).presheaf.stalk (IsLocalRing.closedPoint R)) :=
      wc_henselian_sepClosed_transfer.1 _ _ e.symm.commRingCatIsoToRingEquiv inferInstance
    have h2 : IsSepClosed (IsLocalRing.ResidueField
        ((Spec R).presheaf.stalk (IsLocalRing.closedPoint R))) :=
      wc_henselian_sepClosed_transfer.2 _ _
        (IsLocalRing.ResidueField.mapEquiv e.symm.commRingCatIsoToRingEquiv) inferInstance
    have hd : IsDomain ((Spec R).presheaf.stalk (IsLocalRing.closedPoint R)) :=
      wc_weaklyEtale_smooth_stalk_isDomain K pY n (Scheme.ProEt.mk k)
        (IsLocalRing.closedPoint R) ⟨h1, h2⟩
    haveI := hd
    exact MulEquiv.isDomain _ e.symm.commRingCatIsoToRingEquiv.toMulEquiv
  haveI := hdom
  obtain ⟨hC1, hCmul, hCadd⟩ := wc_hm_const_ring (Spec R) ℓ
  have hC0 : wcHMConst (Spec R) ℓ 0 = 0 := by
    have h := hCadd 0 0
    rw [add_zero] at h
    have h2 : wcHMConst (Spec R) ℓ 0 + wcHMConst (Spec R) ℓ 0 =
