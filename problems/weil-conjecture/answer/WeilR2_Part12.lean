theorem wc_ldpi_oai_proj_lift (K : Type u) [Field K] (n : ℕ) (V : Scheme.{u})
    (fV : V ⟶ Spec (.of K)) (t : Fin (n + 1) → Γ(V, ⊤)) (ht : Ideal.span (Set.range t) = ⊤) :
    ∃ φ : V ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fV ∧
      (∀ J, φ ⁻¹ᵁ wcSgD K n J = V.basicOpen (t J)) ∧
      ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J),
        φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
        V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L) :=
by
  have hres : ∀ (X : Scheme.{u}) (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro X A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have s3a : ∀ (X : Scheme.{u}) (r a : Γ(X, ⊤)), ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away r))).inv (algebraMap Γ(X, ⊤) (Localization.Away r) a)) = (X.basicOpen r).ι.appTop a := by
    intro X r a
    have h1 : ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom) ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r))) = (X.basicOpen r).ι ≫ X.toSpecΓ := by
      have hm := morphismRestrict_ι X.toSpecΓ (PrimeSpectrum.basicOpen r)
      rw [Category.assoc, Category.assoc, basicOpenIsoSpecAway_hom_SpecMap, hm, ← Category.assoc,
        Scheme.isoOfEq_inv_ι]
    have h2 := congrArg Scheme.Hom.appTop h1
    rw [Scheme.Hom.comp_appTop _ (Spec.map _), Scheme.Hom.comp_appTop (X.basicOpen r).ι,
      Scheme.toSpecΓ_appTop] at h2
    have h3 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))
    calc _ = (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)) ≫ (Scheme.ΓSpecIso (.of (Localization.Away r))).inv ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := rfl
      _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))).appTop ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := by
        rw [← Category.assoc, h3, Category.assoc]; rfl
      _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Scheme.ΓSpecIso Γ(X, ⊤)).hom ≫ (X.basicOpen r).ι.appTop) a := by
        rw [h2]
      _ = _ := by rw [Iso.inv_hom_id_assoc]
  have s3 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (X : Scheme.{u}) (f : A →+* Γ(X, ⊤)) (hf : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.map f = ⊤) {t : A} {d : ℕ} (hd : 0 < d) (ht : t ∈ 𝒜 d) (n : ℕ) (y : A) (hy : y ∈ 𝒜 (n • d)), (Proj.fromOfGlobalSections 𝒜 f hf).app (Proj.basicOpen 𝒜 t) ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) * X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f t) ^ n = X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f y) := by
    intro σ A _ _ _ 𝒜 _ X f hf t d hd ht n y hy
    have key : ∀ {U V : Scheme.{u}} {R L : CommRingCat.{u}} (W : V ⟶ Spec L) (φ₀ : R ⟶ L) (i : U ≅ Spec R) (T : V ⟶ U), T = (W ≫ Spec.map φ₀) ≫ i.inv → ∀ x : R, T.appTop (i.hom.appTop ((Scheme.ΓSpecIso R).inv x)) = W.appTop ((Scheme.ΓSpecIso L).inv (φ₀ x)) := by
      intro U V R L W φ₀ i T hT x
      subst hT
      have e1 : ((W ≫ Spec.map φ₀) ≫ i.inv).appTop = i.inv.appTop ≫ (Spec.map φ₀).appTop ≫ W.appTop := by
        rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
      have e2 : i.hom.appTop ≫ i.inv.appTop = 𝟙 _ := by
        rw [← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop]
      have e3 := Scheme.ΓSpecIso_inv_naturality φ₀
      calc _ = ((Scheme.ΓSpecIso R).inv ≫ (i.hom.appTop ≫ i.inv.appTop) ≫ (Spec.map φ₀).appTop ≫ W.appTop) x := by
            rw [e1]; rfl
        _ = ((φ₀ ≫ (Scheme.ΓSpecIso L).inv) ≫ W.appTop) x := by
            rw [e2, Category.id_comp, ← Category.assoc, ← e3]
    have resLE_top : ∀ {X Y : Scheme.{u}} (φ : X ⟶ Y) {U : Y.Opens} {V : X.Opens} (e : V ≤ φ ⁻¹ᵁ U) (r : Γ(Y, U)), (φ.resLE U V e).appTop (U.topIso.inv r) = V.topIso.inv (φ.appLE U V e r) := by
      intro X Y φ U V e r
      calc _ = (U.topIso.inv ≫ U.topIso.hom ≫ φ.appLE U V e ≫ V.topIso.inv) r := by
            rw [← Scheme.Hom.resLE_app_top]; rfl
        _ = _ := by rw [Iso.inv_hom_id_assoc]; rfl
    have hPV : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t = X.basicOpen (f t) :=
      Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f hf hd ht
    have hle : Submonoid.powers t ≤ (Submonoid.powers (f t)).comap f :=
      Submonoid.powers_le.mpr (Submonoid.mem_powers (f t))
    have hT : (Proj.fromOfGlobalSections 𝒜 f hf).resLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge =
        (((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom) ≫
          Spec.map (CommRingCat.ofHom ((IsLocalization.map (Localization.Away (f t)) f hle).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))))) ≫
          (Proj.basicOpenIsoSpec 𝒜 t ht hd).inv := by
      rw [Proj.fromOfGlobalSections_resLE 𝒜 f hf hd ht, Proj.toBasicOpenOfGlobalSections.eq_1]
      simp only [Category.assoc]
    have hi : (Proj.basicOpenIsoSpec 𝒜 t ht hd).hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).inv (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) = (Proj.basicOpen 𝒜 t).topIso.inv ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) := by
      rw [Proj.basicOpenIsoSpec_hom]
      have hh := Proj.basicOpenToSpec_app_top 𝒜 t
      calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).hom ≫ Proj.awayToSection 𝒜 t ≫ (Proj.basicOpen 𝒜 t).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).inv (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) := by rw [← hh]
        _ = (Proj.basicOpen 𝒜 t).topIso.inv (Proj.awayToSection 𝒜 t ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).hom ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).inv (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)))) := rfl
        _ = _ := by rw [Iso.inv_hom_id_apply]
    have h1 := key _ _ _ _ hT (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)
    rw [hi, resLE_top] at h1
    have hD : ((IsLocalization.map (Localization.Away (f t)) f hle).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))) (HomogeneousLocalization.Away.mk 𝒜 ht n y hy) * (algebraMap Γ(X, ⊤) (Localization.Away (f t)) (f t)) ^ n = algebraMap Γ(X, ⊤) (Localization.Away (f t)) (f y) := by
      rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk', IsLocalization.map_mk', ← map_pow, ← map_pow f]
      exact IsLocalization.mk'_spec _ _ _
    have hΦ : ∀ a b c : Localization.Away (f t), a * b ^ n = c →
        ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv a) * (((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv b)) ^ n = ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv c) := by
      intro a b c h
      rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, h]
    have h2 := hΦ _ _ _ hD
    rw [s3a, s3a] at h2
    have h1' : (X.basicOpen (f t)).topIso.inv ((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) = ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv (((IsLocalization.map (Localization.Away (f t)) f hle).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))) (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) := h1
    rw [← h1'] at h2
    have hι : ∀ a, (X.basicOpen (f t)).ι.appTop a = (X.basicOpen (f t)).topIso.inv (X.presheaf.map (homOfLE (le_top : X.basicOpen (f t) ≤ ⊤)).op a) := by
      intro a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [hι, hι, ← map_pow, ← map_mul] at h2
    have hinj : ∀ a b : Γ(X, X.basicOpen (f t)), (X.basicOpen (f t)).topIso.inv a = (X.basicOpen (f t)).topIso.inv b → a = b := by
      intro a b h
      have h' := congrArg (fun w => (X.basicOpen (f t)).topIso.hom w) h
      simp only [Iso.inv_hom_id_apply] at h'
      exact h'
    have hSS := hinj _ _ h2
    have hG1 : (Proj.fromOfGlobalSections 𝒜 f hf).app (Proj.basicOpen 𝒜 t) ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) = X.presheaf.map (homOfLE hPV.le).op ((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) := by
      have hh := Scheme.Hom.appLE_map (Proj.fromOfGlobalSections 𝒜 f hf) hPV.ge (homOfLE hPV.le).op
      rw [Scheme.Hom.app_eq_appLE, ← hh]
      rfl
    have hG2 : ∀ a, X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op a = X.presheaf.map (homOfLE hPV.le).op (X.presheaf.map (homOfLE (le_top : X.basicOpen (f t) ≤ ⊤)).op a) := by
      intro a
      rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [hG1, hG2, hG2, ← map_pow, ← map_mul, hSS]
  have S3 : ∀ (K : Type u) [Field K] (n : ℕ) (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (t : Fin (n + 1) → Γ(V, ⊤)),
      Ideal.span (Set.range t) = ⊤ →
      ∃ φ : V ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fV ∧ (∀ J, φ ⁻¹ᵁ wcSgD K n J = V.basicOpen (t J)) ∧
        ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J), φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L) := by
    intro K _ N V fV s hspan
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ J : Fin (N + 1), (MvPolynomial.X J : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun J =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)
    let F : MvPolynomial (Fin (N + 1)) K →+* Γ(V, ⊤) :=
      MvPolynomial.eval₂Hom (fV.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) s
    have hFX : ∀ J, F (MvPolynomial.X J) = s J := fun J => MvPolynomial.eval₂Hom_X' _ _ J
    have hF : (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal.map F = ⊤ := by
      rw [eq_top_iff, ← hspan, Ideal.span_le]
      rintro _ ⟨J, rfl⟩
      rw [← hFX J]
      apply Ideal.mem_map_of_mem
      exact (HomogeneousIdeal.mem_irrelevant_iff _ _).mpr (by
        rw [GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne _ (hX J) one_ne_zero)
    refine ⟨Proj.fromOfGlobalSections _ F hF, ?_, fun J => ?_, fun J L O hO => ?_⟩
    · have h1 := Proj.fromOfGlobalSections_toSpecZero
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) F hF
      have hc : CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
            (MvPolynomial (Fin (N + 1)) K))) = (Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro k
        show F (MvPolynomial.C k) = fV.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom k)
        exact MvPolynomial.eval₂Hom_C _ _ k
      have h2 : (Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv = 𝟙 _ := by
        rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
      calc Proj.fromOfGlobalSections _ F hF ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0))))
          = (Proj.fromOfGlobalSections _ F hF ≫
              Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) :=
            (Category.assoc _ _ _).symm
        _ = V.toSpecΓ ≫ (Spec.map (CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
              (MvPolynomial (Fin (N + 1)) K)))) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) := by
            rw [h1, Category.assoc]
        _ = V.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop) := by
            rw [← Spec.map_comp, hc]
        _ = (V.toSpecΓ ≫ Spec.map fV.appTop) ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
            rw [Spec.map_comp, Category.assoc]
        _ = fV ≫ ((Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv) := by
            rw [← Scheme.toSpecΓ_naturality, Category.assoc]
        _ = fV := by rw [h2, Category.comp_id]
    · rw [← hFX J]
      exact Proj.fromOfGlobalSections_preimage_basicOpen _ F hF Nat.one_pos (hX J)
    · have hy : (MvPolynomial.X L : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
        rw [one_smul]
        exact hX L
      have h := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) V F hF Nat.one_pos (hX J) 1
        (MvPolynomial.X L) hy
      rw [hFX, hFX, pow_one] at h
      have e := congrArg (V.presheaf.map (homOfLE hO).op) h
      rw [map_mul, hres, hres] at e
      exact e
  exact S3 K n V fV t ht

theorem wc_ldpi_oai_snd_chart (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Z : Scheme.{u}) (g : Z ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hsec : ∀ (i : Fin (N + 1) × Fin 2) (O : (Limits.pullback X.hom (wcProjKStr E 1)).Opens),
      IsAffineOpen O → ∀ (hOW : O ≤ wcLdpW E N X ι i),
      Function.Surjective (g.app O).hom ∧
      RingHom.ker (g.app O).hom = Ideal.span {(Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
        (homOfLE hOW).op (wcLdpH E N X ι G₀ G₁ i)})
    (a : Fin (N + 1)) (ε : Fin 2)
    (hO : IsAffineOpen (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 (ε + 1)))
    (hS2 : ∀ J L : Fin (1 + 1), (wcProjK E 1).basicOpen (wcSgE E 1 J L) = wcSgD E 1 J ⊓ wcSgD E 1 L) :
    (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ
        X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ≤
      (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ⁻¹ᵁ wcSgD E 1 ε :=
by
  classical
  have hε : ε + 1 + 1 = ε := by fin_cases ε <;> rfl
  have hj : ∀ j : Fin 2, j ≠ ε → j = ε + 1 := by
    intro j
    fin_cases ε <;> fin_cases j <;> decide

  have hcov : (⨆ j : Fin (1 + 1), wcSgD E 1 j) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩

  have hc : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (h : B ⟶ C) (U : C.Opens) (V : B.Opens)
      (W : A.Opens) (e₁ : V ≤ h ⁻¹ᵁ U) (e₂ : W ≤ f ⁻¹ᵁ V) (s : Γ(C, U)),
      (f.appLE V W e₂).hom ((h.appLE U V e₁).hom s) =
        ((f ≫ h).appLE U W (e₂.trans (Scheme.Hom.preimage_mono f e₁))).hom s :=
    fun f h U V W e₁ e₂ s => congrArg (fun φ => φ.hom s) (Scheme.Hom.appLE_comp_appLE f h U V W e₁ e₂)
  have hOW : Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 (ε + 1) ≤
        wcLdpW E N X ι (a, ε + 1) :=
    inf_le_inf_right _ (Scheme.Hom.preimage_mono _ (X.left.basicOpen_le _))
  obtain ⟨-, hker⟩ := hsec (a, ε + 1) _ hO hOW
  have h0 := Ideal.mem_span_singleton_self ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
    (homOfLE hOW).op (wcLdpH E N X ι G₀ G₁ (a, ε + 1)))
  rw [← hker, RingHom.mem_ker, Scheme.Hom.app_eq_appLE (f := g)] at h0
  have h1 := congrArg (fun φ => φ.hom (wcLdpH E N X ι G₀ G₁ (a, ε + 1)))
    (Scheme.Hom.map_appLE g (le_refl (g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 (ε + 1))))
      (homOfLE hOW).op)
  have h2 : (g.appLE (wcLdpW E N X ι (a, ε + 1)) (g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 (ε + 1)))
        (Scheme.Hom.preimage_mono g hOW)).hom (wcLdpH E N X ι G₀ G₁ (a, ε + 1)) = 0 := by
    rw [← h1]
    exact h0
  simp only [wcLdpH, map_sub, map_mul, hc] at h2
  rw [sub_eq_zero] at h2
  have h3 := congrArg (Scheme.basicOpen Z) h2
  rw [Scheme.basicOpen_mul, Scheme.basicOpen_appLE, Scheme.basicOpen_appLE,
    Scheme.basicOpen_appLE, hS2] at h3
  intro z hz
  have hz2 : (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) z ∈ (⊤ : (wcProjK E 1).Opens) :=
    trivial
  rw [← hcov, TopologicalSpace.Opens.mem_iSup] at hz2
  obtain ⟨j, hj'⟩ := hz2
  by_cases hjε : j = ε
  · subst hjε
    exact hj'
  · have hje := hj j hjε
    subst hje
    have hmem := h3.le ⟨⟨hz, hj'⟩, by simp only [hε]; exact hz⟩
    have hfin := hmem.1.2.2
    first
      | (rw [hε] at hfin; exact hfin)
      | (simp only [hε] at hfin; exact hfin)

theorem wc_ldpi_oai_surj (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Z : Scheme.{u}) (g : Z ⟶ Limits.pullback X.hom (wcProjKStr E 1)) (hg : IsClosedImmersion g)
    (hsec : ∀ (i : Fin (N + 1) × Fin 2) (O : (Limits.pullback X.hom (wcProjKStr E 1)).Opens),
      IsAffineOpen O → ∀ (hOW : O ≤ wcLdpW E N X ι i),
      Function.Surjective (g.app O).hom ∧
      RingHom.ker (g.app O).hom = Ideal.span {(Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
        (homOfLE hOW).op (wcLdpH E N X ι G₀ G₁ i)})
    (a : Fin (N + 1)) (ε : Fin 2)
    (hU : IsAffineOpen (X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a))))
    (hD : IsAffineOpen (wcSgD E 1 ε))
    (hO : IsAffineOpen (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε))
    (hone : ∀ J : Fin (1 + 1), wcSgE E 1 J J = 1)
    (hS1 : ∀ (J : Fin (1 + 1)) (x : Γ(wcProjK E 1, wcSgD E 1 J)),
      x ∈ Subring.closure (Set.range (wcSgE E 1 J) ∪ Set.range (fun c : E => (wcProjK E 1).presheaf.map
        (homOfLE (le_top : wcSgD E 1 J ≤ ⊤)).op ((wcProjKStr E 1).appTop ((Scheme.ΓSpecIso (.of E)).inv c))))) :
    ∀ e : g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε) ≤
        (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)),
      Function.Surjective ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE
        (X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)))
        (g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε)) e).hom :=
by
  intro e

  have surj_of_gen : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (β : A →+* C) (ψ : B →+* C) (sB : Set B) (sC : Set C),
      (∀ y : B, y ∈ Subring.closure sB) → (∀ y ∈ sB, ψ y ∈ β.range) →
      (∀ t : C, t ∈ Subring.closure sC) → (∀ x ∈ sC, x ∈ β.range ∨ ∃ y, ψ y = x) →
      Function.Surjective β := by
    intro A B C _ _ _ β ψ sB sC hB hψ hC hsC t
    have h1 : Subring.closure sB ≤ β.range.comap ψ :=
      Subring.closure_le.mpr (fun y hy => Subring.mem_comap.mpr (hψ y hy))
    have h2 : Subring.closure sC ≤ β.range := by
      refine Subring.closure_le.mpr (fun x hx => ?_)
      rcases hsC x hx with h | ⟨y, rfl⟩
      · exact h
      · exact Subring.mem_comap.mp (h1 (hB y))
    exact RingHom.mem_range.mp (h2 (hC t))

  have hconst : ∀ {Zs Ys : Scheme.{u}} (h : Zs ⟶ Ys) (U : Ys.Opens) (V : Zs.Opens)
      (e : V ≤ h ⁻¹ᵁ U) (x : Γ(Ys, ⊤)),
      (h.appLE U V e).hom ((Ys.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom x) =
        (Zs.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (h.appTop.hom x) := by
    intro Zs Ys h U V e x
    exact congrArg (fun φ : Γ(Ys, ⊤) ⟶ Γ(Zs, V) => φ.hom x)
      (Scheme.Hom.map_appLE h e (homOfLE (le_top : U ≤ ⊤)).op)

  have core : ∀ {Xl Y Pb Zs : Scheme.{u}} (fst : Pb ⟶ Xl) (snd : Pb ⟶ Y) (g : Zs ⟶ Pb)
      (XU : Xl.Opens) (D : Y.Opens) (γ0 γ1 : Γ(Xl, XU)) (σ : Γ(Y, D)) (W : Pb.Opens)
      (hW1 : W ≤ fst ⁻¹ᵁ XU) (hW2 : W ≤ snd ⁻¹ᵁ D) (Ω : Zs.Opens) (hΩ : Ω ≤ g ⁻¹ᵁ W)
      (e : Ω ≤ (g ≫ fst) ⁻¹ᵁ Xl.basicOpen γ0) (e₂ : Ω ≤ (g ≫ snd) ⁻¹ᵁ D),
      (g.appLE W Ω hΩ).hom ((fst.appLE XU W hW1).hom γ1 -
        (snd.appLE D W hW2).hom σ * (fst.appLE XU W hW1).hom γ0) = 0 →
      ((g ≫ snd).appLE D Ω e₂).hom σ ∈ ((g ≫ fst).appLE (Xl.basicOpen γ0) Ω e).hom.range := by
    intro Xl Y Pb Zs fst snd g XU D γ0 γ1 σ W hW1 hW2 Ω hΩ e e₂ h
    have hF : ∀ γ : Γ(Xl, XU), (g.appLE W Ω hΩ).hom ((fst.appLE XU W hW1).hom γ) =
        ((g ≫ fst).appLE (Xl.basicOpen γ0) Ω e).hom
          ((Xl.presheaf.map (homOfLE (Xl.basicOpen_le γ0)).op).hom γ) := by
      intro γ
      exact (congrArg (fun φ : Γ(Xl, XU) ⟶ Γ(Zs, Ω) => φ.hom γ)
          (Scheme.Hom.appLE_comp_appLE g fst XU W Ω hW1 hΩ)).trans
        (congrArg (fun φ : Γ(Xl, XU) ⟶ Γ(Zs, Ω) => φ.hom γ)
          (Scheme.Hom.map_appLE (g ≫ fst) e (homOfLE (Xl.basicOpen_le γ0)).op)).symm
    have hS : (g.appLE W Ω hΩ).hom ((snd.appLE D W hW2).hom σ) =
        ((g ≫ snd).appLE D Ω e₂).hom σ :=
      congrArg (fun φ : Γ(Y, D) ⟶ Γ(Zs, Ω) => φ.hom σ)
        (Scheme.Hom.appLE_comp_appLE g snd D W Ω hW2 hΩ)
    rw [map_sub, map_mul, hF, hF, hS, sub_eq_zero] at h
    have hu : IsUnit ((Xl.presheaf.map (homOfLE (Xl.basicOpen_le γ0)).op).hom γ0) :=
      RingedSpace.isUnit_res_basicOpen _ _
    refine RingHom.mem_range.mpr
      ⟨(Xl.presheaf.map (homOfLE (Xl.basicOpen_le γ0)).op).hom γ1 * ↑hu.unit⁻¹, ?_⟩
    rw [map_mul, h, mul_assoc, ← map_mul, hu.mul_val_inv, map_one, mul_one]

  have e₂ : g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
        X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
      Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε) ≤
      (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ⁻¹ᵁ wcSgD E 1 ε := fun z hz => hz.2
  have hOW : Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
        X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
      Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε ≤ wcLdpW E N X ι (a, ε) :=
    fun x hx => ⟨X.left.basicOpen_le _ hx.1, hx.2⟩
  obtain ⟨-, hker⟩ := hsec (a, ε) _ hO hOW
  have h0 : (g.app (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
        X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
      Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε)).hom
      ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map (homOfLE hOW).op
        (wcLdpH E N X ι G₀ G₁ (a, ε))) = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self _
  have h1 : (g.appLE (wcLdpW E N X ι (a, ε)) (g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
        X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
      Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε))
      (Scheme.Hom.preimage_mono g hOW)).hom (wcLdpH E N X ι G₀ G₁ (a, ε)) = 0 := by
    refine Eq.trans ?_ h0
    rw [Scheme.Hom.app_eq_appLE g]
    exact (congrArg (fun φ : Γ(Limits.pullback X.hom (wcProjKStr E 1), wcLdpW E N X ι (a, ε)) ⟶
        Γ(Z, g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε)) =>
          φ.hom (wcLdpH E N X ι G₀ G₁ (a, ε)))
      (Scheme.Hom.map_appLE g le_rfl (homOfLE hOW).op)).symm
  have hσ := core (Limits.pullback.fst X.hom (wcProjKStr E 1))
    (Limits.pullback.snd X.hom (wcProjKStr E 1)) g (ι ⁻¹ᵁ wcSgD E N a) (wcSgD E 1 ε)
    ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a))
    ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] (ε + 1)) a))
    (wcSgE E 1 ε (ε + 1)) (wcLdpW E N X ι (a, ε)) inf_le_left inf_le_right _
    (Scheme.Hom.preimage_mono g hOW) e e₂ h1
  have hc : ∀ c' : Γ(Spec (.of E), ⊤),
      (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)).appTop.hom (X.hom.appTop.hom c') =
        (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).appTop.hom
          ((wcProjKStr E 1).appTop.hom c') := by
    intro c'
    have hsq : (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ≫ X.hom =
        (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ≫ wcProjKStr E 1 := by
      rw [Category.assoc, Category.assoc, Limits.pullback.condition]
    have := congrArg (fun k => (Scheme.Hom.appTop k).hom c') hsq
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using this
  haveI := hg
  have hgen := (wc_closed_in_product_chart_gen (Spec (.of E)) X.left (wcProjK E 1) Z X.hom
    (wcProjKStr E 1) g _ (wcSgD E 1 ε) hU hD).2
  refine surj_of_gen _ ((g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).appLE (wcSgD E 1 ε) _ e₂).hom
    _ _ (hS1 ε) ?_ hgen ?_
  · rintro y (⟨j, rfl⟩ | ⟨c, rfl⟩)
    · have key : ∀ x y : Fin 2, y = x ∨ y = x + 1 := by decide
      rcases key ε j with rfl | rfl
      · rw [hone, map_one]
        exact Subring.one_mem _
      · exact hσ
    · exact RingHom.mem_range.mpr
        ⟨(X.left.presheaf.map (homOfLE (le_top : X.left.basicOpen
            ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ≤ ⊤)).op).hom
          (X.hom.appTop.hom ((Scheme.ΓSpecIso (.of E)).inv c)),
        (hconst (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) _ _ e
          (X.hom.appTop.hom ((Scheme.ΓSpecIso (.of E)).inv c))).trans
          ((congrArg (Z.presheaf.map (homOfLE le_top).op).hom
            (hc ((Scheme.ΓSpecIso (.of E)).inv c))).trans
            (hconst (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) _ _ e₂
              ((wcProjKStr E 1).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv c))).symm)⟩
  · rintro x (⟨y, rfl⟩ | ⟨y, rfl⟩)
    · exact Or.inl (RingHom.mem_range.mpr ⟨y, rfl⟩)
    · exact Or.inr ⟨y, rfl⟩

theorem wc_ldpi_oai_inj (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Z : Scheme.{u}) (g : Z ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hsec : ∀ (i : Fin (N + 1) × Fin 2) (O : (Limits.pullback X.hom (wcProjKStr E 1)).Opens),
      IsAffineOpen O → ∀ (hOW : O ≤ wcLdpW E N X ι i),
      Function.Surjective (g.app O).hom ∧
      RingHom.ker (g.app O).hom = Ideal.span {(Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
        (homOfLE hOW).op (wcLdpH E N X ι G₀ G₁ i)})
    (a : Fin (N + 1)) (ε : Fin 2)
    (hO : IsAffineOpen (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε))
    (hS3 : ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of E)) (t : Fin (1 + 1) → Γ(V, ⊤)),
      Ideal.span (Set.range t) = ⊤ →
      ∃ φ : V ⟶ wcProjK E 1, φ ≫ wcProjKStr E 1 = fV ∧
        (∀ J, φ ⁻¹ᵁ wcSgD E 1 J = V.basicOpen (t J)) ∧
        ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD E 1 J),
          φ.appLE (wcSgD E 1 J) O hO (wcSgE E 1 J L) *
            V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L)) :
    ∀ e : g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε) ≤
        (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)),
      Function.Injective ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE
        (X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)))
        (g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε)) e).hom :=
by
  classical
  intro e

  have hres : ∀ (Y : Scheme.{u}) (A B C : Y.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (x : Γ(Y, A)),
      Y.presheaf.map (homOfLE h2).op (Y.presheaf.map (homOfLE h1).op x) =
        Y.presheaf.map (homOfLE h3).op x := by
    intro Y A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hTI : ∀ (Y : Scheme.{u}) (U : Y.Opens) (O : (U : Scheme.{u}).Opens) (x : Γ(Y, U))
      (k : U.ι ''ᵁ O ≤ U),
      (U : Scheme.{u}).presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (U.topIso.inv x) =
        Y.presheaf.map (homOfLE k).op x := by
    intro Y U O x k
    rw [Scheme.Opens.topIso_inv]
    erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hK : ∀ (Y : Scheme.{u}) (A U : Y.Opens) (hUA : U ≤ A) (h1 : ⊤ ≤ U.ι ⁻¹ᵁ A) (x : Γ(Y, A)),
      U.ι.appLE A ⊤ h1 x = (U : Scheme.{u}).presheaf.map
        (homOfLE (le_top : (⊤ : (U : Scheme.{u}).Opens) ≤ ⊤)).op
        (U.topIso.inv (Y.presheaf.map (homOfLE hUA).op x)) := by
    intro Y A U hUA h1 x
    rw [hTI Y U ⊤ _ (Scheme.Opens.ι_image_top U).le,
      hres Y A U (U.ι ''ᵁ ⊤) hUA (Scheme.Opens.ι_image_top U).le
        (le_trans (Scheme.Opens.ι_image_top U).le hUA),
      Scheme.Opens.ι_appLE]
    rfl
  have hinjU : ∀ (Y : Scheme.{u}) (U : Y.Opens) (e : ⊤ ≤ U.ι ⁻¹ᵁ U),
      Function.Injective (U.ι.appLE U ⊤ e).hom := by
    intro Y U e c₁ c₂ h
    have hc : ∀ c, (U.ι.appLE U ⊤ e).hom c = U.topIso.inv.hom c := by
      intro c
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
      try rfl
    rw [hc, hc] at h
    exact (ConcreteCategory.bijective_of_isIso U.topIso.inv).injective h
  have ringLem : ∀ {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
      (α : A →+* B) (Φ : B →+* C) (ρ : B →+* D) (r : B),
      RingHom.ker Φ = Ideal.span {r} → ρ r = 0 → Function.Injective (ρ.comp α) →
      Function.Injective (Φ.comp α) := by
    intro A B C D _ _ _ _ α Φ ρ r hker hr hinj c₁ c₂ h
    have h1 : α c₁ - α c₂ ∈ RingHom.ker Φ := by
      rw [RingHom.mem_ker, map_sub, sub_eq_zero]
      exact h
    rw [hker, Ideal.mem_span_singleton'] at h1
    obtain ⟨d, hd⟩ := h1
    apply hinj
    have h2 := congrArg ρ hd
    rw [map_mul, hr, mul_zero, map_sub] at h2
    exact sub_eq_zero.mp h2.symm
  have hT6 : ∀ {A B : Scheme.{u}} (f f' : A ⟶ B), f = f' → ∀ (V : B.Opens) (W : A.Opens)
      (e : W ≤ f ⁻¹ᵁ V) (e' : W ≤ f' ⁻¹ᵁ V), f.appLE V W e = f'.appLE V W e' := by
    rintro A B f _ rfl V W e e'
    rfl

  set U := X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a))
    with hUdef
  have hUX : U ≤ ι ⁻¹ᵁ wcSgD E N a := X.left.basicOpen_le _
  obtain ⟨t, ht⟩ : ∃ t : Fin (1 + 1) → Γ((U : Scheme.{u}), ⊤), ∀ k, t k =
      U.topIso.inv (X.left.presheaf.map (homOfLE hUX).op
        ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] k) a))) :=
    ⟨fun k => U.topIso.inv (X.left.presheaf.map (homOfLE hUX).op
        ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] k) a))), fun _ => rfl⟩
  have hunit : IsUnit (t ε) := by
    rw [ht]
    have h0 : IsUnit (X.left.presheaf.map (homOfLE hUX).op
        ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a))) :=
      RingedSpace.isUnit_res_basicOpen _ _
    exact h0.map U.topIso.inv.hom
  have hspan : Ideal.span (Set.range t) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨ε, rfl⟩) hunit
  obtain ⟨φ, hφs, hφpre, hφrel⟩ := hS3 (U : Scheme.{u}) (U.ι ≫ X.hom) t hspan
  obtain ⟨s, hfst, hsnd⟩ : ∃ s : (U : Scheme.{u}) ⟶ Limits.pullback X.hom (wcProjKStr E 1),
      s ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = U.ι ∧
      s ≫ Limits.pullback.snd X.hom (wcProjKStr E 1) = φ :=
    ⟨Limits.pullback.lift U.ι φ hφs.symm, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hφD : φ ⁻¹ᵁ wcSgD E 1 ε = ⊤ := by
    rw [hφpre ε, Scheme.basicOpen_of_isUnit _ hunit]
  have hsD : (s ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) ⁻¹ᵁ wcSgD E 1 ε = ⊤ := by
    rw [hsnd, hφD]
  have hsU : (s ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ U = ⊤ := by
    rw [hfst, Scheme.Opens.ι_preimage_self]
  have hUι : ⊤ ≤ U.ι ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N a) :=
    (Scheme.Opens.ι_preimage_self U).ge.trans (Scheme.Hom.preimage_mono _ hUX)
  have h1 : ⊤ ≤ (s ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ (ι ⁻¹ᵁ wcSgD E N a) := by
    rw [hfst]
    exact hUι
  have hsO : ⊤ ≤ s ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ U ⊓
      Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε) := by
    rw [Scheme.Hom.preimage_inf]
    refine le_inf (le_of_eq ?_) (le_of_eq ?_)
    · rw [← Scheme.Hom.comp_preimage, hsU]
    · rw [← Scheme.Hom.comp_preimage, hsD]
  have hOW : Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ U ⊓
      Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε ≤ wcLdpW E N X ι (a, ε) :=
    inf_le_inf_right _ (Scheme.Hom.preimage_mono _ hUX)
  have hker := (hsec (a, ε) _ hO hOW).2
  have hW : ⊤ ≤ s ⁻¹ᵁ wcLdpW E N X ι (a, ε) := le_trans hsO (Scheme.Hom.preimage_mono s hOW)

  have c1 : ∀ x, (s ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE (ι ⁻¹ᵁ wcSgD E N a) ⊤
      h1 x = s.appLE (wcLdpW E N X ι (a, ε)) ⊤ hW
        (((Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE (ι ⁻¹ᵁ wcSgD E N a)
          (wcLdpW E N X ι (a, ε)) inf_le_left).hom x) := by
    intro x
    rw [← Scheme.Hom.appLE_comp_appLE s (Limits.pullback.fst X.hom (wcProjKStr E 1))
      (ι ⁻¹ᵁ wcSgD E N a) (wcLdpW E N X ι (a, ε)) ⊤ inf_le_left hW]
    try rfl
  have c2 : ∀ x, (s ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)).appLE (wcSgD E 1 ε) ⊤
      hsD.ge x = s.appLE (wcLdpW E N X ι (a, ε)) ⊤ hW
        (((Limits.pullback.snd X.hom (wcProjKStr E 1)).appLE (wcSgD E 1 ε)
          (wcLdpW E N X ι (a, ε)) inf_le_right).hom x) := by
    intro x
    rw [← Scheme.Hom.appLE_comp_appLE s (Limits.pullback.snd X.hom (wcProjKStr E 1))
      (wcSgD E 1 ε) (wcLdpW E N X ι (a, ε)) ⊤ inf_le_right hW]
    try rfl
  have hkill : s.appLE (wcLdpW E N X ι (a, ε)) ⊤ hW (wcLdpH E N X ι G₀ G₁ (a, ε)) = 0 := by
    have e1 : wcLdpH E N X ι G₀ G₁ (a, ε) =
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE (ι ⁻¹ᵁ wcSgD E N a)
          (wcLdpW E N X ι (a, ε)) inf_le_left).hom
          ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] (ε + 1)) a)) -
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).appLE (wcSgD E 1 ε)
          (wcLdpW E N X ι (a, ε)) inf_le_right).hom (wcSgE E 1 ε (ε + 1)) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE (ι ⁻¹ᵁ wcSgD E N a)
          (wcLdpW E N X ι (a, ε)) inf_le_left).hom
          ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) := rfl
    rw [e1, map_sub, map_mul, ← c1, ← c1, ← c2, hT6 _ _ hfst _ _ h1 hUι,
      hT6 _ _ hsnd _ _ hsD.ge hφD.ge, hK X.left _ U hUX hUι, hK X.left _ U hUX hUι, sub_eq_zero]
    have hr := hφrel ε (ε + 1) ⊤ hφD.ge
    rw [ht, ht] at hr
    exact hr.symm
  have hρ : (s.appLE _ ⊤ hsO).hom ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
      (homOfLE hOW).op (wcLdpH E N X ι G₀ G₁ (a, ε))) = 0 := by
    have h' : (s.appLE _ ⊤ hsO) ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
        (homOfLE hOW).op (wcLdpH E N X ι G₀ G₁ (a, ε))) = 0 := by
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      exact hkill
    exact h'
  have hβ : ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE U
      (g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ U ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε)) e).hom =
      (g.app (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ U ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε)).hom.comp
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE U
        (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ U ⊓
          Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε) inf_le_left).hom := by
    rw [← CommRingCat.hom_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
  have hρα : (s.appLE _ ⊤ hsO).hom.comp
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).appLE U
        (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ U ⊓
          Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε) inf_le_left).hom =
      (U.ι.appLE U ⊤ (Scheme.Opens.ι_preimage_self U).ge).hom := by
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE,
      hT6 _ _ hfst U ⊤ hsU.ge (Scheme.Opens.ι_preimage_self U).ge]
  rw [hβ]
  refine ringLem _ _ (s.appLE _ ⊤ hsO).hom _ hker hρ ?_
  rw [hρα]
  exact hinjU _ U _

theorem wc_ldpi_offaxis_iso (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Z : Scheme.{u}) (g : Z ⟶ Limits.pullback X.hom (wcProjKStr E 1)) (hg : IsClosedImmersion g)
    (hsec : ∀ (i : Fin (N + 1) × Fin 2) (O : (Limits.pullback X.hom (wcProjKStr E 1)).Opens),
      IsAffineOpen O → ∀ (hOW : O ≤ wcLdpW E N X ι i),
      Function.Surjective (g.app O).hom ∧
      RingHom.ker (g.app O).hom = Ideal.span {(Limits.pullback X.hom (wcProjKStr E 1)).presheaf.map
        (homOfLE hOW).op (wcLdpH E N X ι G₀ G₁ i)}) :
    ∃ V : X.left.Opens, (∀ x, x ∈ V ↔ ¬ wcLdpOnAxis E N ι G₀ G₁ x) ∧
      IsIso ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_ V) :=
by
  classical

  have hmem : ∀ x, x ∈ (⨆ p : Fin (N + 1) × Fin 2,
      X.left.basicOpen ((ι.app (wcSgD E N p.1)).hom (wcLdpSec E N (![G₀, G₁] p.2) p.1))) ↔
      ¬ wcLdpOnAxis E N ι G₀ G₁ x := by
    intro x
    rw [TopologicalSpace.Opens.mem_iSup]
    have hK : ∀ (a : Fin (N + 1)) (k : Fin 2) (hx : x ∈ ι ⁻¹ᵁ wcSgD E N a),
        x ∈ X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] k) a)) ↔
          IsUnit (wcLdpGerm E N ι (![G₀, G₁] k) a x hx) :=
      fun a k hx => Scheme.mem_basicOpen _ _ x hx
    constructor
    · rintro ⟨⟨a, ε⟩, hxU⟩ hOn
      have hx : x ∈ ι ⁻¹ᵁ wcSgD E N a := X.left.basicOpen_le _ hxU
      have hu := (hK a ε hx).mp hxU
      obtain ⟨h0, h1⟩ := hOn a hx
      have hm : wcLdpGerm E N ι (![G₀, G₁] ε) a x hx ∈ IsLocalRing.maximalIdeal _ := by
        fin_cases ε
        · exact h0
        · exact h1
      exact IsLocalRing.notMem_maximalIdeal.mpr hu hm
    · intro hOn
      simp only [wcLdpOnAxis, not_forall, not_and_or] at hOn
      obtain ⟨a, hx, h⟩ := hOn
      rcases h with h | h
      · exact ⟨(a, 0), (hK a 0 hx).mpr (IsLocalRing.notMem_maximalIdeal.mp h)⟩
      · exact ⟨(a, 1), (hK a 1 hx).mpr (IsLocalRing.notMem_maximalIdeal.mp h)⟩

  have hsup : ∀ {A B : Scheme.{u}} (f : A ⟶ B) {I : Type} (U : I → B.Opens),
      (∀ i, IsIso (f ∣_ U i)) → IsIso (f ∣_ ⨆ i, U i) := by
    intro A B f I U h
    rw [← MorphismProperty.isomorphisms.iff]
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme)
      (fun i => (⨆ i, U i).ι ⁻¹ᵁ U i) ?_ ?_
    · rw [← Scheme.Hom.preimage_iSup, Scheme.Opens.ι_preimage_self]
    · intro i
      have hEq : (⨆ i, U i).ι ''ᵁ ((⨆ i, U i).ι ⁻¹ᵁ U i) = U i := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr (le_iSup U i)
      exact ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict f _ _ ≪≫ morphismRestrictEq f hEq)).mpr
        ((MorphismProperty.isomorphisms.iff _).mpr (h i))

  have haffiso : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U : B.Opens) (V : A.Opens)
      (hV : f ⁻¹ᵁ U = V), IsAffineOpen U → IsAffineOpen V →
      Function.Bijective (f.appLE U V hV.ge).hom → IsIso (f ∣_ U) := by
    intro A B f U V hV hU hVa hb
    subst hV
    haveI : IsAffine U := hU
    haveI : IsAffine (f ⁻¹ᵁ U : A.Opens) := hVa
    have htop : IsIso (f ∣_ U).appTop := by
      rw [ConcreteCategory.isIso_iff_bijective]
      show Function.Bijective ((f ∣_ U).app ⊤).hom
      rw [Scheme.Hom.app_eq_appLE, morphismRestrict_appLE]
      exact (Scheme.Hom.appLE_congr f _ (Scheme.Opens.ι_image_top U)
        (by rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top])
        (fun φ => Function.Bijective (ConcreteCategory.hom φ))).mpr hb
    rw [← MorphismProperty.isomorphisms.iff]
    refine ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
      (arrowIsoSpecΓOfIsAffine (f ∣_ U))).mpr ?_
    exact (MorphismProperty.isomorphisms.iff _).mpr
      (inferInstance : IsIso (Spec.map (f ∣_ U).appTop))

  have haff : ∀ (n : ℕ) (J : Fin (n + 1)), IsAffineOpen (wcSgD E n J) := by
    intro n J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) E) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J))
      Nat.one_pos
  haveI := hι
  haveI := hg
  have hU : ∀ (a : Fin (N + 1)) (ε : Fin 2),
      IsAffineOpen (X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a))) :=
    fun a ε => ((haff N a).preimage ι).basicOpen _
  have hO : ∀ (a : Fin (N + 1)) (ε e : Fin 2), IsAffineOpen
      (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
        Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 e) := by
    intro a ε e
    have := (wc_closed_in_product_chart_gen (Spec (.of E)) X.left (wcProjK E 1)
      (Limits.pullback X.hom (wcProjKStr E 1)) X.hom (wcProjKStr E 1) (𝟙 _) _ (wcSgD E 1 e)
      (hU a ε) (haff 1 e)).1
    simpa only [Category.id_comp] using this

  have hS2 : ∀ J L : Fin (1 + 1),
      (wcProjK E 1).basicOpen (wcSgE E 1 J L) = wcSgD E 1 J ⊓ wcSgD E 1 L :=
    fun J L => (wc_ldpi_oai_sgE_facts E 1 J L).2
  have hone : ∀ J : Fin (1 + 1), wcSgE E 1 J J = 1 := fun J => (wc_ldpi_oai_sgE_facts E 1 J J).1
  have hS1 := wc_ldpi_oai_proj_gen E 1
  have hS3 := wc_ldpi_oai_proj_lift E 1

  have hchart : ∀ p : Fin (N + 1) × Fin 2, IsIso ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ∣_
      X.left.basicOpen ((ι.app (wcSgD E N p.1)).hom (wcLdpSec E N (![G₀, G₁] p.2) p.1))) := by
    rintro ⟨a, ε⟩
    have hcont := wc_ldpi_oai_snd_chart E N X ι G₀ G₁ Z g hsec a ε (hO a ε (ε + 1)) hS2
    have hV : (g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) ⁻¹ᵁ
          X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) =
        g ⁻¹ᵁ (Limits.pullback.fst X.hom (wcProjKStr E 1) ⁻¹ᵁ
            X.left.basicOpen ((ι.app (wcSgD E N a)).hom (wcLdpSec E N (![G₀, G₁] ε) a)) ⊓
          Limits.pullback.snd X.hom (wcProjKStr E 1) ⁻¹ᵁ wcSgD E 1 ε) :=
      le_antisymm (fun z hz => by exact ⟨hz, hcont hz⟩)
        (Scheme.Hom.preimage_mono g inf_le_left)
    have hΩ := (hO a ε ε).preimage g
    exact haffiso _ _ _ hV (hU a ε) hΩ
      ⟨wc_ldpi_oai_inj E N X ι G₀ G₁ Z g hsec a ε (hO a ε ε) hS3 hV.ge,
        wc_ldpi_oai_surj E N X ι G₀ G₁ Z g hg hsec a ε (hU a ε) (haff 1 ε) (hO a ε ε) hone hS1
          hV.ge⟩
  exact ⟨_, hmem, hsup _ _ hchart⟩

theorem wc_ldpi_rational_criterion (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (Yt : Over (Spec (.of E))) (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hg : IsClosedImmersion g) (hloc : wcLdpIncLocal E N X ι G₀ G₁ Yt g)
    (w w' : Yt.left) (c c' : Fin 2 → E) :
    ¬ wcLdpOnAxis E N ι G₀ G₁ ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w) →
    ¬ wcLdpOnAxis E N ι G₀ G₁ ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w') →
    wcLdpZero E N ι (c 1 • G₀ - c 0 • G₁) ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w) →
    wcLdpZero E N ι (c' 1 • G₀ - c' 0 • G₁) ((g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1)) w') →
    (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) w =
      (g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1)) w' →
    c 0 * c' 1 - c 1 * c' 0 = 0 :=
by
  classical

  have hcc : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of E)) (y : A),
      wcLdpConst E (f ≫ s) y = (f.stalkMap y).hom.comp (wcLdpConst E s (f y)) := by
    intro A B f s y
    ext r
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact (Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial _).symm

  have s1 : ∀ {Y : Scheme.{u}} (κ : Y ⟶ wcProjK E N)
      (G G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) (c d : E) (a : Fin (N + 1))
      (x : Y) (hx : x ∈ κ ⁻¹ᵁ wcSgD E N a),
      wcLdpGerm E N κ (c • G - d • G') a x hx =
        wcLdpConst E (κ ≫ wcProjKStr E N) x c * wcLdpGerm E N κ G a x hx -
          wcLdpConst E (κ ≫ wcProjKStr E N) x d * wcLdpGerm E N κ G' a x hx := by
    intro Y κ G G' c d a x hx
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) :=
      MvPolynomial.gradedAlgebra
    have hXa : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) E) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)

    have hA : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (hXa a) 2 ((c • G - d • G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
            MvPolynomial (Fin (N + 1)) E) (c • G - d • G').2 =
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) c) *
          HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (hXa a) 2 (G : MvPolynomial (Fin (N + 1)) E) G.2 -
        HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) d) *
          HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (hXa a) 2 (G' : MvPolynomial (Fin (N + 1)) E) G'.2 := by
      apply HomogeneousLocalization.val_injective
      have hZ : ∀ r : E, (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (Submonoid.powers (MvPolynomial.X a))
          (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) r)).val =
          algebraMap (MvPolynomial (Fin (N + 1)) E)
            (Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E)))
            (MvPolynomial.C r) := by
        intro r
        rw [← Localization.mk_one_eq_algebraMap]
        have e : ((algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) r :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0)) :
              MvPolynomial (Fin (N + 1)) E) = MvPolynomial.C r := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← e]
        rfl
      have hmk : ∀ (p : MvPolynomial (Fin (N + 1)) E)
          (s : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E)),
          Localization.mk p s = algebraMap (MvPolynomial (Fin (N + 1)) E)
            (Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E))) p *
            Localization.mk 1 s := by
        intro p s
        rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, mul_one, one_mul]
      have hcoe : ((c • G - d • G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
          MvPolynomial (Fin (N + 1)) E) =
          MvPolynomial.C c * (G : MvPolynomial (Fin (N + 1)) E) -
            MvPolynomial.C d * (G' : MvPolynomial (Fin (N + 1)) E) := by
        rw [Submodule.coe_sub, Submodule.coe_smul, Submodule.coe_smul, MvPolynomial.smul_eq_C_mul,
          MvPolynomial.smul_eq_C_mul]
      rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hZ, hZ, hcoe,
        hmk (MvPolynomial.C c * (G : MvPolynomial (Fin (N + 1)) E) -
          MvPolynomial.C d * (G' : MvPolynomial (Fin (N + 1)) E)),
        hmk (G : MvPolynomial (Fin (N + 1)) E), hmk (G' : MvPolynomial (Fin (N + 1)) E),
        map_sub, map_mul, map_mul]
      ring

    have hιt : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)).Opens) b,
        U.ι.appTop b = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)).presheaf.map
          (homOfLE (le_top : U ≤ ⊤)).op b) := by
      intro U b
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ r : E, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
        (MvPolynomial.X a)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0) r)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)).presheaf.map
          (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (MvPolynomial.X a)) ≤ ⊤)).op).hom
          ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) ≫
            Spec.map (CommRingCat.ofHom (algebraMap E
              ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) 0)))).appTop.hom
            ((Scheme.ΓSpecIso (.of E)).inv.hom r)) := by
      intro r
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X a) (hXa a) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X a) (hXa a) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) ≫
            Spec.map (CommRingCat.ofHom (algebraMap E
              ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X a) (hXa a) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
                (Submonoid.powers (MvPolynomial.X a))).comp
              (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g =>
        (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom r) (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap E ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X a) (hXa a) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (MvPolynomial.X a)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
              (MvPolynomial.X a)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)))).hom ≫
              Proj.awayToSection _ (MvPolynomial.X a) ≫
              (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
                (MvPolynomial.X a)).topIso.inv)
              ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)))).inv y) := by
              rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
                (MvPolynomial.X a)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X a))
                ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hιt] at e4
      have hinj : ∀ b b' : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E),
          Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) (MvPolynomial.X a)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
            (MvPolynomial.X a)).topIso.inv b =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
              (MvPolynomial.X a)).topIso.inv b' → b = b' := by
        intro b b' h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule
          (Fin (N + 1)) E) (MvPolynomial.X a)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm

    have hsec : wcLdpSec E N (c • G - d • G') a =
        ((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
            ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom c)) *
          wcLdpSec E N G a -
        ((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
            ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom d)) *
          wcLdpSec E N G' a := by
      show (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (MvPolynomial.X a)).hom
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E)
          (hXa a) 2 ((c • G - d • G' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2) :
            MvPolynomial (Fin (N + 1)) E) (c • G - d • G').2) = _
      rw [hA, map_sub, map_mul, map_mul, hconst, hconst]
      rfl

    have hk : ∀ r : E, (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a) x hx).hom ((κ.app (wcSgD E N a)).hom
        (((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
          ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)))) =
        wcLdpConst E (κ ≫ wcProjKStr E N) x r := by
      intro r
      have f1 := Scheme.Hom.germ_stalkMap_apply κ (wcSgD E N a) x hx
        (((wcProjK E N).presheaf.map (homOfLE (le_top : wcSgD E N a ≤ ⊤)).op).hom
          ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r)))
      have f2 := TopCat.Presheaf.germ_res_apply (wcProjK E N).presheaf
        (homOfLE (le_top : wcSgD E N a ≤ ⊤)) (κ x) hx
        ((wcProjKStr E N).appTop.hom ((Scheme.ΓSpecIso (.of E)).inv.hom r))
      rw [hcc]
      exact f1.symm.trans (congrArg (κ.stalkMap x).hom f2)
    show (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a) x hx).hom
        ((κ.app (wcSgD E N a)).hom (wcLdpSec E N (c • G - d • G') a)) =
      wcLdpConst E (κ ≫ wcProjKStr E N) x c * (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a) x hx).hom
        ((κ.app (wcSgD E N a)).hom (wcLdpSec E N G a)) -
      wcLdpConst E (κ ≫ wcProjKStr E N) x d * (Y.presheaf.germ (κ ⁻¹ᵁ wcSgD E N a) x hx).hom
        ((κ.app (wcSgD E N a)).hom (wcLdpSec E N G' a))
    rw [hsec]
    simp only [map_sub, map_mul]
    rw [hk, hk]

  have s2 : ∀ {A B S : Type u} [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      [CommRing S] [IsLocalRing S] (δ : A →+* S) [IsLocalHom δ] (ε : B →+* S) [IsLocalHom ε]
      (κA : E →+* A) (κB : E →+* B), (∀ r, δ (κA r) = ε (κB r)) →
      ∀ (u0 u1 : A) (s : B), δ u1 = ε s * δ u0 → (IsUnit u0 ∨ IsUnit u1) →
      ∀ (c0 c1 : E), κA c1 * u0 - κA c0 * u1 ∈ IsLocalRing.maximalIdeal A →
      κB c1 - κB c0 * s ∈ IsLocalRing.maximalIdeal B := by
    intro A B S _ _ _ _ _ _ δ _ ε _ κA κB hκ u0 u1 s heq hu c0 c1 hzA
    have hv0 : IsUnit (δ u0) := by
      rcases hu with h | h
      · exact h.map δ
      · have h1 : IsUnit (δ u1) := h.map δ
        rw [heq] at h1
        exact isUnit_of_mul_isUnit_right h1
    have hS : δ (κA c1 * u0 - κA c0 * u1) ∈ IsLocalRing.maximalIdeal S := by
      rw [IsLocalRing.mem_maximalIdeal] at hzA ⊢
      exact (map_mem_nonunits_iff δ _).mpr hzA
    have hfac : δ (κA c1 * u0 - κA c0 * u1) = δ u0 * ε (κB c1 - κB c0 * s) := by
      rw [map_sub, map_mul, map_mul, hκ, hκ, heq, map_sub, map_mul]
      ring
    rw [hfac] at hS
    have h2 : ε (κB c1 - κB c0 * s) ∈ IsLocalRing.maximalIdeal S := by
      by_contra hc
      rw [IsLocalRing.notMem_maximalIdeal] at hc
      exact (IsLocalRing.notMem_maximalIdeal.mpr (hv0.mul hc)) hS
    rw [IsLocalRing.mem_maximalIdeal] at h2 ⊢
    exact (map_mem_nonunits_iff ε _).mp h2

  have s3 : ∀ {B : Type u} [CommRing B] [IsLocalRing B] (κ : E →+* B) (s : B) (c0 c1 c0' c1' : E),
      κ c1 - κ c0 * s ∈ IsLocalRing.maximalIdeal B →
      κ c1' - κ c0' * s ∈ IsLocalRing.maximalIdeal B → c0 * c1' - c1 * c0' = 0 := by
    intro B _ _ κ s c0 c1 c0' c1' h h'
    by_contra hD
    have hm : κ (c0 * c1' - c1 * c0') ∈ IsLocalRing.maximalIdeal B := by
      have e : κ (c0 * c1' - c1 * c0') =
          κ c0 * (κ c1' - κ c0' * s) - κ c0' * (κ c1 - κ c0 * s) := by
        rw [map_sub, map_mul, map_mul]
        ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ h') (Ideal.mul_mem_left _ _ h)
    exact IsLocalRing.notMem_maximalIdeal.mpr ((Ne.isUnit hD).map κ) hm

  have key : ∀ (v : Yt.left) (cc : Fin 2 → E),
      ¬ wcLdpOnAxis E N ι G₀ G₁ (Limits.pullback.fst X.hom (wcProjKStr E 1) (g v)) →
      wcLdpZero E N ι (cc 1 • G₀ - cc 0 • G₁) (Limits.pullback.fst X.hom (wcProjKStr E 1) (g v)) →
      ∀ (q : wcProjK E 1) (_ : Limits.pullback.snd X.hom (wcProjKStr E 1) (g v) = q)
        (e : Fin 2) (he : q ∈ wcSgD E 1 e),
      wcLdpConst E (wcProjKStr E 1) q (cc (e + 1)) -
          wcLdpConst E (wcProjKStr E 1) q (cc e) *
            ((wcProjK E 1).presheaf.germ (wcSgD E 1 e) q he).hom (wcSgE E 1 e (e + 1)) ∈
        IsLocalRing.maximalIdeal ((wcProjK E 1).presheaf.stalk q) := by
    intro v cc hoffv hzv q hq e he
    subst hq
    simp only [wcLdpOnAxis, not_forall, not_and_or] at hoffv
    obtain ⟨a, ha, hab⟩ := hoffv
    have hz0 := hzv a ha
    rw [s1, hιX] at hz0
    obtain ⟨-, hker⟩ := hloc v a ha e he
    have hK := RingHom.mem_ker.mp ((Ideal.span_singleton_le_iff_mem _).mp hker.ge)
    rw [map_sub, map_mul, sub_eq_zero] at hK
    have hκ : ∀ r : E, (g.stalkMap v).hom
        (((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g v)).hom
          (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g v)) r)) =
        (g.stalkMap v).hom (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g v)).hom
          (wcLdpConst E (wcProjKStr E 1) (Limits.pullback.snd X.hom (wcProjKStr E 1) (g v)) r)) := by
      intro r
      have h1 := RingHom.congr_fun (hcc (Limits.pullback.fst X.hom (wcProjKStr E 1)) X.hom (g v)) r
      have h2 := RingHom.congr_fun
        (hcc (Limits.pullback.snd X.hom (wcProjKStr E 1)) (wcProjKStr E 1) (g v)) r
      rw [RingHom.comp_apply] at h1 h2
      rw [← h1, ← h2, Limits.pullback.condition]
    have hunit : IsUnit (wcLdpGerm E N ι G₀ a _ ha) ∨ IsUnit (wcLdpGerm E N ι G₁ a _ ha) := by
      rcases hab with h | h
      · exact Or.inl (IsLocalRing.notMem_maximalIdeal.mp h)
      · exact Or.inr (IsLocalRing.notMem_maximalIdeal.mp h)
    haveI : IsLocalHom ((g.stalkMap v).hom.comp
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g v)).hom) :=
      RingHom.isLocalHom_comp _ _
    haveI : IsLocalHom ((g.stalkMap v).hom.comp
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g v)).hom) :=
      RingHom.isLocalHom_comp _ _
    obtain rfl | rfl : e = 0 ∨ e = 1 := by fin_cases e <;> simp
    · exact s2 ((g.stalkMap v).hom.comp
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g v)).hom)
        ((g.stalkMap v).hom.comp
          ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g v)).hom)
        (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g v)))
        (wcLdpConst E (wcProjKStr E 1) (Limits.pullback.snd X.hom (wcProjKStr E 1) (g v))) hκ
        (wcLdpGerm E N ι G₀ a _ ha) (wcLdpGerm E N ι G₁ a _ ha)
        (((wcProjK E 1).presheaf.germ (wcSgD E 1 0) _ he).hom (wcSgE E 1 0 (0 + 1)))
        hK hunit (cc 0) (cc 1) hz0
    · have hz1 := neg_mem hz0
      rw [neg_sub] at hz1
      exact s2 ((g.stalkMap v).hom.comp
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap (g v)).hom)
        ((g.stalkMap v).hom.comp
          ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap (g v)).hom)
        (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) (g v)))
        (wcLdpConst E (wcProjKStr E 1) (Limits.pullback.snd X.hom (wcProjKStr E 1) (g v))) hκ
        (wcLdpGerm E N ι G₁ a _ ha) (wcLdpGerm E N ι G₀ a _ ha)
        (((wcProjK E 1).presheaf.germ (wcSgD E 1 1) _ he).hom (wcSgE E 1 1 (1 + 1)))
        hK hunit.symm (cc 1) (cc 0) hz1

  have hcov : (⨆ e : Fin (1 + 1), wcSgD E 1 e) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) E) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    rw [MvPolynomial.mem_support_iff] at hm
    have hne : m ≠ 0 := by
      rintro rfl
      exact hm h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  intro hoff hoff' hz hz' hq
  simp only [Scheme.Hom.comp_apply] at hoff hoff' hz hz' hq
  have hqt : Limits.pullback.snd X.hom (wcProjKStr E 1) (g w) ∈ (⨆ e : Fin (1 + 1), wcSgD E 1 e) := by
    rw [hcov]; trivial
  obtain ⟨e, he⟩ := TopologicalSpace.Opens.mem_iSup.mp hqt
  have h1 := key w c hoff hz _ rfl e he
  have h2 := key w' c' hoff' hz' _ hq.symm e he
  obtain rfl | rfl : e = 0 ∨ e = 1 := by fin_cases e <;> simp
  · exact s3 (wcLdpConst E (wcProjKStr E 1) (Limits.pullback.snd X.hom (wcProjKStr E 1) (g w))) _
      (c 0) (c 1) (c' 0) (c' 1) h1 h2
  · have h3 := s3 (wcLdpConst E (wcProjKStr E 1) (Limits.pullback.snd X.hom (wcProjKStr E 1) (g w)))
      _ (c 1) (c 0) (c' 1) (c' 0) h1 h2
    linear_combination -h3

theorem wc_ldpi_fh_proj_base_change_sections (E Ω : Type u) [Field E] [Field Ω] [Algebra E Ω]
    (N : ℕ) :
    ∃ (pm : wcProjK Ω N ⟶ wcProjK E N)
      (hpre : ∀ a : Fin (N + 1), pm ⁻¹ᵁ wcSgD E N a = wcSgD Ω N a),
      IsPullback pm (wcProjKStr Ω N) (wcProjKStr E N)
          (Spec.map (CommRingCat.ofHom (algebraMap E Ω))) ∧
        ∀ (a : Fin (N + 1)) (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2),
          (pm.appLE (wcSgD E N a) (wcSgD Ω N a) (hpre a).ge).hom (wcLdpSec E N G a) =
            wcLdpSec Ω N (wcLdpMapQ E Ω N G) a :=
by
  suffices PBC : ∀ (F F' : Type u) [Field F] [Field F'] [Algebra F F'] (N : ℕ),
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F))
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F'))
      ∃ (f : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F →+*ᵍ
            MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
        (hf : HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≤
          HomogeneousIdeal.map f
            (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F))),
        (∀ p, f p = MvPolynomial.map (algebraMap F F') p) ∧
        IsPullback (Proj.map f hf)
          (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
          (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
          (Spec.map (CommRingCat.ofHom (algebraMap F F'))) by
    have htop : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), ⊤ ≤ g ⁻¹ᵁ ⊤ := fun g =>
      le_of_eq (Scheme.Hom.preimage_top g).symm
    have H1 : ∀ {X Y : Scheme.{u}} (g g' : X ⟶ Y) (hg : g = g') (U : Y.Opens) (V : X.Opens)
        (e : V ≤ g ⁻¹ᵁ U), g.appLE U V e = g'.appLE U V (hg ▸ e) := by
      intro X Y g g' hg U V e
      subst hg
      rfl
    have H2 : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (e : ⊤ ≤ g ⁻¹ᵁ ⊤), g.appLE ⊤ ⊤ e = g.appTop := by
      intro X Y g e
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      rfl
    have ΓI : ∀ (R : CommRingCat.{u}) (y : R),
        (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom y) = y := by
      intro R y
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
        RingHom.id_apply]

    have chart : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
        (𝒜 : ℕ → σ) [GradedRing 𝒜] (c : A) {m : ℕ} (hc : c ∈ 𝒜 m) (hm : 0 < m)
        (e : ⊤ ≤ Proj.awayι 𝒜 c hc hm ⁻¹ᵁ Proj.basicOpen 𝒜 c)
        (x : HomogeneousLocalization.Away 𝒜 c),
        ((Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ e).hom
            ((Proj.awayToSection 𝒜 c).hom x) =
          (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 c))).inv.hom x := by
      intro σ A _ _ _ 𝒜 _ c m hc hm e x
      have hi : ∀ y, (Proj.basicOpenIsoSpec 𝒜 c hc hm).hom.appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 c))).inv.hom y) =
          (Proj.basicOpen 𝒜 c).topIso.inv.hom ((Proj.awayToSection 𝒜 c).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom, Scheme.Hom.appTop, Proj.basicOpenToSpec_app_top]
        simp only [CommRingCat.hom_comp, RingHom.comp_apply]
        rw [ΓI]
      have e1 : (Proj.awayι 𝒜 c hc hm).appLE (Proj.basicOpen 𝒜 c) ⊤ e =
          (Proj.basicOpen 𝒜 c).ι.appLE (Proj.basicOpen 𝒜 c) ⊤
              (Scheme.Opens.ι_preimage_self (Proj.basicOpen 𝒜 c)).symm.le ≫
            (Proj.basicOpenIsoSpec 𝒜 c hc hm).inv.appLE ⊤ ⊤ (htop _) := by
        rw [Scheme.Hom.appLE_comp_appLE, H1 _ _ (Proj.basicOpenIsoSpec_inv_ι 𝒜 c hc hm).symm]
      have e2 : (Proj.basicOpen 𝒜 c).ι.appLE (Proj.basicOpen 𝒜 c) ⊤
          (Scheme.Opens.ι_preimage_self (Proj.basicOpen 𝒜 c)).symm.le =
          (Proj.basicOpen 𝒜 c).topIso.inv := by
        rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
        rfl
      rw [e1, e2, H2, CommRingCat.hom_comp, RingHom.comp_apply, ← hi, ← RingHom.comp_apply,
        ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop,
        CommRingCat.hom_id, RingHom.id_apply]

    have sec : ∀ {A B σ τ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
        [CommRing B] [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ}
        [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
        (hf : HomogeneousIdeal.irrelevant ℬ ≤
          HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜))
        (s : A) (t : B) (hst : f s = t) {m : ℕ} (hs : s ∈ 𝒜 m) (ht : t ∈ ℬ m) (hm : 0 < m)
        (h : Proj.basicOpen ℬ t ≤ Proj.map f hf ⁻¹ᵁ Proj.basicOpen 𝒜 s)
        (n : ℕ) (a : A) (ha : a ∈ 𝒜 (n • m)),
        ((Proj.map f hf).appLE (Proj.basicOpen 𝒜 s) (Proj.basicOpen ℬ t) h).hom
            ((Proj.awayToSection 𝒜 s).hom (HomogeneousLocalization.Away.mk 𝒜 hs n a ha)) =
          (Proj.awayToSection ℬ t).hom
            (HomogeneousLocalization.Away.mk ℬ ht n (f a) (f.map_mem ha)) := by
      intro A B σ τ _ _ _ _ _ _ 𝒜 ℬ _ _ f hf s t hst m hs ht hm h n a ha
      subst hst
      have eB : ⊤ ≤ Proj.awayι ℬ (f s) ht hm ⁻¹ᵁ Proj.basicOpen ℬ (f s) := by
        intro z _
        show Proj.awayι ℬ (f s) ht hm z ∈ Proj.basicOpen ℬ (f s)
        rw [← Proj.opensRange_awayι ℬ (f s) ht hm]
        exact ⟨z, rfl⟩
      have eA : ⊤ ≤ Proj.awayι 𝒜 s hs hm ⁻¹ᵁ Proj.basicOpen 𝒜 s := by
        intro z _
        show Proj.awayι 𝒜 s hs hm z ∈ Proj.basicOpen 𝒜 s
        rw [← Proj.opensRange_awayι 𝒜 s hs hm]
        exact ⟨z, rfl⟩
      have inj : ∀ z₁ z₂ : Γ(Proj ℬ, Proj.basicOpen ℬ (f s)),
          ((Proj.awayι ℬ (f s) ht hm).appLE (Proj.basicOpen ℬ (f s)) ⊤ eB).hom z₁ =
            ((Proj.awayι ℬ (f s) ht hm).appLE (Proj.basicOpen ℬ (f s)) ⊤ eB).hom z₂ →
              z₁ = z₂ := by
        have hsur : ∀ z : Γ(Proj ℬ, Proj.basicOpen ℬ (f s)), ∃ y,
            (Proj.awayToSection ℬ (f s)).hom y = z := by
          intro z
          refine ⟨(Proj.basicOpenIsoAway ℬ (f s) ht hm).inv.hom z, ?_⟩
          rw [← Proj.basicOpenIsoAway_hom ℬ (f s) ht hm, ← RingHom.comp_apply,
            ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id, RingHom.id_apply]
        intro z₁ z₂ hz
        obtain ⟨y₁, rfl⟩ := hsur z₁
        obtain ⟨y₂, rfl⟩ := hsur z₂
        rw [chart, chart] at hz
        have hz' := congrArg (Scheme.ΓSpecIso _).hom.hom hz
        rw [ΓI, ΓI] at hz'
        rw [hz']
      apply inj
      rw [chart]
      have c1 := congrArg (fun φ => φ.hom ((Proj.awayToSection 𝒜 s).hom
          (HomogeneousLocalization.Away.mk 𝒜 hs n a ha)))
        (Scheme.Hom.appLE_comp_appLE (Proj.awayι ℬ (f s) ht hm) (Proj.map f hf)
          (Proj.basicOpen 𝒜 s) (Proj.basicOpen ℬ (f s)) ⊤ h eB)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at c1
      rw [c1, H1 _ _ (Proj.awayι_comp_map f hf hm s hs)]
      have c2 := congrArg (fun φ => φ.hom ((Proj.awayToSection 𝒜 s).hom
          (HomogeneousLocalization.Away.mk 𝒜 hs n a ha)))
        (Scheme.Hom.appLE_comp_appLE
          (Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f s)))
          (Proj.awayι 𝒜 s hs hm) (Proj.basicOpen 𝒜 s) ⊤ ⊤ eA (htop _))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at c2
      refine c2.symm.trans ?_
      rw [chart, H2]
      have c3 := congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk 𝒜 hs n a ha))
        (Scheme.ΓSpecIso_inv_naturality
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f s)))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at c3
      rw [← c3, HomogeneousLocalization.Away.map_mk]

    obtain ⟨f, hf, hfmap, H⟩ := PBC E Ω N
    letI iE : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E) :=
      MvPolynomial.gradedAlgebra
    letI iΩ : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
      MvPolynomial.gradedAlgebra
    have hXE : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) E) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 1 := fun a =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X E a)
    have hXΩ : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 := fun a =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)
    have hfX : ∀ a : Fin (N + 1), f (MvPolynomial.X a) = MvPolynomial.X a := fun a => by
      rw [hfmap, MvPolynomial.map_X]
    have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ wcSgD E N a = wcSgD Ω N a := fun a => by
      show Proj.map f hf ⁻¹ᵁ Proj.basicOpen _ (MvPolynomial.X a) =
        Proj.basicOpen _ (MvPolynomial.X a)
      rw [Proj.map_preimage_basicOpen, hfX]
    refine ⟨Proj.map f hf, hpre, H, ?_⟩
    intro a G
    have hG : (G : MvPolynomial (Fin (N + 1)) E) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E (2 • 1) := by
      simpa only [smul_eq_mul, mul_one] using G.2
    have key := sec f hf (MvPolynomial.X a) (MvPolynomial.X a) (hfX a) (hXE a) (hXΩ a)
