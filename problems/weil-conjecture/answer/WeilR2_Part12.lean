    rw [hTU, hTY, hP]
    simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    rw [hRΨ]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
    rw [hdeg]



  have h0' : (Abelian.Ext.mk₀ Dz.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dz.Φ x).comp
      (Abelian.Ext.mk₀ νz) (add_zero q)) (zero_add q) = 0 := h0
  have key : wcIntRedTr (Limits.pullback (W₀.fromSpecStalk z) g) ℓ k q (wcZModPull Dk q h) =
      ((Abelian.Ext.mk₀ Dz.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dz.Φ x).comp
        (Abelian.Ext.mk₀ νz) (add_zero q)) (zero_add q)).comp (Abelian.Ext.mk₀ cU)
        (add_zero q) := by
