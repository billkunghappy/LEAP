      Abelian.Ext.mk₀_comp_mk₀, hι']

  have hcancel : ∀ {Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (e : Y ≅ Z) (p : ℕ)
      (a b : Abelian.Ext (wcFreeSheaf S
          (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt)) Y p),
      a.comp (Abelian.Ext.mk₀ e.hom) (add_zero p) =
        b.comp (Abelian.Ext.mk₀ e.hom) (add_zero p) → a = b := by
    intro Y Z e p a b hab
    have := congrArg (fun w => w.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)) hab
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.comp_mk₀_id] at this
    exact this
  have hinvhom : ∀ {Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (e : Y ≅ Z) (p : ℕ)
      (a : Abelian.Ext (wcFreeSheaf S
          (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt)) Z p),
      (a.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)).comp (Abelian.Ext.mk₀ e.hom) (add_zero p) = a := by
    intro Y Z e p a
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.comp_mk₀_id]

  have hqc : QuasiCompact f := inferInstance
  have hqs : QuasiSeparated f := inferInstance
  have hcpt : CompactSpace ↥S :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ f hqc _
  have hqsp : QuasiSeparatedSpace ↥S :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ f _ hqs
  haveI hT1 : CompactSpace
      (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt).left := hcpt
  haveI hT2 : QuasiSeparatedSpace
      (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt).left := hqsp
  refine ⟨ι, ?_, ?_, ?_⟩
  ·
    intro i j k hk x y
    apply (hΦb k).1
    rw [hι]
    have hcup : wcHMCup S ℓ i j k hk (ι i x) (ι j y) = (ι i x).comp (ι j y) hk := by
      simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
    rw [hcup, hΦ, hΨ, Abelian.Ext.mapExactFunctor_comp,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)))
        _ _ (zero_add i) hk (by omega),
      ← hΦ i (ι i x), hι i x, hΨ i x, Abelian.Ext.comp_assoc_of_second_deg_zero,
      ← hΦ j (ι j y), hι j y, hΨ j y]
    exact Abelian.Ext.comp_assoc_of_third_deg_zero x y _ hk
  ·
    intro p z
    obtain ⟨n, yv, hyv⟩ := (proet_qcqs_ladic_rationalization S
      (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt) ℓ p).1
      ((BB p (Φ p z)).comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero p))
    obtain ⟨a, ha⟩ := (hBAb p).2 (yv.comp (Abelian.Ext.mk₀ ιZ.inv) (add_zero p))
    refine ⟨n, a, ?_⟩
    apply (hΦb p).1
    rw [hι, map_nsmul]
    apply (hBBb p).1
    apply hcancel ιQ' p
    have e5 : (ℓ ^ n • BB p (Φ p z)).comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero p) =
        ℓ ^ n • (BB p (Φ p z)).comp (Abelian.Ext.mk₀ ιQ'.hom) (add_zero p) :=
      map_nsmul ((Abelian.Ext.mk₀ ιQ'.hom).postcomp _ (add_zero p)) (ℓ ^ n) (BB p (Φ p z))
    rw [K3, ha, hinvhom, map_nsmul, e5, hyv]
  ·
    intro p x hx
    have hΨ0 : Ψ p x = 0 := by rw [← hι, hx, map_zero]
    have hwz : ((BA p x).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero p)).comp
        (Abelian.Ext.mk₀ (wcIntToLadic S ℓ)) (add_zero p) = 0 := by
      rw [← K3, hΨ0, map_zero, Abelian.Ext.zero_comp]
    obtain ⟨r, hr⟩ := (proet_qcqs_ladic_rationalization S
      (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance : S.ProEt) ℓ p).2 _ hwz
    refine ⟨r, ?_⟩
    have e4 : (ℓ ^ r • BA p x).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero p) =
        ℓ ^ r • (BA p x).comp (Abelian.Ext.mk₀ ιZ.hom) (add_zero p) :=
      map_nsmul ((Abelian.Ext.mk₀ ιZ.hom).postcomp _ (add_zero p)) (ℓ ^ r) (BA p x)
    apply (hBAb p).1
    apply hcancel ιZ p
    rw [map_nsmul, e4, hr]
    simp only [map_zero, Abelian.Ext.zero_comp]

theorem wc_hm_int_tors_duality_right (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (a b N : ℕ) (hab : a + b = N) (hN : N = 2 * n) (m : ℕ) (hm : 1 ≤ m) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
    ∀ β : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) b,
      ℓ ^ (m - 1) • β.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
        (add_zero b) ≠ 0 →
      ∃ c : Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) a,
        ∀ (e : ℕ) (α : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) a), e < m →
          α.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
            (add_zero a) = ℓ ^ e • c →
          ℓ ^ (m - 1 - e) • α.comp (β.comp (Abelian.Ext.mk₀
            (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero b)) hab ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))) := HasExt.standard _

  have hℓpos : (0 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
  have hρc : Continuous (PadicInt.toZModPow (p := ℓ) m) := by
    rw [continuous_discrete_rng]
    intro b
    rw [Metric.isOpen_iff]
    intro y hy
    refine ⟨(ℓ : ℝ) ^ (-(m : ℤ)), zpow_pos hℓpos _, ?_⟩
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    have h1 : z - y ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ m} :=
      (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mp hz.le
    rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hy ⊢
    rw [h1, hy]
  have hdiv : ∀ (T : Type u) [TopologicalSpace T] (g : C(T, ℤ_[ℓ])),
      (∀ t, PadicInt.toZModPow m (g t) = 0) →
      ∃ c : C(T, ℤ_[ℓ]), ∀ t, g t = (ℓ : ℤ_[ℓ]) ^ m * c t := by
    intro T _ g hg
    have hl : ((ℓ : ℚ_[ℓ]) ^ m) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    have hb : ∀ t, ‖((g t : ℚ_[ℓ])) / (ℓ : ℚ_[ℓ]) ^ m‖ ≤ 1 := by
      intro t
      have h1 : g t ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ m} := by
        rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]; exact hg t
      have h2 := (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mpr h1
      rw [PadicInt.norm_def] at h2
      rw [norm_div, Padic.norm_p_pow]
      exact (div_le_one (zpow_pos hℓpos _)).mpr h2
    refine ⟨⟨fun t => (⟨(g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ m, hb t⟩ : ℤ_[ℓ]),
      Continuous.subtype_mk ((continuous_subtype_val.comp g.continuous).div_const _) hb⟩, ?_⟩
    intro t
    apply PadicInt.ext
    rw [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
    change (g t : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ m * ((g t : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ m)
    field_simp
  let g : ULift.{u+1} ℤ_[ℓ] →+* ULift.{u+1} (ZMod (ℓ ^ m)) :=
    (ULift.ringEquiv.{0, u+1} (R := ZMod (ℓ ^ m))).symm.toRingHom.comp
      ((PadicInt.toZModPow (p := ℓ) m).comp (ULift.ringEquiv.{0, u+1} (R := ℤ_[ℓ])).toRingHom)
  have hg : Continuous g := continuous_uliftUp.comp (hρc.comp continuous_uliftDown)
  let φ₀ : wcIntRingPresheaf.{u} ℓ ⟶ wcZModRingPresheaf.{u} (ℓ ^ m) :=
    { app := fun S => RingCat.ofHom (RingHom.compLeftContinuous (↥(Opposite.unop S)) g hg)
      naturality := fun _ _ _ => rfl }
  let φ : wcIntRingSheaf Y ℓ ⟶ wcZModRingSheaf Y (ℓ ^ m) :=
    ((Scheme.ProEt.forget Y ⋙ Over.forget Y).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology Y) Scheme.proetaleTopology).map (ObjectProperty.homMk φ₀)
  have hT : ∀ (V : (Y.ProEt)ᵒᵖ) (r : (wcIntRingSheaf Y ℓ).obj.obj V),
      (ℓ ^ m) • r = 0 → r = 0 := by
    intro V r hr
    let f : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) := r
    have hpt : ∀ t, (ℓ ^ m : ℕ) • (f t).down = 0 := by
      intro t
      have := congrArg
        (fun z : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) => (z t).down) hr
      exact this
    have h0 : ∀ t, (f t).down = 0 := by
      intro t
      have := hpt t
      rw [nsmul_eq_mul] at this
      refine (mul_eq_zero.mp this).resolve_left ?_
      rw [Nat.cast_pow]
      exact pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    change f = 0
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    exact h0 t
  have hS : ∀ (V : (Y.ProEt)ᵒᵖ) (r' : (wcZModRingSheaf Y (ℓ ^ m)).obj.obj V),
      ∃ r : (wcIntRingSheaf Y ℓ).obj.obj V, (φ.hom.app V).hom r = r' := by
    intro V r'
    let f' : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m))) := r'
    let f : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun t => ULift.up (((f' t).down.val : ℕ) : ℤ_[ℓ]),
        (continuous_of_discreteTopology (f := fun b : ULift.{u+1} (ZMod (ℓ ^ m)) =>
          (ULift.up (((b.down).val : ℕ) : ℤ_[ℓ]) : ULift.{u+1} ℤ_[ℓ]))).comp f'.continuous⟩
    refine ⟨f, ?_⟩
    change RingHom.compLeftContinuous (↥(Opposite.unop V).left) g hg f = f'
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    change PadicInt.toZModPow m (((f' t).down.val : ℕ) : ℤ_[ℓ]) = (f' t).down
    rw [map_natCast, ZMod.natCast_zmod_val]
  have hK : ∀ (V : (Y.ProEt)ᵒᵖ) (r : (wcIntRingSheaf Y ℓ).obj.obj V),
      (φ.hom.app V).hom r = 0 → ∃ s : (wcIntRingSheaf Y ℓ).obj.obj V, r = (ℓ ^ m) • s := by
    intro V r hr
    let f : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) := r
    have hx : ∀ t, PadicInt.toZModPow m (f t).down = 0 := by
      intro t
      have := congrArg
        (fun z : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m))) => (z t).down) hr
      exact this
    obtain ⟨c, hc⟩ := hdiv _ ⟨fun t => (f t).down, continuous_uliftDown.comp f.continuous⟩ hx
    let s : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) :=
      ⟨fun t => ULift.up (c t), continuous_uliftUp.comp c.continuous⟩
    refine ⟨s, ?_⟩
    change f = (ℓ ^ m) • s
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    change (f t).down = (ℓ ^ m) • c t
    rw [nsmul_eq_mul, Nat.cast_pow]
    exact hc t
  have hZ : ∀ V : (Y.ProEt)ᵒᵖ, ((ℓ ^ m : ℕ) : (wcZModRingSheaf Y (ℓ ^ m)).obj.obj V) = 0 := by
    intro V
    change ((ℓ ^ m : ℕ) : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod (ℓ ^ m)))) = 0
    apply ContinuousMap.ext
    intro t
    apply ULift.ext
    change ((ℓ ^ m : ℕ) : ZMod (ℓ ^ m)) = 0
    exact ZMod.natCast_self _

  obtain ⟨hPL, hPC⟩ : Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ) ∧
      Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ) := by
    let e : SheafOfModules.restrictScalars.{u+1} φ ⋙
        SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ) ≅
        SheafOfModules.toSheaf (wcZModRingSheaf Y (ℓ ^ m)) :=
      NatIso.ofComponents (fun M => Iso.refl _) (fun f => by rfl)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits _ (wcIntRingSheaf Y ℓ)
    haveI := sheafOfModules_toSheaf_preservesFiniteColimits _ (wcZModRingSheaf Y (ℓ ^ m))
    haveI : Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ ⋙
        SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) :=
      Limits.preservesFiniteLimits_of_natIso e.symm
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ ⋙
        SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) :=
      Limits.preservesFiniteColimits_of_natIso e.symm
    haveI : Limits.ReflectsFiniteLimits (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) :=
      Limits.reflectsFiniteLimits_of_reflectsIsomorphisms _
    haveI : Limits.ReflectsFiniteColimits (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) := by
      refine @Limits.ReflectsFiniteColimits.mk _ _ _ _ _ ?_
      intro K' _ _
      haveI hK1 : Limits.HasColimitsOfShape K' (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) :=
        Limits.HasFiniteColimits.out K'
      haveI hK2 : Limits.PreservesColimitsOfShape K'
          (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)) :=
        Limits.PreservesFiniteColimits.preservesFiniteColimits K'
      exact @Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms _ _ _ _ K' _ _ inferInstance
        hK1 hK2
    exact ⟨Limits.preservesFiniteLimits_of_reflects_of_preserves _
        (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ)),
      Limits.preservesFiniteColimits_of_reflects_of_preserves _
        (SheafOfModules.toSheaf (wcIntRingSheaf Y ℓ))⟩
  obtain ⟨q, w, ⟨hcolim⟩, hcorep⟩ :=
    sheafOfModules_restrictScalars_unit_cokernel _ _ _ φ (ℓ ^ m) hS hK hZ
  obtain ⟨hFull, hFaith, hkill, hess⟩ :=
    sheafOfModules_restrictScalars_quotient_embedding _ _ _ φ (ℓ ^ m) hS hK hZ
  obtain ⟨hmono, hdivI⟩ :=
    sheafOfModules_unit_torsionfree_injective_divisible _ (wcIntRingSheaf Y ℓ) (ℓ ^ m) hT
  haveI hEI1 : EnoughInjectives (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  haveI hEI2 : EnoughInjectives (SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))) :=
    sheafOfModules_enoughInjectives _ _

  have c5 : ∀ (G : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m)) ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) [G.Additive] [G.Full] [G.Faithful]
      (P : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) (n : ℕ),
      Mono (n • 𝟙 P) →
      (∀ (J : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) [Injective J], Epi (n • 𝟙 J)) →
      (∀ M : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m)), n • 𝟙 M = 0) →
      (∀ N : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ), n • 𝟙 N = 0 →
        ∃ M : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m)), Nonempty (G.obj M ≅ N)) →
      ∀ (I : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))) [Injective I] (k : ℕ)
        (e : Abelian.Ext P (G.obj I) (k + 1)), e = 0 := by
    intro G _ _ _ P n h1 h2 h3 h4 I _ k e
    let ι := Injective.ι (G.obj I)
    let J := Injective.under (G.obj I)
    let ν : J ⟶ J := n • 𝟙 J
    haveI : Epi ν := h2 J
    have hιν : ι ≫ ν = 0 := by
      have e1 : ι ≫ ν = (n • 𝟙 (G.obj I)) ≫ ι := by
        show ι ≫ (n • 𝟙 _) = (n • 𝟙 _) ≫ ι
        rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
      rw [e1, ← G.map_id, ← Functor.map_nsmul, h3 I, G.map_zero, Limits.zero_comp]
    let ι' : G.obj I ⟶ Limits.kernel ν := Limits.kernel.lift ν ι hιν
    have hι' : ι' ≫ Limits.kernel.ι ν = ι := Limits.kernel.lift_ι _ _ _
    haveI : Mono ι' := mono_of_mono_fac hι'
    have hker : n • 𝟙 (Limits.kernel ν) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι ν), Limits.zero_comp, Preadditive.nsmul_comp,
        Category.id_comp]
      have := Limits.kernel.condition ν
      simp only [ν, Preadditive.comp_nsmul, Category.comp_id] at this
      exact this
    obtain ⟨M, ⟨eM⟩⟩ := h4 _ hker
    let g : I ⟶ M := G.preimage (ι' ≫ eM.inv)
    have hg : G.map g = ι' ≫ eM.inv := G.map_preimage _
    haveI : Mono (G.map g) := by rw [hg]; infer_instance
    haveI : Mono g := G.mono_of_mono_map this
    let r : M ⟶ I := Injective.factorThru (𝟙 I) g
    have hr : g ≫ r = 𝟙 I := Injective.comp_factorThru _ _
    have hst : ι' ≫ (eM.inv ≫ G.map r) = 𝟙 (G.obj I) := by
      rw [← Category.assoc, ← hg, ← G.map_comp, hr, G.map_id]
    let S : ShortComplex (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) :=
      ShortComplex.mk (Limits.kernel.ι ν) ν (Limits.kernel.condition ν)
    have hS' : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel ν) inferInstance inferInstance
    haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under (G.obj I)))
    have hz : e.comp (Abelian.Ext.mk₀ ι') (add_zero _) = 0 := by
      set z := e.comp (Abelian.Ext.mk₀ ι') (add_zero _)
      have h0 : z.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS' z h0 (n₀ := k) rfl
      rw [← hx₃]
      obtain ⟨y, hy⟩ : ∃ y : Abelian.Ext P S.X₂ k,
          x₃ = y.comp (Abelian.Ext.mk₀ S.g) (add_zero k) := by
        cases k with
        | zero =>
          obtain ⟨f, rfl⟩ : ∃ f : P ⟶ J, Abelian.Ext.mk₀ f = x₃ :=
            ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x₃⟩
          let g' : P ⟶ J := Injective.factorThru f (n • 𝟙 P)
          have hg' : (n • 𝟙 P) ≫ g' = f := Injective.comp_factorThru _ _
          refine ⟨Abelian.Ext.mk₀ g', ?_⟩
          rw [Abelian.Ext.mk₀_comp_mk₀]
          congr 1
          rw [← hg']
          simp only [S, ν, Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
            Category.id_comp]
        | succ k' =>
          refine ⟨0, ?_⟩
          rw [Abelian.Ext.zero_comp]
          exact Abelian.Ext.eq_zero_of_injective _
      rw [hy, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega),
        hS'.comp_extClass, Abelian.Ext.comp_zero]
    have he : e = (e.comp (Abelian.Ext.mk₀ ι') (add_zero _)).comp
        (Abelian.Ext.mk₀ (eM.inv ≫ G.map r)) (add_zero _) := by
      calc e = e.comp (Abelian.Ext.mk₀ (ι' ≫ (eM.inv ≫ G.map r))) (add_zero _) := by
            rw [hst, Abelian.Ext.comp_mk₀_id]
        _ = e.comp ((Abelian.Ext.mk₀ ι').comp (Abelian.Ext.mk₀ (eM.inv ≫ G.map r)) (add_zero 0))
              (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
        _ = _ := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
    rw [he, hz, Abelian.Ext.zero_comp]

  have c1 : ∀ (G : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m)) ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) [G.Additive]
      [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (Xo : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m)))
      (P : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) (ε : P ⟶ G.obj Xo),
      (∀ T, Function.Bijective (fun f : Xo ⟶ T => ε ≫ G.map f)) →
      (∀ (I : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))) [Injective I] (n : ℕ)
        (e : Abelian.Ext P (G.obj I) (n + 1)), e = 0) →
      ∀ (T : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))) (n : ℕ),
        Function.Bijective (fun x : Abelian.Ext Xo T n =>
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G x) (zero_add n)) := by
    intro G _ _ _ Xo P ε ha hb
    have key : ∀ (n : ℕ) (T : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))),
        Function.Bijective (fun x : Abelian.Ext Xo T n =>
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G x) (zero_add n)) := by
      intro n
      induction n with
      | zero =>
        intro T
        have hm' : ∀ f : Xo ⟶ T, (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G
            (Abelian.Ext.mk₀ f)) (zero_add 0) = Abelian.Ext.mk₀ (ε ≫ G.map f) := by
          intro f
          rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
        constructor
        · intro x₁ x₂ hx
          have e1 := Abelian.Ext.mk₀_homEquiv₀_apply x₁
          have e2 := Abelian.Ext.mk₀_homEquiv₀_apply x₂
          simp only at hx
          rw [← e1, ← e2, hm', hm'] at hx
          have h1 := (Abelian.Ext.mk₀_bijective _ _).1 hx
          have h2 : Abelian.Ext.homEquiv₀ x₁ = Abelian.Ext.homEquiv₀ x₂ := (ha T).1 h1
          rw [← e1, ← e2, h2]
        · intro z'
          obtain ⟨f, hf⟩ := (ha T).2 (Abelian.Ext.homEquiv₀ z')
          refine ⟨Abelian.Ext.mk₀ f, ?_⟩
          simp only at hf ⊢
          rw [hm', hf, Abelian.Ext.mk₀_homEquiv₀_apply]
      | succ n ih =>
        intro T
        let ι := Injective.ι T
        let S : ShortComplex (SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))) :=
          ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
        have hS' : S.ShortExact :=
          ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
        have hFS : (S.map G).ShortExact := hS'.map_of_exact G
        haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under T))
        let Ψ : ∀ (Z : SheafOfModules.{u+1} (wcZModRingSheaf Y (ℓ ^ m))) (k : ℕ),
            Abelian.Ext Xo Z k →+ Abelian.Ext P (G.obj Z) k := fun Z k =>
          ((Abelian.Ext.mk₀ ε).precomp (G.obj Z) (zero_add k)).comp
            (AddMonoidHom.mk' (Abelian.Ext.mapExactFunctor G)
              (Abelian.Ext.mapExactFunctor_add G Xo Z k))
        have hΨ : ∀ Z (k : ℕ) (x : Abelian.Ext Xo Z k), Ψ Z k x =
            (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor G x) (zero_add k) :=
          fun _ _ _ => rfl
        have bridge : ∀ w : Abelian.Ext Xo S.X₃ n,
            Ψ S.X₁ (n + 1) (w.comp hS'.extClass rfl) = (Ψ S.X₃ n w).comp hFS.extClass rfl := by
          intro w
          rw [hΨ, hΨ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
            Abelian.Ext.comp_assoc _ _ _ (zero_add n) rfl (by omega)]
        have bridge2 : ∀ v : Abelian.Ext Xo S.X₂ n,
            Ψ S.X₃ n (v.comp (Abelian.Ext.mk₀ S.g) (add_zero n)) =
              (Ψ S.X₂ n v).comp (Abelian.Ext.mk₀ (G.map S.g)) (add_zero n) := by
          intro v
          rw [hΨ, hΨ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
            Abelian.Ext.comp_assoc _ _ _ (zero_add n) (add_zero n) (by omega)]
        constructor
        · have hker : ∀ z : Abelian.Ext Xo T (n + 1), Ψ T (n + 1) z = 0 → z = 0 := by
            intro z hz
            have h0 : z.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
              Abelian.Ext.eq_zero_of_injective _
            obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ Xo hS' z h0 (n₀ := n) rfl
            have h1 : (Ψ S.X₃ n w).comp hFS.extClass rfl = 0 := by
              rw [← bridge, hw]; exact hz
            obtain ⟨v', hv'⟩ := Abelian.Ext.covariant_sequence_exact₃ P hFS
              (Ψ S.X₃ n w) rfl h1
            obtain ⟨v, hv⟩ := (ih S.X₂).2 v'
            have hw2 : w = v.comp (Abelian.Ext.mk₀ S.g) (add_zero n) := by
              apply (ih S.X₃).1
              change Ψ S.X₃ n w = Ψ S.X₃ n (v.comp (Abelian.Ext.mk₀ S.g) (add_zero n))
              rw [bridge2]
              rw [show Ψ S.X₂ n v = v' from hv]
              exact hv'.symm
            rw [← hw, hw2, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega),
              hS'.comp_extClass, Abelian.Ext.comp_zero]
          intro z₁ z₂ hz
          rw [← sub_eq_zero]
          apply hker
          rw [map_sub]
          change Ψ T (n + 1) z₁ = Ψ T (n + 1) z₂ at hz
          rw [hz, sub_self]
        · intro z'
          have h0 : z'.comp (Abelian.Ext.mk₀ (S.map G).f) (add_zero _) = 0 :=
            hb (Injective.under T) n _
          obtain ⟨w', hw'⟩ :=
            Abelian.Ext.covariant_sequence_exact₁ P hFS z' h0 (n₀ := n) rfl
          obtain ⟨w, hw⟩ := (ih S.X₃).2 w'
          refine ⟨w.comp hS'.extClass rfl, ?_⟩
          change Ψ S.X₁ (n + 1) (w.comp hS'.extClass rfl) = z'
          rw [bridge]
          change Ψ S.X₃ n w = w' at hw
          rw [hw, hw']
    exact fun T n => key n T

  haveI := hPL
  haveI := hPC
  haveI := hFull
  haveI := hFaith
  have hvan := c5 (SheafOfModules.restrictScalars.{u+1} φ)
    (SheafOfModules.unit (wcIntRingSheaf Y ℓ)) (ℓ ^ m) hmono hdivI hkill hess
  have hβc := c1 (SheafOfModules.restrictScalars.{u+1} φ)
    (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ m)))
    (SheafOfModules.unit (wcIntRingSheaf Y ℓ)) q hcorep hvan
  let θ : Limits.cokernel ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ))) ≅
      (SheafOfModules.restrictScalars.{u+1} φ).obj (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ m))) :=
    (Limits.cokernelIsCokernel ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ)))).coconePointUniqueUpToIso
      hcolim
  have hπθ : Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ))) ≫
      θ.hom = q :=
    Limits.IsColimit.comp_coconePointUniqueUpToIso_hom
      (Limits.cokernelIsCokernel ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ))))
      hcolim Limits.WalkingParallelPair.one
  let Φp : ∀ n : ℕ, wcZModProEtExt Y (ℓ ^ m) n →+
      Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) n := fun n =>
    ((Abelian.Ext.mk₀ θ.inv).postcomp (SheafOfModules.unit (wcIntRingSheaf Y ℓ))
        (add_zero n)).comp
      (((Abelian.Ext.mk₀ q).precomp _ (zero_add n)).comp
        (AddMonoidHom.mk' (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ))
          (Abelian.Ext.mapExactFunctor_add (SheafOfModules.restrictScalars.{u+1} φ) _ _ n)))
  have hΦp : ∀ (n : ℕ) (x : wcZModProEtExt Y (ℓ ^ m) n), Φp n x =
      ((Abelian.Ext.mk₀ q).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) x)
          (zero_add n)).comp (Abelian.Ext.mk₀ θ.inv) (add_zero n) := fun _ _ => rfl
  have hbij : ∀ n, Function.Bijective (Φp n) := by
    intro n
    have hpost : Function.Bijective (fun y : Abelian.Ext (SheafOfModules.unit (wcIntRingSheaf Y ℓ))
        ((SheafOfModules.restrictScalars.{u+1} φ).obj
          (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ m)))) n =>
        y.comp (Abelian.Ext.mk₀ θ.inv) (add_zero n)) := by
      refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ θ.hom) (add_zero n), ?_⟩⟩
      · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ θ.hom) (add_zero n)) hy
        simp only at hy'
        rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id,
          Abelian.Ext.comp_mk₀_id] at hy'
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    have hfun : (Φp n : wcZModProEtExt Y (ℓ ^ m) n →
          Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) n) =
        (fun y : Abelian.Ext (SheafOfModules.unit (wcIntRingSheaf Y ℓ))
          ((SheafOfModules.restrictScalars.{u+1} φ).obj
            (SheafOfModules.unit (wcZModRingSheaf Y (ℓ ^ m)))) n =>
          y.comp (Abelian.Ext.mk₀ θ.inv) (add_zero n)) ∘
        (fun x : wcZModProEtExt Y (ℓ ^ m) n =>
          (Abelian.Ext.mk₀ q).comp
            (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) x) (zero_add n)) :=
      funext fun x => hΦp n x
    rw [hfun]
    exact hpost.comp (hβc _ n)
  let Φ : ∀ n : ℕ, wcZModProEtExt Y (ℓ ^ m) n ≃+ Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) n :=
    fun n => AddEquiv.ofBijective (Φp n) (hbij n)
  have hΦ : ∀ (i j k : ℕ) (hk : i + j = k)
      (a' : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) i)
      (x : wcZModProEtExt Y (ℓ ^ m) i) (y : wcZModProEtExt Y (ℓ ^ m) j),
      a'.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
        (add_zero i) = Φ i x →
      a'.comp (Φ j y) hk = Φ k (wcZModProEtCup Y (ℓ ^ m) i j k hk x y) := by
    intro i j k hk a' x y H
    change a'.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
        (add_zero i) = Φp i x at H
    change a'.comp (Φp j y) hk = Φp k (wcZModProEtCup Y (ℓ ^ m) i j k hk x y)
    have hCup : wcZModProEtCup Y (ℓ ^ m) i j k hk x y = x.comp y hk := rfl
    rw [hΦp] at H
    have hstar : a'.comp (Abelian.Ext.mk₀ q) (add_zero i) = (Abelian.Ext.mk₀ q).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) x) (zero_add i) := by
      have H' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ θ.hom) (add_zero i)) H
      try simp only at H'
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, hπθ,
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] at H'
      exact H'
    rw [hCup, hΦp, hΦp]
    symm
    calc ((Abelian.Ext.mk₀ q).comp (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} φ) (x.comp y hk)) (zero_add k)).comp
            (Abelian.Ext.mk₀ θ.inv) (add_zero k)
        = ((Abelian.Ext.mk₀ q).comp ((Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} φ) x).comp (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} φ) y) hk) (zero_add k)).comp
            (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
          rw [Abelian.Ext.mapExactFunctor_comp]
      _ = (((Abelian.Ext.mk₀ q).comp (Abelian.Ext.mapExactFunctor
            (SheafOfModules.restrictScalars.{u+1} φ) x) (zero_add i)).comp
            (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) hk).comp
            (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
          rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q) _ _ (zero_add i) hk (by omega)]
      _ = ((a'.comp (Abelian.Ext.mk₀ q) (add_zero i)).comp
            (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) hk).comp
            (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
          rw [hstar]
      _ = (a'.comp ((Abelian.Ext.mk₀ q).comp
            (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) (zero_add j))
            hk).comp (Abelian.Ext.mk₀ θ.inv) (add_zero k) := by
          rw [Abelian.Ext.comp_assoc a' (Abelian.Ext.mk₀ q) _ (add_zero i) (zero_add j) (by omega)]
      _ = a'.comp (((Abelian.Ext.mk₀ q).comp
            (Abelian.Ext.mapExactFunctor (SheafOfModules.restrictScalars.{u+1} φ) y) (zero_add j)).comp
            (Abelian.Ext.mk₀ θ.inv) (add_zero j)) hk := by
          rw [Abelian.Ext.comp_assoc a' _ (Abelian.Ext.mk₀ θ.inv) hk (add_zero j) (by omega)]

  subst hN
  have ha : a ≤ 2 * n := by omega
  obtain rfl : b = 2 * n - a := by omega
  have hn0 : 0 < ℓ ^ m := pow_pos (Fact.out : Nat.Prime ℓ).pos m
  obtain ⟨Ψ, hΨ⟩ := wc_zmod_proet_etale_mod_comparison K Y pY (ℓ ^ m) hn0
  obtain ⟨-, hR⟩ := wc_et_zmod_poincare_nondegenerate K Y pY n ℓ hℓ m hm a ha
  intro β hβ
  obtain ⟨yb, hby⟩ : ∃ yb, β.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero _) = Φ _ yb :=
    ⟨_, (AddEquiv.apply_symm_apply _ _).symm⟩
  have hv : ℓ ^ (m - 1) • Ψ (2 * n - a) yb ≠ 0 := by
    intro h0
    rw [← map_nsmul, AddEquiv.map_eq_zero_iff] at h0
    apply hβ
    rw [hby, ← map_nsmul, h0, map_zero]
  obtain ⟨z, hz⟩ : ∃ z, wcEtZModCup Y (ℓ ^ m) a (2 * n - a) (2 * n)
      (Nat.add_sub_cancel' ha) z (ℓ ^ (m - 1) • Ψ (2 * n - a) yb) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hv (hR _ hcon)
  refine ⟨Φ a ((Ψ a).symm z), fun e α he hae => ?_⟩
  rw [← map_nsmul (Φ a)] at hae
  rw [hby, hΦ a (2 * n - a) (2 * n) hab α _ yb hae,
    ← map_nsmul (Φ (2 * n)), Ne, AddEquiv.map_eq_zero_iff]
  rw [map_nsmul, AddMonoidHom.nsmul_apply, smul_smul, ← pow_add,
    show m - 1 - e + e = m - 1 by omega]
  intro h0
  apply hz
  rw [map_nsmul, ← AddEquiv.apply_symm_apply (Ψ a) z, ← hΨ a (2 * n - a) (2 * n) hab,
    ← map_nsmul (Ψ (2 * n)), h0, map_zero]

theorem wc_hm_poincare_right (K : Type u) [Field K] [IsAlgClosed K]
    {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n : ℕ) [SmoothOfRelativeDimension n pY]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (a b N : ℕ) (hab : a + b = N) (hN : N = 2 * n)
    (w : wcHM Y ℓ b) (hw : ∀ z : wcHM Y ℓ a, wcHMCup Y ℓ a b N hab z w = 0) :
    w = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) := HasExt.standard _
  subst hN

  have tf : ∀ (p k : ℕ) (x : wcHM Y ℓ p), ℓ ^ k • x = 0 → x = 0 := by
    intro p k x hx
    have hs1 : ∀ M : ℕ, x.comp (Abelian.Ext.mk₀
        (M • 𝟙 (SheafOfModules.unit (wcRingSheaf Y ℓ)))) (add_zero p) = M • x := by
      intro M
      induction M with
      | zero => simp only [zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ M ih =>
        rw [succ_nsmul (𝟙 (SheafOfModules.unit (wcRingSheaf Y ℓ))) M, Abelian.Ext.mk₀_add,
          Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id, succ_nsmul x M]
    have hs2 : ∀ M : ℕ, M ≠ 0 →
        (M • 𝟙 (SheafOfModules.unit (wcRingSheaf Y ℓ))) ≫
          wcHMConst Y ℓ ((M : ℚ_[ℓ])⁻¹) = 𝟙 (SheafOfModules.unit (wcRingSheaf Y ℓ)) := by
      intro M hM
      obtain ⟨M', hM'⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
      subst hM'
      rw [Preadditive.nsmul_comp, Category.id_comp]
      apply (SheafOfModules.unitHomEquiv _).injective
      apply Subtype.ext
      funext V
      rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
      have hnapp : ∀ (K' : ℕ) (f : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶
          SheafOfModules.unit (wcRingSheaf Y ℓ))
          (m : ↑((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj V)),
          ConcreteCategory.hom (((K' + 1) • f).val.app V) m =
            (K' + 1) • ConcreteCategory.hom (f.val.app V) m := by
        intro K' f m
        induction K' with
        | zero => rw [zero_add, one_nsmul, one_nsmul]
        | succ K' ih =>
          rw [succ_nsmul f (K' + 1), succ_nsmul (ConcreteCategory.hom (f.val.app V) m) (K' + 1),
            ← ih, SheafOfModules.add_val, PresheafOfModules.add_app]
          rfl
      have hgval : ((SheafOfModules.unitHomEquiv _)
          (wcHMConst Y ℓ (((M' + 1 : ℕ) : ℚ_[ℓ])⁻¹))).val V =
          (ContinuousMap.const _ (ULift.up (((M' + 1 : ℕ) : ℚ_[ℓ])⁻¹)) :
            C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ])) := by
        rw [wcHMConst, Equiv.apply_symm_apply]
        rfl
      rw [SheafOfModules.unitHomEquiv_apply_coe] at hgval
      refine ((hnapp M' _ _).trans (congrArg
        (fun s : ↑((SheafOfModules.unit (wcRingSheaf Y ℓ)).val.obj V) => (M' + 1) • s)
        hgval)).trans ?_
      change ((M' + 1) • (ContinuousMap.const _ (ULift.up (((M' + 1 : ℕ) : ℚ_[ℓ])⁻¹)) :
            C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ]))) =
          (1 : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ]))
      ext t
      rw [ContinuousMap.nsmul_apply, ContinuousMap.const_apply, ContinuousMap.one_apply]
      show (M' + 1) • (((M' + 1 : ℕ) : ℚ_[ℓ])⁻¹) = 1
      rw [nsmul_eq_mul]
      exact mul_inv_cancel₀ (Nat.cast_ne_zero.mpr hM)
    have hN0 : ℓ ^ k ≠ 0 := pow_ne_zero k (Fact.out : Nat.Prime ℓ).ne_zero
    have hg := hs2 (ℓ ^ k) hN0
    calc x = x.comp (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcRingSheaf Y ℓ)))) (add_zero p) :=
          (Abelian.Ext.comp_mk₀_id x).symm
      _ = (x.comp (Abelian.Ext.mk₀ ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcRingSheaf Y ℓ))))
            (add_zero p)).comp
            (Abelian.Ext.mk₀ (wcHMConst Y ℓ (((ℓ ^ k : ℕ) : ℚ_[ℓ])⁻¹))) (add_zero p) := by
          rw [Abelian.Ext.comp_assoc x _ _ (add_zero p) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, hg]
      _ = 0 := by rw [hs1, hx, Abelian.Ext.zero_comp]

  have hnsmul : ∀ (j : ℕ) {W Z : SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)} {p q r : ℕ}
      (α : Abelian.Ext (wcIntUnit Y ℓ) W p)
      (β : Abelian.Ext W Z q) (hr : p + q = r),
      (j • α).comp β hr = j • α.comp β hr := by
    intro j W Z p q r α β hr
    induction j with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ j ih => rw [succ_nsmul, Abelian.Ext.add_comp, ih, succ_nsmul]

  have les : ∀ (m p : ℕ),
      (∀ x : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p,
        x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
          (add_zero p) = 0 →
        ∃ z : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p, x = ℓ ^ m • z) ∧
      (∀ (e : ℕ) (c : Abelian.Ext (wcIntUnit Y ℓ) (wcIntTors Y ℓ m) p),
        (∀ v : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) (p + 1), ℓ ^ m • v = 0 →
          ℓ ^ e • v = 0) →
        ∃ y : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p,
          y.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
            (add_zero p) = ℓ ^ e • c) := by
    intro m p
    have hmono : ∀ M : ℕ, M ≠ 0 →
        Mono (M • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ))) := by
      intro M hM
      have key : ∀ V : (Y.ProEt)ᵒᵖ,
          ∀ t : C(↥((Opposite.unop V).left), ULift.{u+1} ℤ_[ℓ]), M • t = 0 → t = 0 := by
        intro V t ht
        ext x
        have hx : M • (t x).down = 0 := by
          have := congrArg (fun g : C(↥((Opposite.unop V).left), ULift.{u+1} ℤ_[ℓ]) =>
            (g x).down) ht
          exact this
        rw [nsmul_eq_mul, mul_eq_zero] at hx
        rcases hx with h0 | h0
        · exact absurd (Nat.cast_eq_zero.mp h0) hM
        · exact h0
      apply Preadditive.mono_of_cancel_zero
      intro Q φ hφ
      rw [Preadditive.comp_nsmul, Category.comp_id] at hφ
      have hzero : ∀ V (s : Q.val.obj V),
          ((0 : Q ⟶ SheafOfModules.unit (wcIntRingSheaf Y ℓ)).val.app V).hom s = 0 :=
        fun _ _ => rfl
      have happ : ∀ (k : ℕ) V (s : Q.val.obj V),
          ((k • φ).val.app V).hom s = k • (φ.val.app V).hom s := by
        intro k V s
        induction k with
        | zero => rw [zero_nsmul, zero_nsmul]; exact hzero V s
        | succ k ih =>
          rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
            LinearMap.add_apply, ih, succ_nsmul]
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      have h1 : M • (φ.val.app V).hom s = 0 := by rw [← happ, hφ, hzero]
      exact (key V _ h1).trans (hzero V s).symm
    have hcomp : ∀ (j q : ℕ)
        (α : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) q),
        α.comp (Abelian.Ext.mk₀ (j • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ))))
          (add_zero q) = j • α := by
      intro j q α
      induction j with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ j ih =>
        rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
          succ_nsmul]
    have hN : ℓ ^ m ≠ 0 := pow_ne_zero m (Nat.Prime.ne_zero (Fact.out))
    let SC : ShortComplex (SheafOfModules.{u+1} (wcIntRingSheaf Y ℓ)) :=
      ShortComplex.mk ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ)))
        (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntRingSheaf Y ℓ))))
        (Limits.cokernel.condition _)
    have hS : SC.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) (hmono _ hN) inferInstance
    refine ⟨?_, ?_⟩
    · intro x hx
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂
        (SheafOfModules.unit (wcIntRingSheaf Y ℓ)) hS x hx
      refine ⟨x₁, ?_⟩
      rw [← hx₁]
      exact hcomp (ℓ ^ m) p x₁
    · intro e c hyp
      have hδ : ℓ ^ m • c.comp hS.extClass (rfl : p + 1 = p + 1) = 0 := by
        calc ℓ ^ m • c.comp hS.extClass (rfl : p + 1 = p + 1)
            = (c.comp hS.extClass (rfl : p + 1 = p + 1)).comp (Abelian.Ext.mk₀ SC.f)
                (add_zero (p + 1)) := (hcomp (ℓ ^ m) (p + 1) _).symm
          _ = c.comp (hS.extClass.comp (Abelian.Ext.mk₀ SC.f) (add_zero 1)) (by omega) :=
              Abelian.Ext.comp_assoc c hS.extClass (Abelian.Ext.mk₀ SC.f) rfl (add_zero 1)
                (by omega)
          _ = 0 := by rw [hS.extClass_comp, Abelian.Ext.comp_zero]
      have h3 : (ℓ ^ e • c).comp hS.extClass (rfl : p + 1 = p + 1) = 0 := by
        rw [hnsmul]
        exact hyp _ hδ
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₃
        (SheafOfModules.unit (wcIntRingSheaf Y ℓ)) hS (ℓ ^ e • c) rfl h3
      exact ⟨y, hy⟩

  obtain ⟨ι, hmul, hsurj, hker⟩ := wc_hm_int_rationalization K pY ℓ

  have hT : ∀ p : ℕ, ∃ e : ℕ, ∀ x : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p,
      (∃ r : ℕ, ℓ ^ r • x = 0) → ℓ ^ e • x = 0 := by
    intro p
    obtain ⟨inst, fin⟩ := wc_hm_int_fg K pY ℓ hℓ p
    exact (padic_fg_torsion_primitive ℓ (Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p)).1
  have hP : ∀ (p : ℕ) (x : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p),
      (∀ r : ℕ, ℓ ^ r • x ≠ 0) →
      ∃ (s : ℕ) (x₀ τ : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p), x = ℓ ^ s • x₀ + τ ∧
        (∃ r : ℕ, ℓ ^ r • τ = 0) ∧
        ∀ (m : ℕ) (z : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p),
          ℓ ^ m • x₀ ≠ ℓ ^ (m + 1) • z := by
    intro p
    obtain ⟨inst, fin⟩ := wc_hm_int_fg K pY ℓ hℓ p
    exact (padic_fg_torsion_primitive ℓ (Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p)).2

  have F3 : ∀ (m p q r : ℕ) (hr : p + q = r)
      (α : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) p)
      (β : Abelian.Ext (wcIntUnit Y ℓ) (wcIntUnit Y ℓ) q),
      α.comp (β.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
        (add_zero q)) hr =
      (α.comp β hr).comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
        (add_zero r) := by
    intro m p q r hr α β
    exact (Abelian.Ext.comp_assoc α β
      (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ))))
      hr (add_zero q) (by omega)).symm

  by_contra hw0
  obtain ⟨k, β, hβ⟩ := hsurj b w
  have hβnt : ∀ r : ℕ, ℓ ^ r • β ≠ 0 := by
    intro r hr
    apply hw0
    apply tf b (r + k) w
    rw [pow_add, mul_smul, ← hβ, ← map_nsmul, hr, map_zero]
  obtain ⟨s, b₀, τ, hdec, ⟨r, hτ⟩, hprim⟩ := hP b β hβnt
  have hιτ : ι b τ = 0 := tf b r _ (by rw [← map_nsmul, hτ, map_zero])
  have hw' : ℓ ^ k • w = ℓ ^ s • ι b b₀ := by
    rw [← hβ, hdec, map_add, map_nsmul, hιτ, add_zero]
  obtain ⟨e, he⟩ := hT (a + 1)
  obtain ⟨e₂, he₂⟩ := hT (2 * n)
  obtain ⟨m, hm⟩ : ∃ m : ℕ, m = e + e₂ + 1 := ⟨_, rfl⟩
  have hm1 : 1 ≤ m := by omega
  have hred : ℓ ^ (m - 1) • b₀.comp
      (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero b) ≠ 0 := by
    intro h0
    have h0' : (ℓ ^ (m - 1) • b₀).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit Y ℓ)))) (add_zero b) = 0 := by
      rw [hnsmul]
      exact h0
    obtain ⟨z, hz⟩ := (les m b).1 _ h0'
    exact hprim (m - 1) z (by rw [show m - 1 + 1 = m by omega]; exact hz)
  obtain ⟨c, hc⟩ :=
    wc_hm_int_tors_duality_right K pY n ℓ hℓ a b (2 * n) hab rfl m hm1 b₀ hred
  obtain ⟨α, hα⟩ := (les m a).2 e c (fun v hv => he v ⟨m, hv⟩)
  have h1 := hc e α (by omega) hα
  rw [show m - 1 - e = e₂ by omega, F3] at h1
  have hnt : ι (2 * n) (α.comp b₀ hab) ≠ 0 := by
    intro h0
    obtain ⟨r', hr'⟩ := hker _ _ h0
    apply h1
    rw [← hnsmul, he₂ _ ⟨r', hr'⟩, Abelian.Ext.zero_comp]
  rw [hmul] at hnt
  apply hnt
  apply tf (2 * n) s
  rw [← map_nsmul, ← hw', map_nsmul, hw _, smul_zero]

theorem wc_smooth_pair_supp_class_lift (K : Type u) [Field K] [IsAlgClosed K]
    {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of K)) [IsProper pY] [IrreducibleSpace Y]
    (n m r : ℕ) (hmr : m + r = n) [SmoothOfRelativeDimension n pY]
    (i : Z ⟶ Y) [IsClosedImmersion i] [IrreducibleSpace Z] [SmoothOfRelativeDimension m (i ≫ pY)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (k k' N : ℕ) (hk : k = 2 * r) (hk' : k' = 2 * m) (hkN : k' + k = N) (hN : N = 2 * n)
    (c : wcHM Y ℓ k)
    (hc : ∀ z : wcHM Y ℓ k', wcHMPull Di k' z = 0 → wcHMCup Y ℓ k' k N hkN z c = 0) :
    ∃ θ : wcSuppExt Di k, wcSuppClass Di k θ = c :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) := HasExt.standard _

  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  haveI : IsProper (i ≫ pY) := inferInstance

  have hassoc : ∀ (S : Scheme.{u}) (a₁ a₂ a₃ a₁₂ a₂₃ a : ℕ) (h₁₂ : a₁ + a₂ = a₁₂)
      (h₂₃ : a₂ + a₃ = a₂₃) (h1 : a₁₂ + a₃ = a) (h2 : a₁ + a₂₃ = a)
      (x : wcHM S ℓ a₁) (y : wcHM S ℓ a₂) (z : wcHM S ℓ a₃),
      wcHMCup S ℓ a₁₂ a₃ a h1 (wcHMCup S ℓ a₁ a₂ a₁₂ h₁₂ x y) z =
        wcHMCup S ℓ a₁ a₂₃ a h2 x (wcHMCup S ℓ a₂ a₃ a₂₃ h₂₃ y z) := by
    intro S a₁ a₂ a₃ a₁₂ a₂₃ a h₁₂ h₂₃ h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_assoc x y z h₁₂ h₂₃ (by omega)
  have hscR : ∀ (S : Scheme.{u}) (p q s : ℕ) (h : p + q = s) (x : wcHM S ℓ p) (w : wcHM S ℓ q)
      (t : ℚ_[ℓ]), wcHMCup S ℓ p q s h x (wcHMScalar S ℓ q t w) =
        wcHMScalar S ℓ s t (wcHMCup S ℓ p q s h x w) := by
    intro S p q s h x w t
    exact (hassoc S p q 0 s q s h (add_zero q) (add_zero s) h x w
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t))).symm
  have hscL : ∀ (S : Scheme.{u}) (p q s : ℕ) (h : p + q = s) (x : wcHM S ℓ p) (w : wcHM S ℓ q)
      (t : ℚ_[ℓ]), wcHMCup S ℓ p q s h (wcHMScalar S ℓ p t x) w =
        wcHMScalar S ℓ s t (wcHMCup S ℓ p q s h x w) := by
    intro S p q s h x w t
    have e1 := hassoc S p 0 q p q s (add_zero p) (zero_add q) h h x
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t)) w
    have e2 : wcHMCup S ℓ 0 q q (zero_add q)
        (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t)) w =
        wcHMScalar S ℓ q t w := wc_hm_unit_end_central S ℓ (wcHMConst S ℓ t) q w
    rw [e2, hscR] at e1
    exact e1
  have F1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (n : ℕ) (t : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n t x) = wcHMScalar S' ℓ n t (wcHMPull D n x) := by
    intro S S' f D hD n t x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hk : D.Φ.map (wcHMConst S ℓ t) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ t := by
      rw [← wc_hm_pull_const D hD t, Iso.hom_inv_id_assoc]
    have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)} (z : Abelian.Ext A B n)
        (a : B ⟶ C') (b : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero n)).comp (Abelian.Ext.mk₀ b) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero n) := by
      intro A B C' D' z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have e3 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero n))
      (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (zero_add n)
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (add_zero n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e3, e2, hk]
  have hsupp : ∀ (θ : wcSuppExt Di k) (t : ℚ_[ℓ]),
      wcSuppClass Di k (θ.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ t)) (add_zero k)) =
        wcHMScalar Y ℓ k t (wcSuppClass Di k θ) := by
    intro θ t
    exact (Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ (wcSuppUnitMap Di)) θ
      (Abelian.Ext.mk₀ (wcHMConst Y ℓ t)) (zero_add k)).symm
  have arith : ∀ (a b μ : ℚ_[ℓ]), b ≠ 0 → μ * a - a / b * (μ * b) = 0 := by
    intro a b μ hb
    have : a / b * (μ * b) = μ * a := by
      calc a / b * (μ * b) = μ * a * (b / b) := by ring
        _ = μ * a := by rw [div_self hb, mul_one]
    rw [this, sub_self]
  have arith2 : ∀ (a b : ℚ_[ℓ]), b ≠ 0 → a - a / b * b = 0 := by
    intro a b hb
    rw [div_mul_cancel₀ _ hb, sub_self]

  have hex := wc_closed_pushforward_exact_of_noetherian i ℓ Di
  have C1 : ∀ (θ : wcSuppExt Di k) (x : wcHM Y ℓ k'), wcHMPull Di k' x = 0 →
      wcHMCup Y ℓ k' k N hkN x (wcSuppClass Di k θ) = 0 :=
    fun θ x hx => wc_closed_supp_class_restriction_zero_of_exact i ℓ Di hex k k' N hkN θ x hx

  obtain ⟨τ, hτ⟩ := wc_smooth_pair_gysin_detect K pY n m r hmr i ℓ hℓ Di hDi k k' N hk hk' hkN hN
  obtain ⟨ηY, hYinj, hYc⟩ := wc_hm_top_line K pY n ℓ hℓ N hN
  obtain ⟨ηZ, hZinj, hZc⟩ := wc_hm_top_line K (i ≫ pY) m ℓ hℓ k' hk'
  have PD := wc_hm_poincare_right K pY n ℓ hℓ k' k N hkN hN

  by_cases hA : ∃ z₀ : wcHM Y ℓ k', wcHMPull Di k' z₀ ≠ 0
  · obtain ⟨z₀, hz₀⟩ := hA
    have hβ : ηY (wcHMCup Y ℓ k' k N hkN z₀ (wcSuppClass Di k τ)) ≠ 0 := by
      intro h0
      exact hτ z₀ hz₀ (hYinj (h0.trans (map_zero ηY).symm))
    have ha₀ : ηZ (wcHMPull Di k' z₀) ≠ 0 := by
      intro h0
      exact hz₀ (hZinj (h0.trans (map_zero ηZ).symm))
    obtain ⟨lam, hlam⟩ : ∃ lam : ℚ_[ℓ], lam = ηY (wcHMCup Y ℓ k' k N hkN z₀ c) /
        ηY (wcHMCup Y ℓ k' k N hkN z₀ (wcSuppClass Di k τ)) := ⟨_, rfl⟩
    have key : ∀ z : wcHM Y ℓ k',
        wcHMCup Y ℓ k' k N hkN z (c - wcHMScalar Y ℓ k lam (wcSuppClass Di k τ)) = 0 := by
      intro z
      obtain ⟨μ, hμ⟩ : ∃ μ : ℚ_[ℓ], μ = ηZ (wcHMPull Di k' z) / ηZ (wcHMPull Di k' z₀) :=
        ⟨_, rfl⟩
      have hker : wcHMPull Di k' (z - wcHMScalar Y ℓ k' μ z₀) = 0 := by
        apply hZinj
        rw [map_zero, map_sub, map_sub, F1 Di hDi, hZc, hμ]
        exact arith2 _ _ ha₀
      have hc' := hc _ hker
      have hs' := C1 τ _ hker
      rw [map_sub, AddMonoidHom.sub_apply, sub_eq_zero, hscL] at hc' hs'
      apply hYinj
      rw [map_zero, map_sub, map_sub, hscR, hYc, hc', hs', hYc, hYc, hlam]
      exact arith _ _ _ hβ
    have hw := PD (c - wcHMScalar Y ℓ k lam (wcSuppClass Di k τ)) key
    refine ⟨τ.comp (Abelian.Ext.mk₀ (wcHMConst Y ℓ lam)) (add_zero k), ?_⟩
    rw [hsupp]
    exact (sub_eq_zero.mp hw).symm
  · push_neg at hA
    have hc0 : c = 0 := PD c (fun z => hc z (hA z))
    refine ⟨0, ?_⟩
    rw [hc0]
    first
      | exact Abelian.Ext.comp_zero _ _
      | exact Abelian.Ext.comp_zero _
      | simp [wcSuppClass]

theorem wc_diag_supp_point_class_nonzero (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ) :
    ∃ (θ : wcSuppExt DΔ (2 * d)) (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
      (_ : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
      (Dt : wcHMPullData t ℓ) (_ : wcHMPullCanonical Dt),
      Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) ∧
      wcHMPull Dt (2 * d) (wcSuppClass DΔ (2 * d) θ) ≠ 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _

  obtain ⟨x₀, hx₀⟩ := wc_xbar_geom_point_exists F X d

  have w : 𝟙 (wcXbar F X) ≫ wcPi2 F X = (wcPi2 F X ≫ x₀) ≫ wcPi2 F X := by
    rw [Category.assoc, hx₀, Category.comp_id, Category.id_comp]
  set t₀ : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X) :=
    Limits.pullback.lift (𝟙 (wcXbar F X)) (wcPi2 F X ≫ x₀) w with ht₀def
  have ht₁ : t₀ ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ :=
    Limits.pullback.lift_fst _ _ _
  have ht₂ : t₀ ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x₀ :=
    Limits.pullback.lift_snd _ _ _
  obtain ⟨Dt₀, hDt₀⟩ := wc_hm_pull_data_exists t₀ ℓ

  have hC : Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫ t₀ =
      Limits.pullback.snd t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫
        Limits.pullback.diagonal (wcPi2 F X) :=
    Limits.pullback.condition
  have hab : Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) =
      Limits.pullback.snd t₀ (Limits.pullback.diagonal (wcPi2 F X)) := by
    have h := congrArg (· ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) hC
    simp only [Category.assoc, ht₁, Category.comp_id, Limits.pullback.diagonal_fst] at h
    exact h
  have hab2 : Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X ≫ x₀ =
      Limits.pullback.snd t₀ (Limits.pullback.diagonal (wcPi2 F X)) := by
    have h := congrArg (· ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) hC
    simp only [Category.assoc, ht₂, Limits.pullback.diagonal_snd, Category.comp_id] at h
    exact h
  have w' : x₀ ≫ t₀ = x₀ ≫ Limits.pullback.diagonal (wcPi2 F X) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, ht₁, Limits.pullback.diagonal_fst]
    · rw [Category.assoc, Category.assoc, ht₂, Limits.pullback.diagonal_snd,
        ← Category.assoc, hx₀, Category.id_comp, Category.comp_id]
  set j : Spec (.of (AlgebraicClosure F)) ⟶
      Limits.pullback t₀ (Limits.pullback.diagonal (wcPi2 F X)) :=
    Limits.pullback.lift x₀ x₀ w' with hjdef
  have hj1 : j ≫ Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X =
      𝟙 _ := by
    rw [← Category.assoc, hjdef, Limits.pullback.lift_fst, hx₀]
  have hj2 : (Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) ≫ j =
      𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hjdef, Limits.pullback.lift_fst, Category.id_comp,
        hab2, ← hab]
    · rw [Category.assoc, Category.assoc, hjdef, Limits.pullback.lift_snd, Category.id_comp,
        hab2]
  have hiso : IsIso (Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫
      wcPi2 F X) := ⟨⟨j, hj2, hj1⟩⟩
  haveI := hiso
  haveI : IsOpenImmersion (Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫
      wcPi2 F X) :=
    IsOpenImmersion.of_isIso _
  have het : Etale (Limits.pullback.fst t₀ (Limits.pullback.diagonal (wcPi2 F X)) ≫
      wcPi2 F X) := inferInstance

  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨D2, hD2⟩ := wc_hm_pull_data_exists (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨Dx₀, hDx₀⟩ := wc_hm_pull_data_exists x₀ ℓ

  have hax : IsIso (x₀ ≫ wcPi2 F X) := by rw [hx₀]; infer_instance
  obtain ⟨u, hu⟩ := wc_point_supp_class_nonzero F X d ℓ hℓ x₀ hax Dx₀ hDx₀

  obtain ⟨c, hann, hne⟩ := wc_ybar_diag_kunneth_class F X d ℓ hℓ D2 hD2 DΔ hDΔ
    (wcSuppClass Dx₀ (2 * d) u) hu

  have hfp := wc_ybar_fibre_projection_swap F X d ℓ hℓ D1 hD1 D2 hD2 x₀ hx₀ t₀ ht₁ ht₂
    Dt₀ hDt₀ (wcSuppClass Dx₀ (2 * d) u) c
  have htc : wcHMPull Dt₀ (2 * d) c ≠ 0 := by
    intro h0
    apply hne
    rw [hfp, h0, map_zero, map_zero]

  haveI : IsProper (wcPi2 F X) := by unfold wcPi2; infer_instance
  haveI : SmoothOfRelativeDimension d (wcPi2 F X) := by
    unfold wcPi2
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom _) inferInstance
  haveI : IsProper (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) := inferInstance
  haveI : SmoothOfRelativeDimension d (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) := by
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback (wcPi2 F X) (wcPi2 F X)).flip inferInstance
  haveI : IsProper (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X) := inferInstance
  haveI : SmoothOfRelativeDimension (2 * d)
      (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X) := by
    have h : SmoothOfRelativeDimension (d + d)
        (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X) := inferInstance
    rwa [← two_mul] at h
  haveI : IsClosedImmersion (Limits.pullback.diagonal (wcPi2 F X)) := inferInstance
  haveI : GeometricallyIrreducible
      (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X) :=
    GeometricallyIrreducible.comp _ _
  haveI : IrreducibleSpace ↥(Limits.pullback (wcPi2 F X) (wcPi2 F X)) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace
      (f := Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X)
      (𝟙 _) (𝟙 _) (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X) IsPullback.of_id_fst
  haveI : IrreducibleSpace ↥(wcXbar F X) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) _ _
      (IsPullback.of_hasPullback _ _)
  haveI : SmoothOfRelativeDimension d (Limits.pullback.diagonal (wcPi2 F X) ≫
      (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X)) := by
    rw [← Category.assoc, Limits.pullback.diagonal_fst, Category.id_comp]; infer_instance
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h
    have hF : ((ℓ : ℕ) : F) = 0 := by
      apply (algebraMap F (AlgebraicClosure F)).injective
      rw [map_natCast, map_zero]
      exact h
    have hcop : Nat.Coprime ℓ (Nat.card F) :=
      (Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime ℓ)).mpr hℓ
    have hb := Nat.gcd_eq_gcd_ab ℓ (Nat.card F)
    rw [hcop.gcd_eq_one, Nat.cast_one] at hb
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      haveI := Fintype.ofFinite F
      rw [Nat.card_eq_fintype_card]
      exact FiniteField.cast_card_eq_zero F
    have hb' := congrArg (Int.cast : ℤ → F) hb
    push_cast at hb'
    rw [hF, hc] at hb'
    simp at hb'

  obtain ⟨θ, hθ⟩ := wc_smooth_pair_supp_class_lift (AlgebraicClosure F)
    (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ wcPi2 F X) (2 * d) d d (by omega)
    (Limits.pullback.diagonal (wcPi2 F X)) ℓ hℓK DΔ hDΔ
    (2 * d) (2 * d) (4 * d) rfl rfl (by omega) (by omega) c hann
  refine ⟨θ, t₀, ht₁, Dt₀, hDt₀, het, ?_⟩
  rw [hθ]
  exact htc

theorem wc_proet_cover_affine_finite_refine : ∀ {Z : Scheme.{u}} (U : Z.ProEt), IsAffine U.left → ∀ (T : Sieve U), T ∈ Scheme.ProEt.topology Z U → ∃ (n : ℕ) (P : Fin n → Z.ProEt) (f : ∀ k, P k ⟶ U), (∀ k, IsAffine (P k).left) ∧ (∀ k, T (f k)) ∧ ∀ x : U.left, ∃ k, x ∈ Set.range ⇑(f k).left :=
by
  intro Z U hU T hT

  have key : ∀ (𝒰 : Scheme.Cover.{u+1} (Scheme.precoverage @WeaklyEtale) U.left),
      QuasiCompactCover 𝒰.toPreZeroHypercover →
      (∀ i : 𝒰.I₀, ∃ (W : Z.ProEt) (t : W ⟶ U) (h : 𝒰.X i ⟶ W.left),
        T t ∧ 𝒰.f i = h ≫ t.left) →
      ∃ (n : ℕ) (P : Fin n → Z.ProEt) (f : ∀ k, P k ⟶ U), (∀ k, IsAffine (P k).left) ∧
        (∀ k, T (f k)) ∧ ∀ x : U.left, ∃ k, x ∈ Set.range ⇑(f k).left := by
    intro 𝒰 hqc hfac
    have := hU
    have := hqc
    obtain ⟨n, a, V, hV, hcov⟩ := QuasiCompactCover.exists_isAffineOpen_of_isCompact
      𝒰.toPreZeroHypercover (U := ⊤) (isAffineOpen_top U.left).isCompact
    have hwe : ∀ k, WeaklyEtale ((V k).ι ≫ 𝒰.f (a k) ≫ U.hom) := by
      intro k
      have := 𝒰.map_prop (a k)
      infer_instance
    let P : Fin n → Z.ProEt := fun k =>
      @Scheme.ProEt.mk _ _ ((V k).ι ≫ 𝒰.f (a k) ≫ U.hom) (hwe k)
    let f : ∀ k, P k ⟶ U := fun k =>
      MorphismProperty.Over.homMk ((V k).ι ≫ 𝒰.f (a k)) (Category.assoc _ _ _) trivial
    refine ⟨n, P, f, fun k => hV k, ?_, ?_⟩
    · intro k
      obtain ⟨W, t, h, hTt, hht⟩ := hfac (a k)
      have hg : ((V k).ι ≫ h) ≫ t.left = (V k).ι ≫ 𝒰.f (a k) := by
        rw [Category.assoc, ← hht]
      have hw : ((V k).ι ≫ h) ≫ W.hom = (V k).ι ≫ 𝒰.f (a k) ≫ U.hom := by
        rw [← MorphismProperty.Over.w t, ← Category.assoc, hg]
        exact Category.assoc _ _ _
      let g : P k ⟶ W := MorphismProperty.Over.homMk ((V k).ι ≫ h) hw trivial
      have hgt : g ≫ t = f k := MorphismProperty.Over.Hom.ext hg
      rw [← hgt]
      exact T.downward_closed hTt g
    · intro x
      have hx : x ∈ ⋃ i, ⇑(𝒰.f (a i)) '' ↑(V i) := by
        rw [hcov]
        trivial
      obtain ⟨k, y, hy, hyx⟩ := Set.mem_iUnion.mp hx
      exact ⟨k, ⟨y, hy⟩, hyx⟩

  have h1 := (CoverPreserving.of_isContinuous (Scheme.ProEt.forget Z ⋙ Over.forget Z)
    (Scheme.ProEt.topology Z) Scheme.proetaleTopology).cover_preserve hT
  obtain ⟨R, hR, hRle⟩ := Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition.mp h1
  obtain ⟨𝒰, hqc, rfl⟩ := Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mp hR
  have hfac : ∀ i : 𝒰.I₀, ∃ (W : Z.ProEt) (t : W ⟶ U) (h : 𝒰.X i ⟶ W.left),
      T t ∧ 𝒰.f i = h ≫ t.left := by
    intro i
    have h2 : (Sieve.functorPushforward (Scheme.ProEt.forget Z ⋙ Over.forget Z) T).arrows
        (𝒰.f i) := hRle _ (𝒰.f i) (Presieve.ofArrows.mk i)
    rw [Sieve.functorPushforward_apply] at h2
    obtain ⟨W, t, h, hTt, e⟩ := h2
    exact ⟨W, t, h, hTt, e⟩
  exact key 𝒰 hqc hfac

theorem wc_ret_disjoint_open_refine : ∀ {Z : Scheme.{u}} (U : Z.ProEt), IsAffine U.left → (∀ (E : Scheme.{u}) (p : E ⟶ U.left), IsAffine E → WeaklyEtale p → Surjective p → ∃ σ : U.left ⟶ E, σ ≫ p = 𝟙 U.left) → ∀ (n : ℕ) (P : Fin n → Z.ProEt) (f : ∀ k, P k ⟶ U), (∀ k, IsAffine (P k).left) → (∀ x : U.left, ∃ k, x ∈ Set.range ⇑(f k).left) → ∃ (m : ℕ) (Q : Fin m → Z.ProEt) (ι : ∀ j, Q j ⟶ U), (∀ j, IsOpenImmersion (ι j).left) ∧ (∀ x : U.left, ∃! j, x ∈ Set.range ⇑(ι j).left) ∧ ∀ j, ∃ (k : Fin n) (h : Q j ⟶ P k), h ≫ f k = ι j :=
by
  intro Z U _ hRET n P f hPa hsurj
  classical
  have hU : WeaklyEtale U.hom := U.prop

  have hWE : ∀ k, WeaklyEtale (f k).left := by
    intro k
    have : WeaklyEtale ((f k).left ≫ U.hom) := by
      rw [MorphismProperty.Over.w (f k)]; exact (P k).prop
    exact WeaklyEtale.of_comp (f k).left U.hom
  have : ∀ k, IsAffine (P k).left := hPa

  have hpWE : WeaklyEtale (Limits.Sigma.desc (fun k => (f k).left)) :=
    IsZariskiLocalAtSource.sigmaDesc (P := @WeaklyEtale) hWE
  have hpS : Surjective (Limits.Sigma.desc (fun k => (f k).left)) := by
    constructor
    intro x
    obtain ⟨k, y, hy⟩ := hsurj x
    refine ⟨Limits.Sigma.ι (fun k => (P k).left) k y, ?_⟩
    rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
    exact hy
  obtain ⟨σ, hσ⟩ := hRET (∐ fun k => (P k).left) (Limits.Sigma.desc (fun k => (f k).left))
    inferInstance hpWE hpS

  obtain ⟨O, hmemO⟩ : ∃ O : Fin n → U.left.Opens, ∀ k (x : U.left), x ∈ O k ↔
      σ x ∈ Set.range ⇑(Limits.Sigma.ι (fun k => (P k).left) k) := by
    refine ⟨fun k => σ ⁻¹ᵁ (Limits.Sigma.ι (fun k => (P k).left) k).opensRange, ?_⟩
    intro k x
    rw [← Scheme.Hom.coe_opensRange]
    exact Scheme.Hom.mem_preimage σ
  have hfac : ∀ k, ∃ h : (O k).toScheme ⟶ (P k).left, h ≫ (f k).left = (O k).ι := by
    intro k
    have H' : Set.range ⇑((O k).ι ≫ σ) ⊆
        Set.range ⇑(Limits.Sigma.ι (fun k => (P k).left) k) := by
      rintro _ ⟨z, rfl⟩
      have h2 := (hmemO k z.1).1 z.2
      have e : ((O k).ι ≫ σ) z = σ z.1 := by
        rw [Scheme.Hom.comp_apply]
        rfl
      rw [e]
      exact h2
    refine ⟨IsOpenImmersion.lift (Limits.Sigma.ι (fun k => (P k).left) k) ((O k).ι ≫ σ) H', ?_⟩
    rw [← Limits.Sigma.ι_comp_desc (fun k => (f k).left) k, ← Category.assoc,
      IsOpenImmersion.lift_fac, Category.assoc, hσ, Category.comp_id]
  have hcov : ∀ x : U.left, ∃ k, x ∈ O k := by
    intro x
    obtain ⟨i, y, hy⟩ := (sigmaOpenCover (fun k => (P k).left)).exists_eq (σ x)
    exact ⟨i, (hmemO i x).2 ⟨y, hy⟩⟩
  have huniq : ∀ (x : U.left) (j k : Fin n), x ∈ O j → x ∈ O k → j = k := by
    intro x j k hj hk
    obtain ⟨y, hy⟩ := (hmemO j x).1 hj
    obtain ⟨y', hy'⟩ := (hmemO k x).1 hk
    have := (sigmaι_eq_iff (fun k => (P k).left) j k y y').1 (hy.trans hy'.symm)
    exact congrArg Sigma.fst this

  refine ⟨n, fun k => Scheme.ProEt.mk ((O k).ι ≫ U.hom),
    fun k => MorphismProperty.Over.homMk (A := Scheme.ProEt.mk ((O k).ι ≫ U.hom)) (B := U)
      (O k).ι, fun k => ?_, fun x => ?_, fun j => ?_⟩
  · show IsOpenImmersion (O k).ι
    infer_instance
  · have hr : ∀ k, x ∈ Set.range ⇑(O k).ι ↔ x ∈ O k := by
      intro k
      rw [Scheme.Opens.range_ι]
      rfl
    obtain ⟨k, hk⟩ := hcov x
    refine ⟨k, (hr k).2 hk, fun j hj => huniq x j k ((hr j).1 hj) hk⟩
  · obtain ⟨h₀, hh₀⟩ := hfac j
    refine ⟨j, MorphismProperty.Over.homMk (A := Scheme.ProEt.mk ((O j).ι ≫ U.hom)) (B := P j)
      h₀ ?_ trivial, ?_⟩
    · show h₀ ≫ (P j).hom = (O j).ι ≫ U.hom
      rw [← MorphismProperty.Over.w (f j), ← Category.assoc, hh₀]
    · apply MorphismProperty.Over.Hom.ext
      exact hh₀

theorem wc_wl_closedPt_annihilate : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → ∀ m : PrimeSpectrum A, IsClosed ({m} : Set (PrimeSpectrum A)) → ∀ a ∈ m.asIdeal, ∃ s : A, s ∉ m.asIdeal ∧ ∀ m' : PrimeSpectrum A, IsClosed ({m'} : Set (PrimeSpectrum A)) → s * a ∈ m'.asIdeal :=
by
  intro A _ hX m _ a ha
  classical
  set X0 : Set (PrimeSpectrum A) :=
    {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} with hX0
  set J : Ideal A := PrimeSpectrum.vanishingIdeal X0 with hJ
  have hrad : J.IsRadical := PrimeSpectrum.isRadical_vanishingIdeal X0
  have hmax : ∀ P : Ideal A, P.IsPrime → J ≤ P → P.IsMaximal := by
    intro P hP hJP
    have hx : (⟨P, hP⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus (J : Set A) :=
      (PrimeSpectrum.mem_zeroLocus _ _).mpr hJP
    rw [hJ, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hX.closure_eq] at hx
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hx
  have key : ∃ y r : A, y * a ∈ J ∧ y + r * a = 1 := by
    by_contra hcon
    let K' : Ideal A :=
      { carrier := {c | c * a ∈ J}
        add_mem' := fun {x y} hx hy => by
          simp only [Set.mem_setOf_eq] at *
          rw [add_mul]
          exact J.add_mem hx hy
        zero_mem' := by simp
        smul_mem' := fun c x hx => by
          simp only [Set.mem_setOf_eq, smul_eq_mul] at *
          rw [mul_assoc]
          exact J.mul_mem_left c hx }
    have hK : K' ⊔ Ideal.span {a} ≠ ⊤ := by
      intro htop
      apply hcon
      have h1 : (1 : A) ∈ K' ⊔ Ideal.span {a} := by
        rw [htop]
        exact Submodule.mem_top
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      exact ⟨y, r, hy, hyz⟩
    obtain ⟨n, hn, hKn⟩ := Ideal.exists_le_maximal _ hK
    have han : a ∈ n := hKn (Ideal.mem_sup_right (Ideal.mem_span_singleton_self a))
    have hK'n : K' ≤ n := le_trans le_sup_left hKn
    haveI := hn.isPrime
    let S : Submonoid A := n.primeCompl ⊔ Submonoid.powers a
    by_cases hdis : Disjoint (J : Set A) (S : Set A)
    · obtain ⟨P, hP, hJP, hPS⟩ := Ideal.exists_le_prime_disjoint J S hdis
      have hPn : P ≤ n := by
        intro x hxP
        by_contra hxn
        have hxS : x ∈ S := Submonoid.mem_sup_left (show x ∈ n.primeCompl from hxn)
        exact Set.disjoint_left.mp hPS hxP hxS
      have haP : a ∉ P := by
        intro haP
        have haS : a ∈ S := Submonoid.mem_sup_right (Submonoid.mem_powers a)
        exact Set.disjoint_left.mp hPS haP haS
      have hPmax := hmax P hP hJP
      have hPeq : P = n := hPmax.eq_of_le hn.ne_top hPn
      exact haP (hPeq ▸ han)
    · obtain ⟨x, hxJ, hxS⟩ := Set.not_disjoint_iff.mp hdis
      obtain ⟨c, hc, z, hz, hcz⟩ := Submonoid.mem_sup.mp hxS
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp hz
      have hcn : c ∉ n := hc
      have hxJ' : c * a ^ k ∈ J := by rw [hk, hcz]; exact hxJ
      have hca : c * a ∈ J := by
        apply hrad
        refine (Ideal.mem_radical_iff).mpr ⟨k + 1, ?_⟩
        have e : (c * a) ^ (k + 1) = (c ^ k * a) * (c * a ^ k) := by ring
        rw [e]
        exact J.mul_mem_left _ hxJ'
      exact hcn (hK'n hca)
  obtain ⟨y, r, hya, hyr⟩ := key
  refine ⟨y, ?_, ?_⟩
  · intro hy
    apply m.isPrime.ne_top
    rw [Ideal.eq_top_iff_one, ← hyr]
    exact m.asIdeal.add_mem hy (m.asIdeal.mul_mem_left r ha)
  · intro m' hm'
    exact (PrimeSpectrum.mem_vanishingIdeal X0 (y * a)).mp hya m' hm'

theorem wc_wl_closedPts_compact_t2 : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → (∀ m : PrimeSpectrum A, IsClosed ({m} : Set (PrimeSpectrum A)) → ∀ a ∈ m.asIdeal, ∃ s : A, s ∉ m.asIdeal ∧ ∀ m' : PrimeSpectrum A, IsClosed ({m'} : Set (PrimeSpectrum A)) → s * a ∈ m'.asIdeal) → CompactSpace {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} ∧ T2Space {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
by
  intro A _ hcl H
  refine ⟨isCompact_iff_compactSpace.mp hcl.isCompact, ?_⟩
  refine ⟨fun x y hxy => ?_⟩
  have hmax : x.1.asIdeal.IsMaximal :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal x.1).mp x.2
  have hnle : ¬ x.1.asIdeal ≤ y.1.asIdeal := by
    intro hle
    apply hxy
    have heq : x.1.asIdeal = y.1.asIdeal :=
      Ideal.IsMaximal.eq_of_le hmax y.1.isPrime.ne_top hle
    exact Subtype.ext (PrimeSpectrum.ext heq)
  obtain ⟨a, ha, hay⟩ := SetLike.not_le_iff_exists.mp hnle
  obtain ⟨s, hs, hsa⟩ := H x.1 x.2 a ha
  refine ⟨Subtype.val ⁻¹' (PrimeSpectrum.basicOpen s : Set (PrimeSpectrum A)),
    Subtype.val ⁻¹' (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)),
    (PrimeSpectrum.basicOpen s).isOpen.preimage continuous_subtype_val,
    (PrimeSpectrum.basicOpen a).isOpen.preimage continuous_subtype_val, ?_, ?_, ?_⟩
  · show x.1 ∈ PrimeSpectrum.basicOpen s
    exact (PrimeSpectrum.mem_basicOpen s x.1).mpr hs
  · show y.1 ∈ PrimeSpectrum.basicOpen a
    exact (PrimeSpectrum.mem_basicOpen a y.1).mpr hay
  · rw [Set.disjoint_left]
    intro z hzs hza
    have h1 : s ∉ z.1.asIdeal := (PrimeSpectrum.mem_basicOpen s z.1).mp hzs
    have h2 : a ∉ z.1.asIdeal := (PrimeSpectrum.mem_basicOpen a z.1).mp hza
    rcases z.1.isPrime.mem_or_mem (hsa z.1 z.2) with h | h
    · exact h1 h
    · exact h2 h

theorem wc_wl_clopen_idempotent : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → (∀ x : PrimeSpectrum A, ∃! y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) → ∀ U : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, IsClopen U → ∃ e : A, e * e = e ∧ ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, (m ∈ U ↔ e ∉ m.1.asIdeal) :=
by
  intro A _ ha hb U hU
  classical

  have hclosed : ∀ V : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
      IsClosed V → ∀ n : Ideal A, n.IsMaximal →
      PrimeSpectrum.vanishingIdeal (Subtype.val '' V) ≤ n → ∃ m ∈ V, m.1.asIdeal = n := by
    intro V hV n hn hle
    have hVc : IsClosed (Subtype.val '' V) := (IsClosed.isClosedMap_subtype_val ha) V hV
    have hx : (⟨n, hn.isPrime⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
        (PrimeSpectrum.vanishingIdeal (Subtype.val '' V) : Set A) := by
      rw [PrimeSpectrum.mem_zeroLocus]
      exact fun a ha' => hle ha'
    rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hVc.closure_eq] at hx
    obtain ⟨m, hm, hmeq⟩ := hx
    exact ⟨m, hm, by rw [hmeq]⟩

  have hnc : ∀ P : Ideal A, P.IsPrime →
      P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' U) ≠ ⊤ →
      P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) = ⊤ := by
    intro P hP h1
    by_contra h2
    obtain ⟨n1, hn1, hle1⟩ := Ideal.exists_le_maximal _ h1
    obtain ⟨n2, hn2, hle2⟩ := Ideal.exists_le_maximal _ h2
    obtain ⟨m1, hm1U, hm1⟩ := hclosed U hU.isClosed n1 hn1 (le_trans le_sup_right hle1)
    obtain ⟨m2, hm2U, hm2⟩ := hclosed Uᶜ hU.compl.isClosed n2 hn2 (le_trans le_sup_right hle2)
    have sp1 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m1.1 := by
      rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm1]
      exact le_trans le_sup_left hle1
    have sp2 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m2.1 := by
      rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm2]
      exact le_trans le_sup_left hle2
    have heq := (hb ⟨P, hP⟩).unique ⟨m1.2, sp1⟩ ⟨m2.2, sp2⟩
    have hm12 : m1 = m2 := Subtype.ext heq
    exact hm2U (hm12 ▸ hm1U)

  have havoid : ∃ i ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' U),
      ∃ j ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ), (1 - i) * (1 - j) = 0 := by
    set I := PrimeSpectrum.vanishingIdeal (Subtype.val '' U) with hI
    set J := PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) with hJ
    let S : Submonoid A :=
      { carrier := {x | ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j)}
        mul_mem' := by
          rintro a b ⟨i1, hi1, j1, hj1, rfl⟩ ⟨i2, hi2, j2, hj2, rfl⟩
          exact ⟨i1 + i2 - i1 * i2, I.sub_mem (I.add_mem hi1 hi2) (I.mul_mem_right i2 hi1),
            j1 + j2 - j1 * j2, J.sub_mem (J.add_mem hj1 hj2) (J.mul_mem_right j2 hj1), by ring⟩
        one_mem' := by
          show ∃ i ∈ I, ∃ j ∈ J, (1 : A) = (1 - i) * (1 - j)
          exact ⟨0, I.zero_mem, 0, J.zero_mem, by ring⟩ }
    have hS : ∀ x, x ∈ S ↔ ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j) := fun x => Iff.rfl
    by_contra hcon
    have hdisj : Disjoint ((⊥ : Ideal A) : Set A) (S : Set A) := by
      rw [Set.disjoint_left]
      intro x hx hxS
      rw [SetLike.mem_coe, Ideal.mem_bot] at hx
      subst hx
      obtain ⟨i, hi, j, hj, h⟩ := (hS 0).1 hxS
      exact hcon ⟨i, hi, j, hj, h.symm⟩
    obtain ⟨P, hP, -, hPS⟩ := Ideal.exists_le_prime_disjoint ⊥ S hdisj
    have h1 : P ⊔ I ≠ ⊤ := by
      intro htop
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at htop
      obtain ⟨p, hp, i, hi, hpi⟩ := htop
      have hmem : 1 - i ∈ S := (hS _).2 ⟨i, hi, 0, J.zero_mem, by ring⟩
      have hpe : 1 - i = p := by rw [← hpi]; ring
      rw [← hpe] at hp
      exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
    have h2 := hnc P hP h1
    rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at h2
    obtain ⟨p, hp, j, hj, hpj⟩ := h2
    have hmem : 1 - j ∈ S := (hS _).2 ⟨0, I.zero_mem, j, hj, by ring⟩
    have hpe : 1 - j = p := by rw [← hpj]; ring
    rw [← hpe] at hp
    exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
  obtain ⟨i, hi, j, hj, hij⟩ := havoid

  have P1 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∈ U →
      (1 - i) ∉ m.1.asIdeal ∧ (1 - j) ∈ m.1.asIdeal := by
    intro m hm
    have him : i ∈ m.1.asIdeal :=
      (PrimeSpectrum.mem_vanishingIdeal _ _).mp hi m.1 (Set.mem_image_of_mem _ hm)
    have hfn : (1 - i) ∉ m.1.asIdeal := by
      intro hfm
      apply m.1.isPrime.ne_top
      rw [Ideal.eq_top_iff_one]
      have h1 : (1 : A) = (1 - i) + i := by ring
      rw [h1]
      exact m.1.asIdeal.add_mem hfm him
    refine ⟨hfn, ?_⟩
    have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
    exact (m.1.isPrime.mem_or_mem h0).resolve_left hfn
  have P2 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∉ U →
      (1 - j) ∉ m.1.asIdeal ∧ (1 - i) ∈ m.1.asIdeal := by
    intro m hm
    have hjm : j ∈ m.1.asIdeal :=
      (PrimeSpectrum.mem_vanishingIdeal _ _).mp hj m.1
        (Set.mem_image_of_mem _ (show m ∈ Uᶜ from hm))
    have hgn : (1 - j) ∉ m.1.asIdeal := by
      intro hgm
      apply m.1.isPrime.ne_top
      rw [Ideal.eq_top_iff_one]
      have h1 : (1 : A) = (1 - j) + j := by ring
      rw [h1]
      exact m.1.asIdeal.add_mem hgm hjm
    refine ⟨hgn, ?_⟩
    have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
    exact (m.1.isPrime.mem_or_mem h0).resolve_right hgn

  have hunit : IsUnit ((1 - i) + (1 - j)) := by
    by_contra hnu
    obtain ⟨N, hN, hmem⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
    let m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
      ⟨⟨N, hN.isPrime⟩, (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hN⟩
    have hmN : m.1.asIdeal = N := rfl
    by_cases hm : m ∈ U
    · obtain ⟨hf, hg⟩ := P1 m hm
      rw [hmN] at hf hg
      apply hf
      have e1 : 1 - i = ((1 - i) + (1 - j)) - (1 - j) := by ring
      rw [e1]
      exact N.sub_mem hmem hg
    · obtain ⟨hg, hf⟩ := P2 m hm
      rw [hmN] at hf hg
      apply hg
      have e1 : 1 - j = ((1 - i) + (1 - j)) - (1 - i) := by ring
      rw [e1]
      exact N.sub_mem hmem hf
  obtain ⟨u, hu⟩ := hunit
  have h1 : ((1 - i) + (1 - j)) * (↑u⁻¹ : A) = 1 := by rw [← hu, Units.mul_inv]
  refine ⟨(1 - i) * (↑u⁻¹ : A), ?_, ?_⟩
  · linear_combination (-((↑u⁻¹ : A) * (↑u⁻¹ : A))) * hij + ((1 - i) * (↑u⁻¹ : A)) * h1
  · intro m
    constructor
    · intro hm hem
      apply (P1 m hm).1
      have e1 : 1 - i = ((1 - i) * (↑u⁻¹ : A)) * ((1 - i) + (1 - j)) := by
        linear_combination (-(1 - i)) * h1
      rw [e1]
      exact m.1.asIdeal.mul_mem_right _ hem
    · intro hem
      by_contra hm
      exact hem (m.1.asIdeal.mul_mem_right _ (P2 m hm).2)

theorem wc_compactT2_ed_clopen_partition : ∀ (X : Type u) [TopologicalSpace X] [CompactSpace X] [T2Space X] [ExtremallyDisconnected X] (P : Set X → Prop), (∀ U V : Set X, V ⊆ U → P U → P V) → (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ P U) → ∃ (n : ℕ) (U : Fin n → Set X), (∀ i, IsClopen (U i)) ∧ (∀ i, P (U i)) ∧ (∀ i j, i ≠ j → Disjoint (U i) (U j)) ∧ ∀ x, ∃ i, x ∈ U i :=
by
  intro X _ _ _ _ P hmono hloc
  classical
  have hW : ∀ x : X, ∃ W : Set X, IsClopen W ∧ W ∈ nhds x ∧ P W := by
    intro x
    obtain ⟨U, hUo, hxU, hPU⟩ := hloc x
    obtain ⟨t, htn, htc, htU⟩ := exists_mem_nhds_isClosed_subset (hUo.mem_nhds hxU)
    refine ⟨closure (interior t),
      ⟨isClosed_closure, ExtremallyDisconnected.open_closure _ isOpen_interior⟩, ?_, ?_⟩
    · exact Filter.mem_of_superset (interior_mem_nhds.mpr htn) subset_closure
    · exact hmono U _ ((closure_minimal interior_subset htc).trans htU) hPU
  choose W hWc hWn hWP using hW
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover W hWn
  let e := t.equivFin
  let V : Fin t.card → Set X := fun i => W (e.symm i)
  have hVc : ∀ i, IsClopen (V i) := fun i => hWc _
  have hVcov : ∀ x, ∃ i, x ∈ V i := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, W y := ht ▸ Set.mem_univ x
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨e ⟨y, hy⟩, ?_⟩
    show x ∈ W (e.symm (e ⟨y, hy⟩))
    rw [Equiv.symm_apply_apply]
    exact hxy
  let U : Fin t.card → Set X := fun i =>
    V i \ ⋃ j ∈ Finset.univ.filter (fun j => j < i), V j
  refine ⟨t.card, U, ?_, ?_, ?_, ?_⟩
  · intro i
    exact (hVc i).diff (isClopen_biUnion_finset (fun j _ => hVc j))
  · intro i
    exact hmono _ _ Set.diff_subset (hWP _)
  · intro i j hij
    rw [Set.disjoint_left]
    intro x hxi hxj
    rcases lt_or_gt_of_ne hij with h | h
    · exact hxj.2 (Set.mem_biUnion (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩) hxi.1)
    · exact hxi.2 (Set.mem_biUnion (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩) hxj.1)
  · intro x
    let s := Finset.univ.filter (fun i => x ∈ V i)
    have hs : s.Nonempty := by
      obtain ⟨i, hi⟩ := hVcov x
      exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩⟩
    refine ⟨s.min' hs, (Finset.mem_filter.mp (s.min'_mem hs)).2, ?_⟩
    intro hx
    obtain ⟨j, hj, hxj⟩ := Set.mem_iUnion₂.mp hx
    have hjlt := (Finset.mem_filter.mp hj).2
    have hle := s.min'_le j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxj⟩)
    exact absurd hjlt (not_lt.mpr hle)

theorem wc_weaklyEtale_strictHensel_localIso : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], Algebra.WeaklyEtale A B → ∀ (q : Ideal B) [q.IsPrime] (p : Ideal A) [p.IsPrime], q.comap (algebraMap A B) = p → HenselianLocalRing (Localization.AtPrime p) → IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime p)) → (∀ b : B, ∃ (a s : A) (t : B), s ∉ p ∧ t ∉ q ∧ t * (b * algebraMap A B s - algebraMap A B a) = 0) ∧ (∀ a : A, (∃ t : B, t ∉ q ∧ t * algebraMap A B a = 0) → ∃ s : A, s ∉ p ∧ s * a = 0) :=
by
  intro A B _ _ _ hW q _ p _ hpq hHen hSep
  letI alg : Algebra (Localization.AtPrime p) (Localization.AtPrime q) :=
    (Localization.localRingHom p q (algebraMap A B) hpq.symm).toAlgebra
  haveI hAB : Algebra.WeaklyEtale A B := hW
  haveI hBq : Algebra.WeaklyEtale B (Localization.AtPrime q) :=
    wc_localization_weaklyEtale B (Localization.AtPrime q) q.primeCompl
  haveI hAq : Algebra.WeaklyEtale A (Localization.AtPrime q) :=
    Algebra.WeaklyEtale.trans A B (Localization.AtPrime q)
  haveI hAp : Algebra.WeaklyEtale A (Localization.AtPrime p) :=
    wc_localization_weaklyEtale A (Localization.AtPrime p) p.primeCompl
  haveI hTower : IsScalarTower A (Localization.AtPrime p) (Localization.AtPrime q) :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      change algebraMap A (Localization.AtPrime q) x =
        Localization.localRingHom p q (algebraMap A B) hpq.symm
          (algebraMap A (Localization.AtPrime p) x)
      rw [Localization.localRingHom_to_map,
        IsScalarTower.algebraMap_apply A B (Localization.AtPrime q)])
  have hW' : Algebra.WeaklyEtale (Localization.AtPrime p) (Localization.AtPrime q) :=
    wc_weaklyEtale_cancel A _ _ hAp hAq
  have hL : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) :=
    Localization.isLocalHom_localRingHom p q (algebraMap A B) hpq.symm
  have hbij := wc_olivier _ _ hHen hSep hL hW'
  have hbij' : Function.Bijective
      (Localization.localRingHom p q (algebraMap A B) hpq.symm) := hbij
  refine ⟨fun b => ?_, ?_⟩
  · obtain ⟨x, hx⟩ := hbij'.2 (algebraMap B (Localization.AtPrime q) b)
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
    rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_iff_eq_mul, ← map_mul] at hx
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists q.primeCompl (Localization.AtPrime q)).mp hx
    refine ⟨a, s, c, s.2, c.2, ?_⟩
    rw [mul_sub, sub_eq_zero]
    exact hc.symm
  · rintro a ⟨t, ht, hta⟩
    have h1 : algebraMap B (Localization.AtPrime q) (algebraMap A B a) = 0 :=
      (IsLocalization.map_eq_zero_iff q.primeCompl _ _).mpr ⟨⟨t, ht⟩, hta⟩
    have h2 : Localization.localRingHom p q (algebraMap A B) hpq.symm
        (algebraMap A (Localization.AtPrime p) a) =
        Localization.localRingHom p q (algebraMap A B) hpq.symm 0 := by
      rw [Localization.localRingHom_to_map, h1, map_zero]
    have h3 := hbij'.1 h2
    obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ _).mp h3
    exact ⟨s, hs, hsa⟩

theorem wc_wl_fibre_closedPts_t2 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], (∀ m : PrimeSpectrum A, IsClosed ({m} : Set (PrimeSpectrum A)) → ∀ a ∈ m.asIdeal, ∃ s : A, s ∉ m.asIdeal ∧ ∀ m' : PrimeSpectrum A, IsClosed ({m'} : Set (PrimeSpectrum A)) → s * a ∈ m'.asIdeal) → (∀ q : PrimeSpectrum B, IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A)) → ∀ b : B, ∃ (a s : A) (t : B), s ∉ (PrimeSpectrum.comap (algebraMap A B) q).asIdeal ∧ t ∉ q.asIdeal ∧ t * (b * algebraMap A B s - algebraMap A B a) = 0) → T2Space {q : PrimeSpectrum B | IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A))} :=
by
  intro A B _ _ _ Hann Hloc
  have s1 : ∀ q₁ q₂ : PrimeSpectrum B,
      IsClosed ({PrimeSpectrum.comap (algebraMap A B) q₁} : Set (PrimeSpectrum A)) →
      ∀ b : B, b ∈ q₁.asIdeal → b ∉ q₂.asIdeal →
      ∃ U V : Set (PrimeSpectrum B), IsOpen U ∧ IsOpen V ∧ q₁ ∈ U ∧ q₂ ∈ V ∧
        ∀ q : PrimeSpectrum B,
          IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A)) →
          q ∈ U → q ∈ V → False := by
    intro q₁ q₂ hq₁ b hb1 hb2
    obtain ⟨a, s, t, hs, ht, hts⟩ := Hloc q₁ hq₁ b
    have hs' : algebraMap A B s ∉ q₁.asIdeal := by
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at hs
      exact hs
    have ha : a ∈ (PrimeSpectrum.comap (algebraMap A B) q₁).asIdeal := by
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      have h1 : t * (b * algebraMap A B s - algebraMap A B a) ∈ q₁.asIdeal := by
        rw [hts]; exact q₁.asIdeal.zero_mem
      have h2 := (q₁.isPrime.mem_or_mem h1).resolve_left ht
      have h3 : b * algebraMap A B s ∈ q₁.asIdeal := q₁.asIdeal.mul_mem_right _ hb1
      have h4 := q₁.asIdeal.sub_mem h3 h2
      rwa [sub_sub_cancel] at h4
    obtain ⟨s₀, hs₀, hs₀a⟩ := Hann _ hq₁ a ha
    have hs₀' : algebraMap A B s₀ ∉ q₁.asIdeal := by
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at hs₀
      exact hs₀
    refine ⟨((PrimeSpectrum.basicOpen t : Set (PrimeSpectrum B)) ∩
        (PrimeSpectrum.basicOpen (algebraMap A B s) : Set (PrimeSpectrum B))) ∩
        (PrimeSpectrum.basicOpen (algebraMap A B s₀) : Set (PrimeSpectrum B)),
      (PrimeSpectrum.basicOpen b : Set (PrimeSpectrum B)), ?_, ?_, ?_, ?_, ?_⟩
    · exact ((PrimeSpectrum.basicOpen t).isOpen.inter
        (PrimeSpectrum.basicOpen _).isOpen).inter (PrimeSpectrum.basicOpen _).isOpen
    · exact (PrimeSpectrum.basicOpen b).isOpen
    · simp only [Set.mem_inter_iff, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      exact ⟨⟨ht, hs'⟩, hs₀'⟩
    · simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      exact hb2
    · intro q hq hqU hqV
      simp only [Set.mem_inter_iff, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hqU hqV
      obtain ⟨⟨htq, hsq⟩, hs₀q⟩ := hqU
      have e1 := hs₀a _ hq
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, map_mul] at e1
      have e2 := (q.isPrime.mem_or_mem e1).resolve_left hs₀q
      have h1 : t * (b * algebraMap A B s - algebraMap A B a) ∈ q.asIdeal := by
        rw [hts]; exact q.asIdeal.zero_mem
      have h2 := (q.isPrime.mem_or_mem h1).resolve_left htq
      have h3 := q.asIdeal.add_mem h2 e2
      rw [sub_add_cancel] at h3
      exact hqV ((q.isPrime.mem_or_mem h3).resolve_right hsq)
  have s2 : ∀ x y : {q : PrimeSpectrum B |
      IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A))},
      ∀ b : B, b ∈ x.1.asIdeal → b ∉ y.1.asIdeal →
      ∃ u v : Set {q : PrimeSpectrum B |
        IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A))},
        IsOpen u ∧ IsOpen v ∧ x ∈ u ∧ y ∈ v ∧ Disjoint u v := by
    intro x y b hbx hby
    obtain ⟨U, V, hU, hV, hxU, hyV, hdis⟩ := s1 x.1 y.1 x.2 b hbx hby
    refine ⟨Subtype.val ⁻¹' U, Subtype.val ⁻¹' V, hU.preimage continuous_subtype_val,
      hV.preimage continuous_subtype_val, hxU, hyV, ?_⟩
    rw [Set.disjoint_left]
    intro z hzU hzV
    exact hdis z.1 z.2 hzU hzV
  rw [t2Space_iff]
  intro x y hxy
  have hne : x.1.asIdeal ≠ y.1.asIdeal := fun h => hxy (Subtype.ext (PrimeSpectrum.ext h))
  by_cases hle : x.1.asIdeal ≤ y.1.asIdeal
  · have hnle : ¬ y.1.asIdeal ≤ x.1.asIdeal := fun h => hne (le_antisymm hle h)
    obtain ⟨b, hby, hbx⟩ := SetLike.not_le_iff_exists.mp hnle
    obtain ⟨u, v, hu, hv, hyu, hxv, hd⟩ := s2 y x b hby hbx
    exact ⟨v, u, hv, hu, hxv, hyu, hd.symm⟩
  · obtain ⟨b, hbx, hby⟩ := SetLike.not_le_iff_exists.mp hle
    exact s2 x y b hbx hby

theorem wc_wl_gleason_section : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → T2Space {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → ExtremallyDisconnected {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → T2Space {q : PrimeSpectrum B | IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A))} → Function.Surjective (PrimeSpectrum.comap (algebraMap A B)) → ∃ τ : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → PrimeSpectrum B, Continuous τ ∧ ∀ m, PrimeSpectrum.comap (algebraMap A B) (τ m) = m.1 :=
by
  intro A B _ _ _ hX hT2X hED hT2Y hS
  haveI := hT2X
  haveI := hED
  haveI := hT2Y
  haveI : CompactSpace {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
    isCompact_iff_compactSpace.mp hX.isCompact
  have hY : IsClosed {q : PrimeSpectrum B |
      IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A))} :=
    hX.preimage (PrimeSpectrum.continuous_comap (algebraMap A B))
  haveI : CompactSpace {q : PrimeSpectrum B |
      IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A))} :=
    isCompact_iff_compactSpace.mp hY.isCompact
  let g : {q : PrimeSpectrum B |
      IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A))} →
      {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
    fun q => ⟨PrimeSpectrum.comap (algebraMap A B) q.1, q.2⟩
  have hg : Continuous g :=
    ((PrimeSpectrum.continuous_comap (algebraMap A B)).comp continuous_subtype_val).subtype_mk _
  have hgs : Function.Surjective g := by
    intro m
    obtain ⟨q, hq⟩ := hS m.1
    have hqY : IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A)) := by
      rw [hq]; exact m.2
    exact ⟨⟨q, hqY⟩, Subtype.ext hq⟩
  obtain ⟨h, hh, hgh⟩ := CompactT2.ExtremallyDisconnected.projective continuous_id hg hgs
  refine ⟨fun m => (h m).1, continuous_subtype_val.comp hh, fun m => ?_⟩
  exact congrArg Subtype.val (congrFun hgh m)

theorem wc_wl_glue_local_preimages : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (τ : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → PrimeSpectrum B), Continuous τ → (∀ m, PrimeSpectrum.comap (algebraMap A B) (τ m) = m.1) → (∀ U : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, IsClopen U → ∃ e : A, e * e = e ∧ ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, (m ∈ U ↔ e ∉ m.1.asIdeal)) → (∀ P : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → Prop, (∀ U V, V ⊆ U → P U → P V) → (∀ x, ∃ U, IsOpen U ∧ x ∈ U ∧ P U) → ∃ (n : ℕ) (U : Fin n → Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}), (∀ i, IsClopen (U i)) ∧ (∀ i, P (U i)) ∧ (∀ i j, i ≠ j → Disjoint (U i) (U j)) ∧ ∀ x, ∃ i, x ∈ U i) → (∀ (m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}) (b : B), ∃ (a s : A) (t : B), s ∉ m.1.asIdeal ∧ t ∉ (τ m).asIdeal ∧ t * (b * algebraMap A B s - algebraMap A B a) = 0) → ∃ ρ : B → A, ∀ (b : B) (m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}), ∃ t : B, t ∉ (τ m).asIdeal ∧ t * (algebraMap A B (ρ b) - b) = 0 :=
by
  intro A B _ _ _ τ hτc hτ Hidem Hpart Hloc
  classical

  have UC : ∀ x : A, (∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
      x ∉ m.1.asIdeal) → IsUnit x := by
    intro x hx
    by_contra hnu
    obtain ⟨I, hI, hxI⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
    let P : PrimeSpectrum A := ⟨I, hI.isPrime⟩
    have hP : IsClosed ({P} : Set (PrimeSpectrum A)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal P).mpr hI
    exact hx ⟨P, hP⟩ hxI

  have TF : ∀ (m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}) (x : A),
      x ∉ m.1.asIdeal → algebraMap A B x ∉ (τ m).asIdeal := by
    intro m x hx hφ
    apply hx
    have h : m.1.asIdeal = Ideal.comap (algebraMap A B) (τ m).asIdeal := by
      rw [← PrimeSpectrum.comap_asIdeal, hτ m]
    rw [h, Ideal.mem_comap]
    exact hφ
  have key : ∀ b : B, ∃ r : A, ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
      ∃ t : B, t ∉ (τ m).asIdeal ∧ t * (algebraMap A B r - b) = 0 := by
    intro b
    obtain ⟨n, W, hclopen, hP, hdisj, hcover⟩ := Hpart
      (fun V => ∃ (a s : A) (t : B), (∀ m' ∈ V, s ∉ m'.1.asIdeal ∧ t ∉ (τ m').asIdeal) ∧
        t * (b * algebraMap A B s - algebraMap A B a) = 0)
      (by
        rintro U V hVU ⟨a, s, t, hm, he⟩
        exact ⟨a, s, t, fun m' hm' => hm m' (hVU hm'), he⟩)
      (by
        intro x
        obtain ⟨a, s, t, hs, ht, he⟩ := Hloc x b
        refine ⟨Subtype.val ⁻¹' (PrimeSpectrum.basicOpen s : Set (PrimeSpectrum A)) ∩
          τ ⁻¹' (PrimeSpectrum.basicOpen t : Set (PrimeSpectrum B)), ?_, ?_, ?_⟩
        · exact ((PrimeSpectrum.basicOpen s).isOpen.preimage continuous_subtype_val).inter
            ((PrimeSpectrum.basicOpen t).isOpen.preimage hτc)
        · exact ⟨hs, ht⟩
        · exact ⟨a, s, t, fun m' hm' => ⟨hm'.1, hm'.2⟩, he⟩)
    choose a s t hmem hab using hP
    choose e he hiff using fun j => Hidem (W j) (hclopen j)
    have horth : ∀ j k, j ≠ k → e j * e k = 0 := by
      intro j k hjk
      have hzz : (e j * e k) * (e j * e k) = e j * e k := by
        calc (e j * e k) * (e j * e k) = (e j * e j) * (e k * e k) := by ring
          _ = e j * e k := by rw [he j, he k]
      have hzm : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
          e j * e k ∈ m.1.asIdeal := by
        intro m
        by_contra hzn
        have hj : e j ∉ m.1.asIdeal := fun h => hzn (Ideal.mul_mem_right _ _ h)
        have hk : e k ∉ m.1.asIdeal := fun h => hzn (Ideal.mul_mem_left _ _ h)
        exact Set.disjoint_left.mp (hdisj j k hjk) ((hiff j m).mpr hj) ((hiff k m).mpr hk)
      have h1 : IsUnit (1 - e j * e k) := by
        apply UC
        intro m hm
        apply m.1.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have := Ideal.add_mem _ hm (hzm m)
        simpa using this
      obtain ⟨w, hw⟩ := h1.exists_left_inv
      linear_combination (-(e j * e k)) * hw - w * hzz
    have hunit : ∀ j, IsUnit (s j * e j + 1 - e j) := by
      intro j
      apply UC
      intro m hu
      by_cases hej : e j ∈ m.1.asIdeal
      · apply m.1.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have h2 : s j * e j ∈ m.1.asIdeal := Ideal.mul_mem_left _ _ hej
        have := Ideal.add_mem _ (Ideal.sub_mem _ hu h2) hej
        convert this using 1
        ring
      · have hmW := (hiff j m).mpr hej
        have hs := (hmem j m hmW).1
        have h1e : 1 - e j ∈ m.1.asIdeal := by
          have h0 : e j * (1 - e j) ∈ m.1.asIdeal := by
            have h00 : e j * (1 - e j) = 0 := by linear_combination -(he j)
            rw [h00]
            exact Ideal.zero_mem _
          exact (m.1.isPrime.mem_or_mem h0).resolve_left hej
        have hse : s j * e j ∈ m.1.asIdeal := by
          have := Ideal.sub_mem _ hu h1e
          convert this using 1
          ring
        exact (m.1.isPrime.mem_or_mem hse).elim hs hej
    choose v hv using fun j => (hunit j).exists_left_inv
    obtain ⟨r, hr⟩ : ∃ r : A, r = ∑ j, e j * a j * v j := ⟨_, rfl⟩
    have hek : ∀ k, e k * r = e k * a k * v k := by
      intro k
      rw [hr, Finset.mul_sum, Finset.sum_eq_single_of_mem k (Finset.mem_univ k)]
      · linear_combination (a k * v k) * he k
      · intro j _ hjk
        have h0 : e k * e j = 0 := horth k j (Ne.symm hjk)
        linear_combination (a j * v j) * h0
    have hsol : ∀ k, s k * e k * r = e k * a k := by
      intro k
      linear_combination (s k * e k + 1 - e k) * hek k + e k * a k * hv k - (s k - 1) * r * he k
    refine ⟨r, fun m => ?_⟩
    obtain ⟨k, hk⟩ := hcover m
    obtain ⟨hs, ht⟩ := hmem k m hk
    have hek' : e k ∉ m.1.asIdeal := (hiff k m).mp hk
    refine ⟨t k * algebraMap A B (e k) * algebraMap A B (s k), ?_, ?_⟩
    · intro hin
      rcases (τ m).isPrime.mem_or_mem hin with h | h
      · rcases (τ m).isPrime.mem_or_mem h with h | h
        · exact ht h
        · exact TF m _ hek' h
      · exact TF m _ hs h
    · have hφ := congrArg (algebraMap A B) (hsol k)
      simp only [map_mul] at hφ
      linear_combination (t k) * hφ - algebraMap A B (e k) * hab k
  choose ρ hρ using key
  exact ⟨ρ, hρ⟩

theorem wc_wl_algHom_of_local_inverse : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (τ : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → PrimeSpectrum B) (ρ : B → A), (∀ (m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}) (a : A), (∃ t : B, t ∉ (τ m).asIdeal ∧ t * algebraMap A B a = 0) → ∃ s : A, s ∉ m.1.asIdeal ∧ s * a = 0) → (∀ (b : B) (m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}), ∃ t : B, t ∉ (τ m).asIdeal ∧ t * (algebraMap A B (ρ b) - b) = 0) → Nonempty (B →ₐ[A] A) :=
by
  intro A B _ _ _ τ ρ Hinj Hρ

  have s1 : ∀ a : A, (∀ m : PrimeSpectrum A, IsClosed ({m} : Set (PrimeSpectrum A)) →
      ∃ s : A, s ∉ m.asIdeal ∧ s * a = 0) → a = 0 := by
    intro a ha
    by_contra hne
    have hI : (Submodule.span A {a}).annihilator ≠ ⊤ := by
      intro htop
      apply hne
      have h1 : (1 : A) ∈ (Submodule.span A {a}).annihilator := by
        rw [htop]; exact Submodule.mem_top
      rw [Submodule.mem_annihilator_span_singleton, one_smul] at h1
      exact h1
    obtain ⟨M, hM, hIM⟩ := Ideal.exists_le_maximal _ hI
    obtain ⟨s, hs, hsa⟩ := ha ⟨M, hM.isPrime⟩
      ((PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hM)
    apply hs
    apply hIM
    rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul]
    exact hsa

  have key : ∀ a : A, (∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
      ∃ t : B, t ∉ (τ m).asIdeal ∧ t * algebraMap A B a = 0) → a = 0 := by
    intro a ha
    apply s1 a
    intro m hm
    exact Hinj ⟨m, hm⟩ a (ha ⟨m, hm⟩)
  have hone : ρ 1 = 1 := by
    rw [← sub_eq_zero]
    apply key
    intro m
    obtain ⟨t, ht, h⟩ := Hρ 1 m
    exact ⟨t, ht, by rw [map_sub, map_one]; exact h⟩
  have hzero : ρ 0 = 0 := by
    apply key
    intro m
    obtain ⟨t, ht, h⟩ := Hρ 0 m
    exact ⟨t, ht, by rw [sub_zero] at h; exact h⟩
  have hadd : ∀ x y : B, ρ (x + y) = ρ x + ρ y := by
    intro x y
    have h0 : ρ (x + y) - ρ x - ρ y = 0 := by
      apply key
      intro m
      obtain ⟨t1, ht1, h1⟩ := Hρ (x + y) m
      obtain ⟨t2, ht2, h2⟩ := Hρ x m
      obtain ⟨t3, ht3, h3⟩ := Hρ y m
      refine ⟨t1 * t2 * t3,
        (τ m).isPrime.mul_notMem ((τ m).isPrime.mul_notMem ht1 ht2) ht3, ?_⟩
      rw [map_sub, map_sub]
      linear_combination t2 * t3 * h1 - t1 * t3 * h2 - t1 * t2 * h3
    linear_combination h0
  have hmul : ∀ x y : B, ρ (x * y) = ρ x * ρ y := by
    intro x y
    have h0 : ρ (x * y) - ρ x * ρ y = 0 := by
      apply key
      intro m
      obtain ⟨t1, ht1, h1⟩ := Hρ (x * y) m
      obtain ⟨t2, ht2, h2⟩ := Hρ x m
      obtain ⟨t3, ht3, h3⟩ := Hρ y m
      refine ⟨t1 * t2 * t3,
        (τ m).isPrime.mul_notMem ((τ m).isPrime.mul_notMem ht1 ht2) ht3, ?_⟩
      rw [map_sub, map_mul]
      linear_combination t2 * t3 * h1 - t1 * t2 * x * h3 - t1 * t3 * algebraMap A B (ρ y) * h2
    linear_combination h0
  have hcomm : ∀ r : A, ρ (algebraMap A B r) = r := by
    intro r
    rw [← sub_eq_zero]
    apply key
    intro m
    obtain ⟨t, ht, h⟩ := Hρ (algebraMap A B r) m
    exact ⟨t, ht, by rw [map_sub]; exact h⟩
  exact ⟨{ toFun := ρ
           map_one' := hone
           map_mul' := hmul
           map_zero' := hzero
           map_add' := hadd
           commutes' := fun r => hcomm r }⟩

theorem wc_specMap_weaklyEtale_surj_ring : ∀ (R S : CommRingCat.{u}) (f : R ⟶ S), WeaklyEtale (Spec.map f) → Surjective (Spec.map f) → @Algebra.WeaklyEtale R S _ _ f.hom.toAlgebra ∧ Function.Surjective (PrimeSpectrum.comap f.hom) :=
by
  have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
    intro R' S' _ _ _ hW
    have hfl : Module.Flat R' S' := by
      have := hW.flat
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at this
      exact this
    have hd := hW.flat_diagonal
    rw [diagonal_SpecMap] at hd
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
            (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      haveI := hd
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
    exact Algebra.WeaklyEtale.mk hfl hmu
  intro R S f hW hS
  letI : Algebra R S := f.hom.toAlgebra
  refine ⟨?_, ?_⟩
  · have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    exact toRing R S hW'
  · intro y
    obtain ⟨x, hx⟩ := hS.surj y
    exact ⟨x, hx⟩

theorem wc_wlocal_strictHensel_retraction : ∀ (Δ : Scheme.{u}), IsAffine Δ → IsClosed {x : Δ | IsClosed ({x} : Set Δ)} → (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) → ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} → (∀ x : Δ, IsClosed ({x} : Set Δ) → HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)) → ∀ (E : Scheme.{u}) (p : E ⟶ Δ), IsAffine E → WeaklyEtale p → Surjective p → ∃ σ : Δ ⟶ E, σ ≫ p = 𝟙 Δ :=
by

  have ring_level : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B],
      IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} →
      (∀ x : PrimeSpectrum A, ∃! y : PrimeSpectrum A,
        IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) →
      ExtremallyDisconnected {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} →
      (∀ m : PrimeSpectrum A, IsClosed ({m} : Set (PrimeSpectrum A)) →
        HenselianLocalRing (Localization.AtPrime m.asIdeal) ∧
          IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m.asIdeal))) →
      Algebra.WeaklyEtale A B → Function.Surjective (PrimeSpectrum.comap (algebraMap A B)) →
      Nonempty (B →ₐ[A] A) := by
    intro A B _ _ _ ha hb hc hd hW hS
    have Hann := wc_wl_closedPt_annihilate A ha
    obtain ⟨hcpt, ht2⟩ := wc_wl_closedPts_compact_t2 A ha Hann
    haveI := hcpt
    haveI := ht2
    haveI := hc
    have Hidem := wc_wl_clopen_idempotent A ha hb
    have Hpart := fun P h1 h2 =>
      wc_compactT2_ed_clopen_partition
        {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} P h1 h2
    have Hloc' : ∀ q : PrimeSpectrum B,
        IsClosed ({PrimeSpectrum.comap (algebraMap A B) q} : Set (PrimeSpectrum A)) →
        (∀ b : B, ∃ (a s : A) (t : B), s ∉ (PrimeSpectrum.comap (algebraMap A B) q).asIdeal ∧
          t ∉ q.asIdeal ∧ t * (b * algebraMap A B s - algebraMap A B a) = 0) ∧
        (∀ a : A, (∃ t : B, t ∉ q.asIdeal ∧ t * algebraMap A B a = 0) →
          ∃ s : A, s ∉ (PrimeSpectrum.comap (algebraMap A B) q).asIdeal ∧ s * a = 0) := by
      intro q hq
      exact wc_weaklyEtale_strictHensel_localIso A B hW q.asIdeal
        (PrimeSpectrum.comap (algebraMap A B) q).asIdeal
        (PrimeSpectrum.comap_asIdeal _ _).symm (hd _ hq).1 (hd _ hq).2
    have ht2Y := wc_wl_fibre_closedPts_t2 A B Hann (fun q hq b => (Hloc' q hq).1 b)
    obtain ⟨τ, hτc, hτ⟩ := wc_wl_gleason_section A B ha ht2 hc ht2Y hS
    have hτcl : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
        IsClosed ({PrimeSpectrum.comap (algebraMap A B) (τ m)} : Set (PrimeSpectrum A)) := by
      intro m
      rw [hτ m]
      exact m.2
    have Hloc : ∀ (m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}) (b : B),
        ∃ (a s : A) (t : B), s ∉ m.1.asIdeal ∧ t ∉ (τ m).asIdeal ∧
          t * (b * algebraMap A B s - algebraMap A B a) = 0 := by
      intro m b
      have h := (Hloc' (τ m) (hτcl m)).1 b
      rw [hτ m] at h
      exact h
    have Hinj : ∀ (m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}) (a : A),
        (∃ t : B, t ∉ (τ m).asIdeal ∧ t * algebraMap A B a = 0) →
          ∃ s : A, s ∉ m.1.asIdeal ∧ s * a = 0 := by
      intro m a ht
      have h := (Hloc' (τ m) (hτcl m)).2 a ht
      rw [hτ m] at h
      exact h
    obtain ⟨ρ, hρ⟩ := wc_wl_glue_local_preimages A B τ hτc hτ Hidem Hpart Hloc
    exact wc_wl_algHom_of_local_inverse A B τ ρ Hinj hρ

  intro Δ hΔ ha hb hc hd E p hE hW hS
  haveI := hΔ
  haveI := hE
  letI : Algebra Γ(Δ, ⊤) Γ(E, ⊤) := p.appTop.hom.toAlgebra
  have hnat : Spec.map p.appTop = E.isoSpec.inv ≫ p ≫ Δ.isoSpec.hom := by
    rw [← Category.assoc, ← Scheme.isoSpec_inv_naturality p, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]
  have hWS : WeaklyEtale (Spec.map p.appTop) := by rw [hnat]; infer_instance
  have hSS : Surjective (Spec.map p.appTop) := by rw [hnat]; infer_instance
  obtain ⟨hW', hS'⟩ := wc_specMap_weaklyEtale_surj_ring _ _ p.appTop hWS hSS
  obtain ⟨ha', hb', hc'⟩ := wc_wl_conditions_homeomorph Δ (PrimeSpectrum Γ(Δ, ⊤))
    (Scheme.homeoOfIso Δ.isoSpec) ha hb hc
  obtain ⟨ψ⟩ := ring_level Γ(Δ, ⊤) Γ(E, ⊤) ha' hb' hc'
    (wc_affine_closedPt_strictHensel Δ hd) hW' hS'
  have hcomp : p.appTop ≫ (CommRingCat.ofHom ψ.toRingHom : Γ(E, ⊤) ⟶ Γ(Δ, ⊤)) = 𝟙 _ := by
    ext a
    exact ψ.commutes a
  refine ⟨Δ.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom ψ.toRingHom : Γ(E, ⊤) ⟶ Γ(Δ, ⊤)) ≫
    E.isoSpec.inv, ?_⟩
  rw [Category.assoc, Category.assoc, ← Scheme.isoSpec_inv_naturality p,
    ← Category.assoc (Spec.map _), ← Spec.map_comp, hcomp, Spec.map_id, Category.id_comp,
    Iso.hom_inv_id]

theorem wc_affine_WL_topology_iff : ∀ (Δ : Scheme.{u}), IsAffine Δ → (IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ↔ IsClosed {p : PrimeSpectrum Γ(Δ, ⊤) | p.asIdeal.IsMaximal}) ∧ ((∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ↔ (∀ p : PrimeSpectrum Γ(Δ, ⊤), ∃! m : PrimeSpectrum Γ(Δ, ⊤), m.asIdeal.IsMaximal ∧ p ≤ m)) ∧ (ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ↔ ExtremallyDisconnected {p : PrimeSpectrum Γ(Δ, ⊤) | p.asIdeal.IsMaximal}) :=
by
  intro Δ hΔ
  haveI := hΔ
  let h : Δ ≃ₜ PrimeSpectrum Γ(Δ, ⊤) :=
    (Scheme.homeoOfIso Δ.isoSpec).trans (Homeomorph.refl (PrimeSpectrum Γ(Δ, ⊤)))
  have K : ∀ x : Δ, IsClosed ({x} : Set Δ) ↔ (h x).asIdeal.IsMaximal := by
    intro x
    rw [← h.isClosed_image, Set.image_singleton, PrimeSpectrum.isClosed_singleton_iff_isMaximal]
  have S : ∀ x y : Δ, x ⤳ y ↔ h x ≤ h y := by
    intro x y
    rw [PrimeSpectrum.le_iff_specializes, h.isInducing.specializes_iff]
  have hs : {x : Δ | IsClosed ({x} : Set Δ)} =
      ⇑h ⁻¹' {p : PrimeSpectrum Γ(Δ, ⊤) | p.asIdeal.IsMaximal} := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_preimage]
    exact K x
  refine ⟨?_, ?_, ?_⟩
  · rw [hs]
    exact h.isClosed_preimage
  · constructor
    · intro H p
      obtain ⟨y, ⟨hy1, hy2⟩, hyu⟩ := H (h.symm p)
      refine ⟨h y, ⟨(K y).mp hy1, ?_⟩, ?_⟩
      · have := (S _ _).mp hy2
        rwa [h.apply_symm_apply] at this
      · rintro m ⟨hm1, hm2⟩
        have e : h.symm m = y := by
          apply hyu
          refine ⟨(K _).mpr (by rwa [h.apply_symm_apply]), ?_⟩
          rw [S, h.apply_symm_apply, h.apply_symm_apply]
          exact hm2
        rw [← e, h.apply_symm_apply]
    · intro H x
      obtain ⟨m, ⟨hm1, hm2⟩, hmu⟩ := H (h x)
      refine ⟨h.symm m, ⟨(K _).mpr (by rwa [h.apply_symm_apply]), ?_⟩, ?_⟩
      · rw [S, h.apply_symm_apply]
        exact hm2
      · rintro y ⟨hy1, hy2⟩
        have e : h y = m := hmu (h y) ⟨(K y).mp hy1, (S x y).mp hy2⟩
        rw [← e, h.symm_apply_apply]
  · have e := h.sets hs
    constructor
    · intro H
      exact @extremallyDisconnected_of_homeo _ _ _ _ H e
    · intro H
      exact @extremallyDisconnected_of_homeo _ _ _ _ H e.symm

theorem wc_affine_WL_stalk_iff : ∀ (Δ : Scheme.{u}), IsAffine Δ → (∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) → HenselianLocalRing R → HenselianLocalRing S) ∧ (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) → ((∀ x : Δ, IsClosed ({x} : Set Δ) → HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)) ↔ (∀ (m : Ideal Γ(Δ, ⊤)) [m.IsMaximal], HenselianLocalRing (Localization.AtPrime m) ∧ IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m)))) :=
by
  intro Δ hΔ T
  haveI : IsAffine Δ := hΔ
  obtain ⟨T₁, T₂⟩ := T
  constructor
  · intro hL m hm
    let p : PrimeSpectrum Γ(Δ, ⊤) := ⟨m, hm.isPrime⟩
    have hp : IsClosed ({p} : Set (PrimeSpectrum Γ(Δ, ⊤))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hm
    have hcl : IsClosed ({Δ.isoSpec.inv p} : Set Δ) := by
      have := (Scheme.homeoOfIso Δ.isoSpec.symm).isClosedMap ({p} : Set (Spec Γ(Δ, ⊤))) hp
      convert this using 1
      exact (Set.image_singleton (f := (Scheme.homeoOfIso Δ.isoSpec.symm)) (a := p)).symm
    let e : Δ.presheaf.stalk (Δ.isoSpec.inv p) ≃+* Localization.AtPrime p.asIdeal :=
      (asIso (Scheme.Hom.stalkMap Δ.isoSpec.inv (show (Spec Γ(Δ, ⊤) : Scheme.{u}) from p)) ≪≫
        Spec.stalkIso Γ(Δ, ⊤) p).commRingCatIsoToRingEquiv
    obtain ⟨h1, h2⟩ := hL _ hcl
    exact ⟨T₁ _ _ e h1, T₂ _ _ (IsLocalRing.ResidueField.mapEquiv e) h2⟩
  · intro hR x hx
    have hy0 : IsClosed ({Scheme.homeoOfIso Δ.isoSpec x} : Set (Spec Γ(Δ, ⊤))) :=
      (Set.image_singleton (f := Scheme.homeoOfIso Δ.isoSpec) (a := x)) ▸
        (Scheme.homeoOfIso Δ.isoSpec).isClosedMap {x} hx
    have hy : IsClosed ({Δ.isoSpec.hom x} : Set (PrimeSpectrum Γ(Δ, ⊤))) := hy0
    have hmax : (Δ.isoSpec.hom x).asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hy
    have hRy := @hR (Δ.isoSpec.hom x).asIdeal hmax
    let e : Localization.AtPrime (Δ.isoSpec.hom x).asIdeal ≃+* Δ.presheaf.stalk x :=
      ((Spec.stalkIso Γ(Δ, ⊤) (Δ.isoSpec.hom x)).symm ≪≫
        asIso (Scheme.Hom.stalkMap Δ.isoSpec.hom x)).commRingCatIsoToRingEquiv
    exact ⟨T₁ _ _ e hRy.1, T₂ _ _ (IsLocalRing.ResidueField.mapEquiv e) hRy.2⟩

theorem wc_strictHensel_finite_idem_decomp : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∃ (n : ℕ) (e : Fin n → B), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, ∃ (_ : HenselianLocalRing (Localization.Away (e i))), IsSepClosed (IsLocalRing.ResidueField (Localization.Away (e i))) ∧ IsLocalHom ((algebraMap B (Localization.Away (e i))).comp (algebraMap A B)) :=
by
  intro A _ _ hscA
  classical

  have s1 : ∀ (A0 : Type u) [CommRing A0] [HenselianLocalRing A0] (E : Type u) [CommRing E]
      [Algebra A0 E], Algebra.Etale A0 E → ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
      ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
    intro A0 _ hHen
    have sstd : ∀ (S : Type u) [CommRing S] [Algebra A0 S], Algebra.IsStandardEtale A0 S →
        ∀ φ : S →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : S →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A0).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A0)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A0] IsLocalRing.ResidueField A0 :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := sstd _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A0 E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have s2 : ∀ (A0 : Type u) [CommRing A0] [IsLocalRing A0],
      (∀ (E : Type u) [CommRing E] [Algebra A0 E], Algebra.Etale A0 E →
        ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ) →
      ∀ (f : Polynomial A0) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A0)), f.Monic →
        g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A0) = g₀ * h₀ →
        ∃ g h : Polynomial A0, g.Monic ∧ h.Monic ∧ f = g * h ∧
          g.map (IsLocalRing.residue A0) = g₀ ∧ h.map (IsLocalRing.residue A0) = h₀ := by
    intro A0 _ _ s3 f g₀ h₀ hf hg hh hc hfac
    have hofId : ((Algebra.ofId A0 (IsLocalRing.ResidueField A0) :
        A0 →ₐ[A0] IsLocalRing.ResidueField A0) :
        A0 →+* IsLocalRing.ResidueField A0) = IsLocalRing.residue A0 := by
      ext x
      show Algebra.ofId A0 (IsLocalRing.ResidueField A0) x = IsLocalRing.residue A0 x
      rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq A0 f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A0)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap A0 (IsLocalRing.ResidueField A0)) (p : Polynomial A0) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A0)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
    have nat : ∀ (ψ : A0 →ₐ[A0] IsLocalRing.ResidueField A0),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A0 (IsLocalRing.ResidueField A0))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p ((Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2.monic, ?_,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl

  have s5 : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K], IsSepClosed k →
      Algebra.IsAlgebraic k K → IsSepClosed K := by
    intro k K _ _ _ hk hal
    haveI : IsAlgClosure k (AlgebraicClosure K) := IsAlgClosure.ofAlgebraic k K (AlgebraicClosure K)
    haveI : IsPurelyInseparable k (AlgebraicClosure K) :=
      (isSepClosed_iff_isPurelyInseparable_algebraicClosure k (AlgebraicClosure K)).mp hk
    haveI : IsPurelyInseparable K (AlgebraicClosure K) :=
      IsPurelyInseparable.tower_top k K (AlgebraicClosure K)
    exact (isSepClosed_iff_isPurelyInseparable_algebraicClosure K (AlgebraicClosure K)).mpr
      inferInstance

  have L := wc_idempotent_lift_of_factor_lift A (s2 A (s1 A))
  intro B _ _ hB
  obtain ⟨n, e, h1, h2, h3, h4⟩ := wc_finite_alg_local_idempotents A L B hB
  refine ⟨n, e, h1, h2, h3, fun i => ?_⟩
  exact @wc_local_factor_strictly_henselian A _ _ hscA (wc_finite_local_henselian A L) s5 B _ _
    hB (e i) (h1 i) (h4 i)

theorem wc_finite_over_wlocal_wlocal : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], Module.Finite A B → (∀ p : PrimeSpectrum A, ∃! m : PrimeSpectrum A, m.asIdeal.IsMaximal ∧ p ≤ m) → (∀ (m : Ideal A) [m.IsMaximal], HenselianLocalRing (Localization.AtPrime m) ∧ IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m))) → (∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (B' : Type u) [CommRing B'] [Algebra A' B'], Module.Finite A' B' → ∃ (n : ℕ) (e : Fin n → B'), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, ∃ (_ : HenselianLocalRing (Localization.Away (e i))), IsSepClosed (IsLocalRing.ResidueField (Localization.Away (e i))) ∧ IsLocalHom ((algebraMap B' (Localization.Away (e i))).comp (algebraMap A' B'))) → ∀ p : PrimeSpectrum B, ∃! n : PrimeSpectrum B, n.asIdeal.IsMaximal ∧ p ≤ n :=
by
  intro A B _ _ _ hfin hb hd H P
  classical
  have : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  have hint : (algebraMap A B).IsIntegral := algebraMap_isIntegral_iff.mpr inferInstance
  have key : ∀ N₁ N₂ : Ideal B, N₁.IsMaximal → N₂.IsMaximal → P.asIdeal ≤ N₁ →
      P.asIdeal ≤ N₂ → N₁ = N₂ := by
    intro N₁ N₂ h1 h2 hP1 hP2
    have hc1 : (N₁.comap (algebraMap A B)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint N₁
    have hc2 : (N₂.comap (algebraMap A B)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint N₂
    obtain ⟨m, ⟨hm, hpm⟩, huniq⟩ := hb (PrimeSpectrum.comap (algebraMap A B) P)
    have e1 : (⟨N₁.comap (algebraMap A B), hc1.isPrime⟩ : PrimeSpectrum A) = m :=
      huniq _ ⟨hc1, (Ideal.comap_mono hP1 : _)⟩
    have e2 : (⟨N₂.comap (algebraMap A B), hc2.isPrime⟩ : PrimeSpectrum A) = m :=
      huniq _ ⟨hc2, (Ideal.comap_mono hP2 : _)⟩
    have hN1m : N₁.comap (algebraMap A B) = m.asIdeal := congrArg PrimeSpectrum.asIdeal e1
    have hN2m : N₂.comap (algebraMap A B) = m.asIdeal := congrArg PrimeSpectrum.asIdeal e2
    have hPm : P.asIdeal.comap (algebraMap A B) ≤ m.asIdeal := hpm
    have : m.asIdeal.IsMaximal := hm
    obtain ⟨hhen, hsep⟩ := hd m.asIdeal
    let S := Algebra.algebraMapSubmonoid B m.asIdeal.primeCompl
    have hfin' : Module.Finite (Localization.AtPrime m.asIdeal) (Localization S) :=
      Module.Finite.of_isLocalization A B m.asIdeal.primeCompl
    obtain ⟨n, e, hidem, horth, hsum, hloc⟩ := H (Localization.AtPrime m.asIdeal) (Localization S) hfin'
    have hdisj : ∀ Q : Ideal B, Q.comap (algebraMap A B) ≤ m.asIdeal →
        Disjoint (S : Set B) (Q : Set B) := by
      intro Q hQm
      rw [Set.disjoint_left]
      intro x hxS hx
      obtain ⟨a, ha, rfl⟩ := hxS
      exact ha (hQm hx)
    let ψ := algebraMap B (Localization S)
    have hPp : (P.asIdeal.map ψ).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint S _ _ P.isPrime (hdisj _ hPm)
    have hN1p : (N₁.map ψ).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint S _ _ h1.isPrime (hdisj _ hN1m.le)
    have hN2p : (N₂.map ψ).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint S _ _ h2.isPrime (hdisj _ hN2m.le)
    obtain ⟨i, hi⟩ : ∃ i, e i ∉ P.asIdeal.map ψ := by
      by_contra hcon
      push_neg at hcon
      apply hPp.ne_top
      rw [Ideal.eq_top_iff_one, ← hsum]
      exact Ideal.sum_mem _ (fun j _ => hcon j)
    have hej : ∀ j, j ≠ i → e j ∈ P.asIdeal.map ψ := by
      intro j hj
      have : e i * e j ∈ P.asIdeal.map ψ := by
        rw [horth i j (Ne.symm hj)]; exact Ideal.zero_mem _
      exact (hPp.mem_or_mem this).resolve_left hi
    have hnot : ∀ N' : Ideal (Localization S), N'.IsPrime → P.asIdeal.map ψ ≤ N' → e i ∉ N' := by
      intro N' hN' hle hiN
      apply hN'.ne_top
      rw [Ideal.eq_top_iff_one, ← hsum]
      refine Ideal.sum_mem _ (fun j _ => ?_)
      by_cases hji : j = i
      · rw [hji]; exact hiN
      · exact hle (hej j hji)
    obtain ⟨hhen_i, -, -⟩ := hloc i
    let φ := algebraMap (Localization S) (Localization.Away (e i))
    let M := (IsLocalRing.maximalIdeal (Localization.Away (e i))).comap φ
    have hleM : ∀ N' : Ideal (Localization S), N'.IsPrime → P.asIdeal.map ψ ≤ N' → N' ≤ M := by
      intro N' hN' hle
      have hd' : Disjoint (Submonoid.powers (e i) : Set (Localization S)) (N' : Set (Localization S)) := by
        rw [Set.disjoint_left]
        rintro x ⟨t, rfl⟩ hx
        exact hnot N' hN' hle (hN'.mem_of_pow_mem t hx)
      have hpr : (N'.map φ).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (e i)) _ N' hN' hd'
      exact Ideal.map_le_iff_le_comap.mp (IsLocalRing.le_maximalIdeal hpr.ne_top)
    let M'' := M.comap ψ
    have hM'' : M''.IsPrime := Ideal.comap_isPrime _ _
    have k1 : N₁ ≤ M'' :=
      Ideal.le_comap_map.trans (Ideal.comap_mono (hleM _ hN1p (Ideal.map_mono hP1)))
    have k2 : N₂ ≤ M'' :=
      Ideal.le_comap_map.trans (Ideal.comap_mono (hleM _ hN2p (Ideal.map_mono hP2)))
    rw [h1.eq_of_le hM''.ne_top k1, h2.eq_of_le hM''.ne_top k2]
  obtain ⟨N₀, hN₀, hPN₀⟩ := Ideal.exists_le_maximal P.asIdeal P.isPrime.ne_top
  refine ⟨⟨N₀, hN₀.isPrime⟩, ⟨hN₀, hPN₀⟩, ?_⟩
  rintro ⟨N, hNp⟩ ⟨hN, hPN⟩
  exact PrimeSpectrum.ext (key N N₀ hN hN₀ hPN hPN₀)

theorem wc_finite_over_strictHensel_stalks : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], Module.Finite A B → (∀ (m : Ideal A) [m.IsMaximal], HenselianLocalRing (Localization.AtPrime m) ∧ IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m))) → (∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (B' : Type u) [CommRing B'] [Algebra A' B'], Module.Finite A' B' → ∃ (n : ℕ) (e : Fin n → B'), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, ∃ (_ : HenselianLocalRing (Localization.Away (e i))), IsSepClosed (IsLocalRing.ResidueField (Localization.Away (e i))) ∧ IsLocalHom ((algebraMap B' (Localization.Away (e i))).comp (algebraMap A' B'))) → (∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) → HenselianLocalRing R → HenselianLocalRing S) ∧ (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) → ∀ (n : Ideal B) [n.IsMaximal], HenselianLocalRing (Localization.AtPrime n) ∧ IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime n)) :=
by
  intro A B _ _ _ hfin hSTRICT hHDEC hTRANS n hn
  classical
  haveI := hfin

  have s3 : ∀ (R : Type u) [CommRing R] (x : R) (P : Ideal R) [P.IsMaximal], x ∉ P →
      IsLocalRing (Localization.Away x) →
      Nonempty (Localization.AtPrime P ≃+* Localization.Away x) := by
    intro R _ x P hPm hx hloc
    have hdisj : Disjoint (Submonoid.powers x : Set R) (P : Set R) := by
      rw [Set.disjoint_left]
      rintro y ⟨k, rfl⟩ hy
      exact hx (hPm.isPrime.mem_of_pow_mem k hy)
    have hP' : (Ideal.map (algebraMap R (Localization.Away x)) P).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers x) (Localization.Away x) P
        hPm.isPrime hdisj
    have hQ : Ideal.comap (algebraMap R (Localization.Away x))
        (IsLocalRing.maximalIdeal (Localization.Away x)) = P := by
      have h1 : P ≤ Ideal.comap (algebraMap R (Localization.Away x))
          (IsLocalRing.maximalIdeal (Localization.Away x)) :=
        Ideal.le_comap_map.trans (Ideal.comap_mono (IsLocalRing.le_maximalIdeal hP'.ne_top))
      exact (hPm.eq_of_le (Ideal.comap_ne_top _
        (IsLocalRing.maximalIdeal.isMaximal (Localization.Away x)).ne_top) h1).symm
    haveI : IsLocalization P.primeCompl (Localization.Away x) := by
      apply IsLocalization.of_le (Submonoid.powers x) P.primeCompl
      · exact Submonoid.powers_le.mpr hx
      · intro r hr
        by_contra hu
        have h2 : algebraMap R (Localization.Away x) r ∈
            IsLocalRing.maximalIdeal (Localization.Away x) :=
          (IsLocalRing.mem_maximalIdeal _).mpr hu
        apply hr
        rw [← hQ]
        exact h2
    exact ⟨(IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P)
      (Localization.Away x)).toRingEquiv⟩

  have hint : (algebraMap A B).IsIntegral :=
    algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.of_finite A B)
  haveI hmmax : (Ideal.comap (algebraMap A B) n).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A B) hint n
  obtain ⟨hH, hS⟩ := hSTRICT (Ideal.comap (algebraMap A B) n)
  set m := Ideal.comap (algebraMap A B) n with hm
  set U := Algebra.algebraMapSubmonoid B m.primeCompl with hU
  obtain ⟨k, e, -, -, hsum, hpiece⟩ :=
    @hHDEC (Localization.AtPrime m) _ hH hS (Localization U) _ _ inferInstance

  have hdisj : Disjoint (U : Set B) (n : Set B) := by
    rw [Set.disjoint_left]
    rintro y ⟨a, ha, rfl⟩ hy
    exact ha hy
  haveI hmax' : (Ideal.map (algebraMap B (Localization U)) n).IsMaximal :=
    IsLocalization.isMaximal_of_isMaximal_disjoint U (Localization U) n hdisj
  have hcomap : Ideal.comap (algebraMap B (Localization U))
      (Ideal.map (algebraMap B (Localization U)) n) = n :=
    IsLocalization.under_map_of_isPrime_disjoint U (Localization U) hn.isPrime hdisj
  set n' := Ideal.map (algebraMap B (Localization U)) n with hn'

  obtain ⟨i, hi⟩ : ∃ i, e i ∉ n' := by
    by_contra h
    push_neg at h
    have h1 : ∑ i, e i ∈ n' := Ideal.sum_mem n' (fun i _ => h i)
    rw [hsum] at h1
    exact hmax'.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  obtain ⟨hHi, hSi, -⟩ := hpiece i

  have key : ∀ (p : Ideal B) [p.IsPrime], Ideal.comap (algebraMap B (Localization U)) n' = p →
      Nonempty (Localization.AtPrime p ≃+* Localization.AtPrime n') := by
    intro p _ h
    subst h
    exact ⟨(IsLocalization.localizationLocalizationAtPrimeIsoLocalization U n').toRingEquiv⟩
  obtain ⟨φ1⟩ := key n hcomap
  obtain ⟨φ2⟩ := s3 (Localization U) (e i) n' hi hHi.toIsLocalRing
  haveI := hHi
  exact ⟨hTRANS.1 _ _ (φ1.trans φ2).symm hHi,
    hTRANS.2 _ _ (IsLocalRing.ResidueField.mapEquiv (φ1.trans φ2).symm) hSi⟩

theorem wc_reduced_zeroDim_vnr : ∀ (R : Type u) [CommRing R], IsReduced R → (∀ p : Ideal R, p.IsPrime → p.IsMaximal) → ∀ a : R, ∃ e : R, IsIdempotentElem e ∧ Ideal.span {a} = Ideal.span {e} :=
by
  intro R _ hred hzd a
  have s1 : ∀ (t : R) (n : ℕ), a ^ n * t = 0 → a * t = 0 := by
    intro t n h
    have hnil : IsNilpotent (a * t) := ⟨n + 1, by
      have e : (a * t) ^ (n + 1) = (a ^ n * t) * (a * t ^ n) := by ring
      rw [e, h, zero_mul]⟩
    exact hred.eq_zero _ hnil
  have s2 : ∀ (m : Ideal R), m.IsMaximal → a ∈ m → ∃ (n : ℕ) (t : R), t ∉ m ∧ a ^ n * t = 0 := by
    intro m hm ham
    haveI := hm.isPrime
    by_contra hcon
    push_neg at hcon
    have hT : ∀ x, x ∈ Submonoid.powers a ⊔ m.primeCompl → ∃ (n : ℕ) (t : R), t ∉ m ∧ a ^ n * t = x := by
      intro x hx
      obtain ⟨y, hy, z, hz, rfl⟩ := Submonoid.mem_sup.mp hx
      obtain ⟨n, rfl⟩ := hy
      exact ⟨n, z, hz, rfl⟩
    have hdisj : Disjoint ((⊥ : Ideal R) : Set R) ((Submonoid.powers a ⊔ m.primeCompl : Submonoid R) : Set R) := by
      rw [Set.disjoint_left]
      intro x hx hxT
      have hx0 : x = 0 := (Submodule.mem_bot R).mp hx
      obtain ⟨n, t, ht, he⟩ := hT x hxT
      exact hcon n t ht (he.trans hx0)
    obtain ⟨q, hq, -, hqT⟩ := Ideal.exists_le_prime_disjoint ⊥ _ hdisj
    have hqm : q ≤ m := by
      intro x hx
      by_contra hxm
      have hxT : x ∈ Submonoid.powers a ⊔ m.primeCompl :=
        Submonoid.mem_sup_right (show x ∈ m.primeCompl from hxm)
      exact Set.disjoint_left.mp hqT hx hxT
    have hqeq : q = m := (hzd q hq).eq_of_le hm.ne_top hqm
    have haT : a ∈ Submonoid.powers a ⊔ m.primeCompl :=
      Submonoid.mem_sup_left (Submonoid.mem_powers a)
    exact Set.disjoint_left.mp hqT (hqeq ▸ ham) haT
  let K : Ideal R := LinearMap.ker (LinearMap.mulLeft R a)
  have hK : ∀ z, z ∈ K ↔ a * z = 0 := fun z => by simp [K]
  have hJ : Ideal.span {a} ⊔ K = ⊤ := by
    by_contra hJ
    obtain ⟨m, hm, hJm⟩ := Ideal.exists_le_maximal _ hJ
    have ham : a ∈ m := hJm (Ideal.mem_sup_left (Ideal.mem_span_singleton_self a))
    obtain ⟨n, t, ht, h0⟩ := s2 m hm ham
    exact ht (hJm (Ideal.mem_sup_right ((hK t).mpr (s1 t n h0))))
  have h1 : (1 : R) ∈ Ideal.span {a} ⊔ K := by rw [hJ]; exact Submodule.mem_top
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
  obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
  have haz : a * z = 0 := (hK z).mp hz
  have hra : r * a * a = a := by
    have e : r * a = 1 - z := eq_sub_of_add_eq hyz
    rw [e, sub_mul, one_mul, mul_comm z a, haz, sub_zero]
  refine ⟨r * a, ?_, ?_⟩
  · show r * a * (r * a) = r * a
    calc r * a * (r * a) = r * (r * a * a) := by ring
      _ = r * a := by rw [hra]
  · apply le_antisymm
    · rw [Ideal.span_singleton_le_span_singleton]
      exact ⟨a, hra.symm⟩
    · rw [Ideal.span_singleton_le_span_singleton]
      exact dvd_mul_left a r

theorem wc_vnr_fp_support_open : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M], IsReduced R → (∀ p : Ideal R, p.IsPrime → p.IsMaximal) → Module.FinitePresentation R M → IsOpen (Module.support R M) :=
by
  intro R M _ _ _ hred hmax hfp
  haveI : IsReduced R := hred
  haveI : Ring.KrullDimLE 0 R := Ring.krullDimLE_zero_iff.mpr hmax
  have hfree : ∀ p : PrimeSpectrum R, Module.Free (Localization.AtPrime p.asIdeal)
      (LocalizedModule p.asIdeal.primeCompl M) := by
    intro p
    have hmin : p.asIdeal ∈ minimalPrimes R :=
      Ideal.mem_minimalPrimes_of_krullDimLE_zero p.asIdeal
    haveI : Ring.KrullDimLE 0 (Localization.AtPrime p.asIdeal) :=
      Ring.KrullDimLE.of_isLocalization p.asIdeal hmin _
    have hF : IsField (Localization.AtPrime p.asIdeal) := Ring.KrullDimLE.isField_of_isReduced
    letI := hF.toField
    exact Module.Free.of_divisionRing _ _
  have hfl : Module.freeLocus R M = Set.univ :=
    Set.eq_univ_of_forall (fun p => Module.mem_freeLocus.mpr (hfree p))
  haveI : Module.Projective R M := Module.freeLocus_eq_univ_iff.mp hfl
  have hlc : IsLocallyConstant (Module.rankAtStalk (R := R) M) :=
    Module.isLocallyConstant_rankAtStalk
  have hcl := hlc.isClopen_fiber 0
  have hsupp : Module.support R M = {p | Module.rankAtStalk (R := R) M p = 0}ᶜ := by
    ext p
    simp [Module.rankAtStalk_eq_zero_iff_notMem_support]
  rw [hsupp]
  exact hcl.isClosed.isOpen_compl

theorem wc_extremallyDisconnected_of_isLocalHomeomorph : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y), IsLocalHomeomorph f → ExtremallyDisconnected Y → ExtremallyDisconnected X :=
by
  intro X Y _ _ f hf hY
  refine ⟨fun U hU => ?_⟩
  rw [isOpen_iff_forall_mem_open]
  intro x hx
  obtain ⟨e, hxe, rfl⟩ := hf x
  have hV : IsOpen (U ∩ e.source) := hU.inter e.open_source
  have hW : IsOpen (e '' (U ∩ e.source)) :=
    e.isOpen_image_of_subset_source hV Set.inter_subset_right
  have hcW : IsOpen (closure (e '' (U ∩ e.source))) := hY.open_closure _ hW
  refine ⟨e.source ∩ e ⁻¹' closure (e '' (U ∩ e.source)), ?_, e.isOpen_inter_preimage hcW, ?_⟩
  · rintro z ⟨hzs, hzW⟩
    have h1 := mem_closure_image (e.continuousAt_symm (e.map_source hzs)) hzW
    rw [e.left_inv hzs] at h1
    refine closure_mono ?_ h1
    rintro _ ⟨_, ⟨v, hv, rfl⟩, rfl⟩
    rw [e.left_inv hv.2]
    exact hv.1
  · refine ⟨hxe, ?_⟩
    have h1 : x ∈ closure (e.source ∩ U) := e.open_source.inter_closure ⟨hxe, hx⟩
    have h2 := mem_closure_image (e.continuousAt hxe) h1
    rw [Set.inter_comm] at h2
    exact h2

theorem wc_zeroDim_idempotent_vanishing : ∀ (S : Type u) [CommRing S], (∀ p : Ideal S, p.IsPrime → p.IsMaximal) → (∀ (R : Type u) [CommRing R], IsReduced R → (∀ p : Ideal R, p.IsPrime → p.IsMaximal) → ∀ a : R, ∃ e : R, IsIdempotentElem e ∧ Ideal.span {a} = Ideal.span {e}) → ∀ s : S, ∃ ε : S, IsIdempotentElem ε ∧ ∀ Q : Ideal S, Q.IsPrime → (s ∈ Q ↔ ε ∈ Q) :=
by
  intro S _ hS H s
  classical
  let π : S →+* S ⧸ nilradical S := Ideal.Quotient.mk (nilradical S)
  have hsurj : Function.Surjective π := Ideal.Quotient.mk_surjective
  have hred : IsReduced (S ⧸ nilradical S) :=
    (Ideal.isRadical_iff_quotient_reduced (nilradical S)).mp (Ideal.radical_isRadical ⊥)
  have hmaxR : ∀ P : Ideal (S ⧸ nilradical S), P.IsPrime → P.IsMaximal := by
    intro P hP
    have := hP
    have h1 : (Ideal.comap π P).IsMaximal := hS _ (Ideal.IsPrime.comap π)
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective π hsurj h1 with h | h
    · rw [Ideal.map_comap_of_surjective π hsurj P] at h
      exact absurd h hP.ne_top
    · rwa [Ideal.map_comap_of_surjective π hsurj P] at h
  obtain ⟨e, he, hspan⟩ := H (S ⧸ nilradical S) hred hmaxR (π s)
  have hker : ∀ x ∈ RingHom.ker π, IsNilpotent x := by
    intro x hx
    have hx' : x ∈ nilradical S := by
      rw [Ideal.mk_ker] at hx
      exact hx
    exact mem_nilradical.mp hx'
  obtain ⟨ε, hε, hπε⟩ :=
    exists_isIdempotentElem_eq_of_ker_isNilpotent π hker e (hsurj e) he
  have hb : e ∈ Ideal.span {π s} := by
    rw [hspan]; exact Ideal.mem_span_singleton_self e
  have ha : π s ∈ Ideal.span {e} := by
    rw [← hspan]; exact Ideal.mem_span_singleton_self _
  obtain ⟨b, hb'⟩ := Ideal.mem_span_singleton'.mp hb
  obtain ⟨a, ha'⟩ := Ideal.mem_span_singleton'.mp ha
  obtain ⟨a', rfl⟩ := hsurj a
  obtain ⟨b', rfl⟩ := hsurj b
  have h1 : b' * s - ε ∈ nilradical S := by
    apply Ideal.Quotient.eq.mp
    show π (b' * s) = π ε
    rw [map_mul, hb', hπε]
  have h2 : a' * ε - s ∈ nilradical S := by
    apply Ideal.Quotient.eq.mp
    show π (a' * ε) = π s
    rw [map_mul, hπε, ha']
  refine ⟨ε, hε, fun Q hQ => ?_⟩
  have := hQ
  have hNQ : nilradical S ≤ Q := nilradical_le_prime Q
  have h1Q := hNQ h1
  have h2Q := hNQ h2
  constructor
  · intro hs
    have : ε = b' * s - (b' * s - ε) := by ring
    rw [this]
    exact Q.sub_mem (Q.mul_mem_left _ hs) h1Q
  · intro he'
    have : s = a' * ε - (a' * ε - s) := by ring
    rw [this]
    exact Q.sub_mem (Q.mul_mem_left _ he') h2Q

theorem wc_finite_sepClosed_frobenius_congr : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Module.Finite R S → (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) → ∀ (Q : Ideal S) [Q.IsPrime], (Q.comap (algebraMap R S)).IsMaximal → IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime (Q.comap (algebraMap R S)))) → ∀ s : S, ∃ (N : ℕ) (c : R), s ^ (ringExpChar (R ⧸ Q.comap (algebraMap R S)) ^ N) - algebraMap R S c ∈ Q :=
by
  intro R S _ _ _ hfin T Q _ hmax hsep s
  classical
  haveI : (Q.comap (algebraMap R S)).IsMaximal := hmax
  letI : Field (R ⧸ Q.comap (algebraMap R S)) := Ideal.Quotient.field _
  haveI : Q.LiesOver (Q.comap (algebraMap R S)) := ⟨rfl⟩
  haveI : Module.Finite R S := hfin
  haveI : Module.Finite (R ⧸ Q.comap (algebraMap R S)) (S ⧸ Q) :=
    module_finite_of_liesOver Q (Q.comap (algebraMap R S))
  haveI : Algebra.IsIntegral (R ⧸ Q.comap (algebraMap R S)) (S ⧸ Q) :=
    Algebra.IsIntegral.of_finite _ _
  haveI : Algebra.IsAlgebraic (R ⧸ Q.comap (algebraMap R S)) (S ⧸ Q) :=
    Algebra.IsIntegral.isAlgebraic
  have hbij := Ideal.bijective_algebraMap_quotient_residueField (Q.comap (algebraMap R S))
  let e : (R ⧸ Q.comap (algebraMap R S)) ≃+* (Q.comap (algebraMap R S)).ResidueField :=
    RingEquiv.ofBijective (algebraMap (R ⧸ Q.comap (algebraMap R S))
      (Q.comap (algebraMap R S)).ResidueField) hbij
  haveI hsep' : IsSepClosed (Q.comap (algebraMap R S)).ResidueField := hsep
  haveI : IsSepClosed (R ⧸ Q.comap (algebraMap R S)) :=
    T (Q.comap (algebraMap R S)).ResidueField (R ⧸ Q.comap (algebraMap R S)) e.symm hsep'
  haveI : IsPurelyInseparable (R ⧸ Q.comap (algebraMap R S)) (S ⧸ Q) :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  haveI := ringExpChar.expChar (R ⧸ Q.comap (algebraMap R S))
  obtain ⟨N, y, hy⟩ := IsPurelyInseparable.pow_mem (R ⧸ Q.comap (algebraMap R S))
    (ringExpChar (R ⧸ Q.comap (algebraMap R S))) (Ideal.Quotient.mk Q s)
  obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective y
  refine ⟨N, c, ?_⟩
  rw [← Ideal.Quotient.eq, map_pow, ← hy, Ideal.Quotient.algebraMap_mk_of_liesOver]

theorem wc_frobenius_congr_local_injective : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Module.Finite R S → (∀ s : S, ∃ ε : S, IsIdempotentElem ε ∧ ∀ Q : Ideal S, Q.IsPrime → (s ∈ Q ↔ ε ∈ Q)) → ∀ (Q : Ideal S) [Q.IsPrime], (∀ s : S, ∃ (N : ℕ) (c : R), s ^ (ringExpChar (R ⧸ Q.comap (algebraMap R S)) ^ N) - algebraMap R S c ∈ Q) → ∃ ε : S, IsIdempotentElem ε ∧ ε ∉ Q ∧ ∀ Q' Q'' : Ideal S, Q'.IsPrime → Q''.IsPrime → ε ∉ Q' → ε ∉ Q'' → Q'.comap (algebraMap R S) = Q''.comap (algebraMap R S) → Q' = Q'' :=
by
  intro R S _ _ _ hfin PREG Q _ POW
  classical
  have := hfin

  have s1 : ∃ χ q : ℕ, ((χ : ℕ) : R) ∈ Q.comap (algebraMap R S) ∧
      (q = 1 ∨ (Nat.Prime q ∧ q = χ)) ∧ q = ringExpChar (R ⧸ Q.comap (algebraMap R S)) := by
    have hpp : (Q.comap (algebraMap R S)).IsPrime := inferInstance
    refine ⟨ringChar (R ⧸ Q.comap (algebraMap R S)), ringExpChar (R ⧸ Q.comap (algebraMap R S)),
      ?_, ?_, rfl⟩
    · rw [← Ideal.Quotient.eq_zero_iff_mem, map_natCast]
      exact ringChar.Nat.cast_ringChar
    · have e : ringExpChar (R ⧸ Q.comap (algebraMap R S)) =
          max (ringChar (R ⧸ Q.comap (algebraMap R S))) 1 := rfl
      rcases CharP.char_is_prime_or_zero (R ⧸ Q.comap (algebraMap R S))
          (ringChar (R ⧸ Q.comap (algebraMap R S))) with h | h
      · right
        rw [e, max_eq_left h.one_lt.le]
        exact ⟨h, rfl⟩
      · left
        simp [e, h]
  obtain ⟨χ, q, hχp, hqcase, hqdef⟩ := s1
  simp only [← hqdef] at POW

  have s2 : ∀ (n : ℕ) (s : Fin n → S), (∀ j, ∃ (N : ℕ) (c : R), s j ^ (q ^ N) - algebraMap R S c ∈ Q) →
      ∃ (N : ℕ) (d : Fin n → R), ∀ j, s j ^ (q ^ N) - algebraMap R S (d j) ∈ Q := by
    intro n s h
    choose Nj c hc using h
    refine ⟨∑ j, Nj j, fun j => c j ^ (q ^ (∑ i, Nj i - Nj j)), fun j => ?_⟩
    have hle : Nj j ≤ ∑ i, Nj i :=
      Finset.single_le_sum (fun i _ => Nat.zero_le (Nj i)) (Finset.mem_univ j)
    have he : q ^ (∑ i, Nj i) = q ^ Nj j * q ^ (∑ i, Nj i - Nj j) := by
      rw [← pow_add, Nat.add_sub_cancel' hle]
    rw [he, pow_mul, map_pow]
    obtain ⟨m, hm⟩ := sub_dvd_pow_sub_pow (s j ^ q ^ Nj j) (algebraMap R S (c j))
      (q ^ (∑ i, Nj i - Nj j))
    rw [hm]
    exact Q.mul_mem_right _ (hc j)

  have s3 : ∀ (m : ℕ) (t : Fin m → S), (∀ j, t j ∈ Q) → ∃ ε : S, IsIdempotentElem ε ∧ ε ∉ Q ∧
      ∀ Q' : Ideal S, Q'.IsPrime → ε ∉ Q' → ∀ j, t j ∈ Q' := by
    intro m t ht
    choose η hη hηQ using fun j => PREG (t j)
    refine ⟨∏ j, (1 - η j), ?_, ?_, ?_⟩
    · exact Finset.prod_induction _ IsIdempotentElem (fun a b ha hb => ha.mul hb)
        IsIdempotentElem.one (fun j _ => (hη j).one_sub)
    · intro hmem
      obtain ⟨j, -, hj⟩ := (Ideal.IsPrime.prod_mem_iff (p := Q)).mp hmem
      have h1 : η j ∈ Q := ((hηQ j) Q inferInstance).mp (ht j)
      have h2 : (1 : S) ∈ Q := by simpa using Q.add_mem hj h1
      exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one Q).mpr h2)
    · intro Q' hQ' hε j
      have h1 : 1 - η j ∉ Q' := fun h =>
        hε ((Ideal.IsPrime.prod_mem_iff (p := Q')).mpr ⟨j, Finset.mem_univ j, h⟩)
      have h2 : η j * (1 - η j) ∈ Q' := by
        rw [mul_sub, mul_one, (hη j).eq, sub_self]
        exact Q'.zero_mem
      have h3 : η j ∈ Q' := (hQ'.mem_or_mem h2).resolve_right h1
      exact ((hηQ j) Q' hQ').mpr h3

  have s4 : ∀ (P : Ideal S), P.IsPrime → ∀ (N n : ℕ), (q = 1 ∨ (Nat.Prime q ∧ (q : S) ∈ P)) →
      ∀ (s : Fin n → S) (d : Fin n → R), (∀ j, s j ^ (q ^ N) - algebraMap R S (d j) ∈ P) →
      ∀ r : Fin n → R, ((∑ j, r j • s j) ∈ P ↔ algebraMap R S (∑ j, r j ^ (q ^ N) * d j) ∈ P) := by
    intro P hP N n hqP s d hsd r
    have key : (∑ j, r j • s j) ^ (q ^ N) - algebraMap R S (∑ j, r j ^ (q ^ N) * d j) ∈ P := by
      rcases hqP with h1 | ⟨hprime, hqmem⟩
      · rw [h1] at hsd ⊢
        simp only [one_pow, pow_one] at hsd ⊢
        have e : (∑ j, r j • s j) - algebraMap R S (∑ j, r j * d j) =
            ∑ j, algebraMap R S (r j) * (s j - algebraMap R S (d j)) := by
          rw [map_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [Algebra.smul_def, map_mul]
          ring
        rw [e]
        exact P.sum_mem (fun j _ => P.mul_mem_left _ (hsd j))
      · have : CharP (S ⧸ P) q := (CharP.charP_iff_prime_eq_zero hprime).mpr (by
          rw [← map_natCast (Ideal.Quotient.mk P), Ideal.Quotient.eq_zero_iff_mem]
          exact hqmem)
        have : ExpChar (S ⧸ P) q := ExpChar.prime hprime
        have hsd' : ∀ j, (Ideal.Quotient.mk P (s j)) ^ (q ^ N) =
            Ideal.Quotient.mk P (algebraMap R S (d j)) := by
          intro j
          rw [← map_pow]
          exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr (hsd j)
        rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem, map_pow, map_sum, sum_pow_char_pow, map_sum,
          map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Algebra.smul_def, map_mul, map_mul, mul_pow, hsd' j, map_mul]
        simp only [map_pow]
    have hqpos : 0 < q ^ N := by
      rcases hqP with h1 | ⟨hprime, _⟩
      · rw [h1, one_pow]
        exact Nat.one_pos
      · exact pow_pos hprime.pos N
    constructor
    · intro hx
      have h1 : (∑ j, r j • s j) ^ (q ^ N) ∈ P := P.pow_mem_of_mem hx _ hqpos
      have h2 := P.sub_mem h1 key
      rwa [sub_sub_cancel] at h2
    · intro ha
      have h1 : (∑ j, r j • s j) ^ (q ^ N) ∈ P := by
        have h2 := P.add_mem key ha
        rwa [sub_add_cancel] at h2
      exact hP.mem_of_pow_mem _ h1

  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := S)
  have hspan : ∀ x : S, ∃ r : Fin n → R, ∑ j, r j • s j = x := by
    intro x
    have hx : x ∈ Submodule.span R (Set.range s) := by
      rw [hs]
      exact Submodule.mem_top
    exact (Submodule.mem_span_range_iff_exists_fun R).mp hx
  obtain ⟨N, d, hd⟩ := s2 n s (fun j => POW (s j))
  let t : Fin (n + 1) → S :=
    Fin.cons (algebraMap R S (χ : R)) (fun j => s j ^ (q ^ N) - algebraMap R S (d j))
  have ht : ∀ k, t k ∈ Q := by
    intro k
    refine Fin.cases ?_ (fun j => ?_) k
    · simp only [t, Fin.cons_zero]
      exact hχp
    · simp only [t, Fin.cons_succ]
      exact hd j
  obtain ⟨ε, hε, hεQ, hcut⟩ := s3 (n + 1) t ht
  refine ⟨ε, hε, hεQ, ?_⟩
  intro Q' Q'' hQ' hQ'' hε' hε'' hcom
  have hP : ∀ P : Ideal S, P.IsPrime → ε ∉ P → ∀ x : S, ∀ r : Fin n → R, ∑ j, r j • s j = x →
      (x ∈ P ↔ algebraMap R S (∑ j, r j ^ (q ^ N) * d j) ∈ P) := by
    intro P hPp hεP x r hr
    have h0 : algebraMap R S (χ : R) ∈ P := by
      have h := hcut P hPp hεP 0
      simp only [t, Fin.cons_zero] at h
      exact h
    have hsj : ∀ j, s j ^ (q ^ N) - algebraMap R S (d j) ∈ P := by
      intro j
      have h := hcut P hPp hεP j.succ
      simp only [t, Fin.cons_succ] at h
      exact h
    have hqP : q = 1 ∨ (Nat.Prime q ∧ (q : S) ∈ P) := by
      rcases hqcase with h | ⟨hpr, hqχ⟩
      · exact Or.inl h
      · refine Or.inr ⟨hpr, ?_⟩
        rw [hqχ, ← map_natCast (algebraMap R S)]
        exact h0
    rw [← hr]
    exact s4 P hPp N n hqP s d hsj r
  apply Ideal.ext
  intro x
  obtain ⟨r, hr⟩ := hspan x
  rw [hP Q' hQ' hε' x r hr, hP Q'' hQ'' hε'' x r hr]
  constructor
  · intro h
    have h' : (∑ j, r j ^ (q ^ N) * d j) ∈ Q'.comap (algebraMap R S) := h
    rw [hcom] at h'
    exact h'
  · intro h
    have h' : (∑ j, r j ^ (q ^ N) * d j) ∈ Q''.comap (algebraMap R S) := h
    rw [← hcom] at h'
    exact h'

theorem wc_vnr_finite_fp_image_clopen_open : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], IsReduced R → (∀ p : Ideal R, p.IsPrime → p.IsMaximal) → Module.Finite R S → Algebra.FinitePresentation R S → (∀ (M : Type u) [AddCommGroup M] [Module R M], Module.FinitePresentation R M → IsOpen (Module.support R M)) → ∀ η : S, IsIdempotentElem η → IsOpen (PrimeSpectrum.comap (algebraMap R S) '' (PrimeSpectrum.basicOpen η : Set (PrimeSpectrum S))) :=
by
  intro R S _ _ _ _ _ hfin hfp hsupp η hη
  set J : Ideal S := Ideal.span {1 - η} with hJ
  have hfinT : Module.Finite R (S ⧸ J) := Module.Finite.quotient R J
  have : Algebra.IsIntegral R (S ⧸ J) := Algebra.IsIntegral.of_finite R (S ⧸ J)
  have hfpT : Algebra.FinitePresentation R (S ⧸ J) :=
    Algebra.FinitePresentation.quotient ⟨{1 - η}, by simp [hJ]⟩
  have hMfp : Module.FinitePresentation R (S ⧸ J) :=
    Module.FinitePresentation.of_finite_of_finitePresentation R (S ⧸ J)
  have hopen := hsupp (S ⧸ J) hMfp
  have hmk : ∀ r : R, Ideal.Quotient.mk J (algebraMap R S r) = algebraMap R (S ⧸ J) r :=
    fun r => Ideal.Quotient.mk_algebraMap R J r
  have h1J : (1 - η) ∈ J := Ideal.subset_span (Set.mem_singleton _)
  have key : PrimeSpectrum.comap (algebraMap R S) '' (PrimeSpectrum.basicOpen η : Set (PrimeSpectrum S))
      = Module.support R (S ⧸ J) := by
    rw [Module.support_of_algebra, PrimeSpectrum.basicOpen_eq_zeroLocus_of_isIdempotentElem _ hη]
    ext p
    constructor
    · rintro ⟨q, hq, rfl⟩
      rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff] at hq
      rw [PrimeSpectrum.mem_zeroLocus]
      intro r hr
      rw [SetLike.mem_coe, RingHom.mem_ker, ← hmk, Ideal.Quotient.eq_zero_iff_mem] at hr
      have hJq : J ≤ q.asIdeal := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq)
      exact hJq hr
    · intro hp
      rw [PrimeSpectrum.mem_zeroLocus] at hp
      have hle : Ideal.under R (⊥ : Ideal (S ⧸ J)) ≤ p.asIdeal := by
        intro r hr
        apply hp
        rw [SetLike.mem_coe, RingHom.mem_ker]
        rw [Ideal.under_def, Ideal.mem_comap, Ideal.mem_bot] at hr
        exact hr
      obtain ⟨Q, -, hQ, hQp⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p.asIdeal ⊥ hle
      refine ⟨⟨Q.comap (Ideal.Quotient.mk J), Ideal.IsPrime.comap _⟩, ?_, ?_⟩
      · rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
        show Ideal.Quotient.mk J (1 - η) ∈ Q
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr h1J]
        exact Q.zero_mem
      · ext r
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
        show Ideal.Quotient.mk J (algebraMap R S r) ∈ Q ↔ r ∈ p.asIdeal
        rw [hmk, ← hQp, Ideal.under_def, Ideal.mem_comap]
  rw [key]
  exact hopen

theorem wc_vnr_finite_fp_localHomeomorph : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], IsReduced R → (∀ p : Ideal R, p.IsPrime → p.IsMaximal) → (∀ (m : Ideal R) [m.IsMaximal], IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m))) → Module.Finite R S → Algebra.FinitePresentation R S → (∀ s : S, ∃ ε : S, IsIdempotentElem ε ∧ ∀ Q : Ideal S, Q.IsPrime → (s ∈ Q ↔ ε ∈ Q)) → (∀ (Q : Ideal S) [Q.IsPrime], ∀ s : S, ∃ (N : ℕ) (c : R), s ^ (ringExpChar (R ⧸ Q.comap (algebraMap R S)) ^ N) - algebraMap R S c ∈ Q) → (∀ (Q : Ideal S) [Q.IsPrime], ∃ ε : S, IsIdempotentElem ε ∧ ε ∉ Q ∧ ∀ Q' Q'' : Ideal S, Q'.IsPrime → Q''.IsPrime → ε ∉ Q' → ε ∉ Q'' → Q'.comap (algebraMap R S) = Q''.comap (algebraMap R S) → Q' = Q'') → (∀ η : S, IsIdempotentElem η → IsOpen (PrimeSpectrum.comap (algebraMap R S) '' (PrimeSpectrum.basicOpen η : Set (PrimeSpectrum S)))) → IsLocalHomeomorph (PrimeSpectrum.comap (algebraMap R S)) :=
by
  intro R S _ _ _ _hred _hzd _hsep hfin _hfp _PREG _POW CRUX OPEN
  haveI : Module.Finite R S := hfin
  haveI : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
  have hclosed : IsClosedMap (PrimeSpectrum.comap (algebraMap R S)) :=
    PrimeSpectrum.isClosedMap_comap_of_isIntegral (algebraMap R S)
      (algebraMap_isIntegral_iff.mpr inferInstance)
  rw [isLocalHomeomorph_iff_isOpenEmbedding_restrict]
  intro x
  obtain ⟨ε, hε, hεx, hinj⟩ := @CRUX x.asIdeal x.isPrime
  refine ⟨(PrimeSpectrum.basicOpen ε : Set (PrimeSpectrum S)), ?_, ?_⟩
  · exact IsOpen.mem_nhds (PrimeSpectrum.isOpen_basicOpen) ((PrimeSpectrum.mem_basicOpen ε x).mpr hεx)
  · have hUclosed : IsClosed (PrimeSpectrum.basicOpen ε : Set (PrimeSpectrum S)) :=
      (PrimeSpectrum.isClopen_iff.mpr ⟨ε, hε, rfl⟩).isClosed
    have hinjOn : Set.InjOn (PrimeSpectrum.comap (algebraMap R S))
        (PrimeSpectrum.basicOpen ε : Set (PrimeSpectrum S)) := by
      intro a ha b hb hab
      have ha' : ε ∉ a.asIdeal := (PrimeSpectrum.mem_basicOpen ε a).mp ha
      have hb' : ε ∉ b.asIdeal := (PrimeSpectrum.mem_basicOpen ε b).mp hb
      have h1 := congrArg PrimeSpectrum.asIdeal hab
      rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal] at h1
      exact PrimeSpectrum.ext (hinj a.asIdeal b.asIdeal a.isPrime b.isPrime ha' hb' h1)
    have hcont := (PrimeSpectrum.continuous_comap (algebraMap R S)).continuousOn.domRestrict
      (s := (PrimeSpectrum.basicOpen ε : Set (PrimeSpectrum S)))
    have hcl := hclosed.domRestrict hUclosed
    have hemb := (Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap hcont
      hinjOn.injective hcl).isEmbedding
    refine Topology.IsOpenEmbedding.mk hemb ?_
    rw [Set.range_domRestrict]
    exact OPEN ε hε

theorem wc_finite_fp_closedPoints_extremallyDisconnected : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B], Module.Finite A B → Algebra.FinitePresentation A B → IsClosed {p : PrimeSpectrum A | p.asIdeal.IsMaximal} → ExtremallyDisconnected {p : PrimeSpectrum A | p.asIdeal.IsMaximal} → (∀ (m : Ideal A) [m.IsMaximal], IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m))) → (∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], IsReduced R → (∀ p : Ideal R, p.IsPrime → p.IsMaximal) → (∀ (m : Ideal R) [m.IsMaximal], IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m))) → Module.Finite R S → Algebra.FinitePresentation R S → IsLocalHomeomorph (PrimeSpectrum.comap (algebraMap R S))) → (∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y), IsLocalHomeomorph f → ExtremallyDisconnected Y → ExtremallyDisconnected X) → (∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L) → ExtremallyDisconnected {n : PrimeSpectrum B | n.asIdeal.IsMaximal} :=
by
  intro A B _ _ _ hfin hfp hcl hED hsep LH EDT TRANS
  classical
  haveI := hfin
  haveI := hfp

  have s0 : PrimeSpectrum.zeroLocus
      ((PrimeSpectrum.vanishingIdeal {p : PrimeSpectrum A | p.asIdeal.IsMaximal} : Ideal A) : Set A) =
      {p : PrimeSpectrum A | p.asIdeal.IsMaximal} :=
    (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure _).trans hcl.closure_eq
  set I : Ideal A := PrimeSpectrum.vanishingIdeal {p : PrimeSpectrum A | p.asIdeal.IsMaximal} with hI

  have hR : IsReduced (A ⧸ I) :=
    (Ideal.isRadical_iff_quotient_reduced I).mp (PrimeSpectrum.isRadical_vanishingIdeal _)
  have hzd : ∀ P : Ideal (A ⧸ I), P.IsPrime → P.IsMaximal := by
    intro P hP
    have hQ : (P.comap (Ideal.Quotient.mk I)).IsMaximal := by
      have hmem : (⟨P.comap (Ideal.Quotient.mk I), hP.comap _⟩ : PrimeSpectrum A) ∈
          PrimeSpectrum.zeroLocus (I : Set A) := by
        rw [PrimeSpectrum.mem_zeroLocus]
        intro x hx
        show Ideal.Quotient.mk I x ∈ P
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact P.zero_mem
      rw [s0] at hmem
      exact hmem
    have h := Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective hQ
    rw [Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective] at h
    exact h.resolve_left hP.ne_top

  have hsep₀ : ∀ (m₀ : Ideal (A ⧸ I)) [m₀.IsMaximal],
      IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m₀)) := by
    intro m₀ hm₀
    haveI hmax : (m₀.comap (Ideal.Quotient.mk I)).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
    have e1 : A ⧸ m₀.comap (Ideal.Quotient.mk I) ≃+*
        IsLocalRing.ResidueField (Localization.AtPrime (m₀.comap (Ideal.Quotient.mk I))) :=
      IsLocalization.AtPrime.equivQuotMaximalIdeal (m₀.comap (Ideal.Quotient.mk I))
        (Localization.AtPrime (m₀.comap (Ideal.Quotient.mk I)))
    have e3 : (A ⧸ I) ⧸ m₀ ≃+* IsLocalRing.ResidueField (Localization.AtPrime m₀) :=
      IsLocalization.AtPrime.equivQuotMaximalIdeal m₀ (Localization.AtPrime m₀)
    have hker : RingHom.ker ((Ideal.Quotient.mk m₀).comp (Ideal.Quotient.mk I)) =
        m₀.comap (Ideal.Quotient.mk I) := by
      rw [← RingHom.comap_ker, Ideal.mk_ker]
    have hsurj : Function.Surjective ((Ideal.Quotient.mk m₀).comp (Ideal.Quotient.mk I)) :=
      Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
    have e2 : A ⧸ m₀.comap (Ideal.Quotient.mk I) ≃+* (A ⧸ I) ⧸ m₀ :=
      (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
    exact TRANS _ _ ((e1.symm.trans e2).trans e3) (hsep _)

  have hfin₀ : Module.Finite (A ⧸ I) (B ⧸ I.map (algebraMap A B)) := by
    haveI : Module.Finite A (B ⧸ I.map (algebraMap A B)) :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ A (I.map (algebraMap A B))).toLinearMap
        (Ideal.Quotient.mkₐ_surjective A _)
    exact Module.Finite.of_restrictScalars_finite A (A ⧸ I) (B ⧸ I.map (algebraMap A B))
  have hfp₀ : Algebra.FinitePresentation (A ⧸ I) (B ⧸ I.map (algebraMap A B)) :=
    Algebra.FinitePresentation.equiv
      (AlgEquiv.extendScalarsOfSurjective (R := A) (S := A ⧸ I) Ideal.Quotient.mk_surjective
        (((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).restrictScalars A).trans
          (Algebra.TensorProduct.comm A B (A ⧸ I)))).symm

  have c4 : ∀ (R : Type u) [CommRing R] (K : Ideal R),
      Nonempty (PrimeSpectrum (R ⧸ K) ≃ₜ PrimeSpectrum.zeroLocus (K : Set R)) := by
    intro R _ K
    have h1 := (PrimeSpectrum.isClosedEmbedding_comap_of_surjective (R ⧸ K) (Ideal.Quotient.mk K)
      Ideal.Quotient.mk_surjective).isEmbedding.toHomeomorph
    have h2 : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk K)) =
        PrimeSpectrum.zeroLocus (K : Set R) := by
      rw [range_comap_of_surjective (R ⧸ K) (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective,
        Ideal.mk_ker]
    exact ⟨h1.trans (Homeomorph.setCongr h2)⟩

  haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  have hint : (algebraMap A B).IsIntegral := algebraMap_isIntegral_iff.mpr inferInstance
  have c5 : PrimeSpectrum.zeroLocus ((I.map (algebraMap A B) : Ideal B) : Set B) =
      {n : PrimeSpectrum B | n.asIdeal.IsMaximal} := by
    ext n
    rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.map_le_iff_le_comap]
    have h := Set.ext_iff.mp s0 (PrimeSpectrum.comap (algebraMap A B) n)
    rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe] at h
    have h' : I ≤ n.asIdeal.comap (algebraMap A B) ↔
        (n.asIdeal.comap (algebraMap A B)).IsMaximal := h
    rw [h']
    simp only [Set.mem_setOf_eq]
    constructor
    · intro h2
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hint n.asIdeal h2
    · intro h2
      exact Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint n.asIdeal

  have hLH := LH (A ⧸ I) (B ⧸ I.map (algebraMap A B)) hR hzd hsep₀ hfin₀ hfp₀
  obtain ⟨hA⟩ := c4 A I
  obtain ⟨hB⟩ := c4 B (I.map (algebraMap A B))
  haveI := hED
  haveI hEA : ExtremallyDisconnected (PrimeSpectrum (A ⧸ I)) :=
    extremallyDisconnected_of_homeo (hA.trans (Homeomorph.setCongr s0)).symm
  haveI hEB := EDT _ hLH hEA
  exact extremallyDisconnected_of_homeo (hB.trans (Homeomorph.setCongr c5))

theorem wc_wlocal_strictHensel_finite_stable : ∀ {Δ Y : Scheme.{u}} (q : Y ⟶ Δ) [IsFinite q] [LocallyOfFinitePresentation q], IsAffine Δ → IsClosed {x : Δ | IsClosed ({x} : Set Δ)} → (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) → ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} → (∀ x : Δ, IsClosed ({x} : Set Δ) → HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)) → IsClosed {y : Y | IsClosed ({y} : Set Y)} ∧ (∀ x : Y, ∃! y : Y, IsClosed ({y} : Set Y) ∧ x ⤳ y) ∧ ExtremallyDisconnected {y : Y | IsClosed ({y} : Set Y)} ∧ (∀ y : Y, IsClosed ({y} : Set Y) → HenselianLocalRing (Y.presheaf.stalk y) ∧ IsSepClosed (Y.residueField y)) :=
by
  intro Δ Y q _ _ hΔ ha hb hc hd
  haveI : IsAffine Y := isAffine_of_isAffineHom q
  have T := wc_henselian_sepClosed_transfer

  have LH : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], IsReduced R →
      (∀ p : Ideal R, p.IsPrime → p.IsMaximal) →
      (∀ (m : Ideal R) [m.IsMaximal], IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m))) →
      Module.Finite R S → Algebra.FinitePresentation R S →
      IsLocalHomeomorph (PrimeSpectrum.comap (algebraMap R S)) := by
    intro R S _ _ _ hred hzd hsep hfin hfp
    haveI : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
    have hzdS : ∀ p : Ideal S, p.IsPrime → p.IsMaximal := by
      intro p hp
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R S)
        (algebraMap_isIntegral_iff.mpr inferInstance) p (hzd _ (Ideal.IsPrime.comap _))
    have PREG := wc_zeroDim_idempotent_vanishing S hzdS wc_reduced_zeroDim_vnr
    have POW : ∀ (Q : Ideal S) [Q.IsPrime], ∀ s : S, ∃ (N : ℕ) (c : R),
        s ^ (ringExpChar (R ⧸ Q.comap (algebraMap R S)) ^ N) - algebraMap R S c ∈ Q := by
      intro Q _
      haveI hmax : (Q.comap (algebraMap R S)).IsMaximal := hzd _ inferInstance
      exact wc_finite_sepClosed_frobenius_congr R S hfin T.2 Q hmax (hsep _)
    have CRUX : ∀ (Q : Ideal S) [Q.IsPrime], ∃ ε : S, IsIdempotentElem ε ∧ ε ∉ Q ∧
        ∀ Q' Q'' : Ideal S, Q'.IsPrime → Q''.IsPrime → ε ∉ Q' → ε ∉ Q'' →
          Q'.comap (algebraMap R S) = Q''.comap (algebraMap R S) → Q' = Q'' := by
      intro Q _
      exact wc_frobenius_congr_local_injective R S hfin PREG Q (POW Q)
    have OPEN := wc_vnr_finite_fp_image_clopen_open R S hred hzd hfin hfp
      (fun M _ _ hM => wc_vnr_fp_support_open R M hred hzd hM)
    exact wc_vnr_finite_fp_localHomeomorph R S hred hzd hsep hfin hfp PREG POW CRUX OPEN

  obtain ⟨s1a, s1b, s1c⟩ := wc_affine_WL_topology_iff Δ hΔ
  obtain ⟨t1a, t1b, t1c⟩ := wc_affine_WL_topology_iff Y inferInstance
  have hdA := (wc_affine_WL_stalk_iff Δ hΔ T).mp hd
  have haA := s1a.mp ha
  have hbA := s1b.mp hb
  have hcA := s1c.mp hc
  letI : Algebra Γ(Δ, ⊤) Γ(Y, ⊤) := q.appTop.hom.toAlgebra
  have hfin : Module.Finite Γ(Δ, ⊤) Γ(Y, ⊤) := IsFinite.finite_app q ⊤ (isAffineOpen_top Δ)
  have hfp : Algebra.FinitePresentation Γ(Δ, ⊤) Γ(Y, ⊤) :=
    HasRingHomProperty.appTop @LocallyOfFinitePresentation q inferInstance
  haveI : Algebra.IsIntegral Γ(Δ, ⊤) Γ(Y, ⊤) := Algebra.IsIntegral.of_finite _ _
  have hint : (algebraMap Γ(Δ, ⊤) Γ(Y, ⊤)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  refine ⟨t1a.mpr ?_, t1b.mpr ?_, t1c.mpr ?_, (wc_affine_WL_stalk_iff Y inferInstance T).mpr ?_⟩
  · have e : {P : PrimeSpectrum Γ(Y, ⊤) | P.asIdeal.IsMaximal} =
        PrimeSpectrum.comap (algebraMap Γ(Δ, ⊤) Γ(Y, ⊤)) ⁻¹'
          {p : PrimeSpectrum Γ(Δ, ⊤) | p.asIdeal.IsMaximal} := by
      ext P
      simp only [Set.mem_setOf_eq, Set.mem_preimage, PrimeSpectrum.comap_asIdeal]
      constructor
      · intro h
        exact Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint P.asIdeal
      · intro h
        exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hint P.asIdeal h
    rw [e]
    exact haA.preimage (PrimeSpectrum.continuous_comap _)
  · exact wc_finite_over_wlocal_wlocal _ _ hfin hbA hdA wc_strictHensel_finite_idem_decomp
  · exact wc_finite_fp_closedPoints_extremallyDisconnected _ _ hfin hfp haA hcA
      (fun m _ => (hdA m).2) LH wc_extremallyDisconnected_of_isLocalHomeomorph T.2
  · exact wc_finite_over_strictHensel_stalks _ _ hfin hdA wc_strictHensel_finite_idem_decomp T

theorem wc_diag_pushforward_exact (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (DΔ : wcHMPullData (Limits.pullback.diagonal (wcPi2 F X)) ℓ) (hDΔ : wcHMPullCanonical DΔ) :
    Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC (Limits.pullback.diagonal (wcPi2 F X)))
        _ _ DΔ.cont DΔ.φ) :=
by
  classical
  haveI hcont := DΔ.cont

  haveI hci : IsClosedImmersion (Limits.pullback.diagonal (wcPi2 F X)) := inferInstance
  haveI hfin : IsFinite (Limits.pullback.diagonal (wcPi2 F X)) := inferInstance

  haveI hlfp : LocallyOfFinitePresentation (Limits.pullback.diagonal (wcPi2 F X)) := inferInstance

  have hsplit : ∀ (V : (Limits.pullback (wcPi2 F X) (wcPi2 F X)).ProEt)
      (T : Sieve ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).obj V)),
      T ∈ Scheme.ProEt.topology (wcXbar F X)
        ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).obj V) →
      ∃ R : Presieve V, Sieve.generate R ∈
          Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)) V ∧
        ∀ ⦃W : (Limits.pullback (wcPi2 F X) (wcPi2 F X)).ProEt⦄ (f : W ⟶ V), R f →
          ∃ (n : ℕ) (P : Fin n → (wcXbar F X).ProEt)
            (ι : ∀ k, P k ⟶ (wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).obj W),
            (∀ k, IsOpenImmersion (ι k).left) ∧
            (∀ x : ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).obj W).left,
              ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
            ∀ k, T (ι k ≫ (wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).map f) := by
    intro V T hT
    refine ⟨fun (W : (Limits.pullback (wcPi2 F X) (wcPi2 F X)).ProEt) (_ : W ⟶ V) =>
        IsAffine W.left ∧
        (IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, IsClosed ({x} : Set W.left) →
          HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))),
      wc_proet_cover_of_affine_local (fun Δ => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
        (fun V₀ hV₀ => wc_exists_wcontractible_cover V₀ hV₀) V, ?_⟩
    intro W f hRf
    obtain ⟨hWa, q1, q2, q3, q4⟩ := hRf
    haveI : IsAffine W.left := hWa
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hWa
    have hUa : IsAffine (Limits.pullback W.hom (Limits.pullback.diagonal (wcPi2 F X))) :=
      isAffine_of_isAffineHom (Limits.pullback.fst W.hom (Limits.pullback.diagonal (wcPi2 F X)))
    obtain ⟨r1, r2, r3, r4⟩ :=
      wc_wlocal_strictHensel_finite_stable
        (Limits.pullback.fst W.hom (Limits.pullback.diagonal (wcPi2 F X))) hWa q1 q2 q3 q4
    have hRET := wc_wlocal_strictHensel_retraction
      (Limits.pullback W.hom (Limits.pullback.diagonal (wcPi2 F X))) hUa r1 r2 r3 r4
    have hT' : T.pullback ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).map f) ∈
        Scheme.ProEt.topology (wcXbar F X)
          ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).obj W) :=
      (Scheme.ProEt.topology (wcXbar F X)).pullback_stable _ hT
    obtain ⟨n, P, fk, hPa, hTfk, hsurj⟩ :=
      wc_proet_cover_affine_finite_refine
        ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).obj W) hUa _ hT'
    obtain ⟨m, Q, ι, hopen, huniq, hfac⟩ :=
      wc_ret_disjoint_open_refine ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).obj W)
        hUa hRET n P fk hPa hsurj
    refine ⟨m, Q, ι, hopen, huniq, fun j => ?_⟩
    obtain ⟨k, h, hh⟩ := hfac j
    have hj := (T.pullback ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).map f)).downward_closed
      (hTfk k) h
    rw [hh] at hj
    exact hj

  haveI hepi := wc_sheafPushforward_preservesEpi_of_split
    (wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))) hsplit

  haveI hlim : Limits.PreservesFiniteLimits
      ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)))
        (Scheme.ProEt.topology (wcXbar F X))) :=
    inferInstance
  haveI : ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)))
      (Scheme.ProEt.topology (wcXbar F X))).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  haveI : ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)))
      (Scheme.ProEt.topology (wcXbar F X))).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)))
      (Scheme.ProEt.topology (wcXbar F X))).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hcolim : Limits.PreservesFiniteColimits
      ((wcProEtBC (Limits.pullback.diagonal (wcPi2 F X))).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)))
        (Scheme.ProEt.topology (wcXbar F X))) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology (Limits.pullback (wcPi2 F X) (wcPi2 F X)))
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology (wcXbar F X)) (wcRingSheaf (wcXbar F X) ℓ)
  exact (sheafOfModules_pushforward_exact (wcProEtBC (Limits.pullback.diagonal (wcPi2 F X)))
    (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)
    (wcRingSheaf (wcXbar F X) ℓ) DΔ.φ).2.2

theorem wc_diag_cycle_class_exists (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ]) (hηinj : Function.Injective η)
    (hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x)
    (ω : wcHM (wcXbar F X) ℓ (2 * d)) (hω : η ω = 1) :
    ∃ c : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      (∀ (j : ℕ) (hj : j ≤ 2 * d) (a : wcHM (wcXbar F X) ℓ j)
          (b : wcHM (wcXbar F X) ℓ (2 * d - j)),
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (j + 2 * d) (2 * d - j) (4 * d)
            (by omega)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d) (j + 2 * d) rfl
              (wcHMPull D1 j a) c) (wcHMPull D2 (2 * d - j) b) =
          wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d)
            (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b))
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d)
              (by omega) c (wcHMPull D2 (2 * d) ω))) ∧
      (∀ (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
          (ht : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
          (Dt : wcHMPullData t ℓ) (hDt : wcHMPullCanonical Dt) (m : ℕ),
        Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) →
        Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶
            Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)) //
          z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} = m →
        η (wcHMPull Dt (2 * d) c) = (m : ℚ_[ℓ])) :=
by
  classical

  have hassoc : ∀ (S : Scheme.{u}) (a₁ a₂ a₃ a₁₂ a₂₃ a : ℕ) (h₁₂ : a₁ + a₂ = a₁₂)
      (h₂₃ : a₂ + a₃ = a₂₃) (h1 : a₁₂ + a₃ = a) (h2 : a₁ + a₂₃ = a)
      (x : wcHM S ℓ a₁) (y : wcHM S ℓ a₂) (z : wcHM S ℓ a₃),
      wcHMCup S ℓ a₁₂ a₃ a h1 (wcHMCup S ℓ a₁ a₂ a₁₂ h₁₂ x y) z =
        wcHMCup S ℓ a₁ a₂₃ a h2 x (wcHMCup S ℓ a₂ a₃ a₂₃ h₂₃ y z) := by
    intro S a₁ a₂ a₃ a₁₂ a₂₃ a h₁₂ h₂₃ h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_assoc x y z h₁₂ h₂₃ (by omega)

  have hscR : ∀ (S : Scheme.{u}) (p q r : ℕ) (h : p + q = r) (x : wcHM S ℓ p) (w : wcHM S ℓ q)
      (t : ℚ_[ℓ]), wcHMCup S ℓ p q r h x (wcHMScalar S ℓ q t w) =
        wcHMScalar S ℓ r t (wcHMCup S ℓ p q r h x w) := by
    intro S p q r h x w t
    exact (hassoc S p q 0 r q r h (add_zero q) (add_zero r) h x w
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t))).symm

  have F1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (n : ℕ) (t : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n t x) = wcHMScalar S' ℓ n t (wcHMPull D n x) := by
    intro S S' f D hD n t x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hk : D.Φ.map (wcHMConst S ℓ t) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ t := by
      rw [← wc_hm_pull_const D hD t, Iso.hom_inv_id_assoc]
    have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)} (z : Abelian.Ext A B n)
        (a : B ⟶ C') (b : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero n)).comp (Abelian.Ext.mk₀ b) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero n) := by
      intro A B C' D' z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have e3 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero n))
      (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (zero_add n)
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (add_zero n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e3, e2, hk]

  have F3 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (p q r : ℕ) (h : p + q = r)
      (x : wcHM S ℓ p) (y : wcHM S ℓ q),
      wcHMPull D r (wcHMCup S ℓ p q r h x y) =
        wcHMCup S' ℓ p q r h (wcHMPull D p x) (wcHMPull D q y) := by
    intro S S' f D p q r h x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y h)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero r)) (zero_add r) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero p)) (zero_add p)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i1 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero p))
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) (zero_add p) h
      (by omega : 0 + p + q = r)
    have i2 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mk₀ D.μ.hom)
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i3 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q))
        (zero_add q)) (zero_add q) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q) := by
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    have i4 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) h
    rw [Abelian.Ext.mapExactFunctor_comp, i1, i2, i3, ← i4]

  obtain ⟨DΔ, hDΔ⟩ := wc_hm_pull_data_exists (Limits.pullback.diagonal (wcPi2 F X)) ℓ
  obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F X)) ℓ

  have F4 : ∀ (p : Limits.pullback (wcPi2 F X) (wcPi2 F X) ⟶ wcXbar F X)
      (hp : Limits.pullback.diagonal (wcPi2 F X) ≫ p = 𝟙 _) (Dp : wcHMPullData p ℓ)
      (hDp : wcHMPullCanonical Dp) (n : ℕ) (x : wcHM (wcXbar F X) ℓ n),
      wcHMPull DΔ n (wcHMPull Dp n x) = x := by
    intro p hp Dp hDp n x
    exact (wc_hm_pull_comp p (Limits.pullback.diagonal (wcPi2 F X)) (𝟙 _) hp Dp hDp DΔ hDΔ
      D0 hD0 n x).symm.trans (wc_hm_pull_id (𝟙 _) rfl D0 hD0 n x)

  have F5 : ∀ z : wcHM (wcXbar F X) ℓ (2 * d),
      z = wcHMScalar (wcXbar F X) ℓ (2 * d) (η z) ω := by
    intro z
    apply hηinj
    rw [hηc, hω, mul_one]

  obtain ⟨θ, t₀, ht₀, Dt₀, hDt₀, het₀, hne⟩ :=
    wc_diag_supp_point_class_nonzero F X d ℓ hℓ DΔ hDΔ
  obtain ⟨ζ, hζ⟩ := wc_diag_supp_transversal_count F X d ℓ hℓ DΔ hDΔ θ
  have hζ0 : ζ ≠ 0 := by
    intro h0
    apply hne
    rw [hζ t₀ ht₀ Dt₀ hDt₀ _ het₀ rfl, h0, map_zero]
  have hκ : η ζ ≠ 0 := fun h => hζ0 (hηinj (h.trans (map_zero η).symm))
  obtain ⟨c, hcdef⟩ : ∃ c : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      c = wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (η ζ)⁻¹
        (wcSuppClass DΔ (2 * d) θ) := ⟨_, rfl⟩

  have hex := wc_diag_pushforward_exact F X d ℓ DΔ hDΔ

  have K : ∀ x : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMPull DΔ (2 * d) x = 0 →
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega) x c = 0 := by
    intro x hx
    rw [hcdef, hscR, wc_closed_supp_class_restriction_zero_of_exact
      (Limits.pullback.diagonal (wcPi2 F X)) ℓ DΔ hex (2 * d) (2 * d) (4 * d) (by omega) θ x hx,
      map_zero]
  refine ⟨c, ?_, ?_⟩
  · intro j hj a b
    have hsign1 : ((-1 : ℤ) ^ (2 * d * (2 * d - j))) = 1 :=
      Even.neg_one_pow ((even_two_mul d).mul_right _)
    have hsign2 : ((-1 : ℤ) ^ (2 * d * (2 * d))) = 1 :=
      Even.neg_one_pow ((even_two_mul d).mul_right _)
    have hΔ : wcHMPull DΔ (2 * d)
        (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) (by omega)
          (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b) -
        wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)
          (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b))
          (wcHMPull D2 (2 * d) ω)) = 0 := by
      rw [map_sub, F3 DΔ, F1 DΔ hDΔ, F4 _ (Limits.pullback.diagonal_fst _) D1 hD1,
        F4 _ (Limits.pullback.diagonal_snd _) D2 hD2, F4 _ (Limits.pullback.diagonal_snd _) D2 hD2]
      exact sub_eq_zero.mpr (F5 _)
    have hK := K _ hΔ
    rw [map_sub, AddMonoidHom.sub_apply, sub_eq_zero] at hK
    calc wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (j + 2 * d) (2 * d - j) (4 * d)
            (by omega)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d) (j + 2 * d) rfl
              (wcHMPull D1 j a) c) (wcHMPull D2 (2 * d - j) b)
        = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (4 * d - j) (4 * d) (by omega)
            (wcHMPull D1 j a)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d - j) (4 * d - j)
              (by omega) c (wcHMPull D2 (2 * d - j) b)) :=
          hassoc _ j (2 * d) (2 * d - j) (j + 2 * d) (4 * d - j) (4 * d) rfl (by omega) (by omega)
            (by omega) _ _ _
      _ = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (4 * d - j) (4 * d) (by omega)
            (wcHMPull D1 j a)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d - j) (2 * d) (4 * d - j)
              (by omega) (wcHMPull D2 (2 * d - j) b) c) := by
          rw [wc_hm_graded_comm (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d - j)
            (4 * d - j) (by omega) (by omega) c (wcHMPull D2 (2 * d - j) b), hsign1, one_zsmul]
      _ = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) (by omega)
              (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b)) c :=
          (hassoc _ j (2 * d - j) (2 * d) (2 * d) (4 * d - j) (4 * d) (by omega) (by omega)
            (by omega) (by omega) _ _ _).symm
      _ = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
            (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)
              (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b))
              (wcHMPull D2 (2 * d) ω)) c := hK
      _ = wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega) c
            (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)
              (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b))
              (wcHMPull D2 (2 * d) ω)) := by
          rw [wc_hm_graded_comm (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d)
            (4 * d) (by omega) (by omega)
            (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)
              (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b))
              (wcHMPull D2 (2 * d) ω)) c, hsign2, one_zsmul]
      _ = wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (4 * d)
            (η (wcHMCup (wcXbar F X) ℓ j (2 * d - j) (2 * d) (by omega) a b))
            (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d)
              (by omega) c (wcHMPull D2 (2 * d) ω)) := hscR _ _ _ _ _ _ _ _
  · intro t ht Dt hDt m het hcard
    rw [hcdef, F1 Dt hDt, hηc, hζ t ht Dt hDt m het hcard, hηc, ← mul_assoc,
      mul_comm (η ζ)⁻¹ (m : ℚ_[ℓ]), mul_assoc, inv_mul_cancel₀ hκ, mul_one]

theorem wc_xbar_section_exists (F : Type u) [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] :
    ∃ x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X, x₀ ≫ wcPi2 F X = 𝟙 _ :=
by
  classical
  have K : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (Y : Scheme.{u}) (p : Y ⟶ Spec (.of Ω))
      [LocallyOfFiniteType p] [QuasiCompact p] [Nonempty Y],
      ∃ x₀ : Spec (.of Ω) ⟶ Y, x₀ ≫ p = 𝟙 _ := by
    intro Ω _ _ Y p _ _ _
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace p
    obtain ⟨y, -, hy⟩ := IsClosed.exists_closed_singleton (X := Y) isClosed_univ Set.univ_nonempty
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    set g := Y.fromSpecResidueField y ≫ p with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hsurj : Function.Surjective (Spec.preimage g).hom := by
      letI : Algebra Ω (Y.residueField y) := (Spec.preimage g).hom.toAlgebra
      haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
      haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
      intro s
      have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
      obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
      exact ⟨c, hc⟩
    have hinj : Function.Injective (Spec.preimage g).hom := RingHom.injective _
    let e : Ω ≃+* Y.residueField y := RingEquiv.ofBijective (Spec.preimage g).hom ⟨hinj, hsurj⟩
    refine ⟨Spec.map (CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω)) ≫
      Y.fromSpecResidueField y, ?_⟩
    have h1 : Spec.preimage g ≫ CommRingCat.ofHom (e.symm : Y.residueField y →+* Ω) = 𝟙 _ := by
      ext x
      exact e.symm_apply_apply x
    rw [Category.assoc, ← hg, ← hψ, ← Spec.map_comp]
    exact (congrArg (fun f => Spec.map f) h1).trans (Spec.map_id _)
  haveI : IrreducibleSpace (wcXbar F X) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
  haveI : LocallyOfFiniteType (wcPi2 F X) := by unfold wcPi2; infer_instance
  haveI : QuasiCompact (wcPi2 F X) := by unfold wcPi2; infer_instance
  exact K (AlgebraicClosure F) (wcXbar F X) (wcPi2 F X)

theorem wc_diag_class_norm (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ]) (hηinj : Function.Injective η)
    (hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x)
    (ω : wcHM (wcXbar F X) ℓ (2 * d)) (hω : η ω = 1) :
    ∀ c : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      (∀ (t : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
          (ht : t ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
          (Dt : wcHMPullData t ℓ) (hDt : wcHMPullCanonical Dt) (m : ℕ),
        Etale (Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) →
        Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶
            Limits.pullback t (Limits.pullback.diagonal (wcPi2 F X)) //
          z ≫ Limits.pullback.fst t (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} = m →
        η (wcHMPull Dt (2 * d) c) = (m : ℚ_[ℓ])) →
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
          c (wcHMPull D2 (2 * d) ω) =
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
          (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) ω) :=
by
  classical
  intro c hTC

  have H_assoc : ∀ (S : Scheme.{u}) (a b c ab bc abc : ℕ) (hab : a + b = ab) (hbc : b + c = bc)
      (h1 : ab + c = abc) (h2 : a + bc = abc) (x : wcHM S ℓ a) (y : wcHM S ℓ b) (z : wcHM S ℓ c),
      wcHMCup S ℓ ab c abc h1 (wcHMCup S ℓ a b ab hab x y) z =
        wcHMCup S ℓ a bc abc h2 x (wcHMCup S ℓ b c bc hbc y z) := by
    intro S a b c ab bc abc hab hbc h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show (x.comp y hab).comp z h1 = x.comp (y.comp z hbc) h2
    exact Abelian.Ext.comp_assoc x y z hab hbc (by omega)
  have H_scL : ∀ (S : Scheme.{u}) (i j k : ℕ) (hk : i + j = k) (c : ℚ_[ℓ]) (x : wcHM S ℓ i)
      (y : wcHM S ℓ j), wcHMCup S ℓ i j k hk (wcHMScalar S ℓ i c x) y =
        wcHMScalar S ℓ k c (wcHMCup S ℓ i j k hk x y) := by
    intro S i j k hk c x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero i)).comp y hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero, wc_hm_unit_end_central S ℓ (wcHMConst S ℓ c) j y]
    exact (Abelian.Ext.comp_assoc x y _ hk (add_zero j) (by omega)).symm
  have H_mul : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (i j k : ℕ) (hk : i + j = k)
      (x : wcHM S ℓ i) (y : wcHM S ℓ j),
      wcHMPull D k (wcHMCup S ℓ i j k hk x y) =
        wcHMCup S' ℓ i j k hk (wcHMPull D i x) (wcHMPull D j y) := by
    intro S S' f D i j k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) hk
    rw [Abelian.Ext.mapExactFunctor_comp]
    generalize Abelian.Ext.mapExactFunctor D.Φ x = z
    generalize Abelian.Ext.mapExactFunctor D.Φ y = w
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        (w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j)) (zero_add j)) (zero_add j) =
        w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero j) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        (z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) _ (zero_add i) hk (by omega),
      Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ D.μ.hom) _ (add_zero i) (zero_add j) (by omega), e1,
      Abelian.Ext.comp_assoc z w (Abelian.Ext.mk₀ D.μ.hom) hk (add_zero j) (by omega)]
  have pullConst0 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ),
      wcHMPullCanonical D → ∀ t : ℚ_[ℓ],
      wcHMPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t)) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S' ℓ t) := by
    intro S S' f D hD t
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (Abelian.Ext.mk₀ (wcHMConst S ℓ t))).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0))
        (zero_add 0) = Abelian.Ext.mk₀ (wcHMConst S' ℓ t)
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      wc_hm_pull_const D hD t]
  have pullScalar : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ),
      wcHMPullCanonical D → ∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n c x) = wcHMScalar S' ℓ n c (wcHMPull D n x) := by
    intro S S' f D hD n c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    have e0 : wcHMScalar S ℓ n c x =
        wcHMCup S ℓ n 0 n (add_zero n) x (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) := rfl
    have e0' : wcHMScalar S' ℓ n c (wcHMPull D n x) =
        wcHMCup S' ℓ n 0 n (add_zero n) (wcHMPull D n x) (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) := rfl
    rw [e0, e0', H_mul]
    congr 1
    exact pullConst0 D hD c
  have Hb0 : ∀ (S : Scheme.{u}) [PreconnectedSpace S] (b : wcHM S ℓ 0), ∃ t : ℚ_[ℓ],
      b = @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t) := by
    intro S _ b
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    obtain ⟨t, ht⟩ := wc_hm_unit_end_const S ℓ (Abelian.Ext.homEquiv₀ b)
    exact ⟨t, by rw [← ht, Abelian.Ext.mk₀_homEquiv₀_apply]⟩

  obtain ⟨x₀, hx₀⟩ := wc_xbar_section_exists F X
  obtain ⟨s, hs1, hs2⟩ : ∃ s : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X),
      s ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ ∧
      s ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x₀ :=
    ⟨Limits.pullback.lift (𝟙 _) (wcPi2 F X ≫ x₀)
        (by rw [Category.id_comp, Category.assoc, hx₀, Category.comp_id]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hu_eq_v : Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) =
      Limits.pullback.snd s (Limits.pullback.diagonal (wcPi2 F X)) := by
    have e := congrArg (fun k => k ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))
      (Limits.pullback.condition (f := s) (g := Limits.pullback.diagonal (wcPi2 F X)))
    simp only [Category.assoc, hs1, Limits.pullback.diagonal_fst, Category.comp_id] at e
    exact e
  have hstar : Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X ≫ x₀ =
      Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) := by
    have e := congrArg (fun k => k ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X))
      (Limits.pullback.condition (f := s) (g := Limits.pullback.diagonal (wcPi2 F X)))
    simp only [Category.assoc, hs2, Limits.pullback.diagonal_snd, Category.comp_id] at e
    rw [e]
    exact hu_eq_v.symm
  have hw : x₀ ≫ s = x₀ ≫ Limits.pullback.diagonal (wcPi2 F X) := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hs1, Limits.pullback.diagonal_fst, Category.comp_id]
    · simp only [Category.assoc, hs2, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [← Category.assoc, hx₀, Category.id_comp]
  have hiso : IsIso (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) := by
    refine ⟨⟨Limits.pullback.lift x₀ x₀ hw, ?_, ?_⟩⟩
    · apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst, Category.id_comp]
        exact hstar
      · simp only [Category.assoc, Limits.pullback.lift_snd, Category.id_comp]
        rw [hstar]
        exact hu_eq_v
    · rw [← Category.assoc, Limits.pullback.lift_fst, hx₀]
  have het : Etale (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X) :=
    inferInstance
  have hcard : Nat.card {z : Spec (.of (AlgebraicClosure F)) ⟶
      Limits.pullback s (Limits.pullback.diagonal (wcPi2 F X)) //
      z ≫ Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X = 𝟙 _} = 1 := by
    rw [Nat.card_eq_one_iff_unique]
    refine ⟨⟨fun a b => Subtype.ext ((cancel_mono _).mp (a.2.trans b.2.symm))⟩,
      ⟨⟨inv (Limits.pullback.fst s (Limits.pullback.diagonal (wcPi2 F X)) ≫ wcPi2 F X),
        IsIso.inv_hom_id _⟩⟩⟩
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists s ℓ
  obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F X)) ℓ
  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists (wcPi2 F X ≫ x₀) ℓ
  obtain ⟨Dρ, hDρ⟩ := wc_hm_pull_data_exists
    (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ (wcPi2 F X ≫ x₀)) ℓ
  have hTs := hTC s hs1 Ds hDs 1 het hcard
  rw [Nat.cast_one] at hTs
  have hsc : wcHMPull Ds (2 * d) c = ω := hηinj (hTs.trans hω.symm)

  have PA : ∀ (n : ℕ) (a : wcHM (wcXbar F X) ℓ n), wcHMPull Ds n (wcHMPull D1 n a) = a :=
    fun n a => (wc_hm_pull_comp _ _ _ hs1 D1 hD1 Ds hDs D0 hD0 n a).symm.trans
      (wc_hm_pull_id _ rfl D0 hD0 n a)
  have PB : ∀ (n : ℕ) (b : wcHM (wcXbar F X) ℓ n), wcHMPull Ds n (wcHMPull D2 n b) =
      wcHMPull Dg n b :=
    fun n b => (wc_hm_pull_comp _ _ _ hs2 D2 hD2 Ds hDs Dg hDg n b).symm
  have hρ : Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) ≫ (wcPi2 F X ≫ x₀) =
      Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) ≫ (wcPi2 F X ≫ x₀) := by
    rw [← Category.assoc, ← Category.assoc, Limits.pullback.condition]
  have PC : ∀ (n : ℕ) (b : wcHM (wcXbar F X) ℓ n),
      wcHMPull D1 n (wcHMPull Dg n b) = wcHMPull D2 n (wcHMPull Dg n b) :=
    fun n b => (wc_hm_pull_comp _ _ _ rfl Dg hDg D1 hD1 Dρ hDρ n b).symm.trans
      (wc_hm_pull_comp _ _ _ hρ Dg hDg D2 hD2 Dρ hDρ n b)

  have hW : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  obtain ⟨T, -, -⟩ := wc_hm_comparison F X hW ℓ
  have hvanHM : ∀ i : ℕ, 2 * d < i → ∀ x : wcHM (wcXbar F X) ℓ i, x = 0 := by
    intro i hi x
    have h0 := wc_coh_vanishing F X d ℓ hℓ hW i hi ((T i).symm x)
    calc x = T i ((T i).symm x) := (AddEquiv.apply_symm_apply _ _).symm
      _ = T i 0 := by rw [h0]
      _ = 0 := map_zero _

  haveI : IrreducibleSpace (wcXbar F X) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
  have K : ∀ (m k : ℕ) (hk : m + 2 * d = k) (b : wcHM (wcXbar F X) ℓ m),
      wcHMCup (wcXbar F X) ℓ m (2 * d) k hk b ω =
        wcHMCup (wcXbar F X) ℓ m (2 * d) k hk (wcHMPull Dg m b) ω := by
    intro m k hk b
    cases m with
    | zero =>
      obtain ⟨t, rfl⟩ := Hb0 (wcXbar F X) b
      rw [pullConst0 Dg hDg t]
    | succ m' =>
      exact (hvanHM k (by omega) _).trans (hvanHM k (by omega) _).symm

  have h44 : 2 * d + 2 * d = 4 * d := by omega
  have star : ∀ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) h44 z
          (wcHMPull D2 (2 * d) ω) =
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) h44
          (wcHMPull D1 (2 * d) (wcHMPull Ds (2 * d) z)) (wcHMPull D2 (2 * d) ω) := by
    intro z
    have gen : ∀ (t : ℚ_[ℓ]) (j : ℕ) (hj : j ≤ 2 * d) (hjj : j + (2 * d - j) = 2 * d)
        (a : wcHM (wcXbar F X) ℓ j) (b : wcHM (wcXbar F X) ℓ (2 * d - j)),
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) h44
            (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) t
              (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) hjj
                (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b)))
            (wcHMPull D2 (2 * d) ω) =
          wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) h44
            (wcHMPull D1 (2 * d) (wcHMPull Ds (2 * d)
              (wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) t
                (wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ j (2 * d - j) (2 * d) hjj
                  (wcHMPull D1 j a) (wcHMPull D2 (2 * d - j) b)))))
            (wcHMPull D2 (2 * d) ω) := by
      intro t j hj hjj a b
      rw [pullScalar Ds hDs, H_mul Ds, PA, PB, pullScalar D1 hD1, H_mul D1, PC,
        H_scL, H_scL,
        H_assoc (Limits.pullback (wcPi2 F X) (wcPi2 F X)) j (2 * d - j) (2 * d) (2 * d) (4 * d - j)
          (4 * d) hjj (by omega) h44 (by omega),
        H_assoc (Limits.pullback (wcPi2 F X) (wcPi2 F X)) j (2 * d - j) (2 * d) (2 * d) (4 * d - j)
          (4 * d) hjj (by omega) h44 (by omega),
        ← H_mul D2 (2 * d - j) (2 * d) (4 * d - j) (by omega),
        ← H_mul D2 (2 * d - j) (2 * d) (4 * d - j) (by omega),
        ← K (2 * d - j) (4 * d - j) (by omega) b]
    have hmem := wc_ybar_kunneth_span F X d ℓ hℓ D1 hD1 D2 hD2 z
    refine AddSubgroup.closure_induction
      (p := fun z _ => wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) h44 z
          (wcHMPull D2 (2 * d) ω) =
        wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) h44
          (wcHMPull D1 (2 * d) (wcHMPull Ds (2 * d) z)) (wcHMPull D2 (2 * d) ω))
      ?_ ?_ ?_ ?_ hmem
    · intro w hw
      obtain ⟨t, j, hj, a, b, rfl⟩ := hw
      exact gen t j hj _ a b
    · simp only [map_zero, AddMonoidHom.zero_apply]
    · intro x y _ _ hx hy
      simp only [map_add, AddMonoidHom.add_apply]
      rw [hx, hy]
    · intro x _ hx
      simp only [map_neg, AddMonoidHom.neg_apply]
      rw [hx]

  have hfin := star c
  rw [hsc] at hfin
  exact hfin

theorem wc_diag_class_fixed_count (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (φ : wcXbar F X ⟶ wcXbar F X) (hφ : wcIsAbsFrob φ (Nat.card F))
    (hF : (wcGeomFrobX F X h ≫ φ) ≫ wcPi2 F X = wcPi2 F X)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (Dγ : ∀ m : ℕ, wcHMPullData (wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF m) ℓ)
    (hDγ : ∀ m : ℕ, wcHMPullCanonical (Dγ m))
    (η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ]) (hηinj : Function.Injective η)
    (hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x)
    (ω : wcHM (wcXbar F X) ℓ (2 * d)) (hω : η ω = 1) :
    ∃ c : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcDI D1 D2 d η ω c ∧
      ∀ n : ℕ, 1 ≤ n → η (wcHMPull (Dγ n) (2 * d) c) =
        (Nat.card {x : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F (AlgebraicClosure F)) ⟶ X //
          Spec.map (CommRingCat.ofHom
            (((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
                (AlgebraicClosure F) _ _ _) ^ n :
                AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) : AlgebraicClosure F →+* AlgebraicClosure F))
            ≫ x.left = x.left} : ℚ_[ℓ]) :=
by
  obtain ⟨c, hPF, hTC⟩ := wc_diag_cycle_class_exists F X d ℓ hℓ D1 hD1 D2 hD2 η hηinj hηc ω hω
  have hN := wc_diag_class_norm F X d ℓ hℓ D1 hD1 D2 hD2 η hηinj hηc ω hω c hTC
  refine ⟨c, ?_, ?_⟩
  · intro j hj a b
    rw [hPF j hj a b, hN]
  · intro n hn
    have ht : wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF n ≫
        Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ := by
      unfold wcGraph
      exact Limits.pullback.lift_fst _ _ _
    exact hTC (wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF n) ht (Dγ n) (hDγ n) _
      (wc_frob_fix_scheme_etale F X d h φ hφ hF n hn)
      (wc_frob_fix_scheme_points F X d h φ hφ hF n)

theorem wc_lefschetz_frob_fixed (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hvan : ∀ i : ℕ, 2 * d < i → ∀ x : wcCoh F X h ℓ i, x = 0) :
    ∃ (r : ℕ → ℕ) (M : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ]),
      (∀ i ≤ 2 * d, ∃ e : wcCoh F X h ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]),
        (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i), e (wcCohScalar F X h ℓ i c x) = c • e x) ∧
        M i = wcAddEquivMatrix e (wcCohFrob F X h ℓ i)) ∧
      ∀ n : ℕ, 1 ≤ n →
        (Nat.card {x : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F (AlgebraicClosure F)) ⟶ X //
          Spec.map (CommRingCat.ofHom
            (((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
                (AlgebraicClosure F) _ _ _) ^ n :
                AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) : AlgebraicClosure F →+* AlgebraicClosure F))
            ≫ x.left = x.left} : ℚ_[ℓ]) =
          ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((M i) ^ n).trace :=
by
  classical
  choose r e he using wc_coh_finite F X d ℓ hℓ h
  refine ⟨r, fun i => wcAddEquivMatrix (e i) (wcCohFrob F X h ℓ i),
    fun i _ => ⟨e i, he i, rfl⟩, ?_⟩
  intro n hn
  obtain ⟨T, hTs, hTF⟩ := wc_hm_comparison F X h ℓ
  obtain ⟨⟨e₁, he₁⟩, -⟩ := wc_top_coh_frobenius F X d ℓ hℓ h
  obtain ⟨φ, hφ, hF⟩ := wc_abs_frob_exists F X h
  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists (wcGeomFrobX F X h) ℓ
  obtain ⟨DF, hDF⟩ := wc_hm_pull_data_exists (wcGeomFrobX F X h ≫ φ) ℓ
  obtain ⟨D1, hD1⟩ := wc_hm_pull_data_exists (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ
  obtain ⟨D2, hD2⟩ := wc_hm_pull_data_exists (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ
  choose Dγ hDγ using fun m : ℕ =>
    wc_hm_pull_data_exists (wcGraph (wcPi2 F X) (wcGeomFrobX F X h ≫ φ) hF m) ℓ
  have hTinv : ∀ (i : ℕ) (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ i),
      (T i).symm (wcHMScalar (wcXbar F X) ℓ i c y) = wcCohScalar F X h ℓ i c ((T i).symm y) := by
    intro i c y
    apply (T i).injective
    rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
  let η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ] :=
    (Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0).comp
      (e₁.toAddMonoidHom.comp (T (2 * d)).symm.toAddMonoidHom)
  have hηapp : ∀ y, η y = e₁ ((T (2 * d)).symm y) 0 := fun y => rfl
  have hηinj : Function.Injective η := by
    intro y y' hyy
    rw [hηapp, hηapp] at hyy
    have h1 : e₁ ((T (2 * d)).symm y) = e₁ ((T (2 * d)).symm y') := by
      funext k
      rw [Subsingleton.elim k 0]
      exact hyy
    exact (T (2 * d)).symm.injective (e₁.injective h1)
  have hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x := by
    intro c x
    rw [hηapp, hηapp, hTinv, he₁]
    rfl
  let ω : wcHM (wcXbar F X) ℓ (2 * d) := T (2 * d) (e₁.symm (fun _ => 1))
  have hω : η ω = 1 := by
    rw [hηapp]
    simp only [ω, AddEquiv.symm_apply_apply, AddEquiv.apply_symm_apply]
  have hvanHM : ∀ i : ℕ, 2 * d < i → ∀ x : wcHM (wcXbar F X) ℓ i, x = 0 := by
    intro i hi x
    have h0 := hvan i hi ((T i).symm x)
    calc x = T i ((T i).symm x) := (AddEquiv.apply_symm_apply _ _).symm
      _ = T i 0 := by rw [h0]
      _ = 0 := map_zero _
  let E : ∀ i : ℕ, wcHM (wcXbar F X) ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]) := fun i => (T i).symm.trans (e i)
  have hE : ∀ i ≤ 2 * d, ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ i),
      E i (wcHMScalar (wcXbar F X) ℓ i c x) = c • E i x := by
    intro i _ c x
    show e i ((T i).symm (wcHMScalar (wcXbar F X) ℓ i c x)) = c • e i ((T i).symm x)
    rw [hTinv, he]
  obtain ⟨c, hcDI, hcount⟩ := wc_diag_class_fixed_count F X d ℓ hℓ h φ hφ hF D1 hD1 D2 hD2
    Dγ hDγ η hηinj hηc ω hω
  obtain ⟨c₀, hc₀DI, htr⟩ := wc_lefschetz_diag_trace F X d ℓ hℓ (wcGeomFrobX F X h ≫ φ) hF
    D1 hD1 D2 hD2 Dγ hDγ DF hDF η hηinj hηc ω hω hvanHM r E hE
  have hcc : c = c₀ :=
    wc_diag_class_unique F X d ℓ hℓ D1 hD1 D2 hD2 η hηinj hηc ω hω c c₀ hcDI hc₀DI
  rw [← hcount n hn, hcc, htr n hn]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  have hmat : wcAddEquivMatrix (E i) (wcHMPull DF i) =
      wcAddEquivMatrix (e i) (wcCohFrob F X h ℓ i) := by
    ext a b
    show e i ((T i).symm (wcHMPull DF i (T i ((e i).symm (Pi.single b 1))))) a =
      e i (wcCohFrob F X h ℓ i ((e i).symm (Pi.single b 1))) a
    rw [wc_baffling F X h ℓ φ hφ Dg hDg DF hDF, ← hTF Dg hDg, AddEquiv.symm_apply_apply]
  rw [hmat]

theorem wc_trace_formula (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hvan : ∀ i : ℕ, 2 * d < i → ∀ x : wcCoh F X h ℓ i, x = 0)
    (r : ℕ → ℕ) (M : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ])
    (hM : ∀ i ≤ 2 * d, ∃ e : wcCoh F X h ℓ i ≃+ (Fin (r i) → ℚ_[ℓ]),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i), e (wcCohScalar F X h ℓ i c x) = c • e x) ∧
      M i = wcAddEquivMatrix e (wcCohFrob F X h ℓ i))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] :
    (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℚ_[ℓ]) =
      ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((M i) ^ Module.finrank F E).trace :=
by
  classical

  have s3 : ∀ (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i),
      wcCohFrob F X h ℓ i (wcCohScalar F X h ℓ i c x) =
        wcCohScalar F X h ℓ i c (wcCohFrob F X h ℓ i x) := by
    intro i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm

  have s2 : ∀ {V : Type (u+1)} [AddCommGroup V] {r₁ r₂ : ℕ}
      (s : ℚ_[ℓ] → V →+ V) (e₁ : V ≃+ (Fin r₁ → ℚ_[ℓ])) (e₂ : V ≃+ (Fin r₂ → ℚ_[ℓ]))
      (he₁ : ∀ (c : ℚ_[ℓ]) (x : V), e₁ (s c x) = c • e₁ x)
      (he₂ : ∀ (c : ℚ_[ℓ]) (x : V), e₂ (s c x) = c • e₂ x)
      (Φ : V →+ V) (hΦ : ∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x)) (n : ℕ),
      ((wcAddEquivMatrix e₁ Φ) ^ n).trace = ((wcAddEquivMatrix e₂ Φ) ^ n).trace := by
    intro V _ r₁ r₂ s e₁ e₂ he₁ he₂ Φ hΦ n
    have hes₁ : ∀ (c : ℚ_[ℓ]) (v : Fin r₁ → ℚ_[ℓ]), e₁.symm (c • v) = s c (e₁.symm v) :=
      fun c v => e₁.injective (by rw [he₁, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hes₂ : ∀ (c : ℚ_[ℓ]) (v : Fin r₂ → ℚ_[ℓ]), e₂.symm (c • v) = s c (e₂.symm v) :=
      fun c v => e₂.injective (by rw [he₂, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let LA : (Fin r₁ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₁ → ℚ_[ℓ]) :=
      { toFun := fun v => e₁ (Φ (e₁.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes₁, hΦ, he₁, RingHom.id_apply] }
    let LB : (Fin r₂ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₂ → ℚ_[ℓ]) :=
      { toFun := fun v => e₂ (Φ (e₂.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes₂, hΦ, he₂, RingHom.id_apply] }
    let LP : (Fin r₁ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₂ → ℚ_[ℓ]) :=
      { toFun := fun v => e₂ (e₁.symm v)
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes₁, he₂, RingHom.id_apply] }
    let LQ : (Fin r₂ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₁ → ℚ_[ℓ]) :=
      { toFun := fun v => e₁ (e₂.symm v)
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes₂, he₁, RingHom.id_apply] }
    have hA : wcAddEquivMatrix e₁ Φ = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hB : wcAddEquivMatrix e₂ Φ = LinearMap.toMatrix' LB := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hQP : LinearMap.toMatrix' LQ * LinearMap.toMatrix' LP = 1 := by
      rw [← LinearMap.toMatrix'_comp, ← LinearMap.toMatrix'_id]
      congr 1
      apply LinearMap.ext
      intro v
      show e₁ (e₂.symm (e₂ (e₁.symm v))) = v
      rw [AddEquiv.symm_apply_apply, AddEquiv.apply_symm_apply]
    have hPQ : LinearMap.toMatrix' LP * LinearMap.toMatrix' LQ = 1 := by
      rw [← LinearMap.toMatrix'_comp, ← LinearMap.toMatrix'_id]
      congr 1
      apply LinearMap.ext
      intro v
      show e₂ (e₁.symm (e₁ (e₂.symm v))) = v
      rw [AddEquiv.symm_apply_apply, AddEquiv.apply_symm_apply]
    have hBA : LinearMap.toMatrix' LB =
        LinearMap.toMatrix' LP * LinearMap.toMatrix' LA * LinearMap.toMatrix' LQ := by
      rw [← LinearMap.toMatrix'_comp, ← LinearMap.toMatrix'_comp]
      congr 1
      apply LinearMap.ext
      intro v
      show e₂ (Φ (e₂.symm v)) = e₂ (e₁.symm (e₁ (Φ (e₁.symm (e₁ (e₂.symm v))))))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]
    set A := LinearMap.toMatrix' LA
    set B := LinearMap.toMatrix' LB
    set P := LinearMap.toMatrix' LP
    set Q := LinearMap.toMatrix' LQ
    have hpow : ∀ k : ℕ, B ^ k = P * A ^ k * Q := by
      intro k
      induction k with
      | zero => rw [pow_zero, pow_zero, Matrix.mul_one, hPQ]
      | succ k ih =>
        rw [pow_succ, ih, hBA, pow_succ]
        calc P * A ^ k * Q * (P * A * Q) = P * A ^ k * (Q * P) * A * Q := by
              simp only [Matrix.mul_assoc]
          _ = P * (A ^ k * A) * Q := by rw [hQP, Matrix.mul_one]; simp only [Matrix.mul_assoc]
    rw [hA, hB, hpow n, Matrix.trace_mul_comm, ← Matrix.mul_assoc, hQP, Matrix.one_mul]

  have hn : 1 ≤ Module.finrank F E := Module.finrank_pos
  rw [wc_points_eq_frob_fixed F X E]
  obtain ⟨r', M', hM', htr⟩ := wc_lefschetz_frob_fixed F X d ℓ hℓ h hvan
  rw [htr _ hn]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  have hi' : i ≤ 2 * d := Finset.mem_Iic.mp hi
  obtain ⟨e, he, hMi⟩ := hM i hi'
  obtain ⟨e', he', hM'i⟩ := hM' i hi'
  rw [hMi, hM'i, s2 (wcCohScalar F X h ℓ i) e' e he' he (wcCohFrob F X h ℓ i) (s3 i)]

theorem wc_cup_product_perfect (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hone : ∃ e₁ : wcCoh F X h ℓ (2 * d) ≃+ (Fin 1 → ℚ_[ℓ]),
      ∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
        e₁ (wcCohScalar F X h ℓ (2 * d) c x) = c • e₁ x)
    (i : ℕ) (hi : i ≤ 2 * d) :
    ∃ cup : wcCoh F X h ℓ i →+ wcCoh F X h ℓ (2 * d - i) →+ wcCoh F X h ℓ (2 * d),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i) (y : wcCoh F X h ℓ (2 * d - i)),
        cup (wcCohScalar F X h ℓ i c x) y = wcCohScalar F X h ℓ (2 * d) c (cup x y)) ∧
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i) (y : wcCoh F X h ℓ (2 * d - i)),
        cup x (wcCohScalar F X h ℓ (2 * d - i) c y) = wcCohScalar F X h ℓ (2 * d) c (cup x y)) ∧
      (∀ (x : wcCoh F X h ℓ i) (y : wcCoh F X h ℓ (2 * d - i)),
        wcCohFrob F X h ℓ (2 * d) (cup x y) =
          cup (wcCohFrob F X h ℓ i x) (wcCohFrob F X h ℓ (2 * d - i) y)) ∧
      (∀ x : wcCoh F X h ℓ i, (∀ y, cup x y = 0) → x = 0) ∧
      (∀ y : wcCoh F X h ℓ (2 * d - i), (∀ x, cup x y = 0) → y = 0) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _
  obtain ⟨T, hTs, hTF⟩ := wc_modcoh_comparison F X h ℓ
  obtain ⟨hpl, hpr⟩ := wc_modcup_perfect F X d ℓ hℓ h i hi
  have hk : i + (2 * d - i) = 2 * d := Nat.add_sub_cancel' hi

  have hcent : ∀ (τ : 𝟭 (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) ⟶ 𝟭 _)
      {A B : SheafOfModules.{u+1} (wcSliceRing F X h ℓ)} {n : ℕ} (α : Abelian.Ext A B n),
      (Abelian.Ext.mk₀ (τ.app A)).comp α (zero_add n) =
        α.comp (Abelian.Ext.mk₀ (τ.app B)) (add_zero n) := by
    intro τ A B n α
    let hmod : ∀ A' B' : SheafOfModules.{u+1} (wcSliceRing F X h ℓ),
        Module (CatCenter (SheafOfModules.{u+1} (wcSliceRing F X h ℓ))) (A' ⟶ B') := fun A' B' =>
      { one_smul := fun f => by rw [CatCenter.smul_eq]; exact Category.comp_id f
        mul_smul := fun a b f => by
          rw [CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.mul_app,
            Category.assoc, CatCenter.naturality a (b.app B')]
        smul_zero := fun a => by rw [CatCenter.smul_eq, Limits.zero_comp]
        smul_add := fun a f g => by
          rw [CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.smul_eq, Preadditive.add_comp]
        add_smul := fun a b f => by
          rw [CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.smul_eq]
          exact Preadditive.comp_add _ _ _ _ _ _
        zero_smul := fun f => by
          rw [CatCenter.smul_eq]
          exact Limits.comp_zero }
    letI : Linear (CatCenter (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)))
        (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) :=
      { homModule := hmod
        smul_comp := fun A' B' D r f g => by
          rw [CatCenter.smul_eq, CatCenter.smul_eq, Category.assoc, Category.assoc,
            CatCenter.naturality r g]
        comp_smul := fun A' B' D f r g => by
          rw [CatCenter.smul_eq, CatCenter.smul_eq, Category.assoc] }
    let z : CatCenter (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := τ
    have h1 : τ.app A = z • 𝟙 A := by
      rw [CatCenter.smul_eq, Category.id_comp]
      try rfl
    have h2 : τ.app B = z • 𝟙 B := by
      rw [CatCenter.smul_eq, Category.id_comp]
      try rfl
    rw [h1, h2, Abelian.Ext.mk₀_smul, Abelian.Ext.mk₀_smul, Abelian.Ext.smul_comp,
      Abelian.Ext.comp_smul]
    exact congrArg (z • ·) ((Abelian.Ext.mk₀_id_comp α).trans (Abelian.Ext.comp_mk₀_id α).symm)

  have hconst : ∀ c : ℚ_[ℓ], ∃ τ : 𝟭 (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) ⟶ 𝟭 _,
      τ.app (SheafOfModules.unit (wcSliceRing F X h ℓ)) = wcModConst F X h ℓ c := by
    intro c
    let cV : ∀ V, ↑((wcSliceRing F X h ℓ).obj.obj V) := fun V =>
      (ContinuousMap.const _ (ULift.up c) : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]))
    have hcomm : ∀ V (r : ↑((wcSliceRing F X h ℓ).obj.obj V)), cV V * r = r * cV V := by
      intro V r
      exact @mul_comm C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]) _ (cV V) r
    have hres : ∀ ⦃V W⦄ (f : V ⟶ W), ((wcSliceRing F X h ℓ).obj.map f).hom (cV V) = cV W :=
      fun _ _ _ => rfl
    let τapp : ∀ M : SheafOfModules.{u+1} (wcSliceRing F X h ℓ), M ⟶ M := fun M =>
      ⟨PresheafOfModules.homMk
        { app := fun V => AddCommGrpCat.ofHom (DistribSMul.toAddMonoidHom (M.val.obj V) (cV V))
          naturality := fun V W f => by
            ext m
            have hm := M.val.map_smul f (cV V) m
            rw [hres f] at hm
            exact hm.symm }
        (fun V r m => by
          change cV V • (r • m) = r • (cV V • m)
          rw [smul_smul, smul_smul, hcomm])⟩
    refine ⟨{ app := τapp, naturality := ?_ }, ?_⟩
    · intro M N φ
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      ext m
      change cV V • (φ.val.app V).hom m = (φ.val.app V).hom (cV V • m)
      exact ((φ.val.app V).hom.map_smul (cV V) m).symm
    · show τapp (SheafOfModules.unit (wcSliceRing F X h ℓ)) = wcModConst F X h ℓ c
      rw [wcModConst, Equiv.eq_symm_apply]
      apply Subtype.ext
      funext V
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      exact mul_one (cV V)

  have hU1 : ∀ (a : wcModCoh F X h ℓ i) (b : wcModCoh F X h ℓ (2 * d - i)),
      wcModCup F X h ℓ i (2 * d - i) (2 * d) hk a b = a.comp b hk := fun _ _ => rfl
  have hU2 : ∀ (n : ℕ) (c : ℚ_[ℓ]) (a : wcModCoh F X h ℓ n),
      wcModScalar F X h ℓ n c a = a.comp (Abelian.Ext.mk₀ (wcModConst F X h ℓ c)) (add_zero n) :=
    fun _ _ _ => rfl

  obtain ⟨cup, hcup⟩ : ∃ cup : wcCoh F X h ℓ i →+ wcCoh F X h ℓ (2 * d - i) →+ wcCoh F X h ℓ (2 * d),
      ∀ x y, cup x y = (T (2 * d)).symm
        (wcModCup F X h ℓ i (2 * d - i) (2 * d) hk (T i x) (T (2 * d - i) y)) :=
    ⟨(((wcModCup F X h ℓ i (2 * d - i) (2 * d) hk).comp (T i).toAddMonoidHom).compl₂
        (T (2 * d - i)).toAddMonoidHom).compr₂ (T (2 * d)).symm.toAddMonoidHom,
      fun _ _ => rfl⟩
  refine ⟨cup, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro c x y
    obtain ⟨τ, hτ⟩ := hconst c
    have hc := hcent τ (T (2 * d - i) y)
    rw [hτ] at hc
    apply (T (2 * d)).injective
    rw [hcup, hcup, AddEquiv.apply_symm_apply, hTs, hTs, AddEquiv.apply_symm_apply, hU1, hU1,
      hU2, hU2]
    rw [Abelian.Ext.comp_assoc (T i x) (Abelian.Ext.mk₀ (wcModConst F X h ℓ c))
        (T (2 * d - i) y) (add_zero i) (zero_add _) (by omega),
      Abelian.Ext.comp_assoc (T i x) (T (2 * d - i) y) (Abelian.Ext.mk₀ (wcModConst F X h ℓ c))
        hk (add_zero _) (by omega), hc]
  ·
    intro c x y
    apply (T (2 * d)).injective
    rw [hcup, hcup, AddEquiv.apply_symm_apply, hTs, hTs, AddEquiv.apply_symm_apply, hU1, hU1,
      hU2, hU2]
    rw [Abelian.Ext.comp_assoc (T i x) (T (2 * d - i) y) (Abelian.Ext.mk₀ (wcModConst F X h ℓ c))
        hk (add_zero _) (by omega)]
  ·
    intro x y
    rw [hcup, hcup]
    exact hTF i (2 * d - i) (2 * d) hk x y
  ·
    intro x hx
    have h0 : T i x = 0 := by
      apply hpl (T i x)
      intro y'
      have hy := hx ((T (2 * d - i)).symm y')
      rw [hcup, AddEquiv.apply_symm_apply, AddEquiv.map_eq_zero_iff] at hy
      exact hy
    exact (AddEquiv.map_eq_zero_iff (T i)).mp h0
  ·
    intro y hy
    have h0 : T (2 * d - i) y = 0 := by
      apply hpr (T (2 * d - i) y)
      intro x'
      have hx := hy ((T i).symm x')
      rw [hcup, AddEquiv.apply_symm_apply, AddEquiv.map_eq_zero_iff] at hx
      exact hx
    exact (AddEquiv.map_eq_zero_iff (T (2 * d - i))).mp h0

theorem wc_poincare_duality (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hone : ∃ e₁ : wcCoh F X h ℓ (2 * d) ≃+ (Fin 1 → ℚ_[ℓ]),
      ∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
        e₁ (wcCohScalar F X h ℓ (2 * d) c x) = c • e₁ x)
    (htop : ∀ x : wcCoh F X h ℓ (2 * d),
      wcCohFrob F X h ℓ (2 * d) x = wcCohScalar F X h ℓ (2 * d) ((Nat.card F : ℚ_[ℓ]) ^ d) x) :
    ∀ i ≤ 2 * d, ∀ (r r' : ℕ) (e : wcCoh F X h ℓ i ≃+ (Fin r → ℚ_[ℓ]))
      (e' : wcCoh F X h ℓ (2 * d - i) ≃+ (Fin r' → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i), e (wcCohScalar F X h ℓ i c x) = c • e x) →
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d - i)),
        e' (wcCohScalar F X h ℓ (2 * d - i) c x) = c • e' x) →
      ∃ P : Matrix (Fin r) (Fin r') ℚ_[ℓ],
        (wcAddEquivMatrix e (wcCohFrob F X h ℓ i)).transpose * P *
            wcAddEquivMatrix e' (wcCohFrob F X h ℓ (2 * d - i)) =
          ((Nat.card F : ℚ_[ℓ]) ^ d) • P ∧
        (∀ v : Fin r → ℚ_[ℓ], Matrix.vecMul v P = 0 → v = 0) ∧
        (∀ w : Fin r' → ℚ_[ℓ], P.mulVec w = 0 → w = 0) :=
by
  classical
  intro i hi r r' e e' he he'
  obtain ⟨e₁, he₁⟩ := hone
  obtain ⟨cup, hl, hr, hF, hpl, hpr⟩ := wc_cup_product_perfect F X d ℓ hℓ h ⟨e₁, he₁⟩ i hi

  let β : Fin r → wcCoh F X h ℓ i := fun a => e.symm (Pi.single a 1)
  let β' : Fin r' → wcCoh F X h ℓ (2 * d - i) := fun b => e'.symm (Pi.single b 1)

  let η : wcCoh F X h ℓ (2 * d) →+ ℚ_[ℓ] :=
    (Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0).comp e₁.toAddMonoidHom
  have hη : ∀ z, η z = e₁ z 0 := fun _ => rfl
  have hη_s : ∀ (a : ℚ_[ℓ]) z, η (wcCohScalar F X h ℓ (2 * d) a z) = a * η z := by
    intro a z
    rw [hη, hη, he₁, Pi.smul_apply, smul_eq_mul]
  have hη_inj : ∀ z, η z = 0 → z = 0 := by
    intro z hz
    apply e₁.injective
    rw [map_zero]
    funext t
    rw [Fin.fin_one_eq_zero t]
    exact hz

  have hexp : ∀ x : wcCoh F X h ℓ i, x = ∑ j, wcCohScalar F X h ℓ i (e x j) (β j) := by
    intro x
    apply e.injective
    rw [map_sum]
    conv_lhs => rw [← Finset.univ_sum_single (e x)]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [he, AddEquiv.apply_symm_apply]
    funext t
    simp only [Pi.smul_apply, smul_eq_mul, Pi.single_apply]
    split_ifs with ht
    · subst ht; simp
    · simp
  have hexp' : ∀ y : wcCoh F X h ℓ (2 * d - i),
      y = ∑ k, wcCohScalar F X h ℓ (2 * d - i) (e' y k) (β' k) := by
    intro y
    apply e'.injective
    rw [map_sum]
    conv_lhs => rw [← Finset.univ_sum_single (e' y)]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [he', AddEquiv.apply_symm_apply]
    funext t
    simp only [Pi.smul_apply, smul_eq_mul, Pi.single_apply]
    split_ifs with ht
    · subst ht; simp
    · simp

  obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin r) (Fin r') ℚ_[ℓ],
      ∀ a b, P a b = η (cup (β a) (β' b)) := ⟨Matrix.of fun a b => η (cup (β a) (β' b)), fun _ _ => rfl⟩
  have hgram : ∀ x y, η (cup x y) = ∑ j, ∑ k, e x j * P j k * e' y k := by
    intro x y
    have hsplit : η (cup x y) = ∑ j, ∑ k, η (cup (wcCohScalar F X h ℓ i (e x j) (β j))
        (wcCohScalar F X h ℓ (2 * d - i) (e' y k) (β' k))) := by
      conv_lhs => rw [hexp x, hexp' y]
      simp only [map_sum, AddMonoidHom.finset_sum_apply]
      exact Finset.sum_comm
    rw [hsplit]
    refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun k _ => ?_))
    rw [hl, hr, hη_s, hη_s, hP]
    ring
  have hM : ∀ j a, wcAddEquivMatrix e (wcCohFrob F X h ℓ i) j a =
      e (wcCohFrob F X h ℓ i (β a)) j := fun _ _ => rfl
  have hM' : ∀ k b, wcAddEquivMatrix e' (wcCohFrob F X h ℓ (2 * d - i)) k b =
      e' (wcCohFrob F X h ℓ (2 * d - i) (β' b)) k := fun _ _ => rfl
  refine ⟨P, ?_, ?_, ?_⟩
  · ext a b
    have key := hgram (wcCohFrob F X h ℓ i (β a)) (wcCohFrob F X h ℓ (2 * d - i) (β' b))
    rw [← hF, htop, hη_s, ← hP] at key
    simp only [Matrix.mul_apply, Matrix.transpose_apply, hM, hM', Matrix.smul_apply, smul_eq_mul,
      Finset.sum_mul]
    rw [Finset.sum_comm, key]
  · intro v hv
    have hv' : ∀ k, ∑ j, v j * P j k = 0 := fun k => by
      have := congrFun hv k
      simpa [Matrix.vecMul, dotProduct] using this
    have hx : e.symm v = 0 := by
      apply hpl
      intro y
      apply hη_inj
      rw [hgram, AddEquiv.apply_symm_apply, Finset.sum_comm]
      simp_rw [← Finset.sum_mul, hv', zero_mul, Finset.sum_const_zero]
    simpa using congrArg e hx
  · intro w hw
    have hw' : ∀ j, ∑ k, P j k * w k = 0 := fun j => by
      have := congrFun hw j
      simpa [Matrix.mulVec, dotProduct] using this
    have hy : e'.symm w = 0 := by
      apply hpr
      intro x
      apply hη_inj
      rw [hgram, AddEquiv.apply_symm_apply]
      simp_rw [mul_assoc, ← Finset.mul_sum, hw', mul_zero, Finset.sum_const_zero]
    simpa using congrArg e' hy

theorem wc_coh_zero_frob_id (F' : Type u) [Finite F'] [Field F'] (Y : Over (Spec (.of F')))
    [GeometricallyIrreducible Y.hom]
    (h : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (x : wcCoh F' Y h ℓ 0) :
    wcCohFrob F' Y h ℓ 0 x = x :=
by
  classical

  haveI hirr : IrreducibleSpace ↥(Limits.pullback Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    (geometrically_iff_of_isClosedUnderIsomorphisms.mp
      (GeometricallyIrreducible.geometrically_irreducibleSpace (f := Y.hom))) (AlgebraicClosure F')
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))
  have hconst : ∀ (f : C(↥(Limits.pullback Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))), ℚ_[ℓ]))
      (a b : ↥(Limits.pullback Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))), f a = f b := by
    intro f a b
    have hpc : _root_.IsPreconnected (Set.univ : Set ↥(Limits.pullback Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) :=
      (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.isPreconnected
    have hs := (hpc.image f f.continuous.continuousOn).subsingleton
    exact hs ⟨a, trivial, rfl⟩ ⟨b, trivial, rfl⟩

  have hsec : ∀ t : (wcLadicSheaf Y.left ℓ).obj.obj (Opposite.op (wcGeomPoint F' Y h)),
      (wcLadicSheaf Y.left ℓ).obj.map (wcGeomFrob F' Y h).op t = t := by
    intro t
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    exact hconst (ULift.down t) ((wcGeomFrob F' Y h).left a) a

  have hyon : ∀ (S : Scheme.{u}) (V : S.ProEt) (g : V ⟶ V)
      (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      (∀ t : G.obj.obj (Opposite.op V), G.obj.map g.op t = t) →
      ∀ φ : wcFreeSheaf S V ⟶ G, wcFreeSheafMap S g ≫ φ = φ := by
    intro S V g G hG φ
    let Q : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let α : Q ⟶ Q :=
      Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let adj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
    let adjW := Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}
    let β : uliftYoneda.{u+1}.obj V ⟶ uliftYoneda.{u+1}.obj V := uliftYoneda.{u+1}.map g
    have hψ : ∀ ψ : Q ⟶ G.obj, α ≫ ψ = ψ := by
      intro ψ
      have key : β ≫ adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ =
          adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ := by
        apply (uliftYonedaEquiv.{u+1} (X := V) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})).injective
        have h3 := uliftYonedaEquiv_naturality.{u+1}
          (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ) g.op
        exact h3.symm.trans (hG (uliftYonedaEquiv.{u+1} (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ)))
      have h4 : ((Functor.whiskeringRight S.ProEtᵒᵖ (Type (u+1)) AddCommGrpCat.{u+1}).obj
          AddCommGrpCat.free).map β ≫ ψ = ψ := by
        apply (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj).injective
        exact (adjW.homEquiv_naturality_left β ψ).trans key
      exact h4
    have e1 := adj.homEquiv_naturality_left α φ
    apply (adj.homEquiv Q G).injective
    exact e1.trans (hψ (adj.homEquiv Q G φ))

  have hx := Abelian.Ext.mk₀_homEquiv₀_apply x
  generalize Abelian.Ext.homEquiv₀ x = φ at hx
  subst hx
  show (Abelian.Ext.mk₀ (wcFreeSheafMap Y.left (wcGeomFrob F' Y h))).comp
      (Abelian.Ext.mk₀ φ) (zero_add 0) = Abelian.Ext.mk₀ φ
  rw [Abelian.Ext.mk₀_comp_mk₀, hyon Y.left (wcGeomPoint F' Y h) (wcGeomFrob F' Y h)
    (wcLadicSheaf Y.left ℓ) hsec φ]

theorem wc_coh_base_change_frob (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (F' : Type u) [Field F'] [Finite F'] [Algebra F F'] [FiniteDimensional F F']
    (hX' : WeaklyEtale (Limits.pullback.fst
          (Over.mk (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ) :
    ∃ Θ : wcCoh F X h ℓ i ≃+ wcCoh F' (Over.mk (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F F'))))) hX' ℓ i,
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i),
        Θ (wcCohScalar F X h ℓ i c x) = wcCohScalar F' (Over.mk (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F F'))))) hX' ℓ i c (Θ x)) ∧
      ∀ x : wcCoh F X h ℓ i,
        Θ ((⇑(wcCohFrob F X h ℓ i))^[Module.finrank F F'] x) = wcCohFrob F' (Over.mk
          (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))))) hX' ℓ i (Θ x) :=
by
  classical



  have t_coreprIso : ∀ {C : Type (u+2)} [Category.{u+1} C] {Fu : C ⥤ Type (u+1)} {A B : C}
      (a : Fu.CorepresentableBy A) (b : Fu.CorepresentableBy B),
      ∃ i : A ≅ B, ∀ {Z : C} (φ : B ⟶ Z), a.homEquiv (i.hom ≫ φ) = b.homEquiv φ := by
    intro C _ Fu A B a b
    have P0 : ∀ {Z : C} (φ : B ⟶ Z), a.homEquiv (a.homEquiv.symm (b.homEquiv (𝟙 B)) ≫ φ) =
        b.homEquiv φ := by
      intro Z φ
      rw [a.homEquiv_comp, Equiv.apply_symm_apply, ← b.homEquiv_comp, Category.id_comp]
    have P1 : ∀ {Z : C} (φ : A ⟶ Z), b.homEquiv (b.homEquiv.symm (a.homEquiv (𝟙 A)) ≫ φ) =
        a.homEquiv φ := by
      intro Z φ
      rw [b.homEquiv_comp, Equiv.apply_symm_apply, ← a.homEquiv_comp, Category.id_comp]
    refine ⟨⟨a.homEquiv.symm (b.homEquiv (𝟙 B)), b.homEquiv.symm (a.homEquiv (𝟙 A)), ?_, ?_⟩, ?_⟩
    · apply a.homEquiv.injective
      rw [P0, Equiv.apply_symm_apply]
    · apply b.homEquiv.injective
      rw [P1, Equiv.apply_symm_apply]
    · intro Z φ
      exact P0 φ



  have t_pre : ∀ {E : Type (u+1)} [Category.{u} E] {Y Y' : E} (g : Y ⟶ Y')
      (Q : Eᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (φ : yoneda.obj Y' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ Q),
      ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) Q |>.trans uliftYonedaEquiv)
        (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ φ) =
      ConcreteCategory.hom (Q.map g.op)
        (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u}) Q |>.trans uliftYonedaEquiv) φ) := by
    intro E _ Y Y' g Q φ
    have h2 := (Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv_naturality_left
      (Functor.whiskerRight (yoneda.map g) uliftFunctor.{u+1, u}) φ
    exact (congrArg uliftYonedaEquiv h2).trans (uliftYonedaEquiv_naturality _ g.op).symm



  have t_rep : ∀ {E : Type (u+1)} [Category.{u} E] (J' : GrothendieckTopology E)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}],
      ∃ r : ∀ Y : E, (sheafToPresheaf J' AddCommGrpCat.{u+1} ⋙ (evaluation Eᵒᵖ AddCommGrpCat.{u+1}).obj
            (Opposite.op Y) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
            ((presheafToSheaf J' AddCommGrpCat.{u+1}).obj
              (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)),
        ∀ {Y Y' : E} (g : Y ⟶ Y') (H : Sheaf J' AddCommGrpCat.{u+1})
          (ψ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
              (yoneda.obj Y' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ H),
          (r Y).homEquiv ((presheafToSheaf J' AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ ψ) =
          ConcreteCategory.hom (((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj H).map g.op)
            ((r Y').homEquiv ψ) := by
    intro E _ J' _
    refine ⟨fun Y =>
      { homEquiv := fun {G} =>
          ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ G).trans
            (((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
              (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
        homEquiv_comp := fun {G G'} f g => by
          simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
          rfl }, ?_⟩
    intro Y Y' g H ψ
    have h1 := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_naturality_left
      (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ψ
    have h3 := t_pre g ((sheafToPresheaf J' AddCommGrpCat.{u+1}).obj H)
      ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ H ψ)
    exact (congrArg (fun k => ((Adjunction.whiskerRight Eᵒᵖ AddCommGrpCat.adj).homEquiv
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u}) _ |>.trans uliftYonedaEquiv) k) h1).trans h3



  have t_s4 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (Φ : C ⥤ D) [Φ.IsContinuous J K]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
      (adj : L ⊣ Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K),
      ∃ θ : ∀ X : C, L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≅
          (presheafToSheaf K AddCommGrpCat.{u+1}).obj
            (yoneda.obj (Φ.obj X) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
        ∀ {X X' : C} (g : X ⟶ X'),
          L.map ((presheafToSheaf J AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
            (θ X').hom =
          (θ X).hom ≫ (presheafToSheaf K AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map (Φ.map g))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    intro C D _ _ J K _ _ Φ _ L adj
    obtain ⟨r1, hr1⟩ := t_rep J
    obtain ⟨r2, hr2⟩ := t_rep K
    let r3 : ∀ X : C, (sheafToPresheaf K AddCommGrpCat.{u+1} ⋙ (evaluation Dᵒᵖ AddCommGrpCat.{u+1}).obj
          (Opposite.op (Φ.obj X)) ⋙ forget AddCommGrpCat.{u+1}).CorepresentableBy
          (L.obj ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
            (yoneda.obj X ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := fun X =>
      { homEquiv := fun {G} => (adj.homEquiv _ G).trans (r1 X).homEquiv
        homEquiv_comp := fun {G G'} f g => by
          show (r1 X).homEquiv (adj.homEquiv _ G' (g ≫ f)) = _
          rw [Adjunction.homEquiv_naturality_right, (r1 X).homEquiv_comp]
          rfl }
    have hθ := fun X : C => t_coreprIso (r3 X) (r2 (Φ.obj X))
    choose θ hP0 using hθ
    refine ⟨θ, ?_⟩
    intro X X' g
    apply (r3 X).homEquiv.injective
    have eL : (r3 X).homEquiv (L.map ((presheafToSheaf J AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
            (θ X').hom) =
        ConcreteCategory.hom (((sheafToPresheaf K AddCommGrpCat.{u+1}).obj
          ((presheafToSheaf K AddCommGrpCat.{u+1}).obj
            (yoneda.obj (Φ.obj X') ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).map (Φ.map g).op)
          ((r3 X').homEquiv (θ X').hom) := by
      show (r1 X).homEquiv (adj.homEquiv _ _ (L.map _ ≫ (θ X').hom)) = _
      rw [Adjunction.homEquiv_naturality_left]
      exact hr1 g _ _
    have eR : (r3 X).homEquiv ((θ X).hom ≫ (presheafToSheaf K AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map (Φ.map g))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) =
        ConcreteCategory.hom (((sheafToPresheaf K AddCommGrpCat.{u+1}).obj
          ((presheafToSheaf K AddCommGrpCat.{u+1}).obj
            (yoneda.obj (Φ.obj X') ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).map (Φ.map g).op)
          ((r2 (Φ.obj X')).homEquiv (𝟙 _)) := by
      rw [hP0 X, ← Category.comp_id ((presheafToSheaf K AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map (Φ.map g))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))]
      exact hr2 (Φ.map g) _ _
    rw [eL, eR, ← hP0 X' (𝟙 _), Category.comp_id]



  have s2 : ∀ (S : Scheme.{u}) (U : S.ProEt),
      (wcSliceFunctor S U).IsContinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S) ∧
      (wcSliceFunctor S U).IsCocontinuous (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S) ∧
      Limits.PreservesFiniteLimits ((wcSliceFunctor S U).op.lan :
        ((U.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
    intro S U
    have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
        R ∈ Scheme.ProEt.topology S X ↔
          Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
            Scheme.proetaleTopology X.left := by
      intro S X R
      letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
      have h : Scheme.ProEt.topology S =
          (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
        MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
          (P := @WeaklyEtale) Scheme.proetalePrecoverage
          Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
      rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
        Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
      rfl
    have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
        (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
        Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
            (Sieve.functorPullback (wcSliceFunctor S U) T) =
          Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
      intro S U V T
      ext Z g
      constructor
      · rintro ⟨W, t', h, ht', rfl⟩
        exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
      · rintro ⟨W', t, h, ht, rfl⟩
        have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
          (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
        haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
        haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
        let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
        let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
        let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
          MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
        have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
          apply MorphismProperty.Over.Hom.ext
          exact (Category.id_comp _).symm
        refine ⟨W'', t'', h, ?_, rfl⟩
        show T.arrows ((wcSliceFunctor S U).map t'')
        rw [he]
        exact T.downward_closed ht e
    have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
        CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
      intro S U
      apply CompatiblePreserving.mk
      intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
      haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
      haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
      let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
        have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
        have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
        calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
              (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
          _ = f₁.left ≫ Y₁.hom :=
              (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
      let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
      let e : X ⟶ (wcSliceFunctor S U).obj X' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
      have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
