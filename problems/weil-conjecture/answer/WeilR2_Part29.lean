theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_tr_step : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) [(wcGbP W ϖ d).IsPrime], (∀ f : wcGbT W ϖ d, f ≠ 0 → ∃ (c : ↥W) (N : ℕ) (f₀ : wcGbT W ϖ d), c ≠ 0 ∧ c ∣ ϖ ^ N ∧ f₀ ∉ wcGbP W ϖ d ∧ f = algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) * f₀) → (∀ x y : wcGbT W ϖ d, ∃ u z : wcGbT W ϖ d, u ∉ wcGbP W ϖ d ∧ (u * x = z * y ∨ u * y = z * x)) → algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d) ≠ 0 → ∀ (K : Type u) [Field K] [Algebra (wcGbVhat W ϖ d) K] [IsFractionRing (wcGbVhat W ϖ d) K], ∀ (N : Type u) [Field N] [Algebra (K) N] [FiniteDimensional (K) N] [Normal (K) N] [Algebra (wcGbVhat W ϖ d) N] [IsScalarTower (wcGbVhat W ϖ d) (K) N] (L : IntermediateField (K) N), wcTrM (wcGbVhat W ϖ d) (K) N ≤ L → wcTrM (wcGbVhat W ϖ d) (K) N ≠ L → (ringChar (IsLocalRing.ResidueField ↥W)).Prime ∧ ∃ F : IntermediateField (K) N, wcTrM (wcGbVhat W ϖ d) (K) N ≤ F ∧ Module.finrank (K) ↥F < Module.finrank (K) ↥L ∧ (wcRfCart (wcGbVhat W ϖ d) ↥F (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d)) → wcRfCart (wcGbVhat W ϖ d) ↥L (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d)) ∨ ∃ (_ : Algebra ↥F ↥L) (_ : IsScalarTower (wcGbVhat W ϖ d) ↥F ↥L), Module.finrank ↥F ↥L = ringChar (IsLocalRing.ResidueField ↥W) ∧ ∀ y : ↥L, IsIntegral (wcGbVhat W ϖ d) y → ∃ c : ↥F, IsIntegral (wcGbVhat W ϖ d) c ∧ ∃ (r : wcGbVhat W ϖ d) (z : ↥L), ¬ IsUnit r ∧ IsIntegral (wcGbVhat W ϖ d) z ∧ y - algebraMap ↥F ↥L c = algebraMap (wcGbVhat W ϖ d) ↥L r * z) :=
by
  intro Ω _ _ W hW ϖ hϖ0 hϖnu d _ hcont hval ht0 K _ _ _ N _ _ _ _ _ _ L hML hMne
  classical

  obtain ⟨hdomV, htot, htnu, hdiv⟩ :=
