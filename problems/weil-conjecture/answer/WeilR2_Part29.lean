    have hH : Subsingleton (Algebra.H1Cotangent (MvPolynomial (Fin 2) R) L) := by
      have h0 : ∀ x : Algebra.H1Cotangent (MvPolynomial (Fin 2) R) L, x = 0 := by
        intro x
        have hδ : Algebra.H1Cotangent.δ R (MvPolynomial (Fin 2) R) L x = 0 := by
          apply hinj
          rw [map_zero]
