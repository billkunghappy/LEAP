  haveI := h𝔔₀
  letI : Algebra R C₀ := (φ.comp (algebraMap R B)).toAlgebra
  have hRC : algebraMap R C₀ = φ.comp (algebraMap R B) := rfl
  have hyC : (MvPolynomial.eval₂Hom (algebraMap R C₀) ![φ y₁, φ y₂]).Etale := by
