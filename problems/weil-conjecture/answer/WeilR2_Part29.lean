theorem wcpa_dj_lr1s_nf_cnf_fmp_tf_saturation_fg : ∀ (T : Type u) [CommRing T] (t : T), IsNoetherianRing (Localization.Away t) → ∀ (r : ℕ) (N : Submodule T (Fin r → T)), ∃ N' : Submodule T (Fin r → T), N'.FG ∧ N' ≤ N ∧ ∀ x ∈ N, ∃ k : ℕ, t ^ k • x ∈ N' :=
by
  intro T _ t hL r N
  classical
  haveI := hL
  let ι : (Fin r → T) →ₗ[T] (Fin r → Localization.Away t) :=
    LinearMap.pi (fun i => (Algebra.linearMap T (Localization.Away t)).comp (LinearMap.proj i))
  have hι : ∀ z i, ι z i = algebraMap T (Localization.Away t) (z i) := fun z i => rfl
  have hker : ∀ v : Fin r → T, ι v = 0 → ∃ k : ℕ, t ^ k • v = 0 := by
    intro v hv
    have hv' : ∀ i, ∃ k : ℕ, t ^ k * v i = 0 := by
      intro i
      have h0 : algebraMap T (Localization.Away t) (v i) = 0 := by
        rw [← hι, hv]; rfl
