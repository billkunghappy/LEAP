  have T_s2 : ∀ (C : Type u) [CommRing C] (p : C) (S : Type u) [CommRing S] (σ : S), (∀ f : ℕ → S, (∀ n : ℕ, ∃ y : S, f (n + 1) - f n = σ ^ n * y) → ∃ L : S, ∀ n : ℕ, ∃ y : S, L - f n = σ ^ n * y) → (∀ x : S, (∀ k : ℕ, ∃ y : S, x = σ ^ k * y) → x = 0) → ∀ ρ : C →+* S, ρ p = σ → ∃ ψ : AdicCompletion (Ideal.span {p}) C →+* S, ∀ c : C, ψ (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) = ρ c := by
