    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial (↥W) (Fin 1)
    simpa using this

  have NSQ : ∀ (K : Type u) [Field K] (sp : Spec (.of K) ⟶ Spec (.of ↥W))
