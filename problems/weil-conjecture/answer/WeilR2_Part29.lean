import WeilR2_Part28
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_lfg_els_mt_base_change_step : (∀ (A B M M' : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.FaithfullyFlat A B] [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M'] [Module B M'] [IsScalarTower A B M'] (f : M →ₗ[A] M'), IsBaseChange B f → Module.FinitePresentation B M' → Module.FinitePresentation A M) → (∀ (R B P N : Type u) [CommRing R] [CommRing B] [Algebra R B] [AddCommGroup P] [Module B P] [Module R P] [IsScalarTower R B P] [AddCommGroup N] [Module B N] [Module R N] [IsScalarTower R B N], Module.Flat B P → Module.Flat R N → Module.Flat R (TensorProduct B P N)) → ∀ (R T X R' : Type u) [CommRing R] [CommRing T] [Algebra R T] [AddCommGroup X] [Module T X] [Module R X] [IsScalarTower R T X] [Module.Finite T X] (q : Ideal T) [q.IsPrime] [CommRing R'] [Algebra R R'] [Module.Flat R R'] (h : TensorProduct R R' T) (Q' : Ideal (Localization.Away h)) [Q'.IsPrime], (Q'.comap (algebraMap (TensorProduct R R' T) (Localization.Away h))).comap (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := T)).toRingHom = q → Module.Flat R (LocalizedModule q.primeCompl X) → ∃ (N' : Type u) (_ : AddCommGroup N') (_ : Module (Localization.Away h) N') (_ : Module R' N') (_ : IsScalarTower R' (Localization.Away h) N') (_ : Module.Finite (Localization.Away h) N'), Module.Flat R' (LocalizedModule Q'.primeCompl N') ∧ (Module.FinitePresentation (Localization.AtPrime Q') (LocalizedModule Q'.primeCompl N') → Module.FinitePresentation (Localization.AtPrime q) (LocalizedModule q.primeCompl X)) :=
by
  intro HL1 HL3 R T X R' _ _ _ _ _ _ _ _ q _ _ _ hR' h Q' _ hQ hXfl
  have hEnd_t : ∀ (T A Q : Type u) [CommRing T] [CommRing A] [Algebra T A] [AddCommMonoid Q]
      [Module T Q] [Module A Q] [IsScalarTower T A Q] (t : T), IsUnit (algebraMap T A t) →
      IsUnit (algebraMap T (Module.End T Q) t) := by
    intro T A Q _ _ _ _ _ _ _ t ht
    obtain ⟨a, ha⟩ := ht
    rw [Module.End.isUnit_iff]
    constructor
    · intro x y hxy
      simp only [Module.algebraMap_end_apply] at hxy
      rw [← algebraMap_smul A t x, ← algebraMap_smul A t y, ← ha] at hxy
      have := congrArg (fun z => (↑a⁻¹ : A) • z) hxy
      simpa [smul_smul] using this
    · intro y
      refine ⟨(↑a⁻¹ : A) • y, ?_⟩
      simp only [Module.algebraMap_end_apply]
      rw [← algebraMap_smul A t, ← ha, smul_smul]
      simp
  have s1_t : ∀ (T A X Y P : Type u) [CommRing T] [CommRing A] [Algebra T A] [AddCommGroup X]
      [Module T X] [AddCommGroup Y] [Module T Y] [AddCommMonoid P] [Module T P] [Module A P]
      [IsScalarTower T A P] (U : Submonoid T) (ℓ : X →ₗ[T] Y) [IsLocalizedModule U ℓ]
      (ψ : X →ₗ[T] P), (∀ u ∈ U, IsUnit (algebraMap T A u)) → IsBaseChange A ψ →
      ∃ φ : Y →ₗ[T] P, φ ∘ₗ ℓ = ψ ∧ IsBaseChange A φ := by
    intro T A X Y P _ _ _ _ _ _ _ _ _ _ _ U ℓ _ ψ hU hψ
    obtain ⟨φ, hφℓ⟩ : ∃ φ : Y →ₗ[T] P, φ ∘ₗ ℓ = ψ :=
      ⟨_, IsLocalizedModule.lift_comp U ℓ ψ (fun u => hEnd_t T A P u (hU u u.2))⟩
    refine ⟨φ, hφℓ, ?_⟩
    apply IsBaseChange.of_lift_unique
    intro Q _ _ _ _ g
    obtain ⟨g', hg', huniq⟩ := (IsBaseChange.iff_lift_unique.mp hψ) Q (g ∘ₗ ℓ)
    have hg'' : (g'.restrictScalars T) ∘ₗ ψ = g ∘ₗ ℓ := hg'
    refine ⟨g', ?_, ?_⟩
    · show (g'.restrictScalars T) ∘ₗ φ = g
      apply IsLocalizedModule.ext U ℓ (fun u => hEnd_t T A Q u (hU u u.2))
      rw [LinearMap.comp_assoc, hφℓ, hg'']
    · intro k hk
      have hk' : (k.restrictScalars T) ∘ₗ φ = g := hk
      apply huniq
      show (k.restrictScalars T) ∘ₗ ψ = g ∘ₗ ℓ
      rw [← hφℓ, ← LinearMap.comp_assoc, hk']
  have s4_t : ∀ (T D : Type u) [CommRing T] [CommRing D] [Algebra T D] [Module.Flat T D] (h : D)
      (Q' : Ideal (Localization.Away h)) [Q'.IsPrime] (q : Ideal T),
      Q'.comap (algebraMap T (Localization.Away h)) = q →
      Module.Flat D (Localization.AtPrime Q') ∧ Module.Flat T (Localization.AtPrime Q') ∧
      (IsLocalRing.maximalIdeal (Localization.AtPrime Q')).comap
        (algebraMap T (Localization.AtPrime Q')) = q := by
    intro T D _ _ _ _ h Q' _ q hq
    haveI : Module.Flat D (Localization.Away h) := IsLocalization.flat _ (Submonoid.powers h)
    haveI : Module.Flat (Localization.Away h) (Localization.AtPrime Q') :=
      IsLocalization.flat _ Q'.primeCompl
    haveI hDA : Module.Flat D (Localization.AtPrime Q') :=
      Module.Flat.trans D (Localization.Away h) _
    refine ⟨hDA, Module.Flat.trans T D _, ?_⟩
    rw [IsScalarTower.algebraMap_eq T (Localization.Away h) (Localization.AtPrime Q'),
      ← Ideal.comap_comap]
    have hc : (IsLocalRing.maximalIdeal (Localization.AtPrime Q')).comap
        (algebraMap (Localization.Away h) (Localization.AtPrime Q')) = Q' :=
      Localization.AtPrime.comap_maximalIdeal
    rw [hc, hq]
  have s3_t : ∀ (R R' T D A Z : Type u) [CommRing R] [CommRing R'] [CommRing T] [CommRing D]
      [CommRing A] [Algebra R R'] [Algebra R T] [Algebra R D] [Algebra R' D] [Algebra T D]
      [IsScalarTower R R' D] [IsScalarTower R T D] [Algebra.IsPushout R R' T D]
      (hRR' : Module.Flat R R') [Algebra D A] [Module.Flat D A] [Algebra T A] [IsScalarTower T D A]
      [Algebra R' A] [IsScalarTower R' D A] [AddCommGroup Z] [Module T Z] [Module R Z]
      [IsScalarTower R T Z], Module.Flat R Z → ∀ (O : Type u) [AddCommMonoid O] [Module T O]
      [Module A O] [IsScalarTower T A O] [Module R' O] [IsScalarTower R' A O]
      (φ : Z →ₗ[T] O), IsBaseChange A φ → Module.Flat R' O := by
    intro R R' T D A Z _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hZ O _ _ _ _ _ _ φ hφ
    haveI : Module.Flat R' (TensorProduct R R' Z) := Module.Flat.baseChange R R' Z
    haveI hDZ : Module.Flat R' (TensorProduct T D Z) :=
      Module.Flat.of_linearEquiv (Algebra.IsPushout.cancelBaseChange R R' T D Z)
    haveI h1 : Module.Flat R' (TensorProduct D A (TensorProduct T D Z)) :=
      HL3 R' D A (TensorProduct T D Z) inferInstance hDZ
    haveI : Module.Flat R' (TensorProduct T A Z) := Module.Flat.of_linearEquiv
      ((TensorProduct.AlgebraTensorModule.cancelBaseChange T D A A Z).restrictScalars R').symm
    exact Module.Flat.of_linearEquiv (hφ.equiv.restrictScalars R').symm
  have s2_t : ∀ (T A M P : Type u) [CommRing T] [CommRing A] [IsLocalRing A] [Algebra T A]
      [Module.Flat T A] [AddCommGroup M] [Module T M] [AddCommMonoid P] [Module T P] [Module A P]
      [IsScalarTower T A P] (q : Ideal T) [q.IsPrime] (φ : M →ₗ[T] P),
      (IsLocalRing.maximalIdeal A).comap (algebraMap T A) = q → IsBaseChange A φ →
      Module.FinitePresentation A P →
      Module.FinitePresentation (Localization.AtPrime q) (LocalizedModule q.primeCompl M) := by
    intro T A M P _ _ _ _ _ _ _ _ _ _ _ q _ φ hmax hφ hfp
    have hu : ∀ t : T, t ∉ q → IsUnit (algebraMap T A t) := by
      intro t ht
      by_contra hne
      apply ht
      rw [← hmax]
      exact Ideal.mem_comap.mpr ((IsLocalRing.mem_maximalIdeal _).mpr hne)
    let ι : Localization.AtPrime q →+* A :=
      IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q)
        (g := algebraMap T A) (fun y => hu y y.2)
    letI : Algebra (Localization.AtPrime q) A := ι.toAlgebra
    haveI : IsScalarTower T (Localization.AtPrime q) A :=
      IsScalarTower.of_algebraMap_eq' (IsLocalization.lift_comp _).symm
    haveI : IsLocalHom (algebraMap (Localization.AtPrime q) A) := by
      constructor
      intro x hx
      obtain ⟨⟨t, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
      rw [IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime q) q]
      intro htq
      have heq : algebraMap (Localization.AtPrime q) A (IsLocalization.mk' _ t s) *
          algebraMap T A s = algebraMap T A t := by
        rw [IsScalarTower.algebraMap_apply T (Localization.AtPrime q) A (s : T),
          IsScalarTower.algebraMap_apply T (Localization.AtPrime q) A t, ← map_mul,
          IsLocalization.mk'_spec]
      have hut : IsUnit (algebraMap T A t) := heq ▸ hx.mul (hu s s.2)
      have hmem : t ∈ (IsLocalRing.maximalIdeal A).comap (algebraMap T A) := by
        rw [hmax]; exact htq
      exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mem_comap.mp hmem) hut
    haveI : Module.Flat (Localization.AtPrime q) A :=
      (Module.flat_iff_of_isLocalization (Localization.AtPrime q) q.primeCompl A).mpr inferInstance
    haveI : Module.FaithfullyFlat (Localization.AtPrime q) A :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    letI : Module (Localization.AtPrime q) P :=
      Module.compHom P (algebraMap (Localization.AtPrime q) A)
    haveI : IsScalarTower (Localization.AtPrime q) A P := ⟨fun x a p => by
      show (x • a) • p = algebraMap (Localization.AtPrime q) A x • (a • p)
      rw [Algebra.smul_def, mul_smul]⟩
    haveI : IsScalarTower T (Localization.AtPrime q) P := ⟨fun t x p => by
      show algebraMap (Localization.AtPrime q) A (t • x) • p =
        t • (algebraMap (Localization.AtPrime q) A x • p)
      rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply, mul_smul,
        algebraMap_smul]⟩
    let φ₀ : LocalizedModule q.primeCompl M →ₗ[T] P :=
      IsLocalizedModule.lift q.primeCompl (LocalizedModule.mkLinearMap q.primeCompl M) φ
        (fun x => hEnd_t T A P x (hu x x.2))
    let f : LocalizedModule q.primeCompl M →ₗ[Localization.AtPrime q] P :=
      LinearMap.extendScalarsOfIsLocalization q.primeCompl (Localization.AtPrime q) φ₀
    have hf : (f.restrictScalars T) ∘ₗ LocalizedModule.mkLinearMap q.primeCompl M = φ := by
      have := IsLocalizedModule.lift_comp q.primeCompl (LocalizedModule.mkLinearMap q.primeCompl M)
        φ (fun x => hEnd_t T A P x (hu x x.2))
      exact LinearMap.ext fun m => LinearMap.congr_fun this m
    have hbc : IsBaseChange A f := by
      refine IsBaseChange.of_comp (R := T) (S := Localization.AtPrime q) (T := A)
        ((isLocalizedModule_iff_isBaseChange q.primeCompl (Localization.AtPrime q)
          (LocalizedModule.mkLinearMap q.primeCompl M)).mp inferInstance) ?_
      rw [hf]; exact hφ
    letI : AddCommGroup P := Module.addCommMonoidToAddCommGroup A
    exact HL1 (Localization.AtPrime q) A (LocalizedModule q.primeCompl M) P f hbc hfp
  letI : Algebra T (TensorProduct R R' T) := Algebra.TensorProduct.rightAlgebra
  haveI hTD : Module.Flat T (TensorProduct R R' T) :=
    @Module.Flat.isBaseChange R T R' _ _ _ _ _ hR' (TensorProduct R R' T) _ _ _ _ _
      (Algebra.IsPushout.out (R := R) (S := T) (R' := R') (S' := TensorProduct R R' T))
  have hq' : Q'.comap (algebraMap T (Localization.Away h)) = q := by
    rw [IsScalarTower.algebraMap_eq T (TensorProduct R R' T) (Localization.Away h),
      ← Ideal.comap_comap]
    exact hQ
  obtain ⟨hDA, hTA, hmax⟩ := s4_t T (TensorProduct R R' T) h Q' q hq'
  haveI := hDA
  haveI := hTA
  have hu : ∀ u ∈ q.primeCompl, IsUnit (algebraMap T (Localization.AtPrime Q') u) := by
    intro u hu
    by_contra hne
    apply hu
    have hmem : u ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime Q')).comap
        (algebraMap T (Localization.AtPrime Q')) :=
      Ideal.mem_comap.mpr ((IsLocalRing.mem_maximalIdeal _).mpr hne)
    rw [hmax] at hmem
    exact hmem
  let ψ : X →ₗ[T] LocalizedModule Q'.primeCompl (TensorProduct T (Localization.Away h) X) :=
    (LocalizedModule.mkLinearMap Q'.primeCompl
      (TensorProduct T (Localization.Away h) X)).restrictScalars T ∘ₗ
      TensorProduct.mk T (Localization.Away h) X 1
  have hψ : IsBaseChange (Localization.AtPrime Q') ψ :=
    IsBaseChange.comp (TensorProduct.isBaseChange T X (Localization.Away h))
      ((isLocalizedModule_iff_isBaseChange Q'.primeCompl (Localization.AtPrime Q')
        (LocalizedModule.mkLinearMap Q'.primeCompl
          (TensorProduct T (Localization.Away h) X))).mp inferInstance)
  obtain ⟨φ, -, hφ⟩ := s1_t T (Localization.AtPrime Q') X (LocalizedModule q.primeCompl X)
    (LocalizedModule Q'.primeCompl (TensorProduct T (Localization.Away h) X)) q.primeCompl
    (LocalizedModule.mkLinearMap q.primeCompl X) ψ hu hψ
  have hfl := s3_t R R' T (TensorProduct R R' T) (Localization.AtPrime Q')
    (LocalizedModule q.primeCompl X) hR' hXfl _ φ hφ
  have hfp := fun H => s2_t T (Localization.AtPrime Q') X _ q ψ hmax hψ H
  exact ⟨TensorProduct T (Localization.Away h) X, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, hfl, hfp⟩

theorem wcpa_lfg_els_mt_reduce_to_T : (∀ (A B M M' : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.FaithfullyFlat A B] [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M'] [Module B M'] [IsScalarTower A B M'] (f : M →ₗ[A] M'), IsBaseChange B f → Module.FinitePresentation B M' → Module.FinitePresentation A M) → (∀ (T C M : Type u) [CommRing T] [CommRing C] [Algebra T C] [Module.Finite T C] [AddCommGroup M] [Module C M] [Module T M] [IsScalarTower T C M], Module.FinitePresentation T M → Module.FinitePresentation C M) → (∀ (R B P N : Type u) [CommRing R] [CommRing B] [Algebra R B] [AddCommGroup P] [Module B P] [Module R P] [IsScalarTower R B P] [AddCommGroup N] [Module B N] [Module R N] [IsScalarTower R B N], Module.Flat B P → Module.Flat R N → Module.Flat R (TensorProduct B P N)) → (∀ (T C : Type u) [CommRing T] [CommRing C] [Algebra T C] [Module.Finite T C] (QC : Ideal C) [QC.IsPrime], (∀ P'' : Ideal C, P''.IsPrime → P''.comap (algebraMap T C) = QC.comap (algebraMap T C) → P'' = QC) → ∀ c : C, c ∉ QC → ∃ (d : C) (t : T), t ∉ QC.comap (algebraMap T C) ∧ c * d = algebraMap T C t) → ∀ (R A N T C : Type u) [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N] [Module.Finite A N] (Q : Ideal A) [Q.IsPrime] (I : Ideal A) [CommRing T] [Algebra R T] [CommRing C] [Algebra T C] [Module.Finite T C] [Algebra (A ⧸ I) C] [Module.Flat (A ⧸ I) C] [Algebra R C] [IsScalarTower R T C] [IsScalarTower R (A ⧸ I) C] (QC : Ideal C) [QC.IsPrime], I.FG → I ≤ Module.annihilator A N → Module.annihilator A N ≤ Q → QC.comap (algebraMap (A ⧸ I) C) = Q.map (Ideal.Quotient.mk I) → (∀ P'' : Ideal C, P''.IsPrime → P''.comap (algebraMap T C) = QC.comap (algebraMap T C) → P'' = QC) → Module.Flat R (LocalizedModule Q.primeCompl N) → ∃ (X : Type u) (_ : AddCommGroup X) (_ : Module T X) (_ : Module R X) (_ : IsScalarTower R T X) (_ : Module.Finite T X), Module.Flat R (LocalizedModule (QC.comap (algebraMap T C)).primeCompl X) ∧ (Module.FinitePresentation (Localization.AtPrime (QC.comap (algebraMap T C))) (LocalizedModule (QC.comap (algebraMap T C)).primeCompl X) → Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N)) :=
by
  intro HL1 HL2 HL3 HL4

  have s1 : ∀ (T C M M' : Type u) [CommRing T] [CommRing C] [Algebra T C] [AddCommGroup M] [Module C M] [Module T M] [IsScalarTower T C M] [AddCommGroup M'] [Module C M'] [Module T M'] [IsScalarTower T C M'] (QC : Ideal C) [QC.IsPrime] (g : M →ₗ[C] M') [IsLocalizedModule QC.primeCompl g], (∀ c : C, c ∉ QC → ∃ (d : C) (t : T), t ∉ QC.comap (algebraMap T C) ∧ c * d = algebraMap T C t) → IsLocalizedModule (QC.comap (algebraMap T C)).primeCompl (g.restrictScalars T) := by
    intro T C M M' _ _ _ _ _ _ _ _ _ _ _ QC _ g _ hdiv
    constructor
    · rintro ⟨t, ht⟩
      have hu := IsLocalizedModule.map_units g (S := QC.primeCompl) ⟨algebraMap T C t, ht⟩
      rw [Module.End.isUnit_iff] at hu ⊢
      convert hu using 1
      funext x
      simp [algebraMap_smul]
    · intro y
      obtain ⟨⟨m, ⟨c, hc⟩⟩, hy⟩ := IsLocalizedModule.surj QC.primeCompl g y
      obtain ⟨d, t, ht, hcd⟩ := hdiv c hc
      refine ⟨⟨d • m, ⟨t, ht⟩⟩, ?_⟩
      simp only [LinearMap.restrictScalars_apply, map_smul, Submonoid.smul_def] at hy ⊢
      rw [← hy, ← algebraMap_smul C t y, ← hcd, mul_comm, mul_smul]
    · intro x₁ x₂ h
      obtain ⟨⟨c, hc⟩, hx⟩ := IsLocalizedModule.exists_of_eq (S := QC.primeCompl) (f := g) h
      obtain ⟨d, t, ht, hcd⟩ := hdiv c hc
      refine ⟨⟨t, ht⟩, ?_⟩
      simp only [Submonoid.smul_def] at hx ⊢
      rw [← algebraMap_smul C t x₁, ← algebraMap_smul C t x₂, ← hcd, mul_comm, mul_smul, mul_smul,
        hx]

  have s2 : ∀ (R A N : Type u) [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N] (I : Ideal A) [Module (A ⧸ I) N] [IsScalarTower A (A ⧸ I) N] [IsScalarTower R (A ⧸ I) N] (Q : Ideal A) [Q.IsPrime] (QB : Ideal (A ⧸ I)) [QB.IsPrime], I.FG → QB.comap (Ideal.Quotient.mk I) = Q → (Module.Flat R (LocalizedModule Q.primeCompl N) → Module.Flat R (LocalizedModule QB.primeCompl N)) ∧ (Module.FinitePresentation (Localization.AtPrime QB) (LocalizedModule QB.primeCompl N) → Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N)) := by
    intro R A N _ _ _ _ _ _ _ I _ _ _ Q _ QB _ hI hc
    have hc' : QB.comap (algebraMap A (A ⧸ I)) = Q := hc
    have hsub : (QB.comap (algebraMap A (A ⧸ I))).primeCompl = Q.primeCompl := by
      subst hc'; rfl
    have hdiv : ∀ c : A ⧸ I, c ∉ QB → ∃ (d : A ⧸ I) (t : A),
        t ∉ QB.comap (algebraMap A (A ⧸ I)) ∧ c * d = algebraMap A (A ⧸ I) t := by
      intro c hcQ
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective c
      exact ⟨1, s, hcQ, by rw [mul_one]; rfl⟩
    let gN := LocalizedModule.mkLinearMap QB.primeCompl N
    have hlocN : IsLocalizedModule (QB.comap (algebraMap A (A ⧸ I))).primeCompl
        (gN.restrictScalars A) :=
      s1 A (A ⧸ I) N (LocalizedModule QB.primeCompl N) QB gN hdiv
    rw [hsub] at hlocN
    let e : LocalizedModule Q.primeCompl N ≃ₗ[A] LocalizedModule QB.primeCompl N :=
      IsLocalizedModule.iso Q.primeCompl (gN.restrictScalars A)
    constructor
    · intro hfl
      haveI : IsScalarTower R A (LocalizedModule QB.primeCompl N) := by
        refine IsScalarTower.of_algebraMap_smul (fun r x => ?_)
        rw [← algebraMap_smul (A ⧸ I) (algebraMap R A r) x, ← IsScalarTower.algebraMap_apply,
          algebraMap_smul]
      exact Module.Flat.of_linearEquiv (e.restrictScalars R).symm
    · intro hfp
      let φ : Localization.AtPrime Q →+* Localization.AtPrime QB :=
        Localization.localRingHom Q QB (Ideal.Quotient.mk I) hc.symm
      letI : Algebra (Localization.AtPrime Q) (Localization.AtPrime QB) := φ.toAlgebra
      have hφ : ∀ a : A, algebraMap (Localization.AtPrime Q) (Localization.AtPrime QB)
          (algebraMap A (Localization.AtPrime Q) a) =
          algebraMap (A ⧸ I) (Localization.AtPrime QB) (Ideal.Quotient.mk I a) := fun a => by
        rw [RingHom.algebraMap_toAlgebra]
        exact Localization.localRingHom_to_map Q QB (Ideal.Quotient.mk I) hc.symm a
      haveI : IsScalarTower A (Localization.AtPrime Q) (Localization.AtPrime QB) :=
        IsScalarTower.of_algebraMap_eq (fun a => by
          rw [hφ, IsScalarTower.algebraMap_apply A (A ⧸ I) (Localization.AtPrime QB)]
          rfl)
      haveI hAA : Module.FinitePresentation A A := Module.finitePresentation_of_projective A A
      haveI : Module.FinitePresentation A (A ⧸ I) := by
        refine @Module.finitePresentation_of_surjective A A (A ⧸ I) _ _ _ _ _ hAA
          (Algebra.linearMap A (A ⧸ I)) Ideal.Quotient.mk_surjective ?_
        have : LinearMap.ker (Algebra.linearMap A (A ⧸ I)) = I := by
          ext x
          simp only [LinearMap.mem_ker, Algebra.linearMap_apply]
          exact Ideal.Quotient.eq_zero_iff_mem
        rw [this]; exact hI
      let gB := Algebra.linearMap (A ⧸ I) (Localization.AtPrime QB)
      have hlocB : IsLocalizedModule (QB.comap (algebraMap A (A ⧸ I))).primeCompl
          (gB.restrictScalars A) :=
        s1 A (A ⧸ I) (A ⧸ I) (Localization.AtPrime QB) QB gB hdiv
      rw [hsub] at hlocB
      let eB : LocalizedModule Q.primeCompl (A ⧸ I) ≃ₗ[A] Localization.AtPrime QB :=
        IsLocalizedModule.iso Q.primeCompl (gB.restrictScalars A)
      let eB' := LinearEquiv.extendScalarsOfIsLocalization Q.primeCompl (Localization.AtPrime Q) eB
      haveI hFPloc : Module.FinitePresentation (Localization.AtPrime Q)
          (LocalizedModule Q.primeCompl (A ⧸ I)) :=
        instFinitePresentationLocalizationLocalizedModule (R := A) (M := A ⧸ I) Q.primeCompl
      haveI : Module.FinitePresentation (Localization.AtPrime Q) (Localization.AtPrime QB) :=
        Module.FinitePresentation.of_equiv eB'
      letI : Module (Localization.AtPrime Q) (LocalizedModule QB.primeCompl N) :=
        Module.compHom _ (algebraMap (Localization.AtPrime Q) (Localization.AtPrime QB))
      haveI : IsScalarTower (Localization.AtPrime Q) (Localization.AtPrime QB)
          (LocalizedModule QB.primeCompl N) :=
        IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
      haveI : IsScalarTower A (Localization.AtPrime Q) (LocalizedModule QB.primeCompl N) := by
        refine IsScalarTower.of_algebraMap_smul (fun a x => ?_)
        show (algebraMap (Localization.AtPrime Q) (Localization.AtPrime QB)
          (algebraMap A (Localization.AtPrime Q) a)) • x = a • x
        rw [hφ, algebraMap_smul, ← algebraMap_smul (A ⧸ I) a x]
        rfl
      haveI : Module.FinitePresentation (Localization.AtPrime Q)
          (LocalizedModule QB.primeCompl N) :=
        Module.FinitePresentation.trans (Localization.AtPrime Q) (LocalizedModule QB.primeCompl N)
          (Localization.AtPrime QB)
      let e' := LinearEquiv.extendScalarsOfIsLocalization Q.primeCompl (Localization.AtPrime Q) e
      exact Module.FinitePresentation.of_equiv e'.symm

  have s3 : ∀ (R B C N : Type u) [CommRing R] [CommRing B] [CommRing C] [Algebra R B] [Algebra B C] [Algebra R C] [IsScalarTower R B C] [Module.Flat B C] [AddCommGroup N] [Module B N] [Module R N] [IsScalarTower R B N] (PB : Ideal B) [PB.IsPrime] (QC : Ideal C) [QC.IsPrime], QC.comap (algebraMap B C) = PB → (Module.Flat R (LocalizedModule PB.primeCompl N) → Module.Flat R (LocalizedModule QC.primeCompl (TensorProduct B C N))) ∧ (Module.FinitePresentation (Localization.AtPrime QC) (LocalizedModule QC.primeCompl (TensorProduct B C N)) → Module.FinitePresentation (Localization.AtPrime PB) (LocalizedModule PB.primeCompl N)) := by
    intro R B C N _ _ _ _ _ _ _ _ _ _ _ _ PB _ QC _ hP
    let NP := LocalizedModule PB.primeCompl N
    let XQ := LocalizedModule QC.primeCompl (TensorProduct B C N)
    let φ : Localization.AtPrime PB →+* Localization.AtPrime QC :=
      Localization.localRingHom PB QC (algebraMap B C) hP.symm
    letI : Algebra (Localization.AtPrime PB) (Localization.AtPrime QC) := φ.toAlgebra
    have hφ : ∀ b : B, algebraMap (Localization.AtPrime PB) (Localization.AtPrime QC)
        (algebraMap B (Localization.AtPrime PB) b) =
        algebraMap C (Localization.AtPrime QC) (algebraMap B C b) := fun b => by
      rw [RingHom.algebraMap_toAlgebra]
      exact Localization.localRingHom_to_map PB QC (algebraMap B C) hP.symm b
    haveI : IsScalarTower B (Localization.AtPrime PB) (Localization.AtPrime QC) :=
      IsScalarTower.of_algebraMap_eq (fun b => by
        rw [hφ, IsScalarTower.algebraMap_apply B C (Localization.AtPrime QC)])
    haveI : IsScalarTower R (Localization.AtPrime PB) (Localization.AtPrime QC) :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [IsScalarTower.algebraMap_apply R B (Localization.AtPrime PB), hφ,
          IsScalarTower.algebraMap_apply R C (Localization.AtPrime QC),
          IsScalarTower.algebraMap_apply R B C])
    haveI : Module.Flat (Localization.AtPrime PB) (Localization.AtPrime QC) := by
      rw [← RingHom.flat_algebraMap_iff, RingHom.algebraMap_toAlgebra]
      exact RingHom.Flat.localRingHom ((RingHom.flat_algebraMap_iff).mpr inferInstance) _ _ _
    haveI : IsLocalHom (algebraMap (Localization.AtPrime PB) (Localization.AtPrime QC)) := by
      rw [RingHom.algebraMap_toAlgebra]
      exact Localization.isLocalHom_localRingHom _ _ _ _
    haveI : Module.FaithfullyFlat (Localization.AtPrime PB) (Localization.AtPrime QC) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    letI : Module (Localization.AtPrime PB) XQ :=
      Module.compHom _ (algebraMap (Localization.AtPrime PB) (Localization.AtPrime QC))
    haveI : IsScalarTower (Localization.AtPrime PB) (Localization.AtPrime QC) XQ :=
      IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
    haveI : IsScalarTower B (Localization.AtPrime PB) XQ := by
      refine IsScalarTower.of_algebraMap_smul (fun b x => ?_)
      show (algebraMap (Localization.AtPrime PB) (Localization.AtPrime QC)
        (algebraMap B (Localization.AtPrime PB) b)) • x = b • x
      rw [hφ, algebraMap_smul, algebraMap_smul]
    let f₁ : N →ₗ[B] TensorProduct B C N := TensorProduct.mk B C N 1
    have hf₁ : IsBaseChange C f₁ := TensorProduct.isBaseChange B N C
    let f₂ := LocalizedModule.mkLinearMap QC.primeCompl (TensorProduct B C N)
    have hf₂ : IsBaseChange (Localization.AtPrime QC) f₂ :=
      IsLocalizedModule.isBaseChange QC.primeCompl (Localization.AtPrime QC) f₂
    have h12 : IsBaseChange (Localization.AtPrime QC) ((f₂.restrictScalars B) ∘ₗ f₁) :=
      hf₁.comp hf₂
    let f₃ := LocalizedModule.mkLinearMap PB.primeCompl N
    have hf₃ : IsBaseChange (Localization.AtPrime PB) f₃ :=
      IsLocalizedModule.isBaseChange PB.primeCompl (Localization.AtPrime PB) f₃
    have hunits : ∀ x : PB.primeCompl, IsUnit (algebraMap B (Module.End B XQ) x) := by
      rintro ⟨b, hb⟩
      have hb' : algebraMap B C b ∈ QC.primeCompl := by
        intro h; apply hb; rw [← hP]; exact h
      have hu := IsLocalizedModule.map_units f₂ ⟨algebraMap B C b, hb'⟩
      rw [Module.End.isUnit_iff] at hu ⊢
      convert hu using 1
      funext x
      simp [algebraMap_smul]
    let g₀ : NP →ₗ[B] XQ :=
      IsLocalizedModule.lift PB.primeCompl f₃ ((f₂.restrictScalars B) ∘ₗ f₁) hunits
    let h : NP →ₗ[Localization.AtPrime PB] XQ :=
      LinearMap.extendScalarsOfIsLocalization PB.primeCompl (Localization.AtPrime PB) g₀
    have hcomp : (h.restrictScalars B) ∘ₗ f₃ = (f₂.restrictScalars B) ∘ₗ f₁ :=
      IsLocalizedModule.lift_comp PB.primeCompl f₃ _ hunits
    have hbc : IsBaseChange (Localization.AtPrime QC) h :=
      IsBaseChange.of_comp hf₃ (hcomp ▸ h12)
    constructor
    · intro hfl
      haveI : Module.Flat R
          (TensorProduct (Localization.AtPrime PB) (Localization.AtPrime QC) NP) :=
        HL3 R (Localization.AtPrime PB) (Localization.AtPrime QC) NP inferInstance hfl
      exact Module.Flat.of_linearEquiv (hbc.equiv.restrictScalars R).symm
    · intro hfp
      exact HL1 (Localization.AtPrime PB) (Localization.AtPrime QC) NP XQ h hbc hfp

  have s4 : ∀ (R T C M : Type u) [CommRing R] [CommRing T] [CommRing C] [Algebra R T] [Algebra T C] [Algebra R C] [IsScalarTower R T C] [Module.Finite T C] [AddCommGroup M] [Module C M] [Module T M] [Module R M] [IsScalarTower T C M] [IsScalarTower R T M] [IsScalarTower R C M] (QC : Ideal C) [QC.IsPrime], (∀ c : C, c ∉ QC → ∃ (d : C) (t : T), t ∉ QC.comap (algebraMap T C) ∧ c * d = algebraMap T C t) → (Module.Flat R (LocalizedModule QC.primeCompl M) → Module.Flat R (LocalizedModule (QC.comap (algebraMap T C)).primeCompl M)) ∧ (Module.FinitePresentation (Localization.AtPrime (QC.comap (algebraMap T C))) (LocalizedModule (QC.comap (algebraMap T C)).primeCompl M) → Module.FinitePresentation (Localization.AtPrime QC) (LocalizedModule QC.primeCompl M)) := by
    intro R T C M _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ QC _ hdiv
    set q := QC.comap (algebraMap T C) with hq
    let g := LocalizedModule.mkLinearMap QC.primeCompl M
    haveI hloc : IsLocalizedModule q.primeCompl (g.restrictScalars T) :=
      s1 T C M (LocalizedModule QC.primeCompl M) QC g hdiv
    let e : LocalizedModule q.primeCompl M ≃ₗ[T] LocalizedModule QC.primeCompl M :=
      IsLocalizedModule.iso q.primeCompl (g.restrictScalars T)
    constructor
    · intro hfl
      let eR : LocalizedModule q.primeCompl M ≃ₗ[R] LocalizedModule QC.primeCompl M :=
        e.restrictScalars R
      exact Module.Flat.of_linearEquiv eR
    · intro hfp
      letI : Algebra (Localization.AtPrime q) (Localization.AtPrime QC) :=
        (Localization.localRingHom q QC (algebraMap T C) rfl).toAlgebra
      haveI : IsScalarTower T (Localization.AtPrime q) (Localization.AtPrime QC) :=
        IsScalarTower.of_algebraMap_eq (fun t => by
          rw [RingHom.algebraMap_toAlgebra, Localization.localRingHom_to_map,
            IsScalarTower.algebraMap_apply T C (Localization.AtPrime QC)])
      haveI : IsLocalizedModule q.primeCompl
          ((Algebra.linearMap C (Localization.AtPrime QC)).restrictScalars T) :=
        s1 T C C (Localization.AtPrime QC) QC (Algebra.linearMap C _) hdiv
      haveI : Module.Finite (Localization.AtPrime q) (Localization.AtPrime QC) :=
        Module.Finite.of_isLocalizedModule q.primeCompl (Rₚ := Localization.AtPrime q)
          ((Algebra.linearMap C (Localization.AtPrime QC)).restrictScalars T)
      letI : Module (Localization.AtPrime q) (LocalizedModule QC.primeCompl M) :=
        Module.compHom _ (algebraMap (Localization.AtPrime q) (Localization.AtPrime QC))
      haveI : IsScalarTower (Localization.AtPrime q) (Localization.AtPrime QC)
          (LocalizedModule QC.primeCompl M) :=
        IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
      haveI : IsScalarTower T (Localization.AtPrime q) (LocalizedModule QC.primeCompl M) := by
        refine IsScalarTower.of_algebraMap_smul (fun t m => ?_)
        show (algebraMap (Localization.AtPrime q) (Localization.AtPrime QC)
          (algebraMap T (Localization.AtPrime q) t)) • m = t • m
        rw [← IsScalarTower.algebraMap_apply,
          IsScalarTower.algebraMap_apply T C (Localization.AtPrime QC),
          algebraMap_smul, algebraMap_smul]
      let e' := LinearEquiv.extendScalarsOfIsLocalization q.primeCompl (Localization.AtPrime q) e
      haveI : Module.FinitePresentation (Localization.AtPrime q)
          (LocalizedModule QC.primeCompl M) :=
        Module.FinitePresentation.of_equiv e'
      exact HL2 (Localization.AtPrime q) (Localization.AtPrime QC)
        (LocalizedModule QC.primeCompl M) this

  intro R A N T C _ _ _ _ _ _ _ _ Q _ I _ _ _ _ _ _ _ _ _ _ QC _ hIfg hIle hann hQCB huniq hfl
  have htor : Module.IsTorsionBySet A N I := by
    intro n i
    exact (Module.mem_annihilator.mp (hIle i.2)) n
  letI : Module (A ⧸ I) N := htor.module
  haveI : IsScalarTower A (A ⧸ I) N := htor.isScalarTower
  haveI : IsScalarTower R (A ⧸ I) N := htor.isScalarTower
  have hIQ : I ≤ Q := hIle.trans hann
  haveI hQBp : (Q.map (Ideal.Quotient.mk I)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIQ)
  have hQBc : (Q.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = Q := by
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hIQ
  have hdiv := HL4 T C QC huniq
  haveI : Module.Finite (A ⧸ I) N := Module.Finite.of_restrictScalars_finite A (A ⧸ I) N
  haveI : Module.Finite C (TensorProduct (A ⧸ I) C N) := Module.Finite.base_change (A ⧸ I) C N
  haveI hfinT : Module.Finite T (TensorProduct (A ⧸ I) C N) :=
    Module.Finite.trans C (TensorProduct (A ⧸ I) C N)
  obtain ⟨f2, p2⟩ := s2 R A N I Q (Q.map (Ideal.Quotient.mk I)) hIfg hQBc
  obtain ⟨f3, p3⟩ := s3 R (A ⧸ I) C N (Q.map (Ideal.Quotient.mk I)) QC hQCB
  obtain ⟨f4, p4⟩ := s4 R T C (TensorProduct (A ⧸ I) C N) QC hdiv
  exact ⟨TensorProduct (A ⧸ I) C N, inferInstance, inferInstance, inferInstance, inferInstance,
    hfinT, f4 (f3 (f2 hfl)), fun h => p2 (p3 (p4 h))⟩

theorem wcpa_lfg_els_module_transfer : ∀ (R A N T C R' : Type u) [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A] [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N] [Module.Finite A N] (Q : Ideal A) [Q.IsPrime] (I : Ideal A) [CommRing T] [Algebra R T] [CommRing C] [Algebra T C] [Module.Finite T C] [Algebra.FinitePresentation T C] [Algebra (A ⧸ I) C] [Module.Flat (A ⧸ I) C] [Algebra R C] [IsScalarTower R T C] [IsScalarTower R (A ⧸ I) C] (QC : Ideal C) [QC.IsPrime] [CommRing R'] [IsLocalRing R'] [Algebra R R'] [Module.Flat R R'] [IsLocalHom (algebraMap R R')] (h : TensorProduct R R' T) (Q' : Ideal (Localization.Away h)) [Q'.IsPrime], I.FG → I ≤ Module.annihilator A N → Module.annihilator A N ≤ Q → QC.comap (algebraMap (A ⧸ I) C) = Q.map (Ideal.Quotient.mk I) → (∀ P'' : Ideal C, P''.IsPrime → P''.comap (algebraMap T C) = QC.comap (algebraMap T C) → P'' = QC) → Function.Bijective (IsLocalRing.ResidueField.map (algebraMap R R')) → Q'.comap (algebraMap R' (Localization.Away h)) = IsLocalRing.maximalIdeal R' → (Q'.comap (algebraMap (TensorProduct R R' T) (Localization.Away h))).comap (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := T)).toRingHom = QC.comap (algebraMap T C) → Module.Flat R (LocalizedModule Q.primeCompl N) → ∃ (N' : Type u) (_ : AddCommGroup N') (_ : Module (Localization.Away h) N') (_ : Module R' N') (_ : IsScalarTower R' (Localization.Away h) N') (_ : Module.Finite (Localization.Away h) N'), Module.Flat R' (LocalizedModule Q'.primeCompl N') ∧ (Module.FinitePresentation (Localization.AtPrime Q') (LocalizedModule Q'.primeCompl N') → Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N)) :=
by
  intro R A N T C R' _ _ _ _ _ _ _ _ _ Q _ I _ _ _ _ _ _ _ _ _ _ _ QC _ _ _ _ _ _ h Q' _
    hIfg hIle hann hQCB huniq _hbij _hQ'R hQ'q hfl

  have L1 : ∀ (A B M M' : Type u) [CommRing A] [CommRing B] [Algebra A B]
      [Module.FaithfullyFlat A B] [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
      [Module B M'] [IsScalarTower A B M'] (f : M →ₗ[A] M'), IsBaseChange B f →
      Module.FinitePresentation B M' → Module.FinitePresentation A M := by
    intro A B M M' _ _ _ _ _ _ _ _ _ _ f hf hfp
    haveI : Module.FinitePresentation B (TensorProduct A B M) :=
      Module.FinitePresentation.of_equiv hf.equiv.symm
    haveI : Module.Finite A M := Module.Finite.of_finite_tensorProduct_of_faithfullyFlat B
    obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' A M
    set K := LinearMap.ker π with hK
    have hex : Function.Exact (LinearMap.baseChange B K.subtype) (LinearMap.baseChange B π) := by
      have h0 : Function.Exact K.subtype π := LinearMap.exact_subtype_ker_map π
      simpa [LinearMap.baseChange_eq_ltensor] using lTensor_exact B h0 hπ
    have hinj : Function.Injective (LinearMap.baseChange B K.subtype) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact Module.Flat.lTensor_preserves_injective_linearMap _ K.injective_subtype
    have hsurj : Function.Surjective (LinearMap.baseChange B π) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective B hπ
    have hkerfg : (LinearMap.ker (LinearMap.baseChange B π)).FG :=
      Module.FinitePresentation.fg_ker _ hsurj
    have hrange : LinearMap.range (LinearMap.baseChange B K.subtype) =
        LinearMap.ker (LinearMap.baseChange B π) := hex.linearMap_ker_eq.symm
    haveI : Module.Finite B (LinearMap.ker (LinearMap.baseChange B π)) :=
      Module.Finite.iff_fg.mpr hkerfg
    haveI : Module.Finite B (TensorProduct A B K) :=
      Module.Finite.equiv
        ((LinearEquiv.ofInjective _ hinj).trans (LinearEquiv.ofEq _ _ hrange)).symm
    haveI : Module.Finite A K := Module.Finite.of_finite_tensorProduct_of_faithfullyFlat B
    exact Module.finitePresentation_of_free_of_surjective π hπ
      (Module.Finite.iff_fg.mp inferInstance)

  have L2 : ∀ (T C M : Type u) [CommRing T] [CommRing C] [Algebra T C] [Module.Finite T C]
      [AddCommGroup M] [Module C M] [Module T M] [IsScalarTower T C M],
      Module.FinitePresentation T M → Module.FinitePresentation C M := by
    intro T C M _ _ _ _ _ _ _ _ hfp
    haveI : Module.Finite C M := Module.Finite.of_restrictScalars_finite T C M
    obtain ⟨n, l, hl⟩ := Module.Finite.exists_fin' C M
    have hker : (LinearMap.ker (l.restrictScalars T)).FG :=
      Module.FinitePresentation.fg_ker (l.restrictScalars T) hl
    have hker' : (LinearMap.ker l).FG := by
      apply Submodule.FG.of_restrictScalars T
      exact hker
    exact Module.finitePresentation_of_free_of_surjective l hl hker'

  have L3 : ∀ (R B P N : Type u) [CommRing R] [CommRing B] [Algebra R B] [AddCommGroup P]
      [Module B P] [Module R P] [IsScalarTower R B P] [AddCommGroup N] [Module B N] [Module R N]
      [IsScalarTower R B N], Module.Flat B P → Module.Flat R N →
      Module.Flat R (TensorProduct B P N) := by
    intro R B P N _ _ _ _ _ _ _ _ _ _ _ hP hN
    rw [Module.Flat.iff_lTensor_preserves_injective_linearMap]
    intro U V _ _ _ _ u hu
    let g : TensorProduct R N U →ₗ[B] TensorProduct R N V :=
      TensorProduct.AlgebraTensorModule.map LinearMap.id u
    have hg : Function.Injective g := by
      have : (g : TensorProduct R N U → TensorProduct R N V) = LinearMap.lTensor N u := by
        funext x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => simp [g]
        | add x y hx hy => simp only [map_add, hx, hy]
      rw [this]
      exact Module.Flat.lTensor_preserves_injective_linearMap u hu
    have hPg : Function.Injective (LinearMap.lTensor P g) :=
      Module.Flat.lTensor_preserves_injective_linearMap g hg
    let eU := TensorProduct.AlgebraTensorModule.assoc R B B P N U
    let eV := TensorProduct.AlgebraTensorModule.assoc R B B P N V
    have hsq : ∀ x, eV (LinearMap.lTensor (TensorProduct B P N) u x) =
        LinearMap.lTensor P g (eU x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        induction a using TensorProduct.induction_on with
        | zero => simp
        | tmul p n => simp [eU, eV, g]
        | add x y hx hy => simp only [TensorProduct.add_tmul, map_add, hx, hy]
      | add x y hx hy => simp only [map_add, hx, hy]
    intro x y hxy
    apply eU.injective
    apply hPg
    rw [← hsq, ← hsq, hxy]

  have L4 : ∀ (T C : Type u) [CommRing T] [CommRing C] [Algebra T C] [Module.Finite T C]
      (QC : Ideal C) [QC.IsPrime], (∀ P'' : Ideal C, P''.IsPrime →
        P''.comap (algebraMap T C) = QC.comap (algebraMap T C) → P'' = QC) →
      ∀ c : C, c ∉ QC → ∃ (d : C) (t : T), t ∉ QC.comap (algebraMap T C) ∧
        c * d = algebraMap T C t := by
    intro T C _ _ _ _ QC _ huniq c hc
    by_contra hne
    push_neg at hne
    set q := QC.comap (algebraMap T C) with hq
    have hdisj : Disjoint ((Ideal.span {c} : Ideal C) : Set C)
        (q.primeCompl.map (algebraMap T C) : Set C) := by
      rw [Set.disjoint_left]
      intro x hx hxS
      obtain ⟨t, ht, rfl⟩ := hxS
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hx
      exact hne d t ht (by rw [mul_comm]; exact hd)
    obtain ⟨P, hP, hcP, hPS⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
    have hle : P.comap (algebraMap T C) ≤ q := by
      intro t ht
      by_contra htq
      exact Set.disjoint_left.mp hPS ht ⟨t, htq, rfl⟩
    obtain ⟨Q, hQP, hQ, hQq⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime q P hle
    have := huniq Q hQ hQq
    exact hc (this ▸ hQP (hcP (Ideal.mem_span_singleton_self c)))

  obtain ⟨X, i1, i2, i3, i4, i5, hXfl, hXfp⟩ :=
    wcpa_lfg_els_mt_reduce_to_T L1 L2 L3 L4 R A N T C Q I QC hIfg hIle hann hQCB huniq hfl
  obtain ⟨N', j1, j2, j3, j4, j5, hN'fl, hN'fp⟩ :=
    wcpa_lfg_els_mt_base_change_step L1 L3 R T X R' (QC.comap (algebraMap T C)) h Q' hQ'q hXfl
  exact ⟨N', j1, j2, j3, j4, j5, hN'fl, fun hfp => hXfp (hN'fp hfp)⟩

theorem wcpa_lfg_etale_local_structure : ∀ (R A N : Type u) [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] [AddCommGroup N] [Module A N] [Module R N] [IsScalarTower R A N] [Module.Finite A N] (Q : Ideal A) [Q.IsPrime], Q.comap (algebraMap R A) = IsLocalRing.maximalIdeal R → Module.annihilator A N ≤ Q → Module.Flat R (LocalizedModule Q.primeCompl N) → ∃ (R' S N' : Type u) (_ : CommRing R') (_ : IsLocalRing R') (_ : CommRing S) (_ : Algebra R' S) (_ : Algebra.FinitePresentation R' S) (_ : Module.Flat R' S) (_ : AddCommGroup N') (_ : Module S N') (_ : Module R' N') (_ : IsScalarTower R' S N') (_ : Module.Finite S N') (Q' : Ideal S) (_ : Q'.IsPrime), (∀ (p : Ideal R') [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) ∧ IsDomain (S ⧸ Ideal.map (algebraMap R' S) (IsLocalRing.maximalIdeal R')) ∧ Q'.comap (algebraMap R' S) = IsLocalRing.maximalIdeal R' ∧ Module.Flat R' (LocalizedModule Q'.primeCompl N') ∧ ringKrullDim (S ⧸ Ideal.map (algebraMap R' S) (IsLocalRing.maximalIdeal R')) ≤ ringKrullDim (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ⊔ Module.annihilator A N)) ∧ (Module.FinitePresentation (Localization.AtPrime Q') (LocalizedModule Q'.primeCompl N') → Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N)) :=
by
  intro R A N _ _ _ _ _ _ _ _ _ _ Q _ hQ hann hfl
  classical

  have hcut : ∀ J : Ideal A, ∃ I : Ideal A, I.FG ∧ I ≤ J ∧
      Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ⊔ I =
        Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ⊔ J := by
    intro J
    set mA := Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) with hmA
    have s5 : ∀ (B : Type u) [CommRing B] (φ : A →+* B) (I : Ideal A),
        (I.map φ).FG → ∃ H : Finset A, (↑H : Set A) ⊆ I ∧
          (Ideal.span (↑H : Set A)).map φ = I.map φ := by
      intro B _ φ I hfg
      obtain ⟨T, hT⟩ := hfg
      have h1 : (↑T : Set B) ⊆ (Submodule.span B (φ '' (I : Set A)) : Set B) := by
        intro x hx
        have hx' : x ∈ I.map φ := hT ▸ Submodule.subset_span hx
        exact hx'
      obtain ⟨U, hU, hTU⟩ := Submodule.subset_span_finite_of_subset_span h1
      obtain ⟨H, hH, rfl⟩ := Finset.subset_set_image_iff.mp hU
      refine ⟨H, hH, le_antisymm (Ideal.map_mono (Ideal.span_le.mpr hH)) ?_⟩
      rw [← hT, Ideal.map_span]
      apply Submodule.span_le.mpr
      intro x hx
      have hx' := hTU hx
      rw [Finset.coe_image] at hx'
      exact hx'
    letI : Algebra (R ⧸ IsLocalRing.maximalIdeal R) (A ⧸ mA) :=
      Ideal.Quotient.algebraQuotientMapQuotient
    haveI : Algebra.FiniteType R (A ⧸ mA) := inferInstance
    haveI : Algebra.FiniteType (R ⧸ IsLocalRing.maximalIdeal R) (A ⧸ mA) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R _ _
    haveI : IsNoetherianRing (R ⧸ IsLocalRing.maximalIdeal R) := by
      letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal R)
      infer_instance
    haveI : IsNoetherianRing (A ⧸ mA) :=
      Algebra.FiniteType.isNoetherianRing (R ⧸ IsLocalRing.maximalIdeal R) (A ⧸ mA)
    obtain ⟨H, hH, hHeq⟩ := s5 (A ⧸ mA) (Ideal.Quotient.mk mA) J (IsNoetherian.noetherian _)
    refine ⟨Ideal.span (↑H : Set A), ⟨H, rfl⟩, Ideal.span_le.mpr hH, ?_⟩
    apply le_antisymm (sup_le_sup_left (Ideal.span_le.mpr hH) _)
    apply sup_le le_sup_left
    intro j hj
    have h1 : Ideal.Quotient.mk mA j ∈ (Ideal.span (↑H : Set A)).map (Ideal.Quotient.mk mA) := by
      rw [hHeq]; exact Ideal.mem_map_of_mem _ hj
    have h2 : j ∈ ((Ideal.span (↑H : Set A)).map (Ideal.Quotient.mk mA)).comap
        (Ideal.Quotient.mk mA) := h1
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
      sup_comm] at h2
    exact h2

  obtain ⟨I, hIfg, hIle, hIeq⟩ := hcut (Module.annihilator A N)
  have hIQ : I ≤ Q := hIle.trans hann
  haveI hBfp : Algebra.FinitePresentation R (A ⧸ I) := Algebra.FinitePresentation.quotient hIfg
  haveI hQBp : (Q.map (Ideal.Quotient.mk I)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIQ)
  have hQBc : (Q.map (Ideal.Quotient.mk I)).comap (Ideal.Quotient.mk I) = Q := by
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hIQ
  have hQBR : (Q.map (Ideal.Quotient.mk I)).comap (algebraMap R (A ⧸ I)) =
      IsLocalRing.maximalIdeal R := by
    rw [IsScalarTower.algebraMap_eq R A (A ⧸ I), ← Ideal.comap_comap,
      Ideal.Quotient.algebraMap_eq, hQBc, hQ]
  have hmB : Ideal.map (algebraMap R (A ⧸ I)) (IsLocalRing.maximalIdeal R) =
      (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R)).map (Ideal.Quotient.mk I) := by
    rw [Ideal.map_map, ← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
  have hdimB : ringKrullDim ((A ⧸ I) ⧸ Ideal.map (algebraMap R (A ⧸ I))
      (IsLocalRing.maximalIdeal R)) = ringKrullDim (A ⧸ (Ideal.map (algebraMap R A)
        (IsLocalRing.maximalIdeal R) ⊔ Module.annihilator A N)) := by
    rw [hmB, ← hIeq, sup_comm]
    exact ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotSup I _)

  obtain ⟨s, iP, hTow, hsdim, hfin, hres⟩ :=
    wcpa_lfg_els_noether_point R (A ⧸ I) (Q.map (Ideal.Quotient.mk I)) hQBR
  letI := iP
  haveI hPBfp : Algebra.FinitePresentation (MvPolynomial (Fin s) R) (A ⧸ I) :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R _ _

  haveI hqf : Algebra.QuasiFiniteAt (MvPolynomial (Fin s) R) (Q.map (Ideal.Quotient.mk I)) :=
    wcpa_lfg_els_quasifinite_at (MvPolynomial (Fin s) R) (A ⧸ I) _ hfin

  obtain ⟨T, C, _, _, _, _, _, _, _, _, _, _, _, _, _, _, QC, _, hQCB, hQCT, huniq, hresC⟩ :=
    wcpa_lfg_els_etale_finite_split R (MvPolynomial (Fin s) R) (A ⧸ I)
      (Q.map (Ideal.Quotient.mk I)) hres
  have hqR : (QC.comap (algebraMap T C)).comap (algebraMap R T) = IsLocalRing.maximalIdeal R := by
    rw [IsScalarTower.algebraMap_eq R (MvPolynomial (Fin s) R) T, ← Ideal.comap_comap, hQCT,
      Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, hQBR]

  obtain ⟨R', _, _, _, _, _, h, Q', _, hbij, hQ'R, hQ'q, hgeom⟩ :=
    wcpa_lfg_els_geom_integral_nbhd R T s (QC.comap (algebraMap T C)) hqR hresC

  obtain ⟨hSfp, hSflat, hSdom, hSdim⟩ := wcpa_lfg_els_smooth_chart_props R T R' s h hgeom

  obtain ⟨N', _, _, _, _, _, hflN', hfpN'⟩ :=
    wcpa_lfg_els_module_transfer R A N T C R' Q I QC h Q' hIfg hIle hann hQCB huniq hbij hQ'R
      hQ'q hfl

  refine ⟨R', Localization.Away h, N', inferInstance, inferInstance, inferInstance, inferInstance,
    hSfp, hSflat, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, Q',
    inferInstance, hgeom, hSdom, hQ'R, hflN', ?_, hfpN'⟩
  exact hSdim.trans (hsdim.trans hdimB.le)

theorem wcpa_lfg_devissage_step : ∀ (R S N : Type u) [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S] [Algebra.FinitePresentation R S] [Module.Flat R S] [Module.Projective R S] [AddCommGroup N] [Module S N] [Module R N] [IsScalarTower R S N] [Module.Finite S N] (Q : Ideal S) [Q.IsPrime], IsDomain (S ⧸ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R)) → (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → Q.comap (algebraMap R S) = IsLocalRing.maximalIdeal R → Module.Flat R (LocalizedModule Q.primeCompl N) → ∃ (C : Type u) (_ : AddCommGroup C) (_ : Module S C) (_ : Module R C) (_ : IsScalarTower R S C) (_ : Module.Finite S C), Module.Flat R (LocalizedModule Q.primeCompl C) ∧ ringKrullDim (S ⧸ (Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ⊔ Module.annihilator S C)) < ringKrullDim (S ⧸ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R)) ∧ (Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl C) → Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N)) :=
by



  have s1 : ∀ (S N : Type u) [CommRing S] [AddCommGroup N] [Module S N] [Module.Finite S N]
      (P : Ideal S) [P.IsPrime], ∃ (r : ℕ) (x : Fin r → N),
        (∃ s : S, s ∉ P ∧ ∀ n : N, s • n ∈ Submodule.span S (Set.range x)) ∧
        ∀ c : Fin r → S, (∃ t : S, t ∉ P ∧ t • ∑ i, c i • x i ∈ P • (⊤ : Submodule S N)) →
          ∀ i, c i ∈ P := by
    intro S N _ _ _ _ P hP
    classical
    have key : ∀ (k : ℕ) (g : Fin k → N), ∃ (r : ℕ) (x : Fin r → N),
        (∀ c : Fin r → S, (∃ t : S, t ∉ P ∧ t • ∑ i, c i • x i ∈ P • (⊤ : Submodule S N)) →
          ∀ i, c i ∈ P) ∧
        ∃ u : S, u ∉ P ∧ ∀ j, u • g j ∈ Submodule.span S (Set.range x) ⊔ P • (⊤ : Submodule S N) := by
      intro k
      induction k with
      | zero =>
        intro g
        refine ⟨0, Fin.elim0, fun c _ i => Fin.elim0 i, 1, ?_, fun j => Fin.elim0 j⟩
        exact (Ideal.ne_top_iff_one P).mp hP.ne_top
      | succ k ih =>
        intro g
        obtain ⟨r, x, hx, u, huP, hu⟩ := ih (fun j => g (Fin.castSucc j))
        by_cases hgood : ∀ c : Fin (r + 1) → S, (∃ t : S, t ∉ P ∧
            t • ∑ i, c i • (Fin.snoc x (g (Fin.last k)) : Fin (r + 1) → N) i ∈
              P • (⊤ : Submodule S N)) → ∀ i, c i ∈ P
        · refine ⟨r + 1, Fin.snoc x (g (Fin.last k)), hgood, u, huP, ?_⟩
          have hsp : Submodule.span S (Set.range x) ≤
              Submodule.span S (Set.range (Fin.snoc x (g (Fin.last k)) : Fin (r + 1) → N)) := by
            apply Submodule.span_mono
            rintro _ ⟨i, rfl⟩
            exact ⟨Fin.castSucc i, Fin.snoc_castSucc (α := fun _ => N) _ _ _⟩
          intro j
          induction j using Fin.lastCases with
          | last =>
            apply Submodule.mem_sup_left
            apply Submodule.smul_mem
            exact Submodule.subset_span ⟨Fin.last r, Fin.snoc_last (α := fun _ => N) _ _⟩
          | cast j =>
            exact sup_le_sup_right hsp _ (hu j)
        · push_neg at hgood
          obtain ⟨c, ⟨t, htP, ht⟩, i₀, hi₀⟩ := hgood
          rw [Fin.sum_univ_castSucc] at ht
          simp only [Fin.snoc_castSucc, Fin.snoc_last] at ht
          have hcl : c (Fin.last r) ∉ P := by
            intro hcl
            have h1 : t • (c (Fin.last r) • g (Fin.last k)) ∈ P • (⊤ : Submodule S N) :=
              Submodule.smul_mem _ t (Submodule.smul_mem_smul hcl Submodule.mem_top)
            have h2 : t • ∑ i : Fin r, c (Fin.castSucc i) • x i ∈ P • (⊤ : Submodule S N) := by
              have := Submodule.sub_mem _ ht h1
              rwa [smul_add, add_sub_cancel_right] at this
            have h3 := hx (fun i => c (Fin.castSucc i)) ⟨t, htP, h2⟩
            induction i₀ using Fin.lastCases with
            | last => exact hi₀ hcl
            | cast j => exact hi₀ (h3 j)
          refine ⟨r, x, hx, u * (t * c (Fin.last r)), ?_, ?_⟩
          · intro hm
            rcases hP.mem_or_mem hm with h | h
            · exact huP h
            · rcases hP.mem_or_mem h with h' | h'
              · exact htP h'
              · exact hcl h'
          · have hy' : (t * c (Fin.last r)) • g (Fin.last k) ∈
                Submodule.span S (Set.range x) ⊔ P • (⊤ : Submodule S N) := by
              have e : (t * c (Fin.last r)) • g (Fin.last k) =
                  t • (∑ i : Fin r, c (Fin.castSucc i) • x i + c (Fin.last r) • g (Fin.last k)) -
                    t • ∑ i : Fin r, c (Fin.castSucc i) • x i := by
                rw [smul_add, add_sub_cancel_left, mul_smul]
              rw [e]
              refine Submodule.sub_mem _ (Submodule.mem_sup_right ht) (Submodule.mem_sup_left ?_)
              exact Submodule.smul_mem _ t (Submodule.sum_mem _
                (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)))
            intro j
            induction j using Fin.lastCases with
            | last =>
              rw [mul_smul]
              exact Submodule.smul_mem _ u hy'
            | cast j =>
              rw [mul_comm, mul_smul]
              exact Submodule.smul_mem _ _ (hu j)
    obtain ⟨k, g, hg⟩ := Module.Finite.exists_fin (R := S) (M := N)
    obtain ⟨r, x, hx, u, huP, hu⟩ := key k g
    have huN : ∀ n : N, u • n ∈ Submodule.span S (Set.range x) ⊔ P • (⊤ : Submodule S N) := by
      have hle : Submodule.span S (Set.range g) ≤
          (Submodule.span S (Set.range x) ⊔ P • (⊤ : Submodule S N)).comap
            (LinearMap.lsmul S N u) := by
        rw [Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        exact hu j
      intro n
      have hn : n ∈ Submodule.span S (Set.range g) := by rw [hg]; exact Submodule.mem_top
      exact hle hn
    let φ : Module.End S (N ⧸ Submodule.span S (Set.range x)) :=
      algebraMap S (Module.End S (N ⧸ Submodule.span S (Set.range x))) u
    have hφ : LinearMap.range φ ≤ P • (⊤ : Submodule S (N ⧸ Submodule.span S (Set.range x))) := by
      rintro _ ⟨c, rfl⟩
      induction c using Submodule.Quotient.induction_on with
      | H n =>
        obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (huN n)
        have e : φ (Submodule.Quotient.mk n) = (Submodule.span S (Set.range x)).mkQ b := by
          simp only [φ, Module.algebraMap_end_apply]
          rw [← Submodule.Quotient.mk_smul, ← hab, Submodule.Quotient.mk_add,
            (Submodule.Quotient.mk_eq_zero _).mpr ha, zero_add]
          rfl
        rw [e]
        exact Submodule.smul_top_le_comap_smul_top P _ hb
    obtain ⟨p, hmon, -, hcoeff, hev⟩ :=
      LinearMap.exists_monic_and_natDegree_eq_and_coeff_mem_pow_and_aeval_eq_zero S φ P hφ
    have hev' : algebraMap S (Module.End S (N ⧸ Submodule.span S (Set.range x))) (p.eval u) = 0 := by
      rw [← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval]; exact hev
    refine ⟨r, x, ⟨p.eval u, ?_, ?_⟩, hx⟩
    · intro hmem
      have hmap : p.map (Ideal.Quotient.mk P) = Polynomial.X ^ p.natDegree := by
        ext m
        rw [Polynomial.coeff_map, Polynomial.coeff_X_pow]
        split_ifs with hm
        · subst hm; rw [hmon.coeff_natDegree, map_one]
        · rcases lt_or_gt_of_ne hm with hlt | hgt
          · rw [Ideal.Quotient.eq_zero_iff_mem]
            exact Ideal.pow_le_self (by omega) (hcoeff m)
          · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hgt, map_zero]
      have h1 : Ideal.Quotient.mk P (p.eval u) = (Ideal.Quotient.mk P u) ^ p.natDegree := by
        rw [← Polynomial.eval₂_hom, ← Polynomial.eval_map, hmap, Polynomial.eval_X_pow]
      have h2 : (Ideal.Quotient.mk P u) ^ p.natDegree ≠ 0 :=
        pow_ne_zero _ (by rwa [Ne, Ideal.Quotient.eq_zero_iff_mem])
      exact h2 (by rw [← h1, Ideal.Quotient.eq_zero_iff_mem.mpr hmem])
    · intro n
      have h := LinearMap.congr_fun hev' (Submodule.Quotient.mk n)
      rw [Module.algebraMap_end_apply, LinearMap.zero_apply, ← Submodule.Quotient.mk_smul,
        Submodule.Quotient.mk_eq_zero] at h
      exact h



  have s2 : ∀ (S : Type u) [CommRing S] (P A : Ideal S) [P.IsPrime], ¬ A ≤ P →
      ringKrullDim (S ⧸ P) < ⊤ → ringKrullDim (S ⧸ (P ⊔ A)) < ringKrullDim (S ⧸ P) := by
    intro S _ P A _ hA hfin
    obtain ⟨a, haA, haP⟩ := Set.not_subset.mp hA
    have hne : Ideal.Quotient.mk P a ≠ 0 := by
      rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
    have hnzd : Ideal.Quotient.mk P a ∈ nonZeroDivisors (S ⧸ P) :=
      mem_nonZeroDivisors_of_ne_zero hne
    have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hnzd
    have e := (DoubleQuot.quotQuotEquivQuotSup P (Ideal.span {a})).ringKrullDim
    rw [Ideal.map_span, Set.image_singleton] at e
    have hle : P ⊔ Ideal.span {a} ≤ P ⊔ A :=
      sup_le_sup_left (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr haA)) P
    have h2 : ringKrullDim (S ⧸ (P ⊔ A)) ≤ ringKrullDim (S ⧸ (P ⊔ Ideal.span {a})) :=
      ringKrullDim_le_of_surjective (Ideal.Quotient.factor hle) (Ideal.Quotient.factor_surjective hle)
    rw [← e] at h2
    haveI : Nontrivial (S ⧸ P) := Ideal.Quotient.nontrivial_iff.mpr (Ideal.IsPrime.ne_top ‹_›)
    have h0 := ringKrullDim_nonneg_of_nontrivial (R := S ⧸ P)
    refine lt_of_le_of_lt h2 ?_
    generalize ringKrullDim ((S ⧸ P) ⧸ Ideal.span {Ideal.Quotient.mk P a}) = y at h1 ⊢
    generalize ringKrullDim (S ⧸ P) = z at h0 h1 hfin ⊢
    induction y using WithBot.recBotCoe with
    | bot => exact lt_of_lt_of_le (WithBot.bot_lt_coe 0) h0
    | coe y =>
      induction z using WithBot.recBotCoe with
      | bot => exact absurd h0 (by simp)
      | coe z =>
        have h1' : y + 1 ≤ z := by exact_mod_cast h1
        have hz : z < ⊤ := WithBot.coe_lt_coe.mp hfin
        apply WithBot.coe_lt_coe.mpr
        induction z using ENat.recTopCoe with
        | top => exact absurd hz (lt_irrefl _)
        | coe z =>
          induction y using ENat.recTopCoe with
          | top => simp at h1'
          | coe y =>
            have : y + 1 ≤ z := by exact_mod_cast h1'
            exact_mod_cast (by omega : y < z)



  have flat_prod : ∀ (R M N : Type u) [CommRing R] [AddCommGroup M] [Module R M] [Module.Flat R M]
      [AddCommGroup N] [Module R N] [Module.Flat R N], Module.Flat R (M × N) := by
    intro R M N _ _ _ _ _ _ _
    rw [Module.Flat.iff_rTensor_injective']
    intro I
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro ξ hξ
    rw [LinearMap.mem_ker] at hξ
    have nat1 : LinearMap.rTensor M I.subtype (LinearMap.lTensor I (LinearMap.fst R M N) ξ) =
        LinearMap.lTensor R (LinearMap.fst R M N) (LinearMap.rTensor (M × N) I.subtype ξ) := by
      rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
        LinearMap.lTensor_comp_rTensor]
    have nat2 : LinearMap.rTensor N I.subtype (LinearMap.lTensor I (LinearMap.snd R M N) ξ) =
        LinearMap.lTensor R (LinearMap.snd R M N) (LinearMap.rTensor (M × N) I.subtype ξ) := by
      rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
        LinearMap.lTensor_comp_rTensor]
    have i1 : Function.Injective (LinearMap.rTensor M I.subtype) :=
      Module.Flat.rTensor_preserves_injective_linearMap (M := M) _ I.injective_subtype
    have i2 : Function.Injective (LinearMap.rTensor N I.subtype) :=
      Module.Flat.rTensor_preserves_injective_linearMap (M := N) _ I.injective_subtype
    have h1 : LinearMap.lTensor I (LinearMap.fst R M N) ξ = 0 := by
      apply i1
      rw [nat1, hξ, map_zero, map_zero]
    have h2 : LinearMap.lTensor I (LinearMap.snd R M N) ξ = 0 := by
      apply i2
      rw [nat2, hξ, map_zero, map_zero]
    have hid : LinearMap.inl R M N ∘ₗ LinearMap.fst R M N +
        LinearMap.inr R M N ∘ₗ LinearMap.snd R M N = LinearMap.id := by
      apply LinearMap.ext
      intro p
      simp
    have e : ξ = LinearMap.lTensor I (LinearMap.inl R M N) (LinearMap.lTensor I (LinearMap.fst R M N) ξ) +
        LinearMap.lTensor I (LinearMap.inr R M N) (LinearMap.lTensor I (LinearMap.snd R M N) ξ) := by
      rw [← LinearMap.comp_apply (LinearMap.lTensor I (LinearMap.inl R M N)),
        ← LinearMap.comp_apply (LinearMap.lTensor I (LinearMap.inr R M N)),
        ← LinearMap.lTensor_comp, ← LinearMap.lTensor_comp, ← LinearMap.add_apply,
        ← LinearMap.lTensor_add, hid, LinearMap.lTensor_id, LinearMap.id_apply]
    rw [e, h1, h2, map_zero, map_zero, add_zero]
  have split_crit : ∀ (R M₁ M₂ : Type u) [CommRing R] [IsLocalRing R] [AddCommGroup M₁] [Module R M₁]
      [Module.Finite R M₁] [AddCommGroup M₂] [Module R M₂] [Module.Finite R M₂] [Module.Free R M₂]
      (L : M₁ →ₗ[R] M₂), (∀ v : M₁, L v ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M₂) →
        v ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M₁)) →
      ∃ ψ : M₂ →ₗ[R] M₁, ψ ∘ₗ L = LinearMap.id := by
    intro R M₁ M₂ _ _ _ _ _ _ _ _ _ L hL
    rw [IsLocalRing.split_injective_iff_lTensor_residueField_injective]
    set m := IsLocalRing.maximalIdeal R
    let e₁ := TensorProduct.quotTensorEquivQuotSMul M₁ m
    let e₂ := TensorProduct.quotTensorEquivQuotSMul M₂ m
    let φ := Submodule.mapQ (m • (⊤ : Submodule R M₁)) (m • (⊤ : Submodule R M₂)) L
      (Submodule.smul_top_le_comap_smul_top m L)
    have hcomm : ∀ z : TensorProduct R (R ⧸ m) M₁,
        e₂ (LinearMap.lTensor (R ⧸ m) L z) = φ (e₁ z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a v =>
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
        simp only [LinearMap.lTensor_tmul, e₁, e₂, φ, TensorProduct.quotTensorEquivQuotSMul_mk_tmul,
          Submodule.mapQ_apply, map_smul]
      | add a b ha hb => simp only [map_add, ha, hb]
    have hφ : Function.Injective φ := by
      intro a b hab
      induction a using Submodule.Quotient.induction_on with
      | H a =>
      induction b using Submodule.Quotient.induction_on with
      | H b =>
      simp only [φ, Submodule.mapQ_apply] at hab
      rw [Submodule.Quotient.eq] at hab ⊢
      apply hL
      rwa [map_sub]
    show Function.Injective (LinearMap.lTensor (R ⧸ m) L)
    intro z w hzw
    apply e₁.injective
    apply hφ
    rw [← hcomm, ← hcomm, hzw]
  have ui_finfree : ∀ (R M N : Type u) [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]
      [Module.Free R M] [Module.Finite R M] [AddCommGroup N] [Module R N] [Module.Flat R N]
      (f : M →ₗ[R] N), (∀ v : M, f v ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R N) →
        v ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)) →
      ∀ (I : Ideal R) (v : M), f v ∈ I • (⊤ : Submodule R N) → v ∈ I • (⊤ : Submodule R M) := by
    intro R M N _ _ _ _ _ _ _ _ _ f hf I v hv
    classical
    have hv' : f v ∈ I • Submodule.span R (Set.range (id : N → N)) := by
      rwa [Set.range_id, Submodule.span_univ]
    obtain ⟨a, haI, hasum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum I id (f v)).mp hv'
    let ι := ↥a.support
    let G : M × (ι → R) →ₗ[R] N :=
      f ∘ₗ LinearMap.fst R M (ι → R) +
        Fintype.linearCombination R (fun j : ι => (j : N)) ∘ₗ LinearMap.snd R M (ι → R)
    let w : M × (ι → R) := (v, fun j => - a j)
    have hGw : G w = 0 := by
      simp only [G, w, LinearMap.add_apply, LinearMap.comp_apply, LinearMap.fst_apply,
        LinearMap.snd_apply, Fintype.linearCombination_apply, neg_smul]
      rw [← hasum, Finsupp.sum, ← Finset.sum_coe_sort a.support, ← Finset.sum_add_distrib]
      simp
    obtain ⟨k, α, y, hGy, hαw⟩ := Module.Flat.exists_factorization_of_apply_eq_zero_of_free hGw
    let L := α ∘ₗ LinearMap.inl R M (ι → R)
    have hfL : ∀ u, f u = y (L u) := by
      intro u
      have : G (u, 0) = f u := by simp [G]
      rw [← this, hGy]
      rfl
    have hLm : ∀ u, L u ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R _) →
        u ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M) := by
      intro u hu
      apply hf
      rw [hfL]
      exact Submodule.smul_top_le_comap_smul_top _ y hu
    obtain ⟨ψ, hψ⟩ := split_crit R M _ L hLm
    have hsplit : w = LinearMap.inl R M (ι → R) v - LinearMap.inr R M (ι → R) (fun j => a j) := by
      ext <;> simp [w]
    have hLv : L v = α (LinearMap.inr R M (ι → R) (fun j => a j)) := by
      rw [hsplit, map_sub, sub_eq_zero] at hαw
      exact hαw
    have hmem : LinearMap.inr R M (ι → R) (fun j => a j) ∈ I • (⊤ : Submodule R (M × (ι → R))) := by
      rw [pi_eq_sum_univ (fun j : ι => a j), map_sum]
      refine Submodule.sum_mem _ (fun j _ => ?_)
      rw [map_smul]
      exact Submodule.smul_mem_smul (haI j) Submodule.mem_top
    have hLvI : L v ∈ I • (⊤ : Submodule R _) := by
      rw [hLv]
      exact Submodule.smul_top_le_comap_smul_top I α hmem
    have : v = ψ (L v) := by rw [← LinearMap.comp_apply, hψ, LinearMap.id_apply]
    rw [this]
    exact Submodule.smul_top_le_comap_smul_top I ψ hLvI
  have s4 : ∀ (R M N : Type u) [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]
      [Module.Projective R M] [AddCommGroup N] [Module R N] [Module.Flat R N] (f : M →ₗ[R] N),
      (∀ v : M, f v ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R N) →
        v ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)) →
      ∀ (I : Ideal R) (v : M), f v ∈ I • (⊤ : Submodule R N) → v ∈ I • (⊤ : Submodule R M) := by
    intro R M N _ _ _ _ hproj _ _ _ f hf I v hv
    classical
    obtain ⟨σ, hσ⟩ := Module.projective_def'.mp hproj
    set p := Finsupp.linearCombination R (id : M → M)
    have hpσ : ∀ u, p (σ u) = u := fun u => by rw [← LinearMap.comp_apply, hσ, LinearMap.id_apply]
    let F := M →₀ R
    let h : F →ₗ[R] N × F := LinearMap.prod (f ∘ₗ p) (LinearMap.id - σ ∘ₗ p)
    haveI : Module.Flat R (N × F) := flat_prod R N F
    set m := IsLocalRing.maximalIdeal R
    have hhm : ∀ z : F, h z ∈ m • (⊤ : Submodule R (N × F)) → z ∈ m • (⊤ : Submodule R F) := by
      intro z hz
      have h1 : f (p z) ∈ m • (⊤ : Submodule R N) :=
        Submodule.smul_top_le_comap_smul_top m (LinearMap.fst R N F) hz
      have h2 : z - σ (p z) ∈ m • (⊤ : Submodule R F) :=
        Submodule.smul_top_le_comap_smul_top m (LinearMap.snd R N F) hz
      have h3 : σ (p z) ∈ m • (⊤ : Submodule R F) :=
        Submodule.smul_top_le_comap_smul_top m σ (hf _ h1)
      have := Submodule.add_mem _ h2 h3
      rwa [sub_add_cancel] at this
    set z := σ v
    set T : Set M := ↑z.support
    let FT := Finsupp.supported R R T
    haveI : Finite T := Finset.finite_toSet _
    haveI : Module.Free R FT := Module.Free.of_equiv (Finsupp.supportedEquivFinsupp T).symm
    haveI : Module.Finite R FT := Module.Finite.equiv (Finsupp.supportedEquivFinsupp T).symm
    let hT := h ∘ₗ FT.subtype
    let ρ : F →ₗ[R] FT := Finsupp.restrictDom R R T
    have hρ : ∀ z' : FT, ρ z' = z' := by
      intro z'
      have := LinearMap.congr_fun (Finsupp.restrictDom_comp_subtype (M := R) (R := R) T) z'
      simpa only [LinearMap.comp_apply, Submodule.subtype_apply, LinearMap.id_apply] using this
    have hTm : ∀ z' : FT, hT z' ∈ m • (⊤ : Submodule R (N × F)) →
        z' ∈ m • (⊤ : Submodule R FT) := by
      intro z' hz'
      have := hhm _ hz'
      rw [← hρ z']
      exact Submodule.smul_top_le_comap_smul_top m ρ this
    have hzT : z ∈ FT := (Finsupp.mem_supported R z).mpr (subset_refl _)
    have hhz : hT ⟨z, hzT⟩ ∈ I • (⊤ : Submodule R (N × F)) := by
      have e : hT ⟨z, hzT⟩ = LinearMap.inl R N F (f v) := by
        apply Prod.ext
        · show f (p z) = f v
          rw [hpσ]
        · show z - σ (p z) = 0
          rw [hpσ, sub_self]
      rw [e]
      exact Submodule.smul_top_le_comap_smul_top I _ hv
    have hz := ui_finfree R FT (N × F) hT hTm I ⟨z, hzT⟩ hhz
    have hzF : z ∈ I • (⊤ : Submodule R F) :=
      Submodule.smul_top_le_comap_smul_top I FT.subtype hz
    rw [← hpσ v]
    exact Submodule.smul_top_le_comap_smul_top I p hzF



  have s5 : ∀ (R S N : Type u) [CommRing R] [CommRing S] [Algebra R S] [AddCommGroup N] [Module S N]
      [Module R N] [IsScalarTower R S N] (Q : Ideal S) [Q.IsPrime] (I : Ideal R) (n : N),
      LocalizedModule.mk n (1 : Q.primeCompl) ∈ I • (⊤ : Submodule R (LocalizedModule Q.primeCompl N)) →
      ∃ t : S, t ∉ Q ∧ t • n ∈ Ideal.map (algebraMap R S) I • (⊤ : Submodule S N) := by
    intro R S N _ _ _ _ _ _ _ Q _ I n hn
    set W := Ideal.map (algebraMap R S) I • (⊤ : Submodule S N) with hW
    have key : ∀ y ∈ I • (⊤ : Submodule R (LocalizedModule Q.primeCompl N)),
        ∃ (n' : N) (s : Q.primeCompl), n' ∈ W ∧ y = LocalizedModule.mk n' s := by
      intro y hy
      refine Submodule.smul_induction_on hy ?_ ?_
      · intro a ha w _
        induction w using LocalizedModule.induction_on with
        | h n'' s =>
          refine ⟨a • n'', s, ?_, LocalizedModule.smul'_mk a n'' s⟩
          rw [← algebraMap_smul S a n'']
          exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ ha) Submodule.mem_top
      · rintro y z ⟨n1, s1, h1, rfl⟩ ⟨n2, s2, h2, rfl⟩
        refine ⟨s2 • n1 + s1 • n2, s1 * s2, ?_, LocalizedModule.mk_add_mk⟩
        rw [Submonoid.smul_def, Submonoid.smul_def]
        exact W.add_mem (W.smul_mem _ h1) (W.smul_mem _ h2)
    obtain ⟨n', s, hn', he⟩ := key _ hn
    obtain ⟨u, hu⟩ := LocalizedModule.mk_eq.mp he
    refine ⟨(u : S) * s, (u * s).2, ?_⟩
    have hu' : (u : S) • (s : S) • n = (u : S) • n' := by
      simpa [Submonoid.smul_def] using hu
    rw [mul_smul, hu']
    exact W.smul_mem _ hn'



  have flat_quot_crit : ∀ (R M C : Type u) [CommRing R] [AddCommGroup M] [Module R M]
      [Module.Flat R M] [AddCommGroup C] [Module R C] (π : M →ₗ[R] C), Function.Surjective π →
      (∀ (I : Ideal R) (w : M), w ∈ LinearMap.ker π → w ∈ I • (⊤ : Submodule R M) →
        w ∈ I • LinearMap.ker π) → Module.Flat R C := by
    intro R M C _ _ _ _ _ _ π hπ h
    rw [Module.Flat.iff_rTensor_injective']
    intro I
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro ξ hξ
    rw [LinearMap.mem_ker] at hξ
    obtain ⟨η, rfl⟩ := LinearMap.lTensor_surjective I hπ ξ
    set K := LinearMap.ker π
    have hnat : LinearMap.rTensor C I.subtype (LinearMap.lTensor I π η) =
        LinearMap.lTensor R π (LinearMap.rTensor M I.subtype η) := by
      rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
        LinearMap.lTensor_comp_rTensor]
    have hlid : ∀ z : TensorProduct R R M,
        TensorProduct.lid R C (LinearMap.lTensor R π z) = π (TensorProduct.lid R M z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a m => simp
      | add a b ha hb => simp only [map_add, ha, hb]
    set m₀ := TensorProduct.lid R M (LinearMap.rTensor M I.subtype η) with hm₀
    have hm₀K : m₀ ∈ K := by
      rw [LinearMap.mem_ker, hm₀, ← hlid, ← hnat, hξ, map_zero]
    have himg : ∀ z : TensorProduct R I M, TensorProduct.lid R M (LinearMap.rTensor M I.subtype z) ∈
        I • (⊤ : Submodule R M) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a m =>
        simp only [LinearMap.rTensor_tmul, Submodule.subtype_apply, TensorProduct.lid_tmul]
        exact Submodule.smul_mem_smul a.2 Submodule.mem_top
      | add a b ha hb => simp only [map_add]; exact Submodule.add_mem _ ha hb
    have hm₀I := h I m₀ hm₀K (himg η)
    have hlift : ∀ w ∈ I • K, ∃ κ : TensorProduct R I K,
        TensorProduct.lid R M (LinearMap.rTensor M I.subtype (LinearMap.lTensor I K.subtype κ)) = w := by
      intro w hw
      refine Submodule.smul_induction_on hw ?_ ?_
      · intro a ha n hn
        exact ⟨TensorProduct.tmul R (⟨a, ha⟩ : I) (⟨n, hn⟩ : K), by simp⟩
      · rintro x y ⟨κ₁, h₁⟩ ⟨κ₂, h₂⟩
        exact ⟨κ₁ + κ₂, by rw [map_add, map_add, map_add, h₁, h₂]⟩
    obtain ⟨κ, hκ⟩ := hlift m₀ hm₀I
    have hinj : Function.Injective (LinearMap.rTensor M I.subtype) :=
      Module.Flat.rTensor_preserves_injective_linearMap _ I.injective_subtype
    have heq : η = LinearMap.lTensor I K.subtype κ := by
      apply hinj
      apply (TensorProduct.lid R M).injective
      rw [hκ]
    rw [heq, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
    have h0 : π ∘ₗ K.subtype = 0 := by
      ext x; exact x.2
    rw [h0, LinearMap.lTensor_zero, LinearMap.zero_apply]
  have s6 : ∀ (R S N : Type u) [CommRing R] [CommRing S] [Algebra R S] [AddCommGroup N] [Module S N]
      [Module R N] [IsScalarTower R S N] (Q : Ideal S) [Q.IsPrime] (r : ℕ) (x : Fin r → N),
      Module.Flat R (LocalizedModule Q.primeCompl N) →
      (∀ (I : Ideal R) (c : Fin r → S), LocalizedModule.mk (∑ i, c i • x i) (1 : Q.primeCompl) ∈
        I • (⊤ : Submodule R (LocalizedModule Q.primeCompl N)) →
        ∀ i, c i ∈ Ideal.map (algebraMap R S) I) →
      Module.Flat R (LocalizedModule Q.primeCompl (N ⧸ Submodule.span S (Set.range x))) := by
    intro R S N _ _ _ _ _ _ _ Q _ r x hflat hUI
    classical
    set V := Submodule.span S (Set.range x) with hV
    let π : LocalizedModule Q.primeCompl N →ₗ[R] LocalizedModule Q.primeCompl (N ⧸ V) :=
      (LocalizedModule.map Q.primeCompl V.mkQ).restrictScalars R
    have hπ : ∀ (n : N) (s : Q.primeCompl), π (LocalizedModule.mk n s) =
        LocalizedModule.mk (Submodule.Quotient.mk n) s := fun n s =>
      LocalizedModule.map_mk _ _ _ _
    have hadd : ∀ (a b : N) (s : Q.primeCompl), LocalizedModule.mk (a + b) s =
        LocalizedModule.mk a s + LocalizedModule.mk b s := by
      intro a b s
      rw [LocalizedModule.mk_add_mk, ← smul_add, LocalizedModule.mk_cancel_common_left]
    have hsurj : Function.Surjective π := by
      intro y
      induction y using LocalizedModule.induction_on with
      | h q s =>
        obtain ⟨n, rfl⟩ := Submodule.Quotient.mk_surjective V q
        exact ⟨LocalizedModule.mk n s, hπ n s⟩
    have hVK : ∀ n ∈ V, ∀ s : Q.primeCompl, LocalizedModule.mk n s ∈ LinearMap.ker π := by
      intro n hn s
      rw [LinearMap.mem_ker, hπ, (Submodule.Quotient.mk_eq_zero V).mpr hn, LocalizedModule.zero_mk]
    have hSsmul : ∀ (I : Ideal R) (a : S) (y : LocalizedModule Q.primeCompl N),
        y ∈ I • (⊤ : Submodule R (LocalizedModule Q.primeCompl N)) →
        a • y ∈ I • (⊤ : Submodule R (LocalizedModule Q.primeCompl N)) := by
      intro I a y hy
      refine Submodule.smul_induction_on hy ?_ ?_
      · intro b hb n _
        rw [smul_comm]
        exact Submodule.smul_mem_smul hb Submodule.mem_top
      · intro y z hy hz
        rw [smul_add]
        exact Submodule.add_mem _ hy hz
    apply flat_quot_crit R _ _ π hsurj
    intro I w hwK hwI
    induction w using LocalizedModule.induction_on with
    | h n s =>
      rw [LinearMap.mem_ker, hπ, ← LocalizedModule.zero_mk (1 : Q.primeCompl),
        LocalizedModule.mk_eq] at hwK
      obtain ⟨u, hu⟩ := hwK
      have hun : (u : S) • n ∈ V := by
        rw [smul_zero, smul_zero, one_smul, Submonoid.smul_def, ← Submodule.Quotient.mk_smul,
          Submodule.Quotient.mk_eq_zero] at hu
        exact hu
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun S).mp hun
      have hw : LocalizedModule.mk n s = LocalizedModule.mk (∑ i, c i • x i) (u * s) := by
        rw [hc, ← LocalizedModule.mk_cancel_common_left u s n]
        rfl
      rw [hw] at hwI ⊢
      have h1 : LocalizedModule.mk (∑ i, c i • x i) (1 : Q.primeCompl) ∈
          I • (⊤ : Submodule R (LocalizedModule Q.primeCompl N)) := by
        have := hSsmul I ((u * s : Q.primeCompl) : S) _ hwI
        have e : ((u * s : Q.primeCompl) : S) • LocalizedModule.mk (∑ i, c i • x i) (u * s) =
            LocalizedModule.mk (∑ i, c i • x i) (1 : Q.primeCompl) := by
          rw [LocalizedModule.smul'_mk, LocalizedModule.mk_eq]
          exact ⟨1, by simp [Submonoid.smul_def]⟩
        rwa [e] at this
      have hci := hUI I c h1
      have claim : ∀ a ∈ Ideal.map (algebraMap R S) I, ∀ m ∈ V, ∀ t : Q.primeCompl,
          LocalizedModule.mk (a • m) t ∈ I • LinearMap.ker π := by
        intro a ha
        have ha' : a ∈ Submodule.span S (⇑(algebraMap R S) '' (I : Set R)) := ha
        clear ha
        induction ha' using Submodule.span_induction with
        | mem a ha =>
          obtain ⟨b, hb, rfl⟩ := ha
          intro m hm t
          rw [algebraMap_smul, ← LocalizedModule.smul'_mk]
          exact Submodule.smul_mem_smul hb (hVK m hm t)
        | zero =>
          intro m _ t
          rw [zero_smul, LocalizedModule.zero_mk]
          exact Submodule.zero_mem _
        | add a b _ _ iha ihb =>
          intro m hm t
          rw [add_smul, hadd]
          exact Submodule.add_mem _ (iha m hm t) (ihb m hm t)
        | smul b a _ iha =>
          intro m hm t
          rw [smul_eq_mul, mul_comm, mul_smul]
          exact iha _ (V.smul_mem b hm) t
      have hsum : ∀ T : Finset (Fin r), LocalizedModule.mk (∑ i ∈ T, c i • x i) (u * s) ∈
          I • LinearMap.ker π := by
        intro T
        induction T using Finset.induction_on with
        | empty =>
          rw [Finset.sum_empty, LocalizedModule.zero_mk]
          exact Submodule.zero_mem _
        | insert i T hiT ih =>
          rw [Finset.sum_insert hiT, hadd]
          exact Submodule.add_mem _ (claim _ (hci i) _ (Submodule.subset_span ⟨i, rfl⟩) _) ih
      exact hsum Finset.univ



  have s7 : ∀ (S N : Type u) [CommRing S] [AddCommGroup N] [Module S N] (Q : Ideal S) [Q.IsPrime]
      (r : ℕ) (x : Fin r → N),
      (∀ c : Fin r → S, LocalizedModule.mk (∑ i, c i • x i) (1 : Q.primeCompl) = 0 → ∀ i, c i = 0) →
      Module.FinitePresentation (Localization.AtPrime Q)
        (LocalizedModule Q.primeCompl (N ⧸ Submodule.span S (Set.range x))) →
      Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N) := by
    intro S N _ _ _ Q _ r x hx hC
    set K := Submodule.localized Q.primeCompl (Submodule.span S (Set.range x)) with hK
    let v : Fin r → LocalizedModule Q.primeCompl N := fun i => LocalizedModule.mk (x i) 1
    have hKspan : K = Submodule.span (Localization.AtPrime Q) (Set.range v) := by
      rw [hK, Submodule.localized, Submodule.localized'_span, ← Set.range_comp]
      rfl
    have hli : LinearIndependent (Localization.AtPrime Q) v := by
      rw [Fintype.linearIndependent_iff]
      intro g hg i
      obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples Q.primeCompl
        (Finset.univ : Finset (Fin r)) g
      have hb' : ∀ i, ∃ c : S, algebraMap S (Localization.AtPrime Q) c = (b : S) • g i :=
        fun i => hb i (Finset.mem_univ i)
      choose c hc using hb'
      have h1 : LocalizedModule.mk (∑ i, c i • x i) (1 : Q.primeCompl) = 0 := by
        have h0 : ∑ i, (b : S) • (g i • v i) = 0 := by rw [← Finset.smul_sum, hg, smul_zero]
        rw [← LocalizedModule.mkLinearMap_apply, map_sum, ← h0]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_smul, LocalizedModule.mkLinearMap_apply, ← smul_assoc, ← hc i, algebraMap_smul]
      have hci := hx c h1 i
      have h2 : (b : S) • g i = 0 := by rw [← hc i, hci, map_zero]
      rw [Algebra.smul_def] at h2
      exact (IsLocalization.map_units (Localization.AtPrime Q) b).mul_right_eq_zero.mp h2
    have e1 : (Fin r →₀ Localization.AtPrime Q) ≃ₗ[Localization.AtPrime Q] K :=
      hli.linearCombinationEquiv.trans (LinearEquiv.ofEq _ _ hKspan.symm)
    haveI : Module.FinitePresentation (Localization.AtPrime Q) K :=
      Module.FinitePresentation.of_equiv e1
    haveI : Module.FinitePresentation (Localization.AtPrime Q)
        (LocalizedModule Q.primeCompl N ⧸ K) :=
      Module.FinitePresentation.of_equiv
        (localizedQuotientEquiv Q.primeCompl (Submodule.span S (Set.range x))).symm
    haveI : Module.FinitePresentation (Localization.AtPrime Q) (LinearMap.ker K.mkQ) :=
      Module.FinitePresentation.of_equiv (LinearEquiv.ofEq _ _ (Submodule.ker_mkQ K).symm)
    exact Module.finitePresentation_of_ker K.mkQ (Submodule.mkQ_surjective K)



  intro R S N _ _ _ _ _ _ _ _ _ _ _ _ Q _ hdom _hgi hQc hflat
  classical
  haveI hP : (Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R)).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp hdom
  have hPQ : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ≤ Q :=
    Ideal.map_le_iff_le_comap.mpr hQc.ge
  obtain ⟨r, x, ⟨s, hsP, hs⟩, hind⟩ :=
    s1 S N (Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R))
  have hann : ¬ Module.annihilator S (N ⧸ Submodule.span S (Set.range x)) ≤
      Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) := by
    intro h
    apply hsP
    apply h
    rw [Module.mem_annihilator]
    intro c
    induction c using Submodule.Quotient.induction_on with
    | H n =>
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      exact hs n
  have s3 : ∀ (R A : Type u) [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A]
      [Algebra.FiniteType R A] (J : Ideal A),
      Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ≤ J → ringKrullDim (A ⧸ J) < ⊤ := by
    intro R A _ _ _ _ hft J hJ
    obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    let g : R →+* A ⧸ J := (Ideal.Quotient.mk J).comp (algebraMap R A)
    have hg : ∀ a ∈ IsLocalRing.maximalIdeal R, g a = 0 := fun a ha =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (hJ (Ideal.mem_map_of_mem _ ha))
    let g' : IsLocalRing.ResidueField R →+* A ⧸ J := Ideal.Quotient.lift _ g hg
    let X' : Fin n → A ⧸ J := fun i => Ideal.Quotient.mk J (φ (MvPolynomial.X i))
    let θ : MvPolynomial (Fin n) (IsLocalRing.ResidueField R) →+* A ⧸ J :=
      MvPolynomial.eval₂Hom g' X'
    have key : (Ideal.Quotient.mk J).comp φ.toRingHom = MvPolynomial.eval₂Hom g X' := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]
        rw [← MvPolynomial.algebraMap_eq]
        simp [g]
      · intro i
        simp [X']
    have hgg : g'.comp (IsLocalRing.residue R) = g := by
      ext a
      rfl
    have hθ : Function.Surjective θ := by
      intro y
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨p, rfl⟩ := hφ a
      refine ⟨MvPolynomial.map (IsLocalRing.residue R) p, ?_⟩
      have := RingHom.congr_fun key p
      simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom] at this
      simp only [θ, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, hgg]
      rw [← this]
      rfl
    have h1 := ringKrullDim_le_of_surjective θ hθ
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add] at h1
    have hc : ENat.card (Fin n) = (n : ℕ∞) := by simp
    rw [hc] at h1
    exact lt_of_le_of_lt h1 (WithBot.coe_lt_coe.mpr (ENat.natCast_lt_top n))
  have hfin : ringKrullDim (S ⧸ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R)) < ⊤ :=
    s3 R S _ le_rfl
  have hdim := s2 S _ _ hann hfin
  haveI : Module.Projective R (Fin r → S) :=
    Module.Projective.of_equiv (DFinsupp.linearEquivFunOnFintype (R := R) (M := fun _ : Fin r => S))
  let f : (Fin r → S) →ₗ[R] LocalizedModule Q.primeCompl N :=
    (LocalizedModule.mkLinearMap Q.primeCompl N).restrictScalars R ∘ₗ
      (Fintype.linearCombination S x).restrictScalars R
  have hf : ∀ c, f c = LocalizedModule.mk (∑ i, c i • x i) 1 := by
    intro c
    simp only [f, LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_restrictScalars,
      LocalizedModule.mkLinearMap_apply, Fintype.linearCombination_apply]
  have hsmul_map : ∀ (I : Ideal R) (a : S),
      a ∈ I • (⊤ : Submodule R S) ↔ a ∈ Ideal.map (algebraMap R S) I := by
    intro I a
    rw [Ideal.smul_top_eq_map]
    rfl
  have hmodm : ∀ c, f c ∈ IsLocalRing.maximalIdeal R •
      (⊤ : Submodule R (LocalizedModule Q.primeCompl N)) →
      c ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R (Fin r → S)) := by
    intro c hc
    rw [hf] at hc
    obtain ⟨t, htQ, ht⟩ := s5 R S N Q _ _ hc
    have hcP := hind c ⟨t, fun h => htQ (hPQ h), ht⟩
    rw [← Finset.univ_sum_single c]
    refine Submodule.sum_mem _ (fun i _ => ?_)
    have h1 : c i ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R S) :=
      (hsmul_map _ _).mpr (hcP i)
    exact Submodule.smul_top_le_comap_smul_top _ (LinearMap.single R (fun _ : Fin r => S) i) h1
  have hUI : ∀ (I : Ideal R) (c : Fin r → S), LocalizedModule.mk (∑ i, c i • x i) (1 : Q.primeCompl) ∈
      I • (⊤ : Submodule R (LocalizedModule Q.primeCompl N)) →
      ∀ i, c i ∈ Ideal.map (algebraMap R S) I := by
    intro I c hc i
    rw [← hf] at hc
    have h1 := s4 R (Fin r → S) (LocalizedModule Q.primeCompl N) f hmodm I c hc
    exact (hsmul_map _ _).mp
      (Submodule.smul_top_le_comap_smul_top I (LinearMap.proj (R := R) (φ := fun _ : Fin r => S) i) h1)
  have hC := s6 R S N Q r x hflat hUI
  refine ⟨N ⧸ Submodule.span S (Set.range x), inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, hC, hdim, ?_⟩
  apply s7 S N Q r x
  intro c hc i
  have h := hUI ⊥ c (by rw [hc]; exact Submodule.zero_mem _) i
  rwa [Ideal.map_bot, Ideal.mem_bot] at h

theorem wcpa_gf_free_of_filtration : ∀ (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M] (G : ℕ → Submodule R M), Monotone G → G 0 = ⊥ → (⨆ j, G j) = ⊤ → (∀ j, Module.Free R (↥(G (j + 1)) ⧸ Submodule.comap (G (j + 1)).subtype (G j))) → Module.Free R M :=
by
  intro R _ M _ _ G hmono h0 hsup hfree
  classical

  have s1 : ∀ (P Q : Submodule R M) (κ : Type u)
      (b : Module.Basis κ R (↥Q ⧸ Submodule.comap Q.subtype P)) (w : κ → ↥Q), P ≤ Q →
      (∀ i, Submodule.Quotient.mk (w i) = b i) →
      LinearIndependent R (fun i => P.mkQ (w i : M)) ∧
        P ⊔ Submodule.span R (Set.range (fun i => (w i : M))) = Q := by
    intro P Q κ b w hPQ hw
    constructor
    · let ψ : ↥Q →ₗ[R] M ⧸ P := P.mkQ ∘ₗ Q.subtype
      have hker : Submodule.comap Q.subtype P = LinearMap.ker ψ := by
        ext y
        simp [ψ, Submodule.Quotient.mk_eq_zero]
      let φ := (Submodule.comap Q.subtype P).liftQ ψ hker.le
      have hφ : LinearMap.ker φ = ⊥ := Submodule.ker_liftQ_eq_bot' _ _ hker
      have heq : (fun i => P.mkQ (w i : M)) = φ ∘ b := by
        funext i
        rw [Function.comp_apply, ← hw i]
        rfl
      rw [heq]
      exact b.linearIndependent.map' φ hφ
    · apply le_antisymm
      · apply sup_le hPQ
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        exact (w i).2
      · intro x hx
        let x' : ↥Q := ⟨x, hx⟩
        let c := b.repr (Submodule.Quotient.mk x')
        let y : ↥Q := Finsupp.linearCombination R w c
        have hmkw : (Submodule.comap Q.subtype P).mkQ ∘ w = b := by
          funext i; exact hw i
        have hy : (Submodule.comap Q.subtype P).mkQ y = Submodule.Quotient.mk x' := by
          show (Submodule.comap Q.subtype P).mkQ (Finsupp.linearCombination R w c) = _
          rw [Finsupp.apply_linearCombination, hmkw, b.linearCombination_repr]
        have hdiff : x' - y ∈ Submodule.comap Q.subtype P :=
          (Submodule.Quotient.eq _).mp hy.symm
        have hP : x - (y : M) ∈ P := hdiff
        have hyspan : (y : M) ∈ Submodule.span R (Set.range (fun i => (w i : M))) := by
          have e : (y : M) = Finsupp.linearCombination R (Q.subtype ∘ w) c := by
            show Q.subtype (Finsupp.linearCombination R w c) = _
            rw [Finsupp.apply_linearCombination]
          rw [e, ← Finsupp.range_linearCombination]
          exact LinearMap.mem_range_self _ c
        exact Submodule.mem_sup.mpr ⟨x - (y : M), hP, (y : M), hyspan, by abel⟩

  have hb : ∀ j, ∃ κ : Type u,
      Nonempty (Module.Basis κ R (↥(G (j + 1)) ⧸ Submodule.comap (G (j + 1)).subtype (G j))) :=
    fun j => ⟨_, ⟨(hfree j).exists_basis.some.2⟩⟩
  choose κ hκ using hb
  let b := fun j => (hκ j).some
  have hl : ∀ j (i : κ j), ∃ y : ↥(G (j + 1)), Submodule.Quotient.mk y = b j i :=
    fun j i => Submodule.Quotient.mk_surjective _ (b j i)
  choose w hw using hl
  let ι := Σ j, κ j
  let f : ι → M := fun x => (w x.1 x.2 : M)
  let S : ℕ → Set ι := fun n => {x | x.1 < n}
  have key : ∀ n, LinearIndepOn R f (S n) ∧ Submodule.span R (f '' S n) = G n := by
    intro n
    induction n with
    | zero =>
      have hS : S 0 = ∅ := by
        ext x; simp [S]
      rw [hS, Set.image_empty, Submodule.span_empty, h0]
      exact ⟨linearIndepOn_empty R f, rfl⟩
    | succ n ih =>
      have hS : S (n + 1) = S n ∪ Set.range (Sigma.mk n : κ n → ι) := by
        ext ⟨j, i⟩
        simp only [S, Set.mem_setOf_eq, Set.mem_union, Set.mem_range]
        constructor
        · intro h
          rcases Nat.lt_succ_iff_lt_or_eq.mp h with h | h
          · exact Or.inl h
          · subst h; exact Or.inr ⟨i, rfl⟩
        · rintro (h | ⟨i', hi'⟩)
          · omega
          · have := congrArg Sigma.fst hi'
            simp only at this
            omega
      obtain ⟨hA, hB⟩ := s1 (G n) (G (n + 1)) (κ n) (b n) (w n) (hmono n.le_succ) (hw n)
      rw [hS]
      constructor
      · apply LinearIndepOn.union_of_quotient ih.1
        rw [ih.2, linearIndepOn_range_iff sigma_mk_injective]
        exact hA
      · rw [Set.image_union, Submodule.span_union, ih.2, ← Set.range_comp]
        exact hB
  have hSmono : Monotone S := fun a c hac x hx => lt_of_lt_of_le hx hac
  have hSU : (⋃ n, S n) = Set.univ :=
    Set.eq_univ_of_forall fun x => Set.mem_iUnion.mpr ⟨x.1 + 1, Nat.lt_succ_self _⟩
  have hli : LinearIndependent R f := by
    have := linearIndepOn_iUnion_of_directed hSmono.directed_le (fun n => (key n).1)
    rw [hSU] at this
    exact linearIndepOn_univ_iff.mp this
  have hsp : ⊤ ≤ Submodule.span R (Set.range f) := by
    rw [← hsup]
    refine iSup_le fun n => ?_
    rw [← (key n).2]
    exact Submodule.span_mono (Set.image_subset_range _ _)
  exact Module.Free.of_basis (Module.Basis.mk hli hsp)

theorem wcpa_gf_localized_filtration : ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] [Algebra A C] (M : Type u) [AddCommGroup M] [Module A M] [Module C M] [IsScalarTower A C M] (G : ℕ → Submodule C M) (a : A), Monotone G → G 0 = ⊥ → (⨆ j, G j) = ⊤ → ∃ H : ℕ → Submodule (Localization.Away a) (LocalizedModule (Submonoid.powers a) M), Monotone H ∧ H 0 = ⊥ ∧ (⨆ j, H j) = ⊤ ∧ ∀ j, Nonempty ((↥(H (j + 1)) ⧸ Submodule.comap (H (j + 1)).subtype (H j)) ≃ₗ[Localization.Away a] LocalizedModule (Submonoid.powers a) (↥(G (j + 1)) ⧸ Submodule.comap (G (j + 1)).subtype (G j))) :=
by
  intro A _ C _ _ M _ _ _ _ G a hmono h0 hsup
  classical

  have s3 : ∀ (X : Type u) [AddCommGroup X] [Module (Localization.Away a) X] (Y : Type u)
      [AddCommGroup Y] [Module (Localization.Away a) Y] (ι : X →ₗ[Localization.Away a] Y)
      (K' : Submodule (Localization.Away a) X) (H₁ K : Submodule (Localization.Away a) Y),
      Function.Injective ι → LinearMap.range ι = H₁ → (∀ x, ι x ∈ K ↔ x ∈ K') →
      Nonempty ((↥H₁ ⧸ Submodule.comap H₁.subtype K) ≃ₗ[Localization.Away a] (X ⧸ K')) := by
    intro X _ _ Y _ _ ι K' H₁ K hι hr hK
    let e : X ≃ₗ[Localization.Away a] ↥H₁ :=
      (LinearEquiv.ofInjective ι hι).trans (LinearEquiv.ofEq _ _ hr)
    have he : ∀ x, ((e x : ↥H₁) : Y) = ι x := fun x => rfl
    have hmap : Submodule.map (e : X →ₗ[Localization.Away a] ↥H₁) K' =
        Submodule.comap H₁.subtype K := by
      ext y
      rw [Submodule.mem_map_equiv, Submodule.mem_comap, Submodule.coe_subtype, ← hK, ← he,
        LinearEquiv.apply_symm_apply]
    exact ⟨(Submodule.Quotient.equiv K' _ e hmap).symm⟩

  have memL : ∀ (X : Type u) [AddCommGroup X] [Module A X] (N : Submodule A X)
      (z : LocalizedModule (Submonoid.powers a) X),
      z ∈ Submodule.localized (Submonoid.powers a) N ↔
        ∃ m ∈ N, ∃ s : Submonoid.powers a, LocalizedModule.mk m s = z := by
    intro X _ _ N z
    rw [Submodule.mem_localized']
    simp only [IsLocalizedModule.mk_eq_mk']
  refine ⟨fun j => Submodule.localized (Submonoid.powers a) ((G j).restrictScalars A),
    ?_, ?_, ?_, ?_⟩
  · intro i j hij z hz
    obtain ⟨m, hm, s, rfl⟩ := (memL M _ z).1 hz
    exact (memL M _ _).2 ⟨m, hmono hij hm, s, rfl⟩
  · show Submodule.localized' (Localization (Submonoid.powers a)) (Submonoid.powers a)
      (LocalizedModule.mkLinearMap (Submonoid.powers a) M) ((G 0).restrictScalars A) = ⊥
    rw [h0, Submodule.restrictScalars_bot, Submodule.localized'_bot]
  · show (⨆ j, Submodule.localized' (Localization (Submonoid.powers a)) (Submonoid.powers a)
      (LocalizedModule.mkLinearMap (Submonoid.powers a) M) ((G j).restrictScalars A)) = ⊤
    rw [← Submodule.localized'_iSup, ← Submodule.restrictScalars_iSup, hsup,
      Submodule.restrictScalars_top, Submodule.localized'_top]
  · intro j
    set N₁ := G (j + 1) with hN₁
    set N₀ := G j with hN₀
    let f : ↥N₁ →ₗ[A] M := N₁.subtype.restrictScalars A
    have hf : ∀ y : ↥N₁, f y = (y : M) := fun y => rfl
    let ι := LocalizedModule.map (Submonoid.powers a) f
    have hι : Function.Injective ι :=
      LocalizedModule.map_injective (Submonoid.powers a) f (fun x y hxy => Subtype.ext hxy)
    have hrange : LinearMap.range ι =
        Submodule.localized (Submonoid.powers a) (N₁.restrictScalars A) := by
      ext z
      constructor
      · rintro ⟨x, rfl⟩
        induction x using LocalizedModule.induction_on with
        | h y s =>
          rw [LocalizedModule.map_mk]
          exact (memL M _ _).2 ⟨(y : M), y.2, s, rfl⟩
      · intro hz
        obtain ⟨m, hm, s, rfl⟩ := (memL M _ z).1 hz
        exact ⟨LocalizedModule.mk ⟨m, hm⟩ s, by rw [LocalizedModule.map_mk]; rfl⟩
    have hpre : ∀ x, ι x ∈ Submodule.localized (Submonoid.powers a) (N₀.restrictScalars A) ↔
        x ∈ Submodule.localized (Submonoid.powers a)
          ((Submodule.comap N₁.subtype N₀).restrictScalars A) := by
      intro x
      induction x using LocalizedModule.induction_on with
      | h y s =>
        rw [LocalizedModule.map_mk, memL, memL]
        constructor
        · rintro ⟨g, hg, t, hgt⟩
          rw [LocalizedModule.mk_eq] at hgt
          obtain ⟨u, hu⟩ := hgt
          have hu' : (u : A) • (s : A) • g = (u : A) • (t : A) • (y : M) := by
            simpa only [Submonoid.smul_def, hf] using hu
          refine ⟨(u * t) • y, ?_, u * t * s, ?_⟩
          · show (((u * t) • y : ↥N₁) : M) ∈ N₀
            have key : (((u * t) • y : ↥N₁) : M) = (u : A) • (s : A) • g := by
              rw [hu', Submonoid.smul_def, Submonoid.coe_mul, mul_smul]
              rfl
            rw [key]
            exact (N₀.restrictScalars A).smul_mem _ ((N₀.restrictScalars A).smul_mem _ hg)
          · exact LocalizedModule.mk_cancel_common_left (u * t) s y
        · rintro ⟨m, hm, t, hmt⟩
          have := congrArg ι hmt
          simp only [ι, LocalizedModule.map_mk] at this
          exact ⟨f m, hm, t, this⟩
    obtain ⟨e₁⟩ := s3 _ _ ι _ _ _ hι hrange hpre
    have e₂ := localizedQuotientEquiv (Submonoid.powers a)
      ((Submodule.comap N₁.subtype N₀).restrictScalars A)
    have e₃ := IsLocalizedModule.mapEquiv (Submonoid.powers a)
      (LocalizedModule.mkLinearMap (Submonoid.powers a) _)
      (LocalizedModule.mkLinearMap (Submonoid.powers a) _) (Localization.Away a)
      (Submodule.Quotient.restrictScalarsEquiv A (Submodule.comap N₁.subtype N₀))
    exact ⟨e₁.trans (e₂.trans e₃)⟩

theorem wcpa_gf_monogenic_filtration : ∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (B : Type u) [CommRing B] [Algebra C B] (b : B), Algebra.adjoin C {b} = ⊤ → ∀ (M : Type u) [AddCommGroup M] [Module C M] [Module B M] [IsScalarTower C B M] [Module.Finite B M], ∃ (N : Submodule C M) (G : ℕ → Submodule C M) (K : ℕ → Submodule C ↥N) (s : ℕ), N.FG ∧ Monotone G ∧ G 0 = ⊥ ∧ (⨆ j, G j) = ⊤ ∧ (∀ j, s ≤ j → K j = K s) ∧ ∀ j, Nonempty ((↥N ⧸ K j) ≃ₗ[C] (↥(G (j + 1)) ⧸ Submodule.comap (G (j + 1)).subtype (G j))) :=
by
  intro C _ _ B _ _ b hb M _ _ _ _ _
  classical
  obtain ⟨T, hT⟩ := (Module.Finite.fg_top : (⊤ : Submodule B M).FG)
  let N : Submodule C M := Submodule.span C (T : Set M)
  let μ : ℕ → M →ₗ[C] M := fun i => DistribSMul.toLinearMap C M (b ^ i)
  have hμ : ∀ i x, μ i x = b ^ i • x := fun i x => rfl
  obtain ⟨G, hG0, hGs⟩ : ∃ G : ℕ → Submodule C M, G 0 = ⊥ ∧
      ∀ j, G (j + 1) = G j ⊔ N.map (μ j) :=
    ⟨fun j => Nat.rec ⊥ (fun i Gi => Gi ⊔ N.map (μ i)) j, rfl, fun j => rfl⟩
  have hGmono : Monotone G :=
    monotone_nat_of_le_succ (fun j => by rw [hGs j]; exact le_sup_left)
  have hshift : ∀ j, ∀ z ∈ G j, b • z ∈ G (j + 1) := by
    intro j
    induction j with
    | zero =>
      intro z hz
      rw [hG0, Submodule.mem_bot] at hz
      rw [hz, smul_zero]
      exact zero_mem _
    | succ j ih =>
      intro z hz
      rw [hGs j, Submodule.mem_sup] at hz
      obtain ⟨g, hg, w, hw, rfl⟩ := hz
      obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hw
      rw [smul_add, hGs (j + 1)]
      refine add_mem (Submodule.mem_sup_left (ih g hg)) (Submodule.mem_sup_right ?_)
      refine ⟨y, hy, ?_⟩
      rw [hμ, hμ, pow_succ', mul_smul]
  let K : ℕ → Submodule C N := fun j => Submodule.comap (μ j ∘ₗ N.subtype) (G j)
  have hKmono : Monotone K := by
    refine monotone_nat_of_le_succ (fun j y hy => ?_)
    simp only [K, Submodule.mem_comap, LinearMap.comp_apply, Submodule.subtype_apply] at hy ⊢
    have := hshift j _ hy
    rw [hμ] at this ⊢
    rw [pow_succ', mul_smul]
    exact this
  have : IsNoetherian C N := isNoetherian_of_fg_of_noetherian N ⟨T, rfl⟩
  obtain ⟨s, hs⟩ := monotone_stabilizes_iff_noetherian.mpr inferInstance ⟨K, hKmono⟩
  have hiso : ∀ j, Nonempty ((↥N ⧸ K j) ≃ₗ[C]
      (↥(G (j + 1)) ⧸ Submodule.comap (G (j + 1)).subtype (G j))) := by
    intro j
    have h : ∀ y : N, (μ j ∘ₗ N.subtype) y ∈ G (j + 1) := fun y => by
      rw [hGs j]
      exact Submodule.mem_sup_right (Submodule.mem_map_of_mem y.2)
    let g : N →ₗ[C] G (j + 1) := LinearMap.codRestrict (G (j + 1)) (μ j ∘ₗ N.subtype) h
    let φ := (Submodule.comap (G (j + 1)).subtype (G j)).mkQ ∘ₗ g
    have hsurj : Function.Surjective φ := by
      intro q
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ q
      have hz : (z : M) ∈ G j ⊔ N.map (μ j) := by rw [← hGs j]; exact z.2
      obtain ⟨p, hp, w, hw, hpw⟩ := Submodule.mem_sup.mp hz
      obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hw
      refine ⟨⟨y, hy⟩, ?_⟩
      simp only [φ, LinearMap.comp_apply, Submodule.mkQ_apply]
      rw [Submodule.Quotient.eq, Submodule.mem_comap, map_sub, Submodule.subtype_apply,
        Submodule.subtype_apply, ← hpw]
      have e : ((g ⟨y, hy⟩ : G (j + 1)) : M) = μ j y := rfl
      rw [e]
      have e2 : μ j y - (p + μ j y) = -p := by abel
      rw [e2]
      exact neg_mem hp
    have hker : LinearMap.ker φ = K j := by
      ext y
      simp only [φ, LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, K, g, Submodule.subtype_apply,
        LinearMap.codRestrict_apply]
    exact ⟨(Submodule.quotEquivOfEq _ _ hker.symm).trans
      (LinearMap.quotKerEquivOfSurjective φ hsurj)⟩
  have hP : ∀ x ∈ (⨆ j, G j), b • x ∈ (⨆ j, G j) := by
    intro x hx
    refine Submodule.iSup_induction G (motive := fun x => b • x ∈ ⨆ j, G j) hx ?_ ?_ ?_
    · intro i z hz
      exact Submodule.mem_iSup_of_mem (i + 1) (hshift i z hz)
    · rw [smul_zero]; exact zero_mem _
    · intro x y hx hy
      rw [smul_add]
      exact add_mem hx hy
  have hstab : ∀ β : B, ∀ x ∈ (⨆ j, G j), β • x ∈ (⨆ j, G j) := by
    intro β
    have hβ : β ∈ Algebra.adjoin C {b} := by rw [hb]; exact Algebra.mem_top
    induction hβ using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact hP
    | algebraMap c =>
      intro x hx
      rw [algebraMap_smul]
      exact Submodule.smul_mem _ c hx
    | add x y _ _ hx hy =>
      intro z hz
      rw [add_smul]
      exact add_mem (hx z hz) (hy z hz)
    | mul x y _ _ hx hy =>
      intro z hz
      rw [mul_smul]
      exact hx _ (hy z hz)
  have hTP : ∀ t ∈ (T : Set M), t ∈ (⨆ j, G j) := by
    intro t ht
    apply Submodule.mem_iSup_of_mem 1
    have h1 := hGs 0
    rw [zero_add] at h1
    rw [h1]
    refine Submodule.mem_sup_right ⟨t, Submodule.subset_span ht, ?_⟩
    rw [hμ, pow_zero, one_smul]
  have hsup : (⨆ j, G j) = ⊤ := by
    rw [eq_top_iff]
    intro x hx0
    clear hx0
    have hx : x ∈ Submodule.span B (T : Set M) := by rw [hT]; exact Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem x hx => exact hTP x hx
    | zero => exact zero_mem _
    | add x y _ _ hx hy => exact add_mem hx hy
    | smul a x _ hx => exact hstab a x hx
  exact ⟨N, G, K, s, ⟨T, rfl⟩, hGmono, hG0, hsup, fun j hj => (hs j hj).symm, hiso⟩

theorem wcpa_ffp_generic_free : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B] [Algebra.FiniteType A B] (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], ∃ a : A, a ≠ 0 ∧ Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) :=
by
  intro A _ _ _
  classical

  have s1 : ∀ (M : Type u) [AddCommGroup M] [Module A M] (c d : A),
      Module.Free (Localization.Away c) (LocalizedModule (Submonoid.powers c) M) →
      Module.Free (Localization.Away (c * d)) (LocalizedModule (Submonoid.powers (c * d)) M) := by
    intro M _ _ c d h
    letI : Algebra (Localization.Away c) (Localization.Away (c * d)) :=
      (IsLocalization.Away.awayToAwayRight (S := Localization.Away c) c d
        (P := Localization.Away (c * d))).toAlgebra
    haveI : IsScalarTower A (Localization.Away c) (Localization.Away (c * d)) :=
      IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.Away.awayToAwayRight_eq c d x).symm)
    have e1 : TensorProduct A (Localization.Away c) M ≃ₗ[Localization.Away c]
        LocalizedModule (Submonoid.powers c) M :=
      (IsLocalizedModule.isBaseChange (Submonoid.powers c) (Localization.Away c)
        (LocalizedModule.mkLinearMap (Submonoid.powers c) M)).equiv
    haveI : Module.Free (Localization.Away c) (TensorProduct A (Localization.Away c) M) :=
      Module.Free.of_equiv' h e1.symm
    have e2 := TensorProduct.AlgebraTensorModule.cancelBaseChange A (Localization.Away c)
      (Localization.Away (c * d)) (Localization.Away (c * d)) M
    have e3 : TensorProduct A (Localization.Away (c * d)) M ≃ₗ[Localization.Away (c * d)]
        LocalizedModule (Submonoid.powers (c * d)) M :=
      (IsLocalizedModule.isBaseChange (Submonoid.powers (c * d)) (Localization.Away (c * d))
        (LocalizedModule.mkLinearMap (Submonoid.powers (c * d)) M)).equiv
    exact Module.Free.of_equiv' (Module.Free.of_equiv' inferInstance e2) e3

  have s7 : ∀ (B : Type u) [CommRing B] [Algebra A B], (⊥ : Subalgebra A B) = ⊤ →
      ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
        [Module.Finite B M], ∃ a : A, a ≠ 0 ∧
          Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) := by
    intro B _ _ hbot M _ _ _ _ _
    haveI : Module.Finite A B := by
      refine ⟨⟨{1}, ?_⟩⟩
      rw [eq_top_iff]
      intro z _
      have hz : z ∈ (⊥ : Subalgebra A B) := hbot ▸ Algebra.mem_top
      obtain ⟨r, rfl⟩ := Algebra.mem_bot.mp hz
      rw [Finset.coe_singleton, Submodule.mem_span_singleton]
      exact ⟨r, (Algebra.algebraMap_eq_smul_one r).symm⟩
    haveI : Module.Finite A M := Module.Finite.trans B M
    haveI : Module.FinitePresentation A M := Module.finitePresentation_of_finite A M
    haveI : Module.Free (FractionRing A) (LocalizedModule (nonZeroDivisors A) M) :=
      Module.Free.of_divisionRing _ _
    obtain ⟨r, hr, hfree, -⟩ := Module.FinitePresentation.exists_free_localizedModule_powers
      (nonZeroDivisors A) (LocalizedModule.mkLinearMap (nonZeroDivisors A) M) (FractionRing A)
    exact ⟨r, nonZeroDivisors.ne_zero hr, hfree⟩

  have P : ∀ (n : ℕ) (B : Type u) [CommRing B] [Algebra A B] (x : Fin n → B),
      Algebra.adjoin A (Set.range x) = ⊤ → ∀ (M : Type u) [AddCommGroup M] [Module A M]
        [Module B M] [IsScalarTower A B M] [Module.Finite B M], ∃ a : A, a ≠ 0 ∧
          Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) := by
    intro n
    induction n with
    | zero =>
      intro B _ _ x hx M _ _ _ _ _
      apply s7 B _ M
      rw [← hx, Set.range_eq_empty, Algebra.adjoin_empty]
    | succ n ih =>
      intro B _ _ x hx M _ _ _ _ _
      set C := Algebra.adjoin A (Set.range (x ∘ Fin.castSucc)) with hCdef
      haveI : Algebra.FiniteType A C := Algebra.FiniteType.adjoin_of_finite (Set.finite_range _)
      haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing A C
      have hCb : Algebra.adjoin C {x (Fin.last n)} = ⊤ := by
        apply Subalgebra.restrictScalars_injective A
        rw [Subalgebra.restrictScalars_top, ← Algebra.adjoin_union_eq_adjoin_adjoin, ← hx]
        congr 1
        ext z
        simp only [Set.mem_union, Set.mem_range, Function.comp_apply, Set.mem_singleton_iff,
          Fin.exists_fin_succ']
        exact or_congr Iff.rfl eq_comm
      let y : Fin n → C := fun i => ⟨x (Fin.castSucc i), Algebra.subset_adjoin ⟨i, rfl⟩⟩
      have hy : Algebra.adjoin A (Set.range y) = ⊤ := by
        have : Set.range y = ((↑) : C → B) ⁻¹' Set.range (x ∘ Fin.castSucc) := by
          ext ⟨z, hz⟩
          simp only [Set.mem_range, Set.mem_preimage, Function.comp_apply]
          constructor
          · rintro ⟨i, hi⟩; exact ⟨i, congrArg Subtype.val hi⟩
          · rintro ⟨i, hi⟩; exact ⟨i, Subtype.ext hi⟩
        rw [this]
        exact Algebra.adjoin_adjoin_coe_preimage
      obtain ⟨N, G, K, s, hNfg, hGmono, hG0, hGsup, hKs, he⟩ :=
        wcpa_gf_monogenic_filtration C B (x (Fin.last n)) hCb M
      have hfree : ∀ j, ∃ a : A, a ≠ 0 ∧ Module.Free (Localization.Away a)
          (LocalizedModule (Submonoid.powers a) (↥N ⧸ K j)) := by
        intro j
        haveI : Module.Finite C N := Module.Finite.iff_fg.mpr hNfg
        exact ih C y hy (↥N ⧸ K j)
      choose α hα0 hαfree using hfree
      set a : A := ∏ i ∈ Finset.range (s + 1), α i with hadef
      have ha0 : a ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hα0 i)
      have hQfree : ∀ j, Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a)
          (↥(G (j + 1)) ⧸ Submodule.comap (G (j + 1)).subtype (G j))) := by
        intro j
        have hj' : min j s ∈ Finset.range (s + 1) :=
          Finset.mem_range.mpr (Nat.lt_succ_of_le (min_le_right _ _))
        have hKj : K j = K (min j s) := by
          rcases le_total j s with h | h
          · rw [min_eq_left h]
          · rw [min_eq_right h]; exact hKs j h
        have ha : α (min j s) * ∏ i ∈ (Finset.range (s + 1)).erase (min j s), α i = a :=
          Finset.mul_prod_erase _ _ hj'
        have h1 := s1 (↥N ⧸ K (min j s)) (α (min j s))
          (∏ i ∈ (Finset.range (s + 1)).erase (min j s), α i) (hαfree (min j s))
        rw [ha] at h1
        have h2 : Module.Free (Localization.Away a)
            (LocalizedModule (Submonoid.powers a) (↥N ⧸ K j)) := by
          rw [hKj]; exact h1
        obtain ⟨e⟩ := he j
        exact Module.Free.of_equiv' h2 (IsLocalizedModule.mapEquiv (Submonoid.powers a)
          (LocalizedModule.mkLinearMap _ _) (LocalizedModule.mkLinearMap _ _)
          (Localization.Away a) (e.restrictScalars A))
      clear_value a
      obtain ⟨H, hHmono, hH0, hHsup, hHe⟩ :=
        wcpa_gf_localized_filtration A C M G a hGmono hG0 hGsup
      refine ⟨a, ha0, wcpa_gf_free_of_filtration _ _ H hHmono hH0 hHsup ?_⟩
      intro j
      obtain ⟨e⟩ := hHe j
      haveI := hQfree j
      exact Module.Free.of_equiv e.symm
  intro B _ _ _ M _ _ _ _ _
  obtain ⟨t, ht⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A B).FG)
  have hr : Set.range (fun i => (t.equivFin.symm i : B)) = (t : Set B) := by
    ext z
    constructor
    · rintro ⟨i, rfl⟩; exact (t.equivFin.symm i).2
    · intro hz; exact ⟨t.equivFin ⟨z, hz⟩, by simp⟩
  exact P t.card B (fun i => (t.equivFin.symm i : B)) (by rw [hr]; exact ht) M

theorem wcpa_lfg_fa_flat_localize : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] (J : Ideal C), Module.Flat A (C ⧸ J) → ∀ (q : Ideal C) [q.IsPrime], Module.Flat A (Localization.AtPrime q ⧸ J.map (algebraMap C (Localization.AtPrime q))) :=
by
  intro A C _ _ _ J hflat q _
  have hL : Module.Flat A (LocalizedModule q.primeCompl (C ⧸ J)) := by
    rw [Module.Flat.iff_lTensor_preserves_injective_linearMap]
    intro P P' _ _ _ _ f hf
    set S := q.primeCompl
    set g := LocalizedModule.mkLinearMap S (C ⧸ J)
    have hP := IsLocalizedModule.rTensor (R := A) C S (N := P) g
    have hP' := IsLocalizedModule.rTensor (R := A) C S (N := P') g
    set gP := TensorProduct.AlgebraTensorModule.rTensor A P g
    set gP' := TensorProduct.AlgebraTensorModule.rTensor A P' g
    set h := TensorProduct.AlgebraTensorModule.lTensor C (C ⧸ J) f
    have hh : Function.Injective h := by
      have e : (h : TensorProduct A (C ⧸ J) P → TensorProduct A (C ⧸ J) P') =
          LinearMap.lTensor (C ⧸ J) f := by
        rw [← TensorProduct.AlgebraTensorModule.restrictScalars_lTensor (R := A) (A := C)]
        rfl
      rw [e]
      exact Module.Flat.lTensor_preserves_injective_linearMap f hf
    have hinj := IsLocalizedModule.map_injective S gP gP' h hh
    have heq : IsLocalizedModule.map S gP gP' h =
        TensorProduct.AlgebraTensorModule.lTensor C (LocalizedModule S (C ⧸ J)) f := by
      apply IsLocalizedModule.linearMap_ext S gP gP'
      rw [IsLocalizedModule.map_comp]
      apply TensorProduct.AlgebraTensorModule.ext
      intro n p
      simp [gP, gP', h]
    have e2 : (LinearMap.lTensor (LocalizedModule S (C ⧸ J)) f :
        TensorProduct A (LocalizedModule S (C ⧸ J)) P →
          TensorProduct A (LocalizedModule S (C ⧸ J)) P') =
        TensorProduct.AlgebraTensorModule.lTensor C (LocalizedModule S (C ⧸ J)) f := by
      rw [← TensorProduct.AlgebraTensorModule.restrictScalars_lTensor (R := A) (A := C)]
      rfl
    rw [e2, ← heq]
    exact hinj
  have h := @Module.Flat.of_linearEquiv A _ _ _ _ _ _ _ hL
    ((IsLocalizedModule.iso q.primeCompl (Submodule.toLocalizedQuotient' (Localization.AtPrime q)
      q.primeCompl (Algebra.linearMap C (Localization.AtPrime q)) J)).restrictScalars A).symm
  rw [← Ideal.localized'_eq_map (Localization.AtPrime q) q.primeCompl J]
  exact h

theorem wcpa_ffp_local_criterion : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], I ≠ ⊤ → Module.Flat (A ⧸ I) (TensorProduct A (A ⧸ I) M) → Function.Injective (LinearMap.rTensor M (Submodule.subtype I)) → Module.Flat A M :=
by
  intro A B _ _ _ _ _ _ _ _ I M _ _ _ _ _ hI hF hT
  classical

  have c1 : ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module (A ⧸ I) N]
      [IsScalarTower A (A ⧸ I) N] (Y : Submodule A N),
      Function.Injective (LinearMap.rTensor M Y.subtype) := by
    intro N _ _ _ _ Y
    let Z : Submodule (A ⧸ I) N :=
      { carrier := Y
        add_mem' := fun ha hb => Y.add_mem ha hb
        zero_mem' := Y.zero_mem
        smul_mem' := by
          intro c y hy
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
          have : (Ideal.Quotient.mk I a) • y = a • y := by
            rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
          rw [this]
          exact Y.smul_mem a hy }
    let e : ↥Y ≃ₗ[A] ↥Z :=
      { toFun := fun y => ⟨y, y.2⟩
        invFun := fun z => ⟨z, z.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    have hYe : Y.subtype = (Z.subtype.restrictScalars A) ∘ₗ (e : ↥Y →ₗ[A] ↥Z) := by
      ext; rfl
    let cZ := TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ I) (A ⧸ I) ↥Z M
    let cN := TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ I) (A ⧸ I) N M
    have key : ∀ w : TensorProduct A ↥Z M, LinearMap.rTensor M (Z.subtype.restrictScalars A) w =
        cN (LinearMap.rTensor (TensorProduct A (A ⧸ I) M) Z.subtype (cZ.symm w)) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul z m =>
        simp [cZ, cN, TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
          TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
      | add w₁ w₂ h₁ h₂ => rw [map_add, h₁, h₂, map_add, map_add, map_add]
    have hinjZ : Function.Injective (LinearMap.rTensor M (Z.subtype.restrictScalars A)) := by
      intro w₁ w₂ h
      rw [key, key] at h
      have h' := cN.injective h
      have h'' :=
        Module.Flat.rTensor_preserves_injective_linearMap Z.subtype Z.injective_subtype h'
      exact cZ.symm.injective h''
    rw [hYe, LinearMap.rTensor_comp]
    refine hinjZ.comp ?_
    rw [← LinearEquiv.coe_rTensor]
    exact (LinearEquiv.rTensor M e).injective

  have c2 : ∀ (S : Type u), Function.Injective (LinearMap.rTensor M
      (Submodule.subtype (I • (⊤ : Submodule A (S →₀ A))))) := by
    intro S
    let φ : (S →₀ ↥I) →ₗ[A] (S →₀ A) := Finsupp.mapRange.linearMap I.subtype
    have hφmem : ∀ g, φ g ∈ I • (⊤ : Submodule A (S →₀ A)) := by
      intro g
      induction g using Finsupp.induction_linear with
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | add f g hf hg => rw [map_add]; exact Submodule.add_mem _ hf hg
      | single s i =>
        have : φ (Finsupp.single s i) = (i : A) • Finsupp.single s (1 : A) := by
          simp [φ]
        rw [this]
        exact Submodule.smul_mem_smul i.2 trivial
    let ψ : (S →₀ ↥I) →ₗ[A] ↥(I • (⊤ : Submodule A (S →₀ A))) := φ.codRestrict _ hφmem
    have hψ : Function.Surjective ψ := by
      rintro ⟨f, hf⟩
      have : f ∈ LinearMap.range φ := by
        refine Submodule.smul_induction_on hf ?_ ?_
        · intro a ha g hg
          clear hg
          induction g using Finsupp.induction_linear with
          | zero => rw [smul_zero]; exact Submodule.zero_mem _
          | add f g hf hg => rw [smul_add]; exact Submodule.add_mem _ hf hg
          | single s r =>
            refine ⟨Finsupp.single s ⟨a * r, I.mul_mem_right r ha⟩, ?_⟩
            simp [φ]
        · intro x y hx hy
          exact Submodule.add_mem _ hx hy
      obtain ⟨g, hg⟩ := this
      exact ⟨g, Subtype.ext hg⟩
    let fl := TensorProduct.finsuppLeft A A (↥I) M S
    let fa := TensorProduct.finsuppLeft A A A M S
    have nat : ∀ w : TensorProduct A (S →₀ ↥I) M,
        fa (LinearMap.rTensor M φ w) =
          Finsupp.mapRange.linearMap (LinearMap.rTensor M I.subtype) (fl w) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul p m =>
        induction p using Finsupp.induction_linear with
        | zero => simp
        | add p q hp hq =>
          rw [TensorProduct.add_tmul, map_add, map_add, hp, hq, map_add, map_add]
        | single s i =>
          simp [φ, fa, fl, TensorProduct.finsuppLeft_apply_tmul]
      | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]
    have hφinj : Function.Injective (LinearMap.rTensor M φ) := by
      intro w₁ w₂ h
      have h1 := congrArg fa h
      rw [nat, nat] at h1
      have h2 : Function.Injective (Finsupp.mapRange.linearMap (LinearMap.rTensor M I.subtype) :
          (S →₀ TensorProduct A (↥I) M) →ₗ[A] (S →₀ TensorProduct A A M)) :=
        Finsupp.mapRange_injective _ (map_zero _) hT
      exact fl.injective (h2 h1)
    intro x y hxy
    obtain ⟨x', rfl⟩ := LinearMap.rTensor_surjective M hψ x
    obtain ⟨y', rfl⟩ := LinearMap.rTensor_surjective M hψ y
    have hcomp : (I • (⊤ : Submodule A (S →₀ A))).subtype ∘ₗ ψ = φ := by ext; rfl
    have h0 : LinearMap.rTensor M φ x' = LinearMap.rTensor M φ y' := by
      rw [← hcomp, LinearMap.rTensor_comp_apply, LinearMap.rTensor_comp_apply, hxy]
    rw [hφinj h0]

  have c3 : ∀ (F : Type u) [AddCommGroup F] [Module A F] (N Q : Submodule A F), N ≤ Q →
      Function.Injective (LinearMap.rTensor M N.subtype) →
      Function.Injective (LinearMap.rTensor M (Q.map N.mkQ).subtype) →
      Function.Injective (LinearMap.rTensor M Q.subtype) := by
    intro F _ _ N Q hNQ h1 h2
    let ρ : ↥Q →ₗ[A] ↥(Q.map N.mkQ) :=
      (N.mkQ.domRestrict Q).codRestrict (Q.map N.mkQ) (fun q => Submodule.mem_map_of_mem q.2)
    have hρ : Function.Surjective ρ := by
      rintro ⟨y, hy⟩
      obtain ⟨q, hq, rfl⟩ := Submodule.mem_map.mp hy
      exact ⟨⟨q, hq⟩, rfl⟩
    let N' := N.comap Q.subtype
    have hex : Function.Exact N'.subtype ρ := by
      intro q
      constructor
      · intro h
        have : (N.mkQ q : F ⧸ N) = 0 := congrArg Subtype.val h
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this
        exact ⟨⟨q, this⟩, rfl⟩
      · rintro ⟨n, rfl⟩
        apply Subtype.ext
        show (N.mkQ (n : F) : F ⧸ N) = 0
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact n.2
    have hex' := rTensor_exact M hex hρ
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hcomm : (Q.map N.mkQ).subtype ∘ₗ ρ = N.mkQ ∘ₗ Q.subtype := by
      ext
      rfl
    have hρx : LinearMap.rTensor M ρ x = 0 := by
      apply h2
      rw [← LinearMap.rTensor_comp_apply, hcomm, LinearMap.rTensor_comp_apply, hx, map_zero,
        map_zero]
    obtain ⟨y, rfl⟩ := (hex' x).mp hρx
    let c := Submodule.comapSubtypeEquivOfLe hNQ
    have hc : Q.subtype ∘ₗ N'.subtype = N.subtype ∘ₗ (c : N' →ₗ[A] N) := by
      ext
      rfl
    have hcy : LinearMap.rTensor M (c : N' →ₗ[A] N) y = 0 := by
      apply h1
      rw [← LinearMap.rTensor_comp_apply, ← hc, LinearMap.rTensor_comp_apply, hx, map_zero]
    have hinj : Function.Injective (LinearMap.rTensor M (c : N' →ₗ[A] N)) := by
      rw [← LinearEquiv.coe_rTensor]
      exact (LinearEquiv.rTensor M c).injective
    rw [hinj (hcy.trans (map_zero _).symm), map_zero]

  have c4 : ∀ (F P : Type u) [AddCommGroup F] [Module A F] [AddCommGroup P] [Module A P]
      (π : F →ₗ[A] P), Function.Surjective π → ∀ (Q : Submodule A P),
      Function.Injective (LinearMap.rTensor M (Q.comap π).subtype) →
      Function.Injective (LinearMap.rTensor M Q.subtype) := by
    intro F P _ _ _ _ π hπ Q h
    let Q' := Q.comap π
    let π' : ↥Q' →ₗ[A] ↥Q := (π.domRestrict Q').codRestrict Q (fun q => q.2)
    have hπ' : Function.Surjective π' := by
      rintro ⟨q, hq⟩
      obtain ⟨f, rfl⟩ := hπ q
      exact ⟨⟨f, hq⟩, rfl⟩
    have hπ'M := LinearMap.rTensor_surjective M hπ'
    have hexK : Function.Exact (LinearMap.ker π).subtype π := LinearMap.exact_subtype_ker_map π
    have hexK' := rTensor_exact M hexK hπ
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨x', rfl⟩ := hπ'M x
    have hcomm : Q.subtype ∘ₗ π' = π ∘ₗ Q'.subtype := by
      ext
      rfl
    have h1 : LinearMap.rTensor M π (LinearMap.rTensor M Q'.subtype x') = 0 := by
      rw [← LinearMap.rTensor_comp_apply, ← hcomm, LinearMap.rTensor_comp_apply, hx]
    obtain ⟨k, hk⟩ := (hexK' _).mp h1
    have hKQ : LinearMap.ker π ≤ Q' := fun f hf => by
      show π f ∈ Q
      rw [LinearMap.mem_ker.mp hf]
      exact Q.zero_mem
    let ι := Submodule.inclusion hKQ
    have hι : Q'.subtype ∘ₗ ι = (LinearMap.ker π).subtype := by
      ext
      rfl
    have h2 : x' = LinearMap.rTensor M ι k := by
      apply h
      rw [← LinearMap.rTensor_comp_apply, hι, hk]
    have h3 : π' ∘ₗ ι = 0 := by
      ext f
      exact LinearMap.mem_ker.mp f.2
    rw [h2, ← LinearMap.rTensor_comp_apply, h3, LinearMap.rTensor_zero, LinearMap.zero_apply]

  have H1 : ∀ (P : Type u) [AddCommGroup P] [Module A P] (Q : Submodule A P),
      I • (⊤ : Submodule A P) ≤ Q → Function.Injective (LinearMap.rTensor M Q.subtype) := by
    intro P _ _ Q hQ
    let π : (P →₀ A) →ₗ[A] P := Finsupp.linearCombination A (id : P → P)
    have hπ : Function.Surjective π := Finsupp.linearCombination_surjective A Function.surjective_id
    have hNQ' : I • (⊤ : Submodule A (P →₀ A)) ≤ Q.comap π := by
      rw [Submodule.smul_le]
      intro a ha f _
      show π (a • f) ∈ Q
      rw [map_smul]
      exact hQ (Submodule.smul_mem_smul ha trivial)
    apply c4 (P →₀ A) P π hπ Q
    have hY := c1 ((P →₀ A) ⧸ I • (⊤ : Submodule A (P →₀ A)))
      ((Q.comap π).map (I • (⊤ : Submodule A (P →₀ A))).mkQ)
    exact c3 (P →₀ A) (I • (⊤ : Submodule A (P →₀ A))) (Q.comap π) hNQ' (c2 P) hY

  have c5 : ∀ (n : ℕ) (P : Type u) [AddCommGroup P] [Module A P] (Q : Submodule A P),
      I ^ n • (⊤ : Submodule A P) ≤ Q → Function.Injective (LinearMap.rTensor M Q.subtype) := by
    intro n
    induction n with
    | zero =>
      intro P _ _ Q hQ
      rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul] at hQ
      have hQt : Q = ⊤ := top_le_iff.mp hQ
      subst hQt
      have : (⊤ : Submodule A P).subtype =
          ((Submodule.topEquiv : (⊤ : Submodule A P) ≃ₗ[A] P) : (⊤ : Submodule A P) →ₗ[A] P) := by
        ext; rfl
      rw [this, ← LinearEquiv.coe_rTensor]
      exact (LinearEquiv.rTensor M _).injective
    | succ n ih =>
      intro P _ _ Q hQ
      let Q₁ : Submodule A P := Q ⊔ I ^ n • ⊤
      have h1 := ih P Q₁ le_sup_right
      let Q'' := Q.comap Q₁.subtype
      have h2 := H1 ↥Q₁ Q'' (by
        rw [Submodule.smul_le]
        intro a ha z _
        show ((a • z : Q₁) : P) ∈ Q
        obtain ⟨q, hq, w, hw, hz⟩ := Submodule.mem_sup.mp z.2
        rw [Submodule.coe_smul, ← hz, smul_add]
        refine Q.add_mem (Q.smul_mem a hq) (hQ ?_)
        rw [pow_succ', Submodule.mul_smul]
        exact Submodule.smul_mem_smul ha hw)
      let c := Submodule.comapSubtypeEquivOfLe (le_sup_left : Q ≤ Q₁)
      have hc : Q.subtype ∘ₗ (c : Q'' →ₗ[A] Q) = Q₁.subtype ∘ₗ Q''.subtype := by
        ext; rfl
      intro x y hxy
      obtain ⟨x', rfl⟩ := LinearMap.rTensor_surjective M (g := (c : Q'' →ₗ[A] Q)) c.surjective x
      obtain ⟨y', rfl⟩ := LinearMap.rTensor_surjective M (g := (c : Q'' →ₗ[A] Q)) c.surjective y
      rw [← LinearMap.rTensor_comp_apply, ← LinearMap.rTensor_comp_apply, hc,
        LinearMap.rTensor_comp_apply, LinearMap.rTensor_comp_apply] at hxy
      rw [h2 (h1 hxy)]

  have c6 : ∀ (J K : Ideal A) (x : TensorProduct A J M),
      LinearMap.rTensor M (Submodule.inclusion (le_sup_left : J ≤ J ⊔ K)) x = 0 →
      x ∈ LinearMap.range (LinearMap.rTensor M (Submodule.inclusion (inf_le_left : J ⊓ K ≤ J))) := by
    intro J K x hx
    let f : ↥(J ⊓ K) →ₗ[A] ↥J × ↥K :=
      LinearMap.prod (Submodule.inclusion inf_le_left) (Submodule.inclusion inf_le_right)
    let g : ↥J × ↥K →ₗ[A] ↥(J ⊔ K) :=
      (Submodule.inclusion le_sup_left).coprod (-(Submodule.inclusion le_sup_right))
    have hg : Function.Surjective g := by
      rintro ⟨z, hz⟩
      obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hz
      refine ⟨(⟨a, ha⟩, -⟨b, hb⟩), ?_⟩
      ext
      simp [g]
    have hex : Function.Exact f g := by
      intro p
      constructor
      · intro hp
        have h0 : ((p.1 : A) - p.2) = 0 := by
          have := congrArg Subtype.val hp
          simpa [g, sub_eq_add_neg] using this
        have h1 : (p.1 : A) = p.2 := sub_eq_zero.mp h0
        refine ⟨⟨p.1, p.1.2, h1 ▸ p.2.2⟩, ?_⟩
        ext <;> simp [f, h1]
      · rintro ⟨z, rfl⟩
        ext
        simp [f, g]
    have hex' := rTensor_exact M hex hg
    have h1 : LinearMap.rTensor M g (LinearMap.rTensor M (LinearMap.inl A J K) x) = 0 := by
      rw [← LinearMap.rTensor_comp_apply]
      have : g ∘ₗ LinearMap.inl A J K = Submodule.inclusion le_sup_left := by
        ext
        simp [g]
      rw [this, hx]
    obtain ⟨z, hz⟩ := (hex' _).mp h1
    refine ⟨z, ?_⟩
    have : LinearMap.fst A J K ∘ₗ f = Submodule.inclusion inf_le_left := by
      ext
      simp [f]
    rw [← this, LinearMap.rTensor_comp_apply, hz, ← LinearMap.rTensor_comp_apply,
      LinearMap.fst_comp_inl, LinearMap.rTensor_id_apply]

  have c7 : ∀ (J : Ideal A) (x : TensorProduct A J M),
      (∀ n : ℕ, x ∈ LinearMap.range
        (LinearMap.rTensor M (Submodule.inclusion (inf_le_left : J ⊓ I ^ n ≤ J)))) →
      ∀ t : ℕ, x ∈ I ^ t • (⊤ : Submodule A (TensorProduct A J M)) := by
    intro J x hx t
    obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul I (M := A) J
    have hsub : J ⊓ I ^ (t + k) ≤ I ^ t • J := by
      have h := hk (t + k) (by omega)
      rw [Nat.add_sub_cancel] at h
      have e : I ^ (t + k) • (⊤ : Submodule A A) = I ^ (t + k) := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      rw [e] at h
      rw [inf_comm, h]
      exact Submodule.smul_mono le_rfl inf_le_right
    obtain ⟨w, rfl⟩ := hx (t + k)
    clear hx
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | tmul z m =>
      rw [LinearMap.rTensor_tmul]
      have hz : Submodule.inclusion (inf_le_left : J ⊓ I ^ (t + k) ≤ J) z ∈
          I ^ t • (⊤ : Submodule A J) := by
        rw [Submodule.mem_smul_top_iff]
        exact hsub z.2
      have : (Submodule.inclusion (inf_le_left : J ⊓ I ^ (t + k) ≤ J) z) ⊗ₜ[A] m =
          (TensorProduct.mk A J M).flip m (Submodule.inclusion inf_le_left z) := rfl
      rw [this]
      have hmap := Submodule.mem_map_of_mem (f := (TensorProduct.mk A J M).flip m) hz
      rw [Submodule.map_smul''] at hmap
      exact Submodule.smul_mono le_rfl le_top hmap
    | add w₁ w₂ h₁ h₂ => rw [map_add]; exact Submodule.add_mem _ h₁ h₂

  have c8 : ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N]
      (x : TensorProduct A M N),
      (∀ t : ℕ, x ∈ I ^ t • (⊤ : Submodule A (TensorProduct A M N))) → x = 0 := by
    intro N _ _ _ x hx
    obtain ⟨k, σ, hσ⟩ := Module.Finite.exists_fin' A N
    let L : (Fin k → M) →ₗ[B] TensorProduct A M N :=
      (TensorProduct.AlgebraTensorModule.lTensor B M σ) ∘ₗ
        (TensorProduct.piScalarRight A B M (Fin k)).symm.toLinearMap
    have hL : Function.Surjective L := by
      refine (?_ : Function.Surjective (TensorProduct.AlgebraTensorModule.lTensor B M σ)).comp
        (TensorProduct.piScalarRight A B M (Fin k)).symm.surjective
      have e : ∀ w, TensorProduct.AlgebraTensorModule.lTensor B M σ w =
          LinearMap.lTensor M σ w := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => simp
        | add a b ha hb => rw [map_add, map_add, ha, hb]
      intro y
      obtain ⟨w, hw⟩ := LinearMap.lTensor_surjective M hσ y
      exact ⟨w, (e w).trans hw⟩
    have : Module.Finite B (TensorProduct A M N) := Module.Finite.of_surjective L hL
    set 𝔞 : Ideal B := I.map (algebraMap A B) with h𝔞def
    have h𝔞 : 𝔞 ≠ ⊤ := by
      apply ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal B).ne_top
      exact (Ideal.map_mono (IsLocalRing.le_maximalIdeal hI)).trans
        (IsLocalRing.map_maximalIdeal_le (algebraMap A B))
    have hmem : ∀ t : ℕ, x ∈ 𝔞 ^ t • (⊤ : Submodule B (TensorProduct A M N)) := by
      intro t
      refine Submodule.smul_induction_on (hx t) ?_ ?_
      · intro a ha y _
        rw [← algebraMap_smul B a y]
        refine Submodule.smul_mem_smul ?_ trivial
        rw [h𝔞def, ← Ideal.map_pow]
        exact Ideal.mem_map_of_mem _ ha
      · intro y z hy hz
        exact Submodule.add_mem _ hy hz
    have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (R := B)
      (M := TensorProduct A M N) 𝔞 h𝔞
    have hx' : x ∈ ⨅ i, 𝔞 ^ i • (⊤ : Submodule B (TensorProduct A M N)) :=
      Submodule.mem_iInf _ |>.mpr hmem
    rw [hK] at hx'
    exact (Submodule.mem_bot B).mp hx'

  rw [Module.Flat.iff_rTensor_injective']
  intro J
  rw [injective_iff_map_eq_zero]
  intro x hx
  have hdie : ∀ n : ℕ,
      LinearMap.rTensor M (Submodule.inclusion (le_sup_left : J ≤ J ⊔ I ^ n)) x = 0 := by
    intro n
    have hinj := c5 n A (J ⊔ I ^ n) (by
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
      exact le_sup_right)
    apply hinj
    rw [← LinearMap.rTensor_comp_apply, Submodule.subtype_comp_inclusion, hx, map_zero]
  have hpow := c7 J x (fun n => c6 J (I ^ n) x (hdie n))
  let κ := TensorProduct.comm A J M
  have hκ : ∀ t : ℕ, κ x ∈ I ^ t • (⊤ : Submodule A (TensorProduct A M J)) := by
    intro t
    have h := Submodule.mem_map_of_mem (f := (κ : TensorProduct A J M →ₗ[A] TensorProduct A M J))
      (hpow t)
    rw [Submodule.map_smul''] at h
    exact Submodule.smul_mono le_rfl le_top h
  have h0 := c8 (↥J) (κ x) hκ
  exact κ.injective (h0.trans (map_zero κ).symm)

theorem wcpa_ffp_dn_flat_inter : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (J : Ideal B), Module.Flat A (B ⧸ J) → ∀ I : Ideal A, J ⊓ I.map (algebraMap A B) ≤ I.map (algebraMap A B) * J :=
by
  intro A B _ _ _ J hflat I x hx
  obtain ⟨hxJ, hxI⟩ := Submodule.mem_inf.mp hx
  have hxI' : x ∈ Submodule.span B (algebraMap A B '' (I : Set A)) := hxI
  obtain ⟨n, f, g, hfg⟩ := Submodule.mem_span_set'.mp hxI'
  choose a ha hag using fun i => (Set.mem_image _ _ _).mp (g i).2
  have hsmul : ∀ (c : A) (b : B), c • Ideal.Quotient.mk J b =
      Ideal.Quotient.mk J (algebraMap A B c * b) := by
    intro c b
    rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, ← map_mul]
  have hx' : x = ∑ i, algebraMap A B (a i) * f i := by
    rw [← hfg]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [smul_eq_mul, hag i, mul_comm]
  have hrel : ∑ i, a i • Ideal.Quotient.mk J (f i) = 0 := by
    simp_rw [hsmul]
    rw [← map_sum, ← hx']
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hxJ
  have htriv := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := A) (M := B ⧸ J) hrel
  unfold Module.IsTrivialRelation at htriv
  obtain ⟨k, c, y, hy, hc⟩ := htriv
  choose z hz using fun j => Ideal.Quotient.mk_surjective (I := J) (y j)
  have ht : ∀ i, f i - ∑ j, algebraMap A B (c i j) * z j ∈ J := by
    intro i
    have hyi : Ideal.Quotient.mk J (f i) = ∑ j, c i j • y j := hy i
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero, map_sum, hyi]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hz j, hsmul]
  have hzero : ∑ i, ∑ j, algebraMap A B (a i) * (algebraMap A B (c i j) * z j) = 0 := by
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    have e : ∑ i, algebraMap A B (a i) * (algebraMap A B (c i j) * z j) =
        algebraMap A B (∑ i, a i * c i j) * z j := by
      rw [map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, mul_assoc]
    rw [e, hc j, map_zero, zero_mul]
  have hx2 : x = ∑ i, algebraMap A B (a i) * (f i - ∑ j, algebraMap A B (c i j) * z j) := by
    simp_rw [mul_sub, Finset.mul_sum]
    rw [Finset.sum_sub_distrib, hzero, sub_zero, hx']
  rw [hx2]
  exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ (ha i)) (ht i))

theorem wcpa_ffp_dn_level_lift : ∀ (R : Type u) [CommRing R] (n : ℕ) (q : Ideal (MvPolynomial (Fin n) R)) [q.IsPrime] (F : Finset R) (𝔞 : Ideal (MvPolynomial (Fin n) (Subring.closure (F : Set R)))) (r : ℕ) (a : Fin r → MvPolynomial (Fin n) (Subring.closure (F : Set R))), (∀ i, ∃ w ∉ q, w * MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) (a i) ∈ 𝔞.map (MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R))) → ∃ (F' : Finset R) (hF : F ⊆ F'), ∀ i, ∃ w' ∉ q.comap (MvPolynomial.map (algebraMap (Subring.closure (F' : Set R)) R)), w' * MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr hF))) (a i) ∈ 𝔞.map (MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr hF)))) :=
by
  intro R _ n q _ F 𝔞 r a hw
  classical
  have single : ∀ (b : MvPolynomial (Fin n) (Subring.closure (F : Set R))),
      (∃ w ∉ q, w * MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) b ∈
        𝔞.map (MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R))) →
      ∃ G : Finset R, ∀ (F' : Finset R) (hF : F ⊆ F'), G ⊆ F' →
        ∃ w' ∉ q.comap (MvPolynomial.map (algebraMap (Subring.closure (F' : Set R)) R)),
          w' * MvPolynomial.map (Subring.inclusion (Subring.closure_mono
            (Finset.coe_subset.mpr hF))) b ∈
            𝔞.map (MvPolynomial.map (Subring.inclusion (Subring.closure_mono
              (Finset.coe_subset.mpr hF)))) := by
    intro b ⟨w, hwq, hmem⟩
    have hspan : w * MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) b ∈
        Submodule.span (MvPolynomial (Fin n) R)
          (MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) '' (𝔞 : Set _)) := hmem
    obtain ⟨c, t, ht, -, hsum⟩ := (Submodule.mem_span_iff_exists_finset_subset).mp hspan
    have hg : ∀ y ∈ t, ∃ g ∈ 𝔞,
        MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) g = y := fun y hy => ht hy
    choose! g hg𝔞 hgφ using hg
    refine ⟨w.coeffs ∪ t.biUnion (fun y => (c y).coeffs), ?_⟩
    intro F' hF hG
    have hlift : ∀ p : MvPolynomial (Fin n) R, (p.coeffs : Set R) ⊆ (F' : Set R) →
        ∃ p', MvPolynomial.map (algebraMap (Subring.closure (F' : Set R)) R) p' = p := by
      intro p hp
      have h : p ∈ Set.range (MvPolynomial.map (algebraMap (Subring.closure (F' : Set R)) R)) :=
        MvPolynomial.mem_range_map_iff_coeffs_subset.mpr
          (fun x hx => ⟨⟨x, Subring.subset_closure (hp hx)⟩, rfl⟩)
      exact h
    have hcomp : ∀ p : MvPolynomial (Fin n) (Subring.closure (F : Set R)),
        MvPolynomial.map (algebraMap (Subring.closure (F' : Set R)) R)
        (MvPolynomial.map (Subring.inclusion (Subring.closure_mono
          (Finset.coe_subset.mpr hF))) p) =
        MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) p := by
      intro p
      rw [MvPolynomial.map_map]
      rfl
    have hinj : Function.Injective
        (MvPolynomial.map (σ := Fin n) (algebraMap (Subring.closure (F' : Set R)) R)) :=
      MvPolynomial.map_injective _ Subtype.val_injective
    obtain ⟨w', hw'⟩ := hlift w (fun x hx => hG (Finset.mem_union_left _ hx))
    have hc : ∀ y ∈ t, ∃ c', MvPolynomial.map (algebraMap (Subring.closure (F' : Set R)) R) c'
        = c y := fun y hy => hlift (c y)
          (fun x hx => hG (Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨y, hy, hx⟩)))
    choose! c' hc' using hc
    refine ⟨w', ?_, ?_⟩
    · rw [Ideal.mem_comap, hw']; exact hwq
    · have heq : w' * MvPolynomial.map (Subring.inclusion (Subring.closure_mono
            (Finset.coe_subset.mpr hF))) b =
          ∑ y ∈ t, c' y * MvPolynomial.map (Subring.inclusion (Subring.closure_mono
            (Finset.coe_subset.mpr hF))) (g y) := by
        apply hinj
        rw [map_mul, map_sum, hw', hcomp, ← hsum]
        refine Finset.sum_congr rfl (fun y hy => ?_)
        rw [map_mul, hc' y hy, hcomp, hgφ y hy, smul_eq_mul]
      rw [heq]
      exact Ideal.sum_mem _ (fun y hy => Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hg𝔞 y hy)))
  choose G hG using fun i => single (a i) (hw i)
  refine ⟨F ∪ Finset.univ.biUnion G, Finset.subset_union_left, fun i => ?_⟩
  exact hG i _ Finset.subset_union_left
    (fun x hx => Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hx⟩))

theorem wcpa_ffp_dn_tor_basechange : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] (ι : R₁ →+* R₂) (n : ℕ) (p : Ideal R₁) [p.IsPrime] (S : Set (MvPolynomial (Fin n) R₁)) (k : MvPolynomial (Fin n) R₂), k ∈ Ideal.span (MvPolynomial.map ι '' S) → k ∈ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) → ∃ u : R₁, u ∉ p ∧ MvPolynomial.C (ι u) * k ∈ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) * Ideal.span (MvPolynomial.map ι '' S) ⊔ (Ideal.span S ⊓ p.map (MvPolynomial.C : R₁ →+* MvPolynomial (Fin n) R₁)).map (MvPolynomial.map ι) :=
by
  classical

  have ident : ∀ {X : Type u} [CommRing X] (N r : ℕ) (cv cw : X) (c σ' : Fin N → X) (A : Fin N → Fin r → X) (Y : Fin r → X),
      cw * cv * ∑ l, c l * σ' l = ∑ l, (cv * (cw * c l - ∑ β, A l β * Y β)) * σ' l + ∑ β, (∑ l, σ' l * A l β) * (cv * Y β) := by
    intro X _ N r cv cw c σ' A Y
    have e1 : ∑ β, (∑ l, σ' l * A l β) * (cv * Y β) = ∑ l, (cv * ∑ β, A l β * Y β) * σ' l := by
      simp only [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun β _ => ?_))
      ring
    rw [e1, ← Finset.sum_add_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    ring

  have s5 : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] (ι : R₁ →+* R₂) (n : ℕ) (p : Ideal R₁) (S : Set (MvPolynomial (Fin n) R₁)) (N r : ℕ) (σ : Fin N → MvPolynomial (Fin n) R₁) (c : Fin N → MvPolynomial (Fin n) R₂) (α : Fin N → Fin r → MvPolynomial (Fin n) R₁) (y : Fin r → R₂) (w v : R₁), (∀ l, σ l ∈ S) → (∀ l, MvPolynomial.C (ι v) * (MvPolynomial.C (ι w) * c l - ∑ β, MvPolynomial.map ι (α l β) * MvPolynomial.C (y β)) ∈ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι)) → (∀ β, ∑ l, σ l * α l β ∈ p.map (MvPolynomial.C : R₁ →+* MvPolynomial (Fin n) R₁)) → MvPolynomial.C (ι (w * v)) * ∑ l, c l * MvPolynomial.map ι (σ l) ∈ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) * Ideal.span (MvPolynomial.map ι '' S) ⊔ (Ideal.span S ⊓ p.map (MvPolynomial.C : R₁ →+* MvPolynomial (Fin n) R₁)).map (MvPolynomial.map ι) := by
    intro R₁ R₂ _ _ ι n p S N r σ c α y w v hσ hB hZ
    have key := ident N r (MvPolynomial.C (ι v)) (MvPolynomial.C (ι w)) c (fun l => MvPolynomial.map ι (σ l)) (fun l β => MvPolynomial.map ι (α l β)) (fun β => MvPolynomial.C (y β))
    have e2 : ∀ β, ∑ l, MvPolynomial.map ι (σ l) * MvPolynomial.map ι (α l β) = MvPolynomial.map ι (∑ l, σ l * α l β) := by
      intro β
      rw [map_sum]
      simp only [map_mul]
    simp only [e2] at key
    rw [map_mul, map_mul, key]
    refine Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_mul (hB l) (Ideal.subset_span ⟨σ l, hσ l, rfl⟩)))) (Ideal.mem_sup_right (Ideal.sum_mem _ (fun β _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Submodule.mem_inf.mpr ⟨Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_right _ _ (Ideal.subset_span (hσ l))), hZ β⟩)))))

  have s3 : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] (ι : R₁ →+* R₂) (p : Ideal R₁) [p.IsPrime] (n N : ℕ) (Q : Fin N → MvPolynomial (Fin n) R₂), (∀ l, MvPolynomial.map ((algebraMap (R₂ ⧸ p.map ι) (Localization ((nonZeroDivisors (R₁ ⧸ p)).map (Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map)))).comp (Ideal.Quotient.mk (p.map ι))) (Q l) = 0) → ∃ u : R₁, u ∉ p ∧ ∀ l, MvPolynomial.C (ι u) * Q l ∈ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) := by
    intro R₁ R₂ _ _ ι p hp n N Q hQ
    set θ := Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map with hθ
    set M := (nonZeroDivisors (R₁ ⧸ p)).map θ with hM
    set φ₂ := (algebraMap (R₂ ⧸ p.map ι) (Localization M)).comp (Ideal.Quotient.mk (p.map ι)) with hφ₂
    have one : ∀ c : R₂, φ₂ c = 0 → ∃ u : R₁, u ∉ p ∧ ι u * c ∈ p.map ι := by
      intro c hc
      obtain ⟨⟨μ, hμ⟩, hμc⟩ := (IsLocalization.map_eq_zero_iff M (Localization M) (Ideal.Quotient.mk (p.map ι) c)).mp hc
      have hμc' : μ * Ideal.Quotient.mk (p.map ι) c = 0 := hμc
      obtain ⟨d, hd, rfl⟩ := Submonoid.mem_map.mp hμ
      obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective d
      refine ⟨u, fun hu => ?_, ?_⟩
      · exact nonZeroDivisors.ne_zero hd (Ideal.Quotient.eq_zero_iff_mem.mpr hu)
      · rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
        rw [hθ, Ideal.quotientMap_mk] at hμc'
        exact hμc'
    have many : ∀ s : Finset R₂, (∀ c ∈ s, φ₂ c = 0) → ∃ u : R₁, u ∉ p ∧ ∀ c ∈ s, ι u * c ∈ p.map ι := by
      intro s
      induction s using Finset.induction_on with
      | empty => intro _; exact ⟨1, fun h => hp.ne_top ((Ideal.eq_top_iff_one _).mpr h), by simp⟩
      | insert a s ha ih =>
        intro hs
        obtain ⟨u₁, hu₁, h₁⟩ := one a (hs a (Finset.mem_insert_self a s))
        obtain ⟨u₂, hu₂, h₂⟩ := ih (fun c hc => hs c (Finset.mem_insert_of_mem hc))
        refine ⟨u₁ * u₂, Ideal.IsPrime.mul_notMem hp hu₁ hu₂, ?_⟩
        intro c hc
        rcases Finset.mem_insert.mp hc with rfl | hc
        · rw [map_mul, mul_comm (ι u₁), mul_assoc]; exact Ideal.mul_mem_left _ _ h₁
        · rw [map_mul, mul_assoc]; exact Ideal.mul_mem_left _ _ (h₂ c hc)
    obtain ⟨u, hu, hus⟩ := many (Finset.univ.biUnion fun l => (Q l).coeffs) (by
      intro c hc
      obtain ⟨l, -, hl⟩ := Finset.mem_biUnion.mp hc
      obtain ⟨m, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hl
      have h0 := congrArg (fun P => P.coeff m) (hQ l)
      simp only [MvPolynomial.coeff_map] at h0
      exact h0.trans (by simp))
    refine ⟨u, hu, fun l => ?_⟩
    rw [← Ideal.map_map, MvPolynomial.mem_map_C_iff]
    intro m
    rw [MvPolynomial.coeff_C_mul]
    by_cases h0 : (Q l).coeff m = 0
    · rw [h0, mul_zero]; exact Ideal.zero_mem _
    · exact hus _ (Finset.mem_biUnion.mpr ⟨l, Finset.mem_univ _, MvPolynomial.coeff_mem_coeffs m h0⟩)

  have s4 : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] (ι : R₁ →+* R₂) (p : Ideal R₁) [p.IsPrime] (r : ℕ) (e : Fin r → Localization ((nonZeroDivisors (R₁ ⧸ p)).map (Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map))), ∃ s : R₁, s ∉ p ∧ ∃ y : Fin r → R₂, ∀ β, algebraMap (R₂ ⧸ p.map ι) (Localization ((nonZeroDivisors (R₁ ⧸ p)).map (Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map))) (Ideal.Quotient.mk (p.map ι) (ι s)) * e β = algebraMap (R₂ ⧸ p.map ι) (Localization ((nonZeroDivisors (R₁ ⧸ p)).map (Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map))) (Ideal.Quotient.mk (p.map ι) (y β)) := by
    intro R₁ R₂ _ _ ι p _ r e
    obtain ⟨⟨b, hb⟩, hbe⟩ := IsLocalization.exist_integer_multiples_of_finset ((nonZeroDivisors (R₁ ⧸ p)).map (Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map)) (Finset.univ.image e)
    obtain ⟨d, hd, rfl⟩ := Submonoid.mem_map.mp hb
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective d
    refine ⟨s, fun hs => nonZeroDivisors.ne_zero hd (Ideal.Quotient.eq_zero_iff_mem.mpr hs), ?_⟩
    have : ∀ β, ∃ y : R₂, algebraMap (R₂ ⧸ p.map ι) (Localization ((nonZeroDivisors (R₁ ⧸ p)).map (Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map))) (Ideal.Quotient.mk (p.map ι) y) = (Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map (Ideal.Quotient.mk p s)) • e β := by
      intro β
      obtain ⟨a, ha⟩ := hbe (e β) (Finset.mem_image_of_mem e (Finset.mem_univ β))
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective a
      exact ⟨y, ha⟩
    choose y hy using this
    refine ⟨y, fun β => ?_⟩
    rw [hy β, Algebra.smul_def, Ideal.quotientMap_mk]

  have s2 : ∀ (R₁ : Type u) [CommRing R₁] (p : Ideal R₁) [p.IsPrime] (n N r : ℕ) (F : Fin N → Fin r → MvPolynomial (Fin n) (FractionRing (R₁ ⧸ p))), ∃ u : R₁, u ∉ p ∧ ∃ α : Fin N → Fin r → MvPolynomial (Fin n) R₁, ∀ l β, MvPolynomial.map ((algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p))).comp (Ideal.Quotient.mk p)) (α l β) = MvPolynomial.C (algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p)) (Ideal.Quotient.mk p u)) * F l β := by
    intro R₁ _ p _ n N r F
    obtain ⟨⟨b, hb⟩, hbF⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors (R₁ ⧸ p)) (Finset.univ.biUnion fun l => Finset.univ.biUnion fun β => (F l β).coeffs)
    obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective b
    refine ⟨u, fun hu => nonZeroDivisors.ne_zero hb (Ideal.Quotient.eq_zero_iff_mem.mpr hu), ?_⟩
    have : ∀ l β, ∃ a : MvPolynomial (Fin n) R₁, MvPolynomial.map ((algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p))).comp (Ideal.Quotient.mk p)) a = MvPolynomial.C (algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p)) (Ideal.Quotient.mk p u)) * F l β := by
      intro l β
      have hmem : MvPolynomial.C (algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p)) (Ideal.Quotient.mk p u)) * F l β ∈ Set.range (MvPolynomial.map ((algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p))).comp (Ideal.Quotient.mk p))) := by
        rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
        intro c hc
        obtain ⟨m, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hc
        rw [MvPolynomial.coeff_C_mul]
        by_cases h0 : (F l β).coeff m = 0
        · exact ⟨0, by rw [h0, mul_zero, map_zero]⟩
        · obtain ⟨x, hx⟩ := hbF _ (Finset.mem_biUnion.mpr ⟨l, Finset.mem_univ _, Finset.mem_biUnion.mpr ⟨β, Finset.mem_univ _, MvPolynomial.coeff_mem_coeffs m h0⟩⟩)
          obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
          refine ⟨z, ?_⟩
          rw [RingHom.comp_apply, hx, Algebra.smul_def]
      exact hmem
    choose α hα using this
    exact ⟨α, hα⟩

  have s1 : ∀ (κ : Type u) [Field κ] (T : Type u) [CommRing T] (j : κ →+* T) (n N : ℕ) (g : Fin N → MvPolynomial (Fin n) κ) (h : Fin N → MvPolynomial (Fin n) T), ∑ l, MvPolynomial.map j (g l) * h l = 0 → ∃ (r : ℕ) (e : Fin r → T) (f : Fin N → Fin r → MvPolynomial (Fin n) κ), (∀ l, h l = ∑ β, MvPolynomial.map j (f l β) * MvPolynomial.C (e β)) ∧ ∀ β, ∑ l, g l * f l β = 0 := by
    intro κ _ T _ j n N g h hrel
    letI : Algebra κ T := j.toAlgebra
    set V : Submodule κ T := Submodule.span κ (↑(Finset.univ.biUnion fun l => (h l).coeffs) : Set T) with hV
    haveI : FiniteDimensional κ V := FiniteDimensional.span_finset κ _
    set b := Module.finBasis κ V with hb
    have hmem : ∀ l m, (h l).coeff m ∈ V := by
      intro l m
      by_cases h0 : (h l).coeff m = 0
      · rw [h0]; exact V.zero_mem
      · exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨l, Finset.mem_univ _, MvPolynomial.coeff_mem_coeffs m h0⟩))
    set a : Fin N → (Fin n →₀ ℕ) → Fin (Module.finrank κ V) → κ := fun l m β => b.repr ⟨(h l).coeff m, hmem l m⟩ β with ha
    set f : Fin N → Fin (Module.finrank κ V) → MvPolynomial (Fin n) κ := fun l β => ∑ m ∈ (h l).support, MvPolynomial.monomial m (a l m β) with hf
    have hcoeff : ∀ l β m, (f l β).coeff m = a l m β := by
      intro l β m
      simp only [hf, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
      rw [Finset.sum_ite_eq']
      split_ifs with hm
      · rfl
      · have h0 : (h l).coeff m = 0 := MvPolynomial.notMem_support_iff.mp hm
        have : (⟨(h l).coeff m, hmem l m⟩ : V) = 0 := Subtype.ext h0
        show (0 : κ) = b.repr ⟨(h l).coeff m, hmem l m⟩ β
        rw [this, map_zero, Finsupp.coe_zero, Pi.zero_apply]
    have hexp : ∀ x : V, (x : T) = ∑ β, j (b.repr x β) * (b β : T) := by
      intro x
      conv_lhs => rw [← b.sum_repr x]
      rw [Submodule.coe_sum]
      rfl
    have hcoeffmul : ∀ (P : MvPolynomial (Fin n) κ) (t : T) (m : Fin n →₀ ℕ), (MvPolynomial.map j P * MvPolynomial.C t).coeff m = j (P.coeff m) * t := by
      intro P t m
      rw [mul_comm, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, mul_comm]
    have hfirst : ∀ l, h l = ∑ β, MvPolynomial.map j (f l β) * MvPolynomial.C (b β : T) := by
      intro l
      ext m
      rw [MvPolynomial.coeff_sum]
      simp only [hcoeffmul, hcoeff]
      exact hexp ⟨(h l).coeff m, hmem l m⟩
    refine ⟨Module.finrank κ V, fun β => (b β : T), f, hfirst, ?_⟩
    have hsum : ∑ β, MvPolynomial.map j (∑ l, g l * f l β) * MvPolynomial.C (b β : T) = 0 := by
      refine Eq.trans ?_ hrel
      simp only [map_sum, map_mul, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [hfirst l, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun β _ => ?_)
      ring
    intro β
    ext m
    have hm : ∑ β, j ((∑ l, g l * f l β).coeff m) * (b β : T) = 0 := by
      have h0 : (∑ β, MvPolynomial.map j (∑ l, g l * f l β) * MvPolynomial.C (b β : T)).coeff m = (0 : MvPolynomial (Fin n) T).coeff m := by rw [hsum]
      rw [MvPolynomial.coeff_sum] at h0
      simp only [hcoeffmul] at h0
      exact h0.trans (by simp)
    have hV0 : ∑ β, ((∑ l, g l * f l β).coeff m) • b β = 0 := by
      apply Subtype.ext
      rw [Submodule.coe_sum, Submodule.coe_zero]
      refine Eq.trans (Finset.sum_congr rfl fun β _ => ?_) hm
      rw [Submodule.coe_smul, Algebra.smul_def]
      rfl
    exact ((Fintype.linearIndependent_iff.mp b.linearIndependent) _ hV0 β).trans (by simp)

  intro R₁ R₂ _ _ ι n p _ S k hk₁ hk₂
  set θ := Ideal.quotientMap (p.map ι) ι Ideal.le_comap_map with hθ
  set M := (nonZeroDivisors (R₁ ⧸ p)).map θ with hM
  set φ₁ : R₁ →+* FractionRing (R₁ ⧸ p) := (algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p))).comp (Ideal.Quotient.mk p) with hφ₁
  set φ₂ : R₂ →+* Localization M := (algebraMap (R₂ ⧸ p.map ι) (Localization M)).comp (Ideal.Quotient.mk (p.map ι)) with hφ₂
  set j : FractionRing (R₁ ⧸ p) →+* Localization M := IsLocalization.map (M := nonZeroDivisors (R₁ ⧸ p)) (Localization M) θ (Submonoid.le_comap_map _) with hj
  have F3 : ∀ a : R₁, j (φ₁ a) = φ₂ (ι a) := by
    intro a
    show IsLocalization.map (M := nonZeroDivisors (R₁ ⧸ p)) (Localization M) θ (Submonoid.le_comap_map _) (algebraMap (R₁ ⧸ p) (FractionRing (R₁ ⧸ p)) (Ideal.Quotient.mk p a)) = algebraMap (R₂ ⧸ p.map ι) (Localization M) (Ideal.Quotient.mk (p.map ι) (ι a))
    rw [IsLocalization.map_eq, hθ, Ideal.quotientMap_mk]
  have hcomp : φ₂.comp ι = j.comp φ₁ := RingHom.ext fun a => (F3 a).symm
  have hmapcomp : ∀ P : MvPolynomial (Fin n) R₁, MvPolynomial.map φ₂ (MvPolynomial.map ι P) = MvPolynomial.map j (MvPolynomial.map φ₁ P) := by
    intro P
    rw [MvPolynomial.map_map, MvPolynomial.map_map, hcomp]
  have F4 : ∀ P : MvPolynomial (Fin n) R₁, MvPolynomial.map φ₁ P = 0 → P ∈ p.map (MvPolynomial.C : R₁ →+* MvPolynomial (Fin n) R₁) := by
    intro P hP
    rw [MvPolynomial.mem_map_C_iff]
    intro m
    have h0 : (MvPolynomial.map φ₁ P).coeff m = 0 := by rw [hP]; simp
    rw [MvPolynomial.coeff_map] at h0
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    apply IsFractionRing.injective (R₁ ⧸ p) (FractionRing (R₁ ⧸ p))
    rw [map_zero]
    exact h0
  have F5 : ∀ P ∈ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι), MvPolynomial.map φ₂ P = 0 := by
    intro P hP
    have hle : p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) ≤ RingHom.ker (MvPolynomial.map φ₂) := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, MvPolynomial.map_C]
      have h0 : φ₂ (ι a) = 0 := by
        show algebraMap (R₂ ⧸ p.map ι) (Localization M) (Ideal.Quotient.mk (p.map ι) (ι a)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem ι ha), map_zero]
      rw [h0, map_zero]
    exact hle hP

  obtain ⟨N, c, g, hkc⟩ := Submodule.mem_span_set'.mp hk₁
  have hg : ∀ l, ∃ s ∈ S, MvPolynomial.map ι s = (g l : MvPolynomial (Fin n) R₂) := fun l => (g l).2
  choose σ hσS hσg using hg
  have hk : k = ∑ l, c l * MvPolynomial.map ι (σ l) := by
    rw [← hkc]
    simp only [smul_eq_mul, hσg]

  have hrel : ∑ l, MvPolynomial.map j (MvPolynomial.map φ₁ (σ l)) * MvPolynomial.map φ₂ (c l) = 0 := by
    have h2 : MvPolynomial.map φ₂ k = 0 := F5 k hk₂
    rw [hk, map_sum] at h2
    refine Eq.trans ?_ h2
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul, hmapcomp, mul_comm]

  obtain ⟨r, e, F, hF1, hF2⟩ := s1 _ _ j n N (fun l => MvPolynomial.map φ₁ (σ l)) (fun l => MvPolynomial.map φ₂ (c l)) hrel
  have hF1' : ∀ l, MvPolynomial.map φ₂ (c l) = ∑ β, MvPolynomial.map j (F l β) * MvPolynomial.C (e β) := hF1
  have hF2' : ∀ β, ∑ l, MvPolynomial.map φ₁ (σ l) * F l β = 0 := hF2

  obtain ⟨u₁, hu₁, α, hα⟩ := s2 R₁ p n N r F
  have hα' : ∀ l β, MvPolynomial.map φ₁ (α l β) = MvPolynomial.C (φ₁ u₁) * F l β := hα

  obtain ⟨s, hs, y, hy⟩ := s4 R₁ R₂ ι p r e
  have hy' : ∀ β, φ₂ (ι s) * e β = φ₂ (y β) := hy

  have hZ : ∀ β, ∑ l, σ l * α l β ∈ p.map (MvPolynomial.C : R₁ →+* MvPolynomial (Fin n) R₁) := by
    intro β
    apply F4
    rw [map_sum]
    simp only [map_mul, hα']
    rw [show ∑ l, MvPolynomial.map φ₁ (σ l) * (MvPolynomial.C (φ₁ u₁) * F l β) = MvPolynomial.C (φ₁ u₁) * ∑ l, MvPolynomial.map φ₁ (σ l) * F l β by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun l _ => by ring]
    rw [hF2' β, mul_zero]

  have hQ : ∀ l, MvPolynomial.map φ₂ (MvPolynomial.C (ι (u₁ * s)) * c l - ∑ β, MvPolynomial.map ι (α l β) * MvPolynomial.C (y β)) = 0 := by
    intro l
    have e1 : MvPolynomial.map φ₂ (MvPolynomial.C (ι (u₁ * s)) * c l) = MvPolynomial.C (φ₂ (ι u₁)) * MvPolynomial.C (φ₂ (ι s)) * ∑ β, MvPolynomial.map j (F l β) * MvPolynomial.C (e β) := by
      rw [map_mul (MvPolynomial.map φ₂), MvPolynomial.map_C, hF1' l, map_mul ι, map_mul φ₂, map_mul MvPolynomial.C]
    have e2 : ∀ β, MvPolynomial.map φ₂ (MvPolynomial.map ι (α l β) * MvPolynomial.C (y β)) = MvPolynomial.C (φ₂ (ι u₁)) * MvPolynomial.C (φ₂ (ι s)) * (MvPolynomial.map j (F l β) * MvPolynomial.C (e β)) := by
      intro β
      rw [map_mul (MvPolynomial.map φ₂), hmapcomp, hα', MvPolynomial.map_C, ← hy', map_mul (MvPolynomial.map j), MvPolynomial.map_C, F3, map_mul MvPolynomial.C]
      ring
    rw [map_sub, e1, map_sum]
    simp only [e2]
    rw [← Finset.mul_sum, sub_self]

  obtain ⟨u₃, hu₃, hQ3⟩ := s3 R₁ R₂ ι p n N (fun l => MvPolynomial.C (ι (u₁ * s)) * c l - ∑ β, MvPolynomial.map ι (α l β) * MvPolynomial.C (y β)) hQ

  refine ⟨u₁ * s * u₃, Ideal.IsPrime.mul_notMem ‹_› (Ideal.IsPrime.mul_notMem ‹_› hu₁ hs) hu₃, ?_⟩
  rw [hk]
  exact s5 R₁ R₂ ι n p S N r σ c α y (u₁ * s) u₃ hσS hQ3 hZ

theorem wcpa_ffp_dn_fibre_inter : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂] (ι : R₁ →+* R₂) (n : ℕ) (p : Ideal R₁) [p.IsPrime] (S : Set (MvPolynomial (Fin n) R₁)) (𝔭 : Ideal R₂) (k : MvPolynomial (Fin n) R₂), k ∈ Ideal.span (MvPolynomial.map ι '' S) ⊔ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) → k ∈ 𝔭.map (MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂) → ∃ u : R₁, u ∉ p ∧ MvPolynomial.C (ι u) * k ∈ 𝔭.map (MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂) * Ideal.span (MvPolynomial.map ι '' S) ⊔ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) :=
by
  intro R₁ R₂ _ _ ι n p _ S 𝔭 k hk₁ hk₂
  classical

  have s2 : ∀ (κ T : Type u) [Field κ] [CommRing T] (j : κ →+* T)
      (σ : Set (MvPolynomial (Fin n) κ)) (𝔞 : Ideal T),
      Ideal.span (MvPolynomial.map j '' σ) ⊓ 𝔞.map (MvPolynomial.C : T →+* MvPolynomial (Fin n) T) ≤
        𝔞.map (MvPolynomial.C : T →+* MvPolynomial (Fin n) T) *
          Ideal.span (MvPolynomial.map j '' σ) := by
    intro κ T _ _ j σ 𝔞
    set I : Ideal (MvPolynomial (Fin n) κ) := Ideal.span σ with hI
    set V : Submodule κ (MvPolynomial (Fin n) κ) := I.restrictScalars κ with hV
    obtain ⟨W, hW⟩ := Submodule.exists_isCompl V
    set pr : MvPolynomial (Fin n) κ →ₗ[κ] MvPolynomial (Fin n) κ :=
      V.subtype ∘ₗ V.projectionOnto W hW with hpr
    have hpr_mem : ∀ z, pr z ∈ I := fun z => (V.projectionOnto W hW z).2
    have hpr_fix : ∀ z ∈ I, pr z = z := by
      intro z hz
      have h := Submodule.projectionOnto_apply_left hW (⟨z, hz⟩ : V)
      exact congrArg Subtype.val h
    set jt : MvPolynomial (Fin n) κ →+* MvPolynomial (Fin n) T := MvPolynomial.map j with hjt
    set Pr : MvPolynomial (Fin n) T →ₗ[T] MvPolynomial (Fin n) T :=
      (MvPolynomial.basisMonomials (Fin n) T).constr T
        (fun e => jt (pr (MvPolynomial.monomial e 1))) with hPr
    have hPr1 : ∀ e, Pr (MvPolynomial.monomial e 1) = jt (pr (MvPolynomial.monomial e 1)) := by
      intro e
      have h := Module.Basis.constr_basis (MvPolynomial.basisMonomials (Fin n) T) T
        (fun e => jt (pr (MvPolynomial.monomial e 1))) e
      simpa only [MvPolynomial.coe_basisMonomials] using h
    have hPr_mon : ∀ e (t : T), Pr (MvPolynomial.monomial e t) =
        MvPolynomial.C t * jt (pr (MvPolynomial.monomial e 1)) := by
      intro e t
      have h : MvPolynomial.monomial e t = t • (MvPolynomial.monomial e (1 : T)) := by
        rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      rw [h, LinearMap.map_smul, hPr1, MvPolynomial.smul_eq_C_mul]
    have hc : ∀ z, Pr (jt z) = jt (pr z) := by
      intro z
      refine MvPolynomial.induction_on' z ?_ ?_
      · intro e a
        have h : MvPolynomial.monomial e a = a • (MvPolynomial.monomial e (1 : κ)) := by
          rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
        rw [hjt, MvPolynomial.map_monomial, ← hjt, hPr_mon, h, LinearMap.map_smul,
          MvPolynomial.smul_eq_C_mul, map_mul, hjt, MvPolynomial.map_C]
      · intro f g hf hg
        rw [map_add, LinearMap.map_add, hf, hg, LinearMap.map_add, map_add]
    have hd : ∀ g ∈ Ideal.span (MvPolynomial.map j '' σ), ∀ c, Pr (c * g) = c * g := by
      intro g hg
      induction hg using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨s, hs, rfl⟩ := hx
        intro c
        refine MvPolynomial.induction_on' c ?_ ?_
        · intro e t
          have key : MvPolynomial.monomial e t * MvPolynomial.map j s =
              t • jt (MvPolynomial.monomial e 1 * s) := by
            rw [MvPolynomial.smul_eq_C_mul, hjt, map_mul, MvPolynomial.map_monomial, map_one,
              ← mul_assoc, MvPolynomial.C_mul_monomial, mul_one]
          rw [key, LinearMap.map_smul, hc,
            hpr_fix _ (I.mul_mem_left _ (Ideal.subset_span hs))]
        · intro f g hf hg
          rw [add_mul, LinearMap.map_add, hf, hg]
      | zero => intro c; rw [mul_zero, LinearMap.map_zero]
      | add x y _ _ hx hy => intro c; rw [mul_add, LinearMap.map_add, hx, hy]
      | smul a x _ hx => intro c; rw [smul_eq_mul, ← mul_assoc, hx]
    have hεJ : ∀ e, jt (pr (MvPolynomial.monomial e 1)) ∈
        Ideal.span (MvPolynomial.map j '' σ) := by
      intro e
      have h : jt (pr (MvPolynomial.monomial e 1)) ∈ I.map jt := Ideal.mem_map_of_mem _ (hpr_mem _)
      rwa [hI, Ideal.map_span] at h
    have he : ∀ f ∈ 𝔞.map (MvPolynomial.C : T →+* MvPolynomial (Fin n) T),
        Pr f ∈ 𝔞.map (MvPolynomial.C : T →+* MvPolynomial (Fin n) T) *
          Ideal.span (MvPolynomial.map j '' σ) := by
      intro f hf
      rw [MvPolynomial.as_sum f, map_sum]
      refine Ideal.sum_mem _ (fun e _ => ?_)
      rw [hPr_mon]
      exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ ((MvPolynomial.mem_map_C_iff.mp hf) e)) (hεJ e)
    intro x hx
    obtain ⟨hx1, hx2⟩ := Submodule.mem_inf.mp hx
    have h := hd x hx1 1
    rw [one_mul] at h
    rw [← h]
    exact he x hx2

  set M : Submonoid R₂ := p.primeCompl.map ι with hM
  set 𝔠' : Ideal (Localization M) := (p.map ι).map (algebraMap R₂ (Localization M)) with h𝔠'
  set θ : R₂ →+* (Localization M ⧸ 𝔠') :=
    (Ideal.Quotient.mk 𝔠').comp (algebraMap R₂ (Localization M)) with hθ
  have hθι : ∀ a ∈ p, θ (ι a) = 0 := fun a ha => by
    rw [hθ, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ha)

  haveI hmax : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).IsMaximal :=
    IsLocalRing.maximalIdeal.isMaximal _
  letI : Field (Localization.AtPrime p ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime p)) :=
    Ideal.Quotient.field _
  have hle : p.primeCompl ≤ M.comap ι := Submonoid.le_comap_map _
  set ψ : Localization.AtPrime p →+* (Localization M ⧸ 𝔠') :=
    (Ideal.Quotient.mk 𝔠').comp (IsLocalization.map (Localization M) ι hle) with hψdef
  have hψ : ∀ r : R₁, ψ (algebraMap R₁ (Localization.AtPrime p) r) = θ (ι r) := by
    intro r
    rw [hψdef, RingHom.comp_apply, IsLocalization.map_eq, hθ, RingHom.comp_apply]
  have hψker : Ideal.map (algebraMap R₁ (Localization.AtPrime p)) p ≤ RingHom.ker ψ := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, hψ, hθι a ha]
  have hψ0 : ∀ a ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p), ψ a = 0 := by
    intro a ha
    rw [← Localization.AtPrime.map_eq_maximalIdeal] at ha
    exact RingHom.mem_ker.mp (hψker ha)
  set j := Ideal.Quotient.lift (IsLocalRing.maximalIdeal (Localization.AtPrime p)) ψ hψ0 with hj
  set θ₁ := (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime p))).comp
    (algebraMap R₁ (Localization.AtPrime p)) with hθ₁
  have hjθ : ∀ r, j (θ₁ r) = θ (ι r) := by
    intro r
    rw [hj, hθ₁, RingHom.comp_apply, Ideal.Quotient.lift_mk, hψ]

  set π : MvPolynomial (Fin n) R₂ →+* MvPolynomial (Fin n) (Localization M ⧸ 𝔠') :=
    MvPolynomial.map θ with hπ
  have hJ : (Ideal.span (MvPolynomial.map ι '' S)).map π =
      Ideal.span (MvPolynomial.map j '' (MvPolynomial.map θ₁ '' S)) := by
    rw [Ideal.map_span, Set.image_image, Set.image_image]
    congr 1
    apply Set.image_congr
    intro s _
    rw [hπ, MvPolynomial.map_map, MvPolynomial.map_map,
      show θ.comp ι = j.comp θ₁ from RingHom.ext fun r => (hjθ r).symm]
  have hp₂ : p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) ≤ RingHom.ker π := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, hπ, MvPolynomial.map_C, hθι a ha,
      map_zero]
  have hk₁' : π k ∈ Ideal.span (MvPolynomial.map j '' (MvPolynomial.map θ₁ '' S)) := by
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hk₁
    rw [← hyz, map_add, RingHom.mem_ker.mp (hp₂ hz), add_zero, ← hJ]
    exact Ideal.mem_map_of_mem _ hy
  have hC : (𝔭.map (MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂)).map π =
      (𝔭.map θ).map (MvPolynomial.C : (Localization M ⧸ 𝔠') →+* MvPolynomial (Fin n) _) := by
    rw [Ideal.map_map, Ideal.map_map, hπ, MvPolynomial.map_comp_C]
  have hk₂' : π k ∈ (𝔭.map θ).map
      (MvPolynomial.C : (Localization M ⧸ 𝔠') →+* MvPolynomial (Fin n) _) := by
    rw [← hC]; exact Ideal.mem_map_of_mem _ hk₂
  have hX := s2 _ _ j (MvPolynomial.map θ₁ '' S) (𝔭.map θ) (Submodule.mem_inf.mpr ⟨hk₁', hk₂'⟩)
  rw [← hC, ← hJ, ← Ideal.map_mul] at hX

  set X := 𝔭.map (MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂) *
    Ideal.span (MvPolynomial.map ι '' S) with hXdef
  set B := X ⊔ p.map ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) with hB
  letI : Algebra (MvPolynomial (Fin n) R₂) (MvPolynomial (Fin n) (Localization M)) :=
    MvPolynomial.algebraMvPolynomial
  set φ₁ : MvPolynomial (Fin n) R₂ →+* MvPolynomial (Fin n) (Localization M) :=
    MvPolynomial.map (algebraMap R₂ (Localization M)) with hφ₁
  set φ₂ : MvPolynomial (Fin n) (Localization M) →+* MvPolynomial (Fin n) (Localization M ⧸ 𝔠') :=
    MvPolynomial.map (Ideal.Quotient.mk 𝔠') with hφ₂
  have hπφ : π = φ₂.comp φ₁ := by
    apply RingHom.ext
    intro f
    rw [RingHom.comp_apply, hφ₁, hφ₂, MvPolynomial.map_map, hπ, hθ]
  have hφ₂s : Function.Surjective φ₂ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have h1 : φ₁ k ∈ Ideal.comap φ₂ ((X.map φ₁).map φ₂) := by
    rw [Ideal.mem_comap, Ideal.map_map, ← RingHom.comp_apply, ← hπφ]
    exact hX
  rw [Ideal.comap_map_of_surjective' φ₂ hφ₂s, hφ₂, MvPolynomial.ker_map, Ideal.mk_ker] at h1
  have hCB : 𝔠'.map (MvPolynomial.C : Localization M →+* MvPolynomial (Fin n) (Localization M)) ≤
      B.map φ₁ := by
    have e : (MvPolynomial.C.comp (algebraMap R₂ (Localization M))).comp ι =
        φ₁.comp ((MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂).comp ι) := by
      apply RingHom.ext
      intro r
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hφ₁,
        MvPolynomial.map_C]
    rw [h𝔠', Ideal.map_map, Ideal.map_map, e, ← Ideal.map_map]
    exact Ideal.map_mono le_sup_right
  have h3 : φ₁ k ∈ B.map φ₁ := sup_le (Ideal.map_mono le_sup_left) hCB h1
  have hAlg : algebraMap (MvPolynomial (Fin n) R₂) (MvPolynomial (Fin n) (Localization M)) = φ₁ :=
    MvPolynomial.algebraMap_def
  haveI : IsLocalization (M.map (MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂))
      (MvPolynomial (Fin n) (Localization M)) := MvPolynomial.isLocalization M (Localization M)
  rw [← hAlg] at h3
  obtain ⟨m, hm, hmk⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
    (M.map (MvPolynomial.C : R₂ →+* MvPolynomial (Fin n) R₂))
    (MvPolynomial (Fin n) (Localization M)) B k).mp h3
  obtain ⟨m', hm', rfl⟩ := Submonoid.mem_map.mp hm
  obtain ⟨u, hu, rfl⟩ := Submonoid.mem_map.mp hm'
  exact ⟨u, hu, hmk⟩

theorem wcpa_ffp_dn_noeth_crit : (∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], I ≠ ⊤ → Module.Flat (A ⧸ I) (TensorProduct A (A ⧸ I) M) → Function.Injective (LinearMap.rTensor M (Submodule.subtype I)) → Module.Flat A M) → ∀ (R₀ : Type u) [CommRing R₀] [IsNoetherianRing R₀] (n : ℕ) (q₀ : Ideal (MvPolynomial (Fin n) R₀)) [q₀.IsPrime] (J₀ : Ideal (MvPolynomial (Fin n) R₀)) (I₀ : Ideal R₀), I₀ ≤ q₀.comap (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) → (∀ k ∈ J₀ ⊓ I₀.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀), ∃ v ∉ q₀, v * k ∈ I₀.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) * J₀) → (∀ k ∈ (J₀ ⊔ I₀.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀)) ⊓ (q₀.comap (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀)).map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀), ∃ v ∉ q₀, v * k ∈ (q₀.comap (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀)).map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) * J₀ ⊔ I₀.map (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀)) → Module.Flat R₀ (Localization.AtPrime q₀ ⧸ J₀.map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀))) :=
by

  have s1 : ∀ (P : Type u) [CommRing P] (q : Ideal P) [q.IsPrime] (J I 𝔭 : Ideal P), I ≤ 𝔭 →
      (∀ k ∈ J ⊓ I, ∃ v ∉ q, v * k ∈ I * J) →
      (∀ k ∈ (J ⊔ I) ⊓ 𝔭, ∃ v ∉ q, v * k ∈ 𝔭 * J ⊔ I) →
      ∀ k ∈ J ⊓ 𝔭, ∃ v ∉ q, v * k ∈ 𝔭 * J := by
    intro P _ q hq J I 𝔭 hI h2 h3 k hk
    obtain ⟨hkJ, hk𝔭⟩ := Submodule.mem_inf.mp hk
    obtain ⟨v₁, hv₁, h1⟩ := h3 k (Submodule.mem_inf.mpr ⟨Submodule.mem_sup_left hkJ, hk𝔭⟩)
    obtain ⟨y, hy, i, hi, hyi⟩ := Submodule.mem_sup.mp h1
    have hiJ : i ∈ J := by
      have e : i = v₁ * k - y := by rw [← hyi]; ring
      have hyJ : y ∈ J := (Ideal.mul_le.mpr (fun a _ b hb => J.mul_mem_left a hb) : 𝔭 * J ≤ J) hy
      have hvk : v₁ * k ∈ J := Ideal.mul_mem_left J v₁ hkJ
      rw [e]
      exact Ideal.sub_mem J hvk hyJ
    obtain ⟨v₂, hv₂, h2'⟩ := h2 i (Submodule.mem_inf.mpr ⟨hiJ, hi⟩)
    refine ⟨v₂ * v₁, fun h => ?_, ?_⟩
    · rcases hq.mem_or_mem h with h | h
      · exact hv₂ h
      · exact hv₁ h
    · rw [mul_assoc, ← hyi, mul_add]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy) (Ideal.mul_mono_left hI h2')

  have s2 : ∀ (P : Type u) [CommRing P] (q : Ideal P) [q.IsPrime] (J 𝔭 : Ideal P),
      (∀ k ∈ J ⊓ 𝔭, ∃ v ∉ q, v * k ∈ 𝔭 * J) →
      J.map (algebraMap P (Localization.AtPrime q)) ⊓ 𝔭.map (algebraMap P (Localization.AtPrime q)) ≤
        𝔭.map (algebraMap P (Localization.AtPrime q)) * J.map (algebraMap P (Localization.AtPrime q)) := by
    intro P _ q _ J 𝔭 h z hz
    rw [← Ideal.map_mul]
    obtain ⟨hz1, hz2⟩ := Submodule.mem_inf.mp hz
    obtain ⟨⟨x₁, s₁⟩, hx₁⟩ :=
      (IsLocalization.mem_map_algebraMap_iff q.primeCompl (Localization.AtPrime q)).mp hz1
    obtain ⟨⟨x₂, s₂⟩, hx₂⟩ :=
      (IsLocalization.mem_map_algebraMap_iff q.primeCompl (Localization.AtPrime q)).mp hz2
    simp only at hx₁ hx₂
    have heq : algebraMap P (Localization.AtPrime q) ((x₁ : P) * s₂) =
        algebraMap P (Localization.AtPrime q) ((x₂ : P) * s₁) := by
      rw [map_mul, map_mul, ← hx₁, ← hx₂]; ring
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists q.primeCompl (Localization.AtPrime q)).mp heq
    have hk2 : (c : P) * s₂ * x₁ = c * s₁ * x₂ := by linear_combination hc
    have hkJ : (c : P) * s₂ * x₁ ∈ J := J.mul_mem_left _ x₁.2
    have hk𝔭 : (c : P) * s₂ * x₁ ∈ 𝔭 := by rw [hk2]; exact 𝔭.mul_mem_left _ x₂.2
    obtain ⟨v, hv, hvk⟩ := h _ (Submodule.mem_inf.mpr ⟨hkJ, hk𝔭⟩)
    have hu : v * c * s₂ * s₁ ∈ q.primeCompl :=
      q.primeCompl.mul_mem (q.primeCompl.mul_mem (q.primeCompl.mul_mem hv c.2) s₂.2) s₁.2
    have hzu : z * algebraMap P (Localization.AtPrime q) (v * c * s₂ * s₁) =
        algebraMap P (Localization.AtPrime q) (v * (c * s₂ * x₁)) := by
      have e : z * algebraMap P (Localization.AtPrime q) (v * c * s₂ * s₁) =
          algebraMap P (Localization.AtPrime q) (v * c * s₂) *
            (z * algebraMap P (Localization.AtPrime q) s₁) := by
        rw [map_mul]; ring
      rw [e, hx₁, ← map_mul]
      congr 1
      ring
    obtain ⟨w, hw⟩ := (IsLocalization.map_units (Localization.AtPrime q)
      (⟨_, hu⟩ : q.primeCompl)).exists_right_inv
    have hw' : algebraMap P (Localization.AtPrime q) (v * c * s₂ * s₁) * w = 1 := hw
    have hz' : z = algebraMap P (Localization.AtPrime q) (v * (c * s₂ * x₁)) * w := by
      rw [← hzu, mul_assoc, hw', mul_one]
    rw [hz']
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hvk)

  have s3 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
      (I : Ideal A) (J : Ideal B), J ⊓ I.map (algebraMap A B) ≤ I.map (algebraMap A B) * J →
      Function.Injective (LinearMap.rTensor (B ⧸ J) (Submodule.subtype I)) := by
    intro A B _ _ _ _ I J hJ
    let π : B →ₗ[A] B ⧸ J := (Ideal.Quotient.mkₐ A J).toLinearMap
    have hπs : Function.Surjective π := Ideal.Quotient.mkₐ_surjective A J
    let μ : TensorProduct A I B →ₗ[A] B :=
      (TensorProduct.lid A B).toLinearMap ∘ₗ LinearMap.rTensor B I.subtype
    have hμinj : Function.Injective μ := by
      have h0 := Module.Flat.rTensor_preserves_injective_linearMap (M := B) I.subtype
        Subtype.val_injective
      exact (TensorProduct.lid A B).injective.comp h0
    have hμtmul : ∀ (a : I) (b : B), μ (a ⊗ₜ b) = algebraMap A B a * b := by
      intro a b
      show TensorProduct.lid A B (LinearMap.rTensor B I.subtype (a ⊗ₜ b)) = _
      rw [LinearMap.rTensor_tmul, TensorProduct.lid_tmul, Algebra.smul_def]
      rfl
    have hnat : ∀ x : TensorProduct A I B, π (μ x) =
        TensorProduct.lid A (B ⧸ J) (LinearMap.rTensor (B ⧸ J) I.subtype
          (LinearMap.lTensor I π x)) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a b =>
        rw [hμtmul, LinearMap.lTensor_tmul, LinearMap.rTensor_tmul, TensorProduct.lid_tmul,
          ← Algebra.smul_def, map_smul]
        rfl
      | add x y hx hy => simp only [map_add, hx, hy]
    have hrange : ∀ x : TensorProduct A I B, μ x ∈ I.map (algebraMap A B) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact Ideal.zero_mem _
      | tmul a b =>
        rw [hμtmul]; exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ a.2)
      | add x y hx hy => rw [map_add]; exact Ideal.add_mem _ hx hy
    let S : Submodule A B := (LinearMap.ker (LinearMap.lTensor I π)).map μ
    have hgen : ∀ a ∈ I, ∀ j ∈ J, algebraMap A B a * j ∈ S := by
      intro a ha j hj
      refine ⟨⟨a, ha⟩ ⊗ₜ j, ?_, hμtmul _ _⟩
      have hπj : π j = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hj
      show LinearMap.lTensor I π (⟨a, ha⟩ ⊗ₜ j) = 0
      rw [LinearMap.lTensor_tmul, hπj, TensorProduct.tmul_zero]
    have hmul : ∀ y ∈ I.map (algebraMap A B), ∀ j ∈ J, y * j ∈ S := by
      intro y hy
      have hy' : y ∈ Ideal.span (algebraMap A B '' (I : Set A)) := hy
      clear hy
      induction hy' using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        exact hgen a ha
      | zero => intro j _; rw [zero_mul]; exact S.zero_mem
      | add x y _ _ hx hy =>
        intro j hj; rw [add_mul]; exact S.add_mem (hx j hj) (hy j hj)
      | smul b x _ hx =>
        intro j hj
        rw [smul_eq_mul, mul_assoc, mul_left_comm]
        exact hx _ (J.mul_mem_left b hj)
    have hIJ : ∀ x ∈ I.map (algebraMap A B) * J, x ∈ S := by
      intro x hx
      exact Submodule.mul_induction_on hx (fun y hy j hj => hmul y hy j hj)
        (fun x y hx hy => S.add_mem hx hy)
    refine (injective_iff_map_eq_zero _).mpr ?_
    intro t ht
    obtain ⟨t', rfl⟩ := LinearMap.lTensor_surjective I hπs t
    have h1 : π (μ t') = 0 := by rw [hnat, ht, map_zero]
    have h2 : μ t' ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp h1
    obtain ⟨s, hs, hseq⟩ := hIJ _ (hJ (Submodule.mem_inf.mpr ⟨h2, hrange t'⟩))
    rw [← hμinj hseq]
    exact LinearMap.mem_ker.mp hs

  intro hLC R₀ _ _ n q₀ _ J₀ I₀ hI hC1 hC2
  classical
  have hsat := s1 (MvPolynomial (Fin n) R₀) q₀ J₀ _ _ (Ideal.map_mono hI) hC1 hC2
  have hloc := s2 (MvPolynomial (Fin n) R₀) q₀ J₀ _ hsat
  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : Ideal R₀, p₀ = q₀.comap (algebraMap R₀ (MvPolynomial (Fin n) R₀)) :=
    ⟨_, rfl⟩
  haveI : p₀.IsPrime := hp₀ ▸ Ideal.IsPrime.comap _
  have h𝔭 : (q₀.comap (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀)).map
      (MvPolynomial.C : R₀ →+* MvPolynomial (Fin n) R₀) =
      p₀.map (algebraMap R₀ (MvPolynomial (Fin n) R₀)) := by
    rw [hp₀]; rfl
  rw [h𝔭] at hloc
  have hPflat : Module.Flat R₀ (MvPolynomial (Fin n) R₀) :=
    @Module.Flat.of_free _ _ _ _ _ (Module.Free.of_basis (MvPolynomial.basisMonomials (Fin n) R₀))
  have hAflat : Module.Flat R₀ (Localization.AtPrime p₀) := IsLocalization.flat _ p₀.primeCompl
  letI : Algebra (Localization.AtPrime p₀) (Localization.AtPrime q₀) :=
    (Localization.localRingHom p₀ q₀ (algebraMap R₀ (MvPolynomial (Fin n) R₀)) hp₀).toAlgebra
  haveI : IsLocalHom (algebraMap (Localization.AtPrime p₀) (Localization.AtPrime q₀)) :=
    Localization.isLocalHom_localRingHom p₀ q₀ _ hp₀
  have hφflat := RingHom.Flat.localRingHom
    (RingHom.flat_algebraMap_iff.mpr hPflat) q₀ p₀ hp₀
  haveI : Module.Flat (Localization.AtPrime p₀) (Localization.AtPrime q₀) := hφflat
  have hmap : ∀ r : R₀, algebraMap (Localization.AtPrime p₀) (Localization.AtPrime q₀)
      (algebraMap R₀ (Localization.AtPrime p₀) r) = algebraMap R₀ (Localization.AtPrime q₀) r := by
    intro r
    show Localization.localRingHom p₀ q₀ _ hp₀ (algebraMap R₀ (Localization.AtPrime p₀) r) = _
    rw [Localization.localRingHom_to_map,
      IsScalarTower.algebraMap_apply R₀ (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀) r]
  have hmax : (IsLocalRing.maximalIdeal (Localization.AtPrime p₀)).map
      (algebraMap (Localization.AtPrime p₀) (Localization.AtPrime q₀)) =
      (p₀.map (algebraMap R₀ (MvPolynomial (Fin n) R₀))).map
        (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀)) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, Ideal.map_map]
    congr 1
    ext r
    rw [RingHom.comp_apply, RingHom.comp_apply, hmap,
      IsScalarTower.algebraMap_apply R₀ (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀) r]
  rw [← hmax] at hloc
  have hinj := s3 (Localization.AtPrime p₀) (Localization.AtPrime q₀)
    (IsLocalRing.maximalIdeal (Localization.AtPrime p₀))
    (J₀.map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀))) hloc
  have hfield : Module.Flat (Localization.AtPrime p₀ ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime p₀))
      (TensorProduct (Localization.AtPrime p₀)
        (Localization.AtPrime p₀ ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime p₀))
        (Localization.AtPrime q₀ ⧸
          J₀.map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀)))) := by
    letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal (Localization.AtPrime p₀))
    exact @Module.Flat.of_free _ _ _ _ _ (Module.Free.of_divisionRing _ _)
  have hflatA := hLC (Localization.AtPrime p₀) (Localization.AtPrime q₀)
    (IsLocalRing.maximalIdeal (Localization.AtPrime p₀))
    (Localization.AtPrime q₀ ⧸
      J₀.map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀)))
    (Ideal.IsMaximal.ne_top inferInstance) hfield hinj
  haveI : IsScalarTower R₀ (Localization.AtPrime p₀) (Localization.AtPrime q₀ ⧸
      J₀.map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime q₀))) := by
    refine IsScalarTower.of_algebraMap_smul (fun r x => ?_)
    rw [← algebraMap_smul (Localization.AtPrime q₀) (algebraMap R₀ (Localization.AtPrime p₀) r) x,
      hmap, algebraMap_smul]
  exact Module.Flat.trans R₀ (Localization.AtPrime p₀) _

theorem wcpa_ffp_dn_coeff_lift : ∀ (R : Type u) [CommRing R] (n : ℕ) (s : Finset (MvPolynomial (Fin n) R)) (F : Finset R), (∀ f ∈ s, (f.coeffs : Set R) ⊆ (F : Set R)) → ∃ s₀ : Finset (MvPolynomial (Fin n) (Subring.closure (F : Set R))), MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) '' (s₀ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R)))) = (s : Set (MvPolynomial (Fin n) R)) :=
by
  intro R _ n s F hF
  classical
  have hsub : (s : Set (MvPolynomial (Fin n) R)) ⊆
      MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) '' Set.univ := by
    intro f hf
    rw [Set.image_univ]
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro c hc
    exact ⟨⟨c, Subring.subset_closure (hF f hf hc)⟩, rfl⟩
  obtain ⟨s₀, -, himg⟩ := Finset.subset_set_image_iff.mp hsub
  refine ⟨s₀, ?_⟩
  rw [← Finset.coe_image, himg]

theorem wcpa_lfg_fa_descend_ft : ∀ (R : Type u) [CommRing R] (n : ℕ) (s : Finset (MvPolynomial (Fin n) R)) (q : Ideal (MvPolynomial (Fin n) R)) [q.IsPrime], Module.Flat R (Localization.AtPrime q ⧸ (Ideal.span (↑s : Set (MvPolynomial (Fin n) R))).map (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q))) → ∃ (R₀ : Type u) (_ : CommRing R₀) (_ : Algebra.FiniteType ℤ R₀) (_ : Algebra R₀ R) (s₀ : Finset (MvPolynomial (Fin n) R₀)), Ideal.span ((MvPolynomial.map (algebraMap R₀ R)) '' (↑s₀ : Set (MvPolynomial (Fin n) R₀))) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) ∧ Module.Flat R₀ (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R))) ⧸ (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀))).map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R)))))) :=
by
  intro R _ n s q _ hflat
  classical
  have hLC := wcpa_ffp_local_criterion

  have hft : ∀ F : Finset R, Algebra.FiniteType ℤ (Subring.closure (F : Set R)) := by
    intro F
    have h1 : (Algebra.adjoin ℤ (F : Set R)).FG := Subalgebra.fg_adjoin_finset F
    rw [Algebra.adjoin_int] at h1
    have h2 := (Subalgebra.fg_iff_finiteType _).mp h1
    refine Algebra.FiniteType.equiv h2 (RingEquiv.toIntAlgEquiv ?_)
    exact
      { toFun := fun x => ⟨x.1, x.2⟩
        invFun := fun x => ⟨x.1, x.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl }

  have stepA : ∀ (A : Subring R) [IsNoetherianRing A] (SA : Finset (MvPolynomial (Fin n) A)),
      MvPolynomial.map (algebraMap A R) '' (↑SA : Set (MvPolynomial (Fin n) A)) =
        (↑s : Set (MvPolynomial (Fin n) R)) →
      ∃ (r : ℕ) (ν : Fin r → MvPolynomial (Fin n) A),
        Ideal.span (Set.range ν) = Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
          ((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) ∧
        ∀ i, ∃ w ∉ q, w * MvPolynomial.map (algebraMap A R) (ν i) ∈
          (((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) *
            Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
              (MvPolynomial.map (algebraMap A R)) := by
    intro A _ SA hSA
    set pA : Ideal A := (q.comap (MvPolynomial.map (algebraMap A R))).comap
      (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) with hpA
    have hJ : (Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
        (MvPolynomial.map (algebraMap A R)) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) := by
      rw [Ideal.map_span, hSA]
    have hI : (pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
        (MvPolynomial.map (algebraMap A R)) =
        (pA.map (algebraMap A R)).map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) := by
      rw [Ideal.map_map, Ideal.map_map, MvPolynomial.map_comp_C]
    have hIq : (pA.map (algebraMap A R)).map (algebraMap R (Localization.AtPrime q)) =
        ((pA.map (algebraMap A R)).map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R)).map
          (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)) := by
      rw [Ideal.map_map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R), ← MvPolynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_eq]
    have h1 := wcpa_ffp_dn_flat_inter R (Localization.AtPrime q) _ hflat (pA.map (algebraMap A R))
    obtain ⟨r, ν, hν⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
      (IsNoetherian.noetherian (Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
        pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)))
    refine ⟨r, ν, hν, fun i => ?_⟩
    have hνi : ν i ∈ Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
        pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) := by
      rw [← hν]; exact Submodule.subset_span ⟨i, rfl⟩
    have hmemJ : MvPolynomial.map (algebraMap A R) (ν i) ∈
        Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) := by
      rw [← hJ]; exact Ideal.mem_map_of_mem _ (Submodule.mem_inf.mp hνi).1
    have hmemI : MvPolynomial.map (algebraMap A R) (ν i) ∈
        (pA.map (algebraMap A R)).map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) := by
      rw [← hI]; exact Ideal.mem_map_of_mem _ (Submodule.mem_inf.mp hνi).2
    have hx1 : algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)
        (MvPolynomial.map (algebraMap A R) (ν i)) ∈
        (Ideal.span (↑s : Set (MvPolynomial (Fin n) R))).map
          (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)) ⊓
        (pA.map (algebraMap A R)).map (algebraMap R (Localization.AtPrime q)) := by
      refine Submodule.mem_inf.mpr ⟨Ideal.mem_map_of_mem _ hmemJ, ?_⟩
      rw [hIq]; exact Ideal.mem_map_of_mem _ hmemI
    have hx2 := h1 hx1
    rw [hIq, ← Ideal.map_mul] at hx2
    obtain ⟨m, hm, hmx⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff q.primeCompl
      (Localization.AtPrime q) _ _).mp hx2
    refine ⟨m, hm, ?_⟩
    rw [Ideal.map_mul, hI, hJ]
    exact hmx

  have stepB : ∀ (A B : Subring R) (hAB : A ≤ B), IsNoetherianRing B →
      Algebra.FiniteType ℤ B →
      ∀ (SA : Finset (MvPolynomial (Fin n) A)),
      MvPolynomial.map (algebraMap A R) '' (↑SA : Set (MvPolynomial (Fin n) A)) =
        (↑s : Set (MvPolynomial (Fin n) R)) →
      ∀ (r : ℕ) (ν : Fin r → MvPolynomial (Fin n) A),
      Ideal.span (Set.range ν) = Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
          ((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) →
      (∀ i, ∃ w' ∉ q.comap (MvPolynomial.map (algebraMap B R)),
        w' * MvPolynomial.map (Subring.inclusion hAB) (ν i) ∈
          (((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) *
            Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
              (MvPolynomial.map (Subring.inclusion hAB))) →
      ∃ (R₀ : Type u) (_ : CommRing R₀) (_ : Algebra.FiniteType ℤ R₀) (_ : Algebra R₀ R) (s₀ : Finset (MvPolynomial (Fin n) R₀)), Ideal.span ((MvPolynomial.map (algebraMap R₀ R)) '' (↑s₀ : Set (MvPolynomial (Fin n) R₀))) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) ∧ Module.Flat R₀ (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R))) ⧸ (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀))).map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R)))))) := by
    intro A B hAB hBn hBft SA hSA r ν hν hw'
    haveI := hBn
    have hcomp : (algebraMap B R).comp (Subring.inclusion hAB) = algebraMap A R := by
      ext x; rfl
    choose w' hw'q hw'mem using hw'
    haveI hq₀prime : (q.comap (MvPolynomial.map (algebraMap B R))).IsPrime := inferInstance
    set pA : Ideal A := (q.comap (MvPolynomial.map (algebraMap A R))).comap
      (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) with hpA
    set q₀ : Ideal (MvPolynomial (Fin n) B) := q.comap (MvPolynomial.map (algebraMap B R)) with hq₀
    have hC_notin : ∀ u : A, u ∉ pA → MvPolynomial.C (Subring.inclusion hAB u) ∉ q₀ := by
      intro u hu h
      apply hu
      rw [hpA, Ideal.mem_comap, Ideal.mem_comap, MvPolynomial.map_C]
      rw [hq₀, Ideal.mem_comap, MvPolynomial.map_C] at h
      exact h
    have hW_notin : (∏ i, w' i) ∉ q₀ := by
      intro h
      obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff).mp h
      exact hw'q i hi
    have hJ0 : Ideal.span (↑(SA.image (MvPolynomial.map (Subring.inclusion hAB))) :
          Set (MvPolynomial (Fin n) B)) =
        Ideal.span (MvPolynomial.map (Subring.inclusion hAB) ''
          (↑SA : Set (MvPolynomial (Fin n) A))) := by
      rw [Finset.coe_image]
    have hI0C : (pA.map (Subring.inclusion hAB)).map
          (MvPolynomial.C : B →+* MvPolynomial (Fin n) B) =
        pA.map ((MvPolynomial.C : B →+* MvPolynomial (Fin n) B).comp (Subring.inclusion hAB)) :=
      Ideal.map_map _ _
    have h𝔞 : ((pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)) *
          Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
            (MvPolynomial.map (Subring.inclusion hAB)) =
        pA.map ((MvPolynomial.C : B →+* MvPolynomial (Fin n) B).comp (Subring.inclusion hAB)) *
          Ideal.span (MvPolynomial.map (Subring.inclusion hAB) ''
            (↑SA : Set (MvPolynomial (Fin n) A))) := by
      rw [Ideal.map_mul, Ideal.map_map, MvPolynomial.map_comp_C, Ideal.map_span]
    have hgen : ∀ z ∈ Ideal.span (MvPolynomial.map (Subring.inclusion hAB) '' Set.range ν),
        (∏ i, w' i) * z ∈
          pA.map ((MvPolynomial.C : B →+* MvPolynomial (Fin n) B).comp (Subring.inclusion hAB)) *
            Ideal.span (MvPolynomial.map (Subring.inclusion hAB) ''
              (↑SA : Set (MvPolynomial (Fin n) A))) := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨_, ⟨i, rfl⟩, rfl⟩ := hx
        rw [← Finset.prod_erase_mul Finset.univ w' (Finset.mem_univ i), mul_assoc]
        refine Ideal.mul_mem_left _ _ ?_
        rw [← h𝔞]
        exact hw'mem i
      | zero => rw [mul_zero]; exact Ideal.zero_mem _
      | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
      | smul a x _ hx =>
        rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hx
    refine ⟨B, inferInstance, hBft, inferInstance,
      SA.image (MvPolynomial.map (Subring.inclusion hAB)), ?_, ?_⟩
    · have himg : MvPolynomial.map (algebraMap B R) ''
            (↑(SA.image (MvPolynomial.map (Subring.inclusion hAB))) :
              Set (MvPolynomial (Fin n) B)) = (↑s : Set (MvPolynomial (Fin n) R)) := by
        rw [Finset.coe_image, Set.image_image, ← hSA]
        apply Set.image_congr
        intro a _
        rw [MvPolynomial.map_map, hcomp]
      rw [himg]
    · refine wcpa_ffp_dn_noeth_crit hLC B n q₀ _ (pA.map (Subring.inclusion hAB)) ?_ ?_ ?_
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, Ideal.mem_comap, hq₀, Ideal.mem_comap, MvPolynomial.map_C]
        rw [hpA, Ideal.mem_comap, Ideal.mem_comap, MvPolynomial.map_C] at ha
        exact ha
      · intro k hk
        rw [hJ0, hI0C] at hk
        rw [hJ0, hI0C]
        obtain ⟨u, hu, hku⟩ := wcpa_ffp_dn_tor_basechange A B (Subring.inclusion hAB) n pA
          (↑SA : Set (MvPolynomial (Fin n) A)) k (Submodule.mem_inf.mp hk).1
          (Submodule.mem_inf.mp hk).2
        rw [← hν, Ideal.map_span] at hku
        obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hku
        refine ⟨(∏ i, w' i) * MvPolynomial.C (Subring.inclusion hAB u), fun h => ?_, ?_⟩
        · rcases hq₀prime.mem_or_mem h with h1 | h1
          · exact hW_notin h1
          · exact hC_notin u hu h1
        · rw [mul_assoc, ← hyz, mul_add]
          exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy) (hgen z hz)
      · intro k hk
        rw [hJ0, hI0C] at hk
        rw [hJ0, hI0C]
        obtain ⟨u, hu, hku⟩ := wcpa_ffp_dn_fibre_inter A B (Subring.inclusion hAB) n pA
          (↑SA : Set (MvPolynomial (Fin n) A))
          (q₀.comap (MvPolynomial.C : B →+* MvPolynomial (Fin n) B)) k
          (Submodule.mem_inf.mp hk).1 (Submodule.mem_inf.mp hk).2
        exact ⟨MvPolynomial.C (Subring.inclusion hAB u), hC_notin u hu, hku⟩

  obtain ⟨F, hFc⟩ : ∃ F : Finset R, ∀ f ∈ s, (f.coeffs : Set R) ⊆ (F : Set R) :=
    ⟨s.biUnion (fun f => f.coeffs), fun f hf c hc =>
      Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨f, hf, Finset.mem_coe.mp hc⟩)⟩
  obtain ⟨SF, hSF⟩ := wcpa_ffp_dn_coeff_lift R n s F hFc
  haveI hFn : IsNoetherianRing (Subring.closure (F : Set R)) :=
    is_noetherian_subring_closure _ F.finite_toSet
  obtain ⟨r, ν, hν, hw⟩ := stepA (Subring.closure (F : Set R)) SF hSF
  obtain ⟨F', hF, hw'⟩ := wcpa_ffp_dn_level_lift R n q F _ r ν hw
  exact stepB _ _ (Subring.closure_mono (Finset.coe_subset.mpr hF))
    (is_noetherian_subring_closure _ F'.finite_toSet) (hft F') SF hSF r ν hν hw'

theorem wcpa_lfg_fa_ft_image_closure : ∀ (A R : Type u) [CommRing A] [CommRing R] [Algebra.FiniteType ℤ A] (f : A →+* R), ∃ F : Finset R, ∀ x : A, f x ∈ Subring.closure (F : Set R) :=
by
  intro A R _ _ _ f
  classical
  obtain ⟨S, hS⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra ℤ A).FG)
  refine ⟨S.image f, fun x => ?_⟩
  have hx : x ∈ Subring.closure (S : Set A) := by
    have hxa : x ∈ Algebra.adjoin ℤ (S : Set A) := hS ▸ Algebra.mem_top
    induction hxa using Algebra.adjoin_induction with
    | mem y hy => exact Subring.subset_closure hy
    | algebraMap r =>
      rw [algebraMap_int_eq, eq_intCast]
      exact intCast_mem _ r
    | add a b _ _ ha hb => exact Subring.add_mem _ ha hb
    | mul a b _ _ ha hb => exact Subring.mul_mem _ ha hb
  have hle : Subring.closure (S : Set A) ≤
      (Subring.closure ((S.image f : Finset R) : Set R)).comap f := by
    rw [Subring.closure_le]
    intro s hs
    exact Subring.subset_closure (Finset.mem_coe.mpr (Finset.mem_image_of_mem f hs))
  exact Subring.mem_comap.mp (hle hx)

theorem wcpa_ffp_flat_base_change : ∀ (R₀ R : Type u) [CommRing R₀] [CommRing R] [Algebra R₀ R] (n : ℕ) (J₀ : Ideal (MvPolynomial (Fin n) R₀)) (g₀ : MvPolynomial (Fin n) R₀), Module.Flat R₀ (Localization.Away g₀ ⧸ J₀.map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.Away g₀))) → Module.Flat R (Localization.Away (MvPolynomial.map (algebraMap R₀ R) g₀) ⧸ (J₀.map (MvPolynomial.map (algebraMap R₀ R))).map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away (MvPolynomial.map (algebraMap R₀ R) g₀)))) :=
by
  intro R₀ R _ _ _ n J₀ g₀ hflat
  classical

  have s1 : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin n) S)
      (K : Ideal (MvPolynomial (Fin n) S)) (p : MvPolynomial (Fin n) S),
      MvPolynomial.aeval (fun i : Fin n => Ideal.Quotient.mk
          (K.map (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g)))
          (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g) (MvPolynomial.X i))) p
        = Ideal.Quotient.mk (K.map (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g)))
          (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g) p) := by
    intro S _ g K p
    have h : MvPolynomial.aeval (fun i : Fin n => Ideal.Quotient.mk
          (K.map (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g)))
          (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g) (MvPolynomial.X i)))
        = (Ideal.Quotient.mkₐ S (K.map (algebraMap (MvPolynomial (Fin n) S)
            (Localization.Away g)))).comp
          (IsScalarTower.toAlgHom S (MvPolynomial (Fin n) S) (Localization.Away g)) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [Ideal.Quotient.mkₐ_eq_mk]
    rw [h]
    simp [Ideal.Quotient.mkₐ_eq_mk]

  have s2 : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin n) S)
      (K : Ideal (MvPolynomial (Fin n) S)) (T : Type u) [CommSemiring T] [Algebra S T]
      (x : Fin n → T), IsUnit (MvPolynomial.aeval x g) → (∀ f ∈ K, MvPolynomial.aeval x f = 0) →
      ∃ φ : (Localization.Away g ⧸ K.map (algebraMap (MvPolynomial (Fin n) S)
          (Localization.Away g))) →ₐ[S] T, ∀ p : MvPolynomial (Fin n) S,
        φ (Ideal.Quotient.mk (K.map (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g)))
          (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g) p)) =
          MvPolynomial.aeval x p := by
    intro S _ g K T _ _ x hu hK
    have hunits : ∀ y : Submonoid.powers g,
        IsUnit (MvPolynomial.aeval x (y : MvPolynomial (Fin n) S)) := by
      rintro ⟨y, k, rfl⟩
      simp only [map_pow]
      exact hu.pow k
    let ψ : Localization.Away g →ₐ[S] T :=
      IsLocalization.liftAlgHom (M := Submonoid.powers g) (S := Localization.Away g)
        (f := MvPolynomial.aeval x) hunits
    have hψ : ∀ p : MvPolynomial (Fin n) S,
        ψ (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g) p) =
          MvPolynomial.aeval x p := by
      intro p
      simp only [ψ, IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    have hle : K.map (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g)) ≤
        RingHom.ker ψ := by
      rw [Ideal.map_le_iff_le_comap]
      intro f hf
      rw [Ideal.mem_comap, RingHom.mem_ker]
      rw [hψ]
      exact hK f hf
    refine ⟨Ideal.Quotient.liftₐ _ ψ (fun a ha => (RingHom.mem_ker).mp (hle ha)), fun p => ?_⟩
    exact hψ p

  have s3 : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin n) S)
      (K : Ideal (MvPolynomial (Fin n) S)) (T : Type u) [CommSemiring T] [Algebra S T]
      (φ ψ : (Localization.Away g ⧸ K.map (algebraMap (MvPolynomial (Fin n) S)
          (Localization.Away g))) →ₐ[S] T),
      (∀ i : Fin n, φ (Ideal.Quotient.mk (K.map (algebraMap (MvPolynomial (Fin n) S)
          (Localization.Away g))) (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g)
            (MvPolynomial.X i))) =
        ψ (Ideal.Quotient.mk (K.map (algebraMap (MvPolynomial (Fin n) S)
          (Localization.Away g))) (algebraMap (MvPolynomial (Fin n) S) (Localization.Away g)
            (MvPolynomial.X i)))) → φ = ψ := by
    intro S _ g K T _ _ φ ψ h
    have key : φ.comp ((Ideal.Quotient.mkₐ S _).comp
          (IsScalarTower.toAlgHom S (MvPolynomial (Fin n) S) (Localization.Away g))) =
        ψ.comp ((Ideal.Quotient.mkₐ S _).comp
          (IsScalarTower.toAlgHom S (MvPolynomial (Fin n) S) (Localization.Away g))) := by
      apply MvPolynomial.algHom_ext
      intro i
      simpa [Ideal.Quotient.mkₐ_eq_mk] using h i
    apply Ideal.Quotient.algHom_ext
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (Submonoid.powers g)
    apply RingHom.ext
    intro p
    have := AlgHom.congr_fun key p
    simpa [Ideal.Quotient.mkₐ_eq_mk] using this

  generalize hg : MvPolynomial.map (algebraMap R₀ R) g₀ = g
  generalize hJ : J₀.map (MvPolynomial.map (algebraMap R₀ R)) = J

  obtain ⟨x, hx1⟩ : ∃ x : Fin n → (Localization.Away g ⧸ J.map (algebraMap
      (MvPolynomial (Fin n) R) (Localization.Away g))), ∀ p, MvPolynomial.aeval x p =
      Ideal.Quotient.mk (J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g)))
        (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g) p) := ⟨_, s1 R g J⟩
  obtain ⟨x₀, hx₀1⟩ : ∃ x₀ : Fin n → (Localization.Away g₀ ⧸ J₀.map (algebraMap
      (MvPolynomial (Fin n) R₀) (Localization.Away g₀))), ∀ p, MvPolynomial.aeval x₀ p =
      Ideal.Quotient.mk (J₀.map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.Away g₀)))
        (algebraMap (MvPolynomial (Fin n) R₀) (Localization.Away g₀) p) := ⟨_, s1 R₀ g₀ J₀⟩
  have hxi : ∀ i, x i = Ideal.Quotient.mk (J.map (algebraMap (MvPolynomial (Fin n) R)
      (Localization.Away g))) (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g)
        (MvPolynomial.X i)) := fun i => by rw [← hx1, MvPolynomial.aeval_X]
  have hx₀i : ∀ i, x₀ i = Ideal.Quotient.mk (J₀.map (algebraMap (MvPolynomial (Fin n) R₀)
      (Localization.Away g₀))) (algebraMap (MvPolynomial (Fin n) R₀) (Localization.Away g₀)
        (MvPolynomial.X i)) := fun i => by rw [← hx₀1, MvPolynomial.aeval_X]

  have hxg : IsUnit (MvPolynomial.aeval x g₀) := by
    rw [← MvPolynomial.aeval_map_algebraMap R, hg, hx1]
    exact (IsLocalization.Away.algebraMap_isUnit g).map _
  have hxJ : ∀ f ∈ J₀, MvPolynomial.aeval x f = 0 := by
    intro f hf
    rw [← MvPolynomial.aeval_map_algebraMap R, hx1]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply Ideal.mem_map_of_mem
    rw [← hJ]
    exact Ideal.mem_map_of_mem _ hf
  obtain ⟨β, hβ⟩ := s2 R₀ g₀ J₀ _ x hxg hxJ
  have hβi : ∀ i, β (x₀ i) = x i := fun i => by rw [hx₀i, hβ, MvPolynomial.aeval_X]
  let Φ := Algebra.TensorProduct.lift (Algebra.ofId R _) β (fun _ _ => Commute.all _ _)

  have hstar : ∀ p₀ : MvPolynomial (Fin n) R₀,
      MvPolynomial.aeval (fun i => Algebra.TensorProduct.includeRight (R := R₀) (A := R) (x₀ i))
        (MvPolynomial.map (algebraMap R₀ R) p₀) =
      Algebra.TensorProduct.includeRight (R := R₀) (A := R)
        (Ideal.Quotient.mk (J₀.map (algebraMap (MvPolynomial (Fin n) R₀)
          (Localization.Away g₀))) (algebraMap (MvPolynomial (Fin n) R₀)
            (Localization.Away g₀) p₀)) := by
    intro p₀
    rw [MvPolynomial.aeval_map_algebraMap, ← hx₀1]
    exact (AlgHom.congr_fun (MvPolynomial.comp_aeval x₀
      (Algebra.TensorProduct.includeRight (R := R₀) (A := R))) p₀).symm
  have hyg : IsUnit (MvPolynomial.aeval
      (fun i => Algebra.TensorProduct.includeRight (R := R₀) (A := R) (x₀ i)) g) := by
    rw [← hg, hstar]
    exact ((IsLocalization.Away.algebraMap_isUnit g₀).map _).map _
  have hyJ : ∀ f ∈ J, MvPolynomial.aeval
      (fun i => Algebra.TensorProduct.includeRight (R := R₀) (A := R) (x₀ i)) f = 0 := by
    intro f hf
    rw [← hJ] at hf
    have hle : J₀.map (MvPolynomial.map (algebraMap R₀ R)) ≤ RingHom.ker (MvPolynomial.aeval
        (R := R) (fun i => Algebra.TensorProduct.includeRight (R := R₀) (A := R) (x₀ i))) := by
      rw [Ideal.map_le_iff_le_comap]
      intro f₀ hf₀
      rw [Ideal.mem_comap, RingHom.mem_ker, hstar,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hf₀), map_zero]
    exact hle hf
  obtain ⟨Ψ, hΨ⟩ := s2 R g J _ _ hyg hyJ
  have hΨi : ∀ i, Ψ (x i) = Algebra.TensorProduct.includeRight (R := R₀) (A := R) (x₀ i) :=
    fun i => by rw [hxi, hΨ, MvPolynomial.aeval_X]
  have h1 : Φ.comp Ψ = AlgHom.id R _ := by
    apply s3 R g J
    intro i
    rw [← hxi, AlgHom.comp_apply, hΨi, AlgHom.id_apply,
      Algebra.TensorProduct.includeRight_apply]
    simp only [Φ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    exact hβi i
  have h2 : Ψ.comp Φ = AlgHom.id R _ := by
    apply Algebra.TensorProduct.ext
    · exact Subsingleton.elim _ _
    · apply s3 R₀ g₀ J₀ (TensorProduct R₀ R (Localization.Away g₀ ⧸ J₀.map (algebraMap
        (MvPolynomial (Fin n) R₀) (Localization.Away g₀))))
      intro i
      rw [← hx₀i]
      simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, AlgHom.id_apply,
        Algebra.TensorProduct.includeRight_apply, Φ, Algebra.TensorProduct.lift_tmul, map_one,
        one_mul]
      rw [hβi, hΨi, Algebra.TensorProduct.includeRight_apply]
  let e := AlgEquiv.ofAlgHom Φ Ψ h1 h2
  haveI : Module.Flat R₀ (Localization.Away g₀ ⧸ J₀.map (algebraMap (MvPolynomial (Fin n) R₀)
      (Localization.Away g₀))) := hflat
  haveI := Module.Flat.baseChange R₀ R (Localization.Away g₀ ⧸ J₀.map (algebraMap
    (MvPolynomial (Fin n) R₀) (Localization.Away g₀)))
  exact Module.Flat.of_linearEquiv e.symm.toLinearEquiv

theorem wcpa_ffp_nagata_open : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (U : Set (PrimeSpectrum B)), StableUnderGeneralization U → (∀ P ∈ U, ∃ b : B, b ∉ P.asIdeal ∧ ∀ Q : PrimeSpectrum B, P.asIdeal ≤ Q.asIdeal → b ∉ Q.asIdeal → Q ∈ U) → IsOpen U :=
by
  intro B _ _ U hG hN
  classical
  let C : Ideal B → Prop := fun I => ∃ Z : Set (PrimeSpectrum B), IsClosed Z ∧
    ∀ Q : PrimeSpectrum B, I ≤ Q.asIdeal → (Q ∈ U ↔ Q ∉ Z)
  have hstep : ∀ I : Ideal B, (∀ J > I, C J) → C I := by
    intro I ih
    by_cases hI : I.IsPrime
    · let P : PrimeSpectrum B := ⟨I, hI⟩
      by_cases hP : P ∈ U
      · obtain ⟨b, hbI, hb⟩ := hN P hP
        have hlt : I < I ⊔ Ideal.span {b} :=
          left_lt_sup.mpr (fun h => hbI ((Ideal.span_singleton_le_iff_mem _).mp h))
        obtain ⟨Z', hZ'c, hZ'⟩ := ih _ hlt
        refine ⟨Z' ∩ PrimeSpectrum.zeroLocus {b},
          hZ'c.inter (PrimeSpectrum.isClosed_zeroLocus _), ?_⟩
        intro Q hIQ
        by_cases hbQ : b ∈ Q.asIdeal
        · have hJQ : I ⊔ Ideal.span {b} ≤ Q.asIdeal :=
            sup_le hIQ ((Ideal.span_singleton_le_iff_mem _).mpr hbQ)
          rw [hZ' Q hJQ]
          simp [PrimeSpectrum.mem_zeroLocus, hbQ]
        · have hQU : Q ∈ U := hb Q hIQ hbQ
          simp [PrimeSpectrum.mem_zeroLocus, hbQ, hQU]
      · refine ⟨Set.univ, isClosed_univ, ?_⟩
        intro Q hIQ
        simp only [Set.mem_univ, not_true_eq_false, iff_false]
        intro hQ
        have hPQ : P ≤ Q := hIQ
        exact hP (hG ((PrimeSpectrum.le_iff_specializes P Q).mp hPQ) hQ)
    · by_cases htop : I = ⊤
      · refine ⟨∅, isClosed_empty, ?_⟩
        intro Q hIQ
        rw [htop, top_le_iff] at hIQ
        exact absurd hIQ Q.isPrime.ne_top
      · have hex : ∃ x y, x * y ∈ I ∧ x ∉ I ∧ y ∉ I := by
          by_contra hcon
          push_neg at hcon
          exact hI ⟨htop, fun {x y} hxy => by
            by_contra h
            push_neg at h
            exact h.2 (hcon x y hxy h.1)⟩
        obtain ⟨x, y, hxy, hx, hy⟩ := hex
        have hlt1 : I < I ⊔ Ideal.span {x} :=
          left_lt_sup.mpr (fun h => hx ((Ideal.span_singleton_le_iff_mem _).mp h))
        have hlt2 : I < I ⊔ Ideal.span {y} :=
          left_lt_sup.mpr (fun h => hy ((Ideal.span_singleton_le_iff_mem _).mp h))
        obtain ⟨Z₁, hZ₁c, hZ₁⟩ := ih _ hlt1
        obtain ⟨Z₂, hZ₂c, hZ₂⟩ := ih _ hlt2
        refine ⟨(Z₁ ∩ PrimeSpectrum.zeroLocus {x}) ∪ (Z₂ ∩ PrimeSpectrum.zeroLocus {y}),
          (hZ₁c.inter (PrimeSpectrum.isClosed_zeroLocus _)).union
            (hZ₂c.inter (PrimeSpectrum.isClosed_zeroLocus _)), ?_⟩
        intro Q hIQ
        have h1 : x ∈ Q.asIdeal → (Q ∈ U ↔ Q ∉ Z₁) := fun hxQ =>
          hZ₁ Q (sup_le hIQ ((Ideal.span_singleton_le_iff_mem _).mpr hxQ))
        have h2 : y ∈ Q.asIdeal → (Q ∈ U ↔ Q ∉ Z₂) := fun hyQ =>
          hZ₂ Q (sup_le hIQ ((Ideal.span_singleton_le_iff_mem _).mpr hyQ))
        have hor : x ∈ Q.asIdeal ∨ y ∈ Q.asIdeal := Q.isPrime.mem_or_mem (hIQ hxy)
        simp only [Set.mem_union, Set.mem_inter_iff, PrimeSpectrum.mem_zeroLocus,
          Set.singleton_subset_iff, SetLike.mem_coe]
        by_cases hxQ : x ∈ Q.asIdeal <;> by_cases hyQ : y ∈ Q.asIdeal <;> tauto
  have hall : ∀ I, C I := fun I => IsNoetherian.induction (P := C) hstep I
  obtain ⟨Z, hZc, hZ⟩ := hall ⊥
  have hU : U = Zᶜ := Set.ext fun Q => hZ Q bot_le
  rw [hU]
  exact hZc.isOpen_compl

theorem wcpa_ffp_no_tor_open : ∀ (A : Type u) [CommRing A] (C : Type u) [CommRing C] [IsNoetherianRing C] [Algebra A C] (J P : Ideal C) [P.IsPrime] (p : Ideal A), p.FG → Module.Flat A (Localization.AtPrime P ⧸ J.map (algebraMap C (Localization.AtPrime P))) → ∃ b ∉ P, ∀ (Q : Ideal C) [Q.IsPrime], b ∉ Q → Function.Injective (LinearMap.rTensor (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) (Submodule.subtype p)) :=
by
  intro A _ C _ _ _ J P _ p hp hflat
  classical

  have hloc : ∀ (Q : Ideal C) [Q.IsPrime], IsLocalizedModule Q.primeCompl
      (IsScalarTower.toAlgHom C (C ⧸ J)
        (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q)))).toLinearMap := by
    intro Q _
    rw [isLocalizedModule_iff_isLocalization]
    have h := IsLocalization.of_surjective Q.primeCompl (Localization.AtPrime Q)
      (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q))))
      Ideal.Quotient.mk_surjective
      (by
        ext x
        rw [RingHom.comp_apply, RingHom.comp_apply,
          Ideal.Quotient.algebraMap_quotient_map_quotient])
      (by rw [Ideal.mk_ker, Ideal.mk_ker])
    first
      | exact h
      | (convert h using 2)

  have hsq : ∀ (M M' : Type u) [AddCommGroup M] [Module C M] [Module A M] [IsScalarTower A C M]
      [AddCommGroup M'] [Module C M'] [Module A M'] [IsScalarTower A C M'] (g : M →ₗ[C] M')
      (y : TensorProduct A M p),
      TensorProduct.AlgebraTensorModule.rTensor A A g (LinearMap.lTensor M p.subtype y) =
      LinearMap.lTensor M' p.subtype (TensorProduct.AlgebraTensorModule.rTensor A p g y) := by
    intro M M' _ _ _ _ _ _ _ _ g y
    induction y using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul m x => simp
    | add y z hy hz => simp only [map_add, hy, hz]

  have hlin : ∀ (M : Type u) [AddCommGroup M] [Module C M] [Module A M] [IsScalarTower A C M]
      (c : C) (y : TensorProduct A M p),
      LinearMap.lTensor M p.subtype (c • y) = c • LinearMap.lTensor M p.subtype y := by
    intro M _ _ _ _ c y
    have e : ∀ w, LinearMap.lTensor M p.subtype w =
        TensorProduct.AlgebraTensorModule.lTensor C M p.subtype w := fun w => by
      rw [TensorProduct.AlgebraTensorModule.coe_lTensor]
    rw [e, e, map_smul]

  have hto : ∀ (M M' : Type u) [AddCommGroup M] [Module C M] [Module A M] [IsScalarTower A C M]
      [AddCommGroup M'] [Module C M'] [Module A M'] [IsScalarTower A C M'] (S : Submonoid C)
      (g : M →ₗ[C] M') [IsLocalizedModule S g],
      Function.Injective (LinearMap.lTensor M' p.subtype) → ∀ y : TensorProduct A M p,
      LinearMap.lTensor M p.subtype y = 0 → ∃ s ∈ S, s • y = 0 := by
    intro M M' _ _ _ _ _ _ _ _ S g _ hinj y hy
    have h1 : LinearMap.lTensor M' p.subtype
        (TensorProduct.AlgebraTensorModule.rTensor A p g y) = 0 := by
      rw [← hsq M M' g y, hy, map_zero]
    have h2 : TensorProduct.AlgebraTensorModule.rTensor A p g y = 0 :=
      hinj (h1.trans (map_zero _).symm)
    haveI : IsLocalizedModule S (TensorProduct.AlgebraTensorModule.rTensor A p g) :=
      inferInstance
    obtain ⟨s, hs⟩ :=
      (IsLocalizedModule.eq_zero_iff S (TensorProduct.AlgebraTensorModule.rTensor A p g)).mp h2
    exact ⟨s, s.2, hs⟩

  have hfrom : ∀ (M M' : Type u) [AddCommGroup M] [Module C M] [Module A M] [IsScalarTower A C M]
      [AddCommGroup M'] [Module C M'] [Module A M'] [IsScalarTower A C M'] (S : Submonoid C)
      (g : M →ₗ[C] M') [IsLocalizedModule S g],
      (∀ y : TensorProduct A M p, LinearMap.lTensor M p.subtype y = 0 → ∃ s ∈ S, s • y = 0) →
      Function.Injective (LinearMap.lTensor M' p.subtype) := by
    intro M M' _ _ _ _ _ _ _ _ S g _ htor
    haveI : IsLocalizedModule S (TensorProduct.AlgebraTensorModule.rTensor A p g) :=
      inferInstance
    haveI : IsLocalizedModule S (TensorProduct.AlgebraTensorModule.rTensor A A g) :=
      inferInstance
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨y, s⟩, hys⟩ :=
      IsLocalizedModule.surj S (TensorProduct.AlgebraTensorModule.rTensor A p g) z
    have hz' : (s : C) • z = TensorProduct.AlgebraTensorModule.rTensor A p g y := by
      rw [← Submonoid.smul_def]; exact hys
    have h1 : TensorProduct.AlgebraTensorModule.rTensor A A g
        (LinearMap.lTensor M p.subtype y) = 0 := by
      rw [hsq M M' g y, ← hz', hlin M' (s : C) z, hz, smul_zero]
    obtain ⟨s₁, hs₁⟩ :=
      (IsLocalizedModule.eq_zero_iff S (TensorProduct.AlgebraTensorModule.rTensor A A g)).mp h1
    have h2 : LinearMap.lTensor M p.subtype ((s₁ : C) • y) = 0 := by
      rw [hlin M (s₁ : C) y, ← Submonoid.smul_def, hs₁]
    obtain ⟨s₂, hs₂S, hs₂⟩ := htor _ h2
    have h3 : (s₂ * (s₁ : C) * (s : C)) • z = 0 := by
      rw [mul_smul, hz', ← map_smul, mul_smul, hs₂, map_zero]
    have hmem : s₂ * (s₁ : C) * (s : C) ∈ S := S.mul_mem (S.mul_mem hs₂S s₁.2) s.2
    have hu := IsLocalizedModule.map_units (TensorProduct.AlgebraTensorModule.rTensor A p g)
      ⟨s₂ * (s₁ : C) * (s : C), hmem⟩
    have hinj := ((Module.End.isUnit_iff _).mp hu).injective
    apply hinj
    simp only [Module.algebraMap_end_apply, smul_zero]
    exact h3

  have hann : ∀ (S : Submonoid C) (G : Finset (TensorProduct A (C ⧸ J) p)),
      (∀ x ∈ G, ∃ t ∈ S, t • x = 0) →
      ∃ b ∈ S, ∀ y ∈ Submodule.span C (G : Set (TensorProduct A (C ⧸ J) p)), b • y = 0 := by
    intro S G
    induction G using Finset.induction_on with
    | empty =>
      intro _
      refine ⟨1, S.one_mem, fun y hy => ?_⟩
      rw [Finset.coe_empty, Submodule.span_empty, Submodule.mem_bot] at hy
      rw [hy, smul_zero]
    | insert x G hxG ih =>
      intro hG
      obtain ⟨t, htS, ht⟩ := hG x (Finset.mem_insert_self x G)
      obtain ⟨b, hbS, hb⟩ := ih (fun x' hx' => hG x' (Finset.mem_insert_of_mem hx'))
      refine ⟨t * b, S.mul_mem htS hbS, fun y hy => ?_⟩
      rw [Finset.coe_insert, Submodule.mem_span_insert] at hy
      obtain ⟨a, z, hz, rfl⟩ := hy
      rw [smul_add, smul_smul, show t * b * a = a * b * t by ring, mul_smul, ht, smul_zero,
        mul_smul, hb z hz, smul_zero, zero_add]

  have hT : (LinearMap.ker (TensorProduct.AlgebraTensorModule.lTensor C (C ⧸ J)
      (Submodule.subtype p))).FG := by
    haveI : Module.Finite A p := Module.Finite.iff_fg.mpr hp
    haveI : Module.Finite C (TensorProduct A (C ⧸ J) p) := Module.Finite.trans (C ⧸ J) _
    haveI : IsNoetherian C (TensorProduct A (C ⧸ J) p) :=
      isNoetherian_of_isNoetherianRing_of_finite _ _
    exact IsNoetherian.noetherian _
  have hmemT : ∀ y, y ∈ LinearMap.ker (TensorProduct.AlgebraTensorModule.lTensor C (C ⧸ J)
      (Submodule.subtype p)) ↔ LinearMap.lTensor (C ⧸ J) p.subtype y = 0 := by
    intro y
    rw [LinearMap.mem_ker, TensorProduct.AlgebraTensorModule.coe_lTensor]

  haveI := hloc P
  have hinjP : Function.Injective (LinearMap.lTensor
      (Localization.AtPrime P ⧸ J.map (algebraMap C (Localization.AtPrime P))) p.subtype) :=
    Module.Flat.lTensor_preserves_injective_linearMap p.subtype p.injective_subtype
  have htorsP := hto (C ⧸ J)
    (Localization.AtPrime P ⧸ J.map (algebraMap C (Localization.AtPrime P))) P.primeCompl
    (IsScalarTower.toAlgHom C (C ⧸ J)
      (Localization.AtPrime P ⧸ J.map (algebraMap C (Localization.AtPrime P)))).toLinearMap hinjP
  obtain ⟨G, hG⟩ := hT
  obtain ⟨b, hbS, hb⟩ := hann P.primeCompl G (fun x hx =>
    htorsP x ((hmemT x).mp (hG ▸ Submodule.subset_span hx)))
  refine ⟨b, hbS, ?_⟩
  intro Q _ hbQ
  rw [← LinearMap.lTensor_inj_iff_rTensor_inj]
  haveI := hloc Q
  apply hfrom (C ⧸ J)
    (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) Q.primeCompl
    (IsScalarTower.toAlgHom C (C ⧸ J)
      (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q)))).toLinearMap
  intro y hy
  exact ⟨b, hbQ, hb y (by rw [hG]; exact (hmemT y).mpr hy)⟩

theorem wcpa_ffp_no_fibre_flat : ∀ (A : Type u) [CommRing A] (A'' : Type u) [CommRing A''] [Algebra A A''] (C : Type u) [CommRing C] [Algebra A C] (J : Ideal C) (a : A) (Q : Ideal C) [Q.IsPrime], algebraMap A C a ∉ Q → Module.Free (Localization.Away (algebraMap A A'' a)) (LocalizedModule (Submonoid.powers (algebraMap A A'' a)) (TensorProduct A A'' (C ⧸ J))) → Module.Flat A'' (TensorProduct A A'' (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q)))) :=
by
  intro A _ A'' _ _ C _ _ J a Q _ haQ hfree
  classical

  have transport : ∀ {R₁ S₁ R₂ S₂ : Type u} [CommRing R₁] [CommRing S₁] [CommRing R₂]
      [CommRing S₂] [Algebra R₁ S₁] [Algebra R₂ S₂] (M₁ : Submonoid R₁) (_ : IsLocalization M₁ S₁)
      (e₁ : R₁ ≃+* R₂) (e₂ : S₁ ≃+* S₂),
      (∀ x, algebraMap R₂ S₂ (e₁ x) = e₂ (algebraMap R₁ S₁ x)) →
      IsLocalization (M₁.map e₁) S₂ := by
    intro R₁ S₁ R₂ S₂ _ _ _ _ _ _ M₁ hM₁ e₁ e₂ h
    rw [isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, ⟨m, hm, rfl⟩⟩
      show IsUnit (algebraMap R₂ S₂ (e₁ m))
      rw [h]
      exact (IsLocalization.map_units S₁ (⟨m, hm⟩ : M₁)).map e₂
    · intro z
      obtain ⟨⟨x, m⟩, hxm⟩ := IsLocalization.surj M₁ (e₂.symm z)
      refine ⟨⟨e₁ x, ⟨e₁ m, Submonoid.mem_map_of_mem _ m.2⟩⟩, ?_⟩
      show z * algebraMap R₂ S₂ (e₁ m) = algebraMap R₂ S₂ (e₁ x)
      rw [h, h, ← hxm, map_mul, e₂.apply_symm_apply]
    · intro u v huv
      have h' : algebraMap R₁ S₁ (e₁.symm u) = algebraMap R₁ S₁ (e₁.symm v) := by
        apply e₂.injective
        rw [← h, ← h, e₁.apply_symm_apply, e₁.apply_symm_apply]
        exact huv
      obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := M₁) h'
      refine ⟨⟨e₁ c, Submonoid.mem_map_of_mem _ c.2⟩, ?_⟩
      have := congrArg e₁ hc
      simpa using this

  have hfl : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] (r : R),
      Module.Free (Localization.Away r) (LocalizedModule (Submonoid.powers r) D) →
      Module.Flat R (Localization.Away (algebraMap R D r)) := by
    intro R _ D _ _ r h
    have : Module.Flat (Localization.Away r) (LocalizedModule (Submonoid.powers r) D) :=
      Module.Flat.of_free
    have : Module.Flat R (Localization.Away r) := IsLocalization.flat _ (Submonoid.powers r)
    have : Module.Flat R (LocalizedModule (Submonoid.powers r) D) :=
      Module.Flat.trans R (Localization.Away r) _
    have hloc : IsLocalization (Algebra.algebraMapSubmonoid D (Submonoid.powers r))
        (Localization.Away (algebraMap R D r)) := by
      have : Algebra.algebraMapSubmonoid D (Submonoid.powers r) =
          Submonoid.powers (algebraMap R D r) := Submonoid.map_powers _ _
      rw [this]; infer_instance
    have hlm := (isLocalizedModule_iff_isLocalization (S := Submonoid.powers r) (A := D)
      (Aₛ := Localization.Away (algebraMap R D r))).mpr hloc
    exact Module.Flat.of_linearEquiv (IsLocalizedModule.iso (Submonoid.powers r)
      (IsScalarTower.toAlgHom R D (Localization.Away (algebraMap R D r))).toLinearMap).symm

  have hge : ∀ (R : Type u) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] (E : Type u)
      [CommRing E] [Algebra D E] [Algebra R E] [IsScalarTower R D E] (T : Submonoid D),
      IsLocalization T E → ∀ d : D, d ∈ T → Module.Flat R (Localization.Away d) →
      Module.Flat R E := by
    intro R _ D _ _ E _ _ _ _ T hT d hd hflat
    have h : Submonoid.powers d ≤ T := Submonoid.powers_le.mpr hd
    letI : Algebra (Localization.Away d) E :=
      IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (Submonoid.powers d) T h
    haveI : IsScalarTower D (Localization.Away d) E :=
      IsLocalization.localization_isScalarTower_of_submonoid_le _ _ _ _ h
    haveI : IsLocalization (T.map (algebraMap D (Localization.Away d))) E :=
      IsLocalization.isLocalization_of_submonoid_le _ _ _ _ h
    haveI : Module.Flat (Localization.Away d) E :=
      IsLocalization.flat E (T.map (algebraMap D (Localization.Away d)))
    haveI : IsScalarTower R (Localization.Away d) E := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [IsScalarTower.algebraMap_apply R D E, IsScalarTower.algebraMap_apply D (Localization.Away d) E,
        ← IsScalarTower.algebraMap_apply R D (Localization.Away d)])
    exact Module.Flat.trans R (Localization.Away d) E

  have key : ∀ (B : Type u) [CommRing B] [Algebra A B] (B' : Type u) [CommRing B'] [Algebra A B']
      [Algebra B B'] [IsScalarTower A B B'] (M : Submonoid B), IsLocalization M B' →
      algebraMap A B a ∈ M →
      Module.Free (Localization.Away (algebraMap A A'' a))
        (LocalizedModule (Submonoid.powers (algebraMap A A'' a)) (TensorProduct A A'' B)) →
      Module.Flat A'' (TensorProduct A A'' B') := by
    intro B _ _ B' _ _ _ _ M hM haM hfr
    letI ψalg : Algebra (TensorProduct A B A'') (TensorProduct A B' A'') :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A B B') (AlgHom.id A A'')).toRingHom.toAlgebra
    haveI : IsScalarTower B (TensorProduct A B A'') (TensorProduct A B' A'') := by
      refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
      show algebraMap B B' x ⊗ₜ[A] (1 : A'') =
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A B B') (AlgHom.id A A''))
          ((algebraMap B B x) ⊗ₜ[A] (1 : A''))
      simp [Algebra.TensorProduct.map_tmul]
    have hside : (algebraMap (TensorProduct A B A'') (TensorProduct A B' A'')).comp
        Algebra.TensorProduct.includeRight.toRingHom = Algebra.TensorProduct.includeRight.toRingHom := by
      ext s
      show (Algebra.TensorProduct.map (IsScalarTower.toAlgHom A B B') (AlgHom.id A A''))
        ((1 : B) ⊗ₜ[A] s) = (1 : B') ⊗ₜ[A] s
      simp [Algebra.TensorProduct.map_tmul]
    have hR := IsLocalization.tensorProduct_tensorProduct A A'' M B' hside
    letI φalg : Algebra (TensorProduct A A'' B) (TensorProduct A A'' B') :=
      (Algebra.TensorProduct.map (AlgHom.id A'' A'') (IsScalarTower.toAlgHom A B B')).toRingHom.toAlgebra
    have hsq : ∀ x : TensorProduct A B A'',
        algebraMap (TensorProduct A A'' B) (TensorProduct A A'' B')
          ((Algebra.TensorProduct.comm A B A'').toRingEquiv x) =
        (Algebra.TensorProduct.comm A B' A'').toRingEquiv
          (algebraMap (TensorProduct A B A'') (TensorProduct A B' A'') x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul b s =>
        show (Algebra.TensorProduct.map (AlgHom.id A'' A'') (IsScalarTower.toAlgHom A B B'))
            ((Algebra.TensorProduct.comm A B A'') (b ⊗ₜ s)) =
          (Algebra.TensorProduct.comm A B' A'')
            ((Algebra.TensorProduct.map (IsScalarTower.toAlgHom A B B') (AlgHom.id A A'')) (b ⊗ₜ s))
        simp [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.comm_tmul]
      | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
    have hT := transport _ hR (Algebra.TensorProduct.comm A B A'').toRingEquiv
      (Algebra.TensorProduct.comm A B' A'').toRingEquiv hsq
    have hd : algebraMap A'' (TensorProduct A A'' B) (algebraMap A A'' a) ∈
        (Algebra.algebraMapSubmonoid (TensorProduct A B A'') M).map
          (Algebra.TensorProduct.comm A B A'').toRingEquiv := by
      refine Submonoid.mem_map.mpr ⟨algebraMap B (TensorProduct A B A'') (algebraMap A B a),
        Submonoid.mem_map_of_mem _ haM, ?_⟩
      show (Algebra.TensorProduct.comm A B A'') (algebraMap A B a ⊗ₜ[A] (1 : A'')) =
        algebraMap A A'' a ⊗ₜ[A] (1 : B)
      rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_eq_smul_one,
        Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    haveI : IsScalarTower A'' (TensorProduct A A'' B) (TensorProduct A A'' B') :=
      IsScalarTower.of_algebraMap_eq (fun r =>
        ((Algebra.TensorProduct.map (AlgHom.id A'' A'') (IsScalarTower.toAlgHom A B B')).commutes r).symm)
    exact hge A'' (TensorProduct A A'' B) (TensorProduct A A'' B') _ hT _ hd
      (hfl A'' (TensorProduct A A'' B) _ hfr)

  haveI htower : IsScalarTower A (C ⧸ J)
      (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) := by
    refine IsScalarTower.of_algebraMap_eq (R := A) (S := C ⧸ J)
      (A := Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) (fun r => ?_)
    have e1 : algebraMap A (C ⧸ J) r = Ideal.Quotient.mk J (algebraMap A C r) := rfl
    have e2 : algebraMap A (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) r =
        Ideal.Quotient.mk (J.map (algebraMap C (Localization.AtPrime Q)))
          (algebraMap A (Localization.AtPrime Q) r) := rfl
    rw [e1, e2, Ideal.Quotient.algebraMap_quotient_map_quotient,
      IsScalarTower.algebraMap_apply A C (Localization.AtPrime Q)]
  have hloc' : IsLocalization (Q.primeCompl.map (Ideal.Quotient.mk J))
      (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q))) := by
    refine IsLocalization.of_surjective Q.primeCompl (Localization.AtPrime Q)
      (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective ?_ ?_
    · ext x
      rw [RingHom.comp_apply, RingHom.comp_apply,
        Ideal.Quotient.algebraMap_quotient_map_quotient]
    · rw [Ideal.mk_ker, Ideal.mk_ker]
  exact key (C ⧸ J) _ (Q.primeCompl.map (Ideal.Quotient.mk J)) hloc'
    (Submonoid.mem_map_of_mem (Ideal.Quotient.mk J) (show algebraMap A C a ∈ Q.primeCompl from haQ))
    hfree

theorem wcpa_ffp_no_lc_nonlocal : (∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], I ≠ ⊤ → Module.Flat (A ⧸ I) (TensorProduct A (A ⧸ I) M) → Function.Injective (LinearMap.rTensor M (Submodule.subtype I)) → Module.Flat A M) → ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] (p : Ideal A) (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], p ≤ (IsLocalRing.maximalIdeal B).comap (algebraMap A B) → Module.Flat (A ⧸ p) (TensorProduct A (A ⧸ p) M) → Function.Injective (LinearMap.rTensor M (Submodule.subtype p)) → Module.Flat A M :=
by

  have hs2 : ∀ (A A' : Type u) [CommRing A] [CommRing A'] [Algebra A A'] (p : Ideal A)
      (M : Type u) [AddCommGroup M] [Module A M] [Module A' M] [IsScalarTower A A' M],
      ((p.map (algebraMap A A')) • (⊤ : Submodule A' M)).restrictScalars A =
        p • (⊤ : Submodule A M) := by
    intro A A' _ _ _ p M _ _ _ _
    apply le_antisymm
    · intro x hx
      rw [Submodule.restrictScalars_mem] at hx
      have key : ∀ r ∈ p.map (algebraMap A A'), ∀ n : M, r • n ∈ p • (⊤ : Submodule A M) := by
        intro r hr
        have hr' : r ∈ Ideal.span (algebraMap A A' '' (p : Set A)) := hr
        clear hr
        induction hr' using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨a, ha, rfl⟩ := hx
          intro n
          rw [algebraMap_smul]
          exact Submodule.smul_mem_smul ha trivial
        | zero => intro n; rw [zero_smul]; exact zero_mem _
        | add a b _ _ ha hb => intro n; rw [add_smul]; exact add_mem (ha n) (hb n)
        | smul c a _ ha => intro n; rw [smul_eq_mul, mul_comm, mul_smul]; exact ha (c • n)
      exact Submodule.smul_induction_on hx (fun r hr n _ => key r hr n)
        (fun _ _ h1 h2 => add_mem h1 h2)
    · intro x hx
      refine Submodule.smul_induction_on hx ?_ (fun _ _ h1 h2 => add_mem h1 h2)
      intro r hr n _
      rw [Submodule.restrictScalars_mem, ← algebraMap_smul A' r n]
      exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) trivial

  have hs3 : ∀ (A A' : Type u) [CommRing A] [CommRing A'] [Algebra A A'] (S : Submonoid A)
      [IsLocalization S A'] (p : Ideal A) (M : Type u) [AddCommGroup M] [Module A M]
      [Module A' M] [IsScalarTower A A' M],
      ((p.map (algebraMap A A')) • (⊤ : Submodule A' M)).restrictScalars A =
        p • (⊤ : Submodule A M) →
      Module.Flat (A ⧸ p) (TensorProduct A (A ⧸ p) M) →
      Module.Flat (A' ⧸ p.map (algebraMap A A'))
        (TensorProduct A' (A' ⧸ p.map (algebraMap A A')) M) := by
    intro A A' _ _ _ S _ p M _ _ _ _ h hfl
    let e1 : TensorProduct A' (A' ⧸ p.map (algebraMap A A')) M ≃ₗ[A]
        M ⧸ ((p.map (algebraMap A A')) • (⊤ : Submodule A' M)) :=
      (TensorProduct.quotTensorEquivQuotSMul M (p.map (algebraMap A A'))).restrictScalars A
    let e2 : (M ⧸ ((p.map (algebraMap A A')) • (⊤ : Submodule A' M))) ≃ₗ[A]
        M ⧸ (((p.map (algebraMap A A')) • (⊤ : Submodule A' M)).restrictScalars A) :=
      (Submodule.Quotient.restrictScalarsEquiv A ((p.map (algebraMap A A')) • ⊤)).symm
    let e3 := Submodule.quotEquivOfEq _ _ h
    let e4 : (M ⧸ (p • (⊤ : Submodule A M))) ≃ₗ[A] TensorProduct A (A ⧸ p) M :=
      (TensorProduct.quotTensorEquivQuotSMul M p).symm
    let e : TensorProduct A' (A' ⧸ p.map (algebraMap A A')) M ≃ₗ[A]
        TensorProduct A (A ⧸ p) M := ((e1.trans e2).trans e3).trans e4
    let e' : TensorProduct A' (A' ⧸ p.map (algebraMap A A')) M ≃ₗ[A ⧸ p]
        TensorProduct A (A ⧸ p) M :=
      LinearEquiv.extendScalarsOfSurjective Ideal.Quotient.mk_surjective e
    have hflA : Module.Flat (A ⧸ p) (TensorProduct A' (A' ⧸ p.map (algebraMap A A')) M) :=
      Module.Flat.of_linearEquiv e'
    haveI : IsLocalization (S.map (Ideal.Quotient.mk p)) (A' ⧸ p.map (algebraMap A A')) := by
      refine IsLocalization.of_surjective S A'
        (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
        (Ideal.Quotient.mk (p.map (algebraMap A A'))) Ideal.Quotient.mk_surjective ?_ ?_
      · ext x
        rw [RingHom.comp_apply, RingHom.comp_apply,
          Ideal.Quotient.algebraMap_quotient_map_quotient]
      · rw [Ideal.mk_ker, Ideal.mk_ker]
    exact (Module.flat_iff_of_isLocalization (A' ⧸ p.map (algebraMap A A'))
      (S.map (Ideal.Quotient.mk p)) _).mpr hflA

  have hs4 : ∀ (A A' : Type u) [CommRing A] [CommRing A'] [Algebra A A'] (p : Ideal A)
      (M : Type u) [AddCommGroup M] [Module A M] [Module A' M] [IsScalarTower A A' M],
      Function.Injective (LinearMap.rTensor M (Submodule.subtype p)) →
      Function.Injective (LinearMap.rTensor M (Submodule.subtype (p.map (algebraMap A A')))) := by
    intro A A' _ _ _ p M _ _ _ _ hinj
    let ι : p →+ p.map (algebraMap A A') :=
      { toFun := fun x => ⟨algebraMap A A' x, Ideal.mem_map_of_mem _ x.2⟩
        map_zero' := by ext; simp
        map_add' := fun x y => by ext; simp }
    let F : p →+ M →+ TensorProduct A' (p.map (algebraMap A A')) M :=
      AddMonoidHom.mk' (fun x => AddMonoidHom.mk' (fun m => ι x ⊗ₜ[A'] m)
        (fun m m' => TensorProduct.tmul_add _ _ _))
        (fun x y => by
          ext m
          simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add,
            TensorProduct.add_tmul])
    have hF : ∀ (r : A) (x : p) (m : M), F (r • x) m = F x (r • m) := by
      intro r x m
      show ι (r • x) ⊗ₜ[A'] m = ι x ⊗ₜ[A'] (r • m)
      have hι : ι (r • x) = algebraMap A A' r • ι x := by
        apply Subtype.ext
        show algebraMap A A' (r * (x : A)) = algebraMap A A' r * algebraMap A A' x
        exact map_mul _ r x
      rw [hι, TensorProduct.smul_tmul, algebraMap_smul]
    let σ : TensorProduct A p M →+ TensorProduct A' (p.map (algebraMap A A')) M :=
      TensorProduct.liftAddHom F hF
    have hsurj : ∀ z : TensorProduct A' (p.map (algebraMap A A')) M, ∃ y, σ y = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, map_zero σ⟩
      | tmul i m =>
        obtain ⟨i, hi⟩ := i
        have key : ∀ (i : A') (hi : i ∈ Ideal.span (algebraMap A A' '' (p : Set A))) (m : M),
            ∃ y, σ y = (⟨i, hi⟩ : p.map (algebraMap A A')) ⊗ₜ[A'] m := by
          intro i hi
          induction hi using Submodule.span_induction with
          | mem x hx =>
            obtain ⟨a, ha, rfl⟩ := hx
            intro m
            exact ⟨(⟨a, ha⟩ : p) ⊗ₜ[A] m, by rw [TensorProduct.liftAddHom_tmul]; rfl⟩
          | zero =>
            intro m
            exact ⟨0, by rw [map_zero]; exact (TensorProduct.zero_tmul _ m).symm⟩
          | add x y hx hy ihx ihy =>
            intro m
            obtain ⟨y1, h1⟩ := ihx m
            obtain ⟨y2, h2⟩ := ihy m
            exact ⟨y1 + y2, by
              rw [map_add, h1, h2]
              exact (TensorProduct.add_tmul (⟨x, hx⟩ : p.map (algebraMap A A'))
                (⟨y, hy⟩ : p.map (algebraMap A A')) m).symm⟩
          | smul c x hx ih =>
            intro m
            obtain ⟨y, hy⟩ := ih (c • m)
            exact ⟨y, by
              rw [hy]
              exact (TensorProduct.smul_tmul c (⟨x, hx⟩ : p.map (algebraMap A A')) m).symm⟩
        exact key i hi m
      | add z w hz hw =>
        obtain ⟨y, hy⟩ := hz
        obtain ⟨y', hy'⟩ := hw
        exact ⟨y + y', by rw [map_add, hy, hy']⟩
    have hcomm : ∀ y, TensorProduct.lid A' M
        (LinearMap.rTensor M (p.map (algebraMap A A')).subtype (σ y)) =
        TensorProduct.lid A M (LinearMap.rTensor M p.subtype y) := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul x m =>
        rw [TensorProduct.liftAddHom_tmul]
        show TensorProduct.lid A' M
          (LinearMap.rTensor M (p.map (algebraMap A A')).subtype (ι x ⊗ₜ[A'] m)) = _
        rw [LinearMap.rTensor_tmul, LinearMap.rTensor_tmul, TensorProduct.lid_tmul,
          TensorProduct.lid_tmul]
        show algebraMap A A' (x : A) • m = (x : A) • m
        exact algebraMap_smul A' (x : A) m
      | add y y' h h' =>
        simp only [map_add]
        rw [h, h']
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨y, rfl⟩ := hsurj z
    have h1 : TensorProduct.lid A M (LinearMap.rTensor M p.subtype y) = 0 := by
      rw [← hcomm, hz, map_zero]
    have h2 : LinearMap.rTensor M p.subtype y = 0 :=
      (TensorProduct.lid A M).map_eq_zero_iff.mp h1
    have h3 : y = 0 := hinj (h2.trans (map_zero _).symm)
    rw [h3, map_zero]
  intro Hlc A _ _ B _ _ _ _ p M _ _ _ _ _ hp hfib hinj
  classical

  have hq'prime : ((IsLocalRing.maximalIdeal B).comap (algebraMap A B)).IsPrime :=
    Ideal.IsPrime.comap _
  generalize hq'def : (IsLocalRing.maximalIdeal B).comap (algebraMap A B) = q' at hp hq'prime
  have hkey : ∀ x : A, x ∉ q' → IsUnit (algebraMap A B x) := by
    intro x hx
    rw [← hq'def] at hx
    exact IsLocalRing.notMem_maximalIdeal.mp hx
  have hunit : ∀ y : q'.primeCompl, IsUnit (algebraMap A B y) := fun y => hkey y y.2
  have hunit' : ∀ x : A, IsUnit (algebraMap A B x) → x ∈ q'.primeCompl := by
    intro x hx hxq
    rw [← hq'def] at hxq
    exact (IsLocalRing.notMem_maximalIdeal.mpr hx) hxq
  let φ : Localization.AtPrime q' →+* B :=
    IsLocalization.lift (M := q'.primeCompl) (S := Localization.AtPrime q') hunit
  have hφ : ∀ a : A, φ (algebraMap A (Localization.AtPrime q') a) = algebraMap A B a :=
    fun a => IsLocalization.lift_eq hunit a
  letI : Algebra (Localization.AtPrime q') B := φ.toAlgebra
  haveI : IsLocalHom (algebraMap (Localization.AtPrime q') B) := by
    refine ⟨fun a ha => ?_⟩
    obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective q'.primeCompl a
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime q') x s
    have h1 : φ (IsLocalization.mk' (Localization.AtPrime q') x s) * algebraMap A B s =
        algebraMap A B x := by
      rw [← hφ, ← hφ, ← map_mul, hspec]
    have hx : IsUnit (algebraMap A B x) := by
      rw [← h1]; exact IsUnit.mul ha (hunit s)
    exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime q') q' x s).mpr
      (hunit' x hx)
  letI : Module (Localization.AtPrime q') M := Module.compHom M φ
  haveI : IsScalarTower (Localization.AtPrime q') B M := ⟨fun c b m => by
    show (φ c * b) • m = φ c • (b • m)
    rw [mul_smul]⟩
  haveI : IsScalarTower A (Localization.AtPrime q') M := ⟨fun a c m => by
    show φ (a • c) • m = a • (φ c • m)
    rw [Algebra.smul_def, map_mul, hφ, mul_smul, algebraMap_smul]⟩

  have hI : p.map (algebraMap A (Localization.AtPrime q')) ≠ ⊤ := by
    intro h
    have h1 : p.map (algebraMap A (Localization.AtPrime q')) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime q') := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.map_mono hp
    rw [h, top_le_iff] at h1
    exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime q')).ne_top h1
  have hfib' := hs3 A (Localization.AtPrime q') q'.primeCompl p M
    (hs2 A (Localization.AtPrime q') p M) hfib
  have hinj' := hs4 A (Localization.AtPrime q') p M hinj

  have hflat' : Module.Flat (Localization.AtPrime q') M :=
    Hlc (Localization.AtPrime q') B (p.map (algebraMap A (Localization.AtPrime q'))) M hI
      hfib' hinj'
  exact (Module.flat_iff_of_isLocalization (Localization.AtPrime q') q'.primeCompl M).mp hflat'

theorem wcpa_ffp_noetherian_open : (∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B] [Algebra.FiniteType A B] (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], ∃ a : A, a ≠ 0 ∧ Module.Free (Localization.Away a) (LocalizedModule (Submonoid.powers a) M)) → (∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], I ≠ ⊤ → Module.Flat (A ⧸ I) (TensorProduct A (A ⧸ I) M) → Function.Injective (LinearMap.rTensor M (Submodule.subtype I)) → Module.Flat A M) → (∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (U : Set (PrimeSpectrum B)), StableUnderGeneralization U → (∀ P ∈ U, ∃ b : B, b ∉ P.asIdeal ∧ ∀ Q : PrimeSpectrum B, P.asIdeal ≤ Q.asIdeal → b ∉ Q.asIdeal → Q ∈ U) → IsOpen U) → ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (n : ℕ) (J q : Ideal (MvPolynomial (Fin n) A)) [q.IsPrime], Module.Flat A (Localization.AtPrime q ⧸ J.map (algebraMap (MvPolynomial (Fin n) A) (Localization.AtPrime q))) → ∃ g ∉ q, Module.Flat A (Localization.Away g ⧸ J.map (algebraMap (MvPolynomial (Fin n) A) (Localization.Away g))) :=
by
  intro Hgf Hlc Hnag A _ _ n J q _ hq
  classical

  have s1 : ∀ (C : Type u) [CommRing C] [Algebra A C] (J : Ideal C) (S S' : Submonoid C),
      S ≤ S' → Module.Flat A (Localization S ⧸ J.map (algebraMap C (Localization S))) →
      Module.Flat A (Localization S' ⧸ J.map (algebraMap C (Localization S'))) := by
    intro C _ _ J S S' hSS' hflat
    letI : Algebra (Localization S) (Localization S') :=
      IsLocalization.localizationAlgebraOfSubmonoidLe _ _ S S' hSS'
    haveI : IsScalarTower C (Localization S) (Localization S') :=
      IsLocalization.localization_isScalarTower_of_submonoid_le _ _ S S' hSS'
    haveI hlocS : IsLocalization (S'.map (algebraMap C (Localization S))) (Localization S') :=
      IsLocalization.isLocalization_of_submonoid_le _ _ S S' hSS'
    haveI : IsScalarTower A (Localization S) (Localization S') :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [IsScalarTower.algebraMap_apply A C (Localization S'),
          IsScalarTower.algebraMap_apply A C (Localization S),
          ← IsScalarTower.algebraMap_apply C (Localization S) (Localization S')])
    have hKK' : (J.map (algebraMap C (Localization S))).map
        (algebraMap (Localization S) (Localization S')) =
        J.map (algebraMap C (Localization S')) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    rw [← hKK']
    generalize J.map (algebraMap C (Localization S)) = K at hflat ⊢
    have htower : IsScalarTower A (Localization S ⧸ K)
        (Localization S' ⧸ K.map (algebraMap (Localization S) (Localization S'))) := by
      refine IsScalarTower.of_algebraMap_eq (R := A) (S := Localization S ⧸ K)
        (A := Localization S' ⧸ K.map (algebraMap (Localization S) (Localization S')))
        (fun r => ?_)
      have e1 : algebraMap A (Localization S ⧸ K) r =
          Ideal.Quotient.mk K (algebraMap A (Localization S) r) := rfl
      have e2 : algebraMap A (Localization S' ⧸
          K.map (algebraMap (Localization S) (Localization S'))) r =
          Ideal.Quotient.mk (K.map (algebraMap (Localization S) (Localization S')))
            (algebraMap A (Localization S') r) := rfl
      rw [e1, e2, Ideal.Quotient.algebraMap_quotient_map_quotient,
        IsScalarTower.algebraMap_apply A (Localization S) (Localization S')]
    have hloc' : IsLocalization ((S'.map (algebraMap C (Localization S))).map
        (Ideal.Quotient.mk K))
        (Localization S' ⧸ K.map (algebraMap (Localization S) (Localization S'))) := by
      refine IsLocalization.of_surjective (S'.map (algebraMap C (Localization S)))
        (Localization S') (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
        (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective ?_ ?_
      · ext x
        rw [RingHom.comp_apply, RingHom.comp_apply,
          Ideal.Quotient.algebraMap_quotient_map_quotient]
      · rw [Ideal.mk_ker, Ideal.mk_ker]
    have hflat2 : Module.Flat (Localization S ⧸ K)
        (Localization S' ⧸ K.map (algebraMap (Localization S) (Localization S'))) :=
      IsLocalization.flat _ ((S'.map (algebraMap C (Localization S))).map (Ideal.Quotient.mk K))
    exact Module.Flat.trans A (Localization S ⧸ K)
      (Localization S' ⧸ K.map (algebraMap (Localization S) (Localization S')))

  have s2 : ∀ (C : Type u) [CommRing C] [Algebra A C] (J : Ideal C) (g : C),
      (∀ (Q : Ideal C) [Q.IsPrime], g ∉ Q →
        Module.Flat A (Localization.AtPrime Q ⧸ J.map (algebraMap C (Localization.AtPrime Q)))) →
      Module.Flat A (Localization.Away g ⧸ J.map (algebraMap C (Localization.Away g))) := by
    intro C _ _ J g H
    set K : Ideal (Localization.Away g) := J.map (algebraMap C (Localization.Away g)) with hK
    haveI hinst : ∀ (P : Ideal (Localization.Away g ⧸ K)) [P.IsMaximal],
        IsLocalizedModule.AtPrime P
          (Algebra.linearMap (Localization.Away g ⧸ K) (Localization.AtPrime P)) :=
      fun P _ => (isLocalizedModule_iff_isLocalization' _ _).mpr inferInstance
    refine Module.flat_of_isLocalized_maximal (Localization.Away g ⧸ K) (Localization.Away g ⧸ K)
      (fun P _ => Localization.AtPrime P) (fun P _ => Algebra.linearMap _ _) ?_
    intro P hP
    let Q' : Ideal (Localization.Away g) := P.comap (Ideal.Quotient.mk K)
    haveI : Q'.IsPrime := Ideal.IsPrime.comap _
    let Q : Ideal C := Q'.comap (algebraMap C (Localization.Away g))
    haveI : Q.IsPrime := Ideal.IsPrime.comap _
    have hgQ : g ∉ Q := by
      intro h
      apply hP.ne_top
      exact Ideal.eq_top_of_isUnit_mem P (x := Ideal.Quotient.mk K (algebraMap C _ g)) h
        ((IsLocalization.Away.algebraMap_isUnit g).map (Ideal.Quotient.mk K))
    have hflatQ := H Q hgQ
    have hle : Submonoid.powers g ≤ Q.primeCompl := Submonoid.powers_le.mpr hgQ
    letI : Algebra (Localization.Away g) (Localization.AtPrime Q) :=
      IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (Submonoid.powers g) Q.primeCompl hle
    haveI : IsScalarTower C (Localization.Away g) (Localization.AtPrime Q) :=
      IsLocalization.localization_isScalarTower_of_submonoid_le _ _ _ _ hle
    haveI : IsLocalization (Q.primeCompl.map (algebraMap C (Localization.Away g)))
        (Localization.AtPrime Q) :=
      IsLocalization.isLocalization_of_submonoid_le _ _ _ _ hle
    haveI : IsScalarTower A (Localization.Away g) (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [IsScalarTower.algebraMap_apply A C (Localization.AtPrime Q),
          IsScalarTower.algebraMap_apply A C (Localization.Away g),
          ← IsScalarTower.algebraMap_apply C (Localization.Away g) (Localization.AtPrime Q)])
    have hKK' : K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q)) =
        J.map (algebraMap C (Localization.AtPrime Q)) := by
      rw [hK, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    rw [← hKK'] at hflatQ
    have htower : IsScalarTower A (Localization.Away g ⧸ K)
        (Localization.AtPrime Q ⧸
          K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q))) := by
      refine IsScalarTower.of_algebraMap_eq (R := A) (S := Localization.Away g ⧸ K)
        (A := Localization.AtPrime Q ⧸ K.map (algebraMap (Localization.Away g)
          (Localization.AtPrime Q))) (fun r => ?_)
      have e1 : algebraMap A (Localization.Away g ⧸ K) r =
          Ideal.Quotient.mk K (algebraMap A (Localization.Away g) r) := rfl
      have e2 : algebraMap A (Localization.AtPrime Q ⧸
          K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q))) r =
          Ideal.Quotient.mk (K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q)))
            (algebraMap A (Localization.AtPrime Q) r) := rfl
      rw [e1, e2, Ideal.Quotient.algebraMap_quotient_map_quotient,
        IsScalarTower.algebraMap_apply A (Localization.Away g) (Localization.AtPrime Q)]
    have hloc' : IsLocalization ((Q.primeCompl.map (algebraMap C (Localization.Away g))).map
        (Ideal.Quotient.mk K))
        (Localization.AtPrime Q ⧸
          K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q))) := by
      refine IsLocalization.of_surjective (Q.primeCompl.map (algebraMap C (Localization.Away g)))
        (Localization.AtPrime Q)
        (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
        (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective ?_ ?_
      · ext x
        rw [RingHom.comp_apply, RingHom.comp_apply,
          Ideal.Quotient.algebraMap_quotient_map_quotient]
      · rw [Ideal.mk_ker, Ideal.mk_ker]
    have hM0le : (Q.primeCompl.map (algebraMap C (Localization.Away g))).map
        (Ideal.Quotient.mk K) ≤ P.primeCompl := by
      rintro _ ⟨_, ⟨c, hc, rfl⟩, rfl⟩
      exact hc
    have hunits : ∀ x ∈ P.primeCompl, IsUnit (algebraMap (Localization.Away g ⧸ K)
        (Localization.AtPrime Q ⧸
          K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q))) x) := by
      intro x hx
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨⟨c, ⟨_, ⟨k, rfl⟩⟩⟩, hyc⟩ := IsLocalization.surj (Submonoid.powers g) y
      simp only at hyc
      have hcQ : c ∉ Q := by
        intro hc
        apply hx
        have h1 : Ideal.Quotient.mk K (y * algebraMap C (Localization.Away g) (g ^ k)) ∈ P := by
          rw [hyc]; exact hc
        rw [map_mul] at h1
        refine (hP.isPrime.mem_or_mem h1).resolve_right (fun h => hgQ ?_)
        have h' : (Ideal.Quotient.mk K (algebraMap C (Localization.Away g) g)) ^ k ∈ P := by
          rwa [map_pow, map_pow] at h
        exact hP.isPrime.mem_of_pow_mem k h'
      have hu : IsUnit (algebraMap (Localization.Away g ⧸ K)
          (Localization.AtPrime Q ⧸
            K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q)))
          (Ideal.Quotient.mk K (algebraMap C _ c))) :=
        IsLocalization.map_units (M := (Q.primeCompl.map (algebraMap C (Localization.Away g))).map
          (Ideal.Quotient.mk K)) _ ⟨_, ⟨_, ⟨c, hcQ, rfl⟩, rfl⟩⟩
      rw [← hyc, map_mul, map_mul] at hu
      exact isUnit_of_mul_isUnit_left hu
    haveI hlocP : IsLocalization P.primeCompl
        (Localization.AtPrime Q ⧸
          K.map (algebraMap (Localization.Away g) (Localization.AtPrime Q))) :=
      IsLocalization.of_le _ P.primeCompl hM0le hunits
    haveI := hflatQ
    exact Module.Flat.of_linearEquiv
      ((IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P)
        (Localization.AtPrime Q ⧸ K.map (algebraMap (Localization.Away g)
          (Localization.AtPrime Q)))).toLinearEquiv.restrictScalars A)
  let U : Set (PrimeSpectrum (MvPolynomial (Fin n) A)) := {Q | Module.Flat A
    (Localization.AtPrime Q.asIdeal ⧸
      J.map (algebraMap (MvPolynomial (Fin n) A) (Localization.AtPrime Q.asIdeal)))}

  have hgen : StableUnderGeneralization U := by
    intro x y hyx hx
    have hle : y.asIdeal ≤ x.asIdeal := (PrimeSpectrum.le_iff_specializes y x).mpr hyx
    exact s1 (MvPolynomial (Fin n) A) J x.asIdeal.primeCompl
      y.asIdeal.primeCompl (fun c hc hcy => hc (hle hcy)) hx

  have hnag : ∀ P ∈ U, ∃ b : MvPolynomial (Fin n) A, b ∉ P.asIdeal ∧
      ∀ Q : PrimeSpectrum (MvPolynomial (Fin n) A), P.asIdeal ≤ Q.asIdeal → b ∉ Q.asIdeal →
        Q ∈ U := by
    intro P hP
    let p : Ideal A := P.asIdeal.comap (algebraMap A (MvPolynomial (Fin n) A))
    haveI : p.IsPrime := Ideal.IsPrime.comap _
    obtain ⟨abar, habar0, hfree⟩ := Hgf (A ⧸ p)
      (TensorProduct A (A ⧸ p) (MvPolynomial (Fin n) A ⧸ J))
      (TensorProduct A (A ⧸ p) (MvPolynomial (Fin n) A ⧸ J))
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective abar
    have hap : a ∉ p := fun h => habar0 (Ideal.Quotient.eq_zero_iff_mem.mpr h)
    have haP : algebraMap A (MvPolynomial (Fin n) A) a ∉ P.asIdeal := hap
    obtain ⟨b', hb'P, htor⟩ := wcpa_ffp_no_tor_open A (MvPolynomial (Fin n) A) J P.asIdeal p
      (IsNoetherian.noetherian p) hP
    refine ⟨algebraMap A (MvPolynomial (Fin n) A) a * b', ?_, ?_⟩
    · exact fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim haP hb'P
    · intro Q hPQ hbQ
      have haQ : algebraMap A (MvPolynomial (Fin n) A) a ∉ Q.asIdeal :=
        fun h => hbQ (Q.asIdeal.mul_mem_right _ h)
      have hb'Q : b' ∉ Q.asIdeal := fun h => hbQ (Q.asIdeal.mul_mem_left _ h)
      have hfib := wcpa_ffp_no_fibre_flat A (A ⧸ p) (MvPolynomial (Fin n) A) J a Q.asIdeal haQ
        hfree
      have hinj := htor Q.asIdeal hb'Q
      have hple : p ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime Q.asIdeal)).comap
          (algebraMap A (Localization.AtPrime Q.asIdeal)) := by
        intro x hx
        rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply A (MvPolynomial (Fin n) A)
          (Localization.AtPrime Q.asIdeal)]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q.asIdeal)
          Q.asIdeal _).mpr (hPQ hx)
      exact wcpa_ffp_no_lc_nonlocal Hlc A (Localization.AtPrime Q.asIdeal) p
        (Localization.AtPrime Q.asIdeal ⧸
          J.map (algebraMap (MvPolynomial (Fin n) A) (Localization.AtPrime Q.asIdeal)))
        hple hfib hinj

  have hopen : IsOpen U := Hnag _ U hgen hnag
  have hqU : (⟨q, inferInstance⟩ : PrimeSpectrum (MvPolynomial (Fin n) A)) ∈ U := hq
  obtain ⟨_, ⟨g, rfl⟩, hqg, hgU⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hqU hopen
  refine ⟨g, (PrimeSpectrum.mem_basicOpen _ _).mp hqg, ?_⟩

  exact s2 (MvPolynomial (Fin n) A) J g
    (fun Q _ hgQ => hgU ((PrimeSpectrum.mem_basicOpen g ⟨Q, inferInstance⟩).mpr hgQ))

theorem wcpa_lfg_fa_local_model : ∀ (R : Type u) [CommRing R] (n : ℕ) (q : Ideal (MvPolynomial (Fin n) R)) [q.IsPrime] (J : Ideal (MvPolynomial (Fin n) R)) (R₀ : Type u) [CommRing R₀] [IsNoetherianRing R₀] [Algebra R₀ R] (s₀ : Finset (MvPolynomial (Fin n) R₀)) (F : Finset R), (∀ x : R₀, algebraMap R₀ R x ∈ Subring.closure (F : Set R)) → Ideal.span ((MvPolynomial.map (algebraMap R₀ R)) '' (↑s₀ : Set (MvPolynomial (Fin n) R₀))) = J → Module.Flat R₀ (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R))) ⧸ (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀))).map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R)))))) → ∃ (s₁ : Finset (MvPolynomial (Fin n) (Subring.closure (F : Set R)))) (g₁ : MvPolynomial (Fin n) (Subring.closure (F : Set R))), Ideal.span ((MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R)) '' (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))) = J ∧ MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) g₁ ∉ q ∧ Module.Flat (Subring.closure (F : Set R)) (Localization.Away g₁ ⧸ (Ideal.span (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))).map (algebraMap (MvPolynomial (Fin n) (Subring.closure (F : Set R))) (Localization.Away g₁))) :=
by
  intro R _ n q _ J R₀ _ _ _ s₀ F hF hsp hfl
  classical
  obtain ⟨g₀, hg₀, hflat₀⟩ := wcpa_ffp_noetherian_open wcpa_ffp_generic_free
    wcpa_ffp_local_criterion wcpa_ffp_nagata_open R₀ n
    (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀)))
    (q.comap (MvPolynomial.map (algebraMap R₀ R))) hfl
  let ρ : R₀ →+* Subring.closure (F : Set R) :=
    (algebraMap R₀ R).codRestrict (Subring.closure (F : Set R)) hF
  letI : Algebra R₀ (Subring.closure (F : Set R)) := ρ.toAlgebra
  have hcomp : (algebraMap (Subring.closure (F : Set R)) R).comp ρ = algebraMap R₀ R :=
    RingHom.ext fun x => rfl
  have hmap : ∀ p : MvPolynomial (Fin n) R₀,
      MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) (MvPolynomial.map ρ p) =
        MvPolynomial.map (algebraMap R₀ R) p := by
    intro p
    rw [MvPolynomial.map_map, hcomp]
  have hb := wcpa_ffp_flat_base_change R₀ (Subring.closure (F : Set R)) n
    (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀))) g₀ hflat₀
  rw [Ideal.map_span] at hb
  have e : (MvPolynomial.map (algebraMap R₀ (Subring.closure (F : Set R))) :
      MvPolynomial (Fin n) R₀ →+* MvPolynomial (Fin n) (Subring.closure (F : Set R))) =
      MvPolynomial.map ρ := rfl
  rw [e] at hb
  refine ⟨s₀.image (MvPolynomial.map ρ), MvPolynomial.map ρ g₀, ?_, ?_, ?_⟩
  · rw [Finset.coe_image, Set.image_image]
    simp only [hmap]
    exact hsp
  · rw [hmap]
    intro h
    exact hg₀ (Ideal.mem_comap.mpr h)
  · rw [Finset.coe_image]
    exact hb

theorem wcpa_lfg_fa_common_level : ∀ (R : Type u) [CommRing R] (n : ℕ) (s : Finset (MvPolynomial (Fin n) R)) (ι : Type u) (F₀ : ι → Finset R) (s₀ : ∀ i, Finset (MvPolynomial (Fin n) (Subring.closure (F₀ i : Set R)))) (g₀ : ∀ i, MvPolynomial (Fin n) (Subring.closure (F₀ i : Set R))), (∀ i, Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (F₀ i : Set R)) R) '' (↑(s₀ i) : Set (MvPolynomial (Fin n) (Subring.closure (F₀ i : Set R))))) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R))) → Ideal.span (Set.range fun i => MvPolynomial.map (algebraMap (Subring.closure (F₀ i : Set R)) R) (g₀ i)) = ⊤ → ∃ (F : Finset R) (T : Finset ι) (hF : ∀ i ∈ T, F₀ i ⊆ F) (s₁ : Finset (MvPolynomial (Fin n) (Subring.closure (F : Set R)))), Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) '' (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) ∧ (∀ (i : ι) (hi : i ∈ T), Ideal.span (MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr (hF i hi)))) '' (↑(s₀ i) : Set (MvPolynomial (Fin n) (Subring.closure (F₀ i : Set R))))) = Ideal.span (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))) ∧ Ideal.span (Set.range fun (i : T) => MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr (hF i.1 i.2)))) (g₀ i.1)) = ⊤ :=
by
  intro R _ n s ι F₀ s₀ g₀ h1 htop
  classical

  have Hinj : ∀ F : Finset R, Function.Injective
      (MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) :
        MvPolynomial (Fin n) (Subring.closure (F : Set R)) → MvPolynomial (Fin n) R) := by
    intro F
    exact MvPolynomial.map_injective _ (fun a b hab => Subtype.ext hab)

  have Hcomp : ∀ (G F : Finset R) (h : G ⊆ F) (p : MvPolynomial (Fin n) (Subring.closure (G : Set R))),
      MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R)
        (MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h))) p) =
      MvPolynomial.map (algebraMap (Subring.closure (G : Set R)) R) p := by
    intro G F h p
    rw [MvPolynomial.map_map]
    rfl

  have Hlift : ∀ (F : Finset R) (p : MvPolynomial (Fin n) R), (p.coeffs : Set R) ⊆ (F : Set R) →
      ∃ p' : MvPolynomial (Fin n) (Subring.closure (F : Set R)),
        MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) p' = p := by
    intro F p hp
    have hmem : p ∈ Set.range (MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) :
        MvPolynomial (Fin n) (Subring.closure (F : Set R)) → MvPolynomial (Fin n) R) := by
      rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
      intro r hr
      exact ⟨⟨r, Subring.subset_closure (hp hr)⟩, rfl⟩
    exact hmem

  have Hdesc : ∀ (G₁ G₂ : Finset R) (x : MvPolynomial (Fin n) (Subring.closure (G₁ : Set R)))
      (t : Set (MvPolynomial (Fin n) (Subring.closure (G₂ : Set R)))),
      MvPolynomial.map (algebraMap (Subring.closure (G₁ : Set R)) R) x ∈
        Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (G₂ : Set R)) R) '' t) →
      ∃ E : Finset R, ∀ (F : Finset R) (h₁ : G₁ ⊆ F) (h₂ : G₂ ⊆ F), E ⊆ F →
        MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) x ∈
          Ideal.span (MvPolynomial.map (Subring.inclusion
            (Subring.closure_mono (Finset.coe_subset.mpr h₂))) '' t) := by
    intro G₁ G₂ x t hx
    obtain ⟨t', ht', c, hc⟩ := (Submodule.mem_span_image_iff_exists_fun _).mp hx
    refine ⟨Finset.univ.biUnion (fun σ : t' => (c σ).coeffs), ?_⟩
    intro F h₁ h₂ hE
    have hc' : ∀ σ : t', ∃ p' : MvPolynomial (Fin n) (Subring.closure (F : Set R)),
        MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) p' = c σ := by
      intro σ
      apply Hlift
      intro r hr
      exact Finset.mem_coe.mpr (hE (Finset.mem_biUnion.mpr ⟨σ, Finset.mem_univ _, Finset.mem_coe.mp hr⟩))
    choose c' hc'' using hc'
    have hy : ∑ σ : t', c' σ * MvPolynomial.map (Subring.inclusion
        (Subring.closure_mono (Finset.coe_subset.mpr h₂))) σ.1 ∈
        Ideal.span (MvPolynomial.map (Subring.inclusion
          (Subring.closure_mono (Finset.coe_subset.mpr h₂))) '' t) := by
      apply Ideal.sum_mem
      intro σ _
      apply Ideal.mul_mem_left
      apply Ideal.subset_span
      exact Set.mem_image_of_mem _ (ht' σ.2)
    have heq : ∑ σ : t', c' σ * MvPolynomial.map (Subring.inclusion
        (Subring.closure_mono (Finset.coe_subset.mpr h₂))) σ.1 =
        MvPolynomial.map (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr h₁))) x := by
      apply Hinj F
      rw [map_sum, Hcomp G₁ F h₁ x, ← hc]
      refine Finset.sum_congr rfl (fun σ _ => ?_)
      rw [map_mul, hc'' σ, Hcomp G₂ F h₂, smul_eq_mul]
    rw [← heq]
    exact hy

  have h1mem : (1 : MvPolynomial (Fin n) R) ∈ Ideal.span (Set.range fun i =>
      MvPolynomial.map (algebraMap (Subring.closure (F₀ i : Set R)) R) (g₀ i)) := by
    rw [htop]; exact Submodule.mem_top
  obtain ⟨T, c, hc⟩ : ∃ (T : Finset ι) (c : ι → MvPolynomial (Fin n) R),
      ∑ i ∈ T, c i * MvPolynomial.map (algebraMap (Subring.closure (F₀ i : Set R)) R) (g₀ i) = 1 := by
    obtain ⟨c, hc⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).mp h1mem
    exact ⟨c.support, c, hc⟩
  obtain ⟨Etop, hEtop⟩ : ∃ E : Finset R, ∀ i ∈ T, ((c i).coeffs : Set R) ⊆ (E : Set R) :=
    ⟨T.biUnion (fun i => (c i).coeffs),
      fun i hi => Finset.coe_subset.mpr
        (Finset.subset_biUnion_of_mem (fun i => (c i).coeffs) hi)⟩

  obtain ⟨G₀, hG₀⟩ : ∃ G₀ : Finset R, ∀ f ∈ s, (f.coeffs : Set R) ⊆ (G₀ : Set R) :=
    ⟨s.biUnion MvPolynomial.coeffs,
      fun f hf => Finset.coe_subset.mpr
        (Finset.subset_biUnion_of_mem (fun f => MvPolynomial.coeffs f) hf)⟩
  obtain ⟨s', hs'⟩ : ∃ s' : Finset (MvPolynomial (Fin n) (Subring.closure (G₀ : Set R))),
      MvPolynomial.map (algebraMap (Subring.closure (G₀ : Set R)) R) ''
        (s' : Set (MvPolynomial (Fin n) (Subring.closure (G₀ : Set R)))) =
        (s : Set (MvPolynomial (Fin n) R)) := by
    have hL : ∀ f : s, ∃ p' : MvPolynomial (Fin n) (Subring.closure (G₀ : Set R)),
        MvPolynomial.map (algebraMap (Subring.closure (G₀ : Set R)) R) p' = f.1 :=
      fun f => Hlift G₀ f.1 (hG₀ f.1 f.2)
    choose L hL using hL
    refine ⟨Finset.univ.image L, ?_⟩
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨f, _, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hx)
      rw [hL f]
      exact f.2
    · intro hy
      exact ⟨L ⟨y, hy⟩, Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨⟨y, hy⟩, Finset.mem_univ _, rfl⟩),
        hL ⟨y, hy⟩⟩
  have hspan' : Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (G₀ : Set R)) R) ''
      (↑s' : Set (MvPolynomial (Fin n) (Subring.closure (G₀ : Set R))))) =
      Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) := by rw [hs']
  have Ha : ∀ i, ∀ x ∈ s₀ i, MvPolynomial.map (algebraMap (Subring.closure (F₀ i : Set R)) R) x ∈
      Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (G₀ : Set R)) R) ''
        (↑s' : Set (MvPolynomial (Fin n) (Subring.closure (G₀ : Set R))))) := by
    intro i x hx
    rw [hspan', ← h1 i]
    exact Ideal.subset_span (Set.mem_image_of_mem _ hx)
  have Hb : ∀ i, ∀ y ∈ s', MvPolynomial.map (algebraMap (Subring.closure (G₀ : Set R)) R) y ∈
      Ideal.span (MvPolynomial.map (algebraMap (Subring.closure (F₀ i : Set R)) R) ''
        (↑(s₀ i) : Set (MvPolynomial (Fin n) (Subring.closure (F₀ i : Set R))))) := by
    intro i y hy
    rw [h1 i]
    apply Ideal.subset_span
    rw [← hs']
    exact Set.mem_image_of_mem _ hy
  choose Ea hEa using fun i (x : s₀ i) => Hdesc (F₀ i) G₀ x.1 _ (Ha i x.1 x.2)
  choose Eb hEb using fun i (y : s') => Hdesc G₀ (F₀ i) y.1 _ (Hb i y.1 y.2)

  obtain ⟨F, hFA, hFG, hFE, hFa, hFb⟩ : ∃ F : Finset R, (∀ i ∈ T, F₀ i ⊆ F) ∧ G₀ ⊆ F ∧
      Etop ⊆ F ∧ (∀ i ∈ T, ∀ x, Ea i x ⊆ F) ∧ (∀ i ∈ T, ∀ y, Eb i y ⊆ F) := by
    refine ⟨T.biUnion F₀ ∪ G₀ ∪ Etop ∪
      T.biUnion (fun i => Finset.univ.biUnion (Ea i) ∪ Finset.univ.biUnion (Eb i)),
      ?_, ?_, ?_, ?_, ?_⟩
    · intro i hi r hr
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_biUnion.mpr ⟨i, hi, hr⟩)))
    · intro r hr
      exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ hr))
    · intro r hr
      exact Finset.mem_union_left _ (Finset.mem_union_right _ hr)
    · intro i hi x r hr
      exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, hi, Finset.mem_union_left _
        (Finset.mem_biUnion.mpr ⟨x, Finset.mem_univ _, hr⟩)⟩)
    · intro i hi y r hr
      exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, hi, Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨y, Finset.mem_univ _, hr⟩)⟩)
  refine ⟨F, T, hFA, s'.image (MvPolynomial.map (Subring.inclusion
    (Subring.closure_mono (Finset.coe_subset.mpr hFG)))), ?_, ?_, ?_⟩
  ·
    rw [Finset.coe_image, Set.image_image, Set.image_congr (fun x _ => Hcomp G₀ F hFG x), hs']
  ·
    intro i hi
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨x, hx, rfl⟩
      rw [Finset.coe_image]
      exact hEa i ⟨x, hx⟩ F (hFA i hi) hFG (hFa i hi ⟨x, hx⟩)
    · rw [Ideal.span_le]
      intro z hz
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hz)
      exact hEb i ⟨y, hy⟩ F hFG (hFA i hi) (hFb i hi ⟨y, hy⟩)
  ·
    have hc' : ∀ i : T, ∃ p' : MvPolynomial (Fin n) (Subring.closure (F : Set R)),
        MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) p' = c i.1 := fun i =>
      Hlift F _ ((hEtop i.1 i.2).trans (Finset.coe_subset.mpr hFE))
    choose c' hc'' using hc'
    rw [Ideal.eq_top_iff_one]
    have heq : ∑ i : T, c' i * MvPolynomial.map (Subring.inclusion
        (Subring.closure_mono (Finset.coe_subset.mpr (hFA i.1 i.2)))) (g₀ i.1) = 1 := by
      apply Hinj F
      rw [map_sum, map_one, ← hc, ← Finset.sum_coe_sort T]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, hc'' i, Hcomp _ _ (hFA i.1 i.2)]
    rw [← heq]
    apply Ideal.sum_mem
    intro i _
    apply Ideal.mul_mem_left
    exact Ideal.subset_span ⟨i, rfl⟩

theorem wcpa_lfg_fa_flat_of_away_cover : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] (J : Ideal C) (t : Set C), Ideal.span t = ⊤ → (∀ h ∈ t, Module.Flat A (Localization.Away h ⧸ J.map (algebraMap C (Localization.Away h)))) → Module.Flat A (C ⧸ J) :=
by
  intro A C _ _ _ J t ht hflat
  have key : ∀ r : C, IsLocalization (Algebra.algebraMapSubmonoid (C ⧸ J) (Submonoid.powers r))
      (Localization.Away r ⧸ J.map (algebraMap C (Localization.Away r))) := by
    intro r
    have h := IsLocalization.of_surjective (M := Submonoid.powers r) (S := Localization.Away r)
      (R' := C ⧸ J) (S' := Localization.Away r ⧸ J.map (algebraMap C (Localization.Away r)))
      (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk (J.map (algebraMap C (Localization.Away r)))) Ideal.Quotient.mk_surjective
      (RingHom.ext fun x => (Ideal.Quotient.algebraMap_quotient_map_quotient x).symm)
      (by rw [Ideal.mk_ker, Ideal.mk_ker])
    exact h
  have : ∀ r : t, IsLocalizedModule.Away (r : C)
      (IsScalarTower.toAlgHom C (C ⧸ J)
        (Localization.Away (r : C) ⧸ J.map (algebraMap C (Localization.Away (r : C))))).toLinearMap :=
    fun r => (isLocalizedModule_iff_isLocalization (S := Submonoid.powers (r : C))).mpr (key r)
  exact Module.flat_of_isLocalized_span (R := A) C (C ⧸ J) t ht
    (fun r : t => Localization.Away (r : C) ⧸ J.map (algebraMap C (Localization.Away (r : C))))
    (fun r => (IsScalarTower.toAlgHom C (C ⧸ J)
        (Localization.Away (r : C) ⧸ J.map (algebraMap C (Localization.Away (r : C))))).toLinearMap)
    (fun r => hflat r.1 r.2)

theorem wcpa_lfg_fa_tensor_quot : ∀ (R₀ R : Type u) [CommRing R₀] [CommRing R] [Algebra R₀ R] (n : ℕ) (s₀ : Set (MvPolynomial (Fin n) R₀)), Nonempty (TensorProduct R₀ R (MvPolynomial (Fin n) R₀ ⧸ Ideal.span s₀) ≃ₐ[R] MvPolynomial (Fin n) R ⧸ Ideal.span (MvPolynomial.map (algebraMap R₀ R) '' s₀)) :=
by
  intro R₀ R _ _ _ n s₀
  classical
  set I₀ : Ideal (MvPolynomial (Fin n) R₀) := Ideal.span s₀ with hI₀
  let g := Ideal.Quotient.mkₐ R₀ I₀
  have hg : Function.Surjective g := Ideal.Quotient.mkₐ_surjective R₀ I₀
  let Φ : TensorProduct R₀ R (MvPolynomial (Fin n) R₀) →ₐ[R]
      TensorProduct R₀ R (MvPolynomial (Fin n) R₀ ⧸ I₀) :=
    Algebra.TensorProduct.map (AlgHom.id R R) g
  have hΦ : Function.Surjective Φ :=
    Algebra.TensorProduct.map_surjective _ _ Function.surjective_id hg
  have hker : RingHom.ker Φ = Ideal.map (Algebra.TensorProduct.includeRight) I₀ := by
    have h := Algebra.TensorProduct.lTensor_ker (A := R) g hg
    have hkg : RingHom.ker g = I₀ := Ideal.Quotient.mkₐ_ker R₀ I₀
    rw [hkg] at h
    have hfun : ∀ x, Φ x = Algebra.TensorProduct.map (AlgHom.id R₀ R) g x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a p => simp only [Φ, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    ext x
    rw [RingHom.mem_ker, hfun, ← RingHom.mem_ker, h]
  let T := MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) R₀ R
  have hJ : Ideal.span (MvPolynomial.map (algebraMap R₀ R) '' s₀) =
      Ideal.map (T : TensorProduct R₀ R (MvPolynomial (Fin n) R₀) →+* MvPolynomial (Fin n) R)
        (RingHom.ker Φ) := by
    rw [hker, hI₀, Ideal.map_span, Ideal.map_span, Set.image_image]
    congr 1
    apply Set.image_congr
    intro p _
    simp [T, Algebra.TensorProduct.includeRight_apply, MvPolynomial.algebraTensorAlgEquiv_tmul]
  exact ⟨(Ideal.quotientKerAlgEquivOfSurjective hΦ).symm.trans
    (Ideal.quotientEquivAlg (RingHom.ker Φ) _ T hJ)⟩

theorem wcpa_lfg_fa_closure_finiteType : ∀ (R : Type u) [CommRing R] (F : Finset R), Algebra.FiniteType ℤ (Subring.closure (F : Set R)) :=
by
  intro R _ F
  exact Algebra.FiniteType.equiv (Algebra.FiniteType.adjoin_of_finite F.finite_toSet)
    (Subring.closureEquivAdjoinInt (F : Set R)).symm

theorem wcpa_lfg_pgi_flat_approx : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.FinitePresentation R S] [Module.Flat R S], ∃ (R₀ S₀ : Type u) (_ : CommRing R₀) (_ : CommRing S₀) (_ : Algebra.FiniteType ℤ R₀) (_ : Algebra R₀ S₀) (_ : Algebra.FiniteType R₀ S₀) (_ : Module.Flat R₀ S₀) (_ : Algebra R₀ R), Nonempty (TensorProduct R₀ R S₀ ≃ₐ[R] S) :=
by
  intro R S _ _ _ _ _
  classical

  obtain ⟨n, π, hπ, hker⟩ := (inferInstance : Algebra.FinitePresentation R S).out
  obtain ⟨s, hs⟩ := hker
  obtain ⟨e₁⟩ : Nonempty ((MvPolynomial (Fin n) R ⧸ Ideal.span (↑s : Set (MvPolynomial (Fin n) R)))
      ≃ₐ[R] S) :=
    ⟨(Ideal.quotientEquivAlgOfEq R hs).trans (Ideal.quotientKerAlgEquivOfSurjective hπ)⟩
  have hflatC : Module.Flat R (MvPolynomial (Fin n) R ⧸ Ideal.span (↑s : Set (MvPolynomial (Fin n) R))) :=
    Module.Flat.of_linearEquiv e₁.toLinearEquiv

  have key : ∀ P : PrimeSpectrum (MvPolynomial (Fin n) R), ∃ (F : Finset R)
      (s₁ : Finset (MvPolynomial (Fin n) (Subring.closure (F : Set R))))
      (g₁ : MvPolynomial (Fin n) (Subring.closure (F : Set R))),
      Ideal.span ((MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R)) ''
        (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))) =
        Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) ∧
      MvPolynomial.map (algebraMap (Subring.closure (F : Set R)) R) g₁ ∉ P.asIdeal ∧
      Module.Flat (Subring.closure (F : Set R)) (Localization.Away g₁ ⧸
        (Ideal.span (↑s₁ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))).map
          (algebraMap (MvPolynomial (Fin n) (Subring.closure (F : Set R))) (Localization.Away g₁))) := by
    intro P
    haveI := P.isPrime
    have hq := wcpa_lfg_fa_flat_localize R (MvPolynomial (Fin n) R) _ hflatC P.asIdeal
    obtain ⟨R₀, _, hft, _, s₀, hsp, hfl⟩ := wcpa_lfg_fa_descend_ft R n s P.asIdeal hq
    haveI := Algebra.FiniteType.isNoetherianRing ℤ R₀
    obtain ⟨F, hF⟩ := wcpa_lfg_fa_ft_image_closure R₀ R (algebraMap R₀ R)
    obtain ⟨s₁, g₁, e1, e2, e3⟩ := wcpa_lfg_fa_local_model R n P.asIdeal _ R₀ s₀ F hF hsp hfl
    exact ⟨F, s₁, g₁, e1, e2, e3⟩
  choose F₀ s₀' g₀ h1 h2 h3 using key

  have htop0 : Ideal.span (Set.range fun P =>
      MvPolynomial.map (algebraMap (Subring.closure (F₀ P : Set R)) R) (g₀ P)) = ⊤ := by
    by_contra hne
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
    exact h2 ⟨M, hM.isPrime⟩ (hle (Ideal.subset_span ⟨⟨M, hM.isPrime⟩, rfl⟩))

  obtain ⟨F, T, hF, s₂, hspan₂, hJi, htop⟩ :=
    wcpa_lfg_fa_common_level R n s (PrimeSpectrum (MvPolynomial (Fin n) R)) F₀ s₀' g₀ h1 htop0

  have gen : ∀ (A B : Type u) [CommRing A] [CommRing B] (ρ : A →+* B)
      (t₀ : Set (MvPolynomial (Fin n) A)) (t : Set (MvPolynomial (Fin n) B))
      (g : MvPolynomial (Fin n) A),
      Ideal.span (MvPolynomial.map ρ '' t₀) = Ideal.span t →
      Module.Flat A (Localization.Away g ⧸
        (Ideal.span t₀).map (algebraMap (MvPolynomial (Fin n) A) (Localization.Away g))) →
      Module.Flat B (Localization.Away (MvPolynomial.map ρ g) ⧸
        (Ideal.span t).map (algebraMap (MvPolynomial (Fin n) B)
          (Localization.Away (MvPolynomial.map ρ g)))) := by
    intro A B _ _ ρ t₀ t g h hfl
    letI : Algebra A B := ρ.toAlgebra
    have hb := wcpa_ffp_flat_base_change A B n (Ideal.span t₀) g hfl
    rw [Ideal.map_span] at hb
    have e : (MvPolynomial.map (algebraMap A B) : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) B)
        = MvPolynomial.map ρ := rfl
    rw [e, h] at hb
    exact hb
  have hpiece : ∀ h ∈ Set.range (fun i : T => MvPolynomial.map (Subring.inclusion
      (Subring.closure_mono (Finset.coe_subset.mpr (hF i.1 i.2)))) (g₀ i.1)),
      Module.Flat (Subring.closure (F : Set R)) (Localization.Away h ⧸
        (Ideal.span (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))).map
          (algebraMap (MvPolynomial (Fin n) (Subring.closure (F : Set R))) (Localization.Away h))) := by
    rintro _ ⟨⟨i, hi⟩, rfl⟩
    exact gen _ _ (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr (hF i hi))))
      _ _ (g₀ i) (hJi i hi) (h3 i)

  have hflat₀ := wcpa_lfg_fa_flat_of_away_cover (Subring.closure (F : Set R))
    (MvPolynomial (Fin n) (Subring.closure (F : Set R)))
    (Ideal.span (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))) _ htop hpiece

  obtain ⟨e₂⟩ := wcpa_lfg_fa_tensor_quot (Subring.closure (F : Set R)) R n
    (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R))))
  exact ⟨Subring.closure (F : Set R),
    MvPolynomial (Fin n) (Subring.closure (F : Set R)) ⧸
      Ideal.span (↑s₂ : Set (MvPolynomial (Fin n) (Subring.closure (F : Set R)))),
    inferInstance, inferInstance, wcpa_lfg_fa_closure_finiteType R F, inferInstance,
    inferInstance, hflat₀, inferInstance,
    ⟨e₂.trans ((Ideal.quotientEquivAlgOfEq R hspan₂).trans e₁)⟩⟩

theorem wcpa_lfg_gid_finite_stage : ∀ (R₀ R : Type u) [CommRing R₀] [IsNoetherianRing R₀] [CommRing R] [Algebra R₀ R] (G : Ideal R₀ → Prop), (∀ (P : Ideal R) [P.IsPrime], G (P.comap (algebraMap R₀ R))) → (∀ (p : Ideal R₀) [p.IsPrime], G p → ∃ a : R₀, a ∉ p ∧ ∀ (q : Ideal R₀) [q.IsPrime], p ≤ q → a ∉ q → G q) → ∃ T : Finset R, ∀ (P : Ideal (Algebra.adjoin R₀ (T : Set R))) [P.IsPrime], G (P.comap (algebraMap R₀ (Algebra.adjoin R₀ (T : Set R)))) :=
by
  intro R₀ R _ _ _ _ G H1 H2
  classical

  have witness : ∀ (I : Ideal R₀) (s : R₀), algebraMap R₀ R s ∈ I.map (algebraMap R₀ R) →
      ∃ T : Finset R, ∀ T' : Finset R, T ⊆ T' →
        algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R)) s ∈
          I.map (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R))) := by
    intro I s hs
    change algebraMap R₀ R s ∈ Submodule.span R (⇑(algebraMap R₀ R) '' (I : Set R₀)) at hs
    rw [Submodule.mem_span_set'] at hs
    obtain ⟨n, c, g, hcg⟩ := hs
    choose t ht htg using fun i => (g i).2
    refine ⟨Finset.image c Finset.univ, fun T' hT' => ?_⟩
    have hc : ∀ i, c i ∈ Algebra.adjoin R₀ (T' : Set R) := fun i =>
      Algebra.subset_adjoin (Finset.mem_coe.mpr (hT' (Finset.mem_image_of_mem c (Finset.mem_univ i))))
    have key : algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R)) s =
        ∑ i, (⟨c i, hc i⟩ : Algebra.adjoin R₀ (T' : Set R)) *
          algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R)) (t i) := by
      apply Subtype.val_injective
      rw [Subalgebra.coe_algebraMap, ← hcg]
      push_cast
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [smul_eq_mul, ← htg i]
    rw [key]
    exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (ht i)))

  have dich : ∀ (I : Ideal R₀) [I.IsPrime],
      (∃ P : Ideal R, P.IsPrime ∧ P.comap (algebraMap R₀ R) = I) ∨
      (∃ s : R₀, s ∉ I ∧ algebraMap R₀ R s ∈ I.map (algebraMap R₀ R)) := by
    intro I _
    by_cases h : (I.map (algebraMap R₀ R)).comap (algebraMap R₀ R) = I
    · left
      exact (Ideal.comap_map_eq_self_iff_of_isPrime (f := algebraMap R₀ R) I).mp h
    · right
      have hlt : I < (I.map (algebraMap R₀ R)).comap (algebraMap R₀ R) :=
        lt_of_le_of_ne Ideal.le_comap_map (Ne.symm h)
      obtain ⟨_, s, hs, hsI⟩ := SetLike.lt_iff_le_and_exists.mp hlt
      exact ⟨s, hsI, Ideal.mem_comap.mp hs⟩
  have ext : ∀ (I : Ideal R₀) (y : R₀), y ∉ I → I < I ⊔ Ideal.span {y} := fun I y hy =>
    left_lt_sup.mpr (fun h => hy ((Ideal.span_singleton_le_iff_mem I).mp h))
  have ext2 : ∀ (I Q : Ideal R₀) (y : R₀), I ≤ Q → y ∈ Q → I ⊔ Ideal.span {y} ≤ Q :=
    fun I Q y h1 h2 => sup_le h1 ((Ideal.span_singleton_le_iff_mem Q).mpr h2)

  have main : ∀ I : Ideal R₀, ∃ T : Finset R, ∀ T' : Finset R, T ⊆ T' →
      ∀ (P : Ideal (Algebra.adjoin R₀ (T' : Set R))) [P.IsPrime],
        I ≤ P.comap (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R))) →
        G (P.comap (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R)))) := by
    intro I0
    induction I0 using WellFoundedGT.induction with
    | _ I IH =>
    by_cases htop : I = ⊤
    · refine ⟨∅, fun T' _ P _ hle => ?_⟩
      exfalso
      have hQ : (P.comap (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R)))).IsPrime :=
        inferInstance
      rw [htop] at hle
      exact hQ.ne_top (top_le_iff.mp hle)
    by_cases hp : I.IsPrime
    swap
    · have hxy : ∃ x y, x * y ∈ I ∧ x ∉ I ∧ y ∉ I := by
        by_contra hne
        push_neg at hne
        exact hp ((Ideal.isPrime_iff).mpr ⟨htop, fun {x y} hxy => by
          by_contra h
          push_neg at h
          exact h.2 (hne x y hxy h.1)⟩)
      obtain ⟨x, y, hxy, hx, hy⟩ := hxy
      obtain ⟨T₁, hT₁⟩ := IH _ (ext I x hx)
      obtain ⟨T₂, hT₂⟩ := IH _ (ext I y hy)
      refine ⟨T₁ ∪ T₂, fun T' hT' P _ hle => ?_⟩
      have hQ : (P.comap (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R)))).IsPrime :=
        inferInstance
      rcases hQ.mem_or_mem (hle hxy) with h | h
      · exact hT₁ T' (Finset.subset_union_left.trans hT') P (ext2 _ _ _ hle h)
      · exact hT₂ T' (Finset.subset_union_right.trans hT') P (ext2 _ _ _ hle h)
    · haveI := hp
      rcases dich I with ⟨P₀, hP₀, hc⟩ | ⟨s, hs, hsm⟩
      · haveI := hP₀
        have hGI : G I := hc ▸ H1 P₀
        obtain ⟨a, haI, ha⟩ := H2 I hGI
        obtain ⟨T₁, hT₁⟩ := IH _ (ext I a haI)
        refine ⟨T₁, fun T' hT' P _ hle => ?_⟩
        by_cases haQ : a ∈ P.comap (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R)))
        · exact hT₁ T' hT' P (ext2 _ _ _ hle haQ)
        · exact ha _ hle haQ
      · obtain ⟨Ts, hTs⟩ := witness I s hsm
        obtain ⟨T₁, hT₁⟩ := IH _ (ext I s hs)
        refine ⟨T₁ ∪ Ts, fun T' hT' P _ hle => ?_⟩
        have hmap : I.map (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R))) ≤ P :=
          Ideal.map_le_iff_le_comap.mpr hle
        have hsQ : s ∈ P.comap (algebraMap R₀ (Algebra.adjoin R₀ (T' : Set R))) :=
          Ideal.mem_comap.mpr (hmap (hTs T' (Finset.subset_union_right.trans hT')))
        exact hT₁ T' (Finset.subset_union_left.trans hT') P (ext2 _ _ _ hle hsQ)
  obtain ⟨T, hT⟩ := main ⊥
  exact ⟨T, fun P _ => hT T (Finset.Subset.refl _) P bot_le⟩

theorem wcpa_gs_geom_integral_fraction_field : ∀ (K D : Type u) [Field K] [CommRing D] [IsDomain D] [Algebra K D], (∀ (L : Type u) [Field L] [Algebra K L], IsDomain (TensorProduct K L D)) → ∀ (L : Type u) [Field L] [Algebra K L], IsDomain (TensorProduct K L (FractionRing D)) :=
by
  intro K D _ _ _ _ hGI L _ _
  classical
  haveI hD : IsDomain (TensorProduct K L D) := hGI L
  let j : D →+* FractionRing D := algebraMap D (FractionRing D)
  have hj : Function.Injective j := IsFractionRing.injective D (FractionRing D)
  let ι : TensorProduct K L D →ₐ[K] TensorProduct K L (FractionRing D) :=
    Algebra.TensorProduct.map (AlgHom.id K L) (IsScalarTower.toAlgHom K D (FractionRing D))
  have hιt : ∀ (l : L) (a : D), ι (l ⊗ₜ[K] a) = l ⊗ₜ[K] j a := fun l a => by
    simp [ι, j]

  have hι : Function.Injective ι := by
    have h1 : (⇑ι) = ⇑(LinearMap.lTensor L
        (IsScalarTower.toAlgHom K D (FractionRing D)).toLinearMap) := rfl
    rw [h1]
    exact Module.Flat.lTensor_preserves_injective_linearMap _ hj

  have hcd : ∀ z : TensorProduct K L (FractionRing D), ∃ (w : TensorProduct K L D) (s : D),
      s ≠ 0 ∧ z * ((1 : L) ⊗ₜ[K] j s) = ι w := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, 1, one_ne_zero, by simp⟩
    | tmul l q =>
      obtain ⟨⟨a, t⟩, hq⟩ := IsLocalization.mk'_surjective (nonZeroDivisors D) q
      refine ⟨l ⊗ₜ[K] a, (t : D), nonZeroDivisors.ne_zero t.2, ?_⟩
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, hιt]
      have hspec : q * j (t : D) = j a := by
        rw [← hq]
        exact IsLocalization.mk'_spec (FractionRing D) a t
      rw [hspec]
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨w₁, s₁, hs₁, e₁⟩ := h₁
      obtain ⟨w₂, s₂, hs₂, e₂⟩ := h₂
      refine ⟨w₁ * ((1 : L) ⊗ₜ[K] s₂) + w₂ * ((1 : L) ⊗ₜ[K] s₁), s₁ * s₂,
        mul_ne_zero hs₁ hs₂, ?_⟩
      have hsplit : ((1 : L) ⊗ₜ[K] j (s₁ * s₂)) =
          ((1 : L) ⊗ₜ[K] j s₁) * ((1 : L) ⊗ₜ[K] j s₂) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, map_mul]
      have hw : ι (w₁ * ((1 : L) ⊗ₜ[K] s₂) + w₂ * ((1 : L) ⊗ₜ[K] s₁)) =
          ι w₁ * ((1 : L) ⊗ₜ[K] j s₂) + ι w₂ * ((1 : L) ⊗ₜ[K] j s₁) := by
        rw [map_add, map_mul ι w₁, map_mul ι w₂, hιt, hιt]
      rw [hw, hsplit, ← e₁, ← e₂]
      ring

  have hunit : ∀ s : D, s ≠ 0 → IsUnit ((1 : L) ⊗ₜ[K] j s) := by
    intro s hs
    have hjs : j s ≠ 0 := fun h => hs (hj (h.trans (map_zero j).symm))
    refine IsUnit.of_mul_eq_one ((1 : L) ⊗ₜ[K] (j s)⁻¹) ?_
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_inv_cancel₀ hjs]
    rfl

  haveI : Nontrivial (TensorProduct K L (FractionRing D)) := by
    refine ⟨⟨1, 0, fun h => ?_⟩⟩
    apply (one_ne_zero : (1 : TensorProduct K L D) ≠ 0)
    apply hι
    rw [map_one, map_zero]
    exact h

  haveI : NoZeroDivisors (TensorProduct K L (FractionRing D)) := by
    refine ⟨fun {z₁ z₂} h => ?_⟩
    obtain ⟨w₁, s₁, hs₁, e₁⟩ := hcd z₁
    obtain ⟨w₂, s₂, hs₂, e₂⟩ := hcd z₂
    have hw : ι (w₁ * w₂) = ι 0 := by
      rw [map_mul, ← e₁, ← e₂, map_zero]
      calc z₁ * ((1 : L) ⊗ₜ[K] j s₁) * (z₂ * ((1 : L) ⊗ₜ[K] j s₂))
          = (z₁ * z₂) * (((1 : L) ⊗ₜ[K] j s₁) * ((1 : L) ⊗ₜ[K] j s₂)) := by ring
        _ = 0 := by rw [h, zero_mul]
    rcases mul_eq_zero.mp (hι hw) with h0 | h0
    · left
      rw [h0, map_zero] at e₁
      exact (hunit s₁ hs₁).mul_left_eq_zero.mp e₁
    · right
      rw [h0, map_zero] at e₂
      exact (hunit s₂ hs₂).mul_left_eq_zero.mp e₂
  exact NoZeroDivisors.to_isDomain _

theorem wcpa_gs_separating_primitive : ∀ (K D : Type u) [Field K] [CommRing D] [IsDomain D] [Algebra K D] [Algebra.FiniteType K D], (∀ (L : Type u) [Field L] [Algebra K L], IsDomain (TensorProduct K L (FractionRing D))) → ∃ (d : ℕ) (x : Fin d → FractionRing D) (y : FractionRing D), IsTranscendenceBasis K x ∧ IntermediateField.adjoin K (insert y (Set.range x)) = ⊤ :=
by
  intro K D _ _ _ _ _ h
  classical
  have key : ∀ (E : Type u) [Field E] [Algebra K E] [Algebra.EssFiniteType K E] [FinTrdeg K E],
      (∀ (L : Type u) [Field L] [Algebra K L], IsDomain (TensorProduct K L E)) →
      ∃ (d : ℕ) (x : Fin d → E) (y : E), IsTranscendenceBasis K x ∧
        IntermediateField.adjoin K (insert y (Set.range x)) = ⊤ := by
    intro E _ _ _ _ hE

    have H : ∀ p : ℕ, CharP K p → p.Prime → ∀ s : Finset E, LinearIndepOn K id (↑s : Set E) →
        LinearIndepOn K (fun x : E => x ^ p) (↑s : Set E) := by
      intro p hcp hp s hs
      haveI : Fact p.Prime := ⟨hp⟩
      have hs' := hs
      rw [linearIndepOn_finset_iff] at hs ⊢
      intro f hf
      haveI hR : IsDomain (TensorProduct K (AlgebraicClosure K) E) := hE (AlgebraicClosure K)
      have hpow : ∀ i : E, ∃ z : AlgebraicClosure K,
          z ^ p = algebraMap K (AlgebraicClosure K) (f i) :=
        fun i => IsAlgClosed.exists_pow_nat_eq _ hp.pos
      choose b hb using hpow
      haveI : CharP (TensorProduct K (AlgebraicClosure K) E) p :=
        charP_of_injective_algebraMap (algebraMap K (TensorProduct K (AlgebraicClosure K) E)).injective p
      have hz : (∑ i ∈ s, b i ⊗ₜ[K] i : TensorProduct K (AlgebraicClosure K) E) = 0 := by
        have h1 : (∑ i ∈ s, b i ⊗ₜ[K] i : TensorProduct K (AlgebraicClosure K) E) ^ p = 0 := by
          rw [sum_pow_char]
          have h2 : ∀ i ∈ s, (b i ⊗ₜ[K] i : TensorProduct K (AlgebraicClosure K) E) ^ p =
              (1 : AlgebraicClosure K) ⊗ₜ[K] (f i • i ^ p) := by
            intro i _
            rw [Algebra.TensorProduct.tmul_pow, hb, Algebra.algebraMap_eq_smul_one,
              TensorProduct.smul_tmul]
          rw [Finset.sum_congr rfl h2, ← TensorProduct.tmul_sum, hf, TensorProduct.tmul_zero]
        exact (pow_eq_zero_iff hp.ne_zero).mp h1
      have hli : LinearIndepOn (AlgebraicClosure K)
          (fun e : E => (1 : AlgebraicClosure K) ⊗ₜ[K] e) (↑s : Set E) :=
        Module.Flat.linearIndependent_one_tmul hs'
      rw [linearIndepOn_finset_iff] at hli
      have hb0 := hli b (by
        rw [← hz]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one])
      intro i hi
      have e1 := hb i
      rw [hb0 i hi, zero_pow hp.ne_zero] at e1
      exact (algebraMap K (AlgebraicClosure K)).injective (by rw [← e1, map_zero])

    obtain ⟨s, hfin, hb, hsep⟩ : ∃ s : Set E, s.Finite ∧
        IsTranscendenceBasis K (Subtype.val : s → E) ∧
        Algebra.IsSeparable (IntermediateField.adjoin K s) E := by
      obtain ⟨p, hcp⟩ := CharP.exists K
      rcases CharP.char_is_prime_or_zero K p with hp | hp
      · haveI : ExpChar K p := ExpChar.prime hp
        obtain ⟨t, ht1, ht2⟩ :=
          exists_isTranscendenceBasis_and_isSeparable_of_linearIndepOn_pow_of_essFiniteType
            p hp (H p hcp hp)
        exact ⟨↑t, t.finite_toSet, ht1, ht2⟩
      · subst hp
        haveI : CharZero K := CharP.charP_to_charZero K
        haveI : PerfectField K := PerfectField.ofCharZero
        obtain ⟨t, ht1, ht2⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField K E
        exact ⟨↑t, t.finite_toSet, ht1, ht2⟩

    obtain ⟨d, x, hx, hrange⟩ : ∃ (d : ℕ) (x : Fin d → E), IsTranscendenceBasis K x ∧
        Set.range x = s := by
      haveI := hfin.to_subtype
      let e := Finite.equivFin ↥s
      refine ⟨Nat.card ↥s, Subtype.val ∘ e.symm, hb.comp_equiv e.symm, ?_⟩
      rw [e.symm.surjective.range_comp, Subtype.range_coe]
    subst hrange
    haveI : Algebra.EssFiniteType (IntermediateField.adjoin K (Set.range x)) E :=
      Algebra.EssFiniteType.of_comp K _ E
    haveI : Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range x)) E :=
      hx.isAlgebraic_field
    haveI : Module.Finite (IntermediateField.adjoin K (Set.range x)) E :=
      Algebra.finite_of_essFiniteType_of_isAlgebraic
    obtain ⟨α, hα⟩ := Field.exists_primitive_element (IntermediateField.adjoin K (Set.range x)) E
    refine ⟨d, x, α, hx, ?_⟩
    have h3 := IntermediateField.adjoin_adjoin_left K (Set.range x) {α}
    rw [hα, IntermediateField.restrictScalars_top, Set.union_singleton] at h3
    exact h3.symm
  exact key (FractionRing D) h

theorem wcpa_gs_monic_model : ∀ (A K E : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K] [Field E] [Algebra A E] [Algebra K E] [IsScalarTower A K E] (d : ℕ) (x : Fin d → E) (y : E), IsTranscendenceBasis K x → IntermediateField.adjoin K (insert y (Set.range x)) = ⊤ → ∃ (F : MvPolynomial (Fin (d + 1)) A) (v : Fin (d + 1) → E), (MvPolynomial.finSuccEquiv A d F).Monic ∧ 1 ≤ (MvPolynomial.finSuccEquiv A d F).natDegree ∧ MvPolynomial.aeval v F = 0 ∧ (∀ h : MvPolynomial (Fin (d + 1)) K, MvPolynomial.aeval v h = 0 → h ∈ Ideal.span {MvPolynomial.map (algebraMap A K) F}) ∧ (∀ h : MvPolynomial (Fin (d + 1)) A, MvPolynomial.aeval v h = 0 → h ∈ Ideal.span {F}) ∧ ∀ e : E, ∃ h h' : MvPolynomial (Fin (d + 1)) A, MvPolynomial.aeval v h' ≠ 0 ∧ e = MvPolynomial.aeval v h / MvPolynomial.aeval v h' :=
by
  intro A K E _ _ _ _ _ _ _ _ _ d x y hx hgen
  classical

  have s0 : ∀ (n : ℕ) (h : MvPolynomial (Fin n) K), ∃ (c : A) (h₀ : MvPolynomial (Fin n) A),
      c ≠ 0 ∧ MvPolynomial.map (algebraMap A K) h₀ = MvPolynomial.C (algebraMap A K c) * h := by
    intro n h
    letI : Algebra (MvPolynomial (Fin n) A) (MvPolynomial (Fin n) K) :=
      MvPolynomial.algebraMvPolynomial
    haveI : IsLocalization ((nonZeroDivisors A).map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A))
        (MvPolynomial (Fin n) K) := MvPolynomial.isLocalization (nonZeroDivisors A) K
    obtain ⟨⟨h₀, ⟨b, hb⟩⟩, e⟩ := IsLocalization.surj
      ((nonZeroDivisors A).map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)) h
    obtain ⟨c, hc, rfl⟩ := Submonoid.mem_map.mp hb
    refine ⟨c, h₀, nonZeroDivisors.ne_zero hc, ?_⟩
    change h * MvPolynomial.map (algebraMap A K) (MvPolynomial.C c) =
      MvPolynomial.map (algebraMap A K) h₀ at e
    rw [MvPolynomial.map_C] at e
    rw [← e, mul_comm]

  have s1 : ∀ (z : E) (h : MvPolynomial (Fin (d + 1)) A),
      MvPolynomial.aeval (Fin.cons z x : Fin (d + 1) → E) h =
        Polynomial.eval₂ (MvPolynomial.aeval x : MvPolynomial (Fin d) A →ₐ[A] E).toRingHom z
          (MvPolynomial.finSuccEquiv A d h) := by
    intro z h
    induction h using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.aeval_C, ← MvPolynomial.algebraMap_eq, AlgEquiv.commutes,
        Polynomial.algebraMap_apply, Polynomial.eval₂_C, MvPolynomial.algebraMap_eq]
      simp
    | add p q hp hq => simp only [map_add, Polynomial.eval₂_add, hp, hq]
    | mul_X p i hp =>
      rw [map_mul, map_mul, Polynomial.eval₂_mul, hp]
      congr 1
      refine Fin.cases ?_ ?_ i
      · simp [MvPolynomial.finSuccEquiv_X_zero]
      · intro j; simp [MvPolynomial.finSuccEquiv_X_succ]

  have hφ : Function.Injective (MvPolynomial.aeval x : MvPolynomial (Fin d) A →ₐ[A] E) := by
    have h1 := algebraicIndependent_iff_injective_aeval.mp hx.1
    intro p q hpq
    apply MvPolynomial.map_injective _ (IsFractionRing.injective A K)
    apply h1
    simp only [MvPolynomial.aeval_map_algebraMap]
    exact hpq

  have s3 : ∃ P : Polynomial (MvPolynomial (Fin d) A), P ≠ 0 ∧
      Polynomial.eval₂ (MvPolynomial.aeval x : MvPolynomial (Fin d) A →ₐ[A] E).toRingHom y P = 0 := by
    haveI := hx.isAlgebraic
    obtain ⟨p, hp0, hpy⟩ := Algebra.IsAlgebraic.isAlgebraic (R := Algebra.adjoin K (Set.range x)) y
    set e := hx.1.aevalEquiv with he
    set p' : Polynomial (MvPolynomial (Fin d) K) :=
      p.map (e.symm : Algebra.adjoin K (Set.range x) →+* MvPolynomial (Fin d) K) with hp'
    have hp'0 : p' ≠ 0 := (Polynomial.map_ne_zero_iff e.symm.injective).mpr hp0
    have hg : ((MvPolynomial.aeval x : MvPolynomial (Fin d) K →ₐ[K] E).toRingHom).comp
        (e.symm : Algebra.adjoin K (Set.range x) →+* MvPolynomial (Fin d) K) =
        algebraMap (Algebra.adjoin K (Set.range x)) E := by
      apply RingHom.ext
      intro z
      obtain ⟨q, rfl⟩ := e.surjective z
      rw [RingHom.comp_apply]
      rw [he, hx.1.algebraMap_aevalEquiv]
      simp
    have hp'y : Polynomial.eval₂ (MvPolynomial.aeval x : MvPolynomial (Fin d) K →ₐ[K] E).toRingHom
        y p' = 0 := by
      rw [hp', Polynomial.eval₂_map, hg, ← Polynomial.aeval_def, hpy]
    letI : Algebra (MvPolynomial (Fin d) A) (MvPolynomial (Fin d) K) :=
      MvPolynomial.algebraMvPolynomial
    haveI : IsLocalization ((nonZeroDivisors A).map (MvPolynomial.C : A →+* MvPolynomial (Fin d) A))
        (MvPolynomial (Fin d) K) := MvPolynomial.isLocalization (nonZeroDivisors A) K
    refine ⟨IsLocalization.integerNormalization
      ((nonZeroDivisors A).map (MvPolynomial.C : A →+* MvPolynomial (Fin d) A)) p', ?_, ?_⟩
    · intro h0
      obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec
        ((nonZeroDivisors A).map (MvPolynomial.C : A →+* MvPolynomial (Fin d) A)) p'
      obtain ⟨c, hc, hbc⟩ := Submonoid.mem_map.mp hbM
      obtain ⟨i, hi⟩ : ∃ i, p'.coeff i ≠ 0 := by
        by_contra hall
        push_neg at hall
        exact hp'0 (Polynomial.ext (by simpa using hall))
      have := congrArg (fun z => Polynomial.coeff z i) hb
      rw [h0, Polynomial.map_zero, Polynomial.coeff_zero, Polynomial.coeff_smul, Algebra.smul_def,
        ← hbc, MvPolynomial.algebraMap_def, MvPolynomial.map_C] at this
      have hc' : (MvPolynomial.C (algebraMap A K c) : MvPolynomial (Fin d) K) ≠ 0 :=
        (map_ne_zero_iff _ (MvPolynomial.C_injective _ _)).mpr
          (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hc)
      exact (mul_ne_zero hc' hi) this.symm
    · have := IsLocalization.integerNormalization_eval₂_eq_zero
        ((nonZeroDivisors A).map (MvPolynomial.C : A →+* MvPolynomial (Fin d) A))
        (MvPolynomial.aeval x : MvPolynomial (Fin d) K →ₐ[K] E).toRingHom p' hp'y
      have hcomp : ((MvPolynomial.aeval x : MvPolynomial (Fin d) K →ₐ[K] E).toRingHom).comp
          (algebraMap (MvPolynomial (Fin d) A) (MvPolynomial (Fin d) K)) =
          (MvPolynomial.aeval x : MvPolynomial (Fin d) A →ₐ[A] E).toRingHom := by
        apply RingHom.ext
        intro q
        rw [RingHom.comp_apply, MvPolynomial.algebraMap_def]
        exact MvPolynomial.aeval_map_algebraMap K x q
      rw [hcomp] at this
      exact this

  have s4 : ∀ (R : Type u) [CommRing R] [IsDomain R] (φ : R →+* E), Function.Injective φ →
      ∀ (P : Polynomial R), P ≠ 0 → Polynomial.eval₂ φ y P = 0 →
      ∃ (M : Polynomial R) (l : R), l ≠ 0 ∧ M.Monic ∧ 1 ≤ M.natDegree ∧
        Polynomial.eval₂ φ (φ l * y) M = 0 ∧
        ∀ Q : Polynomial R, Polynomial.eval₂ φ (φ l * y) Q = 0 → M ∣ Q := by
    intro R _ _ φ hφR P hP hPy
    have hex : ∃ n, ∃ P : Polynomial R, P ≠ 0 ∧ Polynomial.eval₂ φ y P = 0 ∧ P.natDegree = n :=
      ⟨_, P, hP, hPy, rfl⟩
    obtain ⟨P₀, hP₀, hP₀y, hdeg⟩ := Nat.find_spec hex
    have hmin : ∀ k < Nat.find hex,
        ¬ ∃ P : Polynomial R, P ≠ 0 ∧ Polynomial.eval₂ φ y P = 0 ∧ P.natDegree = k :=
      fun k hk => Nat.find_min hex hk
    have hm1 : 1 ≤ P₀.natDegree := by
      by_contra h0
      push_neg at h0
      have hm0 : P₀.natDegree = 0 := by omega
      rw [Polynomial.eq_C_of_natDegree_eq_zero hm0, Polynomial.eval₂_C] at hP₀y
      have hc : P₀.coeff 0 = 0 := hφR (by rw [hP₀y, map_zero])
      apply hP₀
      rw [Polynomial.eq_C_of_natDegree_eq_zero hm0, hc, map_zero]
    have hl : P₀.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hP₀
    have hMm : P₀.integralNormalization.Monic := Polynomial.monic_integralNormalization hP₀
    have hMdeg : P₀.integralNormalization.natDegree = P₀.natDegree :=
      Polynomial.natDegree_integralNormalization
    have hMt : Polynomial.eval₂ φ (φ P₀.leadingCoeff * y) P₀.integralNormalization = 0 := by
      rw [Polynomial.integralNormalization_eval₂_leadingCoeff_mul hm1 φ y, hP₀y, mul_zero]
    refine ⟨P₀.integralNormalization, P₀.leadingCoeff, hl, hMm, by omega, hMt, ?_⟩
    intro Q hQ
    rw [← Polynomial.modByMonic_eq_zero_iff_dvd hMm]
    by_contra hr
    have hrt : Polynomial.eval₂ φ (φ P₀.leadingCoeff * y) (Q %ₘ P₀.integralNormalization) = 0 := by
      rw [Polynomial.eval₂_modByMonic_eq_self_of_root (p := Q) hMt]; exact hQ
    have hM1 : P₀.integralNormalization ≠ 1 := by
      intro h1
      rw [h1, Polynomial.natDegree_one] at hMdeg
      omega
    have hrdeg : (Q %ₘ P₀.integralNormalization).natDegree < P₀.natDegree := by
      rw [← hMdeg]; exact Polynomial.natDegree_modByMonic_lt Q hMm hM1
    apply hmin ((Q %ₘ P₀.integralNormalization).comp
      (Polynomial.C P₀.leadingCoeff * Polynomial.X)).natDegree
    · rw [Polynomial.natDegree_comp, Polynomial.natDegree_C_mul_X _ hl, mul_one, ← hdeg]
      exact hrdeg
    · refine ⟨(Q %ₘ P₀.integralNormalization).comp (Polynomial.C P₀.leadingCoeff * Polynomial.X),
        ?_, ?_, rfl⟩
      · intro h0
        rw [Polynomial.comp_eq_zero_iff] at h0
        rcases h0 with h0 | ⟨_, h0⟩
        · exact hr h0
        · have := congrArg Polynomial.natDegree h0
          rw [Polynomial.natDegree_C_mul_X _ hl, Polynomial.natDegree_C] at this
          exact one_ne_zero this
      · rw [Polynomial.eval₂_comp]
        simpa [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X] using hrt

  have s5 : ∀ (l : MvPolynomial (Fin d) A), MvPolynomial.aeval x l ≠ 0 →
      IntermediateField.adjoin K
        (Set.range (Fin.cons (MvPolynomial.aeval x l * y) x : Fin (d + 1) → E)) = ⊤ := by
    intro l hl
    rw [Fin.range_cons]
    have hxS : Set.range x ⊆
        IntermediateField.adjoin K (insert (MvPolynomial.aeval x l * y) (Set.range x)) :=
      fun z hz => IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ hz)
    have htS : MvPolynomial.aeval x l * y ∈
        IntermediateField.adjoin K (insert (MvPolynomial.aeval x l * y) (Set.range x)) :=
      IntermediateField.subset_adjoin K _ (Set.mem_insert _ _)
    have haS : MvPolynomial.aeval x l ∈
        IntermediateField.adjoin K (insert (MvPolynomial.aeval x l * y) (Set.range x)) := by
      rw [← MvPolynomial.aeval_map_algebraMap K]
      have h0 : MvPolynomial.aeval x (MvPolynomial.map (algebraMap A K) l) ∈
          Algebra.adjoin K (Set.range x) := by
        rw [Algebra.adjoin_range_eq_range_aeval]; exact ⟨_, rfl⟩
      have h1 : MvPolynomial.aeval x (MvPolynomial.map (algebraMap A K) l) ∈
          IntermediateField.adjoin K (Set.range x) :=
        IntermediateField.algebra_adjoin_le_adjoin K _ h0
      exact IntermediateField.adjoin.mono K _ _ (Set.subset_insert _ _) h1
    have hyS : y ∈ IntermediateField.adjoin K (insert (MvPolynomial.aeval x l * y) (Set.range x)) := by
      have := IntermediateField.div_mem _ htS haS
      rwa [mul_div_cancel_left₀ y hl] at this
    rw [eq_top_iff, ← hgen, IntermediateField.adjoin_le_iff]
    intro z hz
    rcases hz with rfl | hz
    · exact hyS
    · exact hxS hz

  have s6 : ∀ (v : Fin (d + 1) → E), IntermediateField.adjoin K (Set.range v) = ⊤ →
      ∀ e : E, ∃ h h' : MvPolynomial (Fin (d + 1)) A, MvPolynomial.aeval v h' ≠ 0 ∧
        e = MvPolynomial.aeval v h / MvPolynomial.aeval v h' := by
    intro v hv e
    have he : e ∈ IntermediateField.adjoin K (Set.range v) := hv ▸ IntermediateField.mem_top
    obtain ⟨r, hr, s, hs, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp he
    rw [Algebra.adjoin_range_eq_range_aeval] at hr hs
    obtain ⟨p, rfl⟩ := hr
    obtain ⟨q, rfl⟩ := hs
    have hinj : ∀ c : A, c ≠ 0 → algebraMap A E c ≠ 0 := by
      intro c hc
      rw [IsScalarTower.algebraMap_apply A K E]
      exact (map_ne_zero _).mpr (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
        (mem_nonZeroDivisors_of_ne_zero hc))
    by_cases hq : MvPolynomial.aeval v q = 0
    · refine ⟨0, 1, by simp, ?_⟩
      change MvPolynomial.aeval v p / MvPolynomial.aeval v q = _
      rw [hq, div_zero, map_zero, map_one, div_one]
    · obtain ⟨c₁, p₀, hc₁, hp₀⟩ := s0 (d + 1) p
      obtain ⟨c₂, q₀, hc₂, hq₀⟩ := s0 (d + 1) q
      have ep : MvPolynomial.aeval v p₀ = algebraMap A E c₁ * MvPolynomial.aeval v p := by
        rw [← MvPolynomial.aeval_map_algebraMap K, hp₀, map_mul, MvPolynomial.aeval_C,
          IsScalarTower.algebraMap_apply A K E]
      have eq : MvPolynomial.aeval v q₀ = algebraMap A E c₂ * MvPolynomial.aeval v q := by
        rw [← MvPolynomial.aeval_map_algebraMap K, hq₀, map_mul, MvPolynomial.aeval_C,
          IsScalarTower.algebraMap_apply A K E]
      have h1 := hinj c₁ hc₁
      have h2 := hinj c₂ hc₂
      refine ⟨MvPolynomial.C c₂ * p₀, MvPolynomial.C c₁ * q₀, ?_, ?_⟩
      · rw [map_mul, MvPolynomial.aeval_C, eq]
        exact mul_ne_zero h1 (mul_ne_zero h2 hq)
      · change MvPolynomial.aeval v p / MvPolynomial.aeval v q = _
        rw [map_mul, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_C, ep, eq]
        field_simp

  have s7 : ∀ (F : MvPolynomial (Fin (d + 1)) A) (v : Fin (d + 1) → E),
      (∀ h : MvPolynomial (Fin (d + 1)) A, MvPolynomial.aeval v h = 0 → h ∈ Ideal.span {F}) →
      ∀ h : MvPolynomial (Fin (d + 1)) K, MvPolynomial.aeval v h = 0 →
        h ∈ Ideal.span {MvPolynomial.map (algebraMap A K) F} := by
    intro F v hA h hh
    obtain ⟨c, h₀, hc, hh₀⟩ := s0 (d + 1) h
    have hcK : algebraMap A K c ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hc)
    have h0 : MvPolynomial.aeval v h₀ = 0 := by
      rw [← MvPolynomial.aeval_map_algebraMap K, hh₀, map_mul, hh, mul_zero]
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp (hA h₀ h0)
    rw [Ideal.mem_span_singleton']
    refine ⟨MvPolynomial.C (algebraMap A K c)⁻¹ * MvPolynomial.map (algebraMap A K) q, ?_⟩
    rw [mul_assoc, ← map_mul, hq, hh₀, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hcK, map_one,
      one_mul]

  obtain ⟨P, hP0, hPy⟩ := s3
  obtain ⟨M, l, hl, hMm, hMdeg, hMt, hdvd⟩ :=
    s4 (MvPolynomial (Fin d) A) (MvPolynomial.aeval x : MvPolynomial (Fin d) A →ₐ[A] E).toRingHom
      hφ P hP0 hPy
  set t := (MvPolynomial.aeval x : MvPolynomial (Fin d) A →ₐ[A] E).toRingHom l * y with ht
  have hFM : MvPolynomial.finSuccEquiv A d ((MvPolynomial.finSuccEquiv A d).symm M) = M :=
    AlgEquiv.apply_symm_apply _ _
  have hA : ∀ h : MvPolynomial (Fin (d + 1)) A,
      MvPolynomial.aeval (Fin.cons t x : Fin (d + 1) → E) h = 0 →
      h ∈ Ideal.span {(MvPolynomial.finSuccEquiv A d).symm M} := by
    intro h hh
    rw [s1] at hh
    obtain ⟨q, hq⟩ := hdvd _ hh
    rw [Ideal.mem_span_singleton']
    refine ⟨(MvPolynomial.finSuccEquiv A d).symm q, ?_⟩
    apply (MvPolynomial.finSuccEquiv A d).injective
    rw [map_mul, AlgEquiv.apply_symm_apply, hFM, hq, mul_comm]
  refine ⟨(MvPolynomial.finSuccEquiv A d).symm M, Fin.cons t x, ?_, ?_, ?_, ?_, hA, ?_⟩
  · rw [hFM]; exact hMm
  · rw [hFM]; exact hMdeg
  · rw [s1, hFM]; exact hMt
  · exact s7 _ _ hA
  · have hl' : MvPolynomial.aeval x l ≠ 0 := by
      intro h0
      apply hl
      apply hφ
      rw [map_zero]
      exact h0
    exact s6 _ (s5 l hl')

theorem wcpa_gs_model_abs_irreducible : ∀ (A K E : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K] [Field E] [Algebra K E] (n : ℕ) (F : MvPolynomial (Fin n) A) (v : Fin n → E), F ≠ 0 → MvPolynomial.aeval v (MvPolynomial.map (algebraMap A K) F) = 0 → (∀ h : MvPolynomial (Fin n) K, MvPolynomial.aeval v h = 0 → h ∈ Ideal.span {MvPolynomial.map (algebraMap A K) F}) → (∀ (L : Type u) [Field L] [Algebra K L], IsDomain (TensorProduct K L E)) → ∀ (L : Type u) [Field L] [Algebra A L], Function.Injective (algebraMap A L) → Irreducible (MvPolynomial.map (algebraMap A L) F) :=
by
  intro A K E _ _ _ _ _ _ _ n F v hF0 hFv hker hgeom L _ _ hL
  classical
  set f := MvPolynomial.map (algebraMap A K) F with hfdef
  letI : Algebra K L := (IsFractionRing.lift (K := K) hL).toAlgebra
  have hAKL : (algebraMap K L).comp (algebraMap A K) = algebraMap A L := by
    ext a
    exact IsFractionRing.lift_algebraMap hL a
  have hmap : MvPolynomial.map (algebraMap A L) F = MvPolynomial.map (algebraMap K L) f := by
    rw [hfdef, MvPolynomial.map_map, hAKL]
  have hfL0 : MvPolynomial.map (algebraMap A L) F ≠ 0 := by
    intro h
    apply hF0
    apply MvPolynomial.map_injective _ hL
    rw [h, map_zero]
  rw [hmap] at hfL0 ⊢

  have hvan : ∀ a ∈ Ideal.span {f}, MvPolynomial.aeval v a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hFv, mul_zero]
  let ψ : (MvPolynomial (Fin n) K ⧸ Ideal.span {f}) →ₐ[K] E :=
    Ideal.Quotient.liftₐ (Ideal.span {f}) (MvPolynomial.aeval v) hvan
  have hψ : Function.Injective ψ := by
    rw [injective_iff_map_eq_zero]
    intro q hq
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective q
    have h1 : MvPolynomial.aeval v h = 0 := hq
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hker h h1)

  let π : MvPolynomial (Fin n) K →ₐ[K] (MvPolynomial (Fin n) K ⧸ Ideal.span {f}) :=
    Ideal.Quotient.mkₐ K (Ideal.span {f})
  have hπ : Function.Surjective π := Ideal.Quotient.mkₐ_surjective K _
  have hπker : RingHom.ker π = Ideal.span {f} := Ideal.Quotient.mkₐ_ker K _
  let Φ1 := Algebra.TensorProduct.map (AlgHom.id K L) π
  let Φ2 := Algebra.TensorProduct.map (AlgHom.id K L) ψ
  have hΦ2 : Function.Injective Φ2 := by
    have h1 : (⇑Φ2) = ⇑(LinearMap.lTensor L ψ.toLinearMap) := rfl
    rw [h1]
    exact Module.Flat.lTensor_preserves_injective_linearMap _ hψ
  have hker1 : RingHom.ker Φ1 = Ideal.span {(1 : L) ⊗ₜ[K] f} := by
    rw [Algebra.TensorProduct.lTensor_ker π hπ, hπker, Ideal.map_span, Set.image_singleton]
    rfl
  haveI := hgeom L

  let e := MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) K L
  have he1 : e ((1 : L) ⊗ₜ[K] f) = MvPolynomial.map (algebraMap K L) f := by
    rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
  let H : MvPolynomial (Fin n) L →+* TensorProduct K L E :=
    (Φ2.toRingHom.comp Φ1.toRingHom).comp e.symm.toRingEquiv.toRingHom
  have hprime : (RingHom.ker H).IsPrime := RingHom.ker_isPrime H
  have hkerH : RingHom.ker H = Ideal.span {MvPolynomial.map (algebraMap K L) f} := by
    ext x
    rw [RingHom.mem_ker, Ideal.mem_span_singleton, ← he1]
    have hHx : H x = Φ2 (Φ1 (e.symm x)) := rfl
    rw [hHx]
    constructor
    · intro h0
      have h2 : Φ1 (e.symm x) = 0 := hΦ2 (h0.trans (map_zero Φ2).symm)
      have h3 : e.symm x ∈ RingHom.ker Φ1 := h2
      rw [hker1, Ideal.mem_span_singleton] at h3
      have h4 := map_dvd e h3
      rwa [AlgEquiv.apply_symm_apply] at h4
    · intro hd
      have h4 := map_dvd e.symm hd
      rw [AlgEquiv.symm_apply_apply] at h4
      have h3 : e.symm x ∈ RingHom.ker Φ1 := by
        rw [hker1, Ideal.mem_span_singleton]; exact h4
      have h2 : Φ1 (e.symm x) = 0 := h3
      rw [h2, map_zero]
  rw [hkerH] at hprime
  exact ((Ideal.span_singleton_prime hfL0).mp hprime).irreducible

theorem wcpa_gs_generic_point_map : ∀ (A K B : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K] [CommRing B] [Algebra A B] [IsDomain (TensorProduct A K B)], Function.Injective (algebraMap A (FractionRing (TensorProduct A K B))) ∧ (∀ b : B, ((IsScalarTower.toAlgHom A (TensorProduct A K B) (FractionRing (TensorProduct A K B))).comp (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B)) b = 0 → ∃ s : A, s ≠ 0 ∧ algebraMap A B s * b = 0) ∧ ∀ e : FractionRing (TensorProduct A K B), ∃ b b' : B, ((IsScalarTower.toAlgHom A (TensorProduct A K B) (FractionRing (TensorProduct A K B))).comp (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B)) b' ≠ 0 ∧ e = ((IsScalarTower.toAlgHom A (TensorProduct A K B) (FractionRing (TensorProduct A K B))).comp (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B)) b / ((IsScalarTower.toAlgHom A (TensorProduct A K B) (FractionRing (TensorProduct A K B))).comp (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B)) b' :=
by
  intro A K B _ _ _ _ _ _ _ _
  classical
  have hloc : IsLocalizedModule (nonZeroDivisors A) (TensorProduct.mk A K B 1) :=
    (isLocalizedModule_iff_isBaseChange (nonZeroDivisors A) K
      (TensorProduct.mk A K B 1)).mpr (TensorProduct.isBaseChange A B K)
  have hj : Function.Injective
      (algebraMap (TensorProduct A K B) (FractionRing (TensorProduct A K B))) :=
    IsFractionRing.injective (TensorProduct A K B) (FractionRing (TensorProduct A K B))
  have hAT : Function.Injective (algebraMap A (TensorProduct A K B)) := by
    rw [IsScalarTower.algebraMap_eq A K (TensorProduct A K B)]
    exact (algebraMap K (TensorProduct A K B)).injective.comp (IsFractionRing.injective A K)
  have hα : Function.Injective (algebraMap A (FractionRing (TensorProduct A K B))) := by
    rw [IsScalarTower.algebraMap_eq A (TensorProduct A K B) (FractionRing (TensorProduct A K B))]
    exact hj.comp hAT
  have hclear : ∀ z : TensorProduct A K B, ∃ (s : A) (b : B), s ≠ 0 ∧
      algebraMap A (TensorProduct A K B) s * z = TensorProduct.tmul A (1 : K) b := by
    intro z
    obtain ⟨⟨b, c⟩, hc⟩ := IsLocalizedModule.surj (nonZeroDivisors A) (TensorProduct.mk A K B 1) z
    refine ⟨c, b, nonZeroDivisors.ne_zero c.2, ?_⟩
    rw [← Algebra.smul_def]
    exact hc
  set β := ((IsScalarTower.toAlgHom A (TensorProduct A K B)
    (FractionRing (TensorProduct A K B))).comp
    (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B)) with hβdef
  have hU : ∀ b : B, β b = algebraMap (TensorProduct A K B) (FractionRing (TensorProduct A K B))
      (TensorProduct.tmul A (1 : K) b) := fun b => rfl
  have hval : ∀ (t : A) (c : B) (w : TensorProduct A K B),
      algebraMap A (TensorProduct A K B) t * w = TensorProduct.tmul A (1 : K) c →
      β c = algebraMap A (FractionRing (TensorProduct A K B)) t *
        algebraMap (TensorProduct A K B) (FractionRing (TensorProduct A K B)) w := by
    intro t c w h
    rw [hU, ← h, map_mul, ← IsScalarTower.algebraMap_apply]
  refine ⟨hα, ?_, ?_⟩
  · intro b hb
    rw [hU] at hb
    have h1 : TensorProduct.tmul A (1 : K) b = 0 := (map_eq_zero_iff _ hj).mp hb
    have h2 : TensorProduct.mk A K B 1 b = TensorProduct.mk A K B 1 0 := by
      rw [map_zero, TensorProduct.mk_apply]
      exact h1
    obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors A) h2
    refine ⟨c, nonZeroDivisors.ne_zero c.2, ?_⟩
    rw [smul_zero] at hc
    rw [← Algebra.smul_def]
    exact hc
  · intro e
    obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := TensorProduct A K B) e
    obtain ⟨s, b, hs, hsb⟩ := hclear x
    obtain ⟨s', b', hs', hsb'⟩ := hclear y
    have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
    have hjy : algebraMap (TensorProduct A K B) (FractionRing (TensorProduct A K B)) y ≠ 0 :=
      (map_ne_zero_iff _ hj).mpr hy0
    have hαs : algebraMap A (FractionRing (TensorProduct A K B)) s ≠ 0 :=
      (map_ne_zero_iff _ hα).mpr hs
    have hαs' : algebraMap A (FractionRing (TensorProduct A K B)) s' ≠ 0 :=
      (map_ne_zero_iff _ hα).mpr hs'
    have e1 : β (algebraMap A B s' * b) = algebraMap A (FractionRing (TensorProduct A K B)) s' *
        (algebraMap A (FractionRing (TensorProduct A K B)) s *
          algebraMap (TensorProduct A K B) (FractionRing (TensorProduct A K B)) x) := by
      rw [map_mul, AlgHom.commutes, hval s b x hsb]
    have e2 : β (algebraMap A B s * b') = algebraMap A (FractionRing (TensorProduct A K B)) s *
        (algebraMap A (FractionRing (TensorProduct A K B)) s' *
          algebraMap (TensorProduct A K B) (FractionRing (TensorProduct A K B)) y) := by
      rw [map_mul, AlgHom.commutes, hval s' b' y hsb']
    have hden : β (algebraMap A B s * b') ≠ 0 := by
      rw [e2]
      exact mul_ne_zero hαs (mul_ne_zero hαs' hjy)
    refine ⟨algebraMap A B s' * b, algebraMap A B s * b', hden, ?_⟩
    rw [e1, e2]
    field_simp

theorem wcpa_gs_birational_spread : ∀ (A B E : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B] [Field E] [Algebra A E] (n : ℕ) (F : MvPolynomial (Fin n) A) (β : B →ₐ[A] E) (v : Fin n → E), Function.Injective (algebraMap A E) → (∀ b : B, β b = 0 → ∃ s : A, s ≠ 0 ∧ algebraMap A B s * b = 0) → MvPolynomial.aeval v F = 0 → (∀ h : MvPolynomial (Fin n) A, MvPolynomial.aeval v h = 0 → h ∈ Ideal.span {F}) → (∀ e : E, ∃ b b' : B, β b' ≠ 0 ∧ e = β b / β b') → (∀ e : E, ∃ h h' : MvPolynomial (Fin n) A, MvPolynomial.aeval v h' ≠ 0 ∧ e = MvPolynomial.aeval v h / MvPolynomial.aeval v h') → ∃ (G : MvPolynomial (Fin n) A) (g : B), MvPolynomial.aeval v G ≠ 0 ∧ β g ≠ 0 ∧ Nonempty (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) G) ≃ₐ[A] Localization.Away g) :=
by
  intro A B E _ _ _ _ _ _ _ _ n F β v hAE htor hFv hkerA hratB hratA
  classical

  have s4 : ∀ (R : Type u) [CommRing R] [Algebra A R] (φ : R →ₐ[A] E) (r : R), φ r ≠ 0 →
      ∃ ψ : Localization.Away r →ₐ[A] E, (∀ x, φ x ∈ ψ.range) ∧ (φ r)⁻¹ ∈ ψ.range ∧
        (∀ y ∈ ψ.range, ∃ x : R, ∃ k : ℕ, y = φ x * ((φ r)⁻¹) ^ k) ∧
        ((∀ x, φ x = 0 → r * x = 0) → Function.Injective ψ) := by
    intro R _ _ φ r hr
    have hunit : ∀ y : Submonoid.powers r, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simp only [map_pow]
      exact (isUnit_iff_ne_zero.mpr hr).pow k
    let ψ : Localization.Away r →ₐ[A] E :=
      IsLocalization.liftAlgHom (M := Submonoid.powers r) (S := Localization.Away r) (f := φ) hunit
    have hψ : ∀ (x : R) (k : ℕ), ψ (IsLocalization.mk' (Localization.Away r) x
        (⟨r ^ k, Submonoid.pow_mem _ (Submonoid.mem_powers r) k⟩ : Submonoid.powers r)) = φ x * ((φ r)⁻¹) ^ k := by
      intro x k
      show IsLocalization.liftAlgHom _ _ = _
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_mk'_spec]
      change φ x = φ (r ^ k) * (φ x * ((φ r)⁻¹) ^ k)
      rw [map_pow, mul_comm, mul_assoc, ← mul_pow, inv_mul_cancel₀ hr, one_pow, mul_one]
    have hsurj : ∀ z : Localization.Away r, ∃ (x : R) (k : ℕ), z =
        IsLocalization.mk' (Localization.Away r) x
          (⟨r ^ k, Submonoid.pow_mem _ (Submonoid.mem_powers r) k⟩ : Submonoid.powers r) := by
      intro z
      obtain ⟨⟨x, m⟩, hz⟩ := IsLocalization.mk'_surjective (Submonoid.powers r) z
      obtain ⟨k, hk⟩ := m.2
      refine ⟨x, k, hz.symm.trans ?_⟩
      have hm : m = ⟨r ^ k, Submonoid.pow_mem _ (Submonoid.mem_powers r) k⟩ := Subtype.ext hk.symm
      subst hm
      rfl
    refine ⟨ψ, ?_, ?_, ?_, ?_⟩
    · intro x
      refine ⟨IsLocalization.mk' (Localization.Away r) x
        (⟨r ^ 0, Submonoid.pow_mem _ (Submonoid.mem_powers r) 0⟩ : Submonoid.powers r), ?_⟩
      exact (hψ x 0).trans (by rw [pow_zero, mul_one])
    · refine ⟨IsLocalization.mk' (Localization.Away r) (1 : R)
        (⟨r ^ 1, Submonoid.pow_mem _ (Submonoid.mem_powers r) 1⟩ : Submonoid.powers r), ?_⟩
      exact (hψ 1 1).trans (by rw [map_one, one_mul, pow_one])
    · rintro y ⟨z, rfl⟩
      obtain ⟨x, k, rfl⟩ := hsurj z
      exact ⟨x, k, hψ x k⟩
    · intro hker
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨x, k, rfl⟩ := hsurj z
      rw [hψ] at hz
      have hx : φ x = 0 := (mul_eq_zero.mp hz).resolve_right (pow_ne_zero k (inv_ne_zero hr))
      rw [IsLocalization.mk'_eq_zero_iff]
      exact ⟨⟨r, 1, pow_one r⟩, hker x hx⟩

  obtain ⟨s, hs0, hs⟩ : ∃ s : A, s ≠ 0 ∧ ∀ b : B, β b = 0 → algebraMap A B s * b = 0 := by
    have := Algebra.FiniteType.isNoetherianRing A B
    obtain ⟨K, hK⟩ := (IsNoetherian.noetherian (RingHom.ker β) : (RingHom.ker β).FG)
    have key : ∀ K' : Finset B, (↑K' : Set B) ⊆ RingHom.ker β →
        ∃ s : A, s ≠ 0 ∧ ∀ k ∈ K', algebraMap A B s * k = 0 := by
      intro K'
      induction K' using Finset.induction_on with
      | empty => intro _; exact ⟨1, one_ne_zero, by simp⟩
      | insert a K'' haK ih =>
        intro hsub
        obtain ⟨s1, hs1, h1⟩ := ih (fun x hx => hsub (Finset.mem_insert_of_mem hx))
        have ha : β a = 0 := RingHom.mem_ker.mp (hsub (Finset.mem_insert_self a K''))
        obtain ⟨s2, hs2, h2⟩ := htor a ha
        refine ⟨s1 * s2, mul_ne_zero hs1 hs2, ?_⟩
        intro k hk
        rcases Finset.mem_insert.mp hk with rfl | hk
        · rw [map_mul, mul_assoc, h2, mul_zero]
        · rw [map_mul, mul_comm (algebraMap A B s1), mul_assoc, h1 k hk, mul_zero]
    obtain ⟨s, hs0, hsK⟩ := key K (by rw [← hK]; exact Submodule.subset_span)
    refine ⟨s, hs0, fun b hb => ?_⟩
    have hbK : b ∈ Submodule.span B (↑K : Set B) := by
      rw [hK]; exact RingHom.mem_ker.mpr hb
    have hle : Submodule.span B (↑K : Set B) ≤
        LinearMap.ker (LinearMap.mulLeft B (algebraMap A B s)) := by
      rw [Submodule.span_le]
      intro k hk
      rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.mulLeft_apply]
      exact hsK k hk
    have := hle hbK
    rwa [LinearMap.mem_ker, LinearMap.mulLeft_apply] at this

  have inv_mem' : ∀ (S : Subalgebra A E) (x y : E), y ∈ S → (x * y)⁻¹ ∈ S → x * y ≠ 0 →
      x⁻¹ ∈ S := by
    intro S x y hy hxy hne
    have hy0 : y ≠ 0 := right_ne_zero_of_mul hne
    have e : x⁻¹ = y * (x * y)⁻¹ := by
      rw [mul_inv, mul_comm x⁻¹, ← mul_assoc, mul_inv_cancel₀ hy0, one_mul]
    rw [e]; exact mul_mem hy hxy

  have hIv : ∀ a ∈ Ideal.span {F}, MvPolynomial.aeval v a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hFv, mul_zero]
  obtain ⟨α, hα⟩ : ∃ α : (MvPolynomial (Fin n) A ⧸ Ideal.span {F}) →ₐ[A] E,
      ∀ h, α (Ideal.Quotient.mk _ h) = MvPolynomial.aeval v h :=
    ⟨Ideal.Quotient.liftₐ _ (MvPolynomial.aeval v) hIv, fun h => rfl⟩
  have hαinj : Function.Injective α := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [hα] at hz
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hkerA h hz)

  obtain ⟨T, hT⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A B).FG)
  choose hh hh' hh'0 hhe using hratA
  choose bb bb' hbb'0 hbbe using hratB
  obtain ⟨G₀, hG₀⟩ : ∃ G₀ : MvPolynomial (Fin n) A, G₀ = ∏ t ∈ T, hh' (β t) := ⟨_, rfl⟩
  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : E, MvPolynomial.aeval v G₀ = p₀ := ⟨_, rfl⟩
  have hp₀0 : p₀ ≠ 0 := by
    rw [← hp₀, hG₀, map_prod]
    exact Finset.prod_ne_zero_iff.mpr (fun t _ => hh'0 _)
  have hβle : ∀ S : Subalgebra A E, (∀ h : MvPolynomial (Fin n) A, MvPolynomial.aeval v h ∈ S) → p₀⁻¹ ∈ S →
      ∀ b, β b ∈ S := by
    intro S hS hinv b
    have hTS : (↑T : Set B) ⊆ (S.comap β : Set B) := by
      intro t ht
      rw [SetLike.mem_coe, Subalgebra.mem_comap, hhe (β t), div_eq_mul_inv]
      refine mul_mem (hS _) (inv_mem' S _ (MvPolynomial.aeval v (∏ t' ∈ T.erase t, hh' (β t')))
        (hS _) ?_ ?_)
      · rw [← map_mul, Finset.mul_prod_erase T (fun t' => hh' (β t')) ht, ← hG₀, hp₀]
        exact hinv
      · rw [← map_mul, Finset.mul_prod_erase T (fun t' => hh' (β t')) ht, ← hG₀, hp₀]
        exact hp₀0
    have hle : Algebra.adjoin A (↑T : Set B) ≤ S.comap β := Algebra.adjoin_le hTS
    rw [hT] at hle
    exact hle Algebra.mem_top

  obtain ⟨c, c', hc'0, hpc⟩ : ∃ c c' : B, β c' ≠ 0 ∧ p₀ = β c / β c' :=
    ⟨bb p₀, bb' p₀, hbb'0 p₀, hbbe p₀⟩
  have hc0 : β c ≠ 0 := by
    intro h; apply hp₀0; rw [hpc, h, zero_div]
  have hsE : algebraMap A E s ≠ 0 := fun h => hs0 (hAE (h.trans (map_zero _).symm))
  obtain ⟨g, hg⟩ : ∃ g : B, g = algebraMap A B s * ((∏ i, bb' (v i)) * c) := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q : E, β g = q := ⟨_, rfl⟩
  have hq0 : q ≠ 0 := by
    rw [← hq, hg, map_mul, map_mul, AlgHom.commutes, map_prod]
    exact mul_ne_zero hsE (mul_ne_zero (Finset.prod_ne_zero_iff.mpr fun i _ => hbb'0 _) hc0)

  obtain ⟨ψ₀, h0a, h0b, h0c, -⟩ := s4 _ α (Ideal.Quotient.mk (Ideal.span {F}) G₀)
    (by rw [hα, hp₀]; exact hp₀0)
  rw [hα, hp₀] at h0b
  have hq_mem : q ∈ ψ₀.range := by
    rw [← hq]
    exact hβle ψ₀.range (fun h => by rw [← hα]; exact h0a _) h0b g
  obtain ⟨x₀, M, hqx⟩ := h0c q hq_mem
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective x₀
  rw [hα, hα, hp₀] at hqx
  have hw : MvPolynomial.aeval v w = q * p₀ ^ M := by
    rw [hqx, mul_assoc, ← mul_pow, inv_mul_cancel₀ hp₀0, one_pow, mul_one]
  have hp : MvPolynomial.aeval v (G₀ * w) = p₀ * (q * p₀ ^ M) := by
    rw [map_mul, hp₀, hw]
  have hp_ne : p₀ * (q * p₀ ^ M) ≠ 0 :=
    mul_ne_zero hp₀0 (mul_ne_zero hq0 (pow_ne_zero _ hp₀0))

  obtain ⟨ψ₁, h1a, h1b, h1c, h1d⟩ := s4 _ α (Ideal.Quotient.mk (Ideal.span {F}) (G₀ * w))
    (by rw [hα, hp]; exact hp_ne)
  rw [hα, hp] at h1b
  obtain ⟨ψ₂, h2a, h2b, h2c, h2d⟩ := s4 B β g (by rw [hq]; exact hq0)
  rw [hq] at h2b
  have hinj1 : Function.Injective ψ₁ := h1d (fun x hx => by
    rw [show x = 0 from hαinj (hx.trans (map_zero α).symm), mul_zero])
  have hinj2 : Function.Injective ψ₂ := h2d (fun x hx => by
    rw [hg, mul_comm (algebraMap A B s), mul_assoc, hs x hx, mul_zero])

  have invB : ∀ b b2 : B, b * b2 = g → (β b)⁻¹ ∈ ψ₂.range := by
    intro b b2 hb
    refine inv_mem' ψ₂.range (β b) (β b2) (h2a b2) ?_ ?_
    · rw [← map_mul, hb, hq]; exact h2b
    · rw [← map_mul, hb, hq]; exact hq0
  have hvS2 : Set.range v ⊆ ψ₂.range := by
    rintro _ ⟨i, rfl⟩
    rw [hbbe (v i), div_eq_mul_inv]
    refine mul_mem (h2a _) (invB (bb' (v i))
      (algebraMap A B s * ((∏ j ∈ Finset.univ.erase i, bb' (v j)) * c)) ?_)
    rw [hg, ← Finset.mul_prod_erase Finset.univ (fun j => bb' (v j)) (Finset.mem_univ i)]
    ring
  have hA2 : ∀ h : MvPolynomial (Fin n) A, MvPolynomial.aeval v h ∈ ψ₂.range := by
    intro h
    have : MvPolynomial.aeval v h ∈ Algebra.adjoin A (Set.range v) := by
      rw [← MvPolynomial.aeval_range]; exact AlgHom.mem_range_self _ h
    exact Algebra.adjoin_le hvS2 this
  have hp₀inv2 : p₀⁻¹ ∈ ψ₂.range := by
    rw [hpc, inv_div, div_eq_mul_inv]
    refine mul_mem (h2a _) (invB c (algebraMap A B s * ∏ i, bb' (v i)) ?_)
    rw [hg]; ring
  have hpinv2 : (p₀ * (q * p₀ ^ M))⁻¹ ∈ ψ₂.range := by
    have e : (p₀ * (q * p₀ ^ M))⁻¹ = p₀⁻¹ ^ (M + 1) * q⁻¹ := by ring
    rw [e]
    exact mul_mem (pow_mem hp₀inv2 _) h2b

  have hA1 : ∀ h : MvPolynomial (Fin n) A, MvPolynomial.aeval v h ∈ ψ₁.range := fun h => by rw [← hα]; exact h1a _
  have hp₀inv1 : p₀⁻¹ ∈ ψ₁.range :=
    inv_mem' ψ₁.range p₀ (q * p₀ ^ M) (by rw [← hw]; exact hA1 w) h1b hp_ne
  have hqinv1 : q⁻¹ ∈ ψ₁.range := by
    have e : q * p₀ ^ (M + 1) = p₀ * (q * p₀ ^ M) := by ring
    refine inv_mem' ψ₁.range q (p₀ ^ (M + 1)) (pow_mem (by rw [← hp₀]; exact hA1 G₀) _) ?_ ?_
    · rw [e]; exact h1b
    · rw [e]; exact hp_ne

  have hrange : ψ₁.range = ψ₂.range := by
    apply le_antisymm
    · intro y hy
      obtain ⟨x, k, rfl⟩ := h1c y hy
      obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hα, hα, hp]
      exact mul_mem (hA2 h) (pow_mem hpinv2 k)
    · intro y hy
      obtain ⟨b, k, rfl⟩ := h2c y hy
      rw [hq]
      exact mul_mem (hβle ψ₁.range hA1 hp₀inv1 b) (pow_mem hqinv1 k)
  refine ⟨G₀ * w, g, by rw [hp]; exact hp_ne, by rw [hq]; exact hq0, ⟨?_⟩⟩
  exact ((AlgEquiv.ofInjective ψ₁ hinj1).trans (Subalgebra.equivOfEq _ _ hrange)).trans
    (AlgEquiv.ofInjective ψ₂ hinj2).symm

theorem wcpa_gs_bertini_noether : ∀ (A : Type u) [CommRing A] [IsDomain A] (n : ℕ) (F : MvPolynomial (Fin n) A), (∀ (L : Type u) [Field L] [Algebra A L], Function.Injective (algebraMap A L) → Irreducible (MvPolynomial.map (algebraMap A L) F)) → ∃ a : A, a ≠ 0 ∧ ∀ (L : Type u) [Field L] [Algebra A L], algebraMap A L a ≠ 0 → Irreducible (MvPolynomial.map (algebraMap A L) F) :=
by
  intro A _ _ n F hHyp
  classical

  have tdmap : ∀ {S T : Type u} [CommRing S] [CommRing T] (f : S →+* T)
      (p : MvPolynomial (Fin n) S), (MvPolynomial.map f p).totalDegree ≤ p.totalDegree :=
    fun f p => Finset.sup_mono (MvPolynomial.support_map_subset f p)

  have s1 : F ≠ 0 → ∃ c : A, c ≠ 0 ∧ ∀ (L : Type u) [CommRing L] (f : A →+* L), f c ≠ 0 →
      MvPolynomial.map f F ≠ 0 ∧ (MvPolynomial.map f F).totalDegree = F.totalDegree := by
    intro hF
    have hne : F.support.Nonempty := by
      rwa [Finset.nonempty_iff_ne_empty, Ne, MvPolynomial.support_eq_empty]
    obtain ⟨μ₀, hμ₀, hdeg⟩ :=
      Finset.exists_mem_eq_sup F.support hne (fun s => s.sum fun _ e => e)
    refine ⟨F.coeff μ₀, MvPolynomial.mem_support_iff.mp hμ₀, ?_⟩
    intro L _ f hf
    have hc : (MvPolynomial.map f F).coeff μ₀ ≠ 0 := by rw [MvPolynomial.coeff_map]; exact hf
    have hmem : μ₀ ∈ (MvPolynomial.map f F).support := MvPolynomial.mem_support_iff.mpr hc
    refine ⟨fun h => hc (by simp [h]), le_antisymm (tdmap f F) ?_⟩
    have h2 : F.totalDegree = μ₀.sum fun _ e => e := hdeg
    rw [h2]; exact MvPolynomial.le_totalDegree hmem

  have s2 : ∀ (L : Type u) [Field L] (N : ℕ) (P : MvPolynomial (Fin n) L), P ≠ 0 →
      P.totalDegree = N → 1 ≤ N → (¬ Irreducible P ↔ ∃ d : ℕ, 1 ≤ d ∧ d + 1 ≤ N ∧
        ∃ G H : MvPolynomial (Fin n) L, G.totalDegree ≤ d ∧ H.totalDegree ≤ N - d ∧ G * H = P) := by
    intro L _ N P hP hN h1
    have U : ∀ Q : MvPolynomial (Fin n) L, Q ≠ 0 → (IsUnit Q ↔ Q.totalDegree = 0) := by
      intro Q hQ
      constructor
      · intro hu
        obtain ⟨r, -, rfl⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
        exact MvPolynomial.totalDegree_C r
      · intro h0
        have hQC := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0
        have hc : Q.coeff 0 ≠ 0 := fun hc => hQ (by rw [hQC, hc, map_zero])
        exact MvPolynomial.isUnit_iff_eq_C_of_isReduced.mpr ⟨_, hc.isUnit, hQC⟩
    have hPu : ¬ IsUnit P := by rw [U P hP]; omega
    constructor
    · intro hirr
      rw [irreducible_iff] at hirr
      push_neg at hirr
      obtain ⟨G, H, hGH, hG, hH⟩ := hirr hPu
      have hG0 : G ≠ 0 := by rintro rfl; exact hP (by rw [hGH, zero_mul])
      have hH0 : H ≠ 0 := by rintro rfl; exact hP (by rw [hGH, mul_zero])
      have hdG : G.totalDegree ≠ 0 := fun h => hG ((U G hG0).mpr h)
      have hdH : H.totalDegree ≠ 0 := fun h => hH ((U H hH0).mpr h)
      have hsum := MvPolynomial.totalDegree_mul_of_isDomain hG0 hH0
      rw [← hGH, hN] at hsum
      exact ⟨G.totalDegree, by omega, by omega, G, H, le_rfl, by omega, hGH.symm⟩
    · rintro ⟨d, hd1, hdN, G, H, hG, hH, hGH⟩ hirr
      have hG0 : G ≠ 0 := by rintro rfl; exact hP (by rw [← hGH, zero_mul])
      have hH0 : H ≠ 0 := by rintro rfl; exact hP (by rw [← hGH, mul_zero])
      have hsum := MvPolynomial.totalDegree_mul_of_isDomain hG0 hH0
      rw [hGH, hN] at hsum
      rcases hirr.isUnit_or_isUnit hGH.symm with hu | hu
      · have := (U G hG0).mp hu; omega
      · have := (U H hH0).mp hu; omega

  have s3 : ∀ d₁ d₂ : ℕ, ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
      Algebra.FinitePresentation A C ∧
      (∃ G H : MvPolynomial (Fin n) C, G.totalDegree ≤ d₁ ∧ H.totalDegree ≤ d₂ ∧
        G * H = MvPolynomial.map (algebraMap A C) F) ∧
      ∀ (L : Type u) [Field L] [Algebra A L] (G H : MvPolynomial (Fin n) L),
        G.totalDegree ≤ d₁ → H.totalDegree ≤ d₂ → G * H = MvPolynomial.map (algebraMap A L) F →
        Nonempty (C →ₐ[A] L) := by
    intro d₁ d₂
    obtain ⟨deg, hdeg⟩ : ∃ deg : (Fin n →₀ ℕ) → ℕ, deg = fun ν => ν.sum fun _ e => e :=
      ⟨_, rfl⟩
    have hle : ∀ (ν : Fin n →₀ ℕ) (j : Fin n), ν j ≤ deg ν := by
      intro ν j
      rw [hdeg]
      show ν j ≤ ∑ k ∈ ν.support, ν k
      by_cases hj : j ∈ ν.support
      · exact Finset.single_le_sum (f := fun k => ν k) (fun _ _ => Nat.zero_le _) hj
      · rw [Finsupp.notMem_support_iff.mp hj]; exact Nat.zero_le _
    have hmono : ∀ {S : Type u} [CommRing S] (ν : Fin n →₀ ℕ) (s : S),
        (MvPolynomial.monomial ν s).totalDegree ≤ deg ν := by
      intro S _ ν s; rw [hdeg]; exact MvPolynomial.totalDegree_monomial_le ν s
    have hsupp : ∀ {S : Type u} [CommRing S] (P : MvPolynomial (Fin n) S) (ν : Fin n →₀ ℕ),
        P.coeff ν ≠ 0 → deg ν ≤ P.totalDegree := by
      intro S _ P ν h; rw [hdeg]
      exact MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr h)
    have hfin : ∀ e : ℕ, Finite {ν : Fin n →₀ ℕ // deg ν ≤ e} := by
      intro e
      refine Finite.of_injective (fun ν : {ν : Fin n →₀ ℕ // deg ν ≤ e} => fun j : Fin n =>
        (⟨ν.1 j, Nat.lt_succ_of_le ((hle ν.1 j).trans ν.2)⟩ : Fin (e + 1))) ?_
      intro ν ν' h
      apply Subtype.ext
      ext j
      exact congrArg Fin.val (congrFun h j)
    have expand : ∀ (e : ℕ) [Fintype {ν : Fin n →₀ ℕ // deg ν ≤ e}] {S : Type u} [CommRing S]
        (P : MvPolynomial (Fin n) S), P.totalDegree ≤ e →
        ∑ ν : {ν : Fin n →₀ ℕ // deg ν ≤ e}, MvPolynomial.monomial ν.1 (P.coeff ν.1) = P := by
      intro e _ S _ P hP
      ext m
      rw [MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hm : deg m ≤ e
      · rw [Finset.sum_eq_single ⟨m, hm⟩]
        · simp
        · intro b _ hb
          rw [if_neg]
          intro h; exact hb (Subtype.ext h)
        · intro h; exact absurd (Finset.mem_univ _) h
      · rw [Finset.sum_eq_zero]
        · by_contra hc
          exact hm ((hsupp P m (Ne.symm hc)).trans hP)
        · intro b _
          rw [if_neg]
          intro h; apply hm; rw [← h]; exact b.2
    haveI : Finite {ν : Fin n →₀ ℕ // deg ν ≤ d₁} := hfin d₁
    haveI : Finite {ν : Fin n →₀ ℕ // deg ν ≤ d₂} := hfin d₂
    letI : Fintype {ν : Fin n →₀ ℕ // deg ν ≤ d₁} := Fintype.ofFinite _
    letI : Fintype {ν : Fin n →₀ ℕ // deg ν ≤ d₂} := Fintype.ofFinite _
    let R := MvPolynomial ({ν : Fin n →₀ ℕ // deg ν ≤ d₁} ⊕ {ν : Fin n →₀ ℕ // deg ν ≤ d₂}) A
    let Gh : MvPolynomial (Fin n) R := ∑ ν : {ν : Fin n →₀ ℕ // deg ν ≤ d₁},
      MvPolynomial.monomial ν.1 (MvPolynomial.X (Sum.inl ν))
    let Hh : MvPolynomial (Fin n) R := ∑ ν : {ν : Fin n →₀ ℕ // deg ν ≤ d₂},
      MvPolynomial.monomial ν.1 (MvPolynomial.X (Sum.inr ν))
    let D : MvPolynomial (Fin n) R := Gh * Hh - MvPolynomial.map (algebraMap A R) F
    let J : Ideal R := Ideal.span ((D.support.image fun ν => D.coeff ν : Finset R) : Set R)
    have hJfg : J.FG := ⟨_, rfl⟩
    haveI : Algebra.FinitePresentation A R := Algebra.FinitePresentation.mvPolynomial A A _
    have hGh : Gh.totalDegree ≤ d₁ :=
      MvPolynomial.totalDegree_finsetSum_le (fun ν _ => (hmono _ _).trans ν.2)
    have hHh : Hh.totalDegree ≤ d₂ :=
      MvPolynomial.totalDegree_finsetSum_le (fun ν _ => (hmono _ _).trans ν.2)
    refine ⟨R ⧸ J, inferInstance, inferInstance, Algebra.FinitePresentation.quotient hJfg, ?_, ?_⟩
    · refine ⟨MvPolynomial.map (Ideal.Quotient.mk J) Gh, MvPolynomial.map (Ideal.Quotient.mk J) Hh,
        (tdmap _ _).trans hGh, (tdmap _ _).trans hHh, ?_⟩
      have hD : MvPolynomial.map (Ideal.Quotient.mk J) D = 0 := by
        ext ν
        rw [MvPolynomial.coeff_map]
        by_cases hν : ν ∈ D.support
        · rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Finset.mem_coe.mpr
            (Finset.mem_image_of_mem _ hν)))]
          simp
        · rw [MvPolynomial.notMem_support_iff.mp hν, map_zero]; simp
      have hmapF : MvPolynomial.map (Ideal.Quotient.mk J) (MvPolynomial.map (algebraMap A R) F) =
          MvPolynomial.map (algebraMap A (R ⧸ J)) F := by
        rw [MvPolynomial.map_map]; rfl
      rw [← map_mul, ← hmapF, ← sub_eq_zero, ← map_sub]
      exact hD
    · intro L _ _ G' H' hG' hH' hGH'
      let φ₀ : R →ₐ[A] L := MvPolynomial.aeval
        (Sum.elim (fun ν : {ν : Fin n →₀ ℕ // deg ν ≤ d₁} => G'.coeff ν.1)
          (fun ν : {ν : Fin n →₀ ℕ // deg ν ≤ d₂} => H'.coeff ν.1))
      have hGmap : MvPolynomial.map (φ₀ : R →+* L) Gh = G' := by
        conv_rhs => rw [← expand d₁ G' hG']
        simp only [Gh, map_sum, MvPolynomial.map_monomial]
        refine Finset.sum_congr rfl (fun ν _ => ?_)
        congr 1
        exact MvPolynomial.aeval_X _ (Sum.inl ν)
      have hHmap : MvPolynomial.map (φ₀ : R →+* L) Hh = H' := by
        conv_rhs => rw [← expand d₂ H' hH']
        simp only [Hh, map_sum, MvPolynomial.map_monomial]
        refine Finset.sum_congr rfl (fun ν _ => ?_)
        congr 1
        exact MvPolynomial.aeval_X _ (Sum.inr ν)
      have hD0 : MvPolynomial.map (φ₀ : R →+* L) D = 0 := by
        simp only [D, map_sub, map_mul, hGmap, hHmap, MvPolynomial.map_map, φ₀.comp_algebraMap]
        rw [hGH', sub_self]
      have hle' : J ≤ RingHom.ker (φ₀ : R →+* L) := by
        rw [Ideal.span_le]
        intro y hy
        obtain ⟨ν, -, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hy)
        have := congrArg (fun P : MvPolynomial (Fin n) L => P.coeff ν) hD0
        simp only [MvPolynomial.coeff_map] at this
        rw [SetLike.mem_coe, RingHom.mem_ker]
        simpa using this
      exact ⟨Ideal.Quotient.liftₐ J φ₀ (fun x hx => RingHom.mem_ker.mp (hle' hx))⟩

  have s4 : ∀ Z : Set (PrimeSpectrum A), Topology.IsConstructible Z →
      (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A) ∉ Z →
      ∃ a : A, a ≠ 0 ∧ Z ⊆ PrimeSpectrum.zeroLocus {a} := by
    intro Z hZ hη
    obtain ⟨S, rfl⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hZ
    have key : ∀ C ∈ S, ∃ b : A, b ≠ 0 ∧ C.toSet ⊆ PrimeSpectrum.zeroLocus {b} := by
      intro C hC
      have hηC : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A) ∉ C.toSet := by
        intro h; apply hη
        exact Set.mem_biUnion hC h
      by_cases hf : C.f = 0
      · refine ⟨1, one_ne_zero, ?_⟩
        intro x hx
        exfalso
        have hx' : x ∈ PrimeSpectrum.zeroLocus (Set.range C.g) \
            PrimeSpectrum.zeroLocus {C.f} := hx
        rw [hf, PrimeSpectrum.zeroLocus_singleton_zero] at hx'
        exact hx'.2 (Set.mem_univ _)
      · have hηf : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A) ∉
            PrimeSpectrum.zeroLocus {C.f} := by
          rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
          exact hf
        have hηg : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A) ∉
            PrimeSpectrum.zeroLocus (Set.range C.g) :=
          fun h => hηC (show _ ∈ PrimeSpectrum.zeroLocus (Set.range C.g) \
            PrimeSpectrum.zeroLocus {C.f} from ⟨h, hηf⟩)
        rw [PrimeSpectrum.mem_zeroLocus] at hηg
        have : ∃ j, C.g j ≠ 0 := by
          by_contra hcon
          push_neg at hcon
          apply hηg
          rintro _ ⟨j, rfl⟩
          rw [hcon j]
          exact Submodule.zero_mem _
        obtain ⟨j, hj⟩ := this
        refine ⟨C.g j, hj, ?_⟩
        intro x hx
        have hx' : x ∈ PrimeSpectrum.zeroLocus (Set.range C.g) \
            PrimeSpectrum.zeroLocus {C.f} := hx
        exact PrimeSpectrum.zeroLocus_anti_mono (by rintro _ rfl; exact ⟨j, rfl⟩) hx'.1
    choose! b hb0 hbsub using key
    refine ⟨∏ C ∈ S, b C, Finset.prod_ne_zero_iff.mpr hb0, ?_⟩
    intro x hx
    have hx' : x ∈ ⋃ C ∈ S, C.toSet := hx
    simp only [Set.mem_iUnion] at hx'
    obtain ⟨C, hC, hxC⟩ := hx'
    have h1 := hbsub C hC hxC
    rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff] at h1 ⊢
    obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem b hC
    rw [hk]
    exact Ideal.mul_mem_right _ _ h1

  have s6 : Irreducible (MvPolynomial.map (algebraMap A (FractionRing A)) F) →
      F ≠ 0 ∧ 1 ≤ F.totalDegree := by
    intro hirr
    have hF : F ≠ 0 := by
      rintro rfl; rw [map_zero] at hirr; exact not_irreducible_zero hirr
    refine ⟨hF, ?_⟩
    by_contra h
    have h0 : F.totalDegree = 0 := by omega
    have hFC := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0
    have hc : F.coeff 0 ≠ 0 := fun hc => hF (by rw [hFC, hc, map_zero])
    apply hirr.not_isUnit
    rw [hFC, MvPolynomial.map_C]
    apply MvPolynomial.isUnit_iff_eq_C_of_isReduced.mpr
    refine ⟨_, ?_, rfl⟩
    apply Ne.isUnit
    intro h; apply hc
    exact IsFractionRing.injective A (FractionRing A) (h.trans (map_zero _).symm)

  have hK := hHyp (FractionRing A) (IsFractionRing.injective A (FractionRing A))
  obtain ⟨hF0, hN1⟩ := s6 hK
  obtain ⟨c, hc0, hc⟩ := s1 hF0
  obtain ⟨Zd, hZd⟩ : ∃ Zd : ℕ → Set (PrimeSpectrum A), ∀ d p, p ∈ Zd d ↔
      ∃ (L : Type u) (_ : Field L) (_ : Algebra A L),
        RingHom.ker (algebraMap A L) = p.asIdeal ∧
        ∃ G H : MvPolynomial (Fin n) L, G.totalDegree ≤ d ∧ H.totalDegree ≤ F.totalDegree - d ∧
          G * H = MvPolynomial.map (algebraMap A L) F :=
    ⟨fun d => {p | ∃ (L : Type u) (_ : Field L) (_ : Algebra A L),
        RingHom.ker (algebraMap A L) = p.asIdeal ∧
        ∃ G H : MvPolynomial (Fin n) L, G.totalDegree ≤ d ∧ H.totalDegree ≤ F.totalDegree - d ∧
          G * H = MvPolynomial.map (algebraMap A L) F}, fun d p => Iff.rfl⟩
  have hZcons : ∀ d, Topology.IsConstructible (Zd d) := by
    intro d
    obtain ⟨C, _, _, hfp, ⟨Gh, Hh, hGh, hHh, hGH⟩, huniv⟩ := s3 d (F.totalDegree - d)
    have heq : Zd d = Set.range (PrimeSpectrum.comap (algebraMap A C)) := by
      ext p
      rw [hZd]
      constructor
      · rintro ⟨L, _, _, hker, G, H, hG, hH, hGH'⟩
        obtain ⟨φ⟩ := huniv L G H hG hH hGH'
        refine ⟨⟨RingHom.ker φ, RingHom.ker_isPrime φ⟩, ?_⟩
        apply PrimeSpectrum.ext
        rw [PrimeSpectrum.comap_asIdeal, ← hker]
        ext x
        show φ (algebraMap A C x) = 0 ↔ algebraMap A L x = 0
        rw [AlgHom.commutes]
      · rintro ⟨P, rfl⟩
        let ψ₀ : C →+* FractionRing (C ⧸ P.asIdeal) :=
          (algebraMap (C ⧸ P.asIdeal) (FractionRing (C ⧸ P.asIdeal))).comp
            (Ideal.Quotient.mk P.asIdeal)
        letI instA : Algebra A (FractionRing (C ⧸ P.asIdeal)) := (ψ₀.comp (algebraMap A C)).toAlgebra
        let ψ : C →ₐ[A] FractionRing (C ⧸ P.asIdeal) := ⟨ψ₀, fun r => rfl⟩
        refine ⟨FractionRing (C ⧸ P.asIdeal), inferInstance, instA, ?_,
          MvPolynomial.map (ψ : C →+* FractionRing (C ⧸ P.asIdeal)) Gh,
          MvPolynomial.map (ψ : C →+* FractionRing (C ⧸ P.asIdeal)) Hh,
          (tdmap _ _).trans hGh, (tdmap _ _).trans hHh, ?_⟩
        · ext x
          rw [RingHom.mem_ker, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
          constructor
          · intro hx
            have h1 : Ideal.Quotient.mk P.asIdeal (algebraMap A C x) = 0 := by
              apply IsFractionRing.injective (C ⧸ P.asIdeal) (FractionRing (C ⧸ P.asIdeal))
              rw [map_zero]; exact hx
            exact Ideal.Quotient.eq_zero_iff_mem.mp h1
          · intro hx
            show algebraMap (C ⧸ P.asIdeal) (FractionRing (C ⧸ P.asIdeal))
              (Ideal.Quotient.mk P.asIdeal (algebraMap A C x)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
        · rw [← map_mul, hGH, MvPolynomial.map_map, ψ.comp_algebraMap]
    rw [heq]
    exact PrimeSpectrum.isConstructible_range_comap (RingHom.finitePresentation_algebraMap.mpr hfp)
  let Z : Set (PrimeSpectrum A) := ⋃ d ∈ ((Finset.Ico 1 F.totalDegree : Finset ℕ) : Set ℕ), Zd d
  have hZc : Topology.IsConstructible Z :=
    Topology.IsConstructible.biUnion (Finset.finite_toSet _) (fun d _ => hZcons d)
  have hηZ : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A) ∉ Z := by
    intro h
    simp only [Z, Set.mem_iUnion, Finset.coe_Ico, Set.mem_Ico, Finset.mem_coe,
      Finset.mem_Ico] at h
    obtain ⟨d, ⟨hd1, hdN⟩, hd⟩ := h
    rw [hZd] at hd
    obtain ⟨L, _, _, hker, G, H, hG, hH, hGH⟩ := hd
    have hinj : Function.Injective (algebraMap A L) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      have hx' : x ∈ RingHom.ker (algebraMap A L) := hx
      rw [hker] at hx'
      exact Ideal.mem_bot.mp hx'
    have hirr := hHyp L hinj
    obtain ⟨hFL0, hFLd⟩ :=
      hc L (algebraMap A L) (fun h => hc0 (hinj (h.trans (map_zero _).symm)))
    exact ((s2 L _ _ hFL0 hFLd hN1).mpr ⟨d, hd1, by omega, G, H, hG, hH, hGH⟩) hirr
  obtain ⟨a', ha'0, hZa⟩ := s4 Z hZc hηZ
  refine ⟨c * a', mul_ne_zero hc0 ha'0, ?_⟩
  intro L _ _ hL
  rw [map_mul] at hL
  have hcL : algebraMap A L c ≠ 0 := left_ne_zero_of_mul hL
  have ha'L : algebraMap A L a' ≠ 0 := right_ne_zero_of_mul hL
  obtain ⟨hFL0, hFLd⟩ := hc L (algebraMap A L) hcL
  by_contra hirr
  obtain ⟨d, hd1, hdN, G, H, hG, hH, hGH⟩ := (s2 L _ _ hFL0 hFLd hN1).mp hirr
  have hp : (⟨RingHom.ker (algebraMap A L), RingHom.ker_isPrime _⟩ : PrimeSpectrum A) ∈ Z := by
    simp only [Z, Set.mem_iUnion, Finset.coe_Ico, Set.mem_Ico, Finset.mem_coe, Finset.mem_Ico]
    refine ⟨d, ⟨hd1, by omega⟩, ?_⟩
    rw [hZd]
    exact ⟨L, inferInstance, inferInstance, rfl, G, H, hG, hH, hGH⟩
  have hmem := hZa hp
  rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff] at hmem
  exact ha'L hmem

theorem wcpa_gs_nondivisibility_spread : ∀ (A : Type u) [CommRing A] (d : ℕ) (F G : MvPolynomial (Fin (d + 1)) A), (MvPolynomial.finSuccEquiv A d F).Monic → G ∉ Ideal.span {F} → ∃ a : A, a ≠ 0 ∧ ∀ (L : Type u) [Field L] [Algebra A L], algebraMap A L a ≠ 0 → ¬ MvPolynomial.map (algebraMap A L) F ∣ MvPolynomial.map (algebraMap A L) G :=
by
  intro A _ d F G hmon hGF
  classical
  set P := MvPolynomial.finSuccEquiv A d F with hP
  set Q := MvPolynomial.finSuccEquiv A d G with hQ
  have s1 : ¬ P ∣ Q := by
    intro h
    apply hGF
    have h2 := map_dvd (MvPolynomial.finSuccEquiv A d).symm h
    rw [hP, hQ, AlgEquiv.symm_apply_apply, AlgEquiv.symm_apply_apply] at h2
    exact Ideal.mem_span_singleton.mpr h2
  have hR : Q %ₘ P ≠ 0 := fun h0 => s1 ((Polynomial.modByMonic_eq_zero_iff_dvd hmon).mp h0)
  obtain ⟨i, hi⟩ : ∃ i, (Q %ₘ P).coeff i ≠ 0 := by
    by_contra hc
    push_neg at hc
    exact hR (Polynomial.ext fun n => by rw [hc n, Polynomial.coeff_zero])
  obtain ⟨m, hm⟩ := MvPolynomial.ne_zero_iff.mp hi
  refine ⟨((Q %ₘ P).coeff i).coeff m, hm, ?_⟩
  intro L _ _ ha hdiv
  have s2 : ∀ p : MvPolynomial (Fin (d + 1)) A,
      MvPolynomial.finSuccEquiv L d (MvPolynomial.map (algebraMap A L) p) =
        Polynomial.map (MvPolynomial.map (algebraMap A L)) (MvPolynomial.finSuccEquiv A d p) := by
    intro p
    ext j n
    rw [MvPolynomial.finSuccEquiv_coeff_coeff, Polynomial.coeff_map, MvPolynomial.coeff_map,
      MvPolynomial.coeff_map, MvPolynomial.finSuccEquiv_coeff_coeff]
  have h1 := map_dvd (MvPolynomial.finSuccEquiv L d) hdiv
  rw [s2, s2, ← hP, ← hQ] at h1
  have hmonL : (Polynomial.map (MvPolynomial.map (algebraMap A L)) P).Monic := hmon.map _
  have h3 := (Polynomial.modByMonic_eq_zero_iff_dvd hmonL).mpr h1
  rw [← Polynomial.map_modByMonic _ hmon] at h3
  apply ha
  have h4 := congrArg (fun r => (r.coeff i).coeff m) h3
  simp only [Polynomial.coeff_map, MvPolynomial.coeff_map, Polynomial.coeff_zero,
    MvPolynomial.coeff_zero] at h4
  exact h4

theorem wcpa_gs_model_fiber_domain : ∀ (A L : Type u) [CommRing A] [Field L] [Algebra A L] (n : ℕ) (F G : MvPolynomial (Fin n) A), Irreducible (MvPolynomial.map (algebraMap A L) F) → ¬ MvPolynomial.map (algebraMap A L) F ∣ MvPolynomial.map (algebraMap A L) G → IsDomain (TensorProduct A L (Localization.Away (Ideal.Quotient.mk (Ideal.span {F}) G))) :=
by
  intro A L _ _ _ n F G hirr hne
  classical

  have hloc : ∀ (C : Type u) [CommRing C] [Algebra A C] (g : C),
      IsDomain (TensorProduct A C L) → TensorProduct.tmul A g (1 : L) ≠ 0 →
      IsDomain (TensorProduct A L (Localization.Away g)) := by
    intro C _ _ g hS hg
    have hgS : algebraMap C (TensorProduct A C L) g ≠ 0 := by
      rw [Algebra.TensorProduct.algebraMap_apply]
      exact hg
    haveI : IsDomain (Localization.Away (algebraMap C (TensorProduct A C L) g)) :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hgS)
    let e₁ := Algebra.TensorProduct.comm A L (Localization.Away g)
    let e₂ := (Algebra.TensorProduct.cancelBaseChange A C (Localization.Away g)
      (Localization.Away g) L).symm
    letI : Algebra (TensorProduct A C L)
        (TensorProduct C (Localization.Away g) (TensorProduct A C L)) :=
      Algebra.TensorProduct.rightAlgebra
    let e₃ := IsLocalization.Away.tensorRightEquiv (TensorProduct A C L) g (Localization.Away g)
    exact MulEquiv.isDomain _
      (e₁.toRingEquiv.trans (e₂.toRingEquiv.trans e₃.toRingEquiv)).toMulEquiv
  set C := MvPolynomial (Fin n) A ⧸ Ideal.span {F}
  set g : C := Ideal.Quotient.mk (Ideal.span {F}) G
  set S := TensorProduct A C L
  set FL := MvPolynomial.map (algebraMap A L) F
  set Q := MvPolynomial (Fin n) L ⧸ Ideal.span {FL}
  have hp : Prime FL := UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr
  haveI : (Ideal.span {FL}).IsPrime := (Ideal.span_singleton_prime hirr.ne_zero).mpr hp
  haveI hQ : IsDomain Q := Ideal.Quotient.isDomain _

  let ψ₀ : MvPolynomial (Fin n) A →ₐ[A] Q :=
    (Ideal.Quotient.mkₐ A (Ideal.span {FL})).comp (MvPolynomial.mapAlgHom (Algebra.ofId A L))
  have hψ₀ : ∀ p, ψ₀ p = Ideal.Quotient.mk _ (MvPolynomial.map (algebraMap A L) p) := fun p => rfl
  have hFL0 : (Ideal.Quotient.mk (Ideal.span {FL})) FL = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self FL)
  have hker : ∀ a ∈ Ideal.span {F}, ψ₀ a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hψ₀ F]
    exact mul_eq_zero_of_right _ hFL0
  let f : C →ₐ[A] Q := Ideal.Quotient.liftₐ (Ideal.span {F}) ψ₀ hker
  have hf : ∀ p, f (Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk _ (MvPolynomial.map (algebraMap A L) p) :=
    fun p => rfl

  let φ : TensorProduct A L C →ₐ[L] Q :=
    Algebra.TensorProduct.lift (Algebra.ofId L Q) f (fun _ _ => Commute.all _ _)
  let x : Fin n → TensorProduct A L C :=
    fun i => TensorProduct.tmul A (1 : L) (Ideal.Quotient.mk (Ideal.span {F}) (MvPolynomial.X i))
  have key : ((MvPolynomial.aeval x).restrictScalars A).comp
      (MvPolynomial.mapAlgHom (Algebra.ofId A L)) =
      (Algebra.TensorProduct.includeRight).comp (Ideal.Quotient.mkₐ A (Ideal.span {F})) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [x, MvPolynomial.mapAlgHom_apply]
  have hkey : ∀ p, MvPolynomial.aeval x (MvPolynomial.map (algebraMap A L) p) =
      TensorProduct.tmul A (1 : L) (Ideal.Quotient.mk (Ideal.span {F}) p) := by
    intro p
    have := DFunLike.congr_fun key p
    simpa [MvPolynomial.mapAlgHom_apply] using this
  let ψ : Q →ₐ[L] TensorProduct A L C :=
    Ideal.Quotient.liftₐ (Ideal.span {FL}) (MvPolynomial.aeval x) (by
      intro a ha
      have h0 : MvPolynomial.aeval x FL = 0 := by
        rw [hkey F, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self F),
          TensorProduct.tmul_zero]
      have hle : Ideal.span {FL} ≤ RingHom.ker (MvPolynomial.aeval x) :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (RingHom.mem_ker.mpr h0))
      exact RingHom.mem_ker.mp (hle ha))
  have hψφ : ψ.comp φ = AlgHom.id L _ := by
    apply Algebra.TensorProduct.ext
    · exact Subsingleton.elim _ _
    · apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro i
      simp [φ, ψ, x, f, ψ₀]
      change ψ (f (Ideal.Quotient.mk _ (MvPolynomial.X i))) = _
      rw [hf, MvPolynomial.map_X]
      change MvPolynomial.aeval x (MvPolynomial.X i) = _
      rw [MvPolynomial.aeval_X]
  have hφinj : Function.Injective φ :=
    Function.LeftInverse.injective (g := ψ) (fun t => DFunLike.congr_fun hψφ t)
  haveI hT : IsDomain (TensorProduct A L C) := Function.Injective.isDomain φ.toRingHom hφinj
  haveI hS : IsDomain S := MulEquiv.isDomain _ (Algebra.TensorProduct.comm A C L).toMulEquiv

  have hg : TensorProduct.tmul A g (1 : L) ≠ 0 := by
    intro h0
    have h1 : φ ((Algebra.TensorProduct.comm A C L) (TensorProduct.tmul A g (1 : L))) =
        Ideal.Quotient.mk _ (MvPolynomial.map (algebraMap A L) G) := by
      simp [φ, g]
      exact hf G
    rw [h0, map_zero, map_zero] at h1
    apply hne
    exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h1.symm)

  exact hloc C g hS hg

theorem wcpa_gs_nzd_spread : ∀ (A K B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [Field K] [Algebra A K] [IsFractionRing A K] [CommRing B] [Algebra A B] [Algebra.FiniteType A B] (g : B), IsDomain (TensorProduct A K B) → (1 : K) ⊗ₜ[A] g ≠ 0 → ∃ a : A, a ≠ 0 ∧ ∀ (L : Type u) [Field L] [Algebra A L], algebraMap A L a ≠ 0 → ∀ z : TensorProduct A L B, z * ((1 : L) ⊗ₜ[A] g) = 0 → z = 0 :=
by
  intro A K B _ _ _ _ _ _ _ _ _ g hdom hg
  classical

  obtain ⟨a, ha, hfree⟩ := wcpa_ffp_generic_free A B (B × (B ⧸ Ideal.span {g}))
  have hbc := IsLocalizedModule.isBaseChange (Submonoid.powers a) (Localization.Away a)
    (LocalizedModule.mkLinearMap (Submonoid.powers a) (B × (B ⧸ Ideal.span {g})))
  haveI : Module.Flat (Localization.Away a)
      (LocalizedModule (Submonoid.powers a) (B × (B ⧸ Ideal.span {g}))) := Module.Flat.of_free
  haveI : Module.Flat (Localization.Away a)
      (TensorProduct A (Localization.Away a) (B × (B ⧸ Ideal.span {g}))) :=
    Module.Flat.of_linearEquiv hbc.equiv
  haveI : Module.Flat (Localization.Away a)
      (TensorProduct A (Localization.Away a) B ×
        TensorProduct A (Localization.Away a) (B ⧸ Ideal.span {g})) :=
    Module.Flat.of_linearEquiv
      (TensorProduct.prodRight A (Localization.Away a) (Localization.Away a) B
        (B ⧸ Ideal.span {g})).symm
  haveI hflatB : Module.Flat (Localization.Away a) (TensorProduct A (Localization.Away a) B) :=
    Module.Flat.of_retract
      (LinearMap.inl (Localization.Away a) (TensorProduct A (Localization.Away a) B)
        (TensorProduct A (Localization.Away a) (B ⧸ Ideal.span {g})))
      (LinearMap.fst (Localization.Away a) (TensorProduct A (Localization.Away a) B)
        (TensorProduct A (Localization.Away a) (B ⧸ Ideal.span {g})))
      (LinearMap.ext fun _ => rfl)
  haveI hflatQ : Module.Flat (Localization.Away a)
      (TensorProduct A (Localization.Away a) (B ⧸ Ideal.span {g})) :=
    Module.Flat.of_retract
      (LinearMap.inr (Localization.Away a) (TensorProduct A (Localization.Away a) B)
        (TensorProduct A (Localization.Away a) (B ⧸ Ideal.span {g})))
      (LinearMap.snd (Localization.Away a) (TensorProduct A (Localization.Away a) B)
        (TensorProduct A (Localization.Away a) (B ⧸ Ideal.span {g})))
      (LinearMap.ext fun _ => rfl)

  have hunitK : IsUnit (algebraMap A K a) :=
    isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr ha)
  have hreg : ∀ x : TensorProduct A (Localization.Away a) B,
      x * ((1 : Localization.Away a) ⊗ₜ[A] g) = 0 → x = 0 := by
    letI : Algebra (Localization.Away a) K := (IsLocalization.Away.lift a hunitK).toAlgebra
    haveI : IsScalarTower A (Localization.Away a) K :=
      IsScalarTower.of_algebraMap_eq (fun r => (IsLocalization.Away.lift_eq a hunitK r).symm)
    have hψinj : Function.Injective (algebraMap (Localization.Away a) K) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj (Submonoid.powers a) x
      have h1 : algebraMap A K r = 0 := by
        rw [IsScalarTower.algebraMap_apply A (Localization.Away a) K]
        simp only at hrs
        rw [← hrs, map_mul, hx, zero_mul]
      have hr : r = 0 := (map_eq_zero_iff _ (IsFractionRing.injective A K)).mp h1
      rw [hr, map_zero] at hrs
      exact (IsLocalization.map_units (Localization.Away a) s).mul_left_eq_zero.mp hrs
    have hinc : Function.Injective (Algebra.TensorProduct.includeRight (R := Localization.Away a)
        (A := K) (B := TensorProduct A (Localization.Away a) B)) :=
      Algebra.TensorProduct.includeRight_injective hψinj
    let j := Algebra.TensorProduct.cancelBaseChange A (Localization.Away a) K K B
    intro x hx
    have hj1 : j (Algebra.TensorProduct.includeRight ((1 : Localization.Away a) ⊗ₜ[A] g)) =
        (1 : K) ⊗ₜ[A] g := by
      show j ((1 : K) ⊗ₜ[Localization.Away a] ((1 : Localization.Away a) ⊗ₜ[A] g)) = _
      rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul]
    have h2 : j (Algebra.TensorProduct.includeRight x) * ((1 : K) ⊗ₜ[A] g) = 0 := by
      rw [← hj1, ← map_mul, ← map_mul, hx, map_zero, map_zero]
    have h3 : j (Algebra.TensorProduct.includeRight x) = 0 :=
      (mul_eq_zero.mp h2).resolve_right hg
    have h4 : Algebra.TensorProduct.includeRight (R := Localization.Away a) (A := K) x = 0 := by
      have := congrArg j.symm h3
      rwa [AlgEquiv.symm_apply_apply, map_zero] at this
    exact hinc (h4.trans (map_zero _).symm)

  let μ := LinearMap.mulRight (Localization.Away a)
    ((1 : Localization.Away a) ⊗ₜ[A] g : TensorProduct A (Localization.Away a) B)
  let π := LinearMap.baseChange (Localization.Away a)
    (Ideal.Quotient.mkₐ A (Ideal.span {g})).toLinearMap
  have hex : Function.Exact (LinearMap.mulRight A g)
      (Ideal.Quotient.mkₐ A (Ideal.span {g})).toLinearMap := by
    intro y
    simp only [AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton', Set.mem_range,
      LinearMap.mulRight_apply]
  have hμeq : ⇑μ = ⇑(LinearMap.lTensor (Localization.Away a) (LinearMap.mulRight A g)) := by
    funext z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul s b =>
      simp only [μ, LinearMap.mulRight_apply, LinearMap.lTensor_tmul,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hsurj : Function.Surjective π := by
    show Function.Surjective ⇑(LinearMap.baseChange (Localization.Away a)
      (Ideal.Quotient.mkₐ A (Ideal.span {g})).toLinearMap)
    rw [LinearMap.baseChange_eq_ltensor]
    exact LinearMap.lTensor_surjective _ (Ideal.Quotient.mkₐ_surjective A _)
  have hexact : Function.Exact μ π := by
    show Function.Exact ⇑μ ⇑(LinearMap.baseChange (Localization.Away a)
      (Ideal.Quotient.mkₐ A (Ideal.span {g})).toLinearMap)
    rw [LinearMap.baseChange_eq_ltensor, hμeq]
    exact lTensor_exact _ hex (Ideal.Quotient.mkₐ_surjective A _)
  have hμinj : Function.Injective μ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    exact hreg x hx

  refine ⟨a, ha, ?_⟩
  intro L _ _ hL z hz
  have hunitL : IsUnit (algebraMap A L a) := isUnit_iff_ne_zero.mpr hL
  letI : Algebra (Localization.Away a) L := (IsLocalization.Away.lift a hunitL).toAlgebra
  haveI : IsScalarTower A (Localization.Away a) L :=
    IsScalarTower.of_algebraMap_eq (fun r => (IsLocalization.Away.lift_eq a hunitL r).symm)
  have hinjL := LinearMap.lTensor_injective_of_exact_of_flat π hsurj μ hμinj hexact L
  let e := Algebra.TensorProduct.cancelBaseChange A (Localization.Away a) L L B
  have he1 : e ((1 : L) ⊗ₜ[Localization.Away a] ((1 : Localization.Away a) ⊗ₜ[A] g)) =
      (1 : L) ⊗ₜ[A] g := by
    rw [Algebra.TensorProduct.cancelBaseChange_tmul, one_smul]
  have hlt : ∀ z' : TensorProduct A L B,
      LinearMap.lTensor L μ (e.symm z') =
        e.symm z' * ((1 : L) ⊗ₜ[Localization.Away a] ((1 : Localization.Away a) ⊗ₜ[A] g)) := by
    intro z'
    generalize e.symm z' = w
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero, zero_mul]
    | tmul l b =>
      simp only [μ, LinearMap.lTensor_tmul, LinearMap.mulRight_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    | add x y hx hy => rw [map_add, hx, hy, add_mul]
  have hw : e.symm z *
      ((1 : L) ⊗ₜ[Localization.Away a] ((1 : Localization.Away a) ⊗ₜ[A] g)) = 0 := by
    apply e.injective
    rw [map_mul, he1, AlgEquiv.apply_symm_apply, hz, map_zero]
  have hw0 : e.symm z = 0 := by
    apply hinjL
    rw [hlt, hw, map_zero]
  have := congrArg e hw0
  rwa [AlgEquiv.apply_symm_apply, map_zero] at this

theorem wcpa_gs_domain_of_localization : ∀ (A B C L : Type u) [CommRing A] [CommRing B] [CommRing C] [Field L] [Algebra A B] [Algebra A C] [Algebra A L] (g : B), (C ≃ₐ[A] Localization.Away g) → IsDomain (TensorProduct A L C) → (∀ z : TensorProduct A L B, z * ((1 : L) ⊗ₜ[A] g) = 0 → z = 0) → IsDomain (TensorProduct A L B) :=
by
  intro A B C L _ _ _ _ _ _ _ g e hC hg
  let σ : TensorProduct A B L ≃ₐ[A] TensorProduct A L B := Algebra.TensorProduct.comm A B L
  have s1 : algebraMap B (TensorProduct A B L) g ∈ nonZeroDivisors (TensorProduct A B L) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have h1 : algebraMap B (TensorProduct A B L) g = g ⊗ₜ[A] (1 : L) := by
      rw [Algebra.TensorProduct.algebraMap_apply]; rfl
    rw [h1] at hx
    have h2 : σ x * ((1 : L) ⊗ₜ[A] g) = 0 := by
      have := congrArg σ hx
      rw [map_mul, map_zero] at this
      simpa [σ, Algebra.TensorProduct.comm_tmul] using this
    have h3 := hg _ h2
    exact σ.injective (h3.trans (map_zero σ).symm)
  have s2 : Algebra.algebraMapSubmonoid (TensorProduct A B L) (Submonoid.powers g) ≤
      nonZeroDivisors (TensorProduct A B L) := by
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨n, rfl⟩ := hx
    simp only [map_pow]
    exact pow_mem s1 n
  have := IsLocalization.tensor (R := B) (S := TensorProduct A B L) (Localization.Away g)
    (Submonoid.powers g)
  have s4 : Function.Injective (algebraMap (TensorProduct A B L)
      (TensorProduct B (TensorProduct A B L) (Localization.Away g))) :=
    IsLocalization.injective
      (M := Algebra.algebraMapSubmonoid (TensorProduct A B L) (Submonoid.powers g))
      (TensorProduct B (TensorProduct A B L) (Localization.Away g)) s2
  let τ₁ := Algebra.TensorProduct.comm B (TensorProduct A B L) (Localization.Away g)
  let τ₂ := Algebra.TensorProduct.cancelBaseChange A B (Localization.Away g) (Localization.Away g) L
  let τ₃ := Algebra.TensorProduct.comm A (Localization.Away g) L
  let τ₄ := Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[A] L) e.symm
  let Φ : TensorProduct A L B →+* TensorProduct A L C :=
    τ₄.toRingHom.comp (τ₃.toRingHom.comp (τ₂.toRingHom.comp (τ₁.toRingHom.comp
      ((algebraMap (TensorProduct A B L)
        (TensorProduct B (TensorProduct A B L) (Localization.Away g))).comp σ.symm.toRingHom))))
  have hΦ : Function.Injective Φ :=
    τ₄.injective.comp (τ₃.injective.comp (τ₂.injective.comp (τ₁.injective.comp
      (s4.comp σ.symm.injective))))
  exact hΦ.isDomain Φ

theorem wcpa_lfg_gid_generic_spread : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [CommRing B] [Algebra A B] [Algebra.FiniteType A B], (∀ (L : Type u) [Field L] [Algebra (⊥ : Ideal A).ResidueField L], IsDomain (TensorProduct (⊥ : Ideal A).ResidueField L ((⊥ : Ideal A).Fiber B))) → ∃ a : A, a ≠ 0 ∧ ∀ (q : Ideal A) [q.IsPrime], a ∉ q → ∀ (L : Type u) [Field L] [Algebra q.ResidueField L], IsDomain (TensorProduct q.ResidueField L (q.Fiber B)) :=
by
  intro A B _ _ _ _ _ _ hGI
  classical

  have red : ∀ a : A, (∀ (L : Type u) [Field L] [Algebra A L], algebraMap A L a ≠ 0 →
      IsDomain (TensorProduct A L B)) → ∀ (q : Ideal A) [q.IsPrime], a ∉ q →
      ∀ (L : Type u) [Field L] [Algebra q.ResidueField L],
        IsDomain (TensorProduct q.ResidueField L (q.Fiber B)) := by
    intro a h q _ haq L _ _
    letI : Algebra A L :=
      ((algebraMap q.ResidueField L).comp (algebraMap A q.ResidueField)).toAlgebra
    haveI : IsScalarTower A q.ResidueField L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have ha : algebraMap A L a ≠ 0 := by
      change algebraMap q.ResidueField L (algebraMap A q.ResidueField a) ≠ 0
      rw [map_ne_zero]
      intro h0
      exact haq (Ideal.algebraMap_residueField_eq_zero.mp h0)
    haveI := h L ha
    exact MulEquiv.isDomain _
      (Algebra.TensorProduct.cancelBaseChange A q.ResidueField L L B).toMulEquiv

  have hinj : ∀ (L : Type u) [Field L] [Algebra A L], Function.Injective (algebraMap A L) →
      IsDomain (TensorProduct A L B) := by
    intro L _ _ hL
    let lam : (⊥ : Ideal A).ResidueField →+* L :=
      Ideal.ResidueField.lift (⊥ : Ideal A) (algebraMap A L) (by simp) (by
        intro r hr
        have hr0 : r ≠ 0 := fun h0 => hr (by rw [h0]; exact Submodule.zero_mem _)
        have : algebraMap A L r ≠ 0 := fun h0 => hr0 (hL (h0.trans (map_zero _).symm))
        exact isUnit_iff_ne_zero.mpr this)
    letI : Algebra (⊥ : Ideal A).ResidueField L := lam.toAlgebra
    haveI : IsScalarTower A (⊥ : Ideal A).ResidueField L :=
      IsScalarTower.of_algebraMap_eq (fun r =>
        (Ideal.ResidueField.lift_algebraMap (⊥ : Ideal A) (algebraMap A L) _ _ r).symm)
    haveI := hGI L
    exact MulEquiv.isDomain _
      (Algebra.TensorProduct.cancelBaseChange A (⊥ : Ideal A).ResidueField L L B).symm.toMulEquiv

  haveI hBK : IsDomain (TensorProduct A (FractionRing A) B) :=
    hinj (FractionRing A) (IsFractionRing.injective A (FractionRing A))

  have hgeomD : ∀ (L : Type u) [Field L] [Algebra (FractionRing A) L],
      IsDomain (TensorProduct (FractionRing A) L (TensorProduct A (FractionRing A) B)) := by
    intro L _ _
    letI : Algebra A L := ((algebraMap (FractionRing A) L).comp
      (algebraMap A (FractionRing A))).toAlgebra
    haveI : IsScalarTower A (FractionRing A) L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI := hinj L ((algebraMap (FractionRing A) L).injective.comp
      (IsFractionRing.injective A (FractionRing A)))
    exact MulEquiv.isDomain _
      (Algebra.TensorProduct.cancelBaseChange A (FractionRing A) L L B).toMulEquiv

  have hgeomE := wcpa_gs_geom_integral_fraction_field (FractionRing A)
    (TensorProduct A (FractionRing A) B) hgeomD
  obtain ⟨d, x, y, hx, hxy⟩ := wcpa_gs_separating_primitive (FractionRing A)
    (TensorProduct A (FractionRing A) B) hgeomE
  obtain ⟨F, v, hmon, -, hFv, hkerK, hkerA, hratA⟩ := wcpa_gs_monic_model A (FractionRing A)
    (FractionRing (TensorProduct A (FractionRing A) B)) d x y hx hxy
  have hF0 : F ≠ 0 := fun h => hmon.ne_zero (by rw [h, map_zero])

  have hirrInj := wcpa_gs_model_abs_irreducible A (FractionRing A)
    (FractionRing (TensorProduct A (FractionRing A) B)) (d + 1) F v hF0
    (by rw [MvPolynomial.aeval_map_algebraMap]; exact hFv) hkerK hgeomE
  obtain ⟨a₁, ha₁, hirr⟩ := wcpa_gs_bertini_noether A (d + 1) F hirrInj

  obtain ⟨hAE, htor, hratB⟩ := wcpa_gs_generic_point_map A (FractionRing A) B
  obtain ⟨G, g, hG, hg, ⟨eG⟩⟩ := wcpa_gs_birational_spread A B
    (FractionRing (TensorProduct A (FractionRing A) B)) (d + 1) F
    ((IsScalarTower.toAlgHom A (TensorProduct A (FractionRing A) B)
      (FractionRing (TensorProduct A (FractionRing A) B))).comp
      (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A (FractionRing A) B))
    v hAE htor hFv hkerA hratB hratA

  have hGF : G ∉ Ideal.span {F} := by
    intro hmem
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hmem
    apply hG
    rw [map_mul, hFv, mul_zero]
  obtain ⟨a₂, ha₂, hndiv⟩ := wcpa_gs_nondivisibility_spread A d F G hmon hGF

  have hg1 : (1 : FractionRing A) ⊗ₜ[A] g ≠ 0 := by
    intro h0
    apply hg
    change (IsScalarTower.toAlgHom A (TensorProduct A (FractionRing A) B)
      (FractionRing (TensorProduct A (FractionRing A) B))) ((1 : FractionRing A) ⊗ₜ[A] g) = 0
    rw [h0, map_zero]
  obtain ⟨a₃, ha₃, hnzd⟩ := wcpa_gs_nzd_spread A (FractionRing A) B g hBK hg1

  refine ⟨a₁ * a₂ * a₃, mul_ne_zero (mul_ne_zero ha₁ ha₂) ha₃, red _ ?_⟩
  intro L _ _ hL
  rw [map_mul, map_mul] at hL
  have h1 : algebraMap A L a₁ ≠ 0 := left_ne_zero_of_mul (left_ne_zero_of_mul hL)
  have h2 : algebraMap A L a₂ ≠ 0 := right_ne_zero_of_mul (left_ne_zero_of_mul hL)
  have h3 : algebraMap A L a₃ ≠ 0 := right_ne_zero_of_mul hL
  haveI := wcpa_gs_model_fiber_domain A L (d + 1) F G (hirr L h1) (hndiv L h2)
  exact wcpa_gs_domain_of_localization A B _ L g eG this (hnzd L h3)

theorem wcpa_lfg_pgi_geom_integral_descent : ∀ (R R₀ S₀ S : Type u) [CommRing R] [CommRing R₀] [CommRing S₀] [CommRing S] [Algebra.FiniteType ℤ R₀] [Algebra R₀ R] [Algebra R₀ S₀] [Algebra.FiniteType R₀ S₀] [Algebra R S], (TensorProduct R₀ R S₀ ≃ₐ[R] S) → (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra.FiniteType ℤ R₁) (_ : Algebra R₀ R₁) (_ : Algebra R₁ R) (_ : IsScalarTower R₀ R₁ R), ∀ (p : Ideal R₁) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber (TensorProduct R₀ R₁ S₀))) :=
by
  intro R R₀ S₀ S _ _ _ _ _ _ _ _ _ e hGI
  classical
  haveI hR₀noeth : IsNoetherianRing R₀ := Algebra.FiniteType.isNoetherianRing ℤ R₀

  have descent : ∀ (A A' B : Type u) [CommRing A] [CommRing A'] [CommRing B] [Algebra A A'] [Algebra A B] (P : Ideal A') [P.IsPrime], (∀ (L : Type u) [Field L] [Algebra P.ResidueField L], IsDomain (TensorProduct P.ResidueField L (P.Fiber (TensorProduct A A' B)))) → ∀ (L : Type u) [Field L] [Algebra (P.comap (algebraMap A A')).ResidueField L], IsDomain (TensorProduct (P.comap (algebraMap A A')).ResidueField L ((P.comap (algebraMap A A')).Fiber B)) := by
    intro A A' B _ _ _ _ _ P _ hG L _ _
    letI φ : (P.comap (algebraMap A A')).ResidueField →+* P.ResidueField :=
      Ideal.ResidueField.map (P.comap (algebraMap A A')) P (algebraMap A A') rfl
    letI iφ : Algebra (P.comap (algebraMap A A')).ResidueField P.ResidueField := φ.toAlgebra

    have key : ∀ (L'' : Type u) [Field L''] [Algebra P.ResidueField L'']
        [Algebra (P.comap (algebraMap A A')).ResidueField L'']
        [IsScalarTower (P.comap (algebraMap A A')).ResidueField P.ResidueField L''],
        IsDomain (TensorProduct (P.comap (algebraMap A A')).ResidueField L''
          ((P.comap (algebraMap A A')).Fiber B)) := by
      intro L'' _ _ _ _
      letI : Algebra A' L'' :=
        ((algebraMap P.ResidueField L'').comp (algebraMap A' P.ResidueField)).toAlgebra
      letI : Algebra A L'' := ((algebraMap (P.comap (algebraMap A A')).ResidueField L'').comp
        (algebraMap A (P.comap (algebraMap A A')).ResidueField)).toAlgebra
      haveI : IsScalarTower A' P.ResidueField L'' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : IsScalarTower A (P.comap (algebraMap A A')).ResidueField L'' :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : IsScalarTower A A' L'' := IsScalarTower.of_algebraMap_eq (fun r => by
        change algebraMap (P.comap (algebraMap A A')).ResidueField L''
            (algebraMap A (P.comap (algebraMap A A')).ResidueField r) =
          algebraMap P.ResidueField L'' (algebraMap A' P.ResidueField (algebraMap A A' r))
        rw [IsScalarTower.algebraMap_apply (P.comap (algebraMap A A')).ResidueField
          P.ResidueField L'']
        congr 1
        exact Ideal.ResidueField.map_algebraMap (P.comap (algebraMap A A')) P (algebraMap A A') rfl r)
      let e' : TensorProduct P.ResidueField L'' (P.Fiber (TensorProduct A A' B)) ≃+*
          TensorProduct (P.comap (algebraMap A A')).ResidueField L''
            ((P.comap (algebraMap A A')).Fiber B) :=
        (((Algebra.TensorProduct.cancelBaseChange A' P.ResidueField L'' L''
            (TensorProduct A A' B)).toRingEquiv.trans
          (Algebra.TensorProduct.cancelBaseChange A A' L'' L'' B).toRingEquiv).trans
          (Algebra.TensorProduct.cancelBaseChange A (P.comap (algebraMap A A')).ResidueField L'' L''
            B).toRingEquiv.symm)
      haveI : IsDomain (TensorProduct P.ResidueField L'' (P.Fiber (TensorProduct A A' B))) :=
        hG L''
      exact MulEquiv.isDomain (TensorProduct P.ResidueField L'' (P.Fiber (TensorProduct A A' B)))
        e'.symm.toMulEquiv

    haveI : Nontrivial (TensorProduct (P.comap (algebraMap A A')).ResidueField L P.ResidueField) :=
      inferInstance
    obtain ⟨m, hm⟩ := Ideal.exists_maximal
      (TensorProduct (P.comap (algebraMap A A')).ResidueField L P.ResidueField)
    letI : Field (TensorProduct (P.comap (algebraMap A A')).ResidueField L P.ResidueField ⧸ m) :=
      Ideal.Quotient.field m
    letI : Algebra P.ResidueField
        (TensorProduct (P.comap (algebraMap A A')).ResidueField L P.ResidueField ⧸ m) :=
      ((Ideal.Quotient.mk m).comp
        (Algebra.TensorProduct.includeRight (R := (P.comap (algebraMap A A')).ResidueField)
          (A := L) (B := P.ResidueField)).toRingHom).toAlgebra
    haveI : IsScalarTower (P.comap (algebraMap A A')).ResidueField P.ResidueField
        (TensorProduct (P.comap (algebraMap A A')).ResidueField L P.ResidueField ⧸ m) :=
      IsScalarTower.of_algebraMap_eq (fun c =>
        (congrArg (Ideal.Quotient.mk m)
          ((Algebra.TensorProduct.includeRight (R := (P.comap (algebraMap A A')).ResidueField)
            (A := L) (B := P.ResidueField)).commutes c)).symm)
    haveI hD := key (TensorProduct (P.comap (algebraMap A A')).ResidueField L P.ResidueField ⧸ m)
    let lam : L →ₐ[(P.comap (algebraMap A A')).ResidueField]
        (TensorProduct (P.comap (algebraMap A A')).ResidueField L P.ResidueField ⧸ m) :=
      (Ideal.Quotient.mkₐ _ m).comp Algebra.TensorProduct.includeLeft
    have hlam : Function.Injective lam := lam.toRingHom.injective
    let Φ := Algebra.TensorProduct.map lam
      (AlgHom.id (P.comap (algebraMap A A')).ResidueField ((P.comap (algebraMap A A')).Fiber B))
    have hΦ : Function.Injective Φ := by
      have h1 : (⇑Φ) = ⇑(LinearMap.rTensor ((P.comap (algebraMap A A')).Fiber B)
          lam.toLinearMap) := rfl
      rw [h1]
      exact Module.Flat.rTensor_preserves_injective_linearMap _ hlam
    exact Function.Injective.isDomain Φ.toRingHom hΦ

  have ascent : ∀ (A A' B : Type u) [CommRing A] [CommRing A'] [CommRing B] [Algebra A A']
      [Algebra A B] (P : Ideal A') [P.IsPrime],
      (∀ (L : Type u) [Field L] [Algebra (P.comap (algebraMap A A')).ResidueField L],
        IsDomain (TensorProduct (P.comap (algebraMap A A')).ResidueField L
          ((P.comap (algebraMap A A')).Fiber B))) →
      ∀ (L : Type u) [Field L] [Algebra P.ResidueField L],
        IsDomain (TensorProduct P.ResidueField L (P.Fiber (TensorProduct A A' B))) := by
    intro A A' B _ _ _ _ _ P _ hG L _ _
    letI φ : (P.comap (algebraMap A A')).ResidueField →+* P.ResidueField :=
      Ideal.ResidueField.map (P.comap (algebraMap A A')) P (algebraMap A A') rfl
    letI i1 : Algebra (P.comap (algebraMap A A')).ResidueField L :=
      ((algebraMap P.ResidueField L).comp φ).toAlgebra
    letI : Algebra A' L :=
      ((algebraMap P.ResidueField L).comp (algebraMap A' P.ResidueField)).toAlgebra
    letI : Algebra A L := ((algebraMap A' L).comp (algebraMap A A')).toAlgebra
    haveI : IsScalarTower A' P.ResidueField L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower A A' L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower A (P.comap (algebraMap A A')).ResidueField L :=
      IsScalarTower.of_algebraMap_eq (fun r =>
        (congrArg (algebraMap P.ResidueField L)
          (Ideal.ResidueField.map_algebraMap (P.comap (algebraMap A A')) P (algebraMap A A') rfl
            r)).symm)
    let e' : TensorProduct P.ResidueField L (P.Fiber (TensorProduct A A' B)) ≃+*
        TensorProduct (P.comap (algebraMap A A')).ResidueField L
          ((P.comap (algebraMap A A')).Fiber B) :=
      (((Algebra.TensorProduct.cancelBaseChange A' P.ResidueField L L
          (TensorProduct A A' B)).toRingEquiv.trans
        (Algebra.TensorProduct.cancelBaseChange A A' L L B).toRingEquiv).trans
        (Algebra.TensorProduct.cancelBaseChange A (P.comap (algebraMap A A')).ResidueField L L
          B).toRingEquiv.symm)
    haveI : IsDomain (TensorProduct (P.comap (algebraMap A A')).ResidueField L
        ((P.comap (algebraMap A A')).Fiber B)) := @hG L _ i1
    exact MulEquiv.isDomain _ e'.toMulEquiv

  have hGI' : ∀ (P : Ideal R) [P.IsPrime] (L : Type u) [Field L] [Algebra P.ResidueField L],
      IsDomain (TensorProduct P.ResidueField L (P.Fiber (TensorProduct R₀ R S₀))) := by
    intro P _ L _ _
    haveI := hGI P L
    let e1 : P.Fiber (TensorProduct R₀ R S₀) ≃ₐ[P.ResidueField] P.Fiber S :=
      Algebra.TensorProduct.congr AlgEquiv.refl e
    let e2 : TensorProduct P.ResidueField L (P.Fiber (TensorProduct R₀ R S₀)) ≃ₐ[L]
        TensorProduct P.ResidueField L (P.Fiber S) :=
      Algebra.TensorProduct.congr AlgEquiv.refl e1
    exact MulEquiv.isDomain _ e2.toMulEquiv

  obtain ⟨G, hGdef⟩ : ∃ G : Ideal R₀ → Prop, G = fun I : Ideal R₀ => ∀ [I.IsPrime] (L : Type u) [Field L]
      [Algebra I.ResidueField L], IsDomain (TensorProduct I.ResidueField L (I.Fiber S₀)) :=
    ⟨_, rfl⟩
  have Gunfold : ∀ I : Ideal R₀, G I ↔ ∀ [I.IsPrime] (L : Type u) [Field L]
      [Algebra I.ResidueField L], IsDomain (TensorProduct I.ResidueField L (I.Fiber S₀)) := by
    intro I; subst hGdef; exact Iff.rfl
  have Gcongr : ∀ I J : Ideal R₀, I = J → G I → G J := fun I J h hI => h ▸ hI

  have H1 : ∀ (P : Ideal R) [P.IsPrime], G (P.comap (algebraMap R₀ R)) := by
    intro P _
    rw [Gunfold]
    intro _ L _ _
    exact descent R₀ R S₀ P (fun L _ _ => hGI' P L) L

  have H2 : ∀ (p : Ideal R₀) [p.IsPrime], G p → ∃ a : R₀, a ∉ p ∧
      ∀ (q : Ideal R₀) [q.IsPrime], p ≤ q → a ∉ q → G q := by
    intro p _ hGp
    have hbot : (⊥ : Ideal (R₀ ⧸ p)).comap (algebraMap R₀ (R₀ ⧸ p)) = p := by
      rw [Ideal.Quotient.algebraMap_eq, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    have hGbot : G ((⊥ : Ideal (R₀ ⧸ p)).comap (algebraMap R₀ (R₀ ⧸ p))) :=
      Gcongr _ _ hbot.symm hGp
    rw [Gunfold] at hGbot
    have hgen := ascent R₀ (R₀ ⧸ p) S₀ ⊥ (fun L _ _ => hGbot L)
    obtain ⟨abar, habar0, habar⟩ :=
      wcpa_lfg_gid_generic_spread (R₀ ⧸ p) (TensorProduct R₀ (R₀ ⧸ p) S₀) hgen
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective abar
    refine ⟨a, ?_, ?_⟩
    · intro hap
      exact habar0 (Ideal.Quotient.eq_zero_iff_mem.mpr hap)
    · intro q _ hpq haq
      haveI hqbar : (q.map (Ideal.Quotient.mk p)).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hpq)
      have hcq : (q.map (Ideal.Quotient.mk p)).comap (algebraMap R₀ (R₀ ⧸ p)) = q := by
        rw [Ideal.Quotient.algebraMap_eq,
          Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
        exact sup_eq_left.mpr hpq
      have hnot : Ideal.Quotient.mk p a ∉ q.map (Ideal.Quotient.mk p) := by
        intro h
        apply haq
        rw [← hcq, Ideal.mem_comap, Ideal.Quotient.algebraMap_eq]
        exact h
      have hq' := habar (q.map (Ideal.Quotient.mk p)) hnot
      have hdesc := descent R₀ (R₀ ⧸ p) S₀ (q.map (Ideal.Quotient.mk p))
        (fun L _ _ => hq' L)
      apply Gcongr _ _ hcq
      rw [Gunfold]
      intro _ L _ _
      exact hdesc L

  obtain ⟨T, hT⟩ := wcpa_lfg_gid_finite_stage R₀ R G H1 H2
  have hft : Algebra.FiniteType ℤ (Algebra.adjoin R₀ (T : Set R)) :=
    Algebra.FiniteType.trans (S := R₀) inferInstance
      ((Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset T))
  refine ⟨Algebra.adjoin R₀ (T : Set R), inferInstance, hft, inferInstance, inferInstance,
    inferInstance, ?_⟩

  intro P _ L _ _
  apply ascent R₀ (Algebra.adjoin R₀ (T : Set R)) S₀ P
  intro L _ _
  exact (Gunfold _).mp (hT P) L

theorem wcpa_lfg_pgi_fibre_base_change : ∀ (R R' S : Type u) [CommRing R] [CommRing R'] [CommRing S] [Algebra R R'] [Algebra R S], (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → ∀ (P : Ideal R') [P.IsPrime] (L : Type u) [Field L] [Algebra P.ResidueField L], IsDomain (TensorProduct P.ResidueField L (P.Fiber (TensorProduct R R' S))) :=
by
  intro R R' S _ _ _ _ _ hGI P _ L _ _
  letI φ : (P.comap (algebraMap R R')).ResidueField →+* P.ResidueField :=
    Ideal.ResidueField.map (P.comap (algebraMap R R')) P (algebraMap R R') rfl
  letI i1 : Algebra (P.comap (algebraMap R R')).ResidueField L :=
    ((algebraMap P.ResidueField L).comp φ).toAlgebra
  letI : Algebra R' L :=
    ((algebraMap P.ResidueField L).comp (algebraMap R' P.ResidueField)).toAlgebra
  letI : Algebra R L := ((algebraMap R' L).comp (algebraMap R R')).toAlgebra
  haveI : IsScalarTower R' P.ResidueField L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower R R' L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower R (P.comap (algebraMap R R')).ResidueField L :=
    IsScalarTower.of_algebraMap_eq (fun r =>
      (congrArg (algebraMap P.ResidueField L)
        (Ideal.ResidueField.map_algebraMap (P.comap (algebraMap R R')) P (algebraMap R R') rfl
          r)).symm)
  let e : TensorProduct P.ResidueField L (P.Fiber (TensorProduct R R' S)) ≃+*
      TensorProduct (P.comap (algebraMap R R')).ResidueField L
        ((P.comap (algebraMap R R')).Fiber S) :=
    (((Algebra.TensorProduct.cancelBaseChange R' P.ResidueField L L
        (TensorProduct R R' S)).toRingEquiv.trans
      (Algebra.TensorProduct.cancelBaseChange R R' L L S).toRingEquiv).trans
      (Algebra.TensorProduct.cancelBaseChange R (P.comap (algebraMap R R')).ResidueField L L
        S).toRingEquiv.symm)
  haveI : IsDomain (TensorProduct (P.comap (algebraMap R R')).ResidueField L
      ((P.comap (algebraMap R R')).Fiber S)) := @hGI (P.comap (algebraMap R R')) _ L _ i1
  exact MulEquiv.isDomain _ e.toMulEquiv

theorem wcpa_lfg_pgi_nilpotent_lift : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] (I : Ideal R), IsNilpotent I → Module.Flat R M → Module.Projective (R ⧸ I) (TensorProduct R (R ⧸ I) M) → Module.Projective R M :=
by
  intro R M _ _ _ I hI hfl hproj
  classical

  have s1 : ∀ (F : Type u) [AddCommGroup F] [Module R F] (π : F →ₗ[R] M), Function.Surjective π →
      ∀ w ∈ LinearMap.ker π, w ∈ I • (⊤ : Submodule R F) → w ∈ I • LinearMap.ker π := by
    intro F _ _ π hπ w hwK hwI
    rw [← Submodule.span_univ, ← Set.range_id, Submodule.mem_ideal_smul_span_iff_exists_sum] at hwI
    obtain ⟨a, ha, rfl⟩ := hwI
    have hw : (a.sum fun i c => c • id i) = ∑ i : a.support, a (i : F) • (i : F) := by
      rw [Finsupp.sum, ← Finset.sum_coe_sort]
      rfl
    rw [hw] at hwK ⊢
    have h0 : ∑ i : a.support, a (i : F) • π (i : F) = 0 := by
      rw [LinearMap.mem_ker, map_sum] at hwK
      simpa only [map_smul] using hwK
    obtain ⟨k, b, y, hxy, hab⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero h0
    choose y' hy' using fun l => hπ (y l)
    have hsplit : ∑ i : a.support, a (i : F) • (i : F) =
        ∑ i : a.support, a (i : F) • ((i : F) - ∑ l, b i l • y' l) := by
      have : ∑ i : a.support, a (i : F) • ∑ l, b i l • y' l = 0 := by
        simp_rw [Finset.smul_sum, smul_smul]
        rw [Finset.sum_comm]
        simp_rw [← Finset.sum_smul, hab, zero_smul, Finset.sum_const_zero]
      simp_rw [smul_sub, Finset.sum_sub_distrib, this, sub_zero]
    rw [hsplit]
    refine Submodule.sum_mem _ (fun i _ => Submodule.smul_mem_smul (ha i) ?_)
    rw [LinearMap.mem_ker, map_sub, map_sum]
    simp_rw [map_smul, hy']
    rw [← hxy i, sub_self]

  have s3 : ∀ (K : Type u) [AddCommGroup K] [Module R K] (g : K →ₗ[R] K),
      (∀ x : K, g x - x ∈ I • (⊤ : Submodule R K)) → ∃ h : K →ₗ[R] K, h ∘ₗ g = LinearMap.id := by
    intro K _ _ g hg
    set n : Module.End R K := g - 1 with hn
    have hn1 : ∀ x, n x ∈ I • (⊤ : Submodule R K) := fun x => by
      simpa [hn] using hg x
    have key : ∀ j : ℕ, ∀ x, (n ^ j) x ∈ (I ^ j) • (⊤ : Submodule R K) := by
      intro j
      induction j with
      | zero => intro x; simp
      | succ j ih =>
        intro x
        rw [show n ^ (j + 1) = n * n ^ j from pow_succ' n j, Module.End.mul_apply]
        have hz := ih x
        generalize (n ^ j) x = z at hz
        refine Submodule.smul_induction_on hz ?_ ?_
        · intro a ha y _
          rw [map_smul, pow_succ, ← Ideal.smul_eq_mul, Submodule.smul_assoc]
          exact Submodule.smul_mem_smul ha (hn1 y)
        · intro y z hy hz
          rw [map_add]
          exact add_mem hy hz
    obtain ⟨N, hN⟩ := hI
    have hnil : IsNilpotent n := ⟨N, by
      ext x
      have := key N x
      rw [hN, Submodule.zero_eq_bot, Submodule.bot_smul] at this
      simpa using this⟩
    have hu : IsUnit (1 + n) := hnil.isUnit_one_add
    have h1n : 1 + n = g := by simp [hn]
    rw [h1n] at hu
    obtain ⟨u, hu⟩ := hu
    refine ⟨↑u⁻¹, ?_⟩
    rw [← Module.End.mul_eq_comp, ← hu, Units.inv_mul]
    rfl

  have s4 : ∀ (F : Type u) [AddCommGroup F] [Module R F], Module.Projective R F →
      ∀ (π : F →ₗ[R] M), Function.Surjective π → ∀ (ρ : F →ₗ[R] LinearMap.ker π),
      ρ ∘ₗ (LinearMap.ker π).subtype = LinearMap.id → Module.Projective R M := by
    intro F _ _ hF π hπ ρ hρ
    have hex := LinearMap.exact_subtype_ker_map π
    have := (Function.Exact.split_tfae hex Subtype.val_injective hπ).out 1 2
    obtain ⟨l, hl⟩ := this.mpr ⟨ρ, hρ⟩
    exact Module.Projective.of_split l π hl

  have key : ∀ (N P : Type u) [AddCommGroup N] [Module R N] [AddCommGroup P] [Module R P]
      (g : N →ₗ[R] P), Function.Surjective g →
      Function.Exact ((LinearMap.ker g).subtype.lTensor (R ⧸ I)) (g.lTensor (R ⧸ I)) :=
    fun N P _ _ _ _ g hg => lTensor_exact (R ⧸ I) (LinearMap.exact_subtype_ker_map g) hg
  have s2a : ∃ s : TensorProduct R (R ⧸ I) M →ₗ[R ⧸ I] TensorProduct R (R ⧸ I) (M →₀ R),
      ∀ x : TensorProduct R (R ⧸ I) (M →₀ R),
        ∃ k : LinearMap.ker (Finsupp.linearCombination R (id : M → M)),
        (1 : R ⧸ I) ⊗ₜ[R] (k : M →₀ R) =
          x - s ((Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I) x) := by
    have hπ : Function.Surjective (Finsupp.linearCombination R (id : M → M)) :=
      Finsupp.linearCombination_id_surjective R M
    have hQsurj : Function.Surjective (algebraMap R (R ⧸ I)) := Ideal.Quotient.mk_surjective
    have hπb : Function.Surjective
        ((Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I)) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective (R ⧸ I) hπ
    obtain ⟨s, hs⟩ := Module.projective_lifting_property
      ((Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I)) LinearMap.id hπb
    refine ⟨s, fun x => ?_⟩
    have hex := key _ _ _ hπ
    have h0 : (Finsupp.linearCombination R (id : M → M)).lTensor (R ⧸ I)
        (x - s ((Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I) x)) = 0 := by
      rw [← LinearMap.baseChange_eq_ltensor, map_sub]
      rw [show (Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I)
        (s ((Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I) x)) =
        (Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I) x from
          LinearMap.congr_fun hs _]
      rw [sub_self]
    obtain ⟨z, hz⟩ := (hex _).mp h0
    obtain ⟨k, rfl⟩ := TensorProduct.mk_surjective R _ (R ⧸ I) hQsurj z
    refine ⟨k, ?_⟩
    rw [← hz, TensorProduct.mk_apply, LinearMap.lTensor_tmul, Submodule.subtype_apply]
  have s2b : ∀ x : M →₀ R, (1 : R ⧸ I) ⊗ₜ[R] x = 0 → x ∈ I • (⊤ : Submodule R (M →₀ R)) := by
    intro x h4
    have h5 := congrArg (TensorProduct.quotTensorEquivQuotSMul (M →₀ R) I) h4
    rw [← map_one (Ideal.Quotient.mk I), TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul,
      map_zero] at h5
    exact (Submodule.Quotient.mk_eq_zero _).mp h5
  have s2c : ∀ (s : TensorProduct R (R ⧸ I) M →ₗ[R ⧸ I] TensorProduct R (R ⧸ I) (M →₀ R))
      (kf : M → LinearMap.ker (Finsupp.linearCombination R (id : M → M))),
      (∀ m, (1 : R ⧸ I) ⊗ₜ[R] (kf m : M →₀ R) = (1 : R ⧸ I) ⊗ₜ[R] Finsupp.single m (1 : R) -
        s ((Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I)
          ((1 : R ⧸ I) ⊗ₜ[R] Finsupp.single m (1 : R)))) → ∀ (f : M →₀ R),
      (1 : R ⧸ I) ⊗ₜ[R] ((Finsupp.linearCombination R kf f :
          LinearMap.ker (Finsupp.linearCombination R (id : M → M))) : M →₀ R) =
        (1 : R ⧸ I) ⊗ₜ[R] f - s ((Finsupp.linearCombination R (id : M → M)).baseChange (R ⧸ I)
          ((1 : R ⧸ I) ⊗ₜ[R] f)) := by
    intro s kf hkf f
    induction f using Finsupp.induction_linear with
    | zero => simp
    | add f g hf hg =>
      rw [map_add, Submodule.coe_add, TensorProduct.tmul_add, hf, hg, TensorProduct.tmul_add,
        map_add, map_add]
      abel
    | single m c =>
      have hc : Finsupp.single m c = c • Finsupp.single m (1 : R) := by
        rw [Finsupp.smul_single, smul_eq_mul, mul_one]
      rw [Finsupp.linearCombination_single, Submodule.coe_smul, TensorProduct.tmul_smul, hkf m, hc,
        TensorProduct.tmul_smul, LinearMap.map_smul_of_tower,
        LinearMap.map_smul_of_tower, smul_sub]

  have hπ : Function.Surjective (Finsupp.linearCombination R (id : M → M)) :=
    Finsupp.linearCombination_id_surjective R M
  have hA := s1 (M →₀ R) (Finsupp.linearCombination R (id : M → M)) hπ
  obtain ⟨s, hs⟩ := s2a
  choose kf hkf using fun m : M => hs ((1 : R ⧸ I) ⊗ₜ[R] Finsupp.single m (1 : R))
  have hr : ∀ k : LinearMap.ker (Finsupp.linearCombination R (id : M → M)),
      (Finsupp.linearCombination R kf (k : M →₀ R)) - k ∈
        I • (⊤ : Submodule R (LinearMap.ker (Finsupp.linearCombination R (id : M → M)))) := by
    intro k
    have h1 := s2c s kf hkf (k : M →₀ R)
    rw [LinearMap.baseChange_tmul,
      show Finsupp.linearCombination R (id : M → M) (k : M →₀ R) = 0 from k.2,
      TensorProduct.tmul_zero, map_zero, sub_zero] at h1
    have h3 : ((Finsupp.linearCombination R kf (k : M →₀ R) : M →₀ R) - (k : M →₀ R)) ∈
        I • (⊤ : Submodule R (M →₀ R)) := by
      apply s2b
      rw [TensorProduct.tmul_sub, h1, sub_self]
    have h6 := hA _ (sub_mem (Finsupp.linearCombination R kf (k : M →₀ R)).2 k.2) h3
    rw [Submodule.mem_smul_top_iff]
    simpa using h6
  obtain ⟨h, hh⟩ := s3 _ ((Finsupp.linearCombination R kf) ∘ₗ
    (LinearMap.ker (Finsupp.linearCombination R (id : M → M))).subtype) (fun x => hr x)
  refine s4 (M →₀ R) inferInstance (Finsupp.linearCombination R (id : M → M)) hπ
    (h ∘ₗ Finsupp.linearCombination R kf) ?_
  rw [LinearMap.comp_assoc, hh]

theorem wcpa_lfg_pgi_split_ideals : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] (I J : Ideal R), I ⊓ J = ⊥ → Module.Projective (R ⧸ I) (TensorProduct R (R ⧸ I) M) → Module.Projective (R ⧸ J) (TensorProduct R (R ⧸ J) M) → Module.Projective R M :=
by
  intro R M _ _ _ I J hIJ hI hJ

  have s1 : ∀ (K : Ideal R), Module.Projective (R ⧸ K) (TensorProduct R (R ⧸ K) M) →
      ∀ (N N' : Type u) [AddCommGroup N] [Module R N] [AddCommGroup N'] [Module R N'],
      (∀ k ∈ K, ∀ n : N, k • n = 0) → ∀ (f : N →ₗ[R] N') (g : M →ₗ[R] N'),
      Function.Surjective f → ∃ h : M →ₗ[R] N, f ∘ₗ h = g := by
    intro K hK N N' _ _ _ _ hN f g hf
    have hN' : ∀ k ∈ K, ∀ n : N', k • n = 0 := by
      intro k hk y
      obtain ⟨x, rfl⟩ := hf y
      rw [← map_smul, hN k hk x, map_zero]
    have tN : Module.IsTorsionBySet R N (K : Set R) := by
      intro x k; exact hN k.1 k.2 x
    have tN' : Module.IsTorsionBySet R N' (K : Set R) := by
      intro x k; exact hN' k.1 k.2 x
    letI : Module (R ⧸ K) N := tN.module
    letI : Module (R ⧸ K) N' := tN'.module
    haveI : IsScalarTower R (R ⧸ K) N := tN.isScalarTower
    haveI : IsScalarTower R (R ⧸ K) N' := tN'.isScalarTower
    haveI := hK
    let f' : N →ₗ[R ⧸ K] N' := f.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
    let g' : TensorProduct R (R ⧸ K) M →ₗ[R ⧸ K] N' := g.liftBaseChange (R ⧸ K)
    obtain ⟨h', hh'⟩ := Module.projective_lifting_property f' g' hf
    refine ⟨(h'.restrictScalars R) ∘ₗ (TensorProduct.mk R (R ⧸ K) M 1), ?_⟩
    apply LinearMap.ext
    intro m
    have := LinearMap.congr_fun hh' ((1 : R ⧸ K) ⊗ₜ m)
    simp only [f', g', LinearMap.comp_apply, LinearMap.liftBaseChange_tmul, one_smul] at this
    exact this

  have coef : ∀ (K : Ideal R) (x : M →₀ R), x ∈ K • (⊤ : Submodule R (M →₀ R)) → ∀ a, x a ∈ K := by
    intro K x hx
    refine Submodule.smul_induction_on (p := fun x => ∀ a, x a ∈ K) hx ?_ ?_
    · intro r hr n _ a
      rw [Finsupp.smul_apply, smul_eq_mul]
      exact K.mul_mem_right _ hr
    · intro x y hx hy a
      rw [Finsupp.add_apply]
      exact K.add_mem (hx a) (hy a)
  let p : (M →₀ R) →ₗ[R] M := Finsupp.linearCombination R id
  have hp : Function.Surjective p := Finsupp.linearCombination_id_surjective R M
  have map_surj : ∀ (K : Ideal R) (y : M), y ∈ K • (⊤ : Submodule R M) →
      ∃ z ∈ K • (⊤ : Submodule R (M →₀ R)), p z = y := by
    intro K y hy
    have e : Submodule.map p (K • ⊤) = K • (⊤ : Submodule R M) := by
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr hp]
    rw [← e] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    exact ⟨z, hz, rfl⟩
  have map_le : ∀ (K : Ideal R), K • (⊤ : Submodule R (M →₀ R)) ≤
      (K • (⊤ : Submodule R M)).comap p := by
    intro K
    rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
    exact Submodule.smul_mono le_rfl le_top
  have tors : ∀ (K : Ideal R), ∀ k ∈ K, ∀ n : (M →₀ R) ⧸ K • (⊤ : Submodule R (M →₀ R)),
      k • n = 0 := by
    intro K k hk n
    induction n using Submodule.Quotient.induction_on with
    | H x =>
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      exact Submodule.smul_mem_smul hk trivial
  set IF : Submodule R (M →₀ R) := I • ⊤ with hIF
  set JF : Submodule R (M →₀ R) := J • ⊤ with hJF

  obtain ⟨u, hu⟩ := s1 I hI ((M →₀ R) ⧸ IF) (M ⧸ I • (⊤ : Submodule R M))
    (tors I) (IF.mapQ (I • ⊤) p (map_le I)) (I • (⊤ : Submodule R M)).mkQ
    (by
      intro y
      obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective _ y
      obtain ⟨x, rfl⟩ := hp m
      exact ⟨Submodule.Quotient.mk x, rfl⟩)
  have hi : ∀ (m : M) (x : M →₀ R), IF.mkQ x = u m → p x - m ∈ I • (⊤ : Submodule R M) := by
    intro m x hx
    have h1 := LinearMap.congr_fun hu m
    rw [LinearMap.comp_apply, ← hx] at h1
    rw [← Submodule.Quotient.eq]
    exact h1

  obtain ⟨πI, hπI⟩ : ∃ πI : ((M →₀ R) ⧸ IF) →ₗ[R] ((M →₀ R) ⧸ (IF ⊔ JF)),
      ∀ x, πI (Submodule.Quotient.mk x) = Submodule.Quotient.mk x :=
    ⟨Submodule.factor le_sup_left, fun x => Submodule.factor_mk _ x⟩
  obtain ⟨φ, hφ⟩ : ∃ φ : ((M →₀ R) ⧸ JF) →ₗ[R] ((M →₀ R) ⧸ (IF ⊔ JF)) × (M ⧸ J • (⊤ : Submodule R M)),
      ∀ x, φ (Submodule.Quotient.mk x) = (Submodule.Quotient.mk x, Submodule.Quotient.mk (p x)) :=
    ⟨(Submodule.factor le_sup_right).prod (JF.mapQ (J • ⊤) p (map_le J)), fun x => rfl⟩
  obtain ⟨w, hw_def⟩ : ∃ w : M →ₗ[R] ((M →₀ R) ⧸ (IF ⊔ JF)) × (M ⧸ J • (⊤ : Submodule R M)),
      ∀ m, w m = (πI (u m), Submodule.Quotient.mk m) :=
    ⟨(πI ∘ₗ u).prod (J • (⊤ : Submodule R M)).mkQ, fun m => rfl⟩
  have hw : ∀ m, w m ∈ LinearMap.range φ := by
    intro m
    obtain ⟨x, hx⟩ := Submodule.mkQ_surjective IF (u m)
    obtain ⟨z, hz, hpz⟩ := map_surj I _ (hi m x hx)
    refine ⟨Submodule.Quotient.mk (x - z), ?_⟩
    rw [hφ, hw_def, ← hx, Submodule.mkQ_apply, hπI, map_sub, hpz, sub_sub_cancel]
    congr 1
    rw [Submodule.Quotient.eq]
    rw [show x - z - x = -z by abel]
    exact Submodule.neg_mem _ (Submodule.mem_sup_left hz)
  obtain ⟨v, hv⟩ := s1 J hJ ((M →₀ R) ⧸ JF) (LinearMap.range φ) (tors J) φ.rangeRestrict
    (LinearMap.codRestrict (LinearMap.range φ) w hw) φ.surjective_rangeRestrict
  have hv' : ∀ m, φ (v m) = w m := by
    intro m
    have h1 := congrArg Subtype.val (LinearMap.congr_fun hv m)
    simpa using h1
  have hii : ∀ (m : M) (x : M →₀ R), JF.mkQ x = v m → p x - m ∈ J • (⊤ : Submodule R M) := by
    intro m x hx
    have h1 := hv' m
    rw [← hx, Submodule.mkQ_apply, hφ, hw_def] at h1
    rw [← Submodule.Quotient.eq]
    exact (Prod.ext_iff.mp h1).2
  have hiii : ∀ m, ∃ x, IF.mkQ x = u m ∧ JF.mkQ x = v m := by
    intro m
    obtain ⟨xI, hxI⟩ := Submodule.mkQ_surjective IF (u m)
    obtain ⟨xJ, hxJ⟩ := Submodule.mkQ_surjective JF (v m)
    have h1 := hv' m
    rw [← hxJ, Submodule.mkQ_apply, hφ, hw_def, ← hxI, Submodule.mkQ_apply, hπI] at h1
    have h2 : xJ - xI ∈ IF ⊔ JF := (Submodule.Quotient.eq _).mp (Prod.ext_iff.mp h1).1
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h2
    refine ⟨xI + a, ?_, ?_⟩
    · rw [← hxI, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
      rw [show xI + a - xI = a by abel]
      exact ha
    · rw [← hxJ, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
      have e : xI + a - xJ = -b := by
        rw [eq_neg_iff_add_eq_zero,
          show xI + a - xJ + b = (a + b) - (xJ - xI) by abel, hab, sub_self]
      rw [e]
      exact Submodule.neg_mem _ hb

  have hFinf : IF ⊓ JF = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_bot]
    obtain ⟨h1, h2⟩ := Submodule.mem_inf.mp hx
    ext a
    have h3 : x a ∈ I ⊓ J := ⟨coef I x h1 a, coef J x h2 a⟩
    rw [hIJ] at h3
    simpa using h3
  have hψ : Function.Injective (IF.mkQ.prod JF.mkQ) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_prod, Submodule.ker_mkQ, Submodule.ker_mkQ, hFinf]
  have hrange : ∀ m, (u.prod v) m ∈ LinearMap.range (IF.mkQ.prod JF.mkQ) := by
    intro m
    obtain ⟨x, h1, h2⟩ := hiii m
    exact ⟨x, Prod.ext h1 h2⟩
  obtain ⟨h, hh⟩ : ∃ h : M →ₗ[R] (M →₀ R), ∀ m, IF.mkQ (h m) = u m ∧ JF.mkQ (h m) = v m := by
    refine ⟨(LinearEquiv.ofInjective _ hψ).symm.toLinearMap ∘ₗ
      LinearMap.codRestrict _ (u.prod v) hrange, fun m => ?_⟩
    have e1 := congrArg Subtype.val
      ((LinearEquiv.ofInjective _ hψ).apply_symm_apply ⟨(u.prod v) m, hrange m⟩)
    rw [LinearEquiv.ofInjective_apply] at e1
    exact Prod.ext_iff.mp e1

  obtain ⟨δ, hδ⟩ : ∃ δ : M →ₗ[R] M, ∀ m, δ m = p (h m) - m :=
    ⟨p ∘ₗ h - LinearMap.id, fun m => rfl⟩
  have hδI : ∀ m, δ m ∈ I • (⊤ : Submodule R M) := by
    intro m; rw [hδ]; exact hi m (h m) (hh m).1
  have hδJ : ∀ m, δ m ∈ J • (⊤ : Submodule R M) := by
    intro m; rw [hδ]; exact hii m (h m) (hh m).2
  have hkill : ∀ i ∈ I, ∀ y ∈ J • (⊤ : Submodule R M), i • y = 0 := by
    intro i hi' y hy
    refine Submodule.smul_induction_on (p := fun y => i • y = 0) hy ?_ ?_
    · intro j hj n _
      rw [smul_smul]
      have h3 : i * j ∈ I ⊓ J := ⟨I.mul_mem_right j hi', J.mul_mem_left i hj⟩
      rw [hIJ, Ideal.mem_bot] at h3
      rw [h3, zero_smul]
    · intro a b ha hb
      rw [smul_add, ha, hb, add_zero]
  have hsq : ∀ m, δ (δ m) = 0 := by
    intro m
    refine Submodule.smul_induction_on (p := fun y => δ y = 0) (hδI m) ?_ ?_
    · intro i hi' n _
      rw [map_smul]
      exact hkill i hi' _ (hδJ n)
    · intro a b ha hb
      rw [map_add, ha, hb, add_zero]

  have e : ∀ y, p (h y) = y + δ y := fun y => by rw [hδ]; abel
  refine Module.Projective.of_split (h ∘ₗ (LinearMap.id - δ)) p ?_
  apply LinearMap.ext
  intro x
  simp only [LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.id_apply]
  rw [e, map_sub, hsq]
  abel

theorem wcpa_lfg_pgi_projective_of_ml : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M], Module.Flat R M → (∃ s : Set M, s.Countable ∧ Submodule.span R s = ⊤) → (∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)], Function.Injective (TensorProduct.piRightHom R R M Q)) → Module.Projective R M :=
by
  intro R M _ _ _ hF hCtbl hPI
  haveI := hF
  classical

  have s1 : ∀ (r : ℕ) (y : (Fin r → R) →ₗ[R] M) (W : Submodule R (Fin r → R)), LinearMap.lTensor M W.mkQ (∑ k : Fin r, TensorProduct.tmul R (y (Pi.single k 1)) (Pi.single k 1 : Fin r → R)) = 0 → ∃ (t : ℕ) (a : (Fin r → R) →ₗ[R] (Fin t → R)) (z : (Fin t → R) →ₗ[R] M), z ∘ₗ a = y ∧ ∀ l : Fin t, (fun k : Fin r => a (Pi.single k 1) l) ∈ W := by
    intro r y W h
    have hex : Function.Exact (LinearMap.lTensor M W.subtype) (LinearMap.lTensor M W.mkQ) :=
      lTensor_exact M (LinearMap.exact_subtype_mkQ W) (Submodule.mkQ_surjective W)
    obtain ⟨η, hη⟩ := (hex _).mp h
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset η
    set t := S.card
    let m : Fin t → M := fun i => (S.equivFin.symm i).1.1
    let w : Fin t → W := fun i => (S.equivFin.symm i).1.2
    have hη' : η = ∑ i, m i ⊗ₜ w i := by
      rw [hS, ← Finset.sum_coe_sort S]
      exact (Equiv.sum_comp S.equivFin.symm (fun x : S => x.1.1 ⊗ₜ[R] x.1.2)).symm
    have hstar : ∑ k : Fin r, y (Pi.single k 1) ⊗ₜ[R] (Pi.single k 1 : Fin r → R)
        = ∑ i, m i ⊗ₜ[R] ((w i : W) : Fin r → R) := by
      rw [← hη, hη', map_sum]
      simp
    let A : Matrix (Fin t) (Fin r) R := Matrix.of fun l k => (w l : Fin r → R) k
    refine ⟨t, Matrix.mulVecLin A, Fintype.linearCombination R m, ?_, ?_⟩
    · apply (Pi.basisFun R (Fin r)).ext
      intro j
      have := congrFun (congrArg (TensorProduct.piScalarRight R R M (Fin r)) hstar) j
      simp only [map_sum, TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul,
        Finset.sum_apply] at this
      simp only [Pi.basisFun_apply, LinearMap.comp_apply, Matrix.mulVecLin_apply,
        Fintype.linearCombination_apply]
      rw [Matrix.mulVec_single_one]
      simp [Pi.single_apply] at this
      rw [this]
      simp [A]
    · intro l
      have : (fun k : Fin r => (Matrix.mulVecLin A) (Pi.single k 1) l) = (w l : Fin r → R) := by
        funext k
        simp [A]
      rw [this]
      exact (w l).2

  have s2 : ∀ (r t : ℕ) (y : (Fin r → R) →ₗ[R] M) (a : (Fin r → R) →ₗ[R] (Fin t → R)) (z : (Fin t → R) →ₗ[R] M) (W : Submodule R (Fin r → R)), z ∘ₗ a = y → (∀ l : Fin t, (fun k : Fin r => a (Pi.single k 1) l) ∈ W) → LinearMap.lTensor M W.mkQ (∑ k : Fin r, TensorProduct.tmul R (y (Pi.single k 1)) (Pi.single k 1 : Fin r → R)) = 0 := by
    intro r t y a z W hza hrow
    have hy : ∀ k, y (Pi.single k 1) = ∑ l, a (Pi.single k 1) l • z (Pi.single l 1) := by
      intro k
      rw [← hza, LinearMap.comp_apply]
      conv_lhs => rw [← (Pi.basisFun R (Fin t)).sum_repr (a (Pi.single k 1))]
      simp [map_sum, map_smul]
    have hrowsum : ∀ l, (∑ k : Fin r, a (Pi.single k 1) l • (Pi.single k 1 : Fin r → R))
        = (fun k : Fin r => a (Pi.single k 1) l) := by
      intro l
      funext j
      simp [Finset.sum_apply, Pi.single_apply]
    calc LinearMap.lTensor M W.mkQ (∑ k : Fin r, y (Pi.single k 1) ⊗ₜ[R] (Pi.single k 1 : Fin r → R))
        = ∑ k : Fin r, ∑ l : Fin t, z (Pi.single l 1) ⊗ₜ[R] W.mkQ (a (Pi.single k 1) l • (Pi.single k 1 : Fin r → R)) := by
          rw [map_sum]
          refine Finset.sum_congr rfl (fun k _ => ?_)
          rw [LinearMap.lTensor_tmul, hy k, TensorProduct.sum_tmul]
          refine Finset.sum_congr rfl (fun l _ => ?_)
          rw [map_smul, TensorProduct.smul_tmul]
      _ = ∑ l : Fin t, z (Pi.single l 1) ⊗ₜ[R] W.mkQ (∑ k : Fin r, a (Pi.single k 1) l • (Pi.single k 1 : Fin r → R)) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun l _ => ?_)
          rw [map_sum, TensorProduct.tmul_sum]
      _ = 0 := by
          refine Finset.sum_eq_zero (fun l _ => ?_)
          rw [hrowsum l, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero W).mpr (hrow l),
            TensorProduct.tmul_zero]

  have s3 : ∀ (F : Type u) [AddCommGroup F] [Module R F] (ι : Type u) (W : ι → Submodule R F) (ξ : TensorProduct R M F), (∀ i, LinearMap.lTensor M (W i).mkQ ξ = 0) → LinearMap.lTensor M (⨅ i, W i).mkQ ξ = 0 := by
    intro F _ _ ι W ξ h
    set π : F →ₗ[R] ((i : ι) → F ⧸ W i) := LinearMap.pi (fun i => (W i).mkQ) with hπ
    have hker : LinearMap.ker π = ⨅ i, W i := by
      simp [π, LinearMap.ker_pi, Submodule.ker_mkQ]
    set φ := (⨅ i, W i).liftQ π hker.ge with hφdef
    have hφ : Function.Injective φ := by
      rw [← LinearMap.ker_eq_bot]; exact Submodule.ker_liftQ_eq_bot _ _ _ hker.le
    have h1 : Function.Injective (LinearMap.lTensor M φ) :=
      Module.Flat.lTensor_preserves_injective_linearMap φ hφ
    have h2 := hPI ι (fun i => F ⧸ W i)
    have hcomp : (TensorProduct.piRightHom R R M (fun i => F ⧸ W i)) ∘ₗ (LinearMap.lTensor M φ) ∘ₗ
        (LinearMap.lTensor M (⨅ i, W i).mkQ) = LinearMap.pi (fun i => LinearMap.lTensor M (W i).mkQ) := by
      apply TensorProduct.ext'
      intro m f
      ext i
      simp [φ, π]
    apply h1
    apply h2
    have := LinearMap.congr_fun hcomp ξ
    simp only [LinearMap.comp_apply] at this
    rw [this, map_zero, map_zero]
    ext i
    simp [h i]

  have Dom : ∀ (r : ℕ) (y : (Fin r → R) →ₗ[R] M), ∃ (s : ℕ) (a : (Fin r → R) →ₗ[R] (Fin s → R)) (z : (Fin s → R) →ₗ[R] M), z ∘ₗ a = y ∧ (∀ v, y v = 0 → a v = 0) ∧ ∀ (t : ℕ) (a' : (Fin r → R) →ₗ[R] (Fin t → R)) (z' : (Fin t → R) →ₗ[R] M), z' ∘ₗ a' = y → ∃ c : (Fin t → R) →ₗ[R] (Fin s → R), c ∘ₗ a' = a := by
    intro r y
    set ξ := ∑ k : Fin r, TensorProduct.tmul R (y (Pi.single k 1)) (Pi.single k 1 : Fin r → R) with hξ
    let ι := {W : Submodule R (Fin r → R) // LinearMap.lTensor M W.mkQ ξ = 0}
    have h0 := s3 (Fin r → R) ι (fun i => i.1) ξ (fun i => i.2)
    obtain ⟨s, a, z, hza, hrow⟩ := s1 r y _ h0
    have dom : ∀ (t : ℕ) (a' : (Fin r → R) →ₗ[R] (Fin t → R)) (z' : (Fin t → R) →ₗ[R] M), z' ∘ₗ a' = y → ∃ c : (Fin t → R) →ₗ[R] (Fin s → R), c ∘ₗ a' = a := by
      intro t a' z' hza'
      have hW'adm : LinearMap.lTensor M (Submodule.span R (Set.range (fun m : Fin t => (fun k : Fin r => a' (Pi.single k 1) m)))).mkQ ξ = 0 :=
        s2 r t y a' z' _ hza' (fun m => Submodule.subset_span ⟨m, rfl⟩)
      have hle : (⨅ i : ι, i.1) ≤ Submodule.span R (Set.range (fun m : Fin t => (fun k : Fin r => a' (Pi.single k 1) m))) :=
        iInf_le (fun i : ι => i.1) ⟨_, hW'adm⟩
      have hcoef : ∀ l : Fin s, ∃ c : Fin t → R, ∑ m, c m • (fun k : Fin r => a' (Pi.single k 1) m) = (fun k : Fin r => a (Pi.single k 1) l) := fun l =>
        (Submodule.mem_span_range_iff_exists_fun R).mp (hle (hrow l))
      choose c hc using hcoef
      refine ⟨Matrix.mulVecLin (Matrix.of c), ?_⟩
      apply (Pi.basisFun R (Fin r)).ext
      intro k
      funext l
      have := congrFun (hc l) k
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at this
      simp only [LinearMap.comp_apply, Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct,
        Matrix.of_apply, Pi.basisFun_apply]
      exact this
    refine ⟨s, a, z, hza, ?_, dom⟩
    intro v hv
    obtain ⟨k, a'', z'', hy, ha''⟩ := Module.Flat.exists_factorization_of_apply_eq_zero_of_free hv
    obtain ⟨c, hc⟩ := dom k ((Finsupp.linearEquivFunOnFinite R R (Fin k)).toLinearMap ∘ₗ a'')
      (z'' ∘ₗ (Finsupp.linearEquivFunOnFinite R R (Fin k)).symm.toLinearMap) (by
        rw [hy]; ext w; simp)
    rw [← hc]
    simp [ha'']

  have s5 : ∀ (x : ℕ → M), ∃ (r : ℕ → ℕ) (y : ∀ j, (Fin (r j) → R) →ₗ[R] M) (T : ∀ j, (Fin (r j) → R) →ₗ[R] (Fin (r (j + 1)) → R)) (C : ∀ j, (Fin (r (j + 2)) → R) →ₗ[R] (Fin (r (j + 1)) → R)), (∀ j, y (j + 1) ∘ₗ T j = y j) ∧ (∀ j (v : Fin (r j) → R), y j v = 0 → T j v = 0) ∧ (∀ j, C j ∘ₗ (T (j + 1) ∘ₗ T j) = T j) ∧ ∀ n, ∃ v : Fin (r (n + 1)) → R, y (n + 1) v = x n := by
    intro x
    choose S A Z hZA hK hD using Dom
    let snoc0 : (n : ℕ) → (Fin n → R) →ₗ[R] (Fin (n+1) → R) := fun n =>
      { toFun := fun u => Fin.snoc u 0
        map_add' := by
          intro u w; funext i
          refine Fin.lastCases ?_ (fun i => ?_) i <;> simp
        map_smul' := by
          intro c u; funext i
          refine Fin.lastCases ?_ (fun i => ?_) i <;> simp }
    have snoc0_init : ∀ n (u : Fin n → R), LinearMap.funLeft R R Fin.castSucc (snoc0 n u) = u := by
      intro n u; funext i; simp [snoc0, LinearMap.funLeft_apply]
    have snoc0_last : ∀ n (u : Fin n → R), snoc0 n u (Fin.last n) = 0 := by
      intro n u; simp [snoc0]
    let next : (Σ r : ℕ, (Fin r → R) →ₗ[R] M) → ℕ → (Σ r : ℕ, (Fin r → R) →ₗ[R] M) := fun p j =>
      ⟨S p.1 p.2 + 1, Z p.1 p.2 ∘ₗ LinearMap.funLeft R R Fin.castSucc +
        (LinearMap.proj (R := R) (φ := fun _ : Fin (S p.1 p.2 + 1) => R) (Fin.last _)).smulRight (x j)⟩
    let σ : ℕ → (Σ r : ℕ, (Fin r → R) →ₗ[R] M) := fun j =>
      Nat.rec (motive := fun _ => Σ r : ℕ, (Fin r → R) →ₗ[R] M) ⟨0, 0⟩ (fun j p => next p j) j
    let r : ℕ → ℕ := fun j => (σ j).1
    let y : ∀ j, (Fin (r j) → R) →ₗ[R] M := fun j => (σ j).2
    have hy_next : ∀ j (u : Fin (r (j+1)) → R), y (j+1) u =
        Z (r j) (y j) (LinearMap.funLeft R R Fin.castSucc u) + u (Fin.last _) • x j := fun j u => rfl
    let T : ∀ j, (Fin (r j) → R) →ₗ[R] (Fin (r (j + 1)) → R) := fun j =>
      snoc0 (S (r j) (y j)) ∘ₗ A (r j) (y j)
    have hT : ∀ j, y (j + 1) ∘ₗ T j = y j := by
      intro j; refine LinearMap.ext fun v => ?_
      rw [LinearMap.comp_apply, hy_next]
      show Z (r j) (y j) (LinearMap.funLeft R R Fin.castSucc (snoc0 _ (A (r j) (y j) v))) +
        snoc0 _ (A (r j) (y j) v) (Fin.last _) • x j = y j v
      rw [snoc0_init, snoc0_last, zero_smul, add_zero, ← LinearMap.comp_apply, hZA]
    have hTk : ∀ j (v : Fin (r j) → R), y j v = 0 → T j v = 0 := by
      intro j v hv
      show snoc0 _ (A (r j) (y j) v) = 0
      rw [hK _ _ v hv, map_zero]
    have hCex : ∀ j, ∃ C : (Fin (r (j + 2)) → R) →ₗ[R] (Fin (r (j + 1)) → R), C ∘ₗ (T (j + 1) ∘ₗ T j) = T j := by
      intro j
      obtain ⟨c, hc⟩ := hD (r j) (y j) (r (j+2)) (T (j + 1) ∘ₗ T j) (y (j+2)) (LinearMap.ext fun v =>
        (LinearMap.congr_fun (hT (j+1)) (T j v)).trans (LinearMap.congr_fun (hT j) v))
      refine ⟨snoc0 _ ∘ₗ c, ?_⟩
      rw [LinearMap.comp_assoc, hc]
    choose C hC using hCex
    refine ⟨r, y, T, C, hT, hTk, hC, ?_⟩
    intro n
    refine ⟨Pi.single (Fin.last _) 1, ?_⟩
    rw [hy_next]
    have h1 : LinearMap.funLeft R R Fin.castSucc (Pi.single (Fin.last (S (r n) (y n))) (1 : R) : Fin (S (r n) (y n) + 1) → R) = 0 := by
      funext i
      simp [LinearMap.funLeft_apply, Fin.castSucc_ne_last]
    rw [h1, map_zero, zero_add, Pi.single_eq_same, one_smul]

  have s6 : ∀ (N N' : Type u) [AddCommGroup N] [Module R N] [AddCommGroup N'] [Module R N'] (p : N →ₗ[R] N') (φ : M →ₗ[R] N') (r : ℕ → ℕ) (y : ∀ j, (Fin (r j) → R) →ₗ[R] M) (T : ∀ j, (Fin (r j) → R) →ₗ[R] (Fin (r (j + 1)) → R)) (C : ∀ j, (Fin (r (j + 2)) → R) →ₗ[R] (Fin (r (j + 1)) → R)), Function.Surjective p → (∀ j, y (j + 1) ∘ₗ T j = y j) → (∀ j, C j ∘ₗ (T (j + 1) ∘ₗ T j) = T j) → ∃ b : ∀ j, (Fin (r j) → R) →ₗ[R] N, (∀ j, p ∘ₗ b j = φ ∘ₗ y j) ∧ ∀ j, b (j + 1) ∘ₗ T j = b j := by
    intro N N' _ _ _ _ p φ r y T C hp hyT hC
    have hS : ∀ j, ∃ β : (Fin (r j) → R) →ₗ[R] N, p ∘ₗ β = φ ∘ₗ y j := fun j =>
      Module.projective_lifting_property p (φ ∘ₗ y j) hp
    choose β0 hβ0 using hS
    have key : ∀ j (β : (Fin (r (j+1)) → R) →ₗ[R] N), p ∘ₗ β = φ ∘ₗ y (j+1) →
        ∃ β' : (Fin (r (j+2)) → R) →ₗ[R] N, p ∘ₗ β' = φ ∘ₗ y (j+2) ∧
          β' ∘ₗ (T (j+1) ∘ₗ T j) = β ∘ₗ T j := by
      intro j β hβ
      refine ⟨β0 (j+2) + (β - β0 (j+2) ∘ₗ T (j+1)) ∘ₗ C j, ?_, ?_⟩
      · have hd : p ∘ₗ (β - β0 (j+2) ∘ₗ T (j+1)) = 0 := by
          rw [LinearMap.comp_sub, hβ, ← LinearMap.comp_assoc, hβ0, LinearMap.comp_assoc, hyT, sub_self]
        rw [LinearMap.comp_add, hβ0, ← LinearMap.comp_assoc, hd, LinearMap.zero_comp, add_zero]
      · rw [LinearMap.add_comp, LinearMap.comp_assoc, hC, LinearMap.sub_comp, LinearMap.comp_assoc]
        abel
    choose f hf1 hf2 using key
    let seq : ∀ j, {β : (Fin (r (j+1)) → R) →ₗ[R] N // p ∘ₗ β = φ ∘ₗ y (j+1)} := fun j =>
      Nat.rec (motive := fun j => {β : (Fin (r (j+1)) → R) →ₗ[R] N // p ∘ₗ β = φ ∘ₗ y (j+1)})
        ⟨β0 1, hβ0 1⟩ (fun j ih => ⟨f j ih.1 ih.2, hf1 j ih.1 ih.2⟩) j
    refine ⟨fun j => (seq j).1 ∘ₗ T j, ?_, ?_⟩
    · intro j
      show p ∘ₗ ((seq j).1 ∘ₗ T j) = φ ∘ₗ y j
      rw [← LinearMap.comp_assoc, (seq j).2, LinearMap.comp_assoc, hyT]
    · intro j
      show ((seq (j+1)).1 ∘ₗ T (j+1)) ∘ₗ T j = (seq j).1 ∘ₗ T j
      rw [LinearMap.comp_assoc]
      exact hf2 j (seq j).1 (seq j).2

  have s7 : ∀ (N N' : Type u) [AddCommGroup N] [Module R N] [AddCommGroup N'] [Module R N'] (p : N →ₗ[R] N') (φ : M →ₗ[R] N') (x : ℕ → M) (r : ℕ → ℕ) (y : ∀ j, (Fin (r j) → R) →ₗ[R] M) (T : ∀ j, (Fin (r j) → R) →ₗ[R] (Fin (r (j + 1)) → R)) (b : ∀ j, (Fin (r j) → R) →ₗ[R] N), Submodule.span R (Set.range x) = ⊤ → (∀ j, y (j + 1) ∘ₗ T j = y j) → (∀ j (v : Fin (r j) → R), y j v = 0 → T j v = 0) → (∀ n, ∃ v : Fin (r (n + 1)) → R, y (n + 1) v = x n) → (∀ j, p ∘ₗ b j = φ ∘ₗ y j) → (∀ j, b (j + 1) ∘ₗ T j = b j) → ∃ g : M →ₗ[R] N, p ∘ₗ g = φ := by
    intro N N' _ _ _ _ p φ x r y T b hx hyT hker hxv hpb hbT
    have hyT' : ∀ j v, y (j+1) (T j v) = y j v := fun j v => LinearMap.congr_fun (hyT j) v
    have hbT' : ∀ j v, b (j+1) (T j v) = b j v := fun j v => LinearMap.congr_fun (hbT j) v
    have hpb' : ∀ j v, p (b j v) = φ (y j v) := fun j v => LinearMap.congr_fun (hpb j) v
    have kill : ∀ j v, y j v = 0 → b j v = 0 := by
      intro j v hv
      rw [← hbT', hker j v hv, map_zero]
    have trans : ∀ j k, j ≤ k → ∀ v : Fin (r j) → R, ∃ v' : Fin (r k) → R, y k v' = y j v ∧ b k v' = b j v := by
      intro j k hjk
      induction k, hjk using Nat.le_induction with
      | base => intro v; exact ⟨v, rfl, rfl⟩
      | succ k _ ih =>
        intro v
        obtain ⟨v', h1, h2⟩ := ih v
        exact ⟨T k v', by rw [hyT', h1], by rw [hbT', h2]⟩
    have wd0 : ∀ j k, j ≤ k → ∀ (v : Fin (r j) → R) (w : Fin (r k) → R), y j v = y k w → b j v = b k w := by
      intro j k hjk v w hvw
      obtain ⟨v', h1, h2⟩ := trans j k hjk v
      have : b k (v' - w) = 0 := kill k _ (by rw [map_sub, h1, hvw, sub_self])
      rw [map_sub, sub_eq_zero] at this
      rw [← h2, this]
    have wd : ∀ j k (v : Fin (r j) → R) (w : Fin (r k) → R), y j v = y k w → b j v = b k w := by
      intro j k v w hvw
      rcases le_total j k with h | h
      · exact wd0 j k h v w hvw
      · exact (wd0 k j h w v hvw.symm).symm
    let P : Submodule R M :=
      { carrier := {m | ∃ j, ∃ v : Fin (r j) → R, y j v = m}
        add_mem' := by
          rintro _ _ ⟨j, v, rfl⟩ ⟨k, w, rfl⟩
          obtain ⟨v', h1, -⟩ := trans j (max j k) (le_max_left _ _) v
          obtain ⟨w', h2, -⟩ := trans k (max j k) (le_max_right _ _) w
          exact ⟨max j k, v' + w', by rw [map_add, h1, h2]⟩
        zero_mem' := ⟨0, 0, map_zero _⟩
        smul_mem' := by
          rintro c _ ⟨j, v, rfl⟩
          exact ⟨j, c • v, map_smul _ _ _⟩ }
    have hsurj : ∀ m : M, ∃ j, ∃ v : Fin (r j) → R, y j v = m := by
      intro m
      have hle : Submodule.span R (Set.range x) ≤ P := by
        rw [Submodule.span_le]
        rintro _ ⟨n, rfl⟩
        obtain ⟨v, hv⟩ := hxv n
        exact ⟨n+1, v, hv⟩
      rw [hx] at hle
      exact hle (Submodule.mem_top (x := m))
    choose J V hJV using hsurj
    let g : M →ₗ[R] N :=
      { toFun := fun m => b (J m) (V m)
        map_add' := by
          intro m m'
          obtain ⟨v', h1, h1'⟩ := trans (J m) (max (J m) (J m')) (le_max_left _ _) (V m)
          obtain ⟨w', h2, h2'⟩ := trans (J m') (max (J m) (J m')) (le_max_right _ _) (V m')
          have : b (J (m + m')) (V (m + m')) = b (max (J m) (J m')) (v' + w') :=
            wd _ _ _ _ (by rw [hJV, map_add, h1, h2, hJV, hJV])
          show b (J (m + m')) (V (m + m')) = b (J m) (V m) + b (J m') (V m')
          rw [this, map_add, h1', h2']
        map_smul' := by
          intro c m
          have : b (J (c • m)) (V (c • m)) = b (J m) (c • V m) :=
            wd _ _ _ _ (by rw [hJV, map_smul, hJV])
          simp only [RingHom.id_apply]
          rw [this, map_smul] }
    refine ⟨g, LinearMap.ext fun m => ?_⟩
    show p (b (J m) (V m)) = φ m
    rw [hpb', hJV]

  obtain ⟨s, hs, hspan⟩ := hCtbl
  obtain ⟨x, hxs⟩ := (hs.insert 0).exists_eq_range (Set.insert_nonempty 0 s)
  have hx : Submodule.span R (Set.range x) = ⊤ := by
    rw [← hxs, eq_top_iff, ← hspan]
    exact Submodule.span_mono (Set.subset_insert 0 s)
  obtain ⟨r, y, T, C, hyT, hker, hC, hxv⟩ := s5 x
  apply Module.Projective.of_lifting_property''
  intro f hf
  obtain ⟨b, hpb, hbT⟩ := s6 (M →₀ R) M f LinearMap.id r y T C hf hyT hC
  exact s7 (M →₀ R) M f LinearMap.id x r y T b hx hyT hker hxv hpb hbT

theorem wcpa_lfg_pgi_ml_descent : ∀ (R M : Type u) [CommRing R] [IsNoetherianRing R] [AddCommGroup M] [Module R M] (f : R), Module.Projective (Localization.Away f) (LocalizedModule (Submonoid.powers f) M) → (∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module (AdicCompletion (Ideal.span {f}) R) (Q i)], Function.Injective (TensorProduct.piRightHom (AdicCompletion (Ideal.span {f}) R) (AdicCompletion (Ideal.span {f}) R) (TensorProduct R (AdicCompletion (Ideal.span {f}) R) M) Q)) → ∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)], Function.Injective (TensorProduct.piRightHom R R M Q) :=
by
  classical

  have NAT : ∀ (A : Type u) [CommRing A] (N N' : Type u) [AddCommGroup N] [Module A N]
      [AddCommGroup N'] [Module A N'] (g : N →ₗ[A] N') (ι : Type u) (Q : ι → Type u)
      [∀ i, AddCommGroup (Q i)] [∀ i, Module A (Q i)] (z : TensorProduct A N (∀ i, Q i)),
      TensorProduct.piRightHom A A N' Q (LinearMap.rTensor (∀ i, Q i) g z) =
        fun i => LinearMap.rTensor (Q i) g (TensorProduct.piRightHom A A N Q z i) := by
    intro A _ N N' _ _ _ _ g ι Q _ _ z
    induction z using TensorProduct.induction_on with
    | zero => funext i; simp
    | tmul n q => funext i; simp [TensorProduct.piRightHom_tmul]
    | add a b ha hb => rw [map_add, map_add, ha, hb, map_add]; funext i; simp

  have s1 : ∀ (A S : Type u) [CommRing A] (ι : Type u) (Q : ι → Type u)
      [∀ i, AddCommGroup (Q i)] [∀ i, Module A (Q i)],
      Function.Injective (TensorProduct.piRightHom A A (S →₀ A) Q) := by
    intro A S _ ι Q _ _
    let e : ∀ (X : Type u) [AddCommGroup X] [Module A X], (TensorProduct A (S →₀ A) X) ≃ₗ[A] (S →₀ X) :=
      fun X _ _ => TensorProduct.finsuppScalarLeft A X S
    have he : ∀ (X : Type u) [AddCommGroup X] [Module A X] (v : S →₀ A) (x : X) (s : S),
        e X (TensorProduct.tmul A v x) s = v s • x := by
      intro X _ _ v x s
      simp [e]
    have sq : ∀ z : TensorProduct A (S →₀ A) (∀ i, Q i), ∀ i s,
        e (Q i) (TensorProduct.piRightHom A A (S →₀ A) Q z i) s = e (∀ i, Q i) z s i := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => intro i s; simp
      | tmul v q => intro i s; rw [TensorProduct.piRightHom_tmul, he, he]; rfl
      | add a b ha hb =>
        intro i s
        rw [map_add, Pi.add_apply, map_add, Finsupp.add_apply, ha, hb, map_add, Finsupp.add_apply,
          Pi.add_apply]
    intro z z' hzz
    apply (e (∀ i, Q i)).injective
    ext s i
    rw [← sq, ← sq, hzz]

  have s2 : ∀ (A M M' : Type u) [CommRing A] [AddCommGroup M] [Module A M] [AddCommGroup M']
      [Module A M'] (i : M →ₗ[A] M') (p : M' →ₗ[A] M), p ∘ₗ i = LinearMap.id →
      ∀ (ι : Type u) (Q : ι → Type u) [∀ j, AddCommGroup (Q j)] [∀ j, Module A (Q j)],
      Function.Injective (TensorProduct.piRightHom A A M' Q) →
      Function.Injective (TensorProduct.piRightHom A A M Q) := by
    intro A M M' _ _ _ _ _ i p hpi ι Q _ _ hinj
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro z hz
    have h1 : LinearMap.rTensor (∀ j, Q j) i z = 0 := by
      apply hinj
      rw [NAT, hz, map_zero]
      funext j; simp
    have h2 : LinearMap.rTensor (∀ j, Q j) (p ∘ₗ i) z = z := by
      rw [hpi, LinearMap.rTensor_id, LinearMap.id_apply]
    rw [← h2, LinearMap.rTensor_comp, LinearMap.comp_apply, h1, map_zero]

  have s4 : ∀ (R B M : Type u) [CommRing R] [CommRing B] [Algebra R B] [AddCommGroup M]
      [Module R M], (∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)]
      [∀ i, Module B (Q i)], Function.Injective (TensorProduct.piRightHom B B
        (TensorProduct R B M) Q)) →
      ∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module B (Q i)]
      [∀ i, Module R (Q i)] [∀ i, IsScalarTower R B (Q i)],
      Function.Injective (TensorProduct.piRightHom R R M Q) := by
    intro R B M _ _ _ _ _ hPI ι Q _ _ _ _
    let Φ : ∀ (X : Type u) [AddCommGroup X] [Module B X] [Module R X] [IsScalarTower R B X],
        (TensorProduct B (TensorProduct R B M) X) ≃+ (TensorProduct R M X) :=
      fun X _ _ _ _ => (TensorProduct.comm B (TensorProduct R B M) X).toAddEquiv.trans
        ((TensorProduct.AlgebraTensorModule.cancelBaseChange R B B X M).toAddEquiv.trans
          (TensorProduct.comm R X M).toAddEquiv)
    have hΦ : ∀ (X : Type u) [AddCommGroup X] [Module B X] [Module R X] [IsScalarTower R B X]
        (b : B) (m : M) (x : X), Φ X (TensorProduct.tmul B (TensorProduct.tmul R b m) x) =
          TensorProduct.tmul R m (b • x) := by
      intro X _ _ _ _ b m x
      simp [Φ, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
    have sq : ∀ z : TensorProduct B (TensorProduct R B M) (∀ i, Q i),
        TensorProduct.piRightHom R R M Q (Φ (∀ i, Q i) z) =
          fun i => Φ (Q i) (TensorProduct.piRightHom B B (TensorProduct R B M) Q z i) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => funext i; simp
      | tmul t q =>
        induction t using TensorProduct.induction_on with
        | zero => funext i; simp
        | tmul b m =>
          funext i
          rw [hΦ, TensorProduct.piRightHom_tmul, TensorProduct.piRightHom_tmul, hΦ]
          rfl
        | add a b ha hb =>
          rw [TensorProduct.add_tmul, map_add, map_add, ha, hb]
          funext i
          rw [Pi.add_apply, map_add, Pi.add_apply]
          exact (map_add _ _ _).symm
      | add a b ha hb =>
        rw [map_add, map_add, ha, hb]
        funext i
        rw [Pi.add_apply, map_add, Pi.add_apply, map_add]
    intro z z' hzz
    obtain ⟨w, rfl⟩ := (Φ (∀ i, Q i)).surjective z
    obtain ⟨w', rfl⟩ := (Φ (∀ i, Q i)).surjective z'
    rw [sq, sq] at hzz
    have : TensorProduct.piRightHom B B (TensorProduct R B M) Q w =
        TensorProduct.piRightHom B B (TensorProduct R B M) Q w' := by
      funext i
      exact (Φ (Q i)).injective (congrFun hzz i)
    rw [hPI ι Q this]

  have s12 : ∀ (R : Type u) [CommRing R] (n : ℕ) (ι : Type u) (Q : ι → Type u)
      [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)],
      Function.Bijective (TensorProduct.piRightHom R R (Fin n → R) Q) := by
    intro R _ n ι Q _ _
    let e : ∀ (X : Type u) [AddCommGroup X] [Module R X],
        (TensorProduct R (Fin n → R) X) ≃ₗ[R] (Fin n → X) :=
      fun X _ _ => (TensorProduct.comm R (Fin n → R) X).trans
        (TensorProduct.piScalarRight R R X (Fin n))
    have he : ∀ (X : Type u) [AddCommGroup X] [Module R X] (v : Fin n → R) (x : X),
        e X (TensorProduct.tmul R v x) = fun j => v j • x := by
      intro X _ _ v x
      funext j
      simp [e]
    have sq : ∀ z : TensorProduct R (Fin n → R) (∀ i, Q i), ∀ i j,
        e (Q i) (TensorProduct.piRightHom R R (Fin n → R) Q z i) j = e (∀ i, Q i) z j i := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => intro i j; simp
      | tmul v q => intro i j; rw [TensorProduct.piRightHom_tmul, he, he]; rfl
      | add a b ha hb =>
        intro i j
        rw [map_add, Pi.add_apply, map_add, Pi.add_apply, ha, hb, map_add, Pi.add_apply,
          Pi.add_apply]
    constructor
    · intro z z' hzz
      apply (e (∀ i, Q i)).injective
      funext j i
      rw [← sq, ← sq, hzz]
    · intro v
      refine ⟨(e (∀ i, Q i)).symm (fun j i => e (Q i) (v i) j), ?_⟩
      funext i
      apply (e (Q i)).injective
      funext j
      rw [sq, LinearEquiv.apply_symm_apply]

  have s5 : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
      (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)],
      (∀ n : ℕ, Function.Surjective (TensorProduct.piRightHom R R (Fin n → R) Q)) →
      Function.Surjective (TensorProduct.piRightHom R R M Q) := by
    intro R M _ _ _ _ ι Q _ _ hs v
    obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R M
    have hπi : ∀ i, Function.Surjective (LinearMap.rTensor (Q i) π) :=
      fun i => LinearMap.rTensor_surjective _ hπ
    choose u hu using fun i => hπi i (v i)
    obtain ⟨x, hx⟩ := hs n u
    refine ⟨LinearMap.rTensor _ π x, ?_⟩
    rw [NAT, hx]
    funext i
    exact hu i

  have s6 : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M]
      [Module.FinitePresentation R M] (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)]
      [∀ i, Module R (Q i)], (∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.Finite R N],
        Function.Surjective (TensorProduct.piRightHom R R N Q)) →
      (∀ n : ℕ, Function.Injective (TensorProduct.piRightHom R R (Fin n → R) Q)) →
      Function.Injective (TensorProduct.piRightHom R R M Q) := by
    intro R M _ _ _ _ ι Q _ _ hsurj hinjF
    obtain ⟨n, K, x, hK⟩ := Module.FinitePresentation.exists_fin R M
    haveI : Module.Finite R K := Module.Finite.iff_fg.mpr hK
    let π : (Fin n → R) →ₗ[R] M := x.symm.toLinearMap ∘ₗ K.mkQ
    have hπ : Function.Surjective π := by
      intro m
      obtain ⟨q, hq⟩ := x.symm.surjective m
      obtain ⟨v, hv⟩ := K.mkQ_surjective q
      exact ⟨v, by simp [π, hv, hq]⟩
    have hex : Function.Exact K.subtype π := by
      intro v
      constructor
      · intro hv
        have h0 : K.mkQ v = 0 := x.symm.injective (by simpa [π] using hv)
        exact ⟨⟨v, (Submodule.Quotient.mk_eq_zero K).mp h0⟩, rfl⟩
      · rintro ⟨k, rfl⟩
        simp [π]
    have hπK : π ∘ₗ K.subtype = 0 := by
      ext k
      simp [π]
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro z hz
    obtain ⟨y, rfl⟩ := LinearMap.rTensor_surjective (∀ i, Q i) hπ z
    have hrow : ∀ i, ∃ t, LinearMap.rTensor (Q i) K.subtype t =
        TensorProduct.piRightHom R R _ Q y i := by
      intro i
      apply (rTensor_exact (Q i) hex hπ _).mp
      have := congrFun (NAT R _ M π ι Q y) i
      rw [← this, hz]
      rfl
    choose t ht using hrow
    obtain ⟨u, hu⟩ := hsurj K t
    have hy : LinearMap.rTensor _ K.subtype u = y := by
      apply hinjF n
      rw [NAT, hu]
      funext i
      exact ht i
    rw [← hy, ← LinearMap.comp_apply, ← LinearMap.rTensor_comp, hπK, LinearMap.rTensor_zero,
      LinearMap.zero_apply]

  have s7 : ∀ (R B M : Type u) [CommRing R] [CommRing B] [Algebra R B] [AddCommGroup M]
      [Module R M], (∀ (N : Submodule R M), N.FG → ∀ (ι : Type u) (Q : ι → Type u)
        [∀ i, AddCommGroup (Q i)] [∀ i, Module B (Q i)] [∀ i, Module R (Q i)]
        [∀ i, IsScalarTower R B (Q i)], Function.Surjective (TensorProduct.piRightHom R R N Q)) →
      (∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module B (Q i)]
        [∀ i, Module R (Q i)] [∀ i, IsScalarTower R B (Q i)],
        Function.Injective (TensorProduct.piRightHom R R M Q)) →
      ∀ (M₀ : Submodule R M), M₀.FG → ∃ (M' : Submodule R M) (h : M₀ ≤ M'), M'.FG ∧
        ∀ (X : Type u) [AddCommGroup X] [Module B X] [Module R X] [IsScalarTower R B X]
          (y : TensorProduct R M₀ X), LinearMap.rTensor X M₀.subtype y = 0 →
            LinearMap.rTensor X (Submodule.inclusion h) y = 0 := by
    intro R B M _ _ _ _ _ hsurj hinj M₀ hM₀
    by_contra hcon
    push_neg at hcon
    choose X iX iB iR iT y hy0 hyne using hcon
    let ι := {M' : Submodule R M // M₀ ≤ M' ∧ M'.FG}
    let Q : ι → Type u := fun j => X j.1 j.2.1 j.2.2
    letI : ∀ j, AddCommGroup (Q j) := fun j => iX j.1 j.2.1 j.2.2
    letI : ∀ j, Module B (Q j) := fun j => iB j.1 j.2.1 j.2.2
    letI : ∀ j, Module R (Q j) := fun j => iR j.1 j.2.1 j.2.2
    haveI : ∀ j, IsScalarTower R B (Q j) := fun j => iT j.1 j.2.1 j.2.2
    obtain ⟨z₀, hz₀⟩ := hsurj M₀ hM₀ ι Q (fun j => y j.1 j.2.1 j.2.2)
    have hz : LinearMap.rTensor (∀ j, Q j) M₀.subtype z₀ = 0 := by
      apply hinj ι Q
      rw [NAT, hz₀, map_zero]
      funext j
      exact hy0 j.1 j.2.1 j.2.2
    obtain ⟨N', hN', h, hzero⟩ :=
      Submodule.FG.exists_rTensor_fg_inclusion_eq hM₀ (hz.trans (map_zero _).symm)
    rw [map_zero] at hzero
    have key := congrFun (NAT R M₀ N' (Submodule.inclusion h) ι Q z₀) ⟨N', h, hN'⟩
    rw [hzero, map_zero, hz₀] at key
    exact hyne N' h hN' key.symm

  have s8 : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M],
      (∀ (N : Submodule R M), N.FG → ∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)]
        [∀ i, Module R (Q i)], Function.Injective (TensorProduct.piRightHom R R N Q)) →
      (∀ (M₀ : Submodule R M), M₀.FG → ∃ (M' : Submodule R M) (h : M₀ ≤ M'), M'.FG ∧
        ∀ (X : Type u) [AddCommGroup X] [Module R X] (y : TensorProduct R M₀ X),
          LinearMap.rTensor X M₀.subtype y = 0 →
            LinearMap.rTensor X (Submodule.inclusion h) y = 0) →
      ∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)],
        Function.Injective (TensorProduct.piRightHom R R M Q) := by
    intro R M _ _ _ hinj hK ι Q _ _
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro z hz
    obtain ⟨M₀, hM₀, z₀, rfl⟩ := Submodule.exists_fg_le_eq_rTensor_subtype z
    obtain ⟨M', h, hM', hK'⟩ := hK M₀ hM₀
    have h1 : ∀ i, LinearMap.rTensor (Q i) (Submodule.inclusion h)
        (TensorProduct.piRightHom R R M₀ Q z₀ i) = 0 := by
      intro i
      apply hK' (Q i)
      have := congrFun (NAT R M₀ M M₀.subtype ι Q z₀) i
      rw [← this, hz]
      rfl
    have h2 : LinearMap.rTensor (∀ i, Q i) (Submodule.inclusion h) z₀ = 0 := by
      apply hinj M' hM' ι Q
      rw [NAT, map_zero]
      funext i
      exact h1 i
    rw [← Submodule.subtype_comp_inclusion M₀ M' h, LinearMap.rTensor_comp, LinearMap.comp_apply,
      h2, map_zero]

  have s9 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (f : R) (N : Type u)
      [AddCommGroup N] [Module R N] (w : N),
      TensorProduct.tmul R (1 : Localization.Away f) w = 0 →
      TensorProduct.tmul R (1 : AdicCompletion (Ideal.span {f}) R) w = 0 → w = 0 := by
    intro R _ _ f N _ _ w h1 h2
    obtain ⟨⟨s, k, rfl⟩, hsw⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers f)
      (TensorProduct.mk R (Localization.Away f) N 1)).mp h1
    have hkw : f ^ k • w = 0 := hsw
    haveI := AdicCompletion.flat_of_isNoetherian (Ideal.span {f})
    let N₀ := Submodule.span R {w}
    let w₀ : N₀ := ⟨w, Submodule.mem_span_singleton_self w⟩
    have h3 : TensorProduct.tmul R (1 : AdicCompletion (Ideal.span {f}) R) w₀ = 0 := by
      apply Module.Flat.lTensor_preserves_injective_linearMap
        (M := AdicCompletion (Ideal.span {f}) R) N₀.subtype Subtype.val_injective
      rw [LinearMap.lTensor_tmul, map_zero]
      exact h2
    have h4 : TensorProduct.tmul R (Ideal.Quotient.mk ((Ideal.span {f}) ^ k) (1 : R)) w₀ = 0 := by
      rw [map_one]
      have := congrArg (LinearMap.rTensor N₀
        (AdicCompletion.evalₐ (Ideal.span {f}) k).toLinearMap) h3
      rwa [LinearMap.rTensor_tmul, map_zero, AlgHom.toLinearMap_apply, map_one] at this
    have h5 := congrArg (TensorProduct.quotTensorEquivQuotSMul N₀ ((Ideal.span {f}) ^ k)) h4
    rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, map_zero, one_smul,
      Submodule.Quotient.mk_eq_zero] at h5
    have h6 : ((Ideal.span {f}) ^ k • (⊤ : Submodule R N₀)) ≤ ⊥ := by
      rw [Submodule.smul_le]
      intro r hr n _
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hr
      obtain ⟨c, rfl⟩ := hr
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp n.2
      rw [Submodule.mem_bot]
      apply Subtype.ext
      show (c * f ^ k) • (n : N) = 0
      rw [← ha, smul_smul, mul_right_comm, mul_smul, hkw, smul_zero]
    have h7 : w₀ = 0 := by
      have := h6 h5
      rwa [Submodule.mem_bot] at this
    exact congrArg Subtype.val h7

  have s11 : ∀ (R M B₁ B₂ : Type u) [CommRing R] [AddCommGroup M] [Module R M] [CommRing B₁]
      [CommRing B₂] [Algebra R B₁] [Algebra R B₂],
      (∀ (N : Type u) [AddCommGroup N] [Module R N] (w : N), TensorProduct.tmul R (1 : B₁) w = 0 →
        TensorProduct.tmul R (1 : B₂) w = 0 → w = 0) →
      (∀ (M₀ : Submodule R M), M₀.FG → ∃ (M' : Submodule R M) (h : M₀ ≤ M'), M'.FG ∧
        ∀ (X : Type u) [AddCommGroup X] [Module B₁ X] [Module R X] [IsScalarTower R B₁ X]
          (y : TensorProduct R M₀ X), LinearMap.rTensor X M₀.subtype y = 0 →
            LinearMap.rTensor X (Submodule.inclusion h) y = 0) →
      (∀ (M₀ : Submodule R M), M₀.FG → ∃ (M' : Submodule R M) (h : M₀ ≤ M'), M'.FG ∧
        ∀ (X : Type u) [AddCommGroup X] [Module B₂ X] [Module R X] [IsScalarTower R B₂ X]
          (y : TensorProduct R M₀ X), LinearMap.rTensor X M₀.subtype y = 0 →
            LinearMap.rTensor X (Submodule.inclusion h) y = 0) →
      ∀ (M₀ : Submodule R M), M₀.FG → ∃ (M' : Submodule R M) (h : M₀ ≤ M'), M'.FG ∧
        ∀ (X : Type u) [AddCommGroup X] [Module R X] (y : TensorProduct R M₀ X),
          LinearMap.rTensor X M₀.subtype y = 0 →
            LinearMap.rTensor X (Submodule.inclusion h) y = 0 := by
    intro R M B₁ B₂ _ _ _ _ _ _ _ hjoint hK1 hK2 M₀ hM₀
    obtain ⟨M₁, h₁, hM₁, hk₁⟩ := hK1 M₀ hM₀
    obtain ⟨M₂, h₂, hM₂, hk₂⟩ := hK2 M₀ hM₀
    refine ⟨M₁ ⊔ M₂, h₁.trans le_sup_left, hM₁.sup hM₂, ?_⟩
    intro X _ _ y hy
    have key : ∀ (B : Type u) [CommRing B] [Algebra R B] (Mj : Submodule R M) (hj : M₀ ≤ Mj)
        (hle : Mj ≤ M₁ ⊔ M₂),
        (∀ (X : Type u) [AddCommGroup X] [Module B X] [Module R X] [IsScalarTower R B X]
          (y : TensorProduct R M₀ X), LinearMap.rTensor X M₀.subtype y = 0 →
            LinearMap.rTensor X (Submodule.inclusion hj) y = 0) →
        TensorProduct.tmul R (1 : B)
          (LinearMap.rTensor X (Submodule.inclusion (hj.trans hle)) y) = 0 := by
      intro B _ _ Mj hj hle hk
      let ε : X →ₗ[R] TensorProduct R B X := TensorProduct.mk R B X 1
      have ha : LinearMap.rTensor (TensorProduct R B X) M₀.subtype
          (LinearMap.lTensor M₀ ε y) = 0 := by
        rw [← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
          ← LinearMap.lTensor_comp_rTensor, LinearMap.comp_apply, hy, map_zero]
      have hb := hk (TensorProduct R B X) _ ha
      have hc : LinearMap.rTensor (TensorProduct R B X) (Submodule.inclusion (hj.trans hle))
          (LinearMap.lTensor M₀ ε y) = 0 := by
        have e : Submodule.inclusion (hj.trans hle) =
            Submodule.inclusion hle ∘ₗ Submodule.inclusion hj := by
          ext; rfl
        rw [e, LinearMap.rTensor_comp, LinearMap.comp_apply, hb, map_zero]
      have hd : LinearMap.rTensor (TensorProduct R B X) (Submodule.inclusion (hj.trans hle))
          (LinearMap.lTensor M₀ ε y) =
          LinearMap.lTensor _ ε (LinearMap.rTensor X (Submodule.inclusion (hj.trans hle)) y) := by
        rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
          LinearMap.lTensor_comp_rTensor]
      rw [hd] at hc
      have he : ∀ w : TensorProduct R (M₁ ⊔ M₂ : Submodule R M) X,
          TensorProduct.leftComm R _ B X (LinearMap.lTensor _ ε w) =
            TensorProduct.tmul R (1 : B) w := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul m x => simp [ε]
        | add a b ha hb => rw [map_add, map_add, ha, hb, TensorProduct.tmul_add]
      rw [← he, hc, map_zero]
    apply hjoint
    · exact key B₁ M₁ h₁ le_sup_left hk₁
    · exact key B₂ M₂ h₂ le_sup_right hk₂

  intro R M _ _ _ _ f hP hML
  have hPI1 : ∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)]
      [∀ i, Module (Localization.Away f) (Q i)],
      Function.Injective (TensorProduct.piRightHom (Localization.Away f) (Localization.Away f)
        (TensorProduct R (Localization.Away f) M) Q) := by
    have e := (IsLocalizedModule.isBaseChange (Submonoid.powers f) (Localization.Away f)
      (LocalizedModule.mkLinearMap (Submonoid.powers f) M)).equiv
    haveI : Module.Projective (Localization.Away f) (TensorProduct R (Localization.Away f) M) :=
      Module.Projective.of_equiv e.symm
    obtain ⟨s, hs⟩ := Module.projective_def'.mp this
    intro ι Q _ _
    exact s2 _ _ _ s _ hs ι Q (s1 _ _ ι Q)
  have hK1 := s4 R (Localization.Away f) M hPI1
  have hK2 := s4 R (AdicCompletion (Ideal.span {f}) R) M hML
  have hsurjFin : ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.Finite R N] (ι : Type u)
      (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)],
      Function.Surjective (TensorProduct.piRightHom R R N Q) := by
    intro N _ _ _ ι Q _ _
    exact s5 R N ι Q (fun n => (s12 R n ι Q).2)
  have hU1 := s7 R (Localization.Away f) M
    (by
      intro N hN ι Q _ _ _ _
      haveI : Module.Finite R N := Module.Finite.iff_fg.mpr hN
      exact hsurjFin N ι Q) hK1
  have hU2 := s7 R (AdicCompletion (Ideal.span {f}) R) M
    (by
      intro N hN ι Q _ _ _ _
      haveI : Module.Finite R N := Module.Finite.iff_fg.mpr hN
      exact hsurjFin N ι Q) hK2
  have hKR := s11 R M (Localization.Away f) (AdicCompletion (Ideal.span {f}) R)
    (by
      intro N _ _ w h1 h2
      exact s9 R f N w h1 h2) hU1 hU2
  have hinjFG : ∀ (N : Submodule R M), N.FG → ∀ (ι : Type u) (Q : ι → Type u)
      [∀ i, AddCommGroup (Q i)] [∀ i, Module R (Q i)],
      Function.Injective (TensorProduct.piRightHom R R N Q) := by
    intro N hN ι Q _ _
    haveI : Module.Finite R N := Module.Finite.iff_fg.mpr hN
    haveI : Module.FinitePresentation R N := Module.finitePresentation_of_finite R N
    exact s6 R N ι Q (by intro N' _ _ _; exact hsurjFin N' ι Q)
      (fun n => (s12 R n ι Q).1)
  exact s8 R M hinjFG hKR

theorem wcpa_lfg_pgi_cml_powerseries_surj : ∀ (R : Type u) [CommRing R] (f : R), ∃ φ : PowerSeries R →+* AdicCompletion (Ideal.span {f}) R, Function.Surjective φ ∧ φ PowerSeries.X = algebraMap R (AdicCompletion (Ideal.span {f}) R) f ∧ ∀ r : R, φ (PowerSeries.C r) = algebraMap R (AdicCompletion (Ideal.span {f}) R) r :=
by
  intro R _ f
  classical
  set I : Ideal R := Ideal.span {f} with hI
  have hQ : ∀ (n : ℕ) (a b : R), f ^ n ∣ a - b →
      Ideal.Quotient.mk (I ^ n) a = Ideal.Quotient.mk (I ^ n) b := by
    intro n a b h
    rw [Ideal.Quotient.eq, hI, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    exact h
  have hK : ∀ (p : Polynomial R) (m : ℕ), f ^ m ∣ Polynomial.eval f p -
      Polynomial.eval f (PowerSeries.trunc m (p : PowerSeries R)) := by
    intro p m
    have hX : (Polynomial.X : Polynomial R) ^ m ∣ p - PowerSeries.trunc m (p : PowerSeries R) := by
      rw [Polynomial.X_pow_dvd_iff]
      intro d hd
      rw [Polynomial.coeff_sub, PowerSeries.coeff_trunc, if_pos hd, Polynomial.coeff_coe, sub_self]
    obtain ⟨r, hr⟩ := hX
    refine ⟨Polynomial.eval f r, ?_⟩
    rw [← Polynomial.eval_sub, hr, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X]
  let ψ : ∀ n : ℕ, PowerSeries R →+* R ⧸ I ^ n := fun n =>
    { toFun := fun G => Ideal.Quotient.mk (I ^ n) (Polynomial.eval f (PowerSeries.trunc n G))
      map_one' := by
        have h := hK 1 n
        rw [Polynomial.coe_one, Polynomial.eval_one] at h
        exact (hQ n _ _ (dvd_sub_comm.mp h)).trans (map_one _)
      map_mul' := fun G H => by
        have e : PowerSeries.trunc n (G * H) = PowerSeries.trunc n
            ((PowerSeries.trunc n G * PowerSeries.trunc n H : Polynomial R) : PowerSeries R) := by
          rw [Polynomial.coe_mul, PowerSeries.trunc_trunc_mul_trunc]
        show Ideal.Quotient.mk (I ^ n) (Polynomial.eval f (PowerSeries.trunc n (G * H))) =
          Ideal.Quotient.mk (I ^ n) (Polynomial.eval f (PowerSeries.trunc n G)) *
            Ideal.Quotient.mk (I ^ n) (Polynomial.eval f (PowerSeries.trunc n H))
        rw [← map_mul, ← Polynomial.eval_mul, e]
        exact hQ n _ _ (dvd_sub_comm.mp (hK _ n))
      map_zero' := by simp
      map_add' := fun G H => by simp only [map_add, Polynomial.eval_add] }
  have hψ : ∀ n G, ψ n G = Ideal.Quotient.mk (I ^ n) (Polynomial.eval f (PowerSeries.trunc n G)) :=
    fun _ _ => rfl
  have hcompat : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (ψ n) = ψ m := by
    intro m n hle
    refine RingHom.ext fun G => ?_
    rw [RingHom.comp_apply, hψ, hψ]
    rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    apply hQ
    have := hK (PowerSeries.trunc n G) m
    rwa [PowerSeries.trunc_trunc_of_le _ hle] at this
  set φ := AdicCompletion.liftRingHom I ψ hcompat with hφdef
  have hφ : ∀ n G, AdicCompletion.evalₐ I n (φ G) = ψ n G := fun n G =>
    AdicCompletion.evalₐ_liftRingHom I ψ hcompat n G
  have hpoly : ∀ n (p : Polynomial R), ψ n (p : PowerSeries R) =
      Ideal.Quotient.mk (I ^ n) (Polynomial.eval f p) := fun n p =>
    hQ _ _ _ (dvd_sub_comm.mp (hK p n))
  have halg : ∀ n r, AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
      Ideal.Quotient.mk (I ^ n) r := by
    intro n r
    rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      AdicCompletion.evalₐ_of]
  refine ⟨φ, ?_, ?_, ?_⟩
  · intro x
    obtain ⟨t, rfl⟩ := AdicCompletion.mk_surjective I R x
    have hdiff : ∀ n, f ^ n ∣ t (n + 1) - t n := by
      intro n
      have h := AdicCompletion.AdicCauchySequence.mk_eq_mk (Nat.le_succ n) t
      rw [Submodule.Quotient.eq] at h
      rw [Ideal.smul_eq_mul, Ideal.mul_top] at h
      have hmem : ∀ (k : ℕ) (y : R), y ∈ I ^ k → f ^ k ∣ y := by
        intro k y hy
        rw [hI, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hy
        exact hy
      exact hmem n _ h
    choose c hc using hdiff
    have hH : ∀ n, Polynomial.eval f (PowerSeries.trunc n (PowerSeries.mk c)) = t n - t 0 := by
      intro n
      induction n with
      | zero => simp [PowerSeries.trunc_zero']
      | succ n ih =>
        rw [PowerSeries.trunc_succ, Polynomial.eval_add, ih, PowerSeries.coeff_mk,
          Polynomial.eval_monomial]
        linear_combination -(hc n)
    refine ⟨PowerSeries.C (t 0) + PowerSeries.mk c, AdicCompletion.ext_evalₐ fun n => ?_⟩
    rw [hφ, AdicCompletion.evalₐ_mk, hψ]
    cases n with
    | zero => exact hQ 0 _ _ (by rw [pow_zero]; exact one_dvd _)
    | succ k =>
      congr 1
      rw [map_add, PowerSeries.trunc_C, Polynomial.eval_add, Polynomial.eval_C, hH]
      ring
  · refine AdicCompletion.ext_evalₐ fun n => ?_
    rw [hφ, halg, ← Polynomial.coe_X, hpoly, Polynomial.eval_X]
  · intro r
    refine AdicCompletion.ext_evalₐ fun n => ?_
    rw [hφ, halg, ← Polynomial.coe_C, hpoly, Polynomial.eval_C]

theorem wcpa_lfg_pgi_cml_ker_eval : ∀ (R : Type u) [CommRing R] (f : R) (φ : PowerSeries R →+* AdicCompletion (Ideal.span {f}) R), Function.Surjective φ → φ PowerSeries.X = algebraMap R (AdicCompletion (Ideal.span {f}) R) f → (∀ r : R, φ (PowerSeries.C r) = algebraMap R (AdicCompletion (Ideal.span {f}) R) r) → ∀ (n : ℕ) (a : AdicCompletion (Ideal.span {f}) R), AdicCompletion.evalₐ (Ideal.span {f}) n a = 0 → ∃ b : AdicCompletion (Ideal.span {f}) R, a = algebraMap R (AdicCompletion (Ideal.span {f}) R) f ^ n * b :=
by
  intro R _ f φ hsurj hX hC n a ha
  obtain ⟨F, rfl⟩ := hsurj a
  set T : PowerSeries R := ∑ k ∈ Finset.range n,
    PowerSeries.C (PowerSeries.coeff k F) * PowerSeries.X ^ k with hT
  have hdvd : (PowerSeries.X : PowerSeries R) ^ n ∣ F - T := by
    rw [PowerSeries.X_pow_dvd_iff]
    intro d hd
    rw [map_sub, hT, map_sum]
    simp only [PowerSeries.coeff_C_mul_X_pow]
    rw [Finset.sum_ite_eq]
    simp [Finset.mem_range, hd]
  obtain ⟨G, hG⟩ := hdvd
  set p : R := ∑ k ∈ Finset.range n, PowerSeries.coeff k F * f ^ k with hp
  have hφT : φ T = algebraMap R (AdicCompletion (Ideal.span {f}) R) p := by
    rw [hT, hp, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_mul, map_pow, hC, hX, map_mul, map_pow]
  have hFeq : F = T + PowerSeries.X ^ n * G := by rw [← hG]; ring
  have hstar : φ F = algebraMap R (AdicCompletion (Ideal.span {f}) R) p +
      algebraMap R (AdicCompletion (Ideal.span {f}) R) f ^ n * φ G := by
    conv_lhs => rw [hFeq]
    rw [map_add, map_mul, map_pow, hX, hφT]
  have h1 : AdicCompletion.evalₐ (Ideal.span {f}) n
      (algebraMap R (AdicCompletion (Ideal.span {f}) R) p) =
      Ideal.Quotient.mk (Ideal.span {f} ^ n) p := by
    rw [AlgHom.commutes]; rfl
  have h2 : AdicCompletion.evalₐ (Ideal.span {f}) n
      (algebraMap R (AdicCompletion (Ideal.span {f}) R) f ^ n * φ G) = 0 := by
    rw [map_mul, map_pow, AlgHom.commutes, ← map_pow, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self f) n),
      zero_mul]
  have hpI : p ∈ Ideal.span {f} ^ n := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← h1]
    have := ha
    rw [hstar, map_add, h2, add_zero] at this
    exact this
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hpI
  obtain ⟨c, hc⟩ := hpI
  refine ⟨algebraMap R (AdicCompletion (Ideal.span {f}) R) c + φ G, ?_⟩
  rw [hstar, ← hc, map_mul, map_pow]
  ring

theorem wcpa_lfg_pgi_cml_ml_criterion : ∀ (A N : Type u) [CommRing A] [AddCommGroup N] [Module A N], (∀ (P : Type u) [AddCommGroup P] [Module A P] [Module.Finite A P] (t : TensorProduct A N P), t ≠ 0 → ∃ l : N →ₗ[A] A, TensorProduct.lift (LinearMap.lsmul A P ∘ₗ l) t ≠ 0) → ∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module A (Q i)], Function.Injective (TensorProduct.piRightHom A A N Q) :=
by
  intro A N _ _ _ H ι Q _ _

  have nat : ∀ (l : N →ₗ[A] A) (M M' : Type u) [AddCommGroup M] [Module A M] [AddCommGroup M']
      [Module A M'] (g : M →ₗ[A] M') (z : TensorProduct A N M),
      TensorProduct.lift (LinearMap.lsmul A M' ∘ₗ l) (LinearMap.lTensor N g z) =
        g (TensorProduct.lift (LinearMap.lsmul A M ∘ₗ l) z) := by
    intro l M M' _ _ _ _ g z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul n m => simp
    | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]
  have coord : ∀ (x : TensorProduct A N (∀ i, Q i)) (i : ι),
      TensorProduct.piRightHom A A N Q x i = LinearMap.lTensor N (LinearMap.proj i) x := by
    intro x i
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul n f => simp [TensorProduct.piRightHom_tmul]
    | add a b ha hb => rw [map_add, map_add, Pi.add_apply, ha, hb]
  rw [injective_iff_map_eq_zero]
  intro x hx
  by_contra hx0
  obtain ⟨P', hP'fin, hsub⟩ :=
    TensorProduct.exists_finite_submodule_right_of_setFinite ({x} : Set _) (Set.finite_singleton x)
  obtain ⟨t, ht⟩ := hsub (Set.mem_singleton x)
  have ht0 : t ≠ 0 := by
    rintro rfl
    exact hx0 (by rw [← ht, map_zero])
  obtain ⟨l, hl⟩ := H P' t ht0
  have h6 : TensorProduct.lift (LinearMap.lsmul A (∀ i, Q i) ∘ₗ l) x ≠ 0 := by
    rw [← ht, nat l P' (∀ i, Q i) P'.subtype t]
    intro h
    apply hl
    exact (Submodule.coe_eq_zero).mp h
  obtain ⟨i, hi⟩ := Function.ne_iff.mp h6
  apply hi
  have e := nat l (∀ i, Q i) (Q i) (LinearMap.proj i) x
  rw [LinearMap.proj_apply] at e
  rw [Pi.zero_apply, ← e, ← coord x i, hx, Pi.zero_apply, map_zero]

theorem wcpa_lfg_pgi_cml_krull_sep : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] [IsNoetherianRing N] (g : A) (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], (∀ y : N, Function.Injective (LinearMap.rTensor M (LinearMap.mulLeft A (1 - g • y)))) → ∀ t : TensorProduct A N M, (∀ n : ℕ, t ∈ (Ideal.span {g}) ^ n • (⊤ : Submodule A (TensorProduct A N M))) → t = 0 :=
by
  intro A N _ _ _ _ g M _ _ _ hinj t ht
  haveI : Module.Finite N (TensorProduct A N M) := Module.Finite.base_change A N M
  set J : Ideal N := Ideal.span {algebraMap A N g} with hJ
  have hmap : ∀ n : ℕ, (Ideal.span {g} ^ n).map (algebraMap A N) = J ^ n := by
    intro n
    rw [Ideal.map_pow, Ideal.map_span, Set.image_singleton]
  have h2 : ∀ n : ℕ, t ∈ J ^ n • (⊤ : Submodule N (TensorProduct A N M)) := by
    intro n
    refine Submodule.smul_induction_on (ht n) ?_ ?_
    · intro r hr x _
      rw [← algebraMap_smul N r x]
      apply Submodule.smul_mem_smul _ Submodule.mem_top
      rw [← hmap n]
      exact Ideal.mem_map_of_mem _ hr
    · intro x y hx hy
      exact Submodule.add_mem _ hx hy
  have h3 : t ∈ ⨅ i : ℕ, J ^ i • (⊤ : Submodule N (TensorProduct A N M)) :=
    Submodule.mem_iInf _ |>.mpr h2
  obtain ⟨⟨r, hr⟩, hrt⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff (I := J) t).mp h3
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hr
  have hu : ((1 : N) - g • a) • t = 0 := by
    have e1 : ((1 : N) - g • a) • t = (1 : N) • t - (g • a) • t := sub_smul (1 : N) (g • a) t
    have e2 : (1 : N) • t = t := one_smul _ _
    have e3 : g • a = a * algebraMap A N g := by rw [Algebra.smul_def, mul_comm]
    simp only at hrt
    rw [e1, e2, e3, hrt, sub_self]
  have h5 : ∀ x : TensorProduct A N M, ((1 : N) - g • a) • x =
      LinearMap.rTensor M (LinearMap.mulLeft A ((1 : N) - g • a)) x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [smul_zero, map_zero]
    | tmul n m =>
      rw [TensorProduct.smul_tmul', LinearMap.rTensor_tmul, LinearMap.mulLeft_apply, smul_eq_mul]
    | add x y hx hy => rw [smul_add, map_add, hx, hy]
  apply hinj a
  rw [← h5, hu, map_zero]

theorem wcpa_lfg_pgi_cml_devissage : ∀ (A N : Type u) [CommRing A] [IsNoetherianRing A] [CommRing N] [Algebra A N] [Module.Flat A N] (u : N), (∀ (P : Ideal A) [P.IsPrime], Function.Injective (LinearMap.rTensor (A ⧸ P) (LinearMap.mulLeft A u))) → ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], Function.Injective (LinearMap.rTensor M (LinearMap.mulLeft A u)) :=
by
  intro A N _ _ _ _ _ u hP M _ _ hM
  have nat : ∀ (M₁ M₂ : Type u) [AddCommGroup M₁] [Module A M₁] [AddCommGroup M₂] [Module A M₂]
      (h : M₁ →ₗ[A] M₂) (x : TensorProduct A N M₁),
      LinearMap.lTensor N h (LinearMap.rTensor M₁ (LinearMap.mulLeft A u) x) =
        LinearMap.rTensor M₂ (LinearMap.mulLeft A u) (LinearMap.lTensor N h x) := by
    intro M₁ M₂ _ _ _ _ h x
    rw [← LinearMap.comp_apply, ← LinearMap.comp_apply, LinearMap.lTensor_comp_rTensor,
      LinearMap.rTensor_comp_lTensor]
  refine IsNoetherianRing.induction_on_isQuotientEquivQuotientPrime A hM
    (motive := fun M _ _ _ => Function.Injective (LinearMap.rTensor M (LinearMap.mulLeft A u)))
    ?_ ?_ ?_
  · intro M _ _ _ _
    exact Function.injective_of_subsingleton _
  · intro M _ _ _ p e x y hxy
    have h1 := congrArg (LinearMap.lTensor N e.toLinearMap) hxy
    rw [nat, nat] at h1
    have h2 := hP p.asIdeal h1
    exact Module.Flat.lTensor_preserves_injective_linearMap e.toLinearMap e.injective h2
  · intro N₁ _ _ _ N₂ _ _ _ N₃ _ _ _ f g hf hg hfg ih₁ ih₃
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hF : Function.Injective (LinearMap.lTensor N f) :=
      Module.Flat.lTensor_preserves_injective_linearMap f hf
    have hex : Function.Exact (LinearMap.lTensor N f) (LinearMap.lTensor N g) :=
      lTensor_exact N hfg hg
    have hGx : LinearMap.lTensor N g x = 0 := by
      apply ih₃
      rw [← nat, hx, map_zero, map_zero]
    obtain ⟨y, rfl⟩ := (hex x).mp hGx
    have hy : LinearMap.rTensor N₁ (LinearMap.mulLeft A u) y = 0 := by
      apply hF
      rw [nat, hx, map_zero]
    have hy0 : y = 0 := ih₁ (hy.trans (map_zero _).symm)
    rw [hy0, map_zero]

theorem wcpa_lfg_pgi_cml_fibre_inj : ∀ (A N : Type u) [CommRing A] [CommRing N] [Algebra A N] [Module.Flat A N] (g : A), (∀ b : A, IsUnit (1 + g * b)) → (∀ (P : Ideal A) [P.IsPrime], IsDomain (P.Fiber N)) → ∀ (P : Ideal A) [P.IsPrime] (y : N), Function.Injective (LinearMap.rTensor (A ⧸ P) (LinearMap.mulLeft A (1 - g • y))) :=
by
  intro A N _ _ _ _ g hJ hD P _ y

  have hI : P ⊔ Ideal.span {g} ≠ ⊤ := by
    intro htop
    have h1 : (1 : A) ∈ P ⊔ Ideal.span {g} := htop ▸ Submodule.mem_top
    obtain ⟨p, hp, z, hz, hpz⟩ := Submodule.mem_sup.mp h1
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    have hpu : IsUnit p := by
      have : p = 1 + g * (-a) := by linear_combination hpz
      rw [this]; exact hJ _
    exact (inferInstance : P.IsPrime).ne_top (Ideal.eq_top_of_isUnit_mem P hp hpu)
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hI
  have hPm : P ≤ m := le_sup_left.trans hle
  have hgm : g ∈ m := hle (Ideal.mem_sup_right (Ideal.mem_span_singleton_self g))
  haveI := hm.isPrime
  haveI := hD m
  haveI := hD P
  set u : N := 1 - g • y with hu

  let lam : (A ⧸ P) →ₗ[A] m.ResidueField :=
    Submodule.liftQ P (Algebra.linearMap A m.ResidueField) (by
      intro a ha
      rw [LinearMap.mem_ker, Algebra.linearMap_apply]
      exact Ideal.algebraMap_residueField_eq_zero.mpr (hPm ha))
  have hlam1 : lam 1 = 1 := by
    have e1 : (1 : A ⧸ P) = Submodule.Quotient.mk (1 : A) := rfl
    rw [e1]
    erw [Submodule.liftQ_apply]
    exact map_one (algebraMap A m.ResidueField)
  have h1 : ((1 : A ⧸ P) ⊗ₜ[A] u : TensorProduct A (A ⧸ P) N) ≠ 0 := by
    intro h0
    have e := congrArg (LinearMap.rTensor N lam) h0
    rw [LinearMap.rTensor_tmul, map_zero, hlam1, hu, TensorProduct.tmul_sub] at e
    have hg0 : (1 : m.ResidueField) ⊗ₜ[A] (g • y) = 0 := by
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
        Ideal.algebraMap_residueField_eq_zero.mpr hgm, TensorProduct.zero_tmul]
    rw [hg0, sub_zero] at e
    exact one_ne_zero (α := m.Fiber N) e

  let ι : (A ⧸ P) →ₗ[A] P.ResidueField :=
    (IsScalarTower.toAlgHom A (A ⧸ P) P.ResidueField).toLinearMap
  have hι : Function.Injective ι := Ideal.injective_algebraMap_quotient_residueField P
  let ρ : TensorProduct A (A ⧸ P) N →ₗ[A] P.Fiber N := LinearMap.rTensor N ι
  have hρ : Function.Injective ρ := Module.Flat.rTensor_preserves_injective_linearMap ι hι
  let j : TensorProduct A N (A ⧸ P) →ₗ[A] P.Fiber N :=
    ρ ∘ₗ (TensorProduct.comm A N (A ⧸ P)).toLinearMap
  have hj : Function.Injective j := hρ.comp (TensorProduct.comm A N (A ⧸ P)).injective
  have hρ1 : ρ ((1 : A ⧸ P) ⊗ₜ[A] u) = ((1 : P.ResidueField) ⊗ₜ[A] u : P.Fiber N) := by
    simp only [ρ, LinearMap.rTensor_tmul]
    congr 1
    simp [ι]
  have hu0 : ((1 : P.ResidueField) ⊗ₜ[A] u : P.Fiber N) ≠ 0 := by
    intro h0
    apply h1
    apply hρ
    rw [map_zero, hρ1, h0]
  have key : ∀ x, j (LinearMap.rTensor (A ⧸ P) (LinearMap.mulLeft A u) x) =
      ((1 : P.ResidueField) ⊗ₜ[A] u : P.Fiber N) * j x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul n a =>
      simp only [j, ρ, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.rTensor_tmul,
        TensorProduct.comm_tmul, LinearMap.mulLeft_apply]
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
    | add x z hx hz => rw [map_add, map_add, hx, hz, map_add, mul_add]
  rw [injective_iff_map_eq_zero]
  intro x hx
  have e := key x
  rw [hx, map_zero] at e
  rcases mul_eq_zero.mp e.symm with h | h
  · exact absurd h hu0
  · exact hj (h.trans (map_zero j).symm)

theorem wcpa_lfg_pgi_cml_proj_levels : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S] (f : R), Module.Projective (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) S) → ∀ n : ℕ, Module.Projective (R ⧸ Ideal.span {f} ^ n) (TensorProduct R (R ⧸ Ideal.span {f} ^ n) S) :=
by
  intro R S _ _ _ _ f hproj n
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have h : Ideal.span {f} ^ 0 = ⊤ := by rw [pow_zero, Ideal.one_eq_top]
    haveI : Subsingleton (R ⧸ Ideal.span {f} ^ 0) := Ideal.Quotient.subsingleton_iff.mpr h
    haveI : Subsingleton (TensorProduct R (R ⧸ Ideal.span {f} ^ 0) S) :=
      Module.subsingleton (R ⧸ Ideal.span {f} ^ 0) _
    haveI : Module.Free (R ⧸ Ideal.span {f} ^ 0) (TensorProduct R (R ⧸ Ideal.span {f} ^ 0) S) :=
      Module.Free.of_subsingleton _ _
    exact Module.Projective.of_free
  · have hKI : Ideal.span {f} ^ n ≤ Ideal.span {f} := Ideal.pow_le_self hn.ne'
    have hnil : IsNilpotent ((Ideal.span {f}).map (Ideal.Quotient.mkₐ R (Ideal.span {f} ^ n))) := by
      refine ⟨n, ?_⟩
      rw [Ideal.zero_eq_bot, ← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker]
      intro x hx
      rw [RingHom.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
    have htr : Module.Projective
        ((R ⧸ Ideal.span {f} ^ n) ⧸ (Ideal.span {f}).map (Ideal.Quotient.mkₐ R (Ideal.span {f} ^ n)))
        (TensorProduct (R ⧸ Ideal.span {f} ^ n)
          ((R ⧸ Ideal.span {f} ^ n) ⧸ (Ideal.span {f}).map (Ideal.Quotient.mkₐ R (Ideal.span {f} ^ n)))
          (TensorProduct R (R ⧸ Ideal.span {f} ^ n) S)) := by
      generalize hI : Ideal.span {f} = I at hKI hproj
      generalize hK : I ^ n = K at hKI
      let e₁ : ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) ≃ₐ[R] R ⧸ I :=
        DoubleQuot.quotQuotEquivQuotOfLEₐ R hKI
      let σ : ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) →+* R ⧸ I := e₁.toRingEquiv.toRingHom
      let σ' : R ⧸ I →+* ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) :=
        e₁.toRingEquiv.symm.toRingHom
      haveI h1 : RingHomInvPair σ σ' := RingHomInvPair.of_ringEquiv e₁.toRingEquiv
      haveI h2 : RingHomInvPair σ' σ := RingHomInvPair.symm σ σ'
      let T := Algebra.TensorProduct.congr e₁ (AlgEquiv.refl : S ≃ₐ[R] S)
      have hT : ∀ (c : (R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K))
          (x : TensorProduct R ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) S),
          T (c • x) = σ c • T x := by
        intro c x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a s =>
          rw [TensorProduct.smul_tmul']
          simp only [T, Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul]
          rw [TensorProduct.smul_tmul']
          congr 1
          simp [σ, smul_eq_mul, map_mul]
        | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add]
      let E : TensorProduct R ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) S ≃ₛₗ[σ]
          TensorProduct R (R ⧸ I) S :=
        { T.toAddEquiv with map_smul' := hT }
      haveI : Module.Projective ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K))
          (TensorProduct R ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) S) :=
        Module.Projective.of_equiv E.symm
      exact Module.Projective.of_equiv
        (TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ K)
          ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) ((R ⧸ K) ⧸ I.map (Ideal.Quotient.mkₐ R K)) S).symm
    exact wcpa_lfg_pgi_nilpotent_lift (R ⧸ Ideal.span {f} ^ n)
      (TensorProduct R (R ⧸ Ideal.span {f} ^ n) S) _ hnil inferInstance htr

theorem wcpa_lfg_pgi_cml_functional_detect : ∀ (R S : Type u) [CommRing R] [AddCommGroup S] [Module R S] (I : Ideal R), Module.Projective (R ⧸ I) (TensorProduct R (R ⧸ I) S) → ∀ (X : Type u) [AddCommGroup X] [Module R X] (t : TensorProduct R S X), LinearMap.lTensor S (I • (⊤ : Submodule R X)).mkQ t ≠ 0 → ∃ μ : S →ₗ[R] R ⧸ I, TensorProduct.quotTensorEquivQuotSMul X I (LinearMap.rTensor X μ t) ≠ 0 :=
by
  intro R S _ _ _ I hproj X _ _ t ht
  classical
  have s1 : ∀ (B M Y : Type u) [CommRing B] [AddCommGroup M] [Module B M] [AddCommGroup Y]
      [Module B Y], Module.Projective B M → ∀ (z : TensorProduct B M Y), z ≠ 0 →
      ∃ c : M →ₗ[B] B, TensorProduct.lift (LinearMap.lsmul B Y ∘ₗ c) z ≠ 0 := by
    intro B M Y _ _ _ _ _ hP z hz
    obtain ⟨s, hs⟩ := Module.projective_def'.mp hP
    have hz1 : LinearMap.rTensor Y s z ≠ 0 := by
      intro h
      apply hz
      have e : LinearMap.rTensor Y (Finsupp.linearCombination B id) (LinearMap.rTensor Y s z) = z := by
        rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp, hs, LinearMap.rTensor_id,
          LinearMap.id_apply]
      rw [← e, h, map_zero]
    have hΦ : TensorProduct.finsuppScalarLeft B Y M (LinearMap.rTensor Y s z) ≠ 0 :=
      (LinearEquiv.map_ne_zero_iff _).mpr hz1
    obtain ⟨m₀, hm₀⟩ : ∃ m₀, TensorProduct.finsuppScalarLeft B Y M (LinearMap.rTensor Y s z) m₀ ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hΦ (Finsupp.ext hcon)
    refine ⟨Finsupp.lapply m₀ ∘ₗ s, ?_⟩
    have key : ∀ z' : TensorProduct B M Y,
        TensorProduct.lift (LinearMap.lsmul B Y ∘ₗ (Finsupp.lapply m₀ ∘ₗ s)) z' =
          TensorProduct.finsuppScalarLeft B Y M (LinearMap.rTensor Y s z') m₀ := by
      intro z'
      induction z' using TensorProduct.induction_on with
      | zero => simp
      | tmul m y =>
        rw [TensorProduct.lift.tmul, LinearMap.rTensor_tmul,
          TensorProduct.finsuppScalarLeft_apply_tmul_apply]
        rfl
      | add a b ha hb => rw [map_add, ha, hb, map_add, map_add, Finsupp.add_apply]
    rw [key]; exact hm₀
  have hz0 : TensorProduct.comm (R ⧸ I) (X ⧸ I • (⊤ : Submodule R X)) (TensorProduct R (R ⧸ I) S)
      ((TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I)
        (X ⧸ I • (⊤ : Submodule R X)) S).symm
        (TensorProduct.comm R S (X ⧸ I • (⊤ : Submodule R X))
          (LinearMap.lTensor S (I • (⊤ : Submodule R X)).mkQ t))) ≠ 0 := by
    rw [LinearEquiv.map_ne_zero_iff, LinearEquiv.map_ne_zero_iff, LinearEquiv.map_ne_zero_iff]
    exact ht
  obtain ⟨c, hc⟩ := s1 (R ⧸ I) (TensorProduct R (R ⧸ I) S) (X ⧸ I • (⊤ : Submodule R X)) hproj _ hz0
  refine ⟨(c.restrictScalars R) ∘ₗ TensorProduct.mk R (R ⧸ I) S 1, ?_⟩
  have key : ∀ t' : TensorProduct R S X, TensorProduct.quotTensorEquivQuotSMul X I
      (LinearMap.rTensor X ((c.restrictScalars R) ∘ₗ TensorProduct.mk R (R ⧸ I) S 1) t') =
      TensorProduct.lift (LinearMap.lsmul (R ⧸ I) (X ⧸ I • (⊤ : Submodule R X)) ∘ₗ c)
        (TensorProduct.comm (R ⧸ I) (X ⧸ I • (⊤ : Submodule R X)) (TensorProduct R (R ⧸ I) S)
          ((TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I)
            (X ⧸ I • (⊤ : Submodule R X)) S).symm
            (TensorProduct.comm R S (X ⧸ I • (⊤ : Submodule R X))
              (LinearMap.lTensor S (I • (⊤ : Submodule R X)).mkQ t')))) := by
    intro t'
    induction t' using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul s x =>
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (c (1 ⊗ₜ[R] s))
      rw [LinearMap.rTensor_tmul, LinearMap.lTensor_tmul, TensorProduct.comm_tmul,
        TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul, TensorProduct.comm_tmul,
        TensorProduct.lift.tmul]
      rw [LinearMap.comp_apply, LinearMap.restrictScalars_apply, TensorProduct.mk_apply,
        LinearMap.comp_apply, LinearMap.lsmul_apply, ← hr,
        TensorProduct.quotTensorEquivQuotSMul_mk_tmul, Submodule.mkQ_apply]
      rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul, Submodule.Quotient.mk_smul]
    | add a b ha hb =>
      rw [map_add, map_add, ha, hb]
      simp only [map_add]
  rw [key]
  exact hc

theorem wcpa_lfg_pgi_cml_lift_functional : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (f : R), (∀ m : ℕ, Module.Projective (R ⧸ Ideal.span {f} ^ m) (TensorProduct R (R ⧸ Ideal.span {f} ^ m) S)) → ∀ (n : ℕ) (μ : S →ₗ[R] R ⧸ Ideal.span {f} ^ n), ∃ l : S →ₗ[R] AdicCompletion (Ideal.span {f}) R, ∀ s : S, AdicCompletion.evalₐ (Ideal.span {f}) n (l s) = μ s :=
by
  intro R S _ _ _ f hproj n μ
  suffices H : ∀ (I : Ideal R),
      (∀ m : ℕ, Module.Projective (R ⧸ I ^ m) (TensorProduct R (R ⧸ I ^ m) S)) →
      ∀ μ : S →ₗ[R] R ⧸ I ^ n, ∃ l : S →ₗ[R] AdicCompletion I R,
        ∀ s : S, AdicCompletion.evalₐ I n (l s) = μ s from H _ hproj μ
  clear μ hproj
  intro I hproj μ

  have step : ∀ (k : ℕ) (ν : S →ₗ[R] R ⧸ I ^ k), ∃ ν' : S →ₗ[R] R ⧸ I ^ (k + 1),
      ∀ s, Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ k)) (ν' s) = ν s := by
    intro k ν
    letI : Algebra (R ⧸ I ^ (k + 1)) (R ⧸ I ^ k) :=
      (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ k))).toAlgebra
    have : IsScalarTower R (R ⧸ I ^ (k + 1)) (R ⧸ I ^ k) :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [RingHom.algebraMap_toAlgebra, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.algebraMap_eq,
          Ideal.Quotient.factor_mk])
    have := hproj (k + 1)
    obtain ⟨h, hh⟩ := Module.projective_lifting_property
      (Algebra.linearMap (R ⧸ I ^ (k + 1)) (R ⧸ I ^ k))
      (LinearMap.liftBaseChange (R ⧸ I ^ (k + 1)) ν)
      (Ideal.Quotient.factor_surjective (Ideal.pow_le_pow_right (Nat.le_succ k)))
    refine ⟨(h.restrictScalars R) ∘ₗ (TensorProduct.mk R (R ⧸ I ^ (k + 1)) S 1), fun s => ?_⟩
    have e := LinearMap.congr_fun hh ((1 : R ⧸ I ^ (k + 1)) ⊗ₜ[R] s)
    rw [LinearMap.comp_apply, LinearMap.liftBaseChange_tmul, one_smul] at e
    exact e
  choose L hL using step

  let w : ∀ j : ℕ, S →ₗ[R] R ⧸ I ^ (n + j) := fun j =>
    Nat.rec (motive := fun j => S →ₗ[R] R ⧸ I ^ (n + j)) μ (fun j w => L (n + j) w) j
  have hwS : ∀ j s, Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ (n + j)))
      (w (j + 1) s) = w j s := fun j s => hL (n + j) (w j) s
  have hA : ∀ j j' (hjj : j ≤ j') (s : S),
      Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.add_le_add_left hjj n)) (w j' s) = w j s := by
    intro j j' hjj
    induction j', hjj using Nat.le_induction with
    | base =>
      intro s
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (w j s)
      rw [← hr, Ideal.Quotient.factor_mk]
    | succ j' hjj ih =>
      intro s
      rw [← ih s, ← hwS j' s, Ideal.Quotient.factor_comp_apply]

  have hk : ∀ k : ℕ, I ^ k = I ^ k • (⊤ : Submodule R R) := fun k => by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
  let F : ∀ k : ℕ, S →ₗ[R] R ⧸ (I ^ k • (⊤ : Submodule R R)) := fun k =>
    (Submodule.quotEquivOfEq _ _ (hk k)).toLinearMap ∘ₗ
      (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right (Nat.le_add_left k n))).toLinearMap ∘ₗ w k
  have hF : ∀ (k : ℕ) (s : S) (r : R),
      Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_add_left k n)) (w k s) =
        Ideal.Quotient.mk (I ^ k) r →
      F k s = Submodule.Quotient.mk r := by
    intro k s r hr
    show Submodule.quotEquivOfEq _ _ (hk k)
      (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right (Nat.le_add_left k n)) (w k s)) = _
    rw [Ideal.Quotient.factorₐ_apply, hr]
    rfl
  have hcompat : ∀ {m k : ℕ} (hle : m ≤ k),
      AdicCompletion.transitionMap I R hle ∘ₗ F k = F m := by
    intro m k hle
    refine LinearMap.ext fun s => ?_
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (w k s)
    rw [LinearMap.comp_apply, hF k s r (by rw [← hr, Ideal.Quotient.factor_mk]),
      hF m s r (by rw [← hA m k hle s, ← hr, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk])]
    exact Submodule.factor_mk _ r
  refine ⟨AdicCompletion.lift I F hcompat, fun s => ?_⟩
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (w n s)
  have h1 : F n s = Submodule.Quotient.mk r := hF n s r (by rw [← hr, Ideal.Quotient.factor_mk])
  have h3 : Ideal.Quotient.mk (I ^ n) r = μ s := by
    have := hA 0 n (Nat.zero_le n) s
    rw [← hr, Ideal.Quotient.factor_mk] at this
    exact this
  show Ideal.quotientEquivAlgOfEq R (hk n).symm
    (AdicCompletion.eval I R n (AdicCompletion.lift I F hcompat s)) = _
  rw [AdicCompletion.eval_apply, AdicCompletion.eval_lift_apply, h1, ← h3]
  exact Ideal.quotientEquivAlgOfEq_mk R (hk n).symm r

theorem wcpa_lfg_pgi_cml_detect_complete : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (f : R) (n : ℕ), (∀ (X : Type u) [AddCommGroup X] [Module R X] (t : TensorProduct R S X), LinearMap.lTensor S ((Ideal.span {f} ^ n) • (⊤ : Submodule R X)).mkQ t ≠ 0 → ∃ μ : S →ₗ[R] R ⧸ Ideal.span {f} ^ n, TensorProduct.quotTensorEquivQuotSMul X (Ideal.span {f} ^ n) (LinearMap.rTensor X μ t) ≠ 0) → (∀ μ : S →ₗ[R] R ⧸ Ideal.span {f} ^ n, ∃ l : S →ₗ[R] AdicCompletion (Ideal.span {f}) R, ∀ s : S, AdicCompletion.evalₐ (Ideal.span {f}) n (l s) = μ s) → (∀ a : AdicCompletion (Ideal.span {f}) R, AdicCompletion.evalₐ (Ideal.span {f}) n a = 0 → ∃ b : AdicCompletion (Ideal.span {f}) R, a = algebraMap R (AdicCompletion (Ideal.span {f}) R) f ^ n * b) → ∀ (P : Type u) [AddCommGroup P] [Module (AdicCompletion (Ideal.span {f}) R) P] [Module R P] [IsScalarTower R (AdicCompletion (Ideal.span {f}) R) P] (t : TensorProduct (AdicCompletion (Ideal.span {f}) R) (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S) P), t ∉ (Ideal.span {algebraMap R (AdicCompletion (Ideal.span {f}) R) f}) ^ n • (⊤ : Submodule (AdicCompletion (Ideal.span {f}) R) (TensorProduct (AdicCompletion (Ideal.span {f}) R) (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S) P)) → ∃ l : TensorProduct R (AdicCompletion (Ideal.span {f}) R) S →ₗ[AdicCompletion (Ideal.span {f}) R] AdicCompletion (Ideal.span {f}) R, TensorProduct.lift (LinearMap.lsmul (AdicCompletion (Ideal.span {f}) R) P ∘ₗ l) t ≠ 0 :=
by
  intro R S _ _ _ f n hDet hLift hKer P _ _ _ _ t ht

  have s1 : ∀ (A P : Type u) [CommRing A] [Algebra R A] [AddCommGroup P] [Module A P]
      [Module R P] [IsScalarTower R A P] (I : Ideal R)
      (t : TensorProduct A (TensorProduct R A S) P),
      t ∉ (I.map (algebraMap R A)) • (⊤ : Submodule A (TensorProduct A (TensorProduct R A S) P)) →
      LinearMap.lTensor S (I • (⊤ : Submodule R P)).mkQ (TensorProduct.comm R P S
        (TensorProduct.AlgebraTensorModule.cancelBaseChange R A A P S
          (TensorProduct.comm A (TensorProduct R A S) P t))) ≠ 0 := by
    intro A P _ _ _ _ _ _ I t ht h0
    apply ht
    let e : TensorProduct A (TensorProduct R A S) P ≃ₗ[A] TensorProduct R P S :=
      (TensorProduct.comm A (TensorProduct R A S) P).trans
        (TensorProduct.AlgebraTensorModule.cancelBaseChange R A A P S)
    have hex := lTensor_exact S (LinearMap.exact_subtype_mkQ (I • (⊤ : Submodule R P)))
      (Submodule.mkQ_surjective _)
    obtain ⟨z, hz⟩ := (hex _).mp h0
    have key : ∀ z : TensorProduct R S ↥(I • (⊤ : Submodule R P)),
        e.symm ((TensorProduct.comm R P S).symm
          (LinearMap.lTensor S (I • (⊤ : Submodule R P)).subtype z)) ∈
          (I.map (algebraMap R A)) •
            (⊤ : Submodule A (TensorProduct A (TensorProduct R A S) P)) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | add x y hx hy => rw [map_add, map_add, map_add]; exact add_mem hx hy
      | tmul s p =>
        obtain ⟨p, hp⟩ := p
        simp only [LinearMap.lTensor_tmul, Submodule.subtype_apply, TensorProduct.comm_symm_tmul]
        refine Submodule.smul_induction_on (p := fun q => e.symm (q ⊗ₜ[R] s) ∈
          (I.map (algebraMap R A)) • (⊤ : Submodule A (TensorProduct A (TensorProduct R A S) P)))
          hp ?_ ?_
        · intro r hr p' _
          show e.symm ((r • p') ⊗ₜ[R] s) ∈ _
          rw [← algebraMap_smul A r p', ← TensorProduct.smul_tmul', LinearEquiv.map_smul]
          exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) Submodule.mem_top
        · intro x y hx hy
          show e.symm ((x + y) ⊗ₜ[R] s) ∈ _
          rw [TensorProduct.add_tmul, map_add]
          exact add_mem hx hy
    have h1 : (TensorProduct.comm R P S).symm
        (LinearMap.lTensor S (I • (⊤ : Submodule R P)).subtype z) = e t := by
      rw [hz, LinearEquiv.symm_apply_apply]; rfl
    rw [← e.symm_apply_apply t, ← h1]
    exact key z

  have s2 : ∀ (A P : Type u) [CommRing A] [Algebra R A] [AddCommGroup P] [Module A P]
      [Module R P] [IsScalarTower R A P] (I : Ideal R) (c : R), c ∈ I →
      ∀ (ev : A →ₐ[R] R ⧸ I), (∀ a : A, ev a = 0 → ∃ b : A, a = algebraMap R A c * b) →
      ∀ (μ : S →ₗ[R] R ⧸ I) (l₀ : S →ₗ[R] A), (∀ s : S, ev (l₀ s) = μ s) →
      ∀ x : TensorProduct A (TensorProduct R A S) P,
      (I • (⊤ : Submodule R P)).mkQ
        (TensorProduct.lift (LinearMap.lsmul A P ∘ₗ LinearMap.liftBaseChange A l₀) x) =
      TensorProduct.quotTensorEquivQuotSMul P I (LinearMap.rTensor P μ (TensorProduct.comm R P S
        (TensorProduct.AlgebraTensorModule.cancelBaseChange R A A P S
          (TensorProduct.comm A (TensorProduct R A S) P x)))) := by
    intro A P _ _ _ _ _ _ I c hc ev hker μ l₀ hl x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul n p =>
      induction n using TensorProduct.induction_on with
      | zero => simp
      | add x y hx hy => simp only [TensorProduct.add_tmul, map_add, hx, hy]
      | tmul a s =>
        simp only [TensorProduct.lift.tmul, LinearMap.comp_apply, LinearMap.lsmul_apply,
          LinearMap.liftBaseChange_tmul, TensorProduct.comm_tmul,
          TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, LinearMap.rTensor_tmul]
        obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (μ s)
        rw [← hr, TensorProduct.quotTensorEquivQuotSMul_mk_tmul]
        obtain ⟨b, hb⟩ := hker (l₀ s - algebraMap R A r) (by
          rw [map_sub, AlgHom.commutes, hl, ← hr, Ideal.Quotient.algebraMap_eq, sub_self])
        rw [Submodule.mkQ_apply, Submodule.Quotient.eq]
        have hrw : (a • l₀ s) • p - r • a • p = c • ((a * b) • p) := by
          rw [smul_eq_mul, sub_eq_iff_eq_add.mp hb, ← algebraMap_smul A c, ← algebraMap_smul A r,
            smul_smul, smul_smul, ← sub_smul]
          congr 1
          ring
        rw [hrw]
        exact Submodule.smul_mem_smul hc Submodule.mem_top

  have hI : (Ideal.span {algebraMap R (AdicCompletion (Ideal.span {f}) R) f}) ^ n =
      (Ideal.span {f} ^ n).map (algebraMap R (AdicCompletion (Ideal.span {f}) R)) := by
    rw [Ideal.map_pow, Ideal.map_span, Set.image_singleton]
  rw [hI] at ht
  have h0 := s1 (AdicCompletion (Ideal.span {f}) R) P (Ideal.span {f} ^ n) t ht
  obtain ⟨μ, hμ⟩ := hDet P _ h0
  obtain ⟨l₀, hl₀⟩ := hLift μ
  refine ⟨LinearMap.liftBaseChange (AdicCompletion (Ideal.span {f}) R) l₀, ?_⟩
  intro hzero
  have h2 := s2 (AdicCompletion (Ideal.span {f}) R) P (Ideal.span {f} ^ n) (f ^ n)
    (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self f) n)
    (AdicCompletion.evalₐ (Ideal.span {f}) n)
    (fun a ha => by
      obtain ⟨b, hb⟩ := hKer a ha
      exact ⟨b, by rw [map_pow]; exact hb⟩) μ l₀ hl₀ t
  rw [hzero, map_zero] at h2
  exact hμ h2.symm

theorem wcpa_lfg_pgi_complete_ml : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S] [Module.Flat R S] (f : R), (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → Module.Projective (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) S) → ∀ (ι : Type u) (Q : ι → Type u) [∀ i, AddCommGroup (Q i)] [∀ i, Module (AdicCompletion (Ideal.span {f}) R) (Q i)], Function.Injective (TensorProduct.piRightHom (AdicCompletion (Ideal.span {f}) R) (AdicCompletion (Ideal.span {f}) R) (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S) Q) :=
by
  intro R S _ _ _ _ _ _ f hGI hproj ι Q _ _

  obtain ⟨φ, hsurj, hX, hC⟩ := wcpa_lfg_pgi_cml_powerseries_surj R f
  haveI hÂ : IsNoetherianRing (AdicCompletion (Ideal.span {f}) R) :=
    isNoetherianRing_of_surjective (PowerSeries R) _ φ hsurj
  have hJac : ∀ b : AdicCompletion (Ideal.span {f}) R,
      IsUnit (1 + algebraMap R (AdicCompletion (Ideal.span {f}) R) f * b) := by
    intro b
    obtain ⟨G, rfl⟩ := hsurj b
    have hu : IsUnit (1 + PowerSeries.X * G : PowerSeries R) := by
      rw [PowerSeries.isUnit_iff_constantCoeff]
      simp
    have h2 := hu.map φ
    rwa [map_add, map_one, map_mul, hX] at h2
  have hKer := wcpa_lfg_pgi_cml_ker_eval R f φ hsurj hX hC

  haveI hN : IsNoetherianRing (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S) :=
    Algebra.FiniteType.isNoetherianRing (AdicCompletion (Ideal.span {f}) R) _

  have hfib : ∀ (P : Ideal (AdicCompletion (Ideal.span {f}) R)) [P.IsPrime],
      IsDomain (P.Fiber (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S)) := by
    intro P _
    haveI := wcpa_lfg_pgi_fibre_base_change R (AdicCompletion (Ideal.span {f}) R) S hGI P
      P.ResidueField
    exact MulEquiv.isDomain _
      (Algebra.TensorProduct.lid P.ResidueField
        (P.Fiber (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S))).symm.toRingEquiv.toMulEquiv

  have hlev := wcpa_lfg_pgi_cml_proj_levels R S f hproj

  have hinj : ∀ (y : TensorProduct R (AdicCompletion (Ideal.span {f}) R) S) (M : Type u)
      [AddCommGroup M] [Module (AdicCompletion (Ideal.span {f}) R) M]
      [Module.Finite (AdicCompletion (Ideal.span {f}) R) M],
      Function.Injective (LinearMap.rTensor M (LinearMap.mulLeft (AdicCompletion (Ideal.span {f}) R)
        (1 - algebraMap R (AdicCompletion (Ideal.span {f}) R) f • y))) := by
    intro y M _ _ _
    apply wcpa_lfg_pgi_cml_devissage
    intro P _
    exact wcpa_lfg_pgi_cml_fibre_inj _ _ (algebraMap R (AdicCompletion (Ideal.span {f}) R) f)
      hJac hfib P y

  apply wcpa_lfg_pgi_cml_ml_criterion
  intro P _ _ _ t ht
  have hn : ∃ n : ℕ, t ∉ (Ideal.span {algebraMap R (AdicCompletion (Ideal.span {f}) R) f}) ^ n •
      (⊤ : Submodule (AdicCompletion (Ideal.span {f}) R)
        (TensorProduct (AdicCompletion (Ideal.span {f}) R)
          (TensorProduct R (AdicCompletion (Ideal.span {f}) R) S) P)) := by
    by_contra hcon
    push_neg at hcon
    exact ht (wcpa_lfg_pgi_cml_krull_sep _ _ (algebraMap R (AdicCompletion (Ideal.span {f}) R) f)
      P (fun y => hinj y P) t hcon)
  obtain ⟨n, hn⟩ := hn
  letI : Module R P := Module.compHom P (algebraMap R (AdicCompletion (Ideal.span {f}) R))
  haveI : IsScalarTower R (AdicCompletion (Ideal.span {f}) R) P := ⟨fun r a p => by
    show (r • a) • p = algebraMap R (AdicCompletion (Ideal.span {f}) R) r • (a • p)
    rw [Algebra.smul_def, mul_smul]⟩
  exact wcpa_lfg_pgi_cml_detect_complete R S f n
    (wcpa_lfg_pgi_cml_functional_detect R S (Ideal.span {f} ^ n) (hlev n))
    (wcpa_lfg_pgi_cml_lift_functional R S f hlev n) (hKer n) P t hn

theorem wcpa_lfg_pgi_noeth_induction : (∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S] [Module.Flat R S], (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → (∀ J : Ideal R, J ≠ ⊥ → Module.Projective (R ⧸ J) (TensorProduct R (R ⧸ J) S)) → Module.Projective R S) → (∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] (I : Ideal R), IsNilpotent I → Module.Flat R M → Module.Projective (R ⧸ I) (TensorProduct R (R ⧸ I) M) → Module.Projective R M) → (∀ (R R' S : Type u) [CommRing R] [CommRing R'] [CommRing S] [Algebra R R'] [Algebra R S], (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → ∀ (P : Ideal R') [P.IsPrime] (L : Type u) [Field L] [Algebra P.ResidueField L], IsDomain (TensorProduct P.ResidueField L (P.Fiber (TensorProduct R R' S)))) → ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S] [Module.Flat R S], (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → Module.Projective R S :=
by
  intro hRed hNil hFBC R S _ _ _ _ _ _ hGI
  suffices key : ∀ I : Ideal R, ∀ (C : Type u) [CommRing C] [Algebra R C],
      Function.Surjective (algebraMap R C) → RingHom.ker (algebraMap R C) = I →
      Module.Projective C (TensorProduct R C S) by
    have h0 := key ⊥ R Function.surjective_id
      ((RingHom.ker_eq_bot_iff_eq_zero _).mpr (fun x hx => hx))
    exact Module.Projective.of_equiv (TensorProduct.lid R S)
  intro I
  induction I using WellFoundedGT.induction with
  | _ I IH =>
  intro C _ _ hsurj hker
  have : IsNoetherianRing C := isNoetherianRing_of_surjective R C (algebraMap R C) hsurj
  have hGIC := hFBC R C S hGI
  have hNnil : IsNilpotent (nilradical C) := IsNoetherianRing.isNilpotent_nilradical C
  have hredC' : _root_.IsReduced (C ⧸ nilradical C) :=
    (Ideal.isRadical_iff_quotient_reduced _).mp (Ideal.radical_isRadical ⊥)
  have hGIT := hFBC C (C ⧸ nilradical C) (TensorProduct R C S) hGIC
  have hside : ∀ J : Ideal (C ⧸ nilradical C), J ≠ ⊥ →
      Module.Projective ((C ⧸ nilradical C) ⧸ J) (TensorProduct (C ⧸ nilradical C)
        ((C ⧸ nilradical C) ⧸ J) (TensorProduct C (C ⧸ nilradical C) (TensorProduct R C S))) := by
    intro J hJ
    have hcomp : Function.Surjective
        (fun r : R => Ideal.Quotient.mk (nilradical C) (algebraMap R C r)) :=
      Ideal.Quotient.mk_surjective.comp hsurj
    have hsD : Function.Surjective (algebraMap R ((C ⧸ nilradical C) ⧸ J)) := by
      have e : (algebraMap R ((C ⧸ nilradical C) ⧸ J) : R → (C ⧸ nilradical C) ⧸ J) =
          fun r => Ideal.Quotient.mk J (Ideal.Quotient.mk (nilradical C) (algebraMap R C r)) := rfl
      rw [e]
      exact Ideal.Quotient.mk_surjective.comp hcomp
    have hlt : I < RingHom.ker (algebraMap R ((C ⧸ nilradical C) ⧸ J)) := by
      refine lt_of_le_of_ne ?_ ?_
      · intro r hr
        rw [← hker, RingHom.mem_ker] at hr
        rw [RingHom.mem_ker]
        show Ideal.Quotient.mk J (Ideal.Quotient.mk (nilradical C) (algebraMap R C r)) = 0
        rw [hr, map_zero, map_zero]
      · obtain ⟨x, hxJ, hx0⟩ := (Submodule.ne_bot_iff J).mp hJ
        obtain ⟨r, hr⟩ := hcomp x
        intro heq
        have hrD : r ∈ RingHom.ker (algebraMap R ((C ⧸ nilradical C) ⧸ J)) := by
          rw [RingHom.mem_ker]
          show Ideal.Quotient.mk J (Ideal.Quotient.mk (nilradical C) (algebraMap R C r)) = 0
          have hr' : Ideal.Quotient.mk (nilradical C) (algebraMap R C r) = x := hr
          rw [hr', Ideal.Quotient.eq_zero_iff_mem]
          exact hxJ
        rw [← heq, ← hker, RingHom.mem_ker] at hrD
        apply hx0
        have hr' : Ideal.Quotient.mk (nilradical C) (algebraMap R C r) = x := hr
        rw [← hr', hrD, map_zero]
    have hPD := IH _ hlt ((C ⧸ nilradical C) ⧸ J) hsD rfl
    exact Module.Projective.of_equiv
      (((Algebra.TensorProduct.cancelBaseChange C (C ⧸ nilradical C) ((C ⧸ nilradical C) ⧸ J)
        ((C ⧸ nilradical C) ⧸ J) (TensorProduct R C S)).trans
        (Algebra.TensorProduct.cancelBaseChange R C ((C ⧸ nilradical C) ⧸ J)
          ((C ⧸ nilradical C) ⧸ J) S)).symm.toLinearEquiv)
  have hPT := hRed (C ⧸ nilradical C)
    (TensorProduct C (C ⧸ nilradical C) (TensorProduct R C S)) hGIT hside
  exact hNil C (TensorProduct R C S) (nilradical C) hNnil inferInstance hPT

theorem wcpa_lfg_projective_geom_integral : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.FinitePresentation R S] [Module.Flat R S], (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L], IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) → Module.Projective R S :=
by

  have hspan : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S],
      ∃ s : Set S, s.Countable ∧ Submodule.span R s = ⊤ := by
    intro R S _ _ _ _
    obtain ⟨t, ht⟩ := (inferInstance : Algebra.FiniteType R S).out
    refine ⟨Set.range (fun l : List (t : Set S) => (l.map Subtype.val).prod),
      Set.countable_range _, ?_⟩
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ Subalgebra.toSubmodule (Algebra.adjoin R (t : Set S)) := by
      rw [ht]; trivial
    rw [Algebra.adjoin_eq_span] at hx
    refine Submodule.span_mono ?_ hx
    intro y hy
    obtain ⟨l, hl, rfl⟩ := Submonoid.exists_list_of_mem_closure hy
    refine ⟨l.attach.map (fun z => ⟨z.1, hl z.1 z.2⟩), ?_⟩
    simp [List.map_map, Function.comp_def]

  have hRed : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [IsReduced R] [CommRing S]
      [Algebra R S] [Algebra.FiniteType R S] [Module.Flat R S],
      (∀ (p : Ideal R) [p.IsPrime] (L : Type u) [Field L] [Algebra p.ResidueField L],
        IsDomain (TensorProduct p.ResidueField L (p.Fiber S))) →
      (∀ J : Ideal R, J ≠ ⊥ → Module.Projective (R ⧸ J) (TensorProduct R (R ⧸ J) S)) →
      Module.Projective R S := by
    intro R S _ _ _ _ _ _ _ hGI hJ
    rcases subsingleton_or_nontrivial R with hR | hR
    · haveI : Subsingleton S := Module.subsingleton R S
      haveI : Module.Free R S := Module.Free.of_subsingleton R S
      exact Module.Projective.of_free
    · by_cases hzd : ∃ a b : R, a ≠ 0 ∧ b ≠ 0 ∧ a * b = 0
      · obtain ⟨a, b, ha, hb, hab⟩ := hzd
        apply wcpa_lfg_pgi_split_ideals R S (Ideal.span {a}) (Ideal.span {b})
        · rw [eq_bot_iff]
          intro x hx
          obtain ⟨hxa, hxb⟩ := Submodule.mem_inf.mp hx
          obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hxa
          obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp hxb
          rw [Ideal.mem_bot]
          apply IsReduced.eq_zero
          refine ⟨2, ?_⟩
          calc (r * a) ^ 2 = (r * a) * (s * b) := by rw [pow_two, hs]
            _ = (r * s) * (a * b) := by ring
            _ = 0 := by rw [hab, mul_zero]
        · exact hJ _ (by rw [Ne, Ideal.span_singleton_eq_bot]; exact ha)
        · exact hJ _ (by rw [Ne, Ideal.span_singleton_eq_bot]; exact hb)
      · haveI : NoZeroDivisors R := ⟨fun {a b} h => by
          by_contra hne
          push_neg at hne
          exact hzd ⟨a, b, hne.1, hne.2, h⟩⟩
        haveI : IsDomain R := NoZeroDivisors.to_isDomain R
        obtain ⟨f, hf0, hfree⟩ := wcpa_ffp_generic_free R S S
        haveI := hfree
        have hproj : Module.Projective (Localization.Away f)
            (LocalizedModule (Submonoid.powers f) S) := Module.Projective.of_free
        have hJf := hJ (Ideal.span {f}) (by rw [Ne, Ideal.span_singleton_eq_bot]; exact hf0)
        have hML := wcpa_lfg_pgi_complete_ml R S f hGI hJf
        have hPI := wcpa_lfg_pgi_ml_descent R S f hproj hML
        exact wcpa_lfg_pgi_projective_of_ml R S inferInstance (hspan R S) hPI

  intro R S _ _ _ _ _ hGI
  obtain ⟨R₀, S₀, _, _, _, _, _, _, _, ⟨e⟩⟩ := wcpa_lfg_pgi_flat_approx R S
  obtain ⟨R₁, _, _, _, _, _, hGI₁⟩ := wcpa_lfg_pgi_geom_integral_descent R R₀ S₀ S e hGI
  haveI : IsNoetherianRing R₁ := Algebra.FiniteType.isNoetherianRing ℤ R₁
  haveI hP₁ : Module.Projective R₁ (TensorProduct R₀ R₁ S₀) :=
    wcpa_lfg_pgi_noeth_induction hRed wcpa_lfg_pgi_nilpotent_lift wcpa_lfg_pgi_fibre_base_change
      R₁ (TensorProduct R₀ R₁ S₀) hGI₁
  have hP : Module.Projective R (TensorProduct R₁ R (TensorProduct R₀ R₁ S₀)) :=
    Module.Projective.tensorProduct
  exact Module.Projective.of_equiv
    ((Algebra.TensorProduct.cancelBaseChange R₀ R₁ R R S₀).toLinearEquiv.trans e.toLinearEquiv)

theorem wcpa_ffp_local_fg : ∀ (R : Type u) [CommRing R] [IsDomain R] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)), Module.Flat R (MvPolynomial (Fin n) R ⧸ I) → ∀ (q : Ideal (MvPolynomial (Fin n) R)) [q.IsPrime], (I.map (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q))).FG :=
by

  have s8 : ∀ (A N : Type u) [CommRing A] [AddCommGroup N] [Module A N] (Q : Ideal A) [Q.IsPrime],
      ¬ Module.annihilator A N ≤ Q →
      Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N) := by
    intro A N _ _ _ Q _ hQ
    obtain ⟨s, hsAnn, hsQ⟩ := Set.not_subset.mp hQ
    have h1 : ∀ m : N, s • m = 0 := fun m => Module.mem_annihilator.mp hsAnn m
    haveI : Subsingleton (LocalizedModule Q.primeCompl N) := by
      refine subsingleton_of_forall_eq 0 (fun x => ?_)
      induction x using LocalizedModule.induction_on with
      | h m t =>
        rw [← LocalizedModule.zero_mk t, LocalizedModule.mk_eq]
        refine ⟨⟨s, hsQ⟩, ?_⟩
        rw [Submonoid.smul_def, Submonoid.smul_def, Submonoid.smul_def, smul_zero, smul_zero,
          smul_comm, h1, smul_zero]
    infer_instance

  have ord : ∀ (a b : WithBot ℕ∞) (k : ℕ), a < b → b < ((k + 1 : ℕ) : WithBot ℕ∞) →
      a < (k : WithBot ℕ∞) := by
    intro a b k hab hb
    rw [← WithBot.coe_natCast] at hb
    rw [← WithBot.coe_natCast]
    induction b using WithBot.recBotCoe with
    | bot => exact absurd hab not_lt_bot
    | coe b =>
      have hb2 : b < ((k + 1 : ℕ) : ℕ∞) := WithBot.coe_lt_coe.mp hb
      induction a using WithBot.recBotCoe with
      | bot => exact WithBot.bot_lt_coe _
      | coe a =>
        have hab2 : a < b := WithBot.coe_lt_coe.mp hab
        apply WithBot.coe_lt_coe.mpr
        induction b using ENat.recTopCoe with
        | top => exact absurd hb2 (not_lt.mpr le_top)
        | coe b =>
          induction a using ENat.recTopCoe with
          | top => exact absurd hab2 (not_lt.mpr le_top)
          | coe a =>
            have h1 : b < k + 1 := by exact_mod_cast hb2
            have h2 : a < b := by exact_mod_cast hab2
            exact_mod_cast (by omega : a < k)

  have P : ∀ k : ℕ, ∀ (R A N : Type u) [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A]
      [Algebra.FinitePresentation R A] [AddCommGroup N] [Module A N] [Module R N]
      [IsScalarTower R A N] [Module.Finite A N] (Q : Ideal A) [Q.IsPrime],
      Q.comap (algebraMap R A) = IsLocalRing.maximalIdeal R →
      Module.Flat R (LocalizedModule Q.primeCompl N) →
      ringKrullDim (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ⊔
        Module.annihilator A N)) < (k : WithBot ℕ∞) →
      Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N) := by
    intro k
    induction k with
    | zero =>
      intro R A N _ _ _ _ _ _ _ _ _ _ Q _ hQc hfl hd
      by_cases hann : Module.annihilator A N ≤ Q
      · exfalso
        have hmA : Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ≤ Q :=
          Ideal.map_le_iff_le_comap.mpr hQc.ge
        have hJ : Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ⊔
            Module.annihilator A N ≠ ⊤ := by
          intro htop
          exact (inferInstance : Q.IsPrime).ne_top (top_le_iff.mp (htop ▸ sup_le hmA hann))
        haveI : Nontrivial (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ⊔
            Module.annihilator A N)) := Ideal.Quotient.nontrivial_iff.mpr hJ
        have h0 := ringKrullDim_nonneg_of_nontrivial (R := A ⧸ (Ideal.map (algebraMap R A)
          (IsLocalRing.maximalIdeal R) ⊔ Module.annihilator A N))
        rw [Nat.cast_zero] at hd
        exact absurd hd (not_lt.mpr h0)
      · exact s8 A N Q hann
    | succ k ih =>
      intro R A N _ _ _ _ _ _ _ _ _ _ Q _ hQc hfl hd
      by_cases hann : Module.annihilator A N ≤ Q
      · obtain ⟨R', S, N', _, _, _, _, _, _, _, _, _, _, _, Q', _, hgi, hdom, hQ'c, hfl', hdim,
          htr⟩ := wcpa_lfg_etale_local_structure R A N Q hQc hann hfl
        haveI := wcpa_lfg_projective_geom_integral R' S hgi
        obtain ⟨C, _, _, _, _, _, hflC, hdimC, htrC⟩ :=
          wcpa_lfg_devissage_step R' S N' Q' hdom hgi hQ'c hfl'
        exact htr (htrC (ih R' S C Q' hQ'c hflC (ord _ _ k hdimC (lt_of_le_of_lt hdim hd))))
      · exact s8 A N Q hann

  have hloc : ∀ (R A N : Type u) [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A]
      [Algebra.FinitePresentation R A] [AddCommGroup N] [Module A N] [Module R N]
      [IsScalarTower R A N] [Module.Finite A N] (Q : Ideal A) [Q.IsPrime],
      Q.comap (algebraMap R A) = IsLocalRing.maximalIdeal R →
      Module.Flat R (LocalizedModule Q.primeCompl N) →
      Module.FinitePresentation (Localization.AtPrime Q) (LocalizedModule Q.primeCompl N) := by
    intro R A N _ _ _ _ _ _ _ _ _ _ Q _ hQc hfl
    have hfin := wcpa_lfg_fibre_dim_finite R A
      (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ⊔ Module.annihilator A N)
      le_sup_left
    obtain ⟨k, hk⟩ : ∃ k : ℕ, ringKrullDim (A ⧸ (Ideal.map (algebraMap R A)
        (IsLocalRing.maximalIdeal R) ⊔ Module.annihilator A N)) < (k : WithBot ℕ∞) := by
      generalize ringKrullDim (A ⧸ (Ideal.map (algebraMap R A)
        (IsLocalRing.maximalIdeal R) ⊔ Module.annihilator A N)) = x at hfin ⊢
      induction x using WithBot.recBotCoe with
      | bot => exact ⟨0, by rw [← WithBot.coe_natCast]; exact WithBot.bot_lt_coe _⟩
      | coe e =>
        induction e using ENat.recTopCoe with
        | top => exact absurd hfin (lt_irrefl _)
        | coe e =>
          refine ⟨e + 1, ?_⟩
          rw [← WithBot.coe_natCast]
          exact WithBot.coe_lt_coe.mpr (by exact_mod_cast Nat.lt_succ_self e)
    exact P k R A N Q hQc hfl hk

  intro R _ _ n I hflat q _
  have hgen := wcpa_lfg_localize_base hloc
  apply wcpa_lfg_fp_to_fg _ I q
  exact hgen R (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) R ⧸ I) q
    (wcpa_lfg_localized_flat R _ _ q hflat)

theorem wcpa_ffp_descend_noetherian : (∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] [Module.Finite B M], I ≠ ⊤ → Module.Flat (A ⧸ I) (TensorProduct A (A ⧸ I) M) → Function.Injective (LinearMap.rTensor M (Submodule.subtype I)) → Module.Flat A M) → ∀ (R : Type u) [CommRing R] (n : ℕ) (s : Finset (MvPolynomial (Fin n) R)) (q : Ideal (MvPolynomial (Fin n) R)) [q.IsPrime], Module.Flat R (Localization.AtPrime q ⧸ (Ideal.span (↑s : Set (MvPolynomial (Fin n) R))).map (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q))) → ∃ (R₀ : Type u) (_ : CommRing R₀) (_ : IsNoetherianRing R₀) (_ : Algebra R₀ R) (s₀ : Finset (MvPolynomial (Fin n) R₀)), Ideal.span ((MvPolynomial.map (algebraMap R₀ R)) '' (↑s₀ : Set (MvPolynomial (Fin n) R₀))) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) ∧ Module.Flat R₀ (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R))) ⧸ (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀))).map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R)))))) :=
by
  intro hLC R _ n s q _ hflat
  classical


  have stepA : ∀ (A : Subring R) [IsNoetherianRing A] (SA : Finset (MvPolynomial (Fin n) A)),
      MvPolynomial.map (algebraMap A R) '' (↑SA : Set (MvPolynomial (Fin n) A)) =
        (↑s : Set (MvPolynomial (Fin n) R)) →
      ∃ (r : ℕ) (ν : Fin r → MvPolynomial (Fin n) A),
        Ideal.span (Set.range ν) = Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
          ((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) ∧
        ∀ i, ∃ w ∉ q, w * MvPolynomial.map (algebraMap A R) (ν i) ∈
          (((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) *
            Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
              (MvPolynomial.map (algebraMap A R)) := by
    intro A _ SA hSA
    set pA : Ideal A := (q.comap (MvPolynomial.map (algebraMap A R))).comap
      (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) with hpA
    have hJ : (Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
        (MvPolynomial.map (algebraMap A R)) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) := by
      rw [Ideal.map_span, hSA]
    have hI : (pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
        (MvPolynomial.map (algebraMap A R)) =
        (pA.map (algebraMap A R)).map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) := by
      rw [Ideal.map_map, Ideal.map_map, MvPolynomial.map_comp_C]
    have hIq : (pA.map (algebraMap A R)).map (algebraMap R (Localization.AtPrime q)) =
        ((pA.map (algebraMap A R)).map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R)).map
          (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)) := by
      rw [Ideal.map_map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R), ← MvPolynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_eq]
    have h1 := wcpa_ffp_dn_flat_inter R (Localization.AtPrime q) _ hflat (pA.map (algebraMap A R))
    obtain ⟨r, ν, hν⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
      (IsNoetherian.noetherian (Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
        pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)))
    refine ⟨r, ν, hν, fun i => ?_⟩
    have hνi : ν i ∈ Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
        pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) := by
      rw [← hν]; exact Submodule.subset_span ⟨i, rfl⟩
    have hmemJ : MvPolynomial.map (algebraMap A R) (ν i) ∈
        Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) := by
      rw [← hJ]; exact Ideal.mem_map_of_mem _ (Submodule.mem_inf.mp hνi).1
    have hmemI : MvPolynomial.map (algebraMap A R) (ν i) ∈
        (pA.map (algebraMap A R)).map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) := by
      rw [← hI]; exact Ideal.mem_map_of_mem _ (Submodule.mem_inf.mp hνi).2
    have hx1 : algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)
        (MvPolynomial.map (algebraMap A R) (ν i)) ∈
        (Ideal.span (↑s : Set (MvPolynomial (Fin n) R))).map
          (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)) ⊓
        (pA.map (algebraMap A R)).map (algebraMap R (Localization.AtPrime q)) := by
      refine Submodule.mem_inf.mpr ⟨Ideal.mem_map_of_mem _ hmemJ, ?_⟩
      rw [hIq]; exact Ideal.mem_map_of_mem _ hmemI
    have hx2 := h1 hx1
    rw [hIq, ← Ideal.map_mul] at hx2
    obtain ⟨m, hm, hmx⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff q.primeCompl
      (Localization.AtPrime q) _ _).mp hx2
    refine ⟨m, hm, ?_⟩
    rw [Ideal.map_mul, hI, hJ]
    exact hmx

  have stepB : ∀ (A B : Subring R) (hAB : A ≤ B), IsNoetherianRing B →
      ∀ (SA : Finset (MvPolynomial (Fin n) A)),
      MvPolynomial.map (algebraMap A R) '' (↑SA : Set (MvPolynomial (Fin n) A)) =
        (↑s : Set (MvPolynomial (Fin n) R)) →
      ∀ (r : ℕ) (ν : Fin r → MvPolynomial (Fin n) A),
      Ideal.span (Set.range ν) = Ideal.span (↑SA : Set (MvPolynomial (Fin n) A)) ⊓
          ((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) →
      (∀ i, ∃ w' ∉ q.comap (MvPolynomial.map (algebraMap B R)),
        w' * MvPolynomial.map (Subring.inclusion hAB) (ν i) ∈
          (((q.comap (MvPolynomial.map (algebraMap A R))).comap
            (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)).map
              (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) *
            Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
              (MvPolynomial.map (Subring.inclusion hAB))) →
      ∃ (R₀ : Type u) (_ : CommRing R₀) (_ : IsNoetherianRing R₀) (_ : Algebra R₀ R) (s₀ : Finset (MvPolynomial (Fin n) R₀)), Ideal.span ((MvPolynomial.map (algebraMap R₀ R)) '' (↑s₀ : Set (MvPolynomial (Fin n) R₀))) = Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) ∧ Module.Flat R₀ (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R))) ⧸ (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀))).map (algebraMap (MvPolynomial (Fin n) R₀) (Localization.AtPrime (q.comap (MvPolynomial.map (algebraMap R₀ R)))))) := by
    intro A B hAB hBn SA hSA r ν hν hw'
    haveI := hBn
    have hcomp : (algebraMap B R).comp (Subring.inclusion hAB) = algebraMap A R := by
      ext x; rfl
    choose w' hw'q hw'mem using hw'
    haveI hq₀prime : (q.comap (MvPolynomial.map (algebraMap B R))).IsPrime := inferInstance
    set pA : Ideal A := (q.comap (MvPolynomial.map (algebraMap A R))).comap
      (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) with hpA
    set q₀ : Ideal (MvPolynomial (Fin n) B) := q.comap (MvPolynomial.map (algebraMap B R)) with hq₀
    have hC_notin : ∀ u : A, u ∉ pA → MvPolynomial.C (Subring.inclusion hAB u) ∉ q₀ := by
      intro u hu h
      apply hu
      rw [hpA, Ideal.mem_comap, Ideal.mem_comap, MvPolynomial.map_C]
      rw [hq₀, Ideal.mem_comap, MvPolynomial.map_C] at h
      exact h
    have hW_notin : (∏ i, w' i) ∉ q₀ := by
      intro h
      obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff).mp h
      exact hw'q i hi
    have hJ0 : Ideal.span (↑(SA.image (MvPolynomial.map (Subring.inclusion hAB))) :
          Set (MvPolynomial (Fin n) B)) =
        Ideal.span (MvPolynomial.map (Subring.inclusion hAB) ''
          (↑SA : Set (MvPolynomial (Fin n) A))) := by
      rw [Finset.coe_image]
    have hI0C : (pA.map (Subring.inclusion hAB)).map
          (MvPolynomial.C : B →+* MvPolynomial (Fin n) B) =
        pA.map ((MvPolynomial.C : B →+* MvPolynomial (Fin n) B).comp (Subring.inclusion hAB)) :=
      Ideal.map_map _ _
    have h𝔞 : ((pA.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)) *
          Ideal.span (↑SA : Set (MvPolynomial (Fin n) A))).map
            (MvPolynomial.map (Subring.inclusion hAB)) =
        pA.map ((MvPolynomial.C : B →+* MvPolynomial (Fin n) B).comp (Subring.inclusion hAB)) *
          Ideal.span (MvPolynomial.map (Subring.inclusion hAB) ''
            (↑SA : Set (MvPolynomial (Fin n) A))) := by
      rw [Ideal.map_mul, Ideal.map_map, MvPolynomial.map_comp_C, Ideal.map_span]
    have hgen : ∀ z ∈ Ideal.span (MvPolynomial.map (Subring.inclusion hAB) '' Set.range ν),
        (∏ i, w' i) * z ∈
          pA.map ((MvPolynomial.C : B →+* MvPolynomial (Fin n) B).comp (Subring.inclusion hAB)) *
            Ideal.span (MvPolynomial.map (Subring.inclusion hAB) ''
              (↑SA : Set (MvPolynomial (Fin n) A))) := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨_, ⟨i, rfl⟩, rfl⟩ := hx
        rw [← Finset.prod_erase_mul Finset.univ w' (Finset.mem_univ i), mul_assoc]
        refine Ideal.mul_mem_left _ _ ?_
        rw [← h𝔞]
        exact hw'mem i
      | zero => rw [mul_zero]; exact Ideal.zero_mem _
      | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
      | smul a x _ hx =>
        rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hx
    refine ⟨B, inferInstance, hBn, inferInstance,
      SA.image (MvPolynomial.map (Subring.inclusion hAB)), ?_, ?_⟩
    · have himg : MvPolynomial.map (algebraMap B R) ''
            (↑(SA.image (MvPolynomial.map (Subring.inclusion hAB))) :
              Set (MvPolynomial (Fin n) B)) = (↑s : Set (MvPolynomial (Fin n) R)) := by
        rw [Finset.coe_image, Set.image_image, ← hSA]
        apply Set.image_congr
        intro a _
        rw [MvPolynomial.map_map, hcomp]
      rw [himg]
    · refine wcpa_ffp_dn_noeth_crit hLC B n q₀ _ (pA.map (Subring.inclusion hAB)) ?_ ?_ ?_
      ·
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, Ideal.mem_comap, hq₀, Ideal.mem_comap, MvPolynomial.map_C]
        rw [hpA, Ideal.mem_comap, Ideal.mem_comap, MvPolynomial.map_C] at ha
        exact ha
      ·
        intro k hk
        rw [hJ0, hI0C] at hk
        rw [hJ0, hI0C]
        obtain ⟨u, hu, hku⟩ := wcpa_ffp_dn_tor_basechange A B (Subring.inclusion hAB) n pA
          (↑SA : Set (MvPolynomial (Fin n) A)) k (Submodule.mem_inf.mp hk).1
          (Submodule.mem_inf.mp hk).2
        rw [← hν, Ideal.map_span] at hku
        obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hku
        refine ⟨(∏ i, w' i) * MvPolynomial.C (Subring.inclusion hAB u), fun h => ?_, ?_⟩
        · rcases hq₀prime.mem_or_mem h with h1 | h1
          · exact hW_notin h1
          · exact hC_notin u hu h1
        · rw [mul_assoc, ← hyz, mul_add]
          exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hy) (hgen z hz)
      ·
        intro k hk
        rw [hJ0, hI0C] at hk
        rw [hJ0, hI0C]
        obtain ⟨u, hu, hku⟩ := wcpa_ffp_dn_fibre_inter A B (Subring.inclusion hAB) n pA
          (↑SA : Set (MvPolynomial (Fin n) A))
          (q₀.comap (MvPolynomial.C : B →+* MvPolynomial (Fin n) B)) k
          (Submodule.mem_inf.mp hk).1 (Submodule.mem_inf.mp hk).2
        exact ⟨MvPolynomial.C (Subring.inclusion hAB u), hC_notin u hu, hku⟩

  obtain ⟨F, hFc⟩ : ∃ F : Finset R, ∀ f ∈ s, (f.coeffs : Set R) ⊆ (F : Set R) :=
    ⟨s.biUnion (fun f => f.coeffs), fun f hf c hc =>
      Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨f, hf, Finset.mem_coe.mp hc⟩)⟩
  obtain ⟨SF, hSF⟩ := wcpa_ffp_dn_coeff_lift R n s F hFc
  haveI hFn : IsNoetherianRing (Subring.closure (F : Set R)) :=
    is_noetherian_subring_closure _ F.finite_toSet
  obtain ⟨r, ν, hν, hw⟩ := stepA (Subring.closure (F : Set R)) SF hSF
  obtain ⟨F', hF, hw'⟩ := wcpa_ffp_dn_level_lift R n q F _ r ν hw
  exact stepB _ _ (Subring.closure_mono (Finset.coe_subset.mpr hF))
    (is_noetherian_subring_closure _ F'.finite_toSet) SF hSF r ν hν hw'

theorem wcpa_ffp_open_flat : ∀ (R : Type u) [CommRing R] [IsDomain R] (n : ℕ) (I J : Ideal (MvPolynomial (Fin n) R)), J.FG → J ≤ I → Module.Flat R (MvPolynomial (Fin n) R ⧸ I) → ∀ (q : Ideal (MvPolynomial (Fin n) R)) [q.IsPrime], J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)) = I.map (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q)) → ∃ g ∉ q, Module.Flat R (Localization.Away g ⧸ J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g))) :=
by
  intro R _ _ n I J hJfg _hJI hflat q _ hloc
  classical

  have s1 : ∀ (A : Type u) [CommRing A] [Algebra R A] (K p : Ideal A) [p.IsPrime],
      Module.Flat R (A ⧸ K) →
      Module.Flat R (Localization.AtPrime p ⧸ K.map (algebraMap A (Localization.AtPrime p))) := by
    intro A _ _ K p _ hK
    set S := Localization.AtPrime p
    set K' : Ideal S := K.map (algebraMap A S) with hK'
    have htower : IsScalarTower R (A ⧸ K) (S ⧸ K') := by
      refine IsScalarTower.of_algebraMap_eq' ?_
      ext r
      show algebraMap R (S ⧸ K') r = algebraMap (A ⧸ K) (S ⧸ K') (algebraMap R (A ⧸ K) r)
      have e1 : algebraMap R (A ⧸ K) r = Ideal.Quotient.mk K (algebraMap R A r) := by
        first | exact (Ideal.Quotient.mk_algebraMap K r).symm | rfl | simp
      have e2 : algebraMap R (S ⧸ K') r = Ideal.Quotient.mk K' (algebraMap R S r) := by
        first | exact (Ideal.Quotient.mk_algebraMap K' r).symm | rfl | simp
      rw [e1, e2, Ideal.Quotient.algebraMap_quotient_map_quotient,
        IsScalarTower.algebraMap_apply R A S]
    have hloc' : IsLocalization (p.primeCompl.map (Ideal.Quotient.mk K)) (S ⧸ K') := by
      refine IsLocalization.of_surjective p.primeCompl S
        (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
        (Ideal.Quotient.mk K') Ideal.Quotient.mk_surjective ?_ ?_
      · ext x
        rw [RingHom.comp_apply, RingHom.comp_apply,
          Ideal.Quotient.algebraMap_quotient_map_quotient]
      · rw [Ideal.mk_ker, Ideal.mk_ker]
    have hflat2 : Module.Flat (A ⧸ K) (S ⧸ K') :=
      IsLocalization.flat _ (p.primeCompl.map (Ideal.Quotient.mk K))
    exact Module.Flat.trans R (A ⧸ K) (S ⧸ K')
  have hflatq := s1 (MvPolynomial (Fin n) R) I q hflat
  rw [← hloc] at hflatq
  obtain ⟨s, hs⟩ := hJfg
  have hs' : Ideal.span (↑s : Set (MvPolynomial (Fin n) R)) = J := hs
  subst hs'

  obtain ⟨R₀, _, _, _, s₀, hspan, hflat₀⟩ :=
    wcpa_ffp_descend_noetherian wcpa_ffp_local_criterion R n s q hflatq

  obtain ⟨g₀, hg₀, hflatg₀⟩ :=
    wcpa_ffp_noetherian_open wcpa_ffp_generic_free wcpa_ffp_local_criterion wcpa_ffp_nagata_open
      R₀ n (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀)))
      (q.comap (MvPolynomial.map (algebraMap R₀ R))) hflat₀

  have h7 := wcpa_ffp_flat_base_change R₀ R n (Ideal.span (↑s₀ : Set (MvPolynomial (Fin n) R₀)))
    g₀ hflatg₀
  rw [Ideal.map_span, hspan] at h7
  exact ⟨MvPolynomial.map (algebraMap R₀ R) g₀, fun h => hg₀ (Ideal.mem_comap.mpr h), h7⟩

theorem wcpa_dj_mn_flat_fp : ∀ (S Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (g : Y ⟶ S), Flat g → LocallyOfFiniteType g → LocallyOfFinitePresentation g :=
by

  have s5 : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B) (I : Ideal A),
      (I.map φ).FG → ∃ H : Finset A, (↑H : Set A) ⊆ I ∧
        (Ideal.span (↑H : Set A)).map φ = I.map φ := by
    intro A B _ _ φ I hfg
    classical
    obtain ⟨T, hT⟩ := hfg
    have h1 : (↑T : Set B) ⊆ (Submodule.span B (φ '' (I : Set A)) : Set B) := by
      intro x hx
      have hx' : x ∈ I.map φ := hT ▸ Submodule.subset_span hx
      exact hx'
    obtain ⟨U, hU, hTU⟩ := Submodule.subset_span_finite_of_subset_span h1
    obtain ⟨H, hH, rfl⟩ := Finset.subset_set_image_iff.mp hU
    refine ⟨H, hH, le_antisymm (Ideal.map_mono (Ideal.span_le.mpr hH)) ?_⟩
    rw [← hT, Ideal.map_span]
    apply Submodule.span_le.mpr
    intro x hx
    have hx' := hTU hx
    rw [Finset.coe_image] at hx'
    exact hx'

  have s3 : ∀ (R : Type u) [CommRing R] [IsDomain R] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)),
      ∃ G : Finset (MvPolynomial (Fin n) R), (↑G : Set (MvPolynomial (Fin n) R)) ⊆ I ∧
        ∀ f ∈ I, ∃ r : R, r ≠ 0 ∧
          MvPolynomial.C r * f ∈ Ideal.span (↑G : Set (MvPolynomial (Fin n) R)) := by
    intro R _ _ n I
    letI : Algebra (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) (FractionRing R)) :=
      MvPolynomial.algebraMvPolynomial
    haveI : IsLocalization ((nonZeroDivisors R).map
        (MvPolynomial.C : R →+* MvPolynomial (Fin n) R))
        (MvPolynomial (Fin n) (FractionRing R)) :=
      MvPolynomial.isLocalization (nonZeroDivisors R) (FractionRing R)
    have hinj : Function.Injective
        (algebraMap (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) (FractionRing R))) :=
      MvPolynomial.map_injective _ (IsFractionRing.injective R (FractionRing R))
    obtain ⟨G, hG, hGeq⟩ := s5 _ _
      (algebraMap (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) (FractionRing R))) I
      (IsNoetherian.noetherian _)
    refine ⟨G, hG, fun f hf => ?_⟩
    have hmem : algebraMap _ (MvPolynomial (Fin n) (FractionRing R)) f ∈
        (Ideal.span (↑G : Set (MvPolynomial (Fin n) R))).map
          (algebraMap _ (MvPolynomial (Fin n) (FractionRing R))) := by
      rw [hGeq]; exact Ideal.mem_map_of_mem _ hf
    obtain ⟨⟨⟨x, hx⟩, ⟨m, hm⟩⟩, hxm⟩ :=
      (IsLocalization.mem_map_algebraMap_iff ((nonZeroDivisors R).map
        (MvPolynomial.C : R →+* MvPolynomial (Fin n) R))
        (MvPolynomial (Fin n) (FractionRing R))).mp hmem
    obtain ⟨r, hr, rfl⟩ := Submonoid.mem_map.mp hm
    refine ⟨r, nonZeroDivisors.ne_zero hr, ?_⟩
    have hfx : f * MvPolynomial.C r = x := hinj (by rw [map_mul]; exact hxm)
    rw [mul_comm, hfx]
    exact hx

  have s4 : ∀ (R : Type u) [CommRing R] [IsDomain R] (n : ℕ) (I J : Ideal (MvPolynomial (Fin n) R))
      (g : MvPolynomial (Fin n) R), J ≤ I →
      (∀ f ∈ I, ∃ r : R, r ≠ 0 ∧ MvPolynomial.C r * f ∈ J) →
      Module.Flat R (Localization.Away g ⧸
        J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g))) →
      I.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g)) =
        J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g)) := by
    intro R _ _ n I J g hJI htor hflat
    apply le_antisymm _ (Ideal.map_mono hJI)
    rw [Ideal.map_le_iff_le_comap]
    intro f hf
    obtain ⟨r, hr, hrf⟩ := htor f hf
    rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem]
    have hreg : IsSMulRegular (Localization.Away g ⧸
        J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g))) r :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hr)
    have h1 : algebraMap (MvPolynomial (Fin n) R) (Localization.Away g) (MvPolynomial.C r * f) ∈
        J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g)) :=
      Ideal.mem_map_of_mem _ hrf
    have e : algebraMap (MvPolynomial (Fin n) R) (Localization.Away g) (MvPolynomial.C r * f) =
        r • algebraMap (MvPolynomial (Fin n) R) (Localization.Away g) f := by
      rw [Algebra.smul_def, IsScalarTower.algebraMap_apply R (MvPolynomial (Fin n) R)
        (Localization.Away g), map_mul, MvPolynomial.algebraMap_eq]
    have h3 : r • (Ideal.Quotient.mk (J.map (algebraMap (MvPolynomial (Fin n) R)
        (Localization.Away g))) (algebraMap _ (Localization.Away g) f)) =
        Ideal.Quotient.mk (J.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g)))
          (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g) (MvPolynomial.C r * f)) := by
      rw [e]
      first
      | rfl
      | (rw [← Ideal.Quotient.mk_eq_mk, ← Ideal.Quotient.mk_eq_mk, Submodule.Quotient.mk_smul])
      | exact (Submodule.Quotient.mk_smul _ _ _).symm
    have h0 : r • (Ideal.Quotient.mk (J.map (algebraMap (MvPolynomial (Fin n) R)
        (Localization.Away g))) (algebraMap _ (Localization.Away g) f)) = r • 0 := by
      rw [h3, smul_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr h1
    exact hreg h0

  have s8 : ∀ (R : Type u) [CommRing R] [IsDomain R] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)),
      Module.Flat R (MvPolynomial (Fin n) R ⧸ I) → I.FG := by
    intro R _ _ n I hflat
    classical
    obtain ⟨G, hG, htor⟩ := s3 R n I
    have key : ∀ q : PrimeSpectrum (MvPolynomial (Fin n) R), ∃ g ∉ q.asIdeal,
        (I.map (algebraMap (MvPolynomial (Fin n) R) (Localization.Away g))).FG := by
      intro q
      obtain ⟨H, hH, hHeq⟩ := s5 _ _
        (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime q.asIdeal)) I
        (wcpa_ffp_local_fg R n I hflat q.asIdeal)
      have hJfg : (Ideal.span (↑(G ∪ H) : Set (MvPolynomial (Fin n) R))).FG := ⟨G ∪ H, rfl⟩
      have hJI : Ideal.span (↑(G ∪ H) : Set (MvPolynomial (Fin n) R)) ≤ I := by
        rw [Ideal.span_le, Finset.coe_union]
        exact Set.union_subset hG hH
      have hJloc : (Ideal.span (↑(G ∪ H) : Set (MvPolynomial (Fin n) R))).map
            (algebraMap _ (Localization.AtPrime q.asIdeal)) =
          I.map (algebraMap _ (Localization.AtPrime q.asIdeal)) := by
        apply le_antisymm (Ideal.map_mono hJI)
        rw [← hHeq]
        apply Ideal.map_mono
        apply Ideal.span_mono
        rw [Finset.coe_union]
        exact Set.subset_union_right
      obtain ⟨g, hgq, hgflat⟩ := wcpa_ffp_open_flat R n I _ hJfg hJI hflat q.asIdeal hJloc
      refine ⟨g, hgq, ?_⟩
      have htor' : ∀ f ∈ I, ∃ r : R, r ≠ 0 ∧
          MvPolynomial.C r * f ∈ Ideal.span (↑(G ∪ H) : Set (MvPolynomial (Fin n) R)) := by
        intro f hf
        obtain ⟨r, hr, hrf⟩ := htor f hf
        refine ⟨r, hr, Ideal.span_mono ?_ hrf⟩
        rw [Finset.coe_union]
        exact Set.subset_union_left
      rw [s4 R n I _ g hJI htor' hgflat]
      exact hJfg.map _
    choose gf hgf hfg using key
    apply Ideal.fg_of_localizationSpan (Set.range gf)
    · by_contra hne
      obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
      exact hgf ⟨M, hM.isPrime⟩ (hle (Ideal.subset_span ⟨⟨M, hM.isPrime⟩, rfl⟩))
    · rintro ⟨_, ⟨q, rfl⟩⟩
      exact hfg q

  have s2 : ∀ (R B : Type u) [CommRing R] [IsDomain R] [CommRing B] (f : R →+* B),
      f.FiniteType → f.Flat → f.FinitePresentation := by
    intro R B _ _ _ f hft hfl
    letI := f.toAlgebra
    have hft' : Algebra.FiniteType R B := hft
    have hfl' : Module.Flat R B := hfl
    obtain ⟨n, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft'
    show Algebra.FinitePresentation R B
    refine ⟨n, π, hπ, s8 R n (RingHom.ker π.toRingHom) ?_⟩
    exact Module.Flat.of_linearEquiv (Ideal.quotientKerAlgEquivOfSurjective hπ).toLinearEquiv

  intro S Y _ g hflat hlft
  have hsrc : RingHom.StableUnderCompositionWithLocalizationAwaySource
      @RingHom.FinitePresentation :=
    (RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.finitePresentation_holdsForLocalizationAway).1
  rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation) hsrc]
  intro x
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := g x) (U := ⊤) trivial
  obtain ⟨V, hV, hxV, hVU⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := g ⁻¹ᵁ U) hxU
  refine ⟨⟨U, hU⟩, ⟨V, hV⟩, hxV, hVU, ?_⟩
  have : Nonempty U := ⟨⟨g x, hxU⟩⟩
  have : IsDomain Γ(S, U) := IsIntegral.component_integral (X := S) U
  exact s2 _ _ _ (HasRingHomProperty.appLE (P := @LocallyOfFiniteType) g hlft ⟨U, hU⟩ ⟨V, hV⟩ hVU)
    (HasRingHomProperty.appLE (P := @Flat) g hflat ⟨U, hU⟩ ⟨V, hV⟩ hVU)

theorem wcpa_dj_nc_centre_props : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (Δ : Spec (.of ↥W) ⟶ Z') (x₀ : ↥W), LocallyOfFinitePresentation u' → IsSeparated u' → Δ ≫ u' = 𝟙 _ → x₀ ≠ 0 → x₀ ∈ IsLocalRing.maximalIdeal ↥W → (∀ U : Z'.affineOpens, ((Scheme.Hom.ker Δ ⊔ wcNcPrincipal (.of ↥W) Z' u' x₀).ideal U).FG) ∧ (∀ z : ↥Z', z ∈ ((Scheme.Hom.ker Δ ⊔ wcNcPrincipal (.of ↥W) Z' u' x₀).support : Set Z') → z = Δ (IsLocalRing.closedPoint ↥W)) ∧ wcCsdInvPull (Scheme.Hom.ker Δ ⊔ wcNcPrincipal (.of ↥W) Z' u' x₀) Δ :=
by
  intro Ω _ W hW Z' u' Δ x₀ hlfp hsep hΔ hx0 _hx0m
  haveI := hlfp
  haveI := hsep
  haveI : IsClosedImmersion (Δ ≫ u') := by rw [hΔ]; infer_instance
  haveI : IsClosedImmersion Δ := IsClosedImmersion.of_comp Δ u'
  haveI : LocallyOfFinitePresentation (Δ ≫ u') := by rw [hΔ]; infer_instance
  have hsup : ∀ U : Z'.affineOpens, (Scheme.Hom.ker Δ ⊔ wcNcPrincipal (.of ↥W) Z' u' x₀).ideal U =
      (Scheme.Hom.ker Δ).ideal U ⊔ (wcNcPrincipal (.of ↥W) Z' u' x₀).ideal U := by
    intro U
    rw [Scheme.IdealSheafData.ideal_sup]
    rfl
  set x' : Γ(Spec (.of ↥W), ⊤) := (Scheme.ΓSpecIso (.of ↥W)).inv.hom x₀ with hx'
  set g : Γ(Z', ⊤) := u'.appTop.hom x' with hg
  refine ⟨?_, ?_, ?_⟩
  ·
    intro U
    rw [hsup]
    refine Submodule.FG.sup ?_ ?_
    · rw [Scheme.Hom.ker_apply]
      have hV : IsAffineOpen (Δ ⁻¹ᵁ U.1) := U.2.preimage Δ
      have e₁ : U.1 ≤ u' ⁻¹ᵁ ⊤ := by simp
      have e₂ : Δ ⁻¹ᵁ U.1 ≤ (Δ ≫ u') ⁻¹ᵁ ⊤ := by simp
      have hf : (u'.appLE ⊤ U.1 e₁).hom.FinitePresentation :=
        HasRingHomProperty.appLE @LocallyOfFinitePresentation u' inferInstance
          ⟨⊤, isAffineOpen_top _⟩ U e₁
      have hfg0 : ((Δ ≫ u').appLE ⊤ (Δ ⁻¹ᵁ U.1) e₂).hom.FinitePresentation :=
        HasRingHomProperty.appLE @LocallyOfFinitePresentation (Δ ≫ u') inferInstance
          ⟨⊤, isAffineOpen_top _⟩ ⟨_, hV⟩ e₂
      have hcomp : u'.appLE ⊤ U.1 e₁ ≫ Δ.app U.1 = (Δ ≫ u').appLE ⊤ (Δ ⁻¹ᵁ U.1) e₂ := by
        rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
      have hfg : (u'.appLE ⊤ U.1 e₁ ≫ Δ.app U.1).hom.FinitePresentation := by
        rw [hcomp]; exact hfg0
      have hsurj : Function.Surjective (Δ.app U.1).hom := Scheme.Hom.app_surjective Δ U.1 U.2
      letI : Algebra Γ(Spec (.of ↥W), ⊤) Γ(Z', U.1) := (u'.appLE ⊤ U.1 e₁).hom.toAlgebra
      letI : Algebra Γ(Spec (.of ↥W), ⊤) Γ(Spec (.of ↥W), Δ ⁻¹ᵁ U.1) :=
        (u'.appLE ⊤ U.1 e₁ ≫ Δ.app U.1).hom.toAlgebra
      haveI : Algebra.FinitePresentation Γ(Spec (.of ↥W), ⊤) Γ(Z', U.1) := hf
      haveI : Algebra.FinitePresentation Γ(Spec (.of ↥W), ⊤) Γ(Spec (.of ↥W), Δ ⁻¹ᵁ U.1) := hfg
      let φ : Γ(Z', U.1) →ₐ[Γ(Spec (.of ↥W), ⊤)] Γ(Spec (.of ↥W), Δ ⁻¹ᵁ U.1) :=
        { (Δ.app U.1).hom with commutes' := fun r => rfl }
      exact Algebra.FinitePresentation.ker_fG_of_surjective φ hsurj
    · rw [wcNcPrincipal, Scheme.IdealSheafData.ofIdealTop_ideal]
      exact Ideal.FG.map (Submodule.fg_span (Set.toFinite _)) _
  ·
    intro z hz
    rw [Scheme.IdealSheafData.support_sup, TopologicalSpace.Closeds.coe_inf] at hz
    obtain ⟨hz1, hz2⟩ := hz
    rw [Scheme.Hom.support_ker, Δ.isClosedEmbedding.isClosed_range.closure_eq] at hz1
    obtain ⟨p, rfl⟩ := hz1
    rw [wcNcPrincipal, Scheme.IdealSheafData.coe_support_ofIdealTop, Scheme.zeroLocus_span,
      Scheme.zeroLocus_singleton] at hz2
    have hbo : Z'.basicOpen g = u' ⁻¹ᵁ (Spec (.of ↥W)).basicOpen x' :=
      (Scheme.Hom.preimage_basicOpen u' x').symm
    have hz3 : Δ p ∉ u' ⁻¹ᵁ (Spec (.of ↥W)).basicOpen x' := by
      rw [← hbo]; exact hz2
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hΔ, hx', basicOpen_eq_of_affine] at hz3
    have hp : x₀ ∈ p.asIdeal := by
      by_contra hc
      exact hz3 ((PrimeSpectrum.mem_basicOpen _ _).mpr hc)
    have hne : p.asIdeal ≠ ⊥ := by
      intro h0
      rw [h0] at hp
      exact hx0 ((Submodule.mem_bot _).mp hp)
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hmax : p.asIdeal.IsMaximal :=
      Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance p.asIdeal hne p.isPrime
    have hpc : p = IsLocalRing.closedPoint ↥W :=
      PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
    rw [hpc]
  ·
    intro p
    obtain ⟨U₀, hU₀, hpU₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : Z'.Opens)) (x := Δ p) trivial
    have hpD : p ∈ Δ ⁻¹ᵁ U₀ := hpU₀
    obtain ⟨V₀, hV₀, hpV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset hpD
    have hVU : V₀ ≤ Δ ⁻¹ᵁ U₀ := hV₀sub
    set a : Γ(Z', U₀) := (Z'.presheaf.map (homOfLE (le_top : U₀ ≤ ⊤)).op).hom g with ha
    have hφa : (Δ.appLE U₀ V₀ hVU).hom a =
        ((Spec (.of ↥W)).presheaf.map (homOfLE (le_top : V₀ ≤ ⊤)).op).hom x' := by
      have h1 : (Δ.appLE U₀ V₀ hVU).hom a =
          (Δ.appLE ⊤ V₀ (hVU.trans (Δ.preimage_mono le_top))).hom g := by
        rw [ha, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
      have h2 : Δ.appTop.hom g = x' := by
        rw [hg, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, hΔ, Scheme.Hom.id_appTop]
        rfl
      rw [h1, ← h2]
      rfl
    haveI : Nonempty V₀ := ⟨⟨p, hpV₀⟩⟩
    haveI : IsDomain Γ(Spec (.of ↥W), V₀) := IsIntegral.component_integral V₀
    have hx'0 : x' ≠ 0 := by
      intro h0
      apply hx0
      have := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom h0
      simpa [hx'] using this
    refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, hpV₀, ?_, ?_, ?_⟩
    · rw [hsup]
      apply Ideal.mem_sup_right
      rw [wcNcPrincipal, Scheme.IdealSheafData.ofIdealTop_ideal]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self g)
    · apply mem_nonZeroDivisors_of_ne_zero
      rw [hφa]
      intro h0
      apply hx'0
      apply map_injective_of_isIntegral (Spec (.of ↥W)) (homOfLE (le_top : V₀ ≤ ⊤))
      rw [h0, map_zero]
    · rw [hsup, Ideal.map_sup]
      have hker : Ideal.map (Δ.appLE U₀ V₀ hVU).hom ((Scheme.Hom.ker Δ).ideal ⟨U₀, hU₀⟩) = ⊥ := by
        rw [Ideal.map_eq_bot_iff_le_ker]
        refine (Scheme.Hom.ideal_ker_le Δ ⟨U₀, hU₀⟩).trans ?_
        intro y hy
        rw [RingHom.mem_ker] at hy ⊢
        have e : Δ.appLE U₀ V₀ hVU = Δ.app U₀ ≫ (Spec (.of ↥W)).presheaf.map (homOfLE hVU).op := rfl
        rw [e, CommRingCat.comp_apply, hy, map_zero]
      have hprin : Ideal.map (Δ.appLE U₀ V₀ hVU).hom
          ((wcNcPrincipal (.of ↥W) Z' u' x₀).ideal ⟨U₀, hU₀⟩) =
          Ideal.span {(Δ.appLE U₀ V₀ hVU).hom a} := by
        rw [wcNcPrincipal, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_map, Ideal.map_span,
          Set.image_singleton]
        rfl
      rw [hker, hprin, bot_sup_eq]

theorem wcpa_dj_nc_blowup_flat_basechange : ∀ (X X' U : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (f : U ⟶ X), Flat f → wcCsdIsBlowup I r → wcCsdIsBlowup (I.comap f) (Limits.pullback.snd r f) :=
by

  have comapIdeal : ∀ (X Y : Scheme.{u}) (J : Y.IdealSheafData) (π : X ⟶ Y) (U : Y.affineOpens)
      (W : X.affineOpens) (e : W.1 ≤ π ⁻¹ᵁ U.1),
      (J.comap π).ideal W = Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) := by
    intro X Y J π U W e
    rw [Scheme.IdealSheafData.comap, Scheme.Hom.ker_apply]
    apply le_antisymm
    · have hW : IsAffineOpen W.1 := W.2
      have hU : IsAffineOpen U.1 := U.2
      set IB := Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) with hIB
      have H : J.ideal U ≤ Ideal.comap (π.appLE U.1 W.1 e).hom IB := Ideal.le_comap_map
      let ψ : (Γ(Y, U.1) ⧸ J.ideal U) →+* (Γ(X, W.1) ⧸ IB) :=
        Ideal.quotientMap IB (π.appLE U.1 W.1 e).hom H
      let t : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X :=
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec
      let g : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ J.subscheme :=
        Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U
      have hw : t ≫ π = g ≫ J.subschemeι := by
        show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ≫ π =
          (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι
        have hc := J.subschemeCover_map_subschemeι U
        rw [J.glueDataObjι_ι U] at hc
        have hg : (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι =
            Spec.map (CommRingCat.ofHom ψ) ≫
              (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (J.ideal U))) ≫ hU.fromSpec) :=
          (Category.assoc _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ) ≫ ·) hc)
        rw [hg, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec π hU hW e]
        rw [← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        congr 2
      let l := Limits.pullback.lift t g hw
      have hl : l ≫ Limits.pullback.fst π J.subschemeι = t := Limits.pullback.lift_fst _ _ _
      intro b hb
      rw [RingHom.mem_ker] at hb
      have e0 : ⊤ ≤ t ⁻¹ᵁ W.1 := by
        intro p _
        show hW.fromSpec ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) p) ∈ (W.1 : Set X)
        rw [← hW.range_fromSpec]
        exact ⟨_, rfl⟩
      have h1 : ∀ (e : ⊤ ≤ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ⁻¹ᵁ W.1),
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec).appLE W.1 ⊤ e =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        have hb : ∀ (e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1),
            hW.fromSpec.appLE W.1 ⊤ e₁ = (Scheme.ΓSpecIso Γ(X, W.1)).inv := by
          intro e₁
          rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
          have hid : ∀ (f : Opposite.op (⊤ : (Spec Γ(X, W.1)).Opens) ⟶ Opposite.op ⊤),
              (Spec Γ(X, W.1)).presheaf.map f = 𝟙 _ := by
            intro f
            rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
              CategoryTheory.Functor.map_id]
          rw [hid, Category.comp_id]
        intro e
        have e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1 :=
          hW.fromSpec_preimage_self.ge
        have e₂ : (⊤ : (Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB))).Opens) ≤
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) ⁻¹ᵁ ⊤ := le_top
        rw [← Scheme.Hom.appLE_comp_appLE _ hW.fromSpec W.1 ⊤ ⊤ e₁ e₂, hb e₁]
        have happ : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appLE ⊤ ⊤ e₂ =
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appTop :=
          Scheme.Hom.appLE_eq_app _
        rw [happ, ← Scheme.ΓSpecIso_inv_naturality]
      have key : ∀ (s : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X) (hs : s = t)
          (e1 : ⊤ ≤ s ⁻¹ᵁ W.1), s.appLE W.1 ⊤ e1 =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        rintro s rfl e1
        exact h1 e1
      have e2 : ⊤ ≤ (l ≫ Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 := by
        rw [hl]; exact e0
      have h2 := key _ hl e2
      rw [Scheme.Hom.comp_appLE] at h2
      have h3 := congrArg (fun f => f.hom b) h2
      simp only [CommRingCat.comp_apply, hb, map_zero] at h3
      have h4 := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, W.1) ⧸ IB))).hom.hom h3
      simp only [map_zero, Iso.inv_hom_id_apply] at h4
      exact (Ideal.Quotient.eq_zero_iff_mem).mp h4.symm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have hP := Limits.pullback.condition (f := π) (g := J.subschemeι)
      have key : ∀ (s : Limits.pullback π J.subschemeι ⟶ Y)
          (hs : Limits.pullback.fst π J.subschemeι ≫ π = s)
          (e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤ s ⁻¹ᵁ U.1),
          ((Limits.pullback.fst π J.subschemeι).app W.1).hom ((π.appLE U.1 W.1 e).hom a) =
            (s.appLE U.1 _ e1).hom a := by
        rintro s rfl e1
        rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
      have e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤
          (Limits.pullback.snd π J.subschemeι ≫ J.subschemeι) ⁻¹ᵁ U.1 := by
        rw [← hP]; intro x hx; exact e hx
      rw [key _ hP e1, Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
      have h0 : (J.subschemeι.app U.1).hom a = 0 := by
        rw [← RingHom.mem_ker, Scheme.IdealSheafData.ker_subschemeι_app]; exact ha
      rw [h0, map_zero]

  have nzdRes : ∀ (T : Scheme.{u}) (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W →
      ∀ b : Γ(T, W), b ∈ nonZeroDivisors Γ(T, W) →
      T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro T W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (T.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
      haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
      exact hnz
    show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst
  intro X X' U I r f hf hr

  have locGen : ∀ (T : Scheme.{u}) (h : T ⟶ X) (t : T) (U₀ : X.affineOpens) (V : T.affineOpens)
      (hVU : V.1 ≤ h ⁻¹ᵁ U₀.1) (c : Γ(T, V.1)), t ∈ V.1 → c ∈ nonZeroDivisors Γ(T, V.1) →
      Ideal.map (h.appLE U₀.1 V.1 hVU).hom (I.ideal U₀) = Ideal.span {c} →
      ∃ (V' : T.affineOpens) (hV'U : V'.1 ≤ h ⁻¹ᵁ U₀.1) (a : Γ(X, U₀.1)), t ∈ V'.1 ∧
        a ∈ I.ideal U₀ ∧ (h.appLE U₀.1 V'.1 hV'U).hom a ∈ nonZeroDivisors Γ(T, V'.1) ∧
        Ideal.map (h.appLE U₀.1 V'.1 hV'U).hom (I.ideal U₀) =
          Ideal.span {(h.appLE U₀.1 V'.1 hV'U).hom a} := by
    intro T h t U₀ V hVU c htV hc hI
    let M : Ideal Γ(T, V.1) := Ideal.comap (T.presheaf.germ V.1 t htV).hom
      (IsLocalRing.maximalIdeal (T.presheaf.stalk t))
    have hM1 : (1 : Γ(T, V.1)) ∉ M := by
      intro h1
      have h1' : (T.presheaf.germ V.1 t htV).hom 1 ∈ IsLocalRing.maximalIdeal _ := h1
      rw [map_one] at h1'
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h1')
    have hex : ∃ a ∈ I.ideal U₀, (h.appLE U₀.1 V.1 hVU).hom a ∉ Ideal.span {c} * M := by
      by_contra hne
      push_neg at hne
      have hle : Ideal.map (h.appLE U₀.1 V.1 hVU).hom (I.ideal U₀) ≤ Ideal.span {c} * M :=
        Ideal.map_le_iff_le_comap.mpr (fun a ha => hne a ha)
      have hcmem : c ∈ Ideal.span {c} * M := hle (hI ▸ Ideal.mem_span_singleton_self c)
      obtain ⟨z, hzM, hz⟩ := Ideal.mem_span_singleton_mul.mp hcmem
      have h1 : (1 - z) * c = 0 := by rw [sub_mul, one_mul, mul_comm, hz, sub_self]
      have h2 : 1 - z = 0 := mem_nonZeroDivisors_iff_right.mp hc _ h1
      have hz1 : z = 1 := (sub_eq_zero.mp h2).symm
      exact hM1 (hz1 ▸ hzM)
    obtain ⟨a, haI, hanot⟩ := hex
    have hψa : (h.appLE U₀.1 V.1 hVU).hom a ∈ Ideal.span {c} :=
      hI ▸ Ideal.mem_map_of_mem (h.appLE U₀.1 V.1 hVU).hom haI
    obtain ⟨μ, hμ⟩ := Ideal.mem_span_singleton'.mp hψa
    have hμu : IsUnit ((T.presheaf.germ V.1 t htV).hom μ) := by
      by_contra hnu
      apply hanot
      rw [Ideal.mem_span_singleton_mul]
      exact ⟨μ, (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu),
        by rw [mul_comm, hμ]⟩
    have hDV : T.basicOpen μ ≤ V.1 := T.basicOpen_le μ
    have htD : t ∈ T.basicOpen μ := (T.mem_basicOpen μ t htV).mpr hμu
    have hDU : T.basicOpen μ ≤ h ⁻¹ᵁ U₀.1 := hDV.trans hVU
    have hcomp : h.appLE U₀.1 (T.basicOpen μ) hDU =
        h.appLE U₀.1 V.1 hVU ≫ T.presheaf.map (homOfLE hDV).op :=
      (Scheme.Hom.appLE_map h hVU (homOfLE hDV).op).symm
    have hu : IsUnit ((T.presheaf.map (homOfLE hDV).op).hom μ) :=
      RingedSpace.isUnit_res_basicOpen T.toRingedSpace μ
    have hρc := nzdRes T V.1 (T.basicOpen μ) hDV V.2 c hc
    have hval : (h.appLE U₀.1 (T.basicOpen μ) hDU).hom a =
        (T.presheaf.map (homOfLE hDV).op).hom μ * (T.presheaf.map (homOfLE hDV).op).hom c := by
      rw [hcomp, CommRingCat.comp_apply, ← hμ, map_mul]
    refine ⟨⟨T.basicOpen μ, V.2.basicOpen μ⟩, hDU, a, htD, haI, ?_, ?_⟩
    · show (h.appLE U₀.1 (T.basicOpen μ) hDU).hom a ∈ nonZeroDivisors Γ(T, T.basicOpen μ)
      rw [hval]
      exact (nonZeroDivisors _).mul_mem hu.mem_nonZeroDivisors hρc
    · show Ideal.map (h.appLE U₀.1 (T.basicOpen μ) hDU).hom (I.ideal U₀) =
        Ideal.span {(h.appLE U₀.1 (T.basicOpen μ) hDU).hom a}
      rw [hval, Ideal.span_singleton_mul_left_unit hu, hcomp, CommRingCat.hom_comp,
        ← Ideal.map_map, hI, Ideal.map_span, Set.image_singleton]

  have comapIff : ∀ (T : Scheme.{u}) (h : T ⟶ U),
      wcCsdInvPull (I.comap f) h ↔ wcCsdInvPull I (h ≫ f) := by
    intro T h
    constructor
    · intro H t
      obtain ⟨U₁, V, hVU, b, htV, hbJ, hnz, hmap⟩ := H t
      obtain ⟨U₀, hU₀, hftU₀, -⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := f (h t)) trivial
      have hhtU : h t ∈ U₁.1 ⊓ f ⁻¹ᵁ U₀ := ⟨hVU htV, hftU₀⟩
      obtain ⟨U₁', hU₁', hhtU₁', hU₁'sub⟩ := exists_isAffineOpen_mem_and_subset hhtU
      have hU₁'U₁ : U₁' ≤ U₁.1 := fun x hx => (hU₁'sub hx).1
      have hU₁'f : U₁' ≤ f ⁻¹ᵁ U₀ := fun x hx => (hU₁'sub hx).2
      have htVU : t ∈ V.1 ⊓ h ⁻¹ᵁ U₁' := ⟨htV, hhtU₁'⟩
      obtain ⟨V', hV', htV', hV'sub⟩ := exists_isAffineOpen_mem_and_subset htVU
      have hV'V : V' ≤ V.1 := fun x hx => (hV'sub hx).1
      have hV'U₁' : V' ≤ h ⁻¹ᵁ U₁' := fun x hx => (hV'sub hx).2
      have e : V' ≤ (h ≫ f) ⁻¹ᵁ U₀ := fun x hx => hU₁'f (hV'U₁' hx)
      have hc : (T.presheaf.map (homOfLE hV'V).op).hom ((h.appLE U₁.1 V.1 hVU).hom b) ∈
          nonZeroDivisors Γ(T, V') := nzdRes T V.1 V' hV'V V.2 _ hnz
      have hA : Ideal.map (h.appLE U₁' V' hV'U₁').hom ((I.comap f).ideal ⟨U₁', hU₁'⟩) =
          Ideal.span {(T.presheaf.map (homOfLE hV'V).op).hom ((h.appLE U₁.1 V.1 hVU).hom b)} := by
        rw [← (I.comap f).map_ideal (show (⟨U₁', hU₁'⟩ : U.affineOpens) ≤ U₁ from hU₁'U₁),
          Ideal.map_map, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE,
          ← Scheme.Hom.appLE_map h hVU (homOfLE hV'V).op, CommRingCat.hom_comp, ← Ideal.map_map,
          hmap, Ideal.map_span, Set.image_singleton]
      have hB : Ideal.map (h.appLE U₁' V' hV'U₁').hom ((I.comap f).ideal ⟨U₁', hU₁'⟩) =
          Ideal.map ((h ≫ f).appLE U₀ V' e).hom (I.ideal ⟨U₀, hU₀⟩) := by
        rw [comapIdeal U X I f ⟨U₀, hU₀⟩ ⟨U₁', hU₁'⟩ hU₁'f, Ideal.map_map, ← CommRingCat.hom_comp,
          Scheme.Hom.appLE_comp_appLE]
      obtain ⟨V'', hV''U, a, htV'', haI, hnz'', hmap''⟩ :=
        locGen T (h ≫ f) t ⟨U₀, hU₀⟩ ⟨V', hV'⟩ e _ htV' hc (hB.symm.trans hA)
      exact ⟨⟨U₀, hU₀⟩, V'', hV''U, a, htV'', haI, hnz'', hmap''⟩
    · intro H t
      obtain ⟨U₀, V, hVU, a, htV, haI, hnz, hmap⟩ := H t
      have hx : h t ∈ f ⁻¹ᵁ U₀.1 := hVU htV
      obtain ⟨U₁, hU₁, hhtU₁, hU₁sub⟩ := exists_isAffineOpen_mem_and_subset hx
      have hU₁le : U₁ ≤ f ⁻¹ᵁ U₀.1 := hU₁sub
      have htVU : t ∈ V.1 ⊓ h ⁻¹ᵁ U₁ := ⟨htV, hhtU₁⟩
      obtain ⟨V', hV', htV', hV'sub⟩ := exists_isAffineOpen_mem_and_subset htVU
      have hV'V : V' ≤ V.1 := fun x hx => (hV'sub hx).1
      have hV'U₁ : V' ≤ h ⁻¹ᵁ U₁ := fun x hx => (hV'sub hx).2
      have hkey : ∀ x, (h.appLE U₁ V' hV'U₁).hom ((f.appLE U₀.1 U₁ hU₁le).hom x) =
          (T.presheaf.map (homOfLE hV'V).op).hom (((h ≫ f).appLE U₀.1 V.1 hVU).hom x) := by
        intro x
        rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE, ← CommRingCat.comp_apply,
          Scheme.Hom.appLE_map]
      have hfun : (h.appLE U₁ V' hV'U₁).hom.comp (f.appLE U₀.1 U₁ hU₁le).hom =
          (T.presheaf.map (homOfLE hV'V).op).hom.comp ((h ≫ f).appLE U₀.1 V.1 hVU).hom :=
        RingHom.ext hkey
      refine ⟨⟨U₁, hU₁⟩, ⟨V', hV'⟩, hV'U₁, (f.appLE U₀.1 U₁ hU₁le).hom a, htV', ?_, ?_, ?_⟩
      · rw [comapIdeal U X I f U₀ ⟨U₁, hU₁⟩ hU₁le]
        exact Ideal.mem_map_of_mem _ haI
      · show (h.appLE U₁ V' hV'U₁).hom ((f.appLE U₀.1 U₁ hU₁le).hom a) ∈ nonZeroDivisors Γ(T, V')
        rw [hkey]
        exact nzdRes T V.1 V' hV'V V.2 _ hnz
      · show Ideal.map (h.appLE U₁ V' hV'U₁).hom ((I.comap f).ideal ⟨U₁, hU₁⟩) =
          Ideal.span {(h.appLE U₁ V' hV'U₁).hom ((f.appLE U₀.1 U₁ hU₁le).hom a)}
        rw [comapIdeal U X I f U₀ ⟨U₁, hU₁⟩ hU₁le, Ideal.map_map, hfun, ← Ideal.map_map, hmap,
          Ideal.map_span, Set.image_singleton, hkey]

  have flatComp : ∀ (P : Scheme.{u}) (g : P ⟶ X'), Flat g → wcCsdInvPull I r →
      wcCsdInvPull I (g ≫ r) := by
    intro P g hg H p
    obtain ⟨U₀, V, hVU, a, hgV, haI, hnz, hmap⟩ := H (g p)
    have hpV : p ∈ g ⁻¹ᵁ V.1 := hgV
    obtain ⟨V', hV', hpV', hV'sub⟩ := exists_isAffineOpen_mem_and_subset hpV
    have hV'g : V' ≤ g ⁻¹ᵁ V.1 := hV'sub
    have e : V' ≤ (g ≫ r) ⁻¹ᵁ U₀.1 := fun x hx => hVU (hV'g hx)
    have hcomp : r.appLE U₀.1 V.1 hVU ≫ g.appLE V.1 V' hV'g = (g ≫ r).appLE U₀.1 V' e :=
      Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
    refine ⟨U₀, ⟨V', hV'⟩, e, a, hpV', haI, ?_, ?_⟩
    · show ((g ≫ r).appLE U₀.1 V' e).hom a ∈ nonZeroDivisors Γ(P, V')
      rw [← hcomp, CommRingCat.comp_apply]
      haveI := hg
      have hfl : (g.appLE V.1 V' hV'g).hom.Flat := Flat.flat_appLE g V.2 hV' hV'g
      letI := (g.appLE V.1 V' hV'g).hom.toAlgebra
      haveI : Module.Flat Γ(X', V.1) Γ(P, V') := hfl
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Γ(P, V')) hnz
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      apply hreg
      change ((r.appLE U₀.1 V.1 hVU).hom a) • x = ((r.appLE U₀.1 V.1 hVU).hom a) • (0 : Γ(P, V'))
      rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_comm, hx]
    · show Ideal.map ((g ≫ r).appLE U₀.1 V' e).hom (I.ideal U₀) =
        Ideal.span {((g ≫ r).appLE U₀.1 V' e).hom a}
      rw [← hcomp, CommRingCat.hom_comp, ← Ideal.map_map, hmap, Ideal.map_span,
        Set.image_singleton]
      rfl

  haveI : Flat f := hf
  refine ⟨?_, ?_⟩
  · apply (comapIff _ _).mpr
    rw [← Limits.pullback.condition]
    exact flatComp _ _ inferInstance hr.1
  · intro T h hh
    obtain ⟨h', hh', huniq⟩ := hr.2 T (h ≫ f) ((comapIff T h).mp hh)
    refine ⟨Limits.pullback.lift h' h hh', Limits.pullback.lift_snd _ _ _, ?_⟩
    intro k hk
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]
      apply huniq
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hk]
    · rw [Limits.pullback.lift_snd]
      exact hk

theorem wcpa_dj_nc_lfp_ring_ft_descend : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] (f : A →+* B) (k : B →+* C), k.Etale → Function.Surjective (PrimeSpectrum.comap k) → (k.comp f).FiniteType → f.FiniteType :=
by
  intro A B C _ _ _ f k hk hsurj hft
  classical

  have s2 : ∀ (R S T C : Type u) [CommRing R] [CommRing S] [CommRing T] [CommRing C] [Algebra R S]
      [Algebra R T] [Algebra S C] (e : C ≃ₐ[S] TensorProduct R S T)
      (hs : Function.Surjective (PrimeSpectrum.comap (algebraMap S C))) (P : PrimeSpectrum S),
      PrimeSpectrum.comap (algebraMap R S) P ∈ Set.range (PrimeSpectrum.comap (algebraMap R T)) := by
    intro R S T C _ _ _ _ _ _ _ e hs P
    obtain ⟨Q, hQ⟩ := hs P
    refine ⟨PrimeSpectrum.comap
      ((Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T) : T →+* TensorProduct R S T)
      (PrimeSpectrum.comap (e.symm : TensorProduct R S T →+* C) Q), ?_⟩
    ext r
    rw [← hQ]
    simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    have h1 : ((Algebra.TensorProduct.includeRight : T →ₐ[R] TensorProduct R S T) : T →+* _)
        (algebraMap R T r) = algebraMap S (TensorProduct R S T) (algebraMap R S r) := by
      simp only [AlgHom.coe_toRingHom, Algebra.TensorProduct.includeRight_apply,
        Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.tmul_one_eq_one_tmul]
    rw [h1]
    have h2 : (e.symm : TensorProduct R S T →+* C)
        (algebraMap S (TensorProduct R S T) (algebraMap R S r))
        = algebraMap S C (algebraMap R S r) := by
      simp only [RingHom.coe_coe, AlgEquiv.commutes]
    rw [h2]

  have s3 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
      [Algebra.Etale R T],
      (∀ P : PrimeSpectrum S, PrimeSpectrum.comap (algebraMap R S) P ∈
        Set.range (PrimeSpectrum.comap (algebraMap R T))) →
      ∃ (n : ℕ) (a : Fin n → R) (b : Fin n → S), ∑ i, algebraMap R S (a i) * b i = 1 ∧
        ∀ i, ∀ Q : PrimeSpectrum R, a i ∉ Q.asIdeal →
          Q ∈ Set.range (PrimeSpectrum.comap (algebraMap R T)) := by
    intro R S T _ _ _ _ _ _ h
    set U := Set.range (PrimeSpectrum.comap (algebraMap R T)) with hU
    have hUo : IsOpen U :=
      (PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation).isOpen_range
    set J := PrimeSpectrum.vanishingIdeal Uᶜ with hJdef
    have hJ : PrimeSpectrum.zeroLocus (J : Set R) = Uᶜ := by
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hUo.isClosed_compl.closure_eq]
    have hmap : Ideal.map (algebraMap R S) J = ⊤ := by
      by_contra hne
      obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
      have hP := h ⟨M, hM.isPrime⟩
      have hz : PrimeSpectrum.comap (algebraMap R S) ⟨M, hM.isPrime⟩ ∈
          PrimeSpectrum.zeroLocus (J : Set R) := by
        rw [PrimeSpectrum.mem_zeroLocus]
        intro x hx
        show algebraMap R S x ∈ M
        exact hle (Ideal.mem_map_of_mem _ hx)
      rw [hJ] at hz
      exact hz hP
    have h1 : (1 : S) ∈ Ideal.map (algebraMap R S) J := by rw [hmap]; trivial
    rw [Ideal.map, Ideal.span, Submodule.mem_span_set'] at h1
    obtain ⟨n, c, g, hg⟩ := h1
    choose a ha hga using fun i => (g i).2
    refine ⟨n, a, c, ?_, ?_⟩
    · rw [← hg]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hga, smul_eq_mul, mul_comm]
    · intro i Q hQ
      by_contra hQU
      exact hQ ((PrimeSpectrum.mem_vanishingIdeal _ _).mp (ha i) Q hQU)

  have s4 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
      [Module.Flat R T] (n : ℕ) (a : Fin n → R) (b : Fin n → S),
      ∑ i, algebraMap R S (a i) * b i = 1 →
      (∀ i, ∀ Q : PrimeSpectrum R, a i ∉ Q.asIdeal →
        Q ∈ Set.range (PrimeSpectrum.comap (algebraMap R T))) →
      Module.FaithfullyFlat S (TensorProduct R S T) := by
    intro R S T _ _ _ _ _ _ n a b hab hD
    apply Module.FaithfullyFlat.of_comap_surjective
    intro P
    have hex : ∃ i, algebraMap R S (a i) ∉ P.asIdeal := by
      by_contra hall
      push_neg at hall
      apply P.isPrime.ne_top
      rw [Ideal.eq_top_iff_one, ← hab]
      exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (hall i)
    obtain ⟨i, hi⟩ := hex
    obtain ⟨q, hq⟩ := hD i (PrimeSpectrum.comap (algebraMap R S) P) hi
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Spec.map (CommRingCat.ofHom (algebraMap R S)))
      (g := Spec.map (CommRingCat.ofHom (algebraMap R T))) P q (by
        rw [Spec.map_base, Spec.map_base]
        exact hq.symm)
    refine ⟨(pullbackSpecIso R S T).hom z, ?_⟩
    have h1 := congrArg (fun φ => φ z) (pullbackSpecIso_hom_fst' R S T)
    simp only [Scheme.Hom.comp_apply] at h1
    rw [hz] at h1
    rw [Spec.map_base] at h1
    exact h1

  have s6 : ∀ (R S T C₀ : Type u) [CommRing R] [CommRing S] [CommRing T] [CommRing C₀]
      [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T] [Algebra R C₀],
      Module.FaithfullyFlat S (TensorProduct R S C₀) →
      Function.Surjective
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R S T) (AlgHom.id R C₀)) →
      Function.Surjective (algebraMap S T) := by
    intro R S T C₀ _ _ _ _ _ _ _ _ _ hff hφ
    apply Module.FaithfullyFlat.surjective_of_tensorProduct (S := TensorProduct R S C₀)
    let Φ : TensorProduct S (TensorProduct R S C₀) T → TensorProduct R T C₀ := fun x =>
      Algebra.TensorProduct.cancelBaseChange R S T T C₀
        (Algebra.TensorProduct.comm S (TensorProduct R S C₀) T x)
    have hΦi : Function.Injective Φ := fun x y hxy =>
      (Algebra.TensorProduct.comm S (TensorProduct R S C₀) T).injective
        ((Algebra.TensorProduct.cancelBaseChange R S T T C₀).injective hxy)
    have key : ∀ x : TensorProduct R S C₀,
        Φ (algebraMap (TensorProduct R S C₀) (TensorProduct S (TensorProduct R S C₀) T) x) =
        Algebra.TensorProduct.map (IsScalarTower.toAlgHom R S T) (AlgHom.id R C₀) x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp [Φ]
      | tmul s c =>
        simp only [Φ, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
          RingHom.id_apply, Algebra.TensorProduct.comm_tmul,
          Algebra.TensorProduct.cancelBaseChange_tmul, Algebra.TensorProduct.map_tmul,
          IsScalarTower.toAlgHom_apply, AlgHom.id_apply, Algebra.smul_def, mul_one]
      | add x y hx hy => simp only [map_add, Φ] at hx hy ⊢; rw [hx, hy]
    intro w
    obtain ⟨x, hx⟩ := hφ (Φ w)
    exact ⟨x, hΦi (by rw [key, hx])⟩

  letI := f.toAlgebra
  letI := k.toAlgebra
  letI := (k.comp f).toAlgebra
  haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : Algebra.Etale B C := RingHom.etale_algebraMap.mp hk
  haveI hCft : Algebra.FiniteType A C := hft
  obtain ⟨A₀, B₀, _, _, hA₀fg, hB₀et, ⟨e⟩⟩ := Algebra.Etale.exists_subalgebra_fg A B C
  have hU := s2 A₀ B B₀ C e hsurj
  obtain ⟨n, a, b, hab, hD⟩ := s3 A₀ B B₀ hU
  obtain ⟨t, ht⟩ := hCft.out
  choose L hL using fun c : C => TensorProduct.exists_finset (e c)
  let s : Finset B := t.biUnion (fun c => (L c).image Prod.fst)
  let B₁ : Subalgebra A₀ B := Algebra.adjoin A₀ ((s : Set B) ∪ Set.range b)
  have hB₁fg : B₁.FG :=
    Subalgebra.fg_def.mpr ⟨_, s.finite_toSet.union (Set.finite_range b), rfl⟩
  have hbB₁ : ∀ i, b i ∈ B₁ := fun i =>
    Algebra.subset_adjoin (Set.mem_union_right _ ⟨i, rfl⟩)
  have hsB₁ : ∀ x ∈ s, x ∈ B₁ := fun x hx =>
    Algebra.subset_adjoin (Set.mem_union_left _ hx)
  have hab' : ∑ i, algebraMap A₀ B₁ (a i) * (⟨b i, hbB₁ i⟩ : B₁) = 1 := by
    apply Subtype.val_injective
    show B₁.val (∑ i, algebraMap A₀ B₁ (a i) * (⟨b i, hbB₁ i⟩ : B₁)) = B₁.val 1
    rw [map_sum, map_one, ← hab]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, AlgHom.commutes]
    rfl
  haveI : Module.Flat A₀ B₀ := inferInstance
  have hff := s4 A₀ B₁ B₀ n a (fun i => ⟨b i, hbB₁ i⟩) hab' hD
  let φ := Algebra.TensorProduct.map (IsScalarTower.toAlgHom A₀ B₁ B) (AlgHom.id A₀ B₀)
  have hmem : ∀ x ∈ Algebra.adjoin A (t : Set C), e x ∈ φ.range := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem c hc =>
      rw [hL c]
      refine Subalgebra.sum_mem _ fun i hi => ?_
      have hi1 : i.1 ∈ s := Finset.mem_biUnion.mpr ⟨c, hc, Finset.mem_image_of_mem _ hi⟩
      exact ⟨(⟨i.1, hsB₁ _ hi1⟩ : B₁) ⊗ₜ i.2, by simp [φ]⟩
    | algebraMap r =>
      have h1 : e (algebraMap A C r) = (f r) ⊗ₜ (1 : B₀) := by
        have : algebraMap A C r = algebraMap B C (f r) := rfl
        rw [this, AlgEquiv.commutes, Algebra.TensorProduct.algebraMap_apply,
          Algebra.algebraMap_self, RingHom.id_apply]
      rw [h1]
      have hfr : f r ∈ B₁ := by
        have : f r ∈ A₀ := A₀.algebraMap_mem r
        have h2 : algebraMap A₀ B ⟨f r, this⟩ ∈ B₁ := B₁.algebraMap_mem _
        exact h2
      exact ⟨(⟨f r, hfr⟩ : B₁) ⊗ₜ (1 : B₀), by simp [φ]⟩
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  have hφ : Function.Surjective φ := by
    intro y
    have hy : e.symm y ∈ Algebra.adjoin A (t : Set C) := by rw [ht]; trivial
    have := hmem _ hy
    rw [AlgEquiv.apply_symm_apply] at this
    exact this
  have hsur := s6 A₀ B₁ B B₀ hff hφ
  have htop : B₁ = ⊤ := by
    rw [Algebra.eq_top_iff]
    intro x
    obtain ⟨y, hy⟩ := hsur x
    rw [← hy]
    exact y.2
  have h1 : Algebra.FiniteType A₀ B := ⟨by rw [← htop]; exact hB₁fg⟩
  have h0 : Algebra.FiniteType A A₀ := (Subalgebra.fg_iff_finiteType A₀).mp hA₀fg
  exact Algebra.FiniteType.trans h0 h1

theorem wcpa_dj_nc_lfp_ring_fp_descend : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] (f : A →+* B) (k : B →+* C), k.Etale → Function.Surjective (PrimeSpectrum.comap k) → f.FiniteType → (k.comp f).FinitePresentation → f.FinitePresentation :=
by
  intro A B C _ _ _ f k hk hsurj hft hfp
  classical
  have colim : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (B : I → Type u) [∀ i, CommRing (B i)] (R : Type u) [CommRing R] (φ : ∀ i, B i →+* R) (β : ∀ {i j : I}, (j ⟶ i) → (B i →+* B j)), (∀ {i j k : I} (f : k ⟶ j) (g : j ⟶ i) (b : B i), β (f ≫ g) b = β f (β g b)) → (∀ {i j : I} (f : j ⟶ i) (b : B i), φ j (β f b) = φ i b) → (∀ r : R, ∃ (i : I) (b : B i), φ i b = r) → (∀ (i : I) (b : B i), φ i b = 0 → ∃ (j : I) (f : j ⟶ i), β f b = 0) → ∀ (i : I) (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) (B i)), Algebra.Etale R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (φ i) (g k))) → ∃ (j : I) (f : j ⟶ i), Algebra.Etale (B j) (MvPolynomial (Fin m) (B j) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (β f) (g k))) := by
    intro I _ _ B _ R _ φ β hF hC hS hK i m r g hEt
    classical

    have hcompφ : ∀ (τ : Type) {a b : I} (e : a ⟶ b) (p : MvPolynomial τ (B b)),
        MvPolynomial.map (φ a) (MvPolynomial.map (β e) p) = MvPolynomial.map (φ b) p := by
      intro τ a b e p
      have h : (φ a).comp (β e) = φ b := RingHom.ext fun x => hC e x
      rw [MvPolynomial.map_map, h]
    have hcompβ : ∀ (τ : Type) {a b c : I} (d : a ⟶ b) (e : b ⟶ c) (p : MvPolynomial τ (B c)),
        MvPolynomial.map (β d) (MvPolynomial.map (β e) p) = MvPolynomial.map (β (d ≫ e)) p := by
      intro τ a b c d e p
      have h : (β d).comp (β e) = β (d ≫ e) := RingHom.ext fun x => (hF d e x).symm
      rw [MvPolynomial.map_map, h]

    have merge : ∀ (ι : Type) (i₀ : I) (P : ι → ∀ j : I, (j ⟶ i₀) → Prop),
        (∀ a j k (f : j ⟶ i₀) (g : k ⟶ j), P a j f → P a k (g ≫ f)) →
        ∀ s : Finset ι, (∀ a ∈ s, ∃ j f, P a j f) → ∃ j f, ∀ a ∈ s, P a j f := by
      intro ι i₀ P hP s
      induction s using Finset.induction_on with
      | empty => intro _; exact ⟨i₀, 𝟙 i₀, fun a ha => absurd ha (Finset.notMem_empty a)⟩
      | insert b s hb ih =>
        intro h
        obtain ⟨j, f, hj⟩ := ih (fun a ha => h a (Finset.mem_insert_of_mem ha))
        obtain ⟨j', f', hj'⟩ := h b (Finset.mem_insert_self b s)
        obtain ⟨k, g₁, g₂, hw⟩ := IsCofiltered.cospan f f'
        refine ⟨k, g₁ ≫ f, fun a ha => ?_⟩
        rcases Finset.mem_insert.mp ha with rfl | ha
        · rw [hw]; exact hP _ _ _ _ _ hj'
        · exact hP _ _ _ _ _ (hj a ha)

    have liftE : ∀ (ι : Type) [Fintype ι] (i₀ : I) (x : ι → R),
        ∃ (j : I) (_ : j ⟶ i₀) (y : ι → B j), ∀ t, φ j (y t) = x t := by
      intro ι _ i₀ x
      obtain ⟨j, f, hj⟩ := merge ι i₀ (fun t j _ => ∃ y : B j, φ j y = x t)
        (fun t j k f g h => by
          obtain ⟨y, hy⟩ := h
          exact ⟨β g y, by rw [hC, hy]⟩)
        Finset.univ (fun t _ => by
          obtain ⟨i1, b1, hb1⟩ := hS (x t)
          exact ⟨IsCofiltered.min i₀ i1, IsCofiltered.minToLeft i₀ i1,
            β (IsCofiltered.minToRight i₀ i1) b1, by rw [hC, hb1]⟩)
      choose y hy using fun t => hj t (Finset.mem_univ t)
      exact ⟨j, f, y, hy⟩

    have liftP : ∀ (τ ι : Type) [Fintype ι] (i₀ : I) (P : ι → MvPolynomial τ R),
        ∃ (j : I) (_ : j ⟶ i₀) (Q : ι → MvPolynomial τ (B j)),
          ∀ t, MvPolynomial.map (φ j) (Q t) = P t := by
      intro τ ι _ i₀ P
      obtain ⟨j, f, y, hy⟩ := liftE (Σ t : ι, {μ // μ ∈ (P t).support}) i₀
        (fun s => (P s.1).coeff s.2.1)
      refine ⟨j, f, fun t => ∑ μ ∈ (P t).support.attach, MvPolynomial.monomial μ.1 (y ⟨t, μ⟩),
        fun t => ?_⟩
      simp only [map_sum, MvPolynomial.map_monomial, hy]
      rw [Finset.sum_attach (P t).support (fun μ => MvPolynomial.monomial μ ((P t).coeff μ))]
      exact MvPolynomial.support_sum_monomial_coeff _

    have vanish : ∀ (τ ι : Type) [Fintype ι] (j₀ : I) (Q : ι → MvPolynomial τ (B j₀)),
        (∀ t, MvPolynomial.map (φ j₀) (Q t) = 0) →
        ∃ (j : I) (f : j ⟶ j₀), ∀ t, MvPolynomial.map (β f) (Q t) = 0 := by
      intro τ ι _ j₀ Q hQ
      obtain ⟨j, f, hj⟩ := merge (Σ t, {μ // μ ∈ (Q t).support}) j₀
        (fun s j f => β f ((Q s.1).coeff s.2.1) = 0)
        (fun s j k f g h => by
          rw [hF, h, map_zero])
        Finset.univ (fun s _ => by
          refine hK _ _ ?_
          rw [← MvPolynomial.coeff_map, hQ]
          simp)
      refine ⟨j, f, fun t => ?_⟩
      ext μ
      rw [MvPolynomial.coeff_map]
      by_cases hμ : μ ∈ (Q t).support
      · simpa using hj ⟨t, ⟨μ, hμ⟩⟩ (Finset.mem_univ _)
      · simp [MvPolynomial.notMem_support_iff.mp hμ]

    have descM : ∀ (τ κ α : Type) [Fintype κ] [Fintype α] (k₀ : I)
        (Gn : κ → MvPolynomial τ (B k₀)) (P : α → MvPolynomial τ (B k₀)),
        (∀ a, MvPolynomial.map (φ k₀) (P a) ∈
          Ideal.span (Set.range fun t => MvPolynomial.map (φ k₀) (Gn t))) →
        ∃ (j : I) (e : j ⟶ k₀), ∀ a, MvPolynomial.map (β e) (P a) ∈
          Ideal.span (Set.range fun t => MvPolynomial.map (β e) (Gn t)) := by
      intro τ κ α _ _ k₀ Gn P hP
      have hc : ∀ a, ∃ c : κ → MvPolynomial τ R,
          ∑ t, c t * MvPolynomial.map (φ k₀) (Gn t) = MvPolynomial.map (φ k₀) (P a) :=
        fun a => Ideal.mem_span_range_iff_exists_fun.mp (hP a)
      choose c hc using hc
      obtain ⟨j1, f1, c', hc'⟩ := liftP τ (α × κ) k₀ (fun p => c p.1 p.2)
      obtain ⟨j2, f2, hv⟩ := vanish τ α j1 (fun a => MvPolynomial.map (β f1) (P a) -
          ∑ t, c' (a, t) * MvPolynomial.map (β f1) (Gn t)) (by
        intro a
        simp only [map_sub, map_sum, map_mul, hc', hcompφ]
        rw [hc a, sub_self])
      refine ⟨j2, f2 ≫ f1, fun a => ?_⟩
      have h := hv a
      simp only [map_sub, map_sum, map_mul, hcompβ] at h
      rw [sub_eq_zero.mp h]
      exact Ideal.sum_mem _ fun t _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨t, rfl⟩)

    have stab : ∀ (τ κ : Type) [Fintype κ] (k₀ j j' : I) (e : j ⟶ k₀) (d : j' ⟶ j)
        (Gn : κ → MvPolynomial τ (B k₀)) (Q : MvPolynomial τ (B k₀)),
        MvPolynomial.map (β e) Q ∈ Ideal.span (Set.range fun t => MvPolynomial.map (β e) (Gn t)) →
        MvPolynomial.map (β (d ≫ e)) Q ∈
          Ideal.span (Set.range fun t => MvPolynomial.map (β (d ≫ e)) (Gn t)) := by
      intro τ κ _ k₀ j j' e d Gn Q h
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h
      refine Ideal.mem_span_range_iff_exists_fun.mpr ⟨fun t => MvPolynomial.map (β d) (c t), ?_⟩
      rw [← hcompβ, ← hc, map_sum]
      refine Finset.sum_congr rfl fun t _ => ?_
      rw [map_mul, hcompβ]

    have iso : ∀ (A : Type u) [CommRing A] (τ₁ τ₂ κ₁ κ₂ : Type) (g₁ : κ₁ → MvPolynomial τ₁ A)
        (g₂ : κ₂ → MvPolynomial τ₂ A) (X₂ : τ₁ → MvPolynomial τ₂ A) (X₁ : τ₂ → MvPolynomial τ₁ A),
        (∀ c, MvPolynomial.bind₁ X₁ (g₂ c) ∈ Ideal.span (Set.range g₁)) →
        (∀ l, MvPolynomial.bind₁ X₂ (g₁ l) ∈ Ideal.span (Set.range g₂)) →
        (∀ b, MvPolynomial.bind₁ X₁ (X₂ b) - MvPolynomial.X b ∈ Ideal.span (Set.range g₁)) →
        (∀ a, MvPolynomial.bind₁ X₂ (X₁ a) - MvPolynomial.X a ∈ Ideal.span (Set.range g₂)) →
        Nonempty ((MvPolynomial τ₁ A ⧸ Ideal.span (Set.range g₁)) ≃ₐ[A]
          (MvPolynomial τ₂ A ⧸ Ideal.span (Set.range g₂))) := by
      intro A _ τ₁ τ₂ κ₁ κ₂ g₁ g₂ X₂ X₁ h1 h2 h3 h4
      have hα : ∀ x ∈ Ideal.span (Set.range g₁),
          ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₂))).comp (MvPolynomial.bind₁ X₂)) x = 0 := by
        intro x hx
        have hle : Ideal.span (Set.range g₁) ≤
            (Ideal.span (Set.range g₂)).comap (MvPolynomial.bind₁ X₂) := by
          rw [Ideal.span_le]
          rintro _ ⟨l, rfl⟩
          exact h2 l
        rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
        exact hle hx
      have hγ : ∀ x ∈ Ideal.span (Set.range g₂),
          ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₁))).comp (MvPolynomial.bind₁ X₁)) x = 0 := by
        intro x hx
        have hle : Ideal.span (Set.range g₂) ≤
            (Ideal.span (Set.range g₁)).comap (MvPolynomial.bind₁ X₁) := by
          rw [Ideal.span_le]
          rintro _ ⟨c, rfl⟩
          exact h1 c
        rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
        exact hle hx
      let α := Ideal.Quotient.liftₐ (Ideal.span (Set.range g₁))
        ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₂))).comp (MvPolynomial.bind₁ X₂)) hα
      let γ := Ideal.Quotient.liftₐ (Ideal.span (Set.range g₂))
        ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₁))).comp (MvPolynomial.bind₁ X₁)) hγ
      have hαmk : ∀ x, α (Ideal.Quotient.mk _ x) =
          Ideal.Quotient.mk (Ideal.span (Set.range g₂)) (MvPolynomial.bind₁ X₂ x) := fun x => rfl
      have hγmk : ∀ x, γ (Ideal.Quotient.mk _ x) =
          Ideal.Quotient.mk (Ideal.span (Set.range g₁)) (MvPolynomial.bind₁ X₁ x) := fun x => rfl
      have e₁ : γ.comp α = AlgHom.id A _ := by
        apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro b
        simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
        rw [hαmk, MvPolynomial.bind₁_X_right, hγmk, Ideal.Quotient.eq]
        exact h3 b
      have e₂ : α.comp γ = AlgHom.id A _ := by
        apply Ideal.Quotient.algHom_ext
        apply MvPolynomial.algHom_ext
        intro a
        simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
        rw [hγmk, MvPolynomial.bind₁_X_right, hαmk, Ideal.Quotient.eq]
        exact h4 a
      exact ⟨AlgEquiv.ofAlgHom α γ e₂ e₁⟩
    set J := Ideal.span (Set.range fun k => MvPolynomial.map (φ i) (g k)) with hJ

    obtain ⟨ι, σ, _, _, mp, F, val, hbij, hsurj, hker, G, hcert⟩ :
        ∃ (ι σ : Type) (_ : Fintype ι) (_ : Fintype σ) (mp : σ → ι) (F : σ → MvPolynomial ι R)
          (val : ι → MvPolynomial (Fin m) R ⧸ J), Function.Bijective mp ∧
          Function.Surjective (MvPolynomial.aeval (R := R) val) ∧
          RingHom.ker (MvPolynomial.aeval (R := R) val) = Ideal.span (Set.range F) ∧
          ∃ G : MvPolynomial ι R,
            G * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (F b)).det - 1 ∈
              Ideal.span (Set.range F) := by
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 R (MvPolynomial (Fin m) R ⧸ J) :=
        Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt
      obtain ⟨ι, σ, hσ, hι, P, hdim⟩ :=
        Algebra.IsStandardSmoothOfRelativeDimension.out (n := 0) (R := R)
          (S := MvPolynomial (Fin m) R ⧸ J)
      have hdim' : Nat.card ι - Nat.card σ = 0 := hdim
      have hle : Nat.card ι ≤ Nat.card σ := Nat.sub_eq_zero_iff_le.mp hdim'
      letI : Fintype ι := Fintype.ofFinite ι
      letI : Fintype σ := Fintype.ofFinite σ
      have hker : RingHom.ker (MvPolynomial.aeval (R := R) P.val) =
          Ideal.span (Set.range P.relation) :=
        (P.span_range_relation_eq_ker.trans P.ker_eq_ker_aeval_val).symm
      refine ⟨ι, σ, inferInstance, inferInstance, P.map, P.relation, P.val,
        P.map_inj.bijective_of_nat_card_le hle, fun s => ⟨P.σ' s, P.aeval_val_σ' s⟩, hker, ?_⟩
      have hM : (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)) =
          P.jacobiMatrix := by
        ext i j
        rw [Matrix.of_apply, P.jacobiMatrix_apply]
      have hJac : P.jacobian = MvPolynomial.aeval P.val
          (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)).det := by
        rw [P.jacobian_eq_jacobiMatrix_det, hM, Algebra.Generators.algebraMap_apply]
      have hu : IsUnit P.jacobian := P.jacobian_isUnit
      rw [hJac] at hu
      obtain ⟨y, hy⟩ := hu.exists_left_inv
      refine ⟨P.σ' y, ?_⟩
      rw [← hker, RingHom.mem_ker, map_sub, map_mul, map_one, P.aeval_val_σ', hy, sub_self]

    have s3 : ∀ (A : Type u) [CommRing A] (f : σ → MvPolynomial ι A) (g : MvPolynomial ι A),
        g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈
          Ideal.span (Set.range f) →
        Algebra.Etale A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) := by
      intro A _ f g hg
      let P : Algebra.PreSubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
        { Algebra.Presentation.naive (v := f) with map := mp, map_inj := hbij.1 }
      have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j) := by
        ext i j
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        rfl
      have halg : ∀ x : MvPolynomial ι A,
          algebraMap P.Ring (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) x =
            Ideal.Quotient.mk (Ideal.span (Set.range f)) x := fun x => rfl
      have hunit : IsUnit P.jacobian := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
        have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f))
            (g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det) = 1 := by
          rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f))), Ideal.Quotient.eq]
          exact hg
        rw [map_mul, mul_comm] at h1
        exact IsUnit.of_mul_eq_one _ h1
      let Q : Algebra.SubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
        { P with jacobian_isUnit := hunit }
      have hdim : Q.dimension = 0 := by
        show Nat.card ι - Nat.card σ = 0
        rw [Nat.card_eq_of_bijective mp hbij, Nat.sub_self]
      haveI := Q.isStandardSmoothOfRelativeDimension hdim
      infer_instance

    have hdet : ∀ (A A' : Type u) [CommRing A] [CommRing A'] (ψ : A →+* A')
        (Fx : σ → MvPolynomial ι A),
        MvPolynomial.map ψ (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (Fx b)).det =
          (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (MvPolynomial.map ψ (Fx b))).det := by
      intro A A' _ _ ψ Fx
      rw [RingHom.map_det]
      congr 1
      ext a b
      simp [RingHom.mapMatrix_apply, MvPolynomial.pderiv_map]

    have hYs : ∀ a, ∃ y : MvPolynomial (Fin m) R, Ideal.Quotient.mk J y = val a :=
      fun a => Ideal.Quotient.mk_surjective (val a)
    choose Ys hYs using hYs
    have hXs : ∀ b, ∃ x : MvPolynomial ι R,
        MvPolynomial.aeval (R := R) val x = Ideal.Quotient.mk J (MvPolynomial.X b) :=
      fun b => hsurj _
    choose Xs hXs using hXs
    have K1 : ∀ p : MvPolynomial ι R,
        Ideal.Quotient.mk J (MvPolynomial.bind₁ Ys p) = MvPolynomial.aeval (R := R) val p := by
      intro p
      have h : (Ideal.Quotient.mkₐ R J).comp (MvPolynomial.bind₁ Ys) =
          MvPolynomial.aeval (R := R) val := by
        apply MvPolynomial.algHom_ext
        intro a
        rw [AlgHom.comp_apply, MvPolynomial.bind₁_X_right, MvPolynomial.aeval_X,
          Ideal.Quotient.mkₐ_eq_mk, hYs]
      rw [← h, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
    have K2 : ∀ p : MvPolynomial (Fin m) R,
        MvPolynomial.aeval (R := R) val (MvPolynomial.bind₁ Xs p) = Ideal.Quotient.mk J p := by
      intro p
      have h : (MvPolynomial.aeval (R := R) val).comp (MvPolynomial.bind₁ Xs) =
          Ideal.Quotient.mkₐ R J := by
        apply MvPolynomial.algHom_ext
        intro b
        rw [AlgHom.comp_apply, MvPolynomial.bind₁_X_right, hXs, Ideal.Quotient.mkₐ_eq_mk]
      rw [← Ideal.Quotient.mkₐ_eq_mk R J, ← h, AlgHom.comp_apply]
    have R1 : ∀ c, MvPolynomial.bind₁ Ys (F c) ∈ J := by
      intro c
      rw [← Ideal.Quotient.eq_zero_iff_mem, K1, ← RingHom.mem_ker, hker]
      exact Ideal.subset_span ⟨c, rfl⟩
    have R2 : ∀ l, MvPolynomial.bind₁ Xs (MvPolynomial.map (φ i) (g l)) ∈
        Ideal.span (Set.range F) := by
      intro l
      rw [← hker, RingHom.mem_ker, K2, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span ⟨l, rfl⟩
    have R3 : ∀ b, MvPolynomial.bind₁ Ys (Xs b) - MvPolynomial.X b ∈ J := by
      intro b
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, K1, hXs, sub_self]
    have R4 : ∀ a, MvPolynomial.bind₁ Xs (Ys a) - MvPolynomial.X a ∈ Ideal.span (Set.range F) := by
      intro a
      rw [← hker, RingHom.mem_ker, map_sub, K2, hYs, MvPolynomial.aeval_X, sub_self]

    obtain ⟨j1, f1, Q1, hQ1⟩ := liftP ι (σ ⊕ (Unit ⊕ Fin m)) i
      (Sum.elim F (Sum.elim (fun _ => G) Xs))
    obtain ⟨k, f2, Ys', hYs'⟩ := liftP (Fin m) ι j1 Ys
    obtain ⟨F', hF'⟩ : ∃ F' : σ → MvPolynomial ι (B k),
        ∀ c, MvPolynomial.map (φ k) (F' c) = F c :=
      ⟨fun c => MvPolynomial.map (β f2) (Q1 (Sum.inl c)),
        fun c => (hcompφ _ f2 _).trans (hQ1 (Sum.inl c))⟩
    obtain ⟨G', hG'⟩ : ∃ G' : MvPolynomial ι (B k), MvPolynomial.map (φ k) G' = G :=
      ⟨MvPolynomial.map (β f2) (Q1 (Sum.inr (Sum.inl ()))),
        (hcompφ _ f2 _).trans (hQ1 (Sum.inr (Sum.inl ())))⟩
    obtain ⟨Xs', hXs'⟩ : ∃ Xs' : Fin m → MvPolynomial ι (B k),
        ∀ b, MvPolynomial.map (φ k) (Xs' b) = Xs b :=
      ⟨fun b => MvPolynomial.map (β f2) (Q1 (Sum.inr (Sum.inr b))),
        fun b => (hcompφ _ f2 _).trans (hQ1 (Sum.inr (Sum.inr b)))⟩
    obtain ⟨gk, hgkφ, hgkβ⟩ : ∃ gk : Fin r → MvPolynomial (Fin m) (B k),
        (∀ l, MvPolynomial.map (φ k) (gk l) = MvPolynomial.map (φ i) (g l)) ∧
        ∀ (j : I) (e : j ⟶ k) l,
          MvPolynomial.map (β e) (gk l) = MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l) :=
      ⟨fun l => MvPolynomial.map (β (f2 ≫ f1)) (g l), fun l => hcompφ _ _ _,
        fun j e l => hcompβ _ _ _ _⟩

    obtain ⟨PA, hPA1, hPA3⟩ : ∃ PA : σ ⊕ Fin m → MvPolynomial (Fin m) (B k),
        (∀ c, PA (Sum.inl c) = MvPolynomial.bind₁ Ys' (F' c)) ∧
        (∀ b, PA (Sum.inr b) = MvPolynomial.bind₁ Ys' (Xs' b) - MvPolynomial.X b) :=
      ⟨Sum.elim (fun c => MvPolynomial.bind₁ Ys' (F' c))
        (fun b => MvPolynomial.bind₁ Ys' (Xs' b) - MvPolynomial.X b), fun _ => rfl, fun _ => rfl⟩
    obtain ⟨PB, hPB2, hPB4, hPB5⟩ : ∃ PB : (Fin r ⊕ ι) ⊕ Unit → MvPolynomial ι (B k),
        (∀ l, PB (Sum.inl (Sum.inl l)) = MvPolynomial.bind₁ Xs' (gk l)) ∧
        (∀ a, PB (Sum.inl (Sum.inr a)) = MvPolynomial.bind₁ Xs' (Ys' a) - MvPolynomial.X a) ∧
        PB (Sum.inr ()) =
          G' * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (F' b)).det - 1 :=
      ⟨Sum.elim (Sum.elim (fun l => MvPolynomial.bind₁ Xs' (gk l))
          (fun a => MvPolynomial.bind₁ Xs' (Ys' a) - MvPolynomial.X a))
        (fun _ => G' * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (F' b)).det - 1),
        fun _ => rfl, fun _ => rfl, rfl⟩

    obtain ⟨j₁, e₁, H1⟩ := descM (Fin m) (Fin r) (σ ⊕ Fin m) k gk PA (by
      rintro (c | b)
      · rw [hPA1, MvPolynomial.map_bind₁]
        simp only [hYs', hF', hgkφ]
        exact R1 c
      · rw [hPA3, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X]
        simp only [hYs', hXs', hgkφ]
        exact R3 b)
    obtain ⟨j₂, e₂, H2⟩ := descM ι σ ((Fin r ⊕ ι) ⊕ Unit) k F' PB (by
      rintro ((l | a) | u)
      · rw [hPB2, MvPolynomial.map_bind₁]
        simp only [hXs', hgkφ, hF']
        exact R2 l
      · rw [hPB4, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X]
        simp only [hXs', hYs', hF']
        exact R4 a
      · rw [hPB5, map_sub, map_mul, map_one, hdet, hG']
        simp only [hF']
        exact hcert)
    obtain ⟨j, e, H1', H2'⟩ : ∃ (j : I) (e : j ⟶ k),
        (∀ s, MvPolynomial.map (β e) (PA s) ∈
          Ideal.span (Set.range fun t => MvPolynomial.map (β e) (gk t))) ∧
        (∀ s, MvPolynomial.map (β e) (PB s) ∈
          Ideal.span (Set.range fun t => MvPolynomial.map (β e) (F' t))) := by
      obtain ⟨j, d₁, d₂, hw⟩ := IsCofiltered.cospan e₁ e₂
      refine ⟨j, d₁ ≫ e₁, fun s => stab _ _ _ _ _ e₁ d₁ _ _ (H1 s), fun s => ?_⟩
      rw [hw]
      exact stab _ _ _ _ _ e₂ d₂ _ _ (H2 s)

    have hgj := hgkβ j e
    have T1 : ∀ c, MvPolynomial.bind₁ (fun a => MvPolynomial.map (β e) (Ys' a))
        (MvPolynomial.map (β e) (F' c)) ∈
          Ideal.span (Set.range fun l => MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) := by
      intro c
      have h := H1' (Sum.inl c)
      rw [hPA1, MvPolynomial.map_bind₁] at h
      simpa only [hgj] using h
    have T2 : ∀ l, MvPolynomial.bind₁ (fun b => MvPolynomial.map (β e) (Xs' b))
        (MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) ∈
          Ideal.span (Set.range fun c => MvPolynomial.map (β e) (F' c)) := by
      intro l
      have h := H2' (Sum.inl (Sum.inl l))
      rw [hPB2, MvPolynomial.map_bind₁] at h
      simpa only [hgj] using h
    have T3 : ∀ b, MvPolynomial.bind₁ (fun a => MvPolynomial.map (β e) (Ys' a))
        (MvPolynomial.map (β e) (Xs' b)) - MvPolynomial.X b ∈
          Ideal.span (Set.range fun l => MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) := by
      intro b
      have h := H1' (Sum.inr b)
      rw [hPA3, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X] at h
      simpa only [hgj] using h
    have T4 : ∀ a, MvPolynomial.bind₁ (fun b => MvPolynomial.map (β e) (Xs' b))
        (MvPolynomial.map (β e) (Ys' a)) - MvPolynomial.X a ∈
          Ideal.span (Set.range fun c => MvPolynomial.map (β e) (F' c)) := by
      intro a
      have h := H2' (Sum.inl (Sum.inr a))
      rw [hPB4, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X] at h
      exact h
    have T5 : MvPolynomial.map (β e) G' * (Matrix.of fun a b => MvPolynomial.pderiv (mp a)
        (MvPolynomial.map (β e) (F' b))).det - 1 ∈
          Ideal.span (Set.range fun c => MvPolynomial.map (β e) (F' c)) := by
      have h := H2' (Sum.inr ())
      rw [hPB5, map_sub, map_mul, map_one, hdet (B k) (B j) (β e) F'] at h
      exact h
    obtain ⟨eqv⟩ := iso (B j) (Fin m) ι (Fin r) σ
      (fun l => MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) (fun c => MvPolynomial.map (β e) (F' c))
      (fun b => MvPolynomial.map (β e) (Xs' b)) (fun a => MvPolynomial.map (β e) (Ys' a))
      T1 T2 T3 T4
    haveI := s3 (B j) (fun c => MvPolynomial.map (β e) (F' c)) (MvPolynomial.map (β e) G') T5
    exact ⟨j, e ≫ f2 ≫ f1, Algebra.Etale.of_equiv eqv.symm⟩

  have s4 : ∀ (B' C' : Type u) [CommRing B'] [CommRing C'] [Algebra B' C'] [Module.Flat B' C']
      (N : Ideal B'), (∀ n ∈ N, algebraMap B' C' n = 0) →
      IsOpen (Set.range (PrimeSpectrum.comap (algebraMap B' C'))) →
      Set.range (PrimeSpectrum.comap (algebraMap B' C')) = PrimeSpectrum.zeroLocus (N : Set B') →
      N.FG := by
    intro B' C' _ _ _ _ N hN hopen hrange
    have hclopen : IsClopen (Set.range (PrimeSpectrum.comap (algebraMap B' C'))) :=
      ⟨by rw [hrange]; exact PrimeSpectrum.isClosed_zeroLocus _, hopen⟩
    obtain ⟨e0, f0, hef, hsum, hs, -⟩ :=
      PrimeSpectrum.exists_mul_eq_zero_add_eq_one_basicOpen_eq_of_isClopen hclopen
    have hf0idem : IsIdempotentElem f0 := by
      show f0 * f0 = f0
      linear_combination f0 * hsum - hef
    have hf0N : f0 ∈ N := by
      have hrad : f0 ∈ N.radical := by
        rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
        rintro Q ⟨hNQ, hQ⟩
        have hmem : (⟨Q, hQ⟩ : PrimeSpectrum B') ∈ PrimeSpectrum.zeroLocus (N : Set B') :=
          (PrimeSpectrum.mem_zeroLocus _ _).mpr hNQ
        rw [← hrange, hs] at hmem
        have he0 : e0 ∉ Q := hmem
        have h0 : e0 * f0 ∈ Q := by rw [hef]; exact Q.zero_mem
        exact (hQ.mem_or_mem h0).resolve_left he0
      obtain ⟨t, ht⟩ := hrad
      cases t with
      | zero =>
        rw [pow_zero] at ht
        simpa using N.mul_mem_left f0 ht
      | succ t =>
        rwa [IsIdempotentElem.pow_succ_eq t hf0idem] at ht
    have hNle : N ≤ Ideal.span {f0} := by
      intro n hn
      obtain ⟨κ, a, y, hy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
        (R := B') (M := C') (f := ![n]) (x := ![(1 : C')]) (by
          rw [Fin.sum_univ_one]
          exact (Algebra.smul_def n (1 : C')).trans (by simp [hN n hn]))
      have hy0 : (1 : C') = ∑ j, a 0 j • y j := by simpa using hy 0
      have ha0 : ∀ j, n * a 0 j = 0 := fun j => by simpa using ha j
      have htop : Ideal.span (Set.range (a 0)) ⊔ Ideal.span {f0} = ⊤ := by
        by_contra hne
        obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
        have hf0M : f0 ∈ M := hle (Ideal.mem_sup_right (Ideal.subset_span rfl))
        have he0M : e0 ∉ M := fun h =>
          hM.ne_top ((Ideal.eq_top_iff_one M).mpr (by rw [← hsum]; exact M.add_mem h hf0M))
        have hMr : (⟨M, hM.isPrime⟩ : PrimeSpectrum B') ∈
            Set.range (PrimeSpectrum.comap (algebraMap B' C')) := by
          rw [hs]; exact he0M
        obtain ⟨Q, hQ⟩ := hMr
        have h1 : (1 : C') ∈ Q.asIdeal := by
          rw [hy0]
          refine Ideal.sum_mem _ fun j _ => ?_
          rw [Algebra.smul_def]
          refine Ideal.mul_mem_right _ _ ?_
          have h2 : a 0 j ∈ M := hle (Ideal.mem_sup_left (Ideal.subset_span ⟨j, rfl⟩))
          have h3 : a 0 j ∈ (PrimeSpectrum.comap (algebraMap B' C') Q).asIdeal := by
            rw [hQ]; exact h2
          exact h3
        exact Q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      have h1 : (1 : B') ∈ Ideal.span (Set.range (a 0)) ⊔ Ideal.span {f0} := by
        rw [htop]; trivial
      obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp h1
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hu
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hv
      have hnu : n * u = 0 := by
        rw [← hc, Finset.mul_sum]
        exact Finset.sum_eq_zero fun j _ => by
          rw [show n * (c j * a 0 j) = c j * (n * a 0 j) by ring, ha0 j, mul_zero]
      have hev : e0 * v = 0 := by
        rw [← hd]
        linear_combination d * hef
      have hne0 : n * e0 = 0 := by
        linear_combination e0 * hnu + n * hev - n * e0 * huv
      exact Ideal.mem_span_singleton'.mpr ⟨n, by linear_combination n * hsum - hne0⟩
    have hNeq : N = Ideal.span {f0} :=
      le_antisymm hNle ((Ideal.span_singleton_le_iff_mem N).mpr hf0N)
    exact ⟨{f0}, by rw [hNeq, Finset.coe_singleton]⟩

  have stage : ∀ (P B C B' : Type u) [CommRing P] [CommRing B] [CommRing C] [CommRing B']
      (k : B →+* C) (πR : P →+* B) (mk : P →+* B') (ν : B' →+* B),
      Function.Surjective (PrimeSpectrum.comap k) → Function.Surjective πR →
      Function.Surjective mk → ν.comp mk = πR → (RingHom.ker mk).FG →
      ∀ (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) P) (πC : MvPolynomial (Fin m) B →+* C),
      πC.comp MvPolynomial.C = k → (∀ i, πC (MvPolynomial.map πR (g i)) = 0) →
      Ideal.map (MvPolynomial.C : P →+* MvPolynomial (Fin m) P) (RingHom.ker πR) ≤
        Ideal.span (Set.range g) ⊔ Ideal.map MvPolynomial.C (RingHom.ker mk) →
      ∀ I' : Ideal (MvPolynomial (Fin m) B'),
      I' = Ideal.span (Set.range fun i => MvPolynomial.map mk (g i)) →
      Algebra.Etale B' (MvPolynomial (Fin m) B' ⧸ I') → (RingHom.ker πR).FG := by
    intro P B C B' _ _ _ _ k πR mk ν hsurj hπR hmk hνmk hmkfg m r g πC hπCC hgker H3 I' hI' hEt'
    subst hI'
    set I' := Ideal.span (Set.range fun i => MvPolynomial.map mk (g i)) with hI'def
    have hνmk' : ∀ p, ν (mk p) = πR p := fun p => by rw [← hνmk]; rfl
    have hν : Function.Surjective ν := by
      intro b
      obtain ⟨p, rfl⟩ := hπR b
      exact ⟨mk p, hνmk' p⟩
    have hα : ∀ b, algebraMap B' (MvPolynomial (Fin m) B' ⧸ I') b =
        Ideal.Quotient.mk I' (MvPolynomial.C b) := fun b => rfl

    have hkill : ∀ n ∈ RingHom.ker ν, algebraMap B' (MvPolynomial (Fin m) B' ⧸ I') n = 0 := by
      intro n hn
      obtain ⟨p, rfl⟩ := hmk n
      have hp : p ∈ RingHom.ker πR := by
        rw [RingHom.mem_ker, hνmk'] at hn
        exact RingHom.mem_ker.mpr hn
      let Θ := (Ideal.Quotient.mk I').comp (MvPolynomial.map mk)
      have hle : Ideal.span (Set.range g) ⊔ Ideal.map (MvPolynomial.C : P →+*
          MvPolynomial (Fin m) P) (RingHom.ker mk) ≤ RingHom.ker Θ := by
        refine sup_le (Ideal.span_le.mpr ?_) (Ideal.map_le_iff_le_comap.mpr ?_)
        · rintro _ ⟨i, rfl⟩
          show Ideal.Quotient.mk I' (MvPolynomial.map mk (g i)) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.subset_span ⟨i, rfl⟩
        · intro q hq
          show Ideal.Quotient.mk I' (MvPolynomial.map mk (MvPolynomial.C q)) = 0
          rw [MvPolynomial.map_C, RingHom.mem_ker.mp hq, map_zero, map_zero]
      have h1 : MvPolynomial.C p ∈ RingHom.ker Θ :=
        hle (H3 (Ideal.mem_map_of_mem _ hp))
      rw [RingHom.mem_ker] at h1
      rw [hα]
      have h2 : Θ (MvPolynomial.C p) = Ideal.Quotient.mk I' (MvPolynomial.C (mk p)) := by
        show Ideal.Quotient.mk I' (MvPolynomial.map mk (MvPolynomial.C p)) = _
        rw [MvPolynomial.map_C]
      rw [← h2, h1]

    have hψker : ∀ a ∈ I', (πC.comp (MvPolynomial.map ν)) a = 0 := by
      intro a ha
      have hle : I' ≤ RingHom.ker (πC.comp (MvPolynomial.map ν)) := by
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, MvPolynomial.map_map, hνmk]
        exact hgker i
      exact hle ha
    let ψ : (MvPolynomial (Fin m) B' ⧸ I') →+* C :=
      Ideal.Quotient.lift I' (πC.comp (MvPolynomial.map ν)) hψker
    have hψα : ψ.comp (algebraMap B' (MvPolynomial (Fin m) B' ⧸ I')) = k.comp ν := by
      refine RingHom.ext fun b => ?_
      rw [RingHom.comp_apply, hα, RingHom.comp_apply, ← hπCC]
      show πC (MvPolynomial.map ν (MvPolynomial.C b)) = πC (MvPolynomial.C (ν b))
      rw [MvPolynomial.map_C]

    have hrange : Set.range (PrimeSpectrum.comap (algebraMap B' (MvPolynomial (Fin m) B' ⧸ I'))) =
        PrimeSpectrum.zeroLocus (RingHom.ker ν : Set B') := by
      ext P'
      constructor
      · rintro ⟨Q, rfl⟩
        rw [PrimeSpectrum.mem_zeroLocus]
        intro n hn
        show n ∈ Ideal.comap _ Q.asIdeal
        rw [Ideal.mem_comap, hkill n hn]
        exact Q.asIdeal.zero_mem
      · intro hP'
        rw [PrimeSpectrum.mem_zeroLocus] at hP'
        have hkle : RingHom.ker ν ≤ P'.asIdeal := hP'
        haveI hpr : (Ideal.map ν P'.asIdeal).IsPrime := Ideal.map_isPrime_of_surjective hν hkle
        obtain ⟨Q, hQ⟩ := hsurj ⟨Ideal.map ν P'.asIdeal, hpr⟩
        refine ⟨PrimeSpectrum.comap ψ Q, ?_⟩
        rw [← PrimeSpectrum.comap_comp_apply, hψα, PrimeSpectrum.comap_comp_apply, hQ]
        ext1
        show Ideal.comap ν (Ideal.map ν P'.asIdeal) = P'.asIdeal
        rw [Ideal.comap_map_of_surjective _ hν, ← RingHom.ker_eq_comap_bot]
        exact sup_eq_left.mpr hkle

    have hopen : IsOpen (Set.range (PrimeSpectrum.comap
        (algebraMap B' (MvPolynomial (Fin m) B' ⧸ I')))) := by
      haveI : Algebra.HasGoingDown B' (MvPolynomial (Fin m) B' ⧸ I') := Algebra.HasGoingDown.of_flat
      exact PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation.isOpen_range

    have hNfg : (RingHom.ker ν).FG := s4 _ _ _ hkill hopen hrange
    have h := Ideal.fg_ker_comp mk ν hmkfg hNfg hmk
    rwa [hνmk] at h

  letI : Algebra A B := f.toAlgebra
  letI : Algebra B C := k.toAlgebra
  letI : Algebra A C := (k.comp f).toAlgebra
  haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI hEtBC : Algebra.Etale B C := hk
  haveI hFPAC : Algebra.FinitePresentation A C := hfp

  obtain ⟨s, πB, hπB⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
  obtain ⟨m, πC, hπC, hkerC⟩ := (Algebra.Etale.finitePresentation (R := B) (A := C)).out
  obtain ⟨r, gB, hgB⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hkerC
  let πR : MvPolynomial (Fin s) A →+* B := πB.toRingHom
  have hπR : Function.Surjective πR := hπB
  have hlift : ∀ i, ∃ q, MvPolynomial.map πR q = gB i :=
    fun i => MvPolynomial.map_surjective πR hπR (gB i)
  choose g hg using hlift
  have H1 : RingHom.ker πC.toRingHom =
      Ideal.span (Set.range fun i => MvPolynomial.map πR (g i)) := by
    have : (fun i => MvPolynomial.map πR (g i)) = gB := funext hg
    rw [this, ← hgB]
  have H2 : Algebra.Etale B (MvPolynomial (Fin m) B ⧸
      Ideal.span (Set.range fun i => MvPolynomial.map πR (g i))) := by
    have e1 := Ideal.quotientKerAlgEquivOfSurjective (f := πC) hπC
    have e2 := Ideal.quotientEquivAlgOfEq B (show RingHom.ker πC = _ from H1)
    exact Algebra.Etale.of_equiv (e2.symm.trans e1).symm
  set K := RingHom.ker πR with hKdef

  let Φ : MvPolynomial (Fin m) (MvPolynomial (Fin s) A) →ₐ[A] C :=
    (πC.restrictScalars A).comp (MvPolynomial.mapAlgHom πB)
  have hΦ : Function.Surjective Φ := by
    intro c
    obtain ⟨y, rfl⟩ := hπC c
    obtain ⟨x, rfl⟩ := MvPolynomial.map_surjective πR hπR y
    exact ⟨x, rfl⟩
  have hΦfg := Algebra.FinitePresentation.ker_fG_of_surjective Φ hΦ

  have s3 : RingHom.ker Φ.toRingHom = Ideal.span (Set.range g) ⊔
      Ideal.map (MvPolynomial.C : MvPolynomial (Fin s) A →+* MvPolynomial (Fin m) (MvPolynomial (Fin s) A)) K := by
    have e1 : RingHom.ker Φ.toRingHom =
        Ideal.comap (MvPolynomial.map πR) (RingHom.ker πC.toRingHom) := by
      ext x
      simp only [RingHom.mem_ker, Ideal.mem_comap]
      exact Iff.rfl
    rw [e1, H1]
    have e2 : Ideal.span (Set.range fun i => MvPolynomial.map πR (g i)) =
        Ideal.map (MvPolynomial.map πR) (Ideal.span (Set.range g)) := by
      rw [Ideal.map_span, ← Set.range_comp]
      rfl
    rw [e2, Ideal.comap_map_of_surjective _ (MvPolynomial.map_surjective πR hπR),
      ← RingHom.ker_eq_comap_bot, MvPolynomial.ker_map]
  rw [s3] at hΦfg

  obtain ⟨S, hS⟩ := hΦfg
  have hdec : ∀ x ∈ S, ∃ b ∈ Ideal.map (MvPolynomial.C : MvPolynomial (Fin s) A →+*
      MvPolynomial (Fin m) (MvPolynomial (Fin s) A)) K, x - b ∈ Ideal.span (Set.range g) := by
    intro x hx
    have hx' : x ∈ Ideal.span (Set.range g) ⊔ Ideal.map (MvPolynomial.C : MvPolynomial (Fin s) A →+*
        MvPolynomial (Fin m) (MvPolynomial (Fin s) A)) K := by
      rw [← hS]; exact Submodule.subset_span hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx'
    exact ⟨b, hb, by simpa using ha⟩
  choose! bf hbK hbg using hdec
  let K0 : Finset (MvPolynomial (Fin s) A) :=
    S.biUnion (fun x => (bf x).support.image (fun μ => (bf x).coeff μ))
  have hK0K : (↑K0 : Set (MvPolynomial (Fin s) A)) ⊆ (K : Set (MvPolynomial (Fin s) A)) := by
    intro y hy
    obtain ⟨x, hx, hy'⟩ := Finset.mem_biUnion.mp hy
    obtain ⟨μ, -, rfl⟩ := Finset.mem_image.mp hy'
    exact (MvPolynomial.mem_map_C_iff.mp (hbK x hx)) μ
  have hK0 : Ideal.map (MvPolynomial.C : MvPolynomial (Fin s) A →+*
      MvPolynomial (Fin m) (MvPolynomial (Fin s) A)) K ≤ Ideal.span (Set.range g) ⊔
      Ideal.map MvPolynomial.C (Ideal.span (↑K0 : Set (MvPolynomial (Fin s) A))) := by
    refine le_trans le_sup_right (le_trans (le_of_eq hS.symm) ?_)
    refine Submodule.span_le.mpr (fun x hx => ?_)
    have hb : bf x ∈ Ideal.map (MvPolynomial.C : MvPolynomial (Fin s) A →+*
        MvPolynomial (Fin m) (MvPolynomial (Fin s) A)) (Ideal.span (↑K0 : Set (MvPolynomial (Fin s) A))) := by
      rw [MvPolynomial.mem_map_C_iff]
      intro μ
      by_cases hμ : μ ∈ (bf x).support
      · apply Ideal.subset_span
        exact Finset.mem_coe.mpr (Finset.mem_biUnion.mpr ⟨x, hx, Finset.mem_image.mpr ⟨μ, hμ, rfl⟩⟩)
      · rw [MvPolynomial.notMem_support_iff.mp hμ]; exact Ideal.zero_mem _
    have h := Submodule.add_mem_sup (hbg x hx) hb
    rw [sub_add_cancel] at h
    exact h

  obtain ⟨J, hJdef⟩ : ∃ J : (Finset ↥K)ᵒᵈ → Ideal (MvPolynomial (Fin s) A),
      J = fun T : (Finset ↥K)ᵒᵈ => Ideal.span ((↑K0 : Set (MvPolynomial (Fin s) A)) ∪
        Subtype.val '' ((OrderDual.ofDual T : Finset ↥K) : Set ↥K)) := ⟨_, rfl⟩
  have hJK : ∀ T, J T ≤ K := by
    intro T
    rw [hJdef]
    refine Ideal.span_le.mpr (Set.union_subset hK0K ?_)
    rintro _ ⟨x, -, rfl⟩
    exact x.2
  have hJ0 : ∀ T, (↑K0 : Set (MvPolynomial (Fin s) A)) ⊆ J T := by
    intro T
    rw [hJdef]
    exact fun x hx => Ideal.subset_span (Or.inl hx)
  have hJmono : ∀ i j : (Finset ↥K)ᵒᵈ, j ≤ i → J i ≤ J j := by
    intro i j h
    rw [hJdef]
    apply Ideal.span_mono
    apply Set.union_subset_union_right
    exact Set.image_mono (Finset.coe_subset.mpr (show OrderDual.ofDual i ⊆ OrderDual.ofDual j from h))
  have hJmem : ∀ (T : (Finset ↥K)ᵒᵈ) (x : ↥K), x ∈ OrderDual.ofDual T → x.1 ∈ J T := by
    intro T x hx
    rw [hJdef]
    exact Ideal.subset_span (Or.inr ⟨x, Finset.mem_coe.mpr hx, rfl⟩)
  have hJfg : ∀ T, (J T).FG := by
    intro T
    rw [hJdef]
    exact Submodule.fg_span ((K0.finite_toSet).union ((OrderDual.ofDual T).finite_toSet.image _))
  let φ : ∀ i : (Finset ↥K)ᵒᵈ, MvPolynomial (Fin s) A ⧸ J i →+* B :=
    fun i => Ideal.Quotient.lift (J i) πR (fun a ha => RingHom.mem_ker.mp (hJK i ha))
  let β : ∀ {i j : (Finset ↥K)ᵒᵈ}, (j ⟶ i) →
      (MvPolynomial (Fin s) A ⧸ J i →+* MvPolynomial (Fin s) A ⧸ J j) :=
    fun {i j} f => Ideal.Quotient.factor (hJmono i j (leOfHom f))
  have hβmk : ∀ {i j : (Finset ↥K)ᵒᵈ} (f : j ⟶ i) (p : MvPolynomial (Fin s) A),
      β f (Ideal.Quotient.mk (J i) p) = Ideal.Quotient.mk (J j) p := by
    intro i j f p
    exact Ideal.Quotient.factor_mk _ p
  have hφmk : ∀ (i : (Finset ↥K)ᵒᵈ) (p : MvPolynomial (Fin s) A),
      φ i (Ideal.Quotient.mk (J i) p) = πR p := by
    intro i p
    exact Ideal.Quotient.lift_mk _ _ _
  have hcomp : ∀ {i j k : (Finset ↥K)ᵒᵈ} (f : k ⟶ j) (g : j ⟶ i) (b : MvPolynomial (Fin s) A ⧸ J i),
      β (f ≫ g) b = β f (β g b) := by
    intro i j k f g b
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [hβmk (f ≫ g) p, hβmk g p, hβmk f p]
  have hcompat : ∀ {i j : (Finset ↥K)ᵒᵈ} (f : j ⟶ i) (b : MvPolynomial (Fin s) A ⧸ J i),
      φ j (β f b) = φ i b := by
    intro i j f b
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [hβmk f p, hφmk, hφmk]
  have hsurjc : ∀ b : B, ∃ (i : (Finset ↥K)ᵒᵈ) (x : MvPolynomial (Fin s) A ⧸ J i), φ i x = b := by
    intro b
    obtain ⟨p, rfl⟩ := hπR b
    exact ⟨OrderDual.toDual ∅, Ideal.Quotient.mk _ p, hφmk _ p⟩
  have hvan : ∀ (i : (Finset ↥K)ᵒᵈ) (b : MvPolynomial (Fin s) A ⧸ J i), φ i b = 0 →
      ∃ (j : (Finset ↥K)ᵒᵈ) (f : j ⟶ i), β f b = 0 := by
    intro i b hb
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [hφmk] at hb
    have hp : p ∈ K := RingHom.mem_ker.mpr hb
    let hf : OrderDual.toDual (insert ⟨p, hp⟩ (OrderDual.ofDual i)) ⟶ i :=
      homOfLE (show OrderDual.ofDual i ⊆ insert ⟨p, hp⟩ (OrderDual.ofDual i) from
        Finset.subset_insert _ _)
    refine ⟨OrderDual.toDual (insert ⟨p, hp⟩ (OrderDual.ofDual i)), hf, ?_⟩
    rw [hβmk hf p, Ideal.Quotient.eq_zero_iff_mem]
    exact hJmem _ ⟨p, hp⟩ (Finset.mem_insert_self _ _)
  let i₀ : (Finset ↥K)ᵒᵈ := OrderDual.toDual ∅
  have hId0 : Ideal.span (Set.range fun i => MvPolynomial.map πR (g i)) =
      Ideal.span (Set.range fun i => MvPolynomial.map (φ i₀)
        (MvPolynomial.map (Ideal.Quotient.mk (J i₀)) (g i))) := by
    congr 2
    funext i
    rw [MvPolynomial.map_map]
    congr 1
  obtain ⟨j, fj, hEtj⟩ := colim (Finset ↥K)ᵒᵈ (fun i => MvPolynomial (Fin s) A ⧸ J i) B φ β
    hcomp hcompat hsurjc hvan i₀ m r
    (fun i => MvPolynomial.map (Ideal.Quotient.mk (J i₀)) (g i))
    (Algebra.Etale.of_equiv (Ideal.quotientEquivAlgOfEq B hId0))
  have hIdj : Ideal.span (Set.range fun i => MvPolynomial.map (β fj)
        (MvPolynomial.map (Ideal.Quotient.mk (J i₀)) (g i))) =
      Ideal.span (Set.range fun i => MvPolynomial.map (Ideal.Quotient.mk (J j)) (g i)) := by
    congr 2
    funext i
    rw [MvPolynomial.map_map]
    congr 1

  have H3 : Ideal.map (MvPolynomial.C : MvPolynomial (Fin s) A →+*
      MvPolynomial (Fin m) (MvPolynomial (Fin s) A)) K ≤ Ideal.span (Set.range g) ⊔
      Ideal.map MvPolynomial.C (RingHom.ker (Ideal.Quotient.mk (J j))) := by
    rw [Ideal.mk_ker]
    exact le_trans hK0 (sup_le_sup_left (Ideal.map_mono (Ideal.span_le.mpr (hJ0 j))) _)
  have hgker : ∀ i, πC.toRingHom (MvPolynomial.map πR (g i)) = 0 := by
    intro i
    rw [hg i]
    have hmem : gB i ∈ RingHom.ker πC.toRingHom := by
      rw [← hgB]; exact Submodule.subset_span ⟨i, rfl⟩
    exact hmem
  have hπCC : πC.toRingHom.comp MvPolynomial.C = k := by
    ext b
    exact πC.commutes b
  have hKfg : (RingHom.ker πR).FG :=
    stage (MvPolynomial (Fin s) A) B C (MvPolynomial (Fin s) A ⧸ J j) k πR
      (Ideal.Quotient.mk (J j)) (φ j) hsurj hπR Ideal.Quotient.mk_surjective
      (Ideal.Quotient.lift_comp_mk _ _ _) (by rw [Ideal.mk_ker]; exact hJfg j) m r g
      πC.toRingHom hπCC hgker H3 _ hIdj hEtj
  show Algebra.FinitePresentation A B
  exact ⟨⟨s, πB, hπB, hKfg⟩⟩

theorem wcpa_dj_nc_set_lfp_descend : ∀ (X Y S : Scheme.{u}) (p : X ⟶ Y) (f : Y ⟶ S) (z : X) (V : X.Opens), Etale p → z ∈ V → LocallyOfFinitePresentation (V.ι ≫ p ≫ f) → ∃ U : Y.Opens, p z ∈ U ∧ LocallyOfFinitePresentation (U.ι ≫ f) :=
by
  intro X Y S p f z V hp hzV hlfp
  have key0 : ∀ {T : Scheme.{u}} {A B : T.Opens} (h : A ≤ B), B ≤ A → IsIso (homOfLE h).op := by
    intro T A B h h'
    have : IsIso (homOfLE h) := ⟨homOfLE h', Subsingleton.elim _ _, Subsingleton.elim _ _⟩
    infer_instance

  obtain ⟨S₀, hS₀, hfxS₀, -⟩ := exists_isAffineOpen_mem_and_subset (x := f (p z)) (U := ⊤) trivial
  obtain ⟨W, hW, hxW, hWsub⟩ :=
    exists_isAffineOpen_mem_and_subset (x := p z) (U := f ⁻¹ᵁ S₀) hfxS₀
  obtain ⟨V₀, hV₀, hzV₀, hV₀sub⟩ :=
    exists_isAffineOpen_mem_and_subset (x := z) (U := V ⊓ p ⁻¹ᵁ W) ⟨hzV, hxW⟩

  have hO : IsOpen (⇑p '' (V₀ : Set X)) := p.isOpenMap _ V₀.isOpen
  let O : Y.Opens := W ⊓ ⟨_, hO⟩
  have hxO : p z ∈ O := ⟨hxW, z, hzV₀, rfl⟩
  obtain ⟨b, hbO, hxb⟩ := hW.exists_basicOpen_le (V := O) ⟨p z, hxO⟩ hxW
  have hU : IsAffineOpen (Y.basicOpen b) := hW.basicOpen b
  have e : Y.basicOpen b ≤ f ⁻¹ᵁ S₀ := fun t ht => hWsub (Y.basicOpen_le b ht)
  have eV₀ : V₀ ≤ p ⁻¹ᵁ W := fun t ht => (hV₀sub ht).2
  have hV₁eq := Scheme.basicOpen_appLE p V₀ W eV₀ b
  set V₁ := X.basicOpen ((p.appLE W V₀ eV₀).hom b) with hV₁def
  have hV₁ : IsAffineOpen V₁ := hV₀.basicOpen _
  have eV₁ : V₁ ≤ p ⁻¹ᵁ Y.basicOpen b := by rw [hV₁eq]; exact inf_le_right
  have hV₁V : V₁ ≤ V := by
    rw [hV₁eq]; exact fun t ht => (hV₀sub ht.1).1
  set k := p.appLE (Y.basicOpen b) V₁ eV₁ with hkdef

  have hk : k.hom.Etale := HasRingHomProperty.appLE @Etale p hp ⟨_, hU⟩ ⟨V₁, hV₁⟩ eV₁

  have hsurj : Function.Surjective (PrimeSpectrum.comap k.hom) := by
    intro 𝔮'
    let 𝔮 : Spec Γ(Y, Y.basicOpen b) := 𝔮'
    have hu : hU.fromSpec 𝔮 ∈ Y.basicOpen b := by
      have : hU.fromSpec 𝔮 ∈ Set.range hU.fromSpec := ⟨𝔮, rfl⟩
      rw [hU.range_fromSpec] at this; exact this
    have hu' : hU.fromSpec 𝔮 ∈ O := hbO hu
    obtain ⟨v, hvV₀, hv⟩ := hu'.2
    have hvV₁ : v ∈ V₁ := by
      rw [hV₁eq]
      refine ⟨hvV₀, ?_⟩
      show p v ∈ Y.basicOpen b
      rw [hv]; exact hu
    obtain ⟨𝔭, h𝔭⟩ : v ∈ Set.range hV₁.fromSpec := by rw [hV₁.range_fromSpec]; exact hvV₁
    refine ⟨𝔭, ?_⟩
    have h1 := congrArg (fun φ => φ 𝔭) (IsAffineOpen.SpecMap_appLE_fromSpec p hU hV₁ eV₁)
    simp only [Scheme.Hom.comp_apply] at h1
    rw [h𝔭, hv] at h1
    have := hU.isOpenImmersion_fromSpec
    have h2 := hU.fromSpec.isOpenEmbedding.injective h1
    have h3 : (Spec.map k).base 𝔭 = PrimeSpectrum.comap k.hom 𝔭 := by rw [Spec.map_base]; rfl
    exact h3.symm.trans h2

  have hfp : (k.hom.comp (f.appLE S₀ (Y.basicOpen b) e).hom).FinitePresentation := by
    have hpre : IsAffineOpen (V.ι ⁻¹ᵁ V₁) :=
      hV₁.preimage_of_isOpenImmersion V.ι (by rw [Scheme.Opens.opensRange_ι]; exact hV₁V)
    have e' : V.ι ⁻¹ᵁ V₁ ≤ (V.ι ≫ p ≫ f) ⁻¹ᵁ S₀ := fun t ht => e (eV₁ ht)
    have h := hlfp.finitePresentation_appLE hS₀ hpre e'
    have e2 : V₁ ≤ (p ≫ f) ⁻¹ᵁ S₀ := fun t ht => e (eV₁ ht)
    rw [← Scheme.Hom.appLE_comp_appLE V.ι (p ≫ f) S₀ V₁ (V.ι ⁻¹ᵁ V₁) e2 le_rfl] at h
    have hle1 : V.ι ''ᵁ (V.ι ⁻¹ᵁ V₁) ≤ V₁ := fun t ht => by
      obtain ⟨s, hs, rfl⟩ := ht; exact hs
    have hle2 : V₁ ≤ V.ι ''ᵁ (V.ι ⁻¹ᵁ V₁) := fun t ht => ⟨⟨t, hV₁V ht⟩, ht, rfl⟩
    have hI : IsIso (V.ι.appLE V₁ (V.ι ⁻¹ᵁ V₁) le_rfl) := by
      rw [Scheme.Hom.appLE]
      have h1 : IsIso (V.ι.app V₁) := by
        rw [Scheme.Opens.ι_app]
        have := key0 (T := X) (A := V.ι ''ᵁ V.ι ⁻¹ᵁ V₁) (B := V₁) hle1 hle2
        apply Functor.map_isIso
      have h2 : IsIso (homOfLE (le_rfl : V.ι ⁻¹ᵁ V₁ ≤ V.ι ⁻¹ᵁ V₁)).op := key0 le_rfl le_rfl
      infer_instance
    have hA := (RingHom.finitePresentation_respectsIso.cancel_right_isIso _ _).mp h
    rw [← Scheme.Hom.appLE_comp_appLE p f S₀ (Y.basicOpen b) V₁ e eV₁] at hA
    exact hA
  have hft : (f.appLE S₀ (Y.basicOpen b) e).hom.FiniteType :=
    wcpa_dj_nc_lfp_ring_ft_descend _ _ _ _ k.hom hk hsurj (RingHom.FiniteType.of_finitePresentation hfp)
  have hfp' : (f.appLE S₀ (Y.basicOpen b) e).hom.FinitePresentation :=
    wcpa_dj_nc_lfp_ring_fp_descend _ _ _ _ k.hom hk hsurj hft hfp
  refine ⟨Y.basicOpen b, hxb, ?_⟩
  have : IsAffine (Y.basicOpen b).toScheme := hU
  rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation)
    (RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.finitePresentation_holdsForLocalizationAway).1]
  intro x
  have eT : (⊤ : (Y.basicOpen b).toScheme.Opens) ≤ ((Y.basicOpen b).ι ≫ f) ⁻¹ᵁ S₀ :=
    fun t _ => e t.2
  refine ⟨⟨S₀, hS₀⟩, ⟨⊤, isAffineOpen_top _⟩, trivial, eT, ?_⟩
  have eT2 : (⊤ : (Y.basicOpen b).toScheme.Opens) ≤ (Y.basicOpen b).ι ⁻¹ᵁ (Y.basicOpen b) :=
    fun t _ => t.2
  show (((Y.basicOpen b).ι ≫ f).appLE S₀ ⊤ eT).hom.FinitePresentation
  rw [← Scheme.Hom.appLE_comp_appLE (Y.basicOpen b).ι f S₀ (Y.basicOpen b) ⊤ e eT2]
  have hI : IsIso ((Y.basicOpen b).ι.appLE (Y.basicOpen b) ⊤ eT2) := by
    rw [Scheme.Hom.appLE]
    have h1 : IsIso ((Y.basicOpen b).ι.app (Y.basicOpen b)) := by
      rw [Scheme.Opens.ι_app]
      have := key0 (T := Y) (A := (Y.basicOpen b).ι ''ᵁ (Y.basicOpen b).ι ⁻¹ᵁ (Y.basicOpen b))
        (B := Y.basicOpen b) (by simp) (by simp)
      apply Functor.map_isIso
    have h2 : IsIso (homOfLE eT2).op := key0 eT2 le_top
    infer_instance
  exact (RingHom.finitePresentation_respectsIso.cancel_right_isIso _ _).mpr hfp'

theorem wcpa_dj_nc_set_stalk_fs : ∀ (Y₁ Y₂ S : Scheme.{u}) (h : Y₁ ⟶ Y₂) (g : Y₂ ⟶ S) (y : Y₁) (V : Y₁.Opens) (U : Y₂.Opens) (hU : h y ∈ U), Etale h → y ∈ V → Smooth (V.ι ≫ h ≫ g) → LocallyOfFinitePresentation (U.ι ≫ g) → ((U.ι ≫ g).stalkMap ⟨h y, hU⟩).hom.FormallySmooth :=
by
  have wcpa_dj_nc_sfs_std_etale_lift : ∀ (P B E : Type u) [CommRing P] [CommRing B] [CommRing E] [Algebra P B] [Algebra B E] [Algebra P E] [IsScalarTower P B E], Function.Surjective (algebraMap P B) → Algebra.IsStandardEtale B E → ∃ (Pr : StandardEtalePair P) (ψ : Pr.Ring →ₐ[P] E), Function.Surjective ψ ∧ RingHom.ker ψ = Ideal.map (algebraMap P Pr.Ring) (RingHom.ker (algebraMap P B)) := by
    intro P B E _ _ _ _ _ _ _ hπ hst
    let SP : StandardEtalePresentation B E := hst.nonempty_standardEtalePresentation.some
    have hmap := Polynomial.map_surjective (algebraMap P B) hπ
    obtain ⟨F, hF, -, hFm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts _).mpr (hmap SP.P.f)) SP.P.monic_f
    obtain ⟨p₁, p₂, n, hcond⟩ := SP.P.cond
    obtain ⟨G₀, hG₀⟩ := hmap SP.P.g
    obtain ⟨q₁, hq₁⟩ := hmap p₁
    obtain ⟨q₂, hq₂⟩ := hmap p₂
    let G : Polynomial P := G₀ * (Polynomial.derivative F * q₁ + F * q₂)
    have hG : Polynomial.map (algebraMap P B) G = SP.P.g ^ (n + 1) := by
      simp only [G, Polynomial.map_mul, Polynomial.map_add, ← Polynomial.derivative_map, hF, hG₀,
        hq₁, hq₂, hcond]
      ring
    let Pr : StandardEtalePair P :=
      { f := F
        monic_f := hFm
        g := G
        cond := ⟨G₀ * q₁, G₀ * q₂, 1, by simp only [G]; ring⟩ }
    have haux : ∀ {T : Type u} [CommRing T] [Algebra P T] [Algebra B T] [IsScalarTower P B T]
        (t : T) (p : Polynomial P),
        Polynomial.aeval t (Polynomial.map (algebraMap P B) p) = Polynomial.aeval t p := by
      intro T _ _ _ _ t p
      rw [Polynomial.aeval_map_algebraMap]
    have hPr : Pr.HasMap SP.x := by
      refine ⟨?_, ?_⟩
      · show Polynomial.aeval SP.x F = 0
        rw [← haux, hF]
        exact SP.hasMap.1
      · show IsUnit (Polynomial.aeval SP.x G)
        rw [← haux, hG, map_pow]
        exact SP.hasMap.2.pow _
    let ψ : Pr.Ring →ₐ[P] E := Pr.lift SP.x hPr
    have hψX : ψ Pr.X = SP.x := Pr.lift_X _ _
    have hψaeval : ∀ q : Polynomial P, ψ (Polynomial.aeval Pr.X q) = Polynomial.aeval SP.x q := by
      intro q
      rw [← Polynomial.aeval_algHom_apply, hψX]
    refine ⟨Pr, ψ, ?_, ?_⟩
    ·
      obtain ⟨Y, hY⟩ : ∃ Y : Pr.Ring, Polynomial.aeval Pr.X Pr.g * Y = 1 :=
        ⟨_, Pr.aeval_X_g_mul_mk_X⟩
      have hv : (Polynomial.aeval SP.x SP.P.g) ^ (n + 1) * ψ Y = 1 := by
        have := congrArg ψ hY
        rw [map_mul, map_one] at this
        change ψ (Polynomial.aeval Pr.X G) * ψ Y = 1 at this
        rw [hψaeval, ← haux, hG, map_pow] at this
        exact this
      have hG₀x : Polynomial.aeval SP.x G₀ = Polynomial.aeval SP.x SP.P.g := by
        rw [← haux, hG₀]
      intro e
      obtain ⟨p, m, hp⟩ := SP.exists_mul_aeval_x_g_pow_eq_aeval_x e
      obtain ⟨p', hp'⟩ := hmap p
      refine ⟨Polynomial.aeval Pr.X p' * Polynomial.aeval Pr.X G₀ ^ (n * m) * Y ^ m, ?_⟩
      rw [map_mul, map_mul, map_pow, map_pow, hψaeval, hψaeval, hG₀x, ← haux, hp', ← hp]
      calc _ = e * ((Polynomial.aeval SP.x SP.P.g) ^ (n + 1) * ψ Y) ^ m := by ring
        _ = e := by rw [hv, one_pow, mul_one]
    ·
      apply le_antisymm
      · intro z hz
        let J : Ideal Pr.Ring := Ideal.map (algebraMap P Pr.Ring) (RingHom.ker (algebraMap P B))
        let φ0 : P →+* Pr.Ring ⧸ J := (Ideal.Quotient.mk J).comp (algebraMap P Pr.Ring)
        have hle : RingHom.ker (algebraMap P B) ≤ RingHom.ker φ0 := by
          intro i hi
          rw [RingHom.mem_ker]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hi)
        let β : B →+* Pr.Ring ⧸ J := (algebraMap P B).liftOfSurjective hπ ⟨φ0, hle⟩
        letI : Algebra B (Pr.Ring ⧸ J) := β.toAlgebra
        haveI : IsScalarTower P B (Pr.Ring ⧸ J) := by
          apply IsScalarTower.of_algebraMap_eq
          intro x
          rw [RingHom.algebraMap_toAlgebra]
          exact (RingHom.liftOfSurjective_comp_apply (algebraMap P B) hπ ⟨φ0, hle⟩ x).symm
        let Xb : Pr.Ring ⧸ J := Ideal.Quotient.mkₐ P J Pr.X
        have hXb : SP.P.HasMap Xb := by
          refine ⟨?_, ?_⟩
          · rw [← hF, haux, Polynomial.aeval_algHom_apply]
            have : Polynomial.aeval Pr.X F = 0 := Pr.hasMap_X.1
            rw [this, map_zero]
          · refine (isUnit_pow_iff (Nat.succ_ne_zero n)).mp ?_
            rw [← map_pow, ← hG, haux, Polynomial.aeval_algHom_apply]
            exact (Pr.hasMap_X.2 : IsUnit (Polynomial.aeval Pr.X G)).map _
        let θ : E →ₐ[B] Pr.Ring ⧸ J := (SP.P.lift Xb hXb).comp SP.equivRing.toAlgHom
        have hθ : θ SP.x = Xb := by
          show SP.P.lift Xb hXb (SP.equivRing SP.x) = Xb
          rw [SP.equivRing_x]
          exact StandardEtalePair.lift_X SP.P Xb hXb
        have hext : (θ.restrictScalars P).comp ψ = Ideal.Quotient.mkₐ P J := by
          apply Pr.hom_ext
          rw [AlgHom.comp_apply, hψX, AlgHom.restrictScalars_apply, hθ]
        have h1 := congrArg (fun φ => φ z) hext
        simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply] at h1
        rw [RingHom.mem_ker] at hz
        rw [hz, map_zero] at h1
        exact Ideal.Quotient.eq_zero_iff_mem.mp ((Ideal.Quotient.mkₐ_eq_mk P J ▸ h1.symm :))
      · rw [Ideal.map_le_iff_le_comap]
        intro i hi
        rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, IsScalarTower.algebraMap_apply P B E,
          RingHom.mem_ker.mp hi, map_zero]
  have wcpa_dj_nc_sfs_h1_tensor_vanish : ∀ (A P B E : Type u) [CommRing A] [CommRing P] [CommRing B] [CommRing E] [Algebra A P] [Algebra A B] [Algebra P B] [IsScalarTower A P B] [Algebra B E] [Algebra A E] [IsScalarTower A B E] [Algebra P E] [IsScalarTower P B E] (Pr : StandardEtalePair P) (ψ : Pr.Ring →ₐ[P] E), Algebra.FormallySmooth A P → Module.Flat B E → Algebra.FormallySmooth A E → Function.Surjective (algebraMap P B) → Function.Surjective ψ → RingHom.ker ψ = Ideal.map (algebraMap P Pr.Ring) (RingHom.ker (algebraMap P B)) → Subsingleton (TensorProduct B E (Algebra.H1Cotangent A B)) := by
    intro A P B E _ _ _ _ _ _ _ _ _ _ _ _ _ Pr ψ hAP hflat hAE hπ hψ hker
    letI : Algebra A Pr.Ring := ((algebraMap P Pr.Ring).comp (algebraMap A P)).toAlgebra
    haveI : IsScalarTower A P Pr.Ring := .of_algebraMap_eq' rfl
    haveI : IsScalarTower A P E := by
      apply IsScalarTower.of_algebraMap_eq
      intro a
      rw [IsScalarTower.algebraMap_apply A B E, IsScalarTower.algebraMap_apply A P B,
        ← IsScalarTower.algebraMap_apply P B E]
    let 𝒳 : Algebra.Extension A B := Algebra.Extension.ofSurjective (IsScalarTower.toAlgHom A P B) hπ
    let 𝒬 : Algebra.Extension A E := Algebra.Extension.ofSurjective (ψ.restrictScalars A) hψ
    let f : 𝒳.Hom 𝒬 :=
      { toRingHom := algebraMap P Pr.Ring
        toRingHom_algebraMap := fun x => (IsScalarTower.algebraMap_apply A P Pr.Ring x).symm
        algebraMap_toRingHom := fun (x : P) =>
          (ψ.commutes x).trans (IsScalarTower.algebraMap_apply P B E x) }
    letI alg : Algebra 𝒳.Ring 𝒬.Ring := (inferInstance : Algebra P Pr.Ring)
    have halg : algebraMap 𝒳.Ring 𝒬.Ring = f.toRingHom := rfl
    have H₁ : f.toRingHom.FormallyEtale :=
      RingHom.formallyEtale_algebraMap.mpr (inferInstance : Algebra.FormallyEtale P Pr.Ring)
    haveI : Module.Flat 𝒳.Ring 𝒬.Ring := (inferInstance : Module.Flat P Pr.Ring)
    let F := (f.mapKer halg).liftBaseChange 𝒬.Ring
    have H₂ : Function.Bijective F := by
      constructor
      · have key : ∀ x : TensorProduct 𝒳.Ring 𝒬.Ring 𝒳.ker,
            ((F x : 𝒬.ker) : 𝒬.Ring) =
              TensorProduct.rid 𝒳.Ring 𝒬.Ring (LinearMap.lTensor 𝒬.Ring 𝒳.ker.subtype x) := by
          intro x
          induction x using TensorProduct.induction_on with
          | zero => simp
          | tmul r i =>
            simp only [F, LinearMap.liftBaseChange_tmul, Submodule.coe_smul,
              Algebra.Extension.Hom.mapKer_apply_coe, LinearMap.lTensor_tmul, TensorProduct.rid_tmul,
              Submodule.coe_subtype, smul_eq_mul, Algebra.smul_def, halg]
            exact mul_comm _ _
          | add x y hx hy =>
            rw [map_add, Submodule.coe_add, hx, hy, map_add, map_add]
        intro x y hxy
        have hinj : Function.Injective (LinearMap.lTensor 𝒬.Ring 𝒳.ker.subtype) :=
          Module.Flat.lTensor_preserves_injective_linearMap _ 𝒳.ker.injective_subtype
        apply hinj
        apply (TensorProduct.rid 𝒳.Ring 𝒬.Ring).injective
        rw [← key, ← key, hxy]
      · intro z
        have hz : (z : 𝒬.Ring) ∈ RingHom.ker ψ := z.2
        rw [hker] at hz
        change (z : 𝒬.Ring) ∈ Ideal.span _ at hz
        have gen : ∀ w : 𝒬.Ring, w ∈ Ideal.span
            (⇑(algebraMap P Pr.Ring) '' (RingHom.ker (algebraMap P B) : Set P)) →
            ∃ x, ((F x : 𝒬.ker) : 𝒬.Ring) = w := by
          intro w hw
          induction hw using Submodule.span_induction with
          | mem a ha =>
            obtain ⟨i, hi, rfl⟩ := ha
            refine ⟨1 ⊗ₜ ⟨i, hi⟩, ?_⟩
            simp only [F, LinearMap.liftBaseChange_tmul, one_smul,
              Algebra.Extension.Hom.mapKer_apply_coe]
            rfl
          | zero => exact ⟨0, by rw [map_zero]; rfl⟩
          | add a b _ _ ha hb =>
            obtain ⟨x, hx⟩ := ha
            obtain ⟨y, hy⟩ := hb
            exact ⟨x + y, by rw [map_add, Submodule.coe_add, hx, hy]; rfl⟩
          | smul r a _ ha =>
            obtain ⟨x, hx⟩ := ha
            refine ⟨(show 𝒬.Ring from r) • x, ?_⟩
            rw [map_smul, Submodule.coe_smul, hx]
            rfl
        obtain ⟨x, hx⟩ := gen _ hz
        exact ⟨x, Subtype.ext hx⟩
    have e₁ := Algebra.Extension.tensorH1CotangentOfFormallyEtale f halg H₁ H₂
    haveI : Algebra.FormallySmooth A 𝒬.Ring := Algebra.FormallySmooth.comp A P Pr.Ring
    haveI : Algebra.FormallySmooth A 𝒳.Ring := hAP
    have e₂ := Algebra.Extension.equivH1CotangentOfFormallySmooth 𝒬
    have e₃ := Algebra.Extension.equivH1CotangentOfFormallySmooth 𝒳
    haveI : Subsingleton (Algebra.H1Cotangent A E) := inferInstance
    haveI : Subsingleton 𝒬.H1Cotangent := e₂.toEquiv.subsingleton
    haveI : Subsingleton (TensorProduct B E 𝒳.H1Cotangent) := e₁.toEquiv.subsingleton
    exact (LinearEquiv.lTensor E (e₃.restrictScalars B)).symm.toEquiv.subsingleton
  have wcpa_dj_nc_sfs_h1_localize : ∀ (B E : Type u) [CommRing B] [CommRing E] [Algebra B E] (c : E) (Q : Ideal E) [Q.IsPrime] (𝔭 : Ideal B) [𝔭.IsPrime] (H : Type u) [AddCommGroup H] [Module B H], Module.Flat B E → c ∉ Q → Q.comap (algebraMap B E) = 𝔭 → Subsingleton (TensorProduct B (Localization.Away c) H) → Subsingleton (TensorProduct B (Localization.AtPrime 𝔭) H) := by
    intro B E _ _ _ c Q _ 𝔭 _ H _ _ hflat hcQ hQ hsub
    haveI : Q.LiesOver 𝔭 := ⟨hQ.symm⟩
    letI : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime Q) :=
      Localization.AtPrime.algebraOfLiesOver 𝔭 Q
    haveI : Module.Flat (Localization.AtPrime 𝔭) (Localization.AtPrime Q) := by
      rw [← RingHom.flat_algebraMap_iff, Localization.AtPrime.algebraMap_eq 𝔭 Q]
      exact RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr hflat) _ _ _
    haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime Q)) := by
      rw [Localization.AtPrime.algebraMap_eq 𝔭 Q]
      exact Localization.isLocalHom_localRingHom _ _ _ _
    haveI : Module.FaithfullyFlat (Localization.AtPrime 𝔭) (Localization.AtPrime Q) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hunit : IsUnit (algebraMap E (Localization.AtPrime Q) c) :=
      IsLocalization.map_units (Localization.AtPrime Q) (⟨c, hcQ⟩ : Q.primeCompl)
    letI : Algebra (Localization.Away c) (Localization.AtPrime Q) :=
      (IsLocalization.Away.lift c hunit).toAlgebra
    haveI : IsScalarTower B (Localization.Away c) (Localization.AtPrime Q) := by
      apply IsScalarTower.of_algebraMap_eq
      intro b
      rw [RingHom.algebraMap_toAlgebra, IsScalarTower.algebraMap_apply B E (Localization.Away c),
        IsLocalization.Away.lift_eq, ← IsScalarTower.algebraMap_apply]
    haveI : Subsingleton (TensorProduct (Localization.Away c) (Localization.AtPrime Q)
        (TensorProduct B (Localization.Away c) H)) := inferInstance
    have e1 := TensorProduct.AlgebraTensorModule.cancelBaseChange B (Localization.Away c)
      (Localization.AtPrime Q) (Localization.AtPrime Q) H
    haveI : Subsingleton (TensorProduct B (Localization.AtPrime Q) H) := e1.symm.toEquiv.subsingleton
    have e2 := TensorProduct.AlgebraTensorModule.cancelBaseChange B (Localization.AtPrime 𝔭)
      (Localization.AtPrime Q) (Localization.AtPrime Q) H
    haveI : Subsingleton (TensorProduct (Localization.AtPrime 𝔭) (Localization.AtPrime Q)
        (TensorProduct B (Localization.AtPrime 𝔭) H)) := e2.toEquiv.subsingleton
    exact Module.FaithfullyFlat.lTensor_reflects_triviality (Localization.AtPrime 𝔭)
      (Localization.AtPrime Q) _
  have wcpa_dj_nc_sfs_omega_projective : ∀ (A B E : Type u) [CommRing A] [CommRing B] [CommRing E] [Algebra A B] [Algebra B E] [Algebra A E] [IsScalarTower A B E], Algebra.Etale B E → Algebra.FormallySmooth A E → Algebra.FinitePresentation A B → ∀ (Q : Ideal E) [Q.IsPrime] (𝔭 : Ideal B) [𝔭.IsPrime], Q.comap (algebraMap B E) = 𝔭 → Module.Projective (Localization.AtPrime 𝔭) Ω[Localization.AtPrime 𝔭⁄A] := by
    intro A B E _ _ _ _ _ _ _ hE hS hP Q _ 𝔭 _ hQ
    haveI : Q.LiesOver 𝔭 := ⟨hQ.symm⟩
    letI : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime Q) :=
      Localization.AtPrime.algebraOfLiesOver 𝔭 Q
    haveI : Module.Flat (Localization.AtPrime 𝔭) (Localization.AtPrime Q) := by
      rw [← RingHom.flat_algebraMap_iff, Localization.AtPrime.algebraMap_eq 𝔭 Q]
      exact RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) _ _ _
    haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime Q)) := by
      rw [Localization.AtPrime.algebraMap_eq 𝔭 Q]
      exact Localization.isLocalHom_localRingHom _ _ _ _
    haveI : Module.FaithfullyFlat (Localization.AtPrime 𝔭) (Localization.AtPrime Q) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    haveI : IsScalarTower A (Localization.AtPrime 𝔭) (Localization.AtPrime Q) := by
      apply IsScalarTower.of_algebraMap_eq
      intro a
      rw [IsScalarTower.algebraMap_apply A B (Localization.AtPrime 𝔭),
        ← IsScalarTower.algebraMap_apply B (Localization.AtPrime 𝔭) (Localization.AtPrime Q),
        IsScalarTower.algebraMap_apply A E (Localization.AtPrime Q),
        IsScalarTower.algebraMap_apply A B E,
        ← IsScalarTower.algebraMap_apply B E (Localization.AtPrime Q)]
    haveI : Algebra.FormallyEtale E (Localization.AtPrime Q) :=
      Algebra.FormallyEtale.of_isLocalization Q.primeCompl
    haveI : Algebra.FormallyEtale B (Localization.AtPrime Q) :=
      Algebra.FormallyEtale.comp B E (Localization.AtPrime Q)
    haveI : Algebra.FormallyEtale (Localization.AtPrime 𝔭) (Localization.AtPrime Q) :=
      Algebra.FormallyEtale.localization_base 𝔭.primeCompl
    haveI : Algebra.FormallySmooth E (Localization.AtPrime Q) :=
      Algebra.FormallySmooth.of_isLocalization Q.primeCompl
    haveI : Algebra.FormallySmooth A (Localization.AtPrime Q) :=
      Algebra.FormallySmooth.comp A E (Localization.AtPrime Q)
    haveI : Module.Flat (Localization.AtPrime Q) Ω[Localization.AtPrime Q⁄A] :=
      Module.Flat.of_projective
    have e := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A (Localization.AtPrime 𝔭)
      (Localization.AtPrime Q)
    haveI : Module.Flat (Localization.AtPrime Q)
        (TensorProduct (Localization.AtPrime 𝔭) (Localization.AtPrime Q)
          Ω[Localization.AtPrime 𝔭⁄A]) := Module.Flat.of_linearEquiv e
    haveI : Module.Flat (Localization.AtPrime 𝔭) Ω[Localization.AtPrime 𝔭⁄A] :=
      (Module.Flat.iff_flat_tensorProduct _ _ (Localization.AtPrime Q)).mp inferInstance
    haveI : Algebra.FormallyEtale B (Localization.AtPrime 𝔭) :=
      Algebra.FormallyEtale.of_isLocalization 𝔭.primeCompl
    haveI : Module.FinitePresentation (Localization.AtPrime 𝔭) Ω[Localization.AtPrime 𝔭⁄A] :=
      FinitePresentation.of_isBaseChange (KaehlerDifferential.map A A B (Localization.AtPrime 𝔭))
        (KaehlerDifferential.isBaseChange_of_formallyEtale A B (Localization.AtPrime 𝔭))
    exact Module.Flat.projective_of_finitePresentation
  intro Y₁ Y₂ S h g y V U hU hh hyV hsm hlfp

  have ringFS : ∀ (A B E : Type u) [CommRing A] [CommRing B] [CommRing E] [Algebra A B]
      [Algebra B E] [Algebra A E] [IsScalarTower A B E], Algebra.Etale B E →
      Algebra.FormallySmooth A E → Algebra.FinitePresentation A B →
      ∀ (Q : Ideal E) [Q.IsPrime] (𝔭 : Ideal B) [𝔭.IsPrime], Q.comap (algebraMap B E) = 𝔭 →
      Algebra.FormallySmooth A (Localization.AtPrime 𝔭) := by
    intro A B E _ _ _ _ _ _ _ hE hS hP Q _ 𝔭 _ hQ
    haveI : Algebra.IsEtaleAt B Q := Algebra.FormallyEtale.comp B E (Localization.AtPrime Q)
    obtain ⟨c, hcQ, hc⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := B) Q
    haveI := hc
    haveI : IsScalarTower A B (Localization.Away c) := IsScalarTower.to₁₂₄ A B E _
    letI P := (Algebra.Generators.self A B).toExtension.Ring
    haveI : Algebra.FormallySmooth A P := inferInstanceAs (Algebra.FormallySmooth A (MvPolynomial B A))
    letI : Algebra P (Localization.Away c) :=
      ((algebraMap B (Localization.Away c)).comp (algebraMap P B)).toAlgebra
    haveI : IsScalarTower P B (Localization.Away c) := .of_algebraMap_eq' rfl
    obtain ⟨Pr, ψ, hψ, hker⟩ := wcpa_dj_nc_sfs_std_etale_lift P B (Localization.Away c)
      (Algebra.Extension.algebraMap_surjective _) hc
    have h2 := wcpa_dj_nc_sfs_h1_tensor_vanish A P B (Localization.Away c) Pr ψ inferInstance
      inferInstance inferInstance (Algebra.Extension.algebraMap_surjective _) hψ hker
    have h3 := wcpa_dj_nc_sfs_h1_localize B E c Q 𝔭 (Algebra.H1Cotangent A B) inferInstance hcQ hQ h2
    have e := Algebra.tensorH1CotangentOfIsLocalization A (Localization.AtPrime 𝔭) 𝔭.primeCompl
    haveI : Subsingleton (Algebra.H1Cotangent A (Localization.AtPrime 𝔭)) :=
      e.symm.toEquiv.subsingleton
    exact Algebra.FormallySmooth.mk (wcpa_dj_nc_sfs_omega_projective A B E hE hS hP Q 𝔭 hQ)
      inferInstance

  let T : Y₁.Opens := V ⊓ h ⁻¹ᵁ U
  have htT : y ∈ T := ⟨hyV, hU⟩
  let t : T.toScheme := ⟨y, htT⟩
  let k : T.toScheme ⟶ U.toScheme := Y₁.homOfLE (inf_le_right : T ≤ h ⁻¹ᵁ U) ≫ (h ∣_ U)
  haveI : Etale k := inferInstance
  have hkι : k ≫ U.ι = T.ι ≫ h := by
    simp only [k, Category.assoc]
    rw [morphismRestrict_ι, ← Category.assoc, Scheme.homOfLE_ι]
  have hkf : k ≫ U.ι ≫ g = Y₁.homOfLE (inf_le_left : T ≤ V) ≫ V.ι ≫ h ≫ g := by
    rw [← Category.assoc, hkι, ← Category.assoc (Y₁.homOfLE _), Scheme.homOfLE_ι,
      Category.assoc]
  haveI : Smooth (k ≫ U.ι ≫ g) := by rw [hkf]; infer_instance
  have hkt : k t = ⟨h y, hU⟩ := by
    apply Subtype.ext
    have e1 : (k ≫ U.ι) t = h y := by
      rw [hkι, Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]
    rw [Scheme.Hom.comp_apply] at e1
    exact e1
  rw [← hkt]
  obtain ⟨S₀, hS₀, hfS₀, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := (U.ι ≫ g) (k t)) (U := ⊤) trivial
  obtain ⟨W, hW, hkW, hWsub⟩ := exists_isAffineOpen_mem_and_subset
    (x := k t) (U := (U.ι ≫ g) ⁻¹ᵁ S₀) hfS₀
  obtain ⟨T₀, hT₀, htT₀, hT₀sub⟩ := exists_isAffineOpen_mem_and_subset
    (x := t) (U := k ⁻¹ᵁ W) hkW
  have hWS : W ≤ (U.ι ≫ g) ⁻¹ᵁ S₀ := hWsub
  have hTW : T₀ ≤ k ⁻¹ᵁ W := hT₀sub
  have hsmooth := Scheme.Hom.smooth_appLE (k ≫ U.ι ≫ g) hS₀ hT₀
    (hTW.trans (fun x hx => hWS hx))
  rw [← Scheme.Hom.appLE_comp_appLE k (U.ι ≫ g) S₀ W T₀ hWS hTW, CommRingCat.hom_comp]
    at hsmooth
  have hetale : RingHom.Etale (k.appLE W T₀ hTW).hom :=
    HasRingHomProperty.appLE @Etale k inferInstance ⟨W, hW⟩ ⟨T₀, hT₀⟩ hTW
  have hfp : RingHom.FinitePresentation ((U.ι ≫ g).appLE S₀ W hWS).hom :=
    Scheme.Hom.finitePresentation_appLE (U.ι ≫ g) hS₀ hW hWS
  letI := ((U.ι ≫ g).appLE S₀ W hWS).hom.toAlgebra
  letI := (k.appLE W T₀ hTW).hom.toAlgebra
  letI := ((k.appLE W T₀ hTW).hom.comp ((U.ι ≫ g).appLE S₀ W hWS).hom).toAlgebra
  haveI : IsScalarTower Γ(S, S₀) Γ(U.toScheme, W) Γ(T.toScheme, T₀) := .of_algebraMap_eq' rfl
  have hE : Algebra.Etale Γ(U.toScheme, W) Γ(T.toScheme, T₀) := hetale
  have hFS : Algebra.FormallySmooth Γ(S, S₀) Γ(T.toScheme, T₀) :=
    (RingHom.Smooth.toAlgebra hsmooth).formallySmooth
  have hFP : Algebra.FinitePresentation Γ(S, S₀) Γ(U.toScheme, W) := hfp
  have hprime := IsAffineOpen.comap_primeIdealOf_appLE W hW T₀ hT₀ hTW htT₀
  have hQ : (hT₀.primeIdealOf ⟨t, htT₀⟩).asIdeal.comap
      (algebraMap Γ(U.toScheme, W) Γ(T.toScheme, T₀)) = (hW.primeIdealOf ⟨k t, hkW⟩).asIdeal := by
    have e2 := congrArg PrimeSpectrum.asIdeal hprime
    rw [PrimeSpectrum.comap_asIdeal] at e2
    exact e2
  have hfin := ringFS _ _ _ hE hFS hFP _ _ hQ
  exact (formallySmooth_stalkMap_iff S₀ hS₀ W hW hWS hkW).mpr hfin

theorem wcpa_dj_nc_smooth_etale_transfer : ∀ (Y₁ Y₂ S : Scheme.{u}) (h : Y₁ ⟶ Y₂) (g : Y₂ ⟶ S) (y : Y₁), Etale h → ((∃ U : Y₂.Opens, h y ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ g)) ↔ (∃ U : Y₁.Opens, y ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ h ≫ g))) :=
by
  intro Y₁ Y₂ S h g y hh

  have localRelDim : ∀ {Z T : Scheme.{u}} (φ : Z ⟶ T) [Smooth φ] (z : Z),
      ∃ (V₀ : Z.Opens) (m : ℕ), z ∈ V₀ ∧ SmoothOfRelativeDimension m (V₀.ι ≫ φ) := by
    intro Z T φ _ z
    obtain ⟨U₀, hU₀, V₀, hV₀, hz, e, hstd⟩ := Smooth.exists_isStandardSmooth (f := φ) z
    letI := (φ.appLE U₀ V₀ e).hom.toAlgebra
    haveI : Algebra.IsStandardSmooth Γ(T, U₀) Γ(Z, V₀) := hstd
    obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := Algebra.IsStandardSmooth.out (R := Γ(T, U₀)) (S := Γ(Z, V₀))
    have hrd : RingHom.IsStandardSmoothOfRelativeDimension P.dimension (φ.appLE U₀ V₀ e).hom :=
      Algebra.IsStandardSmoothOfRelativeDimension.mk ⟨ι, σ, inferInstance, inferInstance, P, rfl⟩
    refine ⟨V₀, P.dimension, hz, ?_⟩
    rw [smoothOfRelativeDimension_iff]
    intro x
    have e2 : (⊤ : V₀.toScheme.Opens) ≤ V₀.ι ⁻¹ᵁ V₀ := by simp
    have e3 : (⊤ : V₀.toScheme.Opens) ≤ (V₀.ι ≫ φ) ⁻¹ᵁ U₀ := fun t _ => e t.2
    haveI : IsAffine V₀.toScheme := hV₀
    refine ⟨U₀, hU₀, ⊤, isAffineOpen_top _, trivial, e3, ?_⟩
    rw [← Scheme.Hom.appLE_comp_appLE V₀.ι φ U₀ V₀ ⊤ e e2, CommRingCat.hom_comp]
    have key : ∀ {T : Scheme.{u}} {A B : T.Opens} (h : A ≤ B), B ≤ A → IsIso (homOfLE h).op := by
      intro T A B h h'
      have : IsIso (homOfLE h) := ⟨homOfLE h', Subsingleton.elim _ _, Subsingleton.elim _ _⟩
      infer_instance
    haveI : IsIso (V₀.ι.appLE V₀ ⊤ e2) := by
      rw [Scheme.Hom.appLE]
      have h1 : IsIso (V₀.ι.app V₀) := by
        rw [Scheme.Opens.ι_app]
        have := key (T := Z) (A := V₀.ι ''ᵁ V₀.ι ⁻¹ᵁ V₀) (B := V₀) (by simp) (by simp)
        apply Functor.map_isIso
      have h2 : IsIso (homOfLE e2).op := key e2 le_top
      infer_instance
    exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.1 _
      (asIso (V₀.ι.appLE V₀ ⊤ e2)).commRingCatIsoToRingEquiv hrd
  constructor
  ·
    rintro ⟨U, hU, hsm⟩
    refine ⟨h ⁻¹ᵁ U, hU, ?_⟩
    have e1 : (h ⁻¹ᵁ U).ι ≫ h ≫ g = (h ∣_ U) ≫ U.ι ≫ g := by
      rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    rw [e1]
    exact smoothOfRelativeDimension_comp 0 1 (h ∣_ U) (U.ι ≫ g)
  ·
    rintro ⟨V, hyV, hsm⟩
    haveI hsmooth : Smooth (V.ι ≫ h ≫ g) := SmoothOfRelativeDimension.smooth 1 _
    obtain ⟨U, hU, hlfp⟩ := wcpa_dj_nc_set_lfp_descend Y₁ Y₂ S h g y V hh hyV inferInstance
    have hfs := wcpa_dj_nc_set_stalk_fs Y₁ Y₂ S h g y V U hU hh hyV hsmooth hlfp
    obtain ⟨U₂, hU₂, hsm₂⟩ := wc_ldp_il_spread_rel (U.ι ≫ g) ⟨h y, hU⟩ hfs
    obtain ⟨V₀, m, hV₀, hm⟩ := localRelDim (U₂.ι ≫ U.ι ≫ g) ⟨⟨h y, hU⟩, hU₂⟩

    have hWm' : ∃ W' : Y₂.Opens, h y ∈ W' ∧ SmoothOfRelativeDimension m (W'.ι ≫ g) := by
      let F : V₀.toScheme ⟶ Y₂ := V₀.ι ≫ U₂.ι ≫ U.ι
      refine ⟨F.opensRange, ⟨⟨⟨⟨h y, hU⟩, hU₂⟩, hV₀⟩, rfl⟩, ?_⟩
      have e0 : F.opensRange.ι = F.isoOpensRange.inv ≫ F := by
        rw [Iso.eq_inv_comp, Scheme.Hom.isoOpensRange_hom_ι]
      have e1 : F.opensRange.ι ≫ g = F.isoOpensRange.inv ≫ V₀.ι ≫ U₂.ι ≫ U.ι ≫ g := by
        rw [e0, Category.assoc]
        rfl
      rw [e1]
      have := smoothOfRelativeDimension_comp 0 m (F.isoOpensRange).inv (V₀.ι ≫ U₂.ι ≫ U.ι ≫ g)
      simpa using this
    obtain ⟨W', hxW', hWm⟩ := hWm'

    have hyV'' : y ∈ V ⊓ h ⁻¹ᵁ W' := ⟨hyV, hxW'⟩
    have hA : SmoothOfRelativeDimension 1 ((V ⊓ h ⁻¹ᵁ W').ι ≫ h ≫ g) := by
      have e1 : (V ⊓ h ⁻¹ᵁ W').ι ≫ h ≫ g =
          Y₁.homOfLE (inf_le_left : V ⊓ h ⁻¹ᵁ W' ≤ V) ≫ V.ι ≫ h ≫ g := by
        rw [← Category.assoc (Y₁.homOfLE _), Scheme.homOfLE_ι]
      rw [e1]
      have := smoothOfRelativeDimension_comp 0 1 (Y₁.homOfLE (inf_le_left : V ⊓ h ⁻¹ᵁ W' ≤ V))
        (V.ι ≫ h ≫ g)
      simpa using this
    have hB : SmoothOfRelativeDimension m ((V ⊓ h ⁻¹ᵁ W').ι ≫ h ≫ g) := by
      have e1 : (V ⊓ h ⁻¹ᵁ W').ι ≫ h ≫ g = Y₁.homOfLE (inf_le_right : V ⊓ h ⁻¹ᵁ W' ≤ h ⁻¹ᵁ W') ≫
          (h ∣_ W') ≫ W'.ι ≫ g := by
        rw [← Category.assoc (h ∣_ W'), morphismRestrict_ι, Category.assoc,
          ← Category.assoc (Y₁.homOfLE _), Scheme.homOfLE_ι]
      rw [e1]
      have h1 := smoothOfRelativeDimension_comp 0 m (h ∣_ W') (W'.ι ≫ g)
      have h2 := smoothOfRelativeDimension_comp 0 (0 + m)
        (Y₁.homOfLE (inf_le_right : V ⊓ h ⁻¹ᵁ W' ≤ h ⁻¹ᵁ W')) ((h ∣_ W') ≫ W'.ι ≫ g)
      simpa using h2
    have r1 := (@wc_ldp_il_stalk_of_smooth _ _ ((V ⊓ h ⁻¹ᵁ W').ι ≫ h ≫ g) 1 hA ⟨y, hyV''⟩).2.2.2
    have r2 := (@wc_ldp_il_stalk_of_smooth _ _ ((V ⊓ h ⁻¹ᵁ W').ι ≫ h ≫ g) m hB ⟨y, hyV''⟩).2.2.2
    have hm1 : m = 1 := r2.symm.trans r1
    subst hm1
    exact ⟨W', hxW', hWm⟩

theorem wcpa_dj_nc_ns_etale_transfer : ∀ (Y₁ Y₂ S : Scheme.{u}) (h : Y₁ ⟶ Y₂) (g : Y₂ ⟶ S) (g₁ : Y₁ ⟶ S) (hg : h ≫ g = g₁), Etale h → ∀ (K : Type u) [Field K] [IsAlgClosed K] (sp : Spec (.of K) ⟶ S) (w₁ : ↥(Limits.pullback g₁ sp)), wcpaDjMsFibreNS g K sp (Limits.pullback.map g₁ sp g sp h (𝟙 _) (𝟙 _) (by rw [Category.comp_id, hg]) (by rw [Category.comp_id, Category.id_comp]) w₁) ↔ wcpaDjMsFibreNS g₁ K sp w₁ :=
by


  have s2 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (φ : A →+* B), IsLocalHom φ → φ.Flat → φ.EssFiniteType → φ.FormallyUnramified →
      Function.Surjective ((IsLocalRing.residue B).comp φ) → ∀ n : ℕ,
      Ideal.comap φ (IsLocalRing.maximalIdeal B ^ n) = IsLocalRing.maximalIdeal A ^ n ∧
      ∀ b : B, ∃ a : A, b - φ a ∈ IsLocalRing.maximalIdeal B ^ n := by
    intro A B _ _ _ _ φ hloc hfl heft hfu hres
    letI := φ.toAlgebra
    haveI : Module.Flat A B := hfl
    haveI : Algebra.EssFiniteType A B := heft
    haveI : Algebra.FormallyUnramified A B := hfu
    haveI : IsLocalHom (algebraMap A B) := hloc
    have hmap : Ideal.map φ (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hmapn : ∀ n, Ideal.map φ (IsLocalRing.maximalIdeal A ^ n) =
        IsLocalRing.maximalIdeal B ^ n := by
      intro n; rw [Ideal.map_pow, hmap]
    haveI : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
    intro n
    refine ⟨?_, ?_⟩
    · rw [← hmapn n]; exact Ideal.comap_map_eq_self_of_faithfullyFlat _
    · induction n with
      | zero => intro b; exact ⟨0, by simp⟩
      | succ n ih =>
        intro b
        obtain ⟨a, ha⟩ := ih b
        have key : ∀ r ∈ IsLocalRing.maximalIdeal B ^ n, ∃ a' : A,
            r - φ a' ∈ IsLocalRing.maximalIdeal B ^ (n + 1) := by
          intro r hr
          rw [← hmapn n] at hr
          unfold Ideal.map at hr
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hr
          · rintro _ ⟨α, _, rfl⟩; exact ⟨α, by simp⟩
          · exact ⟨0, by simp⟩
          · rintro x y _ _ ⟨a₁, h₁⟩ ⟨a₂, h₂⟩
            refine ⟨a₁ + a₂, ?_⟩
            have e : x + y - φ (a₁ + a₂) = (x - φ a₁) + (y - φ a₂) := by rw [map_add]; ring
            rw [e]; exact Ideal.add_mem _ h₁ h₂
          · rintro c x hx ⟨a₁, h₁⟩
            obtain ⟨ac, hac⟩ := hres (IsLocalRing.residue B c)
            have hc : c - φ ac ∈ IsLocalRing.maximalIdeal B := by
              rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]; exact hac.symm
            have hx' : x ∈ IsLocalRing.maximalIdeal B ^ n := by
              rw [← hmapn n]; exact hx
            refine ⟨ac * a₁, ?_⟩
            have e : c • x - φ (ac * a₁) = (c - φ ac) * x + φ ac * (x - φ a₁) := by
              rw [smul_eq_mul, map_mul]; ring
            rw [e]
            refine Ideal.add_mem _ ?_ (Ideal.mul_mem_left _ _ h₁)
            rw [pow_succ']
            exact Ideal.mul_mem_mul hc hx'
        obtain ⟨a', ha'⟩ := key _ ha
        refine ⟨a + a', ?_⟩
        have e : b - φ (a + a') = (b - φ a) - φ a' := by rw [map_add]; ring
        rw [e]; exact ha'

  have s3 : ∀ (A B : Type u) [CommRing A] [CommRing B] (I : Ideal A) (J : Ideal B) (φ : A →+* B),
      (∀ n : ℕ, Ideal.comap φ (J ^ n) = I ^ n) → (∀ (n : ℕ) (b : B), ∃ a : A, b - φ a ∈ J ^ n) →
      ∃ τ : AdicCompletion I A ≃+* AdicCompletion J B, ∀ a : A,
        τ (algebraMap A (AdicCompletion I A) a) = algebraMap B (AdicCompletion J B) (φ a) := by
    intro A B _ _ I J φ hcomap hdense
    have hfe : ∀ {R : Type u} [CommRing R] (I : Ideal R) {m n : ℕ} (hle : m ≤ n)
        (y : AdicCompletion I R),
        Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n y) =
          AdicCompletion.evalₐ I m y := by
      intro R _ I m n hle y
      obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I R y
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
      have key := AdicCompletion.AdicCauchySequence.mk_eq_mk hle s
      rw [Submodule.Quotient.eq] at key
      rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      simpa [smul_eq_mul, Ideal.mul_top] using key
    have h1 : ∀ n, I ^ n ≤ (J ^ n).comap φ := fun n => (hcomap n).ge
    let f : ∀ n, A ⧸ I ^ n →+* B ⧸ J ^ n := fun n => Ideal.quotientMap (J ^ n) φ (h1 n)
    have finj : ∀ n, Function.Injective (f n) := fun n =>
      Ideal.quotientMap_injective' (hcomap n).le
    have fsurj : ∀ n, Function.Surjective (f n) := by
      intro n z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨a, ha⟩ := hdense n b
      refine ⟨Ideal.Quotient.mk _ a, ?_⟩
      simp only [f, Ideal.quotientMap_mk]
      rw [Ideal.Quotient.eq, ← neg_sub]
      exact neg_mem ha
    let e : ∀ n, A ⧸ I ^ n ≃+* B ⧸ J ^ n := fun n =>
      RingEquiv.ofBijective (f n) ⟨finj n, fsurj n⟩
    let g : ∀ n, B ⧸ J ^ n →+* A ⧸ I ^ n := fun n => (e n).symm.toRingHom
    have hgf : ∀ n z, g n (f n z) = z := fun n z => (e n).symm_apply_apply z
    have hfg : ∀ n z, f n (g n z) = z := fun n z => (e n).apply_symm_apply z
    have hcf : ∀ {m n : ℕ} (hle : m ≤ n) (z : A ⧸ I ^ n),
        Ideal.Quotient.factorPow J hle (f n z) = f m (Ideal.Quotient.factorPow I hle z) := by
      intro m n hle z
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      simp only [f, Ideal.quotientMap_mk, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
    have hcg : ∀ {m n : ℕ} (hle : m ≤ n) (z : B ⧸ J ^ n),
        Ideal.Quotient.factorPow I hle (g n z) = g m (Ideal.Quotient.factorPow J hle z) := by
      intro m n hle z
      apply finj m
      rw [hfg, ← hcf, hfg]
    let F : ∀ n, AdicCompletion I A →+* B ⧸ J ^ n := fun n =>
      (f n).comp (AdicCompletion.evalₐ I n).toRingHom
    have hF : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow J hle).comp (F n) = F m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow J hle (f n (AdicCompletion.evalₐ I n y)) =
        f m (AdicCompletion.evalₐ I m y)
      rw [hcf, hfe I hle y]
    let G : ∀ n, AdicCompletion J B →+* A ⧸ I ^ n := fun n =>
      (g n).comp (AdicCompletion.evalₐ J n).toRingHom
    have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (G n) = G m := by
      intro m n hle
      refine RingHom.ext fun y => ?_
      show Ideal.Quotient.factorPow I hle (g n (AdicCompletion.evalₐ J n y)) =
        g m (AdicCompletion.evalₐ J m y)
      rw [hcg, hfe J hle y]
    let Φ := AdicCompletion.liftRingHom J F hF
    let Ψ := AdicCompletion.liftRingHom I G hG
    have hΦ : ∀ n y, AdicCompletion.evalₐ J n (Φ y) = f n (AdicCompletion.evalₐ I n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom J F hF n y
    have hΨ : ∀ n y, AdicCompletion.evalₐ I n (Ψ y) = g n (AdicCompletion.evalₐ J n y) :=
      fun n y => AdicCompletion.evalₐ_liftRingHom I G hG n y
    have e1 : Φ.comp Ψ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΦ, hΨ, hfg]
    have e2 : Ψ.comp Φ = RingHom.id _ := by
      refine RingHom.ext fun y => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΨ, hΦ, hgf]
    refine ⟨RingEquiv.ofRingHom Φ Ψ e1 e2, fun a => ?_⟩
    show Φ (algebraMap A (AdicCompletion I A) a) = algebraMap B (AdicCompletion J B) (φ a)
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hΦ, AlgHom.commutes, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.algebraMap_eq]
    simp [f, Ideal.quotientMap_mk]

  have s4 : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] (κ : K →+* R),
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp κ) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      Function.Surjective ((IsLocalRing.residue R).comp κ) := by
    intro K _ R _ _ κ ⟨e, he⟩ y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨F, hF⟩ := Ideal.Quotient.mk_surjective
      (e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) a))
    obtain ⟨c, hc⟩ : ∃ c : K, c = MvPowerSeries.constantCoeff F := ⟨_, rfl⟩
    refine ⟨c, ?_⟩
    have hmem : a - κ c ∈ IsLocalRing.maximalIdeal R := by
      by_contra hnot
      have hu : IsUnit (a - κ c) := IsLocalRing.notMem_maximalIdeal.mp hnot
      have hu2 : IsUnit (e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)
          (a - κ c))) := (hu.map _).map e
      have h1 : e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) (κ c)) =
          Ideal.Quotient.mk _ (MvPowerSeries.C c) := RingHom.congr_fun he c
      have h2 : e (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) (a - κ c)) =
          Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
            (F - MvPowerSeries.C c) := by
        rw [map_sub, map_sub, h1, ← hF, map_sub]
      rw [h2] at hu2
      obtain ⟨v, hv⟩ := hu2.exists_right_inv
      obtain ⟨H, rfl⟩ := Ideal.Quotient.mk_surjective v
      rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq,
        Ideal.mem_span_singleton'] at hv
      obtain ⟨G, hG⟩ := hv
      have h3 := congrArg MvPowerSeries.constantCoeff hG
      simp [← hc] at h3
    show IsLocalRing.residue R (κ c) = IsLocalRing.residue R a
    rw [eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact hmem

  have s5 : ∀ (K : Type u) [Field K] [IsAlgClosed K] (A B : Type u) [CommRing A] [IsLocalRing A]
      [CommRing B] [IsLocalRing B] (φ : A →+* B) (κ : K →+* A), IsLocalHom φ →
      φ.EssFiniteType → φ.FormallyUnramified →
      Function.Surjective ((IsLocalRing.residue A).comp κ) →
      Function.Surjective ((IsLocalRing.residue B).comp φ) := by
    intro K _ _ A B _ _ _ _ φ κ hloc heft hfu hsurj
    letI := φ.toAlgebra
    haveI : Algebra.EssFiniteType A B := heft
    haveI : Algebra.FormallyUnramified A B := hfu
    haveI : IsLocalHom (algebraMap A B) := hloc
    have hinj : Function.Injective ((IsLocalRing.residue A).comp κ) := RingHom.injective _
    haveI : IsAlgClosed (IsLocalRing.ResidueField A) :=
      IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective _ ⟨hinj, hsurj⟩)
    haveI : Algebra.IsSeparable (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B) :=
      inferInstance
    haveI : Algebra.IsIntegral (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B) :=
      Algebra.IsAlgebraic.isIntegral
    have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral
      (k := IsLocalRing.ResidueField A) (K := IsLocalRing.ResidueField B)
    intro y
    obtain ⟨t, rfl⟩ := hbij.2 y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective t
    exact ⟨a, (IsLocalRing.ResidueField.algebraMap_residue a).symm⟩

  intro Y₁ Y₂ S h g g₁ hg hh K _ _ sp w₁
  subst hg
  obtain ⟨hK, hKdef⟩ : ∃ f : Limits.pullback (h ≫ g) sp ⟶ Limits.pullback g sp,
      f = Limits.pullback.map (h ≫ g) sp g sp h (𝟙 _) (𝟙 _) (by rw [Category.comp_id])
        (by rw [Category.comp_id, Category.id_comp]) := ⟨_, rfl⟩
  rw [← hKdef]
  have hsnd : hK ≫ Limits.pullback.snd g sp = Limits.pullback.snd (h ≫ g) sp := by
    rw [hKdef, Limits.pullback.lift_snd, Category.comp_id]
  have hfst : hK ≫ Limits.pullback.fst g sp = Limits.pullback.fst (h ≫ g) sp ≫ h := by
    rw [hKdef]; exact Limits.pullback.lift_fst _ _ _
  have hpb : IsPullback hK (Limits.pullback.fst (h ≫ g) sp) (Limits.pullback.fst g sp) h :=
    IsPullback.of_right (by rw [hsnd]; exact (IsPullback.of_hasPullback (h ≫ g) sp).flip) hfst
      (IsPullback.of_hasPullback g sp).flip
  haveI hKet : Etale hK := MorphismProperty.of_isPullback (P := @Etale) hpb.flip hh

  have hκ : (hK.stalkMap w₁).hom.comp
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g sp).appTop ≫
        (Limits.pullback g sp).presheaf.germ ⊤ (hK w₁) trivial).hom =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd (h ≫ g) sp).appTop ≫
        (Limits.pullback (h ≫ g) sp).presheaf.germ ⊤ w₁ trivial).hom := by
    have hgs : (Limits.pullback g sp).presheaf.germ ⊤ (hK w₁) trivial ≫ hK.stalkMap w₁ =
        hK.appTop ≫ (Limits.pullback (h ≫ g) sp).presheaf.germ ⊤ w₁ trivial :=
      Scheme.Hom.germ_stalkMap hK ⊤ w₁ trivial
    have hmor : ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd g sp).appTop ≫
        (Limits.pullback g sp).presheaf.germ ⊤ (hK w₁) trivial) ≫ hK.stalkMap w₁ =
        (Scheme.ΓSpecIso (.of K)).inv ≫ (hK ≫ Limits.pullback.snd g sp).appTop ≫
          (Limits.pullback (h ≫ g) sp).presheaf.germ ⊤ w₁ trivial := by
      rw [Scheme.Hom.comp_appTop, Category.assoc, Category.assoc, hgs]
      simp only [Category.assoc]
    rw [hsnd] at hmor
    rw [← hmor]
    rfl

  have hnodeT : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (φ : A →+* B) (κA : K →+* A) (κB : K →+* B), φ.comp κA = κB → IsLocalHom φ → φ.Flat →
      φ.EssFiniteType → φ.FormallyUnramified →
      ((∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp κA) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) ↔
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp κB) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C)) := by
    intro A B _ _ _ _ φ κA κB hκ' hloc hfl heft hfu
    have hτ0 : Function.Surjective ((IsLocalRing.residue B).comp φ) →
        ∃ τ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
          τ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
            algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ a) := by
      intro hres
      exact s3 A B _ _ φ (fun n => (s2 A B φ hloc hfl heft hfu hres n).1)
        (fun n => (s2 A B φ hloc hfl heft hfu hres n).2)
    constructor
    · rintro ⟨e, he⟩
      obtain ⟨τ, hτ⟩ := hτ0 (s5 K A B φ κA hloc heft hfu (s4 K A κA ⟨e, he⟩))
      refine ⟨τ.symm.trans e, ?_⟩
      refine RingHom.ext fun c => ?_
      have h1 := RingHom.congr_fun he c
      have h2 := hτ (κA c)
      have h3 : φ (κA c) = κB c := RingHom.congr_fun hκ' c
      simp only [RingHom.comp_apply] at h1 ⊢
      rw [← h3, ← h2]
      simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.trans_apply,
        RingEquiv.symm_apply_apply] at h1 ⊢
      exact h1
    · rintro ⟨e, he⟩
      have hsB := s4 K B κB ⟨e, he⟩
      have hres : Function.Surjective ((IsLocalRing.residue B).comp φ) := by
        intro y
        obtain ⟨c, hc⟩ := hsB y
        refine ⟨κA c, ?_⟩
        rw [← hκ'] at hc
        exact hc
      obtain ⟨τ, hτ⟩ := hτ0 hres
      refine ⟨τ.trans e, ?_⟩
      refine RingHom.ext fun c => ?_
      have h1 := RingHom.congr_fun he c
      have h2 := hτ (κA c)
      have h3 : φ (κA c) = κB c := RingHom.congr_fun hκ' c
      simp only [RingHom.comp_apply] at h1 ⊢
      rw [← h3, ← h2] at h1
      simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.trans_apply] at h1 ⊢
      exact h1
  have hsm := wcpa_dj_nc_smooth_etale_transfer _ _ (Spec (.of K)) hK
    (Limits.pullback.snd g sp) w₁ hKet
  rw [hsnd] at hsm
  unfold wcpaDjMsFibreNS
  exact or_congr hsm (hnodeT _ _ (hK.stalkMap w₁).hom _ _ hκ inferInstance
    (Flat.stalkMap hK w₁) (LocallyOfFiniteType.stalkMap hK w₁)
    (FormallyUnramified.stalkMap hK w₁))

theorem wcpa_dj_mscc_coordinate_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (Δ τ₀ : Spec (.of ↥W) ⟶ Z'), IsSeparated u' → LocallyOfFinitePresentation u' → Δ ≫ u' = 𝟙 _ → τ₀ ≫ u' = 𝟙 _ → (∃ U : Z'.Opens, τ₀ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → Δ (IsLocalRing.closedPoint ↥W) = τ₀ (IsLocalRing.closedPoint ↥W) → (∀ p : ↥(Spec (.of ↥W)), p ≠ IsLocalRing.closedPoint ↥W → Δ p ≠ τ₀ p) → (∃ p : ↥(Spec (.of ↥W)), p ≠ IsLocalRing.closedPoint ↥W) → ∃ (U : Z'.Opens) (m : U.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (c : ↥W) (ΔU τU : Spec (.of ↥W) ⟶ U.toScheme), IsAffineOpen U ∧ Etale m ∧ m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = U.ι ≫ u' ∧ c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal ↥W ∧ ΔU ≫ U.ι = Δ ∧ τU ≫ U.ι = τ₀ ∧ ΔU ≫ m = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) ∧ τU ≫ m = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c))) ∧ RingHom.ker ΔU.appTop.hom = Ideal.span {m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))} :=
by

  have wcpa_dj_mscc_cc_chart_at_section : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)) (Δ : Spec (.of R) ⟶ Z), Δ ≫ uu = 𝟙 _ → ∀ (W₁ : Z.Opens), SmoothOfRelativeDimension 1 (W₁.ι ≫ uu) → Δ (IsLocalRing.closedPoint R) ∈ W₁ → ∃ (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) R →+* Γ(Z, V)), IsAffineOpen V ∧ Δ (IsLocalRing.closedPoint R) ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom ∧ Function.Bijective ((Δ.app V).hom.comp (g.comp MvPolynomial.C)) := by
    intro R _ _ Z uu Δ hΔ W₁ hW₁ hΔW₁
    have chart_open : ∀ {Z S : Scheme.{u}} (uu : Z ⟶ S) (W : Z.Opens), SmoothOfRelativeDimension 1 (W.ι ≫ uu) → ∀ z ∈ W, ∃ (U : S.Opens) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ U) (g : MvPolynomial (Fin 1) Γ(S, U) →+* Γ(Z, V)), IsAffineOpen U ∧ IsAffineOpen V ∧ z ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE U V hle).hom := by
      intro Z S uu W hsm z hz
      have := hsm
      obtain ⟨U₀, hU₀, V₀, hV₀, hzV₀, e, hstd⟩ :=
        SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1) (f := W.ι ≫ uu)
          (⟨z, hz⟩ : W.toScheme)
      obtain ⟨g₀, hg₀C, hg₀⟩ := hstd.exists_etale_mvPolynomial
      have hle : W.ι ''ᵁ V₀ ≤ uu ⁻¹ᵁ U₀ := by
        intro y hy
        have hy' : y ∈ (W.ι ''ᵁ V₀ : Set Z) := hy
        rw [Scheme.Hom.coe_image] at hy'
        obtain ⟨x, hx, rfl⟩ := hy'
        have h1 : x ∈ (W.ι ≫ uu) ⁻¹ᵁ U₀ := e hx
        rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply] at h1
        exact h1
      have key : (W.ι ≫ uu).appLE U₀ V₀ e = uu.appLE U₀ (W.ι ''ᵁ V₀) hle := by
        rw [Scheme.Hom.comp_appLE]
        have h := Scheme.Opens.ι_appLE W (uu ⁻¹ᵁ U₀) V₀ (by exact e)
        rw [h, Scheme.Hom.appLE]
        rfl
      refine ⟨U₀, W.ι ''ᵁ V₀, hle, g₀, hU₀, hV₀.image_of_isOpenImmersion W.ι, ?_, hg₀, ?_⟩
      · have h2 := (Scheme.Hom.apply_mem_image_iff W.ι).mpr hzV₀
        simpa using h2
      · exact hg₀C.trans (congrArg CommRingCat.Hom.hom key)
    have chart_shrink : ∀ {Z S : Scheme.{u}} (uu : Z ⟶ S) (τ : S ⟶ Z), τ ≫ uu = 𝟙 S → ∀ (U₀ : S.Opens) (V₁ : Z.Opens) (e₁ : V₁ ≤ uu ⁻¹ᵁ U₀) (g₁ : MvPolynomial (Fin 1) Γ(S, U₀) →+* Γ(Z, V₁)), IsAffineOpen U₀ → IsAffineOpen V₁ → g₁.Etale → g₁.comp MvPolynomial.C = (uu.appLE U₀ V₁ e₁).hom → ∀ p : S, τ p ∈ V₁ → ∃ (U : S.Opens) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ U) (g : MvPolynomial (Fin 1) Γ(S, U) →+* Γ(Z, V)), IsAffineOpen U ∧ IsAffineOpen V ∧ τ p ∈ V ∧ g.Etale ∧ g.comp MvPolynomial.C = (uu.appLE U V hle).hom ∧ Function.Bijective ((τ.app V).hom.comp (uu.appLE U V hle).hom) := by
      intro Z S uu τ h U₀ V₁ e₁ g₁ hU₀ hV₁ hg₁ hg₁C p hp
      have hpt : ∀ x : S, uu (τ x) = x := by
        intro x
        rw [← Scheme.Hom.comp_apply, h]
        rfl
      have hpU₀ : p ∈ U₀ := by
        have h1 : τ p ∈ uu ⁻¹ᵁ U₀ := e₁ hp
        rw [Scheme.Hom.mem_preimage, hpt] at h1
        exact h1
      have hpτ : p ∈ τ ⁻¹ᵁ V₁ := hp
      obtain ⟨c, hc, hpc⟩ := hU₀.exists_basicOpen_le (V := τ ⁻¹ᵁ V₁) ⟨p, hpτ⟩ hpU₀
      have hVeq : Z.basicOpen ((uu.appLE U₀ V₁ e₁).hom c) = V₁ ⊓ uu ⁻¹ᵁ S.basicOpen c :=
        Scheme.basicOpen_appLE uu V₁ U₀ e₁ c
      set V := Z.basicOpen ((uu.appLE U₀ V₁ e₁).hom c) with hVdef
      have hle : V ≤ uu ⁻¹ᵁ S.basicOpen c := by rw [hVeq]; exact inf_le_right
      have hpV : τ p ∈ V := by
        rw [hVeq]
        refine ⟨hp, ?_⟩
        show uu (τ p) ∈ S.basicOpen c
        rw [hpt]; exact hpc
      have hτV : τ ⁻¹ᵁ V = S.basicOpen c := by
        ext x
        rw [hVeq]
        constructor
        · rintro ⟨_, h2⟩
          have h3 : uu (τ x) ∈ S.basicOpen c := h2
          rw [hpt] at h3
          exact h3
        · intro hx
          refine ⟨hc hx, ?_⟩
          show uu (τ x) ∈ S.basicOpen c
          rw [hpt]; exact hx
      have hbij : Function.Bijective ((τ.app V).hom.comp (uu.appLE (S.basicOpen c) V hle).hom) := by
        have key : ∀ (f : S ⟶ S) (W : S.Opens) (e : W ≤ f ⁻¹ᵁ S.basicOpen c), f = 𝟙 S →
            W = S.basicOpen c → Function.Bijective (f.appLE (S.basicOpen c) W e).hom := by
          intro f W e hf hW
          subst hf
          subst hW
          have h1 : (𝟙 S : S ⟶ S).appLE (S.basicOpen c) (S.basicOpen c) e = 𝟙 _ := by
            rw [Scheme.Hom.appLE]
            erw [Scheme.Hom.id_app, Category.id_comp]
            exact S.presheaf.map_id (Opposite.op (S.basicOpen c))
          rw [h1, CommRingCat.hom_id]
          exact Function.bijective_id
        rw [← CommRingCat.hom_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
        exact key _ _ _ h hτV
      haveI hlocS : IsLocalization.Away c Γ(S, S.basicOpen c) := hU₀.isLocalization_basicOpen c
      haveI hlocZ : IsLocalization.Away ((uu.appLE U₀ V₁ e₁).hom c) Γ(Z, V) :=
        hV₁.isLocalization_basicOpen _
      letI : Algebra (MvPolynomial (Fin 1) Γ(S, U₀)) (MvPolynomial (Fin 1) Γ(S, S.basicOpen c)) :=
        MvPolynomial.algebraMvPolynomial
      let M : Submonoid (MvPolynomial (Fin 1) Γ(S, U₀)) :=
        Submonoid.map MvPolynomial.C (Submonoid.powers c)
      haveI hM : IsLocalization M (MvPolynomial (Fin 1) Γ(S, S.basicOpen c)) :=
        MvPolynomial.isLocalization (Submonoid.powers c) _
      have hMmap : M.map g₁ = Submonoid.powers ((uu.appLE U₀ V₁ e₁).hom c) := by
        simp only [M, Submonoid.map_powers]
        rw [← hg₁C]
        rfl
      haveI hM2 : IsLocalization (M.map g₁) Γ(Z, V) := by rw [hMmap]; exact hlocZ
      let g : MvPolynomial (Fin 1) Γ(S, S.basicOpen c) →+* Γ(Z, V) :=
        IsLocalization.map (M := M) (T := M.map g₁) Γ(Z, V) g₁ (Submonoid.le_comap_map M)
      have hgEt : g.Etale :=
        RingHom.Etale.isStableUnderBaseChange.localizationPreserves g₁ M _ _ hg₁
      have hgC : g.comp MvPolynomial.C = (uu.appLE (S.basicOpen c) V hle).hom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers c)
        ext b
        simp only [RingHom.comp_apply]
        have e1 : MvPolynomial.C (algebraMap Γ(S, U₀) Γ(S, S.basicOpen c) b) =
            algebraMap (MvPolynomial (Fin 1) Γ(S, U₀)) (MvPolynomial (Fin 1) Γ(S, S.basicOpen c))
              (MvPolynomial.C b) := by
          rw [MvPolynomial.algebraMap_def, MvPolynomial.map_C]
        rw [e1]
        show IsLocalization.map (M := M) (T := M.map g₁) Γ(Z, V) g₁ (Submonoid.le_comap_map M)
          (algebraMap _ _ (MvPolynomial.C b)) = _
        rw [IsLocalization.map_eq]
        have e2 : g₁ (MvPolynomial.C b) = (uu.appLE U₀ V₁ e₁).hom b := by rw [← hg₁C]; rfl
        rw [e2]
        have e3 : uu.appLE U₀ V₁ e₁ ≫ Z.presheaf.map (homOfLE (Z.basicOpen_le _)).op =
            S.presheaf.map (homOfLE (S.basicOpen_le c)).op ≫ uu.appLE (S.basicOpen c) V hle := by
          rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
        exact congrArg (fun φ => φ.hom b) e3
      exact ⟨S.basicOpen c, V, hle, g, hU₀.basicOpen c, hV₁.basicOpen _, hpV, hgEt, hgC, hbij⟩
    obtain ⟨U₀, V₁, e₁, g₁, hU₀, hV₁, hzV₁, hg₁, hg₁C⟩ :=
      chart_open uu W₁ hW₁ (Δ (IsLocalRing.closedPoint R)) hΔW₁
    obtain ⟨U, V, hle, g, _hU, hV, hΔV, hg, hgC, hbij⟩ :=
      chart_shrink uu Δ hΔ U₀ V₁ e₁ g₁ hU₀ hV₁ hg₁ hg₁C (IsLocalRing.closedPoint R) hzV₁
    have hsU : IsLocalRing.closedPoint R ∈ U := by
      have h1 : Δ (IsLocalRing.closedPoint R) ∈ uu ⁻¹ᵁ U := hle hΔV
      have hpt : uu (Δ (IsLocalRing.closedPoint R)) = IsLocalRing.closedPoint R := by
        show (Δ ≫ uu) (IsLocalRing.closedPoint R) = _
        rw [hΔ]; rfl
      rw [Scheme.Hom.mem_preimage, hpt] at h1
      exact h1
    have hUtop : U = ⊤ := by
      have := Scheme.preimage_eq_top_of_closedPoint_mem (𝟙 (Spec (.of R))) (U := U) hsU
      simpa using this
    subst hUtop
    let e₀ : R ≃+* Γ(Spec (.of R), ⊤) := (Scheme.ΓSpecIso (.of R)).symm.commRingCatIsoToRingEquiv
    have he₀ : ∀ a, e₀ a = (Scheme.ΓSpecIso (.of R)).inv.hom a := fun a => rfl
    let E : MvPolynomial (Fin 1) R ≃+* MvPolynomial (Fin 1) Γ(Spec (.of R), ⊤) :=
      MvPolynomial.mapEquiv (Fin 1) e₀
    have hEC : ∀ a, E (MvPolynomial.C a) = MvPolynomial.C (e₀ a) := fun a => by
      show MvPolynomial.map (e₀ : R →+* Γ(Spec (.of R), ⊤)) (MvPolynomial.C a) = _
      rw [MvPolynomial.map_C]
      rfl
    refine ⟨V, hle, g.comp E.toRingHom, hV, hΔV, RingHom.Etale.respectsIso.2 g E hg, ?_, ?_⟩
    · ext a
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, hEC]
      rw [← he₀]
      exact congrArg (fun φ => φ (e₀ a)) hgC
    · have hfun : ⇑((Δ.app V).hom.comp ((g.comp E.toRingHom).comp MvPolynomial.C)) =
          ⇑((Δ.app V).hom.comp (uu.appLE ⊤ V hle).hom) ∘ ⇑e₀ := by
        funext a
        simp only [RingHom.comp_apply, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, hEC]
        congr 1
        exact congrArg (fun φ => φ (e₀ a)) hgC
      rw [hfun]
      exact hbij.comp e₀.bijective

  have wcpa_dj_mscc_cc_normalized_section_algebra : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale → Function.Bijective (θ.comp (g.comp MvPolynomial.C)) → (RingHom.ker θ).FG → ∃ (g' : MvPolynomial (Fin 1) R →+* A) (r : A), g'.Etale ∧ g'.comp MvPolynomial.C = g.comp MvPolynomial.C ∧ θ (g' (MvPolynomial.X 0)) = 0 ∧ θ r = 1 ∧ ∀ x ∈ RingHom.ker θ, ∃ y : A, r * x = y * g' (MvPolynomial.X 0) := by
    intro R A B _ _ _ g θ hg hbij hFG
    have s2 : ∀ a : R, θ (g (MvPolynomial.C a)) = θ (g (MvPolynomial.X 0)) →
        RingHom.ker θ ≤ RingHom.ker θ ^ 2 ⊔
          Ideal.span {g (MvPolynomial.X 0 - MvPolynomial.C a)} := by
      intro a ha
      letI := g.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
      set e := RingEquiv.ofBijective _ hbij with he
      have he_apply : ∀ c, e c = θ (g (MvPolynomial.C c)) := fun c => rfl
      set J := RingHom.ker θ with hJ
      set I₀ := J ^ 2 ⊔ Ideal.span {g (MvPolynomial.X 0 - MvPolynomial.C a)} with hI₀
      let q := Ideal.Quotient.mk I₀
      let σ : A →+* A := (g.comp MvPolynomial.C).comp ((e.symm : B →+* R).comp θ)
      have hσ : ∀ x, σ x = g (MvPolynomial.C (e.symm (θ x))) := fun x => rfl
      have hσθ : ∀ x, θ (σ x) = θ x := by
        intro x
        rw [hσ, ← he_apply, e.apply_symm_apply]
      have hcomm : (q.comp σ).comp g = q.comp g := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply]
          rw [hσ, ← he_apply, e.symm_apply_apply]
        · intro i
          have hi : i = 0 := Subsingleton.elim _ _
          subst hi
          simp only [RingHom.comp_apply]
          rw [hσ, ← ha, ← he_apply, e.symm_apply_apply]
          refine (Ideal.Quotient.eq.mpr ?_).symm
          rw [← map_sub]
          exact Ideal.mem_sup_right (Ideal.subset_span rfl)
      let q₂ : A →ₐ[MvPolynomial (Fin 1) R] A ⧸ I₀ :=
        { q.comp σ with
          commutes' := fun P => by
            have := congrArg (fun f => f P) hcomm
            simp only [RingHom.comp_apply] at this
            exact this }
      have hq₂ : ∀ x, q₂ x = q (σ x) := fun x => rfl
      have hnil : IsNilpotent (J.map q) := by
        refine ⟨2, ?_⟩
        rw [← Ideal.map_pow]
        have h1 : Ideal.map q (J ^ 2) ≤ Ideal.map q I₀ := Ideal.map_mono le_sup_left
        have h2 : Ideal.map q I₀ = ⊥ := by
          rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
        rw [h2] at h1
        exact le_bot_iff.mp h1
      have hext := Algebra.FormallyUnramified.ext (R := MvPolynomial (Fin 1) R) (J.map q) hnil
        (g₁ := Ideal.Quotient.mkₐ (MvPolynomial (Fin 1) R) I₀) (g₂ := q₂) (fun x => by
          rw [Ideal.Quotient.eq, hq₂, Ideal.Quotient.mkₐ_eq_mk]
          show q x - q (σ x) ∈ _
          rw [← map_sub]
          apply Ideal.mem_map_of_mem
          rw [RingHom.mem_ker, map_sub, hσθ, sub_self])
      intro x hx
      have h1 := congrArg (fun f => f x) hext
      simp only [Ideal.Quotient.mkₐ_eq_mk, hq₂, hσ] at h1
      rw [RingHom.mem_ker.mp hx, map_zero, map_zero, map_zero, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    have s3 : ∀ (J : Ideal A) (t : A), J.FG → J ≤ J ^ 2 ⊔ Ideal.span {t} →
        ∃ r : A, r - 1 ∈ J ∧ ∀ x ∈ J, ∃ y : A, r * x = y * t := by
      intro J t hFG hle
      set K : Ideal A := Ideal.span {t} with hK
      let π := Submodule.mkQ K
      let N : Submodule A (A ⧸ K) := Submodule.map π J
      have hNfg : N.FG := Submodule.FG.map π hFG
      have hNle : N ≤ J • N := by
        rintro _ ⟨x, hx, rfl⟩
        obtain ⟨j, hj, w, hw, hjw⟩ := Submodule.mem_sup.mp (hle hx)
        have hπ : π x = π j := by
          rw [← hjw, map_add]
          have : π w = 0 := (Submodule.Quotient.mk_eq_zero K).mpr hw
          rw [this, add_zero]
        show π x ∈ J • N
        rw [hπ]
        have hj' : j ∈ J • J := by rwa [Ideal.smul_eq_mul, ← pow_two]
        have := Submodule.mem_map_of_mem (f := π) hj'
        rwa [Submodule.map_smul''] at this
      obtain ⟨r, hr1, hr⟩ :=
        Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul J N hNfg hNle
      refine ⟨r, hr1, fun x hx => ?_⟩
      have h1 : π (r * x) = 0 := by
        rw [← smul_eq_mul, LinearMap.map_smul]
        exact hr _ (Submodule.mem_map_of_mem hx)
      have h2 : r * x ∈ K := (Submodule.Quotient.mk_eq_zero K).mp h1
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp h2
      exact ⟨y, hy.symm⟩
    obtain ⟨a, ha⟩ := hbij.2 (θ (g (MvPolynomial.X 0)))
    simp only [RingHom.comp_apply] at ha
    obtain ⟨r, hr1, hr⟩ := s3 (RingHom.ker θ) _ hFG (s2 a ha)
    let φa : MvPolynomial (Fin 1) R →+* MvPolynomial (Fin 1) R :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun _ => MvPolynomial.X 0 - MvPolynomial.C a)
    let φb : MvPolynomial (Fin 1) R →+* MvPolynomial (Fin 1) R :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun _ => MvPolynomial.X 0 + MvPolynomial.C a)
    have hab : φa.comp φb = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [φa, φb]
      · intro i
        rw [Subsingleton.elim i 0]
        simp [φa, φb]
    have hba : φb.comp φa = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [φa, φb]
      · intro i
        rw [Subsingleton.elim i 0]
        simp [φa, φb]
    let Φ := RingEquiv.ofRingHom φa φb hab hba
    have hΦ : ∀ P, Φ P = φa P := fun P => rfl
    refine ⟨g.comp Φ.toRingHom, r, RingHom.Etale.respectsIso.2 g Φ hg, ?_, ?_, ?_, ?_⟩
    · ext c
      simp [hΦ, φa]
    · show θ (g (Φ (MvPolynomial.X 0))) = 0
      rw [hΦ]
      simp only [φa, MvPolynomial.eval₂Hom_X']
      rw [map_sub, map_sub, ha, sub_self]
    · have := RingHom.mem_ker.mp hr1
      rw [map_sub, map_one, sub_eq_zero] at this
      exact this
    · intro x hx
      obtain ⟨y, hy⟩ := hr x hx
      refine ⟨y, ?_⟩
      show r * x = y * g (Φ (MvPolynomial.X 0))
      rw [hΦ]
      simp only [φa, MvPolynomial.eval₂Hom_X']
      exact hy

  have wcpa_dj_mscc_cc_ker_fg : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] (g : MvPolynomial (Fin 1) R →+* A) (θ : A →+* B), g.Etale → Function.Bijective (θ.comp (g.comp MvPolynomial.C)) → (RingHom.ker θ).FG := by
    intro R A B _ _ _ g θ hg hbij
    have hfp : (g.comp MvPolynomial.C).FinitePresentation := by
      have h1 : g.FinitePresentation := by
        letI := g.toAlgebra
        haveI : Algebra.Etale (MvPolynomial (Fin 1) R) A := hg
        exact (inferInstance : Algebra.FinitePresentation (MvPolynomial (Fin 1) R) A)
      have h2 : (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R).FinitePresentation := by
        rw [← MvPolynomial.algebraMap_eq]
        exact RingHom.finitePresentation_algebraMap.mpr inferInstance
      exact RingHom.FinitePresentation.comp h1 h2
    letI : Algebra R A := (g.comp MvPolynomial.C).toAlgebra
    letI : Algebra R B := (θ.comp (g.comp MvPolynomial.C)).toAlgebra
    haveI : Algebra.FinitePresentation R A := hfp
    let θa : A →ₐ[R] B := { θ with commutes' := fun r => rfl }
    have hsurj : Function.Surjective θa := Function.Surjective.of_comp hbij.2
    haveI : Algebra.FinitePresentation R B := by
      let e : R ≃ₐ[R] B := AlgEquiv.ofBijective (Algebra.ofId R B) hbij
      exact Algebra.FinitePresentation.equiv e
    exact Algebra.FinitePresentation.ker_fG_of_surjective θa hsurj

  have wcpa_dj_mscc_cc_kernel_basicOpen : ∀ {X Y : Scheme.{u}} (τ : Y ⟶ X) [IsClosedImmersion τ] (V : X.Opens), IsAffineOpen V → ∀ (t r : Γ(X, V)), (τ.app V).hom t = 0 → (∀ x ∈ RingHom.ker (τ.app V).hom, ∃ y : Γ(X, V), r * x = y * t) → RingHom.ker (τ.app (X.basicOpen r)).hom = Ideal.span {(X.presheaf.map (homOfLE (X.basicOpen_le r)).op).hom t} := by
    intro X Y τ _ W hW t f hθt hker
    haveI hloc : IsLocalization.Away f Γ(X, X.basicOpen f) := hW.isLocalization_basicOpen f
    have hle' : τ ⁻¹ᵁ X.basicOpen f ≤ τ ⁻¹ᵁ W := fun x hx => X.basicOpen_le f hx
    have nat : ∀ a : Γ(X, W), (τ.app (X.basicOpen f)).hom (algebraMap Γ(X, W) Γ(X, X.basicOpen f) a)
        = (Y.presheaf.map (homOfLE hle').op).hom ((τ.app W).hom a) := by
      intro a
      have e := τ.naturality (homOfLE (X.basicOpen_le f)).op
      have := congrArg (fun φ => φ.hom a) e
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    have hfu : IsUnit (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f) :=
      IsLocalization.Away.algebraMap_isUnit f
    have halg : ∀ a, (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a =
        algebraMap Γ(X, W) Γ(X, X.basicOpen f) a := fun a => rfl
    rw [halg]
    refine le_antisymm ?_ ?_
    · intro x' hx'
      rw [RingHom.mem_ker] at hx'
      obtain ⟨⟨x0, ⟨_, n, rfl⟩⟩, hx0⟩ := IsLocalization.surj (Submonoid.powers f) x'
      simp only at hx0
      have h1 : (Y.presheaf.map (homOfLE hle').op).hom ((τ.app W).hom x0) = 0 := by
        rw [← nat, ← hx0, map_mul, hx', zero_mul]
      have hWY : IsAffineOpen (τ ⁻¹ᵁ W) := hW.preimage τ
      letI : Algebra Γ(Y, τ ⁻¹ᵁ W) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) :=
        (Y.presheaf.map (homOfLE hle').op).hom.toAlgebra
      haveI : IsLocalization.Away ((τ.app W).hom f) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) :=
        hWY.isLocalization_of_eq_basicOpen ((τ.app W).hom f) (homOfLE hle')
          (τ.preimage_basicOpen f)
      obtain ⟨⟨_, k, rfl⟩, hk⟩ := (IsLocalization.map_eq_zero_iff
        (Submonoid.powers ((τ.app W).hom f)) Γ(Y, τ ⁻¹ᵁ X.basicOpen f) ((τ.app W).hom x0)).mp h1
      simp only at hk
      obtain ⟨y, hy⟩ := hker (f ^ k * x0) (by rw [RingHom.mem_ker, map_mul, map_pow]; exact hk)
      have key : x' * (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f *
          algebraMap Γ(X, W) Γ(X, X.basicOpen f) f ^ (k + n)) =
          algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * algebraMap Γ(X, W) Γ(X, X.basicOpen f) t := by
        have e := congrArg (algebraMap Γ(X, W) Γ(X, X.basicOpen f)) hy
        rw [map_mul, map_mul, map_mul, map_pow, ← hx0, map_pow] at e
        rw [← e]
        ring
      have hu := hfu.mul (hfu.pow (k + n))
      rw [Ideal.mem_span_singleton']
      refine ⟨algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * ↑hu.unit⁻¹, ?_⟩
      calc algebraMap Γ(X, W) Γ(X, X.basicOpen f) y * ↑hu.unit⁻¹ *
            algebraMap Γ(X, W) Γ(X, X.basicOpen f) t
          = (algebraMap Γ(X, W) Γ(X, X.basicOpen f) y *
            algebraMap Γ(X, W) Γ(X, X.basicOpen f) t) * ↑hu.unit⁻¹ := by ring
        _ = x' * (algebraMap Γ(X, W) Γ(X, X.basicOpen f) f *
            algebraMap Γ(X, W) Γ(X, X.basicOpen f) f ^ (k + n)) * ↑hu.unit⁻¹ := by rw [key]
        _ = x' := by rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat, hθt, map_zero]

  have wcpa_dj_mscc_cc_chart_morphism : ∀ (R : Type u) [CommRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)) (V : Z.Opens) (hle : V ≤ uu ⁻¹ᵁ ⊤) (g : MvPolynomial (Fin 1) R →+* Γ(Z, V)), IsAffineOpen V → g.Etale → g.comp MvPolynomial.C = (uu.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom → ∀ (U : Z.Opens) (hUV : U ≤ V), ∃ m : U.toScheme ⟶ Spec (.of (MvPolynomial (Fin 1) R)), Etale m ∧ m ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R)) = U.ι ≫ uu ∧ m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)) = U.topIso.inv.hom ((Z.presheaf.map (homOfLE hUV).op).hom (g (MvPolynomial.X 0))) := by
    intro R _ Z uu V hle g hV hg hgC U hUV
    have hSpec : Etale (Spec.map (CommRingCat.ofHom g)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hg
    refine ⟨Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g), inferInstance, ?_⟩
    have hE : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv ≫
        (Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop =
        CommRingCat.ofHom g ≫ Z.presheaf.map (homOfLE hUV).op ≫ U.topIso.inv := by
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, ← Category.assoc, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, IsAffineOpen.isoSpec_hom, Category.assoc,
        Scheme.Opens.toSpecΓ_appTop]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
      congr 1
      rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_inv, Scheme.Opens.topIso_inv]
      erw [← Functor.map_comp, ← Functor.map_comp]
      rfl
    have hEx : ∀ P, (Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom P) =
        U.topIso.inv.hom ((Z.presheaf.map (homOfLE hUV).op).hom (g P)) := by
      intro P
      have := congrArg (fun f => f.hom P) hE
      exact this
    refine ⟨?_, hEx _⟩
    apply ext_of_isAffine
    have hC : (Scheme.ΓSpecIso (.of R)).inv ≫ (Spec.map (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R))).appTop =
        CommRingCat.ofHom MvPolynomial.C ≫ (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv :=
      (Scheme.ΓSpecIso_inv_naturality _).symm
    rw [← cancel_epi (Scheme.ΓSpecIso (.of R)).inv]
    ext a
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, ← Category.assoc, hC, Category.assoc]
    change (Z.homOfLE hUV ≫ hV.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom g)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.C a)) = _
    rw [hEx]
    have hga : g (MvPolynomial.C a) = (uu.appLE ⊤ V hle).hom ((Scheme.ΓSpecIso (.of R)).inv.hom a) := by
      have := congrArg (fun f => f a) hgC
      exact this
    rw [hga]
    change ((uu.appLE ⊤ V hle ≫ Z.presheaf.map (homOfLE hUV).op ≫ U.topIso.inv).hom
        ((Scheme.ΓSpecIso (.of R)).inv.hom a)) =
      ((uu.appTop ≫ U.ι.appTop).hom ((Scheme.ΓSpecIso (.of R)).inv.hom a))
    congr 2
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv, Scheme.Hom.appLE, Scheme.Hom.appTop,
      Category.assoc]
    congr 1
    erw [← Functor.map_comp, ← Functor.map_comp]
    rfl

  have wcpa_dj_mscc_cc_ker_open_lift : ∀ (X T : Scheme.{u}) (U : X.Opens) (Δ : T ⟶ X) (ΔU : T ⟶ U.toScheme), ΔU ≫ U.ι = Δ → ∀ h : Γ(X, U), RingHom.ker (Δ.app U).hom = Ideal.span {h} → RingHom.ker ΔU.appTop.hom = Ideal.span {U.topIso.inv.hom h} := by
    intro X T U Δ ΔU hΔU h hker
    subst hΔU
    have e1 : (ΔU ≫ U.ι).app U = U.ι.app U ≫ ΔU.app (U.ι ⁻¹ᵁ U) := Scheme.Hom.comp_app _ _ _
    have e2 := Scheme.Hom.app_eq ΔU (Scheme.Opens.ι_preimage_self U)
    rw [e2] at e1
    have e3 : U.ι.app U ≫ U.toScheme.presheaf.map (eqToHom (Scheme.Opens.ι_preimage_self U).symm).op =
        U.topIso.inv := by
      rw [Scheme.Opens.topIso_inv, Scheme.Opens.ι_app_self]
      erw [← Functor.map_comp]
      congr 1
    rw [← Category.assoc, e3] at e1
    set κ := T.presheaf.map (eqToHom (congrArg (fun V => ΔU ⁻¹ᵁ V) (Scheme.Opens.ι_preimage_self U))).op
      with hκ
    have hκinj : Function.Injective κ.hom := by
      have : IsIso κ := by rw [hκ]; infer_instance
      exact (ConcreteCategory.bijective_of_isIso κ).1
    have key : ∀ x, ((ΔU ≫ U.ι).app U).hom x = κ.hom (ΔU.appTop.hom (U.topIso.inv.hom x)) := by
      intro x
      rw [e1]
      rfl
    ext y
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    have hy : y = U.topIso.inv.hom (U.topIso.hom.hom y) :=
      (CategoryTheory.Iso.hom_inv_id_apply U.topIso y).symm
    constructor
    · intro h0
      have h1 : U.topIso.hom.hom y ∈ RingHom.ker ((ΔU ≫ U.ι).app U).hom := by
        rw [RingHom.mem_ker, key, ← hy, h0]
        exact map_zero _
      rw [hker, Ideal.mem_span_singleton'] at h1
      obtain ⟨b, hb⟩ := h1
      refine ⟨U.topIso.inv.hom b, ?_⟩
      rw [← map_mul, hb, ← hy]
    · rintro ⟨b, hb⟩
      have h1 : U.topIso.hom.hom y ∈ RingHom.ker ((ΔU ≫ U.ι).app U).hom := by
        rw [hker, Ideal.mem_span_singleton']
        refine ⟨U.topIso.hom.hom b, ?_⟩
        rw [← hb, map_mul]
        congr 1
        exact (CategoryTheory.Iso.inv_hom_id_apply U.topIso h).symm
      rw [RingHom.mem_ker, key, ← hy] at h1
      apply hκinj
      rw [h1]
      exact (map_zero _).symm

  have wcpa_dj_mscc_cc_section_eval : ∀ (R : Type u) [CommRing R] (σ : Spec (.of R) ⟶ Spec (.of (MvPolynomial (Fin 1) R))), σ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R)) = 𝟙 _ → σ = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (Scheme.ΓSpecIso (.of R)).hom.hom (σ.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)))))) := by
    intro R _ σ hσ
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = σ := ⟨Spec.preimage σ, Spec.map_preimage σ⟩
    have hC : CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin 1) R) ≫ φ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hσ, Spec.map_id]
    have hnat := Scheme.ΓSpecIso_naturality φ
    have key : (Scheme.ΓSpecIso (.of R)).hom.hom ((Spec.map φ).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0))) = φ.hom (MvPolynomial.X 0) := by
      have := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0))) hnat
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this]
      congr 1
      exact CategoryTheory.Iso.inv_hom_id_apply (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))) _
    rw [key]
    congr 1
    ext1
    apply MvPolynomial.ringHom_ext
    · intro r
      have := congrArg (fun f => f.hom r) hC
      simpa using this
    · intro i
      rw [Subsingleton.elim i 0]
      simp

  have wcpa_dj_mscc_cc_closedPoint_eval : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (a b : R), Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a))) (IsLocalRing.closedPoint R) = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => b))) (IsLocalRing.closedPoint R) → a - b ∈ IsLocalRing.maximalIdeal R := by
    intro R _ _ a b h
    have h2 := congrArg PrimeSpectrum.asIdeal h
    have hb : (MvPolynomial.X 0 - MvPolynomial.C b : MvPolynomial (Fin 1) R) ∈
        (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => b))) (IsLocalRing.closedPoint R)).asIdeal := by
      show MvPolynomial.eval (fun _ : Fin 1 => b) (MvPolynomial.X 0 - MvPolynomial.C b) ∈ IsLocalRing.maximalIdeal R
      simp
    rw [← h2] at hb
    have : MvPolynomial.eval (fun _ : Fin 1 => a) (MvPolynomial.X 0 - MvPolynomial.C b) ∈ IsLocalRing.maximalIdeal R := hb
    simpa using this

  have wcpa_dj_mscc_cc_section_ext : ∀ (T U : Scheme.{u}) [IsAffine U] (π : U ⟶ T) (Δ τ : T ⟶ U), Δ ≫ π = 𝟙 _ → τ ≫ π = 𝟙 _ → RingHom.ker Δ.appTop.hom ≤ RingHom.ker τ.appTop.hom → Δ = τ := by
    intro T U _ π Δ τ hΔ hτ hk
    apply ext_of_isAffine
    ext x
    have e1 : ∀ y, Δ.appTop.hom (π.appTop.hom y) = y := by
      intro y
      have := congrArg (fun f => f.appTop.hom y) hΔ
      simp only [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop, CommRingCat.hom_comp,
        RingHom.comp_apply, CommRingCat.hom_id, RingHom.id_apply] at this
      exact this
    have e2 : ∀ y, τ.appTop.hom (π.appTop.hom y) = y := by
      intro y
      have := congrArg (fun f => f.appTop.hom y) hτ
      simp only [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop, CommRingCat.hom_comp,
        RingHom.comp_apply, CommRingCat.hom_id, RingHom.id_apply] at this
      exact this
    have hy : x - π.appTop.hom (Δ.appTop.hom x) ∈ RingHom.ker Δ.appTop.hom := by
      rw [RingHom.mem_ker, map_sub, e1, sub_self]
    have hy2 := hk hy
    rw [RingHom.mem_ker, map_sub, e2, sub_eq_zero] at hy2
    exact hy2.symm

  intro Ω _ _ W hW Z' u' Δ τ₀ hsep hlfp hΔ hτ hsm hmeet hdisj hp
  haveI := hsep
  obtain ⟨W₁, hτW₁, hW₁⟩ := hsm
  obtain ⟨p₀, hp₀⟩ := hp

  have hΔW₁ : Δ (IsLocalRing.closedPoint ↥W) ∈ W₁ := by rw [hmeet]; exact hτW₁
  obtain ⟨V, hle, g, hV, hΔV, hg, hgC, hbij⟩ :=
    wcpa_dj_mscc_cc_chart_at_section ↥W Z' u' Δ hΔ W₁ hW₁ hΔW₁

  have hFG := wcpa_dj_mscc_cc_ker_fg g (Δ.app V).hom hg hbij
  obtain ⟨g', r, hg', hg'C, hθX, hθr, hr⟩ :=
    wcpa_dj_mscc_cc_normalized_section_algebra g (Δ.app V).hom hg hbij hFG

  haveI : IsClosedImmersion (Δ ≫ u') := by rw [hΔ]; infer_instance
  haveI : IsClosedImmersion Δ := IsClosedImmersion.of_comp Δ u'
  have hK := wcpa_dj_mscc_cc_kernel_basicOpen Δ V hV (g' (MvPolynomial.X 0)) r hθX hr

  obtain ⟨m, hm, hmq, hmX⟩ := wcpa_dj_mscc_cc_chart_morphism ↥W Z' u' V hle g' hV hg'
    (hg'C.trans hgC) (Z'.basicOpen r) (Z'.basicOpen_le r)

  have hΔr : Δ (IsLocalRing.closedPoint ↥W) ∈ Z'.basicOpen r := by
    have h1 : IsLocalRing.closedPoint ↥W ∈ Δ ⁻¹ᵁ (Z'.basicOpen r) := by
      rw [Scheme.preimage_basicOpen, hθr, Scheme.basicOpen_one]
      exact hΔV
    exact h1
  have hτr : τ₀ (IsLocalRing.closedPoint ↥W) ∈ Z'.basicOpen r := by rw [← hmeet]; exact hΔr
  have hpreΔ : Δ ⁻¹ᵁ (Z'.basicOpen r) = ⊤ := Scheme.preimage_eq_top_of_closedPoint_mem Δ hΔr
  have hpreτ : τ₀ ⁻¹ᵁ (Z'.basicOpen r) = ⊤ := Scheme.preimage_eq_top_of_closedPoint_mem τ₀ hτr
  have hrangeΔ : Set.range Δ.base ⊆ Set.range (Z'.basicOpen r).ι.base := by
    rintro _ ⟨p, rfl⟩
    have hp : p ∈ Δ ⁻¹ᵁ (Z'.basicOpen r) := by rw [hpreΔ]; trivial
    have := Scheme.Opens.range_ι (Z'.basicOpen r)
    have h2 : Δ p ∈ Set.range (Z'.basicOpen r).ι := by rw [this]; exact hp
    exact h2
  have hrangeτ : Set.range τ₀.base ⊆ Set.range (Z'.basicOpen r).ι.base := by
    rintro _ ⟨p, rfl⟩
    have hp : p ∈ τ₀ ⁻¹ᵁ (Z'.basicOpen r) := by rw [hpreτ]; trivial
    have := Scheme.Opens.range_ι (Z'.basicOpen r)
    have h2 : τ₀ p ∈ Set.range (Z'.basicOpen r).ι := by rw [this]; exact hp
    exact h2
  obtain ⟨ΔU, hΔU⟩ : ∃ ΔU : Spec (.of ↥W) ⟶ (Z'.basicOpen r).toScheme, ΔU ≫ (Z'.basicOpen r).ι = Δ :=
    ⟨IsOpenImmersion.lift (Z'.basicOpen r).ι Δ hrangeΔ, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨τU, hτU⟩ : ∃ τU : Spec (.of ↥W) ⟶ (Z'.basicOpen r).toScheme, τU ≫ (Z'.basicOpen r).ι = τ₀ :=
    ⟨IsOpenImmersion.lift (Z'.basicOpen r).ι τ₀ hrangeτ, IsOpenImmersion.lift_fac _ _ _⟩

  have hKU := wcpa_dj_mscc_cc_ker_open_lift Z' (Spec (.of ↥W)) (Z'.basicOpen r) Δ ΔU hΔU _ hK
  rw [← hmX] at hKU

  have hsecΔ : (ΔU ≫ m) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = 𝟙 _ := by
    rw [Category.assoc, hmq, ← Category.assoc, hΔU, hΔ]
  have hG := wcpa_dj_mscc_cc_section_eval ↥W (ΔU ≫ m) hsecΔ
  have hX0 : ΔU.appTop.hom (m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
      (MvPolynomial.X 0))) = 0 := by
    have h1 : m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
        (MvPolynomial.X 0)) ∈ RingHom.ker ΔU.appTop.hom := by
      rw [hKU]; exact Ideal.subset_span rfl
    exact h1
  have hcΔ : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((ΔU ≫ m).appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) = 0 := by
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hX0, map_zero]
  rw [hcΔ] at hG

  have hsecτ : (τU ≫ m) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = 𝟙 _ := by
    rw [Category.assoc, hmq, ← Category.assoc, hτU, hτ]
  have hH := wcpa_dj_mscc_cc_section_eval ↥W (τU ≫ m) hsecτ
  obtain ⟨c, hc⟩ : ∃ c : ↥W, c = (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((τU ≫ m).appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) := ⟨_, rfl⟩
  rw [← hc] at hH

  have hpt : ΔU (IsLocalRing.closedPoint ↥W) = τU (IsLocalRing.closedPoint ↥W) := by
    apply (Z'.basicOpen r).ι.isOpenEmbedding.injective
    have e1 : (ΔU ≫ (Z'.basicOpen r).ι) (IsLocalRing.closedPoint ↥W) =
        (τU ≫ (Z'.basicOpen r).ι) (IsLocalRing.closedPoint ↥W) := by
      rw [hΔU, hτU]; exact hmeet
    exact e1
  have hpt2 : Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c)))
      (IsLocalRing.closedPoint ↥W) = Spec.map (CommRingCat.ofHom
        (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) (IsLocalRing.closedPoint ↥W) := by
    rw [← hH, ← hG]
    show m (τU (IsLocalRing.closedPoint ↥W)) = m (ΔU (IsLocalRing.closedPoint ↥W))
    rw [hpt]
  have hcm : c ∈ IsLocalRing.maximalIdeal ↥W := by
    have := wcpa_dj_mscc_cc_closedPoint_eval ↥W c 0 hpt2
    rwa [sub_zero] at this

  have hc0 : c ≠ 0 := by
    intro hc0
    have h2 : (Scheme.ΓSpecIso (.of ↥W)).hom.hom (τU.appTop.hom (m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)))) = 0 := by
      rw [← hc0, hc]
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    have h1 : τU.appTop.hom (m.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) = 0 := by
      have h3 := congrArg (Scheme.ΓSpecIso (.of ↥W)).inv.hom h2
      rw [map_zero] at h3
      rw [← h3]
      exact (CategoryTheory.Iso.hom_inv_id_apply (Scheme.ΓSpecIso (.of ↥W)) _).symm
    have hle' : RingHom.ker ΔU.appTop.hom ≤ RingHom.ker τU.appTop.hom := by
      rw [hKU, Ideal.span_singleton_le_iff_mem]; exact h1
    haveI : IsAffine (Z'.basicOpen r).toScheme := hV.basicOpen r
    have heq := wcpa_dj_mscc_cc_section_ext (Spec (.of ↥W)) (Z'.basicOpen r).toScheme
      ((Z'.basicOpen r).ι ≫ u') ΔU τU (by rw [← Category.assoc, hΔU, hΔ])
      (by rw [← Category.assoc, hτU, hτ]) hle'
    apply hdisj p₀ hp₀
    rw [← hΔU, ← hτU, heq]
  exact ⟨Z'.basicOpen r, m, c, ΔU, τU, hV.basicOpen r, hm, hmq, hc0, hcm, hΔU, hτU, hG, hH, hKU⟩

theorem wcpa_dj_ncmb_invpull_affine : ∀ {X T : Scheme.{u}} [IsAffine X] [IsAffine T] {ι : Type} [Finite ι] (g : ι → Γ(X, ⊤)) (h : T ⟶ X) (l : ι) (τ : ι → Γ(T, ⊤)), (∀ j, h.appTop.hom (g j) = τ j * h.appTop.hom (g l)) → h.appTop.hom (g l) ∈ nonZeroDivisors Γ(T, ⊤) → wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))) h :=
by
  intro X T _ _ ι _ g h l τ H1 H2
  let UX : X.affineOpens := ⟨⊤, by exact isAffineOpen_top X⟩
  let UT : T.affineOpens := ⟨⊤, by exact isAffineOpen_top T⟩
  have hVU : (UT : T.Opens) ≤ h ⁻¹ᵁ (UX : X.Opens) := le_of_eq rfl
  have hI : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))).ideal UX =
      Ideal.span (Set.range g) := by
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    have e : ∀ e' : (UX : X.Opens) ≤ ⊤, X.presheaf.map (homOfLE e').op = 𝟙 _ := by
      intro e'
      rw [show homOfLE e' = 𝟙 _ from Subsingleton.elim _ _]
      exact X.presheaf.map_id _
    rw [e]
    exact Ideal.map_id _
  have hA : h.appLE (UX : X.Opens) (UT : T.Opens) hVU = h.appTop := by
    have e : T.presheaf.map (homOfLE hVU).op = 𝟙 _ := by
      rw [show homOfLE hVU = 𝟙 _ from Subsingleton.elim _ _]
      exact T.presheaf.map_id _
    rw [Scheme.Hom.appLE, e]
    exact Category.comp_id _
  intro t
  refine ⟨UX, UT, hVU, g l, trivial, ?_, ?_, ?_⟩
  · rw [hI]
    exact Ideal.subset_span ⟨l, rfl⟩
  · rw [hA]
    exact H2
  · rw [hI, hA, Ideal.map_span]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro y ⟨x, ⟨j, rfl⟩, rfl⟩
      rw [SetLike.mem_coe, H1 j]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.span_singleton_le_iff_mem]
      exact Ideal.subset_span ⟨g l, ⟨l, rfl⟩, rfl⟩

theorem wcpa_dj_ncmb_chart_open_imm : ∀ {X X' : Scheme.{u}} [IsAffine X] {ι : Type} [Finite ι] (g : ι → Γ(X, ⊤)) (r : X' ⟶ X) (U : ι → X'.Opens) (t : ∀ l : ι, ι → Γ(X', U l)), wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))) r → wcBpChartHyp r g U t → ∀ (l : ι) (T : Scheme.{u}) [IsAffine T] (h : T ⟶ X) (τ : ι → Γ(T, ⊤)), (∀ j, h.appTop.hom (g j) = τ j * h.appTop.hom (g l)) → h.appTop.hom (g l) ∈ nonZeroDivisors Γ(T, ⊤) → (∀ s : Γ(T, ⊤), s ∈ Subring.closure (Set.range h.appTop.hom ∪ Set.range τ)) → (∃ φ : Γ(T, ⊤) →+* Γ(X', U l), φ.comp h.appTop.hom = (r.appLE ⊤ (U l) (by simp)).hom ∧ ∀ j, φ (τ j) = t l j) → ∃ c : T ⟶ X', c ≫ r = h ∧ IsOpenImmersion c ∧ Set.range c = (U l : Set X') :=
by
  intro X X' _ ι _ g r U t hr hU l T _ h τ hrel hnzd hgen hφ
  obtain ⟨φ, hφ1, hφ2⟩ := hφ
  obtain ⟨hU1, hU2, hU3, _hU4, hU5, hU6⟩ := hU

  have hinv : wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))) h := by
    let UX : X.affineOpens := ⟨⊤, by exact isAffineOpen_top X⟩
    let UT : T.affineOpens := ⟨⊤, by exact isAffineOpen_top T⟩
    have hVU : (UT : T.Opens) ≤ h ⁻¹ᵁ (UX : X.Opens) := le_of_eq rfl
    have hI : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))).ideal UX =
        Ideal.span (Set.range g) := by
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]
      have e : ∀ e' : (UX : X.Opens) ≤ ⊤, X.presheaf.map (homOfLE e').op = 𝟙 _ := by
        intro e'
        rw [show homOfLE e' = 𝟙 _ from Subsingleton.elim _ _]
        exact X.presheaf.map_id _
      rw [e]
      exact Ideal.map_id _
    have hA : h.appLE (UX : X.Opens) (UT : T.Opens) hVU = h.appTop := by
      have e : T.presheaf.map (homOfLE hVU).op = 𝟙 _ := by
        rw [show homOfLE hVU = 𝟙 _ from Subsingleton.elim _ _]
        exact T.presheaf.map_id _
      rw [Scheme.Hom.appLE, e]
      exact Category.comp_id _
    intro p
    refine ⟨UX, UT, hVU, g l, trivial, ?_, ?_, ?_⟩
    · rw [hI]
      exact Ideal.subset_span ⟨l, rfl⟩
    · rw [hA]
      exact hnzd
    · rw [hI, hA, Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro y ⟨x, ⟨j, rfl⟩, rfl⟩
        rw [SetLike.mem_coe, hrel j]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      · rw [Ideal.span_singleton_le_iff_mem]
        exact Ideal.subset_span ⟨g l, ⟨l, rfl⟩, rfl⟩

  obtain ⟨c, hc, -⟩ := hr.2 T h hinv
  subst hc

  have nzd_restrict : ∀ (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W → ∀ b : Γ(T, W),
      b ∈ nonZeroDivisors Γ(T, W) → T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (T.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
      haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
      exact hnz
    show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst

  have key : ∀ (W : X'.Opens) (V : T.Opens) (e : V ≤ c ⁻¹ᵁ W) (x : Γ(X, ⊤)),
      (c.appLE W V e).hom ((r.appLE ⊤ W (by simp)).hom x) =
        (T.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom ((c ≫ r).appTop.hom x) := by
    intro W V e x
    have h1 := Scheme.Hom.appLE_comp_appLE c r ⊤ W V (by simp) e
    have h2 := Scheme.Hom.appLE_map (c ≫ r) (U := ⊤) (V := ⊤) (V' := V) (by simp)
      (homOfLE (le_top : V ≤ ⊤)).op
    have h3 : (c ≫ r).appLE ⊤ ⊤ (by simp) = (c ≫ r).appTop := by
      have e' : T.presheaf.map (homOfLE (show (⊤ : T.Opens) ≤ (c ≫ r) ⁻¹ᵁ ⊤ by simp)).op = 𝟙 _ := by
        rw [show homOfLE (show (⊤ : T.Opens) ≤ (c ≫ r) ⁻¹ᵁ ⊤ by simp) = 𝟙 _ from
          Subsingleton.elim _ _]
        exact T.presheaf.map_id _
      show (c ≫ r).app ⊤ ≫ T.presheaf.map
        (homOfLE (show (⊤ : T.Opens) ≤ (c ≫ r) ⁻¹ᵁ ⊤ by simp)).op = _
      rw [e']
      exact Category.comp_id _
    have e1 : (c.appLE W V e).hom ((r.appLE ⊤ W (by simp)).hom x) =
        ((c ≫ r).appLE ⊤ V (by simp)).hom x := by
      rw [← h1]; rfl
    have e2 : ((c ≫ r).appLE ⊤ V (by simp)).hom x =
        (T.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (((c ≫ r).appLE ⊤ ⊤ (by simp)).hom x) := by
      rw [← h2]; rfl
    rw [e1, e2, h3]

  have hrange : ∀ p : T, c p ∈ U l := by
    intro p
    have hp : c p ∈ ⨆ k, U k := by rw [hU1]; trivial
    obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
    have hpV : p ∈ c ⁻¹ᵁ U k := hk
    have hnzdV : (T.presheaf.map (homOfLE (le_top : c ⁻¹ᵁ U k ≤ ⊤)).op).hom
        ((c ≫ r).appTop.hom (g l)) ∈ nonZeroDivisors Γ(T, c ⁻¹ᵁ U k) :=
      nzd_restrict ⊤ (c ⁻¹ᵁ U k) le_top (isAffineOpen_top T) _ hnzd
    have e3 := congrArg (c.appLE (U k) (c ⁻¹ᵁ U k) le_rfl).hom (hU3 k l)
    rw [map_mul, key, key, hrel k, map_mul] at e3
    have hunit : (c.appLE (U k) (c ⁻¹ᵁ U k) le_rfl).hom (t k l) *
        (T.presheaf.map (homOfLE (le_top : c ⁻¹ᵁ U k ≤ ⊤)).op).hom (τ k) = 1 := by
      have h0 : ((c.appLE (U k) (c ⁻¹ᵁ U k) le_rfl).hom (t k l) *
          (T.presheaf.map (homOfLE (le_top : c ⁻¹ᵁ U k ≤ ⊤)).op).hom (τ k) - 1) *
          (T.presheaf.map (homOfLE (le_top : c ⁻¹ᵁ U k ≤ ⊤)).op).hom
            ((c ≫ r).appTop.hom (g l)) = 0 := by
        linear_combination -e3
      exact sub_eq_zero.mp (mem_nonZeroDivisors_iff_right.mp hnzdV _ h0)
    have hu : IsUnit ((c.appLE (U k) (c ⁻¹ᵁ U k) le_rfl).hom (t k l)) :=
      IsUnit.of_mul_eq_one _ hunit
    have happ : c.appLE (U k) (c ⁻¹ᵁ U k) le_rfl = c.app (U k) := Scheme.Hom.appLE_eq_app c
    have hb : T.basicOpen ((c.app (U k)).hom (t k l)) = c ⁻¹ᵁ U k := by
      rw [← happ]; exact Scheme.basicOpen_of_isUnit T hu
    have hmem : p ∈ c ⁻¹ᵁ X'.basicOpen (t k l) := by
      rw [Scheme.preimage_basicOpen, hb]; exact hpV
    exact hU6 k l hmem
  have he : ⊤ ≤ c ⁻¹ᵁ U l := fun p _ => hrange p

  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Γ(X', U l) →+* Γ(T, ⊤), ψ = (c.appLE (U l) ⊤ he).hom := ⟨_, rfl⟩
  have hres_top : ∀ y : Γ(T, ⊤),
      (T.presheaf.map (homOfLE (le_top : (⊤ : T.Opens) ≤ ⊤)).op).hom y = y := by
    intro y
    rw [show homOfLE (le_top : (⊤ : T.Opens) ≤ ⊤) = 𝟙 _ from Subsingleton.elim _ _, op_id,
      T.presheaf.map_id]
    rfl
  have hψρ : ∀ x, ψ ((r.appLE ⊤ (U l) (by simp)).hom x) = (c ≫ r).appTop.hom x := by
    intro x
    rw [hψdef, key, hres_top]
  have hψt : ∀ j, ψ (t l j) = τ j := by
    intro j
    have e := congrArg ψ (hU3 l j)
    rw [map_mul, hψρ, hψρ, hrel j] at e
    have h0 : (ψ (t l j) - τ j) * (c ≫ r).appTop.hom (g l) = 0 := by
      linear_combination -e
    exact sub_eq_zero.mp (mem_nonZeroDivisors_iff_right.mp hnzd _ h0)
  have hψφ : ∀ s, ψ (φ s) = s := by
    have heq : Set.EqOn (ψ.comp φ) (RingHom.id _)
        (Set.range (c ≫ r).appTop.hom ∪ Set.range τ) := by
      rintro s (⟨x, rfl⟩ | ⟨j, rfl⟩)
      · show ψ (φ ((c ≫ r).appTop.hom x)) = (c ≫ r).appTop.hom x
        rw [show φ ((c ≫ r).appTop.hom x) = (r.appLE ⊤ (U l) (by simp)).hom x from
          DFunLike.congr_fun hφ1 x, hψρ]
      · show ψ (φ (τ j)) = τ j
        rw [hφ2, hψt]
    intro s
    exact RingHom.eqOn_set_closure heq (hgen s)
  have hφsurj : ∀ y : Γ(X', U l), ∃ s, φ s = y := by
    intro y
    have hle : Subring.closure (Set.range (r.appLE ⊤ (U l) (by simp)).hom ∪ Set.range (t l)) ≤
        φ.range := by
      rw [Subring.closure_le]
      rintro s (⟨x, rfl⟩ | ⟨j, rfl⟩)
      · exact ⟨(c ≫ r).appTop.hom x, DFunLike.congr_fun hφ1 x⟩
      · exact ⟨τ j, hφ2 j⟩
    exact RingHom.mem_range.mp (hle (hU5 l y))
  have hbij : Function.Bijective ψ := by
    refine ⟨fun y1 y2 hy => ?_, fun s => ⟨φ s, hψφ s⟩⟩
    obtain ⟨s1, rfl⟩ := hφsurj y1
    obtain ⟨s2, rfl⟩ := hφsurj y2
    rw [hψφ, hψφ] at hy
    rw [hy]

  have hTaff : IsAffineOpen (⊤ : T.Opens) := isAffineOpen_top T
  have hsq := IsAffineOpen.SpecMap_appLE_fromSpec c (hU2 l) hTaff he
  haveI : IsIso (c.appLE (U l) ⊤ he) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr (by rw [hψdef] at hbij; exact hbij)
  haveI : IsIso hTaff.fromSpec := by rw [IsAffineOpen.fromSpec_top]; infer_instance
  obtain ⟨E, hE⟩ : ∃ E : T ⟶ Spec Γ(X', U l),
      E = inv hTaff.fromSpec ≫ Spec.map (c.appLE (U l) ⊤ he) := ⟨_, rfl⟩
  haveI : IsIso E := by rw [hE]; infer_instance
  have hc : c = E ≫ (hU2 l).fromSpec := by
    rw [hE, Category.assoc, hsq, IsIso.inv_hom_id_assoc]
  refine ⟨c, rfl, ?_, ?_⟩
  · rw [hc]; infer_instance
  · rw [← (hU2 l).range_fromSpec, hc]
    ext x
    constructor
    · rintro ⟨p, rfl⟩
      exact ⟨E p, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨y, rfl⟩
      refine ⟨(inv E) y, ?_⟩
      rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply (inv E) E, IsIso.inv_hom_id]
      rfl

theorem wcpa_dj_ncmb_fibre_iso : ∀ (R : Type u) [CommRing R] (c : R) (K : Type u) [Field K] (sp : Spec (.of K) ⟶ Spec (.of R)), ∃ Φ : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})))) sp ≅ Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ((Spec.preimage sp).hom c)})), Φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C ((Spec.preimage sp).hom c)}))) = Limits.pullback.snd _ sp :=
by
  intro R _ c K _ sp
  have hpush : ∀ (φ : CommRingCat.of R ⟶ CommRingCat.of K), ∃ inl : CommRingCat.of (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) ⟶ CommRingCat.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ.hom c)}),
      IsPushout (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))) φ inl (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ.hom c)}))) := by
    intro φ
    set I : Ideal (MvPolynomial (Fin 2) R) := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c} with hI
    set IK : Ideal (MvPolynomial (Fin 2) K) := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (φ.hom c)} with hIK
    have hle : I ≤ IK.comap (MvPolynomial.map φ.hom) := by
      rw [hI, Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      simp only [SetLike.mem_coe, Ideal.mem_comap, map_sub, map_mul, MvPolynomial.map_X,
        MvPolynomial.map_C]
      rw [hIK]
      exact Ideal.mem_span_singleton_self _
    have halR : ∀ r : R, algebraMap R (MvPolynomial (Fin 2) R ⧸ I) r = Ideal.Quotient.mk I (MvPolynomial.C r) := fun r => rfl
    have halK : ∀ k : K, algebraMap K (MvPolynomial (Fin 2) K ⧸ IK) k = Ideal.Quotient.mk IK (MvPolynomial.C k) := fun k => rfl
    let inl : CommRingCat.of (MvPolynomial (Fin 2) R ⧸ I) ⟶ CommRingCat.of (MvPolynomial (Fin 2) K ⧸ IK) :=
      CommRingCat.ofHom (Ideal.quotientMap IK (MvPolynomial.map φ.hom) hle)
    have hinl : ∀ p, inl.hom (Ideal.Quotient.mk I p) = Ideal.Quotient.mk IK (MvPolynomial.map φ.hom p) := fun p => by
      simp only [inl, CommRingCat.hom_ofHom, Ideal.quotientMap_mk]
    refine ⟨inl, ?_⟩
    have hcomm : CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 2) R ⧸ I)) ≫ inl = φ ≫ CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 2) K ⧸ IK)) := by
      ext r
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp, Function.comp_apply]
      rw [halR, hinl, halK, MvPolynomial.map_C]
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk inl _ hcomm) ?_
    have hcond : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 2) R ⧸ I))) φ, ∀ r : R,
        s.inl.hom (Ideal.Quotient.mk I (MvPolynomial.C r)) = s.inr.hom (φ.hom r) := by
      intro s r
      have h := congrArg (fun g => g.hom r) s.condition
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp, Function.comp_apply] at h
      rw [halR] at h
      exact h
    let E : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 2) R ⧸ I))) φ,
        MvPolynomial (Fin 2) K →+* s.pt := fun s =>
      MvPolynomial.eval₂Hom s.inr.hom (fun i => s.inl.hom (Ideal.Quotient.mk I (MvPolynomial.X i)))
    have hEX : ∀ s, ∀ i, E s (MvPolynomial.X i) = s.inl.hom (Ideal.Quotient.mk I (MvPolynomial.X i)) := by
      intro s i
      simp only [E, MvPolynomial.eval₂Hom_X']
    have hEC : ∀ s, ∀ k, E s (MvPolynomial.C k) = s.inr.hom k := by
      intro s k
      simp only [E, MvPolynomial.eval₂Hom_C]
    have hEker : ∀ s, ∀ a ∈ IK, E s a = 0 := by
      intro s a ha
      rw [hIK, Ideal.mem_span_singleton'] at ha
      obtain ⟨b, rfl⟩ := ha
      have h0 : Ideal.Quotient.mk I (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem, hI]
        exact Ideal.mem_span_singleton_self _
      have h1 : s.inl.hom (Ideal.Quotient.mk I (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c)) = 0 := by
        rw [h0, map_zero]
      simp only [map_sub, map_mul] at h1
      rw [hcond] at h1
      simp only [map_mul, map_sub, hEX, hEC]
      rw [h1, mul_zero]
    let desc : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 2) R ⧸ I))) φ,
        CommRingCat.of (MvPolynomial (Fin 2) K ⧸ IK) ⟶ s.pt := fun s =>
      CommRingCat.ofHom (Ideal.Quotient.lift IK (E s) (hEker s))
    have hdesc : ∀ s p, (desc s).hom (Ideal.Quotient.mk IK p) = E s p := by
      intro s p
      simp only [desc, CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk]
    refine Limits.PushoutCocone.IsColimit.mk _ desc ?_ ?_ ?_
    · intro s
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [CommRingCat.hom_comp, RingHom.comp_apply]
        rw [hinl, MvPolynomial.map_C, hdesc, hEC, hcond]
      · intro i
        simp only [CommRingCat.hom_comp, RingHom.comp_apply]
        rw [hinl, MvPolynomial.map_X, hdesc, hEX]
    · intro s
      ext k
      simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply, CommRingCat.hom_ofHom]
      rw [halK, hdesc, hEC]
    · intro s m h1 h2
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [RingHom.comp_apply]
        rw [hdesc, hEC, ← h2, CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom, halK]
      · intro i
        simp only [RingHom.comp_apply]
        rw [hdesc, hEX, ← h1, CommRingCat.hom_comp, RingHom.comp_apply, hinl, MvPolynomial.map_X]
  obtain ⟨inl, hP⟩ := hpush (Spec.preimage sp)
  have hP' := isPullback_SpecMap_of_isPushout _ _ _ _ hP
  rw [Spec.map_preimage] at hP'
  exact ⟨hP'.isoPullback.symm, by rw [Iso.symm_hom]; exact hP'.isoPullback_inv_snd⟩

theorem wcpa_dj_ncmb_basicOpen_smooth : ∀ (R : Type u) [CommRing R] (c : R) (i : Fin 2), SmoothOfRelativeDimension 1 (((Spec (.of (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))).basicOpen ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))).inv.hom (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X i)))).ι ≫ Spec.map (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})))) :=
by
  intro R _ c i

  have transfer : ∀ (S : Type u) [CommRing S] [Algebra R S] (f : S) (n : ℕ),
      Algebra.IsStandardSmoothOfRelativeDimension n R (Localization.Away f) →
      SmoothOfRelativeDimension n (((Spec (.of S)).basicOpen
        ((Scheme.ΓSpecIso (.of S)).inv.hom f)).ι ≫ Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
    intro S _ _ f n hsm
    haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away f)))) :=
      @IsOpenImmersion.of_isLocalization S (Localization.Away f) _ _ _ f _
    have hrange : Set.range (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away f)))) =
        Set.range ((Spec (.of S)).basicOpen ((Scheme.ΓSpecIso (.of S)).inv.hom f)).ι := by
      rw [Scheme.Opens.range_ι, basicOpen_eq_of_affine]
      exact PrimeSpectrum.localization_away_comap_range (Localization.Away f) f
    have hfac := IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hrange
    have hfac' : (IsOpenImmersion.isoOfRangeEq _ _ hrange).inv ≫
        Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away f))) =
        ((Spec (.of S)).basicOpen ((Scheme.ΓSpecIso (.of S)).inv.hom f)).ι := by
      rw [Iso.inv_comp_eq]; exact hfac.symm
    have hSpec : SmoothOfRelativeDimension n
        (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f)))) := by
      apply (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension n)).mpr
      exact RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _
        ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr hsm)
    have hmap : Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f))) =
        Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away f))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap R S)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    have hcomp : ((Spec (.of S)).basicOpen ((Scheme.ΓSpecIso (.of S)).inv.hom f)).ι ≫
        Spec.map (CommRingCat.ofHom (algebraMap R S)) =
        (IsOpenImmersion.isoOfRangeEq _ _ hrange).inv ≫
          Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f))) := by
      rw [hmap, ← Category.assoc, hfac']
    rw [hcomp]
    have := smoothOfRelativeDimension_comp 0 n (IsOpenImmersion.isoOfRangeEq _ _ hrange).inv
      (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f))))
    simpa using this

  have gen : ∀ (S : Type u) [CommRing S] [Algebra R S] (x y : S),
      x * y = algebraMap R S c →
      (∀ g h : S →+* Localization.Away x, (∀ r, g (algebraMap R S r) = h (algebraMap R S r)) →
        g x = h x → g y = h y → g = h) →
      ∀ α : S →ₐ[R] Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R),
      α x = algebraMap (MvPolynomial (Fin 1) R) _ (MvPolynomial.X 0) →
      α y = algebraMap R _ c *
        IsLocalization.Away.invSelf (MvPolynomial.X 0 : MvPolynomial (Fin 1) R) →
      Nonempty (Localization.Away x ≃ₐ[R]
        Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) := by
    intro S _ _ x y hxy hext α hαx hαy
    have hu : IsUnit (α x) := by
      rw [hαx]; exact IsLocalization.Away.algebraMap_isUnit _
    let Fwd := IsLocalization.Away.lift (S := Localization.Away x) x (g := α.toRingHom) hu
    have hu' : IsUnit (MvPolynomial.aeval (fun _ : Fin 1 => algebraMap S (Localization.Away x) x)
        (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) := by
      rw [MvPolynomial.aeval_X]; exact IsLocalization.Away.algebraMap_isUnit x
    let Bwd := IsLocalization.Away.lift
      (S := Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R))
      (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)
      (g := (MvPolynomial.aeval (fun _ : Fin 1 => algebraMap S (Localization.Away x) x)).toRingHom) hu'
    have hF : ∀ s, Fwd (algebraMap S _ s) = α s := fun s => IsLocalization.Away.lift_eq x hu s
    have hB : ∀ p, Bwd (algebraMap _ _ p) =
        MvPolynomial.aeval (fun _ : Fin 1 => algebraMap S (Localization.Away x) x) p :=
      fun p => IsLocalization.Away.lift_eq _ hu' p
    have hFR : ∀ r, Fwd (algebraMap R (Localization.Away x) r) = algebraMap R _ r := by
      intro r
      rw [IsScalarTower.algebraMap_apply R S (Localization.Away x), hF, α.commutes]
    have hBR : ∀ r, Bwd (algebraMap R
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) r) = algebraMap R _ r := by
      intro r
      rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin 1) R) (Localization.Away _), hB,
        AlgHom.commutes]
    have hFB : Fwd.comp Bwd = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin 1) R))
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hB, MvPolynomial.aeval_C, hFR,
          IsScalarTower.algebraMap_apply R (MvPolynomial (Fin 1) R) (Localization.Away _),
          MvPolynomial.algebraMap_eq]
      · intro k
        obtain rfl : k = 0 := Subsingleton.elim k 0
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hB, MvPolynomial.aeval_X, hF, hαx]
    have hBF : Bwd.comp Fwd = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x)
      apply hext
      · intro r
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hF, α.commutes, hBR, ← IsScalarTower.algebraMap_apply]
      · simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hF, hαx, hB, MvPolynomial.aeval_X]
      · simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hF, hαy, map_mul, hBR]
        have h1 : algebraMap S (Localization.Away x) x *
            Bwd (IsLocalization.Away.invSelf (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) = 1 := by
          have := hB (MvPolynomial.X 0)
          rw [MvPolynomial.aeval_X] at this
          rw [← this, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
        have h2 : algebraMap R (Localization.Away x) c =
            algebraMap S (Localization.Away x) x * algebraMap S (Localization.Away x) y := by
          rw [IsScalarTower.algebraMap_apply R S (Localization.Away x), ← hxy, map_mul]
        linear_combination (algebraMap S (Localization.Away x) y) * h1 +
          (Bwd (IsLocalization.Away.invSelf (MvPolynomial.X 0 : MvPolynomial (Fin 1) R))) * h2
    exact ⟨AlgEquiv.ofRingEquiv (f := RingEquiv.ofRingHom Fwd Bwd hFB hBF) hFR⟩

  have hL : Algebra.IsStandardSmoothOfRelativeDimension 1 R
      (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) := by
    haveI h1 : Algebra.IsStandardSmoothOfRelativeDimension 1 R (MvPolynomial (Fin 1) R) := by
      have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial R (Fin 1)
      simpa using this
    haveI h0 : Algebra.IsStandardSmoothOfRelativeDimension 0 (MvPolynomial (Fin 1) R)
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (MvPolynomial.X 0)
    have := Algebra.IsStandardSmoothOfRelativeDimension.trans 1 0 R (MvPolynomial (Fin 1) R)
      (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R))
    simpa using this

  have hcases : ∀ a b k : Fin 2, a ≠ b → k = a ∨ k = b := by decide
  have spec : ∀ a b : Fin 2, a ≠ b →
      (MvPolynomial.X a * MvPolynomial.X b : MvPolynomial (Fin 2) R) =
        MvPolynomial.X 0 * MvPolynomial.X 1 →
      Nonempty (Localization.Away (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X a)) ≃ₐ[R]
        Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) := by
    intro a b hab hprod
    have huv := IsLocalization.Away.mul_invSelf
      (S := Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R))
      (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)
    refine gen _ (Ideal.Quotient.mk _ (MvPolynomial.X a)) (Ideal.Quotient.mk _ (MvPolynomial.X b))
      ?_ ?_ (Ideal.Quotient.liftₐ _ (MvPolynomial.aeval (fun k => if k = a then
        algebraMap (MvPolynomial (Fin 1) R)
          (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) (MvPolynomial.X 0)
        else algebraMap R _ c *
          IsLocalization.Away.invSelf (MvPolynomial.X 0 : MvPolynomial (Fin 1) R))) ?_) ?_ ?_
    · rw [← map_mul, hprod, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq,
        Ideal.Quotient.eq]
      exact Ideal.mem_span_singleton_self _
    · intro g h hR hx hy
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        have := hR r
        rwa [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq] at this
      · intro k
        rcases hcases a b k hab with rfl | rfl
        · exact hx
        · exact hy
    · intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, ← hprod]
      simp only [map_sub, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C, ↓reduceIte,
        if_neg (Ne.symm hab)]
      linear_combination (MvPolynomial.aeval _ q * algebraMap R _ c) * huv
    · rw [Ideal.Quotient.liftₐ_apply]
      refine (Ideal.Quotient.lift_mk _ _ _).trans ?_
      simp
    · rw [Ideal.Quotient.liftₐ_apply]
      refine (Ideal.Quotient.lift_mk _ _ _).trans ?_
      simp [Ne.symm hab]
  haveI := hL
  have hS : Algebra.IsStandardSmoothOfRelativeDimension 1 R
      (Localization.Away (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X i))) := by
    obtain ⟨e⟩ : Nonempty (Localization.Away (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 *
        MvPolynomial.X 1 - MvPolynomial.C c}) (MvPolynomial.X i)) ≃ₐ[R]
        Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) R)) := by
      obtain rfl | rfl : i = 0 ∨ i = 1 := hcases 0 1 i (by decide)
      · exact spec 0 1 (by decide) rfl
      · exact spec 1 0 (by decide) (mul_comm _ _)
    exact Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 e.symm
  exact transfer _ _ 1 hS

theorem wcpa_dj_lr1s_sgf_nodal_membership : ∀ (F : Type u) [CommRing F], ∀ f : MvPowerSeries (Fin 2) F, (∀ n : ℕ, f ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ^ n ⊔ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ↔ ∀ a < n, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧ MvPowerSeries.coeff (Finsupp.single 1 a) f = 0) ∧ (f ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ↔ ∀ a : ℕ, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧ MvPowerSeries.coeff (Finsupp.single 1 a) f = 0) :=
by
  intro F _ f
  classical
  obtain ⟨e, he⟩ : ∃ e : Fin 2 →₀ ℕ, e = Finsupp.single 0 1 + Finsupp.single 1 1 := ⟨_, rfl⟩
  have hxy : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) F)
      = MvPowerSeries.monomial e 1 := by
    rw [he, ← pow_one (MvPowerSeries.X (0 : Fin 2)), ← pow_one (MvPowerSeries.X (1 : Fin 2)),
      MvPowerSeries.X_pow_eq, MvPowerSeries.X_pow_eq, MvPowerSeries.monomial_mul_monomial, mul_one]
  have hle : ∀ d : Fin 2 →₀ ℕ, e ≤ d ↔ 1 ≤ d 0 ∧ 1 ≤ d 1 := by
    intro d
    rw [he, Finsupp.le_def, Fin.forall_fin_two]
    simp
  have hF2a : ∀ d : Fin 2 →₀ ℕ, d 1 = 0 → d = Finsupp.single 0 (d 0) := by
    intro d h
    ext i
    fin_cases i <;> simp [h]
  have hF2b : ∀ d : Fin 2 →₀ ℕ, d 0 = 0 → d = Finsupp.single 1 (d 1) := by
    intro d h
    ext i
    fin_cases i <;> simp [h]

  have hB : ∀ g : MvPowerSeries (Fin 2) F,
      g ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ↔
      ∀ a : ℕ, MvPowerSeries.coeff (Finsupp.single 0 a) g = 0 ∧
        MvPowerSeries.coeff (Finsupp.single 1 a) g = 0 := by
    intro g
    rw [Ideal.mem_span_singleton', hxy]
    constructor
    · rintro ⟨c, rfl⟩ a
      rw [mul_comm, MvPowerSeries.coeff_monomial_mul, MvPowerSeries.coeff_monomial_mul]
      constructor
      · rw [if_neg]
        rw [hle]
        simp
      · rw [if_neg]
        rw [hle]
        simp
    · intro h
      obtain ⟨C, hC⟩ : ∃ C : MvPowerSeries (Fin 2) F,
          ∀ d, MvPowerSeries.coeff d C = MvPowerSeries.coeff (d + e) g := ⟨fun d => _, fun d => rfl⟩
      refine ⟨C, ?_⟩
      rw [mul_comm]
      ext d
      rw [MvPowerSeries.coeff_monomial_mul, one_mul]
      by_cases hd : e ≤ d
      · rw [if_pos hd, hC, tsub_add_cancel_of_le hd]
      · rw [if_neg hd]
        rw [hle] at hd
        by_cases h1 : d 1 = 0
        · rw [hF2a d h1]; exact ((h _).1).symm
        · have h0 : d 0 = 0 := by omega
          rw [hF2b d h0]; exact ((h _).2).symm

  have hord : ∀ n : ℕ, ∀ g ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} :
      Ideal (MvPowerSeries (Fin 2) F)) ^ n, (n : ℕ∞) ≤ g.order := by
    have hX : ∀ s : Fin 2, (1 : ℕ∞) ≤ (MvPowerSeries.X s : MvPowerSeries (Fin 2) F).order := by
      intro s
      apply MvPowerSeries.le_order
      intro d hd
      have h1 : Finsupp.degree d < 1 := by exact_mod_cast hd
      have h2 : Finsupp.degree d = 0 := by omega
      rw [(Finsupp.degree_eq_zero_iff d).mp h2]
      exact MvPowerSeries.coeff_zero_X s
    intro n
    induction n with
    | zero => intro g _; simp
    | succ n ih =>
      intro g hg
      rw [pow_succ] at hg
      refine Submodule.mul_induction_on hg ?_ ?_
      · intro a ha b hb
        have hb1 : (1 : ℕ∞) ≤ b.order := by
          obtain ⟨c, c', rfl⟩ := Ideal.mem_span_pair.mp hb
          have h1 : (1 : ℕ∞) ≤ (c * MvPowerSeries.X 0).order :=
            le_trans (le_trans (hX 0) le_add_self) MvPowerSeries.le_order_mul
          have h2 : (1 : ℕ∞) ≤ (c' * MvPowerSeries.X 1).order :=
            le_trans (le_trans (hX 1) le_add_self) MvPowerSeries.le_order_mul
          exact le_trans (le_min h1 h2) MvPowerSeries.min_order_le_add
        calc ((n + 1 : ℕ) : ℕ∞) = (n : ℕ∞) + 1 := by push_cast; rfl
          _ ≤ a.order + b.order := add_le_add (ih a ha) hb1
          _ ≤ (a * b).order := MvPowerSeries.le_order_mul
      · intro x y hx hy
        exact le_trans (le_min hx hy) MvPowerSeries.min_order_le_add
  refine ⟨fun n => ⟨?_, ?_⟩, hB f⟩
  · intro hf a ha
    obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp hf
    have hu' := hord n u hu
    have hv' := (hB v).mp hv a
    have hc : ∀ i : Fin 2, MvPowerSeries.coeff (Finsupp.single i a) u = 0 := by
      intro i
      apply MvPowerSeries.coeff_of_lt_order
      rw [Finsupp.degree_single]
      exact lt_of_lt_of_le (by exact_mod_cast ha) hu'
    rw [map_add, map_add, hc 0, hc 1, hv'.1, hv'.2]
    simp
  · intro h
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_sup_left Submodule.mem_top
    · obtain ⟨A, hA⟩ : ∃ A : MvPowerSeries (Fin 2) F, ∀ d, MvPowerSeries.coeff d A =
          if d 1 = 0 then MvPowerSeries.coeff (d + Finsupp.single 0 n) f else 0 :=
        ⟨fun d => _, fun d => rfl⟩
      obtain ⟨B, hB'⟩ : ∃ B : MvPowerSeries (Fin 2) F, ∀ d, MvPowerSeries.coeff d B =
          if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 n) f else 0 :=
        ⟨fun d => _, fun d => rfl⟩
      obtain ⟨C, hC⟩ : ∃ C : MvPowerSeries (Fin 2) F,
          ∀ d, MvPowerSeries.coeff d C = MvPowerSeries.coeff (d + e) f := ⟨fun d => _, fun d => rfl⟩
      have T1 : ∀ d, MvPowerSeries.coeff d (MvPowerSeries.monomial (Finsupp.single 0 n) 1 * A) =
          if n ≤ d 0 ∧ d 1 = 0 then MvPowerSeries.coeff d f else 0 := by
        intro d
        rw [MvPowerSeries.coeff_monomial_mul, one_mul]
        by_cases h1 : n ≤ d 0
        · rw [if_pos (Finsupp.single_le_iff.mpr h1), hA,
            tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr h1)]
          have : (d - Finsupp.single 0 n : Fin 2 →₀ ℕ) 1 = d 1 := by simp
          rw [this]
          by_cases h2 : d 1 = 0
          · rw [if_pos h2, if_pos ⟨h1, h2⟩]
          · rw [if_neg h2, if_neg (fun h' => h2 h'.2)]
        · rw [if_neg (fun h' => h1 (Finsupp.single_le_iff.mp h')), if_neg (fun h' => h1 h'.1)]
      have T2 : ∀ d, MvPowerSeries.coeff d (MvPowerSeries.monomial (Finsupp.single 1 n) 1 * B) =
          if n ≤ d 1 ∧ d 0 = 0 then MvPowerSeries.coeff d f else 0 := by
        intro d
        rw [MvPowerSeries.coeff_monomial_mul, one_mul]
        by_cases h1 : n ≤ d 1
        · rw [if_pos (Finsupp.single_le_iff.mpr h1), hB',
            tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr h1)]
          have : (d - Finsupp.single 1 n : Fin 2 →₀ ℕ) 0 = d 0 := by simp
          rw [this]
          by_cases h2 : d 0 = 0
          · rw [if_pos h2, if_pos ⟨h1, h2⟩]
          · rw [if_neg h2, if_neg (fun h' => h2 h'.2)]
        · rw [if_neg (fun h' => h1 (Finsupp.single_le_iff.mp h')), if_neg (fun h' => h1 h'.1)]
      have T3 : ∀ d, MvPowerSeries.coeff d (MvPowerSeries.monomial e 1 * C) =
          if 1 ≤ d 0 ∧ 1 ≤ d 1 then MvPowerSeries.coeff d f else 0 := by
        intro d
        rw [MvPowerSeries.coeff_monomial_mul, one_mul]
        by_cases h1 : e ≤ d
        · rw [if_pos h1, hC, tsub_add_cancel_of_le h1, if_pos ((hle d).mp h1)]
        · rw [if_neg h1, if_neg (fun h' => h1 ((hle d).mpr h'))]
      have hdec : f = MvPowerSeries.monomial (Finsupp.single 0 n) 1 * A +
          MvPowerSeries.monomial (Finsupp.single 1 n) 1 * B + MvPowerSeries.monomial e 1 * C := by
        ext d
        have hz : ¬(n ≤ d 0 ∧ d 1 = 0) → ¬(n ≤ d 1 ∧ d 0 = 0) → ¬(1 ≤ d 0 ∧ 1 ≤ d 1) →
            MvPowerSeries.coeff d f = 0 := by
          intro q1 q2 q3
          by_cases h1 : d 1 = 0
          · rw [hF2a d h1]; exact (h (d 0) (by omega)).1
          · have h0 : d 0 = 0 := by omega
            rw [hF2b d h0]; exact (h (d 1) (by omega)).2
        rw [map_add, map_add, T1, T2, T3]
        by_cases p1 : n ≤ d 0 ∧ d 1 = 0
        · have p2 : ¬(n ≤ d 1 ∧ d 0 = 0) := by omega
          have p3 : ¬(1 ≤ d 0 ∧ 1 ≤ d 1) := by omega
          rw [if_pos p1, if_neg p2, if_neg p3, add_zero, add_zero]
        · by_cases p2 : n ≤ d 1 ∧ d 0 = 0
          · have p3 : ¬(1 ≤ d 0 ∧ 1 ≤ d 1) := by omega
            rw [if_neg p1, if_pos p2, if_neg p3, add_zero, zero_add]
          · by_cases p3 : 1 ≤ d 0 ∧ 1 ≤ d 1
            · rw [if_neg p1, if_neg p2, if_pos p3, zero_add, zero_add]
            · rw [if_neg p1, if_neg p2, if_neg p3, add_zero, add_zero]
              exact hz p1 p2 p3
      rw [hdec]
      have hx : MvPowerSeries.monomial (Finsupp.single 0 n) (1 : F) ∈
          (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ^ n := by
        rw [← MvPowerSeries.X_pow_eq]
        exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) n
      have hy : MvPowerSeries.monomial (Finsupp.single 1 n) (1 : F) ∈
          (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ^ n := by
        rw [← MvPowerSeries.X_pow_eq]
        exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) n
      refine add_mem (Submodule.mem_sup_left (add_mem (Ideal.mul_mem_right _ _ hx)
        (Ideal.mul_mem_right _ _ hy))) (Submodule.mem_sup_right ?_)
      rw [← hxy]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

theorem wcpa_dj_lr1s_sgf_nodal_ring_structure : ∀ (F : Type u) [Field F], (∀ f : MvPowerSeries (Fin 2) F, (∀ n : ℕ, f ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ^ n ⊔ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ↔ ∀ a < n, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧ MvPowerSeries.coeff (Finsupp.single 1 a) f = 0) ∧ (f ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ↔ ∀ a : ℕ, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧ MvPowerSeries.coeff (Finsupp.single 1 a) f = 0)) → (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))).IsMaximal ∧ (∀ x : (MvPowerSeries (Fin 2) F ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))), x ∉ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) → IsUnit x) ∧ (∀ f : MvPowerSeries (Fin 2) F, Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) f - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) (MvPowerSeries.C (MvPowerSeries.constantCoeff f)) ∈ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)))) ∧ IsAdicComplete (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) (MvPowerSeries (Fin 2) F ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) :=
by
  intro F _ MEM
  classical
  set J : Ideal (MvPowerSeries (Fin 2) F) :=
    Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} with hJ
  set M : Ideal (MvPowerSeries (Fin 2) F) :=
    Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} with hM
  set N : Ideal (MvPowerSeries (Fin 2) F ⧸ J) := Ideal.map (Ideal.Quotient.mk J) M with hN
  have memq : ∀ (f : MvPowerSeries (Fin 2) F) (n : ℕ), Ideal.Quotient.mk J f ∈ N ^ n ↔
      ∀ a < n, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧
        MvPowerSeries.coeff (Finsupp.single 1 a) f = 0 := by
    intro f n
    rw [hN, ← Ideal.map_pow, Ideal.mem_quotient_iff_mem_sup]
    exact (MEM f).1 n
  have c1 : ∀ f : MvPowerSeries (Fin 2) F,
      Ideal.Quotient.mk J f ∈ N ↔ MvPowerSeries.constantCoeff f = 0 := by
    intro f
    have h1 : N ^ 1 = N := pow_one N
    have h := memq f 1
    rw [h1] at h
    rw [h]
    constructor
    · intro H
      have h0 := (H 0 Nat.zero_lt_one).1
      rwa [Finsupp.single_zero, MvPowerSeries.coeff_zero_eq_constantCoeff_apply] at h0
    · intro H a ha
      have ha0 : a = 0 := by omega
      subst ha0
      rw [Finsupp.single_zero, Finsupp.single_zero,
        MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
      exact ⟨H, H⟩
  have hunit : ∀ x : MvPowerSeries (Fin 2) F ⧸ J, x ∉ N → IsUnit x := by
    intro x hx
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    have h0 : MvPowerSeries.constantCoeff f ≠ 0 := fun h => hx ((c1 f).2 h)
    have hf : IsUnit f := MvPowerSeries.isUnit_iff_constantCoeff.mpr h0.isUnit
    exact hf.map _
  have hmax : N.IsMaximal := by
    rw [Ideal.isMaximal_iff]
    refine ⟨?_, ?_⟩
    · intro h1
      rw [← map_one (Ideal.Quotient.mk J), c1, map_one] at h1
      exact one_ne_zero h1
    · intro J' x _ hx hxJ
      rw [Ideal.eq_top_of_isUnit_mem J' hxJ (hunit x hx)]
      exact Submodule.mem_top
  have hconst : ∀ f : MvPowerSeries (Fin 2) F, Ideal.Quotient.mk J f -
      Ideal.Quotient.mk J (MvPowerSeries.C (MvPowerSeries.constantCoeff f)) ∈ N := by
    intro f
    rw [← map_sub, c1, map_sub, MvPowerSeries.constantCoeff_C, sub_self]
  have hT : ∀ (n : ℕ) (y z : MvPowerSeries (Fin 2) F ⧸ J),
      y ≡ z [SMOD (N ^ n • ⊤ : Submodule (MvPowerSeries (Fin 2) F ⧸ J)
        (MvPowerSeries (Fin 2) F ⧸ J))] ↔ y - z ∈ N ^ n := by
    intro n y z
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
  have hH : IsHausdorff N (MvPowerSeries (Fin 2) F ⧸ J) := by
    refine ⟨fun y hy => ?_⟩
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [Ideal.Quotient.eq_zero_iff_mem, (MEM f).2]
    intro a
    have h := hy (a + 1)
    rw [hT, sub_zero, memq] at h
    exact h a (Nat.lt_succ_self a)
  have hP : IsPrecomplete N (MvPowerSeries (Fin 2) F ⧸ J) := by
    refine ⟨fun s hs => ?_⟩
    choose g hg using fun n => Ideal.Quotient.mk_surjective (s n)
    let L : MvPowerSeries (Fin 2) F := fun e => MvPowerSeries.coeff e (g (e 0 + e 1 + 1))
    have hL0 : ∀ a : ℕ, MvPowerSeries.coeff (Finsupp.single 0 a) L =
        MvPowerSeries.coeff (Finsupp.single 0 a) (g (a + 1)) := by
      intro a
      show MvPowerSeries.coeff (Finsupp.single 0 a)
        (g ((Finsupp.single 0 a : Fin 2 →₀ ℕ) 0 + (Finsupp.single 0 a : Fin 2 →₀ ℕ) 1 + 1)) = _
      rw [Finsupp.single_eq_same, Finsupp.single_eq_of_ne (by decide), add_zero]
    have hL1 : ∀ a : ℕ, MvPowerSeries.coeff (Finsupp.single 1 a) L =
        MvPowerSeries.coeff (Finsupp.single 1 a) (g (a + 1)) := by
      intro a
      show MvPowerSeries.coeff (Finsupp.single 1 a)
        (g ((Finsupp.single 1 a : Fin 2 →₀ ℕ) 0 + (Finsupp.single 1 a : Fin 2 →₀ ℕ) 1 + 1)) = _
      rw [Finsupp.single_eq_same, Finsupp.single_eq_of_ne (by decide), zero_add]
    refine ⟨Ideal.Quotient.mk J L, fun n => ?_⟩
    rw [hT, ← hg n, ← map_sub, memq]
    intro a ha
    have hc := hs (Nat.succ_le_of_lt ha)
    rw [hT, ← hg, ← hg, ← map_sub, memq] at hc
    obtain ⟨h0, h1⟩ := hc a (Nat.lt_succ_self a)
    rw [map_sub, sub_eq_zero] at h0 h1
    rw [map_sub, map_sub, hL0, hL1, sub_eq_zero, sub_eq_zero]
    exact ⟨h0.symm, h1.symm⟩
  exact ⟨hmax, hunit, hconst, { toIsHausdorff := hH, toIsPrecomplete := hP }⟩

theorem wcpa_dj_lr1s_sgf_completion_of_compatible : ∀ (B S : Type u) [CommRing B] [CommRing S] (J : Ideal B) (N : Ideal S) [IsAdicComplete N S] (Φ : ∀ n : ℕ, B ⧸ J ^ n ≃+* S ⧸ N ^ n), (∀ (m n : ℕ) (h : m ≤ n) (x : B ⧸ J ^ n), Ideal.Quotient.factorPow N h (Φ n x) = Φ m (Ideal.Quotient.factorPow J h x)) → ∃ E : AdicCompletion J B ≃+* S, (∀ (n : ℕ) (x : AdicCompletion J B), Ideal.Quotient.mk (N ^ n) (E x) = Φ n (AdicCompletion.evalₐ J n x)) ∧ ∀ (b : B) (s : S), (∀ n : ℕ, Ideal.Quotient.mk (N ^ n) s = Φ n (Ideal.Quotient.mk (J ^ n) b)) → E (algebraMap B (AdicCompletion J B) b) = s :=
by
  intro B S _ _ J N _ Φ hΦ
  have hH : ∀ s t : S, (∀ n : ℕ, Ideal.Quotient.mk (N ^ n) s = Ideal.Quotient.mk (N ^ n) t) → s = t := by
    intro s t h
    have := IsHausdorff.funext' N (R := Unit) (f := fun _ => s) (g := fun _ => t)
      (fun n _ => h n)
    exact congrFun this ()
  have s1 : ∀ {m n : ℕ} (h : m ≤ n) (x : AdicCompletion J B),
      Ideal.Quotient.factorPow J h (AdicCompletion.evalₐ J n x) = AdicCompletion.evalₐ J m x := by
    intro m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective J B x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    have := AdicCompletion.AdicCauchySequence.mk_eq_mk h c
    rw [Submodule.Quotient.eq] at this
    simpa [Ideal.smul_eq_mul, Ideal.mul_top] using this
  let f : ∀ n, AdicCompletion J B →+* S ⧸ N ^ n := fun n =>
    (Φ n : B ⧸ J ^ n →+* S ⧸ N ^ n).comp
      (AdicCompletion.evalₐ J n : AdicCompletion J B →+* B ⧸ J ^ n)
  have hfx : ∀ n x, f n x = Φ n (AdicCompletion.evalₐ J n x) := fun _ _ => rfl
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow N hle).comp (f n) = f m := by
    intro m n hle
    ext x
    rw [RingHom.comp_apply, hfx, hfx, hΦ, s1]
  let g : ∀ n, S →+* B ⧸ J ^ n := fun n =>
    ((Φ n).symm : S ⧸ N ^ n →+* B ⧸ J ^ n).comp (Ideal.Quotient.mk (N ^ n))
  have hgx : ∀ n s, g n s = (Φ n).symm (Ideal.Quotient.mk (N ^ n) s) := fun _ _ => rfl
  have hg : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp (g n) = g m := by
    intro m n hle
    ext s
    rw [RingHom.comp_apply, hgx, hgx]
    apply (Φ m).injective
    rw [← hΦ, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk]
  let Ef : AdicCompletion J B →+* S := IsAdicComplete.liftRingHom N f hf
  let Eb : S →+* AdicCompletion J B := AdicCompletion.liftRingHom J g hg
  have eF : ∀ n x, Ideal.Quotient.mk (N ^ n) (Ef x) = Φ n (AdicCompletion.evalₐ J n x) :=
    fun n x => IsAdicComplete.mk_liftRingHom N f hf n x
  have eB : ∀ n s, AdicCompletion.evalₐ J n (Eb s) = (Φ n).symm (Ideal.Quotient.mk (N ^ n) s) :=
    fun n s => RingHom.congr_fun (AdicCompletion.evalₐ_comp_liftRingHom J g hg n) s
  have h6 : Ef.comp Eb = RingHom.id S := by
    ext s
    apply hH
    intro n
    rw [RingHom.comp_apply, eF, eB, RingEquiv.apply_symm_apply, RingHom.id_apply]
  have h7 : Eb.comp Ef = RingHom.id (AdicCompletion J B) := by
    refine RingHom.ext fun x => ?_
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [RingHom.comp_apply, eB, eF, RingEquiv.symm_apply_apply, RingHom.id_apply]
  refine ⟨RingEquiv.ofRingHom Ef Eb h6 h7, fun n x => eF n x, ?_⟩
  intro b s hs
  apply hH
  intro n
  show Ideal.Quotient.mk (N ^ n) (Ef (algebraMap B (AdicCompletion J B) b)) = _
  rw [eF, hs, AlgHom.commutes, Ideal.Quotient.algebraMap_eq]

theorem wcpa_dj_lr1s_sgf_quot_pow_localization : ∀ (R : Type u) [CommRing R] (P : Ideal R) [P.IsMaximal] (n : ℕ), ∃ ψ : R ⧸ P ^ n ≃+* Localization.AtPrime P ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime P) ^ n, ∀ r : R, ψ (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ (algebraMap R (Localization.AtPrime P) r) :=
by
  intro R _ P hP n
  have s1 : IsLocalRing.maximalIdeal (Localization.AtPrime P) ^ n
      = Ideal.map (algebraMap R (Localization.AtPrime P)) (P ^ n) := by
    rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
  have s2 : ∀ s : R, s ∉ P → ∃ a : R, ∃ b ∈ P ^ n, a * s + b = 1 := by
    intro s hs
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv hP hs
    have h1 : Ideal.span {s} ⊔ P = ⊤ := by
      rw [Ideal.eq_top_iff_one, Ideal.mem_span_singleton_sup]
      exact ⟨y, i, hi, hyi⟩
    have h2 : Ideal.span {s} ⊔ P ^ n = ⊤ := Ideal.sup_pow_eq_top h1
    have h3 : (1 : R) ∈ Ideal.span {s} ⊔ P ^ n := by rw [h2]; exact Submodule.mem_top
    exact Ideal.mem_span_singleton_sup.mp h3
  have H : P ^ n ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime P) ^ n).comap
      (algebraMap R (Localization.AtPrime P)) := by
    rw [s1]; exact Ideal.le_comap_map
  have hinj : Function.Injective
      (Ideal.quotientMap _ (algebraMap R (Localization.AtPrime P)) H) := by
    apply Ideal.quotientMap_injective'
    intro r hr
    rw [Ideal.mem_comap, s1] at hr
    obtain ⟨⟨x, s⟩, hxs⟩ :=
      (IsLocalization.mem_map_algebraMap_iff P.primeCompl (Localization.AtPrime P)).mp hr
    simp only at hxs
    rw [← map_mul] at hxs
    obtain ⟨c, hc⟩ :=
      (IsLocalization.eq_iff_exists P.primeCompl (Localization.AtPrime P)).mp hxs
    have ht : (c : R) * s ∉ P := P.primeCompl.mul_mem c.2 s.2
    obtain ⟨a, b, hb, hab⟩ := s2 _ ht
    have htr : (c : R) * s * r ∈ P ^ n := by
      have e : (c : R) * s * r = c * (r * s) := by ring
      rw [e, hc]; exact Ideal.mul_mem_left _ _ x.2
    have e : r = a * ((c : R) * s * r) + r * b := by linear_combination (-r) * hab
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ htr) (Ideal.mul_mem_left _ _ hb)
  have hsurj : Function.Surjective
      (Ideal.quotientMap _ (algebraMap R (Localization.AtPrime P)) H) := by
    intro z
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl y
    obtain ⟨u, b, hb, hub⟩ := s2 s s.2
    refine ⟨Ideal.Quotient.mk _ (a * u), ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    have hspec := IsLocalization.mk'_spec (Localization.AtPrime P) a s
    have hfb : algebraMap R (Localization.AtPrime P) b ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime P) ^ n := by
      rw [s1]; exact Ideal.mem_map_of_mem _ hb
    have e := congrArg (algebraMap R (Localization.AtPrime P)) hub
    rw [map_add, map_mul, map_one] at e
    have key : algebraMap R (Localization.AtPrime P) (a * u)
        - IsLocalization.mk' (Localization.AtPrime P) a s
        = -(IsLocalization.mk' (Localization.AtPrime P) a s
            * algebraMap R (Localization.AtPrime P) b) := by
      rw [map_mul]
      linear_combination (-(algebraMap R (Localization.AtPrime P) u)) * hspec
        + (IsLocalization.mk' (Localization.AtPrime P) a s) * e
    rw [key]
    exact neg_mem (Ideal.mul_mem_left _ _ hfb)
  let ψ₀ : R ⧸ P ^ n →+* Localization.AtPrime P ⧸
      IsLocalRing.maximalIdeal (Localization.AtPrime P) ^ n :=
    Ideal.quotientMap _ (algebraMap R (Localization.AtPrime P)) H
  have hbij : Function.Bijective ψ₀ := ⟨hinj, hsurj⟩
  refine ⟨RingEquiv.ofBijective ψ₀ hbij, fun r => ?_⟩
  show ψ₀ (Ideal.Quotient.mk (P ^ n) r) = _
  simp only [ψ₀, Ideal.quotientMap_mk]

theorem wcpa_dj_ncmb_field_model_ns : ∀ (K : Type u) [Field K] (e : K) (x : ↥(Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e})))), (∃ W : (Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))).Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))))) ∨ (∃ e' : AdicCompletion (IsLocalRing.maximalIdeal ((Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))).presheaf.stalk x)) ((Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))).presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e'.toRingHom.comp ((algebraMap ((Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))).presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal ((Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))).presheaf.stalk x)) ((Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))).presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e})))).appTop ≫ (Spec (.of (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C e}))).presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) :=
by
  intro K _ e x
  classical

  have s5 : ∀ (n : ℕ) (f : MvPolynomial (Fin 2) K), (∀ a < n, f.coeff (Finsupp.single 0 a) = 0 ∧ f.coeff (Finsupp.single 1 a) = 0) → f ∈ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) K)) ^ n ⊔ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) K)) := by
    intro n f hf
    have hspan : Ideal.span ((fun s => MvPolynomial.monomial s (1 : K)) '' {Finsupp.single 0 n, Finsupp.single 1 n, Finsupp.single 0 1 + Finsupp.single 1 1}) ≤ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) K)) ^ n ⊔ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) K)) := by
      rw [Ideal.span_le]
      rintro y ⟨s, hs, rfl⟩
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hs
      rcases hs with rfl | rfl | rfl
      · apply Ideal.mem_sup_left
        show MvPolynomial.monomial (Finsupp.single 0 n) (1 : K) ∈ _
        rw [← MvPolynomial.X_pow_eq_monomial]
        exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) n
      · apply Ideal.mem_sup_left
        show MvPolynomial.monomial (Finsupp.single 1 n) (1 : K) ∈ _
        rw [← MvPolynomial.X_pow_eq_monomial]
        exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) n
      · apply Ideal.mem_sup_right
        apply Ideal.subset_span
        show MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) (1 : K) ∈ _
        rw [Set.mem_singleton_iff, MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, mul_one]
    apply hspan
    rw [MvPolynomial.mem_ideal_span_monomial_image]
    intro m hm
    rw [MvPolynomial.mem_support_iff] at hm
    by_cases ha : 1 ≤ m 0 ∧ 1 ≤ m 1
    · obtain ⟨ha0, ha1⟩ := ha
      refine ⟨Finsupp.single 0 1 + Finsupp.single 1 1, by simp, ?_⟩
      rw [Finsupp.le_def]
      intro i
      fin_cases i <;> simp <;> omega
    · rw [not_and_or, not_le, not_le] at ha
      rcases ha with h | h
      · have hm0 : m = Finsupp.single 1 (m 1) := by
          ext i
          fin_cases i <;> simp <;> omega
        have hn : n ≤ m 1 := by
          by_contra hlt
          rw [not_le] at hlt
          exact hm (by rw [hm0]; exact (hf _ hlt).2)
        refine ⟨Finsupp.single 1 n, by simp, ?_⟩
        rw [hm0, Finsupp.single_le_iff, Finsupp.single_eq_same]
        exact hn
      · have hm0 : m = Finsupp.single 0 (m 0) := by
          ext i
          fin_cases i <;> simp <;> omega
        have hn : n ≤ m 0 := by
          by_contra hlt
          rw [not_le] at hlt
          exact hm (by rw [hm0]; exact (hf _ hlt).1)
        refine ⟨Finsupp.single 0 n, by simp, ?_⟩
        rw [hm0, Finsupp.single_le_iff, Finsupp.single_eq_same]
        exact hn

  have hkerS : ∀ (n : ℕ) (F : MvPowerSeries (Fin 2) K), Ideal.Quotient.mk ((Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n) (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)) F) = 0 ↔ ∀ a < n, MvPowerSeries.coeff (Finsupp.single 0 a) F = 0 ∧ MvPowerSeries.coeff (Finsupp.single 1 a) F = 0 := by
    intro n F
    have hc := Ideal.comap_map_of_surjective' (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) Ideal.Quotient.mk_surjective ((Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)) ^ n)
    rw [Ideal.mk_ker] at hc
    rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.map_pow, ← Ideal.mem_comap, hc]
    exact (wcpa_dj_lr1s_sgf_nodal_membership K F).1 n

  have s6 : ∀ (P : Ideal (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)})), P = Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)}) (MvPolynomial.X 0), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)}) (MvPolynomial.X 1)} → ∀ n : ℕ, ∃ T : (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)}) ⧸ P ^ n ≃+* (MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n, ∀ p : MvPolynomial (Fin 2) K, T (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ p)) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.coeToMvPowerSeries.ringHom p)) := by
    intro P hP n
    subst hP
    let g : MvPolynomial (Fin 2) K →+* (MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n :=
      (Ideal.Quotient.mk _).comp ((Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))).comp MvPolynomial.coeToMvPowerSeries.ringHom)
    have hgker : ∀ f : MvPolynomial (Fin 2) K, g f = 0 ↔ ∀ a < n, f.coeff (Finsupp.single 0 a) = 0 ∧ f.coeff (Finsupp.single 1 a) = 0 := by
      intro f
      show Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.coeToMvPowerSeries.ringHom f)) = 0 ↔ _
      rw [hkerS n, MvPolynomial.coeToMvPowerSeries.ringHom_apply]
      simp only [MvPolynomial.coeff_coe]
    have hι : MvPolynomial.coeToMvPowerSeries.ringHom (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C 0 : MvPolynomial (Fin 2) K) = MvPowerSeries.X 0 * MvPowerSeries.X 1 := by
      simp [MvPolynomial.coeToMvPowerSeries.ringHom_apply]
    have hq : Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)) (MvPowerSeries.X 0 * MvPowerSeries.X 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hg0 : ∀ f ∈ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)} : Ideal (MvPolynomial (Fin 2) K)), g f = 0 := by
      intro f hf
      rw [Ideal.mem_span_singleton] at hf
      obtain ⟨b, rfl⟩ := hf
      have hgen : g (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)) = 0 := by
        show Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.coeToMvPowerSeries.ringHom (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)))) = 0
        rw [hι, hq, map_zero]
      rw [map_mul, hgen, zero_mul]
    have hpow : (Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)}) (MvPolynomial.X 0), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)}) (MvPolynomial.X 1)} : Ideal (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)})) ^ n = Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)} : Ideal (MvPolynomial (Fin 2) K))) ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) K)) ^ n) := by
      rw [Ideal.map_pow, Ideal.map_span, Set.image_pair]
    have hmι : Ideal.map MvPolynomial.coeToMvPowerSeries.ringHom (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) K)) ≤ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)) := by
      rw [Ideal.map_span, Ideal.span_le]
      rintro y ⟨z, hz, rfl⟩
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · apply Ideal.subset_span; simp [MvPolynomial.coeToMvPowerSeries.ringHom_apply]
      · apply Ideal.subset_span; simp [MvPolynomial.coeToMvPowerSeries.ringHom_apply]
    have hg'0 : ∀ a ∈ (Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)}) (MvPolynomial.X 0), Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)}) (MvPolynomial.X 1)} : Ideal (MvPolynomial (Fin 2) K ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)})) ^ n, Ideal.Quotient.lift _ g hg0 a = 0 := by
      intro a ha
      rw [hpow, Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at ha
      obtain ⟨f, hf, rfl⟩ := ha
      rw [Ideal.Quotient.lift_mk]
      have h1 : MvPolynomial.coeToMvPowerSeries.ringHom f ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)) ^ n := by
        have := Ideal.mem_map_of_mem MvPolynomial.coeToMvPowerSeries.ringHom hf
        rw [Ideal.map_pow] at this
        exact Ideal.pow_right_mono hmι n this
      show Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.coeToMvPowerSeries.ringHom f)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ h1
    let T0 := Ideal.Quotient.lift _ (Ideal.Quotient.lift _ g hg0) hg'0
    have hT0 : ∀ p : MvPolynomial (Fin 2) K, T0 (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ p)) = g p := fun p => rfl
    have hinj : Function.Injective T0 := by
      intro a b hab
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective a
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective b
      obtain ⟨f', rfl⟩ := Ideal.Quotient.mk_surjective y'
      rw [hT0, hT0] at hab
      have hd : g (f - f') = 0 := by rw [map_sub, hab, sub_self]
      have hf := s5 n (f - f') ((hgker _).mp hd)
      obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp hf
      rw [Ideal.Quotient.eq, ← map_sub, ← huv, map_add]
      apply Ideal.add_mem
      · rw [hpow]; exact Ideal.mem_map_of_mem _ hu
      · have hv0 : Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (0 : K)} : Ideal (MvPolynomial (Fin 2) K)) v = 0 := by
          rw [Ideal.Quotient.eq_zero_iff_mem]
          simpa using hv
        rw [hv0]
        exact Ideal.zero_mem _
    have hsurj : Function.Surjective T0 := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.trunc' K (Finsupp.single 0 n + Finsupp.single 1 n) F)), ?_⟩
      rw [hT0]
      show Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.coeToMvPowerSeries.ringHom _)) = _
      rw [← sub_eq_zero, ← map_sub, ← map_sub, hkerS n]
      intro a ha
      simp [MvPolynomial.coeToMvPowerSeries.ringHom_apply, MvPowerSeries.coeff_trunc', ha.le]
    exact ⟨RingEquiv.ofBijective T0 ⟨hinj, hsurj⟩, fun p => rfl⟩

  have s7 : ∀ (R : CommRingCat.{u}) (x : PrimeSpectrum R), ∃ β : (Spec R).presheaf.stalk x ≃+* Localization.AtPrime x.asIdeal, ∀ r : R, β (((Spec R).presheaf.germ ⊤ x trivial).hom ((Scheme.ΓSpecIso R).inv.hom r)) = algebraMap R _ r := by
    intro R x
    refine ⟨(Spec.stalkIso R x).commRingCatIsoToRingEquiv, fun r => ?_⟩
    have h := congrArg (fun φ => CommRingCat.Hom.hom φ r) (Spec.algebraMap_stalkIso_inv (R := R) x)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
    rw [← h]
    show (Spec.stalkIso R x).hom.hom ((Spec.stalkIso R x).inv.hom _) = _
    rw [← CommRingCat.comp_apply, Iso.inv_hom_id]
    rfl

  have s8 : ∀ (R B : Type u) [CommRing R] [CommRing B] [IsLocalRing B] (jR : K →+* R) (P : Ideal R) [P.IsMaximal]
      (β : B ≃+* Localization.AtPrime P)
      (T : ∀ n : ℕ, R ⧸ P ^ n ≃+* (MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n),
      (∀ (m n : ℕ) (h : m ≤ n) (r : R), Ideal.Quotient.factorPow _ h (T n (Ideal.Quotient.mk _ r)) = T m (Ideal.Quotient.mk _ r)) →
      (∀ (n : ℕ) (c : K), T n (Ideal.Quotient.mk _ (jR c)) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.C c))) →
      ∃ e' : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+* (MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))),
        e'.toRingHom.comp ((algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp (β.symm.toRingHom.comp ((algebraMap R (Localization.AtPrime P)).comp jR))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro R B _ _ _ jR P _ β T hT hC
    haveI : IsAdicComplete (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) :=
      (wcpa_dj_lr1s_sgf_nodal_ring_structure K (wcpa_dj_lr1s_sgf_nodal_membership K)).2.2.2
    have hmapJ : Ideal.map (β : B →+* Localization.AtPrime P) (IsLocalRing.maximalIdeal B) = IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
