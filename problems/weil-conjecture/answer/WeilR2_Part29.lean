    rw [h2] at h3
    have hl : z ^ (ℓ * j) * (σ ^ ℓ) x = z ^ (0 * j) * (σ ^ 0) x := by
      rw [pow_mul, hzl, hσl, one_pow, zero_mul, pow_zero, pow_zero]
    linear_combination h3 + hl

  have horth : ∑ j ∈ Finset.range ℓ, α j = (ℓ : N) * x := by
    simp only [hα]
    rw [Finset.sum_comm, hm, Finset.sum_range_succ']
    have hzl' : z ^ (m + 1) = 1 := hm ▸ hzl
    have hzero : ∀ i ∈ Finset.range m,
        ∑ j ∈ Finset.range (m + 1), z ^ ((i + 1) * j) * (σ ^ (i + 1)) x = 0 := by
      intro i hi
      rw [← Finset.sum_mul]
      have hgeo : ∑ j ∈ Finset.range (m + 1), z ^ ((i + 1) * j) = 0 := by
        have hw : z ^ (i + 1) ≠ 1 :=
          hzne (i + 1) (by omega) (by rw [Finset.mem_range] at hi; omega)
        have := geom_sum_mul (z ^ (i + 1)) (m + 1)
        simp only [← pow_mul] at this
        rw [mul_comm (i + 1) (m + 1), pow_mul, hzl', one_pow, sub_self] at this
        exact (mul_eq_zero.mp this).resolve_right (sub_ne_zero.mpr hw)
      rw [hgeo, zero_mul]
    rw [Finset.sum_eq_zero hzero, zero_add]
    simp

  obtain ⟨j, hj0, hjl, hαj⟩ : ∃ j, 0 < j ∧ j < ℓ ∧ α j ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    have h0 : α 0 = (ℓ : N) * x := by
      rw [← horth, Finset.sum_eq_single_of_mem 0 (Finset.mem_range.mpr hℓpos)]
      intro b hb hb0
      exact hcon b (Nat.pos_of_ne_zero hb0) (Finset.mem_range.mp hb)
    have h1 := heig 0
    rw [pow_zero, one_mul, h0, map_mul, map_natCast] at h1
    exact hxm (mul_left_cancel₀ hℓN h1)

  have hαi : IsIntegral V (α j) := by
    rw [hα]
    refine IsIntegral.sum _ (fun i _ => ?_)
    have hz : IsIntegral V z := by rw [hzdef]; exact isIntegral_algebraMap
    exact (hz.pow _).mul (hint _ x hxi)

  obtain ⟨c, u, v, hαcu, huv, hui, hvi⟩ := h5 (α j) hαj hαi
  have hc0 : algebraMap V N c ≠ 0 := by
    intro h
    apply hαj
    rw [hαcu, h, zero_mul]
  have hσu : z ^ j * σ u = u := by
    have h1 := heig j
    rw [hαcu, map_mul, hfix c] at h1
    apply mul_left_cancel₀ hc0
    rw [← h1]
    ring
  have hk0 : 0 < ℓ - j := by omega
  have hkl : ℓ - j < ℓ := by omega
  have hσu' : σ u = z ^ (ℓ - j) * u := by
    calc σ u = z ^ (ℓ - j) * (z ^ j * σ u) := by
          rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hjl.le, hzl, one_mul]
      _ = z ^ (ℓ - j) * u := by rw [hσu]

  obtain ⟨e, he⟩ := (hζu (ℓ - j) hk0 hkl).exists_right_inv
  have hinv : (σ u - u) * (algebraMap V N (-e) * v) = 1 := by
    rw [hσu']
    have hcalc : (z ^ (ℓ - j) * u - u) * (algebraMap V N (-e) * v)
        = algebraMap V N ((1 - ζ ^ (ℓ - j)) * e) * (u * v) := by
      rw [hzdef, map_mul, map_sub, map_one, map_pow, map_neg]
      ring
    rw [hcalc, he, huv, map_one, one_mul]
  have hne : σ u - u ≠ 0 := left_ne_zero_of_mul_eq_one hinv
  have hinveq : (σ u - u)⁻¹ = algebraMap V N (-e) * v := inv_eq_of_mul_eq_one_right hinv
  rcases (hσ u hui).2 with h | h
  · exact hne h
  · apply h
    rw [hinveq]
    exact isIntegral_algebraMap.mul hvi

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_residue_roots_of_unity : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (ℓ : ℕ), ℓ.Prime → ℓ ≠ ringChar (IsLocalRing.ResidueField ↥W) → IsUnit (ℓ : ↥W) ∧ ∃ ζ : ↥W, ζ ^ ℓ = 1 ∧ ∀ i : ℕ, 0 < i → i < ℓ → IsUnit (1 - ζ ^ i) :=
by
  intro Ω _ _ W ℓ hℓ hne
  classical
  have s1 : (ℓ : IsLocalRing.ResidueField ↥W) ≠ 0 := by
    intro h
    have hd : ringChar (IsLocalRing.ResidueField ↥W) ∣ ℓ := ringChar.dvd h
    rcases hℓ.eq_one_or_self_of_dvd _ hd with h1 | h1
    · exact CharP.ringChar_ne_one h1
    · exact hne h1.symm
  have hu : IsUnit (ℓ : ↥W) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_natCast]
    exact s1
  refine ⟨hu, ?_⟩
  have hΩ : (ℓ : Ω) ≠ 0 := by
    have := hu.map W.subtype
    rw [map_natCast] at this
    exact this.ne_zero
  haveI : NeZero (ℓ : Ω) := ⟨hΩ⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Ω ℓ
  have hmem : ζ₀ ∈ W := by
    rcases W.mem_or_inv_mem ζ₀ with h | h
    · exact h
    · have hz : ζ₀ = (ζ₀⁻¹) ^ (ℓ - 1) := by
        rw [inv_pow]
        have : ζ₀ ^ (ℓ - 1) * ζ₀ = 1 := by
          rw [← pow_succ, Nat.sub_add_cancel hℓ.one_lt.le, hζ₀.pow_eq_one]
        exact eq_inv_of_mul_eq_one_right this
      rw [hz]
      exact W.pow_mem h _
  set ζ : ↥W := ⟨ζ₀, hmem⟩ with hζdef
  have hζ : IsPrimitiveRoot ζ ℓ := by
    have hinj : Function.Injective W.subtype := Subtype.val_injective
    exact IsPrimitiveRoot.of_map_of_injective (f := W.subtype) hζ₀ hinj
  refine ⟨ζ, hζ.pow_eq_one, ?_⟩
  intro i hi0 hil
  obtain ⟨n, rfl⟩ : ∃ n, ℓ = n + 1 := ⟨ℓ - 1, by omega⟩
  have hprod := hζ.prod_one_sub_pow_eq_order
  have hunit : IsUnit (∏ k ∈ Finset.range n, (1 - ζ ^ (k + 1))) := by
    rw [hprod]
    have : ((n + 1 : ℕ) : ↥W) = (n : ↥W) + 1 := by push_cast; ring
    rw [← this]
    exact hu
  have hdvd : (1 - ζ ^ (i - 1 + 1)) ∣ ∏ k ∈ Finset.range n, (1 - ζ ^ (k + 1)) :=
    Finset.dvd_prod_of_mem (fun k => 1 - ζ ^ (k + 1)) (Finset.mem_range.mpr (by omega))
  rw [Nat.sub_add_cancel hi0] at hdvd
  exact isUnit_of_dvd_unit hdvd hunit

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_tr_st_galois_step : ∀ (K N : Type u) [Field K] [Field N] [Algebra K N] [FiniteDimensional K N] [Normal K N] (I : Subgroup (N ≃ₐ[K] N)) (p : ℕ), p.Prime → (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ Nat.card I → ℓ = p) → ∀ L : IntermediateField K N, L ≤ separableClosure K N → IntermediateField.fixedField I ⊓ separableClosure K N ≤ L → IntermediateField.fixedField I ⊓ separableClosure K N ≠ L → ∃ F : IntermediateField K N, IntermediateField.fixedField I ⊓ separableClosure K N ≤ F ∧ F ≤ L ∧ Module.finrank K F * p = Module.finrank K L ∧ ∀ z ∈ L, ∃ (e : ℕ) (s : Finset (N ≃ₐ[K] N)), (∀ g ∈ s, g ∈ I) ∧ s.card = p ^ e ∧ (∏ g ∈ s, g z) ∈ F :=
by
  classical
  intro K N _ _ _ _ _ I p hp huniq L hLS hML hMne

  have s_grp : ∀ (G : Type u) [Group G] [Finite G] (A B : Subgroup G),
      (∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ Nat.card A → ℓ = p) → B ≤ A → B ≠ A →
      ∃ H : Subgroup G, B ≤ H ∧ H ≤ A ∧ Nat.card H = p * Nat.card B := by
    intro G _ _ A B hA hBA hne
    haveI : Fact p.Prime := ⟨hp⟩
    have hA0 : Nat.card A ≠ 0 := Nat.card_pos.ne'
    have hApow : Nat.card A = p ^ (Nat.card A).primeFactorsList.length :=
      Nat.eq_prime_pow_of_unique_prime_dvd hA0 (fun hd hdA => hA _ hd hdA)
    generalize (Nat.card A).primeFactorsList.length = a at hApow
    have hBdvd : Nat.card B ∣ p ^ a := by rw [← hApow]; exact Subgroup.card_dvd_of_le hBA
    obtain ⟨c, hca, hBc⟩ := (Nat.dvd_prime_pow hp).mp hBdvd
    have hlt : Nat.card B < Nat.card A := Subgroup.card_lt_of_lt (lt_of_le_of_ne hBA hne)
    have hca' : c < a := by
      rw [hBc, hApow] at hlt
      exact (Nat.pow_lt_pow_iff_right hp.one_lt).mp hlt
    have hdvd : p ^ (c + 1) ∣ Nat.card A := by
      rw [hApow]; exact pow_dvd_pow p hca'
    have hB' : Nat.card (B.subgroupOf A) = p ^ c := by
      rw [← hBc]; exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hBA).toEquiv
    obtain ⟨H', hH'card, hBH'⟩ := Sylow.exists_subgroup_card_pow_succ hdvd hB'
    refine ⟨H'.map A.subtype, ?_, Subgroup.map_subtype_le H', ?_⟩
    · intro b hb
      exact Subgroup.mem_map.mpr ⟨⟨b, hBA hb⟩, hBH' (Subgroup.mem_subgroupOf.mpr hb), rfl⟩
    · rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective A), hH'card, hBc, pow_succ']

  have s_deg : ∀ (S : Type u) [Field S] [Algebra K S] [FiniteDimensional K S]
      (H : Subgroup (S ≃ₐ[K] S)),
      Module.finrank K (IntermediateField.fixedField H) * Nat.card H = Module.finrank K S := by
    intro S _ _ _ H
    rw [← IntermediateField.finrank_fixedField_eq_card H, Module.finrank_mul_finrank]

  have s_norm : ∀ (S : Type u) [Field S] [Algebra K S] (H : Subgroup (S ≃ₐ[K] S))
      (T : Finset (S ≃ₐ[K] S)), (∀ g, g ∈ T ↔ g ∈ H) → ∀ x : S,
      (∏ g ∈ T, g x) ∈ IntermediateField.fixedField H := by
    intro S _ _ H T hT x
    rw [IntermediateField.mem_fixedField_iff]
    intro h hh
    rw [map_prod]
    apply Finset.prod_nbij' (fun g => h * g) (fun g => h⁻¹ * g)
    · intro g hg; exact (hT _).mpr (H.mul_mem hh ((hT g).mp hg))
    · intro g hg; exact (hT _).mpr (H.mul_mem (H.inv_mem hh) ((hT g).mp hg))
    · intro g _; simp
    · intro g _; simp
    · intro g _; rfl

  haveI hSgal : IsGalois K (separableClosure K N) := inferInstance
  haveI hSfd : FiniteDimensional K (separableClosure K N) := inferInstance
  haveI hSnorm : Normal K (separableClosure K N) := inferInstance
  set S := separableClosure K N with hSdef
  set ρ : (N ≃ₐ[K] N) →* (S ≃ₐ[K] S) := AlgEquiv.restrictNormalHom S with hρ
  have hρapp : ∀ (σ : N ≃ₐ[K] N) (x : S), ((ρ σ x : S) : N) = σ x :=
    fun σ x => AlgEquiv.restrictNormalHom_apply S σ x

  have s_fix : ∀ x : S, ((x : N) ∈ IntermediateField.fixedField I ↔
      x ∈ IntermediateField.fixedField (I.map ρ)) := by
    intro x
    rw [IntermediateField.mem_fixedField_iff, IntermediateField.mem_fixedField_iff]
    constructor
    · intro h τ hτ
      obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hτ
      apply Subtype.ext
      rw [hρapp]; exact h g hg
    · intro h g hg
      have h1 := congrArg Subtype.val (h (ρ g) (Subgroup.mem_map_of_mem ρ hg))
      rw [hρapp] at h1
      exact h1

  set IS := I.map ρ with hIS
  set LS := IntermediateField.restrict hLS with hLSdef
  set J := LS.fixingSubgroup with hJ
  have memLS : ∀ y : S, y ∈ LS ↔ (y : N) ∈ L := fun y => IntermediateField.mem_restrict hLS y
  have huniqS : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ Nat.card IS → ℓ = p :=
    fun ℓ hℓ hd => huniq ℓ hℓ (hd.trans (Subgroup.card_map_dvd I ρ))
  have hMLS : IntermediateField.fixedField IS ≤ LS := by
    intro y hy
    rw [memLS]
    apply hML
    exact IntermediateField.mem_inf.mpr ⟨(s_fix y).mpr hy, y.2⟩
  have hLfix : IntermediateField.fixedField J = LS := IsGalois.fixedField_fixingSubgroup LS
  have hJI : J ≤ IS := by
    have := IntermediateField.fixingSubgroup_le hMLS
    rwa [IntermediateField.fixingSubgroup_fixedField] at this
  have hJne : J ≠ IS := by
    intro hJeq
    apply hMne
    apply le_antisymm hML
    intro z hz
    have hz' : (⟨z, hLS hz⟩ : S) ∈ LS := (memLS _).mpr hz
    rw [← hLfix, hJeq] at hz'
    exact IntermediateField.mem_inf.mpr ⟨(s_fix _).mpr hz', hLS hz⟩

  obtain ⟨H, hJH, hHI, hHcard⟩ := s_grp (S ≃ₐ[K] S) IS J huniqS hJI hJne
  refine ⟨IntermediateField.lift (IntermediateField.fixedField H), ?_, ?_, ?_, ?_⟩

  · intro x hx
    obtain ⟨hxI, hxS⟩ := IntermediateField.mem_inf.mp hx
    have h1 : (⟨x, hxS⟩ : S) ∈ IntermediateField.fixedField IS := (s_fix ⟨x, hxS⟩).mp hxI
    exact (IntermediateField.mem_lift (⟨x, hxS⟩ : S)).mpr (IntermediateField.fixedField_le hHI h1)
  · intro x hx
    have hxS : x ∈ S := IntermediateField.lift_le _ hx
    have h1 : (⟨x, hxS⟩ : S) ∈ IntermediateField.fixedField H :=
      (IntermediateField.mem_lift (⟨x, hxS⟩ : S)).mp hx
    have h2 : (⟨x, hxS⟩ : S) ∈ LS := by
      rw [← hLfix]; exact IntermediateField.fixedField_le hJH h1
    exact (memLS _).mp h2

  · have e1 := s_deg S H
    have e2 := s_deg S J
    rw [hLfix] at e2
    rw [hHcard] at e1
    have hJpos : 0 < Nat.card J := Nat.card_pos
    have e3 : Module.finrank K (IntermediateField.fixedField H) * p = Module.finrank K LS := by
      have e4 : Module.finrank K (IntermediateField.fixedField H) * p * Nat.card J =
          Module.finrank K LS * Nat.card J := by
        rw [e2, ← e1, mul_assoc]
      exact Nat.eq_of_mul_eq_mul_right hJpos e4
    have f1 : Module.finrank K (IntermediateField.lift (IntermediateField.fixedField H)) =
        Module.finrank K (IntermediateField.fixedField H) :=
      (IntermediateField.liftAlgEquiv (IntermediateField.fixedField H)).toLinearEquiv.finrank_eq.symm
    have hlift : IntermediateField.lift LS = L := IntermediateField.lift_restrict hLS
    have f2 : Module.finrank K L = Module.finrank K LS := by
      calc Module.finrank K L = Module.finrank K (IntermediateField.lift LS) := by rw [hlift]
        _ = Module.finrank K LS := (IntermediateField.liftAlgEquiv LS).toLinearEquiv.finrank_eq.symm
    rw [f1, f2, e3]

  · intro z hz
    have hHdvd : Nat.card H ∣ Nat.card IS := Subgroup.card_dvd_of_le hHI
    have hH0 : Nat.card H ≠ 0 := Nat.card_pos.ne'
    have hHpow : Nat.card H = p ^ (Nat.card H).primeFactorsList.length :=
      Nat.eq_prime_pow_of_unique_prime_dvd hH0 (fun hd hdH => huniqS _ hd (hdH.trans hHdvd))
    let T : Finset (S ≃ₐ[K] S) := (Set.toFinite (H : Set (S ≃ₐ[K] S))).toFinset
    have memT : ∀ g, g ∈ T ↔ g ∈ H := fun g => Set.Finite.mem_toFinset _
    have hTcard : T.card = Nat.card H := (Nat.card_eq_card_finite_toFinset _).symm
    let lf : (S ≃ₐ[K] S) → (N ≃ₐ[K] N) := fun τ =>
      if h : τ ∈ IS then Classical.choose (Subgroup.mem_map.mp h) else 1
    have hlf : ∀ τ ∈ IS, lf τ ∈ I ∧ ρ (lf τ) = τ := by
      intro τ hτ
      have hs := Classical.choose_spec (Subgroup.mem_map.mp hτ)
      have e : lf τ = Classical.choose (Subgroup.mem_map.mp hτ) := dif_pos hτ
      rw [e]
      exact hs
    have hinj : Set.InjOn lf T := by
      intro τ₁ h₁ τ₂ h₂ heq
      have a1 := (hlf τ₁ (hHI ((memT τ₁).mp h₁))).2
      have a2 := (hlf τ₂ (hHI ((memT τ₂).mp h₂))).2
      calc τ₁ = ρ (lf τ₁) := a1.symm
        _ = ρ (lf τ₂) := by rw [heq]
        _ = τ₂ := a2
    refine ⟨(Nat.card H).primeFactorsList.length, T.image lf, ?_, ?_, ?_⟩
    · intro g hg
      obtain ⟨τ, hτ, rfl⟩ := Finset.mem_image.mp hg
      exact (hlf τ (hHI ((memT τ).mp hτ))).1
    · rw [Finset.card_image_of_injOn hinj, hTcard, ← hHpow]
    · rw [Finset.prod_image hinj]
      have hzS : z ∈ S := hLS hz
      have e : ∀ τ ∈ T, (lf τ) z = ((τ ⟨z, hzS⟩ : S) : N) := by
        intro τ hτ
        have h2 := hρapp (lf τ) ⟨z, hzS⟩
        rw [(hlf τ (hHI ((memT τ).mp hτ))).2] at h2
        exact h2.symm
      rw [Finset.prod_congr rfl e]
      have hprod : (∏ τ ∈ T, τ ⟨z, hzS⟩) ∈ IntermediateField.fixedField H :=
        s_norm S H T memT ⟨z, hzS⟩
      have hc : ((∏ τ ∈ T, τ ⟨z, hzS⟩ : S) : N) = ∏ τ ∈ T, ((τ ⟨z, hzS⟩ : S) : N) :=
        map_prod S.val _ _
      rw [← hc]
      exact (IntermediateField.mem_lift _).mpr hprod

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_tr_st_insep_step : ∀ (K N : Type u) [Field K] [Field N] [Algebra K N] [FiniteDimensional K N] (L : IntermediateField K N), ¬ L ≤ separableClosure K N → (ringChar K).Prime ∧ ∃ F : IntermediateField K N, L ⊓ separableClosure K N ≤ F ∧ F ≤ L ∧ Module.finrank K F * ringChar K = Module.finrank K L ∧ ∀ z ∈ L, z ^ ringChar K ∈ F :=
by
  intro K N _ _ _ _ L hLS
  classical

  have hp : (ringChar K).Prime := by
    rcases CharP.char_is_prime_or_zero K (ringChar K) with h | h
    · exact h
    · exfalso
      have hc : CharP K (ringChar K) := ringChar.charP K
      rw [h] at hc
      haveI : CharZero K := CharP.charP_to_charZero K
      haveI : Algebra.IsIntegral K L := Algebra.IsIntegral.of_finite K L
      exact hLS (le_separableClosure' K N (fun x => IsSeparable.of_integral K x))
  have hcK : CharP K (ringChar K) := ringChar.charP K
  generalize hpdef : ringChar K = p at hp hcK ⊢
  haveI : Fact p.Prime := ⟨hp⟩
  haveI hcN : CharP N p := charP_of_injective_algebraMap (algebraMap K N).injective p
  haveI : ExpChar N p := ExpChar.prime hp

  obtain ⟨Pre, hPre⟩ : ∃ Pre : IntermediateField K N → IntermediateField K N,
      ∀ M z, z ∈ Pre M ↔ z ^ p ∈ M := by
    refine ⟨fun M => (M.toSubfield.comap (frobenius N p)).toIntermediateField (fun c => ?_),
      fun M z => ?_⟩
    · show (frobenius N p) (algebraMap K N c) ∈ M.toSubfield
      rw [frobenius_def, ← map_pow]
      exact M.algebraMap_mem _
    · show (frobenius N p) z ∈ M.toSubfield ↔ _
      rw [frobenius_def]
      rfl

  haveI : Algebra.IsAlgebraic K N := Algebra.IsAlgebraic.of_finite K N
  haveI : IsPurelyInseparable (separableClosure K N) N := separableClosure.isPurelyInseparable K N
  haveI : CharP (separableClosure K N) p :=
    charP_of_injective_algebraMap (algebraMap K (separableClosure K N)).injective p
  haveI : ExpChar (separableClosure K N) p := ExpChar.prime hp
  obtain ⟨e, he⟩ := (IsPurelyInseparable.hasExponent_iff' (separableClosure K N) N p).mp
    IsPurelyInseparable.hasExponent_of_finiteDimensional
  have hexp : ∀ a : N, a ^ p ^ e ∈ separableClosure K N := by
    intro a
    obtain ⟨y, hy⟩ := he a
    rw [← hy]
    exact y.2

  obtain ⟨E0, hE0⟩ : ∃ E0 : IntermediateField K N, E0 = IntermediateField.adjoin K
      ((↑(L ⊓ separableClosure K N) : Set N) ∪ (fun z : N => z ^ p) '' (L : Set N)) := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℕ → IntermediateField K N, ∀ k, M k = IntermediateField.adjoin K
      ((↑(L ⊓ separableClosure K N) : Set N) ∪ (fun z : N => z ^ (p ^ k)) '' (L : Set N)) :=
    ⟨_, fun _ => rfl⟩

  have hE0L : E0 ≤ L := by
    rw [hE0, IntermediateField.adjoin_le_iff]
    rintro g (hg | ⟨z, hz, rfl⟩)
    · exact (IntermediateField.mem_inf.mp hg).1
    · exact pow_mem hz p
  have hS0E0 : L ⊓ separableClosure K N ≤ E0 := fun x hx => by
    rw [hE0]; exact IntermediateField.subset_adjoin K _ (Set.mem_union_left _ hx)
  have hpowE0 : ∀ z ∈ L, z ^ p ∈ E0 := fun z hz => by
    rw [hE0]; exact IntermediateField.subset_adjoin K _ (Set.mem_union_right _ ⟨z, hz, rfl⟩)

  have hne : E0 ≠ L := by
    intro hEq
    have hS0M : ∀ k, ∀ x ∈ L ⊓ separableClosure K N, x ∈ M k := fun k x hx => by
      rw [hM]; exact IntermediateField.subset_adjoin K _ (Set.mem_union_left _ hx)
    have hind : ∀ k, L ≤ M k := by
      intro k
      induction k with
      | zero =>
        intro z hz
        rw [hM]
        apply IntermediateField.subset_adjoin
        right
        exact ⟨z, hz, by simp⟩
      | succ k ih =>
        have h1 : M k ≤ Pre (M (k + 1)) := by
          rw [hM k, IntermediateField.adjoin_le_iff]
          rintro g (hg | ⟨z, hz, rfl⟩)
          · rw [SetLike.mem_coe, hPre]
            exact hS0M (k + 1) _ (pow_mem hg p)
          · rw [SetLike.mem_coe, hPre, hM]
            apply IntermediateField.subset_adjoin
            right
            exact ⟨z, hz, by simp only; rw [← pow_mul, ← pow_succ]⟩
        have h2 : E0 ≤ M (k + 1) := by
          rw [hE0, IntermediateField.adjoin_le_iff]
          rintro g (hg | ⟨z, hz, rfl⟩)
          · exact hS0M (k + 1) _ hg
          · exact (hPre _ _).mp (h1 (ih hz))
        exact hEq.symm.le.trans h2
    have hMe : M e ≤ L ⊓ separableClosure K N := by
      rw [hM, IntermediateField.adjoin_le_iff]
      rintro g (hg | ⟨z, hz, rfl⟩)
      · exact hg
      · exact IntermediateField.mem_inf.mpr ⟨pow_mem hz _, hexp z⟩
    exact hLS ((hind e).trans (hMe.trans inf_le_right))

  let P : ℕ → Prop := fun n => ∃ F : IntermediateField K N, E0 ≤ F ∧ F ≤ L ∧ F ≠ L ∧
    Module.finrank K F = n
  have hP0 : P (Module.finrank K E0) := ⟨E0, le_rfl, hE0L, hne, rfl⟩
  have hle0 : Module.finrank K E0 ≤ Module.finrank K L :=
    IntermediateField.finrank_le_of_le_right hE0L
  obtain ⟨F, hE0F, hFL, hFne, hFrank⟩ := Nat.findGreatest_spec hle0 hP0
  have hmax : ∀ x ∈ L, x ∉ F → F ⊔ IntermediateField.adjoin K {x} = L := by
    intro x hxL hxF
    by_contra hG
    have hGL : F ⊔ IntermediateField.adjoin K {x} ≤ L :=
      sup_le hFL (IntermediateField.adjoin_simple_le_iff.mpr hxL)
    have hPG : P (Module.finrank K ↥(F ⊔ IntermediateField.adjoin K {x})) :=
      ⟨_, hE0F.trans le_sup_left, hGL, hG, rfl⟩
    have h1 := Nat.le_findGreatest (IntermediateField.finrank_le_of_le_right hGL) hPG
    rw [← hFrank] at h1
    have h2 := IntermediateField.eq_of_le_of_finrank_le
      (le_sup_left : F ≤ F ⊔ IntermediateField.adjoin K {x}) h1
    apply hxF
    rw [h2]
    exact (le_sup_right : IntermediateField.adjoin K {x} ≤ _)
      (IntermediateField.mem_adjoin_simple_self K x)

  obtain ⟨x, hxL, hxF⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hFL hFne)
  have hxpF : x ^ p ∈ F := hE0F (hpowE0 x hxL)
  have hdeg : Module.finrank K ↥(F ⊔ IntermediateField.adjoin K {x}) =
      Module.finrank K F * p := by
    have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C (⟨x ^ p, hxpF⟩ : F)) := by
      apply X_pow_sub_C_irreducible_of_prime hp
      intro b hb
      apply hxF
      have hb' : (b : N) ^ p = x ^ p := by
        have := congrArg (fun y : F => (y : N)) hb
        simpa using this
      have h1 : ((b : N) - x) ^ p = 0 := by rw [sub_pow_char, hb', sub_self]
      have h2 : (b : N) - x = 0 := (pow_eq_zero_iff hp.ne_zero).mp h1
      rw [← sub_eq_zero.mp h2]
      exact b.2
    have hmin : minpoly F x = Polynomial.X ^ p - Polynomial.C (⟨x ^ p, hxpF⟩ : F) := by
      refine (minpoly.eq_of_irreducible_of_monic hirr ?_
        (Polynomial.monic_X_pow_sub_C _ hp.ne_zero)).symm
      simp
    have hint : IsIntegral F x := IsIntegral.of_finite F x
    have hFx : Module.finrank F ↥(IntermediateField.adjoin F {x}) = p := by
      rw [IntermediateField.adjoin.finrank hint, hmin, Polynomial.natDegree_X_pow_sub_C]
    have htower := Module.finrank_mul_finrank K F ↥(IntermediateField.adjoin F {x})
    rw [hFx] at htower
    rw [htower, ← IntermediateField.restrictScalars_adjoin_eq_sup]
    rfl

  refine ⟨hp, F, hS0E0.trans hE0F, hFL, ?_, fun z hz => hE0F (hpowE0 z hz)⟩
  rw [← hdeg, hmax x hxL hxF]

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_tr_st_residue_jump : ∀ (V K N : Type u) [CommRing V] [Field K] [Field N] [Algebra V K] [Algebra K N] [Algebra V N] [IsScalarTower V K N] (F L : IntermediateField K N) (p : ℕ), p.Prime → F ≤ L → (∀ y : N, y ≠ 0 → IsIntegral V y ∨ IsIntegral V y⁻¹) → ((p : N) = 0 ∨ ¬ IsIntegral V ((p : N)⁻¹)) → (∀ z ∈ L, IsIntegral V z → ∃ (e : ℕ) (c : N), c ∈ F ∧ IsIntegral V c ∧ (z ^ (p ^ e) - c = 0 ∨ ¬ IsIntegral V (z ^ (p ^ e) - c)⁻¹)) → (∀ y ∈ L, IsIntegral V y → ∃ c : N, c ∈ F ∧ IsIntegral V c ∧ (y - c = 0 ∨ ¬ IsIntegral V (y - c)⁻¹)) ∨ ∃ y ∈ L, IsIntegral V y ∧ ∀ a : Fin p → N, (∀ j, a j ∈ F ∧ IsIntegral V (a j)) → (∃ j, a j ≠ 0 ∧ IsIntegral V (a j)⁻¹) → (∑ j, a j * y ^ (j : ℕ)) ≠ 0 ∧ IsIntegral V (∑ j, a j * y ^ (j : ℕ))⁻¹ :=
by
  intro V K N _ _ _ _ _ _ _ F L p hp _hFL hval hpN hstep
  classical

  have h : ∀ x : N, x ∈ (integralClosure V N).toSubring ∨
      x⁻¹ ∈ (integralClosure V N).toSubring := by
    intro x
    by_cases hx : x = 0
    · left; rw [hx]; exact Subring.zero_mem _
    · rcases hval x hx with h | h
      · left; exact h
      · right; exact h
  set O : ValuationSubring N := ValuationSubring.ofSubring _ h with hOdef
  have hO : ∀ x : N, x ∈ O ↔ IsIntegral V x := by
    intro x
    rw [hOdef, ValuationSubring.mem_ofSubring, Subalgebra.mem_toSubring, mem_integralClosure_iff]
  have hOm : ∀ (x : N) (hx : x ∈ O), ((⟨x, hx⟩ : O) ∈ IsLocalRing.maximalIdeal O ↔
      (x = 0 ∨ ¬ IsIntegral V x⁻¹)) := by
    intro x hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro hnu
      by_contra hc
      push_neg at hc
      obtain ⟨h0, hi⟩ := hc
      apply hnu
      refine ⟨⟨⟨x, hx⟩, ⟨x⁻¹, (hO _).mpr hi⟩, ?_, ?_⟩, rfl⟩
      · apply Subtype.ext; simp [mul_inv_cancel₀ h0]
      · apply Subtype.ext; simp [inv_mul_cancel₀ h0]
    · rintro hc ⟨u, hu⟩
      have h1 : ((u : O) : N) * ((u⁻¹ : Oˣ) : N) = 1 := by
        exact congrArg Subtype.val u.mul_inv
      rw [hu] at h1
      have hx0 : x ≠ 0 := left_ne_zero_of_mul_eq_one h1
      have hinv := eq_inv_of_mul_eq_one_right h1
      rcases hc with hc | hc
      · exact hx0 hc
      · apply hc
        rw [← hinv]
        exact (hO _).mp (u⁻¹ : Oˣ).1.2
  have hres0 : ∀ x : O, IsLocalRing.residue O x = 0 ↔
      ((x : N) = 0 ∨ ¬ IsIntegral V (x : N)⁻¹) := fun x =>
    (IsLocalRing.residue_eq_zero_iff x).trans (hOm x x.2)

  let S1 : Subring (IsLocalRing.ResidueField O) :=
    (F.toSubfield.toSubring.comap O.subtype).map (IsLocalRing.residue O)
  have hS1 : ∀ t, t ∈ S1 ↔ ∃ x : O, (x : N) ∈ F ∧ IsLocalRing.residue O x = t := by
    intro t
    exact Subring.mem_map
  let k : Subfield (IsLocalRing.ResidueField O) :=
    { S1 with
      inv_mem' := by
        intro t ht
        have ht' : t ∈ S1 := ht
        show t⁻¹ ∈ S1
        obtain ⟨x, hxF, rfl⟩ := (hS1 t).mp ht'
        by_cases h0 : IsLocalRing.residue O x = 0
        · rw [h0, inv_zero]; exact S1.zero_mem
        · obtain ⟨u, rfl⟩ := (IsLocalRing.residue_ne_zero_iff_isUnit x).mp h0
          have h1 : ((u : O) : N) * ((u⁻¹ : Oˣ) : N) = 1 := congrArg Subtype.val u.mul_inv
          have hinv := eq_inv_of_mul_eq_one_right h1
          have h2 : IsLocalRing.residue O (u : O) * IsLocalRing.residue O ((u⁻¹ : Oˣ) : O) = 1 := by
            rw [← map_mul, Units.mul_inv, map_one]
          refine (hS1 _).mpr ⟨((u⁻¹ : Oˣ) : O), ?_, eq_inv_of_mul_eq_one_right h2⟩
          rw [hinv]
          exact inv_mem hxF }
  have hk : ∀ t, t ∈ k ↔ ∃ x : O, (x : N) ∈ F ∧ IsLocalRing.residue O x = t := hS1

  have hpκ : (p : IsLocalRing.ResidueField O) = 0 := by
    have hc : (((p : O)) : N) = (p : N) := map_natCast O.subtype p
    have hm : (p : O) ∈ IsLocalRing.maximalIdeal O :=
      (hOm ((p : O) : N) (p : O).2).mpr (by rw [hc]; exact hpN)
    rw [← map_natCast (IsLocalRing.residue O) p]
    exact (IsLocalRing.residue_eq_zero_iff _).mpr hm

  have crux : ∀ w : IsLocalRing.ResidueField O, w ∉ k → w ^ p ∈ k →
      ∀ γ : Fin p → IsLocalRing.ResidueField O, (∀ j, γ j ∈ k) → (∃ j, γ j ≠ 0) →
      ∑ j, γ j * w ^ (j : ℕ) ≠ 0 := by
    intro w hwk hwp γ hγ ⟨j0, hj0⟩ hsum
    haveI : Fact p.Prime := ⟨hp⟩
    haveI : CharP (IsLocalRing.ResidueField O) p := (CharP.charP_iff_prime_eq_zero hp).mpr hpκ
    set a : k := ⟨w ^ p, hwp⟩ with ha
    have hroot : ∀ b : k, b ^ p ≠ a := by
      intro b hb
      have h1 : ((b : IsLocalRing.ResidueField O)) ^ p = w ^ p := congrArg Subtype.val hb
      have h2 : ((b : IsLocalRing.ResidueField O) - w) ^ p = 0 := by
        rw [sub_pow_char, h1, sub_self]
      have h3 : (b : IsLocalRing.ResidueField O) - w = 0 := (pow_eq_zero_iff hp.ne_zero).mp h2
      exact hwk (by rw [← sub_eq_zero.mp h3]; exact b.2)
    have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C a) :=
      X_pow_sub_C_irreducible_of_prime hp hroot
    have hmon : (Polynomial.X ^ p - Polynomial.C a).Monic := Polynomial.monic_X_pow_sub_C a hp.ne_zero
    have hev : Polynomial.aeval w (Polynomial.X ^ p - Polynomial.C a) = 0 := by
      rw [map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C]
      exact sub_eq_zero.mpr rfl
    have hmin : Polynomial.X ^ p - Polynomial.C a = minpoly k w :=
      minpoly.eq_of_irreducible_of_monic hirr hev hmon
    set Q : Polynomial k := ∑ j : Fin p, Polynomial.C (⟨γ j, hγ j⟩ : k) * Polynomial.X ^ (j : ℕ)
      with hQdef
    have hQ : Polynomial.aeval w Q = 0 := by
      rw [hQdef, map_sum]
      simp only [map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
      exact hsum
    have hdvd : minpoly k w ∣ Q := minpoly.dvd k w hQ
    have hdeg : Q.degree < (minpoly k w).degree := by
      rw [← hmin, Polynomial.degree_X_pow_sub_C hp.pos]
      exact Polynomial.degree_sum_fin_lt _
    have hQ0 : Q = 0 := Polynomial.eq_zero_of_dvd_of_degree_lt hdvd hdeg
    have hc : Q.coeff j0 = ⟨γ j0, hγ j0⟩ := by
      rw [hQdef, Polynomial.finset_sum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single j0]
      · simp
      · intro b _ hb
        rw [if_neg]
        intro h'
        exact hb (Fin.ext h').symm
      · intro h'
        exact absurd (Finset.mem_univ j0) h'
    rw [hQ0, Polynomial.coeff_zero] at hc
    exact hj0 (congrArg Subtype.val hc).symm

  by_cases himm : ∀ y ∈ L, IsIntegral V y → ∃ c : N, c ∈ F ∧ IsIntegral V c ∧
      (y - c = 0 ∨ ¬ IsIntegral V (y - c)⁻¹)
  · exact Or.inl himm
  right
  obtain ⟨y0, hy0L, hy0i, hno⟩ : ∃ y0 ∈ L, IsIntegral V y0 ∧ ∀ c : N, c ∈ F →
      IsIntegral V c → ¬ (y0 - c = 0 ∨ ¬ IsIntegral V (y0 - c)⁻¹) := by
    by_contra hcon
    apply himm
    intro y hyL hyi
    by_contra hc
    exact hcon ⟨y, hyL, hyi, fun c hcF hci h' => hc ⟨c, hcF, hci, h'⟩⟩
  set Y0 : O := ⟨y0, (hO y0).mpr hy0i⟩ with hY0
  set w0 := IsLocalRing.residue O Y0 with hw0def
  have hw0 : w0 ∉ k := by
    intro hw
    obtain ⟨c, hcF, hc⟩ := (hk w0).mp hw
    apply hno (c : N) hcF ((hO _).mp c.2)
    have hz : IsLocalRing.residue O (Y0 - c) = 0 := by rw [map_sub, hc, sub_self]
    exact (hres0 (Y0 - c)).mp hz
  obtain ⟨e, c, hcF, hci, hc⟩ := hstep y0 hy0L hy0i
  set C : O := ⟨c, (hO c).mpr hci⟩ with hCdef
  have hz : IsLocalRing.residue O (Y0 ^ (p ^ e) - C) = 0 := (hres0 _).mpr hc
  rw [map_sub, map_pow, sub_eq_zero] at hz
  have hwe : w0 ^ (p ^ e) ∈ k := (hk _).mpr ⟨C, hcF, hz.symm⟩
  have hminexp : ∀ e : ℕ, w0 ^ (p ^ e) ∈ k → ∃ m : ℕ, w0 ^ (p ^ m) ∉ k ∧ (w0 ^ (p ^ m)) ^ p ∈ k := by
    intro e
    induction e with
    | zero => intro h'; rw [pow_zero, pow_one] at h'; exact absurd h' hw0
    | succ e ih =>
      intro h'
      by_cases h'' : w0 ^ (p ^ e) ∈ k
      · exact ih h''
      · refine ⟨e, h'', ?_⟩
        rw [← pow_mul, ← pow_succ]; exact h'
  obtain ⟨m, hwk, hwp⟩ := hminexp e hwe
  refine ⟨y0 ^ (p ^ m), pow_mem hy0L _, hy0i.pow _, ?_⟩
  rintro a ha ⟨j0, hj0ne, hj0inv⟩
  let A : Fin p → O := fun j => ⟨a j, (hO _).mpr (ha j).2⟩
  have hγk : ∀ j, IsLocalRing.residue O (A j) ∈ k := fun j => (hk _).mpr ⟨A j, (ha j).1, rfl⟩
  have hγ0 : IsLocalRing.residue O (A j0) ≠ 0 := by
    intro h'
    rcases (hres0 (A j0)).mp h' with h'' | h''
    · exact hj0ne h''
    · exact h'' hj0inv
  have hSval : (((∑ j, A j * (Y0 ^ (p ^ m)) ^ (j : ℕ) : O)) : N) =
      ∑ j, a j * (y0 ^ (p ^ m)) ^ (j : ℕ) := by
    have := map_sum O.subtype (fun j => A j * (Y0 ^ (p ^ m)) ^ (j : ℕ)) Finset.univ
    simp only [map_mul, map_pow] at this
    exact this
  have hres : IsLocalRing.residue O (∑ j, A j * (Y0 ^ (p ^ m)) ^ (j : ℕ)) =
      ∑ j, IsLocalRing.residue O (A j) * (w0 ^ (p ^ m)) ^ (j : ℕ) := by
    rw [map_sum]
    simp only [map_mul, map_pow]
    rfl
  have hne := crux (w0 ^ (p ^ m)) hwk hwp (fun j => IsLocalRing.residue O (A j)) hγk ⟨j0, hγ0⟩
  have h1 : ¬ (((∑ j, A j * (Y0 ^ (p ^ m)) ^ (j : ℕ) : O) : N) = 0 ∨
      ¬ IsIntegral V (((∑ j, A j * (Y0 ^ (p ^ m)) ^ (j : ℕ) : O) : N))⁻¹) := by
    intro h'
    apply hne
    rw [← hres]
    exact (hres0 _).mpr h'
  rw [hSval] at h1
  obtain ⟨h1a, h1b⟩ := not_or.mp h1
  exact ⟨h1a, not_not.mp h1b⟩

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_tr_st_product_cart : ∀ (V K N : Type u) [CommRing V] [IsDomain V] [Field K] [Algebra V K] [IsFractionRing V K] [Field N] [Algebra K N] [FiniteDimensional K N] [Algebra V N] [IsScalarTower V K N] (t : V), t ≠ 0 → (∀ x y : V, x ∣ y ∨ y ∣ x) → (∀ x : V, x ≠ 0 → ∃ n : ℕ, x ∣ t ^ n) → ∀ (F L : IntermediateField K N) (p : ℕ), F ≤ L → Module.finrank K F * p = Module.finrank K L → wcRfAdm V ↥F t → wcRfCart V ↥F t → ∀ y ∈ L, IsIntegral V y → (∀ a : Fin p → N, (∀ j, a j ∈ F ∧ IsIntegral V (a j)) → (∃ j, a j ≠ 0 ∧ IsIntegral V (a j)⁻¹) → (∑ j, a j * y ^ (j : ℕ)) ≠ 0 ∧ IsIntegral V (∑ j, a j * y ^ (j : ℕ))⁻¹) → wcRfCart V ↥L t :=
by
  classical
  intro V K N _ _ _ _ _ _ _ _ _ _ t ht0 htot hdiv F L p hFL hdeg hadmF hcartF y hyL hyi hy
  have hinjK : Function.Injective (algebraMap V K) := IsFractionRing.injective V K
  have htK : algebraMap V K t ≠ 0 := (map_ne_zero_iff _ hinjK).mpr ht0
  have hic : ∀ x : K, IsIntegral V x → ∃ s : V, algebraMap V K s = x := by
    intro x hx
    haveI : ValuationRing V := ValuationRing.iff_dvd_total.mpr ⟨fun a b => htot a b⟩
    letI : GCDMonoid V := IsBezout.toGCDDomain V
    exact IsIntegrallyClosed.isIntegral_iff.mp hx

  have h1 : ∀ a : K, ∃ (Nn : ℕ) (v : V), algebraMap V K t ^ Nn * a = algebraMap V K v := by
    intro a
    obtain ⟨x, z, hz, rfl⟩ := IsFractionRing.div_surjective (A := V) a
    have hz0 : z ≠ 0 := nonZeroDivisors.ne_zero hz
    obtain ⟨Nn, w, hw⟩ := hdiv z hz0
    refine ⟨Nn, w * x, ?_⟩
    have hzK : algebraMap V K z ≠ 0 := (map_ne_zero_iff _ hinjK).mpr hz0
    rw [← map_pow, hw, map_mul, map_mul]
    field_simp
  have h2 : ∀ (n : ℕ) (a : Fin n → K), ∃ (Nn : ℕ) (v : Fin n → V),
      ∀ j, algebraMap V K t ^ Nn * a j = algebraMap V K (v j) := by
    intro n a
    choose Nf vf hf using fun j => h1 (a j)
    refine ⟨Finset.univ.sup Nf, fun j => t ^ (Finset.univ.sup Nf - Nf j) * vf j, fun j => ?_⟩
    have hle : Nf j ≤ Finset.univ.sup Nf := Finset.le_sup (Finset.mem_univ j)
    rw [map_mul, map_pow, ← hf j, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hle]

  have hliG : ∀ (M : Type u) [Field M] [Algebra K M] [Algebra V M] [IsScalarTower V K M]
      (n : ℕ) (b : Fin n → M),
      (∀ c : Fin n → V, (∃ j, IsUnit (c j)) → (∑ j, algebraMap V M (c j) * b j) ≠ 0) →
      LinearIndependent K b := by
    intro M _ _ _ _ n b hbu
    have hVM : ∀ v, algebraMap V M v = algebraMap K M (algebraMap V K v) :=
      IsScalarTower.algebraMap_apply V K M
    rw [Fintype.linearIndependent_iff]
    intro a ha j
    obtain ⟨Nn, v, hv⟩ := h2 n a
    have hsum : ∑ i, algebraMap V M (v i) * b i = 0 := by
      have e : ∑ i, algebraMap V M (v i) * b i =
          algebraMap K M (algebraMap V K t ^ Nn) * ∑ i, a i • b i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hVM, ← hv i, Algebra.smul_def, map_mul, mul_assoc]
      rw [e, ha, mul_zero]
    have hvz : ∀ i, v i = 0 := by
      by_contra hne
      push_neg at hne
      obtain ⟨i₁, hi₁⟩ := hne
      have hdom : ∀ s : Finset (Fin n), s.Nonempty → ∃ j, ∀ i ∈ s, v j ∣ v i := by
        intro s
        induction s using Finset.induction_on with
        | empty => intro hs; exact absurd hs Finset.not_nonempty_empty
        | insert a s ha ih =>
          intro _
          rcases s.eq_empty_or_nonempty with h | h
          · refine ⟨a, fun i hi => ?_⟩
            rcases Finset.mem_insert.mp hi with rfl | hi
            · exact dvd_rfl
            · rw [h] at hi; simp at hi
          · obtain ⟨j, hj⟩ := ih h
            rcases htot (v j) (v a) with h' | h'
            · refine ⟨j, fun i hi => ?_⟩
              rcases Finset.mem_insert.mp hi with rfl | hi
              · exact h'
              · exact hj i hi
            · refine ⟨a, fun i hi => ?_⟩
              rcases Finset.mem_insert.mp hi with rfl | hi
              · exact dvd_rfl
              · exact h'.trans (hj i hi)
      obtain ⟨j₀, hj₀⟩ := hdom Finset.univ ⟨i₁, Finset.mem_univ _⟩
      have hv0 : v j₀ ≠ 0 := by
        intro h0
        have := hj₀ i₁ (Finset.mem_univ _)
        rw [h0] at this
        exact hi₁ (zero_dvd_iff.mp this)
      have hex : ∀ i, ∃ e : V, v i = v j₀ * e := fun i => hj₀ i (Finset.mem_univ i)
      choose e he using hex
      set e' : Fin n → V := fun i => if i = j₀ then 1 else e i with he'def
      have he' : ∀ i, v i = v j₀ * e' i := by
        intro i
        by_cases hij : i = j₀
        · rw [he'def]; simp only [hij, if_true, mul_one]
        · rw [he'def]; simp only [hij, if_false]; exact he i
      apply hbu e' ⟨j₀, by rw [he'def]; simp only [if_true]; exact isUnit_one⟩
      have hv0M : algebraMap V M (v j₀) ≠ 0 := by
        rw [hVM]; exact (map_ne_zero _).mpr ((map_ne_zero_iff _ hinjK).mpr hv0)
      apply mul_left_cancel₀ hv0M
      rw [mul_zero, Finset.mul_sum, ← hsum]
      refine Finset.sum_congr rfl fun i _ => ?_
