  refine ⟨Fintype.card (Fin n → Fin p), fun j => f (Xe (σ.symm j)), fun d => ?_⟩
  obtain ⟨P, rfl⟩ := hf d
  obtain ⟨c, hc⟩ := hdec P
  refine ⟨fun j => f (c (σ.symm j)), ?_⟩
  rw [hc, map_sum]
  simp only [map_mul, map_pow]
  exact (Equiv.sum_comp σ.symm (fun e => f (c e) ^ p * f (Xe e))).symm

