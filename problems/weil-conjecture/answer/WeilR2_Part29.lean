            (Ideal.Quotient.mk I (f * MvPolynomial.X n)) =
            (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
              (Ideal.Quotient.mk I f) *
            (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
              (Ideal.Quotient.mk I (MvPolynomial.X n)) := by
