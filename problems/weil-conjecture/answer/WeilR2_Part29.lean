  set b := q₁ + φ y₁ * e.repr (D p₁) 1 + φ y₂ * e.repr (D q₁) 1 with hb
  set c := p₂ + φ y₁ * e.repr (D p₂) 0 + φ y₂ * e.repr (D q₂) 0 with hc
  set d := q₂ + φ y₁ * e.repr (D p₂) 1 + φ y₂ * e.repr (D q₂) 1 with hd
  have hdet : a * d - b * c ∉ 𝔔₀ := by
    intro hmemdet
    have k1 : a - p₁ ∈ 𝔔₀ := by
      have : a - p₁ = φ y₁ * e.repr (D p₁) 0 + φ y₂ * e.repr (D q₁) 0 := by rw [ha]; ring
      rw [this]; exact hmem _ _
    have k2 : b - q₁ ∈ 𝔔₀ := by
      have : b - q₁ = φ y₁ * e.repr (D p₁) 1 + φ y₂ * e.repr (D q₁) 1 := by rw [hb]; ring
      rw [this]; exact hmem _ _
    have k3 : c - p₂ ∈ 𝔔₀ := by
      have : c - p₂ = φ y₁ * e.repr (D p₂) 0 + φ y₂ * e.repr (D q₂) 0 := by rw [hc]; ring
      rw [this]; exact hmem _ _
    have k4 : d - q₂ ∈ 𝔔₀ := by
      have : d - q₂ = φ y₁ * e.repr (D p₂) 1 + φ y₂ * e.repr (D q₂) 1 := by rw [hd]; ring
      rw [this]; exact hmem _ _
    have k5 : φ α * φ γ ∈ 𝔔₀ := by
      rw [← map_mul, ← Ideal.mem_comap, hcomap]; exact hαγ
    have key : φ β = (a * d - b * c) - ((a - p₁) * d + p₁ * (d - q₂) + (w - φ β) -
        (b - q₁) * c - q₁ * (c - p₂) - w' * (φ α * φ γ)) := by
      rw [hp₁, hq₁, hp₂, hq₂]; ring
    have hβ' : φ β ∈ 𝔔₀ := by
      rw [key]
      refine Ideal.sub_mem _ hmemdet ?_
      refine Ideal.sub_mem _ (Ideal.sub_mem _ (Ideal.sub_mem _ (Ideal.add_mem _ (Ideal.add_mem _
