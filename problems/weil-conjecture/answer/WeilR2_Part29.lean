    rw [← Category.assoc, hc₀r, hh₀s]
  have hg₁ : c₁ ≫ r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
