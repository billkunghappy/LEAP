      x = algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d) v * u := by
    intro x
    obtain ⟨v, s, hvs⟩ := s3 (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d)
      (algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d))
      (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d))
