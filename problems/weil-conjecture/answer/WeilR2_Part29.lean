      rw [hPy, hF, ← map_pow, ← MvPolynomial.C_pow, hμ, MvPolynomial.C_mul]
      simp only [map_mul]
      ring
    · exact (key fun i => hdv.trans (hdivall i)).elim

  have hb : ∀ f : wcGbT W ϖ d, f ≠ 0 → ∃ (c : ↥W) (N : ℕ) (f₀ : wcGbT W ϖ d), c ≠ 0 ∧
      c ∣ ϖ ^ N ∧ ρ f₀ ≠ 0 ∧
      f = algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) * f₀ := by
    intro f hf
    obtain ⟨c, μ, k, F, y, hcμ, hμ, ⟨e, he⟩, hfeq⟩ := hcontent f hf
    refine ⟨c, k, _, ?_, Dvd.intro μ hcμ, ?_, hfeq⟩
    · rintro rfl
      apply hf
      rw [hfeq, map_zero, map_zero, zero_mul]
    · rw [map_add, map_mul, hψ0 μ hμ, zero_mul, add_zero, hρ]
      refine MvPolynomial.ne_zero_iff.mpr ⟨e, ?_⟩
      rw [MvPolynomial.coeff_map, he, map_one]
      exact one_ne_zero

  have hrad : ∀ a : ↥W, ¬ IsUnit a → ∃ N : ℕ, ϖ ∣ a ^ N := by
    intro a ha
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hmem : a ∈ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine Ideal.mem_sInf.mpr ?_
      rintro J ⟨hJc, hJp⟩
      have hJne : J ≠ ⊥ := by
        intro h
        apply hϖ0
        have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
        rw [h] at h1
        exact Ideal.mem_bot.mp h1
      have hJmax : J.IsMaximal := by
        rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
        · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
        · exact h
      rw [IsLocalRing.eq_maximalIdeal hJmax]
      exact (IsLocalRing.mem_maximalIdeal a).mpr ha
    obtain ⟨n, hn⟩ := hmem
    exact ⟨n, Ideal.mem_span_singleton.mp hn⟩
  have hunitc : ∀ (c : ↥W) (x₀ : wcGbT W ϖ d),
      algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) * x₀ ∉ wcGbP W ϖ d →
      IsUnit c := by
    intro c x₀ hx
    by_contra hc
    obtain ⟨N, w, hw⟩ := hrad c hc
    apply hx
    apply Ideal.mul_mem_right
    show algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) ∈
      (Ideal.span {algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C ϖ)}).radical
    refine ⟨N, ?_⟩
    rw [← map_pow, ← map_pow, hw, map_mul, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

  have hprime : (wcGbP W ϖ d).IsPrime := by
    rw [Ideal.isPrime_iff]
    refine ⟨(Ideal.ne_top_iff_one _).mpr h1notin, ?_⟩
    intro x y hxy
    by_contra hcon
    rw [not_or] at hcon
    obtain ⟨hx, hy⟩ := hcon
    have hx0 : x ≠ 0 := by rintro rfl; exact hx (Ideal.zero_mem _)
    have hy0 : y ≠ 0 := by rintro rfl; exact hy (Ideal.zero_mem _)
    obtain ⟨c₁, -, x₀, -, -, hx₀, rfl⟩ := hb x hx0
    obtain ⟨c₂, -, y₀, -, -, hy₀, rfl⟩ := hb y hy0
    have hu₁ := hunitc c₁ x₀ hx
    have hu₂ := hunitc c₂ y₀ hy
    have hr : ∀ c : ↥W, IsUnit c →
        ρ (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c)) ≠ 0 := by
      intro c hc
      rw [hρ, MvPolynomial.map_C, Ne, MvPolynomial.C_eq_zero]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit c).mpr hc
    have h3 := hker _ hxy
    rw [map_mul, map_mul, map_mul] at h3
    exact mul_ne_zero (mul_ne_zero (hr c₁ hu₁) hx₀) (mul_ne_zero (hr c₂ hu₂) hy₀) h3

  have hcc : ∀ x y : wcGbT W ϖ d, ∃ u z : wcGbT W ϖ d, u ∉ wcGbP W ϖ d ∧
      (u * x = z * y ∨ u * y = z * x) := by
