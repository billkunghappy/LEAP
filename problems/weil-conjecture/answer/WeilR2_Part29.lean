    obtain ⟨y, hy⟩ := hw
    have hsq : IsPullback
        (Limits.pullback.map (cc ≫ r₀ ≫ Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp
          (r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp
