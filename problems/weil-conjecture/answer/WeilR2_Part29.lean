  have content_split : ∀ (n : ℕ) (a : MvPolynomial (Fin n) ↥W) (π : ↥W), ¬ (MvPolynomial.C π ∣ a) → ∃ (c b e : ↥W) (Q M : MvPolynomial (Fin n) ↥W), π = c * b * e ∧ ¬ IsUnit b ∧ Q ≠ 0 ∧ (∀ ν, Q.coeff ν ≠ 0 → IsUnit (Q.coeff ν)) ∧ a = MvPolynomial.C c * (Q + MvPolynomial.C b * M) := by
