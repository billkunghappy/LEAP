    have approxGen : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) →
        ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C)
          (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c +
            algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
      intro C _ p hp
      have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
          (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
          Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
        intro k c
        rw [AlgHom.commutes]
        rfl
      have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
        intro k x
        rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
          p ^ m ∣ a k - a m := by
        intro a m k hmk
        rw [← hmem, map_sub, sub_eq_zero]
        exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
      have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
        intro n
        induction n with
        | zero => intro x h; simpa using h
        | succ n ih =>
          intro x h
          apply ih
          apply hp
          rw [← mul_assoc, ← pow_succ']
          exact h
      have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
        intro n u v h
        rw [← sub_eq_zero]
        apply hN n
        rw [mul_sub, h, sub_self]
      intro n y
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
        fun k => hD a n (k + n) (by omega)
      choose b hb using hex
      have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
        intro k
        rw [SModEq.sub_mem]
        obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
        have e : b k - b (k + 1) = p ^ k * (-s) := by
          apply hNc n
          linear_combination (-1 : C) * hb k + hb (k + 1) - hs
        rw [e]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
          Submodule.mem_top
      let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
        AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
      have hBk : ∀ k, B k = b k := fun k => rfl
      refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
      apply AdicCompletion.ext_evalₐ
