  have hz₂ : φ y₂ ∈ 𝔔₀ := by rw [← Ideal.mem_comap, hcomap]; exact hy₂
  have hmem : ∀ X Y : C₀, φ y₁ * X + φ y₂ * Y ∈ 𝔔₀ := fun X Y =>
    Ideal.add_mem _ (Ideal.mul_mem_right _ _ hz₁) (Ideal.mul_mem_right _ _ hz₂)
  obtain ⟨e, he⟩ := t_L8 R C₀ _ _ hyC
  set D := KaehlerDifferential.D R C₀ with hD
  have hrep : ∀ x : C₀, D x = e.repr (D x) 0 • D (φ y₁) + e.repr (D x) 1 • D (φ y₂) := by
    intro x
    have h := e.sum_repr (D x)
