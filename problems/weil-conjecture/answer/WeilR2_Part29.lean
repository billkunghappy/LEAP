      intro c hc r z hr hz heq
      obtain ⟨hz0, hzi⟩ := hbu c hc
      rw [heq] at hz0 hzi
      have hr0 : algebraMap V M r ≠ 0 := left_ne_zero_of_mul hz0
      have hzz : z ≠ 0 := right_ne_zero_of_mul hz0
      have hrinv : IsIntegral V (algebraMap V M r)⁻¹ := by
