    Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
  have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
        Nat.one_pos).opensRange =
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
    rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
  have H := s6 (Proj.map f hf)
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
    (Spec.map (CommRingCat.ofHom (algebraMap F F')))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
      (hX a) Nat.one_pos)
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
      (f.map_mem (hX a)) Nat.one_pos)
    (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
    hcov hcomm hpre hchart
  exact ⟨H.isoPullback.inv, inferInstance, H.isoPullback_inv_snd⟩

theorem wcpa_dj_lr1k_base_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω),
    ∃ (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), wcpaDjLkModel W uX ι ∧
      ∀ x : ↥(Limits.pullback uX
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
        ∃ U : (Limits.pullback uX
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens,
          x ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ Limits.pullback.snd uX
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
by
  intro Ω _ _ W
  letI := @MvPolynomial.gradedAlgebra (Fin (1+1)) ↥W _

  have hbij : Function.Bijective
      (algebraMap ↥W ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0)) := by
    constructor
    · intro a b hab
      have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0 =>
        (x : MvPolynomial (Fin (1+1)) ↥W)) hab
      simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
      exact MvPolynomial.C_injective _ _ h
    · intro x
      have hx : (x : MvPolynomial (Fin (1+1)) ↥W).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
      have ht : (x : MvPolynomial (Fin (1+1)) ↥W).totalDegree = 0 :=
        Nat.le_zero.mp hx.totalDegree_le
      refine ⟨(x : MvPolynomial (Fin (1+1)) ↥W).coeff 0, Subtype.ext ?_⟩
      simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
  haveI hcW : IsIso (CommRingCat.ofHom (R := ↥W)
      (S := ↥((MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0))
      (algebraMap ↥W ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0))) := by
    rw [ConcreteCategory.isIso_iff_bijective]
    exact hbij

  letI : IsScalarTower ↥W ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0)
      (MvPolynomial (Fin (1+1)) ↥W) :=
    IsScalarTower.of_algebraMap_eq (R := ↥W)
      (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0)
      (A := MvPolynomial (Fin (1+1)) ↥W) (fun r => rfl)
  haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0)
      (MvPolynomial (Fin (1+1)) ↥W) :=
    Algebra.FiniteType.of_restrictScalars_finiteType ↥W _ _
  haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W)) :=
    inferInstance

  haveI hsm0 : SmoothOfRelativeDimension 1
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W)) :=
    wcpa_dj_gs_bf_P1_smooth ↥W
  let uX : Proj (MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) ⟶ Spec (.of ↥W) :=
    Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap ↥W ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W) 0)))
  haveI hsmu : SmoothOfRelativeDimension 1 uX :=
    (inferInstance : SmoothOfRelativeDimension (1 + 0) uX)
  haveI : Smooth uX := SmoothOfRelativeDimension.smooth 1 uX
  haveI hflat : Flat uX := inferInstance
  haveI hpropu : IsProper uX := inferInstance

  have hfib : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
      (w : ↥(Limits.pullback uX s)), ∃ U : (Limits.pullback uX s).Opens,
        w ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ Limits.pullback.snd uX s) := by
    intro K _ s w
    haveI h1 : SmoothOfRelativeDimension 1 (Limits.pullback.snd uX s) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
        (IsPullback.of_hasPullback uX s) inferInstance
    exact ⟨⊤, trivial,
      (inferInstance : SmoothOfRelativeDimension (0 + 1)
        (Scheme.Opens.ι (⊤ : (Limits.pullback uX s).Opens) ≫ Limits.pullback.snd uX s))⟩

  obtain ⟨e, heiso, he⟩ := wcpa_dj_lpm_proj_space_bc_iso ↥W Ω 1
  haveI := heiso
  have he' : inv e ≫ Limits.pullback.snd uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) =
      wcProjKStr Ω 1 := by
    rw [← he, IsIso.inv_hom_id_assoc]
  have hb : IsPullback (inv e) (wcProjKStr Ω 1)
      (Limits.pullback.snd uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [he', Category.comp_id]⟩
  have hpb : IsPullback
      (inv e ≫ Limits.pullback.fst uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
      (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    have h := hb.paste_horiz (IsPullback.of_hasPullback uX
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
    rw [Category.id_comp] at h
    exact h
  refine ⟨Proj (MvPolynomial.homogeneousSubmodule (Fin (1+1)) ↥W), uX,
    inv e ≫ Limits.pullback.fst uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))),
    ⟨⟨hflat, hpropu, ?_⟩, ⟨1, 𝟙 _, inferInstance, Category.id_comp _⟩, hpb⟩, ?_⟩
  · intro K _ _ s w
    exact Or.inl (hfib K s w)
  · intro x
    exact hfib _ _ x

theorem wcpa_dj_lr1s_nf_generic_integrality : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (φ : Ct ⟶ wcProjK Ω 1) (X : Scheme.{u})
    (uX : X ⟶ Spec (.of ↥W)) (ι : wcProjK Ω 1 ⟶ X), IsFinite φ → φ ≫ wcProjKStr Ω 1 = ct →
    LocallyOfFiniteType uX →
    IsPullback ι (wcProjKStr Ω 1) uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
    ∀ U : X.affineOpens,
      letI : Algebra ↥W Γ(X, U) := ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
        X.presheaf.map (homOfLE le_top).op).hom.toAlgebra
      letI : Algebra Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := ((φ ≫ ι).app U).hom.toAlgebra
      letI : Algebra Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ ct.appTop ≫
        Ct.presheaf.map (homOfLE le_top).op).hom.toAlgebra
      Algebra.FiniteType ↥W Γ(X, U) ∧ Algebra.FiniteType Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) ∧
      (∀ w : ↥W, algebraMap Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Γ(X, U) w) =
        algebraMap Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Ω w)) ∧
      ∀ b : Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U), ∃ c : ↥W, c ≠ 0 ∧
        IsIntegral Γ(X, U) (algebraMap Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Ω c) * b) :=
by

  have s1 : ∀ (R S : CommRingCat.{u}) (g : R ⟶ S) (X Y : Scheme.{u}) (uX : X ⟶ Spec R)
      (uY : Y ⟶ Spec S) (f : Y ⟶ X) (h : f ≫ uX = uY ≫ Spec.map g) (U : X.Opens),
      (Scheme.ΓSpecIso R).inv ≫ uX.appTop ≫ X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫
        f.app U = g ≫ (Scheme.ΓSpecIso S).inv ≫ uY.appTop ≫
          Y.presheaf.map (homOfLE (le_top : f ⁻¹ᵁ U ≤ ⊤)).op := by
    intro R S g X Y uX uY f h U
    rw [Scheme.Hom.naturality]
    have h2 : uX.appTop ≫ f.appTop = (Spec.map g).appTop ≫ uY.appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, h]
    rw [← Category.assoc g, Scheme.ΓSpecIso_inv_naturality g]
    simp only [Category.assoc]
    rw [← reassoc_of% h2]
    rfl

  have s0 : ∀ (R : CommRingCat.{u}) (X : Scheme.{u}) (uX : X ⟶ Spec R) [LocallyOfFiniteType uX]
      (U : X.Opens) (hU : IsAffineOpen U),
      ((Scheme.ΓSpecIso R).inv ≫ uX.appTop ≫
        X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.FiniteType := by
    intro R X uX _ U hU
    have e : U ≤ uX ⁻¹ᵁ ⊤ := by simp
    have h1 := Scheme.Hom.finiteType_appLE uX (isAffineOpen_top (Spec R)) hU e
    have h2 : uX.appLE ⊤ U e = uX.appTop ≫ X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op := rfl
    rw [h2] at h1
    rw [CommRingCat.hom_comp]
    exact h1.comp (RingHom.FiniteType.of_surjective _
      (Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv.symm.surjective)

  have s4 : ∀ (R A D B : Type u) [CommRing R] [IsDomain R] [CommRing A] [CommRing D] [CommRing B]
      [Algebra R A] [Algebra A D] [Algebra D B] [Algebra A B] [IsScalarTower A D B]
      [IsLocalization (Algebra.algebraMapSubmonoid A (nonZeroDivisors R)) D] [Module.Finite D B]
      (b : B), ∃ c : R, c ≠ 0 ∧ IsIntegral A (algebraMap A B (algebraMap R A c) * b) := by
    intro R A D B _ _ _ _ _ _ _ _ _ _ _ _ b
    have hb : IsIntegral D b := IsIntegral.of_finite D b
    obtain ⟨⟨m, hm⟩, hmb⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      (Algebra.algebraMapSubmonoid A (nonZeroDivisors R)) b hb
    obtain ⟨c, hc, rfl⟩ := Submonoid.mem_map.mp hm
    refine ⟨c, nonZeroDivisors.ne_zero hc, ?_⟩
    rw [Submonoid.smul_def, Algebra.smul_def] at hmb
    exact hmb

  have s3 : ∀ (R A S D : Type u) [CommRing R] [CommRing A] [CommRing S] [CommRing D] [Algebra R A]
      [Algebra R S] [Algebra A D] [Algebra S D] (M : Submonoid R) [IsLocalization M S]
      (h : IsPushout (CommRingCat.ofHom (algebraMap R A)) (CommRingCat.ofHom (algebraMap R S))
        (CommRingCat.ofHom (algebraMap A D)) (CommRingCat.ofHom (algebraMap S D))),
      IsLocalization (Algebra.algebraMapSubmonoid A M) D ∧
        (Algebra.FiniteType R A → Algebra.FiniteType S D) := by
    intro R A S D _ _ _ _ _ _ _ _ M _ h
    letI : Algebra R D := ((algebraMap S D).comp (algebraMap R S)).toAlgebra
    haveI : IsScalarTower R S D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower R A D := IsScalarTower.of_algebraMap_eq (fun x => by
      have := congrArg (fun k => k.hom x) h.w
      simp at this
      exact this.symm)
    have hp : Algebra.IsPushout R A S D := CommRingCat.isPushout_iff_isPushout.mp h
    refine ⟨(Algebra.isLocalization_iff_isPushout M S).mpr hp, fun hA => ?_⟩
    have hp' : Algebra.IsPushout R S A D := hp.symm
    haveI : Algebra.FiniteType S (TensorProduct R S A) := Algebra.FiniteType.baseChange S
    exact Algebra.FiniteType.equiv inferInstance (Algebra.IsPushout.equiv R S A D)

  have s2 : ∀ (R S : CommRingCat.{u}) (g : R ⟶ S) (P X : Scheme.{u}) (str : P ⟶ Spec S)
      (uX : X ⟶ Spec R) (ι : P ⟶ X) (hpb : IsPullback ι str uX (Spec.map g)) (U : X.Opens)
      (hU : IsAffineOpen U),
      IsPushout ((Scheme.ΓSpecIso R).inv ≫ uX.appTop ≫
          X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op) g
        (ι.app U) ((Scheme.ΓSpecIso S).inv ≫ str.appTop ≫
          P.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ U ≤ ⊤)).op) := by
    intro R S g P X str uX ι hpb U hU
    have h1 := IsPullback.paste_vert (isPullback_morphismRestrict ι U) hpb
    haveI : IsAffine U.toScheme := hU
    have h2 := isPushout_appTop_of_isPullback h1
    refine IsPushout.of_iso h2 (Scheme.ΓSpecIso R) U.topIso (Scheme.ΓSpecIso S) (ι ⁻¹ᵁ U).topIso
      ?_ ?_ ?_ ?_
    · rw [Iso.hom_inv_id_assoc, Scheme.Hom.comp_appTop, Category.assoc, Scheme.Opens.ι_appTop,
        Scheme.Opens.topIso_hom]
      congr 1
      exact (X.presheaf.map_comp _ _).symm
    · exact Scheme.ΓSpecIso_naturality g
    · have gen : ∀ {U1 U2 : X.Opens} {V1 V2 : P.Opens} (hU : U2 = U1) (hV : V2 = V1)
          (e1 : V1 ≤ ι ⁻¹ᵁ U1) (e2 : V2 ≤ ι ⁻¹ᵁ U2),
          ι.appLE U1 V1 e1 ≫ P.presheaf.map (eqToHom hV).op =
            X.presheaf.map (eqToHom hU).op ≫ ι.appLE U2 V2 e2 := by
        intro U1 U2 V1 V2 hU hV e1 e2
        subst hU hV
        simp
      simp only [morphismRestrict_appTop, Scheme.Opens.topIso_hom]
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
      exact gen _ _ _ _
    · rw [Iso.hom_inv_id_assoc, Scheme.Hom.comp_appTop, Category.assoc, Scheme.Opens.ι_appTop,
        Scheme.Opens.topIso_hom]
      congr 1
      exact (P.presheaf.map_comp _ _).symm

  suffices key : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (P : Scheme.{u})
      (str : P ⟶ Spec (.of Ω)) (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (φ : Ct ⟶ P)
      (X : Scheme.{u}) (uX : X ⟶ Spec (.of ↥W)) (ι : P ⟶ X), IsFinite φ → φ ≫ str = ct →
      LocallyOfFiniteType uX →
      IsPullback ι str uX (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
      ∀ U : X.affineOpens,
        letI : Algebra ↥W Γ(X, U) := ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
          X.presheaf.map (homOfLE le_top).op).hom.toAlgebra
        letI : Algebra Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := ((φ ≫ ι).app U).hom.toAlgebra
        letI : Algebra Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ ct.appTop ≫
          Ct.presheaf.map (homOfLE le_top).op).hom.toAlgebra
        Algebra.FiniteType ↥W Γ(X, U) ∧ Algebra.FiniteType Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) ∧
        (∀ w : ↥W, algebraMap Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Γ(X, U) w) =
          algebraMap Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Ω w)) ∧
        ∀ b : Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U), ∃ c : ↥W, c ≠ 0 ∧
          IsIntegral Γ(X, U) (algebraMap Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Ω c) * b) by
    intro Ω _ W Ct ct φ X uX ι
    exact key Ω W (wcProjK Ω 1) (wcProjKStr Ω 1) Ct ct φ X uX ι

  intro Ω _ W P str Ct ct φ X uX ι hφf hφ hlu hpb U
  haveI := hφf
  haveI hιaff : IsAffineHom ι := MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip
    (inferInstance : IsAffineHom (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
  have hV : IsAffineOpen (ι ⁻¹ᵁ (U : X.Opens)) := U.2.preimage ι
  have hcomm : (φ ≫ ι) ≫ uX = ct ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [Category.assoc, hpb.w, ← Category.assoc, hφ]
  letI iWA : Algebra ↥W Γ(X, U) := ((Scheme.ΓSpecIso (.of ↥W)).inv ≫ uX.appTop ≫
    X.presheaf.map (homOfLE le_top).op).hom.toAlgebra
  letI iAB : Algebra Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := ((φ ≫ ι).app U).hom.toAlgebra
  letI iΩB : Algebra Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ ct.appTop ≫
    Ct.presheaf.map (homOfLE le_top).op).hom.toAlgebra

  have ha : Algebra.FiniteType ↥W Γ(X, U) := by
    rw [← RingHom.finiteType_algebraMap]
    exact s0 (.of ↥W) X uX U U.2

  have hc : ∀ w : ↥W, algebraMap Γ(X, U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Γ(X, U) w) =
      algebraMap Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) (algebraMap ↥W Ω w) := by
    intro w
    have := congrArg (fun k => k.hom w)
      (s1 (.of ↥W) (.of Ω) (CommRingCat.ofHom (algebraMap ↥W Ω)) X Ct uX ct (φ ≫ ι) hcomm U)
    exact this

  letI iAD : Algebra Γ(X, U) Γ(P, ι ⁻¹ᵁ U) := (ι.app U).hom.toAlgebra
  letI iΩD : Algebra Ω Γ(P, ι ⁻¹ᵁ U) := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ str.appTop ≫
    P.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ (U : X.Opens) ≤ ⊤)).op).hom.toAlgebra
  have hpo := s2 (.of ↥W) (.of Ω) (CommRingCat.ofHom (algebraMap ↥W Ω)) P X str uX ι hpb U U.2
  obtain ⟨hloc, hDft⟩ := s3 ↥W Γ(X, U) Ω Γ(P, ι ⁻¹ᵁ U) (nonZeroDivisors ↥W) hpo

  have hfac := s1 (.of Ω) (.of Ω) (𝟙 _) P Ct str ct φ (by rw [Spec.map_id, Category.comp_id, hφ])
    (ι ⁻¹ᵁ U)

  letI iDB : Algebra Γ(P, ι ⁻¹ᵁ U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := (φ.app (ι ⁻¹ᵁ U)).hom.toAlgebra
  have hfin : (φ.app (ι ⁻¹ᵁ U)).hom.Finite := Scheme.Hom.finite_app φ (ι ⁻¹ᵁ U) hV
  haveI : Module.Finite Γ(P, ι ⁻¹ᵁ U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) := hfin
  have hΩB : algebraMap Ω Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) =
      (algebraMap Γ(P, ι ⁻¹ᵁ U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U)).comp (algebraMap Ω Γ(P, ι ⁻¹ᵁ U)) := by
    have := congrArg CommRingCat.Hom.hom hfac
    simp only [CommRingCat.hom_comp, CommRingCat.hom_id] at this
    exact this.symm
  refine ⟨ha, ?_, hc, ?_⟩
  · rw [← RingHom.finiteType_algebraMap, hΩB]
    exact RingHom.FiniteType.comp hfin.finiteType (RingHom.finiteType_algebraMap.mpr (hDft ha))
  · intro b
    haveI : IsScalarTower Γ(X, U) Γ(P, ι ⁻¹ᵁ U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    obtain ⟨c, hc0, hci⟩ := s4 ↥W Γ(X, U) Γ(P, ι ⁻¹ᵁ U) Γ(Ct, (φ ≫ ι) ⁻¹ᵁ U) b
    refine ⟨c, hc0, ?_⟩
    rw [← hc c]
    exact hci

theorem wcpa_dj_lr1s_nf_adic_completion_basics : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → (∀ y : AdicCompletion (Ideal.span {p}) C, algebraMap C (AdicCompletion (Ideal.span {p}) C) p * y = 0 → y = 0) ∧ (∀ (n : ℕ) (c : C) (y : AdicCompletion (Ideal.span {p}) C), algebraMap C (AdicCompletion (Ideal.span {p}) C) c = algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y → ∃ c' : C, c = p ^ n * c') ∧ (∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y') :=
by
  intro C _ p hp
  have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
      (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
      Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
    intro k c
    rw [AlgHom.commutes]
    rfl
  have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
    intro k x
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
      p ^ m ∣ a k - a m := by
    intro a m k hmk
    rw [← hmem, map_sub, sub_eq_zero]
    exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
  have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
    intro n
    induction n with
    | zero => intro x h; simpa using h
    | succ n ih =>
      intro x h
      apply ih
      apply hp
      rw [← mul_assoc, ← pow_succ']
      exact h
  have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
    intro n u v h
    rw [← sub_eq_zero]
    apply hN n
    rw [mul_sub, h, sub_self]
  refine ⟨?_, ?_, ?_⟩
  · intro y hy
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_zero, AdicCompletion.evalₐ_mk, hmem]
    have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) (k + 1)) hy
    rw [map_mul, map_zero, hev, AdicCompletion.evalₐ_mk, ← map_mul, hmem] at h1
    obtain ⟨t, ht⟩ := h1
    have h2 : a (k + 1) = p ^ k * t := by
      apply hNc 1
      rw [pow_one, ht]
      ring
    obtain ⟨s, hs⟩ := hD a k (k + 1) (by omega)
    exact ⟨t - s, by linear_combination h2 - hs⟩
  · intro n c y h
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) n) h
    rw [map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, ← map_pow, ← map_mul,
      ← sub_eq_zero, ← map_sub, hmem] at h1
    obtain ⟨t, ht⟩ := h1
    exact ⟨a n + t, by linear_combination ht⟩
  · intro n y
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
      fun k => hD a n (k + n) (by omega)
    choose b hb using hex
    have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
      intro k
      rw [SModEq.sub_mem]
      obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
      have e : b k - b (k + 1) = p ^ k * (-s) := by
        apply hNc n
        linear_combination (-1 : C) * hb k + hb (k + 1) - hs
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
        Submodule.mem_top
    let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
      AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
    have hBk : ∀ k, B k = b k := fun k => rfl
    refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
    obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
    exact ⟨-s, by linear_combination hb k - hs⟩

theorem wcpa_dj_lr1s_nf_completion_descent : ∀ (C B R : Type u) [CommRing C] [CommRing B] [CommRing R] [Algebra C B] [Algebra C R] (p : C), Function.Injective (algebraMap C B) → IsUnit (algebraMap C B p) → (∀ b : B, ∃ n : ℕ, ∃ a : C, algebraMap C B p ^ n * b = algebraMap C B a) → (∀ y : R, algebraMap C R p * y = 0 → y = 0) → (∀ (n : ℕ) (c : C) (y : R), algebraMap C R c = algebraMap C R p ^ n * y → ∃ c' : C, c = p ^ n * c') → (∀ (n : ℕ) (y : R), ∃ (c : C) (y' : R), y = algebraMap C R c + algebraMap C R p ^ n * y') → Module.Finite R ↥(integralClosure R (Localization.Away (algebraMap C R p))) → Module.Finite C ↥(integralClosure C B) :=
by
  intro C B R _ _ _ _ _ p hinj hunit hsurj ha hb hc hfin
  classical

  haveI hloc : IsLocalization (Submonoid.powers p) B := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, n, rfl⟩
      show IsUnit (algebraMap C B (p ^ n))
      rw [map_pow]
      exact hunit.pow n
    · intro b
      obtain ⟨n, a, h⟩ := hsurj b
      refine ⟨(a, ⟨p ^ n, n, rfl⟩), ?_⟩
      show b * algebraMap C B (p ^ n) = algebraMap C B a
      rw [map_pow, mul_comm]
      exact h
    · intro x y h
      exact ⟨1, by rw [hinj h]⟩

  have hπ : IsUnit (algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R p)) :=
    IsLocalization.Away.algebraMap_isUnit _
  have hg : ∀ y : Submonoid.powers p,
      IsUnit (((algebraMap R (Localization.Away (algebraMap C R p))).comp (algebraMap C R)) y) := by
    rintro ⟨_, n, rfl⟩
    show IsUnit (((algebraMap R (Localization.Away (algebraMap C R p))).comp (algebraMap C R)) (p ^ n))
    rw [map_pow]
    exact hπ.pow n
  set ψ : B →+* Localization.Away (algebraMap C R p) := IsLocalization.lift hg with hψdef
  have hψ : ∀ c : C, ψ (algebraMap C B c) =
      algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R c) :=
    fun c => IsLocalization.lift_eq hg c

  have hcancel : ∀ (m : ℕ) (z : R), algebraMap C R p ^ m * z = 0 → z = 0 := by
    intro m
    induction m with
    | zero => intro z h; simpa using h
    | succ m ih =>
      intro z h
      apply ih
      apply ha
      rw [← mul_assoc, ← pow_succ']
      exact h
  have hspade : ∀ (u : B) (y : R),
      ψ u = algebraMap R (Localization.Away (algebraMap C R p)) y → ∃ c : C, u = algebraMap C B c := by
    intro u y hu
    obtain ⟨n, a, hna⟩ := hsurj u
    have h1 : algebraMap R (Localization.Away (algebraMap C R p))
        (algebraMap C R a - algebraMap C R p ^ n * y) = 0 := by
      have := congrArg ψ hna
      rw [map_mul, map_pow, hψ, hψ, hu] at this
      rw [map_sub, map_mul, map_pow, ← this, sub_self]
    obtain ⟨⟨_, m, rfl⟩, hm⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers (algebraMap C R p)) _ _).mp h1
    have h2 := hcancel m _ hm
    obtain ⟨c', hc'⟩ := hb n a y (sub_eq_zero.mp h2)
    refine ⟨c', ?_⟩
    have h3 : algebraMap C B p ^ n * u = algebraMap C B p ^ n * algebraMap C B c' := by
      rw [hna, hc', map_mul, map_pow]
    exact (hunit.pow n).mul_left_cancel h3

  obtain ⟨r, σ, hσ⟩ := Module.Finite.exists_fin (R := R)
    (M := integralClosure R (Localization.Away (algebraMap C R p)))
  obtain ⟨⟨_, N, rfl⟩, hN⟩ := IsLocalization.exist_integer_multiples_of_finite
    (Submonoid.powers (algebraMap C R p)) (fun i => (σ i : Localization.Away (algebraMap C R p)))
  have hN' : ∀ i, ∃ x : R, algebraMap R (Localization.Away (algebraMap C R p)) x =
      algebraMap C R p ^ N • (σ i : Localization.Away (algebraMap C R p)) :=
    fun i => RingHom.mem_rangeS.mp (hN i)
  choose x hx using hN'
  have hx' : ∀ i, algebraMap R (Localization.Away (algebraMap C R p)) (x i) =
      algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R p) ^ N *
        (σ i : Localization.Away (algebraMap C R p)) := by
    intro i
    rw [hx i, Algebra.smul_def, map_pow]

  choose c y hcy using fun i => hc N (x i)
  obtain ⟨μ, hμ⟩ := hunit.exists_right_inv
  set t : Fin r → B := fun i => algebraMap C B (c i) * μ ^ N with ht
  have hν : algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R p) * ψ μ = 1 := by
    rw [← hψ, ← map_mul, hμ, map_one]
  have htψ : ∀ i, ψ (t i) = (σ i : Localization.Away (algebraMap C R p)) -
      algebraMap R (Localization.Away (algebraMap C R p)) (y i) := by
    intro i
    have e0 := hx' i
    rw [hcy i, map_add, map_mul, map_pow] at e0
    have e1 : algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R (c i)) =
        algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R p) ^ N *
          ((σ i : Localization.Away (algebraMap C R p)) -
            algebraMap R (Localization.Away (algebraMap C R p)) (y i)) := by
      linear_combination e0
    rw [ht]
    simp only [map_mul, map_pow, hψ, e1]
    calc _ = (algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R p) * ψ μ) ^ N *
          ((σ i : Localization.Away (algebraMap C R p)) -
            algebraMap R (Localization.Away (algebraMap C R p)) (y i)) := by ring
      _ = _ := by rw [hν, one_pow, one_mul]

  have key : ∀ b : B, _root_.IsIntegral R (ψ b) →
      b ∈ Submodule.span C (insert 1 (Set.range t)) := by
    intro b hb'
    have hmemtop : (⟨ψ b, hb'⟩ : integralClosure R (Localization.Away (algebraMap C R p))) ∈
        Submodule.span R (Set.range σ) := by
      rw [hσ]; exact Submodule.mem_top
    obtain ⟨ρ, hρ⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hmemtop
    have e : ∑ i, algebraMap R (Localization.Away (algebraMap C R p)) (ρ i) *
        (σ i : Localization.Away (algebraMap C R p)) = ψ b := by
      have := congrArg Subtype.val hρ
      simpa [Algebra.smul_def] using this
    choose c' s hcs using fun i => hc N (ρ i)
    have e2 : ψ (b - ∑ i, algebraMap C B (c' i) * t i) =
        algebraMap R (Localization.Away (algebraMap C R p))
          (∑ i, (s i * x i + algebraMap C R (c' i) * y i)) := by
      rw [map_sub, map_sum, map_sum, ← e, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i _
      have hρ' : algebraMap R (Localization.Away (algebraMap C R p)) (ρ i) =
          algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R (c' i)) +
            algebraMap R (Localization.Away (algebraMap C R p)) (algebraMap C R p) ^ N *
              algebraMap R (Localization.Away (algebraMap C R p)) (s i) := by
        rw [hcs i, map_add, map_mul, map_pow]
      rw [map_mul, hψ, htψ i, map_add, map_mul, map_mul]
      linear_combination (σ i : Localization.Away (algebraMap C R p)) * hρ' -
        algebraMap R (Localization.Away (algebraMap C R p)) (s i) * hx' i
    obtain ⟨c0, hc0⟩ := hspade _ _ e2
    have hbeq : b = c0 • (1 : B) + ∑ i, c' i • t i := by
      rw [Algebra.smul_def, mul_one, ← hc0]
      simp only [Algebra.smul_def]
      ring
    rw [hbeq]
    refine Submodule.add_mem _
      (Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_insert _ _)))
      (Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _
        (Submodule.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))

  let Msub : Subalgebra C B :=
    { carrier := {b | _root_.IsIntegral R (ψ b)}
      mul_mem' := fun {a b} ha hb => by
        show _root_.IsIntegral R (ψ (a * b))
        rw [map_mul]; exact ha.mul hb
      add_mem' := fun {a b} ha hb => by
        show _root_.IsIntegral R (ψ (a + b))
        rw [map_add]; exact ha.add hb
      algebraMap_mem' := fun c => by
        show _root_.IsIntegral R (ψ (algebraMap C B c))
        rw [hψ]; exact isIntegral_algebraMap }
  have hMP : Subalgebra.toSubmodule Msub = Submodule.span C (insert 1 (Set.range t)) := by
    apply le_antisymm
    · intro b hb
      exact key b hb
    · rw [Submodule.span_le]
      rintro _ (rfl | ⟨i, rfl⟩)
      · exact Msub.one_mem
      · show _root_.IsIntegral R (ψ (t i))
        rw [htψ i]
        exact (σ i).2.sub isIntegral_algebraMap
  have hFG : (Subalgebra.toSubmodule Msub).FG := by
    rw [hMP]
    exact Submodule.fg_span ((Set.finite_range t).insert 1)
  have hcomp : (algebraMap R (Localization.Away (algebraMap C R p))).comp (algebraMap C R) =
      ψ.comp (algebraMap C B) := by
    ext c
    exact (hψ c).symm
  have hEq : integralClosure C B = Msub := by
    apply le_antisymm
    · intro b hb
      exact _root_.IsIntegral.map_of_comp_eq (algebraMap C R) ψ hcomp hb
    · intro b hb
      exact _root_.IsIntegral.of_mem_of_fg Msub hFG b hb
  have hFG' : (Subalgebra.toSubmodule (integralClosure C B)).FG := by
    rw [hEq]; exact hFG
  exact Module.Finite.iff_fg.mpr hFG'

theorem wcpa_dj_lr1s_nf_cnf_finite_tate_model : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (C : Type u) [CommRing C] [Algebra ↥W C], Algebra.FiniteType ↥W C → (∀ x : C, algebraMap (↥W) C ϖ * x = 0 → x = 0) → ∃ (d : ℕ) (φ : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W) →+* AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C), φ.Finite ∧ φ (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ)) = algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ) :=
by
  intro Ω _ W _ ϖ _ _ C _ _ hC _
  classical

  have s0 : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x : AdicCompletion I R) (m n : ℕ)
      (h : m ≤ n), Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) =
        AdicCompletion.evalₐ I m x := by
    intro R _ I x m n h
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I R x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    show Ideal.Quotient.factor _ (Ideal.Quotient.mk _ _) = _
    rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk h c
    rw [Submodule.Quotient.eq] at hc
    rw [Ideal.smul_eq_mul, Ideal.mul_top] at hc
    exact hc

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (r : R) (s : S), ψ r = s →
      ∃ Ψ : AdicCompletion (Ideal.span {r}) R →+* AdicCompletion (Ideal.span {s}) S,
        ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
          AdicCompletion.evalₐ (Ideal.span {r}) n x = Ideal.Quotient.mk (Ideal.span {r} ^ n) a →
          AdicCompletion.evalₐ (Ideal.span {s}) n (Ψ x) =
            Ideal.Quotient.mk (Ideal.span {s} ^ n) (ψ a) := by
    intro R S _ _ ψ r s hrs
    have hle : ∀ k : ℕ, Ideal.span {r} ^ k ≤ Ideal.comap ψ (Ideal.span {s} ^ k) := by
      intro k
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow, Ideal.map_span, Set.image_singleton, hrs]
    let f : ∀ k : ℕ, AdicCompletion (Ideal.span {r}) R →+* S ⧸ Ideal.span {s} ^ k := fun k =>
      (Ideal.quotientMap (Ideal.span {s} ^ k) ψ (hle k)).comp
        (AdicCompletion.evalₐ (Ideal.span {r}) k :
          AdicCompletion (Ideal.span {r}) R →+* R ⧸ Ideal.span {r} ^ k)
    have hfv : ∀ (k : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
        AdicCompletion.evalₐ (Ideal.span {r}) k x = Ideal.Quotient.mk (Ideal.span {r} ^ k) a →
        f k x = Ideal.Quotient.mk (Ideal.span {s} ^ k) (ψ a) := by
      intro k x a ha
      show Ideal.quotientMap (Ideal.span {s} ^ k) ψ (hle k)
        (AdicCompletion.evalₐ (Ideal.span {r}) k x) = _
      rw [ha, Ideal.quotientMap_mk]
    have hf : ∀ {m n : ℕ} (h : m ≤ n),
        (Ideal.Quotient.factorPow (Ideal.span {s}) h).comp (f n) = f m := by
      intro m n h
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (Ideal.span {r}) n x)
      have ham : AdicCompletion.evalₐ (Ideal.span {r}) m x =
          Ideal.Quotient.mk (Ideal.span {r} ^ m) a := by
        rw [← s0 R _ x m n h, ← ha]
        rfl
      rw [RingHom.comp_apply, hfv n x a ha.symm, hfv m x a ham]
      rfl
    refine ⟨AdicCompletion.liftRingHom (Ideal.span {s}) f hf, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hfv n x a ha

  have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (r : R) (s : S), ψ r = s →
      Function.Surjective ψ →
      ∀ Ψ : AdicCompletion (Ideal.span {r}) R →+* AdicCompletion (Ideal.span {s}) S,
        (∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
          AdicCompletion.evalₐ (Ideal.span {r}) n x = Ideal.Quotient.mk (Ideal.span {r} ^ n) a →
          AdicCompletion.evalₐ (Ideal.span {s}) n (Ψ x) =
            Ideal.Quotient.mk (Ideal.span {s} ^ n) (ψ a)) → Function.Surjective Ψ := by
    intro R S _ _ ψ r s hrs hψ Ψ hΨ y
    have hb : ∀ k : ℕ, ∃ b : S, AdicCompletion.evalₐ (Ideal.span {s}) k y =
        Ideal.Quotient.mk (Ideal.span {s} ^ k) b := fun k =>
      (Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (Ideal.span {s}) k y)).imp
        fun b hb => hb.symm
    choose b hb using hb
    have hbc : ∀ k : ℕ, b (k + 1) - b k ∈ Ideal.span {s} ^ k := by
      intro k
      rw [← Ideal.Quotient.eq]
      have h0 := s0 S (Ideal.span {s}) y k (k + 1) (Nat.le_succ k)
      rw [hb, hb] at h0
      rw [← h0]
      rfl
    have step : ∀ (k : ℕ) (a : R), ψ a - b k ∈ Ideal.span {s} ^ k →
        ∃ a' : R, a' - a ∈ Ideal.span {r} ^ k ∧ ψ a' - b (k + 1) ∈ Ideal.span {s} ^ (k + 1) := by
      intro k a ha
      have h1 : b (k + 1) - ψ a ∈ Ideal.span {s} ^ k := by
        have h2 := Ideal.sub_mem _ (hbc k) ha
        have e : b (k + 1) - b k - (ψ a - b k) = b (k + 1) - ψ a := by ring
        rw [e] at h2
        exact h2
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h1
      obtain ⟨c, hc⟩ := h1
      obtain ⟨c', rfl⟩ := hψ c
      refine ⟨a + c' * r ^ k, ?_, ?_⟩
      · rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
        exact ⟨c', by ring⟩
      · have e : ψ (a + c' * r ^ k) - b (k + 1) = 0 := by
          rw [map_add, map_mul, map_pow, hrs, hc]
          ring
        rw [e]
        exact Ideal.zero_mem _
    choose g hg1 hg2 using step
    let A : ∀ k : ℕ, {a : R // ψ a - b k ∈ Ideal.span {s} ^ k} := fun k =>
      Nat.rec (motive := fun k => {a : R // ψ a - b k ∈ Ideal.span {s} ^ k})
        ⟨0, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top⟩
        (fun k p => ⟨g k p.1 p.2, hg2 k p.1 p.2⟩) k
    have hA : ∀ k : ℕ, (A (k + 1)).1 - (A k).1 ∈ Ideal.span {r} ^ k := fun k =>
      hg1 k (A k).1 (A k).2
    have hcau : ∀ n : ℕ, (fun k => (A k).1) n ≡ (fun k => (A k).1) (n + 1)
        [SMOD (Ideal.span {r} ^ n • ⊤ : Submodule R R)] := by
      intro n
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, ← neg_sub]
      exact neg_mem (hA n)
    refine ⟨AdicCompletion.mk (Ideal.span {r}) R
      (AdicCompletion.AdicCauchySequence.mk (Ideal.span {r}) R (fun k => (A k).1) hcau), ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [hΨ k _ (A k).1 (by rw [AdicCompletion.evalₐ_mk]; rfl), hb k, Ideal.Quotient.eq]
    exact (A k).2

  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hC
  have hψr : (f : MvPolynomial (Fin n) ↥W →+* C) (MvPolynomial.C ϖ) = algebraMap (↥W) C ϖ := by
    show f (MvPolynomial.C ϖ) = _
    rw [← MvPolynomial.algebraMap_eq]
    exact f.commutes ϖ
  obtain ⟨Ψ, hΨ⟩ := s2 _ _ (f : MvPolynomial (Fin n) ↥W →+* C) _ _ hψr
  have hsurj := s3 _ _ _ _ _ hψr (fun c => hf c) Ψ hΨ
  refine ⟨n, Ψ, RingHom.Finite.of_surjective Ψ hsurj, ?_⟩
  apply AdicCompletion.ext_evalₐ
  intro k
  rw [hΨ k _ (MvPolynomial.C ϖ) ?_, hψr]
  · rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
    rfl
  · rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
    rfl

theorem wcpa_dj_lr1s_nf_cnf_adic_series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) :=
by
  intro R _ r
  have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
    AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
  have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
      x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
      ∃ y : AdicCompletion (Ideal.span {r}) R,
        x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
    intro n x
    constructor
    · intro hx
      refine Submodule.smul_induction_on hx ?_ ?_
      · intro a ha m _
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
        obtain ⟨c, rfl⟩ := ha
        refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
        rw [Algebra.smul_def, map_mul, map_pow]
        ring
      · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
        exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
    · rintro ⟨y, rfl⟩
      rw [← map_pow, ← Algebra.smul_def]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
        Submodule.mem_top
  refine ⟨fun f hf => ?_, fun x hx => ?_⟩
  · choose y hy using hf
    have s4 : ∀ m n : ℕ, m ≤ n →
        f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
      intro m n hmn
      induction n, hmn using Nat.le_induction with
      | base => rw [sub_self]; exact Submodule.zero_mem _
      | succ n hmn ih =>
        rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
        refine Submodule.add_mem _ ?_ ih
        have h1 : f (n + 1) - f n ∈
            (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
          (s1 n _).mpr ⟨y n, hy n⟩
        exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
    obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
      rw [SModEq.sub_mem, ← neg_sub]
      exact Submodule.neg_mem _ (s4 m n hmn))
    refine ⟨L, fun n => (s1 n _).mp ?_⟩
    have h := SModEq.sub_mem.mp (hL n)
    rw [← neg_sub]
    exact Submodule.neg_mem _ h
  · refine hc.toIsHausdorff.haus x (fun k => ?_)
    rw [SModEq.sub_mem, sub_zero]
    exact (s1 k x).mpr (hx k)

theorem wcpa_dj_lr1s_ncgr_cn_approx_division : ∀ (T T' : Type u) [CommRing T] [CommRing T'] (ι : T →+* T') (p : T) (p' : T'), ι p = p' → (∀ f : ℕ → T, (∀ n : ℕ, ∃ y : T, f (n + 1) - f n = p ^ n * y) → ∃ L : T, ∀ n : ℕ, ∃ y : T, L - f n = p ^ n * y) → (∀ f : ℕ → T', (∀ n : ℕ, ∃ y : T', f (n + 1) - f n = p' ^ n * y) → ∃ L : T', ∀ n : ℕ, ∃ y : T', L - f n = p' ^ n * y) → (∀ x : T', (∀ k : ℕ, ∃ y : T', x = p' ^ k * y) → x = 0) → ∀ (s : ℕ) (Y : Fin s → T') (Q E : T') (b c w : T) (k : ℕ), b * c = p → b ^ (k + 1) = p * w → (∀ z : T', ∃ (q : T') (t : Fin s → T) (z' : T'), z = q * Q + ∑ j, ι (t j) * Y j + p' * z') → ∀ z : T', ∃ (q : T') (t : Fin s → T), z = q * (Q + ι b * E) + ∑ j, ι (t j) * Y j :=
by
  intro T T' _ _ ι p p' hp hCplT hCplT' hSep s Y Q E b c w k hbc hbw hH
  have hpp : p' = ι b * ι c := by rw [← hp, ← hbc, map_mul]

  have hmod : ∀ z : T', ∃ (q : T') (t : Fin s → T) (z' : T'),
      z = q * (Q + ι b * E) + ∑ j, ι (t j) * Y j + p' * z' := by
    intro z
    have inv : ∀ m : ℕ, ∃ (q : T') (t : Fin s → T) (z' : T'),
        z = q * (Q + ι b * E) + ∑ j, ι (t j) * Y j + ι b ^ m * z' := by
      intro m
      induction m with
      | zero => exact ⟨0, fun _ => 0, z, by simp⟩
      | succ m ih =>
        obtain ⟨q, t, z', hz⟩ := ih
        obtain ⟨q₁, t₁, z₂, hz'⟩ := hH z'
        refine ⟨q + ι b ^ m * q₁, fun j => t j + b ^ m * t₁ j, ι c * z₂ - q₁ * E, ?_⟩
        have hsum : ∑ j, ι (t j + b ^ m * t₁ j) * Y j =
            ∑ j, ι (t j) * Y j + ι b ^ m * ∑ j, ι (t₁ j) * Y j := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [map_add, map_mul, map_pow]; ring
        beta_reduce
        rw [hsum]
        rw [hpp] at hz'
        linear_combination hz + ι b ^ m * hz'
    obtain ⟨q, t, z', hz⟩ := inv (k + 1)
    refine ⟨q, t, ι w * z', ?_⟩
    have hb : ι b ^ (k + 1) = p' * ι w := by rw [← map_pow, hbw, map_mul, hp]
    rw [hb] at hz
    linear_combination hz
  generalize Q + ι b * E = G at hmod ⊢

  intro z
  choose Φq Φt Φz hΦ using hmod
  let zs : ℕ → T' := fun n => Φz^[n] z
  have hzs : ∀ n, zs (n + 1) = Φz (zs n) := fun n => Function.iterate_succ_apply' Φz n z
  let Sq : ℕ → T' := fun n => ∑ i ∈ Finset.range n, p' ^ i * Φq (zs i)
  let St : ℕ → Fin s → T := fun n j => ∑ i ∈ Finset.range n, p ^ i * Φt (zs i) j
  have hinv : ∀ n, z = Sq n * G + ∑ j, ι (St n j) * Y j + p' ^ n * zs n := by
    intro n
    induction n with
    | zero => simp [Sq, St, zs]
    | succ n ih =>
      have h1 := hΦ (zs n)
      have hSq : Sq (n + 1) = Sq n + p' ^ n * Φq (zs n) := Finset.sum_range_succ _ _
      have hSt : ∑ j, ι (St (n + 1) j) * Y j =
          ∑ j, ι (St n j) * Y j + p' ^ n * ∑ j, ι (Φt (zs n) j) * Y j := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp only [St, Finset.sum_range_succ, map_add, map_mul, map_pow, hp]
        ring
      rw [hSq, hSt, hzs]
      linear_combination ih + p' ^ n * h1
  obtain ⟨Lq, hLq⟩ := hCplT' Sq (fun n => ⟨Φq (zs n), by
    simp only [Sq, Finset.sum_range_succ]; ring⟩)
  have hLt : ∀ j, ∃ L : T, ∀ n, ∃ y : T, L - St n j = p ^ n * y := fun j =>
    hCplT (fun n => St n j) (fun n => ⟨Φt (zs n) j, by
      simp only [St, Finset.sum_range_succ]; ring⟩)
  choose Lt hLt using hLt
  choose yq hyq using hLq
  choose yt hyt using hLt
  refine ⟨Lq, Lt, ?_⟩
  have hD : z - (Lq * G + ∑ j, ι (Lt j) * Y j) = 0 := by
    apply hSep
    intro n
    refine ⟨zs n - yq n * G - ∑ j, ι (yt j n) * Y j, ?_⟩
    have e := hinv n
    have hq := hyq n
    have ht : ∑ j, ι (Lt j) * Y j =
        ∑ j, ι (St n j) * Y j + p' ^ n * ∑ j, ι (yt j n) * Y j := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have h := hyt j n
      rw [show Lt j = St n j + p ^ n * yt j n by linear_combination h, map_add, map_mul,
        map_pow, hp]
      ring
    rw [ht]
    linear_combination e - G * hq
  linear_combination hD

theorem wcpa_dj_lr1s_ncgr_cn_kronecker : ∀ (R : Type u) [CommRing R] (n : ℕ) (Q : MvPolynomial (Fin (n + 1)) R), Q ≠ 0 → (∀ ν, Q.coeff ν ≠ 0 → IsUnit (Q.coeff ν)) → ∃ σ : MvPolynomial (Fin (n + 1)) R ≃ₐ[R] MvPolynomial (Fin (n + 1)) R, IsUnit ((MvPolynomial.finSuccEquiv R n (σ Q)).leadingCoeff) :=
by
  intro R _ n Q hQ0 hQu
  classical

  have K1 : ∀ (D m : ℕ) (a b : Fin m → ℕ), (∀ i, a i < D) → (∀ i, b i < D) →
      ∑ i, a i * D ^ (i : ℕ) = ∑ i, b i * D ^ (i : ℕ) → a = b := by
    intro D m
    induction m with
    | zero => intro a b _ _ _; funext i; exact Fin.elim0 i
    | succ m ih =>
      intro a b ha hb h
      have hD : 0 < D := lt_of_le_of_lt (Nat.zero_le _) (ha 0)
      have e : ∀ c : Fin (m + 1) → ℕ, ∑ i : Fin (m + 1), c i * D ^ (i : ℕ) =
          c 0 + D * ∑ i : Fin m, c i.succ * D ^ (i : ℕ) := by
        intro c
        rw [Fin.sum_univ_succ, Finset.mul_sum]
        congr 1
        · simp
        · refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Fin.val_succ, pow_succ]; ring
      rw [e a, e b] at h
      have h0 : a 0 = b 0 := by
        have := congrArg (· % D) h
        simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (ha 0), Nat.mod_eq_of_lt (hb 0)] at this
        exact this
      have h1 : ∑ i : Fin m, a i.succ * D ^ (i : ℕ) = ∑ i : Fin m, b i.succ * D ^ (i : ℕ) := by
        rw [h0] at h
        exact Nat.eq_of_mul_eq_mul_left hD (Nat.add_left_cancel h)
      have h2 := ih (fun i => a i.succ) (fun i => b i.succ) (fun i => ha _) (fun i => hb _) h1
      funext i
      exact Fin.cases h0 (fun j => congrFun h2 j) i

  have K4 : ∀ (A : Type u) [CommRing A] [Nontrivial A] (ι : Type) (S : Finset ι) (c : ι → A)
      (P : ι → Polynomial A) (d : ι → ℕ), S.Nonempty → (∀ i ∈ S, IsUnit (c i)) →
      (∀ i ∈ S, (P i).Monic ∧ (P i).natDegree = d i) → Set.InjOn d ↑S →
      IsUnit (∑ i ∈ S, Polynomial.C (c i) * P i).leadingCoeff := by
    intro A _ _ ι S c P d hS hc hP hd
    obtain ⟨j, hj, hjmax⟩ := Finset.exists_max_image S d hS
    rw [← Finset.add_sum_erase S _ hj, add_comm]
    have htop : (Polynomial.C (c j) * P j).degree = (d j : WithBot ℕ) := by
      rw [Polynomial.degree_C_mul_of_isUnit (hc j hj),
        Polynomial.degree_eq_natDegree (hP j hj).1.ne_zero, (hP j hj).2]
    have hrest : (∑ i ∈ S.erase j, Polynomial.C (c i) * P i).degree <
        (Polynomial.C (c j) * P j).degree := by
      rw [htop]
      refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
      rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
      intro i hi
      have hij : i ≠ j := Finset.ne_of_mem_erase hi
      have hiS : i ∈ S := Finset.mem_of_mem_erase hi
      rw [Polynomial.degree_C_mul_of_isUnit (hc i hiS),
        Polynomial.degree_eq_natDegree (hP i hiS).1.ne_zero, (hP i hiS).2]
      have hne : d i ≠ d j := fun h => hij (hd hiS hj h)
      exact_mod_cast lt_of_le_of_ne (hjmax i hiS) hne
    rw [Polynomial.leadingCoeff_add_of_degree_lt hrest,
      Polynomial.leadingCoeff_mul_monic (hP j hj).1, Polynomial.leadingCoeff_C]
    exact hc j hj

  have hnt : Nontrivial R := by
    obtain ⟨ν₀, hν₀⟩ := MvPolynomial.ne_zero_iff.mp hQ0
    exact nontrivial_of_ne _ _ hν₀
  set D := Q.totalDegree + 1 with hDdef
  have hb : ∀ ν ∈ Q.support, ∀ i, ν i < D := fun ν hν i =>
    Nat.lt_succ_of_le ((MvPolynomial.monomial_le_degreeOf i hν).trans
      (MvPolynomial.degreeOf_le_totalDegree Q i))

  let t : Fin (n + 1) → MvPolynomial (Fin (n + 1)) R :=
    fun i => if i = 0 then 0 else MvPolynomial.X 0 ^ (D ^ (i : ℕ))
  let f : MvPolynomial (Fin (n + 1)) R →ₐ[R] MvPolynomial (Fin (n + 1)) R :=
    MvPolynomial.aeval (fun i => MvPolynomial.X i + t i)
  let g : MvPolynomial (Fin (n + 1)) R →ₐ[R] MvPolynomial (Fin (n + 1)) R :=
    MvPolynomial.aeval (fun i => MvPolynomial.X i - t i)
  have hfX : ∀ i, f (MvPolynomial.X i) = MvPolynomial.X i + t i := fun i => MvPolynomial.aeval_X _ _
  have hgX : ∀ i, g (MvPolynomial.X i) = MvPolynomial.X i - t i := fun i => MvPolynomial.aeval_X _ _
  have ht0 : t 0 = 0 := by simp [t]
  have hft : ∀ i, f (t i) = t i := by
    intro i
    by_cases hi : i = 0
    · simp only [t, hi, ite_true, map_zero]
    · simp only [t, hi, ite_false, map_pow]
      rw [hfX, ht0, add_zero]
  have hgt : ∀ i, g (t i) = t i := by
    intro i
    by_cases hi : i = 0
    · simp only [t, hi, ite_true, map_zero]
    · simp only [t, hi, ite_false, map_pow]
      rw [hgX, ht0, sub_zero]
  have hfg : f.comp g = AlgHom.id R _ := by
    apply MvPolynomial.algHom_ext
    intro i
    show f (g (MvPolynomial.X i)) = MvPolynomial.X i
    rw [hgX, map_sub, hfX, hft]; ring
  have hgf : g.comp f = AlgHom.id R _ := by
    apply MvPolynomial.algHom_ext
    intro i
    show g (f (MvPolynomial.X i)) = MvPolynomial.X i
    rw [hfX, map_add, hgX, hgt]; ring
  let σ := AlgEquiv.ofAlgHom f g hfg hgf
  have hσX : ∀ i, σ (MvPolynomial.X i) = MvPolynomial.X i + t i := hfX
  have K2 : ∀ i : Fin (n + 1), (MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.X i))).Monic ∧
      (MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.X i))).natDegree = D ^ (i : ℕ) := by
    intro i
    induction i using Fin.cases with
    | zero =>
      rw [hσX, ht0, add_zero, MvPolynomial.finSuccEquiv_X_zero]
      exact ⟨Polynomial.monic_X, by simp⟩
    | succ j =>
      have htj : t j.succ = MvPolynomial.X 0 ^ (D ^ (j.succ : ℕ)) := by
        simp [t, Fin.succ_ne_zero]
      rw [hσX, htj, map_add, map_pow, MvPolynomial.finSuccEquiv_X_zero,
        MvPolynomial.finSuccEquiv_X_succ, add_comm]
      have hne : D ^ (j.succ : ℕ) ≠ 0 := pow_ne_zero _ (Nat.succ_ne_zero _)
      exact ⟨Polynomial.monic_X_pow_add_C _ hne, Polynomial.natDegree_X_pow_add_C⟩

  have K3 : ∀ (ν : Fin (n + 1) →₀ ℕ) (c : R),
      MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.monomial ν c)) =
        Polynomial.C (MvPolynomial.C c) *
          ∏ i, MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.X i)) ^ ν i := by
    intro ν c
    have hC : MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.C c)) =
        Polynomial.C (MvPolynomial.C c) := by
      rw [← MvPolynomial.algebraMap_eq, AlgEquiv.commutes, AlgEquiv.commutes,
        Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
    rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun i => pow_zero _), map_mul,
      map_mul, hC, map_prod, map_prod]
    simp only [map_pow]
  have K3' : ∀ ν : Fin (n + 1) →₀ ℕ,
      (∏ i, MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.X i)) ^ ν i).Monic ∧
      (∏ i, MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.X i)) ^ ν i).natDegree =
        ∑ i, ν i * D ^ (i : ℕ) := by
    intro ν
    refine ⟨Polynomial.monic_prod_of_monic _ _ (fun i _ => (K2 i).1.pow _), ?_⟩
    rw [Polynomial.natDegree_prod_of_monic _ _ (fun i _ => (K2 i).1.pow _)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [(K2 i).1.natDegree_pow, (K2 i).2]
  refine ⟨σ, ?_⟩
  have hQsum : MvPolynomial.finSuccEquiv R n (σ Q) = ∑ ν ∈ Q.support,
      Polynomial.C (MvPolynomial.C (Q.coeff ν)) *
        ∏ i, MvPolynomial.finSuccEquiv R n (σ (MvPolynomial.X i)) ^ ν i := by
    conv_lhs => rw [MvPolynomial.as_sum Q]
    rw [map_sum, map_sum]
    exact Finset.sum_congr rfl (fun ν _ => K3 ν _)
  rw [hQsum]
  refine K4 (MvPolynomial (Fin n) R) (Fin (n + 1) →₀ ℕ) Q.support _ _
    (fun ν => ∑ i, ν i * D ^ (i : ℕ)) ?_ ?_ ?_ ?_
  · exact Finset.nonempty_iff_ne_empty.mpr (fun h => hQ0 (MvPolynomial.support_eq_empty.mp h))
  · intro ν hν
    exact (hQu ν (MvPolynomial.mem_support_iff.mp hν)).map MvPolynomial.C
  · intro ν _
    exact K3' ν
  · intro ν hν μ hμ h
    exact DFunLike.coe_injective (K1 D (n + 1) ⇑ν ⇑μ (hb ν hν) (hb μ hμ) h)

theorem wcpa_dj_lr1s_ncgr_cn_poly_division : ∀ (R : Type u) [CommRing R] (n : ℕ) (Q : MvPolynomial (Fin (n + 1)) R) (σ : MvPolynomial (Fin (n + 1)) R ≃ₐ[R] MvPolynomial (Fin (n + 1)) R), IsUnit ((MvPolynomial.finSuccEquiv R n (σ Q)).leadingCoeff) → ∃ (ψ : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n + 1)) R) (s : ℕ) (Y : Fin s → MvPolynomial (Fin (n + 1)) R), ∀ a : MvPolynomial (Fin (n + 1)) R, ∃ (q : MvPolynomial (Fin (n + 1)) R) (c : Fin s → MvPolynomial (Fin n) R), a = q * Q + ∑ j, ψ (c j) * Y j :=
by
  intro R _ n Q σ h
  classical
  set E : MvPolynomial (Fin (n + 1)) R ≃ₐ[R] Polynomial (MvPolynomial (Fin n) R) :=
    σ.trans (MvPolynomial.finSuccEquiv R n) with hE
  have hEQ : E Q = MvPolynomial.finSuccEquiv R n (σ Q) := rfl
  set P := MvPolynomial.finSuccEquiv R n (σ Q) with hP
  set v : MvPolynomial (Fin n) R := ((h.unit⁻¹ : (MvPolynomial (Fin n) R)ˣ) : MvPolynomial (Fin n) R)
    with hv
  set g : Polynomial (MvPolynomial (Fin n) R) := Polynomial.C v * P with hg
  have hgm : g.Monic := Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one h.val_inv_mul
  clear_value g v P E
  refine ⟨(E.symm : Polynomial (MvPolynomial (Fin n) R) →ₐ[R] MvPolynomial (Fin (n + 1)) R).comp
      Polynomial.CAlgHom, g.natDegree + 1,
    fun j => E.symm (Polynomial.X ^ (j : ℕ)), ?_⟩
  intro a
  refine ⟨E.symm (Polynomial.C v * (E a /ₘ g)), fun j => (E a %ₘ g).coeff j, ?_⟩
  apply E.injective
  have hr : E a %ₘ g = ∑ i ∈ Finset.range (g.natDegree + 1),
      Polynomial.C ((E a %ₘ g).coeff i) * Polynomial.X ^ i :=
    Polynomial.as_sum_range_C_mul_X_pow' _
      (Nat.lt_succ_of_le (Polynomial.natDegree_modByMonic_le _ hgm))
  have key : E (∑ j : Fin (g.natDegree + 1),
      ((E.symm : Polynomial (MvPolynomial (Fin n) R) →ₐ[R] MvPolynomial (Fin (n + 1)) R).comp
        Polynomial.CAlgHom) ((E a %ₘ g).coeff j) * E.symm (Polynomial.X ^ (j : ℕ))) =
      E a %ₘ g := by
    rw [map_sum]
    conv_rhs => rw [hr]
    rw [← Fin.sum_univ_eq_sum_range
      (fun i => Polynomial.C ((E a %ₘ g).coeff i) * Polynomial.X ^ i) (g.natDegree + 1)]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, AlgHom.comp_apply, Polynomial.CAlgHom_apply, AlgEquiv.coe_algHom,
      AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
  rw [map_add, key, map_mul, AlgEquiv.apply_symm_apply, hEQ]
  have hdiv : E a %ₘ g + g * (E a /ₘ g) = E a := Polynomial.modByMonic_add_div (E a) g
  generalize E a %ₘ g = r at hdiv ⊢
  generalize E a /ₘ g = t at hdiv ⊢
  rw [hg] at hdiv
  rw [← hdiv]
  ring

theorem wcpa_dj_lr1s_ncgr_cn_adic_normalize : ∀ (R : Type u) [CommRing R] (r : R), (∀ x : R, r * x = 0 → x = 0) → ∀ f : Localization.Away (algebraMap R (AdicCompletion (Ideal.span {r}) R) r), f ≠ 0 → ∃ (a : R) (y : AdicCompletion (Ideal.span {r}) R) (v : Localization.Away (algebraMap R (AdicCompletion (Ideal.span {r}) R) r)), ¬ (r ∣ a) ∧ algebraMap (AdicCompletion (Ideal.span {r}) R) (Localization.Away (algebraMap R (AdicCompletion (Ideal.span {r}) R) r)) (algebraMap R (AdicCompletion (Ideal.span {r}) R) a + algebraMap R (AdicCompletion (Ideal.span {r}) R) r * y) = v * f :=
by
  intro R _ r hr f hf
  classical
  obtain ⟨n, z, hz⟩ := IsLocalization.Away.surj (algebraMap R (AdicCompletion (Ideal.span {r}) R) r) f
  have hu : IsUnit (algebraMap (AdicCompletion (Ideal.span {r}) R)
      (Localization.Away (algebraMap R (AdicCompletion (Ideal.span {r}) R) r))
      (algebraMap R (AdicCompletion (Ideal.span {r}) R) r)) :=
    IsLocalization.Away.algebraMap_isUnit _
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [map_zero] at hz
    exact hf ((IsUnit.mul_left_eq_zero (hu.pow n)).mp hz)

  have hsep : ∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R,
      x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0 := by
    intro x hx
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    refine hc.toIsHausdorff.haus x (fun k => ?_)
    rw [SModEq.sub_mem, sub_zero]
    obtain ⟨y, rfl⟩ := hx k
    rw [← map_pow, ← Algebra.smul_def]
    exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) k)
      Submodule.mem_top

  have happrox : ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {r}) R), ∃ (c : R)
      (y' : AdicCompletion (Ideal.span {r}) R), y = algebraMap R (AdicCompletion (Ideal.span {r}) R) c +
        algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y' := by
    have hev : ∀ (k : ℕ) (c : R), AdicCompletion.evalₐ (Ideal.span {r}) k
        (algebraMap R (AdicCompletion (Ideal.span {r}) R) c) =
        Ideal.Quotient.mk (Ideal.span {r} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : R), Ideal.Quotient.mk (Ideal.span {r} ^ k) x = 0 ↔ r ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {r}) R) (m k : ℕ), m ≤ k →
        r ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {r}) hmk a
    have hN : ∀ (n : ℕ) (x : R), r ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hr
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : R), r ^ n * u = r ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    intro n y
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {r}) R y
    have hex : ∀ k : ℕ, ∃ b : R, a (k + n) - a n = r ^ n * b :=
      fun k => hD a n (k + n) (by omega)
    choose b hb using hex
    have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {r} ^ k • ⊤ : Submodule R R)] := by
      intro k
      rw [SModEq.sub_mem]
      obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
      have e : b k - b (k + 1) = r ^ k * (-s) := by
        apply hNc n
        linear_combination (-1 : R) * hb k + hb (k + 1) - hs
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) k)
        Submodule.mem_top
    let B : AdicCompletion.AdicCauchySequence (Ideal.span {r}) R :=
      AdicCompletion.AdicCauchySequence.mk (Ideal.span {r}) R b hB
    have hBk : ∀ k, B k = b k := fun k => rfl
    refine ⟨a n, AdicCompletion.mk (Ideal.span {r}) R B, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
    obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
    exact ⟨-s, by linear_combination hb k - hs⟩
  have hex : ∃ k : ℕ, ¬ ∃ y : AdicCompletion (Ideal.span {r}) R,
      z = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y := by
    by_contra h
    push_neg at h
    exact hz0 (hsep z h)
  have hK0 : Nat.find hex ≠ 0 := by
    intro h0
    have hs := Nat.find_spec hex
    rw [h0] at hs
    exact hs ⟨z, by rw [pow_zero, one_mul]⟩
  obtain ⟨m, hm⟩ : ∃ m : ℕ, Nat.find hex = m + 1 := ⟨Nat.find hex - 1, by omega⟩
  have hmin : ¬ ¬ ∃ y : AdicCompletion (Ideal.span {r}) R,
      z = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ m * y :=
    Nat.find_min hex (by omega)
  obtain ⟨z', hz'⟩ := not_not.mp hmin
  have hz'np : ¬ ∃ w : AdicCompletion (Ideal.span {r}) R,
      z' = algebraMap R (AdicCompletion (Ideal.span {r}) R) r * w := by
    rintro ⟨w, hw⟩
    have hs := Nat.find_spec hex
    rw [hm] at hs
    exact hs ⟨w, by rw [hz', hw, pow_succ, mul_assoc]⟩
  obtain ⟨a, y, hay⟩ := happrox 1 z'
  rw [pow_one] at hay
  refine ⟨a, y, (↑hu.unit⁻¹) ^ m * (algebraMap (AdicCompletion (Ideal.span {r}) R)
      (Localization.Away (algebraMap R (AdicCompletion (Ideal.span {r}) R) r))
      (algebraMap R (AdicCompletion (Ideal.span {r}) R) r)) ^ n, ?_, ?_⟩
  · rintro ⟨c, rfl⟩
    exact hz'np ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c + y,
      by rw [hay, map_mul, mul_add]⟩
  · rw [← hay, mul_assoc, mul_comm (_ ^ n) f, hz, hz', map_mul, map_pow, ← mul_assoc,
      ← mul_pow, hu.val_inv_mul, one_pow, one_mul]

theorem wcpa_dj_lr1s_ncgr_cn_content_split : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (n : ℕ) (a : MvPolynomial (Fin n) ↥W) (π : ↥W), ¬ (MvPolynomial.C π ∣ a) → ∃ (c b e : ↥W) (Q M : MvPolynomial (Fin n) ↥W), π = c * b * e ∧ ¬ IsUnit b ∧ Q ≠ 0 ∧ (∀ ν, Q.coeff ν ≠ 0 → IsUnit (Q.coeff ν)) ∧ a = MvPolynomial.C c * (Q + MvPolynomial.C b * M) :=
by
  intro Ω _ W n a π h
  classical
  have s1 : ∀ (s : Finset (Fin n →₀ ℕ)) (f : (Fin n →₀ ℕ) → ↥W) (t : ↥W),
      ∃ b : ↥W, (b = t ∨ ∃ i ∈ s, b = f i) ∧ b ∣ t ∧ ∀ i ∈ s, b ∣ f i := by
    intro s f t
    induction s using Finset.induction_on with
    | empty => exact ⟨t, Or.inl rfl, dvd_refl t, fun i hi => by simp at hi⟩
    | insert j s' hj ih =>
      obtain ⟨b', hb'mem, hb't, hb'f⟩ := ih
      rcases ValuationRing.dvd_total b' (f j) with hd | hd
      · refine ⟨b', ?_, hb't, ?_⟩
        · rcases hb'mem with h1 | ⟨i, hi, h1⟩
          · exact Or.inl h1
          · exact Or.inr ⟨i, Finset.mem_insert_of_mem hi, h1⟩
        · intro i hi
          rcases Finset.mem_insert.mp hi with h1 | h1
          · obtain rfl := h1; exact hd
          · exact hb'f i h1
      · refine ⟨f j, Or.inr ⟨j, Finset.mem_insert_self j s', rfl⟩, dvd_trans hd hb't, ?_⟩
        intro i hi
        rcases Finset.mem_insert.mp hi with h1 | h1
        · obtain rfl := h1; exact dvd_refl _
        · exact dvd_trans hd (hb'f i h1)
  have ha0 : a ≠ 0 := fun h0 => h (h0 ▸ dvd_zero _)
  obtain ⟨ν₁, hν₁⟩ := MvPolynomial.ne_zero_iff.mp ha0
  obtain ⟨c, hcmem, -, hcdvd⟩ := s1 a.support a.coeff (a.coeff ν₁)
  obtain ⟨ν₀, hν₀s, hν₀⟩ : ∃ ν₀ ∈ a.support, c = a.coeff ν₀ := by
    rcases hcmem with h1 | h1
    · exact ⟨ν₁, MvPolynomial.mem_support_iff.mpr hν₁, h1⟩
    · exact h1
  have hc0 : c ≠ 0 := by rw [hν₀]; exact MvPolynomial.mem_support_iff.mp hν₀s
  have hcall : ∀ ν, c ∣ a.coeff ν := by
    intro ν
    by_cases hν : ν ∈ a.support
    · exact hcdvd ν hν
    · rw [MvPolynomial.notMem_support_iff.mp hν]; exact dvd_zero c
  obtain ⟨A, hA⟩ := (MvPolynomial.C_dvd_iff_dvd_coeff c a).mpr hcall
  have hAc : ∀ ν, a.coeff ν = c * A.coeff ν := by
    intro ν; rw [hA, MvPolynomial.coeff_C_mul]
  have hA1 : A.coeff ν₀ = 1 := by
    apply mul_left_cancel₀ hc0
    rw [← hAc, ← hν₀, mul_one]
  have hπc : ¬ π ∣ c := by
    intro hd
    exact h ((MvPolynomial.C_dvd_iff_dvd_coeff π a).mpr (fun ν => dvd_trans hd (hcall ν)))
  obtain ⟨t, ht⟩ : c ∣ π := (ValuationRing.dvd_total c π).resolve_right hπc
  have htu : ¬ IsUnit t := by
    rintro ⟨u, rfl⟩
    apply hπc
    exact ⟨↑u⁻¹, by rw [ht, mul_assoc, Units.mul_inv, mul_one]⟩
  obtain ⟨b, hbmem, hbt, hbdvd⟩ :=
    s1 (A.support.filter (fun ν => ¬ IsUnit (A.coeff ν))) A.coeff t
  have hbu : ¬ IsUnit b := by
    rcases hbmem with h1 | ⟨i, hi, h1⟩
    · rw [h1]; exact htu
    · rw [h1]; exact (Finset.mem_filter.mp hi).2
  obtain ⟨e, he⟩ := hbt
  have hbA : ∀ ν, ¬ IsUnit (A.coeff ν) → b ∣ A.coeff ν := by
    intro ν hν
    by_cases hs : ν ∈ A.support
    · exact hbdvd ν (Finset.mem_filter.mpr ⟨hs, hν⟩)
    · rw [MvPolynomial.notMem_support_iff.mp hs]; exact dvd_zero b
  obtain ⟨m, hm0, hm⟩ : ∃ m : (Fin n →₀ ℕ) → ↥W, (∀ ν, IsUnit (A.coeff ν) → m ν = 0) ∧
      (∀ ν, ¬ IsUnit (A.coeff ν) → A.coeff ν = b * m ν) := by
    refine ⟨fun ν => if hν : IsUnit (A.coeff ν) then 0 else Classical.choose (hbA ν hν), ?_, ?_⟩
    · intro ν hν
      simp only [dif_pos hν]
    · intro ν hν
      simp only [dif_neg hν]
      exact Classical.choose_spec (hbA ν hν)
  obtain ⟨M, hMdef⟩ : ∃ M : MvPolynomial (Fin n) ↥W,
      M = ∑ ν ∈ A.support, MvPolynomial.monomial ν (m ν) := ⟨_, rfl⟩
  have hMc : ∀ μ, M.coeff μ = if μ ∈ A.support then m μ else 0 := by
    intro μ
    rw [hMdef, MvPolynomial.coeff_sum]
    simp only [MvPolynomial.coeff_monomial]
    rw [Finset.sum_ite_eq']
  obtain ⟨Q, hQdef⟩ : ∃ Q : MvPolynomial (Fin n) ↥W, Q = A - MvPolynomial.C b * M := ⟨_, rfl⟩
  have hQc : ∀ μ, Q.coeff μ = if IsUnit (A.coeff μ) then A.coeff μ else 0 := by
    intro μ
    rw [hQdef, MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul, hMc]
    by_cases hu : IsUnit (A.coeff μ)
    · have hs : μ ∈ A.support := MvPolynomial.mem_support_iff.mpr hu.ne_zero
      rw [if_pos hs, if_pos hu, hm0 μ hu, mul_zero, sub_zero]
    · rw [if_neg hu]
      by_cases hs : μ ∈ A.support
      · rw [if_pos hs, ← hm μ hu, sub_self]
      · rw [if_neg hs, MvPolynomial.notMem_support_iff.mp hs, mul_zero, sub_zero]
  refine ⟨c, b, e, Q, M, ?_, hbu, ?_, ?_, ?_⟩
  · rw [ht, he, mul_assoc]
  · intro hQ0
    have h2 := hQc ν₀
    rw [hQ0, MvPolynomial.coeff_zero, hA1, if_pos isUnit_one] at h2
    exact zero_ne_one h2
  · intro ν hν
    rw [hQc ν] at hν ⊢
    by_cases hu : IsUnit (A.coeff ν)
    · rw [if_pos hu]; exact hu
    · rw [if_neg hu] at hν; exact absurd rfl hν
  · rw [hQdef, sub_add_cancel, hA]

theorem wcpa_dj_lr1s_ncgr_cn_noeth_criterion : ∀ (T T' : Type u) [CommRing T] [CommRing T'] (p : T) (p' : T'), IsNoetherianRing (Localization.Away p) → (∀ f : Localization.Away p', f ≠ 0 → ∃ (ι : T →+* T') (g : T') (v : Localization.Away p') (s : ℕ) (y : Fin s → T'), ι p = p' ∧ algebraMap T' (Localization.Away p') g = v * f ∧ ∀ z : T', ∃ (q : T') (t : Fin s → T), z = q * g + ∑ j, ι (t j) * y j) → IsNoetherianRing (Localization.Away p') :=
by
  intro T T' _ _ p p' hA H
  rw [isNoetherianRing_iff, isNoetherian_def]
  intro I
  by_cases hI : I = ⊥
  · rw [hI]; exact Submodule.fg_bot
  obtain ⟨f, hfI, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  obtain ⟨ι, g, v, s, y, hιp, hg, hdiv⟩ := H f hf0
  have hunit : IsUnit (((algebraMap T' (Localization.Away p')).comp ι) p) := by
    rw [RingHom.comp_apply, hιp]
    exact IsLocalization.Away.algebraMap_isUnit p'
  let φ : Localization.Away p →+* Localization.Away p' := IsLocalization.Away.lift p hunit
  have hφ : ∀ t : T, φ (algebraMap T (Localization.Away p) t) =
      algebraMap T' (Localization.Away p') (ι t) := fun t =>
    IsLocalization.Away.lift_eq p hunit t
  have hdec : ∀ x : Localization.Away p', ∃ (a : Localization.Away p')
      (c : Fin s → Localization.Away p), x = a * algebraMap T' (Localization.Away p') g +
        ∑ j, φ (c j) * algebraMap T' (Localization.Away p') (y j) := by
    intro x
    obtain ⟨n, z, hz⟩ := IsLocalization.Away.surj p' x
    obtain ⟨q, t, hzq⟩ := hdiv z
    obtain ⟨u, hu⟩ : ∃ u : Localization.Away p', algebraMap T' (Localization.Away p') p' * u = 1 :=
      ⟨_, IsLocalization.Away.mul_invSelf p'⟩
    obtain ⟨w, hw⟩ : ∃ w : Localization.Away p, algebraMap T (Localization.Away p) p * w = 1 :=
      ⟨_, IsLocalization.Away.mul_invSelf p⟩
    have hφw : φ w = u := by
      have h1 : algebraMap T' (Localization.Away p') p' * φ w = 1 := by
        have h0 := hφ p
        rw [hιp] at h0
        rw [← h0, ← map_mul, hw, map_one]
      calc φ w = (algebraMap T' (Localization.Away p') p' * u) * φ w := by rw [hu, one_mul]
        _ = u * (algebraMap T' (Localization.Away p') p' * φ w) := by ring
        _ = u := by rw [h1, mul_one]
    have hx : x = algebraMap T' (Localization.Away p') z * u ^ n := by
      rw [← hz, mul_assoc, ← mul_pow, hu, one_pow, mul_one]
    refine ⟨algebraMap T' (Localization.Away p') q * u ^ n,
      fun j => algebraMap T (Localization.Away p) (t j) * w ^ n, ?_⟩
    rw [hx, hzq, map_add, map_mul, map_sum, add_mul, Finset.sum_mul]
    congr 1
    · ring
    · refine Finset.sum_congr rfl (fun j _ => ?_)
      dsimp only
      rw [φ.map_mul, φ.map_pow, hφ, hφw]
      simp only [map_mul]
      ring
  letI : Algebra (Localization.Away p) (Localization.Away p') := φ.toAlgebra
  have hγI : algebraMap T' (Localization.Away p') g ∈ I := by
    rw [hg]; exact Ideal.mul_mem_left I v hfI
  let M : Submodule (Localization.Away p) (Localization.Away p') :=
    Submodule.span (Localization.Away p) (Set.range (fun j => algebraMap T' (Localization.Away p') (y j)))
  have hM : M.FG := Submodule.fg_span (Set.finite_range _)
  have hMN : IsNoetherian (Localization.Away p) M := isNoetherian_of_fg_of_noetherian M hM
  let N : Submodule (Localization.Away p) (Localization.Away p') :=
    I.restrictScalars (Localization.Away p) ⊓ M
  have hN : N.FG := isNoetherian_submodule.mp hMN N inf_le_right
  obtain ⟨S, hSfin, hS⟩ := Submodule.fg_def.mp hN
  rw [Submodule.fg_def]
  refine ⟨insert (algebraMap T' (Localization.Away p') g) S, hSfin.insert _, ?_⟩
  apply le_antisymm
  · rw [Submodule.span_le]
    intro x hx
    rcases hx with rfl | hx
    · exact hγI
    · have hxN : x ∈ N := by rw [← hS]; exact Submodule.subset_span hx
      exact (Submodule.restrictScalars_mem (Localization.Away p) I x).mp
        (Submodule.mem_inf.mp hxN).1
  · intro x hxI
    obtain ⟨a, c, hx⟩ := hdec x
    have hmM : ∑ j, φ (c j) * algebraMap T' (Localization.Away p') (y j) ∈ M := by
      refine Submodule.sum_mem _ (fun j _ => ?_)
      have e : φ (c j) * algebraMap T' (Localization.Away p') (y j) =
          c j • algebraMap T' (Localization.Away p') (y j) := by
        rw [Algebra.smul_def]; rfl
      rw [e]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    have hmI : ∑ j, φ (c j) * algebraMap T' (Localization.Away p') (y j) ∈ I := by
      have e : ∑ j, φ (c j) * algebraMap T' (Localization.Away p') (y j) =
          x - a * algebraMap T' (Localization.Away p') g := by rw [hx]; ring
      rw [e]
      exact I.sub_mem hxI (Ideal.mul_mem_left I a hγI)
    have hmN : ∑ j, φ (c j) * algebraMap T' (Localization.Away p') (y j) ∈ N :=
      Submodule.mem_inf.mpr ⟨hmI, hmM⟩
    rw [← hS] at hmN
    have hle : Submodule.span (Localization.Away p) S ≤
        (Submodule.span (Localization.Away p')
          (insert (algebraMap T' (Localization.Away p') g) S)).restrictScalars
          (Localization.Away p) := by
      rw [Submodule.span_le]
      intro m hm
      exact Submodule.subset_span (Set.mem_insert_of_mem _ hm)
    have h2 := hle hmN
    rw [hx]
    refine Submodule.add_mem _ ?_ h2
