        Polynomial.aeval x f = x ^ 2 - algebraMap B A β * x + algebraMap B A c := by
      intro A _ _ x
      rw [hfd]
      simp only [map_add, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, map_neg]
      ring
    have hevg : ∀ (A : Type u) [CommRing A] [Algebra B A] (x : A),
        Polynomial.aeval x (Polynomial.X * Polynomial.derivative f) =
          x * (2 * x - algebraMap B A β) := by
      intro A _ _ x
      rw [hder]
      simp only [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, map_neg, map_ofNat]
      ring
    have hX := (StandardEtalePair.hasMap_X (P := P))
    have h1 : Polynomial.aeval P.X f = 0 := hX.1
    have h2 : IsUnit (Polynomial.aeval P.X (Polynomial.X * Polynomial.derivative f)) := hX.2
