      AdicCompletion.evalₐ_of, Ideal.Quotient.lift_mk]
  have htf : ∀ x : MvPolynomial (Fin d) ↥W, MvPolynomial.C ϖ * x = 0 → x = 0 := by
    intro x hx
    exact (mul_eq_zero.mp hx).resolve_left (fun h0 => hϖ0 (MvPolynomial.C_eq_zero.mp h0))
  have hcont : ∀ y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
