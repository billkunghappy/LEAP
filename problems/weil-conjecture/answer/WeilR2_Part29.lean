    intro B _ β c Q _ hc hβ
    classical
    obtain ⟨f, hfd⟩ : ∃ f : Polynomial B, f = Polynomial.X ^ 2 +
        (Polynomial.C (-β) * Polynomial.X + Polynomial.C c) := ⟨_, rfl⟩
    have hfm : f.Monic := by
      rw [hfd]
      apply Polynomial.monic_X_pow_add
      exact lt_of_le_of_lt Polynomial.degree_linear_le (by norm_num)
    have hder : Polynomial.derivative f = Polynomial.C 2 * Polynomial.X + Polynomial.C (-β) := by
      rw [hfd]
      simp only [Polynomial.derivative_add, Polynomial.derivative_X_sq,
        Polynomial.derivative_C_mul_X, Polynomial.derivative_C, add_zero]
    let P : StandardEtalePair B :=
      ⟨f, hfm, Polynomial.X * Polynomial.derivative f, ⟨Polynomial.X, 0, 1, by ring⟩⟩
