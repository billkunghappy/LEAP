    rw [hgy]
    refine Ideal.add_mem _ ?_ ?_
    · refine ⟨N, ?_⟩
      rw [← map_pow]
      obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hN
      rw [hz, map_mul]
      exact Ideal.mem_span_singleton.mpr (dvd_mul_right _ _)
    · exact Ideal.le_radical (Ideal.mem_span_singleton.mpr (dvd_mul_right t y))

  have s5 : ∀ z : T, t ∣ g * z → t ∣ z := by
    intro z hz
    obtain ⟨g₀, yg, hg₀⟩ := hiii 1 g
    obtain ⟨x₀, yx, hx₀⟩ := hiii 1 z
    rw [pow_one] at hg₀ hx₀
    obtain ⟨w, hw⟩ := hz
    have hres := s4 g₀ yg hg₀
    have hc : algebraMap (MvPolynomial (Fin d) ↥W) T (g₀ * x₀) = t ^ 1 *
        (w - yg * algebraMap (MvPolynomial (Fin d) ↥W) T x₀ -
