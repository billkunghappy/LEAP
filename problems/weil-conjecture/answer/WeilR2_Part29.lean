  have H := s4 (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d)
    (algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d))
    (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d))
    hzd htot hr0 hrnu hrk hb2 hnf
  have e : algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d) =
      algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d)
        (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d)) :=
