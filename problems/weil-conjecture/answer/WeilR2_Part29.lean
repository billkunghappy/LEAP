          · refine ⟨j, Finset.mem_insert_of_mem hjS, fun i hi => ?_⟩
            rcases Finset.mem_insert.mp hi with rfl | hi
            · exact ⟨w, hw, h⟩
            · exact hj i hi
          · refine ⟨a, Finset.mem_insert_self a S, fun i hi => ?_⟩
