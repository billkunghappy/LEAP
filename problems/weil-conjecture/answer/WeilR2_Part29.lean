theorem wcpa_dj_ms_collide_blowup : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (α : Type) [Finite α] (r : α → (Spec (.of Ω) ⟶ Ct)) (y : Spec (.of Ω) ⟶ Ct), SmoothOfRelativeDimension 1 ct → (∀ a, r a ≫ ct = 𝟙 _) → y ≫ ct = 𝟙 _ → (∀ (a b : α) (p q : ↥(Spec (.of Ω))), a ≠ b → r a p ≠ r b q) → (∀ (a : α) (p q : ↥(Spec (.of Ω))), y p ≠ r a q) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (τ' : α → (Spec (.of ↥W) ⟶ Z')) (ψ' : Ct ⟶ Z') (Δ : Spec (.of ↥W) ⟶ Z'), wcpaDjSemistable u' → (∃ (N : ℕ) (j : Z' ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = u') → (∀ a, τ' a ≫ u' = 𝟙 _) → (∀ (a b : α) (p q : ↥(Spec (.of ↥W))), a ≠ b → τ' a p ≠ τ' b q) → (∀ a (p : ↥(Spec (.of ↥W))), ∃ U : Z'.Opens, τ' a p ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → IsPullback ψ' ct u' (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → (∀ a, r a ≫ ψ' = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ' a) → Δ ≫ u' = 𝟙 _ → y ≫ ψ' = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ Δ → ∀ a₀ : α, Δ (IsLocalRing.closedPoint ↥W) = τ' a₀ (IsLocalRing.closedPoint ↥W) → ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Option α → (Spec (.of ↥W) ⟶ Z)) (ψ : Ct ⟶ Z), wcpaDjSemistable uu ∧ (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uu) ∧ (∀ a, τ a ≫ uu = 𝟙 _) ∧ (∀ (a b : Option α) (p q : ↥(Spec (.of ↥W))), a ≠ b → τ a p ≠ τ b q) ∧ (∀ a (p : ↥(Spec (.of ↥W))), ∃ U : Z.Opens, τ a p ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ uu)) ∧ IsPullback ψ ct uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧ (∀ a, r a ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ (some a)) ∧ y ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ none :=
by
  intro Ω _ _ W hW Ct ct α _ r y hsm hrs hys hrd hyd Z' u' τ' ψ' Δ hss' hproj' hτ's hτ'd hτ'sm
    hpb' hc' hΔs' hΔc' a₀ ha₀
  classical
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h e x
    rw [← Scheme.Hom.comp_apply, e]

  obtain ⟨hpts, hopen, hrange, hgensm⟩ :=
    wcpa_dj_ms_generic_fibre Ω W hW Ct Z' ct u' ψ' hsm hpb'
  haveI := hopen

  have F2 : ∀ (a : α) (pt : ↥(Spec (.of Ω))),
      Δ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) pt) ≠
        τ' a (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) pt) := by
    intro a pt heq
    rw [ptw hΔc'.symm pt, ptw (hc' a).symm pt, Scheme.Hom.comp_apply,
      Scheme.Hom.comp_apply] at heq
    exact hyd a pt pt (ψ'.isOpenEmbedding.injective heq)

  have hs_nr : IsLocalRing.closedPoint ↥W ∉
      Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    rintro ⟨pt, hpt⟩
    apply F2 a₀ pt
    rw [hpt]
    exact ha₀

  have hsecpt : ∀ σ : Spec (.of ↥W) ⟶ Z', σ ≫ u' = 𝟙 _ → ∀ p : ↥(Spec (.of ↥W)),
      u' (σ p) = p := by
    intro σ hσ p
    rw [ptw hσ p]
    first | rfl | simp
  have hfib : ∀ σ : Spec (.of ↥W) ⟶ Z', σ ≫ u' = 𝟙 _ → ∀ p : ↥(Spec (.of ↥W)),
      σ p = Δ (IsLocalRing.closedPoint ↥W) → p = IsLocalRing.closedPoint ↥W := by
    intro σ hσ p hp
    exact (hsecpt σ hσ p).symm.trans ((congrArg (⇑u') hp).trans (hsecpt Δ hΔs' _))
  have hx_nr : Δ (IsLocalRing.closedPoint ↥W) ∉ Set.range ψ' := by
    intro hx
    have h1 := (hrange _).mp hx
    have h2 := hsecpt Δ hΔs' (IsLocalRing.closedPoint ↥W)
    exact hs_nr (Eq.subst (motive := fun z =>
      z ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) h2 h1)
  have hψx : ∀ c, ψ' c ≠ Δ (IsLocalRing.closedPoint ↥W) := fun c h => hx_nr ⟨c, h⟩
  have hτx : ∀ a, a ≠ a₀ → ∀ p, τ' a p ≠ Δ (IsLocalRing.closedPoint ↥W) := by
    intro a ha p h
    have hp := hfib (τ' a) (hτ's a) p h
    subst hp
    exact hτ'd a a₀ _ _ ha (h.trans ha₀)

  have hgen : ∀ p : ↥(Spec (.of ↥W)), p ≠ IsLocalRing.closedPoint ↥W → Δ p ≠ τ' a₀ p := by
    intro p hp
    rcases hpts p with ⟨pt, rfl⟩ | h
    · exact F2 a₀ pt
    · exact absurd h hp
  have hne : ∃ p : ↥(Spec (.of ↥W)), p ≠ IsLocalRing.closedPoint ↥W :=
    ⟨Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) (IsLocalRing.closedPoint Ω),
      fun h => hs_nr ⟨_, h⟩⟩

  obtain ⟨J, hJfg, hJsupp, hJΔ, hJτ, hJbl⟩ :=
    wcpa_dj_ms_collide_centre Ω W hW Z' u' Δ (τ' a₀) hss' hΔs' (hτ's a₀) (hτ'sm a₀ _) ha₀
      hgen hne
  obtain ⟨Z, rb, hbl⟩ := wcpa_dj_ms_blowup_exists_ft Z' J hJfg
  obtain ⟨hnode, hlift⟩ := hJbl Z rb hbl
  obtain ⟨hflat, hprop, hprojZ⟩ :=
    wcpa_dj_ms_blowup_flat_proj_W Ω W Z' u' hss'.1 hproj' J hJfg Z rb hbl

  have H : ∀ (T : Scheme.{u}) (h : T ⟶ Z'), (∀ t : T, h t ∉ (J.support : Set Z')) →
      wcCsdInvPull J h := by
    intro T h hh t
    obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : Z'.Opens)) (x := h t) trivial
    have hns : h t ∉ Z'.zeroLocus (U := U₀) (J.ideal ⟨U₀, hU₀⟩ : Set Γ(Z', U₀)) := by
      rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
      exact hh t
    rw [Scheme.mem_zeroLocus_iff] at hns
    push_neg at hns
    obtain ⟨a, haI, hxa⟩ := hns
    have htD : t ∈ h ⁻¹ᵁ Z'.basicOpen a := (Scheme.Hom.mem_preimage h).mpr hxa
    obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
    have hVD : V₀ ≤ h ⁻¹ᵁ Z'.basicOpen a := hV₀sub
    have hVU : V₀ ≤ h ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono h (Z'.basicOpen_le a))
    refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV₀, haI, ?_⟩
    have hbo : T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) = V₀ := by
      rw [Scheme.basicOpen_appLE]
      exact inf_eq_left.mpr hVD
    have hunit : IsUnit ((h.appLE U₀ V₀ hVU).hom a) := by
      apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace V₀
      intro y' hy
      have hy' : y' ∈ T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) := by rw [hbo]; exact hy
      exact (T.mem_basicOpen _ y' hy).mp hy'
    refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
    rw [Ideal.span_singleton_eq_top.mpr hunit]
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ haI) hunit

  have uniq : ∀ (T : Scheme.{u}) (f g : T ⟶ Z), f ≫ rb = g ≫ rb →
      (∀ t : T, (f ≫ rb) t ∉ (J.support : Set Z')) → f = g := by
    intro T f g hfg hav
    exact (hbl.2 T (f ≫ rb) (H T _ hav)).unique rfl hfg.symm

  have hinv : ∀ o : Option α, wcCsdInvPull J (Option.elim o Δ τ') := by
    intro o
    cases o with
    | none => exact hJΔ
    | some a =>
      by_cases ha : a = a₀
      · subst ha
        exact hJτ
      · exact H _ _ (fun p hp => hτx a ha p (hJsupp _ hp))
  choose τ hτ using fun o : Option α => (hbl.2 _ _ (hinv o)).exists

  obtain ⟨ψ, hψ⟩ := (hbl.2 Ct ψ' (H Ct ψ' (fun c hc => hψx c (hJsupp _ hc)))).exists

  have hΔτ := hlift (τ none) (τ (some a₀)) (hτ none) (hτ (some a₀))

  have hsecZ : ∀ o, τ o ≫ (rb ≫ u') = 𝟙 _ := by
    intro o
    rw [← Category.assoc, hτ o]
    cases o with
    | none => exact hΔs'
    | some a => exact hτ's a

  have hssZ : wcpaDjSemistable (rb ≫ u') := by
    refine ⟨hflat, hprop, ?_⟩
    intro K _ _ sp w
    by_cases hw : rb (Limits.pullback.fst (rb ≫ u') sp w) = Δ (IsLocalRing.closedPoint ↥W)
    · exact hnode K sp w hw
    · have hO : (J.support : Set Z') ∩ ((J.support.compl : Z'.Opens) : Set Z') = ∅ := by
        rw [TopologicalSpace.Closeds.coe_compl]
        exact Set.inter_compl_self _
      have hiso := wc_csd_blowup_iso_off_center Z' Z J rb J.support.compl hbl hO
      have hmem : rb (Limits.pullback.fst (rb ≫ u') sp w) ∈ J.support.compl := by
        rw [← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl]
        exact fun h => hw (hJsupp _ h)
      exact wcpa_dj_ms_fibre_ns_local_iso Z' Z (Spec (.of ↥W)) rb u' J.support.compl hiso K sp
        (fun w' => hss'.2.2 K sp w') w hmem

  have transfer : ∀ z : Z, rb z ≠ Δ (IsLocalRing.closedPoint ↥W) →
      (∃ V : Z'.Opens, rb z ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ u')) →
      ∃ U : Z.Opens, z ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ rb ≫ u') := by
    intro z hz hV
    obtain ⟨V, hzV, hVsm⟩ := hV
    obtain ⟨O, hOdef⟩ : ∃ O : Z'.Opens, O = V ⊓ J.support.compl := ⟨_, rfl⟩
    have hOV : O ≤ V := by rw [hOdef]; exact inf_le_left
    have hO : (J.support : Set Z') ∩ (O : Set Z') = ∅ := by
      rw [Set.eq_empty_iff_forall_notMem]
      rintro z' ⟨h1, h2⟩
      have h2' : z' ∈ O := h2
      rw [hOdef] at h2'
      have h3 : z' ∈ J.support.compl := (TopologicalSpace.Opens.mem_inf.mp h2').2
      rw [← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl] at h3
      exact h3 h1
    haveI hiso := wc_csd_blowup_iso_off_center Z' Z J rb O hbl hO
    have hzc : rb z ∈ J.support.compl := by
      rw [← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl]
      exact fun h => hz (hJsupp _ h)
    refine ⟨rb ⁻¹ᵁ O, ?_, ?_⟩
    · rw [Scheme.Hom.mem_preimage, hOdef]
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hzV, hzc⟩
    · have e : (rb ⁻¹ᵁ O).ι ≫ rb ≫ u' = (rb ∣_ O) ≫ Z'.homOfLE hOV ≫ V.ι ≫ u' := by
        rw [reassoc_of% (Scheme.homOfLE_ι Z' hOV), ← reassoc_of% (morphismRestrict_ι rb O)]
      rw [e]
      haveI := hVsm
      haveI : SmoothOfRelativeDimension 1 (Z'.homOfLE hOV ≫ V.ι ≫ u') :=
        smoothOfRelativeDimension_comp 0 1 _ _
      exact smoothOfRelativeDimension_comp 0 1 _ _

  have hsmZ : ∀ o (p : ↥(Spec (.of ↥W))), ∃ U : Z.Opens, τ o p ∈ U ∧
      SmoothOfRelativeDimension 1 (U.ι ≫ rb ≫ u') := by
    intro o p
    rcases hpts p with ⟨pt, rfl⟩ | hp
    · have hmem : Option.elim o Δ τ' (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) pt) ∈
          Set.range ψ' := by
        cases o with
        | none => exact ⟨y pt, (ptw hΔc' pt).trans (Scheme.Hom.comp_apply _ _ _)⟩
        | some a => exact ⟨r a pt, (ptw (hc' a) pt).trans (Scheme.Hom.comp_apply _ _ _)⟩
      apply transfer
      · rw [ptw (hτ o)]
        intro h
        apply hx_nr
        rw [← h]
        exact hmem
      · rw [ptw (hτ o)]
        exact hgensm _ hmem
    · cases o with
      | none => subst hp; exact hΔτ.2.1
      | some a =>
        by_cases ha : a = a₀
        · subst ha
          subst hp
          exact hΔτ.2.2
        · apply transfer
          · rw [ptw (hτ (some a)) p]; exact hτx a ha p
          · rw [ptw (hτ (some a)) p]; exact hτ'sm a p

  have hdisj : ∀ (a b : Option α) (p q : ↥(Spec (.of ↥W))), a ≠ b → τ a p ≠ τ b q := by
    intro o o' p q hoo' heq
    by_cases hpq : p = q
    · subst hpq
      have h1 : Option.elim o Δ τ' p = Option.elim o' Δ τ' p := by
        rw [← ptw (hτ o) p, ← ptw (hτ o') p, heq]
      rcases hpts p with ⟨pt, rfl⟩ | rfl
      · cases o with
        | none =>
          cases o' with
          | none => exact hoo' rfl
          | some b => exact F2 b pt h1
        | some a =>
          cases o' with
          | none => exact F2 a pt h1.symm
          | some b => exact hτ'd a b _ _ (fun h => hoo' (congrArg some h)) h1
      · cases o with
        | none =>
          cases o' with
          | none => exact hoo' rfl
          | some b =>
            by_cases hb : b = a₀
            · subst hb
              exact hΔτ.1 heq
            · exact hτx b hb _ h1.symm
        | some a =>
          cases o' with
          | none =>
            by_cases ha : a = a₀
            · subst ha
              exact hΔτ.1 heq.symm
            · exact hτx a ha _ h1
          | some b => exact hτ'd a b _ _ (fun h => hoo' (congrArg some h)) h1
    · apply hpq
      have e1 := ptw (hsecZ o) p
      have e2 := ptw (hsecZ o') q
      rw [heq, e2] at e1
      exact e1.symm

  have hsq : CommSq ψ (𝟙 Ct) rb ψ' := ⟨by rw [hψ, Category.id_comp]⟩
  have hpb1 : IsPullback ψ (𝟙 Ct) rb ψ' := by
    refine IsPullback.of_isLimit' hsq ?_
    refine Limits.PullbackCone.IsLimit.mk hsq.w (fun s => s.snd) ?_ ?_ ?_
    · intro s
      apply uniq
      · rw [Category.assoc, hψ, s.condition]
      · intro t
        rw [Category.assoc, hψ, Scheme.Hom.comp_apply]
        exact fun h => hψx _ (hJsupp _ h)
    · intro s
      exact Category.comp_id _
    · intro s m _ hm2
      exact (Category.comp_id m).symm.trans hm2
  have hpbZ : IsPullback ψ ct (rb ≫ u') (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    have h := hpb1.paste_vert hpb'
    rwa [Category.id_comp] at h

  have hcomp_some : ∀ a, r a ≫ ψ =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ (some a) := by
    intro a
    apply uniq
    · simp only [Category.assoc, hψ, hτ]
      exact hc' a
    · intro t
      rw [Category.assoc, hψ, Scheme.Hom.comp_apply]
      exact fun h => hψx _ (hJsupp _ h)
  have hcomp_none : y ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ none := by
    apply uniq
    · simp only [Category.assoc, hψ, hτ]
      exact hΔc'
    · intro t
      rw [Category.assoc, hψ, Scheme.Hom.comp_apply]
      exact fun h => hψx _ (hJsupp _ h)
  exact ⟨Z, rb ≫ u', τ, ψ, hssZ, hprojZ, hsecZ, hdisj, hsmZ, hpbZ, hcomp_some, hcomp_none⟩

theorem wcpa_dj_nc_residue_algclosed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), IsAlgClosed (IsLocalRing.ResidueField ↥W) :=
by
  intro Ω _ _ W
  classical
  refine IsAlgClosed.of_exists_root _ ?_
  intro pb hmon hirr
  have hdeg : 0 < pb.degree := Polynomial.degree_pos_of_irreducible hirr
  have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
    rw [Polynomial.mem_lifts]
    exact Polynomial.map_surjective _ IsLocalRing.residue_surjective pb
  obtain ⟨p, hpmap, hpdeg, hpmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
  have hPdeg : (p.map (algebraMap ↥W Ω)).degree ≠ 0 := by
    rw [hpmon.degree_map, hpdeg]
    exact ne_of_gt hdeg
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ hPdeg
  have hx' : Polynomial.eval x (p.map (algebraMap ↥W Ω)) = 0 := hx
  have hint : IsIntegral ↥W x := ⟨p, hpmon, by rw [← Polynomial.eval_map]; exact hx'⟩
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  have hpy : p.eval y = 0 := by
    apply IsFractionRing.injective ↥W Ω
    rw [map_zero, ← Polynomial.eval_map_apply, hy]
    exact hx'
  refine ⟨IsLocalRing.residue ↥W y, ?_⟩
  rw [← hpmap, Polynomial.eval_map_apply, hpy, map_zero]

theorem wcpa_dj_mn_fibre_bridge : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y) (w : ↥(Limits.pullback g (S.fromSpecResidueField (g y)))), Limits.pullback.fst g (S.fromSpecResidueField (g y)) w = y → (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalk w)) ((Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) (S.residueField (g y)) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e.toRingHom.comp ((algebraMap ((Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalk w)) ((Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of (S.residueField (g y)))).inv ≫ (Limits.pullback.snd g (S.fromSpecResidueField (g y))).appTop ≫ (Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → ∃ ε : AdicCompletion ((IsLocalRing.maximalIdeal (Y.presheaf.stalk y)).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom))) (Y.presheaf.stalk y ⧸ (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom) ≃+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField (S.presheaf.stalk (g y))) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), ε.toRingHom.comp ((algebraMap (Y.presheaf.stalk y ⧸ (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom) (AdicCompletion ((IsLocalRing.maximalIdeal (Y.presheaf.stalk y)).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom))) (Y.presheaf.stalk y ⧸ (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom))).comp ((Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom)).comp (g.stalkMap y).hom)) = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (IsLocalRing.residue (S.presheaf.stalk (g y)))) :=
by
  intro S Y g y w hw ⟨e, he⟩
  classical

  have t_quot : ∀ {R O : Type u} [CommRing R] [CommRing O] [IsLocalRing R] [IsLocalRing O]
      (I : Ideal R) (χ : R →+* O), Function.Surjective χ → I ≤ RingHom.ker χ →
      (∃ ψ : O →+* R ⧸ I, ψ.comp χ = Ideal.Quotient.mk I) →
      ∃ τ : (R ⧸ I) ≃+* O, (∀ r, τ (Ideal.Quotient.mk I r) = χ r) ∧
        ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk I)).map τ =
          IsLocalRing.maximalIdeal O := by
    intro R O _ _ _ _ I χ hχ hI ⟨ψ, hψ⟩
    have hI' : ∀ a ∈ I, χ a = 0 := fun a ha => RingHom.mem_ker.mp (hI ha)
    have hlm : (Ideal.Quotient.lift I χ hI').comp (Ideal.Quotient.mk I) = χ :=
      RingHom.ext fun r => Ideal.Quotient.lift_mk I χ hI'
    have h1 : (Ideal.Quotient.lift I χ hI').comp ψ = RingHom.id O := by
      apply RingHom.ext
      intro o
      obtain ⟨r, rfl⟩ := hχ o
      have := RingHom.congr_fun hψ r
      simp only [RingHom.comp_apply, RingHom.id_apply] at this ⊢
      rw [this, Ideal.Quotient.lift_mk]
    have h2 : ψ.comp (Ideal.Quotient.lift I χ hI') = RingHom.id (R ⧸ I) := by
      apply Ideal.Quotient.ringHom_ext
      rw [RingHom.comp_assoc, hlm, hψ]
      rfl
    refine ⟨RingEquiv.ofRingHom _ _ h1 h2, fun r => Ideal.Quotient.lift_mk I χ hI', ?_⟩
    change Ideal.map (Ideal.Quotient.lift I χ hI')
      ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk I)) = _
    rw [Ideal.map_map, hlm]
    have hker : RingHom.ker χ ≤ IsLocalRing.maximalIdeal R :=
      IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top χ)
    exact IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.map_of_surjective_of_ker_le hχ hker)

  have hev : ∀ {C : Type u} [CommRing C] (K : Ideal C) (n : ℕ) (c : C),
      AdicCompletion.evalₐ K n (algebraMap C (AdicCompletion K C) c) =
        Ideal.Quotient.mk (K ^ n) c := by
    intro C _ K n c
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hmap : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (f : B →+* B') (J : Ideal B)
      (J' : Ideal B'), (∀ b ∈ J, f b ∈ J') → ∃ F : AdicCompletion J B →+* AdicCompletion J' B',
      ∀ (n : ℕ) (b : B) (x : AdicCompletion J B),
        AdicCompletion.evalₐ J n x = Ideal.Quotient.mk (J ^ n) b →
        AdicCompletion.evalₐ J' n (F x) = Ideal.Quotient.mk (J' ^ n) (f b) := by
    intro B B' _ _ f J J' h
    have hn : ∀ n : ℕ, J ^ n ≤ (J' ^ n).comap f := fun n => by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr (fun b hb => h b hb)) n
    refine ⟨AdicCompletion.liftRingHom J' (fun n => (Ideal.quotientMap (J' ^ n) f (hn n)).comp
      (AdicCompletion.evalₐ J n).toRingHom) ?_, ?_⟩
    · intro m n hle
      ext x
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective J B x
      have hmm := congrArg (Ideal.quotientMap (J' ^ m) f (hn m))
        (AdicCompletion.Ideal.mk_eq_mk J hle a)
      simp only [Ideal.quotientMap_mk] at hmm
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        AdicCompletion.evalₐ_mk, Ideal.quotientMap_mk]
      rw [← hmm]
      rfl
    · intro n b x hx
      rw [AdicCompletion.evalₐ_liftRingHom]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hx,
        Ideal.quotientMap_mk]
  have t_adic : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (τ : B ≃+* B') (J : Ideal B)
      (J' : Ideal B'), J.map τ = J' → ∃ T : AdicCompletion J B ≃+* AdicCompletion J' B',
      ∀ b : B, T (algebraMap B _ b) = algebraMap B' _ (τ b) := by
    intro B B' _ _ τ J J' hJ
    have h1 : ∀ b ∈ J, (τ : B →+* B') b ∈ J' := by
      intro b hb
      rw [← hJ]
      simpa using Ideal.mem_map_of_mem τ hb
    have h2 : ∀ z ∈ J', (τ.symm : B' →+* B) z ∈ J := by
      intro z hz
      rw [← hJ] at hz
      obtain ⟨x, hx, rfl⟩ := (Ideal.mem_map_of_equiv τ z).mp hz
      simpa using hx
    obtain ⟨F, hF⟩ := hmap (τ : B →+* B') J J' h1
    obtain ⟨G, hG⟩ := hmap (τ.symm : B' →+* B) J' J h2
    have hGF : ∀ x, G (F x) = x := fun x => AdicCompletion.ext_evalₐ (fun n => by
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n x)
      rw [hG n ((τ : B →+* B') b) (F x) (hF n b x hb.symm), ← hb]
      simp)
    have hFG : ∀ x, F (G x) = x := fun x => AdicCompletion.ext_evalₐ (fun n => by
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J' n x)
      rw [hF n ((τ.symm : B' →+* B) b) (G x) (hG n b x hb.symm), ← hb]
      simp)
    refine ⟨RingEquiv.ofRingHom F G (RingHom.ext hFG) (RingHom.ext hGF), fun b => ?_⟩
    rw [RingEquiv.ofRingHom_apply]
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hF n b _ (hev J n b), hev]
    rfl

  have hχ : Function.Surjective (Y.presheaf.stalkSpecializes (specializes_of_eq hw) ≫
      (Limits.pullback.fst g (S.fromSpecResidueField (g y))).stalkMap w).hom := by
    have hspec : ∀ {X : Scheme.{u}} {a b : X} (h : a = b),
        Function.Surjective (X.presheaf.stalkSpecializes (specializes_of_eq h)).hom := by
      intro X a b h
      subst h
      rw [TopCat.Presheaf.stalkSpecializes_refl]
      intro z
      exact ⟨z, rfl⟩
    rw [CommRingCat.hom_comp, RingHom.coe_comp]
    exact (Scheme.Hom.stalkMap_surjective _ w).comp (hspec hw)

  have hc : g.stalkMap y ≫ Y.presheaf.stalkSpecializes (specializes_of_eq hw) ≫
      (Limits.pullback.fst g (S.fromSpecResidueField (g y))).stalkMap w =
      S.residue (g y) ≫ (Scheme.ΓSpecIso (.of (S.residueField (g y)))).inv ≫
        (Limits.pullback.snd g (S.fromSpecResidueField (g y))).appTop ≫
        (Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.germ ⊤ w trivial := by
    have K : ∀ (q : Spec (S.residueField (g y))) (c : S.fromSpecResidueField (g y) q ⤳ g y),
        S.presheaf.stalkSpecializes c ≫ (S.fromSpecResidueField (g y)).stalkMap q =
        S.residue (g y) ≫ (Scheme.ΓSpecIso (.of (S.residueField (g y)))).inv ≫
          (Spec (.of (S.residueField (g y)))).presheaf.germ ⊤ q trivial := by
      intro q c
      obtain rfl : q = IsLocalRing.closedPoint (S.residueField (g y)) := Subsingleton.elim _ _
      have e1 : (Scheme.ΓSpecIso (.of (S.residueField (g y)))).inv ≫
          (Spec (.of (S.residueField (g y)))).presheaf.germ ⊤
            (IsLocalRing.closedPoint (S.residueField (g y))) trivial =
          (stalkClosedPointIso (S.residueField (g y))).inv := by
        rw [← ΓSpecIso_hom_stalkClosedPointIso_inv, Iso.inv_hom_id_assoc]
        rfl
      rw [e1, Iso.eq_comp_inv, Category.assoc]
      change S.presheaf.stalkSpecializes c ≫
        Scheme.stalkClosedPointTo (S.fromSpecResidueField (g y)) = S.residue (g y)
      haveI : IsLocalHom (S.residue (g y)).hom := by
        first
          | exact IsLocalRing.isLocalHom_residue _
          | infer_instance
          | exact inferInstanceAs (IsLocalHom (IsLocalRing.residue (S.presheaf.stalk (g y))))
      apply TopCat.Presheaf.stalk_hom_ext
      intro U hU
      rw [TopCat.Presheaf.germ_stalkSpecializes_assoc]
      exact Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk (S.residue (g y)) U _
    have e2 : ∀ q : Spec (S.residueField (g y)), S.fromSpecResidueField (g y) q = g y := by
      intro q
      obtain rfl : q = IsLocalRing.closedPoint (S.residueField (g y)) := Subsingleton.elim _ _
      exact Scheme.fromSpecResidueField_apply _ _
    have L0 : ∀ {X Z : Scheme.{u}} (f₁ f₂ : X ⟶ Z), f₁ = f₂ → ∀ (x : X) (z : Z)
        (c₁ : f₁ x ⤳ z) (c₂ : f₂ x ⤳ z),
        Z.presheaf.stalkSpecializes c₁ ≫ f₁.stalkMap x =
          Z.presheaf.stalkSpecializes c₂ ≫ f₂.stalkMap x := by
      rintro X Z f₁ f₂ rfl x z c₁ c₂
      rfl
    have L : ∀ {X Y₁ Y₂ Z : Scheme.{u}} (a₁ : X ⟶ Y₁) (b₁ : Y₁ ⟶ Z) (a₂ : X ⟶ Y₂)
        (b₂ : Y₂ ⟶ Z), a₁ ≫ b₁ = a₂ ≫ b₂ → ∀ (x : X) (z : Z)
        (c₁ : b₁ (a₁ x) ⤳ z) (c₂ : b₂ (a₂ x) ⤳ z),
        Z.presheaf.stalkSpecializes c₁ ≫ b₁.stalkMap (a₁ x) ≫ a₁.stalkMap x =
          Z.presheaf.stalkSpecializes c₂ ≫ b₂.stalkMap (a₂ x) ≫ a₂.stalkMap x := by
      intro X Y₁ Y₂ Z a₁ b₁ a₂ b₂ h x z c₁ c₂
      have h' := L0 (a₁ ≫ b₁) (a₂ ≫ b₂) h x z c₁ c₂
      rw [Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp] at h'
      exact h'
    have hcond := Limits.pullback.condition (f := g) (g := S.fromSpecResidueField (g y))
    rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc g _ _ (specializes_of_eq hw)]
    refine (L _ _ _ _ hcond w (g y) _ (specializes_of_eq (e2 _))).trans ?_
    rw [← Category.assoc, K]
    simp only [Category.assoc]
    have hg := Scheme.Hom.germ_stalkMap (Limits.pullback.snd g (S.fromSpecResidueField (g y))) ⊤ w
      trivial
    exact congrArg (fun k => S.residue (g y) ≫
      (Scheme.ΓSpecIso (.of (S.residueField (g y)))).inv ≫ k) hg

  have hret : ∃ ψ : (Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalk w →+*
      (Y.presheaf.stalk y ⧸ (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map
        (g.stalkMap y).hom),
      ψ.comp (Y.presheaf.stalkSpecializes (specializes_of_eq hw) ≫
        (Limits.pullback.fst g (S.fromSpecResidueField (g y))).stalkMap w).hom =
      Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map
        (g.stalkMap y).hom) := by
    obtain ⟨I, hI⟩ : ∃ I : Ideal (Y.presheaf.stalk y),
        I = (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom :=
      ⟨_, rfl⟩
    rw [← hI]
    have hIm : I ≤ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
      rw [hI]
      exact Ideal.map_le_iff_le_comap.mpr (fun a ha => map_nonunit _ a ha)
    have hIc : IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)) ≤
        I.comap (g.stalkMap y).hom := by
      rw [hI]
      exact Ideal.le_comap_map
    have hne : I ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal _).ne_top hIm
    haveI : Nontrivial (Y.presheaf.stalk y ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hne
    haveI : IsLocalRing (Y.presheaf.stalk y ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    obtain ⟨q, hq⟩ : ∃ q : Y.presheaf.stalk y ⟶ CommRingCat.of (Y.presheaf.stalk y ⧸ I),
        ∀ r, q.hom r = Ideal.Quotient.mk I r := ⟨CommRingCat.ofHom (Ideal.Quotient.mk I), fun r => rfl⟩
    haveI hlocC : IsLocalHom q.hom := ⟨fun x hx => by
      by_contra hxu
      rw [hq] at hx
      obtain ⟨u, hu⟩ := hx
      obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (↑u⁻¹ : Y.presheaf.stalk y ⧸ I)
      have h1 : Ideal.Quotient.mk I (1 - x * z) = 0 := by
        rw [map_sub, map_one, map_mul, hz, ← hu, Units.mul_inv, sub_self]
      have h2 : 1 - x * z ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
        hIm (Ideal.Quotient.eq_zero_iff_mem.mp h1)
      have h3 : x * z ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
        Ideal.mul_mem_right z _ ((IsLocalRing.mem_maximalIdeal x).mpr hxu)
      have h4 : (1 : Y.presheaf.stalk y) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
        simpa using Ideal.add_mem _ h2 h3
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h4)⟩
    obtain ⟨θ, hθ⟩ : ∃ θ : S.residueField (g y) ⟶ CommRingCat.of (Y.presheaf.stalk y ⧸ I),
        S.residue (g y) ≫ θ = g.stalkMap y ≫ q :=
      ⟨CommRingCat.ofHom (Ideal.quotientMap I (g.stalkMap y).hom hIc), by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        change (Ideal.quotientMap I (g.stalkMap y).hom hIc) ((S.residue (g y)).hom x) =
          q.hom ((g.stalkMap y).hom x)
        rw [hq]
        rfl⟩
    have hcond : (Spec.map q ≫ Y.fromSpecStalk y) ≫ g =
        Spec.map θ ≫ S.fromSpecResidueField (g y) := by
      rw [Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
        ← Spec.map_comp, ← hθ, Spec.map_comp, Category.assoc]
      rfl
    have hapt : (Spec.map q ≫ Y.fromSpecStalk y)
          (IsLocalRing.closedPoint (Y.presheaf.stalk y ⧸ I)) = y := by
      change Y.fromSpecStalk y ((Spec.map q) (IsLocalRing.closedPoint (Y.presheaf.stalk y ⧸ I))) = y
      have h1 : (Spec.map q) (IsLocalRing.closedPoint (Y.presheaf.stalk y ⧸ I)) =
          IsLocalRing.closedPoint (Y.presheaf.stalk y) := Spec_closedPoint (f := q)
      exact (congrArg (Y.fromSpecStalk y) h1).trans Scheme.fromSpecStalk_closedPoint
    have hL : Limits.pullback.lift _ _ hcond
        (IsLocalRing.closedPoint (Y.presheaf.stalk y ⧸ I)) = w := by
      apply (IsPreimmersion.isEmbedding
        (Limits.pullback.fst g (S.fromSpecResidueField (g y)))).injective
      change (Limits.pullback.lift _ _ hcond ≫ Limits.pullback.fst g (S.fromSpecResidueField (g y)))
        (IsLocalRing.closedPoint (Y.presheaf.stalk y ⧸ I)) = _
      rw [Limits.pullback.lift_fst]
      exact hapt.trans hw.symm
    refine ⟨((Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalkSpecializes
      (specializes_of_eq hL) ≫ Scheme.stalkClosedPointTo (Limits.pullback.lift _ _ hcond)).hom,
      ?_⟩
    have gen : ∀ (a' : Spec (CommRingCat.of (Y.presheaf.stalk y ⧸ I)) ⟶ Y),
        a' = Spec.map q ≫ Y.fromSpecStalk y →
        ∀ (d : a' (IsLocalRing.closedPoint (Y.presheaf.stalk y ⧸ I)) ⤳ y),
        Y.presheaf.stalkSpecializes d ≫ Scheme.stalkClosedPointTo a' = q := by
      rintro a' rfl d
      apply TopCat.Presheaf.stalk_hom_ext
      intro U hU
      rw [TopCat.Presheaf.germ_stalkSpecializes_assoc]
      exact Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk q U _
    have key : Y.presheaf.stalkSpecializes (specializes_of_eq hw) ≫
        (Limits.pullback.fst g (S.fromSpecResidueField (g y))).stalkMap w ≫
        (Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.stalkSpecializes
          (specializes_of_eq hL) ≫ Scheme.stalkClosedPointTo (Limits.pullback.lift _ _ hcond) =
        q := by
      rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc _ _ _ (specializes_of_eq hL),
        TopCat.Presheaf.stalkSpecializes_comp_assoc, ← Scheme.stalkClosedPointTo_comp]
      exact gen _ (Limits.pullback.lift_fst _ _ _) _
    apply RingHom.ext
    intro r
    exact (congrArg (fun f => f.hom r) key).trans (hq r)

  obtain ⟨ψ, hψ⟩ := hret
  have hIker : (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map (g.stalkMap y).hom ≤
      RingHom.ker (Y.presheaf.stalkSpecializes (specializes_of_eq hw) ≫
        (Limits.pullback.fst g (S.fromSpecResidueField (g y))).stalkMap w).hom := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker]
    have h1 := congrArg (fun f => f.hom a) hc
    simp only [CommRingCat.comp_apply] at h1
    rw [CommRingCat.comp_apply, h1]
    have h0 : (S.residue (g y)).hom a = 0 := (IsLocalRing.residue_eq_zero_iff a).mpr ha
    rw [h0, map_zero, map_zero, map_zero]
  obtain ⟨τ, hτ1, hτ2⟩ := t_quot _ _ hχ hIker ⟨ψ, hψ⟩
  obtain ⟨T, hT⟩ := t_adic τ _ _ hτ2
  refine ⟨T.trans e, ?_⟩
  apply RingHom.ext
  intro x
  have h1 : (Y.presheaf.stalkSpecializes (specializes_of_eq hw) ≫
        (Limits.pullback.fst g (S.fromSpecResidueField (g y))).stalkMap w).hom
        ((g.stalkMap y).hom x) =
      ((Scheme.ΓSpecIso (.of (S.residueField (g y)))).inv ≫
        (Limits.pullback.snd g (S.fromSpecResidueField (g y))).appTop ≫
        (Limits.pullback g (S.fromSpecResidueField (g y))).presheaf.germ ⊤ w trivial).hom
        ((S.residue (g y)).hom x) :=
    congrArg (fun f => f.hom x) hc
  have h2 := RingHom.congr_fun he ((S.residue (g y)).hom x)
  have h3 := hT (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))).map
    (g.stalkMap y).hom) ((g.stalkMap y).hom x))
  rw [hτ1, h1] at h3
  have h4 := congrArg e h3
  exact h4.trans h2

theorem wcpa_dj_mn_fs_fibre_chart : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y) (U₀ : S.Opens) (hU₀ : IsAffineOpen U₀) (hp : g y ∈ U₀) (V₀ : Y.Opens) (hV₀ : IsAffineOpen V₀) (hy : y ∈ V₀) (e : V₀ ≤ g ⁻¹ᵁ U₀), letI := (g.appLE U₀ V₀ e).hom.toAlgebra; letI := (S.presheaf.germ U₀ (g y) hp ≫ S.residue (g y)).hom.toAlgebra; ∃ ι : Spec (.of (TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀))) ⟶ Limits.pullback g (S.fromSpecResidueField (g y)), IsOpenImmersion ι ∧ ι ≫ Limits.pullback.snd g (S.fromSpecResidueField (g y)) = Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (g y)) (TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)))) ∧ (∀ w, Limits.pullback.fst g (S.fromSpecResidueField (g y)) w ∈ V₀ → w ∈ Set.range ι) ∧ ∀ x, Limits.pullback.fst g (S.fromSpecResidueField (g y)) (ι x) = y → x.asIdeal.comap (Algebra.TensorProduct.includeRight : Γ(Y, V₀) →ₐ[Γ(S, U₀)] TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)) = (hV₀.primeIdealOf ⟨y, hy⟩).asIdeal :=
by
  intro S Y g y U₀ hU₀ hp V₀ hV₀ hy e
  letI := (g.appLE U₀ V₀ e).hom.toAlgebra
  letI := (S.presheaf.germ U₀ (g y) hp ≫ S.residue (g y)).hom.toAlgebra

  have s2 : ∀ {W X Y Z S : Scheme.{u}} {fst : W ⟶ X} {snd : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
      (i : Z ⟶ S) [Mono i] {f' : X ⟶ S} {g' : Y ⟶ S},
      IsPullback fst snd f g → f ≫ i = f' → g ≫ i = g' → IsPullback fst snd f' g' := by
    intro W X Y Z S fst snd f g i _ f' g' H hf hg
    subst hf hg
    refine IsPullback.mk' ?_ ?_ ?_
    · rw [← Category.assoc, H.w, Category.assoc]
    · intro T φ φ' h1 h2
      exact H.hom_ext h1 h2
    · intro T a b hab
      have w : a ≫ f = b ≫ g := by
        rw [← cancel_mono i]
        simpa only [Category.assoc] using hab
      exact ⟨H.lift a b w, H.lift_fst a b w, H.lift_snd a b w⟩

  have H1 := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀))
  haveI : IsOpenImmersion hU₀.fromSpec := hU₀.isOpenImmersion_fromSpec
  haveI : IsOpenImmersion hV₀.fromSpec := hV₀.isOpenImmersion_fromSpec
  have e1 : Spec.map (CommRingCat.ofHom (algebraMap Γ(S, U₀) (S.residueField (g y))))
      ≫ hU₀.fromSpec = S.fromSpecResidueField (g y) := by
    rw [Scheme.fromSpecResidueField, ← hU₀.fromSpecStalk_eq_fromSpecStalk hp,
      IsAffineOpen.fromSpecStalk, ← Category.assoc, ← Spec.map_comp]
    rfl
  have e2 : Spec.map (CommRingCat.ofHom (algebraMap Γ(S, U₀) Γ(Y, V₀))) ≫ hU₀.fromSpec
      = hV₀.fromSpec ≫ g := IsAffineOpen.SpecMap_appLE_fromSpec g hU₀ hV₀ e
  have H2 := s2 hU₀.fromSpec H1 e1 e2
  have H : IsPullback
      (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (g y))
        (TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)))))
      (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : Γ(Y, V₀) →ₐ[Γ(S, U₀)]
        TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)).toRingHom))
      (S.fromSpecResidueField (g y)) (hV₀.fromSpec ≫ g) := H2

  have w : ((Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Y, V₀) →ₐ[Γ(S, U₀)] TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)).toRingHom))
        ≫ hV₀.fromSpec) ≫ g =
      Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (g y))
        (TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)))) ≫
        S.fromSpecResidueField (g y) := by
    rw [Category.assoc]; exact H.w.symm
  let ι := Limits.pullback.lift _ _ w
  have hιsnd : ι ≫ Limits.pullback.snd g (S.fromSpecResidueField (g y)) = _ :=
    Limits.pullback.lift_snd _ _ w
  have hιfst : ι ≫ Limits.pullback.fst g (S.fromSpecResidueField (g y)) = _ :=
    Limits.pullback.lift_fst _ _ w
  have H' : IsPullback (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Y, V₀) →ₐ[Γ(S, U₀)] TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)).toRingHom))
      ι hV₀.fromSpec (Limits.pullback.fst g (S.fromSpecResidueField (g y))) := by
    refine IsPullback.of_bot ?_ hιfst.symm (IsPullback.of_hasPullback g _)
    rw [hιsnd]
    exact H.flip
  have hιo : IsOpenImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) H' inferInstance
  refine ⟨ι, hιo, hιsnd, ?_, ?_⟩
  · intro w hw
    have hw' : Limits.pullback.fst g (S.fromSpecResidueField (g y)) w ∈
        Set.range hV₀.fromSpec := by
      rw [hV₀.range_fromSpec]; exact hw
    obtain ⟨z, hz⟩ := hw'
    obtain ⟨t, -, ht⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := hV₀.fromSpec) (g := Limits.pullback.fst g (S.fromSpecResidueField (g y))) z w hz
    refine ⟨H'.isoPullback.inv t, ?_⟩
    rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_snd, ht]
  · intro x hx
    have h1 : hV₀.fromSpec ((Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Y, V₀) →ₐ[Γ(S, U₀)] TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)).toRingHom))
        x) = y := by
      have hx' := hx
      rw [← Scheme.Hom.comp_apply, hιfst, Scheme.Hom.comp_apply] at hx'
      exact hx'
    have h2 : (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Y, V₀) →ₐ[Γ(S, U₀)] TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)).toRingHom))
        x = hV₀.primeIdealOf ⟨y, hy⟩ := by
      apply hV₀.fromSpec.isOpenEmbedding.injective
      rw [h1, hV₀.fromSpec_primeIdealOf]
    have h3 := congrArg PrimeSpectrum.asIdeal h2
    exact h3

theorem wcpa_dj_mn_fs_field_open_std : ∀ (K T : Type u) [Field K] [CommRing T] [Algebra K T] (n : ℕ) (W' : (Spec (.of T)).Opens) (x : Spec (.of T)), x ∈ W' → SmoothOfRelativeDimension n (W'.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K T))) → ∃ s : T, s ∉ x.asIdeal ∧ Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s) :=
by
  intro K T _ _ _ n W' x hx hsm
  classical

  obtain ⟨U, ⟨t, rfl⟩, hxU, hUW⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (PrimeSpectrum.isBasis_basic_opens (R := T)))
      (show x ∈ (show TopologicalSpace.Opens (PrimeSpectrum T) from W') from hx)
  have ht : t ∉ x.asIdeal := hxU
  have hD : ∀ p : Spec (.of T), t ∉ p.asIdeal → p ∈ W' := fun p hp => hUW hp

  have hrange : Set.range (Spec.map (CommRingCat.ofHom (algebraMap T (Localization.Away t)))) ⊆
      Set.range W'.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨q, rfl⟩
    apply hD
    intro hq
    have e : (Spec.map (CommRingCat.ofHom (algebraMap T (Localization.Away t))) q).asIdeal =
        q.asIdeal.comap (algebraMap T (Localization.Away t)) := rfl
    rw [e, Ideal.mem_comap] at hq
    exact q.isPrime.ne_top
      (Ideal.eq_top_of_isUnit_mem _ hq (IsLocalization.Away.algebraMap_isUnit t))
  have hfac : IsOpenImmersion.lift W'.ι _ hrange ≫ W'.ι =
      Spec.map (CommRingCat.ofHom (algebraMap T (Localization.Away t))) :=
    IsOpenImmersion.lift_fac _ _ _
  haveI : IsOpenImmersion (IsOpenImmersion.lift W'.ι _ hrange ≫ W'.ι) := by
    rw [hfac]; infer_instance
  haveI : IsOpenImmersion (IsOpenImmersion.lift W'.ι _ hrange) :=
    IsOpenImmersion.of_comp _ W'.ι
  haveI : SmoothOfRelativeDimension 0 (IsOpenImmersion.lift W'.ι _ hrange) := inferInstance
  haveI := hsm
  have hsmt : SmoothOfRelativeDimension n
      (Spec.map (CommRingCat.ofHom (algebraMap K (Localization.Away t)))) := by
    have h1 := smoothOfRelativeDimension_comp 0 n (IsOpenImmersion.lift W'.ι _ hrange)
      (W'.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K T)))
    rw [zero_add, ← Category.assoc, hfac, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq] at h1
    exact h1

  haveI hP : x.asIdeal.IsPrime := x.isPrime
  have hdisj : Disjoint (↑(Submonoid.powers t) : Set T) ↑x.asIdeal := by
    rw [Set.disjoint_left]
    rintro _ ⟨k, rfl⟩ hk
    exact ht (hP.mem_of_pow_mem k hk)
  have hP'prime := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers t)
    (Localization.Away t) x.asIdeal hP hdisj
  have hcomap := IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers t)
    (Localization.Away t) hP hdisj
  obtain ⟨s', hs', hstd⟩ :=
    wcpa_dj_cf_ss_field_local_std K (Localization.Away t) n hsmt _ hP'prime
  haveI := hstd
  obtain ⟨⟨c, m⟩, hck⟩ := IsLocalization.surj (Submonoid.powers t) s'
  obtain ⟨k, hk⟩ := m.2
  have hck' : s' * algebraMap T (Localization.Away t) (t ^ k) =
      algebraMap T (Localization.Away t) c := by
    have hk' : t ^ k = (m : T) := hk
    rw [hk']; exact hck
  have htk : algebraMap T (Localization.Away t) (t ^ k) ∉
      x.asIdeal.map (algebraMap T (Localization.Away t)) := by
    intro h
    have h' : t ^ k ∈ Ideal.under T (x.asIdeal.map (algebraMap T (Localization.Away t))) := h
    rw [hcomap] at h'
    exact ht (hP.mem_of_pow_mem k h')
  have hc : c ∉ x.asIdeal := by
    intro h
    have h2 : algebraMap T (Localization.Away t) c ∈
        x.asIdeal.map (algebraMap T (Localization.Away t)) := Ideal.mem_map_of_mem _ h
    rw [← hck'] at h2
    rcases hP'prime.mem_or_mem h2 with h3 | h3
    · exact hs' h3
    · exact htk h3
  refine ⟨c * t, fun h => (hP.mem_or_mem h).elim hc ht, ?_⟩
  have hu : IsUnit (algebraMap T (Localization.Away t) (t ^ k)) := by
    rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit t).pow k
  have h1 : IsLocalization.Away (s' * algebraMap T (Localization.Away t) (t ^ k))
      (Localization.Away s') :=
    IsLocalization.Away.mul_of_isUnit s' _ (hu.map _)
  rw [hck'] at h1
  haveI := h1
  haveI h2 : IsLocalization.Away (c * t) (Localization.Away s') :=
    IsLocalization.Away.mul (Localization.Away t) (Localization.Away s') t c
  exact Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv n
    ((IsLocalization.algEquiv (Submonoid.powers (c * t)) (Localization.Away s')
      (Localization.Away (c * t))).restrictScalars K)

theorem wcpa_dj_mn_fs_fibrewise : ∀ (R K S : Type u) [CommRing R] [Field K] [CommRing S] [Algebra R K] [Algebra R S] [Algebra.FinitePresentation R S] [Module.Flat R S] (Q : Ideal (TensorProduct R K S)) [Q.IsPrime] (q : Ideal S) [q.IsPrime], Q.comap (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S) = q → Algebra.IsSmoothAt K Q → Algebra.IsSmoothAt R q :=
by

  have s1 : ∀ (R K S : Type u) [CommRing R] [CommRing K] [CommRing S] [Algebra R K] [Algebra R S] (n : ℕ) (f : MvPolynomial (Fin n) R →ₐ[R] S), Function.Surjective f → Function.Surjective (MvPolynomial.aeval (R := K) (fun i => TensorProduct.tmul R (1 : K) (f (MvPolynomial.X i))) : MvPolynomial (Fin n) K →ₐ[K] TensorProduct R K S) ∧ RingHom.ker (MvPolynomial.aeval (R := K) (fun i => TensorProduct.tmul R (1 : K) (f (MvPolynomial.X i))) : MvPolynomial (Fin n) K →ₐ[K] TensorProduct R K S).toRingHom = Ideal.map (MvPolynomial.map (algebraMap R K)) (RingHom.ker f.toRingHom) ∧ (MvPolynomial.aeval (R := K) (fun i => TensorProduct.tmul R (1 : K) (f (MvPolynomial.X i))) : MvPolynomial (Fin n) K →ₐ[K] TensorProduct R K S).toRingHom.comp (MvPolynomial.map (algebraMap R K)) = (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S).toRingHom.comp f.toRingHom := by
    intro R K S _ _ _ _ _ n f hf
    set f' : MvPolynomial (Fin n) K →ₐ[K] TensorProduct R K S :=
      MvPolynomial.aeval (R := K) (fun i => TensorProduct.tmul R (1 : K) (f (MvPolynomial.X i)))
      with hf'
    have hcomm : f'.toRingHom.comp (MvPolynomial.map (algebraMap R K)) =
        (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S).toRingHom.comp
          f.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have h1 : f (MvPolynomial.C r) = algebraMap R S r := f.commutes r
        simp only [RingHom.coe_comp, Function.comp_apply, MvPolynomial.map_C, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe]
        rw [h1, Algebra.TensorProduct.includeRight_apply, ← MvPolynomial.algebraMap_eq,
          AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
          RingHom.id_apply, Algebra.TensorProduct.tmul_one_eq_one_tmul]
      · intro i
        simp [f']
    have hpt : ∀ p, f' (MvPolynomial.map (algebraMap R K) p) = (1 : K) ⊗ₜ[R] f p := fun p => by
      have := RingHom.congr_fun hcomm p
      simpa using this
    set e := MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) R K with he
    have hFe : ∀ x, f' (e x) = Algebra.TensorProduct.map (AlgHom.id R K) f x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a p =>
        rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_smul, hpt, Algebra.TensorProduct.map_tmul,
          AlgHom.id_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      | add x y hx hy => simp only [map_add, hx, hy]
    have hFsurj : Function.Surjective (Algebra.TensorProduct.map (AlgHom.id R K) f) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, map_zero _⟩
      | tmul a s =>
        obtain ⟨p, rfl⟩ := hf s
        exact ⟨a ⊗ₜ[R] p, by rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]⟩
      | add x y hx hy =>
        obtain ⟨x', rfl⟩ := hx
        obtain ⟨y', rfl⟩ := hy
        exact ⟨x' + y', map_add _ _ _⟩
    have hμe : ∀ p, e ((1 : K) ⊗ₜ[R] p) = MvPolynomial.map (algebraMap R K) p := by
      intro p
      rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
    have hkerF := Algebra.TensorProduct.lTensor_ker (A := K) f hf
    refine ⟨?_, ?_, hcomm⟩
    · intro z
      obtain ⟨x, rfl⟩ := hFsurj z
      exact ⟨e x, hFe x⟩
    · ext y
      rw [RingHom.mem_ker]
      change f' y = 0 ↔ _
      have hy : f' y = Algebra.TensorProduct.map (AlgHom.id R K) f (e.symm y) := by
        rw [← hFe, AlgEquiv.apply_symm_apply]
      rw [hy, ← RingHom.mem_ker, hkerF]
      have key : Ideal.map (MvPolynomial.map (algebraMap R K)) (RingHom.ker f.toRingHom) =
          Ideal.comap e.toRingEquiv.symm
            (Ideal.map (Algebra.TensorProduct.includeRight : MvPolynomial (Fin n) R →ₐ[R] TensorProduct R K (MvPolynomial (Fin n) R)) (RingHom.ker f)) := by
        rw [Ideal.comap_symm]
