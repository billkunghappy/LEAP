        (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W))
      (k : ℕ), a * b = (algebraMap (MvPolynomial (Fin d) ↥W)
