theorem wcpa_dj_ncx_quadric_normal_form (R : Type u) [CommRing R] [HenselianLocalRing R]
    (B : Type u) [CommRing B] [Algebra R B] (u v g : B) (𝔔 : Ideal B) [𝔔.IsPrime]
    (het : (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).Etale)
    (h𝔔 : 𝔔.comap (algebraMap R B) = IsLocalRing.maximalIdeal R)
    (hres : Function.Surjective ((Ideal.Quotient.mk 𝔔).comp (algebraMap R B)))
    (hu : u ∈ 𝔔) (hv : v ∈ 𝔔) (a b c d : R) (hdet : IsUnit (a * d - b * c))
    (hq : ∃ t ∉ 𝔔, t * (g - (algebraMap R B a * u + algebraMap R B b * v) *
        (algebraMap R B c * u + algebraMap R B d * v)) ∈
      𝔔 ^ 3 ⊔ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) :
    ∃ (C : Type u) (_ : CommRing C) (ι : B →+* C) (T₁ T₂ : C) (r : R) (𝔔' : Ideal C),
      ι.Etale ∧ 𝔔'.IsPrime ∧ 𝔔'.comap ι = 𝔔 ∧ T₁ ∈ 𝔔' ∧ T₂ ∈ 𝔔' ∧
      T₁ * T₂ = ι g + ι (algebraMap R B r) ∧
      (MvPolynomial.eval₂Hom (ι.comp (algebraMap R B)) ![T₁, T₂]).Etale :=
by
  classical
  obtain ⟨t, ht, htq⟩ := hq

  have hloc : ∀ (S : Type u) [CommRing S] (f : S), (algebraMap S (Localization.Away f)).Etale :=
    fun S _ f => RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway f)

  have L7 : ∀ (S : Type u) [CommRing S] [Algebra R S] (Q : Ideal S) [Q.IsPrime] (f : S),
      Q.comap (algebraMap R S) = IsLocalRing.maximalIdeal R →
      Function.Surjective ((Ideal.Quotient.mk Q).comp (algebraMap R S)) → f ∉ Q →
      (Q.map (algebraMap S (Localization.Away f))).IsPrime ∧
      (Q.map (algebraMap S (Localization.Away f))).comap (algebraMap S (Localization.Away f)) = Q ∧
      (Q.map (algebraMap S (Localization.Away f))).comap (algebraMap R (Localization.Away f)) =
        IsLocalRing.maximalIdeal R ∧
      Function.Surjective ((Ideal.Quotient.mk (Q.map (algebraMap S (Localization.Away f)))).comp
        (algebraMap R (Localization.Away f))) := by
    intro S _ _ Q _ f hQ hsurj hf
    have hdisj : Disjoint (↑(Submonoid.powers f) : Set S) ↑Q :=
      (Ideal.disjoint_powers_iff_notMem f (Ideal.IsPrime.isRadical inferInstance)).mpr hf
    have hP := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f)
      (Localization.Away f) Q inferInstance hdisj
    have hC : (Q.map (algebraMap S (Localization.Away f))).comap
        (algebraMap S (Localization.Away f)) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f)
        inferInstance hdisj
    refine ⟨hP, hC, ?_, ?_⟩
    · rw [IsScalarTower.algebraMap_eq R S (Localization.Away f), ← Ideal.comap_comap, hC, hQ]
    · intro y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨⟨b, m⟩, hy⟩ :=
        IsLocalization.mk'_surjective (S := Localization.Away f) (Submonoid.powers f) y
      dsimp only at hy
      subst hy
      obtain ⟨n, hn⟩ := m.2
      obtain ⟨rb, hrb⟩ := hsurj (Ideal.Quotient.mk Q b)
      obtain ⟨rf, hrf⟩ := hsurj (Ideal.Quotient.mk Q f)
      simp only [RingHom.comp_apply] at hrb hrf
      have hrfu : IsUnit rf := by
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hm'
        apply hf
        rw [← hQ, Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem] at hm'
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← hrf, hm']
      obtain ⟨w, hw⟩ := hrfu
      refine ⟨rb * ((w⁻¹ : Rˣ) : R) ^ n, ?_⟩
      simp only [RingHom.comp_apply]
      rw [Ideal.Quotient.eq]
      have key : algebraMap S (Localization.Away f) (↑m) *
          (algebraMap R (Localization.Away f) (rb * ((w⁻¹ : Rˣ) : R) ^ n) -
            IsLocalization.mk' (Localization.Away f) b m) =
          algebraMap S (Localization.Away f) (↑m * algebraMap R S (rb * ((w⁻¹ : Rˣ) : R) ^ n) - b) := by
        rw [mul_sub, mul_comm _ (IsLocalization.mk' _ b m), IsLocalization.mk'_spec, map_sub,
          map_mul (algebraMap S (Localization.Away f)) (↑m),
          ← IsScalarTower.algebraMap_apply R S (Localization.Away f)]
      rw [← Ideal.unit_mul_mem_iff_mem _ (IsLocalization.map_units (Localization.Away f) m), key]
      apply Ideal.mem_map_of_mem
      have e : ((w : R) ^ n * (rb * ((w⁻¹ : Rˣ) : R) ^ n) - rb) = 0 := by
        rw [mul_left_comm, ← mul_pow, Units.mul_inv, one_pow, mul_one, sub_self]
      have h1 : Ideal.Quotient.mk Q (↑m * algebraMap R S (rb * ((w⁻¹ : Rˣ) : R) ^ n) - b) =
          Ideal.Quotient.mk Q (algebraMap R S ((w : R) ^ n * (rb * ((w⁻¹ : Rˣ) : R) ^ n) - rb)) := by
        rw [← hn, map_sub, map_mul, map_pow, ← hrf, ← hrb, ← hw]
        simp only [map_sub, map_mul, map_pow]
      rw [← Ideal.Quotient.eq_zero_iff_mem, h1, e, map_zero, map_zero]

  have hUV : (MvPolynomial.eval₂Hom (algebraMap R B) ![algebraMap R B a * u + algebraMap R B b * v,
      algebraMap R B c * u + algebraMap R B d * v]).Etale := by
    obtain ⟨δ, hδ⟩ := hdet
    have hed : ((δ⁻¹ : Rˣ) : R) * (a * d - b * c) = 1 := by rw [← hδ, Units.inv_mul]
    set e : R := ((δ⁻¹ : Rˣ) : R) with he
    let θ : MvPolynomial (Fin 2) R →ₐ[R] MvPolynomial (Fin 2) R :=
      MvPolynomial.aeval ![MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1,
        MvPolynomial.C c * MvPolynomial.X 0 + MvPolynomial.C d * MvPolynomial.X 1]
    let θ' : MvPolynomial (Fin 2) R →ₐ[R] MvPolynomial (Fin 2) R :=
      MvPolynomial.aeval ![MvPolynomial.C (e * d) * MvPolynomial.X 0 -
          MvPolynomial.C (e * b) * MvPolynomial.X 1,
        MvPolynomial.C (e * a) * MvPolynomial.X 1 - MvPolynomial.C (e * c) * MvPolynomial.X 0]
    have hθ0 : θ (MvPolynomial.X 0) =
        MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1 := by
      simp [θ]
    have hθ1 : θ (MvPolynomial.X 1) =
        MvPolynomial.C c * MvPolynomial.X 0 + MvPolynomial.C d * MvPolynomial.X 1 := by
      simp [θ]
    have hθ'0 : θ' (MvPolynomial.X 0) = MvPolynomial.C (e * d) * MvPolynomial.X 0 -
          MvPolynomial.C (e * b) * MvPolynomial.X 1 := by
      simp [θ']
    have hθ'1 : θ' (MvPolynomial.X 1) =
        MvPolynomial.C (e * a) * MvPolynomial.X 1 - MvPolynomial.C (e * c) * MvPolynomial.X 0 := by
      simp [θ']
    have hθC : ∀ r : R, θ (MvPolynomial.C r) = MvPolynomial.C r := fun r => by
      simp [θ]
    have hθ'C : ∀ r : R, θ' (MvPolynomial.C r) = MvPolynomial.C r := fun r => by
      simp [θ']
    have hl : ∀ x, θ' (θ x) = x := by
      have h1 : θ'.comp θ = AlgHom.id R _ := by
        apply MvPolynomial.algHom_ext
        intro i
        fin_cases i
        · show θ' (θ (MvPolynomial.X 0)) = MvPolynomial.X 0
          rw [hθ0, map_add, map_mul, map_mul, hθ'C, hθ'C, hθ'0, hθ'1]
          calc _ = MvPolynomial.C (e * (a * d - b * c)) * (MvPolynomial.X 0 :
                MvPolynomial (Fin 2) R) := by
                simp only [map_mul, map_sub]; ring
            _ = _ := by rw [hed, map_one, one_mul]
        · show θ' (θ (MvPolynomial.X 1)) = MvPolynomial.X 1
          rw [hθ1, map_add, map_mul, map_mul, hθ'C, hθ'C, hθ'0, hθ'1]
          calc _ = MvPolynomial.C (e * (a * d - b * c)) * (MvPolynomial.X 1 :
                MvPolynomial (Fin 2) R) := by
                simp only [map_mul, map_sub]; ring
            _ = _ := by rw [hed, map_one, one_mul]
      intro x
      rw [← AlgHom.comp_apply, h1, AlgHom.id_apply]
    have hr : ∀ x, θ (θ' x) = x := by
      have h1 : θ.comp θ' = AlgHom.id R _ := by
        apply MvPolynomial.algHom_ext
        intro i
        fin_cases i
        · show θ (θ' (MvPolynomial.X 0)) = MvPolynomial.X 0
          rw [hθ'0]
          simp only [map_sub, map_mul, hθC, hθ0, hθ1]
          calc _ = MvPolynomial.C (e * (a * d - b * c)) * (MvPolynomial.X 0 :
                MvPolynomial (Fin 2) R) := by
                simp only [map_mul, map_sub]; ring
            _ = _ := by rw [hed, map_one, one_mul]
        · show θ (θ' (MvPolynomial.X 1)) = MvPolynomial.X 1
          rw [hθ'1]
          simp only [map_sub, map_mul, hθC, hθ0, hθ1]
          calc _ = MvPolynomial.C (e * (a * d - b * c)) * (MvPolynomial.X 1 :
                MvPolynomial (Fin 2) R) := by
                simp only [map_mul, map_sub]; ring
            _ = _ := by rw [hed, map_one, one_mul]
      intro x
      rw [← AlgHom.comp_apply, h1, AlgHom.id_apply]
    have hbij : Function.Bijective θ := Function.bijective_iff_has_inverse.mpr ⟨θ', hl, hr⟩
    have hθet : (θ.toRingHom).Etale := RingHom.Etale.of_bijective hbij
    have h3 : (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).comp θ.toRingHom =
        MvPolynomial.eval₂Hom (algebraMap R B) ![algebraMap R B a * u + algebraMap R B b * v,
          algebraMap R B c * u + algebraMap R B d * v] := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, hθC]
        simp
      · intro i
        fin_cases i
        · show (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]) (θ (MvPolynomial.X 0)) = _
          rw [hθ0]
          simp
        · show (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]) (θ (MvPolynomial.X 1)) = _
          rw [hθ1]
          simp
    rw [← h3]
    exact RingHom.Etale.stableUnderComposition _ _ hθet het

  have hm : Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R) ≤ 𝔔 := by
    rw [Ideal.map_le_iff_le_comap, h𝔔]
  have hU'Q : algebraMap R B a * u + algebraMap R B b * v ∈ 𝔔 :=
    Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)
  have hV'Q : algebraMap R B c * u + algebraMap R B d * v ∈ 𝔔 :=
    Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)

  obtain ⟨x₁, x₂, h, s, hh, hs, hx₁, hx₂, hxet, hDg, hsg⟩ :=
    wcpa_dj_ncx_qnf_derivative_coords R B _ _ g t 𝔔 (IsLocalRing.maximalIdeal R) hUV hU'Q hV'Q
      hm ht htq
  have hgQ : g ∈ 𝔔 := by
    have h1 : s * (g - x₁ * x₂) ∈ 𝔔 := (sup_le (Ideal.pow_le_self (by norm_num)) hm) hsg
    have h2 := ((inferInstance : 𝔔.IsPrime).mem_or_mem h1).resolve_left hs
    have h3 := Ideal.add_mem _ h2 (Ideal.mul_mem_right x₂ _ hx₁)
    simpa using h3

  obtain ⟨hP1, hC1, hR1, hS1⟩ := L7 B 𝔔 h h𝔔 hres hh
  obtain ⟨Q₁, hQ₁⟩ : ∃ Q₁, Q₁ = 𝔔.map (algebraMap B (Localization.Away h)) := ⟨_, rfl⟩
  rw [← hQ₁] at hP1 hC1 hR1 hS1
  haveI := hP1

  obtain ⟨r, hr, h₂, hh₂, hG⟩ := wcpa_dj_ncx_qnf_hensel_constant R (Localization.Away h)
    (algebraMap B (Localization.Away h) x₁) (algebraMap B (Localization.Away h) x₂)
    (algebraMap B (Localization.Away h) g) Q₁ hxet hR1 hS1
    (by rw [hQ₁]; exact Ideal.mem_map_of_mem _ hx₁) (by rw [hQ₁]; exact Ideal.mem_map_of_mem _ hx₂)
    (by rw [hQ₁]; exact Ideal.mem_map_of_mem _ hgQ)

  obtain ⟨hP2, hC2, hR2, -⟩ := L7 (Localization.Away h) Q₁ h₂ hR1 hS1 hh₂
  obtain ⟨Q₂, hQ₂⟩ : ∃ Q₂, Q₂ = Q₁.map (algebraMap (Localization.Away h) (Localization.Away h₂)) :=
    ⟨_, rfl⟩
  rw [← hQ₂] at hP2 hC2 hR2
  haveI := hP2
  have hQ₂B : Q₂ = 𝔔.map (algebraMap B (Localization.Away h₂)) := by
    rw [hQ₂, hQ₁, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  have hC : Q₂.comap (algebraMap B (Localization.Away h₂)) = 𝔔 := by
    rw [IsScalarTower.algebraMap_eq B (Localization.Away h) (Localization.Away h₂),
      ← Ideal.comap_comap, hC2, hC1]
  have hBet : (algebraMap B (Localization.Away h₂)).Etale := by
    rw [IsScalarTower.algebraMap_eq B (Localization.Away h) (Localization.Away h₂)]
    exact RingHom.Etale.stableUnderComposition _ _ (hloc B h) (hloc _ h₂)
  obtain ⟨y₁, hy₁⟩ : ∃ y, y = algebraMap B (Localization.Away h₂) x₁ := ⟨_, rfl⟩
  obtain ⟨y₂, hy₂⟩ : ∃ y, y = algebraMap B (Localization.Away h₂) x₂ := ⟨_, rfl⟩
  obtain ⟨G, hGdef⟩ : ∃ G, G = algebraMap B (Localization.Away h₂) g +
      algebraMap R (Localization.Away h₂) r := ⟨_, rfl⟩
  have hy₁Q : y₁ ∈ Q₂ := by rw [hy₁, hQ₂B]; exact Ideal.mem_map_of_mem _ hx₁
  have hy₂Q : y₂ ∈ Q₂ := by rw [hy₂, hQ₂B]; exact Ideal.mem_map_of_mem _ hx₂
  have hyet : (MvPolynomial.eval₂Hom (algebraMap R (Localization.Away h₂)) ![y₁, y₂]).Etale := by
    have e : MvPolynomial.eval₂Hom (algebraMap R (Localization.Away h₂)) ![y₁, y₂] =
        (algebraMap (Localization.Away h) (Localization.Away h₂)).comp
          (MvPolynomial.eval₂Hom (algebraMap R (Localization.Away h))
            ![algebraMap B (Localization.Away h) x₁, algebraMap B (Localization.Away h) x₂]) := by
      apply MvPolynomial.ringHom_ext
      · intro r'
        simp [IsScalarTower.algebraMap_apply R (Localization.Away h) (Localization.Away h₂)]
      · intro i
        fin_cases i
        · simp [hy₁, IsScalarTower.algebraMap_apply B (Localization.Away h) (Localization.Away h₂)]
        · simp [hy₂, IsScalarTower.algebraMap_apply B (Localization.Away h) (Localization.Away h₂)]
    rw [e]
    exact RingHom.Etale.stableUnderComposition _ _ hxet (hloc _ h₂)
  have hGspan : G ∈ Ideal.span {y₁, y₂} := by
    have h1 := Ideal.mem_map_of_mem (algebraMap (Localization.Away h) (Localization.Away h₂)) hG
    rw [Ideal.map_span, Set.image_pair] at h1
    simp only [map_mul, map_add, ← IsScalarTower.algebraMap_apply] at h1
    rw [hGdef, hy₁, hy₂]
    exact (Ideal.unit_mul_mem_iff_mem _ (IsLocalization.Away.algebraMap_isUnit h₂)).mp h1
  have hDG : KaehlerDifferential.D R (Localization.Away h₂) G ∈ Ideal.span {y₁, y₂} •
      (⊤ : Submodule (Localization.Away h₂) (KaehlerDifferential R (Localization.Away h₂))) := by
    have e1 : KaehlerDifferential.D R (Localization.Away h₂) G =
        KaehlerDifferential.map R R B (Localization.Away h₂) (KaehlerDifferential.D R B g) := by
      rw [KaehlerDifferential.map_D, hGdef, map_add, Derivation.map_algebraMap, add_zero]
    rw [e1, hDg, map_add, map_smul, map_smul, ← algebraMap_smul (Localization.Away h₂) x₂,
      ← algebraMap_smul (Localization.Away h₂) x₁, ← hy₁, ← hy₂]
    exact Submodule.add_mem _
      (Submodule.smul_mem_smul (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
        Submodule.mem_top)
      (Submodule.smul_mem_smul (Ideal.subset_span (Set.mem_insert _ _)) Submodule.mem_top)

  obtain ⟨α, β, γ, hαβγ⟩ := wcpa_dj_ncx_qnf_morse R (Localization.Away h₂) y₁ y₂ G hyet hGspan hDG

  have h𝔪₂ : Ideal.map (algebraMap R (Localization.Away h₂)) (IsLocalRing.maximalIdeal R) ≤ Q₂ :=
    Ideal.map_le_iff_le_comap.mpr hR2.ge
  have hs₂ : algebraMap B (Localization.Away h₂) s ∉ Q₂ := by
    intro hmem
    apply hs
    rw [← hC]
    exact hmem
  have hmapI : Ideal.map (algebraMap B (Localization.Away h₂))
      (𝔔 ^ 3 ⊔ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) =
      Q₂ ^ 3 ⊔ Ideal.map (algebraMap R (Localization.Away h₂)) (IsLocalRing.maximalIdeal R) := by
    have e1 : Ideal.map (algebraMap B (Localization.Away h₂))
        (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) =
        Ideal.map (algebraMap R (Localization.Away h₂)) (IsLocalRing.maximalIdeal R) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    rw [Ideal.map_sup, Ideal.map_pow, e1, ← hQ₂B]
  have hjet : algebraMap B (Localization.Away h₂) s *
      (α * y₁ ^ 2 + (β - 1) * y₁ * y₂ + γ * y₂ ^ 2) ∈
      Q₂ ^ 3 ⊔ Ideal.map (algebraMap R (Localization.Away h₂)) (IsLocalRing.maximalIdeal R) := by
    have e3 : α * y₁ ^ 2 + (β - 1) * y₁ * y₂ + γ * y₂ ^ 2 = G - y₁ * y₂ := by
      rw [hαβγ]; ring
    have e4 : algebraMap B (Localization.Away h₂) s * (G - y₁ * y₂) =
        algebraMap B (Localization.Away h₂) (s * (g - x₁ * x₂)) +
          algebraMap B (Localization.Away h₂) s * algebraMap R (Localization.Away h₂) r := by
      rw [hGdef, hy₁, hy₂]
      simp only [map_mul, map_sub]
      ring
    rw [e3, e4]
    refine Ideal.add_mem _ ?_ (Ideal.mem_sup_right (Ideal.mul_mem_left _ _
      (Ideal.mem_map_of_mem _ hr)))
    rw [← hmapI]
    exact Ideal.mem_map_of_mem _ hsg
  obtain ⟨hαQ, hβQ, -⟩ := wcpa_dj_ncx_qnf_jet_coeffs R (Localization.Away h₂) y₁ y₂ α (β - 1) γ
    (algebraMap B (Localization.Away h₂) s) Q₂ (IsLocalRing.maximalIdeal R) hyet h𝔪₂ hy₁Q hy₂Q
    hs₂ hjet
  have hαγ : α * γ ∈ Q₂ := Ideal.mul_mem_right _ _ hαQ
  have hβ : β ∉ Q₂ := by
    intro hb
    apply (inferInstance : Q₂.IsPrime).ne_top
    rw [Ideal.eq_top_iff_one]
    have h1 := Ideal.sub_mem _ hb hβQ
    simpa using h1

  obtain ⟨C, iC, ι₃, T₁, T₂, 𝔔', hι₃, h𝔔'p, h𝔔'c, hT₁, hT₂, hT, hTet⟩ :=
    wcpa_dj_ncx_qnf_split_quadric R (Localization.Away h₂) y₁ y₂ α β γ Q₂ hyet hy₁Q hy₂Q hαγ hβ
  refine ⟨C, iC, ι₃.comp (algebraMap B (Localization.Away h₂)), T₁, T₂, r, 𝔔',
    RingHom.Etale.stableUnderComposition _ _ hBet hι₃, h𝔔'p, ?_, hT₁, hT₂, ?_, ?_⟩
  · rw [← Ideal.comap_comap, h𝔔'c, hC]
  · rw [hT, ← hαβγ, hGdef, map_add, RingHom.comp_apply, RingHom.comp_apply,
      ← IsScalarTower.algebraMap_apply]
  · rw [RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq]
    exact hTet

theorem wcpa_dj_ncx_chart_ring {Ω : Type u} [Field Ω] (W : ValuationSubring Ω)
    (A : Type u) [CommRing A] [Algebra (↥W) A] (𝔮 : Ideal A) [𝔮.IsPrime] (s : A) (hs : s ∉ 𝔮)
    (B : Type u) [CommRing B] [Algebra (↥W) B] (g : B) (π : B →ₐ[↥W] Localization.Away s)
    (hπ : Function.Surjective π) (hker : RingHom.ker π = Ideal.span {g})
    (C : Type u) [CommRing C] (ι : B →+* C) (T₁ T₂ : C) (r : ↥W) (𝔔' : Ideal C) [𝔔'.IsPrime]
    (hι : ι.Etale)
    (h𝔔' : 𝔔'.comap ι = Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮))
    (hT₁ : T₁ ∈ 𝔔') (hT₂ : T₂ ∈ 𝔔') (hT : T₁ * T₂ = ι g + ι (algebraMap (↥W) B r))
    (hTet : (MvPolynomial.eval₂Hom (ι.comp (algebraMap (↥W) B)) ![T₁, T₂]).Etale) :
    ∃ (E : Type u) (_ : CommRing E) (f₁ : A →+* E) (f₂ : wcNcRing W r →+* E) (𝔭 : Ideal E),
      𝔭.IsPrime ∧ f₁.Etale ∧ @RingHom.Etale (wcNcRing W r) E _ _ f₂ ∧
      f₁.comp (algebraMap (↥W) A) = f₂.comp (algebraMap (↥W) (wcNcRing W r)) ∧
      𝔭.comap f₁ = 𝔮 ∧
      f₂ (Ideal.Quotient.mk (wcNcIdeal W r) (MvPolynomial.X 0)) ∈ 𝔭 ∧
      f₂ (Ideal.Quotient.mk (wcNcIdeal W r) (MvPolynomial.X 1)) ∈ 𝔭 :=
by
  classical

  have L1 : ∀ {S T : Type u} [CommRing S] [CommRing T] (φ : S →+* T) (I : Ideal S), φ.Etale →
      (Ideal.quotientMap (I.map φ) φ Ideal.le_comap_map).Etale := by
    intro S T _ _ φ I hφ
    letI : Algebra S T := φ.toAlgebra
    haveI : Algebra.Etale S T := RingHom.etale_algebraMap.mp hφ
    have hbc : (algebraMap (S ⧸ I) (TensorProduct S (S ⧸ I) T)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    let e : TensorProduct S (S ⧸ I) T ≃+* (T ⧸ I.map φ) :=
      (Algebra.TensorProduct.comm S (S ⧸ I) T).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I).symm.toRingEquiv
    have he : (e : TensorProduct S (S ⧸ I) T →+* (T ⧸ I.map φ)).Etale :=
      RingHom.Etale.of_bijective e.bijective
    have hcomp := RingHom.Etale.stableUnderComposition _ _ hbc he
    convert hcomp using 1
    apply Ideal.Quotient.ringHom_ext
    ext x
    simp only [RingHom.comp_apply, Ideal.quotientMap_mk]
    show _ = (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I).symm
      ((Algebra.TensorProduct.comm S (S ⧸ I) T)
        (algebraMap (S ⧸ I) (TensorProduct S (S ⧸ I) T) (Ideal.Quotient.mk I x)))
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.TensorProduct.comm_tmul,
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul, Algebra.smul_def, mul_one]
    rfl

  let πr : B →+* Localization.Away s := (π : B →+* Localization.Away s)
  have hπr : Function.Surjective πr := hπ
  let J : Ideal C := Ideal.map ι (RingHom.ker πr)
  let φ : MvPolynomial (Fin 2) ↥W →+* C :=
    MvPolynomial.eval₂Hom (ι.comp (algebraMap (↥W) B)) ![T₁, T₂]
  have hker' : RingHom.ker πr = Ideal.span {g} := hker
  have hJg : J = Ideal.span {ι g} := by
    show Ideal.map ι (RingHom.ker πr) = _
    rw [hker', Ideal.map_span, Set.image_singleton]
  have hφX0 : φ (MvPolynomial.X 0) = T₁ := by
    simp [φ]
  have hφX1 : φ (MvPolynomial.X 1) = T₂ := by
    simp [φ]
  have hφC : ∀ w : ↥W, φ (MvPolynomial.C w) = ι (algebraMap (↥W) B w) := by
    intro w
    simp [φ]
  have hφp : φ (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r) = ι g := by
    rw [map_sub, map_mul, hφX0, hφX1, hφC, hT]
    ring
  have hJ'J : Ideal.map φ (wcNcIdeal W r) = J := by
    rw [hJg]
    show Ideal.map φ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C r}) = _
    rw [Ideal.map_span, Set.image_singleton, hφp]

  have hJQ : J ≤ 𝔔' := by
    show Ideal.map ι (RingHom.ker πr) ≤ 𝔔'
    rw [Ideal.map_le_iff_le_comap, h𝔔']
    intro b hb
    rw [RingHom.mem_ker] at hb
    rw [Ideal.mem_comap]
    have h0 : π b = 0 := hb
    rw [h0]
    exact Ideal.zero_mem _

  let ε := RingHom.quotientKerEquivOfSurjective hπr
  let q₁ : B ⧸ RingHom.ker πr →+* C ⧸ J := Ideal.quotientMap J ι Ideal.le_comap_map
  let f₁ : A →+* C ⧸ J :=
    q₁.comp ((ε.symm : Localization.Away s →+* B ⧸ RingHom.ker πr).comp
      (algebraMap A (Localization.Away s)))
  let q₂ : MvPolynomial (Fin 2) ↥W ⧸ wcNcIdeal W r →+* C ⧸ Ideal.map φ (wcNcIdeal W r) :=
    Ideal.quotientMap (Ideal.map φ (wcNcIdeal W r)) φ Ideal.le_comap_map
  let f₂ : wcNcRing W r →+* C ⧸ J := (Ideal.quotEquivOfEq hJ'J).toRingHom.comp q₂
  have hεb : ∀ b : B, ε.symm (π b) = Ideal.Quotient.mk (RingHom.ker πr) b := by
    intro b
    rw [RingEquiv.symm_apply_eq]
    exact (RingHom.quotientKerEquivOfSurjective_apply_mk hπr b).symm
  have hf₁b : ∀ (x : A) (b : B), π b = algebraMap A (Localization.Away s) x →
      f₁ x = Ideal.Quotient.mk J (ι b) := by
    intro x b hb
    show q₁ (ε.symm (algebraMap A (Localization.Away s) x)) = _
    rw [← hb, hεb]
    exact Ideal.quotientMap_mk
  have hf₂y : ∀ y : MvPolynomial (Fin 2) ↥W,
      f₂ (Ideal.Quotient.mk (wcNcIdeal W r) y) = Ideal.Quotient.mk J (φ y) := by
    intro y
    show (Ideal.quotEquivOfEq hJ'J) (q₂ (Ideal.Quotient.mk (wcNcIdeal W r) y)) = _
    rw [Ideal.quotientMap_mk, Ideal.quotEquivOfEq_mk]

  have hlocet : (algebraMap A (Localization.Away s)).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway s)
  have hεet : (ε.symm : Localization.Away s →+* B ⧸ RingHom.ker πr).Etale :=
    RingHom.Etale.of_bijective ε.symm.bijective
  have hq₁ : q₁.Etale := L1 ι (RingHom.ker πr) hι
  have hf₁et : f₁.Etale :=
    RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _ hlocet hεet) hq₁
  have hq₂ := L1 φ (wcNcIdeal W r) hTet
  have hf₂et : @RingHom.Etale (wcNcRing W r) (C ⧸ J) _ _ f₂ :=
    RingHom.Etale.stableUnderComposition _ _ hq₂
      (RingHom.Etale.of_bijective (Ideal.quotEquivOfEq hJ'J).bijective)

  have hprime : (Ideal.map (Ideal.Quotient.mk J) 𝔔').IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hJQ)

  have hR : f₁.comp (algebraMap (↥W) A) = f₂.comp (algebraMap (↥W) (wcNcRing W r)) := by
    ext w
    show f₁ (algebraMap (↥W) A w) = f₂ (algebraMap (↥W) (wcNcRing W r) w)
    rw [hf₁b (algebraMap (↥W) A w) (algebraMap (↥W) B w)
        (by rw [AlgHom.commutes, IsScalarTower.algebraMap_apply (↥W) A (Localization.Away s)])]
    have e : algebraMap (↥W) (wcNcRing W r) w =
        Ideal.Quotient.mk (wcNcIdeal W r) (MvPolynomial.C w) := by
      first
        | rfl
        | rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    rw [e, hf₂y, hφC]

  have hdisj : Disjoint (↑(Submonoid.powers s) : Set A) ↑𝔮 := by
    rw [Set.disjoint_left]
    rintro _ ⟨n, rfl⟩ hn
    exact hs (‹𝔮.IsPrime›.mem_of_pow_mem n hn)
  have hloc := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s)
    (Localization.Away s) ‹𝔮.IsPrime› hdisj
  have hcomap : (Ideal.map (Ideal.Quotient.mk J) 𝔔').comap f₁ = 𝔮 := by
    ext x
    obtain ⟨b, hb⟩ := hπ (algebraMap A (Localization.Away s) x)
    have e1 : Ideal.Quotient.mk J (ι b) ∈ Ideal.map (Ideal.Quotient.mk J) 𝔔' ↔ ι b ∈ 𝔔' := by
      rw [← Ideal.mem_comap (f := Ideal.Quotient.mk J),
        Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr hJQ]
    have e2 : ι b ∈ 𝔔' ↔ algebraMap A (Localization.Away s) x ∈
        Ideal.map (algebraMap A (Localization.Away s)) 𝔮 := by
      rw [← Ideal.mem_comap (f := ι), h𝔔', Ideal.mem_comap, hb]
    have e3 : algebraMap A (Localization.Away s) x ∈
        Ideal.map (algebraMap A (Localization.Away s)) 𝔮 ↔ x ∈ 𝔮 := by
      rw [← Ideal.mem_comap (f := algebraMap A (Localization.Away s))]
      exact SetLike.ext_iff.mp hloc x
    rw [Ideal.mem_comap, hf₁b x b hb, e1, e2, e3]
  refine ⟨C ⧸ J, inferInstance, f₁, f₂, Ideal.map (Ideal.Quotient.mk J) 𝔔', hprime, hf₁et,
    hf₂et, hR, hcomap, ?_, ?_⟩
  · rw [hf₂y, hφX0]
    exact Ideal.mem_map_of_mem _ hT₁
  · rw [hf₂y, hφX1]
    exact Ideal.mem_map_of_mem _ hT₂

theorem wcpa_dj_nc_chart_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (x : ↥Z'), IsAlgClosed (IsLocalRing.ResidueField ↥W) → Flat u' → LocallyOfFinitePresentation u' → u' x = IsLocalRing.closedPoint ↥W → wcNcNodeDatum u' x → ∃ (U : Scheme.{u}) (e : U ⟶ Z') (a : ↥W) (m : U ⟶ Spec (.of (wcNcRing W a))) (x' : ↥U), Etale e ∧ Etale m ∧ m ≫ wcNcStr W a = e ≫ u' ∧ e x' = x ∧ Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) ∈ PrimeSpectrum.asIdeal (m x') ∧ Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) ∈ PrimeSpectrum.asIdeal (m x') :=
by
  intro Ω _ _ W Z' u' x _hk hflat hlfp hux hdat

  obtain ⟨A, iA, iAlg, j, 𝔮, hj, hju, hjx, hfp, hfl, h𝔮, hD⟩ :=
    wcpa_dj_ncx_affine_datum Ω W Z' u' x hflat hlfp hux hdat
  haveI := hfp
  haveI := hfl
  haveI := hj

  have hlev : wcNcxLevels (↥W) A 𝔮.asIdeal := wcpa_dj_ncx_node_levels (↥W) A 𝔮.asIdeal h𝔮 hD

  obtain ⟨s, B, iB, iBA, u, v, g, π, hs, hπ, hker, het, hprime, h𝔔, hres, hu, hv,
    a, b, c, d, hdet, hq⟩ := wcpa_dj_ncx_cartier_embedding (↥W) A 𝔮.asIdeal h𝔮 hlev
  haveI := hprime

  haveI : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W

  obtain ⟨C, iC, ι, T₁, T₂, r, 𝔔', hι, h𝔔'p, h𝔔'c, hT₁, hT₂, hT, hTet⟩ :=
    wcpa_dj_ncx_quadric_normal_form (↥W) B u v g _ het h𝔔 hres hu hv a b c d hdet hq
  haveI := h𝔔'p

  obtain ⟨E, iE, f₁, f₂, 𝔭, h𝔭, hf₁, hf₂, hcomp, h𝔭c, hX0, hX1⟩ :=
    wcpa_dj_ncx_chart_ring W A 𝔮.asIdeal s hs B g π hπ hker C ι T₁ T₂ r 𝔔' hι h𝔔'c hT₁ hT₂ hT
      hTet

  haveI h1 : Etale (Spec.map (CommRingCat.ofHom f₁)) := HasRingHomProperty.Spec_iff.mpr hf₁
  haveI h2 : Etale (Spec.map (CommRingCat.ofHom f₂)) := by
    rw [HasRingHomProperty.Spec_iff (P := @Etale)]
    exact hf₂
  have hpt1 : Spec.map (CommRingCat.ofHom f₁) (⟨𝔭, h𝔭⟩ : PrimeSpectrum E) = 𝔮 := by
    exact PrimeSpectrum.ext h𝔭c
  refine ⟨Spec (.of E), Spec.map (CommRingCat.ofHom f₁) ≫ j, r, Spec.map (CommRingCat.ofHom f₂),
    (⟨𝔭, h𝔭⟩ : PrimeSpectrum E), inferInstance, h2, ?_, ?_, ?_, ?_⟩
  · rw [Category.assoc, hju, wcNcStr, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp, hcomp]
  · exact (Scheme.Hom.comp_apply _ _ _).trans ((congrArg j hpt1).trans hjx)
  · exact hX0
  · exact hX1

theorem wcpa_dj_nc_chart_a_ne_zero : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (U : Scheme.{u}) (e : U ⟶ Z') (m : U ⟶ Spec (.of (wcNcRing W 0))) (x' : ↥U), Etale e → Etale m → m ≫ wcNcStr W 0 = e ≫ u' → Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 0) ∈ PrimeSpectrum.asIdeal (m x') → Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 1) ∈ PrimeSpectrum.asIdeal (m x') → (∀ z : ↥Z', u' z ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → ∃ V : Z'.Opens, z ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ u')) → False :=
by
  intro Ω _ W Z' u' U e m x' he hm hcomm h0 h1 Hgen
  classical
  haveI := he
  haveI := hm

  obtain ⟨ε, hε⟩ : ∃ ε : wcNcRing W 0 →+* ↥W, ∀ P : MvPolynomial (Fin 2) ↥W,
      ε (Ideal.Quotient.mk (wcNcIdeal W 0) P) = MvPolynomial.aeval (fun _ : Fin 2 => (0 : ↥W)) P :=
    ⟨Ideal.Quotient.lift (wcNcIdeal W 0) (MvPolynomial.aeval (fun _ : Fin 2 => (0 : ↥W))).toRingHom
      (by
        intro p hp
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
        simp), fun P => Ideal.Quotient.lift_mk _ _ _⟩
  have hεX : ∀ i : Fin 2, ε (Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X i)) = 0 := by
    intro i; rw [hε]; simp
  have hmkC : ∀ w : ↥W, Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.C w) =
      algebraMap ↥W (wcNcRing W 0) w := fun w => rfl
  have hεC : ∀ w : ↥W, ε (algebraMap ↥W (wcNcRing W 0) w) = w := by
    intro w; rw [← hmkC, hε]; simp

  obtain ⟨ξ, hξ⟩ : ∃ ξ : ↥(Spec (.of (wcNcRing W 0))), PrimeSpectrum.asIdeal ξ = RingHom.ker ε :=
    ⟨⟨RingHom.ker ε, RingHom.ker_isPrime ε⟩, rfl⟩

  have hmin : ∀ p : PrimeSpectrum (wcNcRing W 0),
      Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 0) ∈ p.asIdeal →
      Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X 1) ∈ p.asIdeal →
      RingHom.ker ε ≤ p.asIdeal := by
    intro p hp0 hp1
    have key : ∀ P : MvPolynomial (Fin 2) ↥W, Ideal.Quotient.mk (wcNcIdeal W 0) P -
        algebraMap ↥W (wcNcRing W 0) (ε (Ideal.Quotient.mk (wcNcIdeal W 0) P)) ∈ p.asIdeal := by
      intro P
      refine MvPolynomial.induction_on (motive := fun P => Ideal.Quotient.mk (wcNcIdeal W 0) P -
        algebraMap ↥W (wcNcRing W 0) (ε (Ideal.Quotient.mk (wcNcIdeal W 0) P)) ∈ p.asIdeal)
        P ?_ ?_ ?_
      · intro a
        rw [hmkC, hεC, sub_self]
        exact p.asIdeal.zero_mem
      · intro P Q hP hQ
        have e1 : Ideal.Quotient.mk (wcNcIdeal W 0) (P + Q) -
            algebraMap ↥W (wcNcRing W 0) (ε (Ideal.Quotient.mk (wcNcIdeal W 0) (P + Q))) =
            (Ideal.Quotient.mk (wcNcIdeal W 0) P -
              algebraMap ↥W (wcNcRing W 0) (ε (Ideal.Quotient.mk (wcNcIdeal W 0) P))) +
            (Ideal.Quotient.mk (wcNcIdeal W 0) Q -
              algebraMap ↥W (wcNcRing W 0) (ε (Ideal.Quotient.mk (wcNcIdeal W 0) Q))) := by
          rw [map_add, map_add, map_add]; ring
        rw [e1]
        exact p.asIdeal.add_mem hP hQ
      · intro P n _
        have hn : Ideal.Quotient.mk (wcNcIdeal W 0) (MvPolynomial.X n) ∈ p.asIdeal := by
          fin_cases n
          · exact hp0
          · exact hp1
        rw [map_mul, map_mul, hεX, mul_zero, map_zero, sub_zero]
        exact p.asIdeal.mul_mem_left _ hn
    intro b hb
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective b
    have h := key P
    rw [RingHom.mem_ker.mp hb, map_zero, sub_zero] at h
    exact h

  have hgen : wcNcStr W 0 ξ ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    obtain ⟨P₀⟩ : Nonempty (PrimeSpectrum Ω) := inferInstance
    have hb : P₀.asIdeal = ⊥ := (Ideal.eq_bot_or_top _).resolve_right P₀.isPrime.ne_top
    refine ⟨P₀, ?_⟩
    apply PrimeSpectrum.ext
    ext w
    show w ∈ Ideal.comap (algebraMap ↥W Ω) P₀.asIdeal ↔
      w ∈ Ideal.comap (algebraMap ↥W (wcNcRing W 0)) (PrimeSpectrum.asIdeal ξ)
    rw [hξ, Ideal.mem_comap, Ideal.mem_comap, RingHom.mem_ker, hεC, hb, Ideal.mem_bot]
    constructor
    · intro h; exact Subtype.ext h
    · intro h; rw [h, map_zero]

  have hle : PrimeSpectrum.asIdeal ξ ≤ PrimeSpectrum.asIdeal (m x') := by
    rw [hξ]
    exact hmin (m x') h0 h1
  have hspec : ξ ⤳ m x' :=
    (PrimeSpectrum.le_iff_specializes (R := wcNcRing W 0) ξ (m x')).mp hle
  have hopen : IsOpen (Set.range m) := (Scheme.Hom.isOpenMap m).isOpen_range
  obtain ⟨ũ, hũ⟩ : ξ ∈ Set.range m := hspec.mem_open hopen ⟨x', rfl⟩

  have hue : u' (e ũ) = wcNcStr W 0 ξ := by
    rw [← Scheme.Hom.comp_apply, ← hcomm, Scheme.Hom.comp_apply, hũ]
  obtain ⟨V, hV, hVsm⟩ := Hgen (e ũ) (hue ▸ hgen)
  haveI := hVsm
  have hO : ũ ∈ e ⁻¹ᵁ V := hV

  have hsmO : Smooth ((e ⁻¹ᵁ V).ι ≫ m ≫ wcNcStr W 0) := by
    have h1 : (e ⁻¹ᵁ V).ι ≫ m ≫ wcNcStr W 0 = (e ∣_ V) ≫ V.ι ≫ u' := by
      rw [hcomm, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    rw [h1]
    haveI : Smooth (V.ι ≫ u') := SmoothOfRelativeDimension.smooth 1 _
    infer_instance

  have hgen_eq : (∑ p : Fin 2, ∑ q : Fin 2,
      MvPolynomial.C ((!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W) p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C 0 : MvPolynomial (Fin 2) ↥W) =
      MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C 0 := by
    simp [Fin.sum_univ_two]
  have hI : wcQuadModelIdeal ↥W 2 0 (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W) = wcNcIdeal W 0 := by
    unfold wcQuadModelIdeal wcNcIdeal
    rw [hgen_eq]
  have hdet : IsUnit ((!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W) +
      (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W).transpose).det := by
    have : ((!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W) +
        (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W).transpose).det = -1 := by
      simp [Matrix.det_fin_two]
    rw [this]
    exact isUnit_one.neg
  obtain ⟨κ, hκ⟩ : ∃ κ : wcQuadModelRing ↥W 2 0 (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W) ≃ₐ[↥W]
      wcNcRing W 0, κ = Ideal.quotientEquivAlgOfEq ↥W hI := ⟨_, rfl⟩
  have hκmk : ∀ P, κ (Ideal.Quotient.mk (wcQuadModelIdeal ↥W 2 0
      (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W)) P) = Ideal.Quotient.mk (wcNcIdeal W 0) P := by
    intro P; rw [hκ]; exact Ideal.quotientEquivAlgOfEq_mk ↥W hI P
  obtain ⟨ι, hι⟩ : ∃ ι : Spec (.of (wcNcRing W 0)) ⟶
      Spec (.of (wcQuadModelRing ↥W 2 0 (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W))),
      ι = Spec.map κ.toRingEquiv.toCommRingCatIso.hom := ⟨_, rfl⟩
  haveI : IsIso ι := by rw [hι]; infer_instance
  have hιstr : ι ≫ wcQuadModelStr ↥W 2 0 (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W) =
      wcNcStr W 0 := by
    rw [hι, wcQuadModelStr, wcNcStr, ← Spec.map_comp]
    congr 1
    ext w
    exact κ.commutes w
  have hvert : ∀ q, Ideal.Quotient.mk (wcQuadModelIdeal ↥W 2 0
      (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ↥W)) (MvPolynomial.X q) ∈ ((m ≫ ι) ũ).asIdeal := by
    intro q
    have hφ : (m ≫ ι) ũ = ι ξ := by rw [Scheme.Hom.comp_apply, hũ]
    rw [hφ, hι]
    show κ (Ideal.Quotient.mk _ (MvPolynomial.X q)) ∈ PrimeSpectrum.asIdeal ξ
    rw [hξ, RingHom.mem_ker, hκmk]
    exact hεX q
  exact wc_quad_model_vertex_not_smooth ↥W 2 (by norm_num) 0 _ hdet (m ≫ ι)
    (𝟙 (Spec (.of ↥W))) ũ hvert
    ⟨e ⁻¹ᵁ V, hO, by simpa only [Category.comp_id, Category.assoc, hιstr] using hsmO⟩

theorem wcpa_dj_nc_henselian_section_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (X U : Scheme.{u}) (e : U ⟶ X) (Δ : Spec (.of ↥W) ⟶ X) (x' : ↥U), IsAlgClosed (IsLocalRing.ResidueField ↥W) → Etale e → e x' = Δ (IsLocalRing.closedPoint ↥W) → ∃ ΔU : Spec (.of ↥W) ⟶ U, ΔU ≫ e = Δ ∧ ΔU (IsLocalRing.closedPoint ↥W) = x' :=
by
  intro Ω _ _ W X U e Δ x' hk he hex
  haveI := he
  haveI : HenselianLocalRing ↥W := wcpa_dj_lmga_valuation_henselian Ω W
  haveI : IsSepClosed (IsLocalRing.ResidueField ↥W) := inferInstance
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h hfg x
    rw [← Scheme.Hom.comp_apply, hfg]
  obtain ⟨O, hxO, hiso⟩ := wc_etale_fibre_point_isolated e x'
  haveI : Etale (O.ι ≫ e) := inferInstance
  have hxr : x' ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hxO
  obtain ⟨w₀, hw₀x⟩ := hxr
  have hw₀ : (O.ι ≫ e) w₀ = Δ (IsLocalRing.closedPoint ↥W) := by
    rw [← ptw (rfl : O.ι ≫ e = O.ι ≫ e) w₀, hw₀x]
    exact hex
  obtain ⟨σ, hσ⟩ := wc_strictHensel_etale_point_lift ↥W Δ (O.ι ≫ e) w₀ hw₀
  have hcomm : (σ ≫ O.ι) ≫ e = Δ := by rw [Category.assoc, hσ]
  refine ⟨σ ≫ O.ι, hcomm, hiso _ ?_ ?_⟩
  · have h1 := ptw (rfl : σ ≫ O.ι = σ ≫ O.ι) (IsLocalRing.closedPoint ↥W)
    have h2 : O.ι (σ (IsLocalRing.closedPoint ↥W)) ∈ O := by
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
      exact ⟨_, rfl⟩
    rwa [h1] at h2
  · exact (ptw hcomm _).trans hex.symm

theorem wcpa_dj_nc_point_normal_form : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (a : ↥W) (σ : Spec (.of ↥W) ⟶ Spec (.of (wcNcRing W a))), a ≠ 0 → σ ≫ wcNcStr W a = 𝟙 _ → Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) ∈ PrimeSpectrum.asIdeal (σ (IsLocalRing.closedPoint ↥W)) → Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) ∈ PrimeSpectrum.asIdeal (σ (IsLocalRing.closedPoint ↥W)) → ∃ (x₀ q : ↥W) (ι : Spec (.of (wcNcRing W a)) ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q))))), IsIso ι ∧ ι ≫ wcNcStr W (x₀ * (x₀ * q)) = wcNcStr W a ∧ σ ≫ ι = wcNcSec W x₀ (x₀ * q) ∧ x₀ ≠ 0 ∧ x₀ ∈ IsLocalRing.maximalIdeal ↥W :=
by
  intro Ω _ W a σ ha hσ h0 h1
  classical
  obtain ⟨φ₀, rfl⟩ := Spec.map_surjective σ

  have hφalg : φ₀.hom.comp (algebraMap ↥W (wcNcRing W a)) = RingHom.id ↥W := by
    have h := hσ
    rw [wcNcStr, ← Spec.map_comp, ← Spec.map_id] at h
    have h2 := congrArg CommRingCat.Hom.hom (Spec.map_injective h)
    simpa using h2
  have hφr : ∀ r : ↥W, φ₀.hom (algebraMap ↥W (wcNcRing W a) r) = r := fun r =>
    RingHom.congr_fun hφalg r

  have hmk : Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0) *
      Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1) =
      algebraMap ↥W (wcNcRing W a) a := by
    rw [← map_mul, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.eq]
    exact Ideal.mem_span_singleton_self _
  obtain ⟨x', hx'⟩ : ∃ x', φ₀.hom (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 0)) = x' :=
    ⟨_, rfl⟩
  obtain ⟨y', hy'⟩ : ∃ y', φ₀.hom (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X 1)) = y' :=
    ⟨_, rfl⟩
  have hprod : x' * y' = a := by
    rw [← hx', ← hy', ← map_mul, hmk, hφr]
  have hxm : x' ∈ IsLocalRing.maximalIdeal ↥W := by rw [← hx']; exact h0
  have hym : y' ∈ IsLocalRing.maximalIdeal ↥W := by rw [← hy']; exact h1
  have hx0 : x' ≠ 0 := by
    rintro rfl; apply ha; rw [← hprod, zero_mul]
  have hy0 : y' ≠ 0 := by
    rintro rfl; apply ha; rw [← hprod, mul_zero]

  have key : ∀ (x₀ q : ↥W) (π : Fin 2 ≃ Fin 2), x₀ * (x₀ * q) = a →
      (MvPolynomial.X (π 0) * MvPolynomial.X (π 1) : MvPolynomial (Fin 2) ↥W) =
        MvPolynomial.X 0 * MvPolynomial.X 1 →
      φ₀.hom (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X (π 0))) = x₀ →
      φ₀.hom (Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.X (π 1))) = x₀ * q →
      ∃ ι : Spec (.of (wcNcRing W a)) ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q)))),
        IsIso ι ∧ ι ≫ wcNcStr W (x₀ * (x₀ * q)) = wcNcStr W a ∧
          Spec.map φ₀ ≫ ι = wcNcSec W x₀ (x₀ * q) := by
    intro x₀ q π ha' hπ hx hy
    obtain ⟨R, hR⟩ : ∃ R : MvPolynomial (Fin 2) ↥W ≃+* MvPolynomial (Fin 2) ↥W,
        ∀ p, R p = MvPolynomial.rename π p :=
      ⟨(MvPolynomial.renameEquiv ↥W π).toRingEquiv, fun p => rfl⟩
    have hgen : (R : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W)
        (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (x₀ * (x₀ * q))) =
        MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C a := by
      rw [RingEquiv.coe_toRingHom, hR, map_sub, map_mul, MvPolynomial.rename_X,
        MvPolynomial.rename_X, MvPolynomial.rename_C, hπ, ha']
    have hI : wcNcIdeal W a =
        Ideal.map (R : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W)
          (wcNcIdeal W (x₀ * (x₀ * q))) := by
      rw [wcNcIdeal, wcNcIdeal, Ideal.map_span, Set.image_singleton, hgen]
    obtain ⟨e, he⟩ : ∃ e : wcNcRing W (x₀ * (x₀ * q)) ≃+* wcNcRing W a,
        ∀ p, e (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) p) =
          Ideal.Quotient.mk (wcNcIdeal W a) (MvPolynomial.rename π p) :=
      ⟨Ideal.quotientEquiv (wcNcIdeal W (x₀ * (x₀ * q))) (wcNcIdeal W a) R hI, fun p => by
        rw [Ideal.quotientEquiv_mk, ← hR]⟩
    refine ⟨Spec.map e.toCommRingCatIso.hom, inferInstance, ?_, ?_⟩
    · rw [wcNcStr, wcNcStr, ← Spec.map_comp]
      congr 1
      ext r
      simp only [RingEquiv.toCommRingCatIso_hom, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
        RingHom.comp_apply, RingEquiv.coe_toRingHom]
      rw [← Ideal.Quotient.mk_algebraMap, he, ← Ideal.Quotient.mk_algebraMap]
      congr 1
      exact (MvPolynomial.renameEquiv ↥W π).commutes r
    · rw [wcNcSec, ← Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingEquiv.toCommRingCatIso_hom, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
          RingHom.comp_apply, RingEquiv.coe_toRingHom]
        rw [he, MvPolynomial.rename_C, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap,
          hφr]
        simp [wcNcSecHom]
      · intro i
        simp only [RingEquiv.toCommRingCatIso_hom, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
          RingHom.comp_apply, RingEquiv.coe_toRingHom]
        rw [he, MvPolynomial.rename_X]
        fin_cases i
        · simp [wcNcSecHom, hx]
        · simp [wcNcSecHom, hy]
  rcases ValuationRing.dvd_total x' y' with ⟨q, hq⟩ | ⟨q, hq⟩
  · obtain ⟨ι, h1, h2, h3⟩ := key x' q (Equiv.refl _) (by rw [← hq]; exact hprod) rfl hx'
      (by rw [← hq]; exact hy')
    exact ⟨x', q, ι, h1, h2, h3, hx0, hxm⟩
  · obtain ⟨ι, h1, h2, h3⟩ := key y' q (Equiv.swap 0 1) (by rw [← hq, mul_comm]; exact hprod)
      (by rw [Equiv.swap_apply_left, Equiv.swap_apply_right, mul_comm])
      (by rw [Equiv.swap_apply_left]; exact hy')
      (by rw [Equiv.swap_apply_right, hx', hq])
    exact ⟨y', q, ι, h1, h2, h3, hy0, hym⟩

theorem wcpa_dj_nc_shrink_kernel : ∀ (T X U : Scheme.{u}) (e : U ⟶ X) (Δ : T ⟶ X) (ΔU : T ⟶ U), Etale e → IsClosedImmersion Δ → ΔU ≫ e = Δ → ∃ O : U.Opens, Set.range ΔU ⊆ (O : Set U) ∧ ∀ (O' : U.Opens) (ΔO : T ⟶ O'), O' ≤ O → ΔO ≫ O'.ι = ΔU → (Scheme.Hom.ker Δ).comap (O'.ι ≫ e) = Scheme.Hom.ker ΔO :=
by
  intro T X U e Δ ΔU he hΔ hcomm
  haveI := he
  haveI := hΔ
  have ptw2 : ∀ {A B B' C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {f' : A ⟶ B'} {g' : B' ⟶ C},
      f ≫ g = f' ≫ g' → ∀ x, g (f x) = g' (f' x) := by
    intro A B B' C f g f' g' h x
    rw [← Scheme.Hom.comp_apply, h, Scheme.Hom.comp_apply]
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h e x
    rw [← Scheme.Hom.comp_apply, e]

  have secOI : ∀ {Y P E : Scheme.{u}} (π : P ⟶ E) [Etale π] (j : Y ⟶ E) [IsOpenImmersion j]
      (σ : Y ⟶ P), σ ≫ π = j → IsOpenImmersion σ := by
    intro Y P E π _ j _ σ h
    haveI : IsOpenImmersion (σ ≫ π) := by rw [h]; infer_instance
    haveI hL : IsOpenImmersion (Limits.pullback.lift (𝟙 Y) σ (by simp) :
        Y ⟶ Limits.pullback (σ ≫ π) π) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (Limits.pullback_lift_diagonal_isPullback σ π)
        (FormallyUnramified.isOpenImmersion_diagonal π)
    have e : (Limits.pullback.lift (𝟙 Y) σ (by simp) : Y ⟶ Limits.pullback (σ ≫ π) π) ≫
        Limits.pullback.snd (σ ≫ π) π = σ := Limits.pullback.lift_snd _ _ _
    rw [← e]
    infer_instance

  have s3 : ∀ (V : Scheme.{u}) (f : V ⟶ X) (ΔV : T ⟶ V), Etale f → ΔV ≫ f = Δ →
      (∀ p : ↥(Limits.pullback f Δ), Limits.pullback.fst f Δ p ∈ Set.range ΔV) →
      (Scheme.Hom.ker Δ).comap f = Scheme.Hom.ker ΔV := by
    intro V f ΔV hf hV hpts
    haveI := hf
    have w : ΔV ≫ f = 𝟙 T ≫ Δ := by rw [Category.id_comp, hV]
    have hφfst : Limits.pullback.lift ΔV (𝟙 T) w ≫ Limits.pullback.fst f Δ = ΔV :=
      Limits.pullback.lift_fst _ _ _
    have hφsnd : Limits.pullback.lift ΔV (𝟙 T) w ≫ Limits.pullback.snd f Δ = 𝟙 T :=
      Limits.pullback.lift_snd _ _ _
    haveI : IsOpenImmersion (Limits.pullback.lift ΔV (𝟙 T) w) :=
      @secOI T _ T (Limits.pullback.snd f Δ) inferInstance (𝟙 T)
        (IsOpenImmersion.of_isIso (𝟙 T)) _ hφsnd
    have hinj : Function.Injective (Limits.pullback.fst f Δ) :=
      (Limits.pullback.fst f Δ).isClosedEmbedding.isEmbedding.injective
    haveI : Surjective (Limits.pullback.lift ΔV (𝟙 T) w) := ⟨fun p => by
      obtain ⟨t, ht⟩ := hpts p
      refine ⟨t, hinj ?_⟩
      rw [ptw hφfst, ht]⟩
    haveI : IsIso (Limits.pullback.lift ΔV (𝟙 T) w) :=
      (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, inferInstance⟩
    rw [← hφfst, Scheme.Hom.ker_comp_of_isIso,
      Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]

  have w : ΔU ≫ e = 𝟙 T ≫ Δ := by rw [Category.id_comp, hcomm]
  have hsfst : Limits.pullback.lift ΔU (𝟙 T) w ≫ Limits.pullback.fst e Δ = ΔU :=
    Limits.pullback.lift_fst _ _ _
  have hssnd : Limits.pullback.lift ΔU (𝟙 T) w ≫ Limits.pullback.snd e Δ = 𝟙 T :=
    Limits.pullback.lift_snd _ _ _
  haveI : IsOpenImmersion (Limits.pullback.lift ΔU (𝟙 T) w) :=
    @secOI T _ T (Limits.pullback.snd e Δ) inferInstance (𝟙 T)
      (IsOpenImmersion.of_isIso (𝟙 T)) _ hssnd
  have hfce := (Limits.pullback.fst e Δ).isClosedEmbedding
  have hinj : Function.Injective (Limits.pullback.fst e Δ) := hfce.isEmbedding.injective
  have hKcl : IsClosed (Limits.pullback.fst e Δ ''
      (Set.range (Limits.pullback.lift ΔU (𝟙 T) w))ᶜ) :=
    hfce.isClosedMap _
      (Limits.pullback.lift ΔU (𝟙 T) w).isOpenEmbedding.isOpen_range.isClosed_compl
  refine ⟨⟨(Limits.pullback.fst e Δ '' (Set.range (Limits.pullback.lift ΔU (𝟙 T) w))ᶜ)ᶜ,
    hKcl.isOpen_compl⟩, ?_, ?_⟩
  · rintro _ ⟨t, rfl⟩
    show ΔU t ∉ Limits.pullback.fst e Δ '' (Set.range (Limits.pullback.lift ΔU (𝟙 T) w))ᶜ
    rintro ⟨c, hc, hct⟩
    apply hc
    refine ⟨t, hinj ?_⟩
    rw [ptw hsfst, hct]
  · intro O' ΔO hO'O hΔO
    haveI hOι : IsOpenImmersion O'.ι := Scheme.Opens.instIsOpenImmersionι O'
    haveI hOe : Etale O'.ι := Etale.instOfIsOpenImmersion O'.ι
    apply s3 O' (O'.ι ≫ e) ΔO (Etale.etale_comp O'.ι e) (by rw [← Category.assoc, hΔO, hcomm])
    intro p'
    have hψ : Limits.pullback.map (O'.ι ≫ e) Δ e Δ O'.ι (𝟙 T) (𝟙 X) (Category.comp_id _)
        (by simp) ≫ Limits.pullback.fst e Δ = Limits.pullback.fst (O'.ι ≫ e) Δ ≫ O'.ι :=
      Limits.pullback.lift_fst _ _ _
    have hmem : Limits.pullback.fst e Δ (Limits.pullback.map (O'.ι ≫ e) Δ e Δ O'.ι (𝟙 T) (𝟙 X)
        (Category.comp_id _) (by simp) p') ∈ (O' : Set U) := by
      rw [ptw2 hψ, ← Scheme.Opens.range_ι O']
      exact ⟨_, rfl⟩
    have hmemO := hO'O hmem
    by_cases hr : Limits.pullback.map (O'.ι ≫ e) Δ e Δ O'.ι (𝟙 T) (𝟙 X)
        (Category.comp_id _) (by simp) p' ∈ Set.range (Limits.pullback.lift ΔU (𝟙 T) w)
    · obtain ⟨t, ht⟩ := hr
      refine ⟨t, O'.ι.isOpenEmbedding.injective ?_⟩
      rw [ptw hΔO, ← ptw2 hψ, ← ht]
      exact (ptw hsfst t).symm
    · exact (hmemO ⟨_, hr, rfl⟩).elim

theorem wcpa_dj_nc_etale_node_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (Δ : Spec (.of ↥W) ⟶ Z'), wcpaDjSemistable u' → LocallyOfFinitePresentation u' → Δ ≫ u' = 𝟙 _ → (∀ z : ↥Z', u' z ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → ∃ U : Z'.Opens, z ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → (¬ ∃ U : Z'.Opens, Δ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → ∃ (U : Scheme.{u}) (e : U ⟶ Z') (x₀ q : ↥W) (m : U ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q))))) (ΔU : Spec (.of ↥W) ⟶ U), Etale e ∧ Etale m ∧ m ≫ wcNcStr W (x₀ * (x₀ * q)) = e ≫ u' ∧ x₀ ≠ 0 ∧ x₀ ∈ IsLocalRing.maximalIdeal ↥W ∧ ΔU ≫ e = Δ ∧ ΔU ≫ m = wcNcSec W x₀ (x₀ * q) ∧ (Scheme.Hom.ker Δ).comap e = Scheme.Hom.ker ΔU ∧ (Scheme.Hom.ker (wcNcSec W x₀ (x₀ * q))).comap m = Scheme.Hom.ker ΔU :=
by
  intro Ω _ _ W _hW Z' u' Δ hss hlfp hΔ Hgen hns
  classical
  have hk : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h e x
    rw [← Scheme.Hom.comp_apply, e]
  have hus : u' (Δ (IsLocalRing.closedPoint ↥W)) = IsLocalRing.closedPoint ↥W :=
    (ptw hΔ _).trans rfl
  have hnode := wcpa_dj_nc_nonsmooth_fibre_node Ω W Z' u' _ hk hss hlfp hus hns
  obtain ⟨U, e, a, m, x', he, hm, hme, hex, hx0, hx1⟩ :=
    wcpa_dj_nc_chart_exists Ω W Z' u' _ hk hss.1 hlfp hus hnode
  have ha : a ≠ 0 := by
    rintro rfl
    exact wcpa_dj_nc_chart_a_ne_zero Ω W Z' u' U e m x' he hm hme hx0 hx1 Hgen
  obtain ⟨ΔU, hΔUe, hΔUs⟩ := wcpa_dj_nc_henselian_section_lift Ω W Z' U e Δ x' hk he hex
  have hσ : (ΔU ≫ m) ≫ wcNcStr W a = 𝟙 _ := by
    rw [Category.assoc, hme, ← Category.assoc, hΔUe, hΔ]
  have hσs : (ΔU ≫ m) (IsLocalRing.closedPoint ↥W) = m x' :=
    (ptw (rfl : ΔU ≫ m = ΔU ≫ m) _).symm.trans (congrArg (fun z => m z) hΔUs)
  obtain ⟨x₀, q, ι, hι, hιstr, hσι, hx0ne, hx0m⟩ :=
    wcpa_dj_nc_point_normal_form Ω W a (ΔU ≫ m) ha hσ (by rw [hσs]; exact hx0)
      (by rw [hσs]; exact hx1)
  haveI := hι
  haveI := he
  haveI := hm
  haveI := hss.2.1
  have hm'et : Etale (m ≫ ι) := inferInstance
  have hm'str : (m ≫ ι) ≫ wcNcStr W (x₀ * (x₀ * q)) = e ≫ u' := by
    rw [Category.assoc, hιstr, hme]
  have hsec : ΔU ≫ (m ≫ ι) = wcNcSec W x₀ (x₀ * q) := by
    rw [← Category.assoc, hσι]
  haveI hΔci : IsClosedImmersion Δ := by
    haveI : IsClosedImmersion (Δ ≫ u') := by rw [hΔ]; infer_instance
    exact IsClosedImmersion.of_comp Δ u'
  haveI hsci : IsClosedImmersion (wcNcSec W x₀ (x₀ * q)) := by
    haveI : IsClosedImmersion (wcNcSec W x₀ (x₀ * q) ≫ wcNcStr W (x₀ * (x₀ * q))) := by
      rw [← hsec, Category.assoc, hm'str, ← Category.assoc, hΔUe, hΔ]
      infer_instance
    exact IsClosedImmersion.of_comp _ (wcNcStr W (x₀ * (x₀ * q)))
  obtain ⟨O₁, hO₁, hO₁k⟩ := wcpa_dj_nc_shrink_kernel _ _ _ e Δ ΔU he hΔci hΔUe
  obtain ⟨O₂, hO₂, hO₂k⟩ :=
    wcpa_dj_nc_shrink_kernel _ _ _ (m ≫ ι) (wcNcSec W x₀ (x₀ * q)) ΔU hm'et hsci hsec
  have hrange : Set.range ΔU ⊆ Set.range (O₁ ⊓ O₂).ι := by
    rw [Scheme.Opens.range_ι]
    intro z hz
    exact ⟨hO₁ hz, hO₂ hz⟩
  have hΔO : IsOpenImmersion.lift (O₁ ⊓ O₂).ι ΔU hrange ≫ (O₁ ⊓ O₂).ι = ΔU :=
    IsOpenImmersion.lift_fac _ _ _
  refine ⟨(O₁ ⊓ O₂).toScheme, (O₁ ⊓ O₂).ι ≫ e, x₀, q, (O₁ ⊓ O₂).ι ≫ (m ≫ ι),
    IsOpenImmersion.lift (O₁ ⊓ O₂).ι ΔU hrange, inferInstance, inferInstance, ?_, hx0ne, hx0m,
    ?_, ?_, ?_, ?_⟩
  · rw [Category.assoc, hm'str, Category.assoc]
  · rw [← Category.assoc, hΔO, hΔUe]
  · rw [← Category.assoc, hΔO, hsec]
  · exact hO₁k _ _ inf_le_left hΔO
  · exact hO₂k _ _ inf_le_right hΔO

theorem wcpa_dj_ncmb_chart_data_x0 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (x₀ q : ↥W), x₀ ≠ 0 → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q))))) (U : Fin 3 → M'.Opens) (t : ∀ l : Fin 3, Fin 3 → Γ(M', U l)), wcBpChartHyp r₀ (wcNcmbGen W (x₀ * (x₀ * q)) x₀) U t → ∃ (h : Spec (.of (wcNcRing W q)) ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q))))) (τ : Fin 3 → Γ(Spec (.of (wcNcRing W q)), ⊤)) (ρ : Spec (.of ↥W) ⟶ Spec (.of (wcNcRing W q))), h ≫ wcNcStr W (x₀ * (x₀ * q)) = wcNcStr W q ∧ (∀ j, h.appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ j) = τ j * h.appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2)) ∧ h.appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) ∈ nonZeroDivisors Γ(Spec (.of (wcNcRing W q)), ⊤) ∧ (∀ s : Γ(Spec (.of (wcNcRing W q)), ⊤), s ∈ Subring.closure (Set.range h.appTop.hom ∪ Set.range τ)) ∧ (∃ φ : Γ(Spec (.of (wcNcRing W q)), ⊤) →+* Γ(M', U 2), φ.comp h.appTop.hom = (r₀.appLE ⊤ (U 2) (by simp)).hom ∧ ∀ j, φ (τ j) = t 2 j) ∧ ρ ≫ h = wcNcSec W x₀ (x₀ * q) ∧ ρ (IsLocalRing.closedPoint ↥W) ∈ (Spec (.of (wcNcRing W q))).basicOpen ((Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0))) :=
by
  intro Ω _ W x₀ q hx0 M' r₀ U t hU
  classical

  have ΓR1 : ∀ y : Γ(Spec (.of (wcNcRing W q)), ⊤),
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
        ((Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom y) = y := fun y => by simp
  have ΓR2 : ∀ y : wcNcRing W q,
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom
        ((Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom y) = y := fun y => by simp
  have ΓB1 : ∀ y : Γ(Spec (.of (wcNcRing W (x₀ * (x₀ * q)))), ⊤),
      (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).hom.hom y) = y := fun y => by simp

  obtain ⟨θ, hθC, hθ0, hθ1⟩ : ∃ θ : wcNcRing W (x₀ * (x₀ * q)) →+* wcNcRing W q,
      (∀ w, θ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C w)) =
        Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C w)) ∧
      θ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0)) =
        Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C x₀) *
          Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0) ∧
      θ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1)) =
        Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C x₀) *
          Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 1) := by
    refine ⟨Ideal.Quotient.lift _ ((Ideal.Quotient.mk (wcNcIdeal W q)).comp
      (MvPolynomial.eval₂Hom MvPolynomial.C
        ![MvPolynomial.C x₀ * MvPolynomial.X 0, MvPolynomial.C x₀ * MvPolynomial.X 1])) ?_,
      ?_, ?_, ?_⟩
    · intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
      apply Ideal.mul_mem_left
      have hmem : MvPolynomial.C (x₀ * x₀) *
          (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C q) ∈ wcNcIdeal W q :=
        Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      convert hmem using 1
      simp only [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, MvPolynomial.C_mul]
      ring
    · intro w
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
    · rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', ← map_mul]
      rfl
    · rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', ← map_mul]
      rfl

  have hθalg : θ.comp (algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q)))) =
      algebraMap ↥W (wcNcRing W q) := by
    refine RingHom.ext fun w => ?_
    rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, hθC,
      ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  obtain ⟨θc, hθcz⟩ : ∃ θc : CommRingCat.of (wcNcRing W (x₀ * (x₀ * q))) ⟶
      CommRingCat.of (wcNcRing W q), ∀ z, θc.hom z = θ z :=
    ⟨@CommRingCat.ofHom (wcNcRing W (x₀ * (x₀ * q))) (wcNcRing W q) _ _ θ, fun z => rfl⟩
  have hcomp : CommRingCat.ofHom (algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q)))) ≫ θc =
      CommRingCat.ofHom (algebraMap ↥W (wcNcRing W q)) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro w
    show θc.hom (algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) w) = algebraMap ↥W (wcNcRing W q) w
    rw [hθcz]
    exact RingHom.congr_fun hθalg w
  have hi : Spec.map θc ≫ wcNcStr W (x₀ * (x₀ * q)) = wcNcStr W q := by
    rw [wcNcStr, wcNcStr, ← Spec.map_comp, hcomp]

  have nat : ∀ z, (Spec.map θc).appTop.hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom z) =
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom (θ z) := by
    intro z
    rw [← hθcz]
    have e := Scheme.ΓSpecIso_inv_naturality θc
    exact (congrArg (fun φ => φ.hom z) e).symm
  have g0 : wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0 =
      (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0)) := rfl
  have g1 : wcNcmbGen W (x₀ * (x₀ * q)) x₀ 1 =
      (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1)) := rfl
  have g2 : wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2 =
      (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C x₀)) := rfl
  have hh0 : (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0) =
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0)) *
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C x₀)) := by
    rw [g0, nat, hθ0, map_mul, mul_comm]
  have hh1 : (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 1) =
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 1)) *
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C x₀)) := by
    rw [g1, nat, hθ1, map_mul, mul_comm]
  have hh2 : (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) =
      (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C x₀)) := by
    rw [g2, nat, hθC]

  obtain ⟨τ, hτ⟩ : ∃ τ : Fin 3 → Γ(Spec (.of (wcNcRing W q)), ⊤),
      τ = ![(Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0)),
        (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 1)), 1] := ⟨_, rfl⟩
  have hτ0 : τ 0 = (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
      (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0)) := by rw [hτ]; rfl
  have hτ1 : τ 1 = (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
      (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 1)) := by rw [hτ]; rfl
  have hτ2 : τ 2 = 1 := by rw [hτ]; rfl

  have hii : ∀ j, (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ j) =
      τ j * (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) := by
    have e0 : (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0) =
        τ 0 * (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) := by
      rw [hh0, hh2, hτ0]
    have e1 : (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 1) =
        τ 1 * (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) := by
      rw [hh1, hh2, hτ1]
    have e2 : (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) =
        τ 2 * (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) := by
      rw [hτ2, one_mul]
    intro j
    fin_cases j
    · exact e0
    · exact e1
    · exact e2

  have nzdP : ∀ p : MvPolynomial (Fin 2) ↥W, p * MvPolynomial.C x₀ ∈ wcNcIdeal W q →
      p ∈ wcNcIdeal W q := by
    intro p hp
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hp
    obtain ⟨s, hs⟩ : ∃ s : Fin 2 →₀ ℕ, s = Finsupp.single 0 1 + Finsupp.single 1 1 := ⟨_, rfl⟩
    have hXX : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) ↥W) =
        MvPolynomial.monomial s 1 := by
      rw [hs, MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul]
    have step : ∀ n : Fin 2 →₀ ℕ, g.coeff n - q * g.coeff (n + s) ∈ Ideal.span {x₀} := by
      intro n
      have e : (g * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C q)).coeff (n + s) =
          (p * MvPolynomial.C x₀).coeff (n + s) := by rw [hg]
      rw [mul_sub, hXX, MvPolynomial.coeff_sub, MvPolynomial.coeff_mul_monomial,
        mul_comm g (MvPolynomial.C q), MvPolynomial.coeff_C_mul, mul_comm p,
        MvPolynomial.coeff_C_mul, mul_one] at e
      rw [e]
      exact Ideal.mem_span_singleton.mpr (dvd_mul_right x₀ _)
    have hshift : ∀ n : Fin 2 →₀ ℕ, (n + s) 0 = n 0 + 1 := by
      intro n
      rw [hs, Finsupp.add_apply, Finsupp.add_apply, Finsupp.single_eq_same,
        Finsupp.single_eq_of_ne (by decide), add_zero]
    have P : ∀ k : ℕ, ∀ n : Fin 2 →₀ ℕ, MvPolynomial.degreeOf 0 g < n 0 + k →
        g.coeff n ∈ Ideal.span {x₀} := by
      intro k
      induction k with
      | zero =>
        intro n hn
        have hz : g.coeff n = 0 := by
          by_contra hne
          have := MvPolynomial.monomial_le_degreeOf 0 (MvPolynomial.mem_support_iff.mpr hne)
          omega
        rw [hz]
        exact Ideal.zero_mem _
      | succ k ih =>
        intro n hn
        have h1 := ih (n + s) (by rw [hshift]; omega)
        have h3 := Ideal.add_mem _ (step n) (Ideal.mul_mem_left _ q h1)
        rwa [sub_add_cancel] at h3
    have hcoef : ∀ n, g.coeff n ∈ Ideal.span {x₀} := fun n =>
      P (MvPolynomial.degreeOf 0 g + 1) n (by omega)
    have hgC : g ∈ Ideal.span {(MvPolynomial.C x₀ : MvPolynomial (Fin 2) ↥W)} := by
      have hm : g ∈ Ideal.map (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 2) ↥W)
          (Ideal.span {x₀}) := MvPolynomial.mem_map_C_iff.mpr hcoef
      rwa [Ideal.map_span, Set.image_singleton] at hm
    obtain ⟨g', rfl⟩ := Ideal.mem_span_singleton'.mp hgC
    have hC : (MvPolynomial.C x₀ : MvPolynomial (Fin 2) ↥W) ≠ 0 := by
      rwa [Ne, MvPolynomial.C_eq_zero]
    have hp' : p = g' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C q) := by
      apply mul_right_cancel₀ hC
      rw [← hg]
      ring
    rw [hp']
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  have nzdR : ∀ y : wcNcRing W q,
      y * Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C x₀) = 0 → y = 0 := by
    intro y hy
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (nzdP p hy)
  have hiii : (Spec.map θc).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) ∈
      nonZeroDivisors Γ(Spec (.of (wcNcRing W q)), ⊤) := by
    rw [hh2]
    refine mem_nonZeroDivisors_iff_right.mpr ?_
    intro y hy
    have h1 : (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom y *
        Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C x₀) = 0 := by
      have := congrArg (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom hy
      rwa [map_mul, map_zero, ΓR2] at this
    have h0 := nzdR _ h1
    have := congrArg (Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom h0
    rwa [ΓR1, map_zero] at this

  have hiv : ∀ s : Γ(Spec (.of (wcNcRing W q)), ⊤), s ∈ Subring.closure
      (Set.range (Spec.map θc).appTop.hom ∪ Set.range τ) := by
    intro s
    rw [← ΓR1 s]
    generalize (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom s = z
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
    induction p using MvPolynomial.induction_on with
    | C w =>
      apply Subring.subset_closure
      left
      exact ⟨(Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C w)), by rw [nat, hθC]⟩
    | add p p' hp hp' =>
      rw [map_add, map_add]
      exact Subring.add_mem _ hp hp'
    | mul_X p n hp =>
      rw [map_mul, map_mul]
      refine Subring.mul_mem _ hp ?_
      apply Subring.subset_closure
      right
      fin_cases n
      · exact ⟨0, hτ0⟩
      · exact ⟨1, hτ1⟩

  have h3 := hU.2.2.1
  have hnzd := hU.2.2.2.1 2
  have ht22 : t 2 2 = 1 := by
    apply (mul_cancel_right_mem_nonZeroDivisors hnzd).mp
    rw [one_mul]
    exact (h3 2 2).symm
  have relB : Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0) *
      Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1) =
      Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C x₀) *
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C x₀) *
          Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C q)) := by
    have e : Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0 * MvPolynomial.X 1) =
        Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C (x₀ * (x₀ * q))) := by
      rw [Ideal.Quotient.eq]
      exact Ideal.mem_span_singleton_self _
    rw [MvPolynomial.C_mul, MvPolynomial.C_mul, map_mul, map_mul, map_mul] at e
    exact e
  have hratio : t 2 0 * t 2 1 = (r₀.appLE ⊤ (U 2) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C q))) := by
    have e := congrArg (fun z => (r₀.appLE ⊤ (U 2) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom z)) relB
    simp only [map_mul] at e
    rw [← g0, ← g1, ← g2, h3 2 0, h3 2 1] at e
    apply (mul_cancel_right_mem_nonZeroDivisors hnzd).mp
    apply (mul_cancel_right_mem_nonZeroDivisors hnzd).mp
    linear_combination e
  obtain ⟨Φ, hΦX0, hΦX1, hΦC⟩ : ∃ Φ : wcNcRing W q →+* Γ(M', U 2),
      Φ (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0)) = t 2 0 ∧
      Φ (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 1)) = t 2 1 ∧
      ∀ w, Φ (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C w)) =
        (r₀.appLE ⊤ (U 2) (by simp)).hom
          ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
            (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C w))) := by
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom ((r₀.appLE ⊤ (U 2) (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom.comp
        ((Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q)))).comp MvPolynomial.C)))
      ![t 2 0, t 2 1]) ?_, ?_, ?_, ?_⟩
    · intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, RingHom.comp_apply]
      rw [hratio, sub_self, mul_zero]
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      rfl
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      rfl
    · intro w
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
      rfl
  have gen0 : Φ (θ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0))) =
      (r₀.appLE ⊤ (U 2) (by simp)).hom ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0))) := by
    rw [hθ0, map_mul, hΦC, hΦX0, ← g0, ← g2, h3 2 0, mul_comm]
  have gen1 : Φ (θ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1))) =
      (r₀.appLE ⊤ (U 2) (by simp)).hom ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1))) := by
    rw [hθ1, map_mul, hΦC, hΦX1, ← g1, ← g2, h3 2 1, mul_comm]
  have hΦθ : ∀ z, Φ (θ z) = (r₀.appLE ⊤ (U 2) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom z) := by
    intro z
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
    induction p using MvPolynomial.induction_on with
    | C w => rw [hθC, hΦC]
    | add p p' hp hp' => simp only [map_add, hp, hp']
    | mul_X p n hp =>
      simp only [map_mul]
      rw [hp]
      congr 1
      fin_cases n
      · exact gen0
      · exact gen1
  have hv : ∃ φ : Γ(Spec (.of (wcNcRing W q)), ⊤) →+* Γ(M', U 2),
      φ.comp (Spec.map θc).appTop.hom = (r₀.appLE ⊤ (U 2) (by simp)).hom ∧
      ∀ j, φ (τ j) = t 2 j := by
    refine ⟨Φ.comp (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom, ?_, ?_⟩
    · refine RingHom.ext fun x => ?_
      rw [← ΓB1 x]
      generalize (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).hom.hom x = z
      rw [RingHom.comp_apply, RingHom.comp_apply, nat, ΓR2, hΦθ]
    · have e0 : (Φ.comp (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom) (τ 0) = t 2 0 := by
        rw [RingHom.comp_apply, hτ0, ΓR2, hΦX0]
      have e1 : (Φ.comp (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom) (τ 1) = t 2 1 := by
        rw [RingHom.comp_apply, hτ1, ΓR2, hΦX1]
      have e2 : (Φ.comp (Scheme.ΓSpecIso (.of (wcNcRing W q))).hom.hom) (τ 2) = t 2 2 := by
        rw [hτ2, map_one, ht22]
      intro j
      fin_cases j
      · exact e0
      · exact e1
      · exact e2

  obtain ⟨ev, hevC, hev0, hev1⟩ : ∃ ev : wcNcRing W q →+* ↥W,
      (∀ w, ev (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.C w)) = w) ∧
      ev (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0)) = 1 ∧
      ev (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 1)) = q := by
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom (RingHom.id ↥W) ![1, q]) ?_, ?_, ?_, ?_⟩
    · intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C]
      simp
    · intro w
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
      rfl
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      rfl
    · rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      rfl
  have hevθ : ev.comp θ = wcNcSecHom W x₀ (x₀ * q) := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hθC, hevC]
      simp [wcNcSecHom]
    · have e0 : ((ev.comp θ).comp (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q)))))
          (MvPolynomial.X 0) = ((wcNcSecHom W x₀ (x₀ * q)).comp
            (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))))) (MvPolynomial.X 0) := by
        rw [RingHom.comp_apply, RingHom.comp_apply, hθ0, map_mul, hevC, hev0, mul_one]
        simp [wcNcSecHom]
      have e1 : ((ev.comp θ).comp (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q)))))
          (MvPolynomial.X 1) = ((wcNcSecHom W x₀ (x₀ * q)).comp
            (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))))) (MvPolynomial.X 1) := by
        rw [RingHom.comp_apply, RingHom.comp_apply, hθ1, map_mul, hevC, hev1]
        simp [wcNcSecHom]
      intro i
      fin_cases i
      · exact e0
      · exact e1
  obtain ⟨evc, hevcz⟩ : ∃ evc : CommRingCat.of (wcNcRing W q) ⟶ CommRingCat.of ↥W,
      ∀ z, evc.hom z = ev z := ⟨@CommRingCat.ofHom (wcNcRing W q) ↥W _ _ ev, fun z => rfl⟩
  have hvi : Spec.map evc ≫ Spec.map θc =
      wcNcSec W x₀ (x₀ * q) := by
    have hc2 : θc ≫ evc = CommRingCat.ofHom (wcNcSecHom W x₀ (x₀ * q)) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro z
      show evc.hom (θc.hom z) = wcNcSecHom W x₀ (x₀ * q) z
      rw [hθcz, hevcz]
      exact RingHom.congr_fun hevθ z
    rw [← Spec.map_comp, hc2]
    rfl

  have hvii : Spec.map evc (IsLocalRing.closedPoint ↥W) ∈
      (Spec (.of (wcNcRing W q))).basicOpen ((Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0))) := by
    have e : (Spec.map evc).appTop.hom
        ((Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0))) = 1 := by
      have en := Scheme.ΓSpecIso_inv_naturality evc
      have := (congrArg (fun φ => φ.hom
        (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0))) en).symm
      refine this.trans ?_
      show (Scheme.ΓSpecIso (.of ↥W)).inv.hom (evc.hom (Ideal.Quotient.mk (wcNcIdeal W q)
        (MvPolynomial.X 0))) = 1
      rw [hevcz, hev0, map_one]
    have hpre : Spec.map evc ⁻¹ᵁ (Spec (.of (wcNcRing W q))).basicOpen
        ((Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0))) = ⊤ := by
      rw [Scheme.Hom.preimage_basicOpen_top]
      erw [e]
      exact Scheme.basicOpen_one _
    have hmem : (IsLocalRing.closedPoint ↥W : ↥(Spec (.of ↥W))) ∈ Spec.map evc ⁻¹ᵁ
        (Spec (.of (wcNcRing W q))).basicOpen ((Scheme.ΓSpecIso (.of (wcNcRing W q))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W q) (MvPolynomial.X 0))) := by
      rw [hpre]
      trivial
    exact hmem
  exact ⟨Spec.map θc, τ, Spec.map evc, hi, hii, hiii, hiv,
    hv, hvi, hvii⟩

theorem wcpa_dj_ncmb_chart_data_X0 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (x₀ q : ↥W), x₀ ≠ 0 → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q))))) (U : Fin 3 → M'.Opens) (t : ∀ l : Fin 3, Fin 3 → Γ(M', U l)), wcBpChartHyp r₀ (wcNcmbGen W (x₀ * (x₀ * q)) x₀) U t → ∃ (h : Spec (.of (wcNcRing W x₀)) ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q))))) (τ : Fin 3 → Γ(Spec (.of (wcNcRing W x₀)), ⊤)), h ≫ wcNcStr W (x₀ * (x₀ * q)) = wcNcStr W x₀ ∧ (∀ j, h.appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ j) = τ j * h.appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0)) ∧ h.appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0) ∈ nonZeroDivisors Γ(Spec (.of (wcNcRing W x₀)), ⊤) ∧ (∀ s : Γ(Spec (.of (wcNcRing W x₀)), ⊤), s ∈ Subring.closure (Set.range h.appTop.hom ∪ Set.range τ)) ∧ ∃ φ : Γ(Spec (.of (wcNcRing W x₀)), ⊤) →+* Γ(M', U 0), φ.comp h.appTop.hom = (r₀.appLE ⊤ (U 0) (by simp)).hom ∧ ∀ j, φ (τ j) = t 0 j :=
by
  intro Ω _ W x₀ q hx0 M' r₀ U t hU
  classical
  obtain ⟨_, _, hrat, hnzd, _, _⟩ := hU

  have hAB : Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 0) *
      Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 1) =
      Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.C x₀) := by
    rw [← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  have halg : ∀ (c w : ↥W), algebraMap (↥W) (wcNcRing W c) w =
      Ideal.Quotient.mk (wcNcIdeal W c) (MvPolynomial.C w) := fun c w => rfl

  obtain ⟨θ₀, hθX0, hθX1, hθC⟩ : ∃ θ₀ : wcNcRing W (x₀ * (x₀ * q)) →+* wcNcRing W x₀,
      θ₀ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0)) =
        Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 0) ∧
      θ₀ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1)) =
        Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.C q) *
          Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 0) *
          Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 1) ^ 2 ∧
      ∀ w : ↥W, θ₀ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C w)) =
        Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.C w) := by
    let θt : MvPolynomial (Fin 2) ↥W →+* wcNcRing W x₀ :=
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (wcNcIdeal W x₀)).comp MvPolynomial.C)
        ![Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 0),
          Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.C q) *
            Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 0) *
            Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 1) ^ 2]
    have hθt : ∀ p ∈ wcNcIdeal W (x₀ * (x₀ * q)), θt p = 0 := by
      intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      have hF : θt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C (x₀ * (x₀ * q))) = 0 := by
        simp only [θt, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          RingHom.comp_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        rw [← hAB]
        ring
      rw [map_mul, hF, mul_zero]
    refine ⟨Ideal.Quotient.lift (wcNcIdeal W (x₀ * (x₀ * q))) θt hθt, ?_, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk]
      simp [θt]
    · rw [Ideal.Quotient.lift_mk]
      simp [θt]
    · intro w
      rw [Ideal.Quotient.lift_mk]
      simp [θt]
  let θc : CommRingCat.of (wcNcRing W (x₀ * (x₀ * q))) ⟶ CommRingCat.of (wcNcRing W x₀) :=
    CommRingCat.ofHom θ₀
  let h : Spec (.of (wcNcRing W x₀)) ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q)))) :=
    Spec.map θc
  have hnat : ∀ z, h.appTop.hom ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom z) =
      (Scheme.ΓSpecIso (.of (wcNcRing W x₀))).inv.hom (θ₀ z) := by
    intro z
    have e := Scheme.ΓSpecIso_inv_naturality θc
    have e2 := congrArg (fun φ => CommRingCat.Hom.hom φ z) e
    simp only [θc, CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e2
    exact e2.symm
  have hδγ : ∀ z : wcNcRing W x₀, (Scheme.ΓSpecIso (.of (wcNcRing W x₀))).hom.hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W x₀))).inv.hom z) = z := fun z => by simp
  have hγδ : ∀ s : Γ(Spec (.of (wcNcRing W x₀)), ⊤), (Scheme.ΓSpecIso (.of (wcNcRing W x₀))).inv.hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W x₀))).hom.hom s) = s := fun s => by simp
  have hγδa : ∀ s : Γ(Spec (.of (wcNcRing W (x₀ * (x₀ * q)))), ⊤),
      (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).hom.hom s) = s := fun s => by simp

  have hAnzd : ∀ y : wcNcRing W x₀,
      y * Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 0) = 0 → y = 0 := by
    intro y hy
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hy
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨σ₀, hσ0, hσ1, hσC⟩ : ∃ σ₀ : MvPolynomial (Fin 2) ↥W →+* MvPolynomial (Fin 2) ↥W,
        σ₀ (MvPolynomial.X 0) = 0 ∧ σ₀ (MvPolynomial.X 1) = MvPolynomial.X 1 ∧
        ∀ r, σ₀ (MvPolynomial.C r) = MvPolynomial.C r :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C ![0, MvPolynomial.X 1], by simp, by simp, by simp⟩
    have hdvd : ∀ f : MvPolynomial (Fin 2) ↥W, MvPolynomial.X 0 ∣ f - σ₀ f := by
      intro f
      induction f using MvPolynomial.induction_on with
      | C r => rw [hσC, sub_self]; exact dvd_zero _
      | add f g hf hg => rw [map_add, add_sub_add_comm]; exact dvd_add hf hg
      | mul_X f n hf =>
        rw [map_mul]
        have e : f * MvPolynomial.X n - σ₀ f * σ₀ (MvPolynomial.X n) =
            (f - σ₀ f) * MvPolynomial.X n + σ₀ f * (MvPolynomial.X n - σ₀ (MvPolynomial.X n)) := by
          ring
        rw [e]
        refine dvd_add (dvd_mul_of_dvd_left hf _) (dvd_mul_of_dvd_right ?_ _)
        fin_cases n
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 0 - σ₀ (MvPolynomial.X 0)
          rw [hσ0, sub_zero]
        · show MvPolynomial.X 0 ∣ MvPolynomial.X 1 - σ₀ (MvPolynomial.X 1)
          rw [hσ1, sub_self]; exact dvd_zero _
    have hσg : σ₀ g = 0 := by
      have h1 := congrArg σ₀ hg
      simp only [map_mul, map_sub, hσ0, hσ1, hσC] at h1
      have h2 : σ₀ g * MvPolynomial.C x₀ = 0 := by linear_combination -h1
      exact (mul_eq_zero.mp h2).resolve_right (fun hc => hx0 (MvPolynomial.C_eq_zero.mp hc))
    obtain ⟨g', hg'⟩ := hdvd g
    rw [hσg, sub_zero] at hg'
    have hp : p * MvPolynomial.X 0 =
        (g' * (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C x₀)) * MvPolynomial.X 0 := by
      rw [← hg, hg']; ring
    have hp' := mul_right_cancel₀ (MvPolynomial.X_ne_zero 0) hp
    rw [Ideal.Quotient.eq_zero_iff_mem, hp']
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

  have ht00 : t 0 0 = 1 := by
    apply (mul_cancel_right_mem_nonZeroDivisors (hnzd 0)).mp
    rw [one_mul]
    exact (hrat 0 0).symm
  have hrelB : Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0 * MvPolynomial.X 1) =
      Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C (x₀ * (x₀ * q))) := by
    rw [Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  rw [map_mul, MvPolynomial.C_mul, MvPolynomial.C_mul, map_mul, map_mul] at hrelB
  have hρ : (r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0) *
      (r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 1) =
      (r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) *
      ((r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) *
        (r₀.appLE ⊤ (U 0) (by simp)).hom ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C q)))) := by
    have := congrArg (fun z => (r₀.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom z)) hrelB
    simp only [map_mul] at this
    exact this
  have ht01 : t 0 1 = (r₀.appLE ⊤ (U 0) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C q))) * t 0 2 ^ 2 := by
    rw [hrat 0 1, hrat 0 2] at hρ
    apply (mul_cancel_right_mem_nonZeroDivisors (hnzd 0)).mp
    apply (mul_cancel_right_mem_nonZeroDivisors (hnzd 0)).mp
    linear_combination hρ

  obtain ⟨Φ, hΦX0, hΦX1, hΦC⟩ : ∃ Φ : wcNcRing W x₀ →+* Γ(M', U 0),
      Φ (Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 0)) =
        (r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0) ∧
      Φ (Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.X 1)) = t 0 2 ∧
      ∀ w : ↥W, Φ (Ideal.Quotient.mk (wcNcIdeal W x₀) (MvPolynomial.C w)) =
        (r₀.appLE ⊤ (U 0) (by simp)).hom ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
          (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C w))) := by
    let ψ : ↥W →+* Γ(M', U 0) := (r₀.appLE ⊤ (U 0) (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom.comp
        ((Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q)))).comp MvPolynomial.C))
    let Φt : MvPolynomial (Fin 2) ↥W →+* Γ(M', U 0) := MvPolynomial.eval₂Hom ψ
      ![(r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 0), t 0 2]
    have hΦt : ∀ p ∈ wcNcIdeal W x₀, Φt p = 0 := by
      intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      have hF : Φt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C x₀) = 0 := by
        simp only [Φt, map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        have e : ψ x₀ = (r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) := rfl
        rw [e, hrat 0 2]
        ring
      rw [map_mul, hF, mul_zero]
    refine ⟨Ideal.Quotient.lift (wcNcIdeal W x₀) Φt hΦt, ?_, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · intro w
      rw [Ideal.Quotient.lift_mk]
      simp only [Φt, MvPolynomial.eval₂Hom_C]
      rfl
  have hkey : Φ.comp θ₀ = (r₀.appLE ⊤ (U 0) (by simp)).hom.comp
      (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro w
      simp only [RingHom.comp_apply]
      rw [hθC, hΦC]
    · intro i
      fin_cases i
      · show Φ (θ₀ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0))) =
          (r₀.appLE ⊤ (U 0) (by simp)).hom ((Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
            (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0)))
        rw [hθX0, hΦX0]
        rfl
      · show Φ (θ₀ (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1))) =
          (r₀.appLE ⊤ (U 0) (by simp)).hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 1)
        rw [hθX1, map_mul, map_mul, map_pow, hΦC, hΦX0, hΦX1, hrat 0 1, ht01]
        ring
  refine ⟨h, ![1, (Scheme.ΓSpecIso (.of (wcNcRing W x₀))).inv.hom
