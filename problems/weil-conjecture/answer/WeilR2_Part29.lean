    obtain ⟨Q, b, c, E, v, hQ0, hQu, hbc, hb, hg⟩ := hnorm (n + 1) f hf
    obtain ⟨σ, hσ⟩ := wcpa_dj_lr1s_ncgr_cn_kronecker (↥W) n Q hQ0 hQu
    obtain ⟨ψ, s, Y, hdivp⟩ := wcpa_dj_lr1s_ncgr_cn_poly_division (↥W) n Q σ hσ
    have hψC : ∀ a : ↥W, ψ.toRingHom (MvPolynomial.C a) = MvPolynomial.C a := by
      intro a
      have := ψ.commutes a
      rw [MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq] at this
      exact this
    obtain ⟨Ψ, hΨ⟩ := wcpa_dj_lr1s_ncgr_cn_adic_map (MvPolynomial (Fin n) ↥W)
      (MvPolynomial (Fin (n + 1)) ↥W) ψ.toRingHom (MvPolynomial.C ϖ) (MvPolynomial.C ϖ) (hψC ϖ)
    have hΨC : ∀ a : ↥W,
        Ψ (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C a)) =
          algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (MvPolynomial.C a) :=
      fun a => (hΨ _).trans (congrArg _ (hψC a))
    obtain ⟨k, w, hkw⟩ := wcpa_dj_lr1s_ncgr_cn_rank_one_nilp Ω W hW ϖ hϖ0 b hb
    have hlift := wcpa_dj_lr1s_ncgr_cn_lift_division (MvPolynomial (Fin n) ↥W)
      (MvPolynomial (Fin (n + 1)) ↥W) ψ.toRingHom (MvPolynomial.C ϖ) (MvPolynomial.C ϖ)
      (hnzd (n + 1)) Ψ hΨ Q s Y hdivp
    have hdiv := wcpa_dj_lr1s_ncgr_cn_approx_division (wcNcgrTo W ϖ n) (wcNcgrTo W ϖ (n + 1)) Ψ
      (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C ϖ))
      (algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (MvPolynomial.C ϖ))
      (hΨC ϖ) (hCpl n) (hCpl (n + 1)) (hSep (n + 1)) s
      (fun j => algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (Y j))
      (algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) Q) E
      (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C b))
      (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C c))
      (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C w)) k
      (hbcα n b c hbc) (hkwα n b w k hkw) hlift
    refine ⟨Ψ, algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) Q +
        algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (MvPolynomial.C b) * E,
      v, s, fun j => algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (Y j),
      hΨC ϖ, hg, ?_⟩
    intro z
    obtain ⟨q, t, hz⟩ := hdiv z
    refine ⟨q, t, ?_⟩
    rw [hΨC b] at hz
    exact hz

  have hT : ∀ d : ℕ, IsNoetherianRing (wcNcgrTn W ϖ d) := by
    intro d
    induction d with
    | zero => exact hT0
    | succ n ih =>
      exact wcpa_dj_lr1s_ncgr_cn_noeth_criterion (wcNcgrTo W ϖ n) (wcNcgrTo W ϖ (n + 1))
        (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C ϖ))
        (algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (MvPolynomial.C ϖ))
        ih (hstep n)

  have hϖΩ : (ϖ : Ω) ≠ 0 := by
    intro h
    apply hϖ0
    exact Subtype.ext h
  have hpB : algebraMap C B (algebraMap W C ϖ) = algebraMap Ω B (ϖ : Ω) := by
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply W Ω B]
    rfl
  have hunit : IsUnit (algebraMap C B (algebraMap W C ϖ)) := by
    rw [hpB]
    exact (IsUnit.mk0 _ hϖΩ).map (algebraMap Ω B)
  have htf : ∀ y : C, algebraMap W C ϖ * y = 0 → y = 0 := by
    intro y hy
    apply hinj
    have h1 := congrArg (algebraMap C B) hy
    rw [map_mul, map_zero] at h1
    rw [map_zero]
    exact (hunit.mul_right_eq_zero).mp h1
  obtain ⟨d, φ, hφf, hφp⟩ :=
    wcpa_dj_lr1s_nf_cnf_finite_tate_model Ω W hW ϖ hϖ0 hϖnu C hC htf
  exact wcpa_dj_lr1s_ncgr_cn_finite_transfer _ _ φ _ _ hφf hφp (hT d)

theorem wcpa_dj_lr1s_ncgr_mpc_kappa : ∀ (R0 : Type u) [CommRing R0] (ϖ : R0) (C : Type u) [CommRing C] [Algebra R0 C], ∃ κ : AdicCompletion (Ideal.span {ϖ}) R0 →+* AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C, ∀ w : R0, κ (algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) w) = algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C w) :=
by
  intro R0 _ ϖ C _ _
  set f := algebraMap R0 C with hf
  have hI : Ideal.span {ϖ} ≤ Ideal.comap f (Ideal.span {f ϖ}) := by
    rw [Ideal.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact Ideal.mem_comap.mpr (Ideal.mem_span_singleton_self _)
  have hpow : ∀ n : ℕ, Ideal.span {ϖ} ^ n ≤ Ideal.comap f (Ideal.span {f ϖ} ^ n) := fun n =>
    (Ideal.pow_right_mono hI n).trans (Ideal.le_comap_pow f n)
  let κn : (n : ℕ) → AdicCompletion (Ideal.span {ϖ}) R0 →+* C ⧸ Ideal.span {f ϖ} ^ n :=
    fun n => (Ideal.quotientMap (Ideal.span {f ϖ} ^ n) f (hpow n)).comp
      (AdicCompletion.evalₐ (Ideal.span {ϖ}) n).toRingHom
  have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
      (Ideal.Quotient.factorPow (Ideal.span {f ϖ}) hle).comp (κn n) = κn m := by
    intro m n hle
    ext x
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (Ideal.span {ϖ}) n x)
    have key : AdicCompletion.evalₐ (Ideal.span {ϖ}) m x =
        Ideal.Quotient.factorPow (Ideal.span {ϖ}) hle (AdicCompletion.evalₐ (Ideal.span {ϖ}) n x) := by
      clear hy
      induction x using AdicCompletion.induction_on with
      | h a =>
        rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factor_mk,
          Ideal.Quotient.mk_eq_mk_iff_sub_mem]
        have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk hle a
        rw [Submodule.Quotient.eq] at h1
        have h2 : (Ideal.span {ϖ} ^ m • (⊤ : Submodule R0 R0)) = Ideal.span {ϖ} ^ m := by
          rw [Ideal.smul_eq_mul, Ideal.mul_top]
        rw [h2] at h1
        have h3 := (Ideal.span {ϖ} ^ m).neg_mem h1
        rwa [neg_sub] at h3
    simp only [κn, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [key, ← hy, Ideal.Quotient.factor_mk, Ideal.quotientMap_mk, Ideal.quotientMap_mk,
      Ideal.Quotient.factor_mk]
  refine ⟨AdicCompletion.liftRingHom (Ideal.span {f ϖ}) κn (fun hle => hcompat hle), ?_⟩
  intro w
  apply AdicCompletion.ext_evalₐ
  intro n
  rw [AdicCompletion.evalₐ_liftRingHom]
  simp only [κn, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of,
    AdicCompletion.evalₐ_of, Algebra.algebraMap_self, RingHom.id_apply, Ideal.quotientMap_mk,
    Algebra.algebraMap_self, RingHom.id_apply]

theorem wcpa_dj_lr1s_ncgr_mpc_hatW_valuation : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → IsDomain (AdicCompletion (Ideal.span {ϖ}) ↥W) ∧ Function.Injective (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W)) ∧ (∀ b : AdicCompletion (Ideal.span {ϖ}) ↥W, b ≠ 0 → ∃ n : ℕ, b ∣ algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ ^ n) ∧ (∀ x y : AdicCompletion (Ideal.span {ϖ}) ↥W, x ∣ y ∨ y ∣ x) ∧ (∀ c : AdicCompletion (Ideal.span {ϖ}) ↥W, ¬ IsUnit c → ∃ k : ℕ, algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ ∣ c ^ k) :=
by

  have basics : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → (∀ y : AdicCompletion (Ideal.span {p}) C, algebraMap C (AdicCompletion (Ideal.span {p}) C) p * y = 0 → y = 0) ∧ (∀ (n : ℕ) (c : C) (y : AdicCompletion (Ideal.span {p}) C), algebraMap C (AdicCompletion (Ideal.span {p}) C) c = algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y → ∃ c' : C, c = p ^ n * c') ∧ (∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y') := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    refine ⟨?_, ?_, ?_⟩
    · intro y hy
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_zero, AdicCompletion.evalₐ_mk, hmem]
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) (k + 1)) hy
      rw [map_mul, map_zero, hev, AdicCompletion.evalₐ_mk, ← map_mul, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      have h2 : a (k + 1) = p ^ k * t := by
        apply hNc 1
        rw [pow_one, ht]
        ring
      obtain ⟨s, hs⟩ := hD a k (k + 1) (by omega)
      exact ⟨t - s, by linear_combination h2 - hs⟩
    · intro n c y h
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) n) h
      rw [map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, ← map_pow, ← map_mul,
        ← sub_eq_zero, ← map_sub, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      exact ⟨a n + t, by linear_combination ht⟩
    · intro n y
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
        fun k => hD a n (k + n) (by omega)
      choose b hb using hex
      have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
        intro k
        rw [SModEq.sub_mem]
        obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
        have e : b k - b (k + 1) = p ^ k * (-s) := by
          apply hNc n
          linear_combination (-1 : C) * hb k + hb (k + 1) - hs
        rw [e]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
          Submodule.mem_top
      let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
        AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
      have hBk : ∀ k, B k = b k := fun k => rfl
      refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
        ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
      obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
      exact ⟨-s, by linear_combination hb k - hs⟩

  have series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
    intro R _ r
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
          Submodule.mem_top
    refine ⟨fun f hf => ?_, fun x hx => ?_⟩
    · choose y hy using hf
      have s4 : ∀ m n : ℕ, m ≤ n →
          f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        intro m n hmn
        induction n, hmn using Nat.le_induction with
        | base => rw [sub_self]; exact Submodule.zero_mem _
        | succ n hmn ih =>
          rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
          refine Submodule.add_mem _ ?_ ih
          have h1 : f (n + 1) - f n ∈
              (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
            (s1 n _).mpr ⟨y n, hy n⟩
          exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
      obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, ← neg_sub]
        exact Submodule.neg_mem _ (s4 m n hmn))
      refine ⟨L, fun n => (s1 n _).mp ?_⟩
      have h := SModEq.sub_mem.mp (hL n)
      rw [← neg_sub]
      exact Submodule.neg_mem _ h
    · refine hc.toIsHausdorff.haus x (fun k => ?_)
      rw [SModEq.sub_mem, sub_zero]
      exact (s1 k x).mpr (hx k)
  intro Ω _ W hdim ϖ hϖ0 hϖu hdiv
  have htf : ∀ x : ↥W, ϖ * x = 0 → x = 0 := fun x h => (mul_eq_zero.mp h).resolve_left hϖ0
  obtain ⟨_B1, B2, B3⟩ := basics (↥W) ϖ htf
  obtain ⟨S1, S2⟩ := series (↥W) ϖ
  set ι := algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) with hι

  have L1 : ∀ u : ↥W, ¬ IsUnit u → ∃ k : ℕ, ϖ ∣ u ^ k := by
    intro u hu
    have : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hdim
    have hrad : u ∈ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro J ⟨hJ, hJp⟩
      have hJne : J ≠ ⊥ := by
        intro h
        apply hϖ0
        have h1 : ϖ ∈ J := hJ (Ideal.mem_span_singleton_self ϖ)
        rw [h] at h1
        exact (Submodule.mem_bot _).mp h1
      have hJmax : J.IsMaximal := (Ring.krullDimLE_one_iff_of_isPrime_bot.mp inferInstance) J hJne hJp
      rw [IsLocalRing.eq_maximalIdeal hJmax]
      exact (IsLocalRing.mem_maximalIdeal u).mpr hu
    obtain ⟨k, hk⟩ := hrad
    exact ⟨k, Ideal.mem_span_singleton.mp hk⟩

  have L2 : ∀ (z t : AdicCompletion (Ideal.span {ϖ}) ↥W) (k : ℕ), z ^ k = ι ϖ * t → IsUnit (1 + z) := by
    intro z t k hzk
    have hxk : (-z) ^ k = ι ϖ * ((-1) ^ k * t) := by
      rw [neg_pow, hzk]; ring
    have hdiff : ∀ n : ℕ, ∃ y, (∑ j ∈ Finset.range (k * (n + 1)), (-z) ^ j) -
        (∑ j ∈ Finset.range (k * n), (-z) ^ j) = ι ϖ ^ n * y := by
      intro n
      refine ⟨((-1) ^ k * t) ^ n * ∑ i ∈ Finset.range k, (-z) ^ i, ?_⟩
      rw [show k * (n + 1) = k * n + k by ring, Finset.sum_range_add, add_sub_cancel_left,
        Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [pow_add, pow_mul, hxk]; ring
    obtain ⟨L, hL⟩ := S1 (fun n => ∑ j ∈ Finset.range (k * n), (-z) ^ j) hdiff
    have hgeom : ∀ n : ℕ, (1 + z) * (∑ j ∈ Finset.range (k * n), (-z) ^ j) =
        1 - ι ϖ ^ n * ((-1) ^ k * t) ^ n := by
      intro n
      have h1 := mul_neg_geom_sum (-z) (k * n)
      rw [pow_mul, hxk, mul_pow, sub_neg_eq_add] at h1
      exact h1
    have hzero : (1 + z) * L - 1 = 0 := by
      apply S2
      intro n
      obtain ⟨y, hy⟩ := hL n
      have hy' : L - ∑ j ∈ Finset.range (k * n), (-z) ^ j = ι ϖ ^ n * y := hy
      refine ⟨(1 + z) * y - ((-1) ^ k * t) ^ n, ?_⟩
      have e : (1 + z) * L - 1 = (1 + z) * (L - ∑ j ∈ Finset.range (k * n), (-z) ^ j) +
          ((1 + z) * (∑ j ∈ Finset.range (k * n), (-z) ^ j) - 1) := by ring
      rw [e, hy', hgeom n]; ring
    have h1 : (1 + z) * L = 1 := sub_eq_zero.mp hzero
    exact ⟨⟨1 + z, L, h1, by rw [mul_comm]; exact h1⟩, rfl⟩

  have L4 : Function.Injective ι := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    by_contra hw0
    obtain ⟨m, v, hv⟩ := hdiv w hw0
    obtain ⟨c', hc'⟩ := B2 (m + 1) w 0 (by rw [mul_zero]; exact hw)
    apply hϖu
    have h0 : ϖ ^ m = ϖ ^ (m + 1) * c' * v := by rw [hv, hc']
    have h1 : ϖ ^ m * (ϖ * (c' * v)) = ϖ ^ m * 1 := by linear_combination -h0
    have h2 := mul_left_cancel₀ (pow_ne_zero m hϖ0) h1
    exact ⟨⟨ϖ, c' * v, h2, by rw [mul_comm]; exact h2⟩, rfl⟩

  have L3 : ∀ x : AdicCompletion (Ideal.span {ϖ}) ↥W, x ≠ 0 → ∃ (w : ↥W)
      (e : AdicCompletion (Ideal.span {ϖ}) ↥W), w ≠ 0 ∧ IsUnit e ∧ x = ι w * e := by
    intro x hx
    have hn : ∃ n : ℕ, ¬ ∃ y, x = ι ϖ ^ n * y := by
      by_contra h
      push_neg at h
      exact hx (S2 x h)
    obtain ⟨n, hn⟩ := hn
    obtain ⟨c, y', hcy⟩ := B3 n x
    have hnd : ¬ ϖ ^ n ∣ c := by
      rintro ⟨c', hc'⟩
      apply hn
      refine ⟨ι c' + y', ?_⟩
      rw [hcy, hc', map_mul, map_pow]; ring
    rcases ValuationRing.dvd_total c (ϖ ^ n) with h | h
    · obtain ⟨u, hu⟩ := h
      have hc0 : c ≠ 0 := by
        rintro rfl
        exact hnd (dvd_zero _)
      have hu' : ¬ IsUnit u := by
        rintro ⟨U, rfl⟩
        apply hnd
        exact ⟨↑U⁻¹, by rw [hu, mul_assoc, Units.mul_inv, mul_one]⟩
      obtain ⟨k, s, hs⟩ := L1 u hu'
      refine ⟨c, 1 + ι u * y', hc0, L2 (ι u * y') (ι s * y' ^ k) k ?_, ?_⟩
      · rw [mul_pow, ← map_pow, hs, map_mul]; ring
      · rw [hcy, ← map_pow, hu, map_mul]; ring
    · exact absurd h hnd

  have hnt : Nontrivial (AdicCompletion (Ideal.span {ϖ}) ↥W) := by
    refine ⟨⟨0, 1, ?_⟩⟩
    intro h
    have h1 : ι 0 = ι 1 := by rw [map_zero, map_one]; exact h
    exact zero_ne_one (L4 h1)
  have hnzd : NoZeroDivisors (AdicCompletion (Ideal.span {ϖ}) ↥W) := by
    refine ⟨fun {a b} hab => ?_⟩
    by_contra h
    push_neg at h
    obtain ⟨w, e, hw, he, rfl⟩ := L3 a h.1
    obtain ⟨w', e', hw', he', rfl⟩ := L3 b h.2
    have h1 : ι (w * w') * (e * e') = 0 := by rw [map_mul, ← hab]; ring
    have h2 : ι (w * w') = 0 := (he.mul he').mul_left_eq_zero.mp h1
    exact mul_ne_zero hw hw' (L4 (h2.trans (map_zero ι).symm))
  refine ⟨?_, L4, ?_, ?_, ?_⟩
  · haveI := hnt
    haveI := hnzd
    exact NoZeroDivisors.to_isDomain _
  · intro b hb
    obtain ⟨w, e, hw, he, rfl⟩ := L3 b hb
    obtain ⟨n, v, hv⟩ := hdiv w hw
    obtain ⟨U, rfl⟩ := he
    refine ⟨n, ↑U⁻¹ * ι v, ?_⟩
    rw [← map_pow, hv, map_mul, mul_assoc, Units.mul_inv_cancel_left]
  · intro x y
    by_cases hx : x = 0
    · right; rw [hx]; exact dvd_zero y
    by_cases hy : y = 0
    · left; rw [hy]; exact dvd_zero x
    obtain ⟨w, e, hw, he, rfl⟩ := L3 x hx
    obtain ⟨w', e', hw', he', rfl⟩ := L3 y hy
    obtain ⟨U, rfl⟩ := he
    obtain ⟨U', rfl⟩ := he'
    rcases ValuationRing.dvd_total w w' with ⟨v, hv⟩ | ⟨v, hv⟩
    · left
      refine ⟨↑U⁻¹ * ι v * ↑U', ?_⟩
      rw [hv, map_mul]
      linear_combination (-(ι w * ι v * ↑U')) * Units.mul_inv U
    · right
      refine ⟨↑U'⁻¹ * ι v * ↑U, ?_⟩
      rw [hv, map_mul]
      linear_combination (-(ι w' * ι v * ↑U)) * Units.mul_inv U'
  · intro c hc
    by_cases hc0 : c = 0
    · exact ⟨1, by rw [hc0, pow_one]; exact dvd_zero _⟩
    obtain ⟨w, e, hw, he, rfl⟩ := L3 c hc0
    have hwu : ¬ IsUnit w := fun h => hc ((h.map ι).mul he)
    obtain ⟨k, s, hs⟩ := L1 w hwu
    exact ⟨k, ι s * e ^ k, by rw [mul_pow, ← map_pow, hs, map_mul]; ring⟩

theorem wcpa_dj_lr1s_ncgr_mpc_hatW_monic_root : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ P : Polynomial (AdicCompletion (Ideal.span {ϖ}) ↥W), P.Monic → 0 < P.natDegree → ∃ r : AdicCompletion (Ideal.span {ϖ}) ↥W, P.eval r = 0 :=
by
  intro Ω _ _ W _hW ϖ hϖ0 _hϖnu _hdiv P hmon hdeg
  classical

  have s1 : ∀ (k d : ℕ) (q : ℕ → ↥W), 0 < d → ϖ ^ (k * d) ∣ q 0 →
      ∃ β : ↥W, β ^ d + ∑ i ∈ Finset.range d, q i * β ^ i = 0 ∧ ϖ ^ k ∣ β := by
    intro k d q hd hq
    obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩
    set Q : Polynomial ↥W := Polynomial.X ^ (d' + 1) +
      ∑ i ∈ Finset.range (d' + 1), Polynomial.C (q i) * Polynomial.X ^ i with hQ
    have hdegs : (∑ i ∈ Finset.range (d' + 1), Polynomial.C (q i) * Polynomial.X ^ i).degree
        < ((d' + 1 : ℕ) : WithBot ℕ) := by
      refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
      rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
      intro i hi
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _)
        (by exact_mod_cast Finset.mem_range.mp hi)
    have hmonQ : Q.Monic := Polynomial.monic_X_pow_add hdegs
    have hnat : Q.natDegree = d' + 1 := by
      rw [hQ, Polynomial.natDegree_add_eq_left_of_degree_lt (by rwa [Polynomial.degree_X_pow]),
        Polynomial.natDegree_X_pow]
    have heval : ∀ x : ↥W, Q.eval x = x ^ (d' + 1) + ∑ i ∈ Finset.range (d' + 1), q i * x ^ i := by
      intro x
      simp [hQ, Polynomial.eval_finset_sum]
    set Qm : Polynomial Ω := Q.map (algebraMap (↥W) Ω) with hQm
    have hmonm : Qm.Monic := hmonQ.map _
    have hnatm : Qm.natDegree = d' + 1 := by rw [hQm, hmonQ.natDegree_map, hnat]
    have hne : Qm ≠ 0 := hmonm.ne_zero
    have hcard : Qm.roots.card = Qm.natDegree := IsAlgClosed.card_roots_eq_natDegree
    have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmonm hcard
    have hevm : ∀ y : ↥W, Qm.eval (algebraMap (↥W) Ω y) = algebraMap (↥W) Ω (Q.eval y) := by
      intro y
      rw [hQm, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have hinW : ∀ ρ ∈ Qm.roots, ∃ y : ↥W, algebraMap (↥W) Ω y = ρ := by
      intro ρ hρ
      have hint : IsIntegral (↥W) ρ := ⟨Q, hmonQ, by
        rw [← Polynomial.eval_map]
        exact (Polynomial.mem_roots hne).mp hρ⟩
      exact IsIntegrallyClosed.isIntegral_iff.mp hint
    set v := W.valuation with hv
    have hconst : v (algebraMap (↥W) Ω (q 0)) = (Qm.roots.map (fun ρ => v ρ)).prod := by
      have h0 : Q.eval 0 = q 0 := by
        rw [heval]
        simp [Finset.sum_range_succ']
      have h1 : algebraMap (↥W) Ω (q 0) = Qm.eval 0 := by
        rw [← h0, ← hevm, map_zero]
      rw [h1]
      conv_lhs => rw [← hprod]
      rw [Polynomial.eval_multiset_prod, map_multiset_prod, Multiset.map_map, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro ρ _
      simp
    have hS0 : Qm.roots ≠ 0 := by
      intro h
      rw [h, hnatm] at hcard
      simp at hcard
    obtain ⟨ρ0, hρ0, hmin⟩ := Multiset.exists_min_image (fun ρ => v ρ) hS0
    have hpow : v ρ0 ^ (d' + 1) ≤ (Qm.roots.map (fun ρ => v ρ)).prod := by
      have h1 := Multiset.pow_card_le_prod (s := Qm.roots.map (fun ρ => v ρ)) (a := v ρ0) (by
        intro x hx
        obtain ⟨z, hz, rfl⟩ := Multiset.mem_map.mp hx
        exact hmin z hz)
      rwa [Multiset.card_map, hcard, hnatm] at h1
    have hupper : v (algebraMap (↥W) Ω (q 0)) ≤ (v (algebraMap (↥W) Ω ϖ) ^ k) ^ (d' + 1) := by
      obtain ⟨e, he⟩ := hq
      rw [he, map_mul, map_pow, map_mul, map_pow, ← pow_mul]
      exact mul_le_of_le_one_right' (W.valuation_le_one e)
    have hle : v ρ0 ≤ v (algebraMap (↥W) Ω ϖ) ^ k :=
      (pow_le_pow_iff_left₀ zero_le' zero_le' (Nat.succ_ne_zero d')).mp
        ((hpow.trans_eq hconst.symm).trans hupper)
    obtain ⟨y, hy⟩ := hinW ρ0 hρ0
    have hϖΩ : algebraMap (↥W) Ω ϖ ≠ 0 := by
      intro h
      exact hϖ0 ((IsFractionRing.injective (↥W) Ω) (h.trans (map_zero _).symm))
    have hvpos : 0 < v (algebraMap (↥W) Ω ϖ) ^ k :=
      pow_pos (zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr hϖΩ)) k
    have hcW : ρ0 / (algebraMap (↥W) Ω ϖ) ^ k ∈ W := by
      apply W.mem_of_valuation_le_one
      rw [map_div₀, map_pow, div_le_one₀ hvpos]
      exact hle
    refine ⟨y, ?_, ⟨⟨_, hcW⟩, ?_⟩⟩
    · apply IsFractionRing.injective (↥W) Ω
      rw [map_zero, ← heval, ← hevm, hy]
      exact (Polynomial.mem_roots hne).mp hρ0
    · apply IsFractionRing.injective (↥W) Ω
      rw [map_mul, map_pow, hy]
      show ρ0 = algebraMap (↥W) Ω ϖ ^ k * (ρ0 / (algebraMap (↥W) Ω ϖ) ^ k)
      rw [mul_div_cancel₀ _ (pow_ne_zero k hϖΩ)]


  have basics : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → (∀ y : AdicCompletion (Ideal.span {p}) C, algebraMap C (AdicCompletion (Ideal.span {p}) C) p * y = 0 → y = 0) ∧ (∀ (n : ℕ) (c : C) (y : AdicCompletion (Ideal.span {p}) C), algebraMap C (AdicCompletion (Ideal.span {p}) C) c = algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y → ∃ c' : C, c = p ^ n * c') ∧ (∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y') := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    refine ⟨?_, ?_, ?_⟩
    · intro y hy
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_zero, AdicCompletion.evalₐ_mk, hmem]
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) (k + 1)) hy
      rw [map_mul, map_zero, hev, AdicCompletion.evalₐ_mk, ← map_mul, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      have h2 : a (k + 1) = p ^ k * t := by
        apply hNc 1
        rw [pow_one, ht]
        ring
      obtain ⟨s, hs⟩ := hD a k (k + 1) (by omega)
      exact ⟨t - s, by linear_combination h2 - hs⟩
    · intro n c y h
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have h1 := congrArg (AdicCompletion.evalₐ (Ideal.span {p}) n) h
      rw [map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, ← map_pow, ← map_mul,
        ← sub_eq_zero, ← map_sub, hmem] at h1
      obtain ⟨t, ht⟩ := h1
      exact ⟨a n + t, by linear_combination ht⟩
    · intro n y
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
      have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
        fun k => hD a n (k + n) (by omega)
      choose b hb using hex
      have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
        intro k
        rw [SModEq.sub_mem]
        obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
        have e : b k - b (k + 1) = p ^ k * (-s) := by
          apply hNc n
          linear_combination (-1 : C) * hb k + hb (k + 1) - hs
        rw [e]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
          Submodule.mem_top
      let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
        AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
      have hBk : ∀ k, B k = b k := fun k => rfl
      refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
        ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
      obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
      exact ⟨-s, by linear_combination hb k - hs⟩
  have series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
    intro R _ r
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
          Submodule.mem_top
    refine ⟨fun f hf => ?_, fun x hx => ?_⟩
    · choose y hy using hf
      have s4 : ∀ m n : ℕ, m ≤ n →
          f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        intro m n hmn
        induction n, hmn using Nat.le_induction with
        | base => rw [sub_self]; exact Submodule.zero_mem _
        | succ n hmn ih =>
          rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
          refine Submodule.add_mem _ ?_ ih
          have h1 : f (n + 1) - f n ∈
              (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
            (s1 n _).mpr ⟨y n, hy n⟩
          exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
      obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, ← neg_sub]
        exact Submodule.neg_mem _ (s4 m n hmn))
      refine ⟨L, fun n => (s1 n _).mp ?_⟩
      have h := SModEq.sub_mem.mp (hL n)
      rw [← neg_sub]
      exact Submodule.neg_mem _ h
    · refine hc.toIsHausdorff.haus x (fun k => ?_)
      rw [SModEq.sub_mem, sub_zero]
      exact (s1 k x).mpr (hx k)
  have htf : ∀ x : ↥W, ϖ * x = 0 → x = 0 := fun x hx => (mul_eq_zero.mp hx).resolve_left hϖ0
  obtain ⟨_, hB2, hB3⟩ := basics (↥W) ϖ htf
  obtain ⟨hS1, hS2⟩ := series (↥W) ϖ
  set ι : ↥W →+* AdicCompletion (Ideal.span {ϖ}) ↥W :=
    algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) with hι
  set t := ι ϖ with ht
  set d := P.natDegree with hd
  obtain ⟨d', hd'⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩

  have hstep : ∀ (k : ℕ) (r : AdicCompletion (Ideal.span {ϖ}) ↥W),
      (∃ y, P.eval r = t ^ (k * d) * y) →
      ∃ δ : AdicCompletion (Ideal.span {ϖ}) ↥W, (∃ z, δ = t ^ k * z) ∧
        ∃ y, P.eval (r + δ) = t ^ ((k + 1) * d) * y := by
    rintro k r ⟨y, hy⟩
    set Pr := Polynomial.taylor r P with hPr
    have hPrm : Pr.Monic := by
      unfold Polynomial.Monic
      rw [hPr, Polynomial.leadingCoeff_taylor]
      exact hmon
    have hPrd : Pr.natDegree = d := Polynomial.natDegree_taylor P r
    have hPr_eval : ∀ s, Pr.eval s = s ^ d + ∑ i ∈ Finset.range d, Pr.coeff i * s ^ i := by
      intro s
      conv_lhs => rw [hPrm.as_sum]
      rw [hPrd]
      simp [Polynomial.eval_finset_sum]
    choose c y' hcy using fun i => hB3 ((k + 1) * d) (Pr.coeff i)
    have hc0 : ϖ ^ (k * d) ∣ c 0 := by
      obtain ⟨c', hc'⟩ := hB2 (k * d) (c 0) (y - t ^ d * y' 0) (by
        have h0 := hcy 0
        rw [hPr, Polynomial.taylor_coeff_zero, hy] at h0
        rw [show (k + 1) * d = k * d + d by ring, pow_add] at h0
        linear_combination -h0)
      exact ⟨c', hc'⟩
    obtain ⟨β, hβ, z0, hz0⟩ := s1 k d c hdeg hc0
    have hιβ : (ι β) ^ d + ∑ i ∈ Finset.range d, ι (c i) * (ι β) ^ i = 0 := by
      have := congrArg ι hβ
      simpa [map_add, map_sum, map_mul, map_pow] using this
    refine ⟨ι β, ⟨ι z0, by rw [hz0, map_mul, map_pow]⟩,
      ∑ i ∈ Finset.range d, y' i * (ι β) ^ i, ?_⟩
    rw [add_comm, ← Polynomial.taylor_eval, ← hPr, hPr_eval]
    rw [Finset.sum_congr rfl (fun i _ => by rw [hcy i])]
    simp only [add_mul, Finset.sum_add_distrib, Finset.mul_sum, mul_assoc]
    linear_combination hιβ

  choose δ hδz hδP using hstep
  let G : ℕ → Type u := fun k =>
    {r : AdicCompletion (Ideal.span {ϖ}) ↥W // ∃ y, P.eval r = t ^ (k * d) * y}
  let s : ∀ k, G k := fun k => Nat.rec (motive := fun k => G k)
    ⟨0, P.eval 0, by simp⟩ (fun k sk => ⟨sk.1 + δ k sk.1 sk.2, hδP k sk.1 sk.2⟩) k
  have hcau : ∀ n : ℕ, ∃ y, (s (n + 1)).1 - (s n).1 = t ^ n * y := by
    intro n
    obtain ⟨z, hz⟩ := hδz n (s n).1 (s n).2
    refine ⟨z, ?_⟩
    show (s n).1 + δ n (s n).1 (s n).2 - (s n).1 = _
    rw [add_sub_cancel_left]
    exact hz
  obtain ⟨L, hL⟩ := hS1 (fun n => (s n).1) hcau
  refine ⟨L, hS2 _ ?_⟩
  intro n
  obtain ⟨yn, hyn⟩ := hL n
  obtain ⟨w, hw⟩ := Polynomial.sub_dvd_eval_sub L (s n).1 P
  obtain ⟨y, hy⟩ := (s n).2
  refine ⟨t ^ (n * d') * y + yn * w, ?_⟩
  have h1 : P.eval L = P.eval (s n).1 + (L - (s n).1) * w := by rw [← hw]; ring
  rw [h1, hy, hyn, show n * d = n + n * d' by rw [hd']; ring, pow_add]
  ring

theorem wcpa_dj_lr1s_ncgr_mpc_frac_algClosed : ∀ (D : Type u) [CommRing D] [IsDomain D], (∀ P : Polynomial D, P.Monic → 0 < P.natDegree → ∃ r : D, P.eval r = 0) → IsAlgClosed (FractionRing D) :=
by
  intro D _ _ hroot
  apply IsAlgClosed.of_exists_root
  intro p hmon hirr
  have hn : 0 < p.natDegree := Irreducible.natDegree_pos hirr
  set s := IsLocalization.commonDenom (nonZeroDivisors D) p.support p.coeff with hs
  have hs0 : algebraMap D (FractionRing D) (s : D) ≠ 0 := by
    intro h
    apply nonZeroDivisors.coe_ne_zero s
    exact (IsFractionRing.injective D (FractionRing D)) (h.trans (map_zero _).symm)
  have hlift : p.scaleRoots (algebraMap D (FractionRing D) (s : D)) ∈
      Polynomial.lifts (algebraMap D (FractionRing D)) :=
    IsLocalization.scaleRoots_commonDenom_mem_lifts (M := nonZeroDivisors D) (p := p)
      ⟨1, by rw [map_one, hmon.leadingCoeff]⟩
  have hmon' : (p.scaleRoots (algebraMap D (FractionRing D) (s : D))).Monic := by
    rw [Polynomial.Monic, Polynomial.leadingCoeff_scaleRoots, hmon.leadingCoeff]
  obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hmon'
  rw [Polynomial.natDegree_scaleRoots] at hqdeg
  obtain ⟨r, hr⟩ := hroot q hqmon (by omega)
  refine ⟨algebraMap D (FractionRing D) r / algebraMap D (FractionRing D) (s : D), ?_⟩
  have h1 : Polynomial.eval (algebraMap D (FractionRing D) r)
      (p.scaleRoots (algebraMap D (FractionRing D) (s : D))) = 0 := by
    rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hr, map_zero]
  have h2 := Polynomial.scaleRoots_eval₂_mul (p := p) (RingHom.id (FractionRing D))
    (algebraMap D (FractionRing D) r / algebraMap D (FractionRing D) (s : D))
    (algebraMap D (FractionRing D) (s : D))
  simp only [RingHom.id_apply, Polynomial.eval₂_id] at h2
  rw [mul_div_cancel₀ _ hs0, h1] at h2
  exact (mul_eq_zero.mp h2.symm).resolve_left (pow_ne_zero _ hs0)

theorem wcpa_dj_lr1s_ncgr_mpc_nullstellensatz : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ (C : Type u) [CommRing C] [Algebra ↥W C], Algebra.FiniteType ↥W C → (∀ x : C, algebraMap (↥W) C ϖ * x = 0 → x = 0) → ∀ κ : AdicCompletion (Ideal.span {ϖ}) ↥W →+* AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C, (∀ w : ↥W, κ (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) w) = algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C w)) → ∀ 𝔪 : Ideal (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ))), 𝔪.IsMaximal → ∀ y : AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C, ∃ Q : Polynomial (AdicCompletion (Ideal.span {ϖ}) ↥W), Q ≠ 0 ∧ algebraMap (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ))) (Q.eval₂ κ y) ∈ 𝔪 :=
by
  intro Ω _ _ W hW ϖ hϖ0 hϖnu _hdiv C _ _ hC htf κ hκ 𝔪 h𝔪 y
  classical



  have s0 : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x : AdicCompletion I R) (m n : ℕ)
      (h : m ≤ n), Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) =
        AdicCompletion.evalₐ I m x := by
    intro R _ I x m n h
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I R x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    show Ideal.Quotient.factor _ (Ideal.Quotient.mk _ _) = _
    rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk h c
    rw [Submodule.Quotient.eq] at hc
    rw [Ideal.smul_eq_mul, Ideal.mul_top] at hc
    exact hc
  have hev : ∀ (T : Type u) [CommRing T] (J : Ideal T) (n : ℕ) (t : T),
      AdicCompletion.evalₐ J n (algebraMap T (AdicCompletion J T) t) =
        Ideal.Quotient.mk (J ^ n) t := by
    intro T _ J n t
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
      RingHom.id_apply]
  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (r : R) (s : S), ψ r = s →
      ∃ Ψ : AdicCompletion (Ideal.span {r}) R →+* AdicCompletion (Ideal.span {s}) S,
        ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
          AdicCompletion.evalₐ (Ideal.span {r}) n x = Ideal.Quotient.mk (Ideal.span {r} ^ n) a →
          AdicCompletion.evalₐ (Ideal.span {s}) n (Ψ x) =
            Ideal.Quotient.mk (Ideal.span {s} ^ n) (ψ a) := by
    intro R S _ _ ψ r s hrs
    have hle : ∀ k : ℕ, Ideal.span {r} ^ k ≤ Ideal.comap ψ (Ideal.span {s} ^ k) := by
      intro k
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow, Ideal.map_span, Set.image_singleton, hrs]
    let f : ∀ k : ℕ, AdicCompletion (Ideal.span {r}) R →+* S ⧸ Ideal.span {s} ^ k := fun k =>
      (Ideal.quotientMap (Ideal.span {s} ^ k) ψ (hle k)).comp
        (AdicCompletion.evalₐ (Ideal.span {r}) k :
          AdicCompletion (Ideal.span {r}) R →+* R ⧸ Ideal.span {r} ^ k)
    have hfv : ∀ (k : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
        AdicCompletion.evalₐ (Ideal.span {r}) k x = Ideal.Quotient.mk (Ideal.span {r} ^ k) a →
        f k x = Ideal.Quotient.mk (Ideal.span {s} ^ k) (ψ a) := by
      intro k x a ha
      show Ideal.quotientMap (Ideal.span {s} ^ k) ψ (hle k)
        (AdicCompletion.evalₐ (Ideal.span {r}) k x) = _
      rw [ha, Ideal.quotientMap_mk]
    have hf : ∀ {m n : ℕ} (h : m ≤ n),
        (Ideal.Quotient.factorPow (Ideal.span {s}) h).comp (f n) = f m := by
      intro m n h
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (Ideal.span {r}) n x)
      have ham : AdicCompletion.evalₐ (Ideal.span {r}) m x =
          Ideal.Quotient.mk (Ideal.span {r} ^ m) a := by
        rw [← s0 R _ x m n h, ← ha]
        rfl
      rw [RingHom.comp_apply, hfv n x a ha.symm, hfv m x a ham]
      rfl
    refine ⟨AdicCompletion.liftRingHom (Ideal.span {s}) f hf, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hfv n x a ha
  have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (r : R) (s : S), ψ r = s →
      Function.Surjective ψ →
      ∀ Ψ : AdicCompletion (Ideal.span {r}) R →+* AdicCompletion (Ideal.span {s}) S,
        (∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
          AdicCompletion.evalₐ (Ideal.span {r}) n x = Ideal.Quotient.mk (Ideal.span {r} ^ n) a →
          AdicCompletion.evalₐ (Ideal.span {s}) n (Ψ x) =
            Ideal.Quotient.mk (Ideal.span {s} ^ n) (ψ a)) → Function.Surjective Ψ := by
    intro R S _ _ ψ r s hrs hψ Ψ hΨ y
    have hb : ∀ k : ℕ, ∃ b : S, AdicCompletion.evalₐ (Ideal.span {s}) k y =
        Ideal.Quotient.mk (Ideal.span {s} ^ k) b := fun k =>
      (Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (Ideal.span {s}) k y)).imp
        fun b hb => hb.symm
    choose b hb using hb
    have hbc : ∀ k : ℕ, b (k + 1) - b k ∈ Ideal.span {s} ^ k := by
      intro k
      rw [← Ideal.Quotient.eq]
      have h0 := s0 S (Ideal.span {s}) y k (k + 1) (Nat.le_succ k)
      rw [hb, hb] at h0
      rw [← h0]
      rfl
    have step : ∀ (k : ℕ) (a : R), ψ a - b k ∈ Ideal.span {s} ^ k →
        ∃ a' : R, a' - a ∈ Ideal.span {r} ^ k ∧ ψ a' - b (k + 1) ∈ Ideal.span {s} ^ (k + 1) := by
      intro k a ha
      have h1 : b (k + 1) - ψ a ∈ Ideal.span {s} ^ k := by
        have h2 := Ideal.sub_mem _ (hbc k) ha
        have e : b (k + 1) - b k - (ψ a - b k) = b (k + 1) - ψ a := by ring
        rw [e] at h2
        exact h2
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h1
      obtain ⟨c, hc⟩ := h1
      obtain ⟨c', rfl⟩ := hψ c
      refine ⟨a + c' * r ^ k, ?_, ?_⟩
      · rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
        exact ⟨c', by ring⟩
      · have e : ψ (a + c' * r ^ k) - b (k + 1) = 0 := by
          rw [map_add, map_mul, map_pow, hrs, hc]
          ring
        rw [e]
        exact Ideal.zero_mem _
    choose g hg1 hg2 using step
    let A : ∀ k : ℕ, {a : R // ψ a - b k ∈ Ideal.span {s} ^ k} := fun k =>
      Nat.rec (motive := fun k => {a : R // ψ a - b k ∈ Ideal.span {s} ^ k})
        ⟨0, by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top⟩
        (fun k p => ⟨g k p.1 p.2, hg2 k p.1 p.2⟩) k
    have hA : ∀ k : ℕ, (A (k + 1)).1 - (A k).1 ∈ Ideal.span {r} ^ k := fun k =>
      hg1 k (A k).1 (A k).2
    have hcau : ∀ n : ℕ, (fun k => (A k).1) n ≡ (fun k => (A k).1) (n + 1)
        [SMOD (Ideal.span {r} ^ n • ⊤ : Submodule R R)] := by
      intro n
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, ← neg_sub]
      exact neg_mem (hA n)
    refine ⟨AdicCompletion.mk (Ideal.span {r}) R
      (AdicCompletion.AdicCauchySequence.mk (Ideal.span {r}) R (fun k => (A k).1) hcau), ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [hΨ k _ (A k).1 (by rw [AdicCompletion.evalₐ_mk]; rfl), hb k, Ideal.Quotient.eq]
    exact (A k).2

  have hmap : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (r : R) (s : S), ψ r = s →
      ∃ Ψ : AdicCompletion (Ideal.span {r}) R →+* AdicCompletion (Ideal.span {s}) S,
        (∀ x : R, Ψ (algebraMap R (AdicCompletion (Ideal.span {r}) R) x) =
          algebraMap S (AdicCompletion (Ideal.span {s}) S) (ψ x)) ∧
        (Function.Surjective ψ → Function.Surjective Ψ) := by
    intro R S _ _ ψ r s hrs
    obtain ⟨Ψ, hΨ⟩ := s2 R S ψ r s hrs
    refine ⟨Ψ, fun x => ?_, fun hψ => s3 R S ψ r s hrs hψ Ψ hΨ⟩
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hΨ n _ x (hev R _ n x), hev]

  have huniq : ∀ (R : Type u) [CommRing R] (r : R), (∀ x : R, r * x = 0 → x = 0) →
      ∀ (T : Type u) [CommRing T] (t : T), (∀ x : T, (∀ k : ℕ, ∃ y : T, x = t ^ k * y) → x = 0) →
      ∀ (f g : AdicCompletion (Ideal.span {r}) R →+* T),
        f (algebraMap R (AdicCompletion (Ideal.span {r}) R) r) = t →
        (∀ x : R, f (algebraMap R (AdicCompletion (Ideal.span {r}) R) x) =
          g (algebraMap R (AdicCompletion (Ideal.span {r}) R) x)) → f = g := by
    intro R _ r hr T _ t hsep f g hft hfg
    obtain ⟨-, -, h3⟩ := wcpa_dj_lr1s_nf_adic_completion_basics R r hr
    have hgt : g (algebraMap R (AdicCompletion (Ideal.span {r}) R) r) = t := (hfg r).symm.trans hft
    refine RingHom.ext (fun z => ?_)
    rw [← sub_eq_zero]
    apply hsep
    intro k
    obtain ⟨c, z', hz⟩ := h3 k z
    refine ⟨f z' - g z', ?_⟩
    rw [hz, map_add, map_add, map_mul, map_mul, map_pow, map_pow, hft, hgt, hfg c]
    ring

  have hclear : ∀ (R : Type u) [CommRing R] (u : R) (L : Type u) [CommRing L] [Nontrivial L]
      (G : Localization.Away u →+* L) (ℓ : L), G.IsIntegralElem ℓ →
      ∃ Q : Polynomial R, Q ≠ 0 ∧ Q.eval₂ (G.comp (algebraMap R (Localization.Away u))) ℓ = 0 := by
    intro R _ u L _ _ G ℓ hℓ
    obtain ⟨P, hPm, hP⟩ := hℓ
    refine ⟨IsLocalization.integerNormalization (Submonoid.powers u) P, ?_,
      IsLocalization.integerNormalization_eval₂_eq_zero (Submonoid.powers u) G P hP⟩
    intro hQ
    obtain ⟨b, hb, hbP⟩ := IsLocalization.integerNormalization_spec (Submonoid.powers u) P
    rw [hQ, Polynomial.map_zero] at hbP
    have h1 := congrArg (fun p => Polynomial.coeff p P.natDegree) hbP
    simp only [Polynomial.coeff_zero, Polynomial.coeff_smul, hPm.coeff_natDegree] at h1
    rw [Algebra.smul_def, mul_one] at h1
    have hu : IsUnit (algebraMap R (Localization.Away u) b) :=
      IsLocalization.map_units (Localization.Away u) (⟨b, hb⟩ : Submonoid.powers u)
    have h2 := hu.map G
    rw [← h1, map_zero] at h2
    exact not_isUnit_zero h2

  have hnebot : ∀ (S : Type u) [CommRing S] (p : S) (V : Type u) [CommRing V] [Nontrivial V] (q : V),
      (∀ x : V, q * x = 0 → x = 0) → ∀ (x : S) (E₀ E₁ : S →+* V), E₀ p = q → E₁ p = q →
      E₀ x = 0 → E₁ x = 1 → ∀ 𝔐 : Ideal (Localization.Away p), 𝔐.IsMaximal → 𝔐 ≠ ⊥ := by
    intro S _ p V _ _ q hq x E₀ E₁ h0 h1 hx0 hx1 𝔐 h𝔐 hbot
    have hpow : ∀ k : ℕ, q ^ k ≠ 0 := by
      intro k
      induction k with
      | zero => rw [pow_zero]; exact one_ne_zero
      | succ k ih => intro h; exact ih (hq _ (by rw [← pow_succ']; exact h))
    by_cases ha : algebraMap S (Localization.Away p) x = 0
    · obtain ⟨m, hmx⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers p) (Localization.Away p) x).mp ha
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
      rw [← hk] at hmx
      have h2 := congrArg E₁ hmx
      simp only [map_mul, map_pow, h1, hx1, mul_one, map_zero] at h2
      exact hpow k h2
    · have hxM : algebraMap S (Localization.Away p) x ∉ 𝔐 := fun h =>
        ha (by rw [hbot] at h; exact Ideal.mem_bot.mp h)
      obtain ⟨b, i, hi, hbi⟩ := h𝔐.exists_inv hxM
      rw [hbot, Ideal.mem_bot] at hi
      rw [hi, add_zero] at hbi
      obtain ⟨m, z, hz⟩ := IsLocalization.Away.surj p b
      have h2 : algebraMap S (Localization.Away p) (z * x) =
          algebraMap S (Localization.Away p) (p ^ m) := by
        rw [map_mul, ← hz, map_pow]
        linear_combination (algebraMap S (Localization.Away p) p) ^ m * hbi
      obtain ⟨c, hc'⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers p) (Localization.Away p)).mp h2
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp c.2
      rw [← hk] at hc'
      have h3 := congrArg E₀ hc'
      simp only [map_mul, map_pow, h0, hx0, mul_zero] at h3
      exact hpow (k + m) (by rw [pow_add]; first | exact h3.symm | exact h3)

  have hfinint : ∀ (R S : Type u) [CommRing R] [CommRing S] (Ψ : R →+* S) (p : R) (p' : S),
      Ψ p = p' → ∀ (𝔐 : Ideal (Localization.Away p')), 𝔐.IsMaximal → ∀ (g : S),
      algebraMap S (Localization.Away p') g ∈ 𝔐 → ∀ (s : ℕ) (y : Fin s → S),
      (∀ z : S, ∃ (q : S) (t : Fin s → R), z = q * g + ∑ j, Ψ (t j) * y j) →
      ∀ (μ : Localization.Away p →+* Localization.Away p'),
      (∀ t : R, μ (algebraMap R (Localization.Away p) t) = algebraMap S (Localization.Away p') (Ψ t)) →
      (RingHom.ker ((Ideal.Quotient.mk 𝔐).comp μ)).IsMaximal ∧
        ((Ideal.Quotient.mk 𝔐).comp μ).IsIntegral := by
    intro R S _ _ Ψ p p' hp 𝔐 h𝔐 g hg s y hdiv μ hμ
    haveI := h𝔐
    letI : Field (Localization.Away p' ⧸ 𝔐) := Ideal.Quotient.field 𝔐
    have hp' : algebraMap S (Localization.Away p') p' = μ (algebraMap R (Localization.Away p) p) := by
      rw [hμ, hp]
    have hi : μ (IsLocalization.Away.invSelf p) = IsLocalization.Away.invSelf p' := by
      have hu : IsUnit (algebraMap S (Localization.Away p') p') :=
        IsLocalization.Away.algebraMap_isUnit p'
      apply hu.mul_left_cancel
      rw [IsLocalization.Away.mul_invSelf, hp', ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
    have hg0 : Ideal.Quotient.mk 𝔐 (algebraMap S (Localization.Away p') g) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hg
    have hspan : ∀ ℓ : Localization.Away p' ⧸ 𝔐, ∃ c : Fin s → Localization.Away p,
        ℓ = ∑ j, ((Ideal.Quotient.mk 𝔐).comp μ) (c j) *
          Ideal.Quotient.mk 𝔐 (algebraMap S (Localization.Away p') (y j)) := by
      intro ℓ
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective ℓ
      obtain ⟨m, z, hz⟩ := IsLocalization.Away.surj p' a
      obtain ⟨q, t, hzq⟩ := hdiv z
      refine ⟨fun j => algebraMap R (Localization.Away p) (t j) * IsLocalization.Away.invSelf p ^ m, ?_⟩
      have ha : a = algebraMap S (Localization.Away p') z * IsLocalization.Away.invSelf p' ^ m := by
        rw [← hz, mul_assoc, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]
      rw [ha, hzq]
      simp only [map_mul, map_add, map_sum, hg0, mul_zero, zero_add, Finset.sum_mul,
        RingHom.comp_apply, map_pow, hi, hμ]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ring
    have hfin : ((Ideal.Quotient.mk 𝔐).comp μ).Finite := by
      letI := ((Ideal.Quotient.mk 𝔐).comp μ).toAlgebra
      show Module.Finite (Localization.Away p) (Localization.Away p' ⧸ 𝔐)
      refine Module.finite_def.mpr ⟨Finset.univ.image
        (fun j => Ideal.Quotient.mk 𝔐 (algebraMap S (Localization.Away p') (y j))), ?_⟩
      rw [eq_top_iff]
      intro ℓ _
      obtain ⟨c, hc⟩ := hspan ℓ
      rw [hc]
      refine Submodule.sum_mem _ (fun j _ => ?_)
      have h1 : ((Ideal.Quotient.mk 𝔐).comp μ) (c j) *
          Ideal.Quotient.mk 𝔐 (algebraMap S (Localization.Away p') (y j)) =
          c j • Ideal.Quotient.mk 𝔐 (algebraMap S (Localization.Away p') (y j)) :=
        (Algebra.smul_def _ _).symm
      rw [h1]
      exact Submodule.smul_mem _ _ (Submodule.subset_span
        (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_univ j))))
    have hint : ((Ideal.Quotient.mk 𝔐).comp μ).IsIntegral := RingHom.IsIntegral.of_finite hfin
