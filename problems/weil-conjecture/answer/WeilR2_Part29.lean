        fin_cases n
        · exact Subring.subset_closure (Set.mem_union_left _
            ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
              (hnat _).trans (congrArg _ hθX)⟩)
