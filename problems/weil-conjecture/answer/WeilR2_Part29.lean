        simp only [map_mul, map_pow, hΦren, MvPolynomial.finSuccEquiv_X_zero]
        rw [← hmodsum, ← hp]
        rw [hg'] at hdiv
        linear_combination -hdiv

      have adic_series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
        intro R _ r
        have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
          AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
        have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
            x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
            ∃ y : AdicCompletion (Ideal.span {r}) R,
              x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
          intro n x
          constructor
          · intro hx
            refine Submodule.smul_induction_on hx ?_ ?_
            · intro a ha m _
              rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
              obtain ⟨c, rfl⟩ := ha
              refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
              rw [Algebra.smul_def, map_mul, map_pow]
              ring
            · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
              exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
          · rintro ⟨y, rfl⟩
            rw [← map_pow, ← Algebra.smul_def]
            exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
              Submodule.mem_top
        refine ⟨fun f hf => ?_, fun x hx => ?_⟩
        · choose y hy using hf
          have s4 : ∀ m n : ℕ, m ≤ n →
              f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
            intro m n hmn
            induction n, hmn using Nat.le_induction with
            | base => rw [sub_self]; exact Submodule.zero_mem _
            | succ n hmn ih =>
              rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
              refine Submodule.add_mem _ ?_ ih
              have h1 : f (n + 1) - f n ∈
                  (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
                (s1 n _).mpr ⟨y n, hy n⟩
              exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
          obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
            rw [SModEq.sub_mem, ← neg_sub]
            exact Submodule.neg_mem _ (s4 m n hmn))
          refine ⟨L, fun n => (s1 n _).mp ?_⟩
          have h := SModEq.sub_mem.mp (hL n)
          rw [← neg_sub]
          exact Submodule.neg_mem _ h
        · refine hc.toIsHausdorff.haus x (fun k => ?_)
          rw [SModEq.sub_mem, sub_zero]
          exact (s1 k x).mpr (hx k)

      have DEC : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
        intro C _ p hp
        have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
            (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
            Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
          intro k c
          rw [AlgHom.commutes]
          rfl
        have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
          intro k x
          rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
            p ^ m ∣ a k - a m := by
          intro a m k hmk
          rw [← hmem, map_sub, sub_eq_zero]
          exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
        have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
          intro n
          induction n with
          | zero => intro x h; simpa using h
          | succ n ih =>
            intro x h
            apply ih
            apply hp
            rw [← mul_assoc, ← pow_succ']
            exact h
        have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
          intro n u v h
          rw [← sub_eq_zero]
          apply hN n
          rw [mul_sub, h, sub_self]
        intro n y
        obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
        have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
          fun k => hD a n (k + n) (by omega)
        choose b hb using hex
        have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
          intro k
          rw [SModEq.sub_mem]
          obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
          have e : b k - b (k + 1) = p ^ k * (-s) := by
            apply hNc n
            linear_combination (-1 : C) * hb k + hb (k + 1) - hs
          rw [e]
          exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
            Submodule.mem_top
        let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
          AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
        have hBk : ∀ k, B k = b k := fun k => rfl
        refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
        apply AdicCompletion.ext_evalₐ
        intro k
        rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
          ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
        obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
        exact ⟨-s, by linear_combination hb k - hs⟩

      have crk : ∀ μ : ↥W, ¬ IsUnit μ → ∃ (j : ℕ) (w : ↥W), μ ^ j = ϖ * w := by
        intro μ hμ
        haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
        have hrad : μ ∈ (Ideal.span {ϖ}).radical := by
          rw [Ideal.radical_eq_sInf]
          refine Ideal.mem_sInf.mpr ?_
          rintro J ⟨hJc, hJp⟩
          have hJne : J ≠ ⊥ := by
            intro h
            apply hϖ0
            have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
            rw [h] at h1
            exact Ideal.mem_bot.mp h1
          have hJmax : J.IsMaximal := by
            rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
            · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
            · exact h
          rw [IsLocalRing.eq_maximalIdeal hJmax]
          exact (IsLocalRing.mem_maximalIdeal μ).mpr hμ
        obtain ⟨n, hn⟩ := hrad
        obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
        exact ⟨n, w, by rw [← hw, mul_comm]⟩

      obtain ⟨ι, -, hιalg⟩ := c5 (MvPolynomial (Fin d) ↥W) (MvPolynomial (Fin (d + 1)) ↥W)
        (MvPolynomial.rename (R := ↥W) (Fin.succ : Fin d → Fin (d + 1))).toRingHom
        (MvPolynomial.C ϖ) (MvPolynomial.C ϖ) (by simp)
      set algD := algebraMap (MvPolynomial (Fin d) ↥W)
        (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
          (MvPolynomial (Fin d) ↥W)) with halgD
      set alg1 := algebraMap (MvPolynomial (Fin (d + 1)) ↥W)
        (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
          (MvPolynomial (Fin (d + 1)) ↥W)) with halg1
      have hι' : ∀ a : MvPolynomial (Fin d) ↥W,
          ι (algD a) = alg1 (MvPolynomial.rename Fin.succ a) := fun a => hιalg a
      have hιt : ι (algD (MvPolynomial.C ϖ)) = alg1 (MvPolynomial.C ϖ) := by
        rw [hι', MvPolynomial.rename_C]
      refine ⟨ι, hιt, ?_⟩
      intro u ρ N L Y hu hρ hL
      have htf : ∀ x : MvPolynomial (Fin (d + 1)) ↥W, MvPolynomial.C ϖ * x = 0 → x = 0 := by
        intro x hx
        have hC : (MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W) ≠ 0 := by
          intro hc
          exact hϖ0 (MvPolynomial.C_eq_zero.mp hc)
        exact (mul_eq_zero.mp hx).resolve_left hC

      have one : ∀ h : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
          (MvPolynomial (Fin (d + 1)) ↥W), ∃ (Q₀ : MvPolynomial (Fin (d + 1)) ↥W)
          (r₀ : Fin N → MvPolynomial (Fin d) ↥W)
          (h'' : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
            (MvPolynomial (Fin (d + 1)) ↥W)),
          h = alg1 Q₀ * (alg1 (MvPolynomial.C u * MvPolynomial.X 0 ^ N + L) +
              alg1 (MvPolynomial.C ρ) * Y) +
            ∑ i, ι (algD (r₀ i)) * alg1 (MvPolynomial.X 0) ^ (i : ℕ) +
            alg1 (MvPolynomial.C ϖ) * h'' - alg1 (MvPolynomial.C ρ) * alg1 Q₀ * Y := by
        intro h
        obtain ⟨P, h'', hP⟩ := DEC (MvPolynomial (Fin (d + 1)) ↥W) (MvPolynomial.C ϖ) htf 1 h
        obtain ⟨Q₀, r₀, hQ₀⟩ := c8 ↥W d N u L hu hL P
        refine ⟨Q₀, r₀, h'', ?_⟩
        have hs : ∑ i, ι (algD (r₀ i)) * alg1 (MvPolynomial.X 0) ^ (i : ℕ) =
            alg1 (∑ i : Fin N, MvPolynomial.rename Fin.succ (r₀ i) * MvPolynomial.X 0 ^ (i : ℕ)) := by
          rw [map_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [hι', map_mul, map_pow]
        rw [hs, hP, hQ₀, pow_one, map_add, map_mul]
        ring

      have Ht : ∀ h : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
          (MvPolynomial (Fin (d + 1)) ↥W), ∃ (Q : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ :
            MvPolynomial (Fin (d + 1)) ↥W)}) (MvPolynomial (Fin (d + 1)) ↥W))
          (r : Fin N → AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
            (MvPolynomial (Fin d) ↥W))
          (h' : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
            (MvPolynomial (Fin (d + 1)) ↥W)),
          h = Q * (alg1 (MvPolynomial.C u * MvPolynomial.X 0 ^ N + L) +
              alg1 (MvPolynomial.C ρ) * Y) +
            ∑ i, ι (r i) * alg1 (MvPolynomial.X 0) ^ (i : ℕ) + alg1 (MvPolynomial.C ϖ) * h' := by
        rcases ValuationRing.dvd_total ρ ϖ with ⟨m, hm⟩ | ⟨m, hm⟩
        ·
          obtain ⟨j, w, hjw⟩ := crk ρ hρ
          have hνj : algD (MvPolynomial.C ρ) ^ j = algD (MvPolynomial.C ϖ) * algD (MvPolynomial.C w) := by
            rw [← map_pow, ← MvPolynomial.C_pow, hjw, MvPolynomial.C_mul, map_mul]
          refine c3a _ _ ι _ _ hιt _ _ N (algD (MvPolynomial.C ρ)) (algD (MvPolynomial.C w)) j hνj ?_
          intro h
          obtain ⟨Q₀, r₀, h'', e⟩ := one h
          refine ⟨alg1 Q₀, fun i => algD (r₀ i), alg1 (MvPolynomial.C m) * h'' - alg1 Q₀ * Y, ?_⟩
          have hν : ι (algD (MvPolynomial.C ρ)) = alg1 (MvPolynomial.C ρ) := by
            rw [hι', MvPolynomial.rename_C]
          have htρ : alg1 (MvPolynomial.C ϖ) = alg1 (MvPolynomial.C ρ) * alg1 (MvPolynomial.C m) := by
            rw [← map_mul, ← MvPolynomial.C_mul, ← hm]
          rw [hν]
          linear_combination e + h'' * htρ
        ·
          intro h
          obtain ⟨Q₀, r₀, h'', e⟩ := one h
          refine ⟨alg1 Q₀, fun i => algD (r₀ i), h'' - alg1 (MvPolynomial.C m) * alg1 Q₀ * Y, ?_⟩
          have hρt : alg1 (MvPolynomial.C ρ) = alg1 (MvPolynomial.C ϖ) * alg1 (MvPolynomial.C m) := by
            rw [← map_mul, ← MvPolynomial.C_mul, ← hm]
          linear_combination e - (alg1 Q₀ * Y) * hρt

      intro h
      obtain ⟨hcomplD, -⟩ := adic_series (MvPolynomial (Fin d) ↥W) (MvPolynomial.C ϖ)
      obtain ⟨hcomplD1, hsepD1⟩ := adic_series (MvPolynomial (Fin (d + 1)) ↥W) (MvPolynomial.C ϖ)
      exact c3b _ _ ι _ _ hιt hcomplD hcomplD1 hsepD1 _ _ N Ht h
  intro Ω _ _ W hW ϖ hϖ0 hϖnu
  classical

  have adic_series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
    intro R _ r
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
          Submodule.mem_top
    refine ⟨fun f hf => ?_, fun x hx => ?_⟩
    · choose y hy using hf
      have s4 : ∀ m n : ℕ, m ≤ n →
          f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        intro m n hmn
        induction n, hmn using Nat.le_induction with
        | base => rw [sub_self]; exact Submodule.zero_mem _
        | succ n hmn ih =>
          rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
          refine Submodule.add_mem _ ?_ ih
          have h1 : f (n + 1) - f n ∈
              (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
            (s1 n _).mpr ⟨y n, hy n⟩
          exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
      obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, ← neg_sub]
        exact Submodule.neg_mem _ (s4 m n hmn))
      refine ⟨L, fun n => (s1 n _).mp ?_⟩
      have h := SModEq.sub_mem.mp (hL n)
      rw [← neg_sub]
      exact Submodule.neg_mem _ h
    · refine hc.toIsHausdorff.haus x (fun k => ?_)
      rw [SModEq.sub_mem, sub_zero]
      exact (s1 k x).mpr (hx k)

  have crk : ∀ μ : ↥W, ¬ IsUnit μ → ∃ (j : ℕ) (w : ↥W), μ ^ j = ϖ * w := by
    intro μ hμ
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hrad : μ ∈ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine Ideal.mem_sInf.mpr ?_
      rintro J ⟨hJc, hJp⟩
      have hJne : J ≠ ⊥ := by
        intro h
        apply hϖ0
        have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
        rw [h] at h1
        exact Ideal.mem_bot.mp h1
      have hJmax : J.IsMaximal := Ideal.IsPrime.isMaximal_of_ne_bot hJp hJne
      rw [IsLocalRing.eq_maximalIdeal hJmax]
      exact (IsLocalRing.mem_maximalIdeal μ).mpr hμ
    obtain ⟨n, hn⟩ := hrad
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
    exact ⟨n, w, by rw [← hw, mul_comm]⟩

  have one_add : ∀ (R : Type u) [CommRing R] (r : R) (z : AdicCompletion (Ideal.span {r}) R),
      IsUnit (1 + algebraMap R (AdicCompletion (Ideal.span {r}) R) r * z) := by
    intro R _ r z
    obtain ⟨hC, hS⟩ := adic_series R r
    set t := algebraMap R (AdicCompletion (Ideal.span {r}) R) r with ht
    obtain ⟨L, hL⟩ := hC (fun n => ∑ k ∈ Finset.range n, (t * (-z)) ^ k) (fun n => ⟨(-z) ^ n, by
      simp only [Finset.sum_range_succ, add_sub_cancel_left]
      rw [mul_pow]⟩)
    have hL' : ∀ n : ℕ, ∃ y, L - ∑ k ∈ Finset.range n, (t * (-z)) ^ k = t ^ n * y := hL
    have key : ∀ n : ℕ, ∃ y, (1 - t * (-z)) * L - 1 = t ^ n * y := by
      intro n
      obtain ⟨y, hy⟩ := hL' n
      refine ⟨(1 - t * (-z)) * y - (-z) ^ n, ?_⟩
      have h1 := mul_neg_geom_sum (t * (-z)) n
      have h2 : (t * (-z)) ^ n = t ^ n * (-z) ^ n := mul_pow _ _ _
      linear_combination (1 - t * (-z)) * hy + h1 - h2
    have hE := hS _ key
    have h1 : (1 + t * z) * L = 1 := by linear_combination hE
    exact isUnit_iff_exists_inv.mpr ⟨L, h1⟩

  have hfinq : ∀ (A B : Type u) [CommRing A] [CommRing B] (κ : A →+* B) (Q₁ : Ideal B) (F X : B)
      (N : ℕ), F ∈ Q₁ → (∀ x : B, ∃ (q : B) (a : Fin N → A),
        x = q * F + ∑ i : Fin N, κ (a i) * X ^ (i : ℕ)) →
      (Ideal.quotientMap Q₁ κ (le_refl (Ideal.comap κ Q₁))).Finite := by
    intro A B _ _ κ Q₁ F X N hF h
    letI := (Ideal.quotientMap Q₁ κ (le_refl (Ideal.comap κ Q₁))).toAlgebra
    unfold RingHom.Finite
    refine ⟨⟨Finset.univ.image (fun i : Fin N => Ideal.Quotient.mk Q₁ (X ^ (i : ℕ))), ?_⟩⟩
    rw [eq_top_iff]
    rintro z -
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨q, a, hx⟩ := h x
    rw [hx, map_add, map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hF, mul_zero, zero_add, map_sum]
    refine Submodule.sum_mem _ (fun i _ => ?_)
    have e : Ideal.Quotient.mk Q₁ (κ (a i) * X ^ (i : ℕ)) =
        (Ideal.Quotient.mk (Ideal.comap κ Q₁) (a i)) • Ideal.Quotient.mk Q₁ (X ^ (i : ℕ)) := by
      rw [Algebra.smul_def, map_mul]
      congr 1
    rw [e]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

  intro d
  induction d with
  | zero =>
    intro Q hQ htQ
    by_cases hQ0 : Q = ⊥
    · subst hQ0
