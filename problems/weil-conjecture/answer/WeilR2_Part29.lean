theorem wcpa_dj_lr1s_nf_cnf_bd_tnn_saturation : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) (x : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (n : ℕ) (a : Localization.Away (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ))), a * algebraMap (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (Localization.Away (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ))) (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) ^ n) = algebraMap (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (Localization.Away (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ))) x → IsIntegral (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) a → ∃ y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W), x = algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) ^ n * y :=
by
  classical

  have core : ∀ (T D : Type u) [CommRing T] [CommRing D] [IsDomain D] (t : T) (ρ : T →+* D),
      (∀ y : T, t * y = 0 → y = 0) →
      (∀ y : T, y ≠ 0 → (∃ y' : T, y = t * y') ∨ ∃ (cc vv μμ y₀ : T) (k : ℕ),
        t = cc * vv ∧ ρ vv = 0 ∧ cc * μμ = t ^ k ∧ y = cc * y₀ ∧ ρ y₀ ≠ 0) →
      ∀ (x : T) (n : ℕ) (a : Localization.Away t),
        a * algebraMap T (Localization.Away t) (t ^ n) = algebraMap T (Localization.Away t) x →
        IsIntegral T a → ∃ y : T, x = t ^ n * y := by
    intro T D _ _ _ t ρ htf hsplit
    have hpow : ∀ (k : ℕ) (z : T), t ^ k * z = 0 → z = 0 := by
      intro k
      induction k with
      | zero => intro z h; simpa using h
      | succ k ih =>
        intro z h
        apply ih
        apply htf
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hinj : Function.Injective (algebraMap T (Localization.Away t)) := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨m, hm⟩, hmz⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers t) _ z).mp hz
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
      exact hpow k z hmz
    have hunit : ∀ k : ℕ, IsUnit (algebraMap T (Localization.Away t) (t ^ k)) := fun k => by
      rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit t).pow k

    have hscale : ∀ (u x₀ : T) (z : Localization.Away t), ρ u = 0 → ρ x₀ ≠ 0 →
        algebraMap T (Localization.Away t) u * z = algebraMap T (Localization.Away t) x₀ →
        ¬ IsIntegral T z := by
      intro u x₀ z hu hx₀ hz hint
      obtain ⟨p, hpm, hp⟩ := hint
      have h1 := Polynomial.scaleRoots_eval₂_eq_zero (s := u) (algebraMap T (Localization.Away t)) hp
      rw [hz, Polynomial.eval₂_at_apply] at h1
      have hE : Polynomial.eval x₀ (p.scaleRoots u) = 0 :=
        hinj (h1.trans (map_zero _).symm)
      rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots] at hE
      have hρ := congrArg ρ hE
      rw [map_sum, map_zero, Finset.sum_eq_single p.natDegree] at hρ
      · rw [Polynomial.coeff_scaleRoots, hpm.coeff_natDegree, Nat.sub_self, pow_zero, one_mul,
          one_mul, map_pow] at hρ
        exact pow_ne_zero _ hx₀ hρ
      · intro i hi hne
        have hlt : i < p.natDegree := by
          have := Finset.mem_range.mp hi
          omega
        rw [Polynomial.coeff_scaleRoots, map_mul, map_mul, map_pow, hu,
          zero_pow (by omega), mul_zero, zero_mul]
      · intro h
        exact absurd (Finset.self_mem_range_succ _) h

    have hone : ∀ (y : T) (a : Localization.Away t),
        a * algebraMap T (Localization.Away t) t = algebraMap T (Localization.Away t) y →
        IsIntegral T a → ∃ y' : T, y = t * y' := by
      intro y a hay ha
      by_cases hy : y = 0
      · exact ⟨0, by rw [hy, mul_zero]⟩
      rcases hsplit y hy with h | ⟨cc, vv, μμ, y₀, k, htc, hvv, hcμ, hyc, hy₀⟩
      · exact h
      · exfalso
        apply hscale vv y₀ a hvv hy₀ _ ha
        have hZ : algebraMap T (Localization.Away t) cc *
            (algebraMap T (Localization.Away t) vv * a - algebraMap T (Localization.Away t) y₀)
            = 0 := by
          have e : algebraMap T (Localization.Away t) cc *
              (algebraMap T (Localization.Away t) vv * a - algebraMap T (Localization.Away t) y₀)
              = a * algebraMap T (Localization.Away t) (cc * vv) -
                algebraMap T (Localization.Away t) (cc * y₀) := by
            rw [map_mul, map_mul]; ring
          rw [e, ← htc, ← hyc, hay, sub_self]
        have hZ2 : algebraMap T (Localization.Away t) (t ^ k) *
            (algebraMap T (Localization.Away t) vv * a - algebraMap T (Localization.Away t) y₀)
            = 0 := by
          rw [← hcμ, map_mul, mul_comm (algebraMap T (Localization.Away t) cc), mul_assoc, hZ,
            mul_zero]
        exact sub_eq_zero.mp ((hunit k).mul_right_eq_zero.mp hZ2)
    intro x n
    induction n generalizing x with
    | zero => intro a _ _; exact ⟨x, by rw [pow_zero, one_mul]⟩
    | succ n ih =>
      intro a hax ha
      have ha' : IsIntegral T (a * algebraMap T (Localization.Away t) t) :=
        ha.mul isIntegral_algebraMap
      obtain ⟨y, hy⟩ := ih x (a * algebraMap T (Localization.Away t) t)
        (by rw [← hax, pow_succ, map_mul]; ring) ha'
      have hay : a * algebraMap T (Localization.Away t) t = algebraMap T (Localization.Away t) y := by
        apply (hunit n).mul_left_cancel
        rw [← map_mul (algebraMap T (Localization.Away t)), ← hy, ← hax, pow_succ, map_mul]
        ring
      obtain ⟨y', hy'⟩ := hone y a hay ha
      exact ⟨y', by rw [hy, hy', pow_succ, mul_assoc]⟩

  intro Ω _ W ϖ hϖ0 hϖnu d
  have hres : ∀ v : ↥W, ¬ IsUnit v → IsLocalRing.residue ↥W v = 0 := fun v hv =>
    (IsLocalRing.residue_eq_zero_iff v).mpr ((IsLocalRing.mem_maximalIdeal v).mpr hv)
  have htf : ∀ z : MvPolynomial (Fin d) ↥W, MvPolynomial.C ϖ * z = 0 → z = 0 := fun z hz =>
    (mul_eq_zero.mp hz).resolve_left (fun h0 => hϖ0 (MvPolynomial.C_eq_zero.mp h0))
  obtain ⟨hTF, -, -⟩ := wcpa_dj_lr1s_nf_adic_completion_basics _ _ htf
  have hH : ∀ z ∈ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) ^ 1,
      MvPolynomial.map (IsLocalRing.residue ↥W) z = 0 := by
    intro z hz
    rw [pow_one, Ideal.mem_span_singleton'] at hz
    obtain ⟨w, rfl⟩ := hz
    rw [map_mul, MvPolynomial.map_C, hres ϖ hϖnu, MvPolynomial.C_0, mul_zero]
  let ρ : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
      (MvPolynomial (Fin d) ↥W) →+* MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W) :=
    (Ideal.Quotient.lift _ (MvPolynomial.map (IsLocalRing.residue ↥W)) hH).comp
      (AdicCompletion.evalₐ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) 1).toRingHom
  have hρ : ∀ P : MvPolynomial (Fin d) ↥W, ρ (algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) P) = MvPolynomial.map (IsLocalRing.residue ↥W) P := by
    intro P
    show Ideal.Quotient.lift _ _ hH (AdicCompletion.evalₐ _ 1 (algebraMap _ _ P)) = _
    rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      AdicCompletion.evalₐ_of, Ideal.Quotient.lift_mk]
  refine core _ (MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W)) _ ρ hTF ?_
  intro y hy
  obtain ⟨c, μ, k, F, y₁, hcμ, hμ, ⟨e, he⟩, hyeq⟩ :=
    wcpa_dj_lr1s_nf_cnf_bd_tn_content Ω W ϖ hϖ0 hϖnu d y hy
  have hy₀ : ρ (algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) F + algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C μ) * y₁) ≠ 0 := by
    rw [map_add, map_mul, hρ, hρ, MvPolynomial.map_C, hres μ hμ, MvPolynomial.C_0, zero_mul,
      add_zero]
    intro h0
    have h1 : (MvPolynomial.map (IsLocalRing.residue ↥W) F).coeff e =
        (0 : MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W)).coeff e := by rw [h0]
    rw [MvPolynomial.coeff_map, he, map_one, MvPolynomial.coeff_zero] at h1
    exact one_ne_zero h1
  generalize hY : (algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) F + algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C μ) * y₁) = y₀ at hyeq hy₀
  rcases ValuationRing.dvd_total c ϖ with ⟨v, hv⟩ | ⟨m, hm⟩
  · by_cases hvu : IsUnit v
    · left
      have hc : c = ϖ * ↑hvu.unit⁻¹ := by rw [hv, mul_assoc, IsUnit.mul_val_inv, mul_one]
      refine ⟨algebraMap (MvPolynomial (Fin d) ↥W)
        (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
          (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C (↑hvu.unit⁻¹ : ↥W)) * y₀, ?_⟩
      rw [hyeq, hc, MvPolynomial.C_mul, map_mul, mul_assoc]
    · right
      refine ⟨algebraMap (MvPolynomial (Fin d) ↥W)
        (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
          (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C c),
        algebraMap (MvPolynomial (Fin d) ↥W)
        (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
          (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C v),
        algebraMap (MvPolynomial (Fin d) ↥W)
        (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
          (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C μ), y₀, k, ?_, ?_, ?_, hyeq, hy₀⟩
      · rw [← map_mul, ← MvPolynomial.C_mul, ← hv]
      · rw [hρ, MvPolynomial.map_C, hres v hvu, MvPolynomial.C_0]
      · rw [← map_mul, ← MvPolynomial.C_mul, hcμ, MvPolynomial.C_pow, map_pow]
  · left
    refine ⟨algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C m) * y₀, ?_⟩
    rw [hyeq, hm, MvPolynomial.C_mul, map_mul, mul_assoc]

theorem wcpa_dj_lr1s_nf_cnf_bd_tnn_base_field : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ a : Localization.Away (algebraMap (MvPolynomial (Fin 0) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin 0) ↥W)}) (MvPolynomial (Fin 0) ↥W)) (MvPolynomial.C ϖ)), a ≠ 0 → IsUnit a :=
by
  intro Ω _ W hW ϖ hϖ0 hϖnu
  classical
  have cb : ∀ (T : Type u) [CommRing T] (t : T), (∀ f : T, f ≠ 0 → ∃ (k : ℕ) (g : T),
      f * g = t ^ k) → ∀ a : Localization.Away t, a ≠ 0 → IsUnit a := by
    intro T _ t hf a ha0
    obtain ⟨⟨f, s⟩, hfs⟩ := IsLocalization.surj (Submonoid.powers t) a
    dsimp only at hfs
    have hf0 : f ≠ 0 := by
      intro h; apply ha0
      rw [h, map_zero] at hfs
      exact (IsLocalization.map_units (Localization.Away t) s).mul_left_eq_zero.mp hfs
    obtain ⟨k, g, hg⟩ := hf f hf0
    have hU : IsUnit (algebraMap T (Localization.Away t) t ^ k) :=
      (IsLocalization.Away.algebraMap_isUnit t).pow k
    have hfu : IsUnit (algebraMap T (Localization.Away t) f) := by
      rw [← map_pow, ← hg, map_mul] at hU
      exact isUnit_of_mul_isUnit_left hU
    rw [← hfs] at hfu
    exact isUnit_of_mul_isUnit_left hfu

  have c10 : ∀ (T : Type u) [CommRing T] (t : T), (∀ f : ℕ → T, (∀ n : ℕ, ∃ y : T,
      f (n + 1) - f n = t ^ n * y) → ∃ L : T, ∀ n : ℕ, ∃ y : T, L - f n = t ^ n * y) →
      (∀ z : T, (∀ k : ℕ, ∃ y : T, z = t ^ k * y) → z = 0) →
      ∀ (z w : T) (j : ℕ), z ^ j = t * w → IsUnit (1 + z) := by
    intro T _ t hC hS z w j hz
    have hz' : (-z) ^ j = t * ((-1) ^ j * w) := by rw [neg_pow, hz]; ring
    have hs : ∀ m : ℕ, (1 + z) * (∑ i ∈ Finset.range m, (-z) ^ i) = 1 - (-z) ^ m := by
      intro m
      induction m with
      | zero => simp
      | succ m ih => rw [Finset.sum_range_succ, mul_add, ih, pow_succ]; ring
    have hpow : ∀ n : ℕ, (-z) ^ (j * n) = t ^ n * ((-1) ^ j * w) ^ n := by
      intro n; rw [pow_mul, hz', mul_pow]
    obtain ⟨L, hL⟩ := hC (fun n => ∑ i ∈ Finset.range (j * n), (-z) ^ i) (fun n => by
      refine ⟨((-1) ^ j * w) ^ n * ∑ i ∈ Finset.range j, (-z) ^ i, ?_⟩
      show ∑ i ∈ Finset.range (j * (n + 1)), (-z) ^ i - ∑ i ∈ Finset.range (j * n), (-z) ^ i = _
      rw [show j * (n + 1) = j * n + j by ring, Finset.sum_range_add, add_sub_cancel_left]
      simp_rw [pow_add]
      rw [← Finset.mul_sum, hpow n]
      ring)
    have hzero : (1 + z) * L - 1 = 0 := by
      apply hS
      intro n
      obtain ⟨y, hy⟩ := hL n
      refine ⟨(1 + z) * y - ((-1) ^ j * w) ^ n, ?_⟩
      have h1 := hs (j * n)
      rw [hpow n] at h1
      have hy' : L - ∑ i ∈ Finset.range (j * n), (-z) ^ i = t ^ n * y := hy
      linear_combination (1 + z) * hy' + h1
    have h1 : (1 + z) * L = 1 := sub_eq_zero.mp hzero
    exact ⟨⟨1 + z, L, h1, by rw [mul_comm]; exact h1⟩, rfl⟩

  have crk : ∀ μ : ↥W, ¬ IsUnit μ → ∃ (j : ℕ) (w : ↥W), μ ^ j = ϖ * w := by
    intro μ hμ
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hrad : μ ∈ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine Ideal.mem_sInf.mpr ?_
      rintro J ⟨hJc, hJp⟩
      have hJne : J ≠ ⊥ := by
        intro h
        apply hϖ0
        have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
        rw [h] at h1
        exact Ideal.mem_bot.mp h1
      have hJmax : J.IsMaximal := by
        rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
        · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
        · exact h
      rw [IsLocalRing.eq_maximalIdeal hJmax]
      exact (IsLocalRing.mem_maximalIdeal μ).mpr hμ
    obtain ⟨n, hn⟩ := hrad
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
    exact ⟨n, w, by rw [← hw, mul_comm]⟩
  set alg := algebraMap (MvPolynomial (Fin 0) ↥W)
    (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin 0) ↥W)})
      (MvPolynomial (Fin 0) ↥W)) with halg

  have hdivt : ∀ f : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin 0) ↥W)})
      (MvPolynomial (Fin 0) ↥W), f ≠ 0 → ∃ (k : ℕ) (g : AdicCompletion
        (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin 0) ↥W)}) (MvPolynomial (Fin 0) ↥W)),
      f * g = alg (MvPolynomial.C ϖ) ^ k := by
    intro f hf
    obtain ⟨c, μ, k, F, y, hcμ, hμ, ⟨e, he⟩, hfeq⟩ :=
      wcpa_dj_lr1s_nf_cnf_bd_tn_content Ω W ϖ hϖ0 hϖnu 0 f hf
    have hF : F = 1 := by
      rw [MvPolynomial.eq_C_of_isEmpty F]
      rw [Subsingleton.elim e 0] at he
      rw [he, MvPolynomial.C_1]
    obtain ⟨j, w, hjw⟩ := crk μ hμ
    have hz : (alg (MvPolynomial.C μ) * y) ^ j =
        alg (MvPolynomial.C ϖ) * (alg (MvPolynomial.C w) * y ^ j) := by
      rw [mul_pow, ← map_pow, ← MvPolynomial.C_pow, hjw, MvPolynomial.C_mul, map_mul]; ring
    obtain ⟨hcompl, hsep⟩ := wcpa_dj_lr1s_nf_cnf_adic_series (MvPolynomial (Fin 0) ↥W)
      (MvPolynomial.C ϖ)
    obtain ⟨v, hv⟩ := (c10 _ _ hcompl hsep _ _ j hz).exists_right_inv
    refine ⟨k, v * alg (MvPolynomial.C μ), ?_⟩
    rw [hfeq, hF, map_one]
    have e : alg (MvPolynomial.C ϖ) ^ k = alg (MvPolynomial.C c) * alg (MvPolynomial.C μ) := by
      rw [← map_pow, ← MvPolynomial.C_pow, ← hcμ, MvPolynomial.C_mul, map_mul]
    rw [e]
    linear_combination (alg (MvPolynomial.C c) * alg (MvPolynomial.C μ)) * hv

  exact cb _ _ hdivt

theorem wcpa_dj_lr1s_nf_cnf_bd_tnn_unit_of_reduction : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (n : ℕ) (ρ : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W) →+* MvPolynomial (Fin n) (IsLocalRing.ResidueField ↥W)), (∀ P : MvPolynomial (Fin n) ↥W, ρ (algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) P) = MvPolynomial.map (IsLocalRing.residue ↥W) P) → ∀ q : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W), IsUnit (ρ q) → IsUnit q :=
by
  intro Ω _ W hW ϖ hϖ0 hϖnu n ρ hρ q hq
  classical

  have adic_series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
    intro R _ r
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
          Submodule.mem_top
    refine ⟨fun f hf => ?_, fun x hx => ?_⟩
    · choose y hy using hf
      have s4 : ∀ m n : ℕ, m ≤ n →
          f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        intro m n hmn
        induction n, hmn using Nat.le_induction with
        | base => rw [sub_self]; exact Submodule.zero_mem _
        | succ n hmn ih =>
          rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
          refine Submodule.add_mem _ ?_ ih
          have h1 : f (n + 1) - f n ∈
              (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
            (s1 n _).mpr ⟨y n, hy n⟩
          exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
      obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, ← neg_sub]
        exact Submodule.neg_mem _ (s4 m n hmn))
      refine ⟨L, fun n => (s1 n _).mp ?_⟩
      have h := SModEq.sub_mem.mp (hL n)
      rw [← neg_sub]
      exact Submodule.neg_mem _ h
    · refine hc.toIsHausdorff.haus x (fun k => ?_)
      rw [SModEq.sub_mem, sub_zero]
      exact (s1 k x).mpr (hx k)

  have DEC : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    intro n y
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
      fun k => hD a n (k + n) (by omega)
    choose b hb using hex
    have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
      intro k
      rw [SModEq.sub_mem]
      obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
      have e : b k - b (k + 1) = p ^ k * (-s) := by
        apply hNc n
        linear_combination (-1 : C) * hb k + hb (k + 1) - hs
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
        Submodule.mem_top
    let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
      AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
    have hBk : ∀ k, B k = b k := fun k => rfl
    refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
    obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
    exact ⟨-s, by linear_combination hb k - hs⟩

  have one_add : ∀ (R : Type u) [CommRing R] (r : R) (z y : AdicCompletion (Ideal.span {r}) R)
      (m : ℕ), z ^ m = algebraMap R (AdicCompletion (Ideal.span {r}) R) r * y → IsUnit (1 + z) := by
    intro R _ r z y m hz
    obtain ⟨AS1, AS2⟩ := adic_series R r
