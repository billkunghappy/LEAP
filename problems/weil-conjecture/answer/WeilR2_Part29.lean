    (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
      (algebraMap R0 C ϖ)))
    (algebraMap _ _) κ (algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) ϖ)
    (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ))
    (hκ ϖ) (IsLocalization.Away.algebraMap_isUnit _) hdiv hH2 hH3 hac s1 𝔪 h𝔪 y hQ

theorem wcpa_dj_lr1s_ncgr_mpc_residue_character : ∀ (R0 : Type u) [CommRing R0] (ϖ : R0) (C : Type u) [CommRing C] [Algebra R0 C], ∀ [IsDomain (AdicCompletion (Ideal.span {ϖ}) R0)], (∀ b : AdicCompletion (Ideal.span {ϖ}) R0, b ≠ 0 → ∃ n : ℕ, b ∣ algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) ϖ ^ n) → ∀ κ : AdicCompletion (Ideal.span {ϖ}) R0 →+* AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C, (∀ w : R0, κ (algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) w) = algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C w)) → ∀ 𝔪 : Ideal (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ))), 𝔪.IsMaximal → (∀ y : AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C, ∃ a : AdicCompletion (Ideal.span {ϖ}) R0, algebraMap (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ))) (y - κ a) ∈ 𝔪) → ∃ χ : Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ)) →+* FractionRing (AdicCompletion (Ideal.span {ϖ}) R0), (∀ x, χ x = 0 ↔ x ∈ 𝔪) ∧ ∀ b : AdicCompletion (Ideal.span {ϖ}) R0, χ (algebraMap (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ))) (κ b)) = algebraMap (AdicCompletion (Ideal.span {ϖ}) R0) (FractionRing (AdicCompletion (Ideal.span {ϖ}) R0)) b :=
by
  have gen : ∀ (Wt Ch : Type u) [CommRing Wt] [IsDomain Wt] [CommRing Ch] (ϖh : Wt) (pc : Ch)
      (κ : Wt →+* Ch), κ ϖh = pc → (∀ b : Wt, b ≠ 0 → ∃ n : ℕ, b ∣ ϖh ^ n) →
      ∀ 𝔪 : Ideal (Localization.Away pc), 𝔪.IsMaximal →
      (∀ y : Ch, ∃ a : Wt, algebraMap Ch (Localization.Away pc) (y - κ a) ∈ 𝔪) →
      ∃ χ : Localization.Away pc →+* FractionRing Wt, (∀ x, χ x = 0 ↔ x ∈ 𝔪) ∧
        ∀ b : Wt, χ (algebraMap Ch (Localization.Away pc) (κ b)) =
          algebraMap Wt (FractionRing Wt) b := by
    intro Wt Ch _ _ _ ϖh pc κ hκϖ hbdiv 𝔪 h𝔪 hpt
    haveI := h𝔪
    letI : Field (Localization.Away pc ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have hpu : IsUnit (Ideal.Quotient.mk 𝔪 (algebraMap Ch (Localization.Away pc) pc)) :=
      (IsLocalization.Away.algebraMap_isUnit pc).map _
    let g : Wt →+* (Localization.Away pc ⧸ 𝔪) :=
      ((Ideal.Quotient.mk 𝔪).comp (algebraMap Ch (Localization.Away pc))).comp κ
    have hgapp : ∀ b, g b = Ideal.Quotient.mk 𝔪 (algebraMap Ch (Localization.Away pc) (κ b)) :=
      fun b => rfl
    have hgϖ : g ϖh = Ideal.Quotient.mk 𝔪 (algebraMap Ch (Localization.Away pc) pc) := by
      rw [hgapp, hκϖ]
    have hg : ∀ y : nonZeroDivisors Wt, IsUnit (g y) := by
      intro y
      obtain ⟨n, hn⟩ := hbdiv y (nonZeroDivisors.coe_ne_zero y)
      have h1 := map_dvd g hn
      rw [map_pow, hgϖ] at h1
      exact isUnit_of_dvd_unit h1 (hpu.pow n)
    let lam : FractionRing Wt →+* (Localization.Away pc ⧸ 𝔪) := IsLocalization.lift hg
    have hlam : ∀ b, lam (algebraMap Wt (FractionRing Wt) b) = g b :=
      fun b => IsLocalization.lift_eq hg b
    have hinj : Function.Injective lam := lam.injective
    have hsurj : Function.Surjective lam := by
      intro z
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨n, y, hxy⟩ := IsLocalization.Away.surj pc x
      obtain ⟨a, ha⟩ := hpt y
      have h1 : Ideal.Quotient.mk 𝔪 (algebraMap Ch (Localization.Away pc) y) = g a := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sub, sub_eq_zero] at ha
        rw [hgapp]
        exact ha
      have h2 : Ideal.Quotient.mk 𝔪 x * (g ϖh) ^ n = g a := by
        rw [hgϖ, ← map_pow, ← map_mul, hxy, h1]
      have hk : algebraMap Wt (FractionRing Wt) ϖh ≠ 0 := by
        intro hk0
        have h3 : g ϖh = 0 := by rw [← hlam, hk0, map_zero]
        rw [hgϖ] at h3
        exact hpu.ne_zero h3
      refine ⟨algebraMap Wt (FractionRing Wt) a * ((algebraMap Wt (FractionRing Wt) ϖh) ^ n)⁻¹, ?_⟩
      have hu : IsUnit (g ϖh ^ n) := by rw [hgϖ]; exact hpu.pow n
      apply hu.mul_left_injective
      show lam _ * g ϖh ^ n = Ideal.Quotient.mk 𝔪 x * g ϖh ^ n
      have e1 : g ϖh ^ n = lam ((algebraMap Wt (FractionRing Wt) ϖh) ^ n) := by
        rw [map_pow, hlam]
      rw [h2, e1, ← map_mul lam, mul_assoc, inv_mul_cancel₀ (pow_ne_zero n hk), mul_one, hlam]
    let e : FractionRing Wt ≃+* (Localization.Away pc ⧸ 𝔪) :=
      RingEquiv.ofBijective lam ⟨hinj, hsurj⟩
    refine ⟨(e.symm : (Localization.Away pc ⧸ 𝔪) →+* FractionRing Wt).comp (Ideal.Quotient.mk 𝔪),
      ?_, ?_⟩
    · intro x
      show e.symm (Ideal.Quotient.mk 𝔪 x) = 0 ↔ x ∈ 𝔪
      rw [map_eq_zero_iff _ e.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    · intro b
      show e.symm (Ideal.Quotient.mk 𝔪 (algebraMap Ch (Localization.Away pc) (κ b))) = _
      have h4 : Ideal.Quotient.mk 𝔪 (algebraMap Ch (Localization.Away pc) (κ b)) =
          e (algebraMap Wt (FractionRing Wt) b) := by
        change _ = lam (algebraMap Wt (FractionRing Wt) b)
        rw [hlam, hgapp]
      rw [h4, e.symm_apply_apply]
  intro R0 _ ϖ C _ _ _ hbdiv κ hκ 𝔪 h𝔪 hpt
  exact gen _ _ _ _ κ (hκ ϖ) hbdiv 𝔪 h𝔪 hpt

theorem wcpa_dj_lr1s_ncgr_mpc_hom_ext : ∀ (R0 : Type u) [CommRing R0] (ϖ : R0) (C : Type u) [CommRing C] [Algebra R0 C], (∀ x : C, algebraMap R0 C ϖ * x = 0 → x = 0) → ∀ (κ : AdicCompletion (Ideal.span {ϖ}) R0 →+* AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C), (∀ w : R0, κ (algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) w) = algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C w)) → ∀ (N : ℕ) (g : Fin N → C), Algebra.adjoin R0 (Set.range g) = ⊤ → ∀ (a : Fin N → AdicCompletion (Ideal.span {ϖ}) R0) (n : ℕ) (V : Type u) [CommRing V] (f f' : AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C →+* V), (∀ c : C, f (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) c) = f' (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) c)) → (∀ b : AdicCompletion (Ideal.span {ϖ}) R0, f (κ b) = f' (κ b)) → (∀ i, f (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (g i) - κ (a i)) ^ n = 0) → f = f' :=
by
  intro R0 _ ϖ C _ _ hC κ0 hκ0 N g hg a0 n V _ f0 f0' hfC0 hfκ0 hnil0
  have gen : ∀ (W' Ch : Type u) [CommRing W'] [CommRing Ch] (κ : W' →+* Ch) (of : C →+* Ch)
      (ιW : R0 →+* W') (u : W') (p : Ch),
      (∀ w, κ (ιW w) = of (algebraMap R0 C w)) → κ u = p →
      (∀ z : Ch, ∃ (c : C) (y' : Ch), z = of c + p * y') →
      (∀ F : ℕ → W', (∀ k : ℕ, ∃ y : W', F (k + 1) - F k = u ^ k * y) →
        ∃ L : W', ∀ k : ℕ, ∃ y : W', L - F k = u ^ k * y) →
      (∀ F : ℕ → Ch, (∀ k : ℕ, ∃ y : Ch, F (k + 1) - F k = p ^ k * y) →
        ∃ L : Ch, ∀ k : ℕ, ∃ y : Ch, L - F k = p ^ k * y) →
      (∀ z : Ch, (∀ k : ℕ, ∃ y : Ch, z = p ^ k * y) → z = 0) →
      ∀ (a : Fin N → W') (f f' : Ch →+* V), (∀ c, f (of c) = f' (of c)) →
        (∀ b, f (κ b) = f' (κ b)) → (∀ i, f (of (g i) - κ (a i)) ^ n = 0) → f = f' := by
    intro W' Ch _ _ κ of ιW u p hκ' hu hdig hserW hserC hsep a f f' hfC hfκ hnil
    obtain ⟨x, hx⟩ : ∃ x : Fin N → Ch, ∀ i, x i = of (g i) - κ (a i) := ⟨_, fun _ => rfl⟩
    obtain ⟨m, hm⟩ : ∃ m : (Fin N → Fin n) → Ch, ∀ β, m β = ∏ i, x i ^ (β i : ℕ) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨R, hR⟩ : ∃ R : Ch → Prop, ∀ z, R z ↔ ∃ (e : (Fin N → Fin n) → W') (t : Fin N → Ch),
        z = ∑ β, κ (e β) * m β + ∑ i, x i ^ n * t i := ⟨_, fun _ => Iff.rfl⟩

    have P0 : R 0 := (hR 0).mpr ⟨0, 0, by simp⟩
    have Padd : ∀ z z', R z → R z' → R (z + z') := by
      intro z z' hz hz'
      obtain ⟨e, t, rfl⟩ := (hR z).mp hz
      obtain ⟨e', t', rfl⟩ := (hR z').mp hz'
      refine (hR _).mpr ⟨e + e', t + t', ?_⟩
      simp only [Pi.add_apply, map_add, add_mul, mul_add, Finset.sum_add_distrib]
      ring
    have Fsum : ∀ {ι : Type} (s : Finset ι) (F : ι → Ch), (∀ i ∈ s, R (F i)) →
        R (∑ i ∈ s, F i) :=
      fun s F h => Finset.sum_induction F R Padd P0 h
    have Psmul : ∀ b z, R z → R (κ b * z) := by
      intro b z hz
      obtain ⟨e, t, rfl⟩ := (hR z).mp hz
      refine (hR _).mpr ⟨fun β => b * e β, fun i => κ b * t i, ?_⟩
      rw [mul_add, Finset.mul_sum, Finset.mul_sum]
      congr 1
      · exact Finset.sum_congr rfl (fun _ _ => by rw [map_mul]; ring)
      · exact Finset.sum_congr rfl (fun _ _ => by ring)
    have Pideal : ∀ j w, R (x j ^ n * w) := by
      intro j w
      refine (hR _).mpr ⟨0, Pi.single j w, ?_⟩
      have h1 : ∑ i, x i ^ n * (Pi.single j w : Fin N → Ch) i = x j ^ n * w := by
        rw [Finset.sum_eq_single j]
        · rw [Pi.single_eq_same]
        · intro i _ h; rw [Pi.single_eq_of_ne h, mul_zero]
        · intro h; exact absurd (Finset.mem_univ j) h
      rw [h1]; simp
    have Pmon : ∀ β, R (m β) := by
      intro β
      refine (hR _).mpr ⟨Pi.single β 1, 0, ?_⟩
      have h1 : ∑ β', κ ((Pi.single β (1 : W') : (Fin N → Fin n) → W') β') * m β' = m β := by
        rw [Finset.sum_eq_single β]
        · rw [Pi.single_eq_same, map_one, one_mul]
        · intro β' _ h; rw [Pi.single_eq_of_ne h, map_zero, zero_mul]
        · intro h; exact absurd (Finset.mem_univ β) h
      rw [h1]; simp
    have Px : ∀ j (β : Fin N → Fin n), R (x j * m β) := by
      intro j β
      have hsplit : ∀ γ : Fin N → Fin n,
          m γ = x j ^ (γ j : ℕ) * ∏ i ∈ Finset.univ.erase j, x i ^ (γ i : ℕ) := by
        intro γ
        rw [hm]
        exact (Finset.mul_prod_erase _ (fun i => x i ^ (γ i : ℕ)) (Finset.mem_univ j)).symm
      by_cases hb : (β j : ℕ) + 1 < n
      · have hP := Pmon (Function.update β j ⟨(β j : ℕ) + 1, hb⟩)
        convert hP using 1
        rw [hsplit β, hsplit (Function.update β j ⟨(β j : ℕ) + 1, hb⟩), Function.update_self]
        have hpr : ∏ i ∈ Finset.univ.erase j,
            x i ^ ((Function.update β j ⟨(β j : ℕ) + 1, hb⟩ i : Fin n) : ℕ) =
            ∏ i ∈ Finset.univ.erase j, x i ^ (β i : ℕ) := by
          apply Finset.prod_congr rfl
          intro i hi
          rw [Function.update_of_ne (Finset.ne_of_mem_erase hi)]
        rw [hpr]
        show x j * (x j ^ (β j : ℕ) * _) = x j ^ ((β j : ℕ) + 1) * _
