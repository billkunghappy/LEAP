      refine ⟨ι c + ι r * y', ?_⟩
      rw [hv, hc, map_mul, map_pow, pow_succ]
      ring

  have s4 : ∀ (R A : Type u) [CommRing R] [CommRing A] (ι : R →+* A) (r : R),
      (∀ a b : R, a * b = 0 → a = 0 ∨ b = 0) → (∀ x y : R, x ∣ y ∨ y ∣ x) → r ≠ 0 →
      ¬ IsUnit r → (∀ v : R, v ≠ 0 → ∃ N : ℕ, v ∣ r ^ N) →
      (∀ (n : ℕ) (c : R) (y : A), ι c = ι r ^ n * y → ∃ c' : R, c = r ^ n * c') →
      (∀ x : A, ∃ (v : R) (u : A), IsUnit u ∧ x = ι v * u) →
      IsDomain A ∧ (∀ x y : A, x ∣ y ∨ y ∣ x) ∧ ¬ IsUnit (ι r) ∧
        ∀ x : A, x ≠ 0 → ∃ N : ℕ, x ∣ ι r ^ N := by
    intro R A _ _ ι r hzd htot hr0 hrnu hrk hb2 hnf
    have hpow : ∀ N : ℕ, r ^ N ≠ 0 := by
      intro N
      induction N with
      | zero =>
        intro h
        apply hr0
        rw [pow_zero] at h
        rw [← mul_one r, h, mul_zero]
      | succ N ih =>
        intro h
        rw [pow_succ] at h
        rcases hzd _ _ h with h | h
        · exact ih h
        · exact hr0 h
    have hsepR : ∀ v : R, (∀ m : ℕ, ∃ c : R, v = r ^ m * c) → v = 0 := by
      intro v hv
      by_contra hv0
      obtain ⟨N, w, hw⟩ := hrk v hv0
      obtain ⟨c, hc⟩ := hv (N + 1)
      have h1 : r ^ N * (1 - r * (c * w)) = 0 := by
        rw [hc] at hw
        linear_combination hw
      rcases hzd _ _ h1 with h | h
      · exact hpow N h
      · exact hrnu (isUnit_iff_exists_inv.mpr ⟨c * w, by linear_combination -h⟩)
    have hinj0 : ∀ v : R, ι v = 0 → v = 0 := by
      intro v hv
      apply hsepR
      intro m
      exact hb2 m v 0 (by rw [hv, mul_zero])
    have htnu : ¬ IsUnit (ι r) := by
      intro hu
      obtain ⟨a, ha⟩ := isUnit_iff_exists_inv.mp hu
      obtain ⟨c', hc'⟩ := hb2 1 1 a (by rw [map_one, pow_one, ha])
      exact hrnu (isUnit_iff_exists_inv.mpr ⟨c', by rw [pow_one] at hc'; exact hc'.symm⟩)
    haveI hnt : Nontrivial A := by
      refine nontrivial_of_ne 1 0 (fun h => hr0 ?_)
      have h1 : (1 : R) = 0 := hinj0 1 (by rw [map_one, h])
      rw [← mul_one r, h1, mul_zero]
    haveI hnzd : NoZeroDivisors A := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨v, u, hu, rfl⟩ := hnf x
      obtain ⟨w, u', hu', rfl⟩ := hnf y
      have h1 : ι (v * w) * (u * u') = 0 := by
        rw [map_mul]
        linear_combination hxy
      have h2 : ι (v * w) = 0 := (hu.mul hu').mul_left_eq_zero.mp h1
      rcases hzd v w (hinj0 _ h2) with h | h
      · left
        rw [h, map_zero, zero_mul]
      · right
        rw [h, map_zero, zero_mul]
    refine ⟨NoZeroDivisors.to_isDomain A, ?_, htnu, ?_⟩
    · intro x y
      obtain ⟨v, u, hu, rfl⟩ := hnf x
      obtain ⟨w, u', hu', rfl⟩ := hnf y
      obtain ⟨ui, hui⟩ := isUnit_iff_exists_inv.mp hu
      obtain ⟨ui', hui'⟩ := isUnit_iff_exists_inv.mp hu'
      rcases htot v w with ⟨a, ha⟩ | ⟨a, ha⟩
      · left
        refine ⟨ui * ι a * u', ?_⟩
        rw [ha, map_mul]
        linear_combination (-(ι v * ι a * u')) * hui
      · right
        refine ⟨ui' * ι a * u, ?_⟩
        rw [ha, map_mul]
        linear_combination (-(ι w * ι a * u)) * hui'
    · intro x hx
      obtain ⟨v, u, hu, rfl⟩ := hnf x
      have hv : v ≠ 0 := by
        rintro rfl
        apply hx
        rw [map_zero, zero_mul]
      obtain ⟨N, w, hw⟩ := hrk v hv
      obtain ⟨ui, hui⟩ := isUnit_iff_exists_inv.mp hu
      refine ⟨N, ui * ι w, ?_⟩
      rw [← map_pow, hw, map_mul]
      linear_combination (-(ι v * ι w)) * hui

  have s1 : ∀ (T : Type u) [CommRing T] [IsDomain T] (P : Ideal T) [P.IsPrime] (t : T),
      t ≠ 0 → t ∈ P →
      (∀ f : T, f ≠ 0 → ∃ (a e f₀ : T) (N : ℕ), f₀ ∉ P ∧ f = a * f₀ ∧ t ^ N = a * e) →
      (∀ x y : T, ∃ u z : T, u ∉ P ∧ (u * x = z * y ∨ u * y = z * x)) →
