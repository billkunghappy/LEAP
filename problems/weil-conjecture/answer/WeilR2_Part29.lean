  obtain ⟨Φ, hΦX0, hΦX1, hΦC⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥W ⧸ I →+* Γ(M', U 0),
      Φ (Ideal.Quotient.mk I (MvPolynomial.X 0)) = (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) ∧
      Φ (Ideal.Quotient.mk I (MvPolynomial.X 1)) = t 0 1 ∧
      ∀ w : ↥W, Φ (Ideal.Quotient.mk I (MvPolynomial.C w)) = (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C w)) := by
    let ψ : ↥W →+* Γ(M', U 0) := (r₀.appLE ⊤ (U 0) (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C)
    let Φt : MvPolynomial (Fin 2) ↥W →+* Γ(M', U 0) := MvPolynomial.eval₂Hom ψ
      ![(r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)), t 0 1]
    have hΦt : ∀ p ∈ I, Φt p = 0 := by
      intro p hp
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      have hF : Φt (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c) = 0 := by
