  intro Ω _ _ W hW ϖ hϖ0 hϖnu d M _ _ hM htM
  classical
  haveI := hM

  obtain ⟨r, f, hf⟩ := Module.Finite.exists_fin' (AdicCompletion (Ideal.span
    {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) M
  have hsat : ∀ x : Fin r → AdicCompletion (Ideal.span
      {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W),
      algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span
        {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W))
        (MvPolynomial.C ϖ) • x ∈ LinearMap.ker f → x ∈ LinearMap.ker f := by
