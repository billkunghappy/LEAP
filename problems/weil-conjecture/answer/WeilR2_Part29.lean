    intro q a e h
    exact MvPolynomial.homogeneousComponent_of_mem ((MvPolynomial.mem_homogeneousSubmodule a q).mpr h)
  have hdec : ∀ v : Fin n → MvPolynomial (Fin (d + 1)) V, ∃ D : ℕ, ∀ i,
