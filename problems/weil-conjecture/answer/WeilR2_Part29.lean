      obtain ⟨Ψ₀, hΨ₀, hΨ₀s⟩ := hmap (↥W) (MvPolynomial (Fin 0) ↥W) MvPolynomial.C ϖ
        (MvPolynomial.C ϖ) rfl
      have hsurj0 : Function.Surjective (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 0) ↥W) :=
        fun P => ⟨P.coeff 0, (MvPolynomial.eq_C_of_isEmpty P).symm⟩
      have hΨj : Ψ₀ = j := huniq (↥W) ϖ hϖW (wcNcgrTo W ϖ 0) _ (hSep 0) Ψ₀ j (hΨ₀ ϖ)
        (fun a => (hΨ₀ a).trans (hj a).symm)
      have hjs : Function.Surjective j := hΨj ▸ hΨ₀s hsurj0
      have hμs := hlocsurj (AdicCompletion (Ideal.span {ϖ}) ↥W) (wcNcgrTo W ϖ 0)
        (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ) _ j (hj ϖ) hjs μ hμ
      exact RingHom.isIntegral_of_surjective _ (Ideal.Quotient.mk_surjective.comp hμs)
    | succ n ih =>
      intro 𝔐 h𝔐 j hj μ hμ

      have hev01 : ∀ c : ↥W, ∃ E : wcNcgrTo W ϖ (n + 1) →+* AdicCompletion (Ideal.span {ϖ}) ↥W,
          E (algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (MvPolynomial.C ϖ)) =
            algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ ∧
          E (algebraMap (MvPolynomial (Fin (n + 1)) ↥W) (wcNcgrTo W ϖ (n + 1)) (MvPolynomial.X 0)) =
            algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) c := by
        intro c
        obtain ⟨E, hE, -⟩ := hmap (MvPolynomial (Fin (n + 1)) ↥W) (↥W)
          (MvPolynomial.eval (fun _ => c)) (MvPolynomial.C ϖ) ϖ (MvPolynomial.eval_C _)
        exact ⟨E, by rw [hE, MvPolynomial.eval_C], by rw [hE, MvPolynomial.eval_X]⟩
      obtain ⟨E₀, hE₀p, hE₀x⟩ := hev01 0
      obtain ⟨E₁, hE₁p, hE₁x⟩ := hev01 1
      rw [map_zero] at hE₀x
      rw [map_one] at hE₁x
      have hne : 𝔐 ≠ ⊥ := hnebot (wcNcgrTo W ϖ (n + 1)) _ (AdicCompletion (Ideal.span {ϖ}) ↥W)
        (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ) hB1 _ E₀ E₁ hE₀p hE₁p hE₀x hE₁x
        𝔐 h𝔐

      obtain ⟨f, hf𝔐, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      obtain ⟨ι', g, v, s, yv, hι'C, hg, hdiv⟩ := hstep n f hf0
      have hu' : IsUnit ((algebraMap (wcNcgrTo W ϖ (n + 1)) (wcNcgrTn W ϖ (n + 1))).comp ι'
          (algebraMap (MvPolynomial (Fin n) ↥W) (wcNcgrTo W ϖ n) (MvPolynomial.C ϖ))) := by
        rw [RingHom.comp_apply, hι'C ϖ]
        exact IsLocalization.Away.algebraMap_isUnit _

      obtain ⟨μ', hμ'⟩ : ∃ μ' : wcNcgrTn W ϖ n →+* wcNcgrTn W ϖ (n + 1),
          ∀ t, μ' (algebraMap (wcNcgrTo W ϖ n) (wcNcgrTn W ϖ n) t) =
            algebraMap (wcNcgrTo W ϖ (n + 1)) (wcNcgrTn W ϖ (n + 1)) (ι' t) :=
        ⟨IsLocalization.Away.lift _ hu', fun t => IsLocalization.Away.lift_eq _ hu' t⟩
      have hg𝔐 : algebraMap (wcNcgrTo W ϖ (n + 1)) (wcNcgrTn W ϖ (n + 1)) g ∈ 𝔐 := by
        rw [hg]; exact 𝔐.mul_mem_left v hf𝔐

      obtain ⟨hker, hφint⟩ := hfinint (wcNcgrTo W ϖ n) (wcNcgrTo W ϖ (n + 1)) ι' _ _ (hι'C ϖ) 𝔐 h𝔐
        g hg𝔐 s yv hdiv μ' hμ'

      obtain ⟨jn, μn, hjn, hμn⟩ := hjμ n
      have hjeq : j = ι'.comp jn := huniq (↥W) ϖ hϖW (wcNcgrTo W ϖ (n + 1)) _ (hSep (n + 1)) j
        (ι'.comp jn) (hj ϖ) (fun a => by rw [hj a, RingHom.comp_apply, hjn a, hι'C a])
      have hμeq : μ = μ'.comp μn := by
        apply IsLocalization.ringHom_ext
          (Submonoid.powers (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ))
        refine RingHom.ext (fun t => ?_)
        simp only [RingHom.comp_apply]
        rw [hμ, hμn, hμ', hjeq, RingHom.comp_apply]

      have hIH := ih (RingHom.ker ((Ideal.Quotient.mk 𝔐).comp μ')) hker jn hjn μn hμn
      have h1 := hitr _ (wcNcgrTn W ϖ n) (wcNcgrTn W ϖ (n + 1) ⧸ 𝔐) μn
        ((Ideal.Quotient.mk 𝔐).comp μ') hφint hIH
      rw [hμeq, ← RingHom.comp_assoc]
      exact h1



  obtain ⟨d, fpres, hfpres⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hC
  have hfC : ∀ a : ↥W, (fpres : MvPolynomial (Fin d) ↥W →+* C) (MvPolynomial.C a) =
      algebraMap (↥W) C a := by
    intro a
    show fpres (MvPolynomial.C a) = _
    rw [← MvPolynomial.algebraMap_eq]
    exact fpres.commutes a
  obtain ⟨Ψ, hΨ, hΨs⟩ := hmap _ _ (fpres : MvPolynomial (Fin d) ↥W →+* C) _ _ (hfC ϖ)
  have hΨsurj := hΨs (fun c => hfpres c)
  have hΨp : Ψ (algebraMap (MvPolynomial (Fin d) ↥W) (wcNcgrTo W ϖ d) (MvPolynomial.C ϖ)) =
      algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ) := by
    rw [hΨ, hfC]
  have hu : IsUnit ((algebraMap (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C)
      (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C)
        (algebraMap (↥W) C ϖ)))).comp Ψ
      (algebraMap (MvPolynomial (Fin d) ↥W) (wcNcgrTo W ϖ d) (MvPolynomial.C ϖ))) := by
    rw [RingHom.comp_apply, hΨp]
    exact IsLocalization.Away.algebraMap_isUnit _
  obtain ⟨Ψ', hΨ'⟩ : ∃ Ψ' : wcNcgrTn W ϖ d →+* Localization.Away (algebraMap C
      (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ)),
      ∀ z, Ψ' (algebraMap (wcNcgrTo W ϖ d) (wcNcgrTn W ϖ d) z) =
        algebraMap (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C)
          (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C)
            (algebraMap (↥W) C ϖ))) (Ψ z) :=
    ⟨IsLocalization.Away.lift _ hu, fun z => IsLocalization.Away.lift_eq _ hu z⟩
  have hΨ's : Function.Surjective Ψ' := hlocsurj _ _ _ _ Ψ hΨp hΨsurj Ψ' hΨ'
  haveI := h𝔪
  haveI h𝔐 : (Ideal.comap Ψ' 𝔪).IsMaximal := Ideal.comap_isMaximal_of_surjective Ψ' hΨ's
  obtain ⟨jd, μd, hjd, hμd⟩ := hjμ d
  have hSepC := (wcpa_dj_lr1s_nf_cnf_adic_series C (algebraMap (↥W) C ϖ)).2
  have hκΨ : κ = Ψ.comp jd := huniq (↥W) ϖ hϖW _ _ hSepC κ (Ψ.comp jd) (hκ ϖ)
    (fun a => by rw [hκ a, RingHom.comp_apply, hjd a, hΨ, hfC])



  obtain ⟨x, rfl⟩ := hΨsurj y
  letI : Field (wcNcgrTn W ϖ d ⧸ Ideal.comap Ψ' 𝔪) := Ideal.Quotient.field _
  have hint := hTI d (Ideal.comap Ψ' 𝔪) h𝔐 jd hjd μd hμd
  obtain ⟨Q, hQ0, hQ⟩ := hclear (AdicCompletion (Ideal.span {ϖ}) ↥W)
    (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ) _
    ((Ideal.Quotient.mk (Ideal.comap Ψ' 𝔪)).comp μd)
    (Ideal.Quotient.mk (Ideal.comap Ψ' 𝔪) (algebraMap (wcNcgrTo W ϖ d) (wcNcgrTn W ϖ d) x)) (hint _)
  refine ⟨Q, hQ0, ?_⟩
  have hcomp : ((Ideal.Quotient.mk (Ideal.comap Ψ' 𝔪)).comp μd).comp
      (algebraMap (AdicCompletion (Ideal.span {ϖ}) ↥W)
        (Localization.Away (algebraMap (↥W) (AdicCompletion (Ideal.span {ϖ}) ↥W) ϖ))) =
      (Ideal.Quotient.mk (Ideal.comap Ψ' 𝔪)).comp
        ((algebraMap (wcNcgrTo W ϖ d) (wcNcgrTn W ϖ d)).comp jd) := by
    refine RingHom.ext (fun t => ?_)
    simp only [RingHom.comp_apply, hμd]
  rw [hcomp, ← Polynomial.hom_eval₂, ← Polynomial.hom_eval₂, Ideal.Quotient.eq_zero_iff_mem,
    Ideal.mem_comap, hΨ', Polynomial.hom_eval₂] at hQ
  rw [hκΨ]
  exact hQ

theorem wcpa_dj_lr1s_ncgr_mpc_integral_point : ∀ (R0 : Type u) [CommRing R0] (ϖ : R0) (C : Type u) [CommRing C] [Algebra R0 C], ∀ [IsDomain (AdicCompletion (Ideal.span {ϖ}) R0)], (∀ x y : AdicCompletion (Ideal.span {ϖ}) R0, x ∣ y ∨ y ∣ x) → (∀ b : AdicCompletion (Ideal.span {ϖ}) R0, b ≠ 0 → ∃ n : ℕ, b ∣ algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) ϖ ^ n) → (∀ c : AdicCompletion (Ideal.span {ϖ}) R0, ¬ IsUnit c → ∃ k : ℕ, algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) ϖ ∣ c ^ k) → IsAlgClosed (FractionRing (AdicCompletion (Ideal.span {ϖ}) R0)) → ∀ κ : AdicCompletion (Ideal.span {ϖ}) R0 →+* AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C, (∀ w : R0, κ (algebraMap R0 (AdicCompletion (Ideal.span {ϖ}) R0) w) = algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C w)) → ∀ 𝔪 : Ideal (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ))), 𝔪.IsMaximal → ∀ y : AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C, (∃ Q : Polynomial (AdicCompletion (Ideal.span {ϖ}) R0), Q ≠ 0 ∧ algebraMap (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ))) (Q.eval₂ κ y) ∈ 𝔪) → ∃ a : AdicCompletion (Ideal.span {ϖ}) R0, algebraMap (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (algebraMap R0 C ϖ))) (y - κ a) ∈ 𝔪 :=
by
  intro R0 _ ϖ C _ _ _ hdiv hH2 hH3 hac κ hκ 𝔪 h𝔪 y hQ
  classical

  have wcpa_dj_lr1s_nf_cnf_adic_series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
    intro R _ r
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have t1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
          Submodule.mem_top
    refine ⟨fun f hf => ?_, fun x hx => ?_⟩
    · choose y hy using hf
      have t4 : ∀ m n : ℕ, m ≤ n →
          f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        intro m n hmn
        induction n, hmn using Nat.le_induction with
        | base => rw [sub_self]; exact Submodule.zero_mem _
        | succ n hmn ih =>
          rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
          refine Submodule.add_mem _ ?_ ih
          have h1 : f (n + 1) - f n ∈
              (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
            (t1 n _).mpr ⟨y n, hy n⟩
          exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
      obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, ← neg_sub]
        exact Submodule.neg_mem _ (t4 m n hmn))
      refine ⟨L, fun n => (t1 n _).mp ?_⟩
      have h := SModEq.sub_mem.mp (hL n)
      rw [← neg_sub]
      exact Submodule.neg_mem _ h
    · refine hc.toIsHausdorff.haus x (fun k => ?_)
      rw [SModEq.sub_mem, sub_zero]
      exact (t1 k x).mpr (hx k)

  have s1 : ∀ (z s : AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C) (k : ℕ),
      z ^ k = algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
        (algebraMap R0 C ϖ) * s → IsUnit (1 - z) := by
    intro z s k hz
    obtain ⟨hser, hsep⟩ := wcpa_dj_lr1s_nf_cnf_adic_series C (algebraMap R0 C ϖ)
    obtain ⟨L, hL⟩ := hser (fun n => ∑ i ∈ Finset.range n,
        (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
          (algebraMap R0 C ϖ) * s) ^ i) (fun n => ⟨s ^ n, by
      simp only [Finset.sum_range_succ, add_sub_cancel_left, mul_pow]⟩)
    have h1 : (1 - algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
        (algebraMap R0 C ϖ) * s) * L = 1 := by
      have h0 := hsep ((1 - algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
          (algebraMap R0 C ϖ) * s) * L - 1) (fun n => by
        obtain ⟨yn, hyn⟩ := hL n
        have hyn' : L - ∑ i ∈ Finset.range n,
            (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
              (algebraMap R0 C ϖ) * s) ^ i =
            algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
              (algebraMap R0 C ϖ) ^ n * yn := hyn
        have hg := mul_neg_geom_sum (algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
            (algebraMap R0 C ϖ) * s) n
        refine ⟨(1 - algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
            (algebraMap R0 C ϖ) * s) * yn - s ^ n, ?_⟩
        linear_combination (1 - algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
            (algebraMap R0 C ϖ) * s) * hyn' + hg)
      exact sub_eq_zero.mp h0
    have hu : IsUnit (1 - algebraMap C (AdicCompletion (Ideal.span {algebraMap R0 C ϖ}) C)
        (algebraMap R0 C ϖ) * s) := isUnit_iff_exists_inv.mpr ⟨L, h1⟩
    have hg := mul_neg_geom_sum z k
    rw [hz] at hg
    have hu' : IsUnit ((1 - z) * ∑ i ∈ Finset.range k, z ^ i) := by rw [hg]; exact hu
    exact isUnit_of_mul_isUnit_left hu'

  have s2 : ∀ (D : Type u) [CommRing D] [IsDomain D], IsAlgClosed (FractionRing D) →
      ∀ (L : Type u) [Field L] (g : D →+* L), Function.Injective g →
      ∀ Q : Polynomial D, Q ≠ 0 → ∀ x : L, Q.eval₂ g x = 0 →
      ∃ u v : D, v ≠ 0 ∧ g v * x = g u := by
    intro D _ _ hK L _ g hg Q hQ0 x hx
    have hlam : ∀ d, (IsFractionRing.lift hg : FractionRing D →+* L)
        (algebraMap D (FractionRing D) d) = g d := fun d => IsFractionRing.lift_algebraMap hg d
    letI : Algebra (FractionRing D) L := (IsFractionRing.lift hg : FractionRing D →+* L).toAlgebra
    have hQK : Q.map (algebraMap D (FractionRing D)) ≠ 0 :=
      (Polynomial.map_ne_zero_iff (IsFractionRing.injective D (FractionRing D))).mpr hQ0
    have hcomp : (IsFractionRing.lift hg : FractionRing D →+* L).comp
        (algebraMap D (FractionRing D)) = g := RingHom.ext hlam
    have hroot : Polynomial.aeval x (Q.map (algebraMap D (FractionRing D))) = 0 := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, RingHom.algebraMap_toAlgebra, hcomp]
      exact hx
    have halg : IsAlgebraic (FractionRing D) x := ⟨_, hQK, hroot⟩
    have hint : IsIntegral (FractionRing D) x := halg.isIntegral
    have hdeg : (minpoly (FractionRing D) x).degree = 1 :=
      IsAlgClosed.degree_eq_one_of_irreducible _ (minpoly.irreducible hint)
    obtain ⟨ρ, hρ⟩ := minpoly.mem_range_of_degree_eq_one (FractionRing D) x hdeg
    obtain ⟨u, v, hv, hρuv⟩ := IsFractionRing.div_surjective (A := D) ρ
    have hvK : algebraMap D (FractionRing D) v ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hv
    have hmul : algebraMap D (FractionRing D) v * ρ = algebraMap D (FractionRing D) u := by
      rw [← hρuv]; field_simp
    refine ⟨u, v, nonZeroDivisors.ne_zero hv, ?_⟩
    rw [← hρ, ← hlam, ← hlam, RingHom.algebraMap_toAlgebra, ← map_mul, hmul]

  have key : ∀ (Wh Ch A : Type u) [CommRing Wh] [IsDomain Wh] [CommRing Ch] [CommRing A]
      (j : Ch →+* A) (κ : Wh →+* Ch) (w0 : Wh) (p0 : Ch), κ w0 = p0 → IsUnit (j p0) →
      (∀ x y : Wh, x ∣ y ∨ y ∣ x) → (∀ b : Wh, b ≠ 0 → ∃ n : ℕ, b ∣ w0 ^ n) →
      (∀ c : Wh, ¬ IsUnit c → ∃ k : ℕ, w0 ∣ c ^ k) → IsAlgClosed (FractionRing Wh) →
      (∀ (z s : Ch) (k : ℕ), z ^ k = p0 * s → IsUnit (1 - z)) →
      ∀ 𝔪 : Ideal A, 𝔪.IsMaximal → ∀ y : Ch,
      (∃ Q : Polynomial Wh, Q ≠ 0 ∧ j (Q.eval₂ κ y) ∈ 𝔪) → ∃ a : Wh, j (y - κ a) ∈ 𝔪 := by
    intro Wh Ch A _ _ _ _ j κ w0 p0 hκp hpu H1 H2 H3 hK hs1 𝔪 h𝔪 y hQ
    obtain ⟨Q, hQ0, hQ⟩ := hQ
    letI : Field (A ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    obtain ⟨π, hπ⟩ : ∃ π : Ch →+* A ⧸ 𝔪, ∀ e, π e = Ideal.Quotient.mk 𝔪 (j e) :=
      ⟨(Ideal.Quotient.mk 𝔪).comp j, fun e => rfl⟩
    have hπ0 : ∀ e, π e = 0 ↔ j e ∈ 𝔪 := fun e => by
      rw [hπ, Ideal.Quotient.eq_zero_iff_mem]
    have hginj : Function.Injective (π.comp κ) := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      by_contra hb0
      obtain ⟨n, hn⟩ := H2 b hb0
      have h1 : (π.comp κ) b ∣ (π.comp κ) w0 ^ n := by rw [← map_pow]; exact map_dvd _ hn
      have h2 : IsUnit ((π.comp κ) w0 ^ n) := by
        have : (π.comp κ) w0 = Ideal.Quotient.mk 𝔪 (j p0) := by
          rw [RingHom.comp_apply, hκp, hπ]
        rw [this]; exact (hpu.map _).pow n
      exact (isUnit_of_dvd_unit h1 h2).ne_zero hb
    have hroot : Q.eval₂ (π.comp κ) (π y) = 0 := by
      rw [← Polynomial.hom_eval₂, hπ0]; exact hQ
    obtain ⟨u, v, hv0, huv⟩ := s2 Wh hK (A ⧸ 𝔪) (π.comp κ) hginj Q hQ0 (π y) hroot
    simp only [RingHom.comp_apply] at huv
    have hgv : π (κ v) ≠ 0 := fun h => hv0 (hginj (by rw [RingHom.comp_apply, h, map_zero]))
    by_cases hvu : v ∣ u
    · obtain ⟨a, rfl⟩ := hvu
