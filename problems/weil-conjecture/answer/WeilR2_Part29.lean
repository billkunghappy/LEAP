theorem wcpa_dj_lr1s_nf_cnf_bd_bounded_torsion : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) (M : Type u) [AddCommGroup M] [Module (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) M], Module.Finite (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) M → ∃ c : ℕ, ∀ m : M, (∃ k : ℕ, algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) ^ k • m = 0) → algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) ^ c • m = 0 :=
by
  intro Ω _ _ W hW ϖ hϖ0 hϖnu d
  classical

  have s2 : ∀ (R : Type u) [CommRing R] (t : R), (∀ I : Ideal R, ∃ c : ℕ, ∀ r : R,
