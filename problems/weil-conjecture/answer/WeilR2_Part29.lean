      have h3 := G3 l (eqv (Sum.inl (l, l))) L (b ⁻¹ᵁ D l) h le_rfl
      rw [hs1, map_one, mul_one, hid] at h3
      exact h3
    refine ⟨M, ψ, fun l => eqv (Sum.inl (l, l)), fun l => (hpre l).ge, G1, hpre, ?_, ?_⟩
    · intro l m
      exact ⟨eqv (Sum.inl (m, l)),
        (hco l (eqv (Sum.inl (m, l))) _).trans (by rw [ev1, hone, one_pow, mul_one])⟩
    · intro l j'
      exact ⟨eqv (Sum.inr (l, j')), (hco l (eqv (Sum.inr (l, j'))) _).trans (ev2 l l j')⟩
  have fpr_proj_proper : ∀ (n : ℕ), IsProper (wcFprS R n) := by
    intro n
    letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) R _
    letI : IsScalarTower R ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) 0)
        (MvPolynomial (Fin (n+1)) R) :=
      IsScalarTower.of_algebraMap_eq (R := R)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) 0)
        (A := MvPolynomial (Fin (n+1)) R) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) 0)
        (MvPolynomial (Fin (n+1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) R)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap R ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) 0 =>
          (x : MvPolynomial (Fin (n+1)) R)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (n+1)) R).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (n+1)) R).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (n+1)) R).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap R ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap R ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) R) 0))))
    infer_instance
  have fpr_closed_imm : ∀ {S Q X : Scheme.{u}} (sQ : Q ⟶ S) (fX : X ⟶ S) [IsProper fX] (ψ : X ⟶ Q) {ι : Type} (U : ι → X.Opens) (V : ι → Q.Opens) (hψ : ∀ l, U l ≤ ψ ⁻¹ᵁ V l), IsSeparated sQ → (∀ l, IsAffineOpen (V l)) → ψ ≫ sQ = fX → (⨆ l, U l) = ⊤ → (∀ l, ψ ⁻¹ᵁ V l = U l) → (∀ l, IsAffineOpen (U l)) → (∀ l (t : Γ(X, U l)), ∃ c, ψ.appLE (V l) (U l) (hψ l) c = t) → IsClosedImmersion ψ := by
    intro S Q X sQ fX _ ψ ι U V hψ hsep haff hcomp hcov hpre haffU hsurj
    haveI : IsProper (ψ ≫ sQ) := by rw [hcomp]; infer_instance
    haveI := hsep
    haveI : IsProper ψ := IsProper.of_comp ψ sQ
    have hcl : IsClosed (Set.range ψ) := ψ.isClosedMap.isClosed_range
    let O : Q.Opens := ⟨(Set.range ψ)ᶜ, hcl.isOpen_compl⟩
    let V' : Option ι → Q.Opens := fun o => o.elim O (fun l => V l)
    have hcov' : iSup V' = ⊤ := by
      rw [eq_top_iff]
      intro y _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hy : y ∈ Set.range ψ
      · obtain ⟨x, rfl⟩ := hy
        have hx : x ∈ ⨆ l, U l := by rw [hcov]; trivial
        obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        exact ⟨some l, hψ l hl⟩
      · exact ⟨none, hy⟩
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion) V' hcov' ?_
    intro o
    cases o with
    | none =>
      haveI : IsEmpty (ψ ⁻¹ᵁ O).toScheme := ⟨fun x => x.2 ⟨x.1, rfl⟩⟩
      show IsClosedImmersion (ψ ∣_ O)
      infer_instance
    | some l =>
      show IsClosedImmersion (ψ ∣_ V l)
      have key : ∀ (W : X.Opens) (hW : W ≤ ψ ⁻¹ᵁ V l), IsAffineOpen W →
          ψ ⁻¹ᵁ V l = W →
          (∀ t : Γ(X, W), ∃ c, ψ.appLE (V l) W hW c = t) →
          IsClosedImmersion (ψ ∣_ V l) := by
        intro W hW hWa heq hs
        subst heq
        rw [← Scheme.Hom.resLE_eq_morphismRestrict]
        haveI : IsAffine (V l) := haff l
        haveI : IsAffine (ψ ⁻¹ᵁ V l) := hWa
        refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
        intro t
        obtain ⟨c, hc⟩ := hs ((ψ ⁻¹ᵁ V l).topIso.hom t)
        refine ⟨(V l).topIso.inv c, ?_⟩
        rw [Scheme.Hom.appTop, Scheme.Hom.resLE_app_top]
        rw [CommRingCat.comp_apply, CommRingCat.comp_apply, Iso.inv_hom_id_apply, hc,
          Iso.hom_inv_id_apply]
      exact key (U l) (hψ l) (haffU l) (hpre l) (hsurj l)

  obtain ⟨N, j, hj, hjs⟩ := hZ
  haveI := hb
  haveI := hj
  have hjs' : j ≫ wcFprS R N = uZ := hjs
  have hb'f : IsFinite (b ≫ j) := inferInstance

  obtain ⟨haffN, hcovN, hcfN⟩ := fpr_ring_chart_facts N
  obtain ⟨E, r, γ, hE, hgen, hrel⟩ :=
    fpr_pre_tuples N (wcFprD R N) (wcFprE R N) (b ≫ j) hb'f haffN hcfN
  obtain ⟨E', γ', hE', hdiag, hrel'⟩ :=
    fpr_fix_tuples N (wcFprD R N) (wcFprE R N) (b ≫ j) E r γ hb'f haffN hcfN hE hrel
  obtain ⟨M, ψ, J0, hψ, hover, hpre, hcE, hcγ⟩ :=
    fpr_glue (wcFprS R N) N (wcFprD R N) (wcFprE R N) (b ≫ j) E' r γ' hE' hcovN hcfN
      (fun m => wcFprP R m) (fun m => wcFprS R m) (fun m => wcFprD R m) (fun m => wcFprE R m)
      (fun m => fpr_up (wcFprS R m) m (wcFprD R m) (wcFprE R m) (fpr_ring_chart_facts m).2.1
        (fpr_ring_proj_lift m)
        (fpr_uniq (wcFprS R m) m (wcFprD R m) (wcFprE R m) (fpr_ring_chart_facts m).1
          (fun J L => ((fpr_ring_chart_facts m).2.2 J L J).2.1) (fpr_ring_chart_facts m).2.1
          (fpr_ring_chart_gen m)))
      hrel'
  have hover' : ψ ≫ wcFprS R M = (b ≫ j) ≫ wcFprS R N := hover
  have hψ' : ∀ l, (b ≫ j) ⁻¹ᵁ wcFprD R N l ≤ ψ ⁻¹ᵁ wcFprD R M (J0 l) := hψ
  have hsurj : ∀ l (t : Γ(Y, (b ≫ j) ⁻¹ᵁ wcFprD R N l)),
      ∃ c, ψ.appLE (wcFprD R M (J0 l)) ((b ≫ j) ⁻¹ᵁ wcFprD R N l) (hψ' l) c = t := by
    intro l
    refine fpr_chart_surj (wcFprS R N) (wcFprS R M) N (wcFprD R N) (wcFprE R N)
      (wcFprD R M (J0 l)) (b ≫ j) ψ l (hψ' l) (Set.range (γ l l)) hover'
      (fpr_ring_chart_gen N l) (hgen l) (fun m => (hcE l m).elim fun L hL => ⟨_, hL⟩) ?_
    rintro _ ⟨j', rfl⟩
    obtain ⟨L, hL⟩ := hcγ l j'
    exact ⟨_, hL.trans (hdiag l j')⟩
  haveI : IsProper (wcFprS R N) := fpr_proj_proper N
  haveI : IsProper (wcFprS R M) := fpr_proj_proper M
  haveI : IsProper ((b ≫ j) ≫ wcFprS R N) := inferInstance
  have hU : (⨆ l, (b ≫ j) ⁻¹ᵁ wcFprD R N l) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hcovN, Scheme.Hom.preimage_top]
  have haffU : ∀ l, IsAffineOpen ((b ≫ j) ⁻¹ᵁ wcFprD R N l) := fun l => (haffN l).preimage (b ≫ j)
  have hpre' : ∀ l, ψ ⁻¹ᵁ wcFprD R M (J0 l) = (b ≫ j) ⁻¹ᵁ wcFprD R N l := hpre
  have hci := fpr_closed_imm (wcFprS R M) ((b ≫ j) ≫ wcFprS R N) ψ
    (fun l => (b ≫ j) ⁻¹ᵁ wcFprD R N l) (fun l => wcFprD R M (J0 l)) hψ' inferInstance
    (fun l => (fpr_ring_chart_facts M).1 (J0 l)) hover' hU hpre' haffU hsurj
  refine ⟨M, ψ, hci, ?_⟩
  show ψ ≫ wcFprS R M = b ≫ uZ
  rw [hover', Category.assoc, hjs']

theorem wcpa_dj_lr1k_gc_function_field_separable : ∀ (S Ct : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Ct] (φ : Ct ⟶ S), IsFinite φ → (∃ V : Ct.Opens, Dense (V : Set Ct) ∧ Etale (V.ι ≫ φ)) → ∃ hgen : φ (genericPoint Ct) ⤳ genericPoint S, letI : Algebra S.functionField Ct.functionField := (S.presheaf.stalkSpecializes hgen ≫ φ.stalkMap (genericPoint Ct)).hom.toAlgebra; FiniteDimensional S.functionField Ct.functionField ∧ Algebra.IsSeparable S.functionField Ct.functionField :=
by
  intro S Ct _ _ φ hφ hV
  obtain ⟨V, hVd, hVet⟩ := hV

  have sf : ∀ (S T : Scheme.{u}) [AlgebraicGeometry.IsIntegral S]
      [AlgebraicGeometry.IsIntegral T] (f : T ⟶ S) (hgen : f (genericPoint T) ⤳ genericPoint S)
      (U₀ : S.Opens), IsAffineOpen U₀ → U₀ ≠ ⊥ → IsFinite (f ∣_ U₀) →
      letI : Algebra S.functionField T.functionField :=
        (S.presheaf.stalkSpecializes hgen ≫ f.stalkMap (genericPoint T)).hom.toAlgebra
      FiniteDimensional S.functionField T.functionField := by
    intro S T _ _ f hgen U₀ hU₀ hne hfin
    have s2 : ∀ (A B K L : Type u) [CommRing A] [CommRing B] [Field K] [Field L] [Algebra B L]
        [IsFractionRing B L] [Algebra K L] (φ : A →+* B) (ψ : A →+* K), φ.Finite →
        (∀ a : A, algebraMap B L (φ a) = algebraMap K L (ψ a)) → FiniteDimensional K L := by
      intro A B K L _ _ _ _ _ _ _ φ ψ hφ hc
      letI : Algebra A B := φ.toAlgebra
      haveI : Module.Finite A B := hφ
      obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := A) (M := B)
      have hint : ∀ i, IsIntegral K (algebraMap B L (b i)) := by
        intro i
        have h1 : IsIntegral A (b i) := IsIntegral.of_finite A (b i)
        exact IsIntegral.map_of_comp_eq ψ (algebraMap B L) (RingHom.ext fun a => (hc a).symm) h1
      set R : Subalgebra K L := Algebra.adjoin K (Set.range (fun i => algebraMap B L (b i)))
        with hR
      have hRfin : Module.Finite K R := by
        apply Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _)
        rintro _ ⟨i, rfl⟩
        exact hint i
      have hB : ∀ x : B, algebraMap B L x ∈ R := by
        intro x
        have hx : x ∈ Submodule.span A (Set.range b) := by rw [hb]; trivial
        obtain ⟨c, hc'⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hx
        rw [← hc', map_sum]
        refine Subalgebra.sum_mem _ fun i _ => ?_
        rw [Algebra.smul_def, map_mul]
        have e : algebraMap B L (algebraMap A B (c i)) = algebraMap K L (ψ (c i)) := hc (c i)
        rw [e]
        exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
          (Algebra.subset_adjoin ⟨i, rfl⟩)
      have hinv : ∀ z ∈ R, z⁻¹ ∈ R := by
        intro z hz
        have hfg : (Subalgebra.toSubmodule R).FG := Module.Finite.iff_fg.mp hRfin
        have hzi : IsIntegral K z := IsIntegral.of_mem_of_fg R hfg z hz
        exact hzi.inv_mem hz
      have htop : ∀ z : L, z ∈ R := by
        intro z
        obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := B) z
        rw [div_eq_mul_inv]
        exact R.mul_mem (hB x) (hinv _ (hB y))
      exact Module.Finite.of_surjective R.val.toLinearMap (fun z => ⟨⟨z, htop z⟩, rfl⟩)
    letI : Algebra S.functionField T.functionField :=
      (S.presheaf.stalkSpecializes hgen ≫ f.stalkMap (genericPoint T)).hom.toAlgebra
    obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mp hne
    have hS : genericPoint S ∈ U₀ := (genericPoint_specializes u).mem_open U₀.isOpen hu
    have hT : genericPoint T ∈ f ⁻¹ᵁ U₀ := hgen.mem_open U₀.isOpen hS
    haveI : Nonempty U₀ := ⟨⟨_, hS⟩⟩
    haveI : Nonempty (f ⁻¹ᵁ U₀) := ⟨⟨_, hT⟩⟩
    haveI := hfin
    haveI : IsAffine (U₀ : Scheme) := hU₀
    have hAff : IsAffineOpen (f ⁻¹ᵁ U₀) := isAffine_of_isAffineHom (f ∣_ U₀)
    have hφ : (f.app U₀).hom.Finite := by
      have h1 : ((f ∣_ U₀).app ⊤).hom.Finite :=
        IsFinite.finite_app (f ∣_ U₀) ⊤ (isAffineOpen_top _)
      rw [morphismRestrict_app] at h1
      have gen : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (g : R₁ ⟶ R₂) (e : R₂ ⟶ R₃) [IsIso e],
          (g ≫ e).hom.Finite → g.hom.Finite := by
        intro R₁ R₂ R₃ g e _ h
        have h2 : (inv e).hom.Finite :=
          RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (inv e)).2
        have e1 : g = (g ≫ e) ≫ inv e := by simp
        rw [e1, CommRingCat.hom_comp]
        exact RingHom.Finite.comp h2 h
      have h2 := @gen _ _ _ _ _ (Functor.map_isIso _ _) h1
      have h3 : ∀ V : S.Opens, (f.app V).hom.Finite → V = U₀ → (f.app U₀).hom.Finite := by
        rintro V h rfl
        exact h
      exact h3 _ h2 (Scheme.Opens.ι_image_top U₀)
    haveI := functionField_isFractionRing_of_isAffineOpen T (f ⁻¹ᵁ U₀) hAff
    have hcomp : ∀ a : Γ(S, U₀), algebraMap Γ(T, f ⁻¹ᵁ U₀) T.functionField ((f.app U₀).hom a) =
        algebraMap S.functionField T.functionField (algebraMap Γ(S, U₀) S.functionField a) := by
      intro a
      have e : S.presheaf.germ U₀ (genericPoint S) hS ≫ S.presheaf.stalkSpecializes hgen ≫
          f.stalkMap (genericPoint T) =
            f.app U₀ ≫ T.presheaf.germ (f ⁻¹ᵁ U₀) (genericPoint T) hT := by
        rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap]
      exact (congrArg (fun φ => φ.hom a) e).symm
    exact s2 Γ(S, U₀) Γ(T, f ⁻¹ᵁ U₀) S.functionField T.functionField (f.app U₀).hom
      (algebraMap Γ(S, U₀) S.functionField) hφ hcomp

  haveI : Etale (V.ι ≫ φ) := hVet
  haveI : IsFinite φ := hφ
  obtain ⟨v, hv⟩ := hVd.nonempty
  have hηV : genericPoint Ct ∈ V := (genericPoint_specializes v).mem_open V.isOpen hv
  have hO : IsOpen (Set.range (V.ι ≫ φ)) := (Scheme.Hom.isOpenMap (V.ι ≫ φ)).isOpen_range
  obtain ⟨v', hv'⟩ : genericPoint S ∈ Set.range (V.ι ≫ φ) :=
    (genericPoint_specializes ((V.ι ≫ φ) ⟨v, hv⟩)).mem_open hO ⟨⟨v, hv⟩, rfl⟩
  have hv'' : φ (V.ι v') = genericPoint S := by
    rw [← hv', Scheme.Hom.comp_apply]
  have hgen : φ (genericPoint Ct) ⤳ genericPoint S := by
    rw [← hv'']
    exact (genericPoint_specializes (V.ι v')).map φ.continuous
  have hins : Inseparable (φ (genericPoint Ct)) (genericPoint S) :=
    hgen.antisymm (genericPoint_specializes _)
  refine ⟨hgen, ?_⟩
  letI : Algebra S.functionField Ct.functionField :=
    (S.presheaf.stalkSpecializes hgen ≫ φ.stalkMap (genericPoint Ct)).hom.toAlgebra

  obtain ⟨U₀, hU₀, hξ, -⟩ := exists_isAffineOpen_mem_and_subset (x := genericPoint S)
    (U := ⊤) trivial
  have hne : U₀ ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mpr ⟨_, hξ⟩
  have hfd : FiniteDimensional S.functionField Ct.functionField :=
    sf S Ct φ hgen U₀ hU₀ hne inferInstance

  have gen1 : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (g : R₁ ⟶ R₂) (e : R₂ ⟶ R₃) [IsIso e],
      (g ≫ e).hom.FormallyUnramified → g.hom.FormallyUnramified := by
    intro R₁ R₂ R₃ g e _ h
    have h2 : (inv e).hom.FormallyUnramified :=
      RingHom.FormallyUnramified.of_surjective (ConcreteCategory.bijective_of_isIso (inv e)).2
    have e1 : g = (g ≫ e) ≫ inv e := by simp
    rw [e1, CommRingCat.hom_comp]
    exact RingHom.FormallyUnramified.comp h h2
  have gen2 : ∀ {R₁ R₂ R₃ : CommRingCat.{u}} (e : R₁ ⟶ R₂) [IsIso e] (g : R₂ ⟶ R₃),
      g.hom.FormallyUnramified → (e ≫ g).hom.FormallyUnramified := by
    intro R₁ R₂ R₃ e _ g h
    have h2 : e.hom.FormallyUnramified :=
      RingHom.FormallyUnramified.of_surjective (ConcreteCategory.bijective_of_isIso e).2
    rw [CommRingCat.hom_comp]
    exact RingHom.FormallyUnramified.comp h2 h
  have hu0 : (φ.stalkMap (V.ι ⟨genericPoint Ct, hηV⟩) ≫
      V.ι.stalkMap ⟨genericPoint Ct, hηV⟩).hom.FormallyUnramified := by
    have h0 := AlgebraicGeometry.FormallyUnramified.stalkMap (V.ι ≫ φ) ⟨genericPoint Ct, hηV⟩
    have e0 := Scheme.Hom.stalkMap_comp V.ι φ ⟨genericPoint Ct, hηV⟩
    first
      | (rw [e0] at h0; exact h0)
      | (erw [e0] at h0; exact h0)
      | exact e0 ▸ h0
  have hu : (φ.stalkMap (genericPoint Ct)).hom.FormallyUnramified :=
    @gen1 _ _ _ _ _ (IsOpenImmersion.instIsIsoCommRingCatStalkMap V.ι _) hu0
  haveI : IsIso (S.presheaf.stalkSpecializes hgen) := by
    have := (S.presheaf.stalkCongr hins.symm).isIso_hom
    rw [TopCat.Presheaf.stalkCongr_hom] at this
    exact this
  have hR : (S.presheaf.stalkSpecializes hgen ≫
      φ.stalkMap (genericPoint Ct)).hom.FormallyUnramified :=
    gen2 _ _ hu
  haveI : Algebra.FormallyUnramified S.functionField Ct.functionField := hR
  haveI := hfd
  exact ⟨hfd, Algebra.FormallyUnramified.isSeparable _ _⟩

theorem wcpa_dj_lr1k_gc_norm_finite : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IsLocallyNoetherian S] (M : Type u) [Field M] [Algebra S.functionField M] [FiniteDimensional S.functionField M] [Algebra.IsSeparable S.functionField M] (f : Spec (.of M) ⟶ S) [QuasiCompact f] [QuasiSeparated f], f = Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫ S.fromSpecStalk (genericPoint S) → (∀ x : S, IsIntegrallyClosed (S.presheaf.stalk x)) → IsFinite f.fromNormalization :=
by
  intro S _ _ M _ _ _ _ f _ _ hf hnorm

  have H : ∀ y : S, ∃ W : S.Opens, IsAffineOpen W ∧ y ∈ W ∧
      (letI : Algebra Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W) := (Scheme.Hom.app f W).hom.toAlgebra;
        Module.Finite Γ(S, W) (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W))) := by
    intro y
    obtain ⟨W, hW, hyW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := ⊤) (TopologicalSpace.Opens.mem_top y)
    refine ⟨W, hW, hyW, ?_⟩
    haveI : Nonempty W := ⟨⟨y, hyW⟩⟩
    have hξ : genericPoint S ∈ W :=
      ((genericPoint_spec S).specializes (Set.mem_univ y)).mem_open W.isOpen hyW
    haveI : IsNoetherianRing Γ(S, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
    haveI : IsIntegrallyClosed Γ(S, W) := by
      have key : ∀ q : PrimeSpectrum Γ(S, W),
          IsIntegrallyClosed (Localization.AtPrime q.asIdeal) := by
        intro q
        have hqU' : hW.fromSpec q ∈ (W : Set S) := by
          rw [← hW.range_fromSpec]
          exact Set.mem_range_self q
        have hqU : hW.fromSpec q ∈ W := hqU'
        obtain ⟨x, hx⟩ : ∃ x : W, (x : S) = hW.fromSpec q := ⟨⟨_, hqU⟩, rfl⟩
        have hpx : hW.primeIdealOf x = q := by
          apply (Scheme.Hom.isOpenEmbedding hW.fromSpec).injective
          rw [hW.fromSpec_primeIdealOf x, hx]
        haveI := hW.isLocalization_stalk x
        haveI := hnorm (x : S)
        have h6 : IsIntegrallyClosed (Localization.AtPrime (hW.primeIdealOf x).asIdeal) :=
          IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv
            (hW.primeIdealOf x).asIdeal.primeCompl
            (S.presheaf.stalk (x : S)) (Localization.AtPrime (hW.primeIdealOf x).asIdeal)).toRingEquiv
        subst hpx
        exact h6
      apply IsIntegrallyClosed.of_localization_maximal
      intro p _ hmax
      exact key ⟨p, hmax.isPrime⟩
    haveI : IsFractionRing Γ(S, W) S.functionField :=
      functionField_isFractionRing_of_isAffineOpen S W hW
    have hpre : f ⁻¹ᵁ W = ⊤ := by
      refine eq_top_iff.mpr fun p _ => ?_
      show f p ∈ W
      have hmem : f p ∈ Set.range (S.fromSpecStalk (genericPoint S)) := by
        rw [hf, Scheme.Hom.comp_apply]; exact ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hmem
      exact (hmem : f p ⤳ genericPoint S).mem_open W.isOpen hξ
    have happ : Scheme.Hom.app f W = S.presheaf.germ W (genericPoint S) hξ ≫
        CommRingCat.ofHom (algebraMap S.functionField M) ≫ (Scheme.ΓSpecIso (.of M)).inv ≫
          (Spec (.of M)).presheaf.map (eqToHom hpre).op := by
      subst hf
      rw [Scheme.Hom.comp_app, Scheme.fromSpecStalk_app hξ, Category.assoc, Category.assoc,
        Scheme.Hom.naturality]
      rw [← Category.assoc ((Scheme.ΓSpecIso _).inv)]
      erw [← Scheme.ΓSpecIso_inv_naturality]
      simp only [Category.assoc]
      rfl
    letI : Algebra Γ(S, W) M :=
      ((algebraMap S.functionField M).comp (algebraMap Γ(S, W) S.functionField)).toAlgebra
    haveI : IsScalarTower Γ(S, W) S.functionField M := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Module.Finite Γ(S, W) (integralClosure Γ(S, W) M) :=
      IsIntegralClosure.finite Γ(S, W) S.functionField M (integralClosure Γ(S, W) M)
    let iso : CommRingCat.of M ≅ Γ(Spec (.of M), f ⁻¹ᵁ W) :=
      (Scheme.ΓSpecIso (.of M)).symm ≪≫ (Spec (.of M)).presheaf.mapIso (eqToIso hpre).op
    let e : M ≃+* Γ(Spec (.of M), f ⁻¹ᵁ W) := iso.commRingCatIsoToRingEquiv
    letI : Algebra Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W) := (Scheme.Hom.app f W).hom.toAlgebra
    let eA : M ≃ₐ[Γ(S, W)] Γ(Spec (.of M), f ⁻¹ᵁ W) := AlgEquiv.ofRingEquiv (f := e) (fun r => by
      show e (algebraMap S.functionField M (algebraMap Γ(S, W) S.functionField r)) =
        (Scheme.Hom.app f W).hom r
      rw [happ]
      rfl)
    exact Module.Finite.equiv eA.mapIntegralClosure.toLinearEquiv

  rw [IsFinite.iff_isIntegralHom_and_locallyOfFiniteType]
  refine ⟨inferInstance, ?_⟩
  choose W hW hyW hfin using H
  have hsup : iSup W = ⊤ :=
    eq_top_iff.mpr fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hyW y⟩
  have hV : iSup (fun y => Scheme.Hom.fromNormalization f ⁻¹ᵁ W y) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hsup, Scheme.Hom.preimage_top]
  haveI : IsZariskiLocalAtSource @LocallyOfFiniteType :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  refine (IsZariskiLocalAtSource.iff_of_iSup_eq_top (P := @LocallyOfFiniteType)
    (fun y => Scheme.Hom.fromNormalization f ⁻¹ᵁ W y) hV).mpr ?_
  intro y
  let U : S.affineOpens := ⟨W y, hW y⟩
  haveI : IsOpenImmersion ((Scheme.Hom.normalizationOpenCover f).f U) :=
    (Scheme.Hom.normalizationOpenCover f).map_prop U
  have e : Scheme.Hom.fromNormalization f ⁻¹ᵁ W y =
      ((Scheme.Hom.normalizationOpenCover f).f U).opensRange :=
    Scheme.Hom.fromNormalization_preimage f U
  have hS : LocallyOfFiniteType
      (Spec.map ((Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (W y)))) := by
    letI : Algebra Γ(S, W y) Γ(Spec (.of M), f ⁻¹ᵁ W y) := (Scheme.Hom.app f (W y)).hom.toAlgebra
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr
      ((RingHom.finite_algebraMap.mpr (hfin y)).finiteType :
        RingHom.FiniteType ((Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (W y))).hom)
  have key : (Scheme.Hom.fromNormalization f ⁻¹ᵁ W y).ι ≫ Scheme.Hom.fromNormalization f =
      ((Scheme.Hom.normalization f).isoOfEq e).hom ≫
        ((Scheme.Hom.normalizationOpenCover f).f U).isoOpensRange.inv ≫
        ((Scheme.Hom.normalizationOpenCover f).f U ≫ Scheme.Hom.fromNormalization f) := by
    rw [← Category.assoc, ← Category.assoc,
      Category.assoc ((Scheme.Hom.normalization f).isoOfEq e).hom,
      Scheme.Hom.isoOpensRange_inv_comp, Scheme.isoOfEq_hom_ι]
  rw [key, Scheme.Hom.ι_fromNormalization f U]
  have hS' : LocallyOfFiniteType
      (Spec.map ((Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (U : S.Opens)))) := hS
  have h1 : LocallyOfFiniteType (IsAffineOpen.fromSpec U.2) := by
    haveI : IsOpenImmersion (IsAffineOpen.fromSpec U.2) := IsAffineOpen.isOpenImmersion_fromSpec _
    first
      | exact IsZariskiLocalAtSource.of_isOpenImmersion (P := @LocallyOfFiniteType) _
      | infer_instance
  have h2 : LocallyOfFiniteType ((Scheme.Hom.normalization f).isoOfEq e).hom := inferInstance
  have h3 : LocallyOfFiniteType
      ((Scheme.Hom.normalizationOpenCover f).f U).isoOpensRange.inv := inferInstance
  exact MorphismProperty.comp_mem _ _ _ h2 (MorphismProperty.comp_mem _ _ _ h3
    (MorphismProperty.comp_mem _ _ _ hS' h1))

theorem wcpa_dj_lr1k_gc_norm_stalk_normal : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (M : Type u) [Field M] [Algebra S.functionField M] [FiniteDimensional S.functionField M] (f : Spec (.of M) ⟶ S) [QuasiCompact f] [QuasiSeparated f], f = Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫ S.fromSpecStalk (genericPoint S) → ∀ x : f.normalization, IsIntegrallyClosed (f.normalization.presheaf.stalk x) :=
by
  intro S _ M _ _ _ f _ _ hf x

  have s1 : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L], IsField L →
      IsDomain (integralClosure A L) ∧ IsIntegrallyClosed (integralClosure A L) := by
    intro A L _ _ _ h
    letI : Field L := h.toField
    haveI : IsDomain L := h.isDomain
    exact ⟨Subalgebra.isDomain _, IsIntegrallyClosed.of_isIntegrallyClosedIn (integralClosure A L) L⟩

  have s3 : ∀ (Y : Scheme.{u}) (V : Y.Opens), IsAffineOpen V → IsDomain Γ(Y, V) →
      IsIntegrallyClosed Γ(Y, V) → ∀ y : V, IsIntegrallyClosed (Y.presheaf.stalk (y : Y)) := by
    intro Y V hV hd hi y
    haveI := hV.isLocalization_stalk y
    exact isIntegrallyClosed_of_isLocalization (Y.presheaf.stalk (y : Y))
      (hV.primeIdealOf y).asIdeal.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors _)

  have s2 : ∀ (W : S.Opens), Nonempty W → IsField Γ(Spec (.of M), f ⁻¹ᵁ W) := by
    intro W hW
    obtain ⟨⟨w, hw⟩⟩ := hW
    have ha : genericPoint S ∈ W :=
      ((genericPoint_spec S).mem_open_set_iff W.isOpen).mpr ⟨w, trivial, hw⟩
    have hc : f ⁻¹ᵁ W = ⊤ := by
      rw [eq_top_iff]
      intro p _
      rw [Scheme.Hom.mem_preimage]
      have hm : f p ∈ Set.range (S.fromSpecStalk (genericPoint S)) := by
        rw [hf, Scheme.Hom.comp_apply]; exact ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hm
      exact Specializes.mem_open hm W.isOpen ha
    rw [hc]
    exact MulEquiv.isField (Field.toIsField M)
      (Scheme.ΓSpecIso (CommRingCat.of M)).commRingCatIsoToRingEquiv.toMulEquiv

  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset
    (show f.fromNormalization x ∈ (⊤ : S.Opens) from trivial)
  haveI hWne : Nonempty W := ⟨⟨f.fromNormalization x, hxW⟩⟩
  have hV : IsAffineOpen (f.fromNormalization ⁻¹ᵁ W) := hW.preimage f.fromNormalization
  have hxV : x ∈ f.fromNormalization ⁻¹ᵁ W := hxW
  letI : Algebra Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W) := (f.app W).hom.toAlgebra
  obtain ⟨hdom, hic⟩ := s1 Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W) (s2 W hWne)
  let e := (Scheme.Hom.normalizationObjIso f hW).commRingCatIsoToRingEquiv
  haveI : IsDomain Γ(f.normalization, f.fromNormalization ⁻¹ᵁ W) :=
    MulEquiv.isDomain _ e.toMulEquiv
  haveI : IsIntegrallyClosed Γ(f.normalization, f.fromNormalization ⁻¹ᵁ W) :=
    IsIntegrallyClosed.of_equiv e.symm
  exact s3 _ _ hV inferInstance inferInstance ⟨x, hxV⟩

theorem wcpa_dj_lr1k_gc_norm_generic_etale : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IsLocallyNoetherian S] (M : Type u) [Field M] [Algebra S.functionField M] [FiniteDimensional S.functionField M] [Algebra.IsSeparable S.functionField M] (f : Spec (.of M) ⟶ S) [QuasiCompact f] [QuasiSeparated f], f = Spec.map (CommRingCat.ofHom (algebraMap S.functionField M)) ≫ S.fromSpecStalk (genericPoint S) → (∀ x : S, IsIntegrallyClosed (S.presheaf.stalk x)) → ∃ V : f.normalization.Opens, Nonempty V ∧ Etale (V.ι ≫ f.fromNormalization) :=
by

  have alg : ∀ (A K M B : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
      [IsNoetherianRing A] [Field K] [Algebra A K] [IsFractionRing A K] [Field M] [Algebra K M]
      [Algebra A M] [IsScalarTower A K M] [FiniteDimensional K M] [Algebra.IsSeparable K M]
      [CommRing B] [Algebra A B] [Algebra B M] [IsScalarTower A B M] [IsIntegralClosure B A M],
      ∃ b : B, b ≠ 0 ∧ Algebra.Etale A (Localization.Away b) ∧
        Nontrivial (Localization.Away b) := by
    intro A K M B _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    haveI : Module.Finite A B := IsIntegralClosure.finite A K M B
    haveI : Algebra.FinitePresentation A B :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    haveI : IsDomain B := Function.Injective.isDomain (algebraMap B M)
      (IsIntegralClosure.algebraMap_injective B A M)
    haveI : IsFractionRing B M := IsIntegralClosure.isFractionRing_of_finite_extension A K M B
    haveI : Algebra.FormallyEtale A K := Algebra.FormallyEtale.of_isLocalization (nonZeroDivisors A)
    haveI : Algebra.FormallyEtale K M := Algebra.FormallyEtale.of_isSeparable K M
    haveI : Algebra.FormallyEtale A M := Algebra.FormallyEtale.comp A K M
    have hkey : ∀ N : Submonoid B, N = nonZeroDivisors B →
        IsLocalization (nonZeroDivisors B) (Localization N) := by
      rintro N rfl
      infer_instance
    haveI hloc : IsLocalization (nonZeroDivisors B) (Localization.AtPrime (⊥ : Ideal B)) :=
      hkey _ Ideal.primeCompl_bot
    let e : M ≃ₐ[B] Localization.AtPrime (⊥ : Ideal B) :=
      IsLocalization.algEquiv (nonZeroDivisors B) M (Localization.AtPrime (⊥ : Ideal B))
    have hfe : Algebra.FormallyEtale A (Localization.AtPrime (⊥ : Ideal B)) :=
      Algebra.FormallyEtale.of_equiv (e.restrictScalars A)
    let p0 : PrimeSpectrum B := ⟨⊥, Ideal.isPrime_bot⟩
    have hmem : p0 ∈ Algebra.etaleLocus A B := Algebra.mem_etaleLocus_iff.mpr hfe
    obtain ⟨_, ⟨b, rfl⟩, hb, hsub⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hmem
        Algebra.isOpen_etaleLocus
    have hb0 : b ≠ 0 := by
      have hb' : b ∉ p0.asIdeal := (PrimeSpectrum.mem_basicOpen b p0).mp hb
      intro h
      apply hb'
      rw [h]
      exact Ideal.zero_mem _
    refine ⟨b, hb0, Algebra.basicOpen_subset_etaleLocus_iff_etale.mp hsub, ?_⟩
    exact (IsLocalization.injective (Localization.Away b)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hb0)).nontrivial
  intro S _ _ M _ _ _ _ f _ _ hf hnorm
  obtain ⟨W, hW, hξ, -⟩ :=
    exists_isAffineOpen_mem_and_subset (U := ⊤) (TopologicalSpace.Opens.mem_top (genericPoint S))
  haveI : Nonempty W := ⟨⟨_, hξ⟩⟩
  haveI : IsNoetherianRing Γ(S, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  haveI : IsIntegrallyClosed Γ(S, W) := by
    have key : ∀ q : PrimeSpectrum Γ(S, W),
        IsIntegrallyClosed (Localization.AtPrime q.asIdeal) := by
      intro q
      have hqU' : hW.fromSpec q ∈ (W : Set S) := by
        rw [← hW.range_fromSpec]
        exact Set.mem_range_self q
      have hqU : hW.fromSpec q ∈ W := hqU'
      obtain ⟨x, hx⟩ : ∃ x : W, (x : S) = hW.fromSpec q := ⟨⟨_, hqU⟩, rfl⟩
      have hpx : hW.primeIdealOf x = q := by
        apply (Scheme.Hom.isOpenEmbedding hW.fromSpec).injective
        rw [hW.fromSpec_primeIdealOf x, hx]
      haveI := hW.isLocalization_stalk x
      haveI := hnorm (x : S)
      have h6 : IsIntegrallyClosed (Localization.AtPrime (hW.primeIdealOf x).asIdeal) :=
        IsIntegrallyClosed.of_equiv (IsLocalization.algEquiv
          (hW.primeIdealOf x).asIdeal.primeCompl
          (S.presheaf.stalk (x : S)) (Localization.AtPrime (hW.primeIdealOf x).asIdeal)).toRingEquiv
      subst hpx
      exact h6
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hmax
    exact key ⟨p, hmax.isPrime⟩
  haveI : IsFractionRing Γ(S, W) S.functionField :=
    functionField_isFractionRing_of_isAffineOpen S W hW
  have hpre : f ⁻¹ᵁ W = ⊤ := by
    refine eq_top_iff.mpr fun p _ => ?_
    show f p ∈ W
    have hmem : f p ∈ Set.range (S.fromSpecStalk (genericPoint S)) := by
      rw [hf, Scheme.Hom.comp_apply]; exact ⟨_, rfl⟩
    rw [Scheme.range_fromSpecStalk] at hmem
    exact (hmem : f p ⤳ genericPoint S).mem_open W.isOpen hξ
  have happ : Scheme.Hom.app f W = S.presheaf.germ W (genericPoint S) hξ ≫
      CommRingCat.ofHom (algebraMap S.functionField M) ≫ (Scheme.ΓSpecIso (.of M)).inv ≫
        (Spec (.of M)).presheaf.map (eqToHom hpre).op := by
    subst hf
    rw [Scheme.Hom.comp_app, Scheme.fromSpecStalk_app hξ, Category.assoc, Category.assoc,
      Scheme.Hom.naturality]
    rw [← Category.assoc ((Scheme.ΓSpecIso _).inv)]
    erw [← Scheme.ΓSpecIso_inv_naturality]
    rfl
  letI : Algebra Γ(S, W) M :=
    ((algebraMap S.functionField M).comp (algebraMap Γ(S, W) S.functionField)).toAlgebra
  haveI : IsScalarTower Γ(S, W) S.functionField M := IsScalarTower.of_algebraMap_eq' rfl
  let iso : CommRingCat.of M ≅ Γ(Spec (.of M), f ⁻¹ᵁ W) :=
    (Scheme.ΓSpecIso (.of M)).symm ≪≫ (Spec (.of M)).presheaf.mapIso (eqToIso hpre).op
  let e : M ≃+* Γ(Spec (.of M), f ⁻¹ᵁ W) := iso.commRingCatIsoToRingEquiv
  letI : Algebra Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W) := (Scheme.Hom.app f W).hom.toAlgebra
  let eA : M ≃ₐ[Γ(S, W)] Γ(Spec (.of M), f ⁻¹ᵁ W) := AlgEquiv.ofRingEquiv (f := e) (fun r => by
    show e (algebraMap S.functionField M (algebraMap Γ(S, W) S.functionField r)) =
      (Scheme.Hom.app f W).hom r
    rw [happ]
    rfl)

  letI : Algebra (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W)) M :=
    ((eA.symm : Γ(Spec (.of M), f ⁻¹ᵁ W) →+* M).comp
      (algebraMap (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W))
        Γ(Spec (.of M), f ⁻¹ᵁ W))).toAlgebra
  haveI : IsScalarTower Γ(S, W) (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W)) M :=
    IsScalarTower.of_algebraMap_eq (fun x => (eA.symm.commutes x).symm)
  haveI : IsIntegralClosure (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W)) Γ(S, W) M := by
    refine IsIntegralClosure.mk ?_ ?_
    · intro y z hyz
      exact Subtype.ext (eA.symm.injective hyz)
    · intro x
      constructor
      · intro hx
        exact ⟨⟨eA x, hx.map eA⟩, eA.symm_apply_apply x⟩
      · rintro ⟨y, rfl⟩
        exact y.2.map eA.symm
  obtain ⟨b, hb0, het, hnt⟩ :=
    alg Γ(S, W) S.functionField M (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W))

  let U : S.affineOpens := ⟨W, hW⟩
  let φU : Spec (.of (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W))) ⟶ f.normalization :=
    (Scheme.Hom.normalizationOpenCover f).f U
  haveI : IsOpenImmersion φU := (Scheme.Hom.normalizationOpenCover f).map_prop U
  haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap
      (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W)) (Localization.Away b)))) :=
    IsOpenImmersion.of_isLocalization b
  let g := Spec.map (CommRingCat.ofHom (algebraMap
      (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W)) (Localization.Away b))) ≫ φU
  haveI : IsOpenImmersion g := @IsOpenImmersion.comp _ _ _ _ _ ‹_› ‹_›
  have hcomp : Spec.map (CommRingCat.ofHom (algebraMap
      (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W)) (Localization.Away b))) ≫
      Spec.map ((Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (U : S.Opens))) =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(S, W) (Localization.Away b))) := by
    refine (Spec.map_comp ((Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (U : S.Opens)))
      (CommRingCat.ofHom (algebraMap
        (integralClosure Γ(S, W) Γ(Spec (.of M), f ⁻¹ᵁ W)) (Localization.Away b)))).symm.trans ?_
    congr 1
  have hEq : g ≫ f.fromNormalization =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(S, W) (Localization.Away b))) ≫ hW.fromSpec := by
    have h2 : φU ≫ f.fromNormalization =
        Spec.map ((Scheme.Hom.normalizationDiagramMap f).app (Opposite.op (U : S.Opens))) ≫
          hW.fromSpec := Scheme.Hom.ι_fromNormalization f U
    show (Spec.map _ ≫ φU) ≫ _ = _
    rw [Category.assoc, h2]
    exact (Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ hW.fromSpec) hcomp)
  refine ⟨g.opensRange, ?_, ?_⟩
  · obtain ⟨pt⟩ : Nonempty (Spec (.of (Localization.Away b))) := inferInstance
    exact ⟨⟨g pt, ⟨pt, rfl⟩⟩⟩
  · haveI h1 : Etale (Spec.map (CommRingCat.ofHom
        (algebraMap Γ(S, W) (Localization.Away b)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr het)
    rw [← Scheme.Hom.isoOpensRange_inv_comp g, Category.assoc, hEq]
    infer_instance

theorem wcpa_dj_lr1k_gc_normal_curve_smooth : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (γ : C ⟶ wcProjK Ω 1), IsFinite γ → Surjective γ → (∀ x : C, IsIntegrallyClosed (C.presheaf.stalk x)) → SmoothOfRelativeDimension 1 (γ ≫ wcProjKStr Ω 1) :=
by
  intro Ω _ _ C _ γ hγf hγs hnorm
  obtain ⟨hPint, -, -, -⟩ := wc_projK_integral_normal Ω 1
  haveI := hPint
  haveI := hγf
  haveI : IsProper (wcProjKStr Ω 1) := wc_proj_space_isProper Ω 1
  have hdim : topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞) := by
    rw [wcpa_dj_alteration_dim_eq Ω C (wcProjK Ω 1) (γ ≫ wcProjKStr Ω 1) (wcProjKStr Ω 1) γ rfl hγs
        ⟨⊤, (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr
          ⟨Classical.choice inferInstance, trivial⟩, inferInstance⟩,
      wc_proj_space_dim Ω 1]
  obtain ⟨hηnc, hspec⟩ := wc_dim_one_integral_specialization C hdim
  have hcl : ∀ y : C, y ≠ genericPoint C → IsClosed ({y} : Set C) := fun y hy =>
    isClosed_of_closure_subset fun z hz =>
      Set.mem_singleton_iff.mpr (hspec y z hy (specializes_iff_mem_closure.mpr hz))
  have hdvr := wc_curve_stalk_dvr Ω C (γ ≫ wcProjKStr Ω 1) hnorm hcl
  refine wc_odp_smooth_of_closed_regular Ω C (γ ≫ wcProjKStr Ω 1) 1 (fun z hz => Or.inr ?_)
  have hz : z ≠ genericPoint C := fun h => hηnc (h ▸ hz)
  haveI := hdvr z hz
  set R := C.presheaf.stalk z with hR
  have hdimR : ringKrullDim R = 1 := IsDiscreteValuationRing.ringKrullDim_eq_one R
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hm : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have hle : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤ 1 := by
    rw [hm]
    have := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) (Set.finite_singleton ϖ)
    rw [Set.ncard_singleton] at this
    exact this
  have hne : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≠ 0 := by
    intro h0
    have hfg : (IsLocalRing.maximalIdeal R).FG := by
      rw [hm]; exact Submodule.fg_span_singleton ϖ
    exact IsDiscreteValuationRing.not_a_field R
      ((Submodule.spanFinrank_eq_zero_iff_eq_bot hfg).mp h0)
  have h1 : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) = 1 := by omega
  refine ⟨IsRegularLocalRing.mk ?_, ?_⟩
  · rw [h1, hdimR]; rfl
  · rw [hdimR]; rfl

theorem wcpa_dj_lr1k_galois_closure_cover : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (Ct : Scheme.{u}) (φ : Ct ⟶ wcProjK Ω 1), wcpaDjLkCov Ω φ →
    ∃ (C : Scheme.{u}) (π : C ⟶ Ct), IsFinite π ∧ Surjective π ∧ wcpaDjLkCov Ω (π ≫ φ) ∧
      wcpaDjLkGalois (π ≫ φ) :=
by
  intro Ω _ _ Ct φ hcov
  classical
  obtain ⟨hproj, hsm, hirr, hφf, hgen⟩ := hcov
  obtain ⟨hPint, hPnorm, hPqs, hPln⟩ := wc_projK_integral_normal Ω 1
  haveI := hPint
  haveI := hPqs
  haveI := hPln
  haveI := hsm
  haveI := hirr
  haveI := hφf

  haveI hstred : ∀ x : Ct, _root_.IsReduced (Ct.presheaf.stalk x) := fun x => by
