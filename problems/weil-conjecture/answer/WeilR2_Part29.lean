    by_cases he : e' = e
    · subst he
      convert hv e' using 1
      funext i
      rw [hcH _ _ _ (MvPolynomial.homogeneousComponent_isHomogeneous e' (v i)), if_pos rfl]
    · have : (fun i => A (MvPolynomial.homogeneousComponent e'
          (MvPolynomial.homogeneousComponent e (v i)))) = 0 := by
        funext i
        rw [hcH _ _ _ (MvPolynomial.homogeneousComponent_isHomogeneous e (v i)), if_neg he, map_zero]
        rfl
      rw [this]
      exact K.zero_mem
  ·
    intro v hv
    rw [hmem] at hv
    obtain ⟨D, hvi⟩ := hdec v
    have : (fun i => A (v i)) = ∑ e ∈ Finset.range (D + 1),
        (fun i => A (MvPolynomial.homogeneousComponent e (v i))) := by
      funext i
      rw [Finset.sum_apply]
      conv_lhs => rw [hvi i]
      rw [map_sum]
    rw [this]
    exact Submodule.sum_mem _ (fun e _ => hv e)
  ·
    intro u hu
    set E := Finset.univ.sup (fun i => (u i).totalDegree) with hE
    have hEi : ∀ i, (u i).totalDegree ≤ E := fun i =>
      Finset.le_sup (f := fun i => (u i).totalDegree) (Finset.mem_univ i)
    let P : Fin n → MvPolynomial (Fin (d + 1)) V := fun i =>
      ∑ j ∈ Finset.range (E + 1), MvPolynomial.X 0 ^ (E - j) *
        MvPolynomial.rename Fin.succ (MvPolynomial.homogeneousComponent j (u i))
    have hPh : ∀ i, (P i).IsHomogeneous E := by
      intro i
      apply MvPolynomial.IsHomogeneous.sum
      intro j hj
      have hjE : j ≤ E := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      have := (MvPolynomial.isHomogeneous_X_pow (R := V) (0 : Fin (d + 1)) (E - j)).mul
        ((MvPolynomial.homogeneousComponent_isHomogeneous j (u i)).rename_isHomogeneous
          (f := Fin.succ))
      rwa [Nat.sub_add_cancel hjE] at this
    have hPA : ∀ i, A (P i) = u i := by
      intro i
      simp only [P, map_sum, map_mul, map_pow, hA0, one_pow, one_mul, hAr]
      rw [← Finset.sum_subset (s₁ := Finset.range ((u i).totalDegree + 1))]
      · exact MvPolynomial.sum_homogeneousComponent (u i)
      · intro j hj
        simp only [Finset.mem_range] at hj ⊢
        have := hEi i
        omega
      · intro j _ hj
        simp only [Finset.mem_range, not_lt] at hj
        exact MvPolynomial.homogeneousComponent_eq_zero j (u i) (by omega)
    refine ⟨P, ?_, ?_⟩
    · rw [hmem]
      intro e
      by_cases he : e = E
      · convert hu using 1
        funext i
        rw [hcH _ _ _ (hPh i), if_pos he, hPA i]
      · have : (fun i => A (MvPolynomial.homogeneousComponent e (P i))) = 0 := by
          funext i
          rw [hcH _ _ _ (hPh i), if_neg he, map_zero]
          rfl
        rw [this]
        exact K.zero_mem
    · funext i
      exact hPA i

theorem wcpa_vrpc_vec_hc_decomp : ∀ (R : Type u) [CommSemiring R] (m n : ℕ) (x : Fin n → MvPolynomial (Fin m) R), ∃ D : ℕ, ∀ D' : ℕ, D ≤ D' → x = ∑ e ∈ Finset.range (D' + 1), (fun i => MvPolynomial.homogeneousComponent e (x i)) :=
by
  intro R _ m n x
  refine ⟨Finset.univ.sup (fun i : Fin n => (x i).totalDegree), fun D' hD => ?_⟩
  funext i
  simp only [Finset.sum_apply]
  have hdeg : (x i).totalDegree ≤ D' :=
    le_trans (Finset.le_sup (f := fun i : Fin n => (x i).totalDegree) (Finset.mem_univ i)) hD
  have hsub : Finset.range ((x i).totalDegree + 1) ⊆ Finset.range (D' + 1) := fun k hk =>
    Finset.mem_range.mpr (lt_of_lt_of_le (Finset.mem_range.mp hk) (by omega))
  rw [← Finset.sum_subset hsub (fun e he hne => by
    simp only [Finset.mem_range] at he hne
    exact MvPolynomial.homogeneousComponent_eq_zero e (x i) (by omega))]
  exact (MvPolynomial.sum_homogeneousComponent (x i)).symm

theorem wcpa_vrpc_residue_generators : ∀ (V : Type u) [CommRing V] [IsLocalRing V] (m n : ℕ) (L : Submodule (MvPolynomial (Fin m) V) (Fin n → MvPolynomial (Fin m) V)), (∀ (v : Fin n → MvPolynomial (Fin m) V) (e : ℕ), v ∈ L → (fun i => MvPolynomial.homogeneousComponent e (v i)) ∈ L) → ∃ (r : ℕ) (h : Fin r → Fin n → MvPolynomial (Fin m) V) (a : Fin r → ℕ), (∀ j, h j ∈ L) ∧ (∀ j i, (h j i).IsHomogeneous (a j)) ∧ ∀ x ∈ L, ∃ A : Fin r → MvPolynomial (Fin m) V, ∀ i α, (x i - ∑ j, A j * h j i).coeff α ∈ IsLocalRing.maximalIdeal V :=
by
  intro V _ _ m n L hgr
  classical
  let π : MvPolynomial (Fin m) V →+* MvPolynomial (Fin m) (IsLocalRing.ResidueField V) :=
    MvPolynomial.map (IsLocalRing.residue V)
  have hπs : Function.Surjective π := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
  let Φ : (Fin n → MvPolynomial (Fin m) V) → (Fin n → MvPolynomial (Fin m) (IsLocalRing.ResidueField V)) :=
    fun v i => π (v i)
  have hFG : (Submodule.span (MvPolynomial (Fin m) (IsLocalRing.ResidueField V))
      (Φ '' (L : Set (Fin n → MvPolynomial (Fin m) V)))).FG := IsNoetherian.noetherian _
  obtain ⟨t, ht, hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hFG
  obtain ⟨s', hs'L, hs't⟩ := Finset.subset_set_image_iff.mp ht
  let D : ℕ := s'.sup (fun v => Finset.univ.sup (fun i => (v i).totalDegree))
  have hD : ∀ v ∈ s', ∀ i, (v i).totalDegree ≤ D := fun v hv i =>
    le_trans (Finset.le_sup (f := fun i => (v i).totalDegree) (Finset.mem_univ i))
      (Finset.le_sup (f := fun v => Finset.univ.sup (fun i => (v i).totalDegree)) hv)
  let T := s' ×ˢ Finset.range (D + 1)
  let ε := T.equivFin
  refine ⟨T.card, fun j i => MvPolynomial.homogeneousComponent (ε.symm j).1.2 ((ε.symm j).1.1 i),
    fun j => (ε.symm j).1.2, ?_, ?_, ?_⟩
  · intro j
    exact hgr _ _ (hs'L (Finset.mem_product.mp (ε.symm j).2).1)
  · intro j i
    exact MvPolynomial.homogeneousComponent_isHomogeneous _ _
  · intro x hx
    have hlift : ∀ y ∈ Submodule.span (MvPolynomial (Fin m) (IsLocalRing.ResidueField V))
        (Φ '' (s' : Set (Fin n → MvPolynomial (Fin m) V))),
        ∃ w ∈ Submodule.span (MvPolynomial (Fin m) V) (s' : Set (Fin n → MvPolynomial (Fin m) V)),
          Φ w = y := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨v, hv, rfl⟩ := hy
        exact ⟨v, Submodule.subset_span hv, rfl⟩
      | zero => exact ⟨0, Submodule.zero_mem _, by funext i; simp [Φ]⟩
      | add y z _ _ hy hz =>
        obtain ⟨w, hw, rfl⟩ := hy
        obtain ⟨w', hw', rfl⟩ := hz
        exact ⟨w + w', Submodule.add_mem _ hw hw', by funext i; simp [Φ]⟩
      | smul c y _ hy =>
        obtain ⟨w, hw, rfl⟩ := hy
        obtain ⟨c', rfl⟩ := hπs c
        exact ⟨c' • w, Submodule.smul_mem _ _ hw, by funext i; simp [Φ]⟩
    have hΦx : Φ x ∈ Submodule.span (MvPolynomial (Fin m) (IsLocalRing.ResidueField V))
        (Φ '' (s' : Set (Fin n → MvPolynomial (Fin m) V))) := by
      rw [← Finset.coe_image, hs't, ← hspan]
      exact Submodule.subset_span ⟨x, hx, rfl⟩
    obtain ⟨w, hw, hwx⟩ := hlift _ hΦx
    obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp hw
    refine ⟨fun j => f (ε.symm j).1.1, ?_⟩
    intro i α
    have hsum : ∑ j, f (ε.symm j).1.1 *
        MvPolynomial.homogeneousComponent (ε.symm j).1.2 ((ε.symm j).1.1 i) = w i := by
      rw [Equiv.sum_comp ε.symm (fun p : T => f p.1.1 *
        MvPolynomial.homogeneousComponent p.1.2 (p.1.1 i))]
      rw [Finset.sum_coe_sort T (fun p => f p.1 * MvPolynomial.homogeneousComponent p.2 (p.1 i))]
      rw [Finset.sum_product, ← hf, Finset.sum_apply]
      refine Finset.sum_congr rfl (fun v hv => ?_)
      dsimp only
      rw [← Finset.mul_sum, Pi.smul_apply, smul_eq_mul]
      congr 1
      conv_rhs => rw [← MvPolynomial.sum_homogeneousComponent (v i)]
      symm
      apply Finset.sum_subset
      · intro e he
        rw [Finset.mem_range] at he ⊢
        have := hD v hv i
        omega
      · intro e _ he
        rw [Finset.mem_range, not_lt] at he
        exact MvPolynomial.homogeneousComponent_eq_zero _ _ (by omega)
    rw [hsum, ← IsLocalRing.residue_eq_zero_iff]
    have h1 : π (w i) = π (x i) := congrFun hwx i
    have h2 : IsLocalRing.residue V ((x i - w i).coeff α) = (π (x i - w i)).coeff α := by
      simp only [π, MvPolynomial.coeff_map]
    rw [h2, map_sub, h1, sub_self]
    simp

theorem wcpa_vrpc_graded_nakayama : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] (m n r : ℕ) (L : Submodule (MvPolynomial (Fin m) V) (Fin n → MvPolynomial (Fin m) V)) (h : Fin r → Fin n → MvPolynomial (Fin m) V) (a : Fin r → ℕ), (∀ (w : V) (v : Fin n → MvPolynomial (Fin m) V), w ≠ 0 → (MvPolynomial.C w : MvPolynomial (Fin m) V) • v ∈ L → v ∈ L) → (∀ j, h j ∈ L) → (∀ j i, (h j i).IsHomogeneous (a j)) → (∀ x ∈ L, ∃ A : Fin r → MvPolynomial (Fin m) V, ∀ i α, (x i - ∑ j, A j * h j i).coeff α ∈ IsLocalRing.maximalIdeal V) → ∀ (e : ℕ) (x : Fin n → MvPolynomial (Fin m) V), x ∈ L → (∀ i, (x i).IsHomogeneous e) → x ∈ Submodule.span (MvPolynomial (Fin m) V) (Set.range h) :=
by
  intro V _ _ _ m n r L h a hsat hmem hhom hres e x₀ hx₀L hx₀hom
  classical

  have s5 : ∀ (p q : MvPolynomial (Fin m) V) (b k : ℕ), q.IsHomogeneous b →
      MvPolynomial.homogeneousComponent k (p * q) =
        if b ≤ k then MvPolynomial.homogeneousComponent (k - b) p * q else 0 := by
    intro p q b k hq
    letI := MvPolynomial.gradedAlgebra (σ := Fin m) (R := V)
    have hq' : q ∈ MvPolynomial.homogeneousSubmodule (Fin m) V b :=
      (MvPolynomial.mem_homogeneousSubmodule b q).mpr hq
    have key := DirectSum.coe_decompose_mul_of_right_mem
      (MvPolynomial.homogeneousSubmodule (Fin m) V) k (a := p) hq'
    have hbr : ∀ (φ : MvPolynomial (Fin m) V) (i : ℕ),
        ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin m) V) φ i :
          MvPolynomial (Fin m) V)) = MvPolynomial.homogeneousComponent i φ := by
      intro φ i
      exact MvPolynomial.decomposition.decompose'_apply φ i
    rw [hbr, hbr] at key
    exact key

  have s1 : (Submodule.pi Set.univ
      (fun _ : Fin n => MvPolynomial.homogeneousSubmodule (Fin m) V e)).FG := by
    apply Submodule.fg_pi
    intro _
    rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported,
      AddMonoidAlgebra.supported_eq_span_single]
    apply Submodule.fg_span
    exact ((Finsupp.finite_of_degree_le e).subset
      (fun d (hd : Finsupp.degree d = e) => hd.le)).image _

  have s2 : ∀ (P N : Submodule V (Fin n → MvPolynomial (Fin m) V)), P.FG → N ≤ P →
      (∀ (w : V) (y : Fin n → MvPolynomial (Fin m) V), w ≠ 0 → y ∈ P → w • y ∈ N → y ∈ N) →
      N.FG := by
    intro P N hP hNP hN
    set N' : Submodule V P := Submodule.comap P.subtype N with hN'
    haveI : Module.Finite V P := Module.Finite.iff_fg.mpr hP
    haveI : Module.Finite V (P ⧸ N') := inferInstance
    have htor : Submodule.torsion V (P ⧸ N') = ⊥ := by
      rw [eq_bot_iff]
      intro q hq
      rw [Submodule.mem_torsion_iff] at hq
      obtain ⟨⟨c, hc⟩, hcq⟩ := hq
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective N' q
      rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
      have hc0 : c ≠ 0 := nonZeroDivisors.ne_zero hc
      have h1 : (c • y : P) ∈ N' := by
        rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_smul]
        exact hcq
      exact hN c (y : Fin n → MvPolynomial (Fin m) V) hc0 y.2 h1
    haveI : Module.Flat V (P ⧸ N') := Module.Flat.flat_iff_torsion_eq_bot_of_isBezout.mpr htor
    haveI : Module.Free V (P ⧸ N') := Module.free_of_flat_of_isLocalRing
    haveI : Module.FinitePresentation V (P ⧸ N') := Module.finitePresentation_of_projective V _
    have hfg : (LinearMap.ker N'.mkQ).FG :=
      Module.FinitePresentation.fg_ker N'.mkQ (Submodule.mkQ_surjective N')
    rw [Submodule.ker_mkQ] at hfg
    have hNe : N = Submodule.map P.subtype N' := by
      rw [hN', Submodule.map_comap_subtype, inf_eq_right.mpr hNP]
    rw [hNe]
    exact hfg.map _

  have s3 : ∀ z : Fin n → MvPolynomial (Fin m) V, z ≠ 0 → (∀ i, (z i).IsHomogeneous e) →
      (∀ i α, (z i).coeff α ∈ IsLocalRing.maximalIdeal V) →
      ∃ (c : V) (y : Fin n → MvPolynomial (Fin m) V), c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal V ∧
        (∀ i, (y i).IsHomogeneous e) ∧ ∀ i, z i = MvPolynomial.C c * y i := by
    intro z hz hzh hzm
    set T : Finset V := Finset.univ.biUnion
      (fun i => (z i).support.image (fun α => (z i).coeff α)) with hT
    have hTne : T.Nonempty := by
      obtain ⟨i, hi⟩ : ∃ i, z i ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        exact hz (funext hcon)
      obtain ⟨α, hα⟩ := MvPolynomial.ne_zero_iff.mp hi
      exact ⟨(z i).coeff α, Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _,
        Finset.mem_image.mpr ⟨α, MvPolynomial.mem_support_iff.mpr hα, rfl⟩⟩⟩
    have hmin : ∀ S : Finset V, S.Nonempty → ∃ c ∈ S, ∀ t ∈ S, c ∣ t := by
      intro S
      induction S using Finset.induction_on with
      | empty => intro h0; exact absurd h0 Finset.not_nonempty_empty
      | insert a0 s has ih =>
        intro _
        by_cases hs : s.Nonempty
        · obtain ⟨c, hc, hcs⟩ := ih hs
          rcases ValuationRing.dvd_total a0 c with hac | hca
          · refine ⟨a0, Finset.mem_insert_self a0 s, fun t ht => ?_⟩
            rcases Finset.mem_insert.mp ht with rfl | ht
            · exact dvd_rfl
            · exact dvd_trans hac (hcs t ht)
          · refine ⟨c, Finset.mem_insert_of_mem hc, fun t ht => ?_⟩
            rcases Finset.mem_insert.mp ht with rfl | ht
            · exact hca
            · exact hcs t ht
        · rw [Finset.not_nonempty_iff_eq_empty] at hs
          subst hs
          refine ⟨a0, Finset.mem_insert_self a0 ∅, fun t ht => ?_⟩
          rw [Finset.mem_insert] at ht
          rcases ht with rfl | ht
          · exact dvd_rfl
          · simp at ht
    obtain ⟨c, hcT, hcdvd⟩ := hmin T hTne
    obtain ⟨i₀, -, hi₀⟩ := Finset.mem_biUnion.mp hcT
    obtain ⟨α₀, hα₀, hcα⟩ := Finset.mem_image.mp hi₀
    have hc0 : c ≠ 0 := by rw [← hcα]; exact MvPolynomial.mem_support_iff.mp hα₀
    have hcm : c ∈ IsLocalRing.maximalIdeal V := by rw [← hcα]; exact hzm i₀ α₀
    have hdiv : ∀ i, MvPolynomial.C c ∣ z i := by
      intro i
      rw [MvPolynomial.C_dvd_iff_dvd_coeff]
      intro α
      by_cases hα : α ∈ (z i).support
      · exact hcdvd _ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _,
          Finset.mem_image.mpr ⟨α, hα, rfl⟩⟩)
      · rw [MvPolynomial.notMem_support_iff.mp hα]; exact dvd_zero c
    choose y hy using hdiv
    refine ⟨c, y, hc0, hcm, fun i => ?_, hy⟩
    intro α hα
    apply hzh i
    rw [hy i, MvPolynomial.coeff_C_mul]
    exact mul_ne_zero hc0 hα

  have hbridge : ∀ (w : V) (y : Fin n → MvPolynomial (Fin m) V),
      (MvPolynomial.C w : MvPolynomial (Fin m) V) • y = w • y := by
    intro w y
    funext i
    rw [Pi.smul_apply, Pi.smul_apply, smul_eq_mul, MvPolynomial.smul_eq_C_mul]
  obtain ⟨Me, hMe⟩ : ∃ Me : Submodule V (Fin n → MvPolynomial (Fin m) V),
      Me = Submodule.pi Set.univ
        (fun _ : Fin n => MvPolynomial.homogeneousSubmodule (Fin m) V e) := ⟨_, rfl⟩
  obtain ⟨Le, hLe⟩ : ∃ Le : Submodule V (Fin n → MvPolynomial (Fin m) V),
      Le = L.restrictScalars V ⊓ Me := ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : Submodule V (Fin n → MvPolynomial (Fin m) V),
      N = (Submodule.span (MvPolynomial (Fin m) V) (Set.range h)).restrictScalars V := ⟨_, rfl⟩
  have hmemMe : ∀ y, y ∈ Me ↔ ∀ i, (y i).IsHomogeneous e := by
    intro y
    rw [hMe, Submodule.mem_pi]
    simp only [Set.mem_univ, true_implies, MvPolynomial.mem_homogeneousSubmodule]
  have hmemLe : ∀ y, y ∈ Le ↔ y ∈ L ∧ ∀ i, (y i).IsHomogeneous e := by
    intro y
    rw [hLe, Submodule.mem_inf, Submodule.restrictScalars_mem, hmemMe]
  have hmemN : ∀ y, y ∈ N ↔ y ∈ Submodule.span (MvPolynomial (Fin m) V) (Set.range h) := by
    intro y
    rw [hN, Submodule.restrictScalars_mem]
  have hspanL : Submodule.span (MvPolynomial (Fin m) V) (Set.range h) ≤ L := by
    rw [Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact hmem j
  have hLeFG : Le.FG := by
    refine s2 Me Le (hMe ▸ s1) (by rw [hLe]; exact inf_le_right) ?_
    intro w y hw hyP hyN
    rw [hmemLe] at hyN ⊢
    refine ⟨hsat w y hw ?_, (hmemMe y).mp hyP⟩
    rw [hbridge]
    exact hyN.1
  have hstep : Le ≤ N ⊔ IsLocalRing.maximalIdeal V • Le := by
    intro x hx
    rw [hmemLe] at hx
    obtain ⟨hxL, hxh⟩ := hx
    obtain ⟨A, hA⟩ := hres x hxL
    obtain ⟨B, hB⟩ : ∃ B : Fin r → MvPolynomial (Fin m) V, ∀ j,
        B j = if a j ≤ e then MvPolynomial.homogeneousComponent (e - a j) (A j) else 0 :=
      ⟨_, fun j => rfl⟩
    obtain ⟨y, hydef⟩ : ∃ y : Fin n → MvPolynomial (Fin m) V, y = ∑ j, B j • h j := ⟨_, rfl⟩
    have hyspan : y ∈ Submodule.span (MvPolynomial (Fin m) V) (Set.range h) := by
      rw [hydef]
      exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
    have hyL : y ∈ L := hspanL hyspan
    have hyN : y ∈ N := (hmemN y).mpr hyspan
    have hz : ∀ i, (x - y) i =
        MvPolynomial.homogeneousComponent e (x i - ∑ j, A j * h j i) := by
      intro i
      have e1 : (x - y) i = x i - ∑ j, B j * h j i := by
        rw [hydef]
        simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      have e2 : MvPolynomial.homogeneousComponent e (x i) = x i := by
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule e (x i)).mpr (hxh i)), if_pos rfl]
      rw [e1, map_sub, map_sum, e2]
      congr 1
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [s5 (A j) (h j i) (a j) e (hhom j i), hB j]
      split_ifs <;> simp
    have hzL : x - y ∈ L := L.sub_mem hxL hyL
    have hzh : ∀ i, ((x - y) i).IsHomogeneous e := fun i => by
      rw [hz i]; exact MvPolynomial.homogeneousComponent_isHomogeneous e _
    have hzm : ∀ i α, ((x - y) i).coeff α ∈ IsLocalRing.maximalIdeal V := by
      intro i α
      rw [hz i, MvPolynomial.coeff_homogeneousComponent]
      split_ifs
      · exact hA i α
      · exact Ideal.zero_mem _
    have hxyz : x = y + (x - y) := (add_sub_cancel y x).symm
    by_cases hz0 : x - y = 0
    · rw [sub_eq_zero] at hz0
      rw [hz0]
      exact Submodule.mem_sup_left hyN
    · obtain ⟨c, y', hc0, hcm, hy'h, hy'⟩ := s3 (x - y) hz0 hzh hzm
      have hzc : x - y = c • y' := by
        funext i
        rw [hy' i, Pi.smul_apply, MvPolynomial.smul_eq_C_mul]
      have hy'L : y' ∈ L := hsat c y' hc0 (by rw [hbridge, ← hzc]; exact hzL)
      have hy'Le : y' ∈ Le := (hmemLe y').mpr ⟨hy'L, hy'h⟩
      rw [hxyz, hzc]
      exact Submodule.add_mem_sup hyN (Submodule.smul_mem_smul hcm hy'Le)
  have hJ : IsLocalRing.maximalIdeal V ≤ (⊥ : Ideal V).jacobson :=
    IsLocalRing.maximalIdeal_le_jacobson ⊥
  have hLeN : Le ≤ N := Submodule.le_of_le_smul_of_le_jacobson_bot hLeFG hJ hstep
  have hx₀ : x₀ ∈ Le := (hmemLe x₀).mpr ⟨hx₀L, hx₀hom⟩
  exact (hmemN x₀).mp (hLeN hx₀)

theorem wcpa_dj_lr1s_nf_cnf_fmp_tf_vr_poly_coherent : ∀ (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] (d n : ℕ) (K : Submodule (MvPolynomial (Fin d) V) (Fin n → MvPolynomial (Fin d) V)), (∀ (w : V) (v : Fin n → MvPolynomial (Fin d) V), w ≠ 0 → (MvPolynomial.C w : MvPolynomial (Fin d) V) • v ∈ K → v ∈ K) → K.FG :=
by
  intro V _ _ _ d n K hK
  obtain ⟨Kh, hsat, hgr, hdeh, hsurj⟩ := wcpa_vrpc_homogenize_submodule V d n K hK
  obtain ⟨r, h, a, hmem, hhom, hres⟩ := wcpa_vrpc_residue_generators V (d + 1) n Kh hgr

  have hspan : ∀ x ∈ Kh, x ∈ Submodule.span (MvPolynomial (Fin (d + 1)) V) (Set.range h) := by
    intro x hx
    obtain ⟨D, hD⟩ := wcpa_vrpc_vec_hc_decomp V (d + 1) n x
    rw [hD D le_rfl]
    refine Submodule.sum_mem _ (fun e _ => ?_)
    exact wcpa_vrpc_graded_nakayama V (d + 1) n r Kh h a hsat hmem hhom hres e _ (hgr x e hx)
      (fun i => MvPolynomial.homogeneousComponent_isHomogeneous e (x i))

  let deh : MvPolynomial (Fin (d + 1)) V →ₐ[V] MvPolynomial (Fin d) V :=
    MvPolynomial.aeval (Fin.cons 1 MvPolynomial.X : Fin (d + 1) → MvPolynomial (Fin d) V)
  let g : Fin r → Fin n → MvPolynomial (Fin d) V := fun j i => deh (h j i)
  have hKeq : K = Submodule.span (MvPolynomial (Fin d) V) (Set.range g) := by
    apply le_antisymm
    · intro u hu
      obtain ⟨v, hv, hvu⟩ := hsurj u hu
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp (hspan v hv)
      rw [Submodule.mem_span_range_iff_exists_fun]
      refine ⟨fun j => deh (c j), ?_⟩
      rw [← hvu, ← hc]
      funext i
      simp only [g, deh, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, map_sum, map_mul]
    · rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      exact hdeh (h j) (hmem j)
  rw [hKeq]
  exact Submodule.fg_span (Set.finite_range g)

theorem wcpa_dj_lr1s_nf_cnf_fmp_tf_modlift : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (ϖ' : R) (c r : ℕ), (∀ (x : R) (y : T), algebraMap R T x = algebraMap R T ϖ' ^ (c + 1) * y → ∃ x' : R, x = ϖ' ^ (c + 1) * x') → (∀ y : T, ∃ (x : R) (y' : T), y = algebraMap R T x + algebraMap R T ϖ' ^ (c + 1) * y') → (∀ (n : ℕ) (φ : (Fin n → R) →ₗ[R] (Fin r → R)), (LinearMap.ker φ).FG) → ∀ (k : ℕ) (nv : Fin k → (Fin r → T)), ∃ (q : ℕ) (y : Fin q → (Fin r → T)), (∀ j, algebraMap R T ϖ' ^ c • y j ∈ Submodule.span T (Set.range nv)) ∧ ∀ x : Fin r → T, algebraMap R T ϖ' ^ c • x ∈ Submodule.span T (Set.range nv) → ∃ (a : Fin q → T) (z : Fin r → T), x = ∑ j, a j • y j + algebraMap R T ϖ' • z :=
by
  intro R T _ _ _ ϖ' c r H1 H2 H3 k nv
  classical
  set t := algebraMap R T ϖ' with ht

  have V2 : ∀ y : Fin r → T, ∃ (x : Fin r → R) (y'' : Fin r → T),
      ∀ l, y l = algebraMap R T (x l) + t ^ (c + 1) * y'' l := by
    intro y
    choose x y'' h using fun l => H2 (y l)
    exact ⟨x, y'', h⟩

  have V1 : ∀ (x : Fin r → R) (y : Fin r → T), (∀ l, algebraMap R T (x l) = t ^ (c + 1) * y l) →
      ∃ x' : Fin r → R, ∀ l, x l = ϖ' ^ (c + 1) * x' l := by
    intro x y h
    choose x' hx' using fun l => H1 (x l) (y l) (h l)
    exact ⟨x', hx'⟩
  choose p n'' hpn using fun i => V2 (nv i)

  let L1 : (Fin (r + (k + r)) → R) →ₗ[R] (Fin r → R) :=
    LinearMap.funLeft R R (Fin.castAdd (k + r))
  let L3 : (Fin (r + (k + r)) → R) →ₗ[R] (Fin r → R) :=
    LinearMap.funLeft R R (fun l : Fin r => Fin.natAdd r (Fin.natAdd k l))
  let φ : (Fin (r + (k + r)) → R) →ₗ[R] (Fin r → R) :=
    ϖ' ^ c • L1 - ∑ i, (LinearMap.proj (R := R) (φ := fun _ : Fin (r + (k + r)) => R)
      (Fin.natAdd r (Fin.castAdd r i))).smulRight (p i) - ϖ' ^ (c + 1) • L3
  have hφ : ∀ u l, φ u l = ϖ' ^ c * u (Fin.castAdd (k + r) l)
      - ∑ i, u (Fin.natAdd r (Fin.castAdd r i)) * p i l
      - ϖ' ^ (c + 1) * u (Fin.natAdd r (Fin.natAdd k l)) := by
    intro u l
    simp [φ, L1, L3, LinearMap.sum_apply, Finset.sum_apply, LinearMap.funLeft_apply]
  obtain ⟨q, v, hv⟩ := Submodule.fg_iff_exists_fin_generating_family.mp ((H3 _ φ).map L1)
  have hvK : ∀ j, v j ∈ Submodule.map L1 (LinearMap.ker φ) := fun j => by
    rw [← hv]; exact Submodule.subset_span ⟨j, rfl⟩
  choose u hu hLu using fun j => Submodule.mem_map.mp (hvK j)
  have hvu : ∀ j l, v j l = u j (Fin.castAdd (k + r) l) := by
    intro j l
    rw [← hLu j]
    rfl

  have hrel : ∀ j l, t ^ c * algebraMap R T (v j l)
      = ∑ i, algebraMap R T (u j (Fin.natAdd r (Fin.castAdd r i))) * algebraMap R T (p i l)
        + t ^ (c + 1) * algebraMap R T (u j (Fin.natAdd r (Fin.natAdd k l))) := by
    intro j l
    have h0 : φ (u j) l = 0 := by
      have := LinearMap.mem_ker.mp (hu j)
      rw [this]; rfl
    rw [hφ] at h0
    have h1 := congrArg (algebraMap R T) h0
    simp only [map_sub, map_mul, map_pow, map_sum, map_zero] at h1
    rw [hvu, ht]
    linear_combination h1

  have hK : ∀ (v₀ : Fin r → R) (α : Fin k → R) (β₀ : Fin r → R),
      (∀ l, ϖ' ^ c * v₀ l = ∑ i, α i * p i l + ϖ' ^ (c + 1) * β₀ l) →
      ∃ b : Fin q → R, ∀ l, v₀ l = ∑ j, b j * v j l := by
    intro v₀ α β₀ h
    have hmem : v₀ ∈ Submodule.map L1 (LinearMap.ker φ) := by
      refine Submodule.mem_map.mpr ⟨Fin.append v₀ (Fin.append α β₀), ?_, ?_⟩
      · rw [LinearMap.mem_ker]
        funext l
        rw [hφ]
        simp only [Fin.append_left, Fin.append_right, Pi.zero_apply]
        rw [h l]
        ring
      · funext l
        show Fin.append v₀ (Fin.append α β₀) (Fin.castAdd (k + r) l) = v₀ l
        rw [Fin.append_left]
    rw [← hv] at hmem
    obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hmem
    refine ⟨b, fun l => ?_⟩
    rw [← hb]
    simp [Finset.sum_apply]

  let w : Fin q → Fin r → T := fun j l => algebraMap R T (u j (Fin.natAdd r (Fin.natAdd k l)))
      - ∑ i, algebraMap R T (u j (Fin.natAdd r (Fin.castAdd r i))) * n'' i l
  refine ⟨q, fun j l => algebraMap R T (v j l) - t * w j l, ?_, ?_⟩
  · intro j
    have heq : t ^ c • (fun l => algebraMap R T (v j l) - t * w j l)
        = ∑ i, algebraMap R T (u j (Fin.natAdd r (Fin.castAdd r i))) • nv i := by
      funext l
      simp only [Pi.smul_apply, smul_eq_mul, Finset.sum_apply]
      have hs : ∑ i, algebraMap R T (u j (Fin.natAdd r (Fin.castAdd r i))) * nv i l
          = ∑ i, algebraMap R T (u j (Fin.natAdd r (Fin.castAdd r i))) * algebraMap R T (p i l)
            + t ^ (c + 1) * ∑ i, algebraMap R T (u j (Fin.natAdd r (Fin.castAdd r i))) * n'' i l := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun i _ => by rw [hpn i l]; ring)
      rw [hs]
      simp only [w]
      linear_combination hrel j l
    rw [heq]
    exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
  · intro x hx
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun T).mp hx
    have hal : ∀ l, ∑ i, a i * nv i l = t ^ c * x l := by
      intro l
      have := congrFun ha l
      simpa [Finset.sum_apply] using this
    choose α a'' hα using fun i => H2 (a i)
    obtain ⟨v₀, x'', hx0⟩ := V2 x
    obtain ⟨β₀, hβ₀⟩ := V1 (fun l => ϖ' ^ c * v₀ l - ∑ i, α i * p i l)
      (fun l => ∑ i, (algebraMap R T (α i) * n'' i l + a'' i * algebraMap R T (p i l)
        + t ^ (c + 1) * a'' i * n'' i l) - t ^ c * x'' l) (by
      intro l
      simp only [map_sub, map_mul, map_pow, map_sum]
      have key : ∑ i, a i * nv i l = ∑ i, algebraMap R T (α i) * algebraMap R T (p i l)
          + t ^ (c + 1) * ∑ i, (algebraMap R T (α i) * n'' i l + a'' i * algebraMap R T (p i l)
            + t ^ (c + 1) * a'' i * n'' i l) := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun i _ => by rw [hα i, hpn i l]; ring)
      rw [← ht]
      linear_combination key - hal l - t ^ c * hx0 l)
    obtain ⟨b, hb⟩ := hK v₀ α β₀ (fun l => by
      have := hβ₀ l
      linear_combination this)
    refine ⟨fun j => algebraMap R T (b j), fun l => ∑ j, algebraMap R T (b j) * w j l + t ^ c * x'' l, ?_⟩
    funext l
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_apply]
    have hv0 : algebraMap R T (v₀ l) = ∑ j, algebraMap R T (b j) * algebraMap R T (v j l) := by
      rw [hb l, map_sum]
      simp only [map_mul]
    have hsplit : ∑ j, algebraMap R T (b j) * (algebraMap R T (v j l) - t * w j l)
        = ∑ j, algebraMap R T (b j) * algebraMap R T (v j l)
          - t * ∑ j, algebraMap R T (b j) * w j l := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    rw [hsplit, hx0 l, hv0]
    ring

theorem wcpa_dj_lr1s_nf_cnf_fmp_tf_adic_lift : ∀ (T : Type u) [CommRing T] (t : T), (∀ f : ℕ → T, (∀ n : ℕ, ∃ y : T, f (n + 1) - f n = t ^ n * y) → ∃ L : T, ∀ n : ℕ, ∃ y : T, L - f n = t ^ n * y) → (∀ x : T, (∀ k : ℕ, ∃ y : T, x = t ^ k * y) → x = 0) → ∀ (r q : ℕ) (N : Submodule T (Fin r → T)) (y : Fin q → (Fin r → T)), (∀ x : Fin r → T, t • x ∈ N → x ∈ N) → (∀ j, y j ∈ N) → (∀ x ∈ N, ∃ (a : Fin q → T) (z : Fin r → T), x = ∑ j, a j • y j + t • z) → N = Submodule.span T (Set.range y) :=
by
  intro T _ t H1 H2 r q N y hS hY hG
  classical
  have step : ∀ w : N, ∃ (a : Fin q → T) (w' : N),
      (w : Fin r → T) = ∑ j, a j • y j + t • (w' : Fin r → T) := by
    intro w
    obtain ⟨a, z, hz⟩ := hG w w.2
    have hz' : t • z ∈ N := by
      have e : t • z = (w : Fin r → T) - ∑ j, a j • y j := by rw [hz]; abel
      rw [e]
      exact N.sub_mem w.2 (N.sum_mem fun j _ => N.smul_mem _ (hY j))
    exact ⟨a, ⟨z, hS z hz'⟩, hz⟩
  choose A Z hAZ using step
  apply le_antisymm
  · intro x hx
    let seq : ℕ → N := fun m => Z^[m] ⟨x, hx⟩
    let f : Fin q → ℕ → T := fun j m => ∑ n ∈ Finset.range m, t ^ n * A (seq n) j
    have e : ∀ j m, f j (m + 1) = f j m + t ^ m * A (seq m) j := fun j m => by
      simp only [f, Finset.sum_range_succ]
    have hinv : ∀ m, x = ∑ j, f j m • y j + t ^ m • (seq m : Fin r → T) := by
      intro m
      induction m with
      | zero => simp [f, seq]
      | succ m ih =>
        have h1 := hAZ (seq m)
        have hs : seq (m + 1) = Z (seq m) := Function.iterate_succ_apply' Z m _
        rw [hs]
        calc x = ∑ j, f j m • y j + t ^ m • (seq m : Fin r → T) := ih
          _ = ∑ j, f j m • y j + t ^ m • (∑ j, A (seq m) j • y j
                + t • (Z (seq m) : Fin r → T)) := by rw [← h1]
          _ = _ := by
            rw [smul_add, Finset.smul_sum, ← add_assoc, ← Finset.sum_add_distrib, pow_succ,
              mul_smul]
            congr 1
            apply Finset.sum_congr rfl
            intro j _
            rw [e j m, add_smul, smul_smul]
    have hcau : ∀ j, ∀ n, ∃ c, f j (n + 1) - f j n = t ^ n * c :=
      fun j n => ⟨A (seq n) j, by rw [e j n]; ring⟩
    choose L hL using fun j => H1 (f j) (hcau j)
    choose u hu using hL
    have hxL : x = ∑ j, L j • y j := by
      funext i
      apply sub_eq_zero.mp
      apply H2
      intro k
      refine ⟨(seq k : Fin r → T) i - ∑ j, u j k * y j i, ?_⟩
      have hk := congrFun (hinv k) i
      simp only [Finset.sum_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at hk ⊢
      have hLj : ∀ j, L j * y j i = f j k * y j i + t ^ k * (u j k * y j i) := fun j => by
        rw [show L j = f j k + t ^ k * u j k by rw [← hu j k]; ring]; ring
      rw [Finset.sum_congr rfl (fun j _ => hLj j), Finset.sum_add_distrib, mul_sub,
        Finset.mul_sum]
      linear_combination hk
    rw [hxL]
    exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  · exact Submodule.span_le.mpr (Set.range_subset_iff.mpr hY)

theorem wcpa_dj_lr1s_nf_cnf_fmp_torsionfree_fp : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) (M : Type u) [AddCommGroup M] [Module (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) M], Module.Finite (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) M → (∀ m : M, (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ)) • m = 0 → m = 0) → Module.FinitePresentation (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) M :=
