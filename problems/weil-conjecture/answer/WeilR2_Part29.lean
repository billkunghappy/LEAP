  ·
    show h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
      (MvPolynomial.X 0)) ∈ _
    rw [hnat, hθX, mem_nonZeroDivisors_iff_right]
    intro y hy
    have h1 := congrArg (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom hy
    rw [map_mul, hδγ, map_zero] at h1
    have h2 := hAnzd _ h1
    rw [← hγδ y, h2, map_zero]
