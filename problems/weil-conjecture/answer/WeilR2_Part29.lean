    rw [LinearMap.map_smul] at hx
    exact htM _ hx
  have hsatk : ∀ (k : ℕ) (x : Fin r → AdicCompletion (Ideal.span
      {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)),
      algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span
        {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W))
        (MvPolynomial.C ϖ) ^ k • x ∈ LinearMap.ker f → x ∈ LinearMap.ker f := by
    intro k
    induction k with
    | zero => intro x hx; simpa using hx
    | succ k ih => intro x hx; rw [pow_succ, mul_smul] at hx; exact hsat x (ih _ hx)

  have hL := wcpa_dj_lr1s_nf_cnf_fmp_tate_noetherian Ω W hW ϖ hϖ0 hϖnu d
  obtain ⟨N', hN'fg, hN'le, hN'sat⟩ := wcpa_dj_lr1s_nf_cnf_fmp_tf_saturation_fg _ _ hL r
    (LinearMap.ker f)
  obtain ⟨k, nv, hnv⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hN'fg

  obtain ⟨c, hc⟩ := wcpa_dj_lr1s_nf_cnf_bd_bounded_torsion Ω W hW ϖ hϖ0 hϖnu d
    ((Fin r → AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
      (MvPolynomial (Fin d) ↥W)) ⧸ N') inferInstance
  have hNc : ∀ x ∈ LinearMap.ker f, algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) ^ c • x ∈ N' := by
    intro x hx
    obtain ⟨k', hk'⟩ := hN'sat x hx
    have h1 := hc (Submodule.Quotient.mk x) ⟨k', by
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]; exact hk'⟩
    rwa [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at h1

  have hCϖ : (MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W) ≠ 0 := by
    rw [Ne, MvPolynomial.C_eq_zero]; exact hϖ0
  have hRdom : ∀ x : MvPolynomial (Fin d) ↥W, MvPolynomial.C ϖ * x = 0 → x = 0 := by
    intro x hx
    exact (mul_eq_zero.mp hx).resolve_left hCϖ
  obtain ⟨_, hii, hiii⟩ := wcpa_dj_lr1s_nf_adic_completion_basics (MvPolynomial (Fin d) ↥W)
    (MvPolynomial.C ϖ) hRdom
  have hker : ∀ (n : ℕ) (φ : (Fin n → MvPolynomial (Fin d) ↥W) →ₗ[MvPolynomial (Fin d) ↥W]
      (Fin r → MvPolynomial (Fin d) ↥W)), (LinearMap.ker φ).FG := by
    intro n φ
    apply wcpa_dj_lr1s_nf_cnf_fmp_tf_vr_poly_coherent ↥W d n
    intro w v hw hv
    rw [LinearMap.mem_ker] at hv ⊢
    rw [LinearMap.map_smul] at hv
    have hCw : (MvPolynomial.C w : MvPolynomial (Fin d) ↥W) ≠ 0 := by
      rw [Ne, MvPolynomial.C_eq_zero]; exact hw
    funext j
    have h2 := congrFun hv j
    simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at h2
    exact (mul_eq_zero.mp h2).resolve_left hCw

  obtain ⟨q, y, hy1, hy2⟩ := wcpa_dj_lr1s_nf_cnf_fmp_tf_modlift (MvPolynomial (Fin d) ↥W)
    (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
      (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) c r (hii (c + 1)) (hiii (c + 1)) hker k nv

  have hS := wcpa_dj_lr1s_nf_cnf_adic_series (MvPolynomial (Fin d) ↥W) (MvPolynomial.C ϖ)
  have hNeq := wcpa_dj_lr1s_nf_cnf_fmp_tf_adic_lift _ _ hS.1 hS.2 r q (LinearMap.ker f) y hsat
    (fun j => hsatk c _ (hN'le (by rw [← hnv]; exact hy1 j)))
    (fun x hx => hy2 x (by rw [hnv]; exact hNc x hx))
  exact Module.finitePresentation_of_surjective f hf
