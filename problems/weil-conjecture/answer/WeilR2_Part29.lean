theorem wcpa_dj_mscm_chart_data_c : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W), c ≠ 0 → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (U : Fin 2 → M'.Opens) (t : ∀ l : Fin 2, Fin 2 → Γ(M', U l)), wcBpChartHyp r₀ ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)] U t → ∃ (h : Spec (.of (MvPolynomial (Fin 1) ↥W)) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (τ : Fin 2 → Γ(Spec (.of (MvPolynomial (Fin 1) ↥W)), ⊤)) (ρ₀ ρc : Spec (.of ↥W) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))), h ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) ∧ (∀ j, h.appTop.hom (![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)] j) = τ j * h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c))) ∧ h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) ∈ nonZeroDivisors Γ(Spec (.of (MvPolynomial (Fin 1) ↥W)), ⊤) ∧ (∀ s : Γ(Spec (.of (MvPolynomial (Fin 1) ↥W)), ⊤), s ∈ Subring.closure (Set.range h.appTop.hom ∪ Set.range τ)) ∧ (∃ φ : Γ(Spec (.of (MvPolynomial (Fin 1) ↥W)), ⊤) →+* Γ(M', U 1), φ.comp h.appTop.hom = (r₀.appLE ⊤ (U 1) (by simp)).hom ∧ ∀ j, φ (τ j) = t 1 j) ∧ ρ₀ ≫ h = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) ∧ ρc ≫ h = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c))) ∧ ρ₀ (IsLocalRing.closedPoint ↥W) ≠ ρc (IsLocalRing.closedPoint ↥W) :=
by
  intro Ω _ W c hc M' r₀ U t hU
  classical
  obtain ⟨H1, H2, H3, H4, H5, H6⟩ := hU
  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have key : ∀ (f : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 1) ↥W)
      (z : MvPolynomial (Fin 1) ↥W),
      (Spec.map (CommRingCat.ofHom f)).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom z) =
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (f z) :=
    fun f z => (congrArg (fun φ => φ.hom z)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom f))).symm
  obtain ⟨θ, hθC, hθX⟩ : ∃ θ : MvPolynomial (Fin 1) ↥W →+* MvPolynomial (Fin 1) ↥W,
      (∀ a, θ (MvPolynomial.C a) = MvPolynomial.C a) ∧
        θ (MvPolynomial.X 0) = MvPolynomial.C c * MvPolynomial.X 0 :=
    ⟨MvPolynomial.eval₂Hom MvPolynomial.C (fun _ : Fin 1 => MvPolynomial.C c * MvPolynomial.X 0),
      fun a => MvPolynomial.eval₂Hom_C _ _ _, by rw [MvPolynomial.eval₂Hom_X']⟩
  have hγne : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c) ≠ 0 := by
    intro h0
    apply hc
    have := congrArg (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom h0
    rw [hinvhom, map_zero] at this
    exact MvPolynomial.C_injective (Fin 1) ↥W (by rw [this, map_zero])
  have ht11 : t 1 1 = 1 := by
    have h311 : (r₀.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) =
        t 1 1 * (r₀.appLE ⊤ (U 1) (by simp)).hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) :=
      H3 1 1
    have h4 : (r₀.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) ∈
        nonZeroDivisors Γ(M', U 1) := H4 1
    have h5 : (t 1 1 - 1) * (r₀.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) = 0 := by
      rw [sub_mul, one_mul, ← h311, sub_self]
    exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff h4).mp h5)
  have h310 : (r₀.appLE ⊤ (U 1) (by simp)).hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
      t 1 0 * (r₀.appLE ⊤ (U 1) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) :=
    H3 1 0
  have hΦθ : (MvPolynomial.eval₂Hom ((r₀.appLE ⊤ (U 1) (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C))
      (fun _ => t 1 0)).comp θ =
      (r₀.appLE ⊤ (U 1) (by simp)).hom.comp
        (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      rw [RingHom.comp_apply, RingHom.comp_apply, hθC, MvPolynomial.eval₂Hom_C]
      rfl
    · intro i
      obtain rfl := Fin.fin_one_eq_zero i
      rw [RingHom.comp_apply, RingHom.comp_apply, hθX, map_mul, MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval₂Hom_X', h310, mul_comm]
      rfl
  have e0 : (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))).comp θ =
      MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [hθC]
    · intro i
      obtain rfl := Fin.fin_one_eq_zero i
      simp [hθX]
  have e1 : (MvPolynomial.eval (fun _ : Fin 1 => (1 : ↥W))).comp θ =
      MvPolynomial.eval (fun _ : Fin 1 => c) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [hθC]
    · intro i
      obtain rfl := Fin.fin_one_eq_zero i
      simp [hθX]
  have eC : θ.comp (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W) = MvPolynomial.C :=
    RingHom.ext hθC
  refine ⟨Spec.map (CommRingCat.ofHom θ),
    ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), 1],
    Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))),
    Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (1 : ↥W)))),
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, eC]
  ·
    intro j
    fin_cases j
    · show (Spec.map (CommRingCat.ofHom θ)).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
        (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0) *
          (Spec.map (CommRingCat.ofHom θ)).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c))
      rw [key, key, hθX, hθC, map_mul, mul_comm]
    · show (Spec.map (CommRingCat.ofHom θ)).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) =
        1 * (Spec.map (CommRingCat.ofHom θ)).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c))
      rw [one_mul]
  ·
    rw [key, hθC]
    exact mem_nonZeroDivisors_of_ne_zero hγne
  ·
    intro s
    obtain ⟨p, rfl⟩ : ∃ p, (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p = s :=
      ⟨_, hhominv _ s⟩
    induction p using MvPolynomial.induction_on with
    | C a =>
      apply Subring.subset_closure
      left
      exact ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C a),
        by rw [key, hθC]⟩
    | add p q hp hq =>
