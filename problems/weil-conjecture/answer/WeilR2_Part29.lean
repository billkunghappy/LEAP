      rw [e0, e2, hτσ]
      exact (one_mul _).symm
    have h1 : (wcNcSec W x₀ (x₀ * q)).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 1) =
        τσ 1 * (wcNcSec W x₀ (x₀ * q)).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) := by
      rw [e1, e2, hτσ]
      show (Scheme.ΓSpecIso (.of ↥W)).inv.hom (x₀ * q) =
        (Scheme.ΓSpecIso (.of ↥W)).inv.hom q * (Scheme.ΓSpecIso (.of ↥W)).inv.hom x₀
      rw [map_mul, mul_comm]
    have h2 : (wcNcSec W x₀ (x₀ * q)).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) =
        τσ 2 * (wcNcSec W x₀ (x₀ * q)).appTop.hom (wcNcmbGen W (x₀ * (x₀ * q)) x₀ 2) := by
      rw [hτσ]
      exact (one_mul _).symm
    have hne : (Scheme.ΓSpecIso (.of ↥W)).inv.hom x₀ ≠ 0 := by
      intro h
      apply hx0
      have := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom h
      simpa using this
    have hInv : wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop
        (Ideal.span (Set.range (wcNcmbGen W (x₀ * (x₀ * q)) x₀)))) (wcNcSec W x₀ (x₀ * q)) := by
      refine wcpa_dj_ncmb_invpull_affine (wcNcmbGen W (x₀ * (x₀ * q)) x₀)
        (wcNcSec W x₀ (x₀ * q)) 2 τσ ?_ ?_
      · intro j
        fin_cases j
        · exact h0
        · exact h1
        · exact h2
      · rw [e2]
        exact mem_nonZeroDivisors_of_ne_zero hne
    have hρc : (ρ ≫ c₂) ≫ r₀ = wcNcSec W x₀ (x₀ * q) := by
      rw [Category.assoc, hc₂r, hρ]
    have hσeq : σ' = ρ ≫ c₂ := (hr₀.2 _ _ hInv).unique hσ' hρc
    have hsm := wcpa_dj_ncmb_basicOpen_smooth (↥W) q 0
    have hsm' : ∃ V : (Spec (.of (wcNcRing W q))).Opens, ρ (IsLocalRing.closedPoint ↥W) ∈ V ∧
        SmoothOfRelativeDimension 1 (V.ι ≫ c₂ ≫ r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) := by
      refine ⟨_, hρmem, ?_⟩
      rw [hg₂]
      exact hsm
    obtain ⟨V, hV, hVs⟩ := (wcpa_dj_nc_smooth_etale_transfer _ M' _ c₂
      (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) (ρ (IsLocalRing.closedPoint ↥W)) inferInstance).mpr hsm'
    refine ⟨V, ?_, hVs⟩
    rw [hσeq]
    show c₂ (ρ (IsLocalRing.closedPoint ↥W)) ∈ V
    exact hV

theorem wcpa_dj_nc_model_centre_eq : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (x₀ q : ↥W), Scheme.Hom.ker (wcNcSec W x₀ (x₀ * q)) ⊔ wcNcPrincipal (.of ↥W) _ (wcNcStr W (x₀ * (x₀ * q))) x₀ = wcNcModelCentre W (x₀ * (x₀ * q)) x₀ :=
by
  intro Ω _ W x₀ q
  classical

  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro X I J
    rw [Scheme.IdealSheafData.ext_iff, Scheme.IdealSheafData.ideal_sup]
    funext U
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]

  have hker : ∀ (R S : CommRingCat.{u}) (f : R ⟶ S),
      RingHom.ker (Spec.map f).appTop.hom =
        Ideal.map (Scheme.ΓSpecIso R).inv.hom (RingHom.ker f.hom) := by
    intro R S f
    have e : (Spec.map f).appTop = (Scheme.ΓSpecIso R).hom ≫ f ≫ (Scheme.ΓSpecIso S).inv := by
      rw [← Category.assoc, ← Scheme.ΓSpecIso_naturality, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have hinjS : Function.Injective (Scheme.ΓSpecIso S).inv.hom := by
      intro x y hxy
      have h1 : ∀ z, (Scheme.ΓSpecIso S).hom.hom ((Scheme.ΓSpecIso S).inv.hom z) = z := by
        intro z
        change ((Scheme.ΓSpecIso S).inv ≫ (Scheme.ΓSpecIso S).hom).hom z = z
        rw [Iso.inv_hom_id]
        rfl
      rw [← h1 x, ← h1 y, hxy]
    have hR1 : ∀ z, (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom z) = z := by
      intro z
      change ((Scheme.ΓSpecIso R).inv ≫ (Scheme.ΓSpecIso R).hom).hom z = z
      rw [Iso.inv_hom_id]
      rfl
    have hR2 : ∀ z, (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom z) = z := by
      intro z
      change ((Scheme.ΓSpecIso R).hom ≫ (Scheme.ΓSpecIso R).inv).hom z = z
      rw [Iso.hom_inv_id]
      rfl
    rw [e, CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_assoc,
      RingHom.ker_comp_of_injective _ hinjS, ← RingHom.comap_ker]
    apply le_antisymm
    · intro x hx
      rw [← hR2 x]
      exact Ideal.mem_map_of_mem _ hx
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_comap, hR1]
      exact hx

  have hs : ∀ p : MvPolynomial (Fin 2) ↥W,
      wcNcSecHom W x₀ (x₀ * q) (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) p) =
        MvPolynomial.aeval (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) p := by
    intro p
    rw [wcNcSecHom, Ideal.Quotient.lift_mk]
    rfl
  have halg : ∀ w : ↥W, algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) w =
      Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C w) := by
    intro w
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have hsalg : ∀ w : ↥W,
      wcNcSecHom W x₀ (x₀ * q) (algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) w) = w := by
    intro w
    rw [halg, hs, MvPolynomial.aeval_C]
    rfl
  have hs0 : wcNcSecHom W x₀ (x₀ * q)
      (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0)) = x₀ := by
    rw [hs, MvPolynomial.aeval_X]
    rfl
  have hs1 : wcNcSecHom W x₀ (x₀ * q)
      (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1)) = x₀ * q := by
    rw [hs, MvPolynomial.aeval_X]
    rfl
  have hring : RingHom.ker (wcNcSecHom W x₀ (x₀ * q)) ⊔
      Ideal.span {algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) x₀} =
      Ideal.span {Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0),
        Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1),
        Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C x₀)} := by
    set mk := Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) with hmk
    set alg := algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) with halgdef
    set s := wcNcSecHom W x₀ (x₀ * q) with hsdef
    set J' := Ideal.span {mk (MvPolynomial.X 0), mk (MvPolynomial.X 1), mk (MvPolynomial.C x₀)}
      with hJ'
    have hu : mk (MvPolynomial.X 0) ∈ J' := Ideal.subset_span (by simp)
    have hv : mk (MvPolynomial.X 1) ∈ J' := Ideal.subset_span (by simp)
    have hc : mk (MvPolynomial.C x₀) ∈ J' := Ideal.subset_span (by simp)
    have hc' : alg x₀ ∈ J' := by rw [halg]; exact hc
    apply le_antisymm
    · apply sup_le
      · have hK : ∀ p : MvPolynomial (Fin 2) ↥W,
            mk p - alg (MvPolynomial.aeval (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) p)
              ∈ J' := by
          intro p
          induction p using MvPolynomial.induction_on with
          | C w =>
            rw [MvPolynomial.aeval_C, halg]
            simp
          | add p r hp hr =>
            rw [map_add, map_add, map_add]
            have e : mk p + mk r - (alg (MvPolynomial.aeval
                (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) p) + alg (MvPolynomial.aeval
                (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) r)) =
                (mk p - alg (MvPolynomial.aeval
                (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) p)) + (mk r - alg (MvPolynomial.aeval
                (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) r)) := by ring
            rw [e]
            exact J'.add_mem hp hr
          | mul_X p n hp =>
            have hn : mk (MvPolynomial.X n) -
                alg ((fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) n) ∈ J' := by
              have hn01 : n = 0 ∨ n = 1 := by fin_cases n <;> simp
              rcases hn01 with rfl | rfl
              · exact J'.sub_mem hu hc'
              · have e1 : ((fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) 1) = x₀ * q := by
                  simp
                have e : alg ((fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) 1) =
                    alg q * alg x₀ := by
                  rw [e1, map_mul, mul_comm (alg x₀)]
                rw [e]
                exact J'.sub_mem hv (J'.mul_mem_left _ hc')
            rw [map_mul, map_mul, MvPolynomial.aeval_X, map_mul]
            have e : mk p * mk (MvPolynomial.X n) - alg (MvPolynomial.aeval
                (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) p) *
                alg ((fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) n) =
                mk (MvPolynomial.X n) * (mk p - alg (MvPolynomial.aeval
                (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) p)) +
                alg (MvPolynomial.aeval (fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) p) *
                (mk (MvPolynomial.X n) -
                  alg ((fun i : Fin 2 => if i = 0 then x₀ else x₀ * q) n)) := by ring
            rw [e]
            exact J'.add_mem (J'.mul_mem_left _ hp) (J'.mul_mem_left _ hn)
        intro b hb
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
        have h := hK p
        rw [← hs, RingHom.mem_ker.mp hb, map_zero, sub_zero] at h
        exact h
      · rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff.mp hx]
        exact hc'
    · rw [Ideal.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl
      · have e : mk (MvPolynomial.X 0) = (mk (MvPolynomial.X 0) - alg x₀) + alg x₀ := by ring
        rw [e]
        refine Ideal.add_mem _ (Ideal.mem_sup_left ?_)
          (Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
        rw [RingHom.mem_ker, map_sub, hs0, hsalg, sub_self]
      · have e : mk (MvPolynomial.X 1) =
            (mk (MvPolynomial.X 1) - alg q * alg x₀) + alg q * alg x₀ := by ring
        rw [e]
        refine Ideal.add_mem _ (Ideal.mem_sup_left ?_)
          (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)))
        rw [RingHom.mem_ker, map_sub, map_mul, hs1, hsalg, hsalg, mul_comm q x₀, sub_self]
      · rw [← halg]
        exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)

  have hp : (wcNcStr W (x₀ * (x₀ * q))).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom x₀) =
      (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) x₀) := by
    have h := congrArg (fun g => g.hom x₀) (Scheme.ΓSpecIso_inv_naturality
      (R := CommRingCat.of ↥W) (S := CommRingCat.of (wcNcRing W (x₀ * (x₀ * q))))
      (CommRingCat.ofHom (algebraMap _ _)))
    exact h.symm
  have e2 : Ideal.span {(Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) x₀)} =
      Ideal.map (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.span {algebraMap ↥W (wcNcRing W (x₀ * (x₀ * q))) x₀}) := by
    rw [Ideal.map_span, Set.image_singleton]
  have e3 : Ideal.span
      {(Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0)),
       (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1)),
       (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C x₀))} =
      Ideal.map (Scheme.ΓSpecIso (.of (wcNcRing W (x₀ * (x₀ * q))))).inv.hom
        (Ideal.span {Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 0),
          Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.X 1),
          Ideal.Quotient.mk (wcNcIdeal W (x₀ * (x₀ * q))) (MvPolynomial.C x₀)}) := by
    rw [Ideal.map_span, Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton]
  rw [wcNcSec, Scheme.ker_of_isAffine, hker, CommRingCat.hom_ofHom, wcNcPrincipal, hp, e2,
    wcNcModelCentre, e3, hsup, ← Ideal.map_sup, hring]

theorem wcpa_dj_ms_node_centre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Ct Z' : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (u' : Z' ⟶ Spec (.of ↥W)) (ψ' : Ct ⟶ Z') (Δ : Spec (.of ↥W) ⟶ Z'), SmoothOfRelativeDimension 1 ct → wcpaDjSemistable u' → (∃ (N : ℕ) (j : Z' ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = u') → IsPullback ψ' ct u' (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → Δ ≫ u' = 𝟙 _ → (¬ ∃ U : Z'.Opens, Δ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → ∃ J : Z'.IdealSheafData, (∀ U : Z'.affineOpens, (J.ideal U).FG) ∧ (∀ z : ↥Z', z ∈ (J.support : Set Z') → z = Δ (IsLocalRing.closedPoint ↥W)) ∧ wcCsdInvPull J Δ ∧ ∀ (Z : Scheme.{u}) (rb : Z ⟶ Z'), wcCsdIsBlowup J rb → (∀ (K : Type u) [Field K] [IsAlgClosed K] (sp : Spec (.of K) ⟶ Spec (.of ↥W)) (w : ↥(Limits.pullback (rb ≫ u') sp)), rb (Limits.pullback.fst (rb ≫ u') sp w) = Δ (IsLocalRing.closedPoint ↥W) → wcpaDjMsFibreNS (rb ≫ u') K sp w) ∧ ∀ Δ' : Spec (.of ↥W) ⟶ Z, Δ' ≫ rb = Δ → ∃ U : Z.Opens, Δ' (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ rb ≫ u') :=
by
  intro Ω _ _ W hW Ct Z' ct u' ψ' Δ hct hss _hproj hpb hΔ hns
  have hflat : Flat u' := hss.1
  have hprop : IsProper u' := hss.2.1
  have hlfp : LocallyOfFinitePresentation u' :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) Z' u' hflat inferInstance
  obtain ⟨-, -, hgen3, hgen4⟩ := wcpa_dj_ms_generic_fibre Ω W hW Ct Z' ct u' ψ' hct hpb
  have Hgen : ∀ z : ↥Z', u' z ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
      ∃ U : Z'.Opens, z ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u') :=
    fun z hz => hgen4 z ((hgen3 z).mpr hz)
  obtain ⟨U, e, x₀, q, m, ΔU, he, hm, hmstr, hx0, hx0m, hΔUe, hΔUm, hkerE, hkerM⟩ :=
    wcpa_dj_nc_etale_node_chart Ω W hW Z' u' Δ hss hlfp hΔ Hgen hns
  have := he
  have := hm
  obtain ⟨hFG, hsupp, hinv⟩ :=
    wcpa_dj_nc_centre_props Ω W hW Z' u' Δ x₀ hlfp inferInstance hΔ hx0 hx0m
  refine ⟨_, hFG, hsupp, hinv, ?_⟩
  intro Z rb hrb

  have hJeq : (Scheme.Hom.ker Δ ⊔ wcNcPrincipal (.of ↥W) Z' u' x₀).comap e =
      (wcNcModelCentre W (x₀ * (x₀ * q)) x₀).comap m := by
    rw [← wcpa_dj_nc_model_centre_eq Ω W x₀ q, Scheme.IdealSheafData.comap_sup,
      Scheme.IdealSheafData.comap_sup, wcpa_dj_nc_ofIdealTop_comap, wcpa_dj_nc_ofIdealTop_comap,
      hkerE, hkerM, hmstr]

  have hJ0FG : ∀ V : (Spec (.of (wcNcRing W (x₀ * (x₀ * q))))).affineOpens,
      ((wcNcModelCentre W (x₀ * (x₀ * q)) x₀).ideal V).FG := by
    intro V
    rw [wcNcModelCentre, Scheme.IdealSheafData.ofIdealTop_ideal]
    exact Ideal.FG.map (Submodule.fg_span (Set.toFinite _)) _
  obtain ⟨M', r₀, hr₀⟩ := wcpa_dj_ms_blowup_exists_ft _ _ hJ0FG
  obtain ⟨hP1, hP2⟩ := wcpa_dj_nc_model_blowup Ω W hW x₀ q hx0 hx0m M' r₀ hr₀
  have hb1 := wcpa_dj_nc_blowup_flat_basechange Z' Z U _ rb e inferInstance hrb
  have hb2 := wcpa_dj_nc_blowup_flat_basechange _ M' U _ r₀ m inferInstance hr₀
  rw [← hJeq] at hb2
  obtain ⟨θ, hθ, -⟩ := hb2.2 _ (Limits.pullback.snd rb e) hb1.1
  obtain ⟨θ', hθ', -⟩ := hb1.2 _ (Limits.pullback.snd r₀ m) hb2.1
  have hθθ' : θ ≫ θ' = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb1.2 _ (Limits.pullback.snd rb e) hb1.1
    exact (huniq _ (by show (θ ≫ θ') ≫ _ = _; rw [Category.assoc, hθ', hθ])).trans
      (huniq _ (Category.id_comp _)).symm
  have hθ'θ : θ' ≫ θ = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb2.2 _ (Limits.pullback.snd r₀ m) hb2.1
    exact (huniq _ (by show (θ' ≫ θ) ≫ _ = _; rw [Category.assoc, hθ, hθ'])).trans
      (huniq _ (Category.id_comp _)).symm
  have : IsIso θ := ⟨θ', hθθ', hθ'θ⟩
  obtain ⟨h₂, hh₂⟩ : ∃ h₂ : Limits.pullback rb e ⟶ M', h₂ = θ ≫ Limits.pullback.fst r₀ m :=
    ⟨_, rfl⟩
  have : Etale h₂ := by rw [hh₂]; infer_instance
  have hcomm : h₂ ≫ r₀ ≫ wcNcStr W (x₀ * (x₀ * q)) = Limits.pullback.fst rb e ≫ rb ≫ u' := by
    rw [hh₂, Category.assoc, Limits.pullback.condition_assoc (f := r₀) (g := m),
      ← Category.assoc θ, hθ, hmstr, ← Limits.pullback.condition_assoc (f := rb) (g := e)]
  refine ⟨?_, ?_⟩
  ·
    intro K _ _ sp w hw
    obtain ⟨ρ, hρ1, hρ2⟩ := Scheme.exists_preimage_of_isPullback (IsPullback.of_hasPullback rb e)
      (Limits.pullback.fst (rb ≫ u') sp w) (ΔU (IsLocalRing.closedPoint ↥W))
      (by rw [hw, ← hΔUe]; rfl)
    have hsq : IsPullback
        (Limits.pullback.map (Limits.pullback.fst rb e ≫ rb ≫ u') sp (rb ≫ u') sp
          (Limits.pullback.fst rb e) (𝟙 _) (𝟙 _) (by rw [Category.comp_id])
          (by rw [Category.comp_id, Category.id_comp]))
        (Limits.pullback.fst (Limits.pullback.fst rb e ≫ rb ≫ u') sp)
        (Limits.pullback.fst (rb ≫ u') sp) (Limits.pullback.fst rb e) := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_fst _ _ _)
        (IsPullback.of_hasPullback (rb ≫ u') sp).flip
      have e1 : Limits.pullback.map (Limits.pullback.fst rb e ≫ rb ≫ u') sp (rb ≫ u') sp
          (Limits.pullback.fst rb e) (𝟙 _) (𝟙 _) (by rw [Category.comp_id])
          (by rw [Category.comp_id, Category.id_comp]) ≫ Limits.pullback.snd (rb ≫ u') sp =
          Limits.pullback.snd (Limits.pullback.fst rb e ≫ rb ≫ u') sp := by
        rw [Limits.pullback.lift_snd, Category.comp_id]
      rw [e1]
      exact (IsPullback.of_hasPullback (Limits.pullback.fst rb e ≫ rb ≫ u') sp).flip
    obtain ⟨w1, hw1a, hw1b⟩ := Scheme.exists_preimage_of_isPullback hsq w ρ hρ1.symm
    have t1 := wcpa_dj_nc_ns_etale_transfer (Limits.pullback rb e) Z (Spec (.of ↥W))
      (Limits.pullback.fst rb e) (rb ≫ u') (Limits.pullback.fst rb e ≫ rb ≫ u') rfl
      inferInstance K sp w1
    have t2 := wcpa_dj_nc_ns_etale_transfer (Limits.pullback rb e) M' (Spec (.of ↥W))
      h₂ (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) (Limits.pullback.fst rb e ≫ rb ≫ u') hcomm
      inferInstance K sp w1
    rw [← hw1a]
    refine t1.mpr (t2.mp (hP1 K sp _ ?_))
    have hmf : Limits.pullback.map (Limits.pullback.fst rb e ≫ rb ≫ u') sp
        (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp h₂ (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hcomm])
        (by rw [Category.comp_id, Category.id_comp]) ≫
        Limits.pullback.fst (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp =
        Limits.pullback.fst (Limits.pullback.fst rb e ≫ rb ≫ u') sp ≫ h₂ :=
      Limits.pullback.lift_fst _ _ _
    have hmor : Limits.pullback.map (Limits.pullback.fst rb e ≫ rb ≫ u') sp
        (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp h₂ (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hcomm])
        (by rw [Category.comp_id, Category.id_comp]) ≫
        Limits.pullback.fst (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp ≫ r₀ ≫
          wcNcStr W (x₀ * (x₀ * q)) =
        Limits.pullback.fst (Limits.pullback.fst rb e ≫ rb ≫ u') sp ≫
          Limits.pullback.fst rb e ≫ rb ≫ u' := by
      calc _ = (Limits.pullback.map (Limits.pullback.fst rb e ≫ rb ≫ u') sp
            (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp h₂ (𝟙 _) (𝟙 _)
            (by rw [Category.comp_id, hcomm])
            (by rw [Category.comp_id, Category.id_comp]) ≫
            Limits.pullback.fst (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp) ≫ r₀ ≫
              wcNcStr W (x₀ * (x₀ * q)) := (Category.assoc _ _ _).symm
        _ = (Limits.pullback.fst (Limits.pullback.fst rb e ≫ rb ≫ u') sp ≫ h₂) ≫ r₀ ≫
              wcNcStr W (x₀ * (x₀ * q)) := congrArg (· ≫ _) hmf
        _ = _ := by rw [Category.assoc, hcomm]
    have hv : (Limits.pullback.map (Limits.pullback.fst rb e ≫ rb ≫ u') sp
        (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp h₂ (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hcomm])
        (by rw [Category.comp_id, Category.id_comp]) ≫
        Limits.pullback.fst (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp ≫ r₀ ≫
          wcNcStr W (x₀ * (x₀ * q))) w1 = IsLocalRing.closedPoint ↥W := by
      rw [hmor]
      show u' (rb (Limits.pullback.fst rb e
        (Limits.pullback.fst (Limits.pullback.fst rb e ≫ rb ≫ u') sp w1))) = _
      rw [hw1b, hρ1, hw]
      show (Δ ≫ u') _ = _
      rw [hΔ]
      rfl
    exact hv
  ·
    intro Δ' hΔ'
    have hc : Δ' ≫ rb = ΔU ≫ e := by rw [hΔ', hΔUe]
    have hσ : (Limits.pullback.lift Δ' ΔU hc ≫ h₂) ≫ r₀ = wcNcSec W x₀ (x₀ * q) := by
      simp only [hh₂, Category.assoc]
      rw [Limits.pullback.condition (f := r₀) (g := m), ← Category.assoc θ, hθ,
        Limits.pullback.lift_snd_assoc, hΔUm]
    obtain ⟨V, hV, hVs⟩ := hP2 _ hσ
    have s1 := (wcpa_dj_nc_smooth_etale_transfer (Limits.pullback rb e) M' (Spec (.of ↥W)) h₂
      (r₀ ≫ wcNcStr W (x₀ * (x₀ * q)))
      (Limits.pullback.lift Δ' ΔU hc (IsLocalRing.closedPoint ↥W)) inferInstance).mp
      ⟨V, hV, hVs⟩
    rw [hcomm] at s1
    obtain ⟨V', hV', hV's⟩ := (wcpa_dj_nc_smooth_etale_transfer (Limits.pullback rb e) Z
      (Spec (.of ↥W)) (Limits.pullback.fst rb e) (rb ≫ u')
      (Limits.pullback.lift Δ' ΔU hc (IsLocalRing.closedPoint ↥W)) inferInstance).mpr s1
    refine ⟨V', ?_, hV's⟩
    have hlf : Limits.pullback.lift Δ' ΔU hc ≫ Limits.pullback.fst rb e = Δ' :=
      Limits.pullback.lift_fst _ _ _
    rw [← hlf]
    exact hV'

theorem wcpa_dj_ms_node_blowup : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (α : Type) [Finite α] (r : α → (Spec (.of Ω) ⟶ Ct)) (y : Spec (.of Ω) ⟶ Ct), SmoothOfRelativeDimension 1 ct → (∀ a, r a ≫ ct = 𝟙 _) → y ≫ ct = 𝟙 _ → (∀ (a b : α) (p q : ↥(Spec (.of Ω))), a ≠ b → r a p ≠ r b q) → (∀ (a : α) (p q : ↥(Spec (.of Ω))), y p ≠ r a q) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (τ' : α → (Spec (.of ↥W) ⟶ Z')) (ψ' : Ct ⟶ Z') (Δ : Spec (.of ↥W) ⟶ Z'), wcpaDjSemistable u' → (∃ (N : ℕ) (j : Z' ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = u') → (∀ a, τ' a ≫ u' = 𝟙 _) → (∀ (a b : α) (p q : ↥(Spec (.of ↥W))), a ≠ b → τ' a p ≠ τ' b q) → (∀ a (p : ↥(Spec (.of ↥W))), ∃ U : Z'.Opens, τ' a p ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → IsPullback ψ' ct u' (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → (∀ a, r a ≫ ψ' = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ' a) → Δ ≫ u' = 𝟙 _ → y ≫ ψ' = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ Δ → (¬ ∃ U : Z'.Opens, Δ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Option α → (Spec (.of ↥W) ⟶ Z)) (ψ : Ct ⟶ Z), wcpaDjSemistable uu ∧ (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uu) ∧ (∀ a, τ a ≫ uu = 𝟙 _) ∧ (∀ (a b : Option α) (p q : ↥(Spec (.of ↥W))), a ≠ b → τ a p ≠ τ b q) ∧ (∀ a (p : ↥(Spec (.of ↥W))), ∃ U : Z.Opens, τ a p ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ uu)) ∧ IsPullback ψ ct uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧ (∀ a, r a ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ (some a)) ∧ y ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ none :=
by
  intro Ω _ _ W hW Ct ct α _ r y hsm hrs hys hrd hyd Z' u' τ' ψ' Δ hss' hproj' hτ's hτ'd hτ'sm
    hpb' hc' hΔs' hΔc' hA
  classical
  have ptw : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {h : A ⟶ C}, f ≫ g = h →
      ∀ x, g (f x) = h x := by
    intro A B C f g h e x
    rw [← Scheme.Hom.comp_apply, e]

  obtain ⟨hpts, hopen, _hrange, hgensm⟩ :=
    wcpa_dj_ms_generic_fibre Ω W hW Ct Z' ct u' ψ' hsm hpb'
  haveI := hopen

  obtain ⟨J, hJfg, hJsupp, hJΔ, hJbl⟩ :=
    wcpa_dj_ms_node_centre Ω W hW Ct Z' ct u' ψ' Δ hsm hss' hproj' hpb' hΔs' hA
  obtain ⟨Z, rb, hbl⟩ := wcpa_dj_ms_blowup_exists_ft Z' J hJfg
  obtain ⟨hnode, hΔsm⟩ := hJbl Z rb hbl
  obtain ⟨hflat, hprop, hprojZ⟩ :=
    wcpa_dj_ms_blowup_flat_proj_W Ω W Z' u' hss'.1 hproj' J hJfg Z rb hbl

  have H : ∀ (T : Scheme.{u}) (h : T ⟶ Z'), (∀ t : T, h t ∉ (J.support : Set Z')) →
      wcCsdInvPull J h := by
    intro T h hh t
    obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : Z'.Opens)) (x := h t) trivial
    have hns : h t ∉ Z'.zeroLocus (U := U₀) (J.ideal ⟨U₀, hU₀⟩ : Set Γ(Z', U₀)) := by
      rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
      exact hh t
    rw [Scheme.mem_zeroLocus_iff] at hns
    push_neg at hns
    obtain ⟨a, haI, hxa⟩ := hns
    have htD : t ∈ h ⁻¹ᵁ Z'.basicOpen a := (Scheme.Hom.mem_preimage h).mpr hxa
    obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
    have hVD : V₀ ≤ h ⁻¹ᵁ Z'.basicOpen a := hV₀sub
    have hVU : V₀ ≤ h ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono h (Z'.basicOpen_le a))
    refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV₀, haI, ?_⟩
    have hbo : T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) = V₀ := by
      rw [Scheme.basicOpen_appLE]
      exact inf_eq_left.mpr hVD
    have hunit : IsUnit ((h.appLE U₀ V₀ hVU).hom a) := by
      apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace V₀
      intro y' hy
      have hy' : y' ∈ T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) := by rw [hbo]; exact hy
      exact (T.mem_basicOpen _ y' hy).mp hy'
    refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
    rw [Ideal.span_singleton_eq_top.mpr hunit]
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ haI) hunit

  have hx_nr : Δ (IsLocalRing.closedPoint ↥W) ∉ Set.range ψ' := fun hx => hA (hgensm _ hx)
  have hψx : ∀ c, ψ' c ≠ Δ (IsLocalRing.closedPoint ↥W) := fun c h => hx_nr ⟨c, h⟩
  have hτx : ∀ a p, τ' a p ≠ Δ (IsLocalRing.closedPoint ↥W) := by
    intro a p h
    apply hA
    obtain ⟨U, hU, hUs⟩ := hτ'sm a p
    exact ⟨U, h ▸ hU, hUs⟩

  have uniq : ∀ (T : Scheme.{u}) (f g : T ⟶ Z), f ≫ rb = g ≫ rb →
      (∀ t : T, (f ≫ rb) t ∉ (J.support : Set Z')) → f = g := by
    intro T f g hfg hav
    exact (hbl.2 T (f ≫ rb) (H T _ hav)).unique rfl hfg.symm

  have hinv : ∀ o : Option α, wcCsdInvPull J (Option.elim o Δ τ') := by
    intro o
    cases o with
    | none => exact hJΔ
    | some a => exact H _ _ (fun p hp => hτx a p (hJsupp _ hp))
  choose τ hτ using fun o : Option α => (hbl.2 _ _ (hinv o)).exists

  obtain ⟨ψ, hψ⟩ := (hbl.2 Ct ψ' (H Ct ψ' (fun c hc => hψx c (hJsupp _ hc)))).exists

  have hsecZ : ∀ o, τ o ≫ (rb ≫ u') = 𝟙 _ := by
    intro o
    rw [← Category.assoc, hτ o]
    cases o with
    | none => exact hΔs'
    | some a => exact hτ's a

  have hssZ : wcpaDjSemistable (rb ≫ u') := by
    refine ⟨hflat, hprop, ?_⟩
    intro K _ _ sp w
    by_cases hw : rb (Limits.pullback.fst (rb ≫ u') sp w) = Δ (IsLocalRing.closedPoint ↥W)
    · exact hnode K sp w hw
    · have hO : (J.support : Set Z') ∩ ((J.support.compl : Z'.Opens) : Set Z') = ∅ := by
        rw [TopologicalSpace.Closeds.coe_compl]
        exact Set.inter_compl_self _
      have hiso := wc_csd_blowup_iso_off_center Z' Z J rb J.support.compl hbl hO
      have hmem : rb (Limits.pullback.fst (rb ≫ u') sp w) ∈ J.support.compl := by
        rw [← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl]
        exact fun h => hw (hJsupp _ h)
      exact wcpa_dj_ms_fibre_ns_local_iso Z' Z (Spec (.of ↥W)) rb u' J.support.compl hiso K sp
        (fun w' => hss'.2.2 K sp w') w hmem

  have transfer : ∀ z : Z, rb z ≠ Δ (IsLocalRing.closedPoint ↥W) →
      (∃ V : Z'.Opens, rb z ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ u')) →
      ∃ U : Z.Opens, z ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ rb ≫ u') := by
    intro z hz hV
    obtain ⟨V, hzV, hVsm⟩ := hV
    obtain ⟨O, hOdef⟩ : ∃ O : Z'.Opens, O = V ⊓ J.support.compl := ⟨_, rfl⟩
    have hOV : O ≤ V := by rw [hOdef]; exact inf_le_left
    have hO : (J.support : Set Z') ∩ (O : Set Z') = ∅ := by
      rw [Set.eq_empty_iff_forall_notMem]
      rintro z' ⟨h1, h2⟩
      have h2' : z' ∈ O := h2
      rw [hOdef] at h2'
      have h3 : z' ∈ J.support.compl := (TopologicalSpace.Opens.mem_inf.mp h2').2
      rw [← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl] at h3
      exact h3 h1
    haveI hiso := wc_csd_blowup_iso_off_center Z' Z J rb O hbl hO
    have hzc : rb z ∈ J.support.compl := by
      rw [← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl]
      exact fun h => hz (hJsupp _ h)
    refine ⟨rb ⁻¹ᵁ O, ?_, ?_⟩
    · rw [Scheme.Hom.mem_preimage, hOdef]
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hzV, hzc⟩
    · have e : (rb ⁻¹ᵁ O).ι ≫ rb ≫ u' = (rb ∣_ O) ≫ Z'.homOfLE hOV ≫ V.ι ≫ u' := by
        rw [reassoc_of% (Scheme.homOfLE_ι Z' hOV), ← reassoc_of% (morphismRestrict_ι rb O)]
      rw [e]
      haveI := hVsm
      haveI : SmoothOfRelativeDimension 1 (Z'.homOfLE hOV ≫ V.ι ≫ u') :=
        smoothOfRelativeDimension_comp 0 1 _ _
      exact smoothOfRelativeDimension_comp 0 1 _ _

  have hsmZ : ∀ o (p : ↥(Spec (.of ↥W))), ∃ U : Z.Opens, τ o p ∈ U ∧
      SmoothOfRelativeDimension 1 (U.ι ≫ rb ≫ u') := by
    intro o p
    cases o with
    | some a =>
      apply transfer
      · rw [ptw (hτ (some a)) p]; exact hτx a p
      · rw [ptw (hτ (some a)) p]; exact hτ'sm a p
    | none =>
      rcases hpts p with ⟨pt, rfl⟩ | rfl
      · have hmem : Δ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) pt) ∈ Set.range ψ' :=
          ⟨y pt, (ptw hΔc' pt).trans (Scheme.Hom.comp_apply _ _ _)⟩
        apply transfer
        · rw [ptw (hτ none)]
          intro h
          apply hx_nr
          rw [← h]
          exact hmem
        · rw [ptw (hτ none)]
          exact hgensm _ hmem
      · exact hΔsm (τ none) (hτ none)

  have F2 : ∀ (a : α) (pt : ↥(Spec (.of Ω))),
      Δ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) pt) ≠
        τ' a (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) pt) := by
    intro a pt heq
    rw [ptw hΔc'.symm pt, ptw (hc' a).symm pt, Scheme.Hom.comp_apply,
      Scheme.Hom.comp_apply] at heq
    exact hyd a pt pt (ψ'.isOpenEmbedding.injective heq)
  have hdisj : ∀ (a b : Option α) (p q : ↥(Spec (.of ↥W))), a ≠ b → τ a p ≠ τ b q := by
    intro o o' p q hoo' heq
    by_cases hpq : p = q
    · subst hpq
      have h1 : Option.elim o Δ τ' p = Option.elim o' Δ τ' p := by
        rw [← ptw (hτ o) p, ← ptw (hτ o') p, heq]
      rcases hpts p with ⟨pt, rfl⟩ | rfl
      · cases o with
        | none =>
          cases o' with
          | none => exact hoo' rfl
          | some b => exact F2 b pt h1
        | some a =>
          cases o' with
          | none => exact F2 a pt h1.symm
          | some b => exact hτ'd a b _ _ (fun h => hoo' (congrArg some h)) h1
      · cases o with
        | none =>
          cases o' with
          | none => exact hoo' rfl
          | some b => exact hτx b _ h1.symm
        | some a =>
          cases o' with
          | none => exact hτx a _ h1
          | some b => exact hτ'd a b _ _ (fun h => hoo' (congrArg some h)) h1
    · apply hpq
      have e1 := ptw (hsecZ o) p
      have e2 := ptw (hsecZ o') q
      rw [heq, e2] at e1
      exact e1.symm

  have hsq : CommSq ψ (𝟙 Ct) rb ψ' := ⟨by rw [hψ, Category.id_comp]⟩
  have hpb1 : IsPullback ψ (𝟙 Ct) rb ψ' := by
    refine IsPullback.of_isLimit' hsq ?_
    refine Limits.PullbackCone.IsLimit.mk hsq.w (fun s => s.snd) ?_ ?_ ?_
    · intro s
      apply uniq
      · rw [Category.assoc, hψ, s.condition]
      · intro t
        rw [Category.assoc, hψ, Scheme.Hom.comp_apply]
        exact fun h => hψx _ (hJsupp _ h)
    · intro s
      exact Category.comp_id _
    · intro s m _ hm2
      exact (Category.comp_id m).symm.trans hm2
  have hpbZ : IsPullback ψ ct (rb ≫ u') (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    have h := hpb1.paste_vert hpb'
    rwa [Category.id_comp] at h

  have hcomp_some : ∀ a, r a ≫ ψ =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ (some a) := by
    intro a
    apply uniq
    · simp only [Category.assoc, hψ, hτ]
      exact hc' a
    · intro t
      rw [Category.assoc, hψ, Scheme.Hom.comp_apply]
      exact fun h => hψx _ (hJsupp _ h)
  have hcomp_none : y ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ none := by
    apply uniq
    · simp only [Category.assoc, hψ, hτ]
      exact hΔc'
    · intro t
      rw [Category.assoc, hψ, Scheme.Hom.comp_apply]
      exact fun h => hψx _ (hJsupp _ h)
  exact ⟨Z, rb ≫ u', τ, ψ, hssZ, hprojZ, hsecZ, hdisj, hsmZ, hpbZ, hcomp_some, hcomp_none⟩

theorem wcpa_dj_lr1_mark_separation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (ι : Type) [Finite ι]
      (r : ι → (Spec (.of Ω) ⟶ Ct)),
    SmoothOfRelativeDimension 1 ct → (∀ a, r a ≫ ct = 𝟙 _) →
    (∀ (a b : ι) (p q : ↥(Spec (.of Ω))), a ≠ b → r a p ≠ r b q) →
    ∀ (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of ↥W)) (ψ₀ : Ct ⟶ Z₀), wcpaDjSemistable u₀ →
    (∃ (N : ℕ) (j : Z₀ ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
        MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧
      j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = u₀) →
    IsPullback ψ₀ ct u₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : ι → (Spec (.of ↥W) ⟶ Z)) (ψ : Ct ⟶ Z),
      wcpaDjSemistable uu ∧
      (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
          MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧
