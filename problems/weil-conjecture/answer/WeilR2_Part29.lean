    have hmor : Limits.pullback.map (Limits.pullback.fst rb U.ι ≫ rb ≫ u') sp
        (r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp
        h₂ (𝟙 _) (𝟙 _)
        (by rw [Category.comp_id, hcomm])
        (by rw [Category.comp_id, Category.id_comp]) ≫
        Limits.pullback.fst (r₀ ≫ Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp ≫ r₀ ≫
          Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
        Limits.pullback.fst (Limits.pullback.fst rb U.ι ≫ rb ≫ u') sp ≫
