    let N : Submodule T A := (Submodule.span T ((S'.erase s0 : Finset A) : Set A)).map
      (LinearMap.mulLeft T (algebraMap T A (c s0)))
    obtain ⟨G, hG, hGN⟩ := s2 N ((S'.erase s0).image (fun s => algebraMap T A (c s) * s)) (by
      intro y hy
      obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨u, z, hu, huz⟩ := hdom s (Finset.mem_of_mem_erase hs)
      refine ⟨u, hu, ?_⟩
      refine Submodule.mem_map.mpr ⟨algebraMap T A z * s, ?_, ?_⟩
      · rw [← Algebra.smul_def]
        exact Submodule.smul_mem _ _ (Submodule.subset_span (Finset.mem_coe.mpr hs))
      · have e := congrArg (algebraMap T A) huz
        simp only [map_mul] at e
        rw [LinearMap.mulLeft_apply]
        linear_combination (-s) * e)
    have hx : ∑ s ∈ S'.erase s0, algebraMap T A (c s) * s ∈ Submodule.span T
        (((S'.erase s0).image (fun s => algebraMap T A (c s) * s) : Finset A) : Set A) :=
      Submodule.sum_mem _ (fun s hs =>
        Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hs)))
    obtain ⟨w, hw, hwx⟩ := Submodule.mem_map.mp (hGN _ hx)
    rw [LinearMap.mulLeft_apply] at hwx
    have hsplit : algebraMap T A (c s0) * s0 + ∑ s ∈ S'.erase s0, algebraMap T A (c s) * s = 0 :=
      (Finset.add_sum_erase S' (fun s => algebraMap T A (c s) * s) hs0).trans hrel
    refine ⟨s0, hs0, G, hG, ?_⟩
    have key : algebraMap T A (c s0) * (algebraMap T A G * s0 + w) = 0 := by
      linear_combination hwx + algebraMap T A G * hsplit
    have hc0' : algebraMap T A (c s0) ≠ 0 := fun h => hc0 (hinj0 _ h)
    have h2 := (mul_eq_zero.mp key).resolve_left hc0'
    have h3 : algebraMap T A G * s0 = -w := eq_neg_of_add_eq_zero_left h2
    rw [h3]
    exact Submodule.neg_mem _ hw

  have s4 : ∀ S' : Finset A, ∃ (n : ℕ) (b : Fin n → A), (∀ j, b j ∈ S') ∧ LinearIndependent T b ∧
      ∀ s ∈ S', ∃ g : T, g ∉ P ∧ algebraMap T A g * s ∈ Submodule.span T (Set.range b) := by
    intro S'
    induction S' using Finset.strongInduction with
    | H S' ih =>
      by_cases hli : LinearIndependent T (fun s : S' => (s : A))
      · refine ⟨S'.card, fun j => ((S'.equivFin.symm j : S') : A),
          fun j => (S'.equivFin.symm j).2, hli.comp _ S'.equivFin.symm.injective,
          fun s hs => ⟨1, h1, ?_⟩⟩
        rw [map_one, one_mul]
        exact Submodule.subset_span ⟨S'.equivFin ⟨s, hs⟩, by simp⟩
      · obtain ⟨s0, hs0, U, hU, hUs⟩ := hE S' hli
        obtain ⟨n, b, hbm, hbli, hgen⟩ := ih (S'.erase s0) (Finset.erase_ssubset hs0)
