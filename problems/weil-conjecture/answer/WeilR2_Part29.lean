    · exact ⟨1, 0, h1notin, Or.inl (by rw [hx0]; ring)⟩
    by_cases hy0 : y = 0
    · exact ⟨1, 0, h1notin, Or.inr (by rw [hy0]; ring)⟩
    obtain ⟨c₁, -, x₀, -, -, hx₀, rfl⟩ := hb x hx0
    obtain ⟨c₂, -, y₀, -, -, hy₀, rfl⟩ := hb y hy0
    rcases ValuationRing.dvd_total c₁ c₂ with ⟨e, he⟩ | ⟨e, he⟩
    · refine ⟨x₀, algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C e) * y₀,
        hnotin _ hx₀, Or.inr ?_⟩
      rw [he, map_mul, map_mul]
      ring
    · refine ⟨y₀, algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C e) * x₀,
        hnotin _ hy₀, Or.inl ?_⟩
      rw [he, map_mul, map_mul]
      ring
  refine ⟨hprime, ?_, hcc⟩
  intro f hf
  obtain ⟨c, N, f₀, hc0, hdvd, hf₀, hfeq⟩ := hb f hf
