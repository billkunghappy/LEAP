    rw [← Nat.sub_add_cancel hle, pow_add, mul_assoc, hk i, mul_zero]
  have hfg : (Submodule.span (Localization.Away t) (ι '' (N : Set (Fin r → T)))).FG :=
    IsNoetherian.noetherian _
  obtain ⟨s', hs'S, hs'eq⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hfg
  set g := Function.invFunOn ι (N : Set (Fin r → T)) with hgdef
  have hgN : ∀ y ∈ s', g y ∈ N := fun y hy => Function.invFunOn_mem (hs'S hy)
  have hgι : ∀ y ∈ s', ι (g y) = y := fun y hy => Function.invFunOn_eq (hs'S hy)
  refine ⟨Submodule.span T (g '' (s' : Set (Fin r → Localization.Away t))), ?_, ?_, ?_⟩
  · exact Submodule.fg_def.mpr ⟨_, s'.finite_toSet.image g, rfl⟩
  · rw [Submodule.span_le]
    rintro _ ⟨y, hy, rfl⟩
    exact hgN y hy
  · intro x hx
    have hιx : ι x ∈ Submodule.span (Localization.Away t)
        (s' : Set (Fin r → Localization.Away t)) := by
      rw [← hs'eq]; exact Submodule.subset_span ⟨x, hx, rfl⟩
    obtain ⟨f, hf⟩ := Submodule.mem_span_finset.mp hιx
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (Submonoid.powers t) s' f
    obtain ⟨m, hm⟩ := b.2
    have hex : ∀ y ∈ s', ∃ a : T, algebraMap T (Localization.Away t) a =
        algebraMap T (Localization.Away t) t ^ m * f y := by
      intro y hy
      obtain ⟨a, ha⟩ := hb y hy
      refine ⟨a, ?_⟩
      simp only at hm
      rw [ha, Algebra.smul_def, ← hm, map_pow]
    choose! a ha using hex
    have hιw : ι (t ^ m • x) = ι (∑ y ∈ s', a y • g y) := by
      rw [map_smul, map_sum, ← hf.2, Finset.smul_sum]
      refine Finset.sum_congr rfl (fun y hy => ?_)
      rw [map_smul, hgι y hy]
      funext i
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [Algebra.smul_def, Algebra.smul_def, ha y hy, map_pow]
      ring
    obtain ⟨k, hk⟩ := hker (t ^ m • x - ∑ y ∈ s', a y • g y) (by rw [map_sub, hιw, sub_self])
    refine ⟨k + m, ?_⟩
    rw [smul_sub, sub_eq_zero] at hk
    rw [pow_add, mul_smul, hk, Finset.smul_sum]
    refine Submodule.sum_mem _ (fun y hy => ?_)
    rw [smul_smul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨y, hy, rfl⟩)

theorem wcpa_vrpc_homogenize_submodule : ∀ (V : Type u) [CommRing V] (d n : ℕ) (K : Submodule (MvPolynomial (Fin d) V) (Fin n → MvPolynomial (Fin d) V)), (∀ (w : V) (v : Fin n → MvPolynomial (Fin d) V), w ≠ 0 → (MvPolynomial.C w : MvPolynomial (Fin d) V) • v ∈ K → v ∈ K) → ∃ Kh : Submodule (MvPolynomial (Fin (d + 1)) V) (Fin n → MvPolynomial (Fin (d + 1)) V), (∀ (w : V) (v : Fin n → MvPolynomial (Fin (d + 1)) V), w ≠ 0 → (MvPolynomial.C w : MvPolynomial (Fin (d + 1)) V) • v ∈ Kh → v ∈ Kh) ∧ (∀ (v : Fin n → MvPolynomial (Fin (d + 1)) V) (e : ℕ), v ∈ Kh → (fun i => MvPolynomial.homogeneousComponent e (v i)) ∈ Kh) ∧ (∀ v ∈ Kh, (fun i => MvPolynomial.aeval (Fin.cons 1 MvPolynomial.X : Fin (d + 1) → MvPolynomial (Fin d) V) (v i)) ∈ K) ∧ ∀ u ∈ K, ∃ v ∈ Kh, (fun i => MvPolynomial.aeval (Fin.cons 1 MvPolynomial.X : Fin (d + 1) → MvPolynomial (Fin d) V) (v i)) = u :=
