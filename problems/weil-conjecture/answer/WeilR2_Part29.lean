theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_unramified : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) [(wcGbP W ϖ d).IsPrime], (∀ f : wcGbT W ϖ d, f ≠ 0 → ∃ (c : ↥W) (N : ℕ) (f₀ : wcGbT W ϖ d), c ≠ 0 ∧ c ∣ ϖ ^ N ∧ f₀ ∉ wcGbP W ϖ d ∧ f = algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) * f₀) → (∀ x y : wcGbT W ϖ d, ∃ u z : wcGbT W ϖ d, u ∉ wcGbP W ϖ d ∧ (u * x = z * y ∨ u * y = z * x)) → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra (wcGbVhat W ϖ d) B], Function.Injective (algebraMap (wcGbVhat W ϖ d) B) → IsUnit (algebraMap (wcGbVhat W ϖ d) B (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d))) → (∃ G : Finset B, ∀ x : B, ∃ n : ℕ, algebraMap (wcGbVhat W ϖ d) B (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d)) ^ n * x ∈ Submodule.span (wcGbVhat W ϖ d) (G : Set B)) → (∀ y : B, y ≠ 0 → ∃ z : B, y * z = 1 ∧ (IsIntegral (wcGbVhat W ϖ d) y ∨ IsIntegral (wcGbVhat W ϖ d) z)) → (∀ y z : B, IsIntegral (wcGbVhat W ϖ d) y → IsIntegral (wcGbVhat W ϖ d) z → ∃ w : B, IsIntegral (wcGbVhat W ϖ d) w ∧ (y = w * z ∨ z = w * y)) → ∀ y : B, y ≠ 0 → IsIntegral (wcGbVhat W ϖ d) y → ∃ (c : wcGbVhat W ϖ d) (u v : B), y = algebraMap (wcGbVhat W ϖ d) B c * u ∧ u * v = 1 ∧ IsIntegral (wcGbVhat W ϖ d) u ∧ IsIntegral (wcGbVhat W ϖ d) v :=
by
  intro Ω _ _ W _hW ϖ hϖ0 hϖnu d _ hcont hval B _ _ _ _hinj _hunit _hG hHA hHB y hy0 hyi
  classical

  have sDom : ∀ (R : Type u) [CommRing R] [Algebra R B],
      (∀ y z : B, IsIntegral R y → IsIntegral R z →
        ∃ w : B, IsIntegral R w ∧ (y = w * z ∨ z = w * y)) →
      ∀ y : B, y ≠ 0 → IsIntegral R y →
      ∃ (m : ℕ) (a b : R) (u u' : B), 0 < m ∧ algebraMap R B a ≠ 0 ∧
        algebraMap R B b ≠ 0 ∧ IsIntegral R u ∧ IsIntegral R u' ∧ u * u' = 1 ∧
        algebraMap R B a * y ^ m = u * algebraMap R B b := by
    intro R _ _ HB y hy0 hyi

    have P0 : ∀ x z : B, IsIntegral R x → IsIntegral R z →
        (¬ ∃ q : B, IsIntegral R q ∧ x * q = 1) → (¬ ∃ q : B, IsIntegral R q ∧ z * q = 1) →
        ¬ ∃ q : B, IsIntegral R q ∧ (x + z) * q = 1 := by
      rintro x z hx hz hxn hzn ⟨q, hq, hxq⟩
      obtain ⟨w, hw, h | h⟩ := HB x z hx hz
      · exact hzn ⟨(w + 1) * q, (hw.add isIntegral_one).mul hq, by linear_combination hxq - q * h⟩
      · exact hxn ⟨(w + 1) * q, (hw.add isIntegral_one).mul hq, by linear_combination hxq - q * h⟩

    have P1 : ∀ (S : Finset ℕ) (f : ℕ → B), (∀ i ∈ S, IsIntegral R (f i)) →
