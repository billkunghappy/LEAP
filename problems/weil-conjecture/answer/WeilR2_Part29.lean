theorem wcpa_dj_nc_model_blowup : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (x₀ q : ↥W), x₀ ≠ 0 → x₀ ∈ IsLocalRing.maximalIdeal ↥W → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (wcNcRing W (x₀ * (x₀ * q))))), wcCsdIsBlowup (wcNcModelCentre W (x₀ * (x₀ * q)) x₀) r₀ → (∀ (K : Type u) [Field K] [IsAlgClosed K] (sp : Spec (.of K) ⟶ Spec (.of ↥W)) (w : ↥(Limits.pullback (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp)), wcNcStr W (x₀ * (x₀ * q)) (r₀ (Limits.pullback.fst (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) sp w)) = IsLocalRing.closedPoint ↥W → wcpaDjMsFibreNS (r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) K sp w) ∧ ∀ σ' : Spec (.of ↥W) ⟶ M', σ' ≫ r₀ = wcNcSec W x₀ (x₀ * q) → ∃ U : M'.Opens, σ' (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ r₀ ≫ wcNcStr W (x₀ * (x₀ * q))) :=
