    haveI : IsScalarTower R (Localization.AtPrime q') (Localization.AtPrime q) :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [IsScalarTower.algebraMap_apply R P (Localization.AtPrime q') r, hgapp,
          IsScalarTower.algebraMap_apply R S (Localization.AtPrime q) r,
          IsScalarTower.algebraMap_apply R P S r])
    have hgsurj : Function.Surjective
        (algebraMap (Localization.AtPrime q') (Localization.AtPrime q)) := by
      intro z
      obtain ⟨⟨s, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl z
      obtain ⟨p, rfl⟩ := hsurj s
      obtain ⟨p', hp'⟩ := hsurj t
      have ht : p' ∈ q'.primeCompl := by
        show algebraMap P S p' ∉ q
        rw [hp']
        exact t.2
      refine ⟨IsLocalization.mk' (Localization.AtPrime q') p ⟨p', ht⟩, ?_⟩
      change Localization.localRingHom q' q (algebraMap P S) rfl _ = _
      rw [Localization.localRingHom_mk']
      congr 1
      exact Subtype.ext hp'
    have hker : RingHom.ker (algebraMap (Localization.AtPrime q') (Localization.AtPrime q)) =
        Ideal.map (algebraMap P (Localization.AtPrime q')) (RingHom.ker (algebraMap P S)) :=
      IsLocalization.ker_map (S := Localization.AtPrime q') (Localization.AtPrime q)
        (algebraMap P S) hT
    have hFG : (RingHom.ker (algebraMap (Localization.AtPrime q')
        (Localization.AtPrime q))).FG := by
      rw [hker]
      exact hfg.map _
    have hunit : ∀ y : q.primeCompl, IsUnit (algebraMap S L y) := by
      intro y
      apply isUnit_iff_ne_zero.mpr
      intro h0
      apply y.2
      have hy : (y : S) ∈ RingHom.ker (algebraMap S L) := RingHom.mem_ker.mpr h0
      rw [hq] at hy
      exact hy
    letI : Algebra (Localization.AtPrime q) L :=
      (IsLocalization.lift (M := q.primeCompl) (S := Localization.AtPrime q) hunit).toAlgebra
    have hliftapp : ∀ s : S, algebraMap (Localization.AtPrime q) L
        (algebraMap S (Localization.AtPrime q) s) = algebraMap S L s := fun s =>
      IsLocalization.lift_eq hunit s
    letI : Algebra (Localization.AtPrime q') L :=
      ((algebraMap (Localization.AtPrime q) L).comp
        (algebraMap (Localization.AtPrime q') (Localization.AtPrime q))).toAlgebra
    haveI : IsScalarTower (Localization.AtPrime q') (Localization.AtPrime q) L :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower P (Localization.AtPrime q') L :=
      IsScalarTower.of_algebraMap_eq (fun p => by
        change _ = algebraMap (Localization.AtPrime q) L
          (algebraMap (Localization.AtPrime q') (Localization.AtPrime q)
            (algebraMap P (Localization.AtPrime q') p))
        rw [hgapp, hliftapp]
        exact IsScalarTower.algebraMap_apply P S L p)
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime q) ≤
        RingHom.ker (algebraMap (Localization.AtPrime q) L) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker, hliftapp, ← RingHom.mem_ker, hq]
      exact hx
    haveI : Algebra.FormallyEtale P (Localization.AtPrime q') :=
      Algebra.FormallyEtale.of_isLocalization q'.primeCompl
    have hbΩ := KaehlerDifferential.isBaseChange_of_formallyEtale R P (Localization.AtPrime q')
    haveI : Module.Free (Localization.AtPrime q') Ω[Localization.AtPrime q'⁄R] := hbΩ.free
    haveI : Module.Finite (Localization.AtPrime q') Ω[Localization.AtPrime q'⁄R] :=
      Module.Finite.equiv hbΩ.equiv
    have hcrit := Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange
      (R := R) (S := Localization.AtPrime q) (Localization.AtPrime q') L hgsurj hFG hmax
    show Algebra.FormallySmooth R (Localization.AtPrime q) ↔ _
    rw [hcrit]
    have hG : ∀ (M M' : Type u) [AddCommGroup M] [Module P M] [AddCommGroup M']
        [Module (Localization.AtPrime q') M'] [Module P M']
        [IsScalarTower P (Localization.AtPrime q') M'] (ψ : M →ₗ[P] M'),
        IsBaseChange (Localization.AtPrime q') ψ →
        ∃ e : TensorProduct P L M ≃ₗ[L] TensorProduct (Localization.AtPrime q') L M',
          ∀ (l : L) (m : M), e (l ⊗ₜ[P] m) = l ⊗ₜ[Localization.AtPrime q'] (ψ m) := by
      intro M M' _ _ _ _ _ _ ψ hψ
      refine ⟨(TensorProduct.AlgebraTensorModule.cancelBaseChange P (Localization.AtPrime q') L L
        M).symm.trans (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl L L) hψ.equiv), ?_⟩
      intro l m
      rw [LinearEquiv.trans_apply, TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
        TensorProduct.AlgebraTensorModule.congr_tmul, LinearEquiv.refl_apply,
        IsBaseChange.equiv_tmul, one_smul]
    obtain ⟨β, hβ⟩ := hG _ _ (KaehlerDifferential.map R R P (Localization.AtPrime q')) hbΩ
    let ψI : RingHom.ker (algebraMap P S) →ₗ[P]
        RingHom.ker (algebraMap (Localization.AtPrime q') (Localization.AtPrime q)) :=
      ((LinearEquiv.ofEq _ _ hker.symm).restrictScalars P).toLinearMap ∘ₗ
        Algebra.idealMap (Localization.AtPrime q') (RingHom.ker (algebraMap P S))
    have hψI : ∀ h : RingHom.ker (algebraMap P S),
        ((ψI h : Localization.AtPrime q')) = algebraMap P (Localization.AtPrime q') h :=
      fun _ => rfl
    haveI : IsLocalizedModule q'.primeCompl ψI :=
      IsLocalizedModule.of_linearEquiv q'.primeCompl _ _
    have hbI : IsBaseChange (Localization.AtPrime q') ψI :=
      (isLocalizedModule_iff_isBaseChange q'.primeCompl (Localization.AtPrime q') ψI).mp
        inferInstance
    obtain ⟨α, hα⟩ := hG _ _ ψI hbI
    have hsq : ∀ x, β (KaehlerDifferential.cotangentComplexBaseChange R S P L x) =
        KaehlerDifferential.cotangentComplexBaseChange R (Localization.AtPrime q)
          (Localization.AtPrime q') L (α x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
      | tmul l h =>
        rw [hα, KaehlerDifferential.cotangentComplexBaseChange_tmul,
          KaehlerDifferential.cotangentComplexBaseChange_tmul,
          KaehlerDifferential.kerToTensor_apply, KaehlerDifferential.kerToTensor_apply,
          map_smul, hβ, KaehlerDifferential.map_D, hψI]
    constructor
    · intro hinj x y hxy
      apply α.injective
      apply hinj
      rw [← hsq, ← hsq, hxy]
    · intro hinj x y hxy
      have hx := α.apply_symm_apply x
      have hy := α.apply_symm_apply y
      rw [← hx, ← hy, ← hsq, ← hsq] at hxy
      have := hinj (β.injective hxy)
      rw [← hx, ← hy, this]

  intro R K S _ _ _ _ _ _ _ Q _ q _ hq hsm
  classical
  obtain ⟨n, f, hf, hI⟩ := Algebra.FinitePresentation.out (R := R) (A := S)
  obtain ⟨hf', hker, hcomm⟩ := s1 R K S n f hf
  set f' : MvPolynomial (Fin n) K →ₐ[K] TensorProduct R K S :=
    MvPolynomial.aeval (R := K) (fun i => TensorProduct.tmul R (1 : K) (f (MvPolynomial.X i)))
    with hf'def
  set μ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) K := MvPolynomial.map (algebraMap R K)
    with hμ
  letI : Algebra (MvPolynomial (Fin n) R) S := f.toRingHom.toAlgebra
  haveI : IsScalarTower R (MvPolynomial (Fin n) R) S :=
    IsScalarTower.of_algebraMap_eq (fun r => (f.commutes r).symm)
  letI : Algebra (MvPolynomial (Fin n) K) (TensorProduct R K S) := f'.toRingHom.toAlgebra
  haveI : IsScalarTower K (MvPolynomial (Fin n) K) (TensorProduct R K S) :=
    IsScalarTower.of_algebraMap_eq (fun r => (f'.commutes r).symm)
  letI : Algebra S Q.ResidueField := ((algebraMap (TensorProduct R K S) Q.ResidueField).comp
    (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S).toRingHom).toAlgebra
  letI : Algebra (MvPolynomial (Fin n) R) Q.ResidueField :=
    ((algebraMap S Q.ResidueField).comp (algebraMap (MvPolynomial (Fin n) R) S)).toAlgebra
  letI : Algebra (MvPolynomial (Fin n) K) Q.ResidueField :=
    ((algebraMap (TensorProduct R K S) Q.ResidueField).comp
      (algebraMap (MvPolynomial (Fin n) K) (TensorProduct R K S))).toAlgebra
  haveI : IsScalarTower (MvPolynomial (Fin n) R) S Q.ResidueField :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower (MvPolynomial (Fin n) K) (TensorProduct R K S) Q.ResidueField :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hL : algebraMap (MvPolynomial (Fin n) R) Q.ResidueField =
      (algebraMap (MvPolynomial (Fin n) K) Q.ResidueField).comp μ := by
    change (algebraMap (TensorProduct R K S) Q.ResidueField).comp
        ((Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S).toRingHom.comp
          f.toRingHom) =
      (algebraMap (TensorProduct R K S) Q.ResidueField).comp (f'.toRingHom.comp μ)
    rw [hcomm]
  have hkerq : RingHom.ker (algebraMap S Q.ResidueField) = q := by
    change RingHom.ker ((algebraMap (TensorProduct R K S) Q.ResidueField).comp
      (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S).toRingHom) = q
    rw [← RingHom.comap_ker, Ideal.ker_algebraMap_residueField, ← hq]
    rfl
  have hFG' : (RingHom.ker (algebraMap (MvPolynomial (Fin n) K) (TensorProduct R K S))).FG := by
    change (RingHom.ker f'.toRingHom).FG
    rw [hker]
    exact hI.map _
  have hcK := (s4 K (TensorProduct R K S) (MvPolynomial (Fin n) K)
    Q.ResidueField hf' hFG' Q (Ideal.ker_algebraMap_residueField Q)).mp hsm
  refine (s4 R S (MvPolynomial (Fin n) R) Q.ResidueField hf hI q hkerq).mpr ?_
  obtain ⟨ΦI, hΦI, hΦIinj⟩ := s2 R K S Q.ResidueField n f hL hf hker
  obtain ⟨ΦΩ, hΦΩ⟩ := s3 R K Q.ResidueField n hL
  have hsq : ∀ x, ΦΩ (KaehlerDifferential.cotangentComplexBaseChange R S
      (MvPolynomial (Fin n) R) Q.ResidueField x) =
      KaehlerDifferential.cotangentComplexBaseChange K (TensorProduct R K S)
        (MvPolynomial (Fin n) K) Q.ResidueField (ΦI x) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
    | tmul l h =>
      have hmem : μ (h : MvPolynomial (Fin n) R) ∈
          RingHom.ker (algebraMap (MvPolynomial (Fin n) K) (TensorProduct R K S)) := by
        change _ ∈ RingHom.ker f'.toRingHom
        rw [hker]
        exact Ideal.mem_map_of_mem _ h.2
      rw [hΦI l h ⟨_, hmem⟩ rfl, KaehlerDifferential.cotangentComplexBaseChange_tmul,
        KaehlerDifferential.cotangentComplexBaseChange_tmul,
        KaehlerDifferential.kerToTensor_apply, KaehlerDifferential.kerToTensor_apply,
        map_smul, hΦΩ 1 h]
  intro x y hxy
  apply hΦIinj
  apply hcK
  rw [← hsq, ← hsq, hxy]

theorem wcpa_dj_mn_fs_reldim : ∀ (R K S : Type u) [CommRing R] [Field K] [Algebra R K] [CommRing S] [Algebra R S] (n m : ℕ) (Q : Ideal (TensorProduct R K S)) [Q.IsPrime] (s : TensorProduct R K S), s ∉ Q → Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s) → ∀ q : Ideal S, Q.comap (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R K S) = q → ∀ b : S, b ∉ q → Algebra.IsStandardSmoothOfRelativeDimension m R (Localization.Away b) → m = n :=
by
  classical

  have s3 : ∀ (K T : Type u) [CommRing K] [CommRing T] [Algebra K T] (Q : Ideal T), Q.IsPrime →
      ∀ (s β : T), s ∉ Q → β ∉ Q → ∀ (n m : ℕ),
      Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s) →
      Algebra.IsStandardSmoothOfRelativeDimension m K (Localization.Away β) → m = n := by
    intro K T _ _ _ Q hQ s β hs hβ n m hn hm
    let Ts := Localization.Away s
    let Tb := Localization.Away β
    let C := Localization.Away (algebraMap T Ts β)
    let D := Localization.Away (algebraMap T Tb s)
    haveI hC0 : Algebra.IsStandardSmoothOfRelativeDimension 0 Ts C :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap T Ts β)
    haveI hD0 : Algebra.IsStandardSmoothOfRelativeDimension 0 Tb D :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away (algebraMap T Tb s)
    have hCn : Algebra.IsStandardSmoothOfRelativeDimension (0 + n) K C :=
      Algebra.IsStandardSmoothOfRelativeDimension.trans n 0 K Ts C
    have hDm : Algebra.IsStandardSmoothOfRelativeDimension (0 + m) K D :=
      Algebra.IsStandardSmoothOfRelativeDimension.trans m 0 K Tb D
    haveI hCl : IsLocalization.Away (β * s) C := IsLocalization.Away.mul Ts C s β
    haveI hDl : IsLocalization.Away (β * s) D := IsLocalization.Away.mul' Tb D β s
    let e : C ≃ₐ[T] D := IsLocalization.algEquiv (Submonoid.powers (β * s)) C D
    let e' : D ≃ₐ[K] C := (e.restrictScalars K).symm
    have hCm : Algebra.IsStandardSmoothOfRelativeDimension (0 + m) K C :=
      @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv (0 + m) K D _ _ _ C _ _ e' hDm
    have hprod : β * s ∉ Q := fun h => (hQ.mem_or_mem h).elim hβ hs
    have hdisj : Disjoint (Submonoid.powers (β * s) : Set T) (Q : Set T) :=
      (Ideal.disjoint_powers_iff_notMem (β * s) hQ.isRadical).mpr hprod
    have hP := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (β * s)) C Q hQ hdisj
    haveI : Nontrivial C := nontrivial_of_ne (0 : C) 1 (fun h => hP.ne_top
      ((Ideal.eq_top_iff_one _).mpr (by rw [← h]; exact Ideal.zero_mem _)))
    have h1 := @Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential K C _ _ _ _
      (0 + n) hCn
    have h2 := @Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential K C _ _ _ _
      (0 + m) hCm
    rw [h1] at h2
    have h3 : 0 + n = 0 + m := by exact_mod_cast h2
    omega

  have s2 : ∀ (A K B : Type u) [CommRing A] [CommRing K] [Algebra A K] [CommRing B] [Algebra A B]
      (b : B), Nonempty (TensorProduct A K (Localization.Away b) ≃ₐ[K]
        Localization.Away (TensorProduct.tmul A (1 : K) b)) := by
    intro A K B _ _ _ _ _ b
    let β : TensorProduct A K B := TensorProduct.tmul A (1 : K) b
    let ιT : TensorProduct A K B →ₐ[K] Localization.Away β :=
      IsScalarTower.toAlgHom K _ (Localization.Away β)
    let jB : B →ₐ[A] Localization.Away β :=
      (ιT.restrictScalars A).comp Algebra.TensorProduct.includeRight
    have hjb : IsUnit (jB b) := IsLocalization.Away.algebraMap_isUnit β
    have hjbp : ∀ y : Submonoid.powers b, IsUnit (jB y) := by
      rintro ⟨y, k, rfl⟩
      simp only [map_pow]
      exact hjb.pow k
    let g : Localization.Away b →ₐ[A] Localization.Away β :=
      IsLocalization.liftAlgHom (M := Submonoid.powers b) hjbp
    let Φ : TensorProduct A K (Localization.Away b) →ₐ[K] Localization.Away β :=
      Algebra.TensorProduct.lift (Algebra.ofId K _) g (fun _ _ => Commute.all _ _)
    let ψ₀ : TensorProduct A K B →ₐ[K] TensorProduct A K (Localization.Away b) :=
      Algebra.TensorProduct.map (AlgHom.id K K) (IsScalarTower.toAlgHom A B (Localization.Away b))
    have hψb : IsUnit (ψ₀ β) := by
      have : ψ₀ β = Algebra.TensorProduct.includeRight (algebraMap B (Localization.Away b) b) := by
        simp [ψ₀, β, Algebra.TensorProduct.includeRight_apply]
      rw [this]
      exact (IsLocalization.Away.algebraMap_isUnit b).map _
    have hψbp : ∀ y : Submonoid.powers β, IsUnit (ψ₀ y) := by
      rintro ⟨y, k, rfl⟩
      simp only [map_pow]
      exact hψb.pow k
    let Ψ : Localization.Away β →ₐ[K] TensorProduct A K (Localization.Away b) :=
      IsLocalization.liftAlgHom (M := Submonoid.powers β) hψbp
    have hΨ : ∀ y, Ψ (algebraMap _ (Localization.Away β) y) = ψ₀ y := fun y =>
      IsLocalization.lift_eq _ y
    have hg : ∀ x, g (algebraMap B (Localization.Away b) x) =
        algebraMap _ (Localization.Away β) (TensorProduct.tmul A (1 : K) x) := fun x =>
      IsLocalization.lift_eq _ x
    have hΦ : ∀ y, Φ (TensorProduct.tmul A (1 : K) y) = g y := fun y => by
      simp only [Φ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    have hψ₀ : ∀ x, ψ₀ (TensorProduct.tmul A (1 : K) x) =
        TensorProduct.tmul A (1 : K) (algebraMap B (Localization.Away b) x) :=
      fun x => by simp [ψ₀]
    refine ⟨AlgEquiv.ofAlgHom Φ Ψ ?_ ?_⟩
    · apply IsLocalization.algHom_ext (Submonoid.powers β)
      apply Algebra.TensorProduct.ext
      · apply Algebra.ext_id
      · ext x
        change Φ (Ψ (algebraMap _ (Localization.Away β) (TensorProduct.tmul A (1 : K) x))) =
          algebraMap _ (Localization.Away β) (TensorProduct.tmul A (1 : K) x)
        rw [hΨ, hψ₀, hΦ, hg]
    · apply Algebra.TensorProduct.ext
      · apply Algebra.ext_id
      · apply IsLocalization.algHom_ext (Submonoid.powers b)
        ext x
        change Ψ (Φ (TensorProduct.tmul A (1 : K) (algebraMap B (Localization.Away b) x))) =
          TensorProduct.tmul A (1 : K) (algebraMap B (Localization.Away b) x)
        rw [hΦ, hg, hΨ, hψ₀]

  intro R K S _ _ _ _ _ n m Q hQ s hs hstdK q hqQ b hb hstd

  have hβQ : TensorProduct.tmul R (1 : K) b ∉ Q := by
    intro h
    apply hb
    rw [← hqQ, Ideal.mem_comap, Algebra.TensorProduct.includeRight_apply]
    exact h
  haveI := hstd
  have hD : Algebra.IsStandardSmoothOfRelativeDimension m K
      (TensorProduct R K (Localization.Away b)) :=
    Algebra.IsStandardSmoothOfRelativeDimension.baseChange m K
  obtain ⟨e⟩ := s2 R K S b
  have hβ : Algebra.IsStandardSmoothOfRelativeDimension m K
      (Localization.Away (TensorProduct.tmul R (1 : K) b)) :=
    @Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv m K _ _ _ _ _ _ _ e hD
  exact s3 K (TensorProduct R K S) Q hQ s _ hs hβQ n m hstdK hβ

theorem wcpa_dj_mn_fibre_smooth : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y) (w : ↥(Limits.pullback g (S.fromSpecResidueField (g y)))), Flat g → LocallyOfFinitePresentation g → Limits.pullback.fst g (S.fromSpecResidueField (g y)) w = y → (∃ W : (Limits.pullback g (S.fromSpecResidueField (g y))).Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g (S.fromSpecResidueField (g y)))) → ∃ W' : Y.Opens, y ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ g) :=
by
  intro S Y g y w hflat hlfp hw ⟨W, hwW, hWsm⟩
  classical

  have s2 : ∀ (P X K : Scheme.{u}) (snd : P ⟶ K) (ι : X ⟶ P) (h : X ⟶ K), IsOpenImmersion ι →
      ι ≫ snd = h → ∀ (w : P), w ∈ Set.range ι → ∀ (W : P.Opens), w ∈ W →
      SmoothOfRelativeDimension 1 (W.ι ≫ snd) →
      ∃ x : X, ι x = w ∧ ∃ W' : X.Opens, x ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ h) := by
    intro P X K snd ι h hι hh w hw W hwW hW
    obtain ⟨x, hx⟩ := hw
    refine ⟨x, hx, ι ⁻¹ᵁ W, ?_, ?_⟩
    · show ι x ∈ W
      rw [hx]; exact hwW
    · have e1 : (ι ⁻¹ᵁ W).ι ≫ h = (ι ∣_ W) ≫ (W.ι ≫ snd) := by
        rw [← hh, ← Category.assoc, ← Category.assoc, morphismRestrict_ι]
      rw [e1]
      haveI : SmoothOfRelativeDimension 0 (ι ∣_ W) := inferInstance
      haveI := hW
      exact smoothOfRelativeDimension_comp 0 1 (ι ∣_ W) (W.ι ≫ snd)

  have s4 : ∀ (A T : Type u) [CommRing A] [CommRing T] [Algebra A T] (n : ℕ) (Q : Ideal T)
      [Q.IsPrime] (s : T), s ∉ Q →
      Algebra.IsStandardSmoothOfRelativeDimension n A (Localization.Away s) →
      Algebra.IsSmoothAt A Q := by
    intro A T _ _ _ n Q _ s hs hstd
    haveI := hstd
    haveI : Algebra.IsStandardSmooth A (Localization.Away s) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.FormallySmooth A (Localization.Away s) := inferInstance
    letI : Algebra (Localization.Away s) (Localization.AtPrime Q) :=
      (IsLocalization.lift (M := Submonoid.powers s) (S := Localization.Away s)
        (g := algebraMap T (Localization.AtPrime Q)) (by
          rintro ⟨_, k, rfl⟩
          show IsUnit (algebraMap T (Localization.AtPrime Q) (s ^ k))
          rw [map_pow]
          exact (IsLocalization.map_units (Localization.AtPrime Q)
            (⟨s, hs⟩ : Q.primeCompl)).pow k)).toAlgebra
    haveI : IsScalarTower T (Localization.Away s) (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun t => (IsLocalization.lift_eq _ t).symm)
    haveI : IsScalarTower A (Localization.Away s) (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun a => by
        rw [IsScalarTower.algebraMap_apply A T (Localization.Away s),
          ← IsScalarTower.algebraMap_apply T (Localization.Away s) (Localization.AtPrime Q),
          ← IsScalarTower.algebraMap_apply A T (Localization.AtPrime Q)])
    have hle : Submonoid.powers s ≤ Q.primeCompl := Submonoid.powers_le.mpr hs
    haveI := IsLocalization.isLocalization_of_submonoid_le (Localization.Away s)
      (Localization.AtPrime Q) (Submonoid.powers s) Q.primeCompl hle
    haveI : Algebra.FormallySmooth (Localization.Away s) (Localization.AtPrime Q) :=
      Algebra.FormallySmooth.of_isLocalization
        (Submonoid.map (algebraMap T (Localization.Away s)) Q.primeCompl)
    exact Algebra.FormallySmooth.comp A (Localization.Away s) (Localization.AtPrime Q)

  obtain ⟨U₀, hU₀, hp, -⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens)
      (show g y ∈ (⊤ : S.Opens) from trivial)
  have hU₀' : IsAffineOpen U₀ := hU₀
  have hyU : y ∈ g ⁻¹ᵁ U₀ := hp
  obtain ⟨V₀, hV₀, hy, e⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens) hyU
  have hV₀' : IsAffineOpen V₀ := hV₀
  letI := (g.appLE U₀ V₀ e).hom.toAlgebra
  letI := (S.presheaf.germ U₀ (g y) hp ≫ S.residue (g y)).hom.toAlgebra
  haveI : Module.Flat Γ(S, U₀) Γ(Y, V₀) :=
    HasRingHomProperty.appLE @Flat g hflat ⟨U₀, hU₀'⟩ ⟨V₀, hV₀'⟩ e
  haveI : Algebra.FinitePresentation Γ(S, U₀) Γ(Y, V₀) :=
    HasRingHomProperty.appLE @LocallyOfFinitePresentation g hlfp ⟨U₀, hU₀'⟩ ⟨V₀, hV₀'⟩ e
  obtain ⟨ι, hιo, hιsnd, hcover, hprime⟩ :=
    wcpa_dj_mn_fs_fibre_chart S Y g y U₀ hU₀' hp V₀ hV₀' hy e
  have hwV : Limits.pullback.fst g (S.fromSpecResidueField (g y)) w ∈ V₀ := by
    rw [hw]; exact hy
  obtain ⟨x, hx, W', hxW', hW'sm⟩ :=
    s2 _ _ _ _ ι _ hιo hιsnd w (hcover w hwV) W hwW hWsm
  obtain ⟨s, hs, hstd⟩ := wcpa_dj_mn_fs_field_open_std (S.residueField (g y))
    (TensorProduct Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀)) 1 W' x hxW' hW'sm
  haveI : x.asIdeal.IsPrime := x.isPrime
  have hsmK := s4 (S.residueField (g y)) _ 1 x.asIdeal s hs hstd
  have hQ := hprime x (by rw [hx]; exact hw)
  have hsmA := wcpa_dj_mn_fs_fibrewise Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀) x.asIdeal
    (hV₀'.primeIdealOf ⟨y, hy⟩).asIdeal hQ hsmK
  obtain ⟨b, m, hb, hstdb⟩ := wcpa_dj_cf_ss_std_smooth_nbhd Γ(S, U₀) Γ(Y, V₀) _ hsmA
  have hm := wcpa_dj_mn_fs_reldim Γ(S, U₀) (S.residueField (g y)) Γ(Y, V₀) 1 m x.asIdeal s hs
    hstd _ hQ b hb hstdb
  subst hm
  obtain ⟨U', hU', V', hV', hyV', e', hchart⟩ :=
    wcpa_dj_cf_ss_chart_of_away Y S g 1 U₀ hU₀' V₀ hV₀' e y hy b hb hstdb
  exact ⟨V', hyV', wcpa_dj_mn_fs_chart_smooth g 1 U' hU' V' hV' e' hchart⟩

theorem wcpa_dj_nc_nonsmooth_fibre_node : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (y : ↥Z'), IsAlgClosed (IsLocalRing.ResidueField ↥W) → wcpaDjSemistable u' → LocallyOfFinitePresentation u' → u' y = IsLocalRing.closedPoint ↥W → (¬ ∃ U : Z'.Opens, y ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → wcNcNodeDatum u' y :=
by
  intro Ω _ _ W Z' u' y hk hss hlfp hy hns
  have hK : ∀ p : ↥(Spec (.of ↥W)), p = IsLocalRing.closedPoint ↥W →
      IsAlgClosed ((Spec (.of ↥W)).residueField p) := by
    intro p hp
    letI i1 : IsLocalRing ((Spec (.of ↥W)).presheaf.stalk p) := inferInstance
    letI i2 : Field ((Spec (.of ↥W)).residueField p) := inferInstance
    subst hp
    haveI : IsLocalRing ↑(CommRingCat.of ↥W) := inferInstanceAs (IsLocalRing ↥W)
    let e : (Spec (.of ↥W)).presheaf.stalk (IsLocalRing.closedPoint ↥W) ≃+* ↥W :=
      (AlgebraicGeometry.stalkClosedPointIso (CommRingCat.of ↥W)).commRingCatIsoToRingEquiv
    let e' : IsLocalRing.ResidueField ((Spec (.of ↥W)).presheaf.stalk
        (IsLocalRing.closedPoint ↥W)) ≃+* IsLocalRing.ResidueField ↥W :=
      IsLocalRing.ResidueField.mapEquiv e
    exact IsAlgClosed.of_ringEquiv (IsLocalRing.ResidueField ↥W)
      ((Spec (.of ↥W)).residueField (IsLocalRing.closedPoint ↥W)) e'.symm
  haveI : IsAlgClosed ((Spec (.of ↥W)).residueField (u' y)) := hK (u' y) hy
  obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := u') (g := (Spec (.of ↥W)).fromSpecResidueField (u' y)) y
    (IsLocalRing.closedPoint ((Spec (.of ↥W)).residueField (u' y)))
    (Scheme.fromSpecResidueField_apply _ _).symm
  rcases hss.2.2 ((Spec (.of ↥W)).residueField (u' y))
      ((Spec (.of ↥W)).fromSpecResidueField (u' y)) w with hsm | ⟨eK, heK⟩
  · exact absurd (wcpa_dj_mn_fibre_smooth _ Z' u' y w hss.1 hlfp hw hsm) hns
  · exact wcpa_dj_mn_fibre_bridge _ Z' u' y w hw ⟨eK, heK⟩

theorem wcpa_dj_lmga_valuation_henselian : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (V : ValuationSubring Ω), HenselianLocalRing ↥V :=
by
  intro Ω _ _ V
  refine ⟨fun f hf a₀ h₁ _ => ?_⟩
  have h2 : V.valuation (algebraMap V Ω (f.eval a₀)) < 1 := (V.valuation_lt_one_iff _).mp h₁
  have hsplit := IsAlgClosed.splits (f.map (algebraMap V Ω))
  have h3 := Polynomial.Splits.aeval_eq_prod_aroots_of_monic hsplit hf (algebraMap V Ω a₀)
  rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at h3
  rw [h3] at h2
  have h4 : ∃ α ∈ f.aroots Ω, V.valuation (algebraMap V Ω a₀ - α) < 1 := by
    by_contra hcon
    push_neg at hcon
    rw [map_multiset_prod, Multiset.map_map] at h2
    have : 1 ≤ ((f.aroots Ω).map (V.valuation ∘ fun α => algebraMap V Ω a₀ - α)).prod := by
      apply Multiset.one_le_prod
      intro x hx
      obtain ⟨α, hα, rfl⟩ := Multiset.mem_map.mp hx
      exact hcon α hα
    exact absurd h2 (not_lt.mpr this)
  obtain ⟨α, hα, hv⟩ := h4
  have hα' := (Polynomial.mem_aroots.mp hα).2
  have hint : _root_.IsIntegral V α := ⟨f, hf, by rwa [← Polynomial.aeval_def]⟩
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  refine ⟨y, ?_, ?_⟩
  · show Polynomial.eval y f = 0
    apply FaithfulSMul.algebraMap_injective V Ω
    rw [map_zero, ← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval, hy]
    exact hα'
  · rw [V.valuation_lt_one_iff]
    have e : ((y - a₀ : V) : Ω) = algebraMap V Ω y - algebraMap V Ω a₀ := by
      simp only [ValuationSubring.algebraMap_apply]; push_cast; rfl
    rw [e, hy, Valuation.map_sub_swap]
    exact hv

theorem wcpa_dj_ncx_affine_datum : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (x : ↥Z'), Flat u' →
    LocallyOfFinitePresentation u' → u' x = IsLocalRing.closedPoint ↥W → wcNcNodeDatum u' x →
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra (↥W) A) (j : Spec (.of A) ⟶ Z')
      (𝔮 : PrimeSpectrum A),
      IsOpenImmersion j ∧ j ≫ u' = Spec.map (CommRingCat.ofHom (algebraMap (↥W) A)) ∧ j 𝔮 = x ∧
      Algebra.FinitePresentation (↥W) A ∧ Module.Flat (↥W) A ∧
      𝔮.asIdeal.comap (algebraMap (↥W) A) = IsLocalRing.maximalIdeal ↥W ∧
      wcNcxDatum (↥W) A 𝔮.asIdeal :=
by
  intro Ω _ W Z' u' x hflat hlfp hux hdat

  have pieceA : ∀ {K K' : Type u} [CommRing K] [CommRing K'] (ρ : K ≃+* K'),
      ∃ Θ : (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) ≃+*
        (MvPowerSeries (Fin 2) K' ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      ∀ c : K, Θ (Ideal.Quotient.mk _ (MvPowerSeries.C c)) =
        Ideal.Quotient.mk _ (MvPowerSeries.C (ρ c)) := by
    intro K K' _ _ ρ
    obtain ⟨e, he⟩ : ∃ e : MvPowerSeries (Fin 2) K ≃+* MvPowerSeries (Fin 2) K',
        ∀ p, e p = MvPowerSeries.map (ρ : K →+* K') p :=
      ⟨RingEquiv.ofRingHom (MvPowerSeries.map (ρ : K →+* K'))
        (MvPowerSeries.map (ρ.symm : K' →+* K))
        (by rw [← MvPowerSeries.map_comp, RingEquiv.comp_symm, MvPowerSeries.map_id])
        (by rw [← MvPowerSeries.map_comp, RingEquiv.symm_comp, MvPowerSeries.map_id]),
        fun p => rfl⟩
    have h0 : ∀ i : Fin 2, e (MvPowerSeries.X i) = MvPowerSeries.X i := fun i => by
      rw [he]; exact MvPowerSeries.map_X _ i
    have hI : Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} =
        Ideal.map (e : MvPowerSeries (Fin 2) K →+* MvPowerSeries (Fin 2) K')
          (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) := by
      rw [Ideal.map_span, Set.image_singleton, RingEquiv.coe_toRingHom, map_mul, h0, h0]
    refine ⟨Ideal.quotientEquiv _ _ e hI, fun c => ?_⟩
    rw [Ideal.quotientEquiv_mk, he, MvPowerSeries.map_C]
    rfl

  have eqmax : ∀ {P Q : Type u} [CommRing P] [CommRing Q] [IsLocalRing P] [IsLocalRing Q]
      (e : P ≃+* Q), (IsLocalRing.maximalIdeal P).map (e : P →+* Q) =
        IsLocalRing.maximalIdeal Q := by
    intro P Q _ _ _ _ e
    exact IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv e)

  have pieceB : ∀ {R A OS O : Type u} [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A]
      (𝔮 : Ideal A) [𝔮.IsPrime] [CommRing OS] [IsLocalRing OS] [CommRing O] [IsLocalRing O]
      (f : OS →+* O) (τ : OS ≃+* R) (σ : O ≃+* Localization.AtPrime 𝔮),
      (∀ y, σ (f y) = algebraMap R (Localization.AtPrime 𝔮) (τ y)) →
      ∃ σb : (O ⧸ (IsLocalRing.maximalIdeal OS).map f) ≃+* wcNcxFib R A 𝔮,
        (∀ o : O, σb (Ideal.Quotient.mk _ o) = Ideal.Quotient.mk _ (σ o)) ∧
        ((IsLocalRing.maximalIdeal O).map
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f))).map σb =
          wcNcxFibMax R A 𝔮 := by
    intro R A OS O _ _ _ _ 𝔮 _ _ _ _ _ f τ σ hc
    have hfc : (σ : O →+* Localization.AtPrime 𝔮).comp f =
        (algebraMap R (Localization.AtPrime 𝔮)).comp (τ : OS →+* R) := RingHom.ext hc
    have hI : (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔮)) =
        ((IsLocalRing.maximalIdeal OS).map f).map (σ : O →+* Localization.AtPrime 𝔮) := by
      rw [Ideal.map_map, hfc, ← Ideal.map_map, eqmax τ]
    obtain ⟨σb, hσb⟩ : ∃ σb : (O ⧸ (IsLocalRing.maximalIdeal OS).map f) ≃+* wcNcxFib R A 𝔮,
        ∀ o : O, σb (Ideal.Quotient.mk _ o) = Ideal.Quotient.mk _ (σ o) :=
      ⟨Ideal.quotientEquiv _ _ σ hI, fun o => Ideal.quotientEquiv_mk _ _ σ hI o⟩
    have hmk : (σb : _ →+* wcNcxFib R A 𝔮).comp
        (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f)) =
        (Ideal.Quotient.mk _).comp (σ : O →+* Localization.AtPrime 𝔮) :=
      RingHom.ext (fun o => hσb o)
    have hJ : ((IsLocalRing.maximalIdeal O).map
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f))).map
          (σb : _ →+* wcNcxFib R A 𝔮) = wcNcxFibMax R A 𝔮 := by
      rw [Ideal.map_map, hmk, ← Ideal.map_map, eqmax σ]
    exact ⟨σb, hσb, hJ⟩

  have hev : ∀ {C : Type u} [CommRing C] (K : Ideal C) (n : ℕ) (c : C),
      AdicCompletion.evalₐ K n (algebraMap C (AdicCompletion K C) c) =
        Ideal.Quotient.mk (K ^ n) c := by
    intro C _ K n c
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hmap : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (f : B →+* B') (J : Ideal B)
      (J' : Ideal B'), (∀ b ∈ J, f b ∈ J') → ∃ F : AdicCompletion J B →+* AdicCompletion J' B',
      ∀ (n : ℕ) (b : B) (x : AdicCompletion J B),
        AdicCompletion.evalₐ J n x = Ideal.Quotient.mk (J ^ n) b →
        AdicCompletion.evalₐ J' n (F x) = Ideal.Quotient.mk (J' ^ n) (f b) := by
    intro B B' _ _ f J J' h
    have hn : ∀ n : ℕ, J ^ n ≤ (J' ^ n).comap f := fun n => by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr (fun b hb => h b hb)) n
    refine ⟨AdicCompletion.liftRingHom J' (fun n => (Ideal.quotientMap (J' ^ n) f (hn n)).comp
      (AdicCompletion.evalₐ J n).toRingHom) ?_, ?_⟩
    · intro m n hle
      ext x
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective J B x
      have hmm := congrArg (Ideal.quotientMap (J' ^ m) f (hn m))
        (AdicCompletion.Ideal.mk_eq_mk J hle a)
      simp only [Ideal.quotientMap_mk] at hmm
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        AdicCompletion.evalₐ_mk, Ideal.quotientMap_mk]
      rw [← hmm]
      rfl
    · intro n b x hx
      rw [AdicCompletion.evalₐ_liftRingHom]
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hx,
        Ideal.quotientMap_mk]
  have pieceT : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (τ : B ≃+* B') (J : Ideal B)
      (J' : Ideal B'), J.map τ = J' → ∃ T : AdicCompletion J B ≃+* AdicCompletion J' B',
      ∀ b : B, T (algebraMap B _ b) = algebraMap B' _ (τ b) := by
    intro B B' _ _ τ J J' hJ
    have h1 : ∀ b ∈ J, (τ : B →+* B') b ∈ J' := by
      intro b hb
      rw [← hJ]
      simpa using Ideal.mem_map_of_mem τ hb
    have h2 : ∀ z ∈ J', (τ.symm : B' →+* B) z ∈ J := by
      intro z hz
      rw [← hJ] at hz
      obtain ⟨x, hx, rfl⟩ := (Ideal.mem_map_of_equiv τ z).mp hz
      simpa using hx
    obtain ⟨F, hF⟩ := hmap (τ : B →+* B') J J' h1
    obtain ⟨G, hG⟩ := hmap (τ.symm : B' →+* B) J' J h2
    have hGF : ∀ x, G (F x) = x := fun x => AdicCompletion.ext_evalₐ (fun n => by
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n x)
      rw [hG n ((τ : B →+* B') b) (F x) (hF n b x hb.symm), ← hb]
      simp)
    have hFG : ∀ x, F (G x) = x := fun x => AdicCompletion.ext_evalₐ (fun n => by
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J' n x)
      rw [hF n ((τ.symm : B' →+* B) b) (G x) (hG n b x hb.symm), ← hb]
      simp)
    refine ⟨RingEquiv.ofRingHom F G (RingHom.ext hFG) (RingHom.ext hGF), fun b => ?_⟩
    rw [RingEquiv.ofRingHom_apply]
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hF n b _ (hev J n b), hev]
    rfl

  have pieceLg : ∀ {R A OS O : Type u} [CommRing R] [IsLocalRing R] [CommRing A] [Algebra R A]
      (𝔮 : Ideal A) [𝔮.IsPrime] [CommRing OS] [IsLocalRing OS] [CommRing O] [IsLocalRing O]
      (f : OS →+* O) (τ : OS ≃+* R) (σ : O ≃+* Localization.AtPrime 𝔮),
      (∀ y, σ (f y) = algebraMap R (Localization.AtPrime 𝔮) (τ y)) →
      (∃ ε : AdicCompletion ((IsLocalRing.maximalIdeal O).map
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f)))
          (O ⧸ (IsLocalRing.maximalIdeal OS).map f) ≃+*
          (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField OS) ⧸
            Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        ε.toRingHom.comp ((algebraMap (O ⧸ (IsLocalRing.maximalIdeal OS).map f)
          (AdicCompletion ((IsLocalRing.maximalIdeal O).map
            (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f)))
            (O ⧸ (IsLocalRing.maximalIdeal OS).map f))).comp
          ((Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f)).comp f)) =
        (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (IsLocalRing.residue OS))) →
      wcNcxDatum R A 𝔮 := by
    intro R A OS O _ _ _ _ 𝔮 _ _ _ _ _ f τ σ hc hε0
    obtain ⟨ε, hε⟩ := hε0
    obtain ⟨σb, hσb, hJ⟩ := pieceB 𝔮 f τ σ hc
    obtain ⟨T, hT⟩ := pieceT σb _ _ hJ
    obtain ⟨Θ, hΘ⟩ := pieceA (IsLocalRing.ResidueField.mapEquiv τ)
    refine ⟨T.symm.trans (ε.trans Θ), ?_⟩
    apply RingHom.ext
    intro r
    obtain ⟨y, rfl⟩ := τ.surjective r
    have e1 : algebraMap R (wcNcxFib R A 𝔮) (τ y) =
        σb (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f) (f y)) := by
      rw [hσb, hc, Ideal.Quotient.mk_algebraMap]
    have e3 : ε (algebraMap _ (AdicCompletion ((IsLocalRing.maximalIdeal O).map
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f)))
          (O ⧸ (IsLocalRing.maximalIdeal OS).map f))
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f) (f y))) =
        Ideal.Quotient.mk _ (MvPowerSeries.C (IsLocalRing.residue OS y)) :=
      RingHom.congr_fun hε y
    have hρ : IsLocalRing.ResidueField.mapEquiv τ (IsLocalRing.residue OS y) =
        IsLocalRing.residue R (τ y) :=
      IsLocalRing.ResidueField.map_residue (τ : OS →+* R) y
    have e4 : T.symm (algebraMap (wcNcxFib R A 𝔮) _ (algebraMap R (wcNcxFib R A 𝔮) (τ y))) =
        algebraMap _ (AdicCompletion ((IsLocalRing.maximalIdeal O).map
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f)))
          (O ⧸ (IsLocalRing.maximalIdeal OS).map f))
          (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal OS).map f) (f y)) := by
      rw [e1, ← hT, RingEquiv.symm_apply_apply]
    show Θ (ε (T.symm (algebraMap (wcNcxFib R A 𝔮) _ (algebraMap R (wcNcxFib R A 𝔮) (τ y))))) =
      Ideal.Quotient.mk _ (MvPowerSeries.C (IsLocalRing.residue R (τ y)))
    rw [e4, e3, hΘ, hρ]

  have pieceL1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (p : ↥(Spec (.of R))),
      p = IsLocalRing.closedPoint R →
      ∃ τ : (Spec (.of R)).presheaf.stalk p ≃+* R, ∀ r : R,
        τ.symm r = ((Spec (.of R)).presheaf.germ ⊤ p trivial).hom
          ((Scheme.ΓSpecIso (.of R)).inv.hom r) := by
    intro R _ _ p hp
    subst hp
    refine ⟨(stalkClosedPointIso (.of R)).commRingCatIsoToRingEquiv, fun r => ?_⟩
    have h := ΓSpecIso_hom_stalkClosedPointIso_inv (.of R)
    have h2 : (stalkClosedPointIso (.of R)).inv = (Scheme.ΓSpecIso (.of R)).inv ≫
        (Spec (.of R)).presheaf.germ ⊤ (IsLocalRing.closedPoint R) trivial := by
      rw [← h, Iso.inv_hom_id_assoc]
    change (stalkClosedPointIso (.of R)).inv.hom r = _
    rw [h2]
    rfl

  obtain ⟨V, hV, hxV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (U := (⊤ : Z'.Opens)) (x := x) trivial
  let ψ : CommRingCat.of ↥W ⟶ Γ(Z', V) := (Scheme.ΓSpecIso (.of ↥W)).inv ≫ u'.appLE ⊤ V le_top
  letI : Algebra ↥W Γ(Z', V) := ψ.hom.toAlgebra
  have hsq : hV.fromSpec ≫ u' = Spec.map ψ := by
    rw [← IsAffineOpen.SpecMap_appLE_fromSpec u' (isAffineOpen_top (Spec (.of ↥W))) hV le_top,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp]

  have L2 : ∀ s : Γ(Spec (.of ↥W), ⊤),
      (u'.stalkMap x).hom (((Spec (.of ↥W)).presheaf.germ ⊤ (u' x) trivial).hom s) =
        (Z'.presheaf.germ V x hxV).hom ((u'.appLE ⊤ V le_top).hom s) := by
    intro s
    have e1 := Scheme.Hom.germ_stalkMap u' ⊤ x trivial
    have e2 : u'.appLE ⊤ V le_top =
        u'.app ⊤ ≫ Z'.presheaf.map (homOfLE (show V ≤ u' ⁻¹ᵁ ⊤ from le_top)).op := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    have e3 : u'.appLE ⊤ V le_top ≫ Z'.presheaf.germ V x hxV =
        (Spec (.of ↥W)).presheaf.germ ⊤ (u' x) trivial ≫ u'.stalkMap x := by
      rw [e1, e2, Category.assoc, TopCat.Presheaf.germ_res]
    exact (congrArg (fun φ => φ.hom s) e3).symm
  set 𝔮 := hV.primeIdealOf ⟨x, hxV⟩ with h𝔮

  letI : Algebra Γ(Z', V) (Z'.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk Z'.presheaf ⟨x, hxV⟩
  haveI hloc : IsLocalization.AtPrime (Z'.presheaf.stalk x) 𝔮.asIdeal :=
    hV.isLocalization_stalk ⟨x, hxV⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : Z'.presheaf.stalk x ≃+* Localization.AtPrime 𝔮.asIdeal,
      ∀ a : Γ(Z', V), σ ((Z'.presheaf.germ V x hxV).hom a) =
        algebraMap Γ(Z', V) (Localization.AtPrime 𝔮.asIdeal) a :=
    ⟨(IsLocalization.algEquiv 𝔮.asIdeal.primeCompl (Z'.presheaf.stalk x)
      (Localization.AtPrime 𝔮.asIdeal)).toRingEquiv, fun a =>
      (IsLocalization.algEquiv 𝔮.asIdeal.primeCompl (Z'.presheaf.stalk x)
        (Localization.AtPrime 𝔮.asIdeal)).commutes a⟩
  obtain ⟨τ, hτ⟩ := pieceL1 ↥W (u' x) hux
  have hc : ∀ y, σ ((u'.stalkMap x).hom y) =
      algebraMap ↥W (Localization.AtPrime 𝔮.asIdeal) (τ y) := by
    intro y
    obtain ⟨r, rfl⟩ := τ.symm.surjective y
    rw [RingEquiv.apply_symm_apply, hτ r, L2, hσ]
    exact (IsScalarTower.algebraMap_apply ↥W Γ(Z', V) (Localization.AtPrime 𝔮.asIdeal) r).symm

  have hlfpj : LocallyOfFinitePresentation (Spec.map ψ) := by rw [← hsq]; infer_instance
  have hflj : Flat (Spec.map ψ) := by rw [← hsq]; infer_instance
  have hfp : RingHom.FinitePresentation ψ.hom :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mp hlfpj
  have hfl : RingHom.Flat ψ.hom := (HasRingHomProperty.Spec_iff (P := @Flat)).mp hflj

  have hf : 𝔮.asIdeal.comap ψ.hom = IsLocalRing.maximalIdeal ↥W := by
    have h0 : hV.fromSpec 𝔮 = x := hV.fromSpec_primeIdealOf ⟨x, hxV⟩
    have h1 : u' (hV.fromSpec 𝔮) = IsLocalRing.closedPoint ↥W := by rw [h0]; exact hux
    have h3 := Scheme.Hom.comp_apply hV.fromSpec u' 𝔮
    rw [hsq] at h3
    have h2 : Spec.map ψ 𝔮 = IsLocalRing.closedPoint ↥W := h3.trans h1
    exact congrArg PrimeSpectrum.asIdeal h2
  exact ⟨Γ(Z', V), inferInstance, ψ.hom.toAlgebra, hV.fromSpec, 𝔮,
    hV.isOpenImmersion_fromSpec, hsq, hV.fromSpec_primeIdealOf ⟨x, hxV⟩, hfp, hfl, hf,
    pieceLg 𝔮.asIdeal (u'.stalkMap x).hom τ σ hc hdat⟩

theorem wcpa_dj_ncx_node_levels (R : Type u) [CommRing R] [IsLocalRing R]
    (A : Type u) [CommRing A] [Algebra R A] [Algebra.FiniteType R A]
    (𝔮 : Ideal A) [𝔮.IsPrime] (h𝔮 : 𝔮.comap (algebraMap R A) = IsLocalRing.maximalIdeal R)
    (hdat : wcNcxDatum R A 𝔮) : wcNcxLevels R A 𝔮 :=
by

  have psChar : ∀ (k : Type u) [Field k] (n : ℕ) (f : MvPowerSeries (Fin 2) k),
      f ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ⊔
        Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} ^ n : Ideal (MvPowerSeries (Fin 2) k)) ↔
      ∀ a < n, ∀ i : Fin 2, MvPowerSeries.coeff (Finsupp.single i a) f = 0 := by
    intro k _ n f
    classical
    let D : ℕ → Ideal (MvPowerSeries (Fin 2) k) := fun n =>
      { carrier := {f | ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < n → MvPowerSeries.coeff d f = 0}
        add_mem' := by
          intro f g hf hg d hd
          rw [map_add, hf d hd, hg d hd, add_zero]
        zero_mem' := by
          intro d hd
          simp
        smul_mem' := by
          intro c f hf d hd
          rw [smul_eq_mul, MvPowerSeries.coeff_mul]
          apply Finset.sum_eq_zero
          intro x hx
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
          have hle : x.2 ≤ d := hx ▸ le_add_self
          have h0 := Finsupp.le_def.mp hle 0
          have h1 := Finsupp.le_def.mp hle 1
          rw [hf x.2 (by omega), mul_zero] }
    have hXmul : ∀ (i : Fin 2) (y : MvPowerSeries (Fin 2) k) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (MvPowerSeries.X i * y) =
          if Finsupp.single i 1 ≤ d then MvPowerSeries.coeff (d - Finsupp.single i 1) y else 0 := by
      intro i y d
      rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, one_mul]
    have hIn : ∀ n, Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} ^ n ≤ D n := by
      intro n
      induction n with
      | zero =>
        intro f _ d hd
        omega
      | succ n ih =>
        rw [pow_succ']
        refine le_trans (Ideal.mul_mono_right ih) ?_
        rw [Submodule.mul_le]
        intro m hm y hy
        obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.mp hm
        have hXi : ∀ i : Fin 2, MvPowerSeries.X i * y ∈ D (n + 1) := by
          intro i d hd
          rw [hXmul]
          split_ifs with hle
          · apply hy
            have h0 := Finsupp.le_def.mp hle 0
            have h1 := Finsupp.le_def.mp hle 1
            rw [Finsupp.tsub_apply, Finsupp.tsub_apply]
            fin_cases i <;> simp at h0 h1 ⊢ <;> omega
          · rfl
        rw [add_mul, mul_assoc, mul_assoc]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hXi 0)) (Ideal.mul_mem_left _ _ (hXi 1))
    let E : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
    have hE : ∀ m : Fin 2 →₀ ℕ, E ≤ m ↔ 1 ≤ m 0 ∧ 1 ≤ m 1 := by
      intro m
      rw [Finsupp.le_def]
      constructor
      · intro h
        have h0 := h 0
        have h1 := h 1
        simp [E] at h0 h1
        exact ⟨h0, h1⟩
      · rintro ⟨h0, h1⟩ i
        fin_cases i <;> simp [E] <;> assumption
    have hXX : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k) =
        MvPowerSeries.monomial E 1 := by
      rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, one_mul]
    have hsplit : ∀ d : Fin 2 →₀ ℕ, d = Finsupp.single 0 (d 0) + Finsupp.single 1 (d 1) := by
      intro d; ext i; fin_cases i <;> simp
    constructor
    · intro hf a ha i
      obtain ⟨q, hq, b, hb, rfl⟩ := Submodule.mem_sup.mp hf
      obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton'.mp hq
      rw [map_add, mul_comm, hXX, MvPowerSeries.coeff_monomial_mul]
      rw [hIn n hb (Finsupp.single i a) (by fin_cases i <;> simp <;> omega)]
      rw [if_neg]
      · simp
      · rw [hE]
        fin_cases i <;> simp
    · intro hf
      let h : MvPowerSeries (Fin 2) k := fun d => MvPowerSeries.coeff (d + E) f
      have hcXh : ∀ d, MvPowerSeries.coeff d (MvPowerSeries.X 0 * MvPowerSeries.X 1 * h) =
          if E ≤ d then MvPowerSeries.coeff d f else 0 := by
        intro d
        rw [hXX, MvPowerSeries.coeff_monomial_mul, one_mul]
        split_ifs with hle
        · show MvPowerSeries.coeff (d - E + E) f = _
          rw [tsub_add_cancel_of_le hle]
        · rfl
      let b : MvPowerSeries (Fin 2) k := f - MvPowerSeries.X 0 * MvPowerSeries.X 1 * h
      have hb : ∀ d, MvPowerSeries.coeff d b = if E ≤ d then 0 else MvPowerSeries.coeff d f := by
        intro d
        show MvPowerSeries.coeff d (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 * h) = _
        rw [map_sub, hcXh]
        split_ifs <;> simp
      let b0 : MvPowerSeries (Fin 2) k := fun d => if d 1 = 0 then MvPowerSeries.coeff d b else 0
      have hb0 : MvPowerSeries.X 0 ^ n ∣ b0 := by
        rw [MvPowerSeries.X_pow_dvd_iff]
        intro m hm
        show (if m 1 = 0 then MvPowerSeries.coeff m b else 0) = 0
        split_ifs with h1
        · rw [hb]
          split_ifs
          · rfl
          · rw [hsplit m, h1, Finsupp.single_zero, add_zero]
            exact hf _ hm 0
        · rfl
      have hb1 : MvPowerSeries.X 1 ^ n ∣ (b - b0) := by
        rw [MvPowerSeries.X_pow_dvd_iff]
        intro m hm
        rw [map_sub]
        show MvPowerSeries.coeff m b - (if m 1 = 0 then MvPowerSeries.coeff m b else 0) = 0
        split_ifs with h1
        · exact sub_self _
        · rw [sub_zero, hb]
          split_ifs with hle
          · rfl
          · have h0 : m 0 = 0 := by
              rw [hE] at hle
              omega
            rw [hsplit m, h0, Finsupp.single_zero, zero_add]
            exact hf _ hm 1
      have hfeq : f = MvPowerSeries.X 0 * MvPowerSeries.X 1 * h + (b0 + (b - b0)) := by
        show f = MvPowerSeries.X 0 * MvPowerSeries.X 1 * h +
          (b0 + ((f - MvPowerSeries.X 0 * MvPowerSeries.X 1 * h) - b0))
        ring
      rw [hfeq]
      refine Submodule.add_mem_sup (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)) ?_
      obtain ⟨c0, hc0⟩ := hb0
      obtain ⟨c1, hc1⟩ := hb1
      rw [hc1, hc0]
      exact Ideal.add_mem _
        (Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) n))
        (Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) n))

  have trunc : ∀ (k : Type u) [Field k] (n : ℕ),
      ∃ e : (MvPowerSeries (Fin 2) k ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ⊔
        Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} ^ n : Ideal (MvPowerSeries (Fin 2) k))) ≃+*
      (MvPolynomial (Fin 2) k ⧸ (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n : Ideal (MvPolynomial (Fin 2) k))),
      ∀ a : k, e (Ideal.Quotient.mk _ (MvPowerSeries.C a)) = Ideal.Quotient.mk _ (MvPolynomial.C a) := by
    intro k _ n
    classical
    have psC := psChar k n
    set Ips : Ideal (MvPowerSeries (Fin 2) k) := Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ⊔
      Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} ^ n with hIps
    set Ipol : Ideal (MvPolynomial (Fin 2) k) := Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
      Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n with hIpol
    have hsplit : ∀ d : Fin 2 →₀ ℕ, d = Finsupp.single 0 (d 0) + Finsupp.single 1 (d 1) := by
      intro d; ext i; fin_cases i <;> simp
    have T2 : ∀ p : MvPolynomial (Fin 2) k,
        (∀ a < n, ∀ i : Fin 2, p.coeff (Finsupp.single i a) = 0) → p ∈ Ipol := by
      intro p hp
      rw [MvPolynomial.as_sum p]
      apply Ideal.sum_mem
      intro v hv
      rw [MvPolynomial.mem_support_iff] at hv
      by_cases hv01 : 1 ≤ v 0 ∧ 1 ≤ v 1
      · apply Ideal.mem_sup_left
        have hv' : Finsupp.single 0 1 + Finsupp.single 1 1 +
            (v - (Finsupp.single 0 1 + Finsupp.single 1 1)) = v := by
          ext i; fin_cases i <;> simp <;> omega
        have : ∀ c : k, MvPolynomial.monomial v c =
            (MvPolynomial.X 0 * MvPolynomial.X 1) *
              MvPolynomial.monomial (v - (Finsupp.single 0 1 + Finsupp.single 1 1)) c := by
          intro c
          rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul_monomial,
            MvPolynomial.monomial_mul_monomial, one_mul, one_mul, hv']
        rw [this]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      · apply Ideal.mem_sup_right
        have hax : ∃ i : Fin 2, v = Finsupp.single i (v i) := by
          by_cases h0 : v 0 = 0
          · refine ⟨1, ?_⟩
            conv_lhs => rw [hsplit v, h0, Finsupp.single_zero, zero_add]
          · refine ⟨0, ?_⟩
            have h1 : v 1 = 0 := by omega
            conv_lhs => rw [hsplit v, h1, Finsupp.single_zero, add_zero]
        obtain ⟨i, hi⟩ := hax
        have hn : n ≤ v i := by
          by_contra hlt
          exact hv (by rw [hi]; exact hp (v i) (by omega) i)
        have : MvPolynomial.monomial v (p.coeff v) =
            MvPolynomial.X i ^ n * MvPolynomial.monomial (Finsupp.single i (v i - n)) (p.coeff v) := by
          rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul_monomial, one_mul,
            ← Finsupp.single_add, Nat.add_sub_cancel' hn, ← hi]
        rw [this]
        exact Ideal.mul_mem_right _ _
          (Ideal.pow_mem_pow (Ideal.subset_span (by fin_cases i <;> simp)) n)
    let ψ : MvPolynomial (Fin 2) k →+* MvPowerSeries (Fin 2) k ⧸ Ips :=
      (Ideal.Quotient.mk Ips).comp MvPolynomial.coeToMvPowerSeries.ringHom
    have hψ : ∀ p, ψ p = Ideal.Quotient.mk Ips (p : MvPowerSeries (Fin 2) k) := fun p => rfl
    have hker : RingHom.ker ψ = Ipol := by
      ext p
      rw [RingHom.mem_ker, hψ, Ideal.Quotient.eq_zero_iff_mem, psC]
      simp only [MvPolynomial.coeff_coe]
      constructor
      · exact T2 p
      · intro hp
        have hmap : Ideal.map (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin 2) (R := k))
            Ipol ≤ Ips := by
          rw [hIpol, Ideal.map_sup, Ideal.map_pow, Ideal.map_span, Ideal.map_span]
          simp only [Set.image_singleton, Set.image_insert_eq,
            MvPolynomial.coeToMvPowerSeries.ringHom_apply, MvPolynomial.coe_mul, MvPolynomial.coe_X]
          exact le_rfl
        have := hmap (Ideal.mem_map_of_mem _ hp)
        rw [MvPolynomial.coeToMvPowerSeries.ringHom_apply, psC] at this
        simpa [MvPolynomial.coeff_coe] using this
    have hsurj : Function.Surjective ψ := by
      intro z
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
      refine ⟨MvPowerSeries.trunc' k (Finsupp.single 0 (n - 1) + Finsupp.single 1 (n - 1)) f, ?_⟩
      rw [hψ, Ideal.Quotient.eq, psC]
      intro a ha i
      rw [map_sub, MvPolynomial.coeff_coe, MvPowerSeries.coeff_trunc', if_pos, sub_self]
      rw [Finsupp.le_def]
      intro j
      fin_cases i <;> fin_cases j <;> simp <;> omega
    let c : (MvPolynomial (Fin 2) k ⧸ Ipol) ≃+* (MvPowerSeries (Fin 2) k ⧸ Ips) :=
      (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
    have hc : ∀ p, c (Ideal.Quotient.mk Ipol p) = ψ p := by
      intro p
      show RingHom.quotientKerEquivOfSurjective hsurj (Ideal.quotEquivOfEq hker.symm
        (Ideal.Quotient.mk Ipol p)) = _
      rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
    refine ⟨c.symm, fun a => ?_⟩
    rw [RingEquiv.symm_apply_eq, hc, hψ, MvPolynomial.coe_C]

  have nodeMax : ∀ (k : Type u) [Field k]
      (J : Ideal (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})),
      J ≠ ⊤ → (∀ y, y ∉ J → IsUnit y) →
      J = Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
        (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1}) := by
    intro k _ J hJ hJu
    classical
    set Q : Ideal (MvPowerSeries (Fin 2) k) := Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}
    set I : Ideal (MvPowerSeries (Fin 2) k) := Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1}
    have hI : ∀ f, f ∈ I ↔ MvPowerSeries.constantCoeff f = 0 := by
      intro f
      constructor
      · intro hf
        have : I ≤ RingHom.ker (MvPowerSeries.constantCoeff (σ := Fin 2) (R := k)) := by
          rw [Ideal.span_le]
          intro x hx
          rcases hx with rfl | hx
          · exact MvPowerSeries.constantCoeff_X 0
          · rw [Set.mem_singleton_iff] at hx
            rw [hx]
            exact MvPowerSeries.constantCoeff_X 1
        exact this hf
      · intro hf
        let g0 : MvPowerSeries (Fin 2) k := fun d => MvPowerSeries.coeff (d + Finsupp.single 0 1) f
        let g1 : MvPowerSeries (Fin 2) k := fun d =>
          if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 1) f else 0
        have heq : f = g0 * MvPowerSeries.X 0 + g1 * MvPowerSeries.X 1 := by
          ext d
          rw [map_add, mul_comm g0, mul_comm g1, MvPowerSeries.X_def, MvPowerSeries.X_def,
            MvPowerSeries.coeff_monomial_mul, MvPowerSeries.coeff_monomial_mul, one_mul, one_mul]
          by_cases h0 : 1 ≤ d 0
          · rw [if_pos (Finsupp.single_le_iff.mpr h0)]
            show _ = MvPowerSeries.coeff (d - Finsupp.single 0 1 + Finsupp.single 0 1) f + _
            rw [tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr h0)]
            split_ifs with h1
            · show _ = _ + (if (d - Finsupp.single 1 1 : Fin 2 →₀ ℕ) 0 = 0 then _ else 0)
              rw [Finsupp.tsub_apply, if_neg (by simp; omega), add_zero]
            · rw [add_zero]
          · rw [if_neg (fun h => h0 (Finsupp.single_le_iff.mp h)), zero_add]
            have hd0 : d 0 = 0 := by omega
            split_ifs with h1
            · show _ = (if (d - Finsupp.single 1 1 : Fin 2 →₀ ℕ) 0 = 0 then
                MvPowerSeries.coeff (d - Finsupp.single 1 1 + Finsupp.single 1 1) f else 0)
              rw [Finsupp.tsub_apply, if_pos (by simp [hd0]),
                tsub_add_cancel_of_le h1]
            · have h1' : ¬ 1 ≤ d 1 := fun h => h1 (Finsupp.single_le_iff.mpr h)
              have hd : d = 0 := by
                ext i; fin_cases i <;> simp <;> omega
              rw [hd, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hf]
        rw [heq]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
          (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
    have hQI : Q ≤ I := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
    have hcomap : Ideal.comap (Ideal.Quotient.mk Q) (Ideal.map (Ideal.Quotient.mk Q) I) = I := by
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr hQI
    have hntop : Ideal.map (Ideal.Quotient.mk Q) I ≠ ⊤ := by
      intro h
      have h1 : (1 : MvPowerSeries (Fin 2) k) ∈ I := by
        rw [← hcomap, h]; trivial
      rw [hI, map_one] at h1
      exact one_ne_zero h1
    have hunit : ∀ y, y ∉ Ideal.map (Ideal.Quotient.mk Q) I → IsUnit y := by
      intro y hy
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hf : f ∉ I := fun h => hy (Ideal.mem_map_of_mem _ h)
      rw [hI] at hf
      have : IsUnit f := MvPowerSeries.isUnit_iff_constantCoeff.mpr (Ne.isUnit hf)
      exact this.map _
    apply le_antisymm
    · intro y hy
      by_contra hn
      exact hJ (Ideal.eq_top_of_isUnit_mem _ hy (hunit y hn))
    · intro y hy
      by_contra hn
      exact hntop (Ideal.eq_top_of_isUnit_mem _ hy (hJu y hn))

  have compl : ∀ (P : Type u) [CommRing P] (I : Ideal P), I.FG → I ≠ ⊤ →
      (∀ x : P, x ∉ I → IsUnit x) →
      (I.map (algebraMap P (AdicCompletion I P)) ≠ ⊤ ∧
        ∀ c : AdicCompletion I P, c ∉ I.map (algebraMap P (AdicCompletion I P)) → IsUnit c) ∧
      ∀ n : ℕ, ∃ e : (P ⧸ I ^ n) ≃+*
          (AdicCompletion I P ⧸ I.map (algebraMap P (AdicCompletion I P)) ^ n),
        ∀ p : P, e (Ideal.Quotient.mk _ p) =
          Ideal.Quotient.mk _ (algebraMap P (AdicCompletion I P) p) := by
    intro P _ I hfg hI hIu
    have hmem : ∀ (k : ℕ) (b : AdicCompletion I P),
        b ∈ Ideal.map (algebraMap P (AdicCompletion I P)) (I ^ k) ↔
        AdicCompletion.eval I P k b = 0 := by
      intro k b
      have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := P) (n := k) hfg
      have h2 := Ideal.smul_top_eq_map (S := AdicCompletion I P) (I ^ k)
      have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
      rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
      exact h3
    have hof : ∀ (k : ℕ) (p : P), AdicCompletion.eval I P k (algebraMap P (AdicCompletion I P) p) =
        Submodule.Quotient.mk p := by
      intro k p
      change AdicCompletion.eval I P k (AdicCompletion.of I P p) = _
      rw [AdicCompletion.eval_of]
      rfl
    have hsurj : ∀ (k : ℕ) (c : AdicCompletion I P), ∃ p : P,
        c - algebraMap P (AdicCompletion I P) p ∈
          Ideal.map (algebraMap P (AdicCompletion I P)) (I ^ k) := by
      intro k c
      obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective _ (AdicCompletion.eval I P k c)
      refine ⟨a, (hmem k _).mpr ?_⟩
      rw [map_sub, hof, ha, sub_self]
    have hinj : ∀ (k : ℕ) (p : P),
        algebraMap P (AdicCompletion I P) p ∈ Ideal.map (algebraMap P (AdicCompletion I P)) (I ^ k) →
        p ∈ I ^ k := by
      intro k p hp
      rw [hmem, hof, Submodule.Quotient.mk_eq_zero] at hp
      have hle : I ^ k • (⊤ : Submodule P P) ≤ I ^ k := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      exact hle hp
    have hone : (1 : AdicCompletion I P) ∉ Ideal.map (algebraMap P (AdicCompletion I P)) I := by
      intro h
      have e : Ideal.map (algebraMap P (AdicCompletion I P)) (I ^ 1) =
          Ideal.map (algebraMap P (AdicCompletion I P)) I := by rw [pow_one]
      rw [← map_one (algebraMap P (AdicCompletion I P)), ← e] at h
      exact hI ((Ideal.eq_top_iff_one _).mpr (by simpa using hinj 1 1 h))
    haveI := AdicCompletion.isAdicComplete_self I hfg
    have hjac := IsAdicComplete.le_jacobson_bot (Ideal.map (algebraMap P (AdicCompletion I P)) I)
    refine ⟨⟨fun h => hone (h ▸ Submodule.mem_top), fun c hc => ?_⟩, fun n => ?_⟩
    · obtain ⟨a, ha⟩ := hsurj 1 c
      rw [pow_one] at ha
      have haI : a ∉ I := by
        intro haI
        apply hc
        have := Ideal.add_mem _ ha (Ideal.mem_map_of_mem (algebraMap P (AdicCompletion I P)) haI)
        rwa [sub_add_cancel] at this
      have hu : IsUnit (algebraMap P (AdicCompletion I P) a) := (hIu a haI).map _
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have hx := Ideal.mem_jacobson_bot.mp (hjac ha) v
      have heq : (c - algebraMap P (AdicCompletion I P) a) * v + 1 = c * v := by
        rw [sub_mul, hv]; ring
      rw [heq] at hx
      exact isUnit_of_mul_isUnit_left hx
    · have hpow : Ideal.map (algebraMap P (AdicCompletion I P)) I ^ n =
          Ideal.map (algebraMap P (AdicCompletion I P)) (I ^ n) := (Ideal.map_pow _ _ _).symm
      have hle : I ^ n ≤ Ideal.comap (algebraMap P (AdicCompletion I P))
          (Ideal.map (algebraMap P (AdicCompletion I P)) I ^ n) := by
        rw [hpow]; exact Ideal.le_comap_map
      let φ := Ideal.quotientMap (Ideal.map (algebraMap P (AdicCompletion I P)) I ^ n)
        (algebraMap P (AdicCompletion I P)) hle
      have hφ : ∀ p, φ (Ideal.Quotient.mk _ p) =
          Ideal.Quotient.mk _ (algebraMap P (AdicCompletion I P) p) := fun p =>
        Ideal.quotientMap_mk
      have hbij : Function.Bijective φ := by
        constructor
        · rw [injective_iff_map_eq_zero]
          intro z hz
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          rw [hφ, Ideal.Quotient.eq_zero_iff_mem, hpow] at hz
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (hinj n p hz)
        · intro z
          obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective z
          obtain ⟨p, hp⟩ := hsurj n c
          refine ⟨Ideal.Quotient.mk _ p, ?_⟩
          rw [hφ, Ideal.Quotient.eq, hpow]
          rw [← neg_sub]
          exact neg_mem_iff.mpr hp
      exact ⟨RingEquiv.ofBijective φ hbij, fun p => hφ p⟩

  have hfib : IsNoetherianRing (wcNcxFib R A 𝔮) ∧ wcNcxFibMax R A 𝔮 ≠ ⊤ ∧
      ∀ x : wcNcxFib R A 𝔮, x ∉ wcNcxFibMax R A 𝔮 → IsUnit x := by
    refine ⟨?_, ?_⟩
    · letI : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
      haveI : Algebra.FiniteType R (A ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R A)) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R _)
          (Ideal.Quotient.mkₐ_surjective R _)
      haveI : Algebra.FiniteType (R ⧸ IsLocalRing.maximalIdeal R)
          (A ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R A)) :=
        Algebra.FiniteType.of_restrictScalars_finiteType R _ _
      haveI : IsNoetherianRing (A ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R A)) :=
        Algebra.FiniteType.isNoetherianRing (R ⧸ IsLocalRing.maximalIdeal R) _
      have hmm : ((IsLocalRing.maximalIdeal R).map (algebraMap R A)).map
          (algebraMap A (Localization.AtPrime 𝔮)) =
          (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔮)) := by
        rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
      have hK : (IsLocalRing.maximalIdeal R).map (algebraMap R A) ≤
          ((IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔮))).comap
            (algebraMap A (Localization.AtPrime 𝔮)) :=
        Ideal.map_le_iff_le_comap.mp (le_of_eq hmm)
      letI : Algebra (A ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R A)) (wcNcxFib R A 𝔮) :=
        (Ideal.quotientMap _ (algebraMap A (Localization.AtPrime 𝔮)) hK).toAlgebra
      have hloc := IsLocalization.of_surjective 𝔮.primeCompl (Localization.AtPrime 𝔮)
        (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map (algebraMap R A)))
        Ideal.Quotient.mk_surjective
        (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
          (algebraMap R (Localization.AtPrime 𝔮))))
        Ideal.Quotient.mk_surjective (RingHom.ext fun x => rfl)
        (by rw [Ideal.mk_ker, Ideal.mk_ker, hmm])
      haveI := hloc
      exact IsLocalization.isNoetherianRing
        (Submonoid.map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map (algebraMap R A)))
          𝔮.primeCompl) (wcNcxFib R A 𝔮) inferInstance
    · have hKle : (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔮)) ≤
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R A (Localization.AtPrime 𝔮),
          IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮]
        rw [← h𝔮] at hr
        exact hr
      have hmax : (wcNcxFibMax R A 𝔮).IsMaximal :=
        Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective
          (by rw [Ideal.mk_ker]; exact hKle)
      refine ⟨hmax.ne_top, fun x hx => ?_⟩
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hz : z ∉ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := fun h =>
        hx (Ideal.mem_map_of_mem _ h)
      exact (IsLocalRing.notMem_maximalIdeal.mp hz).map _

  obtain ⟨hnoeth, hM, hMu⟩ := hfib
  have hfg : (wcNcxFibMax R A 𝔮).FG := (isNoetherianRing_iff.mp hnoeth).noetherian _
  obtain ⟨⟨hMh, hMhu⟩, hlev⟩ := compl _ (wcNcxFibMax R A 𝔮) hfg hM hMu
  obtain ⟨ε, hε⟩ := hdat
  set k := IsLocalRing.ResidueField R
  set Q : Ideal (MvPowerSeries (Fin 2) k) := Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}
  set I : Ideal (MvPowerSeries (Fin 2) k) := Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1}
  set Mh := (wcNcxFibMax R A 𝔮).map
    (algebraMap (wcNcxFib R A 𝔮) (AdicCompletion (wcNcxFibMax R A 𝔮) (wcNcxFib R A 𝔮))) with hMhdef
  have hJ : Ideal.map (ε : _ →+* _) Mh = Ideal.map (Ideal.Quotient.mk Q) I := by
    apply nodeMax k
    · intro h
      apply hMh
      rw [Ideal.eq_top_iff_one] at h ⊢
      obtain ⟨x, hx, hx1⟩ := (Ideal.mem_map_of_equiv ε (1 : MvPowerSeries (Fin 2) k ⧸ Q)).mp h
      have : x = 1 := ε.injective (by rw [hx1, map_one])
      rw [← this]
      exact hx
    · intro y hy
      have hy' : ε.symm y ∉ Mh := by
        intro hm
        apply hy
        exact (Ideal.mem_map_of_equiv ε y).mpr ⟨_, hm, ε.apply_symm_apply y⟩
      have := (hMhu _ hy').map ε
      rw [RingEquiv.apply_symm_apply] at this
      exact this
  intro n
  obtain ⟨e₁, he₁⟩ := hlev n
  have h2 : Ideal.map (Ideal.Quotient.mk Q) (I ^ n) = Ideal.map (ε : _ →+* _) (Mh ^ n) := by
    rw [Ideal.map_pow, Ideal.map_pow, hJ]
  let e₂ := Ideal.quotientEquiv (Mh ^ n) (Ideal.map (Ideal.Quotient.mk Q) (I ^ n)) ε h2
  let e₃ := DoubleQuot.quotQuotEquivQuotSup Q (I ^ n)
  obtain ⟨e₄, he₄⟩ := trunc k n
  let e := e₁.trans (e₂.trans (e₃.trans e₄))
  refine ⟨AlgEquiv.ofRingEquiv (f := e) fun r => ?_⟩
  have hr : algebraMap R (MvPolynomial (Fin 2) k ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}) ^ n : Ideal (MvPolynomial (Fin 2) k))) r =
      Ideal.Quotient.mk _ (MvPolynomial.C (IsLocalRing.residue R r)) := by
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_apply,
      IsLocalRing.ResidueField.algebraMap_eq]
  rw [hr]
  change e₄ (e₃ (e₂ (e₁ (Ideal.Quotient.mk _ (algebraMap R (wcNcxFib R A 𝔮) r))))) = _
  rw [he₁]
  have h3 : e₂ (Ideal.Quotient.mk _ (algebraMap (wcNcxFib R A 𝔮)
      (AdicCompletion (wcNcxFibMax R A 𝔮) (wcNcxFib R A 𝔮)) (algebraMap R (wcNcxFib R A 𝔮) r))) =
      DoubleQuot.quotQuotMk Q (I ^ n) (MvPowerSeries.C (IsLocalRing.residue R r)) := by
    show Ideal.Quotient.mk _ (ε _) = _
    have := RingHom.congr_fun hε r
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this
    rw [this]
    rfl
  rw [h3, DoubleQuot.quotQuotEquivQuotSup_quotQuotMk, he₄]

theorem wcpa_dj_ncxc_levels_consequences (R : Type u) [CommRing R] [IsLocalRing R]
    (A : Type u) [CommRing A] [Algebra R A]
    (𝔮 : Ideal A) [𝔮.IsPrime] (h𝔮 : 𝔮.comap (algebraMap R A) = IsLocalRing.maximalIdeal R)
    (hlev : wcNcxLevels R A 𝔮) :
    Function.Surjective ((Ideal.Quotient.mk 𝔮).comp (algebraMap R A)) ∧
    ∃ x ∈ 𝔮, ∃ y ∈ 𝔮, ∀ z ∈ 𝔮, ∃ w ∉ 𝔮, w * z ∈ Ideal.span {x, y} ⊔ 𝔮 ^ 2 ⊔
      Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) :=
by
  classical
  unfold wcNcxLevels wcNcxFib wcNcxFibMax at hlev

  have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) =
      Ideal.map (algebraMap A (Localization.AtPrime 𝔮)) 𝔮 :=
    (Localization.AtPrime.map_eq_maximalIdeal).symm
  have hP' : Ideal.map (algebraMap R (Localization.AtPrime 𝔮)) (IsLocalRing.maximalIdeal R) =
      Ideal.map (algebraMap A (Localization.AtPrime 𝔮))
        (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R)) := by
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq R A (Localization.AtPrime 𝔮)]
  set P := Ideal.map (algebraMap R (Localization.AtPrime 𝔮))
    (IsLocalRing.maximalIdeal R) with hPdef
  set 𝔫 := Ideal.map (Ideal.Quotient.mk P)
    (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) with h𝔫def

  let cl : ∀ n : ℕ, A →+* (Localization.AtPrime 𝔮 ⧸ P) ⧸ 𝔫 ^ n := fun n =>
    (Ideal.Quotient.mk (𝔫 ^ n)).comp
      ((Ideal.Quotient.mk P).comp (algebraMap A (Localization.AtPrime 𝔮)))
  have hmA : Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ≤ 𝔮 :=
    Ideal.map_le_iff_le_comap.mpr h𝔮.ge
  have hnm : ∀ a b : A, a ∉ 𝔮 → b ∉ 𝔮 → a * b ∉ 𝔮 := fun a b ha hb h =>
    (‹𝔮.IsPrime›.mem_or_mem h).elim ha hb

  have hC : ∀ (n : ℕ) (r : R), cl n (algebraMap R A r) = algebraMap R _ r := by
    intro n r
    show Ideal.Quotient.mk (𝔫 ^ n) (Ideal.Quotient.mk P
      (algebraMap A (Localization.AtPrime 𝔮) (algebraMap R A r))) = _
    rw [← IsScalarTower.algebraMap_apply R A (Localization.AtPrime 𝔮),
      Ideal.Quotient.mk_algebraMap, Ideal.Quotient.mk_algebraMap]

  have hK : ∀ (n : ℕ) (t : A), cl n t = 0 →
      ∃ w ∉ 𝔮, w * t ∈ 𝔮 ^ n ⊔ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) := by
    intro n t ht
    have h0 : Ideal.Quotient.mk (𝔫 ^ n) (Ideal.Quotient.mk P
        (algebraMap A (Localization.AtPrime 𝔮) t)) = 0 := ht
    have h1 := Ideal.Quotient.eq_zero_iff_mem.mp h0
    rw [h𝔫def, ← Ideal.map_pow, Ideal.mem_quotient_iff_mem_sup, hmax, ← Ideal.map_pow,
      hP', ← Ideal.map_sup] at h1
    obtain ⟨m, hm, hmt⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔮.primeCompl
      (Localization.AtPrime 𝔮) _ _).mp h1
    exact ⟨m, hm, hmt⟩
  have hK' : ∀ (n : ℕ) (t : A), t ∈ 𝔮 ^ n → cl n t = 0 := by
    intro n t ht
    show Ideal.Quotient.mk (𝔫 ^ n) (Ideal.Quotient.mk P
      (algebraMap A (Localization.AtPrime 𝔮) t)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem, h𝔫def, ← Ideal.map_pow, hmax, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ht)

  have hS : ∀ (n : ℕ) (v : (Localization.AtPrime 𝔮 ⧸ P) ⧸ 𝔫 ^ n),
      ∃ a s : A, s ∉ 𝔮 ∧ cl n s * v = cl n a := by
    intro n v
    obtain ⟨v', rfl⟩ := Ideal.Quotient.mk_surjective v
    obtain ⟨ℓ, rfl⟩ := Ideal.Quotient.mk_surjective v'
    obtain ⟨⟨a, s⟩, h⟩ := IsLocalization.surj 𝔮.primeCompl ℓ
    have h' : ℓ * algebraMap A (Localization.AtPrime 𝔮) (s : A) =
        algebraMap A (Localization.AtPrime 𝔮) a := h
    refine ⟨a, s, s.2, ?_⟩
    have h2 := congrArg ((Ideal.Quotient.mk (𝔫 ^ n)).comp (Ideal.Quotient.mk P)) h'
    rw [map_mul] at h2
    refine (mul_comm (cl n s) (Ideal.Quotient.mk (𝔫 ^ n) (Ideal.Quotient.mk P ℓ))).trans ?_
    exact h2

  have hXS : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) ∈
      Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
    intro i
    apply Ideal.subset_span
    fin_cases i
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hAUX : ∀ p : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R),
      p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
    intro p
    induction p using MvPolynomial.induction_on
    next a =>
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact Ideal.zero_mem _
    next p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    next p i _ =>
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hXS i)
  have hlift : ∀ (I : Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)))
      (c : IsLocalRing.ResidueField R), ∃ r : R,
      algebraMap R (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I) r =
        Ideal.Quotient.mk I (MvPolynomial.C c) := by
    intro I c
    obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective c
    refine ⟨r, ?_⟩
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_apply,
      IsLocalRing.ResidueField.algebraMap_eq]

  have hN1 : ∀ u : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 1 :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))),
      ∃ r : R, algebraMap R _ r = u := by
    intro u
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨r, hr⟩ := hlift _ (MvPolynomial.constantCoeff p)
    refine ⟨r, hr.trans (Ideal.Quotient.eq.mpr ?_)⟩
    rw [pow_one]
    refine Ideal.mem_sup_right ?_
    rw [← neg_sub]
    exact neg_mem (hAUX p)

  obtain ⟨X0, X1, hX0, hX1, hN2⟩ : ∃ X0 X1 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 2 :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))),
      X0 * X0 = 0 ∧ X1 * X1 = 0 ∧ ∀ u, u * u = 0 →
        ∃ r₀ r₁ : R, u = algebraMap R _ r₀ * X0 + algebraMap R _ r₁ * X1 := by
    refine ⟨Ideal.Quotient.mk _ (MvPolynomial.X 0), Ideal.Quotient.mk _ (MvPolynomial.X 1),
      ?_, ?_, ?_⟩
    · rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_right (by rw [pow_two]; exact Ideal.mul_mem_mul (hXS 0) (hXS 0))
    · rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_sup_right (by rw [pow_two]; exact Ideal.mul_mem_mul (hXS 1) (hXS 1))
    intro u hu
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective u
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hu
    have hker : (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 2 :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))) ≤
        RingHom.ker (MvPolynomial.constantCoeff (R := IsLocalRing.ResidueField R)
          (σ := Fin 2)) := by
      refine sup_le ?_ (le_trans (Ideal.pow_le_self two_ne_zero) ?_)
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_mul,
          MvPolynomial.constantCoeff_X, zero_mul]
      · rw [Ideal.span_le]
        intro q hq
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
        rcases hq with rfl | rfl <;>
          rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.constantCoeff_X]
    have hc : MvPolynomial.constantCoeff p = 0 := by
      have h := hker hu
      rw [RingHom.mem_ker, map_mul] at h
      exact mul_self_eq_zero.mp h
    have hpS := hAUX p
    rw [hc, map_zero, sub_zero] at hpS
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hpS
    obtain ⟨r₀, hr₀⟩ := hlift (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 2) (MvPolynomial.constantCoeff a)
    obtain ⟨r₁, hr₁⟩ := hlift (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 2) (MvPolynomial.constantCoeff b)
    refine ⟨r₀, r₁, ?_⟩
    have hmk : Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 2) p =
        Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 2)
          (MvPolynomial.C (MvPolynomial.constantCoeff a) * MvPolynomial.X 0 +
            MvPolynomial.C (MvPolynomial.constantCoeff b) * MvPolynomial.X 1) := by
      refine Ideal.Quotient.eq.mpr ?_
      have e : p - (MvPolynomial.C (MvPolynomial.constantCoeff a) * MvPolynomial.X 0 +
            MvPolynomial.C (MvPolynomial.constantCoeff b) * MvPolynomial.X 1) =
          (a - MvPolynomial.C (MvPolynomial.constantCoeff a)) * MvPolynomial.X 0 +
            (b - MvPolynomial.C (MvPolynomial.constantCoeff b)) * MvPolynomial.X 1 := by
        rw [← hab]; ring
      rw [e]
      refine Ideal.mem_sup_right (Ideal.add_mem _ ?_ ?_)
      · rw [pow_two]; exact Ideal.mul_mem_mul (hAUX a) (hXS 0)
      · rw [pow_two]; exact Ideal.mul_mem_mul (hAUX b) (hXS 1)
    rw [hmk, map_add, map_mul, map_mul, ← hr₀, ← hr₁]
  obtain ⟨e1⟩ := hlev 1
  obtain ⟨e2⟩ := hlev 2
  refine ⟨?_, ?_⟩

  · intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨r, hr⟩ := hN1 (e1 (cl 1 z))
    have h1 : cl 1 (z - algebraMap R A r) = 0 := by
      rw [map_sub, hC, sub_eq_zero]
      apply e1.injective
      rw [AlgEquiv.commutes, hr]
    obtain ⟨w, hw, hwz⟩ := hK 1 _ h1
    rw [pow_one] at hwz
    have h2 : w * (z - algebraMap R A r) ∈ 𝔮 := sup_le le_rfl hmA hwz
    have h3 := (‹𝔮.IsPrime›.mem_or_mem h2).resolve_left hw
    refine ⟨r, ?_⟩
    rw [RingHom.comp_apply, Ideal.Quotient.eq, ← neg_sub]
    exact neg_mem h3

  · obtain ⟨x, s, hs, hxs⟩ := hS 2 (e2.symm X0)
    obtain ⟨y, s', hs', hys⟩ := hS 2 (e2.symm X1)
    have hx' : e2 (cl 2 x) = e2 (cl 2 s) * X0 := by
      rw [← hxs, map_mul, AlgEquiv.apply_symm_apply]
    have hy' : e2 (cl 2 y) = e2 (cl 2 s') * X1 := by
      rw [← hys, map_mul, AlgEquiv.apply_symm_apply]
    have hC2 : ∀ r : R, e2 (cl 2 (algebraMap R A r)) = algebraMap R _ r := by
      intro r
      rw [hC]
      exact e2.commutes r
    have hmem : ∀ t : A, cl 2 (t * t) = 0 → t ∈ 𝔮 := by
      intro t ht
      obtain ⟨w, hw, hwt⟩ := hK 2 _ ht
      have h2 : w * (t * t) ∈ 𝔮 := sup_le (Ideal.pow_le_self two_ne_zero) hmA hwt
      have h3 := (‹𝔮.IsPrime›.mem_or_mem h2).resolve_left hw
      rcases ‹𝔮.IsPrime›.mem_or_mem h3 with h | h <;> exact h
    have hx : x ∈ 𝔮 := by
      apply hmem
      apply e2.injective
      rw [map_mul, map_mul, hx', map_zero]
      calc e2 (cl 2 s) * X0 * (e2 (cl 2 s) * X0)
          = e2 (cl 2 s) * e2 (cl 2 s) * (X0 * X0) := by ring
        _ = 0 := by rw [hX0, mul_zero]
    have hy : y ∈ 𝔮 := by
      apply hmem
      apply e2.injective
      rw [map_mul, map_mul, hy', map_zero]
      calc e2 (cl 2 s') * X1 * (e2 (cl 2 s') * X1)
          = e2 (cl 2 s') * e2 (cl 2 s') * (X1 * X1) := by ring
        _ = 0 := by rw [hX1, mul_zero]
    refine ⟨x, hx, y, hy, fun z hz => ?_⟩
    have hzz : cl 2 (z * z) = 0 := hK' 2 _ (by rw [pow_two]; exact Ideal.mul_mem_mul hz hz)
    obtain ⟨r₀, r₁, hr⟩ := hN2 (e2 (cl 2 z)) (by rw [← map_mul, ← map_mul, hzz, map_zero])
    have htz : cl 2 (s * s' * z - s' * algebraMap R A r₀ * x - s * algebraMap R A r₁ * y) = 0 := by
      apply e2.injective
      rw [map_zero]
      simp only [map_sub, map_mul]
      rw [hC2, hC2, hr, hx', hy']
      ring
    obtain ⟨w', hw', hwt⟩ := hK 2 _ htz
    refine ⟨w' * s * s', hnm _ _ (hnm _ _ hw' hs) hs', ?_⟩
    have e : w' * s * s' * z =
        w' * (s * s' * z - s' * algebraMap R A r₀ * x - s * algebraMap R A r₁ * y) +
          (w' * s' * algebraMap R A r₀) * x + (w' * s * algebraMap R A r₁) * y := by ring
    rw [e]
    refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
    · exact (sup_le_sup_right (le_sup_right : 𝔮 ^ 2 ≤ Ideal.span {x, y} ⊔ 𝔮 ^ 2)
        (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R))) hwt
    · exact Ideal.mem_sup_left (Ideal.mem_sup_left
        (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))))
    · exact Ideal.mem_sup_left (Ideal.mem_sup_left
        (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))))

theorem wcpa_dj_ncxc_embed (R : Type u) [CommRing R] [IsLocalRing R]
    (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A]
    (𝔮 : Ideal A) [𝔮.IsPrime] (h𝔮 : 𝔮.comap (algebraMap R A) = IsLocalRing.maximalIdeal R)
    (hres : Function.Surjective ((Ideal.Quotient.mk 𝔮).comp (algebraMap R A)))
    (hcot : ∃ x ∈ 𝔮, ∃ y ∈ 𝔮, ∀ z ∈ 𝔮, ∃ w ∉ 𝔮, w * z ∈ Ideal.span {x, y} ⊔ 𝔮 ^ 2 ⊔
      Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R)) :
    ∃ (f : A) (B : Type u) (_ : CommRing B) (_ : Algebra R B) (u v : B)
      (π₀ : B →ₐ[R] Localization.Away f),
      f ∉ 𝔮 ∧ Function.Surjective π₀ ∧
      (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).Etale ∧
      Algebra.FinitePresentation R B ∧
      u ∈ Ideal.comap π₀ (Ideal.map (algebraMap A (Localization.Away f)) 𝔮) ∧
      v ∈ Ideal.comap π₀ (Ideal.map (algebraMap A (Localization.Away f)) 𝔮) :=
by
  classical



  have s2 : ∀ (S : Type u) [CommRing S] (n : ℕ)
      (𝔓 : Ideal (MvPolynomial (Fin n) S)) [𝔓.IsPrime] (I : Ideal S)
      (hI : Ideal.map (MvPolynomial.C : S →+* MvPolynomial (Fin n) S) I ≤ 𝔓)
      (hX : ∀ i, (MvPolynomial.X i : MvPolynomial (Fin n) S) ∈ 𝔓)
      (W e : Fin n → MvPolynomial (Fin n) S) (hW : ∀ j, W j ∉ 𝔓)
      (he : ∀ j, e j ∈ 𝔓 ^ 2 ⊔ Ideal.map (MvPolynomial.C : S →+* MvPolynomial (Fin n) S) I),
      (Matrix.of fun l i : Fin n =>
        MvPolynomial.pderiv i (W l * MvPolynomial.X l - e l)).det ∉ 𝔓 := by
    intro S _ n 𝔓 _ I hI hX W e hW he
    have hK : ∀ i, ∀ p ∈ 𝔓 ^ 2 ⊔ Ideal.map (MvPolynomial.C : S →+* MvPolynomial (Fin n) S) I,
        MvPolynomial.pderiv i p ∈ 𝔓 := by
      intro i
      let K : Ideal (MvPolynomial (Fin n) S) :=
        { carrier := {p | p ∈ 𝔓 ∧ MvPolynomial.pderiv i p ∈ 𝔓}
          add_mem' := fun {a b} ha hb => ⟨𝔓.add_mem ha.1 hb.1, by
            rw [map_add]; exact 𝔓.add_mem ha.2 hb.2⟩
          zero_mem' := ⟨𝔓.zero_mem, by rw [map_zero]; exact 𝔓.zero_mem⟩
          smul_mem' := fun c p hp => ⟨𝔓.mul_mem_left c hp.1, by
            rw [smul_eq_mul, MvPolynomial.pderiv_mul]
            exact 𝔓.add_mem (𝔓.mul_mem_left _ hp.1) (𝔓.mul_mem_left _ hp.2)⟩ }
      have hle : 𝔓 ^ 2 ⊔ Ideal.map (MvPolynomial.C : S →+* MvPolynomial (Fin n) S) I ≤ K := by
        refine sup_le ?_ ?_
        · rw [pow_two]
          refine Ideal.mul_le.mpr ?_
          intro a ha b hb
          refine ⟨𝔓.mul_mem_left a hb, ?_⟩
          rw [MvPolynomial.pderiv_mul]
          exact 𝔓.add_mem (𝔓.mul_mem_left _ hb) (𝔓.mul_mem_right _ ha)
        · rw [Ideal.map_le_iff_le_comap]
          intro s hs
          refine ⟨hI (Ideal.mem_map_of_mem _ hs), ?_⟩
          rw [MvPolynomial.pderiv_C]
          exact 𝔓.zero_mem
      intro p hp
      have h := hle hp
      exact h.2
    set q := Ideal.Quotient.mk 𝔓 with hq
    have hent : q.mapMatrix (Matrix.of fun l i : Fin n =>
        MvPolynomial.pderiv i (W l * MvPolynomial.X l - e l)) =
        Matrix.diagonal (fun l => q (W l)) := by
      ext l i
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, Matrix.diagonal_apply]
      have h1 : q (MvPolynomial.X l) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hX l)
      have h2 : q (MvPolynomial.pderiv i (e l)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hK i _ (he l))
      rw [map_sub, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_sub, map_add, map_mul,
        map_mul, h1, h2, Pi.single_apply]
      by_cases h : l = i <;> simp [h]
    have hdet : q (Matrix.of fun l i : Fin n =>
        MvPolynomial.pderiv i (W l * MvPolynomial.X l - e l)).det = ∏ l, q (W l) := by
      rw [RingHom.map_det, hent, Matrix.det_diagonal]
    intro hmem
    have h0 : q (Matrix.of fun l i : Fin n =>
        MvPolynomial.pderiv i (W l * MvPolynomial.X l - e l)).det = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rw [hdet, Finset.prod_eq_zero_iff] at h0
    obtain ⟨l, _, hl⟩ := h0
    exact hW l (Ideal.Quotient.eq_zero_iff_mem.mp hl)



  have s3 : ∀ (S : Type u) [CommRing S] (n : ℕ) (G : Fin n → MvPolynomial (Fin n) S),
      Algebra.Etale S (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range G))
        (Matrix.of fun l i : Fin n => MvPolynomial.pderiv i (G l)).det)) := by
    intro S _ n G
    set δ := (Matrix.of fun l i : Fin n => MvPolynomial.pderiv i (G l)).det with hδ
    let P₀ : Algebra.Presentation S (MvPolynomial (Fin n) S ⧸ Ideal.span (Set.range G))
        (Fin n) (Fin n) := Algebra.Presentation.naive (v := G)
    let P₁ : Algebra.PreSubmersivePresentation S
        (MvPolynomial (Fin n) S ⧸ Ideal.span (Set.range G)) (Fin n) (Fin n) :=
      { toPresentation := P₀, map := id, map_inj := Function.injective_id }
    have hP₁ : P₁.jacobian = Ideal.Quotient.mk (Ideal.span (Set.range G)) δ := by
      rw [P₁.jacobian_eq_jacobiMatrix_det]
      have hJ : P₁.jacobiMatrix =
          (Matrix.of fun l i : Fin n => MvPolynomial.pderiv i (G l)).transpose := by
        ext i j
        rw [P₁.jacobiMatrix_apply]
        rfl
      rw [hJ, Matrix.det_transpose]
      have h : (MvPolynomial.aeval P₁.val : MvPolynomial (Fin n) S →ₐ[S] _) =
          Ideal.Quotient.mkₐ S (Ideal.span (Set.range G)) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [MvPolynomial.aeval_X]
        rfl
      rw [P₁.algebraMap_eq]
      exact DFunLike.congr_fun h δ
    let P₂ := Algebra.PreSubmersivePresentation.localizationAway
      (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range G)) δ))
      (Ideal.Quotient.mk (Ideal.span (Set.range G)) δ)
    let P := P₂.comp P₁
    have hPj : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian, hP₁,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact (IsLocalization.Away.algebraMap_isUnit _).mul
        (IsLocalization.Away.algebraMap_isUnit _)
    let PS : Algebra.SubmersivePresentation S
        (Localization.Away (Ideal.Quotient.mk (Ideal.span (Set.range G)) δ))
        (Unit ⊕ Fin n) (Unit ⊕ Fin n) := ⟨P, hPj⟩
    have hdim : PS.dimension = 0 := by
      simp [Algebra.Presentation.dimension]
    have := PS.isStandardSmoothOfRelativeDimension hdim
    infer_instance



  obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType R A)
  have hc : ∀ i : Fin n, ∃ c : R, g (MvPolynomial.X i) - algebraMap R A c ∈ 𝔮 := by
    intro i
    obtain ⟨c, hc⟩ := hres (Ideal.Quotient.mk 𝔮 (g (MvPolynomial.X i)))
    refine ⟨c, ?_⟩
    rw [← Ideal.Quotient.eq]
    exact hc.symm
  choose c hc using hc
  obtain ⟨x, hx, y, hy, hxy⟩ := hcot
  set t : Fin n → A := fun i => g (MvPolynomial.X i) - algebraMap R A (c i) with ht
  set Φ : MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) →+* A :=
    MvPolynomial.eval₂Hom (MvPolynomial.aeval (R := R) ![x, y]).toRingHom t with hΦ
  have hΦC : ∀ s, Φ (MvPolynomial.C s) = MvPolynomial.aeval ![x, y] s := fun s =>
    MvPolynomial.eval₂Hom_C _ _ _
  have hΦX : ∀ i, Φ (MvPolynomial.X i) = t i := fun i => MvPolynomial.eval₂Hom_X' _ _ _
  have hΦCC : ∀ r : R, Φ (MvPolynomial.C (MvPolynomial.C r)) = algebraMap R A r := by
    intro r
    rw [hΦC, MvPolynomial.aeval_C]
  have hΦU : Φ (MvPolynomial.C (MvPolynomial.X 0)) = x := by
    rw [hΦC, MvPolynomial.aeval_X]; rfl
  have hΦV : Φ (MvPolynomial.C (MvPolynomial.X 1)) = y := by
    rw [hΦC, MvPolynomial.aeval_X]; rfl

  have hsurj : Function.Surjective Φ := by
    let ψ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) :=
      MvPolynomial.eval₂Hom (MvPolynomial.C.comp MvPolynomial.C)
        (fun i => MvPolynomial.X i + MvPolynomial.C (MvPolynomial.C (c i)))
    have hcomp : Φ.comp ψ = g.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hΦCC]
        exact (g.commutes r).symm.trans (by rw [MvPolynomial.algebraMap_eq]; rfl)
      · intro i
        rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', map_add, hΦX, hΦCC]
        show g (MvPolynomial.X i) - algebraMap R A (c i) + algebraMap R A (c i) = _
        rw [sub_add_cancel]
        rfl
    intro a
    obtain ⟨p, rfl⟩ := hg a
    exact ⟨ψ p, by rw [← RingHom.comp_apply, hcomp]; rfl⟩

  set 𝔓 : Ideal (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R)) := Ideal.comap Φ 𝔮 with h𝔓
  have : 𝔓.IsPrime := Ideal.comap_isPrime Φ 𝔮
  set I₀ : Ideal (MvPolynomial (Fin 2) R) :=
    Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ⊔
      Ideal.map (algebraMap R (MvPolynomial (Fin 2) R)) (IsLocalRing.maximalIdeal R) with hI₀
  set 𝔍 : Ideal (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R)) :=
    𝔓 ^ 2 ⊔ Ideal.map (MvPolynomial.C : MvPolynomial (Fin 2) R →+*
      MvPolynomial (Fin n) (MvPolynomial (Fin 2) R)) I₀ with h𝔍
  have hCU : MvPolynomial.C (MvPolynomial.X 0) ∈ 𝔍 :=
    Ideal.mem_sup_right (Ideal.mem_map_of_mem _
      (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert _ _))))
  have hCV : MvPolynomial.C (MvPolynomial.X 1) ∈ 𝔍 :=
    Ideal.mem_sup_right (Ideal.mem_map_of_mem _
      (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))))
  have hCm : ∀ m ∈ IsLocalRing.maximalIdeal R,
      MvPolynomial.C (MvPolynomial.C m) ∈ 𝔍 := by
    intro m hm
    refine Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (Ideal.mem_sup_right ?_))
    rw [← MvPolynomial.algebraMap_eq]
    exact Ideal.mem_map_of_mem _ hm
  have hlift : Ideal.span {x, y} ⊔ 𝔮 ^ 2 ⊔
      Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) ≤ Ideal.map Φ 𝔍 := by
    refine sup_le (sup_le ?_ ?_) ?_
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      refine ⟨?_, ?_⟩
      · rw [← hΦU]; exact Ideal.mem_map_of_mem _ hCU
      · rw [← hΦV]; exact Ideal.mem_map_of_mem _ hCV
    · have : 𝔮 ^ 2 = Ideal.map Φ (𝔓 ^ 2) := by
        rw [Ideal.map_pow, h𝔓, Ideal.map_comap_of_surjective Φ hsurj]
      rw [this]
      exact Ideal.map_mono le_sup_left
    · rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, ← hΦCC]
      exact Ideal.mem_map_of_mem _ (hCm m hm)
  have hrel : ∀ j : Fin n, ∃ W e : MvPolynomial (Fin n) (MvPolynomial (Fin 2) R),
      Φ W ∉ 𝔮 ∧ e ∈ 𝔍 ∧ Φ (W * MvPolynomial.X j - e) = 0 := by
    intro j
    have htj : t j ∈ 𝔮 := hc j
    obtain ⟨w, hw, hwt⟩ := hxy (t j) htj
    obtain ⟨e, he, hee⟩ := (Ideal.mem_map_iff_of_surjective Φ hsurj).mp (hlift hwt)
    obtain ⟨W, rfl⟩ := hsurj w
    refine ⟨W, e, hw, he, ?_⟩
    rw [map_sub, map_mul, hΦX, hee, sub_self]
  choose W e hW he hWe using hrel



  obtain ⟨G, hGdef⟩ : ∃ G : Fin n → MvPolynomial (Fin n) (MvPolynomial (Fin 2) R),
      G = fun l => W l * MvPolynomial.X l - e l := ⟨_, rfl⟩
  have hG : ∀ j, Φ (G j) = 0 := by
    intro j; rw [hGdef]; exact hWe j
  have hδ : (Matrix.of fun l i : Fin n => MvPolynomial.pderiv i (G l)).det ∉ 𝔓 := by
    rw [hGdef]
    refine s2 (MvPolynomial (Fin 2) R) n 𝔓 I₀ ?_ ?_ W e hW he
    · rw [Ideal.map_le_iff_le_comap]
      refine sup_le ?_ ?_
      · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        refine ⟨?_, ?_⟩
        · show Φ (MvPolynomial.C (MvPolynomial.X 0)) ∈ 𝔮
          rw [hΦU]; exact hx
        · show Φ (MvPolynomial.C (MvPolynomial.X 1)) ∈ 𝔮
          rw [hΦV]; exact hy
      · rw [Ideal.map_le_iff_le_comap]
        intro m hm
        show Φ (MvPolynomial.C (algebraMap R (MvPolynomial (Fin 2) R) m)) ∈ 𝔮
        rw [MvPolynomial.algebraMap_eq, hΦCC, ← Ideal.mem_comap, h𝔮]
        exact hm
    · intro i
      show Φ (MvPolynomial.X i) ∈ 𝔮
      rw [hΦX]; exact hc i
  set δ := (Matrix.of fun l i : Fin n => MvPolynomial.pderiv i (G l)).det with hδdef

  have hJ : Ideal.span (Set.range G) ≤ RingHom.ker Φ := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact hG j
  set J := Ideal.span (Set.range G) with hJdef
  set f := Φ δ with hfdef
  have hf : f ∉ 𝔮 := hδ
  let Ψ : (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) ⧸ J) →+* A :=
    Ideal.Quotient.lift J Φ hJ
  have hΨ : ∀ p, Ψ (Ideal.Quotient.mk J p) = Φ p := fun p => Ideal.Quotient.lift_mk J Φ hJ
  let ψ := (algebraMap A (Localization.Away f)).comp Ψ
  have hunit : IsUnit (ψ (Ideal.Quotient.mk J δ)) := by
    show IsUnit (algebraMap A _ (Ψ (Ideal.Quotient.mk J δ)))
    rw [hΨ]
    exact IsLocalization.Away.algebraMap_isUnit f
  let L : Localization.Away (Ideal.Quotient.mk J δ) →+* Localization.Away f :=
    IsLocalization.Away.lift (Ideal.Quotient.mk J δ) hunit
  have hL : ∀ a, L (algebraMap (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) ⧸ J)
      (Localization.Away (Ideal.Quotient.mk J δ)) a) = ψ a :=
    fun a => IsLocalization.lift_eq _ _
  have hψP : ∀ p : MvPolynomial (Fin n) (MvPolynomial (Fin 2) R), ψ (Ideal.Quotient.mk J p) =
      algebraMap A (Localization.Away f) (Φ p) := by
    intro p
    show algebraMap A _ (Ψ (Ideal.Quotient.mk J p)) = _
    rw [hΨ]
  have hcomm : ∀ r : R, L (algebraMap R _ r) = algebraMap R (Localization.Away f) r := by
    intro r
    rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) ⧸ J) (Localization.Away (Ideal.Quotient.mk J δ)) r, hL,
      IsScalarTower.algebraMap_apply R (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R)) (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) ⧸ J) r, Ideal.Quotient.algebraMap_eq, hψP,
      IsScalarTower.algebraMap_apply R (MvPolynomial (Fin 2) R) (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R)) r,
      MvPolynomial.algebraMap_eq (R := MvPolynomial (Fin 2) R) (σ := Fin n),
      MvPolynomial.algebraMap_eq, hΦCC,
      ← IsScalarTower.algebraMap_apply R A (Localization.Away f) r]
  let π₀ : Localization.Away (Ideal.Quotient.mk J δ) →ₐ[R] Localization.Away f :=
    { L with commutes' := hcomm }
  have hπ₀ : ∀ z, π₀ z = L z := fun z => rfl
  have hval : ∀ s : MvPolynomial (Fin 2) R,
      π₀ (algebraMap (MvPolynomial (Fin 2) R) (Localization.Away (Ideal.Quotient.mk J δ)) s) =
        algebraMap A _ (MvPolynomial.aeval ![x, y] s) := by
    intro s
    rw [hπ₀, IsScalarTower.algebraMap_apply (MvPolynomial (Fin 2) R) (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) ⧸ J) (Localization.Away (Ideal.Quotient.mk J δ)) s, hL,
      IsScalarTower.algebraMap_apply (MvPolynomial (Fin 2) R) (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R)) (MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) ⧸ J) s, Ideal.Quotient.algebraMap_eq, hψP,
      MvPolynomial.algebraMap_eq (R := MvPolynomial (Fin 2) R) (σ := Fin n), hΦC]
  have hπsurj : Function.Surjective π₀ := by
    intro z
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers f) z
    obtain ⟨k, hk⟩ := s.2
    obtain ⟨p, hp⟩ := hsurj a
    let yk : Submonoid.powers (Ideal.Quotient.mk J δ) := ⟨Ideal.Quotient.mk J δ ^ k, k, rfl⟩
    have hy : (yk : MvPolynomial (Fin n) (MvPolynomial (Fin 2) R) ⧸ J) = Ideal.Quotient.mk J δ ^ k := rfl
    refine ⟨IsLocalization.mk' (Localization.Away (Ideal.Quotient.mk J δ)) (Ideal.Quotient.mk J p) yk, ?_⟩
    have hspec := IsLocalization.mk'_spec (Localization.Away (Ideal.Quotient.mk J δ)) (Ideal.Quotient.mk J p) yk
    have h1 := congrArg L hspec
    rw [map_mul, hL, hL, hy, map_pow, hψP, hψP] at h1
    rw [IsLocalization.eq_mk'_iff_mul_eq, hπ₀, ← hk, map_pow, ← hp]
    exact h1

  have hEt : Algebra.Etale (MvPolynomial (Fin 2) R)
      (Localization.Away (Ideal.Quotient.mk J δ)) := s3 (MvPolynomial (Fin 2) R) n G
  set u : Localization.Away (Ideal.Quotient.mk J δ) :=
    algebraMap (MvPolynomial (Fin 2) R) _ (MvPolynomial.X 0) with hu
  set v : Localization.Away (Ideal.Quotient.mk J δ) :=
    algebraMap (MvPolynomial (Fin 2) R) _ (MvPolynomial.X 1) with hv
  have heq : MvPolynomial.eval₂Hom (algebraMap R (Localization.Away (Ideal.Quotient.mk J δ)))
      ![u, v] = algebraMap (MvPolynomial (Fin 2) R) _ := by
    apply MvPolynomial.ringHom_ext
    · intro r
      rw [MvPolynomial.eval₂Hom_C, ← MvPolynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply]
    · intro i
      rw [MvPolynomial.eval₂Hom_X']
      fin_cases i <;> rfl
  have het : (MvPolynomial.eval₂Hom (algebraMap R (Localization.Away (Ideal.Quotient.mk J δ)))
      ![u, v]).Etale := by
    rw [heq]
    exact RingHom.etale_algebraMap.mpr hEt
  have : Algebra.FinitePresentation R (MvPolynomial (Fin 2) R) := inferInstance
  have : Algebra.FinitePresentation (MvPolynomial (Fin 2) R)
      (Localization.Away (Ideal.Quotient.mk J δ)) := Algebra.Etale.finitePresentation
  have hfp : Algebra.FinitePresentation R (Localization.Away (Ideal.Quotient.mk J δ)) :=
    Algebra.FinitePresentation.trans R (MvPolynomial (Fin 2) R) _
  refine ⟨f, Localization.Away (Ideal.Quotient.mk J δ), inferInstance, inferInstance, u, v, π₀,
    hf, hπsurj, het, hfp, ?_, ?_⟩
  · rw [Ideal.mem_comap, hu, hval, MvPolynomial.aeval_X]
    exact Ideal.mem_map_of_mem _ hx
  · rw [Ideal.mem_comap, hv, hval, MvPolynomial.aeval_X]
    exact Ideal.mem_map_of_mem _ hy

theorem wcpa_dj_ncxc_levels_away (R : Type u) [CommRing R] [IsLocalRing R]
    (A : Type u) [CommRing A] [Algebra R A] (𝔮 : Ideal A) [𝔮.IsPrime] (f : A) (hf : f ∉ 𝔮)
    [(Ideal.map (algebraMap A (Localization.Away f)) 𝔮).IsPrime]
    (hlev : wcNcxLevels R A 𝔮) :
    wcNcxLevels R (Localization.Away f) (Ideal.map (algebraMap A (Localization.Away f)) 𝔮) :=
by
  classical
  set P := Ideal.map (algebraMap A (Localization.Away f)) 𝔮 with hP
  have hdisj : Disjoint (Submonoid.powers f : Set A) 𝔮 :=
    (Ideal.disjoint_powers_iff_notMem_of_isPrime f).mpr hf
  have hcomap : Ideal.comap (algebraMap A (Localization.Away f)) P = 𝔮 :=
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers f) _ inferInstance hdisj
  have hloc := IsLocalization.isLocalization_atPrime_localization_atPrime
    (Submonoid.powers f) P
  have hsub : (Ideal.comap (algebraMap A (Localization.Away f)) P).primeCompl = 𝔮.primeCompl := by
    ext x
    rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomap]
  have hloc0 : IsLocalization (Ideal.comap (algebraMap A (Localization.Away f)) P).primeCompl
      (Localization.AtPrime P) := hloc
  rw [hsub] at hloc0
  letI := hloc0
  let e₀ : Localization.AtPrime 𝔮 ≃ₐ[A] Localization.AtPrime P :=
    IsLocalization.algEquiv 𝔮.primeCompl _ _
  let e : Localization.AtPrime 𝔮 ≃ₐ[R] Localization.AtPrime P := e₀.restrictScalars R

  set L := Localization.AtPrime 𝔮
  set L' := Localization.AtPrime P
  set I := Ideal.map (algebraMap R L) (IsLocalRing.maximalIdeal R) with hI
  set I' := Ideal.map (algebraMap R L') (IsLocalRing.maximalIdeal R) with hI'
  have hII : I' = Ideal.map (e : L →+* L') I := by
    rw [hI, hI', Ideal.map_map]
    congr 1
    all_goals
      apply RingHom.ext
      intro r
      rw [RingHom.comp_apply]
      exact (e.commutes r).symm
  let ē : (L ⧸ I) ≃ₐ[R] (L' ⧸ I') := Ideal.quotientEquivAlg I I' e hII
  have hM : Ideal.map (e : L →+* L') (IsLocalRing.maximalIdeal L) = IsLocalRing.maximalIdeal L' :=
    IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv (e : L ≃+* L'))
  have hN : Ideal.map (ē : (L ⧸ I) →+* (L' ⧸ I'))
      (Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal L)) =
      Ideal.map (Ideal.Quotient.mk I') (IsLocalRing.maximalIdeal L') := by
    rw [Ideal.map_map, ← hM, Ideal.map_map]
    congr 1
    all_goals
      apply RingHom.ext
      intro x
      rw [RingHom.comp_apply, RingHom.comp_apply]
      exact Ideal.quotientEquivAlg_mk I I' e hII x
  intro n
  obtain ⟨θ⟩ := hlev n
  have hNn : (Ideal.map (Ideal.Quotient.mk I') (IsLocalRing.maximalIdeal L')) ^ n =
      Ideal.map (ē : (L ⧸ I) →+* (L' ⧸ I'))
        ((Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal L)) ^ n) := by
    have hp := Ideal.map_pow (ē : (L ⧸ I) →+* (L' ⧸ I'))
      (Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal L)) n
    rw [hp, hN]
  exact ⟨(Ideal.quotientEquivAlg _ _ ē hNn).symm.trans θ⟩

theorem wcpa_dj_ncxc_etale_fibre_levels (R : Type u) [CommRing R] [IsLocalRing R]
    (B : Type u) [CommRing B] [Algebra R B] (u v : B)
    (het : (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).Etale)
    (𝔔 : Ideal B) [𝔔.IsPrime] (h𝔔 : 𝔔.comap (algebraMap R B) = IsLocalRing.maximalIdeal R)
    (hres : Function.Surjective ((Ideal.Quotient.mk 𝔔).comp (algebraMap R B)))
    (hu : u ∈ 𝔔) (hv : v ∈ 𝔔) :
    IsNoetherianRing (wcNcxFib R B 𝔔) ∧
    ∀ n : ℕ, Function.Surjective (wcNcxcPhi R B 𝔔 u v n) ∧
      RingHom.ker (wcNcxcPhi R B 𝔔 u v n) =
        Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R) (IsLocalRing.maximalIdeal R) ⊔
          Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n :=
by
  classical

  have s1 : ∀ (S : Type u) [CommRing S] (I K : Ideal S) (n : ℕ), (I ⊔ K) ^ n ⊔ I = I ⊔ K ^ n := by
    intro S _ I K n
    have hle : ∀ n : ℕ, (I ⊔ K) ^ n ≤ I ⊔ K ^ n := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ, pow_succ]
        calc (I ⊔ K) ^ n * (I ⊔ K) ≤ (I ⊔ K ^ n) * (I ⊔ K) := Ideal.mul_mono_left ih
          _ ≤ I ⊔ K ^ n * K := by
            rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup]
            refine sup_le (sup_le (le_sup_of_le_left ?_) (le_sup_of_le_left ?_))
              (sup_le (le_sup_of_le_left ?_) le_sup_right) <;>
              first | exact Ideal.mul_le_left | exact Ideal.mul_le_right
    apply le_antisymm
    · exact sup_le (hle n) le_sup_left
    · exact sup_le le_sup_right (le_sup_of_le_left (Ideal.pow_right_mono le_sup_right n))

  have s4 : ∀ (P B : Type u) [CommRing P] [CommRing B] (φ : P →+* B) (hφ : φ.Etale)
      (𝔔 : Ideal B) [𝔔.IsPrime],
      Ideal.map ((algebraMap B (Localization.AtPrime 𝔔)).comp φ) (𝔔.comap φ) =
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) ∧
        ∀ J : Ideal P, J.IsPrimary → J.radical = 𝔔.comap φ →
          Ideal.comap ((algebraMap B (Localization.AtPrime 𝔔)).comp φ)
            (Ideal.map ((algebraMap B (Localization.AtPrime 𝔔)).comp φ) J) = J := by
    intro P B _ _ φ hφ 𝔔 _
    letI : Algebra P B := φ.toAlgebra
    haveI : Algebra.Etale P B := hφ.toAlgebra
    haveI h𝔓p : (𝔔.comap φ).IsPrime := Ideal.IsPrime.comap φ
    let ρ : Localization.AtPrime (𝔔.comap φ) →+* Localization.AtPrime 𝔔 :=
      Localization.localRingHom (𝔔.comap φ) 𝔔 φ rfl
    have hρ : ρ.comp (algebraMap P (Localization.AtPrime (𝔔.comap φ))) =
        (algebraMap B (Localization.AtPrime 𝔔)).comp φ :=
      RingHom.ext fun x => Localization.localRingHom_to_map (𝔔.comap φ) 𝔔 φ rfl x
    have hφflat : φ.Flat := (RingHom.flat_algebraMap_iff (R := P) (S := B)).mpr inferInstance
    have hρflat : ρ.Flat := RingHom.Flat.localRingHom hφflat 𝔔 (𝔔.comap φ) rfl
    letI : Algebra (Localization.AtPrime (𝔔.comap φ)) (Localization.AtPrime 𝔔) := ρ.toAlgebra
    haveI : Module.Flat (Localization.AtPrime (𝔔.comap φ)) (Localization.AtPrime 𝔔) := hρflat
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (𝔔.comap φ)) (Localization.AtPrime 𝔔)) :=
      Localization.isLocalHom_localRingHom (𝔔.comap φ) 𝔔 φ rfl
    haveI : Module.FaithfullyFlat (Localization.AtPrime (𝔔.comap φ)) (Localization.AtPrime 𝔔) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    haveI : IsScalarTower P (Localization.AtPrime (𝔔.comap φ)) (Localization.AtPrime 𝔔) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [IsScalarTower.algebraMap_apply P B (Localization.AtPrime 𝔔)]
        exact (Localization.localRingHom_to_map (𝔔.comap φ) 𝔔 φ rfl x).symm)
    haveI : Algebra.FormallyUnramified B (Localization.AtPrime 𝔔) :=
      Algebra.FormallyUnramified.of_isLocalization 𝔔.primeCompl
    haveI : Algebra.FormallyUnramified P (Localization.AtPrime 𝔔) :=
      Algebra.FormallyUnramified.comp P B (Localization.AtPrime 𝔔)
    haveI : Algebra.FormallyUnramified (Localization.AtPrime (𝔔.comap φ))
        (Localization.AtPrime 𝔔) :=
      Algebra.FormallyUnramified.localization_base (𝔔.comap φ).primeCompl
    haveI : Algebra.EssFiniteType P (Localization.AtPrime 𝔔) :=
      Algebra.EssFiniteType.comp P B (Localization.AtPrime 𝔔)
    haveI : Algebra.EssFiniteType (Localization.AtPrime (𝔔.comap φ)) (Localization.AtPrime 𝔔) :=
      Algebra.EssFiniteType.of_comp P (Localization.AtPrime (𝔔.comap φ)) (Localization.AtPrime 𝔔)
    refine ⟨?_, ?_⟩
    · rw [← hρ, ← Ideal.map_map, Localization.AtPrime.map_eq_maximalIdeal]
      exact Algebra.FormallyUnramified.map_maximalIdeal
    · intro J hJ hJr
      rw [← hρ, ← Ideal.map_map, ← Ideal.comap_comap]
      have h1 := Ideal.comap_map_eq_self_of_faithfullyFlat
        (A := Localization.AtPrime (𝔔.comap φ)) (B := Localization.AtPrime 𝔔)
        (Ideal.map (algebraMap P (Localization.AtPrime (𝔔.comap φ))) J)
      have h1' : Ideal.comap ρ (Ideal.map ρ
          (Ideal.map (algebraMap P (Localization.AtPrime (𝔔.comap φ))) J)) =
          Ideal.map (algebraMap P (Localization.AtPrime (𝔔.comap φ))) J := h1
      rw [h1']
      have hdisj : Disjoint ((𝔔.comap φ).primeCompl : Set P) (J : Set P) := by
        rw [Set.disjoint_left]
        intro x hx hxJ
        exact hx (hJr ▸ Ideal.le_radical hxJ)
      exact IsLocalization.under_map_of_isPrimary_disjoint (𝔔.comap φ).primeCompl
        (Localization.AtPrime (𝔔.comap φ)) hJ hdisj

  have s6 : ∀ (P L : Type u) [CommRing P] [CommRing L] [IsLocalRing L] (ψ : P →+* L)
      (𝔓 : Ideal P), Ideal.map ψ 𝔓 = IsLocalRing.maximalIdeal L →
      (∀ y : L, ∃ p : P, y - ψ p ∈ IsLocalRing.maximalIdeal L) →
      ∀ (n : ℕ) (y : L), ∃ p : P, y - ψ p ∈ IsLocalRing.maximalIdeal L ^ n := by
    intro P L _ _ _ ψ 𝔓 hmap hlift n
    induction n with
    | zero => intro y; exact ⟨0, by simp⟩
    | succ n ih =>
      intro y
      obtain ⟨p, hp⟩ := ih y
      have claim : ∀ z ∈ Submodule.span L (ψ '' ((𝔓 ^ n : Ideal P) : Set P)),
          ∃ p' : P, z - ψ p' ∈ IsLocalRing.maximalIdeal L ^ (n + 1) := by
        intro z hz
        induction hz using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨g, -, rfl⟩ := hx
          exact ⟨g, by rw [sub_self]; exact zero_mem _⟩
        | zero => exact ⟨0, by rw [map_zero, sub_self]; exact zero_mem _⟩
        | add x y _ _ ihx ihy =>
          obtain ⟨p1, hp1⟩ := ihx
          obtain ⟨p2, hp2⟩ := ihy
          refine ⟨p1 + p2, ?_⟩
          have e : x + y - ψ (p1 + p2) = (x - ψ p1) + (y - ψ p2) := by rw [map_add]; ring
          rw [e]
          exact add_mem hp1 hp2
        | smul a x hx ihx =>
          obtain ⟨p', hp'⟩ := ihx
          obtain ⟨c, hc⟩ := hlift a
          refine ⟨c * p', ?_⟩
          have e : a • x - ψ (c * p') = ψ c * (x - ψ p') + (a - ψ c) * x := by
            rw [smul_eq_mul, map_mul]; ring
          rw [e]
          refine add_mem (Ideal.mul_mem_left _ _ hp') ?_
          have hxM : x ∈ IsLocalRing.maximalIdeal L ^ n := by
            rw [← hmap, ← Ideal.map_pow]; exact hx
          rw [pow_succ']
          exact Ideal.mul_mem_mul hc hxM
      have hpM : y - ψ p ∈ Submodule.span L (ψ '' ((𝔓 ^ n : Ideal P) : Set P)) := by
        have : y - ψ p ∈ Ideal.map ψ (𝔓 ^ n) := by rw [Ideal.map_pow, hmap]; exact hp
        exact this
      obtain ⟨p', hp'⟩ := claim _ hpM
      refine ⟨p + p', ?_⟩
      have e : y - ψ (p + p') = y - ψ p - ψ p' := by rw [map_add]; ring
      rw [e]
      exact hp'

  have hRBft : Algebra.FiniteType R B := by
    letI : Algebra (MvPolynomial (Fin 2) R) B :=
      (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 2) R) B := het.toAlgebra
    have hφft : (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).FiniteType :=
      (inferInstance : Algebra.FiniteType (MvPolynomial (Fin 2) R) B)
    have hCft : (algebraMap R (MvPolynomial (Fin 2) R)).FiniteType :=
      RingHom.finiteType_algebraMap.mpr inferInstance
    have hRB := hφft.comp hCft
    have e : (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).comp
        (algebraMap R (MvPolynomial (Fin 2) R)) = algebraMap R B :=
      MvPolynomial.eval₂Hom_comp_C _ _
    rw [e] at hRB
    exact RingHom.finiteType_algebraMap.mp hRB
  have s5 : IsNoetherianRing (wcNcxFib R B 𝔔) := by
    haveI : Algebra.EssFiniteType R B := Algebra.EssFiniteType.of_finiteType R B
    haveI : Algebra.EssFiniteType R (Localization.AtPrime 𝔔) :=
      Algebra.EssFiniteType.comp R B (Localization.AtPrime 𝔔)
    haveI : Algebra.EssFiniteType R (wcNcxFib R B 𝔔) :=
      Algebra.EssFiniteType.of_surjective (Ideal.Quotient.mkₐ R _) (Ideal.Quotient.mkₐ_surjective R _)
    haveI : Algebra.EssFiniteType (R ⧸ IsLocalRing.maximalIdeal R) (wcNcxFib R B 𝔔) :=
      Algebra.EssFiniteType.of_comp R (R ⧸ IsLocalRing.maximalIdeal R) _
    letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal R)
    exact Algebra.EssFiniteType.isNoetherianRing (R ⧸ IsLocalRing.maximalIdeal R) _

  have s3 : ∀ y : Localization.AtPrime 𝔔, ∃ r : R, y - algebraMap R (Localization.AtPrime 𝔔) r ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) := by
    intro y
    obtain ⟨x, hz⟩ := IsLocalization.surj 𝔔.primeCompl y
    obtain ⟨r₁, hr₁⟩ := hres (Ideal.Quotient.mk 𝔔 x.1)
    obtain ⟨r₂, hr₂⟩ := hres (Ideal.Quotient.mk 𝔔 x.2)
    have hr₁' : algebraMap R B r₁ - x.1 ∈ 𝔔 := Ideal.Quotient.eq.mp hr₁
    have hr₂' : algebraMap R B r₂ - x.2 ∈ 𝔔 := Ideal.Quotient.eq.mp hr₂
    have hσ : (x.2 : B) ∉ 𝔔 := x.2.2
    have hr₂u : IsUnit r₂ := by
      by_contra h
      have hm : r₂ ∈ IsLocalRing.maximalIdeal R := h
      have h1 : algebraMap R B r₂ ∈ 𝔔 := by rw [← Ideal.mem_comap, h𝔔]; exact hm
      apply hσ
      have h2 := 𝔔.sub_mem h1 hr₂'
      rwa [sub_sub_cancel] at h2
    obtain ⟨r₂', hr₂'u⟩ : ∃ r₂' : R, r₂ * r₂' = 1 := ⟨↑hr₂u.unit⁻¹, hr₂u.mul_val_inv⟩
    refine ⟨r₁ * r₂', ?_⟩
    have hkey : x.1 - algebraMap R B (r₁ * r₂') * x.2 ∈ 𝔔 := by
      have hm : algebraMap R B (r₁ * r₂') * algebraMap R B r₂ = algebraMap R B r₁ := by
        rw [← map_mul, mul_assoc, mul_comm r₂' r₂, hr₂'u, mul_one]
      have e : x.1 - algebraMap R B (r₁ * r₂') * x.2 =
          -(algebraMap R B r₁ - x.1) + algebraMap R B (r₁ * r₂') * (algebraMap R B r₂ - x.2) := by
        linear_combination (-1 : B) * hm
      rw [e]
      exact 𝔔.add_mem (𝔔.neg_mem hr₁') (𝔔.mul_mem_left _ hr₂')
    have h2 : (y - algebraMap R (Localization.AtPrime 𝔔) (r₁ * r₂')) *
        algebraMap B (Localization.AtPrime 𝔔) x.2 =
        algebraMap B (Localization.AtPrime 𝔔) (x.1 - algebraMap R B (r₁ * r₂') * x.2) := by
      rw [sub_mul, hz, map_sub, map_mul (algebraMap B (Localization.AtPrime 𝔔)),
        ← IsScalarTower.algebraMap_apply R B]
    have h3 : algebraMap B (Localization.AtPrime 𝔔) (x.1 - algebraMap R B (r₁ * r₂') * x.2) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact Ideal.mem_map_of_mem _ hkey
    have h4 : algebraMap B (Localization.AtPrime 𝔔) (x.2 : B) ∉
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
      exact IsLocalization.map_units (Localization.AtPrime 𝔔) x.2
    rw [← h2] at h3
    exact ((IsLocalRing.maximalIdeal.isMaximal _).isPrime.mem_or_mem h3).resolve_right h4

  obtain ⟨hmapL, hcomap⟩ := s4 (MvPolynomial (Fin 2) R) B _ het 𝔔
  set φ := MvPolynomial.eval₂Hom (algebraMap R B) ![u, v] with hφdef
  set 𝔓 := 𝔔.comap φ with h𝔓def
  set ψ := (algebraMap B (Localization.AtPrime 𝔔)).comp φ with hψdef
  have hφC : ∀ r, φ (MvPolynomial.C r) = algebraMap R B r := fun r => MvPolynomial.eval₂Hom_C _ _ r
  have hφX : ∀ i, φ (MvPolynomial.X i) = ![u, v] i := fun i => MvPolynomial.eval₂Hom_X' _ _ i
  have hC : ∀ r, MvPolynomial.C r ∈ 𝔓 ↔ r ∈ IsLocalRing.maximalIdeal R := by
    intro r
    rw [h𝔓def, Ideal.mem_comap, hφC, ← Ideal.mem_comap, h𝔔]
  have hXmem : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) R) ∈
      Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
    intro i
    fin_cases i
    · exact Ideal.subset_span (by simp)
    · exact Ideal.subset_span (by simp)
  have h𝒳le : Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ≤ 𝔓 := by
    rw [Ideal.span_le]
    intro x hx
    rcases hx with rfl | hx
    · show φ (MvPolynomial.X 0) ∈ 𝔔
      rw [hφX]; exact hu
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      show φ (MvPolynomial.X 1) ∈ 𝔔
      rw [hφX]; exact hv
  have claimA : ∀ p : MvPolynomial (Fin 2) R,
      p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => rw [MvPolynomial.constantCoeff_C, sub_self]; exact zero_mem _
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
            (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
        rw [map_add, map_add]; ring
      rw [e]; exact add_mem hp hq
    | mul_X p i _ =>
      rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (hXmem i)
  have hmem𝔓 : ∀ p, p ∈ 𝔓 ↔ MvPolynomial.constantCoeff p ∈ IsLocalRing.maximalIdeal R := by
    intro p
    have h1 := claimA p
    constructor
    · intro hp
      rw [← hC]
      have h2 := 𝔓.sub_mem hp (h𝒳le h1)
      rwa [sub_sub_cancel] at h2
    · intro hc
      have e : p = MvPolynomial.C (MvPolynomial.constantCoeff p) +
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) := by ring
      rw [e]
      exact 𝔓.add_mem ((hC _).mpr hc) (h𝒳le h1)
  have h𝔓eq : 𝔓 = Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
      (IsLocalRing.maximalIdeal R) ⊔ Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
    apply le_antisymm
    · intro p hp
      have hc := (hmem𝔓 p).mp hp
      have e : p = MvPolynomial.C (MvPolynomial.constantCoeff p) +
          (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hc))
        (Ideal.mem_sup_right (claimA p))
    · refine sup_le ?_ h𝒳le
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      exact (hC r).mpr hr
  have h𝔓max : 𝔓.IsMaximal := by
    have hker : RingHom.ker ((IsLocalRing.residue R).comp
        (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) R →+* R)) = 𝔓 := by
      ext p
      rw [RingHom.mem_ker, RingHom.comp_apply, IsLocalRing.residue_eq_zero_iff, hmem𝔓]
    rw [← hker]
    apply RingHom.ker_isMaximal_of_surjective
    intro x
    obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective x
    exact ⟨MvPolynomial.C r, by rw [RingHom.comp_apply, MvPolynomial.constantCoeff_C]⟩

  have hψC : ∀ r, ψ (MvPolynomial.C r) = algebraMap R (Localization.AtPrime 𝔔) r := by
    intro r
    rw [hψdef, RingHom.comp_apply, hφC, ← IsScalarTower.algebraMap_apply]
  have hmapC : Ideal.map ψ (Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
      (IsLocalRing.maximalIdeal R)) =
      Ideal.map (algebraMap R (Localization.AtPrime 𝔔)) (IsLocalRing.maximalIdeal R) := by
    rw [Ideal.map_map]
    congr 1
    exact RingHom.ext hψC

  have hΦ : ∀ n : ℕ, (wcNcxcPhi R B 𝔔 u v n : MvPolynomial (Fin 2) R →+* _) =
      ((Ideal.Quotient.mk (wcNcxFibMax R B 𝔔 ^ n)).comp (Ideal.Quotient.mk
        ((IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔔))))).comp ψ := by
    intro n
    apply MvPolynomial.ringHom_ext
    · intro r
      show wcNcxcPhi R B 𝔔 u v n (MvPolynomial.C r) = _
      rw [wcNcxcPhi, MvPolynomial.aeval_C, RingHom.comp_apply, RingHom.comp_apply, hψC,
        Ideal.Quotient.mk_algebraMap, Ideal.Quotient.mk_algebraMap]
    · intro i
      show wcNcxcPhi R B 𝔔 u v n (MvPolynomial.X i) = _
      rw [wcNcxcPhi, MvPolynomial.aeval_X, RingHom.comp_apply, RingHom.comp_apply, hψdef,
        RingHom.comp_apply, hφX]

  have hker : ∀ n : ℕ, RingHom.ker (wcNcxcPhi R B 𝔔 u v n) =
      Ideal.comap ψ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) ^ n ⊔
        Ideal.map (algebraMap R (Localization.AtPrime 𝔔)) (IsLocalRing.maximalIdeal R)) := by
    intro n
    have e0 : RingHom.ker (wcNcxcPhi R B 𝔔 u v n) =
        RingHom.ker (wcNcxcPhi R B 𝔔 u v n :
          MvPolynomial (Fin 2) R →+* wcNcxFib R B 𝔔 ⧸ wcNcxFibMax R B 𝔔 ^ n) :=
      Ideal.ext fun _ => Iff.rfl
    rw [e0, hΦ n, ← RingHom.comap_ker, ← RingHom.comap_ker, Ideal.mk_ker]
    congr 1
    have e1 : wcNcxFibMax R B 𝔔 ^ n = Ideal.map (Ideal.Quotient.mk
        ((IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔔))))
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) ^ n) := (Ideal.map_pow _ _ _).symm
    rw [e1, Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
  have hlift := s6 (MvPolynomial (Fin 2) R) (Localization.AtPrime 𝔔) ψ 𝔓 hmapL
    (fun y => by
      obtain ⟨r, hr⟩ := s3 y
      exact ⟨MvPolynomial.C r, by rw [hψC]; exact hr⟩)
  refine ⟨s5, fun n => ⟨?_, ?_⟩⟩
  ·
    intro w
    obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective d
    obtain ⟨p, hp⟩ := hlift n y
    refine ⟨p, ?_⟩
    have hp' : (wcNcxcPhi R B 𝔔 u v n) p = (((Ideal.Quotient.mk (wcNcxFibMax R B 𝔔 ^ n)).comp
        (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
          (algebraMap R (Localization.AtPrime 𝔔))))).comp ψ) p := by
      rw [← hΦ n]; rfl
    rw [hp', RingHom.comp_apply, RingHom.comp_apply, Ideal.Quotient.eq, ← map_sub,
      ← Ideal.map_pow]
    apply Ideal.mem_map_of_mem
    have e : ψ p - y = -(y - ψ p) := by ring
    rw [e]
    exact neg_mem hp
  ·
    rw [hker n]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [pow_zero, pow_zero, Ideal.one_eq_top, Ideal.one_eq_top, top_sup_eq, sup_top_eq,
        Ideal.comap_top]
    · have hJ : Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
          (IsLocalRing.maximalIdeal R) ⊔ Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n =
          𝔓 ^ n ⊔ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
            (IsLocalRing.maximalIdeal R) := by
        rw [h𝔓eq, s1]
      have hmapJ : Ideal.map ψ (𝔓 ^ n ⊔ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
          (IsLocalRing.maximalIdeal R)) =
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) ^ n ⊔
            Ideal.map (algebraMap R (Localization.AtPrime 𝔔)) (IsLocalRing.maximalIdeal R) := by
        rw [Ideal.map_sup, Ideal.map_pow, hmapL, hmapC]
      have hJle : 𝔓 ^ n ⊔ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
          (IsLocalRing.maximalIdeal R) ≤ 𝔓 := by
        refine sup_le (Ideal.pow_le_self hn.ne') ?_
        rw [h𝔓eq]; exact le_sup_left
      have hrad : (𝔓 ^ n ⊔ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
          (IsLocalRing.maximalIdeal R)).radical = 𝔓 := by
        apply le_antisymm
        · exact (Ideal.IsPrime.radical_le_iff h𝔓max.isPrime).mpr hJle
        · calc 𝔓 = (𝔓 ^ n).radical := by
                rw [Ideal.radical_pow _ hn.ne', h𝔓max.isPrime.radical]
            _ ≤ _ := Ideal.radical_mono le_sup_left
      have hprim : (𝔓 ^ n ⊔ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
          (IsLocalRing.maximalIdeal R)).IsPrimary :=
        Ideal.isPrimary_of_isMaximal_radical (by rw [hrad]; exact h𝔓max)
      rw [← hmapJ, hcomap _ hprim hrad, hJ]

theorem wcpa_dj_ncxc_fp_level3_lines (k : Type u) [Field k]
    (φ : MvPolynomial (Fin 2) k →ₐ[k] MvPolynomial (Fin 2) k ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ 3 : Ideal (MvPolynomial (Fin 2) k)))
    (hφ : Function.Surjective φ)
    (hker : (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin 2) k)) ^ 3 ≤ RingHom.ker φ) :
    ∃ a b c d : k, a * d - b * c ≠ 0 ∧
      φ ((MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) *
        (MvPolynomial.C c * MvPolynomial.X 0 + MvPolynomial.C d * MvPolynomial.X 1)) = 0 :=
by
  classical
  revert φ
  set M : Ideal (MvPolynomial (Fin 2) k) :=
    Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} with hM
  set I : Ideal (MvPolynomial (Fin 2) k) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔ M ^ 3 with hI
  intro φ hφ hker
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ∈ M := Ideal.subset_span (by simp)
  have hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ∈ M := Ideal.subset_span (by simp)
  have hXi : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) k) ∈ M :=
    Fin.forall_fin_two.mpr ⟨hX0, hX1⟩
  have hMM : ∀ i j : Fin 2,
      (MvPolynomial.X i * MvPolynomial.X j : MvPolynomial (Fin 2) k) ∈ M ^ 2 := by
    intro i j
    rw [pow_two]
    exact Ideal.mul_mem_mul (hXi i) (hXi j)

  have hccM : ∀ m ∈ M, MvPolynomial.constantCoeff m = 0 := by
    intro m hm
    have hle : M ≤ RingHom.ker (MvPolynomial.constantCoeff :
        MvPolynomial (Fin 2) k →+* k) := by
      rw [hM, Ideal.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl <;> simp
    exact hle hm

  have s1 : ∀ r ∈ M ^ 2, MvPolynomial.constantCoeff r = 0 ∧
      ∀ i : Fin 2, MvPolynomial.constantCoeff (MvPolynomial.pderiv i r) = 0 := by
    intro r hr
    rw [pow_two] at hr
    refine Submodule.mul_induction_on hr ?_ ?_
    · intro m hm n hn
      refine ⟨by rw [map_mul, hccM m hm, zero_mul], fun i => ?_⟩
      rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hccM m hm, hccM n hn]
      ring
    · intro x y hx hy
      exact ⟨by rw [map_add, hx.1, hy.1, add_zero],
        fun i => by rw [map_add, map_add, hx.2 i, hy.2 i, add_zero]⟩

  have s2 : ∀ p : MvPolynomial (Fin 2) k,
      p - MvPolynomial.C (MvPolynomial.constantCoeff p)
        - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 p)) * MvPolynomial.X 0
        - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 p)) * MvPolynomial.X 1
        ∈ M ^ 2 := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q))
          - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 (p + q)))
            * MvPolynomial.X 0
          - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 (p + q)))
            * MvPolynomial.X 1
          = (p - MvPolynomial.C (MvPolynomial.constantCoeff p)
              - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 p))
                * MvPolynomial.X 0
              - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 p))
                * MvPolynomial.X 1)
            + (q - MvPolynomial.C (MvPolynomial.constantCoeff q)
              - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 q))
                * MvPolynomial.X 0
              - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 q))
                * MvPolynomial.X 1) := by
        simp only [map_add]
        ring
      rw [e]
      exact add_mem hp hq
    | mul_X p n hp =>
      have key : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.constantCoeff
            (p * MvPolynomial.X n))
          - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0
              (p * MvPolynomial.X n))) * MvPolynomial.X 0
          - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 1
              (p * MvPolynomial.X n))) * MvPolynomial.X 1
          = (p - MvPolynomial.C (MvPolynomial.constantCoeff p)
              - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 p))
                * MvPolynomial.X 0
              - MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 p))
                * MvPolynomial.X 1) * MvPolynomial.X n
            + MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 p))
                * (MvPolynomial.X 0 * MvPolynomial.X n)
            + MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 p))
                * (MvPolynomial.X 1 * MvPolynomial.X n) := by
        obtain rfl | rfl : n = 0 ∨ n = 1 := by fin_cases n <;> simp
        · simp [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, Pi.single_apply]
          ring
        · simp [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, Pi.single_apply]
          ring
      rw [key]
      exact add_mem (add_mem (Ideal.mul_mem_right _ _ hp)
        (Ideal.mul_mem_left _ _ (hMM _ _))) (Ideal.mul_mem_left _ _ (hMM _ _))

  have s3 : ∀ f : Fin 2 → MvPolynomial (Fin 2) k,
      (∀ i, MvPolynomial.constantCoeff (f i) = 0) → ∀ p : MvPolynomial (Fin 2) k,
      MvPolynomial.constantCoeff (MvPolynomial.aeval f p) = MvPolynomial.constantCoeff p ∧
      ∀ j : Fin 2, MvPolynomial.constantCoeff (MvPolynomial.pderiv j (MvPolynomial.aeval f p)) =
        ∑ i : Fin 2, MvPolynomial.constantCoeff (MvPolynomial.pderiv i p) *
          MvPolynomial.constantCoeff (MvPolynomial.pderiv j (f i)) := by
    intro f hf0 p
    induction p using MvPolynomial.induction_on with
    | C a =>
      refine ⟨by simp [MvPolynomial.aeval_C], fun j => by simp [MvPolynomial.aeval_C]⟩
    | add p q hp hq =>
      refine ⟨by rw [map_add, map_add, map_add, hp.1, hq.1], fun j => ?_⟩
      rw [map_add, map_add, map_add, hp.2 j, hq.2 j, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_add, map_add, add_mul]
    | mul_X p n hp =>
      obtain rfl | rfl : n = 0 ∨ n = 1 := by fin_cases n <;> simp
      · refine ⟨by simp [hf0], fun j => ?_⟩
        rw [map_mul (MvPolynomial.aeval f) p (MvPolynomial.X _), MvPolynomial.aeval_X,
          MvPolynomial.pderiv_mul, map_add, map_mul MvPolynomial.constantCoeff,
          map_mul MvPolynomial.constantCoeff, hf0, hp.1]
        simp [MvPolynomial.pderiv_X, Pi.single_apply, Fin.sum_univ_two]
      · refine ⟨by simp [hf0], fun j => ?_⟩
        rw [map_mul (MvPolynomial.aeval f) p (MvPolynomial.X _), MvPolynomial.aeval_X,
          MvPolynomial.pderiv_mul, map_add, map_mul MvPolynomial.constantCoeff,
          map_mul MvPolynomial.constantCoeff, hf0, hp.1]
        simp [MvPolynomial.pderiv_X, Pi.single_apply, Fin.sum_univ_two]

  choose f hf using fun i : Fin 2 => Ideal.Quotient.mk_surjective (I := I) (φ (MvPolynomial.X i))
  have hφF : ∀ P, φ P = Ideal.Quotient.mk I (MvPolynomial.aeval f P) := by
    have hcomp : (Ideal.Quotient.mkₐ k I).comp (MvPolynomial.aeval f) = φ := by
      apply MvPolynomial.algHom_ext
      intro i
      simp [hf]
    intro P
    rw [← hcomp]
    rfl
  have hIM : I ≤ M ^ 2 := by
    refine sup_le ?_ (Ideal.pow_le_pow_right (by norm_num))
    rw [Ideal.span_singleton_le_iff_mem]
    exact hMM 0 1
  have hJ : ∀ P Q : MvPolynomial (Fin 2) k, Ideal.Quotient.mk I P = Ideal.Quotient.mk I Q →
      MvPolynomial.constantCoeff P = MvPolynomial.constantCoeff Q ∧
      ∀ i : Fin 2, MvPolynomial.constantCoeff (MvPolynomial.pderiv i P) =
        MvPolynomial.constantCoeff (MvPolynomial.pderiv i Q) := by
    intro P Q h
    have h1 := s1 (P - Q) (hIM (Ideal.Quotient.eq.mp h))
    refine ⟨?_, fun i => ?_⟩
    · have h2 := h1.1
      rw [map_sub, sub_eq_zero] at h2
      exact h2
    · have h2 := h1.2 i
      rw [map_sub, map_sub, sub_eq_zero] at h2
      exact h2

  have hf0 : ∀ i, MvPolynomial.constantCoeff (f i) = 0 := by
    intro i
    have h3 : MvPolynomial.X i ^ 3 ∈ RingHom.ker φ := hker (Ideal.pow_mem_pow (hXi i) 3)
    rw [RingHom.mem_ker, map_pow, ← hf, ← map_pow, Ideal.Quotient.eq_zero_iff_mem] at h3
    have h4 := (s1 _ (hIM h3)).1
    rw [map_pow] at h4
    exact (pow_eq_zero_iff (by norm_num : (3 : ℕ) ≠ 0)).mp h4
  have hS3 := s3 f hf0

  obtain ⟨p, hp⟩ := hφ (Ideal.Quotient.mk I (MvPolynomial.X 0))
  obtain ⟨q, hq⟩ := hφ (Ideal.Quotient.mk I (MvPolynomial.X 1))
  have jp := hJ (MvPolynomial.aeval f p) (MvPolynomial.X 0) (by rw [← hφF, hp])
  have jq := hJ (MvPolynomial.aeval f q) (MvPolynomial.X 1) (by rw [← hφF, hq])
  have d00 : MvPolynomial.constantCoeff
      (MvPolynomial.pderiv 0 (MvPolynomial.X 0 : MvPolynomial (Fin 2) k)) = 1 := by
    simp [MvPolynomial.pderiv_X]
  have d01 : MvPolynomial.constantCoeff
      (MvPolynomial.pderiv 1 (MvPolynomial.X 0 : MvPolynomial (Fin 2) k)) = 0 := by
    simp [MvPolynomial.pderiv_X, Pi.single_apply]
  have d10 : MvPolynomial.constantCoeff
      (MvPolynomial.pderiv 0 (MvPolynomial.X 1 : MvPolynomial (Fin 2) k)) = 0 := by
    simp [MvPolynomial.pderiv_X, Pi.single_apply]
  have d11 : MvPolynomial.constantCoeff
      (MvPolynomial.pderiv 1 (MvPolynomial.X 1 : MvPolynomial (Fin 2) k)) = 1 := by
    simp [MvPolynomial.pderiv_X]
  have E1 := jp.2 0
  have E2 := jp.2 1
  have E3 := jq.2 0
  have E4 := jq.2 1
  rw [(hS3 p).2, Fin.sum_univ_two, d00] at E1
  rw [(hS3 p).2, Fin.sum_univ_two, d01] at E2
  rw [(hS3 q).2, Fin.sum_univ_two, d10] at E3
  rw [(hS3 q).2, Fin.sum_univ_two, d11] at E4

  have hr : ∀ r : MvPolynomial (Fin 2) k, MvPolynomial.constantCoeff r = 0 →
      MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 r) = 0 →
      MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 r) = 0 → r ∈ M ^ 2 := by
    intro r h0 h1 h2
    have h := s2 r
    rw [h0, h1, h2] at h
    simpa using h
  have hl : ∀ x y : k,
      MvPolynomial.constantCoeff (MvPolynomial.C x * MvPolynomial.X 0 +
        MvPolynomial.C y * MvPolynomial.X 1 : MvPolynomial (Fin 2) k) = 0 ∧
      MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 (MvPolynomial.C x * MvPolynomial.X 0 +
        MvPolynomial.C y * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)) = x ∧
      MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 (MvPolynomial.C x * MvPolynomial.X 0 +
        MvPolynomial.C y * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)) = y := by
    intro x y
    refine ⟨by simp, ?_, ?_⟩
    · simp [MvPolynomial.pderiv_X, Pi.single_apply]
    · simp [MvPolynomial.pderiv_X, Pi.single_apply]
  set a := MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 p) with ha
  set b := MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 p) with hb
  set c := MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 q) with hc
  set d := MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 q) with hd
  refine ⟨a, b, c, d, ?_, ?_⟩
  ·
    intro h
    have key : (a * d - b * c) *
        (MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 (f 0)) *
          MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 (f 1)) -
         MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 (f 0)) *
          MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 (f 1))) = 1 := by
      linear_combination (c * MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 (f 0)) +
          d * MvPolynomial.constantCoeff (MvPolynomial.pderiv 1 (f 1))) * E1 + E4 -
        (c * MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 (f 0)) +
          d * MvPolynomial.constantCoeff (MvPolynomial.pderiv 0 (f 1))) * E2
    rw [h, zero_mul] at key
    exact zero_ne_one key
  ·
    have hr1 : MvPolynomial.aeval f (MvPolynomial.C a * MvPolynomial.X 0 +
        MvPolynomial.C b * MvPolynomial.X 1) - MvPolynomial.X 0 ∈ M ^ 2 := by
      apply hr
      · rw [map_sub, (hS3 _).1, (hl a b).1]; simp
      · rw [map_sub, map_sub, (hS3 _).2, Fin.sum_univ_two, (hl a b).2.1, (hl a b).2.2, d00]
        linear_combination E1
      · rw [map_sub, map_sub, (hS3 _).2, Fin.sum_univ_two, (hl a b).2.1, (hl a b).2.2, d01]
        linear_combination E2
    have hr2 : MvPolynomial.aeval f (MvPolynomial.C c * MvPolynomial.X 0 +
        MvPolynomial.C d * MvPolynomial.X 1) - MvPolynomial.X 1 ∈ M ^ 2 := by
      apply hr
      · rw [map_sub, (hS3 _).1, (hl c d).1]; simp
      · rw [map_sub, map_sub, (hS3 _).2, Fin.sum_univ_two, (hl c d).2.1, (hl c d).2.2, d10]
        linear_combination E3
      · rw [map_sub, map_sub, (hS3 _).2, Fin.sum_univ_two, (hl c d).2.1, (hl c d).2.2, d11]
        linear_combination E4
    rw [hφF, Ideal.Quotient.eq_zero_iff_mem]
    set r₁ := MvPolynomial.aeval f (MvPolynomial.C a * MvPolynomial.X 0 +
        MvPolynomial.C b * MvPolynomial.X 1) - MvPolynomial.X 0 with hr₁
    set r₂ := MvPolynomial.aeval f (MvPolynomial.C c * MvPolynomial.X 0 +
        MvPolynomial.C d * MvPolynomial.X 1) - MvPolynomial.X 1 with hr₂
    have e : MvPolynomial.aeval f ((MvPolynomial.C a * MvPolynomial.X 0 +
        MvPolynomial.C b * MvPolynomial.X 1) * (MvPolynomial.C c * MvPolynomial.X 0 +
        MvPolynomial.C d * MvPolynomial.X 1)) =
        MvPolynomial.X 0 * MvPolynomial.X 1 +
          (MvPolynomial.X 0 * r₂ + MvPolynomial.X 1 * r₁ + r₁ * r₂) := by
      rw [map_mul, hr₁, hr₂]
      ring
    rw [e]
    have hM3 : M ^ 3 = M * M ^ 2 := pow_succ' M 2
    have hM2 : M ^ 2 ≤ M := Ideal.pow_le_self two_ne_zero
    refine add_mem (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
      (Ideal.mem_sup_right ?_)
    rw [hM3]
    exact add_mem (add_mem (Ideal.mul_mem_mul hX0 hr2) (Ideal.mul_mem_mul hX1 hr1))
      (Ideal.mul_mem_mul (hM2 hr1) hr2)

theorem wcpa_dj_ncxc_fp_trunc_kernel (k : Type u) [Field k] (n : ℕ)
    (φ : MvPolynomial (Fin 2) k →ₐ[k] MvPolynomial (Fin 2) k ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n : Ideal (MvPolynomial (Fin 2) k)))
    (hφ : Function.Surjective φ)
    (G₂ G₃ : MvPolynomial (Fin 2) k) (hG₂ : G₂.IsHomogeneous 2) (hG₂0 : G₂ ≠ 0)
    (hG₃ : G₃ ∈ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin 2) k)) ^ 3)
    (hle : Ideal.span {G₂ + G₃} ⊔ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin 2) k)) ^ n ≤ RingHom.ker φ) :
    RingHom.ker φ = Ideal.span {G₂ + G₃} ⊔ (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
      Ideal (MvPolynomial (Fin 2) k)) ^ n :=
by
  open MvPolynomial in
  classical
  let m : Ideal (MvPolynomial (Fin 2) k) := Ideal.span {X 0, X 1}

  have hdeg1 : ∀ g ∈ m, ∀ e ∈ g.support, 1 ≤ e 0 + e 1 := by
    intro g hg
    induction hg using Submodule.span_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · intro e he; rw [support_X, Finset.mem_singleton] at he; subst he; simp
      · intro e he; rw [support_X, Finset.mem_singleton] at he; subst he; simp
    | zero => simp
    | add x y _ _ hx hy =>
      intro e he
      rcases Finset.mem_union.mp (support_add he) with h | h
      exacts [hx e h, hy e h]
    | smul a x _ hx =>
      intro e he
      rw [smul_eq_mul] at he
      obtain ⟨e1, _, e2, he2, rfl⟩ := Finset.mem_add.mp (support_mul a x he)
      have := hx e2 he2
      simp only [Finsupp.add_apply]; omega
  have tD : ∀ (r : ℕ) (p : MvPolynomial (Fin 2) k), p ∈ m ^ r → ∀ e ∈ p.support, r ≤ e 0 + e 1 := by
    intro r
    induction r with
    | zero => intros; omega
    | succ r ih =>
      intro p hp
      rw [pow_succ] at hp
      refine Submodule.mul_induction_on (C := fun p => ∀ e ∈ p.support, r + 1 ≤ e 0 + e 1) hp ?_ ?_
      · intro f hf g hg e he
        obtain ⟨e1, he1, e2, he2, rfl⟩ := Finset.mem_add.mp (support_mul f g he)
        have h1 := ih f hf e1 he1
        have h2 := hdeg1 g hg e2 he2
        simp only [Finsupp.add_apply]; omega
      · intro x y hx hy e he
        rcases Finset.mem_union.mp (support_add he) with h | h
        exacts [hx e h, hy e h]
  have tMon : ∀ i j r : ℕ, r ≤ i + j → (X 0 ^ i * X 1 ^ j : MvPolynomial (Fin 2) k) ∈ m ^ r := by
    intro i j r h
    apply Ideal.pow_le_pow_right h
    rw [pow_add]
    exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) i)
      (Ideal.pow_mem_pow (Ideal.subset_span (by simp)) j)
  have tM2 : ∀ (V : Submodule k (MvPolynomial (Fin 2) k)) (d : ℕ),
      (∀ i j, d ≤ i + j → (X 0 ^ i * X 1 ^ j : MvPolynomial (Fin 2) k) ∈ V) →
      ∀ q : MvPolynomial (Fin 2) k, (∀ e ∈ q.support, d ≤ e 0 + e 1) → q ∈ V := by
    intro V d hV q hq
    rw [q.as_sum]
    refine Submodule.sum_mem _ (fun e he => ?_)
    have : monomial e (q.coeff e) =
        q.coeff e • (X 0 ^ e 0 * X 1 ^ e 1 : MvPolynomial (Fin 2) k) := by
      rw [smul_eq_C_mul, monomial_eq, Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_two]
    rw [this]
    exact V.smul_mem _ (hV _ _ (hq e he))
  have tFrame : ∀ (V : Submodule k (MvPolynomial (Fin 2) k)),
      (∀ p ∈ m ^ n, p ∈ V) →
      (∀ d < n, (∀ q : MvPolynomial (Fin 2) k, (∀ e ∈ q.support, d + 1 ≤ e 0 + e 1) → q ∈ V) →
        ∀ i j, i + j = d → (X 0 ^ i * X 1 ^ j : MvPolynomial (Fin 2) k) ∈ V) →
      ∀ p : MvPolynomial (Fin 2) k, p ∈ V := by
    intro V hV hstep p
    have R : ∀ t, ∀ i j, n - t ≤ i + j → (X 0 ^ i * X 1 ^ j : MvPolynomial (Fin 2) k) ∈ V := by
      intro t
      induction t with
      | zero => intro i j h; exact hV _ (tMon i j n (by simpa using h))
      | succ t ih =>
        intro i j h
        by_cases ht : n ≤ t
        · exact ih i j (by omega)
        · by_cases hij : i + j = n - (t+1)
          · exact hstep (n - (t+1)) (by omega) (fun q hq => tM2 V _
              (fun i' j' h' => ih i' j' (by omega)) q (fun e he => by have := hq e he; omega)) i j hij
          · exact ih i j (by omega)
    exact tM2 V 0 (fun i j _ => R n i j (by omega)) p (fun _ _ => Nat.zero_le _)

  have tQuad : G₂ = C (G₂.coeff (Finsupp.single 0 2)) * X 0 ^ 2 +
      C (G₂.coeff (Finsupp.single 0 1 + Finsupp.single 1 1)) * (X 0 * X 1) +
      C (G₂.coeff (Finsupp.single 1 2)) * X 1 ^ 2 := by
    have hX : (X 0 * X 1 : MvPolynomial (Fin 2) k) =
        monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1 := by
      rw [X, X, monomial_mul_monomial, one_mul]
    ext e
    obtain ⟨p, q, rfl⟩ : ∃ p q : ℕ, e = Finsupp.single 0 p + Finsupp.single 1 q :=
      ⟨e 0, e 1, by ext i; fin_cases i <;> simp⟩
    rw [hX]
    simp only [MvPolynomial.coeff_add, coeff_C_mul, coeff_X_pow, coeff_monomial]
    by_cases hpq : p + q = 2
    · have hp : p ≤ 2 := by omega
      have hq : q ≤ 2 := by omega
      interval_cases p <;> interval_cases q <;> first | omega | simp [Finsupp.ext_iff, Fin.forall_fin_two]
    · rw [hG₂.coeff_eq_zero (by simpa [Finsupp.degree_single] using hpq)]
      have hne : ∀ f : Fin 2 →₀ ℕ, f 0 + f 1 = 2 → f ≠ Finsupp.single 0 p + Finsupp.single 1 q := by
        intro f hf h; subst h; simp at hf; omega
      rw [if_neg (hne _ (by simp)), if_neg (hne _ (by simp)), if_neg (hne _ (by simp))]
      simp

  have tIndep : LinearIndependent k (Sum.elim
      (fun i : Fin n => Ideal.Quotient.mk (Ideal.span {X 0 * X 1} ⊔ m ^ n) (X 0 ^ (i : ℕ)))
      (fun j : Fin (n - 1) => Ideal.Quotient.mk (Ideal.span {X 0 * X 1} ⊔ m ^ n)
        (X 1 ^ ((j : ℕ) + 1)))) := by
    set J : Ideal (MvPolynomial (Fin 2) k) := Ideal.span {X 0 * X 1} ⊔ m ^ n with hJ
    let E' : Fin n ⊕ Fin (n - 1) → MvPolynomial (Fin 2) k :=
      Sum.elim (fun i => monomial (Finsupp.single 0 (i : ℕ)) 1)
        (fun j => monomial (Finsupp.single 1 ((j : ℕ) + 1)) 1)
    have hw : (Sum.elim (fun i : Fin n => Ideal.Quotient.mk J (X 0 ^ (i : ℕ)))
        (fun j : Fin (n - 1) => Ideal.Quotient.mk J (X 1 ^ ((j : ℕ) + 1)))) =
        (Ideal.Quotient.mkₐ k J) ∘ E' := by
      ext x; cases x <;> simp [E', X_pow_eq_monomial]
    rw [hw, Fintype.linearIndependent_iff]
    intro g hg
    have hq : (∑ i, g i • E' i) ∈ J := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk k, map_sum]
      simpa using hg
    obtain ⟨s, hs, t, ht, hst⟩ := Submodule.mem_sup.mp hq
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hs
    have htc : ∀ e : Fin 2 →₀ ℕ, e 0 + e 1 < n → t.coeff e = 0 := by
      intro e he
      by_contra hne
      have := tD n t ht e (MvPolynomial.mem_support_iff.mpr hne)
      omega
    have hcoef : ∀ e : Fin 2 →₀ ℕ, (∑ i, g i • E' i).coeff e =
        (∑ i : Fin n, if Finsupp.single 0 (i : ℕ) = e then g (Sum.inl i) else 0) +
        ∑ j : Fin (n - 1), if Finsupp.single 1 ((j : ℕ) + 1) = e then g (Sum.inr j) else 0 := by
      intro e
      rw [Fintype.sum_sum_type, MvPolynomial.coeff_add, coeff_sum, coeff_sum]
      congr 1
      · refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [E', Sum.elim_inl, coeff_smul, coeff_monomial, smul_eq_mul]
        split_ifs <;> simp
      · refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [E', Sum.elim_inr, coeff_smul, coeff_monomial, smul_eq_mul]
        split_ifs <;> simp
    intro x
    cases x with
    | inl i0 =>
      have h1 : (∑ i, g i • E' i).coeff (Finsupp.single 0 (i0 : ℕ)) = g (Sum.inl i0) := by
        rw [hcoef, Finset.sum_eq_single i0, Finset.sum_eq_zero, if_pos rfl, add_zero]
        · intro j _
          rw [if_neg]
          intro h
          have := congrArg (fun f => f 1) h
          simp at this
        · intro i _ hi
          rw [if_neg]
          intro h
          have := congrArg (fun f => f 0) h
          simp only [Finsupp.single_eq_same] at this
          exact hi (Fin.ext this)
        · simp
      have h2 : (r * (X 0 * X 1)).coeff (Finsupp.single 0 (i0 : ℕ)) = 0 := by
        rw [← mul_assoc, coeff_mul_X']
        simp
      rw [← h1, ← hst, MvPolynomial.coeff_add, h2, htc _ (by simp)]
      simp
    | inr j0 =>
      have h1 : (∑ i, g i • E' i).coeff (Finsupp.single 1 ((j0 : ℕ) + 1)) = g (Sum.inr j0) := by
        rw [hcoef, Finset.sum_eq_single j0, Finset.sum_eq_zero, if_pos rfl, zero_add]
        · intro j _
          rw [if_neg]
          intro h
          have := congrArg (fun f => f 1) h
          simp at this
        · intro i _ hi
          rw [if_neg]
          intro h
          have := congrArg (fun f => f 1) h
          simp only [Finsupp.single_eq_same] at this
          exact hi (Fin.ext (by omega))
        · simp
      have h2 : (r * (X 0 * X 1)).coeff (Finsupp.single 1 ((j0 : ℕ) + 1)) = 0 := by
        rw [mul_comm (X 0 : MvPolynomial (Fin 2) k), ← mul_assoc, coeff_mul_X', if_neg (by simp)]
      rw [← h1, ← hst, MvPolynomial.coeff_add, h2, htc _ (by simp; omega)]
      simp

  set I : Ideal (MvPolynomial (Fin 2) k) := Ideal.span {G₂ + G₃} ⊔ m ^ n with hI
  have tDim : ∀ E : Fin n ⊕ Fin (n - 1) → MvPolynomial (Fin 2) k,
      (∀ p, p ∈ Submodule.span k (Set.range E) ⊔ I.restrictScalars k) → RingHom.ker φ ≤ I := by
    intro E hE
    let L : (Fin n ⊕ Fin (n - 1) → k) →ₗ[k] _ := Fintype.linearCombination k (fun i => φ (E i))
    have hL : ∀ c, L c = φ (∑ i, c i • E i) := by
      intro c
      simp only [L, Fintype.linearCombination_apply, map_sum, map_smul]
    have hdec : ∀ p, ∃ c : Fin n ⊕ Fin (n - 1) → k, ∃ z ∈ I, p = ∑ i, c i • E i + z := by
      intro p
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (hE p)
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp hy
      exact ⟨c, z, hz, rfl⟩
    have hφI : ∀ z ∈ I, φ z = 0 := fun z hz => RingHom.mem_ker.mp (hle hz)
    have hLs : Function.Surjective L := by
      intro b
      obtain ⟨p, rfl⟩ := hφ b
      obtain ⟨c, z, hz, rfl⟩ := hdec p
      exact ⟨c, by rw [hL, map_add, hφI z hz, add_zero]⟩
    haveI : Module.Finite k (MvPolynomial (Fin 2) k ⧸ (Ideal.span {X 0 * X 1} ⊔ m ^ n)) :=
      Module.Finite.of_surjective L hLs
    have h1 : Fintype.card (Fin n ⊕ Fin (n - 1)) ≤ Module.finrank k (MvPolynomial (Fin 2) k ⧸
        (Ideal.span {X 0 * X 1} ⊔ Ideal.span {X 0, X 1} ^ n : Ideal (MvPolynomial (Fin 2) k))) :=
      tIndep.fintype_card_le_finrank
    have h2 := LinearMap.finrank_le_finrank_of_surjective hLs
    rw [Module.finrank_fintype_fun_eq_card] at h2
    have hLi : Function.Injective L :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
        (by rw [Module.finrank_fintype_fun_eq_card]; omega)).mpr hLs
    intro p hp
    obtain ⟨c, z, hz, rfl⟩ := hdec p
    have hc : L c = L 0 := by
      rw [map_zero, hL]
      have := RingHom.mem_ker.mp hp
      rw [map_add, hφI z hz, add_zero] at this
      exact this
    have := hLi hc
    subst this
    simpa using hz
  refine le_antisymm ?_ hle
  have hGI : ∀ s, s * (G₂ + G₃) ∈ I := fun s =>
    Ideal.mem_sup_left (Ideal.mul_mem_left _ s (Ideal.mem_span_singleton_self _))
  have frame : ∀ E : Fin n ⊕ Fin (n - 1) → MvPolynomial (Fin 2) k,
      (∀ d < n, (∀ q : MvPolynomial (Fin 2) k, (∀ e ∈ q.support, d + 1 ≤ e 0 + e 1) →
        q ∈ Submodule.span k (Set.range E) ⊔ I.restrictScalars k) →
        (∀ s : MvPolynomial (Fin 2) k,
          s * (G₂ + G₃) ∈ Submodule.span k (Set.range E) ⊔ I.restrictScalars k) →
        (∀ α β, α + β + 2 = d → X 0 ^ α * X 1 ^ β * G₃ ∈
          Submodule.span k (Set.range E) ⊔ I.restrictScalars k) →
        ∀ i j, i + j = d → (X 0 ^ i * X 1 ^ j : MvPolynomial (Fin 2) k) ∈
          Submodule.span k (Set.range E) ⊔ I.restrictScalars k) →
      RingHom.ker φ ≤ I := by
    intro E hstep
    refine tDim E (tFrame _ (fun p hp => Submodule.mem_sup_right
      (show p ∈ I.restrictScalars k from Ideal.mem_sup_right hp)) ?_)
    intro d hd Hd
    refine hstep d hd Hd (fun s => Submodule.mem_sup_right
      (show s * (G₂ + G₃) ∈ I.restrictScalars k from hGI s)) ?_
    intro α β hαβ
    refine Hd _ (fun e he => ?_)
    have hmem : X 0 ^ α * X 1 ^ β * G₃ ∈ m ^ (α + β + 3) := by
      rw [pow_add]
      exact Ideal.mul_mem_mul (tMon α β _ le_rfl) hG₃
    have := tD _ _ hmem e he
    omega
  obtain ⟨a, b, c, hG⟩ : ∃ a b c : k,
      G₂ = C a * X 0 ^ 2 + C b * (X 0 * X 1) + C c * X 1 ^ 2 := ⟨_, _, _, tQuad⟩
  by_cases ha : a ≠ 0
  ·
    refine frame (Sum.elim (fun j : Fin n => X 0 ^ 0 * X 1 ^ (j : ℕ))
      (fun j : Fin (n - 1) => X 0 ^ 1 * X 1 ^ (j : ℕ))) ?_
    intro d hd Hd hGV hG3V i
    induction i using Nat.strong_induction_on with
    | _ i ih =>
      intro j hij
      rcases i with _ | _ | i'
      · exact Submodule.mem_sup_left (Submodule.subset_span ⟨Sum.inl ⟨j, by omega⟩, rfl⟩)
      · exact Submodule.mem_sup_left (Submodule.subset_span ⟨Sum.inr ⟨j, by omega⟩, rfl⟩)
      · have key : a • (X 0 ^ (i' + 2) * X 1 ^ j : MvPolynomial (Fin 2) k) =
            X 0 ^ i' * X 1 ^ j * (G₂ + G₃) - b • (X 0 ^ (i' + 1) * X 1 ^ (j + 1)) -
              c • (X 0 ^ i' * X 1 ^ (j + 2)) - X 0 ^ i' * X 1 ^ j * G₃ := by
          rw [hG]; simp only [smul_eq_C_mul]; ring
        have e1 : (X 0 ^ (i' + 2) * X 1 ^ j : MvPolynomial (Fin 2) k) =
            a⁻¹ • (a • (X 0 ^ (i' + 2) * X 1 ^ j)) := by
          rw [smul_smul, inv_mul_cancel₀ ha, one_smul]
        rw [e1, key]
        refine Submodule.smul_mem _ _ (Submodule.sub_mem _ (Submodule.sub_mem _
          (Submodule.sub_mem _ (hGV _) (Submodule.smul_mem _ _ (ih (i' + 1) (by omega) _ (by omega))))
          (Submodule.smul_mem _ _ (ih i' (by omega) _ (by omega)))) (hG3V i' j (by omega)))
  push_neg at ha
  by_cases hc : c ≠ 0
  ·
    refine frame (Sum.elim (fun i : Fin n => X 0 ^ (i : ℕ) * X 1 ^ 0)
      (fun i : Fin (n - 1) => X 0 ^ (i : ℕ) * X 1 ^ 1)) ?_
    intro d hd Hd hGV hG3V
    have main : ∀ j i, i + j = d → (X 0 ^ i * X 1 ^ j : MvPolynomial (Fin 2) k) ∈
        Submodule.span k (Set.range (Sum.elim (fun i : Fin n => X 0 ^ (i : ℕ) * X 1 ^ 0)
          (fun i : Fin (n - 1) => X 0 ^ (i : ℕ) * X 1 ^ 1))) ⊔ I.restrictScalars k := by
      intro j
      induction j using Nat.strong_induction_on with
      | _ j ih =>
        intro i hij
        rcases j with _ | _ | j'
        · exact Submodule.mem_sup_left (Submodule.subset_span ⟨Sum.inl ⟨i, by omega⟩, rfl⟩)
        · exact Submodule.mem_sup_left (Submodule.subset_span ⟨Sum.inr ⟨i, by omega⟩, rfl⟩)
        · have key : c • (X 0 ^ i * X 1 ^ (j' + 2) : MvPolynomial (Fin 2) k) =
              X 0 ^ i * X 1 ^ j' * (G₂ + G₃) - a • (X 0 ^ (i + 2) * X 1 ^ j') -
                b • (X 0 ^ (i + 1) * X 1 ^ (j' + 1)) - X 0 ^ i * X 1 ^ j' * G₃ := by
            rw [hG]; simp only [smul_eq_C_mul]; ring
          have e1 : (X 0 ^ i * X 1 ^ (j' + 2) : MvPolynomial (Fin 2) k) =
              c⁻¹ • (c • (X 0 ^ i * X 1 ^ (j' + 2))) := by
            rw [smul_smul, inv_mul_cancel₀ hc, one_smul]
          rw [e1, key]
          refine Submodule.smul_mem _ _ (Submodule.sub_mem _ (Submodule.sub_mem _
            (Submodule.sub_mem _ (hGV _) (Submodule.smul_mem _ _ (ih j' (by omega) _ (by omega))))
            (Submodule.smul_mem _ _ (ih (j' + 1) (by omega) _ (by omega)))) (hG3V i j' (by omega)))
    exact fun i j hij => main j i hij
  push_neg at hc
  have hb : b ≠ 0 := by
    rintro rfl
    apply hG₂0
    rw [hG, ha, hc]
    simp

  refine frame (Sum.elim (fun i : Fin n => X 0 ^ (i : ℕ) * X 1 ^ 0)
    (fun j : Fin (n - 1) => X 0 ^ 0 * X 1 ^ ((j : ℕ) + 1))) ?_
  intro d hd Hd hGV hG3V i j hij
  rcases j with _ | j'
  · exact Submodule.mem_sup_left (Submodule.subset_span ⟨Sum.inl ⟨i, by omega⟩, rfl⟩)
  rcases i with _ | i'
  · exact Submodule.mem_sup_left (Submodule.subset_span ⟨Sum.inr ⟨j', by omega⟩, rfl⟩)
  have key : b • (X 0 ^ (i' + 1) * X 1 ^ (j' + 1) : MvPolynomial (Fin 2) k) =
      X 0 ^ i' * X 1 ^ j' * (G₂ + G₃) - X 0 ^ i' * X 1 ^ j' * G₃ := by
    rw [hG, ha, hc]; simp only [smul_eq_C_mul, map_zero]; ring
  have e1 : (X 0 ^ (i' + 1) * X 1 ^ (j' + 1) : MvPolynomial (Fin 2) k) =
      b⁻¹ • (b • (X 0 ^ (i' + 1) * X 1 ^ (j' + 1))) := by
    rw [smul_smul, inv_mul_cancel₀ hb, one_smul]
  rw [e1, key]
  exact Submodule.smul_mem _ _ (Submodule.sub_mem _ (hGV _) (hG3V i' j' (by omega)))

theorem wcpa_dj_ncxc_fibre_principal (R : Type u) [CommRing R] [IsLocalRing R]
    (B A' : Type u) [CommRing B] [Algebra R B] [CommRing A'] [Algebra R A']
    (π : B →ₐ[R] A') (hπ : Function.Surjective π)
    (𝔮' : Ideal A') [𝔮'.IsPrime]
    (h𝔮' : 𝔮'.comap (algebraMap R A') = IsLocalRing.maximalIdeal R)
    (u v : B) (hu : u ∈ Ideal.comap π 𝔮') (hv : v ∈ Ideal.comap π 𝔮')
    (hres : Function.Surjective ((Ideal.Quotient.mk (Ideal.comap π 𝔮')).comp (algebraMap R B)))
    (hnoeth : IsNoetherianRing (wcNcxFib R B (Ideal.comap π 𝔮')))
    (hΦ : ∀ n : ℕ, Function.Surjective (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n) ∧
      RingHom.ker (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n) =
        Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R) (IsLocalRing.maximalIdeal R) ⊔
          Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n)
    (hlev : wcNcxLevels R A' 𝔮') :
    ∃ g₀ ∈ RingHom.ker π, ∃ a b c d : R, IsUnit (a * d - b * c) ∧
      (∃ t ∉ Ideal.comap π 𝔮', t * (g₀ - (algebraMap R B a * u + algebraMap R B b * v) *
          (algebraMap R B c * u + algebraMap R B d * v)) ∈
        Ideal.comap π 𝔮' ^ 3 ⊔ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) ∧
      ∀ y ∈ RingHom.ker π, ∃ b' : B, ∃ t ∉ Ideal.comap π 𝔮',
        t * y - b' * g₀ ∈ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R) :=
by
  classical

  have fibMap : ∃ Ψ : wcNcxFib R B (Ideal.comap π 𝔮') →ₐ[R] wcNcxFib R A' 𝔮',
      Function.Surjective Ψ ∧
      (∀ x : B, Ψ (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
          (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮'))))
          (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')) x)) =
        Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime 𝔮')))
          (algebraMap A' (Localization.AtPrime 𝔮') (π x))) ∧
      Ideal.map Ψ (wcNcxFibMax R B (Ideal.comap π 𝔮')) = wcNcxFibMax R A' 𝔮' ∧
      ∀ z, Ψ z = 0 → ∃ j ∈ RingHom.ker π, ∃ w ∉ Ideal.comap π 𝔮',
        z * Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
          (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮'))))
          (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')) w) =
        Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
          (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮'))))
          (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')) j) := by
    set 𝔔 := Ideal.comap π 𝔮' with h𝔔
    have unwind : ∀ (C : Type u) [CommRing C] (P : Ideal C) [P.IsPrime] (I : Ideal C) (x : C),
        algebraMap C (Localization.AtPrime P) x ∈
          Ideal.map (algebraMap C (Localization.AtPrime P)) I →
        ∃ t ∉ P, t * x ∈ I := by
      intro C _ P _ I x hI
      obtain ⟨⟨a, s⟩, hs⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl
        (Localization.AtPrime P)).mp hI
      rw [← map_mul] at hs
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists P.primeCompl (Localization.AtPrime P)).mp hs
      refine ⟨c * s, fun h => ?_, ?_⟩
      · rcases (inferInstance : P.IsPrime).mem_or_mem h with h' | h'
        · exact c.2 h'
        · exact s.2 h'
      · have e : (c : C) * (s : C) * x = c * (x * s) := by ring
        rw [e, hc]
        exact I.mul_mem_left _ a.2
    let ρ : Localization.AtPrime 𝔔 →+* Localization.AtPrime 𝔮' :=
      Localization.localRingHom 𝔔 𝔮' π.toRingHom rfl
    have hρ : ∀ x : B, ρ (algebraMap B _ x) = algebraMap A' _ (π x) := fun x =>
      Localization.localRingHom_to_map 𝔔 𝔮' π.toRingHom rfl x
    let ρₐ : Localization.AtPrime 𝔔 →ₐ[R] Localization.AtPrime 𝔮' :=
      { ρ with
        commutes' := fun r => by
          show ρ (algebraMap R _ r) = _
          rw [IsScalarTower.algebraMap_apply R B (Localization.AtPrime 𝔔), hρ, AlgHom.commutes,
            ← IsScalarTower.algebraMap_apply] }
    have hle : Ideal.map (algebraMap R (Localization.AtPrime 𝔔)) (IsLocalRing.maximalIdeal R) ≤
        Ideal.comap ρₐ (Ideal.map (algebraMap R (Localization.AtPrime 𝔮'))
          (IsLocalRing.maximalIdeal R)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
      exact Ideal.mem_map_of_mem _ hr
    let Ψ := Ideal.quotientMapₐ (Ideal.map (algebraMap R (Localization.AtPrime 𝔮'))
      (IsLocalRing.maximalIdeal R)) ρₐ hle
    have hΨ : ∀ y, Ψ (Ideal.Quotient.mk _ y) = Ideal.Quotient.mk _ (ρ y) := fun y => rfl
    have hIRB : Ideal.map (algebraMap R (Localization.AtPrime 𝔔)) (IsLocalRing.maximalIdeal R) =
        Ideal.map (algebraMap B (Localization.AtPrime 𝔔))
          (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    have hIRA : Ideal.map (algebraMap R (Localization.AtPrime 𝔮')) (IsLocalRing.maximalIdeal R) =
        Ideal.map (algebraMap A' (Localization.AtPrime 𝔮'))
          (Ideal.map (algebraMap R A') (IsLocalRing.maximalIdeal R)) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    have hmA : Ideal.map (algebraMap R A') (IsLocalRing.maximalIdeal R) =
        Ideal.map π (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) := by
      show _ = Ideal.map π.toRingHom (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R))
      rw [Ideal.map_map]
      congr 1
      ext r
      simp
    refine ⟨Ψ, ?_, fun x => by rw [hΨ, hρ], ?_, ?_⟩
    · intro y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮'.primeCompl y
      obtain ⟨a', rfl⟩ := hπ a
      obtain ⟨s', hs'⟩ := hπ s
      have hs'm : s' ∈ 𝔔.primeCompl := by
        show s' ∉ Ideal.comap π 𝔮'
        rw [Ideal.mem_comap, hs']; exact s.2
      refine ⟨Ideal.Quotient.mk _ (IsLocalization.mk' (Localization.AtPrime 𝔔) a' ⟨s', hs'm⟩), ?_⟩
      rw [hΨ]
      congr 1
      dsimp only
      rw [IsLocalization.eq_mk'_iff_mul_eq, ← hs', ← hρ, ← hρ, ← map_mul,
        IsLocalization.mk'_spec_mk]
    · have hcomp : (Ψ : wcNcxFib R B 𝔔 →+* wcNcxFib R A' 𝔮').comp
          (Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization.AtPrime 𝔔))
            (IsLocalRing.maximalIdeal R))) =
          (Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization.AtPrime 𝔮'))
            (IsLocalRing.maximalIdeal R))).comp ρ := RingHom.ext fun y => rfl
      have hρc : ρ.comp (algebraMap B (Localization.AtPrime 𝔔)) =
          (algebraMap A' (Localization.AtPrime 𝔮')).comp π.toRingHom :=
        RingHom.ext fun x => hρ x
      have hmaxB : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔) =
          Ideal.map (algebraMap B (Localization.AtPrime 𝔔)) 𝔔 :=
        (Localization.AtPrime.map_eq_maximalIdeal).symm
      have hmaxA : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮') =
          Ideal.map (algebraMap A' (Localization.AtPrime 𝔮')) 𝔮' :=
        (Localization.AtPrime.map_eq_maximalIdeal).symm
      have hρmax : Ideal.map ρ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔)) =
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮') := by
        rw [hmaxB, hmaxA, Ideal.map_map, hρc, ← Ideal.map_map]
        congr 1
        exact Ideal.map_comap_of_surjective π.toRingHom hπ 𝔮'
      have step1 : Ideal.map (Ψ : wcNcxFib R B 𝔔 →+* wcNcxFib R A' 𝔮')
          (wcNcxFibMax R B 𝔔) =
          Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization.AtPrime 𝔮'))
            (IsLocalRing.maximalIdeal R)))
            (Ideal.map ρ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔))) := by
        show Ideal.map (Ψ : wcNcxFib R B 𝔔 →+* wcNcxFib R A' 𝔮')
          (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization.AtPrime 𝔔))
            (IsLocalRing.maximalIdeal R))) (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔔))) = _
        rw [Ideal.map_map, hcomp, ← Ideal.map_map]
      rw [hρmax] at step1
      exact step1
    · intro z hz
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨⟨x, w0⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔔.primeCompl z
      rw [hΨ, Ideal.Quotient.eq_zero_iff_mem] at hz
      have h1 : algebraMap A' (Localization.AtPrime 𝔮') (π x) ∈
          Ideal.map (algebraMap A' (Localization.AtPrime 𝔮'))
            (Ideal.map (algebraMap R A') (IsLocalRing.maximalIdeal R)) := by
        rw [← hIRA]
        have e : algebraMap A' (Localization.AtPrime 𝔮') (π x) =
            ρ (IsLocalization.mk' (Localization.AtPrime 𝔔) x w0) *
              algebraMap A' (Localization.AtPrime 𝔮') (π w0) := by
          rw [← hρ, ← hρ, ← map_mul, IsLocalization.mk'_spec]
        rw [e]
        exact Ideal.mul_mem_right _ _ hz
      obtain ⟨s, hs, hsx⟩ := unwind A' 𝔮' _ (π x) h1
      rw [hmA] at hsx
      obtain ⟨m, hm, hmx⟩ := (Ideal.mem_map_iff_of_surjective π hπ).mp hsx
      obtain ⟨s', rfl⟩ := hπ s
      refine ⟨s' * x - m, ?_, s' * w0, ?_, ?_⟩
      · rw [RingHom.mem_ker, map_sub, map_mul, hmx, sub_self]
      · intro h
        have h2 : π s' * π (w0 : B) ∈ 𝔮' := by
          rw [← map_mul]; exact h
        rcases (inferInstance : 𝔮'.IsPrime).mem_or_mem h2 with h' | h'
        · exact hs h'
        · exact w0.2 h'
      · rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, hIRB]
        have e : IsLocalization.mk' (Localization.AtPrime 𝔔) x w0 *
            algebraMap B (Localization.AtPrime 𝔔) (s' * w0) -
            algebraMap B (Localization.AtPrime 𝔔) (s' * x - m) =
            algebraMap B (Localization.AtPrime 𝔔) m := by
          rw [map_mul, map_sub, map_mul, mul_comm (algebraMap B _ s'), ← mul_assoc,
            IsLocalization.mk'_spec]
          ring
        rw [e]
        exact Ideal.mem_map_of_mem _ hm

  have fibLift : ∀ x : B,
      (∀ m : ℕ, Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
          (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮'))))
          (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')) x) ∈
          wcNcxFibMax R B (Ideal.comap π 𝔮') ^ m →
        ∃ t ∉ Ideal.comap π 𝔮', t * x ∈ Ideal.comap π 𝔮' ^ m ⊔
          Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) ∧
      (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
          (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮'))))
          (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')) x) = 0 →
        ∃ t ∉ Ideal.comap π 𝔮', t * x ∈ Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) := by
    intro x
    have hIR : Ideal.map (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮')))
        (IsLocalRing.maximalIdeal R) =
        Ideal.map (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')))
          (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    have unwind : ∀ I : Ideal B, algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')) x ∈
        Ideal.map (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮'))) I →
        ∃ t ∉ Ideal.comap π 𝔮', t * x ∈ I := by
      intro I hI
      obtain ⟨⟨a, s⟩, hs⟩ := (IsLocalization.mem_map_algebraMap_iff
        (Ideal.comap π 𝔮').primeCompl (Localization.AtPrime (Ideal.comap π 𝔮'))).mp hI
      rw [← map_mul] at hs
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists (Ideal.comap π 𝔮').primeCompl
        (Localization.AtPrime (Ideal.comap π 𝔮'))).mp hs
      refine ⟨c * s, fun h => ?_, ?_⟩
      · rcases (inferInstance : (Ideal.comap π 𝔮').IsPrime).mem_or_mem h with h' | h'
        · exact c.2 h'
        · exact s.2 h'
      · have e : (c : B) * (s : B) * x = c * (x * s) := by ring
        rw [e, hc]
        exact I.mul_mem_left _ a.2
    refine ⟨fun m hm => unwind _ ?_, fun h0 => unwind _ ?_⟩
    · rw [← Ideal.map_pow, ← Ideal.mem_comap,
        Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        ← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow, hIR,
        ← Ideal.map_sup] at hm
      exact hm
    · rw [Ideal.Quotient.eq_zero_iff_mem, hIR] at h0
      exact h0
  haveI := hnoeth
  unfold wcNcxLevels at hlev

  have hP1 : ∀ r : R, algebraMap R B r ∈ Ideal.comap π 𝔮' ↔ r ∈ IsLocalRing.maximalIdeal R := by
    intro r
    rw [Ideal.mem_comap, AlgHom.commutes, ← Ideal.mem_comap, h𝔮']

  obtain ⟨ιD, hιD⟩ : ∃ f : B →ₐ[R] wcNcxFib R B (Ideal.comap π 𝔮'),
      ∀ x, f x = Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization.AtPrime
        (Ideal.comap π 𝔮'))) (IsLocalRing.maximalIdeal R))
        (algebraMap B (Localization.AtPrime (Ideal.comap π 𝔮')) x) :=
    ⟨(Ideal.Quotient.mkₐ R _).comp (IsScalarTower.toAlgHom R B _), fun x => rfl⟩

  have hP2 : ∀ x ∈ Ideal.comap π 𝔮', ιD x ∈ wcNcxFibMax R B (Ideal.comap π 𝔮') := by
    intro x hx
    rw [hιD]
    exact Ideal.mem_map_of_mem _ ((IsLocalization.AtPrime.to_map_mem_maximal_iff
      (Localization.AtPrime (Ideal.comap π 𝔮')) (Ideal.comap π 𝔮') x).mpr hx)

  have hIR : Ideal.map (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮')))
      (IsLocalRing.maximalIdeal R) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap π 𝔮')) := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap,
      IsScalarTower.algebraMap_apply R B (Localization.AtPrime (Ideal.comap π 𝔮')) r]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ (Ideal.comap π 𝔮') _).mpr
      ((hP1 r).mpr hr)
  have h𝔫ne : wcNcxFibMax R B (Ideal.comap π 𝔮') ≠ ⊤ := by
    intro h
    have h1 : (1 : wcNcxFib R B (Ideal.comap π 𝔮')) ∈ wcNcxFibMax R B (Ideal.comap π 𝔮') := by
      rw [h]; exact Submodule.mem_top
    obtain ⟨m, hm, hm1⟩ := (Ideal.mem_map_iff_of_surjective
      (Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮')))
        (IsLocalRing.maximalIdeal R))) Ideal.Quotient.mk_surjective).mp h1
    have h2 : 1 - m ∈ Ideal.map (algebraMap R (Localization.AtPrime (Ideal.comap π 𝔮')))
        (IsLocalRing.maximalIdeal R) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hm1, sub_self]
    have h3 := Ideal.add_mem _ (hIR h2) hm
    rw [sub_add_cancel] at h3
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
  haveI : Nontrivial (wcNcxFib R B (Ideal.comap π 𝔮')) :=
    Ideal.Quotient.nontrivial_iff.mpr (fun h => (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      (top_le_iff.mp (by rw [← h]; exact hIR)))
  haveI : IsLocalRing (wcNcxFib R B (Ideal.comap π 𝔮')) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

  obtain ⟨Ψ, hΨs, hΨf, hΨm, hΨk⟩ := fibMap

  have levelMaps : ∀ (n : ℕ),
      Function.Surjective (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n) →
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
        Ideal (MvPolynomial (Fin 2) R)) ^ n ≤
          RingHom.ker (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n) →
      ((wcNcxFib R A' 𝔮' ⧸ wcNcxFibMax R A' 𝔮' ^ n) ≃ₐ[R]
        (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
            Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n :
              Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))))) →
      ∃ θ : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) →ₐ[IsLocalRing.ResidueField R]
          (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
            (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} ⊔
              Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ n :
                Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)))),
        Function.Surjective θ ∧
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))) ^ n ≤ RingHom.ker θ ∧
        ∀ (Q : MvPolynomial (Fin 2) R) (z : wcNcxFib R B (Ideal.comap π 𝔮')),
          wcNcxcPhi R B (Ideal.comap π 𝔮') u v n Q = Ideal.Quotient.mk _ z →
          (θ (MvPolynomial.map (IsLocalRing.residue R) Q) = 0 ↔
            Ψ z ∈ wcNcxFibMax R A' 𝔮' ^ n) := by
    intro n hΦs hΦk e
    have hle : wcNcxFibMax R B (Ideal.comap π 𝔮') ^ n ≤
        Ideal.comap Ψ (wcNcxFibMax R A' 𝔮' ^ n) := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow, hΨm]
    let Ψn := Ideal.quotientMapₐ (wcNcxFibMax R A' 𝔮' ^ n) Ψ hle
    have hΨn : ∀ z, Ψn (Ideal.Quotient.mk _ z) = Ideal.Quotient.mk _ (Ψ z) := fun z => rfl
    let θR := (e.toAlgHom.comp Ψn).comp (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n)
    let θ : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) →ₐ[IsLocalRing.ResidueField R] _ :=
      MvPolynomial.aeval (fun i => θR (MvPolynomial.X i))
    have hcompat : ∀ Q : MvPolynomial (Fin 2) R,
        θ (MvPolynomial.map (IsLocalRing.residue R) Q) = θR Q := by
      intro Q
      have h : (θ.toRingHom.comp (MvPolynomial.map (IsLocalRing.residue R))) = θR.toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [RingHom.comp_apply, MvPolynomial.map_C, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe]
          show MvPolynomial.aeval _ (MvPolynomial.C _) = θR (MvPolynomial.C r)
          rw [MvPolynomial.aeval_C, ← MvPolynomial.algebraMap_eq, AlgHom.commutes,
            IsScalarTower.algebraMap_apply R (IsLocalRing.ResidueField R)]
          rfl
        · intro i
          simp [θ]
      exact congrArg (fun f => f Q) h
    have hΨns : Function.Surjective Ψn := by
      intro y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨x, rfl⟩ := hΨs y
      exact ⟨Ideal.Quotient.mk _ x, hΨn x⟩
    have hθRs : Function.Surjective θR :=
      (e.surjective.comp hΨns).comp hΦs
    refine ⟨θ, ?_, ?_, ?_⟩
    · intro y
      obtain ⟨Q, hQ⟩ := hθRs y
      exact ⟨_, (hcompat Q).trans hQ⟩
    · have hMmap : Ideal.map (MvPolynomial.map (IsLocalRing.residue R))
          (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) R)) =
            Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
        rw [Ideal.map_span, Set.image_pair, MvPolynomial.map_X, MvPolynomial.map_X]
      have hpow : (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))) ^ n =
          Ideal.map (MvPolynomial.map (IsLocalRing.residue R))
            ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
              Ideal (MvPolynomial (Fin 2) R)) ^ n) := by
        rw [Ideal.map_pow, hMmap]
      intro y hy
      rw [hpow] at hy
      revert y
      rw [← SetLike.le_def, Ideal.map_le_iff_le_comap]
      intro Q hQ
      rw [Ideal.mem_comap, RingHom.mem_ker, hcompat]
      show e (Ψn (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n Q)) = 0
      rw [RingHom.mem_ker.mp (hΦk hQ), map_zero, map_zero]
    · intro Q z hQz
      rw [hcompat]
      show e (Ψn (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n Q)) = 0 ↔ _
      rw [hQz, hΨn, map_eq_zero_iff _ e.injective, Ideal.Quotient.eq_zero_iff_mem]
  have hθ := fun n : ℕ => levelMaps n (hΦ n).1 (by rw [(hΦ n).2]; exact le_sup_right)
    (hlev n).some
  choose θ hθs hθk hθi using hθ

  have hPhi : ∀ (n : ℕ) (P : MvPolynomial (Fin 2) R),
      wcNcxcPhi R B (Ideal.comap π 𝔮') u v n P =
        Ideal.Quotient.mk (wcNcxFibMax R B (Ideal.comap π 𝔮') ^ n)
          (ιD (MvPolynomial.aeval ![u, v] P)) := by
    intro n P
    have h : wcNcxcPhi R B (Ideal.comap π 𝔮') u v n =
        (Ideal.Quotient.mkₐ R (wcNcxFibMax R B (Ideal.comap π 𝔮') ^ n)).comp
          (ιD.comp (MvPolynomial.aeval ![u, v])) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [wcNcxcPhi, MvPolynomial.aeval_X, AlgHom.comp_apply, hιD,
        Ideal.Quotient.mkₐ_eq_mk]
    rw [h]
    rfl

  have hMmap : Ideal.map (MvPolynomial.map (IsLocalRing.residue R))
      (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) R)) =
        Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} := by
    rw [Ideal.map_span, Set.image_pair, MvPolynomial.map_X, MvPolynomial.map_X]
  have hdesc : ∀ (m : ℕ) (F : MvPolynomial (Fin 2) R),
      F ∈ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
        (IsLocalRing.maximalIdeal R) ⊔ Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ m →
      MvPolynomial.map (IsLocalRing.residue R) F ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))) ^ m := by
    intro m F hF
    have h1 := Ideal.mem_map_of_mem (MvPolynomial.map (IsLocalRing.residue R)) hF
    rw [Ideal.map_sup, Ideal.map_pow, hMmap, Ideal.map_map] at h1
    have h2 : Ideal.map ((MvPolynomial.map (IsLocalRing.residue R)).comp
        (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)) (IsLocalRing.maximalIdeal R) = ⊥ := by
      refine le_bot_iff.mp (Ideal.map_le_iff_le_comap.mpr fun r hr => ?_)
      rw [Ideal.mem_comap, RingHom.comp_apply, MvPolynomial.map_C,
        (IsLocalRing.residue_eq_zero_iff r).mpr hr, map_zero]
      exact Ideal.zero_mem _
    rwa [h2, bot_sup_eq] at h1
  have hlift : ∀ (m : ℕ) (F : MvPolynomial (Fin 2) R),
      MvPolynomial.map (IsLocalRing.residue R) F ∈
        (Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))) ^ m →
      F ∈ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R)
        (IsLocalRing.maximalIdeal R) ⊔ Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} ^ m := by
    intro m F hF
    have h1 : F ∈ Ideal.comap (MvPolynomial.map (IsLocalRing.residue R))
        (Ideal.map (MvPolynomial.map (IsLocalRing.residue R))
          ((Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1} :
            Ideal (MvPolynomial (Fin 2) R)) ^ m)) := by
      rw [Ideal.mem_comap, Ideal.map_pow, hMmap]; exact hF
    rw [Ideal.comap_map_of_surjective' _
        (MvPolynomial.map_surjective _ IsLocalRing.residue_surjective),
      MvPolynomial.ker_map, IsLocalRing.ker_residue, sup_comm] at h1
    exact h1

  obtain ⟨abar, bbar, cbar, dbar, hdet, hline⟩ :=
    wcpa_dj_ncxc_fp_level3_lines (IsLocalRing.ResidueField R) (θ 3) (hθs 3) (hθk 3)
  have hl1 : (MvPolynomial.C abar * MvPolynomial.X 0 + MvPolynomial.C bbar * MvPolynomial.X 1 :
      MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) ≠ 0 := by
    intro h
    have e1 := congrArg (MvPolynomial.eval (![1, 0] : Fin 2 → IsLocalRing.ResidueField R)) h
    have e2 := congrArg (MvPolynomial.eval (![0, 1] : Fin 2 → IsLocalRing.ResidueField R)) h
    simp at e1 e2
    apply hdet; rw [e1, e2]; ring
  have hl2 : (MvPolynomial.C cbar * MvPolynomial.X 0 + MvPolynomial.C dbar * MvPolynomial.X 1 :
      MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) ≠ 0 := by
    intro h
    have e1 := congrArg (MvPolynomial.eval (![1, 0] : Fin 2 → IsLocalRing.ResidueField R)) h
    have e2 := congrArg (MvPolynomial.eval (![0, 1] : Fin 2 → IsLocalRing.ResidueField R)) h
    simp at e1 e2
    apply hdet; rw [e1, e2]; ring
  have hhom : ((MvPolynomial.C abar * MvPolynomial.X 0 + MvPolynomial.C bbar * MvPolynomial.X 1) *
      (MvPolynomial.C cbar * MvPolynomial.X 0 + MvPolynomial.C dbar * MvPolynomial.X 1) :
        MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)).IsHomogeneous (1 + 1) :=
    ((MvPolynomial.isHomogeneous_C_mul_X _ 0).add (MvPolynomial.isHomogeneous_C_mul_X _ 1)).mul
      ((MvPolynomial.isHomogeneous_C_mul_X _ 0).add (MvPolynomial.isHomogeneous_C_mul_X _ 1))
  obtain ⟨a', rfl⟩ := IsLocalRing.residue_surjective abar
  obtain ⟨b', rfl⟩ := IsLocalRing.residue_surjective bbar
  obtain ⟨c', rfl⟩ := IsLocalRing.residue_surjective cbar
  obtain ⟨d', rfl⟩ := IsLocalRing.residue_surjective dbar
  obtain ⟨LP, hLP⟩ : ∃ P : MvPolynomial (Fin 2) R, P =
      (MvPolynomial.C a' * MvPolynomial.X 0 + MvPolynomial.C b' * MvPolynomial.X 1) *
        (MvPolynomial.C c' * MvPolynomial.X 0 + MvPolynomial.C d' * MvPolynomial.X 1) :=
    ⟨_, rfl⟩
  obtain ⟨lam, hlam⟩ : ∃ x : B, x = (algebraMap R B a' * u + algebraMap R B b' * v) *
      (algebraMap R B c' * u + algebraMap R B d' * v) := ⟨_, rfl⟩
  have hLPev : MvPolynomial.aeval ![u, v] LP = lam := by
    rw [hLP, hlam]; simp
  have hLPmap : MvPolynomial.map (IsLocalRing.residue R) LP =
      (MvPolynomial.C (IsLocalRing.residue R a') * MvPolynomial.X 0 +
        MvPolynomial.C (IsLocalRing.residue R b') * MvPolynomial.X 1) *
      (MvPolynomial.C (IsLocalRing.residue R c') * MvPolynomial.X 0 +
        MvPolynomial.C (IsLocalRing.residue R d') * MvPolynomial.X 1) := by
    rw [hLP]; simp

  have hlam3 : Ψ (ιD lam) ∈ wcNcxFibMax R A' 𝔮' ^ 3 := by
    refine (hθi 3 LP (ιD lam) ?_).mp ?_
    · rw [hPhi, hLPev]
    · rw [hLPmap]; exact hline
  rw [← hΨm, ← Ideal.map_pow] at hlam3

  obtain ⟨e, he, hee⟩ := (Ideal.mem_map_iff_of_surjective Ψ hΨs).mp hlam3
  obtain ⟨j, hj, w, hw, hjw⟩ := hΨk (ιD lam - e) (by rw [map_sub, hee, sub_self])
  rw [← hιD, ← hιD] at hjw

  obtain ⟨ω, hω⟩ := hres (Ideal.Quotient.mk _ w)
  rw [RingHom.comp_apply] at hω
  have hω' : algebraMap R B ω - w ∈ Ideal.comap π 𝔮' := Ideal.Quotient.eq.mp hω
  have hωu : IsUnit ω := by
    by_contra hn
    have h1 : algebraMap R B ω ∈ Ideal.comap π 𝔮' :=
      (hP1 ω).mpr ((IsLocalRing.mem_maximalIdeal ω).mpr (mem_nonunits_iff.mpr hn))
    apply hw
    have h2 := Ideal.sub_mem _ h1 hω'
    rwa [sub_sub_cancel] at h2

  have hlamQ : ∀ x y : R, algebraMap R B x * u + algebraMap R B y * v ∈ Ideal.comap π 𝔮' :=
    fun x y => Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)
  have hlam2 : ιD lam ∈ wcNcxFibMax R B (Ideal.comap π 𝔮') ^ 2 := by
    rw [hlam, map_mul, pow_two]
    exact Ideal.mul_mem_mul (hP2 _ (hlamQ _ _)) (hP2 _ (hlamQ _ _))
  have h3eq : wcNcxFibMax R B (Ideal.comap π 𝔮') ^ 3 =
      wcNcxFibMax R B (Ideal.comap π 𝔮') ^ 2 * wcNcxFibMax R B (Ideal.comap π 𝔮') :=
    pow_succ _ 2
  have hcong : ιD (j - algebraMap R B ω * lam) ∈ wcNcxFibMax R B (Ideal.comap π 𝔮') ^ 3 := by
    have e1 : ιD (j - algebraMap R B ω * lam) =
        -(ιD lam * ιD (algebraMap R B ω - w)) - e * ιD w := by
      simp only [map_sub, map_mul]
      rw [← hjw]; ring
    rw [e1, h3eq]
    rw [h3eq] at he
    exact Ideal.sub_mem _ (neg_mem (Ideal.mul_mem_mul hlam2 (hP2 _ hω')))
      (Ideal.mul_mem_right _ _ he)

  have hjQ : j ∈ Ideal.comap π 𝔮' := by
    rw [Ideal.mem_comap, RingHom.mem_ker.mp hj]; exact Ideal.zero_mem _
  have hΨι0 : ∀ y ∈ RingHom.ker π, Ψ (ιD y) = 0 := by
    intro y hy
    rw [hιD, hΨf, RingHom.mem_ker.mp hy, map_zero, map_zero]

  obtain ⟨G2, hG2⟩ : ∃ G : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R),
      G = MvPolynomial.C (IsLocalRing.residue R ω) *
        MvPolynomial.map (IsLocalRing.residue R) LP := ⟨_, rfl⟩
  have hG2h : G2.IsHomogeneous 2 := by
    rw [hG2, hLPmap]
    exact (MvPolynomial.isHomogeneous_C (Fin 2) _).mul hhom
  have hG2ne : G2 ≠ 0 := by
    rw [hG2, hLPmap]
    refine mul_ne_zero ?_ (mul_ne_zero hl1 hl2)
    rw [Ne, MvPolynomial.C_eq_zero]
    exact (hωu.map (IsLocalRing.residue R)).ne_zero

  have hstep : ∀ n : ℕ, 3 ≤ n → ∀ z, Ψ z = 0 →
      z ∈ Ideal.span {ιD j} ⊔ wcNcxFibMax R B (Ideal.comap π 𝔮') ^ n := by
    intro n hn z hz
    obtain ⟨P, hP⟩ := (hΦ n).1 (Ideal.Quotient.mk _ (ιD j))
    have hθP : θ n (MvPolynomial.map (IsLocalRing.residue R) P) = 0 :=
      (hθi n P (ιD j) hP).mpr (by rw [hΨι0 j hj]; exact Ideal.zero_mem _)
    have hP3 : P - MvPolynomial.C ω * LP ∈
        RingHom.ker (wcNcxcPhi R B (Ideal.comap π 𝔮') u v 3) := by
      rw [RingHom.mem_ker, hPhi, Ideal.Quotient.eq_zero_iff_mem]
      rw [hPhi, Ideal.Quotient.eq] at hP
      have h1 : ιD (MvPolynomial.aeval ![u, v] (P - MvPolynomial.C ω * LP)) =
          (ιD (MvPolynomial.aeval ![u, v] P) - ιD j) + ιD (j - algebraMap R B ω * lam) := by
        simp only [map_sub, map_mul, MvPolynomial.aeval_C, hLPev]
        ring
      rw [h1]
      exact Ideal.add_mem _ (Ideal.pow_le_pow_right hn hP) hcong
    rw [(hΦ 3).2] at hP3
    have hG3 := hdesc 3 _ hP3
    rw [map_sub, map_mul, MvPolynomial.map_C, ← hG2] at hG3
    have e3 : G2 + (MvPolynomial.map (IsLocalRing.residue R) P - G2) =
        MvPolynomial.map (IsLocalRing.residue R) P := by ring
    have hker := wcpa_dj_ncxc_fp_trunc_kernel (IsLocalRing.ResidueField R) n (θ n) (hθs n)
      G2 (MvPolynomial.map (IsLocalRing.residue R) P - G2) hG2h hG2ne hG3 (by
        rw [e3]
        exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr (RingHom.mem_ker.mpr hθP))
          (hθk n))
    obtain ⟨Qz, hQz⟩ := (hΦ n).1 (Ideal.Quotient.mk _ z)
    have hθQ : θ n (MvPolynomial.map (IsLocalRing.residue R) Qz) = 0 :=
      (hθi n Qz z hQz).mpr (by rw [hz]; exact Ideal.zero_mem _)
    have hmem : MvPolynomial.map (IsLocalRing.residue R) Qz ∈ RingHom.ker (θ n) :=
      RingHom.mem_ker.mpr hθQ
    rw [hker] at hmem
    obtain ⟨y, hy, e', he', hye⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨H', rfl⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨H, rfl⟩ := MvPolynomial.map_surjective _ IsLocalRing.residue_surjective H'
    have hQH : Qz - H * P ∈ RingHom.ker (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n) := by
      rw [(hΦ n).2]
      apply hlift
      have h4 : MvPolynomial.map (IsLocalRing.residue R) (Qz - H * P) = e' := by
        rw [map_sub, map_mul, ← hye, e3]; ring
      rw [h4]; exact he'
    rw [RingHom.mem_ker, map_sub, map_mul, hQz, hP] at hQH
    obtain ⟨h, hh⟩ := Ideal.Quotient.mk_surjective
      (wcNcxcPhi R B (Ideal.comap π 𝔮') u v n H)
    rw [← hh, ← map_mul, ← map_sub, Ideal.Quotient.eq_zero_iff_mem] at hQH
    have h5 : z = h * ιD j + (z - h * ιD j) := by ring
    rw [h5]
    exact Submodule.add_mem_sup (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)) hQH
  have hall : ∀ n : ℕ, ∀ z, Ψ z = 0 →
      z ∈ Ideal.span {ιD j} ⊔ wcNcxFibMax R B (Ideal.comap π 𝔮') ^ n := by
    intro n z hz
    have hle : Ideal.span {ιD j} ⊔ wcNcxFibMax R B (Ideal.comap π 𝔮') ^ (max n 3) ≤
        Ideal.span {ιD j} ⊔ wcNcxFibMax R B (Ideal.comap π 𝔮') ^ n :=
      sup_le_sup_left (Ideal.pow_le_pow_right (le_max_left n 3)) _
    exact hle (hstep (max n 3) (le_max_right n 3) z hz)

  have krullGen : ∀ (S : Type u) [CommRing S] [IsNoetherianRing S] [IsLocalRing S]
      (N : Ideal S) (g z : S), N ≠ ⊤ → g ∈ N →
      (∀ n : ℕ, z ∈ Ideal.span {g} ⊔ N ^ n) → z ∈ Ideal.span {g} := by
    intro S _ _ _ N g z hN hg hz
    have hgN : Ideal.span {g} ≤ N := (Ideal.span_singleton_le_iff_mem _).mpr hg
    haveI : Nontrivial (S ⧸ Ideal.span {g}) :=
      Ideal.Quotient.nontrivial_iff.mpr (fun h => hN (top_le_iff.mp (by rw [← h]; exact hgN)))
    haveI : IsLocalRing (S ⧸ Ideal.span {g}) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    have hI' : Ideal.map (Ideal.Quotient.mk (Ideal.span {g})) N ≠ ⊤ := by
      intro h
      apply hN
      have h2 := congrArg (Ideal.comap (Ideal.Quotient.mk (Ideal.span {g}))) h
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        Ideal.comap_top, sup_eq_left.mpr hgN] at h2
      exact h2
    have hbot := Ideal.iInf_pow_eq_bot_of_isLocalRing
      (Ideal.map (Ideal.Quotient.mk (Ideal.span {g})) N) hI'
    have hmz : Ideal.Quotient.mk (Ideal.span {g}) z ∈ (⊥ : Ideal (S ⧸ Ideal.span {g})) := by
      rw [← hbot, Submodule.mem_iInf]
      intro n
      have h1 := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span {g})) (hz n)
      rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_pow] at h1
      exact h1
    rw [Ideal.mem_bot] at hmz
    exact Ideal.Quotient.eq_zero_iff_mem.mp hmz
  have hkrull : ∀ z : wcNcxFib R B (Ideal.comap π 𝔮'),
      (∀ n : ℕ, z ∈ Ideal.span {ιD j} ⊔ wcNcxFibMax R B (Ideal.comap π 𝔮') ^ n) →
      z ∈ Ideal.span {ιD j} := fun z hz =>
    krullGen _ (wcNcxFibMax R B (Ideal.comap π 𝔮')) (ιD j) z h𝔫ne (hP2 j hjQ) hz

  refine ⟨j, hj, ω * a', ω * b', c', d', ?_, ?_, ?_⟩
  ·
    have hu' : IsUnit (a' * d' - b' * c') := by
      by_contra hn
      apply hdet
      rw [← map_mul, ← map_mul, ← map_sub]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hn))
    have h6 : ω * a' * d' - ω * b' * c' = ω * (a' * d' - b' * c') := by ring
    rw [h6]; exact hωu.mul hu'
  ·
    obtain ⟨t, ht, htm⟩ := (fibLift (j - algebraMap R B ω * lam)).1 3
      (by rw [← hιD]; exact hcong)
    refine ⟨t, ht, ?_⟩
    have e2 : (algebraMap R B (ω * a') * u + algebraMap R B (ω * b') * v) *
        (algebraMap R B c' * u + algebraMap R B d' * v) = algebraMap R B ω * lam := by
      rw [hlam, map_mul, map_mul]; ring
    rw [e2]; exact htm
  ·
    intro y hy
    have hy1 := hkrull (ιD y) (fun n => hall n _ (hΨι0 y hy))
    obtain ⟨hD, hhD⟩ := Ideal.mem_span_singleton'.mp hy1
    obtain ⟨h₁, rfl⟩ := Ideal.Quotient.mk_surjective hD
    obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj (Ideal.comap π 𝔮').primeCompl h₁
    dsimp only at hbs
    have hs : (s : B) ∉ Ideal.comap π 𝔮' := s.2
    have hsb : ιD s * Ideal.Quotient.mk _ h₁ = ιD b := by
      rw [hιD, hιD, ← map_mul, mul_comm, hbs]
    have hz : ιD (s * y - b * j) = 0 := by
      rw [map_sub, map_mul, map_mul, ← hhD, ← hsb]; ring
    obtain ⟨t', ht', htm'⟩ := (fibLift (s * y - b * j)).2 (by rw [← hιD]; exact hz)
    refine ⟨t' * b, t' * s, fun hmem => ?_, ?_⟩
    · rcases (inferInstance : (Ideal.comap π 𝔮').IsPrime).mem_or_mem hmem with h | h
      · exact ht' h
      · exact hs h
    · have h7 : t' * s * y - t' * b * j = t' * (s * y - b * j) := by ring
      rw [h7]; exact htm'

theorem wcpa_dj_ncxc_flat_nakayama (R : Type u) [CommRing R] (I : Ideal R)
    (B A' : Type u) [CommRing B] [Algebra R B] [CommRing A'] [Algebra R A'] [Module.Flat R A']
    (π : B →ₐ[R] A') (hπ : Function.Surjective π) (hfg : (RingHom.ker π).FG)
    (𝔔 : Ideal B) [𝔔.IsPrime] (hI : Ideal.map (algebraMap R B) I ≤ 𝔔)
    (g₀ : B) (hg₀ : g₀ ∈ RingHom.ker π)
    (hgen : ∀ y ∈ RingHom.ker π, ∃ b : B, ∃ t ∉ 𝔔,
      t * y - b * g₀ ∈ Ideal.map (algebraMap R B) I) :
    ∃ h ∉ 𝔔, ∀ y ∈ RingHom.ker π, ∃ (n : ℕ) (b : B), h ^ n * y = b * g₀ :=
by
  classical

  have s1 : ∀ x : B, x ∈ Ideal.map (algebraMap R B) I → π x = 0 →
      x ∈ Ideal.map (algebraMap R B) I * RingHom.ker π := by
    intro x hxI hxJ
    have hxI' : x ∈ Submodule.span B (algebraMap R B '' (I : Set R)) := hxI
    rw [Submodule.mem_span_set'] at hxI'
    obtain ⟨n, β, g, hx⟩ := hxI'
    choose μ hμI hμ using fun i => (g i).2
    have hsum : ∑ i, μ i • π (β i) = 0 := by
      rw [← hxJ, ← hx, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_eq_mul, ← hμ i, map_mul, AlgHom.commutes, Algebra.smul_def, mul_comm]
    have htriv : Module.IsTrivialRelation μ (fun i => π (β i)) :=
      Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (by exact hsum)
    obtain ⟨κ, a, z', hβ, ha⟩ := htriv
    simp only at hβ
    choose z hz using fun j => hπ (z' j)
    have heJ : ∀ i, β i - ∑ j, algebraMap R B (a i j) * z j ∈ RingHom.ker π := by
      intro i
      rw [RingHom.mem_ker, map_sub, map_sum, hβ i, sub_eq_zero]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, AlgHom.commutes, hz, Algebra.smul_def]
    have h1 : ∑ j, algebraMap R B (∑ i, μ i * a i j) * z j =
        ∑ i, ∑ j, algebraMap R B (μ i) * (algebraMap R B (a i j) * z j) := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, mul_assoc]
    have key : x = ∑ i, algebraMap R B (μ i) * (β i - ∑ j, algebraMap R B (a i j) * z j) +
        ∑ j, algebraMap R B (∑ i, μ i * a i j) * z j := by
      rw [h1, ← Finset.sum_add_distrib, ← hx]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [mul_sub, Finset.mul_sum, sub_add_cancel, smul_eq_mul, ← hμ i, mul_comm]
    have h0 : ∑ j, algebraMap R B (∑ i, μ i * a i j) * z j = 0 :=
      Finset.sum_eq_zero fun j _ => by rw [ha j, map_zero, zero_mul]
    rw [key, h0, add_zero]
    exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ (hμI i)) (heJ i)

  obtain ⟨m, y, hy⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hyJ : ∀ k, y k ∈ RingHom.ker π := fun k => hy ▸ Submodule.subset_span ⟨k, rfl⟩
  choose b t ht hrel using fun k => hgen (y k) (hyJ k)
  have hrel' : ∀ k, t k * y k - b k * g₀ ∈
      Ideal.map (algebraMap R B) I • Submodule.span B (Set.range y) := by
    intro k
    have h1 := s1 _ (hrel k) (by
      rw [map_sub, map_mul, map_mul, RingHom.mem_ker.mp (hyJ k), RingHom.mem_ker.mp hg₀]
      ring)
    rw [← hy] at h1
    rwa [Ideal.smul_eq_mul]
  have hC : ∀ k, ∃ c : Fin m → B, (∀ l, c l ∈ Ideal.map (algebraMap R B) I) ∧
      ∑ l, c l * y l = t k * y k - b k * g₀ := by
    intro k
    obtain ⟨c, hcL, hc⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp (hrel' k)
    refine ⟨c, hcL, ?_⟩
    rw [← hc, Finsupp.sum_fintype c (fun i (x : B) => x • y i) (fun i => zero_smul _ _)]
    simp only [smul_eq_mul]
  choose C hCL hCsum using hC

  set M : Matrix (Fin m) (Fin m) B := Matrix.diagonal t - Matrix.of C with hM
  have hMy : M.mulVec y = fun k => b k * g₀ := by
    funext k
    rw [hM, Matrix.sub_mulVec, Pi.sub_apply, Matrix.mulVec_diagonal]
    have : (Matrix.of C).mulVec y k = ∑ l, C k l * y l := rfl
    rw [this, hCsum k]
    ring
  have hadj : ∀ k, M.det * y k = (∑ l, M.adjugate k l * b l) * g₀ := by
    intro k
    have h1 : (M.adjugate * M).mulVec y = M.adjugate.mulVec (M.mulVec y) :=
      (Matrix.mulVec_mulVec _ _ _).symm
    rw [Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec, hMy] at h1
    have h2 := congrFun h1 k
    simp only [Pi.smul_apply, smul_eq_mul] at h2
    rw [h2]
    simp only [Matrix.mulVec, dotProduct, Finset.sum_mul]
    exact Finset.sum_congr rfl fun l _ => by ring
  have hdet : M.det ∉ 𝔔 := by
    intro hmem
    have hq : (Ideal.Quotient.mk 𝔔) M.det = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rw [RingHom.map_det] at hq
    have hMq : (Ideal.Quotient.mk 𝔔).mapMatrix M =
        Matrix.diagonal (fun k => Ideal.Quotient.mk 𝔔 (t k)) := by
      ext i j
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, hM, Matrix.sub_apply, Matrix.of_apply,
        Matrix.diagonal_apply, Matrix.diagonal_apply]
      have hc : Ideal.Quotient.mk 𝔔 (C i j) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hI (hCL i j))
      split_ifs <;> simp [map_sub, hc]
    rw [hMq, Matrix.det_diagonal] at hq
    obtain ⟨k, _, hk⟩ := Finset.prod_eq_zero_iff.mp hq
    exact ht k (Ideal.Quotient.eq_zero_iff_mem.mp hk)
  refine ⟨M.det, hdet, fun x hx => ?_⟩
  rw [← hy] at hx
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp hx
  refine ⟨1, ∑ k, c k * ∑ l, M.adjugate k l * b l, ?_⟩
  rw [pow_one, Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [smul_eq_mul, mul_left_comm, hadj k, mul_assoc]

theorem wcpa_dj_ncxc_localize_chart (R : Type u) [CommRing R]
    (A : Type u) [CommRing A] [Algebra R A] (𝔮 : Ideal A) [𝔮.IsPrime] (f : A) (hf : f ∉ 𝔮)
    (B : Type u) [CommRing B] [Algebra R B] (u v g : B)
    (π₀ : B →ₐ[R] Localization.Away f) (hπ₀ : Function.Surjective π₀)
    (het : (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).Etale)
    (hg : g ∈ RingHom.ker π₀) (h : B)
    (hh : h ∉ Ideal.comap π₀ (Ideal.map (algebraMap A (Localization.Away f)) 𝔮))
    (hgen : ∀ y ∈ RingHom.ker π₀, ∃ (n : ℕ) (b : B), h ^ n * y = b * g) :
    ∃ (s : A) (B' : Type u) (_ : CommRing B') (_ : Algebra R B') (ι : B →ₐ[R] B')
      (π : B' →ₐ[R] Localization.Away s),
      s ∉ 𝔮 ∧ Function.Surjective π ∧ RingHom.ker π = Ideal.span {ι g} ∧
      (MvPolynomial.eval₂Hom (algebraMap R B') ![ι u, ι v]).Etale ∧
      (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).comap ι =
        Ideal.comap π₀ (Ideal.map (algebraMap A (Localization.Away f)) 𝔮) :=
by
  classical

  obtain ⟨n, a, hc₀⟩ := IsLocalization.Away.surj f (π₀ h)
  have hFf : IsUnit (algebraMap A (Localization.Away f) f) :=
    IsLocalization.Away.algebraMap_isUnit f
  have ha : a ∉ 𝔮 := by
    intro ha
    apply hh
    rw [Ideal.mem_comap]
    obtain ⟨w, hw⟩ := (hFf.pow n).exists_right_inv
    have e : π₀ h = algebraMap A (Localization.Away f) a * w := by
      rw [← hc₀, mul_assoc, hw, mul_one]
    rw [e]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ha)
  have hs : f * a ∉ 𝔮 := fun hm =>
    ((inferInstance : 𝔮.IsPrime).mem_or_mem hm).elim hf ha

  have hFs : IsUnit (algebraMap A (Localization.Away (f * a)) (f * a)) :=
    IsLocalization.Away.algebraMap_isUnit (f * a)
  have hFs' : IsUnit (algebraMap A (Localization.Away (f * a)) f *
      algebraMap A (Localization.Away (f * a)) a) := by
    rw [← map_mul]; exact hFs
  have hF : IsUnit (algebraMap A (Localization.Away (f * a)) f) := (IsUnit.mul_iff.mp hFs').1
  have hα : IsUnit (algebraMap A (Localization.Away (f * a)) a) := (IsUnit.mul_iff.mp hFs').2

  let κr : Localization.Away f →+* Localization.Away (f * a) :=
    IsLocalization.Away.lift f (g := algebraMap A (Localization.Away (f * a))) hF
  have hκr : ∀ x : A, κr (algebraMap A (Localization.Away f) x) =
      algebraMap A (Localization.Away (f * a)) x := fun x =>
    IsLocalization.Away.lift_eq f hF x
  have hκh : κr (π₀ h) * algebraMap A (Localization.Away (f * a)) f ^ n =
      algebraMap A (Localization.Away (f * a)) a := by
    rw [← hκr, ← hκr, ← map_pow, ← map_mul, hc₀]
  have hκhu : IsUnit (κr (π₀ h)) := by
    have : IsUnit (κr (π₀ h) * algebraMap A (Localization.Away (f * a)) f ^ n) := by
      rw [hκh]; exact hα
    exact (IsUnit.mul_iff.mp this).1

  let πr : Localization.Away h →+* Localization.Away (f * a) :=
    IsLocalization.Away.lift h (g := κr.comp (π₀ : B →+* Localization.Away f)) hκhu
  have hπr : ∀ b : B, πr (algebraMap B (Localization.Away h) b) = κr (π₀ b) := fun b =>
    IsLocalization.Away.lift_eq h hκhu b
  let π : Localization.Away h →ₐ[R] Localization.Away (f * a) :=
    { πr with
      commutes' := fun r => by
        show πr (algebraMap R (Localization.Away h) r) = algebraMap R (Localization.Away (f * a)) r
        rw [IsScalarTower.algebraMap_apply R B (Localization.Away h), hπr, AlgHom.commutes,
          IsScalarTower.algebraMap_apply R A (Localization.Away f), hκr,
          ← IsScalarTower.algebraMap_apply] }
  have hππ : ∀ z, π z = πr z := fun z => rfl
  let ι : B →ₐ[R] Localization.Away h := IsScalarTower.toAlgHom R B (Localization.Away h)
  have hι : ∀ b, ι b = algebraMap B (Localization.Away h) b := fun b =>
    IsScalarTower.toAlgHom_apply R B (Localization.Away h) b
  have hπι : ∀ b, π (ι b) = κr (π₀ b) := fun b => by rw [hππ, hι, hπr]
  have hιh : IsUnit (algebraMap B (Localization.Away h) h) :=
    IsLocalization.Away.algebraMap_isUnit h

  have hsurj : Function.Surjective π := by
    intro z
    obtain ⟨k, x, hx⟩ := IsLocalization.Away.surj (f * a) z
    obtain ⟨bx, hbx⟩ := hπ₀ (algebraMap A (Localization.Away f) x)
    obtain ⟨φ, hφ⟩ := hFf.exists_left_inv
    obtain ⟨bφ, hbφ⟩ := hπ₀ φ
    obtain ⟨ih, hih⟩ := hιh.exists_left_inv
    set y : Localization.Away h := algebraMap B (Localization.Away h) bφ ^ (n + 1) * ih with hy
    have e1 : κr φ * algebraMap A (Localization.Away (f * a)) f = 1 := by
      rw [← hκr, ← map_mul, hφ, map_one]
    have e2 : πr ih * κr (π₀ h) = 1 := by
      rw [← hπr, ← map_mul, hih, map_one]
    have hy1 : π y * algebraMap A (Localization.Away (f * a)) (f * a) = 1 := by
      rw [hππ, hy, map_mul, map_pow, hπr, hbφ, map_mul, ← hκh]
      calc κr φ ^ (n + 1) * πr ih * (algebraMap A (Localization.Away (f * a)) f *
              (κr (π₀ h) * algebraMap A (Localization.Away (f * a)) f ^ n))
          = (κr φ * algebraMap A (Localization.Away (f * a)) f) ^ (n + 1) *
              (πr ih * κr (π₀ h)) := by ring
        _ = 1 := by rw [e1, e2, one_pow, one_mul]
    refine ⟨algebraMap B (Localization.Away h) bx * y ^ k, ?_⟩
    rw [map_mul, map_pow, hππ (algebraMap B _ bx), hπr, hbx, hκr, ← hx]
    calc z * algebraMap A (Localization.Away (f * a)) (f * a) ^ k * π y ^ k
        = z * (π y * algebraMap A (Localization.Away (f * a)) (f * a)) ^ k := by ring
      _ = z := by rw [hy1, one_pow, mul_one]

  have hker : RingHom.ker π = Ideal.span {ι g} := by
    apply le_antisymm
    · intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨m, x, hx⟩ := IsLocalization.Away.surj h z
      have hκx : κr (π₀ x) = 0 := by
        rw [← hπr, ← hx, map_mul, ← hππ, hz, zero_mul]
      obtain ⟨j, y', hy'⟩ := IsLocalization.Away.surj f (π₀ x)
      have hy'0 : algebraMap A (Localization.Away (f * a)) y' = 0 := by
        rw [← hκr, ← hy', map_mul, hκx, zero_mul]
      obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (f * a))
          (Localization.Away (f * a)) y').mp hy'0
      have hk' : (f * a) ^ k * y' = 0 := hk
      have e : (π₀ h) ^ k * π₀ x * (algebraMap A (Localization.Away f) f) ^ (k + n * k + j) =
          algebraMap A (Localization.Away f) ((f * a) ^ k * y') := by
        rw [map_mul, map_pow, map_mul, ← hc₀, ← hy']
        ring
      rw [hk', map_zero] at e
      have e' : (π₀ h) ^ k * π₀ x = 0 := (IsUnit.mul_left_eq_zero (hFf.pow _)).mp e
      have hmem : h ^ k * x ∈ RingHom.ker π₀ := by
        rw [RingHom.mem_ker, map_mul, map_pow]; exact e'
      obtain ⟨n', b, hb⟩ := hgen _ hmem
      have e2 : z * algebraMap B (Localization.Away h) h ^ (n' + k + m) =
          algebraMap B (Localization.Away h) b * algebraMap B (Localization.Away h) g := by
        have := congrArg (algebraMap B (Localization.Away h)) hb
        rw [map_mul, map_mul, map_mul, map_pow, map_pow, ← hx] at this
        rw [← this]
        ring
      obtain ⟨w, hw⟩ := (hιh.pow (n' + k + m)).exists_right_inv
      rw [Ideal.mem_span_singleton']
      refine ⟨algebraMap B (Localization.Away h) b * w, ?_⟩
      rw [hι]
      calc algebraMap B (Localization.Away h) b * w * algebraMap B (Localization.Away h) g
          = (algebraMap B (Localization.Away h) b * algebraMap B (Localization.Away h) g) * w := by
            ring
        _ = z * algebraMap B (Localization.Away h) h ^ (n' + k + m) * w := by rw [e2]
        _ = z := by rw [mul_assoc, hw, mul_one]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show ι g ∈ RingHom.ker π
      rw [RingHom.mem_ker, hπι, RingHom.mem_ker.mp hg, map_zero]

  have hetale : (MvPolynomial.eval₂Hom (algebraMap R (Localization.Away h)) ![ι u, ι v]).Etale := by
    have heq : MvPolynomial.eval₂Hom (algebraMap R (Localization.Away h)) ![ι u, ι v] =
        (algebraMap B (Localization.Away h)).comp (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]) := by
      rw [MvPolynomial.comp_eval₂Hom, ← IsScalarTower.algebraMap_eq]
      congr 1
      funext i
      fin_cases i
      · simp [hι]
      · simp [hι]
    rw [heq]
    exact RingHom.Etale.stableUnderComposition _ _ het
      (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway h))

  have hJ : Ideal.comap κr (Ideal.map (algebraMap A (Localization.Away (f * a))) 𝔮) =
      Ideal.map (algebraMap A (Localization.Away f)) 𝔮 := by
    have hcomp : κr.comp (algebraMap A (Localization.Away f)) =
        algebraMap A (Localization.Away (f * a)) := RingHom.ext hκr
    have h1 : Ideal.comap (algebraMap A (Localization.Away f))
        (Ideal.comap κr (Ideal.map (algebraMap A (Localization.Away (f * a))) 𝔮)) = 𝔮 := by
      rw [Ideal.comap_comap, hcomp]
      exact IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers (f * a)) _
        inferInstance ((Ideal.disjoint_powers_iff_notMem_of_isPrime _).mpr hs)
    have h2 := IsLocalization.map_comap (Submonoid.powers f) (Localization.Away f)
      (Ideal.comap κr (Ideal.map (algebraMap A (Localization.Away (f * a))) 𝔮))
    calc Ideal.comap κr (Ideal.map (algebraMap A (Localization.Away (f * a))) 𝔮)
        = Ideal.map (algebraMap A (Localization.Away f)) (Ideal.comap
            (algebraMap A (Localization.Away f))
            (Ideal.comap κr (Ideal.map (algebraMap A (Localization.Away (f * a))) 𝔮))) := h2.symm
      _ = Ideal.map (algebraMap A (Localization.Away f)) 𝔮 := by rw [h1]
  have hcomap : (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away (f * a))) 𝔮)).comap ι =
      Ideal.comap π₀ (Ideal.map (algebraMap A (Localization.Away f)) 𝔮) := by
    ext x
    simp only [Ideal.mem_comap]
    rw [hπι x]
    exact (congrArg (fun I => π₀ x ∈ I) hJ).to_iff
  exact ⟨f * a, Localization.Away h, inferInstance, inferInstance, ι, π, hs, hsurj, hker,
    hetale, hcomap⟩

theorem wcpa_dj_ncx_cartier_embedding (R : Type u) [CommRing R] [IsLocalRing R]
    (A : Type u) [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] [Module.Flat R A]
    (𝔮 : Ideal A) [𝔮.IsPrime] (h𝔮 : 𝔮.comap (algebraMap R A) = IsLocalRing.maximalIdeal R)
    (hlev : wcNcxLevels R A 𝔮) :
    ∃ (s : A) (B : Type u) (_ : CommRing B) (_ : Algebra R B) (u v g : B)
      (π : B →ₐ[R] Localization.Away s),
      s ∉ 𝔮 ∧ Function.Surjective π ∧ RingHom.ker π = Ideal.span {g} ∧
      (MvPolynomial.eval₂Hom (algebraMap R B) ![u, v]).Etale ∧
      (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).IsPrime ∧
      (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).comap (algebraMap R B) =
        IsLocalRing.maximalIdeal R ∧
      Function.Surjective ((Ideal.Quotient.mk
        (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮))).comp (algebraMap R B)) ∧
      u ∈ Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮) ∧
      v ∈ Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮) ∧
      ∃ a b c d : R, IsUnit (a * d - b * c) ∧
        ∃ t ∉ Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮),
          t * (g - (algebraMap R B a * u + algebraMap R B b * v) *
            (algebraMap R B c * u + algebraMap R B d * v)) ∈
          Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮) ^ 3 ⊔
            Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R) :=
by
  classical
  obtain ⟨hresA, hcot⟩ := wcpa_dj_ncxc_levels_consequences R A 𝔮 h𝔮 hlev

  have hdisj : ∀ s : A, s ∉ 𝔮 → Disjoint (Submonoid.powers s : Set A) 𝔮 := fun s hs =>
    (Ideal.disjoint_powers_iff_notMem_of_isPrime s).mpr hs
  have hmapP : ∀ s : A, s ∉ 𝔮 →
      (Ideal.map (algebraMap A (Localization.Away s)) 𝔮).IsPrime := fun s hs =>
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s) _ 𝔮 inferInstance (hdisj s hs)
  have hmapC : ∀ s : A, s ∉ 𝔮 → Ideal.comap (algebraMap A (Localization.Away s))
      (Ideal.map (algebraMap A (Localization.Away s)) 𝔮) = 𝔮 := fun s hs =>
    IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers s) _ inferInstance (hdisj s hs)
  have hmapR : ∀ s : A, s ∉ 𝔮 → (Ideal.map (algebraMap A (Localization.Away s)) 𝔮).comap
      (algebraMap R (Localization.Away s)) = IsLocalRing.maximalIdeal R := by
    intro s hs
    ext r
    rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R A (Localization.Away s) r,
      ← Ideal.mem_comap, hmapC s hs, ← Ideal.mem_comap, h𝔮]

  have s9 : ∀ (s : A), s ∉ 𝔮 → ∀ (B : Type u) [CommRing B] [Algebra R B]
      (π : B →ₐ[R] Localization.Away s),
      (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).IsPrime ∧
      (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).comap (algebraMap R B) =
        IsLocalRing.maximalIdeal R ∧
      Function.Surjective ((Ideal.Quotient.mk
        (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮))).comp
          (algebraMap R B)) := by
    intro s hs B _ _ π
    haveI hP := hmapP s hs
    have key : ∀ z : Localization.Away s, ∃ r : R, z - algebraMap R (Localization.Away s) r ∈
        Ideal.map (algebraMap A (Localization.Away s)) 𝔮 := by
      intro z
      obtain ⟨x, hz⟩ := IsLocalization.surj (Submonoid.powers s) z
      have hσ : (x.2 : A) ∉ 𝔮 := fun h => Set.disjoint_left.mp (hdisj s hs) x.2.2 h
      obtain ⟨α, hα⟩ := hresA x.1
      obtain ⟨β, hβ⟩ := hresA x.2
      have hα' : algebraMap R A α - x.1 ∈ 𝔮 := Ideal.Quotient.eq.mp hα
      have hβ' : algebraMap R A β - x.2 ∈ 𝔮 := Ideal.Quotient.eq.mp hβ
      have hβu : IsUnit β := by
        by_contra hb
        have hbm : β ∈ IsLocalRing.maximalIdeal R := hb
        have hb𝔮 : algebraMap R A β ∈ 𝔮 := by rw [← Ideal.mem_comap, h𝔮]; exact hbm
        apply hσ
        have h2 := 𝔮.sub_mem hb𝔮 hβ'
        rwa [sub_sub_cancel] at h2
      obtain ⟨β', hβ'u⟩ : ∃ β' : R, β * β' = 1 := ⟨↑hβu.unit⁻¹, hβu.mul_val_inv⟩
      refine ⟨α * β', ?_⟩
      have h1 : x.1 - algebraMap R A (α * β') * x.2 ∈ 𝔮 := by
        have hm : algebraMap R A (α * β') * algebraMap R A β = algebraMap R A α := by
          rw [← map_mul, mul_assoc, mul_comm β' β, hβ'u, mul_one]
        have e : x.1 - algebraMap R A (α * β') * x.2 =
            -(algebraMap R A α - x.1) + algebraMap R A (α * β') * (algebraMap R A β - x.2) := by
          linear_combination (-1 : A) * hm
        rw [e]
        exact 𝔮.add_mem (𝔮.neg_mem hα') (𝔮.mul_mem_left _ hβ')
      have h2 : (z - algebraMap R (Localization.Away s) (α * β')) *
          algebraMap A (Localization.Away s) x.2 =
          algebraMap A (Localization.Away s) (x.1 - algebraMap R A (α * β') * x.2) := by
        rw [sub_mul, hz, map_sub, map_mul (algebraMap A (Localization.Away s)),
          ← IsScalarTower.algebraMap_apply R A]
      have h3 : algebraMap A (Localization.Away s) x.2 ∉
          Ideal.map (algebraMap A (Localization.Away s)) 𝔮 := by
        rw [← Ideal.mem_comap, hmapC s hs]; exact hσ
      have h4 : (z - algebraMap R (Localization.Away s) (α * β')) *
          algebraMap A (Localization.Away s) x.2 ∈
          Ideal.map (algebraMap A (Localization.Away s)) 𝔮 := by
        rw [h2]; exact Ideal.mem_map_of_mem _ h1
      exact (hP.mem_or_mem h4).resolve_right h3
    refine ⟨inferInstance, ?_, ?_⟩
    · ext r
      rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes, ← Ideal.mem_comap, hmapR s hs]
    · intro x
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨r, hr⟩ := key (π x)
      refine ⟨r, ?_⟩
      rw [RingHom.comp_apply, Ideal.Quotient.eq, Ideal.mem_comap, map_sub, AlgHom.commutes,
        ← neg_sub]
      exact neg_mem hr

  obtain ⟨f, B, iB, iBR, u, v, π₀, hf, hπ₀, het, hBfp, hu, hv⟩ :=
    wcpa_dj_ncxc_embed R A 𝔮 h𝔮 hresA hcot
  obtain ⟨hQ0p, hQ0c, hQ0r⟩ := s9 f hf B π₀
  haveI := hQ0p
  haveI := hmapP f hf

  have hlevf := wcpa_dj_ncxc_levels_away R A 𝔮 f hf hlev

  obtain ⟨hnoeth, hΦ⟩ := wcpa_dj_ncxc_etale_fibre_levels R B u v het _ hQ0c hQ0r hu hv

  obtain ⟨g₀, hg₀, a, b, c, d, hdet, ⟨t, ht, htq⟩, hgen⟩ :=
    wcpa_dj_ncxc_fibre_principal R B (Localization.Away f) π₀ hπ₀ _ (hmapR f hf) u v hu hv
      hQ0r hnoeth hΦ hlevf

  haveI : Module.Flat A (Localization.Away f) := IsLocalization.flat _ (Submonoid.powers f)
  haveI : Module.Flat R (Localization.Away f) := Module.Flat.trans R A (Localization.Away f)
  haveI := hBfp
  have hfg : (RingHom.ker π₀).FG := Algebra.FinitePresentation.ker_fG_of_surjective π₀ hπ₀
  have hI : Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R) ≤
      Ideal.comap π₀ (Ideal.map (algebraMap A (Localization.Away f)) 𝔮) :=
    Ideal.map_le_iff_le_comap.mpr hQ0c.ge
  obtain ⟨h, hh, hhgen⟩ := wcpa_dj_ncxc_flat_nakayama R (IsLocalRing.maximalIdeal R) B
    (Localization.Away f) π₀ hπ₀ hfg _ hI g₀ hg₀ hgen

  obtain ⟨s, B', iB', iB'R, ι, π, hs, hπ, hker, het', hcomap⟩ :=
    wcpa_dj_ncxc_localize_chart R A 𝔮 f hf B u v g₀ π₀ hπ₀ het hg₀ h hh hhgen
  obtain ⟨hQp, hQc, hQr⟩ := s9 s hs B' π
  refine ⟨s, B', iB', iB'R, ι u, ι v, ι g₀, π, hs, hπ, hker, het', hQp, hQc, hQr, ?_, ?_,
    a, b, c, d, hdet, ι t, ?_, ?_⟩
  · have hu' : u ∈ (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).comap ι := by
      rw [hcomap]; exact hu
    exact hu'
  · have hv' : v ∈ (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).comap ι := by
      rw [hcomap]; exact hv
    exact hv'
  · intro hmem
    apply ht
    have hmem' : t ∈ (Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮)).comap ι :=
      hmem
    rwa [hcomap] at hmem'
  · have hmap : Ideal.map ι (Ideal.comap π₀ (Ideal.map (algebraMap A (Localization.Away f)) 𝔮)) ≤
        Ideal.comap π (Ideal.map (algebraMap A (Localization.Away s)) 𝔮) := by
      rw [← hcomap]; exact Ideal.map_comap_le
    have hmapm : Ideal.map ι (Ideal.map (algebraMap R B) (IsLocalRing.maximalIdeal R)) ≤
        Ideal.map (algebraMap R B') (IsLocalRing.maximalIdeal R) := by
      rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]
      exact Ideal.mem_map_of_mem _ hr
    have e : ι t * (ι g₀ - (algebraMap R B' a * ι u + algebraMap R B' b * ι v) *
        (algebraMap R B' c * ι u + algebraMap R B' d * ι v)) =
        ι (t * (g₀ - (algebraMap R B a * u + algebraMap R B b * v) *
          (algebraMap R B c * u + algebraMap R B d * v))) := by
      simp only [map_mul, map_sub, map_add, AlgHom.commutes]
    rw [e]
    have h1 := Ideal.mem_map_of_mem ι htq
    rw [Ideal.map_sup, Ideal.map_pow] at h1
    exact (sup_le_sup (Ideal.pow_right_mono hmap 3) hmapm) h1

theorem wcpa_dj_ncx_qnf_derivative_coords (R : Type u) [CommRing R] (B : Type u) [CommRing B]
    [Algebra R B] (z₁ z₂ g t : B) (Q : Ideal B) [Q.IsPrime] (𝔪 : Ideal R)
    (hz : (MvPolynomial.eval₂Hom (algebraMap R B) ![z₁, z₂]).Etale)
    (hz₁ : z₁ ∈ Q) (hz₂ : z₂ ∈ Q) (h𝔪 : Ideal.map (algebraMap R B) 𝔪 ≤ Q) (ht : t ∉ Q)
    (hg : t * (g - z₁ * z₂) ∈ Q ^ 3 ⊔ Ideal.map (algebraMap R B) 𝔪) :
    ∃ x₁ x₂ h s : B, h ∉ Q ∧ s ∉ Q ∧ x₁ ∈ Q ∧ x₂ ∈ Q ∧
      (MvPolynomial.eval₂Hom (algebraMap R (Localization.Away h))
        ![algebraMap B (Localization.Away h) x₁, algebraMap B (Localization.Away h) x₂]).Etale ∧
      KaehlerDifferential.D R B g =
        x₂ • KaehlerDifferential.D R B z₁ + x₁ • KaehlerDifferential.D R B z₂ ∧
      s * (g - x₁ * x₂) ∈ Q ^ 3 ⊔ Ideal.map (algebraMap R B) 𝔪 :=
by
  classical
  have hprime : Q.IsPrime := inferInstance

  have L8 : ∀ (S : Type u) [CommRing S] [Algebra R S] (y₁ y₂ : S),
      (MvPolynomial.eval₂Hom (algebraMap R S) ![y₁, y₂]).Etale →
      ∃ b : Module.Basis (Fin 2) S (KaehlerDifferential R S),
        b 0 = KaehlerDifferential.D R S y₁ ∧ b 1 = KaehlerDifferential.D R S y₂ := by
    intro S _ _ y₁ y₂ hy
    letI : Algebra (MvPolynomial (Fin 2) R) S :=
      (MvPolynomial.eval₂Hom (algebraMap R S) ![y₁, y₂]).toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 2) R) S := hy
    haveI : IsScalarTower R (MvPolynomial (Fin 2) R) S := IsScalarTower.of_algebraMap_eq (fun x => by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
    have hbc := KaehlerDifferential.isBaseChange_of_formallyEtale R (MvPolynomial (Fin 2) R) S
    refine ⟨hbc.basis (KaehlerDifferential.mvPolynomialBasis R (Fin 2)), ?_, ?_⟩ <;>
    · rw [IsBaseChange.basis_apply, KaehlerDifferential.mvPolynomialBasis_apply,
        KaehlerDifferential.map_D, RingHom.algebraMap_toAlgebra, MvPolynomial.eval₂Hom_X']
      rfl

  obtain ⟨e, he0, he1⟩ := L8 B z₁ z₂ hz
  set d0 : Derivation R B B := (e.coord 0).compDer (KaehlerDifferential.D R B) with hd0
  set d1 : Derivation R B B := (e.coord 1).compDer (KaehlerDifferential.D R B) with hd1
  have hd0a : ∀ y, d0 y = e.repr (KaehlerDifferential.D R B y) 0 := fun y => rfl
  have hd1a : ∀ y, d1 y = e.repr (KaehlerDifferential.D R B y) 1 := fun y => rfl
  have hDexp : ∀ y, KaehlerDifferential.D R B y =
      d0 y • KaehlerDifferential.D R B z₁ + d1 y • KaehlerDifferential.D R B z₂ := by
    intro y
    conv_lhs => rw [← e.sum_repr (KaehlerDifferential.D R B y)]
    rw [Fin.sum_univ_two, he0, he1, hd0a, hd1a]
  have h00 : d0 z₁ = 1 := by rw [hd0a, ← he0, e.repr_self]; simp
  have h01 : d0 z₂ = 0 := by rw [hd0a, ← he1, e.repr_self]; simp
  have h10 : d1 z₁ = 0 := by rw [hd1a, ← he0, e.repr_self]; simp
  have h11 : d1 z₂ = 1 := by rw [hd1a, ← he1, e.repr_self]; simp

  set J := Ideal.map (algebraMap R B) 𝔪 with hJ
  have hQ32 : Q ^ 3 ≤ Q ^ 2 := Ideal.pow_le_pow_right (by norm_num)
  have hQ21 : Q ^ 2 ≤ Q := Ideal.pow_le_self (by norm_num)
  have hK2Q : Q ^ 2 ⊔ J ≤ Q := sup_le hQ21 h𝔪
  have hK32 : Q ^ 3 ⊔ J ≤ Q ^ 2 ⊔ J := sup_le_sup_right hQ32 J
  have F1 : ∀ d : Derivation R B B, ∀ x ∈ J, d x ∈ J := by
    intro d x hx
    rw [hJ, Ideal.map, Ideal.span] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨r, -, rfl⟩ := hy
      rw [Derivation.map_algebraMap]; exact J.zero_mem
    | zero => rw [map_zero]; exact J.zero_mem
    | add y z _ _ hy hz => rw [map_add]; exact J.add_mem hy hz
    | smul a y hy' hy =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact J.add_mem (J.mul_mem_left _ hy) (J.mul_mem_right _ hy')
  have F2a : ∀ d : Derivation R B B, ∀ x ∈ Q ^ 2, d x ∈ Q := by
    intro d x hx
    rw [sq] at hx
    refine Submodule.mul_induction_on hx (fun a ha b hb => ?_) (fun y z hy hz => ?_)
    · rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact Q.add_mem (Q.mul_mem_right _ ha) (Q.mul_mem_right _ hb)
    · rw [map_add]; exact Q.add_mem hy hz
  have F2b : ∀ d : Derivation R B B, ∀ x ∈ Q ^ 3, d x ∈ Q ^ 2 := by
    intro d x hx
    rw [pow_succ'] at hx
    refine Submodule.mul_induction_on hx (fun a ha b hb => ?_) (fun y z hy hz => ?_)
    · rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      refine Ideal.add_mem _ ?_ (Ideal.mul_mem_right _ _ hb)
      rw [sq]; exact Ideal.mul_mem_mul ha (F2a d b hb)
    · rw [map_add]; exact Ideal.add_mem _ hy hz
  have F3a : ∀ d : Derivation R B B, ∀ x ∈ Q ^ 3 ⊔ J, d x ∈ Q ^ 2 ⊔ J := by
    intro d x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx
    rw [map_add]; exact Submodule.add_mem_sup (F2b d a ha) (F1 d b hb)
  have F3b : ∀ d : Derivation R B B, ∀ x ∈ Q ^ 2 ⊔ J, d x ∈ Q := by
    intro d x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx
    rw [map_add]; exact Q.add_mem (F2a d a ha) (h𝔪 (F1 d b hb))
  have F4 : ∀ y ∈ Q ^ 2 ⊔ J, ∀ q ∈ Q, y * q ∈ Q ^ 3 ⊔ J := by
    intro y hy q hq
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hy
    rw [add_mul]
    refine Submodule.add_mem_sup ?_ (J.mul_mem_right _ hb)
    rw [pow_succ]; exact Ideal.mul_mem_mul ha hq
  have htQ2 : t ^ 2 ∉ Q := fun h => ht (hprime.mem_of_pow_mem 2 h)
  have cancel : ∀ x, t ^ 2 * x ∈ Q → x ∈ Q := fun x h => (hprime.mem_or_mem h).resolve_left htQ2
  have G : ∀ (d : Derivation R B B) (u v : B), u * v = z₁ * z₂ → d u = 0 → d v = 1 →
      t ^ 2 * (d g - u) ∈ Q ^ 2 ⊔ J := by
    intro d u v huv hu hv
    have e : t ^ 2 * (d g - u) = t * d (t * (g - z₁ * z₂)) - d t * (t * (g - z₁ * z₂)) := by
      rw [← huv, Derivation.leibniz, map_sub, Derivation.leibniz, hu, hv]
      simp only [smul_eq_mul]; ring
    rw [e]
    exact Submodule.sub_mem _ (Ideal.mul_mem_left _ _ (F3a d _ hg))
      (hK32 (Ideal.mul_mem_left _ _ hg))
  have Jac : ∀ (d' : Derivation R B B) (x u : B), t ^ 2 * (x - u) ∈ Q ^ 2 ⊔ J → x - u ∈ Q →
      d' x - d' u ∈ Q := by
    intro d' x u hY hxu
    apply cancel
    have e : t ^ 2 * (d' x - d' u) = d' (t ^ 2 * (x - u)) - (x - u) * d' (t ^ 2) := by
      rw [Derivation.leibniz, map_sub, smul_eq_mul, smul_eq_mul]; ring
    rw [e]; exact Q.sub_mem (F3b d' _ hY) (Q.mul_mem_right _ hxu)
  have hY1 : t ^ 2 * (d1 g - z₁) ∈ Q ^ 2 ⊔ J := G d1 z₁ z₂ rfl h10 h11
  have hY2 : t ^ 2 * (d0 g - z₂) ∈ Q ^ 2 ⊔ J := G d0 z₂ z₁ (mul_comm _ _) h01 h00
  have hx1z : d1 g - z₁ ∈ Q := cancel _ (hK2Q hY1)
  have hx2z : d0 g - z₂ ∈ Q := cancel _ (hK2Q hY2)
  have hx1Q : d1 g ∈ Q := by simpa using Q.add_mem hx1z hz₁
  have hx2Q : d0 g ∈ Q := by simpa using Q.add_mem hx2z hz₂
  have ha1 : d0 (d1 g) - 1 ∈ Q := by simpa [h00] using Jac d0 _ _ hY1 hx1z
  have hb : d1 (d1 g) ∈ Q := by simpa [h10] using Jac d1 _ _ hY1 hx1z
  have hc : d0 (d0 g) ∈ Q := by simpa [h01] using Jac d0 _ _ hY2 hx2z
  have hd1' : d1 (d0 g) - 1 ∈ Q := by simpa [h11] using Jac d1 _ _ hY2 hx2z
  have hfinal : t ^ 4 * (g - d1 g * d0 g) ∈ Q ^ 3 ⊔ J := by
    have e : t ^ 4 * (g - d1 g * d0 g) = t ^ 3 * (t * (g - z₁ * z₂))
        - (t ^ 2 * (d1 g - z₁)) * (t ^ 2 * d0 g) - (t ^ 2 * (d0 g - z₂)) * (t ^ 2 * z₁) := by ring
    rw [e]
    exact Submodule.sub_mem _ (Submodule.sub_mem _ (Ideal.mul_mem_left _ _ hg)
      (F4 _ hY1 _ (Q.mul_mem_left _ hx2Q))) (F4 _ hY2 _ (Q.mul_mem_left _ hz₁))
  have hdetQ : d0 (d1 g) * d1 (d0 g) - d1 (d1 g) * d0 (d0 g) ∉ Q := by
    intro hm
    apply hprime.ne_top
    rw [Ideal.eq_top_iff_one]
    have e : (1 : B) = (d0 (d1 g) * d1 (d0 g) - d1 (d1 g) * d0 (d0 g)) -
        ((d0 (d1 g) - 1) * d1 (d0 g) + (d1 (d0 g) - 1) - d1 (d1 g) * d0 (d0 g)) := by ring
    rw [e]
    exact Q.sub_mem hm (Q.sub_mem (Q.add_mem (Q.mul_mem_right _ ha1) hd1')
      (Q.mul_mem_left _ hc))
  have ht4 : t ^ 4 ∉ Q := fun h => ht (hprime.mem_of_pow_mem 4 h)

  have L1 : ∀ (x₁ x₂ A Bb C Dd : B),
      KaehlerDifferential.D R B x₁ =
        A • KaehlerDifferential.D R B z₁ + Bb • KaehlerDifferential.D R B z₂ →
      KaehlerDifferential.D R B x₂ =
        C • KaehlerDifferential.D R B z₁ + Dd • KaehlerDifferential.D R B z₂ →
      ∀ (S : Type u) [CommRing S] [Algebra R S] [Algebra B S] [IsScalarTower R B S],
      (algebraMap B S).Etale → IsUnit (algebraMap B S (A * Dd - Bb * C)) →
      (MvPolynomial.eval₂Hom (algebraMap R S)
        ![algebraMap B S x₁, algebraMap B S x₂]).Etale := by
    intro x₁ x₂ A Bb C Dd hx1 hx2 S _ _ _ _ hBS hunit

    have hzS : (MvPolynomial.eval₂Hom (algebraMap R S)
        ![algebraMap B S z₁, algebraMap B S z₂]).Etale := by
      have e : MvPolynomial.eval₂Hom (algebraMap R S) ![algebraMap B S z₁, algebraMap B S z₂] =
          (algebraMap B S).comp (MvPolynomial.eval₂Hom (algebraMap R B) ![z₁, z₂]) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp [IsScalarTower.algebraMap_apply R B S]
        · intro i
          fin_cases i <;> simp
      rw [e]
      exact RingHom.Etale.stableUnderComposition _ _ hz hBS
    obtain ⟨e', he'0, he'1⟩ := L8 S _ _ hzS

    have hT : ∀ (x a b : B), KaehlerDifferential.D R B x =
        a • KaehlerDifferential.D R B z₁ + b • KaehlerDifferential.D R B z₂ →
        KaehlerDifferential.D R S (algebraMap B S x) =
          algebraMap B S a • e' 0 + algebraMap B S b • e' 1 := by
      intro x a b hx
      rw [he'0, he'1, ← KaehlerDifferential.map_D R R B S, hx, map_add, map_smul, map_smul,
        KaehlerDifferential.map_D, KaehlerDifferential.map_D, algebraMap_smul, algebraMap_smul]
    have hf0 := hT x₁ A Bb hx1
    have hf1 := hT x₂ C Dd hx2
    obtain ⟨w, hw⟩ := hunit
    set a' := algebraMap B S A
    set b' := algebraMap B S Bb
    set c' := algebraMap B S C
    set d' := algebraMap B S Dd
    set v : S := ((w⁻¹ : Sˣ) : S) with hv
    have hu : v * (a' * d' - b' * c') = 1 := by
      have h := Units.inv_mul w
      rw [hw, map_sub, map_mul, map_mul] at h
      exact h

    have hsmR : Algebra.FormallySmooth R S := by
      letI : Algebra (MvPolynomial (Fin 2) R) S :=
        (MvPolynomial.eval₂Hom (algebraMap R S) ![algebraMap B S z₁, algebraMap B S z₂]).toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 2) R) S := hzS
      haveI : IsScalarTower R (MvPolynomial (Fin 2) R) S := IsScalarTower.of_algebraMap_eq
        (fun x => by
          rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
      exact Algebra.FormallySmooth.comp R (MvPolynomial (Fin 2) R) S
    have hfpR : Algebra.FinitePresentation R S := by
      letI : Algebra (MvPolynomial (Fin 2) R) S :=
        (MvPolynomial.eval₂Hom (algebraMap R S) ![algebraMap B S z₁, algebraMap B S z₂]).toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin 2) R) S := hzS
      haveI : IsScalarTower R (MvPolynomial (Fin 2) R) S := IsScalarTower.of_algebraMap_eq
        (fun x => by
          rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
      exact Algebra.FinitePresentation.trans R (MvPolynomial (Fin 2) R) S

    letI : Algebra (MvPolynomial (Fin 2) R) S :=
      (MvPolynomial.eval₂Hom (algebraMap R S) ![algebraMap B S x₁, algebraMap B S x₂]).toAlgebra
    haveI : IsScalarTower R (MvPolynomial (Fin 2) R) S := IsScalarTower.of_algebraMap_eq
      (fun x => by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
    set bT := Algebra.TensorProduct.basis S (KaehlerDifferential.mvPolynomialBasis R (Fin 2))
      with hbT
    set mbc := KaehlerDifferential.mapBaseChange R (MvPolynomial (Fin 2) R) S with hmbc
    have hm0 : mbc (bT 0) = KaehlerDifferential.D R S (algebraMap B S x₁) := by
      rw [hbT, Algebra.TensorProduct.basis_apply, KaehlerDifferential.mvPolynomialBasis_apply,
        hmbc, KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D,
        RingHom.algebraMap_toAlgebra, MvPolynomial.eval₂Hom_X']
      rfl
    have hm1 : mbc (bT 1) = KaehlerDifferential.D R S (algebraMap B S x₂) := by
      rw [hbT, Algebra.TensorProduct.basis_apply, KaehlerDifferential.mvPolynomialBasis_apply,
        hmbc, KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D,
        RingHom.algebraMap_toAlgebra, MvPolynomial.eval₂Hom_X']
      rfl
    set inv := e'.constr S ![v • (d' • bT 0 - b' • bT 1), v • (a' • bT 1 - c' • bT 0)] with hinv
    have hi0 : inv (e' 0) = v • (d' • bT 0 - b' • bT 1) := by
      rw [hinv, Module.Basis.constr_basis]; rfl
    have hi1 : inv (e' 1) = v • (a' • bT 1 - c' • bT 0) := by
      rw [hinv, Module.Basis.constr_basis]; rfl
    have hc1 : mbc.comp inv = LinearMap.id := by
      apply e'.ext
      intro i
      fin_cases i
      · show mbc (inv (e' 0)) = e' 0
        rw [hi0, map_smul, map_sub, map_smul, map_smul, hm0, hm1, hf0, hf1]
        linear_combination (norm := module) hu • e' 0
      · show mbc (inv (e' 1)) = e' 1
        rw [hi1, map_smul, map_sub, map_smul, map_smul, hm0, hm1, hf0, hf1]
        linear_combination (norm := module) hu • e' 1
    have hc2 : inv.comp mbc = LinearMap.id := by
      apply bT.ext
      intro i
      fin_cases i
      · show inv (mbc (bT 0)) = bT 0
        rw [hm0, hf0, map_add, map_smul, map_smul, hi0, hi1]
        linear_combination (norm := module) hu • bT 0
      · show inv (mbc (bT 1)) = bT 1
        rw [hm1, hf1, map_add, map_smul, map_smul, hi0, hi1]
        linear_combination (norm := module) hu • bT 1
    have hinj : Function.Injective mbc := by
      intro x y hxy
      have := congrArg inv hxy
      rwa [← LinearMap.comp_apply, ← LinearMap.comp_apply, hc2] at this
    have hsurj : Function.Surjective mbc := by
      intro y
      refine ⟨inv y, ?_⟩
      rw [← LinearMap.comp_apply, hc1, LinearMap.id_apply]

    haveI hsub : Subsingleton (KaehlerDifferential (MvPolynomial (Fin 2) R) S) := by
      refine subsingleton_of_forall_eq 0 (fun ω => ?_)
      obtain ⟨ω', rfl⟩ := KaehlerDifferential.map_surjective R (MvPolynomial (Fin 2) R) S ω
      obtain ⟨x, rfl⟩ := hsurj ω'
      exact (KaehlerDifferential.exact_mapBaseChange_map R (MvPolynomial (Fin 2) R) S).apply_apply_eq_zero x
    haveI : Algebra.FormallyUnramified (MvPolynomial (Fin 2) R) S := ⟨hsub⟩

    haveI : Subsingleton (Algebra.H1Cotangent (MvPolynomial (Fin 2) R) S) := by
      refine subsingleton_of_forall_eq 0 (fun x => ?_)
      have h1 : Algebra.H1Cotangent.δ R (MvPolynomial (Fin 2) R) S x = 0 := by
        apply hinj
        rw [map_zero]
        exact (Algebra.H1Cotangent.exact_δ_mapBaseChange R (MvPolynomial (Fin 2) R) S).apply_apply_eq_zero x
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ R (MvPolynomial (Fin 2) R) S x).mp h1
      have : y = 0 := Subsingleton.elim _ _
      rw [this, map_zero]
    haveI : Algebra.FormallySmooth (MvPolynomial (Fin 2) R) S := ⟨inferInstance, inferInstance⟩
    haveI : Algebra.FormallyEtale (MvPolynomial (Fin 2) R) S :=
      Algebra.FormallyEtale.of_formallyUnramified_and_formallySmooth
    haveI : Algebra.FinitePresentation (MvPolynomial (Fin 2) R) S :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R _ S
    have : Algebra.Etale (MvPolynomial (Fin 2) R) S := ⟨inferInstance, inferInstance⟩
    exact this

  set h := d0 (d1 g) * d1 (d0 g) - d1 (d1 g) * d0 (d0 g) with hh
  have hBS : (algebraMap B (Localization.Away h)).Etale :=
    RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway h)
  have hEt := L1 (d1 g) (d0 g) (d0 (d1 g)) (d1 (d1 g)) (d0 (d0 g)) (d1 (d0 g))
    (hDexp (d1 g)) (hDexp (d0 g)) (Localization.Away h) hBS
    (IsLocalization.Away.algebraMap_isUnit h)
  exact ⟨d1 g, d0 g, h, t ^ 4, hdetQ, ht4, hx1Q, hx2Q, hEt, hDexp g, hfinal⟩

theorem wcpa_dj_ncx_qnf_hensel_constant (R : Type u) [CommRing R] [HenselianLocalRing R]
    (B : Type u) [CommRing B] [Algebra R B] (x₁ x₂ g : B) (Q : Ideal B) [Q.IsPrime]
    (hx : (MvPolynomial.eval₂Hom (algebraMap R B) ![x₁, x₂]).Etale)
    (hQ : Q.comap (algebraMap R B) = IsLocalRing.maximalIdeal R)
    (hres : Function.Surjective ((Ideal.Quotient.mk Q).comp (algebraMap R B)))
    (hx₁ : x₁ ∈ Q) (hx₂ : x₂ ∈ Q) (hg : g ∈ Q) :
    ∃ r ∈ IsLocalRing.maximalIdeal R, ∃ h ∉ Q,
      h * (g + algebraMap R B r) ∈ Ideal.span {x₁, x₂} :=
by
  classical


  have hetale : ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
      (σ : E →ₐ[R] IsLocalRing.ResidueField R), ∃ τ : E →ₐ[R] R,
        ∀ x : E, IsLocalRing.residue R (τ x) = σ x := by
    intro E _ _ _ σ
    haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
    haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
      Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
    haveI : Algebra.IsEtaleAt R (RingHom.ker σ) :=
      Algebra.FormallyEtale.comp R E (Localization.AtPrime (RingHom.ker σ))
    obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker σ)
    have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
    let σg : Localization.Away g →ₐ[R] IsLocalRing.ResidueField R :=
      IsLocalization.Away.liftAlgHom g hσg
    have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
      intro y
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
    let e : Q.Ring ≃ₐ[R] Localization.Away g :=
      AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
    have heX : e Q.X = Q.x := by
      rw [AlgEquiv.ofBijective_apply]
      exact Q.lift_X _ _
    set a₀ := σg Q.x with ha₀
    have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
    have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
    have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact (Q.hasMap.2.map σg).ne_zero
    have hHen := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
    obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
    have hres' : ∀ p : Polynomial R,
        IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
      intro p
      rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
        ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
    have hHas : Q.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]
        exact hroot
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
        exact hg0
    have hcomp : (Algebra.ofId R (IsLocalRing.ResidueField R)).comp (Q.lift a hHas) =
        σg.comp (e : Q.Ring →ₐ[R] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
    refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[R] Q.Ring)).comp
      (IsScalarTower.toAlgHom R E (Localization.Away g)), fun y => ?_⟩
    have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
      Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      AlgEquiv.coe_toAlgHom, h1, hσg_apply]

  have hker : ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.FormallyUnramified R E]
      [Algebra.FinitePresentation R E] (τ : E →ₐ[R] R),
      ∃ e : E, IsIdempotentElem e ∧ RingHom.ker τ = Ideal.span {e} := by
    intro E _ _ _ _ τ
    have hsurj : Function.Surjective τ := fun r => ⟨algebraMap R E r, by simp⟩
    have hFG : (RingHom.ker τ).FG := by
      have := Algebra.FinitePresentation.ker_fG_of_surjective τ hsurj
      exact this
    have hsplit : ∀ x : E, x - algebraMap R E (τ x) ∈ RingHom.ker τ := by
      intro x
      rw [RingHom.mem_ker, map_sub, AlgHom.commutes]
      simp
    have hKK : RingHom.ker τ ≤ RingHom.ker τ ^ 2 := by
      have hN2 : IsNilpotent ((RingHom.ker τ).map (Ideal.Quotient.mk (RingHom.ker τ ^ 2))) := by
        refine ⟨2, ?_⟩
        rw [← Ideal.map_pow, Ideal.map_quotient_self]
        rfl
      let g₁ : E →ₐ[R] E ⧸ RingHom.ker τ ^ 2 := Ideal.Quotient.mkₐ R (RingHom.ker τ ^ 2)
      let g₂ : E →ₐ[R] E ⧸ RingHom.ker τ ^ 2 := (Algebra.ofId R (E ⧸ RingHom.ker τ ^ 2)).comp τ
      have hg : g₁ = g₂ := by
        apply Algebra.FormallyUnramified.ext _ hN2
        intro x
        rw [Ideal.Quotient.eq]
        have : g₁ x - g₂ x = Ideal.Quotient.mk (RingHom.ker τ ^ 2) (x - algebraMap R E (τ x)) := by
          show Ideal.Quotient.mkₐ R (RingHom.ker τ ^ 2) x -
            (Algebra.ofId R (E ⧸ RingHom.ker τ ^ 2)) (τ x) = _
          rw [map_sub, Ideal.Quotient.mk_algebraMap, Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply]
        rw [this]
        exact Ideal.mem_map_of_mem _ (hsplit x)
      intro x hx
      have h1 := congrArg (fun φ => φ x) hg
      simp only [g₁, g₂, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply] at h1
      rw [RingHom.mem_ker.mp hx, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    have hidem : IsIdempotentElem (RingHom.ker τ) := by
      show RingHom.ker τ * RingHom.ker τ = RingHom.ker τ
      apply le_antisymm Ideal.mul_le_right
      rw [← pow_two]
      exact hKK
    obtain ⟨e, he, hKe⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hidem
    exact ⟨e, he, hKe⟩

  have hquot : Algebra.Etale R (B ⧸ Ideal.span {x₁, x₂}) := by
    letI : Algebra (MvPolynomial (Fin 2) R) B :=
      (MvPolynomial.eval₂Hom (algebraMap R B) ![x₁, x₂]).toAlgebra
    haveI hPB : Algebra.Etale (MvPolynomial (Fin 2) R) B := RingHom.etale_algebraMap.mp hx
    haveI : IsScalarTower R (MvPolynomial (Fin 2) R) B := IsScalarTower.of_algebraMap_eq
      (fun r => by
        rw [MvPolynomial.algebraMap_eq]
        exact (MvPolynomial.eval₂Hom_C (algebraMap R B) ![x₁, x₂] r).symm)
    have hXi : ∀ i, algebraMap (MvPolynomial (Fin 2) R) B (MvPolynomial.X i) = ![x₁, x₂] i :=
      fun i => MvPolynomial.eval₂Hom_X' (algebraMap R B) ![x₁, x₂] i
    have hX0 : algebraMap (MvPolynomial (Fin 2) R) B (MvPolynomial.X 0) = x₁ := hXi 0
    have hX1 : algebraMap (MvPolynomial (Fin 2) R) B (MvPolynomial.X 1) = x₂ := hXi 1
    haveI : Algebra.FinitePresentation R B :=
      Algebra.FinitePresentation.trans R (MvPolynomial (Fin 2) R) B
    haveI : Algebra.FinitePresentation R (B ⧸ Ideal.span {x₁, x₂}) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.toFinite _))
    have hmk1 : Ideal.Quotient.mk (Ideal.span {x₁, x₂}) x₁ = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _))
    have hmk2 : Ideal.Quotient.mk (Ideal.span {x₁, x₂}) x₂ = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
    have upgrade : ∀ (T : Type u) [CommRing T] [Algebra R T] [Algebra (MvPolynomial (Fin 2) R) T]
        [IsScalarTower R (MvPolynomial (Fin 2) R) T],
        (∀ i, algebraMap (MvPolynomial (Fin 2) R) T (MvPolynomial.X i) = 0) →
        ∀ ψ : B →ₐ[R] T, ψ x₁ = 0 → ψ x₂ = 0 →
        ∃ ψ' : B →ₐ[MvPolynomial (Fin 2) R] T, ∀ b, ψ' b = ψ b := by
      intro T _ _ _ _ hT ψ h1 h2
      have hψ : ∀ i : Fin 2, ψ (![x₁, x₂] i) = 0 := Fin.forall_fin_two.mpr ⟨h1, h2⟩
      have hc : ψ.comp (IsScalarTower.toAlgHom R (MvPolynomial (Fin 2) R) B) =
          IsScalarTower.toAlgHom R (MvPolynomial (Fin 2) R) T := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom', IsScalarTower.coe_toAlgHom', hT, hXi]
        exact hψ i
      exact ⟨{ toRingHom := (ψ : B →+* T), commutes' := fun p => congrArg (fun f => f p) hc },
        fun b => rfl⟩
    haveI : Algebra.FormallyEtale R (B ⧸ Ideal.span {x₁, x₂}) := by
      rw [Algebra.FormallyEtale.iff_comp_bijective]
      intro A _ _ J hJ
      letI : Algebra (MvPolynomial (Fin 2) R) A :=
        (MvPolynomial.aeval (fun _ => (0 : A))).toRingHom.toAlgebra
      haveI : IsScalarTower R (MvPolynomial (Fin 2) R) A := IsScalarTower.of_algebraMap_eq
        (fun r => ((MvPolynomial.aeval (fun _ => (0 : A))).commutes r).symm)
      have hA : ∀ i, algebraMap (MvPolynomial (Fin 2) R) A (MvPolynomial.X i) = 0 := fun i =>
        MvPolynomial.aeval_X (fun _ => (0 : A)) i
      have hAJ : ∀ i, algebraMap (MvPolynomial (Fin 2) R) (A ⧸ J) (MvPolynomial.X i) = 0 := by
        intro i
        rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin 2) R) A (A ⧸ J), hA, map_zero]
      have hJn : IsNilpotent J := ⟨2, by rw [hJ]; rfl⟩
      refine ⟨fun G₁ G₂ hG => ?_, fun f => ?_⟩
      · obtain ⟨ψ₁, hψ₁⟩ := upgrade A hA (G₁.comp (Ideal.Quotient.mkₐ R _))
          (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk1, map_zero])
          (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk2, map_zero])
        obtain ⟨ψ₂, hψ₂⟩ := upgrade A hA (G₂.comp (Ideal.Quotient.mkₐ R _))
          (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk1, map_zero])
          (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk2, map_zero])
        have h12 : ψ₁ = ψ₂ := by
          apply Algebra.FormallyUnramified.ext J hJn
          intro b
          rw [hψ₁, hψ₂]
          have := congrArg (fun F => F (Ideal.Quotient.mk (Ideal.span {x₁, x₂}) b)) hG
          simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this ⊢
          exact this
        ext y
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        have := congrArg (fun F => F b) h12
        simp only [hψ₁, hψ₂, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
        exact this
      · obtain ⟨ψ, hψ⟩ := upgrade (A ⧸ J) hAJ (f.comp (Ideal.Quotient.mkₐ R _))
          (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk1, map_zero])
          (by rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, hmk2, map_zero])
        let F₀ : B →ₐ[MvPolynomial (Fin 2) R] A := Algebra.FormallySmooth.lift J hJn ψ
        have hF₀ : ∀ b, Ideal.Quotient.mk J (F₀ b) = ψ b := Algebra.FormallySmooth.mk_lift J hJn ψ
        have hFx : ∀ y ∈ Ideal.span {x₁, x₂}, (F₀.restrictScalars R) y = 0 := by
          intro y hy
          have hle : Ideal.span {x₁, x₂} ≤ RingHom.ker (F₀.restrictScalars R) := by
            rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
            refine ⟨?_, ?_⟩
            · show F₀ x₁ = 0
              rw [← hX0, F₀.commutes, hA]
            · show F₀ x₂ = 0
              rw [← hX1, F₀.commutes, hA]
          exact hle hy
        refine ⟨Ideal.Quotient.liftₐ _ (F₀.restrictScalars R) hFx, ?_⟩
        ext y
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        show Ideal.Quotient.mk J (F₀ b) = f (Ideal.Quotient.mk _ b)
        rw [hF₀, hψ]
        rfl
    exact ⟨inferInstance, inferInstance⟩
  haveI := hquot

  have hIQ : Ideal.span {x₁, x₂} ≤ Q := by
    rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨hx₁, hx₂⟩
  have hfs : Function.Surjective (Algebra.ofId R (B ⧸ Q)) := by
    intro y
    obtain ⟨r, hr⟩ := hres y
    refine ⟨r, ?_⟩
    rw [← hr, RingHom.comp_apply, Ideal.Quotient.mk_algebraMap, Algebra.ofId_apply]
  have hkf : IsLocalRing.maximalIdeal R = RingHom.ker (Algebra.ofId R (B ⧸ Q)) := by
    ext r
    rw [RingHom.mem_ker, Algebra.ofId_apply, ← Ideal.Quotient.mk_algebraMap,
      Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, hQ]
  let eQ : IsLocalRing.ResidueField R ≃ₐ[R] B ⧸ Q :=
    (Ideal.quotientEquivAlgOfEq R hkf).trans (Ideal.quotientKerAlgEquivOfSurjective hfs)
  let σ₀ : B →ₐ[R] IsLocalRing.ResidueField R :=
    (eQ.symm : B ⧸ Q →ₐ[R] IsLocalRing.ResidueField R).comp (Ideal.Quotient.mkₐ R Q)
  have hσ₀ : ∀ b, σ₀ b = 0 ↔ b ∈ Q := by
    intro b
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    show eQ.symm (Ideal.Quotient.mk Q b) = 0 ↔ _
    exact map_eq_zero_iff _ eQ.symm.injective
  let σ : (B ⧸ Ideal.span {x₁, x₂}) →ₐ[R] IsLocalRing.ResidueField R :=
    Ideal.Quotient.liftₐ _ σ₀ (fun a ha => (hσ₀ a).mpr (hIQ ha))
  have hσmk : ∀ b, σ (Ideal.Quotient.mk _ b) = σ₀ b := fun b => rfl

  obtain ⟨τ, hτ⟩ := hetale _ σ
  obtain ⟨e, he, hke⟩ := hker _ τ
  obtain ⟨r, hr⟩ : ∃ r, r = -τ (Ideal.Quotient.mk (Ideal.span {x₁, x₂}) g) := ⟨_, rfl⟩
  have hrm : r ∈ IsLocalRing.maximalIdeal R := by
    rw [hr, Ideal.neg_mem_iff, ← IsLocalRing.residue_eq_zero_iff, hτ, hσmk]
    exact (hσ₀ g).mpr hg
  obtain ⟨e', he'⟩ := Ideal.Quotient.mk_surjective e
  have hτe : τ e = 0 := by
    have : e ∈ RingHom.ker τ := by
      rw [hke]
      exact Ideal.mem_span_singleton_self e
    exact RingHom.mem_ker.mp this
  have he'Q : e' ∈ Q := by
    rw [← hσ₀, ← hσmk, he', ← hτ, hτe, map_zero]
  refine ⟨r, hrm, 1 - e', ?_, ?_⟩
  · intro hmem
    apply (inferInstance : Q.IsPrime).ne_top
    rw [Ideal.eq_top_iff_one]
    have := Q.add_mem hmem he'Q
    rwa [sub_add_cancel] at this
  · have hy : Ideal.Quotient.mk (Ideal.span {x₁, x₂}) (g + algebraMap R B r) ∈ RingHom.ker τ := by
      rw [RingHom.mem_ker, map_add, Ideal.Quotient.mk_algebraMap, map_add, AlgHom.commutes, hr]
      simp
    rw [hke] at hy
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hy
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, map_sub, map_one, he', ← hc]
    have he2 : e * e = e := he
    calc (1 - e) * (c * e) = c * (e - e * e) := by ring
      _ = 0 := by rw [he2, sub_self, mul_zero]

theorem wcpa_dj_ncx_qnf_morse (R : Type u) [CommRing R] (B : Type u) [CommRing B] [Algebra R B]
    (y₁ y₂ G : B) (hy : (MvPolynomial.eval₂Hom (algebraMap R B) ![y₁, y₂]).Etale)
    (hG : G ∈ Ideal.span {y₁, y₂})
    (hD : KaehlerDifferential.D R B G ∈
      Ideal.span {y₁, y₂} • (⊤ : Submodule B (KaehlerDifferential R B))) :
    ∃ α β γ : B, G = α * y₁ ^ 2 + β * y₁ * y₂ + γ * y₂ ^ 2 :=
by
  classical
  obtain ⟨b, hb⟩ : ∃ b : Module.Basis (Fin 2) B (KaehlerDifferential R B),
      ∀ i, b i = KaehlerDifferential.D R B (![y₁, y₂] i) := by
    letI : Algebra (MvPolynomial (Fin 2) R) B :=
      (MvPolynomial.eval₂Hom (algebraMap R B) ![y₁, y₂]).toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 2) R) B := hy
    haveI : IsScalarTower R (MvPolynomial (Fin 2) R) B :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
    have hbc := KaehlerDifferential.isBaseChange_of_formallyEtale R (MvPolynomial (Fin 2) R) B
    refine ⟨hbc.basis (KaehlerDifferential.mvPolynomialBasis R (Fin 2)), fun i => ?_⟩
    rw [IsBaseChange.basis_apply, KaehlerDifferential.mvPolynomialBasis_apply,
      KaehlerDifferential.map_D, RingHom.algebraMap_toAlgebra, MvPolynomial.eval₂Hom_X']
  set I := Ideal.span {y₁, y₂} with hI
  have hy1 : y₁ ∈ I := Ideal.subset_span (Set.mem_insert _ _)
  have hy2 : y₂ ∈ I := Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have hM2 : ∀ (ℓ : KaehlerDifferential R B →ₗ[B] B) (m : KaehlerDifferential R B),
      m ∈ I • (⊤ : Submodule B (KaehlerDifferential R B)) → ℓ m ∈ I := by
    intro ℓ m hm
    refine Submodule.smul_induction_on hm (fun r hr n _ => ?_) (fun x y hx hy => ?_)
    · rw [map_smul, smul_eq_mul]; exact Ideal.mul_mem_right _ _ hr
    · rw [map_add]; exact Ideal.add_mem _ hx hy
  obtain ⟨c₁, c₂, hc⟩ := Ideal.mem_span_pair.mp hG
  have hb0 : b 0 = KaehlerDifferential.D R B y₁ := by rw [hb]; rfl
  have hb1 : b 1 = KaehlerDifferential.D R B y₂ := by rw [hb]; rfl
  have hDG : KaehlerDifferential.D R B G = c₁ • b 0 + y₁ • KaehlerDifferential.D R B c₁ +
      (c₂ • b 1 + y₂ • KaehlerDifferential.D R B c₂) := by
    rw [← hc, Derivation.map_add, Derivation.leibniz, Derivation.leibniz, hb0, hb1]
    try abel
  have hcoord : ∀ i : Fin 2, b.coord i (KaehlerDifferential.D R B G) =
      c₁ * b.coord i (b 0) + y₁ * b.coord i (KaehlerDifferential.D R B c₁) +
      (c₂ * b.coord i (b 1) + y₂ * b.coord i (KaehlerDifferential.D R B c₂)) := by
    intro i
    rw [hDG]
    simp only [map_add, map_smul, smul_eq_mul]
  have hmem : ∀ i : Fin 2, c₁ * b.coord i (b 0) + c₂ * b.coord i (b 1) ∈ I := by
    intro i
    have h := hM2 (b.coord i) _ hD
    have e : c₁ * b.coord i (b 0) + c₂ * b.coord i (b 1) =
        b.coord i (KaehlerDifferential.D R B G) -
          y₁ * b.coord i (KaehlerDifferential.D R B c₁) -
          y₂ * b.coord i (KaehlerDifferential.D R B c₂) := by
      rw [hcoord i]; ring
    rw [e]
    exact Ideal.sub_mem _ (Ideal.sub_mem _ h (Ideal.mul_mem_right _ _ hy1))
      (Ideal.mul_mem_right _ _ hy2)
  have hc1 : c₁ ∈ I := by
    have h := hmem 0
    simpa [Module.Basis.coord_apply, Module.Basis.repr_self] using h
  have hc2 : c₂ ∈ I := by
    have h := hmem 1
    simpa [Module.Basis.coord_apply, Module.Basis.repr_self] using h
  obtain ⟨a₁, b₁, h1⟩ := Ideal.mem_span_pair.mp hc1
  obtain ⟨a₂, b₂, h2⟩ := Ideal.mem_span_pair.mp hc2
  refine ⟨a₁, b₁ + a₂, b₂, ?_⟩
  rw [← hc, ← h1, ← h2]
  ring

theorem wcpa_dj_ncx_qnf_jet_coeffs (R : Type u) [CommRing R] (B : Type u) [CommRing B]
    [Algebra R B] (x₁ x₂ α β γ s : B) (Q : Ideal B) [Q.IsPrime] (𝔪 : Ideal R)
    (hx : (MvPolynomial.eval₂Hom (algebraMap R B) ![x₁, x₂]).Etale)
    (h𝔪 : Ideal.map (algebraMap R B) 𝔪 ≤ Q) (hx₁ : x₁ ∈ Q) (hx₂ : x₂ ∈ Q) (hs : s ∉ Q)
    (hq : s * (α * x₁ ^ 2 + β * x₁ * x₂ + γ * x₂ ^ 2) ∈
      Q ^ 3 ⊔ Ideal.map (algebraMap R B) 𝔪) :
    α ∈ Q ∧ β ∈ Q ∧ γ ∈ Q :=
by
  classical

  have lift : ∀ {A B' D K : Type u} [CommRing A] [CommRing B'] [CommRing D] [CommRing K]
      (φ : A →+* B') (_ : φ.Etale) (θ : A →+* D) (ε : D →+* K) (π : B' →+* K)
      (_ : Function.Surjective ε) (_ : IsNilpotent (RingHom.ker ε))
      (_ : ε.comp θ = π.comp φ), ∃ ψ : B' →+* D, ψ.comp φ = θ ∧ ε.comp ψ = π := by
    intro A B' D K _ _ _ _ φ hφ θ ε π hε hnil hcomm
    letI := φ.toAlgebra
    letI := θ.toAlgebra
    letI : Algebra A K := (π.comp φ).toAlgebra
    haveI : Algebra.Etale A B' := hφ
    let f : B' →ₐ[A] K := { π with commutes' := fun a => rfl }
    let g : D →ₐ[A] K := { ε with commutes' := fun a => RingHom.congr_fun hcomm a }
    have hg : Function.Surjective g := hε
    have hgn : IsNilpotent (RingHom.ker (g : D →+* K)) := hnil
    refine ⟨(Algebra.FormallySmooth.liftOfSurjective f g hg hgn).toRingHom, ?_, ?_⟩
    · ext a
      exact (Algebra.FormallySmooth.liftOfSurjective f g hg hgn).commutes a
    · ext b
      exact Algebra.FormallySmooth.liftOfSurjective_apply f g hg hgn b

  have key : ∀ (K : Type u) [CommRing K] (πQ : B →+* K), (∀ b ∈ Q, πQ b = 0) →
      ∀ c₁ c₂ : K, πQ s * (πQ α * c₁ ^ 2 + πQ β * c₁ * c₂ + πQ γ * c₂ ^ 2) = 0 := by
    intro K _ πQ hπQ c₁ c₂
    set I : Ideal (Polynomial K) := Ideal.span {(Polynomial.X : Polynomial K) ^ 3} with hI
    set mk : Polynomial K →+* Polynomial K ⧸ I := Ideal.Quotient.mk I with hmk
    have hIeval : ∀ p ∈ I, Polynomial.evalRingHom (0 : K) p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      simp
    let ε : (Polynomial K ⧸ I) →+* K := Ideal.Quotient.lift I (Polynomial.evalRingHom 0) hIeval
    have hεf : ∀ p : Polynomial K, ε (mk p) = p.coeff 0 := by
      intro p
      simp [ε, mk, Polynomial.coeff_zero_eq_eval_zero]
    have hεs : Function.Surjective ε := fun k =>
      ⟨mk (Polynomial.C k), by rw [hεf]; simp⟩
    set J : Ideal (Polynomial K ⧸ I) := Ideal.span {mk Polynomial.X} with hJdef
    have hJ : ∀ p : Polynomial K, p.coeff 0 = 0 → mk p ∈ J := by
      intro p hp
      obtain ⟨p', rfl⟩ := Polynomial.X_dvd_iff.mpr hp
      rw [map_mul]
      exact Ideal.mem_span_singleton.mpr (dvd_mul_right _ _)
    have hJ3 : J ^ 3 = ⊥ := by
      rw [hJdef, Ideal.span_singleton_pow, ← map_pow, Ideal.span_singleton_eq_bot, hmk,
        Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton_self _
    have hεn : IsNilpotent (RingHom.ker ε) := by
      refine ⟨3, ?_⟩
      have h1 : RingHom.ker ε ≤ J := by
        intro y hy
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
        apply hJ
        rw [← hεf]
        exact hy
      have h2 := Ideal.pow_right_mono h1 3
      rw [hJ3] at h2
      exact le_bot_iff.mp h2
    let θ : MvPolynomial (Fin 2) R →+* (Polynomial K ⧸ I) :=
      mk.comp (MvPolynomial.eval₂Hom (Polynomial.C.comp (πQ.comp (algebraMap R B)))
        ![Polynomial.C c₁ * Polynomial.X, Polynomial.C c₂ * Polynomial.X])
    have hcomm : ε.comp θ = πQ.comp (MvPolynomial.eval₂Hom (algebraMap R B) ![x₁, x₂]) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, θ, MvPolynomial.eval₂Hom_C, hεf, Polynomial.coeff_C_zero]
      · intro i
        fin_cases i
        · simp [θ, hεf, hπQ x₁ hx₁]
        · simp [θ, hεf, hπQ x₂ hx₂]
    obtain ⟨ψ, hψφ, hεψ⟩ := @lift (MvPolynomial (Fin 2) R) B (Polynomial K ⧸ I) K _ _ _ _
      _ hx θ ε πQ hεs hεn hcomm
    have P0 : ∀ (b : B) (p : Polynomial K), ψ b = mk p → p.coeff 0 = πQ b := by
      intro b p h
      rw [← hεf, ← h]
      exact RingHom.congr_fun hεψ b
    have P1 : ψ x₁ = mk (Polynomial.C c₁ * Polynomial.X) := by
      have := RingHom.congr_fun hψφ (MvPolynomial.X 0)
      simpa [θ] using this
    have P2 : ψ x₂ = mk (Polynomial.C c₂ * Polynomial.X) := by
      have := RingHom.congr_fun hψφ (MvPolynomial.X 1)
      simpa [θ] using this
    have P3 : ∀ r ∈ 𝔪, ψ (algebraMap R B r) = 0 := by
      intro r hr
      have h1 := RingHom.congr_fun hψφ (MvPolynomial.C r)
      have hQ : πQ (algebraMap R B r) = 0 := hπQ _ (h𝔪 (Ideal.mem_map_of_mem _ hr))
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, θ] at h1
      rw [h1, hQ, map_zero, map_zero]
    have hQJ : ∀ b ∈ Q, ψ b ∈ J := by
      intro b hb
      obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (ψ b)
      rw [← hp]
      apply hJ
      rw [P0 b p hp.symm]
      exact hπQ b hb
    have hker : Q ^ 3 ⊔ Ideal.map (algebraMap R B) 𝔪 ≤ Ideal.comap ψ ⊥ := by
      apply sup_le
      · have h1 : Ideal.map ψ Q ≤ J := Ideal.map_le_iff_le_comap.mpr hQJ
        have h2 : Ideal.map ψ (Q ^ 3) ≤ ⊥ := by
          rw [Ideal.map_pow, ← hJ3]
          exact Ideal.pow_right_mono h1 3
        exact Ideal.map_le_iff_le_comap.mp h2
      · apply Ideal.map_le_iff_le_comap.mpr
        intro r hr
        simp only [Ideal.mem_comap]
        rw [P3 r hr]
        exact Ideal.zero_mem _
    have h0 : ψ (s * (α * x₁ ^ 2 + β * x₁ * x₂ + γ * x₂ ^ 2)) = 0 := by
      have := hker hq
      rwa [Ideal.mem_comap, Ideal.mem_bot] at this
    obtain ⟨ps, hps⟩ := Ideal.Quotient.mk_surjective (ψ s)
    obtain ⟨pa, hpa⟩ := Ideal.Quotient.mk_surjective (ψ α)
    obtain ⟨pb, hpb⟩ := Ideal.Quotient.mk_surjective (ψ β)
    obtain ⟨pg, hpg⟩ := Ideal.Quotient.mk_surjective (ψ γ)
    have h1 : ψ (s * (α * x₁ ^ 2 + β * x₁ * x₂ + γ * x₂ ^ 2)) = mk
        (Polynomial.X ^ 2 * (ps * (pa * Polynomial.C c₁ ^ 2 + pb * Polynomial.C c₁ *
          Polynomial.C c₂ + pg * Polynomial.C c₂ ^ 2))) := by
      have e : (Polynomial.X ^ 2 * (ps * (pa * Polynomial.C c₁ ^ 2 + pb * Polynomial.C c₁ *
          Polynomial.C c₂ + pg * Polynomial.C c₂ ^ 2)) : Polynomial K) =
          ps * (pa * (Polynomial.C c₁ * Polynomial.X) ^ 2 +
            pb * (Polynomial.C c₁ * Polynomial.X) * (Polynomial.C c₂ * Polynomial.X) +
            pg * (Polynomial.C c₂ * Polynomial.X) ^ 2) := by ring
      rw [e]
      simp only [map_mul, map_add, map_pow]
      rw [P1, P2, ← hps, ← hpa, ← hpb, ← hpg]
      simp only [hmk, map_mul]
    have h2 : (Polynomial.X ^ 2 * (ps * (pa * Polynomial.C c₁ ^ 2 + pb * Polynomial.C c₁ *
          Polynomial.C c₂ + pg * Polynomial.C c₂ ^ 2))).coeff 2 = 0 := by
      have hm : (Polynomial.X ^ 2 * (ps * (pa * Polynomial.C c₁ ^ 2 + pb * Polynomial.C c₁ *
          Polynomial.C c₂ + pg * Polynomial.C c₂ ^ 2)) : Polynomial K) ∈ I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        show mk _ = 0
        rw [← h1]
        exact h0
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hm
      rw [hr, Polynomial.coeff_X_pow_mul']
      simp
    rw [Polynomial.coeff_X_pow_mul'] at h2
    simp only [le_refl, ite_true, Nat.sub_self] at h2
    rw [Polynomial.coeff_zero_eq_eval_zero] at h2
    simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_pow,
      Polynomial.eval_C] at h2
    rw [← Polynomial.coeff_zero_eq_eval_zero, ← Polynomial.coeff_zero_eq_eval_zero,
      ← Polynomial.coeff_zero_eq_eval_zero, ← Polynomial.coeff_zero_eq_eval_zero,
      P0 s ps hps.symm, P0 α pa hpa.symm, P0 β pb hpb.symm, P0 γ pg hpg.symm] at h2
    exact h2

  have hs' : Ideal.Quotient.mk Q s ≠ 0 := fun h => hs (Ideal.Quotient.eq_zero_iff_mem.mp h)
  have F : ∀ c₁ c₂ : B ⧸ Q, Ideal.Quotient.mk Q α * c₁ ^ 2 +
      Ideal.Quotient.mk Q β * c₁ * c₂ + Ideal.Quotient.mk Q γ * c₂ ^ 2 = 0 :=
    fun c₁ c₂ => (mul_eq_zero.mp (key (B ⧸ Q) (Ideal.Quotient.mk Q)
      (fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr hb) c₁ c₂)).resolve_left hs'
  have hα : Ideal.Quotient.mk Q α = 0 := by simpa using F 1 0
  have hγ : Ideal.Quotient.mk Q γ = 0 := by simpa using F 0 1
  have hβ : Ideal.Quotient.mk Q β = 0 := by
    have := F 1 1
    rw [hα, hγ] at this
    simpa using this
  exact ⟨Ideal.Quotient.eq_zero_iff_mem.mp hα, Ideal.Quotient.eq_zero_iff_mem.mp hβ,
    Ideal.Quotient.eq_zero_iff_mem.mp hγ⟩

theorem wcpa_dj_ncx_qnf_split_quadric (R : Type u) [CommRing R] (B : Type u) [CommRing B]
    [Algebra R B] (y₁ y₂ α β γ : B) (Q : Ideal B) [Q.IsPrime]
    (hy : (MvPolynomial.eval₂Hom (algebraMap R B) ![y₁, y₂]).Etale)
    (hy₁ : y₁ ∈ Q) (hy₂ : y₂ ∈ Q) (hαγ : α * γ ∈ Q) (hβ : β ∉ Q) :
    ∃ (C : Type u) (_ : CommRing C) (ι : B →+* C) (T₁ T₂ : C) (𝔔' : Ideal C),
      ι.Etale ∧ 𝔔'.IsPrime ∧ 𝔔'.comap ι = Q ∧ T₁ ∈ 𝔔' ∧ T₂ ∈ 𝔔' ∧
      T₁ * T₂ = ι (α * y₁ ^ 2 + β * y₁ * y₂ + γ * y₂ ^ 2) ∧
      (MvPolynomial.eval₂Hom (ι.comp (algebraMap R B)) ![T₁, T₂]).Etale :=
by
  classical
  have t_L8 : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (y₁ y₂ : S) (hy : (MvPolynomial.eval₂Hom (algebraMap R S) ![y₁, y₂]).Etale),
      ∃ b : Module.Basis (Fin 2) S (KaehlerDifferential R S),
        ∀ i, b i = KaehlerDifferential.D R S (![y₁, y₂] i) := by
    intro R _ S _ _ y₁ y₂ hy
    letI : Algebra (MvPolynomial (Fin 2) R) S :=
      (MvPolynomial.eval₂Hom (algebraMap R S) ![y₁, y₂]).toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 2) R) S := hy
    haveI : IsScalarTower R (MvPolynomial (Fin 2) R) S := IsScalarTower.of_algebraMap_eq (fun x => by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
    have hbc := KaehlerDifferential.isBaseChange_of_formallyEtale R (MvPolynomial (Fin 2) R) S
    refine ⟨hbc.basis (KaehlerDifferential.mvPolynomialBasis R (Fin 2)), fun i => ?_⟩
    rw [IsBaseChange.basis_apply, KaehlerDifferential.mvPolynomialBasis_apply,
      KaehlerDifferential.map_D, RingHom.algebraMap_toAlgebra, MvPolynomial.eval₂Hom_X']
  have t_smfp : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (y₁ y₂ : S) (hy : (MvPolynomial.eval₂Hom (algebraMap R S) ![y₁, y₂]).Etale),
      Algebra.FormallySmooth R S ∧ Algebra.FinitePresentation R S := by
    intro R _ S _ _ y₁ y₂ hy
    letI : Algebra (MvPolynomial (Fin 2) R) S :=
      (MvPolynomial.eval₂Hom (algebraMap R S) ![y₁, y₂]).toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin 2) R) S := hy
    haveI : IsScalarTower R (MvPolynomial (Fin 2) R) S := IsScalarTower.of_algebraMap_eq (fun x => by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C])
    exact ⟨Algebra.FormallySmooth.comp R (MvPolynomial (Fin 2) R) S,
      Algebra.FinitePresentation.trans R (MvPolynomial (Fin 2) R) S⟩
  have t_jac : ∀ (R : Type u) [CommRing R] (S : Type u) [CommRing S] [Algebra R S] (z₁ z₂ T₁ T₂ a b c d : S) (hz : (MvPolynomial.eval₂Hom (algebraMap R S) ![z₁, z₂]).Etale) (h₁ : KaehlerDifferential.D R S T₁ = a • KaehlerDifferential.D R S z₁ + b • KaehlerDifferential.D R S z₂) (h₂ : KaehlerDifferential.D R S T₂ = c • KaehlerDifferential.D R S z₁ + d • KaehlerDifferential.D R S z₂) (L : Type u) [CommRing L] [Algebra S L] [Algebra R L] [IsScalarTower R S L] [IsLocalization.Away (a * d - b * c) L],
