    exact (mul_eq_zero.mp this).resolve_left (pow_ne_zero _ htK)

  have p6 : ∀ (M : Type u) [Field M] [Algebra K M] [FiniteDimensional K M] [Algebra V M]
      [IsScalarTower V K M],
      ∀ b : Fin (Module.finrank K M) → M, (∀ j, IsIntegral V (b j)) →
      (∀ c : Fin (Module.finrank K M) → V, (∃ j, IsUnit (c j)) →
        (∑ j, algebraMap V M (c j) * b j) ≠ 0 ∧
