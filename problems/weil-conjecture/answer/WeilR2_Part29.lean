          Polynomial.zero_divByMonic]
      rwa [Polynomial.ker_mapRingHom, Ideal.mk_ker] at h2
    have claim : ∀ k : ℕ, ∀ y : Polynomial A, ∃ (ρ z δ : Polynomial A),
        ρ ∈ Polynomial.degreeLT A Nd ∧ y = ρ + (P + H) * z + δ ∧
        δ ∈ Ideal.map (Polynomial.C : A →+* Polynomial A) (J ^ k) := by
      intro k
      induction k with
      | zero =>
        intro y
        refine ⟨0, 0, y, Submodule.zero_mem _, by ring, ?_⟩
        rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]
        exact Submodule.mem_top
      | succ k ih =>
        intro y
        obtain ⟨ρ, z, δ, hρ, hy, hδ⟩ := ih y
        have hq := hdivI _ δ hδ
        have hρ' : δ %ₘ P' ∈ Polynomial.degreeLT A Nd := by
          rw [Polynomial.mem_degreeLT, ← hdegP']
          exact Polynomial.degree_modByMonic_lt _ hmon
        have hq2 : Polynomial.C (↑u⁻¹ : A) * (δ /ₘ P') ∈
            Ideal.map (Polynomial.C : A →+* Polynomial A) (J ^ k) :=
          Ideal.mul_mem_left _ _ hq
        have hHq : H * (Polynomial.C (↑u⁻¹ : A) * (δ /ₘ P')) ∈
            Ideal.map (Polynomial.C : A →+* Polynomial A) (J ^ (k + 1)) := by
          rw [pow_succ', Ideal.map_mul]
          exact Ideal.mul_mem_mul hHJ hq2
        refine ⟨ρ + δ %ₘ P', z + Polynomial.C (↑u⁻¹ : A) * (δ /ₘ P'),
          -(H * (Polynomial.C (↑u⁻¹ : A) * (δ /ₘ P'))), Submodule.add_mem _ hρ hρ', ?_,
          (Ideal.neg_mem_iff _).mpr hHq⟩
        have hd := Polynomial.modByMonic_add_div δ P'
        rw [hy]
        linear_combination (-1 : Polynomial A) * hd + (δ /ₘ P') * hP'def
    refine ⟨Nd, fun i => Polynomial.X ^ (i : ℕ), fun y => ?_⟩
    obtain ⟨ρ, z, δ, hρ, hy, hδ⟩ := claim K y
    have hδx : δ ∈ Ideal.span {Polynomial.C x} := by
      have h1 : Ideal.map (Polynomial.C : A →+* Polynomial A) (J ^ K) ≤
          Ideal.map (Polynomial.C : A →+* Polynomial A) (Ideal.span {x}) := Ideal.map_mono hK
      rw [Ideal.map_span, Set.image_singleton] at h1
      exact h1 hδ
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hδx
    have hρsum : ρ = ∑ i : Fin Nd, Polynomial.C (ρ.coeff i) * Polynomial.X ^ (i : ℕ) := by
      rw [Fin.sum_univ_eq_sum_range (fun i => Polynomial.C (ρ.coeff i) * Polynomial.X ^ i) Nd]
      by_cases h0 : ρ = 0
      · simp [h0]
      · have hlt : ρ.natDegree < Nd :=
          (Polynomial.natDegree_lt_iff_degree_lt h0).mpr (Polynomial.mem_degreeLT.mp hρ)
        conv_lhs => rw [Polynomial.as_sum_range' ρ Nd hlt]
        simp only [Polynomial.C_mul_X_pow_eq_monomial]
    refine ⟨fun i => ρ.coeff i, z, a, ?_⟩
    rw [hy, ← ha]
    linear_combination hρsum

  have s4a : ∀ (V : Type u) [CommRing V] (d : ℕ) (G : MvPolynomial (Fin (d + 1)) V), (∃ α : Fin (d + 1) →₀ ℕ, IsUnit (G.coeff α)) → ∃ (θ : Polynomial (MvPolynomial (Fin d) V) ≃ₐ[V] MvPolynomial (Fin (d + 1)) V) (P H : Polynomial (MvPolynomial (Fin d) V)), IsUnit P.leadingCoeff ∧ θ (P + H) = G ∧ ∀ n : ℕ, H.coeff n ∈ Ideal.map (MvPolynomial.C : V →+* MvPolynomial (Fin d) V) (Ideal.span {a : V | ∃ γ, G.coeff γ = a ∧ ¬ IsUnit a}) := by
    intro V _ d G hα
    rcases subsingleton_or_nontrivial V with hV | hV
    · refine ⟨(MvPolynomial.finSuccEquiv V d).symm, MvPolynomial.finSuccEquiv V d G, 0, ?_, ?_, ?_⟩
      · have h01 : (0 : MvPolynomial (Fin d) V) = 1 := by
          rw [← MvPolynomial.C_0, ← MvPolynomial.C_1, Subsingleton.elim (0 : V) 1]
        haveI := subsingleton_of_zero_eq_one h01
        exact isUnit_of_subsingleton _
      · rw [add_zero, AlgEquiv.symm_apply_apply]
      · intro n
        rw [Polynomial.coeff_zero]
        exact Ideal.zero_mem _
    obtain ⟨ρ, hρ1, hlt⟩ : ∃ ρ : ℕ, 0 < ρ ∧ ∀ β ∈ G.support, ∀ i, β i < ρ := by
      refine ⟨1 + ∑ β ∈ G.support, ∑ i, β i, by omega, fun β hβ i => ?_⟩
      have h1 : β i ≤ ∑ i, β i := Finset.single_le_sum (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
      have h2 : ∑ i, β i ≤ ∑ β ∈ G.support, ∑ i, β i :=
        Finset.single_le_sum (f := fun β : Fin (d + 1) →₀ ℕ => ∑ i, β i) (fun _ _ => Nat.zero_le _) hβ
      omega
    have hinjgen : ∀ (n : ℕ) (f g : Fin n → ℕ), (∀ i, f i < ρ) → (∀ i, g i < ρ) →
        ∑ i, f i * ρ ^ (i : ℕ) = ∑ i, g i * ρ ^ (i : ℕ) → f = g := by
      intro n
      induction n with
      | zero => intro f g _ _ _; funext i; exact Fin.elim0 i
      | succ n ih =>
        intro f g hf hg hfg
        rw [Fin.sum_univ_succ, Fin.sum_univ_succ] at hfg
        have e1 : ∀ h : Fin (n + 1) → ℕ, ∑ i : Fin n, h i.succ * ρ ^ ((i.succ : Fin (n + 1)) : ℕ) =
            ρ * ∑ i : Fin n, h i.succ * ρ ^ (i : ℕ) := by
          intro h
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun i _ => by rw [Fin.val_succ, pow_succ]; ring)
        rw [e1 f, e1 g] at hfg
        simp only [Fin.val_zero, pow_zero, mul_one] at hfg
        have h0 : f 0 = g 0 := by
          have h3 := congrArg (· % ρ) hfg
          simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hf 0), Nat.mod_eq_of_lt (hg 0)] at h3
          exact h3
        have hs : ∑ i : Fin n, f i.succ * ρ ^ (i : ℕ) = ∑ i : Fin n, g i.succ * ρ ^ (i : ℕ) := by
          have h3 := congrArg (· / ρ) hfg
          simp only [Nat.add_mul_div_left _ _ hρ1, Nat.div_eq_of_lt (hf 0), Nat.div_eq_of_lt (hg 0),
            zero_add] at h3
          exact h3
        have hrest := ih (fun i => f i.succ) (fun i => g i.succ) (fun i => hf _) (fun i => hg _) hs
        funext i
        refine Fin.cases h0 (fun j => ?_) i
        exact congrFun hrest j
    obtain ⟨w, hw⟩ : ∃ w : (Fin (d + 1) →₀ ℕ) → ℕ, ∀ β, w β = ∑ i, β i * ρ ^ (i : ℕ) :=
      ⟨_, fun β => rfl⟩
    have winj : ∀ β ∈ G.support, ∀ γ ∈ G.support, w β = w γ → β = γ := by
      intro β hβ γ hγ h
      rw [hw, hw] at h
      have h3 := hinjgen (d + 1) (fun i => β i) (fun i => γ i) (hlt β hβ) (hlt γ hγ) h
      exact Finsupp.ext (fun i => congrFun h3 i)
    obtain ⟨sF, hs0, hss⟩ : ∃ sF : Fin (d + 1) → MvPolynomial (Fin (d + 1)) V,
        sF 0 = MvPolynomial.X 0 ∧ ∀ j : Fin d,
          sF j.succ = MvPolynomial.X j.succ + MvPolynomial.X 0 ^ (ρ ^ ((j : ℕ) + 1)) :=
      ⟨fun i => Fin.cases (MvPolynomial.X 0)
        (fun j => MvPolynomial.X j.succ + MvPolynomial.X 0 ^ (ρ ^ ((j : ℕ) + 1))) i, rfl, fun j => rfl⟩
    obtain ⟨tF, ht0, hts⟩ : ∃ tF : Fin (d + 1) → MvPolynomial (Fin (d + 1)) V,
        tF 0 = MvPolynomial.X 0 ∧ ∀ j : Fin d,
          tF j.succ = MvPolynomial.X j.succ - MvPolynomial.X 0 ^ (ρ ^ ((j : ℕ) + 1)) :=
      ⟨fun i => Fin.cases (MvPolynomial.X 0)
        (fun j => MvPolynomial.X j.succ - MvPolynomial.X 0 ^ (ρ ^ ((j : ℕ) + 1))) i, rfl, fun j => rfl⟩
    obtain ⟨σ, hσ⟩ : ∃ σ : MvPolynomial (Fin (d + 1)) V →ₐ[V] MvPolynomial (Fin (d + 1)) V,
        ∀ i, σ (MvPolynomial.X i) = sF i := ⟨MvPolynomial.aeval sF, fun i => MvPolynomial.aeval_X _ _⟩
    obtain ⟨τ, hτ⟩ : ∃ τ : MvPolynomial (Fin (d + 1)) V →ₐ[V] MvPolynomial (Fin (d + 1)) V,
        ∀ i, τ (MvPolynomial.X i) = tF i := ⟨MvPolynomial.aeval tF, fun i => MvPolynomial.aeval_X _ _⟩
    have hστ : σ.comp τ = AlgHom.id V _ := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · rw [AlgHom.comp_apply, hτ, ht0, hσ, hs0, AlgHom.id_apply]
      · rw [AlgHom.comp_apply, hτ, hts, map_sub, map_pow, hσ, hσ, hs0, hss, AlgHom.id_apply,
          add_sub_cancel_right]
    have hτσ : τ.comp σ = AlgHom.id V _ := by
      apply MvPolynomial.algHom_ext
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · rw [AlgHom.comp_apply, hσ, hs0, hτ, ht0, AlgHom.id_apply]
      · rw [AlgHom.comp_apply, hσ, hss, map_add, map_pow, hτ, hτ, ht0, hts, AlgHom.id_apply,
          sub_add_cancel]
    obtain ⟨θ, hθs⟩ : ∃ θ : Polynomial (MvPolynomial (Fin d) V) ≃ₐ[V] MvPolynomial (Fin (d + 1)) V,
        ∀ x, θ.symm x = MvPolynomial.finSuccEquiv V d (σ x) :=
      ⟨((AlgEquiv.ofAlgHom σ τ hστ hτσ).trans (MvPolynomial.finSuccEquiv V d)).symm, fun x => rfl⟩
    have hgm : ∀ i, (MvPolynomial.finSuccEquiv V d (sF i)).Monic ∧
        (MvPolynomial.finSuccEquiv V d (sF i)).natDegree = ρ ^ (i : ℕ) := by
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · rw [hs0, MvPolynomial.finSuccEquiv_X_zero, Fin.val_zero, pow_zero]
        exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
      · rw [hss, map_add, map_pow, MvPolynomial.finSuccEquiv_X_succ, MvPolynomial.finSuccEquiv_X_zero,
          add_comm, Fin.val_succ]
        exact ⟨Polynomial.monic_X_pow_add_C _ (pow_ne_zero _ hρ1.ne'), Polynomial.natDegree_X_pow_add_C⟩
    obtain ⟨M, hMdef⟩ : ∃ M : (Fin (d + 1) →₀ ℕ) → Polynomial (MvPolynomial (Fin d) V),
        ∀ β, M β = ∏ i, (MvPolynomial.finSuccEquiv V d (sF i)) ^ (β i) := ⟨_, fun β => rfl⟩
    have hMm : ∀ β, (M β).Monic := by
      intro β
      rw [hMdef]
      exact Polynomial.monic_prod_of_monic _ _ (fun i _ => (hgm i).1.pow _)
    have hMd : ∀ β, (M β).natDegree = w β := by
      intro β
      rw [hMdef, Polynomial.natDegree_prod_of_monic _ _ (fun i _ => (hgm i).1.pow _), hw]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [(hgm i).1.natDegree_pow, (hgm i).2]
    have hcomp : (MvPolynomial.finSuccEquiv V d).toAlgHom.comp σ =
        MvPolynomial.aeval (fun i => MvPolynomial.finSuccEquiv V d (sF i)) := by
      apply MvPolynomial.algHom_ext
      intro i
      show MvPolynomial.finSuccEquiv V d (σ (MvPolynomial.X i)) = _
      rw [hσ, MvPolynomial.aeval_X]
    have hmono : ∀ β c, MvPolynomial.finSuccEquiv V d (σ (MvPolynomial.monomial β c)) =
        Polynomial.C (MvPolynomial.C c) * M β := by
      intro β c
      have h1 : MvPolynomial.finSuccEquiv V d (σ (MvPolynomial.monomial β c)) =
          ((MvPolynomial.finSuccEquiv V d).toAlgHom.comp σ) (MvPolynomial.monomial β c) := rfl
      rw [h1, hcomp, MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun i => pow_zero _), hMdef,
        Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
    have hΦG : MvPolynomial.finSuccEquiv V d (σ G) =
        ∑ β ∈ G.support, Polynomial.C (MvPolynomial.C (G.coeff β)) * M β := by
      conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff G]
      rw [map_sum, map_sum]
      exact Finset.sum_congr rfl (fun β _ => hmono β _)
    obtain ⟨α, hαu⟩ := hα
    have hαU : α ∈ G.support.filter (fun β => IsUnit (G.coeff β)) :=
      Finset.mem_filter.mpr ⟨MvPolynomial.mem_support_iff.mpr hαu.ne_zero, hαu⟩
    obtain ⟨b, hbU, hbmax⟩ := Finset.exists_max_image (G.support.filter (fun β => IsUnit (G.coeff β))) w
      ⟨α, hαU⟩
    have hbS : b ∈ G.support := (Finset.mem_filter.mp hbU).1
    have hbu : IsUnit (G.coeff b) := (Finset.mem_filter.mp hbU).2
    refine ⟨θ, ∑ β ∈ G.support.filter (fun β => IsUnit (G.coeff β)),
        Polynomial.C (MvPolynomial.C (G.coeff β)) * M β,
      ∑ β ∈ G.support.filter (fun β => ¬ IsUnit (G.coeff β)),
        Polynomial.C (MvPolynomial.C (G.coeff β)) * M β, ?_, ?_, ?_⟩
    · rw [← Finset.add_sum_erase _ _ hbU]
      have hCb : MvPolynomial.C (G.coeff b) ≠ (0 : MvPolynomial (Fin d) V) :=
        fun h => hbu.ne_zero (MvPolynomial.C_eq_zero.mp h)
      have hdeg_b : (Polynomial.C (MvPolynomial.C (G.coeff b)) * M b).degree = (w b : WithBot ℕ) := by
        rw [Polynomial.Monic.degree_mul (hMm b), Polynomial.degree_C hCb, zero_add,
          Polynomial.degree_eq_natDegree (hMm b).ne_zero, hMd b]
      have hlc_b : (Polynomial.C (MvPolynomial.C (G.coeff b)) * M b).leadingCoeff =
          MvPolynomial.C (G.coeff b) := by
        rw [Polynomial.leadingCoeff_mul_monic (hMm b), Polynomial.leadingCoeff_C]
      have hdegQ : (∑ β ∈ (G.support.filter (fun β => IsUnit (G.coeff β))).erase b,
          Polynomial.C (MvPolynomial.C (G.coeff β)) * M β).degree < (w b : WithBot ℕ) := by
        refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
        rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
        intro β hβ
        obtain ⟨hβb, hβU⟩ := Finset.mem_erase.mp hβ
        have hβS := (Finset.mem_filter.mp hβU).1
        have hwlt : w β < w b := lt_of_le_of_ne (hbmax β hβU) (fun h => hβb (winj β hβS b hbS h))
        refine lt_of_le_of_lt (Polynomial.degree_mul_le _ _) ?_
        refine lt_of_le_of_lt (add_le_add Polynomial.degree_C_le le_rfl) ?_
        rw [zero_add, Polynomial.degree_eq_natDegree (hMm β).ne_zero, hMd β]
        exact_mod_cast hwlt
      rw [Polynomial.leadingCoeff_add_of_degree_lt' (by rw [hdeg_b]; exact hdegQ), hlc_b]
      exact hbu.map MvPolynomial.C
    · rw [Finset.sum_filter_add_sum_filter_not, ← hΦG, ← hθs, AlgEquiv.apply_symm_apply]
    · intro n
      rw [Polynomial.finsetSum_coeff]
      refine Ideal.sum_mem _ (fun β hβ => ?_)
      rw [Polynomial.coeff_C_mul]
      exact Ideal.mul_mem_right _ _
        (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨β, rfl, (Finset.mem_filter.mp hβ).2⟩))

  have s5 : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (r : R) (s : S), ψ r = s →
      ∃ φ : AdicCompletion (Ideal.span {r}) R →+* AdicCompletion (Ideal.span {s}) S,
        ∀ p : R, φ (algebraMap R (AdicCompletion (Ideal.span {r}) R) p) =
          algebraMap S (AdicCompletion (Ideal.span {s}) S) (ψ p) := by
    intro R S _ _ ψ r s hrs
    have hle : ∀ n : ℕ, Ideal.span {r} ^ n ≤ Ideal.comap ψ (Ideal.span {s} ^ n) := by
      intro n
      rw [Ideal.span_singleton_pow, Ideal.span_le, Set.singleton_subset_iff]
      show ψ (r ^ n) ∈ Ideal.span {s} ^ n
      rw [map_pow, hrs]
      exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self s) n
    let f : ∀ n : ℕ, AdicCompletion (Ideal.span {r}) R →+* S ⧸ Ideal.span {s} ^ n := fun n =>
      (Ideal.quotientMap (Ideal.span {s} ^ n) ψ (hle n)).comp
        (AdicCompletion.evalₐ (Ideal.span {r}) n).toRingHom
    have hf : ∀ {m n : ℕ} (hmn : m ≤ n),
        (Ideal.Quotient.factorPow (Ideal.span {s}) hmn).comp (f n) = f m := by
      intro m n hmn
      refine RingHom.ext fun x => ?_
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {r}) R x
      simp only [f, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        AdicCompletion.evalₐ_mk, Ideal.quotientMap_mk]
      have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn a
      rw [Submodule.Quotient.eq] at h1
      have h2 : (a : ℕ → R) n - (a : ℕ → R) m ∈ Ideal.span {r} ^ m := by
        have h3 : Ideal.span {r} ^ m • (⊤ : Submodule R R) ≤ Ideal.span {r} ^ m := by
          rw [smul_eq_mul, Ideal.mul_top]
        exact h3 h1
      have h4 : ψ ((a : ℕ → R) n) - ψ ((a : ℕ → R) m) ∈ Ideal.span {s} ^ m := by
        rw [← map_sub]; exact hle m h2
      rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      exact h4
    refine ⟨AdicCompletion.liftRingHom (Ideal.span {s}) f hf, fun p => ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [AdicCompletion.evalₐ_liftRingHom]
    simp only [f, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      AdicCompletion.evalₐ_of, Ideal.quotientMap_mk]

  have s6 : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S) (t : R),
      (∀ f : ℕ → R, (∀ n : ℕ, ∃ y : R, f (n + 1) - f n = t ^ n * y) →
        ∃ L : R, ∀ n : ℕ, ∃ y : R, L - f n = t ^ n * y) →
      (∀ f : ℕ → S, (∀ n : ℕ, ∃ y : S, f (n + 1) - f n = φ t ^ n * y) →
        ∃ L : S, ∀ n : ℕ, ∃ y : S, L - f n = φ t ^ n * y) →
      (∀ x : S, (∀ k : ℕ, ∃ y : S, x = φ t ^ k * y) → x = 0) →
      ∀ (g : S) (N : ℕ) (e : Fin N → S),
      (∀ y : S, ∃ (r : Fin N → R) (z w : S), y = ∑ i, φ (r i) * e i + g * z + φ t * w) →
      ∀ y : S, ∃ (r : Fin N → R) (z : S), y = ∑ i, φ (r i) * e i + g * z := by
    intro R S _ _ φ t hR hS hH g N e hrep y
    choose ρ ζ ω hω using hrep
    let wseq : ℕ → S := fun n => Nat.rec y (fun _ v => ω v) n
    have hw0 : wseq 0 = y := rfl
    have hws : ∀ n, wseq (n + 1) = ω (wseq n) := fun n => rfl
    let A : Fin N → ℕ → R := fun i n => ∑ j ∈ Finset.range n, t ^ j * ρ (wseq j) i
    let Z : ℕ → S := fun n => ∑ j ∈ Finset.range n, φ t ^ j * ζ (wseq j)
    have hA : ∀ i n, A i (n + 1) = A i n + t ^ n * ρ (wseq n) i := by
      intro i n; simp only [A, Finset.sum_range_succ]
    have hZ : ∀ n, Z (n + 1) = Z n + φ t ^ n * ζ (wseq n) := by
      intro n; simp only [Z, Finset.sum_range_succ]
    have hA0 : ∀ i, A i 0 = 0 := by intro i; simp only [A, Finset.sum_range_zero]
    have hZ0 : Z 0 = 0 := by simp only [Z, Finset.sum_range_zero]
    have hinv : ∀ n, y = ∑ i, φ (A i n) * e i + g * Z n + φ t ^ n * wseq n := by
      intro n
      induction n with
      | zero =>
        simp only [hA0, hZ0, map_zero, zero_mul, Finset.sum_const_zero, mul_zero, zero_add,
          pow_zero, one_mul, hw0]
      | succ n ih =>
        have h1 := hω (wseq n)
        have eS : ∑ i, φ (A i (n + 1)) * e i =
            ∑ i, φ (A i n) * e i + φ t ^ n * ∑ i, φ (ρ (wseq n) i) * e i := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [hA i n, map_add, map_mul, map_pow]
          ring
        rw [eS, hZ, hws]
        linear_combination ih + φ t ^ n * h1
    have hAlim : ∀ i, ∃ L : R, ∀ n, ∃ y' : R, L - A i n = t ^ n * y' := by
      intro i
      apply hR
      intro n
      exact ⟨ρ (wseq n) i, by rw [hA i n]; ring⟩
