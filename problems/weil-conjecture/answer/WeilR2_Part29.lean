      obtain ⟨c2, h2⟩ := hQ
      refine ⟨fun e => c1 e + c2 e, ?_⟩
      rw [h1, h2, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun e _ => ?_
      rw [add_pow_char, add_mul]
