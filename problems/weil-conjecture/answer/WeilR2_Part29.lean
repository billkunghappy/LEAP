      haveI : Nonempty (Fin (Module.finrank K M)) := ⟨⟨0, Module.finrank_pos⟩⟩
      set B := basisOfLinearIndependentOfCardEqFinrank hli (by simp) with hB
      obtain ⟨Nn, v, hv⟩ := h2 _ (fun i => B.repr x i)
      refine ⟨Nn, ?_⟩
      rw [Submodule.mem_span_range_iff_exists_fun]
      refine ⟨v, ?_⟩
      conv_rhs => rw [← B.sum_repr x]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def, Algebra.smul_def, hVM, ← hv i, map_mul, map_pow, ← hVM, mul_assoc, hB,
