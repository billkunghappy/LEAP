    have hc0 : algebraMap B Q.ResidueField c = 0 := by
      rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
      exact hc
    have hmap : P.HasMap (algebraMap B Q.ResidueField β) := by
      constructor
