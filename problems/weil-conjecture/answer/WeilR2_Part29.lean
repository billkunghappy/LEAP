      show ((φ a : S) : R) = a ^ p
      rw [hφ, RingHom.coe_rangeRestrict, frobenius_def]
    haveI : IsNoetherianRing S := isNoetherianRing_of_surjective R S φ hφsurj
    haveI : Module.Finite S R := by
      obtain ⟨m, g, hg⟩ := hF
      refine ⟨⟨Finset.univ.image g, ?_⟩⟩
      rw [eq_top_iff]
      intro r _
      obtain ⟨c, hc⟩ := hg r
      rw [hc]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      have e : c i ^ p * g i = φ (c i) • g i := by
        rw [Algebra.smul_def, hφv]
      rw [e]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
    set J : Ideal S := Ideal.map φ I with hJ
    set N : Submodule S R := LinearMap.range (Algebra.linearMap S R) with hN
    obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul J N
    refine ⟨k, fun n hn x hx => ?_⟩
    have hJpow : ∀ j, J ^ j = Ideal.map φ (I ^ j) := fun j => by rw [hJ, Ideal.map_pow]
    have hc : x ^ p ∈ J ^ n • (⊤ : Submodule S R) := by
      rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
      refine (Ideal.span_le.mpr ?_) hx
      rintro _ ⟨a, ha, rfl⟩
      show a ^ p ∈ Ideal.map (algebraMap S R) (J ^ n)
      rw [← hφv a]
      exact Ideal.mem_map_of_mem _ (by rw [hJpow]; exact Ideal.mem_map_of_mem _ ha)
    have hd : x ^ p ∈ N := ⟨φ x, by rw [Algebra.linearMap_apply]; exact hφv x⟩
    have he : x ^ p ∈ J ^ (n - k) • N := by
      have h1 : x ^ p ∈ J ^ n • (⊤ : Submodule S R) ⊓ N := ⟨hc, hd⟩
      rw [hk n hn] at h1
      exact Submodule.smul_mono le_rfl inf_le_right h1
    have hf : ∀ z ∈ J ^ (n - k) • N, ∃ y ∈ J ^ (n - k), z = algebraMap S R y := by
      intro z hz
      refine Submodule.smul_induction_on (p := fun z => ∃ y ∈ J ^ (n - k), z = algebraMap S R y)
        hz ?_ ?_
      · intro s hs w hw
        obtain ⟨t, rfl⟩ := hw
        refine ⟨s * t, Ideal.mul_mem_right _ _ hs, ?_⟩
        rw [Algebra.linearMap_apply, Algebra.smul_def, map_mul]
      · rintro z₁ z₂ ⟨y₁, hy₁, rfl⟩ ⟨y₂, hy₂, rfl⟩
        exact ⟨y₁ + y₂, Ideal.add_mem _ hy₁ hy₂, (map_add _ _ _).symm⟩
    obtain ⟨y, hy, hxy⟩ := hf _ he
    rw [hJpow] at hy
    obtain ⟨a, ha, rfl⟩ := (Ideal.mem_map_iff_of_surjective φ hφsurj).mp hy
    have hfr : frobenius R p x = frobenius R p a := by
      rw [frobenius_def, frobenius_def, hxy, hφv]
    rw [frobenius_inj R p hfr]
    exact ha

  obtain ⟨k, hk⟩ := hcontr
  rw [isReduced_iff_pow_one_lt p hp1]
  intro ξ hξ
  obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I R ξ
  have hcau : ∀ {m n : ℕ}, m ≤ n → f.1 m - f.1 n ∈ I ^ m := by
    intro m n hmn
    have h := f.2 hmn
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] at h
    exact h
  have hlev : ∀ N, (f.1 N) ^ p ∈ I ^ N := by
    intro N
    have h := congrArg (AdicCompletion.evalₐ I N) hξ
    rw [map_pow, AdicCompletion.evalₐ_mk, map_zero, ← map_pow,
      Ideal.Quotient.eq_zero_iff_mem] at h
    exact h
  have hQ : ∀ n, (f.1 n) ^ p ∈ Ideal.span ((fun a : R => a ^ p) '' ((I ^ n : Ideal R) : Set R)) := by
    intro n
    obtain ⟨N₀, hN₀⟩ := hcof n
    have h1 : (f.1 (max N₀ n)) ^ p ∈
        Ideal.span ((fun a : R => a ^ p) '' ((I ^ n : Ideal R) : Set R)) :=
      hN₀ (Ideal.pow_le_pow_right (le_max_left _ _) (hlev _))
    have h2 : (f.1 n - f.1 (max N₀ n)) ^ p ∈
        Ideal.span ((fun a : R => a ^ p) '' ((I ^ n : Ideal R) : Set R)) :=
      Ideal.subset_span ⟨_, hcau (le_max_right _ _), rfl⟩
    rw [sub_pow_char] at h2
    have h3 := Ideal.add_mem _ h2 h1
    rwa [sub_add_cancel] at h3
  apply AdicCompletion.ext_evalₐ
  intro j
  rw [AdicCompletion.evalₐ_mk, map_zero, Ideal.Quotient.eq_zero_iff_mem]
  have h1 : f.1 (j + k) ∈ I ^ j := by
    have h := hk (j + k) (Nat.le_add_left k j) _ (hQ (j + k))
    rwa [Nat.add_sub_cancel] at h
  have h2 := hcau (Nat.le_add_right j k)
  have h3 := Ideal.add_mem _ h2 h1
  rwa [sub_add_cancel] at h3

theorem wcpa_dj_lr1s_au_minimal_prime_reduction : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R], _root_.IsReduced R → ∀ (I : Ideal R), (∀ 𝔮 ∈ minimalPrimes R, _root_.IsReduced (AdicCompletion (Ideal.map (Ideal.Quotient.mk 𝔮) I) (R ⧸ 𝔮))) → _root_.IsReduced (AdicCompletion I R) :=
by
  intro R _ _ hred I hyp
  classical

  have s1 : ∀ (x : AdicCompletion I R) (m n : ℕ) (r : R), m ≤ n →
      AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) r →
      AdicCompletion.evalₐ I m x = Ideal.Quotient.mk (I ^ m) r := by
    intro x m n r hmn hx
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I R x
    rw [AdicCompletion.evalₐ_mk] at hx ⊢
    have h1 : s.val n - r ∈ I ^ n := Ideal.Quotient.eq.mp hx
    have h2 := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn s
    rw [Submodule.Quotient.eq] at h2
    have h2' : s.val n - s.val m ∈ I ^ m := by
      have e : I ^ m • (⊤ : Submodule R R) = I ^ m := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      rw [e] at h2
      exact h2
    rw [Ideal.Quotient.eq]
    have h3 : s.val n - r ∈ I ^ m := Ideal.pow_le_pow_right hmn h1
    have h4 := (I ^ m).sub_mem h3 h2'
    have e : s.val n - r - (s.val n - s.val m) = s.val m - r := by ring
    rw [e] at h4
    exact h4

  have s2 : ∀ q : Ideal R, ∃ ρ : AdicCompletion I R →+*
      AdicCompletion (Ideal.map (Ideal.Quotient.mk q) I) (R ⧸ q),
      ∀ (n : ℕ) (x : AdicCompletion I R) (r : R),
        AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) r →
        AdicCompletion.evalₐ (Ideal.map (Ideal.Quotient.mk q) I) n (ρ x) =
          Ideal.Quotient.mk (Ideal.map (Ideal.Quotient.mk q) I ^ n) (Ideal.Quotient.mk q r) := by
    intro q
    set J := Ideal.map (Ideal.Quotient.mk q) I with hJ
    have H : ∀ n : ℕ, I ^ n ≤ Ideal.comap (Ideal.Quotient.mk q) (J ^ n) := by
      intro n
      rw [hJ, ← Ideal.map_pow]
      exact Ideal.le_comap_map
    let f : (n : ℕ) → AdicCompletion I R →+* (R ⧸ q) ⧸ J ^ n := fun n =>
      (Ideal.quotientMap (J ^ n) (Ideal.Quotient.mk q) (H n)).comp
        (AdicCompletion.evalₐ I n : AdicCompletion I R →+* R ⧸ I ^ n)
    have hfx : ∀ (n : ℕ) (x : AdicCompletion I R) (r : R),
        AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) r →
        f n x = Ideal.Quotient.mk (J ^ n) (Ideal.Quotient.mk q r) := by
      intro n x r h
      show Ideal.quotientMap (J ^ n) (Ideal.Quotient.mk q) (H n) (AdicCompletion.evalₐ I n x) = _
      rw [h, Ideal.quotientMap_mk]
    have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp (f n) = f m := by
      intro m n hle
      ext x
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n x)
      rw [RingHom.comp_apply, hfx n x r hr.symm, hfx m x r (s1 x m n r hle hr.symm)]
      rfl
    exact ⟨AdicCompletion.liftRingHom J f hf, fun n x r h => by
      rw [AdicCompletion.evalₐ_liftRingHom]; exact hfx n x r h⟩

  have s3 : ∀ (Q : Set (Ideal R)), Q.Finite → sInf Q = ⊥ → ∃ k : ℕ, ∀ n : ℕ, k ≤ n →
      ∀ x : R, (∀ q ∈ Q, x ∈ I ^ n ⊔ q) → x ∈ I ^ (n - k) := by
    intro Q hQ hQ0
    haveI : Finite Q := hQ.to_subtype
    haveI : Fintype Q := Fintype.ofFinite Q
    let φ : R →ₗ[R] ((q : Q) → R ⧸ (q : Ideal R)) :=
      LinearMap.pi (fun q : Q => (Ideal.Quotient.mkₐ R (q : Ideal R)).toLinearMap)
    have hφ : ∀ (x : R) (q : Q), φ x q = Ideal.Quotient.mk (q : Ideal R) x := fun x q => rfl
    have hinj : ∀ x, φ x = 0 → x = 0 := by
      intro x hx
      have hmem : x ∈ sInf Q := by
        rw [Submodule.mem_sInf]
        intro q hq
        have h := congrFun hx ⟨q, hq⟩
        rw [hφ, Pi.zero_apply] at h
        exact Ideal.Quotient.eq_zero_iff_mem.mp h
      rw [hQ0] at hmem
      exact hmem
    obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul I (LinearMap.range φ)
    refine ⟨k, fun n hn x hx => ?_⟩
    have hmem : φ x ∈ I ^ n • (⊤ : Submodule R ((q : Q) → R ⧸ (q : Ideal R))) := by
      choose a ha b hb hab using fun q : Q => Submodule.mem_sup.mp (hx q q.2)
      have hsum : φ x = ∑ q : Q, a q • Pi.single q (1 : R ⧸ (q : Ideal R)) := by
        funext q₀
        rw [Finset.sum_apply, Finset.sum_eq_single q₀]
        · rw [Pi.smul_apply, Pi.single_eq_same, hφ, ← hab q₀, map_add,
            Ideal.Quotient.eq_zero_iff_mem.mpr (hb q₀), add_zero,
            ← Algebra.algebraMap_eq_smul_one, Ideal.Quotient.algebraMap_eq]
        · intro q _ hq
          rw [Pi.smul_apply, Pi.single_eq_of_ne (Ne.symm hq), smul_zero]
        · intro h
          exact absurd (Finset.mem_univ q₀) h
      rw [hsum]
      exact Submodule.sum_mem _ (fun q _ => Submodule.smul_mem_smul (ha q) Submodule.mem_top)
    have h1 : φ x ∈ I ^ n • ⊤ ⊓ LinearMap.range φ :=
      Submodule.mem_inf.mpr ⟨hmem, LinearMap.mem_range_self φ x⟩
    rw [hk n hn] at h1
    have h2 : φ x ∈ I ^ (n - k) • LinearMap.range φ := Submodule.smul_mono le_rfl inf_le_right h1
    rw [LinearMap.range_eq_map, ← Submodule.map_smul''] at h2
    obtain ⟨y, hy, hyx⟩ := (Submodule.mem_map).mp h2
    have hxy : x = y := by
      have h := hinj (x - y) (by rw [map_sub, hyx, sub_self])
      exact sub_eq_zero.mp h
    rw [hxy]
    have e : I ^ (n - k) • (⊤ : Submodule R R) = I ^ (n - k) := by
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
    rw [e] at hy
    exact hy

  refine ⟨fun ξ hξ => ?_⟩
  have hQfin : (minimalPrimes R).Finite := minimalPrimes.finite_of_isNoetherianRing R
  have hQ0 : sInf (minimalPrimes R) = ⊥ := by
    have e : minimalPrimes R = (⊥ : Ideal R).minimalPrimes := rfl
    rw [e, Ideal.sInf_minimalPrimes]
    haveI := hred
    exact Ideal.radical_bot_of_isReduced
  obtain ⟨k, hk⟩ := s3 _ hQfin hQ0
  choose r hr using fun n => Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n ξ)
  have hcomp : ∀ n, ∀ q ∈ minimalPrimes R, r n ∈ I ^ n ⊔ q := by
    intro n q hq
    obtain ⟨ρ, hρ⟩ := s2 q
    have h0 : ρ ξ = 0 := (hyp q hq).eq_zero _ (hξ.map ρ)
    have h1 := hρ n ξ (r n) (hr n).symm
    rw [h0, map_zero] at h1
    have h2 : Ideal.Quotient.mk q (r n) ∈ Ideal.map (Ideal.Quotient.mk q) I ^ n :=
      Ideal.Quotient.eq_zero_iff_mem.mp h1.symm
    rw [← Ideal.map_pow] at h2
    have h3 : r n ∈ Ideal.comap (Ideal.Quotient.mk q) (Ideal.map (Ideal.Quotient.mk q) (I ^ n)) := h2
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker] at h3
    exact h3
  apply AdicCompletion.ext_evalₐ
  intro m
  have h1 := hk (m + k) (Nat.le_add_left k m) (r (m + k)) (hcomp (m + k))
  rw [Nat.add_sub_cancel] at h1
  rw [map_zero, s1 ξ m (m + k) (r (m + k)) (Nat.le_add_right m k) (hr (m + k)).symm]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr h1

theorem wcpa_dj_lr1s_au_poly_completion_domain : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : ℕ) (𝔭 : Ideal (MvPolynomial (Fin s) K)), 𝔭.IsMaximal → IsDomain (AdicCompletion 𝔭 (MvPolynomial (Fin s) K)) :=
by
  intro K _ _ s 𝔭 h𝔭

  have c_abs : ∀ (I : Ideal (MvPolynomial (Fin s) K)), I ≠ ⊤ →
      (∀ (a b : MvPolynomial (Fin s) K) (p q : ℕ), a ∈ I ^ p → a ∉ I ^ (p + 1) → b ∈ I ^ q →
        b ∉ I ^ (q + 1) → a * b ∉ I ^ (p + q + 1)) →
      IsDomain (AdicCompletion I (MvPolynomial (Fin s) K)) := by
    intro I hI hGD
    have hmem : ∀ (n : ℕ) (x : MvPolynomial (Fin s) K),
        (Ideal.Quotient.mk (I ^ n • ⊤ : Ideal (MvPolynomial (Fin s) K)) x = 0 ↔ x ∈ I ^ n) := by
      intro n x
      rw [Ideal.Quotient.eq_zero_iff_mem, smul_eq_mul, Ideal.mul_top]
    have hlift : ∀ (ξ : AdicCompletion I (MvPolynomial (Fin s) K)) (n : ℕ),
        ∃ x : MvPolynomial (Fin s) K,
          Ideal.Quotient.mk (I ^ n • ⊤ : Ideal (MvPolynomial (Fin s) K)) x = ξ.val n :=
      fun ξ n => Ideal.Quotient.mk_surjective _
    have hlev : ∀ (ξ : AdicCompletion I (MvPolynomial (Fin s) K)) {m n : ℕ} (hmn : m ≤ n)
        (x : MvPolynomial (Fin s) K),
        Ideal.Quotient.mk (I ^ n • ⊤ : Ideal (MvPolynomial (Fin s) K)) x = ξ.val n →
        Ideal.Quotient.mk (I ^ m • ⊤ : Ideal (MvPolynomial (Fin s) K)) x = ξ.val m := by
      intro ξ m n hmn x hx
      rw [← AdicCompletion.transitionMap_ideal_mk I hmn, hx,
        AdicCompletion.transitionMap_comp_eval_apply]
    have hord : ∀ ξ : AdicCompletion I (MvPolynomial (Fin s) K), ξ ≠ 0 → ∃ p : ℕ, ∀ N, p + 1 ≤ N →
        ∀ x : MvPolynomial (Fin s) K,
          Ideal.Quotient.mk (I ^ N • ⊤ : Ideal (MvPolynomial (Fin s) K)) x = ξ.val N →
          x ∈ I ^ p ∧ x ∉ I ^ (p + 1) := by
      intro ξ hξ
      have hex : ∃ n, ξ.val n ≠ 0 := by
        by_contra h
        push_neg at h
        exact hξ (AdicCompletion.ext (fun n => by rw [h n]; rfl))
      classical
      have hspec : ξ.val (Nat.find hex) ≠ 0 := Nat.find_spec hex
      have hn₀0 : Nat.find hex ≠ 0 := by
        intro h0
        apply hspec
        obtain ⟨y, hy⟩ := hlift ξ (Nat.find hex)
        rw [← hy, hmem, h0, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      obtain ⟨p, hp⟩ := Nat.exists_eq_succ_of_ne_zero hn₀0
      refine ⟨p, fun N hN x hx => ⟨?_, ?_⟩⟩
      · have hmin : ξ.val p = 0 := by
          have := Nat.find_min hex (show p < Nat.find hex by omega)
          push_neg at this
          exact this
        rw [← hmem, hlev ξ (by omega) x hx, hmin]
      · rw [← hmem, hlev ξ hN x hx]
        rw [hp] at hspec
        exact hspec
    haveI : Nontrivial (AdicCompletion I (MvPolynomial (Fin s) K)) := by
      refine ⟨⟨0, 1, fun h => hI ?_⟩⟩
      have h1 := congrArg (fun ξ : AdicCompletion I (MvPolynomial (Fin s) K) => ξ.val 1) h
      simp only [AdicCompletion.val_zero, AdicCompletion.val_one] at h1
      have h2 : Ideal.Quotient.mk (I ^ 1 • ⊤ : Ideal (MvPolynomial (Fin s) K)) 1 = 0 := by
        rw [map_one]; exact h1.symm
      rw [hmem, pow_one] at h2
      exact (Ideal.eq_top_iff_one I).mpr h2
    haveI : NoZeroDivisors (AdicCompletion I (MvPolynomial (Fin s) K)) := by
      refine ⟨fun {ξ η} h => ?_⟩
      by_contra hne
      push_neg at hne
      obtain ⟨p, hp⟩ := hord ξ hne.1
      obtain ⟨q, hq⟩ := hord η hne.2
      obtain ⟨x, hx⟩ := hlift ξ (p + q + 1)
      obtain ⟨y, hy⟩ := hlift η (p + q + 1)
      obtain ⟨hx1, hx2⟩ := hp _ (by omega) x hx
      obtain ⟨hy1, hy2⟩ := hq _ (by omega) y hy
      apply hGD x y p q hx1 hx2 hy1 hy2
      rw [← hmem, map_mul, hx, hy, ← AdicCompletion.val_mul, h]
      rfl
    exact NoZeroDivisors.to_isDomain _

  have hord : ∀ (n : ℕ) (f : MvPolynomial (Fin s) K),
      f ∈ MvPolynomial.idealOfVars (Fin s) K ^ n ↔
        (n : ℕ∞) ≤ MvPowerSeries.order (f : MvPowerSeries (Fin s) K) := by
    intro n f
    rw [MvPolynomial.mem_pow_idealOfVars_iff]
    constructor
    · intro h
      apply MvPowerSeries.le_order
      intro d hd
      rw [MvPolynomial.coeff_coe]
      by_contra hne
      have h' := h d (MvPolynomial.mem_support_iff.mpr hne)
      have h'' : ((n : ℕ) : ℕ∞) ≤ ((Finsupp.degree d : ℕ) : ℕ∞) := by exact_mod_cast h'
      exact absurd hd (not_lt.mpr h'')
    · intro h d hd
      by_contra hlt
      push_neg at hlt
      have hlt' : ((Finsupp.degree d : ℕ) : ℕ∞) < ((n : ℕ) : ℕ∞) := by exact_mod_cast hlt
      have h0 := MvPowerSeries.coeff_of_lt_order (f := (f : MvPowerSeries (Fin s) K)) (d := d)
        (lt_of_lt_of_le hlt' h)
      rw [MvPolynomial.coeff_coe] at h0
      exact MvPolynomial.mem_support_iff.mp hd h0
  have hexact : ∀ (f : MvPolynomial (Fin s) K) (p : ℕ), f ∈ MvPolynomial.idealOfVars (Fin s) K ^ p →
      f ∉ MvPolynomial.idealOfVars (Fin s) K ^ (p + 1) →
      MvPowerSeries.order (f : MvPowerSeries (Fin s) K) = p := by
    intro f p h1 h2
    rw [hord] at h1 h2
    generalize MvPowerSeries.order (f : MvPowerSeries (Fin s) K) = o at h1 h2 ⊢
    induction o using ENat.recTopCoe with
    | top => exact absurd le_top h2
    | coe m =>
      have h1' : p ≤ m := by exact_mod_cast h1
      have h2' : ¬ p + 1 ≤ m := by exact_mod_cast h2
      have hm : m = p := by omega
      rw [hm]
  have hGD0 : ∀ (a b : MvPolynomial (Fin s) K) (p q : ℕ),
      a ∈ MvPolynomial.idealOfVars (Fin s) K ^ p → a ∉ MvPolynomial.idealOfVars (Fin s) K ^ (p + 1) →
      b ∈ MvPolynomial.idealOfVars (Fin s) K ^ q → b ∉ MvPolynomial.idealOfVars (Fin s) K ^ (q + 1) →
      a * b ∉ MvPolynomial.idealOfVars (Fin s) K ^ (p + q + 1) := by
    intro a b p q ha1 ha2 hb1 hb2 hab
    rw [hord, MvPolynomial.coe_mul, MvPowerSeries.order_mul, hexact a p ha1 ha2,
      hexact b q hb1 hb2] at hab
    have h' : p + q + 1 ≤ p + q := by exact_mod_cast hab
    omega

  obtain ⟨x, hx⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp h𝔭
  let φ : MvPolynomial (Fin s) K →ₐ[K] MvPolynomial (Fin s) K :=
    MvPolynomial.aeval (fun i => MvPolynomial.X i - MvPolynomial.C (x i))
  let ψ : MvPolynomial (Fin s) K →ₐ[K] MvPolynomial (Fin s) K :=
    MvPolynomial.aeval (fun i => MvPolynomial.X i + MvPolynomial.C (x i))
  have hφψ : φ.comp ψ = AlgHom.id K (MvPolynomial (Fin s) K) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [φ, ψ]
  have hψφ : ψ.comp φ = AlgHom.id K (MvPolynomial (Fin s) K) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [φ, ψ]
  let τ : MvPolynomial (Fin s) K ≃+* MvPolynomial (Fin s) K :=
    (AlgEquiv.ofAlgHom φ ψ hφψ hψφ).toRingEquiv
  have hτs : ∀ c, τ.symm c = ψ c := fun c => rfl
  have hev : ∀ c : MvPolynomial (Fin s) K,
      MvPolynomial.constantCoeff (ψ c) = MvPolynomial.eval x c := by
    intro c
    have hcomp : (MvPolynomial.constantCoeff).comp (ψ : MvPolynomial (Fin s) K →+* MvPolynomial (Fin s) K)
        = MvPolynomial.eval x := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [ψ]
      · intro i
        simp [ψ]
    exact RingHom.congr_fun hcomp c
  have h𝔪1 : ∀ g : MvPolynomial (Fin s) K,
      g ∈ MvPolynomial.idealOfVars (Fin s) K ↔ MvPolynomial.constantCoeff g = 0 := by
    intro g
    have h := hord 1 g
    rw [pow_one, Nat.cast_one, MvPowerSeries.one_le_order_iff_constCoeff_eq_zero,
      ← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, MvPolynomial.coeff_coe] at h
    rw [h, MvPolynomial.constantCoeff_eq]
  have hmap : Ideal.map τ (MvPolynomial.idealOfVars (Fin s) K) = 𝔭 := by
    ext c
    rw [← Ideal.symm_apply_mem_of_equiv_iff, hτs, h𝔪1, hev, hx,
      MvPolynomial.mem_vanishingIdeal_singleton_iff]
    exact Iff.rfl
  have hpow : ∀ (n : ℕ) (c : MvPolynomial (Fin s) K),
      c ∈ 𝔭 ^ n ↔ ψ c ∈ MvPolynomial.idealOfVars (Fin s) K ^ n := by
    intro n c
    rw [← hmap, ← Ideal.map_pow, ← Ideal.symm_apply_mem_of_equiv_iff, hτs]
  have hGD : ∀ (a b : MvPolynomial (Fin s) K) (p q : ℕ), a ∈ 𝔭 ^ p → a ∉ 𝔭 ^ (p + 1) →
      b ∈ 𝔭 ^ q → b ∉ 𝔭 ^ (q + 1) → a * b ∉ 𝔭 ^ (p + q + 1) := by
    intro a b p q ha1 ha2 hb1 hb2
    rw [hpow] at ha1 ha2 hb1 hb2 ⊢
    rw [map_mul]
    exact hGD0 _ _ p q ha1 ha2 hb1 hb2
  exact c_abs 𝔭 h𝔭.ne_top hGD

theorem wcpa_dj_lr1s_au_factor_reduced : ∀ (R : Type u) [CommRing R] (J 𝔫 𝔫' : Ideal R) (k : ℕ), 𝔫 ⊔ 𝔫' = ⊤ → (𝔫 * 𝔫') ^ k ≤ J → J ≤ 𝔫 → _root_.IsReduced (AdicCompletion J R) → _root_.IsReduced (AdicCompletion 𝔫 R) :=
by
  intro R _ J 𝔫 𝔫' k hsup hk hJ hred
  set a := k + 1 with ha
  have hP : ∀ n, 𝔫 ^ (a * n) * 𝔫' ^ (a * n) ≤ J ^ n := by
    intro n
    rw [← mul_pow, pow_mul]
    apply Ideal.pow_right_mono
    exact le_trans (Ideal.pow_le_pow_right (Nat.le_succ k)) hk
  have hU : ∀ n, ∃ u : R, u ∈ 𝔫' ^ (a * n) ∧ 1 - u ∈ 𝔫 ^ (a * n) := by
    intro n
    have hc : IsCoprime 𝔫 𝔫' := Ideal.isCoprime_iff_sup_eq.mpr hsup
    have hc' : IsCoprime (𝔫 ^ (a * n)) (𝔫' ^ (a * n)) := hc.pow
    have h1 : (1 : R) ∈ 𝔫 ^ (a * n) ⊔ 𝔫' ^ (a * n) := by
      rw [Ideal.isCoprime_iff_sup_eq.mp hc']; trivial
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1
    refine ⟨z, hz, ?_⟩
    have : 1 - z = y := by rw [← hyz]; ring
    rw [this]; exact hy
  choose u hu1 hu2 using hU
  have hP' : ∀ n y z, y ∈ 𝔫 ^ (a * n) → z ∈ 𝔫' ^ (a * n) → y * z ∈ J ^ n :=
    fun n y z hy hz => hP n (Ideal.mul_mem_mul hy hz)
  have hJn : ∀ n, J ^ n ≤ 𝔫 ^ n := fun n => Ideal.pow_right_mono hJ n
  have han : ∀ n, n ≤ a * n := fun n => by rw [ha]; nlinarith
  have hamono : ∀ n, a * n ≤ a * (n + 1) := fun n => Nat.mul_le_mul_left a (Nat.le_succ n)
  rw [isReduced_iff_pow_one_lt 2 (by norm_num)] at hred ⊢
  intro ξ hξ
  obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective 𝔫 R ξ
  have hC : ∀ m m', m ≤ m' → c m' - c m ∈ 𝔫 ^ m := by
    intro m m' hmm'
    have h := AdicCompletion.AdicCauchySequence.mk_eq_mk hmm' c
    rw [Submodule.Quotient.eq] at h
    simpa [smul_eq_mul, Ideal.mul_top] using h
  have hSq : ∀ m, c m ^ 2 ∈ 𝔫 ^ m := by
    intro m
    have h := congrArg (AdicCompletion.evalₐ 𝔫 m) hξ
    rw [map_pow, AdicCompletion.evalₐ_mk, map_zero, ← map_pow,
      Ideal.Quotient.eq_zero_iff_mem] at h
    exact h
  have hd : ∀ n, u n - u (n + 1) ∈ J ^ n := by
    intro n
    have h1 : u n - u (n + 1) ∈ 𝔫' ^ (a * n) :=
      sub_mem (hu1 n) (Ideal.pow_le_pow_right (hamono n) (hu1 (n + 1)))
    have h2 : u n - u (n + 1) ∈ 𝔫 ^ (a * n) := by
      have : u n - u (n + 1) = (1 - u (n + 1)) - (1 - u n) := by ring
      rw [this]
      exact sub_mem (Ideal.pow_le_pow_right (hamono n) (hu2 (n + 1))) (hu2 n)
    have : u n - u (n + 1) = (u n - u (n + 1)) * u n + (1 - u n) * (u n - u (n + 1)) := by ring
    rw [this]
    exact add_mem (hP' n _ _ h2 (hu1 n)) (hP' n _ _ (hu2 n) h1)
  have hf : ∀ n, (fun n => u n * c (a * n)) n ≡ (fun n => u n * c (a * n)) (n + 1)
      [SMOD (J ^ n • ⊤ : Submodule R R)] := by
    intro n
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
    have : u n * c (a * n) - u (n + 1) * c (a * (n + 1)) =
        (c (a * n) - c (a * (n + 1))) * u n + (u n - u (n + 1)) * c (a * (n + 1)) := by ring
    simp only
    rw [this]
    refine add_mem (hP' n _ _ ?_ (hu1 n)) (Ideal.mul_mem_right _ _ (hd n))
    have h' := neg_mem (hC (a * n) (a * (n + 1)) (hamono n))
    rwa [neg_sub] at h'
  set η := AdicCompletion.mk J R (AdicCompletion.AdicCauchySequence.mk J R _ hf) with hη
  have hevη : ∀ n, AdicCompletion.evalₐ J n η = Ideal.Quotient.mk (J ^ n) (u n * c (a * n)) := by
    intro n
    rw [hη, AdicCompletion.evalₐ_mk, AdicCompletion.AdicCauchySequence.mk_coe]
  have hη2 : η ^ 2 = 0 := by
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [map_pow, hevη, map_zero, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    have : (u n * c (a * n)) ^ 2 = u n * (c (a * n) ^ 2 * u n) := by ring
    rw [this]
    exact Ideal.mul_mem_left _ _ (hP' n _ _ (hSq (a * n)) (hu1 n))
  have hη0 := hred η hη2
  have hV : ∀ n, u n * c (a * n) ∈ J ^ n := by
    intro n
    have := hevη n
    rw [hη0, map_zero] at this
    exact (Ideal.Quotient.eq_zero_iff_mem).mp this.symm
  apply AdicCompletion.ext_evalₐ
  intro n
  rw [AdicCompletion.evalₐ_mk, map_zero, Ideal.Quotient.eq_zero_iff_mem]
  have h1 : c (a * n) ∈ 𝔫 ^ n := by
    have : c (a * n) = u n * c (a * n) + (1 - u n) * c (a * n) := by ring
    rw [this]
    exact add_mem (hJn n (hV n))
      (Ideal.pow_le_pow_right (han n) (Ideal.mul_mem_right _ _ (hu2 n)))
  have h2 := hC n (a * n) (han n)
  have : c n = c (a * n) - (c (a * n) - c n) := by ring
  rw [this]
  exact sub_mem h1 h2

theorem wcpa_dj_lr1s_au_artinian_split : ∀ (P D : Type u) [CommRing P] [CommRing D] [Algebra P D], Module.Finite P D → ∀ (𝔭 : Ideal P), 𝔭.IsMaximal → ∀ (𝔫 : Ideal D), 𝔫.IsMaximal → Ideal.map (algebraMap P D) 𝔭 ≤ 𝔫 → ∃ (𝔫' : Ideal D) (k : ℕ), 𝔫 ⊔ 𝔫' = ⊤ ∧ (𝔫 * 𝔫') ^ k ≤ Ideal.map (algebraMap P D) 𝔭 :=
by
  intro P D _ _ _ hfin 𝔭 h𝔭 𝔫 _ hle
  haveI hA : IsArtinianRing (D ⧸ Ideal.map (algebraMap P D) 𝔭) := by
    haveI := hfin; haveI := h𝔭
    letI := Ideal.Quotient.field 𝔭
    haveI : Module.Finite P (D ⧸ Ideal.map (algebraMap P D) 𝔭) := inferInstance
    haveI := Module.Finite.of_restrictScalars_finite P (P ⧸ 𝔭) (D ⧸ Ideal.map (algebraMap P D) 𝔭)
    exact IsArtinianRing.of_finite (P ⧸ 𝔭) (D ⧸ Ideal.map (algebraMap P D) 𝔭)
  set J := Ideal.map (algebraMap P D) 𝔭 with hJ
  set π := Ideal.Quotient.mk J with hπ
  have hπs : Function.Surjective π := Ideal.Quotient.mk_surjective
  set m := Ideal.map π 𝔫 with hm
  have hstab : ∃ N : ℕ, 0 < N ∧ ∃ e : D ⧸ J, IsIdempotentElem e ∧ m ^ N = Ideal.span {e} := by
    let F : ℕ →o (Ideal (D ⧸ J))ᵒᵈ :=
      ⟨fun n => OrderDual.toDual (m ^ n), fun a b h => Ideal.pow_le_pow_right h⟩
    obtain ⟨n₀, hn₀⟩ := IsArtinian.monotone_stabilizes F
    have hst : ∀ n, n₀ ≤ n → m ^ n = m ^ n₀ := fun n hn => by
      have := hn₀ n hn
      exact (congrArg OrderDual.ofDual this).symm
    refine ⟨n₀ + 1, Nat.succ_pos n₀, ?_⟩
    have hI : IsIdempotentElem (m ^ (n₀ + 1)) := by
      show m ^ (n₀ + 1) * m ^ (n₀ + 1) = m ^ (n₀ + 1)
      rw [← pow_add, hst (n₀ + 1 + (n₀ + 1)) (by omega), hst (n₀ + 1) (by omega)]
    have hFG : (m ^ (n₀ + 1)).FG := IsNoetherian.noetherian _
    obtain ⟨e, he, heI⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hFG).mp hI
    exact ⟨e, he, heI⟩
  obtain ⟨N, hN, e, he, hmN⟩ := hstab
  set f : D ⧸ J := 1 - e with hf
  have hef : e * f = 0 := he.mul_one_sub_self
  refine ⟨Ideal.comap π (Ideal.span {f}), N, ?_, ?_⟩
  · have hem : e ∈ m := by
      have : e ∈ m ^ N := by rw [hmN]; exact Ideal.mem_span_singleton_self e
      exact Ideal.pow_le_self hN.ne' this
    obtain ⟨x, hx, hxe⟩ := (Ideal.mem_map_iff_of_surjective π hπs).mp hem
    obtain ⟨y, hy⟩ := hπs f
    have hy' : y ∈ Ideal.comap π (Ideal.span {f}) := by
      rw [Ideal.mem_comap, hy]; exact Ideal.mem_span_singleton_self f
    have hxy : x + y - 1 ∈ 𝔫 := by
      apply hle
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      show π (x + y - 1) = 0
      rw [map_sub, map_add, map_one, hxe, hy, hf]
      ring
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : D) = (x - (x + y - 1)) + y := by ring
    rw [h1]
    exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.sub_mem _ hx hxy)) (Ideal.mem_sup_right hy')
  · have hker : RingHom.ker π = J := Ideal.mk_ker
    suffices hb : Ideal.map π ((𝔫 * Ideal.comap π (Ideal.span {f})) ^ N) = ⊥ by
      have h2 := (Ideal.map_eq_bot_iff_le_ker π).mp hb
      rwa [hker] at h2
    rw [Ideal.map_pow, Ideal.map_mul, Ideal.map_comap_of_surjective π hπs, ← hm, mul_pow, hmN]
    rw [eq_bot_iff]
    calc Ideal.span {e} * Ideal.span {f} ^ N ≤ Ideal.span {e} * Ideal.span {f} :=
          Ideal.mul_mono_right (Ideal.pow_le_self hN.ne')
      _ = ⊥ := by
          rw [Ideal.span_singleton_mul_span_singleton, hef, Ideal.span_singleton_eq_bot]

theorem wcpa_dj_lr1s_au_completion_tensor_embed : ∀ (P D : Type u) [CommRing P] [IsNoetherianRing P] [CommRing D] [Algebra P D], Module.Finite P D → ∀ (𝔭 : Ideal P), ∃ φ : AdicCompletion (Ideal.map (algebraMap P D) 𝔭) D →+* TensorProduct P (AdicCompletion 𝔭 P) D, Function.Injective φ :=
by
  intro P D _ _ _ _ hfin 𝔭
  set J : Ideal D := Ideal.map (algebraMap P D) 𝔭 with hJ

  have hK : ∀ n : ℕ, (𝔭 ^ n • ⊤ : Submodule P D) =
      (J ^ n • (⊤ : Submodule D D)).restrictScalars P := by
    intro n
    rw [Ideal.smul_top_eq_map, Ideal.map_pow, smul_eq_mul, Ideal.mul_top]

  let q : ∀ n : ℕ, (D ⧸ (𝔭 ^ n • ⊤ : Submodule P D)) ≃+ (D ⧸ (J ^ n • (⊤ : Submodule D D))) :=
    fun n => ((Submodule.quotEquivOfEq _ _ (hK n)).trans
      (Submodule.Quotient.restrictScalarsEquiv P (J ^ n • (⊤ : Submodule D D)))).toAddEquiv
  have hq : ∀ (n : ℕ) (d : D), q n (Submodule.Quotient.mk d) = Submodule.Quotient.mk d :=
    fun n d => rfl

  let e : AdicCompletion 𝔭 D ≃+ AdicCompletion J D :=
    { toFun := fun x => ⟨fun n => q n (x.1 n), fun {m n} hmn => by
        obtain ⟨d, hd⟩ := Submodule.Quotient.mk_surjective _ (x.1 n)
        have hm : x.1 m = Submodule.Quotient.mk d := by
          rw [← AdicCompletion.transitionMap_comp_eval_apply 𝔭 D hmn x]
          show (AdicCompletion.transitionMap 𝔭 D hmn) (x.1 n) = _
          rw [← hd]; rfl
        show (AdicCompletion.transitionMap J D hmn) (q n (x.1 n)) = q m (x.1 m)
        rw [hm, ← hd]; rfl⟩
      invFun := fun y => ⟨fun n => (q n).symm (y.1 n), fun {m n} hmn => by
        obtain ⟨d, hd⟩ := Submodule.Quotient.mk_surjective _ (y.1 n)
        have hm : y.1 m = Submodule.Quotient.mk d := by
          rw [← AdicCompletion.transitionMap_comp_eval_apply J D hmn y]
          show (AdicCompletion.transitionMap J D hmn) (y.1 n) = _
          rw [← hd]; rfl
        show (AdicCompletion.transitionMap 𝔭 D hmn) ((q n).symm (y.1 n)) = (q m).symm (y.1 m)
        rw [hm, ← hd]; rfl⟩
      left_inv := fun x => AdicCompletion.ext (fun n => (q n).symm_apply_apply (x.1 n))
      right_inv := fun y => AdicCompletion.ext (fun n => (q n).apply_symm_apply (y.1 n))
      map_add' := fun x y => AdicCompletion.ext (fun n => by
        show q n ((x + y).1 n) = q n (x.1 n) + q n (y.1 n)
        rw [AdicCompletion.val_add, Pi.add_apply, map_add]) }

  have hB : ∀ (r : AdicCompletion 𝔭 P) (n : ℕ) (p : P), r.1 n = Submodule.Quotient.mk p →
      AdicCompletion.evalₐ 𝔭 n r = Ideal.Quotient.mk (𝔭 ^ n) p := by
    intro r n p hp
    have h : 𝔭 ^ n • (⊤ : Submodule P P) ≤ 𝔭 ^ n := by rw [smul_eq_mul, Ideal.mul_top]
    rw [← AdicCompletion.factor_eval_eq_evalₐ 𝔭 r h, AdicCompletion.eval_apply]
    show Submodule.factor h (r.1 n) = _
    rw [hp]; rfl

  have H : ∀ n : ℕ, 𝔭 ^ n ≤ Ideal.comap (Algebra.ofId P D) (J ^ n) := by
    intro n
    rw [← Ideal.map_le_iff_le_comap]
    exact (Ideal.map_pow (algebraMap P D) 𝔭 n).le
  let f : ∀ n : ℕ, AdicCompletion 𝔭 P →ₐ[P] D ⧸ J ^ n := fun n =>
    (Ideal.quotientMapₐ (J ^ n) (Algebra.ofId P D) (H n)).comp (AdicCompletion.evalₐ 𝔭 n)
  have hf : ∀ (n : ℕ) (r : AdicCompletion 𝔭 P) (p : P), r.1 n = Submodule.Quotient.mk p →
      f n r = Ideal.Quotient.mk (J ^ n) (algebraMap P D p) := by
    intro n r p hp
    show Ideal.quotientMapₐ (J ^ n) (Algebra.ofId P D) (H n) (AdicCompletion.evalₐ 𝔭 n r) = _
    rw [hB r n p hp]; rfl
  have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
      (Ideal.Quotient.factorₐ P (Ideal.pow_le_pow_right hle)).comp (f n) = f m := by
    intro m n hle
    apply AlgHom.ext
    intro r
    obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _ (r.1 n)
    have hm : r.1 m = Submodule.Quotient.mk p := by
      rw [← AdicCompletion.transitionMap_comp_eval_apply 𝔭 P hle r]
      show (AdicCompletion.transitionMap 𝔭 P hle) (r.1 n) = _
      rw [← hp]; rfl
    rw [AlgHom.comp_apply, hf n r p hp.symm, hf m r p hm]
    rfl
  obtain ⟨α, hα⟩ : ∃ α : AdicCompletion 𝔭 P →ₐ[P] AdicCompletion J D,
      ∀ (r : AdicCompletion 𝔭 P) (n : ℕ) (p : P), r.1 n = Submodule.Quotient.mk p →
        (α r).1 n = Submodule.Quotient.mk (algebraMap P D p) := by
    refine ⟨AdicCompletion.liftAlgHom J f hcompat, ?_⟩
    intro r n p hp
    have h' : J ^ n ≤ J ^ n • (⊤ : Submodule D D) := by rw [smul_eq_mul, Ideal.mul_top]
    have h1 := AdicCompletion.factor_evalₐ_eq_eval J (AdicCompletion.liftAlgHom J f hcompat r) h'
    rw [AdicCompletion.eval_apply, AdicCompletion.evalₐ_liftAlgHom, hf n r p hp] at h1
    rw [← h1]
    rfl

  let ψ := Algebra.TensorProduct.productMap α (IsScalarTower.toAlgHom P D (AdicCompletion J D))
  have hψe : ∀ t : TensorProduct P (AdicCompletion 𝔭 P) D,
      ψ t = e (AdicCompletion.ofTensorProduct 𝔭 D t) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero]
    | tmul r d =>
      show α r * algebraMap D (AdicCompletion J D) d = e (AdicCompletion.ofTensorProduct 𝔭 D (r ⊗ₜ d))
      rw [AdicCompletion.ofTensorProduct_tmul]
      apply AdicCompletion.ext
      intro n
      obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _ (r.1 n)
      rw [AdicCompletion.val_mul, hα r n p hp.symm]
      show _ = q n ((r • AdicCompletion.of 𝔭 D d).1 n)
      rw [AdicCompletion.smul_eval, AdicCompletion.val_smul_eq_evalₐ_smul, hB r n p hp.symm,
        AdicCompletion.of_apply, AdicCompletion.algebraMap_apply, AdicCompletion.of_apply,
        Submodule.mkQ_apply, Submodule.mkQ_apply, Module.Quotient.mk_smul_mk, hq]
      simp only [Algebra.algebraMap_self, RingHom.id_apply, Algebra.smul_def,
        Ideal.Quotient.mk_eq_mk, map_mul]
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
  have hψ : Function.Bijective ψ := by
    have h : ⇑ψ = ⇑e ∘ ⇑(AdicCompletion.ofTensorProduct 𝔭 D) := funext hψe
    rw [h]
    exact e.bijective.comp (AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian 𝔭 D)
  exact ⟨(RingEquiv.ofBijective ψ hψ).symm.toRingHom, (RingEquiv.ofBijective ψ hψ).symm.injective⟩

theorem wcpa_dj_lr1s_au_tensor_reduced_char_zero : ∀ (P D : Type u) [CommRing P] [IsDomain P] [IsNoetherianRing P] [CharZero P] [CommRing D] [IsDomain D] [Algebra P D], Module.Finite P D → Function.Injective (algebraMap P D) → ∀ (𝔭 : Ideal P), 𝔭.IsMaximal → IsDomain (AdicCompletion 𝔭 P) → _root_.IsReduced (TensorProduct P (AdicCompletion 𝔭 P) D) :=
by
  intro P D _ _ _ _ _ _ _ hfin hinj 𝔭 _ hdom
  classical
  haveI := hfin
  haveI := hdom
  let F := FractionRing P
  let L := FractionRing D
  let M := FractionRing (AdicCompletion 𝔭 P)

  have hPL : Function.Injective (algebraMap P L) := by
    rw [IsScalarTower.algebraMap_eq P D L]
    exact (IsFractionRing.injective D L).comp hinj
  haveI : FaithfulSMul P L := (faithfulSMul_iff_algebraMap_injective P L).mpr hPL
  letI : Algebra F L := FractionRing.liftAlgebra P L
  haveI : IsScalarTower P F L := FractionRing.isScalarTower_liftAlgebra P L

  haveI : Module.Flat P F := IsLocalization.flat F (nonZeroDivisors P)
  haveI : Module.Flat F L := inferInstance
  haveI hLflat : Module.Flat P L := Module.Flat.trans P F L

  haveI : Algebra.IsIntegral P D := Algebra.IsIntegral.of_finite P D
  haveI : Algebra.IsAlgebraic F L := isAlgebraic_of_isFractionRing P D F L
  haveI : Algebra.IsIntegral F L := Algebra.IsAlgebraic.isIntegral
  haveI : CharZero F := IsFractionRing.charZero P
  haveI : Algebra.IsSeparable F L := Algebra.IsSeparable.of_integral F L
  haveI : Algebra.FormallyUnramified F L := Algebra.FormallyUnramified.of_isSeparable F L
  haveI : Algebra.FormallyUnramified P F :=
    Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors P)
  haveI : Algebra.FormallyUnramified P L := Algebra.FormallyUnramified.comp P F L

  haveI : Algebra.FiniteType P D := inferInstance
  haveI : Algebra.EssFiniteType P D := Algebra.EssFiniteType.of_finiteType P D
  haveI : Algebra.EssFiniteType D L := Algebra.EssFiniteType.of_isLocalization L (nonZeroDivisors D)
  haveI : Algebra.EssFiniteType P L := Algebra.EssFiniteType.comp P D L
  haveI : Algebra.FormallyUnramified M (TensorProduct P M L) :=
    Algebra.FormallyUnramified.base_change (R := P) (A := L) M
  haveI : Algebra.EssFiniteType M (TensorProduct P M L) := Algebra.EssFiniteType.baseChange P L M
  haveI hred : _root_.IsReduced (TensorProduct P M L) :=
    Algebra.FormallyUnramified.isReduced_of_field M (TensorProduct P M L)

  haveI : Module.Flat P (AdicCompletion 𝔭 P) := AdicCompletion.flat_of_isNoetherian 𝔭
  let f : AdicCompletion 𝔭 P →ₐ[P] M := IsScalarTower.toAlgHom P (AdicCompletion 𝔭 P) M
  let g : D →ₐ[P] L := IsScalarTower.toAlgHom P D L
  have hf : Function.Injective f := IsFractionRing.injective (AdicCompletion 𝔭 P) M
  have hg : Function.Injective g := IsFractionRing.injective D L
  have hfac : ∀ x, Algebra.TensorProduct.map f g x =
      LinearMap.rTensor L f.toLinearMap (LinearMap.lTensor (AdicCompletion 𝔭 P) g.toLinearMap x) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul a d => simp
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
  have h1 : Function.Injective (LinearMap.lTensor (AdicCompletion 𝔭 P) g.toLinearMap) :=
    Module.Flat.lTensor_preserves_injective_linearMap g.toLinearMap hg
  have h2 : Function.Injective (LinearMap.rTensor L f.toLinearMap) :=
    Module.Flat.rTensor_preserves_injective_linearMap f.toLinearMap hf
  have hΘ : Function.Injective (Algebra.TensorProduct.map f g) := by
    intro x y hxy
    rw [hfac, hfac] at hxy
    exact h1 (h2 hxy)
  exact isReduced_of_injective (Algebra.TensorProduct.map f g) hΘ

theorem wcpa_dj_lr1s_ncgr_analytically_unramified : ∀ (K : Type u) [Field K] [IsAlgClosed K] (D : Type u) [CommRing D] [Algebra K D], Algebra.FiniteType K D → _root_.IsReduced D → ∀ 𝔫 : Ideal D, 𝔫.IsMaximal → _root_.IsReduced (AdicCompletion 𝔫 D) :=
by
  intro K _ _ D _ _ hft hred 𝔫 h𝔫
  haveI := hft
  haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing K D
  haveI : Nontrivial D := ⟨⟨0, 1, fun h => h𝔫.ne_top ((Ideal.eq_top_iff_one _).mpr (h ▸ 𝔫.zero_mem))⟩⟩
  have hinjK : Function.Injective (algebraMap K D) := (algebraMap K D).injective
  obtain ⟨p, hp⟩ := CharP.exists K
  rcases CharP.char_is_prime_or_zero K p with hpp | hp0
  ·
    haveI : Fact p.Prime := ⟨hpp⟩
    haveI : CharP D p := charP_of_injective_algebraMap hinjK p
    apply wcpa_dj_lr1s_au_frobenius_completion_reduced D p hred
      (wcpa_dj_lr1s_au_frobenius_finite K p D hft) 𝔫
    intro n
    obtain ⟨N, hN⟩ := Ideal.exists_pow_le_of_le_radical_of_fg (I := 𝔫 ^ n)
      (J := Ideal.span ((fun a : D => a ^ p) '' ((𝔫 ^ n : Ideal D) : Set D)))
      (fun a ha => ⟨p, Ideal.subset_span ⟨a, ha, rfl⟩⟩) (IsNoetherian.noetherian _)
    exact ⟨n * N, by rw [pow_mul]; exact hN⟩
  ·
    subst hp0
    haveI : CharZero K := CharP.charP_to_charZero K
    apply wcpa_dj_lr1s_au_minimal_prime_reduction D hred 𝔫
    intro 𝔮 h𝔮
    haveI : 𝔮.IsPrime := h𝔮.1.1
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk 𝔮)
      Ideal.Quotient.mk_surjective h𝔫 with htop | hmax
    · rw [htop]
      refine ⟨fun x _ => ?_⟩
      apply AdicCompletion.ext
      intro n
      have h : ((⊤ : Ideal (D ⧸ 𝔮)) ^ n • (⊤ : Submodule (D ⧸ 𝔮) (D ⧸ 𝔮))) = ⊤ := by
        rw [Ideal.top_pow, Submodule.top_smul]
      obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (x.val n)
      rw [AdicCompletion.val_zero]
      show x.val n = 0
      rw [← hy]
      exact (Submodule.Quotient.mk_eq_zero _).mpr (by rw [h]; trivial)
    · set 𝔫₁ := Ideal.map (Ideal.Quotient.mk 𝔮) 𝔫 with h𝔫₁
      haveI : Algebra.FiniteType K (D ⧸ 𝔮) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K 𝔮) (Ideal.Quotient.mkₐ_surjective K 𝔮)
      haveI : IsDomain (D ⧸ 𝔮) := Ideal.Quotient.isDomain 𝔮
      obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg K (D ⧸ 𝔮)
      letI : Algebra (MvPolynomial (Fin s) K) (D ⧸ 𝔮) := g.toRingHom.toAlgebra
      have hfin : Module.Finite (MvPolynomial (Fin s) K) (D ⧸ 𝔮) := hgfin
      have hinj : Function.Injective (algebraMap (MvPolynomial (Fin s) K) (D ⧸ 𝔮)) := hginj
      set 𝔭 : Ideal (MvPolynomial (Fin s) K) := Ideal.comap g.toRingHom 𝔫₁ with h𝔭
      have h𝔭max : 𝔭.IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal g.toRingHom
          (RingHom.Finite.to_isIntegral hgfin) 𝔫₁
      have hle : Ideal.map (algebraMap (MvPolynomial (Fin s) K) (D ⧸ 𝔮)) 𝔭 ≤ 𝔫₁ :=
        Ideal.map_comap_le
      haveI hdom := wcpa_dj_lr1s_au_poly_completion_domain K s 𝔭 h𝔭max
      haveI hredT := wcpa_dj_lr1s_au_tensor_reduced_char_zero (MvPolynomial (Fin s) K) (D ⧸ 𝔮)
        hfin hinj 𝔭 h𝔭max hdom
      obtain ⟨φ, hφ⟩ := wcpa_dj_lr1s_au_completion_tensor_embed (MvPolynomial (Fin s) K) (D ⧸ 𝔮)
        hfin 𝔭
      have hredJ := isReduced_of_injective φ hφ
      obtain ⟨𝔫', k, hsup, hpow⟩ := wcpa_dj_lr1s_au_artinian_split (MvPolynomial (Fin s) K)
        (D ⧸ 𝔮) hfin 𝔭 h𝔭max 𝔫₁ hmax hle
      exact wcpa_dj_lr1s_au_factor_reduced (D ⧸ 𝔮) _ 𝔫₁ 𝔫' k hsup hpow hle hredJ

theorem wcpa_dj_lr1s_nf_completion_generic_reduced : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → (∀ c : ↥W, c ≠ 0 → ∃ n : ℕ, c ∣ ϖ ^ n) → ∀ (C B : Type u) [CommRing C] [CommRing B] [Algebra ↥W C] [Algebra C B] [Algebra Ω B] [Algebra ↥W B] [IsScalarTower ↥W C B] [IsScalarTower ↥W Ω B], Function.Injective (algebraMap C B) → Algebra.FiniteType ↥W C → Algebra.FiniteType Ω B → _root_.IsReduced B → (∀ b : B, ∃ n : ℕ, ∃ a : C, algebraMap ↥W B ϖ ^ n * b = algebraMap C B a) → _root_.IsReduced (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ))) :=
by
  intro Ω _ _ W hW ϖ hϖ0 hϖnu hdiv C B _ _ _ _ _ _ _ _ hinj hC hB hred hpow

  haveI hnoeth := wcpa_dj_lr1s_ncgr_completed_noetherian Ω W hW ϖ hϖ0 hϖnu hdiv C B hinj hC hB
    hred hpow
  refine ⟨fun x hx => ?_⟩
  obtain ⟨n, hn⟩ := hx
  by_contra hx0

  set I : Ideal (Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C)
      (algebraMap (↥W) C ϖ))) :=
    LinearMap.ker (LinearMap.mulRight _ x) with hIdef
  have hmemI : ∀ s, s ∈ I ↔ s * x = 0 := by
    intro s
    rw [hIdef, LinearMap.mem_ker, LinearMap.mulRight_apply]
  have hI : I ≠ ⊤ := by
    intro h
    have h1 : (1 : Localization.Away (algebraMap C (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C)
        (algebraMap (↥W) C ϖ))) ∈ I := by rw [h]; trivial
    rw [hmemI, one_mul] at h1
    exact hx0 h1
  obtain ⟨m, hm, hIm⟩ := Ideal.exists_le_maximal I hI

  obtain ⟨K, _, _, _, 𝔫, θ, h𝔫, hθ⟩ :=
    wcpa_dj_lr1s_ncgr_maximal_point_comparison Ω W hW ϖ hϖ0 hϖnu hdiv C B hinj hC hB hred hpow m hm

  have hredT : _root_.IsReduced (AdicCompletion 𝔫 (TensorProduct Ω K B)) := by
    haveI := wcpa_dj_lr1s_ncgr_geometrically_reduced Ω K B hB hred
    have hft : Algebra.FiniteType K (TensorProduct Ω K B) := inferInstance
    exact wcpa_dj_lr1s_ncgr_analytically_unramified K (TensorProduct Ω K B) hft inferInstance 𝔫 h𝔫
  have hθx : θ x = 0 :=
    hredT.eq_zero _ ⟨n, by rw [← map_pow, hn, map_zero]⟩
  have hxk := hθ x hθx

  obtain ⟨r, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff m x).mp (by
    rw [Submodule.mem_iInf]
    intro i
    rw [smul_eq_mul, Ideal.mul_top]
    exact hxk i)
  have h2 : (1 - (r : Localization.Away (algebraMap C
      (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ)))) * x = 0 := by
    rw [sub_mul, one_mul]
    rw [smul_eq_mul] at hr
    rw [hr, sub_self]
  have h3 := hIm ((hmemI _).mpr h2)
  have h4 : (1 : Localization.Away (algebraMap C
      (AdicCompletion (Ideal.span {algebraMap (↥W) C ϖ}) C) (algebraMap (↥W) C ϖ))) ∈ m := by
    have := m.add_mem h3 r.2
    simpa using this
  exact hm.ne_top ((Ideal.eq_top_iff_one m).mpr h4)

theorem wcpa_dj_lr1s_nf_cnf_closure_transfer : ∀ (T D A : Type u) [CommRing T] [CommRing D] [CommRing A] [Algebra T D] [Algebra D A] [Algebra T A] [IsScalarTower T D A], Module.Finite T D → Module.Finite T ↥(integralClosure T A) → Module.Finite D ↥(integralClosure D A) :=
by
  intro T D A _ _ _ _ _ _ _ hD hC
  haveI := hD
  haveI := hC
  haveI : Algebra.IsIntegral T D := Algebra.IsIntegral.of_finite T D
  let ι : ↥(integralClosure T A) →ₗ[T] ↥(integralClosure D A) :=
    { toFun := fun x => ⟨(x : A), IsIntegral.tower_top (A := D) x.2⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun t x => by
        apply Subtype.ext
        simp only [RingHom.id_apply]
        rw [Subalgebra.coe_smul, Subalgebra.coe_smul] }
  have hs : Function.Surjective ι := fun y =>
    ⟨⟨(y : A), isIntegral_trans (R := T) (A := D) (y : A) y.2⟩, rfl⟩
  haveI : Module.Finite T ↥(integralClosure D A) := Module.Finite.of_surjective ι hs
  exact Module.Finite.of_restrictScalars_finite T D _

theorem wcpa_dj_lr1s_nf_cnf_bd_tn_content : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (n : ℕ) (f : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)), f ≠ 0 → ∃ (c μ : ↥W) (k : ℕ) (F : MvPolynomial (Fin n) ↥W) (y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)), c * μ = ϖ ^ k ∧ ¬ IsUnit μ ∧ (∃ e, F.coeff e = 1) ∧ f = algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) (MvPolynomial.C c) * (algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) F + algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) (MvPolynomial.C μ) * y) :=
by
  intro Ω _ W ϖ hϖ0 hϖnu n f hf
  classical

  have sepGen : ∀ (R : Type u) [CommRing R] (r : R) (x : AdicCompletion (Ideal.span {r}) R),
      (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R,
        x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0 := by
    intro R _ r x hx
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        (∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) →
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
      rintro n x ⟨y, rfl⟩
      rw [← map_pow, ← Algebra.smul_def]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
        Submodule.mem_top
    refine hc.toIsHausdorff.haus x (fun k => ?_)
    rw [SModEq.sub_mem, sub_zero]
    exact s1 k x (hx k)

  have approxGen : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) →
      ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C)
        (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c +
          algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    intro n y
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
      fun k => hD a n (k + n) (by omega)
    choose b hb using hex
    have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
      intro k
      rw [SModEq.sub_mem]
      obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
      have e : b k - b (k + 1) = p ^ k * (-s) := by
        apply hNc n
        linear_combination (-1 : C) * hb k + hb (k + 1) - hs
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
        Submodule.mem_top
    let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
      AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
    have hBk : ∀ k, B k = b k := fun k => rfl
    refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
    obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
    exact ⟨-s, by linear_combination hb k - hs⟩
  have hsep := sepGen (MvPolynomial (Fin n) ↥W) (MvPolynomial.C ϖ)
  obtain ⟨K, hK⟩ : ∃ K : ℕ, ¬ ∃ y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W),
      f = algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) (MvPolynomial.C ϖ) ^ K * y := by
    by_contra h
    push_neg at h
    exact hf (hsep f h)
  have hCϖ : (MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W) ≠ 0 := by
    rw [Ne, MvPolynomial.C_eq_zero]; exact hϖ0
  have happrox := approxGen (MvPolynomial (Fin n) ↥W)
    (MvPolynomial.C ϖ) (fun x hx => (mul_eq_zero.mp hx).resolve_left hCϖ)
  obtain ⟨P, y', hPy⟩ := happrox K f

  have key : ¬ ∀ i, ϖ ^ K ∣ P.coeff i := by
    intro h
    obtain ⟨Q, hQ⟩ := (MvPolynomial.C_dvd_iff_dvd_coeff (ϖ ^ K) P).mpr h
    apply hK
    refine ⟨algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) Q + y', ?_⟩
    rw [hPy, hQ, MvPolynomial.C_pow]
    simp only [map_mul, map_pow]
    ring
  have hP0 : P ≠ 0 := by
    rintro rfl
    exact key (fun i => by simp)

  have hmin : ∀ s : Finset (Fin n →₀ ℕ), s.Nonempty →
      ∃ e ∈ s, ∀ i ∈ s, P.coeff e ∣ P.coeff i := by
    intro s
    induction s using Finset.induction_on with
    | empty => intro h; exact absurd h Finset.not_nonempty_empty
    | insert a s ha ih =>
      intro _
      rcases s.eq_empty_or_nonempty with hs | hs
      · subst hs
        refine ⟨a, Finset.mem_insert_self a ∅, fun i hi => ?_⟩
        have hi' : i = a := by simpa using hi
        rw [hi']
      · obtain ⟨e₀, he₀, h₀⟩ := ih hs
        rcases ValuationRing.dvd_total (P.coeff a) (P.coeff e₀) with h | h
        · refine ⟨a, Finset.mem_insert_self a s, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with hia | hi
          · rw [hia]
          · exact h.trans (h₀ i hi)
        · refine ⟨e₀, Finset.mem_insert_of_mem he₀, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with hia | hi
          · rw [hia]; exact h
          · exact h₀ i hi
  obtain ⟨d, hd⟩ := MvPolynomial.ne_zero_iff.mp hP0
  obtain ⟨e, he, hediv⟩ := hmin P.support ⟨d, MvPolynomial.mem_support_iff.mpr hd⟩
  have hc0' : P.coeff e ≠ 0 := MvPolynomial.mem_support_iff.mp he
  have hdivall' : ∀ i, P.coeff e ∣ P.coeff i := by
    intro i
    by_cases hi : i ∈ P.support
    · exact hediv i hi
    · rw [MvPolynomial.notMem_support_iff.mp hi]; exact dvd_zero _
  obtain ⟨c, hc⟩ : ∃ c, P.coeff e = c := ⟨_, rfl⟩
  have hc0 : c ≠ 0 := hc ▸ hc0'
  have hdivall : ∀ i, c ∣ P.coeff i := hc ▸ hdivall'
  obtain ⟨F, hF⟩ := (MvPolynomial.C_dvd_iff_dvd_coeff c P).mpr hdivall
  have hFe : F.coeff e = 1 := by
    have h1 : P.coeff e = (MvPolynomial.C c * F).coeff e := by rw [← hF]
    rw [MvPolynomial.coeff_C_mul, hc] at h1
    exact mul_left_cancel₀ hc0 (h1.symm.trans (mul_one c).symm)
  rcases ValuationRing.dvd_total c (ϖ ^ K) with ⟨μ, hμ⟩ | hdv
  · have hμu : ¬ IsUnit μ := by
      intro hu
      apply key
      intro i
      have h2 : ϖ ^ K ∣ c := (hu.dvd_mul_right).mp (dvd_of_eq hμ)
      exact h2.trans (hdivall i)
    refine ⟨c, μ, K, F, y', hμ.symm, hμu, ⟨e, hFe⟩, ?_⟩
    rw [hPy, hF, ← map_pow, ← MvPolynomial.C_pow, hμ, MvPolynomial.C_mul]
    simp only [map_mul]
    ring
  · exact (key fun i => hdv.trans (hdivall i)).elim

