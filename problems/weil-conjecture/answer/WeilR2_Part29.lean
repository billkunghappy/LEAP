    · rw [RingHom.mem_ker, map_sub, StandardEtalePair.lift_X, AlgHom.commutes, sub_self]
  obtain ⟨C₀, iC₀, φ, w, w', 𝔔₀, hφ, h𝔔₀, hcomap, hww, hf, hwβ⟩ :=
