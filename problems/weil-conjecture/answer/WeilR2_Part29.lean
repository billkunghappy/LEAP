      have hz : (κ c * y) ^ k = p0 * (κ t * y ^ k) := by
        rw [mul_pow, ← map_pow, ht, map_mul, hκp]; ring
      have hunit := (hs1 _ _ k hz).map j
      have hmem : j (1 - κ c * y) ∈ 𝔪 := by
        rw [← hπ0, map_sub, map_one, map_mul, hcx, sub_self]
      exact absurd (Ideal.eq_top_of_isUnit_mem 𝔪 hmem hunit) h𝔪.ne_top
