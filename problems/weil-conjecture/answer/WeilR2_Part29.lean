  intro T A _ _ _ _ P hP hV hinj S hSi hSg
  classical
  have hmul : ∀ x y : T, x ∉ P → y ∉ P → x * y ∉ P := fun x y hx hy h =>
    (hP.mem_or_mem h).elim hx hy
  have h1 : (1 : T) ∉ P := hP.ne_top ∘ (Ideal.eq_top_iff_one P).mpr
  have hinj0 : ∀ x : T, algebraMap T A x = 0 → x = 0 := (injective_iff_map_eq_zero _).mp hinj

  have s1 : ∀ (s : Finset A) (c : A → T), s.Nonempty →
      ∃ i0 ∈ s, ∀ i ∈ s, ∃ u z : T, u ∉ P ∧ u * c i = z * c i0 := by
    intro s c hs
    induction s using Finset.induction_on with
    | empty => exact absurd hs Finset.not_nonempty_empty
    | insert a s ha ih =>
      rcases s.eq_empty_or_nonempty with he | hne
      · refine ⟨a, Finset.mem_insert_self a s, fun i hi => ?_⟩
        have hia : i = a := by simpa [he] using hi
        rw [hia]
        exact ⟨1, 1, h1, rfl⟩
      · obtain ⟨m, hm, hmax⟩ := ih hne
        obtain ⟨u, z, hu, h | h⟩ := hV (c a) (c m)
        · refine ⟨m, Finset.mem_insert_of_mem hm, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with hia | hi
          · rw [hia]; exact ⟨u, z, hu, h⟩
          · exact hmax i hi
        · refine ⟨a, Finset.mem_insert_self a s, fun i hi => ?_⟩
          rcases Finset.mem_insert.mp hi with hia | hi
          · rw [hia]; exact ⟨1, 1, h1, rfl⟩
          · obtain ⟨u', z', hu', h'⟩ := hmax i hi
            exact ⟨u * u', z' * z, hmul _ _ hu hu', by linear_combination u * h' + z' * h⟩

  have s2 : ∀ (N : Submodule T A) (S' : Finset A),
      (∀ s ∈ S', ∃ g : T, g ∉ P ∧ algebraMap T A g * s ∈ N) →
      ∃ G : T, G ∉ P ∧ ∀ x ∈ Submodule.span T (S' : Set A), algebraMap T A G * x ∈ N := by
    intro N S' h
    induction S' using Finset.induction_on with
    | empty =>
      refine ⟨1, h1, fun x hx => ?_⟩
      simp at hx
      simp [hx]
    | insert a s ha ih =>
      obtain ⟨G, hG, hGN⟩ := ih (fun s' hs' => h s' (Finset.mem_insert_of_mem hs'))
      obtain ⟨g, hg, hgN⟩ := h a (Finset.mem_insert_self a s)
      refine ⟨G * g, hmul _ _ hG hg, fun x hx => ?_⟩
      rw [Finset.coe_insert, Submodule.mem_span_insert] at hx
