    have hsep := sepGen (MvPolynomial (Fin d) ↥W) (MvPolynomial.C ϖ)
    obtain ⟨K, hK⟩ : ∃ K : ℕ, ¬ ∃ y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W),
        f = algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) ^ K * y := by
      by_contra h
      push_neg at h
      exact hf (hsep f h)
    have hCϖ : (MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W) ≠ 0 := by
      rw [Ne, MvPolynomial.C_eq_zero]; exact hϖ0
    have happrox := approxGen (MvPolynomial (Fin d) ↥W)
      (MvPolynomial.C ϖ) (fun x hx => (mul_eq_zero.mp hx).resolve_left hCϖ)
    obtain ⟨P, y', hPy⟩ := happrox K f
    have key : ¬ ∀ i, ϖ ^ K ∣ P.coeff i := by
      intro h
      obtain ⟨Q, hQ⟩ := (MvPolynomial.C_dvd_iff_dvd_coeff (ϖ ^ K) P).mpr h
