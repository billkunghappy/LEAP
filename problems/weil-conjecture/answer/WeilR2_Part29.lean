        Limits.pullback.lift_snd _ _ _⟩
    have hσ0 : (ρΔ ≫ h₂) ≫ r₀ =
        Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W)))) := by
      rw [hh₂, Category.assoc, Category.assoc, Limits.pullback.condition (f := r₀) (g := m),
        ← Category.assoc θ, hθ, ← Category.assoc, hρΔ2, hΔUm]
    have hσc : (ρτ ≫ h₂) ≫ r₀ =
        Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c))) := by
      rw [hh₂, Category.assoc, Category.assoc, Limits.pullback.condition (f := r₀) (g := m),
