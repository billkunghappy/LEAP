      induction S using Finset.induction_on with
      | empty =>
        intro _ _
        refine ⟨by rw [Finset.sum_empty]; exact isIntegral_zero, ?_⟩
        rintro ⟨q, _, hq⟩
        rw [Finset.sum_empty, zero_mul] at hq
