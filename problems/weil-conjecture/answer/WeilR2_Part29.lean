  have s2 : ∀ g₀ : MvPolynomial (Fin d) ↥W, (∀ e : Fin d →₀ ℕ, ∃ N : ℕ, ϖ ∣ g₀.coeff e ^ N) →
      g₀ ∈ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}).radical := by
    intro g₀ hg₀
    rw [g₀.as_sum]
    refine Ideal.sum_mem _ (fun e _ => ?_)
    rw [MvPolynomial.monomial_eq]
    apply Ideal.mul_mem_right
    obtain ⟨N, w, hw⟩ := hg₀ e
    refine ⟨N, ?_⟩
    rw [← MvPolynomial.C_pow, hw, MvPolynomial.C_mul]
    exact Ideal.mem_span_singleton.mpr (dvd_mul_right _ _)

  have s3 : ∀ g₀ x₀ : MvPolynomial (Fin d) ↥W, MvPolynomial.map (IsLocalRing.residue ↥W) g₀ ≠ 0 →
      MvPolynomial.C ϖ ∣ g₀ * x₀ → MvPolynomial.C ϖ ∣ x₀ := by
    intro g₀ x₀ hres hdvd
    by_contra hx₀
    obtain ⟨c, b, e, Q, M, hϖcbe, hb, hQ0, hQu, hx₀eq⟩ :=
