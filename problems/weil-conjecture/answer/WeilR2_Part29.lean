  have T_s1 : ∀ (D : Type u) [CommRing D] [IsDomain D], (∀ x y : D, x ∣ y ∨ y ∣ x) → ∀ (t : D), (∀ f : ℕ → D, (∀ n : ℕ, ∃ y : D, f (n + 1) - f n = t ^ n * y) → ∃ L : D, ∀ n : ℕ, ∃ y : D, L - f n = t ^ n * y) → (∀ x : D, (∀ k : ℕ, ∃ y : D, x = t ^ k * y) → x = 0) → ∀ (V : Type u) [CommRing V] [Algebra (FractionRing D) V] (N : ℕ) (ε : Fin N → V), (∀ i, IsNilpotent (ε i)) → ∃ (M : Subring V) (σ : ↥M), (σ : V) = algebraMap (FractionRing D) V (algebraMap D (FractionRing D) t) ∧ (∀ d : D, algebraMap (FractionRing D) V (algebraMap D (FractionRing D) d) ∈ M) ∧ (∀ i, ε i ∈ M) ∧ (∀ f : ℕ → ↥M, (∀ n : ℕ, ∃ y : ↥M, f (n + 1) - f n = σ ^ n * y) → ∃ L : ↥M, ∀ n : ℕ, ∃ y : ↥M, L - f n = σ ^ n * y) ∧ (∀ x : ↥M, (∀ k : ℕ, ∃ y : ↥M, x = σ ^ k * y) → x = 0) := by
