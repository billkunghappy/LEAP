          · exact congrFun h3 j

      have nagata : ∀ (R : Type u) [CommRing R] [Nontrivial R] (d b : ℕ), 1 ≤ b →
          ∃ τ : MvPolynomial (Fin (d + 1)) R ≃ₐ[R] MvPolynomial (Fin (d + 1)) R,
            ∀ e : Fin (d + 1) →₀ ℕ,
              (MvPolynomial.finSuccEquiv R d (τ (MvPolynomial.monomial e 1))).Monic ∧
              (MvPolynomial.finSuccEquiv R d (τ (MvPolynomial.monomial e 1))).natDegree =
                ∑ i : Fin (d + 1), e i * b ^ (i : ℕ) := by
        intro R _ _ d b hb
        classical
        let c : Fin (d + 1) → MvPolynomial (Fin (d + 1)) R := fun i =>
          if i = 0 then 0 else MvPolynomial.X 0 ^ (b ^ (i : ℕ))
        let g : Fin (d + 1) → MvPolynomial (Fin (d + 1)) R := fun i => MvPolynomial.X i + c i
        let h : Fin (d + 1) → MvPolynomial (Fin (d + 1)) R := fun i => MvPolynomial.X i - c i
        have hcg : ∀ i, MvPolynomial.aeval g (c i) = c i := by
          intro i; by_cases hi : i = 0 <;> simp [c, g, hi]
        have hch : ∀ i, MvPolynomial.aeval h (c i) = c i := by
          intro i; by_cases hi : i = 0 <;> simp [c, h, hi]
        let τ : MvPolynomial (Fin (d + 1)) R ≃ₐ[R] MvPolynomial (Fin (d + 1)) R :=
          AlgEquiv.ofAlgHom (MvPolynomial.aeval g) (MvPolynomial.aeval h)
            (MvPolynomial.algHom_ext fun i => by
              rw [AlgHom.comp_apply, MvPolynomial.aeval_X, AlgHom.id_apply]
              show MvPolynomial.aeval g (MvPolynomial.X i - c i) = _
              rw [map_sub, MvPolynomial.aeval_X, hcg]
              show MvPolynomial.X i + c i - c i = _
              ring)
            (MvPolynomial.algHom_ext fun i => by
              rw [AlgHom.comp_apply, MvPolynomial.aeval_X, AlgHom.id_apply]
              show MvPolynomial.aeval h (MvPolynomial.X i + c i) = _
              rw [map_add, MvPolynomial.aeval_X, hch]
              show MvPolynomial.X i - c i + c i = _
              ring)
        have hb0 : ∀ j : ℕ, b ^ j ≠ 0 := fun j => pow_ne_zero _ (by omega)
        have hP : ∀ i, (MvPolynomial.finSuccEquiv R d (g i)).Monic ∧
            (MvPolynomial.finSuccEquiv R d (g i)).natDegree = b ^ (i : ℕ) := by
          intro i
          rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
          · have hg0 : g 0 = MvPolynomial.X 0 := by
              show MvPolynomial.X 0 + c 0 = _
              have : c 0 = 0 := by simp [c]
              rw [this, add_zero]
            rw [hg0, MvPolynomial.finSuccEquiv_X_zero, Fin.val_zero, pow_zero]
            exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
          · have hj : (j.succ : Fin (d + 1)) ≠ 0 := Fin.succ_ne_zero j
            have hgs : g j.succ = MvPolynomial.X j.succ +
                MvPolynomial.X 0 ^ (b ^ ((j.succ : Fin (d + 1)) : ℕ)) := by
              show MvPolynomial.X j.succ + c j.succ = _
              have : c j.succ = MvPolynomial.X 0 ^ (b ^ ((j.succ : Fin (d + 1)) : ℕ)) := by
                simp only [c]; rw [if_neg hj]
              rw [this]
            rw [hgs, map_add, map_pow, MvPolynomial.finSuccEquiv_X_zero,
              MvPolynomial.finSuccEquiv_X_succ, add_comm]
            exact ⟨Polynomial.monic_X_pow_add_C _ (hb0 _), Polynomial.natDegree_X_pow_add_C⟩
        refine ⟨τ, fun e => ?_⟩
        have hm : MvPolynomial.monomial e (1 : R) = ∏ i, MvPolynomial.X i ^ (e i) := by
          rw [MvPolynomial.monomial_eq, MvPolynomial.C_1, one_mul, Finsupp.prod_fintype]
          intro i; exact pow_zero _
        have hτX : ∀ i, τ (MvPolynomial.X i) = g i := fun i => by
          show MvPolynomial.aeval g (MvPolynomial.X i) = g i
          exact MvPolynomial.aeval_X g i
        have himg : MvPolynomial.finSuccEquiv R d (τ (MvPolynomial.monomial e 1)) =
            ∏ i, (MvPolynomial.finSuccEquiv R d (g i)) ^ (e i) := by
          rw [hm, map_prod, map_prod]
          simp only [map_pow, hτX]
        rw [himg]
        refine ⟨Polynomial.monic_prod_of_monic _ _ (fun i _ => (hP i).1.pow _), ?_⟩
        rw [Polynomial.natDegree_prod_of_monic _ _ (fun i _ => (hP i).1.pow _)]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [(hP i).1.natDegree_pow, (hP i).2]

      have lead_term : ∀ (R : Type u) [CommRing R] [Nontrivial R] (d : ℕ)
          (τ : MvPolynomial (Fin (d + 1)) R ≃ₐ[R] MvPolynomial (Fin (d + 1)) R)
          (wt : (Fin (d + 1) →₀ ℕ) → ℕ),
          (∀ e : Fin (d + 1) →₀ ℕ,
            (MvPolynomial.finSuccEquiv R d (τ (MvPolynomial.monomial e 1))).Monic ∧
            (MvPolynomial.finSuccEquiv R d (τ (MvPolynomial.monomial e 1))).natDegree = wt e) →
          ∀ U : MvPolynomial (Fin (d + 1)) R, U ≠ 0 →
          Set.InjOn wt (U.support : Set (Fin (d + 1) →₀ ℕ)) →
          (∀ e ∈ U.support, IsUnit (U.coeff e)) →
          ∃ (u : R) (N : ℕ) (L : MvPolynomial (Fin (d + 1)) R), IsUnit u ∧
            (∀ e ∈ L.support, e 0 < N) ∧ τ U = MvPolynomial.C u * MvPolynomial.X 0 ^ N + L := by
        intro R _ _ d τ wt hτ U hU hinj hunit
        classical
        have hne : U.support.Nonempty := by
          rw [Finset.nonempty_iff_ne_empty]; intro h; exact hU (MvPolynomial.support_eq_empty.mp h)
        obtain ⟨es, hes, hmax⟩ := Finset.exists_max_image U.support wt hne
        refine ⟨U.coeff es, wt es, τ U - MvPolynomial.C (U.coeff es) * MvPolynomial.X 0 ^ wt es,
          hunit es hes, ?_, by ring⟩
        have hΦC : ∀ c : R, MvPolynomial.finSuccEquiv R d (MvPolynomial.C c) =
            Polynomial.C (MvPolynomial.C c) := by
          intro c
          have := (MvPolynomial.finSuccEquiv R d).commutes c
          rwa [MvPolynomial.algebraMap_eq, Polynomial.algebraMap_apply,
            MvPolynomial.algebraMap_eq] at this
        have hτC : ∀ c : R, τ (MvPolynomial.C c) = MvPolynomial.C c := by
          intro c
          have := τ.commutes c
          rwa [MvPolynomial.algebraMap_eq] at this
        have hexp : MvPolynomial.finSuccEquiv R d (τ U) = ∑ e ∈ U.support,
            Polynomial.C (MvPolynomial.C (U.coeff e)) *
              MvPolynomial.finSuccEquiv R d (τ (MvPolynomial.monomial e 1)) := by
          conv_lhs => rw [MvPolynomial.as_sum U]
          rw [map_sum, map_sum]
          refine Finset.sum_congr rfl (fun e _ => ?_)
          rw [show MvPolynomial.monomial e (U.coeff e) =
              MvPolynomial.C (U.coeff e) * MvPolynomial.monomial e 1 by
            rw [MvPolynomial.C_mul_monomial, mul_one], map_mul, map_mul, hτC, hΦC]
        have hcoeff : ∀ i, wt es ≤ i → (MvPolynomial.finSuccEquiv R d
            (τ U - MvPolynomial.C (U.coeff es) * MvPolynomial.X 0 ^ wt es)).coeff i = 0 := by
          intro i hi
          rw [map_sub, map_mul, map_pow, hΦC, MvPolynomial.finSuccEquiv_X_zero, Polynomial.coeff_sub,
            hexp, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
          simp_rw [Polynomial.coeff_C_mul]
          rw [Finset.sum_eq_single es]
          · rcases eq_or_lt_of_le hi with h | h
            · subst h
              have h1 : (MvPolynomial.finSuccEquiv R d
                  (τ (MvPolynomial.monomial es 1))).coeff (wt es) = 1 := by
                rw [← (hτ es).2]; exact (hτ es).1.coeff_natDegree
              rw [h1, mul_one, if_pos rfl, sub_self]
            · have h1 : (MvPolynomial.finSuccEquiv R d
                  (τ (MvPolynomial.monomial es 1))).coeff i = 0 :=
                Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [(hτ es).2]; exact h)
              rw [h1, mul_zero, if_neg (by omega), sub_zero]
          · intro e he hne
            rw [Polynomial.coeff_eq_zero_of_natDegree_lt, mul_zero]
            rw [(hτ e).2]
            have h1 := hmax e he
            have h2 : wt e ≠ wt es := fun h => hne (hinj he hes h)
            omega
          · intro h; exact absurd hes h
        intro e he
        by_contra hlt
        push_neg at hlt
        rw [MvPolynomial.mem_support_iff] at he
        apply he
        rw [← Finsupp.cons_tail e, ← MvPolynomial.finSuccEquiv_coeff_coeff, hcoeff _ hlt]
        rfl

      have unit_split : ∀ (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] (n : ℕ)
          (F : MvPolynomial (Fin n) R), (∃ e, F.coeff e = 1) →
          ∃ (U V : MvPolynomial (Fin n) R) (ρ : R), U ≠ 0 ∧ (∀ e ∈ U.support, IsUnit (U.coeff e)) ∧
            ¬ IsUnit ρ ∧ F = U + MvPolynomial.C ρ * V := by
        intro R _ _ _ n F he1
        classical
        have claim : ∀ s : Finset (Fin n →₀ ℕ), ∃ ρ : R, ¬ IsUnit ρ ∧
            ∀ e ∈ s, ¬ IsUnit (F.coeff e) → ρ ∣ F.coeff e := by
          intro s
          induction s using Finset.induction_on with
          | empty => exact ⟨0, not_isUnit_zero, fun e he => absurd he (Finset.notMem_empty e)⟩
          | insert a s ha ih =>
            obtain ⟨ρ, hρ, hdiv⟩ := ih
            by_cases hua : IsUnit (F.coeff a)
            · refine ⟨ρ, hρ, fun e he hne => ?_⟩
              rcases Finset.mem_insert.mp he with rfl | he'
              · exact absurd hua hne
              · exact hdiv e he' hne
            · rcases ValuationRing.dvd_total ρ (F.coeff a) with h | h
              · refine ⟨ρ, hρ, fun e he hne => ?_⟩
                rcases Finset.mem_insert.mp he with rfl | he'
                · exact h
                · exact hdiv e he' hne
              · refine ⟨F.coeff a, hua, fun e he hne => ?_⟩
                rcases Finset.mem_insert.mp he with rfl | he'
                · exact dvd_refl _
                · exact h.trans (hdiv e he' hne)
        obtain ⟨ρ, hρ, hdiv⟩ := claim F.support
        let U : MvPolynomial (Fin n) R := ∑ e ∈ F.support.filter (fun e => IsUnit (F.coeff e)),
          MvPolynomial.monomial e (F.coeff e)
        have hUc : ∀ e, U.coeff e = if IsUnit (F.coeff e) then F.coeff e else 0 := by
          intro e
          simp only [U, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
          by_cases hu : IsUnit (F.coeff e)
          · have : F.coeff e ≠ 0 := hu.ne_zero
            simp [hu, MvPolynomial.mem_support_iff, this]
          · simp [hu]
        have hdvd : MvPolynomial.C ρ ∣ F - U := by
          rw [MvPolynomial.C_dvd_iff_dvd_coeff]
          intro e
          rw [MvPolynomial.coeff_sub, hUc]
          by_cases hu : IsUnit (F.coeff e)
          · rw [if_pos hu, sub_self]; exact dvd_zero _
          · rw [if_neg hu, sub_zero]
            by_cases h0 : F.coeff e = 0
            · rw [h0]; exact dvd_zero _
            · exact hdiv e (MvPolynomial.mem_support_iff.mpr h0) hu
        obtain ⟨V, hV⟩ := hdvd
        obtain ⟨e1, he1⟩ := he1
        refine ⟨U, V, ρ, ?_, ?_, hρ, ?_⟩
        · intro h0
          have := hUc e1
          rw [h0, MvPolynomial.coeff_zero, he1, if_pos isUnit_one] at this
          exact zero_ne_one this
        · intro e he
          rw [MvPolynomial.mem_support_iff, hUc] at he
          rw [hUc]
          split_ifs at he ⊢ with hu
          · exact hu
          · exact absurd rfl he
        · rw [← hV]; ring


      have tn_content : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (n : ℕ) (f : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)), f ≠ 0 → ∃ (c μ : ↥W) (k : ℕ) (F : MvPolynomial (Fin n) ↥W) (y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)), c * μ = ϖ ^ k ∧ ¬ IsUnit μ ∧ (∃ e, F.coeff e = 1) ∧ f = algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) (MvPolynomial.C c) * (algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) F + algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) (MvPolynomial.C μ) * y) := by
        intro Ω _ W ϖ hϖ0 hϖnu n f hf
        classical
        have sepGen : ∀ (R : Type u) [CommRing R] (r : R) (x : AdicCompletion (Ideal.span {r}) R),
            (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R,
              x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0 := by
          intro R _ r x hx
          have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
            AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
          have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
              (∃ y : AdicCompletion (Ideal.span {r}) R,
                x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) →
              x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
            rintro n x ⟨y, rfl⟩
            rw [← map_pow, ← Algebra.smul_def]
            exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
              Submodule.mem_top
          refine hc.toIsHausdorff.haus x (fun k => ?_)
          rw [SModEq.sub_mem, sub_zero]
          exact s1 k x (hx k)
        have approxGen : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) →
            ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C)
              (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c +
                algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
          intro C _ p hp
          have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
              (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
              Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
            intro k c
            rw [AlgHom.commutes]
            rfl
          have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
            intro k x
            rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
          have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
              p ^ m ∣ a k - a m := by
            intro a m k hmk
            rw [← hmem, map_sub, sub_eq_zero]
            exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
          have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
            intro n
            induction n with
            | zero => intro x h; simpa using h
            | succ n ih =>
              intro x h
              apply ih
              apply hp
              rw [← mul_assoc, ← pow_succ']
              exact h
          have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
            intro n u v h
            rw [← sub_eq_zero]
            apply hN n
            rw [mul_sub, h, sub_self]
          intro n y
          obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
          have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
            fun k => hD a n (k + n) (by omega)
          choose b hb using hex
          have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
            intro k
            rw [SModEq.sub_mem]
            obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
            have e : b k - b (k + 1) = p ^ k * (-s) := by
              apply hNc n
              linear_combination (-1 : C) * hb k + hb (k + 1) - hs
            rw [e]
            exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
              Submodule.mem_top
          let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
            AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
          have hBk : ∀ k, B k = b k := fun k => rfl
          refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
          apply AdicCompletion.ext_evalₐ
          intro k
          rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
            ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
          obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
          exact ⟨-s, by linear_combination hb k - hs⟩
        have hsep := sepGen (MvPolynomial (Fin n) ↥W) (MvPolynomial.C ϖ)
        obtain ⟨K, hK⟩ : ∃ K : ℕ, ¬ ∃ y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W),
            f = algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) (MvPolynomial.C ϖ) ^ K * y := by
          by_contra h
          push_neg at h
          exact hf (hsep f h)
        have hCϖ : (MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W) ≠ 0 := by
          rw [Ne, MvPolynomial.C_eq_zero]; exact hϖ0
        have happrox := approxGen (MvPolynomial (Fin n) ↥W)
          (MvPolynomial.C ϖ) (fun x hx => (mul_eq_zero.mp hx).resolve_left hCϖ)
        obtain ⟨P, y', hPy⟩ := happrox K f
        have key : ¬ ∀ i, ϖ ^ K ∣ P.coeff i := by
          intro h
          obtain ⟨Q, hQ⟩ := (MvPolynomial.C_dvd_iff_dvd_coeff (ϖ ^ K) P).mpr h
          apply hK
          refine ⟨algebraMap (MvPolynomial (Fin n) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin n) ↥W)}) (MvPolynomial (Fin n) ↥W)) Q + y', ?_⟩
          rw [hPy, hQ, MvPolynomial.C_pow]
          simp only [map_mul, map_pow]
          ring
        have hP0 : P ≠ 0 := by
          rintro rfl
          exact key (fun i => by simp)
        have hmin : ∀ s : Finset (Fin n →₀ ℕ), s.Nonempty →
            ∃ e ∈ s, ∀ i ∈ s, P.coeff e ∣ P.coeff i := by
          intro s
          induction s using Finset.induction_on with
          | empty => intro h; exact absurd h Finset.not_nonempty_empty
          | insert a s ha ih =>
            intro _
            rcases s.eq_empty_or_nonempty with hs | hs
            · subst hs
              refine ⟨a, Finset.mem_insert_self a ∅, fun i hi => ?_⟩
              have hi' : i = a := by simpa using hi
              rw [hi']
            · obtain ⟨e₀, he₀, h₀⟩ := ih hs
              rcases ValuationRing.dvd_total (P.coeff a) (P.coeff e₀) with h | h
              · refine ⟨a, Finset.mem_insert_self a s, fun i hi => ?_⟩
                rcases Finset.mem_insert.mp hi with hia | hi
                · rw [hia]
                · exact h.trans (h₀ i hi)
              · refine ⟨e₀, Finset.mem_insert_of_mem he₀, fun i hi => ?_⟩
                rcases Finset.mem_insert.mp hi with hia | hi
                · rw [hia]; exact h
                · exact h₀ i hi
        obtain ⟨d, hd⟩ := MvPolynomial.ne_zero_iff.mp hP0
        obtain ⟨e, he, hediv⟩ := hmin P.support ⟨d, MvPolynomial.mem_support_iff.mpr hd⟩
        have hc0' : P.coeff e ≠ 0 := MvPolynomial.mem_support_iff.mp he
        have hdivall' : ∀ i, P.coeff e ∣ P.coeff i := by
          intro i
          by_cases hi : i ∈ P.support
          · exact hediv i hi
          · rw [MvPolynomial.notMem_support_iff.mp hi]; exact dvd_zero _
        obtain ⟨c, hc⟩ : ∃ c, P.coeff e = c := ⟨_, rfl⟩
        have hc0 : c ≠ 0 := hc ▸ hc0'
        have hdivall : ∀ i, c ∣ P.coeff i := hc ▸ hdivall'
        obtain ⟨F, hF⟩ := (MvPolynomial.C_dvd_iff_dvd_coeff c P).mpr hdivall
        have hFe : F.coeff e = 1 := by
          have h1 : P.coeff e = (MvPolynomial.C c * F).coeff e := by rw [← hF]
          rw [MvPolynomial.coeff_C_mul, hc] at h1
          exact mul_left_cancel₀ hc0 (h1.symm.trans (mul_one c).symm)
