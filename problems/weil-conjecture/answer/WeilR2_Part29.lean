            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) := rfl
        rw [e, h01]
        ring
      rw [map_mul, hF, mul_zero]
    refine ⟨Ideal.Quotient.lift I Φt hΦt, ?_, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · rw [Ideal.Quotient.lift_mk]
      simp [Φt]
    · intro w
      rw [Ideal.Quotient.lift_mk]
      simp only [Φt, MvPolynomial.eval₂Hom_C]
      rfl
  have hkey : Φ.comp θ₀ = (r₀.appLE ⊤ (U 0) (by simp)).hom.comp
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom := by
    apply MvPolynomial.ringHom_ext
    · intro w
      simp only [RingHom.comp_apply]
      rw [hθC, hΦC]
    · intro i
      fin_cases i
      show Φ (θ₀ (MvPolynomial.X 0)) = (r₀.appLE ⊤ (U 0) (by simp)).hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))
      rw [hθX, hΦX0]
  refine ⟨h, ![1, (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
      (Ideal.Quotient.mk I (MvPolynomial.X 1))], ?_, ?_, ?_, ?_, ?_⟩
  ·
    show Spec.map θc ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ I)))
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro w
    simp only [θc, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
    exact (hθC w).trans rfl
  ·
    intro j
    fin_cases j
    · exact (one_mul _).symm
    · show h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom
          (MvPolynomial.C c)) =
        (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).inv.hom
          (Ideal.Quotient.mk I (MvPolynomial.X 1)) *
        h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))
      have e2 : (Ideal.Quotient.mk I (MvPolynomial.C c) : MvPolynomial (Fin 2) ↥W ⧸ I) =
          Ideal.Quotient.mk I (MvPolynomial.X 1) * Ideal.Quotient.mk I (MvPolynomial.X 0) := by
        rw [← hAB]; ring
