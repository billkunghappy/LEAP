      obtain ⟨Ui, hUi⟩ := isUnit_iff_exists_inv.mp (hunit u hu)
      obtain ⟨G1i, hG1⟩ := isUnit_iff_exists_inv.mp (hunit g₁ g₁.2)
      obtain ⟨G2i, hG2⟩ := isUnit_iff_exists_inv.mp (hunit g₂ g₂.2)
      rcases hcase with h | h
      · right
        have e3 := congrArg (algebraMap T (Localization.AtPrime P)) h
        rw [map_mul, map_mul] at e3
        refine ⟨Ui * algebraMap T (Localization.AtPrime P) z *
          algebraMap T (Localization.AtPrime P) g₂ * G1i, ?_⟩
        linear_combination (-x) * hG1 + G1i * h1 -
          algebraMap T (Localization.AtPrime P) a₁ * G1i * hUi + Ui * G1i * e3 -
          algebraMap T (Localization.AtPrime P) z * Ui * G1i * h2
      · left
        have e3 := congrArg (algebraMap T (Localization.AtPrime P)) h
        rw [map_mul, map_mul] at e3
        refine ⟨Ui * algebraMap T (Localization.AtPrime P) z *
          algebraMap T (Localization.AtPrime P) g₁ * G2i, ?_⟩
        linear_combination (-y) * hG2 + G2i * h2 -
          algebraMap T (Localization.AtPrime P) a₂ * G2i * hUi + Ui * G2i * e3 -
          algebraMap T (Localization.AtPrime P) z * Ui * G2i * h1
    · intro h
      apply ht0
      apply hinj
      rw [h, map_zero]
    · rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P) P t]
      exact fun h => h htP
    · intro v hv0
      obtain ⟨⟨a, g⟩, hvg⟩ := IsLocalization.surj P.primeCompl v
      simp only at hvg
      have ha0 : a ≠ 0 := by
        rintro rfl
        apply hv0
        rw [map_zero] at hvg
        exact (hunit g g.2).mul_left_eq_zero.mp hvg
      obtain ⟨a', e, f₀, N, hf₀, haeq, htN⟩ := hc a ha0
      obtain ⟨Fi, hFi⟩ := isUnit_iff_exists_inv.mp (hunit f₀ hf₀)
      have hA := congrArg (algebraMap T (Localization.AtPrime P)) haeq
      have hT := congrArg (algebraMap T (Localization.AtPrime P)) htN
      rw [map_mul] at hA
      rw [map_mul, map_pow] at hT
      refine ⟨N, algebraMap T (Localization.AtPrime P) g * Fi *
        algebraMap T (Localization.AtPrime P) e, ?_⟩
      linear_combination hT - algebraMap T (Localization.AtPrime P) a' *
        algebraMap T (Localization.AtPrime P) e * hFi -
        Fi * algebraMap T (Localization.AtPrime P) e * hA -
        Fi * algebraMap T (Localization.AtPrime P) e * hvg

  haveI hTd : IsDomain (wcGbT W ϖ d) := wcpa_dj_lr1s_nf_cnf_bd_tnn_domain Ω W ϖ hϖ0 hϖnu d
  have hp0 : (MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W) ≠ 0 := by
    intro h
    exact hϖ0 (MvPolynomial.C_eq_zero.mp h)
  have hpnzd : ∀ x : MvPolynomial (Fin d) ↥W, MvPolynomial.C ϖ * x = 0 → x = 0 :=
    fun x h => (mul_eq_zero.mp h).resolve_left hp0
  have ht0 : wcGbt W ϖ d ≠ 0 := by
    intro h
    obtain ⟨_, hb2, _⟩ := wcpa_dj_lr1s_nf_adic_completion_basics (MvPolynomial (Fin d) ↥W)
      (MvPolynomial.C ϖ) hpnzd
    obtain ⟨c', hc'⟩ := hb2 2 (MvPolynomial.C ϖ) 0 (by
      rw [mul_zero]
      exact h)
    have h1 : (MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W) * (1 - MvPolynomial.C ϖ * c') = 0 := by
      linear_combination hc'
    have h2 : (1 : MvPolynomial (Fin d) ↥W) = MvPolynomial.C ϖ * c' := by
      linear_combination hpnzd _ h1
    have h3 := congrArg (MvPolynomial.constantCoeff (R := ↥W) (σ := Fin d)) h2
    rw [map_one, map_mul, MvPolynomial.constantCoeff_C] at h3
    exact hϖnu (isUnit_iff_exists_inv.mpr ⟨_, h3.symm⟩)
  have htP : wcGbt W ϖ d ∈ wcGbP W ϖ d :=
    Ideal.le_radical (Ideal.mem_span_singleton_self _)
  have hcont' : ∀ f : wcGbT W ϖ d, f ≠ 0 → ∃ (a e f₀ : wcGbT W ϖ d) (N : ℕ),
      f₀ ∉ wcGbP W ϖ d ∧ f = a * f₀ ∧ wcGbt W ϖ d ^ N = a * e := by
    intro f hf
    obtain ⟨c, N, f₀, _, ⟨e, he⟩, hf₀, hfeq⟩ := hcont f hf
    refine ⟨algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c),
      algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C e), f₀, N, hf₀, hfeq, ?_⟩
    rw [← map_mul, ← MvPolynomial.C_mul, ← he, MvPolynomial.C_pow, map_pow]
  obtain ⟨hzd, htot, hr0, hrnu, hrk⟩ :=
    s1 (wcGbT W ϖ d) (wcGbP W ϖ d) (wcGbt W ϖ d) ht0 htP hcont' hval
  have hnzd : ∀ x : Localization.AtPrime (wcGbP W ϖ d),
      algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d) * x = 0 →
      x = 0 := fun x h => (hzd _ _ h).resolve_left hr0
  obtain ⟨_, hb2, hb3⟩ := wcpa_dj_lr1s_nf_adic_completion_basics
    (Localization.AtPrime (wcGbP W ϖ d))
    (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d)) hnzd
  obtain ⟨hser, hsep⟩ := wcpa_dj_lr1s_nf_cnf_adic_series
    (Localization.AtPrime (wcGbP W ϖ d))
    (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d))
  have hnf : ∀ x : wcGbVhat W ϖ d, ∃ (v : Localization.AtPrime (wcGbP W ϖ d))
