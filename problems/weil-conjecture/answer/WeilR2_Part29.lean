      intro x
      by_cases hx : x = 0
      · left; rw [hx]; exact Subring.zero_mem _
      · rcases hval x hx with h | h
        · left; exact h
        · right; exact h
    have hmem : ∀ x : E, x ∈ ValuationSubring.ofSubring _ h ↔ IsIntegral V x := by
      intro x
      rw [ValuationSubring.mem_ofSubring, Subalgebra.mem_toSubring, mem_integralClosure_iff]
    refine ⟨ValuationSubring.ofSubring _ h, hmem, fun x hx => ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro hnu
