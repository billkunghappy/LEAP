theorem wcpa_dj_lr1s_trivial_valuation : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω), W = ⊤ → ∀ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)), wcpaDjIsProjOver Ω ct → SmoothOfRelativeDimension 1 ct → ∃ (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of ↥W)) (ψ₀ : Ct ⟶ Z₀), wcpaDjSemistable u₀ ∧ (∃ (N : ℕ) (j : Z₀ ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = u₀) ∧ IsPullback ψ₀ ct u₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
by
  intro Ω _ W hWt Ct ct hproj hsm
  classical

  have hmem : ∀ y : Ω, y ∈ W := fun y => by rw [hWt]; exact ValuationSubring.mem_top y
  have hbij : Function.Bijective (algebraMap ↥W Ω) := by
    refine ⟨fun a b h => Subtype.ext h, fun y => ⟨⟨y, hmem y⟩, rfl⟩⟩
  set e : ↥W ≃+* Ω := RingEquiv.ofBijective (algebraMap ↥W Ω) hbij with he
  set eW : Spec (.of Ω) ⟶ Spec (.of ↥W) := Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) with heW

  haveI hiso1 : IsIso (CommRingCat.ofHom (algebraMap ↥W Ω)) :=
    (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom (algebraMap ↥W Ω))).mpr hbij
  haveI hisoW : IsIso eW := inferInstance

  haveI hprop : IsProper ct := wcpa_dj_proj_proper Ω ct hproj
  haveI hflat : Flat ct := inferInstance
  haveI := hsm
  haveI hsmu : SmoothOfRelativeDimension 1 (ct ≫ eW) :=
    (inferInstance : SmoothOfRelativeDimension (1 + 0) (ct ≫ eW))

  set ψ : Ω →+* ↥W := e.symm.toRingHom with hψ
  set g : Spec (.of ↥W) ⟶ Spec (.of Ω) := Spec.map (CommRingCat.ofHom ψ) with hg
  have hψc : ψ.comp (algebraMap ↥W Ω) = RingHom.id ↥W :=
    RingHom.ext fun x => e.symm_apply_apply x
  have hcψ : (algebraMap ↥W Ω).comp ψ = RingHom.id Ω :=
    RingHom.ext fun x => e.apply_symm_apply x
  have hgeW : g ≫ eW = 𝟙 _ := by
    rw [hg, heW, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hψc, CommRingCat.ofHom_id,
      Spec.map_id]
  have heWg : eW ≫ g = 𝟙 _ := by
    rw [hg, heW, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcψ, CommRingCat.ofHom_id,
      Spec.map_id]
  haveI hgiso : IsIso g := ⟨⟨eW, hgeW, heWg⟩⟩
  obtain ⟨N', j', hj', hj'eq⟩ := wcpa_dj_lus_proj_ring_basechange Ω ↥W ψ Ct ct hproj
  haveI := hj'
  haveI hpiso : IsIso (Limits.pullback.fst ct g) := Limits.pullback_fst_iso_of_right_iso ct g
  have hsnd : Limits.pullback.snd ct g = Limits.pullback.fst ct g ≫ ct ≫ eW := by
    calc Limits.pullback.snd ct g = Limits.pullback.snd ct g ≫ g ≫ eW := by
          rw [hgeW, Category.comp_id]
      _ = Limits.pullback.fst ct g ≫ ct ≫ eW := by
          rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc]
  refine ⟨Ct, ct ≫ eW, 𝟙 Ct, ⟨inferInstance, inferInstance, ?_⟩,
    ⟨N', inv (Limits.pullback.fst ct g) ≫ j', inferInstance, ?_⟩, ?_⟩
  · intro K _ _ s w
    have h1 : SmoothOfRelativeDimension 1 (Limits.pullback.snd (ct ≫ eW) s) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
        (IsPullback.of_hasPullback (ct ≫ eW) s) inferInstance
    exact Or.inl ⟨⊤, trivial,
      (inferInstance : SmoothOfRelativeDimension (0 + 1)
        (Scheme.Opens.ι (⊤ : (Limits.pullback (ct ≫ eW) s).Opens) ≫
          Limits.pullback.snd (ct ≫ eW) s))⟩
  · rw [Category.assoc, hj'eq, hsnd, IsIso.inv_hom_id_assoc]
  · exact IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp]⟩

theorem wcpa_dj_lr1s_finite_projection : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)), wcpaDjIsProjOver Ω ct → SmoothOfRelativeDimension 1 ct → IrreducibleSpace Ct → ∃ φ : Ct ⟶ wcProjK Ω 1, IsFinite φ ∧ φ ≫ wcProjKStr Ω 1 = ct ∧ ∃ V : Ct.Opens, Dense (V : Set Ct) ∧ Etale (V.ι ≫ φ) :=
by
  intro Ω _ _ Ct ct hproj hsm hirr
