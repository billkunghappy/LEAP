theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_cv_vhat_rad : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) [(wcGbP W ϖ d).IsPrime], algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d) ≠ 0 → ∀ x : wcGbVhat W ϖ d, ¬ IsUnit x → ∃ (M : ℕ) (y : wcGbVhat W ϖ d), x ^ M = algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d) * y :=
by
  intro Ω _ _ W _hW ϖ hϖ0 hϖnu d _ ht0 x hx
  classical

  have s2 : ∀ (A : Type u) [CommRing A] (τ : A),
      (∀ f : ℕ → A, (∀ n : ℕ, ∃ y : A, f (n + 1) - f n = τ ^ n * y) →
        ∃ L : A, ∀ n : ℕ, ∃ y : A, L - f n = τ ^ n * y) →
      (∀ x : A, (∀ k : ℕ, ∃ y : A, x = τ ^ k * y) → x = 0) →
      ∀ s : A, IsUnit (1 + τ * s) := by
    intro A _ τ hser hsep s
    obtain ⟨L, hL⟩ := hser (fun n => ∑ i ∈ Finset.range n, (-(τ * s)) ^ i) (fun n =>
      ⟨(-s) ^ n, by rw [Finset.sum_range_succ, add_sub_cancel_left, neg_mul_eq_mul_neg, mul_pow]⟩)
    have h0 : (1 + τ * s) * L - 1 = 0 := by
      apply hsep
      intro k
      obtain ⟨y, hy⟩ := hL k
      refine ⟨(1 + τ * s) * y - (-s) ^ k, ?_⟩
      have hg := mul_neg_geom_sum (-(τ * s)) k
      have hq : (-(τ * s)) ^ k = τ ^ k * (-s) ^ k := by rw [neg_mul_eq_mul_neg, mul_pow]
      linear_combination (1 + τ * s) * hy + hg - hq
    exact isUnit_iff_exists_inv.mpr ⟨L, by linear_combination h0⟩

  have core : ∀ (R A : Type u) [CommRing R] [CommRing A] (ι : R →+* A) (r : R),
      (∀ (n : ℕ) (y : A), ∃ (c : R) (y' : A), y = ι c + ι r ^ n * y') →
      (∀ s : A, IsUnit (1 + ι r * s)) →
      (∀ c : R, ¬ IsUnit c → ∃ (M : ℕ) (v : R), c ^ M = r * v) →
      ∀ x : A, ¬ IsUnit x → ∃ (M : ℕ) (y : A), x ^ M = ι r * y := by
    intro R A _ _ ι r hb3 hu hloc x hx
    obtain ⟨c, y', hxy⟩ := hb3 1 x
    rw [pow_one] at hxy
    have hc : ¬ IsUnit c := by
      intro hc
      obtain ⟨c', hcc'⟩ := isUnit_iff_exists_inv.mp hc
      apply hx
      have h1 : ι c * ι c' = 1 := by rw [← map_mul, hcc', map_one]
      have e : x = ι c * (1 + ι r * (ι c' * y')) := by
        rw [hxy]
        linear_combination (-(ι r * y')) * h1
      rw [e]
      exact (hc.map ι).mul (hu _)
    obtain ⟨M, v, hv⟩ := hloc c hc
    obtain ⟨w, hw⟩ := sub_dvd_pow_sub_pow x (ι c) M
    have hcM : ι c ^ M = ι r * ι v := by rw [← map_pow, hv, map_mul]
    have hxc : x - ι c = ι r * y' := by rw [hxy]; ring
    rw [hxc] at hw
    refine ⟨M, ι v + y' * w, ?_⟩
    linear_combination hw + hcM

  haveI hTd : IsDomain (wcGbT W ϖ d) := wcpa_dj_lr1s_nf_cnf_bd_tnn_domain Ω W ϖ hϖ0 hϖnu d
  have hts : algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d) =
      algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d)
        (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d)) :=
    IsScalarTower.algebraMap_apply _ _ _ _
  have htV0 : algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d) ≠ 0 := by
    intro h
    have h' := congrArg (algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d)) h
    rw [map_zero] at h'
    exact ht0 (hts.trans h')
  have hnzd : ∀ y : Localization.AtPrime (wcGbP W ϖ d),
      algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d) * y = 0 →
      y = 0 := fun y h => (mul_eq_zero.mp h).resolve_left htV0

  obtain ⟨_, _, hb3⟩ := wcpa_dj_lr1s_nf_adic_completion_basics
    (Localization.AtPrime (wcGbP W ϖ d))
    (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d)) hnzd
  obtain ⟨hser, hsep⟩ := wcpa_dj_lr1s_nf_cnf_adic_series
    (Localization.AtPrime (wcGbP W ϖ d))
    (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d))

  have hloc : ∀ c : Localization.AtPrime (wcGbP W ϖ d), ¬ IsUnit c → ∃ (M : ℕ)
      (v : Localization.AtPrime (wcGbP W ϖ d)),
      c ^ M = algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d) * v := by
    intro c hc
    obtain ⟨⟨f, g⟩, hfg⟩ := IsLocalization.surj (wcGbP W ϖ d).primeCompl c
    simp only at hfg
    have hgu : IsUnit (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (g : wcGbT W ϖ d)) :=
      IsLocalization.map_units (Localization.AtPrime (wcGbP W ϖ d)) g
    obtain ⟨gi, hgi⟩ := isUnit_iff_exists_inv.mp hgu
    have hf : f ∈ wcGbP W ϖ d := by
      by_contra hf
      apply hc
      have hfu : IsUnit (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) f) :=
        IsLocalization.map_units (Localization.AtPrime (wcGbP W ϖ d))
          (⟨f, hf⟩ : (wcGbP W ϖ d).primeCompl)
      rw [← hfg] at hfu
      exact isUnit_of_mul_isUnit_left hfu
    obtain ⟨M, hM⟩ := (Ideal.mem_radical_iff).mp hf
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hM
    have ha' := congrArg (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))) ha
    rw [map_mul, map_pow] at ha'
    have hfgM : c ^ M * algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))
        (g : wcGbT W ϖ d) ^ M =
        algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) f ^ M := by
      rw [← mul_pow, hfg]
    have hgiM : algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d))
        (g : wcGbT W ϖ d) ^ M * gi ^ M = 1 := by
      rw [← mul_pow, hgi, one_pow]
    refine ⟨M, algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) a * gi ^ M, ?_⟩
    linear_combination (-c ^ M) * hgiM + gi ^ M * hfgM - gi ^ M * ha'

  obtain ⟨M, y, h⟩ := core (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d)
    (algebraMap (Localization.AtPrime (wcGbP W ϖ d)) (wcGbVhat W ϖ d))
    (algebraMap (wcGbT W ϖ d) (Localization.AtPrime (wcGbP W ϖ d)) (wcGbt W ϖ d)) hb3
    (fun s => s2 (wcGbVhat W ϖ d) _ hser hsep s) hloc x hx
  exact ⟨M, y, h.trans (congrArg (· * y) hts.symm)⟩

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_cv_hensel : ∀ (R : Type u) [CommRing R] [IsDomain R], (∀ x y : R, x ∣ y ∨ y ∣ x) → ∀ (t : R), t ≠ 0 → ¬ IsUnit t → (∀ x : R, ¬ IsUnit x → ∃ (M : ℕ) (y : R), x ^ M = t * y) → (∀ f : ℕ → R, (∀ n : ℕ, ∃ y : R, f (n + 1) - f n = t ^ n * y) → ∃ L : R, ∀ n : ℕ, ∃ y : R, L - f n = t ^ n * y) → (∀ x : R, (∀ k : ℕ, ∃ y : R, x = t ^ k * y) → x = 0) → ∀ (F : Polynomial R) (r : ℕ), IsUnit (F.coeff r) → (∀ i < r, ¬ IsUnit (F.coeff i)) → ∃ G H : Polynomial R, G.Monic ∧ G.natDegree = r ∧ F = G * H :=
by
  open Polynomial in
  · intro R _ _ hdt t _ht0 _htnu hrad hcpl hsep F r hu hnu
    classical

    rcases Nat.eq_zero_or_pos r with hr0 | hrpos
    · subst hr0
      exact ⟨1, F, monic_one, natDegree_one, (one_mul F).symm⟩

    have step : ∀ (p : R) (k m : ℕ) (G H A B : R[X]), 1 ≤ k → G.Monic → G.natDegree = r →
        H.natDegree ≤ m → F.natDegree ≤ r + m → C p ∣ A * G + B * H - 1 → C (p ^ k) ∣ F - G * H →
        ∃ g h : R[X], (G + C (p ^ k) * g).Monic ∧ (G + C (p ^ k) * g).natDegree = r ∧
          (H + C (p ^ k) * h).natDegree ≤ m ∧
          C p ∣ A * (G + C (p ^ k) * g) + B * (H + C (p ^ k) * h) - 1 ∧
          C (p ^ (k + 1)) ∣ F - (G + C (p ^ k) * g) * (H + C (p ^ k) * h) := by
      intro p k m G H A B hk hG hGd hHd hFd hD hE
      by_cases hp : p ^ k = 0
      · have hFGH : F - G * H = 0 := by
          rw [hp, C_0, zero_dvd_iff] at hE; exact hE
        refine ⟨0, 0, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [mul_zero, add_zero]
        · exact hG
        · exact hGd
        · exact hHd
        · exact hD
        · rw [hFGH]; exact dvd_zero _
      have hp1 : p ≠ 0 := by
        rintro rfl
        exact hp (zero_pow (by omega))
      obtain ⟨e, he⟩ := hE
      obtain ⟨d, hd⟩ := hD
      have hpc : C p ∣ C (p ^ k) := _root_.map_dvd C (dvd_pow_self p (by omega))
      have hed : e.natDegree ≤ r + m := by
        have h1 : (F - G * H).natDegree ≤ r + m := by
          refine (natDegree_sub_le _ _).trans (max_le hFd ?_)
          exact natDegree_mul_le.trans (by omega)
        rw [he, natDegree_C_mul hp] at h1
        exact h1
      have hGne : G ≠ 0 := hG.ne_zero
      have hdegG : G.degree = r := by rw [degree_eq_natDegree hGne, hGd]
      have hgq := modByMonic_add_div (B * e) G
      have hgdeg := degree_modByMonic_lt (B * e) hG
      generalize (B * e) %ₘ G = g at hgq hgdeg
      generalize (B * e) /ₘ G = q at hgq
      rw [hdegG] at hgdeg
      have hgnat : g.natDegree ≤ r := natDegree_le_of_degree_le hgdeg.le
      have hρh := modByMonic_add_div (e - H * g) G
      have hρdeg := degree_modByMonic_lt (e - H * g) hG
      have hhd0 := natDegree_divByMonic (e - H * g) hG
      generalize (e - H * g) %ₘ G = ρ at hρh hρdeg
      generalize (e - H * g) /ₘ G = h at hρh hhd0
      rw [hdegG] at hρdeg
      have hhd : h.natDegree ≤ m := by
        rw [hhd0, hGd]
        have : (e - H * g).natDegree ≤ r + m :=
          (natDegree_sub_le _ _).trans (max_le hed (natDegree_mul_le.trans (by omega)))
        omega

      have hkey : ρ = G * (A * e + H * q - h) - C p * (d * e) := by
        linear_combination hρh - e * hd - H * hgq
      have hρ' := modByMonic_add_div (d * e) G
      have hρ'deg := degree_modByMonic_lt (d * e) hG
      generalize (d * e) %ₘ G = ρ' at hρ' hρ'deg
      generalize (d * e) /ₘ G = q' at hρ'
      rw [hdegG] at hρ'deg
      have h2 : ρ + C p * ρ' = G * (A * e + H * q - h - C p * q') := by
        linear_combination hkey + C p * hρ'
      have hLdeg : (ρ + C p * ρ').degree < G.degree := by
        rw [hdegG]
        refine lt_of_le_of_lt (degree_add_le _ _) (max_lt hρdeg ?_)
        rw [degree_C_mul hp1]; exact hρ'deg
      have hL0 : ρ + C p * ρ' = 0 := by
        have e1 : (ρ + C p * ρ') %ₘ G = ρ + C p * ρ' := (modByMonic_eq_self_iff hG).mpr hLdeg
        have e2 : (ρ + C p * ρ') %ₘ G = 0 := (modByMonic_eq_zero_iff_dvd hG).mpr ⟨_, h2⟩
        rw [← e1, e2]
      have hpρ : C p ∣ ρ := ⟨-ρ', by linear_combination hL0⟩
      refine ⟨g, h, ?_, ?_, ?_, ?_, ?_⟩
      · have : (C (p ^ k) * g).degree < G.degree := by rw [degree_C_mul hp, hdegG]; exact hgdeg
        exact hG.add_of_left this
      · have : (C (p ^ k) * g).degree < G.degree := by rw [degree_C_mul hp, hdegG]; exact hgdeg
        rw [natDegree_add_eq_left_of_degree_lt this, hGd]
      · exact (natDegree_add_le _ _).trans (max_le hHd ((natDegree_C_mul_le _ _).trans hhd))
      · have : A * (G + C (p ^ k) * g) + B * (H + C (p ^ k) * h) - 1 =
            C p * d + C (p ^ k) * (A * g + B * h) := by linear_combination hd
        rw [this]
        exact dvd_add (dvd_mul_right _ _) (dvd_mul_of_dvd_left hpc _)
      · have e3 : F - (G + C (p ^ k) * g) * (H + C (p ^ k) * h) =
            C (p ^ k) * ρ - C (p ^ k) * (C (p ^ k) * (g * h)) := by
          linear_combination he - C (p ^ k) * hρh
        have e4 : C (p ^ (k + 1)) = C (p ^ k) * C p := by rw [← C_mul, pow_succ]
        rw [e3, e4]
        exact dvd_sub (mul_dvd_mul_left _ hpρ) (mul_dvd_mul_left _ (dvd_mul_of_dvd_left hpc _))

    have plim : ∀ (N : ℕ) (P : ℕ → R[X]), (∀ j, (P j).natDegree ≤ N) →
        (∀ j, C (t ^ j) ∣ P (j + 1) - P j) →
        ∃ Q : R[X], Q.natDegree ≤ N ∧ ∀ j, C (t ^ j) ∣ Q - P j := by
      intro N P hPd hP
      have hL : ∀ i, ∃ L : R, ∀ n, ∃ y, L - (P n).coeff i = t ^ n * y := by
        intro i
        apply hcpl
