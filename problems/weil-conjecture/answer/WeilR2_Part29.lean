      intro s f t
      induction s using Finset.induction_on with
      | empty => exact ⟨t, Or.inl rfl, dvd_refl t, fun i hi => by simp at hi⟩
      | insert j s' hj ih =>
        obtain ⟨b', hb'mem, hb't, hb'f⟩ := ih
        rcases ValuationRing.dvd_total b' (f j) with hd | hd
