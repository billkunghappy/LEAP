      have hcoef := hli ![bb.repr x 0 * algebraMap S L a + bb.repr x 1 * algebraMap S L c,
        bb.repr x 0 * algebraMap S L b + bb.repr x 1 * algebraMap S L d] (by
          rw [Fin.sum_univ_two, ← hx]
