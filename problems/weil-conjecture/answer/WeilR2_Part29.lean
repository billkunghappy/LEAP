      push_neg at hc
      obtain ⟨h0, hi⟩ := hc
      apply hnu
      refine ⟨⟨⟨x, hx⟩, ⟨x⁻¹, (hmem _).mpr hi⟩, ?_, ?_⟩, rfl⟩
