n d) ↥W)}) (MvPolynomial (Fin d) ↥W)), q * (algebraMap (MvPolynomial (Fin (d + 1)) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)}) (MvPolynomial (Fin (d + 1)) ↥W)) (MvPolynomial.C u * MvPolynomial.X 0 ^ N + L) + algebraMap (MvPolynomial (Fin (d + 1)) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)}) (MvPolynomial (Fin (d + 1)) ↥W)) (MvPolynomial.C ρ) * Y) = algebraMap (MvPolynomial (Fin (d + 1)) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)}) (MvPolynomial (Fin (d + 1)) ↥W)) (MvPolynomial.X 0) ^ N - ∑ i, ι (r i) * algebraMap (MvPolynomial (Fin (d + 1)) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)}) (MvPolynomial (Fin (d + 1)) ↥W)) (MvPolynomial.X 0) ^ (i : ℕ) → IsUnit (red₁ q) :=
by
