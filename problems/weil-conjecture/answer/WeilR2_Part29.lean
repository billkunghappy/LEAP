  have unit_split : ∀ (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] (n : ℕ)
      (F : MvPolynomial (Fin n) R), (∃ e, F.coeff e = 1) →
      ∃ (U V : MvPolynomial (Fin n) R) (ρ : R), U ≠ 0 ∧ (∀ e ∈ U.support, IsUnit (U.coeff e)) ∧
        ¬ IsUnit ρ ∧ F = U + MvPolynomial.C ρ * V := by
    intro R _ _ _ n F he1
    classical
    have claim : ∀ s : Finset (Fin n →₀ ℕ), ∃ ρ : R, ¬ IsUnit ρ ∧
        ∀ e ∈ s, ¬ IsUnit (F.coeff e) → ρ ∣ F.coeff e := by
      intro s
      induction s using Finset.induction_on with
      | empty => exact ⟨0, not_isUnit_zero, fun e he => absurd he (Finset.notMem_empty e)⟩
      | insert a s ha ih =>
        obtain ⟨ρ, hρ, hdiv⟩ := ih
        by_cases hua : IsUnit (F.coeff a)
        · refine ⟨ρ, hρ, fun e he hne => ?_⟩
          rcases Finset.mem_insert.mp he with rfl | he'
          · exact absurd hua hne
          · exact hdiv e he' hne
        · rcases ValuationRing.dvd_total ρ (F.coeff a) with h | h
          · refine ⟨ρ, hρ, fun e he hne => ?_⟩
            rcases Finset.mem_insert.mp he with rfl | he'
            · exact h
            · exact hdiv e he' hne
          · refine ⟨F.coeff a, hua, fun e he hne => ?_⟩
            rcases Finset.mem_insert.mp he with rfl | he'
            · exact dvd_refl _
            · exact h.trans (hdiv e he' hne)
    obtain ⟨ρ, hρ, hdiv⟩ := claim F.support
    let U : MvPolynomial (Fin n) R := ∑ e ∈ F.support.filter (fun e => IsUnit (F.coeff e)),
      MvPolynomial.monomial e (F.coeff e)
    have hUc : ∀ e, U.coeff e = if IsUnit (F.coeff e) then F.coeff e else 0 := by
      intro e
      simp only [U, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
      by_cases hu : IsUnit (F.coeff e)
      · have : F.coeff e ≠ 0 := hu.ne_zero
        simp [hu, MvPolynomial.mem_support_iff, this]
      · simp [hu]
    have hdvd : MvPolynomial.C ρ ∣ F - U := by
      rw [MvPolynomial.C_dvd_iff_dvd_coeff]
      intro e
      rw [MvPolynomial.coeff_sub, hUc]
      by_cases hu : IsUnit (F.coeff e)
      · rw [if_pos hu, sub_self]; exact dvd_zero _
      · rw [if_neg hu, sub_zero]
        by_cases h0 : F.coeff e = 0
        · rw [h0]; exact dvd_zero _
        · exact hdiv e (MvPolynomial.mem_support_iff.mpr h0) hu
    obtain ⟨V, hV⟩ := hdvd
    obtain ⟨e1, he1⟩ := he1
    refine ⟨U, V, ρ, ?_, ?_, hρ, ?_⟩
    · intro h0
      have := hUc e1
      rw [h0, MvPolynomial.coeff_zero, he1, if_pos isUnit_one] at this
      exact zero_ne_one this
    · intro e he
      rw [MvPolynomial.mem_support_iff, hUc] at he
      rw [hUc]
      split_ifs at he ⊢ with hu
      · exact hu
      · exact absurd rfl he
