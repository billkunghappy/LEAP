            algebraMap S L c • KaehlerDifferential.D R L (algebraMap S L T₁)) := by
          have h' : e 1 = ((v⁻¹ : Lˣ) : L) • ((v : L) • e 1) := by
            rw [smul_smul, Units.inv_mul, one_smul]
          rw [h', hv, h₁L, h₂L]
          module
        show e 1 ∈ _
        rw [key]
        exact Submodule.smul_mem _ _ (Submodule.sub_mem _ (Submodule.smul_mem _ _ hT2)
