          P0 _ _ (hI a (Finset.mem_insert_self a S)) ih1 (hN a (Finset.mem_insert_self a S)) ih2⟩

    obtain ⟨p, hpm, hpy⟩ : ∃ p : Polynomial R, p.Monic ∧
