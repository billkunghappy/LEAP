    · intro j
      fin_cases j
      · show (Φ.comp (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom) 1 = t 0 0
        rw [map_one, ht00]
      · show (Φ.comp (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 2) ↥W ⧸ I))).hom.hom)
