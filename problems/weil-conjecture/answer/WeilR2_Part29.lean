theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_inertia_closure_prop : ∀ (V K N : Type u) [CommRing V] [Field K] [Field N] [Algebra V K] [Algebra K N] [Algebra V N] [IsScalarTower V K N], (∀ y z : N, IsIntegral V y → IsIntegral V z → ∃ w : N, IsIntegral V w ∧ (y = w * z ∨ z = w * y)) → ∀ σ ∈ Subgroup.closure {σ : N ≃ₐ[K] N | ∀ x : N, IsIntegral V x → IsIntegral V (σ x - x) ∧ (σ x - x = 0 ∨ ¬ IsIntegral V (σ x - x)⁻¹)}, ∀ x : N, IsIntegral V x → IsIntegral V (σ x - x) ∧ (σ x - x = 0 ∨ ¬ IsIntegral V (σ x - x)⁻¹) :=
