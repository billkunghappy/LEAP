theorem wcpa_dj_lr1s_nf_cnf_bd_tnn_domain : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ), IsDomain (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) :=
by
  classical
  have crit : ∀ (T D : Type u) [CommRing T] [CommRing D] [IsDomain D] (ρ : T →+* D) (t : T),
      (∀ y : T, t * y = 0 → y = 0) →
      (∀ y : T, y ≠ 0 → ∃ (a b y₀ : T) (k : ℕ), a * b = t ^ k ∧ y = a * y₀ ∧ ρ y₀ ≠ 0) →
      ((0 : T) ≠ 1 ∧ ∀ x y : T, x * y = 0 → x = 0 ∨ y = 0) := by
    intro T D _ _ _ ρ t ht hc
    have tfk : ∀ (n : ℕ) (z : T), t ^ n * z = 0 → z = 0 := by
      intro n
      induction n with
      | zero => intro z hz; simpa using hz
      | succ n ih =>
        intro z hz
        apply ht
        apply ih
        rw [← mul_assoc, ← pow_succ]
        exact hz
    refine ⟨fun h => ?_, fun x y hxy => ?_⟩
    · have h' := congrArg ρ h
      rw [map_zero, map_one] at h'
      exact zero_ne_one h'
    · by_contra hne
      rw [not_or] at hne
      obtain ⟨a, b, x₀, k, hab, hx, hx₀⟩ := hc x hne.1
      obtain ⟨a', b', y₀, k', hab', hy, hy₀⟩ := hc y hne.2
      have h1 : t ^ (k + k') * (x₀ * y₀) = 0 := by
        have e : t ^ (k + k') * (x₀ * y₀) = (b * b') * (x * y) := by
          rw [pow_add, ← hab, ← hab', hx, hy]; ring
        rw [e, hxy, mul_zero]
      have h2 := tfk _ _ h1
      have h3 : ρ x₀ * ρ y₀ = 0 := by rw [← map_mul, h2, map_zero]
      rcases mul_eq_zero.mp h3 with h | h
      · exact hx₀ h
      · exact hy₀ h
  intro Ω _ W ϖ hϖ0 hϖnu d
  have hres : ∀ μ : ↥W, ¬ IsUnit μ → IsLocalRing.residue ↥W μ = 0 := by
    intro μ hμ
    rw [IsLocalRing.residue_eq_zero_iff]
    exact hμ
  let mres : MvPolynomial (Fin d) ↥W →+* MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W) :=
    MvPolynomial.map (IsLocalRing.residue ↥W)
  have H : ∀ z ∈ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) ^ 1, mres z = 0 := by
