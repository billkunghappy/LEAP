    wcpa_dj_lr1k_gc_function_field_separable (wcProjK Ω 1) Ct φ hφf hgen
  letI : Algebra (wcProjK Ω 1).functionField Ct.functionField :=
    ((wcProjK Ω 1).presheaf.stalkSpecializes hgenpt ≫ φ.stalkMap (genericPoint Ct)).hom.toAlgebra
  haveI := hfd
  haveI := hsep

  let ι : Ct.functionField →ₐ[(wcProjK Ω 1).functionField]
      SeparableClosure (wcProjK Ω 1).functionField := IsSepClosed.lift
  let N := IntermediateField.normalClosure (wcProjK Ω 1).functionField Ct.functionField
    (SeparableClosure (wcProjK Ω 1).functionField)
  haveI hNgal : IsGalois (wcProjK Ω 1).functionField N := IsGalois.normalClosure _ _ _
  haveI hNfd : FiniteDimensional (wcProjK Ω 1).functionField N :=
    normalClosure.is_finiteDimensional _ _ _
  have hmem : ∀ x, ι x ∈ N := fun x =>
    AlgHom.fieldRange_le_normalClosure ι (AlgHom.mem_fieldRange.mpr ⟨x, rfl⟩)
  let ψ : Ct.functionField →+* N :=
    { toFun := fun x => ⟨ι x, hmem x⟩
      map_one' := Subtype.ext (map_one ι)
      map_mul' := fun x y => Subtype.ext (map_mul ι x y)
      map_zero' := Subtype.ext (map_zero ι)
      map_add' := fun x y => Subtype.ext (map_add ι x y) }
  have hψ : ∀ a, ψ (algebraMap (wcProjK Ω 1).functionField Ct.functionField a) =
      algebraMap (wcProjK Ω 1).functionField N a :=
    fun a => Subtype.ext (ι.commutes a)
  let ψc : Ct.functionField ⟶ CommRingCat.of N := CommRingCat.ofHom ψ

  have H0 : Spec.map (CommRingCat.ofHom (algebraMap (wcProjK Ω 1).functionField N)) ≫
      (wcProjK Ω 1).fromSpecStalk (genericPoint (wcProjK Ω 1)) =
      (Spec.map ψc ≫ Ct.fromSpecStalk (genericPoint Ct)) ≫ φ := by
    have hφ' : ((wcProjK Ω 1).presheaf.stalkSpecializes hgenpt ≫ φ.stalkMap (genericPoint Ct)) ≫ ψc
        = CommRingCat.ofHom (algebraMap (wcProjK Ω 1).functionField N) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact hψ a
    have hsp : Spec.map (((wcProjK Ω 1).presheaf.stalkSpecializes hgenpt ≫
        φ.stalkMap (genericPoint Ct)) ≫ ψc) =
        Spec.map ψc ≫ Spec.map (φ.stalkMap (genericPoint Ct)) ≫
          Spec.map ((wcProjK Ω 1).presheaf.stalkSpecializes hgenpt) := by
      rw [Spec.map_comp, Spec.map_comp]
    rw [Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
      ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgenpt, ← hφ', hsp]
    simp only [Category.assoc]
  have hs : ∀ σ : N ≃ₐ[(wcProjK Ω 1).functionField] N,
      Spec.map (CommRingCat.ofHom (σ : N →+* N)) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap (wcProjK Ω 1).functionField N)) ≫
          (wcProjK Ω 1).fromSpecStalk (genericPoint (wcProjK Ω 1))) =
        Spec.map (CommRingCat.ofHom (algebraMap (wcProjK Ω 1).functionField N)) ≫
          (wcProjK Ω 1).fromSpecStalk (genericPoint (wcProjK Ω 1)) := by
    intro σ
    have e : (σ : N →+* N).comp (algebraMap (wcProjK Ω 1).functionField N) =
        algebraMap (wcProjK Ω 1).functionField N := RingHom.ext fun x => σ.commutes x
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, e]
  have hmul : ∀ σ τ : N ≃ₐ[(wcProjK Ω 1).functionField] N,
      Spec.map (CommRingCat.ofHom (σ : N →+* N)) ≫ Spec.map (CommRingCat.ofHom (τ : N →+* N)) =
      Spec.map (CommRingCat.ofHom ((σ * τ : N ≃ₐ[(wcProjK Ω 1).functionField] N) : N →+* N)) := by
    intro σ τ
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  generalize hf : Spec.map (CommRingCat.ofHom (algebraMap (wcProjK Ω 1).functionField N)) ≫
      (wcProjK Ω 1).fromSpecStalk (genericPoint (wcProjK Ω 1)) = f at H0 hs
  have : QuasiCompact f := by subst hf; infer_instance
  have : QuasiSeparated f := by subst hf; infer_instance
  let π : f.normalization ⟶ Ct :=
    f.normalizationDesc (Spec.map ψc ≫ Ct.fromSpecStalk (genericPoint Ct)) φ H0
  have hπγ : π ≫ φ = f.fromNormalization := Scheme.Hom.normalizationDesc_comp _ _ _ _
  have hπt : f.toNormalization ≫ π = Spec.map ψc ≫ Ct.fromSpecStalk (genericPoint Ct) :=
    Scheme.Hom.toNormalization_normalizationDesc _ _ _ _

  have hγfin : IsFinite f.fromNormalization :=
    wcpa_dj_lr1k_gc_norm_finite (wcProjK Ω 1) N f hf.symm hPnorm
  haveI := hγfin
  have hγsurj : Surjective f.fromNormalization := by
    constructor
    have hcl : IsClosed (Set.range f.fromNormalization) :=
      f.fromNormalization.isClosedMap.isClosed_range
    obtain ⟨pt⟩ : Nonempty (Spec (.of N)) := inferInstance
    have hy : f.fromNormalization (f.toNormalization pt) ⤳ genericPoint (wcProjK Ω 1) := by
      have e1 : f.fromNormalization (f.toNormalization pt) = f pt := by
        rw [← Scheme.Hom.comp_apply, Scheme.Hom.toNormalization_fromNormalization]
      rw [e1, ← hf, Scheme.Hom.comp_apply]
      have hmem' : (wcProjK Ω 1).fromSpecStalk (genericPoint (wcProjK Ω 1))
          (Spec.map (CommRingCat.ofHom (algebraMap (wcProjK Ω 1).functionField N)) pt) ∈
          Set.range ((wcProjK Ω 1).fromSpecStalk (genericPoint (wcProjK Ω 1))) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hmem'
      exact hmem'
    have hη : genericPoint (wcProjK Ω 1) ∈ Set.range f.fromNormalization :=
      hy.mem_closed hcl ⟨_, rfl⟩
    have hsub := ((genericPoint_spec (wcProjK Ω 1)).mem_closed_set_iff hcl).mp hη
    exact Set.range_eq_univ.mp (Set.eq_univ_of_univ_subset hsub)
  have hCnorm := wcpa_dj_lr1k_gc_norm_stalk_normal (wcProjK Ω 1) N f hf.symm
  obtain ⟨V, hVne, hVet⟩ := wcpa_dj_lr1k_gc_norm_generic_etale (wcProjK Ω 1) N f hf.symm hPnorm
  have hCsm : SmoothOfRelativeDimension 1 (f.fromNormalization ≫ wcProjKStr Ω 1) :=
    wcpa_dj_lr1k_gc_normal_curve_smooth Ω f.normalization f.fromNormalization hγfin hγsurj hCnorm
  have hCproj : wcpaDjIsProjOver Ω (f.fromNormalization ≫ wcProjKStr Ω 1) :=
    wcpa_dj_lr1s_finite_proj_ring Ω f.fromNormalization (wcProjKStr Ω 1) hγfin
      ⟨1, 𝟙 _, inferInstance, Category.id_comp _⟩
  have hVdense : Dense (V : Set f.normalization) := by
    obtain ⟨⟨v, hv⟩⟩ := hVne
    exact V.isOpen.dense ⟨v, hv⟩
  have hcovC : wcpaDjLkCov Ω f.fromNormalization :=
    ⟨hCproj, hCsm, inferInstance, hγfin, ⟨V, hVdense, hVet⟩⟩

  haveI : IsFinite (π ≫ φ) := hπγ ▸ hγfin
  have hπfin : IsFinite π := IsFinite.of_comp π φ
  haveI := hπfin
  have hπsurj : Surjective π := by
    constructor
    have hcl : IsClosed (Set.range π) := π.isClosedMap.isClosed_range
    obtain ⟨pt⟩ : Nonempty (Spec (.of N)) := inferInstance
    have hy : π (f.toNormalization pt) ⤳ genericPoint Ct := by
      have e1 : π (f.toNormalization pt) =
          Ct.fromSpecStalk (genericPoint Ct) (Spec.map ψc pt) := by
        rw [← Scheme.Hom.comp_apply, hπt, Scheme.Hom.comp_apply]
      rw [e1]
      have hmem' : Ct.fromSpecStalk (genericPoint Ct) (Spec.map ψc pt) ∈
          Set.range (Ct.fromSpecStalk (genericPoint Ct)) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hmem'
      exact hmem'
    have hη : genericPoint Ct ∈ Set.range π := hy.mem_closed hcl ⟨_, rfl⟩
    have hsub := ((genericPoint_spec Ct).mem_closed_set_iff hcl).mp hη
    exact Set.range_eq_univ.mp (Set.eq_univ_of_univ_subset hsub)

  let act : (N ≃ₐ[(wcProjK Ω 1).functionField] N) → (f.normalization ⟶ f.normalization) :=
    fun σ => f.normalizationDesc (Spec.map (CommRingCat.ofHom (σ : N →+* N)) ≫ f.toNormalization)
      f.fromNormalization
      (by rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, hs])
  have h₁ : ∀ σ, f.toNormalization ≫ act σ =
      Spec.map (CommRingCat.ofHom (σ : N →+* N)) ≫ f.toNormalization := fun σ =>
    Scheme.Hom.toNormalization_normalizationDesc _ _ _ _
  have h₂ : ∀ σ, act σ ≫ f.fromNormalization = f.fromNormalization := fun σ =>
    Scheme.Hom.normalizationDesc_comp _ _ _ _
  have h₃ : ∀ σ τ, act σ ≫ act τ = act (σ * τ) := by
    intro σ τ
    apply Scheme.Hom.normalization.hom_ext f _ _ f.fromNormalization
    · rw [reassoc_of% (h₁ σ), h₁ τ, h₁ (σ * τ), ← Category.assoc, hmul]
    · rw [Category.assoc, h₂, h₂]
    · exact h₂ _
  have hact1 : act 1 = 𝟙 _ := by
    apply Scheme.Hom.normalization.hom_ext f _ _ f.fromNormalization
    · rw [h₁, Category.comp_id]
      have e : CommRingCat.ofHom ((1 : N ≃ₐ[(wcProjK Ω 1).functionField] N) : N →+* N) =
          𝟙 (CommRingCat.of N) := by
        ext x
        rfl
      rw [e, Spec.map_id, Category.id_comp]
    · exact h₂ 1
    · exact Category.id_comp _
  let a : (N ≃ₐ[(wcProjK Ω 1).functionField] N) → (f.normalization ≅ f.normalization) :=
    fun σ =>
      { hom := act σ
        inv := act σ⁻¹
        hom_inv_id := by rw [h₃, mul_inv_cancel, hact1]
        inv_hom_id := by rw [h₃, inv_mul_cancel, hact1] }

  have hgeo := wc_fsus_normalization_geom_transitive
    (wc_fsus_intclosure_geom_transitive wc_fsus_alg_geom_transitive wc_fsus_fixed_pow_mem)
    Ω (wcProjK Ω 1) (wcProjKStr Ω 1) (wc_fsus_affine_sections_intclosed (wcProjK Ω 1) hPnorm)
    N f hf.symm act h₁ h₂

  have htop : ∀ c c' : f.normalization, f.fromNormalization c = f.fromNormalization c' →
      ∃ σ, act σ c = c' := by
    intro c c' hcc
    obtain ⟨w, hw1, hw2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := f.fromNormalization) (g := f.fromNormalization) c c' hcc
    obtain ⟨σ, hσ⟩ := hgeo ((Limits.pullback f.fromNormalization f.fromNormalization).residueField w)
      ((Limits.pullback f.fromNormalization f.fromNormalization).fromSpecResidueField w ≫
        Limits.pullback.fst f.fromNormalization f.fromNormalization)
      ((Limits.pullback f.fromNormalization f.fromNormalization).fromSpecResidueField w ≫
        Limits.pullback.snd f.fromNormalization f.fromNormalization)
      (by rw [Category.assoc, Category.assoc, Limits.pullback.condition])
    refine ⟨σ, ?_⟩
    have k1 : act σ (Limits.pullback.fst f.fromNormalization f.fromNormalization
        ((Limits.pullback f.fromNormalization f.fromNormalization).fromSpecResidueField w
          (IsLocalRing.closedPoint
            ((Limits.pullback f.fromNormalization f.fromNormalization).residueField w)))) =
        Limits.pullback.snd f.fromNormalization f.fromNormalization
        ((Limits.pullback f.fromNormalization f.fromNormalization).fromSpecResidueField w
          (IsLocalRing.closedPoint
            ((Limits.pullback f.fromNormalization f.fromNormalization).residueField w))) := by
      have := congrArg (fun g => g (IsLocalRing.closedPoint
        ((Limits.pullback f.fromNormalization f.fromNormalization).residueField w))) hσ
      exact this
    have p : (Limits.pullback f.fromNormalization f.fromNormalization).fromSpecResidueField w
          (IsLocalRing.closedPoint
            ((Limits.pullback f.fromNormalization f.fromNormalization).residueField w)) = w :=
      Scheme.fromSpecResidueField_apply w _
    rw [p, hw1, hw2] at k1
    exact k1

  refine ⟨f.normalization, π, hπfin, hπsurj, ?_, ?_⟩
  · rw [hπγ]
    exact hcovC
  · rw [hπγ]
    intro c c' hcc
    obtain ⟨σ, hσ⟩ := htop c c' hcc
    exact ⟨a σ, h₂ σ, hσ⟩

theorem wcpa_dj_lpm_proj_space_bc_iso : ∀ (F F' : Type u) [CommRing F] [CommRing F'] [Algebra F F'] (N : ℕ), ∃ e : Limits.pullback (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0)))) (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') MvPolynomial.gradedAlgebra, IsIso e ∧ e ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Limits.pullback.snd _ _ :=
by
  have s6 : ∀ {W X Y Z : Scheme.{u}} (φ : W ⟶ X) (p' : W ⟶ Y) (p : X ⟶ Z) (g : Y ⟶ Z) {ι : Type}
      (U U' : ι → Scheme.{u}) (j : ∀ i, U i ⟶ X) (j' : ∀ i, U' i ⟶ W) (φi : ∀ i, U' i ⟶ U i)
      [∀ i, IsOpenImmersion (j i)] [∀ i, IsOpenImmersion (j' i)],
      (⨆ i, (j i).opensRange) = ⊤ → (∀ i, j' i ≫ φ = φi i ≫ j i) →
      (∀ i, φ ⁻¹ᵁ (j i).opensRange = (j' i).opensRange) →
      (∀ i, IsPullback (φi i) (j' i ≫ p') (j i ≫ p) g) → IsPullback φ p' p g := by
    intro W X Y Z φ p' p g ι U U' j j' φi hjI hj'I hcov hcomm hpre hpb
    have hc : ∀ x : X, ∃ i y, j i y = x := by
      intro x
      have hx : x ∈ (⨆ i, (j i).opensRange) := by rw [hcov]; trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      obtain ⟨y, hy⟩ := Scheme.Hom.mem_opensRange.mp hi
      exact ⟨i, y, hy⟩
    refine Scheme.isPullback_of_openCover φ p' p g
      (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι U j hc) ?_
    intro i
    have Q := (@IsOpenImmersion.isPullback _ _ _ _ (φi i) (j' i) (j i) φ (hj'I i) (hjI i)
      (hcomm i) (hpre i)).flip
    refine IsPullback.of_iso (hpb i) Q.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · show φi i ≫ 𝟙 _ = Q.isoPullback.hom ≫ Limits.pullback.snd φ (j i)
      rw [Category.comp_id, IsPullback.isoPullback_hom_snd]
    · show (j' i ≫ p') ≫ 𝟙 _ = Q.isoPullback.hom ≫ (Limits.pullback.fst φ (j i) ≫ p')
      rw [Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst]
    · show (j i ≫ p) ≫ 𝟙 _ = 𝟙 _ ≫ (j i ≫ p)
      rw [Category.comp_id, Category.id_comp]
    · show g ≫ 𝟙 _ = 𝟙 _ ≫ g
      rw [Category.comp_id, Category.id_comp]
  intro F F' _ _ _ N
  have s2 : ∀ (K : Type u) [CommRing K] (a : Fin (N + 1)),
      letI := (MvPolynomial.gradedAlgebra :
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K));
      ∀ (s : MvPolynomial (Fin (N + 1)) K), s = MvPolynomial.X a →
      ∃ e : MvPolynomial (Fin N) K ≃+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) s,
      (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers s)
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
      ∀ j : Fin N, (e (MvPolynomial.X j)).val =
        Localization.mk (MvPolynomial.X (a.succAbove j)) ⟨s, Submonoid.mem_powers s⟩ := by
    intro K _ a
    letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
    intro s hs
    subst hs
    have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (N + 1) → S) (t : S) (n : ℕ)
        (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous n →
        MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
      intro S _ φ x t n F hF
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : Finsupp.degree d = n := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
        simp only [mul_pow]
        rw [Finsupp.prod_mul]
        congr 1
        rw [← hdeg, Finsupp.degree_apply]
        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hX : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
    have hg : ∀ i : Fin N, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)
    obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin N) K →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a),
        (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) ∧
        (∀ i : Fin N, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) hX 1
          (MvPolynomial.X (a.succAbove i)) (hg i)) :=
      ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
        (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
        fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
        fun i => by rw [MvPolynomial.eval₂Hom_X']⟩
    obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin N) K,
        (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
        (∀ i : Fin N, ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin N) K) a 1 MvPolynomial.X),
        fun c => by rw [MvPolynomial.eval₂Hom_C],
        by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
        fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
    have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one
    have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) *
        algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K)) (MvPolynomial.X a) = 1 := by
