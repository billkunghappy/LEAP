  exact ⟨c, by rw [← hc]; simp [Algebra.smul_def]⟩

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_vhat_valuation : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) [(wcGbP W ϖ d).IsPrime], (∀ f : wcGbT W ϖ d, f ≠ 0 → ∃ (c : ↥W) (N : ℕ) (f₀ : wcGbT W ϖ d), c ≠ 0 ∧ c ∣ ϖ ^ N ∧ f₀ ∉ wcGbP W ϖ d ∧ f = algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) * f₀) → (∀ x y : wcGbT W ϖ d, ∃ u z : wcGbT W ϖ d, u ∉ wcGbP W ϖ d ∧ (u * x = z * y ∨ u * y = z * x)) → IsDomain (wcGbVhat W ϖ d) ∧ (∀ x y : wcGbVhat W ϖ d, x ∣ y ∨ y ∣ x) ∧ ¬ IsUnit (algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d)) ∧ ∀ x : wcGbVhat W ϖ d, x ≠ 0 → ∃ N : ℕ, x ∣ algebraMap (wcGbT W ϖ d) (wcGbVhat W ϖ d) (wcGbt W ϖ d) ^ N :=
by
  intro Ω _ _ W _hW ϖ hϖ0 hϖnu d _ hcont hval
  classical

  have s2 : ∀ (A : Type u) [CommRing A] (τ : A),
      (∀ f : ℕ → A, (∀ n : ℕ, ∃ y : A, f (n + 1) - f n = τ ^ n * y) →
        ∃ L : A, ∀ n : ℕ, ∃ y : A, L - f n = τ ^ n * y) →
      (∀ x : A, (∀ k : ℕ, ∃ y : A, x = τ ^ k * y) → x = 0) →
      ∀ s : A, IsUnit (1 + τ * s) := by
    intro A _ τ hser hsep s
    obtain ⟨L, hL⟩ := hser (fun n => ∑ i ∈ Finset.range n, (-(τ * s)) ^ i) (fun n =>
      ⟨(-s) ^ n, by rw [Finset.sum_range_succ, add_sub_cancel_left, neg_mul_eq_mul_neg, mul_pow]⟩)
    have h0 : (1 + τ * s) * L - 1 = 0 := by
      apply hsep
      intro k
      obtain ⟨y, hy⟩ := hL k
      refine ⟨(1 + τ * s) * y - (-s) ^ k, ?_⟩
      have hg := mul_neg_geom_sum (-(τ * s)) k
      have hq : (-(τ * s)) ^ k = τ ^ k * (-s) ^ k := by rw [neg_mul_eq_mul_neg, mul_pow]
      linear_combination (1 + τ * s) * hy + hg - hq
    exact isUnit_iff_exists_inv.mpr ⟨L, by linear_combination h0⟩

  have s3 : ∀ (R A : Type u) [CommRing R] [CommRing A] (ι : R →+* A) (r : R),
      (∀ (n : ℕ) (y : A), ∃ (c : R) (y' : A), y = ι c + ι r ^ n * y') →
      (∀ x : A, (∀ k : ℕ, ∃ y : A, x = ι r ^ k * y) → x = 0) →
      (∀ x y : R, x ∣ y ∨ y ∣ x) →
      ∀ x : A, ∃ (v : R) (s : A), x = ι v * (1 + ι r * s) := by
    intro R A _ _ ι r hb3 hsep htot x
    by_cases hx : x = 0
    · exact ⟨0, 0, by rw [hx, map_zero, zero_mul]⟩
    have hk : ∃ k : ℕ, ¬ ∃ y : A, x = ι r ^ k * y := by
