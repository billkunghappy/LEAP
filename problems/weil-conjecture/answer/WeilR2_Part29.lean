      · show (MvPolynomial.eval₂Hom ((r₀.appLE ⊤ (U 1) (by simp)).hom.comp
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom.comp MvPolynomial.C))
          (fun _ => t 1 0)) ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).hom.hom 1) = t 1 1
        rw [map_one, map_one, ht11]
  · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, e0]
  · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, e1]
  · intro heq
    have h2' : PrimeSpectrum.comap (CommRingCat.ofHom (MvPolynomial.eval fun _ : Fin 1 => (0 : ↥W))).hom
