    have key : ∀ n : ℕ, ∃ y : T, h - qL * g - ∑ i, ι (ρL i) * x ^ (i : ℕ) = t ^ n * y := by
      intro n
      obtain ⟨a, ha⟩ := hqL n
      choose b hb using fun i => hρL i n
      refine ⟨Hs n - a * g - ∑ i, ι (b i) * x ^ (i : ℕ), ?_⟩
      have hsum : ∑ i, ι (ρL i) * x ^ (i : ℕ) = ∑ i, ι (ρ n i) * x ^ (i : ℕ) +
          t ^ n * ∑ i, ι (b i) * x ^ (i : ℕ) := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        have : ρL i = ρ n i + tR ^ n * b i := by rw [← hb i]; ring
        rw [this, map_add, map_mul, map_pow, hι]; ring
      have hq' : qL = q n + t ^ n * a := by rw [← ha]; ring
      rw [hsum, hq']
      linear_combination inv n
    have hE := hS _ key
    linear_combination hE

  have c5 : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (r : R) (s : S), ψ r = s → ∃ Ψ : AdicCompletion (Ideal.span {r}) R →+* AdicCompletion (Ideal.span {s}) S, (∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R), AdicCompletion.evalₐ (Ideal.span {r}) n x = Ideal.Quotient.mk (Ideal.span {r} ^ n) a → AdicCompletion.evalₐ (Ideal.span {s}) n (Ψ x) = Ideal.Quotient.mk (Ideal.span {s} ^ n) (ψ a)) ∧ ∀ a : R, Ψ (algebraMap R (AdicCompletion (Ideal.span {r}) R) a) = algebraMap S (AdicCompletion (Ideal.span {s}) S) (ψ a) := by
    have s0 : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x : AdicCompletion I R) (m n : ℕ)
        (h : m ≤ n), Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) =
          AdicCompletion.evalₐ I m x := by
      intro R _ I x m n h
      obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I R x
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
      show Ideal.Quotient.factor _ (Ideal.Quotient.mk _ _) = _
      rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk h c
      rw [Submodule.Quotient.eq] at hc
      rw [Ideal.smul_eq_mul, Ideal.mul_top] at hc
      exact hc
    intro R S _ _ ψ r s hrs
    have hle : ∀ k : ℕ, Ideal.span {r} ^ k ≤ Ideal.comap ψ (Ideal.span {s} ^ k) := by
      intro k
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow, Ideal.map_span, Set.image_singleton, hrs]
    let f : ∀ k : ℕ, AdicCompletion (Ideal.span {r}) R →+* S ⧸ Ideal.span {s} ^ k := fun k =>
      (Ideal.quotientMap (Ideal.span {s} ^ k) ψ (hle k)).comp
        (AdicCompletion.evalₐ (Ideal.span {r}) k :
          AdicCompletion (Ideal.span {r}) R →+* R ⧸ Ideal.span {r} ^ k)
    have hfv : ∀ (k : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
        AdicCompletion.evalₐ (Ideal.span {r}) k x = Ideal.Quotient.mk (Ideal.span {r} ^ k) a →
        f k x = Ideal.Quotient.mk (Ideal.span {s} ^ k) (ψ a) := by
      intro k x a ha
      show Ideal.quotientMap (Ideal.span {s} ^ k) ψ (hle k)
        (AdicCompletion.evalₐ (Ideal.span {r}) k x) = _
      rw [ha, Ideal.quotientMap_mk]
    have hf : ∀ {m n : ℕ} (h : m ≤ n),
        (Ideal.Quotient.factorPow (Ideal.span {s}) h).comp (f n) = f m := by
      intro m n h
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (Ideal.span {r}) n x)
      have ham : AdicCompletion.evalₐ (Ideal.span {r}) m x =
          Ideal.Quotient.mk (Ideal.span {r} ^ m) a := by
        rw [← s0 R _ x m n h, ← ha]
        rfl
      rw [RingHom.comp_apply, hfv n x a ha.symm, hfv m x a ham]
      rfl
    have hΨ : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R) (a : R),
        AdicCompletion.evalₐ (Ideal.span {r}) n x = Ideal.Quotient.mk (Ideal.span {r} ^ n) a →
        AdicCompletion.evalₐ (Ideal.span {s}) n (AdicCompletion.liftRingHom (Ideal.span {s}) f hf x) =
          Ideal.Quotient.mk (Ideal.span {s} ^ n) (ψ a) := by
      intro n x a ha
      rw [AdicCompletion.evalₐ_liftRingHom]
      exact hfv n x a ha
    refine ⟨AdicCompletion.liftRingHom (Ideal.span {s}) f hf, hΨ, ?_⟩
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have h1 : algebraMap R (AdicCompletion (Ideal.span {r}) R) a =
        AdicCompletion.of (Ideal.span {r}) R a := by
      rw [AdicCompletion.algebraMap_apply]; rfl
    have h2 : algebraMap S (AdicCompletion (Ideal.span {s}) S) (ψ a) =
        AdicCompletion.of (Ideal.span {s}) S (ψ a) := by
      rw [AdicCompletion.algebraMap_apply]; rfl
    rw [h1, h2, AdicCompletion.evalₐ_of]
    exact hΨ n _ a (AdicCompletion.evalₐ_of _ n a)

  have c8 : ∀ (R : Type u) [CommRing R] [Nontrivial R] (d N : ℕ) (u : R) (L : MvPolynomial (Fin (d + 1)) R), IsUnit u → (∀ e ∈ L.support, e 0 < N) → ∀ P : MvPolynomial (Fin (d + 1)) R, ∃ (Q : MvPolynomial (Fin (d + 1)) R) (r : Fin N → MvPolynomial (Fin d) R), P = Q * (MvPolynomial.C u * MvPolynomial.X 0 ^ N + L) + ∑ i : Fin N, MvPolynomial.rename Fin.succ (r i) * MvPolynomial.X 0 ^ (i : ℕ) := by
    intro R _ _ d N u L hu hL P
    obtain ⟨v, huv⟩ := hu.exists_right_inv
    have hren : ((MvPolynomial.finSuccEquiv R d : MvPolynomial (Fin (d + 1)) R ≃ₐ[R]
        Polynomial (MvPolynomial (Fin d) R)) : MvPolynomial (Fin (d + 1)) R →+*
        Polynomial (MvPolynomial (Fin d) R)).comp (MvPolynomial.rename Fin.succ).toRingHom =
        Polynomial.C := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [MvPolynomial.finSuccEquiv_apply]
      · intro j
        simp [MvPolynomial.finSuccEquiv_X_succ]
    have hΦren : ∀ a : MvPolynomial (Fin d) R,
        MvPolynomial.finSuccEquiv R d (MvPolynomial.rename Fin.succ a) = Polynomial.C a :=
      fun a => RingHom.congr_fun hren a
    have hΦC : ∀ c : R, MvPolynomial.finSuccEquiv R d (MvPolynomial.C c) =
        Polynomial.C (MvPolynomial.C c) := by
      intro c; rw [← hΦren, MvPolynomial.rename_C]
    have hLc : ∀ m : ℕ, N ≤ m → (MvPolynomial.finSuccEquiv R d L).coeff m = 0 := by
      intro m hm
      ext e
      rw [MvPolynomial.finSuccEquiv_coeff_coeff, MvPolynomial.coeff_zero]
      by_contra hne
      have := hL _ (MvPolynomial.mem_support_iff.mpr hne)
      rw [Finsupp.cons_zero] at this
      omega
    set pL := Polynomial.C (MvPolynomial.C v) * MvPolynomial.finSuccEquiv R d L with hpL
    have hpLdeg : pL.degree < N := by
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro m hm
      rw [hpL, Polynomial.coeff_C_mul, hLc m hm, mul_zero]
    set g' := Polynomial.C (MvPolynomial.C v) *
      MvPolynomial.finSuccEquiv R d (MvPolynomial.C u * MvPolynomial.X 0 ^ N + L) with hg'
    have hg'eq : g' = Polynomial.X ^ N + pL := by
      rw [hg', hpL, map_add, map_mul, map_pow, hΦC, MvPolynomial.finSuccEquiv_X_zero, mul_add,
        ← mul_assoc, ← Polynomial.C_mul, ← MvPolynomial.C_mul, mul_comm v u, huv,
        MvPolynomial.C_1, Polynomial.C_1, one_mul]
    have hmon : g'.Monic := by rw [hg'eq]; exact Polynomial.monic_X_pow_add hpLdeg
    have hdeg : g'.degree = N := by
      rw [hg'eq, Polynomial.degree_add_eq_left_of_degree_lt, Polynomial.degree_X_pow]
      rw [Polynomial.degree_X_pow]; exact hpLdeg
    set p := MvPolynomial.finSuccEquiv R d P with hp
    have hdiv : p %ₘ g' + g' * (p /ₘ g') = p := Polynomial.modByMonic_add_div p g'
    have hmodlt : (p %ₘ g').degree < N := by
      rw [← hdeg]; exact Polynomial.degree_modByMonic_lt p hmon
    have hmodsum : p %ₘ g' = ∑ i : Fin N, Polynomial.C ((p %ₘ g').coeff i) * Polynomial.X ^ (i : ℕ) := by
      ext n : 1
      rw [Polynomial.finset_sum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      by_cases hn : n < N
      · rw [Finset.sum_eq_single ⟨n, hn⟩]
        · simp
        · intro b _ hb
          rw [if_neg]
          intro h; apply hb; ext; exact h.symm
        · intro h; exact absurd (Finset.mem_univ _) h
      · rw [Finset.sum_eq_zero]
        · exact Polynomial.coeff_eq_zero_of_degree_lt
            (lt_of_lt_of_le hmodlt (by exact_mod_cast (not_lt.mp hn)))
        · intro b _
          rw [if_neg]
          intro h; apply hn; rw [h]; exact b.2
    refine ⟨MvPolynomial.C v * (MvPolynomial.finSuccEquiv R d).symm (p /ₘ g'),
      fun i => (p %ₘ g').coeff i, ?_⟩
    apply (MvPolynomial.finSuccEquiv R d).injective
    rw [map_add, map_mul, map_mul, hΦC, AlgEquiv.apply_symm_apply, map_sum]
    simp only [map_mul, map_pow, hΦren, MvPolynomial.finSuccEquiv_X_zero]
    rw [← hmodsum, ← hp]
    rw [hg'] at hdiv
    linear_combination -hdiv

  have adic_series : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
    intro R _ r
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
          Submodule.mem_top
    refine ⟨fun f hf => ?_, fun x hx => ?_⟩
    · choose y hy using hf
      have s4 : ∀ m n : ℕ, m ≤ n →
          f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        intro m n hmn
        induction n, hmn using Nat.le_induction with
        | base => rw [sub_self]; exact Submodule.zero_mem _
        | succ n hmn ih =>
          rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
          refine Submodule.add_mem _ ?_ ih
          have h1 : f (n + 1) - f n ∈
              (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
            (s1 n _).mpr ⟨y n, hy n⟩
          exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
      obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, ← neg_sub]
        exact Submodule.neg_mem _ (s4 m n hmn))
      refine ⟨L, fun n => (s1 n _).mp ?_⟩
      have h := SModEq.sub_mem.mp (hL n)
      rw [← neg_sub]
      exact Submodule.neg_mem _ h
    · refine hc.toIsHausdorff.haus x (fun k => ?_)
      rw [SModEq.sub_mem, sub_zero]
      exact (s1 k x).mpr (hx k)

  have DEC : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    intro n y
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
      fun k => hD a n (k + n) (by omega)
    choose b hb using hex
    have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
      intro k
      rw [SModEq.sub_mem]
      obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
      have e : b k - b (k + 1) = p ^ k * (-s) := by
        apply hNc n
        linear_combination (-1 : C) * hb k + hb (k + 1) - hs
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
        Submodule.mem_top
    let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
      AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
    have hBk : ∀ k, B k = b k := fun k => rfl
    refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
    obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
    exact ⟨-s, by linear_combination hb k - hs⟩

  have crk : ∀ μ : ↥W, ¬ IsUnit μ → ∃ (j : ℕ) (w : ↥W), μ ^ j = ϖ * w := by
    intro μ hμ
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hrad : μ ∈ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine Ideal.mem_sInf.mpr ?_
      rintro J ⟨hJc, hJp⟩
      have hJne : J ≠ ⊥ := by
        intro h
        apply hϖ0
        have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
        rw [h] at h1
        exact Ideal.mem_bot.mp h1
      have hJmax : J.IsMaximal := by
        rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
        · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
        · exact h
      rw [IsLocalRing.eq_maximalIdeal hJmax]
      exact (IsLocalRing.mem_maximalIdeal μ).mpr hμ
    obtain ⟨n, hn⟩ := hrad
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
    exact ⟨n, w, by rw [← hw, mul_comm]⟩

  obtain ⟨ι, -, hιalg⟩ := c5 (MvPolynomial (Fin d) ↥W) (MvPolynomial (Fin (d + 1)) ↥W)
    (MvPolynomial.rename (R := ↥W) (Fin.succ : Fin d → Fin (d + 1))).toRingHom
    (MvPolynomial.C ϖ) (MvPolynomial.C ϖ) (by simp)
  set algD := algebraMap (MvPolynomial (Fin d) ↥W)
    (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
      (MvPolynomial (Fin d) ↥W)) with halgD
  set alg1 := algebraMap (MvPolynomial (Fin (d + 1)) ↥W)
    (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
      (MvPolynomial (Fin (d + 1)) ↥W)) with halg1
  have hι' : ∀ a : MvPolynomial (Fin d) ↥W,
      ι (algD a) = alg1 (MvPolynomial.rename Fin.succ a) := fun a => hιalg a
  have hιt : ι (algD (MvPolynomial.C ϖ)) = alg1 (MvPolynomial.C ϖ) := by
    rw [hι', MvPolynomial.rename_C]
  refine ⟨ι, hιt, ?_⟩
  intro u ρ N L Y hu hρ hL
  have htf : ∀ x : MvPolynomial (Fin (d + 1)) ↥W, MvPolynomial.C ϖ * x = 0 → x = 0 := by
    intro x hx
    have hC : (MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W) ≠ 0 := by
      intro hc
      exact hϖ0 (MvPolynomial.C_eq_zero.mp hc)
    exact (mul_eq_zero.mp hx).resolve_left hC

  have one : ∀ h : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
      (MvPolynomial (Fin (d + 1)) ↥W), ∃ (Q₀ : MvPolynomial (Fin (d + 1)) ↥W)
      (r₀ : Fin N → MvPolynomial (Fin d) ↥W)
      (h'' : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
        (MvPolynomial (Fin (d + 1)) ↥W)),
      h = alg1 Q₀ * (alg1 (MvPolynomial.C u * MvPolynomial.X 0 ^ N + L) +
          alg1 (MvPolynomial.C ρ) * Y) +
        ∑ i, ι (algD (r₀ i)) * alg1 (MvPolynomial.X 0) ^ (i : ℕ) +
        alg1 (MvPolynomial.C ϖ) * h'' - alg1 (MvPolynomial.C ρ) * alg1 Q₀ * Y := by
    intro h
    obtain ⟨P, h'', hP⟩ := DEC (MvPolynomial (Fin (d + 1)) ↥W) (MvPolynomial.C ϖ) htf 1 h
    obtain ⟨Q₀, r₀, hQ₀⟩ := c8 ↥W d N u L hu hL P
    refine ⟨Q₀, r₀, h'', ?_⟩
    have hs : ∑ i, ι (algD (r₀ i)) * alg1 (MvPolynomial.X 0) ^ (i : ℕ) =
        alg1 (∑ i : Fin N, MvPolynomial.rename Fin.succ (r₀ i) * MvPolynomial.X 0 ^ (i : ℕ)) := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hι', map_mul, map_pow]
    rw [hs, hP, hQ₀, pow_one, map_add, map_mul]
    ring

  have Ht : ∀ h : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
      (MvPolynomial (Fin (d + 1)) ↥W), ∃ (Q : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ :
        MvPolynomial (Fin (d + 1)) ↥W)}) (MvPolynomial (Fin (d + 1)) ↥W))
      (r : Fin N → AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W))
      (h' : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin (d + 1)) ↥W)})
        (MvPolynomial (Fin (d + 1)) ↥W)),
      h = Q * (alg1 (MvPolynomial.C u * MvPolynomial.X 0 ^ N + L) +
          alg1 (MvPolynomial.C ρ) * Y) +
        ∑ i, ι (r i) * alg1 (MvPolynomial.X 0) ^ (i : ℕ) + alg1 (MvPolynomial.C ϖ) * h' := by
    rcases ValuationRing.dvd_total ρ ϖ with ⟨m, hm⟩ | ⟨m, hm⟩
    ·
      obtain ⟨j, w, hjw⟩ := crk ρ hρ
      have hνj : algD (MvPolynomial.C ρ) ^ j = algD (MvPolynomial.C ϖ) * algD (MvPolynomial.C w) := by
        rw [← map_pow, ← MvPolynomial.C_pow, hjw, MvPolynomial.C_mul, map_mul]
      refine c3a _ _ ι _ _ hιt _ _ N (algD (MvPolynomial.C ρ)) (algD (MvPolynomial.C w)) j hνj ?_
      intro h
      obtain ⟨Q₀, r₀, h'', e⟩ := one h
      refine ⟨alg1 Q₀, fun i => algD (r₀ i), alg1 (MvPolynomial.C m) * h'' - alg1 Q₀ * Y, ?_⟩
      have hν : ι (algD (MvPolynomial.C ρ)) = alg1 (MvPolynomial.C ρ) := by
        rw [hι', MvPolynomial.rename_C]
      have htρ : alg1 (MvPolynomial.C ϖ) = alg1 (MvPolynomial.C ρ) * alg1 (MvPolynomial.C m) := by
        rw [← map_mul, ← MvPolynomial.C_mul, ← hm]
      rw [hν]
      linear_combination e + h'' * htρ
    ·
      intro h
      obtain ⟨Q₀, r₀, h'', e⟩ := one h
      refine ⟨alg1 Q₀, fun i => algD (r₀ i), h'' - alg1 (MvPolynomial.C m) * alg1 Q₀ * Y, ?_⟩
      have hρt : alg1 (MvPolynomial.C ρ) = alg1 (MvPolynomial.C ϖ) * alg1 (MvPolynomial.C m) := by
        rw [← map_mul, ← MvPolynomial.C_mul, ← hm]
      linear_combination e - (alg1 Q₀ * Y) * hρt

  intro h
  obtain ⟨hcomplD, -⟩ := adic_series (MvPolynomial (Fin d) ↥W) (MvPolynomial.C ϖ)
  obtain ⟨hcomplD1, hsepD1⟩ := adic_series (MvPolynomial (Fin (d + 1)) ↥W) (MvPolynomial.C ϖ)
  exact c3b _ _ ι _ _ hιt hcomplD hcomplD1 hsepD1 _ _ N Ht h

theorem wcpa_dj_lr1s_nf_cnf_bd_tate_noetherian : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ), IsNoetherianRing (Localization.Away (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ))) :=
by
  intro Ω _ _ W hW ϖ hϖ0 hϖnu d
  classical

  have c1 : ∀ (R A : Type u) [CommRing R] [CommRing A] [IsNoetherianRing R],
      (∀ a : A, a ≠ 0 → ∃ (φ : R →+* A) (N : ℕ) (x : A), ∀ h : A, ∃ (q : A) (r : Fin N → R),
        h = q * a + ∑ i, φ (r i) * x ^ (i : ℕ)) → IsNoetherianRing A := by
    intro R A _ _ _ hdiv
    rw [isNoetherianRing_iff_ideal_fg]
    intro I
    by_cases hI : I = ⊥
    · rw [hI]; exact Submodule.fg_bot
    obtain ⟨a, haI, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
    obtain ⟨φ, N, x, hx⟩ := hdiv a ha0
    letI : Algebra R A := φ.toAlgebra
    let Ψ : (Fin N → R) →ₗ[R] A :=
      { toFun := fun r => ∑ i, φ (r i) * x ^ (i : ℕ)
        map_add' := fun r s => by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
        map_smul' := fun c r => by
          simp only [Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply, Algebra.smul_def,
            RingHom.algebraMap_toAlgebra, Finset.mul_sum, mul_assoc] }
    have hΨ : ∀ r, Ψ r = ∑ i, φ (r i) * x ^ (i : ℕ) := fun r => rfl
    let M : Submodule R (Fin N → R) := (I.restrictScalars R).comap Ψ
    obtain ⟨S, hS⟩ := (IsNoetherian.noetherian M : M.FG)
    refine ⟨insert a (S.image Ψ), ?_⟩
    apply le_antisymm
    · rw [Ideal.span_le]
      intro y hy
      simp only [Finset.coe_insert, Finset.coe_image, Set.mem_insert_iff, Set.mem_image] at hy
      rcases hy with rfl | ⟨s, hs, rfl⟩
      · exact haI
      · have : s ∈ M := hS ▸ Submodule.subset_span hs
        exact this
    · intro y hy
      obtain ⟨q, r, hqr⟩ := hx y
      have hrM : r ∈ M := by
        show Ψ r ∈ I
        rw [hΨ]
        have e : ∑ i, φ (r i) * x ^ (i : ℕ) = y - q * a := by rw [hqr]; ring
        rw [e]
        exact I.sub_mem hy (I.mul_mem_left q haI)
      rw [← hS] at hrM
      have h1 : Ψ r ∈ Submodule.span R (Ψ '' (S : Set (Fin N → R))) := by
        rw [← Submodule.map_span]; exact Submodule.mem_map_of_mem hrM
      have h2 : Submodule.span R (Ψ '' (S : Set (Fin N → R))) ≤
          (Ideal.span (↑(insert a (S.image Ψ)) : Set A)).restrictScalars R := by
        rw [Submodule.span_le]
        intro z hz
        apply Ideal.subset_span
        simp only [Finset.coe_insert, Finset.coe_image]
        exact Set.mem_insert_of_mem _ hz
      have h3 := h2 h1
      rw [hqr]
      refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))) ?_
      rw [← hΨ]; exact h3

  have c2 : ∀ (R T : Type u) [CommRing R] [CommRing T] (tR : R) (t : T),
      (∀ f : T, (∀ k : ℕ, t ^ k * f ≠ 0) → ∃ (ι : R →+* T) (N k : ℕ) (x : T), ι tR = t ∧
        ∀ h : T, ∃ (q : T) (r : Fin N → R), t ^ k * h = q * f + ∑ i, ι (r i) * x ^ (i : ℕ)) →
      ∀ a : Localization.Away t, a ≠ 0 → ∃ (φ : Localization.Away tR →+* Localization.Away t)
        (N : ℕ) (x : Localization.Away t), ∀ h : Localization.Away t,
        ∃ (q : Localization.Away t) (r : Fin N → Localization.Away tR),
          h = q * a + ∑ i, φ (r i) * x ^ (i : ℕ) := by
    intro R T _ _ tR t hdiv a ha
    obtain ⟨⟨f, s⟩, hfs⟩ := IsLocalization.surj (Submonoid.powers t) a
    dsimp only at hfs
    obtain ⟨m, hm⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
    set U := algebraMap T (Localization.Away t) t with hUdef
    have hU : IsUnit U := IsLocalization.Away.algebraMap_isUnit t
    have hfa : algebraMap T (Localization.Away t) f = a * U ^ m := by
      rw [← hfs, ← hm, map_pow]
    have hnt : ∀ k : ℕ, t ^ k * f ≠ 0 := by
      intro k hk
      apply ha
      have h1 : algebraMap T (Localization.Away t) (t ^ k * f) = 0 := by rw [hk, map_zero]
      rw [map_mul, map_pow, hfa] at h1
      have hu : IsUnit (U ^ k * U ^ m) := (hU.pow k).mul (hU.pow m)
      have h2 : (U ^ k * U ^ m) * a = 0 := by rw [← h1]; ring
      exact (hu.mul_right_eq_zero).mp h2
    obtain ⟨ι, N, k, x, hιt, hx⟩ := hdiv f hnt
    have hιU : IsUnit ((algebraMap T (Localization.Away t)).comp ι tR) := by
      rw [RingHom.comp_apply, hιt]; exact hU
    let φ : Localization.Away tR →+* Localization.Away t := IsLocalization.Away.lift tR hιU
    have hφ : ∀ r : R, φ (algebraMap R (Localization.Away tR) r) =
        algebraMap T (Localization.Away t) (ι r) := fun r => IsLocalization.Away.lift_eq tR hιU r
    set V := algebraMap R (Localization.Away tR) tR with hVdef
    have hV : IsUnit V := IsLocalization.Away.algebraMap_isUnit tR
    obtain ⟨Ui, hUi⟩ := hU.exists_right_inv
    obtain ⟨Vi, hVi⟩ := hV.exists_right_inv
    have hφV : φ V = U := by rw [hVdef, hφ, hιt]
    have hφVi : φ Vi = Ui := by
      have e : U * φ Vi = 1 := by rw [← hφV, ← map_mul, hVi, map_one]
      calc φ Vi = (Ui * U) * φ Vi := by rw [mul_comm Ui, hUi, one_mul]
        _ = Ui * (U * φ Vi) := by ring
        _ = Ui := by rw [e, mul_one]
    refine ⟨φ, N, algebraMap T (Localization.Away t) x, fun h' => ?_⟩
    obtain ⟨⟨h, s'⟩, hs'⟩ := IsLocalization.surj (Submonoid.powers t) h'
    dsimp only at hs'
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp s'.2
    obtain ⟨q, r, hqr⟩ := hx h
    have e1 := congrArg (algebraMap T (Localization.Away t)) hqr
    simp only [map_mul, map_pow, map_add, map_sum] at e1
    have hh : algebraMap T (Localization.Away t) h = h' * U ^ n := by
      rw [← hs', ← hn, map_pow]
    rw [hh, hfa] at e1
    refine ⟨Ui ^ (n + k) * U ^ m * algebraMap T (Localization.Away t) q,
      fun i => algebraMap R (Localization.Away tR) (r i) * Vi ^ (n + k), ?_⟩
    have hsum : ∑ i, φ (algebraMap R (Localization.Away tR) (r i) * Vi ^ (n + k)) *
        (algebraMap T (Localization.Away t) x) ^ (i : ℕ) =
        Ui ^ (n + k) * ∑ i, algebraMap T (Localization.Away t) (ι (r i)) *
          algebraMap T (Localization.Away t) x ^ (i : ℕ) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow, hφ, hφVi]
      ring
    rw [hsum]
    have hUU : Ui ^ (n + k) * U ^ (n + k) = 1 := by rw [← mul_pow, mul_comm, hUi, one_pow]
    linear_combination (Ui ^ (n + k)) * e1 + (-h') * hUU

  have c10 : ∀ (T : Type u) [CommRing T] (t : T), (∀ f : ℕ → T, (∀ n : ℕ, ∃ y : T,
      f (n + 1) - f n = t ^ n * y) → ∃ L : T, ∀ n : ℕ, ∃ y : T, L - f n = t ^ n * y) →
      (∀ z : T, (∀ k : ℕ, ∃ y : T, z = t ^ k * y) → z = 0) →
      ∀ (z w : T) (j : ℕ), z ^ j = t * w → IsUnit (1 + z) := by
    intro T _ t hC hS z w j hz
    have hz' : (-z) ^ j = t * ((-1) ^ j * w) := by rw [neg_pow, hz]; ring
    have hs : ∀ m : ℕ, (1 + z) * (∑ i ∈ Finset.range m, (-z) ^ i) = 1 - (-z) ^ m := by
      intro m
      induction m with
      | zero => simp
      | succ m ih => rw [Finset.sum_range_succ, mul_add, ih, pow_succ]; ring
    have hpow : ∀ n : ℕ, (-z) ^ (j * n) = t ^ n * ((-1) ^ j * w) ^ n := by
      intro n; rw [pow_mul, hz', mul_pow]
    obtain ⟨L, hL⟩ := hC (fun n => ∑ i ∈ Finset.range (j * n), (-z) ^ i) (fun n => by
      refine ⟨((-1) ^ j * w) ^ n * ∑ i ∈ Finset.range j, (-z) ^ i, ?_⟩
      show ∑ i ∈ Finset.range (j * (n + 1)), (-z) ^ i - ∑ i ∈ Finset.range (j * n), (-z) ^ i = _
      rw [show j * (n + 1) = j * n + j by ring, Finset.sum_range_add, add_sub_cancel_left]
      simp_rw [pow_add]
      rw [← Finset.mul_sum, hpow n]
      ring)
    have hzero : (1 + z) * L - 1 = 0 := by
      apply hS
      intro n
      obtain ⟨y, hy⟩ := hL n
      refine ⟨(1 + z) * y - ((-1) ^ j * w) ^ n, ?_⟩
      have h1 := hs (j * n)
      rw [hpow n] at h1
      have hy' : L - ∑ i ∈ Finset.range (j * n), (-z) ^ i = t ^ n * y := hy
      linear_combination (1 + z) * hy' + h1
    have h1 : (1 + z) * L = 1 := sub_eq_zero.mp hzero
    exact ⟨⟨1 + z, L, h1, by rw [mul_comm]; exact h1⟩, rfl⟩

  have cb : ∀ (T : Type u) [CommRing T] (t : T), (∀ f : T, f ≠ 0 → ∃ (k : ℕ) (g : T),
      f * g = t ^ k) → IsNoetherianRing (Localization.Away t) := by
    intro T _ t hf
    rw [isNoetherianRing_iff_ideal_fg]
    intro I
    by_cases hI : I = ⊥
    · rw [hI]; exact Submodule.fg_bot
    obtain ⟨a, haI, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
    obtain ⟨⟨f, s⟩, hfs⟩ := IsLocalization.surj (Submonoid.powers t) a
    dsimp only at hfs
    have hf0 : f ≠ 0 := by
      intro h; apply ha0
      rw [h, map_zero] at hfs
      exact (IsLocalization.map_units (Localization.Away t) s).mul_left_eq_zero.mp hfs
    obtain ⟨k, g, hg⟩ := hf f hf0
    have hU : IsUnit (algebraMap T (Localization.Away t) t ^ k) :=
      (IsLocalization.Away.algebraMap_isUnit t).pow k
    have hfu : IsUnit (algebraMap T (Localization.Away t) f) := by
      rw [← map_pow, ← hg, map_mul] at hU
      exact isUnit_of_mul_isUnit_left hU
    have hau : IsUnit a := by
      rw [← hfs] at hfu
      exact isUnit_of_mul_isUnit_left hfu
    rw [Ideal.eq_top_of_isUnit_mem I haI hau]
    exact ⟨{1}, by simp⟩

  have stepgen : ∀ (R T : Type u) [CommRing R] [CommRing T] (tR : R) (t : T)
      [IsNoetherianRing (Localization.Away tR)],
      (∀ f : T, f ≠ 0 → ∃ (σ : T ≃+* T) (ι : R →+* T) (a g x : T) (k N : ℕ), σ t = t ∧
        ι tR = t ∧ a ∣ t ^ k ∧ σ f = a * g ∧
        ∀ h : T, ∃ (q : T) (r : Fin N → R), h = q * g + ∑ i, ι (r i) * x ^ (i : ℕ)) →
      IsNoetherianRing (Localization.Away t) := by
    intro R T _ _ tR t _ H
    apply c1 (Localization.Away tR) (Localization.Away t)
    apply c2 R T tR t
    intro f hf
    have hf0 : f ≠ 0 := by simpa using hf 0
    obtain ⟨σ, ι, a, g, x, k, N, hσt, hιt, ⟨b, hb⟩, hσf, hdiv⟩ := H f hf0
    have hσt' : σ.symm t = t := by
      calc σ.symm t = σ.symm (σ t) := by rw [hσt]
        _ = t := σ.symm_apply_apply t
    refine ⟨σ.symm.toRingHom.comp ι, N, k, σ.symm x, ?_, fun h => ?_⟩
    · show σ.symm (ι tR) = t
      rw [hιt, hσt']
    · obtain ⟨q, r, hqr⟩ := hdiv (σ h)
      refine ⟨σ.symm (b * q), fun i => tR ^ k * r i, ?_⟩
      apply σ.injective
      have e2 : ∀ i : Fin N, σ ((σ.symm.toRingHom.comp ι) (tR ^ k * r i) * σ.symm x ^ (i : ℕ)) =
          t ^ k * (ι (r i) * x ^ (i : ℕ)) := by
        intro i
        show σ (σ.symm (ι (tR ^ k * r i)) * σ.symm x ^ (i : ℕ)) = _
        rw [map_mul, map_pow, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, map_mul,
          map_pow, hιt, mul_assoc]
      rw [map_add, map_sum, Finset.sum_congr rfl (fun i _ => e2 i), ← Finset.mul_sum,
        map_mul σ (t ^ k) h, map_mul σ (σ.symm (b * q)) f, RingEquiv.apply_symm_apply, hσf,
        map_pow, hσt, hqr, hb]
      ring

  have crk : ∀ μ : ↥W, ¬ IsUnit μ → ∃ (j : ℕ) (w : ↥W), μ ^ j = ϖ * w := by
    intro μ hμ
    haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
    have hrad : μ ∈ (Ideal.span {ϖ}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine Ideal.mem_sInf.mpr ?_
      rintro J ⟨hJc, hJp⟩
      have hJne : J ≠ ⊥ := by
        intro h
        apply hϖ0
        have h1 : ϖ ∈ J := hJc (Ideal.mem_span_singleton_self ϖ)
        rw [h] at h1
        exact Ideal.mem_bot.mp h1
      have hJmax : J.IsMaximal := by
        rcases Ring.krullDimLE_one_iff.mp inferInstance J hJp with h | h
        · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hJne
        · exact h
      rw [IsLocalRing.eq_maximalIdeal hJmax]
      exact (IsLocalRing.mem_maximalIdeal μ).mpr hμ
    obtain ⟨n, hn⟩ := hrad
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hn
    exact ⟨n, w, by rw [← hw, mul_comm]⟩
  induction d with
  | zero =>
    apply cb
    intro f hf
    obtain ⟨c, μ, k, F, y, hcμ, hμ, ⟨e, he⟩, hfeq⟩ :=
      wcpa_dj_lr1s_nf_cnf_bd_tn_content Ω W ϖ hϖ0 hϖnu 0 f hf
    have hF : F = 1 := by
      rw [MvPolynomial.eq_C_of_isEmpty F]
      rw [Subsingleton.elim e 0] at he
      rw [he, MvPolynomial.C_1]
    obtain ⟨j, w, hjw⟩ := crk μ hμ
    set alg := algebraMap (MvPolynomial (Fin 0) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin 0) ↥W)})
        (MvPolynomial (Fin 0) ↥W)) with halg
    have hz : (alg (MvPolynomial.C μ) * y) ^ j =
        alg (MvPolynomial.C ϖ) * (alg (MvPolynomial.C w) * y ^ j) := by
      rw [mul_pow, ← map_pow, ← MvPolynomial.C_pow, hjw, MvPolynomial.C_mul, map_mul]; ring
    obtain ⟨hcompl, hsep⟩ := wcpa_dj_lr1s_nf_cnf_adic_series (MvPolynomial (Fin 0) ↥W)
      (MvPolynomial.C ϖ)
    obtain ⟨v, hv⟩ := (c10 _ _ hcompl hsep _ _ j hz).exists_right_inv
    refine ⟨k, v * alg (MvPolynomial.C μ), ?_⟩
    rw [hfeq, hF, map_one]
    have e : alg (MvPolynomial.C ϖ) ^ k = alg (MvPolynomial.C c) * alg (MvPolynomial.C μ) := by
      rw [← map_pow, ← MvPolynomial.C_pow, ← hcμ, MvPolynomial.C_mul, map_mul]
    rw [e]
    linear_combination (alg (MvPolynomial.C c) * alg (MvPolynomial.C μ)) * hv
  | succ d ih =>
    refine @stepgen _ _ _ _ (algebraMap (MvPolynomial (Fin d) ↥W)
      (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
        (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ)) _ ih ?_
    intro f hf
    obtain ⟨σ, c, c', u, ρ, k, N, L, Y, hσt, hcc, hu, hρ, hL, hσf⟩ :=
      wcpa_dj_lr1s_nf_cnf_bd_tn_normal_form Ω W hW ϖ hϖ0 hϖnu d f hf
    obtain ⟨ι, hιt, hdiv⟩ := wcpa_dj_lr1s_nf_cnf_bd_tn_weierstrass_division Ω W hW ϖ hϖ0 hϖnu d
    refine ⟨σ, ι, _, _, _, k, N, hσt, hιt, ?_, hσf, hdiv u ρ N L Y hu hρ hL⟩
    rw [← map_pow, ← MvPolynomial.C_pow]
    exact map_dvd _ (map_dvd _ (Dvd.intro c' hcc))

theorem wcpa_dj_lr1s_nf_cnf_bt_content_factor : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (ϖ : ↥W), ϖ ≠ 0 → ∀ (d : ℕ) (f : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)), f ≠ 0 → ∃ (m : ℕ) (G : MvPolynomial (Fin d) ↥W) (h : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)), (∃ α : Fin d →₀ ℕ, IsUnit (G.coeff α)) ∧ algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) ^ m * (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) G + algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ) * h) ∈ Ideal.span {f} :=
by
  intro Ω _ W ϖ hϖ d
  classical
  set p : MvPolynomial (Fin d) ↥W := MvPolynomial.C ϖ with hp
  intro f hf
  have hp0 : p ≠ 0 := by
    rw [hp]
    exact fun h => hϖ (MvPolynomial.C_eq_zero.mp h)
  have hnzd : ∀ x : MvPolynomial (Fin d) ↥W, p * x = 0 → x = 0 :=
    fun x hx => (mul_eq_zero.mp hx).resolve_left hp0
  have adic_haus : ∀ (R : Type u) [CommRing R] (r : R) (x : AdicCompletion (Ideal.span {r}) R),
