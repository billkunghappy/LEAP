      intro i
      rw [Algebra.TensorProduct.basis_apply, KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.mvPolynomialBasis_apply, KaehlerDifferential.map_D,
        RingHom.algebraMap_toAlgebra, MvPolynomial.eval₂Hom_X']
    have hbb0 : KaehlerDifferential.mapBaseChange R (MvPolynomial (Fin 2) R) L (bb 0) =
        KaehlerDifferential.D R L (algebraMap S L T₁) := hbb 0
    have hbb1 : KaehlerDifferential.mapBaseChange R (MvPolynomial (Fin 2) R) L (bb 1) =
        KaehlerDifferential.D R L (algebraMap S L T₂) := hbb 1
    have hinj : Function.Injective
        (KaehlerDifferential.mapBaseChange R (MvPolynomial (Fin 2) R) L) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro x hx
      rw [← bb.sum_repr x, Fin.sum_univ_two, map_add, map_smul, map_smul, hbb0, hbb1, h₁L,
        h₂L] at hx
