    obtain ⟨c', hc'⟩ := hii 1 (g₀ * x₀) _ hc
    rw [pow_one] at hc'
    obtain ⟨x₃, hx₃⟩ := s3 g₀ x₀ hres ⟨c', hc'⟩
    refine ⟨algebraMap (MvPolynomial (Fin d) ↥W) T x₃ + yx, ?_⟩
    rw [hx₀, hx₃, map_mul]
    ring

  have iter : ∀ (R : Type u) [CommRing R] (t g : R), (∀ y : R, t * y = 0 → y = 0) →
      (∀ z : R, t ∣ g * z → t ∣ z) → ∀ (m : ℕ) (x : R), t ^ m ∣ g * x → t ^ m ∣ x := by
    intro R _ t g hi s5 m
    induction m with
    | zero => intro x _; exact ⟨x, by rw [pow_zero, one_mul]⟩
    | succ m ih =>
      intro x hdiv
      obtain ⟨y, hy⟩ := hdiv
      obtain ⟨x', rfl⟩ := s5 x ⟨t ^ m * y, by rw [hy]; ring⟩
      have h2 : g * x' = t ^ m * y := by
        have h3 : t * (g * x' - t ^ m * y) = 0 := by
          linear_combination hy
        exact sub_eq_zero.mp (hi _ h3)
      obtain ⟨z, hz⟩ := ih x' ⟨y, h2⟩
      exact ⟨z, by rw [hz]; ring⟩
  exact iter _ t g hi s5 m x hdiv

theorem wcpa_dj_lr1s_nf_cnf_fmp_df_integral_of_coprime_mul : ∀ (T A : Type u) [CommRing T] [IsDomain T] [IsIntegrallyClosed T] [CommRing A] [IsDomain A] [Algebra T A], Function.Injective (algebraMap T A) → ∀ (t g : T), t ≠ 0 → (∀ (m : ℕ) (x : T), t ^ m ∣ g * x → t ^ m ∣ x) → ∀ a : A, (∃ k : ℕ, IsIntegral T (algebraMap T A t ^ k * a)) → IsIntegral T (algebraMap T A g * a) → IsIntegral T a :=
by
  intro T A _ _ _ _ _ _ hinj t g ht hP a ⟨k, hx⟩ hy
  classical
  have : Module.IsTorsionFree T A := Module.isTorsionFree_iff_algebraMap_injective.mpr hinj
  have hthat : algebraMap T A t ≠ 0 := by
    intro h; apply ht; apply hinj; rw [h, map_zero]
  by_cases hg : g = 0
  · obtain ⟨u, hu⟩ : t ∣ 1 := by
      have := hP 1 1 (by rw [hg, zero_mul]; exact dvd_zero _)
      simpa using this
    have e : a = (algebraMap T A t ^ k * a) * algebraMap T A (u ^ k) := by
      have h1 : algebraMap T A t ^ k * algebraMap T A (u ^ k) = 1 := by
        rw [← map_pow, ← map_mul, ← mul_pow, ← hu, one_pow, map_one]
      calc a = (algebraMap T A t ^ k * algebraMap T A (u ^ k)) * a := by rw [h1, one_mul]
        _ = _ := by ring
    rw [e]
    exact hx.mul isIntegral_algebraMap
  have hPj : ∀ (j m : ℕ) (z : T), t ^ m ∣ g ^ j * z → t ^ m ∣ z := by
    intro j
    induction j with
    | zero => intro m z h; simpa using h
    | succ j ih =>
      intro m z h
      apply ih m z
      apply hP m
      rw [pow_succ', mul_assoc] at h
      exact h
  set x := algebraMap T A t ^ k * a with hxdef
  have hxs : x = (t ^ k) • a := by rw [Algebra.smul_def, map_pow]
  have hys : algebraMap T A g * a = g • a := by rw [Algebra.smul_def]
  have key : g • x = (t ^ k) • (g • a) := by
    rw [hxs, smul_smul, smul_smul, mul_comm]
  have htk : t ^ k ≠ 0 := pow_ne_zero _ ht
  have hy' : IsIntegral T (g • a) := hys ▸ hy
  have E : (minpoly T x).scaleRoots g = (minpoly T (g • a)).scaleRoots (t ^ k) := by
    rw [← IsIntegrallyClosed.minpoly_smul hg hx, ← IsIntegrallyClosed.minpoly_smul htk hy', key]
  have hpm : (minpoly T x).Monic := minpoly.monic hx
  have hpa : Polynomial.aeval x (minpoly T x) = 0 := minpoly.aeval T x
  set p := minpoly T x with hpdef
  set q := minpoly T (g • a) with hqdef
  set n := p.natDegree with hn
  have hdeg : q.natDegree = n := by
    have := congrArg Polynomial.natDegree E
    rw [Polynomial.natDegree_scaleRoots, Polynomial.natDegree_scaleRoots] at this
    exact this.symm
  have hdiv : ∀ i, ∃ r : T, p.coeff i = t ^ (k * (n - i)) * r := by
    intro i
    have h1 := congrArg (fun P => Polynomial.coeff P i) E
    simp only [Polynomial.coeff_scaleRoots] at h1
    rw [hdeg] at h1
    apply hPj (n - i) (k * (n - i))
    refine ⟨q.coeff i, ?_⟩
    rw [pow_mul]
    linear_combination h1
  choose r hr using hdiv
  set R : Polynomial T := Polynomial.X ^ n +
    ∑ i : Fin n, Polynomial.C (r i) * Polynomial.X ^ (i : ℕ) with hR
  have hRm : R.Monic := Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
  have hRa : algebraMap T A t ^ (k * n) * Polynomial.aeval a R = Polynomial.aeval x p := by
    have hp := hpm.as_sum
    conv_rhs => rw [hp]
    rw [hR]
    simp only [map_add, map_sum, map_mul, Polynomial.aeval_X_pow, Polynomial.aeval_C]
    rw [Fin.sum_univ_eq_sum_range (fun i => algebraMap T A (r i) * a ^ i) n]
    rw [mul_add, Finset.mul_sum]
    congr 1
    · rw [hxdef, mul_pow, ← pow_mul]
    · apply Finset.sum_congr rfl
      intro i hi
