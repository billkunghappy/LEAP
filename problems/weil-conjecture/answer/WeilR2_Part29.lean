  classical
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
  have hp : 0 < p := (Fact.out : p.Prime).pos
  let Xe : (Fin n → Fin p) → MvPolynomial (Fin n) K := fun e =>
