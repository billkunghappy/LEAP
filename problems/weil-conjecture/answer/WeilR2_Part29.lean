  have hdec : ∀ P : MvPolynomial (Fin n) K, ∃ c : (Fin n → Fin p) → MvPolynomial (Fin n) K,
      P = ∑ e, c e ^ p * Xe e := by
    intro P
    induction P using MvPolynomial.induction_on' with
    | monomial u a =>
      obtain ⟨b, hb⟩ := IsAlgClosed.exists_pow_nat_eq a hp
