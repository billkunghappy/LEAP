  have s3 : ∀ (R T : Type u) [CommRing R] [CommRing T] (ι : R →+* T) (a : R) (q : ℕ), 0 < q →
      (∀ x y : T, (x + y) ^ q = x ^ q + y ^ q) →
      (∀ y : T, ∃ (c : R) (y' : T), y = ι c + ι a ^ q * y') →
      (∀ f : ℕ → T, (∀ n : ℕ, ∃ y : T, f (n + 1) - f n = ι a ^ n * y) →
        ∃ L : T, ∀ n : ℕ, ∃ y : T, L - f n = ι a ^ n * y) →
      (∀ x : T, (∀ k : ℕ, ∃ y : T, x = ι a ^ k * y) → x = 0) →
      ∀ (E : Type) [Fintype E] (m : E → T),
      (∀ f : R, ∃ g : E → R, ι f = ∑ e, ι (g e) ^ q * m e) →
      ∀ t : T, ∃ s : E → T, t = ∑ e, s e ^ q * m e := by
    intro R T _ _ ι a q hq hadd hpeel hser hsep E _ m hdec t
    have hsub : ∀ x y : T, (x - y) ^ q = x ^ q - y ^ q := by
      intro x y
      have h := hadd (x - y) y
      rw [sub_add_cancel] at h
      rw [h]; ring
    choose cf yf hcy using hpeel
    choose G hG using hdec
    let y : ℕ → T := fun N => Nat.rec t (fun _ z => yf z) N
    have hy0 : y 0 = t := rfl
    have hyS : ∀ N, y (N + 1) = yf (y N) := fun N => rfl
    let S : E → ℕ → T := fun e N => ∑ k ∈ Finset.range N, ι a ^ k * ι (G (cf (y k)) e)
    have hSS : ∀ e N, S e (N + 1) = S e N + ι a ^ N * ι (G (cf (y N)) e) := by
      intro e N
      simp only [S, Finset.sum_range_succ]
    have hlim : ∀ e, ∃ L : T, ∀ n, ∃ z : T, L - S e n = ι a ^ n * z := by
      intro e
      apply hser
      intro n
      exact ⟨ι (G (cf (y n)) e), by rw [hSS]; ring⟩
    choose s hs using hlim
    choose z hz using hs
    have inv : ∀ N, t = ∑ e, S e N ^ q * m e + ι a ^ (q * N) * y N := by
      intro N
      induction N with
      | zero =>
        simp only [S, Finset.range_zero, Finset.sum_empty, zero_pow hq.ne', zero_mul,
          Finset.sum_const_zero, zero_add, mul_zero, pow_zero, one_mul, hy0]
      | succ N ih =>
        have h1 : y N = ι (cf (y N)) + ι a ^ q * y (N + 1) := by rw [hyS]; exact hcy (y N)
        have key : ∑ e, S e (N + 1) ^ q * m e = ∑ e, S e N ^ q * m e +
            ι a ^ (q * N) * ∑ e, ι (G (cf (y N)) e) ^ q * m e := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun e _ => ?_)
          rw [hSS, hadd, mul_pow, ← pow_mul, mul_comm N q]
          ring
        rw [key, ← hG (cf (y N))]
        linear_combination ih + ι a ^ (q * N) * h1
    refine ⟨s, ?_⟩
    have hD : ∀ k, ∃ w : T, t - ∑ e, s e ^ q * m e = ι a ^ k * w := by
      intro k
      obtain ⟨q', hq'⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
      refine ⟨ι a ^ (q' * k) * (y k - ∑ e, z e k ^ q * m e), ?_⟩
      have h1 : ∀ e, s e ^ q * m e = S e k ^ q * m e + ι a ^ (q * k) * (z e k ^ q * m e) := by
        intro e
        have h := hsub (s e) (S e k)
        rw [hz e k, mul_pow, ← pow_mul, mul_comm k q] at h
        have h' : s e ^ q = S e k ^ q + ι a ^ (q * k) * z e k ^ q := by
          rw [h]; ring
        rw [h']; ring
      conv_lhs => rw [inv k]
      rw [Finset.sum_congr rfl (fun e _ => h1 e), Finset.sum_add_distrib, ← Finset.mul_sum]
      rw [show q * k = k + q' * k by rw [hq']; ring, pow_add]
      ring
    exact sub_eq_zero.mp (hsep _ hD)

  have hfin : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B) (E : Type) [Fintype E]
      (m : E → B), (∀ t : B, ∃ s : E → A, t = ∑ e, f (s e) * m e) → f.Finite := by
    intro A B _ _ f E _ m h
    letI := f.toAlgebra
    unfold RingHom.Finite
    refine ⟨⟨Finset.univ.image m, ?_⟩⟩
    rw [eq_top_iff]
    rintro t -
    obtain ⟨s, hs⟩ := h t
    rw [hs]
    refine Submodule.sum_mem _ (fun e _ => ?_)
    have : f (s e) * m e = s e • m e := by rw [Algebra.smul_def]; rfl
    rw [this]
    exact Submodule.smul_mem _ (s e) (Submodule.subset_span (by simp))

  intro Ω _ _ W hW ϖ hϖ0 hϖnu d p _ r
  have hq : 0 < p ^ r := pow_pos (expChar_pos (AdicCompletion (Ideal.span
    {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) p) r
  have hadd : ∀ x y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)})
      (MvPolynomial (Fin d) ↥W), (x + y) ^ (p ^ r) = x ^ (p ^ r) + y ^ (p ^ r) :=
    fun x y => add_pow_expChar_pow x y p r
  have htf : ∀ x : MvPolynomial (Fin d) ↥W, MvPolynomial.C ϖ * x = 0 → x = 0 := by
    intro x hx
    rcases mul_eq_zero.mp hx with h | h
    · exact absurd (MvPolynomial.C_eq_zero.mp h) hϖ0
    · exact h

  have hseries : ∀ (R : Type u) [CommRing R] (r : R), (∀ f : ℕ → AdicCompletion (Ideal.span {r}) R, (∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, f (n + 1) - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) → ∃ L : AdicCompletion (Ideal.span {r}) R, ∀ n : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, L - f n = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) ∧ (∀ x : AdicCompletion (Ideal.span {r}) R, (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R, x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0) := by
    intro R _ r
    have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
      AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
    have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
        x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) ↔
        ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y := by
      intro n x
      constructor
      · intro hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha m _
          rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at ha
          obtain ⟨c, rfl⟩ := ha
          refine ⟨algebraMap R (AdicCompletion (Ideal.span {r}) R) c * m, ?_⟩
          rw [Algebra.smul_def, map_mul, map_pow]
          ring
        · rintro x y ⟨y1, rfl⟩ ⟨y2, rfl⟩
          exact ⟨y1 + y2, (mul_add _ _ _).symm⟩
      · rintro ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
          Submodule.mem_top
    refine ⟨fun f hf => ?_, fun x hx => ?_⟩
    · choose y hy using hf
      have s4 : ∀ m n : ℕ, m ≤ n →
          f n - f m ∈ (Ideal.span {r} ^ m • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        intro m n hmn
        induction n, hmn using Nat.le_induction with
        | base => rw [sub_self]; exact Submodule.zero_mem _
        | succ n hmn ih =>
          rw [← sub_add_sub_cancel (f (n + 1)) (f n) (f m)]
          refine Submodule.add_mem _ ?_ ih
          have h1 : f (n + 1) - f n ∈
              (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) :=
            (s1 n _).mpr ⟨y n, hy n⟩
          exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hmn) h1
      obtain ⟨L, hL⟩ := hc.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, ← neg_sub]
        exact Submodule.neg_mem _ (s4 m n hmn))
      refine ⟨L, fun n => (s1 n _).mp ?_⟩
      have h := SModEq.sub_mem.mp (hL n)
      rw [← neg_sub]
      exact Submodule.neg_mem _ h
    · refine hc.toIsHausdorff.haus x (fun k => ?_)
      rw [SModEq.sub_mem, sub_zero]
      exact (s1 k x).mpr (hx k)

  have hpeel : ∀ (C : Type u) [CommRing C] (p : C), (∀ x : C, p * x = 0 → x = 0) → ∀ (n : ℕ) (y : AdicCompletion (Ideal.span {p}) C), ∃ (c : C) (y' : AdicCompletion (Ideal.span {p}) C), y = algebraMap C (AdicCompletion (Ideal.span {p}) C) c + algebraMap C (AdicCompletion (Ideal.span {p}) C) p ^ n * y' := by
    intro C _ p hp
    have hev : ∀ (k : ℕ) (c : C), AdicCompletion.evalₐ (Ideal.span {p}) k
        (algebraMap C (AdicCompletion (Ideal.span {p}) C) c) =
        Ideal.Quotient.mk (Ideal.span {p} ^ k) c := by
      intro k c
      rw [AlgHom.commutes]
      rfl
    have hmem : ∀ (k : ℕ) (x : C), Ideal.Quotient.mk (Ideal.span {p} ^ k) x = 0 ↔ p ^ k ∣ x := by
      intro k x
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    have hD : ∀ (a : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C) (m k : ℕ), m ≤ k →
        p ^ m ∣ a k - a m := by
      intro a m k hmk
      rw [← hmem, map_sub, sub_eq_zero]
      exact AdicCompletion.Ideal.mk_eq_mk (Ideal.span {p}) hmk a
    have hN : ∀ (n : ℕ) (x : C), p ^ n * x = 0 → x = 0 := by
      intro n
      induction n with
      | zero => intro x h; simpa using h
      | succ n ih =>
        intro x h
        apply ih
        apply hp
        rw [← mul_assoc, ← pow_succ']
        exact h
    have hNc : ∀ (n : ℕ) (u v : C), p ^ n * u = p ^ n * v → u = v := by
      intro n u v h
      rw [← sub_eq_zero]
      apply hN n
      rw [mul_sub, h, sub_self]
    intro n y
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective (Ideal.span {p}) C y
    have hex : ∀ k : ℕ, ∃ b : C, a (k + n) - a n = p ^ n * b :=
      fun k => hD a n (k + n) (by omega)
    choose b hb using hex
    have hB : ∀ k : ℕ, b k ≡ b (k + 1) [SMOD (Ideal.span {p} ^ k • ⊤ : Submodule C C)] := by
      intro k
      rw [SModEq.sub_mem]
      obtain ⟨s, hs⟩ := hD a (k + n) (k + 1 + n) (by omega)
      have e : b k - b (k + 1) = p ^ k * (-s) := by
        apply hNc n
        linear_combination (-1 : C) * hb k + hb (k + 1) - hs
      rw [e]
      exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self p) k)
        Submodule.mem_top
    let B : AdicCompletion.AdicCauchySequence (Ideal.span {p}) C :=
      AdicCompletion.AdicCauchySequence.mk (Ideal.span {p}) C b hB
    have hBk : ∀ k, B k = b k := fun k => rfl
    refine ⟨a n, AdicCompletion.mk (Ideal.span {p}) C B, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_add, map_mul, map_pow, hev, hev, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
      ← map_pow, ← map_mul, ← map_add, ← sub_eq_zero, ← map_sub, hmem, hBk]
    obtain ⟨s, hs⟩ := hD a k (k + n) (by omega)
    exact ⟨-s, by linear_combination hb k - hs⟩
  have hser := hseries (MvPolynomial (Fin d) ↥W) (MvPolynomial.C ϖ)
  have hspan := s3 (MvPolynomial (Fin d) ↥W) _ (algebraMap _ _) (MvPolynomial.C ϖ) (p ^ r) hq hadd
    (fun y => hpeel _ _ htf (p ^ r) y) hser.1 hser.2
    (Fin d → Fin (p ^ r))
    (fun e => algebraMap _ _ (MvPolynomial.monomial
      (Finsupp.equivFunOnFinite.symm (fun i => ((e i : ℕ)))) (1 : ↥W)))
    (s2 ↥W _ d (p ^ r) hq hadd (fun c => s1 Ω W c (p ^ r) hq) (algebraMap _ _))
  exact hfin (iterateFrobenius _ p r) (Fin d → Fin (p ^ r))
    (fun e => algebraMap _ _ (MvPolynomial.monomial
      (Finsupp.equivFunOnFinite.symm (fun i => ((e i : ℕ)))) (1 : ↥W)))
    (fun t => by
      obtain ⟨s, hs⟩ := hspan t
      exact ⟨s, by rw [hs]; simp only [iterateFrobenius_def]⟩)

theorem wcpa_dj_lr1s_nf_cnf_bd_trace_bound : ∀ (R B : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing B] [IsDomain B] [Algebra R B] (p : ℕ) [ExpChar R p], Function.Injective (algebraMap R B) → ∀ (t : R), t ≠ 0 → ∀ (L : Subalgebra R B), (Subalgebra.toSubmodule L).FG → (∀ x : B, ∃ k : ℕ, algebraMap R B t ^ k * x ∈ L) → ∃ δ : R, δ ≠ 0 ∧ ∃ r : ℕ, ∀ x : B, IsIntegral R x → algebraMap R B δ * x ^ (p ^ r) ∈ Submodule.span R ((fun y : B => y ^ (p ^ r)) '' (L : Set B)) :=
by
  classical

  have c2 : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (p : ℕ) [ExpChar B p]
      (r : ℕ) (G : Set B), ∀ y ∈ Submodule.span R G,
      y ^ (p ^ r) ∈ Submodule.span R ((fun y : B => y ^ (p ^ r)) '' G) := by
    intro R B _ _ _ p _ r G y hy
    induction hy using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
    | zero => rw [zero_pow (expChar_pow_pos B p r).ne']; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [add_pow_expChar_pow]; exact Submodule.add_mem _ hx hy
    | smul a x _ hx => rw [smul_pow]; exact Submodule.smul_mem _ _ hx

  have c1 : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] (p : ℕ) [ExpChar K p]
      (s : Finset E), (∀ x ∈ s, _root_.IsIntegral K x) →
      ∃ r : ℕ, ∀ x ∈ s, IsSeparable K (x ^ (p ^ r)) := by
    intro K E _ _ _ p _ s hs
    have one : ∀ x : E, _root_.IsIntegral K x → ∃ m : ℕ, IsSeparable K (x ^ (p ^ m)) := by
      intro x hx
      obtain ⟨g, hg, m, hgm⟩ := (minpoly.irreducible hx).hasSeparableContraction p
      refine ⟨m, ?_⟩
      have h0 : Polynomial.aeval (x ^ (p ^ m)) g = 0 := by
        rw [← Polynomial.expand_aeval, hgm, minpoly.aeval]
      exact hg.of_dvd (minpoly.dvd K _ h0)
    have mono : ∀ x : E, ∀ m m' : ℕ, m ≤ m' → IsSeparable K (x ^ (p ^ m)) →
        IsSeparable K (x ^ (p ^ m')) := by
      intro x m m' hmm' hsep
      haveI := (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K E).mpr hsep
      apply IntermediateField.isSeparable_of_mem_isSeparable K E
        (L := IntermediateField.adjoin K {x ^ (p ^ m)})
      have e : x ^ (p ^ m') = (x ^ (p ^ m)) ^ (p ^ (m' - m)) := by
        rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hmm']
      rw [e]
      exact pow_mem (IntermediateField.mem_adjoin_simple_self K _) _
    choose! M hM using fun x (hx : x ∈ s) => one x (hs x hx)
    exact ⟨s.sup M, fun x hx => mono x (M x) _ (Finset.le_sup hx) (hM x hx)⟩

  have c3 : ∀ (R K E : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [Field K]
      [Algebra R K] [IsFractionRing R K] [Field E] [Algebra K E] [Algebra R E]
      [IsScalarTower R K E] (T : Finset E),
      (∀ a ∈ T, _root_.IsIntegral R a) → (∀ a ∈ T, IsSeparable K a) →
      (1 : E) ∈ Submodule.span R (T : Set E) →
      (∀ a ∈ T, ∀ b ∈ T, a * b ∈ Submodule.span R (T : Set E)) →
      ∃ δ : R, δ ≠ 0 ∧ ∀ z : E, z ∈ Submodule.span K (T : Set E) → _root_.IsIntegral R z →
        algebraMap R E δ * z ∈ Submodule.span R (T : Set E) := by
    intro R K E _ _ _ _ _ _ _ _ _ _ T hTi hTs h1 hmul
    set S := IntermediateField.adjoin K (T : Set E) with hSdef
    have hTK : ∀ a ∈ (T : Set E), _root_.IsIntegral K a := fun a ha => (hTi a ha).tower_top
    haveI : FiniteDimensional K S := IntermediateField.finiteDimensional_adjoin hTK
    haveI : Algebra.IsSeparable K S :=
      (IntermediateField.isSeparable_adjoin_iff_isSeparable K E).mpr hTs
    set P : Submodule K E := Submodule.span K (T : Set E) with hP
    have hRP : ∀ y ∈ Submodule.span R (T : Set E), y ∈ P := fun y hy =>
      Submodule.span_le_restrictScalars R K (T : Set E) hy
    have hP1 : (1 : E) ∈ P := hRP 1 h1
    have hPmul : ∀ x y : E, x ∈ P → y ∈ P → x * y ∈ P := by
      intro x y hx hy
      have hxy : x * y ∈ P * P := Submodule.mul_mem_mul hx hy
      rw [hP, Submodule.span_mul_span] at hxy
      refine (Submodule.span_le.mpr ?_) hxy
      rintro e ⟨a, ha, b, hb, rfl⟩
      exact hRP _ (hmul a ha b hb)
    have hS : S.toSubalgebra = Algebra.adjoin K (T : Set E) :=
      IntermediateField.adjoin_toSubalgebra_of_isAlgebraic (fun x hx => (hTK x hx).isAlgebraic)
    have hSP : ∀ s : S, (s : E) ∈ P := by
      intro s
      have hs : (s : E) ∈ Algebra.adjoin K (T : Set E) := by rw [← hS]; exact s.2
      have hle : Algebra.adjoin K (T : Set E) ≤ P.toSubalgebra hP1 hPmul :=
        Algebra.adjoin_le (fun e he => Submodule.subset_span he)
      exact hle hs
    obtain ⟨b, hbT, hbspan, hbli⟩ := exists_linearIndependent K (T : Set E)
    haveI : Fintype b := (Set.Finite.subset T.finite_toSet hbT).fintype
    let v : b → S := fun j => ⟨j.1, IntermediateField.subset_adjoin K _ (hbT j.2)⟩
    have hli : LinearIndependent K v := LinearIndependent.of_comp S.val.toLinearMap hbli
    have himg : S.val.toLinearMap '' Set.range v = b := by
      ext e
      constructor
      · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
        exact j.2
      · intro he
        exact ⟨v ⟨e, he⟩, ⟨⟨e, he⟩, rfl⟩, rfl⟩
    have hspan : ⊤ ≤ Submodule.span K (Set.range v) := by
      intro s _
      have hs : (s : E) ∈ Submodule.span K (S.val.toLinearMap '' Set.range v) := by
        rw [himg, hbspan]; exact hSP s
      rw [Submodule.span_image] at hs
      obtain ⟨y, hy, hys⟩ := Submodule.mem_map.mp hs
      have : y = s := Subtype.ext hys
      rw [← this]; exact hy
    let 𝔟 : Module.Basis b K S := Module.Basis.mk hli hspan
    have h𝔟 : ∀ j, 𝔟 j = v j := fun j => Module.Basis.mk_apply hli hspan j
    have hvalinj : Function.Injective (S.val.restrictScalars R) := Subtype.val_injective
    have h𝔟int : ∀ j, _root_.IsIntegral R (𝔟 j) := by
      intro j
      rw [h𝔟]
      exact (isIntegral_algHom_iff (S.val.restrictScalars R) hvalinj).mp (hTi _ (hbT j.2))
    have hdual := integralClosure_le_span_dualBasis (A := R) (K := K) 𝔟 h𝔟int
    set D := (Algebra.traceForm K S).dualBasis (traceForm_nondegenerate K S) 𝔟 with hD
    obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors R)
      (Finset.univ : Finset (b × b)) (fun ij => 𝔟.repr (D ij.1) ij.2)
    choose a ha using fun ij : b × b => hd ij (Finset.mem_univ _)
    have hDi : ∀ i, (d : R) • D i ∈ Submodule.span R (Set.range 𝔟) := by
      intro i
      rw [← 𝔟.sum_repr (D i), Finset.smul_sum]
      refine Submodule.sum_mem _ (fun j _ => ?_)
      rw [← smul_assoc]
      have : (d : R) • 𝔟.repr (D i) j = algebraMap R K (a (i, j)) := (ha (i, j)).symm
      rw [this, algebraMap_smul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    have hdspan : ∀ z' ∈ Submodule.span R (Set.range D),
        (d : R) • z' ∈ Submodule.span R (Set.range 𝔟) := by
      intro z' hz'
      induction hz' using Submodule.span_induction with
      | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hDi i
      | zero => rw [smul_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [smul_add]; exact Submodule.add_mem _ hx hy
      | smul c x _ hx => rw [smul_comm]; exact Submodule.smul_mem _ _ hx
    have hcoe : ∀ x ∈ Submodule.span R (Set.range 𝔟),
        (x : E) ∈ Submodule.span R (T : Set E) := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨j, rfl⟩ := hx
        rw [h𝔟]
        exact Submodule.subset_span (hbT j.2)
      | zero => exact Submodule.zero_mem _
      | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
      | smul c x _ hx => exact Submodule.smul_mem _ c hx
    refine ⟨(d : R), nonZeroDivisors.ne_zero d.2, fun z hz hzi => ?_⟩
    have hzS : z ∈ S :=
      (Submodule.span_le (p := S.toSubalgebra.toSubmodule)).mpr
        (IntermediateField.subset_adjoin K _) hz
    have hz'i : _root_.IsIntegral R (⟨z, hzS⟩ : S) :=
      (isIntegral_algHom_iff (S.val.restrictScalars R) hvalinj).mp hzi
    have h2 := hcoe _ (hdspan _ (hdual hz'i))
    rw [← Algebra.smul_def]
    exact h2

  intro R B _ _ _ _ _ _ p _ hinj t ht0 L hLfg hLsp
  haveI : ExpChar B p := expChar_of_injective_algebraMap hinj p
  have hιinj : Function.Injective (algebraMap B (FractionRing B)) :=
    IsFractionRing.injective B (FractionRing B)
  have hRF : Function.Injective (algebraMap R (FractionRing B)) := by
    rw [IsScalarTower.algebraMap_eq R B (FractionRing B)]
    exact hιinj.comp hinj
  haveI : FaithfulSMul R (FractionRing B) :=
    (faithfulSMul_iff_algebraMap_injective R (FractionRing B)).mpr hRF
  letI : Algebra (FractionRing R) (FractionRing B) := FractionRing.liftAlgebra R (FractionRing B)
  haveI : IsScalarTower R (FractionRing R) (FractionRing B) :=
    FractionRing.isScalarTower_liftAlgebra R (FractionRing B)
  haveI : ExpChar (FractionRing R) p :=
    expChar_of_injective_algebraMap (IsFractionRing.injective R (FractionRing R)) p
  have hLfg' := hLfg
  obtain ⟨G, hG⟩ := hLfg
  have hmemL : ∀ y, y ∈ L ↔ y ∈ Submodule.span R (G : Set B) := by
    intro y; rw [hG]; rfl
  have hLint : ∀ y ∈ L, _root_.IsIntegral R y := _root_.IsIntegral.of_mem_of_fg L hLfg'
  let φ := IsScalarTower.toAlgHom R B (FractionRing B)
  have hint : ∀ y : B, _root_.IsIntegral R y →
      _root_.IsIntegral R (algebraMap B (FractionRing B) y) :=
    fun y hy => hy.map φ
  have hGL : ∀ l ∈ G, l ∈ L := fun l hl => (hmemL l).mpr (Submodule.subset_span hl)
  obtain ⟨r, hr⟩ := c1 (FractionRing R) (FractionRing B) p
    (G.image (algebraMap B (FractionRing B)))
    (by
      intro x hx
      obtain ⟨l, hl, rfl⟩ := Finset.mem_image.mp hx
      exact (hint l (hLint l (hGL l hl))).tower_top)
  have hLV : ∀ y ∈ L, y ^ (p ^ r) ∈
      Submodule.span R ((fun y : B => y ^ (p ^ r)) '' (G : Set B)) :=
    fun y hy => c2 R B p r G y ((hmemL y).mp hy)
  set T : Finset (FractionRing B) :=
    G.image (fun l => algebraMap B (FractionRing B) (l ^ (p ^ r))) with hT
  have hVT : (Submodule.span R ((fun y : B => y ^ (p ^ r)) '' (G : Set B))).map φ.toLinearMap =
      Submodule.span R (T : Set (FractionRing B)) := by
    rw [Submodule.map_span, hT, Finset.coe_image, Set.image_image]
    rfl
  have hLT : ∀ y ∈ L, algebraMap B (FractionRing B) (y ^ (p ^ r)) ∈
      Submodule.span R (T : Set (FractionRing B)) := by
    intro y hy
    rw [← hVT]
    exact Submodule.mem_map_of_mem (hLV y hy)
  obtain ⟨δ, hδ0, hδ⟩ := c3 R (FractionRing R) (FractionRing B) T
    (by
      intro a ha
      obtain ⟨l, hl, rfl⟩ := Finset.mem_image.mp ha
      exact hint _ (hLint _ (L.pow_mem (hGL l hl) _)))
    (by
      intro a ha
      obtain ⟨l, hl, rfl⟩ := Finset.mem_image.mp ha
      rw [map_pow]
      exact hr _ (Finset.mem_image_of_mem _ hl))
    (by
      have := hLT 1 L.one_mem
      rwa [one_pow, map_one] at this)
    (by
      intro a ha b hb
      obtain ⟨l, hl, rfl⟩ := Finset.mem_image.mp ha
      obtain ⟨l', hl', rfl⟩ := Finset.mem_image.mp hb
      rw [← map_mul, ← mul_pow]
      exact hLT _ (L.mul_mem (hGL l hl) (hGL l' hl')))
  refine ⟨δ, hδ0, r, fun x hx => ?_⟩
  have hzi : _root_.IsIntegral R (algebraMap B (FractionRing B) (x ^ (p ^ r))) :=
    hint _ (hx.pow _)
  obtain ⟨k, hk⟩ := hLsp x
  have h1 := hLT _ hk
  have htF : algebraMap B (FractionRing B) (algebraMap R B t) =
      algebraMap (FractionRing R) (FractionRing B) (algebraMap R (FractionRing R) t) := by
    rw [← IsScalarTower.algebraMap_apply R B (FractionRing B),
      ← IsScalarTower.algebraMap_apply R (FractionRing R) (FractionRing B)]
  have hu : algebraMap B (FractionRing B) ((algebraMap R B t ^ k * x) ^ (p ^ r)) =
      (algebraMap R (FractionRing R) t ^ (k * p ^ r)) •
        algebraMap B (FractionRing B) (x ^ (p ^ r)) := by
    rw [Algebra.smul_def, mul_pow, map_mul, ← pow_mul, map_pow, map_pow, htF, map_pow]
  have hu0 : algebraMap R (FractionRing R) t ^ (k * p ^ r) ≠ 0 := by
    apply pow_ne_zero
    intro h
    apply ht0
    exact IsFractionRing.injective R (FractionRing R) (h.trans (map_zero _).symm)
  have hzK : algebraMap B (FractionRing B) (x ^ (p ^ r)) ∈
      Submodule.span (FractionRing R) (T : Set (FractionRing B)) := by
    have h2 : (algebraMap R (FractionRing R) t ^ (k * p ^ r)) •
        algebraMap B (FractionRing B) (x ^ (p ^ r)) ∈
        Submodule.span (FractionRing R) (T : Set (FractionRing B)) := by
      rw [← hu]
      exact Submodule.span_le_restrictScalars R (FractionRing R) _ h1
    have h3 := Submodule.smul_mem _ (algebraMap R (FractionRing R) t ^ (k * p ^ r))⁻¹ h2
    rwa [inv_smul_smul₀ hu0] at h3
  have h4 := hδ _ hzK hzi
  rw [← hVT] at h4
  obtain ⟨w, hw, hwe⟩ := Submodule.mem_map.mp h4
  have hweq : w = algebraMap R B δ * x ^ (p ^ r) := by
    apply hιinj
    rw [map_mul, ← IsScalarTower.algebraMap_apply R B (FractionRing B)]
    exact hwe
  rw [← hweq]
  refine Submodule.span_mono ?_ hw
  exact Set.image_mono (fun l hl => hGL l hl)

theorem wcpa_dj_lr1s_nf_cnf_bd_frobenius_descent : ∀ (R B : Type u) [CommRing R] [CommRing B] [IsDomain B] [Algebra R B] (p : ℕ) [ExpChar R p] [ExpChar B p], (∀ r : ℕ, (iterateFrobenius R p r).Finite) → ∀ (t : R), (∀ (M : Type u) [AddCommGroup M] [Module R M], Module.Finite R M → ∃ c : ℕ, ∀ m : M, (∃ k : ℕ, t ^ k • m = 0) → t ^ c • m = 0) → ∀ (L : Subalgebra R B), (Subalgebra.toSubmodule L).FG → (∀ x : B, ∃ k : ℕ, algebraMap R B t ^ k * x ∈ L) → ∀ (δ : R), algebraMap R B δ ≠ 0 → ∀ r : ℕ, ∃ c : ℕ, ∀ x : B, algebraMap R B δ * x ^ (p ^ r) ∈ Submodule.span R ((fun y : B => y ^ (p ^ r)) '' (L : Set B)) → algebraMap R B t ^ c * x ∈ L :=
by
  intro R B _ _ _ _ p _ _ hF t hT L hLfg hLsp δ hδ r
  classical
  have hp0 : 0 < p := expChar_pos R p
  have hq0 : p ^ r ≠ 0 := pow_ne_zero _ hp0.ne'
  have hfR : ∀ a : R, iterateFrobenius R p r a = a ^ (p ^ r) := fun a => iterateFrobenius_def p r a
  have hfB : ∀ a : B, iterateFrobenius B p r a = a ^ (p ^ r) := fun a => iterateFrobenius_def p r a

  have gen : ∀ (A A' : Type u) [CommRing A] [CommRing A'] (f : A →+* A'), f.Finite →
      ∃ (K : ℕ) (e : Fin K → A'), ∀ y : A', ∃ a : Fin K → A, ∑ k, f (a k) * e k = y := by
    intro A A' _ _ f hf
    letI := f.toAlgebra
    have hfin : Module.Finite A A' := hf
    obtain ⟨K, e, he⟩ := Module.Finite.exists_fin (R := A) (M := A')
    refine ⟨K, e, fun y => ?_⟩
    have hy : y ∈ Submodule.span A (Set.range e) := by rw [he]; exact Submodule.mem_top
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hy
    refine ⟨a, ?_⟩
    rw [← ha]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
  obtain ⟨K, e, he⟩ := gen R R (iterateFrobenius R p r) (hF r)

  obtain ⟨m, l, hl⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hLfg

  have s2 : ∀ v ∈ Submodule.span R ((fun y : B => y ^ (p ^ r)) '' (L : Set B)),
      ∃ ρ : Fin m → R, v = ∑ i, algebraMap R B (ρ i) * l i ^ (p ^ r) := by
    intro v hv
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨y, hy, rfl⟩ := hv
      have hy' : y ∈ Submodule.span R (Set.range l) := by rw [hl]; exact hy
      obtain ⟨s, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hy'
      refine ⟨fun i => s i ^ (p ^ r), ?_⟩
      show (∑ i, s i • l i) ^ (p ^ r) = _
      rw [← hfB, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hfB, Algebra.smul_def, mul_pow, map_pow]
    | zero => exact ⟨0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨ρ, rfl⟩ := hx
      obtain ⟨ρ', rfl⟩ := hy
      exact ⟨ρ + ρ', by simp [add_mul, Finset.sum_add_distrib]⟩
    | smul b x _ hx =>
      obtain ⟨ρ, rfl⟩ := hx
      exact ⟨fun i => b * ρ i, by simp [Algebra.smul_def, Finset.mul_sum, mul_assoc]⟩

  let g : R →+* B := (algebraMap R B).comp (iterateFrobenius R p r)
  have hg : ∀ b : R, g b = algebraMap R B b ^ (p ^ r) := fun b => by
    simp only [g, RingHom.comp_apply, hfR, map_pow]
  let Φ : (Fin K × Fin m → R) →+ B :=
    { toFun := fun a => ∑ j, g (a j) * (algebraMap R B (e j.1) * l j.2 ^ (p ^ r))
      map_zero' := by simp
      map_add' := by
        intro a b
        simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib] }
  have hΦ : ∀ a, Φ a = ∑ j, g (a j) * (algebraMap R B (e j.1) * l j.2 ^ (p ^ r)) :=
    fun a => rfl
  have hΦs : ∀ (b : R) (a : Fin K × Fin m → R), Φ (b • a) = g b * Φ a := by
    intro b a
    rw [hΦ, hΦ, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc]
  have hgq : ∀ (b : R) (y : B), g b * (algebraMap R B δ * y ^ (p ^ r)) =
      algebraMap R B δ * (algebraMap R B b * y) ^ (p ^ r) := by
    intro b y
    rw [hg, mul_pow]; ring

  let U : AddSubgroup B :=
    { carrier := {u | ∃ ℓ ∈ L, u = algebraMap R B δ * ℓ ^ (p ^ r)}
      zero_mem' := ⟨0, L.zero_mem, by simp [zero_pow hq0]⟩
      add_mem' := by
        rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
        exact ⟨a + b, L.add_mem ha hb, by
          rw [← mul_add, ← hfB a, ← hfB b, ← hfB (a + b), map_add]⟩
      neg_mem' := by
        rintro _ ⟨a, ha, rfl⟩
        exact ⟨-a, L.neg_mem ha, by rw [← hfB a, ← hfB (-a), map_neg, mul_neg]⟩ }
  have hU : ∀ u, u ∈ U ↔ ∃ ℓ ∈ L, u = algebraMap R B δ * ℓ ^ (p ^ r) := fun u => Iff.rfl
  have hUs : ∀ (b : R) (u : B), u ∈ U → g b * u ∈ U := by
    intro b u hu
    obtain ⟨ℓ, hℓ, rfl⟩ := (hU u).mp hu
    exact (hU _).mpr ⟨algebraMap R B b * ℓ, L.mul_mem (L.algebraMap_mem b) hℓ, hgq b ℓ⟩

  let P : Submodule R (Fin K × Fin m → R) :=
    { carrier := {a | Φ a ∈ U}
      zero_mem' := by
        show Φ 0 ∈ U
        rw [map_zero]; exact U.zero_mem
      add_mem' := by
        intro a b ha hb
        show Φ (a + b) ∈ U
        rw [map_add]; exact U.add_mem ha hb
      smul_mem' := by
        intro b a ha
        show Φ (b • a) ∈ U
        rw [hΦs]; exact hUs b _ ha }
  have hP : ∀ a, a ∈ P ↔ Φ a ∈ U := fun a => Iff.rfl
  obtain ⟨c, hc⟩ := hT ((Fin K × Fin m → R) ⧸ P) inferInstance
  refine ⟨c, fun x hx => ?_⟩
  obtain ⟨ρ, hρ⟩ := s2 _ hx
  choose a' ha' using fun i => he (ρ i)
  let a : Fin K × Fin m → R := fun j => a' j.2 j.1
  have hΦa : Φ a = algebraMap R B δ * x ^ (p ^ r) := by
    rw [hρ, hΦ, Fintype.sum_prod_type, Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← ha' i, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [g, RingHom.comp_apply, map_mul, a]
    ring
  have hΦt : ∀ n : ℕ, Φ (t ^ n • a) = algebraMap R B δ * (algebraMap R B t ^ n * x) ^ (p ^ r) := by
    intro n
    rw [hΦs, hΦa, hgq, map_pow]
  obtain ⟨k, hk⟩ := hLsp x
  have hkP : t ^ k • a ∈ P := by
    rw [hP, hΦt]
    exact (hU _).mpr ⟨_, hk, rfl⟩
  have h1 := hc (Submodule.Quotient.mk a) ⟨k, by
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]; exact hkP⟩
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, hP, hΦt, hU] at h1
  obtain ⟨ℓ, hℓ, hℓeq⟩ := h1
  have h2 := mul_left_cancel₀ hδ hℓeq
  rw [← hfB, ← hfB] at h2
  have h3 := iterateFrobenius_inj B p r h2
  rw [h3]
  exact hℓ

theorem wcpa_dj_lr1s_nf_cnf_bd_dc_base_transfer : ∀ (T S R B : Type u) [CommRing T] [CommRing S] [CommRing R] [CommRing B] [Algebra T B] [Algebra R B] (π : T →+* S), Function.Surjective π → ∀ (ι : S →+* B), (∀ τ : T, ι (π τ) = algebraMap T B τ) → ∀ (ψ : R →+* S), ψ.Finite → (∀ r : R, ι (ψ r) = algebraMap R B r) → ∀ (L : Subalgebra T B), (Subalgebra.toSubmodule L).FG → ∃ L' : Subalgebra R B, (L' : Set B) = (L : Set B) ∧ (Subalgebra.toSubmodule L').FG ∧ ∀ x : B, IsIntegral T x → IsIntegral R x :=
by
  intro T S R B _ _ _ _ _ _ π hπ ι hι ψ hψfin hψ L hLfg
  classical
  letI : Algebra R S := ψ.toAlgebra
  haveI hfinRS : Module.Finite R S := hψfin
  have s1 : ∀ r : R, algebraMap R B r ∈ L := by
    intro r
    obtain ⟨τ, hτ⟩ := hπ (ψ r)
    rw [← hψ r, ← hτ, hι τ]
    exact L.algebraMap_mem τ
  obtain ⟨E, hE⟩ := Module.finite_def.mp hfinRS
  set H : Finset B := E.image ι with hHdef
  have hHL : ∀ h ∈ H, h ∈ L := by
    intro h hh
    obtain ⟨e, -, rfl⟩ := Finset.mem_image.mp hh
    obtain ⟨τ, rfl⟩ := hπ e
    rw [hι τ]
    exact L.algebraMap_mem τ
  have hspan : ∀ τ : T, algebraMap T B τ ∈ Submodule.span R (H : Set B) := by
    intro τ
    have hmem : π τ ∈ Submodule.span R (E : Set S) := by rw [hE]; trivial
    obtain ⟨f, -, hf⟩ := (Submodule.mem_span_finset).mp hmem
    rw [← hι τ, ← hf, map_sum]
    refine Submodule.sum_mem _ (fun e he => ?_)
    have h1 : ι (f e • e) = f e • ι e := by
      rw [Algebra.smul_def, map_mul, Algebra.smul_def, RingHom.algebraMap_toAlgebra, hψ]
    rw [h1]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem ι he)))
  let L' : Subalgebra R B := { L.toSubsemiring with algebraMap_mem' := s1 }
  refine ⟨L', rfl, ?_, ?_⟩
  · obtain ⟨G, hG⟩ := hLfg
    have hGL : ∀ g ∈ G, g ∈ L := by
      intro g hg
      have : g ∈ Submodule.span T (G : Set B) := Submodule.subset_span hg
      rw [hG] at this
      exact this
    set K : Finset B := Finset.image₂ (· * ·) H G with hKdef
    have hA : ∀ g ∈ G, ∀ y ∈ Submodule.span R (H : Set B), y * g ∈ Submodule.span R (K : Set B) := by
      intro g hg y hy
      have h1 : LinearMap.mulRight R g y ∈ (Submodule.span R (H : Set B)).map (LinearMap.mulRight R g) :=
        Submodule.mem_map_of_mem hy
      rw [Submodule.map_span] at h1
      refine Submodule.span_mono ?_ h1
      rintro _ ⟨h, hh, rfl⟩
      exact Finset.mem_coe.mpr (Finset.mem_image₂.mpr ⟨h, hh, g, hg, rfl⟩)
    refine ⟨K, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro z hz
      obtain ⟨h, hh, g, hg, rfl⟩ := Finset.mem_image₂.mp (Finset.mem_coe.mp hz)
      show h * g ∈ L
      exact L.mul_mem (hHL h hh) (hGL g hg)
    · intro x hx
      have hx' : x ∈ Submodule.span T (G : Set B) := by
        rw [hG]; exact hx
      obtain ⟨f, -, hf⟩ := (Submodule.mem_span_finset).mp hx'
      rw [← hf]
      refine Submodule.sum_mem _ (fun g hg => ?_)
      rw [Algebra.smul_def]
      exact hA g hg _ (hspan (f g))
  · intro x hx
    letI : Algebra S B := ι.toAlgebra
    haveI : IsScalarTower R S B := IsScalarTower.of_algebraMap_eq (fun r => (hψ r).symm)
    haveI : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
    have hSx : IsIntegral S x := by
      obtain ⟨p, hpm, hp⟩ := hx
      refine ⟨p.map π, hpm.map π, ?_⟩
      rw [Polynomial.eval₂_map]
      have : (algebraMap S B).comp π = algebraMap T B := RingHom.ext hι
      rw [this]
      exact hp
    exact isIntegral_trans x hSx

theorem wcpa_dj_lr1s_nf_cnf_bd_domain_case : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ) (B : Type u) [CommRing B] [IsDomain B] [Algebra (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) B], IsUnit (algebraMap (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) B (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ))) → ∀ (L : Subalgebra (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) B), (Subalgebra.toSubmodule L).FG → (∀ x : B, ∃ k : ℕ, algebraMap (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) B (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ)) ^ k * x ∈ L) → ∃ N : ℕ, ∀ x : B, IsIntegral (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) x → algebraMap (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) B (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C ϖ)) ^ N * x ∈ L :=
by
  classical

  have main : ∀ (T Te B : Type u) [CommRing T] [CommRing Te] [IsDomain Te] [IsIntegrallyClosed Te]
      [CommRing B] [IsDomain B] [Algebra T B] (t : T) (te : Te), IsUnit (algebraMap T B t) →
      ∀ (ψ : Te →+* T ⧸ RingHom.ker (algebraMap T B)), Function.Injective ψ → ψ.Finite →
      ψ te = Ideal.Quotient.mk (RingHom.ker (algebraMap T B)) t →
      (∀ (p : ℕ) [ExpChar Te p] (r : ℕ), (iterateFrobenius Te p r).Finite) →
      (∀ (M : Type u) [AddCommGroup M] [Module Te M], Module.Finite Te M →
        ∃ c : ℕ, ∀ m : M, (∃ k : ℕ, te ^ k • m = 0) → te ^ c • m = 0) →
      ∀ (L : Subalgebra T B), (Subalgebra.toSubmodule L).FG →
      (∀ x : B, ∃ k : ℕ, algebraMap T B t ^ k * x ∈ L) →
