theorem wcpa_dj_lr1s_au_frobenius_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K] (p : ℕ) [Fact (Nat.Prime p)] [CharP K p] (D : Type u) [CommRing D] [Algebra K D], Algebra.FiniteType K D → ∃ (m : ℕ) (g : Fin m → D), ∀ d : D, ∃ c : Fin m → D, d = ∑ i, c i ^ p * g i :=
by
