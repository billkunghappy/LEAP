    obtain ⟨w₁, hw₁a, -⟩ := Scheme.exists_preimage_of_isPullback hsq w y hy.symm
    rw [← hw₁a]
    exact (wcpa_dj_nc_ns_etale_transfer Y M' (Spec (.of ↥W)) cc
      (r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
      (cc ≫ r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
      rfl inferInstance K sp w₁).mpr (hNS K sp w₁)

  have key : ∀ (a : ↥W) (z : MvPolynomial (Fin 1) ↥W),
      (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a)))).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom z) =
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom (MvPolynomial.eval (fun _ : Fin 1 => a) z) :=
    fun a z => (congrArg (fun φ => φ.hom z)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a))))).symm
  have hγWne : (Scheme.ΓSpecIso (.of ↥W)).inv.hom c ≠ 0 := by
    intro h
    apply hc
    have := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom h
    rwa [hinvhom, map_zero] at this
  have hInv : ∀ a' : ↥W, wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
        ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0),
          (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)])))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a' * c)))) := by
    intro a'
    refine wcpa_dj_ncmb_invpull_affine _ _ 1 ![(Scheme.ΓSpecIso (.of ↥W)).inv.hom a', 1] ?_ ?_
    · intro j
      fin_cases j
      · show (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a' * c)))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) =
          (Scheme.ΓSpecIso (.of ↥W)).inv.hom a' *
          (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a' * c)))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c))
        rw [key, key, MvPolynomial.eval_X, MvPolynomial.eval_C, map_mul]
      · show (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a' * c)))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) =
          1 * (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a' * c)))).appTop.hom
            ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c))
        rw [one_mul]
    · show (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => a' * c)))).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)) ∈
          nonZeroDivisors Γ(Spec (.of ↥W), ⊤)
      rw [key, MvPolynomial.eval_C]
      exact mem_nonZeroDivisors_of_ne_zero hγWne
  have hInv0 := hInv 0
  simp only [zero_mul] at hInv0
  have hInvc := hInv 1
  simp only [one_mul] at hInvc
  refine ⟨?_, ?_⟩
  ·
    intro K _ _ sp w _
    have hz : Limits.pullback.fst (r₀ ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp w ∈ (⨆ l, U l) := by
      rw [hU.1]; trivial
    obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
    have hl0 : l = 0 → Limits.pullback.fst (r₀ ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp w ∈ Set.range c₀ := by
      intro e; subst e; rw [hc₀range]; exact hl
    have hl1 : l = 1 → Limits.pullback.fst (r₀ ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp w ∈ Set.range c₁ := by
      intro e; subst e; rw [hc₁range]; exact hl
    fin_cases l
    · exact transferNS _ c₀ _ hg₀ NSQ K sp w (hl0 rfl)
    · exact transferNS _ c₁ _ hg₁ NSq K sp w (hl1 rfl)
  ·
    intro σ₀' σc' hσ₀ hσc
    have e0 : σ₀' = ρ₀ ≫ c₁ :=
      (hr₀.2 _ _ hInv0).unique hσ₀ (by rw [Category.assoc, hc₁r, hρ₀])
    have ec : σc' = ρc ≫ c₁ :=
      (hr₀.2 _ _ hInvc).unique hσc (by rw [Category.assoc, hc₁r, hρc])
    have hsmR : SmoothOfRelativeDimension 1 (c₁.opensRange.ι ≫ r₀ ≫
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) := by
      have e0' : c₁.isoOpensRange.inv ≫ c₁ = c₁.opensRange.ι :=
        (Iso.inv_comp_eq _).mpr (Scheme.Hom.isoOpensRange_hom_ι c₁).symm
      have e : c₁.opensRange.ι ≫ r₀ ≫
          Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
          c₁.isoOpensRange.inv ≫
            Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) := by
        rw [← e0', Category.assoc, hg₁]
      rw [e]
      exact smoothOfRelativeDimension_comp 0 1 _ _
    refine ⟨?_, ⟨c₁.opensRange, ?_, hsmR⟩, ⟨c₁.opensRange, ?_, hsmR⟩⟩
    · intro heq
      apply hρne
      rw [e0, ec] at heq
      exact c₁.isOpenEmbedding.injective heq
    · rw [e0]; exact ⟨_, rfl⟩
    · rw [ec]; exact ⟨_, rfl⟩

theorem wcpa_dj_mscc_invpull_comap : ∀ (X Y T : Scheme.{u}) (I : Y.IdealSheafData) (f : X ⟶ Y) (h : T ⟶ X), Flat f → (wcCsdInvPull (I.comap f) h ↔ wcCsdInvPull I (h ≫ f)) :=
by

  have comap_aff : ∀ (X Y : Scheme.{u}) (J : Y.IdealSheafData) (π : X ⟶ Y) (U : Y.affineOpens)
      (W : X.affineOpens) (e : W.1 ≤ π ⁻¹ᵁ U.1),
      (J.comap π).ideal W = Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) := by
    intro X Y J π U W e
    rw [Scheme.IdealSheafData.comap, Scheme.Hom.ker_apply]
    apply le_antisymm
    · have hW : IsAffineOpen W.1 := W.2
      have hU : IsAffineOpen U.1 := U.2
      set IB := Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) with hIB
      have H : J.ideal U ≤ Ideal.comap (π.appLE U.1 W.1 e).hom IB := Ideal.le_comap_map
      let ψ : (Γ(Y, U.1) ⧸ J.ideal U) →+* (Γ(X, W.1) ⧸ IB) :=
        Ideal.quotientMap IB (π.appLE U.1 W.1 e).hom H
      let t : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X :=
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec
      let g : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ J.subscheme :=
        Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U
      have hw : t ≫ π = g ≫ J.subschemeι := by
        show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ≫ π =
          (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι
        have hc := J.subschemeCover_map_subschemeι U
        rw [J.glueDataObjι_ι U] at hc
        have hg : (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι =
            Spec.map (CommRingCat.ofHom ψ) ≫
              (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (J.ideal U))) ≫ hU.fromSpec) :=
          (Category.assoc _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ) ≫ ·) hc)
        rw [hg, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec π hU hW e]
        rw [← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        congr 2
      let l := Limits.pullback.lift t g hw
      have hl : l ≫ Limits.pullback.fst π J.subschemeι = t := Limits.pullback.lift_fst _ _ _
      intro b hb
      rw [RingHom.mem_ker] at hb
      have e0 : ⊤ ≤ t ⁻¹ᵁ W.1 := by
        intro p _
        show hW.fromSpec ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) p) ∈ (W.1 : Set X)
        rw [← hW.range_fromSpec]
        exact ⟨_, rfl⟩
      have h1 : ∀ (e : ⊤ ≤ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ⁻¹ᵁ W.1),
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec).appLE W.1 ⊤ e =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        have hb : ∀ (e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1),
            hW.fromSpec.appLE W.1 ⊤ e₁ = (Scheme.ΓSpecIso Γ(X, W.1)).inv := by
          intro e₁
          rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
          have hid : ∀ (f : Opposite.op (⊤ : (Spec Γ(X, W.1)).Opens) ⟶ Opposite.op ⊤),
              (Spec Γ(X, W.1)).presheaf.map f = 𝟙 _ := by
            intro f
            rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
              CategoryTheory.Functor.map_id]
          rw [hid, Category.comp_id]
        intro e
        have e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1 :=
          hW.fromSpec_preimage_self.ge
        have e₂ : (⊤ : (Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB))).Opens) ≤
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) ⁻¹ᵁ ⊤ := le_top
        rw [← Scheme.Hom.appLE_comp_appLE _ hW.fromSpec W.1 ⊤ ⊤ e₁ e₂, hb e₁]
        have happ : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appLE ⊤ ⊤ e₂ =
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appTop :=
          Scheme.Hom.appLE_eq_app _
        rw [happ, ← Scheme.ΓSpecIso_inv_naturality]
      have key : ∀ (s : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X) (hs : s = t)
          (e1 : ⊤ ≤ s ⁻¹ᵁ W.1), s.appLE W.1 ⊤ e1 =
            CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
        rintro s rfl e1
        exact h1 e1
      have e2 : ⊤ ≤ (l ≫ Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 := by
        rw [hl]; exact e0
      have h2 := key _ hl e2
      rw [Scheme.Hom.comp_appLE] at h2
      have h3 := congrArg (fun f => f.hom b) h2
      simp only [CommRingCat.comp_apply, hb, map_zero] at h3
      have h4 := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, W.1) ⧸ IB))).hom.hom h3
      simp only [map_zero, Iso.inv_hom_id_apply] at h4
      exact (Ideal.Quotient.eq_zero_iff_mem).mp h4.symm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have hP := Limits.pullback.condition (f := π) (g := J.subschemeι)
      have key : ∀ (s : Limits.pullback π J.subschemeι ⟶ Y)
          (hs : Limits.pullback.fst π J.subschemeι ≫ π = s)
          (e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤ s ⁻¹ᵁ U.1),
          ((Limits.pullback.fst π J.subschemeι).app W.1).hom ((π.appLE U.1 W.1 e).hom a) =
            (s.appLE U.1 _ e1).hom a := by
        rintro s rfl e1
        rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
      have e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤
          (Limits.pullback.snd π J.subschemeι ≫ J.subschemeι) ⁻¹ᵁ U.1 := by
        rw [← hP]; intro x hx; exact e hx
      rw [key _ hP e1, Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
      have h0 : (J.subschemeι.app U.1).hom a = 0 := by
        rw [← RingHom.mem_ker, Scheme.IdealSheafData.ker_subschemeι_app]; exact ha
      rw [h0, map_zero]

  have nzd_res : ∀ (T : Scheme.{u}) (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W →
      ∀ b : Γ(T, W), b ∈ nonZeroDivisors Γ(T, W) →
        T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro T W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (T.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
      haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
      exact hnz
    show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst

  have loc_gen : ∀ (Y T : Scheme.{u}) (J : Y.IdealSheafData) (h : T ⟶ Y) (U : Y.affineOpens)
      (V : T.affineOpens) (e : V.1 ≤ h ⁻¹ᵁ U.1) (ε : Γ(T, V.1)) (t : T), t ∈ V.1 →
      ε ∈ nonZeroDivisors Γ(T, V.1) → Ideal.map (h.appLE U.1 V.1 e).hom (J.ideal U) = Ideal.span {ε} →
      ∃ (V' : T.affineOpens) (e' : V'.1 ≤ h ⁻¹ᵁ U.1) (b : Γ(Y, U.1)), t ∈ V'.1 ∧ b ∈ J.ideal U ∧
        (h.appLE U.1 V'.1 e').hom b ∈ nonZeroDivisors Γ(T, V'.1) ∧
        Ideal.map (h.appLE U.1 V'.1 e').hom (J.ideal U) = Ideal.span {(h.appLE U.1 V'.1 e').hom b} := by
    intro Y T J h U V e ε t ht hε hmap
    classical
    have hεmem : ε ∈ Submodule.span Γ(T, V.1)
        ((h.appLE U.1 V.1 e).hom '' (J.ideal U : Set Γ(Y, U.1))) := by
      change ε ∈ Ideal.map (h.appLE U.1 V.1 e).hom (J.ideal U)
      rw [hmap]
      exact Ideal.mem_span_singleton_self ε
    obtain ⟨n, c, g, hcg⟩ := Submodule.mem_span_set'.mp hεmem
    have hg : ∀ i, ∃ a, a ∈ J.ideal U ∧ (h.appLE U.1 V.1 e).hom a = (g i : Γ(T, V.1)) :=
      fun i => (g i).2
    choose a ha hga using hg
    have hy : ∀ i, ∃ y, y * ε = (h.appLE U.1 V.1 e).hom (a i) := by
      intro i
      apply Ideal.mem_span_singleton'.mp
      rw [← hmap]
      exact Ideal.mem_map_of_mem _ (ha i)
    choose y hy using hy
    have hcy : ∑ i, c i * y i = 1 := by
      have h1 : (∑ i, c i * y i) * ε = ε := by
        rw [Finset.sum_mul]
        simp_rw [mul_assoc, hy, hga]
        simpa [smul_eq_mul] using hcg
      have h0 : (∑ i, c i * y i - 1) * ε = 0 := by rw [sub_mul, h1, one_mul, sub_self]
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hε).mp h0)
    obtain ⟨j, hj⟩ : ∃ j, t ∈ T.basicOpen (y j) := by
      by_contra hcon
      push_neg at hcon
      have hm : ∀ j, (T.presheaf.germ V.1 t ht).hom (c j * y j) ∈
          IsLocalRing.maximalIdeal (T.presheaf.stalk t) := by
        intro j
        rw [map_mul]
        apply Ideal.mul_mem_left
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen T (y j) t ht]
        exact hcon j
      have h1 := Ideal.sum_mem (IsLocalRing.maximalIdeal (T.presheaf.stalk t))
        (t := Finset.univ) (fun j _ => hm j)
      rw [← map_sum, hcy, map_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    have e' : T.basicOpen (y j) ≤ h ⁻¹ᵁ U.1 := (T.basicOpen_le (y j)).trans e
    have hform : ∀ x : Γ(Y, U.1), (h.appLE U.1 (T.basicOpen (y j)) e').hom x =
        (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom ((h.appLE U.1 V.1 e).hom x) := by
      intro x
      rw [← Scheme.Hom.appLE_map h e (homOfLE (T.basicOpen_le (y j))).op]
      rfl
    have hcomp : (h.appLE U.1 (T.basicOpen (y j)) e').hom =
        (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom.comp (h.appLE U.1 V.1 e).hom :=
      RingHom.ext hform
    have hε' : (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom ε ∈
        nonZeroDivisors Γ(T, T.basicOpen (y j)) :=
      @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers (y j)) _ _ _
        (V.2.isLocalization_basicOpen (y j)) _ (Submonoid.mem_map_of_mem _ hε)
    have hu : IsUnit ((T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom (y j)) :=
      @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ (y j) (V.2.isLocalization_basicOpen (y j))
    refine ⟨⟨T.basicOpen (y j), V.2.basicOpen (y j)⟩, e', a j, hj, ha j, ?_, ?_⟩
    · show (h.appLE U.1 (T.basicOpen (y j)) e').hom (a j) ∈ nonZeroDivisors Γ(T, T.basicOpen (y j))
      rw [hform, ← hy j, map_mul]
      exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors, hε'⟩
    · show Ideal.map (h.appLE U.1 (T.basicOpen (y j)) e').hom (J.ideal U) =
        Ideal.span {(h.appLE U.1 (T.basicOpen (y j)) e').hom (a j)}
      rw [hform (a j), ← hy j, map_mul, Ideal.span_singleton_mul_left_unit hu, hcomp,
        ← Ideal.map_map, hmap, Ideal.map_span, Set.image_singleton]

  intro X Y T I f h _
  constructor
  ·
    intro H t
    obtain ⟨U', V, eV, a', htV, ha', hnzd, hmap⟩ := H t
    obtain ⟨U, hU, hxU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : Y.Opens)) (x := f (h t)) trivial
    have htU' : h t ∈ U'.1 := eV htV
    obtain ⟨U'', hU'', hxU'', hsub''⟩ :=
      exists_isAffineOpen_mem_and_subset (U := U'.1 ⊓ f ⁻¹ᵁ U) (x := h t)
        (TopologicalSpace.Opens.mem_inf.mpr ⟨htU', (Scheme.Hom.mem_preimage f).mpr hxU⟩)
    have hU''U' : U'' ≤ U'.1 := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hsub'' hx)).1
    have eU'' : U'' ≤ f ⁻¹ᵁ U := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hsub'' hx)).2
    obtain ⟨V'', hV'', htV'', hsubV⟩ :=
      exists_isAffineOpen_mem_and_subset (U := V.1 ⊓ h ⁻¹ᵁ U'') (x := t)
        (TopologicalSpace.Opens.mem_inf.mpr ⟨htV, (Scheme.Hom.mem_preimage h).mpr hxU''⟩)
    have hV''V : V'' ≤ V.1 := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hsubV hx)).1
    have e'' : V'' ≤ h ⁻¹ᵁ U'' := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hsubV hx)).2
    have e3 : V'' ≤ (h ≫ f) ⁻¹ᵁ U := by
      intro x hx
      exact eU'' (e'' hx)
    have hcalc : Ideal.map ((h ≫ f).appLE U V'' e3).hom (I.ideal ⟨U, hU⟩) =
        Ideal.span {(T.presheaf.map (homOfLE hV''V).op).hom ((h.appLE U'.1 V.1 eV).hom a')} := by
      calc Ideal.map ((h ≫ f).appLE U V'' e3).hom (I.ideal ⟨U, hU⟩)
          = Ideal.map (h.appLE U'' V'' e'').hom
              (Ideal.map (f.appLE U U'' eU'').hom (I.ideal ⟨U, hU⟩)) := by
            rw [Ideal.map_map, ← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
        _ = Ideal.map (h.appLE U'' V'' e'').hom ((I.comap f).ideal ⟨U'', hU''⟩) := by
            rw [comap_aff X Y I f ⟨U, hU⟩ ⟨U'', hU''⟩ eU'']
        _ = Ideal.map (h.appLE U'' V'' e'').hom
              (Ideal.map (X.presheaf.map (homOfLE hU''U').op).hom ((I.comap f).ideal U')) := by
            exact congrArg (Ideal.map (h.appLE U'' V'' e'').hom)
              ((I.comap f).map_ideal (U := ⟨U'', hU''⟩) (V := U') hU''U').symm
        _ = Ideal.map (T.presheaf.map (homOfLE hV''V).op).hom
              (Ideal.map (h.appLE U'.1 V.1 eV).hom ((I.comap f).ideal U')) := by
            rw [Ideal.map_map, Ideal.map_map, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp,
              Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
        _ = _ := by
            rw [hmap, Ideal.map_span, Set.image_singleton]
    have hε := nzd_res T V.1 V'' hV''V V.2 _ hnzd
    obtain ⟨V', e', b, htV', hb, hbn, hbm⟩ :=
      loc_gen Y T I (h ≫ f) ⟨U, hU⟩ ⟨V'', hV''⟩ e3 _ t htV'' hε hcalc
    exact ⟨⟨U, hU⟩, V', e', b, htV', hb, hbn, hbm⟩
  ·
    intro H t
    obtain ⟨U, V, e, a, htV, ha, hnzd, hmap⟩ := H t
    have hxU : f (h t) ∈ U.1 := e htV
    obtain ⟨U', hU', hxU', hsub'⟩ :=
      exists_isAffineOpen_mem_and_subset (U := f ⁻¹ᵁ U.1) (x := h t)
        ((Scheme.Hom.mem_preimage f).mpr hxU)
    have eU' : U' ≤ f ⁻¹ᵁ U.1 := hsub'
    obtain ⟨V', hV', htV', hsubV⟩ :=
      exists_isAffineOpen_mem_and_subset (U := V.1 ⊓ h ⁻¹ᵁ U') (x := t)
        (TopologicalSpace.Opens.mem_inf.mpr ⟨htV, (Scheme.Hom.mem_preimage h).mpr hxU'⟩)
    have hV'V : V' ≤ V.1 := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hsubV hx)).1
    have e' : V' ≤ h ⁻¹ᵁ U' := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hsubV hx)).2
    have key : f.appLE U.1 U' eU' ≫ h.appLE U' V' e' =
        (h ≫ f).appLE U.1 V.1 e ≫ T.presheaf.map (homOfLE hV'V).op := by
      rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_map]
    have hval : (h.appLE U' V' e').hom ((f.appLE U.1 U' eU').hom a) =
        (T.presheaf.map (homOfLE hV'V).op).hom (((h ≫ f).appLE U.1 V.1 e).hom a) := by
      rw [← CommRingCat.comp_apply, key, CommRingCat.comp_apply]
    refine ⟨⟨U', hU'⟩, ⟨V', hV'⟩, e', (f.appLE U.1 U' eU').hom a, htV', ?_, ?_, ?_⟩
    · rw [comap_aff X Y I f U ⟨U', hU'⟩ eU']
      exact Ideal.mem_map_of_mem _ ha
    · show (h.appLE U' V' e').hom ((f.appLE U.1 U' eU').hom a) ∈ nonZeroDivisors Γ(T, V')
      rw [hval]
      exact nzd_res T V.1 V' hV'V V.2 _ hnzd
    · show Ideal.map (h.appLE U' V' e').hom ((I.comap f).ideal ⟨U', hU'⟩) =
        Ideal.span {(h.appLE U' V' e').hom ((f.appLE U.1 U' eU').hom a)}
      rw [hval, comap_aff X Y I f U ⟨U', hU'⟩ eU', Ideal.map_map, ← CommRingCat.hom_comp, key,
        CommRingCat.hom_comp, ← Ideal.map_map, hmap, Ideal.map_span, Set.image_singleton]

theorem wcpa_dj_mscc_model_centre : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W), c ≠ 0 → (∀ V : (Spec (.of (MvPolynomial (Fin 1) ↥W))).affineOpens, ((Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔ wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c).ideal V).FG) ∧ wcCsdInvPull (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔ wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W))) (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c) (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c)))) :=
by
  intro Ω _ W c hc
  classical

  have hinvhom : ∀ (R : CommRingCat.{u}) (x : R),
      (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).inv_hom_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this
  have hhominv : ∀ (R : CommRingCat.{u}) (x : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso R).inv.hom ((Scheme.ΓSpecIso R).hom.hom x) = x := by
    intro R x
    have := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso R).hom_inv_id
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_id,
      RingHom.id_apply] using this

  have hker0 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker]
    constructor
    · intro h
      have hs : Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 1) ↥W)} =
          Ideal.span (MvPolynomial.X '' Set.univ) := by
        rw [Set.image_univ, Set.range_unique]
        rfl
      rw [hs, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      refine ⟨0, Set.mem_univ _, ?_⟩
      intro hm0
      have hm' : m = 0 := by
        refine Finsupp.ext (fun i => ?_)
        rw [Fin.fin_one_eq_zero i]
        exact hm0
      subst hm'
      rw [MvPolynomial.mem_support_iff] at hm
      apply hm
      rw [MvPolynomial.eval_zero'] at h
      rw [← h, MvPolynomial.constantCoeff_eq]
    · intro h
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp h
      simp

  have hkerSpec : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (a : A),
      RingHom.ker f = Ideal.span {a} →
      Scheme.Hom.ker (Spec.map (CommRingCat.ofHom f)) =
        Scheme.IdealSheafData.ofIdealTop (Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom a}) := by
    intro A B _ _ f a hf
    rw [Scheme.ker_of_isAffine]
    congr 1
    ext x
    have nat := congrArg (fun g => g.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hx
      have h1 : f ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 := by rw [← nat, hx, map_zero]
      rw [← RingHom.mem_ker, hf, Ideal.mem_span_singleton'] at h1
      obtain ⟨y, hy⟩ := h1
      refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom y, ?_⟩
      rw [← map_mul, hy, hhominv]
    · rintro ⟨y, rfl⟩
      have hfa : f a = 0 := by
        rw [← RingHom.mem_ker, hf]; exact Ideal.mem_span_singleton_self a
      have h1 : (Scheme.ΓSpecIso (.of B)).hom.hom ((Spec.map (CommRingCat.ofHom f)).appTop.hom
          (y * (Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        rw [nat, map_mul, map_mul, hinvhom, hfa, mul_zero]
      have h2 := congrArg (Scheme.ΓSpecIso (.of B)).inv.hom h1
      rwa [hhominv, map_zero] at h2

  have hprinc : wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)}) := by
    unfold wcNcPrincipal
    have := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    rw [this]

  have hsup : ∀ (X : Scheme.{u}) (I J : Ideal Γ(X, ⊤)),
      Scheme.IdealSheafData.ofIdealTop I ⊔ Scheme.IdealSheafData.ofIdealTop J =
        Scheme.IdealSheafData.ofIdealTop (I ⊔ J) := by
    intro X I J
    apply Scheme.IdealSheafData.ext
    rw [Scheme.IdealSheafData.ideal_sup]
    funext U
    rw [Pi.sup_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal,
      Ideal.map_sup]
  have htop : ∀ (X : Scheme.{u}) [IsAffine X] (I : Ideal Γ(X, ⊤)),
      (Scheme.IdealSheafData.ofIdealTop I).ideal ⟨⊤, isAffineOpen_top X⟩ = I := by
    intro X _ I
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    convert Ideal.map_id I
    rw [show (homOfLE _ : (⊤ : X.Opens) ⟶ ⊤) = 𝟙 _ from Subsingleton.elim _ _]
    simp
  have hbr : ∀ (X T : Scheme.{u}) (h : T ⟶ X) (e : (⊤ : T.Opens) ≤ h ⁻¹ᵁ ⊤),
      h.appLE ⊤ ⊤ e = h.appTop := by
    intro X T h e
    exact (Scheme.Hom.app_eq_appLE h).symm

  have hev : ∀ p : MvPolynomial (Fin 1) ↥W,
      (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c)))).appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom p) =
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom (MvPolynomial.eval (fun _ : Fin 1 => c) p) := by
    intro p
    have := congrArg (fun g => g.hom p) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
    exact this.symm
  rw [hkerSpec (MvPolynomial (Fin 1) ↥W) ↥W _ _ hker0, hprinc, hsup]
  refine ⟨fun V => ?_, ?_⟩
  · rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    apply Ideal.FG.map
    exact Submodule.FG.sup (Submodule.fg_span_singleton _) (Submodule.fg_span_singleton _)
  · intro t
    have hle : (⊤ : (Spec (.of ↥W)).Opens) ≤
        (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => c)))) ⁻¹ᵁ ⊤ := by
      simp
    refine ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, hle,
      (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c), trivial,
      ?_, ?_, ?_⟩
    · rw [htop]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
    · dsimp only
      rw [hbr, hev, MvPolynomial.eval_C]
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      apply hc
      have := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom h0
      rwa [hinvhom, map_zero] at this
    · dsimp only
      rw [hbr, htop, hev, MvPolynomial.eval_C, Ideal.map_sup, Ideal.map_span, Ideal.map_span,
        Set.image_singleton, Set.image_singleton, hev, hev, MvPolynomial.eval_X,
        MvPolynomial.eval_C, sup_idem]

theorem wcpa_dj_mscc_ker_restrict_open : ∀ (X : Scheme.{u}) (U : X.Opens) (R : CommRingCat.{u}) (Δ : Spec R ⟶ X) (ΔU : Spec R ⟶ U.toScheme), IsClosedImmersion Δ → ΔU ≫ U.ι = Δ → (Scheme.Hom.ker Δ).comap U.ι = Scheme.Hom.ker ΔU :=
by
  intro X U R Δ ΔU hΔ hΔU
  haveI := hΔ
  have H : Set.range Δ ⊆ Set.range U.ι := by
    rintro _ ⟨x, rfl⟩
    exact ⟨ΔU x, by rw [← hΔU]; rfl⟩
  have hpb : IsPullback ΔU (𝟙 (Spec R)) U.ι Δ := by
    have h1 := IsOpenImmersion.isPullback_lift_id Δ U.ι H
    rwa [← IsOpenImmersion.lift_uniq U.ι Δ H ΔU hΔU] at h1
  apply Scheme.IdealSheafData.ext
  funext W
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    Scheme.ker_ideal_of_isPullback_of_isOpenImmersion Δ ΔU (𝟙 _) U.ι hpb W]

theorem wcpa_dj_mscc_ker_chart_comap : ∀ (R : Type u) [CommRing R] (U : Scheme.{u}) (m : U ⟶ Spec (.of (MvPolynomial (Fin 1) R))) (ΔU : Spec (.of R) ⟶ U), IsAffine U → ΔU ≫ m = Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R)))) → RingHom.ker ΔU.appTop.hom = Ideal.span {m.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0))} → (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R)))))).comap m = Scheme.Hom.ker ΔU :=
by
  intro R _ U m ΔU hU _ hker
  classical
  have s2 : RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))) =
      Ideal.span {MvPolynomial.X 0} := by
    ext p
    rw [RingHom.mem_ker, MvPolynomial.eval_zero']
    constructor
    · intro hp
      rw [← Set.image_singleton, MvPolynomial.mem_ideal_span_X_image]
      intro n hn
      refine ⟨0, Set.mem_singleton _, ?_⟩
      intro h0
      have hn0 : n = 0 := by
        rw [Finsupp.unique_ext_iff]
        exact h0
      rw [MvPolynomial.mem_support_iff, hn0] at hn
      exact hn (by rw [← MvPolynomial.constantCoeff_eq]; exact hp)
    · intro hp
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      simp
  have s3 : Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
      (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))))) =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span
        {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)}) := by
    rw [Scheme.ker_of_isAffine]
    congr 1
    have nat : ∀ y, (Scheme.ΓSpecIso (.of R)).hom.hom
        ((Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))))).appTop.hom y) =
        (MvPolynomial.eval (fun _ : Fin 1 => (0 : R)))
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).hom.hom y) := by
      intro y
      have := congrArg (fun h => h.hom y)
        (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R)))))
      exact this
    have inj : ∀ z, (Scheme.ΓSpecIso (.of R)).hom.hom z = 0 → z = 0 := by
      intro z hz
      have e : (Scheme.ΓSpecIso (.of R)).inv.hom ((Scheme.ΓSpecIso (.of R)).hom.hom z) = z := by
        simp
      rw [← e, hz, map_zero]
    ext y
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hy
      have h2 : (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).hom.hom y ∈
          RingHom.ker (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))) := by
        rw [RingHom.mem_ker, ← nat, hy, map_zero]
      rw [s2] at h2
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h2
      refine ⟨(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom c, ?_⟩
      rw [← map_mul, hc]
      simp
    · rintro ⟨c, rfl⟩
      rw [map_mul]
      have h0 : (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : R))))).appTop.hom
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)) = 0 := by
        apply inj
        rw [nat]
        simp
      rw [h0, mul_zero]
  have : IsAffine U := hU
  rw [s3, Scheme.ker_of_isAffine ΔU, hker]
  have e1 : Scheme.IdealSheafData.ofIdealTop (Ideal.span
      {(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) R))).inv.hom (MvPolynomial.X 0)}) =
      wcNcPrincipal (.of (MvPolynomial (Fin 1) R)) (Spec (.of (MvPolynomial (Fin 1) R))) (𝟙 _)
        (MvPolynomial.X 0) := by
    unfold wcNcPrincipal
    rw [Scheme.Hom.id_appTop]
    rfl
  have comapL : ∀ (R : CommRingCat.{u}) (Y Y' : Scheme.{u}) (g : Y ⟶ Spec R) (f : Y' ⟶ Y) (t : R),
      (wcNcPrincipal R Y g t).comap f = wcNcPrincipal R Y' (f ≫ g) t := by
    have nat : ∀ (X Y : Scheme.{u}) (h : X ⟶ Y) (U : Y.Opens) (b : Γ(Y, ⊤)),
        (h.app U).hom ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom b) =
          (X.presheaf.map (homOfLE (le_top : h ⁻¹ᵁ U ≤ ⊤)).op).hom (h.appTop.hom b) := by
      intro X Y h U b
      exact congrArg (fun φ => φ.hom b) (h.naturality (homOfLE (le_top : U ≤ ⊤)).op)
    have key : ∀ (X : Scheme.{u}) (s : Γ(X, ⊤)),
        (Scheme.IdealSheafData.ofIdealTop (Ideal.span {s})).subschemeι.appTop.hom s = 0 := by
      intro X s
      set J := Scheme.IdealSheafData.ofIdealTop (Ideal.span {s})
      apply J.subscheme.IsSheaf.section_ext
      intro x _
      obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := J.subschemeι x)
        (U := ⊤) trivial
      refine ⟨J.subschemeι ⁻¹ᵁ W, le_top, hxW, ?_⟩
      rw [map_zero]
      have h1 := nat _ _ J.subschemeι W s
      rw [← h1]
      rw [← RingHom.mem_ker, J.ker_subschemeι_app ⟨W, hW⟩, Scheme.IdealSheafData.ofIdealTop_ideal]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self s)
    intro R Y Y' g f t
    unfold wcNcPrincipal
    set a := g.appTop.hom ((Scheme.ΓSpecIso R).inv.hom t)
    have hb : (f ≫ g).appTop.hom ((Scheme.ΓSpecIso R).inv.hom t) = f.appTop.hom a := rfl
    rw [hb]
    set b := f.appTop.hom a
    set I := Scheme.IdealSheafData.ofIdealTop (Ideal.span {a}) with hI
    set I' := Scheme.IdealSheafData.ofIdealTop (Ideal.span {b}) with hI'
    apply le_antisymm
    · apply (Scheme.IdealSheafData.le_map_iff_comap_le).mp
      show _ ≤ Scheme.Hom.ker _
      unfold Scheme.Hom.ker
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U
      rw [hI, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton,
        Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat]
      have hz : (I'.subschemeι ≫ f).appTop.hom a = 0 := key Y' b
      rw [hz]
      exact map_zero _
    · show _ ≤ Scheme.Hom.ker _
      unfold Scheme.Hom.ker
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U
      rw [hI', Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton,
        Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, nat]
      have hz : (Limits.pullback.fst f I.subschemeι).appTop.hom b = 0 := by
        calc (Limits.pullback.fst f I.subschemeι).appTop.hom b
            = (Limits.pullback.fst f I.subschemeι ≫ f).appTop.hom a := rfl
          _ = (Limits.pullback.snd f I.subschemeι ≫ I.subschemeι).appTop.hom a := by
            rw [Limits.pullback.condition]
          _ = (Limits.pullback.snd f I.subschemeι).appTop.hom (I.subschemeι.appTop.hom a) := rfl
          _ = 0 := by rw [key Y a]; exact map_zero _
      rw [hz]
      exact map_zero _
  rw [e1, comapL, Category.comp_id]
  rfl

theorem wcpa_dj_ms_collide_centre : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W)) (Δ τ₀ : Spec (.of ↥W) ⟶ Z'), wcpaDjSemistable u' → Δ ≫ u' = 𝟙 _ → τ₀ ≫ u' = 𝟙 _ → (∃ U : Z'.Opens, τ₀ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ u')) → Δ (IsLocalRing.closedPoint ↥W) = τ₀ (IsLocalRing.closedPoint ↥W) → (∀ p : ↥(Spec (.of ↥W)), p ≠ IsLocalRing.closedPoint ↥W → Δ p ≠ τ₀ p) → (∃ p : ↥(Spec (.of ↥W)), p ≠ IsLocalRing.closedPoint ↥W) → ∃ J : Z'.IdealSheafData, (∀ U : Z'.affineOpens, (J.ideal U).FG) ∧ (∀ z : ↥Z', z ∈ (J.support : Set Z') → z = Δ (IsLocalRing.closedPoint ↥W)) ∧ wcCsdInvPull J Δ ∧ wcCsdInvPull J τ₀ ∧ ∀ (Z : Scheme.{u}) (rb : Z ⟶ Z'), wcCsdIsBlowup J rb → (∀ (K : Type u) [Field K] [IsAlgClosed K] (sp : Spec (.of K) ⟶ Spec (.of ↥W)) (w : ↥(Limits.pullback (rb ≫ u') sp)), rb (Limits.pullback.fst (rb ≫ u') sp w) = Δ (IsLocalRing.closedPoint ↥W) → wcpaDjMsFibreNS (rb ≫ u') K sp w) ∧ ∀ (Δ₁ τ₁ : Spec (.of ↥W) ⟶ Z), Δ₁ ≫ rb = Δ → τ₁ ≫ rb = τ₀ → Δ₁ (IsLocalRing.closedPoint ↥W) ≠ τ₁ (IsLocalRing.closedPoint ↥W) ∧ (∃ U : Z.Opens, Δ₁ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ rb ≫ u')) ∧ (∃ U : Z.Opens, τ₁ (IsLocalRing.closedPoint ↥W) ∈ U ∧ SmoothOfRelativeDimension 1 (U.ι ≫ rb ≫ u')) :=
by
  intro Ω _ _ W hW Z' u' Δ τ₀ hss hΔ hτ hsm hmeet hdisj hp
  haveI hflat : Flat u' := hss.1
  haveI hprop : IsProper u' := hss.2.1
  haveI hlfp : LocallyOfFinitePresentation u' :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) Z' u' hflat inferInstance
  obtain ⟨U, m, c, ΔU, τU, hUaff, hm, hmstr, hc0, hcm, hΔU, hτU, hΔUm, hτUm, hker⟩ :=
    wcpa_dj_mscc_coordinate_chart Ω W hW Z' u' Δ τ₀ inferInstance hlfp hΔ hτ hsm hmeet hdisj hp
  haveI := hm
  haveI : IsAffine U.toScheme := hUaff
  obtain ⟨hFG, hsupp, hinv⟩ :=
    wcpa_dj_nc_centre_props Ω W hW Z' u' Δ c hlfp inferInstance hΔ hc0 hcm
  haveI : IsClosedImmersion (Δ ≫ u') := by rw [hΔ]; infer_instance
  have hΔci : IsClosedImmersion Δ := IsClosedImmersion.of_comp Δ u'
  have hJeq : (Scheme.Hom.ker Δ ⊔ wcNcPrincipal (.of ↥W) Z' u' c).comap U.ι =
      (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c).comap m := by
    rw [Scheme.IdealSheafData.comap_sup, Scheme.IdealSheafData.comap_sup,
      wcpa_dj_nc_ofIdealTop_comap, wcpa_dj_nc_ofIdealTop_comap,
      wcpa_dj_mscc_ker_restrict_open Z' U (.of ↥W) Δ ΔU hΔci hΔU,
      wcpa_dj_mscc_ker_chart_comap ↥W U.toScheme m ΔU inferInstance hΔUm hker, hmstr]
  obtain ⟨hJ0FG, hJ0inv⟩ := wcpa_dj_mscc_model_centre Ω W c hc0
  have hinvτ : wcCsdInvPull (Scheme.Hom.ker Δ ⊔ wcNcPrincipal (.of ↥W) Z' u' c) τ₀ := by
    have h1 : wcCsdInvPull (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom
        (MvPolynomial.eval (fun _ : Fin 1 => (0 : ↥W))))) ⊔
        wcNcPrincipal (.of ↥W) (Spec (.of (MvPolynomial (Fin 1) ↥W)))
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) c)
        (τU ≫ m) := by
      rw [hτUm]; exact hJ0inv
    have h2 := (wcpa_dj_mscc_invpull_comap _ _ _ _ m τU inferInstance).mpr h1
    rw [← hJeq] at h2
    have h3 := (wcpa_dj_mscc_invpull_comap _ _ _ _ U.ι τU inferInstance).mp h2
    rw [hτU] at h3
    exact h3
  refine ⟨_, hFG, hsupp, hinv, hinvτ, ?_⟩
  intro Z rb hrb
  obtain ⟨M', r₀, hr₀⟩ := wcpa_dj_ms_blowup_exists_ft _ _ hJ0FG
  obtain ⟨hP1, hP2⟩ := wcpa_dj_mscc_model_blowup Ω W hW c hc0 hcm M' r₀ hr₀
  have hb1 := wcpa_dj_nc_blowup_flat_basechange Z' Z U.toScheme _ rb U.ι inferInstance hrb
  have hb2 := wcpa_dj_nc_blowup_flat_basechange _ M' U.toScheme _ r₀ m inferInstance hr₀
  rw [← hJeq] at hb2
  obtain ⟨θ, hθ, -⟩ := hb2.2 _ (Limits.pullback.snd rb U.ι) hb1.1
  obtain ⟨θ', hθ', -⟩ := hb1.2 _ (Limits.pullback.snd r₀ m) hb2.1
  have hθθ' : θ ≫ θ' = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb1.2 _ (Limits.pullback.snd rb U.ι) hb1.1
    exact (huniq _ (by show (θ ≫ θ') ≫ _ = _; rw [Category.assoc, hθ', hθ])).trans
      (huniq _ (Category.id_comp _)).symm
  have hθ'θ : θ' ≫ θ = 𝟙 _ := by
    obtain ⟨_, _, huniq⟩ := hb2.2 _ (Limits.pullback.snd r₀ m) hb2.1
    exact (huniq _ (by show (θ' ≫ θ) ≫ _ = _; rw [Category.assoc, hθ, hθ'])).trans
      (huniq _ (Category.id_comp _)).symm
  haveI : IsIso θ := ⟨θ', hθθ', hθ'θ⟩
  obtain ⟨h₂, hh₂⟩ : ∃ h₂ : Limits.pullback rb U.ι ⟶ M', h₂ = θ ≫ Limits.pullback.fst r₀ m :=
    ⟨_, rfl⟩
  haveI : Etale h₂ := by rw [hh₂]; infer_instance
  have hcomm : h₂ ≫ r₀ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) =
      Limits.pullback.fst rb U.ι ≫ rb ≫ u' := by
    rw [hh₂, Category.assoc, Limits.pullback.condition_assoc (f := r₀) (g := m),
      ← Category.assoc θ, hθ, hmstr, ← Limits.pullback.condition_assoc (f := rb) (g := U.ι)]
  refine ⟨?_, ?_⟩
  · intro K _ _ sp w hw
    obtain ⟨ρ, hρ1, hρ2⟩ := Scheme.exists_preimage_of_isPullback (IsPullback.of_hasPullback rb U.ι)
      (Limits.pullback.fst (rb ≫ u') sp w) (ΔU (IsLocalRing.closedPoint ↥W))
      (by rw [hw, ← hΔU]; rfl)
    have hsq : IsPullback
        (Limits.pullback.map (Limits.pullback.fst rb U.ι ≫ rb ≫ u') sp (rb ≫ u') sp
          (Limits.pullback.fst rb U.ι) (𝟙 _) (𝟙 _) (by rw [Category.comp_id])
          (by rw [Category.comp_id, Category.id_comp]))
        (Limits.pullback.fst (Limits.pullback.fst rb U.ι ≫ rb ≫ u') sp)
        (Limits.pullback.fst (rb ≫ u') sp) (Limits.pullback.fst rb U.ι) := by
