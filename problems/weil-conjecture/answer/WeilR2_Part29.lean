        (by rw [Category.comp_id, hcomm])
        (by rw [Category.comp_id, Category.id_comp]) ≫
        Limits.pullback.fst (r₀ ≫ Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W))) sp =
        Limits.pullback.fst (Limits.pullback.fst rb U.ι ≫ rb ≫ u') sp ≫ h₂ :=
