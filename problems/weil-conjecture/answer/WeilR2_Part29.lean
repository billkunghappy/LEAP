          · obtain rfl := h1; exact dvd_refl _
          · exact dvd_trans hd (hb'f i h1)
    have ha0 : a ≠ 0 := fun h0 => h (h0 ▸ dvd_zero _)
    obtain ⟨ν₁, hν₁⟩ := MvPolynomial.ne_zero_iff.mp ha0
    obtain ⟨c, hcmem, -, hcdvd⟩ := s1 a.support a.coeff (a.coeff ν₁)
    obtain ⟨ν₀, hν₀s, hν₀⟩ : ∃ ν₀ ∈ a.support, c = a.coeff ν₀ := by
      rcases hcmem with h1 | h1
