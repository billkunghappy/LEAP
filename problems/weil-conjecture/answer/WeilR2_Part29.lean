theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_extract_basis : ∀ (T A : Type u) [CommRing T] [CommRing A] [IsDomain A] [Algebra T A] (P : Ideal T), P.IsPrime → (∀ x y : T, ∃ u z : T, u ∉ P ∧ (u * x = z * y ∨ u * y = z * x)) → Function.Injective (algebraMap T A) → ∀ S : Finset A, (∀ s ∈ S, IsIntegral T s) → (∀ a : A, IsIntegral T a → ∃ g : T, g ∉ P ∧ algebraMap T A g * a ∈ Submodule.span T (S : Set A)) → ∃ (n : ℕ) (b : Fin n → A), (∀ j, IsIntegral T (b j)) ∧ LinearIndependent T b ∧ ∀ a : A, IsIntegral T a → ∃ g : T, g ∉ P ∧ ∃ c : Fin n → T, algebraMap T A g * a = ∑ j, algebraMap T A (c j) * b j :=
