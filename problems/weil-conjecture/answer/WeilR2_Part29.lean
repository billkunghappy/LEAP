  have hle := wc_smooth_alg_closed_dim_le Ω Ct ct 1
  have hge := wc_smooth_irreducible_dim_ge Ω Ct ct 1
  have hdim : topologicalKrullDim Ct = ((1 : ℕ) : WithBot ℕ∞) := le_antisymm hle hge
  obtain ⟨x⟩ := (IrreducibleSpace.toNonempty : Nonempty Ct)
  obtain ⟨y₀, -, -⟩ := wc_rational_closed_specialization Ω Ct ct x
  obtain ⟨N, j, hj, hjeq⟩ := hproj
  have hjs : j ≫ wcProjKStr Ω N = ct := hjeq
  have hsmV : SmoothOfRelativeDimension 1 ((⊤ : Ct.Opens).ι ≫ j ≫ wcProjKStr Ω N) := by
    rw [hjs]; exact (inferInstance : SmoothOfRelativeDimension (0 + 1) ((⊤ : Ct.Opens).ι ≫ ct))
  obtain ⟨φ, W, hφfin, hφs, hy₀W, hét⟩ := wc_proj_generic_projection_etale_at_point Ω N 1 Ct j
    hj hdim y₀ ⊤ (TopologicalSpace.Opens.mem_top _) hsmV
  exact ⟨φ, hφfin, hφs.trans hjs, W, W.isOpen.dense ⟨_, hy₀W⟩, hét⟩

theorem wcpa_dj_lr1s_finite_proj_ring : ∀ (R : Type u) [CommRing R] {Y Z : Scheme.{u}} (b : Y ⟶ Z) (uZ : Z ⟶ Spec (.of R)), IsFinite b → (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = uZ) → (∃ (N : ℕ) (j : Y ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = b ≫ uZ) :=
by
  intro R _ Y Z b uZ hb hZ
  have fpr_chart_surj : ∀ {S P Q X : Scheme.{u}} (sP : P ⟶ S) (sQ : Q ⟶ S) (N : ℕ) (D : Fin (N + 1) → P.Opens) (e : ∀ J L : Fin (N + 1), Γ(P, D J)) (V : Q.Opens) (b : X ⟶ P) (ψ : X ⟶ Q) (l : Fin (N + 1)) (hψ : b ⁻¹ᵁ D l ≤ ψ ⁻¹ᵁ V) (G : Set Γ(X, b ⁻¹ᵁ D l)), ψ ≫ sQ = b ≫ sP → (∀ x : Γ(P, D l), x ∈ Subring.closure (Set.range (e l) ∪ Set.range (fun c : Γ(S, ⊤) => P.presheaf.map (homOfLE (le_top : D l ≤ ⊤)).op (sP.appTop c)))) → (∀ t : Γ(X, b ⁻¹ᵁ D l), t ∈ Subring.closure (Set.range (b.app (D l)) ∪ G)) → (∀ m : Fin (N + 1), ∃ c, ψ.appLE V (b ⁻¹ᵁ D l) hψ c = b.app (D l) (e l m)) → (∀ g ∈ G, ∃ c, ψ.appLE V (b ⁻¹ᵁ D l) hψ c = g) → ∀ t : Γ(X, b ⁻¹ᵁ D l), ∃ c, ψ.appLE V (b ⁻¹ᵁ D l) hψ c = t := by
    intro S P Q X sP sQ N D e V b ψ l hψ G H1 H2 H3 H4 H5
    have hconst : ∀ {W P' : Scheme.{u}} (h : W ⟶ P') (U : P'.Opens) (V : W.Opens) (e : V ≤ h ⁻¹ᵁ U)
        (x : Γ(P', ⊤)),
        h.appLE U V e (P'.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op x) =
          W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (h.appTop x) := by
      intro W P' h U V e x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      rfl
    have hphi : ∀ x : Γ(P, D l),
        ∃ c, ψ.appLE V (b ⁻¹ᵁ D l) hψ c = b.app (D l) x := by
      intro x
      have hle := (Subring.closure_le
        (t := ((ψ.appLE V (b ⁻¹ᵁ D l) hψ).hom.range.comap (b.app (D l)).hom))
        (s := Set.range (e l) ∪ Set.range (fun c : Γ(S, ⊤) => P.presheaf.map
          (homOfLE (le_top : D l ≤ ⊤)).op (sP.appTop c)))).mpr (by
        rintro _ (⟨m, rfl⟩ | ⟨c, rfl⟩)
        · exact Subring.mem_comap.mpr (RingHom.mem_range.mpr (H4 m))
        · refine Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨Q.presheaf.map
            (homOfLE (le_top : V ≤ ⊤)).op (sQ.appTop c), ?_⟩)
