      (∀ x y : T, ∃ u z : T, u ∉ P ∧ (u * x = z * y ∨ u * y = z * x)) →
      (∀ a b : Localization.AtPrime P, a * b = 0 → a = 0 ∨ b = 0) ∧
      (∀ x y : Localization.AtPrime P, x ∣ y ∨ y ∣ x) ∧
      algebraMap T (Localization.AtPrime P) t ≠ 0 := by
    intro T _ _ P _ t ht0 hv
    have hinj : Function.Injective (algebraMap T (Localization.AtPrime P)) :=
      IsLocalization.injective (Localization.AtPrime P) (Ideal.primeCompl_le_nonZeroDivisors P)
    have hunit : ∀ g : T, g ∉ P → IsUnit (algebraMap T (Localization.AtPrime P) g) := fun g hg =>
      IsLocalization.map_units (Localization.AtPrime P) (⟨g, hg⟩ : P.primeCompl)
    refine ⟨fun a b h => mul_eq_zero.mp h, ?_, ?_⟩
    · intro x y
      obtain ⟨⟨a₁, g₁⟩, h1⟩ := IsLocalization.surj P.primeCompl x
      obtain ⟨⟨a₂, g₂⟩, h2⟩ := IsLocalization.surj P.primeCompl y
      simp only at h1 h2
      obtain ⟨u, z, hu, hcase⟩ := hv a₁ a₂
      obtain ⟨Ui, hUi⟩ := isUnit_iff_exists_inv.mp (hunit u hu)
      obtain ⟨G1i, hG1⟩ := isUnit_iff_exists_inv.mp (hunit g₁ g₁.2)
      obtain ⟨G2i, hG2⟩ := isUnit_iff_exists_inv.mp (hunit g₂ g₂.2)
      rcases hcase with h | h
      · right
