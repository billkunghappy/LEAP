  obtain ⟨-, -, -, h4a, h4b, h5⟩ := wcpa_dj_lr1s_nf_cnf_fmp_gb_cs_rf_tr_finite_ext_adm Ω W hW ϖ
    hϖ0 hϖnu d hcont hval ht0 K N
  have hvalN : ∀ y : N, y ≠ 0 → IsIntegral (wcGbVhat W ϖ d) y ∨
      IsIntegral (wcGbVhat W ϖ d) y⁻¹ := by
    intro y hy
    obtain ⟨z, hz, hor⟩ := h4a y hy
    rw [← eq_inv_of_mul_eq_one_right hz]
    exact hor
  have hicG : ∀ (V K' : Type u) [CommRing V] [IsDomain V] [Field K'] [Algebra V K']
      [IsFractionRing V K'], (∀ x y : V, x ∣ y ∨ y ∣ x) → ∀ x : K', IsIntegral V x →
      ∃ s : V, algebraMap V K' s = x := by
    intro V K' _ _ _ _ _ htot' x hx
    haveI : ValuationRing V := ValuationRing.iff_dvd_total.mpr ⟨fun a b => htot' a b⟩
    letI : GCDMonoid V := IsBezout.toGCDDomain V
    exact IsIntegrallyClosed.isIntegral_iff.mp hx
  have hic : ∀ x : K, IsIntegral (wcGbVhat W ϖ d) x →
      ∃ s : wcGbVhat W ϖ d, algebraMap (wcGbVhat W ϖ d) K s = x :=
    hicG (wcGbVhat W ϖ d) K htot

  have hnu : ∀ r : wcGbVhat W ϖ d, ¬ IsUnit r → (algebraMap (wcGbVhat W ϖ d) N r = 0 ∨
