        exact hvu ⟨↑c'⁻¹, by rw [hc, mul_assoc, Units.mul_inv, mul_one]⟩
      have hgu : π (κ u) ≠ 0 := fun h => hu0 (hginj (by rw [RingHom.comp_apply, h, map_zero]))
