  have h0 : Polynomial.aeval a R = 0 := by
    have h2 : algebraMap T A t ^ (k * n) * Polynomial.aeval a R = 0 := by rw [hRa]; exact hpa
    exact (mul_eq_zero.mp h2).resolve_left (pow_ne_zero _ hthat)
  exact ⟨R, hRm, by rw [← Polynomial.aeval_def]; exact h0⟩

theorem wcpa_dj_lr1s_nf_cnf_fmp_gb_gauss_prime : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ (ϖ : ↥W), ϖ ≠ 0 → ¬ IsUnit ϖ → ∀ (d : ℕ), (wcGbP W ϖ d).IsPrime ∧ (∀ f : wcGbT W ϖ d, f ≠ 0 → ∃ (c : ↥W) (N : ℕ) (f₀ : wcGbT W ϖ d), c ≠ 0 ∧ c ∣ ϖ ^ N ∧ f₀ ∉ wcGbP W ϖ d ∧ f = algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C c) * f₀) ∧ (∀ x y : wcGbT W ϖ d, ∃ u z : wcGbT W ϖ d, u ∉ wcGbP W ϖ d ∧ (u * x = z * y ∨ u * y = z * x)) :=
by
  intro Ω _ _ W hW ϖ hϖ0 hϖnu d
  classical
  have hres0 : ∀ a : ↥W, ¬ IsUnit a → IsLocalRing.residue ↥W a = 0 := fun a ha =>
    (IsLocalRing.residue_eq_zero_iff a).mpr ((IsLocalRing.mem_maximalIdeal a).mpr ha)

  have hψI : ∀ q ∈ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) ^ 1,
      MvPolynomial.map (IsLocalRing.residue ↥W) q = 0 := by
    intro q hq
    rw [pow_one] at hq
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hq
    rw [map_mul, MvPolynomial.map_C, hres0 ϖ hϖnu, map_zero, mul_zero]
  obtain ⟨ρ, hρ⟩ : ∃ ρ : wcGbT W ϖ d →+* MvPolynomial (Fin d) (IsLocalRing.ResidueField ↥W),
      ∀ q : MvPolynomial (Fin d) ↥W, ρ (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) q) =
        MvPolynomial.map (IsLocalRing.residue ↥W) q := by
    refine ⟨(Ideal.Quotient.lift _ (MvPolynomial.map (IsLocalRing.residue ↥W)) hψI).comp
      (AdicCompletion.evalₐ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) 1).toRingHom,
      fun q => ?_⟩
    show Ideal.Quotient.lift _ (MvPolynomial.map (IsLocalRing.residue ↥W)) hψI
      (AdicCompletion.evalₐ (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) 1
        (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) q)) = _
    rw [AlgHom.commutes]
    rfl
  have hψ0 : ∀ a : ↥W, ¬ IsUnit a →
      ρ (algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d) (MvPolynomial.C a)) = 0 := by
    intro a ha
    rw [hρ, MvPolynomial.map_C, hres0 a ha, map_zero]

  have hker : ∀ f : wcGbT W ϖ d, f ∈ wcGbP W ϖ d → ρ f = 0 := by
    intro f hf
    have hf' : f ∈ (Ideal.span {algebraMap (MvPolynomial (Fin d) ↥W) (wcGbT W ϖ d)
        (MvPolynomial.C ϖ)}).radical := hf
    obtain ⟨n, hn⟩ := hf'
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton'.mp hn
    have h1 : ρ f ^ n = 0 := by
      rw [← map_pow, ← hz, map_mul, hψ0 ϖ hϖnu, mul_zero]
    exact IsNilpotent.eq_zero ⟨n, h1⟩
  have hnotin : ∀ f : wcGbT W ϖ d, ρ f ≠ 0 → f ∉ wcGbP W ϖ d := fun f h hf => h (hker f hf)
  have h1notin : (1 : wcGbT W ϖ d) ∉ wcGbP W ϖ d := hnotin 1 (by rw [map_one]; exact one_ne_zero)

  have hcontent : ∀ (f : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)), f ≠ 0 → ∃ (c μ : ↥W) (k : ℕ) (F : MvPolynomial (Fin d) ↥W) (y : AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)), c * μ = ϖ ^ k ∧ ¬ IsUnit μ ∧ (∃ e, F.coeff e = 1) ∧ f = algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C c) * (algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) F + algebraMap (MvPolynomial (Fin d) ↥W) (AdicCompletion (Ideal.span {(MvPolynomial.C ϖ : MvPolynomial (Fin d) ↥W)}) (MvPolynomial (Fin d) ↥W)) (MvPolynomial.C μ) * y) := by
    intro f hf
    have sepGen : ∀ (R : Type u) [CommRing R] (r : R) (x : AdicCompletion (Ideal.span {r}) R),
        (∀ k : ℕ, ∃ y : AdicCompletion (Ideal.span {r}) R,
          x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ k * y) → x = 0 := by
      intro R _ r x hx
      have hc : IsAdicComplete (Ideal.span {r}) (AdicCompletion (Ideal.span {r}) R) :=
        AdicCompletion.isAdicComplete (Submodule.fg_span_singleton r)
      have s1 : ∀ (n : ℕ) (x : AdicCompletion (Ideal.span {r}) R),
          (∃ y : AdicCompletion (Ideal.span {r}) R,
            x = algebraMap R (AdicCompletion (Ideal.span {r}) R) r ^ n * y) →
          x ∈ (Ideal.span {r} ^ n • ⊤ : Submodule R (AdicCompletion (Ideal.span {r}) R)) := by
        rintro n x ⟨y, rfl⟩
        rw [← map_pow, ← Algebra.smul_def]
        exact Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self r) n)
