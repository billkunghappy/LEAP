      refine ⟨k, ?_⟩
      simp only at hk
      subst hk
      exact hm'
    choose k hk using hv'
    refine ⟨∑ i, k i, ?_⟩
    funext i
    simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    have hle : k i ≤ ∑ j, k j :=
