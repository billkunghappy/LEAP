  have hpW : ¬ IsUnit ((ringChar (IsLocalRing.ResidueField ↥W) : ℕ) : ↥W) := by
    intro hu
    have h1 := (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hu
    rw [map_natCast, ringChar.Nat.cast_ringChar] at h1
    exact h1 rfl
  have hpV : ¬ IsUnit ((ringChar (IsLocalRing.ResidueField ↥W) : ℕ) : wcGbVhat W ϖ d) := by
    have := hloc _ hpW
    rwa [map_natCast] at this
  have hpN : ((ringChar (IsLocalRing.ResidueField ↥W) : ℕ) : N) = 0 ∨
      ¬ IsIntegral (wcGbVhat W ϖ d) ((ringChar (IsLocalRing.ResidueField ↥W) : ℕ) : N)⁻¹ := by
    have := hnu _ hpV
    rwa [map_natCast] at this
  generalize hpdef : ringChar (IsLocalRing.ResidueField ↥W) = p at hpN ⊢

  have p8 : ∀ (V E : Type u) [CommRing V] [Field E] [Algebra V E],
      (∀ y : E, y ≠ 0 → IsIntegral V y ∨ IsIntegral V y⁻¹) →
      ∃ O : ValuationSubring E, (∀ x : E, x ∈ O ↔ IsIntegral V x) ∧
        ∀ (x : E) (hx : x ∈ O), ((⟨x, hx⟩ : O) ∈ IsLocalRing.maximalIdeal O ↔
