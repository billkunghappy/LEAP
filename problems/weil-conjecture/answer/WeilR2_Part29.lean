    have Pone : R 1 := by
      by_cases hn : 0 < n
      · have h1 : m (fun _ => ⟨0, hn⟩) = 1 := by
          rw [hm]; exact Finset.prod_eq_one (fun i _ => pow_zero _)
        have hP := Pmon (fun _ => ⟨0, hn⟩)
        rwa [h1] at hP
      · by_cases hN : 0 < N
        · have hP := Pideal ⟨0, hN⟩ 1
          rwa [show n = 0 by omega, pow_zero, one_mul] at hP
        · have h1 : m (fun i => absurd i.isLt (by omega)) = 1 := by
            rw [hm]; exact Finset.prod_eq_one (fun i _ => absurd i.isLt (by omega))
          have hP := Pmon (fun i => absurd i.isLt (by omega))
          rwa [h1] at hP

    have Pmulof : ∀ c : C, ∀ z, R z → R (of c * z) := by
      intro c
      have hc : c ∈ Algebra.adjoin R0 (Set.range g) := by rw [hg]; exact Algebra.mem_top
      induction hc using Algebra.adjoin_induction with
      | mem c' hc' =>
        obtain ⟨j, rfl⟩ := hc'
        intro z hz
        have e : of (g j) * z = x j * z + κ (a j) * z := by rw [hx]; ring
        rw [e]; exact Padd _ _ (Pxs j z hz) (Psmul (a j) z hz)
      | algebraMap r =>
        intro z hz; rw [← hκ']; exact Psmul _ z hz
      | add c1 c2 _ _ h1 h2 =>
        intro z hz; rw [map_add, add_mul]; exact Padd _ _ (h1 z hz) (h2 z hz)
      | mul c1 c2 _ _ h1 h2 =>
        intro z hz; rw [map_mul, mul_assoc]; exact h1 _ (h2 z hz)
    have Pof : ∀ c : C, R (of c) := by
      intro c
      have hP := Pmulof c 1 Pone
      rwa [mul_one] at hP

    have Pall : ∀ y, R y := by
      choose E T hET using fun c => (hR (of c)).mp (Pof c)
      choose dig nxt hdn using hdig
      intro y
      obtain ⟨d, hd⟩ : ∃ d : ℕ → C, ∀ j, d j = dig (nxt^[j] y) := ⟨_, fun _ => rfl⟩
      have hD : ∀ k : ℕ, y = ∑ j ∈ Finset.range k, p ^ j * of (d j) + p ^ k * nxt^[k] y := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
          rw [Finset.sum_range_succ, Function.iterate_succ_apply', hd k]
          have h := hdn (nxt^[k] y)
          linear_combination ih + p ^ k * h
      obtain ⟨F, hF⟩ : ∃ F : (Fin N → Fin n) → ℕ → W',
          ∀ β k, F β k = ∑ j ∈ Finset.range k, u ^ j * E (d j) β := ⟨_, fun _ _ => rfl⟩
      obtain ⟨G, hG⟩ : ∃ G : Fin N → ℕ → Ch,
          ∀ i k, G i k = ∑ j ∈ Finset.range k, p ^ j * T (d j) i := ⟨_, fun _ _ => rfl⟩
      choose L hL using fun β => hserW (F β)
        (fun k => ⟨E (d k) β, by simp only [hF, Finset.sum_range_succ]; ring⟩)
      choose zL hzL using hL
      choose Tl hTl using fun i => hserC (G i)
        (fun k => ⟨T (d k) i, by simp only [hG, Finset.sum_range_succ]; ring⟩)
      choose wT hwT using hTl
      have hre : ∀ k, ∑ j ∈ Finset.range k, p ^ j * of (d j) =
          ∑ β, κ (F β k) * m β + ∑ i, x i ^ n * G i k := by
        intro k
        induction k with
        | zero => simp [hF, hG]
        | succ k ih =>
          have e1 : ∀ β, κ (F β (k + 1)) = κ (F β k) + p ^ k * κ (E (d k) β) := by
            intro β
            rw [hF, hF, Finset.sum_range_succ, map_add, map_mul, map_pow, hu]
          have e2 : ∀ i, G i (k + 1) = G i k + p ^ k * T (d k) i := by
            intro i
            rw [hG, hG, Finset.sum_range_succ]
          have s1 : ∑ β, κ (F β (k + 1)) * m β =
              ∑ β, κ (F β k) * m β + p ^ k * ∑ β, κ (E (d k) β) * m β := by
            rw [Finset.mul_sum, ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl (fun β _ => by rw [e1]; ring)
          have s2 : ∑ i, x i ^ n * G i (k + 1) =
              ∑ i, x i ^ n * G i k + p ^ k * ∑ i, x i ^ n * T (d k) i := by
            rw [Finset.mul_sum, ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl (fun i _ => by rw [e2]; ring)
          rw [Finset.sum_range_succ, ih, hET (d k), s1, s2]
          ring
      have hΔ : ∀ k : ℕ, ∃ w : Ch,
          y - (∑ β, κ (L β) * m β + ∑ i, x i ^ n * Tl i) = p ^ k * w := by
        intro k
        refine ⟨nxt^[k] y - ∑ β, κ (zL β k) * m β - ∑ i, x i ^ n * wT i k, ?_⟩
        have eL : ∀ β, κ (L β) = κ (F β k) + p ^ k * κ (zL β k) := by
          intro β
          have hL' : L β = F β k + u ^ k * zL β k := by linear_combination hzL β k
          rw [hL', map_add, map_mul, map_pow, hu]
        have eT : ∀ i, Tl i = G i k + p ^ k * wT i k := by
          intro i
          linear_combination hwT i k
        have s1 : ∑ β, κ (L β) * m β =
            ∑ β, κ (F β k) * m β + p ^ k * ∑ β, κ (zL β k) * m β := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl (fun β _ => by rw [eL]; ring)
        have s2 : ∑ i, x i ^ n * Tl i =
            ∑ i, x i ^ n * G i k + p ^ k * ∑ i, x i ^ n * wT i k := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl (fun i _ => by rw [eT]; ring)
        rw [s1, s2]
        have h1 := hD k
        rw [hre k] at h1
        linear_combination h1
