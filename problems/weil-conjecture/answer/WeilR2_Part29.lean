        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})))) sp)),
      wcpaDjMsFibreNS (Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸
