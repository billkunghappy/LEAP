theorem wcpa_dj_mscm_chart_data_X : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (c : ↥W), c ≠ 0 → ∀ (M' : Scheme.{u}) (r₀ : M' ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (U : Fin 2 → M'.Opens) (t : ∀ l : Fin 2, Fin 2 → Γ(M', U l)), wcBpChartHyp r₀ ![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)] U t → ∃ (h : Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})) ⟶ Spec (.of (MvPolynomial (Fin 1) ↥W))) (τ : Fin 2 → Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})), ⊤)), h ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.C : ↥W →+* MvPolynomial (Fin 1) ↥W)) = Spec.map (CommRingCat.ofHom (algebraMap ↥W (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c}))) ∧ (∀ j, h.appTop.hom (![(Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0), (Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.C c)] j) = τ j * h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0))) ∧ h.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin 1) ↥W))).inv.hom (MvPolynomial.X 0)) ∈ nonZeroDivisors Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})), ⊤) ∧ (∀ s : Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})), ⊤), s ∈ Subring.closure (Set.range h.appTop.hom ∪ Set.range τ)) ∧ ∃ φ : Γ(Spec (.of (MvPolynomial (Fin 2) ↥W ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C c})), ⊤) →+* Γ(M', U 0), φ.comp h.appTop.hom = (r₀.appLE ⊤ (U 0) (by simp)).hom ∧ ∀ j, φ (τ j) = t 0 j :=
by
  intro Ω _ W c hc M' r₀ U t hU
