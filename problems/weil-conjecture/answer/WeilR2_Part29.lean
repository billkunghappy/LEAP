    haveI : Algebra.Etale (MvPolynomial (Fin 2) R) L := ⟨inferInstance, inferInstance⟩
    exact this
  have t_sqroot : ∀ (B : Type u) [CommRing B] (β c : B) (Q : Ideal B) [Q.IsPrime] (hc : c ∈ Q) (hβ : β ∉ Q),
      ∃ (C₀ : Type u) (_ : CommRing C₀) (φ : B →+* C₀) (w w' : C₀) (𝔔₀ : Ideal C₀),
