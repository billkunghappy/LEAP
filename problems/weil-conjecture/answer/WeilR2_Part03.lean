        (toSheafify (Scheme.smallEtaleTopology Y) ((wcEtBaseChange p).op ⋙ F.obj)) _
    have h5 : Sheaf.IsLocallySurjective ((wcEtPush p).map φ) := h4
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp h5

  haveI := Functor.preservesHomology_of_preservesEpis_and_kernels (wcEtPush p)
  exact Functor.preservesFiniteColimits_of_preservesHomology (wcEtPush p)

theorem wc_et_quot_h1_surj_finite_push : ∀ (Y Z : Scheme.{u}) (p : Z ⟶ Y) [IsFinite p]
    [Limits.PreservesFiniteColimits (wcEtPush p)]
    (W : Set Y), IsOpen W →
    ∀ (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}),
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    (∀ (F' : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (ιF : F' ⟶ F), Mono ιF →
      wcSuppIn Z (p ⁻¹' W) F' →
      (∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (χ : H ⟶ F),
          wcSuppIn Z (p ⁻¹' W) H → ∃ χ' : H ⟶ F', χ' ≫ ιF = χ) →
      ∀ ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) 1,
        ∃ η : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) F 1,
          η.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ιF)) (add_zero 1) = ζ) →
    ∀ (G' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (ιG : G' ⟶ (wcEtPush p).obj F), Mono ιG → wcSuppIn Y W G' →
    (∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H ⟶ (wcEtPush p).obj F),
        wcSuppIn Y W H → ∃ χ' : H ⟶ G', χ' ≫ ιG = χ) →
    ∀ ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιG) 1,
      ∃ η : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((wcEtPush p).obj F) 1,
        η.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ιG)) (add_zero 1) = ζ :=
by

  have s4 : ∀ (Y : Scheme.{u}) (W : Set Y) (P : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V : Y.Etale) (s : P.obj (Opposite.op V)),
        Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
          P.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V) →
      wcSuppIn Y W ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P) := by
    intro Y W P hP V t
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) P) t
    refine GrothendieckTopology.transitive _ hI _ ?_
    intro V' f hf
    obtain ⟨q, hq⟩ := hf
    refine GrothendieckTopology.superset_covering _ ?_ (hP V' q)
    rw [Sieve.generate_le_iff]
    intro V'' h hh
    rw [Sieve.pullback_apply]
    apply Sieve.le_generate
    rcases hh with h0 | hW
    · left
      have e1 : (sheafify (Scheme.smallEtaleTopology Y) P).map (h ≫ f).op t =
          (toSheafify (Scheme.smallEtaleTopology Y) P).app (Opposite.op V'') (P.map h.op q) := by
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, ← hq,
          NatTrans.naturality_apply]
      show (sheafify (Scheme.smallEtaleTopology Y) P).map (h ≫ f).op t = 0
      rw [e1, h0, map_zero]
    · right
      exact hW
  intro Y Z p _ _ W hW F HZ G' ιG hGmono hGsupp hGuniv ζ
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  obtain ⟨F', ιF, hFmono, hFsupp, hFuniv⟩ := wc_et_max_supported_subsheaf Z (p ⁻¹' W) F

  obtain ⟨L, ⟨adj⟩, hL, ⟨eZ⟩⟩ := wc_et_push_left_adjoint p

  have hpre : ∀ (V : Y.Etale) (s : F'.obj.obj (Opposite.op ((wcEtBaseChange p).obj V))),
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        F'.obj.map ((wcEtBaseChange p).map g).op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈
        Scheme.smallEtaleTopology Y V := by
    intro V s
    apply wc_etale_jointly_surjective_covers
    intro v
    by_cases hv : V.hom v ∈ W
    · let O : V.left.Opens := V.hom ⁻¹ᵁ ⟨W, hW⟩
      refine ⟨wcEtOpen Y V O, wcEtOpenι Y V O, ?_, ?_⟩
      · apply Sieve.le_generate
        right
        intro x
        let x' : ↥(O : Scheme.{u}) := x
        have hx : O.ι x' ∈ Set.range O.ι := ⟨x', rfl⟩
        rw [Scheme.Opens.range_ι] at hx
        have e : (O.ι ≫ V.hom) x' = V.hom (O.ι x') := Scheme.Hom.comp_apply _ _ _
        show (O.ι ≫ V.hom) x' ∈ W
        exact e ▸ hx
      · show v ∈ Set.range O.ι
        rw [Scheme.Opens.range_ι]
        exact hv
    · have hfib : ∀ z : ((wcEtBaseChange p).obj V).left, Limits.pullback.fst V.hom p z = v →
          ∃ (V₁ : Z.Etale) (c : V₁ ⟶ (wcEtBaseChange p).obj V), z ∈ Set.range c.left ∧
            F'.obj.map c.op s = 0 := by
        intro z hz
        have hR := hFsupp ((wcEtBaseChange p).obj V) s
        change _ ∈ Scheme.smallGrothendieckTopology @Etale Z _ at hR
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
        obtain ⟨Y₀, g, y, hg, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR z
        obtain ⟨Y', k, g', hg', hcomp⟩ := hg
        have hy' : g'.left (k.left y) = z := by
          rw [← hy, ← hcomp]
          rfl
        rcases hg' with h0 | hW'
        · exact ⟨Y', g', ⟨k.left y, hy'⟩, h0⟩
        · exfalso
          have h1 := hW' (k.left y)
          have h2 : Y'.hom (k.left y) = ((wcEtBaseChange p).obj V).hom z := by
            rw [← MorphismProperty.Over.w g', Scheme.Hom.comp_apply, hy']
          rw [h2] at h1
          let z' : ↥(Limits.pullback V.hom p) := z
          have h1' : p (Limits.pullback.snd V.hom p z') ∈ W := h1
          have hz' : Limits.pullback.fst V.hom p z' = v := hz
          have e1 : V.hom (Limits.pullback.fst V.hom p z') =
              p (Limits.pullback.snd V.hom p z') := by
            rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
          rw [← e1, hz'] at h1'
          exact hv h1'
      obtain ⟨O, hvO, hO⟩ := wc_finite_fibre_vanishing_zariski_nbhd p F'
        (fun O g => wc_etale_section_vanishing_open Z F' O g) V s v hfib
      refine ⟨wcEtOpen Y V O, wcEtOpenι Y V O, ?_, ?_⟩
      · apply Sieve.le_generate
        left
        exact hO
      · show v ∈ Set.range O.ι
        rw [Scheme.Opens.range_ι]
        exact hvO
  have hRsupp : wcSuppIn Y W ((wcEtPush p).obj F') := by
    have h := s4 Y W ((wcEtBaseChange p).op ⋙ F'.obj) hpre
    exact h

  have hRmax : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (χ : H ⟶ (wcEtPush p).obj F), wcSuppIn Y W H →
      ∃ χ' : H ⟶ (wcEtPush p).obj F', χ' ≫ (wcEtPush p).map ιF = χ := by
    intro H χ hH
    obtain ⟨φ', hφ'⟩ := hFuniv (L.obj H) ((adj.homEquiv H F).symm χ)
      (wc_et_supp_left_adjoint_pullback p L ⟨adj⟩ W H hH)
    refine ⟨adj.unit.app H ≫ (wcEtPush p).map φ', ?_⟩
    rw [Category.assoc, ← Functor.map_comp, hφ', ← Adjunction.homEquiv_unit,
      Equiv.apply_symm_apply]

  obtain ⟨α, hα⟩ := hRmax G' ιG hGsupp
  obtain ⟨β, hβ⟩ := hGuniv _ ((wcEtPush p).map ιF) hRsupp
  have w1 : ιG ≫ Limits.cokernel.π ((wcEtPush p).map ιF) = 0 := by
    rw [← hα, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  have w2 : (wcEtPush p).map ιF ≫ Limits.cokernel.π ιG = 0 := by
    rw [← hβ, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  obtain ⟨c, hc⟩ : ∃ c : Limits.cokernel ιG ⟶ Limits.cokernel ((wcEtPush p).map ιF),
      Limits.cokernel.π ιG ≫ c = Limits.cokernel.π ((wcEtPush p).map ιF) :=
    ⟨_, Limits.cokernel.π_desc _ _ w1⟩
  obtain ⟨c', hc'⟩ : ∃ c' : Limits.cokernel ((wcEtPush p).map ιF) ⟶ Limits.cokernel ιG,
      Limits.cokernel.π ((wcEtPush p).map ιF) ≫ c' = Limits.cokernel.π ιG :=
    ⟨_, Limits.cokernel.π_desc _ _ w2⟩
  have hcc' : c ≫ c' = 𝟙 _ := by
    rw [← cancel_epi (Limits.cokernel.π ιG), ← Category.assoc, hc, hc', Category.comp_id]

  haveI := hL
  haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
  haveI : Limits.PreservesFiniteLimits (wcEtPush p) := by
    letI := adj.rightAdjoint_preservesLimits
    infer_instance
  haveI := wc_et_enough_injectives Z
  haveI hκiso : IsIso (Limits.cokernelComparison ιF (wcEtPush p)) := inferInstance
  have hκ : Limits.cokernel.π ((wcEtPush p).map ιF) ≫ Limits.cokernelComparison ιF (wcEtPush p) =
      (wcEtPush p).map (Limits.cokernel.π ιF) :=
    Limits.π_comp_cokernelComparison _ _
  have hcancel : ∀ x y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        (Limits.cokernel ((wcEtPush p).map ιF)) 1,
      x.comp (Abelian.Ext.mk₀ (Limits.cokernelComparison ιF (wcEtPush p))) (add_zero 1) =
        y.comp (Abelian.Ext.mk₀ (Limits.cokernelComparison ιF (wcEtPush p))) (add_zero 1) →
      x = y := by
    have key : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          (Limits.cokernel ((wcEtPush p).map ιF)) 1,
