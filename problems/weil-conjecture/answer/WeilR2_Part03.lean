    have hsurjH : ∀ n (y : Γ(Hs n, V)), ∃ s : Γ((Scheme.Modules.pushforward p).obj F'', V),
        Scheme.Modules.Hom.app (φH n) V s = y := fun n y => (hHalg.2.2 n V hV).1 y
    choose s hs using fun i n => hsurjH n (yg i n)
    have hzi := fun i => hzc (yg i) (s i) (hyg i) (hs i)
    choose e x hx hxη using fun i =>
      hloc (fun n => Scheme.Modules.Hom.app ((Scheme.Modules.pushforward p).map (φ'' n)) V (s i n))
        (hzi i)
    have hαx : ∀ i n, Scheme.Modules.Hom.app (α n) V (x i n) = f ^ e i • yg i n := fun i =>
      keyC (yg i) (s i) (hyg i) (hs i) (x i) (f ^ e i) (hx i) (hxη i)
    have hle : ∀ i, e i ≤ ∑ j, e j := fun i =>
      Finset.single_le_sum (fun j _ => Nat.zero_le (e j)) (Finset.mem_univ i)
    have hfe : ∀ i, f ^ (∑ j, e j - e i) * f ^ e i = f ^ (∑ j, e j) := fun i => by
      rw [← pow_add, Nat.sub_add_cancel (hle i)]
