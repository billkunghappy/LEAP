    intro Y U V g Q τ₀ hK
    let J := Scheme.smallEtaleTopology Y
    let PU := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let PV := yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let τ := (presheafToSheaf J AddCommGrpCat.{u+1}).map τ₀
    let Qs := (presheafToSheaf J AddCommGrpCat.{u+1}).obj Q
    let γ := (g.hom.app (Opposite.op V)).hom (wcSmeGen V V (FreeAbelianGroup.of (ULift.up (𝟙 V))))
    have key : (τ.hom.app (Opposite.op V)).hom γ = 0 := by
      haveI : Presheaf.IsLocallySurjective J (toSheafify J PU) :=
        Presheaf.isLocallySurjective_toSheafify' _ _
      have hS := Presheaf.imageSieve_mem J (toSheafify J PU) (U := Opposite.op V) γ
      refine Qs.isSeparated V _ hS _ 0 (fun T' d hd => ?_)
      obtain ⟨R, hR⟩ := hd
