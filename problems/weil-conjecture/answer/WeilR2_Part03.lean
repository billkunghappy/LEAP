      intro x
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    intro x y hxy
