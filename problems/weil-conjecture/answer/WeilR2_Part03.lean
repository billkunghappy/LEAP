  let R := (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hV0.ge).op).hom
  have hΨlin : ∀ (b : Γ(P, V)) (y : Γ((Scheme.Modules.pullback (Spec.map (q.appLE U V hle))).obj (F.restrict hU.fromSpec), ⊤)), R ((Scheme.Modules.Hom.app J.hom ⊤).hom (b • y)) = b • R ((Scheme.Modules.Hom.app J.hom ⊤).hom y) := by
    intro b y
    refine (congrArg R (hlinTop J.hom b y)).trans ?_
    refine (congrArg R (s1 P V hV ((Scheme.Modules.pullback q).obj F) ⊤ b ((Scheme.Modules.Hom.app J.hom ⊤).hom y))).trans ?_
    refine (Scheme.Modules.map_smul _ _ _ _).trans ?_
    exact congrArg (· • R ((Scheme.Modules.Hom.app J.hom ⊤).hom y)) ((hresZ _ _ b).trans (hidZ _ b))
  let Ψ : Γ((Scheme.Modules.pullback (Spec.map (q.appLE U V hle))).obj (F.restrict hU.fromSpec), ⊤) ≃ₗ[Γ(P, V)] Γ((Scheme.Modules.pullback q).obj F, V) :=
    AddEquiv.toLinearEquiv
      { toFun := fun y => R ((Scheme.Modules.Hom.app J.hom ⊤).hom y)
        invFun := fun z => (Scheme.Modules.Hom.app J.inv ⊤).hom ((((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hV0.le).op).hom z)
        left_inv := fun y => (congrArg (Scheme.Modules.Hom.app J.inv ⊤).hom ((hresF ((Scheme.Modules.pullback q).obj F) hV0.ge hV0.le _).trans (hidF _ _ _))).trans (hinv J ⊤ y)
        right_inv := fun z => (congrArg R (hinv' J ⊤ _)).trans ((hresF ((Scheme.Modules.pullback q).obj F) hV0.le hV0.ge z).trans (hidF _ _ z))
        map_add' := fun y y' => (congrArg R (map_add (Scheme.Modules.Hom.app J.hom ⊤).hom y y')).trans (map_add (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hV0.ge).op).hom _ _) }
      hΨlin

  refine ⟨(LinearEquiv.baseChange Γ(Z, U) Γ(P, V) _ _ ρL).trans (e0.trans (Ξ.trans Ψ)), fun a x => ?_⟩
  rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, LinearEquiv.trans_apply, LinearEquiv.baseChange_tmul, he0, LinearEquiv.map_smul, LinearEquiv.map_smul]
  congr 1
  have k1 : Ξ ((Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction (Spec.map (q.appLE U V hle))).unit.app (tilde ((modulesSpecToSheaf.obj (F.restrict hU.fromSpec)).presheaf.obj (Opposite.op ⊤)))) ⊤).hom ((tilde.toOpen ((modulesSpecToSheaf.obj (F.restrict hU.fromSpec)).presheaf.obj (Opposite.op ⊤)) ⊤).hom (ρL x))) = (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction (Spec.map (q.appLE U V hle))).unit.app (F.restrict hU.fromSpec)) ⊤).hom (ρL x) :=
    (hunit (Spec.map (q.appLE U V hle)) ε.hom ⊤ _).trans (congrArg _ (hfromTilde (F.restrict hU.fromSpec) (ρL x)))
  have k2 : Ψ ((Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction (Spec.map (q.appLE U V hle))).unit.app (F.restrict hU.fromSpec)) ⊤).hom (ρL x)) = (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hle).op).hom ((Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction q).unit.app F) U).hom x) :=
    (congrArg R (chartkey Z P _ _ q F U V hU.fromSpec hV.fromSpec (Spec.map (q.appLE U V hle)) hsq h₀ hTU hV0 hle x)).trans (hresF _ _ _ _)
  exact (congrArg Ψ k1).trans k2

theorem wc_cn_pb_basechange_adic_algebra : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (𝔞 : Ideal A) (M' M N' N : Type u) [AddCommGroup M'] [Module A M'] [AddCommGroup M] [Module A M] [AddCommGroup N'] [Module B N'] [AddCommGroup N] [Module B N] (ψ : M' →ₗ[A] M) (χ : N' →ₗ[B] N) (e' : TensorProduct A B M' ≃ₗ[B] N') (e : TensorProduct A B M ≃ₗ[B] N), (∀ (b : B) (x : M'), χ (e' (b ⊗ₜ[A] x)) = e (b ⊗ₜ[A] ψ x)) → Function.Surjective ψ → (∀ s : M', ψ s = 0 ↔ s ∈ 𝔞 • (⊤ : Submodule A M')) → 𝔞 • (⊤ : Submodule A M) = ⊥ → Module.Finite A M' → Module.Finite A M → Module.Finite B N' ∧ Module.Finite B N ∧ Function.Surjective χ ∧ (∀ s : N', χ s = 0 ↔ s ∈ Ideal.map (algebraMap A B) 𝔞 • (⊤ : Submodule B N')) ∧ Ideal.map (algebraMap A B) 𝔞 • (⊤ : Submodule B N) = ⊥ :=
by
  intro A B _ _ _ 𝔞 M' M N' N _ _ _ _ _ _ _ _ ψ χ e' e hcomp hsurj hker hkill hfin' hfin
  set J : Ideal B := Ideal.map (algebraMap A B) 𝔞 with hJ
  set K : Submodule A M' := 𝔞 • (⊤ : Submodule A M') with hK
  set T : TensorProduct A B M' →ₗ[B] TensorProduct A B M := LinearMap.baseChange B ψ with hT
  set R : Submodule B (TensorProduct A B M') := LinearMap.range (LinearMap.baseChange B K.subtype)
    with hR

  have compat : ∀ z, χ (e' z) = e (T z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul b x => rw [hT, LinearMap.baseChange_tmul]; exact hcomp b x
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]

  have keyI : ∀ (P : Type u) [AddCommGroup P] [Module A P] (a : A) (b : B) (m : P),
      (b ⊗ₜ[A] (a • m) : TensorProduct A B P) = algebraMap A B a • (b ⊗ₜ[A] m) := by
    intro P _ _ a b m
    rw [algebraMap_smul, TensorProduct.tmul_smul]

  have hex : Function.Exact K.subtype ψ := by
    intro s
    rw [hker s]
    constructor
    · intro h; exact ⟨⟨s, h⟩, rfl⟩
    · rintro ⟨k, rfl⟩; exact k.2
  have hT1 := lTensor_exact B hex hsurj
  have kerT : ∀ z, T z = 0 ↔ z ∈ R := by
    intro z
    rw [hR, LinearMap.mem_range, hT, LinearMap.baseChange_eq_ltensor]
    have h := hT1 z
    rw [h]
    simp only [Set.mem_range, LinearMap.baseChange_eq_ltensor]

  have R_le : ∀ w, LinearMap.baseChange B K.subtype w ∈ J • (⊤ : Submodule B (TensorProduct A B M')) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | tmul b k =>
      rw [LinearMap.baseChange_tmul, Submodule.subtype_apply]
      obtain ⟨k, hk⟩ := k
      refine Submodule.smul_induction_on
        (p := fun x => b ⊗ₜ[A] x ∈ J • (⊤ : Submodule B (TensorProduct A B M'))) hk ?_ ?_
      · intro a ha m _
        rw [keyI]
        exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ ha) Submodule.mem_top
      · intro x y hx hy
        rw [TensorProduct.tmul_add]; exact Submodule.add_mem _ hx hy
    | add x y hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  have gen_R : ∀ a ∈ 𝔞, ∀ z, algebraMap A B a • z ∈ R := by
    intro a ha z
    induction z using TensorProduct.induction_on with
    | zero => rw [smul_zero]; exact Submodule.zero_mem _
    | tmul b m =>
      rw [← keyI]
      exact ⟨b ⊗ₜ[A] (⟨a • m, Submodule.smul_mem_smul ha Submodule.mem_top⟩ : K),
        by rw [LinearMap.baseChange_tmul]; rfl⟩
    | add x y hx hy => rw [smul_add]; exact Submodule.add_mem _ hx hy
  have J_R : ∀ r ∈ J, ∀ z, r • z ∈ R := by
    intro r hr
    have hr' : r ∈ Ideal.span (algebraMap A B '' (𝔞 : Set A)) := hr
    clear hr
    induction hr' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact gen_R a ha
    | zero => intro z; rw [zero_smul]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => intro z; rw [add_smul]; exact Submodule.add_mem _ (hx z) (hy z)
    | smul c x _ hx => intro z; rw [smul_eq_mul, mul_smul]; exact Submodule.smul_mem _ c (hx z)
  have range_iff : ∀ z, z ∈ R ↔ z ∈ J • (⊤ : Submodule B (TensorProduct A B M')) := by
    intro z
    constructor
    · rintro ⟨w, rfl⟩; exact R_le w
    · intro hz
      exact Submodule.smul_induction_on (p := fun z => z ∈ R) hz
        (fun r hr z _ => J_R r hr z) (fun x y hx hy => Submodule.add_mem _ hx hy)

  have gen_kill : ∀ a ∈ 𝔞, ∀ z : TensorProduct A B M, algebraMap A B a • z = 0 := by
    intro a ha z
    induction z using TensorProduct.induction_on with
    | zero => rw [smul_zero]
    | tmul b m =>
      rw [← keyI]
      have h := Submodule.smul_mem_smul ha (Submodule.mem_top (x := m))
      rw [hkill] at h
      rw [(Submodule.mem_bot A).mp h, TensorProduct.tmul_zero]
    | add x y hx hy => rw [smul_add, hx, hy, add_zero]
  have J_kill : ∀ r ∈ J, ∀ z : TensorProduct A B M, r • z = 0 := by
    intro r hr
    have hr' : r ∈ Ideal.span (algebraMap A B '' (𝔞 : Set A)) := hr
    clear hr
    induction hr' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact gen_kill a ha
    | zero => intro z; rw [zero_smul]
    | add x y _ _ hx hy => intro z; rw [add_smul, hx z, hy z, add_zero]
    | smul c x _ hx => intro z; rw [smul_eq_mul, mul_smul, hx z, smul_zero]
  have killBM : J • (⊤ : Submodule B (TensorProduct A B M)) = ⊥ :=
    eq_bot_iff.mpr (Submodule.smul_le.mpr fun r hr z _ => (Submodule.mem_bot B).mpr (J_kill r hr z))

  have transport : ∀ {P Q : Type u} [AddCommGroup P] [Module B P] [AddCommGroup Q] [Module B Q]
      (f : P →ₗ[B] Q) (x : P), x ∈ J • (⊤ : Submodule B P) → f x ∈ J • (⊤ : Submodule B Q) := by
    intro P Q _ _ _ _ f x hx
    refine Submodule.smul_induction_on (p := fun x => f x ∈ J • (⊤ : Submodule B Q)) hx ?_ ?_
    · intro r hr n _; rw [map_smul]; exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro x y hx hy; rw [map_add]; exact Submodule.add_mem _ hx hy
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have := Module.Finite.base_change A B M'
    exact Module.Finite.equiv e'
  · have := Module.Finite.base_change A B M
    exact Module.Finite.equiv e
  · intro n
    have hTs : Function.Surjective T := by
      have h := LinearMap.lTensor_surjective B hsurj
      rw [hT, LinearMap.baseChange_eq_ltensor]
      exact h
    obtain ⟨z, hz⟩ := hTs (e.symm n)
    exact ⟨e' z, by rw [compat, hz, LinearEquiv.apply_symm_apply]⟩
  · intro s
    obtain ⟨z, rfl⟩ := e'.surjective s
    rw [compat, LinearEquiv.map_eq_zero_iff, kerT, range_iff]
    constructor
    · intro h; exact transport (e' : TensorProduct A B M' →ₗ[B] N') z h
    · intro h
      have h2 := transport (e'.symm : N' →ₗ[B] TensorProduct A B M') (e' z) h
      rwa [LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply] at h2
  · refine eq_bot_iff.mpr fun n hn => ?_
    have h1 := transport (e.symm : N →ₗ[B] TensorProduct A B M) n hn
    rw [killBM] at h1
    have h2 : e.symm n = 0 := (Submodule.mem_bot B).mp h1
    rw [Submodule.mem_bot, ← e.apply_symm_apply n, h2, map_zero]

theorem wc_cn_pb_local_qcoh_of_tensor : ∀ (Z P : Scheme.{u}) (q : P ⟶ Z) (F : Z.Modules) (U : Z.Opens) (V : P.Opens), IsAffineOpen V → ∀ (hle : V ≤ q ⁻¹ᵁ U) (f : Γ(P, V)), (letI := (q.appLE U V hle).hom.toAlgebra; ∃ e : TensorProduct Γ(Z, U) Γ(P, V) Γ(F, U) ≃ₗ[Γ(P, V)] Γ((Scheme.Modules.pullback q).obj F, V), ∀ (a : Γ(P, V)) (x : Γ(F, U)), e (a ⊗ₜ[Γ(Z, U)] x) = a • (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction q).unit.app F) U x)) → (letI := (q.appLE U (P.basicOpen f) ((P.basicOpen_le f).trans hle)).hom.toAlgebra; ∃ e₁ : TensorProduct Γ(Z, U) Γ(P, P.basicOpen f) Γ(F, U) ≃ₗ[Γ(P, P.basicOpen f)] Γ((Scheme.Modules.pullback q).obj F, P.basicOpen f), ∀ (a : Γ(P, P.basicOpen f)) (x : Γ(F, U)), e₁ (a ⊗ₜ[Γ(Z, U)] x) = a • (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE ((P.basicOpen_le f).trans hle)).op).hom (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction q).unit.app F) U x)) → (∀ s : Γ((Scheme.Modules.pullback q).obj F, P.basicOpen f), ∃ (n : ℕ) (t : Γ((Scheme.Modules.pullback q).obj F, V)), ((P.presheaf.map (homOfLE (P.basicOpen_le f)).op).hom f) ^ n • s = (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE (P.basicOpen_le f)).op).hom t) ∧ (∀ t : Γ((Scheme.Modules.pullback q).obj F, V), (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE (P.basicOpen_le f)).op).hom t = 0 → ∃ n : ℕ, f ^ n • t = 0) :=
by
  have halg : ∀ (A B B₁ M N N₁ : Type u) [CommRing A] [CommRing B] [CommRing B₁] [Algebra A B] [Algebra A B₁] [Algebra B B₁] [IsScalarTower A B B₁] (f : B) [IsLocalization.Away f B₁] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module B N] [AddCommGroup N₁] [Module B₁ N₁] (e : TensorProduct A B M ≃ₗ[B] N) (e₁ : TensorProduct A B₁ M ≃ₗ[B₁] N₁) (r : N →+ N₁), (∀ (b : B) (x : M), r (e (b ⊗ₜ[A] x)) = e₁ (algebraMap B B₁ b ⊗ₜ[A] x)) → (∀ s : N₁, ∃ (n : ℕ) (t : N), (algebraMap B B₁ f) ^ n • s = r t) ∧ (∀ t : N, r t = 0 → ∃ n : ℕ, f ^ n • t = 0) := by
    intro A B B₁ M N N₁ _ _ _ _ _ _ _ f _ _ _ _ _ _ _ e e₁ r hr
    have hρ : IsLocalizedModule (Submonoid.powers f) (Algebra.linearMap B B₁) :=
      (isLocalizedModule_iff_isLocalization' (Submonoid.powers f) B₁).mpr inferInstance
    have hT := IsLocalizedModule.rTensor (R := A) B (N := M) (Submonoid.powers f)
      (Algebra.linearMap B B₁)
    set T := TensorProduct.AlgebraTensorModule.rTensor A M (Algebra.linearMap B B₁) with hTdef
    have key : ∀ z, r (e z) = e₁ (T z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b x =>
        rw [hr]
        rfl
      | add z₁ z₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]
    constructor
    · intro s
      obtain ⟨⟨z, c⟩, hc⟩ := IsLocalizedModule.surj (Submonoid.powers f) T (e₁.symm s)
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp c.2
      refine ⟨n, e z, ?_⟩
      rw [key]
      simp only at hc
      rw [← hc, Submonoid.smul_def, ← hn, ← algebraMap_smul B₁ (f ^ n) (e₁.symm s),
        LinearEquiv.map_smul, LinearEquiv.apply_symm_apply, map_pow]
    · intro t ht
      have h0 : T (e.symm t) = 0 := by
        rw [← e₁.map_eq_zero_iff, ← key, LinearEquiv.apply_symm_apply, ht]
      obtain ⟨c, hc⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers f) T).mp h0
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp c.2
      refine ⟨n, ?_⟩
      rw [Submonoid.smul_def, ← hn] at hc
      rw [← e.apply_symm_apply t, ← LinearEquiv.map_smul, hc, map_zero]
  intro Z P q F U V hV hle f hE hE₁
  letI iAB : Algebra Γ(Z, U) Γ(P, V) := (q.appLE U V hle).hom.toAlgebra
  letI iAB₁ : Algebra Γ(Z, U) Γ(P, P.basicOpen f) :=
    (q.appLE U (P.basicOpen f) ((P.basicOpen_le f).trans hle)).hom.toAlgebra
  haveI : IsScalarTower Γ(Z, U) Γ(P, V) Γ(P, P.basicOpen f) := by
    apply IsScalarTower.of_algebraMap_eq'
    have h := congrArg CommRingCat.Hom.hom
      (Scheme.Hom.appLE_map q hle (homOfLE (P.basicOpen_le f)).op)
    rw [CommRingCat.hom_comp] at h
    exact h.symm
  haveI : IsLocalization.Away f Γ(P, P.basicOpen f) := hV.isLocalization_basicOpen f
  obtain ⟨e, he⟩ := hE
  obtain ⟨e₁, he₁⟩ := hE₁
  have hres : ∀ y : Γ((Scheme.Modules.pullback q).obj F, q ⁻¹ᵁ U),
      (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE (P.basicOpen_le f)).op).hom
        ((((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hle).op).hom y) =
      (((Scheme.Modules.pullback q).obj F).presheaf.map
        (homOfLE ((P.basicOpen_le f).trans hle)).op).hom y := by
    intro y
    exact (congrArg (fun φ => φ.hom y) (((Scheme.Modules.pullback q).obj F).presheaf.map_comp
      (homOfLE hle).op (homOfLE (P.basicOpen_le f)).op)).symm
  have hcompat : ∀ (b : Γ(P, V)) (x : Γ(F, U)),
      (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE (P.basicOpen_le f)).op).hom
        (e (b ⊗ₜ[Γ(Z, U)] x)) =
      e₁ (algebraMap Γ(P, V) Γ(P, P.basicOpen f) b ⊗ₜ[Γ(Z, U)] x) := by
    intro b x
    rw [he, he₁, Scheme.Modules.map_smul]
    congr 1
    exact hres _
  exact halg Γ(Z, U) Γ(P, V) Γ(P, P.basicOpen f) Γ(F, U) _ _ f e e₁ _ hcompat

theorem wc_cn_pb_qcoh_of_good_basis : ∀ (X : Scheme.{u}) (M : X.Modules) (𝓑 : X.Opens → Prop), (∀ V V' : X.Opens, 𝓑 V → V' ≤ V → IsAffineOpen V' → 𝓑 V') → (∀ W : X.Opens, IsAffineOpen W → ∃ (k : ℕ) (g : Fin k → Γ(X, W)), Ideal.span (Set.range g) = ⊤ ∧ ∀ i, 𝓑 (X.basicOpen (g i))) → (∀ V : X.Opens, 𝓑 V → ∀ f : Γ(X, V), (∀ s : Γ(M, X.basicOpen f), ∃ (n : ℕ) (t : Γ(M, V)), ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n • s = (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t) ∧ (∀ t : Γ(M, V), (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t = 0 → ∃ n : ℕ, f ^ n • t = 0)) → wcQcoh M :=
by
  intro X M 𝓑 H1 H2 H3
  classical
  have resG : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have resX : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have smulres : ∀ (A B : X.Opens) (h1 : B ≤ A) (a : Γ(X, A)) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h1).op).hom (a • x) =
      (X.presheaf.map (homOfLE h1).op).hom a • (M.presheaf.map (homOfLE h1).op).hom x :=
    fun A B h1 a x => Scheme.Modules.map_smul M (homOfLE h1) a x

  have cover : ∀ U : X.Opens, IsAffineOpen U → ∃ (p : ℕ) (g : Fin p → Γ(X, U)),
      (∀ x ∈ U, ∃ a, x ∈ X.basicOpen (g a)) ∧
      ∀ (V : X.Opens), IsAffineOpen V → (∃ a, V ≤ X.basicOpen (g a)) → 𝓑 V := by
    intro U hU
    obtain ⟨k, g, hg, hgood⟩ := H2 U hU
    refine ⟨k, g, ?_, ?_⟩
    · intro x hx
      have e := hU.iSup_basicOpen_eq_self_iff.mpr hg
      rw [← e] at hx
      obtain ⟨⟨f, hf⟩, hxf⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      obtain ⟨i, rfl⟩ := hf
      exact ⟨i, hxf⟩
    · rintro V hV ⟨a, hVa⟩
      exact H1 _ V (hgood a) hVa hV

  have kill : ∀ (U : X.Opens), IsAffineOpen U → ∀ (f : Γ(X, U)) (t : Γ(M, U)), (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t = 0 → ∃ n : ℕ, f ^ n • t = 0 := by
    intro U hU f t ht
    obtain ⟨p, gg, hcov, hloc'⟩ := cover U hU
    let W : Fin p → X.Opens := fun a => X.basicOpen (gg a)
    have hWle : ∀ a, W a ≤ U := fun a => X.basicOpen_le (gg a)
    have hWaff : ∀ a, IsAffineOpen (W a) := fun a => hU.basicOpen (gg a)
    have key : ∀ i, ∃ n : ℕ, ((X.presheaf.map (homOfLE (hWle i)).op).hom f) ^ n •
        (M.presheaf.map (homOfLE (hWle i)).op).hom t = 0 := by
      intro i
      refine (H3 (W i) (hloc' (W i) (hWaff i) ⟨i, le_rfl⟩)
        ((X.presheaf.map (homOfLE (hWle i)).op).hom f)).2 _ ?_
      have hle : X.basicOpen ((X.presheaf.map (homOfLE (hWle i)).op).hom f) ≤ X.basicOpen f := by
        rw [Scheme.basicOpen_res]; exact inf_le_right
      rw [resG _ _ _ _ _ ((X.basicOpen_le _).trans (hWle i)),
        ← resG _ _ _ (X.basicOpen_le f) hle, ht, map_zero]
    choose n hn using key
    refine ⟨∑ i, n i, ?_⟩
    have hcov' : U ≤ iSup W := fun x hx => TopologicalSpace.Opens.mem_iSup.mpr (hcov x hx)
    refine TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) W U
      (fun i => homOfLE (hWle i)) hcov' _ _ (fun i => ?_)
    change (M.presheaf.map (homOfLE (hWle i)).op).hom (f ^ (∑ i, n i) • t) =
      (M.presheaf.map (homOfLE (hWle i)).op).hom 0
    rw [map_zero, Scheme.Modules.map_smul, map_pow]
    have hle : n i ≤ ∑ j, n j :=
      Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hn i, smul_zero]

  have lift : ∀ (U : X.Opens), IsAffineOpen U → ∀ (g : Γ(X, U)) (s : Γ(M, X.basicOpen g)), ∃ (n : ℕ) (t : Γ(M, U)), ((X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom g) ^ n • s = (M.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom t := by
    intro X₀ hX₀ g s
    obtain ⟨r, gg, hcov, hloc'⟩ := cover X₀ hX₀
    let W : Fin r → X.Opens := fun a => X.basicOpen (gg a)
    have hWle : ∀ a, W a ≤ X₀ := fun a => X.basicOpen_le (gg a)
    have hWaff : ∀ a, IsAffineOpen (W a) := fun a => hX₀.basicOpen (gg a)
    have hpair : ∀ i j, IsAffineOpen (W i ⊓ W j) := by
      intro i j
      have h := hX₀.basicOpen (gg i * gg j)
      rw [Scheme.basicOpen_mul] at h
      exact h
    have hDX₀ : X.basicOpen g ≤ X₀ := X.basicOpen_le g
    let gi : ∀ i, Γ(X, W i) := fun i => (X.presheaf.map (homOfLE (hWle i)).op).hom g
    have hE : ∀ i, X.basicOpen (gi i) = W i ⊓ X.basicOpen g := fun i => Scheme.basicOpen_res X g _
    have hEW : ∀ i, X.basicOpen (gi i) ≤ W i := fun i => X.basicOpen_le _
    have hED : ∀ i, X.basicOpen (gi i) ≤ X.basicOpen g := fun i => by rw [hE i]; exact inf_le_right
    have hEX : ∀ i, X.basicOpen (gi i) ≤ X₀ := fun i => (hEW i).trans (hWle i)
    have hgE : ∀ i, (X.presheaf.map (homOfLE (hEW i)).op).hom (gi i) =
        (X.presheaf.map (homOfLE (hEX i)).op).hom g := fun i => resX _ _ _ (hWle i) (hEW i) (hEX i) g
    have hgE' : ∀ i, (X.presheaf.map (homOfLE (hED i)).op).hom
        ((X.presheaf.map (homOfLE hDX₀).op).hom g) = (X.presheaf.map (homOfLE (hEX i)).op).hom g :=
      fun i => resX _ _ _ hDX₀ (hED i) (hEX i) g

    have hA : ∀ i, ∃ (n : ℕ) (t : Γ(M, W i)),
        ((X.presheaf.map (homOfLE (hEX i)).op).hom g) ^ n •
          (M.presheaf.map (homOfLE (hED i)).op).hom s =
        (M.presheaf.map (homOfLE (hEW i)).op).hom t := by
      intro i
      obtain ⟨n, t, ht⟩ :=
        (H3 (W i) (hloc' (W i) (hWaff i) ⟨i, le_rfl⟩) (gi i)).1
          ((M.presheaf.map (homOfLE (hED i)).op).hom s)
      exact ⟨n, t, by rw [← hgE i]; exact ht⟩
    choose n t ht using hA

    let N₁ := ∑ i, n i
    let t' : ∀ i, Γ(M, W i) := fun i => (gi i) ^ (N₁ - n i) • t i
    have hB : ∀ i, ((X.presheaf.map (homOfLE (hEX i)).op).hom g) ^ N₁ •
          (M.presheaf.map (homOfLE (hED i)).op).hom s =
        (M.presheaf.map (homOfLE (hEW i)).op).hom (t' i) := by
      intro i
      have hle : n i ≤ N₁ :=
        Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      show _ = (M.presheaf.map (homOfLE (hEW i)).op).hom ((gi i) ^ (N₁ - n i) • t i)
      rw [smulres, map_pow, hgE i, ← ht i, ← mul_smul, ← pow_add, Nat.sub_add_cancel hle]

    have hC : ∀ i j, ∃ m : ℕ,
        ((X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g) ^ m •
        ((M.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (t' i) -
         (M.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (t' j)) = 0 := by
      intro i j
      let gij := (X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g
      refine (H3 (W i ⊓ W j) (hloc' (W i ⊓ W j) (hpair i j) ⟨i, inf_le_left⟩) gij).2 _ ?_
      have hF : X.basicOpen gij = (W i ⊓ W j) ⊓ X.basicOpen g := Scheme.basicOpen_res X g _
      have hFi : X.basicOpen gij ≤ X.basicOpen (gi i) := by
        rw [hF, hE i]; exact inf_le_inf_right _ inf_le_left
      have hFj : X.basicOpen gij ≤ X.basicOpen (gi j) := by
        rw [hF, hE j]; exact inf_le_inf_right _ inf_le_right
      have hFD : X.basicOpen gij ≤ X.basicOpen g := by rw [hF]; exact inf_le_right
      have hFX : X.basicOpen gij ≤ X₀ := hFD.trans hDX₀
      have key : ∀ k, X.basicOpen gij ≤ X.basicOpen (gi k) → ∀ hkk : W i ⊓ W j ≤ W k,
          (M.presheaf.map (homOfLE (X.basicOpen_le gij)).op).hom
            ((M.presheaf.map (homOfLE hkk).op).hom (t' k)) =
          ((X.presheaf.map (homOfLE hFX).op).hom g) ^ N₁ •
            (M.presheaf.map (homOfLE hFD).op).hom s := by
        intro k hk hkk
        have hk' : X.basicOpen gij ≤ W k := hk.trans (hEW k)
        rw [resG _ _ _ _ _ hk', ← resG _ _ _ (hEW k) hk hk', ← hB k, smulres, map_pow,
          resX _ _ _ _ _ hFX, resG _ _ _ _ _ hFD]
      rw [map_sub, key i hFi inf_le_left, key j hFj inf_le_right, sub_self]
    choose m hm using hC

    let Mx := ∑ q : Fin r × Fin r, m q.1 q.2
    let u : ∀ i, Γ(M, W i) := fun i => (gi i) ^ Mx • t' i
    have hcompat : TopCat.Presheaf.IsCompatible
        (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X).obj W u := by
      intro i j
      have hle : m i j ≤ Mx := Finset.single_le_sum (f := fun q : Fin r × Fin r => m q.1 q.2)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ (i, j))
      have e1 : ∀ k (hk : W i ⊓ W j ≤ W k), (M.presheaf.map (homOfLE hk).op).hom (u k) =
          ((X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g) ^ Mx •
          (M.presheaf.map (homOfLE hk).op).hom (t' k) := by
        intro k hk
        show (M.presheaf.map (homOfLE hk).op).hom ((gi k) ^ Mx • t' k) = _
        rw [smulres, map_pow, resX _ _ _ (hWle k) hk (inf_le_left.trans (hWle i))]
      change (M.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (u i) =
        (M.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (u j)
      rw [e1 i inf_le_left, e1 j inf_le_right, ← sub_eq_zero, ← smul_sub,
        ← Nat.sub_add_cancel hle, pow_add, mul_smul, hm i j, smul_zero]
    have hcov' : X₀ ≤ iSup W := fun x hx => TopologicalSpace.Opens.mem_iSup.mpr (hcov x hx)
    obtain ⟨T, hT, -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) W X₀ (fun i => homOfLE (hWle i)) hcov' u hcompat
    refine ⟨N₁ + Mx, T, ?_⟩

    have hcovD : X.basicOpen g ≤ iSup (fun i => X.basicOpen (gi i)) := by
      intro x hx
      obtain ⟨i, hi⟩ := hcov x (hDX₀ hx)
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨i, ?_⟩
      rw [hE i]
      exact ⟨hi, hx⟩
    refine TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X)
      (fun i => X.basicOpen (gi i)) (X.basicOpen g) (fun i => homOfLE (hED i)) hcovD _ _
      (fun i => ?_)
    have hTi : (M.presheaf.map (homOfLE (hWle i)).op).hom T = (gi i) ^ Mx • t' i := hT i
    change (M.presheaf.map (homOfLE (hED i)).op).hom
        (((X.presheaf.map (homOfLE hDX₀).op).hom g) ^ (N₁ + Mx) • s) =
      (M.presheaf.map (homOfLE (hED i)).op).hom ((M.presheaf.map (homOfLE hDX₀).op).hom T)
    rw [smulres, map_pow, hgE' i, add_comm N₁ Mx, pow_add, mul_smul, hB i,
      resG _ _ _ _ _ (hEX i), ← resG _ _ _ (hWle i) (hEW i) (hEX i), hTi,
      smulres (W i) _ (hEW i) ((gi i) ^ Mx) (t' i), map_pow, hgE i]

  intro U hU f
  exact ⟨lift U hU f, kill U hU f⟩

theorem wc_cn_pb_finite_of_basic_cover : ∀ (X : Scheme.{u}) (M : X.Modules), wcQcoh M → ∀ (W : X.Opens), IsAffineOpen W → ∀ (k : ℕ) (g : Fin k → Γ(X, W)), Ideal.span (Set.range g) = ⊤ → (∀ i, Module.Finite Γ(X, X.basicOpen (g i)) Γ(M, X.basicOpen (g i))) → Module.Finite Γ(X, W) Γ(M, W) :=
by
  intro X M hM W hW k g hg hfin

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (f : R)
      [IsLocalization.Away f S] (Mr Ms : Type u) [AddCommGroup Mr] [Module R Mr]
      [AddCommGroup Ms] [Module S Ms] (ρ : Mr →+ Ms),
      (∀ (r : R) (x : Mr), ρ (r • x) = algebraMap R S r • ρ x) →
      ∀ (N0 : Submodule R Mr) (T : Set Ms), Submodule.span S T = ⊤ →
      (∀ y ∈ T, ∃ (m : ℕ) (t : Mr), t ∈ N0 ∧ algebraMap R S f ^ m • y = ρ t) →
      ∀ z : Ms, ∃ (m : ℕ) (t : Mr), t ∈ N0 ∧ algebraMap R S f ^ m • z = ρ t := by
    intro R S _ _ _ f _ Mr Ms _ _ _ _ ρ hρ N0 T hT hgen z
    have hz : z ∈ Submodule.span S T := by rw [hT]; trivial
    induction hz using Submodule.span_induction with
    | mem y hy => exact hgen y hy
    | zero => exact ⟨0, 0, N0.zero_mem, by rw [smul_zero, map_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨m₁, t₁, ht₁, e₁⟩ := hx
      obtain ⟨m₂, t₂, ht₂, e₂⟩ := hy
      refine ⟨m₁ + m₂, f ^ m₂ • t₁ + f ^ m₁ • t₂,
        N0.add_mem (N0.smul_mem _ ht₁) (N0.smul_mem _ ht₂), ?_⟩
      rw [map_add, hρ, hρ, ← e₁, ← e₂, map_pow, map_pow, smul_smul, smul_smul, ← pow_add,
        ← pow_add, add_comm m₂ m₁, smul_add]
    | smul a x _ hx =>
      obtain ⟨m, t, ht, e⟩ := hx
      obtain ⟨j, b, hb⟩ := IsLocalization.Away.surj f a
      refine ⟨j + m, b • t, N0.smul_mem _ ht, ?_⟩
      rw [hρ, ← e, ← hb, smul_smul, smul_smul]
      congr 1
      rw [pow_add]
      ring

  have hgen : ∀ i, ∃ (n : ℕ) (y : Fin n → Γ(M, X.basicOpen (g i))),
      Submodule.span Γ(X, X.basicOpen (g i)) (Set.range y) = ⊤ := fun i => by
    have := hfin i
    exact Module.Finite.exists_fin
  choose n y hy using hgen
  have hlift : ∀ i l, ∃ (N : ℕ) (t : Γ(M, W)),
      ((X.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom (g i)) ^ N • y i l =
        (M.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom t :=
    fun i l => (hM W hW (g i)).1 (y i l)
  choose N y' hy' using hlift

  let N0 : Submodule Γ(X, W) Γ(M, W) :=
    Submodule.span Γ(X, W) (Set.range (fun p : (Σ i : Fin k, Fin (n i)) => y' p.1 p.2))
  have hN0 : ∀ i l, y' i l ∈ N0 := fun i l => Submodule.subset_span ⟨⟨i, l⟩, rfl⟩

  have hpow : ∀ (s : Γ(M, W)) (i : Fin k), ∃ e : ℕ, (g i) ^ e • s ∈ N0 := by
    intro s i
    have := hW.isLocalization_basicOpen (g i)
    obtain ⟨m, t, ht, e⟩ := s2 Γ(X, W) Γ(X, X.basicOpen (g i)) (g i) Γ(M, W)
      Γ(M, X.basicOpen (g i)) (M.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom
      (fun r x => Scheme.Modules.map_smul M (homOfLE (X.basicOpen_le (g i))) r x)
      N0 (Set.range (y i)) (hy i)
      (by rintro _ ⟨l, rfl⟩; exact ⟨N i l, y' i l, hN0 i l, hy' i l⟩)
      ((M.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom s)
    have h0 : (M.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom ((g i) ^ m • s - t) = 0 := by
      rw [map_sub, Scheme.Modules.map_smul, map_pow]
      exact sub_eq_zero.mpr e
    obtain ⟨n', hn'⟩ := (hM W hW (g i)).2 _ h0
    refine ⟨n' + m, ?_⟩
    have h1 : (g i) ^ (n' + m) • s = (g i) ^ n' • t := by
      rw [smul_sub, sub_eq_zero, smul_smul, ← pow_add] at hn'
      exact hn'
    rw [h1]
    exact N0.smul_mem _ ht

  have hall : ∀ s, s ∈ N0 := fun s =>
    Submodule.mem_of_span_eq_top_of_smul_pow_mem N0 (Set.range g) hg s (by
      rintro ⟨_, i, rfl⟩
      exact hpow s i)
  have htop : N0 = ⊤ := Submodule.eq_top_iff'.mpr hall
  constructor
  rw [← htop]
  exact Submodule.fg_span (Set.finite_range _)

theorem wc_cn_pb_surj_of_basic_cover : ∀ (X : Scheme.{u}) (M' M : X.Modules) (φ : M' ⟶ M), wcQcoh M' → wcQcoh M → ∀ (W : X.Opens), IsAffineOpen W → ∀ (k : ℕ) (g : Fin k → Γ(X, W)), Ideal.span (Set.range g) = ⊤ → (∀ i, Function.Surjective (Scheme.Modules.Hom.app φ (X.basicOpen (g i)))) → Function.Surjective (Scheme.Modules.Hom.app φ W) :=
by
  intro X M' M φ hM' hM W hW k g hg hsurj t
  have natr : ∀ {A' B' : X.Modules} (g : A' ⟶ B') {W W' : X.Opens}
      (hWW : W' ≤ W) (x : Γ(A', W)),
      Scheme.Modules.Hom.app g W' ((A'.presheaf.map (homOfLE hWW).op).hom x) =
        (B'.presheaf.map (homOfLE hWW).op).hom (Scheme.Modules.Hom.app g W x) := by
    intro A' B' g W W' hWW x
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g) (homOfLE hWW).op x
  let φL : Γ(M', W) →ₗ[Γ(X, W)] Γ(M, W) :=
    { toFun := Scheme.Modules.Hom.app φ W
      map_add' := map_add _
      map_smul' := fun r x => Scheme.Modules.Hom.app_smul φ r x }
  have key : t ∈ LinearMap.range φL := by
    refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (Set.range g) hg t ?_
    rintro ⟨_, i, rfl⟩
    obtain ⟨s, hs⟩ := hsurj i ((M.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom t)
    obtain ⟨N, s', hs'⟩ := (hM' W hW (g i)).1 s
    have hd : (M.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom
        (Scheme.Modules.Hom.app φ W s' - g i ^ N • t) = 0 := by
      rw [map_sub, ← natr, ← hs', Scheme.Modules.map_smul, Scheme.Modules.Hom.app_smul, hs,
        map_pow, sub_self]
    obtain ⟨m, hm⟩ := (hM W hW (g i)).2 _ hd
    refine ⟨m + N, ⟨g i ^ m • s', ?_⟩⟩
    rw [smul_sub, sub_eq_zero] at hm
    show Scheme.Modules.Hom.app φ W (g i ^ m • s') = g i ^ (m + N) • t
    rw [Scheme.Modules.Hom.app_smul, hm, ← mul_smul, ← pow_add]
  obtain ⟨s, hs⟩ := LinearMap.mem_range.mp key
  exact ⟨s, hs⟩

theorem wc_cn_pb_smul_mem_of_basic_cover : ∀ (X : Scheme.{u}) (M : X.Modules), wcQcoh M → ∀ (W : X.Opens), IsAffineOpen W → ∀ (k : ℕ) (g : Fin k → Γ(X, W)), Ideal.span (Set.range g) = ⊤ → ∀ (𝔞 : Ideal Γ(X, W)) (s : Γ(M, W)), (∀ i, (M.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom s ∈ Ideal.map (X.presheaf.map (homOfLE (X.basicOpen_le (g i))).op).hom 𝔞 • (⊤ : Submodule Γ(X, X.basicOpen (g i)) Γ(M, X.basicOpen (g i)))) → s ∈ 𝔞 • (⊤ : Submodule Γ(X, W) Γ(M, W)) :=
by
  intro X M hM W hW k g hg 𝔞 s hs
  refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (Set.range g) hg s ?_
  rintro ⟨_, i, rfl⟩
  set f := g i with hf
  set ρ := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom with hρ
  set ρM := (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom with hρM
  have hmapsmul : ∀ (r : Γ(X, W)) (x : Γ(M, W)), ρM (r • x) = ρ r • ρM x := fun r x =>
    Scheme.Modules.map_smul M (homOfLE (X.basicOpen_le f)) r x
  obtain ⟨qa, qb⟩ := hM W hW f
  let P : Γ(M, X.basicOpen f) → Prop := fun y =>
    ∃ (n : ℕ) (y' : Γ(M, W)), y' ∈ 𝔞 • (⊤ : Submodule Γ(X, W) Γ(M, W)) ∧ ρ f ^ n • y = ρM y'
  have P0 : P 0 := ⟨0, 0, Submodule.zero_mem _, by rw [smul_zero, map_zero]⟩
  have Padd : ∀ x y, P x → P y → P (x + y) := by
    rintro x y ⟨n, x', hx', hx⟩ ⟨m, y', hy', hy⟩
    refine ⟨n + m, f ^ m • x' + f ^ n • y', Submodule.add_mem _ (Submodule.smul_mem _ _ hx')
      (Submodule.smul_mem _ _ hy'), ?_⟩
    rw [map_add, hmapsmul, hmapsmul, map_pow, map_pow, ← hx, ← hy, smul_add, smul_smul,
      smul_smul, ← pow_add, ← pow_add, add_comm m n]
  have Pgen : ∀ r ∈ Ideal.map ρ 𝔞, ∀ m, P (r • m) := by
    intro r hr
    induction hr using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      intro m
      obtain ⟨N, t, ht⟩ := qa m
      refine ⟨N, a • t, Submodule.smul_mem_smul ha Submodule.mem_top, ?_⟩
      rw [hmapsmul, ← ht, smul_comm]
    | zero => intro m; rw [zero_smul]; exact P0
    | add x y _ _ hx hy => intro m; rw [add_smul]; exact Padd _ _ (hx m) (hy m)
    | smul c x _ hx =>
      intro m
      rw [smul_eq_mul, mul_comm, mul_smul]
      exact hx (c • m)
  have hP : P (ρM s) :=
    Submodule.smul_induction_on (p := P) (hs i) (fun r hr m _ => Pgen r hr m) Padd
  obtain ⟨n, y', hy', hy⟩ := hP
  have hz : ρM (f ^ n • s - y') = 0 := by
    rw [map_sub, hmapsmul, map_pow, hy, sub_self]
  obtain ⟨m, hm⟩ := qb _ hz
  refine ⟨m + n, ?_⟩
  rw [smul_sub, sub_eq_zero, smul_smul, ← pow_add] at hm
  rw [hm]
  exact Submodule.smul_mem _ _ hy'

theorem wc_cn_pullback_adic_system : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z P : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) (q : P ⟶ Z) (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h I Fs ψ →
    wcCnAdicSys (q ≫ h) I (fun n => (Scheme.Modules.pullback q).obj (Fs n))
      (fun n => (Scheme.Modules.pullback q).map (ψ n)) :=
by
  intro B _ I Z P h q Fs ψ hF
  have capp : ∀ {X : Scheme.{u}} {A' B' C' : X.Modules} (g : A' ⟶ B') (k : B' ⟶ C')
      (W : X.Opens) (x : Γ(A', W)),
      Scheme.Modules.Hom.app (g ≫ k) W x =
        Scheme.Modules.Hom.app k W (Scheme.Modules.Hom.app g W x) := by
    intro X A' B' C' g k W x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have natr : ∀ {X : Scheme.{u}} {A' B' : X.Modules} (g : A' ⟶ B') {W W' : X.Opens}
      (hWW : W' ≤ W) (x : Γ(A', W)),
      Scheme.Modules.Hom.app g W' ((A'.presheaf.map (homOfLE hWW).op).hom x) =
        (B'.presheaf.map (homOfLE hWW).op).hom (Scheme.Modules.Hom.app g W x) := by
    intro X A' B' g W W' hWW x
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g) (homOfLE hWW).op x

  have sigres : ∀ {X : Scheme.{u}} (k : X ⟶ Spec (.of B)) {W W' : X.Opens} (hWW : W' ≤ W),
      wcCnSigma k W' = (X.presheaf.map (homOfLE hWW).op).hom.comp (wcCnSigma k W) := by
    intro X k W W' hWW
    apply RingHom.ext
    intro b
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← RingHom.comp_apply (X.presheaf.map (homOfLE hWW).op).hom, ← CommRingCat.hom_comp,
      ← Functor.map_comp]
    rfl
  have sigq : ∀ (U : Z.Opens) (V : P.Opens) (hle : V ≤ q ⁻¹ᵁ U),
      (q.appLE U V hle).hom.comp (wcCnSigma h U) = wcCnSigma (q ≫ h) V := by
    intro U V hle
    have key : Z.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ q.appLE U V hle =
        q.appTop ≫ P.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op := by
      rw [Scheme.Hom.map_appLE]
      rfl
    have key2 := congrArg (fun φ : Γ(Z, ⊤) ⟶ Γ(P, V) => φ.hom) key
    simp only [CommRingCat.hom_comp] at key2
    apply RingHom.ext
    intro b
    have key3 := congrArg (fun φ : Γ(Z, ⊤) →+* Γ(P, V) =>
      φ (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b))) key2
    simp only [RingHom.comp_apply] at key3
    simp only [wcCnSigma, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact key3

  have hun : ∀ (n : ℕ) (U : Z.Opens) (x : Γ(Fs (n + 1), U)),
      Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) (q ⁻¹ᵁ U)
        (Scheme.Modules.Hom.app
          ((Scheme.Modules.pullbackPushforwardAdjunction q).unit.app (Fs (n + 1))) U x) =
      Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction q).unit.app (Fs n)) U
        (Scheme.Modules.Hom.app (ψ n) U x) := by
    intro n U x
    have h1 := (Scheme.Modules.pullbackPushforwardAdjunction q).unit_naturality (ψ n)
    have h2 := congrArg (fun φ => Scheme.Modules.Hom.app φ U x) h1
    simp only [capp] at h2
    exact h2
  have hqcF : ∀ n, wcQcoh (Fs n) := fun n => (hF.1 n).1

  have hloc : ∀ (n : ℕ) (U : Z.Opens) (V : P.Opens), IsAffineOpen U → IsAffineOpen V →
      V ≤ q ⁻¹ᵁ U →
      Module.Finite Γ(P, V) Γ((Scheme.Modules.pullback q).obj (Fs n), V) ∧
      Function.Surjective (Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) V) ∧
      (∀ s : Γ((Scheme.Modules.pullback q).obj (Fs (n + 1)), V),
        Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) V s = 0 ↔
        s ∈ Ideal.map (wcCnSigma (q ≫ h) V) (I ^ (n + 1)) •
          (⊤ : Submodule Γ(P, V) Γ((Scheme.Modules.pullback q).obj (Fs (n + 1)), V))) ∧
      Ideal.map (wcCnSigma (q ≫ h) V) (I ^ (n + 1)) •
        (⊤ : Submodule Γ(P, V) Γ((Scheme.Modules.pullback q).obj (Fs n), V)) = ⊥ := by
    intro n U V hU hV hle
    letI : Algebra Γ(Z, U) Γ(P, V) := (q.appLE U V hle).hom.toAlgebra
    obtain ⟨e', he'⟩ :=
      wc_cn_pb_affine_tensor_sections Z P q (Fs (n + 1)) (hqcF (n + 1)) U V hU hV hle
    obtain ⟨e, he⟩ := wc_cn_pb_affine_tensor_sections Z P q (Fs n) (hqcF n) U V hU hV hle
    let ψL : Γ(Fs (n + 1), U) →ₗ[Γ(Z, U)] Γ(Fs n, U) :=
      { toFun := Scheme.Modules.Hom.app (ψ n) U
        map_add' := map_add _
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul (ψ n) r x }
    let χL : Γ((Scheme.Modules.pullback q).obj (Fs (n + 1)), V) →ₗ[Γ(P, V)]
        Γ((Scheme.Modules.pullback q).obj (Fs n), V) :=
      { toFun := Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) V
        map_add' := map_add _
        map_smul' := fun r x =>
          Scheme.Modules.Hom.app_smul ((Scheme.Modules.pullback q).map (ψ n)) r x }
    have hcompat : ∀ (b : Γ(P, V)) (x : Γ(Fs (n + 1), U)),
        χL (e' (b ⊗ₜ[Γ(Z, U)] x)) = e (b ⊗ₜ[Γ(Z, U)] ψL x) := by
      intro b x
      rw [he', he]
      show Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) V (b • _) = _
      rw [Scheme.Modules.Hom.app_smul]
      refine congrArg (b • ·) ?_
      exact (natr ((Scheme.Modules.pullback q).map (ψ n)) hle _).trans
        (congrArg (((Scheme.Modules.pullback q).obj (Fs n)).presheaf.map (homOfLE hle).op).hom
          (hun n U x))
    obtain ⟨-, hfin, hsurj, hker, hkill⟩ := wc_cn_pb_basechange_adic_algebra Γ(Z, U) Γ(P, V)
      (Ideal.map (wcCnSigma h U) (I ^ (n + 1))) Γ(Fs (n + 1), U) Γ(Fs n, U)
      Γ((Scheme.Modules.pullback q).obj (Fs (n + 1)), V)
      Γ((Scheme.Modules.pullback q).obj (Fs n), V) ψL χL e' e hcompat
      (hF.2.1 n U hU).1 (hF.2.1 n U hU).2 (hF.2.2 n U hU) ((hF.1 (n + 1)).2 U hU)
      ((hF.1 n).2 U hU)
    have hid : Ideal.map (algebraMap Γ(Z, U) Γ(P, V)) (Ideal.map (wcCnSigma h U) (I ^ (n + 1))) =
        Ideal.map (wcCnSigma (q ≫ h) V) (I ^ (n + 1)) := by
      rw [RingHom.algebraMap_toAlgebra, Ideal.map_map, sigq U V hle]
    rw [hid] at hker hkill
    exact ⟨hfin, hsurj, hker, hkill⟩

  let 𝓑 : P.Opens → Prop := fun V => IsAffineOpen V ∧ ∃ U : Z.Opens, IsAffineOpen U ∧ V ≤ q ⁻¹ᵁ U
  have hher : ∀ V V' : P.Opens, 𝓑 V → V' ≤ V → IsAffineOpen V' → 𝓑 V' := by
    rintro V V' ⟨-, U, hU, hle⟩ hVV hV'
    exact ⟨hV', U, hU, hVV.trans hle⟩
  have hcovP : ∀ x : P, ∃ V : P.Opens, 𝓑 V ∧ x ∈ V := by
    intro x
    obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
      (show q x ∈ (⊤ : Z.Opens) from trivial)
    obtain ⟨V, hV, hxV, hVU⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp P.isBasis_affineOpens)
      (show x ∈ q ⁻¹ᵁ U from hxU)
    exact ⟨V, ⟨hV, U, hU, hVU⟩, hxV⟩
  have hcov := wc_cn_pb_basic_good_cover P 𝓑 hher hcovP

  have hqc : ∀ n, wcQcoh ((Scheme.Modules.pullback q).obj (Fs n)) := by
    intro n
    refine wc_cn_pb_qcoh_of_good_basis P _ 𝓑 hher hcov ?_
    rintro V ⟨hV, U, hU, hle⟩ f
    exact wc_cn_pb_local_qcoh_of_tensor Z P q (Fs n) U V hV hle f
      (wc_cn_pb_affine_tensor_sections Z P q (Fs n) (hqcF n) U V hU hV hle)
      (wc_cn_pb_affine_tensor_sections Z P q (Fs n) (hqcF n) U (P.basicOpen f) hU
        (hV.basicOpen f) ((P.basicOpen_le f).trans hle))

  have hzero : ∀ (M : P.Modules), wcQcoh M → ∀ (W : P.Opens), IsAffineOpen W →
      ∀ (k : ℕ) (g : Fin k → Γ(P, W)), Ideal.span (Set.range g) = ⊤ → ∀ t : Γ(M, W),
      (∀ i, (M.presheaf.map (homOfLE (P.basicOpen_le (g i))).op).hom t = 0) → t = 0 := by
    intro M hM W hW k g hg t ht
    have hmem : t ∈ (⊥ : Submodule Γ(P, W) Γ(M, W)) := by
      refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (Set.range g) hg t ?_
      rintro ⟨_, i, rfl⟩
      obtain ⟨m, hm⟩ := (hM W hW (g i)).2 t (ht i)
      exact ⟨m, by rw [hm]; exact Submodule.zero_mem _⟩
    exact (Submodule.mem_bot _).mp hmem

  have hkill : ∀ n (W : P.Opens), IsAffineOpen W →
      Ideal.map (wcCnSigma (q ≫ h) W) (I ^ (n + 1)) •
        (⊤ : Submodule Γ(P, W) Γ((Scheme.Modules.pullback q).obj (Fs n), W)) = ⊥ := by
    intro n W hW
    obtain ⟨k, g, hg, hgood⟩ := hcov W hW
    refine eq_bot_iff.mpr (Submodule.smul_le.mpr fun r hr x _ => (Submodule.mem_bot _).mpr ?_)
    refine hzero _ (hqc n) W hW k g hg _ (fun i => ?_)
    obtain ⟨hV, U, hU, hle⟩ := hgood i
    have hr' : (P.presheaf.map (homOfLE (P.basicOpen_le (g i))).op).hom r ∈
        Ideal.map (wcCnSigma (q ≫ h) (P.basicOpen (g i))) (I ^ (n + 1)) := by
      rw [sigres (q ≫ h) (P.basicOpen_le (g i)), ← Ideal.map_map]
      exact Ideal.mem_map_of_mem _ hr
    have h2 := Submodule.smul_mem_smul hr' (Submodule.mem_top (x :=
      (((Scheme.Modules.pullback q).obj (Fs n)).presheaf.map
        (homOfLE (P.basicOpen_le (g i))).op).hom x))
    rw [(hloc n U _ hU hV hle).2.2.2] at h2
    rw [Scheme.Modules.map_smul]
    exact (Submodule.mem_bot _).mp h2
  refine ⟨fun n => ⟨hqc n, ?_⟩, fun n W hW => ?_, fun n W hW => hkill n W hW⟩
  ·
    intro W hW
    obtain ⟨k, g, hg, hgood⟩ := hcov W hW
    refine wc_cn_pb_finite_of_basic_cover P _ (hqc n) W hW k g hg (fun i => ?_)
    obtain ⟨hV, U, hU, hle⟩ := hgood i
    exact (hloc n U _ hU hV hle).1
  · obtain ⟨k, g, hg, hgood⟩ := hcov W hW
    refine ⟨wc_cn_pb_surj_of_basic_cover P _ _ ((Scheme.Modules.pullback q).map (ψ n))
      (hqc (n + 1)) (hqc n) W hW k g hg (fun i => ?_), fun s => ⟨fun hs => ?_, fun hs => ?_⟩⟩
    · obtain ⟨hV, U, hU, hle⟩ := hgood i
      exact (hloc n U _ hU hV hle).2.1
    ·
      refine wc_cn_pb_smul_mem_of_basic_cover P _ (hqc (n + 1)) W hW k g hg _ s (fun i => ?_)
      obtain ⟨hV, U, hU, hle⟩ := hgood i
      have hs' : Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) W s = 0 := hs
      have h1 := ((hloc n U _ hU hV hle).2.2.1 _).mp
        (by rw [natr _ (P.basicOpen_le (g i)), hs', map_zero])
      rwa [sigres (q ≫ h) (P.basicOpen_le (g i)), ← Ideal.map_map] at h1
    ·
      show Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) W s = 0
      refine Submodule.smul_induction_on
        (p := fun s => Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) W s = 0)
        hs (fun r hr x _ => ?_) (fun x y hx hy => ?_)
      · show Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) W (r • x) = 0
        rw [Scheme.Modules.Hom.app_smul]
        have h3 := Submodule.smul_mem_smul hr (Submodule.mem_top (x :=
          Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) W x))
        rw [hkill n W hW] at h3
        exact (Submodule.mem_bot _).mp h3
      · show Scheme.Modules.Hom.app ((Scheme.Modules.pullback q).map (ψ n)) W (x + y) = 0
        rw [map_add]
        rw [hx, hy, add_zero]

theorem wc_cn_pushforward_coherent : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) [IsProper h] (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ) (g : P ⟶ wcPm.{u} m),
    IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) →
    ∀ G : P.Modules, wcCoherentMod G → wcCoherentMod ((Scheme.Modules.pushforward p).obj G) :=
by
  intro B _ _ Z h _ P p m g hp _ G hG

  have wc_pc_qcoh_annihilate : ∀ (X : Scheme.{u}) (G : X.Modules), wcQcoh G → ∀ (X₀ D : X.Opens) (g : Γ(X, X₀)) (hDX₀ : D ≤ X₀), D = X.basicOpen g → ∀ (r : ℕ) (W : Fin r → X.Opens), (∀ i, IsAffineOpen (W i)) → (∀ i, W i ≤ X₀) → (∀ x ∈ X₀, ∃ i, x ∈ W i) → ∀ t : Γ(G, X₀), (G.presheaf.map (homOfLE hDX₀).op).hom t = 0 → ∃ n : ℕ, g ^ n • t = 0 := by
    intro X G hG X₀ D g hDX₀ hD r W hWaff hWle hcov t ht
    subst hD
    have key : ∀ i, ∃ n : ℕ, ((X.presheaf.map (homOfLE (hWle i)).op).hom g) ^ n •
        (G.presheaf.map (homOfLE (hWle i)).op).hom t = 0 := by
      intro i
      refine (hG (W i) (hWaff i) ((X.presheaf.map (homOfLE (hWle i)).op).hom g)).2 _ ?_
      have hle : X.basicOpen ((X.presheaf.map (homOfLE (hWle i)).op).hom g) ≤ X.basicOpen g := by
        rw [Scheme.basicOpen_res]; exact inf_le_right
      have e1 : (G.presheaf.map (homOfLE (X.basicOpen_le
          ((X.presheaf.map (homOfLE (hWle i)).op).hom g))).op).hom
          ((G.presheaf.map (homOfLE (hWle i)).op).hom t) =
          (G.presheaf.map (homOfLE hle).op).hom ((G.presheaf.map (homOfLE hDX₀).op).hom t) := by
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← ConcreteCategory.comp_apply,
          ← Functor.map_comp]
        rfl
      rw [e1, ht, map_zero]
    choose n hn using key
    refine ⟨∑ i, n i, ?_⟩
    have hcov' : X₀ ≤ iSup W := by
      intro x hx
      rw [TopologicalSpace.Opens.mem_iSup]
      exact hcov x hx
    refine TopCat.Sheaf.eq_of_locally_eq' (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab X) W X₀
      (fun i => homOfLE (hWle i)) hcov' _ _ (fun i => ?_)
    change (G.presheaf.map (homOfLE (hWle i)).op).hom (g ^ (∑ i, n i) • t) =
      (G.presheaf.map (homOfLE (hWle i)).op).hom 0
    rw [map_zero, Scheme.Modules.map_smul, map_pow]
    have hle : n i ≤ ∑ j, n j :=
      Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hn i, smul_zero]

  have wc_pc_qcoh_lift_fraction : ∀ (X : Scheme.{u}) (G : X.Modules), wcQcoh G → ∀ (X₀ D : X.Opens) (g : Γ(X, X₀)) (hDX₀ : D ≤ X₀), D = X.basicOpen g → ∀ (r : ℕ) (W : Fin r → X.Opens), (∀ i, IsAffineOpen (W i)) → (∀ i, W i ≤ X₀) → (∀ x ∈ X₀, ∃ i, x ∈ W i) → (∀ i j, IsAffineOpen (W i ⊓ W j)) → ∀ s : Γ(G, D), ∃ (n : ℕ) (t : Γ(G, X₀)), ((X.presheaf.map (homOfLE hDX₀).op).hom g) ^ n • s = (G.presheaf.map (homOfLE hDX₀).op).hom t := by
    intro X G hG X₀ D g hDX₀ hD r W hWaff hWle hcov hpair s
    subst hD
    have resG : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(G, A)),
        (G.presheaf.map (homOfLE h2).op).hom ((G.presheaf.map (homOfLE h1).op).hom x) =
        (G.presheaf.map (homOfLE h3).op).hom x := by
      intro A B C h1 h2 h3 x
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
    have resX : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
        (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE h3).op).hom x := by
      intro A B C h1 h2 h3 x
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
    have smulres : ∀ (A B : X.Opens) (h1 : B ≤ A) (a : Γ(X, A)) (x : Γ(G, A)),
        (G.presheaf.map (homOfLE h1).op).hom (a • x) =
        (X.presheaf.map (homOfLE h1).op).hom a • (G.presheaf.map (homOfLE h1).op).hom x :=
      fun A B h1 a x => Scheme.Modules.map_smul G (homOfLE h1) a x
    let gi : ∀ i, Γ(X, W i) := fun i => (X.presheaf.map (homOfLE (hWle i)).op).hom g
    have hE : ∀ i, X.basicOpen (gi i) = W i ⊓ X.basicOpen g := fun i => Scheme.basicOpen_res X g _
    have hEW : ∀ i, X.basicOpen (gi i) ≤ W i := fun i => X.basicOpen_le _
    have hED : ∀ i, X.basicOpen (gi i) ≤ X.basicOpen g := fun i => by rw [hE i]; exact inf_le_right
    have hEX : ∀ i, X.basicOpen (gi i) ≤ X₀ := fun i => (hEW i).trans (hWle i)
    have hgE : ∀ i, (X.presheaf.map (homOfLE (hEW i)).op).hom (gi i) =
        (X.presheaf.map (homOfLE (hEX i)).op).hom g := fun i => resX _ _ _ (hWle i) (hEW i) (hEX i) g
    have hgE' : ∀ i, (X.presheaf.map (homOfLE (hED i)).op).hom
        ((X.presheaf.map (homOfLE hDX₀).op).hom g) = (X.presheaf.map (homOfLE (hEX i)).op).hom g :=
      fun i => resX _ _ _ hDX₀ (hED i) (hEX i) g

    have hA : ∀ i, ∃ (n : ℕ) (t : Γ(G, W i)),
        ((X.presheaf.map (homOfLE (hEX i)).op).hom g) ^ n •
          (G.presheaf.map (homOfLE (hED i)).op).hom s =
        (G.presheaf.map (homOfLE (hEW i)).op).hom t := by
      intro i
      obtain ⟨n, t, ht⟩ :=
        (hG (W i) (hWaff i) (gi i)).1 ((G.presheaf.map (homOfLE (hED i)).op).hom s)
      exact ⟨n, t, by rw [← hgE i]; exact ht⟩
    choose n t ht using hA

    let N₁ := ∑ i, n i
    let t' : ∀ i, Γ(G, W i) := fun i => (gi i) ^ (N₁ - n i) • t i
    have hB : ∀ i, ((X.presheaf.map (homOfLE (hEX i)).op).hom g) ^ N₁ •
          (G.presheaf.map (homOfLE (hED i)).op).hom s =
        (G.presheaf.map (homOfLE (hEW i)).op).hom (t' i) := by
      intro i
      have hle : n i ≤ N₁ :=
        Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      show _ = (G.presheaf.map (homOfLE (hEW i)).op).hom ((gi i) ^ (N₁ - n i) • t i)
      rw [smulres, map_pow, hgE i, ← ht i, ← mul_smul, ← pow_add, Nat.sub_add_cancel hle]

    have hC : ∀ i j, ∃ m : ℕ,
        ((X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g) ^ m •
        ((G.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (t' i) -
         (G.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (t' j)) = 0 := by
      intro i j
      let gij := (X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g
      refine (hG (W i ⊓ W j) (hpair i j) gij).2 _ ?_
      have hF : X.basicOpen gij = (W i ⊓ W j) ⊓ X.basicOpen g := Scheme.basicOpen_res X g _
      have hFi : X.basicOpen gij ≤ X.basicOpen (gi i) := by
        rw [hF, hE i]; exact inf_le_inf_right _ inf_le_left
      have hFj : X.basicOpen gij ≤ X.basicOpen (gi j) := by
        rw [hF, hE j]; exact inf_le_inf_right _ inf_le_right
      have hFD : X.basicOpen gij ≤ X.basicOpen g := by rw [hF]; exact inf_le_right
      have hFX : X.basicOpen gij ≤ X₀ := hFD.trans hDX₀
      have key : ∀ k, X.basicOpen gij ≤ X.basicOpen (gi k) → ∀ hkk : W i ⊓ W j ≤ W k,
          (G.presheaf.map (homOfLE (X.basicOpen_le gij)).op).hom
            ((G.presheaf.map (homOfLE hkk).op).hom (t' k)) =
          ((X.presheaf.map (homOfLE hFX).op).hom g) ^ N₁ •
            (G.presheaf.map (homOfLE hFD).op).hom s := by
        intro k hk hkk
        have hk' : X.basicOpen gij ≤ W k := hk.trans (hEW k)
        rw [resG _ _ _ _ _ hk', ← resG _ _ _ (hEW k) hk hk', ← hB k, smulres, map_pow,
          resX _ _ _ _ _ hFX, resG _ _ _ _ _ hFD]
      rw [map_sub, key i hFi inf_le_left, key j hFj inf_le_right, sub_self]
    choose m hm using hC

    let M := ∑ p : Fin r × Fin r, m p.1 p.2
    let u : ∀ i, Γ(G, W i) := fun i => (gi i) ^ M • t' i
    have hcompat : TopCat.Presheaf.IsCompatible
        (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab X).obj W u := by
      intro i j
      have hle : m i j ≤ M := Finset.single_le_sum (f := fun p : Fin r × Fin r => m p.1 p.2)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ (i, j))
      have e1 : ∀ k (hk : W i ⊓ W j ≤ W k), (G.presheaf.map (homOfLE hk).op).hom (u k) =
          ((X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g) ^ M •
          (G.presheaf.map (homOfLE hk).op).hom (t' k) := by
        intro k hk
        show (G.presheaf.map (homOfLE hk).op).hom ((gi k) ^ M • t' k) = _
        rw [smulres, map_pow, resX _ _ _ (hWle k) hk (inf_le_left.trans (hWle i))]
      change (G.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (u i) =
        (G.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (u j)
      rw [e1 i inf_le_left, e1 j inf_le_right, ← sub_eq_zero, ← smul_sub,
        ← Nat.sub_add_cancel hle, pow_add, mul_smul, hm i j, smul_zero]
    have hcov' : X₀ ≤ iSup W := fun x hx => TopologicalSpace.Opens.mem_iSup.mpr (hcov x hx)
    obtain ⟨T, hT, -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab X) W X₀ (fun i => homOfLE (hWle i)) hcov' u hcompat
    refine ⟨N₁ + M, T, ?_⟩

    have hcovD : X.basicOpen g ≤ iSup (fun i => X.basicOpen (gi i)) := by
      intro x hx
      obtain ⟨i, hi⟩ := hcov x (hDX₀ hx)
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨i, ?_⟩
      rw [hE i]
      exact ⟨hi, hx⟩
    refine TopCat.Sheaf.eq_of_locally_eq' (⟨G.presheaf, G.isSheaf⟩ : TopCat.Sheaf Ab X)
      (fun i => X.basicOpen (gi i)) (X.basicOpen g) (fun i => homOfLE (hED i)) hcovD _ _
      (fun i => ?_)
    have hTi : (G.presheaf.map (homOfLE (hWle i)).op).hom T = (gi i) ^ M • t' i := hT i
    change (G.presheaf.map (homOfLE (hED i)).op).hom
        (((X.presheaf.map (homOfLE hDX₀).op).hom g) ^ (N₁ + M) • s) =
      (G.presheaf.map (homOfLE (hED i)).op).hom ((G.presheaf.map (homOfLE hDX₀).op).hom T)
    rw [smulres, map_pow, hgE' i, add_comm N₁ M, pow_add, mul_smul, hB i,
      resG _ _ _ _ _ (hEX i), ← resG _ _ _ (hWle i) (hEW i) (hEX i), hTi,
      smulres (W i) _ (hEW i) ((gi i) ^ M) (t' i), map_pow, hgE i]

  have wc_pc_coherent_restrict_opens : ∀ (X : Scheme.{u}) (U : X.Opens) (G : X.Modules), wcCoherentMod G → wcCoherentMod (G.restrict U.ι) := by
    intro X U G hG
    have resG : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(G, A)),
        (G.presheaf.map (homOfLE h2).op).hom ((G.presheaf.map (homOfLE h1).op).hom x) =
        (G.presheaf.map (homOfLE h3).op).hom x := by
      intro A B C h1 h2 h3 x
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
    have resX : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
        (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE h3).op).hom x := by
      intro A B C h1 h2 h3 x
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
    have resid : ∀ (A : X.Opens) (h1 : A ≤ A) (x : Γ(G, A)),
        (G.presheaf.map (homOfLE h1).op).hom x = x := by
      intro A h1 x
      have : (homOfLE h1).op = 𝟙 (Opposite.op A) := Subsingleton.elim _ _
      rw [this, CategoryTheory.Functor.map_id]; rfl
    have injG : ∀ (A B : X.Opens) (h1 : B ≤ A) (h2 : A ≤ B) (x y : Γ(G, A)),
        (G.presheaf.map (homOfLE h1).op).hom x = (G.presheaf.map (homOfLE h1).op).hom y → x = y := by
      intro A B h1 h2 x y hxy
      have := congrArg (G.presheaf.map (homOfLE h2).op).hom hxy
      rwa [resG _ _ _ _ _ le_rfl, resG _ _ _ _ _ le_rfl, resid, resid] at this
    have hring : ∀ (W : (U : Scheme.{u}).Opens) (r : Γ((U : Scheme.{u}), W)),
        (U.ι.appIso W).inv.hom r = r := by
      intro W r; rw [Scheme.Opens.ι_appIso]; rfl
    have hringres : ∀ (W W' : (U : Scheme.{u}).Opens) (h : W' ≤ W) (r : Γ((U : Scheme.{u}), W)),
        (show Γ(X, U.ι ''ᵁ W') from ((U : Scheme.{u}).presheaf.map (homOfLE h).op).hom r) =
        (X.presheaf.map (homOfLE (U.ι.image_mono h)).op).hom (show Γ(X, U.ι ''ᵁ W) from r) := by
      intro W W' h r
      rw [Scheme.Opens.toScheme_presheaf_map]; rfl
    refine ⟨?_, ?_⟩
    · intro W hW f
      have hW' : IsAffineOpen (U.ι ''ᵁ W) := hW.image_of_isOpenImmersion U.ι
      let f' : Γ(X, U.ι ''ᵁ W) := f
      have E : U.ι ''ᵁ ((U : Scheme.{u}).basicOpen f) = X.basicOpen f' := by
        rw [Scheme.image_basicOpen, hring]
      have hDW : U.ι ''ᵁ ((U : Scheme.{u}).basicOpen f) ≤ U.ι ''ᵁ W :=
        U.ι.image_mono ((U : Scheme.{u}).basicOpen_le f)
      obtain ⟨hi, hii⟩ := hG.1 (U.ι ''ᵁ W) hW' f'
      refine ⟨fun s => ?_, fun t ht => ?_⟩
      · let s0 : Γ(G, U.ι ''ᵁ ((U : Scheme.{u}).basicOpen f)) := s
        obtain ⟨n, t, ht⟩ := hi ((G.presheaf.map (homOfLE E.ge).op).hom s0)
        refine ⟨n, t, ?_⟩
        change (U.ι.appIso _).inv.hom
            ((((U : Scheme.{u}).presheaf.map (homOfLE ((U : Scheme.{u}).basicOpen_le f)).op).hom f) ^ n)
              • s0 =
            (G.presheaf.map (homOfLE hDW).op).hom (show Γ(G, U.ι ''ᵁ W) from t)
        have e3 : (U.ι.appIso _).inv.hom
            ((((U : Scheme.{u}).presheaf.map (homOfLE ((U : Scheme.{u}).basicOpen_le f)).op).hom f) ^ n)
            = ((X.presheaf.map (homOfLE hDW).op).hom f') ^ n :=
          (hring _ _).trans (congrArg (fun a : Γ(X, U.ι ''ᵁ ((U : Scheme.{u}).basicOpen f)) => a ^ n)
            (hringres W _ ((U : Scheme.{u}).basicOpen_le f) f))
        rw [e3]
        apply injG _ _ E.ge E.le
        rw [Scheme.Modules.map_smul, map_pow, resX _ _ _ _ _ (X.basicOpen_le f'),
          resG _ _ _ _ _ (X.basicOpen_le f')]
        exact ht
      · have ht0 : (G.presheaf.map (homOfLE hDW).op).hom (show Γ(G, U.ι ''ᵁ W) from t) = 0 := ht
        let t0 : Γ(G, U.ι ''ᵁ W) := t
        obtain ⟨n, hn⟩ := hii t0 (by
          rw [← resG (U.ι ''ᵁ W) _ (X.basicOpen f') hDW E.ge (X.basicOpen_le f') t0]
          change (G.presheaf.map (homOfLE E.ge).op).hom
            ((G.presheaf.map (homOfLE hDW).op).hom (show Γ(G, U.ι ''ᵁ W) from t)) = 0
          rw [ht0, map_zero])
        refine ⟨n, ?_⟩
        change (U.ι.appIso W).inv.hom (f ^ n) • t0 = 0
        rw [hring]
        exact hn
    · intro W hW
      have hW' : IsAffineOpen (U.ι ''ᵁ W) := hW.image_of_isOpenImmersion U.ι
      haveI := hG.2 _ hW'
      let σ : Γ(X, U.ι ''ᵁ W) →+* Γ((U : Scheme.{u}), W) := (U.ι.appIso W).hom.hom
      let F : Γ(G, U.ι ''ᵁ W) →ₛₗ[σ] Γ(G.restrict U.ι, W) :=
        { toFun := fun x => x
          map_add' := fun _ _ => rfl
          map_smul' := fun a x => by
            change a • x = (U.ι.appIso W).inv.hom (σ a) • x
            rw [← ConcreteCategory.comp_apply, Iso.hom_inv_id]; rfl }
      exact Module.Finite.of_surjective F (fun y => ⟨y, rfl⟩)

  have wc_pc_pushforward_finite_of_restrict_gens : ∀ (Z P : Scheme.{u}) (p : P ⟶ Z) (V : Z.Opens) (hV : IsAffineOpen V) (G : P.Modules) (k : ℕ) (c : Fin k → Γ(G.restrict (p ⁻¹ᵁ V).ι, ⊤)), (∀ s : Γ(G.restrict (p ⁻¹ᵁ V).ι, ⊤), ∃ b : Fin k → Γ(Z, V), s = ∑ l, wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ (b l) • c l) → Module.Finite Γ(Z, V) Γ((Scheme.Modules.pushforward p).obj G, V) := by
    intro Z P p V hV G k c hc
    have hO : p ⁻¹ᵁ V ≤ (p ⁻¹ᵁ V).ι ''ᵁ ⊤ := (Scheme.Opens.ι_image_top (p ⁻¹ᵁ V)).ge
    have hO' : (p ⁻¹ᵁ V).ι ''ᵁ ⊤ ≤ p ⁻¹ᵁ V := (Scheme.Opens.ι_image_top (p ⁻¹ᵁ V)).le
    have endoP : ∀ (A : P.Opens) (i : Opposite.op A ⟶ Opposite.op A) (x : Γ(P, A)),
        (P.presheaf.map i).hom x = x := by
      intro A i x
      rw [Subsingleton.elim i (𝟙 _), CategoryTheory.Functor.map_id]; rfl
    have endoG : ∀ (A : P.Opens) (i : Opposite.op A ⟶ Opposite.op A) (x : Γ(G, A)),
        (G.presheaf.map i).hom x = x := by
      intro A i x
      rw [Subsingleton.elim i (𝟙 _), CategoryTheory.Functor.map_id]; rfl
    have e0 : ((p ⁻¹ᵁ V : Scheme.{u}).presheaf.map
        (homOfLE (le_top : (⊤ : (p ⁻¹ᵁ V : Scheme.{u}).Opens) ≤ ⊤)).op) = 𝟙 _ := by
      rw [Subsingleton.elim (homOfLE (le_top : (⊤ : (p ⁻¹ᵁ V : Scheme.{u}).Opens) ≤ ⊤)).op (𝟙 _),
        CategoryTheory.Functor.map_id]
    have hGSI : ∀ y : Γ(Z, V), (Scheme.ΓSpecIso Γ(Z, V)).hom.hom
        ((Scheme.ΓSpecIso (CommRingCat.of Γ(Z, V))).inv.hom y) = y :=
      fun y => Iso.inv_hom_id_apply (Scheme.ΓSpecIso Γ(Z, V)) y
    have K : ∀ a : Γ(Z, V), (P.presheaf.map (homOfLE hO).op).hom
        (show Γ(P, (p ⁻¹ᵁ V).ι ''ᵁ ⊤) from
          wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ a) = (p.app V).hom a := by
      intro a
      have e1 : wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ a =
          (p ∣_ V).appTop.hom (V.topIso.inv.hom a) := by
        simp only [wcCnSigma, RingHom.comp_apply]
        rw [e0, Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_hom_appTop]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.id_apply, RingHom.comp_apply]
        rw [hGSI]
      rw [e1, morphismRestrict_appTop, Scheme.Opens.topIso_inv]
      have nat := congrArg (fun φ => φ.hom a)
        (Scheme.Hom.naturality p (eqToHom (Scheme.Opens.ι_image_top V)).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at nat
      have chain : ∀ (A B C : P.Opens) (i3 : Opposite.op A ⟶ Opposite.op B)
          (i2 : Opposite.op B ⟶ Opposite.op C) (i1 : Opposite.op C ⟶ Opposite.op A) (x : Γ(P, A)),
          (P.presheaf.map i1).hom ((P.presheaf.map i2).hom ((P.presheaf.map i3).hom x)) = x := by
        intro A B C i3 i2 i1 x
        rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
          ← Functor.map_comp]
        exact endoP _ _ _
      change (P.presheaf.map (homOfLE hO).op).hom ((P.presheaf.map _).hom
        ((p.app (V.ι ''ᵁ ⊤)).hom ((Z.presheaf.map (eqToHom (Scheme.Opens.ι_image_top V)).op).hom a))) = _
      rw [nat]
      exact chain _ _ _ _ _ _ _
    let εh := (G.presheaf.map (homOfLE hO).op).hom
    have hact : ∀ (a : Γ(Z, V)) (x : Γ(G.restrict (p ⁻¹ᵁ V).ι, ⊤)),
        εh (wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ a • x) =
          (p.app V).hom a • εh x := by
      intro a x
      have e3 : ((p ⁻¹ᵁ V).ι.appIso ⊤).inv.hom
          (wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ a) =
          (show Γ(P, (p ⁻¹ᵁ V).ι ''ᵁ ⊤) from
            wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ a) := by
        rw [Scheme.Opens.ι_appIso]; rfl
      change εh (((p ⁻¹ᵁ V).ι.appIso ⊤).inv.hom
          (wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ a) •
          (show Γ(G, (p ⁻¹ᵁ V).ι ''ᵁ ⊤) from x)) = _
      rw [e3]
      change (G.presheaf.map (homOfLE hO).op).hom (_ • _) = _
      rw [Scheme.Modules.map_smul, K]
    classical
    let εr : Γ(G.restrict (p ⁻¹ᵁ V).ι, ⊤) →+ Γ(G, p ⁻¹ᵁ V) := εh
    have hact' : ∀ (a : Γ(Z, V)) (x : Γ(G.restrict (p ⁻¹ᵁ V).ι, ⊤)),
        εr (wcCnSigma (B := Γ(Z, V)) ((p ∣_ V) ≫ hV.isoSpec.hom) ⊤ a • x) =
          (p.app V).hom a • εr x := hact
    let M := Γ((Scheme.Modules.pushforward p).obj G, V)
    let gens : Fin k → M := fun l => εr (c l)
    refine ⟨⟨Finset.univ.image gens, eq_top_iff.mpr fun y _ => ?_⟩⟩
    let y0 : Γ(G, p ⁻¹ᵁ V) := y
    let s : Γ(G.restrict (p ⁻¹ᵁ V).ι, ⊤) := (G.presheaf.map (homOfLE hO').op).hom y0
    have hys : εr s = y0 := by
      change (G.presheaf.map (homOfLE hO).op).hom ((G.presheaf.map (homOfLE hO').op).hom y0) = y0
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      exact endoG _ _ _
    obtain ⟨b, hb⟩ := hc s
    have hy : y = ∑ l, b l • gens l := by
      change y0 = _
      rw [← hys, hb, map_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [hact']
      rfl
    rw [hy]
    refine Submodule.sum_mem _ (fun l _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
    exact Finset.mem_coe.mpr (Finset.mem_image_of_mem gens (Finset.mem_univ l))
  haveI := hp
  haveI : IsLocallyNoetherian (Spec (.of B)) :=
    (isLocallyNoetherian_Spec (R := CommRingCat.of B)).mpr ‹IsNoetherianRing B›
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  have hsep : IsSeparated (Limits.terminal.from P) := by
    have e : Limits.terminal.from P = (p ≫ h) ≫ Limits.terminal.from (Spec (.of B)) :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance
  haveI : P.IsSeparated := Scheme.IsSeparated.mk hsep
  refine ⟨?_, ?_⟩
  ·
    intro V hV f
    have hcpt : IsCompact ((p ⁻¹ᵁ V : P.Opens) : Set P) :=
      QuasiCompact.isCompact_preimage (f := p) (V : Set Z) V.isOpen hV.isCompact

    obtain ⟨r, W, hWaff, hWle, hcov, hpair⟩ : ∃ (r : ℕ) (W : Fin r → P.Opens),
        (∀ i, IsAffineOpen (W i)) ∧ (∀ i, W i ≤ p ⁻¹ᵁ V) ∧ (∀ x ∈ p ⁻¹ᵁ V, ∃ i, x ∈ W i) ∧
        ∀ i j, IsAffineOpen (W i ⊓ W j) := by
      have hW : ∀ x : ↥(p ⁻¹ᵁ V), ∃ W : P.Opens, IsAffineOpen W ∧ x.1 ∈ W ∧ W ≤ p ⁻¹ᵁ V := by
        intro x
        obtain ⟨U', hU', hxU', hle⟩ :=
          (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (P.isBasis_affineOpens)) x.2
        exact ⟨U', hU', hxU', hle⟩
      choose W' hWaff hWmem hWle using hW
      obtain ⟨t, ht⟩ := hcpt.elim_finite_subcover (fun x => (W' x : Set P))
        (fun x => (W' x).isOpen) (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hWmem ⟨y, hy⟩⟩)
      let e := t.equivFin
      refine ⟨t.card, fun i => W' (e.symm i).1, fun i => hWaff _, fun i => hWle _, ?_,
        fun i j => (hWaff _).inf (hWaff _)⟩
      intro x hx
      have hx' := ht hx
      simp only [Set.mem_iUnion] at hx'
      obtain ⟨y, hy, hxy⟩ := hx'
      refine ⟨e ⟨y, hy⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      exact hxy
    have hDX₀ : p ⁻¹ᵁ Z.basicOpen f ≤ p ⁻¹ᵁ V := p.preimage_mono (Z.basicOpen_le f)
    have hD : p ⁻¹ᵁ Z.basicOpen f = P.basicOpen ((p.app V).hom f) := Scheme.preimage_basicOpen p f
    have hT3 : (p.app (Z.basicOpen f)).hom ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) =
        (P.presheaf.map (homOfLE hDX₀).op).hom ((p.app V).hom f) :=
      congrArg (fun φ => φ.hom f) (Scheme.Hom.naturality p (homOfLE (Z.basicOpen_le f)).op)
    refine ⟨fun s => ?_, fun t ht => ?_⟩
    · obtain ⟨n, t, ht⟩ := wc_pc_qcoh_lift_fraction P G hG.1 (p ⁻¹ᵁ V) (p ⁻¹ᵁ Z.basicOpen f)
        ((p.app V).hom f) hDX₀ hD r W hWaff hWle hcov hpair s
      refine ⟨n, t, ?_⟩
      change (p.app (Z.basicOpen f)).hom
          (((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ n) •
          (show Γ(G, p ⁻¹ᵁ Z.basicOpen f) from s) = (G.presheaf.map (homOfLE hDX₀).op).hom t
      rw [map_pow, hT3]
      exact ht
    · have ht' : (G.presheaf.map (homOfLE hDX₀).op).hom t = 0 := ht
      obtain ⟨n, hn⟩ := wc_pc_qcoh_annihilate P G hG.1 (p ⁻¹ᵁ V) (p ⁻¹ᵁ Z.basicOpen f)
        ((p.app V).hom f) hDX₀ hD r W hWaff hWle hcov t ht'
      refine ⟨n, ?_⟩
      change (p.app V).hom (f ^ n) • (show Γ(G, p ⁻¹ᵁ V) from t) = 0
      rw [map_pow]
      exact hn
  ·
    intro V hV
    haveI : IsNoetherianRing Γ(Z, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
    have hcoh := wc_pc_coherent_restrict_opens P (p ⁻¹ᵁ V) G hG
    obtain ⟨k, c, hc⟩ := wc_cn_coherent_global_sections_fg Γ(Z, V) (p ⁻¹ᵁ V : Scheme.{u})
      ((p ∣_ V) ≫ hV.isoSpec.hom) (G.restrict (p ⁻¹ᵁ V).ι) hcoh
    exact wc_pc_pushforward_finite_of_restrict_gens Z P p V hV G k c hc

theorem wc_cn_quotient_system_of_coherent : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B]
    (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsNoetherian Z] (H : Z.Modules),
    wcCoherentMod H → ∃ (Hs : ℕ → Z.Modules) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n) (φH : ∀ n, H ⟶ Hs n),
      wcCnAdicSys h I Hs ψH ∧ wcCnAlg h I Hs ψH H φH :=
by
  intro B _ _ I Z h _ H hH

  have capp : ∀ {P Q R : Z.Modules} (f : P ⟶ Q) (k : Q ⟶ R) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ k) U x =
        Scheme.Modules.Hom.app k U (Scheme.Modules.Hom.app f U x) := by
    intro P Q R f k U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : Z.Modules} (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) U x = 0 := by
    intro P Q U x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have iapp : ∀ {P : Z.Modules} (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (𝟙 P) U x = x := by
    intro P U x
    rw [Scheme.Modules.Hom.id_app]
    rfl
  have smapp : ∀ {P Q : Z.Modules} (f : P ⟶ Q) (U : Z.Opens) (r : Γ(Z, U)) (x : Γ(P, U)),
      Scheme.Modules.Hom.app f U (r • x) = r • Scheme.Modules.Hom.app f U x :=
    fun f U r x => Scheme.Modules.Hom.app_smul f r x
  have hsmul : ∀ {P Q : Z.Modules} (f : P ⟶ Q) (U : Z.Opens) (J : Ideal Γ(Z, U)) (x : Γ(P, U)),
      x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(P, U)) →
        Scheme.Modules.Hom.app f U x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U)) := by
    intro P Q f U J x hx
    refine Submodule.smul_induction_on
      (p := fun y => Scheme.Modules.Hom.app f U y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))) hx ?_ ?_
    · intro r hr y _
      show Scheme.Modules.Hom.app f U (r • y) ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [smapp]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro y y' hy hy'
      show Scheme.Modules.Hom.app f U (y + y') ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [map_add]
      exact Submodule.add_mem _ hy hy'

  have sres : ∀ (c : B) (U V : Z.Opens) (i : V ⟶ U),
      (Z.presheaf.map i.op).hom (wcCnSigma h U c) = wcCnSigma h V c := by
    intro c U V i
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← RingHom.comp_apply (Z.presheaf.map i.op).hom, ← CommRingCat.hom_comp,
      ← Functor.map_comp]
    rfl

  have s1 : ∀ (M : Z.Modules) (c : B), ∃ μ : M ⟶ M, ∀ (U : Z.Opens) (s : Γ(M, U)),
      Scheme.Modules.Hom.app μ U s = wcCnSigma h U c • s := by
    intro M c
    let α : M.val.presheaf ⟶ M.val.presheaf :=
      { app := fun U => AddCommGrpCat.ofHom
          (DistribSMul.toAddMonoidHom Γ(M, U.unop) (wcCnSigma h U.unop c))
        naturality := by
          intro U V i
          ext s
          have e1 := Scheme.Modules.map_smul M i.unop (wcCnSigma h U.unop c) s
          rw [sres c U.unop V.unop i.unop] at e1
          exact e1.symm }
    refine ⟨⟨PresheafOfModules.homMk α ?_⟩, fun U s => rfl⟩
    intro X r m
    have key : ∀ (a b : Γ(Z, X.unop)) (x : Γ(M, X.unop)), a • (b • x) = b • (a • x) :=
      fun a b x => by rw [smul_smul, smul_smul, mul_comm]
    exact key (wcCnSigma h X.unop c) r m

  have s2 : ∀ (M : Z.Modules) (c : B), wcCoherentMod M → ∃ (Q : Z.Modules) (π : M ⟶ Q),
      wcCoherentMod Q ∧
      (∀ U : Z.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app π U) ∧
        ∀ s : Γ(M, U), Scheme.Modules.Hom.app π U s = 0 ↔
          ∃ y : Γ(M, U), s = wcCnSigma h U c • y) ∧
      ∀ (T : Z.Modules) (g : M ⟶ T), (∀ U : Z.Opens, IsAffineOpen U → ∀ y : Γ(M, U),
        Scheme.Modules.Hom.app g U (wcCnSigma h U c • y) = 0) → ∃ g' : Q ⟶ T, π ≫ g' = g := by
    intro M c hM
    obtain ⟨μ, hμ⟩ := s1 M c
    have hfac : Abelian.coimage.π μ ≫ Abelian.factorThruCoimage μ = μ := Abelian.coimage.fac μ
    have hK : wcQcoh (Limits.kernel μ) := wc_cn_kernel_qcoh Z M M μ hM.1 hM.1
    obtain ⟨hIcoh, hps⟩ := wc_cn_coimage_coherent Z M M μ hM hM hK
    obtain ⟨hSES, hQcoh, -, -⟩ := wc_dev_cokernel_coh Z (Abelian.coimage μ) M
      (Abelian.factorThruCoimage μ) inferInstance hIcoh hM
    refine ⟨Limits.cokernel (Abelian.factorThruCoimage μ), Limits.cokernel.π _, hQcoh, ?_, ?_⟩
    · intro U hU
      refine ⟨wc_modules_ses_affine_surj Z _ hSES hIcoh.1 U hU, fun s => ⟨fun hs => ?_, ?_⟩⟩
      · obtain ⟨x, hx⟩ := (wc_modules_ses_left_exact Z _ hSES).2 U s hs
        obtain ⟨z, rfl⟩ := hps U hU x
        have hx' : Scheme.Modules.Hom.app (Abelian.factorThruCoimage μ) U
            (Scheme.Modules.Hom.app (Abelian.coimage.π μ) U z) = s := hx
        refine ⟨z, ?_⟩
        rw [← hμ, ← hfac, capp]
        exact hx'.symm
      · rintro ⟨y, rfl⟩
        have e : μ ≫ Limits.cokernel.π (Abelian.factorThruCoimage μ) = 0 := by
          calc μ ≫ Limits.cokernel.π (Abelian.factorThruCoimage μ)
              = (Abelian.coimage.π μ ≫ Abelian.factorThruCoimage μ) ≫
                  Limits.cokernel.π (Abelian.factorThruCoimage μ) := by rw [hfac]
            _ = 0 := by rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
        rw [← hμ, ← capp, e, zapp]
    · intro T g hg
      have h0 : μ ≫ g = 0 := by
        apply wc_cn_modules_hom_ext_affine
        intro U hU x
        rw [capp, hμ, zapp]
        exact hg U hU x
      have h1 : Abelian.factorThruCoimage μ ≫ g = 0 := by
        rw [← cancel_epi (Abelian.coimage.π μ), ← Category.assoc, hfac, h0, Limits.comp_zero]
      exact ⟨Limits.cokernel.desc _ g h1, Limits.cokernel.π_desc _ _ _⟩

  have s3 : ∀ (S : Finset B) (M : Z.Modules), wcCoherentMod M → ∃ (Q : Z.Modules) (π : M ⟶ Q),
      wcCoherentMod Q ∧
      (∀ U : Z.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app π U) ∧
        ∀ s : Γ(M, U), Scheme.Modules.Hom.app π U s = 0 ↔
          s ∈ Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
            (⊤ : Submodule Γ(Z, U) Γ(M, U))) ∧
      ∀ (T : Z.Modules) (g : M ⟶ T), (∀ U : Z.Opens, IsAffineOpen U →
        ∀ s ∈ Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
          (⊤ : Submodule Γ(Z, U) Γ(M, U)), Scheme.Modules.Hom.app g U s = 0) →
        ∃ g' : Q ⟶ T, π ≫ g' = g := by
    classical
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro M hM
      have e : ∀ U : Z.Opens, Ideal.map (wcCnSigma h U) (Ideal.span ((∅ : Finset B) : Set B)) •
          (⊤ : Submodule Γ(Z, U) Γ(M, U)) = ⊥ := by
        intro U
        rw [Finset.coe_empty, Ideal.span_empty, Ideal.map_bot, Submodule.bot_smul]
      refine ⟨M, 𝟙 M, hM, fun U hU => ⟨fun s => ⟨s, iapp U s⟩, fun s => ?_⟩,
        fun T g _ => ⟨g, Category.id_comp g⟩⟩
      rw [e U, Submodule.mem_bot, iapp]
    | insert a S haS ih =>
      intro M hM
      obtain ⟨Q₁, π₁, hQ₁, hsec₁, huniv₁⟩ := ih M hM
      obtain ⟨Q₂, π₂, hQ₂, hsec₂, huniv₂⟩ := s2 Q₁ a hQ₁
      have espan : ∀ U : Z.Opens, ∀ s : Γ(M, U),
          s ∈ Ideal.map (wcCnSigma h U) (Ideal.span ((insert a S : Finset B) : Set B)) •
            (⊤ : Submodule Γ(Z, U) Γ(M, U)) ↔
          ∃ y : Γ(M, U), s - wcCnSigma h U a • y ∈
            Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
              (⊤ : Submodule Γ(Z, U) Γ(M, U)) := by
        intro U s
        rw [Finset.coe_insert, Ideal.span_insert, Ideal.map_sup, Submodule.sup_smul,
          Ideal.map_span, Set.image_singleton, Submodule.ideal_span_singleton_smul,
          Submodule.mem_sup]
        constructor
        · rintro ⟨u, hu, v, hv, rfl⟩
          obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hu
          exact ⟨y, by rwa [add_sub_cancel_left]⟩
        · rintro ⟨y, hy⟩
          exact ⟨wcCnSigma h U a • y,
            (Submodule.mem_smul_pointwise_iff_exists _ _ _).2 ⟨y, Submodule.mem_top, rfl⟩,
            s - wcCnSigma h U a • y, hy, by abel⟩
      refine ⟨Q₂, π₁ ≫ π₂, hQ₂, fun U hU => ⟨?_, fun s => ?_⟩, ?_⟩
      · intro q
        obtain ⟨q₁, hq₁⟩ := (hsec₂ U hU).1 q
        obtain ⟨s, hs⟩ := (hsec₁ U hU).1 q₁
        exact ⟨s, by rw [capp, hs, hq₁]⟩
      · rw [espan U, capp]
        constructor
        · intro hs
          obtain ⟨y', hy'⟩ := ((hsec₂ U hU).2 _).1 hs
          obtain ⟨y, rfl⟩ := (hsec₁ U hU).1 y'
          refine ⟨y, ((hsec₁ U hU).2 _).1 ?_⟩
          rw [map_sub, smapp, hy', sub_self]
        · rintro ⟨y, hy⟩
          refine ((hsec₂ U hU).2 _).2 ⟨Scheme.Modules.Hom.app π₁ U y, ?_⟩
          rw [← smapp, ← sub_eq_zero, ← map_sub]
          exact ((hsec₁ U hU).2 _).2 hy
      · intro T g hg
        have hle : ∀ U : Z.Opens, ∀ s ∈ Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
            (⊤ : Submodule Γ(Z, U) Γ(M, U)),
            s ∈ Ideal.map (wcCnSigma h U) (Ideal.span ((insert a S : Finset B) : Set B)) •
              (⊤ : Submodule Γ(Z, U) Γ(M, U)) := by
          intro U s hs
          refine (Submodule.smul_mono_left (Ideal.map_mono (Ideal.span_mono ?_))) hs
          rw [Finset.coe_insert]
          exact Set.subset_insert _ _
        obtain ⟨g₁, hg₁⟩ := huniv₁ T g (fun U hU s hs => hg U hU s (hle U s hs))
        obtain ⟨g₂, hg₂⟩ := huniv₂ T g₁ (by
          intro U hU q
          obtain ⟨z, rfl⟩ := (hsec₁ U hU).1 q
          rw [← smapp, ← capp, hg₁]
          apply hg U hU
          refine (espan U _).2 ⟨z, ?_⟩
          rw [sub_self]
          exact Submodule.zero_mem _)
        exact ⟨g₂, by rw [Category.assoc, hg₂, hg₁]⟩

  have hFG : ∀ n : ℕ, ∃ S : Finset B, Ideal.span (S : Set B) = I ^ (n + 1) := fun n =>
    IsNoetherian.noetherian (I ^ (n + 1))
  choose S hS using hFG
  have lev : ∀ n : ℕ, ∃ (Q : Z.Modules) (π : H ⟶ Q), wcCoherentMod Q ∧
      (∀ U : Z.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app π U) ∧
        ∀ s : Γ(H, U), Scheme.Modules.Hom.app π U s = 0 ↔
          s ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(H, U))) ∧
      ∀ (T : Z.Modules) (g : H ⟶ T), (∀ U : Z.Opens, IsAffineOpen U →
        ∀ s ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(H, U)),
          Scheme.Modules.Hom.app g U s = 0) → ∃ g' : Q ⟶ T, π ≫ g' = g := by
    intro n
    have := s3 (S n) H hH
    rw [hS n] at this
    exact this
  choose Hs φ hcoh hsec huniv using lev

  have trans : ∀ n, ∃ ψ : Hs (n + 1) ⟶ Hs n, φ (n + 1) ≫ ψ = φ n := by
    intro n
    refine huniv (n + 1) (Hs n) (φ n) (fun U hU s hs => ((hsec n U hU).2 s).2 ?_)
    exact (Submodule.smul_mono_left (Ideal.map_mono (Ideal.pow_le_pow_right (by omega)))) hs
  choose ψ hψ using trans
  have hψapp : ∀ n (U : Z.Opens) (x : Γ(H, U)),
      Scheme.Modules.Hom.app (ψ n) U (Scheme.Modules.Hom.app (φ (n + 1)) U x) =
        Scheme.Modules.Hom.app (φ n) U x := by
    intro n U x
    rw [← capp, hψ]

  have hkill : ∀ n (U : Z.Opens), IsAffineOpen U →
      Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(Hs n, U)) = ⊥ := by
    intro n U hU
    rw [eq_bot_iff]
    intro m hm
    rw [Submodule.mem_bot]
    refine Submodule.smul_induction_on (p := fun m => m = 0) hm ?_ ?_
    · intro r hr q _
      show r • q = 0
      obtain ⟨x, rfl⟩ := (hsec n U hU).1 q
      rw [← smapp]
      exact ((hsec n U hU).2 _).2 (Submodule.smul_mem_smul hr Submodule.mem_top)
    · intro x y hx hy
      show x + y = 0
      rw [hx, hy, add_zero]
  refine ⟨Hs, ψ, φ, ⟨hcoh, fun n U hU => ⟨?_, fun s => ⟨fun hs => ?_, fun hs => ?_⟩⟩, hkill⟩,
    ⟨hH, hψ, hsec⟩⟩
  · intro q
    obtain ⟨x, rfl⟩ := (hsec n U hU).1 q
    exact ⟨_, hψapp n U x⟩
  · obtain ⟨x, rfl⟩ := (hsec (n + 1) U hU).1 s
    rw [hψapp] at hs
    exact hsmul _ U _ x (((hsec n U hU).2 x).1 hs)
  · have h1 := hsmul (ψ n) U _ s hs
    rw [hkill n U hU] at h1
    exact (Submodule.mem_bot _).1 h1

theorem wc_cn_rml_uniformize : ∀ (Z : Scheme.{u}) [CompactSpace Z] (Q : Z.Opens → ℕ → Prop), (∀ (W : Z.Opens), IsAffineOpen W → ∀ (f : Γ(Z, W)) (c : ℕ), Q W c → Q (Z.basicOpen f) c) → (∀ (W : Z.Opens), IsAffineOpen W → ∀ (k : ℕ) (g : Fin k → Γ(Z, W)), Ideal.span (Set.range g) = ⊤ → ∀ c : ℕ, (∀ j, Q (Z.basicOpen (g j)) c) → Q W c) → (∀ (U : Z.Opens), IsAffineOpen U → ∃ c : ℕ, ∀ c' : ℕ, c ≤ c' → Q U c') → ∃ c : ℕ, ∀ (V : Z.Opens), IsAffineOpen V → Q V c :=
by
  intro Z _ Q hres hglue hloc
  classical
  have hA : ∀ x : Z, ∃ U : Z.Opens, IsAffineOpen U ∧ x ∈ U := by
    intro x
    obtain ⟨U', hU', hxU', -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      Z.isBasis_affineOpens) (show x ∈ (⊤ : Z.Opens) from trivial)
    exact ⟨U', hU', hxU'⟩
  choose A hAa hxA using hA
  choose cx hcx using fun x => hloc (A x) (hAa x)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (A x : Set Z))
    (fun x => (A x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hxA y⟩)
  refine ⟨t.sup cx, fun V hV => ?_⟩
  have hcov : ∀ y : Z, ∃ U : Z.Opens, IsAffineOpen U ∧ y ∈ U ∧ Q U (t.sup cx) := by
    intro y
    have hy := ht (Set.mem_univ y)
    rw [Set.mem_iUnion₂] at hy
    obtain ⟨x, hx, hyx⟩ := hy
    exact ⟨A x, hAa x, hyx, hcx x (t.sup cx) (Finset.le_sup hx)⟩
  let S : Set Γ(Z, V) := {f | Q (Z.basicOpen f) (t.sup cx)}
  have hle : V ≤ ⨆ f : S, Z.basicOpen (f : Γ(Z, V)) := by
    intro x hxV
    obtain ⟨U, hU, hxU, hQU⟩ := hcov x
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter hV hU x ⟨hxV, hxU⟩
    have hf : f ∈ S := by
      show Q (Z.basicOpen f) (t.sup cx)
      rw [hfg]
      exact hres U hU g (t.sup cx) hQU
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hf⟩, hxf⟩
  have hspan : Ideal.span S = ⊤ := hV.self_le_iSup_basicOpen_iff.mp hle
  obtain ⟨s', hs'S, hs'⟩ := (Ideal.span_eq_top_iff_finite S).mp hspan
  let g : Fin s'.card → Γ(Z, V) := fun j => (s'.equivFin.symm j : Γ(Z, V))
  have hrange : Set.range g = ↑s' := by
    ext a
    constructor
    · rintro ⟨j, rfl⟩
      exact (s'.equivFin.symm j).2
    · intro ha
      exact ⟨s'.equivFin ⟨a, ha⟩, by simp [g]⟩
  apply hglue V hV s'.card g (by rw [hrange]; exact hs') (t.sup cx)
  intro j
  exact hs'S (s'.equivFin.symm j).2

theorem wc_cn_rml_basic_restrict : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (M : Z.Modules) (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n) (φ : ∀ n, M ⟶ Ms n), wcQcoh M → (∀ n, wcQcoh (Ms n)) → ∀ (W : Z.Opens), IsAffineOpen W → ∀ (f : Γ(Z, W)) (c : ℕ), (∀ n : ℕ, (∀ s : Γ(M, W), Scheme.Modules.Hom.app (φ (n + c)) W s = 0 → s ∈ Ideal.map (wcCnSigma h W) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, W) Γ(M, W))) ∧ (∀ y : Γ(Ms (n + c), W), ∃ s : Γ(M, W), Scheme.Modules.Hom.app (φ n) W s = Scheme.Modules.Hom.app (wcCnTrans ψ n c) W y)) → ∀ n : ℕ, (∀ s : Γ(M, Z.basicOpen f), Scheme.Modules.Hom.app (φ (n + c)) (Z.basicOpen f) s = 0 → s ∈ Ideal.map (wcCnSigma h (Z.basicOpen f)) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, Z.basicOpen f) Γ(M, Z.basicOpen f))) ∧ (∀ y : Γ(Ms (n + c), Z.basicOpen f), ∃ s : Γ(M, Z.basicOpen f), Scheme.Modules.Hom.app (φ n) (Z.basicOpen f) s = Scheme.Modules.Hom.app (wcCnTrans ψ n c) (Z.basicOpen f) y) :=
by
  intro B _ I Z h M Ms ψ φ hM hMs W hW f c hQ n
  have hle : Z.basicOpen f ≤ W := Z.basicOpen_le f
  have natApp : ∀ {N N' : Z.Modules} (g : N ⟶ N') (x : Γ(N, W)),
      Scheme.Modules.Hom.app g (Z.basicOpen f) ((N.presheaf.map (homOfLE hle).op).hom x) =
      (N'.presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app g W x) :=
    fun g x => congrArg (fun k => k.hom x)
      ((Scheme.Modules.Hom.mapPresheaf g).naturality (homOfLE hle).op)
  have hunit : IsUnit ((Z.presheaf.map (homOfLE hle).op).hom f) :=
    RingedSpace.isUnit_res_basicOpen Z.toRingedSpace f
  obtain ⟨v, hv⟩ := hunit.exists_left_inv
  have hvpow : ∀ e : ℕ, v ^ e * ((Z.presheaf.map (homOfLE hle).op).hom f) ^ e = 1 := fun e => by
    rw [← mul_pow, hv, one_pow]
  have hσres : ∀ b : B, (Z.presheaf.map (homOfLE hle).op).hom (wcCnSigma h W b) =
      wcCnSigma h (Z.basicOpen f) b := by
    intro b
    show (Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ Z.presheaf.map (homOfLE hle).op).hom
        ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b) = _
    rw [← Functor.map_comp]
    rfl
  have hJres : ∀ x : Γ(M, W),
      x ∈ Ideal.map (wcCnSigma h W) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, W) Γ(M, W)) →
      (M.presheaf.map (homOfLE hle).op).hom x ∈ Ideal.map (wcCnSigma h (Z.basicOpen f)) (I ^ (n + 1)) •
        (⊤ : Submodule Γ(Z, Z.basicOpen f) Γ(M, Z.basicOpen f)) := by
    intro x hx
    refine Submodule.smul_induction_on
      (p := fun x => (M.presheaf.map (homOfLE hle).op).hom x ∈
        Ideal.map (wcCnSigma h (Z.basicOpen f)) (I ^ (n + 1)) •
          (⊤ : Submodule Γ(Z, Z.basicOpen f) Γ(M, Z.basicOpen f))) hx ?_ ?_
    · intro r hr m _
      rw [Scheme.Modules.map_smul]
      refine Submodule.smul_mem_smul ?_ Submodule.mem_top
      have hle' : Ideal.map (wcCnSigma h W) (I ^ (n + 1)) ≤
          Ideal.comap (Z.presheaf.map (homOfLE hle).op).hom
            (Ideal.map (wcCnSigma h (Z.basicOpen f)) (I ^ (n + 1))) := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, Ideal.mem_comap, hσres]
        exact Ideal.mem_map_of_mem _ hb
      exact hle' hr
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  refine ⟨fun s hs => ?_, fun y => ?_⟩
  · obtain ⟨a, t, hat⟩ := (hM W hW f).1 s
    have h0 : ((Ms (n + c)).presheaf.map (homOfLE hle).op).hom
        (Scheme.Modules.Hom.app (φ (n + c)) W t) = 0 := by
      rw [← natApp, ← hat, Scheme.Modules.Hom.app_smul, hs, smul_zero]
    obtain ⟨b, hb⟩ := (hMs (n + c) W hW f).2 _ h0
    have hk : Scheme.Modules.Hom.app (φ (n + c)) W (f ^ b • t) = 0 := by
      rw [Scheme.Modules.Hom.app_smul, hb]
    have h1 := hJres _ ((hQ n).1 _ hk)
    rw [Scheme.Modules.map_smul, map_pow, ← hat, smul_smul] at h1
    have hs' : s = (v ^ b * v ^ a) • ((((Z.presheaf.map (homOfLE hle).op).hom f) ^ b *
        ((Z.presheaf.map (homOfLE hle).op).hom f) ^ a) • s) := by
      rw [smul_smul, show v ^ b * v ^ a * (((Z.presheaf.map (homOfLE hle).op).hom f) ^ b *
          ((Z.presheaf.map (homOfLE hle).op).hom f) ^ a) =
          (v ^ b * ((Z.presheaf.map (homOfLE hle).op).hom f) ^ b) *
          (v ^ a * ((Z.presheaf.map (homOfLE hle).op).hom f) ^ a) by ring,
        hvpow, hvpow, one_mul, one_smul]
    rw [hs']
    exact Submodule.smul_mem _ _ h1
  · obtain ⟨a, t, hat⟩ := (hMs (n + c) W hW f).1 y
    obtain ⟨s₀, hs₀⟩ := (hQ n).2 t
    refine ⟨v ^ a • (M.presheaf.map (homOfLE hle).op).hom s₀, ?_⟩
    rw [Scheme.Modules.Hom.app_smul, natApp, hs₀, ← natApp, ← hat, Scheme.Modules.Hom.app_smul,
      smul_smul, hvpow, one_smul]

theorem wc_cn_rml_basic_glue : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (M : Z.Modules) (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n) (φ : ∀ n, M ⟶ Ms n), wcQcoh M → (∀ n, wcQcoh (Ms n)) → ∀ (W : Z.Opens), IsAffineOpen W → ∀ (k : ℕ) (g : Fin k → Γ(Z, W)), Ideal.span (Set.range g) = ⊤ → ∀ c : ℕ, (∀ (j : Fin k) (n : ℕ), (∀ s : Γ(M, Z.basicOpen (g j)), Scheme.Modules.Hom.app (φ (n + c)) (Z.basicOpen (g j)) s = 0 → s ∈ Ideal.map (wcCnSigma h (Z.basicOpen (g j))) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, Z.basicOpen (g j)) Γ(M, Z.basicOpen (g j)))) ∧ (∀ y : Γ(Ms (n + c), Z.basicOpen (g j)), ∃ s : Γ(M, Z.basicOpen (g j)), Scheme.Modules.Hom.app (φ n) (Z.basicOpen (g j)) s = Scheme.Modules.Hom.app (wcCnTrans ψ n c) (Z.basicOpen (g j)) y)) → ∀ n : ℕ, (∀ s : Γ(M, W), Scheme.Modules.Hom.app (φ (n + c)) W s = 0 → s ∈ Ideal.map (wcCnSigma h W) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, W) Γ(M, W))) ∧ (∀ y : Γ(Ms (n + c), W), ∃ s : Γ(M, W), Scheme.Modules.Hom.app (φ n) W s = Scheme.Modules.Hom.app (wcCnTrans ψ n c) W y) :=
by
  intro B _ I Z h M Ms ψ φ hM hMs W hW k g hg c hD n
  have natApp : ∀ {P Q : Z.Modules} (f : P ⟶ Q) {A A' : Z.Opens} (hle : A' ≤ A) (x : Γ(P, A)),
      Scheme.Modules.Hom.app f A' ((P.presheaf.map (homOfLE hle).op).hom x) =
      (Q.presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app f A x) :=
    fun f _ _ hle x => congrArg (fun k => k.hom x)
      ((Scheme.Modules.Hom.mapPresheaf f).naturality (homOfLE hle).op)
  have hσ : ∀ j, wcCnSigma h (Z.basicOpen (g j)) =
      (Z.presheaf.map (homOfLE (Z.basicOpen_le (g j))).op).hom.comp (wcCnSigma h W) := by
    intro j
    have key : ∀ x : Γ(Z, ⊤),
        (Z.presheaf.map (homOfLE (le_top : Z.basicOpen (g j) ≤ ⊤)).op).hom x =
        (Z.presheaf.map (homOfLE (Z.basicOpen_le (g j))).op).hom
          ((Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom x) := by
      intro x
      have e : (homOfLE (le_top : Z.basicOpen (g j) ≤ ⊤)).op =
          (homOfLE (le_top : W ≤ ⊤)).op ≫ (homOfLE (Z.basicOpen_le (g j))).op :=
        Subsingleton.elim _ _
      rw [e, Functor.map_comp]
      rfl
    ext b
    unfold wcCnSigma
    try simp only [RingHom.comp_apply, CommRingCat.comp_apply]
    exact key _
  refine ⟨?_, ?_⟩
  · intro s hs
    have hloc : ∀ i, (M.presheaf.map (homOfLE (Z.basicOpen_le (g i))).op).hom s ∈
        Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le (g i))).op).hom
          (Ideal.map (wcCnSigma h W) (I ^ (n + 1))) •
          (⊤ : Submodule Γ(Z, Z.basicOpen (g i)) Γ(M, Z.basicOpen (g i))) := by
      intro i
      have h0 : Scheme.Modules.Hom.app (φ (n + c)) (Z.basicOpen (g i))
          ((M.presheaf.map (homOfLE (Z.basicOpen_le (g i))).op).hom s) = 0 := by
        rw [natApp, hs, map_zero]
      have h1 := (hD i n).1 _ h0
      rw [Ideal.map_map, ← hσ i]
      exact h1
    generalize Ideal.map (wcCnSigma h W) (I ^ (n + 1)) = 𝔞 at hloc ⊢
    refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (Set.range g) hg s ?_
    rintro ⟨_, i, rfl⟩
    set f := g i with hf
    set ρ := (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom with hρ
    set ρM := (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom with hρM
    have hmapsmul : ∀ (r : Γ(Z, W)) (x : Γ(M, W)), ρM (r • x) = ρ r • ρM x := fun r x =>
      Scheme.Modules.map_smul M (homOfLE (Z.basicOpen_le f)) r x
    obtain ⟨qa, qb⟩ := hM W hW f
    let P : Γ(M, Z.basicOpen f) → Prop := fun y =>
      ∃ (N : ℕ) (y' : Γ(M, W)), y' ∈ 𝔞 • (⊤ : Submodule Γ(Z, W) Γ(M, W)) ∧ ρ f ^ N • y = ρM y'
    have P0 : P 0 := ⟨0, 0, Submodule.zero_mem _, by rw [smul_zero, map_zero]⟩
    have Padd : ∀ x y, P x → P y → P (x + y) := by
      rintro x y ⟨N, x', hx', hx⟩ ⟨m, y', hy', hy⟩
      refine ⟨N + m, f ^ m • x' + f ^ N • y', Submodule.add_mem _ (Submodule.smul_mem _ _ hx')
        (Submodule.smul_mem _ _ hy'), ?_⟩
      rw [map_add, hmapsmul, hmapsmul, map_pow, map_pow, ← hx, ← hy, smul_add, smul_smul,
        smul_smul, ← pow_add, ← pow_add, add_comm m N]
    have Pgen : ∀ r ∈ Ideal.map ρ 𝔞, ∀ m, P (r • m) := by
      intro r hr
      induction hr using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        intro m
        obtain ⟨N, t, ht⟩ := qa m
        refine ⟨N, a • t, Submodule.smul_mem_smul ha Submodule.mem_top, ?_⟩
        rw [hmapsmul, ← ht, smul_comm]
      | zero => intro m; rw [zero_smul]; exact P0
      | add x y _ _ hx hy => intro m; rw [add_smul]; exact Padd _ _ (hx m) (hy m)
      | smul c x _ hx =>
        intro m
        rw [smul_eq_mul, mul_comm, mul_smul]
        exact hx (c • m)
    have hP : P (ρM s) :=
      Submodule.smul_induction_on (p := P) (hloc i) (fun r hr m _ => Pgen r hr m) Padd
    obtain ⟨N, y', hy', hy⟩ := hP
    have hz : ρM (f ^ N • s - y') = 0 := by
      rw [map_sub, hmapsmul, map_pow, hy, sub_self]
    obtain ⟨m, hm⟩ := qb _ hz
    refine ⟨m + N, ?_⟩
    rw [smul_sub, sub_eq_zero, smul_smul, ← pow_add] at hm
    rw [hm]
    exact Submodule.smul_mem _ _ hy'
  · intro y
    let L : Γ(M, W) →ₗ[Γ(Z, W)] Γ(Ms n, W) :=
      { toFun := fun x => Scheme.Modules.Hom.app (φ n) W x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul (φ n) r x }
    suffices hmem : Scheme.Modules.Hom.app (wcCnTrans ψ n c) W y ∈ LinearMap.range L by
      obtain ⟨s, hs⟩ := hmem
      exact ⟨s, hs⟩
    refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (Set.range g) hg _ ?_
    rintro ⟨_, i, rfl⟩
    set f := g i with hf
    set ρ := (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom with hρ
    have hmapsmul : ∀ (r : Γ(Z, W)) (x : Γ(Ms n, W)),
        ((Ms n).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (r • x) =
          ρ r • ((Ms n).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom x := fun r x =>
      Scheme.Modules.map_smul (Ms n) (homOfLE (Z.basicOpen_le f)) r x
    obtain ⟨si, hsi⟩ :=
      (hD i n).2 (((Ms (n + c)).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom y)
    rw [natApp (wcCnTrans ψ n c) (Z.basicOpen_le f) y] at hsi
    obtain ⟨qa, _⟩ := hM W hW f
    obtain ⟨_, qb⟩ := hMs n W hW f
    obtain ⟨a, t, ht⟩ := qa si
    have hzero : ((Ms n).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
        (Scheme.Modules.Hom.app (φ n) W t - f ^ a • Scheme.Modules.Hom.app (wcCnTrans ψ n c) W y)
          = 0 := by
      rw [map_sub, hmapsmul, map_pow, ← natApp (φ n) (Z.basicOpen_le f) t, ← ht,
        Scheme.Modules.Hom.app_smul, hsi, sub_self]
    obtain ⟨b, hb⟩ := qb _ hzero
    refine ⟨b + a, ?_⟩
    rw [smul_sub, sub_eq_zero] at hb
    rw [pow_add, mul_smul, ← hb]
    exact ⟨f ^ b • t, Scheme.Modules.Hom.app_smul (φ n) (f ^ b) t⟩

theorem wc_cn_rml_preimage_model : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z P : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (p : P ⟶ Z), IsProper p → ∀ (V : Z.Opens), IsAffineOpen V → ∀ (Gs : ℕ → P.Modules) (ψG : ∀ n, Gs (n+1) ⟶ Gs n) (G : P.Modules) (φG : ∀ n, G ⟶ Gs n), wcCnAlg (p ≫ h) I Gs ψG G φG → ∃ (X : Scheme.{u}) (f : X ⟶ Spec (.of Γ(Z, V))) (Gs' : ℕ → X.Modules) (ψ' : ∀ n, Gs' (n+1) ⟶ Gs' n) (G' : X.Modules) (φ' : ∀ n, G' ⟶ Gs' n) (e : Γ(G', ⊤) ≃+ Γ(G, p ⁻¹ᵁ V)) (es : ∀ n, Γ(Gs' n, ⊤) ≃+ Γ(Gs n, p ⁻¹ᵁ V)), IsProper f ∧ wcCnAlg f (Ideal.map (wcCnSigma h V) I) Gs' ψ' G' φ' ∧ (∀ (n : ℕ) (x : Γ(G', ⊤)), es n (Scheme.Modules.Hom.app (φ' n) ⊤ x) = Scheme.Modules.Hom.app (φG n) (p ⁻¹ᵁ V) (e x)) ∧ (∀ (n : ℕ) (x : Γ(Gs' (n+1), ⊤)), es n (Scheme.Modules.Hom.app (ψ' n) ⊤ x) = Scheme.Modules.Hom.app (ψG n) (p ⁻¹ᵁ V) (es (n+1) x)) ∧ (∀ (r : Γ(Z, V)) (x : Γ(G', ⊤)), e (wcCnSigma f ⊤ r • x) = (p.app V).hom r • e x) :=
by
  intro B _ I Z P h p hp V hV Gs ψG G φG halg
  classical

  have hinv : ∀ (W : (p ⁻¹ᵁ V).toScheme.Opens) (a : Γ((p ⁻¹ᵁ V).toScheme, W)),
      ((p ⁻¹ᵁ V).ι.appIso W).inv.hom a = a := by
    intro W a
    rw [Scheme.Opens.ι_appIso]
    rfl

  have natApp : ∀ {M N : P.Modules} (φ : M ⟶ N) {A A' : P.Opens} (hle : A' ≤ A)
      (x : Γ(M, A)), Scheme.Modules.Hom.app φ A' ((M.presheaf.map (homOfLE hle).op).hom x) =
      (N.presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app φ A x) :=
    fun φ _ _ hle x => congrArg (fun k => k.hom x)
      ((Scheme.Modules.Hom.mapPresheaf φ).naturality (homOfLE hle).op)

  have gen : ∀ {U U' : Z.Opens} {A A' : P.Opens} (i : Opposite.op U' ⟶ Opposite.op U)
      (e : A ≤ p ⁻¹ᵁ U) (j : Opposite.op A ⟶ Opposite.op A') (e' : A' ≤ p ⁻¹ᵁ U'),
      Z.presheaf.map i ≫ p.appLE U A e ≫ P.presheaf.map j = p.appLE U' A' e' := by
    intro U U' A A' i e j e'
    rw [Scheme.Hom.map_appLE_assoc, Scheme.Hom.appLE_map]
  have gen2 : ∀ {U U' : Z.Opens} {A A' A'' : P.Opens} (i : Opposite.op U' ⟶ Opposite.op U)
      (e : A ≤ p ⁻¹ᵁ U) (j : Opposite.op A ⟶ Opposite.op A') (j' : Opposite.op A' ⟶ Opposite.op A'')
      (e' : A'' ≤ p ⁻¹ᵁ U'),
      Z.presheaf.map i ≫ (p.appLE U A e ≫ P.presheaf.map j) ≫ P.presheaf.map j' =
        p.appLE U' A'' e' := by
    intro U U' A A' A'' i e j j' e'
    rw [Category.assoc, ← Functor.map_comp, gen]
  have s1m : ∀ (W : (p ⁻¹ᵁ V).toScheme.Opens),
      (Scheme.ΓSpecIso Γ(Z, V)).inv ≫ ((p ∣_ V) ≫ hV.isoSpec.hom).appTop ≫
        (p ⁻¹ᵁ V).toScheme.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op =
      (p.app V ≫ P.presheaf.map (homOfLE (Scheme.Opens.ι_image_le (p ⁻¹ᵁ V) W)).op :
        Γ(Z, V) ⟶ Γ((p ⁻¹ᵁ V).toScheme, W)) := by
    intro W
    simp only [Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_hom_appTop, Category.assoc,
      Iso.inv_hom_id_assoc]
    rw [Scheme.Opens.topIso_inv, morphismRestrict_appTop, Scheme.Opens.toScheme_presheaf_map,
      Scheme.Hom.app_eq_appLE, Scheme.Hom.app_eq_appLE]
    exact (gen2 _ _ _ _ _).trans (Scheme.Hom.appLE_map _ _ _).symm
  have s1a : ∀ (W : (p ⁻¹ᵁ V).toScheme.Opens) (r : Γ(Z, V)),
      ((p ⁻¹ᵁ V).ι.appIso W).inv.hom (wcCnSigma ((p ∣_ V) ≫ hV.isoSpec.hom) W r) =
        (P.presheaf.map (homOfLE (Scheme.Opens.ι_image_le (p ⁻¹ᵁ V) W)).op).hom ((p.app V).hom r) := by
    intro W r
    rw [hinv]
    exact congrArg (fun k => k.hom r) (s1m W)
  have s1b : ∀ (W : (p ⁻¹ᵁ V).toScheme.Opens) (b : B),
      ((p ⁻¹ᵁ V).ι.appIso W).inv.hom
          (wcCnSigma ((p ∣_ V) ≫ hV.isoSpec.hom) W (wcCnSigma h V b)) =
        wcCnSigma (p ≫ h) ((p ⁻¹ᵁ V).ι ''ᵁ W) b := by
    intro W b
    rw [s1a]
    have key : h.appTop ≫ Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op ≫ p.app V ≫
        P.presheaf.map (homOfLE (Scheme.Opens.ι_image_le (p ⁻¹ᵁ V) W)).op =
        (p ≫ h).appTop ≫ P.presheaf.map (homOfLE (le_top : (p ⁻¹ᵁ V).ι ''ᵁ W ≤ ⊤)).op := by
      rw [Scheme.Hom.comp_appTop, Category.assoc, show p.appTop = p.app ⊤ from rfl,
        Scheme.Hom.app_eq_appLE, Scheme.Hom.app_eq_appLE]
      congr 1
      exact (gen _ _ _ _).trans (Scheme.Hom.appLE_map _ _ _).symm
    exact congrArg (fun k => k.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)) key


  have hinvC : ∀ (W : (p ⁻¹ᵁ V).toScheme.Opens) (a : Γ((p ⁻¹ᵁ V).toScheme, W)),
      ((p ⁻¹ᵁ V).ι.appIso W).inv a = a := hinv
  have s1aC : ∀ (W : (p ⁻¹ᵁ V).toScheme.Opens) (r : Γ(Z, V)),
      ((p ⁻¹ᵁ V).ι.appIso W).inv (wcCnSigma ((p ∣_ V) ≫ hV.isoSpec.hom) W r) =
        P.presheaf.map (homOfLE (Scheme.Opens.ι_image_le (p ⁻¹ᵁ V) W)).op (p.app V r) := s1a
  have resM : ∀ (M : P.Modules) {A A' A'' : P.Opens} (i : A' ⟶ A) (j : A'' ⟶ A') (s : Γ(M, A)),
      M.presheaf.map j.op (M.presheaf.map i.op s) = M.presheaf.map (j ≫ i).op s := by
    intro M A A' A'' i j s
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]; rfl
  have resP : ∀ {A A' A'' : P.Opens} (i : A' ⟶ A) (j : A'' ⟶ A') (s : Γ(P, A)),
      P.presheaf.map j.op (P.presheaf.map i.op s) = P.presheaf.map (j ≫ i).op s := by
    intro A A' A'' i j s
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]; rfl
  have idM : ∀ (M : P.Modules) {A : P.Opens} (i : A ⟶ A) (s : Γ(M, A)),
      M.presheaf.map i.op s = s := by
    intro M A i s
    rw [show i = 𝟙 A from rfl, op_id, CategoryTheory.Functor.map_id]; rfl
  have idP : ∀ {A : P.Opens} (i : A ⟶ A) (s : Γ(P, A)), P.presheaf.map i.op s = s := by
    intro A i s
    rw [show i = 𝟙 A from rfl, op_id, CategoryTheory.Functor.map_id]; rfl
  have resM' : ∀ (M : P.Modules) {A A' A'' : P.Opens} (h1 : A' ≤ A) (h2 : A'' ≤ A') (s : Γ(M, A)),
      M.presheaf.map (homOfLE h2).op (M.presheaf.map (homOfLE h1).op s) =
        M.presheaf.map (homOfLE (h2.trans h1)).op s := fun M _ _ _ h1 h2 s => resM M _ _ s
  have resP' : ∀ {A A' A'' : P.Opens} (h1 : A' ≤ A) (h2 : A'' ≤ A') (s : Γ(P, A)),
      P.presheaf.map (homOfLE h2).op (P.presheaf.map (homOfLE h1).op s) =
        P.presheaf.map (homOfLE (h2.trans h1)).op s := fun _ _ s => resP _ _ s
  have idM' : ∀ (M : P.Modules) {A : P.Opens} (h0 : A ≤ A) (s : Γ(M, A)),
      M.presheaf.map (homOfLE h0).op s = s := fun M _ _ s => idM M _ s
  have hinvP : ∀ (W : (p ⁻¹ᵁ V).toScheme.Opens) {A : P.Opens} (k : A ⟶ (p ⁻¹ᵁ V).ι ''ᵁ W)
      (a : Γ((p ⁻¹ᵁ V).toScheme, W)),
      P.presheaf.map k.op (((p ⁻¹ᵁ V).ι.appIso W).inv a) = P.presheaf.map k.op a := by
    intro W A k a; rw [hinvC]
  have injE : ∀ (M : P.Modules) (W : (p ⁻¹ᵁ V).toScheme.Opens),
      Function.Injective (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).hom := by
    intro M W a b hab
    have := congrArg (Scheme.Modules.restrictAppIso (p ⁻¹ᵁ V).ι M W).inv hab
    rwa [Iso.hom_inv_id_apply, Iso.hom_inv_id_apply] at this


  have transfer : ∀ (R R' M M' : Type u) [CommRing R] [CommRing R'] [AddCommGroup M] [Module R M]
      [AddCommGroup M'] [Module R' M'] (σ : B →+* R) (σ' : B →+* R') (E : M →+ M'),
      (∀ (b : B) (x : M), E (σ b • x) = σ' b • E x) → ∀ (J : Ideal B) (x : M),
      x ∈ Ideal.map σ J • (⊤ : Submodule R M) → E x ∈ Ideal.map σ' J • (⊤ : Submodule R' M') := by
    intro R R' M M' _ _ _ _ _ _ σ σ' E hE J x hx
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro a ha m hm
      clear hm
      have ha' : a ∈ Submodule.span R (σ '' (J : Set B)) := ha
      revert m
      refine Submodule.span_induction
        (p := fun a _ => ∀ m : M, E (a • m) ∈ Ideal.map σ' J • (⊤ : Submodule R' M'))
        ?_ ?_ ?_ ?_ ha'
      · rintro _ ⟨j, hj, rfl⟩ m
        rw [hE]
        exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem σ' hj) Submodule.mem_top
      · intro m; rw [zero_smul, map_zero]; exact Submodule.zero_mem _
      · intro a a' _ _ iha iha' m
        rw [add_smul, map_add]; exact Submodule.add_mem _ (iha m) (iha' m)
      · intro c a _ iha m
