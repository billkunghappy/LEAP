  have hJfg : ((wcCnComplIdeal U).ideal ⟨V, hV⟩).FG := IsNoetherian.noetherian _
  obtain ⟨t1, ht1⟩ := Ideal.exists_pow_le_of_le_radical_of_fg (I := (wcCnComplIdeal U).ideal ⟨V, hV⟩)
