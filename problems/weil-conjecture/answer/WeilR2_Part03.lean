  classical
  obtain ⟨i₀⟩ : Nonempty I := IsCofiltered.nonempty
  let P : (D.obj i₀).Opens → Prop := fun W => ∃ (k : I) (f : k ⟶ i₀) (A : (D.obj k).Opens) (O : V₀.Opens) (M : Scheme.{u}) (hM : M ⟶ (A : Scheme.{u})) (πO : (O : Scheme.{u}) ⟶ M), A = D.map f ⁻¹ᵁ W ∧ O = p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ W) ∧ IsAffineHom hM ∧ LocallyOfFinitePresentation hM ∧ IsPullback πO (O.ι ≫ p₀) (hM ≫ A.ι) (c.π.app k)
  have hP : P ⊤ := by
    refine compact_open_induction_on (P := P) ⊤ (by simpa using (hcpt i₀).isCompact_univ) ?_ ?_
    · exact wc_lim_affine_open_model I D c hc haff V₀ p₀ hp₀a hp₀l i₀ ⊥ (isAffineOpen_bot _)
