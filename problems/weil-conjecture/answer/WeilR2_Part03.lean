  obtain ⟨k, f, A, O, M, hM, πO, eA, eO, haM, hlM, sq⟩ := hP
  rw [Scheme.Hom.preimage_top] at eA
  rw [Scheme.Hom.preimage_top, Scheme.Hom.preimage_top] at eO
