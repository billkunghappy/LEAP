    let H : Z.Modules := SheafOfModules.mk Pm hsh
    let Θ : ∀ V : Z.Opens, Γ(H, V) →ₗ[Γ(Z, V)] (Γ(L', V) →ₗ[Γ(Z, V)] Γ(F, V)) := fun V =>
      { toFun := fun s => (s : S V).1 ⟨V, le_rfl⟩
