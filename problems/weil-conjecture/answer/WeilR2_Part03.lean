  have hLow : ∀ (k₁ k : I) (g : k ⟶ k₁) (A : (D.obj k₁).Opens) (O : V₀.Opens) (M : Scheme.{u}) (hM : M ⟶ (A : Scheme.{u})) (πO : (O : Scheme.{u}) ⟶ M), IsAffineHom hM → LocallyOfFinitePresentation hM → IsPullback πO (O.ι ≫ p₀) (hM ≫ A.ι) (c.π.app k₁) → ∃ πO' : (O : Scheme.{u}) ⟶ Limits.pullback hM (D.map g ∣_ A), IsAffineHom (Limits.pullback.snd hM (D.map g ∣_ A)) ∧ LocallyOfFinitePresentation (Limits.pullback.snd hM (D.map g ∣_ A)) ∧ IsPullback πO' (O.ι ≫ p₀) (Limits.pullback.snd hM (D.map g ∣_ A) ≫ (D.map g ⁻¹ᵁ A).ι) (c.π.app k) := by
    intro k₁ k g A O M hM πO ha hl sq
