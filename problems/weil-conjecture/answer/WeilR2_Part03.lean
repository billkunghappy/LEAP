      ConcreteCategory.congr_hom (NatTrans.congr_app
        ((sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).congr_map hfq)
        (Opposite.op (wcTorsorEt p ht.etale))) _
    rw [n1, hqs, map_add, hqs, n4, hνL c, hs₀', n2, h0c, map_add, n3]
