      · rw [← Scheme.Hom.comp_apply, hjV, Scheme.Hom.comp_apply] at hb
        obtain ⟨z, hz, -⟩ := s3b (πV v) b hb.symm
        have hv : v ∈ Set.range (Y.homOfLE (inf_le_left : V ⊓ U ≤ V)) := by
          rw [OV]; exact ⟨z, hz⟩
        obtain ⟨t, rfl⟩ := hv
