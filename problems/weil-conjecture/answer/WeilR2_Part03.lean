    rw [← Functor.map_comp]
    all_goals rfl
  have resId : ∀ (G : Z.Modules) (A : Z.Opens) (h : A ≤ A) (x : Γ(G, A)),
      (G.presheaf.map (homOfLE h).op).hom x = x := by
    intro G A h x
    have h' : (homOfLE h).op = 𝟙 (Opposite.op A) := rfl
    rw [h', CategoryTheory.Functor.map_id]
    all_goals rfl
  have smulG : ∀ (G : Z.Modules) {A B : Z.Opens} (h : B ≤ A) (r : Γ(Z, A)) (x : Γ(G, A)),
      (G.presheaf.map (homOfLE h).op).hom (r • x) =
      (Z.presheaf.map (homOfLE h).op).hom r • (G.presheaf.map (homOfLE h).op).hom x :=
    fun G _ _ h r x => Scheme.Modules.map_smul G (homOfLE h) r x
  have natApp : ∀ {M N : Z.Modules} (f : M ⟶ N) {A B : Z.Opens} (h : B ≤ A) (x : Γ(M, A)),
      Scheme.Modules.Hom.app f B ((M.presheaf.map (homOfLE h).op).hom x) =
      (N.presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app f A x) :=
    fun f _ _ h x => congrArg (fun k => k.hom x)
      ((Scheme.Modules.Hom.mapPresheaf f).naturality (homOfLE h).op)
  choose H Θ hnat hglue using objT Z L'
  have homOf : ∀ (M N : Z.Modules) (f : ∀ W : Z.Opens, Γ(M, W) →ₗ[Γ(Z, W)] Γ(N, W)),
      (∀ (W₁ W₂ : Z.Opens) (h : W₂ ≤ W₁) (x : Γ(M, W₁)),
        (N.presheaf.map (homOfLE h).op).hom (f W₁ x) = f W₂ ((M.presheaf.map (homOfLE h).op).hom x)) →
      ∃ a : M ⟶ N, ∀ (W : Z.Opens) (x : Γ(M, W)), Scheme.Modules.Hom.app a W x = f W x := by
    intro M N f hf
    let η : M.presheaf ⟶ N.presheaf :=
      { app := fun V => AddCommGrpCat.ofHom (f V.unop).toAddMonoidHom
        naturality := fun V W i => by
          ext x
          exact (hf V.unop W.unop (leOfHom i.unop) x).symm }
    exact ⟨{ val := PresheafOfModules.homMk η (fun V r x => (f V.unop).map_smul r x) },
      fun W x => rfl⟩
  have linex : ∀ (M N : Z.Modules) (φ : M ⟶ N) (W : Z.Opens),
      ∃ l : Γ(M, W) →ₗ[Γ(Z, W)] Γ(N, W), ∀ y, l y = Scheme.Modules.Hom.app φ W y :=
    fun M N φ W => ⟨{ toFun := fun y => Scheme.Modules.Hom.app φ W y
                      map_add' := fun y y' => map_add _ y y'
                      map_smul' := fun r y => Scheme.Modules.Hom.app_smul φ r y }, fun y => rfl⟩
  choose lin hlin using linex
  have TF : ∀ (F : Z.Modules) (V : Z.Opens) (s : Γ(H F, V)) (W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ V)
      (h₂ : W₂ ≤ W₁) (x : Γ(L', W₁)),
      (F.presheaf.map (homOfLE h₂).op).hom (Θ F W₁ (((H F).presheaf.map (homOfLE h₁).op).hom s) x) =
        Θ F W₂ (((H F).presheaf.map (homOfLE (h₂.trans h₁)).op).hom s)
          ((L'.presheaf.map (homOfLE h₂).op).hom x) := by
    intro F V s W₁ W₂ h₁ h₂ x
    rw [← hnat F W₁ W₂ h₂, resG]
  have DET : ∀ (F : Z.Modules) (V : Z.Opens) (s s' : Γ(H F, V)),
      (∀ (W : Z.Opens) (hW : W ≤ V), Θ F W (((H F).presheaf.map (homOfLE hW).op).hom s) =
        Θ F W (((H F).presheaf.map (homOfLE hW).op).hom s')) → s = s' := by
    intro F V s s' h
    exact (hglue F V (fun W hW => Θ F W (((H F).presheaf.map (homOfLE hW).op).hom s))
      (TF F V s)).unique (fun W hW => rfl) (fun W hW => (h W hW).symm)
  have hσ : ∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (s : Γ(H F, V)) (W₁ W₂ : Z.Opens)
      (h₁ : W₁ ≤ V) (h₂ : W₂ ≤ W₁) (x : Γ(L', W₁)),
      (G.presheaf.map (homOfLE h₂).op).hom
          (((lin F G φ W₁).comp (Θ F W₁ (((H F).presheaf.map (homOfLE h₁).op).hom s))) x) =
        ((lin F G φ W₂).comp (Θ F W₂ (((H F).presheaf.map (homOfLE (h₂.trans h₁)).op).hom s)))
          ((L'.presheaf.map (homOfLE h₂).op).hom x) := by
    intro F G φ V s W₁ W₂ h₁ h₂ x
    rw [LinearMap.comp_apply, LinearMap.comp_apply, hlin, hlin, ← natApp, TF]
  have cex : ∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (s : Γ(H F, V)),
      ∃ c : Γ(H G, V), ∀ (W : Z.Opens) (hW : W ≤ V),
        Θ G W (((H G).presheaf.map (homOfLE hW).op).hom c) =
          (lin F G φ W).comp (Θ F W (((H F).presheaf.map (homOfLE hW).op).hom s)) :=
    fun F G φ V s => (hglue G V _ (hσ F G φ V s)).exists
  choose c hc using cex
  have c_add : ∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (s t : Γ(H F, V)),
      c F G φ V (s + t) = c F G φ V s + c F G φ V t := by
    intro F G φ V s t
    apply DET
    intro W hW
    rw [map_add, map_add, hc, hc, hc, map_add, map_add, LinearMap.comp_add]
  have c_smul : ∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (r : Γ(Z, V)) (s : Γ(H F, V)),
      c F G φ V (r • s) = r • c F G φ V s := by
    intro F G φ V r s
    apply DET
    intro W hW
    apply LinearMap.ext
    intro x
    have e1 : ((H F).presheaf.map (homOfLE hW).op).hom (r • s) =
        (Z.presheaf.map (homOfLE hW).op).hom r • ((H F).presheaf.map (homOfLE hW).op).hom s :=
      smulG (H F) hW r s
    have e2 : ((H G).presheaf.map (homOfLE hW).op).hom (r • c F G φ V s) =
        (Z.presheaf.map (homOfLE hW).op).hom r •
          ((H G).presheaf.map (homOfLE hW).op).hom (c F G φ V s) :=
      smulG (H G) hW r (c F G φ V s)
    rw [hc, e1, e2, map_smul, map_smul, LinearMap.smul_apply, hc, LinearMap.comp_apply,
      LinearMap.comp_apply, LinearMap.smul_apply, hlin, hlin, Scheme.Modules.Hom.app_smul]
  have c_nat : ∀ (F G : Z.Modules) (φ : F ⟶ G) (V V' : Z.Opens) (hV : V' ≤ V) (s : Γ(H F, V)),
      ((H G).presheaf.map (homOfLE hV).op).hom (c F G φ V s) =
        c F G φ V' (((H F).presheaf.map (homOfLE hV).op).hom s) := by
    intro F G φ V V' hV s
    apply DET
    intro W hW
    rw [resG, hc, hc, resG]
  have mpex : ∀ (F G : Z.Modules) (φ : F ⟶ G), ∃ a : H F ⟶ H G,
      ∀ (W : Z.Opens) (s : Γ(H F, W)), Scheme.Modules.Hom.app a W s = c F G φ W s :=
    fun F G φ => homOf (H F) (H G)
      (fun W => { toFun := c F G φ W, map_add' := c_add F G φ W, map_smul' := c_smul F G φ W })
      (fun W₁ W₂ h x => c_nat F G φ W₁ W₂ h x)
  choose mp hmp using mpex
  have hmpΘ : ∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (s : Γ(H F, V)) (W : Z.Opens)
      (hW : W ≤ V),
      Θ G W (((H G).presheaf.map (homOfLE hW).op).hom (Scheme.Modules.Hom.app (mp F G φ) V s)) =
        (lin F G φ W).comp (Θ F W (((H F).presheaf.map (homOfLE hW).op).hom s)) := by
    intro F G φ V s W hW
    rw [hmp]
    exact hc F G φ V s W hW
  have hid : ∀ F : Z.Modules, mp F F (𝟙 F) = 𝟙 (H F) := by
    intro F
    apply Scheme.Modules.hom_ext
    intro V
    refine ConcreteCategory.hom_ext _ _ (fun y => ?_)
    show Scheme.Modules.Hom.app (mp F F (𝟙 F)) V y = Scheme.Modules.Hom.app (𝟙 (H F)) V y
    rw [Scheme.Modules.Hom.id_app]
    apply DET
    intro W hW
    rw [hmpΘ]
    apply LinearMap.ext
    intro x
    rw [LinearMap.comp_apply, hlin, Scheme.Modules.Hom.id_app]
    rfl
  have hcomp : ∀ (F G K : Z.Modules) (φ : F ⟶ G) (ψ : G ⟶ K),
      mp F K (φ ≫ ψ) = mp F G φ ≫ mp G K ψ := by
    intro F G K φ ψ
    apply Scheme.Modules.hom_ext
    intro V
    refine ConcreteCategory.hom_ext _ _ (fun y => ?_)
    rw [Scheme.Modules.Hom.comp_app]
    show Scheme.Modules.Hom.app (mp F K (φ ≫ ψ)) V y =
      Scheme.Modules.Hom.app (mp G K ψ) V (Scheme.Modules.Hom.app (mp F G φ) V y)
    apply DET
    intro W hW
    rw [hmpΘ, hmpΘ, hmpΘ]
    apply LinearMap.ext
    intro x
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, hlin, hlin, hlin,
      Scheme.Modules.Hom.comp_app]
    rfl
  have hΘmp : ∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (s : Γ(H F, V)) (x : Γ(L', V)),
      Θ G V (Scheme.Modules.Hom.app (mp F G φ) V s) x = Scheme.Modules.Hom.app φ V (Θ F V s x) := by
    intro F G φ V s x
    have h := hmpΘ F G φ V s V le_rfl
    rw [resId, resId] at h
    rw [h, LinearMap.comp_apply, hlin]
  have fex : ∀ (F : Z.Modules) (a : L' ⟶ F), ∃ s : Γ(H F, ⊤), ∀ (W : Z.Opens) (hW : W ≤ ⊤),
      Θ F W (((H F).presheaf.map (homOfLE hW).op).hom s) = lin L' F a W := by
    intro F a
    refine (hglue F ⊤ (fun W _ => lin L' F a W) ?_).exists
    intro W₁ W₂ h₁ h₂ x
    rw [hlin, hlin]
    exact (natApp a h₂ x).symm
  choose fwd hfwd using fex
  have bex : ∀ (F : Z.Modules) (s : Γ(H F, ⊤)), ∃ b : L' ⟶ F, ∀ (W : Z.Opens) (x : Γ(L', W)),
      Scheme.Modules.Hom.app b W x =
        Θ F W (((H F).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom s) x :=
    fun F s => homOf L' F (fun W => Θ F W (((H F).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom s))
      (fun W₁ W₂ h x => TF F ⊤ s W₁ W₂ le_top h x)
  choose bwd hbwd using bex
  have linv : ∀ (F : Z.Modules) (a : L' ⟶ F), bwd F (fwd F a) = a := by
    intro F a
    apply Scheme.Modules.hom_ext
    intro V
    refine ConcreteCategory.hom_ext _ _ (fun y => ?_)
    rw [hbwd, hfwd, hlin]
  have rinv : ∀ (F : Z.Modules) (s : Γ(H F, ⊤)), fwd F (bwd F s) = s := by
    intro F s
    apply DET
    intro W hW
    rw [hfwd]
    apply LinearMap.ext
    intro x
    rw [hlin, hbwd]
  have h4 : ∀ (F G : Z.Modules) (φ : F ⟶ G) (a : L' ⟶ F),
      Scheme.Modules.Hom.app (mp F G φ) ⊤ (fwd F a) = fwd G (a ≫ φ) := by
    intro F G φ a
    apply DET
    intro W hW
    rw [hmpΘ, hfwd, hfwd]
    apply LinearMap.ext
    intro x
    rw [LinearMap.comp_apply, hlin, hlin, hlin, Scheme.Modules.Hom.comp_app]
    rfl
  let Hm : Z.Modules ⥤ Z.Modules :=
    { obj := H
      map := fun {F G} φ => mp F G φ
      map_id := hid
      map_comp := fun {F G K} φ ψ => hcomp F G K φ ψ }
  let eqv : ∀ F : Z.Modules, (L' ⟶ F) ≃ Γ(Hm.obj F, ⊤) := fun F =>
    { toFun := fwd F
      invFun := bwd F
      left_inv := linv F
      right_inv := rinv F }
  exact ⟨Hm, Θ, eqv, hnat, hglue, hΘmp, h4⟩

theorem wc_cn_qcoh_affine_hom_extend : ∀ (Z : Scheme.{u}) (L' F : Z.Modules) (W : Z.Opens), IsAffineOpen W → wcQcoh L' → ∀ φ : Γ(L', W) →ₗ[Γ(Z, W)] Γ(F, W), ∃! f : ∀ W' : Z.Opens, W' ≤ W → (Γ(L', W') →ₗ[Γ(Z, W')] Γ(F, W')), (∀ (W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ W) (h₂ : W₂ ≤ W₁) (x : Γ(L', W₁)), (F.presheaf.map (homOfLE h₂).op).hom (f W₁ h₁ x) = f W₂ (h₂.trans h₁) ((L'.presheaf.map (homOfLE h₂).op).hom x)) ∧ f W le_rfl = φ :=
by
  intro Z L' F W hW hq φ

  have resL : ∀ (A B C : Z.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(L', A)),
      (L'.presheaf.map (homOfLE h2).op).hom ((L'.presheaf.map (homOfLE h1).op).hom x) =
      (L'.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have resF : ∀ (A B C : Z.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(F, A)),
      (F.presheaf.map (homOfLE h2).op).hom ((F.presheaf.map (homOfLE h1).op).hom x) =
      (F.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have resZ : ∀ (A B C : Z.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(Z, A)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have smulL : ∀ (A B : Z.Opens) (h1 : B ≤ A) (a : Γ(Z, A)) (x : Γ(L', A)),
      (L'.presheaf.map (homOfLE h1).op).hom (a • x) =
      (Z.presheaf.map (homOfLE h1).op).hom a • (L'.presheaf.map (homOfLE h1).op).hom x :=
    fun A B h1 a x => Scheme.Modules.map_smul L' (homOfLE h1) a x
  have smulF : ∀ (A B : Z.Opens) (h1 : B ≤ A) (a : Γ(Z, A)) (x : Γ(F, A)),
      (F.presheaf.map (homOfLE h1).op).hom (a • x) =
      (Z.presheaf.map (homOfLE h1).op).hom a • (F.presheaf.map (homOfLE h1).op).hom x :=
    fun A B h1 a x => Scheme.Modules.map_smul F (homOfLE h1) a x
  have hunit : ∀ g : Γ(Z, W), IsUnit ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) :=
    fun g => RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g
  have resU : ∀ (g : Γ(Z, W)) (D : Z.Opens) (h : D ≤ Z.basicOpen g) (h' : D ≤ W) (k : ℕ),
      (Z.presheaf.map (homOfLE h').op).hom (g ^ k) = (Z.presheaf.map (homOfLE h).op).hom
        (((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k) := by
    intro g D h h' k
    rw [map_pow, map_pow, resZ _ _ _ (Z.basicOpen_le g) h h']
  have unitO : ∀ (g : Γ(Z, W)) (D : Z.Opens) (h : D ≤ Z.basicOpen g) (h' : D ≤ W) (k : ℕ),
      IsUnit ((Z.presheaf.map (homOfLE h').op).hom (g ^ k)) := by
    intro g D h h' k
    rw [resU g D h h' k]
    exact ((hunit g).pow k).map (Z.presheaf.map (homOfLE h).op).hom
  have restrictEqL : ∀ (V : Z.Opens) (y : Γ(L', V)) (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V)
      (D : Z.Opens) (h : D ≤ Z.basicOpen g) (hDV : D ≤ V) (h' : D ≤ W) (k : ℕ) (t : Γ(L', W)),
      ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k •
          (L'.presheaf.map (homOfLE hg).op).hom y =
        (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t →
      (Z.presheaf.map (homOfLE h').op).hom (g ^ k) • (L'.presheaf.map (homOfLE hDV).op).hom y =
        (L'.presheaf.map (homOfLE h').op).hom t := by
    intro V y g hg D h hDV h' k t e
    rw [resU g D h h' k, ← resL _ _ _ hg h hDV, ← smulL, e, resL _ _ _ (Z.basicOpen_le g) h h']
  have restrictEqF : ∀ (g : Γ(Z, W)) (D : Z.Opens) (h : D ≤ Z.basicOpen g) (h' : D ≤ W) (k : ℕ)
      (w : Γ(F, Z.basicOpen g)) (t : Γ(L', W)),
      ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • w =
        (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t) →
      (Z.presheaf.map (homOfLE h').op).hom (g ^ k) • (F.presheaf.map (homOfLE h).op).hom w =
        (F.presheaf.map (homOfLE h').op).hom (φ t) := by
    intro g D h h' k w t e
    rw [resU g D h h' k, ← smulF, e, resF _ _ _ (Z.basicOpen_le g) h h']

  have cover : ∀ (V : Z.Opens), V ≤ W →
      V ≤ iSup (fun i : {g : Γ(Z, W) // Z.basicOpen g ≤ V} => Z.basicOpen i.1) := by
    intro V hV x hx
    obtain ⟨g, hg, hxg⟩ := hW.exists_basicOpen_le ⟨x, hx⟩ (hV hx)
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hg⟩, hxg⟩
  have sepF : ∀ (V : Z.Opens) (hV : V ≤ W) (s s' : Γ(F, V)),
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V),
        (F.presheaf.map (homOfLE hg).op).hom s = (F.presheaf.map (homOfLE hg).op).hom s') →
      s = s' := by
    intro V hV s s' h
    exact TopCat.Sheaf.eq_of_locally_eq' (⟨F.presheaf, F.isSheaf⟩ : TopCat.Sheaf Ab Z) _ V
      (fun i => homOfLE i.2) (cover V hV) s s' (fun i => h i.1 i.2)

  have hLOC : ∀ (V : Z.Opens) (hV : V ≤ W) (z : Γ(L', W)),
      (L'.presheaf.map (homOfLE hV).op).hom z = 0 →
      (F.presheaf.map (homOfLE hV).op).hom (φ z) = 0 := by
    intro V hV z hz
    refine sepF V hV _ _ (fun g hg => ?_)
    rw [map_zero, resF _ _ _ hV hg (Z.basicOpen_le g)]
    have hz' : (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom z = 0 := by
      rw [← resL _ _ _ hV hg (Z.basicOpen_le g), hz, map_zero]
    obtain ⟨n, hn⟩ := (hq W hW g).2 z hz'
    have h1 : ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ n •
        (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ z) = 0 := by
      rw [← map_pow, ← smulF, ← map_smul φ, hn, map_zero, map_zero]
    exact ((hunit g).pow n).smul_left_cancel.mp (h1.trans (smul_zero _).symm)

  have hXP : ∀ (D : Z.Opens) (hD : D ≤ W) (a a' : Γ(Z, W)) (y : Γ(L', D)) (t t' : Γ(L', W))
      (w : Γ(F, D)),
      IsUnit ((Z.presheaf.map (homOfLE hD).op).hom a) →
      (Z.presheaf.map (homOfLE hD).op).hom a • y = (L'.presheaf.map (homOfLE hD).op).hom t →
      (Z.presheaf.map (homOfLE hD).op).hom a' • y = (L'.presheaf.map (homOfLE hD).op).hom t' →
      (Z.presheaf.map (homOfLE hD).op).hom a • w = (F.presheaf.map (homOfLE hD).op).hom (φ t) →
      (Z.presheaf.map (homOfLE hD).op).hom a' • w =
        (F.presheaf.map (homOfLE hD).op).hom (φ t') := by
    intro D hD a a' y t t' w ha h1 h2 h3
    have hz : (L'.presheaf.map (homOfLE hD).op).hom (a' • t - a • t') = 0 := by
      rw [map_sub, smulL, smulL, ← h1, ← h2, smul_smul, smul_smul, mul_comm, sub_self]
    have hφz := hLOC D hD _ hz
    rw [map_sub φ, map_smul φ, map_smul φ, map_sub, smulF, smulF, sub_eq_zero] at hφz
    apply ha.smul_left_cancel.mp
    rw [smul_smul, mul_comm, ← smul_smul, h3, hφz]

  have hBRu : ∀ (V : Z.Opens) (hV : V ≤ W) (y : Γ(L', V)) (s s' : Γ(F, V)),
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom s = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) →
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom s' = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) →
      s = s' := by
    intro V hV y s s' hs hs'
    refine sepF V hV s s' (fun g hg => ?_)
    obtain ⟨k, t, h1, h2⟩ := hs g hg
    obtain ⟨k', t', h1', h2'⟩ := hs' g hg
    have e := hXP (Z.basicOpen g) (Z.basicOpen_le g) (g ^ k) (g ^ k')
      ((L'.presheaf.map (homOfLE hg).op).hom y) t t' ((F.presheaf.map (homOfLE hg).op).hom s)
      (by rw [map_pow]; exact (hunit g).pow k) (by rw [map_pow]; exact h1)
      (by rw [map_pow]; exact h1') (by rw [map_pow]; exact h2)
    rw [map_pow] at e
    exact ((hunit g).pow k').smul_left_cancel.mp (e.trans h2'.symm)

  have hBRe : ∀ (V : Z.Opens) (hV : V ≤ W) (y : Γ(L', V)), ∃ s : Γ(F, V),
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom s = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) := by
    intro V hV y
    have hA : ∀ i : {g : Γ(Z, W) // Z.basicOpen g ≤ V}, ∃ (k : ℕ) (t : Γ(L', W)),
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le i.1)).op).hom i.1) ^ k •
          (L'.presheaf.map (homOfLE i.2).op).hom y =
        (L'.presheaf.map (homOfLE (Z.basicOpen_le i.1)).op).hom t :=
      fun i => (hq W hW i.1).1 _
    choose k t ht using hA
    let v : ∀ i : {g : Γ(Z, W) // Z.basicOpen g ≤ V}, Γ(F, Z.basicOpen i.1) := fun i =>
      ((((hunit i.1).pow (k i)).unit⁻¹ : (Γ(Z, Z.basicOpen i.1))ˣ) : Γ(Z, Z.basicOpen i.1)) •
        (F.presheaf.map (homOfLE (Z.basicOpen_le i.1)).op).hom (φ (t i))
    have hv : ∀ i, ((Z.presheaf.map (homOfLE (Z.basicOpen_le i.1)).op).hom i.1) ^ (k i) • v i =
        (F.presheaf.map (homOfLE (Z.basicOpen_le i.1)).op).hom (φ (t i)) := by
      intro i
      simp only [v]
      rw [smul_smul, IsUnit.mul_val_inv, one_smul]
    have hcompat : TopCat.Presheaf.IsCompatible (⟨F.presheaf, F.isSheaf⟩ : TopCat.Sheaf Ab Z).obj
        (fun i : {g : Γ(Z, W) // Z.basicOpen g ≤ V} => Z.basicOpen i.1) v := by
      intro i j
      have hOi : Z.basicOpen i.1 ⊓ Z.basicOpen j.1 ≤ Z.basicOpen i.1 := inf_le_left
      have hOj : Z.basicOpen i.1 ⊓ Z.basicOpen j.1 ≤ Z.basicOpen j.1 := inf_le_right
      have hOV : Z.basicOpen i.1 ⊓ Z.basicOpen j.1 ≤ V := hOi.trans i.2
      have hOW : Z.basicOpen i.1 ⊓ Z.basicOpen j.1 ≤ W := hOi.trans (Z.basicOpen_le i.1)
      change (F.presheaf.map (homOfLE hOi).op).hom (v i) =
        (F.presheaf.map (homOfLE hOj).op).hom (v j)
      have e := hXP _ hOW (i.1 ^ k i) (j.1 ^ k j) ((L'.presheaf.map (homOfLE hOV).op).hom y)
        (t i) (t j) ((F.presheaf.map (homOfLE hOi).op).hom (v i))
        (unitO i.1 _ hOi hOW (k i))
        (restrictEqL V y i.1 i.2 _ hOi hOV hOW (k i) (t i) (ht i))
        (restrictEqL V y j.1 j.2 _ hOj hOV hOW (k j) (t j) (ht j))
        (restrictEqF i.1 _ hOi hOW (k i) (v i) (t i) (hv i))
      exact (unitO j.1 _ hOj hOW (k j)).smul_left_cancel.mp
        (e.trans (restrictEqF j.1 _ hOj hOW (k j) (v j) (t j) (hv j)).symm)
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨F.presheaf, F.isSheaf⟩ : TopCat.Sheaf Ab Z) _ V (fun i => homOfLE i.2) (cover V hV) v hcompat
    refine ⟨s, fun g hg => ⟨k ⟨g, hg⟩, t ⟨g, hg⟩, ht ⟨g, hg⟩, ?_⟩⟩
    have hsi : (F.presheaf.map (homOfLE hg).op).hom s = v ⟨g, hg⟩ := hs ⟨g, hg⟩
    rw [hsi]
    exact hv ⟨g, hg⟩

  have hBRadd : ∀ (V : Z.Opens) (y y' : Γ(L', V)) (s s' : Γ(F, V)),
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom s = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) →
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y' = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom s' = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) →
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom (y + y') = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom (s + s') = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) := by
    intro V y y' s s' hs hs' g hg
    obtain ⟨k, t, h1, h2⟩ := hs g hg
    obtain ⟨k', t', h1', h2'⟩ := hs' g hg
    obtain ⟨U, hU⟩ : ∃ U, (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g = U := ⟨_, rfl⟩
    rw [hU] at h1 h2 h1' h2'
    refine ⟨k + k', g ^ k' • t + g ^ k • t', ?_, ?_⟩
    · rw [hU, map_add (L'.presheaf.map (homOfLE hg).op).hom, smul_add, map_add,
        smulL W _ (Z.basicOpen_le g) (g ^ k') t, smulL W _ (Z.basicOpen_le g) (g ^ k) t',
        map_pow, map_pow, hU, ← h1, ← h1', smul_smul, smul_smul, ← pow_add, ← pow_add,
        add_comm k' k]
    · rw [hU, map_add (F.presheaf.map (homOfLE hg).op).hom, smul_add, map_add φ, map_smul φ,
        map_smul φ, map_add, smulF W _ (Z.basicOpen_le g) (g ^ k') (φ t),
        smulF W _ (Z.basicOpen_le g) (g ^ k) (φ t'),
        map_pow, map_pow, hU, ← h2, ← h2', smul_smul, smul_smul, ← pow_add, ← pow_add,
        add_comm k' k]
  have hBRsmul : ∀ (V : Z.Opens) (y : Γ(L', V)) (s : Γ(F, V)) (c : Γ(Z, V)),
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom s = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) →
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom (c • y) = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom (c • s) = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) := by
    intro V y s c hs g hg
    obtain ⟨k, t, h1, h2⟩ := hs g hg
    have := hW.isLocalization_basicOpen g
    obtain ⟨x, hx⟩ := IsLocalization.surj (Submonoid.powers g)
      ((Z.presheaf.map (homOfLE hg).op).hom c)
    obtain ⟨j, hj⟩ := (Submonoid.mem_powers_iff _ _).mp x.2.2
    have hcm : (Z.presheaf.map (homOfLE hg).op).hom c *
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ j =
        (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom x.1 := by
      rw [← map_pow, hj]; exact hx
    have hring : ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ (j + k) *
        (Z.presheaf.map (homOfLE hg).op).hom c =
        ((Z.presheaf.map (homOfLE hg).op).hom c *
          ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ j) *
          ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k := by ring
    refine ⟨j + k, x.1 • t, ?_, ?_⟩
    · rw [smulL V (Z.basicOpen g) hg c y, smul_smul, hring, hcm, mul_smul, h1,
        ← smulL W (Z.basicOpen g) (Z.basicOpen_le g) x.1 t]
    · rw [smulF V (Z.basicOpen g) hg c s, smul_smul, hring, hcm, mul_smul, h2, map_smul φ,
        smulF W (Z.basicOpen g) (Z.basicOpen_le g) x.1 (φ t)]

  have hBRres : ∀ (V₁ V₂ : Z.Opens) (h₂ : V₂ ≤ V₁) (y : Γ(L', V₁)) (s : Γ(F, V₁)),
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V₁), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom s = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) →
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V₂), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom ((L'.presheaf.map (homOfLE h₂).op).hom y) = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom ((F.presheaf.map (homOfLE h₂).op).hom s) = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) := by
    intro V₁ V₂ h₂ y s hs g hg
    obtain ⟨k, t, h1, h2⟩ := hs g (hg.trans h₂)
    refine ⟨k, t, ?_, ?_⟩
    · rw [resL _ _ _ h₂ hg (hg.trans h₂)]; exact h1
    · rw [resF _ _ _ h₂ hg (hg.trans h₂)]; exact h2

  have hfamBR : ∀ (f : ∀ W' : Z.Opens, W' ≤ W → (Γ(L', W') →ₗ[Γ(Z, W')] Γ(F, W'))),
      (∀ (W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ W) (h₂ : W₂ ≤ W₁) (x : Γ(L', W₁)), (F.presheaf.map (homOfLE h₂).op).hom (f W₁ h₁ x) = f W₂ (h₂.trans h₁) ((L'.presheaf.map (homOfLE h₂).op).hom x)) →
      f W le_rfl = φ → ∀ (V : Z.Opens) (hV : V ≤ W) (y : Γ(L', V)),
      (∀ (g : Γ(Z, W)) (hg : Z.basicOpen g ≤ V), ∃ (k : ℕ) (t : Γ(L', W)), ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (L'.presheaf.map (homOfLE hg).op).hom y = (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom t ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ k • (F.presheaf.map (homOfLE hg).op).hom (f V hV y) = (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom (φ t)) := by
    intro f hc htop V hV y g hg
    obtain ⟨k, t, ht⟩ := (hq W hW g).1 ((L'.presheaf.map (homOfLE hg).op).hom y)
    refine ⟨k, t, ht, ?_⟩
    rw [hc V (Z.basicOpen g) hV hg y, ← map_smul (f (Z.basicOpen g) (hg.trans hV)), ht,
      ← hc W (Z.basicOpen g) le_rfl (Z.basicOpen_le g) t, htop]

  choose S hS using hBRe
  let f : ∀ W' : Z.Opens, W' ≤ W → (Γ(L', W') →ₗ[Γ(Z, W')] Γ(F, W')) := fun V hV =>
    { toFun := S V hV
      map_add' := fun y y' => hBRu V hV (y + y') _ _ (hS V hV (y + y'))
        (hBRadd V y y' _ _ (hS V hV y) (hS V hV y'))
      map_smul' := fun c y => hBRu V hV (c • y) _ _ (hS V hV (c • y))
        (hBRsmul V y _ c (hS V hV y)) }
  refine ⟨f, ⟨?_, ?_⟩, ?_⟩
  · intro W₁ W₂ h₁ h₂ x
    exact hBRu W₂ (h₂.trans h₁) _ _ _ (hBRres W₁ W₂ h₂ x _ (hS W₁ h₁ x))
      (hS W₂ (h₂.trans h₁) _)
  · apply LinearMap.ext
    intro y
    refine hBRu W le_rfl y _ _ (hS W le_rfl y) (fun g hg => ⟨0, y, ?_, ?_⟩)
    · rw [pow_zero, one_smul]
    · rw [pow_zero, one_smul]
  · rintro f' ⟨hc', htop'⟩
    funext V hV
    apply LinearMap.ext
    intro y
    exact hBRu V hV y _ _ (hfamBR f' hc' htop' V hV y) (hS V hV y)

theorem wc_cn_locfree_affine_projective : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (L' : Z.Modules), wcCnLocFree L' → ∀ W : Z.Opens, IsAffineOpen W → Module.Projective Γ(Z, W) Γ(L', W) ∧ Module.Finite Γ(Z, W) Γ(L', W) ∧ Module.FinitePresentation Γ(Z, W) Γ(L', W) :=
by
  intro Z _ L' hL' W hW
  classical
  have hq : wcQcoh L' := hL'.1.1
  haveI hnoeth : IsNoetherianRing Γ(Z, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  haveI hfin : Module.Finite Γ(Z, W) Γ(L', W) := hL'.1.2 W hW
  haveI hfp : Module.FinitePresentation Γ(Z, W) Γ(L', W) :=
    Module.finitePresentation_of_finite _ _

  have hloc : ∀ f : Γ(Z, W), Module.Flat Γ(Z, Z.basicOpen f) Γ(L', Z.basicOpen f) →
      Module.Flat Γ(Z, W) (LocalizedModule.Away f Γ(L', W)) := by
    intro f hflat
    haveI := hflat
    letI : Module Γ(Z, W) Γ(L', Z.basicOpen f) :=
      Module.compHom _ (algebraMap Γ(Z, W) Γ(Z, Z.basicOpen f))
    haveI : IsScalarTower Γ(Z, W) Γ(Z, Z.basicOpen f) Γ(L', Z.basicOpen f) :=
      IsScalarTower.of_algebraMap_smul (fun r y => rfl)
    haveI := hW.isLocalization_basicOpen f
    haveI : Module.Flat Γ(Z, W) Γ(Z, Z.basicOpen f) :=
      IsLocalization.flat _ (Submonoid.powers f)
    haveI : Module.Flat Γ(Z, W) Γ(L', Z.basicOpen f) :=
      Module.Flat.trans Γ(Z, W) Γ(Z, Z.basicOpen f) _
    let ρ : Γ(L', W) →ₗ[Γ(Z, W)] Γ(L', Z.basicOpen f) :=
      { toFun := fun x => (L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun c x => Scheme.Modules.map_smul L' (homOfLE (Z.basicOpen_le f)) c x }
    haveI : IsLocalizedModule (Submonoid.powers f) ρ := by
      refine IsLocalizedModule.mk ?_ ?_ ?_
      · rintro ⟨x, n, rfl⟩
        have hu : IsUnit (algebraMap Γ(Z, W) Γ(Z, Z.basicOpen f) (f ^ n)) := by
          rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit f).pow n
        obtain ⟨u, hu'⟩ := hu
        rw [Module.End.isUnit_iff]
        have key : ∀ y : Γ(L', Z.basicOpen f),
            (algebraMap Γ(Z, W) (Module.End Γ(Z, W) Γ(L', Z.basicOpen f)) (f ^ n)) y =
              (u : Γ(Z, Z.basicOpen f)) • y := by
          intro y
          rw [Module.algebraMap_end_apply, hu']
          rfl
        constructor
        · intro y y' h
          rw [key, key] at h
          have h2 := congrArg (fun z => ((u⁻¹ : (Γ(Z, Z.basicOpen f))ˣ) : Γ(Z, Z.basicOpen f)) • z) h
          simp only [smul_smul, Units.inv_mul, one_smul] at h2
          exact h2
        · intro y
          refine ⟨((u⁻¹ : (Γ(Z, Z.basicOpen f))ˣ) : Γ(Z, Z.basicOpen f)) • y, ?_⟩
          rw [key, smul_smul, Units.mul_inv, one_smul]
      · intro y
        obtain ⟨n, t, ht⟩ := (hq W hW f).1 y
        refine ⟨⟨t, ⟨f ^ n, n, rfl⟩⟩, ?_⟩
        change algebraMap Γ(Z, W) Γ(Z, Z.basicOpen f) (f ^ n) • y =
          (L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t
        rw [← ht, map_pow]
        rfl
      · intro x₁ x₂ h
        have h0 : (L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (x₁ - x₂) = 0 := by
          rw [map_sub]; exact sub_eq_zero.mpr h
        obtain ⟨n, hn⟩ := (hq W hW f).2 _ h0
        refine ⟨⟨f ^ n, n, rfl⟩, ?_⟩
        change f ^ n • x₁ = f ^ n • x₂
        rw [← sub_eq_zero, ← smul_sub]
        exact hn
    exact Module.Flat.of_linearEquiv (IsLocalizedModule.iso (Submonoid.powers f) ρ)

  let S : Set Γ(Z, W) := {f | Module.Flat Γ(Z, Z.basicOpen f) Γ(L', Z.basicOpen f)}
  have hS : Ideal.span S = ⊤ := by
    rw [← hW.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨O, r, ε, hxO, -, hb⟩ := hL'.2 x
    obtain ⟨f, hfO, hxf⟩ := hW.exists_basicOpen_le (V := O) ⟨x, hxO⟩ hx
    have hfS : f ∈ S := by
      show Module.Flat Γ(Z, Z.basicOpen f) Γ(L', Z.basicOpen f)
      let Lm : (Fin r → Γ(Z, Z.basicOpen f)) →ₗ[Γ(Z, Z.basicOpen f)] Γ(L', Z.basicOpen f) :=
        { toFun := fun a => ∑ i, a i • (L'.presheaf.map (homOfLE hfO).op).hom (ε i)
          map_add' := fun a b => by
            simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
          map_smul' := fun c a => by
            simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
      have e := LinearEquiv.ofBijective Lm (hb _ hfO)
      haveI : Module.Free Γ(Z, Z.basicOpen f) Γ(L', Z.basicOpen f) := Module.Free.of_equiv e
      exact Module.Flat.of_free
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hfS⟩, hxf⟩

  haveI hflat : Module.Flat Γ(Z, W) Γ(L', W) :=
    Module.flat_of_localized_span _ _ S hS (fun r => hloc r.1 r.2)
  exact ⟨Module.Flat.projective_of_finitePresentation, hfin, hfp⟩

theorem wc_cn_hom_qcoh_of_affine_bij : ∀ (Z : Scheme.{u}) (L' F H : Z.Modules) (Θ : ∀ V : Z.Opens, Γ(H, V) →ₗ[Γ(Z, V)] (Γ(L', V) →ₗ[Γ(Z, V)] Γ(F, V))), wcQcoh L' → wcQcoh F → (∀ V : Z.Opens, IsAffineOpen V → Module.FinitePresentation Γ(Z, V) Γ(L', V)) → (∀ V : Z.Opens, IsAffineOpen V → Function.Bijective (Θ V)) → (∀ (V V' : Z.Opens) (hV : V' ≤ V) (s : Γ(H, V)) (x : Γ(L', V)), Θ V' ((H.presheaf.map (homOfLE hV).op).hom s) ((L'.presheaf.map (homOfLE hV).op).hom x) = (F.presheaf.map (homOfLE hV).op).hom (Θ V s x)) → wcQcoh H :=
by
  intro Z L' F H Θ hL' hF hFP hbij nat
  classical
  intro U hU f
  have := hFP U hU
  obtain ⟨k, p, hspan⟩ := Module.Finite.exists_fin (R := Γ(Z, U)) (M := Γ(L', U))

  have hspanD : Submodule.span Γ(Z, Z.basicOpen f) (Set.range fun i =>
      (L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (p i)) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨n, t, ht⟩ := (hL' U hU f).1 x
    have htm : t ∈ Submodule.span Γ(Z, U) (Set.range p) := by rw [hspan]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp htm
    have hu : IsUnit ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) :=
      RingedSpace.isUnit_res_basicOpen Z.toRingedSpace f
    obtain ⟨v, hv⟩ := hu.exists_left_inv
    have hres : (L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t ∈
        Submodule.span Γ(Z, Z.basicOpen f) (Set.range fun i =>
          (L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (p i)) := by
      rw [← hc, map_sum]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      rw [Scheme.Modules.map_smul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    have hx : x = v ^ n • (L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t := by
      rw [← ht, smul_smul, ← mul_pow, hv, one_pow, one_smul]
    rw [hx]
    exact Submodule.smul_mem _ _ hres

  have part2 : ∀ t : Γ(H, U), (H.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t = 0 →
      ∃ n : ℕ, f ^ n • t = 0 := by
    intro t ht
    have h0 : ∀ i, (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (Θ U t (p i)) = 0 := by
      intro i
      rw [← nat U (Z.basicOpen f) (Z.basicOpen_le f) t (p i), ht, map_zero, LinearMap.zero_apply]
    choose n hn using fun i => (hF U hU f).2 _ (h0 i)
    refine ⟨∑ i, n i, (hbij U hU).1 ?_⟩
    rw [map_zero, map_smul]
    apply LinearMap.ext_on_range hspan
    intro i
    rw [LinearMap.smul_apply, LinearMap.zero_apply]
    have hle : n i ≤ ∑ j, n j :=
      Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hn i, smul_zero]

  have s2 : ∀ (m : Fin k → Γ(F, U)), (∀ c : Fin k → Γ(Z, U), ∑ i, c i • p i = 0 →
      ∃ e : ℕ, f ^ e • ∑ i, c i • m i = 0) →
      ∃ (e : ℕ) (τ : Γ(L', U) →ₗ[Γ(Z, U)] Γ(F, U)), ∀ i, τ (p i) = f ^ e • m i := by
    intro m hm
    have hπ : Function.Surjective (Fintype.linearCombination Γ(Z, U) p) := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hspan]
    obtain ⟨S, hS⟩ := Module.FinitePresentation.fg_ker (Fintype.linearCombination Γ(Z, U) p) hπ
    have hS' : ∀ c ∈ S, ∑ i, c i • p i = 0 := by
      intro c hc
      have hmem : c ∈ LinearMap.ker (Fintype.linearCombination Γ(Z, U) p) := by
        rw [← hS]; exact Submodule.subset_span hc
      rw [LinearMap.mem_ker, Fintype.linearCombination_apply] at hmem
      exact hmem
    choose! ec hec using fun c (hc : c ∈ S) => hm c (hS' c hc)
    have hK : LinearMap.ker (Fintype.linearCombination Γ(Z, U) p) ≤
        LinearMap.ker (Fintype.linearCombination Γ(Z, U) (fun i => f ^ S.sup ec • m i)) := by
      rw [← hS, Submodule.span_le]
      intro c hc
      have hc' : c ∈ S := hc
      rw [SetLike.mem_coe, LinearMap.mem_ker, Fintype.linearCombination_apply]
      have hle : ec c ≤ S.sup ec := Finset.le_sup hc'
      have hsum : ∑ i, c i • f ^ S.sup ec • m i = f ^ S.sup ec • ∑ i, c i • m i := by
        rw [Finset.smul_sum]
        exact Finset.sum_congr rfl (fun i _ => smul_comm _ _ _)
      rw [hsum, ← Nat.sub_add_cancel hle, pow_add, mul_smul, hec c hc', smul_zero]
    refine ⟨S.sup ec, (LinearMap.ker (Fintype.linearCombination Γ(Z, U) p)).liftQ
      (Fintype.linearCombination Γ(Z, U) (fun i => f ^ S.sup ec • m i)) hK ∘ₗ
      ((Fintype.linearCombination Γ(Z, U) p).quotKerEquivOfSurjective hπ).symm.toLinearMap,
      fun i => ?_⟩
    have hpi : Fintype.linearCombination Γ(Z, U) p (Pi.single i 1) = p i := by
      rw [Fintype.linearCombination_apply_single, one_smul]
    have hq : ((Fintype.linearCombination Γ(Z, U) p).quotKerEquivOfSurjective hπ).symm (p i) =
        Submodule.Quotient.mk (Pi.single i 1) := by
      rw [LinearEquiv.symm_apply_eq, LinearMap.quotKerEquivOfSurjective_apply_mk, hpi]
    rw [LinearMap.comp_apply, LinearEquiv.coe_coe, hq, Submodule.liftQ_apply,
      Fintype.linearCombination_apply_single, one_smul]

  have part1 : ∀ s : Γ(H, Z.basicOpen f), ∃ (n : ℕ) (t : Γ(H, U)),
      ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ n • s =
        (H.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t := by
    intro s

    choose n m hm using fun i => (hF U hU f).1
      (Θ (Z.basicOpen f) s ((L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (p i)))
    obtain ⟨N, hN⟩ : ∃ N, N = ∑ i, n i := ⟨_, rfl⟩
    have hnle : ∀ i, n i ≤ N := fun i =>
      hN ▸ Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    have hm' : ∀ i, (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (f ^ (N - n i) • m i) =
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ N •
          Θ (Z.basicOpen f) s ((L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (p i)) := by
      intro i
      rw [Scheme.Modules.map_smul, map_pow, ← hm i, smul_smul, ← pow_add,
        Nat.sub_add_cancel (hnle i)]

    have hrel : ∀ c : Fin k → Γ(Z, U), ∑ i, c i • p i = 0 →
        ∃ e : ℕ, f ^ e • ∑ i, c i • (f ^ (N - n i) • m i) = 0 := by
      intro c hc
      apply (hF U hU f).2
      have e1 : ∑ i, (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
            (c i • (f ^ (N - n i) • m i)) =
          ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ N •
            Θ (Z.basicOpen f) s ((L'.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
              (∑ i, c i • p i)) := by
        rw [map_sum, map_sum, Finset.smul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Scheme.Modules.map_smul, hm' i, Scheme.Modules.map_smul, map_smul, smul_comm]
      rw [map_sum, e1, hc, map_zero, map_zero, smul_zero]

    obtain ⟨e, τ, hτ⟩ := s2 (fun i => f ^ (N - n i) • m i) hrel
    have hτ' : ∀ i, τ (p i) = f ^ e • (f ^ (N - n i) • m i) := hτ

    obtain ⟨t, ht⟩ := (hbij U hU).2 τ

    refine ⟨N + e, t, (hbij _ (hU.basicOpen f)).1 ?_⟩
    apply LinearMap.ext_on_range hspanD
    intro i
    rw [map_smul, LinearMap.smul_apply, nat U (Z.basicOpen f) (Z.basicOpen_le f) t (p i), ht,
      hτ' i, Scheme.Modules.map_smul, map_pow, hm' i, smul_smul, ← pow_add, add_comm]
  exact ⟨part1, part2⟩

theorem wc_cn_hom_adic_transfer : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (L' : Z.Modules) (Hm : Z.Modules ⥤ Z.Modules) (Θ : ∀ (F : Z.Modules) (V : Z.Opens), Γ(Hm.obj F, V) →ₗ[Γ(Z, V)] (Γ(L', V) →ₗ[Γ(Z, V)] Γ(F, V))), (∀ V : Z.Opens, IsAffineOpen V → Module.Projective Γ(Z, V) Γ(L', V) ∧ Module.Finite Γ(Z, V) Γ(L', V)) → (∀ F : Z.Modules, wcCoherentMod F → ∀ V : Z.Opens, IsAffineOpen V → Function.Bijective (Θ F V)) → (∀ F : Z.Modules, wcCoherentMod F → wcQcoh (Hm.obj F)) → (∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (s : Γ(Hm.obj F, V)) (x : Γ(L', V)), Θ G V (Scheme.Modules.Hom.app (Hm.map φ) V s) x = Scheme.Modules.Hom.app φ V (Θ F V s x)) → ∀ (Es : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n) (L : Z.Modules) (φE : ∀ n, L ⟶ Es n), wcCnAdicSys h I Es ψE → wcCnAlg h I Es ψE L φE → wcCnAdicSys h I (fun n => Hm.obj (Es n)) (fun n => Hm.map (ψE n)) ∧ wcCnAlg h I (fun n => Hm.obj (Es n)) (fun n => Hm.map (ψE n)) (Hm.obj L) (fun n => Hm.map (φE n)) :=
by
  intro B _ I Z h L' Hm Θ hP hbij hqH hF Es ψE L φE hEadic hEalg

  have s1a : ∀ (R : Type u) [CommRing R] (P : Type u) [AddCommGroup P] [Module R P]
      [Module.Projective R P] [Module.Finite R P] (M : Type u) [AddCommGroup M] [Module R M],
      Module.Finite R M → Module.Finite R (P →ₗ[R] M) := by
    intro R _ P _ _ _ _ M _ _ hM
    obtain ⟨k, p, hp⟩ := Module.Finite.exists_fin' R P
    obtain ⟨ι, hι⟩ := Module.projective_lifting_property p LinearMap.id hp
    refine Module.Finite.of_surjective (LinearMap.lcomp R M ι) ?_
    intro φ
    refine ⟨φ ∘ₗ p, ?_⟩
    apply LinearMap.ext
    intro x
    rw [LinearMap.lcomp_apply, LinearMap.comp_apply, ← LinearMap.comp_apply p ι, hι,
      LinearMap.id_apply]

  have s1b : ∀ (R : Type u) [CommRing R] (P : Type u) [AddCommGroup P] [Module R P] (J : Ideal R)
      (M : Type u) [AddCommGroup M] [Module R M],
      J • (⊤ : Submodule R M) = ⊥ → J • (⊤ : Submodule R (P →ₗ[R] M)) = ⊥ := by
    intro R _ P _ _ J M _ _ hJ
    rw [eq_bot_iff]
    refine Submodule.smul_le.mpr ?_
    intro a ha φ _
    rw [Submodule.mem_bot]
    apply LinearMap.ext
    intro x
    rw [LinearMap.smul_apply, LinearMap.zero_apply]
    have hx : a • φ x ∈ J • (⊤ : Submodule R M) := Submodule.smul_mem_smul ha Submodule.mem_top
    rw [hJ, Submodule.mem_bot] at hx
    exact hx

  have s1c : ∀ (R : Type u) [CommRing R] (P : Type u) [AddCommGroup P] [Module R P]
      [Module.Projective R P] (M' M : Type u) [AddCommGroup M'] [Module R M'] [AddCommGroup M]
      [Module R M] (π : M' →ₗ[R] M), Function.Surjective π →
      Function.Surjective (fun φ : P →ₗ[R] M' => π ∘ₗ φ) := by
    intro R _ P _ _ _ M' M _ _ _ _ π hπ ψ
    exact Module.projective_lifting_property π ψ hπ

  have s1d : ∀ (R : Type u) [CommRing R] (P : Type u) [AddCommGroup P] [Module R P]
      [Module.Projective R P] [Module.Finite R P] (J : Ideal R)
      (M' M : Type u) [AddCommGroup M'] [Module R M'] [AddCommGroup M] [Module R M]
      (π : M' →ₗ[R] M), (∀ x, π x = 0 ↔ x ∈ J • (⊤ : Submodule R M')) →
      ∀ φ : P →ₗ[R] M', π ∘ₗ φ = 0 ↔ φ ∈ J • (⊤ : Submodule R (P →ₗ[R] M')) := by
    intro R _ P _ _ _ _ J M' M _ _ _ _ π H φ
    constructor
    · intro hφ
      obtain ⟨k, p, hp⟩ := Module.Finite.exists_fin' R P
      obtain ⟨ι, hι⟩ := Module.projective_lifting_property p LinearMap.id hp
      have hsr : ∀ (ℓ : P →ₗ[R] R) (y : M'), y ∈ J • (⊤ : Submodule R M') →
          ℓ.smulRight y ∈ J • (⊤ : Submodule R (P →ₗ[R] M')) := by
        intro ℓ y hy
        apply Submodule.smul_induction_on
          (p := fun y : M' => ℓ.smulRight y ∈ J • (⊤ : Submodule R (P →ₗ[R] M'))) hy
        · intro a ha y' _
          have e : ℓ.smulRight (a • y') = a • ℓ.smulRight y' := by
            apply LinearMap.ext
            intro c
            rw [LinearMap.smulRight_apply, LinearMap.smul_apply, LinearMap.smulRight_apply,
              smul_comm]
          show ℓ.smulRight (a • y') ∈ J • (⊤ : Submodule R (P →ₗ[R] M'))
          rw [e]
          exact Submodule.smul_mem_smul ha Submodule.mem_top
        · intro y₁ y₂ h₁ h₂
          have e : ℓ.smulRight (y₁ + y₂) = ℓ.smulRight y₁ + ℓ.smulRight y₂ := by
            apply LinearMap.ext
            intro c
            rw [LinearMap.smulRight_apply, LinearMap.add_apply, LinearMap.smulRight_apply,
              LinearMap.smulRight_apply, smul_add]
          show ℓ.smulRight (y₁ + y₂) ∈ J • (⊤ : Submodule R (P →ₗ[R] M'))
          rw [e]
          exact Submodule.add_mem _ h₁ h₂
      have hm : ∀ j : Fin k, φ (p (Pi.single j 1)) ∈ J • (⊤ : Submodule R M') := by
        intro j
        rw [← H, ← LinearMap.comp_apply π φ, hφ, LinearMap.zero_apply]
      have hdec : φ = ∑ j : Fin k,
          ((LinearMap.proj (R := R) j : (Fin k → R) →ₗ[R] R) ∘ₗ ι).smulRight
            (φ (p (Pi.single j 1))) := by
        apply LinearMap.ext
        intro x
        rw [LinearMap.sum_apply]
        simp only [LinearMap.smulRight_apply, LinearMap.comp_apply, LinearMap.proj_apply]
        have hx2 : ι x = ∑ j : Fin k, ι x j • (Pi.single j (1 : R) : Fin k → R) := by
          ext i
          simp [Finset.sum_apply, Pi.single_apply]
        calc φ x = φ (p (ι x)) := by
              rw [← LinearMap.comp_apply p ι, hι, LinearMap.id_apply]
          _ = φ (p (∑ j : Fin k, ι x j • (Pi.single j (1 : R) : Fin k → R))) := by rw [← hx2]
          _ = ∑ j : Fin k, ι x j • φ (p (Pi.single j 1)) := by simp only [map_sum, map_smul]
      rw [hdec]
      exact Submodule.sum_mem _ (fun j _ => hsr _ _ (hm j))
    · intro hφ
      apply Submodule.smul_induction_on (p := fun φ : P →ₗ[R] M' => π ∘ₗ φ = 0) hφ
      · intro a ha ψ _
        show π ∘ₗ (a • ψ) = 0
        apply LinearMap.ext
        intro x
        rw [LinearMap.comp_apply, LinearMap.smul_apply, LinearMap.zero_apply, H]
        exact Submodule.smul_mem_smul ha Submodule.mem_top
      · intro φ₁ φ₂ h₁ h₂
        show π ∘ₗ (φ₁ + φ₂) = 0
        have h₁' : π ∘ₗ φ₁ = 0 := h₁
        have h₂' : π ∘ₗ φ₂ = 0 := h₂
        rw [LinearMap.comp_add, h₁', h₂', add_zero]

  have s2 : ∀ (R : Type u) [CommRing R] (P : Type u) [AddCommGroup P] [Module R P] (J : Ideal R)
      (M₁ M₀ H₁ H₀ : Type u) [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₀] [Module R M₀]
      [AddCommGroup H₁] [Module R H₁] [AddCommGroup H₀] [Module R H₀]
      (π : M₁ →ₗ[R] M₀) (g : H₁ →ₗ[R] H₀) (Θ₁ : H₁ →ₗ[R] (P →ₗ[R] M₁))
      (Θ₀ : H₀ →ₗ[R] (P →ₗ[R] M₀)),
      Function.Bijective Θ₁ → Function.Bijective Θ₀ → (∀ s, Θ₀ (g s) = π ∘ₗ Θ₁ s) →
      Function.Surjective (fun φ : P →ₗ[R] M₁ => π ∘ₗ φ) →
      (∀ φ : P →ₗ[R] M₁, π ∘ₗ φ = 0 ↔ φ ∈ J • (⊤ : Submodule R (P →ₗ[R] M₁))) →
      Function.Surjective g ∧ ∀ s, g s = 0 ↔ s ∈ J • (⊤ : Submodule R H₁) := by
    intro R _ P _ _ J M₁ M₀ H₁ H₀ _ _ _ _ _ _ _ _ π g Θ₁ Θ₀ hb₁ hb₀ hc hs hk
    have hstar : Submodule.map Θ₁ (J • (⊤ : Submodule R H₁)) =
        J • (⊤ : Submodule R (P →ₗ[R] M₁)) := by
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr hb₁.2]
    refine ⟨fun t => ?_, fun s => ?_⟩
    · obtain ⟨φ, hφ⟩ := hs (Θ₀ t)
      obtain ⟨s, rfl⟩ := hb₁.2 φ
      refine ⟨s, hb₀.1 ?_⟩
      rw [hc]
      exact hφ
    · have e1 : g s = 0 ↔ Θ₀ (g s) = 0 :=
        ⟨fun h0 => by rw [h0, map_zero], fun h0 => hb₀.1 (by rw [h0, map_zero])⟩
      rw [e1, hc, hk, ← hstar]
      constructor
      · intro hm
        obtain ⟨s', hs', he⟩ := Submodule.mem_map.mp hm
        rw [← hb₁.1 he]
        exact hs'
      · intro hm
        exact Submodule.mem_map_of_mem hm

  have s3 : ∀ (R : Type u) [CommRing R] (P M H : Type u) [AddCommGroup P] [Module R P]
      [AddCommGroup M] [Module R M] [AddCommGroup H] [Module R H] (J : Ideal R)
      (T : H →ₗ[R] (P →ₗ[R] M)), Function.Bijective T →
      (Module.Finite R (P →ₗ[R] M) → Module.Finite R H) ∧
      (J • (⊤ : Submodule R (P →ₗ[R] M)) = ⊥ → J • (⊤ : Submodule R H) = ⊥) := by
    intro R _ P M H _ _ _ _ _ _ J T hb
    refine ⟨fun hfin => Module.Finite.equiv (LinearEquiv.ofBijective T hb).symm, fun hJ => ?_⟩
    rw [eq_bot_iff]
    intro x hx
    have h1 : T x ∈ J • (⊤ : Submodule R (P →ₗ[R] M)) := by
      have hmx := Submodule.mem_map_of_mem (f := T) hx
      rw [Submodule.map_smul''] at hmx
      exact Submodule.smul_mono le_rfl le_top hmx
    rw [hJ, Submodule.mem_bot] at h1
    rw [Submodule.mem_bot]
    exact hb.1 (by rw [h1, map_zero])

  let lin : ∀ (F G : Z.Modules) (φ : F ⟶ G) (U : Z.Opens), Γ(F, U) →ₗ[Γ(Z, U)] Γ(G, U) :=
    fun F G φ U =>
      { toFun := fun x => Scheme.Modules.Hom.app φ U x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul φ r x }
  have stepB : ∀ (F G : Z.Modules) (φ : F ⟶ G) (U : Z.Opens) (s : Γ(Hm.obj F, U)),
      Θ G U (lin _ _ (Hm.map φ) U s) = lin _ _ φ U ∘ₗ Θ F U s := fun F G φ U s =>
    LinearMap.ext fun x => hF F G φ U s x
  have stepC : ∀ F : Z.Modules, wcCoherentMod F → wcCoherentMod (Hm.obj F) := by
    intro F hFc
    have hFq := hqH F hFc
    obtain ⟨_, hFf⟩ := hFc
    unfold wcCoherentMod
    refine ⟨hFq, fun U hU => ?_⟩
    haveI := (hP U hU).1
    haveI := (hP U hU).2
    exact (s3 _ _ _ _ ⊥ (Θ F U) (hbij F ⟨‹_›, hFf⟩ U hU)).1 (s1a _ _ _ (hFf U hU))
  have stepX : ∀ (F G : Z.Modules) (φ : F ⟶ G), wcCoherentMod F → wcCoherentMod G →
      ∀ (U : Z.Opens), IsAffineOpen U → ∀ (J : Ideal Γ(Z, U)),
      Function.Surjective (Scheme.Modules.Hom.app φ U) →
      (∀ s, Scheme.Modules.Hom.app φ U s = 0 ↔ s ∈ J • (⊤ : Submodule Γ(Z, U) Γ(F, U))) →
      Function.Surjective (Scheme.Modules.Hom.app (Hm.map φ) U) ∧
      ∀ s, Scheme.Modules.Hom.app (Hm.map φ) U s = 0 ↔
        s ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Hm.obj F, U)) := by
    intro F G φ hFc hGc U hU J hsurj hker
    haveI := (hP U hU).1
    haveI := (hP U hU).2
    exact s2 _ _ J _ _ _ _ (lin _ _ φ U) (lin _ _ (Hm.map φ) U) (Θ F U) (Θ G U)
      (hbij F hFc U hU) (hbij G hGc U hU) (stepB F G φ U)
      (s1c _ _ _ _ (lin _ _ φ U) hsurj) (s1d _ _ J _ _ (lin _ _ φ U) hker)
  unfold wcCnAdicSys at hEadic
  unfold wcCnAlg at hEalg
  unfold wcCnAdicSys wcCnAlg
  obtain ⟨hEcoh, hEexact, hEtors⟩ := hEadic
  obtain ⟨hLcoh, hLcomp, hLexact⟩ := hEalg
  refine ⟨⟨fun n => stepC _ (hEcoh n), fun n U hU => stepX _ _ (ψE n) (hEcoh (n + 1)) (hEcoh n)
    U hU _ (hEexact n U hU).1 (hEexact n U hU).2, fun n U hU => ?_⟩, stepC _ hLcoh, fun n => ?_,
    fun n U hU => stepX _ _ (φE n) hLcoh (hEcoh n) U hU _ (hLexact n U hU).1
      (hLexact n U hU).2⟩
  · haveI := (hP U hU).1
    haveI := (hP U hU).2
    exact (s3 _ _ _ _ _ (Θ (Es n) U) (hbij _ (hEcoh n) U hU)).2 (s1b _ _ _ _ (hEtors n U hU))
  · show Hm.map (φE (n + 1)) ≫ Hm.map (ψE n) = Hm.map (φE n)
    rw [← Hm.map_comp, hLcomp n]

theorem wc_cn_locfree_hom_lift : wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    (m : ℕ) (g : Z ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift h g) →
    ∀ (L' L : Z.Modules) (Es : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n) (φE : ∀ n, L ⟶ Es n),
    wcCnLocFree L' → wcCnAdicSys h (IsLocalRing.maximalIdeal B) Es ψE →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Es ψE L φE →
    ∀ a : ∀ n, L' ⟶ Es n, (∀ n, a (n + 1) ≫ ψE n = a n) →
    ∃ b : L' ⟶ L, ∀ n, b ≫ φE n = a n :=
by
  intro hFF B _ _ _ _ Z h m g hg L' L Es ψE φE hL' hEadic hEalg a ha

  haveI hprop : IsProper h := by
    have hT : IsProper (Limits.terminal.from (wcPm.{u} m)) := by
      letI : IsScalarTower (ULift.{u} ℤ) ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0)
          (MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ)) :=
        IsScalarTower.of_algebraMap_eq (R := ULift.{u} ℤ)
          (S := ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0))
          (A := MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ)) (fun r => rfl)
      haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0)
          (MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ)) :=
        Algebra.FiniteType.of_restrictScalars_finiteType (ULift.{u} ℤ) _ _
      haveI h1 : IsProper (@Proj.toSpecZero _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) MvPolynomial.gradedAlgebra) := by
        infer_instance
      have hsurj : Function.Surjective (algebraMap (ULift.{u} ℤ)
          ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0)) := by
        intro p
        refine ⟨(p.1).coeff 0, ?_⟩
        apply Subtype.ext
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        have hp : (p.1).IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        by_cases hp0 : p.1 = 0
        · rw [hp0]; simp
        · exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp (hp.totalDegree hp0)).symm
      have key : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S),
          Function.Surjective f → IsClosedImmersion (Spec.map (CommRingCat.ofHom f)) :=
        fun f hf => IsClosedImmersion.spec_of_surjective _ hf
      haveI h2 : IsClosedImmersion (Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ)
          ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0)))) := by
        first
          | exact key (algebraMap (ULift.{u} ℤ)
              ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0)) hsurj
          | exact IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ)
              ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0))) (fun x => hsurj x)
          | (refine key _ ?_; convert hsurj)
          | (apply IsClosedImmersion.spec_of_surjective; convert hsurj)
      haveI h3 : IsIso (Limits.terminal.from (Spec (.of (ULift.{u} ℤ)))) :=
        ⟨⟨specULiftZIsTerminal.from _, specULiftZIsTerminal.hom_ext _ _, Limits.terminal.hom_ext _ _⟩⟩
      have e : Limits.terminal.from (wcPm.{u} m) = @Proj.toSpecZero _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) MvPolynomial.gradedAlgebra ≫
          Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ)
            ((MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 0))) ≫
          Limits.terminal.from (Spec (.of (ULift.{u} ℤ))) := Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    have hfst : IsProper (Limits.prod.fst (X := Spec (.of B)) (Y := wcPm.{u} m)) :=
      MorphismProperty.of_isPullback (P := @IsProper)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m)).flip hT
    rw [← Limits.prod.lift_fst h g]
    infer_instance

  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h

  obtain ⟨Hm, Θ, e, hV, hglue, hF, he⟩ := wc_cn_internal_hom_exists Z L'
  have hq' : wcQcoh L' := hL'.1.1
  have resres : ∀ (M : Z.Modules) (U V W : Z.Opens) (h₁ : V ≤ U) (h₂ : W ≤ V) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h₂).op).hom ((M.presheaf.map (homOfLE h₁).op).hom x) =
        (M.presheaf.map (homOfLE (h₂.trans h₁)).op).hom x := by
    intro M U V W h₁ h₂ x
    rw [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Functor.map_comp]; rfl
  have resid : ∀ (M : Z.Modules) (U : Z.Opens) (hU : U ≤ U) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE hU).op).hom x = x := by
    intro M U hU x
    rw [show homOfLE hU = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]; rfl

  have hbij : ∀ (F : Z.Modules) (W : Z.Opens), IsAffineOpen W → Function.Bijective (Θ F W) := by
    intro F W hW
    have compat : ∀ s : Γ(Hm.obj F, W), ∀ (W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ W) (h₂ : W₂ ≤ W₁)
        (x : Γ(L', W₁)),
        (F.presheaf.map (homOfLE h₂).op).hom
            (Θ F W₁ (((Hm.obj F).presheaf.map (homOfLE h₁).op).hom s) x) =
          Θ F W₂ (((Hm.obj F).presheaf.map (homOfLE (h₂.trans h₁)).op).hom s)
            ((L'.presheaf.map (homOfLE h₂).op).hom x) := by
      intro s W₁ W₂ h₁ h₂ x
      rw [← hV F W₁ W₂ h₂, resres]
    have top : ∀ s : Γ(Hm.obj F, W),
        Θ F W (((Hm.obj F).presheaf.map (homOfLE (le_rfl : W ≤ W)).op).hom s) = Θ F W s := by
      intro s; rw [resid]
    constructor
    · intro s s' hss
      have hfam : (fun (W' : Z.Opens) (hW' : W' ≤ W) =>
            Θ F W' (((Hm.obj F).presheaf.map (homOfLE hW').op).hom s)) =
          (fun (W' : Z.Opens) (hW' : W' ≤ W) =>
            Θ F W' (((Hm.obj F).presheaf.map (homOfLE hW').op).hom s')) :=
        (wc_cn_qcoh_affine_hom_extend Z L' F W hW hq' (Θ F W s)).unique
          ⟨compat s, top s⟩ ⟨compat s', (top s').trans hss.symm⟩
      exact (hglue F W _ (compat s)).unique (fun W' hW' => rfl)
        (fun W' hW' => (congrFun (congrFun hfam W') hW').symm)
    · intro φ
      obtain ⟨f, ⟨hfc, hfW⟩, -⟩ := wc_cn_qcoh_affine_hom_extend Z L' F W hW hq' φ
      obtain ⟨t, ht, -⟩ := hglue F W f hfc
      exact ⟨t, (top t).symm.trans ((ht W le_rfl).trans hfW)⟩

  have hP := wc_cn_locfree_affine_projective Z L' hL'

  have hqH : ∀ F : Z.Modules, wcCoherentMod F → wcQcoh (Hm.obj F) := fun F hFc =>
    wc_cn_hom_qcoh_of_affine_bij Z L' F (Hm.obj F) (Θ F) hq' hFc.1
      (fun V hV => (hP V hV).2.2) (fun V hV => hbij F V hV) (hV F)

  obtain ⟨hadic, halg⟩ := wc_cn_hom_adic_transfer B (IsLocalRing.maximalIdeal B) Z h L' Hm Θ
    (fun V hV => ⟨(hP V hV).1, (hP V hV).2.1⟩) (fun F _ V hV => hbij F V hV) hqH hF
    Es ψE L φE hEadic hEalg

  obtain ⟨s₀, hs₀, -⟩ := hFF B Z h (fun n => Hm.obj (Es n)) (fun n => Hm.map (ψE n))
    (Hm.obj L) (fun n => Hm.map (φE n)) hadic halg (fun n => e (Es n) (a n))
    (fun n => (he _ _ (ψE n) (a (n + 1))).trans (congrArg (e (Es n)) (ha n)))
  refine ⟨(e L).symm s₀, fun n => (e (Es n)).injective ?_⟩
  refine (he L (Es n) (φE n) ((e L).symm s₀)).symm.trans ?_
  rw [Equiv.apply_symm_apply]
  exact hs₀ n

theorem wc_cn_cokernel_algebraization : ∀ (B : Type u) [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m : ℕ) (g : Z ⟶ wcPm.{u} m),
    IsClosedImmersion (Limits.prod.lift h g) →
    ∀ (L L' : Z.Modules) (Es E's Fs : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n)
      (ψE' : ∀ n, E's (n + 1) ⟶ E's n) (ψF : ∀ n, Fs (n + 1) ⟶ Fs n) (φE : ∀ n, L ⟶ Es n)
      (φE' : ∀ n, L' ⟶ E's n) (b : L' ⟶ L) (β : ∀ n, E's n ⟶ Es n) (α : ∀ n, Es n ⟶ Fs n),
    wcCnAlg h (IsLocalRing.maximalIdeal B) Es ψE L φE →
    wcCnAlg h (IsLocalRing.maximalIdeal B) E's ψE' L' φE' →
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψF →
    (∀ n, b ≫ φE n = φE' n ≫ β n) → (∀ n, α (n + 1) ≫ ψF n = ψE n ≫ α n) →
    (∀ n (U : Z.Opens), IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app (α n) U)) →
    (∀ n (U : Z.Opens), IsAffineOpen U → ∀ x : Γ(Es n, U),
      Scheme.Modules.Hom.app (α n) U x = 0 ↔ ∃ y : Γ(E's n, U), Scheme.Modules.Hom.app (β n) U y = x) →
    ∃ (M : Z.Modules) (φ : ∀ n, M ⟶ Fs n), wcCnAlg h (IsLocalRing.maximalIdeal B) Fs ψF M φ :=
by
  intro B _ _ _ Z h m g _ L L' Es E's Fs ψE ψE' ψF φE φE' b β α HE HE' HF Hb Hα Hs Hk

  have capp : ∀ {P Q R : Z.Modules} (f : P ⟶ Q) (k : Q ⟶ R) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ k) U x =
        Scheme.Modules.Hom.app k U (Scheme.Modules.Hom.app f U x) := by
    intro P Q R f k U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : Z.Modules} (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) U x = 0 := by
    intro P Q U x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have hsmul : ∀ {P Q : Z.Modules} (f : P ⟶ Q) (U : Z.Opens) (J : Ideal Γ(Z, U)) (x : Γ(P, U)),
      x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(P, U)) →
        Scheme.Modules.Hom.app f U x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U)) := by
    intro P Q f U J x hx
    refine Submodule.smul_induction_on
      (p := fun y => Scheme.Modules.Hom.app f U y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))) hx ?_ ?_
    · intro r hr y _
      have e : Scheme.Modules.Hom.app f U (r • y) = r • Scheme.Modules.Hom.app f U y :=
        Scheme.Modules.Hom.app_smul f r y
      show Scheme.Modules.Hom.app f U (r • y) ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [e]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro y y' hy hy'
      show Scheme.Modules.Hom.app f U (y + y') ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [map_add]
      exact Submodule.add_mem _ hy hy'

  have hfac : Abelian.coimage.π b ≫ Abelian.factorThruCoimage b = b := Abelian.coimage.fac b
  have hK : wcQcoh (Limits.kernel b) := wc_cn_kernel_qcoh Z L' L b HE'.1.1 HE.1.1
  obtain ⟨hIcoh, -⟩ := wc_cn_coimage_coherent Z L' L b HE'.1 HE.1 hK
  obtain ⟨hSES, hMcoh, -, -⟩ := wc_dev_cokernel_coh Z (Abelian.coimage b) L
    (Abelian.factorThruCoimage b) inferInstance hIcoh HE.1
  have hπs : ∀ U : Z.Opens, IsAffineOpen U → Function.Surjective
      (Scheme.Modules.Hom.app (Limits.cokernel.π (Abelian.factorThruCoimage b)) U) :=
    fun U hU => wc_modules_ses_affine_surj Z _ hSES hIcoh.1 U hU

  have hbπ : b ≫ Limits.cokernel.π (Abelian.factorThruCoimage b) = 0 := by
    have e : (Abelian.coimage.π b ≫ Abelian.factorThruCoimage b) ≫
        Limits.cokernel.π (Abelian.factorThruCoimage b) = 0 := by
      rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    rwa [hfac] at e

  have hβα : ∀ n, β n ≫ α n = 0 := by
    intro n
    apply wc_cn_modules_hom_ext_affine
    intro U hU y
    rw [capp, zapp]
    exact (Hk n U hU _).2 ⟨y, rfl⟩

  have hιφ : ∀ n, Abelian.factorThruCoimage b ≫ φE n ≫ α n = 0 := by
    intro n
    rw [← cancel_epi (Abelian.coimage.π b), ← Category.assoc, hfac, ← Category.assoc, Hb n,
      Category.assoc, hβα n, Limits.comp_zero, Limits.comp_zero]
  obtain ⟨φ, hP⟩ : ∃ φ : ∀ n, Limits.cokernel (Abelian.factorThruCoimage b) ⟶ Fs n,
      ∀ n, Limits.cokernel.π (Abelian.factorThruCoimage b) ≫ φ n = φE n ≫ α n :=
    ⟨fun n => Limits.cokernel.desc _ (φE n ≫ α n) (hιφ n),
      fun n => Limits.cokernel.π_desc _ _ _⟩
  refine ⟨Limits.cokernel (Abelian.factorThruCoimage b), φ, hMcoh, ?_, ?_⟩
  ·
    intro n
    rw [← cancel_epi (Limits.cokernel.π (Abelian.factorThruCoimage b)), ← Category.assoc, hP, hP,
      Category.assoc, Hα n, ← Category.assoc, HE.2.1 n]
  · intro n U hU
    refine ⟨?_, ?_⟩
    ·
      intro z
      obtain ⟨e, he⟩ := Hs n U hU z
      obtain ⟨x, hx⟩ := (HE.2.2 n U hU).1 e
      refine ⟨Scheme.Modules.Hom.app (Limits.cokernel.π (Abelian.factorThruCoimage b)) U x, ?_⟩
      rw [← capp, hP, capp, hx, he]
    ·
      intro μ
      constructor
      · intro hμ
        obtain ⟨x, rfl⟩ := hπs U hU μ
        rw [← capp, hP, capp] at hμ
        obtain ⟨y, hy⟩ := (Hk n U hU _).1 hμ
        obtain ⟨x', hx'⟩ := (HE'.2.2 n U hU).1 y
        have h1 : Scheme.Modules.Hom.app (φE n) U (Scheme.Modules.Hom.app b U x') =
            Scheme.Modules.Hom.app (φE n) U x := by
          rw [← capp, Hb n, capp, hx', hy]
        have h2 := ((HE.2.2 n U hU).2 (x - Scheme.Modules.Hom.app b U x')).1
          (by rw [map_sub, h1, sub_self])
        have h3 : Scheme.Modules.Hom.app (Limits.cokernel.π (Abelian.factorThruCoimage b)) U x =
            Scheme.Modules.Hom.app (Limits.cokernel.π (Abelian.factorThruCoimage b)) U
              (x - Scheme.Modules.Hom.app b U x') := by
          rw [map_sub, ← capp b, hbπ, zapp, sub_zero]
        rw [h3]
        exact hsmul _ U _ _ h2
      · intro hμ
        have h1 := hsmul (φ n) U _ μ hμ
        rw [HF.2.2 n U hU] at h1
        exact (Submodule.mem_bot _).1 h1

theorem wc_cn_existence_projective : wcCnProjExist.{u} :=
by
  unfold wcCnProjExist
  intro B _ _ _ _ Z h m g hg Fs ψF hF
  obtain ⟨L, Es, ψE, φE, α, _hLfree, hEadic, hEalg, hαc, hαs⟩ :=
    wc_cn_twisted_presentation wc_cn_uniform_twisted_lift B Z h m g hg Fs ψF hF
  obtain ⟨Ks, ψK, γ, hKadic, hγc, hker⟩ :=
    wc_cn_kernel_adic_system B Z h m g hg Es Fs ψE ψF α hEadic hF hαc hαs
  obtain ⟨L', E's, ψE', φE', α', hL'free, _hE'adic, hE'alg, hα'c, hα's⟩ :=
    wc_cn_twisted_presentation wc_cn_uniform_twisted_lift B Z h m g hg Ks ψK hKadic
  have hE'c : ∀ n, φE' (n + 1) ≫ ψE' n = φE' n := hE'alg.2.1
  have hcompat : ∀ n, (φE' (n + 1) ≫ α' (n + 1) ≫ γ (n + 1)) ≫ ψE n = φE' n ≫ α' n ≫ γ n := by
    intro n
    simp only [Category.assoc]
    rw [hγc n, ← Category.assoc (α' (n + 1)), hα'c n, Category.assoc,
      ← Category.assoc (φE' (n + 1)), hE'c n]
  obtain ⟨b, hb⟩ := wc_cn_locfree_hom_lift wc_cn_coherent_formal_functions B Z h m g hg L' L Es ψE φE
    hL'free hEadic hEalg
    (fun n => φE' n ≫ α' n ≫ γ n) hcompat
  have hker' : ∀ n (U : Z.Opens), IsAffineOpen U → ∀ x : Γ(Es n, U),
      Scheme.Modules.Hom.app (α n) U x = 0 ↔
        ∃ y : Γ(E's n, U), Scheme.Modules.Hom.app (α' n ≫ γ n) U y = x := by
    intro n U hU x
    rw [hker n U hU x]
    constructor
    · rintro ⟨y, rfl⟩
      obtain ⟨z, rfl⟩ := hα's n U hU y
      exact ⟨z, by rw [Scheme.Modules.Hom.comp_app]; rfl⟩
    · rintro ⟨z, rfl⟩
      exact ⟨Scheme.Modules.Hom.app (α' n) U z, by rw [Scheme.Modules.Hom.comp_app]; rfl⟩
  exact wc_cn_cokernel_algebraization B Z h m g hg L L' Es E's Fs ψE ψE' ψF φE φE' b
    (fun n => α' n ≫ γ n) α hEalg hE'alg hF hb hαc hαs hker'

theorem wc_cn_idealSheaf_wellFoundedGT : ∀ (X : Scheme.{u}) [IsNoetherian X],
    WellFoundedGT X.IdealSheafData :=
by
  intro X _
  classical
  have hW : ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W := by
    intro x
    obtain ⟨W, hWa, hxW, _⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
    exact ⟨W, hWa, hxW⟩
  choose W hWa hWx using hW
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
    (fun x => (W x).isOpen.mem_nhds (hWx x))
  let U : t → X.affineOpens := fun i => ⟨W i.1, hWa i.1⟩
  have hU : ⨆ i, (U i : X.Opens) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have hy : y ∈ ⋃ x ∈ t, (W x : Set X) := by rw [ht]; trivial
    simp only [Set.mem_iUnion] at hy
    obtain ⟨x, hx, hyx⟩ := hy
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨x, hx⟩, hyx⟩
  haveI hfac : ∀ i : t, WellFoundedLT (Ideal Γ(X, (U i : X.Opens)))ᵒᵈ := fun i => by
    have := IsLocallyNoetherian.component_noetherian (U i)
    infer_instance
  haveI : WellFoundedLT ((i : t) → (Ideal Γ(X, (U i : X.Opens)))ᵒᵈ) := Pi.wellFoundedLT
  let Φ : X.IdealSheafData → ((i : t) → (Ideal Γ(X, (U i : X.Opens)))ᵒᵈ) :=
    fun I i => OrderDual.toDual (I.ideal (U i))
  have hanti : ∀ I J : X.IdealSheafData, I ≤ J → Φ J ≤ Φ I := by
    intro I J h i
    exact (Scheme.IdealSheafData.le_def.mp h) (U i)
  have hinj : ∀ I J : X.IdealSheafData, Φ I = Φ J → I = J := by
    intro I J h
    refine Scheme.IdealSheafData.ext_of_iSup_eq_top U hU (fun i => ?_)
    exact OrderDual.toDual.injective (congrFun h i)
  have hsa : StrictAnti Φ := by
    intro I J hIJ
    exact lt_of_le_of_ne (hanti I J hIJ.le) (fun h => hIJ.ne (hinj I J h.symm))
  exact hsa.wellFoundedGT

theorem wc_chow_dense_affine_charts : ∀ (X : Scheme.{u}) [TopologicalSpace.NoetherianSpace X], ∃ (r : ℕ) (U : Fin (r + 1) → X.Opens), (∀ i, IsAffineOpen (U i)) ∧ (⨆ i, U i) = ⊤ ∧ Dense (⋂ i, (U i : Set X)) :=
by
  intro X _
  classical
  let Gs : Set X := {x | closure ({x} : Set X) ∈ irreducibleComponents X}
  have hcomp : (irreducibleComponents X).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hGfin : Gs.Finite := by
    apply Set.Finite.of_finite_image (f := fun x => closure ({x} : Set X))
    · exact hcomp.subset (by rintro _ ⟨x, hx, rfl⟩; exact hx)
    · intro x _ y _ hxy
      exact (inseparable_iff_closure_eq.mpr hxy).eq
  set G : Finset X := hGfin.toFinset with hGdef
  have memG : ∀ x, x ∈ G ↔ closure ({x} : Set X) ∈ irreducibleComponents X := fun x => by
    rw [hGdef, Set.Finite.mem_toFinset]
    rfl

  have hK : ∀ y : X, ∃ k ∈ G, y ∈ closure ({k} : Set X) := by
    intro y
    have hC := irreducibleComponent_mem_irreducibleComponents y
    obtain ⟨k, hk⟩ := QuasiSober.sober (isIrreducible_irreducibleComponent (x := y))
      (isClosed_of_mem_irreducibleComponents _ hC)
    have hk' : closure ({k} : Set X) = irreducibleComponent y := hk
    refine ⟨k, (memG k).2 (by rw [hk']; exact hC), ?_⟩
    rw [hk']
    exact mem_irreducibleComponent

  have hM : ∀ g ∈ G, ∀ h ∈ G, g ∈ closure ({h} : Set X) → g = h := by
    intro g hg h hh hgh
    have h1 : closure ({g} : Set X) ⊆ closure {h} :=
      closure_minimal (Set.singleton_subset_iff.mpr hgh) isClosed_closure
    have hgm : Maximal IsIrreducible (closure ({g} : Set X)) := (memG g).1 hg
    have hhm : Maximal IsIrreducible (closure ({h} : Set X)) := (memG h).1 hh
    have h2 : closure ({g} : Set X) = closure {h} := hgm.eq_of_le hhm.prop h1
    exact (inseparable_iff_closure_eq.mpr h2).eq
  let O : X → Set X := fun g => (⋃ h ∈ G.erase g, closure ({h} : Set X))ᶜ
  have hOopen : ∀ g, IsOpen (O g) := fun g => by
    exact isOpen_compl_iff.mpr (isClosed_biUnion_finset (fun _ _ => isClosed_closure))
  have hOmem : ∀ g ∈ G, g ∈ O g := by
    intro g hg hmem
    obtain ⟨h, hh, hgh⟩ := Set.mem_iUnion₂.mp hmem
    rw [Finset.mem_erase] at hh
    exact hh.1 (hM g hg h hh.2 hgh).symm
  have hOprop : ∀ g y, y ∈ O g → ∀ h ∈ G, y ∈ closure ({h} : Set X) → h = g := by
    intro g y hy h hh hyh
    by_contra hne
    exact hy (Set.mem_iUnion₂.mpr ⟨h, Finset.mem_erase.mpr ⟨hne, hh⟩, hyh⟩)
  have hWex : ∀ g : G, ∃ W : X.Opens, IsAffineOpen W ∧ (g : X) ∈ W ∧ (W : Set X) ⊆ O g := by
    intro g
    obtain ⟨W, hW, hgW, hWO⟩ := exists_isAffineOpen_mem_and_subset (x := (g : X))
      (U := ⟨O g, hOopen g⟩) (hOmem g g.2)
    exact ⟨W, hW, hgW, hWO⟩
  choose W hWaff hWmem hWsub using hWex
  have hWdisjV : ∀ (V : X.Opens) (g : G), (g : X) ∉ V → Disjoint V (W g) := by
    intro V g hgV
    rw [← TopologicalSpace.Opens.coe_disjoint, Set.disjoint_left]
    intro y hyV hyW
    obtain ⟨k, hkG, hyk⟩ := hK y
    have hkg := hOprop g y (hWsub g hyW) k hkG hyk
    rw [hkg] at hyk
    exact hgV ((specializes_iff_mem_closure.mpr hyk).mem_open V.isOpen hyV)
  have hWdisj : ∀ g h : G, g ≠ h → Disjoint (W g) (W h) := by
    intro g h hne
    rw [← TopologicalSpace.Opens.coe_disjoint, Set.disjoint_left]
    intro y hyg hyh
    obtain ⟨k, hkG, hyk⟩ := hK y
    exact hne (Subtype.ext ((hOprop g y (hWsub g hyg) k hkG hyk).symm.trans
      (hOprop h y (hWsub h hyh) k hkG hyk)))

  have hext : ∀ (V : X.Opens), IsAffineOpen V → ∀ s : Finset G,
      (∀ g ∈ s, Disjoint V (W g)) → IsAffineOpen (V ⊔ s.sup W) := by
    intro V hV s
    induction s using Finset.induction_on with
    | empty => intro _; simpa using hV
    | insert a t hat ih =>
      intro hd
      rw [Finset.sup_insert, sup_left_comm]
      have h1 := ih (fun g hg => hd g (Finset.mem_insert_of_mem hg))
      refine (hWaff a).sup_of_disjoint h1 ?_
      rw [disjoint_sup_right]
      refine ⟨(hd a (Finset.mem_insert_self a t)).symm, ?_⟩
      rw [Finset.disjoint_sup_right]
      intro g hg
      exact hWdisj a g (fun h => hat (h ▸ hg))

  have hAex : ∀ x : X, ∃ A : X.Opens, IsAffineOpen A ∧ x ∈ A := fun x => by
    obtain ⟨A, hA, hxA, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    exact ⟨A, hA, hxA⟩
  choose A hAaff hAmem using hAex
  obtain ⟨t, ht⟩ := (TopologicalSpace.NoetherianSpace.isCompact (Set.univ : Set X)).elim_finite_subcover
    (fun x : X => ((A x : X.Opens) : Set X)) (fun x => (A x).isOpen)
    (fun x _ => Set.mem_iUnion.mpr ⟨x, hAmem x⟩)
  let r := t.card
  let V : Fin (r + 1) → X.Opens := Fin.cons ⊥ (fun k => A (t.equivFin.symm k))
  have hVaff : ∀ k, IsAffineOpen (V k) := by
    intro k
    refine Fin.cases ?_ (fun k => ?_) k
    · simpa [V] using isAffineOpen_bot X
    · simpa [V] using hAaff _
  have hVcov : ∀ x : X, ∃ k, x ∈ V k := by
    intro x
    have hx := ht (Set.mem_univ x)
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨(t.equivFin ⟨y, hy⟩).succ, ?_⟩
    simpa [V] using hxy
  let U : Fin (r + 1) → X.Opens := fun k =>
    V k ⊔ (Finset.univ.filter (fun g : G => (g : X) ∉ V k)).sup W
  have hGU : ∀ g ∈ G, ∀ k, g ∈ U k := by
    intro g hg k
    by_cases hgV : g ∈ V k
    · exact (le_sup_left : V k ≤ U k) hgV
    · have hmem : (⟨g, hg⟩ : G) ∈ Finset.univ.filter (fun g' : G => (g' : X) ∉ V k) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hgV⟩
      exact (le_sup_right : _ ≤ U k) (Finset.le_sup (f := W) hmem (hWmem ⟨g, hg⟩))
  refine ⟨r, U, fun k => ?_, ?_, ?_⟩
  · exact hext (V k) (hVaff k) _ (fun g hg => hWdisjV _ g (Finset.mem_filter.mp hg).2)
  · rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    obtain ⟨k, hk⟩ := hVcov x
    exact ⟨k, (le_sup_left : V k ≤ U k) hk⟩
  · rw [dense_iff_inter_open]
    rintro S hS ⟨y, hy⟩
    obtain ⟨k, hkG, hyk⟩ := hK y
    exact ⟨k, (specializes_iff_mem_closure.mpr hyk).mem_open hS hy,
      Set.mem_iInter.mpr (fun i => hGU k hkG i)⟩

theorem wc_chow_affine_generators : ∀ (B : Type u) [CommRing B] (X : Scheme.{u}) (f : X ⟶ Spec (.of B)) [LocallyOfFiniteType f] (U : X.Opens), IsAffineOpen U → ∃ (n : ℕ) (a : Fin (n + 1) → Γ(X, U)), a 0 = 1 ∧ ∀ t : Γ(X, U), t ∈ Subring.closure (Set.range ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp (f.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range a) :=
by
  intro B _ X f _ U hU
  have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType f inferInstance
    ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
  have h2 : ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp f.appTop.hom).FiniteType := h1
  have h3 : (Scheme.ΓSpecIso (.of B)).inv.hom.FiniteType := by
    apply RingHom.FiniteType.of_surjective
    intro x
    exact ⟨(Scheme.ΓSpecIso (.of B)).hom.hom x, by simp⟩
  have hft := RingHom.FiniteType.comp h2 h3
  set ρ := (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
    (f.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) with hρ
  letI := ρ.toAlgebra
  obtain ⟨s, hs⟩ := (hft : Algebra.FiniteType B Γ(X, U)).out
  let a : Fin (s.card + 1) → Γ(X, U) := Fin.cons 1 (fun k => (s.equivFin.symm k).1)
  refine ⟨s.card, a, rfl, fun t => ?_⟩
  have ht : t ∈ (Algebra.adjoin B (s : Set Γ(X, U))).toSubring := by
    rw [hs]; trivial
  rw [Algebra.adjoin_eq_ring_closure] at ht
  refine Subring.closure_mono ?_ ht
  rintro x (hx | hx)
  · exact Or.inl hx
  · refine Or.inr ⟨(s.equivFin ⟨x, hx⟩).succ, ?_⟩
    simp [a]

theorem wc_toImage_injective_dense : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) [QuasiCompact f], (∀ U : f.image.Opens, Function.Injective (f.toImage.app U)) ∧ DenseRange f.toImage :=
by
  intro X Y f _
  refine ⟨fun U => ?_, f.toImage.denseRange⟩
  rw [injective_iff_map_eq_zero]
  intro s hs
  obtain ⟨t, ht, htU⟩ := (f.imageι.isClosedEmbedding.isInducing.isOpen_iff).mp U.isOpen
  have key : ∀ x (hx : x ∈ U), ∃ V : Y.affineOpens,
      ∃ _ : f.imageι ⁻¹ᵁ (V : Y.Opens) ≤ U, x ∈ f.imageι ⁻¹ᵁ (V : Y.Opens) := by
    intro x hx
    have hx' : f.imageι x ∈ (⟨t, ht⟩ : Y.Opens) := by
      have : x ∈ f.imageι ⁻¹' t := by rw [htU]; exact hx
      exact this
    obtain ⟨V, hV, hxV, hVU⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Y)) hx'
    refine ⟨⟨V, hV⟩, ?_, hxV⟩
    intro y hy
    have h1 : f.imageι y ∈ (⟨t, ht⟩ : Y.Opens) := hVU hy
    have h2 : y ∈ f.imageι ⁻¹' t := h1
    rw [htU] at h2
    exact h2
  apply TopCat.Presheaf.section_ext f.image.sheaf U s 0
  intro x hx
  obtain ⟨V, hW, hxW⟩ := key x hx
  have hres : (ConcreteCategory.hom (f.image.presheaf.map (homOfLE hW).op)) s = 0 := by
    apply f.toImage_app_injective V
    rw [map_zero, ← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply, hs,
      map_zero]
  have e := TopCat.Presheaf.germ_res_apply f.image.presheaf (homOfLE hW) x hxW s
  rw [hres, map_zero] at e
  rw [map_zero]
  exact e.symm

theorem wc_isIso_restrict_of_section : ∀ (Y' Y : Scheme.{u}) (π : Y' ⟶ Y) [IsSeparated π] (U : Y.Opens) (δ : (U : Scheme.{u}) ⟶ Y'), (∀ W : Y'.Opens, Function.Injective (δ.app W)) → δ ≫ π = U.ι → IsIso (π ∣_ U) :=
by
  intro Y' Y π _ U δ hinj hδπ

  have s1 : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) [IsClosedImmersion f],
      (∀ V : Z.Opens, Function.Injective (f.app V)) → IsIso f := by
    intro X Z f _ hf
    have hP : MorphismProperty.isomorphisms Scheme f := by
      rw [IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme)
        (fun V : Z.affineOpens => (V : Z.Opens)) (iSup_affineOpens_eq_top Z)]
      intro V
      haveI : IsAffine (V : Z.Opens) := V.2
      haveI : IsClosedImmersion (f ∣_ (V : Z.Opens)) :=
        IsZariskiLocalAtTarget.restrict (P := @IsClosedImmersion) inferInstance _
      have hbij : ∀ {A B : X.Opens} (h : A = B),
          Function.Bijective (X.presheaf.map (eqToHom h).op) := by
        intro A B h
        subst h
        rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
        exact ConcreteCategory.bijective_of_isIso _
      have hinjV : Function.Injective (f ∣_ (V : Z.Opens)).appTop := by
        rw [morphismRestrict_appTop]
        intro a b hab
        exact hf _ ((hbij _).1 hab)
      exact IsClosedImmersion.isIso_of_injective_of_isAffine hinjV
    exact hP

  have hrange : Set.range δ ⊆ Set.range (π ⁻¹ᵁ U).ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    show π (δ x) ∈ (U : Set Y)
    rw [← Scheme.Hom.comp_apply, hδπ]
    have hx : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
    rwa [Scheme.Opens.range_ι] at hx
  obtain ⟨δ', hfac⟩ : ∃ δ' : (U : Scheme.{u}) ⟶ (π ⁻¹ᵁ U : Scheme.{u}),
      δ' ≫ (π ⁻¹ᵁ U).ι = δ := ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
  subst hfac

  have hsec : δ' ≫ π ∣_ U = 𝟙 _ := by
    rw [← cancel_mono U.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hδπ,
      Category.id_comp]

  haveI : IsSeparated (π ∣_ U) := IsZariskiLocalAtTarget.restrict (P := @IsSeparated) ‹_› U
  haveI : IsClosedImmersion (δ' ≫ π ∣_ U) := by rw [hsec]; infer_instance
  haveI : IsClosedImmersion δ' := IsClosedImmersion.of_comp δ' (π ∣_ U)

  have hinj' : ∀ W' : (π ⁻¹ᵁ U : Scheme.{u}).Opens, Function.Injective (δ'.app W') := by
    intro W'
    have h1 := Scheme.Hom.comp_app δ' (π ⁻¹ᵁ U).ι ((π ⁻¹ᵁ U).ι ''ᵁ W')
    haveI := Scheme.Hom.isIso_app (π ⁻¹ᵁ U).ι ((π ⁻¹ᵁ U).ι ''ᵁ W')
      (Scheme.Hom.image_le_opensRange _ W')
    have hsurj := (ConcreteCategory.bijective_of_isIso
      ((π ⁻¹ᵁ U).ι.app ((π ⁻¹ᵁ U).ι ''ᵁ W'))).2
    have key : Function.Injective (δ'.app ((π ⁻¹ᵁ U).ι ⁻¹ᵁ ((π ⁻¹ᵁ U).ι ''ᵁ W'))) := by
      intro a b hab
      obtain ⟨a', rfl⟩ := hsurj a
      obtain ⟨b', rfl⟩ := hsurj b
      have h2 : (δ' ≫ (π ⁻¹ᵁ U).ι).app ((π ⁻¹ᵁ U).ι ''ᵁ W') a' =
          (δ' ≫ (π ⁻¹ᵁ U).ι).app ((π ⁻¹ᵁ U).ι ''ᵁ W') b' := by
        first
          | exact hab
          | (rw [h1]; exact hab)
      rw [hinj _ h2]
    rwa [Scheme.Hom.preimage_image_eq] at key

  haveI : IsIso δ' := s1 δ' hinj'
  haveI : IsIso (δ' ≫ π ∣_ U) := by rw [hsec]; infer_instance
  exact IsIso.of_isIso_comp_left δ' (π ∣_ U)

theorem wc_chow_key_identity : ∀ (Y Y' V P : Scheme.{u}) (π : Y' ⟶ Y) (g : Y' ⟶ P) (δ : V ⟶ Y') (ψ : V ⟶ Y) (φ : V ⟶ P) (r : ℕ) (U : Fin (r + 1) → Y.Opens) (n : Fin (r + 1) → ℕ) (a : ∀ i, Fin (n i + 1) → Γ(Y, U i)) (N : ℕ) (κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1))) (C : Fin (N + 1) → P.Opens) (e : ∀ J L : Fin (N + 1), Γ(P, C J)) (s : Fin (N + 1) → Γ(V, ⊤)) (hψU : ∀ i, ψ ⁻¹ᵁ U i = ⊤), (∀ W : Y'.Opens, Function.Injective (δ.app W)) → δ ≫ π = ψ → δ ≫ g = φ → (∀ i, a i 0 = 1) → (∀ L, s L = ∏ i, ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ L i))) → (∀ J, φ ⁻¹ᵁ C J = V.basicOpen (s J)) → (∀ J L, φ.app (C J) (e J L) * V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J ≤ ⊤)).op (s J) = V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J ≤ ⊤)).op (s L)) → ∀ (i : Fin (r + 1)) (J : Fin (N + 1)), κ J i = 0 → ∀ k : Fin (n i + 1), (Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J ≤ π ⁻¹ᵁ U i)).op).hom (π.app (U i) (a i k)) = (Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J ≤ g ⁻¹ᵁ C J)).op).hom (g.app (C J) (e J (κ.symm (Function.update (κ J) i k)))) :=
by
  intro Y Y' V P π g δ ψ φ r U n a N κ C e s hψU hinj hδπ hδg ha0 hs hφC hrel i J hJi k
  subst hδπ hδg

  have hprod : ∀ (f : ∀ l, Fin (n l + 1) → Γ(V, ⊤)), f i 0 = 1 →
      ∏ l, f l (Function.update (κ J) i k l) = f i k * ∏ l, f l (κ J l) := by
    intro f hf
    rw [Fintype.prod_eq_mul_prod_compl i, Fintype.prod_eq_mul_prod_compl i (fun l => f l (κ J l))]
    simp only [Function.update_self, hJi, hf, one_mul]
    congr 1
    apply Finset.prod_congr rfl
    intro l hl
    rw [Function.update_of_ne (by simpa using hl)]
  have hsL : s (κ.symm (Function.update (κ J) i k)) =
      ((δ ≫ π).appLE (U i) ⊤ (hψU i).ge) (a i k) * s J := by
    rw [hs (κ.symm (Function.update (κ J) i k)), hs J, Equiv.apply_symm_apply]
    exact hprod (fun l m => ((δ ≫ π).appLE (U l) ⊤ (hψU l).ge) (a l m)) (by simp [ha0])

  have hcancel : ∀ (W : V.Opens) (hWU : W ≤ (δ ≫ π) ⁻¹ᵁ U i) (hWC : W ≤ (δ ≫ g) ⁻¹ᵁ C J),
      ((δ ≫ π).appLE (U i) W hWU) (a i k) =
        ((δ ≫ g).appLE (C J) W hWC) (e J (κ.symm (Function.update (κ J) i k))) := by
    intro W hWU hWC
    have hρt : ∀ x : Γ(V, ⊤), (V.presheaf.map (homOfLE hWC).op)
        ((V.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C J ≤ ⊤)).op) x) =
        (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) x := by
      intro x
      change ((V.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C J ≤ ⊤)).op ≫
        V.presheaf.map (homOfLE hWC).op) x) = _
      rw [← Functor.map_comp]
      rfl
    have hτA : (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
        (((δ ≫ π).appLE (U i) ⊤ (hψU i).ge) (a i k)) = ((δ ≫ π).appLE (U i) W hWU) (a i k) := by
      change (((δ ≫ π).appLE (U i) ⊤ (hψU i).ge ≫
        V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) (a i k)) = _
      rw [Scheme.Hom.appLE_map]
    have hWb : W ≤ V.basicOpen (s J) := by rw [← hφC J]; exact hWC
    have hunit : IsUnit ((V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) (s J)) := by
      have e0 : (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) (s J) =
          (V.presheaf.map (homOfLE hWb).op)
            ((V.presheaf.map (homOfLE (V.basicOpen_le (s J))).op) (s J)) := by
        change _ = ((V.presheaf.map (homOfLE (V.basicOpen_le (s J))).op ≫
          V.presheaf.map (homOfLE hWb).op) (s J))
        rw [← Functor.map_comp]
        rfl
      rw [e0]
      exact (RingedSpace.isUnit_res_basicOpen V.toRingedSpace (s J)).map
        (V.presheaf.map (homOfLE hWb).op).hom
    have h1 := congrArg (⇑(V.presheaf.map (homOfLE hWC).op))
      (hrel J (κ.symm (Function.update (κ J) i k)))
    have h2 : ((δ ≫ g).appLE (C J) W hWC) (e J (κ.symm (Function.update (κ J) i k))) *
        (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) (s J) =
        ((δ ≫ π).appLE (U i) W hWU) (a i k) *
        (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) (s J) :=
      calc _ = (V.presheaf.map (homOfLE hWC).op)
              (((δ ≫ g).app (C J)) (e J (κ.symm (Function.update (κ J) i k)))) *
            (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) (s J) := rfl
        _ = (V.presheaf.map (homOfLE hWC).op)
              (((δ ≫ g).app (C J)) (e J (κ.symm (Function.update (κ J) i k)))) *
            (V.presheaf.map (homOfLE hWC).op)
              ((V.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C J ≤ ⊤)).op) (s J)) := by
            rw [hρt]
        _ = (V.presheaf.map (homOfLE hWC).op)
              (((δ ≫ g).app (C J)) (e J (κ.symm (Function.update (κ J) i k))) *
              (V.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C J ≤ ⊤)).op) (s J)) :=
            (map_mul _ _ _).symm
        _ = (V.presheaf.map (homOfLE hWC).op)
              ((V.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C J ≤ ⊤)).op)
                (s (κ.symm (Function.update (κ J) i k)))) := h1
        _ = (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
              (s (κ.symm (Function.update (κ J) i k))) := hρt _
        _ = (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
              (((δ ≫ π).appLE (U i) ⊤ (hψU i).ge) (a i k) * s J) := by rw [hsL]
        _ = (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
              (((δ ≫ π).appLE (U i) ⊤ (hψU i).ge) (a i k)) *
            (V.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) (s J) := map_mul _ _ _
        _ = _ := by rw [hτA]
    exact ((hunit.mul_left_inj).mp h2).symm

  have hmor : ∀ {Z : Scheme.{u}} (h : Y' ⟶ Z) (O : Z.Opens)
      (le : π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J ≤ h ⁻¹ᵁ O) (x : Γ(Z, O)),
      (δ.app (π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J)) ((Y'.presheaf.map (homOfLE le).op) (h.app O x)) =
        ((δ ≫ h).appLE O (δ ⁻¹ᵁ (π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J)) (fun _ hz => le hz)) x := by
    intro Z h O le x
    change ((h.appLE O _ le ≫ δ.app (π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J)) x) = _
    rw [Scheme.Hom.app_eq_appLE δ, Scheme.Hom.appLE_comp_appLE]
  apply hinj (π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J)
  exact (hmor π (U i) inf_le_left (a i k)).trans
    ((hcancel (δ ⁻¹ᵁ (π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J)) (fun _ hz => hz.1) (fun _ hz => hz.2)).trans
      (hmor g (C J) inf_le_right _).symm)

theorem wc_chow_charts_cover_K : ∀ (Y Y' V P : Scheme.{u}) (π : Y' ⟶ Y) (g : Y' ⟶ P) (δ : V ⟶ Y') (ψ : V ⟶ Y) (φ : V ⟶ P) (r : ℕ) (U : Fin (r + 1) → Y.Opens) (n : Fin (r + 1) → ℕ) (a : ∀ i, Fin (n i + 1) → Γ(Y, U i)) (N : ℕ) (κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1))) (C : Fin (N + 1) → P.Opens) (e : ∀ J L : Fin (N + 1), Γ(P, C J)) (s : Fin (N + 1) → Γ(V, ⊤)) (hψU : ∀ i, ψ ⁻¹ᵁ U i = ⊤), (∀ W : Y'.Opens, Function.Injective (δ.app W)) → δ ≫ π = ψ → δ ≫ g = φ → (∀ i, a i 0 = 1) → (∀ L, s L = ∏ i, ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ L i))) → (∀ J, φ ⁻¹ᵁ C J = V.basicOpen (s J)) → (∀ J L, φ.app (C J) (e J L) * V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J ≤ ⊤)).op (s J) = V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J ≤ ⊤)).op (s L)) → (⨆ J, C J) = ⊤ → (∀ J L, P.basicOpen (e J L) = C J ⊓ C L) → (∀ z : Y', ∃ i, π z ∈ U i) → ∀ z : Y', ∃ J : Fin (N + 1), (∃ i, κ J i = 0) ∧ g z ∈ C J :=
by
  classical
  intro Y Y' V P π g δ ψ φ r U n a N κ C e s hψU hinj hδπ hδg ha0 hs hφC hrel hCcov hCbo hπcov z
  obtain ⟨i, hi⟩ := hπcov z
  have hzC : g z ∈ (⊤ : P.Opens) := trivial
  rw [← hCcov] at hzC
  obtain ⟨J', hJ'⟩ := TopologicalSpace.Opens.mem_iSup.mp hzC
  set J := κ.symm (Function.update (κ J') i 0) with hJdef
  have hκJ : κ J = Function.update (κ J') i 0 := Equiv.apply_symm_apply κ _
  refine ⟨J, ⟨i, by rw [hκJ, Function.update_self]⟩, ?_⟩

  have H1 : φ.app (C J') (e J' J) * V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J' ≤ ⊤)).op
      (ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ J' i))) = 1 := by
    have hsJ' : s J' = ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ J' i)) *
        ∏ l ∈ Finset.univ.erase i, ψ.appLE (U l) ⊤ (hψU l).ge (a l (κ J' l)) := by
      rw [hs J']
      exact (Finset.mul_prod_erase Finset.univ
        (fun l => ψ.appLE (U l) ⊤ (hψU l).ge (a l (κ J' l))) (Finset.mem_univ i)).symm
    have hsJ : s J =
        ∏ l ∈ Finset.univ.erase i, ψ.appLE (U l) ⊤ (hψU l).ge (a l (κ J' l)) := by
      rw [hs, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i)]
      have h1 : ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ J i)) = 1 := by
        rw [hκJ, Function.update_self, ha0, map_one]
      rw [h1, one_mul]
      apply Finset.prod_congr rfl
      intro l hl
      rw [hκJ, Function.update_of_ne (Finset.ne_of_mem_erase hl)]
    have hunit : IsUnit (V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J' ≤ ⊤)).op (s J')) := by
      have hle : φ ⁻¹ᵁ C J' ≤ V.basicOpen (s J') := (hφC J').le
      have h1 : IsUnit (V.presheaf.map (homOfLE (le_top : V.basicOpen (s J') ≤ ⊤)).op (s J')) :=
        RingedSpace.isUnit_res_basicOpen V.toRingedSpace (s J')
      have key : V.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ C J' ≤ ⊤)).op =
          V.presheaf.map (homOfLE (le_top : V.basicOpen (s J') ≤ ⊤)).op ≫
            V.presheaf.map (homOfLE hle).op := by
        rw [← Functor.map_comp]; rfl
      rw [key, CommRingCat.comp_apply]
      exact h1.map (ConcreteCategory.hom (V.presheaf.map (homOfLE hle).op))
    rw [hsJ', map_mul] at hunit
    have hcU := isUnit_of_mul_isUnit_right hunit
    have hr := hrel J' J
    rw [hsJ', hsJ, map_mul, ← mul_assoc] at hr
    apply (hcU.mul_left_inj).mp
    rw [one_mul]
    exact hr

  subst hδπ hδg
  set O : Y'.Opens := π ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ C J' with hOdef
  have hT1 : δ ⁻¹ᵁ O ≤ (δ ≫ g) ⁻¹ᵁ C J' := fun x hx => hx.2
  have H2 : Y'.presheaf.map (homOfLE (inf_le_right : O ≤ g ⁻¹ᵁ C J')).op (g.app (C J') (e J' J)) *
      Y'.presheaf.map (homOfLE (inf_le_left : O ≤ π ⁻¹ᵁ U i)).op (π.app (U i) (a i (κ J' i))) = 1 := by
    apply hinj O
    rw [map_mul, map_one]
    have H1' := congrArg (V.presheaf.map (homOfLE hT1).op).hom H1
    rw [map_mul, map_one] at H1'
    convert H1' using 2
    · have key : g.appLE (C J') O inf_le_right ≫ δ.appLE O (δ ⁻¹ᵁ O) le_rfl =
          (δ ≫ g).appLE (C J') (δ ⁻¹ᵁ O) hT1 := Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
      change (g.appLE (C J') O inf_le_right ≫ δ.app O) _ =
        ((δ ≫ g).appLE (C J') (δ ⁻¹ᵁ O) hT1) _
      rw [Scheme.Hom.app_eq_appLE, key]
    · have key : π.appLE (U i) O inf_le_left ≫ δ.appLE O (δ ⁻¹ᵁ O) le_rfl =
          (δ ≫ π).appLE (U i) ⊤ (hψU i).ge ≫
            V.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C J' ≤ ⊤)).op ≫
              V.presheaf.map (homOfLE hT1).op := by
        rw [Scheme.Hom.appLE_comp_appLE, ← Category.assoc, Scheme.Hom.appLE_map,
          Scheme.Hom.appLE_map]
      change (π.appLE (U i) O inf_le_left ≫ δ.app O) _ =
        ((δ ≫ π).appLE (U i) ⊤ (hψU i).ge ≫
            V.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C J' ≤ ⊤)).op ≫
              V.presheaf.map (homOfLE hT1).op) _
      rw [Scheme.Hom.app_eq_appLE, key]

  have hu : IsUnit (Y'.presheaf.map (homOfLE (inf_le_right : O ≤ g ⁻¹ᵁ C J')).op
      (g.app (C J') (e J' J))) := IsUnit.of_mul_eq_one _ H2
  have hzO : z ∈ O := ⟨hi, hJ'⟩
  have hb := Scheme.basicOpen_of_isUnit Y' hu
  rw [Scheme.basicOpen_res] at hb
  have hz2 : z ∈ Y'.basicOpen (g.app (C J') (e J' J)) := by
    have hz' : z ∈ O ⊓ Y'.basicOpen (g.app (C J') (e J' J)) := by rw [hb]; exact hzO
    exact hz'.2
  rw [← Scheme.preimage_basicOpen] at hz2
  have hz3 : g z ∈ P.basicOpen (e J' J) := hz2
  rw [hCbo] at hz3
  exact hz3.2

theorem wc_cn_chow_rel_ideal : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) [IsProper h] (𝒦 : Z.IdealSheafData), 𝒦 ≠ ⊤ →
    ∃ (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ) (g : P ⟶ wcPm.{u} m) (U V₀ : Z.Opens)
      (hV₀ : IsAffineOpen V₀),
      IsProper p ∧ IsClosedImmersion (Limits.prod.lift (p ≫ h) g) ∧ V₀ ≤ U ∧
      𝒦.ideal ⟨V₀, hV₀⟩ ≠ ⊤ ∧
      (∀ (V : Z.Opens) (hV : IsAffineOpen V), ∀ a ∈ 𝒦.ideal ⟨V, hV⟩, (p.app V).hom a = 0) ∧
      ∀ (V : Z.Opens) (hV : IsAffineOpen V), V ≤ U →
        IsAffineOpen (p ⁻¹ᵁ V) ∧ Function.Surjective (p.app V).hom ∧
        RingHom.ker (p.app V).hom = 𝒦.ideal ⟨V, hV⟩ :=
by
  intro B _ _ Z h _ 𝒦 h𝒦
  classical

  have hfstproper : ∀ (N : ℕ) (Y : Scheme.{u}), IsProper (Limits.prod.fst : Y ⨯ wcPm.{u} N ⟶ Y) := by
    intro N Y
    letI 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hP0 : IsProper (Proj.toSpecZero 𝒜) := by
      letI : IsScalarTower (ULift.{u} ℤ) (𝒜 0) (MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) :=
        IsScalarTower.of_algebraMap_eq (R := ULift.{u} ℤ) (S := 𝒜 0)
          (A := MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) (fun r => rfl)
      haveI : Algebra.FiniteType (𝒜 0) (MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) :=
        Algebra.FiniteType.of_restrictScalars_finiteType (ULift.{u} ℤ) _ _
      infer_instance
    have hsurj : Function.Surjective (algebraMap (ULift.{u} ℤ) (𝒜 0)) := by
      intro x
      have hx : (x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2
      refine ⟨(x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).coeff 0, ?_⟩
      apply Subtype.ext
      have h0 := hx.totalDegree_le
      have h1 : (x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).totalDegree = 0 := by omega
      rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h1
      rw [h1]
      simp
    let f : Spec (.of (𝒜 0)) ⟶ Spec (.of (ULift.{u} ℤ)) :=
      Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) (𝒜 0)))
    have hf : IsFinite f := by
      rw [IsFinite.SpecMap_iff]
      exact RingHom.Finite.of_surjective _ hsurj
    have hT : IsIso (Limits.terminal.from (Spec (.of (ULift.{u} ℤ)))) := by
      have e : Limits.terminal.from (Spec (.of (ULift.{u} ℤ))) =
          (specULiftZIsTerminal.uniqueUpToIso Limits.terminalIsTerminal).hom :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    have htop : IsProper (Limits.terminal.from (wcPm.{u} N)) := by
      have e : Limits.terminal.from (wcPm.{u} N) =
          Proj.toSpecZero 𝒜 ≫ f ≫ Limits.terminal.from (Spec (.of (ULift.{u} ℤ))) :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    have hpb : IsPullback (Limits.prod.snd : Y ⨯ wcPm.{u} N ⟶ _) Limits.prod.fst
        (Limits.terminal.from (wcPm.{u} N)) (Limits.terminal.from Y) :=
      (IsPullback.of_isLimit_binaryFan_of_isTerminal (Limits.prodIsProd Y (wcPm.{u} N))
        Limits.terminalIsTerminal).flip
    exact MorphismProperty.of_isPullback (P := @IsProper) hpb htop

  have s12 : ∀ (X Y P : Scheme.{u}) (ι : P ⟶ X ⨯ Y) [IsClosedImmersion ι] (U : X.Opens) (C : Y.Opens), IsAffineOpen U → IsAffineOpen C → IsAffineOpen ((ι ≫ Limits.prod.fst) ⁻¹ᵁ U ⊓ (ι ≫ Limits.prod.snd) ⁻¹ᵁ C) ∧ ∀ t : Γ(P, (ι ≫ Limits.prod.fst) ⁻¹ᵁ U ⊓ (ι ≫ Limits.prod.snd) ⁻¹ᵁ C), t ∈ Subring.closure (Set.range ((P.presheaf.map (homOfLE (inf_le_left : (ι ≫ Limits.prod.fst) ⁻¹ᵁ U ⊓ (ι ≫ Limits.prod.snd) ⁻¹ᵁ C ≤ (ι ≫ Limits.prod.fst) ⁻¹ᵁ U)).op).hom.comp ((ι ≫ Limits.prod.fst).app U).hom) ∪ Set.range ((P.presheaf.map (homOfLE (inf_le_right : (ι ≫ Limits.prod.fst) ⁻¹ᵁ U ⊓ (ι ≫ Limits.prod.snd) ⁻¹ᵁ C ≤ (ι ≫ Limits.prod.snd) ⁻¹ᵁ C)).op).hom.comp ((ι ≫ Limits.prod.snd).app C).hom)) := by
    intro X Y P ι _ U C hU hC
    obtain ⟨hOaff, hOgen⟩ := wc_prod_affine_opens_gen X Y U C hU hC
    refine ⟨hOaff.preimage ι, fun t => ?_⟩
    let φ : Γ(X ⨯ Y, (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ C) →+*
        Γ(P, (ι ≫ Limits.prod.fst) ⁻¹ᵁ U ⊓ (ι ≫ Limits.prod.snd) ⁻¹ᵁ C) :=
      (ι.app ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ C)).hom
    obtain ⟨s, hs⟩ : ∃ s, φ s = t := Scheme.Hom.app_surjective ι _ hOaff t
    rw [← hs, ← Subring.mem_comap]
    refine (Subring.closure_le.mpr ?_) (hOgen s)
    rintro _ (⟨x, rfl⟩ | ⟨y, rfl⟩)
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      left
      refine ⟨x, ?_⟩
      have hh := ConcreteCategory.congr_hom (ι.naturality (homOfLE (inf_le_left :
        (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ C ≤
          (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U)).op) ((Limits.prod.fst : X ⨯ Y ⟶ X).app U x)
      exact hh.symm
    · rw [SetLike.mem_coe, Subring.mem_comap]
      apply Subring.subset_closure
      right
      refine ⟨y, ?_⟩
      have hh := ConcreteCategory.congr_hom (ι.naturality (homOfLE (inf_le_right :
        (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ C ≤
          (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ C)).op) ((Limits.prod.snd : X ⨯ Y ⟶ Y).app C y)
      exact hh.symm

  have s13 : ∀ (Y Y' P : Scheme.{u}) (q : Y ⟶ Spec (.of B)) (π : Y' ⟶ Y) (g : Y' ⟶ P) (U : Y.Opens) (C : P.Opens) (n : ℕ) (a : Fin (n + 1) → Γ(Y, U)) (b : Fin (n + 1) → Γ(P, C)), (∀ t : Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C), t ∈ Subring.closure (Set.range ((Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op).hom.comp (π.app U).hom) ∪ Set.range ((Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom.comp (g.app C).hom))) → (∀ t : Γ(Y, U), t ∈ Subring.closure (Set.range ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp (q.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range a)) → (∀ k, (Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op).hom (π.app U (a k)) = (Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom (g.app C (b k))) → ∀ t : Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C), t ∈ Subring.closure (Set.range ((Y'.presheaf.map (homOfLE (le_top : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ ⊤)).op).hom.comp ((π ≫ q).appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range ((Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom.comp (g.app C).hom)) := by
    intro Y Y' P q π g U C n a b hGen hA hkey
    have nat : ∀ x : Γ(Spec (.of B), ⊤),
        (Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op).hom
          (π.app U ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (q.appTop.hom x))) =
        (Y'.presheaf.map (homOfLE (le_top : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ ⊤)).op).hom
          ((π ≫ q).appTop.hom x) := by
      intro x
      change (q.appTop ≫ Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ π.app U ≫
          Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op) x =
        ((π ≫ q).appTop ≫ Y'.presheaf.map (homOfLE (le_top : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ ⊤)).op) x
      congr 1
      rw [Scheme.Hom.naturality_assoc, ← Functor.map_comp, Scheme.Hom.comp_appTop,
        Category.assoc]
      rfl
    set R := Subring.closure (Set.range ((Y'.presheaf.map (homOfLE (le_top : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ ⊤)).op).hom.comp ((π ≫ q).appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range ((Y'.presheaf.map (homOfLE (inf_le_right : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom.comp (g.app C).hom)) with hR
    set rL : Γ(Y, U) →+* Γ(Y', π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) :=
      (Y'.presheaf.map (homOfLE (inf_le_left : π ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ π ⁻¹ᵁ U)).op).hom.comp
        (π.app U).hom with hrL
    have hGT : Set.range ((Y.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
        (q.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range a ⊆
        (Subring.comap rL R : Set Γ(Y, U)) := by
      rintro x (⟨c, rfl⟩ | ⟨k, rfl⟩)
      · show rL _ ∈ R
        apply Subring.subset_closure
        left
        refine ⟨c, ?_⟩
        exact (nat ((Scheme.ΓSpecIso (.of B)).inv.hom c)).symm
      · show rL (a k) ∈ R
        apply Subring.subset_closure
        right
        exact ⟨b k, (hkey k).symm⟩
    have hTall : ∀ x : Γ(Y, U), rL x ∈ R := fun x => (Subring.closure_le.mpr hGT) (hA x)
    intro t
    refine (Subring.closure_le.mpr ?_) (hGen t)
    rintro _ (⟨x, rfl⟩ | ⟨y, rfl⟩)
    · exact hTall x
    · exact Subring.subset_closure (Or.inr ⟨y, rfl⟩)

  have s14 : ∀ (P Y : Scheme.{u}) (π : P ⟶ Y) (W : Y.Opens), IsIso (π ∣_ W) →
      ∀ V : Y.Opens, IsAffineOpen V → V ≤ W →
        IsAffineOpen (π ⁻¹ᵁ V) ∧ Function.Bijective (π.app V).hom := by
    intro P Y π W hiso V hV hVW
    have hrange : (π ∣_ W ≫ W.ι).opensRange = W := by
      rw [Scheme.Hom.opensRange_comp_of_isIso, Scheme.Opens.opensRange_ι]
    have hVr : V ≤ (π ∣_ W ≫ W.ι).opensRange := by rw [hrange]; exact hVW
    have hcomp : π ∣_ W ≫ W.ι = (π ⁻¹ᵁ W).ι ≫ π := morphismRestrict_ι π W
    have hle : π ⁻¹ᵁ V ≤ π ⁻¹ᵁ W := fun x hx => hVW hx
    have hpre : π ⁻¹ᵁ V ≤ (π ⁻¹ᵁ W).ι.opensRange := by
      rw [Scheme.Opens.opensRange_ι]; exact hle
    constructor
    · have h1 : IsAffineOpen ((π ∣_ W ≫ W.ι) ⁻¹ᵁ V) := hV.preimage_of_isOpenImmersion _ hVr
      rw [hcomp, Scheme.Hom.comp_preimage] at h1
      have h2 := h1.image_of_isOpenImmersion (π ⁻¹ᵁ W).ι
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
        inf_eq_right.mpr hle] at h2
      exact h2
    · have h1 : IsIso ((π ∣_ W ≫ W.ι).app V) := Scheme.Hom.isIso_app _ V hVr
      rw [hcomp, Scheme.Hom.comp_app] at h1
      have h2 : IsIso ((π ⁻¹ᵁ W).ι.app (π ⁻¹ᵁ V)) := Scheme.Hom.isIso_app _ _ hpre
      have h3 : IsIso (π.app V) :=
        @IsIso.of_isIso_comp_right _ _ _ _ _ (π.app V) ((π ⁻¹ᵁ W).ι.app (π ⁻¹ᵁ V)) h2 h1
      exact ConcreteCategory.bijective_of_isIso (π.app V)

  have s15 : ∀ (Z : Scheme.{u}) (𝒦 : Z.IdealSheafData) (W : 𝒦.subscheme.Opens),
      (W : Set 𝒦.subscheme).Nonempty → ∃ (U V₀ : Z.Opens) (hV₀ : IsAffineOpen V₀),
        𝒦.subschemeι ⁻¹ᵁ U = W ∧ V₀ ≤ U ∧ 𝒦.ideal ⟨V₀, hV₀⟩ ≠ ⊤ := by
    intro Z 𝒦 W hW
    obtain ⟨y, hy⟩ := hW
    obtain ⟨t, ht, hte⟩ := (𝒦.subschemeι.isClosedEmbedding.isInducing.isOpen_iff).mp W.isOpen
    have hyt : 𝒦.subschemeι y ∈ (⟨t, ht⟩ : Z.Opens) := by
      show 𝒦.subschemeι y ∈ t
      rw [← Set.mem_preimage, hte]
      exact hy
    obtain ⟨V₀, hV₀, hxV₀, hV₀U⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens hyt
    refine ⟨⟨t, ht⟩, V₀, hV₀, ?_, hV₀U, ?_⟩
    · ext1
      exact hte
    · intro htop
      have hsupp : 𝒦.subschemeι y ∈ (𝒦.support : Set Z) := by
        rw [← 𝒦.range_subschemeι]
        exact ⟨y, rfl⟩
      have h1 := (Scheme.IdealSheafData.mem_support_iff.mp hsupp) ⟨V₀, hV₀⟩
      rw [htop] at h1
      rw [Scheme.mem_zeroLocus_iff] at h1
      exact h1 1 trivial (by rw [Scheme.basicOpen_one]; exact hxV₀)

  obtain ⟨q, hq⟩ : ∃ q : 𝒦.subscheme ⟶ Spec (.of B), q = 𝒦.subschemeι ≫ h := ⟨_, rfl⟩
  haveI hqprop : IsProper q := by rw [hq]; infer_instance
  haveI : CompactSpace 𝒦.subscheme := QuasiCompact.compactSpace_of_compactSpace q
  haveI : IsLocallyNoetherian 𝒦.subscheme := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : IsNoetherian 𝒦.subscheme := ⟨⟩
  have hne : (𝒦.support : Set Z).Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro he
    exact h𝒦 ((Scheme.IdealSheafData.support_eq_bot_iff 𝒦).mp
      (TopologicalSpace.Closeds.coe_eq_empty.mp he))
  obtain ⟨x0, hx0⟩ := hne
  rw [← Scheme.IdealSheafData.range_subschemeι] at hx0
  obtain ⟨y0, -⟩ := hx0
  haveI : Nonempty 𝒦.subscheme := ⟨y0⟩
  obtain ⟨r, U, hUaff, hUcov, hUdense⟩ := wc_chow_dense_affine_charts 𝒦.subscheme
  let W : 𝒦.subscheme.Opens := ⨅ j, U j
  have hWcoe : (W : Set 𝒦.subscheme) = ⋂ j, (U j : Set 𝒦.subscheme) :=
    TopologicalSpace.Opens.coe_iInf U
  have hWdense : Dense (W : Set 𝒦.subscheme) := by rw [hWcoe]; exact hUdense
  have hWne : (W : Set 𝒦.subscheme).Nonempty := hWdense.nonempty
  have hWU : ∀ j, W ≤ U j := fun j => iInf_le U j
  have hgen := fun j => wc_chow_affine_generators B 𝒦.subscheme q (U j) (hUaff j)
  choose n a ha0 hagen using hgen
  have hcard : 0 < Fintype.card (∀ j, Fin (n j + 1)) := Fintype.card_pos
  let N : ℕ := Fintype.card (∀ j, Fin (n j + 1)) - 1
  let κ : Fin (N + 1) ≃ (∀ j, Fin (n j + 1)) :=
    (Fintype.equivFinOfCardEq (by omega : Fintype.card (∀ j, Fin (n j + 1)) = N + 1)).symm
  have hψU : ∀ j, W.ι ⁻¹ᵁ U j = ⊤ := by
    intro j
    apply top_le_iff.mp
    intro x _
    show W.ι x ∈ (U j : Set 𝒦.subscheme)
    have hx : W.ι x ∈ Set.range W.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx
    exact hWU j hx
  let s : Fin (N + 1) → Γ((W : Scheme.{u}), ⊤) :=
    fun L => ∏ j, W.ι.appLE (U j) ⊤ (hψU j).ge (a j (κ L j))
  have hs1 : s (κ.symm 0) = 1 := by
    simp only [s, Equiv.apply_symm_apply, Pi.zero_apply, ha0, map_one, Finset.prod_const_one]
  have hspan : Ideal.span (Set.range s) = ⊤ := by
    rw [Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨κ.symm 0, hs1⟩
  obtain ⟨e, hcov, hbo, huniv⟩ := wc_pm_segre_coords.{u} N
  obtain ⟨φ, hφC, hrel⟩ := huniv (W : Scheme.{u}) s hspan
  let γ : (W : Scheme.{u}) ⟶ 𝒦.subscheme ⨯ wcPm.{u} N := Limits.prod.lift W.ι φ
  haveI : CompactSpace (W : Scheme.{u}) :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (W : Set 𝒦.subscheme))
  haveI : IsNoetherian (W : Scheme.{u}) := ⟨⟩
  haveI : QuasiCompact γ := inferInstance
  let ιQ := γ.imageι
  let δ := γ.toImage
  have hδι : δ ≫ ιQ = γ := Scheme.Hom.toImage_imageι γ
  let π : γ.image ⟶ 𝒦.subscheme := ιQ ≫ Limits.prod.fst
  let g : γ.image ⟶ wcPm.{u} N := ιQ ≫ Limits.prod.snd
  have hδπ : δ ≫ π = W.ι := by
    show δ ≫ ιQ ≫ Limits.prod.fst = W.ι
    rw [← Category.assoc, hδι]
    exact Limits.prod.lift_fst _ _
  have hδg : δ ≫ g = φ := by
    show δ ≫ ιQ ≫ Limits.prod.snd = φ
    rw [← Category.assoc, hδι]
    exact Limits.prod.lift_snd _ _
  obtain ⟨hinj, hdense⟩ := wc_toImage_injective_dense _ _ γ
  haveI := hfstproper N 𝒦.subscheme
  haveI hπprop : IsProper π := by
    show IsProper (ιQ ≫ Limits.prod.fst)
    infer_instance
  have hiso : IsIso (π ∣_ W) := wc_isIso_restrict_of_section _ _ π W δ hinj hδπ
  haveI hπq : IsProper (π ≫ q) := inferInstance
  have hclosed : IsClosed (Set.range (Limits.prod.lift (π ≫ q) g)) := by
    haveI := hfstproper N (Spec (.of B))
    haveI : IsProper (Limits.prod.lift (π ≫ q) g ≫ Limits.prod.fst) := by
      rw [Limits.prod.lift_fst]
      infer_instance
    haveI : IsProper (Limits.prod.lift (π ≫ q) g) := IsProper.of_comp _ Limits.prod.fst
    have hm := (Limits.prod.lift (π ≫ q) g).isClosedMap
    simpa using hm _ isClosed_univ
  have hπcov : ∀ z : γ.image, ∃ j, π z ∈ U j := by
    intro z
    have hz : π z ∈ (⊤ : 𝒦.subscheme.Opens) := trivial
    rw [← hUcov] at hz
    exact TopologicalSpace.Opens.mem_iSup.mp hz
  have hcover := wc_chow_charts_cover_K 𝒦.subscheme γ.image (W : Scheme.{u}) (wcPm.{u} N) π g δ
    W.ι φ r U n a N κ (wcPmChart.{u} N) e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel hcov hbo
    hπcov
  have hCI : IsClosedImmersion (Limits.prod.lift (π ≫ q) g) := by
    refine wc_closed_immersion_of_charts B γ.image (π ≫ q) N g {J | ∃ j, κ J j = 0}
      wc_prod_affine_opens_gen hclosed ?_ ?_
    · intro z
      obtain ⟨J, hJ, hz⟩ := hcover z
      exact ⟨J, hJ, hz⟩
    · rintro J ⟨j, hj⟩
      have hCaff : IsAffineOpen (wcPmChart.{u} N J) :=
        @Proj.isAffineOpen_basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) MvPolynomial.gradedAlgebra
          (MvPolynomial.X J) 1
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X _ J))
          one_pos
      obtain ⟨hVaff, hVgen⟩ := s12 𝒦.subscheme (wcPm.{u} N) γ.image ιQ (U j) (wcPmChart.{u} N J)
        (hUaff j) hCaff
      have hkey := wc_chow_key_identity 𝒦.subscheme γ.image (W : Scheme.{u}) (wcPm.{u} N) π g δ
        W.ι φ r U n a N κ (wcPmChart.{u} N) e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel j J hj
      have hGen := s13 𝒦.subscheme γ.image (wcPm.{u} N) q π g (U j) (wcPmChart.{u} N J) (n j)
        (a j) (fun k => e J (κ.symm (Function.update (κ J) j k))) hVgen (hagen j) hkey
      have hle := wc_chow_chart_contained B 𝒦.subscheme γ.image (W : Scheme.{u}) q N π g δ (U j) J
        wc_prod_affine_opens_gen inferInstance hdense (by rw [hδπ]; exact hψU j) hVaff hGen
      exact ⟨π ⁻¹ᵁ U j ⊓ g ⁻¹ᵁ wcPmChart.{u} N J, inf_le_right, le_inf hle le_rfl, hVaff, hGen⟩

  obtain ⟨U0, V₀, hV₀, hUW, hV₀U, h𝒦V₀⟩ := s15 Z 𝒦 W hWne
  have hstar : ∀ (V : Z.Opens) (hV : IsAffineOpen V),
      RingHom.ker (𝒦.subschemeι.app V).hom = 𝒦.ideal ⟨V, hV⟩ := by
    intro V hV
    have hk := Scheme.Hom.ker_apply 𝒦.subschemeι ⟨V, hV⟩
    rw [Scheme.IdealSheafData.ker_subschemeι] at hk
    exact hk.symm
  have hcomp : ∀ V : Z.Opens, ((π ≫ 𝒦.subschemeι).app V).hom =
      (π.app (𝒦.subschemeι ⁻¹ᵁ V)).hom.comp (𝒦.subschemeι.app V).hom := by
    intro V
    rw [Scheme.Hom.comp_app]
    rfl
  refine ⟨γ.image, π ≫ 𝒦.subschemeι, N, g, U0, V₀, hV₀, inferInstance, ?_, hV₀U, h𝒦V₀, ?_, ?_⟩
  · have e1 : (π ≫ 𝒦.subschemeι) ≫ h = π ≫ q := by rw [hq, Category.assoc]
    rw [e1]
    exact hCI
  · intro V hV x hx
    have hx0 : (𝒦.subschemeι.app V).hom x = 0 := by
      rw [← RingHom.mem_ker, hstar V hV]
      exact hx
    rw [hcomp V]
    exact (congrArg (π.app (𝒦.subschemeι ⁻¹ᵁ V)).hom hx0).trans (map_zero _)
  · intro V hV hVU
    have hiV : IsAffineOpen (𝒦.subschemeι ⁻¹ᵁ V) := hV.preimage _
    have hiVW : 𝒦.subschemeι ⁻¹ᵁ V ≤ W :=
      le_trans (𝒦.subschemeι.preimage_mono hVU) (le_of_eq hUW)
    obtain ⟨hA, hB⟩ := s14 γ.image 𝒦.subscheme π W hiso _ hiV hiVW
    have hsurj := (isClosedImmersion_iff_isAffineHom.mp
      (inferInstance : IsClosedImmersion 𝒦.subschemeι)).2 V hV
    refine ⟨hA, ?_, ?_⟩
    · rw [hcomp V]
      exact hB.2.comp hsurj
    · rw [hcomp V]
      exact (RingHom.ker_comp_of_injective _ hB.1).trans (hstar V hV)

theorem wc_cn_pb_basic_good_cover : ∀ (X : Scheme.{u}) (𝓑 : X.Opens → Prop), (∀ V V' : X.Opens, 𝓑 V → V' ≤ V → IsAffineOpen V' → 𝓑 V') → (∀ x : X, ∃ V : X.Opens, 𝓑 V ∧ x ∈ V) → ∀ W : X.Opens, IsAffineOpen W → ∃ (k : ℕ) (g : Fin k → Γ(X, W)), Ideal.span (Set.range g) = ⊤ ∧ ∀ i, 𝓑 (X.basicOpen (g i)) :=
by
  intro X 𝓑 hher hcov W hW
  classical
  let S : Set Γ(X, W) := {f | 𝓑 (X.basicOpen f)}
  have hcover : W ≤ ⨆ f : S, X.basicOpen (f : Γ(X, W)) := by
    intro x hxW
    obtain ⟨V, hBV, hxV⟩ := hcov x
    obtain ⟨f, hfV, hxf⟩ := hW.exists_basicOpen_le (⟨x, hxV⟩ : V) hxW
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨f, hher _ _ hBV hfV (hW.basicOpen f)⟩, hxf⟩
  have hspan : Ideal.span S = ⊤ := (hW.self_le_iSup_basicOpen_iff (s := S)).mp hcover
  obtain ⟨s', hs'S, hs'⟩ := (Ideal.span_eq_top_iff_finite S).mp hspan
  refine ⟨s'.card, fun i => ((s'.equivFin.symm i : ↥s') : Γ(X, W)), ?_, fun i => ?_⟩
  · rw [eq_top_iff, ← hs']
    apply Ideal.span_mono
    intro y hy
    refine ⟨s'.equivFin ⟨y, hy⟩, ?_⟩
    simp
  · exact hs'S (s'.equivFin.symm i).property

theorem wc_cn_pb_affine_tensor_sections : ∀ (Z P : Scheme.{u}) (q : P ⟶ Z) (F : Z.Modules), wcQcoh F → ∀ (U : Z.Opens) (V : P.Opens), IsAffineOpen U → IsAffineOpen V → ∀ (hle : V ≤ q ⁻¹ᵁ U), letI := (q.appLE U V hle).hom.toAlgebra; ∃ e : TensorProduct Γ(Z, U) Γ(P, V) Γ(F, U) ≃ₗ[Γ(P, V)] Γ((Scheme.Modules.pullback q).obj F, V), ∀ (a : Γ(P, V)) (x : Γ(F, U)), e (a ⊗ₜ[Γ(Z, U)] x) = a • (((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction q).unit.app F) U x) :=
by



  have hresF : ∀ {X : Scheme.{u}} (N : X.Modules) {W1 W2 W3 : X.Opens} (h1 : W2 ≤ W1) (h2 : W3 ≤ W2) (x : Γ(N, W1)), (N.presheaf.map (homOfLE h2).op).hom ((N.presheaf.map (homOfLE h1).op).hom x) = (N.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X N W1 W2 W3 h1 h2 x
    rw [show homOfLE (h2.trans h1) = homOfLE h2 ≫ homOfLE h1 from Subsingleton.elim _ _, op_comp, Functor.map_comp]
    rfl
  have hidF : ∀ {X : Scheme.{u}} (N : X.Modules) {W : X.Opens} (h : W ≤ W) (x : Γ(N, W)), (N.presheaf.map (homOfLE h).op).hom x = x := by
    intro X N W h x
    rw [show homOfLE h = 𝟙 W from Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hresZ : ∀ {X : Scheme.{u}} {W1 W2 W3 : X.Opens} (h1 : W2 ≤ W1) (h2 : W3 ≤ W2) (x : Γ(X, W1)), (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) = (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X W1 W2 W3 h1 h2 x
    rw [show homOfLE (h2.trans h1) = homOfLE h2 ≫ homOfLE h1 from Subsingleton.elim _ _, op_comp, Functor.map_comp]
    rfl
  have hidZ : ∀ {X : Scheme.{u}} {W : X.Opens} (h : W ≤ W) (x : Γ(X, W)), (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X W h x
    rw [show homOfLE h = 𝟙 W from Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hnat : ∀ {X : Scheme.{u}} {M N : X.Modules} (g : M ⟶ N) {W W' : X.Opens} (h : W' ≤ W) (x : Γ(M, W)), (Scheme.Modules.Hom.app g W').hom ((M.presheaf.map (homOfLE h).op).hom x) = (N.presheaf.map (homOfLE h).op).hom ((Scheme.Modules.Hom.app g W).hom x) := by
    intro X M N g W W' h x
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g) (homOfLE h).op x
  have hinv : ∀ {X : Scheme.{u}} {N N' : X.Modules} (i : N ≅ N') (W : X.Opens) (y : Γ(N, W)), (Scheme.Modules.Hom.app i.inv W).hom ((Scheme.Modules.Hom.app i.hom W).hom y) = y := by
    intro X N N' i W y
    have := congrArg (fun f => (Scheme.Modules.Hom.app f W).hom y) i.hom_inv_id
    simp only [Scheme.Modules.Hom.comp_app, Scheme.Modules.Hom.id_app] at this
    exact this
  have hinv' : ∀ {X : Scheme.{u}} {N N' : X.Modules} (i : N ≅ N') (W : X.Opens) (y : Γ(N', W)), (Scheme.Modules.Hom.app i.hom W).hom ((Scheme.Modules.Hom.app i.inv W).hom y) = y := by
    intro X N N' i W y
    have := congrArg (fun f => (Scheme.Modules.Hom.app f W).hom y) i.inv_hom_id
    simp only [Scheme.Modules.Hom.comp_app, Scheme.Modules.Hom.id_app] at this
    exact this
  have hresR : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] (M : Y.Modules) {W W' : X.Opens} (h : W' ≤ W) (h' : f ''ᵁ W' ≤ f ''ᵁ W) (z : Γ(M, f ''ᵁ W)), ((M.restrict f).presheaf.map (homOfLE h).op).hom z = (M.presheaf.map (homOfLE h').op).hom z := by
    intro X Y f _ M W W' h h' z
    rw [show homOfLE h' = f.opensFunctor.map (homOfLE h) from Subsingleton.elim _ _]
    rfl
  have hresP : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (M : X.Modules) {W W' : Y.Opens} (h : W' ≤ W) (h' : f ⁻¹ᵁ W' ≤ f ⁻¹ᵁ W) (z : Γ(M, f ⁻¹ᵁ W)), (((Scheme.Modules.pushforward f).obj M).presheaf.map (homOfLE h).op).hom z = (M.presheaf.map (homOfLE h').op).hom z := by
    intro X Y f M W W' h h' z
    rw [show homOfLE h' = (TopologicalSpace.Opens.map f.base).map (homOfLE h) from Subsingleton.elim _ _]
    rfl
  have hlinTop : ∀ {R : CommRingCat.{u}} {N N' : (Spec R).Modules} (i : N ⟶ N') (r : R) (x : Γ(N, ⊤)), (Scheme.Modules.Hom.app i ⊤).hom (r • x) = r • (Scheme.Modules.Hom.app i ⊤).hom x := by
    intro R N N' i r x
    rw [Scheme.Modules.smul_Spec_def, Scheme.Modules.smul_Spec_def, Scheme.Modules.Hom.app_smul]
  have hfromTilde : ∀ {R : CommRingCat.{u}} (N : (Spec R).Modules) (y : Γ(N, ⊤)), (Scheme.Modules.Hom.app N.fromTildeΓ ⊤).hom ((tilde.toOpen ((modulesSpecToSheaf.obj N).presheaf.obj (Opposite.op ⊤)) ⊤).hom y) = y := by
    intro R N y
    have h := congrArg (fun f => f.hom y) (Scheme.Modules.toOpen_fromTildeΓ_app N ⊤)
    refine h.trans ?_
    change ((modulesSpecToSheaf.obj N).obj.map (homOfLE le_top).op).hom y = y
    rw [show (homOfLE (le_top : (⊤ : (Spec R).Opens) ≤ ⊤)) = 𝟙 _ from Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id]
    rfl



  have s6 : ∀ (X Y : Scheme.{u}) (j : X ⟶ Y) [IsOpenImmersion j] (G : Y.Modules) (W : Y.Opens) (x : Γ(G, W)), (Scheme.Modules.Hom.app ((Scheme.Modules.restrictFunctorIsoPullback j).hom.app G) (j ⁻¹ᵁ W)).hom ((G.presheaf.map (homOfLE (Scheme.Hom.image_preimage_le j W)).op).hom x) = (Scheme.Modules.Hom.app ((Scheme.Modules.pullbackPushforwardAdjunction j).unit.app G) W).hom x := by
    intro X Y j _ G W x
    have h := (Scheme.Modules.restrictAdjunction j).unit_leftAdjointUniq_hom_app (Scheme.Modules.pullbackPushforwardAdjunction j) G
    have h2 := congrArg (fun φ => (Scheme.Modules.Hom.app φ W).hom x) h
