      obtain ⟨k, w, hw⟩ := Blift I n z

      obtain ⟨m, a, b, -⟩ : ∃ (m : Λ) (_ : i ⟶ m) (_ : k ⟶ m), True :=
        ⟨_, IsFiltered.leftToMax i k, IsFiltered.rightToMax i k, trivial⟩
      have hmor1 : (I.map b ≫ (Limits.cokernel.π α).app m) ≫
          Limits.colimit.ι (Limits.cokernel α) m =
          Limits.colimit.ι I k ≫ Limits.colim.map (Limits.cokernel.π α) := by
        rw [Category.assoc, ← Limits.colimit.ι_map, ← Category.assoc, Limits.colimit.w]
      have hy : (x₃.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map a)) (add_zero n) -
          (w.comp (Abelian.Ext.mk₀ (I.map b)) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app m)) (add_zero n)).comp
          (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) m)) (add_zero n) = 0 := by
        have e := map_sub ((Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) m)).postcomp
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))) (add_zero n))
          (x₃.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map a)) (add_zero n))
          ((w.comp (Abelian.Ext.mk₀ (I.map b)) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app m)) (add_zero n))
        refine e.trans ?_
        change (x₃.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map a)) (add_zero n)).comp
            (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) m)) (add_zero n) -
          ((w.comp (Abelian.Ext.mk₀ (I.map b)) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app m)) (add_zero n)).comp
            (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) m)) (add_zero n) = 0
        simp only [cc]
        rw [Limits.colimit.w, hmor1, ← cc w, hw, hz', sub_self]

      obtain ⟨j, g, hg⟩ := ih (Limits.cokernel α) m _ hy
      have hmor2 : (I.map b ≫ (Limits.cokernel.π α).app m) ≫ (Limits.cokernel α).map g =
          I.map (b ≫ g) ≫ (Limits.cokernel.π α).app j := by
        rw [Category.assoc, ← (Limits.cokernel.π α).naturality g, Functor.map_comp, Category.assoc]
      have hg' : x₃.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map (a ≫ g))) (add_zero n) =
          (w.comp (Abelian.Ext.mk₀ (I.map (b ≫ g))) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app j)) (add_zero n) := by
        have e := map_sub ((Abelian.Ext.mk₀ ((Limits.cokernel α).map g)).postcomp
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))) (add_zero n))
          (x₃.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map a)) (add_zero n))
          ((w.comp (Abelian.Ext.mk₀ (I.map b)) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app m)) (add_zero n))
        have e' := e.symm.trans hg
        change (x₃.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map a)) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel α).map g)) (add_zero n) -
          ((w.comp (Abelian.Ext.mk₀ (I.map b)) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app m)) (add_zero n)).comp
            (Abelian.Ext.mk₀ ((Limits.cokernel α).map g)) (add_zero n) = 0 at e'
        simp only [cc] at e'
        rw [← Functor.map_comp, hmor2] at e'
        rw [cc]
        exact sub_eq_zero.mp e'

      refine ⟨j, a ≫ g, ?_⟩
      have hnat_f : (hSk i).extClass.comp (Abelian.Ext.mk₀ (F.map (a ≫ g))) (add_zero 1) =
          (Abelian.Ext.mk₀ ((Limits.cokernel α).map (a ≫ g))).comp (hSk j).extClass (zero_add 1) :=
        (hSk i).extClass_naturality (hSk j)
          { τ₁ := F.map (a ≫ g)
            τ₂ := I.map (a ≫ g)
            τ₃ := (Limits.cokernel α).map (a ≫ g)
            comm₁₂ := α.naturality (a ≫ g)
            comm₂₃ := (Limits.cokernel.π α).naturality (a ≫ g) }
      have hzero : (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app j)).comp (hSk j).extClass
          (zero_add 1) = 0 := (hSk j).comp_extClass
      calc x.comp (Abelian.Ext.mk₀ (F.map (a ≫ g))) (add_zero (n + 1))
          = (x₃.comp (hSk i).extClass rfl).comp (Abelian.Ext.mk₀ (F.map (a ≫ g)))
              (add_zero (n + 1)) := by rw [hx₃]
        _ = x₃.comp ((hSk i).extClass.comp (Abelian.Ext.mk₀ (F.map (a ≫ g))) (add_zero 1)) rfl :=
            Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega)
        _ = x₃.comp ((Abelian.Ext.mk₀ ((Limits.cokernel α).map (a ≫ g))).comp (hSk j).extClass
              (zero_add 1)) rfl := by rw [hnat_f]
        _ = (x₃.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map (a ≫ g))) (add_zero n)).comp
              (hSk j).extClass rfl :=
            (Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega)).symm
        _ = ((w.comp (Abelian.Ext.mk₀ (I.map (b ≫ g))) (add_zero n)).comp
              (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app j)) (add_zero n)).comp
              (hSk j).extClass rfl := by rw [hg']
        _ = (w.comp (Abelian.Ext.mk₀ (I.map (b ≫ g))) (add_zero n)).comp
              ((Abelian.Ext.mk₀ ((Limits.cokernel.π α).app j)).comp (hSk j).extClass
                (zero_add 1)) rfl :=
            Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega)
        _ = 0 := by rw [hzero, Abelian.Ext.comp_zero]

  let D' : AsSmall.{u+1} J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    AsSmall.equiv.{u, u, u+1}.symm.functor ⋙ D
  let k₀ : AsSmall.{u+1} J := AsSmall.equiv.{u, u, u+1}.functor.obj j₀
  let e : Limits.colimit D' ≅ c.pt :=
    (Limits.colimit.isColimit D').coconePointUniqueUpToIso
      (hc.whiskerEquivalence AsSmall.equiv.{u, u, u+1}.symm)
  have he : Limits.colimit.ι D' k₀ ≫ e.hom = c.ι.app j₀ :=
    Limits.IsColimit.comp_coconePointUniqueUpToIso_hom _ _ k₀
  let x' : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))) (D'.obj k₀) n := x
  have h2 : (x'.comp (Abelian.Ext.mk₀ (Limits.colimit.ι D' k₀)) (add_zero n)).comp
      (Abelian.Ext.mk₀ e.hom) (add_zero n) = 0 := by
    rw [cc x', he]
    exact hx
  have hx' : x'.comp (Abelian.Ext.mk₀ (Limits.colimit.ι D' k₀)) (add_zero n) = 0 := by
    have h1 := cc (x'.comp (Abelian.Ext.mk₀ (Limits.colimit.ι D' k₀)) (add_zero n)) e.hom e.inv
    rw [Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at h1
    rw [← h1, h2, Abelian.Ext.zero_comp]
  obtain ⟨k, f', hf'⟩ := main (AsSmall.{u+1} J) n D' k₀ x' hx'
  exact ⟨AsSmall.equiv.{u, u, u+1}.symm.functor.obj k,
    AsSmall.equiv.{u, u, u+1}.symm.functor.map f', hf'⟩

theorem wc_et_quot_kill_of_colim_vanish : ∀ (Y : Scheme.{u}) (W : Set Y) (J : Type u) [SmallCategory J] [IsFiltered J], letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; (∀ (D' : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (c' : Limits.Cocone D'), Nonempty (Limits.IsColimit c') → ∀ (n : ℕ) (j₀ : J) (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (D'.obj j₀) n), x.comp (Abelian.Ext.mk₀ (c'.ι.app j₀)) (add_zero n) = 0 → ∃ (j : J) (f : j₀ ⟶ j), x.comp (Abelian.Ext.mk₀ (D'.map f)) (add_zero n) = 0) → (∀ (D' : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (c' : Limits.Cocone D'), Nonempty (Limits.IsColimit c') → ∀ (Hd : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιd : Hd ⟶ D'), (∀ j, Mono (ιd.app j)) → (∀ j, wcSuppIn Y W (Hd.obj j)) → (∀ (j : J) (H₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ D'.obj j), wcSuppIn Y W H₂ → ∃ χ' : H₂ ⟶ Hd.obj j, χ' ≫ ιd.app j = χ) → ∀ (cH : Limits.Cocone Hd), Nonempty (Limits.IsColimit cH) → ∀ (HX : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιX : HX ⟶ c'.pt), Mono ιX → wcSuppIn Y W HX → (∀ (H₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ c'.pt), wcSuppIn Y W H₂ → ∃ χ' : H₂ ⟶ HX, χ' ≫ ιX = χ) → ∀ (φ : cH.pt ⟶ HX), (∀ j, cH.ι.app j ≫ φ ≫ ιX = ιd.app j ≫ c'.ι.app j) → IsIso φ) → ∀ (D : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (X : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (κ : D ⟶ (Functor.const J).obj X), Nonempty (Limits.IsColimit (Limits.Cocone.mk X κ)) → (∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιH : H ⟶ X), Mono ιH → wcSuppIn Y W H → (∀ (H₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ X), wcSuppIn Y W H₂ → ∃ χ' : H₂ ⟶ H, χ' ≫ ιH = χ) → ∀ q : ℕ, Subsingleton (wcEtExt Y (Limits.cokernel ιH) (q + 1))) → ∀ (F₀ G' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιG : G' ⟶ F₀), wcSuppIn Y W G' → ∀ (j₀ : J) (w₀ : F₀ ⟶ D.obj j₀) (n : ℕ) (ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιG) (n + 1)), ∃ (j : J) (f : j₀ ⟶ j) (H' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιH : H' ⟶ D.obj j), Mono ιH ∧ wcSuppIn Y W H' ∧ ∃ (c : Limits.cokernel ιG ⟶ Limits.cokernel ιH), Limits.cokernel.π ιG ≫ c = (w₀ ≫ D.map f) ≫ Limits.cokernel.π ιH ∧ ζ.comp (Abelian.Ext.mk₀ c) (add_zero (n + 1)) = 0 :=
by
  intro Y W J _ _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro hL hM D X κ hXcol hA F₀ G' ιG hG' j₀ w₀ n ζ
  obtain ⟨hX⟩ := hXcol

  choose Hobj ιo hmono hsupp huniv using
    fun j => wc_et_max_supported_subsheaf Y W (D.obj j)
  have hmapex : ∀ (j k : J) (f : j ⟶ k), ∃ h : Hobj j ⟶ Hobj k, h ≫ ιo k = ιo j ≫ D.map f :=
    fun j k f => huniv k (Hobj j) (ιo j ≫ D.map f) (hsupp j)
  choose Hmap hHmap using hmapex
  let Hd : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    { obj := Hobj
      map := fun {j k} f => Hmap j k f
      map_id := fun j => by
        haveI := hmono j
        show Hmap j j (𝟙 j) = 𝟙 (Hobj j)
        rw [← cancel_mono (ιo j), hHmap j j (𝟙 j), D.map_id, Category.comp_id, Category.id_comp]
      map_comp := fun {j k l} f g => by
        haveI := hmono l
        show Hmap j l (f ≫ g) = Hmap j k f ≫ Hmap k l g
        rw [← cancel_mono (ιo l), hHmap j l (f ≫ g), Category.assoc, hHmap k l g,
          ← Category.assoc, hHmap j k f, Category.assoc, D.map_comp] }
  let ιd : Hd ⟶ D :=
    { app := ιo
      naturality := fun j k f => hHmap j k f }

  obtain ⟨HX, ιX, hXmono, hXsupp, hXuniv⟩ := wc_et_max_supported_subsheaf Y W X
  haveI := hXmono
  choose ψ hψ using fun j => hXuniv (Hobj j) (ιo j ≫ κ.app j) (hsupp j)
  have hκ : ∀ (j k : J) (f : j ⟶ k), D.map f ≫ κ.app k = κ.app j :=
    fun j k f => (Limits.Cocone.mk X κ).w f
  have hψnat : ∀ (j k : J) (f : j ⟶ k), Hd.map f ≫ ψ k = ψ j := by
    intro j k f
    rw [← cancel_mono ιX, Category.assoc, hψ k, ← Category.assoc]
    change (Hmap j k f ≫ ιo k) ≫ κ.app k = ψ j ≫ ιX
    rw [hHmap j k f, hψ j, Category.assoc, hκ j k f]
  let cψ : Limits.Cocone Hd := Limits.Cocone.mk HX
    { app := ψ
      naturality := fun j k f => (hψnat j k f).trans (Category.comp_id (ψ j)).symm }
  let φ : Limits.colimit Hd ⟶ HX := Limits.colimit.desc Hd cψ
  have hφ : ∀ j, Limits.colimit.ι Hd j ≫ φ = ψ j := fun j => Limits.colimit.ι_desc cψ j
  have hφX : ∀ j, (Limits.colimit.cocone Hd).ι.app j ≫ φ ≫ ιX =
      ιd.app j ≫ (Limits.Cocone.mk X κ).ι.app j := by
    intro j
    change Limits.colimit.ι Hd j ≫ φ ≫ ιX = ιo j ≫ κ.app j
    rw [← Category.assoc, hφ j, hψ j]
  haveI hφiso : IsIso φ := hM D (Limits.Cocone.mk X κ) ⟨hX⟩ Hd ιd hmono hsupp huniv
    (Limits.colimit.cocone Hd) ⟨Limits.colimit.isColimit Hd⟩ HX ιX hXmono hXsupp hXuniv φ hφX

  have hQw : ∀ (j k : J) (f : j ⟶ k), ιo j ≫ D.map f ≫ Limits.cokernel.π (ιo k) = 0 := by
    intro j k f
    rw [← Category.assoc, ← hHmap j k f, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  let Qmap : ∀ (j k : J) (f : j ⟶ k), Limits.cokernel (ιo j) ⟶ Limits.cokernel (ιo k) :=
    fun j k f => Limits.cokernel.desc (ιo j) (D.map f ≫ Limits.cokernel.π (ιo k)) (hQw j k f)
  have hQπ : ∀ (j k : J) (f : j ⟶ k),
      Limits.cokernel.π (ιo j) ≫ Qmap j k f = D.map f ≫ Limits.cokernel.π (ιo k) :=
    fun j k f => Limits.cokernel.π_desc _ _ _
  let Q : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    { obj := fun j => Limits.cokernel (ιo j)
      map := fun {j k} f => Qmap j k f
      map_id := fun j => by
        show Qmap j j (𝟙 j) = 𝟙 _
        rw [← cancel_epi (Limits.cokernel.π (ιo j)), hQπ j j (𝟙 j), D.map_id,
          Category.id_comp, Category.comp_id]
      map_comp := fun {j k l} f g => by
        show Qmap j l (f ≫ g) = Qmap j k f ≫ Qmap k l g
        rw [← cancel_epi (Limits.cokernel.π (ιo j)), hQπ j l (f ≫ g), ← Category.assoc,
          hQπ j k f, Category.assoc, hQπ k l g, D.map_comp, Category.assoc] }
  let πd : D ⟶ Q :=
    { app := fun j => Limits.cokernel.π (ιo j)
      naturality := fun j k f => (hQπ j k f).symm }
  have hkw : ∀ j, ιo j ≫ κ.app j ≫ Limits.cokernel.π ιX = 0 := by
    intro j
    rw [← Category.assoc, ← hψ j, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  let kbapp : ∀ j, Limits.cokernel (ιo j) ⟶ Limits.cokernel ιX :=
    fun j => Limits.cokernel.desc (ιo j) (κ.app j ≫ Limits.cokernel.π ιX) (hkw j)
  have hkb : ∀ j, Limits.cokernel.π (ιo j) ≫ kbapp j = κ.app j ≫ Limits.cokernel.π ιX :=
    fun j => Limits.cokernel.π_desc _ _ _
  let kb : Q ⟶ (Functor.const J).obj (Limits.cokernel ιX) :=
    { app := kbapp
      naturality := fun j k f => by
        refine Eq.trans ?_ (Category.comp_id (kbapp j)).symm
        show Qmap j k f ≫ kbapp k = kbapp j
        rw [← cancel_epi (Limits.cokernel.π (ιo j)), ← Category.assoc,
          hQπ j k f, Category.assoc, hkb k, hkb j, ← Category.assoc, hκ j k f] }

  have hkbcol : Limits.IsColimit (Limits.Cocone.mk (Limits.cokernel ιX) kb) := by
    refine Limits.IsColimit.ofExistsUnique (fun s => ?_)
    let t : Limits.Cocone D := Limits.Cocone.mk s.pt (πd ≫ s.ι)
    let u : X ⟶ s.pt := hX.desc t
    have hu : ∀ j, κ.app j ≫ u = Limits.cokernel.π (ιo j) ≫ s.ι.app j := fun j => hX.fac t j
    have h1 : φ ≫ ιX ≫ u = 0 := by
      apply Limits.colimit.hom_ext
      intro j
      calc Limits.colimit.ι Hd j ≫ φ ≫ ιX ≫ u
          = (Limits.colimit.ι Hd j ≫ φ) ≫ ιX ≫ u := (Category.assoc _ _ _).symm
        _ = (ψ j ≫ ιX) ≫ u := by rw [hφ j, Category.assoc]
        _ = ιo j ≫ (κ.app j ≫ u) := by rw [hψ j, Category.assoc]
        _ = (ιo j ≫ Limits.cokernel.π (ιo j)) ≫ s.ι.app j := by rw [hu j, Category.assoc]
        _ = Limits.colimit.ι Hd j ≫ 0 := by
          rw [Limits.cokernel.condition, Limits.zero_comp, Limits.comp_zero]
    have hu0 : ιX ≫ u = 0 := by
      calc ιX ≫ u = inv φ ≫ φ ≫ ιX ≫ u := (IsIso.inv_hom_id_assoc φ _).symm
        _ = 0 := by rw [h1, Limits.comp_zero]
    refine ⟨Limits.cokernel.desc ιX u hu0, fun j => ?_, fun l hl => ?_⟩
    · show kbapp j ≫ Limits.cokernel.desc ιX u hu0 = s.ι.app j
      rw [← cancel_epi (Limits.cokernel.π (ιo j)), ← Category.assoc, hkb j, Category.assoc,
        Limits.cokernel.π_desc, hu j]
    · rw [← cancel_epi (Limits.cokernel.π ιX), Limits.cokernel.π_desc]
      apply hX.hom_ext
      intro j
      show κ.app j ≫ Limits.cokernel.π ιX ≫ l = κ.app j ≫ u
      have hlj : kbapp j ≫ l = s.ι.app j := hl j
      rw [hu j, ← Category.assoc, ← hkb j, Category.assoc, hlj]

  obtain ⟨g, hg⟩ := huniv j₀ G' (ιG ≫ w₀) hG'
  have hc0w : ιG ≫ w₀ ≫ Limits.cokernel.π (ιo j₀) = 0 := by
    rw [← Category.assoc, ← hg, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  let c₀ : Limits.cokernel ιG ⟶ Limits.cokernel (ιo j₀) :=
    Limits.cokernel.desc ιG (w₀ ≫ Limits.cokernel.π (ιo j₀)) hc0w
  have hc₀ : Limits.cokernel.π ιG ≫ c₀ = w₀ ≫ Limits.cokernel.π (ιo j₀) :=
    Limits.cokernel.π_desc _ _ _
  let x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Q.obj j₀) (n + 1) :=
    ζ.comp (Abelian.Ext.mk₀ c₀) (add_zero (n + 1))
  have hy : x.comp (Abelian.Ext.mk₀ ((Limits.Cocone.mk (Limits.cokernel ιX) kb).ι.app j₀))
      (add_zero (n + 1)) = 0 := by
    have hs : Subsingleton (wcEtExt Y (Limits.cokernel ιX) (n + 1)) :=
      hA HX ιX hXmono hXsupp hXuniv n
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιX)
        (n + 1)) at hs
    exact @Subsingleton.elim _ hs _ _
  obtain ⟨j, f, hf⟩ := hL Q (Limits.Cocone.mk (Limits.cokernel ιX) kb) ⟨hkbcol⟩ (n + 1) j₀ x hy

  refine ⟨j, f, Hobj j, ιo j, hmono j, hsupp j, c₀ ≫ Qmap j₀ j f, ?_, ?_⟩
  · rw [← Category.assoc, hc₀]
    simp only [Category.assoc, hQπ]
  · have h2 : ζ.comp (Abelian.Ext.mk₀ (c₀ ≫ Qmap j₀ j f)) (add_zero (n + 1)) =
        (ζ.comp (Abelian.Ext.mk₀ c₀) (add_zero (n + 1))).comp (Abelian.Ext.mk₀ (Qmap j₀ j f))
          (add_zero (n + 1)) := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    rw [h2]
    exact hf

theorem wc_et_push_locSurj_of_propB : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (∀ (V : B.Etale) (ι : Type u) (U : ι → X.Etale) (u : ∀ k, U k ⟶ (wcEtBaseChange g).obj V), (∀ z : ((wcEtBaseChange g).obj V).left, ∃ k, z ∈ Set.range (u k).left) → ∀ v : V.left, ∃ (V' : B.Etale) (e : V' ⟶ V) (n : ℕ) (Wi : Fin n → X.Etale) (w : ∀ i, Wi i ⟶ (wcEtBaseChange g).obj V'), v ∈ Set.range e.left ∧ (∀ i, IsOpenImmersion (w i).left) ∧ (∀ i j, i ≠ j → Disjoint (Set.range (w i).left) (Set.range (w j).left)) ∧ (∀ z : ((wcEtBaseChange g).obj V').left, ∃ i, z ∈ Set.range (w i).left) ∧ ∀ i, ∃ (k : ι) (a : Wi i ⟶ U k), a ≫ u k = w i ≫ (wcEtBaseChange g).map e) → ∀ (F G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (φ : F ⟶ G), Epi φ → Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology B) (Functor.whiskerLeft (wcEtBaseChange g).op φ.hom) :=
by
  intro X B g hB F G φ hφ
  have hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) φ.hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ

  have s1 : ∀ (T : X.Etale) (s : G.obj.obj (Opposite.op T)), ∃ (ι : Type u) (U : ι → X.Etale)
      (u : ∀ k, U k ⟶ T), (∀ z : T.left, ∃ k, z ∈ Set.range (u k).left) ∧
      ∀ k, ∃ y : F.obj.obj (Opposite.op (U k)),
        (φ.hom.app (Opposite.op (U k))).hom y = (G.obj.map (u k).op).hom s := by
    intro T s
    have hR := hls.imageSieve_mem (U := T) s
    obtain ⟨𝒰, h𝒰o, h𝒰, hle⟩ := (Scheme.mem_smallGrothendieckTopology _ _).1 hR
    have := h𝒰o
    have : Scheme.JointlySurjective.{u}
        (Scheme.precoverage (@Etale : MorphismProperty Scheme.{u})) :=
      Scheme.instJointlySurjectivePrecoverage
    unfold Scheme.Cover.toPresieveOverProp at hle
    have crux : ∀ {ι : Type u} (X' : ι → X.Etale) (f' : ∀ j, X' j ⟶ T),
        Presieve.ofArrows X' f' ≤ (Presheaf.imageSieve φ.hom s).arrows →
        (∀ z : T.left, ∃ k, z ∈ Set.range (f' k).left) →
        ∃ (ι : Type u) (U : ι → X.Etale) (u : ∀ k, U k ⟶ T),
          (∀ z : T.left, ∃ k, z ∈ Set.range (u k).left) ∧
          ∀ k, ∃ y : F.obj.obj (Opposite.op (U k)),
            (φ.hom.app (Opposite.op (U k))).hom y = (G.obj.map (u k).op).hom s := by
      intro ι X' f' hle' hcov
      refine ⟨ι, X', f', hcov, fun k => ?_⟩
      obtain ⟨y, hy⟩ := hle' _ _ (Presieve.ofArrows.mk k)
      exact ⟨y, hy⟩
    apply crux _ _ hle
    intro z
    obtain ⟨k, y₀, hy₀⟩ := 𝒰.exists_eq z
    exact ⟨k, y₀, hy₀⟩
  constructor
  intro V s
  obtain ⟨ι, U, u, hcov, hlift⟩ := s1 ((wcEtBaseChange g).obj V) s
  choose y hy using hlift
  apply wc_etale_jointly_surjective_covers B V
  intro v
  obtain ⟨V', e, n, Wi, w, hv, hopen, hdisj, hcov', hfac⟩ := hB V ι U u hcov v
  choose k a ha using hfac
  refine ⟨V', e, ?_, hv⟩
  have hb := wc_et_disjoint_cover_bijective ((wcEtBaseChange g).obj V') n Wi w hopen hdisj hcov'
  obtain ⟨x, hx⟩ := (hb F).2 (fun i => (F.obj.map (a i).op).hom (y (k i)))
  refine ⟨x, ?_⟩
  change (φ.hom.app (Opposite.op ((wcEtBaseChange g).obj V'))).hom x =
    (G.obj.map ((wcEtBaseChange g).map e).op).hom s
  apply (hb G).1
  funext i
  have hxi : (F.obj.map (w i).op).hom x = (F.obj.map (a i).op).hom (y (k i)) := congrFun hx i
  show (G.obj.map (w i).op).hom ((φ.hom.app (Opposite.op ((wcEtBaseChange g).obj V'))).hom x) =
    (G.obj.map (w i).op).hom ((G.obj.map ((wcEtBaseChange g).map e).op).hom s)
  calc (G.obj.map (w i).op).hom ((φ.hom.app (Opposite.op ((wcEtBaseChange g).obj V'))).hom x)
      = (φ.hom.app (Opposite.op (Wi i))).hom ((F.obj.map (w i).op).hom x) :=
        (NatTrans.naturality_apply φ.hom (w i).op x).symm
    _ = (φ.hom.app (Opposite.op (Wi i))).hom ((F.obj.map (a i).op).hom (y (k i))) := by
        rw [hxi]
    _ = (G.obj.map (a i).op).hom ((φ.hom.app (Opposite.op (U (k i)))).hom (y (k i))) :=
        NatTrans.naturality_apply φ.hom (a i).op (y (k i))
    _ = (G.obj.map (a i).op).hom ((G.obj.map (u (k i)).op).hom s) := by
        rw [hy]
    _ = (G.obj.map (a i ≫ u (k i)).op).hom s := by
        rw [op_comp, Functor.map_comp]; rfl
    _ = (G.obj.map (w i ≫ (wcEtBaseChange g).map e).op).hom s := by
        rw [ha]
    _ = (G.obj.map (w i).op).hom ((G.obj.map ((wcEtBaseChange g).map e).op).hom s) := by
        rw [op_comp, Functor.map_comp]; rfl

theorem wc_et_propB_of_ring_propB : (∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Algebra.IsIntegral C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] [∀ i, Algebra.Etale D (E i)], (∀ q : Ideal D, q.IsPrime → ∃ (i : Fin n) (r : Ideal (E i)), r.IsPrime ∧ r.comap (algebraMap D (E i)) = q) → ∀ p : Ideal C, p.IsPrime → ∃ (C' : Type u) (_ : CommRing C') (_ : Algebra C C') (_ : Algebra.Etale C C') (P : Ideal C'), P.IsPrime ∧ P.comap (algebraMap C C') = p ∧ ∃ (m : ℕ) (ε : Fin m → TensorProduct C C' D) (k : Fin m → Fin n), (∀ a, IsIdempotentElem (ε a)) ∧ (∀ a b, a ≠ b → ε a * ε b = 0) ∧ ∑ a, ε a = 1 ∧ ∀ a, ∃ φ : E (k a) →+* Localization.Away (ε a), φ.comp (algebraMap D (E (k a))) = (algebraMap (TensorProduct C C' D) (Localization.Away (ε a))).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D).toRingHom) → ∀ {Y T : Scheme.{u}} (τ : T ⟶ Y) [IsIntegralHom τ] (V : Y.Etale) (ι : Type u) (U : ι → T.Etale) (u : ∀ k, U k ⟶ (wcEtBaseChange τ).obj V), (∀ z : ((wcEtBaseChange τ).obj V).left, ∃ k, z ∈ Set.range (u k).left) → ∀ v : V.left, ∃ (V' : Y.Etale) (e : V' ⟶ V) (n : ℕ) (Wi : Fin n → T.Etale) (w : ∀ i, Wi i ⟶ (wcEtBaseChange τ).obj V'), v ∈ Set.range e.left ∧ (∀ i, IsOpenImmersion (w i).left) ∧ (∀ i j, i ≠ j → Disjoint (Set.range (w i).left) (Set.range (w j).left)) ∧ (∀ z : ((wcEtBaseChange τ).obj V').left, ∃ i, z ∈ Set.range (w i).left) ∧ ∀ i, ∃ (k : ι) (a : Wi i ⟶ U k), a ≫ u k = w i ≫ (wcEtBaseChange τ).map e :=
by

  have jsc : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have finref : ∀ (X : Scheme.{u}) (U : X.Etale), CompactSpace U.left →
      ∀ R ∈ Scheme.smallEtaleTopology X U, ∃ (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U),
        (∀ i, R.arrows (f i)) ∧ (∀ i, IsAffine (V i).left) ∧
        ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left := by
    intro X U hc R hR
    have hSurj : ∀ y : U.left, ∃ (Y : X.Etale) (g : Y ⟶ U) (w : Y.left),
        R.arrows g ∧ g.left w = y := by
      change R ∈ Scheme.smallGrothendieckTopology @Etale X U at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      intro y
      obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U R).mp hR y
      exact ⟨Y, g, w, hg, hw⟩
    have hNbhd : ∀ y : U.left, ∃ (V : X.Etale) (f : V ⟶ U),
        R.arrows f ∧ IsAffine V.left ∧ y ∈ Set.range f.left := by
      intro y
      obtain ⟨Y, g, w, hg, hw⟩ := hSurj y
      obtain ⟨a, ha⟩ := Y.left.affineCover.covers w
      haveI : Etale Y.hom := Y.prop
      let V : X.Etale := MorphismProperty.Over.mk ⊤
        (Y.left.affineCover.f (Y.left.affineCover.idx w) ≫ Y.hom)
        (inferInstance : Etale (Y.left.affineCover.f (Y.left.affineCover.idx w) ≫ Y.hom))
      let h : V ⟶ Y := MorphismProperty.Over.homMk
        (Y.left.affineCover.f (Y.left.affineCover.idx w)) rfl trivial
      refine ⟨V, h ≫ g, R.downward_closed hg h, ?_, ⟨a, ?_⟩⟩
      · show IsAffine (Y.left.affineCover.X (Y.left.affineCover.idx w))
        infer_instance
      · change g.left (Y.left.affineCover.f (Y.left.affineCover.idx w) a) = y
        rw [ha, hw]
    choose Vy fy hR' hA hy using hNbhd
    have hopen : ∀ y, Set.range (fy y).left ∈ nhds y := fun y =>
      ((fy y).left.isOpenMap.isOpen_range).mem_nhds (hy y)
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover _ hopen
    classical
    refine ⟨t.card, fun i => Vy (t.equivFin.symm i).1, fun i => fy (t.equivFin.symm i).1,
      fun i => hR' _, fun i => hA _, ?_⟩
    intro x
    have hx : x ∈ ⋃ y ∈ t, Set.range (fy y).left := by rw [ht]; trivial
    obtain ⟨y, hyt, hxy⟩ := Set.mem_iUnion₂.mp hx
    have key : ∀ z : t, z = ⟨y, hyt⟩ → x ∈ Set.range (fy z.1).left := by
      rintro _ rfl
      exact hxy
    exact ⟨t.equivFin ⟨y, hyt⟩, key _ (Equiv.symm_apply_apply _ _)⟩

  have s2 : ∀ (R : Type u) [CommRing R] (m : ℕ) (ε : Fin m → R),
      (∀ a b, a ≠ b → ε a * ε b = 0) → ∑ a, ε a = 1 →
      (∀ a, IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a)))))) ∧
      (∀ a b, a ≠ b → Disjoint (Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a))))))
        (Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε b))))))) ∧
      ∀ x : Spec (.of R), ∃ a, x ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a))))) := by
    intro R _ m ε horth hsum
    have hr : ∀ a (x : PrimeSpectrum R),
        x ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a))))) ↔
          ε a ∉ x.asIdeal := by
      intro a x
      have e1 : Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a))))) =
          Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away (ε a)))) := by
        congr 1
      rw [e1, PrimeSpectrum.localization_away_comap_range (Localization.Away (ε a)) (ε a)]
      exact PrimeSpectrum.mem_basicOpen _ _
    refine ⟨fun a => IsOpenImmersion.of_isLocalization (ε a), ?_, ?_⟩
    · intro a b hab
      refine Set.disjoint_left.mpr fun x hxa hxb => ?_
      have ha := (hr a x).mp hxa
      have hb := (hr b x).mp hxb
      have h0 : ε a * ε b ∈ (x : PrimeSpectrum R).asIdeal := by
        rw [horth a b hab]; exact Ideal.zero_mem _
      rcases (x : PrimeSpectrum R).isPrime.mem_or_mem h0 with h | h
      · exact ha h
      · exact hb h
    · intro x
      by_contra hcon
      have hall : ∀ a, ε a ∈ (x : PrimeSpectrum R).asIdeal := fun a => by
        by_contra h
        exact hcon ⟨a, (hr a x).mpr h⟩
      have h1 : (1 : R) ∈ (x : PrimeSpectrum R).asIdeal := by
        rw [← hsum]; exact Ideal.sum_mem _ (fun a _ => hall a)
      exact (x : PrimeSpectrum R).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have s4 : ∀ (D : Type u) [CommRing D] (n : ℕ) (E : Fin n → Type u) [∀ j, CommRing (E j)]
      [∀ j, Algebra D (E j)] (X : Scheme.{u}) (O : Fin n → Scheme.{u}) (f : ∀ j, O j ⟶ X)
      (αX : X ≅ Spec (.of D)) (αO : ∀ j, O j ≅ Spec (.of (E j))),
      (∀ j, (αO j).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap D (E j))) = f j ≫ αX.hom) →
      (∀ x : X, ∃ j, x ∈ Set.range (f j)) →
      ∀ q : Ideal D, q.IsPrime → ∃ (j : Fin n) (r : Ideal (E j)), r.IsPrime ∧
        r.comap (algebraMap D (E j)) = q := by
    intro D _ n E _ _ X O f αX αO hsq hcov q hq
    let x : Spec (.of D) := (⟨q, hq⟩ : PrimeSpectrum D)
    obtain ⟨j, y, hy⟩ := hcov (αX.inv x)
    let ρ : PrimeSpectrum (E j) := (αO j).hom y
    refine ⟨j, ρ.asIdeal, ρ.isPrime, ?_⟩
    have h1 : Spec.map (CommRingCat.ofHom (algebraMap D (E j))) ((αO j).hom y) = αX.hom (f j y) := by
      rw [← Scheme.Hom.comp_apply, hsq j, Scheme.Hom.comp_apply]
    have h2 : αX.hom (αX.inv x) = x := by
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
    rw [hy, h2, Spec.map_apply] at h1
    have h3 := congrArg PrimeSpectrum.asIdeal h1
    rw [CommRingCat.hom_ofHom] at h3
    exact (PrimeSpectrum.comap_asIdeal (algebraMap D (E j)) ρ).symm.trans h3

  have s1 : ∀ {Y T : Scheme.{u}} (τ : T ⟶ Y) [IsIntegralHom τ] (V : Y.Etale) (v : V.left),
      ∃ (V₀ : Y.Etale) (e₀ : V₀ ⟶ V), v ∈ Set.range e₀.left ∧ IsAffine V₀.left ∧
        IsAffine ((wcEtBaseChange τ).obj V₀).left := by
    intro Y T τ _ V v
    obtain ⟨U₀, hU, hvU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens V.left)) (by trivial : v ∈ (⊤ : V.left.Opens))
    let U : V.left.Opens := U₀
    have : Etale V.hom := V.prop
    have hUa : IsAffine (U : Scheme.{u}) := hU
    refine ⟨Scheme.Etale.mk (U.ι ≫ V.hom), MorphismProperty.Over.homMk U.ι rfl trivial, ?_, hUa, ?_⟩
    · change v ∈ Set.range U.ι
      rw [Scheme.Opens.range_ι]; exact hvU
    · change IsAffine (Limits.pullback (U.ι ≫ V.hom) τ)
      exact isAffine_of_isAffineHom (Limits.pullback.fst (U.ι ≫ V.hom) τ)

  have s8 : ∀ {Y T : Scheme.{u}} (τ : T ⟶ Y) (V V₀ : Y.Etale) (e₀ : V₀ ⟶ V) (ι : Type u)
      (U : ι → T.Etale) (u : ∀ k, U k ⟶ (wcEtBaseChange τ).obj V),
      (∀ z : ((wcEtBaseChange τ).obj V).left, ∃ k, z ∈ Set.range (u k).left) →
      ∀ z : ((wcEtBaseChange τ).obj V₀).left,
      ∃ (V₁ : T.Etale) (c : V₁ ⟶ (wcEtBaseChange τ).obj V₀) (k : ι) (c' : V₁ ⟶ U k),
        c' ≫ u k = c ≫ (wcEtBaseChange τ).map e₀ ∧ z ∈ Set.range c.left := by
    intro Y T τ V V₀ e₀ ι U u hU z
    obtain ⟨k, y, hy⟩ := hU (((wcEtBaseChange τ).map e₀).left z)
    have h1 : Etale ((wcEtBaseChange τ).obj V).hom := ((wcEtBaseChange τ).obj V).prop
    have h2 : Etale ((wcEtBaseChange τ).obj V₀).hom := ((wcEtBaseChange τ).obj V₀).prop
    have h3 : Etale (U k).hom := (U k).prop
    have h4 : Etale (u k).left := by
      have hw : (u k).left ≫ ((wcEtBaseChange τ).obj V).hom = (U k).hom :=
        MorphismProperty.Over.w (u k)
      have : Etale ((u k).left ≫ ((wcEtBaseChange τ).obj V).hom) := by rw [hw]; exact h3
      exact Etale.of_comp (u k).left ((wcEtBaseChange τ).obj V).hom
    let V₁ : T.Etale := Scheme.Etale.mk (Limits.pullback.snd (u k).left
      ((wcEtBaseChange τ).map e₀).left ≫ ((wcEtBaseChange τ).obj V₀).hom)
    have hc'w : Limits.pullback.fst (u k).left ((wcEtBaseChange τ).map e₀).left ≫ (U k).hom =
        V₁.hom := by
      change _ = Limits.pullback.snd (u k).left ((wcEtBaseChange τ).map e₀).left ≫
        ((wcEtBaseChange τ).obj V₀).hom
      rw [← MorphismProperty.Over.w (u k), ← Category.assoc, Limits.pullback.condition,
        Category.assoc, MorphismProperty.Over.w ((wcEtBaseChange τ).map e₀)]
    refine ⟨V₁, MorphismProperty.Over.homMk (Limits.pullback.snd (u k).left
      ((wcEtBaseChange τ).map e₀).left) rfl trivial, k, MorphismProperty.Over.homMk
      (Limits.pullback.fst (u k).left ((wcEtBaseChange τ).map e₀).left) hc'w trivial, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    · obtain ⟨w, -, hw⟩ := Scheme.Pullback.exists_preimage_pullback y z hy
      exact ⟨w, hw⟩

  have s6 : ∀ {Y T : Scheme.{u}} (τ : T ⟶ Y) [IsIntegralHom τ] (V₀ : Y.Etale) (n : ℕ)
      (O : Fin n → T.Etale) (o : ∀ j, O j ⟶ (wcEtBaseChange τ).obj V₀), IsAffine V₀.left →
      IsAffine ((wcEtBaseChange τ).obj V₀).left → (∀ j, IsAffine (O j).left) →
      ∃ (C D : Type u) (_ : CommRing C) (_ : CommRing D) (_ : Algebra C D)
        (_ : Algebra.IsIntegral C D) (E : Fin n → Type u) (_ : ∀ j, CommRing (E j))
        (_ : ∀ j, Algebra D (E j)) (_ : ∀ j, Algebra.Etale D (E j)) (αS : V₀.left ≅ Spec (.of C))
        (αX : ((wcEtBaseChange τ).obj V₀).left ≅ Spec (.of D))
        (αO : ∀ j, (O j).left ≅ Spec (.of (E j))),
        αX.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap C D)) =
          Limits.pullback.fst V₀.hom τ ≫ αS.hom ∧
        ∀ j, (αO j).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap D (E j))) =
          (o j).left ≫ αX.hom := by
    intro Y T τ _ V₀ n O o h0 h1 h2
    let F : ((wcEtBaseChange τ).obj V₀).left ⟶ V₀.left := Limits.pullback.fst V₀.hom τ
    letI alg : Algebra Γ(V₀.left, ⊤) Γ(((wcEtBaseChange τ).obj V₀).left, ⊤) :=
      F.appTop.hom.toAlgebra
    have hFi : IsIntegralHom F := by
      change IsIntegralHom (Limits.pullback.fst V₀.hom τ); infer_instance
    have hint : Algebra.IsIntegral Γ(V₀.left, ⊤) Γ(((wcEtBaseChange τ).obj V₀).left, ⊤) := by
      rw [← algebraMap_isIntegral_iff]
      exact IsIntegralHom.isIntegral_app F ⊤ (isAffineOpen_top _)
    letI algE : ∀ j, Algebra Γ(((wcEtBaseChange τ).obj V₀).left, ⊤) Γ((O j).left, ⊤) :=
      fun j => (o j).left.appTop.hom.toAlgebra
    have hV : Etale ((wcEtBaseChange τ).obj V₀).hom := ((wcEtBaseChange τ).obj V₀).prop
    have het : ∀ j, Algebra.Etale Γ(((wcEtBaseChange τ).obj V₀).left, ⊤) Γ((O j).left, ⊤) := by
      intro j
      have hO : Etale (O j).hom := (O j).prop
      have hoj : Etale (o j).left := by
        have hw : (o j).left ≫ ((wcEtBaseChange τ).obj V₀).hom = (O j).hom :=
          MorphismProperty.Over.w (o j)
        have : Etale ((o j).left ≫ ((wcEtBaseChange τ).obj V₀).hom) := by rw [hw]; exact hO
        exact Etale.of_comp (o j).left ((wcEtBaseChange τ).obj V₀).hom
      have := h2 j
      rw [← RingHom.etale_algebraMap]
      exact HasRingHomProperty.appTop @Etale (o j).left hoj
    refine ⟨Γ(V₀.left, ⊤), Γ(((wcEtBaseChange τ).obj V₀).left, ⊤), inferInstance, inferInstance,
      alg, hint, fun j => Γ((O j).left, ⊤), fun j => inferInstance, algE, het, V₀.left.isoSpec,
      ((wcEtBaseChange τ).obj V₀).left.isoSpec, fun j => (O j).left.isoSpec, ?_, ?_⟩
    · exact Scheme.isoSpec_hom_naturality F
    · intro j
      have := h2 j
      exact Scheme.isoSpec_hom_naturality (o j).left

  have s3 : ∀ {Y T : Scheme.{u}} (τ : T ⟶ Y) (V₀ : Y.Etale) (C D : Type u) [CommRing C]
      [CommRing D] [Algebra C D] (αS : V₀.left ≅ Spec (.of C))
      (αX : ((wcEtBaseChange τ).obj V₀).left ≅ Spec (.of D)),
      αX.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap C D)) =
        Limits.pullback.fst V₀.hom τ ≫ αS.hom →
      ∀ (C' : Type u) [CommRing C'] [Algebra C C'] [Algebra.Etale C C'],
      ∃ (V' : Y.Etale) (e : V' ⟶ V₀)
        (Ψ : Spec (.of (TensorProduct C C' D)) ≅ ((wcEtBaseChange τ).obj V').left),
        Set.range (Spec.map (CommRingCat.ofHom (algebraMap C C')) ≫ αS.inv) ⊆ Set.range e.left ∧
        Ψ.hom ≫ ((wcEtBaseChange τ).map e).left =
          Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
            D →ₐ[C] TensorProduct C C' D).toRingHom) ≫ αX.inv := by
    intro Y T τ V₀ C D _ _ _ αS αX hsq C' _ _ _
    have hV₀ : Etale V₀.hom := V₀.prop
    have hSa : Etale (Spec.map (CommRingCat.ofHom (algebraMap C C'))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr inferInstance)
    let αX' : Limits.pullback V₀.hom τ ≅ Spec (.of D) := αX
    let g : Spec (.of C') ⟶ V₀.left := Spec.map (CommRingCat.ofHom (algebraMap C C')) ≫ αS.inv
    have hsq' : Limits.pullback.fst V₀.hom τ ≫ αS.hom =
        αX'.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap C D)) := hsq.symm
    have hP : IsPullback (Limits.pullback.fst g (Limits.pullback.fst V₀.hom τ))
        (Limits.pullback.snd g (Limits.pullback.fst V₀.hom τ) ≫ αX'.hom)
        (Spec.map (CommRingCat.ofHom (algebraMap C C')))
        (Spec.map (CommRingCat.ofHom (algebraMap C D))) :=
      IsPullback.of_iso (IsPullback.of_hasPullback _ _) (Iso.refl _) (Iso.refl _) αX' αS
        (by simp) (by simp) (by simp [g]) hsq'
    let e : Scheme.Etale.mk (g ≫ V₀.hom) ⟶ V₀ := MorphismProperty.Over.homMk g rfl trivial
    let PR := Limits.pullbackRightPullbackFstIso V₀.hom τ g
    let Ψ : Spec (.of (TensorProduct C C' D)) ≅
        ((wcEtBaseChange τ).obj (Scheme.Etale.mk (g ≫ V₀.hom))).left :=
      (pullbackSpecIso C C' D).symm ≪≫ hP.isoPullback.symm ≪≫ PR
    have key : ((wcEtBaseChange τ).map e).left =
        PR.inv ≫ Limits.pullback.snd g (Limits.pullback.fst V₀.hom τ) := by
      apply Limits.pullback.hom_ext
      · exact (Limits.pullback.lift_fst _ _ _).trans ((Category.assoc _ _ _).trans
          (Limits.pullbackRightPullbackFstIso_inv_snd_fst V₀.hom τ g)).symm
      · exact (Limits.pullback.lift_snd _ _ _).trans ((Category.assoc _ _ _).trans
          (Limits.pullbackRightPullbackFstIso_inv_snd_snd V₀.hom τ g)).symm
    have hsnd0 : hP.isoPullback.hom ≫ Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap C C')))
        (Spec.map (CommRingCat.ofHom (algebraMap C D))) =
        Limits.pullback.snd g (Limits.pullback.fst V₀.hom τ) ≫ αX'.hom :=
      hP.isoPullback_hom_snd
    have hsnd : hP.isoPullback.inv ≫ Limits.pullback.snd g (Limits.pullback.fst V₀.hom τ) =
        Limits.pullback.snd _ _ ≫ αX'.inv := by
      apply (Iso.inv_comp_eq _).mpr
      rw [← Category.assoc, hsnd0, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have e1 : Ψ.hom ≫ PR.inv ≫ Limits.pullback.snd g (Limits.pullback.fst V₀.hom τ) =
        (pullbackSpecIso C C' D).inv ≫ (hP.isoPullback.inv ≫
          Limits.pullback.snd g (Limits.pullback.fst V₀.hom τ)) := by
      show ((pullbackSpecIso C C' D).inv ≫ hP.isoPullback.inv ≫ PR.hom) ≫ PR.inv ≫ _ = _
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
    refine ⟨_, e, Ψ, fun x hx => hx, ?_⟩
    rw [key]
    refine e1.trans ?_
    rw [hsnd, ← Category.assoc, pullbackSpecIso_inv_snd]
    rfl

  have s5 : ∀ {Y T : Scheme.{u}} (τ : T ⟶ Y) (V₀ V' : Y.Etale) (e : V' ⟶ V₀) (n : ℕ)
      (O : Fin n → T.Etale) (o : ∀ j, O j ⟶ (wcEtBaseChange τ).obj V₀) (D : Type u) [CommRing D]
      (E : Fin n → Type u) [∀ j, CommRing (E j)] [∀ j, Algebra D (E j)]
      (αX : ((wcEtBaseChange τ).obj V₀).left ≅ Spec (.of D))
      (αO : ∀ j, (O j).left ≅ Spec (.of (E j))),
      (∀ j, (αO j).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap D (E j))) =
        (o j).left ≫ αX.hom) →
      ∀ (R : Type u) [CommRing R] (ιR : D →+* R)
        (Ψ : Spec (.of R) ≅ ((wcEtBaseChange τ).obj V').left),
      Ψ.hom ≫ ((wcEtBaseChange τ).map e).left = Spec.map (CommRingCat.ofHom ιR) ≫ αX.inv →
      ∀ (m : ℕ) (ε : Fin m → R) (k : Fin m → Fin n),
      (∀ a, IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a)))))) →
      (∀ a b, a ≠ b → Disjoint
        (Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a))))))
        (Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε b))))))) →
      (∀ x : Spec (.of R), ∃ a,
        x ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε a)))))) →
      (∀ a, ∃ φ : E (k a) →+* Localization.Away (ε a),
        φ.comp (algebraMap D (E (k a))) = (algebraMap R (Localization.Away (ε a))).comp ιR) →
      ∃ (Wi : Fin m → T.Etale) (w : ∀ i, Wi i ⟶ (wcEtBaseChange τ).obj V'),
        (∀ i, IsOpenImmersion (w i).left) ∧
        (∀ i j, i ≠ j → Disjoint (Set.range (w i).left) (Set.range (w j).left)) ∧
        (∀ z : ((wcEtBaseChange τ).obj V').left, ∃ i, z ∈ Set.range (w i).left) ∧
        ∀ i, ∃ a : Wi i ⟶ O (k i), a ≫ o (k i) = w i ≫ (wcEtBaseChange τ).map e := by
    intro Y T τ V₀ V' e n O o D _ E _ _ αX αO hsq R _ ιR Ψ hΨ m ε k hopen hdisj hcov hφall
    choose φ hφ using hφall
    let lam : ∀ i, Spec (.of (Localization.Away (ε i))) ⟶ Spec (.of R) := fun i =>
      Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε i))))
    have hV' : Etale ((wcEtBaseChange τ).obj V').hom := ((wcEtBaseChange τ).obj V').prop
    have hEt : ∀ i, Etale (lam i ≫ Ψ.hom ≫ ((wcEtBaseChange τ).obj V').hom) := fun i => by
      have := hopen i
      change Etale (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ε i)))) ≫
        Ψ.hom ≫ ((wcEtBaseChange τ).obj V').hom)
      infer_instance
    let Wi : Fin m → T.Etale := fun i =>
      MorphismProperty.Over.mk ⊤ (lam i ≫ Ψ.hom ≫ ((wcEtBaseChange τ).obj V').hom) (hEt i)
    let w : ∀ i, Wi i ⟶ (wcEtBaseChange τ).obj V' := fun i =>
      MorphismProperty.Over.homMk (lam i ≫ Ψ.hom) (Category.assoc _ _ _) trivial
    have hinj : ∀ t, Ψ.inv (Ψ.hom t) = t := fun t => by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    have hsurj : ∀ z, Ψ.hom (Ψ.inv z) = z := fun z => by
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
    have hwapp : ∀ i x, (w i).left x = Ψ.hom (lam i x) := fun i x =>
      Scheme.Hom.comp_apply _ _ _
    have hO' : ∀ j, (αO j).inv ≫ (o j).left =
        Spec.map (CommRingCat.ofHom (algebraMap D (E j))) ≫ αX.inv := by
      intro j
      rw [Iso.inv_comp_eq, ← Category.assoc, hsq j, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    refine ⟨Wi, w, ?_, ?_, ?_, ?_⟩
    · intro i
      have := hopen i
      change IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (algebraMap R (Localization.Away (ε i)))) ≫ Ψ.hom)
      infer_instance
    · intro i j hij
      refine Set.disjoint_left.mpr ?_
      rintro z ⟨x, rfl⟩ ⟨y, hy⟩
      have h1 : lam j y = lam i x := by
        have := congrArg (fun t => Ψ.inv t) hy
        simp only [hwapp, hinj] at this
        exact this
      exact Set.disjoint_left.mp (hdisj i j hij) ⟨x, rfl⟩ ⟨y, h1⟩
    · intro z
      obtain ⟨a, t, ht⟩ := hcov (Ψ.inv z)
      refine ⟨a, t, ?_⟩
      refine (hwapp a t).trans ?_
      change Ψ.hom (Spec.map (CommRingCat.ofHom
        (algebraMap R (Localization.Away (ε a)))) t) = z
      rw [ht, hsurj]
    · intro i
      let A : Spec (.of (Localization.Away (ε i))) ⟶ (O (k i)).left :=
        Spec.map (CommRingCat.ofHom (φ i)) ≫ (αO (k i)).inv
      have hleft : A ≫ (o (k i)).left = (w i ≫ (wcEtBaseChange τ).map e).left := by
        show (Spec.map (CommRingCat.ofHom (φ i)) ≫ (αO (k i)).inv) ≫ (o (k i)).left =
          (lam i ≫ Ψ.hom) ≫ ((wcEtBaseChange τ).map e).left
        rw [Category.assoc, hO', Category.assoc, hΨ, ← Category.assoc, ← Category.assoc,
          ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
          hφ i]
      have hover : A ≫ (O (k i)).hom = (Wi i).hom := by
        have hleft' : A ≫ (o (k i)).left = (lam i ≫ Ψ.hom) ≫ ((wcEtBaseChange τ).map e).left :=
          hleft
        have h5 : ((wcEtBaseChange τ).map e).left ≫ ((wcEtBaseChange τ).obj V₀).hom =
            ((wcEtBaseChange τ).obj V').hom := MorphismProperty.Over.w _
        show A ≫ (O (k i)).hom = lam i ≫ Ψ.hom ≫ ((wcEtBaseChange τ).obj V').hom
        rw [← MorphismProperty.Over.w (o (k i)), ← Category.assoc, hleft', Category.assoc,
          Category.assoc, h5]
      refine ⟨MorphismProperty.Over.homMk A hover trivial, ?_⟩
      apply MorphismProperty.Over.Hom.ext
      exact hleft

  intro hB Y T τ _ V ι U u hU v
  obtain ⟨V₀, e₀, ⟨v₀, hv₀⟩, hV₀, hV₀T⟩ := s1 τ V v
  let Rs : Sieve ((wcEtBaseChange τ).obj V₀) :=
    { arrows := fun Z c => ∃ (kk : ι) (c' : Z ⟶ U kk), c' ≫ u kk = c ≫ (wcEtBaseChange τ).map e₀
      downward_closed := by
        rintro Z₁ Z₂ f ⟨kk, c', h⟩ g
        exact ⟨kk, g ≫ c', by rw [Category.assoc, h, ← Category.assoc]⟩ }
  have hRs : Rs ∈ Scheme.smallEtaleTopology T ((wcEtBaseChange τ).obj V₀) := by
    apply jsc
    intro z
    obtain ⟨V₁, c, kk, c', h, hz⟩ := s8 τ V V₀ e₀ ι U u hU z
    exact ⟨V₁, c, ⟨kk, c', h⟩, hz⟩
  have hcomp : CompactSpace ((wcEtBaseChange τ).obj V₀).left := by
    have := hV₀T; infer_instance
  obtain ⟨n, O, o, hRo, hO, hcov⟩ := finref T ((wcEtBaseChange τ).obj V₀) hcomp Rs hRs
  have hRo' : ∀ j, ∃ (kk : ι) (c' : O j ⟶ U kk),
      c' ≫ u kk = o j ≫ (wcEtBaseChange τ).map e₀ := hRo
  choose kk c hc using hRo'
  obtain ⟨C, D, _, _, _, _, E, _, _, _, αS, αX, αO, hsq, hsqO⟩ := s6 τ V₀ n O o hV₀ hV₀T hO
  have hprimes := s4 D n E ((wcEtBaseChange τ).obj V₀).left (fun j => (O j).left)
    (fun j => (o j).left) αX αO hsqO hcov
  let pv : PrimeSpectrum C := αS.hom v₀
  obtain ⟨C', _, _, _, P, hP, hPp, m, ε, k, -, horth, hsum, hφ⟩ :=
    hB C D n E hprimes pv.asIdeal pv.isPrime
  obtain ⟨V', e, Ψ, hrange, hΨ⟩ := s3 τ V₀ C D αS αX hsq C'
  obtain ⟨hopen, hdisj, hcovR⟩ := s2 (TensorProduct C C' D) m ε horth hsum
  obtain ⟨Wi, w, hw_open, hw_disj, hw_cov, ha⟩ := s5 τ V₀ V' e n O o D E αX αO hsqO
    (TensorProduct C C' D) (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D).toRingHom
    Ψ hΨ m ε k hopen hdisj hcovR hφ
  refine ⟨V', e ≫ e₀, m, Wi, w, ?_, hw_open, hw_disj, hw_cov, ?_⟩
  · let 𝔓 : Spec (.of C') := (⟨P, hP⟩ : PrimeSpectrum C')
    have h1 : Spec.map (CommRingCat.ofHom (algebraMap C C')) 𝔓 = αS.hom v₀ := by
      rw [Spec.map_apply]
      apply PrimeSpectrum.ext
      rw [CommRingCat.hom_ofHom, PrimeSpectrum.comap_asIdeal]
      exact hPp
    have h2 : (Spec.map (CommRingCat.ofHom (algebraMap C C')) ≫ αS.inv) 𝔓 = v₀ := by
      rw [Scheme.Hom.comp_apply, h1, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    obtain ⟨y, hy⟩ := hrange ⟨𝔓, h2⟩
    refine ⟨y, ?_⟩
    show (e.left ≫ e₀.left) y = v
    rw [Scheme.Hom.comp_apply, hy, hv₀]
  · intro i
    obtain ⟨a, ha'⟩ := ha i
    refine ⟨kk (k i), a ≫ c (k i), ?_⟩
    rw [Category.assoc, hc (k i), ← Category.assoc, ha', Category.assoc, ← Functor.map_comp]

theorem wc_residue_embed_poly : ∀ (C D E : Type u) [CommRing C] [CommRing D] [CommRing E] [Algebra C D] [Algebra.IsIntegral C D] [Algebra D E] [Algebra.Etale D E] (p : Ideal C) [p.IsPrime] (q : Ideal D) [q.IsPrime] (r : Ideal E) [r.IsPrime], q.comap (algebraMap C D) = p → r.comap (algebraMap D E) = q → ∃ h : Polynomial p.ResidueField, h.Monic ∧ h.Separable ∧ ∀ (Ω : Type u) [Field Ω] (τ : q.ResidueField →+* Ω) (ρ : p.ResidueField →+* Ω), ρ.comp (algebraMap C p.ResidueField) = τ.comp ((algebraMap D q.ResidueField).comp (algebraMap C D)) → (h.map ρ).Splits → ∃ σ : r.ResidueField →+* Ω, σ.comp ((algebraMap E r.ResidueField).comp (algebraMap D E)) = τ.comp (algebraMap D q.ResidueField) :=
by

  have t_field_embed : ∀ (K F L : Type u) [Field K] [Field F] [Field L] [Algebra K F]
      [Algebra F L] [Algebra K L] [IsScalarTower K F L] [Algebra.IsAlgebraic K F]
      [FiniteDimensional F L] [Algebra.IsSeparable F L], ∃ h : Polynomial K, h.Monic ∧
      h.Separable ∧ ∀ (Ω : Type u) [Field Ω] [Algebra F Ω],
        ((h.map (algebraMap K F)).map (algebraMap F Ω)).Splits → Nonempty (L →ₐ[F] Ω) := by
    intro K F L _ _ _ _ _ _ _ _ _ _
    haveI : Algebra.IsAlgebraic F L := Algebra.IsAlgebraic.of_finite F L
    haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.trans K F L
    obtain ⟨β, hβ⟩ := Field.exists_primitive_element F L
    haveI : ExpChar (separableClosure K L) (ringExpChar K) :=
      expChar_of_injective_algebraMap (algebraMap K _).injective (ringExpChar K)
    haveI : ExpChar F (ringExpChar K) :=
      expChar_of_injective_algebraMap (algebraMap K F).injective (ringExpChar K)
    haveI := separableClosure.isPurelyInseparable K L
    obtain ⟨n, s, hs⟩ := IsPurelyInseparable.pow_mem (separableClosure K L) (ringExpChar K) β
    have hβ'sep : IsSeparable K (β ^ ringExpChar K ^ n) := by
      have hmem : (algebraMap (separableClosure K L) L s) ∈ separableClosure K L := s.2
      rw [hs] at hmem
      exact mem_separableClosure_iff.mp hmem
    have hgen : IntermediateField.adjoin F {β ^ ringExpChar K ^ n} = ⊤ := by
      rw [← IntermediateField.adjoin_simple_eq_adjoin_pow_expChar_pow_of_isSeparable F L
        (Algebra.IsSeparable.isSeparable F β) (ringExpChar K) n]
      exact hβ
    refine ⟨minpoly K (β ^ ringExpChar K ^ n), minpoly.monic hβ'sep.isIntegral, hβ'sep, ?_⟩
    intro Ω _ _ hsplit
    have hint : _root_.IsIntegral F (β ^ ringExpChar K ^ n) := _root_.IsIntegral.of_finite F _
    have hdvd : minpoly F (β ^ ringExpChar K ^ n) ∣
        (minpoly K (β ^ ringExpChar K ^ n)).map (algebraMap K F) :=
      minpoly.dvd_map_of_isScalarTower K F _
    have hne : ((minpoly K (β ^ ringExpChar K ^ n)).map (algebraMap K F)).map
        (algebraMap F Ω) ≠ 0 :=
      (((minpoly.monic hβ'sep.isIntegral).map _).map _).ne_zero
    have hms : ((minpoly F (β ^ ringExpChar K ^ n)).map (algebraMap F Ω)).Splits :=
      Polynomial.Splits.of_dvd hsplit hne (Polynomial.map_dvd _ hdvd)
    have hdeg : ((minpoly F (β ^ ringExpChar K ^ n)).map (algebraMap F Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_map]; exact (minpoly.degree_pos hint).ne'
    obtain ⟨γ, hγ⟩ := hms.exists_eval_eq_zero hdeg
    let pb := IntermediateField.adjoin.powerBasis hint
    have hγ' : Polynomial.aeval γ (minpoly F pb.gen) = 0 := by
      rw [IntermediateField.adjoin.powerBasis_gen, IntermediateField.minpoly_gen,
        Polynomial.aeval_def, ← Polynomial.eval_map]
      exact hγ
    exact ⟨(pb.lift γ hγ').comp ((IntermediateField.equivOfEq hgen.symm).toAlgHom.comp
      (IntermediateField.topEquiv.symm.toAlgHom))⟩

  have t_integral_alg : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D]
      [Algebra.IsIntegral C D] (p : Ideal C) [p.IsPrime] (q : Ideal D) [q.IsPrime]
      (hqp : p = q.comap (algebraMap C D)),
      letI : Algebra p.ResidueField q.ResidueField :=
        (Ideal.ResidueField.map p q (algebraMap C D) hqp).toAlgebra
      Algebra.IsAlgebraic p.ResidueField q.ResidueField := by
    intro C D _ _ _ _ p _ q _ hqp
    letI : Algebra p.ResidueField q.ResidueField :=
      (Ideal.ResidueField.map p q (algebraMap C D) hqp).toAlgebra
    haveI : IsScalarTower C p.ResidueField q.ResidueField :=
      IsScalarTower.of_algebraMap_eq (fun c => by
        rw [RingHom.algebraMap_toAlgebra, Ideal.ResidueField.map_algebraMap,
          IsScalarTower.algebraMap_apply C D q.ResidueField])
    have himg : ∀ x : D, IsAlgebraic p.ResidueField (algebraMap D q.ResidueField x) := fun x =>
      (((Algebra.IsIntegral.isIntegral (R := C) x).algebraMap
        (B := q.ResidueField)).tower_top).isAlgebraic
    constructor
    intro z
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (D ⧸ q) z
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective b
    rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply, div_eq_mul_inv]
    exact (himg x).mul (himg y).inv

  have t_etale_sep : ∀ (D E : Type u) [CommRing D] [CommRing E] [Algebra D E]
      [Algebra.Etale D E] (q : Ideal D) [q.IsPrime] (r : Ideal E) [r.IsPrime]
      (hrq : q = r.comap (algebraMap D E)),
      letI : Algebra q.ResidueField r.ResidueField :=
        (Ideal.ResidueField.map q r (algebraMap D E) hrq).toAlgebra
      Algebra.IsSeparable q.ResidueField r.ResidueField ∧
        FiniteDimensional q.ResidueField r.ResidueField := by
    intro D E _ _ _ _ q _ r _ hrq
    letI : Algebra q.ResidueField r.ResidueField :=
      (Ideal.ResidueField.map q r (algebraMap D E) hrq).toAlgebra
    haveI : IsScalarTower D q.ResidueField r.ResidueField :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [RingHom.algebraMap_toAlgebra, Ideal.ResidueField.map_algebraMap,
          IsScalarTower.algebraMap_apply D E r.ResidueField])
    haveI : Algebra.FormallyUnramified E r.ResidueField :=
      Algebra.FormallyUnramified.comp E (Localization.AtPrime r) r.ResidueField
    haveI : Algebra.FormallyUnramified D r.ResidueField :=
      Algebra.FormallyUnramified.comp D E r.ResidueField
    haveI : Algebra.FormallyUnramified q.ResidueField r.ResidueField :=
      Algebra.FormallyUnramified.of_restrictScalars D q.ResidueField r.ResidueField
    haveI : Algebra.EssFiniteType D E := Algebra.EssFiniteType.of_finiteType D E
    haveI : Algebra.EssFiniteType D r.ResidueField :=
      Algebra.EssFiniteType.comp D E r.ResidueField
    haveI : Algebra.EssFiniteType q.ResidueField r.ResidueField :=
      Algebra.EssFiniteType.of_comp D q.ResidueField r.ResidueField
    exact ⟨Algebra.FormallyUnramified.isSeparable _ _,
      Algebra.FormallyUnramified.finite_of_free _ _⟩

  intro C D E _ _ _ _ _ _ _ p _ q _ r _ hqC hrD
  letI : Algebra p.ResidueField q.ResidueField :=
    (Ideal.ResidueField.map p q (algebraMap C D) hqC.symm).toAlgebra
  letI : Algebra q.ResidueField r.ResidueField :=
    (Ideal.ResidueField.map q r (algebraMap D E) hrD.symm).toAlgebra
  letI : Algebra p.ResidueField r.ResidueField :=
    ((Ideal.ResidueField.map q r (algebraMap D E) hrD.symm).comp
      (Ideal.ResidueField.map p q (algebraMap C D) hqC.symm)).toAlgebra
  haveI : IsScalarTower p.ResidueField q.ResidueField r.ResidueField :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI := t_integral_alg C D p q hqC.symm
  obtain ⟨hsep, hfin⟩ := t_etale_sep D E q r hrD.symm
  obtain ⟨h, hmon, hsepH, hemb⟩ := t_field_embed p.ResidueField q.ResidueField r.ResidueField
  refine ⟨h, hmon, hsepH, ?_⟩
  intro Ω _ τ ρ hcomp hsplit
  have hρ : ρ = τ.comp (Ideal.ResidueField.map p q (algebraMap C D) hqC.symm) := by
    apply Ideal.ResidueField.ringHom_ext
    rw [hcomp]
    ext c
    simp [Ideal.ResidueField.map_algebraMap]
  letI : Algebra q.ResidueField Ω := τ.toAlgebra
  have hsplit' : ((h.map (algebraMap p.ResidueField q.ResidueField)).map
      (algebraMap q.ResidueField Ω)).Splits := by
    rw [Polynomial.map_map]
    rw [hρ] at hsplit
    exact hsplit
  obtain ⟨φ⟩ := hemb Ω hsplit'
  refine ⟨(φ : r.ResidueField →+* Ω), ?_⟩
  ext d
  simp only [RingHom.comp_apply, RingHom.coe_coe]
  rw [← Ideal.ResidueField.map_algebraMap q r (algebraMap D E) hrD.symm d]
  exact φ.commutes (algebraMap D q.ResidueField d)

theorem wc_separable_poly_common_splitter : ∀ (K : Type u) [Field K] (ι : Type u) (s : Finset ι) (h : ι → Polynomial K), (∀ i ∈ s, (h i).Separable) → ∃ g : Polynomial K, g.Monic ∧ g.Separable ∧ 0 < g.natDegree ∧ ∀ (Ω : Type u) [Field Ω] (ρ : K →+* Ω) (x : Ω), (g.map ρ).eval x = 0 → ∀ i ∈ s, ((h i).map ρ).Splits :=
by
  classical
  intro K _ ι s h hsep
  set f : Polynomial K := ∏ i ∈ s, h i with hf
  have hsepM : Algebra.IsSeparable K f.SplittingField := by
    rw [← separableClosure.eq_top_iff, eq_top_iff]
    have hroots : f.rootSet f.SplittingField ⊆
        ((separableClosure K f.SplittingField).toSubalgebra : Set f.SplittingField) := by
      intro x hx
      rw [IntermediateField.coe_toSubalgebra, SetLike.mem_coe, mem_separableClosure_iff]
      obtain ⟨_, hx0⟩ := Polynomial.mem_rootSet.mp hx
      have hx1 : Polynomial.aeval x (∏ i ∈ s, h i) = 0 := hx0
      rw [map_prod] at hx1
      obtain ⟨i, hi, hix⟩ := Finset.prod_eq_zero_iff.mp hx1
      exact (hsep i hi).of_dvd (minpoly.dvd K x hix)
    have h1 := Algebra.adjoin_le hroots
    rw [Polynomial.SplittingField.adjoin_rootSet] at h1
    intro y _
    exact h1 Algebra.mem_top
  haveI := hsepM
  let pb := Field.powerBasisOfFiniteOfSeparable K f.SplittingField
  have hθ : IsIntegral K pb.gen := IsIntegral.of_finite K pb.gen
  refine ⟨minpoly K pb.gen, minpoly.monic hθ, Algebra.IsSeparable.isSeparable K pb.gen,
    minpoly.natDegree_pos hθ, ?_⟩
  intro Ω _ ρ x hx i hi
  letI : Algebra K Ω := ρ.toAlgebra
  have hx' : Polynomial.aeval x (minpoly K pb.gen) = 0 := by
    rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra, ← Polynomial.eval_map]
    exact hx
  have hfs : (f.map ρ).Splits := by
    have := Polynomial.Splits.of_algHom (Polynomial.SplittingField.splits f) (pb.lift x hx')
    rwa [RingHom.algebraMap_toAlgebra] at this
  have hf0 : f ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j hj => (hsep j hj).ne_zero)
  exact hfs.of_dvd (Polynomial.map_ne_zero hf0)
    (Polynomial.map_dvd ρ (Finset.dvd_prod_of_mem h hi))

theorem wc_standard_etale_residue_root : ∀ (C : Type u) [CommRing C] (p : Ideal C) [p.IsPrime] (g : Polynomial p.ResidueField), g.Monic → g.Separable → 0 < g.natDegree → ∃ (C₀ : Type u) (_ : CommRing C₀) (_ : Algebra C C₀) (_ : Algebra.Etale C C₀) (P₀ : Ideal C₀) (_ : P₀.IsPrime), P₀.comap (algebraMap C C₀) = p ∧ ∃ ρ₀ : p.ResidueField →+* P₀.ResidueField, ρ₀.comp (algebraMap C p.ResidueField) = (algebraMap C₀ P₀.ResidueField).comp (algebraMap C C₀) ∧ ∃ γ : P₀.ResidueField, (g.map ρ₀).eval γ = 0 :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (f : Polynomial R) (s y : R),
      s * (Polynomial.derivative (f.scaleRoots s)).eval (s * y) =
        s ^ f.natDegree * (Polynomial.derivative f).eval y := by
    intro R _ f s y
    have hN1 : (Polynomial.derivative (f.scaleRoots s)).natDegree < f.natDegree + 1 := by
      have := Polynomial.natDegree_derivative_le (f.scaleRoots s)
      rw [Polynomial.natDegree_scaleRoots] at this
      omega
    have hN2 : (Polynomial.derivative f).natDegree < f.natDegree + 1 := by
      have := Polynomial.natDegree_derivative_le f
      omega
    rw [Polynomial.eval_eq_sum_range' hN1, Polynomial.eval_eq_sum_range' hN2, Finset.mul_sum,
      Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Polynomial.coeff_derivative, Polynomial.coeff_derivative, Polynomial.coeff_scaleRoots]
    by_cases h : i + 1 ≤ f.natDegree
    · obtain ⟨k, hk⟩ : ∃ k, f.natDegree = i + 1 + k := ⟨f.natDegree - (i + 1), by omega⟩
      rw [hk, show i + 1 + k - (i + 1) = k by omega]
      ring
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
      ring

  have s2 : ∀ (C : Type u) [CommRing C] (p : Ideal C) [p.IsPrime] (g : Polynomial p.ResidueField),
      g.Monic → ∃ (c : C) (G : Polynomial C), c ∉ p ∧ G.Monic ∧
        G.map (algebraMap C p.ResidueField) = g.scaleRoots (algebraMap C p.ResidueField c) := by
    intro C _ p _ g hg
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors (C ⧸ p))
      (S := p.ResidueField) ((Finset.range (g.natDegree + 1)).image g.coeff)
    obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (b : C ⧸ p)
    have hcb : algebraMap C p.ResidueField c = algebraMap (C ⧸ p) p.ResidueField b := by
      rw [IsScalarTower.algebraMap_apply C (C ⧸ p) p.ResidueField, Ideal.Quotient.algebraMap_eq, hc]
    have hcp : c ∉ p := by
      intro h
      have : (b : C ⧸ p) = 0 := by rw [← hc]; exact Ideal.Quotient.eq_zero_iff_mem.mpr h
      exact nonZeroDivisors.ne_zero b.2 this
    have hrange : ∀ a : C ⧸ p, algebraMap (C ⧸ p) p.ResidueField a ∈
        (algebraMap C p.ResidueField).range := by
      intro a
      obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
      exact ⟨a', by rw [IsScalarTower.algebraMap_apply C (C ⧸ p) p.ResidueField,
        Ideal.Quotient.algebraMap_eq]⟩
    have hmem : ∀ n, (g.scaleRoots (algebraMap C p.ResidueField c)).coeff n ∈
        Set.range (algebraMap C p.ResidueField) := by
      intro n
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy n g.natDegree with h | h | h
      · have hi := hb (g.coeff n) (Finset.mem_image_of_mem _ (Finset.mem_range.mpr (by omega)))
        have h1 : algebraMap C p.ResidueField c * g.coeff n ∈ (algebraMap C p.ResidueField).range := by
          obtain ⟨a, ha⟩ := RingHom.mem_rangeS.mp hi
          rw [Algebra.smul_def, ← hcb] at ha
          rw [← ha]
          exact hrange a
        have h2 : algebraMap C p.ResidueField c ∈ (algebraMap C p.ResidueField).range := ⟨c, rfl⟩
        have e : g.coeff n * algebraMap C p.ResidueField c ^ (g.natDegree - n) =
            (algebraMap C p.ResidueField c * g.coeff n) *
              algebraMap C p.ResidueField c ^ (g.natDegree - n - 1) := by
          obtain ⟨k, hk⟩ : ∃ k, g.natDegree - n = k + 1 := ⟨g.natDegree - n - 1, by omega⟩
          rw [hk, show k + 1 - 1 = k by omega]
          ring
        rw [e]
        exact RingHom.mem_range.mp ((algebraMap C p.ResidueField).range.mul_mem h1
          ((algebraMap C p.ResidueField).range.pow_mem h2 _))
      · rw [h, Polynomial.Monic.coeff_natDegree hg, Nat.sub_self, pow_zero, one_mul]
        exact ⟨1, map_one _⟩
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt h, zero_mul]
        exact ⟨0, map_zero _⟩
    have hlift : g.scaleRoots (algebraMap C p.ResidueField c) ∈
        Polynomial.lifts (algebraMap C p.ResidueField) :=
      (Polynomial.lifts_iff_coeff_lifts _).mpr hmem
    obtain ⟨G, hG, -, hGm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff _).mpr hg)
    exact ⟨c, G, hcp, hGm, hG⟩

  have s3 : ∀ (C : Type u) [CommRing C] (G : Polynomial C), G.Monic → ∀ (Ω : Type u) [Field Ω]
      (φ : C →+* Ω) (x : Ω), G.eval₂ φ x = 0 → (Polynomial.derivative G).eval₂ φ x ≠ 0 →
      ∃ (C₀ : Type u) (_ : CommRing C₀) (_ : Algebra C C₀) (_ : Algebra.Etale C C₀) (P₀ : Ideal C₀)
        (_ : P₀.IsPrime), P₀.comap (algebraMap C C₀) = RingHom.ker φ ∧
        ∃ t : C₀, G.eval₂ (algebraMap C C₀) t = 0 := by
    intro C _ G hG Ω _ φ x hx hx'
    let P : StandardEtalePair C := ⟨G, hG, Polynomial.derivative G, ⟨1, 0, 1, by ring⟩⟩
    letI : Algebra C Ω := φ.toAlgebra
    have hmap : P.HasMap x := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.aeval_def]; exact hx
      · rw [Polynomial.aeval_def]; exact Ne.isUnit hx'
    let l := P.lift x hmap
    refine ⟨P.Ring, inferInstance, inferInstance, inferInstance, RingHom.ker l,
      RingHom.ker_isPrime _, ?_, P.X, ?_⟩
    · ext c
      simp only [Ideal.mem_comap, RingHom.mem_ker]
      rw [AlgHom.commutes]
      rfl
    · have := (StandardEtalePair.hasMap_X (P := P)).1
      rw [Polynomial.aeval_def] at this
      exact this

  intro C _ p _ g hgm hgs hgd
  obtain ⟨c, G, hcp, hGm, hGmap⟩ := s2 C p g hgm
  have hcb0 : algebraMap C p.ResidueField c ≠ 0 := fun h =>
    hcp (Ideal.algebraMap_residueField_eq_zero.mp h)
  have hgi_monic : (g.map (algebraMap p.ResidueField g.SplittingField)).Monic := hgm.map _
  have hgi_deg : (g.map (algebraMap p.ResidueField g.SplittingField)).natDegree = g.natDegree :=
    hgm.natDegree_map _
  obtain ⟨α, hα⟩ := Polynomial.Splits.exists_eval_eq_zero (Polynomial.SplittingField.splits g) (by
    rw [Polynomial.degree_eq_natDegree hgi_monic.ne_zero, hgi_deg]
    exact_mod_cast hgd.ne')
  have hi : Function.Injective (algebraMap p.ResidueField g.SplittingField) := RingHom.injective _
  let φ : C →+* g.SplittingField :=
    (algebraMap p.ResidueField g.SplittingField).comp (algebraMap C p.ResidueField)
  have hs0 : algebraMap p.ResidueField g.SplittingField (algebraMap C p.ResidueField c) ≠ 0 :=
    (map_ne_zero _).mpr hcb0
  have hGφ : G.map φ = (g.map (algebraMap p.ResidueField g.SplittingField)).scaleRoots
      (algebraMap p.ResidueField g.SplittingField (algebraMap C p.ResidueField c)) := by
    rw [← Polynomial.map_map, hGmap, Polynomial.map_scaleRoots _ _ _
      (by rw [hgm.leadingCoeff, map_one]; exact one_ne_zero)]
  have hroot : G.eval₂ φ
      (algebraMap p.ResidueField g.SplittingField (algebraMap C p.ResidueField c) * α) = 0 := by
    rw [Polynomial.eval₂_eq_eval_map, hGφ, Polynomial.scaleRoots_eval_mul, hα, mul_zero]
  have hsimple : (Polynomial.derivative G).eval₂ φ
      (algebraMap p.ResidueField g.SplittingField (algebraMap C p.ResidueField c) * α) ≠ 0 := by
    rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.derivative_map, hGφ]
    intro hD
    have h1 := s1 g.SplittingField (g.map (algebraMap p.ResidueField g.SplittingField))
      (algebraMap p.ResidueField g.SplittingField (algebraMap C p.ResidueField c)) α
    rw [hD, mul_zero] at h1
    have h2 : (Polynomial.derivative (g.map (algebraMap p.ResidueField g.SplittingField))).eval α
        ≠ 0 := by
      have := (hgs.map (f := algebraMap p.ResidueField g.SplittingField)).aeval_derivative_ne_zero
        (x := α) (by rw [Polynomial.coe_aeval_eq_eval]; exact hα)
      rwa [Polynomial.coe_aeval_eq_eval] at this
    exact mul_ne_zero (pow_ne_zero _ hs0) h2 h1.symm
  obtain ⟨C₀, i1, i2, i3, P₀, hP₀, hcomap, t, ht⟩ := s3 C G hGm g.SplittingField φ _ hroot hsimple
  have hker : RingHom.ker φ = p := by
    rw [RingHom.ker_comp_of_injective _ hi, Ideal.ker_algebraMap_residueField]
  rw [hker] at hcomap
  refine ⟨C₀, i1, i2, i3, P₀, hP₀, hcomap, ?_⟩
  let ρ₀ := Ideal.ResidueField.map p P₀ (algebraMap C C₀) hcomap.symm
  have hρ : ρ₀.comp (algebraMap C p.ResidueField) =
      (algebraMap C₀ P₀.ResidueField).comp (algebraMap C C₀) :=
    RingHom.ext fun c => Ideal.ResidueField.map_algebraMap p P₀ _ hcomap.symm c
  refine ⟨ρ₀, hρ, ?_⟩
  have hy : ((g.map ρ₀).scaleRoots (ρ₀ (algebraMap C p.ResidueField c))).eval
      (algebraMap C₀ P₀.ResidueField t) = 0 := by
    have h := Polynomial.hom_eval₂ G (algebraMap C C₀) (algebraMap C₀ P₀.ResidueField) t
    rw [ht, map_zero, ← hρ, ← Polynomial.eval₂_map, Polynomial.eval₂_eq_eval_map, hGmap,
      Polynomial.map_scaleRoots _ _ _ (by rw [hgm.leadingCoeff, map_one]; exact one_ne_zero)] at h
    exact h.symm
  have hs'0 : ρ₀ (algebraMap C p.ResidueField c) ≠ 0 := (map_ne_zero ρ₀).mpr hcb0
  refine ⟨algebraMap C₀ P₀.ResidueField t / ρ₀ (algebraMap C p.ResidueField c), ?_⟩
  have e : algebraMap C₀ P₀.ResidueField t = ρ₀ (algebraMap C p.ResidueField c) *
      (algebraMap C₀ P₀.ResidueField t / ρ₀ (algebraMap C p.ResidueField c)) :=
    (mul_div_cancel₀ _ hs'0).symm
  rw [e, Polynomial.scaleRoots_eval_mul] at hy
  exact (mul_eq_zero.mp hy).resolve_left (pow_ne_zero _ hs'0)

theorem wc_ring_propB_split : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Module.Finite C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] [∀ i, Algebra.Etale D (E i)], (∀ q : Ideal D, q.IsPrime → ∃ (i : Fin n) (r : Ideal (E i)), r.IsPrime ∧ r.comap (algebraMap D (E i)) = q) → ∀ p : Ideal C, p.IsPrime → ∃ (C₀ : Type u) (_ : CommRing C₀) (_ : Algebra C C₀) (_ : Algebra.Etale C C₀) (P₀ : Ideal C₀), P₀.IsPrime ∧ P₀.comap (algebraMap C C₀) = p ∧ ∀ (Q : Ideal (TensorProduct C C₀ D)) [Q.IsPrime], Q.comap (Algebra.TensorProduct.includeLeft : C₀ →ₐ[C] TensorProduct C C₀ D).toRingHom = P₀ → ∃ (i : Fin n) (r : Ideal (E i)) (_ : r.IsPrime), r.comap (algebraMap D (E i)) = Q.comap (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₀ D).toRingHom ∧ ∃ σ : r.ResidueField →+* Q.ResidueField, σ.comp ((algebraMap (E i) r.ResidueField).comp (algebraMap D (E i))) = (algebraMap (TensorProduct C C₀ D) Q.ResidueField).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₀ D).toRingHom :=
by
  classical
  intro C D _ _ _ _ n E _ _ _ hcov p hp
  haveI := hp
  haveI : Algebra.IsIntegral C D := inferInstance
  haveI : Algebra.QuasiFinite C D := inferInstance

  have hfin := Algebra.QuasiFinite.finite_primesOver (S := D) p
  obtain ⟨s, hs⟩ : ∃ s : Finset (Ideal D), ∀ q, q ∈ s ↔ q ∈ p.primesOver D :=
    ⟨hfin.toFinset, fun q => hfin.mem_toFinset⟩
  have mem : ∀ q, q ∈ s → q.IsPrime ∧ q.comap (algebraMap C D) = p := fun q hq => by
    have h := (hs q).mp hq
    exact ⟨h.1, by rw [← Ideal.under_def]; exact h.2.over.symm⟩

  have key : ∀ (q : Ideal D) (hq : q.IsPrime) (hqp : q.comap (algebraMap C D) = p),
      ∃ (i : Fin n) (r : Ideal (E i)) (_ : r.IsPrime) (_ : r.comap (algebraMap D (E i)) = q)
        (h : Polynomial p.ResidueField), h.Separable ∧
        ∀ (Ω : Type u) [Field Ω] (τ : q.ResidueField →+* Ω) (ρ : p.ResidueField →+* Ω),
          ρ.comp (algebraMap C p.ResidueField) =
            τ.comp ((algebraMap D q.ResidueField).comp (algebraMap C D)) →
          (h.map ρ).Splits → ∃ σ : r.ResidueField →+* Ω,
            σ.comp ((algebraMap (E i) r.ResidueField).comp (algebraMap D (E i))) =
              τ.comp (algebraMap D q.ResidueField) := by
    intro q hq hqp
    obtain ⟨i, r, hr, hrq⟩ := hcov q hq
    haveI := hr
    obtain ⟨h, _, hsep, hprop⟩ := wc_residue_embed_poly C D (E i) p q r hqp hrq
    exact ⟨i, r, hr, hrq, h, hsep, hprop⟩
  choose I R hR hRq H hHs hHprop using key
  let hfam : Ideal D → Polynomial p.ResidueField := fun q =>
    if hq : q ∈ s then H q (mem q hq).1 (mem q hq).2 else 1

  obtain ⟨g, hgm, hgs, hgd, hgsplit⟩ := wc_separable_poly_common_splitter p.ResidueField
    (Ideal D) s hfam (by
      intro q hq
      simp only [hfam, dif_pos hq]
      exact hHs _ _ _)

  obtain ⟨C₀, i1, i2, i3, P₀, hP₀, hP₀p, ρ₀, hρ₀, γ, hγ⟩ :=
    wc_standard_etale_residue_root C p g hgm hgs hgd
  refine ⟨C₀, i1, i2, i3, P₀, hP₀, hP₀p, ?_⟩
  intro Q hQ hQP
  have hcomm : (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₀ D).toRingHom.comp
      (algebraMap C D) =
      (Algebra.TensorProduct.includeLeft : C₀ →ₐ[C] TensorProduct C C₀ D).toRingHom.comp
      (algebraMap C C₀) := by
    refine RingHom.ext fun c => ?_
    change (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₀ D) (algebraMap C D c) =
      (Algebra.TensorProduct.includeLeft : C₀ →ₐ[C] TensorProduct C C₀ D) (algebraMap C C₀ c)
    rw [AlgHom.commutes, AlgHom.commutes]
  set q := Q.comap (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₀ D).toRingHom
    with hqdef
  haveI hqprime : q.IsPrime := Ideal.comap_isPrime _ _
  have hqp : q.comap (algebraMap C D) = p := by
    rw [hqdef, Ideal.comap_comap, hcomm, ← Ideal.comap_comap, hQP, hP₀p]
  have hqs : q ∈ s := (hs q).mpr ⟨hqprime, ⟨by rw [Ideal.under_def]; exact hqp.symm⟩⟩
  refine ⟨I q hqprime hqp, R q hqprime hqp, hR q hqprime hqp, hRq q hqprime hqp, ?_⟩
  let τ : q.ResidueField →+* Q.ResidueField := Ideal.ResidueField.map q Q
    (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₀ D).toRingHom rfl
  let φ₀ : P₀.ResidueField →+* Q.ResidueField := Ideal.ResidueField.map P₀ Q
    (Algebra.TensorProduct.includeLeft : C₀ →ₐ[C] TensorProduct C C₀ D).toRingHom hQP.symm
  let ρ : p.ResidueField →+* Q.ResidueField := φ₀.comp ρ₀
  have hcompat : ρ.comp (algebraMap C p.ResidueField) =
      τ.comp ((algebraMap D q.ResidueField).comp (algebraMap C D)) := by
    refine RingHom.ext fun c => ?_
    have h1 := congrArg (fun f => f c) hρ₀
    simp only [RingHom.comp_apply] at h1
    change φ₀ (ρ₀ (algebraMap C p.ResidueField c)) = τ (algebraMap D q.ResidueField (algebraMap C D c))
    rw [h1, Ideal.ResidueField.map_algebraMap, Ideal.ResidueField.map_algebraMap]
    have h2 := congrArg (fun f => f c) hcomm
    simp only [RingHom.comp_apply] at h2
    rw [h2]
  have hsplit : ((hfam q).map ρ).Splits := by
    refine hgsplit Q.ResidueField ρ (φ₀ γ) ?_ q hqs
    rw [show g.map ρ = (g.map ρ₀).map φ₀ by rw [Polynomial.map_map], Polynomial.eval_map_apply,
      hγ, map_zero]
  have hH : hfam q = H q hqprime hqp := dif_pos hqs
  rw [hH] at hsplit
  obtain ⟨σ, hσ⟩ := hHprop q hqprime hqp Q.ResidueField τ ρ hcompat hsplit
  refine ⟨σ, ?_⟩
  rw [hσ]
  refine RingHom.ext fun d => ?_
  exact Ideal.ResidueField.map_algebraMap _ _ _ _ d

theorem wc_tensor_fiber_inj_of_residue_triv : ∀ (C C₁ C₃ D : Type u) [CommRing C] [CommRing C₁] [CommRing C₃] [CommRing D] [Algebra C C₁] [Algebra C C₃] [Algebra C₁ C₃] [IsScalarTower C C₁ C₃] [Algebra C D] (P₁ : Ideal C₁) (P₃ : Ideal C₃), P₃.IsPrime → P₃.comap (algebraMap C₁ C₃) = P₁ → (∀ y : C₃, ∃ x s : C₁, s ∉ P₁ ∧ algebraMap C₁ C₃ s * y - algebraMap C₁ C₃ x ∈ P₃) → ∀ Q Q' : Ideal (TensorProduct C C₃ D), Q.IsPrime → Q'.IsPrime → Q.comap (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D).toRingHom = P₃ → Q'.comap (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D).toRingHom = P₃ → Q.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃) (AlgHom.id C D)).toRingHom = Q'.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃) (AlgHom.id C D)).toRingHom → Q = Q' :=
by
  intro C C₁ C₃ D _ _ _ _ _ _ _ _ _ P₁ P₃ hP₃ hP₃P₁ hres Q Q' hQ hQ' hQP hQ'P hμ
  classical
  haveI := hP₃
  have hP₁ : P₁.IsPrime := by rw [← hP₃P₁]; exact Ideal.IsPrime.comap _
  have hK : ∀ a : C₁, (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃)
      (AlgHom.id C D)) (a ⊗ₜ[C] (1 : D)) =
      (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D) (algebraMap C₁ C₃ a) := by
    intro a
    simp [Algebra.TensorProduct.map_tmul]
  have approx : ∀ z : TensorProduct C C₃ D, ∃ (s : C₁) (t : TensorProduct C C₁ D)
      (w : TensorProduct C C₃ D), s ∉ P₁ ∧
      w ∈ P₃.map (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D).toRingHom ∧
      (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D) (algebraMap C₁ C₃ s) * z
        = (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃) (AlgHom.id C D)) t + w := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
      refine ⟨1, 0, 0, fun h => hP₁.ne_top ((Ideal.eq_top_iff_one _).mpr h),
        Ideal.zero_mem _, ?_⟩
      simp
    | tmul c d =>
      obtain ⟨x, s, hs, hp⟩ := hres c
      refine ⟨s, x ⊗ₜ[C] d,
        (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D)
          (algebraMap C₁ C₃ s * c - algebraMap C₁ C₃ x) * ((1 : C₃) ⊗ₜ[C] d), hs,
        Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hp), ?_⟩
      simp only [Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.tmul_mul_tmul,
        Algebra.TensorProduct.map_tmul, IsScalarTower.toAlgHom_apply, AlgHom.id_apply, one_mul,
        mul_one]
      rw [← TensorProduct.add_tmul]
      congr 1
      ring
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨s₁, t₁, w₁, hs₁, hw₁, e₁⟩ := h₁
      obtain ⟨s₂, t₂, w₂, hs₂, hw₂, e₂⟩ := h₂
      refine ⟨s₁ * s₂, (s₂ ⊗ₜ[C] (1 : D)) * t₁ + (s₁ ⊗ₜ[C] (1 : D)) * t₂,
        (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D)
            (algebraMap C₁ C₃ s₂) * w₁ +
          (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D)
            (algebraMap C₁ C₃ s₁) * w₂,
        hP₁.mul_notMem hs₁ hs₂,
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ hw₁) (Ideal.mul_mem_left _ _ hw₂), ?_⟩
      simp only [map_add, map_mul, hK]
      linear_combination
        (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D)
            (algebraMap C₁ C₃ s₂) * e₁ +
          (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D)
            (algebraMap C₁ C₃ s₁) * e₂
  have key : ∀ A B : Ideal (TensorProduct C C₃ D), B.IsPrime →
      A.comap (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D).toRingHom = P₃ →
      B.comap (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D).toRingHom = P₃ →
      A.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃)
        (AlgHom.id C D)).toRingHom =
      B.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃)
        (AlgHom.id C D)).toRingHom → A ≤ B := by
    intro A B hB hA3 hB3 hAB z hz
    obtain ⟨s, t, w, hs, hw, e⟩ := approx z
    have hwA : w ∈ A := (Ideal.map_le_iff_le_comap.mpr (le_of_eq hA3.symm)) hw
    have hwB : w ∈ B := (Ideal.map_le_iff_le_comap.mpr (le_of_eq hB3.symm)) hw
    have htA : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃) (AlgHom.id C D)) t ∈ A := by
      have h0 : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃) (AlgHom.id C D)) t =
          (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D)
            (algebraMap C₁ C₃ s) * z - w := by
        rw [e]; ring
      rw [h0]
      exact A.sub_mem (A.mul_mem_left _ hz) hwA
    have htB : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃) (AlgHom.id C D)) t ∈ B := by
      have h1 : t ∈ A.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₃)
          (AlgHom.id C D)).toRingHom := htA
      rw [hAB] at h1
      exact h1
    have hsz : (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D)
        (algebraMap C₁ C₃ s) * z ∈ B := by
      rw [e]; exact B.add_mem htB hwB
    rcases hB.mem_or_mem hsz with h | h
    · exfalso
      apply hs
      rw [← hP₃P₁, Ideal.mem_comap, ← hB3, Ideal.mem_comap]
      exact h
    · exact h
  exact le_antisymm (key Q Q' hQ' hQP hQ'P hμ) (key Q' Q hQ hQ'P hQP hμ.symm)

theorem wc_finite_etale_rank_one_section : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.Finite A B] [Algebra.Etale A B] (q : Ideal A) [q.IsPrime] (R : Ideal B) [R.IsPrime], R.comap (algebraMap A B) = q → (∀ R' : Ideal B, R'.IsPrime → R'.comap (algebraMap A B) = q → R' = R) → (∀ y : B, ∃ x s : A, s ∉ q ∧ algebraMap A B s * y - algebraMap A B x ∈ R) → ∃ g : A, g ∉ q ∧ ∃ ψ : B →+* Localization.Away g, ψ.comp (algebraMap A B) = algebraMap A (Localization.Away g) :=
by
  intro A B _ _ _ _ _ q _ R hR hRq huniq hTR
  classical

  have s1 : ∀ r ∈ R, (1 : q.ResidueField) ⊗ₜ[A] r = (0 : TensorProduct A q.ResidueField B) := by
    intro r hr
    haveI : Algebra.Etale q.ResidueField (TensorProduct A q.ResidueField B) :=
      Algebra.Etale.baseChange A B q.ResidueField
    haveI : _root_.IsReduced (TensorProduct A q.ResidueField B) :=
      Algebra.FormallyUnramified.isReduced_of_field q.ResidueField _
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro P hP
    haveI := hP
    let P' := P.comap (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A q.ResidueField B)
    haveI : P'.IsPrime := Ideal.comap_isPrime _ _
    have hP' : P'.comap (algebraMap A B) = q := by
      have e1 : P'.comap (algebraMap A B) =
          P.comap (algebraMap A (TensorProduct A q.ResidueField B)) := by
        ext a
        simp only [P', Ideal.mem_comap]
        rw [AlgHom.commutes]
      haveI : (P.comap (algebraMap q.ResidueField (TensorProduct A q.ResidueField B))).IsPrime :=
        Ideal.comap_isPrime _ _
      rw [e1, IsScalarTower.algebraMap_eq A q.ResidueField (TensorProduct A q.ResidueField B),
        ← Ideal.comap_comap, Ideal.eq_bot_of_prime (P.comap _), ← RingHom.ker_eq_comap_bot,
        Ideal.ker_algebraMap_residueField]
    have hPR := huniq P' inferInstance hP'
    have hr' : r ∈ P' := hPR ▸ hr
    have hr'' := Ideal.mem_comap.mp hr'
    rwa [Algebra.TensorProduct.includeRight_apply] at hr''
  have hfib : ∀ b : B, ∃ x s : A, s ∉ q ∧ (1 : q.ResidueField) ⊗ₜ[A]
      (algebraMap A B s * b - algebraMap A B x) = (0 : TensorProduct A q.ResidueField B) := by
    intro b
    obtain ⟨x, s, hs, hb⟩ := hTR b
    exact ⟨x, s, hs, s1 _ hb⟩

  obtain ⟨g₁, hg₁q, hsurj⟩ : ∃ g₁ : A, g₁ ∉ q ∧
      ∀ b : B, ∃ a : A, algebraMap A B g₁ * b = algebraMap A B a := by
    set N := LinearMap.range (Algebra.linearMap A B) with hN
    have h1 : ∀ b : B, (1 : q.ResidueField) ⊗ₜ[A] N.mkQ b = 0 := by
      intro b
      obtain ⟨x, s, hs, hb⟩ := hfib b
      have e := congrArg (LinearMap.lTensor q.ResidueField N.mkQ) hb
      rw [LinearMap.lTensor_tmul, map_zero, map_sub] at e
      have hx : N.mkQ (algebraMap A B x) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact ⟨x, rfl⟩
      rw [hx, sub_zero, ← Algebra.smul_def, map_smul, TensorProduct.tmul_smul,
        ← algebraMap_smul q.ResidueField s] at e
      have hs' : algebraMap A q.ResidueField s ≠ 0 := by
        rwa [Ne, Ideal.algebraMap_residueField_eq_zero]
      exact (smul_eq_zero.mp e).resolve_left hs'
    have hall : ∀ z : TensorProduct A q.ResidueField (B ⧸ N), z = 0 := by
      intro z
      obtain ⟨w, rfl⟩ := LinearMap.lTensor_surjective q.ResidueField (Submodule.mkQ_surjective N) z
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul k b =>
        rw [LinearMap.lTensor_tmul]
        have : k ⊗ₜ[A] N.mkQ b = k • ((1 : q.ResidueField) ⊗ₜ[A] N.mkQ b) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [this, h1, smul_zero]
      | add a b ha hb => rw [map_add, ha, hb, add_zero]
    have hsub : Subsingleton (TensorProduct A q.ResidueField (B ⧸ N)) :=
      ⟨fun x y => by rw [hall x, hall y]⟩
    have hns : (⟨q, inferInstance⟩ : PrimeSpectrum A) ∉ Module.support A (B ⧸ N) := by
      rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct,
        not_nontrivial_iff_subsingleton]
      exact hsub
    rw [Module.mem_support_iff_of_finite, SetLike.not_le_iff_exists] at hns
    obtain ⟨g₁, hg₁, hg₁q⟩ := hns
    refine ⟨g₁, hg₁q, fun b => ?_⟩
    have := Module.mem_annihilator.mp hg₁ (N.mkQ b)
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this
    obtain ⟨a, ha⟩ := this
    exact ⟨a, by rw [← Algebra.smul_def, ← ha]; rfl⟩

  have hpt : ∀ a : A, algebraMap A B a = 0 → ∃ t : A, t ∉ q ∧ t * a = 0 := by
    intro a ha
    obtain ⟨k, c, y, hy, hc⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := A) (M := B)
      (f := fun _ : Unit => a) (x := fun _ => (1 : B)) (by simp [Algebra.smul_def, ha])
    by_contra hcon
    push_neg at hcon
    apply hR.ne_top
    apply Ideal.eq_top_of_isUnit_mem R _ isUnit_one
    have h1 : (1 : B) = ∑ j, c () j • y j := hy ()
    rw [h1]
    apply Ideal.sum_mem
    intro j _
    have hcj : c () j ∈ q := by
      by_contra hnot
      apply hcon (c () j) hnot
      simpa [mul_comm] using hc j
    rw [← hRq] at hcj
    convert R.mul_mem_right (y j) hcj using 1
    exact Algebra.smul_def _ _

  haveI : Module.FinitePresentation A B := Module.FinitePresentation.of_finite_of_finitePresentation A B
  obtain ⟨h, hhq, hker⟩ : ∃ h : A, h ∉ q ∧ ∀ a : A, algebraMap A B a = 0 → h * a = 0 := by
    obtain ⟨n, β, hβ⟩ := Module.Finite.exists_fin (R := A) (M := B)
    choose α hα using fun i => hsurj (β i)
    let ℓ : (A × (Fin n → A)) →ₗ[A] B :=
      (LinearMap.toSpanSingleton A B 1).coprod (Fintype.linearCombination A β)
    let θ : (A × (Fin n → A)) →ₗ[A] A :=
      (LinearMap.toSpanSingleton A A g₁).coprod (Fintype.linearCombination A α)
    have hℓ : Function.Surjective ℓ := by
      rw [← LinearMap.range_eq_top, eq_top_iff, ← hβ, ← Fintype.range_linearCombination,
        LinearMap.range_coprod]
      exact le_sup_right
    have hK : (LinearMap.ker ℓ).FG := Module.FinitePresentation.fg_ker ℓ hℓ
    have hkey : ∀ v, algebraMap A B (θ v) = algebraMap A B g₁ * ℓ v := by
      rintro ⟨c₀, c⟩
      simp only [θ, ℓ, LinearMap.coprod_apply, LinearMap.toSpanSingleton_apply,
        Fintype.linearCombination_apply, smul_eq_mul]
      simp only [Algebra.smul_def, map_add, map_mul, map_sum, mul_one, mul_add, Finset.mul_sum]
      congr 1
      · ring
      · apply Finset.sum_congr rfl
        intro i _
        rw [← hα i]
        ring
    have hK' : (Submodule.map θ (LinearMap.ker ℓ)).FG := hK.map θ
    obtain ⟨S, hSfin, hSspan⟩ := Submodule.fg_def.mp hK'
    have hSker : ∀ s ∈ S, algebraMap A B s = 0 := by
      intro s hs
      have : s ∈ Submodule.map θ (LinearMap.ker ℓ) := hSspan ▸ Submodule.subset_span hs
      obtain ⟨v, hv, rfl⟩ := this
      rw [hkey, LinearMap.mem_ker.mp hv, mul_zero]
    choose! t ht using fun s (hs : s ∈ S) => hpt s (hSker s hs)
    have hT : (∏ s ∈ hSfin.toFinset, t s) ∉ q := by
      intro hmem
      obtain ⟨s, hs, hts⟩ := (Ideal.IsPrime.prod_mem_iff).mp hmem
      exact (ht s (hSfin.mem_toFinset.mp hs)).1 hts
    have hTS : ∀ z ∈ Submodule.map θ (LinearMap.ker ℓ), (∏ s ∈ hSfin.toFinset, t s) * z = 0 := by
      intro z hz
      rw [← hSspan] at hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨d, hd⟩ := Finset.dvd_prod_of_mem t (hSfin.mem_toFinset.mpr hx)
        rw [hd, mul_comm (t x) d, mul_assoc, (ht x hx).2, mul_zero]
      | zero => rw [mul_zero]
      | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
      | smul a x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]
    refine ⟨(∏ s ∈ hSfin.toFinset, t s) * g₁, Ideal.IsPrime.mul_notMem inferInstance hT hg₁q,
      fun a ha => ?_⟩
    have hmem : g₁ * a ∈ Submodule.map θ (LinearMap.ker ℓ) := by
      refine ⟨(a, 0), ?_, ?_⟩
      · show ℓ (a, 0) = 0
        simp [ℓ, LinearMap.coprod_apply, Algebra.smul_def, ha]
      · simp [θ, mul_comm]
    rw [mul_assoc]
    exact hTS _ hmem

  refine ⟨g₁ * h, Ideal.IsPrime.mul_notMem inferInstance hg₁q hhq, ?_⟩
  have hgu : IsUnit (algebraMap A (Localization.Away (g₁ * h)) (g₁ * h)) :=
    IsLocalization.Away.algebraMap_isUnit (g₁ * h)
  have hu : IsUnit (algebraMap A (Localization.Away (g₁ * h)) g₁) := by
    rw [map_mul] at hgu
    exact (IsUnit.mul_iff.mp hgu).1
  have hkerL : ∀ a : A, algebraMap A B a = 0 → algebraMap A (Localization.Away (g₁ * h)) a = 0 := by
    intro a ha
    have h0 : (g₁ * h) * a = 0 := by rw [mul_assoc, hker a ha, mul_zero]
    have h1 := congrArg (algebraMap A (Localization.Away (g₁ * h))) h0
    rw [map_mul, map_zero] at h1
    exact (IsUnit.mul_right_eq_zero hgu).mp h1

  have s5 : ∀ (L : Type u) [CommRing L] [Algebra A L], IsUnit (algebraMap A L g₁) →
      (∀ a : A, algebraMap A B a = 0 → algebraMap A L a = 0) →
      ∃ ψ : B →+* L, ψ.comp (algebraMap A B) = algebraMap A L := by
    intro L _ _ hu hker
    choose α hα using hsurj
    obtain ⟨u, hu'⟩ := hu
    have hwd : ∀ a a' : A, algebraMap A B a = algebraMap A B a' →
        algebraMap A L a = algebraMap A L a' := by
      intro a a' h
      have := hker (a - a') (by rw [map_sub, h, sub_self])
      rw [map_sub, sub_eq_zero] at this
      exact this
    have key : ∀ b : B, ∀ a : A, algebraMap A B a = algebraMap A B g₁ * b →
        (↑u⁻¹ : L) * algebraMap A L (α b) = ↑u⁻¹ * algebraMap A L a := by
      intro b a h
      rw [hwd (α b) a ((hα b).symm.trans h.symm)]
    let f : B → L := fun b => (↑u⁻¹ : L) * algebraMap A L (α b)
    have hf : ∀ c : A, f (algebraMap A B c) = algebraMap A L c := by
      intro c
      show (↑u⁻¹ : L) * algebraMap A L (α _) = _
      rw [key _ (g₁ * c) (by rw [map_mul]), map_mul, ← hu', ← mul_assoc, Units.inv_mul, one_mul]
    refine ⟨{ toFun := f, map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ }, ?_⟩
    · have := hf 1
      rwa [map_one, map_one] at this
    · intro x y
      show (↑u⁻¹ : L) * algebraMap A L (α (x * y)) =
        (↑u⁻¹ * algebraMap A L (α x)) * (↑u⁻¹ * algebraMap A L (α y))
      have h1 : algebraMap A B (g₁ * α (x * y)) = algebraMap A B (α x * α y) := by
        rw [map_mul, map_mul, ← hα, ← hα, ← hα]; ring
      have h2 := hwd _ _ h1
      rw [map_mul, map_mul, ← hu'] at h2
      calc (↑u⁻¹ : L) * algebraMap A L (α (x * y))
          = ↑u⁻¹ * ↑u⁻¹ * (↑u * algebraMap A L (α (x * y))) := by
            rw [← mul_assoc, mul_assoc (↑u⁻¹ : L) (↑u⁻¹ : L) (↑u : L), Units.inv_mul, mul_one]
        _ = _ := by rw [h2]; ring
    · show (↑u⁻¹ : L) * algebraMap A L (α 0) = 0
      rw [key 0 0 (by simp)]
      simp
    · intro x y
      show (↑u⁻¹ : L) * algebraMap A L (α (x + y)) =
        ↑u⁻¹ * algebraMap A L (α x) + ↑u⁻¹ * algebraMap A L (α y)
      rw [key (x + y) (α x + α y) (by rw [map_add, ← hα, ← hα, mul_add]), map_add, mul_add]
    · ext c
      exact hf c
  exact s5 _ hu hkerL

theorem wc_etale_nbhd_isolate_tensor : ∀ (C S : Type u) [CommRing C] [CommRing S] [Algebra C S] [Algebra.FiniteType C S] [Algebra.QuasiFinite C S] (C₁ : Type u) [CommRing C₁] [Algebra C C₁] (P₁ : Ideal C₁) [P₁.IsPrime] (R : Ideal (TensorProduct C C₁ S)) [R.IsPrime], R.comap (Algebra.TensorProduct.includeLeft : C₁ →ₐ[C] TensorProduct C C₁ S).toRingHom = P₁ → ∃ (C₂ : Type u) (_ : CommRing C₂) (_ : Algebra C₁ C₂) (_ : Algebra C C₂) (_ : IsScalarTower C C₁ C₂) (_ : Algebra.Etale C₁ C₂) (P₂ : Ideal C₂), P₂.IsPrime ∧ P₂.comap (algebraMap C₁ C₂) = P₁ ∧ (∀ y : C₂, ∃ x s : C₁, s ∉ P₁ ∧ algebraMap C₁ C₂ s * y - algebraMap C₁ C₂ x ∈ P₂) ∧ ∃ (f : TensorProduct C C₂ S), IsIdempotentElem f ∧ Module.Finite C₂ (Localization.Away f) ∧ ∃ R₂ : Ideal (TensorProduct C C₂ S), R₂.IsPrime ∧ R₂.comap (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ S).toRingHom = P₂ ∧ R₂.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C S)).toRingHom = R ∧ f ∉ R₂ ∧ ∀ R' : Ideal (TensorProduct C C₂ S), R'.IsPrime → R'.comap (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ S).toRingHom = P₂ → f ∉ R' → R' = R₂ :=
by
  intro C S _ _ _ _ _ C₁ _ _ P₁ _ R _ hR
  classical
  have hRlo : R.LiesOver P₁ := ⟨by rw [Ideal.under_def]; exact hR.symm⟩
  obtain ⟨C₂, _, _, _, P, hP, hPo, e, he, P', hP', hP'o, hP'R, heP', hbij, hfin, huniq⟩ :=
    Algebra.exists_etale_isIdempotentElem_forall_liesOver_eq (R := C₁)
      (S := TensorProduct C C₁ S) P₁ R
  letI : Algebra C C₂ := ((algebraMap C₁ C₂).comp (algebraMap C C₁)).toAlgebra
  haveI : IsScalarTower C C₁ C₂ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)

  have hPP₁ : P.comap (algebraMap C₁ C₂) = P₁ := by
    rw [← Ideal.under_def]; exact (Ideal.over_def P P₁).symm

  have hgen : ∀ φ : P₁.ResidueField →ₐ[C₁] P.ResidueField, Function.Surjective φ →
      ∀ y : C₂, ∃ x s : C₁, s ∉ P₁ ∧ algebraMap C₁ C₂ s * y - algebraMap C₁ C₂ x ∈ P := by
    intro φ hφ y
    obtain ⟨w, hw⟩ := hφ (algebraMap C₂ P.ResidueField y)
    obtain ⟨xb, sb, hsb, hwq⟩ := IsFractionRing.div_surjective (A := C₁ ⧸ P₁) w
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xb
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective sb
    have hs : s ∉ P₁ := by
      intro hs
      exact nonZeroDivisors.ne_zero hsb (Ideal.Quotient.eq_zero_iff_mem.mpr hs)
    refine ⟨x, s, hs, ?_⟩
    have hφa : ∀ a : C₁, φ (algebraMap (C₁ ⧸ P₁) P₁.ResidueField (Ideal.Quotient.mk P₁ a)) =
        algebraMap C₂ P.ResidueField (algebraMap C₁ C₂ a) := by
      intro a
      rw [← Ideal.Quotient.algebraMap_eq,
        ← IsScalarTower.algebraMap_apply C₁ (C₁ ⧸ P₁) P₁.ResidueField, AlgHom.commutes,
        IsScalarTower.algebraMap_apply C₁ C₂ P.ResidueField]
    subst hwq
    rw [map_div₀, hφa, hφa] at hw
    have hs0 : algebraMap C₂ P.ResidueField (algebraMap C₁ C₂ s) ≠ 0 := by
      intro h0
      rw [Ideal.algebraMap_residueField_eq_zero] at h0
      apply hs
      rw [← hPP₁, Ideal.mem_comap]
      exact h0
    rw [← Ideal.algebraMap_residueField_eq_zero, map_sub, map_mul, ← hw]
    have hc : algebraMap C₂ P.ResidueField (algebraMap C₁ C₂ s) *
        (algebraMap C₂ P.ResidueField (algebraMap C₁ C₂ x) /
          algebraMap C₂ P.ResidueField (algebraMap C₁ C₂ s)) =
        algebraMap C₂ P.ResidueField (algebraMap C₁ C₂ x) := by
      field_simp
    rw [hc, sub_self]
  have hTR := hgen _ hbij.2

  let Ψ := Algebra.TensorProduct.cancelBaseChange C C₁ C₂ C₂ S
  have hΨ1 : ∀ x : TensorProduct C C₁ S,
      Ψ ((Algebra.TensorProduct.includeRight :
        TensorProduct C C₁ S →ₐ[C₁] TensorProduct C₁ C₂ (TensorProduct C C₁ S)) x) =
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C S) x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul c s =>
      simp only [Ψ, Algebra.TensorProduct.includeRight_apply,
        Algebra.TensorProduct.cancelBaseChange_tmul, Algebra.TensorProduct.map_tmul,
        IsScalarTower.toAlgHom_apply, AlgHom.id_apply, Algebra.smul_def, mul_one]
    | add a b ha hb => simp only [map_add, ha, hb]
  have hΨ2 : ∀ c : C₂, Ψ (algebraMap C₂ (TensorProduct C₁ C₂ (TensorProduct C C₁ S)) c) =
      (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ S) c := by
    intro c
    rw [AlgEquiv.commutes, Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.includeLeft_apply, Algebra.algebraMap_self, RingHom.id_apply]

  have hfin' : Module.Finite C₂ (Localization.Away (Ψ e)) :=
    Module.Finite.equiv (IsLocalization.algEquivOfAlgEquiv (Localization.Away e)
      (Localization.Away (Ψ e)) Ψ (Submonoid.map_powers Ψ e)).toLinearEquiv
  refine ⟨C₂, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, P, hP,
    hPP₁, hTR, Ψ e, he.map Ψ, hfin', P'.comap Ψ.symm, inferInstance, ?_, ?_, ?_, ?_⟩
  · ext c
    rw [Ideal.mem_comap, Ideal.mem_comap]
    change Ψ.symm ((Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ S) c) ∈ P'
      ↔ c ∈ P
    rw [← hΨ2, AlgEquiv.symm_apply_apply, Ideal.over_def P' P, Ideal.under_def, Ideal.mem_comap]
  · ext x
    rw [Ideal.mem_comap, Ideal.mem_comap]
    change Ψ.symm (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C S) x)
      ∈ P' ↔ x ∈ R
    rw [← hΨ1, AlgEquiv.symm_apply_apply, ← hP'R, Ideal.mem_comap]
    rfl
  · rw [Ideal.mem_comap, AlgEquiv.symm_apply_apply]
    exact heP'
  · intro R' hR' hR'P hfR'
    have hlo : (R'.comap Ψ).LiesOver P := ⟨by
      ext c
      rw [Ideal.under_def, Ideal.mem_comap, Ideal.mem_comap, hΨ2, ← hR'P, Ideal.mem_comap]
      rfl⟩
    have he' : e ∉ R'.comap Ψ := by
      rw [Ideal.mem_comap]; exact hfR'
    have hEq := huniq (R'.comap Ψ) inferInstance hlo he'
    ext x
    rw [Ideal.mem_comap, ← hEq, Ideal.mem_comap, AlgEquiv.apply_symm_apply]

theorem wc_clopen_unit_nbhd : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Module.Finite C D] (C₂ : Type u) [CommRing C₂] [Algebra C C₂] (P₂ : Ideal C₂) [P₂.IsPrime] (Q₂ : Ideal (TensorProduct C C₂ D)) [Q₂.IsPrime], Q₂.comap (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ D).toRingHom = P₂ → ∀ g : TensorProduct C C₂ D, g ∉ Q₂ → ∃ (C₃ : Type u) (_ : CommRing C₃) (_ : Algebra C₂ C₃) (_ : Algebra C C₃) (_ : IsScalarTower C C₂ C₃) (_ : Algebra.Etale C₂ C₃) (P₃ : Ideal C₃), P₃.IsPrime ∧ P₃.comap (algebraMap C₂ C₃) = P₂ ∧ (∀ y : C₃, ∃ x s : C₂, s ∉ P₂ ∧ algebraMap C₂ C₃ s * y - algebraMap C₂ C₃ x ∈ P₃) ∧ ∃ (e : TensorProduct C C₃ D), IsIdempotentElem e ∧ IsUnit (algebraMap (TensorProduct C C₃ D) (Localization.Away e) (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C₃) (AlgHom.id C D) g)) ∧ ∃ Q₃ : Ideal (TensorProduct C C₃ D), Q₃.IsPrime ∧ Q₃.comap (Algebra.TensorProduct.includeLeft : C₃ →ₐ[C] TensorProduct C C₃ D).toRingHom = P₃ ∧ Q₃.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C₃) (AlgHom.id C D)).toRingHom = Q₂ ∧ e ∉ Q₃ :=
by
  intro C D _ _ _ _ C₂ _ _ P₂ _ Q₂ _ hQ₂ g hg
  classical
  obtain ⟨C', _, _, _, _, _, P', hP', hP'P₂, hTR2', f, hf, hfin, R', hR', hR'P', hR'Q₂, hfR',
    huniq⟩ := wc_etale_nbhd_isolate_tensor C D C₂ P₂ Q₂ hQ₂
  haveI := hP'
  haveI := hR'
  haveI := hfin
  have hε : (Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D).toRingHom =
      algebraMap C' (TensorProduct C C' D) := rfl

  have havoid : ∀ 𝔔 : Ideal (Localization.Away f), 𝔔.IsPrime →
      𝔔.comap (algebraMap C' (Localization.Away f)) = P' →
      algebraMap (TensorProduct C C' D) (Localization.Away f)
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C') (AlgHom.id C D) g) ∉ 𝔔 := by
    intro 𝔔 h𝔔 h𝔔P ha
    haveI := h𝔔
    have hQ'prime : (𝔔.comap (algebraMap (TensorProduct C C' D) (Localization.Away f))).IsPrime :=
      Ideal.comap_isPrime _ _
    have hfQ' : f ∉ 𝔔.comap (algebraMap (TensorProduct C C' D) (Localization.Away f)) := by
      intro hfm
      rw [Ideal.mem_comap] at hfm
      exact h𝔔.ne_top (Ideal.eq_top_of_isUnit_mem _ hfm (IsLocalization.Away.algebraMap_isUnit f))
    have hQ'P : (𝔔.comap (algebraMap (TensorProduct C C' D) (Localization.Away f))).comap
        (Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D).toRingHom = P' := by
      rw [Ideal.comap_comap, hε, ← IsScalarTower.algebraMap_eq]
      exact h𝔔P
    have hQR := huniq _ hQ'prime hQ'P hfQ'
    apply hg
    rw [← hR'Q₂, ← hQR]
    exact ha

  haveI : Algebra.IsIntegral C' (Localization.Away f) := Algebra.IsIntegral.of_finite C' _
  obtain ⟨c, hcP, h, hh⟩ : ∃ c : C', c ∉ P' ∧ ∃ h : Localization.Away f,
      h * algebraMap (TensorProduct C C' D) (Localization.Away f)
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C') (AlgHom.id C D) g) =
      algebraMap C' (Localization.Away f) c := by
    by_contra hcon
    push_neg at hcon
    have hJ : Ideal.under C' (Ideal.span {algebraMap (TensorProduct C C' D) (Localization.Away f)
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C') (AlgHom.id C D) g)}) ≤ P' := by
      intro x hx
      rw [Ideal.under_def, Ideal.mem_comap, Ideal.mem_span_singleton'] at hx
      obtain ⟨y, hy⟩ := hx
      by_contra hxP
      exact hcon x hxP y hy
    obtain ⟨𝔔, h𝔔I, h𝔔, h𝔔P⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P' _ hJ
    exact havoid 𝔔 h𝔔 (by rw [← Ideal.under_def]; exact h𝔔P)
      (h𝔔I (Ideal.mem_span_singleton_self _))

  haveI : Algebra.Etale C₂ (Localization.Away c) := Algebra.Etale.comp C₂ C' (Localization.Away c)
  have hcpow : ∀ n : ℕ, c ^ n ∉ P' := fun n hn => hcP (hP'.mem_of_pow_mem n hn)
  have hdisj : Disjoint (↑(Submonoid.powers c) : Set C') ↑P' := by
    rw [Set.disjoint_left]
    intro x hx hxP
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hx
    exact hcpow n hxP
  have hP₃ : (P'.map (algebraMap C' (Localization.Away c))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers c) _ P' hP' hdisj
  have hP₃P' : (P'.map (algebraMap C' (Localization.Away c))).comap
      (algebraMap C' (Localization.Away c)) = P' := by
    rw [← Ideal.under_def]
    exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers c) _ hP' hdisj
  have hP₃P₂ : (P'.map (algebraMap C' (Localization.Away c))).comap
      (algebraMap C₂ (Localization.Away c)) = P₂ := by
    rw [IsScalarTower.algebraMap_eq C₂ C' (Localization.Away c), ← Ideal.comap_comap, hP₃P',
      hP'P₂]
  have hTR'3 : ∀ y : Localization.Away c, ∃ x s : C', s ∉ P' ∧
      algebraMap C' (Localization.Away c) s * y - algebraMap C' (Localization.Away c) x ∈
        P'.map (algebraMap C' (Localization.Away c)) := by
    intro y
    obtain ⟨n, a₀, hy⟩ := IsLocalization.Away.surj c y
    refine ⟨a₀, c ^ n, hcpow n, ?_⟩
    rw [map_pow, mul_comm, hy, sub_self]
    exact Ideal.zero_mem _
  have hTR23 : ∀ y : Localization.Away c, ∃ x s : C₂, s ∉ P₂ ∧
      algebraMap C₂ (Localization.Away c) s * y - algebraMap C₂ (Localization.Away c) x ∈
        P'.map (algebraMap C' (Localization.Away c)) := by
    intro y
    obtain ⟨b, a, ha, hab⟩ := hTR'3 y
    obtain ⟨x₁, s₁, hs₁, h1⟩ := hTR2' a
    obtain ⟨x₂, s₂, hs₂, h2⟩ := hTR2' b
    have hx₁ : x₁ ∉ P₂ := by
      intro hx
      have hx' : algebraMap C₂ C' x₁ ∈ P' := by
        rw [← hP'P₂] at hx
        exact hx
      have h3 : algebraMap C₂ C' s₁ * a ∈ P' := by
        have h4 := P'.add_mem h1 hx'
        simpa using h4
      rcases hP'.mem_or_mem h3 with h | h
      · exact hs₁ (by rw [← hP'P₂]; exact h)
      · exact ha h
    refine ⟨s₁ * x₂, x₁ * s₂, Ideal.IsPrime.mul_notMem ‹P₂.IsPrime› hx₁ hs₂, ?_⟩
    have hA1 : algebraMap C' (Localization.Away c) (algebraMap C₂ C' s₁ * a - algebraMap C₂ C' x₁)
        ∈ P'.map (algebraMap C' (Localization.Away c)) := Ideal.mem_map_of_mem _ h1
    have hA3 : algebraMap C' (Localization.Away c) (algebraMap C₂ C' s₂ * b - algebraMap C₂ C' x₂)
        ∈ P'.map (algebraMap C' (Localization.Away c)) := Ideal.mem_map_of_mem _ h2
    have e0 : ∀ z : C₂, algebraMap C' (Localization.Away c) (algebraMap C₂ C' z) =
        algebraMap C₂ (Localization.Away c) z :=
      fun z => (IsScalarTower.algebraMap_apply C₂ C' (Localization.Away c) z).symm
    have key : algebraMap C₂ (Localization.Away c) (x₁ * s₂) * y -
          algebraMap C₂ (Localization.Away c) (s₁ * x₂) =
        -(algebraMap C₂ (Localization.Away c) s₂ * y) *
            algebraMap C' (Localization.Away c) (algebraMap C₂ C' s₁ * a - algebraMap C₂ C' x₁)
          + (algebraMap C₂ (Localization.Away c) s₁ * algebraMap C₂ (Localization.Away c) s₂) *
            (algebraMap C' (Localization.Away c) a * y - algebraMap C' (Localization.Away c) b)
          + algebraMap C₂ (Localization.Away c) s₁ *
            algebraMap C' (Localization.Away c) (algebraMap C₂ C' s₂ * b - algebraMap C₂ C' x₂) := by
      simp only [map_sub, map_mul, e0]
      ring
    rw [key]
    exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hA1)
      (Ideal.mul_mem_left _ _ hab)) (Ideal.mul_mem_left _ _ hA3)

  have hκ : Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ (Localization.Away c))
        (AlgHom.id C D) =
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C' (Localization.Away c))
        (AlgHom.id C D)).comp
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C') (AlgHom.id C D)) := by
    apply Algebra.TensorProduct.ext'
    intro x d
    simp only [AlgHom.comp_apply, Algebra.TensorProduct.map_tmul, IsScalarTower.toAlgHom_apply,
      AlgHom.id_apply]
    rw [IsScalarTower.algebraMap_apply C₂ C' (Localization.Away c) x]

  have hunit : IsUnit (algebraMap (TensorProduct C (Localization.Away c) D)
      (Localization.Away (Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom C C' (Localization.Away c)) (AlgHom.id C D) f))
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ (Localization.Away c))
        (AlgHom.id C D) g)) := by
    let μ := Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C' (Localization.Away c))
      (AlgHom.id C D)
    let Λ : Localization.Away f →+* Localization.Away (μ f) :=
      IsLocalization.Away.lift f
        (g := (algebraMap (TensorProduct C (Localization.Away c) D)
          (Localization.Away (μ f))).comp μ.toRingHom)
        (IsLocalization.Away.algebraMap_isUnit (μ f))
    have hΛ : ∀ x, Λ (algebraMap (TensorProduct C C' D) (Localization.Away f) x) =
        algebraMap (TensorProduct C (Localization.Away c) D) (Localization.Away (μ f)) (μ x) :=
      fun x => IsLocalization.Away.lift_eq f _ x
    have hcu : IsUnit (μ (algebraMap C' (TensorProduct C C' D) c)) := by
      have e1 : μ (algebraMap C' (TensorProduct C C' D) c) =
          (Algebra.TensorProduct.includeLeft :
            Localization.Away c →ₐ[C] TensorProduct C (Localization.Away c) D)
            (algebraMap C' (Localization.Away c) c) := by
        simp [μ, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.map_tmul]
      rw [e1]
      exact (IsLocalization.Away.algebraMap_isUnit c).map _
    have e1 := congrArg Λ hh
    rw [map_mul, hΛ, IsScalarTower.algebraMap_apply C' (TensorProduct C C' D)
      (Localization.Away f) c, hΛ] at e1
    have e2 : IsUnit (Λ h * algebraMap (TensorProduct C (Localization.Away c) D)
        (Localization.Away (μ f))
        (μ (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C') (AlgHom.id C D) g))) := by
      rw [e1]
      exact hcu.map _
    rw [hκ]
    exact isUnit_of_mul_isUnit_right e2

  let ρₐ : TensorProduct C C' D →ₐ[C] R'.ResidueField := IsScalarTower.toAlgHom C _ _
  have hρc : IsUnit (ρₐ.comp
      (Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D) c) := by
    apply Ne.isUnit
    intro h0
    have h1 : algebraMap (TensorProduct C C' D) R'.ResidueField
        ((Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D) c) = 0 := h0
    apply hcP
    rw [← hR'P', Ideal.mem_comap]
    exact (Ideal.algebraMap_residueField_eq_zero (I := R')).mp h1
  let lm1 : Localization.Away c →ₐ[C] R'.ResidueField :=
    IsLocalization.liftAlgHom (M := Submonoid.powers c)
      (f := ρₐ.comp (Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D))
      (by
        rintro ⟨y, hy⟩
        obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
        simpa only [map_pow] using hρc.pow n)
  have hlm1 : ∀ x : C', lm1 (algebraMap C' (Localization.Away c) x) =
      ρₐ ((Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D) x) := by
    intro x
    simp only [lm1, IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    rfl
  let lm2 : D →ₐ[C] R'.ResidueField :=
    ρₐ.comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D)
  let lam := Algebra.TensorProduct.productMap lm1 lm2
  have hlamμ : lam.comp (Algebra.TensorProduct.map
      (IsScalarTower.toAlgHom C C' (Localization.Away c)) (AlgHom.id C D)) = ρₐ := by
    apply Algebra.TensorProduct.ext'
    intro x d
    simp only [lam, AlgHom.comp_apply, Algebra.TensorProduct.map_tmul,
      IsScalarTower.toAlgHom_apply, AlgHom.id_apply, Algebra.TensorProduct.productMap_apply_tmul,
      hlm1, lm2]
    rw [← map_mul, Algebra.TensorProduct.includeLeft_apply,
      Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
      mul_one]
  have hQ₃R' : (RingHom.ker lam).comap (Algebra.TensorProduct.map
      (IsScalarTower.toAlgHom C C' (Localization.Away c)) (AlgHom.id C D)).toRingHom = R' := by
    ext x
    rw [Ideal.mem_comap, RingHom.mem_ker]
    change (lam.comp (Algebra.TensorProduct.map
      (IsScalarTower.toAlgHom C C' (Localization.Away c)) (AlgHom.id C D))) x = 0 ↔ x ∈ R'
    rw [hlamμ]
    exact Ideal.algebraMap_residueField_eq_zero
  have hlin : (Algebra.TensorProduct.includeLeft :
        Localization.Away c →ₐ[C] TensorProduct C (Localization.Away c) D).toRingHom.comp
        (algebraMap C' (Localization.Away c)) =
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C' (Localization.Away c))
        (AlgHom.id C D)).toRingHom.comp
        (Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D).toRingHom := by
    apply RingHom.ext
    intro x
    simp [Algebra.TensorProduct.map_tmul]
  have hQ₃P₃ : (RingHom.ker lam).comap (Algebra.TensorProduct.includeLeft :
      Localization.Away c →ₐ[C] TensorProduct C (Localization.Away c) D).toRingHom =
      P'.map (algebraMap C' (Localization.Away c)) := by
    have hK : ((RingHom.ker lam).comap (Algebra.TensorProduct.includeLeft :
        Localization.Away c →ₐ[C] TensorProduct C (Localization.Away c) D).toRingHom).comap
        (algebraMap C' (Localization.Away c)) = P' := by
      rw [Ideal.comap_comap, hlin, ← Ideal.comap_comap, hQ₃R', hR'P']
    have hm := IsLocalization.map_comap (Submonoid.powers c) (Localization.Away c)
      ((RingHom.ker lam).comap (Algebra.TensorProduct.includeLeft :
        Localization.Away c →ₐ[C] TensorProduct C (Localization.Away c) D).toRingHom)
    rw [Ideal.under_def, hK] at hm
    exact hm.symm
  have hQ₃Q₂ : (RingHom.ker lam).comap (Algebra.TensorProduct.map
      (IsScalarTower.toAlgHom C C₂ (Localization.Away c)) (AlgHom.id C D)).toRingHom = Q₂ := by
    have h0 : ((RingHom.ker lam).comap (Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom C C' (Localization.Away c)) (AlgHom.id C D)).toRingHom).comap
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₂ C') (AlgHom.id C D)).toRingHom
        = Q₂ := by
      rw [hQ₃R', hR'Q₂]
    rw [Ideal.comap_comap] at h0
    rw [hκ]
    exact h0
  have heQ₃ : Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C' (Localization.Away c))
      (AlgHom.id C D) f ∉ RingHom.ker lam := by
    intro he
    apply hfR'
    rw [← hQ₃R']
    exact he
  exact ⟨Localization.Away c, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, P'.map (algebraMap C' (Localization.Away c)), hP₃, hP₃P₂, hTR23,
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C' (Localization.Away c))
      (AlgHom.id C D) f, hf.map _, hunit, RingHom.ker lam, RingHom.ker_isPrime lam, hQ₃P₃,
    hQ₃Q₂, heQ₃⟩

theorem wc_point_residue_prime : ∀ (C D E : Type u) [CommRing C] [CommRing D] [CommRing E] [Algebra C D] [Algebra D E] [Algebra C E] [IsScalarTower C D E] (C₁ : Type u) [CommRing C₁] [Algebra C C₁] (Q : Ideal (TensorProduct C C₁ D)) [Q.IsPrime] (r : Ideal E) [r.IsPrime] (σ : r.ResidueField →+* Q.ResidueField), σ.comp ((algebraMap E r.ResidueField).comp (algebraMap D E)) = (algebraMap (TensorProduct C C₁ D) Q.ResidueField).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₁ D).toRingHom → ∃ R : Ideal (TensorProduct C C₁ E), R.IsPrime ∧ R.comap (Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E)).toRingHom = Q ∧ ∀ z : TensorProduct C C₁ E, ∃ x s : TensorProduct C C₁ D, s ∉ Q ∧ Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) s * z - Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) x ∈ R :=
by
  intro C D E _ _ _ _ _ _ _ C₁ _ _ Q _ r _ σ hσ
  classical
  let ρ : TensorProduct C C₁ D →ₐ[C] Q.ResidueField :=
    IsScalarTower.toAlgHom C (TensorProduct C C₁ D) Q.ResidueField
  let τ : E →+* Q.ResidueField := σ.comp (algebraMap E r.ResidueField)
  have hτ : ∀ d : D, τ (algebraMap D E d) =
      algebraMap (TensorProduct C C₁ D) Q.ResidueField ((1 : C₁) ⊗ₜ[C] d) := by
    intro d
    exact RingHom.congr_fun hσ d
  let l₁ : C₁ →ₐ[C] Q.ResidueField := ρ.comp Algebra.TensorProduct.includeLeft
  let l₂ : E →ₐ[C] Q.ResidueField :=
    { τ with
      commutes' := fun k => by
        change τ (algebraMap C E k) = algebraMap C Q.ResidueField k
        rw [IsScalarTower.algebraMap_apply C D E, hτ,
          IsScalarTower.algebraMap_apply C (TensorProduct C C₁ D) Q.ResidueField]
        congr 1
        exact (Algebra.TensorProduct.includeRight (R := C) (A := C₁) (B := D)).commutes k }
  let Λ : TensorProduct C C₁ E →ₐ[C] Q.ResidueField := Algebra.TensorProduct.productMap l₁ l₂
  have hΛ : ∀ x : TensorProduct C C₁ D,
      Λ (Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) x) =
        algebraMap (TensorProduct C C₁ D) Q.ResidueField x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul c d =>
      have e1 : l₁ c = algebraMap (TensorProduct C C₁ D) Q.ResidueField (c ⊗ₜ[C] (1 : D)) := rfl
      have e2 : l₂ (algebraMap D E d) =
          algebraMap (TensorProduct C C₁ D) Q.ResidueField ((1 : C₁) ⊗ₜ[C] d) := hτ d
      rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.productMap_apply_tmul,
        AlgHom.id_apply, IsScalarTower.toAlgHom_apply, e1, e2, ← map_mul,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  refine ⟨RingHom.ker Λ.toRingHom, RingHom.ker_isPrime _, ?_, ?_⟩
  · ext x
    rw [Ideal.mem_comap, RingHom.mem_ker]
    change Λ (Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) x) = 0 ↔ _
    rw [hΛ, Ideal.algebraMap_residueField_eq_zero]
  · intro z
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := TensorProduct C C₁ D ⧸ Q) (Λ z)
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective b
    have hs : s ∉ Q := fun h => nonZeroDivisors.ne_zero hb (Ideal.Quotient.eq_zero_iff_mem.mpr h)
    have compat : ∀ y : TensorProduct C C₁ D,
        algebraMap (TensorProduct C C₁ D ⧸ Q) Q.ResidueField (Ideal.Quotient.mk Q y) =
          algebraMap (TensorProduct C C₁ D) Q.ResidueField y := fun y =>
      (IsScalarTower.algebraMap_apply (TensorProduct C C₁ D) (TensorProduct C C₁ D ⧸ Q)
        Q.ResidueField y).symm
    have hρs : algebraMap (TensorProduct C C₁ D) Q.ResidueField s ≠ 0 := by
      rwa [Ne, Ideal.algebraMap_residueField_eq_zero]
    refine ⟨x, s, hs, ?_⟩
    rw [RingHom.mem_ker]
    change Λ (Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) s * z -
      Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) x) = 0
    rw [map_sub, map_mul, hΛ, hΛ, ← hab, compat, compat, mul_div_cancel₀ _ hρs, sub_self]

theorem wc_etale_tensor_map : ∀ (C D E C₂ : Type u) [CommRing C] [CommRing D] [CommRing E] [CommRing C₂] [Algebra C D] [Algebra D E] [Algebra C E] [IsScalarTower C D E] [Algebra.Etale D E] [Algebra C C₂], RingHom.Etale (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom :=
by
  intro C D E C₂ _ _ _ _ _ _ _ _ _ _
  have h₁ : (algebraMap (TensorProduct C D C₂)
      (TensorProduct D (TensorProduct C D C₂) E)).Etale := by
    haveI : Algebra.Etale (TensorProduct C D C₂) (TensorProduct D (TensorProduct C D C₂) E) :=
      Algebra.Etale.baseChange D E (TensorProduct C D C₂)
    exact RingHom.etale_algebraMap.mpr this
  let σ : TensorProduct C C₂ D ≃+* TensorProduct C D C₂ :=
    (Algebra.TensorProduct.comm C C₂ D).toRingEquiv
  let Ψ : TensorProduct D (TensorProduct C D C₂) E ≃+* TensorProduct C C₂ E :=
    (Algebra.TensorProduct.comm D (TensorProduct C D C₂) E).toRingEquiv.trans
      ((Algebra.TensorProduct.cancelBaseChange C D D E C₂).toRingEquiv.trans
        (Algebra.TensorProduct.comm C E C₂).toRingEquiv)
  have h₃ := RingHom.Etale.respectsIso.2 _ σ
    (RingHom.Etale.respectsIso.1 (algebraMap (TensorProduct C D C₂)
      (TensorProduct D (TensorProduct C D C₂) E)) Ψ h₁)
  have s3 : (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom
      = (Ψ.toRingHom.comp (algebraMap (TensorProduct C D C₂)
          (TensorProduct D (TensorProduct C D C₂) E))).comp σ.toRingHom := by
    apply RingHom.ext
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add y z hy hz => rw [map_add, map_add, hy, hz]
    | tmul c d =>
      simp [σ, Ψ, Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.cancelBaseChange_tmul,
        Algebra.TensorProduct.map_tmul, Algebra.smul_def, Algebra.TensorProduct.algebraMap_apply]
  rw [s3]
  exact h₃

theorem wc_point_piece_package : ∀ (C D E : Type u) [CommRing C] [CommRing D] [CommRing E] [Algebra C D] [Algebra D E] [Algebra C E] [IsScalarTower C D E] (C₁ : Type u) [CommRing C₁] [Algebra C C₁] (Q : Ideal (TensorProduct C C₁ D)) (R : Ideal (TensorProduct C C₁ E)), R.IsPrime → R.comap (Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E)).toRingHom = Q → (∀ z : TensorProduct C C₁ E, ∃ x s : TensorProduct C C₁ D, s ∉ Q ∧ Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) s * z - Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E) x ∈ R) → ∀ (C₂ : Type u) [CommRing C₂] [Algebra C₁ C₂] [Algebra C C₂] [IsScalarTower C C₁ C₂], RingHom.Etale (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom → ∀ (P₂ : Ideal C₂) (f : TensorProduct C C₂ E), IsIdempotentElem f → Module.Finite C₂ (Localization.Away f) → ∀ (R₂ : Ideal (TensorProduct C C₂ E)), R₂.IsPrime → R₂.comap (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ E).toRingHom = P₂ → R₂.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C E)).toRingHom = R → f ∉ R₂ → (∀ R' : Ideal (TensorProduct C C₂ E), R'.IsPrime → R'.comap (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ E).toRingHom = P₂ → f ∉ R' → R' = R₂) → ∃ (Q₂ : Ideal (TensorProduct C C₂ D)), Q₂.IsPrime ∧ Q₂.comap (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ D).toRingHom = P₂ ∧ Q₂.comap (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C D)).toRingHom = Q ∧ ∃ (F : Type u) (_ : CommRing F) (_ : Algebra (TensorProduct C C₂ D) F), Module.Finite (TensorProduct C C₂ D) F ∧ Algebra.Etale (TensorProduct C C₂ D) F ∧ ∃ (Rn : Ideal F), Rn.IsPrime ∧ Rn.comap (algebraMap (TensorProduct C C₂ D) F) = Q₂ ∧ (∀ R' : Ideal F, R'.IsPrime → R'.comap (algebraMap (TensorProduct C C₂ D) F) = Q₂ → R' = Rn) ∧ (∀ y : F, ∃ x s : TensorProduct C C₂ D, s ∉ Q₂ ∧ algebraMap (TensorProduct C C₂ D) F s * y - algebraMap (TensorProduct C C₂ D) F x ∈ Rn) ∧ ∃ χ : E →+* F, χ.comp (algebraMap D E) = (algebraMap (TensorProduct C C₂ D) F).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₂ D).toRingHom :=
by
  intro C D E _ _ _ _ _ _ _ C₁ _ _ Q R _hR hRQ hTR C₂ _ _ _ _ hét P₂ f hf hfin R₂ hR₂ hR₂P₂
    hR₂R hfR₂ huniq
  classical
  haveI := hR₂

  have hL : (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom.comp
      (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ D).toRingHom =
      (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ E).toRingHom := by
    ext c
    simp [Algebra.TensorProduct.map_tmul]
  have hRt : ∀ d : D, (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E))
      ((Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₂ D) d) =
      (Algebra.TensorProduct.includeRight : E →ₐ[C] TensorProduct C C₂ E) (algebraMap D E d) := by
    intro d
    simp [Algebra.TensorProduct.map_tmul]
  have hK : ∀ b : TensorProduct C C₁ D,
      (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E))
        ((Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C D)) b) =
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C E))
        ((Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E)) b) := by
    intro b
    have h : (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).comp
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C D)) =
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C E)).comp
        (Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E)) := by
      apply Algebra.TensorProduct.ext'
      intro a d
      simp [Algebra.TensorProduct.map_tmul]
    exact AlgHom.congr_fun h b
  have hC₂ : ∀ c : C₂, (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E))
      (algebraMap C₂ (TensorProduct C C₂ D) c) = algebraMap C₂ (TensorProduct C C₂ E) c := by
    intro c
    simp [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.map_tmul]
  have hc1 : ∀ c : C₂, (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E))
      (c ⊗ₜ[C] (1 : D)) = c ⊗ₜ[C] (1 : E) := by
    intro c
    simp [Algebra.TensorProduct.map_tmul]

  have hQ₂prime : (R₂.comap (Algebra.TensorProduct.map (AlgHom.id C C₂)
      (IsScalarTower.toAlgHom C D E)).toRingHom).IsPrime := Ideal.comap_isPrime _ _
  have hQ₂P₂ : (R₂.comap (Algebra.TensorProduct.map (AlgHom.id C C₂)
      (IsScalarTower.toAlgHom C D E)).toRingHom).comap
      (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ D).toRingHom = P₂ := by
    rw [Ideal.comap_comap, hL, hR₂P₂]
  have hQ₂Q : (R₂.comap (Algebra.TensorProduct.map (AlgHom.id C C₂)
      (IsScalarTower.toAlgHom C D E)).toRingHom).comap
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C D)).toRingHom = Q := by
    rw [Ideal.comap_comap, ← hRQ, ← hR₂R, Ideal.comap_comap]
    congr 1
    exact RingHom.ext hK

  have hT : ∀ z : TensorProduct C C₂ E, ∃ x s : TensorProduct C C₂ D,
      s ∉ R₂.comap (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom ∧
      (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)) s * z -
        (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)) x ∈ R₂ := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
      refine ⟨0, 1, fun h => hQ₂prime.ne_top ((Ideal.eq_top_iff_one _).mpr h), ?_⟩
      simp
    | tmul c e =>
      obtain ⟨x₀, s₀, hs₀, h₀⟩ := hTR ((1 : C₁) ⊗ₜ[C] e)
      have h₁ : (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C E))
          ((Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E)) s₀ *
            ((1 : C₁) ⊗ₜ[C] e) -
            (Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E)) x₀) ∈ R₂ := by
        rw [← hR₂R] at h₀
        exact h₀
      rw [map_sub, map_mul, ← hK, ← hK, Algebra.TensorProduct.map_tmul, map_one,
        AlgHom.id_apply] at h₁
      have he : (c ⊗ₜ[C] e : TensorProduct C C₂ E) = (c ⊗ₜ[C] (1 : E)) * ((1 : C₂) ⊗ₜ[C] e) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      refine ⟨(c ⊗ₜ[C] (1 : D)) *
          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C D)) x₀,
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C D)) s₀, ?_, ?_⟩
      · intro hs
        apply hs₀
        rw [← hRQ, ← hR₂R]
        change (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₁ C₂) (AlgHom.id C E))
          ((Algebra.TensorProduct.map (AlgHom.id C C₁) (IsScalarTower.toAlgHom C D E)) s₀) ∈ R₂
        rw [← hK]
        exact hs
      · rw [map_mul, hc1, he]
        have key : ∀ a b u v : TensorProduct C C₂ E, a * (u * v) - u * b = u * (a * v - b) := by
          intro a b u v; ring
        rw [key]
        exact R₂.mul_mem_left _ h₁
    | add z z' hz hz' =>
      obtain ⟨x, s, hs, h⟩ := hz
      obtain ⟨x', t, ht, h'⟩ := hz'
      refine ⟨t * x + s * x', s * t, hQ₂prime.mul_notMem hs ht, ?_⟩
      have key : ∀ a b u v w w' : TensorProduct C C₂ E,
          a * b * (u + v) - (b * w + a * w') = b * (a * u - w) + a * (b * v - w') := by
        intro a b u v w w'; ring
      rw [map_mul, map_add, map_mul, map_mul, key]
      exact R₂.add_mem (R₂.mul_mem_left _ h) (R₂.mul_mem_left _ h')

  have hℓf : algebraMap (TensorProduct C C₂ E) (Localization.Away f) f = 1 := by
    have hu : IsUnit (algebraMap (TensorProduct C C₂ E) (Localization.Away f) f) :=
      IsLocalization.Away.algebraMap_isUnit f
    exact (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp (hf.map _)
  have hℓsurj : Function.Surjective (algebraMap (TensorProduct C C₂ E) (Localization.Away f)) := by
    intro y
    obtain ⟨⟨x, m⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers f) y
    obtain ⟨n, hn⟩ := Submonoid.mem_powers_iff _ _ |>.mp m.2
    refine ⟨x, ?_⟩
    have h := IsLocalization.mk'_spec (Localization.Away f) x m
    rw [← hn, map_pow, hℓf, one_pow, mul_one] at h
    exact h.symm
  have hdisj : Disjoint (↑(Submonoid.powers f) : Set (TensorProduct C C₂ E)) ↑R₂ :=
    (Ideal.disjoint_powers_iff_notMem f hR₂.isRadical).mpr hfR₂
  have hRnprime : (R₂.map (algebraMap (TensorProduct C C₂ E) (Localization.Away f))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f) R₂ hR₂ hdisj
  have hRncomap : (R₂.map (algebraMap (TensorProduct C C₂ E) (Localization.Away f))).comap
      (algebraMap (TensorProduct C C₂ E) (Localization.Away f)) = R₂ := by
    have := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) (Localization.Away f)
      hR₂ hdisj
    rwa [Ideal.under_def] at this

  have hét' : RingHom.Etale ((algebraMap (TensorProduct C C₂ E) (Localization.Away f)).comp
      (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom) :=
    RingHom.Etale.stableUnderComposition _ _ hét
      (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway f))
  letI alg : Algebra (TensorProduct C C₂ D) (Localization.Away f) :=
    ((algebraMap (TensorProduct C C₂ E) (Localization.Away f)).comp
      (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom).toAlgebra
  have halg : ∀ a : TensorProduct C C₂ D, algebraMap (TensorProduct C C₂ D) (Localization.Away f) a =
      algebraMap (TensorProduct C C₂ E) (Localization.Away f)
        ((Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)) a) :=
    fun _ => rfl
  haveI : IsScalarTower C₂ (TensorProduct C C₂ D) (Localization.Away f) :=
    IsScalarTower.of_algebraMap_eq (fun c => by
      rw [halg, hC₂, IsScalarTower.algebraMap_apply C₂ (TensorProduct C C₂ E) (Localization.Away f)])
  haveI hFfin : Module.Finite (TensorProduct C C₂ D) (Localization.Away f) :=
    Module.Finite.of_restrictScalars_finite C₂ _ _
  refine ⟨R₂.comap (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom,
    hQ₂prime, hQ₂P₂, hQ₂Q, Localization.Away f, inferInstance, alg, hFfin, hét',
    R₂.map (algebraMap (TensorProduct C C₂ E) (Localization.Away f)), hRnprime, ?_, ?_, ?_, ?_⟩
  ·
    change (R₂.map (algebraMap (TensorProduct C C₂ E) (Localization.Away f))).comap
      ((algebraMap (TensorProduct C C₂ E) (Localization.Away f)).comp
        (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom) = _
    rw [← Ideal.comap_comap, hRncomap]
  ·
    intro R' hR' hR'Q
    change R'.comap ((algebraMap (TensorProduct C C₂ E) (Localization.Away f)).comp
        (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom) =
      R₂.comap (Algebra.TensorProduct.map (AlgHom.id C C₂) (IsScalarTower.toAlgHom C D E)).toRingHom
      at hR'Q
    have h1 : R'.comap (algebraMap (TensorProduct C C₂ E) (Localization.Away f)) = R₂ := by
      apply huniq
      · exact Ideal.comap_isPrime _ _
      · have hh : (R'.comap (algebraMap (TensorProduct C C₂ E) (Localization.Away f))).comap
            (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ E).toRingHom =
            (R'.comap ((algebraMap (TensorProduct C C₂ E) (Localization.Away f)).comp
              (Algebra.TensorProduct.map (AlgHom.id C C₂)
                (IsScalarTower.toAlgHom C D E)).toRingHom)).comap
              (Algebra.TensorProduct.includeLeft : C₂ →ₐ[C] TensorProduct C C₂ D).toRingHom := by
          rw [Ideal.comap_comap, Ideal.comap_comap, ← hL, RingHom.comp_assoc]
        rw [hh, hR'Q, hQ₂P₂]
      · intro h
        rw [Ideal.mem_comap, hℓf] at h
        exact hR'.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    rw [← Ideal.map_comap_of_surjective _ hℓsurj R', h1]
  ·
    intro y
    obtain ⟨z, rfl⟩ := hℓsurj y
    obtain ⟨x, s, hs, hxs⟩ := hT z
    refine ⟨x, s, hs, ?_⟩
    rw [halg, halg, ← map_mul, ← map_sub]
    exact Ideal.mem_map_of_mem _ hxs
  ·
    refine ⟨(algebraMap (TensorProduct C C₂ E) (Localization.Away f)).comp
      (Algebra.TensorProduct.includeRight : E →ₐ[C] TensorProduct C C₂ E).toRingHom, ?_⟩
    ext d
    change algebraMap (TensorProduct C C₂ E) (Localization.Away f)
        ((Algebra.TensorProduct.includeRight : E →ₐ[C] TensorProduct C C₂ E) (algebraMap D E d)) =
      algebraMap (TensorProduct C C₂ D) (Localization.Away f)
        ((Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C₂ D) d)
    rw [halg, hRt]

