            (fun i => s.inl.hom (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X i)))) := by
        rw [Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        apply RingHom.mem_ker.mpr
        have h1 := RingHom.congr_fun hext (g k)
        have hgk : g k ∈ Ideal.span (Set.range g) := Ideal.subset_span ⟨k, rfl⟩
        rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, ← MvPolynomial.coe_eval₂Hom, h1,
          RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hgk, map_zero]
      exact RingHom.mem_ker.mp (hle hx)
    refine ⟨CommRingCat.ofHom (Ideal.quotientMap
      (Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k))) (MvPolynomial.map ψ) hJJ'),
      IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom (Ideal.Quotient.lift
          (Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k)))
          (MvPolynomial.eval₂Hom s.inr.hom
            (fun i => s.inl.hom (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X i))))
          (key s))) ?_ ?_ ?_)⟩
    · intro s
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [Ideal.quotientMap_mk, MvPolynomial.map_C, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_C]
        exact (hc s a).symm
      · intro i
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [Ideal.quotientMap_mk, MvPolynomial.map_X, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X']
    · intro s
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      rw [hB b, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro s μ h1 h2
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro b
        have := congrArg (fun φ => φ.hom b) h2
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at this ⊢
        rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, ← this, hB b]
      · intro i
        have := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (Ideal.span (Set.range g))
          (MvPolynomial.X i))) h1
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at this ⊢
        rw [Ideal.quotientMap_mk, MvPolynomial.map_X] at this
        rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
        exact this

  have s3 : ∀ (X Y : Scheme.{u}) (q : X ⟶ Y), IsAffine X → IsAffine Y →
      ((IsFinite q ↔ q.appTop.hom.Finite) ∧ (Etale q ↔ q.appTop.hom.Etale)) := by
    intro X Y q hX hY
    haveI : HasAffineProperty @IsFinite (affineAnd @RingHom.Finite) :=
      (HasAffineProperty.affineAnd_iff @IsFinite RingHom.finite_respectsIso
        RingHom.finite_localizationPreserves.away RingHom.finite_ofLocalizationSpan).mpr
        (fun f => isFinite_iff f)
    refine ⟨?_, HasRingHomProperty.iff_of_isAffine (P := @Etale)⟩
    rw [HasAffineProperty.iff_of_isAffine (P := @IsFinite) (Q := affineAnd @RingHom.Finite),
      affineAnd_apply]
    exact ⟨fun h => h.2, fun h => ⟨hX, h⟩⟩

  intro S V p hS hp hlfp
  haveI := hS
  haveI := hp
  haveI hV : IsAffine V := isAffine_of_isAffineHom p
  have hfp : p.appTop.hom.FinitePresentation :=
    (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFinitePresentation)).mp hlfp
  obtain ⟨m, r, g, e, he⟩ := s1 _ _ p.appTop.hom hfp
  refine ⟨m, r, g, ?_⟩
  intro S' V' h q j hS' hpb
  haveI := hS'
  haveI hqa : IsAffineHom q := MorphismProperty.of_isPullback (P := @IsAffineHom) hpb hp
  haveI hV' : IsAffine V' := isAffine_of_isAffineHom q
  have P1 := isPushout_appTop_of_isPullback hpb
  have P2 : IsPushout (CommRingCat.ofHom (algebraMap Γ(S, ⊤)
      (MvPolynomial (Fin m) Γ(S, ⊤) ⧸ Ideal.span (Set.range g)))) h.appTop
      (e.toCommRingCatIso.hom ≫ j.appTop) q.appTop := by
    refine IsPushout.of_iso P1 (Iso.refl _) e.toCommRingCatIso.symm (Iso.refl _) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · rw [Iso.refl_hom, Category.id_comp, Iso.symm_hom, Iso.comp_inv_eq]
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact (he a).symm
    · simp
    · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, Iso.inv_hom_id_assoc]
    · simp
  obtain ⟨inl, P3⟩ := s2 _ _ h.appTop.hom m r g
  have E2 := IsPushout.inr_isoIsPushout_hom _ _ P2 P3
  have hcomp : ((IsPushout.isoIsPushout _ _ P2 P3).hom.hom).comp q.appTop.hom =
      algebraMap Γ(S', ⊤) (MvPolynomial (Fin m) Γ(S', ⊤) ⧸
        Ideal.span (Set.range fun k => MvPolynomial.map h.appTop.hom (g k))) := by
    rw [← CommRingCat.hom_comp, E2, CommRingCat.hom_ofHom]
  obtain ⟨hF, hE⟩ := s3 V' S' q hV' hS'
  constructor
  · rw [hF]
    refine (RingHom.finite_respectsIso.cancel_right_isIso q.appTop
      (IsPushout.isoIsPushout _ _ P2 P3).hom).symm.trans ?_
    rw [hcomp]
    exact RingHom.finite_algebraMap
  · rw [hE]
    refine (RingHom.Etale.respectsIso.cancel_right_isIso q.appTop
      (IsPushout.isoIsPushout _ _ P2 P3).hom).symm.trans ?_
    rw [hcomp]
    exact RingHom.etale_algebraMap

theorem wc_lfes_colim_finite_descend : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (B : I → Type u) [∀ i, CommRing (B i)] (R : Type u) [CommRing R] (φ : ∀ i, B i →+* R) (β : ∀ {i j : I}, (j ⟶ i) → (B i →+* B j)), (∀ {i j k : I} (f : k ⟶ j) (g : j ⟶ i) (b : B i), β (f ≫ g) b = β f (β g b)) → (∀ {i j : I} (f : j ⟶ i) (b : B i), φ j (β f b) = φ i b) → (∀ r : R, ∃ (i : I) (b : B i), φ i b = r) → (∀ (i : I) (b : B i), φ i b = 0 → ∃ (j : I) (f : j ⟶ i), β f b = 0) → ∀ (i : I) (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) (B i)), Module.Finite R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (φ i) (g k))) → ∃ (j : I) (f : j ⟶ i), Module.Finite (B j) (MvPolynomial (Fin m) (B j) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (β f) (g k))) :=
by
  intro I _ _ B _ R _ φ β hF hC hS hK i m r g hfin
  classical

  have crit : ∀ (A : Type u) [CommRing A] (g : Fin r → MvPolynomial (Fin m) A),
      Module.Finite A (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)) ↔
      ∀ a : Fin m, ∃ P : Polynomial A, P.Monic ∧
        Polynomial.aeval (MvPolynomial.X a : MvPolynomial (Fin m) A) P ∈ Ideal.span (Set.range g) := by
    intro A _ g
    set J := Ideal.span (Set.range g) with hJ
    have key : ∀ (a : Fin m) (P : Polynomial A),
        Polynomial.aeval (Ideal.Quotient.mk J (MvPolynomial.X a)) P =
          Ideal.Quotient.mk J (Polynomial.aeval (MvPolynomial.X a) P) := by
      intro a P
      rw [← Ideal.Quotient.mkₐ_eq_mk A J, Polynomial.aeval_algHom_apply]
    constructor
    · intro hfin a
      have hint : IsIntegral A (Ideal.Quotient.mk J (MvPolynomial.X a)) :=
        Algebra.IsIntegral.isIntegral _
      obtain ⟨P, hPm, hP⟩ := hint
      refine ⟨P, hPm, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← key, Polynomial.aeval_def]
      exact hP
    · intro h
      have hX : ∀ a, IsIntegral A (Ideal.Quotient.mk J (MvPolynomial.X a)) := by
        intro a
        obtain ⟨P, hPm, hP⟩ := h a
        refine ⟨P, hPm, ?_⟩
        rw [← Polynomial.aeval_def, key, Ideal.Quotient.eq_zero_iff_mem]
        exact hP
      have hall : ∀ p : MvPolynomial (Fin m) A, IsIntegral A (Ideal.Quotient.mk J p) := by
        intro p
        induction p using MvPolynomial.induction_on with
        | C c => exact isIntegral_algebraMap (R := A) (x := c)
        | add p q hp hq => rw [map_add]; exact hp.add hq
        | mul_X p a hp => rw [map_mul]; exact hp.mul (hX a)
      haveI : Algebra.IsIntegral A (MvPolynomial (Fin m) A ⧸ J) := ⟨fun x => by
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact hall p⟩
      haveI : Algebra.FiniteType A (MvPolynomial (Fin m) A ⧸ J) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ A J)
          (Ideal.Quotient.mkₐ_surjective A J)
      exact Algebra.IsIntegral.finite

  have hev : ∀ (A A' : Type u) [CommRing A] [CommRing A'] (ψ : A →+* A') (a : Fin m)
      (P : Polynomial A), MvPolynomial.map ψ (Polynomial.aeval (MvPolynomial.X a) P) =
        Polynomial.aeval (MvPolynomial.X a) (P.map ψ) := by
    intro A A' _ _ ψ a P
    induction P using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add, map_add, hp, hq, Polynomial.map_add, map_add]
    | monomial n c =>
      simp [Polynomial.aeval_monomial, MvPolynomial.algebraMap_eq]

  have merge : ∀ (ι : Type) (i₀ : I) (P : ι → ∀ j : I, (j ⟶ i₀) → Prop),
      (∀ a j k (f : j ⟶ i₀) (g : k ⟶ j), P a j f → P a k (g ≫ f)) →
      ∀ s : Finset ι, (∀ a ∈ s, ∃ j f, P a j f) → ∃ j f, ∀ a ∈ s, P a j f := by
    intro ι i₀ P hP s
    induction s using Finset.induction_on with
    | empty => intro _; exact ⟨i₀, 𝟙 i₀, fun a ha => absurd ha (Finset.notMem_empty a)⟩
    | insert b s hb ih =>
      intro h
      obtain ⟨j, f, hj⟩ := ih (fun a ha => h a (Finset.mem_insert_of_mem ha))
      obtain ⟨j', f', hj'⟩ := h b (Finset.mem_insert_self b s)
      obtain ⟨k, g₁, g₂, hw⟩ := IsCofiltered.cospan f f'
      refine ⟨k, g₁ ≫ f, fun a ha => ?_⟩
      rcases Finset.mem_insert.mp ha with rfl | ha
      · rw [hw]; exact hP _ _ _ _ _ hj'
      · exact hP _ _ _ _ _ (hj a ha)

  have liftE : ∀ (ι : Type) [Fintype ι] (i₀ : I) (x : ι → R),
      ∃ (j : I) (_ : j ⟶ i₀) (y : ι → B j), ∀ t, φ j (y t) = x t := by
    intro ι _ i₀ x
    obtain ⟨j, f, hj⟩ := merge ι i₀ (fun t j _ => ∃ y : B j, φ j y = x t)
      (fun t j k f g h => by
        obtain ⟨y, hy⟩ := h
        exact ⟨β g y, by rw [hC, hy]⟩)
      Finset.univ (fun t _ => by
        obtain ⟨i1, b1, hb1⟩ := hS (x t)
        exact ⟨IsCofiltered.min i₀ i1, IsCofiltered.minToLeft i₀ i1,
          β (IsCofiltered.minToRight i₀ i1) b1, by rw [hC, hb1]⟩)
    choose y hy using fun t => hj t (Finset.mem_univ t)
    exact ⟨j, f, y, hy⟩

  have vanish : ∀ (ι : Type) [Fintype ι] (j₀ : I) (Q : ι → MvPolynomial (Fin m) (B j₀)),
      (∀ t, MvPolynomial.map (φ j₀) (Q t) = 0) →
      ∃ (j : I) (f : j ⟶ j₀), ∀ t, MvPolynomial.map (β f) (Q t) = 0 := by
    intro ι _ j₀ Q hQ
    obtain ⟨j, f, hj⟩ := merge (Σ t, {μ // μ ∈ (Q t).support}) j₀
      (fun s j f => β f ((Q s.1).coeff s.2.1) = 0)
      (fun s j k f g h => by
        rw [hF, h, map_zero])
      Finset.univ (fun s _ => by
        refine hK _ _ ?_
        rw [← MvPolynomial.coeff_map, hQ]
        simp)
    refine ⟨j, f, fun t => ?_⟩
    ext μ
    rw [MvPolynomial.coeff_map]
    by_cases hμ : μ ∈ (Q t).support
    · simpa using hj ⟨t, ⟨μ, hμ⟩⟩ (Finset.mem_univ _)
    · simp [MvPolynomial.notMem_support_iff.mp hμ]

  obtain hmon := (crit R (fun k => MvPolynomial.map (φ i) (g k))).mp hfin
  choose P hPm hPJ using hmon
  have hc0 : ∀ a, ∃ c : Fin r → MvPolynomial (Fin m) R,
      ∑ k, c k * MvPolynomial.map (φ i) (g k) = Polynomial.aeval (MvPolynomial.X a) (P a) :=
    fun a => Ideal.mem_span_range_iff_exists_fun.mp (hPJ a)
  choose c hc using hc0

  obtain ⟨j1, f1, y, hy⟩ := liftE
    ((Σ a : Fin m, Fin (P a).natDegree) ⊕
      (Σ ak : Fin m × Fin r, {μ // μ ∈ (c ak.1 ak.2).support})) i
    (Sum.elim (fun t => (P t.1).coeff t.2) (fun t => (c t.1.1 t.1.2).coeff t.2.1))
  set P' : Fin m → Polynomial (B j1) := fun a => Polynomial.X ^ (P a).natDegree +
    ∑ e : Fin (P a).natDegree, Polynomial.C (y (Sum.inl ⟨a, e⟩)) * Polynomial.X ^ (e : ℕ)
    with hP'
  set q : Fin m → Fin r → MvPolynomial (Fin m) (B j1) := fun a k =>
    ∑ μ ∈ (c a k).support.attach, MvPolynomial.monomial μ.1 (y (Sum.inr ⟨(a, k), μ⟩)) with hq
  have hP'm : ∀ a, (P' a).Monic := fun a =>
    Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
  have hP'map : ∀ a, Polynomial.map (φ j1) (P' a) = P a := by
    intro a
    simp only [hP', Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
      Polynomial.map_mul, Polynomial.map_C, hy, Sum.elim_inl]
    rw [Fin.sum_univ_eq_sum_range (fun e => Polynomial.C ((P a).coeff e) * Polynomial.X ^ e)]
    exact (hPm a).as_sum.symm
  have hqmap : ∀ a k, MvPolynomial.map (φ j1) (q a k) = c a k := by
    intro a k
    simp only [hq, map_sum, MvPolynomial.map_monomial, hy, Sum.elim_inr]
    rw [Finset.sum_attach (c a k).support
      (fun μ => MvPolynomial.monomial μ ((c a k).coeff μ))]
    exact MvPolynomial.support_sum_monomial_coeff _
  have hcomp : ∀ p : MvPolynomial (Fin m) (B i),
      MvPolynomial.map (φ j1) (MvPolynomial.map (β f1) p) = MvPolynomial.map (φ i) p := by
    intro p
    have e : (φ j1).comp (β f1) = φ i := RingHom.ext fun b => hC f1 b
    rw [MvPolynomial.map_map, e]

  set Δ : Fin m → MvPolynomial (Fin m) (B j1) := fun a =>
    Polynomial.aeval (MvPolynomial.X a) (P' a) -
      ∑ k, q a k * MvPolynomial.map (β f1) (g k) with hΔ
  have hΔ0 : ∀ a, MvPolynomial.map (φ j1) (Δ a) = 0 := by
    intro a
    simp only [hΔ, map_sub, map_sum, map_mul]
    rw [hev, hP'map]
    simp only [hqmap, hcomp]
    rw [hc a, sub_self]

  obtain ⟨j2, f2, hv⟩ := vanish (Fin m) j1 Δ hΔ0
  have hcomp2 : ∀ p : MvPolynomial (Fin m) (B i),
      MvPolynomial.map (β f2) (MvPolynomial.map (β f1) p) = MvPolynomial.map (β (f2 ≫ f1)) p := by
    intro p
    have e : (β f2).comp (β f1) = β (f2 ≫ f1) := RingHom.ext fun b => (hF f2 f1 b).symm
    rw [MvPolynomial.map_map, e]

  refine ⟨j2, f2 ≫ f1, (crit (B j2) _).mpr fun a =>
    ⟨(P' a).map (β f2), (hP'm a).map _, ?_⟩⟩
  have e : Polynomial.aeval (MvPolynomial.X a) ((P' a).map (β f2)) =
      ∑ k, MvPolynomial.map (β f2) (q a k) * MvPolynomial.map (β (f2 ≫ f1)) (g k) := by
    rw [← hev]
    have h := hv a
    simp only [hΔ, map_sub, map_sum, map_mul, hcomp2] at h
    exact sub_eq_zero.mp h
  rw [e]
  exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)

theorem wc_lfes_colim_etale_descend : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (B : I → Type u) [∀ i, CommRing (B i)] (R : Type u) [CommRing R] (φ : ∀ i, B i →+* R) (β : ∀ {i j : I}, (j ⟶ i) → (B i →+* B j)), (∀ {i j k : I} (f : k ⟶ j) (g : j ⟶ i) (b : B i), β (f ≫ g) b = β f (β g b)) → (∀ {i j : I} (f : j ⟶ i) (b : B i), φ j (β f b) = φ i b) → (∀ r : R, ∃ (i : I) (b : B i), φ i b = r) → (∀ (i : I) (b : B i), φ i b = 0 → ∃ (j : I) (f : j ⟶ i), β f b = 0) → ∀ (i : I) (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) (B i)), Algebra.Etale R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (φ i) (g k))) → ∃ (j : I) (f : j ⟶ i), Algebra.Etale (B j) (MvPolynomial (Fin m) (B j) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (β f) (g k))) :=
by
  intro I _ _ B _ R _ φ β hF hC hS hK i m r g hEt
  classical

  have hcompφ : ∀ (τ : Type) {a b : I} (e : a ⟶ b) (p : MvPolynomial τ (B b)),
      MvPolynomial.map (φ a) (MvPolynomial.map (β e) p) = MvPolynomial.map (φ b) p := by
    intro τ a b e p
    have h : (φ a).comp (β e) = φ b := RingHom.ext fun x => hC e x
    rw [MvPolynomial.map_map, h]
  have hcompβ : ∀ (τ : Type) {a b c : I} (d : a ⟶ b) (e : b ⟶ c) (p : MvPolynomial τ (B c)),
      MvPolynomial.map (β d) (MvPolynomial.map (β e) p) = MvPolynomial.map (β (d ≫ e)) p := by
    intro τ a b c d e p
    have h : (β d).comp (β e) = β (d ≫ e) := RingHom.ext fun x => (hF d e x).symm
    rw [MvPolynomial.map_map, h]

  have merge : ∀ (ι : Type) (i₀ : I) (P : ι → ∀ j : I, (j ⟶ i₀) → Prop),
      (∀ a j k (f : j ⟶ i₀) (g : k ⟶ j), P a j f → P a k (g ≫ f)) →
      ∀ s : Finset ι, (∀ a ∈ s, ∃ j f, P a j f) → ∃ j f, ∀ a ∈ s, P a j f := by
    intro ι i₀ P hP s
    induction s using Finset.induction_on with
    | empty => intro _; exact ⟨i₀, 𝟙 i₀, fun a ha => absurd ha (Finset.notMem_empty a)⟩
    | insert b s hb ih =>
      intro h
      obtain ⟨j, f, hj⟩ := ih (fun a ha => h a (Finset.mem_insert_of_mem ha))
      obtain ⟨j', f', hj'⟩ := h b (Finset.mem_insert_self b s)
      obtain ⟨k, g₁, g₂, hw⟩ := IsCofiltered.cospan f f'
      refine ⟨k, g₁ ≫ f, fun a ha => ?_⟩
      rcases Finset.mem_insert.mp ha with rfl | ha
      · rw [hw]; exact hP _ _ _ _ _ hj'
      · exact hP _ _ _ _ _ (hj a ha)

  have liftE : ∀ (ι : Type) [Fintype ι] (i₀ : I) (x : ι → R),
      ∃ (j : I) (_ : j ⟶ i₀) (y : ι → B j), ∀ t, φ j (y t) = x t := by
    intro ι _ i₀ x
    obtain ⟨j, f, hj⟩ := merge ι i₀ (fun t j _ => ∃ y : B j, φ j y = x t)
      (fun t j k f g h => by
        obtain ⟨y, hy⟩ := h
        exact ⟨β g y, by rw [hC, hy]⟩)
      Finset.univ (fun t _ => by
        obtain ⟨i1, b1, hb1⟩ := hS (x t)
        exact ⟨IsCofiltered.min i₀ i1, IsCofiltered.minToLeft i₀ i1,
          β (IsCofiltered.minToRight i₀ i1) b1, by rw [hC, hb1]⟩)
    choose y hy using fun t => hj t (Finset.mem_univ t)
    exact ⟨j, f, y, hy⟩

  have liftP : ∀ (τ ι : Type) [Fintype ι] (i₀ : I) (P : ι → MvPolynomial τ R),
      ∃ (j : I) (_ : j ⟶ i₀) (Q : ι → MvPolynomial τ (B j)),
        ∀ t, MvPolynomial.map (φ j) (Q t) = P t := by
    intro τ ι _ i₀ P
    obtain ⟨j, f, y, hy⟩ := liftE (Σ t : ι, {μ // μ ∈ (P t).support}) i₀
      (fun s => (P s.1).coeff s.2.1)
    refine ⟨j, f, fun t => ∑ μ ∈ (P t).support.attach, MvPolynomial.monomial μ.1 (y ⟨t, μ⟩),
      fun t => ?_⟩
    simp only [map_sum, MvPolynomial.map_monomial, hy]
    rw [Finset.sum_attach (P t).support (fun μ => MvPolynomial.monomial μ ((P t).coeff μ))]
    exact MvPolynomial.support_sum_monomial_coeff _

  have vanish : ∀ (τ ι : Type) [Fintype ι] (j₀ : I) (Q : ι → MvPolynomial τ (B j₀)),
      (∀ t, MvPolynomial.map (φ j₀) (Q t) = 0) →
      ∃ (j : I) (f : j ⟶ j₀), ∀ t, MvPolynomial.map (β f) (Q t) = 0 := by
    intro τ ι _ j₀ Q hQ
    obtain ⟨j, f, hj⟩ := merge (Σ t, {μ // μ ∈ (Q t).support}) j₀
      (fun s j f => β f ((Q s.1).coeff s.2.1) = 0)
      (fun s j k f g h => by
        rw [hF, h, map_zero])
      Finset.univ (fun s _ => by
        refine hK _ _ ?_
        rw [← MvPolynomial.coeff_map, hQ]
        simp)
    refine ⟨j, f, fun t => ?_⟩
    ext μ
    rw [MvPolynomial.coeff_map]
    by_cases hμ : μ ∈ (Q t).support
    · simpa using hj ⟨t, ⟨μ, hμ⟩⟩ (Finset.mem_univ _)
    · simp [MvPolynomial.notMem_support_iff.mp hμ]

  have descM : ∀ (τ κ α : Type) [Fintype κ] [Fintype α] (k₀ : I)
      (Gn : κ → MvPolynomial τ (B k₀)) (P : α → MvPolynomial τ (B k₀)),
      (∀ a, MvPolynomial.map (φ k₀) (P a) ∈
        Ideal.span (Set.range fun t => MvPolynomial.map (φ k₀) (Gn t))) →
      ∃ (j : I) (e : j ⟶ k₀), ∀ a, MvPolynomial.map (β e) (P a) ∈
        Ideal.span (Set.range fun t => MvPolynomial.map (β e) (Gn t)) := by
    intro τ κ α _ _ k₀ Gn P hP
    have hc : ∀ a, ∃ c : κ → MvPolynomial τ R,
        ∑ t, c t * MvPolynomial.map (φ k₀) (Gn t) = MvPolynomial.map (φ k₀) (P a) :=
      fun a => Ideal.mem_span_range_iff_exists_fun.mp (hP a)
    choose c hc using hc
    obtain ⟨j1, f1, c', hc'⟩ := liftP τ (α × κ) k₀ (fun p => c p.1 p.2)
    obtain ⟨j2, f2, hv⟩ := vanish τ α j1 (fun a => MvPolynomial.map (β f1) (P a) -
        ∑ t, c' (a, t) * MvPolynomial.map (β f1) (Gn t)) (by
      intro a
      simp only [map_sub, map_sum, map_mul, hc', hcompφ]
      rw [hc a, sub_self])
    refine ⟨j2, f2 ≫ f1, fun a => ?_⟩
    have h := hv a
    simp only [map_sub, map_sum, map_mul, hcompβ] at h
    rw [sub_eq_zero.mp h]
    exact Ideal.sum_mem _ fun t _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨t, rfl⟩)

  have stab : ∀ (τ κ : Type) [Fintype κ] (k₀ j j' : I) (e : j ⟶ k₀) (d : j' ⟶ j)
      (Gn : κ → MvPolynomial τ (B k₀)) (Q : MvPolynomial τ (B k₀)),
      MvPolynomial.map (β e) Q ∈ Ideal.span (Set.range fun t => MvPolynomial.map (β e) (Gn t)) →
      MvPolynomial.map (β (d ≫ e)) Q ∈
        Ideal.span (Set.range fun t => MvPolynomial.map (β (d ≫ e)) (Gn t)) := by
    intro τ κ _ k₀ j j' e d Gn Q h
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h
    refine Ideal.mem_span_range_iff_exists_fun.mpr ⟨fun t => MvPolynomial.map (β d) (c t), ?_⟩
    rw [← hcompβ, ← hc, map_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [map_mul, hcompβ]

  have iso : ∀ (A : Type u) [CommRing A] (τ₁ τ₂ κ₁ κ₂ : Type) (g₁ : κ₁ → MvPolynomial τ₁ A)
      (g₂ : κ₂ → MvPolynomial τ₂ A) (X₂ : τ₁ → MvPolynomial τ₂ A) (X₁ : τ₂ → MvPolynomial τ₁ A),
      (∀ c, MvPolynomial.bind₁ X₁ (g₂ c) ∈ Ideal.span (Set.range g₁)) →
      (∀ l, MvPolynomial.bind₁ X₂ (g₁ l) ∈ Ideal.span (Set.range g₂)) →
      (∀ b, MvPolynomial.bind₁ X₁ (X₂ b) - MvPolynomial.X b ∈ Ideal.span (Set.range g₁)) →
      (∀ a, MvPolynomial.bind₁ X₂ (X₁ a) - MvPolynomial.X a ∈ Ideal.span (Set.range g₂)) →
      Nonempty ((MvPolynomial τ₁ A ⧸ Ideal.span (Set.range g₁)) ≃ₐ[A]
        (MvPolynomial τ₂ A ⧸ Ideal.span (Set.range g₂))) := by
    intro A _ τ₁ τ₂ κ₁ κ₂ g₁ g₂ X₂ X₁ h1 h2 h3 h4
    have hα : ∀ x ∈ Ideal.span (Set.range g₁),
        ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₂))).comp (MvPolynomial.bind₁ X₂)) x = 0 := by
      intro x hx
      have hle : Ideal.span (Set.range g₁) ≤
          (Ideal.span (Set.range g₂)).comap (MvPolynomial.bind₁ X₂) := by
        rw [Ideal.span_le]
        rintro _ ⟨l, rfl⟩
        exact h2 l
      rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact hle hx
    have hγ : ∀ x ∈ Ideal.span (Set.range g₂),
        ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₁))).comp (MvPolynomial.bind₁ X₁)) x = 0 := by
      intro x hx
      have hle : Ideal.span (Set.range g₂) ≤
          (Ideal.span (Set.range g₁)).comap (MvPolynomial.bind₁ X₁) := by
        rw [Ideal.span_le]
        rintro _ ⟨c, rfl⟩
        exact h1 c
      rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact hle hx
    let α := Ideal.Quotient.liftₐ (Ideal.span (Set.range g₁))
      ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₂))).comp (MvPolynomial.bind₁ X₂)) hα
    let γ := Ideal.Quotient.liftₐ (Ideal.span (Set.range g₂))
      ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range g₁))).comp (MvPolynomial.bind₁ X₁)) hγ
    have hαmk : ∀ x, α (Ideal.Quotient.mk _ x) =
        Ideal.Quotient.mk (Ideal.span (Set.range g₂)) (MvPolynomial.bind₁ X₂ x) := fun x => rfl
    have hγmk : ∀ x, γ (Ideal.Quotient.mk _ x) =
        Ideal.Quotient.mk (Ideal.span (Set.range g₁)) (MvPolynomial.bind₁ X₁ x) := fun x => rfl
    have e₁ : γ.comp α = AlgHom.id A _ := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro b
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
      rw [hαmk, MvPolynomial.bind₁_X_right, hγmk, Ideal.Quotient.eq]
      exact h3 b
    have e₂ : α.comp γ = AlgHom.id A _ := by
      apply Ideal.Quotient.algHom_ext
      apply MvPolynomial.algHom_ext
      intro a
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
      rw [hγmk, MvPolynomial.bind₁_X_right, hαmk, Ideal.Quotient.eq]
      exact h4 a
    exact ⟨AlgEquiv.ofAlgHom α γ e₂ e₁⟩
  set J := Ideal.span (Set.range fun k => MvPolynomial.map (φ i) (g k)) with hJ

  obtain ⟨ι, σ, _, _, mp, F, val, hbij, hsurj, hker, G, hcert⟩ :
      ∃ (ι σ : Type) (_ : Fintype ι) (_ : Fintype σ) (mp : σ → ι) (F : σ → MvPolynomial ι R)
        (val : ι → MvPolynomial (Fin m) R ⧸ J), Function.Bijective mp ∧
        Function.Surjective (MvPolynomial.aeval (R := R) val) ∧
        RingHom.ker (MvPolynomial.aeval (R := R) val) = Ideal.span (Set.range F) ∧
        ∃ G : MvPolynomial ι R,
          G * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (F b)).det - 1 ∈
            Ideal.span (Set.range F) := by
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 R (MvPolynomial (Fin m) R ⧸ J) :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt
    obtain ⟨ι, σ, hσ, hι, P, hdim⟩ :=
      Algebra.IsStandardSmoothOfRelativeDimension.out (n := 0) (R := R)
        (S := MvPolynomial (Fin m) R ⧸ J)
    have hdim' : Nat.card ι - Nat.card σ = 0 := hdim
    have hle : Nat.card ι ≤ Nat.card σ := Nat.sub_eq_zero_iff_le.mp hdim'
    letI : Fintype ι := Fintype.ofFinite ι
    letI : Fintype σ := Fintype.ofFinite σ
    have hker : RingHom.ker (MvPolynomial.aeval (R := R) P.val) =
        Ideal.span (Set.range P.relation) :=
      (P.span_range_relation_eq_ker.trans P.ker_eq_ker_aeval_val).symm
    refine ⟨ι, σ, inferInstance, inferInstance, P.map, P.relation, P.val,
      P.map_inj.bijective_of_nat_card_le hle, fun s => ⟨P.σ' s, P.aeval_val_σ' s⟩, hker, ?_⟩
    have hM : (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)) =
        P.jacobiMatrix := by
      ext i j
      rw [Matrix.of_apply, P.jacobiMatrix_apply]
    have hJac : P.jacobian = MvPolynomial.aeval P.val
        (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)).det := by
      rw [P.jacobian_eq_jacobiMatrix_det, hM, Algebra.Generators.algebraMap_apply]
    have hu : IsUnit P.jacobian := P.jacobian_isUnit
    rw [hJac] at hu
    obtain ⟨y, hy⟩ := hu.exists_left_inv
    refine ⟨P.σ' y, ?_⟩
    rw [← hker, RingHom.mem_ker, map_sub, map_mul, map_one, P.aeval_val_σ', hy, sub_self]

  have s3 : ∀ (A : Type u) [CommRing A] (f : σ → MvPolynomial ι A) (g : MvPolynomial ι A),
      g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈
        Ideal.span (Set.range f) →
      Algebra.Etale A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) := by
    intro A _ f g hg
    let P : Algebra.PreSubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
      { Algebra.Presentation.naive (v := f) with map := mp, map_inj := hbij.1 }
    have hJ : P.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j) := by
      ext i j
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      rfl
    have halg : ∀ x : MvPolynomial ι A,
        algebraMap P.Ring (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) x =
          Ideal.Quotient.mk (Ideal.span (Set.range f)) x := fun x => rfl
    have hunit : IsUnit P.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hJ, halg]
      have h1 : Ideal.Quotient.mk (Ideal.span (Set.range f))
          (g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det) = 1 := by
        rw [← map_one (Ideal.Quotient.mk (Ideal.span (Set.range f))), Ideal.Quotient.eq]
        exact hg
      rw [map_mul, mul_comm] at h1
      exact IsUnit.of_mul_eq_one _ h1
    let Q : Algebra.SubmersivePresentation A (MvPolynomial ι A ⧸ Ideal.span (Set.range f)) ι σ :=
      { P with jacobian_isUnit := hunit }
    have hdim : Q.dimension = 0 := by
      show Nat.card ι - Nat.card σ = 0
      rw [Nat.card_eq_of_bijective mp hbij, Nat.sub_self]
    haveI := Q.isStandardSmoothOfRelativeDimension hdim
    infer_instance

  have hdet : ∀ (A A' : Type u) [CommRing A] [CommRing A'] (ψ : A →+* A')
      (Fx : σ → MvPolynomial ι A),
      MvPolynomial.map ψ (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (Fx b)).det =
        (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (MvPolynomial.map ψ (Fx b))).det := by
    intro A A' _ _ ψ Fx
    rw [RingHom.map_det]
    congr 1
    ext a b
    simp [RingHom.mapMatrix_apply, MvPolynomial.pderiv_map]

  have hYs : ∀ a, ∃ y : MvPolynomial (Fin m) R, Ideal.Quotient.mk J y = val a :=
    fun a => Ideal.Quotient.mk_surjective (val a)
  choose Ys hYs using hYs
  have hXs : ∀ b, ∃ x : MvPolynomial ι R,
      MvPolynomial.aeval (R := R) val x = Ideal.Quotient.mk J (MvPolynomial.X b) :=
    fun b => hsurj _
  choose Xs hXs using hXs
  have K1 : ∀ p : MvPolynomial ι R,
      Ideal.Quotient.mk J (MvPolynomial.bind₁ Ys p) = MvPolynomial.aeval (R := R) val p := by
    intro p
    have h : (Ideal.Quotient.mkₐ R J).comp (MvPolynomial.bind₁ Ys) =
        MvPolynomial.aeval (R := R) val := by
      apply MvPolynomial.algHom_ext
      intro a
      rw [AlgHom.comp_apply, MvPolynomial.bind₁_X_right, MvPolynomial.aeval_X,
        Ideal.Quotient.mkₐ_eq_mk, hYs]
    rw [← h, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
  have K2 : ∀ p : MvPolynomial (Fin m) R,
      MvPolynomial.aeval (R := R) val (MvPolynomial.bind₁ Xs p) = Ideal.Quotient.mk J p := by
    intro p
    have h : (MvPolynomial.aeval (R := R) val).comp (MvPolynomial.bind₁ Xs) =
        Ideal.Quotient.mkₐ R J := by
      apply MvPolynomial.algHom_ext
      intro b
      rw [AlgHom.comp_apply, MvPolynomial.bind₁_X_right, hXs, Ideal.Quotient.mkₐ_eq_mk]
    rw [← Ideal.Quotient.mkₐ_eq_mk R J, ← h, AlgHom.comp_apply]
  have R1 : ∀ c, MvPolynomial.bind₁ Ys (F c) ∈ J := by
    intro c
    rw [← Ideal.Quotient.eq_zero_iff_mem, K1, ← RingHom.mem_ker, hker]
    exact Ideal.subset_span ⟨c, rfl⟩
  have R2 : ∀ l, MvPolynomial.bind₁ Xs (MvPolynomial.map (φ i) (g l)) ∈
      Ideal.span (Set.range F) := by
    intro l
    rw [← hker, RingHom.mem_ker, K2, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span ⟨l, rfl⟩
  have R3 : ∀ b, MvPolynomial.bind₁ Ys (Xs b) - MvPolynomial.X b ∈ J := by
    intro b
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, K1, hXs, sub_self]
  have R4 : ∀ a, MvPolynomial.bind₁ Xs (Ys a) - MvPolynomial.X a ∈ Ideal.span (Set.range F) := by
    intro a
    rw [← hker, RingHom.mem_ker, map_sub, K2, hYs, MvPolynomial.aeval_X, sub_self]

  obtain ⟨j1, f1, Q1, hQ1⟩ := liftP ι (σ ⊕ (Unit ⊕ Fin m)) i
    (Sum.elim F (Sum.elim (fun _ => G) Xs))
  obtain ⟨k, f2, Ys', hYs'⟩ := liftP (Fin m) ι j1 Ys
  obtain ⟨F', hF'⟩ : ∃ F' : σ → MvPolynomial ι (B k),
      ∀ c, MvPolynomial.map (φ k) (F' c) = F c :=
    ⟨fun c => MvPolynomial.map (β f2) (Q1 (Sum.inl c)),
      fun c => (hcompφ _ f2 _).trans (hQ1 (Sum.inl c))⟩
  obtain ⟨G', hG'⟩ : ∃ G' : MvPolynomial ι (B k), MvPolynomial.map (φ k) G' = G :=
    ⟨MvPolynomial.map (β f2) (Q1 (Sum.inr (Sum.inl ()))),
      (hcompφ _ f2 _).trans (hQ1 (Sum.inr (Sum.inl ())))⟩
  obtain ⟨Xs', hXs'⟩ : ∃ Xs' : Fin m → MvPolynomial ι (B k),
      ∀ b, MvPolynomial.map (φ k) (Xs' b) = Xs b :=
    ⟨fun b => MvPolynomial.map (β f2) (Q1 (Sum.inr (Sum.inr b))),
      fun b => (hcompφ _ f2 _).trans (hQ1 (Sum.inr (Sum.inr b)))⟩
  obtain ⟨gk, hgkφ, hgkβ⟩ : ∃ gk : Fin r → MvPolynomial (Fin m) (B k),
      (∀ l, MvPolynomial.map (φ k) (gk l) = MvPolynomial.map (φ i) (g l)) ∧
      ∀ (j : I) (e : j ⟶ k) l,
        MvPolynomial.map (β e) (gk l) = MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l) :=
    ⟨fun l => MvPolynomial.map (β (f2 ≫ f1)) (g l), fun l => hcompφ _ _ _,
      fun j e l => hcompβ _ _ _ _⟩

  obtain ⟨PA, hPA1, hPA3⟩ : ∃ PA : σ ⊕ Fin m → MvPolynomial (Fin m) (B k),
      (∀ c, PA (Sum.inl c) = MvPolynomial.bind₁ Ys' (F' c)) ∧
      (∀ b, PA (Sum.inr b) = MvPolynomial.bind₁ Ys' (Xs' b) - MvPolynomial.X b) :=
    ⟨Sum.elim (fun c => MvPolynomial.bind₁ Ys' (F' c))
      (fun b => MvPolynomial.bind₁ Ys' (Xs' b) - MvPolynomial.X b), fun _ => rfl, fun _ => rfl⟩
  obtain ⟨PB, hPB2, hPB4, hPB5⟩ : ∃ PB : (Fin r ⊕ ι) ⊕ Unit → MvPolynomial ι (B k),
      (∀ l, PB (Sum.inl (Sum.inl l)) = MvPolynomial.bind₁ Xs' (gk l)) ∧
      (∀ a, PB (Sum.inl (Sum.inr a)) = MvPolynomial.bind₁ Xs' (Ys' a) - MvPolynomial.X a) ∧
      PB (Sum.inr ()) =
        G' * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (F' b)).det - 1 :=
    ⟨Sum.elim (Sum.elim (fun l => MvPolynomial.bind₁ Xs' (gk l))
        (fun a => MvPolynomial.bind₁ Xs' (Ys' a) - MvPolynomial.X a))
      (fun _ => G' * (Matrix.of fun a b => MvPolynomial.pderiv (mp a) (F' b)).det - 1),
      fun _ => rfl, fun _ => rfl, rfl⟩

  obtain ⟨j₁, e₁, H1⟩ := descM (Fin m) (Fin r) (σ ⊕ Fin m) k gk PA (by
    rintro (c | b)
    · rw [hPA1, MvPolynomial.map_bind₁]
      simp only [hYs', hF', hgkφ]
      exact R1 c
    · rw [hPA3, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X]
      simp only [hYs', hXs', hgkφ]
      exact R3 b)
  obtain ⟨j₂, e₂, H2⟩ := descM ι σ ((Fin r ⊕ ι) ⊕ Unit) k F' PB (by
    rintro ((l | a) | u)
    · rw [hPB2, MvPolynomial.map_bind₁]
      simp only [hXs', hgkφ, hF']
      exact R2 l
    · rw [hPB4, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X]
      simp only [hXs', hYs', hF']
      exact R4 a
    · rw [hPB5, map_sub, map_mul, map_one, hdet, hG']
      simp only [hF']
      exact hcert)
  obtain ⟨j, e, H1', H2'⟩ : ∃ (j : I) (e : j ⟶ k),
      (∀ s, MvPolynomial.map (β e) (PA s) ∈
        Ideal.span (Set.range fun t => MvPolynomial.map (β e) (gk t))) ∧
      (∀ s, MvPolynomial.map (β e) (PB s) ∈
        Ideal.span (Set.range fun t => MvPolynomial.map (β e) (F' t))) := by
    obtain ⟨j, d₁, d₂, hw⟩ := IsCofiltered.cospan e₁ e₂
    refine ⟨j, d₁ ≫ e₁, fun s => stab _ _ _ _ _ e₁ d₁ _ _ (H1 s), fun s => ?_⟩
    rw [hw]
    exact stab _ _ _ _ _ e₂ d₂ _ _ (H2 s)

  have hgj := hgkβ j e
  have T1 : ∀ c, MvPolynomial.bind₁ (fun a => MvPolynomial.map (β e) (Ys' a))
      (MvPolynomial.map (β e) (F' c)) ∈
        Ideal.span (Set.range fun l => MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) := by
    intro c
    have h := H1' (Sum.inl c)
    rw [hPA1, MvPolynomial.map_bind₁] at h
    simpa only [hgj] using h
  have T2 : ∀ l, MvPolynomial.bind₁ (fun b => MvPolynomial.map (β e) (Xs' b))
      (MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) ∈
        Ideal.span (Set.range fun c => MvPolynomial.map (β e) (F' c)) := by
    intro l
    have h := H2' (Sum.inl (Sum.inl l))
    rw [hPB2, MvPolynomial.map_bind₁] at h
    simpa only [hgj] using h
  have T3 : ∀ b, MvPolynomial.bind₁ (fun a => MvPolynomial.map (β e) (Ys' a))
      (MvPolynomial.map (β e) (Xs' b)) - MvPolynomial.X b ∈
        Ideal.span (Set.range fun l => MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) := by
    intro b
    have h := H1' (Sum.inr b)
    rw [hPA3, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X] at h
    simpa only [hgj] using h
  have T4 : ∀ a, MvPolynomial.bind₁ (fun b => MvPolynomial.map (β e) (Xs' b))
      (MvPolynomial.map (β e) (Ys' a)) - MvPolynomial.X a ∈
        Ideal.span (Set.range fun c => MvPolynomial.map (β e) (F' c)) := by
    intro a
    have h := H2' (Sum.inl (Sum.inr a))
    rw [hPB4, map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X] at h
    exact h
  have T5 : MvPolynomial.map (β e) G' * (Matrix.of fun a b => MvPolynomial.pderiv (mp a)
      (MvPolynomial.map (β e) (F' b))).det - 1 ∈
        Ideal.span (Set.range fun c => MvPolynomial.map (β e) (F' c)) := by
    have h := H2' (Sum.inr ())
    rw [hPB5, map_sub, map_mul, map_one, hdet (B k) (B j) (β e) F'] at h
    exact h
  obtain ⟨eqv⟩ := iso (B j) (Fin m) ι (Fin r) σ
    (fun l => MvPolynomial.map (β (e ≫ f2 ≫ f1)) (g l)) (fun c => MvPolynomial.map (β e) (F' c))
    (fun b => MvPolynomial.map (β e) (Xs' b)) (fun a => MvPolynomial.map (β e) (Ys' a))
    T1 T2 T3 T4
  haveI := s3 (B j) (fun c => MvPolynomial.map (β e) (F' c)) (MvPolynomial.map (β e) G') T5
  exact ⟨j, e ≫ f2 ≫ f1, Algebra.Etale.of_equiv eqv.symm⟩

theorem wc_lfes_affine_case_of_ring : (∀ (S V : Scheme.{u}) (p : V ⟶ S), IsAffine S → IsAffineHom p → LocallyOfFinitePresentation p → ∃ (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) Γ(S, ⊤)), ∀ (S' V' : Scheme.{u}) (h : S' ⟶ S) (q : V' ⟶ S') (j : V' ⟶ V), IsAffine S' → IsPullback j q p h → ((IsFinite q ↔ Module.Finite Γ(S', ⊤) (MvPolynomial (Fin m) Γ(S', ⊤) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map h.appTop.hom (g k)))) ∧ (Etale q ↔ Algebra.Etale Γ(S', ⊤) (MvPolynomial (Fin m) Γ(S', ⊤) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map h.appTop.hom (g k)))))) → (∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (B : I → Type u) [∀ i, CommRing (B i)] (R : Type u) [CommRing R] (φ : ∀ i, B i →+* R) (β : ∀ {i j : I}, (j ⟶ i) → (B i →+* B j)), (∀ {i j k : I} (f : k ⟶ j) (g : j ⟶ i) (b : B i), β (f ≫ g) b = β f (β g b)) → (∀ {i j : I} (f : j ⟶ i) (b : B i), φ j (β f b) = φ i b) → (∀ r : R, ∃ (i : I) (b : B i), φ i b = r) → (∀ (i : I) (b : B i), φ i b = 0 → ∃ (j : I) (f : j ⟶ i), β f b = 0) → ∀ (i : I) (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) (B i)), Module.Finite R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (φ i) (g k))) → ∃ (j : I) (f : j ⟶ i), Module.Finite (B j) (MvPolynomial (Fin m) (B j) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (β f) (g k)))) → (∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (B : I → Type u) [∀ i, CommRing (B i)] (R : Type u) [CommRing R] (φ : ∀ i, B i →+* R) (β : ∀ {i j : I}, (j ⟶ i) → (B i →+* B j)), (∀ {i j k : I} (f : k ⟶ j) (g : j ⟶ i) (b : B i), β (f ≫ g) b = β f (β g b)) → (∀ {i j : I} (f : j ⟶ i) (b : B i), φ j (β f b) = φ i b) → (∀ r : R, ∃ (i : I) (b : B i), φ i b = r) → (∀ (i : I) (b : B i), φ i b = 0 → ∃ (j : I) (f : j ⟶ i), β f b = 0) → ∀ (i : I) (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) (B i)), Algebra.Etale R (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (φ i) (g k))) → ∃ (j : I) (f : j ⟶ i), Algebra.Etale (B j) (MvPolynomial (Fin m) (B j) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map (β f) (g k)))) → ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, IsAffine (D.obj i)) → ∀ (i : I) (V : Scheme.{u}) (p : V ⟶ D.obj i) (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ c.pt) (j : V₀ ⟶ V), IsAffineHom p → LocallyOfFinitePresentation p → IsPullback j p₀ p (c.π.app i) → IsFinite p₀ → Etale p₀ → ∃ (i' : I) (f : i' ⟶ i), IsFinite (Limits.pullback.snd p (D.map f)) ∧ Etale (Limits.pullback.snd p (D.map f)) :=
by
  intro H8 H9 H13 I _ _ D c hc hTrans hAff i V p V₀ p₀ j hpa hpl hpb hf he
  haveI : ∀ {a b : I} (f : a ⟶ b), IsAffineHom (D.map f) := hTrans
  haveI : ∀ k, IsAffine (D.obj k) := hAff
  haveI : ∀ k, CompactSpace (D.obj k) := fun k => inferInstance
  haveI : ∀ k, QuasiSeparatedSpace (D.obj k) := fun k => inferInstance
  haveI : IsAffineHom (c.π.app i) := isAffineHom_π_app D c hc i
  haveI hcpt : IsAffine c.pt := isAffine_of_isAffineHom (c.π.app i)
  obtain ⟨m, r, g, hg⟩ := H8 (D.obj i) V p (hAff i) hpa hpl
  obtain ⟨hF0, hE0⟩ := hg c.pt V₀ (c.π.app i) p₀ j hcpt hpb
  have hfunct : ∀ {a b k : I} (f : k ⟶ b) (g : b ⟶ a) (x : Γ(D.obj a, ⊤)),
      (D.map (f ≫ g)).appTop.hom x = (D.map f).appTop.hom ((D.map g).appTop.hom x) := by
    intro a b k f g x
    rw [Functor.map_comp, Scheme.Hom.comp_appTop]
    rfl
  have hcompat : ∀ {a b : I} (f : b ⟶ a) (x : Γ(D.obj a, ⊤)),
      (c.π.app b).appTop.hom ((D.map f).appTop.hom x) = (c.π.app a).appTop.hom x := by
    intro a b f x
    rw [← c.w f, Scheme.Hom.comp_appTop]
    rfl
  have hsurj : ∀ x : Γ(c.pt, ⊤), ∃ (k : I) (b : Γ(D.obj k, ⊤)), (c.π.app k).appTop.hom b = x := by
    intro x
    obtain ⟨k, t, ht⟩ := exists_appTop_π_eq_of_isLimit D c hc x
    exact ⟨k, t, ht.symm⟩
  have hker : ∀ (k : I) (b : Γ(D.obj k, ⊤)), (c.π.app k).appTop.hom b = 0 →
      ∃ (j : I) (f : j ⟶ k), (D.map f).appTop.hom b = 0 := by
    intro k b hb
    exact exists_appTop_map_eq_zero_of_isLimit D c hc b hb
  obtain ⟨j₁, f₁, hfin⟩ := H9 I (fun k => (Γ(D.obj k, ⊤) : Type u)) Γ(c.pt, ⊤)
    (fun k => (c.π.app k).appTop.hom) (fun f => (D.map f).appTop.hom)
    hfunct hcompat hsurj hker i m r g (hF0.mp hf)
  obtain ⟨j₂, f₂, het⟩ := H13 I (fun k => (Γ(D.obj k, ⊤) : Type u)) Γ(c.pt, ⊤)
    (fun k => (c.π.app k).appTop.hom) (fun f => (D.map f).appTop.hom)
    hfunct hcompat hsurj hker i m r g (hE0.mp he)
  have hP1 : IsFinite (Limits.pullback.snd p (D.map f₁)) :=
    (hg (D.obj j₁) _ (D.map f₁) (Limits.pullback.snd p (D.map f₁))
      (Limits.pullback.fst p (D.map f₁)) (hAff j₁) (IsPullback.of_hasPullback p (D.map f₁))).1.mpr hfin
  have hP2 : Etale (Limits.pullback.snd p (D.map f₂)) :=
    (hg (D.obj j₂) _ (D.map f₂) (Limits.pullback.snd p (D.map f₂))
      (Limits.pullback.fst p (D.map f₂)) (hAff j₂) (IsPullback.of_hasPullback p (D.map f₂))).2.mpr het
  have hbc : ∀ {V S T T' : Scheme.{u}} (p : V ⟶ S) (a : T ⟶ S) (b : T' ⟶ T) (c : T' ⟶ S),
      b ≫ a = c → ∃ ik : Limits.pullback p c ⟶ Limits.pullback p a,
        IsPullback ik (Limits.pullback.snd p c) (Limits.pullback.snd p a) b := by
    intro V S T T' p a b c hc
    subst hc
    refine ⟨Limits.pullback.lift (Limits.pullback.fst p (b ≫ a)) (Limits.pullback.snd p (b ≫ a) ≫ b)
      (by rw [Category.assoc]; exact Limits.pullback.condition), ?_⟩
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback p a)
    rw [Limits.pullback.lift_fst]
    exact IsPullback.of_hasPullback p (b ≫ a)
  let l := IsCofiltered.minToLeft j₁ j₂
  let r' := IsCofiltered.minToRight j₁ j₂
  let e := IsCofiltered.eqHom (l ≫ f₁) (r' ≫ f₂)
  have heq : e ≫ l ≫ f₁ = e ≫ r' ≫ f₂ := IsCofiltered.eq_condition _ _
  refine ⟨_, e ≫ l ≫ f₁, ?_, ?_⟩
  · obtain ⟨ik, hik⟩ := hbc p (D.map f₁) (D.map (e ≫ l)) (D.map (e ≫ l ≫ f₁))
      (by rw [← Functor.map_comp, Category.assoc])
    exact MorphismProperty.of_isPullback hik hP1
  · obtain ⟨ik, hik⟩ := hbc p (D.map f₂) (D.map (e ≫ r')) (D.map (e ≫ l ≫ f₁))
      (by rw [← Functor.map_comp, Category.assoc, heq])
    exact MorphismProperty.of_isPullback hik hP2

theorem wc_lfes_open_case_of_affine_case : (∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, IsAffine (D.obj i)) → ∀ (i : I) (V : Scheme.{u}) (p : V ⟶ D.obj i) (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ c.pt) (j : V₀ ⟶ V), IsAffineHom p → LocallyOfFinitePresentation p → IsPullback j p₀ p (c.π.app i) → IsFinite p₀ → Etale p₀ → ∃ (i' : I) (f : i' ⟶ i), IsFinite (Limits.pullback.snd p (D.map f)) ∧ Etale (Limits.pullback.snd p (D.map f))) → ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → ∀ (i : I) (U : (D.obj i).Opens), IsAffineOpen U → ∀ (V : Scheme.{u}) (p : V ⟶ D.obj i) (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ c.pt) (j : V₀ ⟶ V), IsAffineHom p → LocallyOfFinitePresentation p → IsPullback j p₀ p (c.π.app i) → IsFinite p₀ → Etale p₀ → ∃ (i₁ : I) (f₁ : i₁ ⟶ i), IsFinite (Limits.pullback.snd p ((D.map f₁ ⁻¹ᵁ U).ι ≫ D.map f₁)) ∧ Etale (Limits.pullback.snd p ((D.map f₁ ⁻¹ᵁ U).ι ≫ D.map f₁)) :=
by
  intro AC I _ _ D c hc haff i U hU V p V₀ p₀ j hpa hpl hpb hf he

  have s1 : ∀ {V S T T' P : Scheme.{u}} (p : V ⟶ S) (a : T ⟶ S) (q : P ⟶ T) (jj : P ⟶ V)
      (b : T' ⟶ T) (c : T' ⟶ S), b ≫ a = c → IsPullback jj q p a →
      ∃ k : Limits.pullback p c ⟶ P, IsPullback k (Limits.pullback.snd p c) q b := by
    intro V S T T' P p a q jj b c hc hpb
    subst hc
    refine ⟨hpb.lift (Limits.pullback.fst p (b ≫ a)) (Limits.pullback.snd p (b ≫ a) ≫ b)
      (by rw [Category.assoc]; exact Limits.pullback.condition), ?_⟩
    refine IsPullback.of_right ?_ (hpb.lift_snd _ _ _) hpb
    rw [hpb.lift_fst]
    exact IsPullback.of_hasPullback p (b ≫ a)

  have s2 : ∀ {P P' X Y Z : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
      {fst' : P' ⟶ X} {snd' : P' ⟶ Y}, IsPullback fst snd f g → IsPullback fst' snd' f g →
      IsFinite snd' → Etale snd' → IsFinite snd ∧ Etale snd := by
    intro P P' X Y Z fst snd f g fst' snd' h h' hf' he'
    have e1 : (IsPullback.isoIsPullback X Y h h').hom ≫ snd' = snd :=
      IsPullback.isoIsPullback_hom_snd _ _ _ _
    have sq : IsPullback (IsPullback.isoIsPullback X Y h h').hom snd snd' (𝟙 Y) :=
      IsPullback.of_horiz_isIso ⟨by rw [e1, Category.comp_id]⟩
    exact ⟨MorphismProperty.of_isPullback sq hf', MorphismProperty.of_isPullback sq he'⟩

  have hobj : ∀ n : Over i, IsAffine ((opensDiagram D i U).obj n) := by
    intro n
    haveI := haff n.hom
    exact hU.preimage (D.map n.hom)
  have hmap : ∀ {n m : Over i} (t : n ⟶ m), IsAffineHom ((opensDiagram D i U).map t) := by
    intro n m t
    haveI := hobj n
    haveI := hobj m
    exact isAffineHom_of_isAffine _

  have ha : ∀ n : Over i, (opensCone D c i U).π.app n ≫ (D.map n.hom ⁻¹ᵁ U).ι ≫ D.map n.hom =
      (c.π.app i ⁻¹ᵁ U).ι ≫ c.π.app i := by
    intro n
    first
      | (refine (Scheme.Hom.resLE_comp_ι_assoc (c.π.app n.left) _ _ _ (D.map n.hom)).trans ?_
         rw [Limits.Cone.w c n.hom])
      | (rw [opensCone_π_app]; erw [Scheme.Hom.resLE_comp_ι_assoc]; rw [Limits.Cone.w c n.hom])
  have hb : ∀ {n m : Over i} (t : n ⟶ m), (opensDiagram D i U).map t ≫
      (D.map m.hom ⁻¹ᵁ U).ι ≫ D.map m.hom = (D.map n.hom ⁻¹ᵁ U).ι ≫ D.map n.hom := by
    intro n m t
    first
      | (refine (Scheme.Hom.resLE_comp_ι_assoc (D.map t.left) _ _ _ (D.map m.hom)).trans ?_
         rw [← Functor.map_comp, Over.w t])
      | (rw [opensDiagram_map]; erw [Scheme.Hom.resLE_comp_ι_assoc]
         rw [← Functor.map_comp, Over.w t])

  let n₀ : Over i := Over.mk (𝟙 i)
  let e₀ : (opensDiagram D i U).obj n₀ ⟶ D.obj i := (D.map n₀.hom ⁻¹ᵁ U).ι ≫ D.map n₀.hom
  let ℓ : (opensCone D c i U).pt ⟶ D.obj i := (c.π.app i ⁻¹ᵁ U).ι ≫ c.π.app i
  have hpa' : IsAffineHom (Limits.pullback.snd p e₀) :=
    MorphismProperty.of_isPullback (IsPullback.of_hasPullback p e₀) hpa
  have hpl' : LocallyOfFinitePresentation (Limits.pullback.snd p e₀) :=
    MorphismProperty.of_isPullback (IsPullback.of_hasPullback p e₀) hpl
  obtain ⟨k, hsq⟩ := s1 p e₀ (Limits.pullback.snd p e₀) (Limits.pullback.fst p e₀)
    ((opensCone D c i U).π.app n₀) ℓ (ha n₀) (IsPullback.of_hasPullback p e₀)
  obtain ⟨k', hk'⟩ := s1 p (c.π.app i) p₀ j (c.π.app i ⁻¹ᵁ U).ι ℓ rfl hpb
  have hf' : IsFinite (Limits.pullback.snd p ℓ) := MorphismProperty.of_isPullback hk' hf
  have he' : Etale (Limits.pullback.snd p ℓ) := MorphismProperty.of_isPullback hk' he
  obtain ⟨n, t, hQ⟩ := AC (Over i) (opensDiagram D i U) (opensCone D c i U)
    (isLimitOpensCone D c hc i U) hmap hobj n₀ _ (Limits.pullback.snd p e₀) _
    (Limits.pullback.snd p ℓ) k hpa' hpl' hsq hf' he'
  obtain ⟨k'', hk''⟩ := s1 p e₀ (Limits.pullback.snd p e₀) (Limits.pullback.fst p e₀)
    ((opensDiagram D i U).map t) ((D.map n.hom ⁻¹ᵁ U).ι ≫ D.map n.hom) (hb t)
    (IsPullback.of_hasPullback p e₀)
  exact ⟨n.left, n.hom, s2 hk'' (IsPullback.of_hasPullback _ _) hQ.1 hQ.2⟩

theorem wc_limit_finite_etale_spread : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) → (∀ i, QuasiSeparatedSpace (D.obj i)) → ∀ (i : I) (V : Scheme.{u}) (p : V ⟶ D.obj i) (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ c.pt) (j : V₀ ⟶ V), IsAffineHom p → LocallyOfFinitePresentation p → IsPullback j p₀ p (c.π.app i) → IsFinite p₀ → Etale p₀ → ∃ (i' : I) (f : i' ⟶ i), IsFinite (Limits.pullback.snd p (D.map f)) ∧ Etale (Limits.pullback.snd p (D.map f)) :=
by
  classical

  have hbc : ∀ {V S T T' : Scheme.{u}} (p : V ⟶ S) (a : T ⟶ S) (b : T' ⟶ T) (c : T' ⟶ S),
      b ≫ a = c → ∃ ik : Limits.pullback p c ⟶ Limits.pullback p a,
        IsPullback ik (Limits.pullback.snd p c) (Limits.pullback.snd p a) b := by
    intro V S T T' p a b c hc
    subst hc
    refine ⟨Limits.pullback.lift (Limits.pullback.fst p (b ≫ a)) (Limits.pullback.snd p (b ≫ a) ≫ b)
      (by rw [Category.assoc]; exact Limits.pullback.condition), ?_⟩
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback p a)
    rw [Limits.pullback.lift_fst]
    exact IsPullback.of_hasPullback p (b ≫ a)

  have hcover : ∀ (X : Scheme.{u}), CompactSpace X →
      ∃ (n : ℕ) (U : Fin n → X.Opens), (∀ k, IsAffineOpen (U k)) ∧ iSup U = ⊤ := by
    intro X hX
    have hc : IsCompact ((⊤ : X.Opens) : Set X) := by simpa using isCompact_univ
    obtain ⟨s, hs, hsU⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hc
    refine ⟨hs.toFinset.card, fun k => ((hs.toFinset.equivFin.symm k).1 : X.Opens),
      fun k => (hs.toFinset.equivFin.symm k).1.2, ?_⟩
    rw [hsU]
    apply le_antisymm
    · apply iSup_le
      intro k
      exact le_iSup₂_of_le (hs.toFinset.equivFin.symm k).1
        (hs.mem_toFinset.mp (hs.toFinset.equivFin.symm k).2) le_rfl
    · apply iSup₂_le
      intro t ht
      exact le_iSup_of_le (hs.toFinset.equivFin ⟨t, hs.mem_toFinset.mpr ht⟩) (by simp)

  have hloc : ∀ {W Y : Scheme.{u}} (g : W ⟶ Y) (n : ℕ) (U : Fin n → Y.Opens), iSup U = ⊤ →
      (∀ k, ∃ (Wk : Scheme.{u}) (gk : Wk ⟶ (U k : Scheme.{u})) (ik : Wk ⟶ W),
        IsPullback ik gk g (U k).ι ∧ IsFinite gk ∧ Etale gk) → IsFinite g ∧ Etale g := by
    intro W Y g n U hU H
    have hres : ∀ k, IsFinite (g ∣_ U k) ∧ Etale (g ∣_ U k) := by
      intro k
      obtain ⟨Wk, gk, ik, hpb, hf, he⟩ := H k
      have h1 : (IsPullback.isoIsPullback _ _ (isPullback_morphismRestrict g (U k)).flip hpb).hom ≫ gk
          = g ∣_ U k := IsPullback.isoIsPullback_hom_snd _ _ _ _
      rw [← h1]
      exact ⟨inferInstance, inferInstance⟩
    haveI : HasAffineProperty @IsFinite (affineAnd @RingHom.Finite) :=
      (HasAffineProperty.affineAnd_iff @IsFinite RingHom.finite_respectsIso
        RingHom.finite_localizationPreserves.away RingHom.finite_ofLocalizationSpan).mpr
        (fun f => isFinite_iff f)
    haveI : IsZariskiLocalAtTarget @IsFinite :=
      HasAffineProperty.instIsZariskiLocalAtTarget (Q := affineAnd @RingHom.Finite)
    haveI : IsZariskiLocalAtTarget @Etale := HasRingHomProperty.instIsZariskiLocalAtTarget @Etale
    exact ⟨IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsFinite) U hU (fun k => (hres k).1),
      IsZariskiLocalAtTarget.of_iSup_eq_top (P := @Etale) U hU (fun k => (hres k).2)⟩

  have hcone : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (n : ℕ) (i : I) (i' : Fin n → I)
      (f : ∀ k, i' k ⟶ i), ∃ (i₀ : I) (f₀ : i₀ ⟶ i) (g : ∀ k, i₀ ⟶ i' k), ∀ k, g k ≫ f k = f₀ := by
    intro I _ _ n i
    induction n with
    | zero => intro i' f; exact ⟨i, 𝟙 i, fun k => k.elim0, fun k => k.elim0⟩
    | succ n ih =>
      intro i' f
      obtain ⟨a, fa, ga, hga⟩ := ih (fun k => i' k.succ) (fun k => f k.succ)
      let e := IsCofiltered.eqHom (IsCofiltered.minToLeft a (i' 0) ≫ fa)
        (IsCofiltered.minToRight a (i' 0) ≫ f 0)
      have he : e ≫ IsCofiltered.minToLeft a (i' 0) ≫ fa = e ≫ IsCofiltered.minToRight a (i' 0) ≫ f 0 :=
        IsCofiltered.eq_condition _ _
      refine ⟨_, e ≫ IsCofiltered.minToLeft a (i' 0) ≫ fa,
        fun k => Fin.cases (motive := fun k => _ ⟶ i' k) (e ≫ IsCofiltered.minToRight a (i' 0))
          (fun k => e ≫ IsCofiltered.minToLeft a (i' 0) ≫ ga k) k, ?_⟩
      intro k
      refine Fin.cases ?_ (fun k => ?_) k
      · simp only [Fin.cases_zero, Category.assoc]
        exact he.symm
      · simp only [Fin.cases_succ, Category.assoc, hga]

  intro I _ _ D c hc haff hcpt hqs i V p V₀ p₀ j hpa hpl hpb hf he
  obtain ⟨n, U, hUa, hU⟩ := hcover (D.obj i) (hcpt i)
  have RC := wc_lfes_open_case_of_affine_case
    (wc_lfes_affine_case_of_ring wc_lfes_affine_fp_presentation_transfer
      wc_lfes_colim_finite_descend wc_lfes_colim_etale_descend)
  have hk : ∀ k, ∃ (i₁ : I) (f₁ : i₁ ⟶ i),
      IsFinite (Limits.pullback.snd p ((D.map f₁ ⁻¹ᵁ U k).ι ≫ D.map f₁)) ∧
        Etale (Limits.pullback.snd p ((D.map f₁ ⁻¹ᵁ U k).ι ≫ D.map f₁)) :=
    fun k => RC I D c hc haff i (U k) (hUa k) V p V₀ p₀ j hpa hpl hpb hf he
  choose i₁ f₁ hQ using hk
  obtain ⟨i₀, f₀, g, hg⟩ := hcone I n i i₁ f₁
  refine ⟨i₀, f₀, ?_⟩
  refine hloc (Limits.pullback.snd p (D.map f₀)) n (fun k => D.map f₀ ⁻¹ᵁ U k) ?_ ?_
  · rw [← Scheme.Hom.preimage_iSup, hU, Scheme.Hom.preimage_top]
  · intro k
    have hle : D.map f₀ ⁻¹ᵁ U k ≤ D.map (g k) ⁻¹ᵁ (D.map (f₁ k) ⁻¹ᵁ U k) :=
      le_of_eq (by rw [← Scheme.Hom.comp_preimage, ← Functor.map_comp, hg k])
    have hb : (D.map (g k)).resLE (D.map (f₁ k) ⁻¹ᵁ U k) (D.map f₀ ⁻¹ᵁ U k) hle ≫
        ((D.map (f₁ k) ⁻¹ᵁ U k).ι ≫ D.map (f₁ k)) = (D.map f₀ ⁻¹ᵁ U k).ι ≫ D.map f₀ := by
      rw [← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, ← Functor.map_comp, hg k]
    obtain ⟨ik1, hik1⟩ := hbc p _ _ _ hb
    obtain ⟨ik2, hik2⟩ := hbc p (D.map f₀) (D.map f₀ ⁻¹ᵁ U k).ι _ rfl
    exact ⟨_, _, ik2, hik2, MorphismProperty.of_isPullback hik1 (hQ k).1,
      MorphismProperty.of_isPullback hik1 (hQ k).2⟩

theorem wc_fet_descend_cofiltered_limit : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (X : Scheme.{u})
    (ρ : (Functor.const I).obj X ⟶ D), Nonempty (Limits.IsLimit (Limits.Cone.mk X ρ)) →
    (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) →
    (∀ i, QuasiSeparatedSpace (D.obj i)) →
    ∀ (W : Scheme.{u}) (q : W ⟶ X), IsFinite q → Etale q →
    ∃ (i : I) (Wi : Scheme.{u}) (qi : Wi ⟶ D.obj i) (w : W ⟶ Wi),
      IsFinite qi ∧ Etale qi ∧ IsPullback w q qi (ρ.app i) :=
by
  intro I _ _ D X ρ hlim haff hcpt hqs W q hq hqe
  obtain ⟨hl⟩ := hlim
  haveI := hq
  haveI := hqe
  have hqa : IsAffineHom q := inferInstance
  have hql : LocallyOfFinitePresentation q := inferInstance
  obtain ⟨i₁, V₁, p₁, j₁, hp₁a, hp₁l, hj₁⟩ :=
    wc_limit_affine_lfp_descend I D (Limits.Cone.mk X ρ) hl haff hcpt hqs W q hqa hql
  change IsPullback j₁ q p₁ (ρ.app i₁) at hj₁
  obtain ⟨i₂, f, hf₁, hf₂⟩ :=
    wc_limit_finite_etale_spread I D (Limits.Cone.mk X ρ) hl haff hcpt hqs i₁ V₁ p₁ W q j₁
      hp₁a hp₁l hj₁ hq hqe
  have hcone : ρ.app i₂ ≫ D.map f = ρ.app i₁ := (Limits.Cone.mk X ρ).w f
  have w₁ : j₁ ≫ p₁ = (q ≫ ρ.app i₂) ≫ D.map f := by
    rw [Category.assoc, hcone]
    exact hj₁.toCommSq.w
  let w : W ⟶ Limits.pullback p₁ (D.map f) := Limits.pullback.lift j₁ (q ≫ ρ.app i₂) w₁
  have hwf : w ≫ Limits.pullback.fst p₁ (D.map f) = j₁ := Limits.pullback.lift_fst _ _ _
  have hws : w ≫ Limits.pullback.snd p₁ (D.map f) = q ≫ ρ.app i₂ := Limits.pullback.lift_snd _ _ _
  refine ⟨i₂, Limits.pullback p₁ (D.map f), Limits.pullback.snd p₁ (D.map f), w, hf₁, hf₂, ?_⟩
  have hbig : IsPullback (w ≫ Limits.pullback.fst p₁ (D.map f)) q p₁ (ρ.app i₂ ≫ D.map f) := by
    rw [hwf, hcone]
    exact hj₁
  exact IsPullback.of_right hbig hws (IsPullback.of_hasPullback p₁ (D.map f))

theorem wc_fet_ext_of_completion_approx : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [CommRing B]
    [IsLocalRing B] (φ : A →+* B), IsLocalHom φ →
    (∀ b : B, ∃ a : A, b - φ a ∈ IsLocalRing.maximalIdeal B) →
    (∀ (n : ℕ) (s : Finset (MvPolynomial (Fin n) A)) (b : Fin n → B),
      (∀ f ∈ s, MvPolynomial.eval₂ φ b f = 0) →
      ∃ a : Fin n → A, (∀ f ∈ s, MvPolynomial.eval a f = 0) ∧
        ∀ k, b k - φ (a k) ∈ IsLocalRing.maximalIdeal B) →
    (∀ (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (i : Z₀ ⟶ Z)
      (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) →
      ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Z₀), IsFinite p₀ → Etale p₀ →
      ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p i) →
    ∀ (Z Z₀ : Scheme.{u}) (h : Z ⟶ Spec (.of A)) [IsProper h] (i : Z₀ ⟶ Z)
      (h₀ : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField A))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) →
      ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Z₀), IsFinite p₀ → Etale p₀ →
      ∃ (V : Scheme.{u}) (p : V ⟶ Z) (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p i :=
by
  intro A B _ _ _ _ _ φ hφ hres happrox hESB Z Z₀ h _ i h₀ hsq V₀ p₀ hf he
  haveI := hφ

  have s2 : ∀ (C : Type u) [CommRing C] (ψ : A →+* C) (β : C →+* B), ψ.FinitePresentation →
      β.comp ψ = φ → ∃ σ : C →+* A, σ.comp ψ = RingHom.id A ∧
        (IsLocalRing.residue B).comp β =
          (IsLocalRing.ResidueField.map φ).comp ((IsLocalRing.residue A).comp σ) := by
    intro C _ ψ β hfp hβψ
    letI := ψ.toAlgebra
    have hfp' : Algebra.FinitePresentation A C := hfp
    obtain ⟨n, π, hπ, hker⟩ := hfp'.out
    obtain ⟨s, hs⟩ := hker
    have hψC : ∀ r : A, ψ r = π (MvPolynomial.C r) := by
      intro r
      rw [MvPolynomial.algHom_C]
      rfl
    let b : Fin n → B := fun k => β (π (MvPolynomial.X k))
    have hβπ : ∀ p, β (π p) = MvPolynomial.eval₂Hom φ b p := by
      intro p
      have e : β.comp π.toRingHom = MvPolynomial.eval₂Hom φ b := by
        apply MvPolynomial.ringHom_ext
        · intro r
          change β (π (MvPolynomial.C r)) = _
          rw [← hψC, MvPolynomial.eval₂Hom_C, ← RingHom.comp_apply, hβψ]
        · intro k
          change β (π (MvPolynomial.X k)) = _
          rw [MvPolynomial.eval₂Hom_X']
      exact RingHom.congr_fun e p
    have hsb : ∀ f ∈ s, MvPolynomial.eval₂ φ b f = 0 := by
      intro f hf
      have hfk : f ∈ RingHom.ker π.toRingHom := hs ▸ Ideal.subset_span hf
      rw [← MvPolynomial.coe_eval₂Hom, ← hβπ]
      change β (π.toRingHom f) = 0
      rw [(RingHom.mem_ker).mp hfk, map_zero]
    obtain ⟨a, ha0, hab⟩ := happrox n s b hsb
    have hker_le : RingHom.ker π.toRingHom ≤ RingHom.ker (MvPolynomial.eval a) := by
      rw [← hs, Ideal.span_le]
      intro f hf
      exact (RingHom.mem_ker).mpr (ha0 f hf)
    let σ : C →+* A := (π.toRingHom).liftOfRightInverse (Function.surjInv hπ)
      (Function.rightInverse_surjInv hπ) ⟨MvPolynomial.eval a, hker_le⟩
    have hσπ : ∀ p, σ (π p) = MvPolynomial.eval a p := fun p =>
      RingHom.liftOfRightInverse_comp_apply _ _ _ _ p
    refine ⟨σ, ?_, ?_⟩
    · ext r
      rw [RingHom.comp_apply, hψC, hσπ, MvPolynomial.eval_C, RingHom.id_apply]
    · ext c
      obtain ⟨p, rfl⟩ := hπ c
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, hσπ, hβπ]
      have key : (IsLocalRing.residue B).comp (MvPolynomial.eval₂Hom φ b) =
          ((IsLocalRing.ResidueField.map φ).comp (IsLocalRing.residue A)).comp
            (MvPolynomial.eval a) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, MvPolynomial.eval_C,
            IsLocalRing.ResidueField.map_residue]
        · intro k
          simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', MvPolynomial.eval_X,
            IsLocalRing.ResidueField.map_residue]
          rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
          exact hab k
      exact RingHom.congr_fun key p

  have hbij : Function.Bijective (IsLocalRing.ResidueField.map φ) := by
    refine ⟨(IsLocalRing.ResidueField.map φ).injective, fun y => ?_⟩
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨a, ha⟩ := hres b
    refine ⟨IsLocalRing.residue A a, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff]
    have e : φ a - b = -(b - φ a) := by ring
    rw [e]
    exact Submodule.neg_mem _ ha
  haveI hiso : IsIso (CommRingCat.ofHom (IsLocalRing.ResidueField.map φ)) :=
    ⟨⟨CommRingCat.ofHom (RingEquiv.ofBijective _ hbij).symm.toRingHom,
      by ext x; simp <;> exact (RingEquiv.ofBijective _ hbij).symm_apply_apply x,
      by ext x; simp <;> exact (RingEquiv.ofBijective _ hbij).apply_symm_apply x⟩⟩
  set Sk := Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map φ)) with hSk
  set rA := Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) with hrA
  set rB := Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) with hrB
  set Sφ := Spec.map (CommRingCat.ofHom φ) with hSφ
  have hstar : rB ≫ Sφ = Sk ≫ rA := by
    rw [hrB, hSφ, hSk, hrA, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp, IsLocalRing.ResidueField.map_comp_residue]
  let h₀B : Z₀ ⟶ Spec (.of (IsLocalRing.ResidueField B)) := h₀ ≫ inv Sk
  have hw : i ≫ h = (h₀B ≫ rB) ≫ Sφ := by
    rw [Category.assoc, hstar]
    simp only [h₀B, Category.assoc, IsIso.inv_hom_id_assoc]
    exact hsq.w
  let iB : Z₀ ⟶ Limits.pullback h Sφ := Limits.pullback.lift i (h₀B ≫ rB) hw
  have hiBf : iB ≫ Limits.pullback.fst h Sφ = i := Limits.pullback.lift_fst _ _ _
  have hiBs : iB ≫ Limits.pullback.snd h Sφ = h₀B ≫ rB := Limits.pullback.lift_snd _ _ _
  have hbig0 : IsPullback i h₀B h (rB ≫ Sφ) := by
    refine IsPullback.of_iso hsq (Iso.refl _) (Iso.refl _) (asIso Sk).symm (Iso.refl _)
      ?_ ?_ ?_ ?_
    · simp
    · simp [h₀B]
    · simp
    · rw [hstar]; simp
  have hB : IsPullback iB h₀B (Limits.pullback.snd h Sφ) rB := by
    refine IsPullback.of_right ?_ hiBs (IsPullback.of_hasPullback h Sφ)
    rw [hiBf]
    exact hbig0

  obtain ⟨W, q, jW, hq, hqe, hW⟩ := hESB (Limits.pullback h Sφ) Z₀ (Limits.pullback.snd h Sφ)
    iB h₀B hB V₀ p₀ hf he

  obtain ⟨D, ρ, C, instC, ψ, β, sE, hE, hlim, haff, hcpt, hqs, hfp, hβψ, hpb, hρs, hρh⟩ :=
    wc_fp_subalgebra_limit_presentation A B φ Z h
  obtain ⟨T, Wi, qi, w, hqi, hqie, hw'⟩ :=
    wc_fet_descend_cofiltered_limit (Finset B)ᵒᵖ D _ ρ hlim haff hcpt hqs W q hq hqe

  obtain ⟨σ, hσ, hres'⟩ := s2 (C T) (ψ T) (β T) (hfp T) (hβψ T)
  have wσ : 𝟙 Z ≫ h = (h ≫ Spec.map (CommRingCat.ofHom σ)) ≫ Spec.map (CommRingCat.ofHom (ψ T)) := by
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hσ, CommRingCat.ofHom_id,
      Spec.map_id, Category.comp_id, Category.id_comp]
  let sec : Z ⟶ D.obj T := (hpb T).lift (𝟙 Z) (h ≫ Spec.map (CommRingCat.ofHom σ)) wσ
  have hsecf : sec ≫ sE T = 𝟙 Z := (hpb T).lift_fst _ _ _
  have hsecs : sec ≫ hE T = h ≫ Spec.map (CommRingCat.ofHom σ) := (hpb T).lift_snd _ _ _
  have hkey : rB ≫ Spec.map (CommRingCat.ofHom (β T)) =
      Sk ≫ rA ≫ Spec.map (CommRingCat.ofHom σ) := by
    rw [hrB, hSk, hrA]
    simp only [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hres']
  have hkey2 : i ≫ sec = iB ≫ ρ.app T := by
    apply (hpb T).hom_ext
    · rw [Category.assoc, Category.assoc, hsecf, hρs, Category.comp_id, hiBf]
    · rw [Category.assoc, Category.assoc, hsecs, hρh, ← Category.assoc iB, hiBs,
        ← Category.assoc i, hsq.w, Category.assoc, Category.assoc, hkey]
      simp only [h₀B, Category.assoc, IsIso.inv_hom_id_assoc]
  have hbig : IsPullback (jW ≫ w) p₀ qi (i ≫ sec) := by
    rw [hkey2]
    exact hW.paste_horiz hw'
  let j : V₀ ⟶ Limits.pullback qi sec :=
    Limits.pullback.lift (jW ≫ w) (p₀ ≫ i) (by rw [hbig.w, Category.assoc])
  have hjf : j ≫ Limits.pullback.fst qi sec = jW ≫ w := Limits.pullback.lift_fst _ _ _
  have hjs : j ≫ Limits.pullback.snd qi sec = p₀ ≫ i := Limits.pullback.lift_snd _ _ _
  refine ⟨Limits.pullback qi sec, Limits.pullback.snd qi sec, j, ?_, ?_, ?_⟩
  · exact MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_hasPullback qi sec) hqi
  · exact MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback qi sec) hqie
  · refine IsPullback.of_right ?_ hjs (IsPullback.of_hasPullback qi sec)
    rw [hjf]
    exact hbig

theorem wc_hnas_local_subring_localizations : ∀ (A : Type u) [CommRing A] [IsLocalRing A], (∀ S : Finset A, Algebra.FiniteType ℤ ↥(Subring.closure (S : Set A)) ∧ IsNoetherianRing (Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype)) ∧ ∃ g : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype) →+* A, IsLocalHom g ∧ g.comp (algebraMap ↥(Subring.closure (S : Set A)) _) = (Subring.closure (S : Set A)).subtype) ∧ ∀ (S S' : Finset A), S ⊆ S' → ∃ t : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype) →+* Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S' : Set A)).subtype), IsLocalHom t ∧ ∀ (g : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype) →+* A) (g' : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S' : Set A)).subtype) →+* A), g.comp (algebraMap ↥(Subring.closure (S : Set A)) _) = (Subring.closure (S : Set A)).subtype → g'.comp (algebraMap ↥(Subring.closure (S' : Set A)) _) = (Subring.closure (S' : Set A)).subtype → g'.comp t = g :=
by
  intro A _ _
  classical

  have key1 : ∀ S : Finset A, Algebra.FiniteType ℤ ↥(Subring.closure (S : Set A)) := by
    intro S
    let gen : S → ↥(Subring.closure (S : Set A)) :=
      fun x => ⟨x, Subring.subset_closure (Finset.mem_coe.2 x.2)⟩
    refine ⟨⟨(Set.finite_range gen).toFinset, ?_⟩⟩
    rw [Set.Finite.coe_toFinset, eq_top_iff]
    rintro ⟨x, hx⟩ -
    induction hx using Subring.closure_induction with
    | mem x hx => exact Algebra.subset_adjoin ⟨⟨x, hx⟩, rfl⟩
    | zero => exact Subalgebra.zero_mem _
    | one => exact Subalgebra.one_mem _
    | add x y hx hy ihx ihy => exact Subalgebra.add_mem _ ihx ihy
    | neg x hx ih => exact Subalgebra.neg_mem _ ih
    | mul x y hx hy ihx ihy => exact Subalgebra.mul_mem _ ihx ihy

  have key2 : ∀ S : Finset A, IsNoetherianRing (Localization.AtPrime
      ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype)) := by
    intro S
    haveI := key1 S
    haveI : IsNoetherianRing ↥(Subring.closure (S : Set A)) :=
      Algebra.FiniteType.isNoetherianRing ℤ _
    exact IsLocalization.isNoetherianRing
      ((IsLocalRing.maximalIdeal A).comap (Subring.closure (S : Set A)).subtype).primeCompl _
      inferInstance

  have hu : ∀ (R : Subring A)
      (y : ((IsLocalRing.maximalIdeal A).comap R.subtype).primeCompl), IsUnit (R.subtype y) := by
    intro R y
    by_contra h
    exact y.2 (Ideal.mem_comap.2 ((IsLocalRing.mem_maximalIdeal _).2 h))

  have hg : ∀ R : Subring A, ∃ g : Localization.AtPrime
      ((IsLocalRing.maximalIdeal A).comap R.subtype) →+* A,
      IsLocalHom g ∧ g.comp (algebraMap R _) = R.subtype := by
    intro R
    refine ⟨IsLocalization.lift
      (S := Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap R.subtype)) (hu R),
      ⟨fun x hx => ?_⟩, IsLocalization.lift_comp _⟩
    obtain ⟨⟨r, y⟩, hxy⟩ :=
      IsLocalization.surj ((IsLocalRing.maximalIdeal A).comap R.subtype).primeCompl x
    simp only at hxy
    have h1 := congrArg (IsLocalization.lift
      (S := Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap R.subtype)) (hu R)) hxy
    rw [map_mul, IsLocalization.lift_eq, IsLocalization.lift_eq] at h1
    have hr : IsUnit (R.subtype r) := by
      rw [← h1]
      exact hx.mul (hu R y)
    have hr' : r ∈ ((IsLocalRing.maximalIdeal A).comap R.subtype).primeCompl :=
      fun hm => (IsLocalRing.mem_maximalIdeal _).1 (Ideal.mem_comap.1 hm) hr
    have hu2 : IsUnit (x * algebraMap R
        (Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap R.subtype)) (y : R)) := by
      rw [hxy]
      exact IsLocalization.map_units _
        (⟨r, hr'⟩ : ((IsLocalRing.maximalIdeal A).comap R.subtype).primeCompl)
    exact isUnit_of_mul_isUnit_left hu2

  have ht : ∀ R R' : Subring A, R ≤ R' → ∃ t : Localization.AtPrime
      ((IsLocalRing.maximalIdeal A).comap R.subtype) →+* Localization.AtPrime
      ((IsLocalRing.maximalIdeal A).comap R'.subtype), IsLocalHom t ∧
      ∀ (g : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap R.subtype) →+* A)
        (g' : Localization.AtPrime ((IsLocalRing.maximalIdeal A).comap R'.subtype) →+* A),
        g.comp (algebraMap R _) = R.subtype → g'.comp (algebraMap R' _) = R'.subtype →
        g'.comp t = g := by
    intro R R' hle
    have hIJ : (IsLocalRing.maximalIdeal A).comap R.subtype =
        ((IsLocalRing.maximalIdeal A).comap R'.subtype).comap (Subring.inclusion hle) := by
      ext x
      exact Iff.rfl
    refine ⟨Localization.localRingHom _ _ (Subring.inclusion hle) hIJ,
      Localization.isLocalHom_localRingHom _ _ _ hIJ, ?_⟩
    intro g g' hg hg'
    apply IsLocalization.ringHom_ext ((IsLocalRing.maximalIdeal A).comap R.subtype).primeCompl
    ext r
    have e1 := RingHom.congr_fun hg' (Subring.inclusion hle r)
    have e2 := RingHom.congr_fun hg r
    simp only [RingHom.comp_apply] at e1 e2 ⊢
    rw [Localization.localRingHom_to_map, e1, e2]
    rfl
  exact ⟨fun S => ⟨key1 S, key2 S, hg _⟩,
    fun S S' hSS' => ht _ _ (Subring.closure_mono (Finset.coe_subset.2 hSS'))⟩

theorem wc_hnas_completion_local_complete : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], ∃ (_ : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P)), IsAdicComplete (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P)) (AdicCompletion (IsLocalRing.maximalIdeal P) P) ∧ IsLocalHom (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) ∧ ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P, ∃ a : P, b - algebraMap P _ a ∈ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
by
  intro P _ _ _
  have hfg : (IsLocalRing.maximalIdeal P).FG := IsNoetherian.noetherian _
  have hcompl := AdicCompletion.isAdicComplete_self (IsLocalRing.maximalIdeal P) hfg

  have hmem : ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P,
      b ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P) ↔
      AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1 b = 0 := by
    intro b
    have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := P) (n := 1) hfg
    have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal P) P)
      (IsLocalRing.maximalIdeal P ^ 1)
    have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
    rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
    have e : Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P ^ 1) =
        Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P) := by rw [pow_one]
    rw [e] at h3
    exact h3

  have hlift : ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P, ∃ a : P,
      b - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a ∈
        Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P) := by
    intro b
    obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective _
      (AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1 b)
    refine ⟨a, (hmem _).mpr ?_⟩
    rw [map_sub]
    have : AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
        (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a) =
        Submodule.Quotient.mk a := by
      change AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
        (AdicCompletion.of (IsLocalRing.maximalIdeal P) P a) = _
      rw [AdicCompletion.eval_of]
      rfl
    rw [this, ha, sub_self]

  have hone : (1 : AdicCompletion (IsLocalRing.maximalIdeal P) P) ∉
      Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P) := by
    intro h
    rw [hmem, ← map_one (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))] at h
    change AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
      (AdicCompletion.of (IsLocalRing.maximalIdeal P) P 1) = 0 at h
    rw [AdicCompletion.eval_of, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h
    have hle : IsLocalRing.maximalIdeal P ^ 1 • (⊤ : Submodule P P) ≤
        IsLocalRing.maximalIdeal P := by
      rw [pow_one, Ideal.smul_eq_mul, Ideal.mul_top]
    exact (IsLocalRing.maximalIdeal.isMaximal P).ne_top ((Ideal.eq_top_iff_one _).mpr (hle h))
  have hnu : ∀ x ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
      (IsLocalRing.maximalIdeal P), ¬ IsUnit x := fun x hx hu =>
    hone (by rw [Ideal.eq_top_of_isUnit_mem _ hx hu]; trivial)
  have : Nontrivial (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    nontrivial_of_ne 1 0 (fun h => hone (h ▸ Ideal.zero_mem _))
  have := hcompl
  have hjac := IsAdicComplete.le_jacobson_bot
    (Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
      (IsLocalRing.maximalIdeal P))

  have hdich : ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P,
      b ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P) ∨ IsUnit b := by
    intro b
    obtain ⟨a, ha⟩ := hlift b
    by_cases haM : a ∈ IsLocalRing.maximalIdeal P
    · left
      have := Ideal.add_mem _ ha (Ideal.mem_map_of_mem
        (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) haM)
      rwa [sub_add_cancel] at this
    · right
      have hu : IsUnit (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a) :=
        (IsLocalRing.notMem_maximalIdeal.mp haM).map _
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      have hx := Ideal.mem_jacobson_bot.mp (hjac ha) v
      have heq : (b - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a) * v + 1
          = b * v := by
        rw [sub_mul, hv]; ring
      rw [heq] at hx
      exact isUnit_of_mul_isUnit_left hx

  have hloc : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    IsLocalRing.of_nonunits_add (fun x y hx hy =>
      hnu _ (Ideal.add_mem _ ((hdich x).resolve_right hx) ((hdich y).resolve_right hy)))
  refine ⟨hloc, ?_⟩

  have hmax : IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) =
      Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P) := by
    ext z
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact ⟨fun h => (hdich z).resolve_right h, hnu z⟩
  rw [hmax]
  refine ⟨hcompl, ⟨fun a ha => ?_⟩, fun b => hlift b⟩
  by_contra hna
  exact hnu _ (Ideal.mem_map_of_mem _ ((IsLocalRing.mem_maximalIdeal _).mpr hna)) ha

