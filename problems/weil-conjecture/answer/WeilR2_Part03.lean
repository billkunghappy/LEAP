by
  intro B _ I Z _ h Fs ψ H Hs ψH φH α hF hHs hHalg hα V hV J t hLim
  haveI : IsNoetherianRing Γ(Z, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩

  have lift : ∀ (n : ℕ) (T : ℕ → Type u) (τ : ∀ m, T (m+1) → T m),
      (∀ m, Function.Surjective (τ m)) →
      ∀ w : T n, ∃ x : ∀ m, T m, (∀ m, τ m (x (m+1)) = x m) ∧ x n = w := by
    intro n
    induction n with
    | zero =>
      intro T τ hτ w
      refine ⟨fun m => Nat.rec (motive := fun m => T m) w
        (fun m xm => Function.surjInv (hτ m) xm) m, ?_, rfl⟩
      intro m
      exact Function.surjInv_eq (hτ m) _
    | succ n ih =>
      intro T τ hτ w
      obtain ⟨x', hx', hxn⟩ := ih (fun m => T (m+1)) (fun m => τ (m+1)) (fun m => hτ (m+1)) w
      refine ⟨fun m => Nat.casesOn (motive := fun m => T m) m (τ 0 (x' 0)) (fun m => x' m),
        ?_, hxn⟩
      intro m
      cases m with
      | zero => rfl
      | succ m => exact hx' m

  have closed : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (𝔟 : Ideal R) (M : Type u)
      [AddCommGroup M] [Module R M] (Q : ℕ → Type u) [∀ n, AddCommGroup (Q n)]
      [∀ n, Module R (Q n)] (ψQ : ∀ n, Q (n + 1) →ₗ[R] Q n) (φ : ∀ n, M →ₗ[R] Q n),
      (∀ n (x : M), ψQ n (φ (n + 1) x) = φ n x) → (∀ n, Function.Surjective (φ n)) →
      (∀ n (x : M), φ n x = 0 ↔ x ∈ 𝔟 ^ (n + 1) • (⊤ : Submodule R M)) →
      ∀ (y : ∀ n, Q n), (∀ n, ψQ n (y (n + 1)) = y n) → ∀ n, y n = 0 →
      ∃ (k : ℕ) (a : Fin k → R) (z : Fin k → ∀ m, Q m), (∀ i, a i ∈ 𝔟 ^ (n + 1)) ∧
        (∀ i m, ψQ m (z i (m + 1)) = z i m) ∧ ∀ m, y m = ∑ i, a i • z i m := by
    intro R _ _ 𝔟 M _ _ Q _ _ ψQ φ hc hs hk y hy n hyn
    obtain ⟨k, a, ha⟩ := (Submodule.fg_iff_exists_fin_generating_family).mp
      (IsNoetherian.noetherian (𝔟 ^ (n + 1)))
    have hdec : ∀ (P : Submodule R M) (x : M), x ∈ 𝔟 ^ (n + 1) • P →
        ∃ v : Fin k → M, (∀ i, v i ∈ P) ∧ x = ∑ i, a i • v i := by
      intro P x hx
      refine Submodule.smul_induction_on hx ?_ ?_
      · intro r hr q hq
        rw [← ha] at hr
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hr
        refine ⟨fun i => c i • q, fun i => P.smul_mem _ hq, ?_⟩
        rw [← hc, Finset.sum_smul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [smul_eq_mul, mul_comm, mul_smul]
      · rintro x x' ⟨v, hv, rfl⟩ ⟨v', hv', rfl⟩
        refine ⟨v + v', fun i => P.add_mem (hv i) (hv' i), ?_⟩
        simp only [Pi.add_apply, smul_add, Finset.sum_add_distrib]
    choose Y hY using fun m => hs m (y m)
    have hA : ∀ d m, φ m (Y (m + d)) = y m := by
      intro d
      induction d with
      | zero => intro m; exact hY m
      | succ d ih =>
        intro m
        rw [← hc m, show m + (d + 1) = (m + 1) + d by omega, ih (m + 1), hy m]
    have hpow : ∀ j, 𝔟 ^ (n + j + 1) • (⊤ : Submodule R M) = 𝔟 ^ (n + 1) • (𝔟 ^ j • ⊤) := by
      intro j
      rw [← Submodule.mul_smul, ← pow_add, show n + 1 + j = n + j + 1 by omega]
    have hD : ∀ j, ∃ v : Fin k → M, (∀ i, v i ∈ 𝔟 ^ j • (⊤ : Submodule R M)) ∧
        Y (n + j + 1) - Y (n + j) = ∑ i, a i • v i := by
      intro j
      apply hdec
      rw [← hpow, ← hk, map_sub, sub_eq_zero, ← hc (n + j) (Y (n + j + 1)), hY (n + j + 1),
        hy (n + j), hY (n + j)]
    obtain ⟨v0, -, hv0⟩ := hdec ⊤ (Y n) (by rw [← hk, hY, hyn])
    choose v hv hvD using hD
    have htel : ∀ J, Y n + ∑ j ∈ Finset.range J, (Y (n + j + 1) - Y (n + j)) = Y (n + J) := by
      intro J
      induction J with
      | zero => simp
      | succ J ih =>
        rw [Finset.sum_range_succ, ← add_assoc, ih, show n + (J + 1) = n + J + 1 from rfl]
        abel
    refine ⟨k, a, fun i m => φ m (v0 i + ∑ j ∈ Finset.range (m + 1), v j i), fun i => ?_, ?_, ?_⟩
    · rw [← ha]; exact Submodule.subset_span ⟨i, rfl⟩
    · intro i m
      rw [hc, Finset.sum_range_succ (n := m + 1), ← add_assoc, map_add,
        (hk m _).mpr (hv (m + 1) i), add_zero]
    · intro m
      have e1 : ∑ i, a i • φ m (v0 i + ∑ j ∈ Finset.range (m + 1), v j i) =
          φ m (Y n + ∑ j ∈ Finset.range (m + 1), (Y (n + j + 1) - Y (n + j))) := by
        rw [hv0]
        simp only [hvD, map_add, map_sum, map_smul, smul_add, Finset.sum_add_distrib,
          Finset.smul_sum]
        congr 1
        exact Finset.sum_comm
      rw [e1, htel, show n + (m + 1) = m + (n + 1) by omega, hA]

  have transfer : ∀ (R : Type u) [CommRing R] (𝔞 J : Ideal R) (t : ℕ) (N Q : ℕ → Type u)
      [∀ n, AddCommGroup (N n)] [∀ n, Module R (N n)] [∀ n, AddCommGroup (Q n)]
      [∀ n, Module R (Q n)]
      (ψN : ∀ n, N (n+1) →ₗ[R] N n) (ψQ : ∀ n, Q (n+1) →ₗ[R] Q n) (α : ∀ n, N n →ₗ[R] Q n),
      (∀ n, ∀ a ∈ 𝔞 ^ (n+1), ∀ x : N n, a • x = 0) → (∀ n, Function.Surjective (ψN n)) →
      (∀ n, Function.Surjective (ψQ n)) → (∀ n x, α n (ψN n x) = ψQ n (α (n+1) x)) →
      (∀ (y : ∀ n, Q n), (∀ n, ψQ n (y (n+1)) = y n) → ∀ n, y n = 0 →
        ∃ (k : ℕ) (a : Fin k → R) (z : Fin k → ∀ m, Q m), (∀ i, a i ∈ 𝔞 ^ (n+1)) ∧
          (∀ i m, ψQ m (z i (m+1)) = z i m) ∧ ∀ m, y m = ∑ i, a i • z i m) →
      (∀ x : ∀ n, N n, (∀ n, ψN n (x (n+1)) = x n) → (∀ n, α n (x n) = 0) →
        ∀ a ∈ J ^ t, ∀ n, a • x n = 0) →
      (∀ y : ∀ n, Q n, (∀ n, ψQ n (y (n+1)) = y n) → ∀ a ∈ J ^ t,
        ∃ x : ∀ n, N n, (∀ n, ψN n (x (n+1)) = x n) ∧ ∀ n, α n (x n) = a • y n) →
      ∀ n, (∀ x : N n, α n x = 0 → ∀ a ∈ J ^ (2 * t), a • x = 0) ∧
        (∀ y : Q n, ∀ a ∈ J ^ (2 * t), ∃ x : N n, α n x = a • y) := by
    intro R _ 𝔞 J t N Q _ _ _ _ ψN ψQ α hkill hsN hsQ hα hcl hLk hLc n
    have hle : J ^ (2 * t) ≤ J ^ t := Ideal.pow_le_pow_right (by omega)
    refine ⟨fun x₀ hx₀ a ha => ?_, fun y₀ a ha => ?_⟩
    · obtain ⟨x, hx, hxn⟩ := lift n N (fun m => ψN m) hsN x₀
      have hy : ∀ m, ψQ m (α (m+1) (x (m+1))) = α m (x m) := fun m => by rw [← hα, hx]
      obtain ⟨k, c, z, hc, hz, hyz⟩ := hcl (fun m => α m (x m)) hy n
        (show α n (x n) = 0 by rw [hxn, hx₀])
      have hyz' : ∀ m, α m (x m) = ∑ i, c i • z i m := hyz
      have key : ∀ b ∈ J ^ t, ∀ b' ∈ J ^ t, (b' * b) • x₀ = 0 := by
        intro b hb b' hb'
        choose w hw hwα using fun i => hLc (z i) (hz i) b hb
        have hu := hLk (fun m => b • x m - ∑ i, c i • w i m)
          (fun m => by simp only [map_sub, map_sum, map_smul, hx, hw])
          (fun m => by
            simp only [map_sub, map_sum, map_smul, hwα, hyz' m, Finset.smul_sum]
            rw [sub_eq_zero]
            exact Finset.sum_congr rfl (fun i _ => smul_comm _ _ _)) b' hb' n
        have h0 : ∀ i, c i • w i n = 0 := fun i => hkill n _ (hc i) _
        simp only [h0, Finset.sum_const_zero, sub_zero, hxn] at hu
        rw [mul_smul]; exact hu
      have hJ : J ^ (2 * t) ≤ LinearMap.ker (LinearMap.toSpanSingleton R (N n) x₀) := by
        rw [two_mul, pow_add]
        exact Ideal.mul_le.mpr (fun b' hb' b hb => by
          rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]; exact key b hb b' hb')
      have := hJ ha
      rwa [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] at this
    · obtain ⟨y, hy, hyn⟩ := lift n Q (fun m => ψQ m) hsQ y₀
      obtain ⟨x, -, hxα⟩ := hLc y hy a (hle ha)
      exact ⟨x n, by rw [hxα, hyn]⟩

  let L : ∀ {A A' : Z.Modules}, (A ⟶ A') → (Γ(A, V) →ₗ[Γ(Z, V)] Γ(A', V)) := fun f =>
    { toFun := fun x => Scheme.Modules.Hom.app f V x
      map_add' := fun x y => map_add _ x y
      map_smul' := fun r x => Scheme.Modules.Hom.app_smul f r x }
  have hL : ∀ {A A' : Z.Modules} (f : A ⟶ A') (x : Γ(A, V)),
      L f x = Scheme.Modules.Hom.app f V x := fun _ _ => rfl
  have hcomp : ∀ {A A' A'' : Z.Modules} (f : A ⟶ A') (g : A' ⟶ A'') (x : Γ(A, V)),
      Scheme.Modules.Hom.app (f ≫ g) V x =
        Scheme.Modules.Hom.app g V (Scheme.Modules.Hom.app f V x) := by
    intro A A' A'' f g x
    rw [Scheme.Modules.Hom.comp_app]; rfl
  have hmp : ∀ n, Ideal.map (wcCnSigma h V) (I ^ (n + 1)) =
      Ideal.map (wcCnSigma h V) I ^ (n + 1) := fun n => Ideal.map_pow _ _ _
  refine transfer Γ(Z, V) (Ideal.map (wcCnSigma h V) I) J t (fun n => Γ(Fs n, V))
    (fun n => Γ(Hs n, V)) (fun n => L (ψ n)) (fun n => L (ψH n)) (fun n => L (α n))
    ?_ ?_ ?_ ?_ ?_ hLim.1 hLim.2
  · intro n a ha x
    have h1 := hF.2.2 n V hV
    rw [hmp] at h1
    have h2 : a • x ∈ Ideal.map (wcCnSigma h V) I ^ (n + 1) •
        (⊤ : Submodule Γ(Z, V) Γ(Fs n, V)) := Submodule.smul_mem_smul ha Submodule.mem_top
    rw [h1] at h2
    exact (Submodule.mem_bot _).mp h2
  · intro n; exact (hF.2.1 n V hV).1
  · intro n; exact (hHs.2.1 n V hV).1
  · intro n x
    simp only [hL]
    rw [← hcomp, ← hcomp, hα n]
  · intro y hy n hyn
    refine closed Γ(Z, V) (Ideal.map (wcCnSigma h V) I) Γ(H, V) (fun n => Γ(Hs n, V))
      (fun n => L (ψH n)) (fun n => L (φH n)) ?_ ?_ ?_ y hy n hyn
    · intro n x
      simp only [hL]
      rw [← hcomp, hHalg.2.1 n]
    · intro n; exact (hHalg.2.2 n V hV).1
    · intro n x
      rw [← hmp]
      exact (hHalg.2.2 n V hV).2 x

theorem wc_cn_almostIso_of_affinewise : ∀ (Z : Scheme.{u}) [CompactSpace Z] (Fs Hs : ℕ → Z.Modules)
    (α : ∀ n, Fs n ⟶ Hs n) (𝒥 : Z.IdealSheafData),
    (∀ n, wcQcoh (Fs n)) → (∀ n, wcQcoh (Hs n)) →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), ∃ t : ℕ, wcCnLevelBound Fs Hs α V (𝒥.ideal ⟨V, hV⟩) t) →
    ∃ t : ℕ, ∀ n, wcCnAlmostIso 𝒥 t (α n) :=
by
  intro Z _ Fs Hs α 𝒥 hF hH hloc
  classical

  have nat : ∀ {M N : Z.Modules} (φ : M ⟶ N) {U U' : Z.Opens} (h : U ≤ U') (x : Γ(M, U')),
      Scheme.Modules.Hom.app φ U ((M.presheaf.map (homOfLE h).op).hom x) =
        (N.presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app φ U' x) := by
    intro M N φ U U' h x
    have e := (Scheme.Modules.Hom.mapPresheaf φ).naturality (homOfLE h).op
    exact congrArg (fun k => k.hom x) e
  have resSmul : ∀ (M : Z.Modules) {U U' : Z.Opens} (h : U ≤ U') (c : Γ(Z, U')) (x : Γ(M, U')),
      (M.presheaf.map (homOfLE h).op).hom (c • x) =
        (Z.presheaf.map (homOfLE h).op).hom c • (M.presheaf.map (homOfLE h).op).hom x :=
    fun M _ _ h c x => Scheme.Modules.map_smul M (homOfLE h) c x
  have appSmul : ∀ {M N : Z.Modules} (φ : M ⟶ N) (U : Z.Opens) (c : Γ(Z, U)) (x : Γ(M, U)),
      Scheme.Modules.Hom.app φ U (c • x) = c • Scheme.Modules.Hom.app φ U x :=
    fun φ _ c x => Scheme.Modules.Hom.app_smul φ c x

  have s2 : ∀ (F H : Z.Modules) (β : F ⟶ H) (U : Z.Opens), IsAffineOpen U → wcQcoh F → wcQcoh H →
      ∀ (g : Γ(Z, U)) (K : Ideal Γ(Z, U)),
      (∀ s : Γ(F, U), Scheme.Modules.Hom.app β U s = 0 → ∀ b ∈ K, b • s = 0) →
      (∀ y : Γ(H, U), ∀ b ∈ K, ∃ s : Γ(F, U), Scheme.Modules.Hom.app β U s = b • y) →
      (∀ σ : Γ(F, Z.basicOpen g), Scheme.Modules.Hom.app β (Z.basicOpen g) σ = 0 →
          ∀ c ∈ Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom K, c • σ = 0) ∧
      (∀ η : Γ(H, Z.basicOpen g),
          ∀ c ∈ Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom K,
          ∃ σ : Γ(F, Z.basicOpen g), Scheme.Modules.Hom.app β (Z.basicOpen g) σ = c • η) := by
    intro F H β U hU hFq hHq g K hker hcok
    have hu : IsUnit ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) :=
      RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g
    refine ⟨fun σ hσ => ?_, fun η => ?_⟩
    · obtain ⟨N, s', hs'⟩ := (hFq U hU g).1 σ
      have e1 : (H.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom
          (Scheme.Modules.Hom.app β U s') = 0 := by
        rw [← nat β (Z.basicOpen_le g) s', ← hs', appSmul, hσ, smul_zero]
      obtain ⟨M, hM⟩ := (hHq U hU g).2 _ e1
      have e2 : Scheme.Modules.Hom.app β U (g ^ M • s') = 0 := by rw [appSmul, hM]
      have key : ∀ b ∈ K, (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom b •
          (((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ (N + M) • σ) = 0 := by
        intro b hb
        have h0 := hker _ e2 b hb
        have e3 := congrArg (F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom h0
        rw [map_zero, resSmul, resSmul, map_pow, ← hs'] at e3
        rw [pow_add, mul_comm, mul_smul]
        exact e3
      intro c hc
      have hle : Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom K ≤
          LinearMap.ker (LinearMap.toSpanSingleton Γ(Z, Z.basicOpen g) Γ(F, Z.basicOpen g)
            (((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ (N + M) • σ)) := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
        exact key b hb
      have h4 := hle hc
      rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, smul_comm] at h4
      exact ((hu.pow (N + M)).smul_eq_zero).mp h4
    · obtain ⟨N, y', hy'⟩ := (hHq U hU g).1 η
      let T : Ideal Γ(Z, Z.basicOpen g) :=
        { carrier := {c | ∃ σ : Γ(F, Z.basicOpen g), Scheme.Modules.Hom.app β (Z.basicOpen g) σ =
            c • (((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ N • η)}
          add_mem' := by
            rintro a b ⟨σ₁, h₁⟩ ⟨σ₂, h₂⟩
            exact ⟨σ₁ + σ₂, by rw [map_add, h₁, h₂, add_smul]⟩
          zero_mem' := ⟨0, by rw [map_zero, zero_smul]⟩
          smul_mem' := by
            rintro a b ⟨σ₁, h₁⟩
            exact ⟨a • σ₁, by rw [appSmul, h₁, smul_eq_mul, mul_smul]⟩ }
      have hT : ∀ c, c ∈ T ↔ ∃ σ : Γ(F, Z.basicOpen g),
          Scheme.Modules.Hom.app β (Z.basicOpen g) σ =
            c • (((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) ^ N • η) :=
        fun c => Iff.rfl
      have hle : Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom K ≤ T := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, hT]
        obtain ⟨sb, hsb⟩ := hcok y' b hb
        refine ⟨(F.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom sb, ?_⟩
        rw [nat, hsb, resSmul, ← hy']
      intro c hc
      obtain ⟨σ, hσ⟩ := (hT c).mp (hle hc)
      obtain ⟨v, hv⟩ := (hu.pow N).exists_left_inv
      refine ⟨v • σ, ?_⟩
      rw [appSmul, hσ, smul_comm v c, ← mul_smul v, hv, one_smul]

  obtain ⟨r, V, hV, hcov⟩ : ∃ (r : ℕ) (V : Fin r → Z.Opens),
      (∀ i, IsAffineOpen (V i)) ∧ ∀ x : Z, ∃ i, x ∈ V i := by
    have hA : ∀ x : Z, ∃ A : Z.Opens, IsAffineOpen A ∧ x ∈ A := by
      intro x
      obtain ⟨A, hA, hxA, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
        (show x ∈ (⊤ : Z.Opens) from trivial)
      exact ⟨A, hA, hxA⟩
    choose A hAff hxA using hA
    obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x => (A x : Set Z))
      (fun x => (A x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hxA y⟩)
    refine ⟨T.card, fun i => A (T.equivFin.symm i), fun i => hAff _, fun y => ?_⟩
    have hy := hT (Set.mem_univ y)
    simp only [Set.mem_iUnion] at hy
    obtain ⟨x, hx, hyx⟩ := hy
    refine ⟨T.equivFin ⟨x, hx⟩, ?_⟩
    simpa using hyx

  choose tV htV using fun i => hloc (V i) (hV i)
  obtain ⟨t, ht⟩ : ∃ t, t = ∑ i, tV i := ⟨_, rfl⟩
  have htle : ∀ i, tV i ≤ t := fun i =>
    ht ▸ Finset.single_le_sum (fun j _ => Nat.zero_le (tV j)) (Finset.mem_univ i)
  refine ⟨t, fun n => ?_⟩
  intro W hW

  have loc : ∀ (D : Z.Opens) (hDW : D ≤ W) (i : Fin r) (g : Γ(Z, V i)), Z.basicOpen g = D →
      (∀ σ : Γ(Fs n, D), Scheme.Modules.Hom.app (α n) D σ = 0 →
        ∀ a ∈ 𝒥.ideal ⟨W, hW⟩ ^ t, (Z.presheaf.map (homOfLE hDW).op).hom a • σ = 0) ∧
      (∀ η : Γ(Hs n, D), ∀ a ∈ 𝒥.ideal ⟨W, hW⟩ ^ t,
        ∃ σ : Γ(Fs n, D), Scheme.Modules.Hom.app (α n) D σ =
          (Z.presheaf.map (homOfLE hDW).op).hom a • η) := by
    intro D hDW i g hgD
    subst hgD
    have hmono : 𝒥.ideal ⟨V i, hV i⟩ ^ t ≤ 𝒥.ideal ⟨V i, hV i⟩ ^ tV i :=
      Ideal.pow_le_pow_right (htle i)
    obtain ⟨hk, hc⟩ := s2 (Fs n) (Hs n) (α n) (V i) (hV i) (hF n) (hH n) g
      (𝒥.ideal ⟨V i, hV i⟩ ^ t)
      (fun s hs b hb => (htV i n).1 s hs b (hmono hb))
      (fun y b hb => (htV i n).2 y b (hmono hb))
    have s4 : ∀ a ∈ 𝒥.ideal ⟨W, hW⟩ ^ t, (Z.presheaf.map (homOfLE hDW).op).hom a ∈
        Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom
          (𝒥.ideal ⟨V i, hV i⟩ ^ t) := by
      have h1 := 𝒥.map_ideal_basicOpen ⟨V i, hV i⟩ g
      have hle : Z.affineBasicOpen (U := ⟨V i, hV i⟩) g ≤ ⟨W, hW⟩ := by
        show (Z.affineBasicOpen (U := ⟨V i, hV i⟩) g : Z.Opens) ≤ W
        rw [Scheme.affineBasicOpen_coe]
        exact hDW
      have h2 := 𝒥.ideal_le_comap_ideal hle
      rw [← h1] at h2
      intro a ha
      have h3 := ((Ideal.pow_right_mono h2 t).trans (Ideal.le_comap_pow _ t)) ha
      rw [Ideal.mem_comap] at h3
      exact (Ideal.map_pow _ _ _).ge h3
    exact ⟨fun σ hσ a ha => hk σ hσ _ (s4 a ha), fun η a ha => hc η _ (s4 a ha)⟩
  set S : Set Γ(Z, W) := {f | ∃ i, ∃ g : Γ(Z, V i), Z.basicOpen f = Z.basicOpen g} with hSdef

  have hS : Ideal.span S = ⊤ := by
    rw [← hW.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨i, hi⟩ := hcov x
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter hW (hV i) x ⟨hx, hi⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨f, show f ∈ S by rw [hSdef]; exact ⟨i, g, hfg⟩⟩, hxf⟩
  have hloc' : ∀ f ∈ S,
      (∀ σ : Γ(Fs n, Z.basicOpen f), Scheme.Modules.Hom.app (α n) (Z.basicOpen f) σ = 0 →
        ∀ a ∈ 𝒥.ideal ⟨W, hW⟩ ^ t, (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom a • σ = 0) ∧
      (∀ η : Γ(Hs n, Z.basicOpen f), ∀ a ∈ 𝒥.ideal ⟨W, hW⟩ ^ t,
        ∃ σ : Γ(Fs n, Z.basicOpen f), Scheme.Modules.Hom.app (α n) (Z.basicOpen f) σ =
          (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom a • η) := by
    intro f hf
    rw [hSdef] at hf
    obtain ⟨i, g, hfg⟩ := hf
    exact loc (Z.basicOpen f) (Z.basicOpen_le f) i g hfg.symm

  refine ⟨fun s hs a ha => ?_, fun y a ha => ?_⟩
  · have hmem := Submodule.mem_of_span_eq_top_of_smul_pow_mem
      (⊥ : Submodule Γ(Z, W) Γ(Fs n, W)) S hS (a • s) ?_
    · exact (Submodule.mem_bot _).mp hmem
    · rintro ⟨f, hf⟩
      have h1 : Scheme.Modules.Hom.app (α n) (Z.basicOpen f)
          (((Fs n).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom s) = 0 := by
        rw [nat, hs, map_zero]
      have h2 := (hloc' f hf).1 _ h1 a ha
      rw [← resSmul] at h2
      obtain ⟨m, hm⟩ := (hF n W hW f).2 _ h2
      exact ⟨m, (Submodule.mem_bot _).mpr hm⟩
  · let L : Γ(Fs n, W) →ₗ[Γ(Z, W)] Γ(Hs n, W) :=
      { toFun := fun x => Scheme.Modules.Hom.app (α n) W x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun c x => Scheme.Modules.Hom.app_smul (α n) c x }
    have hmem := Submodule.mem_of_span_eq_top_of_smul_pow_mem (LinearMap.range L) S hS (a • y) ?_
    · obtain ⟨s, hs⟩ := LinearMap.mem_range.mp hmem
      exact ⟨s, hs⟩
    · rintro ⟨f, hf⟩
      obtain ⟨σ, hσ⟩ := (hloc' f hf).2
        (((Hs n).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom y) a ha
      rw [← resSmul] at hσ
      obtain ⟨N, τ, hτ⟩ := (hF n W hW f).1 σ
      have h1 : ((Hs n).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
          (Scheme.Modules.Hom.app (α n) W τ - f ^ N • (a • y)) = 0 := by
        rw [map_sub, ← nat, ← hτ, appSmul, hσ, resSmul (Hs n) (Z.basicOpen_le f) (f ^ N) (a • y),
          map_pow, sub_self]
      obtain ⟨M, hM⟩ := (hH n W hW f).2 _ h1
      refine ⟨M + N, LinearMap.mem_range.mpr ⟨f ^ M • τ, ?_⟩⟩
      show Scheme.Modules.Hom.app (α n) W (f ^ M • τ) = f ^ (M + N) • (a • y)
      rw [smul_sub, sub_eq_zero] at hM
      rw [appSmul, pow_add, mul_smul]
      exact hM

theorem wc_cn_chow_comparison : wcCnProjExist.{u} → wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (𝒦 : Z.IdealSheafData) (P : Scheme.{u}) (p : P ⟶ Z) (m : ℕ)
    (g : P ⟶ wcPm.{u} m) (U : Z.Opens),
    IsProper p → IsClosedImmersion (Limits.prod.lift (p ≫ h) g) →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), ∀ a ∈ 𝒦.ideal ⟨V, hV⟩, (p.app V).hom a = 0) →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), V ≤ U →
        IsAffineOpen (p ⁻¹ᵁ V) ∧ Function.Surjective (p.app V).hom ∧
        RingHom.ker (p.app V).hom = 𝒦.ideal ⟨V, hV⟩) →
    ∀ (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ → (∀ n, wcCnKilled 𝒦 (Fs n)) →
    ∃ (𝒥 : Z.IdealSheafData) (H : Z.Modules) (Hs : ℕ → Z.Modules)
      (ψH : ∀ n, Hs (n + 1) ⟶ Hs n) (φH : ∀ n, H ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n) (t : ℕ),
      (∀ (V : Z.Opens) (hV : IsAffineOpen V), V ≤ U → 𝒥.ideal ⟨V, hV⟩ = ⊤) ∧
      wcCnKilled 𝒦 H ∧ wcCnAdicSys h (IsLocalRing.maximalIdeal B) Hs ψH ∧
      wcCnAlg h (IsLocalRing.maximalIdeal B) Hs ψH H φH ∧
      (∀ n, α (n + 1) ≫ ψH n = ψ n ≫ α n) ∧ ∀ n, wcCnAlmostIso 𝒥 t (α n) :=
by
  intro hPE hFF B _ _ _ _ Z h _ 𝒦 P p m g U hp hcl hkill hiso Fs ψ hF hK
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : CompactSpace Z :=
    ⟨by simpa using QuasiCompact.isCompact_preimage (f := h) Set.univ isOpen_univ isCompact_univ⟩
  haveI : IsNoetherian Z := {}

  have hF' := wc_cn_pullback_adic_system B (IsLocalRing.maximalIdeal B) Z P h p Fs ψ hF

  obtain ⟨F'', φ'', hF''⟩ := hPE B P (p ≫ h) m g hcl _ _ hF'

  have hHcoh := wc_cn_pushforward_coherent B Z h P p m g hp hcl F'' hF''.1

  obtain ⟨Hs, ψH, φH, hHs, hHalg⟩ :=
    wc_cn_quotient_system_of_coherent B (IsLocalRing.maximalIdeal B) Z h _ hHcoh

  obtain ⟨α, hα, hR⟩ := wc_cn_comparison_map_exists hFF B Z h P p m g hp hcl Fs ψ hF F'' φ''
    hF' hF'' Hs ψH φH hHs hHalg

  obtain ⟨t, ht⟩ := wc_cn_almostIso_of_affinewise Z Fs Hs α (wcCnComplIdeal U)
    (fun n => (hF.1 n).1) (fun n => (hHs.1 n).1) (fun V hV => by
      obtain ⟨t, ht⟩ := wc_cn_comparison_limit_bound hFF B Z h 𝒦 P p m g U hp hcl hkill hiso
        Fs ψ hF hK F'' φ'' hF' hF'' Hs ψH φH hHs hHalg α hα hR V hV
      exact ⟨2 * t, wc_cn_0888_affine B _ Z h Fs ψ _ Hs ψH φH α hF hHs hHalg hα V hV _ t ht⟩)
  refine ⟨wcCnComplIdeal U, (Scheme.Modules.pushforward p).obj F'', Hs, ψH, φH, α, t,
    ?_, ?_, hHs, hHalg, hα, ht⟩
  · intro V hV hVU
    show (Scheme.IdealSheafData.vanishingIdeal _).ideal ⟨V, hV⟩ = ⊤
    rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
    convert PrimeSpectrum.vanishingIdeal_empty
    ext x
    simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]
    intro hx
    apply hx
    apply hVU
    have h1 : Set.range hV.fromSpec ⊆ (V : Set Z) := hV.range_fromSpec.le
    exact h1 ⟨x, rfl⟩
  · intro V hV a ha s
    change (p.app V a) • (show Γ(F'', p ⁻¹ᵁ V) from s) = 0
    rw [hkill V hV a ha, zero_smul]

theorem wc_cn_affine_family_local : ∀ (Z : Scheme.{u}) (M : Z.Modules) (S : ∀ V : Z.Opens, IsAffineOpen V → Submodule Γ(Z, V) Γ(M, V)), wcQcoh M → (∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V) (s : Γ(M, V)), s ∈ S V hV → (M.presheaf.map (homOfLE hWV).op).hom s ∈ S W hW) → (∀ (U : Z.Opens) (hU : IsAffineOpen U) (f : Γ(Z, U)) (s : Γ(M, Z.basicOpen f)), s ∈ S (Z.basicOpen f) (hU.basicOpen f) → ∃ (n : ℕ) (y : Γ(M, U)), y ∈ S U hU ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ n • s = (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom y) → ∀ (V : Z.Opens) (hV : IsAffineOpen V) (m : Γ(M, V)), (∀ x ∈ V, ∃ (W : Z.Opens) (hW : IsAffineOpen W) (hWV : W ≤ V), x ∈ W ∧ (M.presheaf.map (homOfLE hWV).op).hom m ∈ S W hW) → m ∈ S V hV :=
by
  intro Z M S hM hR hB V hV m hloc
  have s1 : ∀ f : Γ(Z, V), (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom m ∈
      S (Z.basicOpen f) (hV.basicOpen f) → ∃ N : ℕ, f ^ N • m ∈ S V hV := by
    intro f hf
    obtain ⟨n, y, hy, he⟩ := hB V hV f _ hf
    have hsm : (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (f ^ n • m) =
        (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (f ^ n) •
          (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom m :=
      Scheme.Modules.map_smul M (homOfLE (Z.basicOpen_le f)) (f ^ n) m
    have h0 : (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (f ^ n • m - y) = 0 := by
      rw [map_sub, hsm, map_pow, he, sub_self]
    obtain ⟨k, hk⟩ := (hM V hV f).2 _ h0
    refine ⟨k + n, ?_⟩
    rw [smul_sub, sub_eq_zero, smul_smul, ← pow_add] at hk
    rw [hk]
    exact Submodule.smul_mem _ _ hy
  have hcov : V ≤ ⨆ f : {f : Γ(Z, V) | ∃ N : ℕ, f ^ N • m ∈ S V hV},
      Z.basicOpen (f : Γ(Z, V)) := by
    intro x hx
    obtain ⟨W, hW, hWV, hxW, hmW⟩ := hloc x hx
    obtain ⟨f, hfW, hxf⟩ := hV.exists_basicOpen_le (V := W) ⟨x, hxW⟩ hx
    have hres := hR W (Z.basicOpen f) hW (hV.basicOpen f) hfW _ hmW
    have hcomp : (M.presheaf.map (homOfLE hfW).op).hom
        ((M.presheaf.map (homOfLE hWV).op).hom m) =
        (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom m := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, homOfLE_comp]
    rw [hcomp] at hres
    obtain ⟨N, hN⟩ := s1 f hres
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, N, hN⟩, hxf⟩
  exact Submodule.mem_of_span_eq_top_of_smul_pow_mem (S V hV) _
    (hV.self_le_iSup_basicOpen_iff.mp hcov) m (fun r => r.2)

theorem wc_cn_affine_family_subsheaf : ∀ (Z : Scheme.{u}) (M : Z.Modules) (S : ∀ V : Z.Opens, IsAffineOpen V → Submodule Γ(Z, V) Γ(M, V)), (∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V) (s : Γ(M, V)), s ∈ S V hV → (M.presheaf.map (homOfLE hWV).op).hom s ∈ S W hW) → (∀ (V : Z.Opens) (hV : IsAffineOpen V) (m : Γ(M, V)), (∀ x ∈ V, ∃ (W : Z.Opens) (hW : IsAffineOpen W) (hWV : W ≤ V), x ∈ W ∧ (M.presheaf.map (homOfLE hWV).op).hom m ∈ S W hW) → m ∈ S V hV) → ∃ (K : Z.Modules) (ι : K ⟶ M), Mono ι ∧ (∀ V : Z.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) ∧ ∀ (V : Z.Opens) (hV : IsAffineOpen V) (m : Γ(M, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = m) ↔ m ∈ S V hV :=
by
  intro Z M S hR hL

  have dev_pair : ∀ (X : Scheme.{u}) (G M : X.Modules) (Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop), (∀ V, Ψ V 0 0) → (∀ V g m g' m', Ψ V g m → Ψ V g' m' → Ψ V (g + g') (m + m')) → (∀ V (a : Γ(X, V)) g m, Ψ V g m → Ψ V (a • g) (a • m)) → (∀ V W (h : W ≤ V) g m, Ψ V g m → Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) → (∀ V g m, (∀ x ∈ V, ∃ (W : X.Opens) (h : W ≤ V), x ∈ W ∧ Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) → Ψ V g m) → ∃ (E : X.Modules) (α : E ⟶ G) (β : E ⟶ M), (∀ (V : X.Opens) (e e' : Γ(E, V)), Scheme.Modules.Hom.app α V e = Scheme.Modules.Hom.app α V e' → Scheme.Modules.Hom.app β V e = Scheme.Modules.Hom.app β V e' → e = e') ∧ ∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), (∃ e : Γ(E, V), Scheme.Modules.Hom.app α V e = g ∧ Scheme.Modules.Hom.app β V e = m) ↔ Ψ V g m := by
    intro X G M Ψ h0 hadd hsmul hres hloc
    classical
    let S : ∀ V : X.Opens, Submodule Γ(X, V) (Γ(G, V) × Γ(M, V)) := fun V =>
      { carrier := {p | Ψ V p.1 p.2}
        add_mem' := fun {a b} ha hb => hadd V a.1 a.2 b.1 b.2 ha hb
        zero_mem' := h0 V
        smul_mem' := fun c p hp => hsmul V c p.1 p.2 hp }
    let P : (X.Opens)ᵒᵖ ⥤ Ab.{u} :=
      { obj := fun V => AddCommGrpCat.of (S V.unop)
        map := fun {V W} i => AddCommGrpCat.ofHom
          { toFun := fun p => ⟨((G.presheaf.map i).hom p.1.1, (M.presheaf.map i).hom p.1.2),
              hres V.unop W.unop i.unop.le p.1.1 p.1.2 p.2⟩
            map_zero' := Subtype.ext (Prod.ext (map_zero _) (map_zero _))
            map_add' := fun a b => Subtype.ext (Prod.ext (map_add _ _ _) (map_add _ _ _)) }
        map_id := fun V => by
          ext p
          · change (G.presheaf.map (𝟙 V)).hom p.1.1 = p.1.1
            rw [G.presheaf.map_id]; rfl
          · change (M.presheaf.map (𝟙 V)).hom p.1.2 = p.1.2
            rw [M.presheaf.map_id]; rfl
        map_comp := fun {V W Z} i j => by
          ext p
          · change (G.presheaf.map (i ≫ j)).hom p.1.1 =
              (G.presheaf.map j).hom ((G.presheaf.map i).hom p.1.1)
            rw [G.presheaf.map_comp]; rfl
          · change (M.presheaf.map (i ≫ j)).hom p.1.2 =
              (M.presheaf.map j).hom ((M.presheaf.map i).hom p.1.2)
            rw [M.presheaf.map_comp]; rfl }
    letI inst : ∀ V : (X.Opens)ᵒᵖ, Module ↑(X.ringCatSheaf.obj.obj V) ↑(P.obj V) := fun V =>
      (inferInstance : Module Γ(X, V.unop) (S V.unop))
    let Pm : PresheafOfModules X.ringCatSheaf.obj := PresheafOfModules.ofPresheaf P (by
      intro V W f r p
      apply Subtype.ext
      exact Prod.ext (Scheme.Modules.map_smul G f.unop r p.1.1)
        (Scheme.Modules.map_smul M f.unop r p.1.2))
    have hsh : TopCat.Presheaf.IsSheaf P := by
      rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
      intro ι U sf hcompat
      let sG : ∀ i, Γ(G, U i) := fun i => (sf i).1.1
      let sM : ∀ i, Γ(M, U i) := fun i => (sf i).1.2
      have hcG : TopCat.Presheaf.IsCompatible G.presheaf U sG := by
        intro i j
        exact congrArg (fun q => q.1.1) (hcompat i j)
      have hcM : TopCat.Presheaf.IsCompatible M.presheaf U sM := by
        intro i j
        exact congrArg (fun q => q.1.2) (hcompat i j)
      obtain ⟨g, hg, huG⟩ := TopCat.Sheaf.existsUnique_gluing ⟨G.presheaf, G.isSheaf⟩ U sG hcG
      obtain ⟨m, hm, huM⟩ := TopCat.Sheaf.existsUnique_gluing ⟨M.presheaf, M.isSheaf⟩ U sM hcM
      have hΨ : Ψ (iSup U) g m := by
        apply hloc
        intro x hx
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        refine ⟨U i, le_iSup U i, hi, ?_⟩
        have e1 := hg i
        have e2 := hm i
        change (G.presheaf.map (homOfLE (le_iSup U i)).op).hom g = sG i at e1
        change (M.presheaf.map (homOfLE (le_iSup U i)).op).hom m = sM i at e2
        change Ψ (U i) ((G.presheaf.map (homOfLE (le_iSup U i)).op).hom g)
          ((M.presheaf.map (homOfLE (le_iSup U i)).op).hom m)
        rw [e1, e2]
        exact (sf i).2
      exact ⟨⟨(g, m), hΨ⟩, fun i => Subtype.ext (Prod.ext (hg i) (hm i)),
        fun t ht => Subtype.ext (Prod.ext (huG t.1.1 fun i => congrArg (fun q => q.1.1) (ht i))
          (huM t.1.2 fun i => congrArg (fun q => q.1.2) (ht i)))⟩
    let E : X.Modules := SheafOfModules.mk Pm hsh
    let φG : P ⟶ G.presheaf :=
      { app := fun V => AddCommGrpCat.ofHom
          ((LinearMap.fst Γ(X, V.unop) Γ(G, V.unop) Γ(M, V.unop)).comp
            (S V.unop).subtype).toAddMonoidHom
        naturality := fun V W i => rfl }
    let φM : P ⟶ M.presheaf :=
      { app := fun V => AddCommGrpCat.ofHom
          ((LinearMap.snd Γ(X, V.unop) Γ(G, V.unop) Γ(M, V.unop)).comp
            (S V.unop).subtype).toAddMonoidHom
        naturality := fun V W i => rfl }
    let α : E ⟶ G := ⟨PresheafOfModules.homMk (M₁ := Pm) (M₂ := G.val) φG (fun V r p => rfl)⟩
    let β : E ⟶ M := ⟨PresheafOfModules.homMk (M₁ := Pm) (M₂ := M.val) φM (fun V r p => rfl)⟩
    have hα : ∀ V (e : Γ(E, V)), Scheme.Modules.Hom.app α V e = (e : S V).1.1 := fun V e => rfl
    have hβ : ∀ V (e : Γ(E, V)), Scheme.Modules.Hom.app β V e = (e : S V).1.2 := fun V e => rfl
    refine ⟨E, α, β, ?_, ?_⟩
    · intro V e e' h1 h2
      rw [hα, hα] at h1
      rw [hβ, hβ] at h2
      exact Subtype.ext (Prod.ext h1 h2)
    · intro V g m
      constructor
      · rintro ⟨e, h1, h2⟩
        rw [hα] at h1
        rw [hβ] at h2
        subst h1 h2
        exact (e : S V).2
      · intro h
        exact ⟨(⟨(g, m), h⟩ : S V), rfl, rfl⟩

  have resc : ∀ (U V W : Z.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    have e : M.presheaf.map (homOfLE (h2.trans h1)).op =
        M.presheaf.map (homOfLE h1).op ≫ M.presheaf.map (homOfLE h2).op := by
      rw [← M.presheaf.map_comp]; rfl
    rw [e]; rfl
  have resid : ∀ (V : Z.Opens) (h : V ≤ V) (x : Γ(M, V)),
      (M.presheaf.map (homOfLE h).op).hom x = x := by
    intro V h x
    have e : M.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op V) from rfl, M.presheaf.map_id]
    rw [e]; rfl


  have h0 : ∀ W : Z.Opens, (∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
      (M.presheaf.map (homOfLE hVW).op).hom (0 : Γ(M, W)) ∈ S V hV) ∧ (0 : Γ(M, W)) = 0 := by
    intro W
    refine ⟨fun V hV hVW => ?_, rfl⟩
    rw [map_zero]
    exact (S V hV).zero_mem
  have hadd : ∀ (W : Z.Opens) (g m g' m' : Γ(M, W)),
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
        (M.presheaf.map (homOfLE hVW).op).hom g ∈ S V hV) ∧ m = 0) →
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
        (M.presheaf.map (homOfLE hVW).op).hom g' ∈ S V hV) ∧ m' = 0) →
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
        (M.presheaf.map (homOfLE hVW).op).hom (g + g') ∈ S V hV) ∧ m + m' = 0) := by
    rintro W g m g' m' ⟨hg, rfl⟩ ⟨hg', rfl⟩
    refine ⟨fun V hV hVW => ?_, add_zero 0⟩
    rw [map_add]
    exact (S V hV).add_mem (hg V hV hVW) (hg' V hV hVW)
  have hsmul : ∀ (W : Z.Opens) (a : Γ(Z, W)) (g m : Γ(M, W)),
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
        (M.presheaf.map (homOfLE hVW).op).hom g ∈ S V hV) ∧ m = 0) →
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
        (M.presheaf.map (homOfLE hVW).op).hom (a • g) ∈ S V hV) ∧ a • m = 0) := by
    rintro W a g m ⟨hg, rfl⟩
    refine ⟨fun V hV hVW => ?_, smul_zero a⟩
    have e : (M.presheaf.map (homOfLE hVW).op).hom (a • g) =
        Z.presheaf.map (homOfLE hVW).op a • (M.presheaf.map (homOfLE hVW).op).hom g :=
      Scheme.Modules.map_smul M (homOfLE hVW) a g
    rw [e]
    exact (S V hV).smul_mem _ (hg V hV hVW)
  have hres : ∀ (W W' : Z.Opens) (h : W' ≤ W) (g m : Γ(M, W)),
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
        (M.presheaf.map (homOfLE hVW).op).hom g ∈ S V hV) ∧ m = 0) →
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W'),
        (M.presheaf.map (homOfLE hVW).op).hom (M.presheaf.map (homOfLE h).op g) ∈ S V hV) ∧
        M.presheaf.map (homOfLE h).op m = 0) := by
    rintro W W' h g m ⟨hg, rfl⟩
    refine ⟨fun V hV hVW => ?_, map_zero (M.presheaf.map (homOfLE h).op).hom⟩
    change (M.presheaf.map (homOfLE hVW).op).hom ((M.presheaf.map (homOfLE h).op).hom g) ∈ S V hV
    rw [resc W W' V h hVW g]
    exact hg V hV (hVW.trans h)
  have hloc : ∀ (W : Z.Opens) (g m : Γ(M, W)),
      (∀ x ∈ W, ∃ (W' : Z.Opens) (h : W' ≤ W), x ∈ W' ∧
        ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W'),
          (M.presheaf.map (homOfLE hVW).op).hom (M.presheaf.map (homOfLE h).op g) ∈ S V hV) ∧
          M.presheaf.map (homOfLE h).op m = 0)) →
      ((∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
        (M.presheaf.map (homOfLE hVW).op).hom g ∈ S V hV) ∧ m = 0) := by
    intro W g m H
    choose Wx hWx hxW hP using H
    have hm : m = 0 := by
      refine TopCat.Sheaf.eq_of_locally_eq' ⟨M.presheaf, M.isSheaf⟩
        (fun x : W => Wx x.1 x.2) W (fun x => homOfLE (hWx x.1 x.2)) ?_ m 0 ?_
      · intro x hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxW x hx⟩
      · intro x
        exact (hP x.1 x.2).2.trans
          (map_zero (M.presheaf.map (homOfLE (hWx x.1 x.2)).op).hom).symm
    refine ⟨fun V hV hVW => ?_, hm⟩
    apply hL V hV
    intro y hy
    have hyW : y ∈ W := hVW hy
    have hyI : y ∈ V ⊓ Wx y hyW := ⟨hy, hxW y hyW⟩
    obtain ⟨V', hV'aff, hyV', hV'sub⟩ := exists_isAffineOpen_mem_and_subset hyI
    have hle : V' ≤ V ⊓ Wx y hyW := fun z hz => hV'sub hz
    have hV'V : V' ≤ V := (le_inf_iff.mp hle).1
    have hV'W : V' ≤ Wx y hyW := (le_inf_iff.mp hle).2
    refine ⟨V', hV'aff, hV'V, hyV', ?_⟩
    rw [resc W V V' hVW hV'V g]
    have h1 : (M.presheaf.map (homOfLE hV'W).op).hom
        ((M.presheaf.map (homOfLE (hWx y hyW)).op).hom g) ∈ S V' hV'aff :=
      (hP y hyW).1 V' hV'aff hV'W
    rw [resc W (Wx y hyW) V' (hWx y hyW) hV'W g] at h1
    exact h1
  obtain ⟨E, α, β, hinj2, hiff⟩ := dev_pair Z M M
    (fun W g m => (∀ (V : Z.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
      (M.presheaf.map (homOfLE hVW).op).hom g ∈ S V hV) ∧ m = 0) h0 hadd hsmul hres hloc
  have hF : ∀ (V : Z.Opens) (e : Γ(E, V)), (∀ (V' : Z.Opens) (hV' : IsAffineOpen V')
      (hVW : V' ≤ V), (M.presheaf.map (homOfLE hVW).op).hom (Scheme.Modules.Hom.app α V e) ∈
        S V' hV') ∧ Scheme.Modules.Hom.app β V e = 0 :=
    fun V e => (hiff V _ _).1 ⟨e, rfl, rfl⟩
  have hinj : ∀ V : Z.Opens, Function.Injective (Scheme.Modules.Hom.app α V) := by
    intro V e e' h
    exact hinj2 V e e' h (by rw [(hF V e).2, (hF V e').2])
  refine ⟨E, α, ?_, hinj, ?_⟩
  · constructor
    intro T a b hab
    apply Scheme.Modules.hom_ext
    intro V
    ext x
    apply hinj V
    have := congrArg (fun f => Scheme.Modules.Hom.app f V x) hab
    exact this
  · intro V hV m
    constructor
    · rintro ⟨k, rfl⟩
      have h1 := (hF V k).1 V hV le_rfl
      rwa [resid V le_rfl] at h1
    · intro hm
      obtain ⟨e, he1, -⟩ := (hiff V m 0).2 ⟨fun V' hV' hV'V => hR V V' hV hV' hV'V m hm, rfl⟩
      exact ⟨e, he1⟩

theorem wc_cn_affine_family_cokernel : ∀ (Z : Scheme.{u}) [IsNoetherian Z] (M K : Z.Modules) (ι : K ⟶ M) (S : ∀ V : Z.Opens, IsAffineOpen V → Submodule Γ(Z, V) Γ(M, V)), Mono ι → wcCoherentMod M → (∀ V : Z.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) → (∀ (V : Z.Opens) (hV : IsAffineOpen V) (m : Γ(M, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = m) ↔ m ∈ S V hV) → (∀ (U : Z.Opens) (hU : IsAffineOpen U) (f : Γ(Z, U)) (s : Γ(M, Z.basicOpen f)), s ∈ S (Z.basicOpen f) (hU.basicOpen f) → ∃ (n : ℕ) (y : Γ(M, U)), y ∈ S U hU ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ n • s = (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom y) → ∃ (Q : Z.Modules) (π : M ⟶ Q), Epi π ∧ wcCoherentMod Q ∧ (∀ (V : Z.Opens) (hV : IsAffineOpen V), Function.Surjective (Scheme.Modules.Hom.app π V) ∧ ∀ s : Γ(M, V), Scheme.Modules.Hom.app π V s = 0 ↔ s ∈ S V hV) ∧ ∀ (T : Z.Modules) (g : M ⟶ T), (∀ (V : Z.Opens) (hV : IsAffineOpen V) (s : Γ(M, V)), s ∈ S V hV → Scheme.Modules.Hom.app g V s = 0) → ∃ g' : Q ⟶ T, π ≫ g' = g :=
by
  intro Z _ M K ι S hmono hM hinj hrange hB
  have capp : ∀ {P Q R : Z.Modules} (f : P ⟶ Q) (k : Q ⟶ R) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ k) U x =
        Scheme.Modules.Hom.app k U (Scheme.Modules.Hom.app f U x) := by
    intro P Q R f k U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : Z.Modules} (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) U x = 0 := by
    intro P Q U x
    rw [Scheme.Modules.Hom.zero_app]
    rfl

  have nat : ∀ (V W : Z.Opens) (h : W ≤ V) (k : Γ(K, V)),
      Scheme.Modules.Hom.app ι W ((K.presheaf.map (homOfLE h).op).hom k) =
        (M.presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app ι V k) := by
    intro V W h k
    have e := congrArg (fun φ => φ.hom k)
      ((Scheme.Modules.Hom.mapPresheaf ι).naturality (homOfLE h).op)
    exact e

  have hK : wcCoherentMod K := by
    unfold wcCoherentMod wcQcoh
    refine ⟨fun U hU f => ⟨fun k => ?_, fun t ht => ?_⟩, fun U hU => ?_⟩
    · have hk : Scheme.Modules.Hom.app ι (Z.basicOpen f) k ∈
          S (Z.basicOpen f) (hU.basicOpen f) := (hrange _ _ _).1 ⟨k, rfl⟩
      obtain ⟨n, y, hy, hfy⟩ := hB U hU f _ hk
      obtain ⟨k', rfl⟩ := (hrange U hU y).2 hy
      refine ⟨n, k', hinj _ ?_⟩
      rw [Scheme.Modules.Hom.app_smul, hfy]
      exact (nat _ _ _ k').symm
    · have h1 : (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
          (Scheme.Modules.Hom.app ι U t) = 0 := by
        rw [← nat, ht, map_zero]
      obtain ⟨n, hn⟩ := (hM.1 U hU f).2 _ h1
      refine ⟨n, hinj U ?_⟩
      rw [Scheme.Modules.Hom.app_smul, hn, map_zero]
    · haveI : IsNoetherianRing Γ(Z, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
      haveI : Module.Finite Γ(Z, U) Γ(M, U) := hM.2 U hU
      haveI : IsNoetherian Γ(Z, U) Γ(M, U) := isNoetherian_of_isNoetherianRing_of_finite _ _
      exact Module.Finite.of_injective (wcCnJaAppL ι U) (hinj U)

  obtain ⟨hSES, hQcoh, -, -⟩ := wc_dev_cokernel_coh Z K M ι hmono hK hM
  refine ⟨Limits.cokernel ι, Limits.cokernel.π ι, inferInstance, hQcoh, ?_, ?_⟩

  · intro V hV
    refine ⟨wc_modules_ses_affine_surj Z _ hSES hK.1 V hV, fun s => ⟨fun hs => ?_, fun hs => ?_⟩⟩
    · obtain ⟨x, hx⟩ := (wc_modules_ses_left_exact Z _ hSES).2 V s hs
      exact (hrange V hV s).1 ⟨x, hx⟩
    · obtain ⟨k, rfl⟩ := (hrange V hV s).2 hs
      rw [← capp, Limits.cokernel.condition, zapp]

  · intro T g hg
    have h0 : ι ≫ g = 0 := by
      apply wc_cn_modules_hom_ext_affine
      intro U hU x
      rw [capp, zapp]
      exact hg U hU _ ((hrange U hU _).1 ⟨x, rfl⟩)
    exact ⟨Limits.cokernel.desc ι g h0, Limits.cokernel.π_desc ι g h0⟩

theorem wc_cn_ideal_family_smul_compat : ∀ (Z : Scheme.{u}) (I : ∀ V : Z.Opens, IsAffineOpen V → Ideal Γ(Z, V)), (∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V), Ideal.map (Z.presheaf.map (homOfLE hWV).op).hom (I V hV) = I W hW) → ∀ (M : Z.Modules), (∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V) (s : Γ(M, V)), s ∈ I V hV • (⊤ : Submodule Γ(Z, V) Γ(M, V)) → (M.presheaf.map (homOfLE hWV).op).hom s ∈ I W hW • (⊤ : Submodule Γ(Z, W) Γ(M, W))) ∧ (wcQcoh M → ∀ (U : Z.Opens) (hU : IsAffineOpen U) (f : Γ(Z, U)) (s : Γ(M, Z.basicOpen f)), s ∈ I (Z.basicOpen f) (hU.basicOpen f) • (⊤ : Submodule Γ(Z, Z.basicOpen f) Γ(M, Z.basicOpen f)) → ∃ (n : ℕ) (y : Γ(M, U)), y ∈ I U hU • (⊤ : Submodule Γ(Z, U) Γ(M, U)) ∧ ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ n • s = (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom y) :=
by
  intro Z I hC M
  refine ⟨?_, ?_⟩
  ·
    intro V W hV hW hWV s hs
    refine Submodule.smul_induction_on hs (fun c hc m _ => ?_) (fun a b ha hb => ?_)
    · rw [Scheme.Modules.map_smul M (homOfLE hWV) c m]
      have hc' : (Z.presheaf.map (homOfLE hWV).op).hom c ∈ I W hW := by
        rw [← hC V W hV hW hWV]
        exact Ideal.mem_map_of_mem _ hc
      exact Submodule.smul_mem_smul hc' Submodule.mem_top
    · rw [map_add]
      exact Submodule.add_mem _ ha hb
  ·
    intro hM U hU f s hs
    set ρ := (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom with hρ
    set ρM := (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom with hρM
    have hmapsmul : ∀ (a : Γ(Z, U)) (x : Γ(M, U)), ρM (a • x) = ρ a • ρM x := fun a x =>
      Scheme.Modules.map_smul M (homOfLE (Z.basicOpen_le f)) a x
    obtain ⟨qa, _⟩ := hM U hU f
    let P : Γ(M, Z.basicOpen f) → Prop := fun x =>
      ∃ (n : ℕ) (y : Γ(M, U)), y ∈ I U hU • (⊤ : Submodule Γ(Z, U) Γ(M, U)) ∧
        ρ f ^ n • x = ρM y
    have P0 : P 0 := ⟨0, 0, Submodule.zero_mem _, by rw [smul_zero, map_zero]⟩
    have Padd : ∀ x x', P x → P x' → P (x + x') := by
      rintro x x' ⟨n, z, hz, hx⟩ ⟨m, z', hz', hx'⟩
      refine ⟨n + m, f ^ m • z + f ^ n • z', Submodule.add_mem _ (Submodule.smul_mem _ _ hz)
        (Submodule.smul_mem _ _ hz'), ?_⟩
      rw [map_add, hmapsmul, hmapsmul, map_pow, map_pow, ← hx, ← hx', smul_add, smul_smul,
        smul_smul, ← pow_add, ← pow_add, add_comm m n]
    have hID : I (Z.basicOpen f) (hU.basicOpen f) = Ideal.map ρ (I U hU) :=
      (hC U (Z.basicOpen f) hU (hU.basicOpen f) (Z.basicOpen_le f)).symm
    have Pgen : ∀ c ∈ Ideal.map ρ (I U hU), ∀ m, P (c • m) := by
      intro c hc
      induction hc using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨b, hb, rfl⟩ := hx
        intro m
        obtain ⟨N, t, ht⟩ := qa m
        refine ⟨N, b • t, Submodule.smul_mem_smul hb Submodule.mem_top, ?_⟩
        rw [hmapsmul, ← ht, smul_comm]
      | zero => intro m; rw [zero_smul]; exact P0
      | add x x' _ _ hx hx' => intro m; rw [add_smul]; exact Padd _ _ (hx m) (hx' m)
      | smul a x _ hx =>
        intro m
        rw [smul_eq_mul, mul_comm, mul_smul]
        exact hx (a • m)
    rw [hID] at hs
    exact Submodule.smul_induction_on (p := P) hs (fun c hc m _ => Pgen c hc m) Padd

theorem wc_cn_088A_quot_layers : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) [IsNoetherian Z] (h : Z ⟶ Spec (.of B)) (𝒦 𝒥 : Z.IdealSheafData)
    (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ → (∀ n, wcCnKilled 𝒦 (Fs n)) →
    ∀ (Hs : ℕ → Z.Modules) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n) (t : ℕ),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Hs ψH →
    (∀ n, α (n + 1) ≫ ψH n = ψ n ≫ α n) → (∀ n, wcCnAlmostIso 𝒥 t (α n)) →
    Nonempty (wcCn088AQuot h (IsLocalRing.maximalIdeal B) 𝒦 𝒥 Fs ψ Hs ψH α) :=
by
  intro B _ _ _ Z _ h 𝒦 𝒥 Fs ψ hF hK Hs ψH α t hH hα hαi

  have capp : ∀ {P Q R : Z.Modules} (f : P ⟶ Q) (k : Q ⟶ R) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ k) U x =
        Scheme.Modules.Hom.app k U (Scheme.Modules.Hom.app f U x) := by
    intro P Q R f k U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have smapp : ∀ {P Q : Z.Modules} (f : P ⟶ Q) (U : Z.Opens) (r : Γ(Z, U)) (x : Γ(P, U)),
      Scheme.Modules.Hom.app f U (r • x) = r • Scheme.Modules.Hom.app f U x :=
    fun f U r x => Scheme.Modules.Hom.app_smul f r x
  have hsmul : ∀ {P Q : Z.Modules} (f : P ⟶ Q) (U : Z.Opens) (J : Ideal Γ(Z, U)) (x : Γ(P, U)),
      x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(P, U)) →
        Scheme.Modules.Hom.app f U x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U)) := by
    intro P Q f U J x hx
    refine Submodule.smul_induction_on
      (p := fun y => Scheme.Modules.Hom.app f U y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))) hx ?_ ?_
    · intro r hr y _
      show Scheme.Modules.Hom.app f U (r • y) ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [smapp]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro y y' hy hy'
      show Scheme.Modules.Hom.app f U (y + y') ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [map_add]
      exact Submodule.add_mem _ hy hy'

  have vanish : ∀ {P Q : Z.Modules} (p : P ⟶ Q) (V : Z.Opens) (𝔞 : Ideal Γ(Z, V)),
      Function.Surjective (Scheme.Modules.Hom.app p V) →
      (∀ x ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(P, V)), Scheme.Modules.Hom.app p V x = 0) →
      𝔞 • (⊤ : Submodule Γ(Z, V) Γ(Q, V)) = ⊥ := by
    intro P Q p V 𝔞 hs hk
    rw [eq_bot_iff]
    intro m hm
    rw [Submodule.mem_bot]
    refine Submodule.smul_induction_on (p := fun m => m = 0) hm ?_ ?_
    · intro r hr q _
      obtain ⟨x, rfl⟩ := hs q
      show r • Scheme.Modules.Hom.app p V x = 0
      rw [← smapp]
      exact hk _ (Submodule.smul_mem_smul hr Submodule.mem_top)
    · intro x y hx hy
      show x + y = 0
      rw [hx, hy, add_zero]

  have tower : ∀ {M N1 N0 : Z.Modules} (p1 : M ⟶ N1) (p0 : M ⟶ N0) (τ : N1 ⟶ N0) (V : Z.Opens)
      (𝔞 : Ideal Γ(Z, V)), p1 ≫ τ = p0 → Function.Surjective (Scheme.Modules.Hom.app p1 V) →
      (Function.Surjective (Scheme.Modules.Hom.app p0 V) ∧ ∀ x, Scheme.Modules.Hom.app p0 V x = 0 ↔
        x ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M, V))) →
      (Function.Surjective (Scheme.Modules.Hom.app τ V) ∧ ∀ s, Scheme.Modules.Hom.app τ V s = 0 ↔
        s ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(N1, V))) ∧ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(N0, V)) = ⊥ := by
    intro M N1 N0 p1 p0 τ V 𝔞 hcomm hp1s hp0
    obtain ⟨hp0s, hp0k⟩ := hp0
    have happ : ∀ x, Scheme.Modules.Hom.app τ V (Scheme.Modules.Hom.app p1 V x) =
        Scheme.Modules.Hom.app p0 V x := by
      intro x
      rw [← capp, hcomm]
    have hN0 : 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(N0, V)) = ⊥ :=
      vanish p0 V 𝔞 hp0s (fun x hx => (hp0k x).2 hx)
    refine ⟨⟨?_, fun s => ⟨fun hs => ?_, fun hs => ?_⟩⟩, hN0⟩
    · intro y
      obtain ⟨x, rfl⟩ := hp0s y
      exact ⟨_, happ x⟩
    · obtain ⟨x, rfl⟩ := hp1s s
      rw [happ] at hs
      exact hsmul p1 V 𝔞 x ((hp0k x).1 hs)
    · have h1 := hsmul τ V 𝔞 s hs
      rw [hN0] at h1
      exact (Submodule.mem_bot _).1 h1

  have layer : ∀ {M1 M0 N1 N0 : Z.Modules} (ψ0 : M1 ⟶ M0) (p1 : M1 ⟶ N1) (p0 : M0 ⟶ N0)
      (ψ' : N1 ⟶ N0) (V : Z.Opens) (𝔞 𝔟 : Ideal Γ(Z, V)), p1 ≫ ψ' = ψ0 ≫ p0 →
      (Function.Surjective (Scheme.Modules.Hom.app ψ0 V) ∧ ∀ x, Scheme.Modules.Hom.app ψ0 V x = 0 ↔
        x ∈ 𝔟 • (⊤ : Submodule Γ(Z, V) Γ(M1, V))) →
      𝔟 • (⊤ : Submodule Γ(Z, V) Γ(M0, V)) = ⊥ →
      (Function.Surjective (Scheme.Modules.Hom.app p1 V) ∧ ∀ x, Scheme.Modules.Hom.app p1 V x = 0 ↔
        x ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M1, V))) →
      (Function.Surjective (Scheme.Modules.Hom.app p0 V) ∧ ∀ x, Scheme.Modules.Hom.app p0 V x = 0 ↔
        x ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M0, V))) →
      (Function.Surjective (Scheme.Modules.Hom.app ψ' V) ∧ ∀ s, Scheme.Modules.Hom.app ψ' V s = 0 ↔
        s ∈ 𝔟 • (⊤ : Submodule Γ(Z, V) Γ(N1, V))) ∧ 𝔟 • (⊤ : Submodule Γ(Z, V) Γ(N0, V)) = ⊥ := by
    intro M1 M0 N1 N0 ψ0 p1 p0 ψ' V 𝔞 𝔟 hcomm hψ0 hb hp1 hp0
    obtain ⟨hψs, hψk⟩ := hψ0
    obtain ⟨hp1s, hp1k⟩ := hp1
    obtain ⟨hp0s, hp0k⟩ := hp0
    have happ : ∀ x, Scheme.Modules.Hom.app ψ' V (Scheme.Modules.Hom.app p1 V x) =
        Scheme.Modules.Hom.app p0 V (Scheme.Modules.Hom.app ψ0 V x) := by
      intro x
      rw [← capp, hcomm, capp]
    have hN0 : 𝔟 • (⊤ : Submodule Γ(Z, V) Γ(N0, V)) = ⊥ := by
      refine vanish p0 V 𝔟 hp0s (fun x hx => ?_)
      have h1 : x ∈ (⊥ : Submodule Γ(Z, V) Γ(M0, V)) := hb ▸ hx
      rw [(Submodule.mem_bot _).1 h1, map_zero]
    refine ⟨⟨?_, fun s => ⟨fun hs => ?_, fun hs => ?_⟩⟩, hN0⟩
    · intro y
      obtain ⟨m, rfl⟩ := hp0s y
      obtain ⟨x, rfl⟩ := hψs m
      exact ⟨_, happ x⟩
    · obtain ⟨x, rfl⟩ := hp1s s
      rw [happ] at hs
      have h1 := (hp0k _).1 hs
      have hlift : ∀ y ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M0, V)),
          ∃ z ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M1, V)), Scheme.Modules.Hom.app ψ0 V z = y := by
        intro y hy
        refine Submodule.smul_induction_on (p := fun y => ∃ z ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M1, V)),
          Scheme.Modules.Hom.app ψ0 V z = y) hy ?_ ?_
        · intro r hr m _
          obtain ⟨w, rfl⟩ := hψs m
          exact ⟨r • w, Submodule.smul_mem_smul hr Submodule.mem_top, smapp ψ0 V r w⟩
        · rintro y1 y2 ⟨z1, hz1, rfl⟩ ⟨z2, hz2, rfl⟩
          exact ⟨z1 + z2, Submodule.add_mem _ hz1 hz2, map_add _ z1 z2⟩
      obtain ⟨z, hz, hzx⟩ := hlift _ h1
      have hxz : x - z ∈ 𝔟 • (⊤ : Submodule Γ(Z, V) Γ(M1, V)) := by
        apply (hψk _).1
        rw [map_sub, hzx, sub_self]
      have hpz : Scheme.Modules.Hom.app p1 V z = 0 := (hp1k z).2 hz
      have e1 : Scheme.Modules.Hom.app p1 V x = Scheme.Modules.Hom.app p1 V (x - z) := by
        rw [map_sub, hpz, sub_zero]
      rw [e1]
      exact hsmul p1 V 𝔟 _ hxz
    · have h1 := hsmul ψ' V 𝔟 s hs
      rw [hN0] at h1
      exact (Submodule.mem_bot _).1 h1

  have almost : ∀ {M N M' N' : Z.Modules} (f : M ⟶ N) (f' : M' ⟶ N') (p : M ⟶ M') (q : N ⟶ N')
      (V : Z.Opens) (I 𝔞 : Ideal Γ(Z, V)) (t0 : ℕ), p ≫ f' = f ≫ q →
      (Function.Surjective (Scheme.Modules.Hom.app p V) ∧ ∀ x, Scheme.Modules.Hom.app p V x = 0 ↔
        x ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M, V))) →
      (Function.Surjective (Scheme.Modules.Hom.app q V) ∧ ∀ y, Scheme.Modules.Hom.app q V y = 0 ↔
        y ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(N, V))) →
      ((∀ x, Scheme.Modules.Hom.app f V x = 0 → ∀ a ∈ I ^ t0, a • x = 0) ∧
        (∀ y, ∀ a ∈ I ^ t0, ∃ x, Scheme.Modules.Hom.app f V x = a • y)) →
      (∀ x', Scheme.Modules.Hom.app f' V x' = 0 → ∀ a ∈ I ^ (2 * t0), a • x' = 0) ∧
        (∀ y', ∀ a ∈ I ^ (2 * t0), ∃ x', Scheme.Modules.Hom.app f' V x' = a • y') := by
    intro M N M' N' f f' p q V I 𝔞 t0 hcomm hp hq hf
    obtain ⟨hps, hpk⟩ := hp
    obtain ⟨hqs, hqk⟩ := hq
    obtain ⟨hfk, hfc⟩ := hf
    have happ : ∀ x, Scheme.Modules.Hom.app f' V (Scheme.Modules.Hom.app p V x) =
        Scheme.Modules.Hom.app q V (Scheme.Modules.Hom.app f V x) := by
      intro x
      rw [← capp, hcomm, capp]
    have hle : I ^ (2 * t0) ≤ I ^ t0 := Ideal.pow_le_pow_right (by omega)
    refine ⟨fun x' hx' => ?_, fun y' a ha => ?_⟩
    · obtain ⟨x, rfl⟩ := hps x'
      rw [happ] at hx'
      have h1 := (hqk _).1 hx'
      have claim : ∀ c ∈ I ^ t0, ∃ w ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M, V)),
          c • Scheme.Modules.Hom.app f V x = Scheme.Modules.Hom.app f V w := by
        intro c hc
        refine Submodule.smul_induction_on (p := fun y => ∃ w ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(M, V)),
          c • y = Scheme.Modules.Hom.app f V w) h1 ?_ ?_
        · intro r hr m _
          obtain ⟨z, hz⟩ := hfc m c hc
          refine ⟨r • z, Submodule.smul_mem_smul hr Submodule.mem_top, ?_⟩
          rw [smapp, hz, smul_smul, smul_smul, mul_comm]
        · rintro y1 y2 ⟨w1, hw1, e1⟩ ⟨w2, hw2, e2⟩
          exact ⟨w1 + w2, Submodule.add_mem _ hw1 hw2, by rw [smul_add, e1, e2, map_add]⟩
      have hprod : ∀ b ∈ I ^ t0, ∀ c ∈ I ^ t0, (b * c) • Scheme.Modules.Hom.app p V x = 0 := by
        intro b hb c hc
        obtain ⟨w, hw, hcw⟩ := claim c hc
        have h2 : Scheme.Modules.Hom.app f V (c • x - w) = 0 := by
          rw [map_sub, smapp, hcw, sub_self]
        have h3 := hfk _ h2 b hb
        rw [smul_sub, sub_eq_zero, smul_smul] at h3
        rw [← smapp]
        apply (hpk _).2
        rw [h3]
        exact Submodule.smul_mem _ b hw
      intro a ha
      have hI : I ^ (2 * t0) ≤ LinearMap.ker
          (LinearMap.toSpanSingleton Γ(Z, V) Γ(M', V) (Scheme.Modules.Hom.app p V x)) := by
        rw [two_mul, pow_add, Ideal.mul_le]
        intro b hb c hc
        rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
        exact hprod b hb c hc
      have hmem := hI ha
      rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] at hmem
      exact hmem
    · obtain ⟨y, rfl⟩ := hqs y'
      obtain ⟨x, hx⟩ := hfc y a (hle ha)
      exact ⟨Scheme.Modules.Hom.app p V x, by rw [happ, hx, smapp]⟩

  have hQ : ∀ (M : Z.Modules), wcCoherentMod M → ∀ k : ℕ, ∃ (Q : Z.Modules) (π : M ⟶ Q),
      Epi π ∧ wcCoherentMod Q ∧
      (∀ (V : Z.Opens) (hV : IsAffineOpen V), Function.Surjective (Scheme.Modules.Hom.app π V) ∧
        ∀ s : Γ(M, V), Scheme.Modules.Hom.app π V s = 0 ↔
          s ∈ (𝒥.ideal ⟨V, hV⟩ ^ k) • (⊤ : Submodule Γ(Z, V) Γ(M, V))) ∧
      ∀ (T : Z.Modules) (g : M ⟶ T), (∀ (V : Z.Opens) (hV : IsAffineOpen V) (s : Γ(M, V)),
        s ∈ (𝒥.ideal ⟨V, hV⟩ ^ k) • (⊤ : Submodule Γ(Z, V) Γ(M, V)) →
          Scheme.Modules.Hom.app g V s = 0) → ∃ g' : Q ⟶ T, π ≫ g' = g := by
    intro M hM k
    have hC : ∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V),
        Ideal.map (Z.presheaf.map (homOfLE hWV).op).hom (𝒥.ideal ⟨V, hV⟩ ^ k) =
          𝒥.ideal ⟨W, hW⟩ ^ k := by
      intro V W hV hW hWV
      rw [Ideal.map_pow]
      exact congrArg (· ^ k) (𝒥.map_ideal (U := ⟨W, hW⟩) (V := ⟨V, hV⟩) hWV)
    obtain ⟨hR, hB⟩ := wc_cn_ideal_family_smul_compat Z (fun V hV => 𝒥.ideal ⟨V, hV⟩ ^ k) hC M
    have hL := wc_cn_affine_family_local Z M
      (fun V hV => (𝒥.ideal ⟨V, hV⟩ ^ k) • (⊤ : Submodule Γ(Z, V) Γ(M, V))) hM.1 hR (hB hM.1)
    obtain ⟨K, ι, hmono, hinj, hrange⟩ := wc_cn_affine_family_subsheaf Z M
      (fun V hV => (𝒥.ideal ⟨V, hV⟩ ^ k) • (⊤ : Submodule Γ(Z, V) Γ(M, V))) hR hL
    exact wc_cn_affine_family_cokernel Z M K ι
      (fun V hV => (𝒥.ideal ⟨V, hV⟩ ^ k) • (⊤ : Submodule Γ(Z, V) Γ(M, V)))
      hmono hM hinj hrange (hB hM.1)

  choose Fq pF hpFepi hFqcoh hpFsec hpFuniv using fun e n => hQ (Fs n) (hF.1 n) (e + 1)
  choose Hq pH hpHepi hHqcoh hpHsec hpHuniv using fun e n => hQ (Hs n) (hH.1 n) (e + 1)
  have hle : ∀ (P : Z.Modules) (V : Z.Opens) (hV : IsAffineOpen V) (e : ℕ) (s : Γ(P, V)),
      s ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1 + 1)) • (⊤ : Submodule Γ(Z, V) Γ(P, V)) →
        s ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1)) • (⊤ : Submodule Γ(Z, V) Γ(P, V)) :=
    fun P V hV e s hs => Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega)) hs

  have exτF : ∀ e n, ∃ τ : Fq (e + 1) n ⟶ Fq e n, pF (e + 1) n ≫ τ = pF e n := fun e n =>
    hpFuniv (e + 1) n (Fq e n) (pF e n)
      (fun V hV s hs => ((hpFsec e n V hV).2 s).2 (hle _ V hV e s hs))
  choose τF hτF using exτF
  have exτH : ∀ e n, ∃ τ : Hq (e + 1) n ⟶ Hq e n, pH (e + 1) n ≫ τ = pH e n := fun e n =>
    hpHuniv (e + 1) n (Hq e n) (pH e n)
      (fun V hV s hs => ((hpHsec e n V hV).2 s).2 (hle _ V hV e s hs))
  choose τH hτH using exτH
  have exψq : ∀ e n, ∃ τ : Fq e (n + 1) ⟶ Fq e n, pF e (n + 1) ≫ τ = ψ n ≫ pF e n := fun e n =>
    hpFuniv e (n + 1) (Fq e n) (ψ n ≫ pF e n) (fun V hV s hs => by
      rw [capp]
      exact ((hpFsec e n V hV).2 _).2 (hsmul (ψ n) V _ s hs))
  choose ψq hψq using exψq
  have exψHq : ∀ e n, ∃ τ : Hq e (n + 1) ⟶ Hq e n, pH e (n + 1) ≫ τ = ψH n ≫ pH e n := fun e n =>
    hpHuniv e (n + 1) (Hq e n) (ψH n ≫ pH e n) (fun V hV s hs => by
      rw [capp]
      exact ((hpHsec e n V hV).2 _).2 (hsmul (ψH n) V _ s hs))
  choose ψHq hψHq using exψHq
  have exαq : ∀ e n, ∃ τ : Fq e n ⟶ Hq e n, pF e n ≫ τ = α n ≫ pH e n := fun e n =>
    hpFuniv e n (Hq e n) (α n ≫ pH e n) (fun V hV s hs => by
      rw [capp]
      exact ((hpHsec e n V hV).2 _).2 (hsmul (α n) V _ s hs))
  choose αq hαq using exαq

  have hτF' : ∀ e n {W : Z.Modules} (k : Fq e n ⟶ W), pF (e + 1) n ≫ τF e n ≫ k = pF e n ≫ k :=
    fun e n W k => by rw [← Category.assoc, hτF]
  have hτH' : ∀ e n {W : Z.Modules} (k : Hq e n ⟶ W), pH (e + 1) n ≫ τH e n ≫ k = pH e n ≫ k :=
    fun e n W k => by rw [← Category.assoc, hτH]
  have hψq' : ∀ e n {W : Z.Modules} (k : Fq e n ⟶ W),
      pF e (n + 1) ≫ ψq e n ≫ k = ψ n ≫ pF e n ≫ k :=
    fun e n W k => by rw [← Category.assoc, hψq, Category.assoc]
  have hψHq' : ∀ e n {W : Z.Modules} (k : Hq e n ⟶ W),
      pH e (n + 1) ≫ ψHq e n ≫ k = ψH n ≫ pH e n ≫ k :=
    fun e n W k => by rw [← Category.assoc, hψHq, Category.assoc]
  have hαq' : ∀ e n {W : Z.Modules} (k : Hq e n ⟶ W),
      pF e n ≫ αq e n ≫ k = α n ≫ pH e n ≫ k :=
    fun e n W k => by rw [← Category.assoc, hαq, Category.assoc]
  have hα' : ∀ n {W : Z.Modules} (k : Hs n ⟶ W), α (n + 1) ≫ ψH n ≫ k = ψ n ≫ α n ≫ k :=
    fun n W k => by rw [← Category.assoc, hα, Category.assoc]

  have sqτF : ∀ e n, τF e (n + 1) ≫ ψq e n = ψq (e + 1) n ≫ τF e n := by
    intro e n
    apply (hpFepi (e + 1) (n + 1)).left_cancellation
    rw [hτF' e (n + 1), hψq e n, hψq' (e + 1) n, hτF e n]
  have sqτH : ∀ e n, τH e (n + 1) ≫ ψHq e n = ψHq (e + 1) n ≫ τH e n := by
    intro e n
    apply (hpHepi (e + 1) (n + 1)).left_cancellation
    rw [hτH' e (n + 1), hψHq e n, hψHq' (e + 1) n, hτH e n]
  have sqαψ : ∀ e n, αq e (n + 1) ≫ ψHq e n = ψq e n ≫ αq e n := by
    intro e n
    apply (hpFepi e (n + 1)).left_cancellation
    rw [hαq' e (n + 1), hψHq e n, hα' n, hψq' e n, hαq e n]
  have sqατ : ∀ e n, αq (e + 1) n ≫ τH e n = τF e n ≫ αq e n := by
    intro e n
    apply (hpFepi (e + 1) n).left_cancellation
    rw [hαq' (e + 1) n, hτH e n, hτF' e n, hαq e n]

  exact ⟨{
    Fq := Fq
    pF := pF
    τF := τF
    ψq := ψq
    Hq := Hq
    pH := pH
    τH := τH
    ψHq := ψHq
    αq := αq
    c := 2 * t
    Fq_adic := fun e => ⟨fun n => hFqcoh e n,
      fun n U hU => (layer (ψ n) (pF e (n + 1)) (pF e n) (ψq e n) U _ _ (hψq e n)
        (hF.2.1 n U hU) (hF.2.2 n U hU) (hpFsec e (n + 1) U hU) (hpFsec e n U hU)).1,
      fun n U hU => (layer (ψ n) (pF e (n + 1)) (pF e n) (ψq e n) U _ _ (hψq e n)
        (hF.2.1 n U hU) (hF.2.2 n U hU) (hpFsec e (n + 1) U hU) (hpFsec e n U hU)).2⟩
    Hq_adic := fun e => ⟨fun n => hHqcoh e n,
      fun n U hU => (layer (ψH n) (pH e (n + 1)) (pH e n) (ψHq e n) U _ _ (hψHq e n)
        (hH.2.1 n U hU) (hH.2.2 n U hU) (hpHsec e (n + 1) U hU) (hpHsec e n U hU)).1,
      fun n U hU => (layer (ψH n) (pH e (n + 1)) (pH e n) (ψHq e n) U _ _ (hψHq e n)
        (hH.2.1 n U hU) (hH.2.2 n U hU) (hpHsec e (n + 1) U hU) (hpHsec e n U hU)).2⟩
    Fq_jadic := fun n => ⟨fun e => hFqcoh e n,
      fun e V hV => (tower (pF (e + 1) n) (pF e n) (τF e n) V _ (hτF e n)
        (hpFsec (e + 1) n V hV).1 (hpFsec e n V hV)).1,
      fun e V hV => (tower (pF (e + 1) n) (pF e n) (τF e n) V _ (hτF e n)
        (hpFsec (e + 1) n V hV).1 (hpFsec e n V hV)).2⟩
    Hq_jadic := fun n => ⟨fun e => hHqcoh e n,
      fun e V hV => (tower (pH (e + 1) n) (pH e n) (τH e n) V _ (hτH e n)
        (hpHsec (e + 1) n V hV).1 (hpHsec e n V hV)).1,
      fun e V hV => (tower (pH (e + 1) n) (pH e n) (τH e n) V _ (hτH e n)
        (hpHsec (e + 1) n V hV).1 (hpHsec e n V hV)).2⟩
    pF_jalg := fun n => ⟨hF.1 n, fun e => hτF e n, fun e V hV => hpFsec e n V hV⟩
    pH_jalg := fun n => ⟨hH.1 n, fun e => hτH e n, fun e V hV => hpHsec e n V hV⟩
    Fq_killed := by
      intro e n V hV a ha s
      obtain ⟨x, rfl⟩ := (hpFsec e n V hV).1 s
      rw [← smapp, hK n V hV a ha x, map_zero]
    pF_ψ := hψq
    pH_ψ := hψHq
    τF_ψ := sqτF
    τH_ψ := sqτH
    pF_α := hαq
    αq_ψ := sqαψ
    αq_τ := sqατ
    αq_almost := fun e n V hV => almost (α n) (αq e n) (pF e n) (pH e n) V _ _ t (hαq e n)
      (hpFsec e n V hV) (hpHsec e n V hV) (hαi n V hV) }⟩

theorem wc_cn_biprod_coherent : ∀ (Z : Scheme.{u}) (A C : Z.Modules), wcCoherentMod A →
    wcCoherentMod C → wcCoherentMod (Limits.biprod A C) :=
by
  intro Z A C hA hC
  have capp : ∀ {P Q R : Z.Modules} (g : P ⟶ Q) (k : Q ⟶ R) (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (g ≫ k) V x =
        Scheme.Modules.Hom.app k V (Scheme.Modules.Hom.app g V x) := by
    intro P Q R g k V x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have iapp : ∀ {P : Z.Modules} (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (𝟙 P) V x = x := by
    intro P V x
    rw [Scheme.Modules.Hom.id_app]
    rfl
  have aapp : ∀ {P Q : Z.Modules} (g g' : P ⟶ Q) (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (g + g') V x =
        Scheme.Modules.Hom.app g V x + Scheme.Modules.Hom.app g' V x := by
    intro P Q g g' V x
    rw [Scheme.Modules.Hom.add_app]
    rfl
  have dec : ∀ (V : Z.Opens) (x : Γ(Limits.biprod A C, V)),
      x = Scheme.Modules.Hom.app Limits.biprod.inl V
            (Scheme.Modules.Hom.app Limits.biprod.fst V x) +
          Scheme.Modules.Hom.app Limits.biprod.inr V
            (Scheme.Modules.Hom.app Limits.biprod.snd V x) := by
    intro V x
    rw [← capp, ← capp, ← aapp, Limits.biprod.total, iapp]
  have dec0 : ∀ (V : Z.Opens) (x : Γ(Limits.biprod A C, V)),
      Scheme.Modules.Hom.app Limits.biprod.fst V x = 0 →
      Scheme.Modules.Hom.app Limits.biprod.snd V x = 0 → x = 0 := by
    intro V x h1 h2
    rw [dec V x, h1, h2, map_zero, map_zero, add_zero]
  refine ⟨fun U hU f => ?_, fun U hU => ?_⟩
  · have nat : ∀ {P Q : Z.Modules} (g : P ⟶ Q) (x : Γ(P, U)),
        Scheme.Modules.Hom.app g (Z.basicOpen f)
            ((P.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom x) =
          (Q.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
            (Scheme.Modules.Hom.app g U x) := by
      intro P Q g x
      exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g)
        (homOfLE (Z.basicOpen_le f)).op x
    have rsmul : ∀ {P : Z.Modules} (r : Γ(Z, U)) (x : Γ(P, U)),
        (P.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (r • x) =
          (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom r •
            (P.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom x := by
      intro P r x
      exact Scheme.Modules.map_smul P _ r x
    refine ⟨fun s => ?_, fun t ht => ?_⟩
    · obtain ⟨n₁, t₁, ht₁⟩ := (hA.1 U hU f).1 (Scheme.Modules.Hom.app Limits.biprod.fst _ s)
      obtain ⟨n₂, t₂, ht₂⟩ := (hC.1 U hU f).1 (Scheme.Modules.Hom.app Limits.biprod.snd _ s)
      refine ⟨n₁ + n₂, f ^ n₂ • Scheme.Modules.Hom.app Limits.biprod.inl U t₁ +
        f ^ n₁ • Scheme.Modules.Hom.app Limits.biprod.inr U t₂, ?_⟩
      rw [map_add, rsmul, rsmul, ← nat, ← nat, ← ht₁, ← ht₂, map_pow, map_pow,
        Scheme.Modules.Hom.app_smul, Scheme.Modules.Hom.app_smul, smul_smul, smul_smul,
        ← pow_add, ← pow_add, add_comm n₂ n₁, ← smul_add, ← dec]
    · have h1 : (A.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
          (Scheme.Modules.Hom.app Limits.biprod.fst U t) = 0 := by
        rw [← nat, ht, map_zero]
      have h2 : (C.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
          (Scheme.Modules.Hom.app Limits.biprod.snd U t) = 0 := by
        rw [← nat, ht, map_zero]
      obtain ⟨m₁, hm₁⟩ := (hA.1 U hU f).2 _ h1
      obtain ⟨m₂, hm₂⟩ := (hC.1 U hU f).2 _ h2
      refine ⟨m₁ + m₂, dec0 U _ ?_ ?_⟩
      · rw [Scheme.Modules.Hom.app_smul, add_comm, pow_add, mul_smul, hm₁, smul_zero]
      · rw [Scheme.Modules.Hom.app_smul, pow_add, mul_smul, hm₂, smul_zero]
  · haveI : Module.Finite Γ(Z, U) Γ(A, U) := hA.2 U hU
    haveI : Module.Finite Γ(Z, U) Γ(C, U) := hC.2 U hU
    refine Module.Finite.of_surjective
      ((wcCnSecLin (Limits.biprod.inl : A ⟶ Limits.biprod A C) U).coprod
        (wcCnSecLin (Limits.biprod.inr : C ⟶ Limits.biprod A C) U)) ?_
    intro x
    refine ⟨(Scheme.Modules.Hom.app Limits.biprod.fst U x,
      Scheme.Modules.Hom.app Limits.biprod.snd U x), ?_⟩
    rw [LinearMap.coprod_apply]
    exact (dec U x).symm

theorem wc_cn_biprod_alg : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) (As Cs : ℕ → Z.Modules) (ψA : ∀ n, As (n + 1) ⟶ As n)
    (ψC : ∀ n, Cs (n + 1) ⟶ Cs n) (A C : Z.Modules) (φA : ∀ n, A ⟶ As n) (φC : ∀ n, C ⟶ Cs n),
    wcCnAdicSys h I As ψA → wcCnAlg h I As ψA A φA → wcCnAdicSys h I Cs ψC →
    wcCnAlg h I Cs ψC C φC → wcCoherentMod (Limits.biprod A C) →
    (∀ n, wcCoherentMod (Limits.biprod (As n) (Cs n))) →
    wcCnAdicSys h I (fun n => Limits.biprod (As n) (Cs n))
      (fun n => Limits.biprod.map (ψA n) (ψC n)) ∧
    wcCnAlg h I (fun n => Limits.biprod (As n) (Cs n)) (fun n => Limits.biprod.map (ψA n) (ψC n))
      (Limits.biprod A C) (fun n => Limits.biprod.map (φA n) (φC n)) :=
by
  intro B _ I Z h As Cs ψA ψC A C φA φC hA hAalg hC hCalg hP hPs
  have capp : ∀ {P Q R : Z.Modules} (g : P ⟶ Q) (k : Q ⟶ R) (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (g ≫ k) V x =
        Scheme.Modules.Hom.app k V (Scheme.Modules.Hom.app g V x) := by
    intro P Q R g k V x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have iapp : ∀ {P : Z.Modules} (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (𝟙 P) V x = x := by
    intro P V x
    rw [Scheme.Modules.Hom.id_app]
    rfl
  have aapp : ∀ {P Q : Z.Modules} (g g' : P ⟶ Q) (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (g + g') V x =
        Scheme.Modules.Hom.app g V x + Scheme.Modules.Hom.app g' V x := by
    intro P Q g g' V x
    rw [Scheme.Modules.Hom.add_app]
    rfl
  have zapp : ∀ {P Q : Z.Modules} (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) V x = 0 := by
    intro P Q V x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have dec : ∀ {X Y : Z.Modules} (V : Z.Opens) (x : Γ(Limits.biprod X Y, V)),
      x = Scheme.Modules.Hom.app (Limits.biprod.inl : X ⟶ Limits.biprod X Y) V
            (Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X Y ⟶ X) V x) +
          Scheme.Modules.Hom.app (Limits.biprod.inr : Y ⟶ Limits.biprod X Y) V
            (Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X Y ⟶ Y) V x) := by
    intro X Y V x
    rw [← capp, ← capp, ← aapp, Limits.biprod.total, iapp]
  have pr11 : ∀ {X Y : Z.Modules} (V : Z.Opens) (y : Γ(X, V)),
      Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X Y ⟶ X) V
        (Scheme.Modules.Hom.app (Limits.biprod.inl : X ⟶ Limits.biprod X Y) V y) = y := by
    intro X Y V y
    rw [← capp, Limits.biprod.inl_fst, iapp]
  have pr12 : ∀ {X Y : Z.Modules} (V : Z.Opens) (y : Γ(X, V)),
      Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X Y ⟶ Y) V
        (Scheme.Modules.Hom.app (Limits.biprod.inl : X ⟶ Limits.biprod X Y) V y) = 0 := by
    intro X Y V y
    rw [← capp, Limits.biprod.inl_snd, zapp]
  have pr21 : ∀ {X Y : Z.Modules} (V : Z.Opens) (y : Γ(Y, V)),
      Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X Y ⟶ X) V
        (Scheme.Modules.Hom.app (Limits.biprod.inr : Y ⟶ Limits.biprod X Y) V y) = 0 := by
    intro X Y V y
    rw [← capp, Limits.biprod.inr_fst, zapp]
  have pr22 : ∀ {X Y : Z.Modules} (V : Z.Opens) (y : Γ(Y, V)),
      Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X Y ⟶ Y) V
        (Scheme.Modules.Hom.app (Limits.biprod.inr : Y ⟶ Limits.biprod X Y) V y) = y := by
    intro X Y V y
    rw [← capp, Limits.biprod.inr_snd, iapp]
  have m1 : ∀ {X Y X' Y' : Z.Modules} (u : X ⟶ X') (v : Y ⟶ Y') (V : Z.Opens)
      (x : Γ(Limits.biprod X Y, V)),
      Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X' Y' ⟶ X') V
        (Scheme.Modules.Hom.app (Limits.biprod.map u v) V x) =
      Scheme.Modules.Hom.app u V
        (Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X Y ⟶ X) V x) := by
    intro X Y X' Y' u v V x
    rw [← capp, ← capp, Limits.biprod.map_fst]
  have m2 : ∀ {X Y X' Y' : Z.Modules} (u : X ⟶ X') (v : Y ⟶ Y') (V : Z.Opens)
      (x : Γ(Limits.biprod X Y, V)),
      Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X' Y' ⟶ Y') V
        (Scheme.Modules.Hom.app (Limits.biprod.map u v) V x) =
      Scheme.Modules.Hom.app v V
        (Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X Y ⟶ Y) V x) := by
    intro X Y X' Y' u v V x
    rw [← capp, ← capp, Limits.biprod.map_snd]
  have sub : ∀ {P Q : Z.Modules} (g : P ⟶ Q) (V : Z.Opens) (𝔫 : Ideal Γ(Z, V)) (s : Γ(P, V)),
      s ∈ 𝔫 • (⊤ : Submodule Γ(Z, V) Γ(P, V)) →
      Scheme.Modules.Hom.app g V s ∈ 𝔫 • (⊤ : Submodule Γ(Z, V) Γ(Q, V)) := by
    intro P Q g V 𝔫 s hs
    refine Submodule.smul_induction_on hs ?_ ?_
    · intro r hr n _
      rw [Scheme.Modules.Hom.app_smul]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy

  have s1 : ∀ {X Y X' Y' : Z.Modules} (u : X ⟶ X') (v : Y ⟶ Y') (U : Z.Opens)
      (𝔫 : Ideal Γ(Z, U)),
      Function.Surjective (Scheme.Modules.Hom.app u U) →
      (∀ s : Γ(X, U), Scheme.Modules.Hom.app u U s = 0 ↔
        s ∈ 𝔫 • (⊤ : Submodule Γ(Z, U) Γ(X, U))) →
      Function.Surjective (Scheme.Modules.Hom.app v U) →
      (∀ s : Γ(Y, U), Scheme.Modules.Hom.app v U s = 0 ↔
        s ∈ 𝔫 • (⊤ : Submodule Γ(Z, U) Γ(Y, U))) →
      Function.Surjective (Scheme.Modules.Hom.app (Limits.biprod.map u v) U) ∧
      ∀ s : Γ(Limits.biprod X Y, U), Scheme.Modules.Hom.app (Limits.biprod.map u v) U s = 0 ↔
        s ∈ 𝔫 • (⊤ : Submodule Γ(Z, U) Γ(Limits.biprod X Y, U)) := by
    intro X Y X' Y' u v U 𝔫 hu hku hv hkv
    refine ⟨fun z => ?_, fun s => ?_⟩
    · obtain ⟨x₁, hx₁⟩ := hu (Scheme.Modules.Hom.app
        (Limits.biprod.fst : Limits.biprod X' Y' ⟶ X') U z)
      obtain ⟨x₂, hx₂⟩ := hv (Scheme.Modules.Hom.app
        (Limits.biprod.snd : Limits.biprod X' Y' ⟶ Y') U z)
      refine ⟨Scheme.Modules.Hom.app (Limits.biprod.inl : X ⟶ Limits.biprod X Y) U x₁ +
        Scheme.Modules.Hom.app (Limits.biprod.inr : Y ⟶ Limits.biprod X Y) U x₂, ?_⟩
      have h1 : Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X' Y' ⟶ X') U
          (Scheme.Modules.Hom.app (Limits.biprod.map u v) U
            (Scheme.Modules.Hom.app (Limits.biprod.inl : X ⟶ Limits.biprod X Y) U x₁ +
              Scheme.Modules.Hom.app (Limits.biprod.inr : Y ⟶ Limits.biprod X Y) U x₂)) =
          Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X' Y' ⟶ X') U z := by
        rw [m1 u v, map_add, pr11, pr21, add_zero, hx₁]
      have h2 : Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X' Y' ⟶ Y') U
          (Scheme.Modules.Hom.app (Limits.biprod.map u v) U
            (Scheme.Modules.Hom.app (Limits.biprod.inl : X ⟶ Limits.biprod X Y) U x₁ +
              Scheme.Modules.Hom.app (Limits.biprod.inr : Y ⟶ Limits.biprod X Y) U x₂)) =
          Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X' Y' ⟶ Y') U z := by
        rw [m2 u v, map_add, pr12, pr22, zero_add, hx₂]
      rw [dec U (Scheme.Modules.Hom.app (Limits.biprod.map u v) U
        (Scheme.Modules.Hom.app (Limits.biprod.inl : X ⟶ Limits.biprod X Y) U x₁ +
          Scheme.Modules.Hom.app (Limits.biprod.inr : Y ⟶ Limits.biprod X Y) U x₂)), h1, h2]
      exact (dec U z).symm
    · have hk : Scheme.Modules.Hom.app (Limits.biprod.map u v) U s = 0 ↔
          Scheme.Modules.Hom.app u U
            (Scheme.Modules.Hom.app (Limits.biprod.fst : Limits.biprod X Y ⟶ X) U s) = 0 ∧
          Scheme.Modules.Hom.app v U
            (Scheme.Modules.Hom.app (Limits.biprod.snd : Limits.biprod X Y ⟶ Y) U s) = 0 := by
        constructor
        · intro h0
          refine ⟨?_, ?_⟩
          · rw [← m1 u v, h0, map_zero]
          · rw [← m2 u v, h0, map_zero]
        · rintro ⟨h1, h2⟩
          rw [dec U (Scheme.Modules.Hom.app (Limits.biprod.map u v) U s), m1 u v, m2 u v, h1, h2,
            map_zero, map_zero, add_zero]
      rw [hk, hku, hkv]
      constructor
      · rintro ⟨h1, h2⟩
        rw [dec U s]
        exact Submodule.add_mem _ (sub _ U 𝔫 _ h1) (sub _ U 𝔫 _ h2)
      · intro hs
        exact ⟨sub _ U 𝔫 s hs, sub _ U 𝔫 s hs⟩

  have s2 : ∀ {X Y : Z.Modules} (U : Z.Opens) (𝔫 : Ideal Γ(Z, U)),
      𝔫 • (⊤ : Submodule Γ(Z, U) Γ(X, U)) = ⊥ → 𝔫 • (⊤ : Submodule Γ(Z, U) Γ(Y, U)) = ⊥ →
      𝔫 • (⊤ : Submodule Γ(Z, U) Γ(Limits.biprod X Y, U)) = ⊥ := by
    intro X Y U 𝔫 hX hY
    rw [eq_bot_iff]
    intro s hs
    rw [Submodule.mem_bot]
    have h1 := sub (Limits.biprod.fst : Limits.biprod X Y ⟶ X) U 𝔫 s hs
    have h2 := sub (Limits.biprod.snd : Limits.biprod X Y ⟶ Y) U 𝔫 s hs
    rw [hX, Submodule.mem_bot] at h1
    rw [hY, Submodule.mem_bot] at h2
    rw [dec U s, h1, h2, map_zero, map_zero, add_zero]
  obtain ⟨_, hAψ, hAkill⟩ := hA
  obtain ⟨_, hCψ, hCkill⟩ := hC
  obtain ⟨_, hAcomp, hAφ⟩ := hAalg
  obtain ⟨_, hCcomp, hCφ⟩ := hCalg
  refine ⟨⟨hPs, fun n U hU => ?_, fun n U hU => ?_⟩, ⟨hP, fun n => ?_, fun n U hU => ?_⟩⟩
  · exact s1 (ψA n) (ψC n) U _ (hAψ n U hU).1 (hAψ n U hU).2 (hCψ n U hU).1 (hCψ n U hU).2
  · exact s2 U _ (hAkill n U hU) (hCkill n U hU)
  · show Limits.biprod.map (φA (n + 1)) (φC (n + 1)) ≫ Limits.biprod.map (ψA n) (ψC n) =
      Limits.biprod.map (φA n) (φC n)
    apply Limits.biprod.hom_ext
    · simp only [Category.assoc, Limits.biprod.map_fst, Limits.biprod.map_fst_assoc, hAcomp]
    · simp only [Category.assoc, Limits.biprod.map_snd, Limits.biprod.map_snd_assoc, hCcomp]
  · exact s1 (φA n) (φC n) U _ (hAφ n U hU).1 (hAφ n U hU).2 (hCφ n U hU).1 (hCφ n U hU).2

theorem wc_cn_formal_multilin_lift : (∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (I : Ideal R)
      (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] (k : ℕ), ∃ c : ℕ,
      ∀ (N : ℕ) (β : MultilinearMap R (fun _ : Fin k => M) M),
        (∀ x, β x ∈ I ^ (N + c) • (⊤ : Submodule R M)) →
          β ∈ I ^ N • (⊤ : Submodule R (MultilinearMap R (fun _ : Fin k => M) M))) →
    (∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (I : Ideal R)
      (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] (k : ℕ), ∃ c : ℕ,
