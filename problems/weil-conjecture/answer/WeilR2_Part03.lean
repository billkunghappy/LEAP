import WeilR2_Part02
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_affine_stage_finite_surjective : ∀ (Y W Z : Scheme.{u}) (π : W ⟶ Y) [IsIntegralHom π] (p : Z ⟶ Y) [IsAffineHom p] (r : W ⟶ Z) (hr : r ≫ p = π), (∀ V : Y.Opens, IsAffineOpen V → Function.Injective (r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom) → (∀ V : Y.Opens, IsAffineOpen V → ∃ T : Finset Γ(W, π ⁻¹ᵁ V), (↑T : Set Γ(W, π ⁻¹ᵁ V)) ⊆ Set.range (r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom ∧ ∀ a ∈ Set.range (r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom, ∃ c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, V), a = ∑ t ∈ T, (π.app V).hom (c t) * t) → IsFinite p ∧ Function.Surjective r :=
by
  intro Y W Z π _ p _ r hr hinj hspan
  subst hr
  classical

  have key : ∀ (V : Y.Opens) (a : Γ(Y, V)),
      ((r ≫ p).app V).hom a =
        (r.appLE (p ⁻¹ᵁ V) ((r ≫ p) ⁻¹ᵁ V) le_rfl).hom ((p.app V).hom a) := by
    intro V a
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.comp_appLE]
    rfl

  have ring_lemma : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C]
      (φ : A →+* B) (ρ : B →+* C), Function.Injective ρ → ∀ (T : Finset C),
      (↑T : Set C) ⊆ Set.range ρ →
      (∀ a ∈ Set.range ρ, ∃ c : C → A, a = ∑ t ∈ T, ρ (φ (c t)) * t) → φ.Finite := by
    intro A B C _ _ _ φ ρ hρ T hT hsp
    letI := φ.toAlgebra
    show Module.Finite A B
    rw [Module.finite_def]
    refine ⟨T.image (Function.invFun ρ), ?_⟩
    rw [eq_top_iff]
    intro b _
    obtain ⟨c, hc⟩ := hsp (ρ b) ⟨b, rfl⟩
    have hb : b = ∑ t ∈ T, c t • Function.invFun ρ t := by
      apply hρ
      rw [hc, map_sum]
      refine Finset.sum_congr rfl (fun t ht => ?_)
      rw [Algebra.smul_def, map_mul, RingHom.algebraMap_toAlgebra, Function.invFun_eq (hT ht)]
    rw [hb]
    refine Submodule.sum_mem _ (fun t ht => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
    exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ ht)

  have hfin : IsFinite p := by
    refine IsFinite.mk (fun V hV => ?_)
    obtain ⟨T, hT, hTs⟩ := hspan V hV
    refine ring_lemma (p.app V).hom (r.appLE (p ⁻¹ᵁ V) ((r ≫ p) ⁻¹ᵁ V) le_rfl).hom
      (hinj V hV) T hT ?_
    intro a ha
    obtain ⟨c, hc⟩ := hTs a ha
    exact ⟨c, hc.trans (Finset.sum_congr rfl fun t _ => congrArg (· * t) (key V (c t)))⟩

  have hsurj : Function.Surjective r := by
    intro z
    obtain ⟨V, hV, hzV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show p z ∈ (⊤ : Y.Opens) from trivial)
    have hpV : IsAffineOpen (p ⁻¹ᵁ V) := hV.preimage p
    have hπV : IsAffineOpen ((r ≫ p) ⁻¹ᵁ V) := hV.preimage (r ≫ p)
    have hint : (r.appLE (p ⁻¹ᵁ V) ((r ≫ p) ⁻¹ᵁ V) le_rfl).hom.IsIntegral := by
      have h1 : ((r ≫ p).app V).hom.IsIntegral := IsIntegralHom.isIntegral_app _ V hV
      have h2 : ((r ≫ p).app V).hom =
          (r.appLE (p ⁻¹ᵁ V) ((r ≫ p) ⁻¹ᵁ V) le_rfl).hom.comp (p.app V).hom := by
        ext a
        exact key V a
      rw [h2] at h1
      exact RingHom.IsIntegral.tower_top _ _ h1
    have hcs := RingHom.IsIntegral.comap_surjective hint (hinj V hV)
    have hz : z ∈ Set.range hpV.fromSpec := by
      rw [hpV.range_fromSpec]
      exact hzV
    obtain ⟨q, hq⟩ := hz
    obtain ⟨q', hq'⟩ := hcs q
    let x : ↥(Spec Γ(W, (r ≫ p) ⁻¹ᵁ V)) := q'
    have hx : (Spec.map (r.appLE (p ⁻¹ᵁ V) ((r ≫ p) ⁻¹ᵁ V) le_rfl)) x = q := hq'
    refine ⟨hπV.fromSpec x, ?_⟩
    have hsq := IsAffineOpen.SpecMap_appLE_fromSpec r hpV hπV le_rfl
    rw [← Scheme.Hom.comp_apply, ← hsq, Scheme.Hom.comp_apply, hx, hq]
  exact ⟨hfin, hsurj⟩

theorem wc_integral_finite_stage : ∀ (Y W : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (π : W ⟶ Y) [IsIntegralHom π] (J : Type) [Finite J] (Vs : J → Y.Opens), (∀ i, IsAffineOpen (Vs i)) → ∀ (w : ∀ i, Γ(W, π ⁻¹ᵁ Vs i)), ∃ (Z : Scheme.{u}) (p : Z ⟶ Y) (r : W ⟶ Z) (_ : IsFinite p) (hr : r ≫ p = π), Function.Surjective r ∧ (∀ V' : Y.Opens, IsAffineOpen V' → Function.Injective (r.appLE (p ⁻¹ᵁ V') (π ⁻¹ᵁ V') (by rw [← hr]; exact le_rfl)).hom) ∧ ∀ i, w i ∈ Set.range (r.appLE (p ⁻¹ᵁ Vs i) (π ⁻¹ᵁ Vs i) (by rw [← hr]; exact le_rfl)).hom :=
by
  intro Y W _ _ π _ J _ Vs hVs w
  classical

  have hsys : ∀ (V : Y.Opens), IsAffineOpen V → ∀ x : Γ(W, π ⁻¹ᵁ V),
      ∃ 𝒜 : ∀ V' : Y.Opens, Set Γ(W, π ⁻¹ᵁ V'), wcFSys π ⊤ 𝒜 ∧ x ∈ 𝒜 V := by
    intro V hV x
    obtain ⟨𝒢, hG, hx⟩ := wc_fsys_single_generator Y W π V hV x
    obtain ⟨𝒜, h𝒜, hag⟩ := wc_fsys_extend Y W π V hV.isCompact 𝒢 hG
    exact ⟨𝒜, h𝒜, (hag V hV le_rfl x).mpr hx⟩

  have hfold : ∀ s : Finset J, ∃ 𝒜 : ∀ V' : Y.Opens, Set Γ(W, π ⁻¹ᵁ V'),
      wcFSys π ⊤ 𝒜 ∧ ∀ i ∈ s, w i ∈ 𝒜 (Vs i) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      obtain ⟨𝒜, h𝒜, -⟩ := hsys ⊥ (isAffineOpen_bot Y) 0
      exact ⟨𝒜, h𝒜, fun i hi => absurd hi (Finset.notMem_empty i)⟩
    | insert a s ha ih =>
      obtain ⟨𝒜₁, h₁, hw₁⟩ := ih
      obtain ⟨𝒜₂, h₂, hw₂⟩ := hsys (Vs a) (hVs a) (w a)
      obtain ⟨𝒜, h𝒜, hincl⟩ := wc_fsys_join Y W π ⊤ 𝒜₁ 𝒜₂ h₁ h₂
      refine ⟨𝒜, h𝒜, fun i hi => ?_⟩
      rcases Finset.mem_insert.mp hi with h | hi'
      · subst h
        exact (hincl (Vs i) (hVs i) le_top).2 hw₂
      · exact (hincl (Vs i) (hVs i) le_top).1 (hw₁ i hi')
  haveI := Fintype.ofFinite J
  obtain ⟨𝒜, h𝒜, hw⟩ := hfold Finset.univ

  obtain ⟨Z, p, r, hr, hpaff, hZ⟩ := wc_fsys_to_scheme Y W π 𝒜 h𝒜
  haveI := hpaff

  have hspan : ∀ V : Y.Opens, IsAffineOpen V → ∃ T : Finset Γ(W, π ⁻¹ᵁ V),
      (↑T : Set Γ(W, π ⁻¹ᵁ V)) ⊆
        Set.range (r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom ∧
      ∀ a ∈ Set.range (r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom,
        ∃ c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, V), a = ∑ t ∈ T, (π.app V).hom (c t) * t := by
    intro V hV
    obtain ⟨T, hT, hTspan⟩ := (h𝒜.1 V hV le_top).2.2
    exact ⟨T, fun t ht => ((hZ V hV).2 t).mpr (hT ht),
      fun a ha => hTspan a (((hZ V hV).2 a).mp ha)⟩
  obtain ⟨hfin, hsurj⟩ := wc_affine_stage_finite_surjective Y W Z π p r hr
    (fun V hV => (hZ V hV).1) hspan
  exact ⟨Z, p, r, hfin, hr, hsurj, fun V hV => (hZ V hV).1,
    fun i => ((hZ (Vs i) (hVs i)).2 (w i)).mpr (hw i (Finset.mem_univ i))⟩

theorem wc_finite_stage_open_immersion : ∀ (X W Y Z : Scheme.{u}) (π : W ⟶ Y) (p : Z ⟶ Y) [IsAffineHom π] [IsAffineHom p] (r : W ⟶ Z) (hr : r ≫ p = π) (OY : Y.Opens), IsAffineOpen OY → Function.Injective (r.appLE (p ⁻¹ᵁ OY) (π ⁻¹ᵁ OY) (by rw [← hr]; exact le_rfl)).hom → ∀ (n : ℕ) (t : Fin n → Γ(W, π ⁻¹ᵁ OY)), (∀ l, t l ∈ Set.range (r.appLE (p ⁻¹ᵁ OY) (π ⁻¹ᵁ OY) (by rw [← hr]; exact le_rfl)).hom) → (∀ x : Γ(W, π ⁻¹ᵁ OY), ∃ c : Fin n → Γ(Y, OY), x = ∑ l, (π.appLE OY (π ⁻¹ᵁ OY) le_rfl).hom (c l) * t l) → ∀ (j : X ⟶ W), IsOpenImmersion j → Set.range j = π ⁻¹' (OY : Set Y) → IsOpenImmersion (j ≫ r) ∧ Set.range (j ≫ r) = p ⁻¹' (OY : Set Y) :=
by
  intro X W Y Z π p _ _ r hr OY hOY hinj n t ht hgen j hj hjr
  subst hr
  have := hj
  have e : (r ≫ p) ⁻¹ᵁ OY ≤ r ⁻¹ᵁ (p ⁻¹ᵁ OY) := le_rfl
  have hcomp : ∀ a : Γ(Y, OY),
      (r.appLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e).hom ((p.appLE OY (p ⁻¹ᵁ OY) le_rfl).hom a)
        = ((r ≫ p).appLE OY ((r ≫ p) ⁻¹ᵁ OY) le_rfl).hom a := by
    intro a
    exact congrArg (fun g => g.hom a)
      (Scheme.Hom.appLE_comp_appLE r p OY (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) le_rfl e)
  have hsurj : Function.Surjective (r.appLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e).hom := by
    intro x
    obtain ⟨c, hc⟩ := hgen x
    choose b hb using ht
    refine ⟨∑ l, (p.appLE OY (p ⁻¹ᵁ OY) le_rfl).hom (c l) * b l, ?_⟩
    rw [map_sum, hc]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul, hcomp, hb]
  have hbij : Function.Bijective (r.appLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e).hom :=
    ⟨hinj, hsurj⟩
  have hU : IsAffineOpen (p ⁻¹ᵁ OY) := IsAffineHom.isAffine_preimage _ hOY
  have hV : IsAffineOpen ((r ≫ p) ⁻¹ᵁ OY) := IsAffineHom.isAffine_preimage _ hOY
  haveI : IsAffine (p ⁻¹ᵁ OY).toScheme := hU
  haveI : IsAffine ((r ≫ p) ⁻¹ᵁ OY).toScheme := hV
  have hbij' : Function.Bijective
      (Scheme.Hom.appTop (r.resLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e)).hom := by
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    refine (Scheme.Hom.appLE_congr _ _ rfl (Scheme.Hom.preimage_top _)
      (fun f => Function.Bijective f.hom)).mpr ?_
    rw [Scheme.Hom.resLE_appLE]
    refine (Scheme.Hom.appLE_congr _ _ (Scheme.Opens.ι_image_top _) (Scheme.Opens.ι_image_top _)
      (fun f => Function.Bijective f.hom)).mpr ?_
    exact hbij
  haveI : IsIso (Spec.map (Scheme.Hom.appTop
      (r.resLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e))) := (isIso_SpecMap_iff).mpr hbij'
  haveI hiso : IsIso (r.resLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e) := by
    have hnat := Scheme.isoSpec_hom_naturality (r.resLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e)
    have heq : r.resLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) le_rfl =
        (Scheme.isoSpec _).hom ≫ Spec.map (Scheme.Hom.appTop
          (r.resLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e)) ≫ (Scheme.isoSpec _).inv := by
      rw [← Category.assoc, hnat, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [heq]
    infer_instance
  have hjr' : Set.range j = Set.range ((r ≫ p) ⁻¹ᵁ OY).ι := by
    rw [hjr, Scheme.Opens.range_ι]
    rfl
  obtain ⟨κ, hκ⟩ : ∃ κ : X ≅ ((r ≫ p) ⁻¹ᵁ OY).toScheme, κ.hom ≫ ((r ≫ p) ⁻¹ᵁ OY).ι = j :=
    ⟨_, IsOpenImmersion.isoOfRangeEq_hom_fac j ((r ≫ p) ⁻¹ᵁ OY).ι hjr'⟩
  have hfac : j ≫ r = (κ.hom ≫
      r.resLE (p ⁻¹ᵁ OY) ((r ≫ p) ⁻¹ᵁ OY) e) ≫ (p ⁻¹ᵁ OY).ι := by
    rw [← hκ, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
  rw [hfac]
  refine ⟨inferInstance, ?_⟩
  have hrange : ∀ {A B C : Scheme.{u}} (g : A ⟶ B) [IsIso g] (h : B ⟶ C),
      Set.range (g ≫ h) = Set.range h := by
    intro A B C g _ h
    ext z
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨g x, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨y, rfl⟩
      refine ⟨inv g y, ?_⟩
      rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply (inv g), IsIso.inv_hom_id]
      rfl
  rw [hrange, Scheme.Opens.range_ι]
  rfl

theorem wc_et_split_finite_model : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of R)) [QuasiCompact fY] [QuasiSeparated fY] (U V : Y.Etale), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → ∀ y : Y, ∃ (Z : Scheme.{u}) (p : Z ⟶ Y) (_ : IsFinite p) (O : Z.Opens) (E : Set Y), y ∈ E ∧ Topology.IsConstructible E ∧ E ⊆ p '' (O : Set Z) ∧ ∃ (k : ℕ) (ua : Fin k → ((O : Scheme.{u}) ⟶ U.left)) (hu : ∀ a, ua a ≫ U.hom = O.ι ≫ p), (∀ a, IsOpenImmersion (Limits.pullback.lift (ua a) O.ι (hu a))) ∧ ∃ Θ : Fin k → Set ↥(Limits.pullback U.hom p), (∀ a, IsClopen (Θ a)) ∧ (∀ x, ∃! a, x ∈ Θ a) ∧ (∀ a, Set.range (Limits.pullback.lift (ua a) O.ι (hu a)) = Θ a ∩ (Limits.pullback.snd U.hom p) ⁻¹' (O : Set Z)) ∧ ∃ (k' : ℕ) (vb : Fin k' → ((O : Scheme.{u}) ⟶ V.left)) (hv : ∀ b, vb b ≫ V.hom = O.ι ≫ p), (∀ b, IsOpenImmersion (Limits.pullback.lift (vb b) O.ι (hv b))) ∧ (∀ (b b' : Fin k') (z z' : (O : Scheme.{u})), Limits.pullback.lift (vb b) O.ι (hv b) z = Limits.pullback.lift (vb b') O.ι (hv b') z' → b = b') ∧ (∀ x : ↥(Limits.pullback V.hom p), Limits.pullback.snd V.hom p x ∈ (O : Set Z) → ∃ (b : Fin k') (z : (O : Scheme.{u})), Limits.pullback.lift (vb b) O.ι (hv b) z = x) :=
by
  intro R _ Y fY _ _ U V hU1 hU2 hV1 hV2 y
  classical
  haveI hYc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace fY
  haveI hYq : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated fY

  have hrange_comp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C),
      Set.range (f ≫ g) = g '' Set.range f := by
    intro A B C f g
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨f a, ⟨a, rfl⟩, (Scheme.Hom.comp_apply f g a).symm⟩
    · rintro ⟨b, ⟨a, rfl⟩, rfl⟩
      exact ⟨a, Scheme.Hom.comp_apply f g a⟩

  obtain ⟨OY, hOY, E', εO, hεO, hyE, hEc, k, ua, hu, hgu, hudisj, hucov,
    k', vb, hv, hgv, hvdisj, hvcov⟩ := wc_split_stratum_cover Y U V hU1 hU2 hV1 hV2 y
  haveI := hεO
  haveI : IsAffine (OY : Scheme.{u}) := hOY
  haveI hqc : QuasiCompact (εO ≫ OY.ι) := inferInstance
  haveI hqs : QuasiSeparated (εO ≫ OY.ι) := inferInstance

  obtain ⟨hιo, hιr, hιd, n, t, ht⟩ :=
    wc_normalization_iso_over_finite_locus E' Y (εO ≫ OY.ι) OY hOY εO hεO rfl

  have hGpart : ∀ x : ↥(Limits.pullback U.hom (εO ≫ OY.ι)),
      ∃! a, x ∈ Set.range (Limits.pullback.lift (ua a) (𝟙 E') (hu a)) := by
    intro x
    obtain ⟨a, e, he⟩ := hucov x
    refine ⟨a, ⟨e, he⟩, ?_⟩
    rintro a' ⟨e', he'⟩
    exact hudisj a' a e' e (he'.trans he.symm)
  have hGopen : ∀ a, IsOpen (Set.range (Limits.pullback.lift (ua a) (𝟙 E') (hu a))) := by
    intro a
    haveI := hgu a
    exact IsOpenImmersion.isOpen_range _
  have hGclopen : ∀ a, IsClopen (Set.range (Limits.pullback.lift (ua a) (𝟙 E') (hu a))) := by
    intro a
    refine ⟨?_, hGopen a⟩
    have hc : (Set.range (Limits.pullback.lift (ua a) (𝟙 E') (hu a)))ᶜ =
        ⋃ b ∈ {b | b ≠ a}, Set.range (Limits.pullback.lift (ua b) (𝟙 E') (hu b)) := by
      ext x
      simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_setOf_eq, exists_prop]
      constructor
      · intro hx
        obtain ⟨b, hb, -⟩ := hGpart x
        refine ⟨b, fun h => ?_, hb⟩
        subst h
        exact hx hb
      · rintro ⟨b, hba, hb⟩ hx
        exact hba ((hGpart x).unique hb hx)
    rw [← isOpen_compl_iff, hc]
    exact isOpen_biUnion (fun b _ => hGopen b)

  obtain ⟨Ω, hΩc, hΩp, hΩj⟩ := wc_normalization_clopen_extension E' Y (εO ≫ OY.ι) hιo hιd U k
    (fun a => Set.range (Limits.pullback.lift (ua a) (𝟙 E') (hu a))) hGclopen hGpart

  obtain ⟨nV, Vs, hVs, w, hdesc⟩ := wc_clopen_partition_descends_finite_stage Y
    (εO ≫ OY.ι).normalization (εO ≫ OY.ι).fromNormalization U hU1 k Ω hΩc hΩp

  obtain ⟨Z, p, r, hp, hr, hrs, hri, hrw⟩ := wc_integral_finite_stage Y
    (εO ≫ OY.ι).normalization (εO ≫ OY.ι).fromNormalization (Fin nV ⊕ Fin n)
    (Sum.elim Vs (fun _ => OY))
    (fun i => match i with
      | Sum.inl i => hVs i
      | Sum.inr _ => hOY)
    (fun i => match i with
      | Sum.inl i => w i
      | Sum.inr l => t l)
  haveI := hp
  obtain ⟨Θ, hΘc, hΘp, hΘpre⟩ := hdesc Z p r hr hrs hri (fun i => hrw (Sum.inl i))

  obtain ⟨hOi, hOr⟩ := wc_finite_stage_open_immersion E' (εO ≫ OY.ι).normalization Y Z
    (εO ≫ OY.ι).fromNormalization p r hr OY hOY (hri OY hOY) n t (fun l => hrw (Sum.inr l)) ht
    (εO ≫ OY.ι).toNormalization hιo hιr

  obtain ⟨i, hi⟩ : ∃ i : E' ⟶ Z, i = (εO ≫ OY.ι).toNormalization ≫ r := ⟨_, rfl⟩
  rw [← hi] at hOi hOr
  haveI := hOi
  have hip : i ≫ p = εO ≫ OY.ι := by
    rw [hi, Category.assoc, hr, Scheme.Hom.toNormalization_fromNormalization]
  obtain ⟨O, κ, hκ, hOset⟩ : ∃ (O : Z.Opens) (κ : E' ≅ (O : Scheme.{u})),
      κ.hom ≫ O.ι = i ∧ (O : Set Z) = Set.range i :=
    ⟨Scheme.Hom.opensRange i, Scheme.Hom.isoOpensRange i, Scheme.Hom.isoOpensRange_hom_ι i,
      Scheme.Hom.coe_opensRange i⟩
  have hOι : O.ι = κ.inv ≫ i := by rw [← hκ, Iso.inv_hom_id_assoc]
  have hinv : Set.range κ.inv = Set.univ :=
    Set.eq_univ_of_forall (fun x => ⟨κ.hom x, Scheme.hom_inv_apply κ x⟩)
  have hn : ∀ T : Y.Etale, ∃ nT : Limits.pullback T.hom (εO ≫ OY.ι) ⟶ Limits.pullback T.hom p,
      IsOpenImmersion nT ∧ Set.range nT = Limits.pullback.snd T.hom p ⁻¹' Set.range i ∧
      nT ≫ Limits.pullback.fst T.hom p = Limits.pullback.fst T.hom (εO ≫ OY.ι) ∧
      nT ≫ Limits.pullback.snd T.hom p = Limits.pullback.snd T.hom (εO ≫ OY.ι) ≫ i := by
    intro T
    refine ⟨Limits.pullback.map T.hom (εO ≫ OY.ι) T.hom p (𝟙 _) i (𝟙 _) (by simp)
      (by rw [Category.comp_id, hip]), inferInstance, ?_, ?_, ?_⟩
    · rw [Scheme.Pullback.range_map]
      ext x
      simp only [Set.mem_inter_iff, Set.mem_preimage]
      exact ⟨fun h => h.2, fun h => ⟨⟨Limits.pullback.fst T.hom p x, rfl⟩, h⟩⟩
    · rw [Limits.pullback.lift_fst, Category.comp_id]
    · rw [Limits.pullback.lift_snd]
  obtain ⟨nU, hnUo, hnUr, hnUfst, hnUsnd⟩ := hn U
  obtain ⟨nVm, hnVo, hnVr, hnVfst, hnVsnd⟩ := hn V
  haveI := hnUo
  haveI := hnVo

  obtain ⟨j, hjfst, hjsnd, hjpre⟩ : ∃ j : Limits.pullback U.hom (εO ≫ OY.ι) ⟶
      Limits.pullback U.hom (εO ≫ OY.ι).fromNormalization,
      j ≫ Limits.pullback.fst U.hom (εO ≫ OY.ι).fromNormalization =
        Limits.pullback.fst U.hom (εO ≫ OY.ι) ∧
      j ≫ Limits.pullback.snd U.hom (εO ≫ OY.ι).fromNormalization =
        Limits.pullback.snd U.hom (εO ≫ OY.ι) ≫ (εO ≫ OY.ι).toNormalization ∧
      ∀ a, ⇑j ⁻¹' Ω a = Set.range (Limits.pullback.lift (ua a) (𝟙 E') (hu a)) :=
    ⟨_, by rw [Limits.pullback.lift_fst, Category.comp_id], by rw [Limits.pullback.lift_snd], hΩj⟩
  obtain ⟨M, hMfst, hMsnd, hMpre⟩ : ∃ M : Limits.pullback U.hom (εO ≫ OY.ι).fromNormalization ⟶
      Limits.pullback U.hom p,
      M ≫ Limits.pullback.fst U.hom p = Limits.pullback.fst U.hom (εO ≫ OY.ι).fromNormalization ∧
      M ≫ Limits.pullback.snd U.hom p = Limits.pullback.snd U.hom (εO ≫ OY.ι).fromNormalization ≫ r ∧
      ∀ a, ⇑M ⁻¹' Θ a = Ω a :=
    ⟨_, by rw [Limits.pullback.lift_fst, Category.comp_id], by rw [Limits.pullback.lift_snd], hΘpre⟩
  have hnUjM : nU = j ≫ M := by
    apply Limits.pullback.hom_ext
    · rw [hnUfst, Category.assoc, hMfst, hjfst]
    · rw [hnUsnd, Category.assoc, hMsnd, ← Category.assoc, hjsnd, Category.assoc, ← hi]
  have hpreU : ∀ a, ⇑nU ⁻¹' Θ a = Set.range (Limits.pullback.lift (ua a) (𝟙 E') (hu a)) := by
    intro a
    rw [← hjpre a, ← hMpre a, hnUjM]
    rfl

  have huO : ∀ a, (κ.inv ≫ ua a) ≫ U.hom = O.ι ≫ p := by
    intro a
    rw [Category.assoc, hu a, Category.id_comp, hOι, Category.assoc, hip]
  have hvO : ∀ b, (κ.inv ≫ vb b) ≫ V.hom = O.ι ≫ p := by
    intro b
    rw [Category.assoc, hv b, Category.id_comp, hOι, Category.assoc, hip]
  have hliftU : ∀ a, Limits.pullback.lift (κ.inv ≫ ua a) O.ι (huO a) =
      κ.inv ≫ Limits.pullback.lift (ua a) (𝟙 E') (hu a) ≫ nU := by
    intro a
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]
      simp only [Category.assoc]
      rw [hnUfst, Limits.pullback.lift_fst]
    · rw [Limits.pullback.lift_snd]
      simp only [Category.assoc]
      rw [hnUsnd, Limits.pullback.lift_snd_assoc, Category.id_comp, hOι]
  have hliftV : ∀ b, Limits.pullback.lift (κ.inv ≫ vb b) O.ι (hvO b) =
      κ.inv ≫ Limits.pullback.lift (vb b) (𝟙 E') (hv b) ≫ nVm := by
    intro b
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]
      simp only [Category.assoc]
      rw [hnVfst, Limits.pullback.lift_fst]
    · rw [Limits.pullback.lift_snd]
      simp only [Category.assoc]
      rw [hnVsnd, Limits.pullback.lift_snd_assoc, Category.id_comp, hOι]
  refine ⟨Z, p, hp, O, Set.range (εO ≫ OY.ι), hyE, hEc, ?_, k, fun a => κ.inv ≫ ua a, huO, ?_,
    Θ, hΘc, hΘp, ?_, k', fun b => κ.inv ≫ vb b, hvO, ?_, ?_, ?_⟩
  ·
    rintro _ ⟨e, rfl⟩
    refine ⟨i e, by rw [hOset]; exact ⟨e, rfl⟩, ?_⟩
    rw [← Scheme.Hom.comp_apply, hip]
  ·
    intro a
    have h := hliftU a
    haveI := hgu a
    rw [h]
    infer_instance
  ·
    intro a
    have h := hliftU a
    rw [h, hrange_comp, hinv, Set.image_univ, hrange_comp, ← hpreU a,
      Set.image_preimage_eq_inter_range, hnUr, hOset]
  ·
    intro b
    have h := hliftV b
    haveI := hgv b
    rw [h]
    infer_instance
  ·
    intro b b' z z' hzz
    have h1 := hliftV b
    have h2 := hliftV b'
    rw [h1, h2] at hzz
    simp only [Scheme.Hom.comp_apply] at hzz
    exact hvdisj b b' _ _ ((Scheme.Hom.isOpenEmbedding nVm).injective hzz)
  ·
    intro x hx
    rw [hOset] at hx
    have hxr : x ∈ Set.range nVm := by rw [hnVr]; exact hx
    obtain ⟨w', rfl⟩ := hxr
    obtain ⟨b, e, he⟩ := hvcov w'
    refine ⟨b, κ.hom e, ?_⟩
    have h := hliftV b
    rw [h]
    simp only [Scheme.Hom.comp_apply, Scheme.hom_inv_apply, he]

theorem wc_zmod_hom_separation : ∀ (m : ℕ), m ≠ 0 → ∀ (k : ℕ) (M : AddSubgroup (Fin k → ZMod m))
    (w : Fin k → ZMod m), w ∉ M →
    ∃ f : (Fin k → ZMod m) →+ ZMod m, (∀ x ∈ M, f x = 0) ∧ f w ≠ 0 :=
by
  intro m hm k M w hw
  classical
  have hπ : (QuotientAddGroup.mk' M w) ≠ 0 := by
    rw [QuotientAddGroup.mk'_apply, Ne, QuotientAddGroup.eq_zero_iff]
    exact hw
  obtain ⟨c, hc⟩ := CharacterModule.exists_character_apply_ne_zero_of_ne_zero hπ
  let χ : (Fin k → ZMod m) →+ AddCircle (1 : ℚ) :=
    (c : (Fin k → ZMod m) ⧸ M →+ AddCircle (1 : ℚ)).comp (QuotientAddGroup.mk' M)
  have hχM : ∀ x ∈ M, χ x = 0 := by
    intro x hx
    have h0 : (QuotientAddGroup.mk' M x) = 0 := (QuotientAddGroup.eq_zero_iff x).mpr hx
    show c (QuotientAddGroup.mk' M x) = 0
    rw [h0, map_zero]
  have hmQ : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hm
  let u : AddCircle (1 : ℚ) := ((1 / (m : ℚ) : ℚ) : AddCircle (1 : ℚ))
  have hu : (m : ℤ) • u = 0 := by
    show (m : ℤ) • (((1 / (m : ℚ) : ℚ)) : AddCircle (1 : ℚ)) = 0
    rw [← AddCircle.coe_zsmul, zsmul_eq_mul]
    push_cast
    rw [mul_one_div_cancel hmQ, AddCircle.coe_period]
  let j : ZMod m →+ AddCircle (1 : ℚ) :=
    ZMod.lift m ⟨zmultiplesHom _ u, by simpa using hu⟩
  have hj : ∀ z : ℤ, j (z : ZMod m) = (((z : ℚ) / m : ℚ) : AddCircle (1 : ℚ)) := by
    intro z
    simp only [j, ZMod.lift_coe]
    show z • u = _
    show z • (((1 / (m : ℚ) : ℚ)) : AddCircle (1 : ℚ)) = _
    rw [← AddCircle.coe_zsmul, zsmul_eq_mul, mul_one_div]
  have hjinj : Function.Injective j := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨z, rfl⟩ := ZMod.intCast_surjective a
    rw [hj, AddCircle.coe_eq_zero_iff] at ha
    obtain ⟨n, hn⟩ := ha
    rw [zsmul_eq_mul, mul_one] at hn
    have h1 : (z : ℚ) = n * m := by rw [hn]; field_simp
    have hz : z = n * m := by exact_mod_cast h1
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
    exact ⟨n, by rw [hz, mul_comm]⟩
  have hjsurj : ∀ y : AddCircle (1 : ℚ), m • y = 0 → ∃ a, j a = y := by
    intro y hy
    obtain ⟨q, rfl⟩ := QuotientAddGroup.mk_surjective y
    have h1 : ((m • q : ℚ) : AddCircle (1 : ℚ)) = 0 := by
      rw [AddCircle.coe_nsmul]; exact hy
    rw [AddCircle.coe_eq_zero_iff] at h1
    obtain ⟨n, hn⟩ := h1
    rw [zsmul_eq_mul, mul_one, nsmul_eq_mul] at hn
    refine ⟨(n : ZMod m), ?_⟩
    rw [hj, hn]
    congr 1
    field_simp
  have htors : ∀ x : Fin k → ZMod m, m • x = 0 := by
    intro x
    funext i
    simp [nsmul_eq_mul]
  have hrange : ∀ x, ∃ a, j a = χ x := fun x =>
    hjsurj _ (by rw [← map_nsmul, htors, map_zero])
  choose F hF using hrange
  let f : (Fin k → ZMod m) →+ ZMod m :=
    { toFun := F
      map_zero' := hjinj (by rw [hF, map_zero, map_zero])
      map_add' := fun x y => hjinj (by rw [hF, map_add, map_add, hF, hF]) }
  refine ⟨f, fun x hx => hjinj ?_, fun h => hc ?_⟩
  · show j (F x) = j 0
    rw [hF, map_zero]
    exact hχM x hx
  · have h2 : j (F w) = j 0 := by rw [show F w = 0 from h]
    rw [hF, map_zero] at h2
    exact h2

theorem wc_split_target_map : ∀ (Y Z : Scheme.{u}) (p : Z ⟶ Y) [IsFinite p] (U V : Y.Etale)
    (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    (m k : ℕ) (Θ : Fin k → Set ↥(Limits.pullback U.hom p)), (∀ a, IsClopen (Θ a)) →
    ∀ (S : Set Z) (f : (Fin k → ZMod m) →+ ZMod m),
    (∀ z ∈ S, ∀ v ∈ wcSmeWit p U V g m k Θ z, f v = 0) →
    ∃ (W : Scheme.{u}) (q : W ⟶ Y) (_ : IsFinite q)
      (φ : Limits.cokernel g ⟶ (wcEtPush q).obj ((constantSheaf (Scheme.smallEtaleTopology W)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))),
      ∀ (T : Y.Etale) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
        (φ.hom.app (Opposite.op T)).hom
          (((Limits.cokernel.π g).hom.app (Opposite.op T)).hom (wcSmeGen U T R)) = 0 →
        ∀ w : ↥(Limits.pullback T.hom p), Limits.pullback.snd T.hom p w ∈ S →
          f (wcSmePieceVec p U m k Θ T w R) = 0 :=
by
  classical

  have hL1 : ∀ (X : Scheme.{u}) (A : Type (u+1)) [AddCommGroup A],
      Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtLC X A) := by
    intro X A _
    have s2 : ∀ {Z : Type u} [TopologicalSpace Z] {ι : Type (u+1)} {V : ι → Type u}
        [∀ i, TopologicalSpace (V i)] (f : ∀ i, V i → Z), (∀ i, IsOpenMap (f i)) →
        (∀ z : Z, ∃ (i : ι) (v : V i), f i v = z) → ∀ (g : ∀ i, LocallyConstant (V i) A),
        (∀ (i j : ι) (v : V i) (w : V j), f i v = f j w → g i v = g j w) →
        ∃ G : LocallyConstant Z A, ∀ (i : ι) (v : V i), G (f i v) = g i v := by
      intro Z _ ι V _ f hopen hsurj g hcompat
      choose iz vz hz using hsurj
      let G₀ : Z → A := fun z => g (iz z) (vz z)
      have hK : ∀ j w, G₀ (f j w) = g j w := fun j w => hcompat _ _ _ _ (hz _)
      have hlc : IsLocallyConstant G₀ := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro a
        rw [isOpen_iff_forall_mem_open]
        intro z hzA
        refine ⟨f (iz z) '' {v' | g (iz z) v' = g (iz z) (vz z)}, ?_,
          hopen _ _ (IsLocallyConstant.isOpen_fiber (g (iz z)).isLocallyConstant _),
          ⟨vz z, rfl, hz z⟩⟩
        rintro _ ⟨v', hv', rfl⟩
        change G₀ (f (iz z) v') = a
        rw [hK, hv']
        exact hzA
      exact ⟨⟨G₀, hlc⟩, hK⟩
    have s3 : ∀ (U : X.Etale) (S : Sieve U), S ∈ Scheme.smallEtaleTopology X U →
        ∀ z : U.left, ∃ (V : X.Etale) (f : V ⟶ U) (y : V.left), S.arrows f ∧ f.left y = z := by
      intro U S hS z
      change S ∈ Scheme.smallGrothendieckTopology @Etale X U at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      obtain ⟨V, f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U S).mp hS z
      exact ⟨V, f, y, hf, hy⟩
    have s4e : ∀ {V U : X.Etale} (c : V ⟶ U), Etale c.left := by
      intro V U c
      haveI : Etale U.hom := U.prop
      haveI : Etale (c.left ≫ U.hom) := by rw [MorphismProperty.Over.w c]; exact V.prop
      exact Etale.of_comp c.left U.hom
    have s4 : ∀ {V U : X.Etale} (c : V ⟶ U), IsOpenMap c.left := by
      intro V U c
      haveI := s4e c
      exact c.left.isOpenMap
    have s5 : ∀ {U V₁ V₂ : X.Etale} (f₁ : V₁ ⟶ U) (f₂ : V₂ ⟶ U) (y₁ : V₁.left) (y₂ : V₂.left),
        f₁.left y₁ = f₂.left y₂ → ∃ (D : X.Etale) (π₁ : D ⟶ V₁) (π₂ : D ⟶ V₂) (z : D.left),
          π₁ ≫ f₁ = π₂ ≫ f₂ ∧ π₁.left z = y₁ ∧ π₂.left z = y₂ := by
      intro U V₁ V₂ f₁ f₂ y₁ y₂ h
      haveI := s4e f₂
      haveI hEt : Etale (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) := by
        haveI : Etale V₁.hom := V₁.prop
        infer_instance
      let D : X.Etale :=
        MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) hEt
      have hw : Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom =
          Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom := by
        rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let p₁ : D ⟶ V₁ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl trivial
      let p₂ : D ⟶ V₂ :=
        MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left) hw trivial
      have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
        apply MorphismProperty.Over.Hom.ext
        change Limits.pullback.fst f₁.left f₂.left ≫ f₁.left =
          Limits.pullback.snd f₁.left f₂.left ≫ f₂.left
        exact Limits.pullback.condition
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback y₁ y₂ h
      exact ⟨D, p₁, p₂, z, hcomm, hz1, hz2⟩
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) (wcEtLC X A)
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro U S hS x hx
    let ι := Σ (V : X.Etale), {f : V ⟶ U // S.arrows f}
    obtain ⟨G, hG⟩ := s2 (Z := U.left) (ι := ι) (V := fun i => ↥(i.1.left))
      (fun i v => i.2.1.left v) (fun i => s4 i.2.1)
      (fun z => by
        obtain ⟨V, f, y, hf, hy⟩ := s3 U S hS z
        exact ⟨⟨V, f, hf⟩, y, hy⟩)
      (fun i => show LocallyConstant i.1.left A from x i.2.1 i.2.2)
      (by
        rintro ⟨V₁, f₁, h₁⟩ ⟨V₂, f₂, h₂⟩ v w hvw
        obtain ⟨D, π₁, π₂, z, hcomm, hz1, hz2⟩ := s5 f₁ f₂ v w hvw
        have hc := hx π₁ π₂ h₁ h₂ hcomm
        have h := congrArg (fun k => (show LocallyConstant D.left A from k) z) hc
        change (show LocallyConstant V₁.left A from x f₁ h₁) v =
          (show LocallyConstant V₂.left A from x f₂ h₂) w
        rw [← hz1, ← hz2]
        exact h)
    refine ⟨G, fun V f hf => ?_, fun t ht => ?_⟩
    · change @Eq (LocallyConstant V.left A) _ _
      exact LocallyConstant.ext (fun y => hG ⟨V, f, hf⟩ y)
    · change @Eq (LocallyConstant U.left A) _ _
      refine LocallyConstant.ext (fun z => ?_)
      obtain ⟨V, f, y, hf, rfl⟩ := s3 U S hS z
      have h1 := congrArg (fun k => (show LocallyConstant V.left A from k) y) (ht f hf)
      exact h1.trans (hG ⟨V, f, hf⟩ y).symm

  have hL2 : ∀ (X : Scheme.{u}) (A : Type (u+1)) [AddCommGroup A],
      ∃ φ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A) ⟶ wcEtLC X A,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) φ ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) φ := by
    intro X A _
    have hcov : ∀ (U : X.Etale) (R : Sieve U), (∀ p : U.left, ∃ (V : X.Etale) (f : V ⟶ U)
        (v : V.left), R.arrows f ∧ Etale f.left ∧ f.left v = p) →
        R ∈ Scheme.smallEtaleTopology X U := by
      intro U R hR
      change R ∈ Scheme.smallGrothendieckTopology @Etale X U
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      exact hR
    let φ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A) ⟶ wcEtLC X A :=
      { app := fun U => AddCommGrpCat.ofHom
          (LocallyConstant.constAddMonoidHom : A →+ LocallyConstant U.unop.left A)
        naturality := fun U V g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro a
          rfl }
    refine ⟨φ, ?_, ?_⟩
    · constructor
      intro U x y h
      apply hcov
      intro p
      have hxy : x = y := by
        have := congrArg (fun k : LocallyConstant U.unop.left A => k p) h
        exact this
      refine ⟨U.unop, 𝟙 _, p, ?_, ?_, rfl⟩
      · subst hxy
        exact rfl
      · show Etale (𝟙 U.unop.left)
        infer_instance
    · constructor
      intro U s
      apply hcov
      intro p
      let σ : LocallyConstant U.left A := s
      let N : U.left.Opens := ⟨{q | σ q = σ p}, σ.isLocallyConstant.isOpen_fiber (σ p)⟩
      haveI : Etale U.hom := U.prop
      let V : X.Etale := Scheme.Etale.mk (N.ι ≫ U.hom)
      let f : V ⟶ U := MorphismProperty.Over.homMk N.ι rfl trivial
      refine ⟨V, f, ⟨p, rfl⟩, ?_, ?_, rfl⟩
      · refine ⟨σ p, ?_⟩
        apply LocallyConstant.ext
        intro q
        change σ p = σ (f.left q)
        exact q.2.symm
      · show Etale N.ι
        infer_instance

  have hL3 : ∀ {X Y : Scheme.{u}} (a : X ⟶ Y) (A : Type (u+1)) [AddCommGroup A],
      Nonempty ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (wcLCPb a A) ≅ (wcEtPush a).obj ((constantSheaf (Scheme.smallEtaleTopology X)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A))) := by
    intro X Y a A _
    obtain ⟨φ, hinj, hsurj⟩ := hL2 X A
    let L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} := ⟨wcEtLC X A, hL1 X A⟩
    have hW : (Scheme.smallEtaleTopology X).W φ :=
      (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology X) φ).mpr
        ⟨hinj, hsurj⟩
    have hI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) :=
      (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology X) φ).mp hW
    let e1 := @asIso _ _ _ _ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) hI
    let ε : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of A) ≅ L :=
      e1 ≪≫ (sheafificationIso L).symm
    exact ⟨(wcEtPush a).mapIso ε.symm⟩

  have c1 : ∀ (Z : Scheme.{u}) (S : Set Z), ∃ (W : Scheme.{u}) (ι : W ⟶ Z),
      IsClosedImmersion ι ∧ Set.range ι = closure S ∧ Dense (ι ⁻¹' S) := by
    intro Z S
    let C : TopologicalSpace.Closeds Z := ⟨closure S, isClosed_closure⟩
    let I := Scheme.IdealSheafData.vanishingIdeal C
    have hr : Set.range I.subschemeι = closure S := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    refine ⟨I.subscheme, I.subschemeι, inferInstance, hr, ?_⟩
    rw [dense_iff_closure_eq,
      I.subschemeι.isClosedEmbedding.isInducing.closure_eq_preimage_closure_image,
      Set.image_preimage_eq_inter_range, hr, Set.inter_eq_left.mpr subset_closure, ← hr,
      Set.preimage_range]

  have c3 : ∀ (Y W : Scheme.{u}) (q : W ⟶ Y) (T : Y.Etale) (A : Type (u+1)) [AddCommGroup A]
      (h : LocallyConstant ↥(Limits.pullback T.hom q) A) (D : Set W), Dense D →
      (∀ x : ↥(Limits.pullback T.hom q), Limits.pullback.snd T.hom q x ∈ D → h x = 0) →
      h = 0 := by
    intro Y W q T A _ h D hD H
    haveI : Etale T.hom := T.prop
    have hopen : IsOpenMap (Limits.pullback.snd T.hom q) := (Limits.pullback.snd T.hom q).isOpenMap
    have hd := hD.preimage hopen
    have hcl : IsClosed {x | h x = 0} := (h.isLocallyConstant.isClopen_fiber 0).isClosed
    have hsub : closure (Limits.pullback.snd T.hom q ⁻¹' D) ⊆ {x | h x = 0} :=
      closure_minimal (fun x hx => H x hx) hcl
    rw [hd.closure_eq] at hsub
    ext x
    exact hsub (Set.mem_univ x)

  have c4a : ∀ (Y Z : Scheme.{u}) (p : Z ⟶ Y) (U : Y.Etale) (m k : ℕ)
      (Θ : Fin k → Set ↥(Limits.pullback U.hom p)), (∀ a, IsClopen (Θ a)) →
      ∀ (f : (Fin k → ZMod m) →+ ZMod m) (T : Y.Etale)
        (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      IsLocallyConstant (fun w : ↥(Limits.pullback T.hom p) =>
        f (wcSmePieceVec p U m k Θ T w R)) := by
    intro Y Z p U m k Θ hΘ f T R
    have hloc : ∀ a, IsLocallyConstant (Set.indicator (Θ a) (fun _ => (1 : ZMod m))) := by
      intro a
      rw [IsLocallyConstant.iff_exists_open]
      intro x
      by_cases hx : x ∈ Θ a
      · exact ⟨Θ a, (hΘ a).isOpen, hx, fun y hy => by
          rw [Set.indicator_of_mem hy, Set.indicator_of_mem hx]⟩
      · exact ⟨(Θ a)ᶜ, (hΘ a).compl.isOpen, hx, fun y hy => by
          rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hx]⟩
    have hpi : IsLocallyConstant (fun (x : ↥(Limits.pullback U.hom p)) (a : Fin k) =>
        Set.indicator (Θ a) (fun _ => (1 : ZMod m)) x) := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro v
      have e : (fun (x : ↥(Limits.pullback U.hom p)) (a : Fin k) =>
          Set.indicator (Θ a) (fun _ => (1 : ZMod m)) x) ⁻¹' {v} =
          ⋂ a, (Set.indicator (Θ a) (fun _ => (1 : ZMod m))) ⁻¹' {v a} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iInter, funext_iff]
      rw [e]
      exact isOpen_iInter_of_finite (fun a => IsLocallyConstant.iff_isOpen_fiber.mp (hloc a) (v a))
    suffices h : IsLocallyConstant
        (fun w : ↥(Limits.pullback T.hom p) => wcSmePieceVec p U m k Θ T w R) from h.comp f
    induction R using FreeAbelianGroup.induction_on with
    | zero =>
      simp only [map_zero]
      exact IsLocallyConstant.const 0
    | of c =>
      have := hpi.comp_continuous (Limits.pullback.map T.hom p U.hom p c.down.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w c.down).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm)).continuous
      convert this using 1
      funext w
      simp only [wcSmePieceVec, FreeAbelianGroup.lift_apply_of, Function.comp_apply]
    | neg c ih =>
      simp only [map_neg]
      exact ih.neg
    | add x y hx hy =>
      simp only [map_add]
      exact hx.add hy

  have c2 : ∀ (Y W : Scheme.{u}) (q : W ⟶ Y) (A : Type (u+1)) [AddCommGroup A] (T : Y.Etale)
      (x : LocallyConstant ↥(Limits.pullback T.hom q) A),
      ((toSheafify (Scheme.smallEtaleTopology Y) (wcLCPb q A)).app (Opposite.op T)).hom x = 0 →
      x = 0 := by
    intro Y W q A _ T x hx
    have gen : ∀ (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] [P.IsMultiplicative]
        (S : Scheme.{u}) (X : P.Over ⊤ S) (R : Sieve X),
        R ∈ Scheme.smallGrothendieckTopology P S X → ∀ v : X.left,
        ∃ (X₁ : P.Over ⊤ S) (c : X₁ ⟶ X), R.arrows c ∧ v ∈ Set.range c.left := by
      intro P _ _ S X R hR v
      obtain ⟨𝒰, hO, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology X R).mp hR
      obtain ⟨i, y, hy⟩ := 𝒰.exists_eq v
      refine ⟨_, _, hle _ _ (Presieve.ofArrows.mk i), y, ?_⟩
      exact hy
    haveI : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y)
        (toSheafify (Scheme.smallEtaleTopology Y) (wcLCPb q A)) :=
      Presheaf.isLocallyInjective_toSheafify' _ _
    have hE := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) (wcLCPb q A)) (X := Opposite.op T)
      (show (wcLCPb q A).obj (Opposite.op T) from x) 0 (by rw [map_zero]; exact hx)
    ext y
    obtain ⟨T₃, c, hc, t₃, ht₃⟩ := gen _ Y T _ hE (Limits.pullback.fst T.hom q y)
    haveI : Mono (𝟙 Y) := inferInstance
    have hr := Scheme.Pullback.range_map T₃.hom q T.hom q c.left (𝟙 W) (𝟙 Y)
      ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
      ((Category.comp_id _).trans (Category.id_comp _).symm)
    have hy : y ∈ Set.range (Limits.pullback.map T₃.hom q T.hom q c.left (𝟙 W) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm)) := by
      rw [hr]
      exact ⟨⟨t₃, ht₃⟩, ⟨Limits.pullback.snd T.hom q y, rfl⟩⟩
    obtain ⟨y', rfl⟩ := hy
    have h1 := congrArg (fun z : LocallyConstant ↥(Limits.pullback T₃.hom q) A => z y') hc
    simp only at h1
    rw [map_zero] at h1
    exact h1

  have c4 : ∀ (Y Z W : Scheme.{u}) (p : Z ⟶ Y) (ι : W ⟶ Z) (U : Y.Etale) (m k : ℕ)
      (Θ : Fin k → Set ↥(Limits.pullback U.hom p)) (f : (Fin k → ZMod m) →+ ZMod m),
      (∀ (T : Y.Etale) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
        IsLocallyConstant (fun w : ↥(Limits.pullback T.hom p) =>
          f (wcSmePieceVec p U m k Θ T w R))) →
      ∃ τ₀ : (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          wcLCPb (ι ≫ p) (ULift.{u+1} (ZMod m)),
        ∀ (T : Y.Etale) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)))
          (x : ↥(Limits.pullback T.hom (ι ≫ p))),
          (show LocallyConstant ↥(Limits.pullback T.hom (ι ≫ p)) (ULift.{u+1} (ZMod m)) from
              (τ₀.app (Opposite.op T)).hom R) x =
            ULift.up (f (wcSmePieceVec p U m k Θ T
              (Limits.pullback.map T.hom (ι ≫ p) T.hom p (𝟙 T.left) ι (𝟙 Y)
                ((Category.comp_id _).trans (Category.id_comp _).symm) (Category.comp_id _) x) R)) := by
    intro Y Z W p ι U m k Θ f H
    let j : ∀ T : Y.Etale, Limits.pullback T.hom (ι ≫ p) ⟶ Limits.pullback T.hom p := fun T =>
      Limits.pullback.map T.hom (ι ≫ p) T.hom p (𝟙 T.left) ι (𝟙 Y)
        ((Category.comp_id _).trans (Category.id_comp _).symm) (Category.comp_id _)
    let ψ : ∀ T : Y.Etale, FreeAbelianGroup (ULift.{u+1} (T ⟶ U)) →+
        LocallyConstant ↥(Limits.pullback T.hom (ι ≫ p)) (ULift.{u+1} (ZMod m)) := fun T =>
      { toFun := fun R => ⟨fun x => ULift.up (f (wcSmePieceVec p U m k Θ T (j T x) R)),
