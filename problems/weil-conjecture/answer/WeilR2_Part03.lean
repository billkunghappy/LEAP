      exact congrArg (fun f : (wcEtBaseChange p).obj (W.obj l) ⟶ (wcEtBaseChange p).obj V =>
        f.left) (show (wcEtBaseChange p).map (W.map k) ≫ (wcEtBaseChange p).map (g l') =
          (wcEtBaseChange p).map (g l) by rw [← Functor.map_comp, hWg])
    obtain ⟨l₀⟩ : Nonempty Λ := IsCofiltered.nonempty

    obtain ⟨xs, aQ, haQ⟩ := wc_finite_pieces_etale_factor (Limits.pullback (ψ ≫ V.hom) p)
      ((wcEtBaseChange p).obj V).left n O t c ht hdisj hcov' hsec (π l₀ ≫ tt l₀)
      (fun x => (U ((π l₀ ≫ tt l₀) x)).left) (fun x => (u ((π l₀ ≫ tt l₀) x)).left)
      (fun x => hEt _) (fun x => ⟨y _, huy _⟩)

    have hEtD : Etale (Limits.Sigma.desc (fun i => (u ((π l₀ ≫ tt l₀) (xs i))).left)) :=
      @IsZariskiLocalAtSource.sigmaDesc @Etale HasRingHomProperty.instIsZariskiLocalAtSource
        _ _ _ _ _ (fun i => hEt _)
    obtain ⟨l, b', hb'⟩ := wc_scheme_limit_lfp_factor Λ D ((wcEtBaseChange p).obj V).left tt htt
      (Limits.pullback (ψ ≫ V.hom) p) π hπc hπlim hcpt hqs haff
      (∐ (fun i => (U ((π l₀ ≫ tt l₀) (xs i))).left))
      (Limits.Sigma.desc (fun i => (u ((π l₀ ≫ tt l₀) (xs i))).left)) inferInstance l₀ aQ haQ

    obtain ⟨r, hr⟩ := wc_et_sheaf_lift_through_sigma φ ((wcEtBaseChange p).obj V) σ n
      (fun i => U ((π l₀ ≫ tt l₀) (xs i))) (fun i => u ((π l₀ ≫ tt l₀) (xs i)))
      (fun i => hu _) ((wcEtBaseChange p).obj (W.obj l)) ((wcEtBaseChange p).map (g l)) b' hb'

    refine ⟨W.obj l, g l, ⟨r, hr⟩, φl l (IsLocalRing.closedPoint A), ?_⟩
    have e : (g l).left (φl l (IsLocalRing.closedPoint A)) = ψ (IsLocalRing.closedPoint A) := by
      rw [← hφg l]
      first | rfl | exact (Scheme.Hom.comp_apply _ _ _).symm
    exact e.trans hψv

  haveI : (wcEtPush p).PreservesEpimorphisms := by
