    rw [Limits.comp_zero]
    apply NatTrans.ext
    funext T
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext (α := ULift.{u+1} (T.unop ⟶ V)) _ _ (fun c => ?_)
    rw [NatTrans.app_zero]
    erw [hall T c.down]
    rfl

  intro Y Z p _ U V g m k Θ hΘ S f hkill
  obtain ⟨W, ι, hι, hrange, hdense⟩ := c1 Z S
  haveI := hι
  obtain ⟨e⟩ := hL3 (ι ≫ p) (ULift.{u+1} (ZMod m))
  obtain ⟨τ₀, hτ₀⟩ := c4 Y Z W p ι U m k Θ f (fun T R => c4a Y Z p U m k Θ hΘ f T R)
  have hj : ∀ (T : Y.Etale) (x : ↥(Limits.pullback T.hom (ι ≫ p))),
      Limits.pullback.snd T.hom p (Limits.pullback.map T.hom (ι ≫ p) T.hom p (𝟙 T.left) ι (𝟙 Y)
        ((Category.comp_id _).trans (Category.id_comp _).symm) (Category.comp_id _) x) =
      ι (Limits.pullback.snd T.hom (ι ≫ p) x) := by
    intro T x
    have e : Limits.pullback.map T.hom (ι ≫ p) T.hom p (𝟙 T.left) ι (𝟙 Y)
        ((Category.comp_id _).trans (Category.id_comp _).symm) (Category.comp_id _) ≫
        Limits.pullback.snd T.hom p = Limits.pullback.snd T.hom (ι ≫ p) ≫ ι :=
      Limits.pullback.lift_snd _ _ _
    rw [← Scheme.Hom.comp_apply, e, Scheme.Hom.comp_apply]
  have hK : ∀ (T' : Y.Etale) (d : T' ⟶ V) (R : FreeAbelianGroup (ULift.{u+1} (T' ⟶ U))),
      wcSmeGen U T' R = (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map d.op).hom
        ((g.hom.app (Opposite.op V)).hom (wcSmeGen V V (FreeAbelianGroup.of (ULift.up (𝟙 V))))) →
      (τ₀.app (Opposite.op T')).hom R = 0 := by
    intro T' d R hR
    refine c3 Y W (ι ≫ p) T' (ULift.{u+1} (ZMod m))
      (show LocallyConstant ↥(Limits.pullback T'.hom (ι ≫ p)) (ULift.{u+1} (ZMod m)) from
