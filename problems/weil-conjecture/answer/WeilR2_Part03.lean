  have hSψ : Sψ.Exact := (ShortComplex.exact_iff_epi_kernel_lift Sψ).2 hk
  haveI : Epi Sψ.g := hψ
  obtain ⟨e₂, he₂⟩ : ∃ e₂ : Limits.cokernel (wcEtExtZeroι Y (Set.range i)ᶜ m) ≅
      F.obj ((constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))),
      Limits.cokernel.π (wcEtExtZeroι Y (Set.range i)ᶜ m) ≫ e₂.hom = νL :=
    ⟨Limits.IsColimit.coconePointUniqueUpToIso (Limits.colimit.isColimit _) hSψ.gIsCokernel,
      Limits.IsColimit.comp_coconePointUniqueUpToIso_hom (Limits.colimit.isColimit _)
        hSψ.gIsCokernel Limits.WalkingParallelPair.one⟩

  have hiso := wc_et_const_unit_iso i hTZ (AddCommGrpCat.of (ULift.{u+1} ℤ)) νZ hfacZ

  have hbij := wc_ext_adjoint_transfer L F adj
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 1
  let φ := (adj.homEquiv ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))).symm νZ
  haveI : IsIso φ := hiso
  have hν : adj.unit.app ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ F.map φ = νZ :=
    (adj.homEquiv_unit _ _ φ).symm.trans (Equiv.apply_symm_apply _ νZ)
  obtain ⟨e, he⟩ := hbij.2 (ζ.comp (Abelian.Ext.mk₀ e₂.hom) (add_zero 1))
  have he' : (Abelian.Ext.mk₀ (adj.unit.app
      ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))))).comp (Abelian.Ext.mapExactFunctor F e) (zero_add 1) =
      ζ.comp (Abelian.Ext.mk₀ e₂.hom) (add_zero 1) := he
  have hξ₀ : (Abelian.Ext.mk₀ νZ).comp (Abelian.Ext.mapExactFunctor F
      ((Abelian.Ext.mk₀ (inv φ)).comp e (zero_add 1))) (zero_add 1) =
      ζ.comp (Abelian.Ext.mk₀ e₂.hom) (add_zero 1) := by
    rw [← he', Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, ← hν, Category.assoc, ← F.map_comp, IsIso.hom_inv_id,
      F.map_id]
    erw [Category.comp_id]
  refine ⟨(Abelian.Ext.mk₀ (inv φ)).comp e (zero_add 1), ?_⟩
  intro E₀ f₀ g₀ w₀ hS₀ hξ V₀ p₀ a₀ ht₀ s₀ hs₀ V p a j ht hpb hj

  have hS₁ := hS₀.map_of_exact F
  have hcls₁ : hS₁.extClass = Abelian.Ext.mapExactFunctor F
      ((Abelian.Ext.mk₀ (inv φ)).comp e (zero_add 1)) := by
    rw [← hξ, Abelian.Ext.mapExactFunctor_extClass]

  let S₁ := (ShortComplex.mk f₀ g₀ w₀).map F
  have hw0 : S₁.f ≫ S₁.g = (0 : S₁.X₁ ⟶ (constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≫ νZ := by
    rw [S₁.zero, Limits.zero_comp]
  let fE : S₁.X₁ ⟶ Limits.pullback S₁.g νZ := Limits.pullback.lift S₁.f 0 hw0
  let gE := Limits.pullback.snd S₁.g νZ
  have hf1 : fE ≫ Limits.pullback.fst S₁.g νZ = S₁.f := Limits.pullback.lift_fst _ _ _
  have hf2 : fE ≫ gE = 0 := Limits.pullback.lift_snd _ _ _
  haveI : Mono S₁.f := hS₁.mono_f
  haveI : Mono fE := mono_of_mono_fac hf1
  haveI : Epi S₁.g := hS₁.epi_g
  haveI : Epi gE := Abelian.epi_pullback_of_epi_f _ _
  have hex : (ShortComplex.mk fE gE hf2).Exact := by
    refine ShortComplex.exact_of_f_is_kernel _
      (Limits.KernelFork.IsLimit.ofι' fE hf2 (fun {Z} k hk => ?_))
    have hk' : (k ≫ Limits.pullback.fst S₁.g νZ) ≫ S₁.g = 0 := by
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc]
      change (k ≫ gE) ≫ νZ = 0
      rw [hk, Limits.zero_comp]
    refine ⟨hS₁.exact.lift (k ≫ Limits.pullback.fst _ _) hk', ?_⟩
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hf1]
      exact hS₁.exact.lift_f _ hk'
    · rw [Category.assoc]
      change _ ≫ (fE ≫ gE) = k ≫ gE
      rw [hf2, hk, Limits.comp_zero]
  have hSE : (ShortComplex.mk fE gE hf2).ShortExact :=
    ShortComplex.ShortExact.mk' hex inferInstance inferInstance
  let ψm : ShortComplex.mk fE gE hf2 ⟶ S₁ :=
    { τ₁ := 𝟙 _
      τ₂ := Limits.pullback.fst _ _
      τ₃ := νZ
      comm₁₂ := by
        change 𝟙 _ ≫ S₁.f = fE ≫ Limits.pullback.fst _ _
        rw [hf1, Category.id_comp]
      comm₂₃ := Limits.pullback.condition }
  have hnat := hSE.extClass_naturality hS₁ ψm
  change hSE.extClass.comp (Abelian.Ext.mk₀ (𝟙 _)) _ = (Abelian.Ext.mk₀ νZ).comp hS₁.extClass _
    at hnat
  rw [Abelian.Ext.comp_mk₀_id] at hnat
  refine ⟨F.obj ((constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))), νL, e₂.inv, ?_,
    Limits.pullback S₁.g νZ, fE, gE, hf2, hSE, ?_, ?_⟩
  · rw [← he₂, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  · rw [hnat, hcls₁, hξ₀, Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  · exact wc_et_split_section_transfer Y Y₀ i m E₀ f₀ g₀ V₀ p₀ a₀ ht₀ s₀ hs₀ V p a j ht hpb hj
      νZ νL hfacZ hfacL _ (Limits.pullback.fst _ _) gE fE (IsPullback.of_hasPullback _ _) hf1 hf2

theorem wc_et_quot_h1_lift_of_torsor_lift : ∀ (Y Y₀ : Scheme.{u}) (i : Y₀ ⟶ Y) [IsClosedImmersion i]
    (S : Set Y), Set.range i = Sᶜ → ∀ (m : ℕ), m ≠ 0 →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel (wcEtExtZeroι Y S m)) 1,
    ∃ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Y₀) (a₀ : ZMod m → (V₀ ⟶ V₀)), wcFetTorsor p₀ m a₀ ∧
      ∀ (V : Scheme.{u}) (p : V ⟶ Y) (a : ZMod m → (V ⟶ V)) (j : V₀ ⟶ V),
        wcFetTorsor p m a → IsPullback j p₀ p i → (∀ c, a₀ c ≫ j = j ≫ a c) →
        ∃ η : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 1,
          η.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (wcEtExtZeroι Y S m))) (add_zero 1) = ζ :=
by
  intro Y Y₀ i _ S hS m hm ζ
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Y₀

  have s2 : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}}
      (ξ : Abelian.Ext A B 1), ∃ (E : Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1})
        (f : B ⟶ E) (g : E ⟶ A) (w : f ≫ g = 0) (hSE : (ShortComplex.mk f g w).ShortExact),
        hSE.extClass = ξ := by
    intro A B ξ
    let ι := Injective.ι B
    let T := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
    have hT : T.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
    have h0 : ξ.comp (Abelian.Ext.mk₀ T.f) (add_zero 1) = 0 := Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ A hT ξ h0 (zero_add 1)
    let h := Abelian.Ext.homEquiv₀ x₃
    have hx : Abelian.Ext.mk₀ h = x₃ := Abelian.Ext.mk₀_homEquiv₀_apply x₃
    have hw0 : ι ≫ Limits.cokernel.π ι = (0 : B ⟶ A) ≫ h := by
      rw [Limits.cokernel.condition, Limits.zero_comp]
    let f : B ⟶ Limits.pullback (Limits.cokernel.π ι) h := Limits.pullback.lift ι 0 hw0
    let g : Limits.pullback (Limits.cokernel.π ι) h ⟶ A := Limits.pullback.snd _ _
    have hf1 : f ≫ Limits.pullback.fst _ _ = ι := Limits.pullback.lift_fst _ _ _
    have hf2 : f ≫ g = 0 := Limits.pullback.lift_snd _ _ _
    haveI : Mono f := mono_of_mono_fac hf1
    haveI : Epi g := Abelian.epi_pullback_of_epi_f _ _
    have hex : (ShortComplex.mk f g hf2).Exact := by
      refine ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι' f hf2 (fun {Z} k hk => ?_))
      have hk' : (k ≫ Limits.pullback.fst _ _) ≫ T.g = 0 := by
        change (k ≫ Limits.pullback.fst _ _) ≫ Limits.cokernel.π ι = 0
        rw [Category.assoc, Limits.pullback.condition, ← Category.assoc]
        change (k ≫ g) ≫ h = 0
        rw [hk, Limits.zero_comp]
      haveI : Mono T.f := hT.mono_f
      refine ⟨hT.exact.lift (k ≫ Limits.pullback.fst _ _) hk', ?_⟩
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hf1]
        exact hT.exact.lift_f _ hk'
      · rw [Category.assoc]
        change _ ≫ (f ≫ g) = k ≫ g
        rw [hf2, hk, Limits.comp_zero]
    have hSE : (ShortComplex.mk f g hf2).ShortExact :=
      ShortComplex.ShortExact.mk' hex inferInstance inferInstance
    let φ : ShortComplex.mk f g hf2 ⟶ T :=
      { τ₁ := 𝟙 B
        τ₂ := Limits.pullback.fst _ _
        τ₃ := h
        comm₁₂ := by
          change 𝟙 B ≫ ι = f ≫ Limits.pullback.fst _ _
          rw [hf1, Category.id_comp]
        comm₂₃ := Limits.pullback.condition }
    refine ⟨_, f, g, hf2, hSE, ?_⟩
    have hnat := hSE.extClass_naturality hT φ
    change hSE.extClass.comp (Abelian.Ext.mk₀ (𝟙 B)) _ = (Abelian.Ext.mk₀ h).comp hT.extClass _
      at hnat
    rw [Abelian.Ext.comp_mk₀_id, hx] at hnat
    rw [hnat]
    exact hx₃
  obtain ⟨ξ₀, H⟩ := wc_et_closed_ext_transfer Y Y₀ i S hS m hm ζ
  obtain ⟨E₀, f₀, g₀, w₀, hS₀, hξ⟩ := s2 ξ₀
  obtain ⟨V₀, p₀, a₀, ht₀, s₀, hs₀⟩ := wc_et_ses_torsor_representable Y₀ m hm E₀ f₀ g₀ w₀ hS₀
  refine ⟨V₀, p₀, a₀, ht₀, ?_⟩
  intro V p a j ht hpb hj
  obtain ⟨G, ρ, τ, hρτ, E, f, g, w, hSE, hζ, s, hs⟩ :=
    H E₀ f₀ g₀ w₀ hS₀ hξ V₀ p₀ a₀ ht₀ s₀ hs₀ V p a j ht hpb hj
  obtain ⟨η, hη⟩ := wc_et_fet_torsor_class Y V p m a ht hm
  refine ⟨η, ?_⟩
  rw [← hρτ, ← Abelian.Ext.mk₀_comp_mk₀,
    ← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
    ← hη G E ρ f g w hSE s hs, hζ]

theorem wc_tinv_etale_alg_hom_lift_nil : ∀ (R A C : Type u) [CommRing R] [CommRing A] [CommRing C] [Algebra R A] [Algebra R C] [Algebra.Etale R A] (J : Ideal C), J ≤ nilradical C → Function.Bijective (fun φ : A →ₐ[R] C => (Ideal.Quotient.mkₐ R J).comp φ) :=
by
  intro R A C _ _ _ _ _ _ J hJ
  constructor
  · intro φ₁ φ₂ h
    have h' : (Ideal.Quotient.mkₐ R J).comp φ₁ = (Ideal.Quotient.mkₐ R J).comp φ₂ := h
    obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra R A).FG)
    let J₀ : Ideal C := Ideal.span ((fun a => φ₁ a - φ₂ a) '' (s : Set A))
    have hfg : J₀.FG := Submodule.fg_span (s.finite_toSet.image _)
    have hJ₀J : J₀ ≤ J := by
      rw [Ideal.span_le]
      rintro _ ⟨a, -, rfl⟩
      have := AlgHom.congr_fun h' a
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
      exact Ideal.Quotient.eq.mp this
    have hnil : IsNilpotent J₀ :=
      (Ideal.FG.isNilpotent_iff_le_nilradical hfg).mpr (hJ₀J.trans hJ)
    apply Algebra.FormallyUnramified.lift_unique J₀ hnil
    apply AlgHom.ext_of_adjoin_eq_top hs
    intro a ha
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
    exact Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨a, ha, rfl⟩)
  · intro ψ
    obtain ⟨n, f, hf, hker⟩ := (Algebra.FinitePresentation.out (R := R) (A := A))
    obtain ⟨t, ht⟩ := hker
    choose c hc using fun i : Fin n => Ideal.Quotient.mk_surjective (ψ (f (MvPolynomial.X i)))
    let F : MvPolynomial (Fin n) R →ₐ[R] C := MvPolynomial.aeval c
    have hF : (Ideal.Quotient.mkₐ R J).comp F = ψ.comp f := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, F, MvPolynomial.aeval_X]
      exact hc i
    have hFp : ∀ p, Ideal.Quotient.mk J (F p) = ψ (f p) := fun p => by
      have := AlgHom.congr_fun hF p
      simpa only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] using this
    let J₀ : Ideal C := Ideal.span (F '' (t : Set _))
    have hfg : J₀.FG := Submodule.fg_span (t.finite_toSet.image _)
    have hmemker : ∀ g ∈ t, f g = 0 := by
      intro g hg
      have : g ∈ RingHom.ker f.toRingHom := ht ▸ Ideal.subset_span hg
      exact this
    have hJ₀J : J₀ ≤ J := by
      rw [Ideal.span_le]
      rintro _ ⟨g, hg, rfl⟩
      rw [SetLike.mem_coe, ← Ideal.Quotient.eq_zero_iff_mem, hFp, hmemker g hg, map_zero]
    have hnil : IsNilpotent J₀ :=
      (Ideal.FG.isNilpotent_iff_le_nilradical hfg).mpr (hJ₀J.trans hJ)
    have hle : RingHom.ker f.toRingHom ≤ Ideal.comap F J₀ := by
      rw [← ht, Ideal.span_le]
      intro g hg
      exact Ideal.subset_span ⟨g, hg, rfl⟩
    have hker' : ∀ p ∈ RingHom.ker f, ((Ideal.Quotient.mkₐ R J₀).comp F) p = 0 := by
      intro p hp
      have := hle hp
      rw [Ideal.mem_comap] at this
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr this
    let ψ₀ : A →ₐ[R] C ⧸ J₀ :=
      (Ideal.Quotient.liftₐ (RingHom.ker f) ((Ideal.Quotient.mkₐ R J₀).comp F) hker').comp
        (Ideal.quotientKerAlgEquivOfSurjective hf).symm.toAlgHom
    have hψ₀ : ∀ p, ψ₀ (f p) = Ideal.Quotient.mk J₀ (F p) := by
      intro p
      have e : (Ideal.quotientKerAlgEquivOfSurjective hf).symm (f p) =
          Ideal.Quotient.mk (RingHom.ker f) p := by
        apply (Ideal.quotientKerAlgEquivOfSurjective hf).injective
        rw [AlgEquiv.apply_symm_apply]
        rfl
      change (Ideal.Quotient.liftₐ (RingHom.ker f) ((Ideal.Quotient.mkₐ R J₀).comp F) hker')
        ((Ideal.quotientKerAlgEquivOfSurjective hf).symm (f p)) = _
      rw [e, Ideal.Quotient.liftₐ_apply]
      rfl
    refine ⟨Algebra.FormallySmooth.lift J₀ hnil ψ₀, ?_⟩
    apply AlgHom.ext
    intro x
    obtain ⟨p, rfl⟩ := hf x
    show Ideal.Quotient.mkₐ R J (Algebra.FormallySmooth.lift J₀ hnil ψ₀ (f p)) = ψ (f p)
    rw [Ideal.Quotient.mkₐ_eq_mk]
    calc Ideal.Quotient.mk J (Algebra.FormallySmooth.lift J₀ hnil ψ₀ (f p))
        = Ideal.Quotient.factor hJ₀J
            (Ideal.Quotient.mk J₀ (Algebra.FormallySmooth.lift J₀ hnil ψ₀ (f p))) :=
          (Ideal.Quotient.factor_mk hJ₀J _).symm
      _ = Ideal.Quotient.factor hJ₀J (ψ₀ (f p)) := by
          rw [Algebra.FormallySmooth.mk_lift]
      _ = Ideal.Quotient.factor hJ₀J (Ideal.Quotient.mk J₀ (F p)) := by rw [hψ₀]
      _ = Ideal.Quotient.mk J (F p) := Ideal.Quotient.factor_mk hJ₀J _
      _ = ψ (f p) := hFp p

theorem wc_tinv_etale_lift_finite_nil : (∀ (R : Type u) [CommRing R] (I : Ideal R) (B : Type u) [CommRing B] [Algebra R B] [Algebra (R ⧸ I) B] [IsScalarTower R (R ⧸ I) B] [Algebra.Etale (R ⧸ I) B], ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R'), Algebra.Etale R R' ∧ Nonempty ((R' ⧸ I.map (algebraMap R R')) ≃ₐ[R] B)) → ∀ (R : Type u) [CommRing R] (I : Ideal R), I ≤ nilradical R → ∀ (B : Type u) [CommRing B] [Algebra R B] [Algebra (R ⧸ I) B] [IsScalarTower R (R ⧸ I) B] [Algebra.Etale (R ⧸ I) B] [Module.Finite (R ⧸ I) B], ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R'), Algebra.Etale R R' ∧ Module.Finite R R' ∧ Nonempty ((R' ⧸ I.map (algebraMap R R')) ≃ₐ[R] B) :=
by
  intro H R _ I hI B _ _ _ _ _ _
  obtain ⟨R', instR', instA, hEt, ⟨σ⟩⟩ := H R I B
  refine ⟨R', instR', instA, hEt, ?_, ⟨σ⟩⟩
  haveI := hEt
  haveI : Algebra.IsIntegral (R ⧸ I) B := Algebra.IsIntegral.of_finite (R ⧸ I) B
  haveI : Algebra.IsIntegral R B := Algebra.IsIntegral.trans (R ⧸ I)
  haveI : Algebra.IsIntegral R (R' ⧸ I.map (algebraMap R R')) :=
    Algebra.IsIntegral.of_surjective σ.symm.toAlgHom σ.symm.surjective
  have hJ : I.map (algebraMap R R') ≤ nilradical R' := by
    rw [Ideal.map_le_iff_le_comap]
    intro i hi
    rw [Ideal.mem_comap, mem_nilradical]
    exact (mem_nilradical.mp (hI hi)).map (algebraMap R R')
  haveI : Algebra.IsIntegral R R' := by
    constructor
    intro x
    obtain ⟨f, hf, hfx⟩ := Algebra.IsIntegral.isIntegral (R := R)
      (Ideal.Quotient.mkₐ R (I.map (algebraMap R R')) x)
    have h2 : Ideal.Quotient.mkₐ R (I.map (algebraMap R R')) (Polynomial.aeval x f) = 0 := by
      rw [← Polynomial.aeval_algHom_apply, Polynomial.aeval_def]
      exact hfx
    rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at h2
    obtain ⟨n, hn⟩ := mem_nilradical.mp (hJ h2)
    refine ⟨f ^ n, hf.pow n, ?_⟩
    rw [← Polynomial.aeval_def, map_pow, hn]
  exact Algebra.IsIntegral.finite

theorem wc_tinv_quotient_spec_isPullback : ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (I : Ideal R), IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap R R'))))) (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R') Ideal.le_comap_map))) (Spec.map (CommRingCat.ofHom (algebraMap R R'))) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
by
  intro R R' _ _ _ I
  apply AlgebraicGeometry.isPullback_SpecMap_of_isPushout
  have hcomm : ∀ r : R, Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R')
      Ideal.le_comap_map (Ideal.Quotient.mk I r) =
      Ideal.Quotient.mk (I.map (algebraMap R R')) (algebraMap R R' r) := fun r =>
    Ideal.quotientMap_mk
  have w : CommRingCat.ofHom (algebraMap R R') ≫
      CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap R R'))) =
      CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
      CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R')
        Ideal.le_comap_map) := by
    ext r
    exact (hcomm r).symm
  have key : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap R R'))
      (CommRingCat.ofHom (Ideal.Quotient.mk I))) (r : R),
      s.inl.hom (algebraMap R R' r) = s.inr.hom (Ideal.Quotient.mk I r) := by
    intro s r
    have := congrArg (fun φ => φ.hom r) s.condition
    simpa using this
  have H : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap R R'))
      (CommRingCat.ofHom (Ideal.Quotient.mk I))),
      I.map (algebraMap R R') ≤ RingHom.ker s.inl.hom := by
    intro s
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, key s x, Ideal.Quotient.eq_zero_iff_mem.mpr hx,
      map_zero]
  refine IsPushout.of_isColimit' ⟨w⟩ (Limits.PushoutCocone.IsColimit.mk w
    (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _ s.inl.hom (fun a ha => H s ha)))
    ?_ ?_ ?_)
  · intro s
    ext x
    exact Ideal.Quotient.lift_mk (I.map (algebraMap R R')) s.inl.hom (fun a ha => H s ha)
  · intro s
    ext x
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
      Function.comp_apply, hcomm, Ideal.Quotient.lift_mk]
    exact key s x
  · intro s m h1 _
    ext x
    have := congrArg (fun φ => φ.hom x) h1
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
      Function.comp_apply] at this
    simp only [CommRingCat.hom_ofHom, Ideal.Quotient.lift_mk]
    exact this

theorem wc_tinv_affine_case : (∀ (R S : CommRingCat.{u}) (f : R ⟶ S), Function.Surjective (Spec.map f) → RingHom.ker f.hom ≤ nilradical R) → (∀ (R : Type u) [CommRing R] (I : Ideal R), I ≤ nilradical R → ∀ (B : Type u) [CommRing B] [Algebra R B] [Algebra (R ⧸ I) B] [IsScalarTower R (R ⧸ I) B] [Algebra.Etale (R ⧸ I) B] [Module.Finite (R ⧸ I) B], ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R'), Algebra.Etale R R' ∧ Module.Finite R R' ∧ Nonempty ((R' ⧸ I.map (algebraMap R R')) ≃ₐ[R] B)) → (∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (I : Ideal R), IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap R R'))))) (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R') Ideal.le_comap_map))) (Spec.map (CommRingCat.ofHom (algebraMap R R'))) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) → ∀ (T T' : Scheme.{u}) (k : T ⟶ T') [IsClosedImmersion k] [IsAffine T'], Function.Surjective k → ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ T), IsFinite p₀ → Etale p₀ → ∃ (V : Scheme.{u}) (p : V ⟶ T') (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p k :=
by
  intro H1 H4 H5 T T' k _ _ hk V₀ p₀ hf he
  haveI := hf
  haveI := he

  obtain ⟨I, e, hκ⟩ := IsClosedImmersion.Spec_iff.mp
    (inferInstance : IsClosedImmersion (k ≫ T'.isoSpec.hom))
  have hek : e.inv ≫ k = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ T'.isoSpec.inv := by
    have hk' : k = (k ≫ T'.isoSpec.hom) ≫ T'.isoSpec.inv := by simp
    rw [hk', hκ]
    simp
  have hmk : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) = e.inv ≫ k ≫ T'.isoSpec.hom := by
    rw [hκ]
    simp
  have hsurj : Function.Surjective (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
    rw [hmk]
    have hfun : ⇑(e.inv ≫ k ≫ T'.isoSpec.hom) = ⇑T'.isoSpec.hom ∘ ⇑k ∘ ⇑e.inv := by
      funext x
      simp only [Function.comp_apply, Scheme.Hom.comp_apply]
    rw [hfun]
    exact (T'.isoSpec.hom.surjective).comp (hk.comp e.inv.surjective)
  have hI : I ≤ nilradical Γ(T', ⊤) := by
    have := H1 Γ(T', ⊤) (CommRingCat.of (Γ(T', ⊤) ⧸ I)) (CommRingCat.ofHom (Ideal.Quotient.mk I))
      hsurj
    rwa [CommRingCat.hom_ofHom, Ideal.mk_ker] at this

  haveI : IsAffineHom (p₀ ≫ e.hom) := inferInstance
  haveI : IsAffine V₀ := isAffine_of_isAffineHom (p₀ ≫ e.hom)
  let β : CommRingCat.of (Γ(T', ⊤) ⧸ I) ⟶ Γ(V₀, ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of (Γ(T', ⊤) ⧸ I))).inv ≫ (p₀ ≫ e.hom).appTop
  have hβ : V₀.isoSpec.hom ≫ Spec.map β = p₀ ≫ e.hom := by
    simp only [β, Spec.map_comp]
    rw [← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc, Scheme.isoSpec_Spec_hom,
      ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
  have hSpecβ : Spec.map β = V₀.isoSpec.inv ≫ p₀ ≫ e.hom := by
    rw [← hβ, Iso.inv_hom_id_assoc]
  haveI hβfS : IsFinite (Spec.map β) := by rw [hSpecβ]; infer_instance
  haveI hβeS : Etale (Spec.map β) := by rw [hSpecβ]; infer_instance
  have hβf : β.hom.Finite := (IsFinite.SpecMap_iff β).mp hβfS
  have hβe : β.hom.Etale := (HasRingHomProperty.Spec_iff (P := @Etale)).mp hβeS

  let βr : (Γ(T', ⊤) ⧸ I) →+* Γ(V₀, ⊤) := β.hom
  letI alg1 : Algebra (Γ(T', ⊤) ⧸ I) Γ(V₀, ⊤) := βr.toAlgebra
  letI alg2 : Algebra Γ(T', ⊤) Γ(V₀, ⊤) := (βr.comp (Ideal.Quotient.mk I)).toAlgebra
  haveI : IsScalarTower Γ(T', ⊤) (Γ(T', ⊤) ⧸ I) Γ(V₀, ⊤) := IsScalarTower.of_algebraMap_eq' rfl
  haveI : Algebra.Etale (Γ(T', ⊤) ⧸ I) Γ(V₀, ⊤) := RingHom.etale_algebraMap.mp hβe
  haveI : Module.Finite (Γ(T', ⊤) ⧸ I) Γ(V₀, ⊤) := RingHom.finite_algebraMap.mp hβf
  obtain ⟨R', _, _, hR'e, hR'f, ⟨τ⟩⟩ := H4 Γ(T', ⊤) I hI Γ(V₀, ⊤)
  have hσ : τ.toRingEquiv.toRingHom.comp (Ideal.quotientMap (I.map (algebraMap Γ(T', ⊤) R'))
      (algebraMap Γ(T', ⊤) R') Ideal.le_comap_map) = βr := by
    apply Ideal.Quotient.ringHom_ext
    ext r
    simp only [RingHom.comp_apply, Ideal.quotientMap_mk]
    change τ (Ideal.Quotient.mk _ (algebraMap Γ(T', ⊤) R' r)) = _
    rw [Ideal.Quotient.mk_algebraMap, τ.commutes]
    rfl

  let eσ : Spec Γ(V₀, ⊤) ≅ Spec (CommRingCat.of (R' ⧸ I.map (algebraMap Γ(T', ⊤) R'))) :=
    { hom := Spec.map (CommRingCat.ofHom τ.toRingEquiv.toRingHom)
      inv := Spec.map (CommRingCat.ofHom τ.toRingEquiv.symm.toRingHom)
      hom_inv_id := by
        have h : CommRingCat.ofHom τ.toRingEquiv.symm.toRingHom ≫
            CommRingCat.ofHom τ.toRingEquiv.toRingHom = 𝟙 _ := by
          ext x
          simp
        rw [← Spec.map_comp, h]
        exact Spec.map_id _
      inv_hom_id := by
        have h : CommRingCat.ofHom τ.toRingEquiv.toRingHom ≫
            CommRingCat.ofHom τ.toRingEquiv.symm.toRingHom = 𝟙 _ := by
          ext x
          simp
        rw [← Spec.map_comp, h]
        exact Spec.map_id _ }
  have h1 : eσ.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.quotientMap
      (I.map (algebraMap Γ(T', ⊤) R')) (algebraMap Γ(T', ⊤) R') Ideal.le_comap_map)) =
      Spec.map β := by
    change Spec.map (CommRingCat.ofHom τ.toRingEquiv.toRingHom) ≫ _ = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hσ]
    rfl
  have h2 : Spec.map (CommRingCat.ofHom (Ideal.quotientMap
      (I.map (algebraMap Γ(T', ⊤) R')) (algebraMap Γ(T', ⊤) R') Ideal.le_comap_map)) =
      eσ.inv ≫ Spec.map β := by
    rw [← h1, Iso.inv_hom_id_assoc]
  have hpf : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap Γ(T', ⊤) R'))) := by
    rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
    exact RingHom.finite_algebraMap.mpr hR'f
  have hpe : Etale (Spec.map (CommRingCat.ofHom (algebraMap Γ(T', ⊤) R'))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Etale), CommRingCat.hom_ofHom]
    exact RingHom.etale_algebraMap.mpr hR'e
  refine ⟨Spec (CommRingCat.of R'),
    Spec.map (CommRingCat.ofHom (algebraMap Γ(T', ⊤) R')) ≫ T'.isoSpec.inv,
    V₀.isoSpec.hom ≫ eσ.hom ≫
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap Γ(T', ⊤) R')))),
    inferInstance, inferInstance, ?_⟩
  refine IsPullback.of_iso (H5 Γ(T', ⊤) R' I) (V₀.isoSpec ≪≫ eσ).symm (Iso.refl _) e.symm
    T'.isoSpec.symm ?_ ?_ ?_ ?_
  · simp
  · rw [h2, hSpecβ]
    simp
  · simp
  · exact hek.symm

theorem wc_tinv_affine_hom_lift : (∀ (R S : CommRingCat.{u}) (f : R ⟶ S), Function.Surjective (Spec.map f) → RingHom.ker f.hom ≤ nilradical R) → (∀ (R A C : Type u) [CommRing R] [CommRing A] [CommRing C] [Algebra R A] [Algebra R C] [Algebra.Etale R A] (J : Ideal C), J ≤ nilradical C → Function.Bijective (fun φ : A →ₐ[R] C => (Ideal.Quotient.mkₐ R J).comp φ)) → ∀ (S X X₀ W : Scheme.{u}) [IsAffine S] [IsAffine X] [IsAffine W] (jX : X₀ ⟶ X) [IsClosedImmersion jX], Function.Surjective jX → ∀ (pX : X ⟶ S) (pW : W ⟶ S), Etale pW → ∀ ψ₀ : X₀ ⟶ W, ψ₀ ≫ pW = jX ≫ pX → ∃! φ : X ⟶ W, φ ≫ pW = pX ∧ jX ≫ φ = ψ₀ :=
by
  intro H1 H2 S X X₀ W _ _ _ jX _ hjX pX pW hpW ψ₀ hψ

  have s1 : ∀ (R A C C₀ : Type u) [CommRing R] [CommRing A] [CommRing C] [CommRing C₀]
      (a : R →+* A) (c : R →+* C) (ρ : C →+* C₀) (ψ : A →+* C₀), a.Etale →
      Function.Surjective ρ → RingHom.ker ρ ≤ nilradical C → ψ.comp a = ρ.comp c →
      ∃! g : A →+* C, g.comp a = c ∧ ρ.comp g = ψ := by
    intro R A C C₀ _ _ _ _ a c ρ ψ ha hρ hker hcomm
    letI : Algebra R A := a.toAlgebra
    letI : Algebra R C := c.toAlgebra
    haveI : Algebra.Etale R A := (RingHom.etale_algebraMap (R := R) (S := A)).mp ha
    let e : C ⧸ RingHom.ker ρ ≃+* C₀ := RingHom.quotientKerEquivOfSurjective hρ
    have he : ∀ x, e (Ideal.Quotient.mk (RingHom.ker ρ) x) = ρ x := fun x =>
      RingHom.quotientKerEquivOfSurjective_apply_mk hρ x
    have he' : ∀ x, e.symm (ρ x) = Ideal.Quotient.mk (RingHom.ker ρ) x := fun x => by
      rw [RingEquiv.symm_apply_eq, he]
    let ψ' : A →ₐ[R] C ⧸ RingHom.ker ρ := AlgHom.mk (e.symm.toRingHom.comp ψ) (fun r => by
      show e.symm (ψ (a r)) = algebraMap R (C ⧸ RingHom.ker ρ) r
      have h1 : ψ (a r) = ρ (c r) := RingHom.congr_fun hcomm r
      rw [h1, he']
      exact Ideal.Quotient.mk_algebraMap R (RingHom.ker ρ) r)
    obtain ⟨φ, hφ⟩ := (H2 R A C (RingHom.ker ρ) hker).2 ψ'
    have hφx : ∀ x, Ideal.Quotient.mk (RingHom.ker ρ) (φ x) = e.symm (ψ x) := fun x =>
      AlgHom.congr_fun hφ x
    refine ⟨(φ : A →+* C), ⟨?_, ?_⟩, ?_⟩
    · exact AlgHom.comp_algebraMap φ
    · apply RingHom.ext
      intro x
      show ρ (φ x) = ψ x
      rw [← he, hφx, RingEquiv.apply_symm_apply]
    · rintro g ⟨hg1, hg2⟩
      let φ' : A →ₐ[R] C := AlgHom.mk g (fun r => RingHom.congr_fun hg1 r)
      have hφ' : (Ideal.Quotient.mkₐ R (RingHom.ker ρ)).comp φ' = ψ' := by
        apply AlgHom.ext
        intro x
        show Ideal.Quotient.mk (RingHom.ker ρ) (g x) = e.symm (ψ x)
        rw [← he']
        exact congrArg e.symm (RingHom.congr_fun hg2 x)
      have hinj := (H2 R A C (RingHom.ker ρ) hker).1 (hφ'.trans hφ.symm)
      apply RingHom.ext
      intro x
      exact AlgHom.congr_fun hinj x

  have s2 : ∀ (X Y : Scheme.{u}) [IsAffine X] [IsAffine Y] (g : Γ(Y, ⊤) ⟶ Γ(X, ⊤)),
      ∃ f : X ⟶ Y, f.appTop = g := by
    intro X Y _ _ g
    refine ⟨X.isoSpec.hom ≫ Spec.map g ≫ Y.isoSpec.inv, ?_⟩
    apply Spec.map_injective
    rw [← cancel_epi X.isoSpec.hom, Scheme.isoSpec_hom_naturality]
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]

  obtain ⟨hX₀, hρs⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine jX
  haveI := hX₀
  have hker : RingHom.ker jX.appTop.hom ≤ nilradical Γ(X, ⊤) := by
    apply H1
    have e : Spec.map jX.appTop = X₀.isoSpec.inv ≫ jX ≫ X.isoSpec.hom := by
      rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
    rw [e]
    intro y
    obtain ⟨x1, hx1⟩ := Scheme.Hom.surjective X.isoSpec.hom y
    obtain ⟨x2, hx2⟩ := hjX x1
    obtain ⟨x3, hx3⟩ := Scheme.Hom.surjective X₀.isoSpec.inv x2
    exact ⟨x3, by rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hx3, hx2, hx1]⟩

  have hA : (pW.appTop.hom).Etale := by
    have := HasRingHomProperty.appTop @Etale pW hpW
    exact this
  have hcomm : ψ₀.appTop.hom.comp pW.appTop.hom = jX.appTop.hom.comp pX.appTop.hom := by
    have := congrArg (fun f : X₀ ⟶ S => (Scheme.Hom.appTop f).hom) hψ
    simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp] using this
  obtain ⟨g, ⟨hg1, hg2⟩, hU⟩ := s1 _ _ _ _ pW.appTop.hom pX.appTop.hom jX.appTop.hom
    ψ₀.appTop.hom hA hρs hker hcomm
  obtain ⟨φ, hφ⟩ := s2 X W (CommRingCat.ofHom g)
  have hφg : φ.appTop.hom = g := by rw [hφ, CommRingCat.hom_ofHom]
  refine ⟨φ, ⟨?_, ?_⟩, ?_⟩
  · apply ext_of_isAffine
    apply CommRingCat.hom_ext
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, hφg, hg1]
  · apply ext_of_isAffine
    apply CommRingCat.hom_ext
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, hφg, hg2]
  · rintro φ' ⟨h1, h2⟩
    have e1 : φ'.appTop.hom.comp pW.appTop.hom = pX.appTop.hom := by
      rw [← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, h1]
    have e2 : jX.appTop.hom.comp φ'.appTop.hom = ψ₀.appTop.hom := by
      rw [← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, h2]
    have hg' := hU _ ⟨e1, e2⟩
    apply ext_of_isAffine
    apply CommRingCat.hom_ext
    rw [hg', hφg]

theorem wc_tinv_isPullback_detect : (∀ (S X Y X₀ Y₀ : Scheme.{u}) [IsAffine S] [IsAffine X] [IsAffine Y] (pX : X ⟶ S) (pY : Y ⟶ S) (θ : X ⟶ Y) (jX : X₀ ⟶ X) (jY : Y₀ ⟶ Y) [IsClosedImmersion jX] [IsClosedImmersion jY], Function.Surjective jX → Function.Surjective jY → Etale pX → Etale pY → θ ≫ pY = pX → ∀ θ₀ : X₀ ⟶ Y₀, IsIso θ₀ → θ₀ ≫ jY = jX ≫ θ → IsIso θ) → ∀ (U U' T₁ T₁' X Y' X₀ Y₀ : Scheme.{u}) [IsAffine U] [IsAffine X] (e : U ⟶ U') (kU : T₁ ⟶ U) (kU' : T₁' ⟶ U') (t : T₁ ⟶ T₁') [IsClosedImmersion kU'], Function.Surjective kU' → IsPullback t kU kU' e → ∀ (q : X ⟶ U) (q' : Y' ⟶ U') (jX : X₀ ⟶ X) (pX₀ : X₀ ⟶ T₁) (jY : Y₀ ⟶ Y') (pY₀ : Y₀ ⟶ T₁') (v : X₀ ⟶ Y₀) (φ : X ⟶ Y'), Etale q → Etale q' → IsAffineHom q' → IsPullback jX pX₀ q kU → IsPullback jY pY₀ q' kU' → IsPullback v pX₀ pY₀ t → φ ≫ q' = q ≫ e → jX ≫ φ = v ≫ jY → IsPullback φ q q' e :=
by
  intro H8 U U' T₁ T₁' X Y' X₀ Y₀ _ _ e kU kU' t _ hkU' hT q q' jX pX₀ jY pY₀ v φ hq hq' hq'a
    hX hY hV hφ hjφ
  let P := Limits.pullback q' e
  let π₁ : P ⟶ Y' := Limits.pullback.fst q' e
  let π₂ : P ⟶ U := Limits.pullback.snd q' e
  have c1 : π₁ ≫ q' = π₂ ≫ e := Limits.pullback.condition
  let θ : X ⟶ P := Limits.pullback.lift φ q hφ
  have θ1 : θ ≫ π₁ = φ := Limits.pullback.lift_fst _ _ _
  have θ2 : θ ≫ π₂ = q := Limits.pullback.lift_snd _ _ _
  have hPB : IsPullback π₁ π₂ q' e := IsPullback.of_hasPullback q' e
  haveI hkUc : IsClosedImmersion kU :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hT inferInstance
  have hkUs' : Surjective kU' := (surjective_iff kU').mpr hkU'
  have hkUs : Surjective kU := MorphismProperty.of_isPullback (P := @Surjective) hT hkUs'
  haveI hjXc : IsClosedImmersion jX :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hX.flip hkUc
  have hjXs : Surjective jX := MorphismProperty.of_isPullback (P := @Surjective) hX.flip hkUs
  haveI hπ₂e : Etale π₂ := MorphismProperty.of_isPullback (P := @Etale) hPB hq'
  haveI hπ₂a : IsAffineHom π₂ := MorphismProperty.of_isPullback (P := @IsAffineHom) hPB hq'a
  haveI : IsAffine P := isAffine_of_isAffineHom π₂
  let P₀ := Limits.pullback π₂ kU
  let ρ₁ : P₀ ⟶ P := Limits.pullback.fst π₂ kU
  let ρ₂ : P₀ ⟶ T₁ := Limits.pullback.snd π₂ kU
  have c0 : ρ₁ ≫ π₂ = ρ₂ ≫ kU := Limits.pullback.condition
  have hPB0 : IsPullback ρ₁ ρ₂ π₂ kU := IsPullback.of_hasPullback π₂ kU
  haveI hρ₁c : IsClosedImmersion ρ₁ :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hPB0.flip hkUc
  have hρ₁s : Surjective ρ₁ := MorphismProperty.of_isPullback (P := @Surjective) hPB0.flip hkUs
  have w₀ : (jX ≫ θ) ≫ π₂ = pX₀ ≫ kU := by
    rw [Category.assoc, θ2]; exact hX.w
  let θ₀ : X₀ ⟶ P₀ := Limits.pullback.lift (jX ≫ θ) pX₀ w₀
  have θ₀1 : θ₀ ≫ ρ₁ = jX ≫ θ := Limits.pullback.lift_fst _ _ _
  have θ₀2 : θ₀ ≫ ρ₂ = pX₀ := Limits.pullback.lift_snd _ _ _
  have hw : (ρ₁ ≫ π₁) ≫ q' = (ρ₂ ≫ t) ≫ kU' := by
    simp only [Category.assoc]
    rw [c1, reassoc_of% c0, ← hT.w]
  let w : P₀ ⟶ Y₀ := hY.lift (ρ₁ ≫ π₁) (ρ₂ ≫ t) hw
  have w1 : w ≫ jY = ρ₁ ≫ π₁ := hY.lift_fst _ _ _
  have w2 : w ≫ pY₀ = ρ₂ ≫ t := hY.lift_snd _ _ _
  have Big : IsPullback (ρ₁ ≫ π₁) ρ₂ q' (kU ≫ e) := hPB0.paste_horiz hPB
  have Big' : IsPullback (w ≫ jY) ρ₂ q' (t ≫ kU') := by
    rw [w1, hT.w]; exact Big
  have hW : IsPullback w ρ₂ pY₀ t := IsPullback.of_right Big' w2 hY
  have hθ₀w : θ₀ ≫ w = v := by
    apply hY.hom_ext
    · rw [Category.assoc, w1, ← Category.assoc, θ₀1, Category.assoc, θ1, hjφ]
    · rw [Category.assoc, w2, ← Category.assoc, θ₀2, ← hV.w]
  have hε : (IsPullback.isoIsPullback Y₀ T₁ hV hW).hom = θ₀ := by
    apply hW.hom_ext
    · rw [IsPullback.isoIsPullback_hom_fst, hθ₀w]
    · rw [IsPullback.isoIsPullback_hom_snd, θ₀2]
  haveI : IsIso θ₀ := hε ▸ Iso.isIso_hom (IsPullback.isoIsPullback Y₀ T₁ hV hW)
  haveI : IsIso θ := H8 U X P X₀ P₀ q π₂ θ jX ρ₁ ((surjective_iff jX).mp hjXs)
    ((surjective_iff ρ₁).mp hρ₁s) hq hπ₂e θ2 θ₀ inferInstance θ₀1
  exact IsPullback.of_iso_pullback ⟨hφ⟩ (asIso θ) θ1 θ2

theorem wc_tinv_glue_affine_family : ∀ (T' : Scheme.{u}) (W : T'.affineOpens → Scheme.{u}) (q : ∀ U, W U ⟶ (U.1 : Scheme.{u})) (φ : ∀ U U' : T'.affineOpens, U ≤ U' → (W U ⟶ W U')), (∀ U, φ U U le_rfl = 𝟙 _) → (∀ (U U' U'' : T'.affineOpens) (h : U ≤ U') (h' : U' ≤ U''), φ U U' h ≫ φ U' U'' h' = φ U U'' (h.trans h')) → (∀ (U U' : T'.affineOpens) (h : U ≤ U'), IsPullback (φ U U' h) (q U) (q U') (T'.homOfLE h)) → ∃ (V : Scheme.{u}) (p : V ⟶ T') (ι : ∀ U, W U ⟶ V), (∀ U, IsPullback (ι U) (q U) p U.1.ι) ∧ (∀ (U U' : T'.affineOpens) (h : U ≤ U'), φ U U' h ≫ ι U' = ι U) :=
by
  intro T' W q φ H1 H2 H3
  let F : T'.directedAffineCover.I₀ ⥤ Scheme.{u} :=
    { obj := fun U => W U
      map := fun {U U'} f => φ U U' (leOfHom f)
      map_id := fun U => H1 U
      map_comp := fun {U U' U''} f g => (H2 U U' U'' (leOfHom f) (leOfHom g)).symm }
  let α : F ⟶ T'.directedAffineCover.functorOfLocallyDirected :=
    { app := fun U => q U
      naturality := fun U U' f => (H3 U U' (leOfHom f)).w }
  have hα : NatTrans.Equifibered α := fun U U' f => H3 U U' (leOfHom f)
  have key : ∀ d : T'.directedAffineCover.RelativeGluingData, ∃ (V : Scheme.{u}) (p : V ⟶ T')
      (ι : ∀ U : T'.directedAffineCover.I₀, d.functor.obj U ⟶ V),
      (∀ U, IsPullback (ι U) (d.natTrans.app U) p (T'.directedAffineCover.f U)) ∧
      (∀ (U U' : T'.directedAffineCover.I₀) (f : U ⟶ U'), d.functor.map f ≫ ι U' = ι U) := by
    intro d
    exact ⟨d.glued, d.toBase, fun U => Limits.colimit.ι d.functor U,
      fun U => (d.isPullback_natTrans_ι_toBase U).flip,
      fun U U' f => Limits.colimit.w d.functor f⟩
  obtain ⟨V, p, ι, h1, h2⟩ := key ⟨F, α, hα⟩
  exact ⟨V, p, ι, h1, fun U U' h => h2 U U' (homOfLE h)⟩

theorem wc_tinv_isPullback_of_local : ∀ (V₀ V T T' : Scheme.{u}) (j : V₀ ⟶ V) (p₀ : V₀ ⟶ T) (p : V ⟶ T') (k : T ⟶ T') (ι : Type u) (S : ι → Scheme.{u}) (s : ∀ i, S i ⟶ T'), (∀ i, IsOpenImmersion (s i)) → (∀ x : T', ∃ i, x ∈ Set.range (s i)) → j ≫ p = p₀ ≫ k → (∀ i, ∃ (A B C : Scheme.{u}) (a : A ⟶ V₀) (b : B ⟶ V) (c : C ⟶ T) (jA : A ⟶ B) (pA : A ⟶ C) (pB : B ⟶ S i) (kC : C ⟶ S i), IsPullback b pB p (s i) ∧ IsPullback c kC k (s i) ∧ IsPullback a pA p₀ c ∧ jA ≫ b = a ≫ j ∧ IsPullback jA pA pB kC) → IsPullback j p₀ p k :=
by
  intro V₀ V T T' j p₀ p k ι S s hs hcov hw hloc
  choose A B C a b c jA pA pB kC H1 H2 H3 H4 H5 using hloc
  have hb : ∀ i, IsOpenImmersion (b i) := fun i =>
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) (H1 i).flip (hs i)
  have hc : ∀ x : V, ∃ i y, b i y = x := by
    intro x
    obtain ⟨i, hi⟩ := hcov (p x)
    have hx : x ∈ Set.range (Limits.pullback.fst p (s i)) := by
      rw [Scheme.Pullback.range_fst]; exact hi
    obtain ⟨w, hw'⟩ := hx
    refine ⟨i, (H1 i).isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hw']
  let 𝒰 : V.OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) ι B b hc hb
  apply Scheme.isPullback_of_openCover (𝒰 := 𝒰)
  intro i
  have Q1 : IsPullback (a i) (jA i) j (b i) := by
    refine IsPullback.of_bot ?_ (H4 i).symm (H1 i)
    have := (H3 i).paste_vert (H2 i)
    rw [← (H5 i).w, ← hw] at this
    exact this
  have P2 : IsPullback (jA i) (pA i ≫ c i) (b i ≫ p) k := by
    have := (H5 i).paste_vert (H2 i).flip
    rw [← (H1 i).w] at this
    exact this
  have L : IsPullback (Limits.pullback.snd j (b i)) (Limits.pullback.fst j (b i) ≫ p₀)
      (b i ≫ p) k := by
    refine IsPullback.of_iso P2 Q1.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp [IsPullback.isoPullback_hom_snd]
    · rw [Iso.refl_hom, Category.comp_id, ← Category.assoc, IsPullback.isoPullback_hom_fst,
        (H3 i).w]
    · simp
    · simp
  exact L

theorem wc_tinv_glue_family_to_global : (∀ (T' : Scheme.{u}) (W : T'.affineOpens → Scheme.{u}) (q : ∀ U, W U ⟶ (U.1 : Scheme.{u})) (φ : ∀ U U' : T'.affineOpens, U ≤ U' → (W U ⟶ W U')), (∀ U, φ U U le_rfl = 𝟙 _) → (∀ (U U' U'' : T'.affineOpens) (h : U ≤ U') (h' : U' ≤ U''), φ U U' h ≫ φ U' U'' h' = φ U U'' (h.trans h')) → (∀ (U U' : T'.affineOpens) (h : U ≤ U'), IsPullback (φ U U' h) (q U) (q U') (T'.homOfLE h)) → ∃ (V : Scheme.{u}) (p : V ⟶ T') (ι : ∀ U, W U ⟶ V), (∀ U, IsPullback (ι U) (q U) p U.1.ι) ∧ (∀ (U U' : T'.affineOpens) (h : U ≤ U'), φ U U' h ≫ ι U' = ι U)) → (∀ (V₀ V T T' : Scheme.{u}) (j : V₀ ⟶ V) (p₀ : V₀ ⟶ T) (p : V ⟶ T') (k : T ⟶ T') (ι : Type u) (S : ι → Scheme.{u}) (s : ∀ i, S i ⟶ T'), (∀ i, IsOpenImmersion (s i)) → (∀ x : T', ∃ i, x ∈ Set.range (s i)) → j ≫ p = p₀ ≫ k → (∀ i, ∃ (A B C : Scheme.{u}) (a : A ⟶ V₀) (b : B ⟶ V) (c : C ⟶ T) (jA : A ⟶ B) (pA : A ⟶ C) (pB : B ⟶ S i) (kC : C ⟶ S i), IsPullback b pB p (s i) ∧ IsPullback c kC k (s i) ∧ IsPullback a pA p₀ c ∧ jA ≫ b = a ≫ j ∧ IsPullback jA pA pB kC) → IsPullback j p₀ p k) → (∀ (T T' V₀ U : Scheme.{u}) (k : T ⟶ T') (p₀ : V₀ ⟶ T) (u : U ⟶ T') (r : Limits.pullback (p₀ ≫ k) u ⟶ Limits.pullback k u), r ≫ Limits.pullback.fst k u = Limits.pullback.fst (p₀ ≫ k) u ≫ p₀ → r ≫ Limits.pullback.snd k u = Limits.pullback.snd (p₀ ≫ k) u → IsPullback (Limits.pullback.fst (p₀ ≫ k) u) r p₀ (Limits.pullback.fst k u)) → ∀ (T T' : Scheme.{u}) (k : T ⟶ T') (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ T) (W : T'.affineOpens → Scheme.{u}) (q : ∀ U, W U ⟶ (U.1 : Scheme.{u})) (r : ∀ U : T'.affineOpens, Limits.pullback (p₀ ≫ k) U.1.ι ⟶ Limits.pullback k U.1.ι) (jW : ∀ U : T'.affineOpens, Limits.pullback (p₀ ≫ k) U.1.ι ⟶ W U) (φ : ∀ U U' : T'.affineOpens, U ≤ U' → (W U ⟶ W U')), (∀ U, IsFinite (q U)) → (∀ U, Etale (q U)) → (∀ U, r U ≫ Limits.pullback.fst k U.1.ι = Limits.pullback.fst (p₀ ≫ k) U.1.ι ≫ p₀) → (∀ U, r U ≫ Limits.pullback.snd k U.1.ι = Limits.pullback.snd (p₀ ≫ k) U.1.ι) → (∀ U, IsPullback (jW U) (r U) (q U) (Limits.pullback.snd k U.1.ι)) → (∀ U, φ U U le_rfl = 𝟙 _) → (∀ (U U' U'' : T'.affineOpens) (h : U ≤ U') (h' : U' ≤ U''), φ U U' h ≫ φ U' U'' h' = φ U U'' (h.trans h')) → (∀ (U U' : T'.affineOpens) (h : U ≤ U'), IsPullback (φ U U' h) (q U) (q U') (T'.homOfLE h)) → (∀ (U U' : T'.affineOpens) (h : U ≤ U'), jW U ≫ φ U U' h = Limits.pullback.map (p₀ ≫ k) U.1.ι (p₀ ≫ k) U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫ jW U') → ∃ (V : Scheme.{u}) (p : V ⟶ T') (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p k :=
by
  intro G L Rs T T' k V₀ p₀ W q r jW φ hqf hqe hr1 hr2 hjW hφid hφcomp hφpb hjWφ
  obtain ⟨V, p, ι, hι, hιφ⟩ := G T' W q φ hφid hφcomp hφpb
  have hsnd : ∀ U : T'.affineOpens,
      (hι U).isoPullback.inv ≫ q U = Limits.pullback.snd p U.1.ι :=
    fun U => (hι U).isoPullback_inv_snd
  have hpf : IsFinite p := by
    set_option backward.isDefEq.respectTransparency.types false in
    refine IsZariskiLocalAtTarget.of_openCover (P := @IsFinite) T'.directedAffineCover ?_
    intro (U : T'.affineOpens)
    change IsFinite (Limits.pullback.snd p U.1.ι)
    rw [← hsnd U]
    haveI := hqf U
    infer_instance
  have hpe : Etale p := by
    set_option backward.isDefEq.respectTransparency.types false in
    refine IsZariskiLocalAtTarget.of_openCover (P := @Etale) T'.directedAffineCover ?_
    intro (U : T'.affineOpens)
    change Etale (Limits.pullback.snd p U.1.ι)
    rw [← hsnd U]
    haveI := hqe U
    infer_instance
  have glue : ∀ (Y : Scheme.{u}) (f : V₀ ⟶ T') (g : ∀ U : T'.affineOpens, Limits.pullback f U.1.ι ⟶ Y),
      (∀ (U U' : T'.affineOpens) (h : U ≤ U'), Limits.pullback.map f U.1.ι f U'.1.ι (𝟙 _)
        (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫ g U' = g U) →
      ∃ j : V₀ ⟶ Y, ∀ U : T'.affineOpens, Limits.pullback.fst f U.1.ι ≫ j = g U :=
    fun Y f g hg => ⟨Scheme.OpenCover.glueMorphismsOfLocallyDirected
      (Precoverage.ZeroHypercover.pullback₁ f T'.directedAffineCover) g
      (fun {U U'} hUU => hg U U' (leOfHom hUU)),
    fun U => Scheme.OpenCover.map_glueMorphismsOfLocallyDirected
      (Precoverage.ZeroHypercover.pullback₁ f T'.directedAffineCover) g
      (fun {U U'} hUU => hg U U' (leOfHom hUU)) U⟩
  have ext : ∀ (Y : Scheme.{u}) (f : V₀ ⟶ T') (a b : V₀ ⟶ Y),
      (∀ U : T'.affineOpens, Limits.pullback.fst f U.1.ι ≫ a = Limits.pullback.fst f U.1.ι ≫ b) →
      a = b :=
    fun Y f a b H =>
      Scheme.Cover.hom_ext (Precoverage.ZeroHypercover.pullback₁ f T'.directedAffineCover) a b H
  obtain ⟨j, hj⟩ := glue V (p₀ ≫ k) (fun U => jW U ≫ ι U) (by
    intro U U' h
    rw [← Category.assoc, ← hjWφ U U' h, Category.assoc, hιφ])
  have hcomm : j ≫ p = p₀ ≫ k := by
    apply ext T' (p₀ ≫ k)
    intro U
    rw [reassoc_of% (hj U), (hι U).w, reassoc_of% (hjW U).w,
      ← Limits.pullback.condition (f := k) (g := U.1.ι), reassoc_of% (hr1 U)]
  have hcov : ∀ x : T', ∃ U : T'.affineOpens, x ∈ Set.range U.1.ι := by
    intro x
    obtain ⟨U, y, hy⟩ := T'.directedAffineCover.exists_eq x
    exact ⟨U, y, hy⟩
  refine ⟨V, p, j, hpf, hpe, ?_⟩
  refine L V₀ V T T' j p₀ p k T'.affineOpens (fun U => (U.1 : Scheme.{u}))
    (fun U => U.1.ι) (fun U => inferInstance) hcov hcomm ?_
  intro U
  exact ⟨_, _, _, Limits.pullback.fst (p₀ ≫ k) U.1.ι, ι U, Limits.pullback.fst k U.1.ι, jW U,
    r U, q U, Limits.pullback.snd k U.1.ι, hι U, IsPullback.of_hasPullback _ _,
    Rs T T' V₀ (U.1 : Scheme.{u}) k p₀ U.1.ι (r U) (hr1 U) (hr2 U), (hj U).symm, hjW U⟩

theorem wc_tinv_local_family_exists : (∀ (T T' : Scheme.{u}) (k : T ⟶ T') [IsClosedImmersion k] [IsAffine T'], Function.Surjective k → ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ T), IsFinite p₀ → Etale p₀ → ∃ (V : Scheme.{u}) (p : V ⟶ T') (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p k) → (∀ (S X X₀ W : Scheme.{u}) [IsAffine S] [IsAffine X] [IsAffine W] (jX : X₀ ⟶ X) [IsClosedImmersion jX], Function.Surjective jX → ∀ (pX : X ⟶ S) (pW : W ⟶ S), Etale pW → ∀ ψ₀ : X₀ ⟶ W, ψ₀ ≫ pW = jX ≫ pX → ∃! φ : X ⟶ W, φ ≫ pW = pX ∧ jX ≫ φ = ψ₀) → (∀ (U U' T₁ T₁' X Y' X₀ Y₀ : Scheme.{u}) [IsAffine U] [IsAffine X] (e : U ⟶ U') (kU : T₁ ⟶ U) (kU' : T₁' ⟶ U') (t : T₁ ⟶ T₁') [IsClosedImmersion kU'], Function.Surjective kU' → IsPullback t kU kU' e → ∀ (q : X ⟶ U) (q' : Y' ⟶ U') (jX : X₀ ⟶ X) (pX₀ : X₀ ⟶ T₁) (jY : Y₀ ⟶ Y') (pY₀ : Y₀ ⟶ T₁') (v : X₀ ⟶ Y₀) (φ : X ⟶ Y'), Etale q → Etale q' → IsAffineHom q' → IsPullback jX pX₀ q kU → IsPullback jY pY₀ q' kU' → IsPullback v pX₀ pY₀ t → φ ≫ q' = q ≫ e → jX ≫ φ = v ≫ jY → IsPullback φ q q' e) → (∀ (T T' V₀ U : Scheme.{u}) (k : T ⟶ T') (p₀ : V₀ ⟶ T) (u : U ⟶ T') (r : Limits.pullback (p₀ ≫ k) u ⟶ Limits.pullback k u), r ≫ Limits.pullback.fst k u = Limits.pullback.fst (p₀ ≫ k) u ≫ p₀ → r ≫ Limits.pullback.snd k u = Limits.pullback.snd (p₀ ≫ k) u → IsPullback (Limits.pullback.fst (p₀ ≫ k) u) r p₀ (Limits.pullback.fst k u)) → ∀ (T T' : Scheme.{u}) (k : T ⟶ T') [IsClosedImmersion k], Function.Surjective k → ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ T), IsFinite p₀ → Etale p₀ → ∃ (W : T'.affineOpens → Scheme.{u}) (q : ∀ U, W U ⟶ (U.1 : Scheme.{u})) (r : ∀ U : T'.affineOpens, Limits.pullback (p₀ ≫ k) U.1.ι ⟶ Limits.pullback k U.1.ι) (jW : ∀ U : T'.affineOpens, Limits.pullback (p₀ ≫ k) U.1.ι ⟶ W U) (φ : ∀ U U' : T'.affineOpens, U ≤ U' → (W U ⟶ W U')), (∀ U, IsFinite (q U)) ∧ (∀ U, Etale (q U)) ∧ (∀ U, r U ≫ Limits.pullback.fst k U.1.ι = Limits.pullback.fst (p₀ ≫ k) U.1.ι ≫ p₀) ∧ (∀ U, r U ≫ Limits.pullback.snd k U.1.ι = Limits.pullback.snd (p₀ ≫ k) U.1.ι) ∧ (∀ U, IsPullback (jW U) (r U) (q U) (Limits.pullback.snd k U.1.ι)) ∧ (∀ U, φ U U le_rfl = 𝟙 _) ∧ (∀ (U U' U'' : T'.affineOpens) (h : U ≤ U') (h' : U' ≤ U''), φ U U' h ≫ φ U' U'' h' = φ U U'' (h.trans h')) ∧ (∀ (U U' : T'.affineOpens) (h : U ≤ U'), IsPullback (φ U U' h) (q U) (q U') (T'.homOfLE h)) ∧ (∀ (U U' : T'.affineOpens) (h : U ≤ U'), jW U ≫ φ U U' h = Limits.pullback.map (p₀ ≫ k) U.1.ι (p₀ ≫ k) U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫ jW U') :=
by
  intro A H D Rs T T' k _ hk V₀ p₀ hf he

  have mapfst : ∀ (X : Scheme.{u}) (f : X ⟶ T') (U U' : T'.Opens) (h : U ≤ U'),
      Limits.pullback.map f U.ι f U'.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫
        Limits.pullback.fst f U'.ι = Limits.pullback.fst f U.ι := by
    intro X f U U' h
    unfold Limits.pullback.map
    rw [Limits.pullback.lift_fst, Category.comp_id]
  have mapsnd : ∀ (X : Scheme.{u}) (f : X ⟶ T') (U U' : T'.Opens) (h : U ≤ U'),
      Limits.pullback.map f U.ι f U'.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp) ≫
        Limits.pullback.snd f U'.ι = Limits.pullback.snd f U.ι ≫ T'.homOfLE h := by
    intro X f U U' h
    unfold Limits.pullback.map
    rw [Limits.pullback.lift_snd]

  have s3 : ∀ (X : Scheme.{u}) (f : X ⟶ T') (U U' : T'.Opens) (h : U ≤ U'),
      IsPullback (Limits.pullback.map f U.ι f U'.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp))
        (Limits.pullback.snd f U.ι) (Limits.pullback.snd f U'.ι) (T'.homOfLE h) := by
    intro X f U U' h
    refine IsPullback.of_right ?_ (mapsnd X f U U' h) (IsPullback.of_hasPullback f U'.ι)
    have e2 : T'.homOfLE h ≫ U'.ι = U.ι := Scheme.homOfLE_ι _ _
    rw [mapfst X f U U' h, e2]
    exact IsPullback.of_hasPullback f U.ι

  have s4 : ∀ (U U' : T'.Opens) (h : U ≤ U')
      (rU : Limits.pullback (p₀ ≫ k) U.ι ⟶ Limits.pullback k U.ι)
      (rU' : Limits.pullback (p₀ ≫ k) U'.ι ⟶ Limits.pullback k U'.ι),
      rU ≫ Limits.pullback.fst k U.ι = Limits.pullback.fst (p₀ ≫ k) U.ι ≫ p₀ →
      rU ≫ Limits.pullback.snd k U.ι = Limits.pullback.snd (p₀ ≫ k) U.ι →
      rU' ≫ Limits.pullback.fst k U'.ι = Limits.pullback.fst (p₀ ≫ k) U'.ι ≫ p₀ →
      rU' ≫ Limits.pullback.snd k U'.ι = Limits.pullback.snd (p₀ ≫ k) U'.ι →
      IsPullback (Limits.pullback.map (p₀ ≫ k) U.ι (p₀ ≫ k) U'.ι (𝟙 _) (T'.homOfLE h) (𝟙 _)
          (by simp) (by simp)) rU rU'
        (Limits.pullback.map k U.ι k U'.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp)) := by
    intro U U' h rU rU' h1 h2 h1' h2'
    have v1 := mapfst V₀ (p₀ ≫ k) U U' h
    have v2 := mapsnd V₀ (p₀ ≫ k) U U' h
    have t1 := mapfst T k U U' h
    have t2 := mapsnd T k U U' h
    refine IsPullback.of_right ?_ ?_ (Rs T T' V₀ U' k p₀ U'.ι rU' h1' h2')
    · rw [v1, t1]
      exact Rs T T' V₀ U k p₀ U.ι rU h1 h2
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, h1', reassoc_of% v1, Category.assoc, t1, h1]
      · rw [Category.assoc, h2', v2, Category.assoc, t2, reassoc_of% h2]

  have s1 : ∀ U : T'.affineOpens, ∃ (W : Scheme.{u}) (q : W ⟶ (U.1 : Scheme.{u}))
      (r : Limits.pullback (p₀ ≫ k) U.1.ι ⟶ Limits.pullback k U.1.ι)
      (jW : Limits.pullback (p₀ ≫ k) U.1.ι ⟶ W), IsFinite q ∧ Etale q ∧
      r ≫ Limits.pullback.fst k U.1.ι = Limits.pullback.fst (p₀ ≫ k) U.1.ι ≫ p₀ ∧
      r ≫ Limits.pullback.snd k U.1.ι = Limits.pullback.snd (p₀ ≫ k) U.1.ι ∧
      IsPullback jW r q (Limits.pullback.snd k U.1.ι) ∧ IsAffine W ∧ IsClosedImmersion jW ∧
      Function.Surjective jW := by
    intro U
    have hkU : Function.Surjective (Limits.pullback.snd k U.1.ι) :=
      (MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback k U.1.ι)
        ⟨hk⟩).surj
    let r : Limits.pullback (p₀ ≫ k) U.1.ι ⟶ Limits.pullback k U.1.ι :=
      Limits.pullback.lift (Limits.pullback.fst (p₀ ≫ k) U.1.ι ≫ p₀)
        (Limits.pullback.snd (p₀ ≫ k) U.1.ι)
        (by rw [Category.assoc]; exact Limits.pullback.condition)
    have hr1 : r ≫ Limits.pullback.fst k U.1.ι = Limits.pullback.fst (p₀ ≫ k) U.1.ι ≫ p₀ :=
      Limits.pullback.lift_fst _ _ _
    have hr2 : r ≫ Limits.pullback.snd k U.1.ι = Limits.pullback.snd (p₀ ≫ k) U.1.ι :=
      Limits.pullback.lift_snd _ _ _
    have hR := Rs T T' V₀ U.1 k p₀ U.1.ι r hr1 hr2
    have hrf : IsFinite r := MorphismProperty.of_isPullback (P := @IsFinite) hR hf
    have hre : Etale r := MorphismProperty.of_isPullback (P := @Etale) hR he
    obtain ⟨W, q, j, hqf, hqe, hj⟩ := A (Limits.pullback k U.1.ι) U.1
      (Limits.pullback.snd k U.1.ι) hkU (Limits.pullback (p₀ ≫ k) U.1.ι) r hrf hre
    have : IsAffine W := isAffine_of_isAffineHom q
    refine ⟨W, q, r, j, hqf, hqe, hr1, hr2, hj, this, ?_, ?_⟩
    · exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) hj.flip inferInstance
    · exact (MorphismProperty.of_isPullback (P := @Surjective) hj.flip ⟨hkU⟩).surj
  choose W q r jW hqF hqE hr1 hr2 hpb hWA hjC hjS using s1
  have hJ : ∀ U, jW U ≫ q U = Limits.pullback.snd (p₀ ≫ k) U.1.ι :=
    fun U => (hpb U).w.trans (hr2 U)

  have L : ∀ (U U' : T'.affineOpens) (h : U ≤ U'), ∃! φ : W U ⟶ W U',
      φ ≫ q U' = q U ≫ T'.homOfLE h ∧
      jW U ≫ φ = Limits.pullback.map (p₀ ≫ k) U.1.ι (p₀ ≫ k) U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _)
        (by simp) (by simp) ≫ jW U' := by
    intro U U' h
    have := hWA U
    have := hWA U'
    have := hjC U
    refine H U'.1 (W U) _ (W U') (jW U) (hjS U) (q U ≫ T'.homOfLE h) (q U') (hqE U') _ ?_
    rw [Category.assoc, hJ U', reassoc_of% (hJ U)]
    exact mapsnd V₀ (p₀ ≫ k) U.1 U'.1 h
  choose φ hφ using fun U U' h => (L U U' h).exists
  have hid : ∀ U, φ U U le_rfl = 𝟙 _ := by
    intro U
    refine (L U U le_rfl).unique (hφ U U le_rfl) ⟨?_, ?_⟩
    · rw [Category.id_comp, Scheme.homOfLE_rfl, Category.comp_id]
    · have hM : Limits.pullback.map (p₀ ≫ k) U.1.ι (p₀ ≫ k) U.1.ι (𝟙 _) (T'.homOfLE (le_refl U))
          (𝟙 _) (by simp) (by simp) = 𝟙 _ := by
        apply Limits.pullback.hom_ext
        · rw [mapfst V₀ (p₀ ≫ k) U.1 U.1 (le_refl U), Category.id_comp]
        · rw [mapsnd V₀ (p₀ ≫ k) U.1 U.1 (le_refl U), Scheme.homOfLE_rfl, Category.comp_id,
            Category.id_comp]
      rw [hM, Category.id_comp, Category.comp_id]
  have hcoc : ∀ (U U' U'' : T'.affineOpens) (h : U ≤ U') (h' : U' ≤ U''),
      φ U U' h ≫ φ U' U'' h' = φ U U'' (h.trans h') := by
    intro U U' U'' h h'
    refine (L U U'' (h.trans h')).unique ⟨?_, ?_⟩ (hφ U U'' (h.trans h'))
    · rw [Category.assoc, (hφ U' U'' h').1, reassoc_of% (hφ U U' h).1, Scheme.homOfLE_homOfLE]
    · rw [reassoc_of% (hφ U U' h).2, (hφ U' U'' h').2, ← Category.assoc]
      congr 1
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, mapfst V₀ (p₀ ≫ k) U'.1 U''.1 h', mapfst V₀ (p₀ ≫ k) U.1 U'.1 h,
          mapfst V₀ (p₀ ≫ k) U.1 U''.1 (h.trans h')]
      · rw [Category.assoc, mapsnd V₀ (p₀ ≫ k) U'.1 U''.1 h',
          reassoc_of% (mapsnd V₀ (p₀ ≫ k) U.1 U'.1 h),
          mapsnd V₀ (p₀ ≫ k) U.1 U''.1 (h.trans h'), Scheme.homOfLE_homOfLE]
  have hsurjk : ∀ U : T'.Opens, Function.Surjective (Limits.pullback.snd k U.ι) := fun U =>
    (MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback k U.ι) ⟨hk⟩).surj
  refine ⟨W, q, r, jW, φ, hqF, hqE, hr1, hr2, hpb, hid, hcoc, ?_, fun U U' h => (hφ U U' h).2⟩
  intro U U' h
  have := hWA U
  have := hqF U'
  exact D U.1 U'.1 (Limits.pullback k U.1.ι) (Limits.pullback k U'.1.ι) (W U) (W U')
    (Limits.pullback (p₀ ≫ k) U.1.ι) (Limits.pullback (p₀ ≫ k) U'.1.ι) (T'.homOfLE h)
    (Limits.pullback.snd k U.1.ι) (Limits.pullback.snd k U'.1.ι)
    (Limits.pullback.map k U.1.ι k U'.1.ι (𝟙 _) (T'.homOfLE h) (𝟙 _) (by simp) (by simp))
    (hsurjk U'.1) (s3 T k U.1 U'.1 h) (q U) (q U') (jW U) (r U) (jW U') (r U') _ (φ U U' h)
    (hqE U) (hqE U') inferInstance (hpb U) (hpb U')
    (s4 U.1 U'.1 h (r U) (r U') (hr1 U) (hr2 U) (hr1 U') (hr2 U')) (hφ U U' h).1 (hφ U U' h).2

theorem wc_fet_ext_surj_closed_immersion : ∀ (T T' : Scheme.{u}) (k : T ⟶ T') [IsClosedImmersion k], Function.Surjective k →
    ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ T), IsFinite p₀ → Etale p₀ →
    ∃ (V : Scheme.{u}) (p : V ⟶ T') (j : V₀ ⟶ V), IsFinite p ∧ Etale p ∧ IsPullback j p₀ p k :=
by
  intro T T' k _ hk V₀ p₀ hf he

  have s1 : ∀ (R S : CommRingCat.{u}) (f : R ⟶ S), Function.Surjective (Spec.map f) →
      RingHom.ker f.hom ≤ nilradical R := by
    intro R S f hsurj x hx
    rw [nilradical_eq_sInf, Ideal.mem_sInf]
    intro P hP
    obtain ⟨y, hy⟩ := hsurj ⟨P, hP⟩
    have hy' : PrimeSpectrum.comap f.hom y = ⟨P, hP⟩ := hy
    have h2 : x ∈ (PrimeSpectrum.comap f.hom y).asIdeal := by
      show f.hom x ∈ (show PrimeSpectrum S from y).asIdeal
      rw [RingHom.mem_ker.mp hx]
      exact zero_mem _
    rw [hy'] at h2
    exact h2

  have s13 : ∀ (T T' V₀ U : Scheme.{u}) (k : T ⟶ T') (p₀ : V₀ ⟶ T) (u : U ⟶ T')
      (r : Limits.pullback (p₀ ≫ k) u ⟶ Limits.pullback k u),
      r ≫ Limits.pullback.fst k u = Limits.pullback.fst (p₀ ≫ k) u ≫ p₀ →
      r ≫ Limits.pullback.snd k u = Limits.pullback.snd (p₀ ≫ k) u →
      IsPullback (Limits.pullback.fst (p₀ ≫ k) u) r p₀ (Limits.pullback.fst k u) := by
    intro T T' V₀ U k p₀ u r h1 h2
    refine IsPullback.of_bot ?_ h1.symm (IsPullback.of_hasPullback k u)
    rw [h2]
    exact IsPullback.of_hasPullback (p₀ ≫ k) u

  have H7 := wc_tinv_affine_hom_lift s1 wc_tinv_etale_alg_hom_lift_nil

  have s8 : ∀ (S X Y X₀ Y₀ : Scheme.{u}) [IsAffine S] [IsAffine X] [IsAffine Y] (pX : X ⟶ S)
      (pY : Y ⟶ S) (θ : X ⟶ Y) (jX : X₀ ⟶ X) (jY : Y₀ ⟶ Y) [IsClosedImmersion jX]
      [IsClosedImmersion jY], Function.Surjective jX → Function.Surjective jY → Etale pX →
      Etale pY → θ ≫ pY = pX → ∀ θ₀ : X₀ ⟶ Y₀, IsIso θ₀ → θ₀ ≫ jY = jX ≫ θ → IsIso θ := by
    intro S X Y X₀ Y₀ _ _ _ pX pY θ jX jY _ _ hjX hjY hpX hpY hθ θ₀ _ hθ₀
    obtain ⟨η, ⟨hη1, hη2⟩, -⟩ := H7 S Y Y₀ X jY hjY pY pX hpX (inv θ₀ ≫ jX) (by
      rw [Category.assoc, ← hθ, ← Category.assoc jX, ← hθ₀]
      simp only [Category.assoc, IsIso.inv_hom_id_assoc])
    have e1 : θ ≫ η = 𝟙 X := by
      obtain ⟨φ, -, huniq⟩ := H7 S X X₀ X jX hjX pX pX hpX jX rfl
      have a1 := huniq (θ ≫ η) ⟨by rw [Category.assoc, hη1, hθ], by
        rw [← Category.assoc, ← hθ₀, Category.assoc, hη2, IsIso.hom_inv_id_assoc]⟩
      have a2 := huniq (𝟙 X) ⟨Category.id_comp _, Category.comp_id _⟩
      rw [a1, a2]
    have e2 : η ≫ θ = 𝟙 Y := by
      obtain ⟨φ, -, huniq⟩ := H7 S Y Y₀ Y jY hjY pY pY hpY jY rfl
      have a1 := huniq (η ≫ θ) ⟨by rw [Category.assoc, hθ, hη1], by
        rw [← Category.assoc, hη2, Category.assoc, ← hθ₀, IsIso.inv_hom_id_assoc]⟩
      have a2 := huniq (𝟙 Y) ⟨Category.id_comp _, Category.comp_id _⟩
      rw [a1, a2]
    exact ⟨⟨η, e1, e2⟩⟩

  obtain ⟨W, q, r, jW, φ, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ :=
    wc_tinv_local_family_exists
      (wc_tinv_affine_case s1 (wc_tinv_etale_lift_finite_nil wc_etale_lift_quotient_global)
        wc_tinv_quotient_spec_isPullback)
      H7 (wc_tinv_isPullback_detect s8) s13 T T' k hk V₀ p₀ hf he

  exact wc_tinv_glue_family_to_global wc_tinv_glue_affine_family wc_tinv_isPullback_of_local s13
    T T' k V₀ p₀ W q r jW φ h1 h2 h3 h4 h5 h6 h7 h8 h9

theorem wc_cn_tower_pushforward_system : ∀ (B : Type u) [CommRing B] [IsLocalRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (W : ℕ → Scheme.{u})
    (q : ∀ n, W n ⟶ wcCnThick h n) (τ : ∀ n, wcCnThick h n ⟶ wcCnThick h (n + 1))
    (t : ∀ n, W n ⟶ W (n + 1)),
    (∀ n, τ n ≫ wcCnThickι h (n + 1) = wcCnThickι h n) → (∀ n, IsFinite (q n)) →
    (∀ n, IsPullback (t n) (q n) (q (n + 1)) (τ n)) →
    ∃ ψ : ∀ n, wcCnPush (q (n + 1) ≫ wcCnThickι h (n + 1)) ⟶ wcCnPush (q n ≫ wcCnThickι h n),
      wcCnAdicSys h (IsLocalRing.maximalIdeal B) (fun n => wcCnPush (q n ≫ wcCnThickι h n)) ψ ∧
      wcCnRingTower (fun n => q n ≫ wcCnThickι h n) ψ :=
by
  intro B _ _ Z h W q τ t hτ hqf hW

  have C1 : ∀ (X Y Z : Scheme.{u}) (t : X ⟶ Y) (g : Y ⟶ Z) (g' : X ⟶ Z) (e : t ≫ g = g'),
      ∃ ψ : (Scheme.Modules.pushforward g).obj (SheafOfModules.unit Y.ringCatSheaf) ⟶
          (Scheme.Modules.pushforward g').obj (SheafOfModules.unit X.ringCatSheaf),
        ∀ (U : Z.Opens) (x : Γ(Y, g ⁻¹ᵁ U)),
          (show Γ(X, g' ⁻¹ᵁ U) from Scheme.Modules.Hom.app ψ U x) =
            (t.appLE (g ⁻¹ᵁ U) (g' ⁻¹ᵁ U) (by rw [← e]; exact le_rfl)).hom x := by
    intro X Y Z t g g' e
    subst e
    refine ⟨(Scheme.Modules.pushforward g).map
        (SheafOfModules.unitToPushforwardObjUnit t.toRingCatSheafHom) ≫
      (Scheme.Modules.pushforwardComp t g).hom.app (SheafOfModules.unit X.ringCatSheaf),
      fun U x => ?_⟩
    show _ = (t.appLE (g ⁻¹ᵁ U) (t ⁻¹ᵁ g ⁻¹ᵁ U) le_rfl).hom x
    rw [Scheme.Hom.appLE_eq_app]
    rfl

  have C2 : ∀ (X Y : Scheme.{u}) (g : X ⟶ Y) [IsFinite g],
      wcCoherentMod ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf)) := by
    intro X Y g _
    refine ⟨fun U hU f => ?_, fun U hU => ?_⟩
    · have hO : IsAffineOpen (g ⁻¹ᵁ U) := hU.preimage g
      let i : g ⁻¹ᵁ Y.basicOpen f ⟶ g ⁻¹ᵁ U := homOfLE (g.preimage_mono (Y.basicOpen_le f))
      letI : Algebra Γ(X, g ⁻¹ᵁ U) Γ(X, g ⁻¹ᵁ Y.basicOpen f) := (X.presheaf.map i.op).hom.toAlgebra
      haveI : IsLocalization.Away ((g.app U).hom f) Γ(X, g ⁻¹ᵁ Y.basicOpen f) :=
        hO.isLocalization_of_eq_basicOpen ((g.app U).hom f) i (Scheme.preimage_basicOpen g f)
      have hnat : (g.app (Y.basicOpen f)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) =
          (X.presheaf.map i.op).hom ((g.app U).hom f) :=
        congrArg (fun φ => φ.hom f) (g.naturality (homOfLE (Y.basicOpen_le f)).op)
      refine ⟨fun (s : Γ(X, g ⁻¹ᵁ Y.basicOpen f)) => ?_, fun (s : Γ(X, g ⁻¹ᵁ U)) hs => ?_⟩
      · obtain ⟨n, b, hb⟩ := IsLocalization.Away.surj ((g.app U).hom f) s
        refine ⟨n, b, ?_⟩
        show (g.app (Y.basicOpen f)).hom (((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ n) * s =
          (X.presheaf.map i.op).hom b
        rw [map_pow, hnat, mul_comm]
        exact hb
      · have hs' : algebraMap Γ(X, g ⁻¹ᵁ U) Γ(X, g ⁻¹ᵁ Y.basicOpen f) s = 0 := hs
        obtain ⟨⟨m, hm⟩, hmt⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers ((g.app U).hom f)) _ s).mp hs'
        obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff m _).mp hm
        refine ⟨n, ?_⟩
        show (g.app U).hom (f ^ n) * s = 0
        rw [map_pow]
        exact hmt
    · have hfin := g.finite_app U hU
      letI := (g.app U).hom.toAlgebra
      haveI : Module.Finite Γ(Y, U) Γ(X, g ⁻¹ᵁ U) := hfin
      let φ : Γ(X, g ⁻¹ᵁ U) →ₗ[Γ(Y, U)]
          Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U) :=
        { toFun := fun x => x, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
      exact Module.Finite.of_surjective φ (fun x => ⟨x, rfl⟩)

  have C3 : ∀ (n : ℕ)
      (τ : Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) ⟶
        Limits.pullback h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1)))))),
      τ ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1))))) =
        Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) →
      IsPullback τ (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))))
        (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1))))) ≫ h)
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) := by
    intro n τ hτ
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1))))) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    refine IsPullback.mk' ?_ ?_ ?_
    · rw [← Category.assoc, hτ, Limits.pullback.condition]
    · intro T φ φ' h1 h2
      apply Limits.pullback.hom_ext
      · rw [← hτ, ← Category.assoc, ← Category.assoc, h1]
      · exact h2
    · intro T a b hab
      refine ⟨Limits.pullback.lift (a ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1)))))) b
          (by rw [Category.assoc]; exact hab), ?_, Limits.pullback.lift_snd _ _ _⟩
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hτ, Limits.pullback.lift_fst]
      · rw [← cancel_mono (Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1 + 1)))))]
        simp only [Category.assoc, ← Limits.pullback.condition, reassoc_of% hτ,
          Limits.pullback.lift_fst_assoc]

  have C4 : ∀ (A : Type u) [CommRing A] (Z R P : Scheme.{u}) (h : Z ⟶ Spec (.of A)) (g : R ⟶ Z)
      [IsAffineHom g] (J : Ideal A) (t : P ⟶ R) (k : P ⟶ Spec (.of (A ⧸ J))),
      IsPullback t k (g ≫ h) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) →
      ∀ (U : Z.Opens), IsAffineOpen U → ∀ (V : P.Opens) (e : V ≤ t ⁻¹ᵁ (g ⁻¹ᵁ U)),
        t ⁻¹ᵁ (g ⁻¹ᵁ U) ≤ V →
        Function.Surjective (t.appLE (g ⁻¹ᵁ U) V e).hom ∧
        RingHom.ker (t.appLE (g ⁻¹ᵁ U) V e).hom =
          Ideal.map (g.app U).hom (Ideal.map (wcCnSigma h U) J) := by
    intro A _ Z R P h g _ J t k hpb U hU V e e'
    obtain rfl : V = t ⁻¹ᵁ (g ⁻¹ᵁ U) := le_antisymm e e'
    rw [Scheme.Hom.appLE_eq_app]
    have hO : IsAffineOpen (g ⁻¹ᵁ U) := hU.preimage g
    obtain ⟨hsurj, hker⟩ := wc_pullback_quot_affine_sections A R (g ≫ h) J (g ⁻¹ᵁ U) hO
    have hσ : ((R.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ U ≤ ⊤)).op).hom.comp
        ((g ≫ h).appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) =
        (g.app U).hom.comp (wcCnSigma h U) := by
      ext a
      have hn := congrArg (fun φ => φ.hom (h.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)))
        (g.naturality (homOfLE (le_top : U ≤ ⊤)).op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hn
      simp only [wcCnSigma, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
      exact hn.symm
    obtain ⟨E, hE⟩ : ∃ E : P ≅ Limits.pullback (g ≫ h)
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))),
        E.hom ≫ Limits.pullback.fst (g ≫ h) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) = t :=
      ⟨hpb.isoPullback, hpb.isoPullback_hom_fst⟩
    subst hE
    have hbij : Function.Bijective (E.hom.app
        ((Limits.pullback.fst (g ≫ h) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) ⁻¹ᵁ
          (g ⁻¹ᵁ U))).hom :=
      ConcreteCategory.bijective_of_isIso _
    have key : ∀ x, ((E.hom ≫ Limits.pullback.fst (g ≫ h)
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))).app (g ⁻¹ᵁ U)).hom x =
        (E.hom.app ((Limits.pullback.fst (g ≫ h) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) ⁻¹ᵁ
          (g ⁻¹ᵁ U))).hom (((Limits.pullback.fst (g ≫ h)
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))).app (g ⁻¹ᵁ U)).hom x) :=
      fun x => rfl
    refine ⟨fun y => ?_, ?_⟩
    · obtain ⟨x, hx⟩ := hbij.2 y
      obtain ⟨z, hz⟩ := hsurj x
      exact ⟨z, by rw [key, hz, hx]⟩
    · have hmap : Ideal.map (g.app U).hom (Ideal.map (wcCnSigma h U) J) =
          Ideal.map ((R.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ U ≤ ⊤)).op).hom.comp
            ((g ≫ h).appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) J := by
        rw [Ideal.map_map, hσ]
      rw [hmap]
      ext x
      rw [RingHom.mem_ker, ← hker x]
      constructor
      · intro hx
        have h1 : (E.hom.app ((Limits.pullback.fst (g ≫ h)
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) ⁻¹ᵁ (g ⁻¹ᵁ U))).hom
            (((Limits.pullback.fst (g ≫ h)
              (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))).app (g ⁻¹ᵁ U)).hom x) = 0 :=
          (key x).symm.trans hx
        exact hbij.1 (h1.trans (map_zero _).symm)
      · intro hx
        have h1 : (E.hom.app ((Limits.pullback.fst (g ≫ h)
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))) ⁻¹ᵁ (g ⁻¹ᵁ U))).hom
            (((Limits.pullback.fst (g ≫ h)
              (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))).app (g ⁻¹ᵁ U)).hom x) = 0 := by
          rw [hx, map_zero]
        exact (key x).trans h1

  have C5 : ∀ (X Z : Scheme.{u}) (g : X ⟶ Z) (U : Z.Opens) (I : Ideal Γ(Z, U)) (s : Γ(X, g ⁻¹ᵁ U)),
      (show Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U) from s) ∈
        I • (⊤ : Submodule Γ(Z, U) Γ((Scheme.Modules.pushforward g).obj
          (SheafOfModules.unit X.ringCatSheaf), U)) ↔ s ∈ Ideal.map (g.app U).hom I := by
    intro X Z g U I s
    have aux : ∀ (c : Γ(X, g ⁻¹ᵁ U))
        (x : Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U)),
        x ∈ I • (⊤ : Submodule Γ(Z, U) Γ((Scheme.Modules.pushforward g).obj
          (SheafOfModules.unit X.ringCatSheaf), U)) →
        (c * (show Γ(X, g ⁻¹ᵁ U) from x) : Γ(X, g ⁻¹ᵁ U)) ∈ I • (⊤ : Submodule Γ(Z, U)
          Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U)) := by
      intro c x hx
      refine Submodule.smul_induction_on hx
        (p := fun (y : Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U)) =>
          (c * (show Γ(X, g ⁻¹ᵁ U) from y) : Γ(X, g ⁻¹ᵁ U)) ∈ I • (⊤ : Submodule Γ(Z, U)
            Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U))) ?_ ?_
      · intro r hr n _
        have e1 : (c * ((g.app U).hom r * (show Γ(X, g ⁻¹ᵁ U) from n)) : Γ(X, g ⁻¹ᵁ U)) =
            (g.app U).hom r * (c * (show Γ(X, g ⁻¹ᵁ U) from n)) := by ring
        have e2 := Submodule.smul_mem_smul (N := (⊤ : Submodule Γ(Z, U)
          Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U))) hr
          (Submodule.mem_top (x := (show Γ((Scheme.Modules.pushforward g).obj
            (SheafOfModules.unit X.ringCatSheaf), U) from (c * (show Γ(X, g ⁻¹ᵁ U) from n)))))
        show (c * ((g.app U).hom r * (show Γ(X, g ⁻¹ᵁ U) from n)) : Γ(X, g ⁻¹ᵁ U)) ∈ _
        rw [e1]
        exact e2
      · intro y z hy hz
        show (c * ((show Γ(X, g ⁻¹ᵁ U) from y) + (show Γ(X, g ⁻¹ᵁ U) from z)) : Γ(X, g ⁻¹ᵁ U)) ∈ _
        rw [mul_add]
        exact Submodule.add_mem _ hy hz
    constructor
    · intro hs
      exact Submodule.smul_induction_on hs
        (p := fun (y : Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U)) =>
          (show Γ(X, g ⁻¹ᵁ U) from y) ∈ Ideal.map (g.app U).hom I)
        (fun r hr n _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hr))
        (fun y z hy hz => Ideal.add_mem _ hy hz)
    · intro hs
      change s ∈ Ideal.span ((g.app U).hom '' I) at hs
      induction hs using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨r, hr, rfl⟩ := hx
        have e2 := Submodule.smul_mem_smul (N := (⊤ : Submodule Γ(Z, U)
          Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit X.ringCatSheaf), U))) hr
          (Submodule.mem_top (x := (show Γ((Scheme.Modules.pushforward g).obj
            (SheafOfModules.unit X.ringCatSheaf), U) from (1 : Γ(X, g ⁻¹ᵁ U)))))
        have e1 : (g.app U).hom r = (g.app U).hom r * (1 : Γ(X, g ⁻¹ᵁ U)) := (mul_one _).symm
        rw [e1]
        exact e2
      | zero => exact Submodule.zero_mem _
      | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
      | smul a x _ hx => exact aux a x hx

  have hπ : ∀ n, IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) := fun n =>
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have hι : ∀ n, IsClosedImmersion (wcCnThickι h n) := fun n => by
    haveI := hπ n
    exact MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback h (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1)))))).flip inferInstance
  have hF1 : ∀ n, t n ≫ (q (n + 1) ≫ wcCnThickι h (n + 1)) = q n ≫ wcCnThickι h n := fun n => by
    rw [← Category.assoc, (hW n).w, Category.assoc, hτ n]
  choose ψ hψ using fun n => C1 (W n) (W (n + 1)) Z (t n) (q (n + 1) ≫ wcCnThickι h (n + 1))
    (q n ≫ wcCnThickι h n) (hF1 n)
  refine ⟨ψ, ⟨?_, ?_, ?_⟩, ?_⟩
  ·
    intro n
    haveI := hqf n
    haveI := hι n
    exact C2 (W n) Z (q n ≫ wcCnThickι h n)
  ·
    intro n U hU
    haveI := hqf (n + 1)
    haveI := hι (n + 1)
    have hpb : IsPullback (t n) (q n ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))))
        ((q (n + 1) ≫ wcCnThickι h (n + 1)) ≫ h)
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + 1))))) := by
      have := (hW n).paste_vert (C3 n (τ n) (hτ n))
      rw [Category.assoc]
      exact this
    obtain ⟨hsurj, hker⟩ := C4 B Z (W (n + 1)) (W n) h (q (n + 1) ≫ wcCnThickι h (n + 1))
      (IsLocalRing.maximalIdeal B ^ (n + 1)) (t n) _ hpb U hU ((q n ≫ wcCnThickι h n) ⁻¹ᵁ U)
      (by rw [← hF1 n] <;> exact le_rfl) (by rw [← hF1 n] <;> exact le_rfl)
    refine ⟨fun y => ?_, fun s => ?_⟩
    · obtain ⟨x, hx⟩ := hsurj y
      exact ⟨x, (hψ n U x).trans hx⟩
    · have e1 := hψ n U s
      have e2 := C5 (W (n + 1)) Z (q (n + 1) ≫ wcCnThickι h (n + 1)) U
        (Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1))) s
      rw [SetLike.ext_iff] at hker
      exact ⟨fun h0 => e2.mpr ((hker s).mp (RingHom.mem_ker.mpr (e1.symm.trans h0))),
        fun hm => e1.trans (RingHom.mem_ker.mp ((hker s).mpr (e2.mp hm)))⟩
  ·
    intro n U hU
    rw [eq_bot_iff]
    intro s hs
    rw [Submodule.mem_bot]
    have e2 := (C5 (W n) Z (q n ≫ wcCnThickι h n) U
      (Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1))) s).mp hs
    have hzero : ∀ x ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1)),
        ((q n ≫ wcCnThickι h n).app U).hom x = 0 := by
      intro x hx
      have h0 : ((wcCnThickι h n).app U).hom x = 0 :=
        ((wc_pullback_quot_affine_sections B Z h (IsLocalRing.maximalIdeal B ^ (n + 1)) U hU).2 x).mpr hx
      show ((q n).app _).hom (((wcCnThickι h n).app U).hom x) = 0
      rw [h0, map_zero]
    have hbot : Ideal.map ((q n ≫ wcCnThickι h n).app U).hom
        (Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1))) = ⊥ :=
      (Ideal.map_eq_bot_iff_le_ker _).mpr (fun x hx => RingHom.mem_ker.mpr (hzero x hx))
    rw [hbot] at e2
    have e3 : (show Γ(W n, (q n ≫ wcCnThickι h n) ⁻¹ᵁ U) from s) = 0 := (Ideal.mem_bot).mp e2
    exact e3
  ·
    intro n U x y
    refine ⟨?_, ?_⟩
    · exact (hψ n U (x * y)).trans ((map_mul _ x y).trans
        (congrArg₂ (· * ·) (hψ n U x).symm (hψ n U y).symm))
    · exact (hψ n U 1).trans (map_one _)

theorem wc_cn_coherent_global_sections_fg : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (M : Z.Modules), wcCoherentMod M → ∃ (k : ℕ) (c : Fin k → Γ(M, ⊤)), ∀ s : Γ(M, ⊤), ∃ b : Fin k → B, s = ∑ l, wcCnSigma h ⊤ (b l) • c l :=
by
  intro B _ _ Z h _ M hM
  classical
  haveI : IsLocallyNoetherian (Spec (.of B)) :=
    (isLocallyNoetherian_Spec (R := CommRingCat.of B)).mpr ‹IsNoetherianRing B›
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace h
  haveI : AlgebraicGeometry.IsNoetherian Z := AlgebraicGeometry.IsNoetherian.mk

  obtain ⟨r, V, hV, hcov, hV2⟩ : ∃ (r : ℕ) (U : Fin r → Z.Opens), (∀ i, IsAffineOpen (U i)) ∧
      (∀ x : Z, ∃ i, x ∈ U i) ∧ ∀ i j, IsAffineOpen (U i ⊓ U j) := by
    have hsep : IsSeparated (Limits.terminal.from Z) := by
      have e : Limits.terminal.from Z = h ≫ Limits.terminal.from (Spec (.of B)) :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    haveI : Z.IsSeparated := Scheme.IsSeparated.mk hsep
    have hW : ∀ x : Z, ∃ W : Z.Opens, IsAffineOpen W ∧ x ∈ W := by
      intro x
      obtain ⟨U', hU', hxU', -⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Z.isBasis_affineOpens))
          (show x ∈ (⊤ : Z.Opens) from trivial)
      exact ⟨U', hU', hxU'⟩
    choose W hWaff hWmem using hW
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (W x : Set Z))
      (fun x => (W x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hWmem y⟩)
    let e := t.equivFin
    refine ⟨t.card, fun i => W (e.symm i).1, fun i => hWaff _, ?_,
      fun i j => (hWaff _).inf (hWaff _)⟩
    intro x
    have hx := ht (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨y, hy, hxy⟩ := hx
    refine ⟨e ⟨y, hy⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxy

  have hzero : ∀ N : Z.Modules, Limits.IsZero N → wcCechH01FG B Z h N r V := by
    intro N hN
    have hs : ∀ (U : Z.Opens) (s : Γ(N, U)), s = 0 := by
      intro U s
      have h1 : (𝟙 N : N ⟶ N) = 0 := hN.eq_of_src _ _
      have h2 : Scheme.Modules.Hom.app (𝟙 N) U s = Scheme.Modules.Hom.app (0 : N ⟶ N) U s := by
        rw [h1]
      simpa using h2
    refine ⟨⟨0, fun l => l.elim0, fun z _ => ⟨fun l => l.elim0, ?_⟩⟩,
      ⟨0, fun l => l.elim0, fun z _ => ⟨fun l => l.elim0, 0, ?_⟩⟩⟩
    · funext i
      exact (hs _ _).trans (hs _ _).symm
    · funext p
      exact (hs _ _).trans (hs _ _).symm
  have hA : ∀ S : ShortComplex Z.Modules, S.ShortExact → wcCoherentMod S.X₁ →
      wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → wcCechH01FG B Z h S.X₁ r V →
      wcCechH01FG B Z h S.X₃ r V → wcCechH01FG B Z h S.X₂ r V := by
    intro S hS h1 _ _
    obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact Z S hS
    exact (wc_cech_h01_two_of_three B Z h r V S hinj hex
      (fun i => wc_modules_ses_affine_surj Z S hS h1.1 (V i) (hV i))).1
  have hB : ∀ S : ShortComplex Z.Modules, S.ShortExact → wcCoherentMod S.X₁ →
      wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → wcCechH01FG B Z h S.X₂ r V →
      wcCechH01FG B Z h S.X₃ r V → wcCechH01FG B Z h S.X₁ r V := by
    intro S hS h1 _ _
    obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact Z S hS
    exact (wc_cech_h01_two_of_three B Z h r V S hinj hex
      (fun i => wc_modules_ses_affine_surj Z S hS h1.1 (V i) (hV i))).2
  have hP : wcCechH01FG B Z h M r V :=
    wc_coherent_devissage Z (fun N => wcCechH01FG B Z h N r V) hzero hA hB
      (fun T hT => wc_proper_good_sheaf_exists B Z h r V hV hcov hV2 T hT) M hM

  have hσres : ∀ (W W' : Z.Opens) (hle : W' ≤ W) (b : B),
      Z.presheaf.map (homOfLE hle).op (wcCnSigma h W b) = wcCnSigma h W' b := by
    intro W W' hle b
    show (Z.presheaf.map (homOfLE hle).op) ((Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)) =
      (Z.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hrescomp : ∀ (W W' W'' : Z.Opens) (h1 : W' ≤ W) (h2 : W'' ≤ W') (h3 : W'' ≤ W)
      (x : Γ(M, W)),
      M.presheaf.map (homOfLE h2).op (M.presheaf.map (homOfLE h1).op x) =
        M.presheaf.map (homOfLE h3).op x := by
    intro W W' W'' h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hsmulres : ∀ (i : Fin r) (a : B) (t : Γ(M, ⊤)),
      M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op (wcCnSigma h ⊤ a • t) =
        wcCnSigma h (V i) a • M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op t := by
    intro i a t
    rw [Scheme.Modules.map_smul, hσres]
  have hcov' : (⊤ : Z.Opens) ≤ iSup V := by
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact hcov x
  have hsep : ∀ (x y : Γ(M, ⊤)),
      (∀ i, M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op x =
        M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op y) → x = y := by
    intro x y hxy
    exact TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Z) V ⊤
      (fun i => homOfLE le_top) hcov' x y hxy

  obtain ⟨k₀, c₀, hc₀⟩ := hP.1
  obtain ⟨z, hz⟩ : ∃ z : (Fin k₀ → B) → ∀ i, Γ(M, V i),
      ∀ b i, z b i = ∑ l, wcCnSigma h (V i) (b l) • c₀ l i := ⟨_, fun _ _ => rfl⟩
  have hz_add : ∀ b b' i, z (b + b') i = z b i + z b' i := by
    intro b b' i
    rw [hz, hz, hz, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [Pi.add_apply, map_add, add_smul]
  have hz_smul : ∀ (a : B) b i, z (a • b) i = wcCnSigma h (V i) a • z b i := by
    intro a b i
    rw [hz, hz, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, map_mul, mul_smul]
  have hz_zero : ∀ i, z 0 i = 0 := by
    intro i
    rw [hz]
    refine Finset.sum_eq_zero (fun l _ => ?_)
    rw [Pi.zero_apply, map_zero, zero_smul]

  let S : Submodule B (Fin k₀ → B) :=
    { carrier := {b | ∃ t : Γ(M, ⊤), ∀ i, M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op t = z b i}
      add_mem' := fun {b b'} hb hb' => by
        obtain ⟨t, ht⟩ := hb
        obtain ⟨t', ht'⟩ := hb'
        exact ⟨t + t', fun i => by rw [map_add, ht, ht', hz_add]⟩
      zero_mem' := ⟨0, fun i => by rw [map_zero, hz_zero]⟩
      smul_mem' := fun a {b} hb => by
        obtain ⟨t, ht⟩ := hb
        exact ⟨wcCnSigma h ⊤ a • t, fun i => by rw [hsmulres, ht, hz_smul]⟩ }
  have hS_mem : ∀ b, b ∈ S ↔
      ∃ t : Γ(M, ⊤), ∀ i, M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op t = z b i :=
    fun b => Iff.rfl
  have hfg : S.FG := IsNoetherian.noetherian S
  obtain ⟨k, β, hβ⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hβS : ∀ j, ∃ t : Γ(M, ⊤),
      ∀ i, M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op t = z (β j) i := by
    intro j
    have hmem : β j ∈ S := by
      rw [← hβ]
      exact Submodule.subset_span ⟨j, rfl⟩
    exact (hS_mem _).mp hmem
  choose c hc using hβS
  refine ⟨k, c, fun s => ?_⟩
  obtain ⟨b, hb⟩ := hc₀ (fun i => M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op s)
    (fun i j => (hrescomp ⊤ (V j) (V i ⊓ V j) le_top inf_le_right le_top s).trans
      (hrescomp ⊤ (V i) (V i ⊓ V j) le_top inf_le_left le_top s).symm)
  have hsb : ∀ i, M.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op s = z b i := by
    intro i
    rw [hz]
    exact congrFun hb i
  have hbS : b ∈ S := (hS_mem b).mpr ⟨s, hsb⟩
  rw [← hβ] at hbS
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp hbS
  refine ⟨a, hsep _ _ (fun i => ?_)⟩
  have hzi : ∀ (s' : Finset (Fin k)),
      z (∑ j ∈ s', a j • β j) i = ∑ j ∈ s', wcCnSigma h (V i) (a j) • z (β j) i := by
    intro s'
    induction s' using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty, hz_zero]
    | insert j s' hj ih => rw [Finset.sum_insert hj, Finset.sum_insert hj, hz_add, hz_smul, ih]
  rw [hsb, ← ha, hzi, map_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [hsmulres, hc]

theorem wc_cn_sqzero_relative_spec : ∀ (Z : Scheme.{u}) (M : Z.Modules), wcCoherentMod M → ∃ (Z' : Scheme.{u}) (pr : Z' ⟶ Z) (ι : ∀ U : Z.Opens, IsAffineOpen U → (Γ(M, U) →+ Γ(Z', pr ⁻¹ᵁ U))) (π : ∀ U : Z.Opens, IsAffineOpen U → (Γ(Z', pr ⁻¹ᵁ U) →+ Γ(M, U))), IsFinite pr ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U) (m : Γ(M, U)), π U hU (ι U hU m) = m) ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U) (c : Γ(Z, U)) (m : Γ(M, U)), ι U hU (c • m) = pr.app U c * ι U hU m) ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U) (c : Γ(Z, U)) (y : Γ(Z', pr ⁻¹ᵁ U)), π U hU (pr.app U c * y) = c • π U hU y) ∧ (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U) (m : Γ(M, U)), ι U' hU' (M.presheaf.map (homOfLE hle).op m) = Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op (ι U hU m)) ∧ (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U) (y : Γ(Z', pr ⁻¹ᵁ U)), π U' hU' (Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op y) = M.presheaf.map (homOfLE hle).op (π U hU y)) :=
by
  intro Z M hM

  have s1 : ∀ (R M R' M' : Type u) [CommRing R] [AddCommGroup M] [Module R M] [Module Rᵐᵒᵖ M] [IsCentralScalar R M] [CommRing R'] [AddCommGroup M'] [Module R' M'] [Module R'ᵐᵒᵖ M'] [IsCentralScalar R' M'] (f : R) (ρ : R →+* R') (μ : M →+ M') (Φ : TrivSqZeroExt R M →+* TrivSqZeroExt R' M'), (letI := ρ.toAlgebra; IsLocalization.Away f R') → (∀ (r : R) (m : M), μ (r • m) = ρ r • μ m) → (∀ m' : M', ∃ (n : ℕ) (m : M), ρ f ^ n • m' = μ m) → (∀ m : M, μ m = 0 → ∃ n : ℕ, f ^ n • m = 0) → (∀ x, (Φ x).fst = ρ x.fst) → (∀ x, (Φ x).snd = μ x.snd) → (letI := Φ.toAlgebra; IsLocalization.Away (TrivSqZeroExt.inl f : TrivSqZeroExt R M) (TrivSqZeroExt R' M')) := by
    intro R M R' M' _ _ _ _ _ _ _ _ _ _ f ρ μ Φ hloc hlin hsurj hker hfst hsnd
    letI : Algebra R R' := ρ.toAlgebra
    letI : Algebra (TrivSqZeroExt R M) (TrivSqZeroExt R' M') := Φ.toAlgebra
    have hρ : ∀ r, algebraMap R R' r = ρ r := fun _ => rfl
    have hΦ : ∀ x, algebraMap (TrivSqZeroExt R M) (TrivSqZeroExt R' M') x = Φ x := fun _ => rfl
    have mul_inl' : ∀ (s : TrivSqZeroExt R' M') (c : R'),
        s * TrivSqZeroExt.inl c = (TrivSqZeroExt.inl (s.fst * c) + TrivSqZeroExt.inr (c • s.snd)) := by
      intro s c
      ext
      · simp
      · simp [op_smul_eq_smul]
    have inl_mul' : ∀ (c : R) (x : TrivSqZeroExt R M),
        TrivSqZeroExt.inl c * x = (TrivSqZeroExt.inl (c * x.fst) + TrivSqZeroExt.inr (c • x.snd)) := by
      intro c x
      ext
      · simp
      · simp
    have hΦf : ∀ n : ℕ, Φ (TrivSqZeroExt.inl f) ^ n = TrivSqZeroExt.inl (ρ f ^ n) := by
      intro n
      have : Φ (TrivSqZeroExt.inl f) = TrivSqZeroExt.inl (ρ f) := by
        ext
        · rw [hfst]; simp
        · rw [hsnd]; simp
      rw [this, TrivSqZeroExt.inl_pow]
    refine IsLocalization.Away.mk _ ?_ ?_ ?_
    · rw [hΦ]
      have h := hΦf 1
      rw [pow_one, pow_one] at h
      rw [h]
      have hu : IsUnit (ρ f) := by
        rw [← hρ]; exact IsLocalization.Away.algebraMap_isUnit f
      exact hu.map (TrivSqZeroExt.inlHom R' M')
    · intro s
      obtain ⟨n₁, a, ha⟩ := IsLocalization.Away.surj f s.fst
      obtain ⟨n₂, m, hm⟩ := hsurj s.snd
      refine ⟨n₁ + n₂, TrivSqZeroExt.inl (a * f ^ n₂) + TrivSqZeroExt.inr (f ^ n₁ • m), ?_⟩
      rw [hΦ, hΦ, hΦf, mul_inl']
      ext
      · simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, add_zero]
        rw [hfst]
        simp only [hρ] at ha
        simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr, add_zero,
          map_mul, map_pow]
        rw [pow_add, ← mul_assoc, ha]
      · simp only [TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_add]
        rw [hsnd]
        simp only [TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, zero_add]
        rw [hlin, pow_add, mul_smul, hm, map_pow]
    · intro x y hxy
      rw [hΦ, hΦ] at hxy
      have h1 : algebraMap R R' x.fst = algebraMap R R' y.fst := by
        rw [hρ, hρ, ← hfst, ← hfst, hxy]
      obtain ⟨n₁, hn₁⟩ := IsLocalization.Away.exists_of_eq f h1
      have h2 : μ (x.snd - y.snd) = 0 := by
        rw [map_sub, ← hsnd, ← hsnd, hxy, sub_self]
      obtain ⟨n₂, hn₂⟩ := hker _ h2
      rw [smul_sub, sub_eq_zero] at hn₂
      refine ⟨n₁ + n₂, ?_⟩
      rw [TrivSqZeroExt.inl_pow, inl_mul', inl_mul']
      congr 2
      · rw [pow_add, mul_comm (f ^ n₁), mul_assoc, mul_assoc, hn₁]
      · rw [pow_add, mul_smul, mul_smul, hn₂]

  have s2 : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] [Module Rᵐᵒᵖ M]
      [IsCentralScalar R M], Module.Finite R M → (TrivSqZeroExt.inlHom R M).Finite := by
    intro R N _ _ _ _ _ hN
    have e : TrivSqZeroExt.inlHom R N = algebraMap R (TrivSqZeroExt R N) := by
      ext r
      · simp [TrivSqZeroExt.algebraMap_eq_inl]
      · simp [TrivSqZeroExt.algebraMap_eq_inl]
    rw [e, RingHom.finite_algebraMap]
    exact inferInstanceAs (Module.Finite R (R × N))

  have s3 : ∃ (F : Z.Opensᵒᵖ ⥤ CommRingCat.{u}) (α : Z.presheaf ⟶ F) (ι0 : ∀ W : Z.Opens, Γ(M, W) →+ F.obj (Opposite.op W)) (π0 : ∀ W : Z.Opens, F.obj (Opposite.op W) →+ Γ(M, W)), (∀ (U : Z.Opens), IsAffineOpen U → ∀ f : Γ(Z, U), letI := (F.map (homOfLE (Z.basicOpen_le f)).op).hom.toAlgebra; IsLocalization.Away (α.app (Opposite.op U) f) (F.obj (Opposite.op (Z.basicOpen f)))) ∧ (∀ (W : Z.Opens) (κ : Type u) (V : κ → Z.Opens) (hV : ∀ i, V i ≤ W), W ≤ iSup V → ∀ x y : F.obj (Opposite.op W), (∀ i, F.map (homOfLE (hV i)).op x = F.map (homOfLE (hV i)).op y) → x = y) ∧ (∀ (W : Z.Opens) (m : Γ(M, W)), π0 W (ι0 W m) = m) ∧ (∀ (W : Z.Opens) (c : Γ(Z, W)) (m : Γ(M, W)), ι0 W (c • m) = α.app (Opposite.op W) c * ι0 W m) ∧ (∀ (W : Z.Opens) (c : Γ(Z, W)) (y : F.obj (Opposite.op W)), π0 W (α.app (Opposite.op W) c * y) = c • π0 W y) ∧ (∀ (W W' : Z.Opens) (hle : W' ≤ W) (m : Γ(M, W)), ι0 W' (M.presheaf.map (homOfLE hle).op m) = F.map (homOfLE hle).op (ι0 W m)) ∧ (∀ (W W' : Z.Opens) (hle : W' ≤ W) (y : F.obj (Opposite.op W)), π0 W' (F.map (homOfLE hle).op y) = M.presheaf.map (homOfLE hle).op (π0 W y)) ∧ (∀ (U : Z.Opens), IsAffineOpen U → (α.app (Opposite.op U)).hom.Finite) := by
    let ι0 : ∀ W : Z.Opens, Γ(M, W) →+ (wcSqzPresheaf M).obj (Opposite.op W) := fun W =>
      { toFun := fun m => (Prod.mk (0 : Γ(Z, W)) m : TrivSqZeroExt Γ(Z, W) Γ(M, W))
        map_zero' := rfl
        map_add' := fun m m' => TrivSqZeroExt.ext (add_zero (0 : Γ(Z, W))).symm rfl }
    let π0 : ∀ W : Z.Opens, (wcSqzPresheaf M).obj (Opposite.op W) →+ Γ(M, W) := fun W =>
      { toFun := fun x => TrivSqZeroExt.snd (x : TrivSqZeroExt Γ(Z, W) Γ(M, W))
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    refine ⟨wcSqzPresheaf M, wcSqzUnit M, ι0, π0, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro U hU f
      letI : Module (Γ(Z, U))ᵐᵒᵖ Γ(M, U) :=
        Module.compHom _ (RingEquiv.toOpposite Γ(Z, U)).symm.toRingHom
      haveI : IsCentralScalar Γ(Z, U) Γ(M, U) := ⟨fun _ _ => rfl⟩
      letI : Module (Γ(Z, Z.basicOpen f))ᵐᵒᵖ Γ(M, Z.basicOpen f) :=
        Module.compHom _ (RingEquiv.toOpposite Γ(Z, Z.basicOpen f)).symm.toRingHom
      haveI : IsCentralScalar Γ(Z, Z.basicOpen f) Γ(M, Z.basicOpen f) := ⟨fun _ _ => rfl⟩
      obtain ⟨hq1, hq2⟩ := hM.1 U hU f
      exact s1 Γ(Z, U) Γ(M, U) Γ(Z, Z.basicOpen f) Γ(M, Z.basicOpen f) f
        (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
        (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
        ((wcSqzPresheaf M).map (homOfLE (Z.basicOpen_le f)).op).hom
        (hU.isLocalization_basicOpen f)
        (fun r m => Scheme.Modules.map_smul M _ r m) hq1 hq2 (fun _ => rfl) (fun _ => rfl)
    · intro W κ V hV hcov x y hxy
      refine TrivSqZeroExt.ext ?_ ?_
      · exact TopCat.Sheaf.eq_of_locally_eq' Z.sheaf V W (fun i => homOfLE (hV i)) hcov
          (x : TrivSqZeroExt Γ(Z, W) Γ(M, W)).fst (y : TrivSqZeroExt Γ(Z, W) Γ(M, W)).fst
          (fun i => congrArg (fun z : TrivSqZeroExt Γ(Z, V i) Γ(M, V i) => z.fst) (hxy i))
      · exact TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Z) V W
          (fun i => homOfLE (hV i)) hcov
          (x : TrivSqZeroExt Γ(Z, W) Γ(M, W)).snd (y : TrivSqZeroExt Γ(Z, W) Γ(M, W)).snd
          (fun i => congrArg (fun z : TrivSqZeroExt Γ(Z, V i) Γ(M, V i) => z.snd) (hxy i))
    · intro W m
      rfl
    · intro W c m
      refine TrivSqZeroExt.ext ?_ ?_
      · show (0 : Γ(Z, W)) = c * 0
        rw [mul_zero]
      · show c • m = c • m + (0 : Γ(Z, W)) • (0 : Γ(M, W))
        rw [smul_zero, add_zero]
    · intro W c y
      show c • (y : TrivSqZeroExt Γ(Z, W) Γ(M, W)).snd +
        (y : TrivSqZeroExt Γ(Z, W) Γ(M, W)).fst • (0 : Γ(M, W)) =
          c • (y : TrivSqZeroExt Γ(Z, W) Γ(M, W)).snd
      rw [smul_zero, add_zero]
    · intro W W' hle m
      refine TrivSqZeroExt.ext ?_ rfl
      exact (map_zero (Z.presheaf.map (homOfLE hle).op).hom).symm
    · intro W W' hle y
      rfl
    · intro U hU
      letI : Module (Γ(Z, U))ᵐᵒᵖ Γ(M, U) :=
        Module.compHom _ (RingEquiv.toOpposite Γ(Z, U)).symm.toRingHom
      haveI : IsCentralScalar Γ(Z, U) Γ(M, U) := ⟨fun _ _ => rfl⟩
      exact s2 Γ(Z, U) Γ(M, U) (hM.2 U hU)

  have s4 : ∀ (F : Z.Opensᵒᵖ ⥤ CommRingCat.{u}) (α : Z.presheaf ⟶ F), (∀ (U : Z.Opens), IsAffineOpen U → ∀ f : Γ(Z, U), letI := (F.map (homOfLE (Z.basicOpen_le f)).op).hom.toAlgebra; IsLocalization.Away (α.app (Opposite.op U) f) (F.obj (Opposite.op (Z.basicOpen f)))) → ∃ (Z' : Scheme.{u}) (pr : Z' ⟶ Z) (j : ∀ U : Z.Opens, IsAffineOpen U → (Spec (F.obj (Opposite.op U)) ⟶ Z')), (∀ (U : Z.Opens) (hU : IsAffineOpen U), IsOpenImmersion (j U hU)) ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U), Set.range (j U hU) = ((pr ⁻¹ᵁ U : Z'.Opens) : Set Z')) ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U), j U hU ≫ pr = Spec.map (α.app (Opposite.op U)) ≫ hU.fromSpec) ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U) (f : Γ(Z, U)), Spec.map (F.map (homOfLE (Z.basicOpen_le f)).op) ≫ j U hU = j (Z.basicOpen f) (hU.basicOpen f)) := by
    intro F α hloc
    have H : NatTrans.Coequifibered
        (Functor.whiskerLeft (Scheme.AffineZariskiSite.toOpensFunctor Z).op α) := by
      rw [Scheme.AffineZariskiSite.coequifibered_iff_forall_isLocalizationAway]
      intro U f
      exact hloc U.1 U.2 f
    let d := Scheme.AffineZariskiSite.relativeGluingData H
    haveI : (d.functor ⋙ Scheme.forget).IsLocallyDirected :=
      Scheme.Cover.RelativeGluingData.instIsLocallyDirectedI₀CompFunctorForgetOfIsThin ..
    refine ⟨d.glued, d.toBase,
      fun U hU => Limits.colimit.ι d.functor (⟨U, hU⟩ : Z.AffineZariskiSite), ?_, ?_, ?_, ?_⟩
    · intro U hU
      have h := d.isPullback_natTrans_ι_toBase (⟨U, hU⟩ : Z.AffineZariskiSite)
      have hU' : IsOpenImmersion ((Scheme.AffineZariskiSite.directedCover Z).f
          (⟨U, hU⟩ : Z.AffineZariskiSite)) := by
        show IsOpenImmersion U.ι
        infer_instance
      show IsOpenImmersion (Limits.colimit.ι d.functor (⟨U, hU⟩ : Z.AffineZariskiSite))
      exact MorphismProperty.of_isPullback (P := @IsOpenImmersion) h hU'
    · intro U hU
      have h := d.toBase_preimage_eq_opensRange_ι (⟨U, hU⟩ : Z.AffineZariskiSite)
      have h' : Scheme.Hom.opensRange ((Scheme.AffineZariskiSite.directedCover Z).f
          (⟨U, hU⟩ : Z.AffineZariskiSite)) = U :=
        Scheme.Opens.opensRange_ι U
      rw [h'] at h
      show Set.range (Limits.colimit.ι d.functor (⟨U, hU⟩ : Z.AffineZariskiSite)) = _
      rw [h, Scheme.Hom.coe_opensRange]
    · intro U hU
      have h := d.ι_toBase (⟨U, hU⟩ : Z.AffineZariskiSite)
      refine h.trans ?_
      have e : d.natTrans.app (⟨U, hU⟩ : Z.AffineZariskiSite) =
          Spec.map (α.app (Opposite.op U)) ≫ hU.isoSpec.inv := rfl
      rw [e]
      exact (Category.assoc _ _ _).trans
        (congrArg (Spec.map (α.app (Opposite.op U)) ≫ ·) (IsAffineOpen.isoSpec_inv_ι hU))
    · intro U hU f
      exact Limits.colimit.w d.functor
        (homOfLE (Scheme.AffineZariskiSite.basicOpen_le (⟨U, hU⟩ : Z.AffineZariskiSite) f))

  have s5 : ∀ (Z' : Scheme.{u}) (pr : Z' ⟶ Z) (F : Z.Opensᵒᵖ ⥤ CommRingCat.{u}) (α : Z.presheaf ⟶ F) (j : ∀ U : Z.Opens, IsAffineOpen U → (Spec (F.obj (Opposite.op U)) ⟶ Z')), (∀ (U : Z.Opens) (hU : IsAffineOpen U), IsOpenImmersion (j U hU)) → (∀ (U : Z.Opens) (hU : IsAffineOpen U), Set.range (j U hU) = ((pr ⁻¹ᵁ U : Z'.Opens) : Set Z')) → (∀ (U : Z.Opens) (hU : IsAffineOpen U), j U hU ≫ pr = Spec.map (α.app (Opposite.op U)) ≫ hU.fromSpec) → (∀ (U : Z.Opens) (hU : IsAffineOpen U) (f : Γ(Z, U)), Spec.map (F.map (homOfLE (Z.basicOpen_le f)).op) ≫ j U hU = j (Z.basicOpen f) (hU.basicOpen f)) → ∃ e : ∀ U : Z.Opens, IsAffineOpen U → (Γ(Z', pr ⁻¹ᵁ U) ≃+* F.obj (Opposite.op U)), (∀ (U : Z.Opens), IsAffineOpen U → IsAffineOpen (pr ⁻¹ᵁ U)) ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U) (c : Γ(Z, U)), e U hU (pr.app U c) = α.app (Opposite.op U) c) ∧ (∀ (U V : Z.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V) (hle : V ≤ U) (f : Γ(Z, U)), Z.basicOpen f = V → ∀ y : Γ(Z', pr ⁻¹ᵁ U), e V hV (Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op y) = F.map (homOfLE hle).op (e U hU y)) := by
    intro Z' pr F α j hj1 hj2 hj3 hj4
    have hTop : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S) (e : (⊤ : (Spec S).Opens) ≤ (Spec.map φ) ⁻¹ᵁ ⊤),
        (Spec.map φ).appLE ⊤ ⊤ e = (Spec.map φ).appTop := fun φ e => (Spec.map φ).appLE_eq_app
    have htop' : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S),
        (⊤ : (Spec S).Opens) ≤ (Spec.map φ) ⁻¹ᵁ ⊤ := fun φ x _ => trivial
    have hle : ∀ (U : Z.Opens) (hU : IsAffineOpen U),
        (⊤ : (Spec (F.obj (Opposite.op U))).Opens) ≤ (j U hU) ⁻¹ᵁ (pr ⁻¹ᵁ U) := by
      intro U hU x _
      show (j U hU) x ∈ ((pr ⁻¹ᵁ U : Z'.Opens) : Set Z')
      rw [← hj2 U hU]
      exact Set.mem_range_self x
    have hO : ∀ (U : Z.Opens) (hU : IsAffineOpen U),
        pr ⁻¹ᵁ U = @Scheme.Hom.opensRange _ _ (j U hU) (hj1 U hU) := by
      intro U hU
      apply TopologicalSpace.Opens.ext
      rw [Scheme.Hom.coe_opensRange, hj2]
    have hiso : ∀ (U : Z.Opens) (hU : IsAffineOpen U),
        IsIso ((j U hU).appLE (pr ⁻¹ᵁ U) ⊤ (hle U hU)) := by
      intro U hU
      haveI := hj1 U hU
      have hO' : (j U hU) ''ᵁ ⊤ = pr ⁻¹ᵁ U := by
        rw [Scheme.Hom.image_top_eq_opensRange, hO U hU]
      have h0 := (inferInstance : IsIso ((j U hU).appIso ⊤).hom)
      rw [Scheme.Hom.appIso_hom'] at h0
      exact (Scheme.Hom.appLE_congr (j U hU) _ hO' rfl (fun f => IsIso f)).mp h0
    let eU : ∀ U : Z.Opens, IsAffineOpen U → (Γ(Z', pr ⁻¹ᵁ U) ≃+* F.obj (Opposite.op U)) :=
      fun U hU => (haveI := hiso U hU
        asIso ((j U hU).appLE (pr ⁻¹ᵁ U) ⊤ (hle U hU) ≫
          (Scheme.ΓSpecIso (F.obj (Opposite.op U))).hom)).commRingCatIsoToRingEquiv
    have heU : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (y : Γ(Z', pr ⁻¹ᵁ U)),
        eU U hU y = ((j U hU).appLE (pr ⁻¹ᵁ U) ⊤ (hle U hU) ≫
          (Scheme.ΓSpecIso (F.obj (Opposite.op U))).hom) y := fun _ _ _ => rfl
    refine ⟨eU, ?_, ?_, ?_⟩
    · intro U hU
      haveI := hj1 U hU
      rw [hO U hU]
      exact isAffineOpen_opensRange _
    · intro U hU c
      rw [heU]
      have key : ∀ (g : Spec (F.obj (Opposite.op U)) ⟶ Z)
          (hg : g = Spec.map (α.app (Opposite.op U)) ≫ hU.fromSpec) (e : ⊤ ≤ g ⁻¹ᵁ U),
          g.appLE U ⊤ e ≫ (Scheme.ΓSpecIso _).hom = α.app (Opposite.op U) := by
        rintro _ rfl e
        rw [← Scheme.Hom.appLE_comp_appLE (Spec.map (α.app (Opposite.op U))) hU.fromSpec U ⊤ ⊤
          (le_of_eq hU.fromSpec_preimage_self.symm) (htop' _)]
        have h3 : hU.fromSpec.appLE U ⊤ (le_of_eq hU.fromSpec_preimage_self.symm) =
            (Scheme.ΓSpecIso Γ(Z, U)).inv := by
          rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc,
            ← Functor.map_comp]
          have hid : ∀ (k : (Opposite.op (⊤ : (Spec Γ(Z, U)).Opens)) ⟶ Opposite.op ⊤),
              k = 𝟙 _ := fun k => Subsingleton.elim _ _
          rw [hid (_ ≫ _), CategoryTheory.Functor.map_id, Category.comp_id]
        rw [h3, Category.assoc, hTop, Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
      have h2 : pr.app U ≫ (j U hU).appLE (pr ⁻¹ᵁ U) ⊤ (hle U hU) ≫
          (Scheme.ΓSpecIso (F.obj (Opposite.op U))).hom = α.app (Opposite.op U) := by
        rw [← Category.assoc, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
        exact key _ (hj3 U hU) _
      exact congrArg (fun φ => φ.hom c) h2
    · intro U V hU hV hle' f hf y
      subst hf
      rw [heU, heU]
      have key : ∀ (g : Spec (F.obj (Opposite.op (Z.basicOpen f))) ⟶ Z')
          (hg : Spec.map (F.map (homOfLE hle').op) ≫ j U hU = g) (e : ⊤ ≤ g ⁻¹ᵁ (pr ⁻¹ᵁ U)),
          g.appLE (pr ⁻¹ᵁ U) ⊤ e ≫ (Scheme.ΓSpecIso _).hom =
            (j U hU).appLE (pr ⁻¹ᵁ U) ⊤ (hle U hU) ≫ (Scheme.ΓSpecIso _).hom ≫
              F.map (homOfLE hle').op := by
        rintro _ rfl e
        rw [← Scheme.Hom.appLE_comp_appLE (Spec.map _) (j U hU) (pr ⁻¹ᵁ U) ⊤ ⊤ (hle U hU)
          (htop' _), Category.assoc, hTop, Scheme.ΓSpecIso_naturality]
      have h2 : Z'.presheaf.map (homOfLE (pr.preimage_mono hle')).op ≫
          (j (Z.basicOpen f) hV).appLE (pr ⁻¹ᵁ Z.basicOpen f) ⊤ (hle (Z.basicOpen f) hV) ≫
            (Scheme.ΓSpecIso _).hom =
          (j U hU).appLE (pr ⁻¹ᵁ U) ⊤ (hle U hU) ≫ (Scheme.ΓSpecIso _).hom ≫
              F.map (homOfLE hle').op := by
        rw [← Category.assoc, Scheme.Hom.map_appLE]
        exact key _ (hj4 U hU f) _
      exact congrArg (fun φ => φ.hom y) h2
  obtain ⟨F, α, ι0, π0, h1, h2, h3, h4, h5, h6, h7, h8⟩ := s3
  obtain ⟨Z', pr, j, hj1, hj2, hj3, hj4⟩ := s4 F α h1
  obtain ⟨e, hAff, hα, hbo⟩ := s5 Z' pr F α j hj1 hj2 hj3 hj4

  have hnat : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (y : Γ(Z', pr ⁻¹ᵁ U)), e U' hU' (Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op y) =
        F.map (homOfLE hle).op (e U hU y) := by
    intro U U' hU hU' hle y
    have hx : ∀ x : U', ∃ (f : Γ(Z, U)) (g : Γ(Z, U')), Z.basicOpen f = Z.basicOpen g ∧
        (x : Z) ∈ Z.basicOpen f := fun x =>
      exists_basicOpen_le_affine_inter hU hU' x.1 ⟨hle x.2, x.2⟩
    choose f g hfg hxf using hx
    have hVU' : ∀ x : U', Z.basicOpen (g x) ≤ U' := fun x => Z.basicOpen_le (g x)
    have hVU : ∀ x : U', Z.basicOpen (g x) ≤ U := fun x => (hfg x) ▸ Z.basicOpen_le (f x)
    apply h2 U' U' (fun x => Z.basicOpen (g x)) hVU'
    · intro x hx'
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨⟨x, hx'⟩, (hfg ⟨x, hx'⟩) ▸ hxf ⟨x, hx'⟩⟩
    intro x
    have e1 := hbo U' (Z.basicOpen (g x)) hU' (hU'.basicOpen (g x)) (hVU' x) (g x) rfl
      (Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op y)
    have e2 := hbo U (Z.basicOpen (g x)) hU (hU'.basicOpen (g x)) (hVU x) (f x) (hfg x) y
    rw [← e1, ← CommRingCat.comp_apply, ← Functor.map_comp, ← CommRingCat.comp_apply,
      ← Functor.map_comp]
    exact e2
  have hprapp : ∀ (U : Z.Opens) (hU : IsAffineOpen U) (c : Γ(Z, U)),
      pr.app U c = (e U hU).symm (α.app (Opposite.op U) c) := fun U hU c =>
    ((e U hU).symm_apply_eq.mpr (hα U hU c).symm).symm
  refine ⟨Z', pr, fun U hU => (e U hU).symm.toAddMonoidHom.comp (ι0 U),
    fun U hU => (π0 U).comp (e U hU).toAddMonoidHom, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · haveI : IsAffineHom pr := ⟨fun U hU => hAff U hU⟩
    refine { finite_app := fun U hU => ?_ }
    have hc : (pr.app U).hom = (e U hU).symm.toRingHom.comp (α.app (Opposite.op U)).hom := by
      ext c
      exact hprapp U hU c
    rw [hc]
    exact RingHom.Finite.comp (RingHom.Finite.of_surjective _ (e U hU).symm.surjective) (h8 U hU)
  · intro U hU m
    show π0 U (e U hU ((e U hU).symm (ι0 U m))) = m
    rw [RingEquiv.apply_symm_apply]
    exact h3 U m
  · intro U hU c m
    show (e U hU).symm (ι0 U (c • m)) = pr.app U c * (e U hU).symm (ι0 U m)
    rw [h4, map_mul, hprapp U hU c]
  · intro U hU c y
    show π0 U (e U hU (pr.app U c * y)) = c • π0 U (e U hU y)
    rw [map_mul, hα, h5]
  · intro U U' hU hU' hle m
    show (e U' hU').symm (ι0 U' (M.presheaf.map (homOfLE hle).op m)) =
      Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op ((e U hU).symm (ι0 U m))
    apply (e U' hU').injective
    rw [RingEquiv.apply_symm_apply, hnat U U' hU hU' hle, RingEquiv.apply_symm_apply, h6]
  · intro U U' hU hU' hle y
    show π0 U' (e U' hU' (Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op y)) =
      M.presheaf.map (homOfLE hle).op (π0 U (e U hU y))
    rw [hnat U U' hU hU' hle, h7]

theorem wc_cn_cech_artin_rees_module : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (M : Z.Modules) (Z' : Scheme.{u}) (pr : Z' ⟶ Z) (ι : ∀ U : Z.Opens, IsAffineOpen U → (Γ(M, U) →+ Γ(Z', pr ⁻¹ᵁ U))) (π : ∀ U : Z.Opens, IsAffineOpen U → (Γ(Z', pr ⁻¹ᵁ U) →+ Γ(M, U))), IsFinite pr → (∀ (U : Z.Opens) (hU : IsAffineOpen U) (m : Γ(M, U)), π U hU (ι U hU m) = m) → (∀ (U : Z.Opens) (hU : IsAffineOpen U) (c : Γ(Z, U)) (m : Γ(M, U)), ι U hU (c • m) = pr.app U c * ι U hU m) → (∀ (U : Z.Opens) (hU : IsAffineOpen U) (c : Γ(Z, U)) (y : Γ(Z', pr ⁻¹ᵁ U)), π U hU (pr.app U c * y) = c • π U hU y) → (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U) (m : Γ(M, U)), ι U' hU' (M.presheaf.map (homOfLE hle).op m) = Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op (ι U hU m)) → (∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U) (y : Γ(Z', pr ⁻¹ᵁ U)), π U' hU' (Z'.presheaf.map (homOfLE (pr.preimage_mono hle)).op y) = M.presheaf.map (homOfLE hle).op (π U hU y)) → ∀ (r : ℕ) (U : Fin r → Z.Opens), (∀ i, IsAffineOpen (U i)) → (∀ x : Z, ∃ i, x ∈ U i) → (∀ i j, IsAffineOpen (U i ⊓ U j)) → ∃ (q : ℕ) (deg : Fin q → ℕ) (y : Fin q → ∀ i : Fin r, Γ(M, U i)), wcCnARM h I M r U q deg y :=
by
  intro B _ _ I Z h _ M Z' pr ι π hpr h1 h2 h3 h4 h5 r U hUaff hcov hint
  classical
  haveI := hpr

  have s1 : ∀ (A : Type u) [CommRing A] (Idx : Type) [Fintype Idx] (S : Idx → Type u)
      [∀ i, CommRing (S i)] (ψ : ∀ i, A →+* S i) (J : Ideal A) (x : ∀ i, S i),
      x ∈ Ideal.map (RingHom.pi ψ) J ↔ ∀ i, x i ∈ Ideal.map (ψ i) J := by
    intro A _ Idx _ S _ ψ J x
    have e : ∀ i, (Pi.evalRingHom S i).comp (RingHom.pi ψ) = ψ i :=
      fun i => RingHom.ext fun _ => rfl
    constructor
    · intro hx i
      have := Ideal.mem_map_of_mem (Pi.evalRingHom S i) hx
      rwa [Ideal.map_map, e] at this
    · intro hx
      rw [← Finset.univ_sum_single x]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      have hsurj : Function.Surjective (Pi.evalRingHom S i) :=
        fun c => ⟨Pi.single i c, Pi.single_eq_same i c⟩
      have hxi : x i ∈ Ideal.map (Pi.evalRingHom S i) (Ideal.map (RingHom.pi ψ) J) := by
        rw [Ideal.map_map, e]; exact hx i
      obtain ⟨y, hy, hyi⟩ := (Ideal.mem_map_iff_of_surjective _ hsurj).mp hxi
      have hsingle : Pi.single i (x i) = Pi.single i 1 * y := by
        funext j
        by_cases hj : j = i
        · subst hj
          simp only [Pi.mul_apply, Pi.single_eq_same, one_mul]
          exact hyi.symm
        · simp only [Pi.mul_apply, Pi.single_eq_of_ne hj, zero_mul]
      rw [hsingle]
      exact Ideal.mul_mem_left _ _ hy

  have s2 : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (f : R →+* R') (σ : B →+* R)
      (J : Ideal B) (N : Type u) [AddCommGroup N] [Module R N] (ι₀ : N →+ R'),
      (∀ (c : R) (m : N), ι₀ (c • m) = f c * ι₀ m) → ∀ m : N,
      m ∈ Ideal.map σ J • (⊤ : Submodule R N) → ι₀ m ∈ Ideal.map (f.comp σ) J := by
    intro R R' _ _ f σ J N _ _ ι₀ hι m hm
    refine Submodule.smul_induction_on (p := fun m => ι₀ m ∈ Ideal.map (f.comp σ) J) hm ?_ ?_
    · intro c hc n _
      show ι₀ (c • n) ∈ Ideal.map (f.comp σ) J
      rw [hι]
      refine Ideal.mul_mem_right _ _ ?_
      have := Ideal.mem_map_of_mem f hc
      rwa [Ideal.map_map] at this
    · intro a b ha hb
      show ι₀ (a + b) ∈ Ideal.map (f.comp σ) J
      rw [map_add]
      exact Ideal.add_mem _ ha hb

  have s3 : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (f : R →+* R') (σ : B →+* R)
      (J : Ideal B) (N : Type u) [AddCommGroup N] [Module R N] (π₀ : R' →+ N),
      (∀ (c : R) (y : R'), π₀ (f c * y) = c • π₀ y) → ∀ z : R',
      z ∈ Ideal.map (f.comp σ) J → π₀ z ∈ Ideal.map σ J • (⊤ : Submodule R N) := by
    intro R R' _ _ f σ J N _ _ π₀ hπ z hz
    have hz' : z ∈ Submodule.span R' ((f.comp σ) '' (J : Set B)) := hz
    clear hz
    have key : ∀ a : R', π₀ (a * z) ∈ Ideal.map σ J • (⊤ : Submodule R N) := by
      induction hz' using Submodule.span_induction with
      | mem t ht =>
        obtain ⟨b, hb, rfl⟩ := ht
        intro a
        rw [mul_comm, RingHom.comp_apply, hπ]
        exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem σ hb) Submodule.mem_top
      | zero =>
        intro a
        rw [mul_zero, map_zero]
        exact Submodule.zero_mem _
      | add s t _ _ hs ht =>
        intro a
        rw [mul_add, map_add]
        exact Submodule.add_mem _ (hs a) (ht a)
      | smul c t _ ht =>
        intro a
        rw [smul_eq_mul, ← mul_assoc]
        exact ht (a * c)
    have := key 1
    rwa [one_mul] at this

  have s4 : ∀ (V : Z.Opens) (b : B),
      wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ V) b = pr.app V (wcCnSigma h V b) := by
    intro V b
    have e : Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op ≫ pr.app V =
        pr.appTop ≫ Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V ≤ ⊤)).op := by
      rw [Scheme.Hom.naturality]; rfl
    have e2 := congrArg (fun φ => φ.hom (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b))) e
    show (Z'.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ V ≤ ⊤)).op).hom
        ((pr ≫ h).appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)) =
      (pr.app V).hom ((Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
        (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)))
    rw [Scheme.Hom.comp_appTop]
    exact e2.symm
  have hσ : ∀ V : Z.Opens, wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ V) = (pr.app V).hom.comp (wcCnSigma h V) :=
    fun V => RingHom.ext (fun b => s4 V b)

  have hU'aff : ∀ i, IsAffineOpen (pr ⁻¹ᵁ U i) := fun i => (hUaff i).preimage pr
  have hU'cov : ∀ x : Z', ∃ i, x ∈ pr ⁻¹ᵁ U i := fun x => by
    obtain ⟨i, hi⟩ := hcov (pr x)
    exact ⟨i, hi⟩
  have hU'int : ∀ i j, IsAffineOpen (pr ⁻¹ᵁ U i ⊓ pr ⁻¹ᵁ U j) :=
    fun i j => (hint i j).preimage pr
  obtain ⟨q, deg, y', H⟩ :=
    wc_proper_cech_artin_rees B I Z' (pr ≫ h) r (fun i => pr ⁻¹ᵁ U i) hU'aff hU'cov hU'int
  beta_reduce at H

  have Dι : ∀ (x : ∀ i, Γ(M, U i)) (p : Fin r × Fin r),
      Z'.presheaf.map (homOfLE (inf_le_right : pr ⁻¹ᵁ U p.1 ⊓ pr ⁻¹ᵁ U p.2 ≤ pr ⁻¹ᵁ U p.2)).op
          (ι (U p.2) (hUaff p.2) (x p.2)) -
        Z'.presheaf.map (homOfLE (inf_le_left : pr ⁻¹ᵁ U p.1 ⊓ pr ⁻¹ᵁ U p.2 ≤ pr ⁻¹ᵁ U p.1)).op
          (ι (U p.1) (hUaff p.1) (x p.1)) =
      ι (U p.1 ⊓ U p.2) (hint p.1 p.2)
        (M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) -
          M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) := by
    intro x p
    rw [map_sub, h4 (U p.2) _ (hUaff p.2) (hint p.1 p.2) inf_le_right,
      h4 (U p.1) _ (hUaff p.1) (hint p.1 p.2) inf_le_left]
    rfl
  have Dπ : ∀ (z : ∀ i, Γ(Z', pr ⁻¹ᵁ U i)) (p : Fin r × Fin r),
      π (U p.1 ⊓ U p.2) (hint p.1 p.2)
        (Z'.presheaf.map (homOfLE (inf_le_right : pr ⁻¹ᵁ U p.1 ⊓ pr ⁻¹ᵁ U p.2 ≤ pr ⁻¹ᵁ U p.2)).op
            (z p.2) -
          Z'.presheaf.map (homOfLE (inf_le_left : pr ⁻¹ᵁ U p.1 ⊓ pr ⁻¹ᵁ U p.2 ≤ pr ⁻¹ᵁ U p.1)).op
            (z p.1)) =
      M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op
          (π (U p.2) (hUaff p.2) (z p.2)) -
        M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op
          (π (U p.1) (hUaff p.1) (z p.1)) := by
    intro z p
    rw [← h5 (U p.2) _ (hUaff p.2) (hint p.1 p.2) inf_le_right,
      ← h5 (U p.1) _ (hUaff p.1) (hint p.1 p.2) inf_le_left, ← map_sub]
    rfl
  have hterm : ∀ (p : Fin r × Fin r) (b : B) (t : Γ(Z', pr ⁻¹ᵁ (U p.1 ⊓ U p.2))),
      π (U p.1 ⊓ U p.2) (hint p.1 p.2) (wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ (U p.1 ⊓ U p.2)) b * t) =
        wcCnSigma h (U p.1 ⊓ U p.2) b • π (U p.1 ⊓ U p.2) (hint p.1 p.2) t := by
    intro p b t
    rw [s4]
    exact h3 _ _ _ t
  refine ⟨q, deg, fun l i => π (U i) (hUaff i) (y' l i), ?_⟩
  intro n x hx
  have hx' : (fun p : Fin r × Fin r =>
      Z'.presheaf.map (homOfLE (inf_le_right : pr ⁻¹ᵁ U p.1 ⊓ pr ⁻¹ᵁ U p.2 ≤ pr ⁻¹ᵁ U p.2)).op
          (ι (U p.2) (hUaff p.2) (x p.2)) -
        Z'.presheaf.map (homOfLE (inf_le_left : pr ⁻¹ᵁ U p.1 ⊓ pr ⁻¹ᵁ U p.2 ≤ pr ⁻¹ᵁ U p.1)).op
          (ι (U p.1) (hUaff p.1) (x p.1))) ∈
      Ideal.map (RingHom.pi (fun p : Fin r × Fin r =>
        wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ (U p.1 ⊓ U p.2)))) (I ^ n) := by
    refine (s1 B (Fin r × Fin r) (fun p => Γ(Z', pr ⁻¹ᵁ (U p.1 ⊓ U p.2))) _ _ _).mpr ?_
    intro p
    have := s2 _ _ (pr.app (U p.1 ⊓ U p.2)).hom (wcCnSigma h (U p.1 ⊓ U p.2)) (I ^ n) _
      (ι (U p.1 ⊓ U p.2) (hint p.1 p.2)) (fun c m => h2 _ _ c m) _ (hx p)
    rw [← hσ, ← Dι x p] at this
    exact this
  obtain ⟨a, w', ha, -, hw', hdx'⟩ := H n (fun i => ι (U i) (hUaff i) (x i)) hx'
  refine ⟨a, fun i => π (U i) (hUaff i) (w' i), ha, ?_, ?_⟩
  · intro i
    have hwi := (s1 B (Fin r) (fun i => Γ(Z', pr ⁻¹ᵁ U i))
      (fun i => wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ U i)) (I ^ n) w').mp hw' i
    rw [hσ] at hwi
    exact s3 _ _ (pr.app (U i)).hom (wcCnSigma h (U i)) (I ^ n) _ (π (U i) (hUaff i))
      (fun c y => h3 _ _ c y) _ hwi
  · intro p
    have e := congrFun hdx' p
    simp only [Finset.sum_apply, Pi.add_apply, Pi.mul_apply, RingHom.pi_apply] at e
    obtain ⟨π', hπ'⟩ : ∃ π' : Γ(Z', pr ⁻¹ᵁ U p.1 ⊓ pr ⁻¹ᵁ U p.2) →+ Γ(M, U p.1 ⊓ U p.2),
        ∀ t, π' t = π (U p.1 ⊓ U p.2) (hint p.1 p.2) t := ⟨_, fun _ => rfl⟩
    have e2 := congrArg π' e
    rw [hπ', Dι x p, h1] at e2
    rw [e2, map_add, map_sum]
    congr 1
    · refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [hπ']
      exact (hterm p (a l) _).trans (by rw [Dπ (y' l) p])
    · rw [hπ', Dπ w' p]

theorem wc_cn_ml_level_lift : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (Ms : ℕ → Z.Modules) (ψ : ∀ n, Ms (n + 1) ⟶ Ms n) (M : Z.Modules) (φ : ∀ n, M ⟶ Ms n), wcCnAdicSys h I Ms ψ → wcCnAlg h I Ms ψ M φ → ∀ (r : ℕ) (U : Fin r → Z.Opens), (∀ i, IsAffineOpen (U i)) → (∀ x : Z, ∃ i, x ∈ U i) → (∀ i j, IsAffineOpen (U i ⊓ U j)) → ∀ (q : ℕ) (deg : Fin q → ℕ) (y : Fin q → ∀ i : Fin r, Γ(M, U i)), wcCnARM h I M r U q deg y → ∀ s : ∀ n, Γ(Ms n, ⊤), (∀ n, Scheme.Modules.Hom.app (ψ n) ⊤ (s (n + 1)) = s n) → ∀ m : ℕ, ∃ t : Γ(M, ⊤), Scheme.Modules.Hom.app (φ m) ⊤ t = s m :=
by
  intro B _ I Z h Ms ψ M φ _hsys halg r U hUaff hcov hint q deg y hARM s hs m
  classical
  have hσres : ∀ (W W' : Z.Opens) (hle : W' ≤ W) (b : B),
      Z.presheaf.map (homOfLE hle).op (wcCnSigma h W b) = wcCnSigma h W' b := by
    intro W W' hle b
    show (Z.presheaf.map (homOfLE hle).op) ((Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)) =
      (Z.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hsmulres : ∀ (W W' : Z.Opens) (hle : W' ≤ W) (b : B) (z : Γ(M, W)),
      M.presheaf.map (homOfLE hle).op (wcCnSigma h W b • z) =
        wcCnSigma h W' b • M.presheaf.map (homOfLE hle).op z := by
    intro W W' hle b z
    rw [Scheme.Modules.map_smul, hσres]
  have hnat : ∀ (N N' : Z.Modules) (f : N ⟶ N') (W W' : Z.Opens) (hle : W' ≤ W) (x : Γ(N, W)),
      Scheme.Modules.Hom.app f W' (N.presheaf.map (homOfLE hle).op x) =
        N'.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app f W x) :=
    fun N N' f W W' hle x => PresheafOfModules.naturality_apply f.val (homOfLE hle).op x
  have hresres : ∀ (N : Z.Modules) (W W' : Z.Opens) (hle : W' ≤ W) (v : Γ(N, ⊤)),
      N.presheaf.map (homOfLE hle).op (N.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op v) =
        N.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op v := by
    intro N W W' hle v
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hstep : ∀ (n : ℕ) (W : Z.Opens) (x : Γ(M, W)),
      Scheme.Modules.Hom.app (ψ n) W (Scheme.Modules.Hom.app (φ (n + 1)) W x) =
        Scheme.Modules.Hom.app (φ n) W x := by
    intro n W x
    rw [← halg.2.1 n, Scheme.Modules.Hom.comp_app]
    rfl

  have hQ : ∀ (W : Z.Opens) (u : Γ(M, W)) (k : ℕ),
      Scheme.Modules.Hom.app (φ (m + k)) W u =
        (Ms (m + k)).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (s (m + k)) →
      Scheme.Modules.Hom.app (φ m) W u =
        (Ms m).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (s m) := by
    intro W u k
    induction k with
    | zero => intro hk; exact hk
    | succ k ih =>
      intro hk
      apply ih
      have hk' : Scheme.Modules.Hom.app (φ (m + k + 1)) W u =
          (Ms (m + k + 1)).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (s (m + k + 1)) := hk
      rw [← hstep (m + k) W u, hk', hnat, hs]

  obtain ⟨c, hdeg⟩ : ∃ c : ℕ, ∀ l, deg l ≤ c :=
    ⟨Finset.univ.sup deg, fun l => Finset.le_sup (Finset.mem_univ l)⟩
  choose x hx using fun i => (halg.2.2 (m + c) (U i) (hUaff i)).1
    ((Ms (m + c)).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (s (m + c)))
  have hloc : ∀ (k : ℕ) (W W' : Z.Opens) (hle : W' ≤ W) (u : Γ(M, W)),
      Scheme.Modules.Hom.app (φ k) W u =
        (Ms k).presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (s k) →
      Scheme.Modules.Hom.app (φ k) W' (M.presheaf.map (homOfLE hle).op u) =
        (Ms k).presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op (s k) := by
    intro k W W' hle u hu
    rw [hnat, hu, hresres]

  have hdx : ∀ p : Fin r × Fin r,
      M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) -
        M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1) ∈
      Ideal.map (wcCnSigma h (U p.1 ⊓ U p.2)) (I ^ (m + c + 1)) •
        (⊤ : Submodule Γ(Z, U p.1 ⊓ U p.2) Γ(M, U p.1 ⊓ U p.2)) := by
    intro p
    refine ((halg.2.2 (m + c) _ (hint p.1 p.2)).2 _).mp ?_
    rw [map_sub, hloc _ _ _ _ _ (hx p.2), hloc _ _ _ _ _ (hx p.1), sub_self]

  obtain ⟨a, w, ha, hw, hdxeq⟩ := hARM (m + c + 1) x hdx
  let b : ∀ i : Fin r, Γ(M, U i) := fun i => x i - ∑ l, wcCnSigma h (U i) (a l) • y l i - w i
  have hcoc : ∀ p : Fin r × Fin r,
      M.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (b p.2) -
        M.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (b p.1) = 0 := by
    intro p
    have key : ∀ (X1 X2 S1 S2 W1 W2 : Γ(M, U p.1 ⊓ U p.2)),
        X2 - X1 = (S2 - S1) + (W2 - W1) → (X2 - S2 - W2) - (X1 - S1 - W1) = 0 := by
      intro X1 X2 S1 S2 W1 W2 he
      have e2 : X2 = X1 + ((S2 - S1) + (W2 - W1)) := by rw [← he]; abel
      rw [e2]; abel
    have e := hdxeq p
    simp only [smul_sub, Finset.sum_sub_distrib] at e
    simp only [b, map_sub, map_sum, hsmulres]
    exact key _ _ _ _ _ _ e
  have hcompat : TopCat.Presheaf.IsCompatible
      (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Z).obj U b := by
    intro i j
    exact (sub_eq_zero.mp (hcoc (i, j))).symm
  have hcov' : (⊤ : Z.Opens) ≤ iSup U := by
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact hcov z
  obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing'
    (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Z) U ⊤ (fun i => homOfLE le_top) hcov' b hcompat
  have ht' : ∀ i, M.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op t = b i := ht

  have hb : ∀ i, Scheme.Modules.Hom.app (φ m) (U i) (b i) =
      (Ms m).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (s m) := by
    intro i
    have h1 : x i - b i ∈ Ideal.map (wcCnSigma h (U i)) (I ^ (m + 1)) •
        (⊤ : Submodule Γ(Z, U i) Γ(M, U i)) := by
      have e : x i - b i = ∑ l, wcCnSigma h (U i) (a l) • y l i + w i := by
        simp only [b]; abel
      rw [e]
      refine Submodule.add_mem _ (Submodule.sum_mem _ (fun l _ => ?_)) ?_
      · refine Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ ?_) Submodule.mem_top
        exact Ideal.pow_le_pow_right (by have := hdeg l; omega) (ha l)
      · exact Submodule.smul_mono_left (Ideal.map_mono (Ideal.pow_le_pow_right (by omega))) (hw i)
    have h2 := ((halg.2.2 m (U i) (hUaff i)).2 _).mpr h1
    rw [map_sub, sub_eq_zero] at h2
    rw [← h2]
    exact hQ (U i) (x i) c (hx i)
  refine ⟨t, ?_⟩
  apply TopCat.Sheaf.eq_of_locally_eq' (⟨(Ms m).presheaf, (Ms m).isSheaf⟩ : TopCat.Sheaf Ab Z) U ⊤
    (fun i => homOfLE le_top) hcov'
  intro i
  change (Ms m).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (Scheme.Modules.Hom.app (φ m) ⊤ t) =
    (Ms m).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op (s m)
  rw [← hnat, ht', hb]

theorem wc_cn_closed_fibre_vanishing : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (M : Z.Modules), wcCoherentMod M → ∀ t : Γ(M, ⊤), (∀ (n : ℕ) (U : Z.Opens), IsAffineOpen U → M.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op t ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(M, U))) → t = 0 :=
by
  intro B _ _ _ Z h _ M hM t ht
  classical

  have s4 : ∀ (U : Z.Opens) (f : Γ(Z, U)) (x : Γ(M, U)), f • x = 0 →
      M.presheaf.map (homOfLE (Z.basicOpen_le f)).op x = 0 := by
    intro U f x hfx
    have hu : IsUnit ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) :=
      RingedSpace.isUnit_res_basicOpen Z.toRingedSpace f
    have e := Scheme.Modules.map_smul M (homOfLE (Z.basicOpen_le f)) f x
    rw [hfx, map_zero] at e
    exact (hu.smul_eq_zero).mp e.symm

  have s2 : ∀ (U : Z.Opens) (z : Z) (hz : z ∈ U), h z = IsLocalRing.closedPoint B →
      ∀ a ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B), z ∈ Z.basicOpen (1 - a) := by
    intro U z hz hzc a ha
    have hle : Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ≤
        Ideal.comap (Z.presheaf.germ U z hz).hom
          (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hunit
      have h1 : z ∈ Z.basicOpen (wcCnSigma h U b) := (Scheme.mem_basicOpen Z _ z hz).mpr hunit
      have h2 : Z.basicOpen (wcCnSigma h U b) =
          U ⊓ Z.basicOpen (h.appTop ((Scheme.ΓSpecIso (.of B)).inv b)) :=
        Scheme.basicOpen_res Z _ _
      rw [h2] at h1
      have h3 : z ∈ Z.basicOpen (h.appTop ((Scheme.ΓSpecIso (.of B)).inv b)) :=
        (TopologicalSpace.Opens.mem_inf.mp h1).2
      have h4 : z ∈ h ⁻¹ᵁ (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv b) := by
        rw [Scheme.preimage_basicOpen]; exact h3
      rw [basicOpen_eq_of_affine] at h4
      have h5 : b ∉ (h z).asIdeal := h4
      rw [hzc] at h5
      exact h5 hb
    have hga : (Z.presheaf.germ U z hz).hom a ∈ nonunits (Z.presheaf.stalk z) :=
      (IsLocalRing.mem_maximalIdeal _).mp (hle ha)
    rw [Scheme.mem_basicOpen Z _ z hz, map_sub, map_one]
    exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hga

  have s3 : ∀ (W : Z.Opens), (∀ z : Z, h z = IsLocalRing.closedPoint B → z ∈ W) → W = ⊤ := by
    intro W hW
    rw [eq_top_iff]
    intro z₁ _
    by_contra hz₁
    have hC : IsClosed ((W : Set Z)ᶜ) := W.isOpen.isClosed_compl
    have hhC : IsClosed (h '' ((W : Set Z)ᶜ)) := Scheme.Hom.isClosedMap h _ hC
    have hspec : h z₁ ⤳ IsLocalRing.closedPoint B :=
      (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal (h z₁).2.ne_top)
    obtain ⟨z, hzC, hz⟩ := hspec.mem_closed hhC ⟨z₁, hz₁, rfl⟩
    exact hzC (hW z hz)

  haveI : IsLocallyNoetherian (Spec (.of B)) := isLocallyNoetherian_Spec.mpr inferInstance
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h

  have key : ∀ U : Z.affineOpens, ∃ a ∈ Ideal.map (wcCnSigma h U.1) (IsLocalRing.maximalIdeal B),
      (1 - a) • M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op t = 0 := by
    intro U
    haveI : IsNoetherianRing Γ(Z, U.1) := IsLocallyNoetherian.component_noetherian U
    haveI : Module.Finite Γ(Z, U.1) Γ(M, U.1) := hM.2 U.1 U.2
    have hmem : M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op t ∈
        ⨅ i, (Ideal.map (wcCnSigma h U.1) (IsLocalRing.maximalIdeal B)) ^ i •
          (⊤ : Submodule Γ(Z, U.1) Γ(M, U.1)) := by
      rw [Submodule.mem_iInf]
      intro i
      cases i with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
        exact Submodule.mem_top
      | succ n =>
        rw [← Ideal.map_pow]
        exact ht n U.1 U.2
    obtain ⟨r, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff _ _).mp hmem
    exact ⟨r, r.2, by rw [sub_smul, one_smul, hr, sub_self]⟩
  choose a ha hka using key
  let D : Z.affineOpens → Z.Opens := fun U => Z.basicOpen (1 - a U)
  have hW : (⨆ U, D U) = ⊤ := by
    apply s3
    intro z hz
    obtain ⟨U', hU', hzU', -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
        (show z ∈ (⊤ : Z.Opens) from trivial)
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨U', hU'⟩, s2 U' z hzU' hz _ (ha ⟨U', hU'⟩)⟩
  have hres : ∀ U : Z.affineOpens, M.presheaf.map (homOfLE (le_top : D U ≤ ⊤)).op t = 0 := by
    intro U
    have e : M.presheaf.map (homOfLE (le_top : D U ≤ ⊤)).op t =
        M.presheaf.map (homOfLE (Z.basicOpen_le (1 - a U))).op
          (M.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op t) := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl
    rw [e]
    exact s4 U.1 (1 - a U) _ (hka U)
  exact TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab Z) D ⊤
    (fun U => homOfLE le_top) hW.ge t 0 (fun U => (hres U).trans (map_zero _).symm)

theorem wc_cn_chevalley_limit : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (R : Type u) [CommRing R] (σ : B →+* R) (K : Type u) [AddCommGroup K] [Module R K], (∃ (k : ℕ) (c : Fin k → K), ∀ x : K, ∃ b : Fin k → B, x = ∑ l, σ (b l) • c l) → ∀ (F : ℕ → Submodule R K), (∀ n, F (n + 1) ≤ F n) → (∀ x : K, (∀ n, x ∈ F n) → x = 0) → (∀ n, Ideal.map σ (IsLocalRing.maximalIdeal B ^ (n + 1)) • (⊤ : Submodule R K) ≤ F n) → ∀ u : ℕ → K, (∀ n, u n - u (n + 1) ∈ F n) → ∃ t : K, ∀ n, t - u n ∈ F n :=
by

  have s1 : ∀ (B : Type u) [CommRing B] (I : Ideal B) [IsPrecomplete I B] (K : Type u) [AddCommGroup K] [Module B K] (k : ℕ) (c : Fin k → K), Submodule.span B (Set.range c) = ⊤ → ∀ g : ℕ → K, (∀ e, g e - g (e + 1) ∈ I ^ e • (⊤ : Submodule B K)) → ∃ L : K, ∀ e, g e - L ∈ I ^ e • (⊤ : Submodule B K) := by
    intro B _ I _ K _ _ k c hspan g hg
    classical
    have hβ : ∀ e, ∃ β : Fin k → B, (∀ l, β l ∈ I ^ e) ∧ ∑ l, β l • c l = g e - g (e + 1) := by
      intro e
      have h := hg e
      rw [← hspan] at h
      obtain ⟨a, ha, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp h
      refine ⟨a, ha, ?_⟩
      rw [← hsum, Finsupp.sum_fintype]
      intro i; exact zero_smul _ _
    choose β hβI hβs using hβ
    obtain ⟨S, hS⟩ : ∃ S : Fin k → ℕ → B, ∀ l E, S l E = ∑ e ∈ Finset.range E, β e l :=
      ⟨fun l E => ∑ e ∈ Finset.range E, β e l, fun _ _ => rfl⟩
    have hSc : ∀ l, ∀ {m n : ℕ}, m ≤ n → S l m ≡ S l n [SMOD I ^ m • (⊤ : Submodule B B)] := by
      intro l m n hmn
      rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
      have : S l n - S l m = ∑ e ∈ Finset.Ico m n, β e l := by
        rw [hS, hS, Finset.sum_Ico_eq_sub _ hmn]
      rw [← neg_sub, this]
      refine neg_mem (Ideal.sum_mem _ fun e he => ?_)
      exact Ideal.pow_le_pow_right (Finset.mem_Ico.mp he).1 (hβI e l)
    have hLc : ∀ l, ∃ L : B, ∀ n, S l n ≡ L [SMOD I ^ n • (⊤ : Submodule B B)] := fun l =>
      IsPrecomplete.prec inferInstance (hSc l)
    choose Lc hLc using hLc
    have htel : ∀ E, g E = g 0 - ∑ l, S l E • c l := by
      intro E
      induction E with
      | zero => simp [hS]
      | succ E ih =>
        have : ∑ l, S l (E+1) • c l = ∑ l, S l E • c l + (g E - g (E+1)) := by
          rw [← hβs E, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun l _ => ?_
          rw [hS, hS, Finset.sum_range_succ, add_smul]
        rw [this, ih]; abel
    refine ⟨g 0 - ∑ l, Lc l • c l, fun E => ?_⟩
    have : g E - (g 0 - ∑ l, Lc l • c l) = ∑ l, (Lc l - S l E) • c l := by
      rw [htel E]; simp only [sub_smul, Finset.sum_sub_distrib]; abel
    rw [this]
    refine Submodule.sum_mem _ fun l _ => Submodule.smul_mem_smul ?_ Submodule.mem_top
    have h := (SModEq.sub_mem.mp (hLc l E))
    rw [smul_eq_mul, Ideal.mul_top] at h
    rw [← neg_sub]; exact neg_mem h

  have s2 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (K : Type u) [AddCommGroup K] [Module B K] [Module.Finite B K] (G : Submodule B K) (x : K), (∀ e : ℕ, x ∈ G ⊔ IsLocalRing.maximalIdeal B ^ e • (⊤ : Submodule B K)) → x ∈ G := by
    intro B _ _ _ K _ _ _ G x hx
    have hbot : ⨅ i, IsLocalRing.maximalIdeal B ^ i • (⊤ : Submodule B (K ⧸ G)) = ⊥ :=
      Ideal.iInf_pow_smul_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal B).ne_top
    rw [← Submodule.Quotient.mk_eq_zero]
    have : (Submodule.Quotient.mk x : K ⧸ G) ∈ ⨅ i, IsLocalRing.maximalIdeal B ^ i • (⊤ : Submodule B (K ⧸ G)) := by
      rw [Submodule.mem_iInf]
      intro e
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (hx e)
      rw [Submodule.Quotient.mk_add, (Submodule.Quotient.mk_eq_zero G).mpr hy, zero_add]
      exact Submodule.smul_top_le_comap_smul_top _ G.mkQ hz
    rw [hbot] at this
    exact (Submodule.mem_bot _).mp this

  have s3 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (K : Type u) [AddCommGroup K] [Module B K] [Module.Finite B K] (e : ℕ), IsArtinian B (K ⧸ IsLocalRing.maximalIdeal B ^ e • (⊤ : Submodule B K)) := by
    intro B _ _ _ K _ _ _ e
    have hdim : Ring.KrullDimLE 0 (B ⧸ IsLocalRing.maximalIdeal B ^ e) := by
      rw [Ring.krullDimLE_zero_iff]
      intro P hP
      have hQ : (Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ e)) P).IsPrime :=
        Ideal.comap_isPrime _ P
      have hle : IsLocalRing.maximalIdeal B ≤ Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ e)) P := by
        intro a ha
        apply hQ.mem_of_pow_mem e
        rw [Ideal.mem_comap, map_pow, ← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow ha e)]
        exact P.zero_mem
      have heq := (IsLocalRing.maximalIdeal.isMaximal B).eq_of_le hQ.ne_top hle
      have hP' : P = Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ e)) (IsLocalRing.maximalIdeal B) := by
        have h0 := Ideal.map_comap_of_surjective (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ e))
          Ideal.Quotient.mk_surjective P
        rw [← heq] at h0
        exact h0.symm
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ e))
        Ideal.Quotient.mk_surjective (IsLocalRing.maximalIdeal.isMaximal B) with h | h
      · exact absurd (hP'.trans h) hP.ne_top
      · rw [hP']; exact h
    haveI : IsArtinianRing (B ⧸ IsLocalRing.maximalIdeal B ^ e) :=
      isArtinianRing_iff_isNoetherianRing_krullDimLE_zero.mpr ⟨inferInstance, hdim⟩
    haveI : IsArtinian (B ⧸ IsLocalRing.maximalIdeal B ^ e) (K ⧸ IsLocalRing.maximalIdeal B ^ e • (⊤ : Submodule B K)) :=
      isArtinian_of_fg_of_artinian'
    exact isArtinian_of_surjective_algebraMap (R := B ⧸ IsLocalRing.maximalIdeal B ^ e)
      (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective)

  have s4 : ∀ (B : Type u) [CommRing B] (I : Ideal B) (K : Type u) [AddCommGroup K] [Module B K], (∀ e : ℕ, IsArtinian B (K ⧸ I ^ e • (⊤ : Submodule B K))) → (∀ (G : Submodule B K) (x : K), (∀ e : ℕ, x ∈ G ⊔ I ^ e • (⊤ : Submodule B K)) → x ∈ G) → (∀ g : ℕ → K, (∀ e, g e - g (e + 1) ∈ I ^ e • (⊤ : Submodule B K)) → ∃ L : K, ∀ e, g e - L ∈ I ^ e • (⊤ : Submodule B K)) → ∀ F : ℕ → Submodule B K, (∀ n, F (n + 1) ≤ F n) → (∀ x : K, (∀ n, x ∈ F n) → x = 0) → ∀ e : ℕ, ∃ j : ℕ, F j ≤ I ^ e • (⊤ : Submodule B K) := by
    intro B _ I K _ _ hA hC hP F hF hZ e₀
    obtain ⟨N, hN⟩ : ∃ N : ℕ → Submodule B K, ∀ e, N e = I ^ e • (⊤ : Submodule B K) :=
      ⟨fun e => I ^ e • (⊤ : Submodule B K), fun _ => rfl⟩
    have hA' : ∀ e, IsArtinian B (K ⧸ N e) := fun e => by rw [hN]; exact hA e
    have hC' : ∀ (G : Submodule B K) (x : K), (∀ e : ℕ, x ∈ G ⊔ N e) → x ∈ G :=
      fun G x h => hC G x (fun e => by rw [← hN]; exact h e)
    have hP' : ∀ g : ℕ → K, (∀ e, g e - g (e + 1) ∈ N e) → ∃ L : K, ∀ e, g e - L ∈ N e := by
      intro g h
      obtain ⟨L, hL⟩ := hP g (fun e => by rw [← hN]; exact h e)
      exact ⟨L, fun e => by rw [hN]; exact hL e⟩
    suffices hs : ∃ j : ℕ, F j ≤ N e₀ by
      obtain ⟨j, hj⟩ := hs
      exact ⟨j, by rw [← hN]; exact hj⟩
    have hFa : Antitone F := antitone_nat_of_succ_le hF
    have hNa : Antitone N := fun a b hab => by
      rw [hN, hN]; exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hab)
    by_contra H
    push_neg at H
    have hstab : ∀ e, ∃ J, ∀ j, J ≤ j → F j ⊔ N e = F J ⊔ N e := by
      intro e
      haveI := hA' e
      let f : ℕ →o (Submodule B (K ⧸ N e))ᵒᵈ :=
        ⟨fun j => OrderDual.toDual (Submodule.map (N e).mkQ (F j)),
          fun a b hab => Submodule.map_mono (hFa hab)⟩
      obtain ⟨J, hJ⟩ := IsArtinian.monotone_stabilizes f
      refine ⟨J, fun j hj => ?_⟩
      have h1 : N e ⊔ F J = N e ⊔ F j := by
        rw [← Submodule.comap_map_mkQ, ← Submodule.comap_map_mkQ]
        exact congrArg (fun p => Submodule.comap (N e).mkQ (OrderDual.ofDual p)) (hJ j hj)
      rw [sup_comm (F j), sup_comm (F J)]
      exact h1.symm
    choose J hJ using hstab
    have hdown : ∀ e x, x ∈ F (J e) ⊔ N e → ∃ x', x' ∈ F (J (e + 1)) ⊔ N (e + 1) ∧ x - x' ∈ N e := by
      intro e x hx
      have hle : F (J e) ⊔ N e ≤ (F (J (e + 1)) ⊔ N (e + 1)) ⊔ N e := by
        rw [← hJ e (max (J e) (J (e + 1))) (le_max_left _ _),
          ← hJ (e + 1) (max (J e) (J (e + 1))) (le_max_right _ _)]
        exact sup_le (le_sup_left.trans le_sup_left) le_sup_right
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (hle hx)
      exact ⟨y, hy, by rw [add_sub_cancel_left]; exact hz⟩
    obtain ⟨x₀, hx₀F, hx₀N⟩ := SetLike.not_le_iff_exists.mp (H (J e₀))
    choose nxt hnxt using hdown
    obtain ⟨y, hy0, hys⟩ : ∃ y : ∀ k : ℕ, {x : K // x ∈ F (J (e₀ + k)) ⊔ N (e₀ + k)},
        (y 0).1 = x₀ ∧ ∀ k, (y k).1 - (y (k + 1)).1 ∈ N (e₀ + k) :=
      ⟨fun k => Nat.rec (motive := fun k => {x : K // x ∈ F (J (e₀ + k)) ⊔ N (e₀ + k)})
        ⟨x₀, Submodule.mem_sup_left hx₀F⟩
        (fun k p => ⟨nxt (e₀ + k) p.1 p.2, (hnxt _ _ p.2).1⟩) k,
        rfl, fun k => (hnxt _ _ _).2⟩
    obtain ⟨g, hg⟩ : ∃ g : ℕ → K, ∀ e, g e = (y (e - e₀)).1 := ⟨_, fun _ => rfl⟩
    have hgC : ∀ e, g e - g (e + 1) ∈ N e := by
      intro e
      by_cases he : e₀ ≤ e
      · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le he
        have h1 : e₀ + k - e₀ = k := by omega
        have h2 : e₀ + k + 1 - e₀ = k + 1 := by omega
        rw [hg, hg, h1, h2]
        exact hys k
      · have h1 : e - e₀ = 0 := by omega
        have h2 : e + 1 - e₀ = 0 := by omega
        rw [hg, hg, h1, h2, sub_self]
        exact Submodule.zero_mem _
    have hgL : ∀ e, e₀ ≤ e → g e ∈ F (J e) ⊔ N e := by
      intro e he
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le he
      have h1 : e₀ + k - e₀ = k := by omega
      rw [hg, h1]
      exact (y k).2
    obtain ⟨x, hx⟩ := hP' g hgC
    have hxN : x ∉ N e₀ := by
      intro h
      apply hx₀N
      have := Submodule.add_mem _ (hx e₀) h
      rwa [sub_add_cancel, hg, Nat.sub_self, hy0] at this
    have hxF : ∀ j, x ∈ F j := by
      intro j
      apply hC' (F j) x
      intro e
      have he' : e₀ ≤ max e e₀ := le_max_right _ _
      have hxL : x ∈ F (J (max e e₀)) ⊔ N (max e e₀) := by
        have h1 := hgL _ he'
        have h2 : g (max e e₀) - x ∈ F (J (max e e₀)) ⊔ N (max e e₀) :=
          Submodule.mem_sup_right (hx _)
        have := Submodule.sub_mem _ h1 h2
        rwa [sub_sub_cancel] at this
      rw [← hJ (max e e₀) (max j (J (max e e₀))) (le_max_right _ _)] at hxL
      exact sup_le_sup (hFa (le_max_left _ _)) (hNa (le_max_left _ _)) hxL
    exact hxN (by rw [hZ x hxF]; exact Submodule.zero_mem _)

  intro B _ _ _ _ R _ σ K _ _ hfin F hF hZ hm u hu
  classical
  obtain ⟨k, c, hc⟩ := hfin
  letI : Module B K := Module.compHom K σ
  have hsmul : ∀ (b : B) (x : K), b • x = σ b • x := fun _ _ => rfl
  let F' : ℕ → Submodule B K := fun n =>
    { carrier := F n
      add_mem' := (F n).add_mem
      zero_mem' := (F n).zero_mem
      smul_mem' := fun b x hx => (F n).smul_mem (σ b) hx }
  have hF' : ∀ n x, x ∈ F' n ↔ x ∈ F n := fun _ _ => Iff.rfl
  have hspan : Submodule.span B (Set.range c) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨b, rfl⟩ := hc x
    refine Submodule.sum_mem _ fun l _ => ?_
    rw [← hsmul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨l, rfl⟩)
  haveI : Module.Finite B K := Module.finite_def.mpr ⟨Finset.univ.image c, by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]; exact hspan⟩
  have hNF : ∀ n, IsLocalRing.maximalIdeal B ^ (n + 1) • (⊤ : Submodule B K) ≤ F' n := by
    intro n
    refine Submodule.smul_le.mpr fun b hb x _ => ?_
    rw [hF', hsmul]
    exact hm n (Submodule.smul_mem_smul (Ideal.mem_map_of_mem σ hb) Submodule.mem_top)
  have hj : ∀ e, ∃ j, F' j ≤ IsLocalRing.maximalIdeal B ^ e • (⊤ : Submodule B K) :=
    s4 B (IsLocalRing.maximalIdeal B) K (fun e => s3 B K e) (fun G x h => s2 B K G x h)
      (fun g hg => s1 B (IsLocalRing.maximalIdeal B) K k c hspan g hg) F' (fun n => hF n)
      (fun x hx => hZ x hx)
  choose j hj using hj
  have hFa : Antitone F := antitone_nat_of_succ_le hF
  have htel : ∀ a b, a ≤ b → u a - u b ∈ F a := by
    intro a b hab
    induction b, hab using Nat.le_induction with
    | base => rw [sub_self]; exact (F a).zero_mem
    | succ b hab ih =>
      have : u a - u (b + 1) = (u a - u b) + (u b - u (b + 1)) := by abel
      rw [this]; exact (F a).add_mem ih (hFa hab (hu b))
  obtain ⟨Jx, hJx⟩ : ∃ Jx : ℕ → ℕ, ∀ e, Jx e = e + ∑ e' ∈ Finset.range (e + 1), j e' :=
    ⟨_, fun _ => rfl⟩
  have hJx1 : ∀ e, Jx e ≤ Jx (e + 1) := by
    intro e; rw [hJx, hJx, Finset.sum_range_succ _ (e + 1)]; omega
  have hJx2 : ∀ e, e ≤ Jx e := fun e => by rw [hJx]; exact Nat.le_add_right _ _
  have hJx3 : ∀ e, j e ≤ Jx e := fun e => by
    rw [hJx]
    exact (Finset.single_le_sum (fun i _ => Nat.zero_le (j i)) (Finset.self_mem_range_succ e)).trans
      (Nat.le_add_left _ _)
  have hgC : ∀ e, u (Jx e) - u (Jx (e + 1)) ∈ IsLocalRing.maximalIdeal B ^ e • (⊤ : Submodule B K) := by
    intro e
    apply hj e
    rw [hF']
    exact hFa (hJx3 e) (htel _ _ (hJx1 e))
  obtain ⟨L, hL⟩ := s1 B (IsLocalRing.maximalIdeal B) K k c hspan (fun e => u (Jx e)) hgC
  refine ⟨L, fun n => ?_⟩
  have h1 : u (Jx (n + 1)) - L ∈ F n := (hF' n _).mp (hNF n (hL (n + 1)))
  have h2 : u n - u (Jx (n + 1)) ∈ F n := htel _ _ ((Nat.le_succ n).trans (hJx2 _))
  have : L - u n = -((u (Jx (n + 1)) - L) + (u n - u (Jx (n + 1)))) := by abel
  rw [this]
  exact (F n).neg_mem ((F n).add_mem h1 h2)

theorem wc_cn_coherent_formal_functions : wcCnFormalFns.{u} :=
by
  intro B _ _ _ _ Z h _ Ms ψ M φ hsys halg s hs
  classical

  have hσres : ∀ (W W' : Z.Opens) (hle : W' ≤ W) (b : B),
      Z.presheaf.map (homOfLE hle).op (wcCnSigma h W b) = wcCnSigma h W' b := by
    intro W W' hle b
    show (Z.presheaf.map (homOfLE hle).op) ((Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)) =
      (Z.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) b)
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hmapres : ∀ (W W' : Z.Opens) (hle : W' ≤ W) (J : Ideal B) (c : Γ(Z, W)),
      c ∈ Ideal.map (wcCnSigma h W) J →
      Z.presheaf.map (homOfLE hle).op c ∈ Ideal.map (wcCnSigma h W') J := by
    intro W W' hle J c hc
    have e : (Z.presheaf.map (homOfLE hle).op).hom.comp (wcCnSigma h W) = wcCnSigma h W' :=
      RingHom.ext (fun b => hσres W W' hle b)
    have h1 := Ideal.mem_map_of_mem (Z.presheaf.map (homOfLE hle).op).hom hc
    rw [Ideal.map_map, e] at h1
    exact h1

  have hnat : ∀ (N N' : Z.Modules) (f : N ⟶ N') (W W' : Z.Opens) (hle : W' ≤ W) (x : Γ(N, W)),
      Scheme.Modules.Hom.app f W' (N.presheaf.map (homOfLE hle).op x) =
        N'.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app f W x) :=
    fun N N' f W W' hle x => PresheafOfModules.naturality_apply f.val (homOfLE hle).op x

  have hstep : ∀ (n : ℕ) (W : Z.Opens) (x : Γ(M, W)),
      Scheme.Modules.Hom.app (ψ n) W (Scheme.Modules.Hom.app (φ (n + 1)) W x) =
        Scheme.Modules.Hom.app (φ n) W x := by
    intro n W x
    rw [← halg.2.1 n, Scheme.Modules.Hom.comp_app]
    rfl

  obtain ⟨r, U, hUaff, hcov, hint⟩ : ∃ (r : ℕ) (U : Fin r → Z.Opens), (∀ i, IsAffineOpen (U i)) ∧
      (∀ x : Z, ∃ i, x ∈ U i) ∧ ∀ i j, IsAffineOpen (U i ⊓ U j) := by
    haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace h
    have hsep : IsSeparated (Limits.terminal.from Z) := by
      have e : Limits.terminal.from Z = h ≫ Limits.terminal.from (Spec (.of B)) :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    haveI : Z.IsSeparated := Scheme.IsSeparated.mk hsep
    have hW : ∀ x : Z, ∃ W : Z.Opens, IsAffineOpen W ∧ x ∈ W := by
      intro x
      obtain ⟨U', hU', hxU', -⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Z.isBasis_affineOpens))
          (show x ∈ (⊤ : Z.Opens) from trivial)
      exact ⟨U', hU', hxU'⟩
    choose W hWaff hWmem using hW
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (W x : Set Z))
      (fun x => (W x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hWmem y⟩)
    let e := t.equivFin
    refine ⟨t.card, fun i => W (e.symm i).1, fun i => hWaff _, ?_,
      fun i j => (hWaff _).inf (hWaff _)⟩
    intro x
    have hx := ht (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨y, hy, hxy⟩ := hx
    refine ⟨e ⟨y, hy⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxy

  have hcov' : (⊤ : Z.Opens) ≤ iSup U := by
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact hcov x
  have hsep : ∀ (N : Z.Modules) (x y : Γ(N, ⊤)),
      (∀ i, N.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op x =
        N.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op y) → x = y := by
    intro N x y hxy
    exact TopCat.Sheaf.eq_of_locally_eq' (⟨N.presheaf, N.isSheaf⟩ : TopCat.Sheaf Ab Z) U ⊤
      (fun i => homOfLE le_top) hcov' x y hxy

  have hkerres : ∀ (n : ℕ) (k : Γ(M, ⊤)), Scheme.Modules.Hom.app (φ n) ⊤ k = 0 →
      ∀ (W : Z.Opens), IsAffineOpen W →
        M.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op k ∈
          Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
            (⊤ : Submodule Γ(Z, W) Γ(M, W)) := by
    intro n k hk W hW
    refine ((halg.2.2 n W hW).2 _).mp ?_
    rw [hnat, hk, map_zero]

  have hsepK : ∀ k : Γ(M, ⊤), (∀ n, Scheme.Modules.Hom.app (φ n) ⊤ k = 0) → k = 0 :=
    fun k hk => wc_cn_closed_fibre_vanishing B Z h M halg.1 k
      (fun n W hW => hkerres n k (hk n) W hW)

  have hkill : ∀ (n : ℕ) (c : Γ(Z, ⊤)),
      c ∈ Ideal.map (wcCnSigma h ⊤) (IsLocalRing.maximalIdeal B ^ (n + 1)) →
      ∀ v : Γ(Ms n, ⊤), c • v = 0 := by
    intro n c hc v
    apply hsep (Ms n)
    intro i
    rw [Scheme.Modules.map_smul, map_zero]
    have hmem : Z.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op c •
        (Ms n).presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op v ∈
        Ideal.map (wcCnSigma h (U i)) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
          (⊤ : Submodule Γ(Z, U i) Γ(Ms n, U i)) :=
      Submodule.smul_mem_smul (hmapres _ _ _ _ _ hc) Submodule.mem_top
    rw [hsys.2.2 n (U i) (hUaff i)] at hmem
    exact (Submodule.mem_bot _).mp hmem

  let F : ℕ → Submodule Γ(Z, ⊤) Γ(M, ⊤) := fun n =>
    { carrier := {k | Scheme.Modules.Hom.app (φ n) ⊤ k = 0}
      add_mem' := fun {a b} ha hb => by
        have ha' : Scheme.Modules.Hom.app (φ n) ⊤ a = 0 := ha
        have hb' : Scheme.Modules.Hom.app (φ n) ⊤ b = 0 := hb
        show Scheme.Modules.Hom.app (φ n) ⊤ (a + b) = 0
        rw [map_add, ha', hb', add_zero]
      zero_mem' := by
        show Scheme.Modules.Hom.app (φ n) ⊤ 0 = 0
        exact map_zero _
      smul_mem' := fun c k hk => by
        have hk' : Scheme.Modules.Hom.app (φ n) ⊤ k = 0 := hk
        show Scheme.Modules.Hom.app (φ n) ⊤ (c • k) = 0
        rw [Scheme.Modules.Hom.app_smul, hk', smul_zero] }
  have hF : ∀ n k, k ∈ F n ↔ Scheme.Modules.Hom.app (φ n) ⊤ k = 0 := fun _ _ => Iff.rfl

  obtain ⟨Z', pr, ι, π, hpr, h1, h2, h3, h4, h5⟩ := wc_cn_sqzero_relative_spec Z M halg.1
  obtain ⟨q, deg, y, hARM⟩ := wc_cn_cech_artin_rees_module B (IsLocalRing.maximalIdeal B) Z h M
    Z' pr ι π hpr h1 h2 h3 h4 h5 r U hUaff hcov hint
  have hlift : ∀ m, ∃ t : Γ(M, ⊤), Scheme.Modules.Hom.app (φ m) ⊤ t = s m :=
    wc_cn_ml_level_lift B (IsLocalRing.maximalIdeal B) Z h Ms ψ M φ hsys halg r U hUaff hcov hint
      q deg y hARM s hs
  choose t ht using hlift

  obtain ⟨t₀, ht₀⟩ := wc_cn_chevalley_limit B Γ(Z, ⊤) (wcCnSigma h ⊤) Γ(M, ⊤)
    (wc_cn_coherent_global_sections_fg B Z h M halg.1) F
    (fun n k hk => by
      rw [hF] at hk ⊢
      rw [← hstep n ⊤ k, hk, map_zero])
    (fun k hk => hsepK k (fun n => (hF n k).mp (hk n)))
    (fun n => Submodule.smul_le.mpr (fun c hc k _ => by
      rw [hF, Scheme.Modules.Hom.app_smul]
      exact hkill n c hc _))
    t
    (fun n => by
      rw [hF, map_sub, ← hstep n ⊤ (t (n + 1)), ht, ht, hs, sub_self])
  have hex : ∀ n, Scheme.Modules.Hom.app (φ n) ⊤ t₀ = s n := by
    intro n
    have e := (hF n _).mp (ht₀ n)
    rw [map_sub, sub_eq_zero] at e
    rw [e, ht]
  refine ⟨t₀, hex, fun s' hs' => ?_⟩
  refine sub_eq_zero.mp (hsepK _ (fun n => ?_))
  rw [map_sub, hs' n, hex n, sub_self]

theorem wc_cn_utl_lift_of_h1 : ∀ {Z : Scheme.{u}} {m : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)),
    (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k j) =
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k l) *
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m l)).op (e l j)) →
    ∀ {G' G : Z.Modules} (ψ : G' ⟶ G) (w : ℕ),
    (∀ k, Function.Surjective (Scheme.Modules.Hom.app ψ (g ⁻¹ᵁ wcPmChart m k))) →
    wcCnUtlH1Van g e ψ w →
    ∀ s : ∀ k, Γ(G, g ⁻¹ᵁ wcPmChart m k), wcCnTwisted g e G w s →
      ∃ s' : ∀ k, Γ(G', g ⁻¹ᵁ wcPmChart m k), wcCnTwisted g e G' w s' ∧
        ∀ k, Scheme.Modules.Hom.app ψ (g ⁻¹ᵁ wcPmChart m k) (s' k) = s k :=
by
  intro Z m g e hE3 G' G ψ w hsurj hH s hs
  have resM : ∀ (M : Z.Modules) {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro M U V W h1 h2 x
    change (M.presheaf.map (homOfLE h1).op ≫ M.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resZ : ∀ {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Z, U)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have smulM : ∀ (M : Z.Modules) {U V : Z.Opens} (h : V ≤ U) (r : Γ(Z, U)) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h).op).hom (r • x) =
      (Z.presheaf.map (homOfLE h).op).hom r • (M.presheaf.map (homOfLE h).op).hom x :=
    fun M U V h r x => Scheme.Modules.map_smul M (homOfLE h) r x
  have natψ : ∀ {U V : Z.Opens} (h : V ≤ U) (x : Γ(G', U)),
      Scheme.Modules.Hom.app ψ V ((G'.presheaf.map (homOfLE h).op).hom x) =
      (G.presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app ψ U x) :=
    fun h x => NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf ψ) (homOfLE h).op x
  have natg : ∀ {A B : (wcPm.{u} m).Opens} (h : B ≤ A) (x : Γ(wcPm.{u} m, A)),
      g.app B ((wcPm.{u} m).presheaf.map (homOfLE h).op x) =
      (Z.presheaf.map (homOfLE (g.preimage_mono h)).op).hom (g.app A x) := by
    intro A B h x
    exact congrArg (fun f => f.hom x) (g.naturality (homOfLE h).op)
  have hT : ∀ k l j : Fin (m + 1),
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k j)) =
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l)) *
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom
          (g.app (wcPmChart m l) (e l j)) := by
    intro k l j
    have hW : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ (wcPmChart m k ⊓ wcPmChart m l) := inf_le_left
    have key := congrArg (fun x => (Z.presheaf.map (homOfLE hW).op).hom
      (g.app (wcPmChart m k ⊓ wcPmChart m l) x)) (hE3 k l j)
    simp only [map_mul] at key
    rw [natg, natg, natg, resZ, resZ, resZ] at key
    exact key
  choose st hst using fun k => hsurj k (s k)
  obtain ⟨c, hc⟩ : ∃ c : ∀ k l : Fin (m + 1), Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l),
      ∀ k l, c k l =
        (G'.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m k)).op).hom (st k) -
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ w •
        (G'.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m l)).op).hom (st l) := ⟨_, fun _ _ => rfl⟩
  have hc0 : ∀ k l, Scheme.Modules.Hom.app ψ (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)
      (c k l) = 0 := by
    intro k l
    rw [hc, map_sub, Scheme.Modules.Hom.app_smul, natψ, natψ, hst, hst, hs k l, sub_self]
  have hcoc : ∀ k l j : Fin (m + 1),
      (G'.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓
          g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)).op).hom (c k l) +
        ((Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l))) ^ w •
        (G'.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom (c l j) =
      (G'.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom (c k j) := by
    intro k l j
    rw [hc, hc, hc]
    simp only [map_sub, smulM, map_pow, resM, resZ]
    rw [hT k l j, mul_pow, mul_smul, smul_sub]
    abel
  obtain ⟨b, hb0, hbc⟩ := hH c hc0 hcoc
  refine ⟨fun k => st k - b k, ?_, ?_⟩
  · intro k l
    dsimp only
    have h1 := hbc k l
    rw [hc] at h1
    simp only [map_sub, smul_sub]
    rw [← sub_eq_zero] at h1 ⊢
    rw [← h1]
    abel
  · intro k
    dsimp only
    rw [map_sub, hst, hb0, sub_zero]

theorem wc_cn_utl_h1_of_laurent : ∀ {Z : Scheme.{u}} {m : ℕ} (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), (∀ k, e k k = 1) →
    (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k j) =
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k l) *
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m l)).op (e l j)) →
    ∀ {G' G : Z.Modules} (ψ : G' ⟶ G) (w : ℕ) (A : Type u) [CommRing A] (R : ℕ) (d : Fin R → ℕ)
      (K : Submodule (MvPolynomial (Fin (m + 1)) A) (Fin R → MvPolynomial (Fin (m + 1)) A))
      (H : AddSubgroup (Fin R → (Fin (m + 1) → ℤ) →₀ A))
      (Θ1 : ∀ k : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) → Γ(G', g ⁻¹ᵁ wcPmChart m k))
      (Θ2 : ∀ k l : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) →
        Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
      (Θ3 : ∀ k l j : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) →
        Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)),
    wcCnUtlModel g e ψ A R d K H Θ1 Θ2 Θ3 w →
    wcCnUtlVan A (m + 1) R d K 1 (w : ℤ) →
    wcCnUtlH1Van g e ψ w :=
by
  intro Z m g e hE1 hE3 G' G ψ w A _ R d K H Θ1 Θ2 Θ3 hM hVan
  obtain ⟨M1, M2, M3, M4, M5, M6, M7, M8, M9, M10, M11, M12⟩ := hM
  intro c hc0 hcoc

  have resM : ∀ (M : Z.Modules) {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro M U V W h1 h2 x
    change (M.presheaf.map (homOfLE h1).op ≫ M.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resZ : ∀ {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Z, U)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have smulM : ∀ (M : Z.Modules) {U V : Z.Opens} (h : V ≤ U) (r : Γ(Z, U)) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h).op).hom (r • x) =
      (Z.presheaf.map (homOfLE h).op).hom r • (M.presheaf.map (homOfLE h).op).hom x :=
    fun M U V h r x => Scheme.Modules.map_smul M (homOfLE h) r x
  have natg : ∀ {A B : (wcPm.{u} m).Opens} (h : B ≤ A) (x : Γ(wcPm.{u} m, A)),
      g.app B ((wcPm.{u} m).presheaf.map (homOfLE h).op x) =
      (Z.presheaf.map (homOfLE (g.preimage_mono h)).op).hom (g.app A x) := by
    intro A B h x
    exact congrArg (fun f => f.hom x) (g.naturality (homOfLE h).op)
  have hT : ∀ k l j : Fin (m + 1),
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k j)) =
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l)) *
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom
          (g.app (wcPmChart m l) (e l j)) := by
    intro k l j
    have hW : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ (wcPmChart m k ⊓ wcPmChart m l) := inf_le_left
    have key := congrArg (fun x => (Z.presheaf.map (homOfLE hW).op).hom
      (g.app (wcPmChart m k ⊓ wcPmChart m l) x)) (hE3 k l j)
    simp only [map_mul] at key
    rw [natg, natg, natg, resZ, resZ, resZ] at key
    exact key
  have hinj : ∀ {U V : Z.Opens} (h1 : V ≤ U) (h2 : U ≤ V) (x : Γ(G', U)),
      (G'.presheaf.map (homOfLE h1).op).hom x = 0 → x = 0 := by
    intro U V h1 h2 x hx
    have e0 : (G'.presheaf.map (homOfLE h2).op).hom
        ((G'.presheaf.map (homOfLE h1).op).hom x) = x := by
      rw [resM]
      change (G'.presheaf.map (𝟙 _)).hom x = x
      rw [CategoryTheory.Functor.map_id]
      rfl
    rw [← e0, hx, map_zero]

  have hΘ2sub : ∀ k l a b, Θ2 k l (a - b) = Θ2 k l a - Θ2 k l b :=
    fun k l a b => map_sub (AddMonoidHom.mk' (Θ2 k l) (M2 k l)) a b
  have hΘ2neg : ∀ k l a, Θ2 k l (-a) = -Θ2 k l a :=
    fun k l a => map_neg (AddMonoidHom.mk' (Θ2 k l) (M2 k l)) a
  have hΘ3sub : ∀ k l j a b, Θ3 k l j (a - b) = Θ3 k l j a - Θ3 k l j b :=
    fun k l j a b => map_sub (AddMonoidHom.mk' (Θ3 k l j) (M3 k l j)) a b
  have hΘ3neg : ∀ k l j a, Θ3 k l j (-a) = -Θ3 k l j a :=
    fun k l j a => map_neg (AddMonoidHom.mk' (Θ3 k l j) (M3 k l j)) a

  have hC0 : ∀ σ, (0 : Fin R → (Fin (m + 1) → ℤ) →₀ A) ∈ wcLaurC A (m + 1) R d (w : ℤ) σ := by
    intro σ
    simp only [wcLaurC, Set.mem_setOf_eq]
    intro r
    exact Submodule.zero_mem _
  have hCadd : ∀ σ (v v' : Fin R → (Fin (m + 1) → ℤ) →₀ A), v ∈ wcLaurC A (m + 1) R d (w : ℤ) σ →
      v' ∈ wcLaurC A (m + 1) R d (w : ℤ) σ → v + v' ∈ wcLaurC A (m + 1) R d (w : ℤ) σ := by
    intro σ v v' hv hv'
    simp only [wcLaurC, Set.mem_setOf_eq] at hv hv' ⊢
    intro r
    exact Submodule.add_mem _ (hv r) (hv' r)
  have hCneg : ∀ σ (v : Fin R → (Fin (m + 1) → ℤ) →₀ A), v ∈ wcLaurC A (m + 1) R d (w : ℤ) σ →
      -v ∈ wcLaurC A (m + 1) R d (w : ℤ) σ := by
    intro σ v hv
    simp only [wcLaurC, Set.mem_setOf_eq] at hv ⊢
    intro r
    exact Submodule.neg_mem _ (hv r)
  have hCsub : ∀ σ (v v' : Fin R → (Fin (m + 1) → ℤ) →₀ A), v ∈ wcLaurC A (m + 1) R d (w : ℤ) σ →
      v' ∈ wcLaurC A (m + 1) R d (w : ℤ) σ → v - v' ∈ wcLaurC A (m + 1) R d (w : ℤ) σ := by
    intro σ v v' hv hv'
    simp only [wcLaurC, Set.mem_setOf_eq] at hv hv' ⊢
    intro r
    exact Submodule.sub_mem _ (hv r) (hv' r)
  have hCmono : ∀ σ τ : Finset (Fin (m + 1)), σ ⊆ τ → ∀ v : Fin R → (Fin (m + 1) → ℤ) →₀ A,
      v ∈ wcLaurC A (m + 1) R d (w : ℤ) σ → v ∈ wcLaurC A (m + 1) R d (w : ℤ) τ := by
    intro σ τ hst v hv
    simp only [wcLaurC, Set.mem_setOf_eq] at hv ⊢
    intro r
    refine Finsupp.supported_mono ?_ (hv r)
    intro β hβ
    simp only [Set.mem_setOf_eq] at hβ ⊢
    exact ⟨hβ.1, fun i hi => hβ.2 i (fun h => hi (hst h))⟩

  have hD2 : ∀ (f : Finset (Fin (m + 1)) → Fin R → (Fin (m + 1) → ℤ) →₀ A) (k l : Fin (m + 1)),
      k < l → wcAltD (A := A) (m + 1) f {k, l} = f {l} - f {k} := by
    intro f k l hkl
    have h1 : k.val < l.val := hkl
    have n1 : k ∉ ({l} : Finset (Fin (m + 1))) := by
      simp only [Finset.mem_singleton, Fin.ext_iff]; omega
    have e1 : ({k, l} : Finset (Fin (m + 1))).filter (· < k) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl <;> intro h <;> simp only [Fin.lt_def] at h <;> omega
    have e2 : ({k, l} : Finset (Fin (m + 1))).filter (· < l) = {k} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Fin.ext_iff, Fin.lt_def]
      constructor <;> intro h <;> omega
    have e3 : ({k, l} : Finset (Fin (m + 1))).erase k = {l} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    have e4 : ({k, l} : Finset (Fin (m + 1))).erase l = {k} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    show ∑ i ∈ ({k, l} : Finset (Fin (m + 1))),
      ((-1 : A) ^ (({k, l} : Finset (Fin (m + 1))).filter (· < i)).card) •
        f (({k, l} : Finset (Fin (m + 1))).erase i) = _
    rw [Finset.sum_insert n1, Finset.sum_singleton, e1, e2, e3, e4, Finset.card_empty,
      Finset.card_singleton, pow_zero, pow_one]
    ext r β
    simp <;> ring
  have hD3 : ∀ (f : Finset (Fin (m + 1)) → Fin R → (Fin (m + 1) → ℤ) →₀ A) (k l j : Fin (m + 1)),
      k < l → l < j → wcAltD (A := A) (m + 1) f {k, l, j} = f {l, j} - f {k, j} + f {k, l} := by
    intro f k l j hkl hlj
    have h1 : k.val < l.val := hkl
    have h2 : l.val < j.val := hlj
    have n1 : k ∉ ({l, j} : Finset (Fin (m + 1))) := by
      simp only [Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]; omega
    have n2 : l ∉ ({j} : Finset (Fin (m + 1))) := by
      simp only [Finset.mem_singleton, Fin.ext_iff]; omega
    have e1 : ({k, l, j} : Finset (Fin (m + 1))).filter (· < k) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton] at hx
      rcases hx with rfl | rfl | rfl <;> intro h <;> simp only [Fin.lt_def] at h <;> omega
    have e2 : ({k, l, j} : Finset (Fin (m + 1))).filter (· < l) = {k} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Fin.ext_iff, Fin.lt_def]
      constructor <;> intro h <;> omega
    have e3 : ({k, l, j} : Finset (Fin (m + 1))).filter (· < j) = {k, l} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Fin.ext_iff, Fin.lt_def]
      constructor <;> intro h <;> omega
    have e4 : ({k, l, j} : Finset (Fin (m + 1))).erase k = {l, j} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    have e5 : ({k, l, j} : Finset (Fin (m + 1))).erase l = {k, j} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    have e6 : ({k, l, j} : Finset (Fin (m + 1))).erase j = {k, l} := by
      ext x
      simp only [Finset.mem_erase, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff]
      constructor <;> intro h <;> omega
    show ∑ i ∈ ({k, l, j} : Finset (Fin (m + 1))),
      ((-1 : A) ^ (({k, l, j} : Finset (Fin (m + 1))).filter (· < i)).card) •
        f (({k, l, j} : Finset (Fin (m + 1))).erase i) = _
    rw [Finset.sum_insert n1, Finset.sum_insert n2, Finset.sum_singleton, e1, e2, e3, e4, e5, e6,
      Finset.card_empty, Finset.card_singleton, Finset.card_pair (ne_of_lt hkl), pow_zero, pow_one,
      neg_one_sq]
    ext r β
    simp <;> ring

  have hsort : ∀ τ : Finset (Fin (m + 1)), τ.card = 3 →
      ∃ k l j : Fin (m + 1), k < l ∧ l < j ∧ τ = {k, l, j} := by
    intro τ hτ
    obtain ⟨x, y, x', hxy, hxx', hyx', rfl⟩ := Finset.card_eq_three.mp hτ
    rcases lt_or_gt_of_ne hxy with h1 | h1 <;> rcases lt_or_gt_of_ne hxx' with h2 | h2 <;>
      rcases lt_or_gt_of_ne hyx' with h3 | h3
    all_goals first
      | exact ⟨x, y, x', by assumption, by assumption, rfl⟩
      | (refine ⟨x, x', y, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨x', x, y, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨y, x, x', by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨y, x', x, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (refine ⟨x', y, x, by assumption, by assumption, ?_⟩
         ext a; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
      | (exfalso; simp only [Fin.lt_def] at *; omega)

  have hlift : ∀ k l : Fin (m + 1), ∃ v, v ∈ H ∧ v ∈ wcLaurC A (m + 1) R d (w : ℤ) {k, l} ∧
      (k < l → Θ2 k l v = c k l) ∧ (¬ k < l → v = 0) := by
    intro k l
    by_cases hkl : k < l
    · obtain ⟨v, hvH, hvC, hv⟩ := M5 k l hkl (c k l) (hc0 k l)
      exact ⟨v, hvH, hvC, fun _ => hv, fun h => absurd hkl h⟩
    · exact ⟨0, H.zero_mem, hC0 _, fun h => absurd h hkl, fun _ => rfl⟩
  choose V hVH hVC hVc hV0 using hlift

  obtain ⟨z, hzdef⟩ : ∃ z : Finset (Fin (m + 1)) → Fin R → (Fin (m + 1) → ℤ) →₀ A,
      z = fun σ => if σ.card = 2 then -(∑ a ∈ σ, ∑ b ∈ σ, V a b) else 0 := ⟨_, rfl⟩
  have hz2 : ∀ k l : Fin (m + 1), k < l → z {k, l} = -V k l := by
    intro k l hkl
    have hne : k ≠ l := ne_of_lt hkl
    have h1 : z {k, l} = -(∑ a ∈ ({k, l} : Finset (Fin (m + 1))),
        ∑ b ∈ ({k, l} : Finset (Fin (m + 1))), V a b) := by
      rw [hzdef]
      exact if_pos (Finset.card_pair hne)
    rw [h1, Finset.sum_pair hne, Finset.sum_pair hne, Finset.sum_pair hne,
      hV0 k k (lt_irrefl k), hV0 l l (lt_irrefl l), hV0 l k (not_lt.mpr hkl.le)]
    simp

  have hz1 : ∀ σ : Finset (Fin (m + 1)),
      (σ.card = 1 + 1 → z σ ∈ wcLaurC A (m + 1) R d (w : ℤ) σ) ∧ (σ.card ≠ 1 + 1 → z σ = 0) := by
    intro σ
    refine ⟨fun hσ => ?_, fun hσ => ?_⟩
    · have h1 : z σ = -(∑ a ∈ σ, ∑ b ∈ σ, V a b) := by
        rw [hzdef]
        exact if_pos hσ
      rw [h1]
      apply hCneg
      simp only [wcLaurC, Set.mem_setOf_eq]
      intro r
      rw [Finset.sum_apply]
      refine Submodule.sum_mem _ (fun a ha => ?_)
      rw [Finset.sum_apply]
      refine Submodule.sum_mem _ (fun b hb => ?_)
      have hsub : ({a, b} : Finset (Fin (m + 1))) ⊆ σ :=
        Finset.insert_subset_iff.mpr ⟨ha, Finset.singleton_subset_iff.mpr hb⟩
      have h2 := hCmono _ _ hsub _ (hVC a b)
      simp only [wcLaurC, Set.mem_setOf_eq] at h2
      exact h2 r
    · rw [hzdef]
      exact if_neg hσ

  have hz3 : ∀ τ : Finset (Fin (m + 1)), τ.card = 1 + 2 →
      wcAltD (A := A) (m + 1) z τ ∈ wcLaurK A (m + 1) R d K (w : ℤ) τ := by
    intro τ hτ
    obtain ⟨k, l, j, hkl, hlj, rfl⟩ := hsort τ hτ
    have hkj : k < j := lt_trans hkl hlj
    rw [hD3 z k l j hkl hlj, hz2 l j hlj, hz2 k j hkj, hz2 k l hkl]
    have s1 : ({l, j} : Finset (Fin (m + 1))) ⊆ {k, l, j} := by
      intro x; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
    have s2 : ({k, j} : Finset (Fin (m + 1))) ⊆ {k, l, j} := by
      intro x; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
    have s3 : ({k, l} : Finset (Fin (m + 1))) ⊆ {k, l, j} := by
      intro x; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
    refine M7 k l j hkl hlj _ ?_ ?_ ?_
    · exact H.add_mem (H.sub_mem (H.neg_mem (hVH l j)) (H.neg_mem (hVH k j)))
        (H.neg_mem (hVH k l))
    · exact hCadd _ _ _ (hCsub _ _ _ (hCneg _ _ (hCmono _ _ s1 _ (hVC l j)))
        (hCneg _ _ (hCmono _ _ s2 _ (hVC k j)))) (hCneg _ _ (hCmono _ _ s3 _ (hVC k l)))
    · rw [M3, hΘ3sub, hΘ3neg, hΘ3neg, hΘ3neg, M12 k l j hkl hlj _ (hVC l j),
        M11 k l j hkl hlj _ (hVC k j), M10 k l j hkl hlj _ (hVC k l), hVc l j hlj, hVc k j hkj,
        hVc k l hkl, ← hcoc k l j]
      abel

  obtain ⟨y, hy1, hy2⟩ := hVan z hz1 hz3

  have hlt : ∀ k l : Fin (m + 1), k < l → c k l =
      (G'.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ wcPmChart m k)).op).hom (Θ1 k (y {k})) -
      ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ w •
      (G'.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ wcPmChart m l)).op).hom (Θ1 l (y {l})) := by
    intro k l hkl
    have hX := hy2 {k, l} (Finset.card_pair (ne_of_lt hkl))
    rw [hz2 k l hkl, hD2 y k l hkl] at hX
    have h0 := M6 k l hkl _ hX
    rw [hΘ2sub, hΘ2neg, hΘ2sub, M8 k l hkl _ ((hy1 {k}).1 (Finset.card_singleton k)),
      M9 k l hkl _ ((hy1 {l}).1 (Finset.card_singleton l)), hVc k l hkl] at h0
    apply eq_of_sub_eq_zero
    rw [← neg_eq_zero, ← h0]
    abel

  have hckk : ∀ k, c k k = 0 := by
    intro k
    have h := hcoc k k k
    simp only [hE1, map_one, one_pow, one_smul] at h
    apply hinj (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m k ≤
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m k) (le_inf le_rfl inf_le_left)
    have h2 : ∀ x : Γ(G', g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m k),
        x + x = x → x = 0 := by
      intro x hx
      have h3 := congrArg (fun t => t - x) hx
      simpa using h3
    exact h2 _ h

  refine ⟨fun k => Θ1 k (y {k}), fun k => M4 k _ ((hy1 {k}).1 (Finset.card_singleton k)), ?_⟩
  intro k l
  beta_reduce
  rcases lt_trichotomy k l with hkl | rfl | hlk
  · exact hlt k l hkl
  · rw [hckk k, hE1 k, map_one, map_one, one_pow, one_smul]
    exact (sub_self _).symm
  · have hcoc' := hcoc k l k
    rw [hckk k, map_zero, hlt l k hlk] at hcoc'
    simp only [map_sub, smulM, map_pow, resM, resZ] at hcoc'
    have hu := hT k l k
    simp only [hE1, map_one] at hu
    rw [smul_sub, ← mul_smul, ← mul_pow, ← hu, one_pow, one_smul] at hcoc'
    have hc' := eq_neg_of_add_eq_zero_left hcoc'
    rw [← sub_eq_zero]
    apply hinj (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
      g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) (le_inf le_rfl inf_le_left)
    simp only [map_sub, smulM, map_pow, resM, resZ]
    rw [hc']
    abel

theorem wc_cn_twisted_generation : ∀ (B : Type u) [CommRing B] (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) (m : ℕ) (g : Z ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift h g) →
    ∀ e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k), (∀ k, e k k = 1) →
    (∀ k l, wcPmChart m k ⊓ wcPmChart m l = (wcPm.{u} m).basicOpen (e k l)) →
    (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k j) =
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k l) *
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m l)).op (e l j)) →
    ∀ F : Z.Modules, wcQcoh F →
    (∀ k, Module.Finite Γ(Z, g ⁻¹ᵁ wcPmChart m k) Γ(F, g ⁻¹ᵁ wcPmChart m k)) →
    ∃ (D q : ℕ) (s : Fin q → ∀ k, Γ(F, g ⁻¹ᵁ wcPmChart m k)),
      (∀ ρ, wcCnTwisted g e F D (s ρ)) ∧
      ∀ k, Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k) (Set.range fun ρ => s ρ k) = ⊤ :=
by
  intro B _ Z h m g hg e he1 he2 he3 F hF hfin
  classical
  have hUaff : ∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : ∀ k : Fin (m + 1), IsAffineOpen (wcPmChart.{u} m k) := fun k =>
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k))
        Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
    haveI hcomp : IsAffineHom (Limits.prod.lift h g ≫ Limits.prod.snd) := inferInstance
    have hga : IsAffineHom g := by
      rw [Limits.prod.lift_snd] at hcomp
      exact hcomp
    exact fun k => (hD k).preimage g

  have rF : ∀ {V₁ V₂ V₃ : Z.Opens} (h₁ : V₂ ≤ V₁) (h₂ : V₃ ≤ V₂) (x : Γ(F, V₁)),
      (F.presheaf.map (homOfLE h₂).op).hom ((F.presheaf.map (homOfLE h₁).op).hom x) =
      (F.presheaf.map (homOfLE (h₂.trans h₁)).op).hom x := by
    intro V₁ V₂ V₃ h₁ h₂ x
    show _ = (F.presheaf.map ((homOfLE h₁).op ≫ (homOfLE h₂).op)).hom x
    rw [Functor.map_comp]; rfl
  have rZ : ∀ {V₁ V₂ V₃ : Z.Opens} (h₁ : V₂ ≤ V₁) (h₂ : V₃ ≤ V₂) (x : Γ(Z, V₁)),
      (Z.presheaf.map (homOfLE h₂).op).hom ((Z.presheaf.map (homOfLE h₁).op).hom x) =
      (Z.presheaf.map (homOfLE (h₂.trans h₁)).op).hom x := by
    intro V₁ V₂ V₃ h₁ h₂ x
    show _ = (Z.presheaf.map ((homOfLE h₁).op ≫ (homOfLE h₂).op)).hom x
    rw [Functor.map_comp]; rfl
  have smF : ∀ {V₁ V₂ : Z.Opens} (h₁ : V₂ ≤ V₁) (r : Γ(Z, V₁)) (x : Γ(F, V₁)),
      (F.presheaf.map (homOfLE h₁).op).hom (r • x) =
        (Z.presheaf.map (homOfLE h₁).op).hom r • (F.presheaf.map (homOfLE h₁).op).hom x :=
    fun h₁ r x => Scheme.Modules.map_smul F (homOfLE h₁) r x
  have nat : ∀ {V W : (wcPm.{u} m).Opens} (hWV : W ≤ V) (r : Γ(wcPm.{u} m, V)),
      g.app W ((wcPm.{u} m).presheaf.map (homOfLE hWV).op r) =
        (Z.presheaf.map (homOfLE (g.preimage_mono hWV)).op).hom (g.app V r) := by
    intro V W hWV r
    exact congrArg (fun φ => φ.hom r) (g.naturality (homOfLE hWV).op)

  have P1 : ∀ k, g.app (wcPmChart m k) (e k k) = 1 := by
    intro k; rw [he1 k, map_one]
  have P2 : ∀ k l, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l =
      Z.basicOpen (g.app (wcPmChart m k) (e k l)) := by
    intro k l
    rw [← Scheme.preimage_basicOpen, ← he2 k l] <;> rfl
  have P3V : ∀ (a b c : Fin (m + 1)) (V : Z.Opens) (h1 : V ≤ g ⁻¹ᵁ wcPmChart m a)
      (h2 : V ≤ g ⁻¹ᵁ wcPmChart m b),
      (Z.presheaf.map (homOfLE h1).op).hom (g.app (wcPmChart m a) (e a c)) =
        (Z.presheaf.map (homOfLE h1).op).hom (g.app (wcPmChart m a) (e a b)) *
        (Z.presheaf.map (homOfLE h2).op).hom (g.app (wcPmChart m b) (e b c)) := by
    intro a b c V h1 h2
    have h3 := congrArg (ConcreteCategory.hom (g.app (wcPmChart m a ⊓ wcPmChart m b))) (he3 a b c)
    rw [map_mul, nat, nat, nat] at h3
    have h3' : (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
          g ⁻¹ᵁ wcPmChart m b ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a c)) =
        (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
          g ⁻¹ᵁ wcPmChart m b ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a b)) *
        (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓
          g ⁻¹ᵁ wcPmChart m b ≤ g ⁻¹ᵁ wcPmChart m b)).op).hom (g.app (wcPmChart m b) (e b c)) :=
      h3
    have h4 := congrArg (Z.presheaf.map (homOfLE (le_inf h1 h2 :
      V ≤ g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b)).op).hom h3'
    rw [map_mul, rZ, rZ, rZ] at h4
    exact h4

  have qc1 : ∀ (U : Z.Opens), IsAffineOpen U → ∀ (f : Γ(Z, U)) (V : Z.Opens) (hVU : V ≤ U),
      V = Z.basicOpen f → ∀ s : Γ(F, V), ∃ (n : ℕ) (t : Γ(F, U)),
        ((Z.presheaf.map (homOfLE hVU).op).hom f) ^ n • s =
          (F.presheaf.map (homOfLE hVU).op).hom t := by
    intro U hU f V hVU hV
    subst hV
    exact (hF U hU f).1
  have qc2 : ∀ (U : Z.Opens), IsAffineOpen U → ∀ (f : Γ(Z, U)) (V : Z.Opens) (hVU : V ≤ U),
      V = Z.basicOpen f → ∀ t : Γ(F, U), (F.presheaf.map (homOfLE hVU).op).hom t = 0 →
        ∃ n : ℕ, f ^ n • t = 0 := by
    intro U hU f V hVU hV
    subst hV
    exact (hF U hU f).2

  have key : ∀ (k : Fin (m + 1)) (x : Γ(F, g ⁻¹ᵁ wcPmChart m k)), ∃ N₀ : ℕ, ∀ N, N₀ ≤ N →
      ∃ s : ∀ l, Γ(F, g ⁻¹ᵁ wcPmChart m l), wcCnTwisted g e F N s ∧ s k = x := by
    intro k x

    have ha : ∀ l, ∃ (n : ℕ) (z : Γ(F, g ⁻¹ᵁ wcPmChart m l)),
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
          g ⁻¹ᵁ wcPmChart m l)).op).hom (g.app (wcPmChart m l) (e l k))) ^ n •
          (F.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
            g ⁻¹ᵁ wcPmChart m k)).op).hom x =
        (F.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
          g ⁻¹ᵁ wcPmChart m l)).op).hom z :=
      fun l => qc1 _ (hUaff l) _ _ inf_le_left (P2 l k) _
    choose n z hz using ha

    have hy' : ∀ l, (F.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓
          g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom
          ((g.app (wcPmChart m l) (e l k)) ^ (Finset.univ.sup n - n l) • z l) =
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
          g ⁻¹ᵁ wcPmChart m l)).op).hom (g.app (wcPmChart m l) (e l k))) ^ (Finset.univ.sup n) •
          (F.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
            g ⁻¹ᵁ wcPmChart m k)).op).hom x := by
      intro l
      rw [smF, map_pow, ← hz l, smul_smul, ← pow_add,
        Nat.sub_add_cancel (Finset.le_sup (f := n) (Finset.mem_univ l))]

    obtain ⟨y, hyk, hy⟩ : ∃ y : ∀ l, Γ(F, g ⁻¹ᵁ wcPmChart m l), y k = x ∧ ∀ l,
        (F.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓
          g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (y l) =
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
          g ⁻¹ᵁ wcPmChart m l)).op).hom (g.app (wcPmChart m l) (e l k))) ^ (Finset.univ.sup n) •
          (F.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k ≤
            g ⁻¹ᵁ wcPmChart m k)).op).hom x := by
      refine ⟨Function.update (fun l => (g.app (wcPmChart m l) (e l k)) ^
        (Finset.univ.sup n - n l) • z l) k x, Function.update_self _ _ _, fun l => ?_⟩
      by_cases hl : l = k
      · subst hl
        rw [Function.update_self, P1, map_one, one_pow, one_smul]
      · rw [Function.update_of_ne hl]
        exact hy' l

    have hyV : ∀ l (V : Z.Opens) (h1 : V ≤ g ⁻¹ᵁ wcPmChart m l) (h2 : V ≤ g ⁻¹ᵁ wcPmChart m k),
        (F.presheaf.map (homOfLE h1).op).hom (y l) =
          ((Z.presheaf.map (homOfLE h1).op).hom (g.app (wcPmChart m l) (e l k))) ^
            (Finset.univ.sup n) • (F.presheaf.map (homOfLE h2).op).hom x := by
      intro l V h1 h2
      have h3 := congrArg (F.presheaf.map (homOfLE (le_inf h1 h2 :
        V ≤ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m k)).op).hom (hy l)
      rw [smF, map_pow, rF, rZ, rF] at h3
      exact h3

    have hD : ∀ j l, ∃ c : ℕ,
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j k))) ^ c •
        ((F.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤
          g ⁻¹ᵁ wcPmChart m j)).op).hom (y j) -
          ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤
            g ⁻¹ᵁ wcPmChart m j)).op).hom (g.app (wcPmChart m j) (e j l))) ^ (Finset.univ.sup n) •
          (F.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤
            g ⁻¹ᵁ wcPmChart m l)).op).hom (y l)) = 0 := by
      intro j l
      have hW : IsAffineOpen (g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l) := by
        rw [P2 j l]; exact (hUaff j).basicOpen _
      have hk' : (g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l) ⊓
          (g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m k) ≤ g ⁻¹ᵁ wcPmChart m k :=
        le_trans inf_le_right inf_le_right
      have hl' : (g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l) ⊓
          (g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m k) ≤ g ⁻¹ᵁ wcPmChart m l :=
        le_trans inf_le_left inf_le_right
      refine qc2 _ hW _ ((g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l) ⊓
          (g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m k)) inf_le_left ?_ _ ?_
      · have e1 := Scheme.basicOpen_res Z (g.app (wcPmChart m j) (e j k))
          (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤
            g ⁻¹ᵁ wcPmChart m j)).op
        rw [← P2 j k] at e1
        exact e1.symm
      · rw [map_sub, smF, map_pow, rF, rF, rZ, hyV j _ _ hk', hyV l _ _ hk',
          P3V j l k _ _ hl', mul_pow, smul_smul]
        exact sub_self _
    choose c hc using hD

    refine ⟨Finset.univ.sup n + Finset.univ.sup (fun p : Fin (m + 1) × Fin (m + 1) => c p.1 p.2),
      fun N hN => ?_⟩
    obtain ⟨r, rfl⟩ : ∃ r, N = Finset.univ.sup n + r := ⟨N - Finset.univ.sup n, by omega⟩
    refine ⟨fun l => (g.app (wcPmChart m l) (e l k)) ^ r • y l, ?_, ?_⟩
    · unfold wcCnTwisted
      intro a b
      dsimp only
      have hcle := Finset.le_sup (f := fun p : Fin (m + 1) × Fin (m + 1) => c p.1 p.2)
        (Finset.mem_univ (a, b))
      have hcr : c a b ≤ r := by
        simp only at hcle
        omega
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hcr
      have h1 := hc a b
      have h2 : ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
          g ⁻¹ᵁ wcPmChart m b ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom
          (g.app (wcPmChart m a) (e a k))) ^ (c a b + d) •
        ((F.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
          g ⁻¹ᵁ wcPmChart m a)).op).hom (y a) -
          ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
            g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a b))) ^ (Finset.univ.sup n) •
          (F.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
            g ⁻¹ᵁ wcPmChart m b)).op).hom (y b)) = 0 := by
        rw [pow_add, mul_comm _ (_ ^ d), mul_smul, h1, smul_zero]
      rw [smul_sub, smul_smul, sub_eq_zero] at h2
      rw [smF, smF, map_pow, map_pow, h2, smul_smul,
        P3V a b k _ inf_le_left inf_le_right]
      congr 1
      ring
    · show (g.app (wcPmChart m k) (e k k)) ^ r • y k = x
      rw [P1, one_pow, one_smul, hyk]

  have hgen : ∀ k, ∃ (nk : ℕ) (gen : Fin nk → Γ(F, g ⁻¹ᵁ wcPmChart m k)),
      Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k) (Set.range gen) = ⊤ := by
    intro k
    have := hfin k
    exact Module.Finite.exists_fin
  choose nk gen hgen using hgen
  have key2 : ∀ p : (Σ k : Fin (m + 1), Fin (nk k)), ∃ N₀ : ℕ, ∀ N, N₀ ≤ N →
      ∃ s : ∀ l, Γ(F, g ⁻¹ᵁ wcPmChart m l), wcCnTwisted g e F N s ∧ s p.1 = gen p.1 p.2 :=
    fun p => key p.1 (gen p.1 p.2)
  choose N₀ hN₀ using key2
  have hs : ∀ p : (Σ k : Fin (m + 1), Fin (nk k)), ∃ s : ∀ l, Γ(F, g ⁻¹ᵁ wcPmChart m l),
      wcCnTwisted g e F (Finset.univ.sup N₀) s ∧ s p.1 = gen p.1 p.2 :=
    fun p => hN₀ p _ (Finset.le_sup (f := N₀) (Finset.mem_univ p))
  choose S hS1 hS2 using hs
  refine ⟨Finset.univ.sup N₀, Fintype.card (Σ k : Fin (m + 1), Fin (nk k)),
    fun ρ => S ((Fintype.equivFin _).symm ρ), fun ρ => hS1 _, fun k => ?_⟩
  rw [eq_top_iff, ← hgen k]
  apply Submodule.span_mono
  rintro _ ⟨a, rfl⟩
  refine ⟨Fintype.equivFin _ ⟨k, a⟩, ?_⟩
  simp only [Equiv.symm_apply_apply]
  exact hS2 ⟨k, a⟩

theorem wc_cn_klm_adic_mod : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n), wcCnAdicSys h I Gs ψ → ∀ U : Z.Opens, IsAffineOpen U → (∀ (p : ℕ) (x : Γ(Gs p, U)), x ∈ Ideal.map (wcCnSigma h U) I • (⊤ : Submodule Γ(Z, U) Γ(Gs p, U)) → ∀ a ∈ I ^ p, wcCnSigma h U a • x = 0) ∧ (∀ x : ∀ p, Γ(Gs p, U), (∀ p, Scheme.Modules.Hom.app (ψ p) U (x (p + 1)) = x p) → x 0 = 0 → ∀ p, x p ∈ Ideal.map (wcCnSigma h U) I • (⊤ : Submodule Γ(Z, U) Γ(Gs p, U))) ∧ (∀ (q : ℕ) (ℓ : Fin q → ∀ p, Γ(Gs p, U)), (∀ ρ p, Scheme.Modules.Hom.app (ψ p) U (ℓ ρ (p + 1)) = ℓ ρ p) → Submodule.span Γ(Z, U) (Set.range fun ρ => ℓ ρ 0) = ⊤ → ∀ (p : ℕ) (y : Γ(Gs p, U)), ∃ c : Fin q → Γ(Z, U), y - ∑ ρ, c ρ • ℓ ρ p ∈ Ideal.map (wcCnSigma h U) I • (⊤ : Submodule Γ(Z, U) Γ(Gs p, U))) :=
by
  intro B _ I Z h Gs ψ hG U hU
  have hsurj := fun p => (hG.2.1 p U hU).1
  have hker := fun p => (hG.2.1 p U hU).2
  have hbot := fun p => hG.2.2 p U hU
  have hlin : ∀ p (r : Γ(Z, U)) (s : Γ(Gs (p + 1), U)),
      Scheme.Modules.Hom.app (ψ p) U (r • s) = r • Scheme.Modules.Hom.app (ψ p) U s :=
    fun p r s => Scheme.Modules.Hom.app_smul (ψ p) r s
  have hstep : ∀ p (y : Γ(Gs (p + 1), U)), Scheme.Modules.Hom.app (ψ p) U y ∈
      Ideal.map (wcCnSigma h U) I • (⊤ : Submodule Γ(Z, U) Γ(Gs p, U)) →
      y ∈ Ideal.map (wcCnSigma h U) I • (⊤ : Submodule Γ(Z, U) Γ(Gs (p + 1), U)) := by
    intro p y hy
    have himg : ∃ x' ∈ Ideal.map (wcCnSigma h U) I • (⊤ : Submodule Γ(Z, U) Γ(Gs (p + 1), U)),
        Scheme.Modules.Hom.app (ψ p) U x' = Scheme.Modules.Hom.app (ψ p) U y := by
      refine Submodule.smul_induction_on (p := fun z => ∃ x' ∈ Ideal.map (wcCnSigma h U) I •
        (⊤ : Submodule Γ(Z, U) Γ(Gs (p + 1), U)), Scheme.Modules.Hom.app (ψ p) U x' = z) hy ?_ ?_
      · intro r hr n _
        obtain ⟨n', hn'⟩ := hsurj p n
        exact ⟨r • n', Submodule.smul_mem_smul hr Submodule.mem_top, by rw [hlin, hn']⟩
      · rintro z₁ z₂ ⟨x₁, hx₁, rfl⟩ ⟨x₂, hx₂, rfl⟩
        exact ⟨x₁ + x₂, Submodule.add_mem _ hx₁ hx₂, map_add _ _ _⟩
    obtain ⟨x', hx', hxe⟩ := himg
    have h0 : Scheme.Modules.Hom.app (ψ p) U (y - x') = 0 := by
      rw [map_sub, hxe, sub_self]
    have h1 := (hker p (y - x')).mp h0
    have hle : Ideal.map (wcCnSigma h U) (I ^ (p + 1)) ≤ Ideal.map (wcCnSigma h U) I :=
      Ideal.map_mono (Ideal.pow_le_self (Nat.succ_ne_zero p))
    have h2 := Submodule.smul_mono_left hle h1
    have h3 := Submodule.add_mem _ h2 hx'
    rwa [sub_add_cancel] at h3
  refine ⟨?_, ?_, ?_⟩
  · intro p x hx a ha
    have h1 : wcCnSigma h U a ∈ Ideal.map (wcCnSigma h U) I ^ p := by
      rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem _ ha
    have h2 := Submodule.smul_mem_smul h1 hx
    rw [← Submodule.mul_smul, ← pow_succ, ← Ideal.map_pow, hbot p] at h2
    exact (Submodule.mem_bot _).mp h2
  · intro x hx hx0 p
    induction p with
    | zero => rw [hx0]; exact Submodule.zero_mem _
    | succ p ih => exact hstep p _ (by rw [hx p]; exact ih)
  · intro q ℓ hℓ hspan p
    induction p with
    | zero =>
      intro y
      have hy : y ∈ Submodule.span Γ(Z, U) (Set.range fun ρ => ℓ ρ 0) := by
        rw [hspan]; exact Submodule.mem_top
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun Γ(Z, U)).mp hy
      have hc' : y - ∑ ρ, c ρ • ℓ ρ 0 = 0 := sub_eq_zero.mpr hc.symm
      exact ⟨c, by rw [hc']; exact Submodule.zero_mem _⟩
    | succ p ih =>
      intro y
      obtain ⟨c, hc⟩ := ih (Scheme.Modules.Hom.app (ψ p) U y)
      refine ⟨c, hstep p _ ?_⟩
      have he : Scheme.Modules.Hom.app (ψ p) U (y - ∑ ρ, c ρ • ℓ ρ (p + 1)) =
          Scheme.Modules.Hom.app (ψ p) U y - ∑ ρ, c ρ • ℓ ρ p := by
        rw [map_sub, map_sum]
        congr 1
        refine Finset.sum_congr rfl (fun ρ _ => ?_)
        rw [hlin, hℓ]
      rw [he]; exact hc

theorem wc_cn_klm_pow_homog : ∀ {B : Type u} [CommRing B] (I : Ideal B) {r : ℕ} (b : Fin r → B), Ideal.span (Set.range b) = I → ∀ p : ℕ, (∀ P : MvPolynomial (Fin r) B, wcKlmEps b p P ∈ I ^ p) ∧ (∀ a ∈ I ^ p, ∃ P : MvPolynomial (Fin r) B, P.IsHomogeneous p ∧ MvPolynomial.eval b P = a) :=
by
  intro B _ I r b hI p
  classical
  have hbm : ∀ i, b i ∈ I := fun i => by
    rw [← hI]; exact Ideal.subset_span ⟨i, rfl⟩
  have hprod : ∀ d : Fin r →₀ ℕ, (d.prod fun i k => b i ^ k) ∈ I ^ d.degree := by
    intro d
    have h1 := Ideal.prod_mem_prod (s := d.support)
      (I := fun i => I ^ d i) (x := fun i => b i ^ d i)
      (fun i _ => Ideal.pow_mem_pow (hbm i) _)
    rw [Finset.prod_pow_eq_pow_sum] at h1
    exact h1
  have hε : ∀ (p : ℕ) (c : MvPolynomial (Fin r) B), wcKlmEps b p c ∈ I ^ p := by
    intro p c
    unfold wcKlmEps
    rw [MvPolynomial.homogeneousComponent_apply, map_sum]
    refine Ideal.sum_mem _ (fun d hd => ?_)
    rw [MvPolynomial.eval_monomial]
    have hdeg : d.degree = p := (Finset.mem_filter.mp hd).2
    refine Ideal.mul_mem_left _ _ ?_
    rw [← hdeg]
    exact hprod d
  have hii : ∀ p : ℕ, ∀ a ∈ I ^ p, ∃ P : MvPolynomial (Fin r) B,
      P.IsHomogeneous p ∧ MvPolynomial.eval b P = a := by
    intro p
    induction p with
    | zero =>
      intro a _
      exact ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C (Fin r) a, MvPolynomial.eval_C a⟩
    | succ p ih =>
      intro a ha
      rw [pow_succ] at ha
      refine Submodule.mul_induction_on ha ?_ ?_
      · intro m hm n hn
        obtain ⟨Pm, hPm, hPme⟩ := ih m hm
        rw [← hI] at hn
        obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hn
        have hLf : (∑ i, MvPolynomial.C (c i) * MvPolynomial.X i :
            MvPolynomial (Fin r) B).IsHomogeneous 1 :=
          MvPolynomial.IsHomogeneous.sum Finset.univ _ 1
            (fun i _ => MvPolynomial.isHomogeneous_C_mul_X (c i) i)
        refine ⟨Pm * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, hPm.mul hLf, ?_⟩
        rw [map_mul, hPme, ← hc, map_sum]
        congr 1
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      · rintro x y ⟨Px, hPx, rfl⟩ ⟨Py, hPy, rfl⟩
        exact ⟨Px + Py, hPx.add hPy, map_add _ _ _⟩
  exact ⟨fun P => hε p P, fun a ha => hii p a ha⟩

theorem wc_cn_klm_T3_witness : ∀ {B : Type u} {T M : Type*} [CommRing B] [CommRing T] [AddCommGroup M] [Module T M] (σ : B →+* T) {r q n : ℕ} (b : Fin r → B) (p N0 D : ℕ) (w : ℤ) (u : Fin n → T) (k l : Fin n), k ≠ l → u k = 1 → IsUnit (u l) → ∀ (ℓ : Fin q → M) (P : MvPolynomial (Fin r) B), P.IsHomogeneous p → ∀ Q : Fin q → MvPolynomial (Fin n) B, ∃ v : Fin q → (Fin n → ℤ) →₀ MvPolynomial (Fin r) B, v ∈ wcKlmH B r q n p ∧ v ∈ wcLaurC (MvPolynomial (Fin r) B) n q (fun _ => D) w {k, l} ∧ wcKlmEv (fun c => σ (wcKlmEps b p c)) u ℓ v = ∑ ρ, (σ (MvPolynomial.eval b P) * MvPolynomial.eval₂ σ u (Q ρ) * Ring.inverse (u l) ^ N0) • ℓ ρ :=
by
  classical
  intro B T M _ _ _ _ σ r q n b p N0 D w u k l hkl huk hul ℓ P hP Q
  obtain ⟨β, hβ⟩ : ∃ β : (Fin n →₀ ℕ) → Fin n → ℤ, ∀ μ i, β μ i = (μ i : ℤ) +
      (if i = k then (w - (D : ℤ)) - (∑ j, (μ j : ℤ)) + (N0 : ℤ) else 0) -
      (if i = l then (N0 : ℤ) else 0) := ⟨fun μ i => (μ i : ℤ) +
      (if i = k then (w - (D : ℤ)) - (∑ j, (μ j : ℤ)) + (N0 : ℤ) else 0) -
      (if i = l then (N0 : ℤ) else 0), fun _ _ => rfl⟩
  obtain ⟨v, hv⟩ : ∃ v : Fin q → (Fin n → ℤ) →₀ MvPolynomial (Fin r) B, ∀ ρ, v ρ =
      ∑ μ ∈ (Q ρ).support, Finsupp.single (β μ) (MvPolynomial.C ((Q ρ).coeff μ) * P) :=
    ⟨fun ρ => ∑ μ ∈ (Q ρ).support, Finsupp.single (β μ) (MvPolynomial.C ((Q ρ).coeff μ) * P),
      fun _ => rfl⟩

  have hLP : ∀ μ : Fin n →₀ ℕ,
      wcKlmLP u (β μ) = (∏ i, u i ^ μ i) * Ring.inverse (u l) ^ N0 := by
    intro μ
    obtain ⟨υ, hυ⟩ := hul
    have hR : (∏ i, u i ^ μ i) * Ring.inverse (u l) ^ N0 =
        ∏ i, (u i ^ μ i * (if i = l then Ring.inverse (u l) ^ N0 else 1)) := by
      rw [Finset.prod_mul_distrib]
      congr 1
      simp
    rw [hR]
    unfold wcKlmLP
    refine Finset.prod_congr rfl (fun i _ => ?_)
    rw [hβ]
    by_cases hik : i = k
    · subst hik
      rw [if_neg hkl, if_pos rfl, if_neg hkl, huk]
      simp [Ring.inverse_one]
    · by_cases hil : i = l
      · subst hil
        rw [if_pos rfl, if_neg hik, if_pos rfl, add_zero, ← hυ, Ring.inverse_unit,
          ← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val,
          ← Units.val_pow_eq_pow_val, ← Units.val_mul, ← Units.val_mul]
        congr 1
        rw [inv_pow, inv_pow, ← zpow_natCast, ← zpow_natCast, ← zpow_natCast, ← zpow_natCast,
          ← zpow_neg, ← zpow_neg, ← zpow_add, ← zpow_add]
        congr 1
        omega
      · rw [if_neg hik, if_neg hil, if_neg hil, add_zero, sub_zero, mul_one, Int.toNat_natCast,
          show (-(μ i : ℤ)).toNat = 0 by omega, pow_zero, mul_one]
  have hEps : ∀ c : B, wcKlmEps b p (MvPolynomial.C c * P) = c * MvPolynomial.eval b P := by
    intro c
    unfold wcKlmEps
    rw [MvPolynomial.homogeneousComponent_C_mul,
      MvPolynomial.homogeneousComponent_of_mem ((MvPolynomial.mem_homogeneousSubmodule p P).2 hP),
      if_pos rfl, map_mul, MvPolynomial.eval_C]
  have hterm : ∀ c : B, (MvPolynomial.C c * P).IsHomogeneous p := by
    intro c
    have := (MvPolynomial.isHomogeneous_C (Fin r) c).mul hP
    rwa [zero_add] at this
  refine ⟨v, ?_, ?_, ?_⟩
  · show ∀ ρ β', (v ρ β').IsHomogeneous p
    intro ρ β'
    rw [hv ρ, Finsupp.finsetSum_apply]
    apply MvPolynomial.IsHomogeneous.sum
    intro μ _
    rw [Finsupp.single_apply]
    split_ifs
    · exact hterm _
    · exact MvPolynomial.isHomogeneous_zero _ _ _
  · intro ρ
    rw [hv ρ]
    apply Submodule.sum_mem
    intro μ _
    apply Finsupp.single_mem_supported
    rw [Set.mem_setOf_eq]
    constructor
    · simp only [hβ]
      rw [Finset.sum_sub_distrib, Finset.sum_add_distrib, Fintype.sum_ite_eq', Fintype.sum_ite_eq']
      ring
    · intro i hi
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hi
      rw [hβ, if_neg hi.1, if_neg hi.2]
      omega
  · unfold wcKlmEv
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    set t : (Fin n → ℤ) → MvPolynomial (Fin r) B → M :=
      fun β' c => (σ (wcKlmEps b p c) * wcKlmLP u β') • ℓ ρ with ht
    have h0 : ∀ β', t β' 0 = 0 := by
      intro β'
      simp [ht, wcKlmEps]
    have hadd : ∀ β' (c1 c2 : MvPolynomial (Fin r) B), t β' (c1 + c2) = t β' c1 + t β' c2 := by
      intro β' c1 c2
      simp only [ht, wcKlmEps, map_add, add_mul, add_smul]
    show (v ρ).sum t = _
    rw [hv ρ, ← Finsupp.sum_finsetSum_index h0 hadd]
    have hterm2 : ∀ μ : Fin n →₀ ℕ, (Finsupp.single (β μ) (MvPolynomial.C ((Q ρ).coeff μ) * P)).sum t
        = (σ ((Q ρ).coeff μ) * σ (MvPolynomial.eval b P) *
            ((∏ i, u i ^ μ i) * Ring.inverse (u l) ^ N0)) • ℓ ρ := by
      intro μ
      rw [Finsupp.sum_single_index (h0 _), ht]
      simp only
      rw [hEps, hLP, map_mul]
    rw [Finset.sum_congr rfl (fun μ _ => hterm2 μ), ← Finset.sum_smul]
    congr 1
    rw [MvPolynomial.eval₂_eq', Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    ring

theorem wc_cn_klm_T3 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m r q : ℕ) (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n) (D : ℕ)
    (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)),
    wcKlmHyp h g e b Gs ψ D L → ∀ n w : ℕ,
    ∀ k l : Fin (m + 1), k < l → ∀ c : Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l),
      Scheme.Modules.Hom.app (ψ n) (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) c = 0 →
      ∃ v ∈ wcKlmH B r q (m + 1) (n + 1),
        v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l} ∧
        wcKlmTh2 h g e b Gs L (n + 1) k l v = c :=
by
  intro B _ _ _ Z h m r q g e b Gs ψ D L hHyp n w k l hkl c hc
  classical
  obtain ⟨hg, he1, he2, he3, he4, hG, hb, -, hspan, hL⟩ := hHyp

  have hcov : ∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : ∀ k : Fin (m + 1), IsAffineOpen (wcPmChart.{u} m k) := fun k =>
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k))
        Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
    haveI hcomp : IsAffineHom (Limits.prod.lift h g ≫ Limits.prod.snd) := inferInstance
    have hga : IsAffineHom g := by
      rw [Limits.prod.lift_snd] at hcomp
      exact hcomp
    exact fun k => (hD k).preimage g

  have hVeq : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l =
      Z.basicOpen (g.app (wcPmChart m k) (e k l)) := by
    rw [← Scheme.Hom.preimage_inf, he2 k l, Scheme.preimage_basicOpen]

  have hqc : ∀ (M : Z.Modules), wcQcoh M → ∀ (U W : Z.Opens) (hWU : W ≤ U), IsAffineOpen U →
      ∀ f : Γ(Z, U), W = Z.basicOpen f → IsAffineOpen W ∧
        IsUnit ((Z.presheaf.map (homOfLE hWU).op).hom f) ∧
        ∀ s : Γ(M, W), ∃ (N : ℕ) (t : Γ(M, U)),
          ((Z.presheaf.map (homOfLE hWU).op).hom f) ^ N • s = (M.presheaf.map (homOfLE hWU).op).hom t := by
    intro M hM U W hWU hU f hW
    subst hW
    exact ⟨hU.basicOpen f, RingedSpace.isUnit_res_basicOpen Z.toRingedSpace f, (hM U hU f).1⟩
  obtain ⟨hVaff, hlam, hloc⟩ := hqc (Gs (n + 1)) (hG.1 (n + 1)).1 (g ⁻¹ᵁ wcPmChart m k)
    (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) inf_le_left (hcov k) _ hVeq

  have hc' := ((hG.2.1 n _ hVaff).2 c).mp hc

  have hσcomp : (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
      g ⁻¹ᵁ wcPmChart m k)).op).hom.comp (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k)) =
      wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) := by
    unfold wcCnSigma
    rw [← RingHom.comp_assoc, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl
  have hσres : ∀ a : B, (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) a) =
      wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) a := fun a => by
    rw [← hσcomp]; rfl
  have hsm : ∀ (t : Γ(Z, g ⁻¹ᵁ wcPmChart m k)) (s : Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k)),
      ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (t • s) =
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom t •
      ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom s := fun t s =>
    Scheme.Modules.map_smul (Gs (n + 1)) (homOfLE inf_le_left) t s

  have hR0 : ∃ v ∈ wcKlmH B r q (m + 1) (n + 1),
      v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l} ∧
      wcKlmTh2 h g e b Gs L (n + 1) k l v = 0 := by
    refine ⟨0, zero_mem _, fun ρ => Submodule.zero_mem _, ?_⟩
    unfold wcKlmTh2 wcKlmEv
    simp
  have hRadd : ∀ x y : Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l),
      (∃ v ∈ wcKlmH B r q (m + 1) (n + 1),
        v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l} ∧
        wcKlmTh2 h g e b Gs L (n + 1) k l v = x) →
      (∃ v ∈ wcKlmH B r q (m + 1) (n + 1),
        v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l} ∧
        wcKlmTh2 h g e b Gs L (n + 1) k l v = y) →
      (∃ v ∈ wcKlmH B r q (m + 1) (n + 1),
        v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l} ∧
        wcKlmTh2 h g e b Gs L (n + 1) k l v = x + y) := by
    rintro x y ⟨v, hv, hvL, rfl⟩ ⟨v', hv', hv'L, rfl⟩
    refine ⟨v + v', add_mem hv hv', fun ρ => Submodule.add_mem _ (hvL ρ) (hv'L ρ), ?_⟩
    unfold wcKlmTh2 wcKlmEv
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.add_apply]
    apply Finsupp.sum_add_index'
    · intro β; simp [wcKlmEps]
    · intro β c1 c2; simp only [wcKlmEps, map_add, add_mul, add_smul]

  have hgen : ∀ a ∈ IsLocalRing.maximalIdeal B ^ (n + 1),
      ∀ x : Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l),
      ∃ v ∈ wcKlmH B r q (m + 1) (n + 1),
        v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l} ∧
        wcKlmTh2 h g e b Gs L (n + 1) k l v =
          wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) a • x := by
    intro a ha x
    obtain ⟨N, y, hy⟩ := hloc x
    obtain ⟨hA1, -, hA3⟩ := wc_cn_klm_adic_mod B (IsLocalRing.maximalIdeal B) Z h Gs ψ hG
      (g ⁻¹ᵁ wcPmChart m k) (hcov k)
    obtain ⟨cc, hcc⟩ := hA3 q (L k) (fun ρ p => hL k ρ p) (hspan k) (n + 1) y
    have hkill := hA1 (n + 1) _ hcc a ha
    have h1 : wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) a • y =
        ∑ ρ, (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) a * cc ρ) • L k ρ (n + 1) := by
      rw [smul_sub, sub_eq_zero, Finset.smul_sum] at hkill
      rw [hkill]
      refine Finset.sum_congr rfl (fun ρ _ => ?_)
      rw [smul_smul]

    have h2 : wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) a •
        ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom y =
        ∑ ρ, (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) a *
          (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
            g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (cc ρ)) •
          ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
            g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ (n + 1)) := by
      have h1' := congrArg ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left :
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom h1
      rw [hsm, map_sum, hσres] at h1'
      rw [h1']
      refine Finset.sum_congr rfl (fun ρ _ => ?_)
      rw [hsm, map_mul, hσres]

    have hx : x = Ring.inverse ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ N •
        ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom y := by
      rw [← hy, smul_smul, ← mul_pow, Ring.inverse_mul_cancel _ hlam, one_pow, one_smul]
    have h3 : wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) a • x =
        ∑ ρ, (Ring.inverse ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ N *
          (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) a *
          (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
            g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (cc ρ))) •
          ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
            g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ (n + 1)) := by
      conv_lhs => rw [hx]
      rw [smul_comm, h2, Finset.smul_sum]
      refine Finset.sum_congr rfl (fun ρ _ => ?_)
      rw [smul_smul]

    have hQex : ∀ ρ, ∃ Q : MvPolynomial (Fin (m + 1)) B,
        MvPolynomial.eval₂ (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k))
          (fun i => g.app (wcPmChart m k) (e k i)) Q = cc ρ := fun ρ =>
      wc_pm_chart_pullback_generation B Z h m g hg k (e k) (he4 k) (cc ρ)
    choose Q hQ using hQex
    have hresQ : ∀ ρ, (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (cc ρ) =
        MvPolynomial.eval₂ (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
          (fun i => (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
            g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
              (g.app (wcPmChart m k) (e k i))) (Q ρ) := by
      intro ρ
      rw [← hQ ρ, MvPolynomial.eval₂_comp_left, hσcomp]
      rfl

    obtain ⟨P, hP, hPa⟩ := (wc_cn_klm_pow_homog (IsLocalRing.maximalIdeal B) b hb (n + 1)).2 a ha

    have huk : (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k k)) = 1 := by
      rw [he1 k, map_one, map_one]
    obtain ⟨v, hvH, hvL, hvE⟩ := wc_cn_klm_T3_witness
      (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)) b (n + 1) N D (w : ℤ)
      (fun i => (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k i)))
      k l (ne_of_lt hkl) huk hlam
      (fun ρ => ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ (n + 1))) P hP Q
    refine ⟨v, hvH, hvL, ?_⟩
    unfold wcKlmTh2
    rw [hvE, h3]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [hPa, ← hresQ ρ]
    congr 1
    ring

  refine Submodule.smul_induction_on hc' ?_ hRadd
  intro s hs x _
  have hs' : s ∈ Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)
      (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) ''
        ↑(IsLocalRing.maximalIdeal B ^ (n + 1))) := hs
  clear hs
  induction hs' using Submodule.span_induction generalizing x with
  | mem s hs =>
    obtain ⟨a, ha, rfl⟩ := hs
    exact hgen a ha x
  | zero =>
    rw [zero_smul]
    exact hR0
  | add s t _ _ hs ht =>
    rw [add_smul]
    exact hRadd _ _ (hs x trivial) (ht x trivial)
  | smul t s _ hs =>
    rw [smul_eq_mul, mul_comm, mul_smul]
    exact hs (t • x) trivial

theorem wc_cn_klm_T4 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m r q : ℕ) (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n) (D : ℕ)
    (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)),
    wcKlmHyp h g e b Gs ψ D L → ∀ n w : ℕ,
    ∀ k l : Fin (m + 1), k < l → ∀ v ∈ wcLaurK (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D)
      (wcKlmK h g e b Gs L) (w : ℤ) {k, l}, wcKlmTh2 h g e b Gs L (n + 1) k l v = 0 :=
by
  intro B _ _ _ Z h m r q g e b Gs ψ D L hHyp n w k l _hkl v hv
  obtain ⟨hg, he1, he2, _he3, _he4, hG, hb, _htw, _hsp, hL1⟩ := hHyp
  have hbm : ∀ i, b i ∈ IsLocalRing.maximalIdeal B := fun i => by
    rw [← hb]; exact Ideal.subset_span ⟨i, rfl⟩

  have hU : IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : IsAffineOpen (wcPmChart.{u} m k) :=
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k))
        Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
    haveI hcomp : IsAffineHom (Limits.prod.lift h g ≫ Limits.prod.snd) := inferInstance
    have hga : IsAffineHom g := by
      rw [Limits.prod.lift_snd] at hcomp
      exact hcomp
    exact hD.preimage g



  have pevZero : ∀ {T M : Type u} [CommRing T] [AddCommGroup M] [Module T M]
      (α : MvPolynomial (Fin r) B → T) (u : Fin (m + 1) → T) (ℓ : Fin q → M),
      wcKlmPEv α u ℓ (0 : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) = 0 := by
    intro T M _ _ _ α u ℓ
    unfold wcKlmPEv
    simp
  have pevZeroα : ∀ {T M : Type u} [CommRing T] [AddCommGroup M] [Module T M]
      (α : MvPolynomial (Fin r) B → T), (∀ c, α c = 0) → ∀ (u : Fin (m + 1) → T) (ℓ : Fin q → M)
      (f : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      wcKlmPEv α u ℓ f = 0 := by
    intro T M _ _ _ α hα u ℓ f
    unfold wcKlmPEv
    simp [hα]
  have pevAdd : ∀ {T M : Type u} [CommRing T] [AddCommGroup M] [Module T M]
      (α : MvPolynomial (Fin r) B → T), α 0 = 0 → (∀ a a', α (a + a') = α a + α a') →
      ∀ (u : Fin (m + 1) → T) (ℓ : Fin q → M)
      (f f' : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      wcKlmPEv α u ℓ (f + f') = wcKlmPEv α u ℓ f + wcKlmPEv α u ℓ f' := by
    intro T M _ _ _ α h0 hadd u ℓ f f'
    classical
    unfold wcKlmPEv
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.add_apply]
    have hsub : ∀ (P : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B))
        (S : Finset (Fin (m + 1) →₀ ℕ)), P.support ⊆ S →
        ∑ μ ∈ P.support, (α (P.coeff μ) * ∏ i, u i ^ μ i) • ℓ ρ =
          ∑ μ ∈ S, (α (P.coeff μ) * ∏ i, u i ^ μ i) • ℓ ρ := by
      intro P S hPS
      refine Finset.sum_subset hPS (fun μ _ hμ => ?_)
      rw [MvPolynomial.notMem_support_iff.mp hμ, h0, zero_mul, zero_smul]
    rw [hsub _ ((f ρ).support ∪ (f' ρ).support) MvPolynomial.support_add,
      hsub (f ρ) ((f ρ).support ∪ (f' ρ).support) Finset.subset_union_left,
      hsub (f' ρ) ((f ρ).support ∪ (f' ρ).support) Finset.subset_union_right,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [MvPolynomial.coeff_add, hadd, add_mul, add_smul]
  have pevX : ∀ {T M : Type u} [CommRing T] [AddCommGroup M] [Module T M]
      (α : MvPolynomial (Fin r) B → T) (u : Fin (m + 1) → T) (ℓ : Fin q → M) (i : Fin (m + 1))
      (f : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      wcKlmPEv α u ℓ ((MvPolynomial.X i : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) • f) = u i • wcKlmPEv α u ℓ f := by
    intro T M _ _ _ α u ℓ i f
    unfold wcKlmPEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, MvPolynomial.support_X_mul, Finset.sum_map, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    have hp : ∏ j, u j ^ ((Finsupp.single i 1 + μ : Fin (m + 1) →₀ ℕ) j) =
        u i * ∏ j, u j ^ μ j := by
      simp only [Finsupp.add_apply, pow_add, Finset.prod_mul_distrib]
      congr 1
      rw [Finset.prod_eq_single i (fun j _ hj => by
          rw [Finsupp.single_apply, if_neg (fun h' => hj h'.symm), pow_zero])
        (fun hi => absurd (Finset.mem_univ i) hi), Finsupp.single_eq_same, pow_one]
    rw [addLeftEmbedding_apply, MvPolynomial.coeff_X_mul, hp, smul_smul]
    congr 1
    ring
  have pevC : ∀ {T M : Type u} [CommRing T] [AddCommGroup M] [Module T M]
      (α : MvPolynomial (Fin r) B → T), α 0 = 0 → ∀ (u : Fin (m + 1) → T) (ℓ : Fin q → M)
      (c₀ : MvPolynomial (Fin r) B)
      (f : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      wcKlmPEv α u ℓ ((MvPolynomial.C c₀ : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) • f) = wcKlmPEv (fun c => α (c₀ * c)) u ℓ f := by
    intro T M _ _ _ α h0 u ℓ c₀ f
    unfold wcKlmPEv
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul]
    have hs : (MvPolynomial.C c₀ * f ρ).support ⊆ (f ρ).support := by
      rw [MvPolynomial.C_mul']; exact MvPolynomial.support_smul
    refine (Finset.sum_subset hs ?_).trans (Finset.sum_congr rfl ?_)
    · intro μ _ hμ
      rw [MvPolynomial.notMem_support_iff.mp hμ, h0, zero_mul, zero_smul]
    · intro μ _
      rw [MvPolynomial.coeff_C_mul]
  have pevSmul : ∀ {T M : Type u} [CommRing T] [AddCommGroup M] [Module T M]
      (α : MvPolynomial (Fin r) B → T) (t : T) (u : Fin (m + 1) → T) (ℓ : Fin q → M)
      (f : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      wcKlmPEv (fun c => t * α c) u ℓ f = t • wcKlmPEv α u ℓ f := by
    intro T M _ _ _ α t u ℓ f
    unfold wcKlmPEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [smul_smul, mul_assoc]
  have pevLin : ∀ {T M M' : Type u} [CommRing T] [AddCommGroup M] [Module T M]
      [AddCommGroup M'] [Module T M'] (Φ : M →ₗ[T] M')
      (α : MvPolynomial (Fin r) B → T) (u : Fin (m + 1) → T) (ℓ : Fin q → M)
      (f : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      Φ (wcKlmPEv α u ℓ f) = wcKlmPEv α u (fun ρ => Φ (ℓ ρ)) f := by
    intro T M M' _ _ _ _ _ Φ α u ℓ f
    unfold wcKlmPEv
    simp only [map_sum, map_smul]
  have pevMap : ∀ {T T' M M' : Type u} [CommRing T] [CommRing T'] [AddCommGroup M] [Module T M]
      [AddCommGroup M'] [Module T' M'] (φ0 : T →+* T') (π0 : M →+ M'),
      (∀ (t : T) (x : M), π0 (t • x) = φ0 t • π0 x) →
      ∀ (α : MvPolynomial (Fin r) B → T) (α' : MvPolynomial (Fin r) B → T'),
      (∀ c, α' c = φ0 (α c)) → ∀ (u : Fin (m + 1) → T) (ℓ : Fin q → M)
      (f : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      wcKlmPEv α' (fun i => φ0 (u i)) (fun ρ => π0 (ℓ ρ)) f = π0 (wcKlmPEv α u ℓ f) := by
    intro T T' M M' _ _ _ _ _ _ φ0 π0 hπ0 α α' hα' u ℓ f
    unfold wcKlmPEv
    rw [map_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [hπ0, map_mul, map_prod, hα']
    simp only [map_pow]



  have eps0 : ∀ p, wcKlmEps b p 0 = 0 := fun p => by simp [wcKlmEps]
  have epsAdd : ∀ p c c', wcKlmEps b p (c + c') = wcKlmEps b p c + wcKlmEps b p c' :=
    fun p c c' => by simp only [wcKlmEps, map_add]
  have epsC : ∀ p (β : B) c, wcKlmEps b p (MvPolynomial.C β * c) = β * wcKlmEps b p c :=
    fun p β c => by
      simp only [wcKlmEps, MvPolynomial.homogeneousComponent_C_mul, map_mul, MvPolynomial.eval_C]
  have epsX0 : ∀ (j : Fin r) c, wcKlmEps b 0 (MvPolynomial.X j * c) = 0 := fun j c => by
    simp [wcKlmEps, MvPolynomial.homogeneousComponent_zero, MvPolynomial.coeff_X_mul']
  have epsXs : ∀ p (j : Fin r) c,
      wcKlmEps b (p + 1) (MvPolynomial.X j * c) = b j * wcKlmEps b p c := by
    intro p j c
    have hc : MvPolynomial.homogeneousComponent (p + 1) (MvPolynomial.X j * c) =
        MvPolynomial.X j * MvPolynomial.homogeneousComponent p c := by
      ext d
      rw [MvPolynomial.coeff_homogeneousComponent, MvPolynomial.coeff_X_mul',
        MvPolynomial.coeff_X_mul', MvPolynomial.coeff_homogeneousComponent]
      by_cases hj : j ∈ d.support
      · have hd : d = (d - Finsupp.single j 1) + Finsupp.single j 1 := by
          rw [tsub_add_cancel_of_le]
          rw [Finsupp.single_le_iff]
