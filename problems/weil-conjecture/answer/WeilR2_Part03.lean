theorem wc_lfes_affine_fp_presentation_transfer : ∀ (S V : Scheme.{u}) (p : V ⟶ S), IsAffine S → IsAffineHom p → LocallyOfFinitePresentation p → ∃ (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) Γ(S, ⊤)), ∀ (S' V' : Scheme.{u}) (h : S' ⟶ S) (q : V' ⟶ S') (j : V' ⟶ V), IsAffine S' → IsPullback j q p h → ((IsFinite q ↔ Module.Finite Γ(S', ⊤) (MvPolynomial (Fin m) Γ(S', ⊤) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map h.appTop.hom (g k)))) ∧ (Etale q ↔ Algebra.Etale Γ(S', ⊤) (MvPolynomial (Fin m) Γ(S', ⊤) ⧸ Ideal.span (Set.range fun k => MvPolynomial.map h.appTop.hom (g k))))) :=
by

  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B), f.FinitePresentation →
      ∃ (m r : ℕ) (g : Fin r → MvPolynomial (Fin m) A)
        (e : (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)) ≃+* B),
        ∀ a : A, e (algebraMap A (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)) a) = f a := by
    intro A B _ _ f hf
    letI := f.toAlgebra
    have hf' : Algebra.FinitePresentation A B := hf
    obtain ⟨m, π, hπ, hK⟩ := hf'.out
    obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hK
    have hg' : Ideal.span (Set.range g) = RingHom.ker π := hg
    refine ⟨m, r, g, ((Ideal.quotientEquivAlgOfEq A hg').trans
      (Ideal.quotientKerAlgEquivOfSurjective hπ)).toRingEquiv, fun a => ?_⟩
    have := ((Ideal.quotientEquivAlgOfEq A hg').trans
      (Ideal.quotientKerAlgEquivOfSurjective hπ)).commutes a
    rw [RingHom.algebraMap_toAlgebra] at this
    exact this

  have s2 : ∀ (A B : Type u) [CommRing A] [CommRing B] (ψ : A →+* B) (m r : ℕ)
      (g : Fin r → MvPolynomial (Fin m) A),
      ∃ inl : CommRingCat.of (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)) ⟶
              CommRingCat.of (MvPolynomial (Fin m) B ⧸
                Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k))),
        IsPushout (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin m) A ⧸
            Ideal.span (Set.range g)))) (CommRingCat.ofHom ψ)
          inl (CommRingCat.ofHom (algebraMap B (MvPolynomial (Fin m) B ⧸
            Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k))))) := by
    intro A B _ _ ψ m r g
    have hJJ' : Ideal.span (Set.range g) ≤ Ideal.comap (MvPolynomial.map ψ)
        (Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k))) := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      exact Ideal.subset_span ⟨k, rfl⟩
    have hA : ∀ a : A, algebraMap A (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)) a =
        Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.C a) := by
      intro a
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    have hB : ∀ b : B, algebraMap B (MvPolynomial (Fin m) B ⧸
        Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k))) b =
        Ideal.Quotient.mk (Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k)))
          (MvPolynomial.C b) := by
      intro b
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    have hcomm : CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin m) A ⧸
          Ideal.span (Set.range g))) ≫
        CommRingCat.ofHom (Ideal.quotientMap
          (Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k))) (MvPolynomial.map ψ) hJJ') =
        CommRingCat.ofHom ψ ≫ CommRingCat.ofHom (algebraMap B (MvPolynomial (Fin m) B ⧸
          Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k)))) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      rw [hA a, hB (ψ a), Ideal.quotientMap_mk, MvPolynomial.map_C]
    have hc : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap A
        (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)))) (CommRingCat.ofHom ψ)) (a : A),
        s.inl.hom (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.C a)) =
          s.inr.hom (ψ a) := by
      intro s a
      have := congrArg (fun φ => φ.hom a) s.condition
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at this
      rw [hA a] at this
      exact this
    have key : ∀ (s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap A
        (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range g)))) (CommRingCat.ofHom ψ)),
        ∀ x ∈ Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k)),
        MvPolynomial.eval₂Hom s.inr.hom
          (fun i => s.inl.hom (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X i)))
          x = 0 := by
      intro s x hx
      have hext : MvPolynomial.eval₂Hom (s.inr.hom.comp ψ)
          (fun i => s.inl.hom (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X i))) =
          s.inl.hom.comp (Ideal.Quotient.mk (Ideal.span (Set.range g))) := by
        apply MvPolynomial.ringHom_ext
        · intro a
          rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, RingHom.comp_apply, hc s a]
        · intro i
          rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply]
      have hle : Ideal.span (Set.range fun k => MvPolynomial.map ψ (g k)) ≤
