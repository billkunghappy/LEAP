        (∀ hle : Y.basicOpen (h * (c + d)) ≤ Y.basicOpen h, (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE hle))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp ξ (zero_add (n + 1)) = 0) := by
      intro c d hc hd hle
      have hlat : Y.basicOpen (h * (c + d) * c) ⊔ Y.basicOpen (h * (c + d) * d) =
          Y.basicOpen (h * (c + d)) := by
        rw [Scheme.basicOpen_mul Y (h * (c + d)) c, Scheme.basicOpen_mul Y (h * (c + d)) d,
          ← inf_sup_left]
        apply inf_eq_left.mpr
        exact (hmr h (c + d)).trans (Scheme.basicOpen_add_le Y c d)
      have ec : Y.basicOpen (h * (c + d) * c) ≤ Y.basicOpen (h * c) := by
        rw [show h * (c + d) * c = (h * c) * (c + d) by ring]; exact hml _ _
      have ed : Y.basicOpen (h * (c + d) * d) ≤ Y.basicOpen (h * d) := by
        rw [show h * (c + d) * d = (h * d) * (c + d) by ring]; exact hml _ _
      refine hMV _ _ _ (hml (h * (c + d)) c) (hml (h * (c + d)) d) hlat n
        (hsplit _ _ _ hlat) _ ?_ ?_
      · rw [← s1 (n + 1) _ _ _ (hml (h * (c + d)) c) hle ((hml (h * (c + d)) c).trans hle) ξ]
        exact kill c _ ec _ hc
      · rw [← s1 (n + 1) _ _ _ (hml (h * (c + d)) d) hle ((hml (h * (c + d)) d).trans hle) ξ]
        exact kill d _ ed _ hd
    obtain ⟨S, hS, hSv⟩ := hL h n ξ
    obtain ⟨k, N, f, a, hN, hf⟩ := hR h S hS
    have Pf : ∀ j, ∀ hle : Y.basicOpen (h * f j) ≤ Y.basicOpen h, (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE hle))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp ξ (zero_add (n + 1)) = 0 := by
      intro j hle
      obtain ⟨hle', hj⟩ := hf j
      exact hSv _ _ hj
    have PN : ∀ hle : Y.basicOpen (h * h ^ N) ≤ Y.basicOpen h, (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE hle))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp ξ (zero_add (n + 1)) = 0 := by
      rw [hN]
      exact Finset.sum_induction _
        (fun c => ∀ hle : Y.basicOpen (h * c) ≤ Y.basicOpen h, (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE hle))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp ξ (zero_add (n + 1)) = 0)
        Padd P0 (fun j _ => Psmul (a j) (f j) (Pf j))
    have hle0 : Y.basicOpen (h * h ^ N) ≤ Y.basicOpen h := hml _ _
    have heq : Y.basicOpen (h * h ^ N) = Y.basicOpen h := by
      rw [← pow_succ', Scheme.basicOpen_pow Y h (Nat.succ_pos N)]
    exact s2 (n + 1) _ _ heq hle0 ξ (PN hle0)
  intro q
  induction q with
  | zero => exact core 0 hH0
  | succ q ih =>
    apply core (q + 1)
    intro a b c _ y
    refine ⟨0, 0, ?_⟩
    have hs : Subsingleton (Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj (Y.basicOpen a ⊓ Y.basicOpen b)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F (q + 1)) := by
      have := ih (a * b)
      rwa [Scheme.basicOpen_mul] at this
    rw [Abelian.Ext.comp_zero, Abelian.Ext.comp_zero, add_zero]
    exact @Subsingleton.elim _ hs _ _

theorem wc_et_normal_sepclosed_quotient_acyclic : ∀ (Z : Scheme.{u}) [IsAffine Z] (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [IsSepClosed (FractionRing R)] (π : R →+* Γ(Z, ⊤)), Function.Surjective π → ∀ (m : ℕ), m ≠ 0 → ∀ q : ℕ, Subsingleton (wcEtCoh Z m (q + 1)) :=
by
  intro Z _ R _ _ _ _ π hπ m hm q
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hsplit := wc_normal_sepclosed_quot_etale_idem_split Z R π hπ

  have hsec : ∀ (c : Γ(Z, ⊤)) (V : Scheme.{u}) (p : V ⟶ (Z.basicOpen c : Scheme.{u})),
      IsFinite p → Etale p → Surjective p →
        ∃ σ : (Z.basicOpen c : Scheme.{u}) ⟶ V, σ ≫ p = 𝟙 _ := by
    intro c V p hfin het hsurj
    obtain ⟨hA, R', _, _, _, _, π', hπ'⟩ := wc_normal_sepclosed_quot_basicOpen Z R π hπ c
    haveI := hA
    exact wc_finite_etale_section_of_idem_split (Z.basicOpen c)
      (wc_normal_sepclosed_quot_etale_idem_split (Z.basicOpen c) R' π' hπ') V p hfin het hsurj

  have hall := wc_et_basic_open_induction Z
    ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    (wc_et_free_bot_isZero Z)
    (fun h n ξ => wc_et_ext_free_locally_zero Z _ _ n ξ)
    (wc_et_cover_basic_refine Z hsplit)
    (fun U U₀ U₁ h₀ h₁ hU n => wc_et_zariski_mv_ext Z U U₀ U₁ h₀ h₁ hU _ n)
    (wc_et_basic_mv_h0_surj Z hsec m hm) q 1
  have h1 : Z.basicOpen (1 : Γ(Z, ⊤)) = ⊤ := Z.basicOpen_of_isUnit isUnit_one
  rw [h1] at hall
  obtain ⟨e⟩ := wc_et_free_top_iso_const Z
  change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (q + 1))
  refine ⟨fun x y => ?_⟩
  have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (q + 1),
      z = (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp z (zero_add _))
        (zero_add _) := by
    intro z
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  rw [key x, key y, @Subsingleton.elim _ hall ((Abelian.Ext.mk₀ e.hom).comp x (zero_add _))
    ((Abelian.Ext.mk₀ e.hom).comp y (zero_add _))]

theorem wc_et_affine_finite_push_quot_kill : ∀ (Y : Scheme.{u}) [IsAffine Y] (W : Set Y), IsOpen W → ∀ (m : ℕ), m ≠ 0 → ∀ (P : Scheme.{u}) (p : P ⟶ Y) [IsFinite p] (G' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιG : G' ⟶ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), Mono ιG → wcSuppIn Y W G' → (∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H ⟶ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), wcSuppIn Y W H → ∃ χ' : H ⟶ G', χ' ≫ ιG = χ) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ (n : ℕ) (ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιG) (n + 1)), ∃ (P'' : Scheme.{u}) (p'' : P'' ⟶ Y) (_ : IsFinite p'') (v : (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ⟶ (wcEtPush p'').obj ((constantSheaf (Scheme.smallEtaleTopology P'') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), Mono v ∧ ∃ (H' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιH : H' ⟶ (wcEtPush p'').obj ((constantSheaf (Scheme.smallEtaleTopology P'') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), Mono ιH ∧ wcSuppIn Y W H' ∧ ∃ (c : Limits.cokernel ιG ⟶ Limits.cokernel ιH), Limits.cokernel.π ιG ≫ c = v ≫ Limits.cokernel.π ιH ∧ ζ.comp (Abelian.Ext.mk₀ c) (add_zero (n + 1)) = 0 :=
by
  intro Y _ W hW m hm P p _ G' ιG hGmono hGsupp hGuniv
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro n ζ

  haveI : IsAffine P := isAffine_of_isAffineHom p

  obtain ⟨T, t, hTa, hti, hts, R, _, _, _, _, π, hπ⟩ := wc_affine_absolute_integral_cover P
  haveI := hTa
  haveI := hti
  haveI := hts

  obtain ⟨J, _, _, D, P', p', hfin, e, κ, ⟨hcol⟩, j₀, w₀, hw₀⟩ :=
    wc_et_integral_push_const_colim Y m P p T t

  haveI : Limits.PreservesFiniteColimits (wcEtPush (t ≫ p)) := wc_et_integral_push_exact (t ≫ p)

  have hT7 : ∀ (F' : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
      (ιF : F' ⟶ (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))),
      Mono ιF → wcSuppIn T ((t ≫ p) ⁻¹' W) F' →
      (∀ (H₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
        (χ : H₂ ⟶ (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))),
        wcSuppIn T ((t ≫ p) ⁻¹' W) H₂ → ∃ χ' : H₂ ⟶ F', χ' ≫ ιF = χ) →
      ∀ q : ℕ, Subsingleton (wcEtExt T (Limits.cokernel ιF) (q + 1)) := by
    intro F' ιF hιF hF'supp hF'univ q
    have hW' : IsOpen ((t ≫ p) ⁻¹' W) := hW.preimage (t ≫ p).continuous
    obtain ⟨eI⟩ := wc_et_maxsupp_const_coker_iso T _ hW' m F' ιF hιF hF'supp hF'univ
    obtain ⟨Z, i, hi, hZa, hrange, ρ, hρ⟩ :=
      wc_affine_closed_subscheme_quotient T _ hW'.isClosed_compl
    haveI := hi
    haveI := hZa
    have hc : (Set.range i)ᶜ = (t ≫ p) ⁻¹' W := by rw [hrange, compl_compl]
    obtain ⟨E⟩ := wc_et_closed_complement_coh T Z i m (q + 1)
    haveI hsZ : Subsingleton (wcEtCoh Z m (q + 1)) :=
      wc_et_normal_sepclosed_quotient_acyclic Z R (ρ.comp π) (hρ.comp hπ) m hm q
    have hs1 : Subsingleton
        (wcEtExt T (Limits.cokernel (wcEtExtZeroι T (Set.range i)ᶜ m)) (q + 1)) :=
      E.subsingleton
    rw [hc] at hs1
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) (q + 1))
    change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        (Limits.cokernel (wcEtExtZeroι T ((t ≫ p) ⁻¹' W) m)) (q + 1)) at hs1
    refine ⟨fun x y => ?_⟩
    have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) (q + 1),
        z = (z.comp (Abelian.Ext.mk₀ eI.hom) (add_zero _)).comp (Abelian.Ext.mk₀ eI.inv)
          (add_zero _) := by
      intro z
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    rw [key x, key y, @Subsingleton.elim _ hs1 (x.comp (Abelian.Ext.mk₀ eI.hom) (add_zero _))
      (y.comp (Abelian.Ext.mk₀ eI.hom) (add_zero _))]

  obtain ⟨j, f, H', ιH, hιH, hH', c, hc, hζ⟩ := wc_et_quot_kill_of_colim_vanish Y W J
    (fun D' c' h => wc_et_affine_ext_filtered_colim_inj Y J D' c' h)
    (wc_et_maxsupp_filtered_colim Y W hW J)
    D _ κ ⟨hcol⟩ (wc_et_quot_acyclic_integral_push Y T (t ≫ p) W hW _ hT7)
    _ G' ιG hGsupp j₀ w₀ n ζ

  haveI := hfin j
  haveI := hw₀ j f
  haveI := hιH
  refine ⟨P' j, p' j, hfin j, (w₀ ≫ D.map f) ≫ (e j).hom, inferInstance, H', ιH ≫ (e j).hom,
    inferInstance, hH', ?_⟩
  have hw : ιH ≫ (e j).hom ≫ Limits.cokernel.π (ιH ≫ (e j).hom) = 0 := by
    rw [← Category.assoc, Limits.cokernel.condition]
  let d := Limits.cokernel.desc ιH ((e j).hom ≫ Limits.cokernel.π (ιH ≫ (e j).hom)) hw
  have hd : Limits.cokernel.π ιH ≫ d = (e j).hom ≫ Limits.cokernel.π (ιH ≫ (e j).hom) :=
    Limits.cokernel.π_desc _ _ _
  refine ⟨c ≫ d, ?_, ?_⟩
  · rw [← Category.assoc, hc]
    simp only [Category.assoc, hd]
  · have h2 : ζ.comp (Abelian.Ext.mk₀ (c ≫ d)) (add_zero (n + 1)) =
        (ζ.comp (Abelian.Ext.mk₀ c) (add_zero (n + 1))).comp (Abelian.Ext.mk₀ d)
          (add_zero (n + 1)) := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    rw [h2, hζ, Abelian.Ext.zero_comp]

theorem wc_et_affine_quot_vanish : ∀ (Y : Scheme.{u}) [IsAffine Y] (W : Set Y), IsOpen W →
    ∀ m : ℕ, m ≠ 0 →
    ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I]
      (J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (ι : J' ⟶ Limits.kernel (m • 𝟙 I)), Mono ι → wcSuppIn Y W J' →
    (∀ V : Y.Etale, (∀ x, V.hom x ∈ W) → Function.Surjective (ι.hom.app (Opposite.op V)).hom) →
    ∀ p : ℕ, Subsingleton (wcEtExt Y (Limits.cokernel ι) (p + 1)) :=
by
  intro Y _ W hW m hm I _ J' ι hι hsupp hsurj p
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hK : m • 𝟙 (Limits.kernel (m • 𝟙 I)) = 0 := by
    rw [← cancel_mono (Limits.kernel.ι (m • 𝟙 I))]
    have hc := Limits.kernel.condition (m • 𝟙 I)
    simp only [Preadditive.comp_nsmul, Category.comp_id] at hc
    simp only [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
    exact hc

  have huniv : ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (φ : G ⟶ Limits.kernel (m • 𝟙 I)), wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ := by
    intro G φ hG
    have hnat : ∀ (V₁ V₂ : Y.Etale) (a : V₂ ⟶ V₁) (x : G.obj.obj (Opposite.op V₁)),
        ((Limits.cokernel.π ι).hom.app (Opposite.op V₂)).hom
          ((φ.hom.app (Opposite.op V₂)).hom ((G.obj.map a.op).hom x)) =
        ((Limits.cokernel ι).obj.map a.op).hom
          (((Limits.cokernel.π ι).hom.app (Opposite.op V₁)).hom
            ((φ.hom.app (Opposite.op V₁)).hom x)) := by
      intro V₁ V₂ a x
      have h1 : (φ.hom.app (Opposite.op V₂)).hom ((G.obj.map a.op).hom x) =
          ((Limits.kernel (m • 𝟙 I)).obj.map a.op).hom ((φ.hom.app (Opposite.op V₁)).hom x) :=
        NatTrans.naturality_apply φ.hom a.op x
      rw [h1]
      exact NatTrans.naturality_apply (Limits.cokernel.π ι).hom a.op _
    have hsec : ∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)),
        ((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom
          ((φ.hom.app (Opposite.op V)).hom s) = 0 := by
      intro V s
      have hzero : ∀ (V' : Y.Etale) (g : V' ⟶ V),
          (Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
            G.obj.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W)).arrows g →
          ((Limits.cokernel ι).obj.map g.op).hom
            (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom
              ((φ.hom.app (Opposite.op V)).hom s)) = 0 := by
        intro V' g hg
        obtain ⟨V'', h, g', hg', rfl⟩ := hg
        have h1 : ((Limits.cokernel ι).obj.map g'.op).hom
            (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom
              ((φ.hom.app (Opposite.op V)).hom s)) = 0 := by
          rw [← hnat]
          rcases hg' with h0 | hWV
          · have h0' : (G.obj.map g'.op).hom s = 0 := h0
            rw [h0', map_zero, map_zero]
          · obtain ⟨a, ha⟩ := hsurj V'' hWV
              ((φ.hom.app (Opposite.op V'')).hom ((G.obj.map g'.op).hom s))
            rw [← ha]
            change ((ι ≫ Limits.cokernel.π ι).hom.app (Opposite.op V'')).hom a = 0
            rw [Limits.cokernel.condition]
            rfl
        rw [op_comp, Functor.map_comp]
        change ((Limits.cokernel ι).obj.map h.op).hom (((Limits.cokernel ι).obj.map g'.op).hom
          (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom
            ((φ.hom.app (Opposite.op V)).hom s))) = 0
        rw [h1, map_zero]
      refine (Limits.cokernel ι).isSeparated _ _ (hG V s) _ _ (fun V' g hg => ?_)
      have := hzero V' g hg
      rw [map_zero]
      exact this
    have hφπ : φ ≫ Limits.cokernel.π ι = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro s
      exact hsec V.unop s
    haveI := hι
    have hS : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).Exact :=
      ShortComplex.exact_cokernel ι
    exact ⟨hS.lift φ hφπ, hS.lift_f φ hφπ⟩

  have hT : ∀ (Q : Scheme.{u}) (q : Q ⟶ Y),
      m • 𝟙 ((wcEtPush q).obj ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) = 0 := by
    intro Q q
    have h0 : m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      rintro ⟨z⟩
      apply ULift.ext
      change m • z = (0 : ZMod m)
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    rw [← CategoryTheory.Functor.map_id (wcEtPush q), ← Functor.map_nsmul,
      ← CategoryTheory.Functor.map_id
        (constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}),
      ← Functor.map_nsmul, h0, Functor.map_zero, Functor.map_zero]

  have hE : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (a : A ⟶ B),
      Mono a → m • 𝟙 B = 0 → ∀ x : A ⟶ Limits.kernel (m • 𝟙 I),
      ∃ y : B ⟶ Limits.kernel (m • 𝟙 I), a ≫ y = x := by
    intro A B a ha hB x
    haveI := ha
    let y₀ : B ⟶ I := Injective.factorThru (x ≫ Limits.kernel.ι _) a
    have hy₀ : a ≫ y₀ = x ≫ Limits.kernel.ι _ := Injective.comp_factorThru _ _
    have hy : y₀ ≫ (m • 𝟙 I) = 0 := by
      have e : y₀ ≫ (m • 𝟙 I) = (m • 𝟙 B) ≫ y₀ := by
        simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
          Category.id_comp]
      rw [e, hB, Limits.zero_comp]
    refine ⟨Limits.kernel.lift _ y₀ hy, ?_⟩
    rw [← cancel_mono (Limits.kernel.ι (m • 𝟙 I)), Category.assoc, Limits.kernel.lift_ι, hy₀]

  change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ι) (p + 1))
  have hall : ∀ ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ι) (p + 1),
      ξ = 0 := by
    intro ξ

    obtain ⟨U, V, g, hU1, hU2, hV1, hV2, hgtor, ψ, F', ιF, hFmono, hFsupp, cF, hcF, ζ, hζ⟩ :=
      wc_et_quot_ext_fp_approx Y W hW m hm _ hK J' ι hι hsupp huniv (p + 1) ξ

    obtain ⟨P, pp, hpp, e, he⟩ := wc_et_fp_torsion_embed_finite_push Γ(Y, ⊤) Y Y.isoSpec.hom m hm
      U V g hU1 hU2 hV1 hV2 hgtor
    haveI := hpp

    obtain ⟨t, ht⟩ := hE e he (hT P pp) ψ

    obtain ⟨G', ιG, hGmono, hGsupp, hGuniv⟩ := wc_et_max_supported_subsheaf Y W
      ((wcEtPush pp).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))
    obtain ⟨e', he'⟩ := hGuniv F' (ιF ≫ e) hFsupp
    have hw : ιF ≫ e ≫ Limits.cokernel.π ιG = 0 := by
      rw [← Category.assoc, ← he', Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let d := Limits.cokernel.desc ιF (e ≫ Limits.cokernel.π ιG) hw
    have hd : Limits.cokernel.π ιF ≫ d = e ≫ Limits.cokernel.π ιG := Limits.cokernel.π_desc _ _ _

    obtain ⟨P'', p'', hp'', v, hv, H', ιH, hHmono, hHsupp, c, hc, hζ0⟩ :=
      wc_et_affine_finite_push_quot_kill Y W hW m hm P pp G' ιG hGmono hGsupp hGuniv p
        (ζ.comp (Abelian.Ext.mk₀ d) (add_zero (p + 1)))
    haveI := hp''

    obtain ⟨t'', ht''⟩ := hE v hv (hT P'' p'') t
    obtain ⟨h', hh'⟩ := huniv H' (ιH ≫ t'') hHsupp
    have hw'' : ιH ≫ t'' ≫ Limits.cokernel.π ι = 0 := by
      rw [← Category.assoc, ← hh', Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let c'' := Limits.cokernel.desc ιH (t'' ≫ Limits.cokernel.π ι) hw''
    have hc'' : Limits.cokernel.π ιH ≫ c'' = t'' ≫ Limits.cokernel.π ι :=
      Limits.cokernel.π_desc _ _ _

    have hcomp : d ≫ c ≫ c'' = cF := by
      rw [← cancel_epi (Limits.cokernel.π ιF)]
      calc Limits.cokernel.π ιF ≫ d ≫ c ≫ c''
          = e ≫ (Limits.cokernel.π ιG ≫ c) ≫ c'' := by
            rw [← Category.assoc, hd]; simp only [Category.assoc]
        _ = e ≫ v ≫ (Limits.cokernel.π ιH ≫ c'') := by rw [hc]; simp only [Category.assoc]
        _ = (e ≫ (v ≫ t'')) ≫ Limits.cokernel.π ι := by rw [hc'']; simp only [Category.assoc]
        _ = Limits.cokernel.π ιF ≫ cF := by rw [ht'', ht, hcF]

    have key : ((ζ.comp (Abelian.Ext.mk₀ d) (add_zero (p + 1))).comp (Abelian.Ext.mk₀ c)
        (add_zero (p + 1))).comp (Abelian.Ext.mk₀ c'') (add_zero (p + 1)) = ξ := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (p + 1)) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero (p + 1)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hcomp, hζ]
    rw [← key, hζ0, Abelian.Ext.zero_comp]
  exact ⟨fun x y => (hall x).trans (hall y).symm⟩

theorem wc_pbc_P1_quot_vanish_ge2 : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (a : Spec (.of A) ⟶ Spec (.of ((MvPolynomial.homogeneousSubmodule (Fin 2) R) 0)))
    (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A))
    (a' : X' ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) R) MvPolynomial.gradedAlgebra),
    IsPullback a' f' (wcP1 R) a → ∀ m : ℕ, m ≠ 0 →
    ∀ (I : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) [Injective I]
      (J' : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
      (ι : J' ⟶ Limits.kernel (m • 𝟙 I)), Mono ι →
    wcSuppIn X' {x | f' x ≠ IsLocalRing.closedPoint A} J' →
    (∀ (G : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1})
        (φ : G ⟶ Limits.kernel (m • 𝟙 I)),
        wcSuppIn X' {x | f' x ≠ IsLocalRing.closedPoint A} G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) →
    ∀ n : ℕ, Subsingleton (wcEtExt X' (Limits.cokernel ι) (n + 2)) :=
by
  intro R _ A _ _ _ a X' f' a' hsq m hm I _ J' ι hι hsupp huniv n
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _

  have hW : IsOpen {x | f' x ≠ IsLocalRing.closedPoint A} :=
    ((IsLocalRing.isClosed_singleton_closedPoint A).preimage f'.continuous).isOpen_compl

  have hsurj := wc_et_maxsupp_sections_surj X' {x | f' x ≠ IsLocalRing.closedPoint A}
    (Limits.kernel (m • 𝟙 I)) J' ι huniv

  have hlocT : ∀ T : X'.Etale, IsAffine T.left → ∀ p : ℕ,
      ∀ y : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
          (Limits.cokernel ι) (p + 1), y = 0 := by
    intro T hT p y
    haveI := (wc_et_slice_continuous T).1
    obtain ⟨IU, JU, ιU, hinj, hmonoU, hsuppU, hsurjU, ⟨e⟩⟩ :=
      wc_et_slice_restrict_torsion_data X' T {x | f' x ≠ IsLocalRing.closedPoint A} m I J' ι hι
        hsupp hsurj
    haveI := hinj
    haveI := hT
    have hWT : IsOpen (T.hom ⁻¹' {x | f' x ≠ IsLocalRing.closedPoint A}) :=
      hW.preimage T.hom.continuous
    have hs := wc_et_affine_quot_vanish T.left _ hWT m hm IU JU ιU hmonoU hsuppU hsurjU p
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    have hs2 : Subsingleton (wcEtExt T.left
        (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X')).obj
            (Limits.cokernel ι)) (p + 1)) := by
      change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ (p + 1))
      change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιU)
          (p + 1)) at hs
      refine ⟨fun x y => ?_⟩
      have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T.left)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
            (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X')).obj
              (Limits.cokernel ι)) (p + 1),
          z = (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv)
            (add_zero _) := by
        intro z
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      rw [key x, key y, @Subsingleton.elim _ hs (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero _))
        (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _))]
    obtain ⟨E⟩ := wc_et_ext_free_slice X' T (Limits.cokernel ι) (p + 1)
    apply E.injective
    exact @Subsingleton.elim _ hs2 _ _
  have hloc : ∀ U : X'.Opens, IsAffineOpen U → ∀ p : ℕ,
      ∀ y : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcZarToEt X').obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
          (Limits.cokernel ι) (p + 1), y = 0 := fun U hU p y =>
    hlocT ((wcZarToEt X').obj U) hU p y

  have mv : ∀ {A₀ B₀ B₁ P : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}}
      (f : A₀ ⟶ B₀ ⊞ B₁) (g : B₀ ⊞ B₁ ⟶ P) (h : f ≫ g = 0),
      (ShortComplex.mk f g h).ShortExact →
      ∀ (Q : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}),
      (∀ y : Abelian.Ext B₀ Q (n + 2), y = 0) → (∀ y : Abelian.Ext B₁ Q (n + 2), y = 0) →
      (∀ y : Abelian.Ext A₀ Q (n + 1), y = 0) → ∀ x : Abelian.Ext P Q (n + 2), x = 0 := by
    intro A₀ B₀ B₁ P f g h hS Q H0 H1 H01 x
    have hB : ∀ y : Abelian.Ext (B₀ ⊞ B₁) Q (n + 2), y = 0 := by
      intro y
      have e1 : y = (Abelian.Ext.mk₀ (𝟙 (B₀ ⊞ B₁))).comp y (zero_add _) :=
        (Abelian.Ext.mk₀_id_comp y).symm
      rw [e1, ← Limits.biprod.total, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
        H0 ((Abelian.Ext.mk₀ Limits.biprod.inl).comp y (zero_add _)),
        H1 ((Abelian.Ext.mk₀ Limits.biprod.inr).comp y (zero_add _)),
        Abelian.Ext.comp_zero, Abelian.Ext.comp_zero, add_zero]
    have h0 : (Abelian.Ext.mk₀ g).comp x (zero_add _) = 0 := hB _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS Q x h0
      (show 1 + (n + 1) = n + 2 by omega)
    rw [← hx₁, H01 x₁, Abelian.Ext.comp_zero]

  obtain ⟨U₀, U₁, htop, h0, h1, h01⟩ := wc_P1_base_change_affine_cover R A a X' f' a' hsq
  obtain ⟨f, g, h, hS⟩ := wc_et_free_mayer_vietoris_ses X' U₀ U₁ htop

  have hx := mv f g h hS (Limits.cokernel ι) (fun y => hloc U₀ h0 (n + 1) y)
    (fun y => hloc U₁ h1 (n + 1) y) (fun y => hloc (U₀ ⊓ U₁) h01 n y)
  change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X')
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ι) (n + 2))
  exact ⟨fun x y => (hx x).trans (hx y).symm⟩

theorem wc_et_qcqs_sections_local_cocone : ∀ (Y : Scheme.{u}) (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ] (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : ∀ i, F.obj i ⟶ G), (∀ (i j : Λ) (f : i ⟶ j), F.map f ≫ ψ j = ψ i) → (∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V')), ((ψ i).hom.app (Opposite.op V')).hom t = (G.obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) → (∀ (i : Λ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)), ((ψ i).hom.app (Opposite.op V)).hom t = 0 → Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) = 0) ∈ Scheme.smallEtaleTopology Y V) → ∀ (U : Y.Etale), CompactSpace U.left → QuasiSeparatedSpace U.left → (∀ s : G.obj.obj (Opposite.op U), ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op U)), ((ψ i).hom.app (Opposite.op U)).hom t = s) ∧ (∀ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op U)), ((ψ i).hom.app (Opposite.op U)).hom t = 0 → ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op U)).hom t = 0) :=
by
  intro Y Λ _ _ F G ψ hcomp hLa hLb U hUc hUq
  classical

  have hnat : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (φ : A ⟶ B)
      {V₁ V₂ : Y.Etale} (h : V₂ ⟶ V₁) (x : A.obj.obj (Opposite.op V₁)),
      (φ.hom.app (Opposite.op V₂)).hom ((A.obj.map h.op).hom x) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op V₁)).hom x) := by
    intro A B φ V₁ V₂ h x
    exact NatTrans.naturality_apply φ.hom h.op x
  have hres : ∀ {A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      {V₁ V₂ V₃ : Y.Etale} (g : V₃ ⟶ V₂) (h : V₂ ⟶ V₁) (x : A.obj.obj (Opposite.op V₁)),
      (A.obj.map (g ≫ h).op).hom x = (A.obj.map g.op).hom ((A.obj.map h.op).hom x) := by
    intro A V₁ V₂ V₃ g h x
    rw [op_comp, Functor.map_comp]
    rfl
  have hFcomp : ∀ {i j l : Λ} (f : i ⟶ j) (g : j ⟶ l) (V : Y.Etale)
      (x : (F.obj i).obj.obj (Opposite.op V)),
      ((F.map (f ≫ g)).hom.app (Opposite.op V)).hom x =
        ((F.map g).hom.app (Opposite.op V)).hom (((F.map f).hom.app (Opposite.op V)).hom x) := by
    intro i j l f g V x
    rw [Functor.map_comp]
    rfl
  have hψc : ∀ {i j : Λ} (f : i ⟶ j) (V : Y.Etale) (x : (F.obj i).obj.obj (Opposite.op V)),
      ((ψ j).hom.app (Opposite.op V)).hom (((F.map f).hom.app (Opposite.op V)).hom x) =
        ((ψ i).hom.app (Opposite.op V)).hom x := by
    intro i j f V x
    rw [← hcomp i j f]
    rfl

  have hc1 : ∀ (ι : Type) [Finite ι] (j : ι → Λ), ∃ j' : Λ, ∀ a, Nonempty (j a ⟶ j') := by
    intro ι _ j
    let _ := Fintype.ofFinite ι
    obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists (Finset.univ.image j)
    exact ⟨S, fun a => hS (Finset.mem_image_of_mem _ (Finset.mem_univ a))⟩
  have hc2 : ∀ (ι : Type) [Finite ι] (i : Λ) (j : ι → Λ) (φ : ∀ a, i ⟶ j a),
      ∃ (j' : Λ) (g : i ⟶ j') (h : ∀ a, j a ⟶ j'), ∀ a, φ a ≫ h a = g := by
    intro ι _ i j φ
    let _ := Fintype.ofFinite ι
    let O : Finset Λ := insert i (Finset.univ.image j)
    have hi : i ∈ O := Finset.mem_insert_self _ _
    have hj : ∀ a, j a ∈ O := fun a =>
      Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ a))
    let Hs : Finset ((X : Λ) ×' (Y : Λ) ×' (_ : X ∈ O) ×' (_ : Y ∈ O) ×' (X ⟶ Y)) :=
      Finset.univ.image (fun a => ⟨i, j a, hi, hj a, φ a⟩)
    obtain ⟨S, T, hT⟩ := IsFiltered.sup_exists O Hs
    exact ⟨S, T hi, fun a => T (hj a), fun a =>
      hT hi (hj a) (Finset.mem_image_of_mem _ (Finset.mem_univ a))⟩

  have hcovS : ∀ (V : Y.Etale) (k : ℕ) (W : Fin k → Y.Etale) (f : ∀ a, W a ⟶ V),
      (∀ x : V.left, ∃ a, x ∈ Set.range (f a).left) →
      Sieve.generate (Presieve.ofArrows W f) ∈ Scheme.smallEtaleTopology Y V := by
    intro V k W f hcov
    apply wc_etale_jointly_surjective_covers
    intro v
    obtain ⟨a, ha⟩ := hcov v
    exact ⟨W a, f a, ⟨_, 𝟙 _, f a, Presieve.ofArrows.mk a, Category.id_comp _⟩, ha⟩
  have hsep : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale)
      (k : ℕ) (W : Fin k → Y.Etale) (f : ∀ a, W a ⟶ V),
      (∀ x : V.left, ∃ a, x ∈ Set.range (f a).left) →
      ∀ (x y : H.obj.obj (Opposite.op V)),
        (∀ a, (H.obj.map (f a).op).hom x = (H.obj.map (f a).op).hom y) → x = y := by
    intro H V k W f hcov x y hxy
    apply H.isSeparated _ _ (hcovS V k W f hcov) x y
    intro Z e he
    obtain ⟨Z', h, g, hg, rfl⟩ := he
    cases hg with
    | mk a =>
      have e1 := hres (A := H) h (f a) x
      have e2 := hres (A := H) h (f a) y
      change (H.obj.map (h ≫ f a).op).hom x = (H.obj.map (h ≫ f a).op).hom y
      rw [e1, e2, hxy a]
  have hglue : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale)
      (k : ℕ) (W : Fin k → Y.Etale) (f : ∀ a, W a ⟶ V),
      (∀ x : V.left, ∃ a, x ∈ Set.range (f a).left) →
      ∀ (w : ∀ a, H.obj.obj (Opposite.op (W a))),
        (∀ σ : Fin 2 → Fin k,
          (H.obj.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op).hom (w (σ 0)) =
            (H.obj.map (Limits.WidePullback.π (fun l => f (σ l)) 1).op).hom (w (σ 1))) →
        ∃ t : H.obj.obj (Opposite.op V), ∀ a, (H.obj.map (f a).op).hom t = w a := by
    intro H V k W f hcov w hw
    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Y) (H.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj H).property
    have hSF := (Presieve.isSheafFor_arrows_iff _ f).mp (hP.isSheafFor _ (hcovS V k W f hcov))
    obtain ⟨t, ht, -⟩ := hSF w (by
      intro a b Z ga gb hab
      let σ : Fin 2 → Fin k := ![a, b]
      let fs : ∀ l : Fin 2, Z ⟶ W (σ l) := fun l =>
        Fin.cases (motive := fun l => Z ⟶ W (σ l)) ga
          (fun i => Fin.cases (motive := fun i => Z ⟶ W (σ i.succ)) gb (fun j => j.elim0) i) l
      have hfs : ∀ l, fs l ≫ f (σ l) = ga ≫ f a := by
        intro l
        fin_cases l
        · rfl
        · exact hab.symm
      have h0 : Limits.WidePullback.lift (ga ≫ f a) fs hfs ≫
          Limits.WidePullback.π (fun l => f (σ l)) 0 = ga :=
        Limits.WidePullback.lift_π (fun l => f (σ l)) (ga ≫ f a) fs hfs 0
      have h1 : Limits.WidePullback.lift (ga ≫ f a) fs hfs ≫
          Limits.WidePullback.π (fun l => f (σ l)) 1 = gb :=
        Limits.WidePullback.lift_π (fun l => f (σ l)) (ga ≫ f a) fs hfs 1
      change (H.obj.map ga.op).hom (w a) = (H.obj.map gb.op).hom (w b)
      have e0 := hres (A := H) (Limits.WidePullback.lift (ga ≫ f a) fs hfs)
        (Limits.WidePullback.π (fun l => f (σ l)) 0) (w (σ 0))
      have e1 := hres (A := H) (Limits.WidePullback.lift (ga ≫ f a) fs hfs)
        (Limits.WidePullback.π (fun l => f (σ l)) 1) (w (σ 1))
      rw [h0] at e0
      rw [h1] at e1
      refine e0.trans (Eq.trans ?_ e1.symm)
      rw [hw σ])
    exact ⟨t, ht⟩

  have hinj : ∀ (V : Y.Etale), CompactSpace V.left → ∀ (i : Λ)
      (t : (F.obj i).obj.obj (Opposite.op V)), ((ψ i).hom.app (Opposite.op V)).hom t = 0 →
      ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V)).hom t = 0 := by
    intro V hV i t ht
    obtain ⟨k, W, f, hR, -, hcov⟩ := wc_et_finite_affine_refinement Y V hV _ (hLb i V t ht)
    have hloc : ∀ a, ∃ (j : Λ) (φ : i ⟶ j), ((F.map φ).hom.app (Opposite.op (W a))).hom
        (((F.obj i).obj.map (f a).op).hom t) = 0 := by
      intro a
      obtain ⟨Z, h, g, ⟨j₀, φ₀, hφ₀⟩, hfa⟩ := hR a
      refine ⟨j₀, φ₀, ?_⟩
      rw [← hfa, hres, hnat, hφ₀, map_zero]
    choose jj φ hφ using hloc
    obtain ⟨j', g, hh, hgh⟩ := hc2 (Fin k) i jj φ
    refine ⟨j', g, ?_⟩
    apply hsep (F.obj j') V k W f hcov
    intro a
    rw [← hnat (F.map g) (f a) t, ← hgh a, hFcomp, hφ a]
    simp only [map_zero]
  refine ⟨fun s => ?_, fun i t ht => hinj U hUc i t ht⟩

  obtain ⟨k, W, f, hR, hWaff, hcov⟩ :=
    wc_et_finite_affine_refinement Y U hUc _ (hLa U s)
  have hloc : ∀ a, ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op (W a))),
      ((ψ i).hom.app (Opposite.op (W a))).hom t = (G.obj.map (f a).op).hom s := by
    intro a
    obtain ⟨Z, h, g, ⟨i₀, t₀, ht₀⟩, hfa⟩ := hR a
    refine ⟨i₀, ((F.obj i₀).obj.map h.op).hom t₀, ?_⟩
    rw [hnat, ht₀, ← hres, hfa]
  choose ii tt htt using hloc
  obtain ⟨j, hj⟩ := hc1 (Fin k) ii
  have e : ∀ a, ii a ⟶ j := fun a => (hj a).some
  obtain ⟨uu, huu⟩ : ∃ uu : ∀ a, (F.obj j).obj.obj (Opposite.op (W a)),
      ∀ a, ((ψ j).hom.app (Opposite.op (W a))).hom (uu a) = (G.obj.map (f a).op).hom s :=
    ⟨fun a => ((F.map (e a)).hom.app _).hom (tt a), fun a => (hψc (e a) _ _).trans (htt a)⟩
  have hd : ∀ σ : Fin 2 → Fin k, ∃ (jσ : Λ) (φ : j ⟶ jσ),
      ((F.map φ).hom.app (Opposite.op (Limits.widePullback U (fun l => W (σ l))
        (fun l => f (σ l))))).hom
        (((F.obj j).obj.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op).hom (uu (σ 0)) -
          ((F.obj j).obj.map (Limits.WidePullback.π (fun l => f (σ l)) 1).op).hom (uu (σ 1))) = 0 := by
    intro σ
    apply hinj _ (wc_et_widePullback_qcqs Y U k W f hUc hUq hWaff 1 σ).1 j
    rw [map_sub, hnat, hnat, huu, huu, ← hres, ← hres,
      Limits.WidePullback.π_arrow (fun l => f (σ l)) 0,
      Limits.WidePullback.π_arrow (fun l => f (σ l)) 1, sub_self]
  choose jσ φσ hφσ using hd
  obtain ⟨j', g, hh, hgh⟩ := hc2 (Fin 2 → Fin k) j jσ φσ
  obtain ⟨t, ht⟩ := hglue (F.obj j') U k W f hcov
    (fun a => ((F.map g).hom.app _).hom (uu a)) (by
      intro σ
      rw [← sub_eq_zero, ← hnat, ← hnat, ← map_sub, ← hgh σ, hFcomp, hφσ σ, map_zero])
  have ht' : ∀ a, ((F.obj j').obj.map (f a).op).hom t =
      ((F.map g).hom.app (Opposite.op (W a))).hom (uu a) := ht
  refine ⟨j', t, ?_⟩
  apply hsep G U k W f hcov
  intro a
  rw [← hnat, ht' a, hψc, huu]

theorem wc_et_qcqs_colim_injective_acyclic : ∀ (Y : Scheme.{u}), CompactSpace Y → QuasiSeparatedSpace Y → ∀ (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ] (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ i, Injective (I.obj i)) → (∀ (U : Y.Etale), CompactSpace U.left → QuasiSeparatedSpace U.left → (∀ s : (Limits.colimit I).obj.obj (Opposite.op U), ∃ (i : Λ) (t : (I.obj i).obj.obj (Opposite.op U)), ((Limits.colimit.ι I i).hom.app (Opposite.op U)).hom t = s) ∧ (∀ (i : Λ) (t : (I.obj i).obj.obj (Opposite.op U)), ((Limits.colimit.ι I i).hom.app (Opposite.op U)).hom t = 0 → ∃ (j : Λ) (f : i ⟶ j), ((I.map f).hom.app (Opposite.op U)).hom t = 0)) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)), e = 0 :=
by
  intro Y hYc hYqs Λ _ _ I hinj Hq
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q e
  haveI := wc_et_enough_injectives Y

  have hW : ∀ {i j : Λ} (g : i ⟶ j) (Z : Y.Etale) (x : (I.obj i).obj.obj (Opposite.op Z)),
      ((Limits.colimit.ι I j).hom.app (Opposite.op Z)).hom (((I.map g).hom.app (Opposite.op Z)).hom x) =
        ((Limits.colimit.ι I i).hom.app (Opposite.op Z)).hom x := by
    intro i j g Z x
    exact congrArg (fun m => (m.hom.app (Opposite.op Z)).hom x) (Limits.colimit.w I g)

  have hcomp : ∀ {i j l : Λ} (g : i ⟶ j) (g' : j ⟶ l) (Z : Y.Etale) (x : (I.obj i).obj.obj (Opposite.op Z)),
      ((I.map (g ≫ g')).hom.app (Opposite.op Z)).hom x =
        ((I.map g').hom.app (Opposite.op Z)).hom (((I.map g).hom.app (Opposite.op Z)).hom x) := by
    intro i j l g g' Z x
    exact congrArg (fun m => (m.hom.app (Opposite.op Z)).hom x) (I.map_comp g g')

  have s1 : ∀ (R : Type) [Finite R] (Z : R → Y.Etale),
      (∀ (r : R) (s : (Limits.colimit I).obj.obj (Opposite.op (Z r))), ∃ (i : Λ)
        (t : (I.obj i).obj.obj (Opposite.op (Z r))),
        ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom t = s) →
      ∀ (s : ∀ r, (Limits.colimit I).obj.obj (Opposite.op (Z r))), ∃ (i : Λ)
        (t : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        ∀ r, ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom (t r) = s r := by
    intro R _ Z h s
    choose i₀ t₀ ht₀ using fun r => h r (s r)
    haveI := Fintype.ofFinite R
    classical
    obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists (Finset.univ.image i₀)
    have g : ∀ r, i₀ r ⟶ S := fun r => (hS (Finset.mem_image_of_mem i₀ (Finset.mem_univ r))).some
    exact ⟨S, fun r => ((I.map (g r)).hom.app _).hom (t₀ r), fun r =>
      (hW (g r) (Z r) (t₀ r)).trans (ht₀ r)⟩

  have s2 : ∀ (R : Type) [Finite R] (Z : R → Y.Etale),
      (∀ (r : R) (i : Λ) (t : (I.obj i).obj.obj (Opposite.op (Z r))),
        ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom t = 0 →
        ∃ (j : Λ) (f : i ⟶ j), ((I.map f).hom.app (Opposite.op (Z r))).hom t = 0) →
      ∀ (i : Λ) (x : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        (∀ r, ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom (x r) = 0) →
        ∃ (j : Λ) (φ : i ⟶ j), ∀ r, ((I.map φ).hom.app (Opposite.op (Z r))).hom (x r) = 0 := by
    intro R _ Z h
    haveI := Fintype.ofFinite R
    classical
    have key : ∀ S : Finset R, ∀ (i : Λ) (x : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        (∀ r, ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom (x r) = 0) →
        ∃ (j : Λ) (φ : i ⟶ j), ∀ r ∈ S, ((I.map φ).hom.app (Opposite.op (Z r))).hom (x r) = 0 := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        intro i x _
        exact ⟨i, 𝟙 i, fun r hr => by simp at hr⟩
      | insert a S' haS ih =>
        intro i x hx
        obtain ⟨j₁, f₁, hf₁⟩ := h a i (x a) (hx a)
        obtain ⟨j, φ', hφ'⟩ := ih j₁ (fun r => ((I.map f₁).hom.app _).hom (x r))
          (fun r => (hW f₁ (Z r) (x r)).trans (hx r))
        refine ⟨j, f₁ ≫ φ', fun r hr => ?_⟩
        rw [hcomp]
        rcases Finset.mem_insert.mp hr with hra | hr'
        · subst hra
          rw [hf₁, map_zero]
        · exact hφ' r hr'
    intro i x hx
    obtain ⟨j, φ, hφ⟩ := key Finset.univ i x hx
    exact ⟨j, φ, fun r => hφ r (Finset.mem_univ r)⟩

  have hcech : ∀ (U : Y.Etale) (k : ℕ) (V : Fin k → Y.Etale) (f : ∀ i, V i ⟶ U),
      CompactSpace U.left → QuasiSeparatedSpace U.left → (∀ i, IsAffine (V i).left) →
      wcCechAcyclic (Limits.colimit I).obj V f := by
    intro U k V f hU1 hU2 hV p c hc

    obtain ⟨i, t, ht⟩ := s1 (Fin (p + 2) → Fin k)
      (fun τ => Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)))
      (fun τ s => (Hq _ (wc_et_widePullback_qcqs Y U k V f hU1 hU2 hV (p + 1) τ).1
        (wc_et_widePullback_qcqs Y U k V f hU1 hU2 hV (p + 1) τ).2).1 s) c

    have hx0 : ∀ ρ : Fin (p + 3) → Fin k,
        ((Limits.colimit.ι I i).hom.app
          (Opposite.op (Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l))))).hom
          (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
            (I.obj i).obj.map (wcCechFace V f ρ j).op (t (fun l => ρ (j.succAbove l)))) = 0 := by
      intro ρ
      refine Eq.trans ?_ (hc ρ)
      rw [map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_zsmul]
      congr 1
      rw [← ht (fun l => ρ (j.succAbove l))]
      exact NatTrans.naturality_apply (Limits.colimit.ι I i).hom (wcCechFace V f ρ j).op _

    obtain ⟨j, φ, hφ⟩ := s2 (Fin (p + 3) → Fin k)
      (fun ρ => Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l)))
      (fun ρ i t ht => (Hq _ (wc_et_widePullback_qcqs Y U k V f hU1 hU2 hV (p + 2) ρ).1
        (wc_et_widePullback_qcqs Y U k V f hU1 hU2 hV (p + 2) ρ).2).2 i t ht)
      i (fun ρ => ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
            (I.obj i).obj.map (wcCechFace V f ρ j).op (t (fun l => ρ (j.succAbove l)))) hx0

    haveI := hinj j
    obtain ⟨b', hb'⟩ := (wc_injective_cech_acyclic (Scheme.smallEtaleTopology Y) (I.obj j) V f).2 p
      (fun τ => ((I.map φ).hom.app _).hom (t τ)) (by
        intro ρ
        have hφρ := hφ ρ
        beta_reduce at hφρ ⊢
        refine Eq.trans ?_ hφρ
        rw [map_sum]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [map_zsmul]
        congr 1
        exact (NatTrans.naturality_apply (I.map φ).hom (wcCechFace V f ρ l).op _).symm)

    refine ⟨fun σ => ((Limits.colimit.ι I j).hom.app _).hom (b' σ), fun τ => ?_⟩
    have e1 := hb' τ
    beta_reduce at e1 ⊢
    refine Eq.trans ?_ ((congrArg (fun z => ((Limits.colimit.ι I j).hom.app
      (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))).hom z) e1).trans
      ((hW φ _ (t τ)).trans (ht τ)))
    beta_reduce
    rw [map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_zsmul]
    congr 1
    exact (NatTrans.naturality_apply (Limits.colimit.ι I j).hom (wcCechFace V f τ l).op _).symm

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTc : CompactSpace (Scheme.Etale.mk (𝟙 Y)).left := hYc
  have hTqs : QuasiSeparatedSpace (Scheme.Etale.mk (𝟙 Y)).left := hYqs
  have hs := wc_et_cartan_criterion_const Y
    (fun U => CompactSpace U.left ∧ QuasiSeparatedSpace U.left)
    (fun U k V f => (CompactSpace U.left ∧ QuasiSeparatedSpace U.left) ∧
      (∀ i, IsAffine (V i).left) ∧ ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left)
    (fun U k V f hc => wc_etale_jointly_surjective_covers Y U _ (fun v => by
      obtain ⟨i, hi⟩ := hc.2.2 v
      exact ⟨V i, f i, ⟨_, 𝟙 _, f i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hi⟩))
    (fun U k V f hc p σ => wc_et_widePullback_qcqs Y U k V f hc.1.1 hc.1.2 hc.2.1 p σ)
    (fun U hU R hR => by
      obtain ⟨k, V, f, hRf, hV, hsurj⟩ := wc_et_finite_affine_refinement Y U hU.1 R hR
      exact ⟨k, V, f, ⟨hU, hV, hsurj⟩, hRf⟩)
    _ hT ⟨hTc, hTqs⟩ (Limits.colimit I) (fun U k V f hc => hcech U k V f hc.1.1 hc.1.2 hc.2.1) q
  exact @Subsingleton.elim _ hs e 0

theorem wc_et_quot_h1_fp_approx : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of R))
    [QuasiCompact fY] [QuasiSeparated fY] (W : Set Y), IsOpen W → ∀ (m : ℕ), m ≠ 0 →
    ∀ (K : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), m • 𝟙 K = 0 →
    ∀ (J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : J' ⟶ K), Mono ι →
    wcSuppIn Y W J' →
    (∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : G ⟶ K),
        wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ι) 1,
    ∃ (U V : Y.Etale)
      (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)),
      CompactSpace U.left ∧ QuasiSeparatedSpace U.left ∧ CompactSpace V.left ∧
      QuasiSeparatedSpace V.left ∧ m • 𝟙 (Limits.cokernel g) = 0 ∧
      ∃ (ψ : Limits.cokernel g ⟶ K) (F' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (ιF : F' ⟶ Limits.cokernel g), Mono ιF ∧ wcSuppIn Y W F' ∧
        (∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H ⟶ Limits.cokernel g),
          wcSuppIn Y W H → ∃ χ' : H ⟶ F', χ' ≫ ιF = χ) ∧
        ∃ (cF : Limits.cokernel ιF ⟶ Limits.cokernel ι),
          Limits.cokernel.π ιF ≫ cF = ψ ≫ Limits.cokernel.π ι ∧
          ∃ ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) 1,
            ζ.comp (Abelian.Ext.mk₀ cF) (add_zero 1) = ξ :=
by
  intro R _ Y fY _ _ W hW m hm K hK J' ι hι hsupp huniv
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro ξ

  haveI hYc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace fY
  haveI hYqs : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated fY
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}
  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTc : CompactSpace (Scheme.Etale.mk (𝟙 Y)).left := hYc
  have hTqs : QuasiSeparatedSpace (Scheme.Etale.mk (𝟙 Y)).left := hYqs

  obtain ⟨Λ, hcat, hfilt, F, ψ, hcomp, hLa, hLb, hfp⟩ := wc_et_torsion_fp_filtered_system Y m K hK
  obtain ⟨Q, cq, hqc, hQa, hQb, hQdata⟩ :=
    wc_et_quot_filtered_system Y W Λ F K ψ hcomp hLa hLb J' ι hι hsupp huniv

  have H0 : ∀ (G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit G) 0),
      ∃ (i : Λ) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G.obj i) 0),
        y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero 0) = x := by
    intro G x
    obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y Λ G
    obtain ⟨hsurj, -⟩ := wc_et_qcqs_sections_local_cocone Y Λ G (Limits.colimit G)
      (Limits.colimit.ι G) (fun i j f => Limits.colimit.w G f) hA hB (Scheme.Etale.mk (𝟙 Y))
      hTc hTqs
    obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G) hT) x)
    refine ⟨i, (Sheaf.H.equiv₀ (G.obj i) hT).symm t,
      (Sheaf.H.equiv₀ (Limits.colimit G) hT).injective ?_⟩
    have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G i)
      ((Sheaf.H.equiv₀ (G.obj i) hT).symm t)
    rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
    rw [← h, ht]

  have Hemb : ∀ G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : G ⟶ I), Mono α ∧
        ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)),
          e = 0 := by
    intro G
    obtain ⟨I, α, hα, hinj⟩ := wc_et_functorial_injective_embedding Y Λ G
    obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y Λ I
    exact ⟨I, α, hα, wc_et_qcqs_colim_injective_acyclic Y hYc hYqs Λ I hinj (fun U hU1 hU2 =>
      wc_et_qcqs_sections_local_cocone Y Λ I (Limits.colimit I) (Limits.colimit.ι I)
        (fun i j f => Limits.colimit.w I f) hA hB U hU1 hU2)⟩

  obtain ⟨e, he⟩ := wc_et_local_cocone_colimit_iso Y Λ Q (Limits.cokernel ι) cq hqc hQa hQb
    (wc_et_sheaf_colimit_cocone_local Y Λ Q).1
  obtain ⟨i, ζQ, hζQ⟩ := wc_ext_filtered_colim_lift
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) Λ H0 Hemb Q 1
    (ξ.comp (Abelian.Ext.mk₀ e.inv) (add_zero 1))
  have hζcq : ζQ.comp (Abelian.Ext.mk₀ (cq i)) (add_zero 1) = ξ := by
    have h1 : (ζQ.comp (Abelian.Ext.mk₀ (Limits.colimit.ι Q i)) (add_zero 1)).comp
        (Abelian.Ext.mk₀ e.hom) (add_zero 1) = ξ := by
      rw [hζQ, Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, he i] at h1
    exact h1

  obtain ⟨U, V, g, hU1, hU2, hV1, hV2, hgtor, ⟨θ₁⟩⟩ := hfp i
  obtain ⟨F₀, ιF₀, θ, hF₀mono, hF₀s, hθ⟩ := hQdata i
  obtain ⟨ψ', hψ'⟩ : ∃ ψ' : Limits.cokernel g ⟶ K, ψ' = θ₁.inv ≫ ψ i := ⟨_, rfl⟩
  obtain ⟨F', ιF, hFmono, hFsupp, hFuniv⟩ := wc_et_max_supported_subsheaf Y W (Limits.cokernel g)
  obtain ⟨φ', hφ'⟩ := huniv F' (ιF ≫ ψ') hFsupp
  have hw₁ : ιF ≫ ψ' ≫ Limits.cokernel.π ι = 0 := by
    rw [← Category.assoc, ← hφ', Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  obtain ⟨cF, hcF⟩ : ∃ cF : Limits.cokernel ιF ⟶ Limits.cokernel ι,
      Limits.cokernel.π ιF ≫ cF = ψ' ≫ Limits.cokernel.π ι :=
    ⟨Limits.cokernel.desc ιF _ hw₁, Limits.cokernel.π_desc _ _ _⟩
  obtain ⟨e₀, he₀⟩ := hFuniv F₀ (ιF₀ ≫ θ₁.hom) hF₀s
  have hw₂ : ιF₀ ≫ θ₁.hom ≫ Limits.cokernel.π ιF = 0 := by
    rw [← Category.assoc, ← he₀, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  obtain ⟨κ, hκ⟩ : ∃ κ : Limits.cokernel ιF₀ ⟶ Limits.cokernel ιF,
      Limits.cokernel.π ιF₀ ≫ κ = θ₁.hom ≫ Limits.cokernel.π ιF :=
    ⟨Limits.cokernel.desc ιF₀ _ hw₂, Limits.cokernel.π_desc _ _ _⟩

  have hκcF : κ ≫ cF = θ.inv ≫ cq i := by
    rw [← cancel_epi (Limits.cokernel.π ιF₀)]
    calc Limits.cokernel.π ιF₀ ≫ κ ≫ cF = θ₁.hom ≫ Limits.cokernel.π ιF ≫ cF := by
          simp only [← Category.assoc, hκ]
      _ = Limits.cokernel.π ιF₀ ≫ θ.inv ≫ cq i := by
          rw [hcF, hθ]
          simp only [hψ', Category.assoc, Iso.hom_inv_id_assoc]
  refine ⟨U, V, g, hU1, hU2, hV1, hV2, hgtor, ψ', F', ιF, hFmono, hFsupp, hFuniv, cF, hcF,
    ζQ.comp (Abelian.Ext.mk₀ (θ.hom ≫ κ)) (add_zero 1), ?_⟩
  rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
    Category.assoc, hκcF, Iso.hom_inv_id_assoc, hζcq]

theorem wc_finite_strict_henselian_pieces : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Q : Scheme.{u}) (q : Q ⟶ Spec (.of A)), IsFinite q → ∃ (n : ℕ) (O : Fin n → Scheme.{u}) (t : ∀ i, O i ⟶ Q) (c : ∀ i, O i), (∀ i, IsOpenImmersion (t i)) ∧ (∀ i j, i ≠ j → Disjoint (Set.range (t i)) (Set.range (t j))) ∧ (∀ x : Q, ∃ i, x ∈ Set.range (t i)) ∧ ∀ (i : Fin n) (E : Scheme.{u}) (g : E ⟶ O i), Etale g → c i ∈ Set.range g → ∃ σ : O i ⟶ E, σ ≫ g = 𝟙 (O i) :=
by
  intro A _ _ hscA Q q hq
  classical

  have s1 : ∀ (A0 : Type u) [CommRing A0] [HenselianLocalRing A0] (E : Type u) [CommRing E]
      [Algebra A0 E], Algebra.Etale A0 E → ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
      ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
    intro A0 _ hHen
    have sstd : ∀ (S : Type u) [CommRing S] [Algebra A0 S], Algebra.IsStandardEtale A0 S →
        ∀ φ : S →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : S →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A0).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A0)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A0] IsLocalRing.ResidueField A0 :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := sstd _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A0 E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have s2 : ∀ (A0 : Type u) [CommRing A0] [IsLocalRing A0],
      (∀ (E : Type u) [CommRing E] [Algebra A0 E], Algebra.Etale A0 E →
        ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ) →
      ∀ (f : Polynomial A0) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A0)), f.Monic →
        g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A0) = g₀ * h₀ →
        ∃ g h : Polynomial A0, g.Monic ∧ h.Monic ∧ f = g * h ∧
          g.map (IsLocalRing.residue A0) = g₀ ∧ h.map (IsLocalRing.residue A0) = h₀ := by
    intro A0 _ _ s3 f g₀ h₀ hf hg hh hc hfac
    have hofId : ((Algebra.ofId A0 (IsLocalRing.ResidueField A0) :
        A0 →ₐ[A0] IsLocalRing.ResidueField A0) :
        A0 →+* IsLocalRing.ResidueField A0) = IsLocalRing.residue A0 := by
      ext x
      show Algebra.ofId A0 (IsLocalRing.ResidueField A0) x = IsLocalRing.residue A0 x
      rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq A0 f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A0)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap A0 (IsLocalRing.ResidueField A0)) (p : Polynomial A0) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A0)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
    have nat : ∀ (ψ : A0 →ₐ[A0] IsLocalRing.ResidueField A0),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A0 (IsLocalRing.ResidueField A0))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p ((Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2.monic, ?_,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl

  have s5 : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K], IsSepClosed k →
      Algebra.IsAlgebraic k K → IsSepClosed K := by
    intro k K _ _ _ hk hal
    haveI : IsAlgClosure k (AlgebraicClosure K) := IsAlgClosure.ofAlgebraic k K (AlgebraicClosure K)
    haveI : IsPurelyInseparable k (AlgebraicClosure K) :=
      (isSepClosed_iff_isPurelyInseparable_algebraicClosure k (AlgebraicClosure K)).mp hk
    haveI : IsPurelyInseparable K (AlgebraicClosure K) :=
      IsPurelyInseparable.tower_top k K (AlgebraicClosure K)
    exact (isSepClosed_iff_isPurelyInseparable_algebraicClosure K (AlgebraicClosure K)).mpr
      inferInstance

  have L := wc_idempotent_lift_of_factor_lift A (s2 A (s1 A))
  have hdec : ∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B →
      ∃ (n : ℕ) (e : Fin n → B), (∀ i, IsIdempotentElem (e i)) ∧
        (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧
        ∀ i, ∃ (_ : HenselianLocalRing (Localization.Away (e i))),
          IsSepClosed (IsLocalRing.ResidueField (Localization.Away (e i))) ∧
          IsLocalHom ((algebraMap B (Localization.Away (e i))).comp (algebraMap A B)) := by
    intro B _ _ hB
    obtain ⟨n, e, h1, h2, h3, h4⟩ := wc_finite_alg_local_idempotents A L B hB
    refine ⟨n, e, h1, h2, h3, fun i => ?_⟩
    exact @wc_local_factor_strictly_henselian A _ _ hscA (wc_finite_local_henselian A L) s5 B _ _
      hB (e i) (h1 i) (h4 i)

  obtain ⟨n, Ti, t₀, R, _, _, e, hsep, hopen, hdisj, hcov, -⟩ :=
    wc_finite_over_local_strict_cover A hdec Q q hq
  refine ⟨n, fun i => (Ti i).left, fun i => (t₀ i).left,
    fun i => (e i).inv (IsLocalRing.closedPoint (R i)), hopen, hdisj, hcov, ?_⟩

  intro i E g hg hc
  obtain ⟨y, hy⟩ := hc
  haveI := hsep i
  haveI : Etale g := hg
  exact wc_etale_section_strict_local (R i) (s1 (R i)) (e i) g y
    (by
      rw [hy]
      first
        | exact Scheme.inv_hom_apply (e i) _
        | (rw [← Scheme.Hom.comp_apply (e i).inv (e i).hom, Iso.inv_hom_id]; rfl)
        | (have h := Scheme.Hom.comp_apply (e i).inv (e i).hom (IsLocalRing.closedPoint (R i))
           rw [Iso.inv_hom_id] at h
           exact h.symm)
        | (simp; done))

theorem wc_finite_pieces_etale_factor : ∀ (Q S : Scheme.{u}) (n : ℕ) (O : Fin n → Scheme.{u}) (t : ∀ i, O i ⟶ Q) (c : ∀ i, O i), (∀ i, IsOpenImmersion (t i)) → (∀ i j, i ≠ j → Disjoint (Set.range (t i)) (Set.range (t j))) → (∀ x : Q, ∃ i, x ∈ Set.range (t i)) → (∀ (i : Fin n) (E : Scheme.{u}) (g : E ⟶ O i), Etale g → c i ∈ Set.range g → ∃ σ : O i ⟶ E, σ ≫ g = 𝟙 (O i)) → ∀ (s : Q ⟶ S) (W : Q → Scheme.{u}) (w : ∀ x, W x ⟶ S), (∀ x, Etale (w x)) → (∀ x, s x ∈ Set.range (w x)) → ∃ (xs : Fin n → Q) (a : Q ⟶ ∐ (fun i => W (xs i))), a ≫ Limits.Sigma.desc (fun i => w (xs i)) = s :=
by
  intro Q S n O t c ht hdisj hcov hsec s W w hw hsw
  let xs : Fin n → Q := fun i => t i (c i)
  have hlift : ∀ i, ∃ b : O i ⟶ W (xs i), b ≫ w (xs i) = t i ≫ s := by
    intro i
    haveI : Etale (w (xs i)) := hw (xs i)
    obtain ⟨y, hy⟩ := hsw (xs i)
    have hfy : (t i ≫ s) (c i) = w (xs i) y := by
      rw [hy, Scheme.Hom.comp_apply]
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (c i) y hfy
    obtain ⟨σ, hσ⟩ := hsec i (Limits.pullback (t i ≫ s) (w (xs i)))
      (Limits.pullback.fst _ _) inferInstance ⟨z, hz⟩
    refine ⟨σ ≫ Limits.pullback.snd _ _, ?_⟩
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
  choose b hb using hlift
  haveI : ∀ i, IsOpenImmersion (t i) := ht
  haveI hiso : IsIso (Limits.Sigma.desc t) := by
    rw [isIso_iff_isOpenImmersion_and_surjective]
    refine ⟨isOpenImmersion_sigmaDesc O t (fun i j hij => hdisj i j hij), ⟨fun x => ?_⟩⟩
    obtain ⟨i, y, hy⟩ := hcov x
    refine ⟨Limits.Sigma.ι O i y, ?_⟩
    rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_desc, hy]
  refine ⟨xs, inv (Limits.Sigma.desc t) ≫
    Limits.Sigma.desc (fun i => b i ≫ Limits.Sigma.ι (fun j => W (xs j)) i), ?_⟩
  have K : Limits.Sigma.desc (fun i => b i ≫ Limits.Sigma.ι (fun j => W (xs j)) i) ≫
      Limits.Sigma.desc (fun i => w (xs i)) = Limits.Sigma.desc t ≫ s := by
    apply Limits.Sigma.hom_ext
    intro i
    simp [hb]
  rw [Category.assoc, K, IsIso.inv_hom_id_assoc]

theorem wc_et_sheaf_lift_through_sigma : ∀ {Z : Scheme.{u}} {F G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}} (φ : F ⟶ G) (B : Z.Etale) (s : G.obj.obj (Opposite.op B)) (n : ℕ) (U : Fin n → Z.Etale) (u : ∀ i, U i ⟶ B), (∀ i, ∃ r : F.obj.obj (Opposite.op (U i)), (φ.hom.app (Opposite.op (U i))).hom r = (G.obj.map (u i).op).hom s) → ∀ (T : Z.Etale) (b : T ⟶ B) (g' : T.left ⟶ ∐ (fun i => (U i).left)), g' ≫ Limits.Sigma.desc (fun i => (u i).left) = b.left → ∃ r : F.obj.obj (Opposite.op T), (φ.hom.app (Opposite.op T)).hom r = (G.obj.map b.op).hom s :=
by
  intro Z F G φ B s n U u hr T b g' hg
  classical
  choose r hr using hr

  have s1 : ∃ (Ti : Fin n → Z.Etale) (τ : ∀ i, Ti i ⟶ T) (k : ∀ i, Ti i ⟶ U i),
      (∀ i, IsOpenImmersion (τ i).left) ∧
      (∀ i j, i ≠ j → Disjoint (Set.range (τ i).left) (Set.range (τ j).left)) ∧
      (∀ x : T.left, ∃ i, x ∈ Set.range (τ i).left) ∧ ∀ i, k i ≫ u i = τ i ≫ b := by
    let O : Fin n → T.left.Opens := fun i =>
      g' ⁻¹ᵁ (Limits.Sigma.ι (fun i => (U i).left) i).opensRange
    have hmemO : ∀ i (x : T.left), x ∈ Set.range (O i).ι ↔
        ∃ y, Limits.Sigma.ι (fun i => (U i).left) i y = g' x := by
      intro i x
      rw [Scheme.Opens.range_ι, SetLike.mem_coe, Scheme.Hom.mem_preimage,
        Scheme.Hom.mem_opensRange]
    have H : ∀ i, Set.range ((O i).ι ≫ g') ⊆
        Set.range (Limits.Sigma.ι (fun i => (U i).left) i) := by
      rintro i _ ⟨w, rfl⟩
      rw [Scheme.Hom.comp_apply]
      obtain ⟨y, hy⟩ := (hmemO i ((O i).ι w)).mp ⟨w, rfl⟩
      exact ⟨y, hy⟩
    let κ : ∀ i, (O i : Scheme.{u}) ⟶ (U i).left := fun i =>
      IsOpenImmersion.lift (Limits.Sigma.ι (fun i => (U i).left) i) ((O i).ι ≫ g') (H i)
    have hκ : ∀ i, κ i ≫ Limits.Sigma.ι (fun i => (U i).left) i = (O i).ι ≫ g' := fun i =>
      IsOpenImmersion.lift_fac _ _ _
    have hstar : ∀ i, κ i ≫ (u i).left = (O i).ι ≫ b.left := by
      intro i
      calc κ i ≫ (u i).left
          = κ i ≫ Limits.Sigma.ι (fun i => (U i).left) i ≫
              Limits.Sigma.desc (fun i => (u i).left) := by
            rw [Limits.Sigma.ι_desc]
        _ = (O i).ι ≫ g' ≫ Limits.Sigma.desc (fun i => (u i).left) := by
            rw [← Category.assoc, hκ, Category.assoc]
        _ = (O i).ι ≫ b.left := by rw [hg]
    have hover : ∀ i, κ i ≫ (U i).hom = (O i).ι ≫ T.hom := by
      intro i
      rw [← MorphismProperty.Over.w (u i), ← Category.assoc, hstar i, Category.assoc,
        MorphismProperty.Over.w b]
    let Ti : Fin n → Z.Etale := fun i => Scheme.Etale.mk ((O i).ι ≫ T.hom)
    let τ : ∀ i, Ti i ⟶ T := fun i => MorphismProperty.Over.homMk (O i).ι rfl trivial
    let k : ∀ i, Ti i ⟶ U i := fun i => MorphismProperty.Over.homMk (κ i) (hover i) trivial
    refine ⟨Ti, τ, k, fun i => ?_, fun i j hij => ?_, fun x => ?_, fun i => ?_⟩
    · show IsOpenImmersion (O i).ι
      infer_instance
    · change Disjoint (Set.range (O i).ι) (Set.range (O j).ι)
      rw [Set.disjoint_left]
      intro x hi hj
      obtain ⟨y, hy⟩ := (hmemO i x).mp hi
      obtain ⟨z, hz⟩ := (hmemO j x).mp hj
      have hd := disjoint_iff.mp (disjoint_opensRange_sigmaι (fun i => (U i).left) i j hij)
      have hx : g' x ∈ (Limits.Sigma.ι (fun i => (U i).left) i).opensRange ⊓
          (Limits.Sigma.ι (fun i => (U i).left) j).opensRange :=
        TopologicalSpace.Opens.mem_inf.mpr
          ⟨Scheme.Hom.mem_opensRange.mpr ⟨y, hy⟩, Scheme.Hom.mem_opensRange.mpr ⟨z, hz⟩⟩
      rw [hd] at hx
      simp at hx
    · obtain ⟨i, z, hz⟩ := (sigmaOpenCover (fun i => (U i).left)).exists_eq (g' x)
      exact ⟨i, (hmemO i x).mpr ⟨z, hz⟩⟩
    · apply MorphismProperty.Over.Hom.ext
      exact hstar i
  obtain ⟨Ti, τ, k, hopen, hdisj, hcov, hsq⟩ := s1


  have hbij : ∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}),
      Function.Bijective (fun (x : H.obj.obj (Opposite.op T)) (i : Fin n) =>
        (H.obj.map (τ i).op).hom x) := by
    intro H
    have e1 : ∀ W : Z.Etale, IsEmpty W.left → Subsingleton (H.obj.obj (Opposite.op W)) := by
      intro W hW
      have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology Z W := by
        change (⊥ : Sieve W) ∈ Scheme.smallGrothendieckTopology @Etale Z W
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        exact isEmptyElim x
      exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover H W hbot).isZero
    have e2 : Sieve.generate (Presieve.ofArrows Ti τ) ∈ Scheme.smallEtaleTopology Z T := by
      change Sieve.generate (Presieve.ofArrows Ti τ) ∈ Scheme.smallGrothendieckTopology @Etale Z T
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨i, y, hy⟩ := hcov x
      haveI := hopen i
      have hmem : (Sieve.generate (Presieve.ofArrows Ti τ)).arrows (τ i) :=
        Sieve.le_generate (Presieve.ofArrows Ti τ) (Ti i) (τ i) (Presieve.ofArrows.mk i)
      exact ⟨Ti i, τ i, y, hmem, inferInstance, hy⟩
    let P := H.obj ⋙ forget AddCommGrpCat
    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Z) P :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Z) H.obj
          (forget AddCommGrpCat)).1 H.cond)
    have e3 := (Presieve.isSheafFor_arrows_iff P τ).1 (hP.isSheafFor _ e2)
    have e4 : ∀ x : ∀ i, P.obj (Opposite.op (Ti i)), Presieve.Arrows.Compatible P τ x := by
      intro x i j W' gi gj h
      have hl : gi.left ≫ (τ i).left = gj.left ≫ (τ j).left := by
        have h1 : (Scheme.Etale.forget Z ⋙ Over.forget Z).map gi ≫
            (Scheme.Etale.forget Z ⋙ Over.forget Z).map (τ i) =
            (Scheme.Etale.forget Z ⋙ Over.forget Z).map gj ≫
            (Scheme.Etale.forget Z ⋙ Over.forget Z).map (τ j) := by
          rw [← Functor.map_comp, ← Functor.map_comp, h]
        exact h1
      by_cases hij : i = j
      · subst hij
        haveI := hopen i
        have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (τ i).left).1 hl
        rw [hg]
      · haveI : IsEmpty W'.left := ⟨fun z => by
          have hz : (τ i).left (gi.left z) = (τ j).left (gj.left z) := by
            rw [← Scheme.Hom.comp_apply, hl, Scheme.Hom.comp_apply]
          exact Set.disjoint_left.1 (hdisj i j hij) ⟨_, rfl⟩ ⟨_, hz.symm⟩⟩
        exact @Subsingleton.elim _ (e1 W' inferInstance) _ _
    refine ⟨fun x x' hxx => ?_, fun x => ?_⟩
    · obtain ⟨x0, _, huniq⟩ := e3 (fun i => (H.obj.map (τ i).op).hom x) (e4 _)
      exact (huniq x (fun i => rfl)).trans (huniq x' (fun i => (congrFun hxx i).symm)).symm
    · obtain ⟨x0, hx0, _⟩ := e3 x (e4 x)
      exact ⟨x0, funext hx0⟩

  let ρ : ∀ i, F.obj.obj (Opposite.op (Ti i)) := fun i => (F.obj.map (k i).op).hom (r i)
  have hρ : ∀ i, (φ.hom.app (Opposite.op (Ti i))).hom (ρ i) =
      (G.obj.map (τ i).op).hom ((G.obj.map b.op).hom s) := by
    intro i
    have e1 : (φ.hom.app (Opposite.op (Ti i))).hom ((F.obj.map (k i).op).hom (r i)) =
        (G.obj.map (k i).op).hom ((φ.hom.app (Opposite.op (U i))).hom (r i)) := by
      have := congrArg (fun h => h.hom (r i)) (φ.hom.naturality (k i).op)
      simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using this
    have e2 : G.obj.map (u i).op ≫ G.obj.map (k i).op = G.obj.map b.op ≫ G.obj.map (τ i).op := by
      rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hsq i]
    have e3 := congrArg (fun h => h.hom s) e2
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at e3
    show (φ.hom.app (Opposite.op (Ti i))).hom ((F.obj.map (k i).op).hom (r i)) = _
    rw [e1, hr i]
    exact e3
  obtain ⟨r₀, hr₀⟩ := (hbij F).2 ρ
  refine ⟨r₀, (hbij G).1 (funext fun i => ?_)⟩
  have h4 : (F.obj.map (τ i).op).hom r₀ = ρ i := congrFun hr₀ i
  have e5 : (φ.hom.app (Opposite.op (Ti i))).hom ((F.obj.map (τ i).op).hom r₀) =
      (G.obj.map (τ i).op).hom ((φ.hom.app (Opposite.op T)).hom r₀) := by
    have := congrArg (fun h => h.hom r₀) (φ.hom.naturality (τ i).op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using this
  show (G.obj.map (τ i).op).hom ((φ.hom.app (Opposite.op T)).hom r₀) =
    (G.obj.map (τ i).op).hom ((G.obj.map b.op).hom s)
  rw [← e5, h4, hρ i]

theorem wc_et_strict_henselization_prosystem : ∀ {Y : Scheme.{u}} (V : Y.Etale) (v : V.left), ∃ (A : Type u) (_ : CommRing A) (_ : HenselianLocalRing A) (_ : IsSepClosed (IsLocalRing.ResidueField A)) (Λ : Type u) (_ : SmallCategory Λ) (_ : IsCofiltered Λ) (W : Λ ⥤ Y.Etale) (g : ∀ l, W.obj l ⟶ V) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (ψ : Spec (.of A) ⟶ V.left), (∀ l, IsAffine (W.obj l).left) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), W.map t ≫ g l' = g l) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') ∧ (∀ l, φ l ≫ (g l).left = ψ) ∧ ψ (IsLocalRing.closedPoint A) = v ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) :=
by
  intro Y V v

  have s1 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), wcIndEtale σ → ∀ a : A, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E) (β : E →+* A) (x : E), Algebra.Etale R E ∧ β.comp (algebraMap R E) = σ ∧ β x = a := by
    intro R A _ _ σ hσ a
    letI := σ.toAlgebra
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hσ (Polynomial R) (Polynomial.aeval a)
    refine ⟨E, inferInstance, inferInstance, β.toRingHom, α Polynomial.X, hE, ?_, ?_⟩
    · ext r
      exact β.commutes r
    · have := congrArg (fun f => f Polynomial.X) hαβ
      simpa using this

  have s2 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), wcIndEtale σ → ∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ (β : E →+* A), β.comp (algebraMap R E) = σ → ∀ (m : ℕ) (x y : Fin m → E), (∀ i, β (x i) = β (y i)) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra R E') (q : E →ₐ[R] E') (β' : E' →+* A), Algebra.Etale R E' ∧ β'.comp (algebraMap R E') = σ ∧ β'.comp q.toRingHom = β ∧ ∀ i, q (x i) = q (y i) := by
    intro R A _ _ σ hσ E _ _ hE β hβ m x y hxy
    letI := σ.toAlgebra
    let βₐ : E →ₐ[R] A := { β with commutes' := fun r => RingHom.congr_fun hβ r }
    let I : Ideal E := Ideal.span (Set.range (fun i => x i - y i))
    haveI : Algebra.FinitePresentation R E := inferInstance
    haveI : Algebra.FinitePresentation R (E ⧸ I) :=
      Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range _))
    have hle : I ≤ RingHom.ker β := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      simp [RingHom.mem_ker, map_sub, hxy i]
    have hI : ∀ a ∈ I, βₐ a = 0 := fun a ha => hle ha
    obtain ⟨E', _, _, hE', α, β', hαβ'⟩ := hσ (E ⧸ I) (Ideal.Quotient.liftₐ I βₐ hI)
    refine ⟨E', inferInstance, inferInstance, α.comp (Ideal.Quotient.mkₐ R I), β'.toRingHom, hE',
      ?_, ?_, ?_⟩
    · ext r
      exact β'.commutes r
    · ext e
      have := congrArg (fun f => f (Ideal.Quotient.mk I e)) hαβ'
      simpa [βₐ] using this
    · intro i
      show α (Ideal.Quotient.mk I (x i)) = α (Ideal.Quotient.mk I (y i))
      rw [Ideal.Quotient.eq.mpr
        (Ideal.subset_span (⟨i, rfl⟩ : x i - y i ∈ Set.range (fun i => x i - y i)))]

  have s3 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A), (∀ a : A, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E) (β : E →+* A) (x : E), Algebra.Etale R E ∧ β.comp (algebraMap R E) = σ ∧ β x = a) → (∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ (β : E →+* A), β.comp (algebraMap R E) = σ → ∀ (m : ℕ) (x y : Fin m → E), (∀ i, β (x i) = β (y i)) → ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra R E') (q : E →ₐ[R] E') (β' : E' →+* A), Algebra.Etale R E' ∧ β'.comp (algebraMap R E') = σ ∧ β'.comp q.toRingHom = β ∧ ∀ i, q (x i) = q (y i)) → ∃ (J : Type u) (_ : SmallCategory J) (_ : IsFiltered J) (D : J ⥤ CommRingCat.{u}) (s : ∀ j, R →+* D.obj j) (β : ∀ j, D.obj j ⟶ CommRingCat.of A), (∀ j, (s j).Etale) ∧ (∀ {j j' : J} (t : j ⟶ j'), (D.map t).hom.comp (s j) = s j') ∧ (∀ {j j' : J} (t : j ⟶ j'), D.map t ≫ β j' = β j) ∧ (∀ j, (β j).hom.comp (s j) = σ) ∧ (∀ a : A, ∃ (j : J) (x : D.obj j), (β j).hom x = a) ∧ (∀ (j j' : J) (x : D.obj j) (y : D.obj j'), (β j).hom x = (β j').hom y → ∃ (k : J) (t : j ⟶ k) (t' : j' ⟶ k), (D.map t).hom x = (D.map t').hom y) := by
    intro R A _ _ σ hCOV hEQ
    letI := σ.toAlgebra
    have hOBJ : ∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ (b : E →ₐ[R] A),
        ∃ (j : wcShObj R A) (e : (MvPolynomial (Fin j.n) R ⧸ j.I) ≃ₐ[R] E),
          ∀ z, j.b z = b (e z) := by
      intro E _ _ hE b
      obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
        (inferInstance : Algebra.FiniteType R E)
      let e := Ideal.quotientKerAlgEquivOfSurjective hf
      exact ⟨⟨n, _, b.comp e.toAlgHom, Algebra.Etale.of_equiv e.symm⟩, e, fun _ => rfl⟩
    have toAlg : ∀ (E : Type u) [CommRing E] [Algebra R E] (β : E →+* A),
        β.comp (algebraMap R E) = σ → ∃ b : E →ₐ[R] A, ∀ z, b z = β z := by
      intro E _ _ β hβ
      exact ⟨{ β with commutes' := fun r => RingHom.congr_fun hβ r }, fun _ => rfl⟩
    have hEQ' : ∀ (k₀ : wcShObj R A) (m : ℕ) (x y : Fin m → (MvPolynomial (Fin k₀.n) R ⧸ k₀.I)),
        (∀ i, k₀.b (x i) = k₀.b (y i)) →
        ∃ (k : wcShObj R A) (u : k₀ ⟶ k), ∀ i, u.1 (x i) = u.1 (y i) := by
      intro k₀ m x y hxy
      haveI := k₀.et
      obtain ⟨E', _, _, q, β', hE', hβ', hβq, hq⟩ :=
        hEQ _ k₀.et k₀.b.toRingHom k₀.b.comp_algebraMap m x y hxy
      obtain ⟨b', hb'⟩ := toAlg E' β' hβ'
      obtain ⟨k, e, hk⟩ := hOBJ E' hE' b'
      refine ⟨k, ⟨e.symm.toAlgHom.comp q, ?_⟩, fun i => ?_⟩
      · apply AlgHom.ext
        intro z
        have := RingHom.congr_fun hβq z
        show k.b (e.symm (q z)) = k₀.b z
        rw [hk, AlgEquiv.apply_symm_apply, hb']
        exact this
      · show e.symm (q (x i)) = e.symm (q (y i))
        rw [hq i]
    have hobj : ∀ j₁ j₂ : wcShObj R A, ∃ (k : wcShObj R A) (_ : j₁ ⟶ k) (_ : j₂ ⟶ k), True := by
      intro j₁ j₂
      haveI := j₁.et
      haveI := j₂.et
      haveI : Algebra.Etale (MvPolynomial (Fin j₁.n) R ⧸ j₁.I)
          (TensorProduct R (MvPolynomial (Fin j₁.n) R ⧸ j₁.I) (MvPolynomial (Fin j₂.n) R ⧸ j₂.I)) :=
        Algebra.Etale.baseChange R _ _
      have hE3 : Algebra.Etale R
          (TensorProduct R (MvPolynomial (Fin j₁.n) R ⧸ j₁.I) (MvPolynomial (Fin j₂.n) R ⧸ j₂.I)) :=
        Algebra.Etale.comp R (MvPolynomial (Fin j₁.n) R ⧸ j₁.I) _
      obtain ⟨k, e, hk⟩ := hOBJ _ hE3 (Algebra.TensorProduct.lift j₁.b j₂.b
        (fun _ _ => Commute.all _ _))
      refine ⟨k, ⟨e.symm.toAlgHom.comp Algebra.TensorProduct.includeLeft, ?_⟩,
        ⟨e.symm.toAlgHom.comp Algebra.TensorProduct.includeRight, ?_⟩, trivial⟩
      · apply AlgHom.ext
        intro z
        show k.b (e.symm _) = _
        rw [hk, AlgEquiv.apply_symm_apply]
        simp
      · apply AlgHom.ext
        intro z
        show k.b (e.symm _) = _
        rw [hk, AlgEquiv.apply_symm_apply]
        simp
    haveI hfilt : IsFiltered (wcShObj R A) := by
      have hne : Nonempty (wcShObj R A) := by
        obtain ⟨E, _, _, β, x, hE, hβ, -⟩ := hCOV 0
        obtain ⟨b, -⟩ := toAlg E β hβ
        obtain ⟨j, -, -⟩ := hOBJ E hE b
        exact ⟨j⟩
      have hobj' : ∀ j₁ j₂ : wcShObj R A, ∃ (k : wcShObj R A) (_ : j₁ ⟶ k) (_ : j₂ ⟶ k), True :=
        hobj
      have hmaps : ∀ ⦃j₁ j₂ : wcShObj R A⦄ (f g : j₁ ⟶ j₂), ∃ (k : wcShObj R A) (h : j₂ ⟶ k),
          f ≫ h = g ≫ h := by
        intro j₁ j₂ f g
        obtain ⟨k, u, hu⟩ := hEQ' j₂ j₁.n (fun i => f.1 (Ideal.Quotient.mk _ (MvPolynomial.X i)))
          (fun i => g.1 (Ideal.Quotient.mk _ (MvPolynomial.X i))) (fun i => by
            have h1 := AlgHom.congr_fun f.2 (Ideal.Quotient.mk _ (MvPolynomial.X i))
            have h2 := AlgHom.congr_fun g.2 (Ideal.Quotient.mk _ (MvPolynomial.X i))
            simp only [AlgHom.comp_apply] at h1 h2
            rw [h1, h2])
        refine ⟨k, u, Subtype.ext ?_⟩
        apply Ideal.Quotient.algHom_ext R
        apply MvPolynomial.algHom_ext
        intro i
        exact hu i
      exact { cocone_objs := hobj', cocone_maps := hmaps, nonempty := hne }
    refine ⟨wcShObj R A, inferInstance, hfilt, wcShD R A,
      fun j => algebraMap R (MvPolynomial (Fin j.n) R ⧸ j.I),
      fun j => CommRingCat.ofHom j.b.toRingHom, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro j
      show (algebraMap R (MvPolynomial (Fin j.n) R ⧸ j.I)).Etale
      exact RingHom.etale_algebraMap.mpr j.et
    · intro j j' t
      exact t.1.comp_algebraMap
    · intro j j' t
      ext z
      exact AlgHom.congr_fun t.2 z
    · intro j
      exact j.b.comp_algebraMap
    · intro a
      obtain ⟨E, _, _, β, x, hE, hβ, hx⟩ := hCOV a
      obtain ⟨b, hb⟩ := toAlg E β hβ
      obtain ⟨j, e, hj⟩ := hOBJ E hE b
      refine ⟨j, e.symm x, ?_⟩
      show j.b (e.symm x) = a
      rw [hj, AlgEquiv.apply_symm_apply, hb, hx]
    · intro j j' x y hxy
      change MvPolynomial (Fin j.n) R ⧸ j.I at x
      change MvPolynomial (Fin j'.n) R ⧸ j'.I at y
      change j.b x = j'.b y at hxy
      obtain ⟨k₀, t₀, t₀', -⟩ := hobj j j'
      obtain ⟨k, u, hu⟩ := hEQ' k₀ 1 (fun _ => t₀.1 x) (fun _ => t₀'.1 y) (fun _ => by
        have h1 := AlgHom.congr_fun t₀.2 x
        have h2 := AlgHom.congr_fun t₀'.2 y
        simp only [AlgHom.comp_apply] at h1 h2
        rw [h1, h2]
        exact hxy)
      refine ⟨k, t₀ ≫ u, t₀' ≫ u, ?_⟩
      exact hu 0

  have s4 : ∀ (A : Type u) [CommRing A] (J : Type u) [SmallCategory J] [IsFiltered J] (D : J ⥤ CommRingCat.{u}) (β : ∀ j, D.obj j ⟶ CommRingCat.of A), (∀ {j j' : J} (t : j ⟶ j'), D.map t ≫ β j' = β j) → (∀ a : A, ∃ (j : J) (x : D.obj j), (β j).hom x = a) → (∀ (j j' : J) (x : D.obj j) (y : D.obj j'), (β j).hom x = (β j').hom y → ∃ (k : J) (t : j ⟶ k) (t' : j' ⟶ k), (D.map t).hom x = (D.map t').hom y) → ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ Spec (D.obj j)), (∀ {j j' : J} (t : j ⟶ j'), z j' ≫ Spec.map (D.map t) = z j) → ∃! z₀ : T ⟶ Spec (CommRingCat.of A), ∀ j, z₀ ≫ Spec.map (β j) = z j := by
    intro A _ J _ _ D β hDβ hsurj hinj T z hz
    let c : Limits.Cocone D :=
      { pt := CommRingCat.of A
        ι := { app := β
               naturality := fun j j' t => by
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
                 exact hDβ t } }
    have h1 : Limits.IsColimit ((forget CommRingCat).mapCocone c) := by
      apply Limits.Types.FilteredColimit.isColimitOf
      · intro a
        obtain ⟨j, x, hx⟩ := hsurj a
        exact ⟨j, x, hx.symm⟩
      · intro i j x y hxy
        exact hinj i j x y hxy
    haveI : Limits.ReflectsColimit D (forget CommRingCat) :=
      Limits.reflectsColimit_of_reflectsIsomorphisms D (forget CommRingCat)
    have hc : Limits.IsColimit c := Limits.isColimitOfReflects (forget CommRingCat) h1
    have hl := Limits.isLimitOfPreserves Scheme.Spec hc.op
    let s : Limits.Cone (D.op ⋙ Scheme.Spec) :=
      { pt := T
        π := { app := fun j => z j.unop
               naturality := fun j j' t => by
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp]
                 exact (hz t.unop).symm } }
    obtain ⟨z₀, hz₀, huniq⟩ := hl.existsUnique s
    exact ⟨z₀, fun j => hz₀ (Opposite.op j), fun w hw => huniq w (fun j => hw j.unop)⟩

  have s5 : ∀ (R A K : Type u) [CommRing R] [CommRing A] [IsLocalRing A] [Field K] (P : PrimeSpectrum R) [Algebra P.asIdeal.ResidueField K] (σ : R →+* A) (ρ : A →+* K), IsLocalHom ρ → ρ.comp σ = (algebraMap P.asIdeal.ResidueField K).comp (algebraMap R P.asIdeal.ResidueField) → PrimeSpectrum.comap σ (IsLocalRing.closedPoint A) = P := by
    intro R A K _ _ _ _ P _ σ ρ hρ h
    apply PrimeSpectrum.ext
    ext r
    have key : ρ (σ r) = algebraMap _ K (algebraMap R P.asIdeal.ResidueField r) :=
      RingHom.congr_fun h r
    have e1 : algebraMap R P.asIdeal.ResidueField r = 0 ↔ r ∈ P.asIdeal := by
      rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    change σ r ∈ IsLocalRing.maximalIdeal A ↔ _
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← e1]
    constructor
    · intro hn
      by_contra hr
      apply hn
      have h2 : ρ (σ r) ≠ 0 := by rw [key]; exact (map_ne_zero _).mpr hr
      exact isUnit_of_map_unit ρ _ (isUnit_iff_ne_zero.mpr h2)
    · intro hr hu
      have h3 := hu.map ρ
      rw [key, hr, map_zero] at h3
      exact not_isUnit_zero h3

  obtain ⟨U, hU, hvU, -⟩ := exists_isAffineOpen_mem_and_subset (X := V.left) (x := v) (U := ⊤) trivial
  let P : PrimeSpectrum Γ(V.left, U) := hU.primeIdealOf ⟨v, hvU⟩
  have hPv : hU.fromSpec P = v := hU.fromSpec_primeIdealOf ⟨v, hvU⟩
  let K := AlgebraicClosure P.asIdeal.ResidueField
  have hsep : IsSepClosed (IsLocalRing.ResidueField K) := by
    haveI := IsAlgClosed.of_ringEquiv K (IsLocalRing.ResidueField K)
      (RingEquiv.ofBijective (IsLocalRing.residue K)
        ⟨RingHom.injective _, IsLocalRing.residue_surjective⟩)
    infer_instance
  obtain ⟨A, _, σ, ρ, hAloc, hρσ, hAh, hAsep, hρloc, hind⟩ := wc_strict_hull Γ(V.left, U) K hsep
  obtain ⟨J, _, _, D, s, β, hs, hsD, hDβ, hβs, hsurj, hinj⟩ :=
    s3 _ A σ (s1 _ A σ hind) (s2 _ A σ hind)
  have hlim := s4 A J D β hDβ hsurj hinj

  let S : ∀ j, Γ(V.left, U) ⟶ D.obj j := fun j => CommRingCat.ofHom (s j)
  have hSD : ∀ {j j' : J} (t : j ⟶ j'), S j ≫ D.map t = S j' := by
    intro j j' t
    ext x
    exact RingHom.congr_fun (hsD t) x
  have hSβ : ∀ j, S j ≫ β j = CommRingCat.ofHom σ := by
    intro j
    ext x
    exact RingHom.congr_fun (hβs j) x
  have hSet : ∀ j, Etale (Spec.map (S j)) := fun j =>
    HasRingHomProperty.Spec_iff.mpr (hs j)
  haveI := hU.isOpenImmersion_fromSpec
  haveI : Etale V.hom := V.prop
  let Wobj : J → Y.Etale := fun j => MorphismProperty.Over.mk ⊤
    (Spec.map (S j) ≫ hU.fromSpec ≫ V.hom) (by haveI := hSet j; infer_instance)
  let W : Jᵒᵖ ⥤ Y.Etale :=
    { obj := fun l => Wobj l.unop
      map := fun {l l'} t => MorphismProperty.Over.homMk (Spec.map (D.map t.unop)) (by
          show Spec.map (D.map t.unop) ≫ Spec.map (S l'.unop) ≫ hU.fromSpec ≫ V.hom =
            Spec.map (S l.unop) ≫ hU.fromSpec ≫ V.hom
          rw [← Category.assoc, ← Spec.map_comp, hSD]) trivial
      map_id := fun l => by
        apply MorphismProperty.Over.Hom.ext
        show Spec.map (D.map (𝟙 l.unop)) = 𝟙 _
        rw [D.map_id, Spec.map_id]
      map_comp := fun {l l' l''} f g => by
        apply MorphismProperty.Over.Hom.ext
        show Spec.map (D.map (g.unop ≫ f.unop)) = Spec.map (D.map f.unop) ≫ Spec.map (D.map g.unop)
        rw [D.map_comp, Spec.map_comp] }
  let g : ∀ l, W.obj l ⟶ V := fun l =>
    MorphismProperty.Over.homMk (Spec.map (S l.unop) ≫ hU.fromSpec) (Category.assoc _ _ _) trivial
  let φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left := fun l => Spec.map (β l.unop)
  let ψ : Spec (.of A) ⟶ V.left := Spec.map (CommRingCat.ofHom σ) ≫ hU.fromSpec
  refine ⟨A, inferInstance, hAh, hAsep, Jᵒᵖ, inferInstance, isCofiltered_op_of_isFiltered J,
    W, g, φ, ψ, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro l
    show IsAffine (Spec (D.obj l.unop))
    infer_instance
  · intro l l' t
    apply MorphismProperty.Over.Hom.ext
    show Spec.map (D.map t.unop) ≫ Spec.map (S l'.unop) ≫ hU.fromSpec =
      Spec.map (S l.unop) ≫ hU.fromSpec
    rw [← Category.assoc, ← Spec.map_comp, hSD]
  · intro l l' t
    show Spec.map (β l.unop) ≫ Spec.map (D.map t.unop) = Spec.map (β l'.unop)
    rw [← Spec.map_comp, hDβ]
  · intro l
    show Spec.map (β l.unop) ≫ Spec.map (S l.unop) ≫ hU.fromSpec =
      Spec.map (CommRingCat.ofHom σ) ≫ hU.fromSpec
    rw [← Category.assoc, ← Spec.map_comp, hSβ]
  · have h5 := s5 _ A K P σ ρ hρloc (hρσ.trans (IsScalarTower.algebraMap_eq _ _ _))
    show hU.fromSpec ((Spec.map (CommRingCat.ofHom σ)) (IsLocalRing.closedPoint A)) = v
    change hU.fromSpec (PrimeSpectrum.comap σ (IsLocalRing.closedPoint A)) = v
    rw [h5]
    exact hPv
  · intro T z hz
    obtain ⟨z₀, hz₀, hu⟩ := hlim T (fun j => z (Opposite.op j)) (fun {j j'} t => hz t.op)
    exact ⟨z₀, fun l => hz₀ l.unop, fun w hw => hu w (fun j => hw (Opposite.op j))⟩

theorem wc_et_baseChange_limit_presentation : ∀ {X' Y' : Scheme.{u}} (h : X' ⟶ Y') [IsProper h] (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ Y'.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ Y'), (∀ l, IsAffine (W.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X') (hZ : XZ ⟶ Spec (.of A)), IsPullback p hZ h a → ∃ π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left, (∀ l, π l ≫ ((W ⋙ wcEtBaseChange h).obj l).hom = p) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l') ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') → ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l) ∧ (∀ l, CompactSpace ((W ⋙ wcEtBaseChange h).obj l).left) ∧ (∀ l, QuasiSeparatedSpace ((W ⋙ wcEtBaseChange h).obj l).left) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((W ⋙ wcEtBaseChange h).map t).left) ∧ CompactSpace XZ ∧ QuasiSeparatedSpace XZ ∧ XZ.IsSeparated :=
by
  intro X' Y' h _ A _ Λ _ _ W φ a hW hφ hφa hlim XZ p hZ hpb

  have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.fst (W.obj l').hom h =
        Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left := by
    intro l l' t
    exact Limits.pullback.lift_fst _ _ _
  have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.snd (W.obj l').hom h =
        Limits.pullback.snd (W.obj l).hom h := by
    intro l l' t
    exact Limits.pullback.lift_snd _ _ _
  have hw : p ≫ h = hZ ≫ a := hpb.w
  have wl : ∀ l, (hZ ≫ φ l) ≫ (W.obj l).hom = p ≫ h := by
    intro l
    rw [Category.assoc, hφa l, hw]

  let π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left := fun l =>
    Limits.pullback.lift (hZ ≫ φ l) p (wl l)
  have P1 : ∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l := fun l =>
    Limits.pullback.lift_fst _ _ _
  have P2 : ∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom h = p := fun l =>
    Limits.pullback.lift_snd _ _ _

  have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l' := by
    intro l l' t
    refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := h) ?_ ?_
    · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.fst (W.obj l').hom h
          = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.fst (W.obj l').hom h) := Category.assoc _ _ _
        _ = π l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := whisker_eq _ (M1 t)
        _ = (π l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left :=
            (Category.assoc _ _ _).symm
        _ = (hZ ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
        _ = hZ ≫ φ l' := by rw [Category.assoc, hφ t]
        _ = π l' ≫ Limits.pullback.fst (W.obj l').hom h := (P1 l').symm
    · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.snd (W.obj l').hom h
          = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.snd (W.obj l').hom h) := Category.assoc _ _ _
        _ = π l ≫ Limits.pullback.snd (W.obj l).hom h := whisker_eq _ (M2 t)
        _ = p := P2 l
        _ = π l' ≫ Limits.pullback.snd (W.obj l').hom h := (P2 l').symm

  have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') →
      ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
    intro T z hz
    have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom h =
        z l' ≫ Limits.pullback.snd (W.obj l').hom h := by
      intro l l' t
      calc z l ≫ Limits.pullback.snd (W.obj l).hom h
          = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.snd (W.obj l').hom h) := (whisker_eq _ (M2 t)).symm
        _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
              Limits.pullback.snd (W.obj l').hom h := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.snd (W.obj l').hom h := eq_whisker (hz t) _
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom h =
        z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := fun l =>
      (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
    have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫
        (W.map t).left = z l' ≫ Limits.pullback.fst (W.obj l').hom h := by
      intro l l' t
      calc (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left
          = z l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := Category.assoc _ _ _
        _ = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.fst (W.obj l').hom h) := whisker_eq _ (M1 t).symm
        _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
              Limits.pullback.fst (W.obj l').hom h := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.fst (W.obj l').hom h := eq_whisker (hz t) _
    obtain ⟨y, hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (W.obj l).hom h) hf
    have hy' : ∀ l, y ≫ φ l = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy
    have hxy : (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h = y ≫ a := by
      calc (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h
          = z l₀ ≫ (Limits.pullback.snd (W.obj l₀).hom h ≫ h) := Category.assoc _ _ _
        _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom h ≫ (W.obj l₀).hom) :=
            whisker_eq _ Limits.pullback.condition.symm
        _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom h) ≫ (W.obj l₀).hom :=
            (Category.assoc _ _ _).symm
        _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
        _ = y ≫ a := by rw [Category.assoc, hφa l₀]
    obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ XZ,
        z₀ ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h ∧ z₀ ≫ hZ = y :=
      ⟨hpb.lift _ y hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
    refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
    · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := h) ?_ ?_
      · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h
            = z₀ ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := Category.assoc _ _ _
          _ = z₀ ≫ (hZ ≫ φ l) := whisker_eq _ (P1 l)
          _ = (z₀ ≫ hZ) ≫ φ l := (Category.assoc _ _ _).symm
          _ = y ≫ φ l := eq_whisker hz₀Z _
          _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy' l
      · calc (z₀ ≫ π l) ≫ Limits.pullback.snd (W.obj l).hom h
            = z₀ ≫ (π l ≫ Limits.pullback.snd (W.obj l).hom h) := Category.assoc _ _ _
          _ = z₀ ≫ p := whisker_eq _ (P2 l)
          _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := hz₀p
          _ = z l ≫ Limits.pullback.snd (W.obj l).hom h := (hX l).symm
    · have e1 : z' ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := by
        calc z' ≫ p = z' ≫ (π l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) :=
              whisker_eq _ (P2 l₀).symm
          _ = (z' ≫ π l₀) ≫ Limits.pullback.snd (W.obj l₀).hom h := (Category.assoc _ _ _).symm
          _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := eq_whisker (hz' l₀) _
      have e2 : z' ≫ hZ = y := by
        apply hyu
        intro l
        calc (z' ≫ hZ) ≫ φ l = z' ≫ (hZ ≫ φ l) := Category.assoc _ _ _
          _ = z' ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := whisker_eq _ (P1 l).symm
          _ = (z' ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h := (Category.assoc _ _ _).symm
          _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := eq_whisker (hz' l) _
      exact hpb.hom_ext (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)

  have hfstP : ∀ l, IsProper (Limits.pullback.fst (W.obj l).hom h) := fun l =>
    MorphismProperty.of_isPullback (P := @IsProper)
      (IsPullback.of_hasPullback (W.obj l).hom h).flip inferInstance
  have hWc : ∀ l, CompactSpace ((W.obj l).left : Scheme.{u}) := fun l => by
    have := hW l
    infer_instance
  have hWq : ∀ l, QuasiSeparatedSpace ((W.obj l).left : Scheme.{u}) := fun l => by
    have := hW l
    infer_instance
  have keyC : ∀ {S S' : Scheme.{u}} (f : S ⟶ S'), IsProper f → CompactSpace S' →
      CompactSpace S := fun f _ _ => QuasiCompact.compactSpace_of_compactSpace f
  have keyQ : ∀ {S S' : Scheme.{u}} (f : S ⟶ S'), IsProper f → QuasiSeparatedSpace S' →
      QuasiSeparatedSpace S := fun f _ _ => quasiSeparatedSpace_of_quasiSeparated f
  have C4 : ∀ l, CompactSpace ((W ⋙ wcEtBaseChange h).obj l).left := fun l =>
    keyC (Limits.pullback.fst (W.obj l).hom h) (hfstP l) (hWc l)
  have C5 : ∀ l, QuasiSeparatedSpace ((W ⋙ wcEtBaseChange h).obj l).left := fun l =>
    keyQ (Limits.pullback.fst (W.obj l).hom h) (hfstP l) (hWq l)

  have C6 : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((W ⋙ wcEtBaseChange h).map t).left := by
    intro l l' t
    have := hW l
    have := hW l'
    have R : IsPullback (Limits.pullback.snd (W.obj l').hom h)
        (Limits.pullback.fst (W.obj l').hom h) h (W.obj l').hom :=
      (IsPullback.of_hasPullback (W.obj l').hom h).flip
    have O : IsPullback (((W ⋙ wcEtBaseChange h).map t).left ≫
        Limits.pullback.snd (W.obj l').hom h) (Limits.pullback.fst (W.obj l).hom h) h
        ((W.map t).left ≫ (W.obj l').hom) := by
      rw [M2 t, MorphismProperty.Over.w (W.map t)]
      exact (IsPullback.of_hasPullback (W.obj l).hom h).flip
    have L : IsPullback ((W ⋙ wcEtBaseChange h).map t).left
        (Limits.pullback.fst (W.obj l).hom h) (Limits.pullback.fst (W.obj l').hom h)
        (W.map t).left :=
      IsPullback.of_right O (M1 t) R
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) L.flip
      (isAffineHom_of_isAffine (W.map t).left)

  have : IsProper hZ := MorphismProperty.of_isPullback (P := @IsProper) hpb inferInstance
  have C7 : CompactSpace XZ := QuasiCompact.compactSpace_of_compactSpace hZ
  have C8 : QuasiSeparatedSpace XZ := quasiSeparatedSpace_of_quasiSeparated hZ
  have C9 : XZ.IsSeparated := by
    have : IsSeparated (Limits.terminal.from (Spec (.of A))) :=
      Scheme.IsSeparated.isSeparated_terminal_from
    refine Scheme.IsSeparated.mk ?_
    rw [← Limits.terminal.comp_from hZ]
    infer_instance
  exact ⟨π, P2, C2, C3, C4, C5, C6, C7, C8, C9⟩

theorem wc_et_finite_push_exact : ∀ {Y Z : Scheme.{u}} (p : Z ⟶ Y) [IsFinite p],
    Limits.PreservesFiniteColimits (wcEtPush p) :=
by
  intro Y Z p _

  have wc_scheme_limit_lfp_factor : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u}) (S : Scheme.{u}) (t : ∀ l, D.obj l ⟶ S), (∀ {l l' : Λ} (k : l ⟶ l'), D.map k ≫ t l' = t l) → ∀ (P : Scheme.{u}) (π : ∀ l, P ⟶ D.obj l), (∀ {l l' : Λ} (k : l ⟶ l'), π l ≫ D.map k = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (k : l ⟶ l'), z l ≫ D.map k = z l') → ∃! z₀ : T ⟶ P, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l)) → (∀ l, QuasiSeparatedSpace (D.obj l)) → (∀ {l l' : Λ} (k : l ⟶ l'), IsAffineHom (D.map k)) → ∀ (E : Scheme.{u}) (f : E ⟶ S), LocallyOfFinitePresentation f → ∀ (l₀ : Λ) (a : P ⟶ E), a ≫ f = π l₀ ≫ t l₀ → ∃ (l : Λ) (b : D.obj l ⟶ E), b ≫ f = t l := by
    intro Λ _ _ D S t ht P π hπ hlim hc hq ha E f hf l₀ a haf
    let tt : D ⟶ (Functor.const Λ).obj S :=
      { app := t
        naturality := fun l l' k => by simp [ht k] }
    let c : Limits.Cone D :=
      { pt := P
        π := { app := π
               naturality := fun l l' k => by simp [hπ k] } }
    have hcl : Limits.IsLimit c := by
      refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
      obtain ⟨z₀, hz₀, huniq⟩ := hlim s.pt s.π.app (fun k => s.w k)
      exact ⟨z₀, hz₀, fun m hm => huniq m hm⟩
    haveI := hc
    haveI := hq
    haveI : ∀ {i j : Λ} (k : i ⟶ j), IsAffineHom (D.map k) := fun k => ha k
    have key : c.π ≫ tt = (Functor.const Λ).map (a ≫ f) := by
      ext l
      change π l ≫ t l = a ≫ f
      rw [haf]
      rw [← hπ (IsCofiltered.minToLeft l l₀), ← hπ (IsCofiltered.minToRight l l₀),
        Category.assoc, Category.assoc, ht, ht]
    obtain ⟨l, g, -, hg⟩ :=
      Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D tt f c hcl a key
    exact ⟨l, g, hg⟩

  have s7 : ∀ {F G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}} (φ : F ⟶ G),
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) φ.hom →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
        (Functor.whiskerLeft (wcEtBaseChange p).op φ.hom) := by
    intro F G φ hφ
    constructor
    intro V σ
    apply wc_etale_jointly_surjective_covers Y V
    intro v

    have hI : Presheaf.imageSieve φ.hom σ ∈
        Scheme.smallEtaleTopology Z ((wcEtBaseChange p).obj V) :=
      Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Z) φ.hom σ
    have hcov : ∀ (x : ((wcEtBaseChange p).obj V).left), ∃ (Y₁ : Z.Etale)
        (f : Y₁ ⟶ (wcEtBaseChange p).obj V) (y : Y₁.left),
        (Presheaf.imageSieve φ.hom σ).arrows f ∧ Etale f.left ∧ f.left y = x := by
      change Presheaf.imageSieve φ.hom σ ∈ Scheme.smallGrothendieckTopology @Etale Z _ at hI
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hI
      exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hI
    choose U u y hu hEt huy using hcov

    obtain ⟨A, _, _, _, Λ, _, _, W, g, φl, ψ, hWaff, hWg, hφW, hφg, hψv, hlim⟩ :=
      wc_et_strict_henselization_prosystem V v

    have ha : ∀ l, φl l ≫ (W.obj l).hom = ψ ≫ V.hom := by
      intro l
      rw [← MorphismProperty.Over.w (g l), ← Category.assoc, hφg]
    obtain ⟨π, -, hπc, hπlim, hcpt, hqs, haff, -, -, -⟩ :=
      wc_et_baseChange_limit_presentation p A Λ W φl (ψ ≫ V.hom) hWaff hφW ha hlim
        (Limits.pullback (ψ ≫ V.hom) p) (Limits.pullback.snd (ψ ≫ V.hom) p)
        (Limits.pullback.fst (ψ ≫ V.hom) p) (IsPullback.of_hasPullback (ψ ≫ V.hom) p).flip

    obtain ⟨n, O, t, c, ht, hdisj, hcov', hsec⟩ :=
      wc_finite_strict_henselian_pieces A (Limits.pullback (ψ ≫ V.hom) p)
        (Limits.pullback.fst (ψ ≫ V.hom) p) inferInstance

    let D : Λ ⥤ Scheme.{u} := W ⋙ wcEtBaseChange p ⋙ Scheme.Etale.forget Z ⋙ Over.forget Z
    let tt : ∀ l, D.obj l ⟶ ((wcEtBaseChange p).obj V).left :=
      fun l => ((wcEtBaseChange p).map (g l)).left
    have htt : ∀ {l l' : Λ} (k : l ⟶ l'), D.map k ≫ tt l' = tt l := by
