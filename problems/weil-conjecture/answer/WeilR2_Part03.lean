      rw [Functor.map_zero, NatTrans.app_zero]
      first | rfl | simp
    rw [m1, hgs, map_add, hgs, m2, add_zero]
    exact hcr Y (ULift.{u+1} ℤ) _ _ _ (ULift.up 1)

theorem wc_et_closed_ext_transfer : ∀ (Y Y₀ : Scheme.{u}) (i : Y₀ ⟶ Y) [IsClosedImmersion i]
    (S : Set Y), Set.range i = Sᶜ → ∀ (m : ℕ), m ≠ 0 →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel (wcEtExtZeroι Y S m)) 1,
    ∃ ξ₀ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 1,
    ∀ (E₀ : Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1})
      (f₀ : (constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E₀)
      (g₀ : E₀ ⟶ (constantSheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w₀ : f₀ ≫ g₀ = 0)
      (hS₀ : (ShortComplex.mk f₀ g₀ w₀).ShortExact), hS₀.extClass = ξ₀ →
    ∀ (V₀ : Scheme.{u}) (p₀ : V₀ ⟶ Y₀) (a₀ : ZMod m → (V₀ ⟶ V₀)) (ht₀ : wcFetTorsor p₀ m a₀)
      (s₀ : E₀.obj.obj (Opposite.op (wcTorsorEt p₀ ht₀.etale))), wcSplitRel ht₀ (𝟙 _) f₀ g₀ s₀ →
    ∀ (V : Scheme.{u}) (p : V ⟶ Y) (a : ZMod m → (V ⟶ V)) (j : V₀ ⟶ V)
      (ht : wcFetTorsor p m a), IsPullback j p₀ p i → (∀ c, a₀ c ≫ j = j ≫ a c) →
    ∃ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (ρ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ G)
      (τ : G ⟶ Limits.cokernel (wcEtExtZeroι Y S m)),
      ρ ≫ τ = Limits.cokernel.π (wcEtExtZeroι Y S m) ∧
      ∃ (E : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (f : G ⟶ E)
        (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0)
        (hS : (ShortComplex.mk f g w).ShortExact),
        hS.extClass.comp (Abelian.Ext.mk₀ τ) (add_zero 1) = ζ ∧
        ∃ s : E.obj.obj (Opposite.op (wcTorsorEt p ht.etale)), wcSplitRel ht ρ f g s :=
by
  intro Y Y₀ i _ S hS m hm
  have hSeq : S = (Set.range i)ᶜ := by rw [hS, compl_compl]
  subst hSeq

  haveI hlim : Limits.PreservesFiniteLimits (wcEtBaseChange i) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtBaseChange i)
      (Scheme.Etale.forget Y₀)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y ⋙ Over.pullback i)))
      inferInstance
  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y₀)
      (wcEtBaseChange i) := by
