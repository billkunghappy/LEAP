      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  obtain ⟨η, hη1⟩ : ∃ η : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((wcEtPush p).obj F) 1,
      η.comp (Abelian.Ext.mk₀ ((wcEtPush p).map (Limits.cokernel.π ιF))) (add_zero 1) =
        ζ₀.comp (Abelian.Ext.mk₀ (Limits.cokernelComparison ιF (wcEtPush p))) (add_zero 1) := by
    refine ⟨(Abelian.Ext.mk₀ (adj.unit.app _)).comp
      (Abelian.Ext.mapExactFunctor (wcEtPush p) η'') (zero_add 1), ?_⟩
    rw [Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega),
      ← Abelian.Ext.mapExactFunctor_mk₀, ← Abelian.Ext.mapExactFunctor_comp, hη'']
    exact he
  have hη2 : η.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((wcEtPush p).map ιF))) (add_zero 1) =
      ζ₀ := by
    apply hcancel
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hκ]
    exact hη1
  refine ⟨η, ?_⟩
  rw [← hc', ← Abelian.Ext.mk₀_comp_mk₀,
    ← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega), hη2, hζ₀,
    Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
    Abelian.Ext.mk₀_comp_mk₀, hcc', Abelian.Ext.comp_mk₀_id]

theorem wc_ff_torsor_descent_core : ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R']
    [Module.FaithfullyFlat R R'] (m : ℕ) [NeZero m] (e : ZMod m → TensorProduct R R' R'),
    wcTorDescCocyc R R' m e →
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (ι : B →ₐ[R] (ZMod m → R'))
      (σ : ZMod m → (B →ₐ[R] B)), Function.Injective ι ∧
      (∀ x, (∃ b, ι b = x) ↔ wcTorDescCond R R' m e x) ∧
      (∀ c b h, ι (σ c b) h = ι b (h + c)) ∧ Function.Bijective (wcTorDescL R R' m B ι) :=
by
  intro R R' _ _ _ _ m _ e he
  obtain ⟨hidem, horth, hsum, hcoc⟩ := he
  let p12 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeLeft
  let p13 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    Algebra.TensorProduct.map (AlgHom.id R R') Algebra.TensorProduct.includeRight
  let p23 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R') :=
    Algebra.TensorProduct.includeRight
  let μ : TensorProduct R R' R' →ₐ[R] R' := Algebra.TensorProduct.lmul' R
  let ψ : TensorProduct R R' (TensorProduct R R' R') →ₐ[R] TensorProduct R R' R' :=
    Algebra.TensorProduct.map (AlgHom.id R R') μ
  have hcoc' : ∀ c, p13 (e c) = ∑ a, p12 (e a) * p23 (e (c - a)) := hcoc
  have hμt : ∀ a b : R', μ (a ⊗ₜ[R] b) = a * b := fun a b =>
    Algebra.TensorProduct.lmul'_apply_tmul a b

  have hψ13 : ∀ z, ψ (p13 z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a b =>
      simp only [ψ, p13, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Algebra.TensorProduct.includeRight_apply, hμt, one_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hψ12 : ∀ z, ψ (p12 z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a b =>
      simp only [ψ, p12, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Algebra.TensorProduct.includeLeft_apply, hμt, mul_one]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hψ23 : ∀ z, ψ (p23 z) = (1 : R') ⊗ₜ[R] μ z := by
    intro z
    simp only [ψ, p23, Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.map_tmul,
      AlgHom.id_apply]
  have hf : ∀ c, μ (e c) = μ (e c) * μ (e 0) := by
    intro c
    have h1 : e c = ∑ a, e a * ((1 : R') ⊗ₜ[R] μ (e (c - a))) := by
      have := congrArg ψ (hcoc' c)
      rw [hψ13, map_sum] at this
      simpa only [map_mul, hψ12, hψ23] using this
    have h2 : e c = e c * ((1 : R') ⊗ₜ[R] μ (e 0)) := by
      calc e c = e c * e c := (hidem c).eq.symm
        _ = e c * ∑ a, e a * ((1 : R') ⊗ₜ[R] μ (e (c - a))) := by rw [← h1]
        _ = ∑ a, e c * (e a * ((1 : R') ⊗ₜ[R] μ (e (c - a)))) := Finset.mul_sum _ _ _
        _ = e c * (e c * ((1 : R') ⊗ₜ[R] μ (e (c - c)))) := by
          refine Finset.sum_eq_single c (fun b _ hb => ?_) (fun hc => absurd (Finset.mem_univ c) hc)
          rw [← mul_assoc, horth c b (Ne.symm hb), zero_mul]
        _ = e c * ((1 : R') ⊗ₜ[R] μ (e 0)) := by rw [sub_self, ← mul_assoc, (hidem c).eq]
    have h3 := congrArg μ h2
    rwa [map_mul, hμt, one_mul] at h3
  have hne : ∀ c, c ≠ 0 → μ (e c) = 0 := by
    intro c hc
    rw [hf c, ← map_mul, horth c 0 hc, map_zero]
  have h0 : μ (e 0) = 1 := by
    have := congrArg μ hsum
    rw [map_sum, map_one, Finset.sum_eq_single (0 : ZMod m) (fun b _ hb => hne b hb)
      (fun h => absurd (Finset.mem_univ _) h)] at this
    exact this
  have hμ : ∀ c, μ (e c) = if c = 0 then 1 else 0 := by
    intro c
    split_ifs with hc
    · rw [hc]; exact h0
    · exact hne c hc

  obtain ⟨S, hS, hsh⟩ : ∃ S : Subalgebra R (ZMod m → R'),
      (∀ v, v ∈ S ↔ wcTorDescCond R R' m e v) ∧
      ∀ (c : ZMod m) (v : ZMod m → R'), v ∈ S → (fun h => v (h + c)) ∈ S := by
    have hmul : ∀ v w : ZMod m → R', wcTorDescCond R R' m e v → wcTorDescCond R R' m e w →
        wcTorDescCond R R' m e (v * w) := by
      intro v w hv hw h
      have h1 : (1 : R') ⊗ₜ[R] (v h * w h) = ((1 : R') ⊗ₜ[R] v h) * ((1 : R') ⊗ₜ[R] w h) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      simp only [Pi.mul_apply]
      rw [h1, hv h, hw h, Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [Finset.sum_eq_single c]
      · rw [mul_mul_mul_comm, (hidem c).eq, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      · intro d _ hdc
        rw [mul_mul_mul_comm, horth c d (Ne.symm hdc), zero_mul]
      · intro hc; exact absurd (Finset.mem_univ c) hc
    have hadd : ∀ v w : ZMod m → R', wcTorDescCond R R' m e v → wcTorDescCond R R' m e w →
        wcTorDescCond R R' m e (v + w) := by
      intro v w hv hw h
      simp only [Pi.add_apply, TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add,
        Finset.sum_add_distrib]
      rw [hv h, hw h]
    have hzero : wcTorDescCond R R' m e 0 := by
      intro h
      simp only [Pi.zero_apply, TensorProduct.tmul_zero, TensorProduct.zero_tmul, mul_zero,
        Finset.sum_const_zero]
    have halg : ∀ r : R, wcTorDescCond R R' m e (algebraMap R (ZMod m → R') r) := by
      intro r h
      simp only [Pi.algebraMap_apply]
      rw [← Finset.sum_mul, hsum, one_mul, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    refine ⟨{ carrier := {v | wcTorDescCond R R' m e v}
              mul_mem' := fun {v w} hv hw => hmul v w hv hw
              add_mem' := fun {v w} hv hw => hadd v w hv hw
              zero_mem' := hzero
              one_mem' := by
                have := halg 1
                rwa [map_one] at this
              algebraMap_mem' := halg }, fun v => Iff.rfl, ?_⟩
    intro c v hv
    change wcTorDescCond R R' m e v at hv
    change wcTorDescCond R R' m e (fun h => v (h + c))
    intro h
    show (1 : R') ⊗ₜ[R] v (h + c) = ∑ d, e d * (v (h + d + c) ⊗ₜ[R] (1 : R'))
    rw [hv (h + c)]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rw [add_right_comm]

  haveI : Module.Flat R R' := inferInstance
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (ZMod m → R') →ₗ[R] (ZMod m → TensorProduct R R' R'),
      ∀ v h, Φ v h = (1 : R') ⊗ₜ[R] v h - ∑ c, e c * (v (h + c) ⊗ₜ[R] (1 : R')) := by
    refine ⟨{ toFun := fun v h => (1 : R') ⊗ₜ[R] v h - ∑ c, e c * (v (h + c) ⊗ₜ[R] (1 : R'))
              map_add' := ?_
              map_smul' := ?_ }, fun v h => rfl⟩
    · intro v w
      funext h
      simp only [Pi.add_apply, TensorProduct.tmul_add, TensorProduct.add_tmul, mul_add,
        Finset.sum_add_distrib]
      abel
    · intro r v
      funext h
      simp only [Pi.smul_apply, RingHom.id_apply, smul_sub, Finset.smul_sum,
        TensorProduct.tmul_smul, ← TensorProduct.smul_tmul', mul_smul_comm]
  have hexact : Function.Exact S.val.toLinearMap Φ := by
    intro v
    rw [Set.mem_range]
    constructor
    · intro hv
      refine ⟨⟨v, (hS v).2 (fun h => ?_)⟩, rfl⟩
      have := congrFun hv h
      rw [hΦ, Pi.zero_apply, sub_eq_zero] at this
      exact this
    · rintro ⟨b, rfl⟩
      funext h
      rw [hΦ, Pi.zero_apply, sub_eq_zero]
      exact (hS _).1 b.2 h
  let P₁ := TensorProduct.piRight R R R' (fun _ : ZMod m => R')
  let P₂ := TensorProduct.piRight R R R' (fun _ : ZMod m => TensorProduct R R' R')
  have hP₁ : ∀ (r : R') (v : ZMod m → R') h, P₁ (r ⊗ₜ[R] v) h = r ⊗ₜ[R] v h := by
    intro r v h
    simp only [P₁, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
  have hP₂ : ∀ (r : R') (v : ZMod m → TensorProduct R R' R') h,
      P₂ (r ⊗ₜ[R] v) h = r ⊗ₜ[R] v h := by
    intro r v h
    simp only [P₂, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
  have hlt := Module.Flat.lTensor_exact R' hexact
  have hli := Module.Flat.lTensor_preserves_injective_linearMap (M := R') S.val.toLinearMap
    Subtype.val_injective
  have hPhi2 : ∀ y h, P₂ (LinearMap.lTensor R' Φ y) h =
      p13 (P₁ y h) - ∑ c, p23 (e c) * p12 (P₁ y (h + c)) := by
    intro y h
    induction y using TensorProduct.induction_on with
    | zero =>
      simp only [map_zero, Pi.zero_apply, mul_zero, Finset.sum_const_zero, sub_zero]
    | tmul r v =>
      simp only [LinearMap.lTensor_tmul, hP₂, hP₁, hΦ, p13, p12, p23,
        Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.tmul_mul_tmul, one_mul, TensorProduct.tmul_sub,
        TensorProduct.tmul_sum]
    | add x y hx hy =>
      simp only [map_add, Pi.add_apply, hx, hy, mul_add, Finset.sum_add_distrib]
      abel
  have hJrange0 : ∀ x : ZMod m → TensorProduct R R' R',
      (∀ h, p13 (x h) = ∑ c, p23 (e c) * p12 (x (h + c))) →
      ∃ z, P₁ (LinearMap.lTensor R' S.val.toLinearMap z) = x := by
    intro x hx
    have h1 : LinearMap.lTensor R' Φ (P₁.symm x) = 0 := by
      apply P₂.injective
      rw [map_zero]
      funext h
      rw [hPhi2, LinearEquiv.apply_symm_apply, Pi.zero_apply, hx h, sub_self]
    obtain ⟨z, hz⟩ := (hlt (P₁.symm x)).1 h1
    exact ⟨z, by rw [hz, LinearEquiv.apply_symm_apply]⟩
  obtain ⟨J, hJdef⟩ : ∃ J : TensorProduct R R' ↥S →ₗ[R] (ZMod m → TensorProduct R R' R'),
      J = P₁.toLinearMap ∘ₗ LinearMap.lTensor R' S.val.toLinearMap := ⟨_, rfl⟩
  have hJt : ∀ (r : R') (b : ↥S) h, J (r ⊗ₜ[R] b) h = r ⊗ₜ[R] (b : ZMod m → R') h := by
    intro r b h
    rw [hJdef]
    show P₁ (LinearMap.lTensor R' S.val.toLinearMap (r ⊗ₜ[R] b)) h = _
    rw [LinearMap.lTensor_tmul]
    exact hP₁ r _ h
  have hJinj : Function.Injective J := by
    rw [hJdef]
    exact P₁.injective.comp hli
  have hJrange : ∀ x : ZMod m → TensorProduct R R' R',
      (∀ h, p13 (x h) = ∑ c, p23 (e c) * p12 (x (h + c))) → ∃ z, J z = x := by
    intro x hx
    obtain ⟨z, hz⟩ := hJrange0 x hx
    exact ⟨z, by rw [hJdef]; exact hz⟩

  have hF1 : ∀ z h, wcTorDescL R R' m (↥S) S.val z h = μ (J z h) := by
    intro z h
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero, Pi.zero_apply]
    | tmul r b =>
      rw [hJt, hμt]
      simp [wcTorDescL, Algebra.TensorProduct.lift_tmul]
    | add x y hx hy => simp only [map_add, Pi.add_apply, hx, hy]
  have hF2 : ∀ z h, J z h = ∑ c, e c * (μ (J z (h + c)) ⊗ₜ[R] (1 : R')) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
      intro h
      simp only [map_zero, Pi.zero_apply, TensorProduct.zero_tmul, mul_zero,
        Finset.sum_const_zero]
    | tmul r b =>
      intro h
      simp only [hJt, hμt]
      have hb : (1 : R') ⊗ₜ[R] (b : ZMod m → R') h =
          ∑ c, e c * ((b : ZMod m → R') (h + c) ⊗ₜ[R] (1 : R')) := (hS _).1 b.2 h
      calc r ⊗ₜ[R] (b : ZMod m → R') h
          = (r ⊗ₜ[R] (1 : R')) * ((1 : R') ⊗ₜ[R] (b : ZMod m → R') h) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        _ = (r ⊗ₜ[R] (1 : R')) * ∑ c, e c * ((b : ZMod m → R') (h + c) ⊗ₜ[R] (1 : R')) := by
            rw [hb]
        _ = ∑ c, e c * ((r * (b : ZMod m → R') (h + c)) ⊗ₜ[R] (1 : R')) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun c _ => ?_)
            rw [mul_left_comm, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    | add x y hx hy =>
      intro h
      simp only [map_add, Pi.add_apply, TensorProduct.add_tmul, mul_add, Finset.sum_add_distrib]
      rw [← hx, ← hy]

  have hreidx : ∀ (A B V : ZMod m → TensorProduct R R' (TensorProduct R R' R')) (h : ZMod m),
      ∑ k, (∑ a, A a * B (k - a)) * V (h + k) = ∑ c, B c * ∑ d, A d * V (h + c + d) := by
    intro A B V h
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    refine Fintype.sum_equiv (Equiv.subRight a) _ _ (fun k => ?_)
    simp only [Equiv.subRight_apply]
    rw [add_assoc, sub_add_cancel]
    ring
  have hU12 : ∀ a : R', p12 (a ⊗ₜ[R] (1 : R')) = a ⊗ₜ[R] (1 : TensorProduct R R' R') := by
    intro a
    simp only [p12, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]
  have hU13 : ∀ a : R', p13 (a ⊗ₜ[R] (1 : R')) = a ⊗ₜ[R] (1 : TensorProduct R R' R') := by
    intro a
    simp only [p13, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one]

  refine ⟨↥S, inferInstance, inferInstance, S.val, fun c => AlgHom.codRestrict
    ((AlgHom.pi fun h => Pi.evalAlgHom R (fun _ => R') (h + c)).comp S.val) S
    (fun b => hsh c b.1 b.2), Subtype.val_injective, fun x => ⟨?_, ?_⟩, fun c b h => rfl,
    ⟨?_, ?_⟩⟩
  · rintro ⟨b, rfl⟩
    exact (hS _).1 b.2
  · intro hx
    exact ⟨⟨x, (hS x).2 hx⟩, rfl⟩
  · intro z z' hzz
    apply hJinj
    funext h
    rw [hF2 z h, hF2 z' h]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [← hF1, ← hF1, hzz]
  · intro u
    obtain ⟨z, hz⟩ := hJrange (fun h => ∑ c, e c * (u (h + c) ⊗ₜ[R] (1 : R'))) (by
      intro h
      simp only [map_sum, map_mul, hU12, hU13, hcoc']
      exact hreidx (fun a => p12 (e a)) (fun a => p23 (e a))
        (fun k => u k ⊗ₜ[R] (1 : TensorProduct R R' R')) h)
    refine ⟨z, funext fun h => ?_⟩
    rw [hF1, hz]
    simp [hμt, hμ]

theorem wc_ff_torsor_descent_props : ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R']
    [Module.FaithfullyFlat R R'] (m : ℕ) [NeZero m] (B : Type u) [CommRing B] [Algebra R B]
    (ι : B →ₐ[R] (ZMod m → R')) (σ : ZMod m → (B →ₐ[R] B)), Function.Injective ι →
    (∀ c b h, ι (σ c b) h = ι b (h + c)) → Function.Bijective (wcTorDescL R R' m B ι) →
    Algebra.Etale R B ∧ Module.Finite R B ∧
      Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
      σ 0 = AlgHom.id R B ∧ (∀ c c', σ (c + c') = (σ c).comp (σ c')) ∧
      Function.Bijective (wcTorDescMu R B m σ) :=
by
  intro R R' _ _ _ _ m _ B _ _ ι σ hinj hshift hL
  classical

  have hσ0 : σ 0 = AlgHom.id R B := by
    ext b
    apply hinj
    funext h
    rw [hshift, add_zero, AlgHom.id_apply]
  have hσadd : ∀ c c', σ (c + c') = (σ c).comp (σ c') := by
    intro c c'
    ext b
    apply hinj
    funext h
    rw [AlgHom.comp_apply, hshift, hshift, hshift, add_assoc]

  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) := by
    intro p
    obtain ⟨q, hq⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := R') p
    let ψ : B →ₐ[R] R' := (Pi.evalAlgHom R (fun _ : ZMod m => R') 0).comp ι
    have hψ : (ψ : B →+* R').comp (algebraMap R B) = algebraMap R R' := ψ.comp_algebraMap
    refine ⟨PrimeSpectrum.comap (ψ : B →+* R') q, ?_⟩
    rw [← hq]
    ext1
    simp only [PrimeSpectrum.comap_asIdeal, Ideal.comap_comap, hψ]

  let e := AlgEquiv.ofBijective (wcTorDescL R R' m B ι) hL
  have hffR : (algebraMap R R').FaithfullyFlat :=
    RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
  haveI : Algebra.Etale R' (TensorProduct R R' B) := Algebra.Etale.of_equiv e.symm
  haveI : Module.Finite R' (TensorProduct R R' B) := Module.Finite.equiv e.symm.toLinearEquiv
  have het : Algebra.Etale R B := RingHom.etale_algebraMap.mp
    (RingHom.CodescendsAlong.algebraMap_tensorProduct _ R R' B
      RingHom.Etale.codescendsAlong_faithfullyFlat hffR
      (RingHom.etale_algebraMap.mpr inferInstance))
  have hfin : Module.Finite R B := RingHom.finite_algebraMap.mp
    (RingHom.CodescendsAlong.algebraMap_tensorProduct _ R R' B
      RingHom.Finite.codescendsAlong_faithfullyFlat hffR
      (RingHom.finite_algebraMap.mpr inferInstance))

  let Le : TensorProduct R R' B ≃ₗ[R] (ZMod m → R') := e.toLinearEquiv.restrictScalars R
  have hLe : ∀ (x : R') (b : B), Le (TensorProduct.tmul R x b) = fun h => x * ι b h := by
    intro x b
    funext h
    simp [Le, e, wcTorDescL, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply]
  let Ψ : TensorProduct R R' (TensorProduct R B B) ≃ₗ[R] (ZMod m → ZMod m → R') :=
    (((TensorProduct.assoc R R' B B).symm.trans (LinearEquiv.rTensor B Le)).trans
      (TensorProduct.piLeft R B (fun _ : ZMod m => R'))).trans
      (LinearEquiv.piCongrRight (fun _ => Le))
  have hΨ : ∀ (x : R') (b b' : B),
      Ψ (TensorProduct.tmul R x (TensorProduct.tmul R b b')) = fun k h => x * ι b k * ι b' h := by
    intro x b b'
    simp only [Ψ, LinearEquiv.trans_apply, TensorProduct.assoc_symm_tmul,
      LinearEquiv.rTensor_tmul, hLe]
    funext k h
    simp [TensorProduct.piLeft, hLe]
  let Φ : TensorProduct R R' (ZMod m → B) ≃ₗ[R] (ZMod m → ZMod m → R') :=
    (TensorProduct.piRight R R R' (fun _ : ZMod m => B)).trans
      (LinearEquiv.piCongrRight fun _ => Le)
  have hΦ : ∀ (x : R') (f : ZMod m → B),
      Φ (TensorProduct.tmul R x f) = fun c h => x * ι (f c) h := by
    intro x f
    funext c h
    simp [Φ, hLe]
  let T : (ZMod m → ZMod m → R') ≃ₗ[R] (ZMod m → ZMod m → R') :=
    { toFun := fun w c h => w (h + c) h
      invFun := fun v k h => v (k - h) h
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      left_inv := fun w => by funext k h; simp
      right_inv := fun v => by funext c h; simp }
  have hT : ∀ w c h, T w c h = w (h + c) h := fun _ _ _ => rfl
  have hμ : ∀ (b b' : B) (c : ZMod m),
      wcTorDescMu R B m σ (TensorProduct.tmul R b b') c = σ c b * b' := by
    intro b b' c
    simp [wcTorDescMu, Algebra.TensorProduct.lift_tmul]
  let μl := (wcTorDescMu R B m σ).toLinearMap
  have key : ∀ z, Φ (LinearMap.lTensor R' μl z) = T (Ψ z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul x y =>
      induction y using TensorProduct.induction_on with
      | zero => simp only [TensorProduct.tmul_zero, map_zero]
      | add y y' hy hy' => simp only [TensorProduct.tmul_add, map_add, hy, hy']
      | tmul b b' =>
        rw [LinearMap.lTensor_tmul, hΦ, hΨ]
        funext c h
        rw [hT]
        change x * ι (wcTorDescMu R B m σ (TensorProduct.tmul R b b') c) h =
          x * ι b (h + c) * ι b' h
        rw [hμ, map_mul, Pi.mul_apply, hshift, mul_assoc]
  have hbij : Function.Bijective (LinearMap.lTensor R' μl) := by
    have hcomp : ⇑(LinearMap.lTensor R' μl) = Φ.symm ∘ T ∘ Ψ := by
      funext z
      simp only [Function.comp]
      rw [← key z, LinearEquiv.symm_apply_apply]
    rw [hcomp]
    exact Φ.symm.bijective.comp (T.bijective.comp Ψ.bijective)
  have hmu : Function.Bijective (wcTorDescMu R B m σ) :=
    (Module.FaithfullyFlat.lTensor_bijective_iff_bijective R R' μl).mp hbij
  exact ⟨het, hfin, hsurj, hσ0, hσadd, hmu⟩

theorem wc_fet_torsor_of_ring : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (m : ℕ)
    [NeZero m] (σ : ZMod m → (B →ₐ[R] B)), Algebra.Etale R B → Module.Finite R B →
    Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) → σ 0 = AlgHom.id R B →
    (∀ c c', σ (c + c') = (σ c).comp (σ c')) → Function.Bijective (wcTorDescMu R B m σ) →
    wcFetTorsor (Spec.map (CommRingCat.ofHom (algebraMap R B))) m
      (fun c => Spec.map (CommRingCat.ofHom (σ c).toRingHom)) :=
by
  intro R B _ _ _ m _ σ het hfin hsurj h0 hadd hmu
  classical

  have hact : ∀ c, Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap R B)) =
      Spec.map (CommRingCat.ofHom (algebraMap R B)) := by
    intro c
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact (σ c).commutes x

  let e : TensorProduct R B B ≃+* (ZMod m → B) := RingEquiv.ofBijective (wcTorDescMu R B m σ) hmu
  haveI hMiso : IsIso (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) :=
    ⟨⟨CommRingCat.ofHom e.symm.toRingHom,
      by apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact e.symm_apply_apply x,
      by apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact e.apply_symm_apply y⟩⟩

  let ρ : (ZMod m → B) ≃+* (ULift.{u} (ZMod m) → B) :=
    { toFun := fun f i => f i.down
      invFun := fun g c => g ⟨c⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }
  haveI hρiso : IsIso (CommRingCat.ofHom ρ.toRingHom) :=
    ⟨⟨CommRingCat.ofHom ρ.symm.toRingHom,
      by apply CommRingCat.hom_ext; apply RingHom.ext; intro x; exact ρ.symm_apply_apply x,
      by apply CommRingCat.hom_ext; apply RingHom.ext; intro y; exact ρ.apply_symm_apply y⟩⟩
  have hjfac : ∀ c : ZMod m,
      Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) =
      Limits.Sigma.ι (fun _ : ULift.{u} (ZMod m) => Spec (CommRingCat.of B)) (ULift.up c) ≫
        sigmaSpec (fun _ : ULift.{u} (ZMod m) => CommRingCat.of B) ≫
        Spec.map (CommRingCat.ofHom ρ.toRingHom) := by
    intro c
    rw [← Category.assoc, ι_sigmaSpec, ← Spec.map_comp]
    rfl

  have hgraph0 : ∀ c (h : Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap R B)) =
      𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap R B))),
      Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ c).toRingHom))
        (𝟙 (Spec (CommRingCat.of B))) h =
      Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) ≫
        (Spec.map (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) ≫
          (pullbackSpecIso R B B).inv) := by
    intro c h
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst, Category.assoc, Category.assoc, pullbackSpecIso_inv_fst,
        ← Spec.map_comp, ← Spec.map_comp]
      congr 1
      ext x
      simp [wcTorDescMu]
    · rw [Limits.pullback.lift_snd, Category.assoc, Category.assoc, pullbackSpecIso_inv_snd,
        ← Spec.map_comp, ← Spec.map_comp, ← Spec.map_id (CommRingCat.of B)]
      congr 1
      ext x
      simp [wcTorDescMu]
  obtain ⟨j, hjdef⟩ : ∃ j : ZMod m → (Spec (CommRingCat.of B) ⟶
      Spec (CommRingCat.of (ZMod m → B))),
      ∀ c, j c = Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod m => B) c)) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : Spec (CommRingCat.of (ZMod m → B)) ⟶
      Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R B)))
        (Spec.map (CommRingCat.ofHom (algebraMap R B))),
      Φ = Spec.map (CommRingCat.ofHom (wcTorDescMu R B m σ).toRingHom) ≫
        (pullbackSpecIso R B B).inv := ⟨_, rfl⟩
  have hgraph : ∀ c (h : Spec.map (CommRingCat.ofHom (σ c).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap R B)) =
      𝟙 (Spec (CommRingCat.of B)) ≫ Spec.map (CommRingCat.ofHom (algebraMap R B))),
      Limits.pullback.lift (Spec.map (CommRingCat.ofHom (σ c).toRingHom))
        (𝟙 (Spec (CommRingCat.of B))) h = j c ≫ Φ := by
    intro c h
    rw [hjdef, hΦdef]
    exact hgraph0 c h
  haveI hΦiso : IsIso Φ := by rw [hΦdef]; infer_instance
  have hjopen : ∀ c, IsOpenImmersion (j c) := by
    intro c
    rw [hjdef, hjfac c]
    infer_instance
  have hjpt : ∀ c x, j c x = PrimeSpectrum.sigmaToPi (fun _ : ZMod m => B) ⟨c, x⟩ := by
    intro c x
    rw [hjdef]
    rfl
  have hΦinj : Function.Injective Φ := by
    intro a b hab
    apply (Scheme.Hom.homeomorph Φ).injective
    rw [Scheme.Hom.homeomorph_apply, Scheme.Hom.homeomorph_apply]
    exact hab
  have hΦsurj : Function.Surjective Φ := by
    intro z
    obtain ⟨w, hw⟩ := (Scheme.Hom.homeomorph Φ).surjective z
    exact ⟨w, by rw [← Scheme.Hom.homeomorph_apply]; exact hw⟩
  have hbij := PrimeSpectrum.sigmaToPi_bijective (fun _ : ZMod m => B)
  refine ⟨?_, ?_, ?_, hact, ?_, ?_, ?_, ?_, ?_⟩
  · rw [IsFinite.SpecMap_iff]
    exact RingHom.finite_algebraMap.mpr hfin
  · rw [HasRingHomProperty.Spec_iff (P := @Etale)]
    exact RingHom.etale_algebraMap.mpr het
  · exact Set.range_eq_univ.mpr fun x => hsurj x
  · show Spec.map (CommRingCat.ofHom (σ 0).toRingHom) = 𝟙 _
    rw [h0]
    exact Spec.map_id _
  · intro c c'
    show Spec.map (CommRingCat.ofHom (σ (c + c')).toRingHom) =
      Spec.map (CommRingCat.ofHom (σ c').toRingHom) ≫ Spec.map (CommRingCat.ofHom (σ c).toRingHom)
    rw [← Spec.map_comp, add_comm, hadd]
    rfl
  · intro c
    rw [hgraph]
    haveI := hjopen c
    infer_instance
  · intro c c' hcc'
    show Disjoint _ _
    rw [hgraph, hgraph, Set.disjoint_left]
    rintro _ ⟨x, rfl⟩ ⟨y, hy⟩
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hy
    have h1 := hΦinj hy
    rw [hjpt, hjpt] at h1
    have h2 := congrArg Sigma.fst (hbij.1 h1)
    exact hcc' h2.symm
  · rw [Set.eq_univ_iff_forall]
    intro z
    obtain ⟨w, rfl⟩ := hΦsurj z
    obtain ⟨⟨c, x⟩, hx⟩ := hbij.2 w
    refine Set.mem_iUnion.mpr ⟨c, x, ?_⟩
    rw [hgraph]
    show Φ (j c x) = Φ w
    exact congrArg Φ ((hjpt c x).trans hx)

theorem wc_fet_split_unique : ∀ (X : Scheme.{u}) (m : ℕ) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E) (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact → ∀ (U : X.Opens) (V : Scheme.{u}) (pU : V ⟶ (U : Scheme.{u})) (a : ZMod m → (V ⟶ V)) (ht : wcFetTorsor pU m a) (hE : Etale (pU ≫ U.ι)) (s : E.obj.obj (Opposite.op (wcTorsorEt (pU ≫ U.ι) hE))), wcTorLocRel f g U ht hE s → ∀ (W : X.Etale) (φ₁ φ₂ : W ⟶ wcTorsorEt (pU ≫ U.ι) hE), (E.obj.map φ₁.op).hom s = (E.obj.map φ₂.op).hom s → φ₁ = φ₂ :=
by
  intro X m E f g w hS U V pU a ht hE s hrel W φ₁ φ₂ h12

  have hmap : ∀ {A B C : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map (a₁ ≫ b₁).op).hom x = (E.obj.map a₁.op).hom ((E.obj.map b₁.op).hom x) := by
    intro A B C a₁ b₁ x
    rw [op_comp, Functor.map_comp]
    rfl

  have hdict : ∀ (V₀ : X.Etale) (R : Sieve V₀), R ∈ Scheme.smallEtaleTopology X V₀ ↔
      ∀ x : V₀.left, ∃ (W₀ : X.Etale) (g₀ : W₀ ⟶ V₀) (y : W₀.left),
        R.arrows g₀ ∧ Etale g₀.left ∧ g₀.left y = x := by
    intro V₀ R
    change R ∈ Scheme.smallGrothendieckTopology @Etale X V₀ ↔ _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact @Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V₀ R

  have hconst0 : ∀ (Y : X.Etale) (c : ULift.{u+1} (ZMod m)),
      ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op Y)).hom c = 0 →
      c = 0 ∨ IsEmpty Y.left := by
    intro Y c hc
    by_cases hc0 : c = 0
    · exact Or.inl hc0
    · right
      refine ⟨fun x => hc0 ?_⟩
      have hτ : ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op Y)).hom c =
          ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op Y)).hom 0 := by
        rw [hc, map_zero]
      have hEq := Presheaf.IsLocallyInjective.equalizerSieve_mem
        (J := Scheme.smallEtaleTopology X)
        (φ := toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (X := Opposite.op Y) c 0 (by exact hτ)
      obtain ⟨W', g', y, hg, -, -⟩ := (hdict Y _).mp hEq x
      rw [Presheaf.equalizerSieve_apply] at hg
      simpa using hg

  haveI : Mono f := hS.mono_f
  have hfinj : ∀ (Y : X.Etale), Function.Injective (f.hom.app (Opposite.op Y)) := fun Y =>
    (AddCommGrpCat.mono_iff_injective (f.hom.app (Opposite.op Y))).mp
      (Functor.map_mono (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op Y)) f)

  have hnat : ∀ (V₁ T₁ : X.Etale) (e : T₁ ⟶ V₁) (c : ULift.{u+1} (ZMod m)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e.op).hom
        (wcConstSec X (ULift.{u+1} (ZMod m)) V₁ c) = wcConstSec X (ULift.{u+1} (ZMod m)) T₁ c := by
    intro V₁ T₁ e c
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) e.op c).symm

  have hcancel : ∀ (k₁ k₂ : W.left ⟶ V), k₁ ≫ pU ≫ U.ι = k₂ ≫ pU ≫ U.ι → k₁ ≫ pU = k₂ ≫ pU := by
    intro k₁ k₂ h
    rw [← cancel_mono U.ι, Category.assoc, Category.assoc]
    exact h
  have hp : φ₁.left ≫ pU = φ₂.left ≫ pU :=
    hcancel _ _ ((MorphismProperty.Over.w φ₁).trans (MorphismProperty.Over.w φ₂).symm)

  have hlocal : ∀ (k₁ k₂ : W.left ⟶ V), k₁ ≫ pU = k₂ ≫ pU →
      ∃ O : ZMod m → W.left.Opens, (∀ z : W.left, ∃ c, z ∈ O c) ∧
        ∀ c, (O c).ι ≫ k₁ = (O c).ι ≫ k₂ ≫ a c := by
    intro k₁ k₂ hk
    let γ : ZMod m → (V ⟶ Limits.pullback pU pU) := fun c =>
      Limits.pullback.lift (a c) (𝟙 V) ((ht.act_p c).trans (Category.id_comp pU).symm)
    have hγ : ∀ c, IsOpenImmersion (γ c) := fun c => ht.graph_open c
    let κ : W.left ⟶ Limits.pullback pU pU := Limits.pullback.lift k₁ k₂ hk
    let O : ZMod m → W.left.Opens := fun c =>
      ⟨κ ⁻¹' Set.range (γ c), by
        haveI := hγ c
        exact (γ c).isOpenEmbedding.isOpen_range.preimage κ.continuous⟩
    refine ⟨O, ?_, ?_⟩
    · intro z
      have hz : κ z ∈ (⋃ c, Set.range (γ c)) := by
        rw [show (⋃ c, Set.range (γ c)) = Set.univ from ht.graph_cover]
        exact Set.mem_univ _
      obtain ⟨c, hc⟩ := Set.mem_iUnion.mp hz
      exact ⟨c, hc⟩
    · intro c
      haveI := hγ c
      have hsub : Set.range ((O c).ι ≫ κ) ⊆ Set.range (γ c) := by
        rintro _ ⟨x, rfl⟩
        rw [Scheme.Hom.comp_apply]
        exact x.2
      let ℓ := IsOpenImmersion.lift (γ c) ((O c).ι ≫ κ) hsub
      have hℓ : ℓ ≫ γ c = (O c).ι ≫ κ := IsOpenImmersion.lift_fac _ _ _
      have h1 : ℓ ≫ a c = (O c).ι ≫ k₁ := by
        have := congrArg (· ≫ Limits.pullback.fst pU pU) hℓ
        simp only [Category.assoc, γ, κ, Limits.pullback.lift_fst] at this
        exact this
      have h2 : ℓ = (O c).ι ≫ k₂ := by
        have := congrArg (· ≫ Limits.pullback.snd pU pU) hℓ
        simp only [Category.assoc, γ, κ, Limits.pullback.lift_snd, Category.comp_id] at this
        exact this
      rw [← h1, h2, Category.assoc]

  have hglue : ∀ (k₁ k₂ : W.left ⟶ V) (O : ZMod m → W.left.Opens), (∀ z : W.left, ∃ c, z ∈ O c) →
      (∀ c, (O c).ι ≫ k₁ = (O c).ι ≫ k₂ ≫ a c) → (∀ c, c = 0 ∨ IsEmpty (O c : Scheme.{u})) →
      k₁ = k₂ := by
    intro k₁ k₂ O hcov hO hpiece
    have hcov' : ∀ z : W.left, ∃ c, ∃ y : (O c : Scheme.{u}), (O c).ι y = z := by
      intro z
      obtain ⟨c, hc⟩ := hcov z
      exact ⟨c, ⟨z, hc⟩, rfl⟩
    refine Scheme.Cover.hom_ext (Scheme.Cover.mkOfCovers (ZMod m) (fun c => (O c : Scheme.{u}))
      (fun c => (O c).ι) hcov') _ _ ?_
    intro c
    show (O c).ι ≫ k₁ = (O c).ι ≫ k₂
    rcases hpiece c with h | h
    · subst h
      rw [hO 0, ht.act_zero, Category.comp_id]
    · haveI := h
      exact AlgebraicGeometry.isInitialOfIsEmpty.hom_ext _ _
  obtain ⟨O, hcov, hO⟩ := hlocal φ₁.left φ₂.left hp

  haveI hWet : Etale W.hom := W.prop
  have hpiece : ∀ c, c = 0 ∨ IsEmpty (O c : Scheme.{u}) := by
    intro c
    let Wc : X.Etale := MorphismProperty.Over.mk ⊤ ((O c).ι ≫ W.hom) inferInstance
    let ρ : Wc ⟶ W := MorphismProperty.Over.homMk (O c).ι rfl trivial
    let act : wcTorsorEt (pU ≫ U.ι) hE ⟶ wcTorsorEt (pU ≫ U.ι) hE :=
      wcTorsorAct (pU ≫ U.ι) hE (a c) (by rw [← Category.assoc, ht.act_p c])
    have hfac : ρ ≫ φ₁ = (ρ ≫ φ₂) ≫ act := by
      apply MorphismProperty.Over.Hom.ext
      exact (hO c).trans (Category.assoc _ _ _).symm
    have hs1 : (E.obj.map (ρ ≫ φ₁).op).hom s = (E.obj.map (ρ ≫ φ₂).op).hom s := by
      rw [hmap, hmap, h12]
    have hs2 : (E.obj.map (ρ ≫ φ₁).op).hom s = (E.obj.map (ρ ≫ φ₂).op).hom s +
        (f.hom.app (Opposite.op Wc)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) Wc (ULift.up c)) := by
      rw [hfac, hmap, hrel.2 c, map_add]
      congr 1
      rw [← hnat (wcTorsorEt (pU ≫ U.ι) hE) Wc (ρ ≫ φ₂) (ULift.up c)]
      exact (NatTrans.naturality_apply f.hom (ρ ≫ φ₂).op _).symm
    have hf0 : (f.hom.app (Opposite.op Wc)).hom
        (wcConstSec X (ULift.{u+1} (ZMod m)) Wc (ULift.up c)) = 0 :=
      add_eq_left.mp (hs2.symm.trans hs1)
    have hc0 : wcConstSec X (ULift.{u+1} (ZMod m)) Wc (ULift.up c) = 0 := by
      apply hfinj Wc
      rw [map_zero]
      exact hf0
    rcases hconst0 Wc (ULift.up c) hc0 with h | h
    · left
      exact congrArg ULift.down h
    · right
      exact h

  exact MorphismProperty.Over.Hom.ext (hglue φ₁.left φ₂.left O hcov hO hpiece)

theorem wc_et_const_sheaf_local_form : ∀ (Z : Scheme.{u}) (m : ℕ), (∀ (V : Z.Etale) (a : ULift.{u+1} (ZMod m)), ((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a = 0 → a = 0 ∨ IsEmpty V.left) ∧ (∀ (U : Z.Etale) (s : ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op U)) (x : U.left), ∃ (O : Set U.left) (a : ULift.{u+1} (ZMod m)), IsOpen O ∧ x ∈ O ∧ ∀ (V : Z.Etale) (e : V ⟶ U), Set.range e.left ⊆ O → (((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e.op).hom s = ((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a) :=
by
  intro Z m

  have hdict : ∀ (V : Z.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Z V ↔
      ∀ x : V.left, ∃ (W : Z.Etale) (g : W ⟶ V) (y : W.left),
        R.arrows g ∧ Etale g.left ∧ g.left y = x := by
    intro V R
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z V ↔ _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact @Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R

  have hnat : ∀ (V T : Z.Etale) (g : T ⟶ V) (a : ULift.{u+1} (ZMod m)),
      (((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map g.op).hom
        (((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a) =
      ((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op T)).hom a := by
    intro V T g a
    have h := congrArg (fun φ => φ.hom a) ((toSheafify (Scheme.smallEtaleTopology Z)
      ((Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).naturality g.op)
    simp only [Functor.const_obj_map, AddCommGrpCat.hom_comp,
      AddMonoidHom.coe_comp, Function.comp_apply] at h
    exact h.symm

  have hfun : ∀ (U V T : Z.Etale) (e : V ⟶ U) (g : T ⟶ V)
      (s : ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op U)),
      (((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map g.op).hom
        ((((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e.op).hom s) =
      (((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map (g ≫ e).op).hom s := by
    intro U V T e g s
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  refine ⟨?_, ?_⟩
  ·
    intro V a ha
    by_cases ha0 : a = 0
    · exact Or.inl ha0
    · right
      refine ⟨fun x => ha0 ?_⟩
      have hτ : ((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a =
          ((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom 0 := by
        rw [ha, map_zero]
      have hE := Presheaf.IsLocallyInjective.equalizerSieve_mem
        (J := Scheme.smallEtaleTopology Z)
        (φ := toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (X := Opposite.op V) a 0 (by exact hτ)
      obtain ⟨W, g, y, hg, -, -⟩ := (hdict V _).mp hE x
      rw [Presheaf.equalizerSieve_apply] at hg
      simpa using hg
  ·
    intro U s x
    have hI : Presheaf.imageSieve (toSheafify (Scheme.smallEtaleTopology Z)
        ((Functor.const (Z.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) s ∈
        Scheme.smallEtaleTopology Z U :=
      Presheaf.IsLocallySurjective.imageSieve_mem _
    obtain ⟨W₀, f, y, hf, -, hy⟩ := (hdict U _).mp hI x
    obtain ⟨a, ha⟩ := hf
    have ha' : (((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map f.op).hom s =
        ((toSheafify (Scheme.smallEtaleTopology Z) ((Functor.const (Z.Etale)ᵒᵖ).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op W₀)).hom a := ha.symm
    refine ⟨Set.range f.left, a, (Scheme.Hom.isOpenMap f.left).isOpen_range, ⟨y, hy⟩, ?_⟩
    intro V e he
    let S : Sieve V :=
      { arrows := fun T g' => ∃ h' : T ⟶ W₀, h' ≫ f = g' ≫ e
        downward_closed := by
          rintro T T' g' ⟨h', hh'⟩ k
          exact ⟨k ≫ h', by rw [Category.assoc, hh', Category.assoc]⟩ }
    have hS : S ∈ Scheme.smallEtaleTopology Z V := by
      refine (hdict V S).mpr ?_
      intro w
      obtain ⟨y', hy'⟩ := he ⟨w, rfl⟩
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := e.left) (g := f.left)
        w y' hy'.symm
      let W' : Z.Etale := MorphismProperty.Over.mk ⊤
        (Limits.pullback.fst e.left f.left ≫ V.hom) inferInstance
      let g : W' ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst e.left f.left)
        (by rfl) (by trivial)
      have htri : Limits.pullback.snd e.left f.left ≫ W₀.hom = W'.hom := by
        show _ = Limits.pullback.fst e.left f.left ≫ V.hom
        rw [← MorphismProperty.Over.w f, ← MorphismProperty.Over.w e]
        exact (Limits.pullback.condition_assoc _).symm
      let h : W' ⟶ W₀ := MorphismProperty.Over.homMk (Limits.pullback.snd e.left f.left)
        htri (by trivial)
      refine ⟨W', g, z, ⟨h, ?_⟩, inferInstance, hz⟩
      apply MorphismProperty.Over.Hom.ext
      exact (Limits.pullback.condition (f := e.left) (g := f.left)).symm
    apply Sheaf.isSeparated _ V S hS
    rintro T g' ⟨h', hh'⟩
    have e1 := hfun U V T e g' s
    have e2 := hfun U W₀ T f h' s
    have e3 := hnat W₀ T h' a
    have e4 := hnat V T g' a
    rw [← hh'] at e1
    exact e1.trans (e2.symm.trans ((congrArg
      (⇑(((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map h'.op).hom) ha').trans
      (e3.trans e4.symm)))

theorem wc_fet_split_translate : ∀ (X : Scheme.{u}) (m : ℕ) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E) (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0), (ShortComplex.mk f g w).ShortExact → ∀ (U : X.Opens) (V : Scheme.{u}) (pU : V ⟶ (U : Scheme.{u})) (a : ZMod m → (V ⟶ V)) (ht : wcFetTorsor pU m a) (hE : Etale (pU ≫ U.ι)) (s : E.obj.obj (Opposite.op (wcTorsorEt (pU ≫ U.ι) hE))), wcTorLocRel f g U ht hE s → ∀ (W : X.Etale) (ψ : W ⟶ wcTorsorEt (pU ≫ U.ι) hE) (t : E.obj.obj (Opposite.op W)), (g.hom.app (Opposite.op W)).hom t = wcConstSec X (ULift.{u+1} ℤ) W (ULift.up 1) → ∃ φ : W ⟶ wcTorsorEt (pU ≫ U.ι) hE, (E.obj.map φ.op).hom s = t :=
by
  intro X m E f g w hS U V pU a ht hE s hrel W ψ t ht1
  classical

  have hmap : ∀ {A B C : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map (a₁ ≫ b₁).op).hom x = (E.obj.map a₁.op).hom ((E.obj.map b₁.op).hom x) := by
    intro A B C a₁ b₁ x
    rw [op_comp, Functor.map_comp]
    rfl

  have hconstZ : ∀ (V₁ V₂ : X.Etale) (e : V₂ ⟶ V₁) (x : ULift.{u+1} ℤ),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map e.op).hom (wcConstSec X (ULift.{u+1} ℤ) V₁ x) =
        wcConstSec X (ULift.{u+1} ℤ) V₂ x := by
    intro V₁ V₂ e x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) e.op x).symm
  have hconstM : ∀ (V₁ V₂ : X.Etale) (e : V₂ ⟶ V₁) (x : ULift.{u+1} (ZMod m)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e.op).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) V₁ x) =
        wcConstSec X (ULift.{u+1} (ZMod m)) V₂ x := by
    intro V₁ V₂ e x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) e.op x).symm

  have hfnat : ∀ {A B : X.Etale} (e : A ⟶ B)
      (y : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op B)),
      (E.obj.map e.op).hom ((f.hom.app (Opposite.op B)).hom y) =
        (f.hom.app (Opposite.op A)).hom
          ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e.op).hom y) := by
    intro A B e y
    exact (NatTrans.naturality_apply f.hom e.op y).symm

  have hgψ : (g.hom.app (Opposite.op W)).hom ((E.obj.map ψ.op).hom s) =
      wcConstSec X (ULift.{u+1} ℤ) W (ULift.up 1) := by
    calc (g.hom.app (Opposite.op W)).hom ((E.obj.map ψ.op).hom s)
        = (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map ψ.op).hom
            ((g.hom.app (Opposite.op (wcTorsorEt (pU ≫ U.ι) hE))).hom s) :=
          NatTrans.naturality_apply g.hom ψ.op s
      _ = wcConstSec X (ULift.{u+1} ℤ) W (ULift.up 1) := by
          rw [hrel.1]; exact hconstZ _ W ψ (ULift.up 1)
  have hdiff : (g.hom.app (Opposite.op W)).hom (t - (E.obj.map ψ.op).hom s) = 0 := by
    rw [map_sub, ht1, hgψ, sub_self]
  obtain ⟨l, hl⟩ := (wc_sheaf_ses_sectionwise (Scheme.smallEtaleTopology X) f g w hS).2 W _ hdiff
  have hl' : (f.hom.app (Opposite.op W)).hom l = t - (E.obj.map ψ.op).hom s := hl
  have ht_eq : t = (E.obj.map ψ.op).hom s + (f.hom.app (Opposite.op W)).hom l := by
    rw [hl']; abel

  have hLF := wc_et_const_sheaf_local_form X m
  choose Oset cst hOopen hxO hloc using fun x : W.left => hLF.2 W l x
  let O : W.left → W.left.Opens := fun x => ⟨Oset x, hOopen x⟩
  have hcompat : ∀ x y : W.left, (∃ z, z ∈ Oset x ∧ z ∈ Oset y) → cst x = cst y := by
    rintro x y ⟨z, hzx, hzy⟩
    let Q : W.left.Opens := O x ⊓ O y
    have hrx : Set.range (wcEtOpenι X W Q).left ⊆ Oset x := by
      change Set.range Q.ι ⊆ Oset x
      rw [Scheme.Opens.range_ι]
      intro p hp
      exact (TopologicalSpace.Opens.mem_inf.mp hp).1
    have hry : Set.range (wcEtOpenι X W Q).left ⊆ Oset y := by
      change Set.range Q.ι ⊆ Oset y
      rw [Scheme.Opens.range_ι]
      intro p hp
      exact (TopologicalSpace.Opens.mem_inf.mp hp).2
    have h1 := hloc x (wcEtOpen X W Q) (wcEtOpenι X W Q) hrx
    have h2 := hloc y (wcEtOpen X W Q) (wcEtOpenι X W Q) hry
    have h0 : ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op (wcEtOpen X W Q))).hom
          (cst x - cst y) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact h1.symm.trans h2
    rcases hLF.1 (wcEtOpen X W Q) (cst x - cst y) h0 with h | h
    · exact sub_eq_zero.mp h
    · have hne : Nonempty (Q : Scheme.{u}) :=
        (Scheme.Opens.nonempty_iff Q).mpr ⟨z, TopologicalSpace.Opens.mem_inf.mpr ⟨hzx, hzy⟩⟩
      have h' : IsEmpty (Q : Scheme.{u}) := h
      exact (h'.false hne.some).elim

  have hcov : TopologicalSpace.IsOpenCover O := by
    apply TopologicalSpace.IsOpenCover.mk
    rw [eq_top_iff]
    intro z _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨z, hxO z⟩
  let 𝒰 := W.left.openCoverOfIsOpenCover O hcov
  have hrange : ∀ i : W.left, Set.range (𝒰.f i) = Oset i := by
    intro i
    rw [Scheme.openCoverOfIsOpenCover_f]
    exact Scheme.Opens.range_ι (O i)
  have hpre : ∀ c, a c ≫ pU ≫ U.ι = pU ≫ U.ι := by
    intro c
    rw [← Category.assoc, ht.act_p]
  let gl : ∀ x : 𝒰.I₀, 𝒰.X x ⟶ V := fun x => 𝒰.f x ≫ ψ.left ≫ a (cst x).down
  have hagree : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ gl x =
      Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ gl y := by
    intro x y
    by_cases hP : Nonempty ↥(Limits.pullback (𝒰.f x) (𝒰.f y) : Scheme.{u})
    · obtain ⟨p⟩ := hP
      have hcond : (Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ 𝒰.f x) p =
          (Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ 𝒰.f y) p := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hcond
      have hc : cst x = cst y := by
        apply hcompat x y
        refine ⟨𝒰.f x (Limits.pullback.fst (𝒰.f x) (𝒰.f y) p), ?_, ?_⟩
        · exact (hrange x).subset ⟨_, rfl⟩
        · rw [hcond]; exact (hrange y).subset ⟨_, rfl⟩
      have hc' : (cst x).down = (cst y).down := congrArg ULift.down hc
      change Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ 𝒰.f x ≫ ψ.left ≫ a (cst x).down =
        Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ 𝒰.f y ≫ ψ.left ≫ a (cst y).down
      rw [hc']
      exact Limits.pullback.condition_assoc (ψ.left ≫ a (cst y).down)
    · haveI : IsEmpty ↥(Limits.pullback (𝒰.f x) (𝒰.f y) : Scheme.{u}) := not_nonempty_iff.mp hP
      exact isInitialOfIsEmpty.hom_ext _ _
  let k : W.left ⟶ V := Scheme.Cover.glueMorphisms 𝒰 gl hagree
  have hk : ∀ x : 𝒰.I₀, 𝒰.f x ≫ k = gl x := Scheme.Cover.ι_glueMorphisms 𝒰 gl hagree

  have hkX : k ≫ pU ≫ U.ι = W.hom := by
    have h1 : k ≫ pU ≫ U.ι = ψ.left ≫ pU ≫ U.ι := by
      apply Scheme.Cover.hom_ext 𝒰
      intro x
      rw [← Category.assoc, hk x]
      change (𝒰.f x ≫ ψ.left ≫ a (cst x).down) ≫ pU ≫ U.ι = 𝒰.f x ≫ ψ.left ≫ pU ≫ U.ι
      calc (𝒰.f x ≫ ψ.left ≫ a (cst x).down) ≫ pU ≫ U.ι
          = 𝒰.f x ≫ ((ψ.left ≫ a (cst x).down) ≫ pU ≫ U.ι) := Category.assoc _ _ _
        _ = 𝒰.f x ≫ (ψ.left ≫ (a (cst x).down ≫ pU ≫ U.ι)) :=
            congrArg (𝒰.f x ≫ ·) (Category.assoc _ _ _)
        _ = 𝒰.f x ≫ ψ.left ≫ pU ≫ U.ι :=
            congrArg (fun h => 𝒰.f x ≫ ψ.left ≫ h) (hpre _)
    rw [h1]
    exact MorphismProperty.Over.w ψ
  let φ : W ⟶ wcTorsorEt (pU ≫ U.ι) hE := MorphismProperty.Over.homMk k hkX trivial

  have key : ∀ (V' : X.Etale) (e : V' ⟶ W) (i : W.left), Set.range e.left ⊆ Oset i →
      (E.obj.map e.op).hom ((E.obj.map φ.op).hom s) = (E.obj.map e.op).hom t := by
    intro V' e i hi
    have hact : a (cst i).down ≫ pU ≫ U.ι = pU ≫ U.ι := hpre _
    have he : e ≫ φ = (e ≫ ψ) ≫ wcTorsorAct (pU ≫ U.ι) hE (a (cst i).down) hact := by
      apply MorphismProperty.Over.Hom.ext
      change e.left ≫ k = (e.left ≫ ψ.left) ≫ a (cst i).down
      haveI : IsOpenImmersion (𝒰.f i) := 𝒰.map_prop i
      let ℓ := IsOpenImmersion.lift (𝒰.f i) e.left (hi.trans (hrange i).symm.subset)
      have hℓ : ℓ ≫ 𝒰.f i = e.left := IsOpenImmersion.lift_fac _ _ _
      rw [← hℓ, Category.assoc, hk i]
      change ℓ ≫ 𝒰.f i ≫ ψ.left ≫ a (cst i).down = ((ℓ ≫ 𝒰.f i) ≫ ψ.left) ≫ a (cst i).down
      calc ℓ ≫ 𝒰.f i ≫ ψ.left ≫ a (cst i).down
          = ℓ ≫ ((𝒰.f i ≫ ψ.left) ≫ a (cst i).down) :=
            congrArg (ℓ ≫ ·) (Category.assoc _ _ _).symm
        _ = (ℓ ≫ (𝒰.f i ≫ ψ.left)) ≫ a (cst i).down := (Category.assoc _ _ _).symm
        _ = ((ℓ ≫ 𝒰.f i) ≫ ψ.left) ≫ a (cst i).down :=
            congrArg (· ≫ a (cst i).down) (Category.assoc _ _ _).symm
    have hL : (E.obj.map e.op).hom ((E.obj.map φ.op).hom s) =
        (E.obj.map e.op).hom ((E.obj.map ψ.op).hom s) +
          (f.hom.app (Opposite.op V')).hom
            (wcConstSec X (ULift.{u+1} (ZMod m)) V' (ULift.up (cst i).down)) := by
      rw [← hmap, he, hmap, hrel.2 (cst i).down, map_add, hfnat, hconstM, hmap]
    have hR : (E.obj.map e.op).hom t =
        (E.obj.map e.op).hom ((E.obj.map ψ.op).hom s) +
          (f.hom.app (Opposite.op V')).hom
            (wcConstSec X (ULift.{u+1} (ZMod m)) V' (ULift.up (cst i).down)) := by
      rw [ht_eq, map_add, hfnat, hloc i V' e hi]
      rfl
    rw [hL, hR]
  have hScov : Sieve.generate (fun (V' : X.Etale) (e : V' ⟶ W) => ∃ i, Set.range e.left ⊆ Oset i)
      ∈ Scheme.smallEtaleTopology X W := by
    apply wc_etale_jointly_surjective_covers
    intro v
    refine ⟨wcEtOpen X W (O v), wcEtOpenι X W (O v), ?_, ?_⟩
    · apply Sieve.le_generate
      refine ⟨v, ?_⟩
      change Set.range (O v).ι ⊆ Oset v
      rw [Scheme.Opens.range_ι]
      exact fun _ h => h
    · change v ∈ Set.range (O v).ι
      rw [Scheme.Opens.range_ι]
      exact hxO v
  refine ⟨φ, E.isSeparated W _ hScov _ _ ?_⟩
  intro V' h hh
  obtain ⟨V'', h', e, ⟨i, hi⟩, rfl⟩ := hh
  change (E.obj.map (h' ≫ e).op).hom ((E.obj.map φ.op).hom s) = (E.obj.map (h' ≫ e).op).hom t
  rw [hmap, hmap, key V'' e i hi]

theorem wc_fet_split_universal : ∀ (X : Scheme.{u}) (m : ℕ), m ≠ 0 →
    ∀ (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
      (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0),
      (ShortComplex.mk f g w).ShortExact → wcTorSplitUniv f g :=
by
  intro X m _ E f g w hS U V pU a ht hE s hrel W hWU t ht1

  have hmap : ∀ {A B C : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map (a₁ ≫ b₁).op).hom x = (E.obj.map a₁.op).hom ((E.obj.map b₁.op).hom x) := by
    intro A B C a₁ b₁ x
    rw [op_comp, Functor.map_comp]
    rfl

  have hconst : ∀ (V₁ V₂ : X.Etale) (e : V₂ ⟶ V₁) (x : ULift.{u+1} ℤ),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map e.op).hom (wcConstSec X (ULift.{u+1} ℤ) V₁ x) =
        wcConstSec X (ULift.{u+1} ℤ) V₂ x := by
    intro V₁ V₂ e x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) e.op x).symm

  have hsep : ∀ (W₁ W₂ : X.Etale) (π : W₂ ⟶ W₁), Function.Surjective π.left →
      ∀ x y : E.obj.obj (Opposite.op W₁),
        (E.obj.map π.op).hom x = (E.obj.map π.op).hom y → x = y := by
    intro W₁ W₂ π hπ x y hxy
    have hcov : Sieve.generate (Presieve.singleton π) ∈ Scheme.smallEtaleTopology X W₁ := by
      apply wc_etale_jointly_surjective_covers
      intro v
      obtain ⟨v', hv'⟩ := hπ v
      exact ⟨W₂, π, ⟨W₂, 𝟙 W₂, π, Presieve.singleton.mk, Category.id_comp π⟩, v', hv'⟩
    refine E.isSeparated W₁ _ hcov x y ?_
    intro Y h hh
    obtain ⟨Z, h', π', hπ', rfl⟩ := hh
    cases hπ'
    change (E.obj.map (h' ≫ π).op).hom x = (E.obj.map (h' ≫ π).op).hom y
    rw [hmap, hmap, hxy]

  have hdesc : ∀ {A B Z : Scheme.{u}} (π : A ⟶ B), Flat π → QuasiCompact π → Surjective π →
      ∀ (k' : A ⟶ Z), Limits.pullback.fst π π ≫ k' = Limits.pullback.snd π π ≫ k' →
        ∃! k : B ⟶ Z, π ≫ k = k' := by
    intro A B Z π hfl hqc hsurj k' hk'
    have hsh : Presieve.IsSheaf Scheme.fpqcTopology (yoneda.obj Z) :=
      GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
    have hcov : Sieve.generate (Presieve.singleton π) ∈ Scheme.fpqcTopology B := by
      apply Precoverage.generate_mem_toGrothendieck
      refine ⟨?_, ?_⟩
      · have h1 := (Scheme.presieve₀_mem_qcPrecoverage_iff.{u, u}
          (E := PreZeroHypercover.singleton.{u, u, u+1} π)).mpr (QuasiCompactCover.singleton.{u, u} π)
        rwa [PreZeroHypercover.presieve₀_singleton] at h1
      · exact (Scheme.singleton_mem_precoverage_iff (P := @Flat) π).2 ⟨Surjective.surj, hfl⟩
    refine Presieve.isSheafFor_singleton.mp (hsh.isSheafFor _ hcov) k' ?_
    intro Y p₁ p₂ hp
    change p₁ ≫ k' = p₂ ≫ k'
    have e1 : Limits.pullback.lift p₁ p₂ hp ≫ Limits.pullback.fst π π = p₁ :=
      Limits.pullback.lift_fst _ _ _
    have e2 : Limits.pullback.lift p₁ p₂ hp ≫ Limits.pullback.snd π π = p₂ :=
      Limits.pullback.lift_snd _ _ _
    calc p₁ ≫ k' = (Limits.pullback.lift p₁ p₂ hp ≫ Limits.pullback.fst π π) ≫ k' := by rw [e1]
      _ = Limits.pullback.lift p₁ p₂ hp ≫ Limits.pullback.snd π π ≫ k' := by
          rw [Category.assoc, hk']
      _ = p₂ ≫ k' := by rw [← Category.assoc, e2]

  haveI : IsFinite pU := ht.finite
  haveI : Etale pU := ht.etale
  haveI : Surjective pU := ⟨Set.range_eq_univ.mp ht.surj⟩
  haveI hWet : Etale W.hom := W.prop

  let w₀ : W.left ⟶ (U : Scheme.{u}) :=
    IsOpenImmersion.lift U.ι W.hom (by rw [Scheme.Opens.range_ι]; exact hWU)
  have hw₀ : w₀ ≫ U.ι = W.hom := IsOpenImmersion.lift_fac _ _ _

  let π : Limits.pullback w₀ pU ⟶ W.left := Limits.pullback.fst w₀ pU
  have hq : Limits.pullback.snd w₀ pU ≫ pU ≫ U.ι = π ≫ W.hom := by
    rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc, hw₀]

  let W' : X.Etale := MorphismProperty.Over.mk ⊤ (π ≫ W.hom) inferInstance
  let πₑ : W' ⟶ W := MorphismProperty.Over.homMk π rfl trivial
  let ψ : W' ⟶ wcTorsorEt (pU ≫ U.ι) hE :=
    MorphismProperty.Over.homMk (Limits.pullback.snd w₀ pU) hq trivial

  have ht1' : (g.hom.app (Opposite.op W')).hom ((E.obj.map πₑ.op).hom t) =
      wcConstSec X (ULift.{u+1} ℤ) W' (ULift.up 1) := by
    calc (g.hom.app (Opposite.op W')).hom ((E.obj.map πₑ.op).hom t)
        = (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map πₑ.op).hom
            ((g.hom.app (Opposite.op W)).hom t) := NatTrans.naturality_apply g.hom πₑ.op t
      _ = wcConstSec X (ULift.{u+1} ℤ) W' (ULift.up 1) := by
          rw [ht1]; exact hconst W W' πₑ (ULift.up 1)
  obtain ⟨φ', hφ'⟩ := wc_fet_split_translate X m E f g w hS U V pU a ht hE s hrel W' ψ
    ((E.obj.map πₑ.op).hom t) ht1'

  let W₂ : X.Etale := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst π π ≫ π ≫ W.hom) inferInstance
  let e₁ : W₂ ⟶ W' := MorphismProperty.Over.homMk (Limits.pullback.fst π π) rfl trivial
  have he₂ : Limits.pullback.snd π π ≫ π ≫ W.hom = Limits.pullback.fst π π ≫ π ≫ W.hom := by
    rw [← Category.assoc, ← Limits.pullback.condition, Category.assoc]
  let e₂ : W₂ ⟶ W' := MorphismProperty.Over.homMk (Limits.pullback.snd π π) he₂ trivial
  have he : e₁ ≫ πₑ = e₂ ≫ πₑ := by
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.fst π π ≫ π = Limits.pullback.snd π π ≫ π
    exact Limits.pullback.condition
  have hE12 : (E.obj.map (e₁ ≫ φ').op).hom s = (E.obj.map (e₂ ≫ φ').op).hom s := by
    rw [hmap, hmap, hφ', ← hmap, ← hmap, he]
  have he12 : e₁ ≫ φ' = e₂ ≫ φ' :=
    wc_fet_split_unique X m E f g w hS U V pU a ht hE s hrel W₂ (e₁ ≫ φ') (e₂ ≫ φ') hE12
  have hcompat : Limits.pullback.fst π π ≫ φ'.left = Limits.pullback.snd π π ≫ φ'.left :=
    congrArg (fun x => x.left) he12

  obtain ⟨k, hk, -⟩ := hdesc π inferInstance inferInstance inferInstance φ'.left hcompat

  have hkX : k ≫ pU ≫ U.ι = W.hom := by
    obtain ⟨k0, -, huniq⟩ := hdesc π inferInstance inferInstance inferInstance (π ≫ W.hom)
      (by rw [← Category.assoc, Limits.pullback.condition, Category.assoc])
    have h1 : π ≫ k ≫ pU ≫ U.ι = π ≫ W.hom := by
      rw [← Category.assoc, hk]
      exact MorphismProperty.Over.w φ'
    exact (huniq _ h1).trans (huniq W.hom rfl).symm

  let φ : W ⟶ wcTorsorEt (pU ≫ U.ι) hE := MorphismProperty.Over.homMk k hkX trivial
  have hφπ : πₑ ≫ φ = φ' := by
    apply MorphismProperty.Over.Hom.ext
    exact hk
  have hφt : (E.obj.map φ.op).hom s = t := by
    refine hsep W W' πₑ (show Function.Surjective π from Surjective.surj) _ _ ?_
    rw [← hmap, hφπ, hφ']

  refine ⟨k, ⟨φ, rfl, hφt⟩, ?_⟩
  rintro k₂ ⟨φ₂, rfl, hφ₂⟩
  have h2 : φ₂ = φ :=
    wc_fet_split_unique X m E f g w hS U V pU a ht hE s hrel W φ₂ φ (hφ₂.trans hφt.symm)
  exact congrArg (fun x => x.left) h2

theorem wc_tar_cover : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))), Epi g →
    ∀ (U : X.Opens) (hU : IsAffineOpen U),
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra Γ(X, U) R') (_ : Algebra.Etale Γ(X, U) R'),
      Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(X, U) R')) ∧
      ∃ e : E.obj.obj (Opposite.op (wcEtAff X hU R')),
        (g.hom.app (Opposite.op (wcEtAff X hU R'))).hom e =
          wcConstSec X (ULift.{u+1} ℤ) (wcEtAff X hU R') (ULift.up 1) :=
by
  intro X E g hg U hU
  classical

  have hres : ∀ {V W : X.Etale} (h : V ⟶ W) (x : ULift.{u+1} ℤ),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map h.op).hom
        (wcConstSec X (ULift.{u+1} ℤ) W x) = wcConstSec X (ULift.{u+1} ℤ) V x := by
    intro V W h x
    have hn := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) h.op x
    exact hn.symm

  have hepi : ∀ {B Q : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}} (g : B ⟶ Q) [Epi g]
      (U : X.Etale) (q : Q.obj.obj (Opposite.op U)),
      Presheaf.imageSieve g.hom q ∈ Scheme.smallEtaleTopology X U := by
    intro B Q g _ U q
    have hpb : ∀ {V W : X.Etale} (h : W ⟶ V) (s : Q.obj.obj (Opposite.op V)),
        Presheaf.imageSieve g.hom (Q.obj.map h.op s) =
          Sieve.pullback h (Presheaf.imageSieve g.hom s) := by
      intro V W h s
      ext Z f
      change (∃ t, g.hom.app _ t = Q.obj.map f.op (Q.obj.map h.op s)) ↔
        (∃ t, g.hom.app _ t = Q.obj.map (f ≫ h).op s)
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
    let IU : ∀ V : (X.Etale)ᵒᵖ, AddSubgroup (Q.obj.obj V) := fun V =>
      { carrier := {s | Presheaf.imageSieve g.hom s ∈ Scheme.smallEtaleTopology X V.unop}
        zero_mem' := by
          refine (Scheme.smallEtaleTopology X).superset_covering ?_
            ((Scheme.smallEtaleTopology X).top_mem _)
          intro Z f _
          exact ⟨0, by simp⟩
        add_mem' := by
          intro a b ha hb
          refine (Scheme.smallEtaleTopology X).superset_covering ?_
            ((Scheme.smallEtaleTopology X).intersection_covering ha hb)
          rintro Z f ⟨⟨t₁, h₁⟩, ⟨t₂, h₂⟩⟩
          exact ⟨t₁ + t₂, by rw [map_add, h₁, h₂, map_add]⟩
        neg_mem' := by
          intro a ha
          refine (Scheme.smallEtaleTopology X).superset_covering ?_ ha
          rintro Z f ⟨t, h⟩
          exact ⟨-t, by rw [map_neg, h, map_neg]⟩ }
    have hstab : ∀ {V W : (X.Etale)ᵒᵖ} (φ : V ⟶ W) (s : Q.obj.obj V), s ∈ IU V →
        Q.obj.map φ s ∈ IU W := by
      intro V W φ s hs
      have h1 := hpb φ.unop s
      simp only [Quiver.Hom.op_unop] at h1
      change Presheaf.imageSieve g.hom (Q.obj.map φ s) ∈ Scheme.smallEtaleTopology X W.unop
      rw [h1]
      exact (Scheme.smallEtaleTopology X).pullback_stable _ hs
    let I : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun V => AddCommGrpCat.of (IU V)
        map := fun {V W} φ => AddCommGrpCat.ofHom
          (AddMonoidHom.codRestrict ((Q.obj.map φ).hom.comp (IU V).subtype) (IU W)
            (fun s => hstab φ s.1 s.2))
        map_id := by
          intro V
          ext s
          simp
        map_comp := by
          intro V W Z φ ψ
          ext s
          change Q.obj.map (φ ≫ ψ) s.1 = Q.obj.map ψ (Q.obj.map φ s.1)
          rw [Functor.map_comp, ConcreteCategory.comp_apply] }
    let ι₀ : I ⟶ Q.obj :=
      { app := fun V => AddCommGrpCat.ofHom (IU V).subtype
        naturality := by
          intro V W φ
          ext s
          rfl }
    have hgb : ∀ (V : (X.Etale)ᵒᵖ) (b : B.obj.obj V), g.hom.app V b ∈ IU V := by
      intro V b
      change Presheaf.imageSieve g.hom (g.hom.app V b) ∈ Scheme.smallEtaleTopology X V.unop
      rw [Presheaf.imageSieve_app g.hom (U := V.unop) b]
      exact (Scheme.smallEtaleTopology X).top_mem _
    let g₀ : B.obj ⟶ I :=
      { app := fun V => AddCommGrpCat.ofHom
          (AddMonoidHom.codRestrict (g.hom.app V).hom (IU V) (fun b => hgb V b))
        naturality := by
          intro V W φ
          ext b
          exact ConcreteCategory.congr_hom (g.hom.naturality φ) b }
    have hQ : Presieve.IsSheaf (Scheme.smallEtaleTopology X) (Q.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology X) _).1
        (GrothendieckTopology.HasSheafCompose.isSheaf Q.obj Q.property)
    have hIt : Presieve.IsSheaf (Scheme.smallEtaleTopology X) (I ⋙ forget AddCommGrpCat.{u+1}) := by
      intro W R hR x hx
      let x' : Presieve.FamilyOfElements (Q.obj ⋙ forget AddCommGrpCat.{u+1}) R :=
        fun Y f hf => (x f hf).1
      have hx' : x'.Compatible := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hc
        exact congrArg Subtype.val (hx g₁ g₂ h₁ h₂ hc)
      let s := (hQ R hR).amalgamate x' hx'
      have hvalid : ∀ {Y : X.Etale} (f : Y ⟶ W) (hf : R f), Q.obj.map f.op s = x' f hf :=
        fun f hf => (hQ R hR).valid_glue hx' f hf
      have hmem : s ∈ IU (Opposite.op W) := by
        change Presheaf.imageSieve g.hom s ∈ Scheme.smallEtaleTopology X W
        refine (Scheme.smallEtaleTopology X).transitive hR _ (fun Y f hf => ?_)
        rw [← hpb, hvalid f hf]
        exact (x f hf).2
      refine ⟨(⟨s, hmem⟩ : IU (Opposite.op W)), fun Y f hf => ?_, fun y hy => ?_⟩
      · apply Subtype.ext
        exact hvalid f hf
      · apply Subtype.ext
        refine (hQ R hR).isSeparatedFor x' _ s ?_ ((hQ R hR).isAmalgamation hx')
        intro Y f hf
        change ((I ⋙ forget AddCommGrpCat.{u+1}).map f.op y).1 = (x f hf).1
        rw [hy f hf]
    have hI : Presheaf.IsSheaf (Scheme.smallEtaleTopology X) I :=
      Presheaf.isSheaf_of_isSheaf_comp (Scheme.smallEtaleTopology X) I (forget AddCommGrpCat.{u+1})
        ((isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology X) _).2 hIt)
    let Is : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} := ⟨I, hI⟩
    let ι : Is ⟶ Q := ObjectProperty.homMk ι₀
    let g' : B ⟶ Is := ObjectProperty.homMk g₀
    have hfac : g' ≫ ι = g := by
      apply Sheaf.hom_ext
      ext V b
      rfl
    have : Epi ι := epi_of_epi_fac hfac
    have : ∀ V, Mono (ι₀.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).2 Subtype.val_injective
    have : Mono ι₀ := NatTrans.mono_of_mono_app ι₀
    have : Mono ι := Functor.mono_of_mono_map
      (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (show Mono ι₀ from inferInstance)
    have : IsIso ι := isIso_of_mono_of_epi ι
    have hι₀ : IsIso ι₀ := (inferInstance : IsIso
      ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map ι))
    have : IsIso (ι₀.app (Opposite.op U)) := NatIso.isIso_app_of_isIso ι₀ _
    have hsurj : Function.Surjective (ι₀.app (Opposite.op U)) :=
      (ConcreteCategory.bijective_of_isIso (ι₀.app (Opposite.op U))).2
    obtain ⟨y, hy⟩ := hsurj q
    rw [← hy]
    exact y.2

  have hrefine : ∀ (U : X.Etale), CompactSpace U.left →
      ∀ R ∈ Scheme.smallEtaleTopology X U, ∃ (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U),
        (∀ i, R.arrows (f i)) ∧ (∀ i, IsAffine (V i).left) ∧
        ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left := by
    intro U hc R hR
    have hSurj : ∀ y : U.left, ∃ (Y : X.Etale) (g : Y ⟶ U) (w : Y.left),
        R.arrows g ∧ g.left w = y := by
      change R ∈ Scheme.smallGrothendieckTopology @Etale X U at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      intro y
      obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U R).mp hR y
      exact ⟨Y, g, w, hg, hw⟩
    have hNbhd : ∀ y : U.left, ∃ (V : X.Etale) (f : V ⟶ U),
        R.arrows f ∧ IsAffine V.left ∧ y ∈ Set.range f.left := by
      intro y
      obtain ⟨Y, g, w, hg, hw⟩ := hSurj y
      obtain ⟨a, ha⟩ := Y.left.affineCover.covers w
      haveI : Etale Y.hom := Y.prop
      let V : X.Etale := MorphismProperty.Over.mk ⊤
        (Y.left.affineCover.f (Y.left.affineCover.idx w) ≫ Y.hom)
        (inferInstance : Etale (Y.left.affineCover.f (Y.left.affineCover.idx w) ≫ Y.hom))
      let h : V ⟶ Y := MorphismProperty.Over.homMk
        (Y.left.affineCover.f (Y.left.affineCover.idx w)) rfl trivial
      refine ⟨V, h ≫ g, R.downward_closed hg h, ?_, ⟨a, ?_⟩⟩
      · show IsAffine (Y.left.affineCover.X (Y.left.affineCover.idx w))
        infer_instance
      · change g.left (Y.left.affineCover.f (Y.left.affineCover.idx w) a) = y
        rw [ha, hw]
    choose Vy fy hR' hA hy using hNbhd
    have hopen : ∀ y, Set.range (fy y).left ∈ nhds y := fun y =>
      ((fy y).left.isOpenMap.isOpen_range).mem_nhds (hy y)
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover _ hopen
    refine ⟨t.card, fun i => Vy (t.equivFin.symm i).1, fun i => fy (t.equivFin.symm i).1,
      fun i => hR' _, fun i => hA _, ?_⟩
    intro x
    have hx : x ∈ ⋃ y ∈ t, Set.range (fy y).left := by rw [ht]; trivial
    obtain ⟨y, hyt, hxy⟩ := Set.mem_iUnion₂.mp hx
    have key : ∀ z : t, z = ⟨y, hyt⟩ → x ∈ Set.range (fy z.1).left := by
      rintro _ rfl
      exact hxy
    exact ⟨t.equivFin ⟨y, hyt⟩, key _ (Equiv.symm_apply_apply _ _)⟩


  have hbij : ∀ (T : X.Etale) (n : ℕ) (Ti : Fin n → X.Etale) (t : ∀ i, Ti i ⟶ T),
      (∀ i, IsOpenImmersion (t i).left) →
      (∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left)) →
      (∀ x : T.left, ∃ i, x ∈ Set.range (t i).left) →
      ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      Function.Bijective (fun (s : F.obj.obj (Opposite.op T)) (i : Fin n) =>
        (F.obj.map (t i).op).hom s) := by
    intro T n Ti t hopen hdisj hcov F
    have s1 : ∀ W : X.Etale, IsEmpty W.left → Subsingleton (F.obj.obj (Opposite.op W)) := by
      intro W hW
      have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology X W := by
        change (⊥ : Sieve W) ∈ Scheme.smallGrothendieckTopology @Etale X W
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        exact isEmptyElim x
      exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover F W hbot).isZero
    have s2 : Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallEtaleTopology X T := by
      change Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallGrothendieckTopology @Etale X T
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨i, y, hy⟩ := hcov x
      haveI := hopen i
      have hmem : (Sieve.generate (Presieve.ofArrows Ti t)).arrows (t i) :=
        Sieve.le_generate (Presieve.ofArrows Ti t) (Ti i) (t i) (Presieve.ofArrows.mk i)
      exact ⟨Ti i, t i, y, hmem, inferInstance, hy⟩
    let P := F.obj ⋙ forget AddCommGrpCat
    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology X) P :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) F.obj
          (forget AddCommGrpCat)).1 F.cond)
    have s3 := (Presieve.isSheafFor_arrows_iff P t).1 (hP.isSheafFor _ s2)
    have s4 : ∀ x : ∀ i, P.obj (Opposite.op (Ti i)), Presieve.Arrows.Compatible P t x := by
      intro x i j Z gi gj h
      have hl : gi.left ≫ (t i).left = gj.left ≫ (t j).left := by
        have h1 : (Scheme.Etale.forget X ⋙ Over.forget X).map gi ≫
            (Scheme.Etale.forget X ⋙ Over.forget X).map (t i) =
            (Scheme.Etale.forget X ⋙ Over.forget X).map gj ≫
            (Scheme.Etale.forget X ⋙ Over.forget X).map (t j) := by
          rw [← Functor.map_comp, ← Functor.map_comp, h]
        exact h1
      by_cases hij : i = j
      · subst hij
        haveI := hopen i
        have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (t i).left).1 hl
        rw [hg]
      · haveI : IsEmpty Z.left := ⟨fun z => by
          have hz : (t i).left (gi.left z) = (t j).left (gj.left z) := by
            rw [← Scheme.Hom.comp_apply, hl, Scheme.Hom.comp_apply]
          exact Set.disjoint_left.1 (hdisj i j hij) ⟨_, rfl⟩ ⟨_, hz.symm⟩⟩
        exact @Subsingleton.elim _ (s1 Z inferInstance) _ _
    refine ⟨fun s s' hss => ?_, fun x => ?_⟩
    · obtain ⟨s0, _, huniq⟩ := s3 (fun i => (F.obj.map (t i).op).hom s) (s4 _)
      exact (huniq s (fun i => rfl)).trans (huniq s' (fun i => (congrFun hss i).symm)).symm
    · obtain ⟨s, hs, _⟩ := s3 x (s4 x)
      exact ⟨s, funext hs⟩

  let T0 : X.Etale := wcEtAff X hU Γ(X, U)
  have hT0c : CompactSpace T0.left := by
    show CompactSpace (Spec (CommRingCat.of Γ(X, U)))
    infer_instance
  have hT0aff : IsAffine T0.left := by
    show IsAffine (Spec (CommRingCat.of Γ(X, U)))
    infer_instance

  obtain ⟨k, V, φ, harr, haff, hcov⟩ := hrefine T0 hT0c _
    (hepi g T0 (wcConstSec X (ULift.{u+1} ℤ) T0 (ULift.up 1)))
  have hlift : ∀ i, ∃ t : E.obj.obj (Opposite.op (V i)),
      (g.hom.app (Opposite.op (V i))).hom t = wcConstSec X (ULift.{u+1} ℤ) (V i) (ULift.up 1) := by
    intro i
    obtain ⟨t, ht⟩ := harr i
    exact ⟨t, ht.trans (hres (φ i) _)⟩
  choose t ht using hlift

  let A : Fin k → Type u := fun i => Γ((V i).left, ⊤)
  letI hAring : ∀ i, CommRing (A i) := fun i => inferInstanceAs (CommRing Γ((V i).left, ⊤))
  let ρ : ∀ i, Γ(X, U) →+* A i := fun i =>
    ((Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv ≫ Scheme.Hom.appTop (φ i).left).hom
  have hρ : ∀ i, (ρ i).Etale := by
    intro i
    haveI := haff i
    haveI := hT0aff
    have h1 : RingHom.Etale (Scheme.Hom.appTop (φ i).left).hom :=
      HasRingHomProperty.appTop @Etale (φ i).left (inferInstance : Etale (φ i).left)
    have h2 : RingHom.Etale (Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv.hom :=
      RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
    change RingHom.Etale ((Scheme.Hom.appTop (φ i).left).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv.hom)
    exact RingHom.Etale.stableUnderComposition _ _ h2 h1
  letI hAalg : ∀ i, Algebra Γ(X, U) (A i) := fun i => (ρ i).toAlgebra
  haveI hAet : ∀ i, Algebra.Etale Γ(X, U) (A i) := fun i => RingHom.etale_algebraMap.mp (hρ i)
  haveI hR'et : Algebra.Etale Γ(X, U) (∀ i, A i) := inferInstance

  have hring : ∀ i, CommRingCat.ofHom (algebraMap Γ(X, U) (∀ i, A i)) ≫
      CommRingCat.ofHom (Pi.evalRingHom A i) =
      (Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv ≫ Scheme.Hom.appTop (φ i).left := by
    intro i
    ext a
    rfl

  let j : ∀ i, (V i).left ⟶ Spec (CommRingCat.of (∀ i, A i)) := fun i =>
    (@Scheme.isoSpec (V i).left (haff i)).hom ≫ Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))
  have hkey : ∀ i, j i ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (∀ i, A i))) =
      (φ i).left := by
    intro i
    have e1 : Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (∀ i, A i))) =
        Spec.map (Scheme.Hom.appTop (φ i).left) ≫
          Spec.map (Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv := by
      rw [← Spec.map_comp, hring i, Spec.map_comp]
      rfl
    have hn : (V i).left.toSpecΓ ≫ Spec.map (Scheme.Hom.appTop (φ i).left) =
        (φ i).left ≫ (Spec (CommRingCat.of Γ(X, U))).toSpecΓ :=
      (Scheme.toSpecΓ_naturality (φ i).left).symm
    have hiso : (@Scheme.isoSpec (V i).left (haff i)).hom = (V i).left.toSpecΓ :=
      @Scheme.isoSpec_hom (V i).left (haff i)
    change ((@Scheme.isoSpec (V i).left (haff i)).hom ≫
      Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (∀ i, A i))) = (φ i).left
    rw [Category.assoc, e1, ← Category.assoc, hiso, hn]
    exact (Category.assoc _ _ _).trans ((congrArg (fun z => (φ i).left ≫ z)
      (toSpecΓ_SpecMap_ΓSpecIso_inv (CommRingCat.of Γ(X, U)))).trans (Category.comp_id _))
  have hover : ∀ i, j i ≫ (wcEtAff X hU (∀ i, A i)).hom = (V i).hom := by
    intro i
    rw [← MorphismProperty.Over.w (φ i)]
    show j i ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (∀ i, A i))) ≫ hU.fromSpec) =
      (φ i).left ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) Γ(X, U))) ≫ hU.fromSpec)
    rw [← Category.assoc, hkey i, Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id]
    exact (congrArg (fun z => (φ i).left ≫ z) (Category.id_comp hU.fromSpec)).symm
  let Jm : ∀ i, V i ⟶ wcEtAff X hU (∀ i, A i) := fun i =>
    MorphismProperty.Over.homMk (j i) (hover i) trivial
  have hopen : ∀ i, IsOpenImmersion (Jm i).left := by
    intro i
    haveI := haff i
    show IsOpenImmersion ((V i).left.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i)))
    infer_instance

  have hdisj : ∀ i i', i ≠ i' → Disjoint (Set.range (Jm i).left) (Set.range (Jm i').left) := by
    intro i i' hii'
    rw [Set.disjoint_left]
    rintro x ⟨a, rfl⟩ ⟨b, hb⟩
    haveI := haff i
    haveI := haff i'
    have h1 : (Pi.single i (1 : A i) : ∀ l, A l) ∉
        @PrimeSpectrum.asIdeal (∀ l, A l) _ ((Jm i).left a) := by
      intro h
      change (Pi.single i (1 : A i) : ∀ l, A l) i ∈
        @PrimeSpectrum.asIdeal (A i) _ ((V i).left.isoSpec.hom a) at h
      rw [Pi.single_eq_same] at h
      exact (PrimeSpectrum.isPrime _).ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have h2 : (Pi.single i (1 : A i) : ∀ l, A l) ∈
        @PrimeSpectrum.asIdeal (∀ l, A l) _ ((Jm i').left b) := by
      change (Pi.single i (1 : A i) : ∀ l, A l) i' ∈
        @PrimeSpectrum.asIdeal (A i') _ ((V i').left.isoSpec.hom b)
      rw [Pi.single_eq_of_ne (Ne.symm hii')]
      exact Ideal.zero_mem _
    rw [hb] at h2
    exact h1 h2
  have hcov' : ∀ x : (wcEtAff X hU (∀ i, A i)).left, ∃ i, x ∈ Set.range (Jm i).left := by
    intro x
    obtain ⟨⟨i, p⟩, hp⟩ := (PrimeSpectrum.sigmaToPi_bijective A).2
      (show PrimeSpectrum (∀ l, A l) from x)
    haveI := haff i
    refine ⟨i, (V i).left.isoSpec.inv p, ?_⟩
    have e1 := Scheme.Hom.comp_apply (V i).left.isoSpec.inv (V i).left.isoSpec.hom p
    rw [Iso.inv_hom_id] at e1
    change Spec.map (CommRingCat.ofHom (Pi.evalRingHom A i))
      ((V i).left.isoSpec.hom ((V i).left.isoSpec.inv p)) = x
    rw [← e1, ← hp, PrimeSpectrum.sigmaToPi_apply]
    rfl

  obtain ⟨e, he⟩ := (hbij _ k V Jm hopen hdisj hcov' E).2 t
  have hgE : (g.hom.app (Opposite.op (wcEtAff X hU (∀ i, A i)))).hom e =
      wcConstSec X (ULift.{u+1} ℤ) (wcEtAff X hU (∀ i, A i)) (ULift.up 1) := by
    apply (hbij _ k V Jm hopen hdisj hcov'
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))).1
    funext i
    have hn := NatTrans.naturality_apply g.hom (Jm i).op e
    exact hn.symm.trans (((congrArg (fun z => (g.hom.app (Opposite.op (V i))).hom z)
      (congrFun he i)).trans (ht i)).trans (hres (Jm i) _).symm)

  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(X, U) (∀ i, A i))) := by
    intro P
    obtain ⟨i, v, hv⟩ := hcov P
    refine ⟨j i v, ?_⟩
    rw [← hv, ← hkey i, Scheme.Hom.comp_apply]
    rfl
  exact ⟨∀ i, A i, inferInstance, inferInstance, inferInstance, hsurj, e, hgE⟩

theorem wc_tar_lc_cocycle : ∀ (X : Scheme.{u}) (m : ℕ)
    (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
    (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0),
    (ShortComplex.mk f g w).ShortExact →
    ∀ (U : X.Opens) (hU : IsAffineOpen U) (R' : Type u) [CommRing R'] [Algebra Γ(X, U) R']
      [Algebra.Etale Γ(X, U) R'] (e : E.obj.obj (Opposite.op (wcEtAff X hU R'))),
    (g.hom.app (Opposite.op (wcEtAff X hU R'))).hom e =
      wcConstSec X (ULift.{u+1} ℤ) (wcEtAff X hU R') (ULift.up 1) →
    ∃ lc : LocallyConstant (PrimeSpectrum (TensorProduct Γ(X, U) R' R')) (ZMod m),
      wcTarLcCoc Γ(X, U) R' m lc ∧
      ∀ (Z : X.Etale) (z1 z2 : Z ⟶ wcEtAff X hU R')
        (wz : Z.left ⟶ Spec (.of (TensorProduct Γ(X, U) R' R'))) (c : ZMod m),
        wz ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct Γ(X, U) R' R')) = z1.left →
        wz ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R').toRingHom) =
          z2.left →
        (∀ ζ : Z.left, lc (wz ζ) = c) →
        (E.obj.map z2.op).hom e - (E.obj.map z1.op).hom e =
          (f.hom.app (Opposite.op Z)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) Z (ULift.up c)) :=
by
  intro X m E f g w hS U hU R' _ _ _ e he
  classical
  haveI hA : Algebra.Etale Γ(X, U) (TensorProduct Γ(X, U) R' R') :=
    Algebra.Etale.comp Γ(X, U) R' (TensorProduct Γ(X, U) R' R')
  haveI hA3 : Algebra.Etale Γ(X, U) (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R')) :=
    Algebra.Etale.comp Γ(X, U) R' (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R'))

  have mkHom : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra Γ(X, U) C] [Algebra Γ(X, U) D]
      [Algebra.Etale Γ(X, U) C] [Algebra.Etale Γ(X, U) D] (φ : C →ₐ[Γ(X, U)] D),
      ∃ Q : wcEtAff X hU D ⟶ wcEtAff X hU C, Q.left = Spec.map (CommRingCat.ofHom φ.toRingHom) := by
    intro C D _ _ _ _ _ _ φ
    have hφ : φ.toRingHom.comp (algebraMap Γ(X, U) C) = algebraMap Γ(X, U) D :=
      RingHom.ext fun r => φ.commutes r
    refine ⟨MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom φ.toRingHom)) ?_ trivial, rfl⟩
    change Spec.map (CommRingCat.ofHom φ.toRingHom) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) C)) ≫ hU.fromSpec) =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) D)) ≫ hU.fromSpec
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hφ]
  obtain ⟨Q1, hQ1⟩ := mkHom R' (TensorProduct Γ(X, U) R' R')
    (Algebra.TensorProduct.includeLeft : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R')
  obtain ⟨Q2, hQ2⟩ := mkHom R' (TensorProduct Γ(X, U) R' R')
    (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R')
  obtain ⟨P12, hP12⟩ := mkHom (TensorProduct Γ(X, U) R' R')
    (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R'))
    (Algebra.TensorProduct.map (AlgHom.id Γ(X, U) R')
      (Algebra.TensorProduct.includeLeft : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R'))
  obtain ⟨P13, hP13⟩ := mkHom (TensorProduct Γ(X, U) R' R')
    (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R'))
    (Algebra.TensorProduct.map (AlgHom.id Γ(X, U) R')
      (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R'))
  obtain ⟨P23, hP23⟩ := mkHom (TensorProduct Γ(X, U) R' R')
    (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R'))
    (Algebra.TensorProduct.includeRight : TensorProduct Γ(X, U) R' R' →ₐ[Γ(X, U)]
      TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R'))

  have hr1 : (Algebra.TensorProduct.map (AlgHom.id Γ(X, U) R')
        (Algebra.TensorProduct.includeLeft : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R')).comp
        (Algebra.TensorProduct.includeLeft : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R') =
      (Algebra.TensorProduct.map (AlgHom.id Γ(X, U) R')
        (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R')).comp
        (Algebra.TensorProduct.includeLeft : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R') := by
    ext x; simp
  have hr2 : (Algebra.TensorProduct.map (AlgHom.id Γ(X, U) R')
        (Algebra.TensorProduct.includeLeft : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R')).comp
        (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R') =
      (Algebra.TensorProduct.includeRight : TensorProduct Γ(X, U) R' R' →ₐ[Γ(X, U)]
        TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R')).comp
        (Algebra.TensorProduct.includeLeft : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R') := by
    ext x; simp
  have hr3 : (Algebra.TensorProduct.map (AlgHom.id Γ(X, U) R')
        (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R')).comp
        (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R') =
      (Algebra.TensorProduct.includeRight : TensorProduct Γ(X, U) R' R' →ₐ[Γ(X, U)]
        TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R')).comp
        (Algebra.TensorProduct.includeRight : R' →ₐ[Γ(X, U)] TensorProduct Γ(X, U) R' R') := by
    ext x; simp
  have hSpecComp : ∀ {C D D' : Type u} [CommRing C] [CommRing D] [CommRing D'] (φ : C →+* D)
      (ψ : D →+* D'), Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φ) =
        Spec.map (CommRingCat.ofHom (ψ.comp φ)) := by
    intro C D D' _ _ _ φ ψ
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hSq : ∀ {C D D' : Type u} [CommRing C] [CommRing D] [CommRing D'] [Algebra Γ(X, U) C]
      [Algebra Γ(X, U) D] [Algebra Γ(X, U) D'] (φ1 φ2 : C →ₐ[Γ(X, U)] D)
      (ψ1 ψ2 : D →ₐ[Γ(X, U)] D'), ψ1.comp φ1 = ψ2.comp φ2 →
      Spec.map (CommRingCat.ofHom ψ1.toRingHom) ≫ Spec.map (CommRingCat.ofHom φ1.toRingHom) =
        Spec.map (CommRingCat.ofHom ψ2.toRingHom) ≫ Spec.map (CommRingCat.ofHom φ2.toRingHom) := by
    intro C D D' _ _ _ _ _ _ φ1 φ2 ψ1 ψ2 h
    rw [hSpecComp, hSpecComp]
    exact congrArg (fun φ => Spec.map (CommRingCat.ofHom φ)) (congrArg AlgHom.toRingHom h)
  have e1 : P12 ≫ Q1 = P13 ≫ Q1 := by
    apply MorphismProperty.Over.Hom.ext
    have h : P12.left ≫ Q1.left = P13.left ≫ Q1.left := by
      rw [hP12, hP13, hQ1]
      exact hSq _ _ _ _ hr1
    exact h
  have e2 : P12 ≫ Q2 = P23 ≫ Q1 := by
    apply MorphismProperty.Over.Hom.ext
    have h : P12.left ≫ Q2.left = P23.left ≫ Q1.left := by
      rw [hP12, hP23, hQ2, hQ1]
      exact hSq _ _ _ _ hr2
    exact h
  have e3 : P13 ≫ Q2 = P23 ≫ Q2 := by
    apply MorphismProperty.Over.Hom.ext
    have h : P13.left ≫ Q2.left = P23.left ≫ Q2.left := by
      rw [hP13, hP23, hQ2]
      exact hSq _ _ _ _ hr3
    exact h

  have hcompL : ∀ {A B C : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C) (y : A.left),
      (a₁ ≫ b₁).left y = b₁.left (a₁.left y) := fun a₁ b₁ y =>
    Scheme.Hom.comp_apply a₁.left b₁.left y
  have hmap : ∀ {A B C : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map (a₁ ≫ b₁).op).hom x = (E.obj.map a₁.op).hom ((E.obj.map b₁.op).hom x) := by
    intro A B C a₁ b₁ x
    rw [op_comp, Functor.map_comp]
    rfl
  have hmapL : ∀ {A B C : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C)
      (x : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op C)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map (a₁ ≫ b₁).op).hom x =
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map a₁.op).hom
        ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map b₁.op).hom x) := by
    intro A B C a₁ b₁ x
    rw [op_comp, Functor.map_comp]
    rfl
  have hconstZ : ∀ (V₁ V₂ : X.Etale) (e' : V₂ ⟶ V₁) (x : ULift.{u+1} ℤ),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map e'.op).hom (wcConstSec X (ULift.{u+1} ℤ) V₁ x) =
        wcConstSec X (ULift.{u+1} ℤ) V₂ x := by
    intro V₁ V₂ e' x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) e'.op x).symm
  have hconstM : ∀ (V₁ V₂ : X.Etale) (e' : V₂ ⟶ V₁) (x : ULift.{u+1} (ZMod m)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e'.op).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) V₁ x) =
        wcConstSec X (ULift.{u+1} (ZMod m)) V₂ x := by
    intro V₁ V₂ e' x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) e'.op x).symm
  have hfnat : ∀ {A B : X.Etale} (e' : A ⟶ B)
      (y : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op B)),
      (E.obj.map e'.op).hom ((f.hom.app (Opposite.op B)).hom y) =
        (f.hom.app (Opposite.op A)).hom
          ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e'.op).hom y) := by
    intro A B e' y
    exact (NatTrans.naturality_apply f.hom e'.op y).symm

  have hgQ : ∀ (Q : wcEtAff X hU (TensorProduct Γ(X, U) R' R') ⟶ wcEtAff X hU R'),
      (g.hom.app (Opposite.op (wcEtAff X hU (TensorProduct Γ(X, U) R' R')))).hom
        ((E.obj.map Q.op).hom e) =
      wcConstSec X (ULift.{u+1} ℤ) (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) (ULift.up 1) := by
    intro Q
    calc (g.hom.app (Opposite.op (wcEtAff X hU (TensorProduct Γ(X, U) R' R')))).hom
          ((E.obj.map Q.op).hom e)
        = (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map Q.op).hom
            ((g.hom.app (Opposite.op (wcEtAff X hU R'))).hom e) :=
          NatTrans.naturality_apply g.hom Q.op e
      _ = wcConstSec X (ULift.{u+1} ℤ) (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) (ULift.up 1) := by
          rw [he]; exact hconstZ _ _ Q (ULift.up 1)
  have hd : (g.hom.app (Opposite.op (wcEtAff X hU (TensorProduct Γ(X, U) R' R')))).hom
      ((E.obj.map Q2.op).hom e - (E.obj.map Q1.op).hom e) = 0 := by
    rw [map_sub, hgQ Q2, hgQ Q1, sub_self]
  have hses := wc_sheaf_ses_sectionwise (Scheme.smallEtaleTopology X) f g w hS
  obtain ⟨l, hl⟩ := hses.2 _ _ hd
  have hl' : (f.hom.app (Opposite.op (wcEtAff X hU (TensorProduct Γ(X, U) R' R')))).hom l =
      (E.obj.map Q2.op).hom e - (E.obj.map Q1.op).hom e := hl

  have hcoc : (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map P13.op).hom l =
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map P12.op).hom l +
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map P23.op).hom l := by
    have key : (f.hom.app (Opposite.op
        (wcEtAff X hU (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R'))))).hom
        ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map P13.op).hom l -
        (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map P12.op).hom l -
        (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map P23.op).hom l) = 0 := by
      simp only [map_sub, ← hfnat, hl', ← hmap]
      rw [e1, e2, e3]
      abel
    have h0 := hses.1 _ _ key
    rw [sub_sub, sub_eq_zero] at h0
    exact h0

  have hLF := wc_et_const_sheaf_local_form X m
  choose Oset cst hOopen hxO hloc using
    fun x : (wcEtAff X hU (TensorProduct Γ(X, U) R' R')).left =>
      hLF.2 (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) l x
  have huniq : ∀ (V : X.Etale) (a b : ULift.{u+1} (ZMod m)), Nonempty V.left →
      ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a =
      ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom b → a = b := by
    intro V a b hne hab
    have h0 : ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom (a - b) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact hab
    rcases hLF.1 V (a - b) h0 with h | h
    · exact sub_eq_zero.mp h
    · exact (h.false hne.some).elim
  have huniq2 : ∀ (V : X.Etale) (a b c : ULift.{u+1} (ZMod m)), Nonempty V.left →
      ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom a =
      ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom b +
      ((toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app (Opposite.op V)).hom c → a = b + c := by
    intro V a b c hne habc
    apply huniq V _ _ hne
    rw [map_add]
    exact habc
  have hcompat : ∀ x y z : (wcEtAff X hU (TensorProduct Γ(X, U) R' R')).left,
      z ∈ Oset x → z ∈ Oset y → cst x = cst y := by
    intro x y z hzx hzy
    let Q : (wcEtAff X hU (TensorProduct Γ(X, U) R' R')).left.Opens :=
      (⟨Oset x, hOopen x⟩ : (wcEtAff X hU (TensorProduct Γ(X, U) R' R')).left.Opens) ⊓
        ⟨Oset y, hOopen y⟩
    have hrx : Set.range (wcEtOpenι X (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) Q).left ⊆
        Oset x := by
      change Set.range Q.ι ⊆ Oset x
      rw [Scheme.Opens.range_ι]
      intro p hp
      exact (TopologicalSpace.Opens.mem_inf.mp hp).1
    have hry : Set.range (wcEtOpenι X (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) Q).left ⊆
        Oset y := by
      change Set.range Q.ι ⊆ Oset y
      rw [Scheme.Opens.range_ι]
      intro p hp
      exact (TopologicalSpace.Opens.mem_inf.mp hp).2
    have h1 := hloc x _ (wcEtOpenι X (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) Q) hrx
    have h2 := hloc y _ (wcEtOpenι X (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) Q) hry
    refine huniq (wcEtOpen X (wcEtAff X hU (TensorProduct Γ(X, U) R' R')) Q) _ _ ?_
      (h1.symm.trans h2)
    exact (Scheme.Opens.nonempty_iff Q).mpr ⟨z, TopologicalSpace.Opens.mem_inf.mpr ⟨hzx, hzy⟩⟩
  have hlcf : IsLocallyConstant
      (fun x : (wcEtAff X hU (TensorProduct Γ(X, U) R' R')).left => (cst x).down) := by
    rw [IsLocallyConstant.iff_exists_open]
    intro x
    exact ⟨Oset x, hOopen x, hxO x, fun y hy => congrArg ULift.down (hcompat y x y (hxO y) hy)⟩
  let lc : LocallyConstant (PrimeSpectrum (TensorProduct Γ(X, U) R' R')) (ZMod m) :=
    ⟨fun x => (cst x).down, hlcf⟩
  refine ⟨lc, ?_, ?_⟩
  ·
    intro P
    have hlcP : ∀ (Q : wcEtAff X hU (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R')) ⟶
          wcEtAff X hU (TensorProduct Γ(X, U) R' R'))
        (φ : TensorProduct Γ(X, U) R' R' →+* TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R')),
        Q.left = Spec.map (CommRingCat.ofHom φ) →
        lc (PrimeSpectrum.comap φ P) = (cst (Q.left P)).down := by
      intro Q φ hQ
      rw [hQ]
      rfl
    have hSo : IsOpen (P12.left ⁻¹' Oset (P12.left P) ∩ P13.left ⁻¹' Oset (P13.left P) ∩
        P23.left ⁻¹' Oset (P23.left P)) :=
      (((hOopen _).preimage P12.left.continuous).inter
        ((hOopen _).preimage P13.left.continuous)).inter ((hOopen _).preimage P23.left.continuous)
    let NO : (wcEtAff X hU (TensorProduct Γ(X, U) R' (TensorProduct Γ(X, U) R' R'))).left.Opens :=
      ⟨P12.left ⁻¹' Oset (P12.left P) ∩ P13.left ⁻¹' Oset (P13.left P) ∩
        P23.left ⁻¹' Oset (P23.left P), hSo⟩
    have hPS : P ∈ P12.left ⁻¹' Oset (P12.left P) ∩ P13.left ⁻¹' Oset (P13.left P) ∩
        P23.left ⁻¹' Oset (P23.left P) := ⟨⟨hxO _, hxO _⟩, hxO _⟩
    have hne : Nonempty (NO : Scheme.{u}) := (Scheme.Opens.nonempty_iff NO).mpr ⟨P, hPS⟩
    have hmemN : ∀ y : (NO : Scheme.{u}), NO.ι y ∈ P12.left ⁻¹' Oset (P12.left P) ∩
        P13.left ⁻¹' Oset (P13.left P) ∩ P23.left ⁻¹' Oset (P23.left P) := by
      intro y
      have hy : NO.ι y ∈ (NO : Set _) := by
        rw [← Scheme.Opens.range_ι NO]
        exact ⟨y, rfl⟩
      exact hy
    have hr12 : Set.range (wcEtOpenι X _ NO ≫ P12).left ⊆ Oset (P12.left P) := by
      rintro _ ⟨y, rfl⟩
      obtain ⟨⟨h1, -⟩, -⟩ := hmemN y
      rw [hcompL]
      exact h1
    have hr13 : Set.range (wcEtOpenι X _ NO ≫ P13).left ⊆ Oset (P13.left P) := by
      rintro _ ⟨y, rfl⟩
      obtain ⟨⟨-, h1⟩, -⟩ := hmemN y
      rw [hcompL]
      exact h1
    have hr23 : Set.range (wcEtOpenι X _ NO ≫ P23).left ⊆ Oset (P23.left P) := by
      rintro _ ⟨y, rfl⟩
      obtain ⟨⟨-, -⟩, h1⟩ := hmemN y
      rw [hcompL]
      exact h1
    have h12 := hloc (P12.left P) _ (wcEtOpenι X _ NO ≫ P12) hr12
    have h13 := hloc (P13.left P) _ (wcEtOpenι X _ NO ≫ P13) hr13
    have h23 := hloc (P23.left P) _ (wcEtOpenι X _ NO ≫ P23) hr23
    have hc' := congrArg ((((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map
        (wcEtOpenι X _ NO).op).hom) hcoc
    rw [map_add, ← hmapL, ← hmapL, ← hmapL, h12, h13, h23] at hc'
    have hcst := huniq2 _ _ _ _ hne hc'
    exact (hlcP P13 _ hP13).trans ((congrArg ULift.down hcst).trans
      (congrArg₂ (· + ·) (hlcP P12 _ hP12).symm (hlcP P23 _ hP23).symm))
  ·
    intro Z z1 z2 wz c hw1 hw2 hconst
    have hwQ1 : wz ≫ Q1.left = z1.left := by rw [hQ1]; exact hw1
    have hwQ2 : wz ≫ Q2.left = z2.left := by rw [hQ2]; exact hw2
    have hwz : wz ≫ (wcEtAff X hU (TensorProduct Γ(X, U) R' R')).hom = Z.hom := by
      calc wz ≫ (wcEtAff X hU (TensorProduct Γ(X, U) R' R')).hom
          = wz ≫ (Q1.left ≫ (wcEtAff X hU R').hom) :=
            congrArg (fun h => wz ≫ h) (MorphismProperty.Over.w Q1).symm
        _ = (wz ≫ Q1.left) ≫ (wcEtAff X hU R').hom := (Category.assoc _ _ _).symm
        _ = z1.left ≫ (wcEtAff X hU R').hom :=
            congrArg (fun h => h ≫ (wcEtAff X hU R').hom) hwQ1
        _ = Z.hom := MorphismProperty.Over.w z1
    let W : Z ⟶ wcEtAff X hU (TensorProduct Γ(X, U) R' R') :=
      MorphismProperty.Over.homMk wz hwz trivial
    have hWQ1 : W ≫ Q1 = z1 := by
      apply MorphismProperty.Over.Hom.ext
      exact hwQ1
    have hWQ2 : W ≫ Q2 = z2 := by
      apply MorphismProperty.Over.Hom.ext
      exact hwQ2
    have key : ∀ (V'' : X.Etale) (e' : V'' ⟶ Z) (ζ : Z.left),
        Set.range e'.left ⊆ wz ⁻¹' Oset (wz ζ) →
        (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e'.op).hom
          ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map W.op).hom l) =
        (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map e'.op).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) Z (ULift.up c)) := by
      intro V'' e' ζ hζ
      have hr : Set.range (e' ≫ W).left ⊆ Oset (wz ζ) := by
        rintro _ ⟨y, rfl⟩
        rw [hcompL]
        exact hζ ⟨y, rfl⟩
      have hcz : cst (wz ζ) = ULift.up c := ULift.ext _ _ (hconst ζ)
      rw [← hmapL, hloc (wz ζ) V'' (e' ≫ W) hr, hcz, hconstM]
      rfl
    have hScov : Sieve.generate (fun (V' : X.Etale) (e' : V' ⟶ Z) =>
        ∃ ζ : Z.left, Set.range e'.left ⊆ wz ⁻¹' Oset (wz ζ)) ∈ Scheme.smallEtaleTopology X Z := by
      apply wc_etale_jointly_surjective_covers
      intro v
      let NO : Z.left.Opens := ⟨wz ⁻¹' Oset (wz v), (hOopen (wz v)).preimage wz.continuous⟩
      refine ⟨wcEtOpen X Z NO, wcEtOpenι X Z NO, ?_, ?_⟩
      · apply Sieve.le_generate
        refine ⟨v, ?_⟩
        change Set.range NO.ι ⊆ wz ⁻¹' Oset (wz v)
        rw [Scheme.Opens.range_ι]
        exact fun _ h => h
      · change v ∈ Set.range NO.ι
        rw [Scheme.Opens.range_ι]
        exact hxO (wz v)
    have hWl : (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map W.op).hom l =
        wcConstSec X (ULift.{u+1} (ZMod m)) Z (ULift.up c) := by
      refine ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).isSeparated Z _ hScov _ _ ?_
      intro V' h hh
      obtain ⟨V'', h', e', ⟨ζ, hζ⟩, rfl⟩ := hh
      change (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map (h' ≫ e').op).hom
          ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map W.op).hom l) =
        (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map (h' ≫ e').op).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) Z (ULift.up c))
      rw [hmapL, hmapL, key V'' e' ζ hζ]
    calc (E.obj.map z2.op).hom e - (E.obj.map z1.op).hom e
        = (E.obj.map (W ≫ Q2).op).hom e - (E.obj.map (W ≫ Q1).op).hom e := by
          rw [hWQ1, hWQ2]
      _ = (E.obj.map W.op).hom ((E.obj.map Q2.op).hom e - (E.obj.map Q1.op).hom e) := by
          rw [hmap, hmap, map_sub]
      _ = (E.obj.map W.op).hom
          ((f.hom.app (Opposite.op (wcEtAff X hU (TensorProduct Γ(X, U) R' R')))).hom l) := by
          rw [hl']
      _ = (f.hom.app (Opposite.op Z)).hom
          ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map W.op).hom l) := hfnat W l
      _ = (f.hom.app (Opposite.op Z)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) Z (ULift.up c)) := by
          rw [hWl]

theorem wc_tar_idem_cocycle : ∀ (R R' : Type u) [CommRing R] [CommRing R'] [Algebra R R'] (m : ℕ)
    [NeZero m] (lc : LocallyConstant (PrimeSpectrum (TensorProduct R R' R')) (ZMod m)),
    wcTarLcCoc R R' m lc →
    ∃ e : ZMod m → TensorProduct R R' R', wcTorDescCocyc R R' m e ∧
      ∀ (c : ZMod m) (P : PrimeSpectrum (TensorProduct R R' R')), e c ∉ P.asIdeal ↔ lc P = c :=
by
  intro R R' _ _ _ m _ lc hcoc
  classical

  have s1 : ∀ (A : Type u) [CommRing A] (x y : A), IsIdempotentElem x → IsIdempotentElem y →
      (∀ P : PrimeSpectrum A, x ∉ P.asIdeal ↔ y ∉ P.asIdeal) → x = y := by
    intro A _ x y hx hy H
    have key : ∀ x y : A, IsIdempotentElem x → IsIdempotentElem y →
        (∀ P : PrimeSpectrum A, x ∉ P.asIdeal → y ∉ P.asIdeal) → x * (1 - y) = 0 := by
      intro x y hx hy H
      apply IsIdempotentElem.eq_zero_of_isNilpotent (hx.mul hy.one_sub)
      rw [nilpotent_iff_mem_prime]
      intro J hJ
      by_cases hxJ : x ∈ J
      · exact J.mul_mem_right _ hxJ
      · have hyJ : y ∉ J := H ⟨J, hJ⟩ hxJ
        have h0 : y * (1 - y) ∈ J := by
          rw [mul_sub, mul_one, hy.eq, sub_self]; exact J.zero_mem
        rcases hJ.mem_or_mem h0 with h | h
        · exact absurd h hyJ
        · exact J.mul_mem_left _ h
    have h1 := key x y hx hy (fun P => (H P).1)
    have h2 := key y x hy hx (fun P => (H P).2)
    have e1 : x = x * y := by rw [mul_sub, mul_one, sub_eq_zero] at h1; exact h1
    have e2 : y = y * x := by rw [mul_sub, mul_one, sub_eq_zero] at h2; exact h2
    calc x = x * y := e1
      _ = y * x := mul_comm _ _
      _ = y := e2.symm

  have s2 : ∀ (A : Type u) [CommRing A] (x : ZMod m → A),
      (∀ a b, a ≠ b → x a * x b = 0) → ∀ P : PrimeSpectrum A,
      ((∑ a, x a) ∉ P.asIdeal ↔ ∃ a, x a ∉ P.asIdeal) := by
    intro A _ x hx P
    constructor
    · intro h
      by_contra hc
      push_neg at hc
      exact h (Ideal.sum_mem _ (fun a _ => hc a))
    · rintro ⟨a0, ha0⟩ hs
      apply ha0
      have h1 : x a0 * ∑ a, x a = x a0 * x a0 := by
        rw [Finset.mul_sum, Fintype.sum_eq_single a0]
        intro a ha
        exact hx a0 a (Ne.symm ha)
      have h2 : x a0 * x a0 ∈ P.asIdeal := by
        rw [← h1]; exact P.asIdeal.mul_mem_left _ hs
      rcases P.isPrime.mem_or_mem h2 with h | h <;> exact h

  have s4 : ∀ (A : Type u) [CommRing A] (x : ZMod m → A), (∀ a, IsIdempotentElem (x a)) →
      (∀ a b, a ≠ b → x a * x b = 0) → IsIdempotentElem (∑ a, x a) := by
    intro A _ x hi ho
    exact (OrthogonalIdempotents.mk hi (fun a b hab => ho a b hab)).isIdempotentElem_sum

  have s3 : ∀ c : ZMod m, ∃ x : TensorProduct R R' R', IsIdempotentElem x ∧
      ∀ P : PrimeSpectrum (TensorProduct R R' R'), x ∉ P.asIdeal ↔ lc P = c := by
    intro c
    have hS : IsClopen {P | lc P = c} := lc.isLocallyConstant.isClopen_fiber c
    let C : TopologicalSpace.Clopens (PrimeSpectrum (TensorProduct R R' R')) := ⟨_, hS⟩
    let E := PrimeSpectrum.isIdempotentElemEquivClopens.symm C
    refine ⟨E.1, E.2, fun P => ?_⟩
    have h1 : (PrimeSpectrum.isIdempotentElemEquivClopens E).toOpens =
        PrimeSpectrum.basicOpen E.1 :=
      PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens E
    have h2 : PrimeSpectrum.isIdempotentElemEquivClopens E = C := OrderIso.apply_symm_apply _ _
    rw [h2] at h1
    have h3 : P ∈ C.toOpens ↔ P ∈ PrimeSpectrum.basicOpen E.1 := by rw [h1]
    rw [PrimeSpectrum.mem_basicOpen] at h3
    exact h3.symm
  choose e he hmem using s3

  have hortho : ∀ c c', c ≠ c' → e c * e c' = 0 := by
    intro c c' hcc'
    apply s1 _ _ _ ((he c).mul (he c')) IsIdempotentElem.zero
    intro P
    constructor
    · intro h
      exfalso
      have hc : e c ∉ P.asIdeal := fun h' => h (P.asIdeal.mul_mem_right _ h')
      have hc' : e c' ∉ P.asIdeal := fun h' => h (P.asIdeal.mul_mem_left _ h')
      exact hcc' (((hmem c P).1 hc).symm.trans ((hmem c' P).1 hc'))
    · intro h
      exact absurd P.asIdeal.zero_mem h

  have hsum : ∑ c, e c = 1 := by
    apply s1 _ _ _ (s4 _ e he hortho) IsIdempotentElem.one
    intro P
    constructor
    · intro _ h
      exact P.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h)
    · intro _
      exact (s2 _ e hortho P).2 ⟨lc P, (hmem (lc P) P).2 rfl⟩

  have gen : ∀ (φ13 φ12 φ23 : TensorProduct R R' R' →ₐ[R] TensorProduct R R' (TensorProduct R R' R')),
      (∀ P : PrimeSpectrum (TensorProduct R R' (TensorProduct R R' R')),
        lc (PrimeSpectrum.comap φ13.toRingHom P) =
          lc (PrimeSpectrum.comap φ12.toRingHom P) + lc (PrimeSpectrum.comap φ23.toRingHom P)) →
      ∀ c, φ13 (e c) = ∑ a, φ12 (e a) * φ23 (e (c - a)) := by
    intro φ13 φ12 φ23 H c
    have ht_idem : ∀ a, IsIdempotentElem (φ12 (e a) * φ23 (e (c - a))) :=
      fun a => ((he a).map φ12).mul ((he (c - a)).map φ23)
    have ht_orth : ∀ a b, a ≠ b →
        (φ12 (e a) * φ23 (e (c - a))) * (φ12 (e b) * φ23 (e (c - b))) = 0 := by
      intro a b hab
      rw [mul_mul_mul_comm, ← map_mul, hortho a b hab, map_zero, zero_mul]
    apply s1 _ _ _ ((he c).map φ13)
      (s4 _ (fun a => φ12 (e a) * φ23 (e (c - a))) ht_idem ht_orth)
    intro P
    have hprod : ∀ a, φ12 (e a) * φ23 (e (c - a)) ∉ P.asIdeal ↔
        (lc (PrimeSpectrum.comap φ12.toRingHom P) = a ∧
          lc (PrimeSpectrum.comap φ23.toRingHom P) = c - a) := by
      intro a
      constructor
      · intro h
        exact ⟨(hmem a (PrimeSpectrum.comap φ12.toRingHom P)).1
            (fun h' => h (P.asIdeal.mul_mem_right _ h')),
          (hmem (c - a) (PrimeSpectrum.comap φ23.toRingHom P)).1
            (fun h' => h (P.asIdeal.mul_mem_left _ h'))⟩
      · rintro ⟨h1, h2⟩ h
        have g1 : φ12 (e a) ∉ P.asIdeal := (hmem a (PrimeSpectrum.comap φ12.toRingHom P)).2 h1
        have g2 : φ23 (e (c - a)) ∉ P.asIdeal :=
          (hmem (c - a) (PrimeSpectrum.comap φ23.toRingHom P)).2 h2
        rcases P.isPrime.mem_or_mem h with h' | h'
        · exact g1 h'
        · exact g2 h'
    refine Iff.trans ?_ (s2 _ (fun a => φ12 (e a) * φ23 (e (c - a))) ht_orth P).symm
    refine Iff.trans (hmem c (PrimeSpectrum.comap φ13.toRingHom P)) ?_
    rw [H P]
    constructor
    · intro h
      exact ⟨lc (PrimeSpectrum.comap φ12.toRingHom P), (hprod _).2 ⟨rfl, eq_sub_of_add_eq' h⟩⟩
    · rintro ⟨a, ha⟩
      obtain ⟨h1, h2⟩ := (hprod a).1 ha
      rw [h1, h2]
      ring
  exact ⟨e, ⟨he, hortho, hsum, fun c => gen _ _ _ hcoc c⟩, hmem⟩

theorem wc_tar_copies_cover : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B]
    [Algebra R R'] [Algebra R B] (m : ℕ) [NeZero m] (ι : B →ₐ[R] (ZMod m → R')),
    Function.Surjective (PrimeSpectrum.comap (algebraMap R R')) →
    Function.Bijective (wcTorDescL R R' m B ι) →
    ∀ P : Spec (.of B), ∃ (h : ZMod m) (Q : Spec (.of R')),
      Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') h).comp ι.toRingHom)) Q = P :=
by
  intro R R' B _ _ _ _ _ m _ ι hsurj hbij P
  classical

  obtain ⟨x₀, hx⟩ := hsurj (PrimeSpectrum.comap (algebraMap R B) P)
  let x : Spec (.of R') := x₀
  have hx' : (Spec.map (CommRingCat.ofHom (algebraMap R R'))) x =
      (Spec.map (CommRingCat.ofHom (algebraMap R B))) P := by
    rw [Spec.map_apply, Spec.map_apply]
    exact hx

  obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback x P hx'

  let Q' : Spec (.of (TensorProduct R R' B)) := (pullbackSpecIso R R' B).hom z
  have hE1 : (Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R R' B).toRingHom)) Q' = P := by
    rw [← hz, ← pullbackSpecIso_hom_snd R R' B, Scheme.Hom.comp_apply]
    rfl
  have hP : ∀ b : B, b ∈ P.asIdeal ↔ ((1 : R') ⊗ₜ[R] b) ∈ Q'.asIdeal := by
    intro b
    rw [← hE1, Spec.map_apply]
    rfl

  let e := RingEquiv.ofBijective (wcTorDescL R R' m B ι) hbij
  have hL : ∀ b : B, wcTorDescL R R' m B ι ((1 : R') ⊗ₜ[R] b) = ι b := by
    intro b
    simp only [wcTorDescL, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  have he : ∀ b : B, e.symm (ι b) = (1 : R') ⊗ₜ[R] b := by
    intro b
    rw [RingEquiv.symm_apply_eq]
    exact (hL b).symm

  obtain ⟨h, Q, hQ⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq (R := fun _ : ZMod m => R')
    (PrimeSpectrum.comap (e.symm : (ZMod m → R') →+* TensorProduct R R' B) Q')
  let Q₁ : Spec (.of R') := Q
  refine ⟨h, Q₁, ?_⟩

  rw [Spec.map_apply]
  apply PrimeSpectrum.ext
  ext b
  rw [hP b, ← he b]
  have key : (ι b) ∈ (PrimeSpectrum.comap (e.symm : (ZMod m → R') →+* TensorProduct R R' B)
      Q').asIdeal ↔ ι b h ∈ Q.asIdeal := by
    rw [← hQ]
    rfl
  exact key.symm

theorem wc_tar_copies_overlap : ∀ (R R' B : Type u) [CommRing R] [CommRing R'] [CommRing B]
    [Algebra R R'] [Algebra R B] (m : ℕ) [NeZero m] (eI : ZMod m → TensorProduct R R' R')
    (ι : B →ₐ[R] (ZMod m → R')),
    (∀ b, wcTorDescCond R R' m eI (ι b)) → Function.Surjective (wcTorDescL R R' m B ι) →
    ∀ (Z : Scheme.{u}) (z1 z2 : Z ⟶ Spec (.of R')) (h1 h2 : ZMod m),
      z1 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') h1).comp ι.toRingHom)) =
      z2 ≫ Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') h2).comp ι.toRingHom)) →
      ∃ wz : Z ⟶ Spec (.of (TensorProduct R R' R')),
        wz ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) = z1 ∧
        wz ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) = z2 ∧
        ∀ ζ : Z, eI (h1 - h2) ∉ @PrimeSpectrum.asIdeal (TensorProduct R R' R') _ (wz ζ) :=
by
  intro R R' B _ _ _ _ _ m _ eI ι hDC hL Z z1 z2 h1 h2 hz
  classical

  have hj : ∀ h : ZMod m, ((Pi.evalRingHom (fun _ : ZMod m => R') h).comp ι.toRingHom).comp
      (algebraMap R B) = algebraMap R R' := by
    intro h
    ext r
    change ι (algebraMap R B r) h = algebraMap R R' r
    rw [ι.commutes]
    rfl
  have hSpec : ∀ h : ZMod m, Spec.map (CommRingCat.ofHom (algebraMap R R')) =
      Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') h).comp ι.toRingHom)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R B)) := by
    intro h
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hj h]
  have hz' : z1 ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) =
      z2 ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) := by
    calc z1 ≫ Spec.map (CommRingCat.ofHom (algebraMap R R'))
        = (z1 ≫ Spec.map (CommRingCat.ofHom
            ((Pi.evalRingHom (fun _ : ZMod m => R') h1).comp ι.toRingHom))) ≫
            Spec.map (CommRingCat.ofHom (algebraMap R B)) := by
          rw [Category.assoc, ← hSpec h1]
      _ = (z2 ≫ Spec.map (CommRingCat.ofHom
            ((Pi.evalRingHom (fun _ : ZMod m => R') h2).comp ι.toRingHom))) ≫
            Spec.map (CommRingCat.ofHom (algebraMap R B)) := by rw [hz]
      _ = z2 ≫ Spec.map (CommRingCat.ofHom (algebraMap R R')) := by
          rw [Category.assoc, ← hSpec h2]

  let w : Z ⟶ Spec (.of (TensorProduct R R' R')) :=
    Limits.pullback.lift z1 z2 hz' ≫ (pullbackSpecIso R R' R').hom
  have hw1 : w ≫ Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) = z1 := by
    simp only [w, Category.assoc, pullbackSpecIso_hom_fst, Limits.pullback.lift_fst]
  have hw2 : w ≫ Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) = z2 := by
    have this : (pullbackSpecIso R R' R').hom ≫ Spec.map
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          R' →ₐ[R] TensorProduct R R' R').toRingHom) =
        Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap R R')))
          (Spec.map (CommRingCat.ofHom (algebraMap R R'))) :=
      pullbackSpecIso_hom_snd R R' R'
    change Limits.pullback.lift z1 z2 hz' ≫ ((pullbackSpecIso R R' R').hom ≫ Spec.map
      (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        R' →ₐ[R] TensorProduct R R' R').toRingHom)) = z2
    rw [this, Limits.pullback.lift_snd]

  have hN : ∀ {C D : CommRingCat.{u}} (f : C ⟶ D) (v : Z ⟶ Spec D),
      (Scheme.ΓSpecIso C).inv ≫ (v ≫ Spec.map f).appTop =
        f ≫ (Scheme.ΓSpecIso D).inv ≫ v.appTop := by
    intro C D f v
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]
  let φ : TensorProduct R R' R' →+* Γ(Z, ⊤) :=
    ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv ≫ w.appTop).hom
  let ψ1 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z1.appTop).hom
  let ψ2 : R' →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (.of R')).inv ≫ z2.appTop).hom
  have hψ1 : ∀ x : R', φ (x ⊗ₜ[R] 1) = ψ1 x := by
    intro x
    have e := hN (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) w
    rw [hw1] at e
    exact (congrArg (fun k => k.hom x) e).symm
  have hψ2 : ∀ y : R', φ ((1 : R') ⊗ₜ[R] y) = ψ2 y := by
    intro y
    have e := hN (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) w
    rw [hw2] at e
    exact (congrArg (fun k => k.hom y) e).symm
  have hφ : ∀ x y : R', φ (x ⊗ₜ[R] y) = ψ1 x * ψ2 y := by
    intro x y
    have : x ⊗ₜ[R] y = (x ⊗ₜ[R] (1 : R')) * ((1 : R') ⊗ₜ[R] y) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [this, map_mul, hψ1, hψ2]
  have hψ : ∀ b : B, ψ1 (ι b h1) = ψ2 (ι b h2) := by
    intro b
    have e1 := hN (CommRingCat.ofHom
      ((Pi.evalRingHom (fun _ : ZMod m => R') h1).comp ι.toRingHom)) z1
    have e2 := hN (CommRingCat.ofHom
      ((Pi.evalRingHom (fun _ : ZMod m => R') h2).comp ι.toRingHom)) z2
    rw [hz, e2] at e1
    exact (congrArg (fun k => k.hom b) e1).symm

  have hLt : ∀ (r : R') (b : B) (h : ZMod m), wcTorDescL R R' m B ι (r ⊗ₜ[R] b) h = r * ι b h := by
    intro r b h
    simp [wcTorDescL, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply]
  have hK : ∀ y : TensorProduct R R' B,
      φ (∑ d, eI d * ((wcTorDescL R R' m B ι y) (h2 + d) ⊗ₜ[R] (1 : R'))) =
        ψ1 ((wcTorDescL R R' m B ι y) h1) := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul r b =>
      simp only [hLt]
      have e : ∑ d, eI d * ((r * ι b (h2 + d)) ⊗ₜ[R] (1 : R')) =
          (r ⊗ₜ[R] (1 : R')) * ∑ d, eI d * (ι b (h2 + d) ⊗ₜ[R] (1 : R')) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [show (r * ι b (h2 + d)) ⊗ₜ[R] (1 : R') =
            (r ⊗ₜ[R] (1 : R')) * (ι b (h2 + d) ⊗ₜ[R] (1 : R')) by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]]
        ring
      rw [e, ← hDC b h2, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, hφ, ← hψ,
        map_mul]
    | add y1 y2 ih1 ih2 =>
      simp only [map_add, Pi.add_apply, TensorProduct.add_tmul, mul_add,
        Finset.sum_add_distrib]
      rw [ih1, ih2]

  have hone : φ (eI (h1 - h2)) = 1 := by
    obtain ⟨y, hy⟩ := hL (Pi.single h1 1)
    have e := hK y
    rw [hy, Pi.single_eq_same, map_one] at e
    rw [← e]
    congr 1
    rw [Finset.sum_eq_single (h1 - h2)]
    · rw [add_sub_cancel, Pi.single_eq_same, ← Algebra.TensorProduct.one_def, mul_one]
    · intro d _ hd
      have hne : h2 + d ≠ h1 := by
        intro hc
        apply hd
        rw [← hc, add_sub_cancel_left]
      rw [Pi.single_eq_of_ne hne, TensorProduct.zero_tmul, mul_zero]
    · intro hc
      exact absurd (Finset.mem_univ _) hc
  have hunit : IsUnit ((Scheme.Hom.app w ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
      (eI (h1 - h2)))) := by
    have : (Scheme.Hom.app w ⊤) ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv
        (eI (h1 - h2))) = φ (eI (h1 - h2)) := rfl
    rw [this, hone]
    exact isUnit_one

  refine ⟨w, hw1, hw2, fun ζ => ?_⟩
  have hpre := Scheme.Hom.preimage_basicOpen w (U := ⊤)
    ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (eI (h1 - h2)))
  have hmem : ζ ∈ w ⁻¹ᵁ (Spec (.of (TensorProduct R R' R'))).basicOpen
      ((Scheme.ΓSpecIso (.of (TensorProduct R R' R'))).inv (eI (h1 - h2))) := by
    rw [hpre, Scheme.basicOpen_of_isUnit _ hunit]
    trivial
  rw [Scheme.Hom.mem_preimage, basicOpen_eq_of_affine] at hmem
  exact (PrimeSpectrum.mem_basicOpen _ _).mp hmem

theorem wc_tar_glue_copies : ∀ (X : Scheme.{u}) (m : ℕ)
    (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
    (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))), f ≫ g = 0 →
    ∀ (Vo To : X.Etale) (κ : ZMod m → (To ⟶ Vo)), (∀ v : Vo.left, ∃ h t, (κ h).left t = v) →
    ∀ e : E.obj.obj (Opposite.op To),
    (g.hom.app (Opposite.op To)).hom e = wcConstSec X (ULift.{u+1} ℤ) To (ULift.up 1) →
    (∀ (Z : X.Etale) (z1 z2 : Z ⟶ To) (h1 h2 : ZMod m), z1 ≫ κ h1 = z2 ≫ κ h2 →
      (E.obj.map z2.op).hom e - (E.obj.map z1.op).hom e =
        (f.hom.app (Opposite.op Z)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) Z (ULift.up (h1 - h2)))) →
    ∃ s : E.obj.obj (Opposite.op Vo),
      (g.hom.app (Opposite.op Vo)).hom s = wcConstSec X (ULift.{u+1} ℤ) Vo (ULift.up 1) ∧
      ∀ (α : Vo ⟶ Vo) (c : ZMod m), (∀ h, κ h ≫ α = κ (h + c)) →
        (E.obj.map α.op).hom s =
          s + (f.hom.app (Opposite.op Vo)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) Vo (ULift.up c)) :=
by
  intro X m E f g w Vo To κ hsurj e he hOV

  have hmapE : ∀ {A B C : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map (a₁ ≫ b₁).op).hom x = (E.obj.map a₁.op).hom ((E.obj.map b₁.op).hom x) := by
    intro A B C a₁ b₁ x
    rw [op_comp, Functor.map_comp]
    rfl

  have hconstZ : ∀ (V₁ V₂ : X.Etale) (k : V₂ ⟶ V₁) (x : ULift.{u+1} ℤ),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map k.op).hom (wcConstSec X (ULift.{u+1} ℤ) V₁ x) =
        wcConstSec X (ULift.{u+1} ℤ) V₂ x := by
    intro V₁ V₂ k x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) k.op x).symm
  have hconstM : ∀ (V₁ V₂ : X.Etale) (k : V₂ ⟶ V₁) (x : ULift.{u+1} (ZMod m)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map k.op).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) V₁ x) =
        wcConstSec X (ULift.{u+1} (ZMod m)) V₂ x := by
    intro V₁ V₂ k x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) k.op x).symm

  have haddM : ∀ (W : X.Etale) (a b : ZMod m),
      wcConstSec X (ULift.{u+1} (ZMod m)) W (ULift.up (a + b)) =
        wcConstSec X (ULift.{u+1} (ZMod m)) W (ULift.up a) +
          wcConstSec X (ULift.{u+1} (ZMod m)) W (ULift.up b) := by
    intro W a b
    exact map_add ((toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
        (Opposite.op W)).hom (ULift.up a) (ULift.up b)

  have hfnat : ∀ {A B : X.Etale} (φ : A ⟶ B)
      (y : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op B)),
      (E.obj.map φ.op).hom ((f.hom.app (Opposite.op B)).hom y) =
        (f.hom.app (Opposite.op A)).hom
          ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map φ.op).hom y) := by
    intro A B φ y
    exact (NatTrans.naturality_apply f.hom φ.op y).symm
  have hgnat : ∀ {A B : X.Etale} (φ : A ⟶ B) (y : E.obj.obj (Opposite.op B)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map φ.op).hom ((g.hom.app (Opposite.op B)).hom y) =
        (g.hom.app (Opposite.op A)).hom ((E.obj.map φ.op).hom y) := by
    intro A B φ y
    exact (NatTrans.naturality_apply g.hom φ.op y).symm

  have hgf : ∀ (W : X.Etale)
      (y : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op W)),
      (g.hom.app (Opposite.op W)).hom ((f.hom.app (Opposite.op W)).hom y) = 0 := by
    intro W y
    have h0 := congrArg (fun k => (k.hom.app (Opposite.op W)).hom y) w
    exact h0

  have hcov : Sieve.generate (Presieve.ofArrows (fun _ : ZMod m => To) κ) ∈
      Scheme.smallEtaleTopology X Vo := by
    change Sieve.generate (Presieve.ofArrows (fun _ : ZMod m => To) κ) ∈
      Scheme.smallGrothendieckTopology @Etale X Vo
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    obtain ⟨h, t, ht⟩ := hsurj v
    have hEt : Etale (κ h).left := inferInstance
    exact ⟨To, κ h, t, Sieve.le_generate (Presieve.ofArrows (fun _ : ZMod m => To) κ) _ (κ h)
      (Presieve.ofArrows.mk h), hEt, ht⟩

  have hsep : ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (a b : F.obj.obj (Opposite.op Vo)),
      (∀ h, (F.obj.map (κ h).op).hom a = (F.obj.map (κ h).op).hom b) → a = b := by
    intro F a b hab
    refine F.isSeparated Vo _ hcov a b ?_
    intro Y k hk
    obtain ⟨Z, k', π', hπ', rfl⟩ := hk
    rcases hπ' with ⟨h⟩
    change (F.obj.map (k' ≫ κ h).op).hom a = (F.obj.map (k' ≫ κ h).op).hom b
    rw [op_comp, Functor.map_comp]
    change (F.obj.map k'.op).hom ((F.obj.map (κ h).op).hom a) =
      (F.obj.map k'.op).hom ((F.obj.map (κ h).op).hom b)
    rw [hab h]

  let P := E.obj ⋙ forget AddCommGrpCat.{u+1}
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology X) P :=
    (isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology X) P).1
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) E.obj
        (forget AddCommGrpCat.{u+1})).1 E.property)
  have hSF : Presieve.IsSheafFor P (Presieve.ofArrows (fun _ : ZMod m => To) κ) :=
    hP.isSheafFor _ hcov
  have hA := (Presieve.isSheafFor_arrows_iff P κ).1 hSF

  let x : ZMod m → E.obj.obj (Opposite.op To) := fun h =>
    e + (f.hom.app (Opposite.op To)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) To (ULift.up h))
  have hxdef : ∀ h, x h =
      e + (f.hom.app (Opposite.op To)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) To (ULift.up h)) :=
    fun h => rfl
  have hres : ∀ {A : X.Etale} (φ : A ⟶ To) (h : ZMod m),
      (E.obj.map φ.op).hom (x h) = (E.obj.map φ.op).hom e +
        (f.hom.app (Opposite.op A)).hom (wcConstSec X (ULift.{u+1} (ZMod m)) A (ULift.up h)) := by
    intro A φ h
    rw [hxdef, map_add, hfnat, hconstM]
  have hx : Presieve.Arrows.Compatible P κ x := by
    intro h1 h2 Z z1 z2 heq
    change (E.obj.map z1.op).hom (x h1) = (E.obj.map z2.op).hom (x h2)
    rw [hres, hres, eq_add_of_sub_eq' (hOV Z z1 z2 h1 h2 heq), add_assoc, ← map_add, ← haddM,
      sub_add_cancel]
  obtain ⟨s, hs, -⟩ := hA x hx
  have hs' : ∀ h, (E.obj.map (κ h).op).hom s = x h := hs
  refine ⟨s, ?_, ?_⟩
  · apply hsep
    intro h
    rw [hgnat, hs', hconstZ, hxdef, map_add, he, hgf, add_zero]
  · intro α c hα
    apply hsep E
    intro h
    have e1 : (E.obj.map (κ h).op).hom ((E.obj.map α.op).hom s) = x (h + c) := by
      rw [← hmapE, hα h, hs']
    have e2 : (E.obj.map (κ h).op).hom (s + (f.hom.app (Opposite.op Vo)).hom
        (wcConstSec X (ULift.{u+1} (ZMod m)) Vo (ULift.up c))) =
        x h + (f.hom.app (Opposite.op To)).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) To (ULift.up c)) := by
      rw [map_add, hs', hfnat, hconstM]
    refine e1.trans (Eq.trans ?_ e2.symm)
    rw [hxdef, hxdef, haddM, map_add, add_assoc]

theorem wc_tar_fet_transport : ∀ {Y Y' V : Scheme.{u}} (p : V ⟶ Y) (m : ℕ) (a : ZMod m → (V ⟶ V))
    (e : Y ≅ Y'), wcFetTorsor p m a → wcFetTorsor (p ≫ e.hom) m a :=
by
  intro Y Y' V p m a e t
  haveI := t.finite
  haveI := t.etale
  have hact : ∀ c, a c ≫ (p ≫ e.hom) = p ≫ e.hom := fun c => by
    rw [← Category.assoc, t.act_p c]
  have hΦw : Limits.pullback.fst p p ≫ (p ≫ e.hom) = Limits.pullback.snd p p ≫ (p ≫ e.hom) := by
    rw [← Category.assoc, Limits.pullback.condition, Category.assoc]
  have hΨw : Limits.pullback.fst (p ≫ e.hom) (p ≫ e.hom) ≫ p =
      Limits.pullback.snd (p ≫ e.hom) (p ≫ e.hom) ≫ p := by
    rw [← cancel_mono e.hom, Category.assoc, Category.assoc]
    exact Limits.pullback.condition
  let Φ : Limits.pullback p p ⟶ Limits.pullback (p ≫ e.hom) (p ≫ e.hom) :=
    Limits.pullback.lift _ _ hΦw
  let Ψ : Limits.pullback (p ≫ e.hom) (p ≫ e.hom) ⟶ Limits.pullback p p :=
    Limits.pullback.lift _ _ hΨw
  have hΦ1 : Φ ≫ Limits.pullback.fst (p ≫ e.hom) (p ≫ e.hom) = Limits.pullback.fst p p :=
    Limits.pullback.lift_fst _ _ _
  have hΦ2 : Φ ≫ Limits.pullback.snd (p ≫ e.hom) (p ≫ e.hom) = Limits.pullback.snd p p :=
    Limits.pullback.lift_snd _ _ _
  have hΨ1 : Ψ ≫ Limits.pullback.fst p p = Limits.pullback.fst (p ≫ e.hom) (p ≫ e.hom) :=
    Limits.pullback.lift_fst _ _ _
  have hΨ2 : Ψ ≫ Limits.pullback.snd p p = Limits.pullback.snd (p ≫ e.hom) (p ≫ e.hom) :=
    Limits.pullback.lift_snd _ _ _
  have h1 : Φ ≫ Ψ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · first
        | rw [Category.assoc, hΨ1, hΦ1, Category.id_comp]
        | erw [Category.assoc, hΨ1, hΦ1, Category.id_comp]
    · first
        | rw [Category.assoc, hΨ2, hΦ2, Category.id_comp]
        | erw [Category.assoc, hΨ2, hΦ2, Category.id_comp]
  have h2 : Ψ ≫ Φ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · first
        | rw [Category.assoc, hΦ1, hΨ1, Category.id_comp]
        | erw [Category.assoc, hΦ1, hΨ1, Category.id_comp]
    · first
        | rw [Category.assoc, hΦ2, hΨ2, Category.id_comp]
        | erw [Category.assoc, hΦ2, hΨ2, Category.id_comp]
  haveI hΦiso : IsIso Φ := ⟨⟨Ψ, h1, h2⟩⟩
  have hΓ : ∀ c, Limits.pullback.lift (a c) (𝟙 V)
        ((hact c).trans (Category.id_comp (p ≫ e.hom)).symm) =
      Limits.pullback.lift (a c) (𝟙 V) ((t.act_p c).trans (Category.id_comp p).symm) ≫ Φ := by
    intro c
    apply Limits.pullback.hom_ext
    · first
        | rw [Category.assoc, hΦ1, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
        | erw [Category.assoc, hΦ1, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
    · first
        | rw [Category.assoc, hΦ2, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
        | erw [Category.assoc, hΦ2, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
  have hrange : ∀ c, Set.range (Limits.pullback.lift (a c) (𝟙 V)
        ((hact c).trans (Category.id_comp (p ≫ e.hom)).symm)) =
      Φ '' Set.range (Limits.pullback.lift (a c) (𝟙 V)
        ((t.act_p c).trans (Category.id_comp p).symm)) := by
    intro c
    rw [hΓ c]
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      exact ⟨_, ⟨v, rfl⟩, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
      exact ⟨v, Scheme.Hom.comp_apply _ _ _⟩
  have hinj : Function.Injective Φ := Φ.injective
  have hsurj : Function.Surjective Φ := Φ.surjective
  refine ⟨inferInstance, inferInstance, ?_, hact, t.act_zero, t.act_add, ?_, ?_, ?_⟩
  · rw [Set.eq_univ_iff_forall]
    intro y
    obtain ⟨v, hv⟩ : e.inv y ∈ Set.range p := by rw [t.surj]; trivial
    refine ⟨v, ?_⟩
    rw [Scheme.Hom.comp_apply, hv, ← Scheme.Hom.comp_apply, e.inv_hom_id]
    rfl
  · intro c
    rw [hΓ c]
    haveI := t.graph_open c
    infer_instance
  · intro c c' hcc'
    rw [hrange c, hrange c', Set.disjoint_image_iff hinj]
    exact t.graph_disj hcc'
  · rw [Set.iUnion_congr hrange, ← Set.image_iUnion, t.graph_cover,
      Set.image_univ_of_surjective hsurj]

theorem wc_et_ses_torsor_affine_reduction : wcTorDescHyp.{u} → ∀ (X : Scheme.{u}) (m : ℕ), m ≠ 0 →
    ∀ (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
      (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0),
      (ShortComplex.mk f g w).ShortExact →
      ∀ U : X.Opens, IsAffineOpen U → wcTorLocRep f g U :=
by
  intro hdesc X m hm E f g w hS U hU
  haveI : NeZero m := ⟨hm⟩
  have hepi : Epi g := hS.epi_g

  obtain ⟨R', _, _, _, hsurj, e, he⟩ := wc_tar_cover X E g hepi U hU

  obtain ⟨lc, hcoc, hdiff⟩ := wc_tar_lc_cocycle X m E f g w hS U hU R' e he

  obtain ⟨eI, hcocyc, H1⟩ := wc_tar_idem_cocycle Γ(X, U) R' m lc hcoc
  haveI : Module.FaithfullyFlat Γ(X, U) R' := Module.FaithfullyFlat.of_comap_surjective hsurj

  obtain ⟨B, _, _, ι, σ, -, hrange, hshift, hbij, ht0⟩ := hdesc Γ(X, U) R' m eI hcocyc
  have hιalg : ∀ h : ZMod m, ((Pi.evalRingHom (fun _ : ZMod m => R') h).comp ι.toRingHom).comp
      (algebraMap Γ(X, U) B) = algebraMap Γ(X, U) R' := by
    intro h
    ext r
    change ι (algebraMap Γ(X, U) B r) h = algebraMap Γ(X, U) R' r
    rw [ι.commutes]
    rfl

  have ht : wcFetTorsor (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫ hU.isoSpec.inv) m
      (fun c => Spec.map (CommRingCat.ofHom (σ c).toRingHom)) :=
    wc_tar_fet_transport _ m _ hU.isoSpec.symm ht0
  haveI := ht0.etale
  have hE : Etale ((Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫ hU.isoSpec.inv) ≫ U.ι) := by
    infer_instance
  have hpUι : (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫ hU.isoSpec.inv) ≫ U.ι =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫ hU.fromSpec := by
    rw [Category.assoc, IsAffineOpen.isoSpec_inv_ι]

  let κ : ZMod m → (wcEtAff X hU R' ⟶
      wcTorsorEt ((Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫ hU.isoSpec.inv) ≫ U.ι) hE) :=
    fun h => MorphismProperty.Over.homMk
      (Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') h).comp ι.toRingHom)))
      (by
        change Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') h).comp
            ι.toRingHom)) ≫ ((Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫
              hU.isoSpec.inv) ≫ U.ι) =
          Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) R')) ≫ hU.fromSpec
        rw [hpUι, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hιalg h])
      trivial

  have hjs : ∀ v : (wcTorsorEt ((Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫
      hU.isoSpec.inv) ≫ U.ι) hE).left, ∃ h t, (κ h).left t = v := by
    intro v
    obtain ⟨h, Q, hQ⟩ := wc_tar_copies_cover Γ(X, U) R' B m ι hsurj hbij v
    exact ⟨h, Q, hQ⟩

  have hDC : ∀ b, wcTorDescCond Γ(X, U) R' m eI (ι b) := fun b => (hrange (ι b)).1 ⟨b, rfl⟩
  have hcompat : ∀ (Z : X.Etale) (z1 z2 : Z ⟶ wcEtAff X hU R') (h1 h2 : ZMod m),
      z1 ≫ κ h1 = z2 ≫ κ h2 →
      (E.obj.map z2.op).hom e - (E.obj.map z1.op).hom e =
        (f.hom.app (Opposite.op Z)).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) Z (ULift.up (h1 - h2))) := by
    intro Z z1 z2 h1 h2 hz
    have hz' : z1.left ≫ Spec.map (CommRingCat.ofHom
          ((Pi.evalRingHom (fun _ : ZMod m => R') h1).comp ι.toRingHom)) =
        z2.left ≫ Spec.map (CommRingCat.ofHom
          ((Pi.evalRingHom (fun _ : ZMod m => R') h2).comp ι.toRingHom)) := by
      have hz0 := congrArg (fun k : Z ⟶ wcTorsorEt ((Spec.map (CommRingCat.ofHom
        (algebraMap Γ(X, U) B)) ≫ hU.isoSpec.inv) ≫ U.ι) hE => k.left) hz
      exact hz0
    obtain ⟨wz, hw1, hw2, hwI⟩ := wc_tar_copies_overlap Γ(X, U) R' B m eI ι hDC hbij.2
      Z.left z1.left z2.left h1 h2 hz'
    exact hdiff Z z1 z2 wz (h1 - h2) hw1 hw2 (fun ζ => (H1 (h1 - h2) (wz ζ)).1 (hwI ζ))

  obtain ⟨s, hs1, hs2⟩ := wc_tar_glue_copies X m E f g w _ _ κ hjs e he hcompat
  refine ⟨Spec (.of B), Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) B)) ≫ hU.isoSpec.inv,
    fun c => Spec.map (CommRingCat.ofHom (σ c).toRingHom), ht, hE, s, ?_⟩
  refine And.intro hs1 (fun c => ?_)
  apply hs2
  intro h
  apply MorphismProperty.Over.Hom.ext
  change Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') h).comp
      ι.toRingHom)) ≫ Spec.map (CommRingCat.ofHom (σ c).toRingHom) =
    Spec.map (CommRingCat.ofHom ((Pi.evalRingHom (fun _ : ZMod m => R') (h + c)).comp ι.toRingHom))
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  ext b
  exact hshift c b h

theorem wc_sch_rel_glue : ∀ (X : Scheme.{u}) (J : Type u) (U : J → X.Opens) (V : J → Scheme.{u})
    (q : ∀ i, V i ⟶ X), (∀ i, Set.range (q i) ⊆ (U i : Set X)) →
    ∀ (τ : ∀ i j, ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) ⟶ V j),
    (∀ i j, τ i j ≫ q j = (q i ⁻¹ᵁ U j).ι ≫ q i) →
    (∀ i (T : Scheme.{u}) (h : T ⟶ ((q i ⁻¹ᵁ U i : (V i).Opens) : Scheme.{u})),
      h ≫ τ i i = h ≫ (q i ⁻¹ᵁ U i).ι) →
    (∀ i j k (T : Scheme.{u}) (h₁ : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}))
      (h₂ : T ⟶ ((q j ⁻¹ᵁ U k : (V j).Opens) : Scheme.{u}))
      (h₃ : T ⟶ ((q i ⁻¹ᵁ U k : (V i).Opens) : Scheme.{u})),
      h₂ ≫ (q j ⁻¹ᵁ U k).ι = h₁ ≫ τ i j → h₃ ≫ (q i ⁻¹ᵁ U k).ι = h₁ ≫ (q i ⁻¹ᵁ U j).ι →
      h₂ ≫ τ j k = h₃ ≫ τ i k) →
    ∃ (W : Scheme.{u}) (p : W ⟶ X) (ι : ∀ i, V i ⟶ W),
      (∀ i, IsOpenImmersion (ι i)) ∧ (∀ i, ι i ≫ p = q i) ∧
      (∀ i, Set.range (ι i) = p ⁻¹' (U i : Set X)) ∧ (∀ w : W, ∃ i y, ι i y = w) ∧
      (∀ i j, (q i ⁻¹ᵁ U j).ι ≫ ι i = τ i j ≫ ι j) ∧
      (∀ i j (T : Scheme.{u}) (h₁ : T ⟶ V i) (h₂ : T ⟶ V j), h₁ ≫ ι i = h₂ ≫ ι j →
        ∃ h' : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}),
          h' ≫ (q i ⁻¹ᵁ U j).ι = h₁ ∧ h' ≫ τ i j = h₂) :=
by
  intro X J U V q hq τ hτ hid hcoc

  have hR : ∀ i j, Set.range ⇑(τ i j) ⊆ Set.range ⇑(q j ⁻¹ᵁ U i).ι := by
    intro i j
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    have e := congrArg (fun φ => φ y) (hτ i j)
    simp only [Scheme.Hom.comp_apply] at e
    rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, e]
    exact hq i ⟨_, rfl⟩
  let τ' : ∀ i j, ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) ⟶
      ((q j ⁻¹ᵁ U i : (V j).Opens) : Scheme.{u}) :=
    fun i j => IsOpenImmersion.lift (q j ⁻¹ᵁ U i).ι (τ i j) (hR i j)
  have hτ' : ∀ i j, τ' i j ≫ (q j ⁻¹ᵁ U i).ι = τ i j := fun i j =>
    IsOpenImmersion.lift_fac _ _ _

  have hS : ∀ i, Function.Surjective ⇑(q i ⁻¹ᵁ U i).ι := by
    intro i v
    refine ⟨⟨v, (Scheme.Hom.mem_preimage (q i)).2 (hq i ⟨v, rfl⟩)⟩, ?_⟩
    exact Scheme.Opens.ι_apply _ _
  have hiso : ∀ i, IsIso (q i ⁻¹ᵁ U i).ι := by
    intro i
    rw [isIso_iff_isOpenImmersion_and_epi_base]
    refine ⟨inferInstance, ?_⟩
    rw [TopCat.epi_iff_surjective]
    exact hS i

  have hInv : ∀ i j, τ' i j ≫ τ j i = (q i ⁻¹ᵁ U j).ι := by
    intro i j
    have hκR : Set.range ⇑(q i ⁻¹ᵁ U j).ι ⊆ Set.range ⇑(q i ⁻¹ᵁ U i).ι := by
      rw [(hS i).range_eq]; exact Set.subset_univ _
    let κ := IsOpenImmersion.lift (q i ⁻¹ᵁ U i).ι (q i ⁻¹ᵁ U j).ι hκR
    have hκ : κ ≫ (q i ⁻¹ᵁ U i).ι = (q i ⁻¹ᵁ U j).ι := IsOpenImmersion.lift_fac _ _ _
    have h1 := hcoc i j i _ (𝟙 _) (τ' i j) κ (by rw [hτ', Category.id_comp])
      (by rw [hκ, Category.id_comp])
    rw [h1, hid i _ κ, hκ]

  have hTid : ∀ i, τ' i i = 𝟙 _ := by
    intro i
    rw [← cancel_mono (q i ⁻¹ᵁ U i).ι, hτ', Category.id_comp]
    simpa using hid i _ (𝟙 _)

  have ht'ex : ∀ i j k, ∃ t : Limits.pullback (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι ⟶
      Limits.pullback (q j ⁻¹ᵁ U k).ι (q j ⁻¹ᵁ U i).ι,
      t ≫ Limits.pullback.snd (q j ⁻¹ᵁ U k).ι (q j ⁻¹ᵁ U i).ι =
        Limits.pullback.fst (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι ≫ τ' i j := by
    intro i j k
    have hr : Set.range ⇑(Limits.pullback.fst (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι ≫ τ i j) ⊆
        Set.range ⇑(q j ⁻¹ᵁ U k).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have e1 := congrArg (fun φ => φ z)
        (Limits.pullback.condition (f := (q i ⁻¹ᵁ U j).ι) (g := (q i ⁻¹ᵁ U k).ι))
      have e2 := congrArg (fun φ => φ (Limits.pullback.fst (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι z))
        (hτ i j)
      simp only [Scheme.Hom.comp_apply] at e1 e2 ⊢
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, e2, e1]
      have hv0 : (q i ⁻¹ᵁ U k).ι (Limits.pullback.snd (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι z) ∈
          Set.range ⇑(q i ⁻¹ᵁ U k).ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι, SetLike.mem_coe] at hv0
      exact (Scheme.Hom.mem_preimage (q i)).mp hv0
    let y₀ := IsOpenImmersion.lift (q j ⁻¹ᵁ U k).ι _ hr
    have hy₀ : y₀ ≫ (q j ⁻¹ᵁ U k).ι =
        Limits.pullback.fst (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι ≫ τ i j :=
      IsOpenImmersion.lift_fac _ _ hr
    refine ⟨Limits.pullback.lift y₀
      (Limits.pullback.fst (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι ≫ τ' i j) ?_,
      Limits.pullback.lift_snd _ _ _⟩
    rw [hy₀, Category.assoc, hτ']
  choose t' ht' using ht'ex

  have hF : ∀ a b c, t' a b c ≫ Limits.pullback.fst (q b ⁻¹ᵁ U c).ι (q b ⁻¹ᵁ U a).ι ≫
      (q b ⁻¹ᵁ U c).ι = Limits.pullback.fst (q a ⁻¹ᵁ U b).ι (q a ⁻¹ᵁ U c).ι ≫ τ a b := by
    intro a b c
    rw [Limits.pullback.condition, ← Category.assoc, ht', Category.assoc, hτ']

  have hcocy : ∀ i j k, t' i j k ≫ t' j k i ≫ t' k i j = 𝟙 _ := by
    intro i j k
    have hx := hcoc i j k _ (Limits.pullback.fst (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι)
      (t' i j k ≫ Limits.pullback.fst (q j ⁻¹ᵁ U k).ι (q j ⁻¹ᵁ U i).ι)
      (Limits.pullback.snd (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι)
      (by rw [Category.assoc, hF]) Limits.pullback.condition.symm
    have hz : t' i j k ≫ t' j k i ≫ Limits.pullback.fst (q k ⁻¹ᵁ U i).ι (q k ⁻¹ᵁ U j).ι =
        Limits.pullback.snd (q i ⁻¹ᵁ U j).ι (q i ⁻¹ᵁ U k).ι ≫ τ' i k := by
      rw [← cancel_mono (q k ⁻¹ᵁ U i).ι]
      simp only [Category.assoc]
      rw [hF j k i, hτ' i k, ← hx, Category.assoc]
    apply Limits.pullback.hom_ext
    · rw [← cancel_mono (q i ⁻¹ᵁ U j).ι]
      simp only [Category.assoc, Category.id_comp]
      rw [hF k i j, reassoc_of% hz, hInv i k]
      exact Limits.pullback.condition.symm
    · rw [← cancel_mono (q i ⁻¹ᵁ U k).ι]
      simp only [Category.assoc, Category.id_comp]
      rw [reassoc_of% (ht' k i j), hτ' k i, reassoc_of% hz, hInv i k]

  let D : Scheme.GlueData.{u} :=
    { J := J
      U := V
      V := fun ij => ((q ij.1 ⁻¹ᵁ U ij.2 : (V ij.1).Opens) : Scheme.{u})
      f := fun i j => (q i ⁻¹ᵁ U j).ι
      f_mono := fun i j => inferInstance
      f_hasPullback := fun i j k => inferInstance
      f_id := hiso
      t := τ'
      t_id := hTid
      t' := t'
      t_fac := ht'
      cocycle := hcocy
      f_open := fun i j => inferInstance }
  let ιW : ∀ i, V i ⟶ D.glued := fun i => D.ι i
  have hopen : ∀ i, IsOpenImmersion (ιW i) := fun i => Scheme.GlueData.ι_isOpenImmersion D i
  have hsurj : ∀ w : D.glued, ∃ i y, ιW i y = w := D.ι_jointly_surjective
  have hovl : ∀ i j, (q i ⁻¹ᵁ U j).ι ≫ ιW i = τ i j ≫ ιW j := by
    intro i j
    rw [← hτ' i j, Category.assoc]
    exact (D.glue_condition i j).symm
  have hfact : ∀ i j (T : Scheme.{u}) (h₁ : T ⟶ V i) (h₂ : T ⟶ V j), h₁ ≫ ιW i = h₂ ≫ ιW j →
      ∃ h' : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}),
        h' ≫ (q i ⁻¹ᵁ U j).ι = h₁ ∧ h' ≫ τ i j = h₂ := by
    intro i j T h₁ h₂ hw
    let h' : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) :=
      Limits.PullbackCone.IsLimit.lift (D.vPullbackConeIsLimit i j) h₁ h₂ hw
    have e1 : h' ≫ (q i ⁻¹ᵁ U j).ι = h₁ :=
      Limits.PullbackCone.IsLimit.lift_fst (D.vPullbackConeIsLimit i j) h₁ h₂ hw
    have e2 : h' ≫ τ' i j ≫ (q j ⁻¹ᵁ U i).ι = h₂ :=
      Limits.PullbackCone.IsLimit.lift_snd (D.vPullbackConeIsLimit i j) h₁ h₂ hw
    refine ⟨h', e1, ?_⟩
    rw [← hτ' i j]
    exact e2

  let 𝒰 : D.glued.OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) J V ιW hsurj hopen
  have hc : ∀ i j : J, Limits.pullback.fst (ιW i) (ιW j) ≫ q i =
      Limits.pullback.snd (ιW i) (ιW j) ≫ q j := by
    intro i j
    obtain ⟨h', hh1, hh2⟩ := hfact i j _ (Limits.pullback.fst (ιW i) (ιW j))
      (Limits.pullback.snd (ιW i) (ιW j)) Limits.pullback.condition
    rw [← hh1, ← hh2, Category.assoc, Category.assoc, hτ]
  let p : D.glued ⟶ X := 𝒰.glueMorphisms (fun i => q i) hc
  have hιp : ∀ i, ιW i ≫ p = q i := fun i => Scheme.Cover.ι_glueMorphisms 𝒰 (fun i => q i) hc i
  have hrange : ∀ i, Set.range (ιW i) = p ⁻¹' (U i : Set X) := by
    intro i
    ext w
    constructor
    · rintro ⟨v, rfl⟩
      have e := congrArg (fun φ => φ v) (hιp i)
      simp only [Scheme.Hom.comp_apply] at e
      rw [Set.mem_preimage, e]
      exact hq i ⟨v, rfl⟩
    · intro hw
      obtain ⟨j, y, rfl⟩ := hsurj w
      have e := congrArg (fun φ => φ y) (hιp j)
      simp only [Scheme.Hom.comp_apply] at e
      rw [Set.mem_preimage, e] at hw
      let y' : ↥(q j ⁻¹ᵁ U i) := ⟨y, (Scheme.Hom.mem_preimage (q j)).2 hw⟩
      refine ⟨τ j i y', ?_⟩
      have e2 := congrArg (fun φ => φ y') (hovl j i)
      simp only [Scheme.Hom.comp_apply] at e2
      exact e2.symm
  exact ⟨D.glued, p, ιW, hopen, hιp, hrange, hsurj, hovl, hfact⟩

theorem wc_sch_rel_glue_endo : ∀ (X : Scheme.{u}) (J : Type u) (U : J → X.Opens) (V : J → Scheme.{u})
    (q : ∀ i, V i ⟶ X) (τ : ∀ i j, ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) ⟶ V j)
    (W : Scheme.{u}) (ι : ∀ i, V i ⟶ W), (∀ i, IsOpenImmersion (ι i)) →
    (∀ w : W, ∃ i y, ι i y = w) →
    (∀ i j, (q i ⁻¹ᵁ U j).ι ≫ ι i = τ i j ≫ ι j) →
    (∀ i j (T : Scheme.{u}) (h₁ : T ⟶ V i) (h₂ : T ⟶ V j), h₁ ≫ ι i = h₂ ≫ ι j →
      ∃ h' : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}),
        h' ≫ (q i ⁻¹ᵁ U j).ι = h₁ ∧ h' ≫ τ i j = h₂) →
    ∀ (b : ∀ i, V i ⟶ V i), (∀ i, b i ≫ q i = q i) →
    (∀ i j (T : Scheme.{u}) (h h' : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u})),
      h' ≫ (q i ⁻¹ᵁ U j).ι = h ≫ (q i ⁻¹ᵁ U j).ι ≫ b i → h' ≫ τ i j = h ≫ τ i j ≫ b j) →
    ∃ β : W ⟶ W, ∀ i, ι i ≫ β = b i ≫ ι i :=
by
  intro X J U V q τ W ι hopen hsurj hovl hfact b hb hequiv
  let 𝒰 : W.OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) J V ι hsurj hopen
  have hc' : ∀ i j : J, Limits.pullback.fst (ι i) (ι j) ≫ (b i ≫ ι i) =
      Limits.pullback.snd (ι i) (ι j) ≫ (b j ≫ ι j) := by
    intro i j
    obtain ⟨h', hh1, hh2⟩ := hfact i j (Limits.pullback (ι i) (ι j))
      (Limits.pullback.fst (ι i) (ι j)) (Limits.pullback.snd (ι i) (ι j))
      Limits.pullback.condition
    have H : Set.range ⇑(h' ≫ (q i ⁻¹ᵁ U j).ι ≫ b i) ⊆ Set.range ⇑(q i ⁻¹ᵁ U j).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨t, rfl⟩
      have hv0 : (q i ⁻¹ᵁ U j).ι (h' t) ∈ Set.range ⇑(q i ⁻¹ᵁ U j).ι := ⟨h' t, rfl⟩
      rw [Scheme.Opens.range_ι, SetLike.mem_coe] at hv0
      have hv := (Scheme.Hom.mem_preimage (q i)).mp hv0
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, SetLike.mem_coe,
        Scheme.Hom.mem_preimage]
      have hq := congrArg (fun φ => φ ((q i ⁻¹ᵁ U j).ι (h' t))) (hb i)
      simp only [Scheme.Hom.comp_apply] at hq
      rw [hq]
      exact hv
    let L := IsOpenImmersion.lift (q i ⁻¹ᵁ U j).ι (h' ≫ (q i ⁻¹ᵁ U j).ι ≫ b i) H
    have hL : L ≫ (q i ⁻¹ᵁ U j).ι = h' ≫ (q i ⁻¹ᵁ U j).ι ≫ b i :=
      IsOpenImmersion.lift_fac _ _ H
    have he := hequiv i j _ h' L hL
    calc Limits.pullback.fst (ι i) (ι j) ≫ (b i ≫ ι i)
        = (h' ≫ (q i ⁻¹ᵁ U j).ι ≫ b i) ≫ ι i := by
          rw [← hh1]; simp only [Category.assoc]
      _ = L ≫ ((q i ⁻¹ᵁ U j).ι ≫ ι i) := by rw [← hL, Category.assoc]
      _ = L ≫ τ i j ≫ ι j := by rw [hovl i j]
      _ = (h' ≫ τ i j ≫ b j) ≫ ι j := by rw [← Category.assoc, he]
      _ = Limits.pullback.snd (ι i) (ι j) ≫ (b j ≫ ι j) := by
          rw [← hh2]; simp only [Category.assoc]
  exact ⟨𝒰.glueMorphisms (fun i => b i ≫ ι i) hc',
    fun i => Scheme.Cover.ι_glueMorphisms 𝒰 (fun i => b i ≫ ι i) hc' i⟩

theorem wc_fet_torsor_zariski_local : ∀ (X : Scheme.{u}) (m : ℕ) (W : Scheme.{u}) (p : W ⟶ X)
    (aW : ZMod m → (W ⟶ W))
    (J : Type u) (U : J → X.Opens) (V : J → Scheme.{u}) (pU : ∀ i, V i ⟶ (U i : Scheme.{u}))
    (a : ∀ i, ZMod m → (V i ⟶ V i)) (ι : ∀ i, V i ⟶ W),
    (∀ x : X, ∃ i, x ∈ U i) → (∀ i, IsOpenImmersion (ι i)) →
    (∀ i, Set.range (ι i) = p ⁻¹' (U i : Set X)) → (∀ i, ι i ≫ p = pU i ≫ (U i).ι) →
    (∀ i c, ι i ≫ aW c = a i c ≫ ι i) → (∀ i, wcFetTorsor (pU i) m (a i)) →
    wcFetTorsor p m aW :=
by
  intro X m W p aW J U V pU a ι Hcov Hopen Hrange Hcomm Hequiv Htor

  have hsurjι : ∀ w : W, ∃ i y, ι i y = w := by
    intro w
    obtain ⟨i, hi⟩ := Hcov (p w)
    have hw : w ∈ Set.range (ι i) := by rw [Hrange i]; exact hi
    obtain ⟨y, hy⟩ := hw
    exact ⟨i, y, hy⟩
  have hext : ∀ {Z : Scheme.{u}} (f g : W ⟶ Z), (∀ i, ι i ≫ f = ι i ≫ g) → f = g :=
    fun f g h => (Scheme.Cover.mkOfCovers J V ι hsurjι Hopen : W.OpenCover).hom_ext f g h

  have hact_p : ∀ c, aW c ≫ p = p := by
    intro c
    apply hext
    intro i
    rw [← Category.assoc, Hequiv, Category.assoc, Hcomm, ← Category.assoc, (Htor i).act_p c]
  have hact0 : aW 0 = 𝟙 W := by
    apply hext
    intro i
    rw [Hequiv, (Htor i).act_zero, Category.id_comp, Category.comp_id]
  have hadd : ∀ c c', aW (c + c') = aW c' ≫ aW c := by
    intro c c'
    apply hext
    intro i
    rw [Hequiv, (Htor i).act_add, Category.assoc, ← Hequiv, ← Category.assoc, ← Hequiv,
      Category.assoc]

  have hsurj : Set.range p = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro x
    obtain ⟨i, hi⟩ := Hcov x
    have hx : x ∈ Set.range (U i).ι := by rw [Scheme.Opens.range_ι]; exact hi
    obtain ⟨y, rfl⟩ := hx
    have hy : y ∈ Set.range (pU i) := by rw [(Htor i).surj]; trivial
    obtain ⟨v, rfl⟩ := hy
    refine ⟨ι i v, ?_⟩
    rw [← Scheme.Hom.comp_apply, Hcomm, Scheme.Hom.comp_apply]

  have hsup : iSup U = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact Hcov x
  have hres : ∀ i, ∃ e : V i ≅ ((p ⁻¹ᵁ U i : W.Opens) : Scheme.{u}), p ∣_ U i = e.inv ≫ pU i := by
    intro i
    have := Hopen i
    have hr : Set.range (ι i) = Set.range (p ⁻¹ᵁ U i).ι := by
      rw [Scheme.Opens.range_ι, Scheme.Hom.coe_preimage, Hrange i]
    refine ⟨IsOpenImmersion.isoOfRangeEq (ι i) (p ⁻¹ᵁ U i).ι hr, ?_⟩
    rw [Iso.eq_inv_comp, ← cancel_mono (U i).ι, Category.assoc, morphismRestrict_ι,
      ← Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac, Hcomm]
  have hfin : IsFinite p := by
    refine @IsZariskiLocalAtTarget.of_iSup_eq_top @IsFinite
      (@HasAffineProperty.instIsZariskiLocalAtTarget @IsFinite
        (fun X _ f _ => IsAffine X ∧ f.appTop.hom.Finite)
        IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop)
      W X p J U hsup ?_
    intro i
    obtain ⟨e, he⟩ := hres i
    have := (Htor i).finite
    rw [he]
    infer_instance
  have het : Etale p := by
    refine @IsZariskiLocalAtTarget.of_iSup_eq_top @Etale
      (HasRingHomProperty.instIsZariskiLocalAtTarget (P := @Etale)) W X p J U hsup ?_
    intro i
    obtain ⟨e, he⟩ := hres i
    have := (Htor i).etale
    rw [he]
    infer_instance

  have hgo : ∀ (b : W ⟶ W) (hb : b ≫ p = p),
      IsOpenImmersion (Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm)) := by
    intro b hb
    have : Etale p := het
    have h1 := MorphismProperty.of_isPullback (P := @IsOpenImmersion)
      (Limits.pullback_lift_diagonal_isPullback b p)
      (inferInstance : IsOpenImmersion (Limits.pullback.diagonal p))
    have heq : Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm) =
        Limits.pullback.lift (𝟙 W) b (Category.id_comp _) ≫
          (Limits.pullback.congrHom hb rfl).hom ≫ (Limits.pullbackSymmetry p p).hom := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [Limits.pullback.lift_fst, Limits.pullbackSymmetry_hom_comp_fst,
          Limits.pullback.congrHom_hom, Limits.pullback.lift_snd, Category.comp_id,
          Limits.pullback.lift_snd]
      · simp only [Category.assoc]
        rw [Limits.pullback.lift_snd, Limits.pullbackSymmetry_hom_comp_snd,
          Limits.pullback.congrHom_hom, Limits.pullback.lift_fst, Category.comp_id,
          Limits.pullback.lift_fst]
    rw [heq]
    have := h1
    infer_instance

  have hG : ∀ i c, Limits.pullback.lift (a i c) (𝟙 (V i))
      (((Htor i).act_p c).trans (Category.id_comp (pU i)).symm) ≫
      Limits.pullback.map (pU i) (pU i) p p (ι i) (ι i) (U i).ι (Hcomm i).symm (Hcomm i).symm =
      ι i ≫ Limits.pullback.lift (aW c) (𝟙 W) ((hact_p c).trans (Category.id_comp p).symm) := by
    intro i c
    have hm1 : Limits.pullback.map (pU i) (pU i) p p (ι i) (ι i) (U i).ι (Hcomm i).symm
        (Hcomm i).symm ≫ Limits.pullback.fst p p = Limits.pullback.fst (pU i) (pU i) ≫ ι i :=
      Limits.pullback.lift_fst _ _ _
    have hm2 : Limits.pullback.map (pU i) (pU i) p p (ι i) (ι i) (U i).ι (Hcomm i).symm
        (Hcomm i).symm ≫ Limits.pullback.snd p p = Limits.pullback.snd (pU i) (pU i) ≫ ι i :=
      Limits.pullback.lift_snd _ _ _
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hm1, Limits.pullback.lift_fst_assoc, Category.assoc,
        Limits.pullback.lift_fst, Hequiv]
    · rw [Category.assoc, hm2, Limits.pullback.lift_snd_assoc, Category.assoc,
        Limits.pullback.lift_snd, Category.id_comp, Category.comp_id]

  have hdisj : Pairwise fun c c' =>
      Disjoint (Set.range (Limits.pullback.lift (aW c) (𝟙 W) ((hact_p c).trans (Category.id_comp p).symm)))
        (Set.range (Limits.pullback.lift (aW c') (𝟙 W) ((hact_p c').trans (Category.id_comp p).symm))) := by
    intro c c' hcc'
    rw [Set.disjoint_left]
    rintro z ⟨v, rfl⟩ ⟨v', hv'⟩
    have hvv : v' = v := by
      have h2 := congrArg (fun z => Limits.pullback.snd p p z) hv'
      simp only at h2
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.lift_snd,
        Limits.pullback.lift_snd] at h2
      exact h2
    subst hvv
    obtain ⟨i, y, rfl⟩ := hsurjι v'
    have := Hopen i
    have k : ∀ c, Limits.pullback.lift (aW c) (𝟙 W) ((hact_p c).trans (Category.id_comp p).symm) (ι i y) =
        Limits.pullback.map (pU i) (pU i) p p (ι i) (ι i) (U i).ι (Hcomm i).symm (Hcomm i).symm
          (Limits.pullback.lift (a i c) (𝟙 (V i))
            (((Htor i).act_p c).trans (Category.id_comp (pU i)).symm) y) := by
      intro c
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hG]
    rw [k, k] at hv'
    have hinj := Scheme.Hom.injective _ hv'
    exact Set.disjoint_left.mp ((Htor i).graph_disj hcc') ⟨y, rfl⟩ ⟨y, hinj⟩

  have hcov : (⋃ c, Set.range (Limits.pullback.lift (aW c) (𝟙 W)
      ((hact_p c).trans (Category.id_comp p).symm))) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro z
    obtain ⟨i, hi⟩ := Hcov (p (Limits.pullback.snd p p z))
    have := Hopen i
    have hz1 : Limits.pullback.snd p p z ∈ Set.range (ι i) := by rw [Hrange i]; exact hi
    have hz0 : Limits.pullback.fst p p z ∈ Set.range (ι i) := by
      rw [Hrange i]
      show p (Limits.pullback.fst p p z) ∈ (U i : Set X)
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      exact hi
    have hzm : z ∈ Set.range
        (Limits.pullback.map (pU i) (pU i) p p (ι i) (ι i) (U i).ι (Hcomm i).symm (Hcomm i).symm) := by
      rw [Scheme.Pullback.range_map]
      exact ⟨hz0, hz1⟩
    obtain ⟨y, rfl⟩ := hzm
    have hy : y ∈ ⋃ c, Set.range (Limits.pullback.lift (a i c) (𝟙 (V i))
        (((Htor i).act_p c).trans (Category.id_comp (pU i)).symm)) := by
      rw [(Htor i).graph_cover]; trivial
    obtain ⟨c, y', rfl⟩ := Set.mem_iUnion.mp hy
    refine Set.mem_iUnion.mpr ⟨c, ι i y', ?_⟩
    rw [← Scheme.Hom.comp_apply, ← hG, Scheme.Hom.comp_apply]
  exact ⟨hfin, het, hsurj, hact_p, hact0, hadd, fun c => hgo (aW c) (hact_p c), hdisj, hcov⟩

theorem wc_tor_glue_trans_exist : ∀ (X : Scheme.{u}) (m : ℕ)
    (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
    (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))),
    wcTorSplitUniv f g →
    ∀ (J : Type u) (U : J → X.Opens) (V : J → Scheme.{u}) (pU : ∀ i, V i ⟶ (U i : Scheme.{u}))
      (a : ∀ i, ZMod m → (V i ⟶ V i)) (ht : ∀ i, wcFetTorsor (pU i) m (a i))
      (hE : ∀ i, Etale (pU i ≫ (U i).ι))
      (s : ∀ i, E.obj.obj (Opposite.op (wcTorsorEt (pU i ≫ (U i).ι) (hE i)))),
      (∀ i, wcTorLocRel f g (U i) (ht i) (hE i) (s i)) →
      ∃ τ : ∀ i j, (((pU i ≫ (U i).ι) ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) ⟶ V j,
        (∀ i j, τ i j ≫ (pU j ≫ (U j).ι) = ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) ∧
        (∀ i j (T : X.Etale) (h₁ : T ⟶ wcTorsorEt (pU i ≫ (U i).ι) (hE i))
          (h₂ : T ⟶ wcTorsorEt (pU j ≫ (U j).ι) (hE j))
          (h' : T.left ⟶ (((pU i ≫ (U i).ι) ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u})),
          h' ≫ ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι = h₁.left → h' ≫ τ i j = h₂.left →
          (E.obj.map h₁.op).hom (s i) = (E.obj.map h₂.op).hom (s j)) :=
by
  intro X m E f g hU J U V pU a ht hE s hrel
  have hconst : ∀ (A : Type (u+1)) [AddCommGroup A] (U₁ W₁ : X.Etale) (φ : W₁ ⟶ U₁) (x : A),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of A)).obj.map φ.op).hom (wcConstSec X A U₁ x) = wcConstSec X A W₁ x := by
    intro A _ U₁ W₁ φ x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A))) φ.op x).symm
  have natg : ∀ (A B : X.Etale) (φ : A ⟶ B) (x : E.obj.obj (Opposite.op B)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map φ.op).hom ((g.hom.app (Opposite.op B)).hom x) =
      (g.hom.app (Opposite.op A)).hom ((E.obj.map φ.op).hom x) :=
    fun A B φ x => (NatTrans.naturality_apply g.hom φ.op x).symm
  have hcomp : ∀ {A B C : X.Etale} (φ : A ⟶ B) (ψ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map φ.op).hom ((E.obj.map ψ.op).hom x) = (E.obj.map (φ ≫ ψ).op).hom x :=
    fun φ ψ x => (congrArg (fun k => k.hom x) (E.obj.map_comp ψ.op φ.op)).symm
  have hW : ∀ i j, Etale (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) := by
    intro i j
    haveI := hE i
    infer_instance
  have key : ∀ i j, ∃ φ : wcTorsorEt (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) (hW i j) ⟶
      wcTorsorEt (pU j ≫ (U j).ι) (hE j),
      (E.obj.map φ.op).hom (s j) = (E.obj.map (wcEtHomMk (pU i ≫ (U i).ι) (hE i)
        (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) (hW i j)
        ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι rfl).op).hom (s i) := by
    intro i j
    have hrange : Set.range (wcTorsorEt (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι))
        (hW i j)).hom ⊆ ((U j : X.Opens) : Set X) := by
      have aux : ∀ y : ↥(((pU i ≫ (U i).ι) ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}),
          ((((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) y) ∈ U j := by
        intro y
        rw [Scheme.Hom.comp_apply]
        have hy : (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι y) ∈ ((pU i ≫ (U i).ι) ⁻¹ᵁ U j) := by
          rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
          exact ⟨y, rfl⟩
        exact hy
      rintro _ ⟨y, rfl⟩
      exact aux y
    have hg : (g.hom.app (Opposite.op (wcTorsorEt (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫
        (pU i ≫ (U i).ι)) (hW i j)))).hom ((E.obj.map (wcEtHomMk (pU i ≫ (U i).ι) (hE i)
        (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) (hW i j)
        ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι rfl).op).hom (s i)) =
        wcConstSec X (ULift.{u+1} ℤ) (wcTorsorEt (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫
          (pU i ≫ (U i).ι)) (hW i j)) (ULift.up 1) := by
      rw [← natg, (hrel i).1, hconst]
    obtain ⟨k, ⟨φ, -, hφ⟩, -⟩ :=
      hU (U j) (V j) (pU j) (a j) (ht j) (hE j) (s j) (hrel j) _ hrange _ hg
    exact ⟨φ, hφ⟩
  choose φ hφ using key
  refine ⟨fun i j => (φ i j).left, fun i j => MorphismProperty.Over.w (φ i j), ?_⟩
  intro i j T h₁ h₂ h' e₁ e₂
  have hw : h' ≫ (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) = T.hom := by
    rw [← Category.assoc, e₁]
    exact MorphismProperty.Over.w h₁
  let ho : T ⟶ wcTorsorEt (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) (hW i j) :=
    MorphismProperty.Over.homMk h' hw trivial
  have hh₁ : h₁ = ho ≫ wcEtHomMk (pU i ≫ (U i).ι) (hE i)
      (((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) (hW i j)
      ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι rfl := by
    apply MorphismProperty.Over.Hom.ext
    exact e₁.symm
  have hh₂ : h₂ = ho ≫ φ i j := by
    apply MorphismProperty.Over.Hom.ext
    exact e₂.symm
  rw [hh₁, hh₂, ← hcomp, ← hcomp, hφ]

theorem wc_tor_glue_trans_rigid : ∀ (X : Scheme.{u}) (m : ℕ)
    (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
    (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))),
    wcTorSplitUniv f g →
    ∀ (J : Type u) (U : J → X.Opens) (V : J → Scheme.{u}) (pU : ∀ i, V i ⟶ (U i : Scheme.{u}))
      (a : ∀ i, ZMod m → (V i ⟶ V i)) (ht : ∀ i, wcFetTorsor (pU i) m (a i))
      (hE : ∀ i, Etale (pU i ≫ (U i).ι))
      (s : ∀ i, E.obj.obj (Opposite.op (wcTorsorEt (pU i ≫ (U i).ι) (hE i)))),
      (∀ i, wcTorLocRel f g (U i) (ht i) (hE i) (s i)) →
      ∀ τ : ∀ i j, (((pU i ≫ (U i).ι) ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) ⟶ V j,
        (∀ i j, τ i j ≫ (pU j ≫ (U j).ι) = ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ (pU i ≫ (U i).ι)) →
        (∀ i j (T : X.Etale) (h₁ : T ⟶ wcTorsorEt (pU i ≫ (U i).ι) (hE i))
          (h₂ : T ⟶ wcTorsorEt (pU j ≫ (U j).ι) (hE j))
          (h' : T.left ⟶ (((pU i ≫ (U i).ι) ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u})),
          h' ≫ ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι = h₁.left → h' ≫ τ i j = h₂.left →
          (E.obj.map h₁.op).hom (s i) = (E.obj.map h₂.op).hom (s j)) →
        (∀ i (T : Scheme.{u}) (h : T ⟶ (((pU i ≫ (U i).ι) ⁻¹ᵁ U i : (V i).Opens) : Scheme.{u})),
          h ≫ τ i i = h ≫ ((pU i ≫ (U i).ι) ⁻¹ᵁ U i).ι) ∧
        (∀ i j k (T : Scheme.{u})
          (h₁ : T ⟶ (((pU i ≫ (U i).ι) ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}))
          (h₂ : T ⟶ (((pU j ≫ (U j).ι) ⁻¹ᵁ U k : (V j).Opens) : Scheme.{u}))
          (h₃ : T ⟶ (((pU i ≫ (U i).ι) ⁻¹ᵁ U k : (V i).Opens) : Scheme.{u})),
          h₂ ≫ ((pU j ≫ (U j).ι) ⁻¹ᵁ U k).ι = h₁ ≫ τ i j →
          h₃ ≫ ((pU i ≫ (U i).ι) ⁻¹ᵁ U k).ι = h₁ ≫ ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι →
          h₂ ≫ τ j k = h₃ ≫ τ i k) ∧
        (∀ (c : ZMod m) i j (T : Scheme.{u})
          (h h' : T ⟶ (((pU i ≫ (U i).ι) ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u})),
          h' ≫ ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι = h ≫ ((pU i ≫ (U i).ι) ⁻¹ᵁ U j).ι ≫ a i c →
          h' ≫ τ i j = h ≫ τ i j ≫ a j c) :=
by
  intro X m E f g hU J U V pU a ht hE s hrel
  unfold wcTorSplitUniv at hU

  have hconst : ∀ (A : Type (u+1)) [AddCommGroup A] (U₁ W₁ : X.Etale) (φ : W₁ ⟶ U₁) (x : A),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of A)).obj.map φ.op).hom (wcConstSec X A U₁ x) = wcConstSec X A W₁ x := by
    intro A _ U₁ W₁ φ x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A))) φ.op x).symm
  have natg : ∀ (A B : X.Etale) (φ : A ⟶ B) (x : E.obj.obj (Opposite.op B)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map φ.op).hom ((g.hom.app (Opposite.op B)).hom x) =
      (g.hom.app (Opposite.op A)).hom ((E.obj.map φ.op).hom x) :=
    fun A B φ x => (NatTrans.naturality_apply g.hom φ.op x).symm
  have natf : ∀ (A B : X.Etale) (φ : A ⟶ B)
      (x : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op B)),
      (E.obj.map φ.op).hom ((f.hom.app (Opposite.op B)).hom x) =
      (f.hom.app (Opposite.op A)).hom
        ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map φ.op).hom x) :=
    fun A B φ x => (NatTrans.naturality_apply f.hom φ.op x).symm
  have hcomp : ∀ {A B C : X.Etale} (φ : A ⟶ B) (ψ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map φ.op).hom ((E.obj.map ψ.op).hom x) = (E.obj.map (φ ≫ ψ).op).hom x :=
    fun φ ψ x => (congrArg (fun k => k.hom x) (E.obj.map_comp ψ.op φ.op)).symm
  have hpt : ∀ {A B C : Scheme.{u}} (φ : A ⟶ B) (ψ : B ⟶ C) (x : A), (φ ≫ ψ) x = ψ (φ x) :=
    fun _ _ _ => rfl

  have hrig : ∀ j (T : X.Etale), Set.range T.hom ⊆ ((U j : X.Opens) : Set X) →
      ∀ φ₁ φ₂ : T ⟶ wcTorsorEt (pU j ≫ (U j).ι) (hE j),
        (E.obj.map φ₁.op).hom (s j) = (E.obj.map φ₂.op).hom (s j) → φ₁.left = φ₂.left := by
    intro j T hT φ₁ φ₂ heq
    have hg : (g.hom.app (Opposite.op T)).hom ((E.obj.map φ₁.op).hom (s j)) =
        wcConstSec X (ULift.{u+1} ℤ) T (ULift.up 1) := by
      rw [← natg, (hrel j).1, hconst]
    exact (hU (U j) (V j) (pU j) (a j) (ht j) (hE j) (s j) (hrel j) T hT _ hg).unique
      (y₁ := φ₁.left) (y₂ := φ₂.left) ⟨φ₁, rfl, rfl⟩ ⟨φ₂, rfl, heq.symm⟩

  have key : ∀ (q : ∀ i, V i ⟶ X) (hq : ∀ i, Etale (q i))
      (σ : ∀ i, E.obj.obj (Opposite.op (wcTorsorEt (q i) (hq i)))),
      (∀ j (T : X.Etale), Set.range T.hom ⊆ ((U j : X.Opens) : Set X) →
        ∀ φ₁ φ₂ : T ⟶ wcTorsorEt (q j) (hq j),
          (E.obj.map φ₁.op).hom (σ j) = (E.obj.map φ₂.op).hom (σ j) → φ₁.left = φ₂.left) →
      ∀ (hact : ∀ i c, a i c ≫ q i = q i),
      (∀ i c, (E.obj.map (wcTorsorAct (q i) (hq i) (a i c) (hact i c)).op).hom (σ i) =
          σ i + (f.hom.app (Opposite.op (wcTorsorEt (q i) (hq i)))).hom
            (wcConstSec X (ULift.{u+1} (ZMod m)) (wcTorsorEt (q i) (hq i)) (ULift.up c))) →
      ∀ τ : ∀ i j, ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) ⟶ V j,
        (∀ i j, τ i j ≫ q j = (q i ⁻¹ᵁ U j).ι ≫ q i) →
        (∀ i j (T : X.Etale) (h₁ : T ⟶ wcTorsorEt (q i) (hq i))
          (h₂ : T ⟶ wcTorsorEt (q j) (hq j))
          (h' : T.left ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u})),
          h' ≫ (q i ⁻¹ᵁ U j).ι = h₁.left → h' ≫ τ i j = h₂.left →
          (E.obj.map h₁.op).hom (σ i) = (E.obj.map h₂.op).hom (σ j)) →
        (∀ i (T : Scheme.{u}) (h : T ⟶ ((q i ⁻¹ᵁ U i : (V i).Opens) : Scheme.{u})),
          h ≫ τ i i = h ≫ (q i ⁻¹ᵁ U i).ι) ∧
        (∀ i j k (T : Scheme.{u})
          (h₁ : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}))
          (h₂ : T ⟶ ((q j ⁻¹ᵁ U k : (V j).Opens) : Scheme.{u}))
          (h₃ : T ⟶ ((q i ⁻¹ᵁ U k : (V i).Opens) : Scheme.{u})),
          h₂ ≫ (q j ⁻¹ᵁ U k).ι = h₁ ≫ τ i j →
          h₃ ≫ (q i ⁻¹ᵁ U k).ι = h₁ ≫ (q i ⁻¹ᵁ U j).ι →
          h₂ ≫ τ j k = h₃ ≫ τ i k) ∧
        (∀ (c : ZMod m) i j (T : Scheme.{u})
          (h h' : T ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u})),
          h' ≫ (q i ⁻¹ᵁ U j).ι = h ≫ (q i ⁻¹ᵁ U j).ι ≫ a i c →
          h' ≫ τ i j = h ≫ τ i j ≫ a j c) := by
    intro q hq σ hrg hact hsh τ hover hsec

    have hPt : ∀ i (W : X.Opens) (y : ↥((q i ⁻¹ᵁ W : (V i).Opens) : Scheme.{u})),
        q i ((q i ⁻¹ᵁ W).ι y) ∈ W := by
      intro i W y
      have h1 : (q i ⁻¹ᵁ W).ι y ∈ ((q i ⁻¹ᵁ W : (V i).Opens) : Set (V i)) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
      exact h1
    refine ⟨?_, ?_, ?_⟩
    ·
      have hId : ∀ i, τ i i = (q i ⁻¹ᵁ U i).ι := by
        intro i
        haveI := hq i
        have hEt : Etale ((q i ⁻¹ᵁ U i).ι ≫ q i) := inferInstance
        have h := hsec i i (wcTorsorEt _ hEt)
          (wcEtHomMk (q i) (hq i) _ hEt (q i ⁻¹ᵁ U i).ι rfl)
          (wcEtHomMk (q i) (hq i) _ hEt (τ i i) (hover i i))
          (𝟙 _) (Category.id_comp _) (Category.id_comp _)
        exact (hrg i (wcTorsorEt _ hEt) (by rintro _ ⟨y, rfl⟩; exact hPt i (U i) y) _ _ h).symm
      intro i T h
      rw [hId i]
    ·
      intro i j k T h₁ h₂ h₃ H2 H3
      haveI := hq i
      obtain ⟨W, hW⟩ : ∃ W : (V i).Opens, W = (q i ⁻¹ᵁ U j) ⊓ (q i ⁻¹ᵁ U k) := ⟨_, rfl⟩
      have hWij : W ≤ q i ⁻¹ᵁ U j := by rw [hW]; exact inf_le_left
      have hWik : W ≤ q i ⁻¹ᵁ U k := by rw [hW]; exact inf_le_right
      obtain ⟨e₁, he₁⟩ : ∃ e₁ : (W : Scheme.{u}) ⟶ ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}),
          e₁ ≫ (q i ⁻¹ᵁ U j).ι = W.ι := ⟨_, Scheme.homOfLE_ι _ hWij⟩
      obtain ⟨e₃, he₃⟩ : ∃ e₃ : (W : Scheme.{u}) ⟶ ((q i ⁻¹ᵁ U k : (V i).Opens) : Scheme.{u}),
          e₃ ≫ (q i ⁻¹ᵁ U k).ι = W.ι := ⟨_, Scheme.homOfLE_ι _ hWik⟩
      have hWpt : ∀ y : ↥(W : Scheme.{u}), q i (W.ι y) ∈ U k := by
        intro y
        have h1 : W.ι y ∈ (W : Set (V i)) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
        have h2 : W.ι y ∈ W := h1
        exact SetLike.le_def.mp hWik h2
      have hr2 : Set.range (e₁ ≫ τ i j) ⊆ Set.range (q j ⁻¹ᵁ U k).ι := by
        rintro _ ⟨y, rfl⟩
        rw [Scheme.Opens.range_ι]
        show q j ((e₁ ≫ τ i j) y) ∈ U k
        rw [← hpt (e₁ ≫ τ i j) (q j) y, Category.assoc, hover i j, ← Category.assoc, he₁]
        exact hWpt y
      obtain ⟨e₂, he₂⟩ : ∃ e₂ : (W : Scheme.{u}) ⟶ ((q j ⁻¹ᵁ U k : (V j).Opens) : Scheme.{u}),
          e₂ ≫ (q j ⁻¹ᵁ U k).ι = e₁ ≫ τ i j :=
        ⟨IsOpenImmersion.lift _ _ hr2, IsOpenImmersion.lift_fac _ _ _⟩
      have hEt : Etale (W.ι ≫ q i) := inferInstance
      have hT₀ : Set.range (wcTorsorEt (W.ι ≫ q i) hEt).hom ⊆ ((U k : X.Opens) : Set X) := by
        rintro _ ⟨y, rfl⟩; exact hWpt y
      have cB : (e₂ ≫ (q j ⁻¹ᵁ U k).ι) ≫ q j = W.ι ≫ q i := by
        rw [he₂, Category.assoc, hover i j, ← Category.assoc, he₁]
      have c1 : (e₂ ≫ τ j k) ≫ q k = W.ι ≫ q i := by
        rw [Category.assoc, hover j k, ← Category.assoc, cB]
      have c2 : (e₃ ≫ τ i k) ≫ q k = W.ι ≫ q i := by
        rw [Category.assoc, hover i k, ← Category.assoc, he₃]
      have s1 := hsec i j (wcTorsorEt _ hEt) (wcEtHomMk (q i) (hq i) _ hEt W.ι rfl)
        (wcEtHomMk (q j) (hq j) _ hEt (e₂ ≫ (q j ⁻¹ᵁ U k).ι) cB) e₁ he₁ he₂.symm
      have s2 := hsec j k (wcTorsorEt _ hEt)
        (wcEtHomMk (q j) (hq j) _ hEt (e₂ ≫ (q j ⁻¹ᵁ U k).ι) cB)
        (wcEtHomMk (q k) (hq k) _ hEt (e₂ ≫ τ j k) c1) e₂ rfl rfl
      have s3 := hsec i k (wcTorsorEt _ hEt) (wcEtHomMk (q i) (hq i) _ hEt W.ι rfl)
        (wcEtHomMk (q k) (hq k) _ hEt (e₃ ≫ τ i k) c2) e₃ he₃ rfl
      have hstar : e₂ ≫ τ j k = e₃ ≫ τ i k :=
        hrg k (wcTorsorEt _ hEt) hT₀ _ _ (s2.symm.trans (s1.symm.trans s3))

      have hrT : Set.range (h₁ ≫ (q i ⁻¹ᵁ U j).ι) ⊆ Set.range W.ι := by
        rintro _ ⟨t, rfl⟩
        rw [Scheme.Opens.range_ι]
        have m1 : (q i ⁻¹ᵁ U j).ι (h₁ t) ∈ ((q i ⁻¹ᵁ U j : (V i).Opens) : Set (V i)) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
        have m2 : (q i ⁻¹ᵁ U k).ι (h₃ t) ∈ ((q i ⁻¹ᵁ U k : (V i).Opens) : Set (V i)) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
        have e : (q i ⁻¹ᵁ U k).ι (h₃ t) = (q i ⁻¹ᵁ U j).ι (h₁ t) := by
          rw [← hpt h₃ (q i ⁻¹ᵁ U k).ι t, ← hpt h₁ (q i ⁻¹ᵁ U j).ι t, H3]
        rw [e] at m2
        have m3 : (h₁ ≫ (q i ⁻¹ᵁ U j).ι) t ∈ (q i ⁻¹ᵁ U j) ⊓ (q i ⁻¹ᵁ U k) :=
          TopologicalSpace.Opens.mem_inf.mpr ⟨m1, m2⟩
        rw [← hW] at m3
        exact m3
      obtain ⟨r, hr⟩ : ∃ r : T ⟶ (W : Scheme.{u}), r ≫ W.ι = h₁ ≫ (q i ⁻¹ᵁ U j).ι :=
        ⟨IsOpenImmersion.lift _ _ hrT, IsOpenImmersion.lift_fac _ _ _⟩
      have r1 : r ≫ e₁ = h₁ := by
        rw [← cancel_mono (q i ⁻¹ᵁ U j).ι, Category.assoc, he₁, hr]
      have r3 : r ≫ e₃ = h₃ := by
        rw [← cancel_mono (q i ⁻¹ᵁ U k).ι, Category.assoc, he₃, hr, H3]
      have r2 : r ≫ e₂ = h₂ := by
        rw [← cancel_mono (q j ⁻¹ᵁ U k).ι, Category.assoc, he₂, ← Category.assoc, r1, H2]
      rw [← r2, ← r3, Category.assoc, Category.assoc, hstar]
    ·
      intro c i j T h h' H
      haveI := hq i
      have hrα : Set.range ((q i ⁻¹ᵁ U j).ι ≫ a i c) ⊆ Set.range (q i ⁻¹ᵁ U j).ι := by
        rintro _ ⟨y, rfl⟩
        rw [Scheme.Opens.range_ι]
        show q i (((q i ⁻¹ᵁ U j).ι ≫ a i c) y) ∈ U j
        rw [← hpt ((q i ⁻¹ᵁ U j).ι ≫ a i c) (q i) y, Category.assoc, hact i c]
        exact hPt i (U j) y
      obtain ⟨α, hα⟩ : ∃ α : ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}) ⟶
          ((q i ⁻¹ᵁ U j : (V i).Opens) : Scheme.{u}),
          α ≫ (q i ⁻¹ᵁ U j).ι = (q i ⁻¹ᵁ U j).ι ≫ a i c :=
        ⟨IsOpenImmersion.lift _ _ hrα, IsOpenImmersion.lift_fac _ _ _⟩
      have hEt : Etale ((q i ⁻¹ᵁ U j).ι ≫ q i) := inferInstance
      have hT₀ : Set.range (wcTorsorEt ((q i ⁻¹ᵁ U j).ι ≫ q i) hEt).hom ⊆
          ((U j : X.Opens) : Set X) := by
        rintro _ ⟨y, rfl⟩; exact hPt i (U j) y
      have cΨ : (α ≫ (q i ⁻¹ᵁ U j).ι) ≫ q i = (q i ⁻¹ᵁ U j).ι ≫ q i := by
        rw [hα, Category.assoc, hact i c]
      have cΦ₁ : (α ≫ τ i j) ≫ q j = (q i ⁻¹ᵁ U j).ι ≫ q i := by
        rw [Category.assoc, hover i j, ← Category.assoc, cΨ]
      have cΦ₂ : (τ i j ≫ a j c) ≫ q j = (q i ⁻¹ᵁ U j).ι ≫ q i := by
        rw [Category.assoc, hact j c, hover i j]
      have shift : ∀ k (φ : wcTorsorEt ((q i ⁻¹ᵁ U j).ι ≫ q i) hEt ⟶ wcTorsorEt (q k) (hq k)),
          (E.obj.map (φ ≫ wcTorsorAct (q k) (hq k) (a k c) (hact k c)).op).hom (σ k) =
            (E.obj.map φ.op).hom (σ k) +
              (f.hom.app (Opposite.op (wcTorsorEt ((q i ⁻¹ᵁ U j).ι ≫ q i) hEt))).hom
                (wcConstSec X (ULift.{u+1} (ZMod m))
                  (wcTorsorEt ((q i ⁻¹ᵁ U j).ι ≫ q i) hEt) (ULift.up c)) := by
        intro k φ
        rw [← hcomp, hsh k c, map_add, natf, hconst]
      have e1 := hsec i j (wcTorsorEt _ hEt)
        (wcEtHomMk (q i) (hq i) _ hEt (α ≫ (q i ⁻¹ᵁ U j).ι) cΨ)
        (wcEtHomMk (q j) (hq j) _ hEt (α ≫ τ i j) cΦ₁) α rfl rfl
      have e2 := hsec i j (wcTorsorEt _ hEt)
        (wcEtHomMk (q i) (hq i) _ hEt (q i ⁻¹ᵁ U j).ι rfl)
        (wcEtHomMk (q j) (hq j) _ hEt (τ i j) (hover i j))
        (𝟙 _) (Category.id_comp _) (Category.id_comp _)
      have hF1 : wcEtHomMk (q i) (hq i) _ hEt (α ≫ (q i ⁻¹ᵁ U j).ι) cΨ =
          wcEtHomMk (q i) (hq i) _ hEt (q i ⁻¹ᵁ U j).ι rfl ≫
            wcTorsorAct (q i) (hq i) (a i c) (hact i c) :=
        MorphismProperty.Over.Hom.ext hα
      have hF2 : wcEtHomMk (q j) (hq j) _ hEt (τ i j ≫ a j c) cΦ₂ =
          wcEtHomMk (q j) (hq j) _ hEt (τ i j) (hover i j) ≫
            wcTorsorAct (q j) (hq j) (a j c) (hact j c) :=
        MorphismProperty.Over.Hom.ext rfl
      have key2 : (E.obj.map (wcEtHomMk (q j) (hq j) _ hEt (α ≫ τ i j) cΦ₁).op).hom (σ j) =
          (E.obj.map (wcEtHomMk (q j) (hq j) _ hEt (τ i j ≫ a j c) cΦ₂).op).hom (σ j) := by
        rw [← e1, hF1, hF2, shift i, shift j, e2]
      have hQ : α ≫ τ i j = τ i j ≫ a j c := hrg j (wcTorsorEt _ hEt) hT₀ _ _ key2
      have hh : h' = h ≫ α := by
        rw [← cancel_mono (q i ⁻¹ᵁ U j).ι, H, Category.assoc, hα]
      rw [hh, Category.assoc, hQ]
  intro τ hover hsec
  exact key (fun i => pU i ≫ (U i).ι) hE s hrig
    (fun i c => by rw [← Category.assoc, (ht i).act_p c]) (fun i c => (hrel i).2 c) τ hover hsec

theorem wc_et_sheaf_open_glue : ∀ (X : Scheme.{u})
    (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (W : Scheme.{u}) (p : W ⟶ X) (hp : Etale p) (J : Type u) (V : J → Scheme.{u})
    (q : ∀ i, V i ⟶ X) (hq : ∀ i, Etale (q i)) (ι : ∀ i, V i ⟶ W),
    (∀ i, IsOpenImmersion (ι i)) → ∀ (hιp : ∀ i, ι i ≫ p = q i), (∀ w : W, ∃ i y, ι i y = w) →
    (∀ s s' : F.obj.obj (Opposite.op (wcTorsorEt p hp)),
      (∀ i, (F.obj.map (wcEtHomMk p hp (q i) (hq i) (ι i) (hιp i)).op).hom s =
        (F.obj.map (wcEtHomMk p hp (q i) (hq i) (ι i) (hιp i)).op).hom s') → s = s') ∧
    (∀ σ : ∀ i, F.obj.obj (Opposite.op (wcTorsorEt (q i) (hq i))),
      (∀ i j (T : X.Etale) (h₁ : T ⟶ wcTorsorEt (q i) (hq i)) (h₂ : T ⟶ wcTorsorEt (q j) (hq j)),
        h₁.left ≫ ι i = h₂.left ≫ ι j → (F.obj.map h₁.op).hom (σ i) = (F.obj.map h₂.op).hom (σ j)) →
      ∃ s, ∀ i, (F.obj.map (wcEtHomMk p hp (q i) (hq i) (ι i) (hιp i)).op).hom s = σ i) :=
by
  intro X F W p hp J V q hq ι hopen hιp hsurj
  let Y : J → X.Etale := fun i => wcTorsorEt (q i) (hq i)
  let π : ∀ i, Y i ⟶ wcTorsorEt p hp := fun i => wcEtHomMk p hp (q i) (hq i) (ι i) (hιp i)
  have hπl : ∀ i, (π i).left = ι i := fun i => rfl
  have hcov : Sieve.generate (Presieve.ofArrows Y π) ∈
      Scheme.smallEtaleTopology X (wcTorsorEt p hp) := by
    change Sieve.generate (Presieve.ofArrows Y π) ∈
      Scheme.smallGrothendieckTopology @Etale X (wcTorsorEt p hp)
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    obtain ⟨i, y, hy⟩ := hsurj v
    haveI := hopen i
    have hEt : Etale (π i).left := (inferInstance : Etale (ι i))
    exact ⟨Y i, π i, y, Sieve.le_generate (Presieve.ofArrows Y π) _ (π i) (Presieve.ofArrows.mk i),
      hEt, hy⟩
  let P := F.obj ⋙ forget AddCommGrpCat.{u+1}
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology X) P :=
    (isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology X) P).1
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) F.obj
        (forget AddCommGrpCat.{u+1})).1 F.property)
  have hSF : Presieve.IsSheafFor P (Presieve.ofArrows Y π) := hP.isSheafFor _ hcov
  have hA := (Presieve.isSheafFor_arrows_iff P π).1 hSF
  have hcomp : ∀ {A B C : X.Etale} (φ : A ⟶ B) (ψ : B ⟶ C) (x : F.obj.obj (Opposite.op C)),
      (F.obj.map φ.op).hom ((F.obj.map ψ.op).hom x) = (F.obj.map (φ ≫ ψ).op).hom x :=
    fun φ ψ x => (congrArg (fun k => k.hom x) (F.obj.map_comp ψ.op φ.op)).symm
  refine ⟨fun s s' h => ?_, fun σ hσ => ?_⟩
  · let x : ∀ i, P.obj (Opposite.op (Y i)) := fun i => (F.obj.map (π i).op).hom s
    have hx : Presieve.Arrows.Compatible P π x := by
      intro i j Z gi gj heq
      show (F.obj.map gi.op).hom ((F.obj.map (π i).op).hom s) =
        (F.obj.map gj.op).hom ((F.obj.map (π j).op).hom s)
      rw [hcomp, hcomp, heq]
    obtain hu := hA x hx
    exact hu.unique (y₁ := s) (y₂ := s') (fun i => rfl) (fun i => (h i).symm)
  · have hx : Presieve.Arrows.Compatible P π σ := by
      intro i j Z gi gj heq
      have hl : gi.left ≫ ι i = gj.left ≫ ι j := congrArg (fun k => k.left) heq
      exact hσ i j Z gi gj hl
    obtain ⟨t, ht, -⟩ := hA σ hx
    exact ⟨t, fun i => ht i⟩

theorem wc_et_ses_torsor_zariski_glue : ∀ (X : Scheme.{u}) (m : ℕ), m ≠ 0 →
    ∀ (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
      (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0),
      (ShortComplex.mk f g w).ShortExact → wcTorSplitUniv f g →
      (∀ x : X, ∃ U : X.Opens, x ∈ U ∧ wcTorLocRep f g U) →
      ∃ (V : Scheme.{u}) (p : V ⟶ X) (a : ZMod m → (V ⟶ V)) (ht : wcFetTorsor p m a)
        (s : E.obj.obj (Opposite.op (wcTorsorEt p ht.etale))), wcSplitRel ht (𝟙 _) f g s :=
by
  intro X m _hm E f g _w _hS hU hloc

  have hconst : ∀ (A : Type (u+1)) [AddCommGroup A] (U₁ W₁ : X.Etale) (φ : W₁ ⟶ U₁) (x : A),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of A)).obj.map φ.op).hom (wcConstSec X A U₁ x) = wcConstSec X A W₁ x := by
    intro A _ U₁ W₁ φ x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A))) φ.op x).symm
  have natg : ∀ (A B : X.Etale) (φ : A ⟶ B) (x : E.obj.obj (Opposite.op B)),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map φ.op).hom ((g.hom.app (Opposite.op B)).hom x) =
      (g.hom.app (Opposite.op A)).hom ((E.obj.map φ.op).hom x) :=
    fun A B φ x => (NatTrans.naturality_apply g.hom φ.op x).symm
  have natf : ∀ (A B : X.Etale) (φ : A ⟶ B)
      (x : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op B)),
      (E.obj.map φ.op).hom ((f.hom.app (Opposite.op B)).hom x) =
      (f.hom.app (Opposite.op A)).hom
        ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map φ.op).hom x) :=
    fun A B φ x => (NatTrans.naturality_apply f.hom φ.op x).symm
  have hcomp : ∀ {A B C : X.Etale} (φ : A ⟶ B) (ψ : B ⟶ C) (x : E.obj.obj (Opposite.op C)),
      (E.obj.map φ.op).hom ((E.obj.map ψ.op).hom x) = (E.obj.map (φ ≫ ψ).op).hom x :=
    fun φ ψ x => (congrArg (fun k => k.hom x) (E.obj.map_comp ψ.op φ.op)).symm

  choose U hxU hrep using hloc
  unfold wcTorLocRep at hrep
  choose V pU a ht hE s hrel using hrep
  have hrange : ∀ i, Set.range (pU i ≫ (U i).ι) ⊆ ((U i : X.Opens) : Set X) := by
    intro i
    rintro _ ⟨v, rfl⟩
    rw [Scheme.Hom.comp_apply, ← Scheme.Opens.range_ι]
    exact ⟨pU i v, rfl⟩

  obtain ⟨τ, hover, hsec⟩ := wc_tor_glue_trans_exist X m E f g hU (↥X) U V pU a ht hE s hrel
  obtain ⟨hid, hcoc, hequiv⟩ :=
    wc_tor_glue_trans_rigid X m E f g hU (↥X) U V pU a ht hE s hrel τ hover hsec

  obtain ⟨W, p, ι, hopen, hιp, hrι, hsurj, hovl, hfact⟩ :=
    wc_sch_rel_glue X (↥X) U V (fun i => pU i ≫ (U i).ι) hrange τ hover hid hcoc

  have hact : ∀ c : ZMod m, ∃ β : W ⟶ W, ∀ i, ι i ≫ β = a i c ≫ ι i := fun c =>
    wc_sch_rel_glue_endo X (↥X) U V (fun i => pU i ≫ (U i).ι) τ W ι hopen hsurj hovl hfact
      (fun i => a i c)
      (fun i => by
        show a i c ≫ (pU i ≫ (U i).ι) = pU i ≫ (U i).ι
        rw [← Category.assoc, (ht i).act_p c])
      (hequiv c)
  choose aW haW using hact

  have htW : wcFetTorsor p m aW :=
    wc_fet_torsor_zariski_local X m W p aW (↥X) U V pU a ι (fun x => ⟨x, hxU x⟩) hopen hrι hιp
      (fun i c => haW c i) ht

  obtain ⟨hsepE, hglueE⟩ := wc_et_sheaf_open_glue X E W p htW.etale (↥X) V
    (fun i => pU i ≫ (U i).ι) hE ι hopen hιp hsurj
  obtain ⟨hsepZ, -⟩ := wc_et_sheaf_open_glue X
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) W p htW.etale (↥X) V
    (fun i => pU i ≫ (U i).ι) hE ι hopen hιp hsurj
  beta_reduce at hsepE hglueE hsepZ
  obtain ⟨sW, hsW⟩ := hglueE s (by
    intro i j T h₁ h₂ heq
    obtain ⟨h', h1', h2'⟩ := hfact i j T.left h₁.left h₂.left heq
    exact hsec i j T h₁ h₂ h' h1' h2')
  refine ⟨W, p, aW, htW, sW, ?_⟩
  unfold wcSplitRel
  refine ⟨?_, fun c => ?_⟩
  ·
    apply hsepZ
    intro i
    rw [natg, hsW i, hconst]
    exact (hrel i).1
  ·
    apply hsepE
    intro i
    have hcomm : wcEtHomMk p htW.etale (pU i ≫ (U i).ι) (hE i) (ι i) (hιp i) ≫
          wcTorsorAct p htW.etale (aW c) (htW.act_p c) =
        wcTorsorAct (pU i ≫ (U i).ι) (hE i) (a i c)
            (by rw [← Category.assoc, (ht i).act_p c]) ≫
          wcEtHomMk p htW.etale (pU i ≫ (U i).ι) (hE i) (ι i) (hιp i) :=
      MorphismProperty.Over.Hom.ext (haW c i)
    have hid1 : ∀ x, (((𝟙 ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :
          ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ⟶
          ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))).hom.app
          (Opposite.op (wcTorsorEt p htW.etale))).hom x = x := fun x => rfl
    rw [hcomp, hcomm, ← hcomp, hsW i, (hrel i).2 c, map_add, hsW i, hid1, natf, hconst]

theorem wc_et_ses_torsor_representable : ∀ (X : Scheme.{u}) (m : ℕ), m ≠ 0 →
    ∀ (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (f : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ E)
      (g : E ⟶ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (w : f ≫ g = 0),
      (ShortComplex.mk f g w).ShortExact →
      ∃ (V : Scheme.{u}) (p : V ⟶ X) (a : ZMod m → (V ⟶ V)) (ht : wcFetTorsor p m a)
        (s : E.obj.obj (Opposite.op (wcTorsorEt p ht.etale))), wcSplitRel ht (𝟙 _) f g s :=
by
  intro X m hm E f g w hS
  have hdesc : wcTorDescHyp.{u} := by
    intro R R' _ _ _ _ m' _ e he
    obtain ⟨B, _, _, ι, σ, hinj, hrange, hshift, hbij⟩ := wc_ff_torsor_descent_core R R' m' e he
    obtain ⟨het, hfin, hsurj, h0, hadd, hmu⟩ :=
      wc_ff_torsor_descent_props R R' m' B ι σ hinj hshift hbij
    exact ⟨B, inferInstance, inferInstance, ι, σ, hinj, hrange, hshift, hbij,
      wc_fet_torsor_of_ring R B m' σ het hfin hsurj h0 hadd hmu⟩
  have hloc : ∀ x : X, ∃ U : X.Opens, x ∈ U ∧ wcTorLocRep f g U := by
    intro x
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    exact ⟨W, hxW, wc_et_ses_torsor_affine_reduction hdesc X m hm E f g w hS W hW⟩
  exact wc_et_ses_torsor_zariski_glue X m hm E f g w hS
    (wc_fet_split_universal X m hm E f g w hS) hloc

theorem wc_et_ftc_aug_epi : ∀ (X V : Scheme.{u}) (p : V ⟶ X) (hp : Etale p), Set.range p = Set.univ →
    ∀ (ε : wcFtcFS X (wcTorsorEt p hp) ⟶
      (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))),
    (ε.hom.app (Opposite.op (wcTorsorEt p hp))).hom (wcFtcGen X (wcTorsorEt p hp)) =
      wcConstSec X (ULift.{u+1} ℤ) (wcTorsorEt p hp) (ULift.up 1) → Epi ε :=
by
  intro X V p hp hsurj ε hε

  have rc : ∀ (W W' : X.Etale) (h : W' ⟶ W) (x : ULift.{u+1} ℤ),
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map h.op).hom (wcConstSec X (ULift.{u+1} ℤ) W x) =
        wcConstSec X (ULift.{u+1} ℤ) W' x := by
    intro W W' h x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) h.op x).symm

  have hc : ∀ (W' : X.Etale) (a : ULift.{u+1} ℤ),
      a.down • wcConstSec X (ULift.{u+1} ℤ) W' (ULift.up 1) = wcConstSec X (ULift.{u+1} ℤ) W' a := by
    intro W' a
    have h1 := (map_zsmul ((toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).app
        (Opposite.op W')).hom a.down (ULift.up 1)).symm
    have h2 : a.down • (ULift.up 1 : ULift.{u+1} ℤ) = a := by
      apply ULift.ext
      simp
    rw [h2] at h1
    exact h1

  have cover : ∀ (U : X.Etale) (S : Sieve U),
      (∀ (W : X.Etale) (g : W ⟶ U), Nonempty (W ⟶ wcTorsorEt p hp) → S.arrows g) →
      S ∈ Scheme.smallEtaleTopology X U := by
    intro U S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X U
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    haveI : Etale U.hom := U.prop
    haveI := hp
    have hW : Etale (Limits.pullback.fst U.hom p ≫ U.hom) := inferInstance
    let g : wcTorsorEt (Limits.pullback.fst U.hom p ≫ U.hom) hW ⟶ U :=
      MorphismProperty.Over.homMk (Limits.pullback.fst U.hom p) rfl trivial
    let t : wcTorsorEt (Limits.pullback.fst U.hom p ≫ U.hom) hW ⟶ wcTorsorEt p hp :=
      MorphismProperty.Over.homMk (Limits.pullback.snd U.hom p) Limits.pullback.condition.symm trivial
    have hx : x ∈ Set.range (Limits.pullback.fst U.hom p) := by
      rw [Scheme.Pullback.range_fst, hsurj]
      trivial
    obtain ⟨y, hy⟩ := hx
    have hEt : Etale g.left := (inferInstance : Etale (Limits.pullback.fst U.hom p))
    exact ⟨_, g, y, hS _ g ⟨t⟩, hEt, hy⟩

  have hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) ε.hom := by
    constructor
    intro U s
    let τ := toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) τ :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hR := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) τ s
    refine GrothendieckTopology.transitive _ hR _ ?_
    intro W h hh
    obtain ⟨a, ha⟩ := hh
    have ha' : (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map h.op).hom s =
        wcConstSec X (ULift.{u+1} ℤ) W a := ha.symm
    apply cover W
    rintro W' k ⟨t⟩
    have n1 : (ε.hom.app (Opposite.op W')).hom
        (((wcFtcFS X (wcTorsorEt p hp)).obj.map t.op).hom (wcFtcGen X (wcTorsorEt p hp))) =
        wcConstSec X (ULift.{u+1} ℤ) W' (ULift.up 1) :=
      (NatTrans.naturality_apply ε.hom t.op (wcFtcGen X (wcTorsorEt p hp))).trans
        ((congrArg (fun z => (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map t.op).hom z) hε).trans (rc _ _ t _))
    have e1 : (ε.hom.app (Opposite.op W')).hom (a.down •
        ((wcFtcFS X (wcTorsorEt p hp)).obj.map t.op).hom (wcFtcGen X (wcTorsorEt p hp))) =
        wcConstSec X (ULift.{u+1} ℤ) W' a := by
      rw [map_zsmul, n1, hc]
    have rhs : (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map (k ≫ h).op).hom s =
        wcConstSec X (ULift.{u+1} ℤ) W' a := by
      rw [op_comp, Functor.map_comp]
      change (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map k.op).hom
        ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map h.op).hom s) = _
      rw [ha']
      exact rc W W' k a
    exact ⟨a.down • ((wcFtcFS X (wcTorsorEt p hp)).obj.map t.op).hom (wcFtcGen X (wcTorsorEt p hp)),
      e1.trans rhs.symm⟩
  exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} ε).mp hls

theorem wc_et_ftc_pair_exact : ∀ (X V : Scheme.{u}) (p : V ⟶ X) (hp : Etale p)
    (hp2 : Etale (Limits.pullback.fst p p ≫ p))
    (pr₁ pr₂ : wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2 ⟶ wcTorsorEt p hp),
    pr₁.left = Limits.pullback.fst p p → pr₂.left = Limits.pullback.snd p p →
    ∀ (βs : wcFtcFS X (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2) ⟶ wcFtcFS X (wcTorsorEt p hp))
      (ε : wcFtcFS X (wcTorsorEt p hp) ⟶
        (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))),
    (βs.hom.app (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))).hom
        (wcFtcGen X (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2)) =
      ((wcFtcFS X (wcTorsorEt p hp)).obj.map pr₁.op).hom (wcFtcGen X (wcTorsorEt p hp)) -
        ((wcFtcFS X (wcTorsorEt p hp)).obj.map pr₂.op).hom (wcFtcGen X (wcTorsorEt p hp)) →
    (ε.hom.app (Opposite.op (wcTorsorEt p hp))).hom (wcFtcGen X (wcTorsorEt p hp)) =
      wcConstSec X (ULift.{u+1} ℤ) (wcTorsorEt p hp) (ULift.up 1) →
    ∀ (w : βs ≫ ε = 0), (ShortComplex.mk βs ε w).Exact :=
by
  intro X V p hp hp2 pr₁ pr₂ h₁ h₂ βs ε hβ hε w

  have alg : ∀ (S T' : Type (u+1)) (q₁ q₂ : T' → S), (∀ x y : S, ∃ τ : T', q₁ τ = x ∧ q₂ τ = y) →
      ∀ (β : FreeAbelianGroup T' →+ FreeAbelianGroup S) (ε : FreeAbelianGroup S →+ ULift.{u+1} ℤ),
      (∀ τ, β (FreeAbelianGroup.of τ) = FreeAbelianGroup.of (q₁ τ) - FreeAbelianGroup.of (q₂ τ)) →
      (∀ x, ε (FreeAbelianGroup.of x) = ULift.up 1) →
      ∀ z, ε z = 0 → ∃ y, β y = z := by
    intro S T' q₁ q₂ hsurj β ε0 hβ' hε' z hz
    rcases isEmpty_or_nonempty S with hS | ⟨⟨x₀⟩⟩
    · refine ⟨0, ?_⟩
      rw [map_zero]
      have hz0 : ∀ z' : FreeAbelianGroup S, z' = 0 := fun z' =>
        FreeAbelianGroup.induction_on z' rfl (fun x => isEmptyElim x) (fun x _ => isEmptyElim x)
          (fun a b ha hb => by rw [ha, hb, add_zero])
      exact (hz0 z).symm
    · choose τ hτ using fun x => hsurj x x₀
      have key : β.comp (FreeAbelianGroup.lift (fun x => FreeAbelianGroup.of (τ x))) =
          AddMonoidHom.id _ - (zmultiplesHom (FreeAbelianGroup S) (FreeAbelianGroup.of x₀)).comp
            ((AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom.comp ε0) := by
        refine FreeAbelianGroup.lift_ext _ _ (fun x => ?_)
        rw [AddMonoidHom.comp_apply, FreeAbelianGroup.lift_apply_of, hβ', (hτ x).1, (hτ x).2,
          AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply,
          AddMonoidHom.comp_apply, hε']
        simp
        exact (one_smul ℤ _).symm
      refine ⟨FreeAbelianGroup.lift (fun x => FreeAbelianGroup.of (τ x)) z, ?_⟩
      have h1 := DFunLike.congr_fun key z
      rw [AddMonoidHom.comp_apply] at h1
      rw [h1, AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply,
        AddMonoidHom.comp_apply, hz]
      simp

  have yon : ∀ (Y : X.Etale) (F : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (e : F.obj (Opposite.op Y)),
      ∃ φ : yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ F,
        ∀ (W : (X.Etale)ᵒᵖ) (t : W.unop ⟶ Y),
          (φ.app W).hom (FreeAbelianGroup.of (ULift.up t)) = (F.map t.op).hom e := by
    intro Y F e
    refine ⟨{ app := fun W => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
                (fun t : ULift.{u+1} (W.unop ⟶ Y) => (F.map t.down.op).hom e))
              naturality := ?_ }, ?_⟩
    · intro W W' h
      apply AddCommGrpCat.hom_ext
      refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
      have key : ((yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map h).hom
          (FreeAbelianGroup.of t) = FreeAbelianGroup.of (ULift.up (h.unop ≫ t.down)) := rfl
      have e1 : (FreeAbelianGroup.lift (fun t : ULift.{u+1} (W'.unop ⟶ Y) => (F.map t.down.op).hom e))
          (FreeAbelianGroup.of (ULift.up (h.unop ≫ t.down))) =
          (F.map (h.unop ≫ t.down).op).hom e := FreeAbelianGroup.lift_apply_of _ _
      have e2 : (FreeAbelianGroup.lift (fun t : ULift.{u+1} (W.unop ⟶ Y) => (F.map t.down.op).hom e))
          (FreeAbelianGroup.of t) = (F.map t.down.op).hom e := FreeAbelianGroup.lift_apply_of _ _
      change (FreeAbelianGroup.lift (fun t : ULift.{u+1} (W'.unop ⟶ Y) => (F.map t.down.op).hom e))
          (((yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map h).hom
            (FreeAbelianGroup.of t)) =
        (F.map h).hom ((FreeAbelianGroup.lift
          (fun t : ULift.{u+1} (W.unop ⟶ Y) => (F.map t.down.op).hom e)) (FreeAbelianGroup.of t))
      rw [key]
      refine e1.trans (Eq.trans ?_ (congrArg (fun z => (F.map h).hom z) e2).symm)
      rw [op_comp, CategoryTheory.Functor.map_comp]
      rfl
    · intro W t
      exact FreeAbelianGroup.lift_apply_of _ _

  have yonU : ∀ (Y : X.Etale) (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (φ ψ : wcFtcFS X Y ⟶ F),
      (φ.hom.app (Opposite.op Y)).hom (wcFtcGen X Y) = (ψ.hom.app (Opposite.op Y)).hom (wcFtcGen X Y) →
      φ = ψ := by
    intro Y F φ ψ h
    apply Sheaf.hom_ext
    apply sheafify_hom_ext _ φ.hom ψ.hom F.property
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
    have e : (FreeAbelianGroup.of t : FreeAbelianGroup (ULift.{u+1} (W.unop ⟶ Y))) =
        ((yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map t.down.op).hom
          (FreeAbelianGroup.of (ULift.up (𝟙 Y))) := by
      change _ = FreeAbelianGroup.of (ULift.up (t.down ≫ 𝟙 Y))
      rw [Category.comp_id]
      rfl
    have nφ := NatTrans.naturality_apply
      (toSheafify (Scheme.smallEtaleTopology X) (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ φ.hom)
      t.down.op (FreeAbelianGroup.of (ULift.up (𝟙 Y)))
    have nψ := NatTrans.naturality_apply
      (toSheafify (Scheme.smallEtaleTopology X) (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ ψ.hom)
      t.down.op (FreeAbelianGroup.of (ULift.up (𝟙 Y)))
    exact (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology X)
        (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ φ.hom).app W).hom z) e).trans
      (nφ.trans ((congrArg (fun z => (F.obj.map t.down.op).hom z) h).trans (nψ.symm.trans
        (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ ψ.hom).app W).hom z) e).symm)))

  have hlhs : ∀ (Y : X.Etale) (F : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (η : yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ F),
      (((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map η).hom.app
          (Opposite.op Y)).hom (wcFtcGen X Y) =
        ((toSheafify (Scheme.smallEtaleTopology X) F).app (Opposite.op Y)).hom
          ((η.app (Opposite.op Y)).hom (FreeAbelianGroup.of (ULift.up (𝟙 Y)))) := by
    intro Y F η
    exact (congrArg (fun k => (k.app (Opposite.op Y)).hom (FreeAbelianGroup.of (ULift.up (𝟙 Y))))
      (toSheafify_naturality (Scheme.smallEtaleTopology X) η)).symm

  have hnat : ∀ (Y Y' : X.Etale) (g : Y' ⟶ Y),
      ((wcFtcFS X Y).obj.map g.op).hom (wcFtcGen X Y) =
        ((toSheafify (Scheme.smallEtaleTopology X)
          (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op Y')).hom
          (FreeAbelianGroup.of (ULift.up g)) := by
    intro Y Y' g
    have h := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) g.op
      (FreeAbelianGroup.of (ULift.up (𝟙 Y)))
    have e : ((yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map g.op).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 Y))) = FreeAbelianGroup.of (ULift.up g) := by
      change FreeAbelianGroup.of (ULift.up (g ≫ 𝟙 Y)) = _
      rw [Category.comp_id]
    refine h.symm.trans (congrArg (fun z => ((toSheafify (Scheme.smallEtaleTopology X)
      (yoneda.obj Y ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op Y')).hom z) e)

  have pairsurj : ∀ (U : X.Etale) (x y : U ⟶ wcTorsorEt p hp),
      ∃ τ : U ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2, τ ≫ pr₁ = x ∧ τ ≫ pr₂ = y := by
    intro U x y
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift x.left y.left
        ((MorphismProperty.Over.w x).trans (MorphismProperty.Over.w y).symm))
      ((Limits.pullback.lift_fst_assoc _ _ _ p).trans (MorphismProperty.Over.w x)) trivial, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact (congrArg (fun k => (Limits.pullback.lift x.left y.left
        ((MorphismProperty.Over.w x).trans (MorphismProperty.Over.w y).symm)) ≫ k) h₁).trans
        (Limits.pullback.lift_fst _ _ _)
    · apply MorphismProperty.Over.Hom.ext
      exact (congrArg (fun k => (Limits.pullback.lift x.left y.left
        ((MorphismProperty.Over.w x).trans (MorphismProperty.Over.w y).symm)) ≫ k) h₂).trans
        (Limits.pullback.lift_snd _ _ _)

  obtain ⟨βp, hβp⟩ := yon (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2)
    (yoneda.obj (wcTorsorEt p hp) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    (FreeAbelianGroup.of (ULift.up pr₁) - FreeAbelianGroup.of (ULift.up pr₂))
  obtain ⟨εp, hεp⟩ := yon (wcTorsorEt p hp)
    ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (ULift.up 1)
  have hβp' : ∀ (W : (X.Etale)ᵒᵖ) (τ : W.unop ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2),
      (βp.app W).hom (FreeAbelianGroup.of (ULift.up τ)) =
        FreeAbelianGroup.of (ULift.up (τ ≫ pr₁)) - FreeAbelianGroup.of (ULift.up (τ ≫ pr₂)) := by
    intro W τ
    rw [hβp]
    exact (map_sub _ _ _).trans rfl
  have hεp' : ∀ (W : (X.Etale)ᵒᵖ) (t : W.unop ⟶ wcTorsorEt p hp),
      (εp.app W).hom (FreeAbelianGroup.of (ULift.up t)) = ULift.up 1 := fun W t => (hεp W t).trans rfl
  have hz : βp ≫ εp = 0 := by
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
    obtain ⟨t⟩ := t
    change (εp.app W).hom ((βp.app W).hom (FreeAbelianGroup.of (ULift.up t))) = _
    exact ((congrArg (εp.app W).hom (hβp' W t)).trans ((map_sub (εp.app W).hom _ _).trans
      ((congrArg₂ (· - ·) (hεp' W (t ≫ pr₁)) (hεp' W (t ≫ pr₂))).trans (sub_self _)))).trans rfl

  have hsec : ∀ (U : (X.Etale)ᵒᵖ)
      (x : (yoneda.obj (wcTorsorEt p hp) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj U),
      (εp.app U).hom x = 0 → ∃ q, (βp.app U).hom q = x := by
    intro U z hz0
    exact alg (ULift.{u+1} (U.unop ⟶ wcTorsorEt p hp))
      (ULift.{u+1} (U.unop ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))
      (fun τ => ULift.up (τ.down ≫ pr₁)) (fun τ => ULift.up (τ.down ≫ pr₂))
      (fun x y => by
        obtain ⟨τ₀, e1, e2⟩ := pairsurj U.unop x.down y.down
        exact ⟨ULift.up τ₀, congrArg ULift.up e1, congrArg ULift.up e2⟩)
      (βp.app U).hom (εp.app U).hom (fun τ => hβp' U τ.down) (fun x => hεp' U x.down) z hz0

  have hSp : (ShortComplex.mk βp εp hz).Exact := by
    rw [ShortComplex.exact_iff_isZero_homology]
    apply Functor.isZero
    intro U
    have hU : ((ShortComplex.mk βp εp hz).map
        ((evaluation (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj U)).Exact := by
      rw [ShortComplex.ab_exact_iff]
      intro x hx
      obtain ⟨q, hq⟩ := hsec U x hx
      exact ⟨q, hq⟩
    exact Limits.IsZero.of_iso ((ShortComplex.exact_iff_isZero_homology _).mp hU)
      ((ShortComplex.mk βp εp hz).mapHomologyIso
        ((evaluation (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj U)).symm
  have hSs := hSp.map (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})

  have eβ : βs = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map βp := by
    apply yonU
    refine hβ.trans (Eq.trans ?_ (hlhs _ _ βp).symm)
    rw [hnat _ _ pr₁, hnat _ _ pr₂, hβp', Category.id_comp, Category.id_comp]
    exact (map_sub _ _ _).symm
  have eε : ε = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map εp := by
    apply yonU
    refine hε.trans (Eq.trans ?_ (hlhs _ _ εp).symm)
    rw [hεp']
    rfl
  subst eβ eε
  exact hSs

theorem wc_et_ftc_diff_section : ∀ (X V : Scheme.{u}) (p : V ⟶ X) (m : ℕ) (a : ZMod m → (V ⟶ V))
    (ht : wcFetTorsor p m a) (hp2 : Etale (Limits.pullback.fst p p ≫ p)),
    ∃ d : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj
        (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2)),
      ∀ (c : ZMod m) (γ : wcTorsorEt p ht.etale ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2),
        γ.left = Limits.pullback.lift (a c) (𝟙 V) ((ht.act_p c).trans (Category.id_comp p).symm) →
        (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map γ.op).hom d =
          wcConstSec X (ULift.{u+1} (ZMod m)) (wcTorsorEt p ht.etale) (ULift.up c) :=
by
  intro X V p m a ht hp2
  classical

  have cov : ∀ (W : X.Etale) (S : Sieve W), (∀ v : W.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ W),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X W := by
    intro W S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X W
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ W.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale W.hom := W.prop
      have h2 : Etale (c.left ≫ W.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left W.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hsh : Presieve.IsSheaf (Scheme.smallEtaleTopology X)
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type (Scheme.smallEtaleTopology X)
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj ⋙ forget AddCommGrpCat.{u+1})).mp
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X)
        ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj (forget AddCommGrpCat.{u+1})).mp
        ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).property)

  have emp : ∀ (W : X.Etale), IsEmpty W.left →
      ∀ x y : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op W), x = y := by
    intro W hW x y
    have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology X W :=
      cov W ⊥ (fun v => isEmptyElim v)
    exact (hsh ⊥ hbot).isSeparatedFor (fun _ f hf => absurd hf (by simp)) x y
      (fun _ f hf => absurd hf (by simp)) (fun _ f hf => absurd hf (by simp))

  have rc : ∀ (W W' : X.Etale) (h : W' ⟶ W) (x : ULift.{u+1} (ZMod m)),
      ((((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map h.op).hom
        (wcConstSec X (ULift.{u+1} (ZMod m)) W x)) = wcConstSec X (ULift.{u+1} (ZMod m)) W' x := by
    intro W W' h x
    exact (NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) h.op x).symm

  let Γ : ZMod m → (wcTorsorEt p ht.etale ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2) :=
    fun c => MorphismProperty.Over.homMk
      (Limits.pullback.lift (a c) (𝟙 V) ((ht.act_p c).trans (Category.id_comp p).symm))
      ((Limits.pullback.lift_fst_assoc (a c) (𝟙 V)
        ((ht.act_p c).trans (Category.id_comp p).symm) p).trans (ht.act_p c))
      trivial
  have hΓ : ∀ c, (Γ c).left =
