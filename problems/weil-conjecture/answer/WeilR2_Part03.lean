      obtain ⟨k₂, f₂, A₂, O₂, M₂, h₂, π₂, eA₂, eO₂, ha₂, hl₂, sq₂⟩ :=
        wc_lim_affine_open_model I D c hc haff V₀ p₀ hp₀a hp₀l i₀ U U.2
      subst eA₁ eO₁ eA₂ eO₂
