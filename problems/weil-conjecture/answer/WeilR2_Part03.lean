      have loc : ∀ (W : Z.Opens) (hW : W ≤ iSup U) (y y' : Γ(F, W)),
          (∀ i, (F.presheaf.map (homOfLE (inf_le_left : W ⊓ U i ≤ W)).op).hom y =
            (F.presheaf.map (homOfLE (inf_le_left : W ⊓ U i ≤ W)).op).hom y') → y = y' :=
