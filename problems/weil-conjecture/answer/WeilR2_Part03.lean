      exact Subtype.ext (funext fun W => hs' W.1 W.2)
  intro Z L'
  classical
  have resG : ∀ (G : Z.Modules) {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(G, A)),
