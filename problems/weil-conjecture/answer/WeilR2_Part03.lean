    ((Abelian.Ext.mk₀ eZ.inv).comp e (zero_add 1))
  obtain ⟨η'', hη''⟩ : ∃ η'' : Abelian.Ext (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y)
