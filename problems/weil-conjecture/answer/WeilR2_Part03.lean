  · intro n V hV
    haveI := hnoeth V hV
    haveI : Module.Finite Γ(Z, V) Γ(F, V) := hFalg.1.2 V hV
    haveI : Module.Finite Γ(Z, V) Γ(Fs n, V) := (hF.1 n).2 V hV

    have himg : ∀ e, ∀ y ∈ Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
        (⊤ : Submodule Γ(Z, V) Γ(L.G e, V)),
        ∃ w ∈ Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
