        Function.Surjective f →
        (∀ m, f m = 0 ↔ m ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ^ (N + c) •
          (⊤ : Submodule Γ(Z, U) Γ(M, U))) →
        ∀ μ' : MultilinearMap Γ(Z, U) (fun _ : Fin k => P) P,
          ∃ β : MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U),
          ∀ x : Fin k → Γ(M, U), f (β x) - μ' (fun i => f (x i)) ∈
            Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ^ N • (⊤ : Submodule Γ(Z, U) P) := by
    intro U hU
    haveI := hnoeth U hU
    haveI := halg.1.2 U hU
    exact hlift Γ(Z, U) _ Γ(M, U) k
  choose c₁ hc₁ using hc1
  choose c₂ hc₂ using hc2
  have T := fun (U : Z.Opens) (hU : IsAffineOpen U) =>
    s3 Γ(Z, U) (Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B)) Γ(M, U) k
      (fun n => Γ(Ms n, U)) (fun n => wcCnJaAppL (ψ n) U) (fun n => wcCnJaAppL (φ n) U)
      (fun n => lam n U hU) (c₁ U hU) (c₂ U hU)
      (fun n => (halg.2.2 n U hU).1)
      (fun n m => by rw [← Ideal.map_pow]; exact (halg.2.2 n U hU).2 m)
      (fun n m => by
        show Scheme.Modules.Hom.app (ψ n) U (Scheme.Modules.Hom.app (φ (n + 1)) U m) =
          Scheme.Modules.Hom.app (φ n) U m
        rw [← hcomp, halg.2.1 n])
      (fun n x => hlampsi n U hU x) (hc₁ U hU) (hc₂ U hU)
  have hexA : ∀ (L : ℕ) (U : Z.Opens) (hU : IsAffineOpen U), ∃ e : Γ(E, U),
      ∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ L) U (ev U hU e x) =
        lam L U hU (fun i => Scheme.Modules.Hom.app (φ L) U (x i)) := by
    intro L U hU
    obtain ⟨β, hβ⟩ := (T U hU).1 L
    obtain ⟨e, rfl⟩ := (hev U hU).2 β
    exact ⟨e, hβ⟩
  have hmonoA : ∀ (L j : ℕ) (U : Z.Opens) (hU : IsAffineOpen U) (e : Γ(E, U)),
      (∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ (L + j)) U (ev U hU e x) =
        lam (L + j) U hU (fun i => Scheme.Modules.Hom.app (φ (L + j)) U (x i))) →
      ∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ L) U (ev U hU e x) =
        lam L U hU (fun i => Scheme.Modules.Hom.app (φ L) U (x i)) :=
    fun L j U hU e he => (T U hU).2.2.1 L j (ev U hU e) he
  have hresA : ∀ (L : ℕ) (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U')
      (hle : U' ≤ U) (e : Γ(E, U)),
      (∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ L) U (ev U hU e x) =
        lam L U hU (fun i => Scheme.Modules.Hom.app (φ L) U (x i))) →
      ∀ x : Fin k → Γ(M, U'), Scheme.Modules.Hom.app (φ L) U'
          (ev U' hU' (E.presheaf.map (homOfLE hle).op e) x) =
        lam L U' hU' (fun i => Scheme.Modules.Hom.app (φ L) U' (x i)) := by
    intro L U U' hU hU' hle e he
    refine s1 Z M (Ms L) halg.1.1 k U hU
      (fun V hV hVU x => Scheme.Modules.Hom.app (φ L) V
        (ev V hV (E.presheaf.map (homOfLE hVU).op e) x))
      (fun V hV hVU x => lam L V hV (fun i => Scheme.Modules.Hom.app (φ L) V (x i)))
      ?_ ?_ ?_ ?_ ?_ U' hU' hle
    · intro V hV hVU c x
      dsimp only
      rw [MultilinearMap.map_smul_univ, Scheme.Modules.Hom.app_smul]
    · intro V hV hVU c x
      dsimp only
      simp only [Scheme.Modules.Hom.app_smul]
      rw [MultilinearMap.map_smul_univ]
    · intro V V' hV hV' hVU hV'U hle' x
      dsimp only
      rw [← hnat, hevnat V V' hV hV' hle', hres]
    · intro V V' hV hV' hVU hV'U hle' x
      dsimp only
      rw [hlamnat L V V' hV hV' hle']
      congr 1
      funext i
      exact (hnat _ _ _ _ _).symm
    · intro V hV hVU x
      dsimp only
      rw [← hevnat U V hU hV hVU e x, hnat, he x, hlamnat L U V hU hV hVU]
      congr 1
      funext i
      exact (hnat _ _ _ _ _).symm
  have hwdA : ∀ (n : ℕ) (U : Z.Opens) (hU : IsAffineOpen U) (e e' : Γ(E, U)),
      (∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (ev U hU e x) =
        lam (n + c₁ U hU) U hU (fun i => Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (x i))) →
      (∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (ev U hU e' x) =
        lam (n + c₁ U hU) U hU (fun i => Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (x i))) →
      Scheme.Modules.Hom.app (Φ n) U e = Scheme.Modules.Hom.app (Φ n) U e' := by
    intro n U hU e e' he he'
    have hdiff := (T U hU).2.1 n (ev U hU e) (ev U hU e') he he'
    let evE := LinearEquiv.ofBijective (ev U hU) (hev U hU)
    have hsymm : ∀ y, evE.symm (ev U hU y) = y := fun y => evE.symm_apply_apply y
    have h3 : evE.symm (ev U hU e - ev U hU e') ∈
        Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ^ (n + 1) •
          (⊤ : Submodule Γ(Z, U) Γ(E, U)) :=
      Submodule.smul_top_le_comap_smul_top _ evE.symm.toLinearMap hdiff
    rw [← map_sub, hsymm] at h3
    have h4 := ((hQ2.2.2 n U hU).2 (e - e')).mpr (by rw [Ideal.map_pow]; exact h3)
    rw [map_sub, sub_eq_zero] at h4
    exact h4
  choose ew hew using hexA
  let qU : ∀ (n : ℕ) (U : Z.Opens) (hU : IsAffineOpen U), Γ(Q n, U) := fun n U hU =>
    Scheme.Modules.Hom.app (Φ n) U (ew (n + c₁ U hU) U hU)
  have hWD : ∀ (n : ℕ) (U : Z.Opens) (hU : IsAffineOpen U) (e : Γ(E, U)),
      (∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (ev U hU e x) =
        lam (n + c₁ U hU) U hU (fun i => Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (x i))) →
      Scheme.Modules.Hom.app (Φ n) U e = qU n U hU :=
    fun n U hU e he => hwdA n U hU e _ he (hew _ U hU)
  have hqnat : ∀ (n : ℕ) (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U')
      (hle : U' ≤ U), (Q n).presheaf.map (homOfLE hle).op (qU n U hU) = qU n U' hU' := by
    intro n U U' hU hU' hle
    have he := hew (n + c₁ U hU + c₁ U' hU') U hU
    have h1 := hmonoA _ _ U hU _ he
    have h2 := hresA _ U U' hU hU' hle _ he
    have h3 : ∀ x : Fin k → Γ(M, U'), Scheme.Modules.Hom.app (φ (n + c₁ U' hU' + c₁ U hU)) U'
        (ev U' hU' (E.presheaf.map (homOfLE hle).op (ew (n + c₁ U hU + c₁ U' hU') U hU)) x) =
        lam (n + c₁ U' hU' + c₁ U hU) U' hU'
          (fun i => Scheme.Modules.Hom.app (φ (n + c₁ U' hU' + c₁ U hU)) U' (x i)) := by
      rw [show n + c₁ U' hU' + c₁ U hU = n + c₁ U hU + c₁ U' hU' by omega]
      exact h2
    have h4 := hmonoA _ _ U' hU' _ h3
    rw [← hWD n U hU _ h1, ← hWD n U' hU' _ h4, hnat]
  choose q hq hqu using fun n => s2 Z (Q n) (qU n) (hqnat n)
  have hP : ∀ (n : ℕ) (U : Z.Opens) (hU : IsAffineOpen U) (e : Γ(E, U)),
      (∀ x : Fin k → Γ(M, U), Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (ev U hU e x) =
        lam (n + c₁ U hU) U hU (fun i => Scheme.Modules.Hom.app (φ (n + c₁ U hU)) U (x i))) →
      Scheme.Modules.Hom.app (Φ n) U e = (Q n).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (q n) :=
    fun n U hU e he => (hWD n U hU e he).trans (hq n U hU).symm
  have hqc : ∀ n, Scheme.Modules.Hom.app (ψQ n) ⊤ (q (n + 1)) = q n := by
    intro n
    refine hqu n _ (fun V hV => ?_)
    rw [← hnat, hq (n + 1) V hV]
    have he := hew (n + 1 + c₁ V hV) V hV
    have he' : ∀ x : Fin k → Γ(M, V), Scheme.Modules.Hom.app (φ (n + c₁ V hV + 1)) V
        (ev V hV (ew (n + 1 + c₁ V hV) V hV) x) =
        lam (n + c₁ V hV + 1) V hV
          (fun i => Scheme.Modules.Hom.app (φ (n + c₁ V hV + 1)) V (x i)) := by
      rw [show n + c₁ V hV + 1 = n + 1 + c₁ V hV by omega]
      exact he
    show Scheme.Modules.Hom.app (ψQ n) V
        (Scheme.Modules.Hom.app (Φ (n + 1)) V (ew (n + 1 + c₁ V hV) V hV)) = qU n V hV
    rw [← hcomp, hQ2.2.1 n]
    exact hWD n V hV _ (hmonoA _ 1 V hV _ he')
  obtain ⟨e₀, he₀, -⟩ := hff B Z h Q ψQ E Φ hQ1 hQ2 q hqc
  refine ⟨⟨fun U hU => ev U hU (E.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op e₀), ?_, ?_⟩, ?_⟩
  · intro U U' hU hU' hle x
    dsimp only
    rw [hevnat U U' hU hU' hle, hres]
  · intro n U hU x
    dsimp only
    have he := hew (n + c₁ U hU) U hU
    generalize ew (n + c₁ U hU) U hU = e at he
    have h1 : Scheme.Modules.Hom.app (Φ n) U e =
        Scheme.Modules.Hom.app (Φ n) U (E.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op e₀) := by
      rw [hP n U hU e he, hnat, he₀ n]
    have h2 : E.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op e₀ - e ∈
        Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ^ (n + 1) •
          (⊤ : Submodule Γ(Z, U) Γ(E, U)) := by
      have := (hQ2.2.2 n U hU).2 (E.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op e₀ - e)
      rw [Ideal.map_pow] at this
      exact this.mp (by rw [map_sub, h1, sub_self])
    have h3 : ev U hU (E.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op e₀) - ev U hU e ∈
        Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ^ (n + 1) •
          (⊤ : Submodule Γ(Z, U) (MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U))) := by
      rw [← map_sub]
      exact Submodule.smul_top_le_comap_smul_top _ (ev U hU) h2
    have h4 := hmonoA n (c₁ U hU) U hU e he
    exact (T U hU).2.2.2 n _ _ h3 h4 x
  · intro β β' hβn hβ'n hβl hβ'l
    let δ : ∀ U : Z.Opens, IsAffineOpen U →
        MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U) := fun U hU => β U hU - β' U hU
    have hδnat : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
        (x : Fin k → Γ(M, U)),
        M.presheaf.map (homOfLE hle).op (δ U hU x) =
          δ U' hU' (fun i => M.presheaf.map (homOfLE hle).op (x i)) := by
      intro U U' hU hU' hle x
      show M.presheaf.map (homOfLE hle).op ((β U hU - β' U hU) x) =
        (β U' hU' - β' U' hU') (fun i => M.presheaf.map (homOfLE hle).op (x i))
      rw [MultilinearMap.sub_apply, MultilinearMap.sub_apply, map_sub, hβn, hβ'n]
    have hδmem : ∀ (n : ℕ) (U : Z.Opens) (hU : IsAffineOpen U),
        δ U hU ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ^ (n + 1) •
          (⊤ : Submodule Γ(Z, U) (MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U))) := by
      intro n U hU
      apply hc₁ U hU (n + 1) (δ U hU)
      intro x
      have h0 : Scheme.Modules.Hom.app (φ (n + 1 + c₁ U hU)) U (δ U hU x) = 0 := by
        show Scheme.Modules.Hom.app (φ (n + 1 + c₁ U hU)) U ((β U hU - β' U hU) x) = 0
        rw [MultilinearMap.sub_apply, map_sub, hβl, hβ'l, sub_self]
      have h1 := ((halg.2.2 (n + 1 + c₁ U hU) U hU).2 _).mp h0
      rw [Ideal.map_pow] at h1
      exact Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega)) h1
    let evE : ∀ (U : Z.Opens) (hU : IsAffineOpen U), _ := fun U hU =>
      LinearEquiv.ofBijective (ev U hU) (hev U hU)
    let d : ∀ U : Z.Opens, IsAffineOpen U → Γ(E, U) := fun U hU => (evE U hU).symm (δ U hU)
    have hevd : ∀ U hU, ev U hU (d U hU) = δ U hU := fun U hU => (evE U hU).apply_symm_apply _
    have hdmem : ∀ (n : ℕ) (U : Z.Opens) (hU : IsAffineOpen U),
        d U hU ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ^ (n + 1) •
          (⊤ : Submodule Γ(Z, U) Γ(E, U)) := fun n U hU =>
      Submodule.smul_top_le_comap_smul_top _ (evE U hU).symm.toLinearMap (hδmem n U hU)
    have hdnat : ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U),
        E.presheaf.map (homOfLE hle).op (d U hU) = d U' hU' := by
      intro U U' hU hU' hle
      apply (hev U' hU').1
      rw [hevd U' hU']
      ext x
      exact s1 Z M M halg.1.1 k U hU
        (fun V hV hVU x => ev V hV (E.presheaf.map (homOfLE hVU).op (d U hU)) x)
        (fun V hV hVU x => δ V hV x)
        (fun V hV hVU c x => MultilinearMap.map_smul_univ _ _ _)
        (fun V hV hVU c x => MultilinearMap.map_smul_univ _ _ _)
        (fun V V' hV hV' hVU hV'U hle' x => by
          dsimp only
          rw [hevnat V V' hV hV' hle', hres])
        (fun V V' hV hV' hVU hV'U hle' x => hδnat V V' hV hV' hle' x)
        (fun V hV hVU x => by
          dsimp only
          rw [← hevnat U V hU hV hVU, hevd U hU, hδnat])
        U' hU' hle x
    obtain ⟨t, ht, -⟩ := s2 Z E d hdnat
    have hΦt : ∀ n, Scheme.Modules.Hom.app (Φ n) ⊤ t = 0 := by
      intro n
      refine (s2 Z (Q n) (fun _ _ => 0) (fun V V' hV hV' hle => map_zero _)).unique
        (fun V hV => ?_) (fun V hV => map_zero _)
      rw [← hnat, ht V hV]
      refine ((hQ2.2.2 n V hV).2 _).mpr ?_
      rw [Ideal.map_pow]
      exact hdmem n V hV
    obtain ⟨s₀, -, hs₀⟩ := hff B Z h Q ψQ E Φ hQ1 hQ2 (fun _ => 0) (fun n => map_zero _)
    have ht0 : t = 0 := (hs₀ t hΦt).trans (hs₀ 0 (fun n => map_zero _)).symm
    intro U hU
    have hd0 : d U hU = 0 := by rw [← ht U hU, ht0, map_zero]
    have hδ0 : δ U hU = 0 := by rw [← hevd, hd0, map_zero]
    exact sub_eq_zero.mp hδ0

theorem wc_cn_multilin_hom_sheaf : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (M : Z.Modules),
    wcCoherentMod M → ∀ k : ℕ,
    ∃ (E : Z.Modules) (ev : ∀ U : Z.Opens, IsAffineOpen U →
        (Γ(E, U) →ₗ[Γ(Z, U)] MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U))),
      wcCoherentMod E ∧ (∀ (U : Z.Opens) (hU : IsAffineOpen U), Function.Bijective (ev U hU)) ∧
      ∀ (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
        (e : Γ(E, U)) (x : Fin k → Γ(M, U)),
        M.presheaf.map (homOfLE hle).op (ev U hU e x) =
          ev U' hU' (E.presheaf.map (homOfLE hle).op e)
            (fun i => M.presheaf.map (homOfLE hle).op (x i)) :=
by
  intro Z _ M hM k

  have hres2 : ∀ (G : Z.Modules) (V W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ V) (h₂ : W₂ ≤ W₁) (s : Γ(G, V)),
      (G.presheaf.map (homOfLE h₂).op).hom ((G.presheaf.map (homOfLE h₁).op).hom s) =
        (G.presheaf.map (homOfLE (h₂.trans h₁)).op).hom s := fun G V W₁ W₂ h₁ h₂ s =>
    (congrArg (fun φ => φ.hom s) (G.presheaf.map_comp (homOfLE h₁).op (homOfLE h₂).op)).symm
  have hres1 : ∀ (G : Z.Modules) (V : Z.Opens) (s : Γ(G, V)),
      (G.presheaf.map (homOfLE (le_refl V)).op).hom s = s := fun G V s =>
    congrArg (fun φ => φ.hom s) (G.presheaf.map_id (Opposite.op V))
  induction k with
  | zero =>
    refine ⟨M, fun U _ => (MultilinearMap.constLinearEquivOfIsEmpty Γ(Z, U) Γ(Z, U)
      (fun _ : Fin 0 => Γ(M, U)) Γ(M, U)).toLinearMap, hM, fun U hU => LinearEquiv.bijective _, ?_⟩
    intro U U' hU hU' hle e x
    rfl
  | succ k ih =>
    obtain ⟨E, ev, hEcoh, hev, hevnat⟩ := ih
    obtain ⟨Hm, Θ0, -, hnat0, hglue0, -, -⟩ := wc_cn_internal_hom_exists Z M

    have hΘbij : ∀ U : Z.Opens, IsAffineOpen U → Function.Bijective (Θ0 E U) := by
      intro U hU
      have hTF : ∀ s : Γ(Hm.obj E, U), ∀ (W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ U) (h₂ : W₂ ≤ W₁)
          (x : Γ(M, W₁)),
          (E.presheaf.map (homOfLE h₂).op).hom
              (Θ0 E W₁ (((Hm.obj E).presheaf.map (homOfLE h₁).op).hom s) x) =
            Θ0 E W₂ (((Hm.obj E).presheaf.map (homOfLE (h₂.trans h₁)).op).hom s)
              ((M.presheaf.map (homOfLE h₂).op).hom x) := by
        intro s W₁ W₂ h₁ h₂ x
        rw [← hnat0 E W₁ W₂ h₂, hres2]
      have hTF0 : ∀ s : Γ(Hm.obj E, U),
          Θ0 E U (((Hm.obj E).presheaf.map (homOfLE (le_refl U)).op).hom s) = Θ0 E U s := by
        intro s; rw [hres1]
      constructor
      · intro s s' hss'
        obtain ⟨f, ⟨hf, hfU⟩, hfuniq⟩ :=
          wc_cn_qcoh_affine_hom_extend Z M E U hU hM.1 (Θ0 E U s)
        have e1 : (fun W hW => Θ0 E W (((Hm.obj E).presheaf.map (homOfLE hW).op).hom s)) = f :=
          hfuniq _ ⟨hTF s, hTF0 s⟩
        have e2 : (fun W hW => Θ0 E W (((Hm.obj E).presheaf.map (homOfLE hW).op).hom s')) = f :=
          hfuniq _ ⟨hTF s', (hTF0 s').trans hss'.symm⟩
        obtain ⟨t, -, htuniq⟩ := hglue0 E U f hf
        exact (htuniq s (fun W hW => congrFun (congrFun e1 W) hW)).trans
          (htuniq s' (fun W hW => congrFun (congrFun e2 W) hW)).symm
      · intro φ
        obtain ⟨f, ⟨hf, hfU⟩, -⟩ := wc_cn_qcoh_affine_hom_extend Z M E U hU hM.1 φ
        obtain ⟨t, ht, -⟩ := hglue0 E U f hf
        exact ⟨t, (hTF0 t).symm.trans ((ht U (le_refl U)).trans hfU)⟩

    have hHq : wcQcoh (Hm.obj E) := wc_cn_hom_qcoh_of_affine_bij Z M E (Hm.obj E) (Θ0 E) hM.1
      hEcoh.1 (fun V hV => by
        haveI := IsLocallyNoetherian.component_noetherian (X := Z) ⟨V, hV⟩
        haveI : Module.Finite Γ(Z, V) Γ(M, V) := hM.2 V hV
        exact Module.finitePresentation_of_finite _ _) hΘbij (hnat0 E)

    have hHfin : ∀ U : Z.Opens, IsAffineOpen U → Module.Finite Γ(Z, U) Γ(Hm.obj E, U) := by
      intro U hU
      haveI := IsLocallyNoetherian.component_noetherian (X := Z) ⟨U, hU⟩
      haveI : Module.Finite Γ(Z, U) Γ(M, U) := hM.2 U hU
      haveI : Module.Finite Γ(Z, U) Γ(E, U) := hEcoh.2 U hU
      exact Module.Finite.equiv (LinearEquiv.ofBijective (Θ0 E U) (hΘbij U hU)).symm

    let ev' : ∀ U : Z.Opens, IsAffineOpen U → (Γ(Hm.obj E, U) →ₗ[Γ(Z, U)]
        MultilinearMap Γ(Z, U) (fun _ : Fin (k + 1) => Γ(M, U)) Γ(M, U)) :=
      fun U hU => (multilinearCurryLeftEquiv Γ(Z, U) (fun _ : Fin (k + 1) => Γ(M, U))
          Γ(M, U)).symm.toLinearMap ∘ₗ
        (LinearMap.llcomp Γ(Z, U) Γ(M, U) Γ(E, U)
          (MultilinearMap Γ(Z, U) (fun _ : Fin k => Γ(M, U)) Γ(M, U)) (ev U hU)) ∘ₗ Θ0 E U
    refine ⟨Hm.obj E, ev', ⟨hHq, hHfin⟩, fun U hU => ?_, ?_⟩
    · have hl : Function.Bijective
          (fun g : Γ(M, U) →ₗ[Γ(Z, U)] Γ(E, U) => (ev U hU) ∘ₗ g) := by
        constructor
        · intro g g' hg
          exact LinearMap.ext fun x => (hev U hU).1 (LinearMap.congr_fun hg x)
        · intro h
          refine ⟨(LinearEquiv.ofBijective (ev U hU) (hev U hU)).symm.toLinearMap ∘ₗ h, ?_⟩
          exact LinearMap.ext fun x =>
            (LinearEquiv.ofBijective (ev U hU) (hev U hU)).apply_symm_apply (h x)
      exact ((multilinearCurryLeftEquiv Γ(Z, U) (fun _ : Fin (k + 1) => Γ(M, U))
          Γ(M, U)).symm.bijective).comp (hl.comp (hΘbij U hU))
    · intro U U' hU hU' hle e x
      have h1 := hevnat U U' hU hU' hle (Θ0 E U e (x 0)) (Fin.tail x)
      have h2 := hnat0 E U U' hle e (x 0)
      refine h1.trans ?_
      exact congrArg (fun a => ev U' hU' a (fun i => M.presheaf.map (homOfLE hle).op (x i.succ)))
        h2.symm

theorem wc_cn_coherent_adic_quotients : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (I : Ideal B)
    (Z : Scheme.{u}) [IsLocallyNoetherian Z] (h : Z ⟶ Spec (.of B)) (E : Z.Modules), wcCoherentMod E →
    ∃ (Q : ℕ → Z.Modules) (ψQ : ∀ n, Q (n + 1) ⟶ Q n) (Φ : ∀ n, E ⟶ Q n),
      wcCnAdicSys h I Q ψQ ∧ wcCnAlg h I Q ψQ E Φ :=
by
  intro B _ _ I Z _ h E hE
  obtain ⟨Es, ψE, φE, h1, h2, -, -⟩ := wc_cn_quotient_system B I Z h E hE
  exact ⟨Es, ψE, φE, h1, h2⟩

theorem wc_cn_multilin_artin_rees_sep : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (I : Ideal R)
    (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] (k : ℕ), ∃ c : ℕ,
    ∀ (N : ℕ) (β : MultilinearMap R (fun _ : Fin k => M) M),
      (∀ x, β x ∈ I ^ (N + c) • (⊤ : Submodule R M)) →
        β ∈ I ^ N • (⊤ : Submodule R (MultilinearMap R (fun _ : Fin k => M) M)) :=
by
  intro R _ _ I M _ _ _ k
  classical
  obtain ⟨r, m, hm⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let ι : MultilinearMap R (fun _ : Fin k => M) M →ₗ[R] ((Fin k → Fin r) → M) :=
    { toFun := fun β j => β (fun i => m (j i))
      map_add' := fun β β' => by funext j; rfl
      map_smul' := fun a β => by funext j; rfl }
  have hinj : Function.Injective ι := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro β hβ
    have h0 : ∀ j : Fin k → Fin r, β (fun i => m (j i)) = 0 := fun j => congrFun hβ j
    ext x
    have hx : ∀ i, ∃ a : Fin r → R, ∑ l, a l • m l = x i := by
      intro i
      have : x i ∈ Submodule.span R (Set.range m) := by rw [hm]; trivial
      exact (Submodule.mem_span_range_iff_exists_fun R).mp this
    choose a ha using hx
    have hxe : x = fun i => ∑ l, a i l • m l := funext fun i => (ha i).symm
    rw [hxe, MultilinearMap.map_sum]
    simp only [MultilinearMap.zero_apply]
    apply Finset.sum_eq_zero
    intro j _
    rw [MultilinearMap.map_smul_univ, h0 j, smul_zero]
  obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul I (LinearMap.range ι)
  refine ⟨c, fun N β hβ => ?_⟩
  have h1 : ι β ∈ I ^ (N + c) • (⊤ : Submodule R ((Fin k → Fin r) → M)) := by
    have : ι β = ∑ j, Pi.single j (ι β j) := (Finset.univ_sum_single _).symm
    rw [this]
    refine Submodule.sum_mem _ fun j _ => ?_
    have hmem : LinearMap.single R (fun _ : Fin k → Fin r => M) j (ι β j) ∈
        Submodule.map (LinearMap.single R (fun _ : Fin k → Fin r => M) j)
          (I ^ (N + c) • (⊤ : Submodule R M)) :=
      Submodule.mem_map_of_mem (hβ _)
    rw [Submodule.map_smul''] at hmem
    exact Submodule.smul_mono le_rfl le_top hmem
  have h2 : ι β ∈ (I ^ (N + c) • (⊤ : Submodule R ((Fin k → Fin r) → M))) ⊓ LinearMap.range ι :=
    ⟨h1, LinearMap.mem_range_self ι β⟩
  rw [hc (N + c) (Nat.le_add_left c N), Nat.add_sub_cancel] at h2
  have h3 : ι β ∈ I ^ N • LinearMap.range ι := Submodule.smul_mono le_rfl inf_le_right h2
  rw [← Submodule.map_top, ← Submodule.map_smul''] at h3
  obtain ⟨β', hβ', he⟩ := h3
  rwa [← hinj he]

theorem wc_cn_multilin_artin_rees_lift : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (I : Ideal R)
    (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] (k : ℕ), ∃ c : ℕ,
    ∀ (N : ℕ) (P : Type u) [AddCommGroup P] [Module R P] (f : M →ₗ[R] P), Function.Surjective f →
      (∀ m, f m = 0 ↔ m ∈ I ^ (N + c) • (⊤ : Submodule R M)) →
      ∀ μ' : MultilinearMap R (fun _ : Fin k => P) P, ∃ β : MultilinearMap R (fun _ : Fin k => M) M,
        ∀ x : Fin k → M, f (β x) - μ' (fun i => f (x i)) ∈ I ^ N • (⊤ : Submodule R P) :=
by
  intro R _ _ I M _ _ _ k
  classical
  obtain ⟨a, p, hp⟩ := Module.Finite.exists_fin' R (PiTensorProduct R (fun _ : Fin k => M))
  have hfg : (LinearMap.ker p).FG := IsNoetherian.noetherian _
  obtain ⟨s, κ, hκ⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  let ρ : (Fin a → M) →ₗ[R] (Fin s → M) :=
    LinearMap.pi (fun l => ∑ j, κ l j • (LinearMap.proj j : (Fin a → M) →ₗ[R] M))
  have hρ : ∀ d l, ρ d l = ∑ j, κ l j • d j := by
    intro d l
    simp [ρ, LinearMap.pi_apply]
  obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul I (LinearMap.range ρ)
  refine ⟨c, fun N P _ _ f hf hker μ' => ?_⟩
  let g : PiTensorProduct R (fun _ : Fin k => M) →ₗ[R] P :=
    PiTensorProduct.lift (μ'.compLinearMap (fun _ => f))
  have hg : ∀ x : Fin k → M, g (PiTensorProduct.tprod R x) = μ' (fun i => f (x i)) := by
    intro x
    simp [g, PiTensorProduct.lift.tprod, MultilinearMap.compLinearMap_apply]
  have hpre : ∀ j : Fin a, ∃ m : M, f m = g (p (Pi.single j 1)) := fun j => hf _
  choose m hm using hpre
  let γ : (Fin a → R) →ₗ[R] M := Fintype.linearCombination R m
  have hγ : ∀ y, γ y = ∑ j, y j • m j := by
    intro y
    simp [γ, Fintype.linearCombination_apply]
  have hfγ : ∀ y, f (γ y) = g (p y) := by
    have h1 : f ∘ₗ γ = g ∘ₗ p := by
      refine LinearMap.pi_ext (fun j r => ?_)
      have e : (Pi.single j r : Fin a → R) = r • Pi.single j (1 : R) := by
        ext i
        by_cases h : i = j
        · subst h; simp
        · simp [h]
      rw [LinearMap.comp_apply, LinearMap.comp_apply, e]
      simp only [map_smul]
      rw [← hm j]
      congr 1
      simp [γ, Fintype.linearCombination_apply_single]
    intro y
    exact LinearMap.congr_fun h1 y
  have hκker : ∀ l, p (κ l) = 0 := by
    intro l
    have : κ l ∈ LinearMap.ker p := by
      rw [← hκ]; exact Submodule.subset_span (Set.mem_range_self l)
    exact this
  have hγκ : ∀ l, γ (κ l) = ρ m l := by
    intro l; rw [hγ, hρ]
  have hγmem : ∀ l, γ (κ l) ∈ I ^ (N + c) • (⊤ : Submodule R M) := by
    intro l
    rw [← hker, hfγ, hκker, map_zero]
  have h1 : ρ m ∈ I ^ (N + c) • (⊤ : Submodule R (Fin s → M)) := by
    have : ρ m = ∑ l, Pi.single l (ρ m l) := (Finset.univ_sum_single _).symm
    rw [this]
    refine Submodule.sum_mem _ fun l _ => ?_
    have hmem : LinearMap.single R (fun _ : Fin s => M) l (ρ m l) ∈
        Submodule.map (LinearMap.single R (fun _ : Fin s => M) l)
          (I ^ (N + c) • (⊤ : Submodule R M)) :=
      Submodule.mem_map_of_mem (by rw [← hγκ]; exact hγmem l)
    rw [Submodule.map_smul''] at hmem
    exact Submodule.smul_mono le_rfl le_top hmem
  have h2 : ρ m ∈ (I ^ (N + c) • (⊤ : Submodule R (Fin s → M))) ⊓ LinearMap.range ρ :=
    ⟨h1, LinearMap.mem_range_self ρ m⟩
  rw [hc (N + c) (Nat.le_add_left c N), Nat.add_sub_cancel] at h2
  have h3 : ρ m ∈ I ^ N • LinearMap.range ρ := Submodule.smul_mono le_rfl inf_le_right h2
  rw [← Submodule.map_top, ← Submodule.map_smul''] at h3
  obtain ⟨d', hd', hρd'⟩ := h3
  have hd'j : ∀ j, d' j ∈ I ^ N • (⊤ : Submodule R M) := by
    intro j
    exact Submodule.smul_top_le_comap_smul_top (I ^ N)
      (LinearMap.proj j : (Fin a → M) →ₗ[R] M) hd'
  let δ : (Fin a → R) →ₗ[R] M := Fintype.linearCombination R d'
  have hδ : ∀ y, δ y = ∑ j, y j • d' j := by
    intro y
    simp [δ, Fintype.linearCombination_apply]
  have hδmem : ∀ y, δ y ∈ I ^ N • (⊤ : Submodule R M) := by
    intro y
    rw [hδ]
    exact Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (hd'j j)
  have hδκ : ∀ l, δ (κ l) = γ (κ l) := by
    intro l
    rw [hδ, hγκ, ← hρd', hρ]
  let φ : (Fin a → R) →ₗ[R] M := γ - δ
  have hle : LinearMap.ker p ≤ LinearMap.ker φ := by
    rw [← hκ, Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    show φ (κ l) = 0
    simp [φ, hδκ]
  let e := LinearMap.quotKerEquivOfSurjective p hp
  let βl : PiTensorProduct R (fun _ : Fin k => M) →ₗ[R] M :=
    (LinearMap.ker p).liftQ φ hle ∘ₗ (e.symm : PiTensorProduct R (fun _ : Fin k => M) →ₗ[R] _)
  have hβl : ∀ y, βl (p y) = φ y := by
    intro y
    have he : e.symm (p y) = Submodule.Quotient.mk y := by
      rw [LinearEquiv.symm_apply_eq]
      rfl
    simp only [βl, LinearMap.comp_apply, LinearEquiv.coe_coe, he, Submodule.liftQ_apply]
  refine ⟨βl.compMultilinearMap (PiTensorProduct.tprod R), fun x => ?_⟩
  obtain ⟨y, hy⟩ := hp (PiTensorProduct.tprod R x)
  rw [LinearMap.compMultilinearMap_apply, ← hy, hβl, ← hg, ← hy, ← hfγ]
  simp only [φ, LinearMap.sub_apply, map_sub, sub_sub_cancel_left]
  exact Submodule.neg_mem _ (Submodule.smul_top_le_comap_smul_top (I ^ N) f (hδmem y))

theorem wc_cn_coh_hom_lift : wcCnFormalFns.{u} → ∀ (B : Type u) [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) [IsProper h] (Ns : ℕ → Z.Modules) (ψN : ∀ n, Ns (n + 1) ⟶ Ns n)
    (N : Z.Modules) (φN : ∀ n, N ⟶ Ns n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Ns ψN →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Ns ψN N φN →
    ∀ (M : Z.Modules), wcCoherentMod M → ∀ a : ∀ n, M ⟶ Ns n, (∀ n, a (n + 1) ≫ ψN n = a n) →
      ∃ b : M ⟶ N, ∀ n, b ≫ φN n = a n :=
by
  intro hFF B _ _ _ _ Z h _ Ns ψN N φN hNs hNalg M hM a ha
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h

  have hcomp : ∀ {A A' A'' : Z.Modules} (f : A ⟶ A') (g : A' ⟶ A'') (V : Z.Opens) (x : Γ(A, V)),
      Scheme.Modules.Hom.app g V (Scheme.Modules.Hom.app f V x) =
        Scheme.Modules.Hom.app (f ≫ g) V x := by
    intro A A' A'' f g V x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have hnat : ∀ {A C : Z.Modules} (f : A ⟶ C) (U U' : Z.Opens) (hle : U' ≤ U) (x : Γ(A, U)),
      C.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app f U x) =
        Scheme.Modules.Hom.app f U' (A.presheaf.map (homOfLE hle).op x) := by
    intro A C f U U' hle x
    first
      | exact (NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf f) (homOfLE hle).op x).symm
      | exact (PresheafOfModules.naturality_apply f.val (homOfLE hle).op x).symm
  let linU : ∀ {A C : Z.Modules}, (A ⟶ C) → ∀ U : Z.Opens, Γ(A, U) →ₗ[Γ(Z, U)] Γ(C, U) :=
    fun f U =>
      { toFun := fun x => Scheme.Modules.Hom.app f U x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul f r x }

  obtain ⟨Ms, ψM, φM, hMs, hMalg, hMepi, hMuniv⟩ :=
    wc_cn_quotient_system B (IsLocalRing.maximalIdeal B) Z h M hM
  have ha'ex : ∀ n, ∃ a' : Ms n ⟶ Ns n, φM n ≫ a' = a n := fun n =>
    hMuniv n (Ns n) (a n) (fun U hU => hNs.2.2 n U hU)
  choose a' ha' using ha'ex
  have ha'c : ∀ n, a' (n + 1) ≫ ψN n = ψM n ≫ a' n := by
    intro n
    haveI := hMepi (n + 1)
    apply (cancel_epi (φM (n + 1))).mp
    rw [← Category.assoc, ha' (n + 1), ha n, ← Category.assoc, hMalg.2.1 n, ha' n]

  have hPcoh : wcCoherentMod (Limits.biprod M N) := wc_cn_biprod_coherent Z M N hM hNalg.1
  have hPscoh : ∀ n, wcCoherentMod (Limits.biprod (Ms n) (Ns n)) := fun n =>
    wc_cn_biprod_coherent Z _ _ (hMs.1 n) (hNs.1 n)
  obtain ⟨hPs, hPalg⟩ := wc_cn_biprod_alg B (IsLocalRing.maximalIdeal B) Z h Ms Ns ψM ψN M N φM φN
    hMs hMalg hNs hNalg hPcoh hPscoh

  let lamM : ∀ n, Limits.biprod (Ms n) (Ns n) ⟶ Limits.biprod (Ms n) (Ns n) := fun n =>
    Limits.biprod.fst ≫ a' n ≫ Limits.biprod.inr
  have hlamc : ∀ n, lamM (n + 1) ≫ Limits.biprod.map (ψM n) (ψN n) =
      Limits.biprod.map (ψM n) (ψN n) ≫ lamM n := by
    intro n
    simp only [lamM, Category.assoc, Limits.biprod.inr_map, Limits.biprod.map_fst_assoc,
      reassoc_of% (ha'c n)]
  let lam : ∀ (n : ℕ) (U : Z.Opens), IsAffineOpen U →
      MultilinearMap Γ(Z, U) (fun _ : Fin 1 => Γ(Limits.biprod (Ms n) (Ns n), U))
        Γ(Limits.biprod (Ms n) (Ns n), U) :=
    fun n U _ => MultilinearMap.ofSubsingleton Γ(Z, U) Γ(Limits.biprod (Ms n) (Ns n), U)
      Γ(Limits.biprod (Ms n) (Ns n), U) (0 : Fin 1) (linU (lamM n) U)
  have hlam : ∀ n (U : Z.Opens) (hU : IsAffineOpen U)
      (x : Fin 1 → Γ(Limits.biprod (Ms n) (Ns n), U)),
      lam n U hU x = Scheme.Modules.Hom.app (lamM n) U (x 0) := fun n U hU x =>
    MultilinearMap.ofSubsingleton_apply_apply _ _ _ _ _ _
  have hlamnat : ∀ n (U U' : Z.Opens) (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U)
      (x : Fin 1 → Γ(Limits.biprod (Ms n) (Ns n), U)),
      (Limits.biprod (Ms n) (Ns n)).presheaf.map (homOfLE hle).op (lam n U hU x) =
        lam n U' hU' (fun i => (Limits.biprod (Ms n) (Ns n)).presheaf.map (homOfLE hle).op (x i)) := by
    intro n U U' hU hU' hle x
    rw [hlam n U hU, hlam n U' hU']
    exact hnat (lamM n) U U' hle (x 0)
  have hlamψ : ∀ n (U : Z.Opens) (hU : IsAffineOpen U)
      (x : Fin 1 → Γ(Limits.biprod (Ms (n + 1)) (Ns (n + 1)), U)),
      Scheme.Modules.Hom.app (Limits.biprod.map (ψM n) (ψN n)) U (lam (n + 1) U hU x) =
        lam n U hU (fun i => Scheme.Modules.Hom.app (Limits.biprod.map (ψM n) (ψN n)) U (x i)) := by
    intro n U hU x
    rw [hlam (n + 1) U hU, hlam n U hU]
    dsimp only
    rw [hcomp, hcomp, hlamc n]

  obtain ⟨E, ev, hEcoh, hev, hevnat⟩ := wc_cn_multilin_hom_sheaf Z (Limits.biprod M N) hPcoh 1
  obtain ⟨Q, ψQ, Φ, hQ, hQalg⟩ :=
    wc_cn_coherent_adic_quotients B (IsLocalRing.maximalIdeal B) Z h E hEcoh

  obtain ⟨⟨β, hβnat, hβ⟩, -⟩ := wc_cn_formal_multilin_lift wc_cn_multilin_artin_rees_sep
    wc_cn_multilin_artin_rees_lift hFF B Z h (fun n => Limits.biprod (Ms n) (Ns n))
    (fun n => Limits.biprod.map (ψM n) (ψN n)) (Limits.biprod M N)
    (fun n => Limits.biprod.map (φM n) (φN n)) hPs hPalg 1 E ev hEcoh hev hevnat Q ψQ Φ hQ hQalg
    lam hlamnat hlamψ

  let fβ : ∀ V : Z.Opens, IsAffineOpen V →
      (Γ(Limits.biprod M N, V) →ₗ[Γ(Z, V)] Γ(Limits.biprod M N, V)) := fun V hV =>
    (MultilinearMap.ofSubsingleton Γ(Z, V) Γ(Limits.biprod M N, V) Γ(Limits.biprod M N, V)
      (0 : Fin 1)).symm (β V hV)
  have hfβ : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (y : Γ(Limits.biprod M N, V)),
      fβ V hV y = β V hV (fun _ => y) := fun V hV y =>
    MultilinearMap.ofSubsingleton_symm_apply_apply _ _ _ _ _ _
  obtain ⟨βt, hβt⟩ := wc_cn_modules_hom_of_affine Z _ _ fβ (by
    intro V V' hV hV' hle x
    rw [hfβ, hfβ]
    exact (hβnat V V' hV hV' hle (fun _ => x)).symm)
  have hkey : ∀ n, βt ≫ Limits.biprod.map (φM n) (φN n) =
      Limits.biprod.map (φM n) (φN n) ≫ lamM n := by
    intro n
    apply wc_cn_modules_hom_ext_affine
    intro U hU y
    rw [← hcomp, ← hcomp, hβt U hU y, hfβ, hβ n U hU (fun _ => y), hlam n U hU]

  refine ⟨Limits.biprod.inl ≫ βt ≫ Limits.biprod.snd, fun n => ?_⟩
  calc (Limits.biprod.inl ≫ βt ≫ Limits.biprod.snd) ≫ φN n
      = Limits.biprod.inl ≫ (βt ≫ Limits.biprod.map (φM n) (φN n)) ≫ Limits.biprod.snd := by
        simp only [Category.assoc, Limits.biprod.map_snd]
    _ = Limits.biprod.inl ≫ (Limits.biprod.map (φM n) (φN n) ≫ lamM n) ≫ Limits.biprod.snd := by
        rw [hkey n]
    _ = a n := by
        simp only [lamM, Category.assoc, Limits.biprod.inr_snd, Category.comp_id,
          Limits.biprod.inl_map_assoc, Limits.biprod.inl_fst_assoc]
        exact ha' n

theorem wc_cn_alg_quot : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) (𝒜 : Z.IdealSheafData) (Ns Ns' : ℕ → Z.Modules)
    (ψ : ∀ n, Ns (n + 1) ⟶ Ns n) (ψ' : ∀ n, Ns' (n + 1) ⟶ Ns' n) (M : Z.Modules)
    (φ : ∀ n, M ⟶ Ns n) (Q' : Z.Modules) (π : M ⟶ Q') (ρ : ∀ n, Ns n ⟶ Ns' n)
    (φ' : ∀ n, Q' ⟶ Ns' n), wcCnAlg h I Ns ψ M φ → wcCoherentMod Q' →
    (∀ (V : Z.Opens) (hV : IsAffineOpen V), Function.Surjective (Scheme.Modules.Hom.app π V) ∧
      ∀ s : Γ(M, V), Scheme.Modules.Hom.app π V s = 0 ↔
        s ∈ 𝒜.ideal ⟨V, hV⟩ • (⊤ : Submodule Γ(Z, V) Γ(M, V))) →
    (∀ n (V : Z.Opens) (hV : IsAffineOpen V),
      Function.Surjective (Scheme.Modules.Hom.app (ρ n) V) ∧
      ∀ s : Γ(Ns n, V), Scheme.Modules.Hom.app (ρ n) V s = 0 ↔
        s ∈ 𝒜.ideal ⟨V, hV⟩ • (⊤ : Submodule Γ(Z, V) Γ(Ns n, V))) →
    (∀ n, ρ (n + 1) ≫ ψ' n = ψ n ≫ ρ n) → (∀ n, π ≫ φ' n = φ n ≫ ρ n) →
    wcCnAlg h I Ns' ψ' Q' φ' :=
by
  intro B _ I Z h 𝒜 Ns Ns' ψ ψ' M φ Q' π ρ φ' hA hQ hπ hρ hρψ hπφ
  obtain ⟨_hMc, hcompat, hsec⟩ := hA
  have hcomp : ∀ {A A' A'' : Z.Modules} (a : A ⟶ A') (b : A' ⟶ A'') (c : A ⟶ A''), a ≫ b = c →
      ∀ (V : Z.Opens) (x : Γ(A, V)),
        Scheme.Modules.Hom.app b V (Scheme.Modules.Hom.app a V x) =
          Scheme.Modules.Hom.app c V x := by
    intro A A' A'' a b c e V x
    rw [← e, Scheme.Modules.Hom.comp_app]
    rfl
  have hLIN : ∀ {A A' : Z.Modules} (f : A ⟶ A') (V : Z.Opens) (𝔞 : Ideal Γ(Z, V)) (s : Γ(A, V)),
      s ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(A, V)) →
      Scheme.Modules.Hom.app f V s ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(A', V)) := by
    intro A A' f V 𝔞 s hs
    refine Submodule.smul_induction_on hs ?_ ?_
    · intro r hr n _
      rw [Scheme.Modules.Hom.app_smul]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  have P1 : ∀ n (V : Z.Opens) (x : Γ(M, V)),
      Scheme.Modules.Hom.app (φ' n) V (Scheme.Modules.Hom.app π V x) =
        Scheme.Modules.Hom.app (ρ n) V (Scheme.Modules.Hom.app (φ n) V x) := by
    intro n V x
    rw [hcomp π (φ' n) _ (hπφ n), hcomp (φ n) (ρ n) _ rfl]
  refine ⟨hQ, fun n => ?_, fun n U hU => ⟨?_, fun s => ⟨?_, ?_⟩⟩⟩
  ·
    apply wc_cn_modules_hom_ext_affine
    intro U hU y
    obtain ⟨x, rfl⟩ := (hπ U hU).1 y
    rw [← hcomp (φ' (n + 1)) (ψ' n) _ rfl, P1 (n + 1) U x, hcomp (ρ (n + 1)) (ψ' n) _ (hρψ n),
      ← hcomp (ψ n) (ρ n) _ rfl, hcomp (φ (n + 1)) (ψ n) _ (hcompat n), P1 n U x]
  ·
    intro z
    obtain ⟨w, rfl⟩ := (hρ n U hU).1 z
    obtain ⟨x, rfl⟩ := (hsec n U hU).1 w
    exact ⟨Scheme.Modules.Hom.app π U x, P1 n U x⟩
  ·
    intro h0
    obtain ⟨x, rfl⟩ := (hπ U hU).1 s
    rw [P1] at h0
    have hmem := ((hρ n U hU).2 _).mp h0
    have hlift : ∀ w ∈ 𝒜.ideal ⟨U, hU⟩ • (⊤ : Submodule Γ(Z, U) Γ(Ns n, U)),
        ∃ x₁ ∈ 𝒜.ideal ⟨U, hU⟩ • (⊤ : Submodule Γ(Z, U) Γ(M, U)),
          Scheme.Modules.Hom.app (φ n) U x₁ = w := by
      intro w hw
      refine Submodule.smul_induction_on (p := fun w => ∃ x₁ ∈ 𝒜.ideal ⟨U, hU⟩ •
          (⊤ : Submodule Γ(Z, U) Γ(M, U)), Scheme.Modules.Hom.app (φ n) U x₁ = w) hw ?_ ?_
      · intro r hr w₀ _
        obtain ⟨x₀, hx₀⟩ := (hsec n U hU).1 w₀
        exact ⟨r • x₀, Submodule.smul_mem_smul hr Submodule.mem_top,
          by rw [Scheme.Modules.Hom.app_smul, hx₀]⟩
      · rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
        exact ⟨a + b, Submodule.add_mem _ ha hb, map_add _ _ _⟩
    obtain ⟨x₁, hx₁, hφx₁⟩ := hlift _ hmem
    have hπx₁ : Scheme.Modules.Hom.app π U x₁ = 0 := ((hπ U hU).2 x₁).mpr hx₁
    have hx : Scheme.Modules.Hom.app π U x = Scheme.Modules.Hom.app π U (x - x₁) := by
      rw [map_sub, hπx₁, sub_zero]
    rw [hx]
    have hdiff := ((hsec n U hU).2 (x - x₁)).mp (by rw [map_sub, hφx₁, sub_self])
    exact hLIN π U _ _ hdiff
  ·
    intro hs
    refine Submodule.smul_induction_on (p := fun t => Scheme.Modules.Hom.app (φ' n) U t = 0) hs
      ?_ ?_
    · intro r hr q _
      obtain ⟨x', rfl⟩ := (hπ U hU).1 q
      show Scheme.Modules.Hom.app (φ' n) U (r • Scheme.Modules.Hom.app π U x') = 0
      rw [← Scheme.Modules.Hom.app_smul, P1,
        ((hsec n U hU).2 (r • x')).mpr (Submodule.smul_mem_smul hr Submodule.mem_top), map_zero]
    · intro x y hx hy
      show Scheme.Modules.Hom.app (φ' n) U (x + y) = 0
      rw [map_add, hx, hy, add_zero]

theorem wc_cn_alg_hom_unique : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (Ns : ℕ → Z.Modules)
    (ψN : ∀ n, Ns (n + 1) ⟶ Ns n) (N : Z.Modules) (φN : ∀ n, N ⟶ Ns n),
    wcCnAlg h (IsLocalRing.maximalIdeal B) Ns ψN N φN →
    ∀ (M : Z.Modules), wcCoherentMod M → ∀ f g : M ⟶ N, (∀ n, f ≫ φN n = g ≫ φN n) → f = g :=
by
  intro B _ _ _ Z h _ Ns ψN N φN hN M hM f g hfg
  classical

  have krull : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (P Q : Type u) [AddCommGroup P]
      [Module R P] [AddCommGroup Q] [Module R Q] [Module.Finite R P] [Module.Finite R Q]
      (I : Ideal R) (L : P →ₗ[R] Q),
      (∀ (x : P) (n : ℕ), L x ∈ I ^ (n + 1) • (⊤ : Submodule R Q)) →
      ∃ a ∈ I, ∀ x : P, (1 - a) • L x = 0 := by
    intro R _ _ P Q _ _ _ _ _ _ I L hL
    have h1 : ∀ x : P, ∃ r ∈ I, (1 - r) • L x = 0 := by
      intro x
      have hmem : L x ∈ ⨅ i, I ^ i • (⊤ : Submodule R Q) := by
        rw [Submodule.mem_iInf]
        intro i
        cases i with
        | zero =>
          rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
          exact Submodule.mem_top
        | succ n => exact hL x n
      obtain ⟨r, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff I (L x)).mp hmem
      exact ⟨r, r.2, by rw [sub_smul, one_smul, hr, sub_self]⟩
    have h2 : ∀ S : Finset P, ∃ a ∈ I, ∀ x ∈ S, (1 - a) • L x = 0 := by
      intro S
      induction S using Finset.induction_on with
      | empty => exact ⟨0, I.zero_mem, fun x hx => absurd hx (Finset.notMem_empty x)⟩
      | insert y S _ ih =>
        obtain ⟨a, ha, hka⟩ := ih
        obtain ⟨r, hr, hkr⟩ := h1 y
        refine ⟨a + r - a * r, I.sub_mem (I.add_mem ha hr) (I.mul_mem_right r ha), fun x hx => ?_⟩
        have e : (1 - (a + r - a * r)) = (1 - r) * (1 - a) := by ring
        rw [e, mul_smul]
        rcases Finset.mem_insert.mp hx with hxy | hx
        · rw [hxy, smul_comm (1 - r) (1 - a) (L y), hkr, smul_zero]
        · rw [hka x hx, smul_zero]
    obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := R) (M := P)
    obtain ⟨a, ha, hka⟩ := h2 S
    refine ⟨a, ha, fun x => ?_⟩
    have hx : x ∈ Submodule.span R (S : Set P) := by rw [hS]; exact Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem y hy => exact hka y hy
    | zero => rw [map_zero, smul_zero]
    | add y z _ _ hy hz => rw [map_add, smul_add, hy, hz, add_zero]
    | smul c y _ hy => rw [map_smul, smul_comm, hy, smul_zero]

  have hd : ∀ (U : Z.Opens) (x : Γ(M, U)), Scheme.Modules.Hom.app (f - g) U x =
      Scheme.Modules.Hom.app f U x - Scheme.Modules.Hom.app g U x := by
    intro U x
    rw [Scheme.Modules.Hom.sub_app]
    rfl

  haveI : IsLocallyNoetherian (Spec (.of B)) := isLocallyNoetherian_Spec.mpr inferInstance
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h

  have key : ∀ U : Z.affineOpens, ∃ a ∈ Ideal.map (wcCnSigma h U.1) (IsLocalRing.maximalIdeal B),
      ∀ t : Γ(M, U.1), (1 - a) • Scheme.Modules.Hom.app (f - g) U.1 t = 0 := by
    intro U
    haveI : IsNoetherianRing Γ(Z, U.1) := IsLocallyNoetherian.component_noetherian U
    haveI : Module.Finite Γ(Z, U.1) Γ(M, U.1) := hM.2 U.1 U.2
    haveI : Module.Finite Γ(Z, U.1) Γ(N, U.1) := hN.1.2 U.1 U.2
    let L : Γ(M, U.1) →ₗ[Γ(Z, U.1)] Γ(N, U.1) :=
      { toFun := fun x => Scheme.Modules.Hom.app (f - g) U.1 x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul (f - g) r x }
    refine krull Γ(Z, U.1) Γ(M, U.1) Γ(N, U.1) _ L ?_
    intro x n
    have e1 : ∀ k : M ⟶ N, Scheme.Modules.Hom.app (φN n) U.1 (Scheme.Modules.Hom.app k U.1 x) =
        Scheme.Modules.Hom.app (k ≫ φN n) U.1 x := by
      intro k
      rw [Scheme.Modules.Hom.comp_app]
      rfl
    have h0 : Scheme.Modules.Hom.app (φN n) U.1 (L x) = 0 := by
      change Scheme.Modules.Hom.app (φN n) U.1 (Scheme.Modules.Hom.app (f - g) U.1 x) = 0
      rw [hd, map_sub, e1, e1, hfg n, sub_self]
    have h3 := ((hN.2.2 n U.1 U.2).2 (L x)).mp h0
    rwa [Ideal.map_pow] at h3
  choose a ha hka using key

  have s2 : ∀ (U : Z.Opens) (z : Z) (hz : z ∈ U), h z = IsLocalRing.closedPoint B →
      ∀ a ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B), z ∈ Z.basicOpen (1 - a) := by
    intro U z hz hzc a ha
    have hle : Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ≤
        Ideal.comap (Z.presheaf.germ U z hz).hom
          (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hunit
      have h1 : z ∈ Z.basicOpen (wcCnSigma h U b) := (Scheme.mem_basicOpen Z _ z hz).mpr hunit
      have h2 : Z.basicOpen (wcCnSigma h U b) =
          U ⊓ Z.basicOpen (h.appTop ((Scheme.ΓSpecIso (.of B)).inv b)) :=
        Scheme.basicOpen_res Z _ _
      rw [h2] at h1
      have h3 : z ∈ Z.basicOpen (h.appTop ((Scheme.ΓSpecIso (.of B)).inv b)) :=
        (TopologicalSpace.Opens.mem_inf.mp h1).2
      have h4 : z ∈ h ⁻¹ᵁ (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv b) := by
        rw [Scheme.preimage_basicOpen]; exact h3
      rw [basicOpen_eq_of_affine] at h4
      have h5 : b ∉ (h z).asIdeal := h4
      rw [hzc] at h5
      exact h5 hb
    have hga : (Z.presheaf.germ U z hz).hom a ∈ nonunits (Z.presheaf.stalk z) :=
      (IsLocalRing.mem_maximalIdeal _).mp (hle ha)
    rw [Scheme.mem_basicOpen Z _ z hz, map_sub, map_one]
    exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hga

  have s3 : ∀ (W : Z.Opens), (∀ z : Z, h z = IsLocalRing.closedPoint B → z ∈ W) → W = ⊤ := by
    intro W hW
    rw [eq_top_iff]
    intro z₁ _
    by_contra hz₁
    have hC : IsClosed ((W : Set Z)ᶜ) := W.isOpen.isClosed_compl
    have hhC : IsClosed (h '' ((W : Set Z)ᶜ)) := Scheme.Hom.isClosedMap h _ hC
    have hspec : h z₁ ⤳ IsLocalRing.closedPoint B :=
      (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal (h z₁).2.ne_top)
    obtain ⟨z, hzC, hz⟩ := hspec.mem_closed hhC ⟨z₁, hz₁, rfl⟩
    exact hzC (hW z hz)

  have hW : (⨆ U : Z.affineOpens, Z.basicOpen (1 - a U)) = ⊤ := by
    apply s3
    intro z hz
    obtain ⟨U', hU', hzU', -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
        (show z ∈ (⊤ : Z.Opens) from trivial)
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨U', hU'⟩, s2 U' z hzU' hz _ (ha ⟨U', hU'⟩)⟩

  have s4 : ∀ (W : Z.affineOpens) (g' : Γ(Z, W.1)), Z.basicOpen g' ≤ Z.basicOpen (1 - a W) →
      ∀ s : Γ(M, Z.basicOpen g'), Scheme.Modules.Hom.app (f - g) (Z.basicOpen g') s = 0 := by
    intro W g' hle s
    obtain ⟨n, t, ht⟩ := (hM.1 W.1 W.2 g').1 s
    have hnat : Scheme.Modules.Hom.app (f - g) (Z.basicOpen g')
          ((M.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom t) =
        (N.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom
          (Scheme.Modules.Hom.app (f - g) W.1 t) := by
      have h1 := NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf (f - g))
        (homOfLE (Z.basicOpen_le g')).op t
      simp only [Scheme.Modules.mapPresheaf_app] at h1
      exact h1
    have hu1 : IsUnit (Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op (1 - a W)) := by
      have e : Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op =
          Z.presheaf.map (homOfLE (Z.basicOpen_le (1 - a W))).op ≫
            Z.presheaf.map (homOfLE hle).op := by
        rw [← Functor.map_comp]
        rfl
      rw [e, ConcreteCategory.comp_apply]
      exact (RingedSpace.isUnit_res_basicOpen Z.toRingedSpace (1 - a W)).map _
    have hdt : (N.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom
        (Scheme.Modules.Hom.app (f - g) W.1 t) = 0 := by
      have e := Scheme.Modules.map_smul N (homOfLE (Z.basicOpen_le g')) (1 - a W)
        (Scheme.Modules.Hom.app (f - g) W.1 t)
      rw [hka W t, map_zero] at e
      exact (hu1.smul_eq_zero).mp e.symm
    have hu2 : IsUnit (((Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom g') ^ n) :=
      (RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g').pow n
    have h3 : ((Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom g') ^ n •
        Scheme.Modules.Hom.app (f - g) (Z.basicOpen g') s = 0 := by
      rw [← Scheme.Modules.Hom.app_smul, ht, hnat, hdt]
    exact (hu2.smul_eq_zero).mp h3

  have hloc : ∀ (U : Z.Opens) (x : Γ(M, U)), Scheme.Modules.Hom.app (f - g) U x = 0 := by
    intro U x
    let ι := {V : Z.Opens // V ≤ U ∧ ∀ s : Γ(M, V), Scheme.Modules.Hom.app (f - g) V s = 0}
    let Wf : ι → Z.Opens := fun i => i.1
    have hcov : U ≤ iSup Wf := by
      intro y hy
      have hy' : y ∈ (⨆ W : Z.affineOpens, Z.basicOpen (1 - a W)) := by rw [hW]; trivial
      obtain ⟨W, hyW⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
      have hyW1 : y ∈ W.1 := Z.basicOpen_le _ hyW
      obtain ⟨g', hg'le, hyg'⟩ :=
        W.2.exists_basicOpen_le (V := U ⊓ Z.basicOpen (1 - a W)) ⟨y, ⟨hy, hyW⟩⟩ hyW1
      exact TopologicalSpace.Opens.mem_iSup.mpr
        ⟨⟨Z.basicOpen g', le_trans hg'le inf_le_left, s4 W g' (le_trans hg'le inf_le_right)⟩, hyg'⟩
    let NS : TopCat.Sheaf Ab.{u} Z := ⟨N.presheaf, N.isSheaf⟩
    refine TopCat.Sheaf.eq_of_locally_eq' NS Wf U (fun i => homOfLE i.2.1) hcov _ _ ?_
    intro i
    have h1 := NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf (f - g))
      (homOfLE i.2.1).op x
    simp only [Scheme.Modules.mapPresheaf_app] at h1
    change N.presheaf.map (homOfLE i.2.1).op (Scheme.Modules.Hom.app (f - g) U x) =
      N.presheaf.map (homOfLE i.2.1).op 0
    rw [← h1, map_zero]
    exact i.2.2 _

  apply Scheme.Modules.hom_ext
  intro U
  ext x
  have h0 := hloc U x
  rw [hd] at h0
  exact sub_eq_zero.mp h0

theorem wc_cn_kernel_coherent : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (M N : Z.Modules) (b : M ⟶ N), wcCoherentMod M → wcCoherentMod N → ∃ (K : Z.Modules) (ι : K ⟶ M), wcCoherentMod K ∧ ι ≫ b = 0 ∧ (∀ V : Z.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) ∧ ∀ (V : Z.Opens), IsAffineOpen V → ∀ x : Γ(M, V), Scheme.Modules.Hom.app b V x = 0 ↔ ∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = x :=
by
  intro Z _ M N b hM hN
  have sesLE : ∀ (S : ShortComplex Z.Modules), S.ShortExact →
      (∀ U : Z.Opens, Function.Injective (Scheme.Modules.Hom.app S.f U)) ∧
      ∀ (U : Z.Opens) (y : Γ(S.X₂, U)), Scheme.Modules.Hom.app S.g U y = 0 →
        ∃ x, Scheme.Modules.Hom.app S.f U x = y := by
    intro S hS
    refine ⟨fun U => ?_, fun U y hy => ?_⟩
    · exact (AddCommGrpCat.mono_iff_injective _).mp
        (@Functor.map_mono _ _ _ _
          (SheafOfModules.toSheaf Z.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
            (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
          inferInstance _ _ S.f hS.mono_f)
    · letI : (SheafOfModules.toSheaf Z.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
          (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U) :
            Z.Modules ⥤ AddCommGrpCat.{u}).PreservesZeroMorphisms :=
        ⟨fun _ _ => Scheme.Modules.Hom.zero_app⟩
      have hE := hS.exact.map_of_mono_of_preservesKernel
        (SheafOfModules.toSheaf Z.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
          (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
        hS.mono_f (@Limits.PreservesLimitsOfShape.preservesLimit _ _ _ _ _ _
          (SheafOfModules.toSheaf Z.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
            (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
          (Limits.PreservesFiniteLimits.preservesFiniteLimits Limits.WalkingParallelPair) _)
      obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy
      exact ⟨x, hx⟩
  have hS1 : (ShortComplex.mk (Limits.kernel.ι b) (Abelian.coimage.π b)
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (Limits.kernel.ι b))
      inferInstance inferInstance
  have hS2 : (ShortComplex.mk (Abelian.factorThruCoimage b)
      (Limits.cokernel.π (Abelian.factorThruCoimage b)) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  obtain ⟨K1, E1⟩ := sesLE _ hS1
  obtain ⟨K2, -⟩ := sesLE _ hS2
  have K1' : ∀ V, Function.Injective (Scheme.Modules.Hom.app (Limits.kernel.ι b) V) := K1
  have K2' : ∀ V, Function.Injective (Scheme.Modules.Hom.app (Abelian.factorThruCoimage b) V) :=
    K2
  have E1' : ∀ V (y : Γ(M, V)), Scheme.Modules.Hom.app (Abelian.coimage.π b) V y = 0 →
      ∃ x, Scheme.Modules.Hom.app (Limits.kernel.ι b) V x = y := E1
  have capp : ∀ {P Q R : Z.Modules} (g : P ⟶ Q) (k : Q ⟶ R) (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (g ≫ k) V x =
        Scheme.Modules.Hom.app k V (Scheme.Modules.Hom.app g V x) := by
    intro P Q R g k V x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : Z.Modules} (V : Z.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) V x = 0 := by
    intro P Q V x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have K4 : ∀ V (s : Γ(Limits.kernel b, V)),
      Scheme.Modules.Hom.app b V (Scheme.Modules.Hom.app (Limits.kernel.ι b) V s) = 0 := by
    intro V s
    rw [← capp, Limits.kernel.condition, zapp]
  have K3 : ∀ V (y : Γ(M, V)), Scheme.Modules.Hom.app b V y = 0 →
      ∃ x, Scheme.Modules.Hom.app (Limits.kernel.ι b) V x = y := by
    intro V y hy
    apply E1' V y
    apply K2' V
    rw [← capp, Abelian.coimage.fac, hy, map_zero]
  have hqc : wcQcoh (Limits.kernel b) := by
    intro U hU f
    have nat : ∀ {P Q : Z.Modules} (g : P ⟶ Q) (x : Γ(P, U)),
        Scheme.Modules.Hom.app g (Z.basicOpen f)
            ((P.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom x) =
          (Q.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
            (Scheme.Modules.Hom.app g U x) := by
      intro P Q g x
      exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g)
        (homOfLE (Z.basicOpen_le f)).op x
    have rsmul : ∀ {P : Z.Modules} (r : Γ(Z, U)) (x : Γ(P, U)),
        (P.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (r • x) =
          (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom r •
            (P.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom x := by
      intro P r x
      exact Scheme.Modules.map_smul P _ r x
    refine ⟨fun s => ?_, fun t ht => ?_⟩
    · obtain ⟨n, t, ht⟩ := (hM.1 U hU f).1 (Scheme.Modules.Hom.app (Limits.kernel.ι b) _ s)
      have h0 : (N.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
          (Scheme.Modules.Hom.app b U t) = 0 := by
        rw [← nat, ← ht, Scheme.Modules.Hom.app_smul, K4, smul_zero]
      obtain ⟨m, hm⟩ := (hN.1 U hU f).2 _ h0
      rw [← Scheme.Modules.Hom.app_smul] at hm
      obtain ⟨t₀, ht₀⟩ := K3 U _ hm
      refine ⟨m + n, t₀, K1' _ ?_⟩
      rw [Scheme.Modules.Hom.app_smul, nat, ht₀, rsmul, ← ht, map_pow, pow_add, mul_smul]
    · have h1 : (M.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
          (Scheme.Modules.Hom.app (Limits.kernel.ι b) U t) = 0 := by
        rw [← nat, ht, map_zero]
      obtain ⟨n, hn⟩ := (hM.1 U hU f).2 _ h1
      refine ⟨n, K1' U ?_⟩
      rw [Scheme.Modules.Hom.app_smul, hn, map_zero]
  refine ⟨Limits.kernel b, Limits.kernel.ι b, ⟨hqc, fun V hV => ?_⟩, Limits.kernel.condition b,
    K1', fun V _ x => ⟨fun hx => K3 V x hx, fun ⟨k, hk⟩ => ?_⟩⟩
  · haveI : IsNoetherianRing Γ(Z, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
    haveI : Module.Finite Γ(Z, V) Γ(M, V) := hM.2 V hV
    haveI : IsNoetherian Γ(Z, V) Γ(M, V) :=
      isNoetherian_of_isNoetherianRing_of_finite Γ(Z, V) Γ(M, V)
    exact Module.Finite.of_injective (wcCnSecLin (Limits.kernel.ι b) V) (K1' V)
  · rw [← hk]
    exact K4 V k

theorem wc_cn_cokernel_coherent : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (M N : Z.Modules) (b : M ⟶ N), wcCoherentMod M → wcCoherentMod N → ∃ (C : Z.Modules) (π : N ⟶ C), wcCoherentMod C ∧ b ≫ π = 0 ∧ ∀ (V : Z.Opens), IsAffineOpen V → Function.Surjective (Scheme.Modules.Hom.app π V) ∧ ∀ y : Γ(N, V), Scheme.Modules.Hom.app π V y = 0 ↔ ∃ x : Γ(M, V), Scheme.Modules.Hom.app b V x = y :=
by
  intro Z _ M N b hM hN
  have capp : ∀ {P Q R : Z.Modules} (f : P ⟶ Q) (k : Q ⟶ R) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ k) U x =
        Scheme.Modules.Hom.app k U (Scheme.Modules.Hom.app f U x) := by
    intro P Q R f k U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : Z.Modules} (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) U x = 0 := by
    intro P Q U x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have hfac : Abelian.coimage.π b ≫ Abelian.factorThruCoimage b = b := Abelian.coimage.fac b
  have hK : wcQcoh (Limits.kernel b) := wc_cn_kernel_qcoh Z M N b hM.1 hN.1
  obtain ⟨hIcoh, hpsurj⟩ := wc_cn_coimage_coherent Z M N b hM hN hK
  obtain ⟨hSES, hCcoh, -, -⟩ := wc_dev_cokernel_coh Z (Abelian.coimage b) N
    (Abelian.factorThruCoimage b) inferInstance hIcoh hN
  have hπs : ∀ U : Z.Opens, IsAffineOpen U → Function.Surjective
      (Scheme.Modules.Hom.app (Limits.cokernel.π (Abelian.factorThruCoimage b)) U) :=
    fun U hU => wc_modules_ses_affine_surj Z _ hSES hIcoh.1 U hU
  have hbπ : b ≫ Limits.cokernel.π (Abelian.factorThruCoimage b) = 0 := by
    have e : (Abelian.coimage.π b ≫ Abelian.factorThruCoimage b) ≫
        Limits.cokernel.π (Abelian.factorThruCoimage b) = 0 := by
      rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    rwa [hfac] at e
  have hlex := (wc_modules_ses_left_exact Z _ hSES).2
  refine ⟨Limits.cokernel (Abelian.factorThruCoimage b),
    Limits.cokernel.π (Abelian.factorThruCoimage b), hCcoh, hbπ, fun V hV => ⟨hπs V hV, fun y => ?_⟩⟩
  constructor
  · intro hy
    obtain ⟨x', hx'⟩ := hlex V y hy
    obtain ⟨x, hx⟩ := hpsurj V hV x'
    refine ⟨x, ?_⟩
    rw [← hfac, capp, hx]
    exact hx'
  · rintro ⟨x, rfl⟩
    rw [← capp, hbπ, zapp]

theorem wc_cn_coh_sub_closed_fibre_zero : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (C N : Z.Modules) (ι : C ⟶ N), wcCoherentMod C → wcCoherentMod N → (∀ V : Z.Opens, IsAffineOpen V → Function.Injective (Scheme.Modules.Hom.app ι V)) → (∀ (V : Z.Opens), IsAffineOpen V → ∀ (x : Γ(C, V)) (n : ℕ), Scheme.Modules.Hom.app ι V x ∈ Ideal.map (wcCnSigma h V) (IsLocalRing.maximalIdeal B ^ (n + 1)) • (⊤ : Submodule Γ(Z, V) Γ(N, V))) → ∀ (V : Z.Opens), IsAffineOpen V → ∀ x : Γ(C, V), x = 0 :=
by
  intro B _ _ _ Z h _ C N ι hC hN hinj hmem
  classical

  have krull : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (P Q : Type u) [AddCommGroup P]
      [Module R P] [AddCommGroup Q] [Module R Q] [Module.Finite R P] [Module.Finite R Q]
      (I : Ideal R) (L : P →ₗ[R] Q),
      (∀ (x : P) (n : ℕ), L x ∈ I ^ (n + 1) • (⊤ : Submodule R Q)) →
      ∃ a ∈ I, ∀ x : P, (1 - a) • L x = 0 := by
    intro R _ _ P Q _ _ _ _ _ _ I L hL
    have h1 : ∀ x : P, ∃ r ∈ I, (1 - r) • L x = 0 := by
      intro x
      have hmem : L x ∈ ⨅ i, I ^ i • (⊤ : Submodule R Q) := by
        rw [Submodule.mem_iInf]
        intro i
        cases i with
        | zero =>
          rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
          exact Submodule.mem_top
        | succ n => exact hL x n
      obtain ⟨r, hr⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff I (L x)).mp hmem
      exact ⟨r, r.2, by rw [sub_smul, one_smul, hr, sub_self]⟩
    have h2 : ∀ S : Finset P, ∃ a ∈ I, ∀ x ∈ S, (1 - a) • L x = 0 := by
      intro S
      induction S using Finset.induction_on with
      | empty => exact ⟨0, I.zero_mem, fun x hx => absurd hx (Finset.notMem_empty x)⟩
      | insert y S _ ih =>
        obtain ⟨a, ha, hka⟩ := ih
        obtain ⟨r, hr, hkr⟩ := h1 y
        refine ⟨a + r - a * r, I.sub_mem (I.add_mem ha hr) (I.mul_mem_right r ha), fun x hx => ?_⟩
        have e : (1 - (a + r - a * r)) = (1 - r) * (1 - a) := by ring
        rw [e, mul_smul]
        rcases Finset.mem_insert.mp hx with hxy | hx
        · rw [hxy, smul_comm (1 - r) (1 - a) (L y), hkr, smul_zero]
        · rw [hka x hx, smul_zero]
    obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := R) (M := P)
    obtain ⟨a, ha, hka⟩ := h2 S
    refine ⟨a, ha, fun x => ?_⟩
    have hx : x ∈ Submodule.span R (S : Set P) := by rw [hS]; exact Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem y hy => exact hka y hy
    | zero => rw [map_zero, smul_zero]
    | add y z _ _ hy hz => rw [map_add, smul_add, hy, hz, add_zero]
    | smul c y _ hy => rw [map_smul, smul_comm, hy, smul_zero]

  haveI : IsLocallyNoetherian (Spec (.of B)) := isLocallyNoetherian_Spec.mpr inferInstance
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h

  have key : ∀ U : Z.affineOpens, ∃ a ∈ Ideal.map (wcCnSigma h U.1) (IsLocalRing.maximalIdeal B),
      ∀ t : Γ(C, U.1), (1 - a) • Scheme.Modules.Hom.app ι U.1 t = 0 := by
    intro U
    haveI : IsNoetherianRing Γ(Z, U.1) := IsLocallyNoetherian.component_noetherian U
    haveI : Module.Finite Γ(Z, U.1) Γ(C, U.1) := hC.2 U.1 U.2
    haveI : Module.Finite Γ(Z, U.1) Γ(N, U.1) := hN.2 U.1 U.2
    let L : Γ(C, U.1) →ₗ[Γ(Z, U.1)] Γ(N, U.1) :=
      { toFun := fun x => Scheme.Modules.Hom.app ι U.1 x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun r x => Scheme.Modules.Hom.app_smul ι r x }
    refine krull Γ(Z, U.1) Γ(C, U.1) Γ(N, U.1) _ L ?_
    intro x n
    have h3 := hmem U.1 U.2 x n
    rw [Ideal.map_pow] at h3
    exact h3
  choose a ha hka using key

  have s2 : ∀ (U : Z.Opens) (z : Z) (hz : z ∈ U), h z = IsLocalRing.closedPoint B →
      ∀ a ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B), z ∈ Z.basicOpen (1 - a) := by
    intro U z hz hzc a ha
    have hle : Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B) ≤
        Ideal.comap (Z.presheaf.germ U z hz).hom
          (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hunit
      have h1 : z ∈ Z.basicOpen (wcCnSigma h U b) := (Scheme.mem_basicOpen Z _ z hz).mpr hunit
      have h2 : Z.basicOpen (wcCnSigma h U b) =
          U ⊓ Z.basicOpen (h.appTop ((Scheme.ΓSpecIso (.of B)).inv b)) :=
        Scheme.basicOpen_res Z _ _
      rw [h2] at h1
      have h3 : z ∈ Z.basicOpen (h.appTop ((Scheme.ΓSpecIso (.of B)).inv b)) :=
        (TopologicalSpace.Opens.mem_inf.mp h1).2
      have h4 : z ∈ h ⁻¹ᵁ (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv b) := by
        rw [Scheme.preimage_basicOpen]; exact h3
      rw [basicOpen_eq_of_affine] at h4
      have h5 : b ∉ (h z).asIdeal := h4
      rw [hzc] at h5
      exact h5 hb
    have hga : (Z.presheaf.germ U z hz).hom a ∈ nonunits (Z.presheaf.stalk z) :=
      (IsLocalRing.mem_maximalIdeal _).mp (hle ha)
    rw [Scheme.mem_basicOpen Z _ z hz, map_sub, map_one]
    exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hga

  have s3 : ∀ (W : Z.Opens), (∀ z : Z, h z = IsLocalRing.closedPoint B → z ∈ W) → W = ⊤ := by
    intro W hW
    rw [eq_top_iff]
    intro z₁ _
    by_contra hz₁
    have hCl : IsClosed ((W : Set Z)ᶜ) := W.isOpen.isClosed_compl
    have hhC : IsClosed (h '' ((W : Set Z)ᶜ)) := Scheme.Hom.isClosedMap h _ hCl
    have hspec : h z₁ ⤳ IsLocalRing.closedPoint B :=
      (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal (h z₁).2.ne_top)
    obtain ⟨z, hzC, hz⟩ := hspec.mem_closed hhC ⟨z₁, hz₁, rfl⟩
    exact hzC (hW z hz)

  have hW : (⨆ U : Z.affineOpens, Z.basicOpen (1 - a U)) = ⊤ := by
    apply s3
    intro z hz
    obtain ⟨U', hU', hzU', -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
        (show z ∈ (⊤ : Z.Opens) from trivial)
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨U', hU'⟩, s2 U' z hzU' hz _ (ha ⟨U', hU'⟩)⟩

  have s4 : ∀ (W : Z.affineOpens) (g' : Γ(Z, W.1)), Z.basicOpen g' ≤ Z.basicOpen (1 - a W) →
      ∀ s : Γ(C, Z.basicOpen g'), s = 0 := by
    intro W g' hle s
    obtain ⟨n, t, ht⟩ := (hC.1 W.1 W.2 g').1 s
    have hnat : Scheme.Modules.Hom.app ι (Z.basicOpen g')
          ((C.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom t) =
        (N.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom
          (Scheme.Modules.Hom.app ι W.1 t) := by
      have h1 := NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf ι)
        (homOfLE (Z.basicOpen_le g')).op t
      simp only [Scheme.Modules.mapPresheaf_app] at h1
      exact h1
    have hu1 : IsUnit (Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op (1 - a W)) := by
      have e : Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op =
          Z.presheaf.map (homOfLE (Z.basicOpen_le (1 - a W))).op ≫
            Z.presheaf.map (homOfLE hle).op := by
        rw [← Functor.map_comp]
        rfl
      rw [e, ConcreteCategory.comp_apply]
      exact (RingedSpace.isUnit_res_basicOpen Z.toRingedSpace (1 - a W)).map _
    have hdt : (N.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom
        (Scheme.Modules.Hom.app ι W.1 t) = 0 := by
      have e := Scheme.Modules.map_smul N (homOfLE (Z.basicOpen_le g')) (1 - a W)
        (Scheme.Modules.Hom.app ι W.1 t)
      rw [hka W t, map_zero] at e
      exact (hu1.smul_eq_zero).mp e.symm
    have hu2 : IsUnit (((Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom g') ^ n) :=
      (RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g').pow n
    have h3 : ((Z.presheaf.map (homOfLE (Z.basicOpen_le g')).op).hom g') ^ n •
        Scheme.Modules.Hom.app ι (Z.basicOpen g') s = 0 := by
      rw [← Scheme.Modules.Hom.app_smul, ht, hnat, hdt]
    have h0 : Scheme.Modules.Hom.app ι (Z.basicOpen g') s = 0 := (hu2.smul_eq_zero).mp h3
    apply hinj _ (W.2.basicOpen g')
    rw [h0, map_zero]

  intro V _ x
  let ιx := {V' : Z.Opens // V' ≤ V ∧ ∀ s : Γ(C, V'), s = 0}
  let Wf : ιx → Z.Opens := fun i => i.1
  have hcov : V ≤ iSup Wf := by
    intro y hy
    have hy' : y ∈ (⨆ W : Z.affineOpens, Z.basicOpen (1 - a W)) := by rw [hW]; trivial
    obtain ⟨W, hyW⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
    have hyW1 : y ∈ W.1 := Z.basicOpen_le _ hyW
    obtain ⟨g', hg'le, hyg'⟩ :=
      W.2.exists_basicOpen_le (V := V ⊓ Z.basicOpen (1 - a W)) ⟨y, ⟨hy, hyW⟩⟩ hyW1
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨Z.basicOpen g', le_trans hg'le inf_le_left, s4 W g' (le_trans hg'le inf_le_right)⟩, hyg'⟩
  let CS : TopCat.Sheaf Ab.{u} Z := ⟨C.presheaf, C.isSheaf⟩
  refine TopCat.Sheaf.eq_of_locally_eq' CS Wf V (fun i => homOfLE i.2.1) hcov _ _ ?_
  intro i
  exact (i.2.2 _).trans (i.2.2 _).symm

theorem wc_cn_almost_of_levels : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) [IsProper h] (𝒥 : Z.IdealSheafData) (c : ℕ)
    (Fs Hs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n)
    (G H' : Z.Modules) (χ : ∀ n, G ⟶ Fs n) (χH : ∀ n, H' ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n)
    (β : G ⟶ H'), wcCnAlg h (IsLocalRing.maximalIdeal B) Fs ψ G χ →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Hs ψH H' χH →
    (∀ n, β ≫ χH n = χ n ≫ α n) → (∀ n, wcCnAlmostIso 𝒥 c (α n)) → wcCnAlmostIso 𝒥 c β :=
by
  intro B _ _ _ Z h _ 𝒥 c Fs Hs ψ ψH G H' χ χH α β hG hH hcompat hα
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : CompactSpace Z :=
    ⟨by simpa using QuasiCompact.isCompact_preimage (f := h) Set.univ isOpen_univ isCompact_univ⟩
  haveI : IsNoetherian Z := {}
  obtain ⟨hGcoh, -, hGsec⟩ := hG
  obtain ⟨hHcoh, -, hHsec⟩ := hH

  have hcomp : ∀ {A A' A'' : Z.Modules} (a : A ⟶ A') (b : A' ⟶ A'') (d : A ⟶ A''), a ≫ b = d →
      ∀ (V : Z.Opens) (x : Γ(A, V)),
        Scheme.Modules.Hom.app b V (Scheme.Modules.Hom.app a V x) =
          Scheme.Modules.Hom.app d V x := by
    intro A A' A'' a b d e V x
    rw [← e, Scheme.Modules.Hom.comp_app]
    rfl
  have hβχ : ∀ n (V : Z.Opens) (x : Γ(G, V)),
      Scheme.Modules.Hom.app (χH n) V (Scheme.Modules.Hom.app β V x) =
        Scheme.Modules.Hom.app (α n) V (Scheme.Modules.Hom.app (χ n) V x) := by
    intro n V x
    rw [hcomp β (χH n) _ (hcompat n) V x, hcomp (χ n) (α n) _ rfl V x]

  have hSub : ∀ M : Z.Modules, wcCoherentMod M → ∃ (K : Z.Modules) (ι : K ⟶ M),
      wcCoherentMod K ∧
      (∀ V : Z.Opens, IsAffineOpen V → Function.Injective (Scheme.Modules.Hom.app ι V)) ∧
      ∀ (V : Z.Opens) (hV : IsAffineOpen V) (m : Γ(M, V)),
        (∃ k, Scheme.Modules.Hom.app ι V k = m) ↔
          m ∈ (𝒥.ideal ⟨V, hV⟩ ^ c : Ideal Γ(Z, V)) • (⊤ : Submodule Γ(Z, V) Γ(M, V)) := by
    intro M hM
    let I : ∀ V : Z.Opens, IsAffineOpen V → Ideal Γ(Z, V) := fun V hV => 𝒥.ideal ⟨V, hV⟩ ^ c
    have hC : ∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V),
        Ideal.map (Z.presheaf.map (homOfLE hWV).op).hom (I V hV) = I W hW := by
      intro V W hV hW hWV
      show Ideal.map _ (𝒥.ideal ⟨V, hV⟩ ^ c) = 𝒥.ideal ⟨W, hW⟩ ^ c
      rw [Ideal.map_pow]
      exact congrArg (· ^ c) (𝒥.map_ideal (U := ⟨W, hW⟩) (V := ⟨V, hV⟩) hWV)
    obtain ⟨hR, hB⟩ := wc_cn_ideal_family_smul_compat Z I hC M
    have hB' := hB hM.1
    have hL := wc_cn_affine_family_local Z M (fun V hV => I V hV • ⊤) hM.1 hR hB'
    obtain ⟨K₀, ι₀, hmono, hinj, hrange⟩ :=
      wc_cn_affine_family_subsheaf Z M (fun V hV => I V hV • ⊤) hR hL
    obtain ⟨Q', π, -, hQcoh, hsec, -⟩ :=
      wc_cn_affine_family_cokernel Z M K₀ ι₀ (fun V hV => I V hV • ⊤) hmono hM hinj hrange hB'
    obtain ⟨K, ι, hKcoh, -, hιinj, hιker⟩ := wc_cn_kernel_coherent Z M Q' π hM hQcoh
    refine ⟨K, ι, hKcoh, fun V _ => hιinj V, fun V hV m => ?_⟩
    rw [← hιker V hV m]
    exact (hsec V hV).2 m

  obtain ⟨K, ι, hKcoh, hιβ, hιinj, hιker⟩ := wc_cn_kernel_coherent Z G H' β hGcoh hHcoh
  obtain ⟨K₂, ι₂, hK₂coh, hι₂inj, hι₂rng⟩ := hSub K hKcoh
  have hβι : ∀ (W : Z.Opens) (m : Γ(K, W)),
      Scheme.Modules.Hom.app β W (Scheme.Modules.Hom.app ι W m) = 0 := by
    intro W m
    rw [hcomp ι β 0 hιβ W m, Scheme.Modules.Hom.zero_app]
    rfl
  have hK₂0 : ∀ (W : Z.Opens), IsAffineOpen W → ∀ x : Γ(K₂, W), x = 0 := by
    refine wc_cn_coh_sub_closed_fibre_zero B Z h K₂ G (ι₂ ≫ ι) hK₂coh hGcoh ?_ ?_
    · intro W hW x y hxy
      rw [← hcomp ι₂ ι _ rfl W x, ← hcomp ι₂ ι _ rfl W y] at hxy
      exact hι₂inj W hW (hιinj W hxy)
    · intro W hW x n
      rw [← hcomp ι₂ ι _ rfl W x, ← (hGsec n W hW).2]
      have hk : Scheme.Modules.Hom.app ι₂ W x ∈
          (𝒥.ideal ⟨W, hW⟩ ^ c : Ideal Γ(Z, W)) • (⊤ : Submodule Γ(Z, W) Γ(K, W)) :=
        (hι₂rng W hW _).mp ⟨x, rfl⟩
      refine Submodule.smul_induction_on
        (p := fun k => Scheme.Modules.Hom.app (χ n) W (Scheme.Modules.Hom.app ι W k) = 0) hk
        (fun r hr m _ => ?_) (fun x y hx hy => ?_)
      · show Scheme.Modules.Hom.app (χ n) W (Scheme.Modules.Hom.app ι W (r • m)) = 0
        rw [Scheme.Modules.Hom.app_smul, Scheme.Modules.Hom.app_smul]
        have h0 : Scheme.Modules.Hom.app (α n) W
            (Scheme.Modules.Hom.app (χ n) W (Scheme.Modules.Hom.app ι W m)) = 0 := by
          rw [← hβχ n W, hβι W m, map_zero]
        exact (hα n W hW).1 _ h0 r hr
      · show Scheme.Modules.Hom.app (χ n) W (Scheme.Modules.Hom.app ι W (x + y)) = 0
        rw [map_add, map_add, hx, hy, add_zero]

  obtain ⟨C, π, hCcoh, hβπ, hπ⟩ := wc_cn_cokernel_coherent Z G H' β hGcoh hHcoh
  obtain ⟨C₂, ι₃, hC₂coh, hι₃inj, hι₃rng⟩ := hSub C hCcoh
  have hπβ : ∀ (W : Z.Opens) (g : Γ(G, W)),
      Scheme.Modules.Hom.app π W (Scheme.Modules.Hom.app β W g) = 0 := by
    intro W g
    rw [hcomp β π 0 hβπ W g, Scheme.Modules.Hom.zero_app]
    rfl
  have hLIN : ∀ (W : Z.Opens) (𝔞 : Ideal Γ(Z, W)) (s : Γ(H', W)),
      s ∈ 𝔞 • (⊤ : Submodule Γ(Z, W) Γ(H', W)) →
      Scheme.Modules.Hom.app π W s ∈ 𝔞 • (⊤ : Submodule Γ(Z, W) Γ(C, W)) := by
    intro W 𝔞 s hs
    refine Submodule.smul_induction_on hs ?_ ?_
    · intro r hr n _
      rw [Scheme.Modules.Hom.app_smul]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  have hstar : ∀ (W : Z.Opens) (hW : IsAffineOpen W), ∀ r ∈ 𝒥.ideal ⟨W, hW⟩ ^ c,
      ∀ (y' : Γ(H', W)) (n : ℕ),
      Scheme.Modules.Hom.app π W (r • y') ∈
        Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
          (⊤ : Submodule Γ(Z, W) Γ(C, W)) := by
    intro W hW r hr y' n
    obtain ⟨w, hw⟩ := (hα n W hW).2 (Scheme.Modules.Hom.app (χH n) W y') r hr
    obtain ⟨g, hg⟩ := (hGsec n W hW).1 w
    have hd : Scheme.Modules.Hom.app (χH n) W (r • y' - Scheme.Modules.Hom.app β W g) = 0 := by
      rw [map_sub, Scheme.Modules.Hom.app_smul, hβχ n W g, hg, hw, sub_self]
    have hd' := ((hHsec n W hW).2 _).mp hd
    have h1 := hLIN W _ _ hd'
    rw [map_sub, hπβ, sub_zero] at h1
    exact h1
  have hC₂0 : ∀ (W : Z.Opens), IsAffineOpen W → ∀ x : Γ(C₂, W), x = 0 := by
    refine wc_cn_coh_sub_closed_fibre_zero B Z h C₂ C ι₃ hC₂coh hCcoh hι₃inj ?_
    intro W hW x n
    have hx : Scheme.Modules.Hom.app ι₃ W x ∈
        (𝒥.ideal ⟨W, hW⟩ ^ c : Ideal Γ(Z, W)) • (⊤ : Submodule Γ(Z, W) Γ(C, W)) :=
      (hι₃rng W hW _).mp ⟨x, rfl⟩
    refine Submodule.smul_induction_on
      (p := fun z => z ∈ Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
        (⊤ : Submodule Γ(Z, W) Γ(C, W))) hx (fun r hr z _ => ?_)
      (fun x y hx hy => Submodule.add_mem _ hx hy)
    obtain ⟨y', rfl⟩ := (hπ W hW).1 z
    show r • Scheme.Modules.Hom.app π W y' ∈ _
    rw [← Scheme.Modules.Hom.app_smul]
    exact hstar W hW r hr y' n

  intro V hV
  refine ⟨fun s hs a ha => ?_, fun y a ha => ?_⟩
  · obtain ⟨k, hk⟩ := (hιker V hV s).mp hs
    have hak : a • k ∈ (𝒥.ideal ⟨V, hV⟩ ^ c : Ideal Γ(Z, V)) •
        (⊤ : Submodule Γ(Z, V) Γ(K, V)) := Submodule.smul_mem_smul ha Submodule.mem_top
    obtain ⟨x, hx⟩ := (hι₂rng V hV (a • k)).mpr hak
    rw [hK₂0 V hV x, map_zero] at hx
    rw [← hk, ← Scheme.Modules.Hom.app_smul, ← hx, map_zero]
  · have hm : Scheme.Modules.Hom.app π V (a • y) ∈ (𝒥.ideal ⟨V, hV⟩ ^ c : Ideal Γ(Z, V)) •
        (⊤ : Submodule Γ(Z, V) Γ(C, V)) := by
      rw [Scheme.Modules.Hom.app_smul]
      exact Submodule.smul_mem_smul ha Submodule.mem_top
    obtain ⟨x, hx⟩ := (hι₃rng V hV _).mpr hm
    rw [hC₂0 V hV x, map_zero] at hx
    exact ((hπ V hV).2 (a • y)).mp hx.symm

theorem wc_cn_088A_layers : wcCnFormalFns.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    [IsProper h] (𝒦 𝒥 : Z.IdealSheafData),
    (∀ 𝒦' : Z.IdealSheafData, 𝒦 ≤ 𝒦' →
      (∃ e : ℕ, 1 ≤ e ∧ ∀ (V : Z.Opens) (hV : IsAffineOpen V),
        𝒥.ideal ⟨V, hV⟩ ^ e ≤ 𝒦'.ideal ⟨V, hV⟩) →
      wcCnXi h (IsLocalRing.maximalIdeal B) 𝒦') →
    ∀ (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ →
    ∀ (H : Z.Modules) (Hs : ℕ → Z.Modules) (ψH : ∀ n, Hs (n + 1) ⟶ Hs n)
      (φH : ∀ n, H ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Hs ψH →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Hs ψH H φH →
    ∀ Q : wcCn088AQuot h (IsLocalRing.maximalIdeal B) 𝒦 𝒥 Fs ψ Hs ψH α,
    Nonempty (wcCn088ALayers Q H φH) :=
by
  intro hFF B _ _ _ _ Z h _ 𝒦 𝒥 hXi Fs ψ hF H Hs ψH φH α hHs hHalg Q
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian h

  have hpow : ∀ k : ℕ, ∃ 𝒥k : Z.IdealSheafData, ∀ (V : Z.Opens) (hV : IsAffineOpen V),
      𝒥k.ideal ⟨V, hV⟩ = 𝒥.ideal ⟨V, hV⟩ ^ k := by
    intro k
    refine ⟨Scheme.IdealSheafData.mk (fun U => 𝒥.ideal U ^ k) ?_
      (⋂ U, Z.zeroLocus (U := U.1) ((𝒥.ideal U ^ k : Ideal _) : Set _)) rfl, fun V hV => rfl⟩
    intro U f
    rw [Ideal.map_pow]
    exact congrArg (· ^ k) (𝒥.map_ideal_basicOpen U f)
  choose 𝒥p h𝒥p using hpow

  have hLIN : ∀ {A A' : Z.Modules} (φ : A ⟶ A') (V : Z.Opens) (𝔞 : Ideal Γ(Z, V)) (s : Γ(A, V)),
      s ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(A, V)) →
      Scheme.Modules.Hom.app φ V s ∈ 𝔞 • (⊤ : Submodule Γ(Z, V) Γ(A', V)) := by
    intro A A' φ V 𝔞 s hs
    refine Submodule.smul_induction_on hs ?_ ?_
    · intro r hr n _
      rw [Scheme.Modules.Hom.app_smul]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  have hcomp : ∀ {A A' A'' : Z.Modules} (a : A ⟶ A') (b : A' ⟶ A'') (c : A ⟶ A''), a ≫ b = c →
      ∀ (V : Z.Opens) (x : Γ(A, V)),
        Scheme.Modules.Hom.app b V (Scheme.Modules.Hom.app a V x) = Scheme.Modules.Hom.app c V x := by
    intro A A' A'' a b c e V x
    rw [← e, Scheme.Modules.Hom.comp_app]
    rfl
  have hkillOf : ∀ (T : Z.Modules) (k : ℕ), (∀ (V : Z.Opens) (hV : IsAffineOpen V),
      (𝒥.ideal ⟨V, hV⟩ ^ k : Ideal Γ(Z, V)) • (⊤ : Submodule Γ(Z, V) Γ(T, V)) = ⊥) →
      wcCnKilled (𝒥p k) T := by
    intro T k hT V hV a ha s
    rw [h𝒥p] at ha
    have h1 := Submodule.smul_mem_smul ha (Submodule.mem_top (x := s))
    rw [hT V hV] at h1
    exact (Submodule.mem_bot _).mp h1

  haveI : CompactSpace Z :=
    ⟨by simpa using QuasiCompact.isCompact_preimage (f := h) Set.univ isOpen_univ isCompact_univ⟩
  haveI : IsNoetherian Z := {}
  have hQ : ∀ (k : ℕ) (M : Z.Modules), wcCoherentMod M → ∃ (Q : Z.Modules) (π : M ⟶ Q),
      Epi π ∧ wcCoherentMod Q ∧
      (∀ (V : Z.Opens) (hV : IsAffineOpen V), Function.Surjective (Scheme.Modules.Hom.app π V) ∧
        ∀ s : Γ(M, V), Scheme.Modules.Hom.app π V s = 0 ↔
          s ∈ (𝒥p k).ideal ⟨V, hV⟩ • (⊤ : Submodule Γ(Z, V) Γ(M, V))) ∧
      ∀ (T : Z.Modules) (u : M ⟶ T), wcCnKilled (𝒥p k) T → ∃ u' : Q ⟶ T, π ≫ u' = u := by
    intro k M hM
    let I : ∀ V : Z.Opens, IsAffineOpen V → Ideal Γ(Z, V) := fun V hV => 𝒥.ideal ⟨V, hV⟩ ^ k
    have hC : ∀ (V W : Z.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (hWV : W ≤ V),
        Ideal.map (Z.presheaf.map (homOfLE hWV).op).hom (I V hV) = I W hW := by
      intro V W hV hW hWV
      show Ideal.map _ (𝒥.ideal ⟨V, hV⟩ ^ k) = 𝒥.ideal ⟨W, hW⟩ ^ k
      rw [Ideal.map_pow]
      exact congrArg (· ^ k) (𝒥.map_ideal (U := ⟨W, hW⟩) (V := ⟨V, hV⟩) hWV)
    obtain ⟨hR, hB⟩ := wc_cn_ideal_family_smul_compat Z I hC M
    have hB' := hB hM.1
    have hL := wc_cn_affine_family_local Z M (fun V hV => I V hV • ⊤) hM.1 hR hB'
    obtain ⟨K, ι, hmono, hinj, hrange⟩ :=
      wc_cn_affine_family_subsheaf Z M (fun V hV => I V hV • ⊤) hR hL
    obtain ⟨Q', π, hepi, hQcoh, hsec, huniv⟩ :=
      wc_cn_affine_family_cokernel Z M K ι (fun V hV => I V hV • ⊤) hmono hM hinj hrange hB'
    refine ⟨Q', π, hepi, hQcoh, fun V hV => ⟨(hsec V hV).1, fun s => ?_⟩, fun T u hT => huniv T u ?_⟩
    · rw [h𝒥p]
      exact (hsec V hV).2 s
    · intro V hV s hs
      refine Submodule.smul_induction_on (p := fun x => Scheme.Modules.Hom.app u V x = 0) hs
        (fun r hr n _ => ?_) (fun x y hx hy => ?_)
      · show Scheme.Modules.Hom.app u V (r • n) = 0
        rw [Scheme.Modules.Hom.app_smul]
        exact hT V hV r (by rw [h𝒥p]; exact hr) _
      · show Scheme.Modules.Hom.app u V (x + y) = 0
        rw [map_add, hx, hy, add_zero]

  have hUI : ∀ (Ns : ℕ → Z.Modules) (ψN : ∀ n, Ns (n + 1) ⟶ Ns n) (M M' : Z.Modules)
      (φ : ∀ n, M ⟶ Ns n) (φ' : ∀ n, M' ⟶ Ns n),
      wcCnAdicSys h (IsLocalRing.maximalIdeal B) Ns ψN →
      wcCnAlg h (IsLocalRing.maximalIdeal B) Ns ψN M φ →
      wcCnAlg h (IsLocalRing.maximalIdeal B) Ns ψN M' φ' →
      ∃ (u : M ⟶ M') (v : M' ⟶ M), (∀ n, u ≫ φ' n = φ n) ∧ (∀ n, v ≫ φ n = φ' n) ∧
        u ≫ v = 𝟙 M ∧ v ≫ u = 𝟙 M' := by
    intro Ns ψN M M' φ φ' hNs hM hM'
    obtain ⟨u, hu⟩ := wc_cn_coh_hom_lift hFF B Z h Ns ψN M' φ' hNs hM' M hM.1 φ hM.2.1
    obtain ⟨v, hv⟩ := wc_cn_coh_hom_lift hFF B Z h Ns ψN M φ hNs hM M' hM'.1 φ' hM'.2.1
    refine ⟨u, v, hu, hv, ?_, ?_⟩
    · exact wc_cn_alg_hom_unique B Z h Ns ψN M φ hM M hM.1 _ _
        (fun n => by rw [Category.assoc, hv, hu, Category.id_comp])
    · exact wc_cn_alg_hom_unique B Z h Ns ψN M' φ' hM' M' hM'.1 _ _
        (fun n => by rw [Category.assoc, hu, hv, Category.id_comp])

  have hsup : ∀ (e : ℕ) (V : Z.Opens) (hV : IsAffineOpen V),
      (𝒦 ⊔ 𝒥p (e + 1)).ideal ⟨V, hV⟩ = 𝒦.ideal ⟨V, hV⟩ ⊔ 𝒥.ideal ⟨V, hV⟩ ^ (e + 1) := by
    intro e V hV
    rw [← h𝒥p (e + 1) V hV, Scheme.IdealSheafData.ideal_sup]
    rfl
  have hGex : ∀ e : ℕ, ∃ (G : Z.Modules) (χ : ∀ n, G ⟶ Q.Fq e n),
      wcCnAlg h (IsLocalRing.maximalIdeal B) (Q.Fq e) (Q.ψq e) G χ := by
    intro e
    refine hXi (𝒦 ⊔ 𝒥p (e + 1)) le_sup_left ⟨e + 1, by omega, fun V hV => ?_⟩ (Q.Fq e) (Q.ψq e)
      (Q.Fq_adic e) ?_
    · rw [hsup]
      exact le_sup_right
    · intro n V hV a ha s
      rw [hsup] at ha
      obtain ⟨k, hk, j, hj, rfl⟩ := Submodule.mem_sup.mp ha
      have h3 : (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) •
          (⊤ : Submodule Γ(Z, V) Γ(Q.Fq e n, V)) = ⊥ := (Q.Fq_jadic n).2.2 e V hV
      have hj' := Submodule.smul_mem_smul hj (Submodule.mem_top (x := s))
      rw [h3] at hj'
      rw [add_smul, Q.Fq_killed e n V hV k hk s, (Submodule.mem_bot _).mp hj', add_zero]
  choose G χ hGalg using hGex

  have hτex : ∀ e : ℕ, ∃ τe : G (e + 1) ⟶ G e,
      (∀ n, τe ≫ χ e n = χ (e + 1) n ≫ Q.τF e n) ∧
      ∀ (V : Z.Opens) (hV : IsAffineOpen V),
        Function.Surjective (Scheme.Modules.Hom.app τe V) ∧
        (∀ s : Γ(G (e + 1), V), Scheme.Modules.Hom.app τe V s = 0 ↔
          s ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) •
            (⊤ : Submodule Γ(Z, V) Γ(G (e + 1), V))) ∧
        (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) • (⊤ : Submodule Γ(Z, V) Γ(G e, V)) = ⊥ := by
    intro e
    obtain ⟨Q', π', _, hQ'coh, hπsec, hπuniv⟩ := hQ (e + 1) (G (e + 1)) (hGalg (e + 1)).1
    have hkF : ∀ n, wcCnKilled (𝒥p (e + 1)) (Q.Fq e n) :=
      fun n => hkillOf _ _ (fun V hV => (Q.Fq_jadic n).2.2 e V hV)
    choose φ' hφ' using fun n => hπuniv (Q.Fq e n) (χ (e + 1) n ≫ Q.τF e n) (hkF n)
    have hQ'alg : wcCnAlg h (IsLocalRing.maximalIdeal B) (Q.Fq e) (Q.ψq e) Q' φ' := by
      refine wc_cn_alg_quot B _ Z h (𝒥p (e + 1)) (Q.Fq (e + 1)) (Q.Fq e) (Q.ψq (e + 1)) (Q.ψq e)
        (G (e + 1)) (χ (e + 1)) Q' π' (fun n => Q.τF e n) φ' (hGalg (e + 1)) hQ'coh hπsec ?_ ?_ hφ'
      · intro n V hV
        refine ⟨((Q.Fq_jadic n).2.1 e V hV).1, fun s => ?_⟩
        rw [h𝒥p (e + 1) V hV]
        exact ((Q.Fq_jadic n).2.1 e V hV).2 s
      · intro n
        exact Q.τF_ψ e n
    obtain ⟨u, v, hu, hv, huv, hvu⟩ :=
      hUI (Q.Fq e) (Q.ψq e) Q' (G e) φ' (χ e) (Q.Fq_adic e) hQ'alg (hGalg e)
    refine ⟨π' ≫ u, fun n => ?_, fun V hV => ?_⟩
    · rw [Category.assoc, hu, hφ']
    · have hvu' : ∀ y : Γ(G e, V),
          Scheme.Modules.Hom.app u V (Scheme.Modules.Hom.app v V y) = y := by
        intro y
        rw [hcomp v u (𝟙 _) hvu V y, Scheme.Modules.Hom.id_app]
        rfl
      have huv' : ∀ y : Γ(Q', V),
          Scheme.Modules.Hom.app v V (Scheme.Modules.Hom.app u V y) = y := by
        intro y
        rw [hcomp u v (𝟙 _) huv V y, Scheme.Modules.Hom.id_app]
        rfl
      have happ : ∀ x : Γ(G (e + 1), V), Scheme.Modules.Hom.app (π' ≫ u) V x =
          Scheme.Modules.Hom.app u V (Scheme.Modules.Hom.app π' V x) :=
        fun x => (hcomp π' u _ rfl V x).symm
      refine ⟨?_, ?_, ?_⟩
      · intro y
        obtain ⟨x, hx⟩ := (hπsec V hV).1 (Scheme.Modules.Hom.app v V y)
        exact ⟨x, by rw [happ, hx, hvu']⟩
      · intro s
        rw [happ, ← h𝒥p (e + 1) V hV, ← (hπsec V hV).2 s]
        constructor
        · intro h0
          rw [← huv' (Scheme.Modules.Hom.app π' V s), h0, map_zero]
        · intro h0
          rw [h0, map_zero]
      · rw [eq_bot_iff]
        intro y hy
        refine Submodule.smul_induction_on hy ?_ ?_
        · intro r hr n _
          obtain ⟨x, hx⟩ := (hπsec V hV).1 (Scheme.Modules.Hom.app v V n)
          have hn : n = Scheme.Modules.Hom.app u V (Scheme.Modules.Hom.app π' V x) := by
            rw [hx, hvu']
          have h0 : Scheme.Modules.Hom.app π' V (r • x) = 0 := by
            rw [(hπsec V hV).2, h𝒥p (e + 1) V hV]
            exact Submodule.smul_mem_smul hr Submodule.mem_top
          rw [hn, ← Scheme.Modules.Hom.app_smul, ← Scheme.Modules.Hom.app_smul, h0, map_zero]
          exact Submodule.zero_mem _
        · intro x y hx hy
          exact Submodule.add_mem _ hx hy
  choose τ hτχ hτsec using hτex

  choose H' q hqepi hH'coh hqsec hquniv using
    fun e => hQ (e + 1) H hHalg.1
  have hH'kill : ∀ e k, e + 1 ≤ k → wcCnKilled (𝒥p k) (H' e) := by
    intro e k hk V hV a ha y
    obtain ⟨x, rfl⟩ := (hqsec e V hV).1 y
    rw [← Scheme.Modules.Hom.app_smul, (hqsec e V hV).2, h𝒥p (e + 1) V hV]
    rw [h𝒥p k V hV] at ha
    exact Submodule.smul_mem_smul (Ideal.pow_le_pow_right hk ha) Submodule.mem_top
  have hH'van : ∀ e (V : Z.Opens) (hV : IsAffineOpen V), (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) •
      (⊤ : Submodule Γ(Z, V) Γ(H' e, V)) = ⊥ := by
    intro e V hV
    rw [eq_bot_iff]
    intro y hy
    refine Submodule.smul_induction_on hy (fun r hr n _ => ?_)
      (fun x y hx hy => Submodule.add_mem _ hx hy)
    rw [Submodule.mem_bot]
    exact hH'kill e (e + 1) le_rfl V hV r (by rw [h𝒥p (e + 1) V hV]; exact hr) n
  choose τH' hτH' using fun e => hquniv (e + 1) (H' e) (q e) (hH'kill e (e + 1 + 1) (by omega))
  choose χH hχH using fun e n => hquniv e (Q.Hq e n) (φH n ≫ Q.pH e n)
    (hkillOf _ _ (fun V hV => (Q.Hq_jadic n).2.2 e V hV))
  have hH'alg : ∀ e, wcCnAlg h (IsLocalRing.maximalIdeal B) (Q.Hq e) (Q.ψHq e) (H' e) (χH e) := by
    intro e
    refine wc_cn_alg_quot B _ Z h (𝒥p (e + 1)) Hs (Q.Hq e) ψH (Q.ψHq e) H φH (H' e) (q e)
      (fun n => Q.pH e n) (χH e) hHalg (hH'coh e) (hqsec e) ?_ ?_ (hχH e)
    · intro n V hV
      refine ⟨((Q.pH_jalg n).2.2 e V hV).1, fun s => ?_⟩
      rw [h𝒥p (e + 1) V hV]
      exact ((Q.pH_jalg n).2.2 e V hV).2 s
    · intro n
      exact Q.pH_ψ e n

  have hβex : ∀ e, ∃ βe : G e ⟶ H' e, ∀ n, βe ≫ χH e n = χ e n ≫ Q.αq e n := by
    intro e
    refine wc_cn_coh_hom_lift hFF B Z h (Q.Hq e) (Q.ψHq e) (H' e) (χH e) (Q.Hq_adic e) (hH'alg e)
      (G e) (hGalg e).1 (fun n => χ e n ≫ Q.αq e n) (fun n => ?_)
    rw [Category.assoc, Q.αq_ψ, ← Category.assoc, (hGalg e).2.1]
  choose β hβχ using hβex
  have hτHχ : ∀ e n, τH' e ≫ χH e n = χH (e + 1) n ≫ Q.τH e n := by
    intro e n
    have hp : Q.pH (e + 1) n ≫ Q.τH e n = Q.pH e n := (Q.pH_jalg n).2.1 e
    have e1 : q (e + 1) ≫ τH' e ≫ χH e n = φH n ≫ Q.pH e n := by
      rw [← Category.assoc, hτH', hχH]
    have e2 : q (e + 1) ≫ χH (e + 1) n ≫ Q.τH e n = φH n ≫ Q.pH e n := by
      rw [← Category.assoc, hχH, Category.assoc, hp]
    haveI : Epi (q (e + 1)) := hqepi (e + 1)
    exact (cancel_epi (q (e + 1))).mp (e1.trans e2.symm)
  have hβτ : ∀ e, β (e + 1) ≫ τH' e = τ e ≫ β e := by
    intro e
    refine wc_cn_alg_hom_unique B Z h (Q.Hq e) (Q.ψHq e) (H' e) (χH e) (hH'alg e) (G (e + 1))
      (hGalg (e + 1)).1 _ _ (fun n => ?_)
    calc (β (e + 1) ≫ τH' e) ≫ χH e n = β (e + 1) ≫ χH (e + 1) n ≫ Q.τH e n := by
          rw [Category.assoc, hτHχ]
      _ = χ (e + 1) n ≫ Q.αq (e + 1) n ≫ Q.τH e n := by
          rw [← Category.assoc, hβχ, Category.assoc]
      _ = χ (e + 1) n ≫ Q.τF e n ≫ Q.αq e n := by rw [Q.αq_τ]
      _ = (τ e ≫ χ e n) ≫ Q.αq e n := by rw [hτχ, Category.assoc]
      _ = (τ e ≫ β e) ≫ χH e n := by rw [Category.assoc, Category.assoc, hβχ]
  have hβalm : ∀ e, wcCnAlmostIso 𝒥 Q.c (β e) := fun e =>
    wc_cn_almost_of_levels B Z h 𝒥 Q.c (Q.Fq e) (Q.Hq e) (Q.ψq e) (Q.ψHq e) (G e) (H' e) (χ e)
      (χH e) (Q.αq e) (β e) (hGalg e) (hH'alg e) (hβχ e) (Q.αq_almost e)

  have hGj : wcCnJAdicSys 𝒥 G τ :=
    ⟨fun e => (hGalg e).1, fun e V hV => ⟨(hτsec e V hV).1, (hτsec e V hV).2.1⟩,
      fun e V hV => (hτsec e V hV).2.2⟩
  have hH'j : wcCnJAdicSys 𝒥 H' τH' := by
    refine ⟨hH'coh, fun e V hV => ⟨fun y => ?_, fun z => ?_⟩, hH'van⟩
    · obtain ⟨x, hx⟩ := (hqsec e V hV).1 y
      exact ⟨Scheme.Modules.Hom.app (q (e + 1)) V x, by rw [hcomp _ _ _ (hτH' e), hx]⟩
    · obtain ⟨y, rfl⟩ := (hqsec (e + 1) V hV).1 z
      rw [hcomp _ _ _ (hτH' e)]
      constructor
      · intro h0
        have hy := ((hqsec e V hV).2 y).mp h0
        rw [h𝒥p (e + 1) V hV] at hy
        exact hLIN (q (e + 1)) V _ y hy
      · intro hz
        have h1 := hLIN (τH' e) V _ _ hz
        rw [hcomp _ _ _ (hτH' e), hH'van e V hV] at h1
        exact (Submodule.mem_bot _).mp h1
  have hqj : wcCnJAlg 𝒥 H' τH' H q :=
    ⟨hHalg.1, hτH', fun e V hV => ⟨(hqsec e V hV).1, fun s => by
      rw [← h𝒥p (e + 1) V hV]; exact (hqsec e V hV).2 s⟩⟩
  exact ⟨⟨G, τ, χ, H', τH', q, χH, β, Q.c, hGj, hGalg, hτχ, hH'j, hqj, hχH, hβτ, hβχ, hβalm⟩⟩

theorem wc_cn_modules_seqlim_sections : ∀ (Z : Scheme.{u}) (D : ℕᵒᵖ ⥤ Z.Modules) (V : Z.Opens), (∀ x y : Γ(Limits.limit D, V), (∀ e : ℕ, Scheme.Modules.Hom.app (Limits.limit.π D (Opposite.op e)) V x = Scheme.Modules.Hom.app (Limits.limit.π D (Opposite.op e)) V y) → x = y) ∧ ∀ g : ∀ e : ℕ, Γ(D.obj (Opposite.op e), V), (∀ e : ℕ, Scheme.Modules.Hom.app (D.map (homOfLE (Nat.le_succ e)).op) V (g (e + 1)) = g e) → ∃ x : Γ(Limits.limit D, V), ∀ e : ℕ, Scheme.Modules.Hom.app (Limits.limit.π D (Opposite.op e)) V x = g e :=
by
  intro Z D V
  let E : Z.Modules ⥤ Type u :=
    SheafOfModules.evaluation Z.ringCatSheaf (Opposite.op V) ⋙ forget _
  have hpres : Limits.PreservesLimitsOfShape ℕᵒᵖ E :=
    inferInstanceAs (Limits.PreservesLimitsOfShape ℕᵒᵖ
      (SheafOfModules.evaluation Z.ringCatSheaf (Opposite.op V) ⋙ forget _))
  have hc := Limits.isLimitOfPreserves E (Limits.limit.isLimit D)
  let Φ := Limits.Types.isLimitEquivSections hc
  have hK : ∀ (x : Γ(Limits.limit D, V)) (e : ℕ),
      (Φ x).1 (Opposite.op e) = Scheme.Modules.Hom.app (Limits.limit.π D (Opposite.op e)) V x := by
    intro x e
    exact Limits.Types.isLimitEquivSections_apply hc (Opposite.op e) x
  have hC : ∀ g : ∀ e : ℕ, Γ(D.obj (Opposite.op e), V),
      (∀ e : ℕ, Scheme.Modules.Hom.app (D.map (homOfLE (Nat.le_succ e)).op) V (g (e + 1)) = g e) →
      ∀ n m (h : n ≤ m), Scheme.Modules.Hom.app (D.map (homOfLE h).op) V (g m) = g n := by
    intro g hg n m h
    induction m, h using Nat.le_induction with
    | base =>
      have e : (homOfLE (le_refl n)).op = 𝟙 (Opposite.op n) := Subsingleton.elim _ _
      rw [e, D.map_id, Scheme.Modules.Hom.id_app]
      rfl
    | succ k hk ih =>
      have e : (homOfLE (le_trans hk (Nat.le_succ k))).op =
          (homOfLE (Nat.le_succ k)).op ≫ (homOfLE hk).op := Subsingleton.elim _ _
      rw [e, D.map_comp, Scheme.Modules.Hom.comp_app]
      change Scheme.Modules.Hom.app (D.map (homOfLE hk).op) V
        (Scheme.Modules.Hom.app (D.map (homOfLE (Nat.le_succ k)).op) V (g (k + 1))) = g n
      rw [hg k, ih]
  refine ⟨fun x y h => Φ.injective (Subtype.ext (funext fun j => ?_)), fun g hg => ?_⟩
  · cases j with
    | op e =>
      rw [hK, hK]
      exact h e
  · let s : ∀ j : ℕᵒᵖ, (D ⋙ E).obj j := fun j => g j.unop
    have hs : s ∈ (D ⋙ E).sections := by
      intro j j' f
      cases j with
      | op m =>
        cases j' with
        | op n =>
          have h : n ≤ m := leOfHom f.unop
          have ef : f = (homOfLE h).op := Subsingleton.elim _ _
          rw [ef]
          exact hC g hg n m h
    refine ⟨Φ.symm ⟨s, hs⟩, fun e => ?_⟩
    exact Limits.Types.isLimitEquivSections_symm_apply hc ⟨s, hs⟩ (Opposite.op e)

theorem wc_cn_modules_pullback_sections : ∀ (Z : Scheme.{u}) (X Y W : Z.Modules) (f : X ⟶ W) (g : Y ⟶ W) (V : Z.Opens), (∀ s t : Γ(Limits.pullback f g, V), Scheme.Modules.Hom.app (Limits.pullback.fst f g) V s = Scheme.Modules.Hom.app (Limits.pullback.fst f g) V t → Scheme.Modules.Hom.app (Limits.pullback.snd f g) V s = Scheme.Modules.Hom.app (Limits.pullback.snd f g) V t → s = t) ∧ ∀ (x : Γ(X, V)) (y : Γ(Y, V)), Scheme.Modules.Hom.app f V x = Scheme.Modules.Hom.app g V y → ∃ w : Γ(Limits.pullback f g, V), Scheme.Modules.Hom.app (Limits.pullback.fst f g) V w = x ∧ Scheme.Modules.Hom.app (Limits.pullback.snd f g) V w = y :=
by
  intro Z X Y W f g V
  have hc := Limits.isLimitPullbackConeMapOfIsLimit
    (SheafOfModules.evaluation Z.ringCatSheaf (Opposite.op V) ⋙ forget _)
    Limits.pullback.condition (Limits.pullbackIsPullback f g)
  refine ⟨fun s t h1 h2 => Limits.PullbackCone.IsLimit.type_ext hc h1 h2, fun x y h => ?_⟩
  exact ⟨(Limits.PullbackCone.IsLimit.equivPullbackObj hc).symm ⟨(x, y), h⟩,
    Limits.PullbackCone.IsLimit.equivPullbackObj_symm_apply_fst hc ⟨(x, y), h⟩,
    Limits.PullbackCone.IsLimit.equivPullbackObj_symm_apply_snd hc ⟨(x, y), h⟩⟩

theorem wc_cn_jadic_fibre_sections : ∀ (Z : Scheme.{u}) (G : ℕ → Z.Modules) (τ : ∀ e, G (e + 1) ⟶ G e) (H : Z.Modules) (H' : ℕ → Z.Modules) (τH' : ∀ e, H' (e + 1) ⟶ H' e) (q : ∀ e, H ⟶ H' e) (β : ∀ e, G e ⟶ H' e), (∀ e, q (e + 1) ≫ τH' e = q e) → (∀ e, β (e + 1) ≫ τH' e = τ e ≫ β e) → ∃ (F : Z.Modules) (a : F ⟶ H) (φF : ∀ e, F ⟶ G e), (∀ e, φF (e + 1) ≫ τ e = φF e) ∧ (∀ e, φF e ≫ β e = a ≫ q e) ∧ ∀ V : Z.Opens, (∀ s : Γ(F, V), Scheme.Modules.Hom.app a V s = 0 → (∀ e, Scheme.Modules.Hom.app (φF e) V s = 0) → s = 0) ∧ ∀ (n : Γ(H, V)) (g : ∀ e, Γ(G e, V)), (∀ e, Scheme.Modules.Hom.app (τ e) V (g (e + 1)) = g e) → (∀ e, Scheme.Modules.Hom.app (β e) V (g e) = Scheme.Modules.Hom.app (q e) V n) → ∃ s : Γ(F, V), Scheme.Modules.Hom.app a V s = n ∧ ∀ e, Scheme.Modules.Hom.app (φF e) V s = g e :=
by
  intro Z G τ H H' τH' q β hq hβ
  have capp : ∀ {M N P : Z.Modules} (f : M ⟶ N) (g : N ⟶ P) (U : Z.Opens) (x : Γ(M, U)),
      Scheme.Modules.Hom.app (f ≫ g) U x =
        Scheme.Modules.Hom.app g U (Scheme.Modules.Hom.app f U x) := by
    intro M N P f g U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have hτG : ∀ e, (Functor.ofOpSequence τ).map (homOfLE (Nat.le_succ e)).op = τ e :=
    fun e => Functor.ofOpSequence_map_homOfLE_succ τ e
  have hτH : ∀ e, (Functor.ofOpSequence τH').map (homOfLE (Nat.le_succ e)).op = τH' e :=
    fun e => Functor.ofOpSequence_map_homOfLE_succ τH' e

  obtain ⟨lam, hlam⟩ : ∃ lam : H ⟶ Limits.limit (Functor.ofOpSequence τH'),
      ∀ e : ℕ, lam ≫ Limits.limit.π (Functor.ofOpSequence τH') (Opposite.op e) = q e := by
    let cH : Limits.Cone (Functor.ofOpSequence τH') :=
      ⟨H, NatTrans.ofOpSequence (F := (Functor.const ℕᵒᵖ).obj H) (G := Functor.ofOpSequence τH')
        (fun e => q e) (fun e =>
          (Category.id_comp (q e)).trans ((hq e).symm.trans (congrArg (q (e + 1) ≫ ·) (hτH e).symm)))⟩
    refine ⟨Limits.limit.lift _ cH, fun e => ?_⟩
    rw [Limits.limit.lift_π]
    rfl

  obtain ⟨mu, hmu⟩ : ∃ mu : Limits.limit (Functor.ofOpSequence τ) ⟶
      Limits.limit (Functor.ofOpSequence τH'),
      ∀ e : ℕ, mu ≫ Limits.limit.π (Functor.ofOpSequence τH') (Opposite.op e) =
        Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e) ≫ β e := by
    refine ⟨Limits.limMap (NatTrans.ofOpSequence (F := Functor.ofOpSequence τ)
      (G := Functor.ofOpSequence τH') (fun e => β e) (fun e =>
        (congrArg (· ≫ β e) (hτG e)).trans ((hβ e).symm.trans
          (congrArg (β (e + 1) ≫ ·) (hτH e).symm)))), fun e => ?_⟩
    rw [Limits.limMap_π]
    rfl

  refine ⟨Limits.pullback lam mu, Limits.pullback.fst lam mu,
    fun e => Limits.pullback.snd lam mu ≫ Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e),
    fun e => ?_, fun e => ?_, fun V => ?_⟩
  ·
    have hw : Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op (e + 1)) ≫ τ e =
        Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e) :=
      (congrArg (Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op (e + 1)) ≫ ·) (hτG e).symm).trans
        (Limits.limit.w (Functor.ofOpSequence τ) (homOfLE (Nat.le_succ e)).op)
    show (Limits.pullback.snd lam mu ≫ Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op (e + 1)))
        ≫ τ e = Limits.pullback.snd lam mu ≫ Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e)
    exact (Category.assoc _ _ _).trans (congrArg (Limits.pullback.snd lam mu ≫ ·) hw)
  ·
    show (Limits.pullback.snd lam mu ≫ Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e))
        ≫ β e = Limits.pullback.fst lam mu ≫ q e
    exact ((Category.assoc _ _ _).trans (congrArg (Limits.pullback.snd lam mu ≫ ·) (hmu e).symm)).trans
      ((Category.assoc _ _ _).symm.trans
        ((congrArg (· ≫ Limits.limit.π (Functor.ofOpSequence τH') (Opposite.op e))
          Limits.pullback.condition.symm).trans
          ((Category.assoc _ _ _).trans (congrArg (Limits.pullback.fst lam mu ≫ ·) (hlam e)))))
  ·
    obtain ⟨injG, exG⟩ := wc_cn_modules_seqlim_sections Z (Functor.ofOpSequence τ) V
    obtain ⟨injH, -⟩ := wc_cn_modules_seqlim_sections Z (Functor.ofOpSequence τH') V
    obtain ⟨injP, exP⟩ := wc_cn_modules_pullback_sections Z H _ _ lam mu V
    refine ⟨fun s hs0 hφ => ?_, fun n g hg hgq => ?_⟩
    · refine injP s 0 (hs0.trans (map_zero _).symm) ?_
      refine (injG (Scheme.Modules.Hom.app (Limits.pullback.snd lam mu) V s) 0
        (fun e => ?_)).trans (map_zero _).symm
      exact ((capp (Limits.pullback.snd lam mu)
        (Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e)) V s).symm.trans (hφ e)).trans
          (map_zero _).symm
    · obtain ⟨w, hw⟩ := exG g (fun e =>
        (congrArg (fun φ => Scheme.Modules.Hom.app φ V (g (e + 1))) (hτG e)).trans (hg e))
      have e1 : ∀ e, Scheme.Modules.Hom.app
          (Limits.limit.π (Functor.ofOpSequence τH') (Opposite.op e)) V
            (Scheme.Modules.Hom.app lam V n) = Scheme.Modules.Hom.app (q e) V n := fun e =>
        (capp lam (Limits.limit.π (Functor.ofOpSequence τH') (Opposite.op e)) V n).symm.trans
          (congrArg (fun φ => Scheme.Modules.Hom.app φ V n) (hlam e))
      have e2 : ∀ e, Scheme.Modules.Hom.app
          (Limits.limit.π (Functor.ofOpSequence τH') (Opposite.op e)) V
            (Scheme.Modules.Hom.app mu V w) = Scheme.Modules.Hom.app (q e) V n := fun e =>
        ((capp mu (Limits.limit.π (Functor.ofOpSequence τH') (Opposite.op e)) V w).symm.trans
          (congrArg (fun φ => Scheme.Modules.Hom.app φ V w) (hmu e))).trans
          ((capp (Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e)) (β e) V w).trans
            ((congrArg (fun x => Scheme.Modules.Hom.app (β e) V x) (hw e)).trans (hgq e)))
      have hlm : Scheme.Modules.Hom.app lam V n = Scheme.Modules.Hom.app mu V w :=
        injH _ _ (fun e => (e1 e).trans (e2 e).symm)
      obtain ⟨s, hs1, hs2⟩ := exP n w hlm
      refine ⟨s, hs1, fun e => ?_⟩
      exact (capp (Limits.pullback.snd lam mu)
        (Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e)) V s).trans
          ((congrArg (fun x => Scheme.Modules.Hom.app
            (Limits.limit.π (Functor.ofOpSequence τ) (Opposite.op e)) V x) hs2).trans (hw e))

theorem wc_cn_jadic_fibre_core : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (J : Ideal A) (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N] (Nq M : ℕ → Type u) [∀ e, AddCommGroup (Nq e)] [∀ e, Module A (Nq e)] [∀ e, AddCommGroup (M e)] [∀ e, Module A (M e)] [∀ e, Module.Finite A (M e)] (q : ∀ e, N →ₗ[A] Nq e) (τN : ∀ e, Nq (e + 1) →ₗ[A] Nq e) (π : ∀ e, M (e + 1) →ₗ[A] M e) (β : ∀ e, M e →ₗ[A] Nq e) (c : ℕ), (∀ e, Function.Surjective (q e)) → (∀ e n, q e n = 0 ↔ n ∈ J ^ (e + 1) • (⊤ : Submodule A N)) → (∀ e n, τN e (q (e + 1) n) = q e n) → (∀ e, Function.Surjective (π e)) → (∀ e x, π e x = 0 ↔ x ∈ J ^ (e + 1) • (⊤ : Submodule A (M (e + 1)))) → (∀ e, J ^ (e + 1) • (⊤ : Submodule A (M e)) = ⊥) → (∀ e x, τN e (β (e + 1) x) = β e (π e x)) → (∀ e x, β e x = 0 → ∀ a ∈ J ^ c, a • x = 0) → (∀ e y, ∀ a ∈ J ^ c, ∃ x, β e x = a • y) → (∀ e (m : M e), ∃ (n : N) (g : ∀ k, M k), (∀ k, π k (g (k + 1)) = g k) ∧ (∀ k, β k (g k) = q k n) ∧ g e = m) ∧ (∀ e (n : N) (g : ∀ k, M k), (∀ k, π k (g (k + 1)) = g k) → (∀ k, β k (g k) = q k n) → g e = 0 → ∃ (s : ℕ) (b : Fin s → A) (n' : Fin s → N) (g' : Fin s → ∀ k, M k), (∀ i, b i ∈ J ^ (e + 1)) ∧ (∀ i k, π k (g' i (k + 1)) = g' i k) ∧ (∀ i k, β k (g' i k) = q k (n' i)) ∧ n = ∑ i, b i • n' i ∧ ∀ k, g k = ∑ i, b i • g' i k) ∧ (∃ (s : ℕ) (n0 : Fin s → N) (g0 : Fin s → ∀ k, M k), (∀ i k, π k (g0 i (k + 1)) = g0 i k) ∧ (∀ i k, β k (g0 i k) = q k (n0 i)) ∧ ∀ (n : N) (g : ∀ k, M k), (∀ k, π k (g (k + 1)) = g k) → (∀ k, β k (g k) = q k n) → ∃ b : Fin s → A, n = ∑ i, b i • n0 i ∧ ∀ k, g k = ∑ i, b i • g0 i k) ∧ (∀ (n : N), ∀ a ∈ J ^ (2 * c), ∃ g : ∀ k, M k, (∀ k, π k (g (k + 1)) = g k) ∧ ∀ k, β k (g k) = q k (a • n)) ∧ (∃ k1 : ℕ, ∀ g : ∀ k, M k, (∀ k, π k (g (k + 1)) = g k) → (∀ k, β k (g k) = 0) → g k1 = 0 → ∀ k, g k = 0) :=
by

  have jfc_ef2 : ∀ (A : Type u) [CommRing A] (X : Type u) [AddCommGroup X] [Module A X] (t : ℕ)
      (j : Fin t → A) (N' : Submodule A X) (x : X), x ∈ Submodule.span A (Set.range j) • N' →
      ∃ n : Fin t → X, (∀ l, n l ∈ N') ∧ x = ∑ l, j l • n l := by
    intro A _ X _ _ t j N' x hx
    refine Submodule.smul_induction_on
      (p := fun x => ∃ n : Fin t → X, (∀ l, n l ∈ N') ∧ x = ∑ l, j l • n l) hx ?_ ?_
    · intro r hr m hm
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hr
      refine ⟨fun l => c l • m, fun l => N'.smul_mem _ hm, ?_⟩
      rw [← hc, Finset.sum_smul]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [smul_smul, smul_eq_mul, mul_comm]
    · rintro x y ⟨n, hn, rfl⟩ ⟨n', hn', rfl⟩
      refine ⟨fun l => n l + n' l, fun l => N'.add_mem (hn l) (hn' l), ?_⟩
      simp only [smul_add, Finset.sum_add_distrib]

  have jfc_t2 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (J : Ideal A) (X : ℕ → Type u)
      [∀ k, AddCommGroup (X k)] [∀ k, Module A (X k)] (p : ∀ k, X (k+1) →ₗ[A] X k) (s : ℕ)
      (ρ : ∀ k, (Fin s → A) →ₗ[A] X k) (L : Submodule A (∀ k, X k)),
      (∀ g, g ∈ L ↔ ∀ k, p k (g (k+1)) = g k) →
      (∀ k v, p k (ρ (k+1) v) = ρ k v) →
      (∀ k, J ^ (k + 1) • (⊤ : Submodule A (Fin s → A)) ≤ LinearMap.ker (ρ k)) →
      (∀ k (x : X (k + 1)), p k x = 0 →
        ∃ w ∈ J ^ (k + 1) • (⊤ : Submodule A (Fin s → A)), ρ (k + 1) w = x) →
      ∀ e g, g ∈ L → g e = 0 → g ∈ J ^ (e+1) • L := by
    intro A _ _ J X _ _ p s ρ L hL hρc hA hB e g hgL hge
    have hg := (hL g).mp hgL
    have hw : ∀ k (x : X (k+1)), ∃ w : Fin s → A, p k x = 0 →
        (w ∈ J ^ (k + 1) • (⊤ : Submodule A (Fin s → A)) ∧ ρ (k + 1) w = x) := by
      intro k x
      by_cases h : p k x = 0
      · obtain ⟨w, hw1, hw2⟩ := hB k x h
        exact ⟨w, fun _ => ⟨hw1, hw2⟩⟩
      · exact ⟨0, fun h' => absurd h' h⟩
    choose wf hwf using hw
    obtain ⟨u, hu0, husucc⟩ : ∃ u : ℕ → (Fin s → A), u 0 = 0 ∧
        ∀ i, u (i+1) = u i + wf (e + i) (g (e + i + 1) - ρ (e + i + 1) (u i)) :=
      ⟨fun i => Nat.rec (motive := fun _ => Fin s → A) 0
        (fun i ui => ui + wf (e + i) (g (e + i + 1) - ρ (e + i + 1) ui)) i, rfl, fun i => rfl⟩
    have hu : ∀ i, ρ (e + i) (u i) = g (e + i) := by
      intro i
      induction i with
      | zero => show ρ e (u 0) = g e; rw [hu0, map_zero, hge]
      | succ i ih =>
        have h0 : p (e + i) (g (e + i + 1) - ρ (e + i + 1) (u i)) = 0 := by
          rw [map_sub, hρc, hg, ih, sub_self]
        have := (hwf (e+i) _ h0).2
        show ρ (e + i + 1) (u (i+1)) = g (e + i + 1)
        rw [husucc, map_add, this]; abel
    have hp0 : ∀ i, p (e + i) (g (e + i + 1) - ρ (e + i + 1) (u i)) = 0 := by
      intro i; rw [map_sub, hρc, hg, hu, sub_self]
    obtain ⟨t, j, hj⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
      (IsNoetherian.noetherian (J ^ (e+1)))
    have hfac : ∀ i, ∃ ε : Fin t → (Fin s → A),
        (∀ l, ε l ∈ J ^ i • (⊤ : Submodule A (Fin s → A))) ∧
        wf (e + i) (g (e + i + 1) - ρ (e + i + 1) (u i)) = ∑ l, j l • ε l := by
      intro i
      apply jfc_ef2
      rw [hj, ← Submodule.mul_smul, ← pow_add, show e + 1 + i = e + i + 1 by omega]
      exact (hwf _ _ (hp0 i)).1
    choose ε hε hεsum using hfac
    have hsum : ∀ n, ∑ i ∈ Finset.range n, ∑ l, j l • ε i l = u n := by
      intro n
      induction n with
      | zero => rw [Finset.sum_range_zero, hu0]
      | succ n ih => rw [Finset.sum_range_succ, ih, ← hεsum, husucc]
    have hdesc : ∀ d k v, ρ (k + d) v = g (k + d) → ρ k v = g k := by
      intro d
      induction d with
      | zero => intro k v h; exact h
      | succ d ih =>
        intro k v h
        apply ih
        have h' : ρ (k + d + 1) v = g (k + d + 1) := h
        rw [← hρc, h', hg]
    obtain ⟨hf, hhf⟩ : ∃ hf : Fin t → ∀ k, X k,
        ∀ l k, hf l k = ρ k (∑ i ∈ Finset.range (k+1), ε i l) := ⟨_, fun _ _ => rfl⟩
    have hhc : ∀ l, hf l ∈ L := by
      intro l; rw [hL]; intro k
      rw [hhf, hhf, hρc, Finset.sum_range_succ _ (k+1), map_add,
        LinearMap.mem_ker.mp (hA k (hε (k+1) l)), add_zero]
    have hrec : g = ∑ l, j l • hf l := by
      funext k
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, hhf]
      simp_rw [← map_smul, ← map_sum, Finset.smul_sum]
      rw [Finset.sum_comm, hsum]
      exact (hdesc (e+1) k _ (by rw [show k + (e+1) = e + (k+1) by omega]; exact hu (k+1))).symm
    rw [hrec]
    exact Submodule.sum_mem _ (fun l _ => Submodule.smul_mem_smul
      (by rw [← hj]; exact Submodule.subset_span ⟨l, rfl⟩) (hhc l))

  have jfc_t1 : ∀ (A : Type u) [CommRing A] (J : Ideal A) (Nq M : ℕ → Type u)
      [∀ e, AddCommGroup (Nq e)] [∀ e, Module A (Nq e)] [∀ e, AddCommGroup (M e)]
      [∀ e, Module A (M e)] (τN : ∀ e, Nq (e + 1) →ₗ[A] Nq e) (π : ∀ e, M (e + 1) →ₗ[A] M e)
      (β : ∀ e, M e →ₗ[A] Nq e) (c : ℕ),
      (∀ e x, τN e (β (e + 1) x) = β e (π e x)) →
      (∀ e x, β e x = 0 → ∀ a ∈ J ^ c, a • x = 0) →
      (∀ e y, ∀ a ∈ J ^ c, ∃ x, β e x = a • y) →
      ∀ (Lc : Submodule A (∀ k, M k)) (LcN : Submodule A (∀ k, Nq k)),
      (∀ g, g ∈ Lc ↔ ∀ k, π k (g (k+1)) = g k) →
      (∀ y, y ∈ LcN ↔ ∀ k, τN k (y (k+1)) = y k) →
      ∀ (bP : (∀ k, M k) →ₗ[A] (∀ k, Nq k)), (∀ x k, bP x k = β k (x k)) →
      ∀ d, J ^ (d + 2 * c) • LcN ≤ Submodule.map bP (J ^ d • Lc) := by
    intro A _ J Nq M _ _ _ _ τN π β c hβτ hβker hβcok Lc LcN hLc hLcN bP hbP
    have core : J ^ (2 * c) • LcN ≤ Submodule.map bP Lc := by
      rw [Submodule.smul_le]
      intro a ha y hy
      rw [hLcN] at hy
      rw [two_mul, pow_add] at ha
      refine Submodule.mul_induction_on (C := fun a => a • y ∈ Submodule.map bP Lc) ha ?_ ?_
      · intro a1 ha1 a2 ha2
        choose x hx using fun k => hβcok k (y k) a2 ha2
        refine ⟨a1 • x, ?_, ?_⟩
        · rw [SetLike.mem_coe, hLc]; intro k
          have h0 : β k (π k (x (k+1)) - x k) = 0 := by
            rw [map_sub, ← hβτ, hx, hx, map_smul, hy, sub_self]
          have := hβker k _ h0 a1 ha1
          rw [smul_sub, sub_eq_zero] at this
          simp only [Pi.smul_apply, map_smul, this]
        · funext k
          simp only [hbP, Pi.smul_apply, map_smul, hx, smul_smul]
      · intro a b ha hb; rw [add_smul]; exact Submodule.add_mem _ ha hb
    intro d
    calc J ^ (d + 2 * c) • LcN = J ^ d • (J ^ (2 * c) • LcN) := by
          rw [pow_add, Submodule.mul_smul]
      _ ≤ J ^ d • Submodule.map bP Lc := Submodule.smul_mono le_rfl core
      _ = Submodule.map bP (J ^ d • Lc) := (Submodule.map_smul'' _ _ _).symm

  have jfc_uniform : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (J : Ideal A)
      (M : ℕ → Type u) [∀ k, AddCommGroup (M k)] [∀ k, Module A (M k)]
      (π : ∀ k, M (k + 1) →ₗ[A] M k) (s : ℕ) (ρ : ∀ k, (Fin s → A) →ₗ[A] M k)
      (S : ∀ k, Submodule A (M k)) (c : ℕ),
      (∀ k, Function.Surjective (ρ k)) → (∀ k v, π k (ρ (k + 1) v) = ρ k v) →
      (∀ k (x : M (k + 1)), π k x = 0 → x ∈ J ^ (k + 1) • (⊤ : Submodule A (M (k + 1)))) →
      (∀ k, J ^ (k + 1) • (⊤ : Submodule A (M k)) = ⊥) →
      (∀ k, ∀ a ∈ J ^ c, ∀ x ∈ S k, a • x = 0) →
      ∃ k1 : ℕ, ∀ g : ∀ k, M k, (∀ k, π k (g (k + 1)) = g k) → (∀ k, g k ∈ S k) →
        g k1 = 0 → ∀ k, g k = 0 := by
    intro A _ _ J M _ _ π s ρ S c hρ hρc hker hkill hS
    have hmap : ∀ n m, J ^ m • (⊤ : Submodule A (M n)) =
        Submodule.map (ρ n) (J ^ m • (⊤ : Submodule A (Fin s → A))) := by
      intro n m
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr (hρ n)]
    have hρmem : ∀ n m (w : Fin s → A), w ∈ J ^ m • (⊤ : Submodule A (Fin s → A)) →
        ρ n w ∈ J ^ m • (⊤ : Submodule A (M n)) := by
      intro n m w hw
      rw [hmap]; exact Submodule.mem_map_of_mem hw
    have hkill' : ∀ n m (x : M n), n + 1 ≤ m → x ∈ J ^ m • (⊤ : Submodule A (M n)) → x = 0 := by
      intro n m x hm hx
      have : x ∈ J ^ (n + 1) • (⊤ : Submodule A (M n)) :=
        Submodule.smul_mono_left (Ideal.pow_le_pow_right hm) hx
      rwa [hkill, Submodule.mem_bot] at this
    have hi : ∀ (g : ∀ k, M k) (n : ℕ), (∀ k, π k (g (k + 1)) = g k) → (∀ k < n, g k = 0) →
        g n ∈ J ^ n • (⊤ : Submodule A (M n)) := by
      intro g n hg hlt
      cases n with
      | zero => rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]; trivial
      | succ m => exact hker m _ (by rw [hg m]; exact hlt m (Nat.lt_succ_self m))
    have hK : ∀ (h : ∀ k, M k) (m : ℕ), (∀ k, π k (h (k + 1)) = h k) → h m = 0 →
        ∀ d, h (m + d) ∈ J ^ (m + 1) • (⊤ : Submodule A (M (m + d))) := by
      intro h m hh hm d
      induction d with
      | zero => rw [Nat.add_zero, hm]; exact Submodule.zero_mem _
      | succ d ih =>
        rw [hmap, Submodule.mem_map] at ih
        obtain ⟨w, hw, hwe⟩ := ih
        have h0 : π (m + d) (h (m + d + 1) - ρ (m + d + 1) w) = 0 := by
          rw [map_sub, hρc, hh, hwe, sub_self]
        have h1 := hker _ _ h0
        have h2 : h (m + d + 1) = (h (m + d + 1) - ρ (m + d + 1) w) + ρ (m + d + 1) w := by abel
        show h (m + d + 1) ∈ _
        rw [h2]
        exact Submodule.add_mem _
          (Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega)) h1) (hρmem _ _ w hw)
    let W : ∀ n, Submodule A (M n) := fun n =>
      { carrier := {x | ∃ g : ∀ k, M k, (∀ k, π k (g (k + 1)) = g k) ∧ (∀ k, g k ∈ S k) ∧
          (∀ k < n, g k = 0) ∧ g n = x}
        add_mem' := by
          rintro x y ⟨g, hg1, hg2, hg3, rfl⟩ ⟨g', hg1', hg2', hg3', rfl⟩
          refine ⟨g + g', fun k => ?_, fun k => (S k).add_mem (hg2 k) (hg2' k),
            fun k hk => ?_, rfl⟩
          · simp only [Pi.add_apply, map_add, hg1, hg1']
          · simp only [Pi.add_apply, hg3 k hk, hg3' k hk, add_zero]
        zero_mem' := ⟨0, fun k => by simp, fun k => (S k).zero_mem, fun k _ => rfl, rfl⟩
        smul_mem' := by
          rintro a x ⟨g, hg1, hg2, hg3, rfl⟩
          refine ⟨a • g, fun k => ?_, fun k => (S k).smul_mem a (hg2 k), fun k hk => ?_, rfl⟩
          · simp only [Pi.smul_apply, map_smul, hg1]
          · simp only [Pi.smul_apply, hg3 k hk, smul_zero] }
    have hWmem : ∀ n x, x ∈ W n ↔ ∃ g : ∀ k, M k, (∀ k, π k (g (k + 1)) = g k) ∧
        (∀ k, g k ∈ S k) ∧ (∀ k < n, g k = 0) ∧ g n = x := fun n x => Iff.rfl
    have hpow : ∀ (n : ℕ) (X : Type u) [AddCommGroup X] [Module A X],
        J • (J ^ n • (⊤ : Submodule A X)) = J ^ (n + 1) • (⊤ : Submodule A X) := by
      intro n X _ _
      rw [← Submodule.mul_smul, pow_succ']
    let F : J.Filtration (Fin s → A) :=
      { N := fun n => J ^ n • (⊤ : Submodule A (Fin s → A)) ⊓ Submodule.comap (ρ n) (W n)
        mono := by
          intro n v hv
          obtain ⟨hv1, hv2⟩ := Submodule.mem_inf.mp hv
          rw [Submodule.mem_comap, hWmem] at hv2
          obtain ⟨g, hg1, hg2, hg3, hg4⟩ := hv2
          refine Submodule.mem_inf.mpr ⟨Submodule.smul_mono_left
            (Ideal.pow_le_pow_right (Nat.le_succ n)) hv1, ?_⟩
          rw [Submodule.mem_comap, hWmem]
          refine ⟨g, hg1, hg2, fun k hk => hg3 k (by omega), ?_⟩
          rw [← hg1, hg4, hρc]
        smul_le := by
          intro n
          rw [Submodule.smul_le]
          intro a ha v hv
          obtain ⟨hv1, hv2⟩ := Submodule.mem_inf.mp hv
          rw [Submodule.mem_comap, hWmem] at hv2
          obtain ⟨g, hg1, hg2, hg3, hg4⟩ := hv2
          refine Submodule.mem_inf.mpr ⟨?_, ?_⟩
          · rw [← hpow]; exact Submodule.smul_mem_smul ha hv1
          · rw [Submodule.mem_comap, hWmem]
            refine ⟨a • g, fun k => ?_, fun k => (S k).smul_mem a (hg2 k), fun k hk => ?_, ?_⟩
            · simp only [Pi.smul_apply, map_smul, hg1]
            · rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | hk
              · simp only [Pi.smul_apply, hg3 k hk, smul_zero]
              · subst hk
                apply hkill' k (k + 1) _ le_rfl
                rw [← hpow]
                exact Submodule.smul_mem_smul ha (hi g k hg1 hg3)
            · have h0 : π n (ρ (n + 1) v - g (n + 1)) = 0 := by
                rw [map_sub, hρc, hg1, hg4, sub_self]
              have h1 := hker n _ h0
              have h2 : a • (ρ (n + 1) v - g (n + 1)) = 0 := by
                apply hkill' (n + 1) (n + 1 + 1) _ le_rfl
                rw [← hpow]
                exact Submodule.smul_mem_smul ha h1
              rw [smul_sub, sub_eq_zero] at h2
              simp only [Pi.smul_apply, map_smul, h2] }
    have hFle : F ≤ J.stableFiltration ⊤ := fun k => by
      show J ^ k • (⊤ : Submodule A (Fin s → A)) ⊓ Submodule.comap (ρ k) (W k) ≤
        (J.stableFiltration ⊤).N k
      rw [Ideal.stableFiltration_N]
      exact inf_le_left
    have hFst : F.Stable := (Ideal.stableFiltration_stable J ⊤).of_le hFle
    obtain ⟨n0, hn0⟩ := hFst.exists_pow_smul_eq_of_ge
    have hkey : ∀ d, c ≤ d → ∀ v ∈ F.N (n0 + d), ρ (n0 + d) v = 0 := by
      intro d hcd v hv
      rw [hn0 (n0 + d) (by omega), Nat.add_sub_cancel_left] at hv
      have hle : J ^ d • F.N n0 ≤ LinearMap.ker (ρ (n0 + d)) := by
        rw [Submodule.smul_le]
        intro a ha w hw
        obtain ⟨_, hw2⟩ := Submodule.mem_inf.mp hw
        rw [Submodule.mem_comap, hWmem] at hw2
        obtain ⟨g, hg1, hg2, _, hg4⟩ := hw2
        have hh := hK (fun k => ρ k w - g k) n0
          (fun k => by simp only [map_sub, hρc, hg1]) (by simp only [hg4, sub_self]) d
        have hsplit : ρ (n0 + d) (a • w) =
            a • (ρ (n0 + d) w - g (n0 + d)) + a • g (n0 + d) := by
          rw [map_smul, ← smul_add, sub_add_cancel]
        rw [LinearMap.mem_ker, hsplit, hS _ a (Ideal.pow_le_pow_right hcd ha) _ (hg2 _), add_zero]
        apply hkill' (n0 + d) (d + (n0 + 1)) _ (by omega)
        rw [pow_add, Submodule.mul_smul]
        exact Submodule.smul_mem_smul ha hh
      exact hle hv
    refine ⟨n0 + c, fun g hg1 hg2 hgk => ?_⟩
    have hdesc : ∀ d k, g (k + d) = 0 → g k = 0 := by
      intro d
      induction d with
      | zero => intro k h; exact h
      | succ d ih =>
        intro k h
        apply ih
        have h' : g (k + d + 1) = 0 := h
        rw [← hg1, h', map_zero]
    have hlow : ∀ k ≤ n0 + c, g k = 0 := by
      intro k hk
      exact hdesc (n0 + c - k) k (by rw [show k + (n0 + c - k) = n0 + c by omega]; exact hgk)
    have hall : ∀ m, ∀ k ≤ n0 + c + m, g k = 0 := by
      intro m
      induction m with
      | zero => exact hlow
      | succ m ih =>
        intro k hk
        rcases Nat.lt_or_ge (n0 + c + m) k with hk' | hk'
        · have hkn : k = n0 + c + m + 1 := by omega
          have hlt : ∀ j < k, g j = 0 := fun j hj => ih j (by omega)
          have hgn := hi g k hg1 hlt
          rw [hmap, Submodule.mem_map] at hgn
          obtain ⟨v, hv, hve⟩ := hgn
          have hvF : v ∈ F.N k := by
            refine Submodule.mem_inf.mpr ⟨hv, ?_⟩
            rw [Submodule.mem_comap, hWmem]
            exact ⟨g, hg1, hg2, hlt, hve.symm⟩
          rw [show k = n0 + (c + m + 1) by omega] at hvF hve ⊢
          rw [← hve]
          exact hkey (c + m + 1) (by omega) v hvF
        · exact ih k hk'
    intro k
    exact hall k k (by omega)

  have jfc_sys : ∀ (A : Type u) [CommRing A] (J : Ideal A) (X : ℕ → Type u)
      [∀ k, AddCommGroup (X k)] [∀ k, Module A (X k)] (p : ∀ k, X (k + 1) →ₗ[A] X k),
      Module.Finite A (X 0) → (∀ k, Function.Surjective (p k)) →
      (∀ k (x : X (k + 1)), p k x = 0 → x ∈ J ^ (k + 1) • (⊤ : Submodule A (X (k + 1)))) →
      (∀ k, J ^ (k + 1) • (⊤ : Submodule A (X k)) = ⊥) →
      ∃ (s : ℕ) (ρ : ∀ k, (Fin s → A) →ₗ[A] X k), (∀ k, Function.Surjective (ρ k)) ∧
        (∀ k v, p k (ρ (k + 1) v) = ρ k v) ∧
        (∀ k, J ^ (k + 1) • (⊤ : Submodule A (Fin s → A)) ≤ LinearMap.ker (ρ k)) ∧
        (∀ k (x : X (k + 1)), p k x = 0 →
          ∃ w ∈ J ^ (k + 1) • (⊤ : Submodule A (Fin s → A)), ρ (k + 1) w = x) := by
    intro A _ J X _ _ p hfin hp hker hkill
    obtain ⟨s, g₀, hg₀⟩ := Module.Finite.exists_fin (R := A) (M := X 0)
    let g : ∀ k, Fin s → X k := fun k =>
      Nat.rec (motive := fun k => Fin s → X k) g₀ (fun k gk i => Function.surjInv (hp k) (gk i)) k
    have hg : ∀ k i, p k (g (k + 1) i) = g k i := fun k i => Function.surjInv_eq (hp k) (g k i)
    let ρ : ∀ k, (Fin s → A) →ₗ[A] X k := fun k => Fintype.linearCombination A (g k)
    have hcomp : ∀ k, (p k).comp (ρ (k + 1)) = ρ k := by
      intro k
      apply LinearMap.ext
      intro v
      simp only [LinearMap.comp_apply, ρ, Fintype.linearCombination_apply, map_sum, map_smul, hg]
    have hcv : ∀ k v, p k (ρ (k + 1) v) = ρ k v := fun k v => by
      rw [← LinearMap.comp_apply, hcomp]
    have hsurj : ∀ k, Function.Surjective (ρ k) := by
      intro k
      rw [← LinearMap.range_eq_top]
      induction k with
      | zero =>
        show (Fintype.linearCombination A (g 0)).range = ⊤
        rw [Fintype.range_linearCombination]
        exact hg₀
      | succ k ih =>
        rw [LinearMap.range_eq_top] at ih
        have h1 : (⊤ : Submodule A (X (k + 1))) ≤ LinearMap.range (ρ (k + 1)) ⊔
            J ^ (k + 1) • (⊤ : Submodule A (X (k + 1))) := by
          intro y _
          obtain ⟨v, hv⟩ := ih (p k y)
          have h0 : p k (y - ρ (k + 1) v) = 0 := by
            rw [map_sub, hcv, hv, sub_self]
          rw [Submodule.mem_sup]
          exact ⟨ρ (k + 1) v, LinearMap.mem_range_self _ _, _, hker k _ h0, by abel⟩
        have h2 : J ^ (k + 1) • (⊤ : Submodule A (X (k + 1))) ≤ LinearMap.range (ρ (k + 1)) := by
          calc J ^ (k + 1) • (⊤ : Submodule A (X (k + 1)))
              ≤ J ^ (k + 1) • (LinearMap.range (ρ (k + 1)) ⊔
                  J ^ (k + 1) • (⊤ : Submodule A (X (k + 1)))) := Submodule.smul_mono le_rfl h1
            _ = J ^ (k + 1) • LinearMap.range (ρ (k + 1)) ⊔
                  (J ^ (k + 1) * J ^ (k + 1)) • (⊤ : Submodule A (X (k + 1))) := by
                rw [Submodule.smul_sup, Submodule.mul_smul]
            _ ≤ LinearMap.range (ρ (k + 1)) ⊔ J ^ (k + 1 + 1) • (⊤ : Submodule A (X (k + 1))) :=
                sup_le_sup Submodule.smul_le_right (Submodule.smul_mono_left (by
                  rw [← pow_add]; exact Ideal.pow_le_pow_right (by omega)))
            _ = LinearMap.range (ρ (k + 1)) := by rw [hkill (k + 1), sup_bot_eq]
        exact eq_top_iff.mpr (h1.trans (sup_le le_rfl h2))
    refine ⟨s, ρ, hsurj, hcv, fun k => ?_, fun k x hx => ?_⟩
    · rw [Submodule.smul_le]
      intro r hr v _
      have hmem : ρ k (r • v) ∈ J ^ (k + 1) • (⊤ : Submodule A (X k)) := by
        rw [map_smul]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
      rw [hkill k, Submodule.mem_bot] at hmem
      exact hmem
    · have hx' := hker k x hx
      have hmap : J ^ (k + 1) • (⊤ : Submodule A (X (k + 1))) =
          Submodule.map (ρ (k + 1)) (J ^ (k + 1) • (⊤ : Submodule A (Fin s → A))) := by
        rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr (hsurj (k + 1))]
      rw [hmap, Submodule.mem_map] at hx'
      exact hx'
  intro A _ _ J N _ _ _ Nq M _ _ _ _ _ q τN π β c hq_s hq_k hq_c hπ_s hπ_k hkill hβτ hβker hβcok

  have hfmem : ∀ {X Y : Type u} [AddCommGroup X] [Module A X] [AddCommGroup Y] [Module A Y]
      (f : X →ₗ[A] Y) (I : Ideal A) (L : Submodule A X) (x : X), x ∈ I • L →
      f x ∈ I • (⊤ : Submodule A Y) := by
    intro X Y _ _ _ _ f I L x hx
    have h1 : f x ∈ Submodule.map f (I • L) := Submodule.mem_map_of_mem hx
    rw [Submodule.map_smul''] at h1
    exact Submodule.smul_mono le_rfl le_top h1
  have hkM : ∀ k m (x : M k), k + 1 ≤ m → x ∈ J ^ m • (⊤ : Submodule A (M k)) → x = 0 := by
    intro k m x hm hx
    have : x ∈ J ^ (k + 1) • (⊤ : Submodule A (M k)) :=
      Submodule.smul_mono_left (Ideal.pow_le_pow_right hm) hx
    rwa [hkill, Submodule.mem_bot] at this

  have hτs : ∀ e, Function.Surjective (τN e) := by
    intro e y
    obtain ⟨n, rfl⟩ := hq_s e y
    exact ⟨q (e + 1) n, hq_c e n⟩
  have hτk : ∀ e (x : Nq (e + 1)), τN e x = 0 → x ∈ J ^ (e + 1) • (⊤ : Submodule A (Nq (e + 1))) := by
    intro e x hx
    obtain ⟨n, rfl⟩ := hq_s (e + 1) x
    rw [hq_c] at hx
    exact hfmem (q (e + 1)) _ ⊤ n ((hq_k e n).mp hx)
  have hNkill : ∀ e, J ^ (e + 1) • (⊤ : Submodule A (Nq e)) = ⊥ := by
    intro e
    rw [eq_bot_iff]
    intro y hy
    have hmapq : J ^ (e + 1) • (⊤ : Submodule A (Nq e)) =
        Submodule.map (q e) (J ^ (e + 1) • (⊤ : Submodule A N)) := by
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr (hq_s e)]
    rw [hmapq, Submodule.mem_map] at hy
    obtain ⟨n, hn, rfl⟩ := hy
    exact (Submodule.mem_bot A).mpr ((hq_k e n).mpr hn)
  have hNq0 : Module.Finite A (Nq 0) := Module.Finite.of_surjective (q 0) (hq_s 0)

  obtain ⟨s, ρ, hρs, hρc, hρA, hρB⟩ := jfc_sys A J M π inferInstance hπ_s
    (fun k x hx => (hπ_k k x).mp hx) hkill
  obtain ⟨r, ρN, -, hρNc, hρNA, hρNB⟩ := jfc_sys A J Nq τN hNq0 hτs hτk hNkill

  let Lc : Submodule A (∀ k, M k) :=
    { carrier := {g | ∀ k, π k (g (k + 1)) = g k}
      add_mem' := fun {a b} ha hb k => by simp only [Pi.add_apply, map_add, ha k, hb k]
      zero_mem' := fun k => by simp
      smul_mem' := fun a g hg k => by simp only [Pi.smul_apply, map_smul, hg k] }
  have hLc : ∀ g, g ∈ Lc ↔ ∀ k, π k (g (k + 1)) = g k := fun g => Iff.rfl
  let LcN : Submodule A (∀ k, Nq k) :=
    { carrier := {g | ∀ k, τN k (g (k + 1)) = g k}
      add_mem' := fun {a b} ha hb k => by simp only [Pi.add_apply, map_add, ha k, hb k]
      zero_mem' := fun k => by simp
      smul_mem' := fun a g hg k => by simp only [Pi.smul_apply, map_smul, hg k] }
  have hLcN : ∀ g, g ∈ LcN ↔ ∀ k, τN k (g (k + 1)) = g k := fun g => Iff.rfl
  let bP : (∀ k, M k) →ₗ[A] (∀ k, Nq k) := LinearMap.pi (fun k => (β k).comp (LinearMap.proj k))
  have hbP : ∀ x k, bP x k = β k (x k) := fun x k => rfl
  have T1 := jfc_t1 A J Nq M τN π β c hβτ hβker hβcok Lc LcN hLc hLcN bP hbP
  have T2M := jfc_t2 A J M π s ρ Lc hLc hρc hρA hρB
  have T2N := jfc_t2 A J Nq τN r ρN LcN hLcN hρNc hρNA hρNB

  obtain ⟨k1, hk1⟩ := jfc_uniform A J M π s ρ (fun k => LinearMap.ker (β k)) c hρs hρc
    (fun k x hx => (hπ_k k x).mp hx) hkill (fun k a ha x hx => hβker k x hx a ha)
  have cF : ∀ g : ∀ k, M k, (∀ k, π k (g (k + 1)) = g k) → (∀ k, β k (g k) = 0) →
      g k1 = 0 → ∀ k, g k = 0 := fun g hg hβg hgk => hk1 g hg (fun k => hβg k) hgk

  have cE : ∀ (n : N), ∀ a ∈ J ^ (2 * c), ∃ g : ∀ k, M k,
      (∀ k, π k (g (k + 1)) = g k) ∧ ∀ k, β k (g k) = q k (a • n) := by
    intro n a ha
    have hy : (fun k => q k n) ∈ LcN := fun k => hq_c k n
    have h1 : a • (fun k => q k n) ∈ J ^ (0 + 2 * c) • LcN := by
      rw [zero_add]; exact Submodule.smul_mem_smul ha hy
    obtain ⟨x, hx, hxe⟩ := (Submodule.mem_map).mp (T1 0 h1)
    refine ⟨x, (hLc x).mp (Submodule.smul_le_right hx), fun k => ?_⟩
    rw [← hbP, hxe, map_smul]
    rfl

  let K : Submodule A (N × ∀ k, M k) :=
    { carrier := {x | (∀ k, π k (x.2 (k + 1)) = x.2 k) ∧ ∀ k, β k (x.2 k) = q k x.1}
      add_mem' := fun {a b} ha hb => ⟨fun k => by
          simp only [Prod.snd_add, Pi.add_apply, map_add, ha.1 k, hb.1 k],
        fun k => by simp only [Prod.snd_add, Prod.fst_add, Pi.add_apply, map_add, ha.2 k, hb.2 k]⟩
      zero_mem' := ⟨fun k => by simp, fun k => by simp⟩
      smul_mem' := fun a x hx => ⟨fun k => by
          simp only [Prod.smul_snd, Pi.smul_apply, map_smul, hx.1 k],
        fun k => by simp only [Prod.smul_snd, Prod.smul_fst, Pi.smul_apply, map_smul, hx.2 k]⟩ }
  have hNnoeth : IsNoetherian A N := isNoetherian_of_isNoetherianRing_of_finite A N
  have hMnoeth : IsNoetherian A (M k1) := isNoetherian_of_isNoetherianRing_of_finite A (M k1)
  let ev : (N × ∀ k, M k) →ₗ[A] M k1 :=
    (LinearMap.proj k1).comp (LinearMap.snd A N (∀ k, M k))
  have hKfg : K.FG := by
    apply Submodule.fg_of_fg_map_of_fg_inf_ker (LinearMap.fst A N (∀ k, M k))
    · exact IsNoetherian.noetherian _
    · apply Submodule.fg_of_fg_map_of_fg_inf_ker ev
      · exact IsNoetherian.noetherian _
      · have hbot : K ⊓ LinearMap.ker (LinearMap.fst A N (∀ k, M k)) ⊓ LinearMap.ker ev = ⊥ := by
          rw [eq_bot_iff]
          rintro ⟨n, g⟩ hx
          obtain ⟨⟨hxK, hx1'⟩, hx2'⟩ := hx
          have hx1 : n = 0 := hx1'
          have hx2 : g k1 = 0 := hx2'
          have hxK' : (n, g) ∈ K := hxK
          obtain ⟨hgc, hgβ⟩ := hxK'
          subst hx1
          have := cF g hgc (fun k => by rw [hgβ k]; exact map_zero _) hx2
          rw [Submodule.mem_bot]
          ext k
          · rfl
          · exact this k
        rw [hbot]; exact Submodule.fg_bot
  obtain ⟨t, gen, hgen⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hKfg
  have hgenK : ∀ i, gen i ∈ K := fun i => by rw [← hgen]; exact Submodule.subset_span ⟨i, rfl⟩

  have cC : ∃ (s : ℕ) (n0 : Fin s → N) (g0 : Fin s → ∀ k, M k),
      (∀ i k, π k (g0 i (k + 1)) = g0 i k) ∧ (∀ i k, β k (g0 i k) = q k (n0 i)) ∧
      ∀ (n : N) (g : ∀ k, M k), (∀ k, π k (g (k + 1)) = g k) → (∀ k, β k (g k) = q k n) →
        ∃ b : Fin s → A, n = ∑ i, b i • n0 i ∧ ∀ k, g k = ∑ i, b i • g0 i k := by
    refine ⟨t, fun i => (gen i).1, fun i => (gen i).2, fun i => (hgenK i).1,
      fun i => (hgenK i).2, fun n g hg hgq => ?_⟩
    have hmem : (n, g) ∈ K := ⟨hg, hgq⟩
    rw [← hgen, Submodule.mem_span_range_iff_exists_fun] at hmem
    obtain ⟨b, hb⟩ := hmem
    refine ⟨b, ?_, fun k => ?_⟩
    · have h1 := congrArg Prod.fst hb
      simp only [Prod.fst_sum, Prod.smul_fst] at h1
      exact h1.symm
    · have h2 := congrArg (fun x => x.2 k) hb
      simp only [Prod.snd_sum, Finset.sum_apply, Prod.smul_snd, Pi.smul_apply] at h2
      exact h2.symm

  have cA : ∀ e (m : M e), ∃ (n : N) (g : ∀ k, M k), (∀ k, π k (g (k + 1)) = g k) ∧
      (∀ k, β k (g k) = q k n) ∧ g e = m := by
    intro e m
    obtain ⟨v, hv⟩ := hρs e m
    have hg0 : (fun k => ρ k v) ∈ Lc := fun k => hρc k v
    have hy : bP (fun k => ρ k v) ∈ LcN := fun k => by
      rw [hbP, hbP, hβτ, hρc]
    obtain ⟨n, hn⟩ := hq_s (e + 2 * c) (bP (fun k => ρ k v) (e + 2 * c))
    have hz : bP (fun k => ρ k v) - (fun k => q k n) ∈ LcN :=
      LcN.sub_mem hy (fun k => hq_c k n)
    have hz0 : (bP (fun k => ρ k v) - (fun k => q k n)) (e + 2 * c) = 0 := by
      simp only [Pi.sub_apply, hn, sub_self]
    have h1 := T2N _ _ hz hz0
    rw [show e + 2 * c + 1 = (e + 1) + 2 * c by omega] at h1
    obtain ⟨X, hX, hXe⟩ := (Submodule.mem_map).mp (T1 (e + 1) h1)
    have hXL : X ∈ Lc := Submodule.smul_le_right hX
    have hXe0 : X e = 0 := hkM e (e + 1) _ le_rfl (hfmem (LinearMap.proj e) _ Lc X hX)
    refine ⟨n, (fun k => ρ k v) - X, (hLc _).mp (Lc.sub_mem hg0 hXL), fun k => ?_, ?_⟩
    · have h2 := congrFun hXe k
      simp only [hbP, Pi.sub_apply] at h2 ⊢
      rw [map_sub, h2]; abel
    · simp only [Pi.sub_apply, hXe0, sub_zero, hv]

  have hlift : ∀ D, Lc ≤ Submodule.map (LinearMap.snd A N (∀ k, M k)) K ⊔ J ^ (D + 1) • Lc := by
    intro D h hh
    have hy : bP h ∈ LcN := fun k => by rw [hbP, hbP, hβτ, (hLc h).mp hh k]
    obtain ⟨ν, hν⟩ := hq_s (D + 2 * c) (bP h (D + 2 * c))
    have hz : bP h - (fun k => q k ν) ∈ LcN := LcN.sub_mem hy (fun k => hq_c k ν)
    have hz0 : (bP h - (fun k => q k ν)) (D + 2 * c) = 0 := by
      simp only [Pi.sub_apply, hν, sub_self]
    have h1 := T2N _ _ hz hz0
    rw [show D + 2 * c + 1 = (D + 1) + 2 * c by omega] at h1
    obtain ⟨ω, hω, hωe⟩ := (Submodule.mem_map).mp (T1 (D + 1) h1)
    have hωL : ω ∈ Lc := Submodule.smul_le_right hω
    have hmK : (ν, h - ω) ∈ K := by
      refine ⟨(hLc _).mp (Lc.sub_mem hh hωL), fun k => ?_⟩
      have h2 := congrFun hωe k
      simp only [hbP, Pi.sub_apply] at h2 ⊢
      rw [map_sub, h2]; abel
    rw [Submodule.mem_sup]
    exact ⟨h - ω, ⟨(ν, h - ω), hmK, rfl⟩, ω, hω, by abel⟩
  have hfstK : J ^ (2 * c) • (⊤ : Submodule A N) ≤ Submodule.map (LinearMap.fst A N (∀ k, M k)) K := by
    rw [Submodule.smul_le]
    intro a ha n _
    obtain ⟨g, hg, hgq⟩ := cE n a ha
    exact ⟨(a • n, g), ⟨hg, hgq⟩, rfl⟩
  have cB : ∀ e (n : N) (g : ∀ k, M k), (∀ k, π k (g (k + 1)) = g k) →
      (∀ k, β k (g k) = q k n) → g e = 0 → ∃ (s : ℕ) (b : Fin s → A) (n' : Fin s → N)
      (g' : Fin s → ∀ k, M k), (∀ i, b i ∈ J ^ (e + 1)) ∧ (∀ i k, π k (g' i (k + 1)) = g' i k) ∧
      (∀ i k, β k (g' i k) = q k (n' i)) ∧ n = ∑ i, b i • n' i ∧
      ∀ k, g k = ∑ i, b i • g' i k := by
    intro e n g hg hgq hge
    have hgJ := T2M e g hg hge
    have h1 : g ∈ Submodule.map (LinearMap.snd A N (∀ k, M k)) (J ^ (e + 1) • K) ⊔
        J ^ ((e + 1) + (k1 + 2 * c + 1)) • Lc := by
      have := Submodule.smul_mono (le_refl (J ^ (e + 1))) (hlift (k1 + 2 * c)) hgJ
      rwa [Submodule.smul_sup, ← Submodule.map_smul'', ← Submodule.mul_smul, ← pow_add] at this
    obtain ⟨g1, ⟨κ', hκ', hκ'2⟩, ω', hω', hsum⟩ := Submodule.mem_sup.mp h1
    have hκ'K : κ' ∈ K := Submodule.smul_le_right hκ'
    have hx'K : (n, g) - κ' ∈ K := K.sub_mem ⟨hg, hgq⟩ hκ'K
    have hx'2 : ((n, g) - κ').2 = ω' := by
      have e1 : κ'.2 = g1 := hκ'2
      show g - κ'.2 = ω'
      rw [e1, ← hsum]; abel
    have hω'0 : ∀ m, m + 1 ≤ (e + 1) + (k1 + 2 * c + 1) → ω' m = 0 := fun m hm =>
      hkM m _ _ hm (hfmem (LinearMap.proj m) _ Lc ω' hω')
    have hℓ : q (e + k1 + 2 * c + 1) ((n, g) - κ').1 = 0 := by
      rw [← hx'K.2, hx'2, hω'0 _ (by omega), map_zero]
    have hfst := (hq_k _ _).mp hℓ
    rw [show e + k1 + 2 * c + 1 + 1 = (e + k1 + 2) + 2 * c by omega, pow_add,
      Submodule.mul_smul] at hfst
    have hfst2 := Submodule.smul_mono (le_refl (J ^ (e + k1 + 2))) hfstK hfst
    rw [← Submodule.map_smul'', Submodule.mem_map] at hfst2
    obtain ⟨κ, hκ, hκ1⟩ := hfst2
    have hκK : κ ∈ K := Submodule.smul_le_right hκ
    have hκ2 : κ.2 k1 = 0 := hkM k1 _ _ (by omega) (hfmem ev _ K κ hκ)
    have hx''K : ((n, g) - κ') - κ ∈ K := K.sub_mem hx'K hκK
    have hx''1 : (((n, g) - κ') - κ).1 = 0 := by
      simp only [Prod.fst_sub] at hκ1 ⊢
      rw [← hκ1]; exact sub_self _
    have hx''2 := cF _ hx''K.1 (fun k => by rw [hx''K.2 k, hx''1, map_zero])
      (by
        simp only [Prod.snd_sub, Pi.sub_apply] at hx'2 ⊢
        rw [hκ2, sub_zero]
        have := congrFun hx'2 k1
        simp only [Pi.sub_apply] at this
        rw [this, hω'0 k1 (by omega)])
    have hdecomp : (n, g) = κ' + κ := by
      have h0 : ((n, g) - κ') - κ = 0 := Prod.ext hx''1 (funext hx''2)
      rw [sub_sub, sub_eq_zero] at h0
      exact h0
    have hmem : (n, g) ∈ J ^ (e + 1) • Submodule.span A (Set.range gen) := by
      rw [hgen, hdecomp]
      exact Submodule.add_mem _ hκ'
        (Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega)) hκ)
    obtain ⟨a, ha, hasum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ gen _).mp hmem
    rw [Finsupp.sum_fintype _ _ (fun i => zero_smul A (gen i))] at hasum
    refine ⟨t, a, fun i => (gen i).1, fun i => (gen i).2, ha, fun i => (hgenK i).1,
      fun i => (hgenK i).2, ?_, fun k => ?_⟩
    · have h1 := congrArg Prod.fst hasum
      simp only [Prod.fst_sum, Prod.smul_fst] at h1
      exact h1.symm
    · have h2 := congrArg (fun x => x.2 k) hasum
      simp only [Prod.snd_sum, Finset.sum_apply, Prod.smul_snd, Pi.smul_apply] at h2
      exact h2.symm
  exact ⟨cA, cB, cC, cE, ⟨k1, cF⟩⟩

theorem wc_cn_jadic_fibre_qcoh : ∀ (Z : Scheme.{u}) (𝒥 : Z.IdealSheafData) (G : ℕ → Z.Modules) (τ : ∀ e, G (e + 1) ⟶ G e) (H F : Z.Modules) (a : F ⟶ H) (φF : ∀ e, F ⟶ G e) (c : ℕ), (∀ e, wcQcoh (G e)) → wcQcoh H → (∀ e, φF (e + 1) ≫ τ e = φF e) → (∀ e (V : Z.Opens), IsAffineOpen V → Function.Surjective (Scheme.Modules.Hom.app (φF e) V)) → (∀ e (V : Z.Opens) (hV : IsAffineOpen V) (s : Γ(F, V)), Scheme.Modules.Hom.app (φF e) V s = 0 ↔ s ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) • (⊤ : Submodule Γ(Z, V) Γ(F, V))) → (∀ (V : Z.Opens) (hV : IsAffineOpen V) (n : Γ(H, V)), ∀ a0 ∈ 𝒥.ideal ⟨V, hV⟩ ^ c, ∃ s : Γ(F, V), Scheme.Modules.Hom.app a V s = a0 • n) → (∀ (V : Z.Opens), IsAffineOpen V → ∃ k1 : ℕ, ∀ s : Γ(F, V), Scheme.Modules.Hom.app a V s = 0 → Scheme.Modules.Hom.app (φF k1) V s = 0 → s = 0) → wcQcoh F :=
by
  intro Z 𝒥 G τ H F a φF c hG hH _hcomp surjF kerF imgF unifF
  have nat : ∀ {M N : Z.Modules} (g : M ⟶ N) {V W : Z.Opens} (h : V ≤ W) (s : Γ(M, W)),
      Scheme.Modules.Hom.app g V ((M.presheaf.map (homOfLE h).op).hom s) =
        (N.presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app g W s) := by
    intro M N g V W h s
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g) (homOfLE h).op s
  have smulR : ∀ (M : Z.Modules) {V W : Z.Opens} (h : V ≤ W) (r : Γ(Z, W)) (x : Γ(M, W)),
      (M.presheaf.map (homOfLE h).op).hom (r • x) =
        (Z.presheaf.map (homOfLE h).op).hom r • (M.presheaf.map (homOfLE h).op).hom x :=
    fun M V W h r x => Scheme.Modules.map_smul M (homOfLE h) r x
  intro U hU f
  have hD : IsAffineOpen (Z.basicOpen f) := hU.basicOpen f
  haveI := hU.isLocalization_basicOpen f
  have hunit : IsUnit ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) :=
    IsLocalization.Away.algebraMap_isUnit (S := Γ(Z, Z.basicOpen f)) f
  obtain ⟨v, hv⟩ := hunit.exists_left_inv
  refine ⟨?_, ?_⟩
  swap
  ·
    intro t ht
    obtain ⟨k1, hk1⟩ := unifF U hU
    have h1 : (H.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
        (Scheme.Modules.Hom.app a U t) = 0 := by
      rw [← nat, ht, map_zero]
    obtain ⟨p1, hp1⟩ := (hH U hU f).2 _ h1
    have h2 : ((G k1).presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom
        (Scheme.Modules.Hom.app (φF k1) U t) = 0 := by
      rw [← nat, ht, map_zero]
    obtain ⟨p2, hp2⟩ := (hG k1 U hU f).2 _ h2
    refine ⟨p1 + p2, hk1 _ ?_ ?_⟩
    · rw [Scheme.Modules.Hom.app_smul, pow_add, mul_comm, mul_smul, hp1, smul_zero]
    · rw [Scheme.Modules.Hom.app_smul, pow_add, mul_smul, hp2, smul_zero]
  ·
    intro s
    obtain ⟨k1, hk1⟩ := unifF (Z.basicOpen f) hD
    let R : Submodule Γ(Z, Z.basicOpen f) Γ(F, Z.basicOpen f) :=
      Submodule.span Γ(Z, Z.basicOpen f)
        (Set.range (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom)

    have s2 : ∀ x, x ∈ Submodule.span Γ(Z, Z.basicOpen f)
          (Set.range (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom) →
        ∃ (n : ℕ) (t : Γ(F, U)),
        ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ n • x =
          (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t := by
      intro x hx'
      induction hx' using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨t, rfl⟩ := hx
        exact ⟨0, t, by rw [pow_zero, one_smul]⟩
      | zero => exact ⟨0, 0, by rw [smul_zero, map_zero]⟩
      | add x y _ _ hx hy =>
        obtain ⟨n1, t1, e1⟩ := hx
        obtain ⟨n2, t2, e2⟩ := hy
        refine ⟨n1 + n2, f ^ n2 • t1 + f ^ n1 • t2, ?_⟩
        rw [map_add, smulR, smulR, map_pow, map_pow, ← e1, ← e2, smul_add, smul_smul, smul_smul,
          ← pow_add, ← pow_add, add_comm n2 n1]
      | smul b x _ hx =>
        obtain ⟨n, t, e⟩ := hx
        obtain ⟨m, c0, hc⟩ := IsLocalization.Away.surj f b
        have hc' : b * (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f ^ m =
            (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom c0 := hc
        refine ⟨m + n, c0 • t, ?_⟩
        rw [smulR, ← e, ← hc', smul_smul, smul_smul, pow_add]
        congr 1
        ring

    have h3 : ∀ s : Γ(F, Z.basicOpen f), ∃ r ∈ R, s - r ∈
        (𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ (k1 + c + 1) : Ideal Γ(Z, Z.basicOpen f)) •
          (⊤ : Submodule Γ(Z, Z.basicOpen f) Γ(F, Z.basicOpen f)) := by
      intro s
      obtain ⟨p, μ, hμ⟩ := (hG (k1 + c) U hU f).1
        (Scheme.Modules.Hom.app (φF (k1 + c)) (Z.basicOpen f) s)
      obtain ⟨t, ht⟩ := surjF (k1 + c) U hU μ
      have hd : Scheme.Modules.Hom.app (φF (k1 + c)) (Z.basicOpen f)
          (((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ p • s -
            (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t) = 0 := by
        rw [map_sub, Scheme.Modules.Hom.app_smul, hμ, nat, ht, sub_self]
      have hd' := (kerF (k1 + c) (Z.basicOpen f) hD _).1 hd
      refine ⟨v ^ p • (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t,
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨t, rfl⟩), ?_⟩
      have e : s - v ^ p • (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t =
          v ^ p • (((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ p • s -
            (F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t) := by
        rw [smul_sub, smul_smul, ← mul_pow, hv, one_pow, one_smul]
      rw [e]
      exact Submodule.smul_mem _ _ hd'

    have hmap : Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (𝒥.ideal ⟨U, hU⟩) =
        𝒥.ideal ⟨Z.basicOpen f, hD⟩ := 𝒥.map_ideal_basicOpen ⟨U, hU⟩ f
    have hIc : 𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ c =
        Ideal.map (Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom (𝒥.ideal ⟨U, hU⟩ ^ c) := by
      rw [Ideal.map_pow, hmap]
    have h4 : ∀ a0 ∈ 𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ c, ∀ w : Γ(F, Z.basicOpen f), ∃ r ∈ R,
        Scheme.Modules.Hom.app a (Z.basicOpen f) r =
          a0 • Scheme.Modules.Hom.app a (Z.basicOpen f) w := by
      intro a0 ha0 w
      obtain ⟨p, n0, hn0⟩ := (hH U hU f).1 (Scheme.Modules.Hom.app a (Z.basicOpen f) w)
      have claim : ∀ b, b ∈ Submodule.span Γ(Z, Z.basicOpen f)
            ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom ''
              ((𝒥.ideal ⟨U, hU⟩ ^ c : Ideal Γ(Z, U)) : Set Γ(Z, U))) →
          ∃ r ∈ R, Scheme.Modules.Hom.app a (Z.basicOpen f) r =
            b • (H.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom n0 := by
        intro b hb'
        induction hb' using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨u, hu, rfl⟩ := hx
          obtain ⟨t, ht⟩ := imgF U hU n0 u hu
          exact ⟨(F.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom t,
            Submodule.subset_span ⟨t, rfl⟩, by rw [nat, ht, smulR]⟩
        | zero => exact ⟨0, R.zero_mem, by rw [map_zero, zero_smul]⟩
        | add x y _ _ hx hy =>
          obtain ⟨r1, hr1, e1⟩ := hx
          obtain ⟨r2, hr2, e2⟩ := hy
          exact ⟨r1 + r2, R.add_mem hr1 hr2, by rw [map_add, e1, e2, add_smul]⟩
        | smul b' x _ hx =>
          obtain ⟨r0, hr0, e0⟩ := hx
          exact ⟨b' • r0, R.smul_mem b' hr0, by
            rw [Scheme.Modules.Hom.app_smul, e0, smul_eq_mul, mul_smul]⟩
      rw [hIc] at ha0
      obtain ⟨r0, hr0, e0⟩ := claim a0 ha0
      refine ⟨v ^ p • r0, R.smul_mem _ hr0, ?_⟩
      have hcoef : v ^ p * a0 * ((Z.presheaf.map (homOfLE (Z.basicOpen_le f)).op).hom f) ^ p = a0 := by
        rw [mul_comm (v ^ p) a0, mul_assoc, ← mul_pow, hv, one_pow, mul_one]
      rw [Scheme.Modules.Hom.app_smul, e0, ← hn0, smul_smul, smul_smul, hcoef]

    have inner : ∀ y ∈ (𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ c : Ideal Γ(Z, Z.basicOpen f)) •
        (⊤ : Submodule Γ(Z, Z.basicOpen f) Γ(F, Z.basicOpen f)), ∃ r ∈ R,
          Scheme.Modules.Hom.app a (Z.basicOpen f) r = Scheme.Modules.Hom.app a (Z.basicOpen f) y := by
      intro y hy
      refine Submodule.smul_induction_on (p := fun y => ∃ r ∈ R,
          Scheme.Modules.Hom.app a (Z.basicOpen f) r = Scheme.Modules.Hom.app a (Z.basicOpen f) y)
        hy (fun a0 ha0 w _ => ?_) (fun x y hx hy => ?_)
      · obtain ⟨r, hr, e⟩ := h4 a0 ha0 w
        exact ⟨r, hr, by rw [e, Scheme.Modules.Hom.app_smul]⟩
      · obtain ⟨r1, hr1, e1⟩ := hx
        obtain ⟨r2, hr2, e2⟩ := hy
        exact ⟨r1 + r2, R.add_mem hr1 hr2, by rw [map_add, map_add, e1, e2]⟩
    have outer : ∀ x ∈ (𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ (k1 + 1) : Ideal Γ(Z, Z.basicOpen f)) •
        ((𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ c : Ideal Γ(Z, Z.basicOpen f)) •
          (⊤ : Submodule Γ(Z, Z.basicOpen f) Γ(F, Z.basicOpen f))), x ∈ R := by
      intro x hx
      refine Submodule.smul_induction_on (p := fun x => x ∈ R) hx (fun b hb y hy => ?_)
        (fun x y hx hy => R.add_mem hx hy)
      obtain ⟨r, hr, e⟩ := inner y hy
      have hl : b • (y - r) = 0 := by
        apply hk1
        · rw [Scheme.Modules.Hom.app_smul, map_sub, e, sub_self, smul_zero]
        · exact (kerF k1 (Z.basicOpen f) hD _).2 (Submodule.smul_mem_smul hb Submodule.mem_top)
      have hbr : b • y = b • r := by
        rw [smul_sub, sub_eq_zero] at hl
        exact hl
      show b • y ∈ R
      rw [hbr]
      exact R.smul_mem b hr
    obtain ⟨r0, hr0, hw0⟩ := h3 s
    have epow : (𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ (k1 + c + 1) : Ideal Γ(Z, Z.basicOpen f)) =
        𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ (k1 + 1) * 𝒥.ideal ⟨Z.basicOpen f, hD⟩ ^ c := by
      rw [← pow_add, show k1 + 1 + c = k1 + c + 1 by omega]
    rw [epow, Submodule.mul_smul] at hw0
    have hmem : s - r0 ∈ R := outer _ hw0
    have hsR : s ∈ R := by
      have := R.add_mem hr0 hmem
      rwa [add_sub_cancel] at this
    exact s2 s hsR

theorem wc_cn_jadic_algebraise : ∀ (Z : Scheme.{u}) [IsNoetherian Z] (𝒥 : Z.IdealSheafData)
    (G : ℕ → Z.Modules) (τ : ∀ e, G (e + 1) ⟶ G e) (H : Z.Modules) (H' : ℕ → Z.Modules)
    (τH' : ∀ e, H' (e + 1) ⟶ H' e) (q : ∀ e, H ⟶ H' e) (β : ∀ e, G e ⟶ H' e) (c : ℕ),
    wcCnJAdicSys 𝒥 G τ → wcCnJAdicSys 𝒥 H' τH' → wcCnJAlg 𝒥 H' τH' H q →
    (∀ e, β (e + 1) ≫ τH' e = τ e ≫ β e) → (∀ e, wcCnAlmostIso 𝒥 c (β e)) →
    ∃ (F : Z.Modules) (a : F ⟶ H) (φF : ∀ e, F ⟶ G e) (c' : ℕ),
      wcCnJAlg 𝒥 G τ F φF ∧ (∀ e, φF e ≫ β e = a ≫ q e) ∧ wcCnAlmostIso 𝒥 c' a :=
by
  intro Z _ 𝒥 G τ H H' τH' q β c hG _hH' hq hβτ hβa
  obtain ⟨hGcoh, hGtr, hGkill⟩ := hG
  obtain ⟨hHcoh, hqcomp, hqtr⟩ := hq
  have capp : ∀ {M N P : Z.Modules} (f : M ⟶ N) (g : N ⟶ P) (U : Z.Opens) (x : Γ(M, U)),
      Scheme.Modules.Hom.app (f ≫ g) U x =
        Scheme.Modules.Hom.app g U (Scheme.Modules.Hom.app f U x) := by
    intro M N P f g U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have hlin : ∀ {M N : Z.Modules} (φ : M ⟶ N) (V : Z.Opens) {ι : Type} [Fintype ι]
      (b : ι → Γ(Z, V)) (x : ι → Γ(M, V)),
      Scheme.Modules.Hom.app φ V (∑ i, b i • x i) = ∑ i, b i • Scheme.Modules.Hom.app φ V (x i) := by
    intro M N φ V ι _ b x
    change wcCnJaAppL φ V (∑ i, b i • x i) = ∑ i, b i • wcCnJaAppL φ V (x i)
    rw [map_sum]
    simp only [map_smul]
  obtain ⟨F, a, φF, hcomp, hsq, hsec⟩ :=
    wc_cn_jadic_fibre_sections Z G τ H H' τH' q β hqcomp hβτ
  have hcompV : ∀ e (V : Z.Opens) (s : Γ(F, V)),
      Scheme.Modules.Hom.app (τ e) V (Scheme.Modules.Hom.app (φF (e + 1)) V s) =
        Scheme.Modules.Hom.app (φF e) V s := by
    intro e V s
    rw [← capp, hcomp e]
  have hsqV : ∀ e (V : Z.Opens) (s : Γ(F, V)),
      Scheme.Modules.Hom.app (β e) V (Scheme.Modules.Hom.app (φF e) V s) =
        Scheme.Modules.Hom.app (q e) V (Scheme.Modules.Hom.app a V s) := by
    intro e V s
    rw [← capp, ← capp, hsq e]
  have hβτV : ∀ e (V : Z.Opens) (x : Γ(G (e + 1), V)),
      Scheme.Modules.Hom.app (τH' e) V (Scheme.Modules.Hom.app (β (e + 1)) V x) =
        Scheme.Modules.Hom.app (β e) V (Scheme.Modules.Hom.app (τ e) V x) := by
    intro e V x
    rw [← capp, ← capp, hβτ e]
  have hqcompV : ∀ e (V : Z.Opens) (n : Γ(H, V)),
      Scheme.Modules.Hom.app (τH' e) V (Scheme.Modules.Hom.app (q (e + 1)) V n) =
        Scheme.Modules.Hom.app (q e) V n := by
    intro e V n
    rw [← capp, hqcomp e]
  have hext : ∀ (V : Z.Opens) (s t : Γ(F, V)),
      Scheme.Modules.Hom.app a V s = Scheme.Modules.Hom.app a V t →
      (∀ e, Scheme.Modules.Hom.app (φF e) V s = Scheme.Modules.Hom.app (φF e) V t) → s = t := by
    intro V s t h1 h2
    apply sub_eq_zero.mp
    apply (hsec V).1
    · rw [map_sub, h1, sub_self]
    · intro e
      rw [map_sub, h2 e, sub_self]

  have core := fun (V : Z.Opens) (hV : IsAffineOpen V) =>
    haveI : IsNoetherianRing Γ(Z, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
    haveI : Module.Finite Γ(Z, V) Γ(H, V) := hHcoh.2 V hV
    haveI : ∀ e, Module.Finite Γ(Z, V) Γ(G e, V) := fun e => (hGcoh e).2 V hV
    wc_cn_jadic_fibre_core Γ(Z, V) (𝒥.ideal ⟨V, hV⟩) Γ(H, V) (fun e => Γ(H' e, V))
      (fun e => Γ(G e, V)) (fun e => wcCnJaAppL (q e) V) (fun e => wcCnJaAppL (τH' e) V)
      (fun e => wcCnJaAppL (τ e) V) (fun e => wcCnJaAppL (β e) V) c
      (fun e => (hqtr e V hV).1) (fun e n => (hqtr e V hV).2 n) (fun e n => hqcompV e V n)
      (fun e => (hGtr e V hV).1) (fun e x => (hGtr e V hV).2 x) (fun e => hGkill e V hV)
      (fun e x => hβτV e V x) (fun e x hx => (hβa e V hV).1 x hx) (fun e y => (hβa e V hV).2 y)

  have surjF : ∀ e (V : Z.Opens), IsAffineOpen V →
      Function.Surjective (Scheme.Modules.Hom.app (φF e) V) := by
    intro e V hV m
    obtain ⟨cA, -, -, -, -⟩ := core V hV
    obtain ⟨n, g, hg, hgq, hge⟩ := cA e m
    obtain ⟨s, -, hs2⟩ := (hsec V).2 n g hg hgq
    exact ⟨s, (hs2 e).trans hge⟩

  have kerF : ∀ e (V : Z.Opens) (hV : IsAffineOpen V) (s : Γ(F, V)),
      Scheme.Modules.Hom.app (φF e) V s = 0 ↔
        s ∈ (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) • (⊤ : Submodule Γ(Z, V) Γ(F, V)) := by
    intro e V hV s
    constructor
    · intro h0
      obtain ⟨-, cB, -, -, -⟩ := core V hV
      obtain ⟨r, b, n', g', hb, hg', hq', hn, hg⟩ :=
        cB e (Scheme.Modules.Hom.app a V s) (fun k => Scheme.Modules.Hom.app (φF k) V s)
          (fun k => hcompV k V s) (fun k => hsqV k V s) h0
      choose t ht1 ht2 using fun i => (hsec V).2 (n' i) (g' i) (hg' i) (hq' i)
      have hs : s = ∑ i, b i • t i := by
        refine hext V s _ ?_ ?_
        · rw [hlin]
          simp only [ht1]
          exact hn
        · intro k
          rw [hlin]
          simp only [ht2]
          exact hg k
      rw [hs]
      exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem_smul (hb i) Submodule.mem_top)
    · intro hs
      refine Submodule.smul_induction_on (p := fun x => Scheme.Modules.Hom.app (φF e) V x = 0) hs
        (fun r hr n _ => ?_) (fun x y hx hy => ?_)
      · have h1 : r • Scheme.Modules.Hom.app (φF e) V n ∈
            (𝒥.ideal ⟨V, hV⟩ ^ (e + 1) : Ideal Γ(Z, V)) •
              (⊤ : Submodule Γ(Z, V) Γ(G e, V)) :=
          Submodule.smul_mem_smul hr Submodule.mem_top
        rw [hGkill e V hV] at h1
        exact (Scheme.Modules.Hom.app_smul (φF e) r n).trans ((Submodule.mem_bot _).mp h1)
      · show Scheme.Modules.Hom.app (φF e) V (x + y) = 0
        rw [map_add, hx, hy, add_zero]

  have finF : ∀ V : Z.Opens, IsAffineOpen V → Module.Finite Γ(Z, V) Γ(F, V) := by
    intro V hV
    classical
    obtain ⟨-, -, cC, -, -⟩ := core V hV
    obtain ⟨r, n0, g0, hc0, hq0, hgen⟩ := cC
    choose t0 ht01 ht02 using fun i => (hsec V).2 (n0 i) (g0 i) (hc0 i) (hq0 i)
    refine Module.finite_def.mpr ⟨Finset.univ.image t0, eq_top_iff.mpr (fun s _ => ?_)⟩
    obtain ⟨b, hbn, hbg⟩ := hgen (Scheme.Modules.Hom.app a V s)
      (fun k => Scheme.Modules.Hom.app (φF k) V s) (fun k => hcompV k V s) (fun k => hsqV k V s)
    have hs : s = ∑ i, b i • t0 i := by
      refine hext V s _ ?_ ?_
      · rw [hlin]
        simp only [ht01]
        exact hbn
      · intro k
        rw [hlin]
        simp only [ht02]
        exact hbg k
    rw [hs]
    exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))

  have imgF : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (n : Γ(H, V)),
      ∀ a0 ∈ 𝒥.ideal ⟨V, hV⟩ ^ (2 * c), ∃ s : Γ(F, V), Scheme.Modules.Hom.app a V s = a0 • n := by
    intro V hV n a0 ha0
    obtain ⟨-, -, -, cE, -⟩ := core V hV
    obtain ⟨g, hg, hgq⟩ := cE n a0 ha0
    obtain ⟨s, hs1, -⟩ := (hsec V).2 (a0 • n) g hg hgq
    exact ⟨s, hs1⟩

  have unifF : ∀ (V : Z.Opens), IsAffineOpen V → ∃ k1 : ℕ, ∀ s : Γ(F, V),
      Scheme.Modules.Hom.app a V s = 0 → Scheme.Modules.Hom.app (φF k1) V s = 0 → s = 0 := by
    intro V hV
    obtain ⟨-, -, -, -, cF⟩ := core V hV
    obtain ⟨k1, hk1⟩ := cF
    refine ⟨k1, fun s hs0 hsk => (hsec V).1 s hs0 ?_⟩
    exact hk1 (fun k => Scheme.Modules.Hom.app (φF k) V s) (fun k => hcompV k V s)
      (fun k => (hsqV k V s).trans (by rw [hs0, map_zero])) hsk

  have qcohF : wcQcoh F :=
    wc_cn_jadic_fibre_qcoh Z 𝒥 G τ H F a φF (2 * c) (fun e => (hGcoh e).1) hHcoh.1 hcomp
      surjF kerF imgF unifF

  have almostF : wcCnAlmostIso 𝒥 (2 * c) a := by
    intro V hV
    refine ⟨fun s hs0 a0 ha0 => ?_, fun n a0 ha0 => imgF V hV n a0 ha0⟩
    have ha0' : a0 ∈ 𝒥.ideal ⟨V, hV⟩ ^ c := Ideal.pow_le_pow_right (by omega) ha0
    apply (hsec V).1
    · exact (Scheme.Modules.Hom.app_smul a a0 s).trans (by rw [hs0, smul_zero])
    · intro k
      exact (Scheme.Modules.Hom.app_smul (φF k) a0 s).trans
        ((hβa k V hV).1 _ ((hsqV k V s).trans (by rw [hs0, map_zero])) a0 ha0')
  exact ⟨F, a, φF, 2 * c, ⟨⟨qcohF, finF⟩, hcomp, fun e V hV => ⟨surjF e V hV, kerF e V hV⟩⟩,
    hsq, almostF⟩

theorem wc_cn_adic_cartesian : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (J : Ideal A) (t : ℕ) (M N : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] [AddCommGroup N] [Module A N] (Mq Nq : ℕ → Type u) [∀ e, AddCommGroup (Mq e)] [∀ e, Module A (Mq e)] [∀ e, AddCommGroup (Nq e)] [∀ e, Module A (Nq e)] (α : M →ₗ[A] N) (p : ∀ e, M →ₗ[A] Mq e) (π : ∀ e, N →ₗ[A] Nq e) (τM : ∀ e, Mq (e+1) →ₗ[A] Mq e) (ᾱ : ∀ e, Mq e →ₗ[A] Nq e), (∀ m, α m = 0 → ∀ b ∈ J ^ t, b • m = 0) → (∀ y, ∀ b ∈ J ^ t, ∃ m, α m = b • y) → (∀ e, Function.Surjective (p e)) → (∀ e m, p e m = 0 ↔ m ∈ J ^ (e+1) • (⊤ : Submodule A M)) → (∀ e y, π e y = 0 ↔ y ∈ J ^ (e+1) • (⊤ : Submodule A N)) → (∀ e m, τM e (p (e+1) m) = p e m) → (∀ e m, ᾱ e (p e m) = π e (α m)) → (∀ m, α m = 0 → (∀ e, p e m = 0) → m = 0) ∧ (∀ (y : N) (z : ∀ e, Mq e), (∀ e, τM e (z (e+1)) = z e) → (∀ e, ᾱ e (z e) = π e y) → ∃ m, α m = y ∧ ∀ e, p e m = z e) :=
by
  intro A _ _ J t M N _ _ _ _ _ Mq Nq _ _ _ _ α p π τM ᾱ hK hC hp hpk hπk hτ hᾱ
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul J (LinearMap.ker α)
  have hJK : J ^ t • LinearMap.ker α = ⊥ := by
    rw [eq_bot_iff]
    apply Submodule.smul_le.mpr
    intro r hr x hx
    rw [Submodule.mem_bot]
    exact hK x (LinearMap.mem_ker.mp hx) r hr
  have hstar : ∀ m, α m = 0 → m ∈ J ^ (k + t + 1) • (⊤ : Submodule A M) → m = 0 := by
    intro m hm hmem
    have h1 : m ∈ J ^ (k + t + 1) • (⊤ : Submodule A M) ⊓ LinearMap.ker α :=
      Submodule.mem_inf.mpr ⟨hmem, LinearMap.mem_ker.mpr hm⟩
    rw [hk (k + t + 1) (by omega)] at h1
    have h2 : J ^ (k + t + 1 - k) • (J ^ k • (⊤ : Submodule A M) ⊓ LinearMap.ker α) ≤
        J ^ t • LinearMap.ker α :=
      (Submodule.smul_mono le_rfl inf_le_right).trans
        (Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega)))
    have h3 := h2 h1
    rw [hJK, Submodule.mem_bot] at h3
    exact h3
  refine ⟨fun m hm hp0 => hstar m hm ((hpk (k + t) m).mp (hp0 (k + t))), ?_⟩
  intro y z hz hzα
  have hT : ∀ m e d, p (e + d) m = z (e + d) → p e m = z e := by
    intro m e d
    induction d with
    | zero => exact id
    | succ d ih =>
      intro h
      apply ih
      have h' : p (e + d + 1) m = z (e + d + 1) := h
      have := congrArg (τM (e + d)) h'
      rwa [hτ, hz] at this
  have hR0 : J ^ t • (⊤ : Submodule A N) ≤ LinearMap.range α := by
    apply Submodule.smul_le.mpr
    intro r hr y _
    obtain ⟨m, hm⟩ := hC y r hr
    exact LinearMap.mem_range.mpr ⟨m, hm⟩
  have hR : ∀ e, ∀ v ∈ J ^ (e + 1 + t) • (⊤ : Submodule A N),
      ∃ w ∈ J ^ (e + 1) • (⊤ : Submodule A M), α w = v := by
    intro e v hv
    have h1 : J ^ (e + 1 + t) • (⊤ : Submodule A N) ≤
        (J ^ (e + 1) • (⊤ : Submodule A M)).map α := by
      rw [pow_add J (e + 1) t, Submodule.mul_smul, Submodule.map_smul'', Submodule.map_top]
      exact Submodule.smul_mono le_rfl hR0
    obtain ⟨w, hw, hwv⟩ := (Submodule.mem_map).mp (h1 hv)
    exact ⟨w, hw, hwv⟩
  have hlev : ∀ e, ∃ m, α m = y ∧ p e m = z e := by
    intro e
    obtain ⟨m₀, hm₀⟩ := hp (e + t) (z (e + t))
    have h1 : π (e + t) (y - α m₀) = 0 := by
      rw [map_sub, ← hzα, ← hᾱ, hm₀, sub_self]
    have h2 := (hπk (e + t) _).mp h1
    rw [show e + t + 1 = e + 1 + t by omega] at h2
    obtain ⟨w, hw, hwv⟩ := hR e _ h2
    refine ⟨m₀ + w, ?_, ?_⟩
    · rw [map_add, hwv, add_sub_cancel]
    · rw [map_add, hT m₀ e t hm₀, (hpk e w).mpr hw, add_zero]
  choose mE hmEα hmEp using hlev
  refine ⟨mE (k + t), hmEα _, fun e => ?_⟩
  have h1 : p (k + t) (mE (k + t + e)) = z (k + t) := hT _ _ e (hmEp _)
  have h2 : mE (k + t + e) - mE (k + t) = 0 := by
    apply hstar
    · rw [map_sub, hmEα, hmEα, sub_self]
    · apply (hpk (k + t) _).mp
      rw [map_sub, h1, hmEp, sub_self]
  rw [sub_eq_zero] at h2
  rw [← h2]
  apply hT _ e (k + t)
  rw [show e + (k + t) = k + t + e by omega]
  exact hmEp _

theorem wc_cn_modules_cartesian_lift : ∀ (Z : Scheme.{u}) (M N : Z.Modules) (Mq Nq : ℕ → Z.Modules) (τM : ∀ e, Mq (e+1) ⟶ Mq e) (τN : ∀ e, Nq (e+1) ⟶ Nq e) (α : M ⟶ N) (p : ∀ e, M ⟶ Mq e) (π : ∀ e, N ⟶ Nq e) (ᾱ : ∀ e, Mq e ⟶ Nq e), (∀ e, p (e+1) ≫ τM e = p e) → (∀ e, π (e+1) ≫ τN e = π e) → (∀ e, ᾱ (e+1) ≫ τN e = τM e ≫ ᾱ e) → (∀ e, p e ≫ ᾱ e = α ≫ π e) → (∀ (V : Z.Opens), IsAffineOpen V → ∀ m : Γ(M, V), Scheme.Modules.Hom.app α V m = 0 → (∀ e, Scheme.Modules.Hom.app (p e) V m = 0) → m = 0) → (∀ (V : Z.Opens), IsAffineOpen V → ∀ (y : Γ(N, V)) (z : ∀ e, Γ(Mq e, V)), (∀ e, Scheme.Modules.Hom.app (τM e) V (z (e+1)) = z e) → (∀ e, Scheme.Modules.Hom.app (ᾱ e) V (z e) = Scheme.Modules.Hom.app (π e) V y) → ∃ m : Γ(M, V), Scheme.Modules.Hom.app α V m = y ∧ ∀ e, Scheme.Modules.Hom.app (p e) V m = z e) → ∀ (F : Z.Modules) (f : F ⟶ N) (g : ∀ e, F ⟶ Mq e), (∀ e, g (e+1) ≫ τM e = g e) → (∀ e, g e ≫ ᾱ e = f ≫ π e) → (∃ φ : F ⟶ M, φ ≫ α = f ∧ ∀ e, φ ≫ p e = g e) ∧ (∀ u u' : F ⟶ M, u ≫ α = u' ≫ α → (∀ e, u ≫ p e = u' ≫ p e) → u = u') :=
by
  intro Z M N Mq Nq τM τN α p π ᾱ _h1 _h2 _h3 _h4 hinj hsurj F f g hg hgᾱ
  have capp : ∀ {P R S : Z.Modules} (k : P ⟶ R) (l : R ⟶ S) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (k ≫ l) U x =
        Scheme.Modules.Hom.app l U (Scheme.Modules.Hom.app k U x) := by
    intro P R S k l U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have happ : ∀ {P R : Z.Modules} {k l : P ⟶ R}, k = l → ∀ (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app k U x = Scheme.Modules.Hom.app l U x := by
    rintro P R k l rfl U x
    rfl
  have nat : ∀ {P R : Z.Modules} (k : P ⟶ R) {V V' : Z.Opens} (h : V' ≤ V) (x : Γ(P, V)),
      Scheme.Modules.Hom.app k V' ((P.presheaf.map (homOfLE h).op).hom x) =
        (R.presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app k V x) := by
    intro P R k V V' h x
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf k) (homOfLE h).op x
  have LU : ∀ (V : Z.Opens), IsAffineOpen V → ∀ m m' : Γ(M, V),
      Scheme.Modules.Hom.app α V m = Scheme.Modules.Hom.app α V m' →
      (∀ e, Scheme.Modules.Hom.app (p e) V m = Scheme.Modules.Hom.app (p e) V m') → m = m' := by
    intro V hV m m' hα hp
    have h0 := hinj V hV (m - m') (by rw [map_sub, hα, sub_self])
      (fun e => by rw [map_sub, hp e, sub_self])
    exact sub_eq_zero.mp h0
  have hex : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (x : Γ(F, V)), ∃ m : Γ(M, V),
      Scheme.Modules.Hom.app α V m = Scheme.Modules.Hom.app f V x ∧
      ∀ e, Scheme.Modules.Hom.app (p e) V m = Scheme.Modules.Hom.app (g e) V x := by
    intro V hV x
    refine hsurj V hV (Scheme.Modules.Hom.app f V x) (fun e => Scheme.Modules.Hom.app (g e) V x)
      (fun e => ?_) (fun e => ?_)
    · rw [← capp]
      exact happ (hg e) V x
    · rw [← capp, ← capp]
      exact happ (hgᾱ e) V x
  choose Φ hΦα hΦp using hex
  have hadd : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (x x' : Γ(F, V)),
      Φ V hV (x + x') = Φ V hV x + Φ V hV x' := by
    intro V hV x x'
    apply LU V hV
    · rw [map_add, hΦα, hΦα, hΦα, map_add]
    · intro e
      rw [map_add, hΦp, hΦp, hΦp, map_add]
  have hsmul : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (r : Γ(Z, V)) (x : Γ(F, V)),
      Φ V hV (r • x) = r • Φ V hV x := by
    intro V hV r x
    apply LU V hV
    · rw [Scheme.Modules.Hom.app_smul, hΦα, hΦα, Scheme.Modules.Hom.app_smul]
    · intro e
      rw [Scheme.Modules.Hom.app_smul, hΦp, hΦp, Scheme.Modules.Hom.app_smul]
  let Φlin : ∀ V : Z.Opens, IsAffineOpen V → (Γ(F, V) →ₗ[Γ(Z, V)] Γ(M, V)) := fun V hV =>
    { toFun := Φ V hV
      map_add' := hadd V hV
      map_smul' := fun r x => by rw [RingHom.id_apply]; exact hsmul V hV r x }
  have hres : ∀ (V V' : Z.Opens) (hV : IsAffineOpen V) (hV' : IsAffineOpen V') (hle : V' ≤ V)
      (x : Γ(F, V)), Φlin V' hV' ((F.presheaf.map (homOfLE hle).op).hom x) =
        (M.presheaf.map (homOfLE hle).op).hom (Φlin V hV x) := by
    intro V V' hV hV' hle x
    show Φ V' hV' ((F.presheaf.map (homOfLE hle).op).hom x) =
        (M.presheaf.map (homOfLE hle).op).hom (Φ V hV x)
    apply LU V' hV'
    · rw [hΦα, nat, nat, hΦα]
    · intro e
      rw [hΦp, nat, nat, hΦp]
  obtain ⟨φ, hφ⟩ := wc_cn_modules_hom_of_affine Z F M Φlin hres
  have hφ' : ∀ (V : Z.Opens) (hV : IsAffineOpen V) (x : Γ(F, V)),
      Scheme.Modules.Hom.app φ V x = Φ V hV x := fun V hV x => hφ V hV x
  refine ⟨⟨φ, ?_, fun e => ?_⟩, ?_⟩
  · apply wc_cn_modules_hom_ext_affine
    intro U hU x
    rw [capp, hφ' U hU, hΦα]
  · apply wc_cn_modules_hom_ext_affine
    intro U hU x
    rw [capp, hφ' U hU, hΦp]
  · intro u u' huα hup
    apply wc_cn_modules_hom_ext_affine
    intro U hU x
    apply LU U hU
    · rw [← capp, ← capp]
      exact happ huα U x
    · intro e
      rw [← capp, ← capp]
      exact happ (hup e) U x

theorem wc_cn_compare_affine : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (J 𝔫 : Ideal A) (c t : ℕ) (Fv Hv Hn Mn : Type u) [AddCommGroup Fv] [Module A Fv] [Module.Finite A Fv] [AddCommGroup Hv] [Module A Hv] [AddCommGroup Hn] [Module A Hn] [AddCommGroup Mn] [Module A Mn] [Module.Finite A Mn] (Mq : ℕ → Type u) [∀ e, AddCommGroup (Mq e)] [∀ e, Module A (Mq e)] (φ : Fv →ₗ[A] Mn) (a : Fv →ₗ[A] Hv) (φH : Hv →ₗ[A] Hn) (α : Mn →ₗ[A] Hn) (p : ∀ e, Mn →ₗ[A] Mq e), (∀ x, a x = 0 → ∀ b ∈ J ^ c, b • x = 0) → (∀ y, ∀ b ∈ J ^ c, ∃ x, a x = b • y) → Function.Surjective φH → (∀ y, φH y = 0 ↔ y ∈ 𝔫 • (⊤ : Submodule A Hv)) → 𝔫 • (⊤ : Submodule A Mn) = ⊥ → (∀ m, α m = 0 → ∀ b ∈ J ^ t, b • m = 0) → (∀ x, α (φ x) = φH (a x)) → (∀ e m, p e m = 0 → m ∈ J ^ (e+1) • (⊤ : Submodule A Mn)) → (∀ e m, ∃ x, p e (φ x) = p e m) → (∀ e x, p e (φ x) = 0 → x ∈ 𝔫 • (⊤ : Submodule A Fv) ⊔ J ^ (e+1) • (⊤ : Submodule A Fv)) → Function.Surjective φ ∧ ∀ x, φ x = 0 ↔ x ∈ 𝔫 • (⊤ : Submodule A Fv) :=
by
  intro A _ _ J 𝔫 c t Fv Hv Hn Mn _ _ _ _ _ _ _ _ _ _ Mq _ _ φ a φH α p h1 h2 h3 h4 h5 h6 h7 h8 h9 h10

  have KR : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M]
      (P : Submodule A M) (x : M) (s : ℕ), (∀ r ∈ J ^ s, r • x ∈ P) →
      (∀ e : ℕ, x ∈ P ⊔ J ^ (e + 1) • (⊤ : Submodule A M)) → x ∈ P := by
    intro M _ _ _ P x s hs hd
    obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul J (P ⊔ Submodule.span A {x})
    obtain ⟨u, hu, j, hj, hx⟩ := Submodule.mem_sup.mp (hd (k + s))
    have hjn : j ∈ J ^ (k + s) • (⊤ : Submodule A M) :=
      Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ _)) hj
    have hjN : j ∈ P ⊔ Submodule.span A {x} := by
      have hj' : j = x - u := by rw [← hx]; abel
      rw [hj']
      exact Submodule.sub_mem _ (Submodule.mem_sup_right (Submodule.mem_span_singleton_self x))
        (Submodule.mem_sup_left hu)
    have hmem : j ∈ J ^ (k + s) • (⊤ : Submodule A M) ⊓ (P ⊔ Submodule.span A {x}) :=
      Submodule.mem_inf.mpr ⟨hjn, hjN⟩
    rw [hk (k + s) (Nat.le_add_right k s), Nat.add_sub_cancel_left] at hmem
    have hle : J ^ s • (J ^ k • (⊤ : Submodule A M) ⊓ (P ⊔ Submodule.span A {x})) ≤ P := by
      refine le_trans (Submodule.smul_mono le_rfl inf_le_right) ?_
      rw [Submodule.smul_sup]
      refine sup_le Submodule.smul_le_right ?_
      rw [Submodule.smul_le]
      intro r hr y hy
      obtain ⟨b, rfl⟩ := Submodule.mem_span_singleton.mp hy
      rw [smul_comm]
      exact P.smul_mem b (hs r hr)
    rw [← hx]
    exact P.add_mem hu (hle hmem)

  have mulT : ∀ (M : Type u) [AddCommGroup M] [Module A M] (P : Submodule A M) (x : M)
      (I1 I2 : Ideal A), (∀ b' ∈ I1, ∀ b ∈ I2, (b' * b) • x ∈ P) → ∀ r ∈ I1 * I2, r • x ∈ P := by
    intro M _ _ P x I1 I2 h r hr
    have hle : I1 * I2 ≤ Submodule.comap (LinearMap.toSpanSingleton A M x) P := by
      rw [Ideal.mul_le]
      intro b' hb' b hb
      rw [Submodule.mem_comap, LinearMap.toSpanSingleton_apply]
      exact h b' hb' b hb
    have h' := hle hr
    rwa [Submodule.mem_comap, LinearMap.toSpanSingleton_apply] at h'

  have hA : ∀ x ∈ 𝔫 • (⊤ : Submodule A Fv), φ x = 0 := by
    intro x hx
    refine Submodule.smul_induction_on (p := fun x => φ x = 0) hx ?_ ?_
    · intro r hr y _
      have hm : φ (r • y) ∈ 𝔫 • (⊤ : Submodule A Mn) := by
        rw [map_smul]; exact Submodule.smul_mem_smul hr Submodule.mem_top
      rw [h5] at hm
      exact (Submodule.mem_bot A).mp hm
    · intro y1 y2 e1 e2
      rw [map_add, e1, e2, add_zero]

  have hB : ∀ x, φ x = 0 → x ∈ 𝔫 • (⊤ : Submodule A Fv) := by
    intro x hx
    have hax : a x ∈ 𝔫 • (⊤ : Submodule A Hv) := (h4 _).mp (by rw [← h7, hx, map_zero])
    have hw : ∀ b ∈ J ^ c, ∃ w ∈ 𝔫 • (⊤ : Submodule A Fv), a w = b • a x := by
      intro b hb
      refine Submodule.smul_induction_on
        (p := fun y => ∃ w ∈ 𝔫 • (⊤ : Submodule A Fv), a w = b • y) hax ?_ ?_
      · intro r hr y _
        obtain ⟨f, hf⟩ := h2 y b hb
        refine ⟨r • f, Submodule.smul_mem_smul hr Submodule.mem_top, ?_⟩
        rw [map_smul, hf, smul_comm]
      · rintro y1 y2 ⟨w1, hw1, e1⟩ ⟨w2, hw2, e2⟩
        exact ⟨w1 + w2, Submodule.add_mem _ hw1 hw2, by rw [map_add, e1, e2, smul_add]⟩
    have htor : ∀ r ∈ J ^ (c + c), r • x ∈ 𝔫 • (⊤ : Submodule A Fv) := by
      rw [pow_add]
      refine mulT Fv _ x _ _ ?_
      intro b' hb' b hb
      obtain ⟨w, hw1, hw2⟩ := hw b hb
      have h0 : a (b • x - w) = 0 := by rw [map_sub, map_smul, hw2, sub_self]
      have h00 := h1 _ h0 b' hb'
      rw [smul_sub, sub_eq_zero] at h00
      rw [mul_smul, h00]
      exact Submodule.smul_mem _ b' hw1
    refine KR Fv _ x (c + c) htor ?_
    intro e
    exact h10 e x (by rw [hx, map_zero])

  have hC : Function.Surjective φ := by
    intro m
    have htor : ∀ r ∈ J ^ (t + c), r • m ∈ LinearMap.range φ := by
      rw [pow_add]
      refine mulT Mn _ m _ _ ?_
      intro b' hb' b hb
      obtain ⟨y, hy⟩ := h3 (α m)
      obtain ⟨f, hf⟩ := h2 y b hb
      have h0 : α (b • m - φ f) = 0 := by
        rw [map_sub, map_smul, h7, hf, map_smul, hy, sub_self]
      have h00 := h6 _ h0 b' hb'
      rw [smul_sub, sub_eq_zero] at h00
      rw [mul_smul, h00, ← map_smul]
      exact LinearMap.mem_range_self φ _
    have hm := KR Mn (LinearMap.range φ) m (t + c) htor (fun e => by
      obtain ⟨x, hx⟩ := h9 e m
      have hd := h8 e (m - φ x) (by rw [map_sub, hx, sub_self])
      exact Submodule.mem_sup.mpr ⟨φ x, LinearMap.mem_range_self φ x, m - φ x, hd, by abel⟩)
    exact LinearMap.mem_range.mp hm
  exact ⟨hC, fun x => ⟨hB x, hA x⟩⟩

theorem wc_cn_088A_compare : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) [IsNoetherian Z] (h : Z ⟶ Spec (.of B)) (𝒦 𝒥 : Z.IdealSheafData)
    (Fs : ℕ → Z.Modules) (ψ : ∀ n, Fs (n + 1) ⟶ Fs n) (H : Z.Modules) (Hs : ℕ → Z.Modules)
    (ψH : ∀ n, Hs (n + 1) ⟶ Hs n) (φH : ∀ n, H ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n) (t : ℕ)
    (Q : wcCn088AQuot h (IsLocalRing.maximalIdeal B) 𝒦 𝒥 Fs ψ Hs ψH α)
    (L : wcCn088ALayers Q H φH) (F : Z.Modules) (a : F ⟶ H) (φF : ∀ e, F ⟶ L.G e) (c' : ℕ),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψ →
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Hs ψH →
    wcCnAlg h (IsLocalRing.maximalIdeal B) Hs ψH H φH →
    (∀ n, α (n + 1) ≫ ψH n = ψ n ≫ α n) → (∀ n, wcCnAlmostIso 𝒥 t (α n)) →
    wcCnJAlg 𝒥 L.G L.τ F φF → (∀ e, φF e ≫ L.β e = a ≫ L.q e) → wcCnAlmostIso 𝒥 c' a →
    ∃ (M : Z.Modules) (φ : ∀ n, M ⟶ Fs n), wcCnAlg h (IsLocalRing.maximalIdeal B) Fs ψ M φ :=
by
  intro B _ _ _ Z _ h 𝒦 𝒥 Fs ψ H Hs ψH φH α t Q L F a φF c' hF _hHs hHalg hα hαi hFalg hFβ ha

  have capp : ∀ {P R S : Z.Modules} (f : P ⟶ R) (k : R ⟶ S) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ k) U x =
        Scheme.Modules.Hom.app k U (Scheme.Modules.Hom.app f U x) := by
    intro P R S f k U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have happ : ∀ {P R : Z.Modules} {f g : P ⟶ R}, f = g → ∀ (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app f U x = Scheme.Modules.Hom.app g U x := by
    rintro P R f g rfl U x
    rfl
  have smapp : ∀ {P R : Z.Modules} (f : P ⟶ R) (U : Z.Opens) (r : Γ(Z, U)) (x : Γ(P, U)),
      Scheme.Modules.Hom.app f U (r • x) = r • Scheme.Modules.Hom.app f U x :=
    fun f U r x => Scheme.Modules.Hom.app_smul f r x
  have hnoeth : ∀ (V : Z.Opens), IsAffineOpen V → IsNoetherianRing Γ(Z, V) := fun V hV =>
    IsLocallyNoetherian.component_noetherian ⟨V, hV⟩

  have hcart : ∀ n (V : Z.Opens), IsAffineOpen V →
      (∀ m : Γ(Fs n, V), Scheme.Modules.Hom.app (α n) V m = 0 →
        (∀ e, Scheme.Modules.Hom.app (Q.pF e n) V m = 0) → m = 0) ∧
      (∀ (y : Γ(Hs n, V)) (z : ∀ e, Γ(Q.Fq e n, V)),
        (∀ e, Scheme.Modules.Hom.app (Q.τF e n) V (z (e + 1)) = z e) →
        (∀ e, Scheme.Modules.Hom.app (Q.αq e n) V (z e) =
          Scheme.Modules.Hom.app (Q.pH e n) V y) →
        ∃ m : Γ(Fs n, V), Scheme.Modules.Hom.app (α n) V m = y ∧
          ∀ e, Scheme.Modules.Hom.app (Q.pF e n) V m = z e) := by
    intro n V hV
    haveI := hnoeth V hV
    haveI : Module.Finite Γ(Z, V) Γ(Fs n, V) := (hF.1 n).2 V hV
    exact wc_cn_adic_cartesian Γ(Z, V) (𝒥.ideal ⟨V, hV⟩) t Γ(Fs n, V) Γ(Hs n, V)
      (fun e => Γ(Q.Fq e n, V)) (fun e => Γ(Q.Hq e n, V))
      (wcCnSecLin (α n) V) (fun e => wcCnSecLin (Q.pF e n) V)
      (fun e => wcCnSecLin (Q.pH e n) V)
      (fun e => wcCnSecLin (Q.τF e n) V) (fun e => wcCnSecLin (Q.αq e n) V)
      (hαi n V hV).1 (hαi n V hV).2
      (fun e => ((Q.pF_jalg n).2.2 e V hV).1)
      (fun e => ((Q.pF_jalg n).2.2 e V hV).2)
      (fun e => ((Q.pH_jalg n).2.2 e V hV).2)
      (fun e m => (capp (Q.pF (e + 1) n) (Q.τF e n) V m).symm.trans
        (happ ((Q.pF_jalg n).2.1 e) V m))
      (fun e m => (capp (Q.pF e n) (Q.αq e n) V m).symm.trans
        ((happ (Q.pF_α e n) V m).trans (capp (α n) (Q.pH e n) V m)))

  have hlift : ∀ n, (∃ φ : F ⟶ Fs n, φ ≫ α n = a ≫ φH n ∧
      ∀ e, φ ≫ Q.pF e n = φF e ≫ L.χ e n) ∧
      (∀ u u' : F ⟶ Fs n, u ≫ α n = u' ≫ α n → (∀ e, u ≫ Q.pF e n = u' ≫ Q.pF e n) →
        u = u') := by
    intro n
    refine wc_cn_modules_cartesian_lift Z (Fs n) (Hs n) (fun e => Q.Fq e n) (fun e => Q.Hq e n)
      (fun e => Q.τF e n) (fun e => Q.τH e n) (α n) (fun e => Q.pF e n) (fun e => Q.pH e n)
      (fun e => Q.αq e n) (Q.pF_jalg n).2.1 (Q.pH_jalg n).2.1 (fun e => Q.αq_τ e n)
      (fun e => Q.pF_α e n) (fun V hV => (hcart n V hV).1) (fun V hV => (hcart n V hV).2)
      F (a ≫ φH n) (fun e => φF e ≫ L.χ e n) ?_ ?_
    · intro e
      simp only [Category.assoc]
      rw [← L.τ_χ e n, ← Category.assoc, hFalg.2.1 e]
    · intro e
      simp only [Category.assoc]
      rw [← L.β_χ e n, ← Category.assoc, hFβ e, Category.assoc, L.q_χH e n]
  choose φ hφ1 hφ2 using fun n => (hlift n).1
  refine ⟨F, φ, hFalg.1, ?_, ?_⟩

  · intro n
    apply (hlift n).2
    · rw [Category.assoc, ← hα n, ← Category.assoc, hφ1 (n + 1), Category.assoc,
        hHalg.2.1 n, hφ1 n]
    · intro e
      rw [Category.assoc, ← Q.pF_ψ e n, ← Category.assoc, hφ2 (n + 1) e, Category.assoc,
