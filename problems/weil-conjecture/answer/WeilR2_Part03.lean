      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Scheme.Modules.Hom.app_smul, Scheme.Modules.Hom.app_smul, hx i n, ← sub_eq_zero,
        ← sub_smul]
      exact hkF n _ (hd i n) _
    · beta_reduce
      rw [map_sum, hyd n, Finset.smul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Scheme.Modules.Hom.app_smul, Scheme.Modules.Hom.app_smul, hαx i n,
        smul_smul (f ^ (∑ j, e j - e i)), hfe i]
