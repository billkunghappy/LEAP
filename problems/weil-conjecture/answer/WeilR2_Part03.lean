theorem wc_cn_0888_affine : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u})
    [IsLocallyNoetherian Z] (h : Z ⟶ Spec (.of B)) (Fs : ℕ → Z.Modules)
    (ψ : ∀ n, Fs (n + 1) ⟶ Fs n) (H : Z.Modules) (Hs : ℕ → Z.Modules)
    (ψH : ∀ n, Hs (n + 1) ⟶ Hs n) (φH : ∀ n, H ⟶ Hs n) (α : ∀ n, Fs n ⟶ Hs n),
