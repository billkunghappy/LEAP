  ·
    have m1 : (g.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
        ((E.obj.map (wcTorsorAct p ht.etale (a c) (ht.act_p c)).op).hom s) =
        (((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))).obj.map
            (wcTorsorAct p ht.etale (a c) (ht.act_p c)).op).hom
          ((g.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom s) :=
      NatTrans.naturality_apply g.hom (wcTorsorAct p ht.etale (a c) (ht.act_p c)).op s
    have m2 : (g.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
        ((f.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
          ((νL.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
            (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcTorsorEt p ht.etale) (ULift.up c)))) = 0 := by
      have h := ConcreteCategory.congr_hom (NatTrans.congr_app
        ((sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).congr_map hfg)
        (Opposite.op (wcTorsorEt p ht.etale)))
        ((νL.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
            (wcConstSec Y (ULift.{u+1} (ZMod m)) (wcTorsorEt p ht.etale) (ULift.up c)))
