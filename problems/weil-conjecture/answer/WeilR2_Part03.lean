        (Limits.pullback.map T'.hom (ι ≫ p) T'.hom p (𝟙 T'.left) ι (𝟙 Y)
          ((Category.comp_id _).trans (Category.id_comp _).symm) (Category.comp_id _) x) R ∈
        wcSmeWit p U V g m k Θ (ι (Limits.pullback.snd T'.hom (ι ≫ p) x)) :=
      ⟨T', d, R, _, hR, hz, rfl⟩
    rw [hkill _ hx _ hmem]
    rfl
  have hgτ := c5 Y U V g (wcLCPb (ι ≫ p) (ULift.{u+1} (ZMod m))) τ₀ hK
  refine ⟨W, ι ≫ p, inferInstance, Limits.cokernel.desc g _ hgτ ≫ e.hom, ?_⟩
  intro T R hφ w hw
  have hcomp : Limits.cokernel.π g ≫ (Limits.cokernel.desc g _ hgτ ≫ e.hom) =
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map τ₀ ≫ e.hom) ≫
        e.inv ≫ e.hom := by
    rw [← Category.assoc, Limits.cokernel.π_desc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have h2 : ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map τ₀ ≫ e.hom) ≫
      e.inv ≫ e.hom).hom.app (Opposite.op T)).hom (wcSmeGen U T R) = 0 := by
    rw [← hcomp]; exact hφ
  have h3 : ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map τ₀ ≫ e.hom) ≫
      e.inv).hom.app (Opposite.op T)).hom (wcSmeGen U T R) = 0 := by
    have h2' := h2
    rw [← Category.assoc] at h2'
    change (e.hom.hom.app (Opposite.op T)).hom _ = 0 at h2'
    have := congrArg (e.inv.hom.app (Opposite.op T)).hom h2'
    rw [map_zero] at this
    change ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map τ₀ ≫ e.hom) ≫
      e.inv ≫ e.hom ≫ e.inv).hom.app (Opposite.op T)).hom (wcSmeGen U T R) = 0 at this
    rwa [Iso.hom_inv_id, Category.comp_id] at this
  rw [Category.assoc, Iso.hom_inv_id, Category.comp_id] at h3
  have h4 : ((toSheafify (Scheme.smallEtaleTopology Y) (wcLCPb (ι ≫ p) (ULift.{u+1} (ZMod m)))).app
      (Opposite.op T)).hom ((τ₀.app (Opposite.op T)).hom R) = 0 := by
    have hnat := congrArg (fun φ => (φ.app (Opposite.op T)).hom R)
      (toSheafify_naturality (Scheme.smallEtaleTopology Y) τ₀)
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp] at hnat
    erw [hnat]
    exact h3
  have h5 := c2 Y W (ι ≫ p) (ULift.{u+1} (ZMod m)) T _ h4
  haveI : Mono (𝟙 Y) := inferInstance
  have hr := Scheme.Pullback.range_map T.hom (ι ≫ p) T.hom p (𝟙 T.left) ι (𝟙 Y)
    ((Category.comp_id _).trans (Category.id_comp _).symm) (Category.comp_id _)
  have hw' : w ∈ Set.range (Limits.pullback.map T.hom (ι ≫ p) T.hom p (𝟙 T.left) ι (𝟙 Y)
      ((Category.comp_id _).trans (Category.id_comp _).symm) (Category.comp_id _)) := by
    rw [hr]
    refine ⟨⟨Limits.pullback.fst T.hom p w, rfl⟩, ?_⟩
    change Limits.pullback.snd T.hom p w ∈ Set.range ι
    rw [hrange]
    exact subset_closure hw
  obtain ⟨x, rfl⟩ := hw'
  have h6 := hτ₀ T R x
  have h7 := congrArg (fun y : LocallyConstant ↥(Limits.pullback T.hom (ι ≫ p))
    (ULift.{u+1} (ZMod m)) => y x) h5
  have h8 : ULift.up (f (wcSmePieceVec p U m k Θ T _ R)) = (0 : ULift.{u+1} (ZMod m)) :=
    h6.symm.trans h7
  exact congrArg ULift.down h8

theorem wc_free_cokernel_local_lift : ∀ (Y : Scheme.{u}) (U V : Y.Etale)
    (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    (T : Y.Etale) (s : (Limits.cokernel g).obj.obj (Opposite.op T)) (t : T.left),
    ∃ (T₁ : Y.Etale) (c₁ : T₁ ⟶ T) (t₁ : T₁.left) (R : FreeAbelianGroup (ULift.{u+1} (T₁ ⟶ U))),
      c₁.left t₁ = t ∧
      ((Limits.cokernel.π g).hom.app (Opposite.op T₁)).hom (wcSmeGen U T₁ R) =
        ((Limits.cokernel g).obj.map c₁.op).hom s :=
by
  intro Y U V g T s t
  classical
  have gen : ∀ (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] [P.IsMultiplicative]
      (S : Scheme.{u}) (X : P.Over ⊤ S) (R : Sieve X),
      R ∈ Scheme.smallGrothendieckTopology P S X → ∀ v : X.left,
      ∃ (X₁ : P.Over ⊤ S) (c : X₁ ⟶ X), R.arrows c ∧ v ∈ Set.range c.left := by
    intro P _ _ S X R hR v
    obtain ⟨𝒰, hO, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology X R).mp hR
    obtain ⟨i, y, hy⟩ := 𝒰.exists_eq v
    refine ⟨_, _, hle _ _ (Presieve.ofArrows.mk i), y, ?_⟩
    exact hy
  have s1 : ∀ (X : Y.Etale) (R : Sieve X), R ∈ Scheme.smallEtaleTopology Y X →
      ∀ v : X.left, ∃ (X₁ : Y.Etale) (c : X₁ ⟶ X), R.arrows c ∧ v ∈ Set.range c.left :=
    fun X R hR v => gen _ Y X R hR v

  haveI hπ : Sheaf.IsLocallySurjective (Limits.cokernel.π g) :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (Limits.cokernel.π g)).mpr
      inferInstance
  have hS1 : Presheaf.imageSieve (Limits.cokernel.π g).hom s ∈ Scheme.smallEtaleTopology Y T :=
    Presheaf.imageSieve_mem _ _ s
  obtain ⟨T₀, c₀, ⟨x, hx⟩, t₀, ht₀⟩ := s1 T _ hS1 t

  let ε := toSheafify (Scheme.smallEtaleTopology Y)
    (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
  haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) ε :=
    Presheaf.isLocallySurjective_toSheafify' _ _
  have hS2 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) ε x
  obtain ⟨T₁, c', ⟨R, hR⟩, t₁, ht₁⟩ := s1 T₀ _ hS2 t₀
  refine ⟨T₁, c' ≫ c₀, t₁, R, ?_, ?_⟩
  · change c₀.left (c'.left t₁) = t
    rw [ht₁, ht₀]
  · have hR' : wcSmeGen U T₁ R =
        (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map c'.op).hom x := hR
    have hx' : ((Limits.cokernel.π g).hom.app (Opposite.op T₀)).hom x =
        ((Limits.cokernel g).obj.map c₀.op).hom s := hx
    have hnat : ((Limits.cokernel.π g).hom.app (Opposite.op T₁)).hom
        ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map c'.op).hom x) =
        ((Limits.cokernel g).obj.map c'.op).hom
          (((Limits.cokernel.π g).hom.app (Opposite.op T₀)).hom x) :=
      NatTrans.naturality_apply (Limits.cokernel.π g).hom c'.op x
    rw [hR', hnat, hx', op_comp, Functor.map_comp, AddCommGrpCat.hom_comp,
      AddMonoidHom.comp_apply]

theorem wc_split_witness_realize : ∀ {Y Z : Scheme.{u}} (p : Z ⟶ Y) (U V : Y.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) (m k : ℕ) (Θ : Fin k → Set ↥(Limits.pullback U.hom p)) (z : Z) (v : Fin k → ZMod m), v ∈ AddSubgroup.closure (wcSmeWit p U V g m k Θ z) → ∀ (T : Y.Etale) (w : ↥(Limits.pullback T.hom p)), Limits.pullback.snd T.hom p w = z → ∃ (T'' : Y.Etale) (c : T'' ⟶ T) (w'' : ↥(Limits.pullback T''.hom p)) (R₀ : FreeAbelianGroup (ULift.{u+1} (T'' ⟶ U))), Limits.pullback.map T''.hom p T.hom p c.left (𝟙 Z) (𝟙 Y) ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm) ((Category.comp_id _).trans (Category.id_comp _).symm) w'' = w ∧ ((Limits.cokernel.π g).hom.app (Opposite.op T'')).hom (wcSmeGen U T'' R₀) = 0 ∧ wcSmePieceVec p U m k Θ T'' w'' R₀ = v :=
by
  intro Y Z p U V g m k Θ z v hv
  classical

  have hgen : ∀ (T T' : Y.Etale) (h : T' ⟶ T) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      wcSmeGen U T' (FreeAbelianGroup.map
        (fun c : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (h ≫ c.down)) R) =
      (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map h.op).hom
        (wcSmeGen U T R) := by
    intro T T' h R
    exact NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Y)
      (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) h.op R
  have hA1 : ∀ (T T' : Y.Etale) (h : T' ⟶ T) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      ((Limits.cokernel.π g).hom.app (Opposite.op T')).hom (wcSmeGen U T' (FreeAbelianGroup.map
        (fun c : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (h ≫ c.down)) R)) =
      ((Limits.cokernel g).obj.map h.op).hom
        (((Limits.cokernel.π g).hom.app (Opposite.op T)).hom (wcSmeGen U T R)) := by
    intro T T' h R
    rw [hgen]
    exact NatTrans.naturality_apply (Limits.cokernel.π g).hom h.op _

  have hsnd : ∀ (A B : Y.Etale) (c : A ⟶ B) (x : ↥(Limits.pullback A.hom p)),
      Limits.pullback.snd B.hom p (Limits.pullback.map A.hom p B.hom p c.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x) =
      Limits.pullback.snd A.hom p x := by
    intro A B c x
    rw [← Scheme.Hom.comp_apply]
    erw [Limits.pullback.lift_snd, Category.comp_id]
  have hcomp : ∀ (A B C : Y.Etale) (c : A ⟶ B) (d : B ⟶ C) (e : A ⟶ C),
      e.left = c.left ≫ d.left → ∀ (x : ↥(Limits.pullback A.hom p)),
      Limits.pullback.map A.hom p C.hom p e.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w e).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x =
      Limits.pullback.map B.hom p C.hom p d.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w d).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm)
        (Limits.pullback.map A.hom p B.hom p c.left (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
          ((Category.comp_id _).trans (Category.id_comp _).symm) x) := by
    intro A B C c d e he x
    rw [← Scheme.Hom.comp_apply]
    refine congrArg (fun f : Limits.pullback A.hom p ⟶ Limits.pullback C.hom p => f x) ?_
    apply Limits.pullback.hom_ext
    · rw [Category.assoc]
      erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst, ← Category.assoc,
        Limits.pullback.lift_fst, Category.assoc, he]
    · rw [Category.assoc]
      erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd, ← Category.assoc,
        Limits.pullback.lift_snd]
      simp only [Category.comp_id]
  have hid : ∀ (A : Y.Etale) (x : ↥(Limits.pullback A.hom p)),
      Limits.pullback.map A.hom p A.hom p (𝟙 A : A ⟶ A).left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w (𝟙 A)).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x = x := by
    intro A x
    have h : Limits.pullback.map A.hom p A.hom p (𝟙 A : A ⟶ A).left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w (𝟙 A)).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · erw [Limits.pullback.lift_fst]
        exact (Category.comp_id _).trans (Category.id_comp _).symm
      · erw [Limits.pullback.lift_snd]
        exact (Category.comp_id _).trans (Category.id_comp _).symm
    rw [h]
    rfl

  have hpv : ∀ (T T' : Y.Etale) (h : T' ⟶ T) (x : ↥(Limits.pullback T'.hom p))
      (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      wcSmePieceVec p U m k Θ T' x (FreeAbelianGroup.map
        (fun c : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (h ≫ c.down)) R) =
      wcSmePieceVec p U m k Θ T (Limits.pullback.map T'.hom p T.hom p h.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w h).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x) R := by
    intro T T' h x R
    induction R using FreeAbelianGroup.induction_on with
    | zero => simp only [map_zero]
    | of c =>
      rw [FreeAbelianGroup.map_of_apply]
      unfold wcSmePieceVec
      rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
      funext a
      simp only
      rw [hcomp T' T U h c.down (h ≫ c.down) (MorphismProperty.Comma.comp_left _ _) x]
    | neg c ih => rw [map_neg, map_neg, map_neg, ih]
    | add a b ha hb => rw [map_add, map_add, map_add, ha, hb]

  have hγ : ((Limits.cokernel.π g).hom.app (Opposite.op V)).hom
      ((g.hom.app (Opposite.op V)).hom (wcSmeGen V V (FreeAbelianGroup.of (ULift.up (𝟙 V))))) = 0 := by
    change ((g ≫ Limits.cokernel.π g).hom.app (Opposite.op V)).hom _ = 0
    rw [Limits.cokernel.condition]
    rfl

  have hpair : ∀ (T₁ T₂ : Y.Etale) (w₁ : ↥(Limits.pullback T₁.hom p))
      (w₂ : ↥(Limits.pullback T₂.hom p)),
      Limits.pullback.snd T₁.hom p w₁ = Limits.pullback.snd T₂.hom p w₂ →
      ∃ (T₃ : Y.Etale) (c₁ : T₃ ⟶ T₁) (c₂ : T₃ ⟶ T₂) (w₃ : ↥(Limits.pullback T₃.hom p)),
        Limits.pullback.map T₃.hom p T₁.hom p c₁.left (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w c₁).symm)
          ((Category.comp_id _).trans (Category.id_comp _).symm) w₃ = w₁ ∧
        Limits.pullback.map T₃.hom p T₂.hom p c₂.left (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w c₂).symm)
          ((Category.comp_id _).trans (Category.id_comp _).symm) w₃ = w₂ := by
    intro T₁ T₂ w₁ w₂ h12
    obtain ⟨q, hq1, hq2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.snd T₁.hom p) (g := Limits.pullback.snd T₂.hom p) w₁ w₂ h12
    have H1 : (Limits.pullback.fst (Limits.pullback.snd T₁.hom p) (Limits.pullback.snd T₂.hom p) ≫
          Limits.pullback.fst T₁.hom p) ≫ T₁.hom =
        (Limits.pullback.snd (Limits.pullback.snd T₁.hom p) (Limits.pullback.snd T₂.hom p) ≫
          Limits.pullback.fst T₂.hom p) ≫ T₂.hom := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition (f := T₁.hom) (g := p),
        Limits.pullback.condition (f := T₂.hom) (g := p),
        Limits.pullback.condition_assoc (f := Limits.pullback.snd T₁.hom p)
          (g := Limits.pullback.snd T₂.hom p)]
    have H2 : Limits.pullback.lift _ _ H1 ≫ (Limits.pullback.fst T₁.hom T₂.hom ≫ T₁.hom) =
        (Limits.pullback.fst (Limits.pullback.snd T₁.hom p) (Limits.pullback.snd T₂.hom p) ≫
          Limits.pullback.snd T₁.hom p) ≫ p := by
      rw [Limits.pullback.lift_fst_assoc, Category.assoc, Category.assoc,
        Limits.pullback.condition (f := T₁.hom) (g := p)]
    refine ⟨MorphismProperty.Over.mk ⊤ (Limits.pullback.fst T₁.hom T₂.hom ≫ T₁.hom) inferInstance,
      MorphismProperty.Over.homMk (Limits.pullback.fst T₁.hom T₂.hom) rfl trivial,
      MorphismProperty.Over.homMk (Limits.pullback.snd T₁.hom T₂.hom)
        Limits.pullback.condition.symm trivial,
      Limits.pullback.lift (Limits.pullback.lift _ _ H1) _ H2 q, ?_, ?_⟩
    · refine (Scheme.Hom.comp_apply _ _ q).symm.trans (Eq.trans (congrArg
        (fun f : Limits.pullback (Limits.pullback.snd T₁.hom p) (Limits.pullback.snd T₂.hom p) ⟶
          Limits.pullback T₁.hom p => f q) ?_) hq1)
      apply Limits.pullback.hom_ext
      · erw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst]
        exact Limits.pullback.lift_fst _ _ _
      · erw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id]
        exact Limits.pullback.lift_snd _ _ _
    · refine (Scheme.Hom.comp_apply _ _ q).symm.trans (Eq.trans (congrArg
        (fun f : Limits.pullback (Limits.pullback.snd T₁.hom p) (Limits.pullback.snd T₂.hom p) ⟶
          Limits.pullback T₂.hom p => f q) ?_) hq2)
      apply Limits.pullback.hom_ext
      · erw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst]
        exact Limits.pullback.lift_snd _ _ _
      · erw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id, Limits.pullback.lift_snd]
        exact Limits.pullback.condition

  induction hv using AddSubgroup.closure_induction with
  | mem x hx =>
    intro T w hw
    obtain ⟨T', d, R', w', hR', hw', hxv⟩ := hx
    obtain ⟨T₃, c₁, c₂, w₃, h1, h2⟩ := hpair T T' w w' (hw.trans hw'.symm)
    refine ⟨T₃, c₁, w₃, FreeAbelianGroup.map
      (fun c : ULift.{u+1} (T' ⟶ U) => ULift.up.{u+1} (c₂ ≫ c.down)) R', h1, ?_, ?_⟩
    · have e1 : ((Limits.cokernel.π g).hom.app (Opposite.op T')).hom
          ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map d.op).hom
            ((g.hom.app (Opposite.op V)).hom
              (wcSmeGen V V (FreeAbelianGroup.of (ULift.up (𝟙 V)))))) =
          ((Limits.cokernel g).obj.map d.op).hom
            (((Limits.cokernel.π g).hom.app (Opposite.op V)).hom
              ((g.hom.app (Opposite.op V)).hom
                (wcSmeGen V V (FreeAbelianGroup.of (ULift.up (𝟙 V)))))) :=
        NatTrans.naturality_apply (Limits.cokernel.π g).hom d.op _
      rw [hA1 T' T₃ c₂ R', hR', e1, hγ, map_zero, map_zero]
    · rw [hpv T' T₃ c₂ w₃ R', h2]
      exact hxv
  | zero =>
    intro T w hw
    exact ⟨T, 𝟙 T, w, 0, hid T w, by rw [map_zero, map_zero], map_zero _⟩
  | add x y _ _ ihx ihy =>
    intro T w hw
    obtain ⟨T₁, c₁, w₁, R₁, hb1, hπ1, hv1⟩ := ihx T w hw
    have hz1 : Limits.pullback.snd T₁.hom p w₁ = z := by
      rw [← hsnd T₁ T c₁ w₁, hb1]
      exact hw
    obtain ⟨T₂, c₂, w₂, R₂, hb2, hπ2, hv2⟩ := ihy T₁ w₁ hz1
    refine ⟨T₂, c₂ ≫ c₁, w₂, FreeAbelianGroup.map
      (fun c : ULift.{u+1} (T₁ ⟶ U) => ULift.up.{u+1} (c₂ ≫ c.down)) R₁ + R₂, ?_, ?_, ?_⟩
    · rw [hcomp T₂ T₁ T c₂ c₁ (c₂ ≫ c₁) (MorphismProperty.Comma.comp_left _ _) w₂, hb2, hb1]
    · rw [map_add, map_add, hA1, hπ1, hπ2, map_zero, add_zero]
    · rw [map_add, hpv, hb2, hv1, hv2]
  | neg x _ ihx =>
    intro T w hw
    obtain ⟨T'', c, w'', R₀, hb, hπ, hv0⟩ := ihx T w hw
    exact ⟨T'', c, w'', -R₀, hb, by rw [map_neg, map_neg, hπ, neg_zero], by rw [map_neg, hv0]⟩

theorem wc_split_vector_zero_mtorsion : ∀ {Y Z : Scheme.{u}} (p : Z ⟶ Y) (U : Y.Etale) (O : Z.Opens) (k : ℕ) (ua : Fin k → ((O : Scheme.{u}) ⟶ U.left)) (hu : ∀ a, ua a ≫ U.hom = O.ι ≫ p), (∀ a, IsOpenImmersion (Limits.pullback.lift (ua a) O.ι (hu a))) → ∀ (Θ : Fin k → Set ↥(Limits.pullback U.hom p)), (∀ x, ∃! a, x ∈ Θ a) → (∀ a, Set.range (Limits.pullback.lift (ua a) O.ι (hu a)) = Θ a ∩ (Limits.pullback.snd U.hom p) ⁻¹' (O : Set Z)) → ∀ (m : ℕ) (T : Y.Etale) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))) (w : ↥(Limits.pullback T.hom p)), Limits.pullback.snd T.hom p w ∈ (O : Set Z) → wcSmePieceVec p U m k Θ T w R = 0 → ∃ (N : T.left.Opens) (y : FreeAbelianGroup (ULift.{u+1} (wcEtOpen Y T N ⟶ U))), Limits.pullback.fst T.hom p w ∈ N ∧ FreeAbelianGroup.map (fun c : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (wcEtOpenι Y T N ≫ c.down)) R = m • y :=
by
  intro Y Z p U O k ua hu hΓ Θ hΘ hΘrange m T R w hzO hPV
  classical

  let α : (T ⟶ U) → (Limits.pullback T.hom p ⟶ Limits.pullback U.hom p) := fun c =>
    Limits.pullback.map T.hom p U.hom p c.left (𝟙 Z) (𝟙 Y)
      ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
      ((Category.comp_id _).trans (Category.id_comp _).symm)
  have hαs : ∀ c : T ⟶ U, α c ≫ Limits.pullback.snd U.hom p = Limits.pullback.snd T.hom p :=
    fun c => (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  have hαf : ∀ c : T ⟶ U,
      α c ≫ Limits.pullback.fst U.hom p = Limits.pullback.fst T.hom p ≫ c.left :=
    fun c => Limits.pullback.lift_fst _ _ _

  have hgeo : ∀ (a : Fin k) (c c' : T ⟶ U), α c w ∈ Θ a → α c' w ∈ Θ a →
      ∃ N : T.left.Opens, Limits.pullback.fst T.hom p w ∈ N ∧ N.ι ≫ c.left = N.ι ≫ c'.left := by
    intro a c c' hc hc'
    obtain ⟨Γ, hΓeq⟩ : ∃ Γ, Γ = Limits.pullback.lift (ua a) O.ι (hu a) := ⟨_, rfl⟩
    haveI : IsOpenImmersion Γ := by rw [hΓeq]; exact hΓ a
    have hΓs : Γ ≫ Limits.pullback.snd U.hom p = O.ι := by
      rw [hΓeq]; exact Limits.pullback.lift_snd _ _ _
    have hΓr : Set.range Γ = Θ a ∩ (Limits.pullback.snd U.hom p) ⁻¹' (O : Set Z) := by
      rw [hΓeq]; exact hΘrange a
    have hmemR : ∀ (d : T ⟶ U) (x : ↥(Limits.pullback T.hom p)), α d x ∈ Θ a →
        Limits.pullback.snd T.hom p x ∈ (O : Set Z) → α d x ∈ Set.range Γ := by
      intro d x hd hx
      rw [hΓr]
      refine ⟨hd, ?_⟩
      show Limits.pullback.snd U.hom p (α d x) ∈ (O : Set Z)
      rw [← Scheme.Hom.comp_apply, hαs]
      exact hx
    obtain ⟨Q, hQ⟩ : ∃ Q : (Limits.pullback T.hom p).Opens,
        Q = α c ⁻¹ᵁ Γ.opensRange ⊓ α c' ⁻¹ᵁ Γ.opensRange := ⟨_, rfl⟩
    have hQmem : ∀ x, x ∈ Q ↔ α c x ∈ Set.range Γ ∧ α c' x ∈ Set.range Γ := by
      intro x
      rw [hQ, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage,
        ← Scheme.Hom.coe_opensRange Γ]
      exact Iff.rfl
    have hwQ : w ∈ Q := (hQmem w).2 ⟨hmemR c w hc hzO, hmemR c' w hc' hzO⟩
    have hlift : ∀ d : T ⟶ U, (∀ x, x ∈ Q → α d x ∈ Set.range Γ) →
        ∃ κ : (Q : Scheme.{u}) ⟶ (O : Scheme.{u}), κ ≫ Γ = Q.ι ≫ α d := by
      intro d hd
      have hr : Set.range (Q.ι ≫ α d) ⊆ Set.range Γ := by
        rintro _ ⟨q, rfl⟩
        rw [Scheme.Hom.comp_apply]
        apply hd
        have h0 : Q.ι q ∈ Set.range Q.ι := ⟨q, rfl⟩
        rw [Scheme.Opens.range_ι] at h0
        exact h0
      exact ⟨_, IsOpenImmersion.lift_fac Γ (Q.ι ≫ α d) hr⟩
    obtain ⟨κ, hκ⟩ := hlift c (fun x hx => ((hQmem x).1 hx).1)
    obtain ⟨κ', hκ'⟩ := hlift c' (fun x hx => ((hQmem x).1 hx).2)
    have e1 : κ ≫ O.ι = Q.ι ≫ Limits.pullback.snd T.hom p := by
      calc κ ≫ O.ι = κ ≫ Γ ≫ Limits.pullback.snd U.hom p := by rw [hΓs]
        _ = (Q.ι ≫ α c) ≫ Limits.pullback.snd U.hom p := by rw [← Category.assoc, hκ]
        _ = Q.ι ≫ Limits.pullback.snd T.hom p := by rw [Category.assoc, hαs]
    have e2 : κ' ≫ O.ι = Q.ι ≫ Limits.pullback.snd T.hom p := by
      calc κ' ≫ O.ι = κ' ≫ Γ ≫ Limits.pullback.snd U.hom p := by rw [hΓs]
        _ = (Q.ι ≫ α c') ≫ Limits.pullback.snd U.hom p := by rw [← Category.assoc, hκ']
        _ = Q.ι ≫ Limits.pullback.snd T.hom p := by rw [Category.assoc, hαs]
    have hκκ : κ = κ' := (cancel_mono O.ι).1 (e1.trans e2.symm)
    have hQe : Q.ι ≫ α c = Q.ι ≫ α c' := by rw [← hκ, ← hκ', hκκ]
    obtain ⟨ρ, hρdef⟩ : ∃ ρ : (Q : Scheme.{u}) ⟶ T.left,
        ρ = Q.ι ≫ Limits.pullback.fst T.hom p := ⟨_, rfl⟩
    have hρ : ρ ≫ c.left = ρ ≫ c'.left := by
      rw [hρdef, Category.assoc, Category.assoc, ← hαf, ← hαf, ← Category.assoc,
        ← Category.assoc, hQe]
    obtain ⟨wQ, hwQ'⟩ : ∃ wQ : Q, Q.ι wQ = w := ⟨⟨w, hwQ⟩, by rw [Scheme.Opens.ι_apply]⟩
    have hρw : ρ wQ = Limits.pullback.fst T.hom p w := by
      rw [hρdef]
      exact (Scheme.Hom.comp_apply Q.ι (Limits.pullback.fst T.hom p) wQ).trans
        (congrArg (Limits.pullback.fst T.hom p) hwQ')
    haveI : Etale U.hom := U.prop
    have hcU : c.left ≫ U.hom = c'.left ≫ U.hom := by
      rw [MorphismProperty.Over.w c, MorphismProperty.Over.w c']
    obtain ⟨D, hDf, hDs⟩ : ∃ D : T.left ⟶ Limits.pullback U.hom U.hom,
        D ≫ Limits.pullback.fst U.hom U.hom = c.left ∧
        D ≫ Limits.pullback.snd U.hom U.hom = c'.left :=
      ⟨Limits.pullback.lift c.left c'.left hcU, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hkey : ρ ≫ D = (ρ ≫ c.left) ≫ Limits.pullback.diagonal U.hom := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hDf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hDs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hρ]
    refine ⟨D ⁻¹ᵁ (Limits.pullback.diagonal U.hom).opensRange, ?_, ?_⟩
    · rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      have h1 : D (ρ wQ) = Limits.pullback.diagonal U.hom (c.left (ρ wQ)) :=
        (Scheme.Hom.comp_apply ρ D wQ).symm.trans
          ((congrArg (fun f : (Q : Scheme.{u}) ⟶ Limits.pullback U.hom U.hom => f wQ) hkey).trans
            ((Scheme.Hom.comp_apply (ρ ≫ c.left) (Limits.pullback.diagonal U.hom) wQ).trans
              (congrArg (Limits.pullback.diagonal U.hom) (Scheme.Hom.comp_apply ρ c.left wQ))))
      rw [hρw] at h1
      exact ⟨_, h1.symm⟩
    · set V := D ⁻¹ᵁ (Limits.pullback.diagonal U.hom).opensRange with hV
      have hrange : Set.range (V.ι ≫ D) ⊆ Set.range (Limits.pullback.diagonal U.hom) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : V.ι x ∈ Set.range V.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : D (V.ι x) ∈ (Limits.pullback.diagonal U.hom).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal U.hom = V.ι ≫ D :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal U.hom) (V.ι ≫ D) hrange⟩
      have h1 : V.ι ≫ c.left = t := by
        calc V.ι ≫ c.left = (V.ι ≫ D) ≫ Limits.pullback.fst U.hom U.hom := by
              rw [Category.assoc, hDf]
          _ = (t ≫ Limits.pullback.diagonal U.hom) ≫ Limits.pullback.fst U.hom U.hom := by
              rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : V.ι ≫ c'.left = t := by
        calc V.ι ≫ c'.left = (V.ι ≫ D) ≫ Limits.pullback.snd U.hom U.hom := by
              rw [Category.assoc, hDs]
          _ = (t ≫ Limits.pullback.diagonal U.hom) ≫ Limits.pullback.snd U.hom U.hom := by
              rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]

  have hex : ∀ c : ULift.{u+1} (T ⟶ U), ∃ a, α c.down w ∈ Θ a := fun c => (hΘ _).exists
  choose A hA using hex
  have huniq : ∀ c a, α c.down w ∈ Θ a → a = A c := fun c a h => (hΘ _).unique h (hA c)

  have hexp : R = ∑ c ∈ R.support, FreeAbelianGroup.coeff c R • FreeAbelianGroup.of c := by
    conv_lhs => rw [← Finsupp.toFreeAbelianGroup_toFinsupp R]
    rw [Finsupp.toFreeAbelianGroup.eq_1, Finsupp.liftAddHom_apply, Finsupp.sum]
    rfl

  have hPVof : ∀ c, wcSmePieceVec p U m k Θ T w (FreeAbelianGroup.of c) = Pi.single (A c) 1 := by
    intro c
    unfold wcSmePieceVec
    rw [FreeAbelianGroup.lift_apply_of]
    funext a
    rw [Pi.single_apply]
    split_ifs with h
    · subst h
      exact Set.indicator_of_mem (hA c) _
    · exact Set.indicator_of_notMem (fun hm => h (huniq c a hm)) _

  have hdiv : ∀ a : Fin k, (m : ℤ) ∣ ∑ c ∈ R.support with A c = a, FreeAbelianGroup.coeff c R := by
    intro a
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    have h1 : wcSmePieceVec p U m k Θ T w R a = 0 := by rw [hPV]; rfl
    have h2 : wcSmePieceVec p U m k Θ T w R a = ∑ c ∈ R.support,
        (FreeAbelianGroup.coeff c R : ZMod m) * ((Pi.single (A c) (1 : ZMod m) : Fin k → ZMod m) a) := by
      conv_lhs => rw [hexp]
      rw [map_sum, Finset.sum_apply]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [map_zsmul, hPVof, Pi.smul_apply, zsmul_eq_mul]
    have h3 : ∑ c ∈ R.support,
        (FreeAbelianGroup.coeff c R : ZMod m) * ((Pi.single (A c) (1 : ZMod m) : Fin k → ZMod m) a) =
        ((∑ c ∈ R.support with A c = a, FreeAbelianGroup.coeff c R : ℤ) : ZMod m) := by
      rw [Int.cast_sum, Finset.sum_filter]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [Pi.single_apply]
      by_cases h : A c = a
      · simp [h]
      · have h' : a ≠ A c := fun e => h e.symm
        simp [h, h']
    rw [← h3, ← h2]
    exact h1

  have hpair : ∀ q : ULift.{u+1} (T ⟶ U) × ULift.{u+1} (T ⟶ U), ∃ M : T.left.Opens,
      Limits.pullback.fst T.hom p w ∈ M ∧
        (A q.1 = A q.2 → M.ι ≫ q.1.down.left = M.ι ≫ q.2.down.left) := by
    intro q
    by_cases h : A q.1 = A q.2
    · obtain ⟨M, hM, hMe⟩ := hgeo (A q.1) q.1.down q.2.down (hA q.1)
        (by rw [h]; exact hA q.2)
      exact ⟨M, hM, fun _ => hMe⟩
    · exact ⟨⊤, by simp, fun h' => absurd h' h⟩
  choose M hMw hMe using hpair
  obtain ⟨N, hNdef⟩ : ∃ N : T.left.Opens, N = (R.support ×ˢ R.support).inf M := ⟨_, rfl⟩
  have hN : Limits.pullback.fst T.hom p w ∈ N := by
    rw [hNdef]
    exact Finset.inf_induction (p := fun V : T.left.Opens => Limits.pullback.fst T.hom p w ∈ V)
      (by simp) (fun a ha b hb => TopologicalSpace.Opens.mem_inf.2 ⟨ha, hb⟩) (fun q _ => hMw q)
  have hagr : ∀ c ∈ R.support, ∀ c' ∈ R.support, A c = A c' →
      wcEtOpenι Y T N ≫ c.down = wcEtOpenι Y T N ≫ c'.down := by
    intro c hc c' hc' h
    have hle : N ≤ M (c, c') := by
      rw [hNdef]; exact Finset.inf_le (Finset.mem_product.2 ⟨hc, hc'⟩)
    have e : (M (c, c')).ι ≫ c.down.left = (M (c, c')).ι ≫ c'.down.left := hMe (c, c') h
    apply MorphismProperty.Over.Hom.ext
    change N.ι ≫ c.down.left = N.ι ≫ c'.down.left
    rw [← T.left.homOfLE_ι hle, Category.assoc, Category.assoc, e]

  have hgen : ∀ (f : ULift.{u+1} (T ⟶ U) → ULift.{u+1} (wcEtOpen Y T N ⟶ U)),
      (∀ c ∈ R.support, ∀ c' ∈ R.support, A c = A c' → f c = f c') →
      ∃ y, FreeAbelianGroup.map f R = m • y := by
    intro f hf
    have hfib : ∀ a : Fin k, ∃ z : FreeAbelianGroup (ULift.{u+1} (wcEtOpen Y T N ⟶ U)),
        ∑ c ∈ R.support with A c = a,
          FreeAbelianGroup.coeff c R • FreeAbelianGroup.of (f c) = m • z := by
      intro a
      by_cases hne : ∃ c₀ ∈ R.support, A c₀ = a
      · obtain ⟨c₀, hc₀, hA₀⟩ := hne
        refine ⟨((∑ c ∈ R.support with A c = a, FreeAbelianGroup.coeff c R) / (m : ℤ)) •
          FreeAbelianGroup.of (f c₀), ?_⟩
        have hconst : ∀ c ∈ R.support.filter (fun c => A c = a),
            FreeAbelianGroup.coeff c R • FreeAbelianGroup.of (f c) =
              FreeAbelianGroup.coeff c R • FreeAbelianGroup.of (f c₀) := by
          intro c hc
          rw [Finset.mem_filter] at hc
          rw [hf c hc.1 c₀ hc₀ (hc.2.trans hA₀.symm)]
        rw [Finset.sum_congr rfl hconst, ← Finset.sum_smul, ← natCast_zsmul, smul_smul,
          Int.mul_ediv_cancel' (hdiv a)]
      · refine ⟨0, ?_⟩
        rw [smul_zero]
        apply Finset.sum_eq_zero
        intro c hc
        rw [Finset.mem_filter] at hc
        exact absurd ⟨c, hc.1, hc.2⟩ hne
    choose z hz using hfib
    refine ⟨∑ a, z a, ?_⟩
    rw [Finset.smul_sum]
    conv_lhs => rw [hexp]
    rw [map_sum]
    simp only [map_zsmul, FreeAbelianGroup.map_of_apply]
    rw [← Finset.sum_fiberwise R.support A]
    exact Finset.sum_congr rfl (fun a _ => hz a)
  obtain ⟨y, hy⟩ := hgen _ (fun c hc c' hc' h => congrArg ULift.up (hagr c hc c' hc' h))
  exact ⟨N, y, hN, hy⟩

theorem wc_split_realize_vanish : ∀ (Y Z : Scheme.{u}) (p : Z ⟶ Y) (U V : Y.Etale)
    (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    (m : ℕ), m • 𝟙 (Limits.cokernel g) = 0 →
    ∀ (O : Z.Opens) (k : ℕ) (ua : Fin k → ((O : Scheme.{u}) ⟶ U.left))
      (hu : ∀ a, ua a ≫ U.hom = O.ι ≫ p),
    (∀ a, IsOpenImmersion (Limits.pullback.lift (ua a) O.ι (hu a))) →
    ∀ Θ : Fin k → Set ↥(Limits.pullback U.hom p), (∀ x, ∃! a, x ∈ Θ a) →
    (∀ a, Set.range (Limits.pullback.lift (ua a) O.ι (hu a)) =
      Θ a ∩ (Limits.pullback.snd U.hom p) ⁻¹' (O : Set Z)) →
    ∀ (T₁ : Y.Etale) (R : FreeAbelianGroup (ULift.{u+1} (T₁ ⟶ U))) (w : ↥(Limits.pullback T₁.hom p)),
      Limits.pullback.snd T₁.hom p w ∈ (O : Set Z) →
      wcSmePieceVec p U m k Θ T₁ w R ∈
        AddSubgroup.closure (wcSmeWit p U V g m k Θ (Limits.pullback.snd T₁.hom p w)) →
      ∃ (T₃ : Y.Etale) (c : T₃ ⟶ T₁), Limits.pullback.fst T₁.hom p w ∈ Set.range c.left ∧
        ((Limits.cokernel g).obj.map c.op).hom
          (((Limits.cokernel.π g).hom.app (Opposite.op T₁)).hom (wcSmeGen U T₁ R)) = 0 :=
by
  intro Y Z p U V g m htor O k ua hu hΓ Θ hΘpart hΘrange T₁ R w hzO hmem
  classical

  have hgen : ∀ (T T' : Y.Etale) (h : T' ⟶ T) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      wcSmeGen U T' (FreeAbelianGroup.map
        (fun c : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (h ≫ c.down)) R) =
      (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map h.op).hom
        (wcSmeGen U T R) := by
    intro T T' h R
    exact NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Y)
      (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) h.op R
  have hA1 : ∀ (T T' : Y.Etale) (h : T' ⟶ T) (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      ((Limits.cokernel.π g).hom.app (Opposite.op T')).hom (wcSmeGen U T' (FreeAbelianGroup.map
        (fun c : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (h ≫ c.down)) R)) =
      ((Limits.cokernel g).obj.map h.op).hom
        (((Limits.cokernel.π g).hom.app (Opposite.op T)).hom (wcSmeGen U T R)) := by
    intro T T' h R
    rw [hgen]
    exact NatTrans.naturality_apply (Limits.cokernel.π g).hom h.op _

  have hm : ∀ (T : Y.Etale) (x : (Limits.cokernel g).obj.obj (Opposite.op T)), m • x = 0 := by
    intro T x
    have h1 : (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (m • 𝟙 (Limits.cokernel g)) = 0 := by rw [htor, Functor.map_zero]
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id] at h1
    have h2 := congrArg (fun f => (f.app (Opposite.op T)).hom x) h1
    simpa only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, NatTrans.app_zero, AddCommGrpCat.hom_zero,
      AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply] using h2

  have hsnd : ∀ (A B : Y.Etale) (c : A ⟶ B) (x : ↥(Limits.pullback A.hom p)),
      Limits.pullback.snd B.hom p (Limits.pullback.map A.hom p B.hom p c.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x) =
      Limits.pullback.snd A.hom p x := by
    intro A B c x
    rw [← Scheme.Hom.comp_apply]
    erw [Limits.pullback.lift_snd, Category.comp_id]
  have hfst : ∀ (A B : Y.Etale) (c : A ⟶ B) (x : ↥(Limits.pullback A.hom p)),
      Limits.pullback.fst B.hom p (Limits.pullback.map A.hom p B.hom p c.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x) =
      c.left (Limits.pullback.fst A.hom p x) := by
    intro A B c x
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
    erw [Limits.pullback.lift_fst]
  have hcomp : ∀ (A B C : Y.Etale) (c : A ⟶ B) (d : B ⟶ C) (e : A ⟶ C),
      e.left = c.left ≫ d.left → ∀ (x : ↥(Limits.pullback A.hom p)),
      Limits.pullback.map A.hom p C.hom p e.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w e).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x =
      Limits.pullback.map B.hom p C.hom p d.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w d).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm)
        (Limits.pullback.map A.hom p B.hom p c.left (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w c).symm)
          ((Category.comp_id _).trans (Category.id_comp _).symm) x) := by
    intro A B C c d e he x
    rw [← Scheme.Hom.comp_apply]
    refine congrArg (fun f : Limits.pullback A.hom p ⟶ Limits.pullback C.hom p => f x) ?_
    apply Limits.pullback.hom_ext
    · rw [Category.assoc]
      erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst, ← Category.assoc,
        Limits.pullback.lift_fst, Category.assoc, he]
    · rw [Category.assoc]
      erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd, ← Category.assoc,
        Limits.pullback.lift_snd]
      simp only [Category.comp_id]

  have hpv : ∀ (T T' : Y.Etale) (h : T' ⟶ T) (x : ↥(Limits.pullback T'.hom p))
      (R : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      wcSmePieceVec p U m k Θ T' x (FreeAbelianGroup.map
        (fun c : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (h ≫ c.down)) R) =
      wcSmePieceVec p U m k Θ T (Limits.pullback.map T'.hom p T.hom p h.left (𝟙 Z) (𝟙 Y)
        ((Category.comp_id _).trans (MorphismProperty.Over.w h).symm)
        ((Category.comp_id _).trans (Category.id_comp _).symm) x) R := by
    intro T T' h x R
    induction R using FreeAbelianGroup.induction_on with
    | zero => simp only [map_zero]
    | of c =>
      rw [FreeAbelianGroup.map_of_apply]
      unfold wcSmePieceVec
      rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
      funext a
      simp only
      rw [hcomp T' T U h c.down (h ≫ c.down) (MorphismProperty.Comma.comp_left _ _) x]
    | neg c ih => rw [map_neg, map_neg, map_neg, ih]
    | add a b ha hb => rw [map_add, map_add, map_add, ha, hb]

  obtain ⟨T'', c'', w'', R₀, hBC, hR₀, hPV⟩ := wc_split_witness_realize p U V g m k Θ _ _ hmem
    T₁ w rfl

  have hPV0 : wcSmePieceVec p U m k Θ T'' w'' (FreeAbelianGroup.map
      (fun c : ULift.{u+1} (T₁ ⟶ U) => ULift.up.{u+1} (c'' ≫ c.down)) R - R₀) = 0 := by
    rw [map_sub, hpv, hBC, hPV, sub_self]

  have hz'' : Limits.pullback.snd T''.hom p w'' ∈ (O : Set Z) := by
    rw [← hsnd T'' T₁ c'' w'', hBC]
    exact hzO

  obtain ⟨N, y, hN, hy⟩ := wc_split_vector_zero_mtorsion p U O k ua hu hΓ Θ hΘpart hΘrange m T''
    _ w'' hz'' hPV0

  refine ⟨wcEtOpen Y T'' N, wcEtOpenι Y T'' N ≫ c'',
    ⟨(⟨Limits.pullback.fst T''.hom p w'', hN⟩ : N), ?_⟩, ?_⟩
  · change c''.left (N.ι ⟨Limits.pullback.fst T''.hom p w'', hN⟩) = _
    rw [Scheme.Opens.ι_apply]
    change c''.left (Limits.pullback.fst T''.hom p w'') = _
    rw [← hfst T'' T₁ c'' w'', hBC]
  · rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, ← hA1]
    have hsplit : FreeAbelianGroup.map
        (fun c : ULift.{u+1} (T₁ ⟶ U) => ULift.up.{u+1} (c'' ≫ c.down)) R =
        (FreeAbelianGroup.map
          (fun c : ULift.{u+1} (T₁ ⟶ U) => ULift.up.{u+1} (c'' ≫ c.down)) R - R₀) + R₀ :=
      (sub_add_cancel _ _).symm
    rw [hsplit, map_add, map_add, map_add, hR₀, map_zero, add_zero, ← hA1, hy, map_nsmul,
      map_nsmul, hm]

theorem wc_et_split_model_embed : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of R)) [QuasiCompact fY] [QuasiSeparated fY] (m : ℕ), m ≠ 0 → ∀ (U V : Y.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → m • 𝟙 (Limits.cokernel g) = 0 → ∀ (Z : Scheme.{u}) (p : Z ⟶ Y) [IsFinite p] (O : Z.Opens) (k : ℕ) (ua : Fin k → ((O : Scheme.{u}) ⟶ U.left)) (hu : ∀ a, ua a ≫ U.hom = O.ι ≫ p), (∀ a, IsOpenImmersion (Limits.pullback.lift (ua a) O.ι (hu a))) → ∀ Θ : Fin k → Set ↥(Limits.pullback U.hom p), (∀ a, IsClopen (Θ a)) → (∀ x, ∃! a, x ∈ Θ a) → (∀ a, Set.range (Limits.pullback.lift (ua a) O.ι (hu a)) = Θ a ∩ (Limits.pullback.snd U.hom p) ⁻¹' (O : Set Z)) → ∀ (k' : ℕ) (vb : Fin k' → ((O : Scheme.{u}) ⟶ V.left)) (hv : ∀ b, vb b ≫ V.hom = O.ι ≫ p), (∀ b, IsOpenImmersion (Limits.pullback.lift (vb b) O.ι (hv b))) → (∀ (b b' : Fin k') (z z' : (O : Scheme.{u})), Limits.pullback.lift (vb b) O.ι (hv b) z = Limits.pullback.lift (vb b') O.ι (hv b') z' → b = b') → (∀ x : ↥(Limits.pullback V.hom p), Limits.pullback.snd V.hom p x ∈ (O : Set Z) → ∃ (b : Fin k') (z : (O : Scheme.{u})), Limits.pullback.lift (vb b) O.ι (hv b) z = x) → ∃ (n : ℕ) (Zf : Fin n → Scheme.{u}) (pf : ∀ i, Zf i ⟶ Y) (_ : ∀ i, IsFinite (pf i)) (φ : ∀ i, Limits.cokernel g ⟶ (wcEtPush (pf i)).obj ((constantSheaf (Scheme.smallEtaleTopology (Zf i)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), ∀ (T : Y.Etale) (s : (Limits.cokernel g).obj.obj (Opposite.op T)), (∀ i, ((φ i).hom.app (Opposite.op T)).hom s = 0) → ∀ t : T.left, T.hom t ∈ p '' (O : Set Z) → ∃ (T' : Y.Etale) (c : T' ⟶ T), t ∈ Set.range c.left ∧ ((Limits.cokernel g).obj.map c.op).hom s = 0 :=
by
  intro R _ Y fY _ _ m hm U V g hU1 hU2 hV1 hV2 htor Z p _ O k ua hu hΓ Θ hΘ hΘpart hΘrange
    k' vb hv hgv hvdisj hvcov
  classical
  haveI : NeZero m := ⟨hm⟩
  haveI : Finite (AddSubgroup (Fin k → ZMod m)) :=
    Finite.of_injective (fun M : AddSubgroup (Fin k → ZMod m) => (M : Set (Fin k → ZMod m)))
      SetLike.coe_injective
  haveI : Finite ((Fin k → ZMod m) →+ ZMod m) :=
    Finite.of_injective (fun f : (Fin k → ZMod m) →+ ZMod m => (f : (Fin k → ZMod m) → ZMod m))
      DFunLike.coe_injective
  let I := {x : AddSubgroup (Fin k → ZMod m) × ((Fin k → ZMod m) →+ ZMod m) //
    ∀ v ∈ x.1, x.2 v = 0}
  let e : I ≃ Fin (Nat.card I) := Finite.equivFin I
  let S : I → Set Z := fun x =>
    {z | z ∈ (O : Set Z) ∧ AddSubgroup.closure (wcSmeWit p U V g m k Θ z) = x.1.1}
  have hkill : ∀ x : I, ∀ z ∈ S x, ∀ v ∈ wcSmeWit p U V g m k Θ z, x.1.2 v = 0 := by
    rintro x z ⟨_, hz⟩ v hv
    apply x.2
    rw [← hz]
    exact AddSubgroup.subset_closure hv
  have H := fun x : I => wc_split_target_map Y Z p U V g m k Θ hΘ (S x) x.1.2 (hkill x)
  choose W q hq φ hφ using H
  refine ⟨Nat.card I, fun i => W (e.symm i), fun i => q (e.symm i), fun i => hq (e.symm i),
    fun i => φ (e.symm i), ?_⟩
  intro T s hs t ht
  have hs' : ∀ x : I, ((φ x).hom.app (Opposite.op T)).hom s = 0 := by
    intro x
    obtain ⟨i, rfl⟩ := e.symm.surjective x
    exact hs i
  obtain ⟨z, hzO, hzt⟩ := ht
  obtain ⟨T₁, c₁, t₁, Rr, hc₁t, hR⟩ := wc_free_cokernel_local_lift Y U V g T s t
  have h1 : T₁.hom t₁ = p z := by
    rw [← MorphismProperty.Over.w c₁, Scheme.Hom.comp_apply, hc₁t, hzt]
  obtain ⟨w, hw1, hw2⟩ := Scheme.Pullback.exists_preimage_pullback (f := T₁.hom) (g := p) t₁ z h1
  have hmem : wcSmePieceVec p U m k Θ T₁ w Rr ∈
      AddSubgroup.closure (wcSmeWit p U V g m k Θ (Limits.pullback.snd T₁.hom p w)) := by
    rw [hw2]
    by_contra hnot
    obtain ⟨f, hfM, hfw⟩ := wc_zmod_hom_separation m hm k _ _ hnot
    let x : I := ⟨(AddSubgroup.closure (wcSmeWit p U V g m k Θ z), f), hfM⟩
    have hnat := NatTrans.naturality_apply (φ x).hom c₁.op s
    have hzero : ((φ x).hom.app (Opposite.op T₁)).hom
        (((Limits.cokernel.π g).hom.app (Opposite.op T₁)).hom (wcSmeGen U T₁ Rr)) = 0 := by
      rw [hR]
      erw [hnat, hs' x, map_zero]
    exact hfw (hφ x T₁ Rr hzero w (by rw [hw2]; exact ⟨hzO, rfl⟩))
  obtain ⟨T₃, c, ⟨y, hy⟩, hvan⟩ := wc_split_realize_vanish Y Z p U V g m htor O k ua hu hΓ Θ
    hΘpart hΘrange T₁ Rr w (by rw [hw2]; exact hzO) hmem
  refine ⟨T₃, c ≫ c₁, ⟨y, ?_⟩, ?_⟩
  · change c₁.left (c.left y) = t
    rw [hy, hw1, hc₁t]
  · rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, ← hR]
    exact hvan

theorem wc_et_fp_torsion_local_embed : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of R)) [QuasiCompact fY] [QuasiSeparated fY] (m : ℕ), m ≠ 0 → ∀ (U V : Y.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → m • 𝟙 (Limits.cokernel g) = 0 → ∀ y : Y, ∃ (Z : Scheme.{u}) (p : Z ⟶ Y) (_ : IsFinite p) (φ : Limits.cokernel g ⟶ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (E : Set Y), y ∈ E ∧ Topology.IsConstructible E ∧ ∀ (T : Y.Etale) (s : (Limits.cokernel g).obj.obj (Opposite.op T)), (φ.hom.app (Opposite.op T)).hom s = 0 → ∀ t : T.left, T.hom t ∈ E → ∃ (T' : Y.Etale) (c : T' ⟶ T), t ∈ Set.range c.left ∧ ((Limits.cokernel g).obj.map c.op).hom s = 0 :=
by
  intro R _ Y fY _ _ m hm U V g hU1 hU2 hV1 hV2 htor y
  classical

  obtain ⟨Z, p, hp, O, E, hyE, hEc, hEO, k, ua, hu, hgu, Θ, hΘ, hΘpart, hΘrange,
    k', vb, hv, hgv, hvdisj, hvcov⟩ := wc_et_split_finite_model R Y fY U V hU1 hU2 hV1 hV2 y
  haveI := hp

  obtain ⟨n, Zf, pf, hpf, φ, hφ⟩ := wc_et_split_model_embed R Y fY m hm U V g hU1 hU2 hV1 hV2
    htor Z p O k ua hu hgu Θ hΘ hΘpart hΘrange k' vb hv hgv hvdisj hvcov

  have claim : ∀ (n : ℕ) (Zf : Fin n → Scheme.{u}) (pf : ∀ i, Zf i ⟶ Y) (_ : ∀ i, IsFinite (pf i))
      (φ : ∀ i, Limits.cokernel g ⟶ (wcEtPush (pf i)).obj
        ((constantSheaf (Scheme.smallEtaleTopology (Zf i)) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))),
      ∃ (Z' : Scheme.{u}) (p' : Z' ⟶ Y) (_ : IsFinite p')
        (e : Limits.cokernel g ⟶ (wcEtPush p').obj
          ((constantSheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))),
        ∀ (T : Y.Etale) (s : (Limits.cokernel g).obj.obj (Opposite.op T)),
          (e.hom.app (Opposite.op T)).hom s = 0 → ∀ i, ((φ i).hom.app (Opposite.op T)).hom s = 0 := by
    intro n
    induction n with
    | zero =>
      intro Zf pf hpf φ
      exact ⟨Y, 𝟙 Y, inferInstance, 0, fun T s _ i => i.elim0⟩
    | succ n ih =>
      intro Zf pf hpf φ
      obtain ⟨Z₀, p₀, hp₀, e₀, he₀⟩ := ih (fun i => Zf i.succ) (fun i => pf i.succ)
        (fun i => hpf i.succ) (fun i => φ i.succ)
      haveI := hp₀
      haveI := hpf 0
      obtain ⟨Z', p', hp', q₁, q₂, hq⟩ := wc_et_finite_push_const_pair Y Z₀ (Zf 0) p₀ (pf 0) m
      obtain ⟨e, h1, h2⟩ := hq _ e₀ (φ 0)
      refine ⟨Z', p', hp', e, fun T s hs => ?_⟩
      have hs1 : (e₀.hom.app (Opposite.op T)).hom s = 0 := by
        rw [← h1]
        change (q₁.hom.app (Opposite.op T)).hom ((e.hom.app (Opposite.op T)).hom s) = 0
        rw [hs, map_zero]
      have hs2 : ((φ 0).hom.app (Opposite.op T)).hom s = 0 := by
        rw [← h2]
        change (q₂.hom.app (Opposite.op T)).hom ((e.hom.app (Opposite.op T)).hom s) = 0
        rw [hs, map_zero]
      intro i
      exact Fin.cases (motive := fun i => ((φ i).hom.app (Opposite.op T)).hom s = 0) hs2
        (fun j => he₀ T s hs1 j) i
  obtain ⟨Z', p', hp', e, he⟩ := claim n Zf pf hpf φ
  exact ⟨Z', p', hp', e, E, hyE, hEc, fun T s hs t ht => hφ T s (he T s hs) t (hEO ht)⟩

theorem wc_et_fp_torsion_embed_finite_push : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of R)) [QuasiCompact fY] [QuasiSeparated fY] (m : ℕ), m ≠ 0 → ∀ (U V : Y.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → m • 𝟙 (Limits.cokernel g) = 0 → ∃ (Z : Scheme.{u}) (p : Z ⟶ Y) (_ : IsFinite p) (e : Limits.cokernel g ⟶ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), Mono e :=
by
  intro R _ Y fY _ _ m hm U V g hU1 hU2 hV1 hV2 htor
  classical
  haveI hYc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace fY
  haveI hYq : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated fY

  have s4 : ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (T : Y.Etale)
      (s : F.obj.obj (Opposite.op T)),
      (∀ t : T.left, ∃ (T' : Y.Etale) (c : T' ⟶ T), t ∈ Set.range c.left ∧
        (F.obj.map c.op).hom s = 0) → s = 0 := by
    intro F T s h
    choose T' c hc hz using h
    have hTe : Etale T.hom := T.prop
    letI hJS : Scheme.IsJointlySurjectivePreserving (@Etale : MorphismProperty Scheme.{u}) :=
      ⟨fun {_ _ _ _ _} _ _ x y hxy =>
        (inferInstance : Scheme.IsJointlySurjectivePreserving
          (⊤ : MorphismProperty Scheme.{u})).exists_preimage_fst_triplet_of_prop trivial x y hxy⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage (@Etale : MorphismProperty Scheme.{u})) T.left :=
      Scheme.Cover.mkOfCovers (P := (@Etale : MorphismProperty Scheme.{u})) T.left
        (fun t => (T' t).left) (fun t => (c t).left)
        (fun x => by
          obtain ⟨y, hy⟩ := hc x
          exact ⟨x, y, hy⟩)
        (fun t => by
          have hw : (c t).left ≫ T.hom = (T' t).hom := MorphismProperty.Over.w (c t)
          have : Etale ((c t).left ≫ T.hom) := by
            rw [hw]; exact (T' t).prop
          exact Etale.of_comp (c t).left T.hom)
    let S : Sieve T :=
      { arrows := fun _ f => (F.obj.map f.op).hom s = 0
        downward_closed := by
          intro _ _ f hf k
          rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
          rw [hf, map_zero] }
    letI hov : ∀ t, (𝒰.X t).Over Y := fun t => ⟨(T' t).hom⟩
    let hO : Scheme.Cover.Over Y 𝒰 :=
      { «over» := hov
        isOver_map := fun t => ⟨MorphismProperty.Over.w (c t)⟩ }
    have hS : S ∈ Scheme.smallEtaleTopology Y T := by
      refine (Scheme.mem_smallGrothendieckTopology (P := (@Etale : MorphismProperty Scheme.{u}))
        T S).mpr ⟨𝒰, hO, fun t => (T' t).prop, ?_⟩
      rintro _ _ ⟨t⟩
      exact hz t
    exact F.isSeparated T S hS s 0 (fun _ f hf => by
      rw [map_zero]
      exact hf)

  have s2 : ∀ (E : Y → Set Y), (∀ x, x ∈ E x) → (∀ x, Topology.IsConstructible (E x)) →
      ∃ S : Finset Y, ∀ x, ∃ y ∈ S, x ∈ E y := by
    intro E hxE hE
    have hopen : ∀ s : Set Y, Topology.IsConstructible s →
        @IsOpen Y (constructibleTopology Y) s := by
      intro s hs
      let B : BooleanSubalgebra (Set Y) :=
        { carrier := {s | @IsClopen Y (constructibleTopology Y) s}
          supClosed' := fun a ha b hb => @IsClopen.union Y (constructibleTopology Y) a b ha hb
          infClosed' := fun a ha b hb => @IsClopen.inter Y (constructibleTopology Y) a b ha hb
          compl_mem' := fun {a} ha => @IsClopen.compl Y (constructibleTopology Y) a ha
          bot_mem' := @isClopen_empty Y (constructibleTopology Y) }
      have hle : BooleanSubalgebra.closure {U : Set Y | IsOpen U ∧ IsRetrocompact U} ≤ B := by
        rw [BooleanSubalgebra.closure_le]
        rintro W ⟨hWo, hWr⟩
        have hWc : IsCompact W := by
          have := hWr isCompact_univ isOpen_univ
          rwa [Set.inter_univ] at this
        have hWc' : IsCompact Wᶜᶜ := by rw [compl_compl]; exact hWc
        have h1 : @IsOpen Y (constructibleTopology Y) Wᶜ :=
          TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨hWo.isClosed_compl, hWc'⟩)
        have h2 : @IsOpen Y (constructibleTopology Y) W :=
          TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl ⟨hWo, hWc⟩)
        exact ⟨@IsClosed.mk Y (constructibleTopology Y) W h1, h2⟩
      exact (hle hs).2
    have hcpt : IsCompact (Set.univ : Set (WithConstructibleTopology Y)) :=
      (compactSpace_withConstructibleTopology (X := Y)).isCompact_univ
    obtain ⟨t, ht⟩ := hcpt.elim_finite_subcover
      (fun i : Y => (WithTopology.ofTopology ⁻¹' E i : Set (WithConstructibleTopology Y)))
      (fun i => WithConstructibleTopology.isOpen_iff.mpr (hopen _ (hE i)))
      (fun x _ => Set.mem_iUnion.mpr ⟨x.ofTopology, hxE _⟩)
    refine ⟨t, fun x => ?_⟩
    have hx := ht (Set.mem_univ (WithTopology.toTopology (constructibleTopology Y) x))
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    exact ⟨y, hy, hxy⟩

  choose Zy py hpy φy Ey hyE hEc hloc using
    wc_et_fp_torsion_local_embed R Y fY m hm U V g hU1 hU2 hV1 hV2 htor

  have claim : ∀ S' : Finset Y, ∃ (Z : Scheme.{u}) (p : Z ⟶ Y) (_ : IsFinite p)
      (e : Limits.cokernel g ⟶ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))),
      ∀ (T : Y.Etale) (s : (Limits.cokernel g).obj.obj (Opposite.op T)),
        (e.hom.app (Opposite.op T)).hom s = 0 → ∀ t : T.left, (∃ y ∈ S', T.hom t ∈ Ey y) →
        ∃ (T' : Y.Etale) (c : T' ⟶ T), t ∈ Set.range c.left ∧
          ((Limits.cokernel g).obj.map c.op).hom s = 0 := by
    intro S'
    induction S' using Finset.induction_on with
    | empty =>
      exact ⟨Y, 𝟙 Y, inferInstance, 0, fun T s _ t ⟨y, hy, _⟩ =>
        absurd hy (Finset.notMem_empty y)⟩
    | insert a S' ha ih =>
      obtain ⟨Z₀, p₀, hp₀, e₀, he₀⟩ := ih
      haveI := hp₀
      haveI := hpy a
      obtain ⟨Z, p, hp, q₁, q₂, hq⟩ := wc_et_finite_push_const_pair Y Z₀ (Zy a) p₀ (py a) m
      obtain ⟨e, h1, h2⟩ := hq _ e₀ (φy a)
      refine ⟨Z, p, hp, e, fun T s hs t ⟨y, hy, hyt⟩ => ?_⟩
      have hs1 : (e₀.hom.app (Opposite.op T)).hom s = 0 := by
        rw [← h1]
        change (q₁.hom.app (Opposite.op T)).hom ((e.hom.app (Opposite.op T)).hom s) = 0
        rw [hs, map_zero]
      have hs2 : ((φy a).hom.app (Opposite.op T)).hom s = 0 := by
        rw [← h2]
        change (q₂.hom.app (Opposite.op T)).hom ((e.hom.app (Opposite.op T)).hom s) = 0
        rw [hs, map_zero]
      rcases Finset.mem_insert.mp hy with rfl | hy'
      · exact hloc y T s hs2 t hyt
      · exact he₀ T s hs1 t ⟨y, hy', hyt⟩

  obtain ⟨S, hS⟩ := s2 Ey hyE hEc
  obtain ⟨Z, p, hp, e, he⟩ := claim S
  refine ⟨Z, p, hp, e, ?_⟩
  haveI hmono : ∀ X, Mono (e.hom.app X) := by
    intro X
    rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
    intro s hs
    exact s4 _ X.unop s (fun t => by
      obtain ⟨y, hyS, hy⟩ := hS (X.unop.hom t)
      exact he X.unop s hs t ⟨y, hyS, hy⟩)
  haveI : Mono e.hom := NatTrans.mono_of_mono_app _
  exact Sheaf.Hom.mono_of_presheaf_mono _ _ e

theorem wc_affine_absolute_integral_cover : ∀ (P : Scheme.{u}) [IsAffine P], ∃ (T : Scheme.{u}) (t : T ⟶ P), IsAffine T ∧ IsIntegralHom t ∧ Surjective t ∧ ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsIntegrallyClosed R) (_ : IsSepClosed (FractionRing R)) (π : R →+* Γ(T, ⊤)), Function.Surjective π :=
by
  intro P _

  have s1 : ∀ (B : Type u) [CommRing B] [IsDomain B] (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      [Algebra B Ω] [Algebra.IsAlgebraic B Ω], Function.Injective (algebraMap B Ω) →
      Function.Injective (algebraMap B (integralClosure B Ω)) ∧
      IsIntegrallyClosed (integralClosure B Ω) ∧
      IsSepClosed (FractionRing (integralClosure B Ω)) := by
    intro B _ _ Ω _ _ _ _ hBΩ
    have hBR : Function.Injective (algebraMap B (integralClosure B Ω)) := by
      intro x y h
      apply hBΩ
      rw [IsScalarTower.algebraMap_apply B (integralClosure B Ω) Ω x,
        IsScalarTower.algebraMap_apply B (integralClosure B Ω) Ω y, h]
    haveI hfr : IsFractionRing (integralClosure B Ω) Ω :=
      integralClosure.isFractionRing_of_algebraic (fun x hx => hBΩ (by rw [hx, map_zero]))
    have hic : IsIntegrallyClosed (integralClosure B Ω) := by
      rw [isIntegrallyClosed_iff Ω]
      intro x hx
      have hxB : IsIntegral B x := isIntegral_trans (R := B) (A := integralClosure B Ω) x hx
      exact ⟨⟨x, (mem_integralClosure_iff B Ω).mpr hxB⟩, rfl⟩
    refine ⟨hBR, hic, ?_⟩
    let e : FractionRing (integralClosure B Ω) ≃ₐ[integralClosure B Ω] Ω :=
      IsLocalization.algEquiv (nonZeroDivisors (integralClosure B Ω)) _ Ω
    haveI : IsAlgClosed (FractionRing (integralClosure B Ω)) :=
      IsAlgClosed.of_ringEquiv Ω _ e.symm.toRingEquiv
    exact IsSepClosed.of_isAlgClosed _

  have s2 : ∀ (B : Type u) [CommRing B] (R : Type u) [CommRing R] [Algebra B R]
      [Algebra.IsIntegral B R], Function.Injective (algebraMap B R) → ∀ (A : Type u) [CommRing A]
      (σ : B →+* A), Function.Surjective σ →
      ∃ φ : A →+* R ⧸ (RingHom.ker σ).map (algebraMap B R),
        φ.IsIntegral ∧ Function.Surjective (PrimeSpectrum.comap φ) := by
    intro B _ R _ _ _ hinj A _ σ hσ
    let e := RingHom.quotientKerEquivOfSurjective hσ
    let ψ := Ideal.quotientMap ((RingHom.ker σ).map (algebraMap B R)) (algebraMap B R)
      Ideal.le_comap_map
    let φ : A →+* R ⧸ (RingHom.ker σ).map (algebraMap B R) :=
      ψ.comp (e.symm : A →+* B ⧸ RingHom.ker σ)
    have key : ∀ b : B, φ (σ b) =
        Ideal.Quotient.mk ((RingHom.ker σ).map (algebraMap B R)) (algebraMap B R b) := by
      intro b
      have h1 : e.symm (σ b) = Ideal.Quotient.mk (RingHom.ker σ) b :=
        (RingEquiv.symm_apply_eq e).mpr (RingHom.quotientKerEquivOfSurjective_apply_mk hσ b).symm
      show ψ (e.symm (σ b)) = _
      rw [h1, Ideal.quotientMap_mk]
    refine ⟨φ, ?_, ?_⟩
    · have hcomp : φ.comp σ =
          (Ideal.Quotient.mk ((RingHom.ker σ).map (algebraMap B R))).comp (algebraMap B R) :=
        RingHom.ext key
      have h2 : (φ.comp σ).IsIntegral := by
        rw [hcomp]
        exact RingHom.IsIntegral.trans _ _ (algebraMap_isIntegral_iff.mpr inferInstance)
          (RingHom.isIntegral_of_surjective _ Ideal.Quotient.mk_surjective)
      exact RingHom.IsIntegral.tower_top σ φ h2
    · intro p
      haveI : (Ideal.comap σ p.asIdeal).IsPrime := Ideal.IsPrime.comap σ
      obtain ⟨Q, -, hQ, hQq⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
        (Ideal.comap σ p.asIdeal) (⊥ : Ideal R)
        (by rw [Ideal.under_def, Ideal.comap_bot_of_injective _ hinj]; exact bot_le)
      rw [Ideal.under_def] at hQq
      have hIQ : (RingHom.ker σ).map (algebraMap B R) ≤ Q := by
        apply Ideal.map_le_of_le_comap
        rw [hQq]
        intro b hb
        rw [RingHom.mem_ker] at hb
        show σ b ∈ p.asIdeal
        rw [hb]
        exact p.asIdeal.zero_mem
      haveI := hQ
      haveI hQ' : (Q.map (Ideal.Quotient.mk ((RingHom.ker σ).map (algebraMap B R)))).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
          (by rw [Ideal.mk_ker]; exact hIQ)
      refine ⟨⟨_, hQ'⟩, PrimeSpectrum.ext ?_⟩
      ext x
      obtain ⟨b, rfl⟩ := hσ x
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, key, Ideal.mem_quotient_iff_mem hIQ,
        ← Ideal.mem_comap, hQq, Ideal.mem_comap]

  have s3 : ∀ (A' : Type u) [CommRing A'] (φ : Γ(P, ⊤) →+* A'),
      φ.IsIntegral → Function.Surjective (PrimeSpectrum.comap φ) →
      ∃ (T : Scheme.{u}) (t : T ⟶ P), IsAffine T ∧ IsIntegralHom t ∧ Surjective t ∧
        ∃ π : A' →+* Γ(T, ⊤), Function.Surjective π := by
    intro A' _ φ hφi hφs
    haveI : IsIntegralHom (Spec.map (CommRingCat.ofHom φ)) := IsIntegralHom.SpecMap_iff.mpr hφi
    haveI : Surjective (Spec.map (CommRingCat.ofHom φ)) := ⟨hφs⟩
    refine ⟨Spec (CommRingCat.of A'), Spec.map (CommRingCat.ofHom φ) ≫ P.isoSpec.inv,
      inferInstance, inferInstance, inferInstance,
      (Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom, ?_⟩
    exact (Scheme.ΓSpecIso (CommRingCat.of A')).symm.commRingCatIsoToRingEquiv.surjective

  haveI : Algebra.IsAlgebraic (MvPolynomial Γ(P, ⊤) ℤ) (FractionRing (MvPolynomial Γ(P, ⊤) ℤ)) :=
    IsLocalization.isAlgebraic _ (nonZeroDivisors (MvPolynomial Γ(P, ⊤) ℤ))
  haveI : Algebra.IsAlgebraic (MvPolynomial Γ(P, ⊤) ℤ)
      (AlgebraicClosure (FractionRing (MvPolynomial Γ(P, ⊤) ℤ))) :=
    Algebra.IsAlgebraic.trans _ (FractionRing (MvPolynomial Γ(P, ⊤) ℤ)) _
  have hBΩ : Function.Injective (algebraMap (MvPolynomial Γ(P, ⊤) ℤ)
      (AlgebraicClosure (FractionRing (MvPolynomial Γ(P, ⊤) ℤ)))) := by
    rw [IsScalarTower.algebraMap_eq (MvPolynomial Γ(P, ⊤) ℤ)
      (FractionRing (MvPolynomial Γ(P, ⊤) ℤ))
      (AlgebraicClosure (FractionRing (MvPolynomial Γ(P, ⊤) ℤ)))]
    exact (algebraMap (FractionRing (MvPolynomial Γ(P, ⊤) ℤ))
      (AlgebraicClosure (FractionRing (MvPolynomial Γ(P, ⊤) ℤ)))).injective.comp
      (IsFractionRing.injective _ _)
  obtain ⟨hinj, hic, hsep⟩ := s1 (MvPolynomial Γ(P, ⊤) ℤ)
    (AlgebraicClosure (FractionRing (MvPolynomial Γ(P, ⊤) ℤ))) hBΩ
  have hσ : Function.Surjective (MvPolynomial.eval₂Hom (Int.castRingHom Γ(P, ⊤)) id) :=
    fun a => ⟨MvPolynomial.X a, MvPolynomial.eval₂Hom_X' _ _ a⟩
  obtain ⟨φ, hφi, hφs⟩ := s2 (MvPolynomial Γ(P, ⊤) ℤ)
    (integralClosure (MvPolynomial Γ(P, ⊤) ℤ)
      (AlgebraicClosure (FractionRing (MvPolynomial Γ(P, ⊤) ℤ)))) hinj Γ(P, ⊤) _ hσ
  obtain ⟨T, t, hT, hti, hts, π, hπ⟩ := s3 _ φ hφi hφs
  exact ⟨T, t, hT, hti, hts, _, inferInstance, inferInstance, hic, hsep,
    π.comp (Ideal.Quotient.mk _), hπ.comp Ideal.Quotient.mk_surjective⟩

theorem wc_et_lc_isSheaf : ∀ (X : Scheme.{u}) (A : Type (u+1)) [AddCommGroup A], Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtLC X A) :=
by
  intro X A _

  have s2 : ∀ {Z : Type u} [TopologicalSpace Z] {ι : Type (u+1)} {V : ι → Type u}
      [∀ i, TopologicalSpace (V i)] (f : ∀ i, V i → Z), (∀ i, IsOpenMap (f i)) →
      (∀ z : Z, ∃ (i : ι) (v : V i), f i v = z) → ∀ (g : ∀ i, LocallyConstant (V i) A),
      (∀ (i j : ι) (v : V i) (w : V j), f i v = f j w → g i v = g j w) →
      ∃ G : LocallyConstant Z A, ∀ (i : ι) (v : V i), G (f i v) = g i v := by
    intro Z _ ι V _ f hopen hsurj g hcompat
    choose iz vz hz using hsurj
    let G₀ : Z → A := fun z => g (iz z) (vz z)
    have hK : ∀ j w, G₀ (f j w) = g j w := fun j w => hcompat _ _ _ _ (hz _)
    have hlc : IsLocallyConstant G₀ := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro a
      rw [isOpen_iff_forall_mem_open]
      intro z hzA
      refine ⟨f (iz z) '' {v' | g (iz z) v' = g (iz z) (vz z)}, ?_,
        hopen _ _ (IsLocallyConstant.isOpen_fiber (g (iz z)).isLocallyConstant _),
        ⟨vz z, rfl, hz z⟩⟩
      rintro _ ⟨v', hv', rfl⟩
      change G₀ (f (iz z) v') = a
      rw [hK, hv']
      exact hzA
    exact ⟨⟨G₀, hlc⟩, hK⟩

  have s3 : ∀ (U : X.Etale) (S : Sieve U), S ∈ Scheme.smallEtaleTopology X U →
      ∀ z : U.left, ∃ (V : X.Etale) (f : V ⟶ U) (y : V.left), S.arrows f ∧ f.left y = z := by
    intro U S hS z
    change S ∈ Scheme.smallGrothendieckTopology @Etale X U at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    obtain ⟨V, f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U S).mp hS z
    exact ⟨V, f, y, hf, hy⟩

  have s4e : ∀ {V U : X.Etale} (c : V ⟶ U), Etale c.left := by
    intro V U c
    haveI : Etale U.hom := U.prop
    haveI : Etale (c.left ≫ U.hom) := by rw [MorphismProperty.Over.w c]; exact V.prop
    exact Etale.of_comp c.left U.hom
  have s4 : ∀ {V U : X.Etale} (c : V ⟶ U), IsOpenMap c.left := by
    intro V U c
    haveI := s4e c
    exact c.left.isOpenMap

  have s5 : ∀ {U V₁ V₂ : X.Etale} (f₁ : V₁ ⟶ U) (f₂ : V₂ ⟶ U) (y₁ : V₁.left) (y₂ : V₂.left),
      f₁.left y₁ = f₂.left y₂ → ∃ (D : X.Etale) (π₁ : D ⟶ V₁) (π₂ : D ⟶ V₂) (z : D.left),
        π₁ ≫ f₁ = π₂ ≫ f₂ ∧ π₁.left z = y₁ ∧ π₂.left z = y₂ := by
    intro U V₁ V₂ f₁ f₂ y₁ y₂ h
    haveI := s4e f₂
    haveI hEt : Etale (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) := by
      haveI : Etale V₁.hom := V₁.prop
      infer_instance
    let D : X.Etale :=
      MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom) hEt
    have hw : Limits.pullback.snd f₁.left f₂.left ≫ V₂.hom =
        Limits.pullback.fst f₁.left f₂.left ≫ V₁.hom := by
      rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let p₁ : D ⟶ V₁ :=
      MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl trivial
    let p₂ : D ⟶ V₂ :=
      MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left) hw trivial
    have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
      apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst f₁.left f₂.left ≫ f₁.left =
        Limits.pullback.snd f₁.left f₂.left ≫ f₂.left
      exact Limits.pullback.condition
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback y₁ y₂ h
    exact ⟨D, p₁, p₂, z, hcomm, hz1, hz2⟩

  rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) (wcEtLC X A)
    (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
  intro U S hS x hx

  let ι := Σ (V : X.Etale), {f : V ⟶ U // S.arrows f}
  obtain ⟨G, hG⟩ := s2 (Z := U.left) (ι := ι) (V := fun i => ↥(i.1.left))
    (fun i v => i.2.1.left v) (fun i => s4 i.2.1)
    (fun z => by
      obtain ⟨V, f, y, hf, hy⟩ := s3 U S hS z
      exact ⟨⟨V, f, hf⟩, y, hy⟩)
    (fun i => show LocallyConstant i.1.left A from x i.2.1 i.2.2)
    (by
      rintro ⟨V₁, f₁, h₁⟩ ⟨V₂, f₂, h₂⟩ v w hvw
      obtain ⟨D, π₁, π₂, z, hcomm, hz1, hz2⟩ := s5 f₁ f₂ v w hvw
      have hc := hx π₁ π₂ h₁ h₂ hcomm
      have h := congrArg (fun k => (show LocallyConstant D.left A from k) z) hc
      change (show LocallyConstant V₁.left A from x f₁ h₁) v =
        (show LocallyConstant V₂.left A from x f₂ h₂) w
      rw [← hz1, ← hz2]
      exact h)

  refine ⟨G, fun V f hf => ?_, fun t ht => ?_⟩
  · change @Eq (LocallyConstant V.left A) _ _
    exact LocallyConstant.ext (fun y => hG ⟨V, f, hf⟩ y)
  · change @Eq (LocallyConstant U.left A) _ _
    refine LocallyConstant.ext (fun z => ?_)
    obtain ⟨V, f, y, hf, rfl⟩ := s3 U S hS z
    have h1 := congrArg (fun k => (show LocallyConstant V.left A from k) y) (ht f hf)
    exact h1.trans (hG ⟨V, f, hf⟩ y).symm

theorem wc_et_const_to_lc_locBij : ∀ (X : Scheme.{u}) (A : Type (u+1)) [AddCommGroup A], ∃ φ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A) ⟶ wcEtLC X A, Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) φ ∧ Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) φ :=
by
  intro X A _
  have hcov : ∀ (U : X.Etale) (R : Sieve U), (∀ p : U.left, ∃ (V : X.Etale) (f : V ⟶ U)
      (v : V.left), R.arrows f ∧ Etale f.left ∧ f.left v = p) →
      R ∈ Scheme.smallEtaleTopology X U := by
    intro U R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale X U
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    exact hR
  let φ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A) ⟶ wcEtLC X A :=
    { app := fun U => AddCommGrpCat.ofHom
        (LocallyConstant.constAddMonoidHom : A →+ LocallyConstant U.unop.left A)
      naturality := fun U V g => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        rfl }
  refine ⟨φ, ?_, ?_⟩
  · constructor
    intro U x y h
    apply hcov
    intro p
    have hxy : x = y := by
      have := congrArg (fun k : LocallyConstant U.unop.left A => k p) h
      exact this
    refine ⟨U.unop, 𝟙 _, p, ?_, ?_, rfl⟩
    · subst hxy
      exact rfl
    · show Etale (𝟙 U.unop.left)
      infer_instance
  · constructor
    intro U s
    apply hcov
    intro p
    let σ : LocallyConstant U.left A := s
    let N : U.left.Opens := ⟨{q | σ q = σ p}, σ.isLocallyConstant.isOpen_fiber (σ p)⟩
    haveI : Etale U.hom := U.prop
    let V : X.Etale := Scheme.Etale.mk (N.ι ≫ U.hom)
    let f : V ⟶ U := MorphismProperty.Over.homMk N.ι rfl trivial
    refine ⟨V, f, ⟨p, rfl⟩, ?_, ?_, rfl⟩
    · refine ⟨σ p, ?_⟩
      apply LocallyConstant.ext
      intro q
      change σ p = σ (f.left q)
      exact q.2.symm
    · show Etale N.ι
      infer_instance

theorem wc_et_push_const_lc_iso : ∀ {X Y : Scheme.{u}} (a : X ⟶ Y) (A : Type (u+1)) [AddCommGroup A], Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtLC X A) → (∃ φ : (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of A) ⟶ wcEtLC X A, Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) φ ∧ Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) φ) → Nonempty ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (wcLCPb a A) ≅ (wcEtPush a).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A))) :=
by
  intro X Y a A _ hs hφ
  obtain ⟨φ, hinj, hsurj⟩ := hφ
  let L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} := ⟨wcEtLC X A, hs⟩
  have hW : (Scheme.smallEtaleTopology X).W φ :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology X) φ).mpr
      ⟨hinj, hsurj⟩
  have hI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology X) φ).mp hW
  let e1 := @asIso _ _ _ _ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) hI
  let ε : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of A) ≅ L :=
    e1 ≪≫ (sheafificationIso L).symm
  exact ⟨(wcEtPush a).mapIso ε.symm⟩

theorem wc_lcpb_transfer : ∀ {Y X X' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (r : X' ⟶ X) (h : r ≫ a = a') (A : Type (u+1)) [AddCommGroup A], ∃ θ : wcLCPb a A ⟶ wcLCPb a' A, ∀ V : Y.Etale, θ.app (Opposite.op V) = AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom ⟨wcPbρ a a' r h V, (wcPbρ a a' r h V).continuous⟩) :=
by
  intro Y X X' a a' r h A _
  have hβ : ∀ {Z : Scheme.{u}} (b : Z ⟶ Y) {V₁ V₂ : Y.Etale} (c : V₁ ⟶ V₂),
      (((wcEtBaseChange b).map c).left : Limits.pullback V₁.hom b ⟶ Limits.pullback V₂.hom b) ≫
        Limits.pullback.fst V₂.hom b = Limits.pullback.fst V₁.hom b ≫ c.left ∧
      (((wcEtBaseChange b).map c).left : Limits.pullback V₁.hom b ⟶ Limits.pullback V₂.hom b) ≫
        Limits.pullback.snd V₂.hom b = Limits.pullback.snd V₁.hom b := by
    intro Z b V₁ V₂ c
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hρ : ∀ V : Y.Etale,
      (wcPbρ a a' r h V : Limits.pullback V.hom a' ⟶ Limits.pullback V.hom a) ≫
        Limits.pullback.fst V.hom a = Limits.pullback.fst V.hom a' ∧
      (wcPbρ a a' r h V : Limits.pullback V.hom a' ⟶ Limits.pullback V.hom a) ≫
        Limits.pullback.snd V.hom a = Limits.pullback.snd V.hom a' ≫ r := by
    intro V
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have abs1 : ∀ {P₁' P₁ P₂' P₂ T S : Scheme.{u}} (ρ₁ : P₁' ⟶ P₁) (β : P₁ ⟶ P₂) (β' : P₁' ⟶ P₂')
      (ρ₂ : P₂' ⟶ P₂) (f : P₂ ⟶ T) (x : P₁ ⟶ S) (y : S ⟶ T) (x' : P₁' ⟶ S) (w : P₂' ⟶ T),
      β ≫ f = x ≫ y → ρ₁ ≫ x = x' → ρ₂ ≫ f = w → β' ≫ w = x' ≫ y →
      (ρ₁ ≫ β) ≫ f = (β' ≫ ρ₂) ≫ f := by
    intro P₁' P₁ P₂' P₂ T S ρ₁ β β' ρ₂ f x y x' w h1 h2 h3 h4
    rw [Category.assoc, Category.assoc, h1, h3, ← Category.assoc, h2, h4]
  have abs2 : ∀ {P₁' P₁ P₂' P₂ T S : Scheme.{u}} (ρ₁ : P₁' ⟶ P₁) (β : P₁ ⟶ P₂) (β' : P₁' ⟶ P₂')
      (ρ₂ : P₂' ⟶ P₂) (f : P₂ ⟶ T) (x : P₁ ⟶ T) (x' : P₁' ⟶ S) (s : P₂' ⟶ S) (r' : S ⟶ T),
      β ≫ f = x → ρ₁ ≫ x = x' ≫ r' → ρ₂ ≫ f = s ≫ r' → β' ≫ s = x' →
      (ρ₁ ≫ β) ≫ f = (β' ≫ ρ₂) ≫ f := by
    intro P₁' P₁ P₂' P₂ T S ρ₁ β β' ρ₂ f x x' s r' h1 h2 h3 h4
    rw [Category.assoc, Category.assoc, h1, h3, h2, ← Category.assoc, h4]
  have key : ∀ {V₁ V₂ : Y.Etale} (c : V₁ ⟶ V₂),
      ((wcPbρ a a' r h V₁ ≫ ((wcEtBaseChange a).map c).left :
          Limits.pullback V₁.hom a' ⟶ Limits.pullback V₂.hom a)) =
      ((((wcEtBaseChange a').map c).left ≫ wcPbρ a a' r h V₂ :
          Limits.pullback V₁.hom a' ⟶ Limits.pullback V₂.hom a)) := by
    intro V₁ V₂ c
    apply Limits.pullback.hom_ext
    · exact abs1 _ _ _ _ _ _ _ _ _ (hβ a c).1 (hρ V₁).1 (hρ V₂).1 (hβ a' c).1
    · exact abs2 _ _ _ _ _ _ _ _ _ (hβ a c).2 (hρ V₁).2 (hρ V₂).2 (hβ a' c).2
  refine ⟨{ app := fun V => AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom
              ⟨wcPbρ a a' r h V.unop, (wcPbρ a a' r h V.unop).continuous⟩)
            naturality := ?_ }, fun V => rfl⟩
  intro V₂ V₁ g
  apply AddCommGrpCat.hom_ext
  apply AddMonoidHom.ext
  intro s
  apply LocallyConstant.ext
  intro z
  have e := key g.unop
  change (show LocallyConstant ((wcEtBaseChange a).obj V₂.unop).left A from s)
      (((wcEtBaseChange a).map g.unop).left (wcPbρ a a' r h V₁.unop z)) =
    (show LocallyConstant ((wcEtBaseChange a).obj V₂.unop).left A from s)
      (wcPbρ a a' r h V₂.unop (((wcEtBaseChange a').map g.unop).left z))
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply]
  exact congrArg _ (congrArg (fun k => k z) e)

theorem wc_pbρ_laws : (∀ {Y X X' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (r : X' ⟶ X) (h : r ≫ a = a') (V : Y.Etale), wcPbρ a a' r h V ≫ Limits.pullback.fst V.hom a = Limits.pullback.fst V.hom a' ∧ wcPbρ a a' r h V ≫ Limits.pullback.snd V.hom a = Limits.pullback.snd V.hom a' ≫ r) ∧ (∀ {Y X X' X'' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (a'' : X'' ⟶ Y) (r : X' ⟶ X) (r' : X'' ⟶ X') (r'' : X'' ⟶ X) (h : r ≫ a = a') (h' : r' ≫ a' = a'') (h'' : r'' ≫ a = a''), r' ≫ r = r'' → ∀ V : Y.Etale, wcPbρ a' a'' r' h' V ≫ wcPbρ a a' r h V = wcPbρ a a'' r'' h'' V) ∧ (∀ {Y X : Scheme.{u}} (a : X ⟶ Y) (r : X ⟶ X) (h : r ≫ a = a), r = 𝟙 X → ∀ V : Y.Etale, wcPbρ a a r h V = 𝟙 _) :=
by
  have L1 : ∀ {Y X X' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (r : X' ⟶ X) (h : r ≫ a = a')
      (V : Y.Etale), wcPbρ a a' r h V ≫ Limits.pullback.fst V.hom a = Limits.pullback.fst V.hom a' ∧
        wcPbρ a a' r h V ≫ Limits.pullback.snd V.hom a = Limits.pullback.snd V.hom a' ≫ r := by
    intro Y X X' a a' r h V
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  refine ⟨L1, ?_, ?_⟩
  · intro Y X X' X'' a a' a'' r r' r'' h h' h'' hr V
    apply Limits.pullback.hom_ext (f := V.hom) (g := a)
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun k => wcPbρ a' a'' r' h' V ≫ k) (L1 a a' r h V).1).trans
          ((L1 a' a'' r' h' V).1.trans (L1 a a'' r'' h'' V).1.symm))
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun k => wcPbρ a' a'' r' h' V ≫ k) (L1 a a' r h V).2).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (fun k => k ≫ r) (L1 a' a'' r' h' V).2).trans
              ((Category.assoc _ _ _).trans
                ((congrArg (fun k => Limits.pullback.snd V.hom a'' ≫ k) hr).trans
                  (L1 a a'' r'' h'' V).2.symm)))))
  · intro Y X a r h hr V
    apply Limits.pullback.hom_ext (f := V.hom) (g := a)
    · exact (L1 a a r h V).1.trans (Category.id_comp _).symm
    · exact (L1 a a r h V).2.trans
        ((congrArg (fun k => Limits.pullback.snd V.hom a ≫ k) hr).trans
          ((Category.comp_id _).trans (Category.id_comp _).symm))

theorem wc_stage_finite_surj : ∀ {P T : Scheme.{u}} [IsAffine P] [IsAffine T] (t : T ⟶ P) [IsIntegralHom t] (F : Finset Γ(T, ⊤)), IsFinite (wcStageQ t F) ∧ Surjective (wcStageS t F) :=
by
  intro P T _ _ t _ F
  classical
  have hφ : t.appTop.hom.IsIntegral := IsIntegralHom.isIntegral_app t ⊤ (isAffineOpen_top P)
  have hmem : ∀ x, t.appTop.hom x ∈ wcStageSub t.appTop.hom F :=
    fun x => Subring.subset_closure (Or.inl ⟨x, rfl⟩)
  have hcomp : (wcStageSub t.appTop.hom F).subtype.comp
      (t.appTop.hom.codRestrict (wcStageSub t.appTop.hom F) hmem) = t.appTop.hom :=
    RingHom.ext fun x => rfl
  refine ⟨?_, ?_⟩
  ·
    have hψint : (t.appTop.hom.codRestrict (wcStageSub t.appTop.hom F) hmem).IsIntegral :=
      RingHom.IsIntegral.tower_bot _ (wcStageSub t.appTop.hom F).subtype
        (wcStageSub t.appTop.hom F).subtype_injective (by rw [hcomp]; exact hφ)
    have hψft : (t.appTop.hom.codRestrict (wcStageSub t.appTop.hom F) hmem).FiniteType := by
      letI : Algebra Γ(P, ⊤) (wcStageSub t.appTop.hom F) :=
        (t.appTop.hom.codRestrict (wcStageSub t.appTop.hom F) hmem).toAlgebra
      have hGfin : ((wcStageSub t.appTop.hom F).subtype ⁻¹' (F : Set Γ(T, ⊤))).Finite :=
        F.finite_toSet.preimage (wcStageSub t.appTop.hom F).subtype_injective.injOn
      have key : ∀ y : wcStageSub t.appTop.hom F,
          y ∈ Algebra.adjoin Γ(P, ⊤) (hGfin.toFinset : Set (wcStageSub t.appTop.hom F)) := by
        have hle : wcStageSub t.appTop.hom F ≤
            (Algebra.adjoin Γ(P, ⊤) (hGfin.toFinset : Set (wcStageSub t.appTop.hom F))).toSubring.map
              (wcStageSub t.appTop.hom F).subtype := by
          apply Subring.closure_le.mpr
          rintro b (⟨a, rfl⟩ | hb)
          · exact ⟨algebraMap Γ(P, ⊤) (wcStageSub t.appTop.hom F) a,
              Subalgebra.algebraMap_mem _ a, rfl⟩
          · refine ⟨⟨b, Subring.subset_closure (Or.inr hb)⟩, Algebra.subset_adjoin ?_, rfl⟩
            rw [Set.Finite.coe_toFinset]
            exact hb
        intro y
        obtain ⟨z, hz, hzy⟩ := hle y.2
        have hzy' : z = y := Subtype.ext hzy
        rw [← hzy']
        exact hz
      change Algebra.FiniteType Γ(P, ⊤) (wcStageSub t.appTop.hom F)
      exact ⟨⟨hGfin.toFinset, eq_top_iff.mpr fun y _ => key y⟩⟩
    have hψfin : (t.appTop.hom.codRestrict (wcStageSub t.appTop.hom F) hmem).Finite :=
      hψint.to_finite hψft
    haveI h1 : IsFinite (Spec.map (CommRingCat.ofHom
        (t.appTop.hom.codRestrict (wcStageSub t.appTop.hom F) hmem))) := by
      rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
      exact hψfin
    show IsFinite (Spec.map (CommRingCat.ofHom
        (t.appTop.hom.codRestrict (wcStageSub t.appTop.hom F) hmem)) ≫ P.isoSpec.inv)
    infer_instance
  ·
    have hsubint : (wcStageSub t.appTop.hom F).subtype.IsIntegral :=
      RingHom.IsIntegral.tower_top _ _ (by rw [hcomp]; exact hφ)
    haveI : Algebra.IsIntegral (wcStageSub t.appTop.hom F) Γ(T, ⊤) :=
      algebraMap_isIntegral_iff.mp hsubint
    have hsurj : Function.Surjective
        (PrimeSpectrum.comap (algebraMap (wcStageSub t.appTop.hom F) Γ(T, ⊤))) :=
      Algebra.IsIntegral.comap_surjective _ _
    haveI h2 : Surjective (Spec.map (CommRingCat.ofHom (wcStageSub t.appTop.hom F).subtype)) := by
      constructor
      intro x
      obtain ⟨y, hy⟩ := hsurj x
      let y' : Spec (CommRingCat.of Γ(T, ⊤)) := y
      refine ⟨y', ?_⟩
      rw [Spec.map_apply, CommRingCat.hom_ofHom]
      exact hy
    show Surjective (T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (wcStageSub t.appTop.hom F).subtype))
    infer_instance

theorem wc_stage_compat : ∀ {P T : Scheme.{u}} [IsAffine P] (t : T ⟶ P), (∀ F : Finset Γ(T, ⊤), wcStageS t F ≫ wcStageQ t F = t) ∧ (∀ (F F' : Finset Γ(T, ⊤)) (h : F ⊆ F'), wcStageR t h ≫ wcStageQ t F = wcStageQ t F' ∧ wcStageS t F' ≫ wcStageR t h = wcStageS t F) ∧ (∀ (F : Finset Γ(T, ⊤)) (h : F ⊆ F), wcStageR t h = 𝟙 _) ∧ (∀ (F F' F'' : Finset Γ(T, ⊤)) (h : F ⊆ F') (h' : F' ⊆ F'') (h'' : F ⊆ F''), wcStageR t h' ≫ wcStageR t h = wcStageR t h'') ∧ (∀ (F : Finset Γ(T, ⊤)) (b : Γ(T, ⊤)), b ∈ F → ∃ b' : Γ(wcStage t F, ⊤), (wcStageS t F).appTop b' = b) :=
by
  intro P T _ t
  have g1 : ∀ {R : CommRingCat.{u}} (σ : R ⟶ Γ(T, ⊤)) (ψ : Γ(P, ⊤) ⟶ R),
      ψ ≫ σ = t.appTop → (T.toSpecΓ ≫ Spec.map σ) ≫ (Spec.map ψ ≫ P.isoSpec.inv) = t := by
    intro R σ ψ h
    rw [Category.assoc, ← Category.assoc (Spec.map σ), ← Spec.map_comp, h,
      ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc, ← Scheme.isoSpec_hom,
      Iso.hom_inv_id, Category.comp_id]
  have g2 : ∀ {R R' : CommRingCat.{u}} (ι : R ⟶ R') (ψ : Γ(P, ⊤) ⟶ R) (ψ' : Γ(P, ⊤) ⟶ R'),
      ψ ≫ ι = ψ' → Spec.map ι ≫ (Spec.map ψ ≫ P.isoSpec.inv) = Spec.map ψ' ≫ P.isoSpec.inv := by
    intro R R' ι ψ ψ' h
    rw [← Category.assoc, ← Spec.map_comp, h]
  have g3 : ∀ {R R' : CommRingCat.{u}} (ι : R ⟶ R') (σ : R ⟶ Γ(T, ⊤)) (σ' : R' ⟶ Γ(T, ⊤)),
      ι ≫ σ' = σ → (T.toSpecΓ ≫ Spec.map σ') ≫ Spec.map ι = T.toSpecΓ ≫ Spec.map σ := by
    intro R R' ι σ σ' h
    rw [Category.assoc, ← Spec.map_comp, h]
  have g4 : ∀ {R R' R'' : CommRingCat.{u}} (ι : R ⟶ R') (ι' : R' ⟶ R'') (ι'' : R ⟶ R''),
      ι ≫ ι' = ι'' → Spec.map ι' ≫ Spec.map ι = Spec.map ι'' := by
    intro R R' R'' ι ι' ι'' h
    rw [← Spec.map_comp, h]
  have g5 : ∀ {R : CommRingCat.{u}} (σ : R ⟶ Γ(T, ⊤)),
      (T.toSpecΓ ≫ Spec.map σ).appTop = (Scheme.ΓSpecIso R).hom ≫ σ := by
    intro R σ
    rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality]
  have g5' : ∀ {R : CommRingCat.{u}} (σ : R ⟶ Γ(T, ⊤)) (y : R),
      (T.toSpecΓ ≫ Spec.map σ).appTop ((Scheme.ΓSpecIso R).inv y) = σ y := by
    intro R σ y
    rw [g5, CommRingCat.comp_apply, Iso.inv_hom_id_apply]
  have g6 : ∀ {R : CommRingCat.{u}} (ι : R ⟶ R), ι = 𝟙 R → Spec.map ι = 𝟙 (Spec R) := by
    intro R ι hι
    rw [hι, Spec.map_id]

  have rB : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B) (S S' : Subring B)
      (hS : S ≤ S') (h1 : ∀ x, φ x ∈ S) (h2 : ∀ x, φ x ∈ S'),
      CommRingCat.ofHom (φ.codRestrict S h1) ≫ CommRingCat.ofHom (Subring.inclusion hS) =
        CommRingCat.ofHom (φ.codRestrict S' h2) := by
    intro A B _ _ φ S S' hS h1 h2
    ext x
    rfl
  have rC : ∀ {B : Type u} [CommRing B] (S S' : Subring B) (hS : S ≤ S'),
      CommRingCat.ofHom (Subring.inclusion hS) ≫ CommRingCat.ofHom S'.subtype =
        CommRingCat.ofHom S.subtype := by
    intro B _ S S' hS
    ext x
    rfl
  have rD : ∀ {B : Type u} [CommRing B] (S : Subring B) (hS : S ≤ S),
      CommRingCat.ofHom (Subring.inclusion hS) = 𝟙 (CommRingCat.of S) := by
    intro B _ S hS
    ext x
    rfl
  have rE : ∀ {B : Type u} [CommRing B] (S S' S'' : Subring B) (h1 : S ≤ S') (h2 : S' ≤ S'')
      (h3 : S ≤ S''),
      CommRingCat.ofHom (Subring.inclusion h1) ≫ CommRingCat.ofHom (Subring.inclusion h2) =
        CommRingCat.ofHom (Subring.inclusion h3) := by
    intro B _ S S' S'' h1 h2 h3
    ext x
    rfl
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro F
    exact g1 _ _ (by ext x; rfl)
  · intro F F' h
    exact ⟨g2 _ _ _ (rB _ _ _ _ _ _), g3 _ _ _ (rC _ _ _)⟩
  · intro F h
    exact g6 _ (rD _ _)
  · intro F F' F'' h h' h''
    exact g4 _ _ _ (rE _ _ _ _ _ _)
  · intro F b hb
    exact ⟨(Scheme.ΓSpecIso (CommRingCat.of (wcStageSub t.appTop.hom F))).inv
      ⟨b, Subring.subset_closure (Or.inr (Finset.mem_coe.mpr hb))⟩,
      g5' (CommRingCat.ofHom (wcStageSub t.appTop.hom F).subtype) _⟩

theorem wc_affine_pullback_sections_span : ∀ (Y V T : Scheme.{u}) [IsAffine Y] [IsAffine V] [IsAffine T] (v : V ⟶ Y) (τ : T ⟶ Y) (s : Γ(Limits.pullback v τ, ⊤)), ∃ (n : ℕ) (c : Fin n → Γ(V, ⊤)) (b : Fin n → Γ(T, ⊤)), s = ∑ i, (Limits.pullback.fst v τ).appTop (c i) * (Limits.pullback.snd v τ).appTop (b i) :=
by
  intro Y V T _ _ _ v τ s
  classical
  letI : Algebra Γ(Y, ⊤) Γ(V, ⊤) := v.appTop.hom.toAlgebra
  letI : Algebra Γ(Y, ⊤) Γ(T, ⊤) := τ.appTop.hom.toAlgebra
  let φ0 : Limits.pullback v τ ⟶ Limits.pullback (Spec.map v.appTop) (Spec.map τ.appTop) :=
    Limits.pullback.map v τ _ _ V.isoSpec.hom T.isoSpec.hom Y.isoSpec.hom
      (Scheme.isoSpec_hom_naturality v).symm (Scheme.isoSpec_hom_naturality τ).symm
  haveI h0 : IsIso φ0 := by dsimp only [φ0]; infer_instance
  let φ : Limits.pullback v τ ⟶ Limits.pullback
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, ⊤) Γ(V, ⊤))))
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, ⊤) Γ(T, ⊤)))) := φ0
  haveI : IsIso φ := h0
  let A : CommRingCat.{u} := CommRingCat.of (TensorProduct Γ(Y, ⊤) Γ(V, ⊤) Γ(T, ⊤))
  let ψ : Limits.pullback v τ ⟶ Spec A := φ ≫ (pullbackSpecIso Γ(Y, ⊤) Γ(V, ⊤) Γ(T, ⊤)).hom
  haveI : IsIso ψ := IsIso.comp_isIso
  let Θ : TensorProduct Γ(Y, ⊤) Γ(V, ⊤) Γ(T, ⊤) →+* Γ(Limits.pullback v τ, ⊤) :=
    ((Scheme.ΓSpecIso A).inv ≫ ψ.appTop).hom

  have hsurj : Function.Surjective Θ := by
    intro x
    refine ⟨(Scheme.ΓSpecIso A).hom ((inv ψ).appTop x), ?_⟩
    have h1 : (inv ψ).appTop ≫ ψ.appTop = 𝟙 _ := by
      rw [← Scheme.Hom.comp_appTop, IsIso.hom_inv_id, Scheme.Hom.id_appTop]
    change ψ.appTop ((Scheme.ΓSpecIso A).inv ((Scheme.ΓSpecIso A).hom ((inv ψ).appTop x))) = x
    rw [Iso.hom_inv_id_apply, ← CommRingCat.comp_apply, h1, CommRingCat.id_apply]

  have gen : ∀ (ψ' : Limits.pullback v τ ⟶ Spec A) (W : Scheme.{u}) [IsAffine W]
      (i : Γ(W, ⊤) ⟶ A) (h : Limits.pullback v τ ⟶ W),
      ψ' ≫ Spec.map i = h ≫ W.isoSpec.hom →
        i ≫ (Scheme.ΓSpecIso A).inv ≫ ψ'.appTop = h.appTop := by
    intro ψ' W _ i h e
    have e1 := congrArg Scheme.Hom.appTop e
    simp only [Scheme.Hom.comp_appTop, Scheme.isoSpec_hom, Scheme.toSpecΓ_appTop] at e1
    have e2 : (Spec.map i).appTop = (Scheme.ΓSpecIso Γ(W, ⊤)).hom ≫ i ≫ (Scheme.ΓSpecIso A).inv := by
      rw [← Category.assoc, ← Scheme.ΓSpecIso_naturality, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    rw [e2, Category.assoc, Category.assoc] at e1
    exact (Iso.cancel_iso_hom_left _ _ _).mp e1
  have hF : ψ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
      (R := Γ(Y, ⊤)) (A := Γ(V, ⊤)) (B := Γ(T, ⊤)))) = Limits.pullback.fst v τ ≫ V.isoSpec.hom := by
    show (φ ≫ (pullbackSpecIso Γ(Y, ⊤) Γ(V, ⊤) Γ(T, ⊤)).hom) ≫ _ = _
    rw [Category.assoc, pullbackSpecIso_hom_fst]
    exact Limits.pullback.lift_fst _ _ _
  have hG : ψ ≫ Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight
      (R := Γ(Y, ⊤)) (A := Γ(V, ⊤)) (B := Γ(T, ⊤)) :
        Γ(T, ⊤) →+* TensorProduct Γ(Y, ⊤) Γ(V, ⊤) Γ(T, ⊤))) =
      Limits.pullback.snd v τ ≫ T.isoSpec.hom := by
    show (φ ≫ (pullbackSpecIso Γ(Y, ⊤) Γ(V, ⊤) Γ(T, ⊤)).hom) ≫ _ = _
    rw [Category.assoc, pullbackSpecIso_hom_snd]
    exact Limits.pullback.lift_snd _ _ _
  have hL : ∀ c : Γ(V, ⊤), Θ (TensorProduct.tmul Γ(Y, ⊤) c (1 : Γ(T, ⊤))) =
      (Limits.pullback.fst v τ).appTop c := by
    intro c
    rw [← gen ψ V _ _ hF]
    rfl
  have hR : ∀ b : Γ(T, ⊤), Θ (TensorProduct.tmul Γ(Y, ⊤) (1 : Γ(V, ⊤)) b) =
      (Limits.pullback.snd v τ).appTop b := by
    intro b
    rw [← gen ψ T _ _ hG]
    rfl

  have span : ∀ z : TensorProduct Γ(Y, ⊤) Γ(V, ⊤) Γ(T, ⊤), ∃ (n : ℕ) (c : Fin n → Γ(V, ⊤))
      (b : Fin n → Γ(T, ⊤)), Θ z = ∑ i, Θ (TensorProduct.tmul Γ(Y, ⊤) (c i) (1 : Γ(T, ⊤))) *
        Θ (TensorProduct.tmul Γ(Y, ⊤) (1 : Γ(V, ⊤)) (b i)) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
    | tmul x y =>
      refine ⟨1, fun _ => x, fun _ => y, ?_⟩
      rw [Fin.sum_univ_one, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨n₁, c₁, b₁, e₁⟩ := h₁
      obtain ⟨n₂, c₂, b₂, e₂⟩ := h₂
      refine ⟨n₁ + n₂, Fin.append c₁ c₂, Fin.append b₁ b₂, ?_⟩
      rw [map_add, e₁, e₂, Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]
  obtain ⟨z, rfl⟩ := hsurj s
  obtain ⟨n, c, b, e⟩ := span z
  refine ⟨n, c, b, ?_⟩
  rw [e]
  exact Finset.sum_congr rfl (fun i _ => by rw [hL, hR])

theorem wc_affine_clopen_basicOpen : ∀ (X : Scheme.{u}) [IsAffine X] (U : Set X), IsClopen U → ∃ e : Γ(X, ⊤), (X.basicOpen e : Set X) = U :=
by
  intro X _ U hU
  let V : Set (PrimeSpectrum Γ(X, ⊤)) := (X.isoSpec.inv : Spec Γ(X, ⊤) ⟶ X) ⁻¹' U
  have hV : IsClopen V := hU.preimage (X.isoSpec.inv).continuous
  let e₀ := (PrimeSpectrum.isIdempotentElemEquivClopens (R := Γ(X, ⊤))).symm ⟨V, hV⟩
  have hBV : (PrimeSpectrum.basicOpen (e₀ : Γ(X, ⊤)) : Set (PrimeSpectrum Γ(X, ⊤))) = V := by
    rw [← PrimeSpectrum.isIdempotentElemEquivClopens_apply_toOpens]
    simp [e₀]
  refine ⟨(e₀ : Γ(X, ⊤)), ?_⟩
  rw [← Scheme.toSpecΓ_preimage_basicOpen]
  ext x
  change X.toSpecΓ x ∈ (PrimeSpectrum.basicOpen (e₀ : Γ(X, ⊤)) : Set (PrimeSpectrum Γ(X, ⊤))) ↔ x ∈ U
  rw [hBV]
  change X.isoSpec.inv (X.toSpecΓ x) ∈ U ↔ x ∈ U
  rw [← Scheme.isoSpec_hom, Scheme.hom_inv_apply]

theorem wc_lc_descends_finite_stage : ∀ (I : Type u) [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I] (X : Scheme.{u}), CompactSpace X → (∀ U : Set X, IsClopen U → ∃ e : Γ(X, ⊤), (X.basicOpen e : Set X) = U) → ∀ (Xs : I → Scheme.{u}) (π : ∀ i, X ⟶ Xs i) (r : ∀ i j, i ≤ j → (Xs j ⟶ Xs i)), (∀ i j (h : i ≤ j), π j ≫ r i j h = π i) → (∀ i, Surjective (π i)) → (∀ s : Γ(X, ⊤), ∃ (i : I) (s' : Γ(Xs i, ⊤)), (π i).appTop s' = s) → ∀ (A : Type (u+1)) (g : LocallyConstant X A), ∃ (i : I) (g' : LocallyConstant (Xs i) A), ∀ x : X, g' (π i x) = g x :=
by
  intro I _ _ _ X hcpt hcl Xs π r hcomp hsurj hlift A g
  classical
  have hfin : (Set.range g).Finite := g.range_finite
  haveI : Finite (Set.range g) := hfin.to_subtype
  have hfib : ∀ a : Set.range g, ∃ e : Γ(X, ⊤), (X.basicOpen e : Set X) = {x | g x = a.1} :=
    fun a => hcl _ (g.isLocallyConstant.isClopen_fiber a.1)
  choose e he using hfib
  choose ia s' hs' using fun a : Set.range g => hlift (e a)
  obtain ⟨M, hM⟩ := Finite.exists_le ia
  have hte : ∀ a, (π M).appTop ((r (ia a) M (hM a)).appTop (s' a)) = e a := by
    intro a
    rw [← hs' a, ← hcomp (ia a) M (hM a), Scheme.Hom.comp_appTop]
    rfl
  have hV : ∀ (a : Set.range g) (x' : X),
      π M x' ∈ ((Xs M).basicOpen ((r (ia a) M (hM a)).appTop (s' a)) : Set (Xs M)) ↔
        g x' = a.1 := by
    intro a x'
    have h1 : x' ∈ ((π M ⁻¹ᵁ (Xs M).basicOpen ((r (ia a) M (hM a)).appTop (s' a))) : Set X) ↔
        π M x' ∈ ((Xs M).basicOpen ((r (ia a) M (hM a)).appTop (s' a)) : Set (Xs M)) := Iff.rfl
    rw [← h1, Scheme.preimage_basicOpen_top, hte, he]
    rfl
  have hs : Function.Surjective (π M) := (hsurj M).surj
  have hq : ∀ y, π M (Function.surjInv hs y) = y := Function.surjInv_eq hs
  have hlc : IsLocallyConstant (fun y => g (Function.surjInv hs y)) := by
    rw [IsLocallyConstant.iff_exists_open]
    intro y
    let a : Set.range g := ⟨g (Function.surjInv hs y), Function.surjInv hs y, rfl⟩
    refine ⟨((Xs M).basicOpen ((r (ia a) M (hM a)).appTop (s' a)) : Set (Xs M)),
      ((Xs M).basicOpen ((r (ia a) M (hM a)).appTop (s' a))).isOpen, ?_, ?_⟩
    · have h2 := (hV a (Function.surjInv hs y)).mpr rfl
      rwa [hq y] at h2
    · intro y' hy'
      rw [← hq y'] at hy'
      exact (hV a (Function.surjInv hs y')).mp hy'
  refine ⟨M, ⟨fun y => g (Function.surjInv hs y), hlc⟩, fun x => ?_⟩
  show g (Function.surjInv hs (π M x)) = g x
  let a : Set.range g := ⟨g x, x, rfl⟩
  have h1 : π M x ∈ ((Xs M).basicOpen ((r (ia a) M (hM a)).appTop (s' a)) : Set (Xs M)) :=
    (hV a x).mpr rfl
  rw [← hq (π M x)] at h1
  exact (hV a _).mp h1

theorem wc_et_sheafify_filtered_colim_of_affine : ∀ (Y : Scheme.{u}) (J : Type u) [SmallCategory J] [IsFiltered J] (L : J ⥤ ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) (c : Limits.Cocone L), (∀ (V : Y.Etale), IsAffine V.left → (∀ s : c.pt.obj (Opposite.op V), ∃ (j : J) (t : (L.obj j).obj (Opposite.op V)), ((c.ι.app j).app (Opposite.op V)).hom t = s) ∧ (∀ (j : J) (t : (L.obj j).obj (Opposite.op V)), ((c.ι.app j).app (Opposite.op V)).hom t = 0 → ∃ (k : J) (f : j ⟶ k), ((L.map f).app (Opposite.op V)).hom t = 0)) → Nonempty (Limits.IsColimit ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapCocone c)) :=
by
  intro Y J _ _ L c hyp

  have s0 : ∀ (V : Y.Etale) (R S : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
      (∀ (V' : Y.Etale) (h : V' ⟶ V), IsAffine V'.left → R.arrows h → S.arrows h) →
      S ∈ Scheme.smallEtaleTopology Y V := by
    intro V R S hR hS
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mpr
    intro v
    obtain ⟨Y₁, f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR v
    obtain ⟨a, ha⟩ := Y₁.left.affineCover.covers y
    haveI : Etale Y₁.hom := Y₁.prop
    let V' : Y.Etale := MorphismProperty.Over.mk ⊤
      (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) ≫ Y₁.hom)
      (inferInstance : Etale (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) ≫ Y₁.hom))
    let h : V' ⟶ Y₁ := MorphismProperty.Over.homMk
      (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y)) rfl trivial
    have hA : IsAffine V'.left := by
      show IsAffine (Y₁.left.affineCover.X (Y₁.left.affineCover.idx y))
      infer_instance
    obtain ⟨c, hc⟩ : ∃ c : V' ⟶ V, c = h ≫ f := ⟨_, rfl⟩
    have hRc : R.arrows c := hc ▸ R.downward_closed hf h
    have hSc : S.arrows c := hS V' c hA hRc
    have hEt : Etale c.left := by
      haveI : Etale V.hom := V.prop
      have hw : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
      haveI : Etale (c.left ≫ V.hom) := by
        rw [hw]
        exact V'.prop
      exact Etale.of_comp c.left V.hom
    refine ⟨V', c, a, hSc, hEt, ?_⟩
    subst hc
    change f.left (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) a) = v
    rw [ha, hy]
  have s0' : ∀ (V : Y.Etale) (S : Sieve V),
      (∀ (V' : Y.Etale) (h : V' ⟶ V), IsAffine V'.left → S.arrows h) →
      S ∈ Scheme.smallEtaleTopology Y V := fun V S hS =>
    s0 V ⊤ S (GrothendieckTopology.top_mem _ V) (fun V' h hA _ => hS V' h hA)

  have key : ∀ (j : J) (X : (Y.Etale)ᵒᵖ) (y : (L.obj j).obj X),
      ((Limits.colimit.desc L c).app X).hom (((Limits.colimit.ι L j).app X).hom y) =
        ((c.ι.app j).app X).hom y := by
    intro j X y
    show ((Limits.colimit.ι L j ≫ Limits.colimit.desc L c).app X).hom y = _
    rw [Limits.colimit.ι_desc]
  have trans : ∀ (j k : J) (f : j ⟶ k) (X : (Y.Etale)ᵒᵖ) (y : (L.obj j).obj X),
      ((Limits.colimit.ι L k).app X).hom (((L.map f).app X).hom y) =
        ((Limits.colimit.ι L j).app X).hom y := by
    intro j k f X y
    show ((L.map f ≫ Limits.colimit.ι L k).app X).hom y = _
    rw [Limits.colimit.w]
  letI : Limits.PreservesFilteredColimitsOfSize.{u, u} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  have rep : ∀ (X : (Y.Etale)ᵒᵖ) (x : (Limits.colimit L).obj X),
      ∃ (j : J) (y : (L.obj j).obj X), ((Limits.colimit.ι L j).app X).hom y = x := by
    intro X x
    have hX := Limits.isColimitOfPreserves ((evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj X)
      (Limits.colimit.isColimit L)
    obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ hX x
    exact ⟨j, y, hy⟩
  have bij : ∀ V : Y.Etale, IsAffine V.left →
      Function.Bijective ((Limits.colimit.desc L c).app (Opposite.op V)).hom := by
    intro V hV
    obtain ⟨ha, hb⟩ := hyp V hV
    constructor
    · rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨j, y, rfl⟩ := rep _ x
      rw [key] at hx
      obtain ⟨k, f, hf⟩ := hb j y hx
      rw [← trans j k f, hf, map_zero]
    · intro s
      obtain ⟨j, t, rfl⟩ := ha s
      exact ⟨_, key j _ t⟩

  have hiso : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (Limits.colimit.desc L c)) := by
    rw [← GrothendieckTopology.W_iff, GrothendieckTopology.W_iff_isLocallyBijective]
    constructor
    · apply Presheaf.IsLocallyInjective.mk
      intro X x y hxy
      apply s0'
      intro V' h hV'
      rw [Presheaf.equalizerSieve_apply]
      apply (bij V' hV').1
      have e1 := NatTrans.naturality_apply (Limits.colimit.desc L c) h.op x
      have e2 := NatTrans.naturality_apply (Limits.colimit.desc L c) h.op y
      exact e1.trans ((congrArg _ hxy).trans e2.symm)
    · refine Presheaf.IsLocallySurjective.mk ?_
      intro U s
      apply s0'
      intro V' h hV'
      rw [Presheaf.imageSieve_apply]
      exact (bij V' hV').2 _

  have hC := Limits.isColimitOfPreserves
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (Limits.colimit.isColimit L)
  have hE := Limits.IsColimit.extendIso
    ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (Limits.colimit.desc L c)) hC
  refine ⟨hE.ofIsoColimit (Limits.Cocone.ext (Iso.refl _) ?_)⟩
  intro j
  simp only [Limits.Cocone.extend_ι, NatTrans.comp_app, Functor.const_map_app,
    Functor.mapCocone_ι_app, Limits.colimit.cocone_ι, Iso.refl_hom, Category.comp_id,
    ← Functor.map_comp, Limits.colimit.ι_desc]

theorem wc_pullback_map_surjective : ∀ {Y X X' V : Scheme.{u}} (v : V ⟶ Y) (a : X ⟶ Y) (a' : X' ⟶ Y) (r : X' ⟶ X), r ≫ a = a' → Surjective r → ∀ (ρ : Limits.pullback v a' ⟶ Limits.pullback v a), ρ ≫ Limits.pullback.fst v a = Limits.pullback.fst v a' → ρ ≫ Limits.pullback.snd v a = Limits.pullback.snd v a' ≫ r → Surjective ρ :=
by
  intro Y X X' V v a a' r h hr ρ hfst hsnd
  subst h
  have hout : IsPullback (ρ ≫ Limits.pullback.fst v a) (Limits.pullback.snd v (r ≫ a)) v
      (r ≫ a) := by
    rw [hfst]; exact IsPullback.of_hasPullback v (r ≫ a)
  have hright : IsPullback (Limits.pullback.fst v a) (Limits.pullback.snd v a) v a :=
    IsPullback.of_hasPullback v a
  have hsq : IsPullback ρ (Limits.pullback.snd v (r ≫ a)) (Limits.pullback.snd v a) r :=
    IsPullback.of_right hout hsnd hright
  exact MorphismProperty.of_isPullback (P := @Surjective) hsq.flip hr

theorem wc_stage_sections_lift : ∀ (Y P T : Scheme.{u}) [IsAffine Y] [IsAffine P] [IsAffine T] (p : P ⟶ Y) (t : T ⟶ P) (V : Y.Etale), IsAffine V.left → (∀ (Y₀ V₀ T₀ : Scheme.{u}) [IsAffine Y₀] [IsAffine V₀] [IsAffine T₀] (v : V₀ ⟶ Y₀) (τ : T₀ ⟶ Y₀) (s : Γ(Limits.pullback v τ, ⊤)), ∃ (n : ℕ) (c : Fin n → Γ(V₀, ⊤)) (b : Fin n → Γ(T₀, ⊤)), s = ∑ i, (Limits.pullback.fst v τ).appTop (c i) * (Limits.pullback.snd v τ).appTop (b i)) → (∀ (F : Finset Γ(T, ⊤)) (b : Γ(T, ⊤)), b ∈ F → ∃ b' : Γ(wcStage t F, ⊤), (wcStageS t F).appTop b' = b) → ∀ (hc : ∀ F : Finset Γ(T, ⊤), wcStageS t F ≫ wcStageQ t F ≫ p = t ≫ p), (∀ F : Finset Γ(T, ⊤), wcPbρ (wcStageQ t F ≫ p) (t ≫ p) (wcStageS t F) (hc F) V ≫ Limits.pullback.fst V.hom (wcStageQ t F ≫ p) = Limits.pullback.fst V.hom (t ≫ p) ∧ wcPbρ (wcStageQ t F ≫ p) (t ≫ p) (wcStageS t F) (hc F) V ≫ Limits.pullback.snd V.hom (wcStageQ t F ≫ p) = Limits.pullback.snd V.hom (t ≫ p) ≫ wcStageS t F) → ∀ s : Γ(((wcEtBaseChange (t ≫ p)).obj V).left, ⊤), ∃ (F : Finset Γ(T, ⊤)) (s' : Γ(((wcEtBaseChange (wcStageQ t F ≫ p)).obj V).left, ⊤)), (wcPbρ (wcStageQ t F ≫ p) (t ≫ p) (wcStageS t F) (hc F) V).appTop s' = s :=
by
  classical
  intro Y P T _ _ _ p t V hV H8 Hst hc Hproj s
  have helper : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : Γ(C, ⊤)),
      (f ≫ g).appTop x = f.appTop (g.appTop x) := by
    intro A B C f g x
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
  obtain ⟨n, c, b, hs⟩ := @H8 Y V.left T _ hV _ V.hom (t ≫ p) s
  obtain ⟨F, hF⟩ : ∃ F : Finset Γ(T, ⊤), F = Finset.univ.image b := ⟨_, rfl⟩
  have hmem : ∀ i, b i ∈ F := fun i => hF ▸ Finset.mem_image_of_mem b (Finset.mem_univ i)
  choose b' hb' using fun i => Hst F (b i) (hmem i)
  obtain ⟨h₁, h₂⟩ := Hproj F
  have gen : ∀ (ρ : Limits.pullback V.hom (t ≫ p) ⟶ Limits.pullback V.hom (wcStageQ t F ≫ p)),
      ρ ≫ Limits.pullback.fst V.hom (wcStageQ t F ≫ p) = Limits.pullback.fst V.hom (t ≫ p) →
      ρ ≫ Limits.pullback.snd V.hom (wcStageQ t F ≫ p) =
        Limits.pullback.snd V.hom (t ≫ p) ≫ wcStageS t F →
      ρ.appTop (∑ i, (Limits.pullback.fst V.hom (wcStageQ t F ≫ p)).appTop (c i) *
        (Limits.pullback.snd V.hom (wcStageQ t F ≫ p)).appTop (b' i)) =
      ∑ i, (Limits.pullback.fst V.hom (t ≫ p)).appTop (c i) *
        (Limits.pullback.snd V.hom (t ≫ p)).appTop (b i) := by
    intro ρ e1 e2
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, ← helper, ← helper, e1, e2, helper, hb']
  exact ⟨F, ∑ i, (Limits.pullback.fst V.hom (wcStageQ t F ≫ p)).appTop (c i) *
      (Limits.pullback.snd V.hom (wcStageQ t F ≫ p)).appTop (b' i), (gen _ h₁ h₂).trans hs.symm⟩

theorem wc_et_integral_push_const_colim : ∀ (Y : Scheme.{u}) [IsAffine Y] (m : ℕ) (P : Scheme.{u}) (p : P ⟶ Y) [IsFinite p] (T : Scheme.{u}) [IsAffine T] (t : T ⟶ P) [IsIntegralHom t] [Surjective t], ∃ (J : Type u) (_ : SmallCategory J) (_ : IsFiltered J) (D : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (P' : J → Scheme.{u}) (p' : ∀ j, P' j ⟶ Y) (_ : ∀ j, IsFinite (p' j)) (_ : ∀ j, D.obj j ≅ (wcEtPush (p' j)).obj ((constantSheaf (Scheme.smallEtaleTopology (P' j)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (κ : D ⟶ (Functor.const J).obj ((wcEtPush (t ≫ p)).obj ((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))), Nonempty (Limits.IsColimit (Limits.Cocone.mk _ κ)) ∧ ∃ (j₀ : J) (w₀ : (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ⟶ D.obj j₀), ∀ (j : J) (f : j₀ ⟶ j), Mono (w₀ ≫ D.map f) :=
by
  intro Y _ m P p _ T _ t _ _
  haveI : IsAffine P := isAffine_of_isAffineHom p

  have eI : ∀ {X : Scheme.{u}} (a : X ⟶ Y), Nonempty
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (wcLCPb a (ULift.{u+1} (ZMod m))) ≅
      (wcEtPush a).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) := fun a =>
    wc_et_push_const_lc_iso a _ (wc_et_lc_isSheaf _ _) (wc_et_const_to_lc_locBij _ _)

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : (∀ {X X' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (r : X' ⟶ X)
      (_ : r ≫ a = a'), wcLCPb a (ULift.{u+1} (ZMod m)) ⟶ wcLCPb a' (ULift.{u+1} (ZMod m))),
      ∀ {X X' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (r : X' ⟶ X) (h : r ≫ a = a')
        (V : Y.Etale), (Θ a a' r h).app (Opposite.op V) = AddCommGrpCat.ofHom
          (LocallyConstant.comapAddMonoidHom ⟨wcPbρ a a' r h V, (wcPbρ a a' r h V).continuous⟩) :=
    ⟨fun a a' r h => (wc_lcpb_transfer a a' r h (ULift.{u+1} (ZMod m))).choose,
      fun a a' r h => (wc_lcpb_transfer a a' r h (ULift.{u+1} (ZMod m))).choose_spec⟩
  have hev : ∀ {X X' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (r : X' ⟶ X) (h : r ≫ a = a')
      (V : Y.Etale) (g : (wcLCPb a (ULift.{u+1} (ZMod m))).obj (Opposite.op V))
      (g' : (wcLCPb a' (ULift.{u+1} (ZMod m))).obj (Opposite.op V)),
      (∀ y, (show LocallyConstant ((wcEtBaseChange a).obj V).left (ULift.{u+1} (ZMod m)) from g)
          (wcPbρ a a' r h V y) =
        (show LocallyConstant ((wcEtBaseChange a').obj V).left (ULift.{u+1} (ZMod m)) from g') y) →
      ((Θ a a' r h).app (Opposite.op V)).hom g = g' := by
    intro X X' a a' r h V g g' hy
    rw [hΘ]
    refine LocallyConstant.ext fun y => ?_
    exact hy y
  have Θcomp : ∀ {X X' X'' : Scheme.{u}} (a : X ⟶ Y) (a' : X' ⟶ Y) (a'' : X'' ⟶ Y) (r : X' ⟶ X)
      (r' : X'' ⟶ X') (r'' : X'' ⟶ X) (h : r ≫ a = a') (h' : r' ≫ a' = a'') (h'' : r'' ≫ a = a''),
      r' ≫ r = r'' → Θ a a' r h ≫ Θ a' a'' r' h' = Θ a a'' r'' h'' := by
    intro X X' X'' a a' a'' r r' r'' h h' h'' hr
    apply NatTrans.ext
    funext V
    rcases V with ⟨V⟩
    rw [NatTrans.comp_app, hΘ, hΘ, hΘ]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro g
    refine LocallyConstant.ext fun y => ?_
    have e := wc_pbρ_laws.2.1 a a' a'' r r' r'' h h' h'' hr V
    change (show LocallyConstant ((wcEtBaseChange a).obj V).left (ULift.{u+1} (ZMod m)) from g)
        (wcPbρ a a' r h V (wcPbρ a' a'' r' h' V y)) =
      (show LocallyConstant ((wcEtBaseChange a).obj V).left (ULift.{u+1} (ZMod m)) from g)
        (wcPbρ a a'' r'' h'' V y)
    rw [← e, Scheme.Hom.comp_apply]
  have Θid : ∀ {X : Scheme.{u}} (a : X ⟶ Y) (r : X ⟶ X) (h : r ≫ a = a), r = 𝟙 X →
      Θ a a r h = 𝟙 _ := by
    intro X a r h hr
    apply NatTrans.ext
    funext V
    rcases V with ⟨V⟩
    rw [NatTrans.id_app, hΘ]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro g
    refine LocallyConstant.ext fun y => ?_
    have e := wc_pbρ_laws.2.2 a r h hr V
