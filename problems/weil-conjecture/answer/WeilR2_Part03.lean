          (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₀ C₁)
            (AlgHom.id C D)).toRingHom ∈ S := by
        convert hQ₃S using 1
        ext x
        simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [← hcomp]
        rfl
      obtain ⟨a, ha⟩ := hcov (Q₃.comap μ.toRingHom) hQ₁ hA hB
      exact ⟨a, ha⟩

  have hunion : ∀ S₁ S₂ : Set (Ideal (TensorProduct C C₀ D)),
      wcPropBAccPkg C D n E C₀ P₀ S₁ → wcPropBAccPkg C D n E C₀ P₀ S₂ →
      wcPropBAccPkg C D n E C₀ P₀ (S₁ ∪ S₂) := by
    intro S₁ S₂ h₁ h₂
    obtain ⟨C₁, _, _, _, _, _, P₁, hP₁, hP₁₀, m₁, e₁, k₁, he₁, hφ₁, hcov₁⟩ := h₁
    obtain ⟨C₂, _, _, _, _, _, P₂, hP₂, hP₂₀, m₂, e₂, k₂, he₂, hφ₂, hcov₂⟩ := h₂
    haveI := hP₁
    haveI := hP₂
    obtain ⟨P'', hP'', hL, hR⟩ := hs1 C₀ C₁ C₂ P₀ P₁ P₂ hP₁₀ hP₂₀
    haveI : Algebra.Etale C₀ (TensorProduct C₀ C₁ C₂) := Algebra.Etale.comp C₀ C₁ _
    obtain ⟨he₁', hφ₁', hcov₁'⟩ := hs2 C₁ (TensorProduct C₀ C₁ C₂)
      Algebra.TensorProduct.includeLeft P₁ P'' hL S₁ m₁ e₁ k₁ he₁ hφ₁ hcov₁
    obtain ⟨he₂', hφ₂', hcov₂'⟩ := hs2 C₂ (TensorProduct C₀ C₁ C₂)
      Algebra.TensorProduct.includeRight P₂ P'' hR S₂ m₂ e₂ k₂ he₂ hφ₂ hcov₂
    refine ⟨TensorProduct C₀ C₁ C₂, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, P'', hP'', ?_, m₁ + m₂,
      Fin.append (fun a => Algebra.TensorProduct.map
        ((Algebra.TensorProduct.includeLeft : C₁ →ₐ[C₀] TensorProduct C₀ C₁ C₂).restrictScalars C)
        (AlgHom.id C D) (e₁ a))
      (fun a => Algebra.TensorProduct.map
        ((Algebra.TensorProduct.includeRight : C₂ →ₐ[C₀] TensorProduct C₀ C₁ C₂).restrictScalars C)
        (AlgHom.id C D) (e₂ a)),
      Fin.append k₁ k₂, ?_, ?_, ?_⟩
    · rw [← hP₁₀, ← hL]
      ext x
      simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.includeLeft_apply]
    · intro a
      induction a using Fin.addCases with
      | left i => rw [Fin.append_left]; exact he₁' i
      | right i => rw [Fin.append_right]; exact he₂' i
    · intro a
      induction a using Fin.addCases with
      | left i => rw [Fin.append_left, Fin.append_left]; exact hφ₁' i
      | right i => rw [Fin.append_right, Fin.append_right]; exact hφ₂' i
    · intro Q hQ hQP hQS
      rcases hQS with h | h
      · obtain ⟨i, hi⟩ := hcov₁' Q hQ hQP h
        exact ⟨Fin.castAdd m₂ i, by rw [Fin.append_left]; exact hi⟩
      · obtain ⟨i, hi⟩ := hcov₂' Q hQ hQP h
        exact ⟨Fin.natAdd m₁ i, by rw [Fin.append_right]; exact hi⟩

  have hsing : ∀ Q : Ideal (TensorProduct C C₀ D), Q.IsPrime →
      Q.comap (Algebra.TensorProduct.includeLeft : C₀ →ₐ[C] TensorProduct C C₀ D).toRingHom = P₀ →
      wcPropBAccPkg C D n E C₀ P₀ {Q} := by
    intro Q hQ hQP
    obtain ⟨C₂, i1, i2, i3, i4, i5, P₂, hP₂, hP₂₀, e, i, he, hφ, hav⟩ := H Q hQ hQP
    exact ⟨C₂, i1, i2, i3, i4, i5, P₂, hP₂, hP₂₀, 1, fun _ => e, fun _ => i, fun _ => he,
      fun _ => hφ, fun Q₂ hQ₂ hQ₂P hQ₂S => ⟨0, hav Q₂ hQ₂ hQ₂P hQ₂S⟩⟩

  have hbase : wcPropBAccPkg C D n E C₀ P₀ ∅ :=
    ⟨C₀, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, P₀, hP₀,
      by ext x; exact Iff.rfl, 0, Fin.elim0, Fin.elim0, fun a => a.elim0, fun a => a.elim0,
      fun _ _ _ h => False.elim h⟩

  have hfin : {Q : Ideal (TensorProduct C C₀ D) | Q.IsPrime ∧
      Q.comap (Algebra.TensorProduct.includeLeft : C₀ →ₐ[C] TensorProduct C C₀ D).toRingHom
        = P₀}.Finite := by
    apply (Algebra.QuasiFinite.finite_primesOver P₀ (S := TensorProduct C C₀ D)).subset
    rintro Q ⟨hQ, hQP⟩
    refine ⟨hQ, ⟨?_⟩⟩
    rw [← hQP, Ideal.under_def]
    ext x
    simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.includeLeft_apply]
    rfl
  have hall : ∀ T : Finset (Ideal (TensorProduct C C₀ D)),
      (↑T : Set (Ideal (TensorProduct C C₀ D))) ⊆ {Q : Ideal (TensorProduct C C₀ D) | Q.IsPrime ∧
        Q.comap (Algebra.TensorProduct.includeLeft : C₀ →ₐ[C] TensorProduct C C₀ D).toRingHom
          = P₀} → wcPropBAccPkg C D n E C₀ P₀ ↑T := by
    classical
    intro T
    induction T using Finset.induction_on with
    | empty => intro _; rw [Finset.coe_empty]; exact hbase
    | insert Q T hQT ih =>
      intro hsub
      rw [Finset.coe_insert, Set.insert_eq]
      have hQ := hsub (Finset.mem_coe.mpr (Finset.mem_insert_self Q T))
      exact hunion _ _ (hsing Q hQ.1 hQ.2)
        (ih (fun x hx => hsub (Finset.mem_coe.mpr (Finset.mem_insert_of_mem hx))))
  have hS₀ := hall hfin.toFinset (by rw [Set.Finite.coe_toFinset])
  rw [Set.Finite.coe_toFinset] at hS₀
  obtain ⟨C₁, i1, i2, i3, i4, i5, P₁, hP₁, hP₁₀, m, e, k, he, hφ, hcov⟩ := hS₀
  haveI : Algebra.Etale C C₁ := Algebra.Etale.comp C C₀ C₁
  refine ⟨C₁, i1, i3, inferInstance, P₁, hP₁, ?_, m, e, k, he, hφ, ?_⟩
  · rw [IsScalarTower.algebraMap_eq C C₀ C₁, ← Ideal.comap_comap, hP₁₀, hP₀p]
  · intro Q' hQ' hQ'P
    apply hcov Q' hQ' hQ'P
    refine ⟨Ideal.IsPrime.comap _, ?_⟩
    have hpt : ∀ x : C₀, (Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C₀ C₁)
        (AlgHom.id C D)) (Algebra.TensorProduct.includeLeft (S := C) x : TensorProduct C C₀ D) =
        Algebra.TensorProduct.includeLeft (S := C) (algebraMap C₀ C₁ x) := by
      intro x
      simp [Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.map_tmul]
    rw [← hP₁₀, ← hQ'P]
    ext x
    simp only [Ideal.mem_comap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [hpt]

theorem wc_ring_propB_assemble : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Module.Finite C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] (p : Ideal C) (C' : Type u) [CommRing C'] [Algebra C C'] [Algebra.Etale C C'] (P' : Ideal C'), P'.IsPrime → P'.comap (algebraMap C C') = p → ∀ (m : ℕ) (e : Fin m → TensorProduct C C' D) (k : Fin m → Fin n), (∀ a, IsIdempotentElem (e a)) → (∀ a, ∃ φ : E (k a) →+* Localization.Away (e a), φ.comp (algebraMap D (E (k a))) = (algebraMap (TensorProduct C C' D) (Localization.Away (e a))).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D).toRingHom) → (∀ Q' : Ideal (TensorProduct C C' D), Q'.IsPrime → Q'.comap (Algebra.TensorProduct.includeLeft : C' →ₐ[C] TensorProduct C C' D).toRingHom = P' → ∃ a, e a ∉ Q') → ∃ (C'' : Type u) (_ : CommRing C'') (_ : Algebra C C'') (_ : Algebra.Etale C C'') (P : Ideal C''), P.IsPrime ∧ P.comap (algebraMap C C'') = p ∧ ∃ (m : ℕ) (ε : Fin m → TensorProduct C C'' D) (k : Fin m → Fin n), (∀ a, IsIdempotentElem (ε a)) ∧ (∀ a b, a ≠ b → ε a * ε b = 0) ∧ ∑ a, ε a = 1 ∧ ∀ a, ∃ φ : E (k a) →+* Localization.Away (ε a), φ.comp (algebraMap D (E (k a))) = (algebraMap (TensorProduct C C'' D) (Localization.Away (ε a))).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C'' D).toRingHom :=
by
  intro C D _ _ _ _ n E _ _ p C' _ _ _ P' hP' hP'p m e k he hφ hcov
  classical

  have s1 : ∀ (B : Type u) [CommRing B] (m : ℕ) (e : Fin m → B), (∀ a, IsIdempotentElem (e a)) →
      ∃ δ : Fin m → B, (∀ a, IsIdempotentElem (δ a)) ∧ (∀ a b, a ≠ b → δ a * δ b = 0) ∧
        (∀ a, e a * δ a = δ a) ∧ ∑ a, δ a + ∏ a, (1 - e a) = 1 := by
    intro B _ m
    induction m with
    | zero =>
      intro e _
      exact ⟨fun a => a.elim0, fun a => a.elim0, fun a => a.elim0, fun a => a.elim0, by simp⟩
    | succ m ih =>
      intro e he
      obtain ⟨δ', hI, hO, hA, hS⟩ := ih (fun i => e i.castSucc) (fun i => he _)
      have hπI : IsIdempotentElem (∏ i : Fin m, (1 - e i.castSucc)) := by
        apply Finset.prod_induction _ IsIdempotentElem (fun a b ha hb => ha.mul hb)
          IsIdempotentElem.one
        intro i _
        exact (he _).one_sub
      have hδπ : ∀ i, δ' i * ∏ i : Fin m, (1 - e i.castSucc) = 0 := by
        intro i
        rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i), ← mul_assoc, mul_sub,
          mul_one, mul_comm (δ' i), hA i, sub_self, zero_mul]
      refine ⟨Fin.snoc (α := fun _ => B) δ' (e (Fin.last m) * ∏ i : Fin m, (1 - e i.castSucc)),
        ?_, ?_, ?_, ?_⟩
      · intro a
        induction a using Fin.lastCases with
        | last => rw [Fin.snoc_last]; exact (he _).mul hπI
        | cast i => rw [Fin.snoc_castSucc]; exact hI i
      · intro a b hab
        induction a using Fin.lastCases with
        | last =>
          induction b using Fin.lastCases with
          | last => exact absurd rfl hab
          | cast j =>
            rw [Fin.snoc_last, Fin.snoc_castSucc, mul_assoc, mul_comm _ (δ' j), hδπ, mul_zero]
        | cast i =>
          induction b using Fin.lastCases with
          | last =>
            rw [Fin.snoc_last, Fin.snoc_castSucc, mul_left_comm, hδπ, mul_zero]
          | cast j =>
            rw [Fin.snoc_castSucc, Fin.snoc_castSucc]
            exact hO i j (fun h => hab (h ▸ rfl))
      · intro a
        induction a using Fin.lastCases with
        | last => rw [Fin.snoc_last, ← mul_assoc, (he _).eq]
        | cast i => rw [Fin.snoc_castSucc]; exact hA i
      · rw [Fin.sum_univ_castSucc, Fin.prod_univ_castSucc]
        simp only [Fin.snoc_last, Fin.snoc_castSucc]
        linear_combination hS
  obtain ⟨δ, hI, hO, hA, hS⟩ := s1 _ m e he

  have hδ₀I : IsIdempotentElem (∏ a, (1 - e a)) := by
    apply Finset.prod_induction _ IsIdempotentElem (fun a b ha hb => ha.mul hb)
      IsIdempotentElem.one
    intro i _
    exact (he _).one_sub
  have hfib : ∀ Q : Ideal (TensorProduct C C' D), Q.IsPrime →
      Q.comap (algebraMap C' (TensorProduct C C' D)) = P' → ∏ a, (1 - e a) ∈ Q := by
    intro Q hQ hQP
    obtain ⟨a, ha⟩ := hcov Q hQ hQP
    have h1 : e a * (1 - e a) ∈ Q := by
      rw [mul_sub, mul_one, (he a).eq, sub_self]; exact Q.zero_mem
    have h2 : 1 - e a ∈ Q := (hQ.mem_or_mem h1).resolve_left ha
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ a)]
    exact Q.mul_mem_right _ h2
  haveI := hP'

  obtain ⟨c, hcP, hc⟩ : ∃ c : C', c ∉ P' ∧
      algebraMap C' (TensorProduct C C' D) c * ∏ a, (1 - e a) = 0 := by
    by_contra H
    push_neg at H
    have hle : Ideal.under C' (Ideal.span {1 - ∏ a, (1 - e a)}) ≤ P' := by
      intro r hr
      rw [Ideal.under, Ideal.mem_comap, Ideal.mem_span_singleton'] at hr
      obtain ⟨b, hb⟩ := hr
      by_contra hrP
      apply H r hrP
      rw [← hb, mul_assoc, sub_mul, one_mul, hδ₀I.eq, sub_self, mul_zero]
    obtain ⟨Q, hQI, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P' _ hle
    have h1 : 1 - ∏ a, (1 - e a) ∈ Q := hQI (Ideal.mem_span_singleton_self _)
    have h2 : ∏ a, (1 - e a) ∈ Q := hfib Q hQ hQP
    apply hQ.ne_top
    rw [Ideal.eq_top_iff_one]
    have := Q.add_mem h1 h2
    rwa [sub_add_cancel] at this

  have hdisj : Disjoint (Submonoid.powers c : Set C') (P' : Set C') := by
    rw [Set.disjoint_left]
    rintro x ⟨j, rfl⟩ hxP
    exact hcP (hP'.mem_of_pow_mem j hxP)
  have hPprime : (Ideal.map (algebraMap C' (Localization.Away c)) P').IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers c) _ P' hP' hdisj
  have hPcomap : (Ideal.map (algebraMap C' (Localization.Away c)) P').comap
      (algebraMap C (Localization.Away c)) = p := by
    have h : (Ideal.map (algebraMap C' (Localization.Away c)) P').comap
        (algebraMap C' (Localization.Away c)) = P' :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers c) (Localization.Away c)
        hP' hdisj
    rw [IsScalarTower.algebraMap_eq C C' (Localization.Away c), ← Ideal.comap_comap, h, hP'p]
  haveI : Algebra.Etale C (Localization.Away c) := Algebra.Etale.comp C C' (Localization.Away c)

  let θ : TensorProduct C C' D →ₐ[C] TensorProduct C (Localization.Away c) D :=
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom C C' (Localization.Away c)) (AlgHom.id C D)
  have hθunit : IsUnit (θ (algebraMap C' (TensorProduct C C' D) c)) := by
    have h : θ (algebraMap C' (TensorProduct C C' D) c) =
        algebraMap (Localization.Away c) (TensorProduct C (Localization.Away c) D)
          (algebraMap C' (Localization.Away c) c) := by
      simp [θ, Algebra.TensorProduct.algebraMap_apply]
    rw [h]
    exact (IsLocalization.Away.algebraMap_isUnit c).map _
  have hθ0 : θ (∏ a, (1 - e a)) = 0 := by
    have h := congrArg θ hc
    rw [map_mul, map_zero] at h
    exact hθunit.mul_right_eq_zero.mp h
  refine ⟨Localization.Away c, inferInstance, inferInstance, inferInstance,
    Ideal.map (algebraMap C' (Localization.Away c)) P', hPprime, hPcomap, m,
    fun a => θ (δ a), k, ?_, ?_, ?_, ?_⟩
  · intro a
    exact (hI a).map θ
  · intro a b hab
    simp only
    rw [← map_mul, hO a b hab, map_zero]
  · rw [← map_sum, eq_sub_of_add_eq hS, map_sub, map_one, hθ0, sub_zero]
  · intro a
    obtain ⟨φ, hφa⟩ := hφ a
    let g : TensorProduct C C' D →+* Localization.Away (θ (δ a)) :=
      (algebraMap (TensorProduct C (Localization.Away c) D) (Localization.Away (θ (δ a)))).comp
        θ.toRingHom
    have hge : IsUnit (g (e a)) := by
      have hu : IsUnit (g (δ a)) := IsLocalization.Away.algebraMap_isUnit (θ (δ a))
      have h1 : g (e a) * g (δ a) = g (δ a) := by rw [← map_mul, hA a]
      have h2 : g (e a) = 1 := hu.mul_eq_right.mp h1
      rw [h2]; exact isUnit_one
    let ψ : Localization.Away (e a) →+* Localization.Away (θ (δ a)) :=
      IsLocalization.Away.lift (e a) hge
    have hψ : ψ.comp (algebraMap (TensorProduct C C' D) (Localization.Away (e a))) = g :=
      IsLocalization.Away.lift_comp (e a) hge
    refine ⟨ψ.comp φ, ?_⟩
    rw [RingHom.comp_assoc, hφa, ← RingHom.comp_assoc, hψ]
    apply RingHom.ext
    intro d
    simp [g, θ]

theorem wc_ring_propB_finite : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Module.Finite C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] [∀ i, Algebra.Etale D (E i)], (∀ q : Ideal D, q.IsPrime → ∃ (i : Fin n) (r : Ideal (E i)), r.IsPrime ∧ r.comap (algebraMap D (E i)) = q) → ∀ p : Ideal C, p.IsPrime → ∃ (C' : Type u) (_ : CommRing C') (_ : Algebra C C') (_ : Algebra.Etale C C') (P : Ideal C'), P.IsPrime ∧ P.comap (algebraMap C C') = p ∧ ∃ (m : ℕ) (ε : Fin m → TensorProduct C C' D) (k : Fin m → Fin n), (∀ a, IsIdempotentElem (ε a)) ∧ (∀ a b, a ≠ b → ε a * ε b = 0) ∧ ∑ a, ε a = 1 ∧ ∀ a, ∃ φ : E (k a) →+* Localization.Away (ε a), φ.comp (algebraMap D (E (k a))) = (algebraMap (TensorProduct C C' D) (Localization.Away (ε a))).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D).toRingHom :=
by
  intro C D _ _ _ _ n E _ _ _ hcov p hp
  obtain ⟨C₀, _, _, _, P₀, hP₀, hP₀p, hsplit⟩ := wc_ring_propB_split C D n E hcov p hp
  haveI := hP₀
  obtain ⟨C', _, _, _, P', hP', hP'p, m, e, k, he, hφ, hcovQ⟩ :=
    wc_ring_propB_accumulate C D n E p C₀ P₀ hP₀ hP₀p (by
      intro Q hQ hQP
      haveI := hQ
      obtain ⟨i, r, hr, hrQ, σ, hσ⟩ := hsplit Q hQP
      haveI := hr
      obtain ⟨C₂, i1, i2, i3, i4, i5, P₂, hP₂, hP₂P, e, he, hφ, hav⟩ :=
        wc_ring_propB_point C D (E i) C₀ P₀ Q hQP r hrQ σ hσ
      exact ⟨C₂, i1, i2, i3, i4, i5, P₂, hP₂, hP₂P, e, i, he, hφ, hav⟩)
  exact wc_ring_propB_assemble C D n E p C' P' hP' hP'p m e k he hφ hcovQ

theorem wc_ring_propB_integral_of_finite : (∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Algebra.IsIntegral C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] [∀ i, Algebra.Etale D (E i)], ∃ (D' : Subalgebra C D), Module.Finite C D' ∧ ∃ (E' : Fin n → Type u) (_ : ∀ i, CommRing (E' i)) (_ : ∀ i, Algebra D' (E' i)), (∀ i, Algebra.Etale D' (E' i)) ∧ ∀ i, Nonempty (TensorProduct D' D (E' i) ≃ₐ[D] E i)) → (∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Module.Finite C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] [∀ i, Algebra.Etale D (E i)], (∀ q : Ideal D, q.IsPrime → ∃ (i : Fin n) (r : Ideal (E i)), r.IsPrime ∧ r.comap (algebraMap D (E i)) = q) → ∀ p : Ideal C, p.IsPrime → ∃ (C' : Type u) (_ : CommRing C') (_ : Algebra C C') (_ : Algebra.Etale C C') (P : Ideal C'), P.IsPrime ∧ P.comap (algebraMap C C') = p ∧ ∃ (m : ℕ) (ε : Fin m → TensorProduct C C' D) (k : Fin m → Fin n), (∀ a, IsIdempotentElem (ε a)) ∧ (∀ a b, a ≠ b → ε a * ε b = 0) ∧ ∑ a, ε a = 1 ∧ ∀ a, ∃ φ : E (k a) →+* Localization.Away (ε a), φ.comp (algebraMap D (E (k a))) = (algebraMap (TensorProduct C C' D) (Localization.Away (ε a))).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D).toRingHom) → ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Algebra.IsIntegral C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] [∀ i, Algebra.Etale D (E i)], (∀ q : Ideal D, q.IsPrime → ∃ (i : Fin n) (r : Ideal (E i)), r.IsPrime ∧ r.comap (algebraMap D (E i)) = q) → ∀ p : Ideal C, p.IsPrime → ∃ (C' : Type u) (_ : CommRing C') (_ : Algebra C C') (_ : Algebra.Etale C C') (P : Ideal C'), P.IsPrime ∧ P.comap (algebraMap C C') = p ∧ ∃ (m : ℕ) (ε : Fin m → TensorProduct C C' D) (k : Fin m → Fin n), (∀ a, IsIdempotentElem (ε a)) ∧ (∀ a b, a ≠ b → ε a * ε b = 0) ∧ ∑ a, ε a = 1 ∧ ∀ a, ∃ φ : E (k a) →+* Localization.Away (ε a), φ.comp (algebraMap D (E (k a))) = (algebraMap (TensorProduct C C' D) (Localization.Away (ε a))).comp (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D).toRingHom :=
by
  intro Hdesc Hfin C D _ _ _ _ n E _ _ _ hcov p hp
  obtain ⟨D', hD'fin, E', instCR, instAlg, hEt, he⟩ := Hdesc C D n E
  haveI := hD'fin

  have hcov' : ∀ q' : Ideal D', q'.IsPrime → ∃ (i : Fin n) (r : Ideal (E' i)), r.IsPrime ∧
      r.comap (algebraMap D' (E' i)) = q' := by
    intro q' hq'
    haveI := hq'
    haveI : Algebra.IsIntegral D' D := Algebra.IsIntegral.tower_top C
    have hle : Ideal.under D' (⊥ : Ideal D) ≤ q' := by
      rw [Ideal.under_def, Ideal.comap_bot_of_injective _ Subtype.val_injective]
      exact bot_le
    obtain ⟨Q, -, hQ, hQq⟩ := Ideal.exists_ideal_over_prime_of_isIntegral q' ⊥ hle
    obtain ⟨i, r, hr, hrQ⟩ := hcov Q hQ
    haveI := hr
    let e := (he i).some
    let ψ : E' i →+* E i := e.toRingHom.comp
      (Algebra.TensorProduct.includeRight : E' i →ₐ[D'] TensorProduct D' D (E' i)).toRingHom
    have hsq : ψ.comp (algebraMap D' (E' i)) = (algebraMap D (E i)).comp (algebraMap D' D) := by
      ext x
      show e (Algebra.TensorProduct.includeRight (algebraMap D' (E' i) x)) = _
      rw [AlgHom.commutes]
      first
        | (change e (algebraMap D (TensorProduct D' D (E' i)) (algebraMap D' D x)) =
              algebraMap D (E i) (algebraMap D' D x)
           exact e.commutes _)
        | (have h2 : (algebraMap D' (TensorProduct D' D (E' i))) x =
              algebraMap D (TensorProduct D' D (E' i)) (algebraMap D' D x) := by
             simp [Algebra.TensorProduct.algebraMap_apply]
           rw [RingHom.comp_apply, ← e.commutes]
           exact congrArg e h2)
    refine ⟨i, r.comap ψ, Ideal.IsPrime.comap ψ, ?_⟩
    rw [Ideal.comap_comap, hsq, ← Ideal.comap_comap, hrQ, ← hQq, Ideal.under_def]

  obtain ⟨C', instC', instCC', hC'et, P, hP, hPp, m, ε', k, hid', horth', hsum', hφ'⟩ :=
    Hfin C D' n E' hcov' p hp

  let θ : TensorProduct C C' D' →ₐ[C] TensorProduct C C' D :=
    Algebra.TensorProduct.map (AlgHom.id C C') D'.val
  refine ⟨C', instC', instCC', hC'et, P, hP, hPp, m, fun a => θ (ε' a), k,
    fun a => (hid' a).map θ, ?_, ?_, ?_⟩
  · intro a b hab
    show θ (ε' a) * θ (ε' b) = 0
    rw [← map_mul, horth' a b hab, map_zero]
  · show ∑ a, θ (ε' a) = 1
    rw [← map_sum, hsum', map_one]

  · intro a
    obtain ⟨φ', hφ'a⟩ := hφ' a
    let L := Localization.Away (θ (ε' a))
    let lam : Localization.Away (ε' a) →+* L := Localization.awayMap θ.toRingHom (ε' a)
    have hlam : ∀ y, lam (algebraMap _ _ y) = algebraMap _ L (θ y) := by
      intro y
      exact IsLocalization.map_eq _ _
    let β : D →+* L := (algebraMap (TensorProduct C C' D) L).comp
      (Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D).toRingHom
    let g : E' (k a) →+* L := lam.comp φ'
    have hg : ∀ x : D', g (algebraMap D' (E' (k a)) x) = β x := by
      intro x
      have h1 := congrArg (fun f => f x) hφ'a
      simp only [RingHom.comp_apply] at h1
      show lam (φ' (algebraMap D' (E' (k a)) x)) = _
      rw [h1, hlam]
      change algebraMap (TensorProduct C C' D) L
          (θ ((Algebra.TensorProduct.includeRight : D' →ₐ[C] TensorProduct C C' D') x)) =
        algebraMap (TensorProduct C C' D) L
          ((Algebra.TensorProduct.includeRight : D →ₐ[C] TensorProduct C C' D) (x : D))
      congr 1
    letI : Algebra D L := β.toAlgebra
    let gt : E' (k a) →ₐ[D'] L := ⟨g, fun x => (hg x).trans rfl⟩
    let Φ : TensorProduct D' D (E' (k a)) →ₐ[D] L :=
      Algebra.TensorProduct.lift (Algebra.ofId D L) gt (fun _ _ => Commute.all _ _)
    let e := (he (k a)).some
    refine ⟨Φ.toRingHom.comp e.symm.toRingHom, ?_⟩
    ext d
    show Φ (e.symm (algebraMap D (E (k a)) d)) = β d
    rw [e.symm.commutes, Φ.commutes]
    rfl

theorem wc_etale_descend_finite_subalgebra : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [Algebra.IsIntegral C D] (n : ℕ) (E : Fin n → Type u) [∀ i, CommRing (E i)] [∀ i, Algebra D (E i)] [∀ i, Algebra.Etale D (E i)], ∃ (D' : Subalgebra C D), Module.Finite C D' ∧ ∃ (E' : Fin n → Type u) (_ : ∀ i, CommRing (E' i)) (_ : ∀ i, Algebra D' (E' i)), (∀ i, Algebra.Etale D' (E' i)) ∧ ∀ i, Nonempty (TensorProduct D' D (E' i) ≃ₐ[D] E i) :=
by
  intro C D _ _ _ _ n E _ _ _

  have key : ∀ (A₀ D' : Subalgebra C D), A₀ ≤ D' → ∀ (B₀ : Type u) [CommRing B₀]
      [Algebra A₀ B₀] [Algebra.Etale A₀ B₀] (E : Type u) [CommRing E] [Algebra D E],
      Nonempty (E ≃ₐ[D] TensorProduct A₀ D B₀) → ∃ (E' : Type u) (_ : CommRing E')
        (_ : Algebra D' E'), Algebra.Etale D' E' ∧ Nonempty (TensorProduct D' D E' ≃ₐ[D] E) := by
    intro A₀ D' h B₀ _ _ _ E₀ _ _ ⟨e⟩
    letI : Algebra A₀ D' := (Subalgebra.inclusion h).toAlgebra
    haveI : IsScalarTower A₀ D' D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    exact ⟨TensorProduct A₀ D' B₀, inferInstance, inferInstance,
      Algebra.Etale.baseChange A₀ B₀ D',
      ⟨(Algebra.TensorProduct.cancelBaseChange A₀ D' D D B₀).trans e.symm⟩⟩

  have h1 := fun i => Algebra.Etale.exists_subalgebra_fg C D (E i)
  choose A B hBr hBa hFG hEt he using h1
  have h2 : ∀ i, ∃ t : Set D, t.Finite ∧ Algebra.adjoin C t = A i :=
    fun i => Subalgebra.fg_def.mp (hFG i)
  choose t ht_fin ht_eq using h2
  have hs : (⋃ i, t i).Finite := Set.finite_iUnion ht_fin
  have hfin : Module.Finite C (Algebra.adjoin C (⋃ i, t i)) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral hs (fun x _ => Algebra.IsIntegral.isIntegral x)
  have hle : ∀ i, A i ≤ Algebra.adjoin C (⋃ i, t i) := fun i => by
    rw [← ht_eq i]
    exact Algebra.adjoin_mono (Set.subset_iUnion t i)
  have h3 : ∀ i, ∃ (E' : Type u) (_ : CommRing E') (_ : Algebra (Algebra.adjoin C (⋃ i, t i)) E'),
      Algebra.Etale (Algebra.adjoin C (⋃ i, t i)) E' ∧
      Nonempty (TensorProduct (Algebra.adjoin C (⋃ i, t i)) D E' ≃ₐ[D] E i) := by
    intro i
    letI := hBr i
    letI := hBa i
    haveI := hEt i
    exact key (A i) _ (hle i) (B i) (E i) (he i)
  choose E' hEr hEa hEet hiso using h3
  exact ⟨_, hfin, E', hEr, hEa, hEet, hiso⟩

theorem wc_et_integral_push_exact : ∀ {Y T : Scheme.{u}} (τ : T ⟶ Y) [IsIntegralHom τ], Limits.PreservesFiniteColimits (wcEtPush τ) :=
by
  intro Y T τ _

  have hB := wc_et_propB_of_ring_propB
    (wc_ring_propB_integral_of_finite wc_etale_descend_finite_subalgebra wc_ring_propB_finite) τ

  have hloc := wc_et_push_locSurj_of_propB τ hB

  haveI hepi : (wcEtPush τ).PreservesEpimorphisms := by
    constructor
    intro F G φ hφ
    have h1 := hloc F G φ hφ
    have h2 : Sheaf.IsLocallySurjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcEtBaseChange τ).op φ.hom)) :=
      (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr h1
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp h2
  haveI : (wcEtPush τ).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels (wcEtPush τ)
  have hiff : (wcEtPush τ).PreservesHomology ↔
      (Limits.PreservesFiniteLimits (wcEtPush τ) ∧ Limits.PreservesFiniteColimits (wcEtPush τ)) :=
    (Functor.exact_tfae (wcEtPush τ)).out 3 4
  exact (hiff.mp inferInstance).2

theorem wc_et_supp_left_adjoint_pullback : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → ∀ (S : Set B) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), wcSuppIn B S F → wcSuppIn X (g ⁻¹' S) (L.obj F) :=
by

  have s1 : ∀ (Y : Scheme.{u}) (W : Set Y) (P : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : P.obj (Opposite.op U), p = 0) →
      ∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) →
      ∀ t : (sheafify (Scheme.smallEtaleTopology Y) P).obj (Opposite.op U), t = 0 := by
    intro Y W P hP U hU t
    haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) P) t
    have hsep := Sheaf.isSeparated
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P)
    refine hsep U _ hI t 0 ?_
    intro U' h hh
    obtain ⟨p, hp⟩ := hh
    have hU' : ∀ x, U'.hom x ∈ W := by
      intro x
      rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
      exact hU _
    rw [hP U' hU' p, map_zero] at hp
    rw [map_zero]
    exact hp.symm

  have s2 : ∀ (Y : Scheme.{u}) (W : Set Y) (F H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      wcSuppIn Y W F →
      (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ t : H.obj.obj (Opposite.op U), t = 0) →
      ∀ φ : F ⟶ H, φ = 0 := by
    intro Y W F H hF hH φ
    have key : ∀ (V : Y.Etale) (s : F.obj.obj (Opposite.op V)),
        φ.hom.app (Opposite.op V) s = 0 := by
      intro V s
      refine Sheaf.isSeparated H V _ (hF V s) _ 0 ?_
      intro V'' f hf
      obtain ⟨V', a, b, hb, rfl⟩ := hf
      have hnat : H.obj.map b.op (φ.hom.app (Opposite.op V) s) =
          φ.hom.app (Opposite.op V') (F.obj.map b.op s) :=
        (NatTrans.naturality_apply φ.hom b.op s).symm
      rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
      rcases hb with h0 | hW
      · rw [hnat, h0, map_zero, map_zero]
      · rw [hH V' hW (H.obj.map b.op (φ.hom.app (Opposite.op V) s)), map_zero]
    apply Sheaf.hom_ext
    ext V s
    exact (key V.unop s).trans rfl

  have s3 : ∀ (Y : Scheme.{u}) (W : Set Y) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      (∀ (P : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (π : G.obj ⟶ P),
        (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : P.obj (Opposite.op U), p = 0) →
        π ≫ toSheafify (Scheme.smallEtaleTopology Y) P = 0) → wcSuppIn Y W G := by
    intro Y W G hG
    have hM : ∀ {U U' : Y.Etale} (h : U' ⟶ U), (∀ x, U.hom x ∈ W) → ∀ x, U'.hom x ∈ W := by
      intro U U' h hU x
      rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
      exact hU _
    let K : ∀ U : Y.Etale, AddSubgroup (G.obj.obj (Opposite.op U)) :=
      fun U => ⨆ (_ : ∀ x, U.hom x ∈ W), ⊤
    have hK : ∀ (U : Y.Etale) (y : G.obj.obj (Opposite.op U)),
        y ∈ K U ↔ ((∀ x, U.hom x ∈ W) ∨ y = 0) := by
      intro U y
      by_cases hU : ∀ x, U.hom x ∈ W
      · simp only [K, iSup_pos hU]
        simp [hU]
      · simp only [K, iSup_neg hU]
        rw [AddSubgroup.mem_bot]
        exact ⟨Or.inr, fun h => h.resolve_left hU⟩
    have hle : ∀ {U U' : Y.Etale} (h : U' ⟶ U),
        K U ≤ (K U').comap (G.obj.map h.op).hom := by
      intro U U' h y hy
      rw [AddSubgroup.mem_comap, hK]
      rcases (hK U y).mp hy with hU | hy0
      · exact Or.inl (hM h hU)
      · right
        rw [hy0, map_zero]
    let Q : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun U => AddCommGrpCat.of (G.obj.obj U ⧸ K U.unop)
        map := fun {U U'} h => AddCommGrpCat.ofHom
          (QuotientAddGroup.map (K U.unop) (K U'.unop) (G.obj.map h).hom (hle h.unop))
        map_id := fun U => by
          apply AddCommGrpCat.hom_ext
          refine QuotientAddGroup.addMonoidHom_ext _ ?_
          ext y
          simp
        map_comp := fun f g => by
          apply AddCommGrpCat.hom_ext
          refine QuotientAddGroup.addMonoidHom_ext _ ?_
          ext y
          simp }
    let π : G.obj ⟶ Q :=
      { app := fun U => AddCommGrpCat.ofHom (QuotientAddGroup.mk' (K U.unop))
        naturality := fun U U' h => by
          apply AddCommGrpCat.hom_ext
          ext y
          rfl }
    have hQ : ∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : Q.obj (Opposite.op U), p = 0 := by
      intro U hU p
      obtain ⟨y, rfl⟩ : ∃ y : G.obj.obj (Opposite.op U),
          (QuotientAddGroup.mk y : G.obj.obj (Opposite.op U) ⧸ K U) = p :=
        QuotientAddGroup.mk_surjective p
      exact (QuotientAddGroup.eq_zero_iff y).mpr ((hK U y).mpr (Or.inl hU))
    intro V s
    have h0 := hG Q π hQ
    have h1 : (toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V)
        (QuotientAddGroup.mk s : G.obj.obj (Opposite.op V) ⧸ K V) =
        (toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V) 0 := by
      rw [map_zero]
      have h2 : (π ≫ toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V) = 0 := by
        rw [h0]; rfl
      exact (ConcreteCategory.congr_hom h2 s).trans rfl
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Y) Q
    have hE := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) Q) _ _ h1
    refine GrothendieckTopology.superset_covering _ ?_ hE
    intro V' f hf
    apply Sieve.le_generate
    rw [Presheaf.equalizerSieve_apply, map_zero] at hf
    have hf' : (QuotientAddGroup.mk (G.obj.map f.op s) :
        G.obj.obj (Opposite.op V') ⧸ K V') = 0 := hf
    rcases (hK V' _).mp ((QuotientAddGroup.eq_zero_iff _).mp hf') with hW | hz
    · exact Or.inr hW
    · exact Or.inl hz

  intro X B g L hadj S F hF
  obtain ⟨adj⟩ := hadj
  apply s3 X (g ⁻¹' S) (L.obj F)
  intro P π hP
  let H := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P
  let q : L.obj F ⟶ H := ObjectProperty.homMk (π ≫ toSheafify (Scheme.smallEtaleTopology X) P)
  have hH : ∀ (U : X.Etale), (∀ x, U.hom x ∈ g ⁻¹' S) → ∀ t : H.obj.obj (Opposite.op U), t = 0 :=
    fun U hU t => s1 X (g ⁻¹' S) P hP U hU t
  have hpush : ∀ (V : B.Etale), (∀ x, V.hom x ∈ S) →
      ∀ t : ((wcEtPush g).obj H).obj.obj (Opposite.op V), t = 0 := by
    intro V hV t
    refine s1 B S ((wcEtBaseChange g).op ⋙ H.obj) ?_ V hV t
    intro V' hV' p
    refine hH ((wcEtBaseChange g).obj V') ?_ p
    show ∀ z : ↥(Limits.pullback V'.hom g), g (Limits.pullback.snd V'.hom g z) ∈ S
    intro z
    have e1 : (Limits.pullback.fst V'.hom g ≫ V'.hom) z = (Limits.pullback.snd V'.hom g ≫ g) z := by
      rw [Limits.pullback.condition]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
    rw [← e1]
    exact hV' _
  have hq' : adj.homEquiv F H q = 0 := s2 B S F ((wcEtPush g).obj H) hF hpush _
  have hq : q = 0 := by
    apply (adj.homEquiv F H).injective
    rw [hq', Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  show q.hom = 0
  rw [hq]
  rfl

theorem wc_et_quot_acyclic_integral_push : ∀ (Y T : Scheme.{u}) (τ : T ⟶ Y) [IsIntegralHom τ] [Limits.PreservesFiniteColimits (wcEtPush τ)] (W : Set Y), IsOpen W → ∀ (F : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}), (∀ (F' : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (ιF : F' ⟶ F), Mono ιF → wcSuppIn T (τ ⁻¹' W) F' → (∀ (H₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ F), wcSuppIn T (τ ⁻¹' W) H₂ → ∃ χ' : H₂ ⟶ F', χ' ≫ ιF = χ) → ∀ q : ℕ, Subsingleton (wcEtExt T (Limits.cokernel ιF) (q + 1))) → ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιH : H ⟶ (wcEtPush τ).obj F), Mono ιH → wcSuppIn Y W H → (∀ (H₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ (wcEtPush τ).obj F), wcSuppIn Y W H₂ → ∃ χ' : H₂ ⟶ H, χ' ≫ ιH = χ) → ∀ q : ℕ, Subsingleton (wcEtExt Y (Limits.cokernel ιH) (q + 1)) :=
by
  intro Y T τ _ _ W hW F hT H ιH hHmono hHsupp hHuniv q

  obtain ⟨F', ιF, hFmono, hFsupp, hFuniv⟩ := wc_et_max_supported_subsheaf T (τ ⁻¹' W) F
  haveI := hFmono
  haveI := hHmono

  obtain ⟨L, ⟨adj⟩, hLlim, ⟨eL⟩⟩ := wc_et_push_left_adjoint τ

  have hfac : ∀ (H₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (χ : H₂ ⟶ (wcEtPush τ).obj F), wcSuppIn Y W H₂ →
      ∃ χ' : H₂ ⟶ (wcEtPush τ).obj F', χ' ≫ (wcEtPush τ).map ιF = χ := by
    intro H₂ χ hH₂
    obtain ⟨φ', hφ'⟩ := hFuniv (L.obj H₂) ((adj.homEquiv H₂ F).symm χ)
      (wc_et_supp_left_adjoint_pullback τ L ⟨adj⟩ W H₂ hH₂)
    refine ⟨adj.homEquiv H₂ F' φ', ?_⟩
    rw [← Adjunction.homEquiv_naturality_right, hφ', Equiv.apply_symm_apply]

  have s1T : ∀ (V : T.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology T V →
      ∀ v : V.left, ∃ (V₁ : T.Etale) (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left := by
    have gen : ∀ (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] [P.IsMultiplicative]
        (S : Scheme.{u}) (X : P.Over ⊤ S) (R : Sieve X),
        R ∈ Scheme.smallGrothendieckTopology P S X → ∀ v : X.left,
        ∃ (X₁ : P.Over ⊤ S) (c : X₁ ⟶ X), R.arrows c ∧ v ∈ Set.range c.left := by
      intro P _ _ S X R hR v
      obtain ⟨𝒰, hO, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology X R).mp hR
      obtain ⟨i, y, hy⟩ := 𝒰.exists_eq v
      refine ⟨_, _, hle _ _ (Presieve.ofArrows.mk i), y, ?_⟩
      exact hy
    intro V R hR v
    exact gen _ T V R hR v

  have s2 : ∀ (P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V : Y.Etale) (s : P.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        P.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V) →
      wcSuppIn Y W ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P) := by
    intro P hP V s
    let η := toSheafify (Scheme.smallEtaleTopology Y) P
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    refine GrothendieckTopology.transitive _
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η s) _ ?_
    intro V' g hg
    obtain ⟨t, ht⟩ := hg
    refine GrothendieckTopology.superset_covering _ ?_ (hP V' t)
    rintro V₀ h ⟨V₁, k, g₀, hg₀, rfl⟩
    change (Sieve.generate _).arrows ((k ≫ g₀) ≫ g)
    rw [Category.assoc]
    apply Sieve.downward_closed
    apply Sieve.le_generate
    rcases hg₀ with h0 | hW₁
    · left
      change (sheafify (Scheme.smallEtaleTopology Y) P).map (g₀ ≫ g).op s = 0
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, ← ht,
        ← NatTrans.naturality_apply, h0, map_zero]
    · exact Or.inr hW₁

  haveI : UniversallyClosed τ := inferInstance
  have s3 : ∀ (V : Y.Etale) (s : F'.obj.obj (Opposite.op ((wcEtBaseChange τ).obj V))),
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        F'.obj.map ((wcEtBaseChange τ).map g).op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈
        Scheme.smallEtaleTopology Y V := by
    intro V s
    obtain ⟨hOopen, hOvan⟩ := wc_etale_section_vanishing_open T F' ((wcEtBaseChange τ).obj V) s
    set O := {v : ((wcEtBaseChange τ).obj V).left | ∃ (V₁ : T.Etale)
      (c : V₁ ⟶ (wcEtBaseChange τ).obj V), v ∈ Set.range c.left ∧ F'.obj.map c.op s = 0} with hO

    have hC : ∀ p : ((wcEtBaseChange τ).obj V).left, p ∉ O →
        V.hom (Limits.pullback.fst V.hom τ p) ∈ W := by
      intro p hp
      obtain ⟨V₁, c, hc, y, hy⟩ := s1T _ _ (hFsupp _ s) p
      obtain ⟨Z, k, g₀, hg₀, rfl⟩ := hc
      rcases hg₀ with h0 | hZ
      · exfalso
        apply hp
        refine ⟨V₁, k ≫ g₀, ⟨y, hy⟩, ?_⟩
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, h0, map_zero]
      · have h2 : τ (Z.hom (k.left y)) ∈ W := hZ (k.left y)
        have e1 : Z.hom (k.left y) = Limits.pullback.snd V.hom τ p := by
          rw [← hy, ← MorphismProperty.Over.w g₀]
          rfl
        have h3 : τ (Limits.pullback.snd V.hom τ p) ∈ W :=
          (congrArg (fun z => τ z ∈ W) e1).mp h2
        have e3 : V.hom (Limits.pullback.fst V.hom τ p) = τ (Limits.pullback.snd V.hom τ p) :=
          (Scheme.Hom.comp_apply _ _ p).symm.trans
            ((congrArg (fun φ => φ p) (Limits.pullback.condition (f := V.hom) (g := τ))).trans
              (Scheme.Hom.comp_apply _ _ p))
        exact (congrArg (· ∈ W) e3).mpr h3

    have hK : IsClosed (Limits.pullback.fst V.hom τ '' Oᶜ) :=
      Scheme.Hom.isClosedMap (Limits.pullback.fst V.hom τ) _ hOopen.isClosed_compl

    let U₀ : V.left.Opens := ⟨(Limits.pullback.fst V.hom τ '' Oᶜ)ᶜ, hK.isOpen_compl⟩
    let U₁ : V.left.Opens := ⟨V.hom ⁻¹' W, hW.preimage V.hom.continuous⟩
    apply wc_etale_jointly_surjective_covers
    intro v
    by_cases hv : v ∈ (U₀ : Set V.left)
    · refine ⟨wcEtOpen Y V U₀, wcEtOpenι Y V U₀, ?_, ?_⟩
      · apply Sieve.le_generate
        left

        apply hOvan
        rintro _ ⟨r, rfl⟩
        by_contra hr
        have key : ((wcEtBaseChange τ).map (wcEtOpenι Y V U₀)).left ≫
            Limits.pullback.fst V.hom τ = Limits.pullback.fst (wcEtOpen Y V U₀).hom τ ≫ U₀.ι :=
          Limits.pullback.lift_fst _ _ _
        have e : Limits.pullback.fst V.hom τ (((wcEtBaseChange τ).map (wcEtOpenι Y V U₀)).left r) =
            U₀.ι (Limits.pullback.fst (wcEtOpen Y V U₀).hom τ r) :=
          (Scheme.Hom.comp_apply _ _ r).symm.trans
            ((congrArg (fun φ => φ r) key).trans (Scheme.Hom.comp_apply _ _ r))
        have hmem : U₀.ι (Limits.pullback.fst (wcEtOpen Y V U₀).hom τ r) ∈ (U₀ : Set V.left) := by
          rw [← Scheme.Opens.range_ι]
          exact ⟨_, rfl⟩
        exact hmem ⟨_, hr, e⟩
      · change v ∈ Set.range U₀.ι
        rw [Scheme.Opens.range_ι]
        exact hv
    · have hvK : v ∈ Limits.pullback.fst V.hom τ '' Oᶜ := not_not.mp hv
      obtain ⟨p, hp, rfl⟩ := hvK
      refine ⟨wcEtOpen Y V U₁, wcEtOpenι Y V U₁, ?_, ?_⟩
      · apply Sieve.le_generate
        right

        intro x
        have hx : U₁.ι x ∈ (U₁ : Set V.left) := by
          rw [← Scheme.Opens.range_ι]
          exact ⟨x, rfl⟩
        have ex : (U₁.ι ≫ V.hom) x = V.hom (U₁.ι x) := Scheme.Hom.comp_apply _ _ _
        show (U₁.ι ≫ V.hom) x ∈ W
        rw [ex]
        exact hx
      · change _ ∈ Set.range U₁.ι
        rw [Scheme.Opens.range_ι]
        exact hC p hp

  have hPF : wcSuppIn Y W ((wcEtPush τ).obj F') :=
    s2 ((wcEtBaseChange τ).op ⋙ F'.obj) (fun V s => s3 V s)

  haveI : Mono ((wcEtPush τ).map ιF) := inferInstance
  obtain ⟨a, ha⟩ := hfac H ιH hHsupp
  obtain ⟨b, hb⟩ := hHuniv _ ((wcEtPush τ).map ιF) hPF
  have hab : a ≫ b = 𝟙 H := by
    rw [← cancel_mono ιH, Category.assoc, hb, ha, Category.id_comp]
  have hba : b ≫ a = 𝟙 _ := by
    rw [← cancel_mono ((wcEtPush τ).map ιF), Category.assoc, ha, hb, Category.id_comp]
  let e : H ≅ (wcEtPush τ).obj F' := ⟨a, b, hab, hba⟩
  have he : ιH ≫ (Iso.refl ((wcEtPush τ).obj F)).hom = e.hom ≫ (wcEtPush τ).map ιF := by
    rw [Iso.refl_hom, Category.comp_id]
    exact ha.symm

  let E : Limits.cokernel ιH ≅ (wcEtPush τ).obj (Limits.cokernel ιF) :=
    Limits.cokernel.mapIso ιH ((wcEtPush τ).map ιF) e (Iso.refl _) he ≪≫
      (Limits.PreservesCokernel.iso (wcEtPush τ) ιF).symm

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives T
  haveI := hLlim
  haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
  have hs : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) (q + 1)) :=
    hT F' ιF hFmono hFsupp hFuniv q
  have hsL : Subsingleton (Abelian.Ext (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) (Limits.cokernel ιF) (q + 1)) := by
    refine Function.Injective.subsingleton
      (f := fun x => (Abelian.Ext.mk₀ eL.inv).comp x (zero_add (q + 1))) ?_
    intro x y hxy
    have key : ∀ z : Abelian.Ext (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))) (Limits.cokernel ιF) (q + 1),
        z = (Abelian.Ext.mk₀ eL.hom).comp ((Abelian.Ext.mk₀ eL.inv).comp z (zero_add (q + 1)))
          (zero_add (q + 1)) := by
      intro z
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add (q + 1)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [key x, key y]
    simp only at hxy
    rw [hxy]
  have hbij := wc_ext_adjoint_transfer L (wcEtPush τ) adj
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) (q + 1)
  haveI hsP : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((wcEtPush τ).obj (Limits.cokernel ιF)) (q + 1)) := hbij.2.subsingleton
  change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιH) (q + 1))
  refine Function.Injective.subsingleton
    (f := fun z => z.comp (Abelian.Ext.mk₀ E.hom) (add_zero (q + 1))) ?_
  intro x y hxy
  have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιH) (q + 1),
      z = (z.comp (Abelian.Ext.mk₀ E.hom) (add_zero _)).comp (Abelian.Ext.mk₀ E.inv)
        (add_zero _) := by
    intro z
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  rw [key x, key y]
  simp only at hxy
  rw [hxy]

theorem wc_et_maxsupp_filtered_colim : ∀ (Y : Scheme.{u}) (W : Set Y), IsOpen W → ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (D : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (c : Limits.Cocone D), Nonempty (Limits.IsColimit c) → ∀ (Hd : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιd : Hd ⟶ D), (∀ j, Mono (ιd.app j)) → (∀ j, wcSuppIn Y W (Hd.obj j)) → (∀ (j : J) (H₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ D.obj j), wcSuppIn Y W H₂ → ∃ χ' : H₂ ⟶ Hd.obj j, χ' ≫ ιd.app j = χ) → ∀ (cH : Limits.Cocone Hd), Nonempty (Limits.IsColimit cH) → ∀ (HX : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιX : HX ⟶ c.pt), Mono ιX → wcSuppIn Y W HX → (∀ (H₂ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ c.pt), wcSuppIn Y W H₂ → ∃ χ' : H₂ ⟶ HX, χ' ≫ ιX = χ) → ∀ (φ : cH.pt ⟶ HX), (∀ j, cH.ι.app j ≫ φ ≫ ιX = ιd.app j ≫ c.ι.app j) → IsIso φ :=
by
  intro Y W _hW J _ _ D c hc Hd ιd hmono _hsuppd hmax cH hcH HX ιX hιX hHX _hmaxX φ hφ

  have nat : ∀ {F G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (α : F ⟶ G)
      {V V' : Y.Etale} (h : V' ⟶ V) (x : F.obj.obj (Opposite.op V)),
      (α.hom.app (Opposite.op V')).hom ((F.obj.map h.op).hom x) =
        (G.obj.map h.op).hom ((α.hom.app (Opposite.op V)).hom x) :=
    by
      intro F G α V V' h x
      exact NatTrans.naturality_apply α.hom h.op x

  have inj : ∀ {F G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (α : F ⟶ G),
      Mono α → ∀ V : Y.Etale, Function.Injective (α.hom.app (Opposite.op V)).hom := by
    intro F G α hα V
    exact (AddCommGrpCat.mono_iff_injective (α.hom.app (Opposite.op V))).1
      (((NatTrans.mono_iff_mono_app α.hom).1
        (inferInstance : Mono ((sheafToPresheaf _ _).map α))) (Opposite.op V))

  have F9 : ∀ (V : Y.Etale) (P₀ : Presieve V) (I : Sieve V),
      Sieve.generate P₀ ∈ Scheme.smallEtaleTopology Y V →
      (∀ (V' : Y.Etale) (g₀ : V' ⟶ V), P₀ g₀ →
        Sieve.pullback g₀ I ∈ Scheme.smallEtaleTopology Y V') →
      I ∈ Scheme.smallEtaleTopology Y V := by
    intro V P₀ I hS hI
    refine GrothendieckTopology.transitive _ hS I ?_
    intro V' f hf
    obtain ⟨Z, h, g, hg, rfl⟩ := hf
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ _ (hI _ g hg)

  have s1 : ∀ (D' : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (c' : Limits.Cocone D'), Limits.IsColimit c' →
      (∀ (V : Y.Etale) (s : c'.pt.obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : J) (t : (D'.obj j).obj.obj (Opposite.op V')), ((c'.ι.app j).hom.app (Opposite.op V')).hom t = (c'.pt.obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) ∧
      (∀ (j : J) (V : Y.Etale) (t : (D'.obj j).obj.obj (Opposite.op V)), ((c'.ι.app j).hom.app (Opposite.op V)).hom t = 0 → Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (k : J) (f : j ⟶ k), ((D'.map f).hom.app (Opposite.op V')).hom (((D'.obj j).obj.map h.op).hom t) = 0) ∈ Scheme.smallEtaleTopology Y V) := by
    intro D' c' hc'
    have : IsFiltered (AsSmall.{u+1} J) := IsFiltered.of_equivalence AsSmall.equiv
    obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y (AsSmall.{u+1} J)
      (AsSmall.down.{u, u, u+1} ⋙ D')
    let e : Limits.colimit (AsSmall.down.{u, u, u+1} ⋙ D') ≅ c'.pt :=
      (Limits.colimit.isColimit (AsSmall.down.{u, u, u+1} ⋙ D')).coconePointUniqueUpToIso
        (hc'.whiskerEquivalence (AsSmall.equiv.{u, u, u+1} (C := J)).symm)
    have he1 : ∀ a : AsSmall.{u+1} J, Limits.colimit.ι (AsSmall.down.{u, u, u+1} ⋙ D') a ≫ e.hom =
        c'.ι.app (AsSmall.down.obj a) := fun a =>
      Limits.IsColimit.comp_coconePointUniqueUpToIso_hom _ _ a
    have he2 : ∀ a : AsSmall.{u+1} J, c'.ι.app (AsSmall.down.obj a) ≫ e.inv =
        Limits.colimit.ι (AsSmall.down.{u, u, u+1} ⋙ D') a := fun a => by
      rw [← he1 a, Category.assoc, e.hom_inv_id, Category.comp_id]
    refine ⟨fun V s => ?_, fun j V t ht => ?_⟩
    · refine GrothendieckTopology.superset_covering _ ?_
        (hA V ((e.inv.hom.app (Opposite.op V)).hom s))
      rw [Sieve.generate_le_iff]
      rintro V' h ⟨a, t, ht⟩
      apply Sieve.le_generate
      refine ⟨AsSmall.down.obj a, t, ?_⟩
      have k1 : ((c'.ι.app (AsSmall.down.obj a)).hom.app (Opposite.op V')).hom t =
          (e.hom.hom.app (Opposite.op V')).hom
            (((Limits.colimit.ι (AsSmall.down.{u, u, u+1} ⋙ D') a).hom.app (Opposite.op V')).hom t) := by
        rw [← he1 a]
        rfl
      have k2 : (e.hom.hom.app (Opposite.op V')).hom
          (((Limits.colimit (AsSmall.down.{u, u, u+1} ⋙ D')).obj.map h.op).hom
            ((e.inv.hom.app (Opposite.op V)).hom s)) =
          (c'.pt.obj.map h.op).hom ((e.hom.hom.app (Opposite.op V)).hom
            ((e.inv.hom.app (Opposite.op V)).hom s)) := nat e.hom h _
      have k3 : (e.hom.hom.app (Opposite.op V)).hom ((e.inv.hom.app (Opposite.op V)).hom s) = s := by
        change ((e.inv ≫ e.hom).hom.app (Opposite.op V)).hom s = s
        rw [e.inv_hom_id]
        rfl
      rw [k1, ht, k2, k3]
    · have ht' : ((Limits.colimit.ι (AsSmall.down.{u, u, u+1} ⋙ D') (AsSmall.up.obj j)).hom.app
          (Opposite.op V)).hom t = 0 := by
        rw [← he2 (AsSmall.up.obj j)]
        change (e.inv.hom.app (Opposite.op V)).hom (((c'.ι.app j).hom.app (Opposite.op V)).hom t) = 0
        rw [ht, map_zero]
      refine GrothendieckTopology.superset_covering _ ?_ (hB (AsSmall.up.obj j) V t ht')
      rw [Sieve.generate_le_iff]
      rintro V' h ⟨a', f, hf⟩
      apply Sieve.le_generate
      exact ⟨AsSmall.down.obj a', AsSmall.down.map f, hf⟩
  obtain ⟨hc⟩ := hc
  obtain ⟨hcH⟩ := hcH
  obtain ⟨hcA, hcB⟩ := s1 D c hc
  obtain ⟨hcHA, -⟩ := s1 Hd cH hcH

  have hepi : Epi φ := by
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ.hom := by
      refine Presheaf.IsLocallySurjective.mk (fun {V} h => ?_)
      refine F9 V _ _ (hHX V h) ?_
      rintro V' g₀ (h0 | hW')
      · have hmem : (Presheaf.imageSieve φ.hom h).arrows g₀ := by
          refine ⟨0, ?_⟩
          rw [map_zero]
          exact h0.symm
        rw [Sieve.pullback_eq_top_of_mem _ hmem]
        exact GrothendieckTopology.top_mem _ _
      · refine GrothendieckTopology.superset_covering _ ?_
          (hcA V' ((ιX.hom.app (Opposite.op V')).hom ((HX.obj.map g₀.op).hom h)))
        rw [Sieve.generate_le_iff]
        rintro V'' g ⟨j, t, ht⟩
        have hW'' : ∀ x, V''.hom x ∈ W := fun x => by
          rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]
          exact hW' _
        obtain ⟨u', hu'⟩ := wc_et_maxsupp_sections_surj Y W (D.obj j) (Hd.obj j) (ιd.app j)
          (hmax j) V'' hW'' t
        show ∃ w, (φ.hom.app (Opposite.op V'')).hom w = (HX.obj.map (g ≫ g₀).op).hom h
        refine ⟨((cH.ι.app j).hom.app (Opposite.op V'')).hom u', ?_⟩
        apply inj ιX hιX V''
        have e1 : (ιX.hom.app (Opposite.op V'')).hom ((φ.hom.app (Opposite.op V'')).hom
            (((cH.ι.app j).hom.app (Opposite.op V'')).hom u')) =
            ((cH.ι.app j ≫ φ ≫ ιX).hom.app (Opposite.op V'')).hom u' := rfl
        rw [e1, hφ j]
        change ((c.ι.app j).hom.app (Opposite.op V'')).hom
          (((ιd.app j).hom.app (Opposite.op V'')).hom u') = _
        rw [hu', ht, op_comp, Functor.map_comp]
        exact (nat ιX g _).symm
    exact Sheaf.epi_of_isLocallySurjective φ

  have hmonoφ : Mono φ := by
    have hinj : ∀ X : (Y.Etale)ᵒᵖ, Function.Injective (φ.hom.app X).hom := by
      rintro ⟨V⟩
      rw [injective_iff_map_eq_zero]
      intro a ha
      let R : Sieve V :=
        { arrows := fun V'' g => (cH.pt.obj.map g.op).hom a = 0
          downward_closed := fun {V'' V'''} {g} hg g' => by
            show (cH.pt.obj.map (g' ≫ g).op).hom a = 0
            rw [op_comp, Functor.map_comp]
            change (cH.pt.obj.map g'.op).hom ((cH.pt.obj.map g.op).hom a) = 0
            rw [hg, map_zero] }
      have hR : R ∈ Scheme.smallEtaleTopology Y V := by
        refine F9 V _ R (hcHA V a) ?_
        rintro V' h ⟨j, t, ht⟩
        have hτ : ((c.ι.app j).hom.app (Opposite.op V')).hom
            (((ιd.app j).hom.app (Opposite.op V')).hom t) = 0 := by
          change ((ιd.app j ≫ c.ι.app j).hom.app (Opposite.op V')).hom t = 0
          rw [← hφ j]
          change (ιX.hom.app (Opposite.op V')).hom ((φ.hom.app (Opposite.op V')).hom
            (((cH.ι.app j).hom.app (Opposite.op V')).hom t)) = 0
          rw [ht, nat φ h a, ha, map_zero, map_zero]
        refine GrothendieckTopology.superset_covering _ ?_ (hcB j V' _ hτ)
        rw [Sieve.generate_le_iff]
        rintro V'' g ⟨k, f, hf⟩
        show (cH.pt.obj.map (g ≫ h).op).hom a = 0
        have h1 : ((Hd.map f).hom.app (Opposite.op V'')).hom
            (((Hd.obj j).obj.map g.op).hom t) = 0 := by
          apply inj (ιd.app k) (hmono k) V''
          rw [map_zero]
          change ((Hd.map f ≫ ιd.app k).hom.app (Opposite.op V'')).hom _ = 0
          rw [ιd.naturality f]
          change ((D.map f).hom.app (Opposite.op V'')).hom (((ιd.app j).hom.app
            (Opposite.op V'')).hom (((Hd.obj j).obj.map g.op).hom t)) = 0
          rw [nat (ιd.app j) g t]
          exact hf
        rw [op_comp, Functor.map_comp]
        change (cH.pt.obj.map g.op).hom ((cH.pt.obj.map h.op).hom a) = 0
        have hn : ((cH.ι.app j).hom.app (Opposite.op V'')).hom (((Hd.obj j).obj.map g.op).hom t) =
            (cH.pt.obj.map g.op).hom (((cH.ι.app j).hom.app (Opposite.op V')).hom t) :=
          nat (cH.ι.app j) g t
        rw [← ht, ← hn, ← cH.w f]
        change ((cH.ι.app k).hom.app (Opposite.op V'')).hom (((Hd.map f).hom.app
          (Opposite.op V'')).hom (((Hd.obj j).obj.map g.op).hom t)) = 0
        rw [h1, map_zero]
      exact cH.pt.isSeparated V R hR a 0 (fun V'' g hg => by rw [map_zero]; exact hg)
    have : Sheaf.IsLocallyInjective φ := (Sheaf.isLocallyInjective_iff_injective φ).2 hinj
    exact Sheaf.mono_of_isLocallyInjective φ
  exact isIso_of_mono_of_epi φ

theorem wc_et_maxsupp_const_coker_iso : ∀ (T : Scheme.{u}) (W' : Set T), IsOpen W' → ∀ (m : ℕ) (G' : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (ιG : G' ⟶ (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))), Mono ιG → wcSuppIn T W' G' → (∀ (H₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (χ : H₂ ⟶ (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))), wcSuppIn T W' H₂ → ∃ χ' : H₂ ⟶ G', χ' ≫ ιG = χ) → Nonempty (Limits.cokernel ιG ≅ Limits.cokernel (wcEtExtZeroι T W' m)) :=
by
  intro T W' _ m G' ιG hGmono hGsupp hmax
  let α : wcEtExtZeroPre T W' m ⟶
      (Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :=
    { app := fun V => AddCommGrpCat.ofHom (wcSuppSub.{u} m (∀ x, V.unop.hom x ∈ W')).subtype
      naturality := fun _ _ _ => rfl }

  have hεmono : Mono (wcEtExtZeroι T W' m) := by
    have : ∀ V, Mono (α.app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
    have : Mono α := NatTrans.mono_of_mono_app α
    exact Functor.map_mono (presheafToSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) α

  have hEsupp : wcSuppIn T W' (wcEtExtZero T W' m) := by
    intro V s
    let η := toSheafify (Scheme.smallEtaleTopology T) (wcEtExtZeroPre T W' m)
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology T) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology T) η s
    refine GrothendieckTopology.superset_covering _ ?_ hI
    intro V' g hg
    obtain ⟨t, ht⟩ := hg
    apply Sieve.le_generate
    by_cases hp : ∀ x, V'.hom x ∈ W'
    · exact Or.inr hp
    · left
      have key : ∀ (p : Prop), ¬p → ∀ y : ↥(wcSuppSub.{u} m p), y = 0 := by
        intro p hp y
        obtain ⟨y, hy⟩ := y
        have hy' : y ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod m))) := by
          unfold wcSuppSub at hy
          rwa [iSup_neg hp] at hy
        exact Subtype.ext ((AddSubgroup.mem_bot).mp hy')
      have ht0 : t = 0 := key _ hp t
      have h2 : (sheafify (Scheme.smallEtaleTopology T) (wcEtExtZeroPre T W' m)).map g.op s
          = 0 := by
        rw [← ht, ht0, map_zero]
      exact h2

  have hloc : ∀ (V : T.Etale), (∀ x, V.hom x ∈ W') →
      ∀ s : ((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op V),
      Sieve.generate (fun (V' : T.Etale) (k : V' ⟶ V) =>
        ∃ t : (wcEtExtZero T W' m).obj.obj (Opposite.op V'),
          ((wcEtExtZeroι T W' m).hom.app (Opposite.op V')).hom t =
          (((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map k.op).hom s) ∈
        Scheme.smallEtaleTopology T V := by
    intro V hV s
    let ηC := toSheafify (Scheme.smallEtaleTopology T)
      ((Functor.const (T.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    let ηW := toSheafify (Scheme.smallEtaleTopology T) (wcEtExtZeroPre T W' m)
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology T) ηC :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology T) ηC s
    refine GrothendieckTopology.superset_covering _ ?_ hI
    intro V' k hk
    obtain ⟨a, ha⟩ := hk
    apply Sieve.le_generate
    have hp : ∀ x, V'.hom x ∈ W' := by
      intro x
      rw [← MorphismProperty.Over.w k, Scheme.Hom.comp_apply]
      exact hV _
    have ha' : a ∈ wcSuppSub.{u} m (∀ x, V'.hom x ∈ W') :=
      AddSubgroup.mem_iSup_of_mem hp (AddSubgroup.mem_top a)
    refine ⟨(ηW.app (Opposite.op V')).hom ⟨a, ha'⟩, ?_⟩
    have hn : (α ≫ ηC).app (Opposite.op V') =
        (ηW ≫ sheafifyMap (Scheme.smallEtaleTopology T) α).app (Opposite.op V') := by
      rw [toSheafify_naturality]
    have h2 := congrArg (fun f => f.hom (⟨a, ha'⟩ : wcSuppSub.{u} m (∀ x, V'.hom x ∈ W'))) hn
    calc _ = ((ηW ≫ sheafifyMap (Scheme.smallEtaleTopology T) α).app (Opposite.op V')).hom
            ⟨a, ha'⟩ := rfl
      _ = ((α ≫ ηC).app (Opposite.op V')).hom ⟨a, ha'⟩ := h2.symm
      _ = (ηC.app (Opposite.op V')).hom a := rfl
      _ = _ := ha

  have hdie : ∀ (H : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
      (φ : H ⟶ (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))),
      wcSuppIn T W' H → φ ≫ Limits.cokernel.π (wcEtExtZeroι T W' m) = 0 := by
    intro H φ hH
    have hnat : ∀ (V₁ V₂ : T.Etale) (a : V₂ ⟶ V₁) (y : H.obj.obj (Opposite.op V₁)),
        ((Limits.cokernel.π (wcEtExtZeroι T W' m)).hom.app (Opposite.op V₂)).hom
          ((φ.hom.app (Opposite.op V₂)).hom ((H.obj.map a.op).hom y)) =
        ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map a.op).hom
          (((Limits.cokernel.π (wcEtExtZeroι T W' m)).hom.app (Opposite.op V₁)).hom
            ((φ.hom.app (Opposite.op V₁)).hom y)) := by
      intro V₁ V₂ a y
      have h1 : (φ.hom.app (Opposite.op V₂)).hom ((H.obj.map a.op).hom y) =
          (((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map a.op).hom
            ((φ.hom.app (Opposite.op V₁)).hom y) :=
        NatTrans.naturality_apply φ.hom a.op y
      rw [h1]
      exact NatTrans.naturality_apply (Limits.cokernel.π (wcEtExtZeroι T W' m)).hom a.op _
    have hsec : ∀ (V : T.Etale) (s : H.obj.obj (Opposite.op V)),
        ((Limits.cokernel.π (wcEtExtZeroι T W' m)).hom.app (Opposite.op V)).hom
          ((φ.hom.app (Opposite.op V)).hom s) = 0 := by
      intro V s
      set x := ((Limits.cokernel.π (wcEtExtZeroι T W' m)).hom.app (Opposite.op V)).hom
          ((φ.hom.app (Opposite.op V)).hom s) with hx
      let S : Sieve V :=
        { arrows := fun V' g =>
            ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map g.op).hom x = 0
          downward_closed := by
            intro V₁ V₂ g hg h
            show ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map (h ≫ g).op).hom x = 0
            rw [op_comp, Functor.map_comp]
            change ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map h.op).hom
              (((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map g.op).hom x) = 0
            rw [hg, map_zero] }
      have hS : S ∈ Scheme.smallEtaleTopology T V := by
        refine GrothendieckTopology.transitive _ (hH V s) S ?_
        intro V' g hg
        obtain ⟨V'', h, g', hg', rfl⟩ := hg
        rw [Sieve.pullback_comp]
        apply GrothendieckTopology.pullback_stable
        rcases hg' with h0 | hW
        · have hmem : S.arrows g' := by
            show ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map g'.op).hom x = 0
            rw [hx, ← hnat]
            have h0' : (H.obj.map g'.op).hom s = 0 := h0
            rw [h0', map_zero, map_zero]
          rw [Sieve.pullback_eq_top_of_mem S hmem]
          exact GrothendieckTopology.top_mem _ _
        · refine GrothendieckTopology.superset_covering _ ?_
            (hloc V'' hW ((φ.hom.app (Opposite.op V'')).hom ((H.obj.map g'.op).hom s)))
          rw [Sieve.generate_le_iff]
          intro V₃ k hk
          obtain ⟨t, ht⟩ := hk
          show ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map (k ≫ g').op).hom x = 0
          rw [op_comp, Functor.map_comp]
          change ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map k.op).hom
            (((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map g'.op).hom x) = 0
          have hπk : ((Limits.cokernel.π (wcEtExtZeroι T W' m)).hom.app (Opposite.op V₃)).hom
              ((((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
                (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map k.op).hom
                ((φ.hom.app (Opposite.op V'')).hom ((H.obj.map g'.op).hom s))) =
              ((Limits.cokernel (wcEtExtZeroι T W' m)).obj.map k.op).hom
                (((Limits.cokernel.π (wcEtExtZeroι T W' m)).hom.app (Opposite.op V'')).hom
                  ((φ.hom.app (Opposite.op V'')).hom ((H.obj.map g'.op).hom s))) :=
            NatTrans.naturality_apply (Limits.cokernel.π (wcEtExtZeroι T W' m)).hom k.op _
          rw [hx, ← hnat, ← hπk, ← ht]
          change ((wcEtExtZeroι T W' m ≫ Limits.cokernel.π (wcEtExtZeroι T W' m)).hom.app
            (Opposite.op V₃)).hom t = 0
          rw [Limits.cokernel.condition]
          rfl
      refine (Limits.cokernel (wcEtExtZeroι T W' m)).isSeparated V S hS x 0
        (fun V' g hg => ?_)
      rw [map_zero]
      exact hg
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro s
    exact hsec V.unop s

  have hεmax : ∀ (H₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
      (χ : H₂ ⟶ (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))),
      wcSuppIn T W' H₂ → ∃ χ' : H₂ ⟶ wcEtExtZero T W' m, χ' ≫ wcEtExtZeroι T W' m = χ := by
    intro H₂ χ hH₂
    have hχ := hdie H₂ χ hH₂
    have := hεmono
    have hS : (ShortComplex.mk (wcEtExtZeroι T W' m) (Limits.cokernel.π _)
        (Limits.cokernel.condition _)).Exact := ShortComplex.exact_cokernel _
    exact ⟨hS.lift χ hχ, hS.lift_f χ hχ⟩
  have := hεmono
  obtain ⟨α', hα'⟩ := hmax _ (wcEtExtZeroι T W' m) hEsupp
  obtain ⟨β, hβ⟩ := hεmax G' ιG hGsupp
  have h1 : α' ≫ β = 𝟙 _ := by
    rw [← cancel_mono (wcEtExtZeroι T W' m), Category.assoc, hβ, hα', Category.id_comp]
  have h2 : β ≫ α' = 𝟙 _ := by
    rw [← cancel_mono ιG, Category.assoc, hα', hβ, Category.id_comp]
  let e : G' ≅ wcEtExtZero T W' m := ⟨β, α', h2, h1⟩
  refine ⟨Limits.cokernel.mapIso ιG (wcEtExtZeroι T W' m) e (Iso.refl _) ?_⟩
  rw [Iso.refl_hom, Category.comp_id]
  exact hβ.symm

theorem wc_affine_closed_subscheme_quotient : ∀ (T : Scheme.{u}) [IsAffine T] (S : Set T), IsClosed S → ∃ (Z : Scheme.{u}) (i : Z ⟶ T), IsClosedImmersion i ∧ IsAffine Z ∧ Set.range i = S ∧ ∃ ρ : Γ(T, ⊤) →+* Γ(Z, ⊤), Function.Surjective ρ :=
by
  intro T _ S hS
  have hS' : IsClosed (T.isoSpec.inv ⁻¹' S) := hS.preimage T.isoSpec.inv.continuous
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S))))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  refine ⟨Spec (CommRingCat.of (Γ(T, ⊤) ⧸ PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S))),
    Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S)))) ≫ T.isoSpec.inv,
    inferInstance, inferInstance, ?_,
    (Scheme.ΓSpecIso (CommRingCat.of (Γ(T, ⊤) ⧸
      PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S)))).inv.hom.comp
      (Ideal.Quotient.mk _), ?_⟩
  · have hsurj : Function.Surjective T.isoSpec.inv := by
      intro y
      refine ⟨T.isoSpec.hom y, ?_⟩
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl
    have h1 : Set.range (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S))))) =
        T.isoSpec.inv ⁻¹' S := by
      have r1 := range_comap_of_surjective _
        (Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S)))
        Ideal.Quotient.mk_surjective
      have r2 := PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure (T.isoSpec.inv ⁻¹' S)
      rw [Ideal.mk_ker] at r1
      exact r1.trans (r2.trans hS'.closure_eq)
    have h2 : ⇑(Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S)))) ≫ T.isoSpec.inv) =
        ⇑T.isoSpec.inv ∘ ⇑(Spec.map (CommRingCat.ofHom
          (Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S))))) :=
      funext fun x => Scheme.Hom.comp_apply _ _ x
    rw [h2, Set.range_comp, h1, Set.image_preimage_eq S hsurj]
  · intro x
    obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
      (I := PrimeSpectrum.vanishingIdeal (T.isoSpec.inv ⁻¹' S)) ((Scheme.ΓSpecIso _).hom.hom x)
    refine ⟨y, ?_⟩
    rw [RingHom.comp_apply, hy]
    exact Iso.hom_inv_id_apply (Scheme.ΓSpecIso _) x

theorem wc_et_free_top_iso_const : ∀ (Y : Scheme.{u}), Nonempty ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj ⊤) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) :=
by
  intro Y
  have huniq : ∀ (V : Y.Etale) (f g : V ⟶ (wcZarToEt Y).obj ⊤), f = g := by
    intro V f g
    haveI : Mono ((wcZarToEt Y).obj ⊤).hom :=
      show Mono (⊤ : Y.Opens).ι from (inferInstance : Mono (⊤ : Y.Opens).ι)
    apply MorphismProperty.Over.Hom.ext
    rw [← cancel_mono ((wcZarToEt Y).obj ⊤).hom, MorphismProperty.Over.w f,
      MorphismProperty.Over.w g]
  have hU : ∀ V : Y.Etale, Unique (V ⟶ (wcZarToEt Y).obj ⊤) := fun V =>
    { default := MorphismProperty.Over.homMk (V.hom ≫ Y.topIso.inv)
        (by
          change (V.hom ≫ Y.topIso.inv) ≫ (⊤ : Y.Opens).ι = V.hom
          rw [← Scheme.topIso_hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]) trivial
      uniq := fun f => huniq V f _ }
  let e : ∀ V : Y.Etaleᵒᵖ,
      FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj ⊤)) ≃+ ULift.{u+1} ℤ :=
    fun V => by
      letI := hU V.unop
      exact (FreeAbelianGroup.uniqueEquiv _).trans AddEquiv.ulift.symm
  have he : ∀ (V : Y.Etaleᵒᵖ) (t : ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj ⊤)),
      e V (FreeAbelianGroup.of t) = ULift.up 1 := by
    intro V t
    simp [e, FreeAbelianGroup.uniqueEquiv, AddEquiv.ulift] <;> rfl
  let η : (yoneda.obj ((wcZarToEt Y).obj ⊤) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
      (Functor.const Y.Etaleᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) :=
    NatIso.ofComponents (fun V => (e V).toAddCommGrpIso) (by
      intro V W f
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro t
      change e W (FreeAbelianGroup.map
          (fun x : ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj ⊤) =>
            (ULift.up (f.unop ≫ x.down) : ULift.{u+1} (W.unop ⟶ (wcZarToEt Y).obj ⊤)))
          (FreeAbelianGroup.of t)) = e V (FreeAbelianGroup.of t)
      exact (congrArg (e W) (FreeAbelianGroup.map_of_apply _)).trans
        ((he W _).trans (he V t).symm))
  exact ⟨(presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapIso η⟩

theorem wc_et_free_bot_isZero : ∀ (Y : Scheme.{u}), Limits.IsZero ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj ⊥) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
by
  intro Y

  have s1 : ∀ (V : Y.Etale) (g : V ⟶ (wcZarToEt Y).obj ⊥) (v : V.left), False := by
    intro V g v
    obtain ⟨x, hx⟩ : ↥(⊥ : Y.Opens) := g.left v
    exact hx

  have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have s2 : ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale),
      (∀ v : V.left, False) → ∀ x y : G.obj.obj (Opposite.op V), x = y := by
    intro G V h x y
    refine G.isSeparated V ⊥
      (hcov V ⊥ (fun v => (h v).elim)) x y ?_
    intro _ _ hf
    simp at hf

  have s3 : ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (φ₁ φ₂ : (yoneda.obj ((wcZarToEt Y).obj ⊥) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free) ⟶ G.obj), φ₁ = φ₂ := by
    intro G φ₁ φ₂
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro g
    exact s2 G V.unop (s1 V.unop g.down) _ _

  rw [Limits.IsZero.iff_id_eq_zero]
  apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).homEquiv
    _ _).injective
  apply s3

theorem wc_et_ext_free_locally_zero : ∀ (Y : Scheme.{u}) (U : Y.Etale) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (n : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ ξ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F (n + 1), ∃ S : Sieve U, S ∈ Scheme.smallEtaleTopology Y U ∧ ∀ (V : Y.Etale) (g : V ⟶ U), S.arrows g → (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp ξ (zero_add (n + 1)) = 0 :=
by
  intro Y U F n ξ
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives.{u+1}

  let η : ∀ T : Y.Etale, ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.obj (Opposite.op T) :=
    fun T => ((toSheafify (Scheme.smallEtaleTopology Y)
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
      (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
  let e : ∀ (T : Y.Etale) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G) ≃
        G.obj.obj (Opposite.op T) := fun T G =>
    ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
      (((Adjunction.whiskerRight (Y.Etale)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
        (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
  have he : ∀ (T : Y.Etale) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G),
      e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
  have hnat : ∀ (T T' : Y.Etale) (c : T' ⟶ T),
      (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yoneda.map c)
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app (Opposite.op T')).hom (η T') =
      (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map c.op).hom (η T) := by
    intro T T' c
    let J := Scheme.smallEtaleTopology Y
    let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
    let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
    have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
        (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
          ((w.app (Opposite.op T')).hom x') :=
      (ConcreteCategory.congr_hom
        (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
    have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
        FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      refine (FreeAbelianGroup.map_of_apply _).trans
        (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
      congr 1
    have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
      NatTrans.naturality_apply (toSheafify J P) c.op x
    change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
        (Opposite.op T')).hom x') =
      ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
    rw [h1, h2, hn]

  have hlift : ∀ (I Q : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (π : I ⟶ Q),
      Epi π → ∀ φ : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q,
      ∃ S : Sieve U, S ∈ Scheme.smallEtaleTopology Y U ∧ ∀ (V : Y.Etale) (g : V ⟶ U), S.arrows g →
        ∃ ψ : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ I,
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
            (Functor.whiskerRight (yoneda.map g)
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫ φ = ψ ≫ π := by
    intro I Q π hπ φ
    have hls : Sheaf.IsLocallySurjective π :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr hπ
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) π.hom := hls
    let s : Q.obj.obj (Opposite.op U) := (φ.hom.app (Opposite.op U)).hom (η U)
    refine ⟨Presheaf.imageSieve π.hom s,
      Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) π.hom s, ?_⟩
    intro V g hg
    obtain ⟨t, ht⟩ := hg
    refine ⟨(e V I).symm t, ?_⟩
    apply (e V Q).injective
    refine (he V Q _).trans (Eq.trans ?_ (he V Q _).symm)
    have h1 : (((e V I).symm t).hom.app (Opposite.op V)).hom (η V) = t :=
      (he V I _).symm.trans (Equiv.apply_symm_apply _ _)
    have h2 := hnat U V g
    have h3 : (φ.hom.app (Opposite.op V)).hom
        ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map g.op).hom (η U)) =
        (Q.obj.map g.op).hom ((φ.hom.app (Opposite.op U)).hom (η U)) :=
      NatTrans.naturality_apply φ.hom g.op (η U)
    change (φ.hom.app (Opposite.op V)).hom
        ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app
          (Opposite.op V)).hom (η V)) =
      (π.hom.app (Opposite.op V)).hom ((((e V I).symm t).hom.app (Opposite.op V)).hom (η V))
    rw [h2, h3, h1]
    exact ht.symm

  induction n generalizing F with
  | zero =>
    haveI := Injective.injective_under F
    let T := ShortComplex.mk (Injective.ι F) (Limits.cokernel.π (Injective.ι F))
      (Limits.cokernel.condition (Injective.ι F))
    have hT : T.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    have h0 : ξ.comp (Abelian.Ext.mk₀ (Injective.ι F)) (add_zero _) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hT ξ h0 (rfl : 0 + 1 = 0 + 1)
    obtain ⟨Sv, hSv, hlS⟩ := hlift _ _ T.g inferInstance (Abelian.Ext.homEquiv₀ x₃)
    refine ⟨Sv, hSv, fun V g hg => ?_⟩
    obtain ⟨ψ, hψ⟩ := hlS V g hg
    rw [← hx₃, ← Abelian.Ext.mk₀_homEquiv₀_apply x₃,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (rfl : 0 + 1 = 0 + 1) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hψ, ← Abelian.Ext.mk₀_comp_mk₀ ψ T.g,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega),
      hT.comp_extClass, Abelian.Ext.comp_zero]
  | succ n ih =>
    haveI := Injective.injective_under F
    let T := ShortComplex.mk (Injective.ι F) (Limits.cokernel.π (Injective.ι F))
      (Limits.cokernel.condition (Injective.ι F))
    have hT : T.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    have h0 : ξ.comp (Abelian.Ext.mk₀ (Injective.ι F)) (add_zero _) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hT ξ h0
      (rfl : n + 1 + 1 = n + 1 + 1)
    obtain ⟨Sv, hSv, hk⟩ := ih (Limits.cokernel (Injective.ι F)) x₃
    refine ⟨Sv, hSv, fun V g hg => ?_⟩
    rw [← hx₃, ← Abelian.Ext.comp_assoc _ _ _ (zero_add (n + 1)) (rfl : n + 1 + 1 = n + 1 + 1)
      (by omega), hk V g hg, Abelian.Ext.zero_comp]

theorem wc_etale_lift_quotient_global : ∀ (R : Type u) [CommRing R] (I : Ideal R) (B : Type u) [CommRing B] [Algebra R B] [Algebra (R ⧸ I) B] [IsScalarTower R (R ⧸ I) B] [Algebra.Etale (R ⧸ I) B], ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R'), Algebra.Etale R R' ∧ Nonempty ((R' ⧸ I.map (algebraMap R R')) ≃ₐ[R] B) :=
by
  intro R _ I B _ _ _ _ _

  obtain ⟨n, fb, val, hsurj, hker, gb, hgb⟩ :=
    wc_sh_standard_presentation_fin (R ⧸ I) B inferInstance
  have hπs : Function.Surjective (MvPolynomial.map (σ := Fin n) (Ideal.Quotient.mk I)) :=
    MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective

  choose f hf using fun b => hπs (fb b)
  obtain ⟨g, hg⟩ := hπs gb
  obtain ⟨Δ, hΔdef⟩ : ∃ Δ : MvPolynomial (Fin n) R,
      Δ = (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det := ⟨_, rfl⟩
  obtain ⟨F, hFcs, hFlast⟩ : ∃ F : Fin (n+1) → MvPolynomial (Fin (n+1)) R,
      (∀ b, F (Fin.castSucc b) = MvPolynomial.rename Fin.castSucc (f b)) ∧
      F (Fin.last n) = MvPolynomial.X (Fin.last n) * MvPolynomial.rename Fin.castSucc Δ - 1 :=
    ⟨Fin.snoc (α := fun _ => MvPolynomial (Fin (n+1)) R)
      (fun b => MvPolynomial.rename Fin.castSucc (f b))
      (MvPolynomial.X (Fin.last n) * MvPolynomial.rename Fin.castSucc Δ - 1),
      fun b => by simp, by simp⟩
  obtain ⟨J, hJ⟩ : ∃ J : Ideal (MvPolynomial (Fin (n+1)) R), J = Ideal.span (Set.range F) :=
    ⟨_, rfl⟩
  have hlastJ : F (Fin.last n) ∈ J := by rw [hJ]; exact Ideal.subset_span ⟨_, rfl⟩

  have hΔ : MvPolynomial.map (Ideal.Quotient.mk I) Δ =
      (Matrix.of fun a b => MvPolynomial.pderiv a (fb b)).det := by
    rw [hΔdef, RingHom.map_det]
    congr 1
    ext a b
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
    rw [← hf b, MvPolynomial.pderiv_map]

  have ha : ∀ h : MvPolynomial (Fin n) R,
      MvPolynomial.pderiv (Fin.last n) (MvPolynomial.rename Fin.castSucc h) = 0 := by
    intro h
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro hm
    obtain ⟨a, -, ha⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename _ _ hm)
    exact Fin.castSucc_ne_last a ha
  have hdet : (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).det =
      MvPolynomial.rename Fin.castSucc Δ * MvPolynomial.rename Fin.castSucc Δ := by
    rw [Matrix.det_succ_row _ (Fin.last n), Fin.sum_univ_castSucc]
    simp only [Matrix.of_apply, hFcs, hFlast, ha, mul_zero, zero_mul,
      Finset.sum_const_zero, zero_add, Fin.succAbove_last]
    have hlast : MvPolynomial.pderiv (Fin.last n) (MvPolynomial.X (Fin.last n) *
        MvPolynomial.rename Fin.castSucc Δ - 1 : MvPolynomial (Fin (n+1)) R) =
        MvPolynomial.rename Fin.castSucc Δ := by
      rw [map_sub, Derivation.leibniz, ha, MvPolynomial.pderiv_X_self,
        Derivation.map_one_eq_zero]
      simp
    have hsub : (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).submatrix
        Fin.castSucc Fin.castSucc =
        (MvPolynomial.rename Fin.castSucc :
          MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n+1)) R).toRingHom.mapMatrix
          (Matrix.of fun a b => MvPolynomial.pderiv a (f b)) := by
      refine Matrix.ext fun a b => ?_
      simp only [Matrix.submatrix_apply, Matrix.of_apply, hFcs, RingHom.mapMatrix_apply,
        Matrix.map_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      exact MvPolynomial.pderiv_rename (R := R) (Fin.castSucc_injective n) a (f b)
    rw [hlast, hsub, ← RingHom.map_det, ← hΔdef]
    have hsign : ((-1 : MvPolynomial (Fin (n+1)) R) ^
        ((Fin.last n : ℕ) + (Fin.last n : ℕ))) = 1 := by
      rw [Fin.val_last]; exact Even.neg_one_pow ⟨n, rfl⟩
    rw [hsign, one_mul]
    rfl

  have hEt : Algebra.Etale R (MvPolynomial (Fin (n+1)) R ⧸ J) := by
    rw [hJ]
    refine @wc_standard_etale_quotient R _ (Fin (n+1)) (Fin (n+1)) _ _ _ id
      Function.bijective_id F (MvPolynomial.X (Fin.last n) ^ 2) ?_
    show MvPolynomial.X (Fin.last n) ^ 2 *
      (Matrix.of fun i j => MvPolynomial.pderiv i (F j)).det - 1 ∈ Ideal.span (Set.range F)
    rw [hdet]
    have : (MvPolynomial.X (Fin.last n) : MvPolynomial (Fin (n+1)) R) ^ 2 *
        (MvPolynomial.rename Fin.castSucc Δ * MvPolynomial.rename Fin.castSucc Δ) - 1 =
        F (Fin.last n) * (MvPolynomial.X (Fin.last n) * MvPolynomial.rename Fin.castSucc Δ + 1) := by
      rw [hFlast]; ring
    rw [this, ← hJ]
    exact J.mul_mem_right _ hlastJ

  obtain ⟨v, hvcs, hvlast⟩ : ∃ v : Fin (n+1) → B, (∀ a, v (Fin.castSucc a) = val a) ∧
      v (Fin.last n) = MvPolynomial.aeval val gb :=
    ⟨Fin.snoc (α := fun _ => B) val (MvPolynomial.aeval val gb), fun a => by simp, by simp⟩
  have hvc : v ∘ Fin.castSucc = val := funext hvcs
  have hT : ∀ h : MvPolynomial (Fin n) R,
      MvPolynomial.aeval v (MvPolynomial.rename Fin.castSucc h) =
        MvPolynomial.aeval val (MvPolynomial.map (Ideal.Quotient.mk I) h) := by
    intro h
    rw [MvPolynomial.aeval_rename, hvc, ← Ideal.Quotient.algebraMap_eq,
      MvPolynomial.aeval_map_algebraMap]
  have hzb : ∀ q ∈ Ideal.span (Set.range fb), MvPolynomial.aeval val q = 0 := by
    intro q hq
    rw [← hker] at hq
    exact RingHom.mem_ker.mp hq

  have hΦJ : ∀ p ∈ J, MvPolynomial.aeval v p = 0 := by
    intro p hp
    have hle : J ≤ RingHom.ker (MvPolynomial.aeval (R := R) v) := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      induction i using Fin.lastCases with
      | last =>
        rw [SetLike.mem_coe, RingHom.mem_ker, hFlast, map_sub, map_mul, map_one,
          MvPolynomial.aeval_X, hvlast, hT, hΔ]
        have := hzb _ hgb
        rwa [map_sub, map_mul, map_one] at this
      | cast b =>
        rw [SetLike.mem_coe, RingHom.mem_ker, hFcs, hT, hf]
        exact hzb _ (Ideal.subset_span ⟨b, rfl⟩)
    exact RingHom.mem_ker.mp (hle hp)
  have hΦI : ∀ c ∈ I, MvPolynomial.aeval (R := R) v (MvPolynomial.C c) = 0 := by
    intro c hc
    rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply R (R ⧸ I) B,
      Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hc, map_zero]
  obtain ⟨K, hK⟩ : ∃ K : Ideal (MvPolynomial (Fin (n+1)) R),
      K = J ⊔ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin (n+1)) R) I := ⟨_, rfl⟩
  have hΦK : ∀ p ∈ K, MvPolynomial.aeval (R := R) v p = 0 := by
    have : K ≤ RingHom.ker (MvPolynomial.aeval (R := R) v) := by
      rw [hK]
      refine sup_le (fun p hp => RingHom.mem_ker.mpr (hΦJ p hp)) ?_
      rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, RingHom.mem_ker]
      exact hΦI c hc
    exact fun p hp => RingHom.mem_ker.mp (this hp)

  have hspan : Ideal.map (MvPolynomial.map (Ideal.Quotient.mk I)) (Ideal.span (Set.range f)) =
      Ideal.span (Set.range fb) := by
    rw [Ideal.map_span, ← Set.range_comp]
    have : (⇑(MvPolynomial.map (σ := Fin n) (Ideal.Quotient.mk I)) ∘ f) = fb := funext hf
    rw [this]
  have hlift : ∀ q : MvPolynomial (Fin n) R,
      MvPolynomial.map (Ideal.Quotient.mk I) q ∈ Ideal.span (Set.range fb) →
      q ∈ Ideal.span (Set.range f) ⊔
        Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) I := by
    intro q hq
    rw [← hspan] at hq
    obtain ⟨s, hs, hs'⟩ := (Ideal.mem_map_iff_of_surjective _ hπs).mp hq
    have hk : q - s ∈ RingHom.ker (MvPolynomial.map (σ := Fin n) (Ideal.Quotient.mk I)) := by
      rw [RingHom.mem_ker, map_sub, hs', sub_self]
    rw [MvPolynomial.ker_map, Ideal.mk_ker] at hk
    have := Submodule.add_mem_sup hs hk
    simpa using this

  have hrC : (MvPolynomial.rename Fin.castSucc :
      MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n+1)) R).toRingHom.comp
        MvPolynomial.C = MvPolynomial.C :=
    RingHom.ext fun c => by simp
  have hmap : ∀ q ∈ Ideal.span (Set.range f) ⊔
      Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) I,
      MvPolynomial.rename Fin.castSucc q ∈ K := by
    intro q hq
    have h1 : Ideal.map (MvPolynomial.rename Fin.castSucc :
        MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (n+1)) R).toRingHom
        (Ideal.span (Set.range f) ⊔
          Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) I) ≤ K := by
      rw [Ideal.map_sup, Ideal.map_span, Ideal.map_map, hrC, hK]
      refine sup_le_sup ?_ le_rfl
      rw [hJ]
      apply Ideal.span_mono
      rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
      exact ⟨Fin.castSucc b, by rw [hFcs]; rfl⟩
    exact h1 (Ideal.mem_map_of_mem _ hq)

  have hy : MvPolynomial.X (Fin.last n) - MvPolynomial.rename Fin.castSucc g ∈ K := by
    have hu : g * Δ - 1 ∈ Ideal.span (Set.range f) ⊔
        Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) I := by
      apply hlift
      rw [map_sub, map_mul, map_one, hg, hΔ]
      exact hgb
    have h1 := hmap _ hu
    rw [map_sub, map_mul, map_one] at h1
    have h2 : F (Fin.last n) ∈ K := by rw [hK]; exact Ideal.mem_sup_left hlastJ
    have key : MvPolynomial.X (Fin.last n) - MvPolynomial.rename Fin.castSucc g =
        -(MvPolynomial.X (Fin.last n)) * (MvPolynomial.rename Fin.castSucc g *
          MvPolynomial.rename Fin.castSucc Δ - 1) +
        MvPolynomial.rename Fin.castSucc g * F (Fin.last n) := by
      rw [hFlast]; ring
    rw [key]
    exact K.add_mem (K.mul_mem_left _ h1) (K.mul_mem_left _ h2)

  obtain ⟨w, hwcs, hwlast⟩ : ∃ w : Fin (n+1) → MvPolynomial (Fin n) R,
      (∀ a, w (Fin.castSucc a) = MvPolynomial.X a) ∧ w (Fin.last n) = g :=
    ⟨Fin.snoc (α := fun _ => MvPolynomial (Fin n) R) MvPolynomial.X g, fun a => by simp,
      by simp⟩
  have hE : ∀ p : MvPolynomial (Fin (n+1)) R,
      p - MvPolynomial.rename Fin.castSucc (MvPolynomial.aeval w p) ∈ K := by
    have hext : (Ideal.Quotient.mkₐ R K).comp ((MvPolynomial.rename Fin.castSucc).comp
        (MvPolynomial.aeval w)) = Ideal.Quotient.mkₐ R K := by
      apply MvPolynomial.algHom_ext
      intro i
      induction i using Fin.lastCases with
      | last =>
        simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, hwlast, Ideal.Quotient.mkₐ_eq_mk]
        exact (Ideal.Quotient.eq.mpr hy).symm
      | cast a =>
        simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, hwcs, MvPolynomial.rename_X]
    intro p
    have := congrArg (fun φ => φ p) hext
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
    exact Ideal.Quotient.eq.mp this.symm

  refine ⟨MvPolynomial (Fin (n+1)) R ⧸ J, inferInstance, inferInstance, hEt, ?_⟩
  let Φ₁ : (MvPolynomial (Fin (n+1)) R ⧸ J) →ₐ[R] B :=
    Ideal.Quotient.liftₐ J (MvPolynomial.aeval v) hΦJ
  have hΦ₁ : ∀ a ∈ I.map (algebraMap R (MvPolynomial (Fin (n+1)) R ⧸ J)), Φ₁ a = 0 := by
    intro a ha
    have hle : I.map (algebraMap R (MvPolynomial (Fin (n+1)) R ⧸ J)) ≤ RingHom.ker Φ₁ := by
      rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes,
        IsScalarTower.algebraMap_apply R (R ⧸ I) B, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem.mpr hc, map_zero]
    exact RingHom.mem_ker.mp (hle ha)
  let φ := Ideal.Quotient.liftₐ (I.map (algebraMap R (MvPolynomial (Fin (n+1)) R ⧸ J))) Φ₁ hΦ₁
  have hφ : ∀ p, φ (Ideal.Quotient.mk _ (Ideal.Quotient.mk J p)) = MvPolynomial.aeval v p :=
    fun p => rfl
  have hsurjφ : Function.Surjective φ := by
    intro b
    obtain ⟨p, rfl⟩ := hsurj b
    obtain ⟨p', rfl⟩ := hπs p
    exact ⟨_, (hφ _).trans (hT p')⟩
  have hκK : ∀ p ∈ K, (Ideal.Quotient.mk (I.map (algebraMap R
      (MvPolynomial (Fin (n+1)) R ⧸ J)))) (Ideal.Quotient.mk J p) = 0 := by
    intro p hp
    rw [hK] at hp
    have hle : J ⊔ Ideal.map (MvPolynomial.C : R →+* MvPolynomial (Fin (n+1)) R) I ≤
        RingHom.ker ((Ideal.Quotient.mk (I.map (algebraMap R
          (MvPolynomial (Fin (n+1)) R ⧸ J)))).comp (Ideal.Quotient.mk J)) := by
      refine sup_le (fun q hq => ?_) ?_
      · rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hq,
          map_zero]
      · rw [Ideal.map_le_iff_le_comap]
        intro c hc
        rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, ← MvPolynomial.algebraMap_eq,
          Ideal.Quotient.mk_algebraMap]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hc)
    exact RingHom.mem_ker.mp (hle hp)
  have hinjφ : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro q hq
    obtain ⟨q', rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q'
    rw [hφ] at hq
    apply hκK
    have h0 : MvPolynomial.aeval v p =
        MvPolynomial.aeval v (MvPolynomial.rename Fin.castSucc (MvPolynomial.aeval w p)) := by
      have := hΦK _ (hE p)
      rw [map_sub, sub_eq_zero] at this
      exact this
    have h1 : MvPolynomial.map (Ideal.Quotient.mk I) (MvPolynomial.aeval w p) ∈
        Ideal.span (Set.range fb) := by
      rw [← hker, RingHom.mem_ker, ← hT, ← h0]
      exact hq
    have hmem := K.add_mem (hmap _ (hlift _ h1)) (hE p)
    simpa using hmem
  exact ⟨AlgEquiv.ofBijective φ ⟨hinjφ, hsurjφ⟩⟩

theorem wc_etale_normal_sepclosed_rank_one_idem : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [IsSepClosed (FractionRing R)] (A : Type u) [CommRing A] [Algebra R A], Algebra.Etale R A → ∃ (n : ℕ) (e : Fin n → A), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i (x : A), ∃ r s : R, r ≠ 0 ∧ r • (x * e i) = s • e i :=
by
  intro R _ _ _ _ A _ _ hEt
  classical
  haveI := hEt
  let K := FractionRing R
  let B := TensorProduct R K A
  let j : A →ₐ[R] B := Algebra.TensorProduct.includeRight

  have hloc : IsLocalizedModule (nonZeroDivisors R) (TensorProduct.mk R K A 1) :=
    (isLocalizedModule_iff_isBaseChange (nonZeroDivisors R) K (TensorProduct.mk R K A 1)).mpr
      (TensorProduct.isBaseChange R A K)
  have hjf : ∀ a : A, j a = TensorProduct.mk R K A 1 a := fun a => rfl
  have hinj : Function.Injective j := by
    intro a₁ a₂ h
    rw [hjf, hjf] at h
    obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors R) h
    have hreg : IsSMulRegular A (c : R) := Module.Flat.isSMulRegular_of_nonZeroDivisors c.2
    exact hreg hc
  have hden : ∀ y : B, ∃ (s : R) (a : A), s ≠ 0 ∧ s • y = j a := by
    intro y
    obtain ⟨⟨a, t⟩, h⟩ := IsLocalizedModule.surj (nonZeroDivisors R) (TensorProduct.mk R K A 1) y
    exact ⟨t, a, nonZeroDivisors.ne_zero t.2, h⟩
  have hunit : ∀ s : R, s ≠ 0 → IsUnit (algebraMap R B s) := by
    intro s hs
    rw [IsScalarTower.algebraMap_apply R K B]
    apply IsUnit.map
    apply Ne.isUnit
    intro h0
    apply hs
    exact (IsFractionRing.injective R K) (by rw [h0, map_zero])

  haveI hEB : Algebra.Etale K B := Algebra.Etale.baseChange R A K
  obtain ⟨I, hI, Ai, _, _, Θ, hAi⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K B).mp hEB
  haveI := hI
  letI : Fintype I := Fintype.ofFinite I
  have hsurj : ∀ i, Function.Surjective (algebraMap K (Ai i)) := by
    intro i
    haveI := (hAi i).2
    exact IsSepClosed.algebraMap_surjective K (Ai i)
  let σ : I ≃ Fin (Nat.card I) := Finite.equivFin I
  let ε : Fin (Nat.card I) → B := fun k => Θ.symm (Pi.single (M := Ai) (σ.symm k) 1)
  have hε : ∀ k, ε k = Θ.symm (Pi.single (M := Ai) (σ.symm k) 1) := fun k => rfl
  have hid0 : ∀ a : I, Θ.symm (Pi.single (M := Ai) a 1) * Θ.symm (Pi.single (M := Ai) a 1) =
      Θ.symm (Pi.single (M := Ai) a 1) := by
    intro a
    rw [← map_mul, ← Pi.single_mul, mul_one]
  have hor0 : ∀ a b : I, a ≠ b →
      Θ.symm (Pi.single (M := Ai) a 1) * Θ.symm (Pi.single (M := Ai) b 1) = 0 := by
    intro a b hab
    rw [← map_mul]
    have h0 : Pi.single (M := Ai) a 1 * Pi.single (M := Ai) b 1 = 0 := by
      funext m
      rw [Pi.mul_apply, Pi.zero_apply]
      by_cases hm : m = a
      · subst hm
        rw [Pi.single_eq_of_ne hab, mul_zero]
      · rw [Pi.single_eq_of_ne hm, zero_mul]
    rw [h0, map_zero]
  have hsum0 : ∑ k, ε k = 1 := by
    have h1 : ∑ k, ε k = Θ.symm (∑ k, Pi.single (M := Ai) (σ.symm k) 1) := by
      rw [map_sum]
    have h2 : ∑ a : I, Pi.single (M := Ai) a 1 = 1 :=
      Finset.univ_sum_single (fun a => (1 : Ai a))
    rw [h1, Equiv.sum_comp σ.symm (fun a => Pi.single (M := Ai) a 1), h2, map_one]
  have hrk0 : ∀ (a : I) (y : B), ∃ c : K,
      y * Θ.symm (Pi.single (M := Ai) a 1) = c • Θ.symm (Pi.single (M := Ai) a 1) := by
    intro a y
    obtain ⟨c, hc⟩ := hsurj a (Θ y a)
    refine ⟨c, Θ.injective ?_⟩
    rw [map_mul, map_smul, AlgEquiv.apply_symm_apply]
    funext m
    rw [Pi.mul_apply, Pi.smul_apply]
    by_cases hm : m = a
    · subst hm
      rw [Pi.single_eq_same, mul_one, Algebra.smul_def, mul_one, hc]
    · rw [Pi.single_eq_of_ne hm, mul_zero, smul_zero]
  have hrkR : ∀ k (y : B), ∃ r s : R, r ≠ 0 ∧ r • (y * ε k) = s • ε k := by
    intro k y
    obtain ⟨c, hc⟩ := hrk0 (σ.symm k) y
    obtain ⟨x, t, ht, hxt⟩ := IsFractionRing.div_surjective (A := R) c
    refine ⟨t, x, nonZeroDivisors.ne_zero ht, ?_⟩
    have htne : algebraMap R K t ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ht
    have hmul : algebraMap R K t * c = algebraMap R K x := by
      rw [← hxt]
      exact mul_div_cancel₀ _ htne
    rw [hε, hc, ← algebraMap_smul K t, ← algebraMap_smul K x, smul_smul, hmul]

  have hnorm := wc_weaklyEtale_normal_idem R A inferInstance
  have hlift : ∀ k, ∃ e : A, j e = ε k := by
    intro k
    obtain ⟨s, a, hs, hsa⟩ := hden (ε k)
    have hidk : ε k * ε k = ε k := hid0 (σ.symm k)
    have haa : a * a = s • a := by
      apply hinj
      rw [map_mul, map_smul, ← hsa, smul_mul_smul_comm, hidk, mul_smul]
    obtain ⟨c', hc'⟩ := hnorm a s hs haa
    refine ⟨c', ?_⟩
    have h2 : s • j c' = s • ε k := by
      rw [← map_smul j s c', ← hc', hsa]
    have h3 : algebraMap R B s * j c' = algebraMap R B s * ε k := by
      rw [← Algebra.smul_def, ← Algebra.smul_def]
      exact h2
    exact (hunit s hs).mul_left_cancel h3
  choose e he using hlift
  refine ⟨Nat.card I, e, ?_, ?_, ?_, ?_⟩
  · intro k
    show e k * e k = e k
    apply hinj
    rw [map_mul, he]
    exact hid0 _
  · intro k l hkl
    apply hinj
    rw [map_mul, he, he, map_zero]
    exact hor0 _ _ (fun h => hkl (σ.symm.injective h))
  · apply hinj
    rw [map_sum, map_one]
    simp only [he]
    exact hsum0
  · intro k x
    obtain ⟨r, s, hr, h⟩ := hrkR k (j x)
    refine ⟨r, s, hr, hinj ?_⟩
    rw [map_smul, map_mul, map_smul, he]
    exact h

theorem wc_normal_sepclosed_quot_etale_idem_split : ∀ (Z : Scheme.{u}) [IsAffine Z] (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [IsSepClosed (FractionRing R)] (π : R →+* Γ(Z, ⊤)), Function.Surjective π → ∀ (V : Scheme.{u}) [IsAffine V] (g : V ⟶ Z) [Etale g], ∃ (n : ℕ) (e : Fin n → Γ(V, ⊤)), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, IsOpenImmersion ((V.basicOpen (e i)).ι ≫ g) :=
by
  intro Z _ R _ _ _ _ π hπ V _ g _
  classical

  obtain ⟨R', _, _, q, p, hEt, hpb⟩ : ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R')
      (q : V ⟶ Spec (.of R')) (p : Z ⟶ Spec (.of R)),
      Algebra.Etale R R' ∧ IsPullback q g (Spec.map (CommRingCat.ofHom (algebraMap R R'))) p := by
    let I := RingHom.ker π
    let ψ : R ⧸ I ≃+* Γ(Z, ⊤) := RingHom.quotientKerEquivOfSurjective hπ
    let γ : Γ(Z, ⊤) →+* Γ(V, ⊤) := g.appTop.hom
    letI : Algebra R Γ(V, ⊤) := (γ.comp π).toAlgebra
    letI : Algebra (R ⧸ I) Γ(V, ⊤) := (γ.comp ψ.toRingHom).toAlgebra
    have hψmk : ∀ r : R, ψ (Ideal.Quotient.mk I r) = π r := fun r =>
      RingHom.quotientKerEquivOfSurjective_apply_mk hπ r
    haveI : IsScalarTower R (R ⧸ I) Γ(V, ⊤) := IsScalarTower.of_algebraMap_eq (fun r => by
      change γ (π r) = γ (ψ (Ideal.Quotient.mk I r))
      rw [hψmk])
    have hγ : γ.Etale := HasRingHomProperty.appTop @Etale g inferInstance
    haveI : Algebra.Etale (R ⧸ I) Γ(V, ⊤) := by
      rw [← RingHom.etale_algebraMap]
      exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective ψ.bijective) hγ
    obtain ⟨R', _, _, hEt, ⟨ε⟩⟩ := wc_etale_lift_quotient_global R I Γ(V, ⊤)

    have P0 : IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap R R')))))
        (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R')
          Ideal.le_comap_map)))
        (Spec.map (CommRingCat.ofHom (algebraMap R R')))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
      apply isPullback_SpecMap_of_isPushout
      have h := CommRingCat.isPushout_tensorProduct R R' (R ⧸ I)
      let τ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' I
      refine h.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (RingEquiv.toCommRingCatIso τ.symm.toRingEquiv) ?_ ?_ ?_ ?_
      · rfl
      · rfl
      · ext x
        change τ.symm (x ⊗ₜ[R] 1) = Ideal.Quotient.mk _ x
        rw [AlgEquiv.symm_apply_eq]
        exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk R' I x).symm
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        ext r
        change τ.symm (1 ⊗ₜ[R] Ideal.Quotient.mk I r) =
          Ideal.quotientMap (I.map (algebraMap R R')) (algebraMap R R') Ideal.le_comap_map
            (Ideal.Quotient.mk I r)
        rw [Ideal.quotientMap_mk, AlgEquiv.symm_apply_eq,
          Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
        rw [Algebra.algebraMap_eq_smul_one, ← Ideal.Quotient.algebraMap_eq,
          Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]

    let e1 : Spec (.of (R' ⧸ I.map (algebraMap R R'))) ≅ V :=
      Scheme.Spec.mapIso (ε.symm.toRingEquiv.toCommRingCatIso).op ≪≫ V.isoSpec.symm
    let e3 : Spec (.of (R ⧸ I)) ≅ Z :=
      Scheme.Spec.mapIso (ψ.symm.toCommRingCatIso).op ≪≫ Z.isoSpec.symm
    refine ⟨R', inferInstance, inferInstance,
      e1.inv ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap R R')))),
      e3.inv ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)), hEt, ?_⟩
    refine P0.of_iso e1 (Iso.refl _) e3 (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · change Spec.map (CommRingCat.ofHom _) ≫
          (Spec.map (CommRingCat.ofHom ψ.symm.toRingHom) ≫ Z.isoSpec.inv) =
        (Spec.map (CommRingCat.ofHom ε.symm.toRingEquiv.toRingHom) ≫ V.isoSpec.inv) ≫ g
      rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Spec.map_comp_assoc,
        ← Spec.map_comp_assoc]
      congr 2
      ext z
      obtain ⟨r, rfl⟩ := hπ z
      change Ideal.quotientMap _ _ Ideal.le_comap_map (ψ.symm (π r)) = ε.symm (γ (π r))
      have h1 : ψ.symm (π r) = Ideal.Quotient.mk I r := by
        rw [RingEquiv.symm_apply_eq, hψmk]
      have h2 : γ (π r) = algebraMap R Γ(V, ⊤) r := rfl
      rw [h1, h2, AlgEquiv.commutes, Ideal.quotientMap_mk]
      rfl
    · simp
    · simp

  obtain ⟨n, e, hid, hor, hsum, hrk⟩ := wc_etale_normal_sepclosed_rank_one_idem R R' hEt

  have s17 : ∀ f : R', IsIdempotentElem f → (∀ x : R', ∃ r s : R, r ≠ 0 ∧ r • (x * f) = s • f) →
      IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f)))) := by
    intro f he hrkf
    have hL : Algebra.Etale R (Localization.Away f) := Algebra.Etale.comp R R' (Localization.Away f)
    haveI hEtL : Etale (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f)))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Etale)]
      exact RingHom.etale_algebraMap.mpr hL
    have hℓe : algebraMap R' (Localization.Away f) f = 1 :=
      (IsIdempotentElem.iff_eq_one_of_isUnit (IsLocalization.Away.algebraMap_isUnit f)).mp
        (he.map _)
    have hsurj : Function.Surjective (algebraMap R' (Localization.Away f)) := by
      intro y
      obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers f) y
      refine ⟨x, ?_⟩
      rw [IsLocalization.eq_mk'_iff_mul_eq]
      obtain ⟨k, hk⟩ := s.2
      rw [← hk, map_pow, hℓe, one_pow, mul_one]
    have hrk' : ∀ a : Localization.Away f, ∃ r s : R, r ≠ 0 ∧
        r • a = algebraMap R (Localization.Away f) s := by
      intro a
      obtain ⟨x, rfl⟩ := hsurj a
      obtain ⟨r, s, hr, h⟩ := hrkf x
      refine ⟨r, s, hr, ?_⟩
      have := congrArg (algebraMap R' (Localization.Away f)) h
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, map_mul, map_mul, hℓe, mul_one, mul_one,
        ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply] at this
      rw [Algebra.smul_def]
      exact this
    have hepi : Algebra.IsEpi R (Localization.Away f) := by
      rw [Algebra.isEpi_iff_forall_one_tmul_eq]
      intro a
      obtain ⟨r, s, hr, h⟩ := hrk' a
      have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors
        (M := TensorProduct R (Localization.Away f) (Localization.Away f))
        (mem_nonZeroDivisors_of_ne_zero hr)
      have key : r • ((1 : Localization.Away f) ⊗ₜ[R] a) =
          r • (a ⊗ₜ[R] (1 : Localization.Away f)) := by
        rw [← TensorProduct.tmul_smul, h, TensorProduct.smul_tmul', h,
          Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      exact hreg key
    haveI : Epi (CommRingCat.ofHom (algebraMap R (Localization.Away f))) :=
      CommRingCat.epi_iff_epi.mpr hepi
    haveI hmono : Mono (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f)))) := by
      have h := (inferInstance :
        Mono (Scheme.Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away f))).op))
      rwa [Scheme.Spec_map, Quiver.Hom.unop_op] at h
    exact IsOpenImmersion.of_flat_of_mono _
  have hop : ∀ i, IsOpenImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (e i))))) :=
    fun i => s17 (e i) (hid i) (hrk i)

  obtain ⟨e', h1, h2, h3, h4⟩ : ∃ e' : Fin n → Γ(Spec (.of R'), ⊤), (∀ i, IsIdempotentElem (e' i)) ∧
      (∀ i j, i ≠ j → e' i * e' j = 0) ∧ ∑ i, e' i = 1 ∧
      ∀ i, IsOpenImmersion (((Spec (.of R')).basicOpen (e' i)).ι ≫
        Spec.map (CommRingCat.ofHom (algebraMap R R'))) := by
    refine ⟨fun i => (Scheme.ΓSpecIso (.of R')).inv.hom (e i), fun i => (hid i).map _,
      fun i j hij => by simp only [← map_mul, hor i j hij, map_zero],
      by rw [← map_sum, hsum, map_one], fun i => ?_⟩
    haveI hj : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (algebraMap R' (Localization.Away (e i))))) := IsOpenImmersion.of_isLocalization (e i)
    haveI := hop i
    have hr : Set.range ((Spec (.of R')).basicOpen ((Scheme.ΓSpecIso (.of R')).inv.hom (e i))).ι =
        Set.range (Spec.map (CommRingCat.ofHom (algebraMap R' (Localization.Away (e i))))) := by
      rw [Scheme.Opens.range_ι, basicOpen_eq_of_affine]
      exact (PrimeSpectrum.localization_away_comap_range (Localization.Away (e i)) (e i)).symm
    have hfac := IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hr
    rw [← hfac, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq]
    infer_instance

  refine ⟨n, fun i => q.appTop.hom (e' i), fun i => (h1 i).map q.appTop.hom,
    fun i j hij => by simp only [← map_mul, h2 i j hij, map_zero],
    by rw [← map_sum, h3, map_one], fun i => ?_⟩
  have hU := Scheme.preimage_basicOpen_top q (e' i)
  have key : ∀ U' : V.Opens, U' = q ⁻¹ᵁ (Spec (.of R')).basicOpen (e' i) →
      IsOpenImmersion (U'.ι ≫ g) := by
    rintro U' rfl
    have h := (isPullback_morphismRestrict q ((Spec (.of R')).basicOpen (e' i))).paste_vert hpb
    exact MorphismProperty.of_isPullback (P := @IsOpenImmersion) h (h4 i)
  exact key _ hU.symm

theorem wc_normal_sepclosed_quot_basicOpen : ∀ (Z : Scheme.{u}) [IsAffine Z] (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [IsSepClosed (FractionRing R)] (π : R →+* Γ(Z, ⊤)), Function.Surjective π → ∀ c : Γ(Z, ⊤), IsAffine (Z.basicOpen c : Scheme.{u}) ∧ ∃ (R' : Type u) (_ : CommRing R') (_ : IsDomain R') (_ : IsIntegrallyClosed R') (_ : IsSepClosed (FractionRing R')) (π' : R' →+* Γ((Z.basicOpen c : Scheme.{u}), ⊤)), Function.Surjective π' :=
by
  intro Z _ R hRr hRd hRi hRs π hπ c
  have s1 : ∀ (K L : Type u) [Field K] [Field L] [IsSepClosed K], (K ≃+* L) → IsSepClosed L := by
    intro K L _ _ _ e
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    have hqsep : (p.map (e.symm : L →+* K)).Separable := hsep.map
    have hdeg : (p.map (e.symm : L →+* K)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root _ hdeg hqsep
    refine ⟨e x, ?_⟩
    have hqp : (p.map (e.symm : L →+* K)).map (e : K →+* L) = p := by
      rw [Polynomial.map_map, RingEquiv.comp_symm, Polynomial.map_id]
    have hx' : Polynomial.eval x (p.map (e.symm : L →+* K)) = 0 := hx
    have h2 := Polynomial.eval_map_apply (e : K →+* L) (p := p.map (e.symm : L →+* K)) (x := x)
    rw [hqp, hx', map_zero] at h2
    exact h2
  have s3 : ∀ r : R, ∃ π' : Localization.Away r →+* Γ((Z.basicOpen (π r) : Scheme.{u}), ⊤),
      Function.Surjective π' := by
    intro r
    have hloc : IsLocalization.Away (π r) Γ(Z, Z.basicOpen (π r)) :=
      (isAffineOpen_top Z).isLocalization_basicOpen (π r)
    let g : R →+* Γ(Z, Z.basicOpen (π r)) :=
      (algebraMap Γ(Z, ⊤) Γ(Z, Z.basicOpen (π r))).comp π
    have hg : ∀ y : Submonoid.powers r, IsUnit (g y) := by
      rintro ⟨y, n, rfl⟩
      simp only [g, RingHom.comp_apply, map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit (π r)).pow n
    let φ := IsLocalization.lift (M := Submonoid.powers r) (S := Localization.Away r) hg
    have hφ : Function.Surjective φ := by
      intro z
      obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (π r) z
      obtain ⟨a', rfl⟩ := hπ a
      refine ⟨IsLocalization.mk' (Localization.Away r) a'
        (⟨r ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers r) n⟩ : Submonoid.powers r), ?_⟩
      rw [IsLocalization.lift_mk'_spec]
      simp only [g, RingHom.comp_apply, map_pow]
      rw [← ha, mul_comm]
    let ε := (Scheme.Opens.topIso (Z.basicOpen (π r))).commRingCatIsoToRingEquiv.symm
    exact ⟨(ε : _ →+* _).comp φ, ε.surjective.comp hφ⟩
  refine ⟨(isAffineOpen_top Z).basicOpen c, ?_⟩
  obtain ⟨r, rfl⟩ := hπ c
  obtain ⟨φ, hφ⟩ := s3 r
  by_cases hr : r = 0
  · subst hr
    have : Subsingleton (Localization.Away (0 : R)) :=
      IsLocalization.subsingleton (M := Submonoid.powers (0 : R))
        (S := Localization.Away (0 : R)) (Submonoid.mem_powers 0)
    exact ⟨R, hRr, hRd, hRi, hRs,
      φ.comp (algebraMap R _), hφ.comp (Function.surjective_to_subsingleton _)⟩
  · have hM : Submonoid.powers r ≤ nonZeroDivisors R :=
      powers_le_nonZeroDivisors_of_noZeroDivisors hr
    haveI hD : IsDomain (Localization.Away r) := IsLocalization.isDomain_localization hM
    have hIC : IsIntegrallyClosed (Localization.Away r) :=
      isIntegrallyClosed_of_isLocalization (Localization.Away r) (Submonoid.powers r) hM
    have hunit : ∀ y : Submonoid.powers r, IsUnit (algebraMap R (FractionRing R) y) := fun y =>
      IsUnit.mk0 _ (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (hM y.2))
    letI : Algebra (Localization.Away r) (FractionRing R) :=
      (IsLocalization.lift (M := Submonoid.powers r) (S := Localization.Away r) hunit).toAlgebra
    haveI : IsScalarTower R (Localization.Away r) (FractionRing R) :=
      IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.lift_eq hunit x).symm)
    haveI : IsFractionRing (Localization.Away r) (FractionRing R) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers r)
        (Localization.Away r) (FractionRing R)
    let e : FractionRing (Localization.Away r) ≃+* FractionRing R :=
      (IsLocalization.algEquiv (nonZeroDivisors (Localization.Away r))
        (FractionRing (Localization.Away r)) (FractionRing R)).toRingEquiv
    exact ⟨Localization.Away r, inferInstance, hD, hIC,
      @s1 (FractionRing R) (FractionRing (Localization.Away r)) _ _ hRs e.symm, φ, hφ⟩

theorem wc_finite_etale_section_of_idem_split : ∀ (W : Scheme.{u}) [IsAffine W], (∀ (V : Scheme.{u}) [IsAffine V] (g : V ⟶ W) [Etale g], ∃ (n : ℕ) (e : Fin n → Γ(V, ⊤)), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, IsOpenImmersion ((V.basicOpen (e i)).ι ≫ g)) → ∀ (V : Scheme.{u}) (p : V ⟶ W), IsFinite p → Etale p → Surjective p → ∃ σ : W ⟶ V, σ ≫ p = 𝟙 W :=
by
  intro W _ H V p hfin het hsurj
  classical
  haveI := hfin
  haveI := het
  haveI := hsurj
  haveI : IsAffine V := isAffine_of_isAffineHom p
  obtain ⟨n, e, -, horth, hsum, hopen⟩ := H V p

  have hcov : ∀ x : V, ∃ i, x ∈ V.basicOpen (e i) := by
    intro x
    by_contra hne
    push_neg at hne
    have hmem : ∀ i, ConcreteCategory.hom (V.presheaf.germ ⊤ x trivial) (e i) ∈
        IsLocalRing.maximalIdeal (V.presheaf.stalk x) := fun i =>
      (IsLocalRing.mem_maximalIdeal _).mpr ((Scheme.mem_basicOpen_top V (e i) x).not.mp (hne i))
    have h1 : ConcreteCategory.hom (V.presheaf.germ ⊤ x trivial) (∑ i, e i) ∈
        IsLocalRing.maximalIdeal (V.presheaf.stalk x) := by
      rw [map_sum]
      exact Ideal.sum_mem _ (fun i _ => hmem i)
    rw [hsum, map_one] at h1
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1) isUnit_one
  have hdisj : ∀ i j, i ≠ j →
      Disjoint (V.basicOpen (e i) : Set V) (V.basicOpen (e j) : Set V) := by
    intro i j hij
    rw [Set.disjoint_left]
    intro x hi hj
    have h : V.basicOpen (e i * e j) = ⊥ := by rw [horth i j hij, Scheme.basicOpen_zero]
    rw [Scheme.basicOpen_mul] at h
    have hx : x ∈ V.basicOpen (e i) ⊓ V.basicOpen (e j) :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨hi, hj⟩
    rw [h] at hx
    simp at hx
  have hclosed : ∀ i, IsClosed (V.basicOpen (e i) : Set V) := by
    intro i
    have hc : (V.basicOpen (e i) : Set V)ᶜ =
        ⋃ (j : Fin n) (_ : j ≠ i), (V.basicOpen (e j) : Set V) := by
      ext x
      simp only [Set.mem_compl_iff, Set.mem_iUnion]
      constructor
      · intro hx
        obtain ⟨j, hj⟩ := hcov x
        refine ⟨j, fun h => hx ?_, hj⟩
        subst h
        exact hj
      · rintro ⟨j, hji, hj⟩ hi
        exact Set.disjoint_left.mp (hdisj j i hji) hj hi
    rw [← isOpen_compl_iff, hc]
    exact isOpen_iUnion fun j => isOpen_iUnion fun _ => (V.basicOpen (e j)).isOpen

  have s2 : ∀ (U : Fin n → Set W), (∀ i, IsOpen (U i)) → (∀ i, IsClosed (U i)) →
      (∀ x, ∃ i, x ∈ U i) → ∃ D : Fin n → Set W, (∀ k, IsOpen (D k)) ∧ (∀ k, D k ⊆ U k) ∧
        (∀ k l, k ≠ l → Disjoint (D k) (D l)) ∧ ∀ x, ∃ k, x ∈ D k := by
    intro U hUo hUc hUcov
    refine ⟨fun k => U k \ ⋃ (j : Fin n) (_ : j < k), U j, ?_, ?_, ?_, ?_⟩
    · intro k
      exact (hUo k).sdiff
        (isClosed_iUnion_of_finite fun j => isClosed_iUnion_of_finite fun _ => hUc j)
    · intro k
      exact Set.diff_subset
    · have aux : ∀ k l : Fin n, k < l → Disjoint (U k \ ⋃ (j : Fin n) (_ : j < k), U j)
          (U l \ ⋃ (j : Fin n) (_ : j < l), U j) := by
        intro k l hkl
        rw [Set.disjoint_left]
        rintro x ⟨hxk, -⟩ ⟨-, hxl⟩
        exact hxl (Set.mem_iUnion₂.mpr ⟨k, hkl, hxk⟩)
      intro k l hkl
      rcases lt_or_gt_of_ne hkl with h | h
      · exact aux k l h
      · exact (aux l k h).symm
    · intro x
      obtain ⟨i, hi⟩ := hUcov x
      have hS : (Finset.univ.filter (fun j => x ∈ U j)).Nonempty :=
        ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩⟩
      refine ⟨(Finset.univ.filter (fun j => x ∈ U j)).min' hS,
        (Finset.mem_filter.mp (Finset.min'_mem _ hS)).2, fun h => ?_⟩
      obtain ⟨j, hj, hxj⟩ := Set.mem_iUnion₂.mp h
      have hle := Finset.min'_le (Finset.univ.filter (fun j => x ∈ U j)) j
        (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxj⟩)
      exact absurd hj (not_lt.mpr hle)

  have s3 : ∀ (D : Fin n → W.Opens), (∀ k l, k ≠ l → Disjoint (D k : Set W) (D l : Set W)) →
      (∀ x : W, ∃ k, x ∈ D k) → (∀ k, ∃ s : (D k : Scheme.{u}) ⟶ V, s ≫ p = (D k).ι) →
      ∃ σ : W ⟶ V, σ ≫ p = 𝟙 W := by
    intro D hD hDc hs
    choose s hs using hs
    have hcover : TopologicalSpace.IsOpenCover D := by
      apply TopologicalSpace.IsOpenCover.mk
      rw [eq_top_iff]
      intro x _
      obtain ⟨k, hk⟩ := hDc x
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hk⟩
    let 𝒰 := W.openCoverOfIsOpenCover D hcover
    let s' : (k : 𝒰.I₀) → 𝒰.X k ⟶ V := fun k => s k
    have hcompat : ∀ k l : 𝒰.I₀, Limits.pullback.fst (𝒰.f k) (𝒰.f l) ≫ s' k =
        Limits.pullback.snd (𝒰.f k) (𝒰.f l) ≫ s' l := by
      intro k l
      by_cases hkl : k = l
      · subst hkl
        rw [Limits.fst_eq_snd_of_mono_eq]
      · haveI : IsEmpty ↥(Limits.pullback (𝒰.f k) (𝒰.f l)) := by
          apply Scheme.isEmpty_of_commSq (IsPullback.of_hasPullback _ _).toCommSq
          change Disjoint (Set.range (D k).ι) (Set.range (D l).ι)
          rw [Scheme.Opens.range_ι, Scheme.Opens.range_ι]
          exact hD k l hkl
        exact isInitialOfIsEmpty.hom_ext _ _
    refine ⟨𝒰.glueMorphisms s' hcompat, ?_⟩
    apply 𝒰.hom_ext
    intro k
    rw [← Category.assoc, 𝒰.ι_glueMorphisms, Category.comp_id]
    exact hs k

  have hrange : ∀ i, Set.range ((V.basicOpen (e i)).ι ≫ p) = p '' (V.basicOpen (e i) : Set V) := by
    intro i
    have hf : ⇑((V.basicOpen (e i)).ι ≫ p) = ⇑p ∘ ⇑(V.basicOpen (e i)).ι := by
      funext x
      exact Scheme.Hom.comp_apply _ _ x
    rw [hf, Set.range_comp, Scheme.Opens.range_ι]
  have hUo : ∀ i, IsOpen (Set.range ((V.basicOpen (e i)).ι ≫ p)) := by
    intro i
    haveI := hopen i
    exact IsOpenImmersion.isOpen_range _
  have hUc : ∀ i, IsClosed (Set.range ((V.basicOpen (e i)).ι ≫ p)) := by
    intro i
    rw [hrange i]
    exact p.isClosedMap _ (hclosed i)
  have hUcov : ∀ y : W, ∃ i, y ∈ Set.range ((V.basicOpen (e i)).ι ≫ p) := by
    intro y
    obtain ⟨v, rfl⟩ := p.surjective y
    obtain ⟨i, hi⟩ := hcov v
    refine ⟨i, ?_⟩
    rw [hrange i]
    exact ⟨v, hi, rfl⟩

  obtain ⟨Dset, hDo, hDsub, hDdisj, hDcov⟩ :=
    s2 (fun i => Set.range ((V.basicOpen (e i)).ι ≫ p)) hUo hUc hUcov
  apply s3 (fun k => ⟨Dset k, hDo k⟩) hDdisj hDcov
  intro k
  haveI := hopen k
  have hsub : Set.range (Scheme.Opens.ι (⟨Dset k, hDo k⟩ : W.Opens)) ⊆
      Set.range ((V.basicOpen (e k)).ι ≫ p) := by
    rw [Scheme.Opens.range_ι]
    exact hDsub k
  refine ⟨IsOpenImmersion.lift _ _ hsub ≫ (V.basicOpen (e k)).ι, ?_⟩
  rw [Category.assoc, IsOpenImmersion.lift_fac]

theorem wc_et_cover_basic_refine : ∀ (Y : Scheme.{u}) [IsAffine Y], (∀ (V : Scheme.{u}) [IsAffine V] (g : V ⟶ Y) [Etale g], ∃ (n : ℕ) (e : Fin n → Γ(V, ⊤)), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, IsOpenImmersion ((V.basicOpen (e i)).ι ≫ g)) → ∀ (h : Γ(Y, ⊤)) (S : Sieve ((wcZarToEt Y).obj (Y.basicOpen h))), S ∈ Scheme.smallEtaleTopology Y ((wcZarToEt Y).obj (Y.basicOpen h)) → ∃ (k N : ℕ) (f a : Fin k → Γ(Y, ⊤)), h ^ N = ∑ j, a j * f j ∧ ∀ j, ∃ hle : Y.basicOpen (h * f j) ≤ Y.basicOpen h, S.arrows ((wcZarToEt Y).map (homOfLE hle)) :=
by
  intro Y _ H h S hS
  let T : Set Γ(Y, ⊤) := {f | ∃ hle : Y.basicOpen (h * f) ≤ Y.basicOpen h,
    S.arrows ((wcZarToEt Y).map (homOfLE hle))}

  have hSurj : ∀ x : ((wcZarToEt Y).obj (Y.basicOpen h)).left,
      ∃ (Y' : Y.Etale) (g : Y' ⟶ (wcZarToEt Y).obj (Y.basicOpen h)) (w : Y'.left),
        S.arrows g ∧ g.left w = x := by
    have hS' := hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y _ at hS'
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS'
    intro x
    obtain ⟨Y', g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ S).mp hS' x
    exact ⟨Y', g, w, hg, hw⟩

  have hNbhd : ∀ x : ((wcZarToEt Y).obj (Y.basicOpen h)).left,
      ∃ (V : Y.Etale) (φ : V ⟶ (wcZarToEt Y).obj (Y.basicOpen h)) (v : V.left),
        S.arrows φ ∧ IsAffine V.left ∧ φ.left v = x := by
    intro x
    obtain ⟨Y', g, w, hg, hw⟩ := hSurj x
    obtain ⟨a, ha⟩ := Y'.left.affineCover.covers w
    haveI : Etale Y'.hom := Y'.prop
    let V : Y.Etale := MorphismProperty.Over.mk ⊤
      (Y'.left.affineCover.f (Y'.left.affineCover.idx w) ≫ Y'.hom)
      (inferInstance : Etale (Y'.left.affineCover.f (Y'.left.affineCover.idx w) ≫ Y'.hom))
    let hh : V ⟶ Y' := MorphismProperty.Over.homMk
      (Y'.left.affineCover.f (Y'.left.affineCover.idx w)) rfl trivial
    refine ⟨V, hh ≫ g, a, S.downward_closed hg hh, ?_, ?_⟩
    · show IsAffine (Y'.left.affineCover.X (Y'.left.affineCover.idx w))
      infer_instance
    · change g.left (Y'.left.affineCover.f (Y'.left.affineCover.idx w) a) = x
      rw [ha, hw]

  have hA : ∀ y : Y, y ∈ Y.basicOpen h → ∃ f ∈ T, y ∈ Y.basicOpen f := by
    intro y hy
    obtain ⟨V, φ, v, hφS, hVa, hv⟩ := hNbhd ⟨y, hy⟩
    haveI := hVa
    haveI : Etale V.hom := V.prop
    obtain ⟨n, e, -, -, hsum, hopen⟩ := H V.left V.hom
    have hcov : ∃ l, v ∈ V.left.basicOpen (e l) := by
      by_contra hne
      push_neg at hne
      have hmem : ∀ l, (V.left.presheaf.germ ⊤ v trivial).hom (e l) ∈
          IsLocalRing.maximalIdeal (V.left.presheaf.stalk v) := by
        intro l
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen_top]
        exact hne l
      have h1 : (V.left.presheaf.germ ⊤ v trivial).hom (∑ l, e l) ∈
          IsLocalRing.maximalIdeal (V.left.presheaf.stalk v) := by
        rw [map_sum]
        exact Ideal.sum_mem _ (fun l _ => hmem l)
      rw [hsum, map_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    obtain ⟨l, hl⟩ := hcov
    haveI := hopen l
    have hyR : y ∈ ((V.left.basicOpen (e l)).ι ≫ V.hom).opensRange := by
      rw [Scheme.Hom.mem_opensRange]
      refine ⟨⟨v, hl⟩, ?_⟩
      have hw : ((wcZarToEt Y).obj (Y.basicOpen h)).hom (φ.left v) = V.hom v :=
        congrArg (fun g : V.left ⟶ Y => g v) (MorphismProperty.Over.w φ)
      change V.hom v = y
      exact hw.symm.trans ((congrArg (Y.basicOpen h).ι hv).trans
        (Scheme.Opens.ι_apply (Y.basicOpen h) ⟨y, hy⟩))
    obtain ⟨f, hfle, hyf⟩ := (isAffineOpen_top Y).exists_basicOpen_le
      (V := ((V.left.basicOpen (e l)).ι ≫ V.hom).opensRange ⊓ Y.basicOpen h)
      ⟨y, hyR, hy⟩ trivial
    have hle : Y.basicOpen (h * f) ≤ Y.basicOpen h := by
      rw [Scheme.basicOpen_mul]; exact inf_le_left
    have hB : Set.range (Y.basicOpen (h * f)).ι ⊆
        Set.range ((V.left.basicOpen (e l)).ι ≫ V.hom) := by
      rw [Scheme.Opens.range_ι, ← Scheme.Hom.coe_opensRange]
      intro z hz
      rw [Scheme.basicOpen_mul] at hz
      exact (hfle hz.2).1
    let ℓ := IsOpenImmersion.lift ((V.left.basicOpen (e l)).ι ≫ V.hom)
      (Y.basicOpen (h * f)).ι hB
    have hℓ : ℓ ≫ (V.left.basicOpen (e l)).ι ≫ V.hom = (Y.basicOpen (h * f)).ι :=
      IsOpenImmersion.lift_fac _ _ _
    let β : (wcZarToEt Y).obj (Y.basicOpen (h * f)) ⟶ V :=
      MorphismProperty.Over.homMk (ℓ ≫ (V.left.basicOpen (e l)).ι)
        ((Category.assoc _ _ _).trans hℓ) trivial
    have hβ : β ≫ φ = (wcZarToEt Y).map (homOfLE hle) := by
      apply MorphismProperty.Over.Hom.ext
      have hw : φ.left ≫ (Y.basicOpen h).ι = V.hom := MorphismProperty.Over.w φ
      have e1 : ((ℓ ≫ (V.left.basicOpen (e l)).ι) ≫ φ.left) ≫ (Y.basicOpen h).ι =
          (Y.basicOpen (h * f)).ι :=
        (Category.assoc _ _ _).trans ((congrArg (fun g => (ℓ ≫ (V.left.basicOpen (e l)).ι) ≫ g)
          hw).trans ((Category.assoc _ _ _).trans hℓ))
      have e2 : Y.homOfLE hle ≫ (Y.basicOpen h).ι = (Y.basicOpen (h * f)).ι :=
        Scheme.homOfLE_ι _ _
      exact (cancel_mono (Y.basicOpen h).ι).mp (e1.trans e2.symm)
    refine ⟨f, ⟨hle, ?_⟩, hyf⟩
    have h2 := S.downward_closed hφS β
    rw [hβ] at h2
    exact h2

  have hrad : h ∈ (Ideal.span T).radical := by
    rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
    rintro p ⟨hTp, hp⟩
    by_contra hhp
    let x : Spec Γ(Y, ⊤) := (⟨p, hp⟩ : PrimeSpectrum Γ(Y, ⊤))
    let y : Y := Y.isoSpec.inv x
    have hxy : Y.toSpecΓ y = x := by
      rw [← Scheme.isoSpec_hom]
      have h0 : (Y.isoSpec.inv ≫ Y.isoSpec.hom) x = x := by
        rw [Iso.inv_hom_id]; rfl
      rw [Scheme.Hom.comp_apply] at h0
      exact h0
    have hy : y ∈ Y.basicOpen h := by
      rw [← Scheme.toSpecΓ_preimage_basicOpen]
      show Y.toSpecΓ y ∈ PrimeSpectrum.basicOpen h
      rw [hxy]
      exact (PrimeSpectrum.mem_basicOpen h ⟨p, hp⟩).mpr hhp
    obtain ⟨f, hfT, hyf⟩ := hA y hy
    rw [← Scheme.toSpecΓ_preimage_basicOpen] at hyf
    have h3 : Y.toSpecΓ y ∈ PrimeSpectrum.basicOpen f := hyf
    rw [hxy] at h3
    exact (PrimeSpectrum.mem_basicOpen f ⟨p, hp⟩).mp h3 (hTp (Ideal.subset_span hfT))
  obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hrad
  obtain ⟨k, a, g, hg⟩ := Submodule.mem_span_set'.mp hN
  refine ⟨k, N, fun j => (g j : Γ(Y, ⊤)), a, ?_, fun j => (g j).2⟩
  rw [← hg]
  simp only [smul_eq_mul]

theorem wc_et_zariski_mv_ext : ∀ (Y : Scheme.{u}) (U U₀ U₁ : Y.Opens) (h₀ : U₀ ≤ U) (h₁ : U₁ ≤ U), U₀ ⊔ U₁ = U → ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (n : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; (∀ y : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj (U₀ ⊓ U₁)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F n, ∃ (y₀ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj U₀) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F n) (y₁ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj U₁) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F n), y = (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀)))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp y₀ (zero_add n) + (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁)))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp y₁ (zero_add n)) → ∀ ξ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F (n + 1), (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp ξ (zero_add (n + 1)) = 0 → (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp ξ (zero_add (n + 1)) = 0 → ξ = 0 :=
by
  intro Y U U₀ U₁ h₀ h₁ hU F n
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro H ξ hξ₀ hξ₁

  have chase : ∀ {A B₀ B₁ P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (a₀ : A ⟶ B₀) (a₁ : A ⟶ B₁)
      (b₀ : B₀ ⟶ P) (b₁ : B₁ ⟶ P)
      (hz : Limits.biprod.lift a₀ (-a₁) ≫ Limits.biprod.desc b₀ b₁ = 0),
      Mono (Limits.biprod.lift a₀ (-a₁)) → (ShortComplex.mk _ _ hz).Exact →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) (Limits.biprod.desc b₀ b₁) →
      (∀ y : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A) F n,
        ∃ (y₀ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B₀) F n)
          (y₁ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B₁) F n),
          y = (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map a₀)).comp
              y₀ (zero_add n) +
            (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map a₁)).comp
              y₁ (zero_add n)) →
      ∀ ξ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P) F (n + 1),
      (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map b₀)).comp ξ
          (zero_add (n + 1)) = 0 →
      (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map b₁)).comp ξ
          (zero_add (n + 1)) = 0 → ξ = 0 := by
    intro A B₀ B₁ P a₀ a₁ b₀ b₁ hz hmono hex hls H ξ hξ₀ hξ₁
    have hS : ((ShortComplex.mk _ _ hz).map
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).ShortExact := by
      haveI : Sheaf.IsLocallySurjective
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
            (Limits.biprod.desc b₀ b₁)) :=
        (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hls
      haveI := hmono
      exact ShortComplex.ShortExact.mk' (hex.map _)
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_mono _)
        (Sheaf.epi_of_isLocallySurjective
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
            (Limits.biprod.desc b₀ b₁)))
    have h0 : (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (Limits.biprod.desc b₀ b₁))).comp ξ (zero_add (n + 1)) = 0 := by
      rw [Limits.biprod.desc_eq, Functor.map_add, Functor.map_comp, Functor.map_comp,
        Abelian.Ext.mk₀_add, Abelian.Ext.add_comp,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega),
        hξ₀, hξ₁, Abelian.Ext.comp_zero, Abelian.Ext.comp_zero, add_zero]
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS F ξ h0
      (show 1 + n = n + 1 by omega)
    obtain ⟨y₀, y₁, hy⟩ := H x₁
    have e0 : (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.biprod.lift a₀ (-a₁)))).comp
        ((Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀))).comp y₀ (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map a₀)).comp
          y₀ (zero_add n) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, ← Functor.map_comp, Limits.biprod.lift_fst]
    have e1 : (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.biprod.lift a₀ (-a₁)))).comp
        ((Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (-(Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁)))).comp y₁ (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map a₁)).comp
          y₁ (zero_add n) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, ← Functor.map_comp, Preadditive.comp_neg, Limits.biprod.lift_snd,
        neg_neg]
    have hw : x₁ = (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.biprod.lift a₀ (-a₁)))).comp
        ((Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀))).comp y₀ (zero_add n) +
        (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (-(Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁)))).comp y₁ (zero_add n)) (zero_add n) := by
      rw [Abelian.Ext.comp_add, e0, e1, hy]
    have hc : hS.extClass.comp
        (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.biprod.lift a₀ (-a₁)))) (add_zero 1) = 0 := hS.extClass_comp
    rw [← hx₁, hw, ← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add n) (by omega), hc,
      Abelian.Ext.zero_comp]

  have hT1 : ∀ (W : Y.Opens) (V : Y.Etale), Subsingleton (V ⟶ (wcZarToEt Y).obj W) ∧
      (Nonempty (V ⟶ (wcZarToEt Y).obj W) ↔ Set.range V.hom ⊆ (W : Set Y)) := by
    intro W V
    have hw : ∀ φ : V ⟶ (wcZarToEt Y).obj W, φ.left ≫ W.ι = V.hom :=
      fun φ => MorphismProperty.Over.w φ
    refine ⟨⟨fun φ ψ => ?_⟩, ⟨fun ⟨φ⟩ => ?_, fun h => ?_⟩⟩
    · apply MorphismProperty.Over.Hom.ext
      exact (cancel_mono W.ι).mp ((hw φ).trans (hw ψ).symm)
    · have h1 : Set.range V.hom ⊆ Set.range W.ι := by
        rintro _ ⟨x, rfl⟩
        exact ⟨φ.left x, by rw [← hw φ]; rfl⟩
      rwa [Scheme.Opens.range_ι] at h1
    · have hr : Set.range V.hom ⊆ Set.range W.ι := by
        rw [Scheme.Opens.range_ι]; exact h
      let ℓ : V.left ⟶ (W : Scheme.{u}) := IsOpenImmersion.lift W.ι V.hom hr
      have hℓ : ℓ ≫ W.ι = V.hom := IsOpenImmersion.lift_fac _ _ _
      exact ⟨MorphismProperty.Over.homMk ℓ hℓ trivial⟩

  have hK : ∀ {α : Type (u+1)}, (∀ a b : α, a = b) → ∀ (a : α) (z : FreeAbelianGroup α),
      z = (FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) z).down •
        FreeAbelianGroup.of a := by
    intro α hα a z
    induction z using FreeAbelianGroup.induction_on with
    | zero => simp
    | of x => rw [hα x a]; simp
    | neg x ih => rw [hα x a]; simp
    | add x y hx hy =>
      rw [map_add, ULift.add_down, add_zsmul, ← hx, ← hy]
  have hE : ∀ {α : Type (u+1)}, ¬ Nonempty α → ∀ z : FreeAbelianGroup α, z = 0 := by
    intro α hα z
    induction z using FreeAbelianGroup.induction_on with
    | zero => rfl
    | of x => exact absurd ⟨x⟩ hα
    | neg x ih => exact absurd ⟨x⟩ hα
    | add x y hx hy => rw [hx, hy, add_zero]
  have hZ : ∀ {α : Type (u+1)}, (∀ a b : α, a = b) → ∀ z : FreeAbelianGroup α,
      FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) z = 0 → z = 0 := by
    intro α hα z hz
    by_cases hn : Nonempty α
    · obtain ⟨a⟩ := hn
      rw [hK hα a z, hz]; simp
    · exact hE hn z
  have hM : ∀ {α β : Type (u+1)} (i : α → β) (z : FreeAbelianGroup α),
      FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) (FreeAbelianGroup.map i z) =
        FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) z := by
    intro α β i z
    induction z using FreeAbelianGroup.induction_on with
    | zero => simp
    | of x => simp
    | neg x ih => simp
    | add x y hx hy => simp only [map_add, hx, hy]

  have hI : ∀ (W W' : Y.Opens) (hle : W ≤ W'),
      ∃ i : ∀ V : (Y.Etale)ᵒᵖ, ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj W) →
          ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj W'),
        ∀ (V : (Y.Etale)ᵒᵖ) (z : FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj W))),
          ((Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE hle)))
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app V).hom z = FreeAbelianGroup.map (i V) z :=
    fun W W' hle => ⟨fun V e => ULift.up (e.down ≫ (wcZarToEt Y).map (homOfLE hle)), fun V z => rfl⟩
  obtain ⟨i₀, hi₀⟩ := hI _ _ (inf_le_left : U₀ ⊓ U₁ ≤ U₀)
  obtain ⟨i₁, hi₁⟩ := hI _ _ (inf_le_right : U₀ ⊓ U₁ ≤ U₁)
  obtain ⟨j₀, hj₀⟩ := hI _ _ h₀
  obtain ⟨j₁, hj₁⟩ := hI _ _ h₁
  have hsub : ∀ (W : Y.Opens) (V : (Y.Etale)ᵒᵖ) (a b : ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj W)),
      a = b := fun W V a b => ULift.ext _ _ ((hT1 W V.unop).1.elim _ _)
  have hne : ∀ V : (Y.Etale)ᵒᵖ, Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U₀)) →
      Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U₁)) →
      Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj (U₀ ⊓ U₁))) := by
    rintro V ⟨e₀⟩ ⟨e₁⟩
    have h0 := (hT1 U₀ V.unop).2.mp ⟨e₀.down⟩
    have h1 := (hT1 U₁ V.unop).2.mp ⟨e₁.down⟩
    have h01 : Set.range V.unop.hom ⊆ ((U₀ ⊓ U₁ : Y.Opens) : Set Y) := by
      rw [TopologicalSpace.Opens.coe_inf]; exact Set.subset_inter h0 h1
    obtain ⟨e⟩ := (hT1 (U₀ ⊓ U₁) V.unop).2.mpr h01
    exact ⟨ULift.up e⟩
  have hinj : ∀ V : (Y.Etale)ᵒᵖ, Function.Injective (FreeAbelianGroup.map (i₀ V)) := by
    intro V z z' hzz
    by_cases h : Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj (U₀ ⊓ U₁)))
    · obtain ⟨a⟩ := h
      rw [hK (hsub _ V) a z, hK (hsub _ V) a z', ← hM (i₀ V) z, ← hM (i₀ V) z', hzz]
    · rw [hE h z, hE h z']

  have hsq : ∀ (V : (Y.Etale)ᵒᵖ)
      (z : FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj (U₀ ⊓ U₁)))),
      FreeAbelianGroup.map (j₀ V) (FreeAbelianGroup.map (i₀ V) z) =
        FreeAbelianGroup.map (j₁ V) (FreeAbelianGroup.map (i₁ V) z) := by
    intro V z
    induction z using FreeAbelianGroup.induction_on with
    | zero => simp
    | of x =>
      simp only [FreeAbelianGroup.map_of_apply]
      rw [hsub U V (j₀ V (i₀ V x)) (j₁ V (i₁ V x))]
    | neg x ih =>
      simp only [map_neg, FreeAbelianGroup.map_of_apply]
      rw [hsub U V (j₀ V (i₀ V x)) (j₁ V (i₁ V x))]
    | add x y hx hy => simp only [map_add, hx, hy]
  have hcomp : Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀))))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
      Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
      Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁))))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
      Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
    apply NatTrans.ext; funext V; apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro z
    exact (congrArg ((Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app V).hom (hi₀ V z)).trans
      ((hj₀ V _).trans ((hsq V z).trans ((hj₁ V _).symm.trans
        (congrArg ((Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app V).hom (hi₁ V z)).symm)))
  have hz : Limits.biprod.lift
        (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀))))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        (-(Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁))))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
      Limits.biprod.desc
        (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) = 0 := by
    rw [Limits.biprod.lift_desc, Preadditive.neg_comp, hcomp, add_neg_cancel]

  have hmono0 : Mono (Functor.whiskerRight
      (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀))))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    have : ∀ V, Mono ((Functor.whiskerRight
        (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀))))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app V) := fun V =>
      (AddCommGrpCat.mono_iff_injective _).mpr (by
        intro z z' h
        exact hinj V ((hi₀ V z).symm.trans (h.trans (hi₀ V z'))))
    exact NatTrans.mono_of_mono_app _
  have hmono := mono_of_mono_fac (Limits.biprod.lift_fst
    (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_left : U₀ ⊓ U₁ ≤ U₀))))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    (-(Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁))))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))))

  have S4 : ∀ {A B₀ B₁ P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (a₀ : A ⟶ B₀) (a₁ : A ⟶ B₁)
      (b₀ : B₀ ⟶ P) (b₁ : B₁ ⟶ P) (h : Limits.biprod.lift a₀ a₁ ≫ Limits.biprod.desc b₀ b₁ = 0),
      (∀ (X : (Y.Etale)ᵒᵖ) (x₀ : B₀.obj X) (x₁ : B₁.obj X),
        (b₀.app X).hom x₀ + (b₁.app X).hom x₁ = 0 →
        ∃ y : A.obj X, (a₀.app X).hom y = x₀ ∧ (a₁.app X).hom y = x₁) →
      (ShortComplex.mk (Limits.biprod.lift a₀ a₁) (Limits.biprod.desc b₀ b₁) h).Exact := by
    intro A B₀ B₁ P a₀ a₁ b₀ b₁ h H
    rw [ShortComplex.exact_iff_isZero_homology]
    apply Functor.isZero
    intro X
    have hX : ((ShortComplex.mk (Limits.biprod.lift a₀ a₁) (Limits.biprod.desc b₀ b₁) h).map
        ((evaluation _ _).obj X)).Exact := by
      rw [ShortComplex.ab_exact_iff]
      intro x hx
      have htot : ∀ z : (B₀ ⊞ B₁).obj X,
          z = (NatTrans.app (Limits.biprod.inl : B₀ ⟶ B₀ ⊞ B₁) X).hom
              ((NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom z) +
            (NatTrans.app (Limits.biprod.inr : B₁ ⟶ B₀ ⊞ B₁) X).hom
              ((NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom z) := by
        intro z
        have := congrArg (fun φ : B₀ ⊞ B₁ ⟶ B₀ ⊞ B₁ => (φ.app X).hom z)
          (Limits.biprod.total (X := B₀) (Y := B₁))
        simp only [NatTrans.app_add, NatTrans.comp_app, NatTrans.id_app, AddCommGrpCat.hom_add,
          AddCommGrpCat.hom_comp, AddCommGrpCat.hom_id, AddMonoidHom.add_apply,
          AddMonoidHom.comp_apply, AddMonoidHom.id_apply] at this
        exact this.symm
      have e1 : ((Limits.biprod.desc b₀ b₁).app X).hom x =
          (b₀.app X).hom ((NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom x) +
          (b₁.app X).hom ((NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom x) := by
        conv_lhs => rw [htot x]
        rw [map_add]
        congr 1
        · change ((Limits.biprod.inl ≫ Limits.biprod.desc b₀ b₁).app X).hom _ = _
          rw [Limits.biprod.inl_desc]
        · change ((Limits.biprod.inr ≫ Limits.biprod.desc b₀ b₁).app X).hom _ = _
          rw [Limits.biprod.inr_desc]
      obtain ⟨y, hy0, hy1⟩ := H X _ _ (e1.symm.trans hx)
      refine ⟨y, ?_⟩
      change ((Limits.biprod.lift a₀ a₁).app X).hom y = x
      have f1 : (NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom
            (((Limits.biprod.lift a₀ a₁).app X).hom y) =
          (NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom x := by
        change ((Limits.biprod.lift a₀ a₁ ≫ Limits.biprod.fst).app X).hom y = _
        rw [Limits.biprod.lift_fst]; exact hy0
      have f2 : (NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom
            (((Limits.biprod.lift a₀ a₁).app X).hom y) =
          (NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom x := by
        change ((Limits.biprod.lift a₀ a₁ ≫ Limits.biprod.snd).app X).hom y = _
        rw [Limits.biprod.lift_snd]; exact hy1
      rw [htot (((Limits.biprod.lift a₀ a₁).app X).hom y), f1, f2, ← htot x]
    exact ((ShortComplex.exact_iff_isZero_homology _).mp hX).of_iso
      (ShortComplex.mapHomologyIso _ ((evaluation _ _).obj X)).symm
  have key : ∀ (X : (Y.Etale)ᵒᵖ) (x₀ : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₀)))
      (x₁ : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₁))),
      FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₀ +
        FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₁ = 0 →
      ∃ y : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj (U₀ ⊓ U₁))),
        FreeAbelianGroup.map (i₀ X) y = x₀ ∧ -(FreeAbelianGroup.map (i₁ X) y) = x₁ := by
    intro X x₀ x₁ hx'
    by_cases h0 : Nonempty (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₀))
    · by_cases h1 : Nonempty (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₁))
      · obtain ⟨a⟩ := hne X h0 h1
        have hd : (FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₁).down =
            -(FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₀).down := by
          have := congrArg ULift.down hx'
          simp only [ULift.add_down, ULift.zero_down] at this
          omega
        refine ⟨(FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₀).down •
          FreeAbelianGroup.of a, ?_, ?_⟩
        · rw [map_zsmul, FreeAbelianGroup.map_of_apply]
          exact (hK (hsub U₀ X) (i₀ X a) x₀).symm
        · rw [map_zsmul, FreeAbelianGroup.map_of_apply, ← neg_zsmul, ← hd]
          exact (hK (hsub U₁ X) (i₁ X a) x₁).symm
      · have hx1 : x₁ = 0 := hE h1 x₁
        have hx0 : x₀ = 0 := by
          apply hZ (hsub U₀ X)
          rw [hx1, map_zero, add_zero] at hx'
          exact hx'
        refine ⟨0, ?_, ?_⟩
        · rw [map_zero]; exact hx0.symm
        · rw [map_zero, neg_zero]; exact hx1.symm
    · have hx0 : x₀ = 0 := hE h0 x₀
      have hx1 : x₁ = 0 := by
        apply hZ (hsub U₁ X)
        rw [hx0, map_zero, zero_add] at hx'
        exact hx'
      refine ⟨0, ?_, ?_⟩
      · rw [map_zero]; exact hx0.symm
      · rw [map_zero, neg_zero]; exact hx1.symm
  have hex : (ShortComplex.mk _ _ hz).Exact := by
    apply S4
    intro X x₀ x₁ hx
    have hneg : ∀ y, ((-(Functor.whiskerRight
        (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁))))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).app X).hom y =
        -(((Functor.whiskerRight
          (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_right : U₀ ⊓ U₁ ≤ U₁))))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app X).hom y) := by
      intro y; rw [NatTrans.app_neg, AddCommGrpCat.hom_neg]; rfl
    have hx2 : FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₀ +
        FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₁ = 0 := by
      have hx' : FreeAbelianGroup.map (j₀ X) x₀ + FreeAbelianGroup.map (j₁ X) x₁ = 0 :=
        (congrArg₂ (· + ·) (hj₀ X x₀) (hj₁ X x₁)).symm.trans hx
      have h3 := congrArg (FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ))) hx'
      exact (congrArg₂ (· + ·) (hM (j₀ X) x₀) (hM (j₁ X) x₁)).symm.trans
        ((map_add _ _ _).symm.trans (h3.trans (map_zero _)))
    obtain ⟨y, hy0, hy1⟩ := key X x₀ x₁ hx2
    exact ⟨y, (hi₀ X y).trans hy0, (hneg y).trans ((congrArg Neg.neg (hi₁ X y)).trans hy1)⟩

  have hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      (Limits.biprod.desc
        (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := by
    constructor
    intro V s
    by_cases hV : Nonempty (V ⟶ (wcZarToEt Y).obj U)
    swap
    · have hV' : ¬ Nonempty (ULift.{u+1} (V ⟶ (wcZarToEt Y).obj U)) := fun ⟨e⟩ => hV ⟨e.down⟩
      have hs0 : s = 0 := hE hV' s
      apply GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ V)
      intro V' c _
      refine ⟨0, ?_⟩
      rw [hs0, map_zero, map_zero]
    obtain ⟨φU⟩ := hV
    have hrU := (hT1 U V).2.mp ⟨φU⟩
    change _ ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    have hxtop : V.hom x ∈ U₀ ⊔ U₁ := by rw [hU]; exact hrU ⟨x, rfl⟩
    have harr : ∀ (W : Y.Opens) (hW : V.hom x ∈ W),
        (∀ (V₁ : Y.Etale) (φ : V₁ ⟶ (wcZarToEt Y).obj W) (c : V₁ ⟶ V),
          (Presheaf.imageSieve (Limits.biprod.desc
            (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
            (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) s).arrows c) →
        ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (y : V₁.left),
          (Presheaf.imageSieve (Limits.biprod.desc
            (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
            (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) s).arrows c ∧
            Etale c.left ∧ c.left y = x := by
      intro W hW Hc
      let O : V.left.Opens := V.hom ⁻¹ᵁ W
      let V₁ : Y.Etale := Scheme.Etale.mk (O.ι ≫ V.hom)
      let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
      have hr : Set.range V₁.hom ⊆ (W : Set Y) := by
        rintro _ ⟨y, rfl⟩
        show V.hom (O.ι y) ∈ W
        have hy : O.ι y ∈ (O : Set V.left) := by
          have : O.ι y ∈ Set.range O.ι := ⟨y, rfl⟩
          rwa [Scheme.Opens.range_ι] at this
        exact hy
      obtain ⟨φ⟩ := (hT1 W V₁).2.mpr hr
      refine ⟨V₁, c, ⟨x, hW⟩, Hc V₁ φ c, ?_, ?_⟩
      · change Etale O.ι
        infer_instance
      · change O.ι ⟨x, hW⟩ = x
        rw [Scheme.Opens.ι_apply]
    rcases TopologicalSpace.Opens.mem_sup.mp hxtop with hx0 | hx1
    · refine harr U₀ hx0 (fun V₁ φ c => ?_)
      refine ⟨(NatTrans.app (Limits.biprod.inl :
        (yoneda.obj ((wcZarToEt Y).obj U₀) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ _)
          (Opposite.op V₁)).hom
          ((FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ))
            (((yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map
              c.op).hom s)).down • FreeAbelianGroup.of (ULift.up φ) :
            FreeAbelianGroup (ULift.{u+1} (V₁ ⟶ (wcZarToEt Y).obj U₀))), ?_⟩
      change ((Limits.biprod.inl ≫ Limits.biprod.desc
          (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
          (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).app (Opposite.op V₁)).hom
          ((FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ))
            (((yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map
              c.op).hom s)).down • FreeAbelianGroup.of (ULift.up φ) :
            FreeAbelianGroup (ULift.{u+1} (V₁ ⟶ (wcZarToEt Y).obj U₀))) =
        ((yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map
          c.op).hom s
      rw [Limits.biprod.inl_desc, hj₀, map_zsmul, FreeAbelianGroup.map_of_apply]
      exact (hK (hsub U (Opposite.op V₁)) (j₀ (Opposite.op V₁) (ULift.up φ)) _).symm
    · refine harr U₁ hx1 (fun V₁ φ c => ?_)
      refine ⟨(NatTrans.app (Limits.biprod.inr :
        (yoneda.obj ((wcZarToEt Y).obj U₁) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ _)
          (Opposite.op V₁)).hom
          ((FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ))
            (((yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map
              c.op).hom s)).down • FreeAbelianGroup.of (ULift.up φ) :
            FreeAbelianGroup (ULift.{u+1} (V₁ ⟶ (wcZarToEt Y).obj U₁))), ?_⟩
      change ((Limits.biprod.inr ≫ Limits.biprod.desc
          (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₀)))
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
          (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE h₁)))
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).app (Opposite.op V₁)).hom
          ((FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ))
            (((yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map
              c.op).hom s)).down • FreeAbelianGroup.of (ULift.up φ) :
            FreeAbelianGroup (ULift.{u+1} (V₁ ⟶ (wcZarToEt Y).obj U₁))) =
        ((yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map
          c.op).hom s
      rw [Limits.biprod.inr_desc, hj₁, map_zsmul, FreeAbelianGroup.map_of_apply]
      exact (hK (hsub U (Opposite.op V₁)) (j₁ (Opposite.op V₁) (ULift.up φ)) _).symm
  exact chase _ _ _ _ hz hmono hex hls H ξ hξ₀ hξ₁

theorem wc_et_locallyConstant_glue : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V → ∀ (m : ℕ) (x : ∀ (V' : Y.Etale) (g : V' ⟶ V), S.arrows g → LocallyConstant V'.left (ZMod m)), (∀ (V' V'' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (h : V'' ⟶ V') (w : V''.left), x V'' (h ≫ g) (S.downward_closed hg h) w = x V' g hg (h.left w)) → ∃! f : LocallyConstant V.left (ZMod m), ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left), f (g.left v) = x V' g hg v :=
by
  intro Y V S hS m x hx

  have hEt : ∀ (A B : Y.Etale) (g : A ⟶ B), Etale g.left := by
    intro A B g
    haveI : Etale B.hom := B.prop
    have hw : g.left ≫ B.hom = A.hom := MorphismProperty.Over.w g
    haveI : Etale (g.left ≫ B.hom) := by
      rw [hw]
      exact A.prop
    exact Etale.of_comp g.left B.hom
  have hOpen : ∀ (A B : Y.Etale) (g : A ⟶ B), IsOpenMap g.left := by
    intro A B g
    haveI := hEt A B g
    exact g.left.isOpenMap

  have hsurj : ∀ v : V.left, ∃ (V' : Y.Etale) (g : V' ⟶ V) (v' : V'.left),
      S.arrows g ∧ g.left v' = v := by
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    intro v
    obtain ⟨V', g, v', hg, -, hv⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mp hS v
    exact ⟨V', g, v', hg, hv⟩

  have hcongr : ∀ (Q : Y.Etale) (k k' : Q ⟶ V) (_ : k = k') (hk : S.arrows k)
      (hk' : S.arrows k') (w : Q.left), x Q k hk w = x Q k' hk' w := by
    intro Q k k' e hk hk' w
    subst e
    rfl

  have hagree : ∀ (V₁ V₂ : Y.Etale) (g₁ : V₁ ⟶ V) (g₂ : V₂ ⟶ V) (hg₁ : S.arrows g₁)
      (hg₂ : S.arrows g₂) (v₁ : V₁.left) (v₂ : V₂.left), g₁.left v₁ = g₂.left v₂ →
      x V₁ g₁ hg₁ v₁ = x V₂ g₂ hg₂ v₂ := by
    intro V₁ V₂ g₁ g₂ hg₁ hg₂ v₁ v₂ hv
    haveI : Etale g₂.left := hEt V₂ V g₂
    haveI : Etale V₁.hom := V₁.prop
    let Q : Y.Etale := MorphismProperty.Over.mk ⊤
      (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom)
      (inferInstance : Etale (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom))
    let h₁ : Q ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
    have hc : Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom = Q.hom := by
      change Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom =
        Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom
      rw [← MorphismProperty.Over.w g₂, ← MorphismProperty.Over.w g₁, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let h₂ : Q ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left) hc trivial
    obtain ⟨c₁, hc₁⟩ : ∃ c : Q ⟶ V, c = h₁ ≫ g₁ := ⟨_, rfl⟩
    obtain ⟨c₂, hc₂⟩ : ∃ c : Q ⟶ V, c = h₂ ≫ g₂ := ⟨_, rfl⟩
    have hc12 : c₁ = c₂ := by
      apply MorphismProperty.Over.Hom.ext
      rw [hc₁, hc₂]
      change Limits.pullback.fst g₁.left g₂.left ≫ g₁.left =
        Limits.pullback.snd g₁.left g₂.left ≫ g₂.left
      exact Limits.pullback.condition
    obtain ⟨w, hw₁, hw₂⟩ := Scheme.Pullback.exists_preimage_pullback v₁ v₂ hv
    have k1 : h₁.left w = v₁ := hw₁
    have k2 : h₂.left w = v₂ := hw₂
    have e1 := hx V₁ Q g₁ hg₁ h₁ w
    have e2 := hx V₂ Q g₂ hg₂ h₂ w
    rw [← k1, ← k2, ← e1, ← e2]
    exact hcongr Q _ _ (hc₁.symm.trans (hc12.trans hc₂)) _ _ w

  choose V₀ g₀ z₀ hg₀ hz₀ using hsurj
  let F : V.left → ZMod m := fun v => x (V₀ v) (g₀ v) (hg₀ v) (z₀ v)
  have hF : ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left),
      F (g.left v) = x V' g hg v := by
    intro V' g hg v
    exact hagree _ _ _ _ _ _ _ _ (hz₀ (g.left v))
  have hFlc : IsLocallyConstant F := by
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro a
    have hfib : F ⁻¹' {a} = ⋃ (i : Σ V' : Y.Etale, {g : V' ⟶ V // S.arrows g}),
        i.2.1.left '' {z | x i.1 i.2.1 i.2.2 z = a} := by
      ext v
      constructor
      · intro hv
        exact Set.mem_iUnion.2 ⟨⟨V₀ v, g₀ v, hg₀ v⟩, z₀ v, hv, hz₀ v⟩
      · intro hv
        obtain ⟨⟨V', g, hg⟩, z, hz, hzv⟩ := Set.mem_iUnion.1 hv
        subst hzv
        exact (hF V' g hg z).trans hz
    rw [hfib]
    apply isOpen_iUnion
    intro i
    exact hOpen _ _ i.2.1 _ (IsLocallyConstant.isOpen_fiber (x i.1 i.2.1 i.2.2).isLocallyConstant a)
  refine ⟨⟨F, hFlc⟩, fun V' g hg v => hF V' g hg v, ?_⟩
  intro f' hf'
  ext v
  change f' v = F v
  exact (congrArg f' (hz₀ v)).symm.trans (hf' _ _ _ _)

theorem wc_et_const_zmod_sections_locallyConstant : ∀ (Y : Scheme.{u}) (m : ℕ), (∀ (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V → ∀ (x : ∀ (V' : Y.Etale) (g : V' ⟶ V), S.arrows g → LocallyConstant V'.left (ZMod m)), (∀ (V' V'' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (h : V'' ⟶ V') (w : V''.left), x V'' (h ≫ g) (S.downward_closed hg h) w = x V' g hg (h.left w)) → ∃! f : LocallyConstant V.left (ZMod m), ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left), f (g.left v) = x V' g hg v) → ∃ e : ∀ V : Y.Etale, ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op V) ≃+ LocallyConstant V.left (ZMod m), ∀ (V V' : Y.Etale) (g : V' ⟶ V) (s : ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj (Opposite.op V)) (x : V'.left), e V' ((((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map g.op).hom s) x = e V s (g.left x) :=
by
  intro Y m H

  have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
      S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  let L := wcEtLC Y (ULift.{u+1} (ZMod m))
  let eL : ∀ V : Y.Etale, (L.obj (Opposite.op V)) ≃+ LocallyConstant V.left (ZMod m) := fun V =>
    { toFun := fun f => (show LocallyConstant V.left (ULift.{u+1} (ZMod m)) from f).map ULift.down
      invFun := fun g => (show L.obj (Opposite.op V) from g.map ULift.up)
      left_inv := fun f => rfl
      right_inv := fun g => rfl
      map_add' := fun f g => rfl }

  have hL : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) L := by
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Y) L
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    intro V S hS x hx
    have hx' := hx.to_sieveCompatible
    obtain ⟨f, hf, huniq⟩ := H V S hS (fun V' g hg => eL V' (x g hg)) (by
      intro V' V'' g hg h w
      exact (congrArg (fun t => (eL V'' t) w) (hx' g h hg)).trans rfl)
    refine ⟨(eL V).symm f, ?_, ?_⟩
    · intro V' g hg
      apply (eL V').injective
      ext v
      exact hf V' g hg v
    · intro t ht
      have : eL V t = f := by
        apply huniq
        intro V' g hg v
        rw [← ht g hg]
        rfl
      exact (eL V).eq_symm_apply.mpr this

  let P := (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
  let α : P ⟶ L :=
    { app := fun V => AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom :
        ULift.{u+1} (ZMod m) →+ LocallyConstant V.unop.left (ULift.{u+1} (ZMod m)))
      naturality := fun _ _ _ => rfl }
  have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α := by
    constructor
    intro X a b hab
    apply hcov
    intro v
    have hab' : a = b :=
      congrArg (fun f : LocallyConstant X.unop.left (ULift.{u+1} (ZMod m)) => f v) hab
    refine ⟨X.unop, 𝟙 _, ?_, ⟨v, rfl⟩⟩
    rw [Presheaf.equalizerSieve_apply, hab']
  have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α := by
    constructor
    intro V s
    apply hcov
    intro v
    let f : LocallyConstant V.left (ULift.{u+1} (ZMod m)) := s
    let O : V.left.Opens := ⟨{x | f x = f v}, f.isLocallyConstant.isOpen_fiber (f v)⟩
    let V₁ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) (by infer_instance)
    let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    have hv : v ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      exact (rfl : f v = f v)
    refine ⟨V₁, c, ?_, hv⟩
    rw [Presheaf.imageSieve_apply]
    refine ⟨f v, ?_⟩
    apply LocallyConstant.ext
    intro x
    have hx : O.ι x ∈ (O : Set V.left) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨x, rfl⟩
    exact (show f (O.ι x) = f v from hx).symm

  let φ := sheafifyLift (Scheme.smallEtaleTopology Y) α hL
  have hfac : toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ = α :=
    toSheafify_sheafifyLift _ α hL
  have := hinj
  have := hsurj
  have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) P) :=
    Presheaf.isLocallySurjective_toSheafify' _ P
  have h1 : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) φ :=
    Presheaf.isLocallySurjective_of_isLocallySurjective_fac _ hfac
  have h2 : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) φ :=
    Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac _ α hfac
  let Φ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶
      (⟨L, hL⟩ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    ObjectProperty.homMk φ
  have hΦ : IsIso Φ := (Sheaf.isLocallyBijective_iff_isIso Φ).mp ⟨h2, h1⟩
  have hφ : IsIso φ := by
    have : IsIso ((sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map Φ) :=
      Functor.map_isIso _ Φ
    exact this
  have hV : ∀ V, IsIso (φ.app V) := fun V => NatIso.isIso_app_of_isIso φ V
  refine ⟨fun V => (asIso (φ.app (Opposite.op V))).addCommGroupIsoToAddEquiv.trans (eL V), ?_⟩
  intro V V' g s x
  have key := NatTrans.naturality_apply φ g.op s
  exact (congrArg (fun t => (eL V' t) x) key).trans rfl

theorem wc_scheme_glue_opens : ∀ (Y : Scheme.{u}) (J : Type u) (O : J → Y.Opens) (W : J → J → Y.Opens), (∀ j, W j j = O j) → (∀ j k, W j k ≤ O j) → (∀ j k, W j k = W k j) → (∀ i j k, W i j ⊓ W i k ≤ W j k) → ∃ (P : Scheme.{u}) (π : P ⟶ Y) (ι : ∀ j, (O j : Scheme.{u}) ⟶ P), (∀ j, IsOpenImmersion (ι j)) ∧ (∀ j, ι j ≫ π = (O j).ι) ∧ (∀ z : P, ∃ (j : J) (x : (O j : Scheme.{u})), ι j x = z) ∧ ∀ (j k : J) (x : (O j : Scheme.{u})) (y : (O k : Scheme.{u})), ι j x = ι k y ↔ ((O j).ι x = (O k).ι y ∧ (O j).ι x ∈ W j k) :=
by
  intro Y J O W h1 h2 h3 h4
  have hmem : ∀ (U : Y.Opens) (z : (U : Scheme.{u})), U.ι z ∈ U := by
    intro U z
    have : U.ι z ∈ Set.range U.ι := ⟨z, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  have hρ : ∀ i j k, Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι
      = Limits.pullback.snd (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i k).ι := by
    intro i j k
    rw [← Y.homOfLE_ι (h2 i j), ← Y.homOfLE_ι (h2 i k), ← Category.assoc,
      Limits.pullback.condition, Category.assoc]
  have hrange : ∀ i j k, Set.range (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k))
      ≫ (W i j).ι) ⊆ Set.range (W j k).ι := by
    intro i j k
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    have e1 : (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι) z ∈ W i j := by
      rw [Scheme.Hom.comp_apply]; exact hmem _ _
    have e2 : (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι) z ∈ W i k := by
      rw [hρ, Scheme.Hom.comp_apply]; exact hmem _ _
    exact h4 i j k ⟨e1, e2⟩
  have hw : ∀ i j k, IsOpenImmersion.lift (W j k).ι _ (hrange i j k) ≫ Y.homOfLE (h2 j k)
      = (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ Y.homOfLE (h3 i j).le)
        ≫ Y.homOfLE (h2 j i) := by
    intro i j k
    apply (cancel_mono (O j).ι).1
    simp only [Category.assoc, Scheme.homOfLE_ι, IsOpenImmersion.lift_fac]
  obtain ⟨t', tfac, tρ⟩ : ∃ t' : ∀ i j k, Limits.pullback (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k))
      ⟶ Limits.pullback (Y.homOfLE (h2 j k)) (Y.homOfLE (h2 j i)),
      (∀ i j k, t' i j k ≫ Limits.pullback.snd (Y.homOfLE (h2 j k)) (Y.homOfLE (h2 j i))
        = Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ Y.homOfLE (h3 i j).le) ∧
      (∀ i j k, t' i j k ≫ Limits.pullback.fst (Y.homOfLE (h2 j k)) (Y.homOfLE (h2 j i)) ≫ (W j k).ι
        = Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k)) ≫ (W i j).ι) :=
    ⟨fun i j k => Limits.pullback.lift _ _ (hw i j k),
      fun i j k => Limits.pullback.lift_snd _ _ _,
      fun i j k => by rw [← Category.assoc, Limits.pullback.lift_fst, IsOpenImmersion.lift_fac]⟩
  have coc : ∀ i j k, t' i j k ≫ t' j k i ≫ t' k i j = 𝟙 _ := by
    intro i j k
    apply (cancel_mono (Limits.pullback.fst (Y.homOfLE (h2 i j)) (Y.homOfLE (h2 i k))
      ≫ (W i j).ι)).1
    rw [Category.assoc, Category.assoc, tρ k i j, tρ j k i, tρ i j k, Category.id_comp]
  have fid : ∀ i, IsIso (Y.homOfLE (h2 i i)) := by
    intro i
    rw [← Scheme.isoOfEq_hom Y (h1 i)]
    infer_instance
  have tid : ∀ i, Y.homOfLE (h3 i i).le = 𝟙 _ := fun i => Scheme.homOfLE_rfl Y (W i i)
  let D : Scheme.GlueData.{u} := Scheme.GlueData.mk
    { J := J, U := fun j => (O j : Scheme.{u}), V := fun p => (W p.1 p.2 : Scheme.{u}),
      f := fun i j => Y.homOfLE (h2 i j), f_id := fid,
      t := fun i j => Y.homOfLE (h3 i j).le, t_id := tid, t' := t', t_fac := tfac, cocycle := coc }
    (fun i j => (inferInstance : IsOpenImmersion (Y.homOfLE (h2 i j))))
  have hcompat : ∀ i j, Y.homOfLE (h2 i j) ≫ (O i).ι
      = Y.homOfLE (h3 i j).le ≫ Y.homOfLE (h2 j i) ≫ (O j).ι := by
    intro i j
    simp only [Scheme.homOfLE_ι]
  have hdesc : ∀ (D : Scheme.GlueData.{u}) (m : ∀ j, D.U j ⟶ Y),
      (∀ i j, D.f i j ≫ m i = D.t i j ≫ D.f j i ≫ m j) →
      ∃ π : D.glued ⟶ Y, ∀ j, D.ι j ≫ π = m j := by
    intro D m hm
    refine ⟨Limits.Multicoequalizer.desc D.diagram Y m ?_, fun j =>
      Limits.Multicoequalizer.π_desc D.diagram Y m _ j⟩
    rintro ⟨i, j⟩
    exact hm i j
  obtain ⟨π, hπ⟩ := hdesc D (fun j => (O j).ι) hcompat
  refine ⟨D.glued, π, fun j => D.ι j, fun j => D.ι_isOpenImmersion j,
    hπ, fun z => D.ι_jointly_surjective z, ?_⟩
  intro j k x y
  rw [Scheme.GlueData.ι_eq_iff]
  show (∃ z : (W j k : Scheme.{u}), Y.homOfLE (h2 j k) z = x ∧
      (Y.homOfLE (h3 j k).le ≫ Y.homOfLE (h2 k j)) z = y) ↔ _
  constructor
  · rintro ⟨z, hx, hy⟩
    have ex : (O j).ι x = (W j k).ι z := by
      rw [← hx, ← Scheme.homOfLE_ι Y (h2 j k), Scheme.Hom.comp_apply]
    have ey : (O k).ι y = (W j k).ι z := by
      rw [← hy, ← Scheme.homOfLE_ι Y (h3 j k).le, ← Scheme.homOfLE_ι Y (h2 k j)]
      simp only [Scheme.Hom.comp_apply]
    refine ⟨ex.trans ey.symm, ?_⟩
    rw [ex]
    exact hmem _ _
  · rintro ⟨hxy, hxW⟩
    obtain ⟨z, hz⟩ : (O j).ι x ∈ Set.range (W j k).ι := by
      rw [Scheme.Opens.range_ι]; exact hxW
    refine ⟨z, ?_, ?_⟩
    · apply (O j).ι.isOpenEmbedding.injective
      rw [← hz, ← Scheme.homOfLE_ι Y (h2 j k), Scheme.Hom.comp_apply]
    · apply (O k).ι.isOpenEmbedding.injective
      rw [← hxy, ← hz, ← Scheme.homOfLE_ι Y (h3 j k).le, ← Scheme.homOfLE_ι Y (h2 k j)]
      simp only [Scheme.Hom.comp_apply]

theorem wc_finite_etale_of_local_disjoint_copies : ∀ (X P : Scheme.{u}) (p : P ⟶ X) (I : Type) [Finite I] (A : I → Scheme.{u}) (e : ∀ i, A i ⟶ X), (∀ i, IsOpenImmersion (e i)) → (∀ i, IsAffine (A i)) → (∀ x : X, ∃ i, x ∈ Set.range (e i)) → ∀ (K : Type) [Finite K] [Nonempty K] (j : ∀ i, K → (A i ⟶ P)), (∀ i t, IsOpenImmersion (j i t)) → (∀ i t, j i t ≫ p = e i) → (∀ i t t', t ≠ t' → Disjoint (Set.range (j i t)) (Set.range (j i t'))) → (∀ i (z : P), p z ∈ Set.range (e i) → ∃ t, z ∈ Set.range (j i t)) → IsFinite p ∧ Etale p ∧ Surjective p :=
by
  classical
  intro X P p I _ A e he hA hcov K _ _ j hj hjp hdisj hfib

  have s1 : ∀ (B : Scheme.{u}) [IsAffine B],
      IsFinite (Limits.Sigma.desc (fun _ : ULift.{u} K => 𝟙 B)) := by
    intro B _
    have hfac : Limits.Sigma.desc (fun _ : ULift.{u} K => 𝟙 B) =
        Limits.Sigma.map (fun _ : ULift.{u} K => B.isoSpec.hom) ≫
          sigmaSpec (fun _ : ULift.{u} K => Γ(B, ⊤)) ≫
          Spec.map (CommRingCat.ofHom (algebraMap Γ(B, ⊤) (ULift.{u} K → Γ(B, ⊤)))) ≫
          B.isoSpec.inv := by
      apply Limits.Sigma.hom_ext
      intro k
      rw [Limits.Sigma.ι_comp_desc, Limits.Sigma.ι_map_assoc, ι_sigmaSpec_assoc,
        ← Spec.map_comp_assoc]
      have h1 : CommRingCat.ofHom (algebraMap Γ(B, ⊤) (ULift.{u} K → Γ(B, ⊤))) ≫
          CommRingCat.ofHom (Pi.evalRingHom (fun _ : ULift.{u} K => (Γ(B, ⊤) : Type u)) k) =
          𝟙 Γ(B, ⊤) := rfl
      rw [h1]
      erw [Spec.map_id]
      rw [Category.id_comp, Iso.hom_inv_id]
    have hSpec : IsFinite (Spec.map (CommRingCat.ofHom
        (algebraMap Γ(B, ⊤) (ULift.{u} K → Γ(B, ⊤))))) := by
      rw [IsFinite.SpecMap_iff]
      exact RingHom.finite_algebraMap.mpr inferInstance
    rw [hfac]
    infer_instance

  have s2 : ∀ (B : Scheme.{u}) (eB : B ⟶ X) (jB : K → (B ⟶ P)), (∀ t, IsOpenImmersion (jB t)) →
      (∀ t, jB t ≫ p = eB) → (∀ t t', t ≠ t' → Disjoint (Set.range (jB t)) (Set.range (jB t'))) →
      (∀ z : P, p z ∈ Set.range eB → ∃ t, z ∈ Set.range (jB t)) →
      IsOpenImmersion (Limits.Sigma.desc (fun t : ULift.{u} K => jB t.down)) ∧
      Limits.Sigma.desc (fun t : ULift.{u} K => jB t.down) ≫ p =
        Limits.Sigma.desc (fun _ : ULift.{u} K => 𝟙 B) ≫ eB ∧
      p ⁻¹' Set.range eB = Set.range (Limits.Sigma.desc (fun t : ULift.{u} K => jB t.down)) := by
    intro B eB jB hjB hjpB hdisjB hfibB
    have hpt : ∀ (t : ULift.{u} K) (y : B),
        (Limits.Sigma.desc (fun t : ULift.{u} K => jB t.down))
          (Limits.Sigma.ι (fun _ : ULift.{u} K => B) t y) = jB t.down y := by
      intro t y
      rw [← Scheme.Hom.comp_apply, Limits.Sigma.ι_comp_desc]
    refine ⟨?_, ?_, ?_⟩
    · haveI : ∀ t : ULift.{u} K, IsOpenImmersion (jB t.down) := fun t => hjB t.down
      apply isOpenImmersion_sigmaDesc
      intro t t' htt'
      exact hdisjB t.down t'.down (fun h => htt' (ULift.ext _ _ h))
    · apply Limits.Sigma.hom_ext
      intro t
      rw [Limits.Sigma.ι_comp_desc_assoc, Limits.Sigma.ι_comp_desc_assoc, Category.id_comp, hjpB]
    · ext z
      constructor
      · intro hz
        obtain ⟨t, y, rfl⟩ := hfibB z hz
        exact ⟨Limits.Sigma.ι (fun _ : ULift.{u} K => B) ⟨t⟩ y, hpt ⟨t⟩ y⟩
      · rintro ⟨w, rfl⟩
        have key : ∀ (t : ULift.{u} K) (y : B),
            (Limits.Sigma.desc (fun t : ULift.{u} K => jB t.down))
              (Limits.Sigma.ι (fun _ : ULift.{u} K => B) t y) ∈ p ⁻¹' Set.range eB := by
          intro t y
          refine ⟨y, ?_⟩
          rw [hpt, ← Scheme.Hom.comp_apply, hjpB]
        obtain ⟨t, y, rfl⟩ := Scheme.Cover.exists_eq (sigmaOpenCover (fun _ : ULift.{u} K => B)) w
        exact key t y

  have S := fun i => s2 (A i) (e i) (j i) (hj i) (hjp i) (hdisj i) (hfib i)
  have hcov' : ∀ x : X, ∃ i y, e i y = x := by
    intro x
    obtain ⟨i, y, hy⟩ := hcov x
    exact ⟨i, y, hy⟩
  haveI : ∀ i, IsOpenImmersion (e i) := he
  haveI : ∀ i, IsOpenImmersion (Limits.Sigma.desc (fun t : ULift.{u} K => j i t.down)) :=
    fun i => (S i).1
  have hopens : ∀ i, p ⁻¹ᵁ (e i).opensRange =
      (Limits.Sigma.desc (fun t : ULift.{u} K => j i t.down)).opensRange := by
    intro i
    apply TopologicalSpace.Opens.ext
    rw [Scheme.Hom.coe_preimage, Scheme.Hom.coe_opensRange, Scheme.Hom.coe_opensRange]
    exact (S i).2.2
  have hfin : IsFinite p := by
    rw [IsFinite.iff_isProper_and_isAffineHom]
    constructor
    · apply IsZariskiLocalAtTarget.of_openCover (P := @IsProper)
        (Scheme.Cover.mkOfCovers I A e hcov' : X.OpenCover)
      intro i
      haveI := hA i
      haveI := s1 (A i)
      haveI := (S i).1
      haveI := he i
      have hP : IsPullback (Limits.Sigma.desc (fun _ : ULift.{u} K => 𝟙 (A i)))
          (Limits.Sigma.desc (fun t : ULift.{u} K => j i t.down)) (e i) p :=
        IsOpenImmersion.isPullback _ _ _ _ (S i).2.1 (hopens i)
      show IsProper (Limits.pullback.snd p (e i))
      rw [← hP.flip.isoPullback_inv_snd]
      infer_instance
    · apply isAffineHom_of_forall_exists_isAffineOpen
      intro x
      obtain ⟨i, hi⟩ := hcov x
      haveI := hA i
      refine ⟨(e i).opensRange, ?_, isAffineOpen_opensRange (e i), ?_⟩
      · rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        exact hi
      · rw [hopens i]
        exact isAffineOpen_opensRange _
  have hcovP : ∀ z : P, ∃ (q : I × K) (y : A q.1), j q.1 q.2 y = z := by
    intro z
    obtain ⟨i, hi⟩ := hcov (p z)
    obtain ⟨t, y, hy⟩ := hfib i z hi
    exact ⟨(i, t), y, hy⟩
  haveI : ∀ q : I × K, IsOpenImmersion (j q.1 q.2) := fun q => hj q.1 q.2
  have het : Etale p := by
    apply @IsZariskiLocalAtSource.of_openCover @Etale HasRingHomProperty.instIsZariskiLocalAtSource
      _ _ p (Scheme.Cover.mkOfCovers (I × K) (fun q => A q.1) (fun q => j q.1 q.2) hcovP :
        P.OpenCover)
    intro q
    show Etale (j q.1 q.2 ≫ p)
    rw [hjp]
    infer_instance
  have hsurj : Surjective p := by
    rw [surjective_iff]
    intro x
    obtain ⟨i, y, rfl⟩ := hcov x
    exact ⟨j i (Classical.arbitrary K) y, by rw [← Scheme.Hom.comp_apply, hjp]⟩
  exact ⟨hfin, het, hsurj⟩

theorem wc_locallyConstant_mv_split_of_sections : ∀ (Y : Scheme.{u}) (U₀ U₁ U : Y.Opens), U₀ ⊔ U₁ = U → IsAffineOpen U₀ → IsAffineOpen U₁ → (∀ (V : Scheme.{u}) (p : V ⟶ (U : Scheme.{u})), IsFinite p → Etale p → Surjective p → ∃ σ : (U : Scheme.{u}) ⟶ V, σ ≫ p = 𝟙 _) → (∀ (Z : Scheme.{u}) (J : Type u) (O : J → Z.Opens) (W : J → J → Z.Opens), (∀ j, W j j = O j) → (∀ j k, W j k ≤ O j) → (∀ j k, W j k = W k j) → (∀ i j k, W i j ⊓ W i k ≤ W j k) → ∃ (P : Scheme.{u}) (π : P ⟶ Z) (ι : ∀ j, (O j : Scheme.{u}) ⟶ P), (∀ j, IsOpenImmersion (ι j)) ∧ (∀ j, ι j ≫ π = (O j).ι) ∧ (∀ z : P, ∃ (j : J) (x : (O j : Scheme.{u})), ι j x = z) ∧ ∀ (j k : J) (x : (O j : Scheme.{u})) (y : (O k : Scheme.{u})), ι j x = ι k y ↔ ((O j).ι x = (O k).ι y ∧ (O j).ι x ∈ W j k)) → (∀ (X P : Scheme.{u}) (p : P ⟶ X) (I : Type) [Finite I] (A : I → Scheme.{u}) (e : ∀ i, A i ⟶ X), (∀ i, IsOpenImmersion (e i)) → (∀ i, IsAffine (A i)) → (∀ x : X, ∃ i, x ∈ Set.range (e i)) → ∀ (K : Type) [Finite K] [Nonempty K] (j : ∀ i, K → (A i ⟶ P)), (∀ i t, IsOpenImmersion (j i t)) → (∀ i t, j i t ≫ p = e i) → (∀ i t t', t ≠ t' → Disjoint (Set.range (j i t)) (Set.range (j i t'))) → (∀ i (z : P), p z ∈ Set.range (e i) → ∃ t, z ∈ Set.range (j i t)) → IsFinite p ∧ Etale p ∧ Surjective p) → ∀ (m : ℕ), m ≠ 0 → ∀ f : LocallyConstant ((U₀ ⊓ U₁ : Y.Opens) : Scheme.{u}) (ZMod m), ∃ (f₀ : LocallyConstant (U₀ : Scheme.{u}) (ZMod m)) (f₁ : LocallyConstant (U₁ : Scheme.{u}) (ZMod m)), ∀ x : ((U₀ ⊓ U₁ : Y.Opens) : Scheme.{u}), f x = f₀ (Y.homOfLE inf_le_left x) + f₁ (Y.homOfLE inf_le_right x) :=
by
  intro Y U₀ U₁ U hU h₀ h₁ hsec hglue hfet m hm f
  classical
  have : NeZero m := ⟨hm⟩

  have memι : ∀ (V : Y.Opens) (x : (V : Scheme.{u})), V.ι x ∈ V := by
    intro V x
    have hx : V.ι x ∈ Set.range V.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx
    exact hx
  have hhom : ∀ (V V' : Y.Opens) (h : V ≤ V') (x : (V : Scheme.{u})),
      V'.ι (Y.homOfLE h x) = V.ι x := by
    intro V V' h x
    have hx := Scheme.Hom.comp_apply (Y.homOfLE h) V'.ι x
    rw [Scheme.homOfLE_ι] at hx
    exact hx.symm
  have hbot : ∀ y : Y, y ∉ (⊥ : Y.Opens) := by
    intro y hy
    have hy' : y ∈ ((⊥ : Y.Opens) : Set Y) := hy
    rw [TopologicalSpace.Opens.coe_bot] at hy'
    exact hy'
  have hinj01 : Function.Injective (U₀ ⊓ U₁).ι := Scheme.Hom.injective (U₀ ⊓ U₁).ι
  have mem01 : ∀ x : ((U₀ ⊓ U₁ : Y.Opens) : Scheme.{u}),
      (U₀ ⊓ U₁).ι x ∈ U₀ ∧ (U₀ ⊓ U₁).ι x ∈ U₁ := fun x =>
    TopologicalSpace.Opens.mem_inf.mp (memι _ x)
  have hrange01 : ∀ y : Y, y ∈ U₀ → y ∈ U₁ → ∃ x, (U₀ ⊓ U₁).ι x = y := by
    intro y hy0 hy1
    have hy : y ∈ Set.range (U₀ ⊓ U₁).ι := by
      rw [Scheme.Opens.range_ι]
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hy0, hy1⟩
    exact hy
  have hboth : ∀ (a b : Bool) (y : Y), a ≠ b → y ∈ cond a U₁ U₀ → y ∈ cond b U₁ U₀ →
      y ∈ U₀ ∧ y ∈ U₁ := by
    intro a b y hab ha hb
    cases a <;> cases b
    · exact absurd rfl hab
    · exact ⟨ha, hb⟩
    · exact ⟨hb, ha⟩
    · exact absurd rfl hab
  have hvinj : ∀ (b : Bool) (t s : ZMod m) (x : ((U₀ ⊓ U₁ : Y.Opens) : Scheme.{u})),
      cond b t (t + f x) = cond b s (s + f x) → t = s := by
    intro b t s x h
    cases b
    · have h' : t + f x = s + f x := h
      exact add_right_cancel h'
    · exact h

  obtain ⟨S, memS⟩ : ∃ S : ZMod m → Y.Opens, ∀ (d : ZMod m) (y : Y),
      y ∈ S d ↔ (y ∈ U₀ ∧ y ∈ U₁) ∧ ∀ x, (U₀ ⊓ U₁).ι x = y → f x = d := by
    refine ⟨fun d => ⟨_, (Scheme.Hom.isOpenEmbedding (U₀ ⊓ U₁).ι).isOpenMap _
      (IsLocallyConstant.isOpen_fiber f.isLocallyConstant d)⟩, ?_⟩
    intro d y
    show y ∈ (U₀ ⊓ U₁).ι '' {x | f x = d} ↔ _
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨mem01 x, fun x' hx' => by rw [hinj01 hx']; exact hx⟩
    · rintro ⟨⟨hy0, hy1⟩, H⟩
      obtain ⟨x, rfl⟩ := hrange01 y hy0 hy1
      exact ⟨x, H x rfl, rfl⟩

  obtain ⟨W, memW⟩ : ∃ W : ULift.{u} (Bool × ZMod m) → ULift.{u} (Bool × ZMod m) → Y.Opens,
      ∀ (b : Bool) (t : ZMod m) (c : Bool) (s : ZMod m) (y : Y),
        y ∈ W ⟨(b, t)⟩ ⟨(c, s)⟩ ↔ (y ∈ cond b U₁ U₀ ∧ y ∈ cond c U₁ U₀ ∧ (b = c → t = s) ∧
          ∀ x, (U₀ ⊓ U₁).ι x = y → cond b t (t + f x) = cond c s (s + f x)) := by
    refine ⟨fun j k => if j.down.1 = k.down.1 then
      (if j.down.2 = k.down.2 then cond j.down.1 U₁ U₀ else ⊥)
      else S (cond j.down.1 (j.down.2 - k.down.2) (k.down.2 - j.down.2)), ?_⟩
    intro b t c s y
    cases b <;> cases c
    · show y ∈ (if t = s then U₀ else ⊥) ↔ _
      by_cases hts : t = s
      · rw [if_pos hts]
        subst hts
        exact ⟨fun h => ⟨h, h, fun _ => rfl, fun _ _ => rfl⟩, fun h => h.1⟩
      · rw [if_neg hts]
        exact iff_of_false (hbot y) (fun h => hts (h.2.2.1 rfl))
    · show y ∈ S (s - t) ↔ _
      rw [memS]
      constructor
      · rintro ⟨⟨hy0, hy1⟩, H⟩
        refine ⟨hy0, hy1, fun h => absurd h (by decide), fun x hx => ?_⟩
        have h1 := H x hx
        show t + f x = s
        linear_combination h1
      · rintro ⟨hy0, hy1, -, H⟩
        refine ⟨⟨hy0, hy1⟩, fun x hx => ?_⟩
        have h1 : t + f x = s := H x hx
        linear_combination h1
    · show y ∈ S (t - s) ↔ _
      rw [memS]
      constructor
      · rintro ⟨⟨hy0, hy1⟩, H⟩
        refine ⟨hy1, hy0, fun h => absurd h (by decide), fun x hx => ?_⟩
        have h1 := H x hx
        show t = s + f x
        linear_combination -h1
      · rintro ⟨hy1, hy0, -, H⟩
        refine ⟨⟨hy0, hy1⟩, fun x hx => ?_⟩
        have h1 : t = s + f x := H x hx
        linear_combination -h1
    · show y ∈ (if t = s then U₁ else ⊥) ↔ _
      by_cases hts : t = s
      · rw [if_pos hts]
        subst hts
        exact ⟨fun h => ⟨h, h, fun _ => rfl, fun _ _ => rfl⟩, fun h => h.1⟩
      · rw [if_neg hts]
        exact iff_of_false (hbot y) (fun h => hts (h.2.2.1 rfl))
  have hW1 : ∀ j, W j j = cond j.down.1 U₁ U₀ := by
    rintro ⟨⟨b, t⟩⟩
    apply SetLike.ext
    intro y
    rw [memW]
    exact ⟨fun h => h.1, fun h => ⟨h, h, fun _ => rfl, fun _ _ => rfl⟩⟩
  have hW2 : ∀ j k, W j k ≤ cond j.down.1 U₁ U₀ := by
    rintro ⟨⟨b, t⟩⟩ ⟨⟨c, s⟩⟩ y hy
    exact ((memW b t c s y).mp hy).1
  have hW3 : ∀ j k, W j k = W k j := by
    rintro ⟨⟨b, t⟩⟩ ⟨⟨c, s⟩⟩
    apply SetLike.ext
    intro y
    rw [memW, memW]
    constructor <;> rintro ⟨h1, h2, h3, h4⟩ <;>
      exact ⟨h2, h1, fun h => (h3 h.symm).symm, fun x hx => (h4 x hx).symm⟩
  have hW4 : ∀ i j k, W i j ⊓ W i k ≤ W j k := by
    rintro ⟨⟨a, r⟩⟩ ⟨⟨b, t⟩⟩ ⟨⟨c, s⟩⟩ y hy
    have hy' : y ∈ W ⟨(a, r)⟩ ⟨(b, t)⟩ ⊓ W ⟨(a, r)⟩ ⟨(c, s)⟩ := hy
    obtain ⟨hy1, hy2⟩ := TopologicalSpace.Opens.mem_inf.mp hy'
    rw [memW] at hy1 hy2
    obtain ⟨ha, hb, hab, hv1⟩ := hy1
    obtain ⟨-, hc, hac, hv2⟩ := hy2
    show y ∈ W ⟨(b, t)⟩ ⟨(c, s)⟩
    rw [memW]
    refine ⟨hb, hc, ?_, fun x hx => (hv1 x hx).symm.trans (hv2 x hx)⟩
    intro hbc
    by_cases hy01 : y ∈ U₀ ∧ y ∈ U₁
    · obtain ⟨x, hx⟩ := hrange01 y hy01.1 hy01.2
      have h := (hv1 x hx).symm.trans (hv2 x hx)
      rw [hbc] at h
      exact hvinj c t s x h
    · have hab' : a = b := by
        by_contra hne
        exact hy01 (hboth a b y hne ha hb)
      exact (hab hab').symm.trans (hac (hab'.trans hbc))

  obtain ⟨P, π, ι, hoi, hfac, hsurj, hiff⟩ := hglue Y (ULift.{u} (Bool × ZMod m))
    (fun j => cond j.down.1 U₁ U₀) W hW1 hW2 hW3 hW4
  have hfac' : ∀ (b : Bool) (t : ZMod m), ι ⟨(b, t)⟩ ≫ π = (cond b U₁ U₀).ι := fun b t => hfac _
  have hle : ∀ b : Bool, cond b U₁ U₀ ≤ U := by
    intro b
    cases b
    · rw [← hU]; exact le_sup_left
    · rw [← hU]; exact le_sup_right
  have hrangeπ : Set.range π ⊆ Set.range U.ι := by
    rintro _ ⟨z, rfl⟩
    obtain ⟨j, x, rfl⟩ := hsurj z
    have e := Scheme.Hom.comp_apply (ι j) π x
    rw [hfac] at e
    rw [← e, Scheme.Opens.range_ι]
    exact hle _ (memι _ x)
  let p : P ⟶ (U : Scheme.{u}) := IsOpenImmersion.lift U.ι π hrangeπ
  have hp : p ≫ U.ι = π := IsOpenImmersion.lift_fac _ _ _

  have c1 : ∀ (b : Bool) (t : ZMod m), ι ⟨(b, t)⟩ ≫ p = Y.homOfLE (hle b) := by
    intro b t
    rw [← cancel_mono U.ι, Category.assoc, hp, hfac', Scheme.homOfLE_ι]
  have c2 : ∀ (b : Bool) (t t' : ZMod m), t ≠ t' →
      Disjoint (Set.range (ι ⟨(b, t)⟩)) (Set.range (ι ⟨(b, t')⟩)) := by
    intro b t t' htt
    rw [Set.disjoint_left]
    rintro _ ⟨x, rfl⟩ ⟨x', hx'⟩
    have hW := ((hiff ⟨(b, t)⟩ ⟨(b, t')⟩ x x').mp hx'.symm).2
    exact htt (((memW b t b t' _).mp hW).2.2.1 rfl)
  have hcross : ∀ (b b' : Bool) (t' : ZMod m) (x : ((U₀ ⊓ U₁ : Y.Opens) : Scheme.{u})), b' ≠ b →
      ∃ t, cond b' t' (t' + f x) = cond b t (t + f x) := by
    intro b b' t' x h
    cases b <;> cases b'
    · exact absurd rfl h
    · exact ⟨t' - f x, by simp⟩
    · exact ⟨t' + f x, by simp⟩
    · exact absurd rfl h
  have c3 : ∀ (b : Bool) (z : P), p z ∈ Set.range (Y.homOfLE (hle b)) →
      ∃ t, z ∈ Set.range (ι ⟨(b, t)⟩) := by
    rintro b z ⟨x₀, hx₀⟩
    obtain ⟨⟨⟨b', t'⟩⟩, x, rfl⟩ := hsurj z
    by_cases hbb : b' = b
    · subst hbb
      exact ⟨t', x, rfl⟩
    · have e1 : (cond b' U₁ U₀).ι x = (cond b U₁ U₀).ι x₀ := by
        have h1 := Scheme.Hom.comp_apply (ι ⟨(b', t')⟩) π x
        rw [hfac'] at h1
        have h2 := Scheme.Hom.comp_apply p U.ι (ι ⟨(b', t')⟩ x)
        rw [hp] at h2
        have h3 := hhom _ _ (hle b) x₀
        exact h1.trans (h2.trans ((congrArg (fun w => U.ι w) hx₀).symm.trans h3))
      have hy' : (cond b' U₁ U₀).ι x ∈ cond b' U₁ U₀ := memι _ x
      have hy : (cond b' U₁ U₀).ι x ∈ cond b U₁ U₀ := by rw [e1]; exact memι _ x₀
      obtain ⟨hy0, hy1⟩ := hboth b' b _ hbb hy' hy
      obtain ⟨x₁, hx₁⟩ := hrange01 _ hy0 hy1
      obtain ⟨t, ht⟩ := hcross b b' t' x₁ hbb
      refine ⟨t, x₀, ?_⟩
      refine (hiff ⟨(b, t)⟩ ⟨(b', t')⟩ x₀ x).mpr ⟨e1.symm, ?_⟩
      refine (memW b t b' t' _).mpr ⟨memι _ x₀, e1 ▸ hy', fun h => absurd h.symm hbb, ?_⟩
      intro x' hx'
      rw [hinj01 (hx'.trans (e1.symm.trans hx₁.symm))]
      exact ht.symm
  have c4 : ∀ x : (U : Scheme.{u}), ∃ b, x ∈ Set.range (Y.homOfLE (hle b)) := by
    intro x
    have hx' : U.ι x ∈ U₀ ⊔ U₁ := by rw [hU]; exact memι U x
    have key : ∀ b : Bool, U.ι x ∈ cond b U₁ U₀ → x ∈ Set.range (Y.homOfLE (hle b)) := by
      intro b hb
      obtain ⟨x', hx''⟩ : U.ι x ∈ Set.range (cond b U₁ U₀).ι := by
        rw [Scheme.Opens.range_ι]; exact hb
      exact ⟨x', Scheme.Hom.injective U.ι ((hhom _ _ (hle b) x').trans hx'')⟩
    rcases TopologicalSpace.Opens.mem_sup.mp hx' with h | h
    · exact ⟨false, key false h⟩
    · exact ⟨true, key true h⟩
  obtain ⟨hpf, hpe, hps⟩ := hfet (U : Scheme.{u}) P p Bool
    (fun b => ((cond b U₁ U₀ : Y.Opens) : Scheme.{u})) (fun b => Y.homOfLE (hle b))
    (fun b => inferInstance) (fun b => by cases b; exacts [h₀, h₁]) c4 (ZMod m)
    (fun b t => ι ⟨(b, t)⟩) (fun b t => hoi _) c1 c2 c3
  obtain ⟨σ, hσ⟩ := hsec P p hpf hpe hps
  have hσpt : ∀ x, p (σ x) = x := by
    intro x
    have h := Scheme.Hom.comp_apply σ p x
    rw [hσ] at h
    exact h.symm

  have hread : ∀ b : Bool, ∃ τ : LocallyConstant ((cond b U₁ U₀ : Y.Opens) : Scheme.{u}) (ZMod m),
      ∀ a, σ (Y.homOfLE (hle b) a) = ι ⟨(b, τ a)⟩ a := by
    intro b
    have hex : ∀ a, ∃ t, σ (Y.homOfLE (hle b) a) = ι ⟨(b, t)⟩ a := by
      intro a
      obtain ⟨t, a', ha'⟩ := c3 b (σ (Y.homOfLE (hle b) a)) ⟨a, (hσpt _).symm⟩
      refine ⟨t, ?_⟩
      have e : Y.homOfLE (hle b) a' = Y.homOfLE (hle b) a := by
        have h1 := Scheme.Hom.comp_apply (ι ⟨(b, t)⟩) p a'
        rw [c1 b t, ha', hσpt] at h1
        exact h1
      have haa : a' = a := Scheme.Hom.injective (Y.homOfLE (hle b)) e
      rw [← ha', haa]
    choose τ₀ hτ₀ using hex
    have hfib : ∀ t₀, τ₀ ⁻¹' {t₀} =
        (fun a => σ (Y.homOfLE (hle b) a)) ⁻¹' Set.range (ι ⟨(b, t₀)⟩) := by
      intro t₀
      ext a
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro h
        rw [hτ₀ a, h]
        exact ⟨a, rfl⟩
      · intro h
        by_contra hne
        exact Set.disjoint_left.mp (c2 b (τ₀ a) t₀ hne) ⟨a, (hτ₀ a).symm⟩ h
    have hlc : IsLocallyConstant τ₀ := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro t₀
      rw [hfib]
      have := hoi ⟨(b, t₀)⟩
      exact IsOpen.preimage ((Scheme.Hom.continuous σ).comp
        (Scheme.Hom.continuous (Y.homOfLE (hle b))))
        (Scheme.Hom.isOpenEmbedding (ι ⟨(b, t₀)⟩)).isOpen_range
    exact ⟨⟨τ₀, hlc⟩, hτ₀⟩
  obtain ⟨τ₀, hτ₀⟩ := hread false
  obtain ⟨τ₁, hτ₁⟩ := hread true
  refine ⟨-τ₀, τ₁, fun x => ?_⟩
  have hu : Y.homOfLE (hle false) (Y.homOfLE inf_le_left x) =
      Y.homOfLE (hle true) (Y.homOfLE inf_le_right x) := by
    apply Scheme.Hom.injective U.ι
    exact (hhom _ _ (hle false) _).trans ((hhom _ _ inf_le_left x).trans
      ((hhom _ _ inf_le_right x).symm.trans (hhom _ _ (hle true) _).symm))
  have heq : ι ⟨(false, τ₀ (Y.homOfLE inf_le_left x))⟩ (Y.homOfLE inf_le_left x) =
      ι ⟨(true, τ₁ (Y.homOfLE inf_le_right x))⟩ (Y.homOfLE inf_le_right x) :=
    (hτ₀ _).symm.trans ((congrArg (fun w => σ w) hu).trans (hτ₁ _))
  have hmemb := ((hiff _ _ _ _).mp heq).2
  have hv : τ₀ (Y.homOfLE inf_le_left x) + f x = τ₁ (Y.homOfLE inf_le_right x) :=
    ((memW false _ true _ _).mp hmemb).2.2.2 x (hhom _ _ inf_le_left x).symm
  change f x = -(τ₀ (Y.homOfLE inf_le_left x)) + τ₁ (Y.homOfLE inf_le_right x)
  linear_combination hv

theorem wc_et_basic_mv_h0_surj : ∀ (Y : Scheme.{u}) [IsAffine Y], (∀ (c : Γ(Y, ⊤)) (V : Scheme.{u}) (p : V ⟶ (Y.basicOpen c : Scheme.{u})), IsFinite p → Etale p → Surjective p → ∃ σ : (Y.basicOpen c : Scheme.{u}) ⟶ V, σ ≫ p = 𝟙 _) → ∀ (m : ℕ), m ≠ 0 → ∀ (a b c : Γ(Y, ⊤)), Y.basicOpen a ⊔ Y.basicOpen b = Y.basicOpen c → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ y : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj (Y.basicOpen a ⊓ Y.basicOpen b)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 0, ∃ (y₀ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj (Y.basicOpen a)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 0) (y₁ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj ((wcZarToEt Y).obj (Y.basicOpen b)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) 0), y = (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_left : Y.basicOpen a ⊓ Y.basicOpen b ≤ Y.basicOpen a)))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp y₀ (zero_add 0) + (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE (inf_le_right : Y.basicOpen a ⊓ Y.basicOpen b ≤ Y.basicOpen b)))) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp y₁ (zero_add 0) :=
by
  intro Y _ hsec m hm a b c hU
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
