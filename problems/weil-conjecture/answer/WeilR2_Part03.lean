theorem wc_et_affine_ext_filtered_colim_inj : ∀ (Y : Scheme.{u}) [IsAffine Y] (J : Type u) [SmallCategory J] [IsFiltered J] (D : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (c : Limits.Cocone D), Nonempty (Limits.IsColimit c) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ (n : ℕ) (j₀ : J) (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (D.obj j₀) n), x.comp (Abelian.Ext.mk₀ (c.ι.app j₀)) (add_zero n) = 0 → ∃ (j : J) (f : j₀ ⟶ j), x.comp (Abelian.Ext.mk₀ (D.map f)) (add_zero n) = 0 :=
by
  intro Y _ J _ _ D c hc
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro n j₀ x hx
  obtain ⟨hc⟩ := hc
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}

  have cc : ∀ {A B C' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} {p : ℕ}
      (v : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) A p) (f : A ⟶ B) (g : B ⟶ C'),
      (v.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ g) (add_zero p) =
        v.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero p) := by
    intro A B C' p v f g
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hYaff : IsAffine (Scheme.Etale.mk (𝟙 Y)).left := by
    change IsAffine Y
    infer_instance

  have main : ∀ (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ] (n : ℕ)
      (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (i : Λ)
      (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (F.obj i) n),
      x.comp (Abelian.Ext.mk₀ (Limits.colimit.ι F i)) (add_zero n) = 0 →
      ∃ (j : Λ) (f : i ⟶ j), x.comp (Abelian.Ext.mk₀ (F.map f)) (add_zero n) = 0 := by
    intro Λ _ _

    have Ainj : ∀ (G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (i : Λ)
        (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G.obj i) 0),
        y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero 0) = 0 →
        ∃ (j : Λ) (f : i ⟶ j), y.comp (Abelian.Ext.mk₀ (G.map f)) (add_zero 0) = 0 := by
      intro G i y hy
      obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y Λ G
      obtain ⟨-, hinj⟩ := wc_et_affine_sections_local_cocone Y Λ G (Limits.colimit G)
        (Limits.colimit.ι G) (fun i j f => Limits.colimit.w G f) hA hB (Scheme.Etale.mk (𝟙 Y)) hYaff
      have h1 := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G i) y
      rw [Sheaf.H.map_apply] at h1
      have h0 : ((Limits.colimit.ι G i).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
