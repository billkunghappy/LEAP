    (hα0 : α 0 = 0) (hαadd : ∀ c c', α (c + c') = α c + α c') :
    (∀ (σ : Finset (Fin N)) (κ : ℕ) (f : Fin R → MvPolynomial (Fin N) A),
      (∀ i ∈ σ, IsUnit (u i)) →
      wcKlmEv α u ℓ (fun r => ∑ μ ∈ (f r).support,
        Finsupp.single (fun i => (μ i : ℤ) - if i ∈ σ then (κ : ℤ) else 0) ((f r).coeff μ)) =
      (∏ i ∈ σ, Ring.inverse (u i)) ^ κ • wcKlmPEv α u ℓ f) ∧
    (∀ (i : Fin N) (n : ℕ) (f : Fin R → MvPolynomial (Fin N) A),
      wcKlmPEv α u ℓ ((MvPolynomial.X i ^ n : MvPolynomial (Fin N) A) • f) =
        u i ^ n • wcKlmPEv α u ℓ f) :=
by
  have unitPow : ∀ (x : T), IsUnit x → ∀ (a b c d : ℕ),
      (a : ℤ) - b = (c : ℤ) - d → x ^ a * Ring.inverse x ^ b = x ^ c * Ring.inverse x ^ d := by
    intro x hx a b c d habcd
    obtain ⟨υ, rfl⟩ := hx
    rw [Ring.inverse_unit]
    have key : υ ^ a * υ⁻¹ ^ b = υ ^ c * υ⁻¹ ^ d := by
      rw [inv_pow, inv_pow, ← zpow_natCast υ a, ← zpow_natCast υ b, ← zpow_natCast υ c,
        ← zpow_natCast υ d, ← zpow_neg, ← zpow_neg, ← zpow_add, ← zpow_add]
      congr 1
    have := congrArg (fun z : Tˣ => (z : T)) key
    simpa only [Units.val_mul, Units.val_pow_eq_pow_val] using this
  have lpFactor : ∀ (σ : Finset (Fin N)),
      (∀ i ∈ σ, IsUnit (u i)) → ∀ (κ : ℕ) (μ : Fin N →₀ ℕ),
      wcKlmLP u (fun i => (μ i : ℤ) - if i ∈ σ then (κ : ℤ) else 0) =
        (∏ i ∈ σ, Ring.inverse (u i)) ^ κ * ∏ i, u i ^ μ i := by
    intro σ hσ κ μ
    unfold wcKlmLP
    have hfac : ∀ i, u i ^ ((μ i : ℤ) - if i ∈ σ then (κ : ℤ) else 0).toNat *
        Ring.inverse (u i) ^ (-((μ i : ℤ) - if i ∈ σ then (κ : ℤ) else 0)).toNat =
        (if i ∈ σ then Ring.inverse (u i) ^ κ else 1) * u i ^ μ i := by
      intro i
      by_cases hi : i ∈ σ
      · simp only [hi, if_true]
        rw [mul_comm (Ring.inverse (u i) ^ κ)]
        exact unitPow _ (hσ i hi) _ _ _ _ (Int.toNat_sub_toNat_neg _)
      · simp only [hi, if_false, sub_zero, Int.toNat_natCast, one_mul]
        rw [Int.toNat_eq_zero.mpr (by omega), pow_zero, mul_one]
    rw [Finset.prod_congr rfl (fun i _ => hfac i), Finset.prod_mul_distrib, Finset.prod_ite_mem,
      Finset.univ_inter, Finset.prod_pow]
  have pevX : ∀ (i : Fin N) (f : Fin R → MvPolynomial (Fin N) A),
      wcKlmPEv α u ℓ ((MvPolynomial.X i : MvPolynomial (Fin N) A) • f) =
        u i • wcKlmPEv α u ℓ f := by
    intro i f
    unfold wcKlmPEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, MvPolynomial.support_X_mul, Finset.sum_map, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    have hp : ∏ j, u j ^ ((Finsupp.single i 1 + μ : Fin N →₀ ℕ) j) =
        u i * ∏ j, u j ^ μ j := by
      simp only [Finsupp.add_apply, pow_add, Finset.prod_mul_distrib]
      congr 1
      rw [Finset.prod_eq_single i (fun j _ hj => by
          rw [Finsupp.single_apply, if_neg (fun h' => hj h'.symm), pow_zero])
        (fun hi => absurd (Finset.mem_univ i) hi), Finsupp.single_eq_same, pow_one]
    rw [addLeftEmbedding_apply, MvPolynomial.coeff_X_mul, hp, smul_smul]
    congr 1
    ring
  refine ⟨fun σ κ f hσ => ?_, fun i n f => ?_⟩
  · unfold wcKlmEv wcKlmPEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [← Finsupp.sum_finsetSum_index (fun _ => by simp [hα0])
      (fun _ _ _ => by simp only [hαadd, add_mul, add_smul]), Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [Finsupp.sum_single_index (by simp [hα0]), lpFactor σ hσ κ μ, smul_smul]
    congr 1
    ring
  · induction n with
    | zero => rw [pow_zero, one_smul, pow_zero, one_smul]
    | succ n ih => rw [pow_succ', mul_smul, pevX, ih, smul_smul, ← pow_succ']

theorem wc_cn_klm_shift_algebra : ∀ (A : Type u) [CommRing A] (n : ℕ) (σ : Finset (Fin n))
    (κ N : ℕ) (g : MvPolynomial (Fin n) A),
    (∑ μ ∈ ((∏ i ∈ σ, MvPolynomial.X i ^ N) * g).support,
        Finsupp.single (fun i => (μ i : ℤ) - if i ∈ σ then ((κ + N : ℕ) : ℤ) else 0)
          (((∏ i ∈ σ, MvPolynomial.X i ^ N) * g).coeff μ) =
      ∑ μ ∈ g.support, Finsupp.single (fun i => (μ i : ℤ) - if i ∈ σ then (κ : ℤ) else 0)
        (g.coeff μ)) ∧
    (∀ c : ℤ, (∀ μ ∈ g.support, (∑ i, (μ i : ℤ)) = c) →
      ∀ μ ∈ ((∏ i ∈ σ, MvPolynomial.X i ^ N) * g).support,
        (∑ i, (μ i : ℤ)) = c + (N : ℤ) * (σ.card : ℤ)) ∧
    (∀ μ ∈ g.support, g.coeff μ =
      (∑ μ' ∈ g.support, Finsupp.single (fun i => (μ' i : ℤ) - if i ∈ σ then (κ : ℤ) else 0)
        (g.coeff μ')) (fun i => (μ i : ℤ) - if i ∈ σ then (κ : ℤ) else 0)) ∧
    (∀ c : ℤ, (∀ μ ∈ g.support, (∑ i, (μ i : ℤ)) = c) → g.IsHomogeneous c.toNat) :=
by
  intro A _ n σ κ N g
  set ν : Fin n →₀ ℕ := ∑ i ∈ σ, Finsupp.single i N with hν
  have s1 : (∏ i ∈ σ, (MvPolynomial.X i : MvPolynomial (Fin n) A) ^ N) =
      MvPolynomial.monomial ν 1 := by
    rw [hν, MvPolynomial.monomial_sum_one]
    exact Finset.prod_congr rfl (fun i _ => MvPolynomial.X_pow_eq_monomial)
  have s2 : ∀ i, ν i = if i ∈ σ then N else 0 := by
    intro i
    rw [hν, Finsupp.finsetSum_apply]
    simp [Finsupp.single_apply]
  rw [s1]
  set h := MvPolynomial.monomial ν (1 : A) * g with hh
  have s3a : ∀ μ, h.coeff (ν + μ) = g.coeff μ := fun μ => by
    rw [hh, MvPolynomial.coeff_monomial_mul, one_mul]
  have s3c : ∀ μ' ∈ h.support, ν ≤ μ' ∧ μ' - ν ∈ g.support := by
    intro μ' hμ'
    rw [MvPolynomial.mem_support_iff, hh, MvPolynomial.coeff_monomial_mul', one_mul] at hμ'
    split_ifs at hμ' with hle
    · exact ⟨hle, MvPolynomial.mem_support_iff.mpr hμ'⟩
    · exact absurd rfl hμ'
  have s3d : ∀ μ ∈ g.support, ν + μ ∈ h.support := by
    intro μ hμ
    rw [MvPolynomial.mem_support_iff, s3a]
    exact MvPolynomial.mem_support_iff.mp hμ
  have s4 : ∀ μ : Fin n →₀ ℕ,
      (fun i => (((ν + μ) i : ℕ) : ℤ) - if i ∈ σ then ((κ + N : ℕ) : ℤ) else 0) =
      (fun i => (μ i : ℤ) - if i ∈ σ then (κ : ℤ) else 0) := by
    intro μ
    funext i
    rw [Finsupp.add_apply, s2]
    by_cases hi : i ∈ σ
    · simp only [hi, ite_true]; push_cast; ring
    · simp only [hi, ite_false]; push_cast; ring
  refine ⟨?_, ?_, ?_, ?_⟩
  · symm
    apply Finset.sum_nbij' (fun μ => ν + μ) (fun μ' => μ' - ν)
    · intro μ hμ; exact s3d μ hμ
    · intro μ' hμ'; exact (s3c μ' hμ').2
    · intro μ _; exact add_tsub_cancel_left ν μ
    · intro μ' hμ'; exact add_tsub_cancel_of_le (s3c μ' hμ').1
    · intro μ _
      rw [s3a, s4 μ]
  · intro c hc μ' hμ'
    obtain ⟨hle, hmem⟩ := s3c μ' hμ'
    have e : μ' = ν + (μ' - ν) := (add_tsub_cancel_of_le hle).symm
    rw [e]
    have hsum : ∑ i, (((ν + (μ' - ν)) i : ℕ) : ℤ) =
        ∑ i, (ν i : ℤ) + ∑ i, (((μ' - ν) i : ℕ) : ℤ) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finsupp.add_apply]
      push_cast
      ring
    have hν' : ∑ i, (ν i : ℤ) = (N : ℤ) * σ.card := by
      simp only [s2]
      push_cast
      rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
      ring
    rw [hsum, hν', hc _ hmem]
    ring
  · intro μ hμ
    rw [Finsupp.finsetSum_apply, Finset.sum_eq_single μ]
    · rw [Finsupp.single_eq_same]
    · intro μ' _ hne
      rw [Finsupp.single_apply, if_neg]
      intro heq
      apply hne
      ext i
      have h1 := congrFun heq i
      simp only [sub_left_inj, Nat.cast_inj] at h1
      omega
    · intro hn
      exact absurd hμ hn
  · intro c hc d hd
    have hmem : d ∈ g.support := MvPolynomial.mem_support_iff.mpr hd
    have h1 := hc d hmem
    have h2 : (Finsupp.weight 1 d : ℕ) = ∑ i, d i := by
      rw [Finsupp.weight_apply, Finsupp.sum_fintype]
      · simp
      · intro i; simp
    rw [h2, ← h1, ← Nat.cast_sum, Int.toNat_natCast]

theorem wc_cn_klm_saturate : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m r q : ℕ) (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n) (D : ℕ)
    (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)),
    wcKlmHyp h g e b Gs ψ D L →
    ∀ (p : ℕ) (k : Fin (m + 1)) (f : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B))
      (d : ℕ), (∀ ρ, (f ρ).IsHomogeneous d) → (∀ ρ μ, ((f ρ).coeff μ).IsHomogeneous p) →
    wcKlmPEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) (wcKlmEps b p c))
      (fun i => g.app (wcPmChart m k) (e k i)) (fun ρ => L k ρ p) f = 0 →
    ∃ M : ℕ, ((MvPolynomial.X k ^ M : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) • f) ∈
      wcKlmK h g e b Gs L :=
by
  intro B _ _ _ Z h m r q g e b Gs ψ D L hHyp p k f d hhom hcoef hP
  classical
  obtain ⟨hg, he1, he2, he3, he4, hG, hb, htw, hsp, hL1⟩ := hHyp

  have pevMap : ∀ {A T T' M M' : Type u} [CommRing A] [CommRing T] [CommRing T']
      [AddCommGroup M] [Module T M] [AddCommGroup M'] [Module T' M'] {N R : ℕ}
      (φ : T →+* T') (π : M →+ M'), (∀ (t : T) (x : M), π (t • x) = φ t • π x) →
      ∀ (α : A → T) (u : Fin N → T) (ℓ : Fin R → M) (f : Fin R → MvPolynomial (Fin N) A),
      π (wcKlmPEv α u ℓ f) =
        wcKlmPEv (fun c => φ (α c)) (fun i => φ (u i)) (fun r => π (ℓ r)) f := by
    intro A T T' M M' _ _ _ _ _ _ _ N R φ π hπ α u ℓ f
    unfold wcKlmPEv
    rw [map_sum]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [hπ, map_mul, map_prod]
    simp only [map_pow]

  have pevChart : ∀ {A T M : Type u} [CommRing A] [CommRing T] [AddCommGroup M]
      [Module T M] {N R : ℕ} (α : A → T) (u u' : Fin N → T) (ℓ ℓ' : Fin R → M) (c : T)
      (d D : ℕ) (f : Fin R → MvPolynomial (Fin N) A),
      (∀ i, u i = c * u' i) → (∀ r, (f r).IsHomogeneous d) →
      (∀ r, ∀ μ ∈ (f r).support,
        α ((f r).coeff μ) • ℓ r = α ((f r).coeff μ) • (c ^ D • ℓ' r)) →
      wcKlmPEv α u ℓ f = c ^ (d + D) • wcKlmPEv α u' ℓ' f := by
    intro A T M _ _ _ _ N R α u u' ℓ ℓ' c d D f hu hhom hℓ
    have hu' : u = fun i => c * u' i := funext hu
    subst hu'
    unfold wcKlmPEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ hμ => ?_)
    have hdeg : ∑ i, μ i = d := by
      have h1 : Finsupp.degree μ = d := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hμ) ((hhom r).coeff_eq_zero hne)
      rw [← h1, Finsupp.degree_eq_sum]
    have hprod : ∏ i, (c * u' i) ^ μ i = c ^ d * ∏ i, u' i ^ μ i := by
      rw [← hdeg, ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [mul_pow]
    dsimp only
    rw [hprod]
    calc (α ((f r).coeff μ) * (c ^ d * ∏ i, u' i ^ μ i)) • ℓ r
        = (c ^ d * ∏ i, u' i ^ μ i) • (α ((f r).coeff μ) • ℓ r) := by
          rw [mul_comm, mul_smul]
      _ = (c ^ d * ∏ i, u' i ^ μ i) • (α ((f r).coeff μ) • (c ^ D • ℓ' r)) := by
          rw [hℓ r μ hμ]
      _ = (c ^ (d + D) * (α ((f r).coeff μ) * ∏ i, u' i ^ μ i)) • ℓ' r := by
          rw [smul_smul, smul_smul]; congr 1; ring
      _ = _ := by rw [mul_smul]

  have pevZero : ∀ {A T M : Type u} [CommRing A] [CommRing T] [AddCommGroup M]
      [Module T M] {N R : ℕ} (α : A → T) (u : Fin N → T) (ℓ : Fin R → M)
      (f : Fin R → MvPolynomial (Fin N) A),
      (∀ r μ, α ((f r).coeff μ) = 0) → wcKlmPEv α u ℓ f = 0 := by
    intro A T M _ _ _ _ N R α u ℓ f h0
    unfold wcKlmPEv
    refine Finset.sum_eq_zero (fun r _ => Finset.sum_eq_zero (fun μ _ => ?_))
    rw [h0, zero_mul, zero_smul]

  have pevX : ∀ {A T M : Type u} [CommRing A] [CommRing T] [AddCommGroup M]
      [Module T M] {N R : ℕ} (α : A → T) (u : Fin N → T) (ℓ : Fin R → M) (i : Fin N)
      (f : Fin R → MvPolynomial (Fin N) A),
      wcKlmPEv α u ℓ ((MvPolynomial.X i : MvPolynomial (Fin N) A) • f) =
        u i • wcKlmPEv α u ℓ f := by
    intro A T M _ _ _ _ N R α u ℓ i f
    unfold wcKlmPEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun ρ _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, MvPolynomial.support_X_mul, Finset.sum_map, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    have hp : ∏ j, u j ^ ((Finsupp.single i 1 + μ : Fin N →₀ ℕ) j) =
        u i * ∏ j, u j ^ μ j := by
      simp only [Finsupp.add_apply, pow_add, Finset.prod_mul_distrib]
      congr 1
      rw [Finset.prod_eq_single i (fun j _ hj => by
          rw [Finsupp.single_apply, if_neg (fun h' => hj h'.symm), pow_zero])
        (fun hi => absurd (Finset.mem_univ i) hi), Finsupp.single_eq_same, pow_one]
    rw [addLeftEmbedding_apply, MvPolynomial.coeff_X_mul, hp, smul_smul]
    congr 1
    ring
  have pevXn : ∀ {A T M : Type u} [CommRing A] [CommRing T] [AddCommGroup M]
      [Module T M] {N R : ℕ} (α : A → T) (u : Fin N → T) (ℓ : Fin R → M) (i : Fin N) (n : ℕ)
      (f : Fin R → MvPolynomial (Fin N) A),
      wcKlmPEv α u ℓ ((MvPolynomial.X i ^ n : MvPolynomial (Fin N) A) • f) =
        u i ^ n • wcKlmPEv α u ℓ f := by
    intro A T M _ _ _ _ N R α u ℓ i n f
    induction n with
    | zero => rw [pow_zero, one_smul, pow_zero, one_smul]
    | succ n ih => rw [pow_succ', mul_smul, pevX, ih, smul_smul, ← pow_succ']

  have resZ : ∀ {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Z, U)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have smulM : ∀ (M : Z.Modules) {U V : Z.Opens} (h : V ≤ U) (r : Γ(Z, U)) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h).op).hom (r • x) =
      (Z.presheaf.map (homOfLE h).op).hom r • (M.presheaf.map (homOfLE h).op).hom x :=
    fun M U V h r x => Scheme.Modules.map_smul M (homOfLE h) r x
  have natψ : ∀ (p : ℕ) {U V : Z.Opens} (h : V ≤ U) (x : Γ(Gs (p + 1), U)),
      Scheme.Modules.Hom.app (ψ p) V (((Gs (p + 1)).presheaf.map (homOfLE h).op).hom x) =
      ((Gs p).presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app (ψ p) U x) :=
    fun p U V h x => NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf (ψ p)) (homOfLE h).op x
  have natg : ∀ {A B : (wcPm.{u} m).Opens} (h : B ≤ A) (x : Γ(wcPm.{u} m, A)),
      g.app B ((wcPm.{u} m).presheaf.map (homOfLE h).op x) =
      (Z.presheaf.map (homOfLE (g.preimage_mono h)).op).hom (g.app A x) := by
    intro A B h x
    exact congrArg (fun f => f.hom x) (g.naturality (homOfLE h).op)
  have sigRes : ∀ {U V : Z.Opens} (hVU : V ≤ U) (c : B),
      (Z.presheaf.map (homOfLE hVU).op).hom (wcCnSigma h U c) = wcCnSigma h V c := by
    intro U V hVU c
    unfold wcCnSigma
    simp only [RingHom.comp_apply]
    exact resZ _ _ _

  have hBO : ∀ k l, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l =
      Z.basicOpen (g.app (wcPmChart m k) (e k l)) := by
    intro k l
    rw [← Scheme.Hom.preimage_inf, he2, Scheme.preimage_basicOpen]
  have hF3 : ∀ k l i, (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k i)) =
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l)) *
      (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (g.app (wcPmChart m l) (e l i)) := by
    intro k l i
    have hW : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ (wcPmChart m k ⊓ wcPmChart m l) := (Scheme.Hom.preimage_inf g).ge
    have key := congrArg (fun x => (Z.presheaf.map (homOfLE hW).op).hom
      (g.app (wcPmChart m k ⊓ wcPmChart m l) x)) (he3 k l i)
    simp only [map_mul] at key
    rw [natg, natg, natg, resZ, resZ, resZ] at key
    exact key

  have hcov : ∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : ∀ k : Fin (m + 1), IsAffineOpen (wcPmChart.{u} m k) := fun k =>
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k))
        Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
    haveI hcomp : IsAffineHom (Limits.prod.lift h g ≫ Limits.prod.snd) := inferInstance
    have hga : IsAffineHom g := by
      rw [Limits.prod.lift_snd] at hcomp
      exact hcomp
    exact fun k => (hD k).preimage g
  have hcov2 : ∀ k l, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) := by
    intro k l
    rw [hBO k l]
    exact (hcov k).basicOpen _

  have hbm : ∀ i, b i ∈ IsLocalRing.maximalIdeal B := fun i => by
    rw [← hb]; exact Ideal.subset_span ⟨i, rfl⟩
  have hprod : ∀ d : Fin r →₀ ℕ, (d.prod fun i k => b i ^ k) ∈
      IsLocalRing.maximalIdeal B ^ d.degree := by
    intro d
    have h1 := Ideal.prod_mem_prod (s := d.support)
      (I := fun i => IsLocalRing.maximalIdeal B ^ d i) (x := fun i => b i ^ d i)
      (fun i _ => Ideal.pow_mem_pow (hbm i) _)
    rw [Finset.prod_pow_eq_pow_sum] at h1
    exact h1
  have hε : ∀ (p : ℕ) (c : MvPolynomial (Fin r) B),
      wcKlmEps b p c ∈ IsLocalRing.maximalIdeal B ^ p := by
    intro p c
    unfold wcKlmEps
    rw [MvPolynomial.homogeneousComponent_apply, map_sum]
    refine Ideal.sum_mem _ (fun d hd => ?_)
    rw [MvPolynomial.eval_monomial]
    have hdeg : d.degree = p := (Finset.mem_filter.mp hd).2
    refine Ideal.mul_mem_left _ _ ?_
    rw [← hdeg]
    exact hprod d

  have swap : ∀ (k l : Fin (m + 1)) (ρ : Fin q) (p : ℕ) (c : B),
      c ∈ IsLocalRing.maximalIdeal B ^ p →
      wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) c •
        ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ p) =
      wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) c •
        (((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l))) ^ D •
        ((Gs p).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (L l ρ p)) := by
    intro k l ρ p c hc
    have hV := hcov2 k l
    obtain ⟨x, hx⟩ : ∃ x : ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l), ∀ p, x p =
        ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ p) -
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l))) ^ D •
        ((Gs p).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (L l ρ p) := ⟨_, fun _ => rfl⟩
    have hx0 : x 0 = 0 := by
      rw [hx, sub_eq_zero]
      exact htw ρ k l
    have hxc : ∀ p, Scheme.Modules.Hom.app (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)
        (x (p + 1)) = x p := by
      intro p
      rw [hx (p + 1), hx p, map_sub, Scheme.Modules.Hom.app_smul, natψ, natψ, hL1, hL1]
    have hJ : ∀ p, x p ∈ Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
        (IsLocalRing.maximalIdeal B) • (⊤ : Submodule Γ(Z, g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l) Γ(Gs p, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)) := by
      intro p
      induction p with
      | zero => rw [hx0]; exact Submodule.zero_mem _
      | succ p ih =>
        obtain ⟨hs, hk⟩ := hG.2.1 p _ hV
        have hmap : Submodule.map (wcCnSecLin (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
            (Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
              (IsLocalRing.maximalIdeal B) • ⊤) =
            Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
              (IsLocalRing.maximalIdeal B) • ⊤ := by
          have hr : LinearMap.range (wcCnSecLin (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓
              g ⁻¹ᵁ wcPmChart m l)) = ⊤ := LinearMap.range_eq_top.mpr (fun y => hs y)
          rw [Submodule.map_smul'', Submodule.map_top, hr]
        rw [← hmap] at ih
        obtain ⟨y, hy, hyx⟩ := ih
        have hdiff : x (p + 1) - y ∈ Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓
            g ⁻¹ᵁ wcPmChart m l)) (IsLocalRing.maximalIdeal B) • (⊤ : Submodule Γ(Z, g ⁻¹ᵁ
              wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) Γ(Gs (p + 1), g ⁻¹ᵁ wcPmChart m k ⊓
                g ⁻¹ᵁ wcPmChart m l)) := by
          have h0 : Scheme.Modules.Hom.app (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)
              (x (p + 1) - y) = 0 := by
            rw [map_sub, hxc]
            exact sub_eq_zero.mpr hyx.symm
          exact Submodule.smul_mono_left (Ideal.map_mono (Ideal.pow_le_self (by omega)))
            ((hk _).mp h0)
        have := Submodule.add_mem _ hdiff hy
        rwa [sub_add_cancel] at this
    have hmem := Submodule.smul_mem_smul
      (Ideal.mem_map_of_mem (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)) hc) (hJ p)
    rw [← Submodule.mul_smul, ← Ideal.map_mul, ← pow_succ, hG.2.2 p _ hV,
      Submodule.mem_bot, hx, smul_sub, sub_eq_zero] at hmem
    exact hmem

  have chart : ∀ a : Fin (m + 1), ∃ N : ℕ, (g.app (wcPmChart m a) (e a k)) ^ N •
      wcKlmPEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m a) (wcKlmEps b p c))
        (fun i => g.app (wcPmChart m a) (e a i)) (fun ρ => L a ρ p) f = 0 := by
    intro a
    have e1 := pevMap (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom
      ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom (fun t x => smulM _ _ t x)
      (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m a) (wcKlmEps b p c))
      (fun i => g.app (wcPmChart m a) (e a i)) (fun ρ => L a ρ p) f
    simp only [sigRes] at e1
    have e3 := pevMap (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
      ((Gs p).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (fun t x => smulM _ _ t x)
      (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) (wcKlmEps b p c))
      (fun i => g.app (wcPmChart m k) (e k i)) (fun ρ => L k ρ p) f
    rw [hP, map_zero] at e3
    simp only [sigRes] at e3
    have e2 := pevChart (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m k)
        (wcKlmEps b p c))
      (fun i => (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a i)))
      (fun i => (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k i)))
      (fun ρ => ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom (L a ρ p))
      (fun ρ => ((Gs p).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ p))
      ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a k)))
      d D f (fun i => hF3 a k i) hhom
      (fun ρ μ _ => swap a k ρ p (wcKlmEps b p ((f ρ).coeff μ)) (hε p _))
    have hres : ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓
        g ⁻¹ᵁ wcPmChart m k ≤ g ⁻¹ᵁ wcPmChart m a)).op).hom
        (wcKlmPEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m a) (wcKlmEps b p c))
          (fun i => g.app (wcPmChart m a) (e a i)) (fun ρ => L a ρ p) f) = 0 :=
      e1.trans (e2.trans (by rw [← e3, smul_zero]))
    have hqc : wcQcoh (Gs p) := (hG.1 p).1
    have hq2 : ∀ (W : Z.Opens) (_ : W = Z.basicOpen (g.app (wcPmChart m a) (e a k)))
        (hWU : W ≤ g ⁻¹ᵁ wcPmChart m a) (x : Γ(Gs p, g ⁻¹ᵁ wcPmChart m a)),
        ((Gs p).presheaf.map (homOfLE hWU).op).hom x = 0 →
        ∃ N : ℕ, (g.app (wcPmChart m a) (e a k)) ^ N • x = 0 := by
      intro W hW hWU x hx
      subst hW
      exact (hqc _ (hcov a) _).2 x hx
    exact hq2 _ (hBO a k) inf_le_left _ hres
  choose N hN using chart

  have hcoefX : ∀ (i : Fin (m + 1)) (N : ℕ)
      (P : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      (∀ μ, (P.coeff μ).IsHomogeneous p) →
      ∀ μ, ((MvPolynomial.X i ^ N * P).coeff μ).IsHomogeneous p := by
    intro i N
    induction N with
    | zero => intro P hP μ; rw [pow_zero, one_mul]; exact hP μ
    | succ N ih =>
      intro P hP μ
      rw [pow_succ, mul_assoc]
      refine ih _ (fun μ' => ?_) μ
      rw [MvPolynomial.coeff_X_mul']
      split_ifs
      · exact hP _
      · exact MvPolynomial.isHomogeneous_zero _ _ _
  refine ⟨Finset.univ.sup N, Submodule.subset_span ⟨⟨Finset.univ.sup N + d, fun ρ => ?_⟩,
    fun a p' => ?_⟩⟩
  · rw [Pi.smul_apply, smul_eq_mul]
    exact (MvPolynomial.isHomogeneous_X_pow k _).mul (hhom ρ)
  · by_cases hp' : p' = p
    · subst hp'
      rw [pevXn]
      have hle : N a ≤ Finset.univ.sup N := Finset.le_sup (Finset.mem_univ a)
      rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hN a, smul_zero]
    · apply pevZero
      intro ρ μ
      have hc : ((((MvPolynomial.X k ^ Finset.univ.sup N :
          MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) • f) ρ).coeff μ).IsHomogeneous p := by
        rw [Pi.smul_apply, smul_eq_mul]
        exact hcoefX k _ _ (hcoef ρ) μ
      rw [wcKlmEps, MvPolynomial.homogeneousComponent_of_mem
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hc), if_neg hp', map_zero, map_zero]

theorem wc_cn_klm_T5 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m r q : ℕ) (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n) (D : ℕ)
    (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)),
    wcKlmHyp h g e b Gs ψ D L → ∀ n w : ℕ,
    ∀ k l j : Fin (m + 1), k < l → l < j → ∀ v ∈ wcKlmH B r q (m + 1) (n + 1),
      v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l, j} →
      wcKlmTh3 h g e b Gs L (n + 1) k l j v = 0 →
      v ∈ wcLaurK (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (wcKlmK h g e b Gs L)
        (w : ℤ) {k, l, j} :=
by
  intro B _ _ _ Z h m r q g e b Gs ψ D L hHyp n w k l j hkl hlj v hvH hvC hTh
  classical
  have hHyp' := hHyp
  obtain ⟨hg, he1, he2, _he3, _he4, hG, _hb, _htw, _hsp, _hL1⟩ := hHyp'
  have hkl' : k ≠ l := ne_of_lt hkl
  have hlj' : l ≠ j := ne_of_lt hlj
  have hkj' : k ≠ j := ne_of_lt (hkl.trans hlj)

  obtain ⟨κ, f, hf, hfdeg⟩ := wc_gc_laur_repr (MvPolynomial (Fin r) B) (m + 1) q
    (fun _ => (w : ℤ) - (D : ℤ)) ({k, l, j} : Finset (Fin (m + 1))) v (fun ρ => hvC ρ)
  set c : ℤ := (w : ℤ) - (D : ℤ) + (κ : ℤ) * (({k, l, j} : Finset (Fin (m + 1))).card : ℤ)
    with hc
  have hfdeg' : ∀ ρ, ∀ μ ∈ (f ρ).support, (∑ i, (μ i : ℤ)) = c := fun ρ μ hμ => hfdeg ρ μ hμ
  have hvH' : ∀ ρ β, (v ρ β).IsHomogeneous (n + 1) := hvH

  have hfhom : ∀ ρ, (f ρ).IsHomogeneous c.toNat := fun ρ =>
    (wc_cn_klm_shift_algebra _ (m + 1) ({k, l, j} : Finset (Fin (m + 1))) κ 0 (f ρ)).2.2.2 c
      (hfdeg' ρ)
  have hfcoef : ∀ ρ μ, ((f ρ).coeff μ).IsHomogeneous (n + 1) := by
    intro ρ μ
    by_cases hμ : μ ∈ (f ρ).support
    · have h1 := (wc_cn_klm_shift_algebra _ (m + 1) ({k, l, j} : Finset (Fin (m + 1))) κ 0
        (f ρ)).2.2.1 μ hμ
      rw [← hf ρ] at h1
      rw [h1]
      exact hvH' ρ _
    · rw [MvPolynomial.notMem_support_iff.mp hμ]
      exact MvPolynomial.isHomogeneous_zero _ _ _

  have hsig : ∀ (U V : Z.Opens) (hVU : V ≤ U) (a : B),
      (Z.presheaf.map (homOfLE hVU).op).hom (wcCnSigma h U a) = wcCnSigma h V a := by
    intro U V hVU a
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← RingHom.comp_apply (Z.presheaf.map (homOfLE hVU).op).hom, ← CommRingCat.hom_comp,
      ← Functor.map_comp]
    rfl
  have hα0 : ∀ U : Z.Opens, wcCnSigma h U (wcKlmEps b (n + 1) 0) = 0 := by
    intro U; simp [wcKlmEps]
  have hαadd : ∀ (U : Z.Opens) (a a' : MvPolynomial (Fin r) B),
      wcCnSigma h U (wcKlmEps b (n + 1) (a + a')) =
        wcCnSigma h U (wcKlmEps b (n + 1) a) + wcCnSigma h U (wcKlmEps b (n + 1) a') := by
    intro U a a'; simp [wcKlmEps, map_add]
  have hunitres : ∀ (U W : Z.Opens) (s : Γ(Z, U)) (_ : W = Z.basicOpen s) (hWU : W ≤ U),
      IsUnit ((Z.presheaf.map (homOfLE hWU).op).hom s) := by
    intro U W s hW hWU
    subst hW
    exact RingedSpace.isUnit_res_basicOpen Z.toRingedSpace s
  have hbasic : ∀ a, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m a =
      Z.basicOpen (g.app (wcPmChart m k) (e k a)) := by
    intro a
    rw [← Scheme.Hom.preimage_inf, he2, Scheme.preimage_basicOpen]
  have hV3 : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j =
      Z.basicOpen (g.app (wcPmChart m k) (e k l) * g.app (wcPmChart m k) (e k j)) := by
    rw [Scheme.basicOpen_mul, ← hbasic l, ← hbasic j, ← inf_inf_distrib_left, inf_assoc]
  have hι3 : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
      g ⁻¹ᵁ wcPmChart m k := le_trans inf_le_left inf_le_left

  have hunits : ∀ i ∈ ({k, l, j} : Finset (Fin (m + 1))),
      IsUnit ((Z.presheaf.map (homOfLE hι3).op).hom (g.app (wcPmChart m k) (e k i))) := by
    have hlj := hunitres _ _ _ hV3 hι3
    rw [map_mul] at hlj
    intro i hi
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi
    rcases hi with rfl | rfl | rfl
    · rw [he1 i, map_one, map_one]; exact isUnit_one
    · exact isUnit_of_mul_isUnit_left hlj
    · exact isUnit_of_mul_isUnit_right hlj

  have hEv := (wc_cn_klm5_ev_algebra
    (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)
      (wcKlmEps b (n + 1) c))
    (fun i => (Z.presheaf.map (homOfLE hι3).op).hom (g.app (wcPmChart m k) (e k i)))
    (fun ρ => ((Gs (n + 1)).presheaf.map (homOfLE hι3).op).hom (L k ρ (n + 1)))
    (hα0 _) (hαadd _)).1 ({k, l, j} : Finset (Fin (m + 1))) κ f hunits
  have hvfun : v = fun ρ => ∑ μ ∈ (f ρ).support, Finsupp.single
      (fun i => (μ i : ℤ) - if i ∈ ({k, l, j} : Finset (Fin (m + 1))) then (κ : ℤ) else 0)
      ((f ρ).coeff μ) := funext hf
  have hTh' : wcKlmTh3 h g e b Gs L (n + 1) k l j v = wcKlmEv
      (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)
        (wcKlmEps b (n + 1) c))
      (fun i => (Z.presheaf.map (homOfLE hι3).op).hom (g.app (wcPmChart m k) (e k i)))
      (fun ρ => ((Gs (n + 1)).presheaf.map (homOfLE hι3).op).hom (L k ρ (n + 1))) v := rfl
  rw [hTh', hvfun, hEv] at hTh
  have hPi : IsUnit (∏ i ∈ ({k, l, j} : Finset (Fin (m + 1))),
      Ring.inverse ((Z.presheaf.map (homOfLE hι3).op).hom (g.app (wcPmChart m k) (e k i)))) :=
    Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one
      (fun i hi => (hunits i hi).ringInverse)
  have hPEv3 := ((hPi.pow κ).smul_eq_zero).mp hTh

  have htrans : ((Gs (n + 1)).presheaf.map (homOfLE hι3).op).hom
      (wcKlmPEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) (wcKlmEps b (n + 1) c))
        (fun i => g.app (wcPmChart m k) (e k i)) (fun ρ => L k ρ (n + 1)) f) = 0 := by
    rw [← hPEv3]
    simp only [wcKlmPEv, map_sum]
    refine Finset.sum_congr rfl (fun ρ _ => Finset.sum_congr rfl (fun μ _ => ?_))
    rw [Scheme.Modules.map_smul, map_mul, map_prod, hsig]
    simp only [map_pow]

  have hUk : IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := (wc_pm_chart_cover B Z h m g hg).1 k
  have hqc : wcQcoh (Gs (n + 1)) := (hG.1 (n + 1)).1
  have hq2 : ∀ (W : Z.Opens) (_ : W = Z.basicOpen (g.app (wcPmChart m k) (e k l) *
      g.app (wcPmChart m k) (e k j))) (hWU : W ≤ g ⁻¹ᵁ wcPmChart m k)
      (x : Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k)),
      ((Gs (n + 1)).presheaf.map (homOfLE hWU).op).hom x = 0 →
      ∃ N : ℕ, (g.app (wcPmChart m k) (e k l) * g.app (wcPmChart m k) (e k j)) ^ N • x = 0 := by
    intro W hW hWU x hx
    subst hW
    exact (hqc _ hUk _).2 x hx
  obtain ⟨M, hM⟩ := hq2 _ hV3 hι3 _ htrans
  have hEvk := (wc_cn_klm5_ev_algebra
    (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) (wcKlmEps b (n + 1) c))
    (fun i => g.app (wcPmChart m k) (e k i)) (fun ρ => L k ρ (n + 1))
    (hα0 _) (hαadd _)).2
  set f₁ : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B) :=
    (MvPolynomial.X l ^ M : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) •
      (MvPolynomial.X j ^ M : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) • f with hf₁
  have hP₁ : wcKlmPEv (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m k) (wcKlmEps b (n + 1) c))
      (fun i => g.app (wcPmChart m k) (e k i)) (fun ρ => L k ρ (n + 1)) f₁ = 0 := by
    rw [hf₁, hEvk, hEvk, smul_smul, ← mul_pow, hM]

  have hcoefX : ∀ (i : Fin (m + 1)) (N : ℕ) (P : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)),
      (∀ μ, (P.coeff μ).IsHomogeneous (n + 1)) →
      ∀ μ, ((MvPolynomial.X i ^ N * P).coeff μ).IsHomogeneous (n + 1) := by
    intro i N
    induction N with
    | zero => intro P hP μ; rw [pow_zero, one_mul]; exact hP μ
    | succ N ih =>
      intro P hP μ
      rw [pow_succ, mul_assoc]
      refine ih _ (fun μ' => ?_) μ
      rw [MvPolynomial.coeff_X_mul']
      split_ifs
      · exact hP _
      · exact MvPolynomial.isHomogeneous_zero _ _ _
  have hhom₁ : ∀ ρ, (f₁ ρ).IsHomogeneous (M + (M + c.toNat)) := fun ρ =>
    (MvPolynomial.isHomogeneous_X_pow l M).mul
      ((MvPolynomial.isHomogeneous_X_pow j M).mul (hfhom ρ))
  have hcoef₁ : ∀ ρ μ, ((f₁ ρ).coeff μ).IsHomogeneous (n + 1) := fun ρ =>
    hcoefX l M _ (hcoefX j M _ (hfcoef ρ))
  obtain ⟨M', hM'⟩ := wc_cn_klm_saturate B Z h m r q g e b Gs ψ D L hHyp (n + 1) k f₁
    (M + (M + c.toNat)) hhom₁ hcoef₁ hP₁

  set F : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B) :=
    (∏ i ∈ ({k, l, j} : Finset (Fin (m + 1))),
      (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) ^ (M + M')) • f
      with hF
  have hprod : (∏ i ∈ ({k, l, j} : Finset (Fin (m + 1))),
      (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) ^ (M + M')) =
      MvPolynomial.X k ^ (M + M') * (MvPolynomial.X l ^ (M + M') * MvPolynomial.X j ^ (M + M')) := by
    rw [Finset.prod_insert (by simp [hkl', hkj']), Finset.prod_insert (by simp [hlj']),
      Finset.prod_singleton]
  have hFK : F ∈ wcKlmK h g e b Gs L := by
    have hmem := Submodule.smul_mem (wcKlmK h g e b Gs L)
      (MvPolynomial.X k ^ M * MvPolynomial.X l ^ M' * MvPolynomial.X j ^ M') hM'
    convert hmem using 1
    funext ρ
    simp only [hF, hf₁, Pi.smul_apply, smul_eq_mul, hprod]
    ring

  refine Submodule.subset_span ⟨κ + (M + M'), F, hFK, ?_, ?_⟩
  · intro ρ μ hμ
    have h1 := (wc_cn_klm_shift_algebra _ (m + 1) ({k, l, j} : Finset (Fin (m + 1))) κ (M + M')
      (f ρ)).2.1 c (hfdeg' ρ) μ hμ
    rw [h1, hc]
    push_cast
    ring
  · funext ρ
    rw [hf ρ]
    exact ((wc_cn_klm_shift_algebra _ (m + 1) ({k, l, j} : Finset (Fin (m + 1))) κ (M + M')
      (f ρ)).1).symm

theorem wc_cn_klm_T6 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m r q : ℕ) (g : Z ⟶ wcPm.{u} m)
    (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)) (b : Fin r → B)
    (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n) (D : ℕ)
    (L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)),
    wcKlmHyp h g e b Gs ψ D L → ∀ n w : ℕ,
    (∀ k l : Fin (m + 1), k < l →
      ∀ v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k},
      wcKlmTh2 h g e b Gs L (n + 1) k l v = ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left :
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
        (wcKlmTh1 h g e b Gs L (n + 1) k v)) ∧
    (∀ k l : Fin (m + 1), k < l →
      ∀ v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {l},
      wcKlmTh2 h g e b Gs L (n + 1) k l v = ((Z.presheaf.map (homOfLE (inf_le_left :
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
        (g.app (wcPmChart m k) (e k l))) ^ w •
        ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom
          (wcKlmTh1 h g e b Gs L (n + 1) l v)) ∧
    (∀ k l j : Fin (m + 1), k < l → l < j →
      ∀ v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, l},
      wcKlmTh3 h g e b Gs L (n + 1) k l j v = ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left :
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)).op).hom
        (wcKlmTh2 h g e b Gs L (n + 1) k l v)) ∧
    (∀ k l j : Fin (m + 1), k < l → l < j →
      ∀ v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k, j},
      wcKlmTh3 h g e b Gs L (n + 1) k l j v = ((Gs (n + 1)).presheaf.map (homOfLE (le_inf
        (le_trans inf_le_left inf_le_left) inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom
        (wcKlmTh2 h g e b Gs L (n + 1) k j v)) ∧
    (∀ k l j : Fin (m + 1), k < l → l < j →
      ∀ v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {l, j},
      wcKlmTh3 h g e b Gs L (n + 1) k l j v = ((Z.presheaf.map (homOfLE
        (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓
          g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l))) ^ w •
        ((Gs (n + 1)).presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right)
          inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom
          (wcKlmTh2 h g e b Gs L (n + 1) l j v)) :=
by
  intro B _ _ _ Z h m r q g e b Gs ψ D L hHyp n w
  obtain ⟨hg, he1, he2, he3, he4, hG, hb, htw, hsp, hL1⟩ := hHyp
  classical

  have evMap : ∀ {A T T' M M' : Type u} [CommRing A] [CommRing T] [CommRing T']
      [AddCommGroup M] [Module T M] [AddCommGroup M'] [Module T' M'] {N R : ℕ}
      (φ : T →+* T') (π : M →+ M'), (∀ (t : T) (x : M), π (t • x) = φ t • π x) →
      ∀ (α : A → T) (u : Fin N → T) (ℓ : Fin R → M) (v : Fin R → (Fin N → ℤ) →₀ A),
      (∀ r, ∀ β ∈ (v r).support, ∀ i, 0 ≤ β i ∨ IsUnit (u i)) →
      π (wcKlmEv α u ℓ v) =
        wcKlmEv (fun c => φ (α c)) (fun i => φ (u i)) (fun r => π (ℓ r)) v := by
    intro A T T' M M' _ _ _ _ _ _ _ N R φ π hπ α u ℓ v hu
    have hLP : ∀ β : Fin N → ℤ, (∀ i, 0 ≤ β i ∨ IsUnit (u i)) →
        φ (wcKlmLP u β) = wcKlmLP (fun i => φ (u i)) β := by
      intro β hβ
      unfold wcKlmLP
      rw [map_prod]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow, map_pow]
      dsimp only
      rcases hβ i with h0 | h0
      · have : (-β i).toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
        rw [this, pow_zero, pow_zero]
      · obtain ⟨υ, hυ⟩ := h0
        rw [← hυ, Ring.inverse_unit]
        have h1 : φ (↑υ⁻¹ : T) = ((Units.map φ.toMonoidHom υ)⁻¹ : T'ˣ) := by
          simp
        have h2 : φ (υ : T) = (Units.map φ.toMonoidHom υ : T'ˣ) := by simp
        rw [h1, h2, Ring.inverse_unit]
    unfold wcKlmEv
    rw [map_sum]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    rw [map_finsuppSum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    rw [hπ, map_mul, hLP β (hu r β hβ)]

  have evChart : ∀ {A T M : Type u} [CommRing A] [CommRing T] [AddCommGroup M]
      [Module T M] {N R : ℕ} (α : A → T) (u u' : Fin N → T) (ℓ ℓ' : Fin R → M) (c : T)
      (w D : ℕ) (v : Fin R → (Fin N → ℤ) →₀ A),
      IsUnit c → (∀ i, u i = c * u' i) →
      (∀ r, ∀ β ∈ (v r).support, ∑ i, β i = (w : ℤ) - (D : ℤ)) →
      (∀ r, ∀ β ∈ (v r).support, α (v r β) • ℓ r = α (v r β) • (c ^ D • ℓ' r)) →
      wcKlmEv α u ℓ v = c ^ w • wcKlmEv α u' ℓ' v := by
    intro A T M _ _ _ _ N R α u u' ℓ ℓ' c w D v hc hu hdeg hℓ
    obtain ⟨υ, rfl⟩ := hc
    have hfac : ∀ (x : T) (b : ℤ),
        ((υ : T) * x) ^ b.toNat * Ring.inverse ((υ : T) * x) ^ (-b).toNat
        = ((υ ^ b : Tˣ) : T) * (x ^ b.toNat * Ring.inverse x ^ (-b).toNat) := by
      intro x b
      rw [Ring.mul_inverse_rev, Ring.inverse_unit, mul_pow, mul_pow]
      have : ((υ ^ b : Tˣ) : T) = (υ : T) ^ b.toNat * ((υ⁻¹ : Tˣ) : T) ^ (-b).toNat := by
        have hb : b = (b.toNat : ℤ) - ((-b).toNat : ℤ) := (Int.toNat_sub_toNat_neg b).symm
        conv_lhs => rw [hb]
        rw [zpow_sub, zpow_natCast, zpow_natCast, ← inv_pow, Units.val_mul,
          Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
      rw [this]; ring
    have hprodz : ∀ (s : Finset (Fin N)) (f : Fin N → ℤ),
        ∏ i ∈ s, (υ ^ f i) = υ ^ (∑ i ∈ s, f i) := by
      intro s f
      induction s using Finset.induction_on with
      | empty => simp
      | insert a s ha ih => rw [Finset.prod_insert ha, Finset.sum_insert ha, ih, zpow_add]
    have hLP : ∀ β : Fin N → ℤ, wcKlmLP (fun i => (υ : T) * u' i) β =
        ((υ ^ (∑ i, β i) : Tˣ) : T) * wcKlmLP u' β := by
      intro β
      unfold wcKlmLP
      rw [Finset.prod_congr rfl (fun i _ => hfac (u' i) (β i)), Finset.prod_mul_distrib, ← hprodz,
        Units.coe_prod]
    have hu' : u = fun i => (υ : T) * u' i := funext hu
    subst hu'
    unfold wcKlmEv
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    rw [Finsupp.smul_sum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    rw [hLP β, hdeg r β hβ]
    have key : ((υ ^ ((w : ℤ) - D) : Tˣ) : T) * (υ : T) ^ D = (υ : T) ^ w := by
      rw [← Units.val_pow_eq_pow_val, ← Units.val_mul, ← zpow_natCast υ D, ← zpow_add,
        sub_add_cancel, zpow_natCast, Units.val_pow_eq_pow_val]
    calc (α (v r β) * (((υ ^ ((w : ℤ) - D) : Tˣ) : T) * wcKlmLP u' β)) • ℓ r
        = (((υ ^ ((w : ℤ) - D) : Tˣ) : T) * wcKlmLP u' β) • (α (v r β) • ℓ r) := by
          rw [mul_comm, mul_smul]
      _ = (((υ ^ ((w : ℤ) - D) : Tˣ) : T) * wcKlmLP u' β) •
            (α (v r β) • ((υ : T) ^ D • ℓ' r)) := by
          rw [hℓ r β hβ]
      _ = ((((υ ^ ((w : ℤ) - D) : Tˣ) : T) * (υ : T) ^ D) * (α (v r β) * wcKlmLP u' β)) •
            ℓ' r := by
          rw [smul_smul, smul_smul]; congr 1; ring
      _ = _ := by rw [key, mul_smul]

  have resM : ∀ (M : Z.Modules) {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro M U V W h1 h2 x
    change (M.presheaf.map (homOfLE h1).op ≫ M.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resZ : ∀ {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Z, U)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have smulM : ∀ (M : Z.Modules) {U V : Z.Opens} (h : V ≤ U) (r : Γ(Z, U)) (x : Γ(M, U)),
      (M.presheaf.map (homOfLE h).op).hom (r • x) =
      (Z.presheaf.map (homOfLE h).op).hom r • (M.presheaf.map (homOfLE h).op).hom x :=
    fun M U V h r x => Scheme.Modules.map_smul M (homOfLE h) r x
  have natψ : ∀ (p : ℕ) {U V : Z.Opens} (h : V ≤ U) (x : Γ(Gs (p + 1), U)),
      Scheme.Modules.Hom.app (ψ p) V (((Gs (p + 1)).presheaf.map (homOfLE h).op).hom x) =
      ((Gs p).presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app (ψ p) U x) :=
    fun p U V h x => NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf (ψ p)) (homOfLE h).op x
  have natg : ∀ {A B : (wcPm.{u} m).Opens} (h : B ≤ A) (x : Γ(wcPm.{u} m, A)),
      g.app B ((wcPm.{u} m).presheaf.map (homOfLE h).op x) =
      (Z.presheaf.map (homOfLE (g.preimage_mono h)).op).hom (g.app A x) := by
    intro A B h x
    exact congrArg (fun f => f.hom x) (g.naturality (homOfLE h).op)
  have sigRes : ∀ {U V : Z.Opens} (hVU : V ≤ U) (c : B),
      (Z.presheaf.map (homOfLE hVU).op).hom (wcCnSigma h U c) = wcCnSigma h V c := by
    intro U V hVU c
    unfold wcCnSigma
    simp only [RingHom.comp_apply]
    exact resZ _ _ _

  have hF1 : ∀ k, g.app (wcPmChart m k) (e k k) = 1 := by
    intro k; rw [he1, map_one]
  have hBO : ∀ k l, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l =
      Z.basicOpen (g.app (wcPmChart m k) (e k l)) := by
    intro k l
    rw [← Scheme.Hom.preimage_inf, he2, Scheme.preimage_basicOpen]
  have unitBO : ∀ {U V : Z.Opens} (f : Γ(Z, U)), V = Z.basicOpen f → ∀ (hVU : V ≤ U),
      IsUnit ((Z.presheaf.map (homOfLE hVU).op).hom f) := by
    intro U V f hV hVU
    subst hV
    exact RingedSpace.isUnit_res_basicOpen Z.toRingedSpace f
  have hunit : ∀ k l, IsUnit ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) :=
    fun k l => unitBO _ (hBO k l) _
  have hF3 : ∀ k l i, (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k i)) =
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l)) *
      (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (g.app (wcPmChart m l) (e l i)) := by
    intro k l i
    have hW : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ (wcPmChart m k ⊓ wcPmChart m l) := (Scheme.Hom.preimage_inf g).ge
    have key := congrArg (fun x => (Z.presheaf.map (homOfLE hW).op).hom
      (g.app (wcPmChart m k ⊓ wcPmChart m l) x)) (he3 k l i)
    simp only [map_mul] at key
    rw [natg, natg, natg, resZ, resZ, resZ] at key
    exact key
  have hT : ∀ k l j : Fin (m + 1),
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k j)) =
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l)) *
      (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom
          (g.app (wcPmChart m l) (e l j)) := by
    intro k l j
    have hW : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ (wcPmChart m k ⊓ wcPmChart m l) :=
      le_trans inf_le_left (Scheme.Hom.preimage_inf g).ge
    have key := congrArg (fun x => (Z.presheaf.map (homOfLE hW).op).hom
      (g.app (wcPmChart m k ⊓ wcPmChart m l) x)) (he3 k l j)
    simp only [map_mul] at key
    rw [natg, natg, natg, resZ, resZ, resZ] at key
    exact key

  have hcov : ∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : ∀ k : Fin (m + 1), IsAffineOpen (wcPmChart.{u} m k) := fun k =>
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k))
        Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
    haveI hcomp : IsAffineHom (Limits.prod.lift h g ≫ Limits.prod.snd) := inferInstance
    have hga : IsAffineHom g := by
      rw [Limits.prod.lift_snd] at hcomp
      exact hcomp
    exact fun k => (hD k).preimage g
  have hcov2 : ∀ k l, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) := by
    intro k l
    rw [hBO k l]
    exact (hcov k).basicOpen _

  have hbm : ∀ i, b i ∈ IsLocalRing.maximalIdeal B := fun i => by
    rw [← hb]; exact Ideal.subset_span ⟨i, rfl⟩
  have hprod : ∀ d : Fin r →₀ ℕ, (d.prod fun i k => b i ^ k) ∈
      IsLocalRing.maximalIdeal B ^ d.degree := by
    intro d
    have h1 := Ideal.prod_mem_prod (s := d.support)
      (I := fun i => IsLocalRing.maximalIdeal B ^ d i) (x := fun i => b i ^ d i)
      (fun i _ => Ideal.pow_mem_pow (hbm i) _)
    rw [Finset.prod_pow_eq_pow_sum] at h1
    exact h1
  have hε : ∀ (p : ℕ) (c : MvPolynomial (Fin r) B),
      wcKlmEps b p c ∈ IsLocalRing.maximalIdeal B ^ p := by
    intro p c
    unfold wcKlmEps
    rw [MvPolynomial.homogeneousComponent_apply, map_sum]
    refine Ideal.sum_mem _ (fun d hd => ?_)
    rw [MvPolynomial.eval_monomial]
    have hdeg : d.degree = p := (Finset.mem_filter.mp hd).2
    refine Ideal.mul_mem_left _ _ ?_
    rw [← hdeg]
    exact hprod d

  have swap : ∀ (k l : Fin (m + 1)) (ρ : Fin q) (p : ℕ) (c : B),
      c ∈ IsLocalRing.maximalIdeal B ^ p →
      wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) c •
        ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ p) =
      wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) c •
        (((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l))) ^ D •
        ((Gs p).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (L l ρ p)) := by
    intro k l ρ p c hc
    have hV := hcov2 k l
    obtain ⟨x, hx⟩ : ∃ x : ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l), ∀ p, x p =
        ((Gs p).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ p) -
        ((Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m k)).op).hom
          (g.app (wcPmChart m k) (e k l))) ^ D •
        ((Gs p).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (L l ρ p) := ⟨_, fun _ => rfl⟩
    have hx0 : x 0 = 0 := by
      rw [hx, sub_eq_zero]
      exact htw ρ k l
    have hxc : ∀ p, Scheme.Modules.Hom.app (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)
        (x (p + 1)) = x p := by
      intro p
      rw [hx (p + 1), hx p, map_sub, Scheme.Modules.Hom.app_smul, natψ, natψ, hL1, hL1]
    have hJ : ∀ p, x p ∈ Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
        (IsLocalRing.maximalIdeal B) • (⊤ : Submodule Γ(Z, g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l) Γ(Gs p, g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)) := by
      intro p
      induction p with
      | zero => rw [hx0]; exact Submodule.zero_mem _
      | succ p ih =>
        obtain ⟨hs, hk⟩ := hG.2.1 p _ hV
        have hmap : Submodule.map (wcCnSecLin (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
            (Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
              (IsLocalRing.maximalIdeal B) • ⊤) =
            Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
              (IsLocalRing.maximalIdeal B) • ⊤ := by
          have hr : LinearMap.range (wcCnSecLin (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓
              g ⁻¹ᵁ wcPmChart m l)) = ⊤ := LinearMap.range_eq_top.mpr (fun y => hs y)
          rw [Submodule.map_smul'', Submodule.map_top, hr]
        rw [← hmap] at ih
        obtain ⟨y, hy, hyx⟩ := ih
        have hdiff : x (p + 1) - y ∈ Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓
            g ⁻¹ᵁ wcPmChart m l)) (IsLocalRing.maximalIdeal B) • (⊤ : Submodule Γ(Z, g ⁻¹ᵁ
              wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l) Γ(Gs (p + 1), g ⁻¹ᵁ wcPmChart m k ⊓
                g ⁻¹ᵁ wcPmChart m l)) := by
          have h0 : Scheme.Modules.Hom.app (ψ p) (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)
              (x (p + 1) - y) = 0 := by
            rw [map_sub, hxc]
            exact sub_eq_zero.mpr hyx.symm
          exact Submodule.smul_mono_left (Ideal.map_mono (Ideal.pow_le_self (by omega)))
            ((hk _).mp h0)
        have := Submodule.add_mem _ hdiff hy
        rwa [sub_add_cancel] at this
    have hmem := Submodule.smul_mem_smul
      (Ideal.mem_map_of_mem (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l)) hc) (hJ p)
    rw [← Submodule.mul_smul, ← Ideal.map_mul, ← pow_succ, hG.2.2 p _ hV,
      Submodule.mem_bot, hx, smul_sub, sub_eq_zero] at hmem
    exact hmem

  have laur : ∀ (σ : Finset (Fin (m + 1))) (v : Fin q → (Fin (m + 1) → ℤ) →₀ MvPolynomial (Fin r) B),
      v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) σ →
      ∀ ρ, ∀ β ∈ (v ρ).support, ∑ i, β i = (w : ℤ) - (D : ℤ) ∧ ∀ i, i ∉ σ → 0 ≤ β i :=
    fun σ v hv ρ β hβ => (Finsupp.mem_supported _ _).mp (hv ρ) (Finset.mem_coe.mpr hβ)
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  ·
    intro k l _ v hv
    symm
    unfold wcKlmTh1 wcKlmTh2
    refine (evMap _ _ (fun t x => smulM _ _ t x) _ _ _ v ?_).trans ?_
    · intro ρ β hβ i
      obtain ⟨_, hnn⟩ := laur _ v hv ρ β hβ
      by_cases hi : i = k
      · right; subst hi; rw [hF1]; exact isUnit_one
      · left; exact hnn i (by simpa using hi)
    · simp only [sigRes]
  ·
    intro k l _ v hv
    unfold wcKlmTh1 wcKlmTh2
    rw [evMap _ ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓
      g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (fun t x => smulM _ _ t x)
      (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m l) (wcKlmEps b (n + 1) c))
      (fun i => g.app (wcPmChart m l) (e l i)) (fun ρ => L l ρ (n + 1)) v ?unitsL]
    · simp only [sigRes]
      exact evChart _ _ _ _ _ _ w D v (hunit k l) (fun i => hF3 k l i)
        (fun ρ β hβ => (laur _ v hv ρ β hβ).1)
        (fun ρ β hβ => swap k l ρ (n + 1) _ (hε _ _))
    · intro ρ β hβ i
      obtain ⟨_, hnn⟩ := laur _ v hv ρ β hβ
      by_cases hi : i = l
      · right; subst hi; dsimp only; rw [hF1]; exact isUnit_one
      · left; exact hnn i (by simpa using hi)
  ·
    intro k l j _ _ v hv
    symm
    unfold wcKlmTh2 wcKlmTh3
    refine (evMap _ _ (fun t x => smulM _ _ t x) _ _ _ v ?_).trans ?_
    · intro ρ β hβ i
      obtain ⟨_, hnn⟩ := laur _ v hv ρ β hβ
      by_cases hi : i = k
      · right; subst hi; dsimp only; rw [hF1, map_one]; exact isUnit_one
      · by_cases hi' : i = l
        · right; subst hi'; exact hunit k i
        · left; exact hnn i (by simp [hi, hi'])
    · simp only [sigRes, resZ, resM]
  ·
    intro k l j _ _ v hv
    symm
    unfold wcKlmTh2 wcKlmTh3
    refine (evMap _ _ (fun t x => smulM _ _ t x) _ _ _ v ?_).trans ?_
    · intro ρ β hβ i
      obtain ⟨_, hnn⟩ := laur _ v hv ρ β hβ
      by_cases hi : i = k
      · right; subst hi; dsimp only; rw [hF1, map_one]; exact isUnit_one
      · by_cases hi' : i = j
        · right; subst hi'; exact hunit k i
        · left; exact hnn i (by simp [hi, hi'])
    · simp only [sigRes, resZ, resM]
  ·
    intro k l j _ _ v hv
    unfold wcKlmTh2 wcKlmTh3
    have hμ : IsUnit ((Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
        g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
        g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) := by
      have := (hunit k l).map (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l)).op).hom
      rwa [resZ] at this
    have swap3 : ∀ (ρ : Fin q) (c : B), c ∈ IsLocalRing.maximalIdeal B ^ (n + 1) →
        wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j) c •
          ((Gs (n + 1)).presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
            g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
            g ⁻¹ᵁ wcPmChart m k)).op).hom (L k ρ (n + 1)) =
        wcCnSigma h (g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j) c •
          (((Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
            g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
            g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l))) ^ D •
          ((Gs (n + 1)).presheaf.map (homOfLE (le_trans inf_le_left inf_le_right :
            g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
            g ⁻¹ᵁ wcPmChart m l)).op).hom (L l ρ (n + 1))) := by
      intro ρ c hc
      have := congrArg ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k ⊓
        g ⁻¹ᵁ wcPmChart m l)).op).hom (swap k l ρ (n + 1) c hc)
      simp only [smulM, map_pow, resM, resZ, sigRes] at this
      exact this
    rw [evMap _ ((Gs (n + 1)).presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right)
          inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom (fun t x => smulM _ _ t x)
      (fun c => wcCnSigma h (g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j) (wcKlmEps b (n + 1) c))
      (fun i => (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓
        g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (g.app (wcPmChart m l) (e l i)))
      (fun ρ => ((Gs (n + 1)).presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m l ⊓
        g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m l)).op).hom (L l ρ (n + 1))) v ?unitsLJ]
    · simp only [sigRes, resZ, resM]
      have hT' : ∀ i, (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k i)) =
          (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_left :
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m k)).op).hom (g.app (wcPmChart m k) (e k l)) *
          (Z.presheaf.map (homOfLE (le_trans inf_le_left inf_le_right :
          g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤
          g ⁻¹ᵁ wcPmChart m l)).op).hom (g.app (wcPmChart m l) (e l i)) := by
        intro i
        have := congrArg (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m k ⊓
          g ⁻¹ᵁ wcPmChart m l)).op).hom (hF3 k l i)
        rw [map_mul, resZ, resZ, resZ] at this
        exact this
      exact evChart _ _ _ _ _ _ w D v hμ (fun i => hT' i)
        (fun ρ β hβ => (laur _ v hv ρ β hβ).1)
        (fun ρ β hβ => swap3 ρ _ (hε _ _))
    · intro ρ β hβ i
      obtain ⟨_, hnn⟩ := laur _ v hv ρ β hβ
      by_cases hi : i = l
      · right; subst hi; dsimp only; rw [hF1, map_one]; exact isUnit_one
      · by_cases hi' : i = j
        · right; subst hi'; exact hunit l i
        · left; exact hnn i (by simp [hi, hi'])

theorem wc_cn_kernel_laurent_model : ∀ (B : Type u) [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m : ℕ) (g : Z ⟶ wcPm.{u} m),
    IsClosedImmersion (Limits.prod.lift h g) →
    ∀ e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k), (∀ k, e k k = 1) →
    (∀ k l, wcPmChart m k ⊓ wcPmChart m l = (wcPm.{u} m).basicOpen (e k l)) →
    (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k j) =
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m k)).op (e k l) *
      (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤
        wcPmChart m l)).op (e l j)) →
    (∀ k (s : Γ(wcPm.{u} m, wcPmChart m k)), ∃ p : MvPolynomial (Fin (m + 1)) ℤ,
      MvPolynomial.eval₂ (Int.castRingHom _) (e k) p = s) →
    ∀ (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Gs ψ →
    ∀ (D q : ℕ) (s : Fin q → ∀ k, Γ(Gs 0, g ⁻¹ᵁ wcPmChart m k)),
    (∀ ρ, wcCnTwisted g e (Gs 0) D (s ρ)) →
    (∀ k, Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k) (Set.range fun ρ => s ρ k) = ⊤) →
    ∃ (A : Type u) (_ : CommRing A) (_ : IsNoetherianRing A) (R : ℕ) (d : Fin R → ℕ)
      (K : Submodule (MvPolynomial (Fin (m + 1)) A) (Fin R → MvPolynomial (Fin (m + 1)) A)),
      (∀ f ∈ K, ∀ t : ℕ, (fun r => if d r ≤ t then
        MvPolynomial.homogeneousComponent (t - d r) (f r) else 0) ∈ K) ∧
      ∀ n : ℕ, ∃ (H : AddSubgroup (Fin R → (Fin (m + 1) → ℤ) →₀ A))
        (Θ1 : ∀ k : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) →
          Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k))
        (Θ2 : ∀ k l : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) →
          Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l))
        (Θ3 : ∀ k l j : Fin (m + 1), (Fin R → (Fin (m + 1) → ℤ) →₀ A) →
          Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ⊓ g ⁻¹ᵁ wcPmChart m j)),
        ∀ w : ℕ, wcCnUtlModel g e (ψ n) A R d K H Θ1 Θ2 Θ3 w :=
by
  intro B _ _ _ Z h m g hg e he1 he2 he3 he4 Gs ψ hG D q s hs hspan
  classical

  obtain ⟨r, b, hb⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal B))
  have hb' : Ideal.span (Set.range b) = IsLocalRing.maximalIdeal B := hb
  have hbm : ∀ i, b i ∈ IsLocalRing.maximalIdeal B := fun i => by
    rw [← hb']; exact Ideal.subset_span ⟨i, rfl⟩

  have hcov : ∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k) := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    have hD : ∀ k : Fin (m + 1), IsAffineOpen (wcPmChart.{u} m k) := fun k =>
      Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) (m := 1)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k))
        Nat.one_pos
    haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasBinaryProduct' (Spec (.of B)) (wcPm.{u} m))
        (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of B))))
    haveI hcomp : IsAffineHom (Limits.prod.lift h g ≫ Limits.prod.snd) := inferInstance
    have hga : IsAffineHom g := by
      rw [Limits.prod.lift_snd] at hcomp
      exact hcomp
    exact fun k => (hD k).preimage g

  have hsurj : ∀ (k : Fin (m + 1)) (p : ℕ) (x : Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)),
      ∃ y : Γ(Gs (p + 1), g ⁻¹ᵁ wcPmChart m k),
        Scheme.Modules.Hom.app (ψ p) (g ⁻¹ᵁ wcPmChart m k) y = x :=
    fun k p x => (hG.2.1 p _ (hcov k)).1 x
  choose lift hlift using hsurj
  obtain ⟨L, hL0, hL1⟩ : ∃ L : ∀ k : Fin (m + 1), Fin q → ∀ p, Γ(Gs p, g ⁻¹ᵁ wcPmChart m k),
      (∀ k ρ, L k ρ 0 = s ρ k) ∧
      ∀ k ρ p, Scheme.Modules.Hom.app (ψ p) (g ⁻¹ᵁ wcPmChart m k) (L k ρ (p + 1)) = L k ρ p :=
    ⟨fun k ρ p => Nat.rec (motive := fun p => Γ(Gs p, g ⁻¹ᵁ wcPmChart m k)) (s ρ k)
      (fun p x => lift k p x) p, fun _ _ => rfl, fun k ρ p => hlift k p _⟩
  have hHyp : wcKlmHyp h g e b Gs ψ D L := by
    refine ⟨hg, he1, he2, he3, he4, hG, hb', fun ρ => ?_, fun k => ?_, hL1⟩
    · have e0 : (fun k => L k ρ 0) = s ρ := funext fun k => hL0 k ρ
      rw [e0]; exact hs ρ
    · have e0 : (fun ρ => L k ρ 0) = fun ρ => s ρ k := funext fun ρ => hL0 k ρ
      rw [e0]; exact hspan k

  have hprod : ∀ d : Fin r →₀ ℕ, (d.prod fun i k => b i ^ k) ∈
      IsLocalRing.maximalIdeal B ^ d.degree := by
    intro d
    have h1 := Ideal.prod_mem_prod (s := d.support)
      (I := fun i => IsLocalRing.maximalIdeal B ^ d i) (x := fun i => b i ^ d i)
      (fun i _ => Ideal.pow_mem_pow (hbm i) _)
    rw [Finset.prod_pow_eq_pow_sum] at h1
    exact h1
  have hε : ∀ (p : ℕ) (c : MvPolynomial (Fin r) B),
      wcKlmEps b p c ∈ IsLocalRing.maximalIdeal B ^ p := by
    intro p c
    unfold wcKlmEps
    rw [MvPolynomial.homogeneousComponent_apply, map_sum]
    refine Ideal.sum_mem _ (fun d hd => ?_)
    rw [MvPolynomial.eval_monomial]
    have hdeg : d.degree = p := (Finset.mem_filter.mp hd).2
    refine Ideal.mul_mem_left _ _ ?_
    rw [← hdeg]
    exact hprod d
  refine ⟨MvPolynomial (Fin r) B, inferInstance, inferInstance, q, fun _ => D,
    wcKlmK h g e b Gs L, ?_, fun n => ⟨wcKlmH B r q (m + 1) (n + 1),
      wcKlmTh1 h g e b Gs L (n + 1), wcKlmTh2 h g e b Gs L (n + 1),
      wcKlmTh3 h g e b Gs L (n + 1), fun w => ?_⟩⟩
  ·
    intro f hf t
    obtain ⟨n', c, g', rfl⟩ := Submodule.mem_span_set'.mp hf
    have hdeg : ∀ i, ∃ dd : ℕ, ∀ ρ, ((g' i : Fin q → MvPolynomial (Fin (m + 1))
        (MvPolynomial (Fin r) B)) ρ).IsHomogeneous dd := fun i => (g' i).2.1
    choose dg hdg using hdeg
    have key := wc_gc_graded_kernel_hc (MvPolynomial (Fin r) B) (m + 1) q n' (fun _ => D)
      (fun i => dg i + D) (fun i => (g' i : Fin q → MvPolynomial (Fin (m + 1))
        (MvPolynomial (Fin r) B)))
      (fun i ρ => by
        show ((g' i : Fin q → MvPolynomial (Fin (m + 1)) (MvPolynomial (Fin r) B)) ρ).IsHomogeneous
          (dg i + D - D)
        rw [Nat.add_sub_cancel]; exact hdg i ρ)
      (fun i ρ hlt => absurd hlt (by show ¬ (dg i + D < D); omega)) c t
    refine (congrArg (· ∈ wcKlmK h g e b Gs L) key).mpr ?_
    exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span (g' i).2))
  ·
    have evAdd : ∀ (V : Z.Opens) (u : Fin (m + 1) → Γ(Z, V)) (ℓ : Fin q → Γ(Gs (n + 1), V))
        (v v' : Fin q → (Fin (m + 1) → ℤ) →₀ MvPolynomial (Fin r) B),
        wcKlmEv (fun c => wcCnSigma h V (wcKlmEps b (n + 1) c)) u ℓ (v + v') =
          wcKlmEv (fun c => wcCnSigma h V (wcKlmEps b (n + 1) c)) u ℓ v +
          wcKlmEv (fun c => wcCnSigma h V (wcKlmEps b (n + 1) c)) u ℓ v' := by
      intro V u ℓ v v'
      unfold wcKlmEv
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun ρ _ => ?_)
      rw [Pi.add_apply]
      apply Finsupp.sum_add_index'
      · intro β; simp [wcKlmEps]
      · intro β c1 c2; simp only [wcKlmEps, map_add, add_mul, add_smul]
    have T2 : ∀ k, ∀ v ∈ wcLaurC (MvPolynomial (Fin r) B) (m + 1) q (fun _ => D) (w : ℤ) {k},
        Scheme.Modules.Hom.app (ψ n) (g ⁻¹ᵁ wcPmChart m k)
          (wcKlmTh1 h g e b Gs L (n + 1) k v) = 0 := by
      intro k v _
      apply ((hG.2.1 n _ (hcov k)).2 _).mpr
      unfold wcKlmTh1 wcKlmEv
      refine Submodule.sum_mem _ (fun ρ _ => ?_)
      unfold Finsupp.sum
      refine Submodule.sum_mem _ (fun β _ => ?_)
      dsimp only
      rw [mul_smul]
      exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ (hε _ _)) Submodule.mem_top
    obtain ⟨t1, t2, t3, t4, t5⟩ := wc_cn_klm_T6 B Z h m r q g e b Gs ψ D L hHyp n w
    exact ⟨fun k v v' => evAdd _ _ _ v v', fun k l v v' => evAdd _ _ _ v v',
      fun k l j v v' => evAdd _ _ _ v v', T2,
      fun k l hkl c hc => wc_cn_klm_T3 B Z h m r q g e b Gs ψ D L hHyp n w k l hkl c hc,
      fun k l hkl v hv => wc_cn_klm_T4 B Z h m r q g e b Gs ψ D L hHyp n w k l hkl v hv,
      fun k l j hkl hlj v hv hv' hv'' =>
        wc_cn_klm_T5 B Z h m r q g e b Gs ψ D L hHyp n w k l j hkl hlj v hv hv' hv'',
      t1, t2, t3, t4, t5⟩

theorem wc_cn_lsv_free_vanishing : ∀ (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ) (p : ℕ) (w : ℤ), (∀ r, (d r : ℤ) < w + n) → (∀ (z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (i0 : Fin n) (s : Finset (Fin n)), wcAltD (A := A) n (fun ρ => if i0 ∈ ρ then 0 else ((-1 : A) ^ (ρ.filter (· < i0)).card) • z (insert i0 ρ)) s + (if i0 ∈ s then 0 else ((-1 : A) ^ (s.filter (· < i0)).card) • wcAltD (A := A) n z (insert i0 s)) = z s) → (∀ (z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (τ : Finset (Fin n)), wcAltD (A := A) n (wcAltD (A := A) n z) τ = 0) → (∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) → (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ = 0) → ∃ y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧ (p = 0 → y = 0) ∧ ∀ σ : Finset (Fin n), σ.card = p + 1 → ∀ r, ∀ β ∈ (z σ r - wcAltD (A := A) n y σ r).support, ∑ i, β i = w - d r ∧ ((∀ i, 0 ≤ β i) ∨ (∀ i, β i < 0))) → ∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) → (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ = 0) → ∃ y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧ ∀ σ : Finset (Fin n), σ.card = p + 1 → z σ - wcAltD (A := A) n y σ = 0 :=
by
  intro A _ n R d p w hb hcone hD hbox z hz hcoc

  have dsub : ∀ (a b : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (τ : Finset (Fin n)),
      wcAltD (A := A) n (fun σ => a σ - b σ) τ =
        wcAltD (A := A) n a τ - wcAltD (A := A) n b τ := by
    intro a b τ
    simp only [wcAltD, smul_sub, Finset.sum_sub_distrib]
  have dadd : ∀ (a b : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (τ : Finset (Fin n)),
      wcAltD (A := A) n (fun σ => a σ + b σ) τ =
        wcAltD (A := A) n a τ + wcAltD (A := A) n b τ := by
    intro a b τ
    simp only [wcAltD, smul_add, Finset.sum_add_distrib]

  have dconc : ∀ (c : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (q : ℕ),
      (∀ σ : Finset (Fin n), σ.card ≠ q → c σ = 0) →
      ∀ τ : Finset (Fin n), τ.card ≠ q + 1 → wcAltD (A := A) n c τ = 0 := by
    intro c q hc τ hτ
    unfold wcAltD
    apply Finset.sum_eq_zero
    intro i hi
    have h1 := Finset.card_erase_of_mem hi
    have h2 : 0 < τ.card := Finset.card_pos.mpr ⟨i, hi⟩
    rw [hc (τ.erase i) (by omega), smul_zero]

  obtain ⟨y₁, hy₁, -, hbx⟩ := hbox z hz hcoc
  obtain ⟨x, hxdef⟩ : ∃ x : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
      x = fun σ => z σ - wcAltD (A := A) n y₁ σ := ⟨_, rfl⟩
  have hxσ : ∀ σ, x σ = z σ - wcAltD (A := A) n y₁ σ := fun σ => by rw [hxdef]

  have hpos : ∀ σ : Finset (Fin n), σ.card = p + 1 → ∀ r, ∀ β ∈ (x σ r).support,
      ∑ i, β i = w - d r ∧ ∀ i, 0 ≤ β i := by
    intro σ hσ r β hβ
    rw [hxσ σ, Pi.sub_apply] at hβ
    obtain ⟨hsum, hdis⟩ := hbx σ hσ r β hβ
    refine ⟨hsum, ?_⟩
    rcases hdis with h | h
    · exact h
    · exfalso
      have hle : ∑ i, β i ≤ ∑ _i : Fin n, (-1 : ℤ) :=
        Finset.sum_le_sum (fun i _ => by have := h i; omega)
      have hc : ∑ _i : Fin n, (-1 : ℤ) = -(n : ℤ) := by
        simp [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
      have := hb r
      linarith

  have hx0 : ∀ σ : Finset (Fin n), σ.card ≠ p + 1 → x σ = 0 := by
    intro σ hσ
    rw [hxσ σ, (hz σ).2 hσ, dconc y₁ p (fun σ' h => (hy₁ σ').2 h) σ hσ, sub_zero]

  have hxcoc : ∀ τ, wcAltD (A := A) n x τ = 0 := by
    intro τ
    rw [hxdef, dsub z (wcAltD (A := A) n y₁) τ, hD y₁ τ, sub_zero]
    by_cases hτ : τ.card = p + 2
    · exact hcoc τ hτ
    · exact dconc z (p + 1) (fun σ' h => (hz σ').2 h) τ (by omega)

  rcases Nat.eq_zero_or_pos n with hn | hn
  · refine ⟨0, fun σ => ⟨fun _ => ?_, fun _ => rfl⟩, fun σ hσ => ?_⟩
    · rw [wcLaurC, Set.mem_setOf_eq]
      intro r
      exact Submodule.zero_mem _
    · exfalso
      have h1 := Finset.card_le_univ σ
      rw [Fintype.card_fin] at h1
      omega
  · have i0 : Fin n := ⟨0, hn⟩
    obtain ⟨H, hHdef⟩ : ∃ H : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
        H = fun ρ => if i0 ∈ ρ then 0 else
          ((-1 : A) ^ (ρ.filter (· < i0)).card) • x (insert i0 ρ) := ⟨_, rfl⟩
    have hδH : ∀ s, wcAltD (A := A) n H s = x s := by
      intro s
      have hc := hcone x i0 s
      rw [hxcoc, smul_zero, ite_self, add_zero] at hc
      rw [hHdef]
      exact hc

    have hHshape : ∀ ρ : Finset (Fin n),
        (ρ.card = p → H ρ ∈ wcLaurC A n R d w ρ) ∧ (ρ.card ≠ p → H ρ = 0) := by
      intro ρ
      by_cases hi : i0 ∈ ρ
      · have h0 : H ρ = 0 := by rw [hHdef]; simp only [if_pos hi]
        refine ⟨fun _ => ?_, fun _ => h0⟩
        rw [h0, wcLaurC, Set.mem_setOf_eq]
        intro r
        exact Submodule.zero_mem _
      · have hH : H ρ = ((-1 : A) ^ (ρ.filter (· < i0)).card) • x (insert i0 ρ) := by
          rw [hHdef]; simp only [if_neg hi]
        have hcard := Finset.card_insert_of_notMem hi
        refine ⟨fun hρ => ?_, fun hρ => ?_⟩
        · rw [hH, wcLaurC, Set.mem_setOf_eq]
          intro r
          rw [Pi.smul_apply]
          apply Submodule.smul_mem
          rw [Finsupp.mem_supported]
          intro β hβ
          obtain ⟨hs, hnn⟩ := hpos (insert i0 ρ) (by omega) r β hβ
          simp only [Set.mem_setOf_eq]
          exact ⟨hs, fun i _ => hnn i⟩
        · rw [hH, hx0 (insert i0 ρ) (by omega), smul_zero]

    refine ⟨fun σ => y₁ σ + H σ, fun σ => ⟨fun hσ => ?_, fun hσ => ?_⟩, fun σ hσ => ?_⟩
    · have h1 := (hy₁ σ).1 hσ
      have h2 := (hHshape σ).1 hσ
      rw [wcLaurC, Set.mem_setOf_eq] at h1 h2 ⊢
      intro r
      show y₁ σ r + H σ r ∈ _
      exact Submodule.add_mem _ (h1 r) (h2 r)
    · show y₁ σ + H σ = 0
      rw [(hy₁ σ).2 hσ, (hHshape σ).2 hσ, add_zero]
    · rw [dadd y₁ H σ, hδH σ, hxσ σ]
      abel

theorem wc_cn_lsv_step : ∀ (A : Type u) [CommRing A] (n R R' : ℕ) (d : Fin R → ℕ) (d' : Fin R' → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (K' : Submodule (MvPolynomial (Fin n) A) (Fin R' → MvPolynomial (Fin n) A)) (Φ : (Fin R' → (Fin n → ℤ) →₀ A) →ₗ[A] (Fin R → (Fin n → ℤ) →₀ A)) (p : ℕ) (w : ℤ), (∀ (z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (τ : Finset (Fin n)), wcAltD (A := A) n (wcAltD (A := A) n z) τ = 0) → (∀ σ, ∀ x ∈ wcLaurK A n R d K w σ, x ∈ wcLaurC A n R d w σ) → (∀ σ, ∀ v ∈ wcLaurC A n R' d' w σ, Φ v ∈ wcLaurK A n R d K w σ) → (∀ σ, ∀ x ∈ wcLaurK A n R d K w σ, ∃ v ∈ wcLaurC A n R' d' w σ, Φ v = x) → (∀ σ, ∀ v ∈ wcLaurC A n R' d' w σ, Φ v = 0 → v ∈ wcLaurK A n R' d' K' w σ) → (∀ σ, ∀ v ∈ wcLaurK A n R' d' K' w σ, Φ v = 0) → wcCnUtlVan A n R' d' K' (p + 1) w → (∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) → (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ = 0) → ∃ y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧ ∀ σ : Finset (Fin n), σ.card = p + 1 → z σ - wcAltD (A := A) n y σ = 0) → wcCnUtlVan A n R d K p w :=
by
  classical
  intro A _ n R R' d d' K K' Φ p w H2 H3 Hin Hsurj Hker Hker' IH Free
  unfold wcCnUtlVan at IH ⊢
  have dsub : ∀ {V : Type u} [AddCommGroup V] [Module A V] (z₁ z₂ : Finset (Fin n) → V)
      (τ : Finset (Fin n)), wcAltD (A := A) n (fun σ => z₁ σ - z₂ σ) τ =
        wcAltD (A := A) n z₁ τ - wcAltD (A := A) n z₂ τ := by
    intro V _ _ z₁ z₂ τ
    simp only [wcAltD, smul_sub, Finset.sum_sub_distrib]
  have dmap : ∀ {V W : Type u} [AddCommGroup V] [Module A V] [AddCommGroup W] [Module A W]
      (f : V →ₗ[A] W) (z : Finset (Fin n) → V) (τ : Finset (Fin n)),
      wcAltD (A := A) n (fun σ => f (z σ)) τ = f (wcAltD (A := A) n z τ) := by
    intro V W _ _ _ _ f z τ
    simp only [wcAltD, map_sum, map_smul]
  have dsupp : ∀ {V : Type u} [AddCommGroup V] [Module A V] (q : ℕ) (z : Finset (Fin n) → V),
      (∀ σ : Finset (Fin n), σ.card ≠ q + 1 → z σ = 0) →
      ∀ τ : Finset (Fin n), τ.card ≠ q + 2 → wcAltD (A := A) n z τ = 0 := by
    intro V _ _ q z hz τ hτ
    apply Finset.sum_eq_zero
    intro i hi
    have hpos := Finset.card_pos.mpr ⟨i, hi⟩
    rw [hz (τ.erase i) (by rw [Finset.card_erase_of_mem hi]; omega), smul_zero]
  have hPex : ∀ (R₀ : ℕ) (d₀ : Fin R₀ → ℕ) (σ : Finset (Fin n)),
      ∃ P : Submodule A (Fin R₀ → (Fin n → ℤ) →₀ A), ∀ v, v ∈ P ↔ v ∈ wcLaurC A n R₀ d₀ w σ := by
    intro R₀ d₀ σ
    refine ⟨Submodule.pi Set.univ (fun r => Finsupp.supported A A
      {β : Fin n → ℤ | ∑ i, β i = w - d₀ r ∧ ∀ i, i ∉ σ → 0 ≤ β i}), fun v => ?_⟩
    simp only [Submodule.mem_pi, Set.mem_univ, true_implies]
    exact Iff.rfl
  have hmono : ∀ (R₀ : ℕ) (d₀ : Fin R₀ → ℕ) (σ σ' : Finset (Fin n)), σ ⊆ σ' →
      ∀ v ∈ wcLaurC A n R₀ d₀ w σ, v ∈ wcLaurC A n R₀ d₀ w σ' := by
    intro R₀ d₀ σ σ' hss v hv r
    refine Finsupp.supported_mono ?_ (hv r)
    rintro β ⟨h1, h2⟩
    exact ⟨h1, fun i hi => h2 i (fun h => hi (hss h))⟩
  intro z hz hcoc

  have hlift : ∀ τ : Finset (Fin n), ∃ v : Fin R' → (Fin n → ℤ) →₀ A,
      (τ.card = p + 2 → v ∈ wcLaurC A n R' d' w τ) ∧ Φ v = wcAltD (A := A) n z τ ∧
        (τ.card ≠ p + 2 → v = 0) := by
    intro τ
    by_cases hτ : τ.card = p + 2
    · obtain ⟨v, hv, hΦ⟩ := Hsurj τ _ (hcoc τ hτ)
      exact ⟨v, fun _ => hv, hΦ, fun h => absurd hτ h⟩
    · refine ⟨0, fun h => absurd h hτ, ?_, fun _ => rfl⟩
      rw [map_zero, dsupp p z (fun σ hσ => (hz σ).2 hσ) τ hτ]
  choose u hu1 hΦu hu0 using hlift
  have hu : ∀ σ, (σ.card = p + 1 + 1 → u σ ∈ wcLaurC A n R' d' w σ) ∧
      (σ.card ≠ p + 1 + 1 → u σ = 0) :=
    fun σ => ⟨fun h => hu1 σ (by omega), fun h => hu0 σ (by omega)⟩
  have hucoc : ∀ ρ : Finset (Fin n), ρ.card = p + 1 + 2 →
      wcAltD (A := A) n u ρ ∈ wcLaurK A n R' d' K' w ρ := by
    intro ρ hρ
    refine Hker ρ _ ?_ ?_
    · obtain ⟨P, hP⟩ := hPex R' d' ρ
      apply (hP _).mp
      simp only [wcAltD]
      apply Submodule.sum_mem
      intro i hi
      apply Submodule.smul_mem
      apply (hP _).mpr
      have hc : (ρ.erase i).card = p + 2 := by rw [Finset.card_erase_of_mem hi]; omega
      exact hmono R' d' _ _ (Finset.erase_subset i ρ) _ (hu1 _ hc)
    · rw [← dmap Φ u ρ, show (fun σ => Φ (u σ)) = wcAltD (A := A) n z from funext hΦu, H2]
  obtain ⟨y', hy', hκ⟩ := IH u hu hucoc

  obtain ⟨x, hxdef⟩ : ∃ x : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
      ∀ σ, x σ = z σ - Φ (y' σ) := ⟨_, fun σ => rfl⟩
  have hx : ∀ σ, (σ.card = p + 1 → x σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → x σ = 0) := by
    intro σ
    constructor
    · intro hσ
      obtain ⟨P, hP⟩ := hPex R d σ
      rw [hxdef]
      apply (hP _).mp
      exact sub_mem ((hP _).mpr ((hz σ).1 hσ))
        ((hP _).mpr (H3 σ _ (Hin σ _ ((hy' σ).1 hσ))))
    · intro hσ
      rw [hxdef, (hz σ).2 hσ, (hy' σ).2 hσ, map_zero, sub_zero]
  have hxc : ∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n x τ = 0 := by
    intro τ hτ
    have ex : x = fun σ => z σ - Φ (y' σ) := funext hxdef
    rw [ex, dsub z (fun σ => Φ (y' σ)) τ, dmap Φ y' τ, ← hΦu τ, ← map_sub]
    exact Hker' τ _ (hκ τ (by omega))
  obtain ⟨y, hy, hrel⟩ := Free x hx hxc
  refine ⟨y, hy, fun σ hσ => ?_⟩
  have h1 := hrel σ hσ
  rw [hxdef] at h1
  have e : z σ - wcAltD (A := A) n y σ = Φ (y' σ) := by
    rw [← sub_eq_zero]
    rw [show z σ - wcAltD (A := A) n y σ - Φ (y' σ) =
      z σ - Φ (y' σ) - wcAltD (A := A) n y σ by abel]
    exact h1
  rw [e]
  exact Hin σ _ ((hy' σ).1 hσ)

theorem wc_cn_laurent_serre_vanishing : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A]
    (n R : ℕ) (d : Fin R → ℕ)
    (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)),
    (∀ f ∈ K, ∀ t : ℕ, (fun r => if d r ≤ t then
      MvPolynomial.homogeneousComponent (t - d r) (f r) else 0) ∈ K) →
    ∀ p : ℕ, 1 ≤ p → ∃ w₀ : ℤ, ∀ w : ℤ, w₀ ≤ w → wcCnUtlVan A n R d K p w :=
by
  classical
  intro A _ _ n

  have hbase : ∀ (p : ℕ), n ≤ p → ∀ (R : ℕ) (d : Fin R → ℕ)
      (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (w : ℤ),
      wcCnUtlVan A n R d K p w := by
    intro p hp R d K w z _ _
    refine ⟨0, fun σ => ⟨fun _ => ?_, fun _ => rfl⟩, fun σ hσ => ?_⟩
    · intro r
      exact Submodule.zero_mem _
    · exfalso
      have h1 := Finset.card_le_univ σ
      rw [Fintype.card_fin] at h1
      omega

  have Q : ∀ m : ℕ, ∀ p, n ≤ p + m → ∀ (R : ℕ) (d : Fin R → ℕ)
      (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)),
      (∀ f ∈ K, ∀ t : ℕ, (fun r => if d r ≤ t then
        MvPolynomial.homogeneousComponent (t - d r) (f r) else 0) ∈ K) →
      ∃ w₀ : ℤ, ∀ w : ℤ, w₀ ≤ w → wcCnUtlVan A n R d K p w := by
    intro m
    induction m with
    | zero =>
      intro p hp R d K _
      exact ⟨0, fun w _ => hbase p (by omega) R d K w⟩
    | succ m ih =>
      intro p hp R d K hK
      obtain ⟨R', d', g, hg1, hg2, hg3, hg4⟩ := wc_gc_graded_presentation A n R d K hK
      have h7 := wc_gc_graded_kernel_hc A n R R' d d' g hg1 hg2
      have hK' : ∀ f ∈ LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g),
          ∀ t : ℕ, (fun j => if d' j ≤ t then
            MvPolynomial.homogeneousComponent (t - d' j) (f j) else 0) ∈
            LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g) := by
        intro f hf t
        simp only [LinearMap.mem_ker, Fintype.linearCombination_apply] at hf ⊢
        rw [← h7 f t, hf]
        funext r
        simp
      obtain ⟨w₁, hw₁⟩ := ih (p + 1) (by omega) R' d' _ hK'
      refine ⟨max w₁ ((∑ r, (d r : ℤ)) - n + 1), fun w hw => ?_⟩
      have hw1 : w₁ ≤ w := le_trans (le_max_left _ _) hw
      have hw2 : (∑ r, (d r : ℤ)) - n + 1 ≤ w := le_trans (le_max_right _ _) hw
      have hb : ∀ r, (d r : ℤ) < w + n := by
        intro r
        have hle : (d r : ℤ) ≤ ∑ r', (d r' : ℤ) :=
          Finset.single_le_sum (f := fun r' => (d r' : ℤ))
            (fun i _ => Int.natCast_nonneg (d i)) (Finset.mem_univ r)
        linarith
      have hex := fun σ => wc_gc_phi_exact A n R R' d d' K g (wc_gc_laur_mul A n)
        (wc_gc_laur_add_inj A n) (wc_gc_laur_repr A n R') hg1 hg2 hg3 hg4 h7 w σ
      exact wc_cn_lsv_step A n R R' d d' K
        (LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g)) _ p w
        (wc_gc_altD_sq_zero A (Fin R → (Fin n → ℤ) →₀ A) n)
        (wc_gc_laurK_sub_laurC A n R d K w)
        (fun σ => (hex σ).1) (fun σ => (hex σ).2.1) (fun σ => (hex σ).2.2.1)
        (fun σ => (hex σ).2.2.2)
        (hw₁ w hw1)
        (wc_cn_lsv_free_vanishing A n R d p w hb
          (wc_gc_cone_identity A (Fin R → (Fin n → ℤ) →₀ A) n)
          (wc_gc_altD_sq_zero A (Fin R → (Fin n → ℤ) →₀ A) n)
          (wc_gc_free_reduce_box A n R d p w
            (wc_gc_cone_identity A (Fin R → (Fin n → ℤ) →₀ A) n)))
  intro R d K hK p _
  exact Q n p (by omega) R d K hK

theorem wc_cn_uniform_twisted_lift : wcCnUnifLift.{u} :=
by
  intro B _ _ _ Z h m g hg e he1 he2 he3 he4 Gs ψ hG
  have hcov := (wc_pm_chart_cover B Z h m g hg).1
  obtain ⟨D, q, s, hs, hspan⟩ := wc_cn_twisted_generation B Z h m g hg e he1 he2 he3 (Gs 0)
    (hG.1 0).1 (fun k => (hG.1 0).2 _ (hcov k))
  obtain ⟨A, _, _, R, d, K, hK, hmodel⟩ :=
    wc_cn_kernel_laurent_model B Z h m g hg e he1 he2 he3 he4 Gs ψ hG D q s hs hspan
  obtain ⟨w₀, hw₀⟩ := wc_cn_laurent_serre_vanishing A (m + 1) R d K hK 1 le_rfl
  refine ⟨w₀.toNat, fun d' hd' n s₀ hs₀ => ?_⟩
  obtain ⟨H, Θ1, Θ2, Θ3, hΘ⟩ := hmodel n
  have hle : w₀ ≤ (d' : ℤ) := le_trans (Int.self_le_toNat w₀) (by exact_mod_cast hd')
  have hh1 := wc_cn_utl_h1_of_laurent g e he1 he3 (ψ n) d' A R d K H Θ1 Θ2 Θ3 (hΘ d')
    (hw₀ _ hle)
  exact wc_cn_utl_lift_of_h1 g e he3 (ψ n) d' (fun k => (hG.2.1 n _ (hcov k)).1) hh1 s₀ hs₀

theorem wc_cn_twist_sheaf : ∀ (Z : Scheme.{u}) (m : ℕ) (g : Z ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), (∀ k, e k k = 1) → (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k j) = (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k l) * (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m l)).op (e l j)) → ∀ (d t : ℕ), ∃ (L : Z.Modules) (ε : Fin t → ∀ k : Fin (m + 1), Γ(L, g ⁻¹ᵁ wcPmChart m k)), (∀ i, wcCnTwisted g e L d (ε i)) ∧ ∀ (k : Fin (m + 1)) (V : Z.Opens) (hV : V ≤ g ⁻¹ᵁ wcPmChart m k), Function.Bijective (fun a : Fin t → Γ(Z, V) => ∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε i k)) :=
by
  intro Z m g e he1 he3 d t
  classical
  have resZ : ∀ {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Z, A)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have resId : ∀ {A : Z.Opens} (h : A ≤ A) (x : Γ(Z, A)),
      (Z.presheaf.map (homOfLE h).op).hom x = x := by
    intro A h x
    change (Z.presheaf.map (𝟙 (Opposite.op A))).hom x = x
    rw [CategoryTheory.Functor.map_id]
    rfl

  have s2 : ∀ (n t : ℕ) (U : Fin n → Z.Opens) (c : ∀ l j : Fin n, Γ(Z, U l)), ∃ (L : Z.Modules) (π : ∀ V : Z.Opens, Γ(L, V) → Fin t → ∀ j : Fin n, Γ(Z, V ⊓ U j)), (∀ (V : Z.Opens) (x y : Γ(L, V)), π V x = π V y → x = y) ∧ (∀ (V : Z.Opens) (y : Fin t → ∀ j : Fin n, Γ(Z, V ⊓ U j)), (∃ x : Γ(L, V), π V x = y) ↔ ∀ (i : Fin t) (j l : Fin n), (Z.presheaf.map (homOfLE (inf_le_left : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U j)).op).hom (y i j) = (Z.presheaf.map (homOfLE (le_trans inf_le_right inf_le_right : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ U l)).op).hom (c l j) * (Z.presheaf.map (homOfLE (inf_le_right : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U l)).op).hom (y i l)) ∧ (∀ (V : Z.Opens) (x x' : Γ(L, V)) (i : Fin t) (j : Fin n), π V (x + x') i j = π V x i j + π V x' i j) ∧ (∀ (V : Z.Opens) (r : Γ(Z, V)) (x : Γ(L, V)) (i : Fin t) (j : Fin n), π V (r • x) i j = (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * π V x i j) ∧ (∀ (V W : Z.Opens) (h : W ≤ V) (x : Γ(L, V)) (i : Fin t) (j : Fin n), π W ((L.presheaf.map (homOfLE h).op).hom x) i j = (Z.presheaf.map (homOfLE (inf_le_inf_right (U j) h)).op).hom (π V x i j)) := by
    intro n t U c
    let S : ∀ V : Z.Opens, AddSubgroup (Fin t → ∀ j : Fin n, Γ(Z, V ⊓ U j)) := fun V =>
      { carrier := {y | ∀ (i : Fin t) (j l : Fin n),
          (Z.presheaf.map (homOfLE (inf_le_left : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U j)).op).hom (y i j) =
          (Z.presheaf.map (homOfLE (le_trans inf_le_right inf_le_right :
            (V ⊓ U j) ⊓ (V ⊓ U l) ≤ U l)).op).hom (c l j) *
          (Z.presheaf.map (homOfLE (inf_le_right : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U l)).op).hom (y i l)}
        add_mem' := fun {y y'} hy hy' i j l => by
          simp only [Pi.add_apply, map_add, mul_add]
          rw [hy i j l, hy' i j l]
        zero_mem' := fun i j l => by
          simp only [Pi.zero_apply, map_zero, mul_zero]
        neg_mem' := fun {y} hy i j l => by
          simp only [Pi.neg_apply, map_neg, mul_neg]
          rw [hy i j l] }
    have resMem : ∀ (V W : Z.Opens) (h : W ≤ V) (y : Fin t → ∀ j : Fin n, Γ(Z, V ⊓ U j)), y ∈ S V →
        (fun i j => (Z.presheaf.map (homOfLE (inf_le_inf_right (U j) h)).op).hom (y i j)) ∈ S W := by
      intro V W h y hy i j l
      have hΩ : (W ⊓ U j) ⊓ (W ⊓ U l) ≤ (V ⊓ U j) ⊓ (V ⊓ U l) :=
        inf_le_inf (inf_le_inf_right (U j) h) (inf_le_inf_right (U l) h)
      have e := congrArg (Z.presheaf.map (homOfLE hΩ).op).hom (hy i j l)
      rw [map_mul, resZ, resZ, resZ] at e
      beta_reduce
      rw [resZ, resZ]
      exact e
    have smulMem : ∀ (V : Z.Opens) (r : Γ(Z, V)) (y : Fin t → ∀ j : Fin n, Γ(Z, V ⊓ U j)), y ∈ S V →
        (fun i j => (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * y i j) ∈ S V := by
      intro V r y hy i j l
      beta_reduce
      rw [map_mul, map_mul, resZ, resZ, hy i j l]
      ring
    let P : (Z.Opens)ᵒᵖ ⥤ Ab.{u} :=
      { obj := fun V => AddCommGrpCat.of (S V.unop)
        map := fun {V W} i => AddCommGrpCat.ofHom
          { toFun := fun p => ⟨fun a j =>
                (Z.presheaf.map (homOfLE (inf_le_inf_right (U j) i.unop.le)).op).hom (p.1 a j),
              resMem V.unop W.unop i.unop.le p.1 p.2⟩
            map_zero' := by
              ext a j
              exact map_zero _
            map_add' := fun p q => by
              ext a j
              exact map_add _ _ _ }
        map_id := fun V => by
          ext p a j
          exact resId _ _
        map_comp := fun {V W X} i i' => by
          ext p a j
          exact (resZ _ _ _).symm }
    letI smulS : ∀ V : Z.Opens, SMul Γ(Z, V) (S V) := fun V =>
      ⟨fun r y => ⟨fun i j => (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * y.1 i j,
        smulMem V r y.1 y.2⟩⟩
    letI modS : ∀ V : Z.Opens, Module Γ(Z, V) (S V) := fun V =>
      Module.ofMinimalAxioms
        (fun r x y => by
          ext i j
          exact mul_add _ _ _)
        (fun r s x => by
          ext i j
          change (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom (r + s) * x.1 i j =
            (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * x.1 i j +
            (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom s * x.1 i j
          rw [map_add, add_mul])
        (fun r s x => by
          ext i j
          change (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom (r * s) * x.1 i j =
            (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r *
            ((Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom s * x.1 i j)
          rw [map_mul, mul_assoc])
        (fun x => by
          ext i j
          change (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom 1 * x.1 i j = x.1 i j
          rw [map_one, one_mul])
    letI inst : ∀ V : (Z.Opens)ᵒᵖ, Module ↑(Z.ringCatSheaf.obj.obj V) ↑(P.obj V) := fun V =>
      (inferInstance : Module Γ(Z, V.unop) (S V.unop))
    have compat : ∀ (V W : Z.Opens) (h : W ≤ V) (r : Γ(Z, V)) (y : S V) (i : Fin t) (j : Fin n),
        (Z.presheaf.map (homOfLE (inf_le_inf_right (U j) h)).op).hom
          ((Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * y.1 i j) =
        (Z.presheaf.map (homOfLE (inf_le_left : W ⊓ U j ≤ W)).op).hom
          ((Z.presheaf.map (homOfLE h).op).hom r) *
        (Z.presheaf.map (homOfLE (inf_le_inf_right (U j) h)).op).hom (y.1 i j) := by
      intro V W h r y i j
      rw [map_mul, resZ, resZ]
    let Pm : PresheafOfModules Z.ringCatSheaf.obj := PresheafOfModules.ofPresheaf P (by
      intro V W f r p
      apply Subtype.ext
      funext i j
      exact compat V.unop W.unop f.unop.le r p i j)
    have hsh : TopCat.Presheaf.IsSheaf P := by
      rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
      intro ι O sf hcompat
      have hcomp : ∀ (a : Fin t) (b : Fin n), TopCat.Presheaf.IsCompatible Z.sheaf.obj
          (fun α => O α ⊓ U b) (fun α => (sf α).1 a b) := by
        intro a b α β
        have h : (Z.presheaf.map (homOfLE (inf_le_inf_right (U b)
              (inf_le_left : O α ⊓ O β ≤ O α))).op).hom ((sf α).1 a b) =
            (Z.presheaf.map (homOfLE (inf_le_inf_right (U b)
              (inf_le_right : O α ⊓ O β ≤ O β))).op).hom ((sf β).1 a b) :=
          congrArg (fun q => q.1 a b) (hcompat α β)
        have hle : (O α ⊓ U b) ⊓ (O β ⊓ U b) ≤ (O α ⊓ O β) ⊓ U b :=
          le_inf (inf_le_inf inf_le_left inf_le_left) (le_trans inf_le_left inf_le_right)
        have h2 := congrArg (Z.presheaf.map (homOfLE hle).op).hom h
        rw [resZ, resZ] at h2
        exact h2
      have hglue : ∀ (a : Fin t) (b : Fin n), ∃! y : Γ(Z, iSup O ⊓ U b), ∀ α,
          (Z.presheaf.map (homOfLE (inf_le_inf_right (U b) (le_iSup O α))).op).hom y = (sf α).1 a b := by
        intro a b
        exact TopCat.Sheaf.existsUnique_gluing' Z.sheaf (fun α => O α ⊓ U b) (iSup O ⊓ U b)
          (fun α => homOfLE (inf_le_inf_right (U b) (le_iSup O α))) (iSup_inf_eq O (U b)).le _
          (hcomp a b)
      choose y hy huniq using hglue
      have hyS : (fun a b => y a b) ∈ S (iSup O) := by
        intro a j l
        refine TopCat.Sheaf.eq_of_locally_eq' Z.sheaf (fun α => (O α ⊓ U j) ⊓ (O α ⊓ U l))
          ((iSup O ⊓ U j) ⊓ (iSup O ⊓ U l))
          (fun α => homOfLE (inf_le_inf (inf_le_inf_right (U j) (le_iSup O α))
            (inf_le_inf_right (U l) (le_iSup O α)))) ?_ _ _ ?_
        · intro x hx
          obtain ⟨α, hα⟩ := TopologicalSpace.Opens.mem_iSup.mp hx.1.1
          exact TopologicalSpace.Opens.mem_iSup.mpr ⟨α, ⟨hα, hx.1.2⟩, ⟨hα, hx.2.2⟩⟩
        · intro α
          change (Z.presheaf.map (homOfLE (inf_le_inf (inf_le_inf_right (U j) (le_iSup O α))
              (inf_le_inf_right (U l) (le_iSup O α)))).op).hom
              ((Z.presheaf.map (homOfLE (inf_le_left :
                (iSup O ⊓ U j) ⊓ (iSup O ⊓ U l) ≤ iSup O ⊓ U j)).op).hom (y a j)) =
            (Z.presheaf.map (homOfLE (inf_le_inf (inf_le_inf_right (U j) (le_iSup O α))
              (inf_le_inf_right (U l) (le_iSup O α)))).op).hom
              ((Z.presheaf.map (homOfLE (le_trans inf_le_right inf_le_right :
                (iSup O ⊓ U j) ⊓ (iSup O ⊓ U l) ≤ U l)).op).hom (c l j) *
              (Z.presheaf.map (homOfLE (inf_le_right :
                (iSup O ⊓ U j) ⊓ (iSup O ⊓ U l) ≤ iSup O ⊓ U l)).op).hom (y a l))
          rw [map_mul, resZ, resZ, resZ]
          have hs : (Z.presheaf.map (homOfLE (inf_le_left :
                (O α ⊓ U j) ⊓ (O α ⊓ U l) ≤ O α ⊓ U j)).op).hom ((sf α).1 a j) =
              (Z.presheaf.map (homOfLE (le_trans inf_le_right inf_le_right :
                (O α ⊓ U j) ⊓ (O α ⊓ U l) ≤ U l)).op).hom (c l j) *
              (Z.presheaf.map (homOfLE (inf_le_right :
                (O α ⊓ U j) ⊓ (O α ⊓ U l) ≤ O α ⊓ U l)).op).hom ((sf α).1 a l) :=
            (sf α).2 a j l
          rw [← hy a j α, ← hy a l α, resZ, resZ] at hs
          exact hs
      refine ⟨⟨fun a b => y a b, hyS⟩, ?_, ?_⟩
      · intro α
        apply Subtype.ext
        funext a b
        exact hy a b α
      · intro s' hs'
        apply Subtype.ext
        funext a b
        exact huniq a b (s'.1 a b) (fun α => congrArg (fun q => q.1 a b) (hs' α))
    let L : Z.Modules := SheafOfModules.mk Pm hsh
    refine ⟨L, fun V x => (x : S V).1, ?_, ?_, ?_, ?_, ?_⟩
    · intro V x x' h
      exact Subtype.ext h
    · intro V y
      constructor
      · rintro ⟨x, rfl⟩
        exact (x : S V).2
      · intro h
        exact ⟨(⟨y, h⟩ : S V), rfl⟩
    · intro V x x' i j
      rfl
    · intro V r x i j
      rfl
    · intro V W h x i j
      rfl

  have s3 : ∀ (n t : ℕ) (U : Fin n → Z.Opens) (c : ∀ l j : Fin n, Γ(Z, U l)) (L : Z.Modules) (π : ∀ V : Z.Opens, Γ(L, V) → Fin t → ∀ j : Fin n, Γ(Z, V ⊓ U j)), (∀ (V : Z.Opens) (x y : Γ(L, V)), π V x = π V y → x = y) → (∀ (V : Z.Opens) (y : Fin t → ∀ j : Fin n, Γ(Z, V ⊓ U j)), (∃ x : Γ(L, V), π V x = y) ↔ ∀ (i : Fin t) (j l : Fin n), (Z.presheaf.map (homOfLE (inf_le_left : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U j)).op).hom (y i j) = (Z.presheaf.map (homOfLE (le_trans inf_le_right inf_le_right : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ U l)).op).hom (c l j) * (Z.presheaf.map (homOfLE (inf_le_right : (V ⊓ U j) ⊓ (V ⊓ U l) ≤ V ⊓ U l)).op).hom (y i l)) → (∀ (V : Z.Opens) (x x' : Γ(L, V)) (i : Fin t) (j : Fin n), π V (x + x') i j = π V x i j + π V x' i j) → (∀ (V : Z.Opens) (r : Γ(Z, V)) (x : Γ(L, V)) (i : Fin t) (j : Fin n), π V (r • x) i j = (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom r * π V x i j) → (∀ (V W : Z.Opens) (h : W ≤ V) (x : Γ(L, V)) (i : Fin t) (j : Fin n), π W ((L.presheaf.map (homOfLE h).op).hom x) i j = (Z.presheaf.map (homOfLE (inf_le_inf_right (U j) h)).op).hom (π V x i j)) → (∀ k, c k k = 1) → (∀ k l j, (Z.presheaf.map (homOfLE (inf_le_left : U k ⊓ U l ≤ U k)).op).hom (c k j) = (Z.presheaf.map (homOfLE (inf_le_left : U k ⊓ U l ≤ U k)).op).hom (c k l) * (Z.presheaf.map (homOfLE (inf_le_right : U k ⊓ U l ≤ U l)).op).hom (c l j)) → ∃ ε : Fin t → ∀ k : Fin n, Γ(L, U k), (∀ (i : Fin t) (k l : Fin n), (L.presheaf.map (homOfLE (inf_le_left : U k ⊓ U l ≤ U k)).op).hom (ε i k) = (Z.presheaf.map (homOfLE (inf_le_left : U k ⊓ U l ≤ U k)).op).hom (c k l) • (L.presheaf.map (homOfLE (inf_le_right : U k ⊓ U l ≤ U l)).op).hom (ε i l)) ∧ ∀ (k : Fin n) (V : Z.Opens) (hV : V ≤ U k), Function.Bijective (fun a : Fin t → Γ(Z, V) => ∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε i k)) := by
    intro n t U c L π P1 P2 P3 P4 P5 H1 H2
    have H2' : ∀ (k l j : Fin n) {W : Z.Opens} (hk : W ≤ U k) (hl : W ≤ U l),
        (Z.presheaf.map (homOfLE hk).op).hom (c k j) =
        (Z.presheaf.map (homOfLE hk).op).hom (c k l) * (Z.presheaf.map (homOfLE hl).op).hom (c l j) := by
      intro k l j W hk hl
      have e := congrArg (Z.presheaf.map (homOfLE (le_inf hk hl)).op).hom (H2 k l j)
      rw [map_mul, resZ, resZ, resZ] at e
      exact e
    have π0 : ∀ (V : Z.Opens) (i : Fin t) (j : Fin n), π V 0 i j = 0 := by
      intro V i j
      have h := P4 V 0 0 i j
      rw [zero_smul, map_zero, zero_mul] at h
      exact h
    have πsum : ∀ (V : Z.Opens) (s : Finset (Fin t)) (f : Fin t → Γ(L, V)) (i : Fin t) (j : Fin n),
        π V (∑ a ∈ s, f a) i j = ∑ a ∈ s, π V (f a) i j := by
      intro V s f i j
      induction s using Finset.induction_on with
      | empty => rw [Finset.sum_empty, Finset.sum_empty, π0]
      | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, P3, ih]
    let y : Fin t → ∀ k : Fin n, Fin t → ∀ j : Fin n, Γ(Z, U k ⊓ U j) := fun i k i' j =>
      if i' = i then (Z.presheaf.map (homOfLE (inf_le_left : U k ⊓ U j ≤ U k)).op).hom (c k j) else 0
    have ymem : ∀ i k, ∃ x : Γ(L, U k), π (U k) x = y i k := by
      intro i k
      rw [P2]
      intro i' j l
      by_cases hi : i' = i
      · simp only [y, if_pos hi]
        rw [resZ, resZ, H2' k l j _ (le_trans inf_le_right inf_le_right), mul_comm]
      · simp only [y, if_neg hi, map_zero, mul_zero]
    choose ε hε using ymem
    refine ⟨ε, ?_, ?_⟩
    · intro i k l
      apply P1
      funext i' j
      rw [P5, P4, P5, hε, hε]
      by_cases hi : i' = i
      · simp only [y, if_pos hi]
        rw [resZ, resZ, resZ, H2' k l j _ (le_trans inf_le_left inf_le_right)]
      · simp only [y, if_neg hi, map_zero, mul_zero]
    · intro k V hV
      have dag : ∀ (a : Fin t → Γ(Z, V)) (i' : Fin t) (j : Fin n),
          π V (∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε i k)) i' j =
          (Z.presheaf.map (homOfLE (inf_le_left : V ⊓ U j ≤ V)).op).hom (a i') *
          (Z.presheaf.map (homOfLE (le_trans (inf_le_inf_right (U j) hV) inf_le_left :
            V ⊓ U j ≤ U k)).op).hom (c k j) := by
        intro a i' j
        rw [πsum, Finset.sum_eq_single i']
        · rw [P4, P5, hε]
          simp only [y, if_pos rfl]
          rw [resZ]
        · intro b _ hb
          rw [P4, P5, hε]
          simp only [y, if_neg (Ne.symm hb), map_zero, mul_zero]
        · intro h
          exact absurd (Finset.mem_univ i') h
      constructor
      · intro a b hab
        beta_reduce at hab
        funext i'
        have h1 := dag a i' k
        have h2 := dag b i' k
        rw [hab, h2, H1, map_one, mul_one, mul_one] at h1
        have h3 := congrArg (Z.presheaf.map (homOfLE (le_inf le_rfl hV : V ≤ V ⊓ U k)).op).hom h1
        rw [resZ, resZ, resId, resId] at h3
        exact h3.symm
      · intro x
        refine ⟨fun i => (Z.presheaf.map (homOfLE (le_inf le_rfl hV : V ≤ V ⊓ U k)).op).hom (π V x i k),
          ?_⟩
        apply P1
        funext i' j
        rw [dag, resZ]
        have hx := (P2 V (π V x)).mp ⟨x, rfl⟩ i' j k
        have hle : V ⊓ U j ≤ (V ⊓ U j) ⊓ (V ⊓ U k) :=
          le_inf le_rfl (le_inf inf_le_left (le_trans inf_le_left hV))
        have h3 := congrArg (Z.presheaf.map (homOfLE hle).op).hom hx
        rw [map_mul, resZ, resZ, resZ, resId] at h3
        rw [h3, mul_comm]

  have natg : ∀ {A B : (wcPm.{u} m).Opens} (h : B ≤ A) (x : Γ(wcPm.{u} m, A)),
      g.app B ((wcPm.{u} m).presheaf.map (homOfLE h).op x) =
      (Z.presheaf.map (homOfLE (g.preimage_mono h)).op).hom (g.app A x) := by
    intro A B h x
    exact congrArg (fun f => f.hom x) (g.naturality (homOfLE h).op)
  have hT : ∀ a b c : Fin (m + 1),
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a c)) =
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a b)) *
      (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ wcPmChart m b)).op).hom (g.app (wcPmChart m b) (e b c)) := by
    intro a b c
    have hW : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ (wcPmChart m a ⊓ wcPmChart m b) := g.preimage_inf.ge
    have key := congrArg (fun x => (Z.presheaf.map (homOfLE hW).op).hom
      (g.app (wcPmChart m a ⊓ wcPmChart m b) x)) (he3 a b c)
    simp only [map_mul] at key
    rw [natg, natg, natg, resZ, resZ, resZ] at key
    exact key
  have H1 : ∀ k : Fin (m + 1), (g.app (wcPmChart m k) (e k k)) ^ d = 1 := by
    intro k
    rw [he1, map_one, one_pow]
  have H2 : ∀ k l j : Fin (m + 1),
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ wcPmChart m k)).op).hom ((g.app (wcPmChart m k) (e k j)) ^ d) =
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ wcPmChart m k)).op).hom ((g.app (wcPmChart m k) (e k l)) ^ d) *
      (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ wcPmChart m l)).op).hom ((g.app (wcPmChart m l) (e l j)) ^ d) := by
    intro k l j
    rw [map_pow, map_pow, map_pow, hT k l j, mul_pow]
  obtain ⟨L, π, P1, P2, P3, P4, P5⟩ := s2 (m + 1) t (fun j => g ⁻¹ᵁ wcPmChart m j)
    (fun l j => (g.app (wcPmChart m l) (e l j)) ^ d)
  obtain ⟨ε, hTw, hB⟩ := s3 (m + 1) t (fun j => g ⁻¹ᵁ wcPmChart m j)
    (fun l j => (g.app (wcPmChart m l) (e l j)) ^ d) L π P1 P2 P3 P4 P5 H1 H2
  refine ⟨L, ε, ?_, hB⟩
  intro i k l
  have h := hTw i k l
  simp only [map_pow] at h
  exact h

theorem wc_cn_twist_hom : ∀ (Z : Scheme.{u}) (m : ℕ) (g : Z ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), (∀ z : Z, ∃ k, z ∈ g ⁻¹ᵁ wcPmChart m k) → ∀ (d t : ℕ) (L : Z.Modules) (ε : Fin t → ∀ k : Fin (m + 1), Γ(L, g ⁻¹ᵁ wcPmChart m k)), (∀ i, wcCnTwisted g e L d (ε i)) → (∀ (k : Fin (m + 1)) (V : Z.Opens) (hV : V ≤ g ⁻¹ᵁ wcPmChart m k), Function.Bijective (fun a : Fin t → Γ(Z, V) => ∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε i k))) → ∀ (F : Z.Modules), (∀ s : Fin t → ∀ k : Fin (m + 1), Γ(F, g ⁻¹ᵁ wcPmChart m k), (∀ i, wcCnTwisted g e F d (s i)) → ∃ f : L ⟶ F, ∀ i k, Scheme.Modules.Hom.app f (g ⁻¹ᵁ wcPmChart m k) (ε i k) = s i k) ∧ ∀ f f' : L ⟶ F, (∀ i k, Scheme.Modules.Hom.app f (g ⁻¹ᵁ wcPmChart m k) (ε i k) = Scheme.Modules.Hom.app f' (g ⁻¹ᵁ wcPmChart m k) (ε i k)) → f = f' :=
by
  intro Z m g e hcov d t L ε hεtw hεbij F
  classical
  have resG : ∀ (G : Z.Modules) {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(G, A)),
      (G.presheaf.map (homOfLE h2).op).hom ((G.presheaf.map (homOfLE h1).op).hom x) =
      (G.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro G A B C h1 h2 x
    change (G.presheaf.map (homOfLE h1).op ≫ G.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    all_goals rfl
  have resZ : ∀ {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Z, A)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    all_goals rfl
  have resId : ∀ (G : Z.Modules) (A : Z.Opens) (h : A ≤ A) (x : Γ(G, A)),
      (G.presheaf.map (homOfLE h).op).hom x = x := by
    intro G A h x
    have h' : (homOfLE h).op = 𝟙 (Opposite.op A) := rfl
    rw [h', CategoryTheory.Functor.map_id]
    all_goals rfl
  have smulG : ∀ (G : Z.Modules) {A B : Z.Opens} (h : B ≤ A) (r : Γ(Z, A)) (x : Γ(G, A)),
      (G.presheaf.map (homOfLE h).op).hom (r • x) =
      (Z.presheaf.map (homOfLE h).op).hom r • (G.presheaf.map (homOfLE h).op).hom x :=
    fun G _ _ h r x => Scheme.Modules.map_smul G (homOfLE h) r x
  have natApp : ∀ {M N : Z.Modules} (f : M ⟶ N) {A B : Z.Opens} (h : B ≤ A) (x : Γ(M, A)),
      Scheme.Modules.Hom.app f B ((M.presheaf.map (homOfLE h).op).hom x) =
      (N.presheaf.map (homOfLE h).op).hom (Scheme.Modules.Hom.app f A x) :=
    fun f _ _ h x => congrArg (fun k => k.hom x)
      ((Scheme.Modules.Hom.mapPresheaf f).naturality (homOfLE h).op)

  have twres : ∀ (G : Z.Modules) (σ : ∀ k : Fin (m + 1), Γ(G, g ⁻¹ᵁ wcPmChart m k)),
      wcCnTwisted g e G d σ →
      ∀ (k l : Fin (m + 1)) (V : Z.Opens) (hk : V ≤ g ⁻¹ᵁ wcPmChart m k)
        (hl : V ≤ g ⁻¹ᵁ wcPmChart m l),
      (G.presheaf.map (homOfLE hk).op).hom (σ k) =
        ((Z.presheaf.map (homOfLE hk).op).hom (g.app (wcPmChart m k) (e k l))) ^ d •
          (G.presheaf.map (homOfLE hl).op).hom (σ l) := by
    intro G σ hσ k l V hk hl
    have hW : V ≤ g ⁻¹ᵁ wcPmChart m k ⊓ g ⁻¹ᵁ wcPmChart m l := le_inf hk hl
    have key := congrArg (fun y => (G.presheaf.map (homOfLE hW).op).hom y) (hσ k l)
    dsimp only at key
    rw [smulG, map_pow, resG, resG, resZ] at key
    exact key

  have main : ∀ (n : ℕ) (U : Fin n → Z.Opens) (τ : ∀ k l : Fin n, Γ(Z, U k)),
      (∀ z : Z, ∃ k, z ∈ U k) →
      ∀ (ε : Fin t → ∀ k, Γ(L, U k)),
      (∀ i k l (V : Z.Opens) (hk : V ≤ U k) (hl : V ≤ U l),
        (L.presheaf.map (homOfLE hk).op).hom (ε i k) =
          ((Z.presheaf.map (homOfLE hk).op).hom (τ k l)) ^ d •
            (L.presheaf.map (homOfLE hl).op).hom (ε i l)) →
      (∀ k (V : Z.Opens) (hV : V ≤ U k), Function.Bijective
        (fun a : Fin t → Γ(Z, V) => ∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε i k))) →
      (∀ s : Fin t → ∀ k, Γ(F, U k),
        (∀ i k l (V : Z.Opens) (hk : V ≤ U k) (hl : V ≤ U l),
          (F.presheaf.map (homOfLE hk).op).hom (s i k) =
            ((Z.presheaf.map (homOfLE hk).op).hom (τ k l)) ^ d •
              (F.presheaf.map (homOfLE hl).op).hom (s i l)) →
        ∃ f : L ⟶ F, ∀ i k, Scheme.Modules.Hom.app f (U k) (ε i k) = s i k) ∧
      ∀ f f' : L ⟶ F, (∀ i k, Scheme.Modules.Hom.app f (U k) (ε i k) =
        Scheme.Modules.Hom.app f' (U k) (ε i k)) → f = f' := by
    intro n U τ hcov ε hεtw hεbij
    have natS : ∀ (G : Z.Modules) (σ : Fin t → ∀ k, Γ(G, U k)) (k : Fin n) (V W : Z.Opens)
        (hV : V ≤ U k) (hWV : W ≤ V) (a : Fin t → Γ(Z, V)),
        ∑ i, (Z.presheaf.map (homOfLE hWV).op).hom (a i) •
            (G.presheaf.map (homOfLE (hWV.trans hV)).op).hom (σ i k) =
          (G.presheaf.map (homOfLE hWV).op).hom
            (∑ i, a i • (G.presheaf.map (homOfLE hV).op).hom (σ i k)) := by
      intro G σ k V W hV hWV a
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [smulG, resG]
    have twS : ∀ (G : Z.Modules) (σ : Fin t → ∀ k, Γ(G, U k)),
        (∀ i k l (V : Z.Opens) (hk : V ≤ U k) (hl : V ≤ U l),
          (G.presheaf.map (homOfLE hk).op).hom (σ i k) =
            ((Z.presheaf.map (homOfLE hk).op).hom (τ k l)) ^ d •
              (G.presheaf.map (homOfLE hl).op).hom (σ i l)) →
        ∀ k l (V : Z.Opens) (hk : V ≤ U k) (hl : V ≤ U l) (a : Fin t → Γ(Z, V)),
        ∑ i, a i • (G.presheaf.map (homOfLE hk).op).hom (σ i k) =
          ∑ i, ((Z.presheaf.map (homOfLE hk).op).hom (τ k l) ^ d * a i) •
            (G.presheaf.map (homOfLE hl).op).hom (σ i l) := by
      intro G σ hσ k l V hk hl a
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hσ i k l V hk hl, smul_smul, mul_comm (a i)]

    obtain ⟨c, hc⟩ : ∃ c : ∀ (k : Fin n) (V : Z.Opens), V ≤ U k → Γ(L, V) → (Fin t → Γ(Z, V)),
        ∀ k V (hV : V ≤ U k) (x : Γ(L, V)),
          ∑ i, c k V hV x i • (L.presheaf.map (homOfLE hV).op).hom (ε i k) = x :=
      ⟨fun k V hV x => ((hεbij k V hV).2 x).choose,
        fun k V hV x => ((hεbij k V hV).2 x).choose_spec⟩
    have hinj : ∀ k V (hV : V ≤ U k) (a b : Fin t → Γ(Z, V)),
        ∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε i k) =
          ∑ i, b i • (L.presheaf.map (homOfLE hV).op).hom (ε i k) → a = b :=
      fun k V hV a b h => (hεbij k V hV).1 h
    have c_add : ∀ k V (hV : V ≤ U k) (x y : Γ(L, V)),
        c k V hV (x + y) = c k V hV x + c k V hV y := by
      intro k V hV x y
      apply hinj k V hV
      rw [hc]
      simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib, hc]
    have c_smul : ∀ k V (hV : V ≤ U k) (b : Γ(Z, V)) (x : Γ(L, V)),
        c k V hV (b • x) = fun i => b * c k V hV x i := by
      intro k V hV b x
      apply hinj k V hV
      rw [hc]
      simp only [mul_smul, ← Finset.smul_sum, hc]
    have c_nat : ∀ k (V W : Z.Opens) (hV : V ≤ U k) (hWV : W ≤ V) (x : Γ(L, V)),
        c k W (hWV.trans hV) ((L.presheaf.map (homOfLE hWV).op).hom x) =
          fun i => (Z.presheaf.map (homOfLE hWV).op).hom (c k V hV x i) := by
      intro k V W hV hWV x
      apply hinj k W (hWV.trans hV)
      rw [hc, natS L ε k V W hV hWV (c k V hV x), hc]
    have c_chart : ∀ k l (V : Z.Opens) (hk : V ≤ U k) (hl : V ≤ U l) (x : Γ(L, V)),
        c l V hl x = fun i => (Z.presheaf.map (homOfLE hk).op).hom (τ k l) ^ d * c k V hk x i := by
      intro k l V hk hl x
      apply hinj l V hl
      rw [hc, ← twS L ε hεtw k l V hk hl (c k V hk x), hc]
    have c_frame : ∀ i k, c k (U k) le_rfl (ε i k) = Pi.single i 1 := by
      intro i k
      apply hinj k (U k) le_rfl
      rw [hc, Finset.sum_eq_single i, Pi.single_eq_same, one_smul, resId]
      · intro j _ hji
        rw [Pi.single_eq_of_ne hji, zero_smul]
      · intro h
        exact absurd (Finset.mem_univ i) h
    have hcovV : ∀ V : Z.Opens, V ≤ ⨆ k, V ⊓ U k := by
      intro V z hz
      obtain ⟨k, hk⟩ := hcov z
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨k, ⟨hz, hk⟩⟩
    let FS : TopCat.Sheaf Ab Z := ⟨F.presheaf, F.isSheaf⟩
    have loc : ∀ (V : Z.Opens) (y y' : Γ(F, V)),
        (∀ k, (F.presheaf.map (homOfLE (inf_le_left : V ⊓ U k ≤ V)).op).hom y =
          (F.presheaf.map (homOfLE (inf_le_left : V ⊓ U k ≤ V)).op).hom y') → y = y' :=
      fun V y y' h => TopCat.Sheaf.eq_of_locally_eq' FS (fun k => V ⊓ U k) V
        (fun k => homOfLE inf_le_left) (hcovV V) y y' h
    refine ⟨fun s hs => ?_, fun f f' hff' => ?_⟩
    ·
      obtain ⟨φ, hφ⟩ : ∃ φ : ∀ (k : Fin n) (V : Z.Opens), V ≤ U k → Γ(L, V) → Γ(F, V),
          ∀ k V (hV : V ≤ U k) x,
            φ k V hV x = ∑ i, c k V hV x i • (F.presheaf.map (homOfLE hV).op).hom (s i k) :=
        ⟨fun k V hV x => ∑ i, c k V hV x i • (F.presheaf.map (homOfLE hV).op).hom (s i k),
          fun _ _ _ _ => rfl⟩
      have φ_add : ∀ k V (hV : V ≤ U k) (x y : Γ(L, V)),
          φ k V hV (x + y) = φ k V hV x + φ k V hV y := by
        intro k V hV x y
        simp only [hφ, c_add, Pi.add_apply, add_smul, Finset.sum_add_distrib]
      have φ_smul : ∀ k V (hV : V ≤ U k) (b : Γ(Z, V)) (x : Γ(L, V)),
          φ k V hV (b • x) = b • φ k V hV x := by
        intro k V hV b x
        simp only [hφ, c_smul, mul_smul, Finset.smul_sum]
      have φ_nat : ∀ k (V W : Z.Opens) (hV : V ≤ U k) (hWV : W ≤ V) (x : Γ(L, V)),
          φ k W (hWV.trans hV) ((L.presheaf.map (homOfLE hWV).op).hom x) =
            (F.presheaf.map (homOfLE hWV).op).hom (φ k V hV x) := by
        intro k V W hV hWV x
        rw [hφ, hφ, ← natS F s k V W hV hWV (c k V hV x)]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [c_nat k V W hV hWV x]
      have φ_agree : ∀ k l (V : Z.Opens) (hk : V ≤ U k) (hl : V ≤ U l) (x : Γ(L, V)),
          φ k V hk x = φ l V hl x := by
        intro k l V hk hl x
        rw [hφ, hφ, c_chart k l V hk hl x, twS F s hs k l V hk hl (c k V hk x)]
      have hglue : ∀ (V : Z.Opens) (x : Γ(L, V)), ∃ y : Γ(F, V), ∀ k,
          (F.presheaf.map (homOfLE (inf_le_left : V ⊓ U k ≤ V)).op).hom y =
            φ k (V ⊓ U k) inf_le_right
              ((L.presheaf.map (homOfLE (inf_le_left : V ⊓ U k ≤ V)).op).hom x) := by
        intro V x
        have hcomp : TopCat.Presheaf.IsCompatible FS.obj (fun k => V ⊓ U k)
            (fun k => φ k (V ⊓ U k) inf_le_right
              ((L.presheaf.map (homOfLE (inf_le_left : V ⊓ U k ≤ V)).op).hom x)) := by
          intro k l
          change (F.presheaf.map (homOfLE (inf_le_left :
              (V ⊓ U k) ⊓ (V ⊓ U l) ≤ V ⊓ U k)).op).hom
              (φ k (V ⊓ U k) inf_le_right
                ((L.presheaf.map (homOfLE (inf_le_left : V ⊓ U k ≤ V)).op).hom x)) =
            (F.presheaf.map (homOfLE (inf_le_right :
              (V ⊓ U k) ⊓ (V ⊓ U l) ≤ V ⊓ U l)).op).hom
              (φ l (V ⊓ U l) inf_le_right
                ((L.presheaf.map (homOfLE (inf_le_left : V ⊓ U l ≤ V)).op).hom x))
          rw [← φ_nat, ← φ_nat, resG, resG]
          exact φ_agree _ _ _ _ _ _
        obtain ⟨y, hy, -⟩ := TopCat.Sheaf.existsUnique_gluing' FS (fun k => V ⊓ U k) V
          (fun k => homOfLE inf_le_left) (hcovV V) _ hcomp
        exact ⟨y, hy⟩
      choose Fv hFv using hglue
      have Fv_add : ∀ (V : Z.Opens) (x y : Γ(L, V)), Fv V (x + y) = Fv V x + Fv V y := by
        intro V x y
        apply loc
        intro k
        rw [map_add, hFv, hFv, hFv, map_add, φ_add]
      have Fv_smul : ∀ (V : Z.Opens) (b : Γ(Z, V)) (x : Γ(L, V)), Fv V (b • x) = b • Fv V x := by
        intro V b x
        apply loc
        intro k
        simp only [hFv, smulG, φ_smul]
      have Fv_nat : ∀ (V W : Z.Opens) (hWV : W ≤ V) (x : Γ(L, V)),
          Fv W ((L.presheaf.map (homOfLE hWV).op).hom x) =
            (F.presheaf.map (homOfLE hWV).op).hom (Fv V x) := by
        intro V W hWV x
        apply loc
        intro k
        have hWk : W ⊓ U k ≤ V ⊓ U k := inf_le_inf_right _ hWV
        rw [hFv, resG, resG, ← resG F (inf_le_left : V ⊓ U k ≤ V) hWk, hFv, ← φ_nat, resG]
      have Fv_val : ∀ k (V : Z.Opens) (hV : V ≤ U k) (x : Γ(L, V)), Fv V x = φ k V hV x := by
        intro k V hV x
        apply loc
        intro l
        rw [hFv, ← φ_nat k V (V ⊓ U l) hV inf_le_left x]
        exact φ_agree _ _ _ _ _ _
      let η : L.presheaf ⟶ F.presheaf :=
        { app := fun V => AddCommGrpCat.ofHom (AddMonoidHom.mk' (Fv V.unop) (Fv_add V.unop))
          naturality := fun V W f => by
            ext x
            exact Fv_nat V.unop W.unop (leOfHom f.unop) x }
      let fhom : L ⟶ F := { val := PresheafOfModules.homMk η (fun V r x => Fv_smul V.unop r x) }
      refine ⟨fhom, fun i k => ?_⟩
      change Fv (U k) (ε i k) = s i k
      rw [Fv_val k (U k) le_rfl, hφ, c_frame, Finset.sum_eq_single i, Pi.single_eq_same,
        one_smul, resId]
      · intro j _ hji
        rw [Pi.single_eq_of_ne hji, zero_smul]
      · intro h
        exact absurd (Finset.mem_univ i) h
    ·
      apply Scheme.Modules.hom_ext
      intro V
      refine ConcreteCategory.hom_ext _ _ (fun y => ?_)
      apply loc
      intro k
      rw [← natApp, ← natApp,
        ← hc k (V ⊓ U k) inf_le_right ((L.presheaf.map (homOfLE inf_le_left).op).hom y)]
      simp only [map_sum, Scheme.Modules.Hom.app_smul]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [natApp, natApp, hff' i k]
  obtain ⟨h1, h2⟩ := main (m + 1) (fun k => g ⁻¹ᵁ wcPmChart m k)
    (fun k l => g.app (wcPmChart m k) (e k l)) hcov ε (fun i => twres L (ε i) (hεtw i)) hεbij
  exact ⟨fun s hs => h1 s (fun i => twres F (s i) (hs i)), h2⟩

theorem wc_cn_locfree_coherent : ∀ (X : Scheme.{u}) (M : X.Modules), (∀ z : X, ∃ (U : X.Opens) (r : ℕ) (ε : Fin r → Γ(M, U)), z ∈ U ∧ IsAffineOpen U ∧ ∀ (V : X.Opens) (hV : V ≤ U), Function.Bijective (fun a : Fin r → Γ(X, V) => ∑ i, a i • (M.presheaf.map (homOfLE hV).op).hom (ε i))) → wcCoherentMod M :=
by
  intro X M hloc
  classical
  have resG : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h2).op).hom ((M.presheaf.map (homOfLE h1).op).hom x) =
      (M.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have resX : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
  have smulres : ∀ (A B : X.Opens) (h1 : B ≤ A) (a : Γ(X, A)) (x : Γ(M, A)),
      (M.presheaf.map (homOfLE h1).op).hom (a • x) =
      (X.presheaf.map (homOfLE h1).op).hom a • (M.presheaf.map (homOfLE h1).op).hom x :=
    fun A B h1 a x => Scheme.Modules.map_smul M (homOfLE h1) a x

  have frame : ∀ (O : X.Opens) (r : ℕ) (ε : Fin r → Γ(M, O)), (∀ (V : X.Opens) (hV : V ≤ O), Function.Bijective (fun a : Fin r → Γ(X, V) => ∑ i, a i • (M.presheaf.map (homOfLE hV).op).hom (ε i))) → ∀ (W : X.Opens), IsAffineOpen W → W ≤ O → Module.Finite Γ(X, W) Γ(M, W) ∧ ∀ f : Γ(X, W), (∀ s : Γ(M, X.basicOpen f), ∃ (n : ℕ) (t : Γ(M, W)), ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n • s = (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t) ∧ (∀ t : Γ(M, W), (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t = 0 → ∃ n : ℕ, f ^ n • t = 0) := by
    intro O r ε hbij W hW hWO
    have star : ∀ (A B : X.Opens) (hA : A ≤ O) (hB : B ≤ O) (hBA : B ≤ A) (a : Fin r → Γ(X, A)),
        (M.presheaf.map (homOfLE hBA).op).hom (∑ i, a i • (M.presheaf.map (homOfLE hA).op).hom (ε i)) =
        ∑ i, (X.presheaf.map (homOfLE hBA).op).hom (a i) • (M.presheaf.map (homOfLE hB).op).hom (ε i) := by
      intro A B hA hB hBA a
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [smulres, resG]
    refine ⟨?_, fun f => ⟨fun s => ?_, fun t ht => ?_⟩⟩
    · let L : (Fin r → Γ(X, W)) →ₗ[Γ(X, W)] Γ(M, W) :=
        { toFun := fun a => ∑ i, a i • (M.presheaf.map (homOfLE hWO).op).hom (ε i)
          map_add' := fun a b => by
            simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
          map_smul' := fun c a => by
            simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
      exact Module.Finite.of_surjective L (hbij W hWO).2
    · have hD : X.basicOpen f ≤ O := (X.basicOpen_le f).trans hWO
      obtain ⟨b, hb⟩ := (hbij (X.basicOpen f) hD).2 s
      have hb' : ∑ i, b i • (M.presheaf.map (homOfLE hD).op).hom (ε i) = s := hb
      haveI := hW.isLocalization_basicOpen f
      choose n c hc using fun i => IsLocalization.Away.surj (S := Γ(X, X.basicOpen f)) f (b i)
      refine ⟨∑ i, n i, ∑ i, (f ^ (∑ j, n j - n i) * c i) • (M.presheaf.map (homOfLE hWO).op).hom (ε i), ?_⟩
      rw [star W (X.basicOpen f) hWO hD (X.basicOpen_le f) (fun i => f ^ (∑ j, n j - n i) * c i),
        ← hb', Finset.smul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [smul_smul]
      congr 1
      have hle : n i ≤ ∑ j, n j :=
        Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      have hci : b i * (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f ^ n i =
          (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (c i) := hc i
      rw [map_mul, map_pow, ← hci]
      conv_lhs => rw [← Nat.sub_add_cancel hle]
      ring
    · have hD : X.basicOpen f ≤ O := (X.basicOpen_le f).trans hWO
      obtain ⟨a, ha⟩ := (hbij W hWO).2 t
      have ha' : ∑ i, a i • (M.presheaf.map (homOfLE hWO).op).hom (ε i) = t := ha
      subst ha'
      haveI := hW.isLocalization_basicOpen f
      have h0 : ∀ i, (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (a i) = 0 := by
        have hinj := (hbij (X.basicOpen f) hD).1
        have e1 : (fun a : Fin r → Γ(X, X.basicOpen f) => ∑ i, a i • (M.presheaf.map (homOfLE hD).op).hom (ε i)) (fun i => (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (a i)) = (fun a : Fin r → Γ(X, X.basicOpen f) => ∑ i, a i • (M.presheaf.map (homOfLE hD).op).hom (ε i)) 0 := by
          simp only [Pi.zero_apply, zero_smul, Finset.sum_const_zero]
          rw [← star W (X.basicOpen f) hWO hD (X.basicOpen_le f) a]
          exact ht
        intro i
        exact congrFun (hinj e1) i
      choose k hk using fun i => (IsLocalization.map_eq_zero_iff (Submonoid.powers f)
        Γ(X, X.basicOpen f) (a i)).mp (h0 i)
      choose k' hk' using fun i => (Submonoid.mem_powers_iff _ _).mp (k i).2
      refine ⟨∑ i, k' i, ?_⟩
      rw [Finset.smul_sum]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [smul_smul]
      have hle : k' i ≤ ∑ j, k' j :=
        Finset.single_le_sum (f := k') (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      have hz : f ^ (∑ j, k' j) * a i = 0 := by
        rw [← Nat.sub_add_cancel hle, pow_add, mul_assoc, hk' i, hk i, mul_zero]
      rw [hz, zero_smul]

  have cover : ∀ U : X.Opens, IsAffineOpen U → ∃ (p : ℕ) (g : Fin p → Γ(X, U)), Ideal.span (Set.range g) = ⊤ ∧ (∀ x ∈ U, ∃ a, x ∈ X.basicOpen (g a)) ∧ ∀ (V : X.Opens), IsAffineOpen V → (∃ a, V ≤ X.basicOpen (g a)) → Module.Finite Γ(X, V) Γ(M, V) ∧ ∀ f : Γ(X, V), (∀ s : Γ(M, X.basicOpen f), ∃ (n : ℕ) (t : Γ(M, V)), ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n • s = (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t) ∧ (∀ t : Γ(M, V), (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t = 0 → ∃ n : ℕ, f ^ n • t = 0) := by
    intro U hU
    let S : Set Γ(X, U) := {f | ∃ (O : X.Opens) (r : ℕ) (ε : Fin r → Γ(M, O)), (∀ (V : X.Opens) (hV : V ≤ O), Function.Bijective (fun a : Fin r → Γ(X, V) => ∑ i, a i • (M.presheaf.map (homOfLE hV).op).hom (ε i))) ∧ X.basicOpen f ≤ O}
    have hS : Ideal.span S = ⊤ := by
      rw [← hU.self_le_iSup_basicOpen_iff]
      intro x hx
      obtain ⟨O, r, ε, hxO, -, hb⟩ := hloc x
      obtain ⟨f, hfO, hxf⟩ := hU.exists_basicOpen_le (V := O) ⟨x, hxO⟩ hx
      have hfS : f ∈ S := ⟨O, r, ε, hb, hfO⟩
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hfS⟩, hxf⟩
    obtain ⟨s', hs'S, hs'⟩ := (Ideal.span_eq_top_iff_finite S).mp hS
    have hrange : Set.range (fun i => (s'.equivFin.symm i).1) = (↑s' : Set Γ(X, U)) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact (s'.equivFin.symm i).2
      · intro hy
        exact ⟨s'.equivFin ⟨y, hy⟩, by simp⟩
    refine ⟨s'.card, fun i => (s'.equivFin.symm i).1, by rw [hrange]; exact hs', ?_, ?_⟩
    · intro x hx
      have e := hU.iSup_basicOpen_eq_self_iff.mpr hs'
      rw [← e] at hx
      obtain ⟨⟨f, hf⟩, hxf⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      exact ⟨s'.equivFin ⟨f, hf⟩, by simpa using hxf⟩
    · rintro V hV ⟨a, hVa⟩
      obtain ⟨O, r, ε, hb, hle⟩ := hs'S (s'.equivFin.symm a).2
      exact frame O r ε hb V hV (hVa.trans hle)

  have kill : ∀ (U : X.Opens), IsAffineOpen U → ∀ (f : Γ(X, U)) (t : Γ(M, U)), (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom t = 0 → ∃ n : ℕ, f ^ n • t = 0 := by
    intro U hU f t ht
    obtain ⟨p, gg, -, hcov, hloc'⟩ := cover U hU
    let W : Fin p → X.Opens := fun a => X.basicOpen (gg a)
    have hWle : ∀ a, W a ≤ U := fun a => X.basicOpen_le (gg a)
    have hWaff : ∀ a, IsAffineOpen (W a) := fun a => hU.basicOpen (gg a)
    have key : ∀ i, ∃ n : ℕ, ((X.presheaf.map (homOfLE (hWle i)).op).hom f) ^ n •
        (M.presheaf.map (homOfLE (hWle i)).op).hom t = 0 := by
      intro i
      refine ((hloc' (W i) (hWaff i) ⟨i, le_rfl⟩).2
        ((X.presheaf.map (homOfLE (hWle i)).op).hom f)).2 _ ?_
      have hle : X.basicOpen ((X.presheaf.map (homOfLE (hWle i)).op).hom f) ≤ X.basicOpen f := by
        rw [Scheme.basicOpen_res]; exact inf_le_right
      rw [resG _ _ _ _ _ ((X.basicOpen_le _).trans (hWle i)),
        ← resG _ _ _ (X.basicOpen_le f) hle, ht, map_zero]
    choose n hn using key
    refine ⟨∑ i, n i, ?_⟩
    have hcov' : U ≤ iSup W := fun x hx => TopologicalSpace.Opens.mem_iSup.mpr (hcov x hx)
    refine TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) W U
      (fun i => homOfLE (hWle i)) hcov' _ _ (fun i => ?_)
    change (M.presheaf.map (homOfLE (hWle i)).op).hom (f ^ (∑ i, n i) • t) =
      (M.presheaf.map (homOfLE (hWle i)).op).hom 0
    rw [map_zero, Scheme.Modules.map_smul, map_pow]
    have hle : n i ≤ ∑ j, n j :=
      Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hn i, smul_zero]

  have lift : ∀ (U : X.Opens), IsAffineOpen U → ∀ (g : Γ(X, U)) (s : Γ(M, X.basicOpen g)), ∃ (n : ℕ) (t : Γ(M, U)), ((X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom g) ^ n • s = (M.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom t := by
    intro X₀ hX₀ g s
    obtain ⟨r, gg, -, hcov, hloc'⟩ := cover X₀ hX₀
    let W : Fin r → X.Opens := fun a => X.basicOpen (gg a)
    have hWle : ∀ a, W a ≤ X₀ := fun a => X.basicOpen_le (gg a)
    have hWaff : ∀ a, IsAffineOpen (W a) := fun a => hX₀.basicOpen (gg a)
    have hpair : ∀ i j, IsAffineOpen (W i ⊓ W j) := by
      intro i j
      have h := hX₀.basicOpen (gg i * gg j)
      rw [Scheme.basicOpen_mul] at h
      exact h
    have hDX₀ : X.basicOpen g ≤ X₀ := X.basicOpen_le g
    let gi : ∀ i, Γ(X, W i) := fun i => (X.presheaf.map (homOfLE (hWle i)).op).hom g
    have hE : ∀ i, X.basicOpen (gi i) = W i ⊓ X.basicOpen g := fun i => Scheme.basicOpen_res X g _
    have hEW : ∀ i, X.basicOpen (gi i) ≤ W i := fun i => X.basicOpen_le _
    have hED : ∀ i, X.basicOpen (gi i) ≤ X.basicOpen g := fun i => by rw [hE i]; exact inf_le_right
    have hEX : ∀ i, X.basicOpen (gi i) ≤ X₀ := fun i => (hEW i).trans (hWle i)
    have hgE : ∀ i, (X.presheaf.map (homOfLE (hEW i)).op).hom (gi i) =
        (X.presheaf.map (homOfLE (hEX i)).op).hom g := fun i => resX _ _ _ (hWle i) (hEW i) (hEX i) g
    have hgE' : ∀ i, (X.presheaf.map (homOfLE (hED i)).op).hom
        ((X.presheaf.map (homOfLE hDX₀).op).hom g) = (X.presheaf.map (homOfLE (hEX i)).op).hom g :=
      fun i => resX _ _ _ hDX₀ (hED i) (hEX i) g

    have hA : ∀ i, ∃ (n : ℕ) (t : Γ(M, W i)),
        ((X.presheaf.map (homOfLE (hEX i)).op).hom g) ^ n •
          (M.presheaf.map (homOfLE (hED i)).op).hom s =
        (M.presheaf.map (homOfLE (hEW i)).op).hom t := by
      intro i
      obtain ⟨n, t, ht⟩ :=
        ((hloc' (W i) (hWaff i) ⟨i, le_rfl⟩).2 (gi i)).1 ((M.presheaf.map (homOfLE (hED i)).op).hom s)
      exact ⟨n, t, by rw [← hgE i]; exact ht⟩
    choose n t ht using hA

    let N₁ := ∑ i, n i
    let t' : ∀ i, Γ(M, W i) := fun i => (gi i) ^ (N₁ - n i) • t i
    have hB : ∀ i, ((X.presheaf.map (homOfLE (hEX i)).op).hom g) ^ N₁ •
          (M.presheaf.map (homOfLE (hED i)).op).hom s =
        (M.presheaf.map (homOfLE (hEW i)).op).hom (t' i) := by
      intro i
      have hle : n i ≤ N₁ :=
        Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      show _ = (M.presheaf.map (homOfLE (hEW i)).op).hom ((gi i) ^ (N₁ - n i) • t i)
      rw [smulres, map_pow, hgE i, ← ht i, ← mul_smul, ← pow_add, Nat.sub_add_cancel hle]

    have hC : ∀ i j, ∃ m : ℕ,
        ((X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g) ^ m •
        ((M.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (t' i) -
         (M.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (t' j)) = 0 := by
      intro i j
      let gij := (X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g
      refine ((hloc' (W i ⊓ W j) (hpair i j) ⟨i, inf_le_left⟩).2 gij).2 _ ?_
      have hF : X.basicOpen gij = (W i ⊓ W j) ⊓ X.basicOpen g := Scheme.basicOpen_res X g _
      have hFi : X.basicOpen gij ≤ X.basicOpen (gi i) := by
        rw [hF, hE i]; exact inf_le_inf_right _ inf_le_left
      have hFj : X.basicOpen gij ≤ X.basicOpen (gi j) := by
        rw [hF, hE j]; exact inf_le_inf_right _ inf_le_right
      have hFD : X.basicOpen gij ≤ X.basicOpen g := by rw [hF]; exact inf_le_right
      have hFX : X.basicOpen gij ≤ X₀ := hFD.trans hDX₀
      have key : ∀ k, X.basicOpen gij ≤ X.basicOpen (gi k) → ∀ hkk : W i ⊓ W j ≤ W k,
          (M.presheaf.map (homOfLE (X.basicOpen_le gij)).op).hom
            ((M.presheaf.map (homOfLE hkk).op).hom (t' k)) =
          ((X.presheaf.map (homOfLE hFX).op).hom g) ^ N₁ •
            (M.presheaf.map (homOfLE hFD).op).hom s := by
        intro k hk hkk
        have hk' : X.basicOpen gij ≤ W k := hk.trans (hEW k)
        rw [resG _ _ _ _ _ hk', ← resG _ _ _ (hEW k) hk hk', ← hB k, smulres, map_pow,
          resX _ _ _ _ _ hFX, resG _ _ _ _ _ hFD]
      rw [map_sub, key i hFi inf_le_left, key j hFj inf_le_right, sub_self]
    choose m hm using hC

    let Mx := ∑ q : Fin r × Fin r, m q.1 q.2
    let u : ∀ i, Γ(M, W i) := fun i => (gi i) ^ Mx • t' i
    have hcompat : TopCat.Presheaf.IsCompatible
        (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X).obj W u := by
      intro i j
      have hle : m i j ≤ Mx := Finset.single_le_sum (f := fun q : Fin r × Fin r => m q.1 q.2)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ (i, j))
      have e1 : ∀ k (hk : W i ⊓ W j ≤ W k), (M.presheaf.map (homOfLE hk).op).hom (u k) =
          ((X.presheaf.map (homOfLE (inf_le_left.trans (hWle i) : W i ⊓ W j ≤ X₀)).op).hom g) ^ Mx •
          (M.presheaf.map (homOfLE hk).op).hom (t' k) := by
        intro k hk
        show (M.presheaf.map (homOfLE hk).op).hom ((gi k) ^ Mx • t' k) = _
        rw [smulres, map_pow, resX _ _ _ (hWle k) hk (inf_le_left.trans (hWle i))]
      change (M.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op).hom (u i) =
        (M.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op).hom (u j)
      rw [e1 i inf_le_left, e1 j inf_le_right, ← sub_eq_zero, ← smul_sub,
        ← Nat.sub_add_cancel hle, pow_add, mul_smul, hm i j, smul_zero]
    have hcov' : X₀ ≤ iSup W := fun x hx => TopologicalSpace.Opens.mem_iSup.mpr (hcov x hx)
    obtain ⟨T, hT, -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) W X₀ (fun i => homOfLE (hWle i)) hcov' u hcompat
    refine ⟨N₁ + Mx, T, ?_⟩

    have hcovD : X.basicOpen g ≤ iSup (fun i => X.basicOpen (gi i)) := by
      intro x hx
      obtain ⟨i, hi⟩ := hcov x (hDX₀ hx)
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨i, ?_⟩
      rw [hE i]
      exact ⟨hi, hx⟩
    refine TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X)
      (fun i => X.basicOpen (gi i)) (X.basicOpen g) (fun i => homOfLE (hED i)) hcovD _ _
      (fun i => ?_)
    have hTi : (M.presheaf.map (homOfLE (hWle i)).op).hom T = (gi i) ^ Mx • t' i := hT i
    change (M.presheaf.map (homOfLE (hED i)).op).hom
        (((X.presheaf.map (homOfLE hDX₀).op).hom g) ^ (N₁ + Mx) • s) =
      (M.presheaf.map (homOfLE (hED i)).op).hom ((M.presheaf.map (homOfLE hDX₀).op).hom T)
    rw [smulres, map_pow, hgE' i, add_comm N₁ Mx, pow_add, mul_smul, hB i,
      resG _ _ _ _ _ (hEX i), ← resG _ _ _ (hWle i) (hEW i) (hEX i), hTi,
      smulres (W i) _ (hEW i) ((gi i) ^ Mx) (t' i), map_pow, hgE i]

  have fin : ∀ U : X.Opens, IsAffineOpen U → Module.Finite Γ(X, U) Γ(M, U) := by
    intro U hU
    obtain ⟨p, g, hspan, -, hloc'⟩ := cover U hU
    have hfinD : ∀ a, Module.Finite Γ(X, X.basicOpen (g a)) Γ(M, X.basicOpen (g a)) :=
      fun a => (hloc' _ (hU.basicOpen (g a)) ⟨a, le_rfl⟩).1
    choose q e he using fun a => @Module.Finite.exists_fin _ _ _ _ _ (hfinD a)
    choose nn tt htt using fun (c : Σ a, Fin (q a)) => lift U hU (g c.1) (e c.1 c.2)
    let N : Submodule Γ(X, U) Γ(M, U) := Submodule.span Γ(X, U) (Set.range tt)
    have hlocmem : ∀ (x : Γ(M, U)) (a : Fin p), ∃ L : ℕ, g a ^ L • x ∈ N := by
      intro x a
      have htt' : ∀ k, ((X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (g a)) ^ (nn ⟨a, k⟩) •
          e a k = (M.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (tt ⟨a, k⟩) :=
        fun k => htt ⟨a, k⟩
      have hx : (M.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom x ∈
          Submodule.span Γ(X, X.basicOpen (g a)) (Set.range (e a)) := by
        rw [he a]; trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
      haveI := hU.isLocalization_basicOpen (g a)
      choose m d hd using fun k =>
        IsLocalization.Away.surj (S := Γ(X, X.basicOpen (g a))) (g a) (c k)
      have hd' : ∀ k, c k * ((X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (g a)) ^ m k =
          (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (d k) := hd
      obtain ⟨A, hA⟩ : ∃ A, A = ∑ k, m k := ⟨_, rfl⟩
      obtain ⟨B, hB⟩ : ∃ B, B = ∑ k, nn ⟨a, k⟩ := ⟨_, rfl⟩
      obtain ⟨y, hydef⟩ : ∃ y : Γ(M, U), y = g a ^ (A + B) • x -
          ∑ k, (g a ^ ((A - m k) + (B - nn ⟨a, k⟩)) * d k) • tt ⟨a, k⟩ := ⟨_, rfl⟩
      have hy : (M.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom y = 0 := by
        rw [hydef, map_sub, smulres, map_pow, ← hc, Finset.smul_sum, map_sum, sub_eq_zero]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [smulres, ← htt' k, smul_smul, smul_smul]
        congr 1
        rw [map_mul, map_pow, ← hd' k]
        have h1 : m k ≤ A := hA ▸ Finset.single_le_sum (f := m) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ k)
        have h2 : nn ⟨a, k⟩ ≤ B := hB ▸ Finset.single_le_sum (f := fun k => nn ⟨a, k⟩)
          (fun _ _ => Nat.zero_le _) (Finset.mem_univ k)
        conv_lhs => rw [← Nat.sub_add_cancel h1, ← Nat.sub_add_cancel h2]
        ring
      obtain ⟨K, hK⟩ := kill U hU (g a) y hy
      refine ⟨K + (A + B), ?_⟩
      have e1 : g a ^ (K + (A + B)) • x = g a ^ K • y +
          g a ^ K • ∑ k, (g a ^ ((A - m k) + (B - nn ⟨a, k⟩)) * d k) • tt ⟨a, k⟩ := by
        rw [← smul_add, hydef, sub_add_cancel, pow_add, mul_smul]
      rw [e1, hK, zero_add]
      exact N.smul_mem _ (N.sum_mem (fun k _ => N.smul_mem _ (Submodule.subset_span ⟨⟨a, k⟩, rfl⟩)))
    have hN : N = ⊤ := by
      rw [eq_top_iff]
      intro x _
      choose L hL using hlocmem x
      obtain ⟨L0, hL0⟩ : ∃ L0, L0 = ∑ a, L a := ⟨_, rfl⟩
      have hpow : Ideal.span (Set.range fun a => g a ^ L0) = ⊤ := by
        have h := Ideal.span_pow_eq_top _ hspan L0
        rw [← Set.range_comp] at h
        exact h
      have h1 : (1 : Γ(X, U)) ∈ Ideal.span (Set.range fun a => g a ^ L0) := by
        rw [hpow]; exact Submodule.mem_top
      obtain ⟨rr, hr⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
      rw [← one_smul Γ(X, U) x, ← hr, Finset.sum_smul]
      refine N.sum_mem (fun a _ => ?_)
      rw [mul_smul]
      refine N.smul_mem _ ?_
      have hle : L a ≤ L0 := hL0 ▸ Finset.single_le_sum (f := L) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ a)
      rw [← Nat.sub_add_cancel hle, pow_add, mul_smul]
      exact N.smul_mem _ (hL a)
    exact ⟨by rw [← hN]; exact Submodule.fg_span (Set.finite_range tt)⟩
  exact ⟨fun U hU f => ⟨lift U hU f, kill U hU f⟩, fin⟩

theorem wc_cn_kernel_qcoh : ∀ (X : Scheme.{u}) (L' L : X.Modules) (b : L' ⟶ L), wcQcoh L' → wcQcoh L → wcQcoh (Limits.kernel b) :=
by
  intro X L' L b hL' hL U hU f
  have wc_modules_ses_left_exact : ∀ (S : ShortComplex X.Modules), S.ShortExact →
      (∀ U : X.Opens, Function.Injective (Scheme.Modules.Hom.app S.f U)) ∧
      ∀ (U : X.Opens) (y : Γ(S.X₂, U)), Scheme.Modules.Hom.app S.g U y = 0 →
        ∃ x, Scheme.Modules.Hom.app S.f U x = y := by
    intro S hS
    refine ⟨fun U => ?_, fun U y hy => ?_⟩
    · exact (AddCommGrpCat.mono_iff_injective _).mp
        (@Functor.map_mono _ _ _ _
          (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
            (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
          inferInstance _ _ S.f hS.mono_f)
    · letI : (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
          (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U) :
            X.Modules ⥤ AddCommGrpCat.{u}).PreservesZeroMorphisms :=
        ⟨fun _ _ => Scheme.Modules.Hom.zero_app⟩
      have hE := hS.exact.map_of_mono_of_preservesKernel
        (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
          (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
        hS.mono_f (@Limits.PreservesLimitsOfShape.preservesLimit _ _ _ _ _ _
          (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
            (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
          (Limits.PreservesFiniteLimits.preservesFiniteLimits Limits.WalkingParallelPair) _)
      obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy
      exact ⟨x, hx⟩
  have hS1 : (ShortComplex.mk (Limits.kernel.ι b) (Abelian.coimage.π b)
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (Limits.kernel.ι b))
      inferInstance inferInstance
  have hS2 : (ShortComplex.mk (Abelian.factorThruCoimage b)
      (Limits.cokernel.π (Abelian.factorThruCoimage b)) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
  obtain ⟨K1, E1⟩ := wc_modules_ses_left_exact _ hS1
  obtain ⟨K2, -⟩ := wc_modules_ses_left_exact _ hS2
  have K1' : ∀ V, Function.Injective (Scheme.Modules.Hom.app (Limits.kernel.ι b) V) := K1
  have K2' : ∀ V, Function.Injective (Scheme.Modules.Hom.app (Abelian.factorThruCoimage b) V) :=
    K2
  have E1' : ∀ V (y : Γ(L', V)), Scheme.Modules.Hom.app (Abelian.coimage.π b) V y = 0 →
      ∃ x, Scheme.Modules.Hom.app (Limits.kernel.ι b) V x = y := E1
  have capp : ∀ {P Q R : X.Modules} (g : P ⟶ Q) (k : Q ⟶ R) (V : X.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (g ≫ k) V x =
        Scheme.Modules.Hom.app k V (Scheme.Modules.Hom.app g V x) := by
    intro P Q R g k V x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : X.Modules} (V : X.Opens) (x : Γ(P, V)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) V x = 0 := by
    intro P Q V x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have nat : ∀ {P Q : X.Modules} (g : P ⟶ Q) (x : Γ(P, U)),
      Scheme.Modules.Hom.app g (X.basicOpen f)
          ((P.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom x) =
        (Q.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (Scheme.Modules.Hom.app g U x) := by
    intro P Q g x
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g)
      (homOfLE (X.basicOpen_le f)).op x
  have rsmul : ∀ {P : X.Modules} (r : Γ(X, U)) (x : Γ(P, U)),
      (P.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (r • x) =
        (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom r •
          (P.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom x := by
    intro P r x
    exact Scheme.Modules.map_smul P _ r x
  have K4 : ∀ V (s : Γ(Limits.kernel b, V)),
      Scheme.Modules.Hom.app b V (Scheme.Modules.Hom.app (Limits.kernel.ι b) V s) = 0 := by
    intro V s
    rw [← capp, Limits.kernel.condition, zapp]
  have K3 : ∀ V (y : Γ(L', V)), Scheme.Modules.Hom.app b V y = 0 →
      ∃ x, Scheme.Modules.Hom.app (Limits.kernel.ι b) V x = y := by
    intro V y hy
    apply E1' V y
    apply K2' V
    rw [← capp, Abelian.coimage.fac, hy, map_zero]
  refine ⟨fun s => ?_, fun t ht => ?_⟩
  · obtain ⟨n, t, ht⟩ := (hL' U hU f).1 (Scheme.Modules.Hom.app (Limits.kernel.ι b) _ s)
    have h0 : (L.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (Scheme.Modules.Hom.app b U t) = 0 := by
      rw [← nat, ← ht, Scheme.Modules.Hom.app_smul, K4, smul_zero]
    obtain ⟨m, hm⟩ := (hL U hU f).2 _ h0
    rw [← Scheme.Modules.Hom.app_smul] at hm
    obtain ⟨t₀, ht₀⟩ := K3 U _ hm
    refine ⟨m + n, t₀, K1' _ ?_⟩
    rw [Scheme.Modules.Hom.app_smul, nat, ht₀, rsmul, ← ht, map_pow, pow_add, mul_smul]
  · have h1 : (L'.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (Scheme.Modules.Hom.app (Limits.kernel.ι b) U t) = 0 := by
      rw [← nat, ht, map_zero]
    obtain ⟨n, hn⟩ := (hL' U hU f).2 _ h1
    refine ⟨n, K1' U ?_⟩
    rw [Scheme.Modules.Hom.app_smul, hn, map_zero]

theorem wc_cn_coimage_coherent : ∀ (X : Scheme.{u}) (L' L : X.Modules) (b : L' ⟶ L), wcCoherentMod L' → wcCoherentMod L → wcQcoh (Limits.kernel b) → wcCoherentMod (Abelian.coimage b) ∧ ∀ U : X.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app (Abelian.coimage.π b) U) :=
by
  intro X L' L b hL' hL hK
  have hN : ∀ {M N : X.Modules} (φ : M ⟶ N) {W W' : X.Opens} (hle : W' ≤ W) (x : Γ(M, W)),
      Scheme.Modules.Hom.app φ W' (M.presheaf.map (homOfLE hle).op x) =
        N.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app φ W x) :=
    fun φ _ _ hle x =>
      NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf φ) (homOfLE hle).op x
  have hS1 : (ShortComplex.mk (Limits.kernel.ι b) (Abelian.coimage.π b)
      (Limits.cokernel.condition (Limits.kernel.ι b))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (Limits.kernel.ι b))
      inferInstance inferInstance
  have hsurj : ∀ U : X.Opens, IsAffineOpen U →
      Function.Surjective (Scheme.Modules.Hom.app (Abelian.coimage.π b) U) :=
    wc_modules_ses_affine_surj X _ hS1 hK
  have hS2 : (ShortComplex.mk (Abelian.factorThruCoimage b)
      (Limits.cokernel.π (Abelian.factorThruCoimage b))
      (Limits.cokernel.condition (Abelian.factorThruCoimage b))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (Abelian.factorThruCoimage b))
      inferInstance inferInstance
  have hinj : ∀ V : X.Opens,
      Function.Injective (Scheme.Modules.Hom.app (Abelian.factorThruCoimage b) V) :=
    (wc_modules_ses_left_exact X _ hS2).1
  refine ⟨⟨?_, ?_⟩, hsurj⟩
  · intro U hU f
    have hD := hU.basicOpen f
    constructor
    · intro s
      obtain ⟨y, rfl⟩ := hsurj _ hD s
      obtain ⟨n, t, ht⟩ := (hL'.1 U hU f).1 y
      refine ⟨n, Scheme.Modules.Hom.app (Abelian.coimage.π b) U t, ?_⟩
      rw [← Scheme.Modules.Hom.app_smul, ht]
      exact hN (Abelian.coimage.π b) (X.basicOpen_le f) t
    · intro t ht
      have h0 : L.presheaf.map (homOfLE (X.basicOpen_le f)).op
          (Scheme.Modules.Hom.app (Abelian.factorThruCoimage b) U t) = 0 := by
        rw [← hN, ht, map_zero]
      obtain ⟨n, hn⟩ := (hL.1 U hU f).2 _ h0
      refine ⟨n, ?_⟩
      apply hinj U
      rw [Scheme.Modules.Hom.app_smul, hn, map_zero]
  · intro U hU
    haveI := hL'.2 U hU
    exact Module.Finite.of_surjective
      ({ toFun := fun x => Scheme.Modules.Hom.app (Abelian.coimage.π b) U x,
         map_add' := fun x y => map_add _ x y,
         map_smul' := fun r x => Scheme.Modules.Hom.app_smul (Abelian.coimage.π b) r x } :
        Γ(L', U) →ₗ[Γ(X, U)] Γ(Abelian.coimage b, U)) (hsurj U hU)

theorem wc_cn_modules_hom_ext_affine : ∀ (X : Scheme.{u}) (M N : X.Modules) (f g : M ⟶ N), (∀ (U : X.Opens), IsAffineOpen U → ∀ x : Γ(M, U), Scheme.Modules.Hom.app f U x = Scheme.Modules.Hom.app g U x) → f = g :=
by
  intro X M N f g H
  apply Scheme.Modules.hom_ext
  intro U
  ext x
  let ι := {V : X.Opens // IsAffineOpen V ∧ V ≤ U}
  let W : ι → X.Opens := fun i => i.1
  have hcov : U ≤ iSup W := by
    intro y hy
    obtain ⟨V', hV', hyV', hV'U⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X)) hy
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨V', hV', hV'U⟩, hyV'⟩
  let NS : TopCat.Sheaf Ab.{u} X := ⟨N.presheaf, N.isSheaf⟩
  refine TopCat.Sheaf.eq_of_locally_eq' NS W U (fun i => homOfLE i.2.2) hcov _ _ ?_
  intro i
  have h1 := NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf f) (homOfLE i.2.2).op x
  have h2 := NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g) (homOfLE i.2.2).op x
  simp only [Scheme.Modules.mapPresheaf_app] at h1 h2
  change N.presheaf.map (homOfLE i.2.2).op (Scheme.Modules.Hom.app f U x) =
    N.presheaf.map (homOfLE i.2.2).op (Scheme.Modules.Hom.app g U x)
  rw [← h1, ← h2]
  exact H i.1 i.2.1 _

theorem wc_cn_quotient_system : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (I : Ideal B) (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (L : Z.Modules), wcCoherentMod L → ∃ (Es : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n) (φE : ∀ n, L ⟶ Es n), wcCnAdicSys h I Es ψE ∧ wcCnAlg h I Es ψE L φE ∧ (∀ n, Epi (φE n)) ∧ ∀ (n : ℕ) (G : Z.Modules) (a : L ⟶ G), (∀ U : Z.Opens, IsAffineOpen U → Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(G, U)) = ⊥) → ∃ a' : Es n ⟶ G, φE n ≫ a' = a :=
by
  intro B _ _ I Z h H hH

  have capp : ∀ {P Q R : Z.Modules} (f : P ⟶ Q) (k : Q ⟶ R) (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ k) U x =
        Scheme.Modules.Hom.app k U (Scheme.Modules.Hom.app f U x) := by
    intro P Q R f k U x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : Z.Modules} (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) U x = 0 := by
    intro P Q U x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have iapp : ∀ {P : Z.Modules} (U : Z.Opens) (x : Γ(P, U)),
      Scheme.Modules.Hom.app (𝟙 P) U x = x := by
    intro P U x
    rw [Scheme.Modules.Hom.id_app]
    rfl
  have smapp : ∀ {P Q : Z.Modules} (f : P ⟶ Q) (U : Z.Opens) (r : Γ(Z, U)) (x : Γ(P, U)),
      Scheme.Modules.Hom.app f U (r • x) = r • Scheme.Modules.Hom.app f U x :=
    fun f U r x => Scheme.Modules.Hom.app_smul f r x
  have hsmul : ∀ {P Q : Z.Modules} (f : P ⟶ Q) (U : Z.Opens) (J : Ideal Γ(Z, U)) (x : Γ(P, U)),
      x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(P, U)) →
        Scheme.Modules.Hom.app f U x ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U)) := by
    intro P Q f U J x hx
    refine Submodule.smul_induction_on
      (p := fun y => Scheme.Modules.Hom.app f U y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))) hx ?_ ?_
    · intro r hr y _
      show Scheme.Modules.Hom.app f U (r • y) ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [smapp]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro y y' hy hy'
      show Scheme.Modules.Hom.app f U (y + y') ∈ J • (⊤ : Submodule Γ(Z, U) Γ(Q, U))
      rw [map_add]
      exact Submodule.add_mem _ hy hy'

  have sres : ∀ (c : B) (U V : Z.Opens) (i : V ⟶ U),
      (Z.presheaf.map i.op).hom (wcCnSigma h U c) = wcCnSigma h V c := by
    intro c U V i
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← RingHom.comp_apply (Z.presheaf.map i.op).hom, ← CommRingCat.hom_comp,
      ← Functor.map_comp]
    rfl

  have s1 : ∀ (M : Z.Modules) (c : B), ∃ μ : M ⟶ M, ∀ (U : Z.Opens) (s : Γ(M, U)),
      Scheme.Modules.Hom.app μ U s = wcCnSigma h U c • s := by
    intro M c
    let α : M.val.presheaf ⟶ M.val.presheaf :=
      { app := fun U => AddCommGrpCat.ofHom
          (DistribSMul.toAddMonoidHom Γ(M, U.unop) (wcCnSigma h U.unop c))
        naturality := by
          intro U V i
          ext s
          have e1 := Scheme.Modules.map_smul M i.unop (wcCnSigma h U.unop c) s
          rw [sres c U.unop V.unop i.unop] at e1
          exact e1.symm }
    refine ⟨⟨PresheafOfModules.homMk α ?_⟩, fun U s => rfl⟩
    intro X r m
    have key : ∀ (a b : Γ(Z, X.unop)) (x : Γ(M, X.unop)), a • (b • x) = b • (a • x) :=
      fun a b x => by rw [smul_smul, smul_smul, mul_comm]
    exact key (wcCnSigma h X.unop c) r m

  have s2 : ∀ (M : Z.Modules) (c : B), wcCoherentMod M → ∃ (Q : Z.Modules) (π : M ⟶ Q),
      wcCoherentMod Q ∧
      (∀ U : Z.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app π U) ∧
        ∀ s : Γ(M, U), Scheme.Modules.Hom.app π U s = 0 ↔
          ∃ y : Γ(M, U), s = wcCnSigma h U c • y) ∧
      (∀ (T : Z.Modules) (g : M ⟶ T), (∀ U : Z.Opens, IsAffineOpen U → ∀ y : Γ(M, U),
        Scheme.Modules.Hom.app g U (wcCnSigma h U c • y) = 0) → ∃ g' : Q ⟶ T, π ≫ g' = g) ∧
      Epi π := by
    intro M c hM
    obtain ⟨μ, hμ⟩ := s1 M c
    have hfac : Abelian.coimage.π μ ≫ Abelian.factorThruCoimage μ = μ := Abelian.coimage.fac μ
    have hK : wcQcoh (Limits.kernel μ) := wc_cn_kernel_qcoh Z M M μ hM.1 hM.1
    obtain ⟨hIcoh, hps⟩ := wc_cn_coimage_coherent Z M M μ hM hM hK
    obtain ⟨hSES, hQcoh, -, -⟩ := wc_dev_cokernel_coh Z (Abelian.coimage μ) M
      (Abelian.factorThruCoimage μ) inferInstance hIcoh hM
    refine ⟨Limits.cokernel (Abelian.factorThruCoimage μ), Limits.cokernel.π _, hQcoh, ?_, ?_,
      inferInstance⟩
    · intro U hU
      refine ⟨wc_modules_ses_affine_surj Z _ hSES hIcoh.1 U hU, fun s => ⟨fun hs => ?_, ?_⟩⟩
      · obtain ⟨x, hx⟩ := (wc_modules_ses_left_exact Z _ hSES).2 U s hs
        obtain ⟨z, rfl⟩ := hps U hU x
        have hx' : Scheme.Modules.Hom.app (Abelian.factorThruCoimage μ) U
            (Scheme.Modules.Hom.app (Abelian.coimage.π μ) U z) = s := hx
        refine ⟨z, ?_⟩
        rw [← hμ, ← hfac, capp]
        exact hx'.symm
      · rintro ⟨y, rfl⟩
        have e : μ ≫ Limits.cokernel.π (Abelian.factorThruCoimage μ) = 0 := by
          calc μ ≫ Limits.cokernel.π (Abelian.factorThruCoimage μ)
              = (Abelian.coimage.π μ ≫ Abelian.factorThruCoimage μ) ≫
                  Limits.cokernel.π (Abelian.factorThruCoimage μ) := by rw [hfac]
            _ = 0 := by rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
        rw [← hμ, ← capp, e, zapp]
    · intro T g hg
      have h0 : μ ≫ g = 0 := by
        apply wc_cn_modules_hom_ext_affine
        intro U hU x
        rw [capp, hμ, zapp]
        exact hg U hU x
      have h1 : Abelian.factorThruCoimage μ ≫ g = 0 := by
        rw [← cancel_epi (Abelian.coimage.π μ), ← Category.assoc, hfac, h0, Limits.comp_zero]
      exact ⟨Limits.cokernel.desc _ g h1, Limits.cokernel.π_desc _ _ _⟩

  have s3 : ∀ (S : Finset B) (M : Z.Modules), wcCoherentMod M → ∃ (Q : Z.Modules) (π : M ⟶ Q),
      wcCoherentMod Q ∧
      (∀ U : Z.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app π U) ∧
        ∀ s : Γ(M, U), Scheme.Modules.Hom.app π U s = 0 ↔
          s ∈ Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
            (⊤ : Submodule Γ(Z, U) Γ(M, U))) ∧
      (∀ (T : Z.Modules) (g : M ⟶ T), (∀ U : Z.Opens, IsAffineOpen U →
        ∀ s ∈ Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
          (⊤ : Submodule Γ(Z, U) Γ(M, U)), Scheme.Modules.Hom.app g U s = 0) →
        ∃ g' : Q ⟶ T, π ≫ g' = g) ∧
      Epi π := by
    classical
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro M hM
      have e : ∀ U : Z.Opens, Ideal.map (wcCnSigma h U) (Ideal.span ((∅ : Finset B) : Set B)) •
          (⊤ : Submodule Γ(Z, U) Γ(M, U)) = ⊥ := by
        intro U
        rw [Finset.coe_empty, Ideal.span_empty, Ideal.map_bot, Submodule.bot_smul]
      refine ⟨M, 𝟙 M, hM, fun U hU => ⟨fun s => ⟨s, iapp U s⟩, fun s => ?_⟩,
        fun T g _ => ⟨g, Category.id_comp g⟩, inferInstance⟩
      rw [e U, Submodule.mem_bot, iapp]
    | insert a S haS ih =>
      intro M hM
      obtain ⟨Q₁, π₁, hQ₁, hsec₁, huniv₁, hepi₁⟩ := ih M hM
      obtain ⟨Q₂, π₂, hQ₂, hsec₂, huniv₂, hepi₂⟩ := s2 Q₁ a hQ₁
      have espan : ∀ U : Z.Opens, ∀ s : Γ(M, U),
          s ∈ Ideal.map (wcCnSigma h U) (Ideal.span ((insert a S : Finset B) : Set B)) •
            (⊤ : Submodule Γ(Z, U) Γ(M, U)) ↔
          ∃ y : Γ(M, U), s - wcCnSigma h U a • y ∈
            Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
              (⊤ : Submodule Γ(Z, U) Γ(M, U)) := by
        intro U s
        rw [Finset.coe_insert, Ideal.span_insert, Ideal.map_sup, Submodule.sup_smul,
          Ideal.map_span, Set.image_singleton, Submodule.ideal_span_singleton_smul,
          Submodule.mem_sup]
        constructor
        · rintro ⟨u, hu, v, hv, rfl⟩
          obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hu
          exact ⟨y, by rwa [add_sub_cancel_left]⟩
        · rintro ⟨y, hy⟩
          exact ⟨wcCnSigma h U a • y,
            (Submodule.mem_smul_pointwise_iff_exists _ _ _).2 ⟨y, Submodule.mem_top, rfl⟩,
            s - wcCnSigma h U a • y, hy, by abel⟩
      haveI := hepi₁
      haveI := hepi₂
      refine ⟨Q₂, π₁ ≫ π₂, hQ₂, fun U hU => ⟨?_, fun s => ?_⟩, ?_, epi_comp π₁ π₂⟩
      · intro q
        obtain ⟨q₁, hq₁⟩ := (hsec₂ U hU).1 q
        obtain ⟨s, hs⟩ := (hsec₁ U hU).1 q₁
        exact ⟨s, by rw [capp, hs, hq₁]⟩
      · rw [espan U, capp]
        constructor
        · intro hs
          obtain ⟨y', hy'⟩ := ((hsec₂ U hU).2 _).1 hs
          obtain ⟨y, rfl⟩ := (hsec₁ U hU).1 y'
          refine ⟨y, ((hsec₁ U hU).2 _).1 ?_⟩
          rw [map_sub, smapp, hy', sub_self]
        · rintro ⟨y, hy⟩
          refine ((hsec₂ U hU).2 _).2 ⟨Scheme.Modules.Hom.app π₁ U y, ?_⟩
          rw [← smapp, ← sub_eq_zero, ← map_sub]
          exact ((hsec₁ U hU).2 _).2 hy
      · intro T g hg
        have hle : ∀ U : Z.Opens, ∀ s ∈ Ideal.map (wcCnSigma h U) (Ideal.span (S : Set B)) •
            (⊤ : Submodule Γ(Z, U) Γ(M, U)),
            s ∈ Ideal.map (wcCnSigma h U) (Ideal.span ((insert a S : Finset B) : Set B)) •
              (⊤ : Submodule Γ(Z, U) Γ(M, U)) := by
          intro U s hs
          refine (Submodule.smul_mono_left (Ideal.map_mono (Ideal.span_mono ?_))) hs
          rw [Finset.coe_insert]
          exact Set.subset_insert _ _
        obtain ⟨g₁, hg₁⟩ := huniv₁ T g (fun U hU s hs => hg U hU s (hle U s hs))
        obtain ⟨g₂, hg₂⟩ := huniv₂ T g₁ (by
          intro U hU q
          obtain ⟨z, rfl⟩ := (hsec₁ U hU).1 q
          rw [← smapp, ← capp, hg₁]
          apply hg U hU
          refine (espan U _).2 ⟨z, ?_⟩
          rw [sub_self]
          exact Submodule.zero_mem _)
        exact ⟨g₂, by rw [Category.assoc, hg₂, hg₁]⟩

  have hFG : ∀ n : ℕ, ∃ S : Finset B, Ideal.span (S : Set B) = I ^ (n + 1) := fun n =>
    IsNoetherian.noetherian (I ^ (n + 1))
  choose S hS using hFG
  have lev : ∀ n : ℕ, ∃ (Q : Z.Modules) (π : H ⟶ Q), wcCoherentMod Q ∧
      (∀ U : Z.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app π U) ∧
        ∀ s : Γ(H, U), Scheme.Modules.Hom.app π U s = 0 ↔
          s ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(H, U))) ∧
      (∀ (T : Z.Modules) (g : H ⟶ T), (∀ U : Z.Opens, IsAffineOpen U →
        ∀ s ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(H, U)),
          Scheme.Modules.Hom.app g U s = 0) → ∃ g' : Q ⟶ T, π ≫ g' = g) ∧
      Epi π := by
    intro n
    have := s3 (S n) H hH
    rw [hS n] at this
    exact this
  choose Hs φ hcoh hsec huniv hepi using lev

  have trans : ∀ n, ∃ ψ : Hs (n + 1) ⟶ Hs n, φ (n + 1) ≫ ψ = φ n := by
    intro n
    refine huniv (n + 1) (Hs n) (φ n) (fun U hU s hs => ((hsec n U hU).2 s).2 ?_)
    exact (Submodule.smul_mono_left (Ideal.map_mono (Ideal.pow_le_pow_right (by omega)))) hs
  choose ψ hψ using trans
  have hψapp : ∀ n (U : Z.Opens) (x : Γ(H, U)),
      Scheme.Modules.Hom.app (ψ n) U (Scheme.Modules.Hom.app (φ (n + 1)) U x) =
        Scheme.Modules.Hom.app (φ n) U x := by
    intro n U x
    rw [← capp, hψ]

  have hkill : ∀ n (U : Z.Opens), IsAffineOpen U →
      Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(Hs n, U)) = ⊥ := by
    intro n U hU
    rw [eq_bot_iff]
    intro m hm
    rw [Submodule.mem_bot]
    refine Submodule.smul_induction_on (p := fun m => m = 0) hm ?_ ?_
    · intro r hr q _
      show r • q = 0
      obtain ⟨x, rfl⟩ := (hsec n U hU).1 q
      rw [← smapp]
      exact ((hsec n U hU).2 _).2 (Submodule.smul_mem_smul hr Submodule.mem_top)
    · intro x y hx hy
      show x + y = 0
      rw [hx, hy, add_zero]

  have hfact : ∀ (n : ℕ) (G : Z.Modules) (a : H ⟶ G), (∀ U : Z.Opens, IsAffineOpen U →
      Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(G, U)) = ⊥) →
      ∃ a' : Hs n ⟶ G, φ n ≫ a' = a := by
    intro n G a hG
    refine huniv n G a (fun U hU s hs => ?_)
    have h1 := hsmul a U _ s hs
    rw [hG U hU] at h1
    exact (Submodule.mem_bot _).1 h1
  refine ⟨Hs, ψ, φ, ⟨hcoh, fun n U hU => ⟨?_, fun s => ⟨fun hs => ?_, fun hs => ?_⟩⟩, hkill⟩,
    ⟨hH, hψ, hsec⟩, hepi, hfact⟩
  · intro q
    obtain ⟨x, rfl⟩ := (hsec n U hU).1 q
    exact ⟨_, hψapp n U x⟩
  · obtain ⟨x, rfl⟩ := (hsec (n + 1) U hU).1 s
    rw [hψapp] at hs
    exact hsmul _ U _ x (((hsec n U hU).2 x).1 hs)
  · have h1 := hsmul (ψ n) U _ s hs
    rw [hkill n U hU] at h1
    exact (Submodule.mem_bot _).1 h1

theorem wc_cn_affine_surj_of_chart_surj : ∀ (X : Scheme.{u}) (M N : X.Modules) (a : M ⟶ N) (r : ℕ) (U : Fin r → X.Opens), wcCoherentMod M → wcCoherentMod N → (∀ k, IsAffineOpen (U k)) → (∀ x : X, ∃ k, x ∈ U k) → (∀ k, Function.Surjective (Scheme.Modules.Hom.app a (U k))) → ∀ V : X.Opens, IsAffineOpen V → Function.Surjective (Scheme.Modules.Hom.app a V) :=
by
  intro X M N a r U hM hN hU hcov hsurj V hV
  have capp : ∀ {P Q R : X.Modules} (g : P ⟶ Q) (k : Q ⟶ R) (W : X.Opens) (x : Γ(P, W)),
      Scheme.Modules.Hom.app (g ≫ k) W x =
        Scheme.Modules.Hom.app k W (Scheme.Modules.Hom.app g W x) := by
    intro P Q R g k W x
    rw [Scheme.Modules.Hom.comp_app]
    rfl
  have zapp : ∀ {P Q : X.Modules} (W : X.Opens) (x : Γ(P, W)),
      Scheme.Modules.Hom.app (0 : P ⟶ Q) W x = 0 := by
    intro P Q W x
    rw [Scheme.Modules.Hom.zero_app]
    rfl
  have hK := wc_cn_kernel_qcoh X M N a hM.1 hN.1
  obtain ⟨hCoim, hCoimSurj⟩ := wc_cn_coimage_coherent X M N a hM hN hK
  obtain ⟨hSE, hCcoh, -, -⟩ := wc_dev_cokernel_coh X (Abelian.coimage a) N
    (Abelian.factorThruCoimage a) inferInstance hCoim hN
  have hLE : ∀ (W : X.Opens) (y : Γ(N, W)),
      Scheme.Modules.Hom.app (Limits.cokernel.π (Abelian.factorThruCoimage a)) W y = 0 →
      ∃ x, Scheme.Modules.Hom.app (Abelian.factorThruCoimage a) W x = y := by
    intro W y hy
    letI : (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
        (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op W) :
          X.Modules ⥤ AddCommGrpCat.{u}).PreservesZeroMorphisms :=
      ⟨fun _ _ => Scheme.Modules.Hom.zero_app⟩
    have hE := hSE.exact.map_of_mono_of_preservesKernel
      (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
        (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op W))
      hSE.mono_f (@Limits.PreservesLimitsOfShape.preservesLimit _ _ _ _ _ _
        (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
          (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op W))
        (Limits.PreservesFiniteLimits.preservesFiniteLimits Limits.WalkingParallelPair) _)
    obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy
    exact ⟨x, hx⟩
  have hfac : ∀ (W : X.Opens) (x : Γ(M, W)), Scheme.Modules.Hom.app a W x =
      Scheme.Modules.Hom.app (Abelian.factorThruCoimage a) W
        (Scheme.Modules.Hom.app (Abelian.coimage.π a) W x) := by
    intro W x
    rw [← capp, Abelian.coimage.fac]
  have hchart : ∀ k (c : Γ(Limits.cokernel (Abelian.factorThruCoimage a), U k)), c = 0 := by
    intro k c
    obtain ⟨y, rfl⟩ := wc_modules_ses_affine_surj X _ hSE hCoim.1 (U k) (hU k) c
    obtain ⟨x, rfl⟩ := hsurj k y
    rw [hfac]
    change Scheme.Modules.Hom.app (Limits.cokernel.π (Abelian.factorThruCoimage a)) (U k)
      (Scheme.Modules.Hom.app (Abelian.factorThruCoimage a) (U k)
        (Scheme.Modules.Hom.app (Abelian.coimage.π a) (U k) x)) = 0
    rw [← capp, Limits.cokernel.condition, zapp]
  have hzero : ∀ (W : X.Opens) (c : Γ(Limits.cokernel (Abelian.factorThruCoimage a), W)),
      c = 0 := by
    intro W c
    let J := {p : (Σ k : Fin r, Γ(X, U k)) // X.basicOpen p.2 ≤ W}
    let D : J → X.Opens := fun p => X.basicOpen p.1.2
    have hcovW : W ≤ iSup D := by
      intro y hy
      obtain ⟨k, hk⟩ := hcov y
      obtain ⟨f, hfW, hyf⟩ := (hU k).exists_basicOpen_le (V := W) ⟨y, hy⟩ hk
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨k, f⟩, hfW⟩, hyf⟩
    let CS : TopCat.Sheaf Ab.{u} X :=
      ⟨(Limits.cokernel (Abelian.factorThruCoimage a)).presheaf,
        (Limits.cokernel (Abelian.factorThruCoimage a)).isSheaf⟩
    refine TopCat.Sheaf.eq_of_locally_eq' CS D W (fun p => homOfLE p.2) hcovW _ _ ?_
    intro p
    obtain ⟨⟨k, f⟩, hfW⟩ := p
    change ((Limits.cokernel (Abelian.factorThruCoimage a)).presheaf.map (homOfLE hfW).op).hom c =
      ((Limits.cokernel (Abelian.factorThruCoimage a)).presheaf.map (homOfLE hfW).op).hom 0
    rw [map_zero]
    obtain ⟨n, t, ht⟩ := (hCcoh.1 (U k) (hU k) f).1
      (((Limits.cokernel (Abelian.factorThruCoimage a)).presheaf.map (homOfLE hfW).op).hom c)
    rw [hchart k t, map_zero] at ht
    have hunit : IsUnit (((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n) :=
      (RingedSpace.isUnit_res_basicOpen X.toRingedSpace f).pow n
    exact hunit.smul_left_cancel.mp (ht.trans (smul_zero _).symm)
  intro s
  obtain ⟨y, hy⟩ := hLE V s (hzero V _)
  obtain ⟨x, rfl⟩ := hCoimSurj V hV y
  exact ⟨x, (hfac V x).trans hy⟩

theorem wc_cn_twist_raise : ∀ (Z : Scheme.{u}) (m : ℕ) (g : Z ⟶ wcPm.{u} m) (e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), (∀ k, e k k = 1) → (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k j) = (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k l) * (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m l)).op (e l j)) → ∀ (F : Z.Modules) (w r : ℕ) (k : Fin (m + 1)) (s : ∀ l : Fin (m + 1), Γ(F, g ⁻¹ᵁ wcPmChart m l)), wcCnTwisted g e F w s → ∃ s' : ∀ l : Fin (m + 1), Γ(F, g ⁻¹ᵁ wcPmChart m l), wcCnTwisted g e F (w + r) s' ∧ s' k = s k :=
by
  intro Z m g e he1 he3 F w r k s hs
  have resZ : ∀ {U V W : Z.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Z, U)),
      (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
      (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have smulM : ∀ {U V : Z.Opens} (h : V ≤ U) (c : Γ(Z, U)) (x : Γ(F, U)),
      (F.presheaf.map (homOfLE h).op).hom (c • x) =
      (Z.presheaf.map (homOfLE h).op).hom c • (F.presheaf.map (homOfLE h).op).hom x :=
    fun h c x => Scheme.Modules.map_smul F (homOfLE h) c x
  have natg : ∀ {A B : (wcPm.{u} m).Opens} (h : B ≤ A) (x : Γ(wcPm.{u} m, A)),
      g.app B ((wcPm.{u} m).presheaf.map (homOfLE h).op x) =
      (Z.presheaf.map (homOfLE (g.preimage_mono h)).op).hom (g.app A x) := by
    intro A B h x
    exact congrArg (fun f => f.hom x) (g.naturality (homOfLE h).op)
  have hT : ∀ a b c : Fin (m + 1),
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a c)) =
      (Z.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ wcPmChart m a)).op).hom (g.app (wcPmChart m a) (e a b)) *
      (Z.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ wcPmChart m b)).op).hom (g.app (wcPmChart m b) (e b c)) := by
    intro a b c
    have hW : g ⁻¹ᵁ wcPmChart m a ⊓ g ⁻¹ᵁ wcPmChart m b ≤
        g ⁻¹ᵁ (wcPmChart m a ⊓ wcPmChart m b) := g.preimage_inf.ge
    have key := congrArg (fun x => (Z.presheaf.map (homOfLE hW).op).hom
      (g.app (wcPmChart m a ⊓ wcPmChart m b) x)) (he3 a b c)
    simp only [map_mul] at key
    rw [natg, natg, natg, resZ, resZ, resZ] at key
    exact key
  refine ⟨fun l => (g.app (wcPmChart m l) (e l k)) ^ r • s l, ?_, ?_⟩
  · intro a b
    dsimp only
    rw [smulM, smulM, map_pow, map_pow, hs a b, hT a b k, smul_smul, smul_smul]
    congr 1
    ring
  · dsimp only
    rw [he1, map_one, one_pow, one_smul]

theorem wc_cn_twisted_presentation : wcCnUnifLift.{u} →
    ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) (m : ℕ) (g : Z ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift h g) →
    ∀ (Gs : ℕ → Z.Modules) (ψ : ∀ n, Gs (n + 1) ⟶ Gs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Gs ψ →
    ∃ (L : Z.Modules) (Es : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n) (φE : ∀ n, L ⟶ Es n)
      (α : ∀ n, Es n ⟶ Gs n),
      wcCnLocFree L ∧ wcCnAdicSys h (IsLocalRing.maximalIdeal B) Es ψE ∧
      wcCnAlg h (IsLocalRing.maximalIdeal B) Es ψE L φE ∧
      (∀ n, α (n + 1) ≫ ψ n = ψE n ≫ α n) ∧
      (∀ n (U : Z.Opens), IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app (α n) U)) :=
by
  intro H B _ _ _ Z h m g hg Gs ψ hG
  classical

  obtain ⟨e, he1, he2, he3, he4⟩ := wc_pm_chart_coords.{u} m
  obtain ⟨hUaff, hcov⟩ := wc_pm_chart_cover B Z h m g hg

  obtain ⟨d₀, hd₀⟩ := H B Z h m g hg e he1 he2 he3 he4 Gs ψ hG

  obtain ⟨D, q, sg, hsgtw, hsggen⟩ := wc_cn_twisted_generation B Z h m g hg e he1 he2 he3 (Gs 0)
    (hG.1 0).1 (fun k => (hG.1 0).2 _ (hUaff k))
  obtain ⟨d, hd0, hdD⟩ : ∃ d, d₀ ≤ d ∧ D ≤ d := ⟨max d₀ D, le_max_left _ _, le_max_right _ _⟩
  have hDd : D + (d - D) = d := Nat.add_sub_cancel' hdD
  have hraise : ∀ p : Fin (m + 1) × Fin q, ∃ s' : ∀ l, Γ(Gs 0, g ⁻¹ᵁ wcPmChart m l),
      wcCnTwisted g e (Gs 0) d s' ∧ s' p.1 = sg p.2 p.1 := by
    intro p
    obtain ⟨s', h1, h2⟩ := wc_cn_twist_raise Z m g e he1 he3 (Gs 0) D (d - D) p.1 (sg p.2)
      (hsgtw p.2)
    rw [hDd] at h1
    exact ⟨s', h1, h2⟩
  choose sr hsrtw hsrk using hraise
  obtain ⟨t, s0, hs0tw, hs0gen⟩ : ∃ (t : ℕ) (s0 : Fin t → ∀ k, Γ(Gs 0, g ⁻¹ᵁ wcPmChart m k)),
      (∀ i, wcCnTwisted g e (Gs 0) d (s0 i)) ∧
      ∀ k, Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k) (Set.range fun i => s0 i k) = ⊤ := by
    refine ⟨(m + 1) * q, fun i => sr (finProdFinEquiv.symm i), fun i => hsrtw _, ?_⟩
    intro k
    rw [eq_top_iff, ← hsggen k]
    apply Submodule.span_mono
    rintro _ ⟨ρ, rfl⟩
    refine ⟨finProdFinEquiv (k, ρ), ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hsrk (k, ρ)

  have hlift : ∀ n (s : Fin t → ∀ k, Γ(Gs n, g ⁻¹ᵁ wcPmChart m k)),
      (∀ i, wcCnTwisted g e (Gs n) d (s i)) →
      ∃ s' : Fin t → ∀ k, Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k),
        (∀ i, wcCnTwisted g e (Gs (n + 1)) d (s' i)) ∧
        ∀ i k, Scheme.Modules.Hom.app (ψ n) (g ⁻¹ᵁ wcPmChart m k) (s' i k) = s i k := by
    intro n s hs
    choose s' hs' hs'' using fun i => hd₀ d hd0 n (s i) (hs i)
    exact ⟨s', hs', hs''⟩
  choose lift hlifttw hliftψ using hlift
  let T : ∀ n, {S : Fin t → ∀ k, Γ(Gs n, g ⁻¹ᵁ wcPmChart m k) //
      ∀ i, wcCnTwisted g e (Gs n) d (S i)} := fun n =>
    Nat.rec (motive := fun n => {S : Fin t → ∀ k, Γ(Gs n, g ⁻¹ᵁ wcPmChart m k) //
      ∀ i, wcCnTwisted g e (Gs n) d (S i)})
      ⟨s0, hs0tw⟩ (fun n S => ⟨lift n S.1 S.2, hlifttw n S.1 S.2⟩) n
  have hTsucc : ∀ n, (T (n + 1)).1 = lift n (T n).1 (T n).2 := fun n => rfl
  have hTψ : ∀ n i k, Scheme.Modules.Hom.app (ψ n) (g ⁻¹ᵁ wcPmChart m k) ((T (n + 1)).1 i k) =
      (T n).1 i k := by
    intro n i k
    rw [hTsucc]
    exact hliftψ n _ _ i k

  have linOf : ∀ {M M' : Z.Modules} (φ : M ⟶ M') (U : Z.Opens),
      ∃ f : Γ(M, U) →ₗ[Γ(Z, U)] Γ(M', U), ∀ x, f x = Scheme.Modules.Hom.app φ U x :=
    fun φ U => ⟨{ toFun := fun x => Scheme.Modules.Hom.app φ U x
                  map_add' := fun x y => map_add _ x y
                  map_smul' := fun r x => Scheme.Modules.Hom.app_smul φ r x }, fun _ => rfl⟩

  obtain ⟨L, ε, hεtw, hεbij⟩ := wc_cn_twist_sheaf Z m g e he1 he3 d t
  have hLloc : ∀ z : Z, ∃ (U : Z.Opens) (r : ℕ) (ε' : Fin r → Γ(L, U)), z ∈ U ∧ IsAffineOpen U ∧
      ∀ (V : Z.Opens) (hV : V ≤ U), Function.Bijective
        (fun a : Fin r → Γ(Z, V) => ∑ i, a i • (L.presheaf.map (homOfLE hV).op).hom (ε' i)) := by
    intro z
    obtain ⟨k, hk⟩ := hcov z
    exact ⟨g ⁻¹ᵁ wcPmChart m k, t, fun i => ε i k, hk, hUaff k, fun V hV => hεbij k V hV⟩
  have hLcoh : wcCoherentMod L := wc_cn_locfree_coherent Z L hLloc
  have hLfree : wcCnLocFree L := ⟨hLcoh, hLloc⟩

  obtain ⟨Es, ψE, φE, hEadic, hEalg, hepi, hfact⟩ :=
    wc_cn_quotient_system B (IsLocalRing.maximalIdeal B) Z h L hLcoh

  have hhom := fun n => wc_cn_twist_hom Z m g e hcov d t L ε hεtw hεbij (Gs n)
  choose a ha using fun n => (hhom n).1 (T n).1 (T n).2

  have hacomp : ∀ n, a (n + 1) ≫ ψ n = a n := by
    intro n
    apply (hhom n).2
    intro i k
    rw [Scheme.Modules.Hom.comp_app]
    change Scheme.Modules.Hom.app (ψ n) (g ⁻¹ᵁ wcPmChart m k)
      (Scheme.Modules.Hom.app (a (n + 1)) (g ⁻¹ᵁ wcPmChart m k) (ε i k)) = _
    rw [ha (n + 1) i k, hTψ n i k, ha n i k]

  choose α hα using fun n => hfact n (Gs n) (a n) (fun U hU => hG.2.2 n U hU)

  have hαc : ∀ n, α (n + 1) ≫ ψ n = ψE n ≫ α n := by
    intro n
    haveI := hepi (n + 1)
    rw [← cancel_epi (φE (n + 1)), ← Category.assoc, hα (n + 1), hacomp n, ← Category.assoc,
      hEalg.2.1 n, hα n]

  have hgen : ∀ n k, Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k)
      (Set.range fun i => (T n).1 i k) = ⊤ := by
    intro n
    induction n with
    | zero => exact hs0gen
    | succ n ih =>
      intro k
      obtain ⟨f, hf⟩ := linOf (ψ n) (g ⁻¹ᵁ wcPmChart m k)
      have hAd := hG.2.1 n (g ⁻¹ᵁ wcPmChart m k) (hUaff k)
      have hkill := hG.2.2 (n + 1) (g ⁻¹ᵁ wcPmChart m k) (hUaff k)
      set A := Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k)) (IsLocalRing.maximalIdeal B ^ (n + 1))
        with hA
      set A' := Ideal.map (wcCnSigma h (g ⁻¹ᵁ wcPmChart m k))
        (IsLocalRing.maximalIdeal B ^ (n + 1 + 1)) with hA'
      set S := Set.range fun i => (T (n + 1)).1 i k with hS
      set Nsub := Submodule.span Γ(Z, g ⁻¹ᵁ wcPmChart m k) S with hNsub
      have hAA : A * A ≤ A' := by
        rw [hA, hA', ← Ideal.map_mul, ← pow_add]
        exact Ideal.map_mono (Ideal.pow_le_pow_right (by omega))
      have himage : f '' S = Set.range fun i => (T n).1 i k := by
        rw [hS, ← Set.range_comp]
        congr 1
        funext i
        simp only [Function.comp_apply]
        rw [hf]
        exact hTψ n i k
      have hmap : Submodule.map f Nsub = ⊤ := by
        rw [hNsub, Submodule.map_span, himage]
        exact ih k
      have htop : (⊤ : Submodule Γ(Z, g ⁻¹ᵁ wcPmChart m k) Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k)) ≤
          Nsub ⊔ A • ⊤ := by
        intro x _
        have hfx : f x ∈ Submodule.map f Nsub := by rw [hmap]; trivial
        obtain ⟨y, hy, hfy⟩ := hfx
        have hxy : x - y ∈ A • (⊤ : Submodule Γ(Z, g ⁻¹ᵁ wcPmChart m k)
            Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k)) := by
          apply (hAd.2 (x - y)).mp
          rw [← hf, map_sub, hfy, sub_self]
        have hsplit : x = y + (x - y) := by abel
        rw [hsplit]
        exact Submodule.add_mem_sup hy hxy
      have h2 : A • (⊤ : Submodule Γ(Z, g ⁻¹ᵁ wcPmChart m k)
          Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k)) ≤ Nsub := by
        calc A • (⊤ : Submodule Γ(Z, g ⁻¹ᵁ wcPmChart m k) Γ(Gs (n + 1), g ⁻¹ᵁ wcPmChart m k))
            ≤ A • (Nsub ⊔ A • ⊤) := Submodule.smul_mono le_rfl htop
          _ = A • Nsub ⊔ A • (A • ⊤) := Submodule.smul_sup _ _ _
          _ ≤ Nsub ⊔ A' • ⊤ := by
            refine sup_le_sup Submodule.smul_le_right ?_
            rw [← Submodule.mul_smul]
            exact Submodule.smul_mono_left hAA
          _ = Nsub := by rw [hkill, sup_bot_eq]
      rw [eq_top_iff]
      exact le_trans htop (sup_le le_rfl h2)

  have hchart : ∀ n k, Function.Surjective
      (Scheme.Modules.Hom.app (a n) (g ⁻¹ᵁ wcPmChart m k)) := by
    intro n k
    obtain ⟨fa, hfa⟩ := linOf (a n) (g ⁻¹ᵁ wcPmChart m k)
    have hr : LinearMap.range fa = ⊤ := by
      rw [eq_top_iff, ← hgen n k, Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact LinearMap.mem_range.mpr ⟨ε i k, (hfa _).trans (ha n i k)⟩
    intro y
    obtain ⟨x, hx⟩ := LinearMap.range_eq_top.mp hr y
    exact ⟨x, (hfa x).symm.trans hx⟩

  have haff : ∀ n (V : Z.Opens), IsAffineOpen V →
      Function.Surjective (Scheme.Modules.Hom.app (a n) V) := fun n =>
    wc_cn_affine_surj_of_chart_surj Z L (Gs n) (a n) (m + 1) (fun k => g ⁻¹ᵁ wcPmChart m k)
      hLcoh (hG.1 n) hUaff hcov (hchart n)

  refine ⟨L, Es, ψE, φE, α, hLfree, hEadic, hEalg, hαc, ?_⟩
  intro n V hV y
  obtain ⟨x, hx⟩ := haff n V hV y
  refine ⟨Scheme.Modules.Hom.app (φE n) V x, ?_⟩
  rw [← hx, ← hα n, Scheme.Modules.Hom.comp_app]
  rfl

theorem wc_cn_kas_noetherian_sections : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m : ℕ) (g : Z ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift h g) → ∀ U : Z.Opens, IsAffineOpen U → IsNoetherianRing Γ(Z, U) :=
by
  intro B _ _ Z h m g hg U hU
  obtain ⟨haff, hcov⟩ := wc_pm_chart_cover B Z h m g hg
  obtain ⟨e, -, -, -, he⟩ := wc_pm_chart_coords.{u} m
  have hchart : ∀ k : Fin (m + 1), IsNoetherianRing Γ(Z, g ⁻¹ᵁ wcPmChart m k) := by
    intro k
    have hsurj : Function.Surjective (MvPolynomial.eval₂Hom
        ((Z.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom.comp
          (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom))
        (fun l => g.app (wcPmChart m k) (e k l))) := by
      intro s
      obtain ⟨p, hp⟩ := wc_pm_chart_pullback_generation B Z h m g hg k (e k) (he k) s
      exact ⟨p, by rw [MvPolynomial.coe_eval₂Hom]; exact hp⟩
    exact isNoetherianRing_of_surjective _ _ _ hsurj
  haveI : IsLocallyNoetherian Z := by
    refine isLocallyNoetherian_of_affine_cover
      (S := fun k : Fin (m + 1) => (⟨g ⁻¹ᵁ wcPmChart m k, haff k⟩ : Z.affineOpens)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      obtain ⟨k, hk⟩ := hcov x
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hk⟩
    · intro k
      exact hchart k
  exact IsLocallyNoetherian.component_noetherian ⟨U, hU⟩

theorem wc_cn_kas_kernel_tower : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)), (∀ U : Z.Opens, IsAffineOpen U → IsNoetherianRing Γ(Z, U)) →
    ∀ (Es Fs : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n) (ψF : ∀ n, Fs (n + 1) ⟶ Fs n)
      (α : ∀ n, Es n ⟶ Fs n),
    wcCnAdicSys h I Es ψE → wcCnAdicSys h I Fs ψF →
    (∀ n, α (n + 1) ≫ ψF n = ψE n ≫ α n) →
    (∀ n (U : Z.Opens), IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app (α n) U)) →
    ∃ (Ls : ℕ → Z.Modules) (ℓ : ∀ k, Ls (k + 1) ⟶ Ls k) (ι : ∀ k, Ls k ⟶ Es k),
      (∀ k, wcCoherentMod (Ls k)) ∧
      (∀ k, ℓ k ≫ ι k = ι (k + 1) ≫ ψE k) ∧
      (∀ k (U : Z.Opens), IsAffineOpen U → Function.Injective (Scheme.Modules.Hom.app (ι k) U)) ∧
      (∀ k (U : Z.Opens), IsAffineOpen U → ∀ x : Γ(Es k, U),
        Scheme.Modules.Hom.app (α k) U x = 0 ↔ ∃ y : Γ(Ls k, U), Scheme.Modules.Hom.app (ι k) U y = x) ∧
      (∀ k (U : Z.Opens), IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app (ℓ k) U)) :=
by
  intro B _ I Z h hN Es Fs ψE ψF α hE hF hαc hαs
  classical
  have hcomp : ∀ {M N P : Z.Modules} (f : M ⟶ N) (f' : N ⟶ P) (U : Z.Opens) (x : Γ(M, U)),
      Scheme.Modules.Hom.app (f ≫ f') U x =
        Scheme.Modules.Hom.app f' U (Scheme.Modules.Hom.app f U x) := by
    intro M N P f f' U x
    rw [Scheme.Modules.Hom.comp_app]; rfl

  have s1 : ∀ (M N : Z.Modules) (f : M ⟶ N),
      (∀ U : Z.Opens, Function.Injective (Scheme.Modules.Hom.app (Limits.kernel.ι f) U)) ∧
      ∀ (U : Z.Opens) (x : Γ(M, U)), Scheme.Modules.Hom.app f U x = 0 ↔
        ∃ y : Γ(Limits.kernel f, U), Scheme.Modules.Hom.app (Limits.kernel.ι f) U y = x := by
    intro M N f
    have hS : (ShortComplex.mk (Limits.kernel.ι f) (Limits.cokernel.π (Limits.kernel.ι f))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    have hS' : (ShortComplex.mk (Abelian.factorThruCoimage f)
        (Limits.cokernel.π (Abelian.factorThruCoimage f))
        (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance
    obtain ⟨h1, h2⟩ := wc_modules_ses_left_exact Z _ hS
    have h3 := (wc_modules_ses_left_exact Z _ hS').1
    have hfac : Limits.cokernel.π (Limits.kernel.ι f) ≫ Abelian.factorThruCoimage f = f :=
      Abelian.coimage.fac f
    refine ⟨h1, fun U x => ⟨fun hx => h2 U x ?_, ?_⟩⟩
    · refine h3 U ?_
      show Scheme.Modules.Hom.app (Abelian.factorThruCoimage f) U
          (Scheme.Modules.Hom.app (Limits.cokernel.π (Limits.kernel.ι f)) U x) =
        Scheme.Modules.Hom.app (Abelian.factorThruCoimage f) U 0
      rw [← hcomp, hfac, hx, map_zero]
    · rintro ⟨y, rfl⟩
      rw [← hcomp, Limits.kernel.condition, Scheme.Modules.Hom.zero_app]
      rfl

  have coh : ∀ k, wcCoherentMod (Limits.kernel (α k)) := by
    intro k
    refine ⟨wc_cn_kernel_qcoh Z _ _ (α k) (hE.1 k).1 (hF.1 k).1, fun U hU => ?_⟩
    let φ : Γ(Limits.kernel (α k), U) →ₗ[Γ(Z, U)] Γ(Es k, U) :=
      { toFun := Scheme.Modules.Hom.app (Limits.kernel.ι (α k)) U
        map_add' := map_add _
        map_smul' := by
          intro r x
          exact Scheme.Modules.Hom.app_smul _ _ _ }
    haveI := hN U hU
    haveI := (hE.1 k).2 U hU
    haveI : IsNoetherian Γ(Z, U) Γ(Es k, U) := isNoetherian_of_isNoetherianRing_of_finite _ _
    exact Module.Finite.of_injective φ ((s1 _ _ (α k)).1 U)

  have hlift : ∀ {M N : Z.Modules} (φ : M ⟶ N) (U : Z.Opens),
      Function.Surjective (Scheme.Modules.Hom.app φ U) → ∀ (J : Ideal Γ(Z, U)) (z : Γ(N, U)),
      z ∈ J • (⊤ : Submodule Γ(Z, U) Γ(N, U)) →
        ∃ y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(M, U)), Scheme.Modules.Hom.app φ U y = z := by
    intro M N φ U hs J z hz
    refine Submodule.smul_induction_on hz (fun r hr t _ => ?_) (fun a b ha hb => ?_)
    · obtain ⟨t', rfl⟩ := hs t
      exact ⟨r • t', Submodule.smul_mem_smul hr Submodule.mem_top,
        Scheme.Modules.Hom.app_smul _ _ _⟩
    · obtain ⟨y₁, hy₁, rfl⟩ := ha
      obtain ⟨y₂, hy₂, rfl⟩ := hb
      exact ⟨y₁ + y₂, Submodule.add_mem _ hy₁ hy₂, map_add _ _ _⟩
  have s3 : ∀ (k : ℕ) (U : Z.Opens), IsAffineOpen U → ∀ x : Γ(Es k, U),
      Scheme.Modules.Hom.app (α k) U x = 0 → ∃ e : Γ(Es (k + 1), U),
        Scheme.Modules.Hom.app (α (k + 1)) U e = 0 ∧ Scheme.Modules.Hom.app (ψE k) U e = x := by
    intro k U hU x hx
    obtain ⟨x', rfl⟩ := (hE.2.1 k U hU).1 x
    have hb : Scheme.Modules.Hom.app (ψF k) U (Scheme.Modules.Hom.app (α (k + 1)) U x') = 0 := by
      rw [← hcomp, hαc k, hcomp]
      exact hx
    have hJ := ((hF.2.1 k U hU).2 _).mp hb
    obtain ⟨y, hy, hαy⟩ := hlift (α (k + 1)) U (hαs (k + 1) U hU) _ _ hJ
    refine ⟨x' - y, by rw [map_sub, hαy, sub_self], ?_⟩
    rw [map_sub, ((hE.2.1 k U hU).2 y).mpr hy, sub_zero]

  have w : ∀ k, (Limits.kernel.ι (α (k + 1)) ≫ ψE k) ≫ α k = 0 := by
    intro k
    rw [Category.assoc, ← hαc k, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
  have hℓι : ∀ k, Limits.kernel.lift (α k) (Limits.kernel.ι (α (k + 1)) ≫ ψE k) (w k) ≫
      Limits.kernel.ι (α k) = Limits.kernel.ι (α (k + 1)) ≫ ψE k :=
    fun k => Limits.kernel.lift_ι _ _ _
  refine ⟨fun k => Limits.kernel (α k),
    fun k => Limits.kernel.lift (α k) (Limits.kernel.ι (α (k + 1)) ≫ ψE k) (w k),
    fun k => Limits.kernel.ι (α k), coh, hℓι, fun k U _ => (s1 _ _ (α k)).1 U,
    fun k U _ x => (s1 _ _ (α k)).2 U x, ?_⟩
  intro k U hU y
  obtain ⟨e, he0, he⟩ := s3 k U hU _ (((s1 _ _ (α k)).2 U _).mpr ⟨y, rfl⟩)
  obtain ⟨y', rfl⟩ := ((s1 _ _ (α (k + 1))).2 U e).mp he0
  refine ⟨y', (s1 _ _ (α k)).1 U ?_⟩
  show Scheme.Modules.Hom.app (Limits.kernel.ι (α k)) U
      (Scheme.Modules.Hom.app (Limits.kernel.lift (α k) (Limits.kernel.ι (α (k + 1)) ≫ ψE k) (w k))
        U y') = Scheme.Modules.Hom.app (Limits.kernel.ι (α k)) U y
  rw [← hcomp, hℓι, hcomp]
  exact he

theorem wc_cn_kas_affine_ar : ∀ (B : Type u) [CommRing B] (I : Ideal B) (Z : Scheme.{u})
    (h : Z ⟶ Spec (.of B)) (Es Fs : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n)
    (ψF : ∀ n, Fs (n + 1) ⟶ Fs n) (α : ∀ n, Es n ⟶ Fs n),
    wcCnAdicSys h I Es ψE → wcCnAdicSys h I Fs ψF →
    (∀ n, α (n + 1) ≫ ψF n = ψE n ≫ α n) →
    (∀ n (U : Z.Opens), IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app (α n) U)) →
    ∀ (Ls : ℕ → Z.Modules) (ℓ : ∀ k, Ls (k + 1) ⟶ Ls k) (ι : ∀ k, Ls k ⟶ Es k),
    (∀ k, ℓ k ≫ ι k = ι (k + 1) ≫ ψE k) →
    (∀ k (U : Z.Opens), IsAffineOpen U → Function.Injective (Scheme.Modules.Hom.app (ι k) U)) →
    (∀ k (U : Z.Opens), IsAffineOpen U → ∀ x : Γ(Es k, U),
      Scheme.Modules.Hom.app (α k) U x = 0 ↔ ∃ y : Γ(Ls k, U), Scheme.Modules.Hom.app (ι k) U y = x) →
    ∀ U : Z.Opens, IsAffineOpen U → IsNoetherianRing Γ(Z, U) →
    ∃ c : ℕ, ∀ n k : ℕ, c + n ≤ k → ∀ y : Γ(Ls (k + 1), U),
      Scheme.Modules.Hom.app (ℓ k) U y = 0 →
      y ∈ Ideal.map (wcCnSigma h U) (I ^ (n + 1)) • (⊤ : Submodule Γ(Z, U) Γ(Ls (k + 1), U)) :=
by

  have s1 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (J : Ideal R) (P : Type u)
      [AddCommGroup P] [Module R P] [Module.Finite R P] (Q : ℕ → Submodule R P),
      (∀ k, J ^ (k + 1) • (⊤ : Submodule R P) ≤ Q k) →
      (∀ k, Q k = Q (k + 1) ⊔ J ^ (k + 1) • (⊤ : Submodule R P)) →
      ∃ c : ℕ, ∀ k : ℕ, c ≤ k → Q k ⊓ J ^ k • (⊤ : Submodule R P) ≤
        J ^ (k - c) • Q k ⊔ J ^ (k + 1) • (⊤ : Submodule R P) := by
    intro R _ _ J P _ _ _ Q H1 H2
    have hQmono : ∀ k, Q (k + 1) ≤ Q k := fun k => le_sup_left.trans (H2 k).ge
    have hpow : ∀ m : ℕ, J • (J ^ m • (⊤ : Submodule R P)) = J ^ (m + 1) • (⊤ : Submodule R P) :=
      fun m => by rw [← Submodule.mul_smul, pow_succ']
    let F : J.Filtration P :=
      { N := fun k => Q k ⊓ J ^ k • (⊤ : Submodule R P)
        mono := fun k => inf_le_inf (hQmono k)
          (Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ k)))
        smul_le := fun k => by
          apply le_inf
          · calc J • (Q k ⊓ J ^ k • (⊤ : Submodule R P)) ≤ J • Q k :=
                  Submodule.smul_mono le_rfl inf_le_left
              _ = J • Q (k + 1) ⊔ J • (J ^ (k + 1) • (⊤ : Submodule R P)) := by
                  rw [← Submodule.smul_sup, ← H2 k]
              _ ≤ Q (k + 1) := sup_le Submodule.smul_le_right (by rw [hpow]; exact H1 (k + 1))
          · calc J • (Q k ⊓ J ^ k • (⊤ : Submodule R P)) ≤ J • (J ^ k • (⊤ : Submodule R P)) :=
                  Submodule.smul_mono le_rfl inf_le_right
              _ = J ^ (k + 1) • (⊤ : Submodule R P) := hpow k }
    have hFle : F ≤ J.stableFiltration ⊤ := fun k => by
      show Q k ⊓ J ^ k • (⊤ : Submodule R P) ≤ (J.stableFiltration ⊤).N k
      rw [Ideal.stableFiltration_N]
      exact inf_le_right
    have hFst : F.Stable := (Ideal.stableFiltration_stable J ⊤).of_le hFle
    obtain ⟨c, hc⟩ := hFst.exists_pow_smul_eq_of_ge
    have htel : ∀ k, c ≤ k → Q c ≤ Q k ⊔ J ^ (c + 1) • (⊤ : Submodule R P) := by
      intro k hk
      induction k, hk using Nat.le_induction with
      | base => exact le_sup_left
      | succ k hk ih =>
        calc Q c ≤ Q k ⊔ J ^ (c + 1) • (⊤ : Submodule R P) := ih
          _ = Q (k + 1) ⊔ J ^ (k + 1) • (⊤ : Submodule R P) ⊔
                J ^ (c + 1) • (⊤ : Submodule R P) := by
              rw [← H2 k]
          _ ≤ Q (k + 1) ⊔ J ^ (c + 1) • (⊤ : Submodule R P) :=
              sup_le (sup_le le_sup_left (le_sup_of_le_right
                (Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega))))) le_sup_right
    refine ⟨c, fun k hk => ?_⟩
    calc Q k ⊓ J ^ k • (⊤ : Submodule R P) = F.N k := rfl
      _ = J ^ (k - c) • F.N c := hc k hk
      _ ≤ J ^ (k - c) • Q c := Submodule.smul_mono le_rfl inf_le_left
      _ ≤ J ^ (k - c) • (Q k ⊔ J ^ (c + 1) • (⊤ : Submodule R P)) :=
          Submodule.smul_mono le_rfl (htel k hk)
      _ = J ^ (k - c) • Q k ⊔ J ^ (k + 1) • (⊤ : Submodule R P) := by
          rw [Submodule.smul_sup, ← Submodule.mul_smul, ← pow_add,
            show k - c + (c + 1) = k + 1 by omega]

  have s2 : ∀ (R : Type u) [CommRing R] (J : Ideal R) (M : ℕ → Type u)
      [∀ k, AddCommGroup (M k)] [∀ k, Module R (M k)] (πM : ∀ k, M (k + 1) →ₗ[R] M k),
      Module.Finite R (M 0) → (∀ k, Function.Surjective (πM k)) →
      (∀ k (x : M (k + 1)), πM k x = 0 → x ∈ J ^ (k + 1) • (⊤ : Submodule R (M (k + 1)))) →
      (∀ k, J ^ (k + 1) • (⊤ : Submodule R (M k)) = ⊥) →
      ∃ (s : ℕ) (ρ : ∀ k, (Fin s → R) →ₗ[R] M k), (∀ k, Function.Surjective (ρ k)) ∧
        ∀ k, (πM k).comp (ρ (k + 1)) = ρ k := by
    intro R _ J M _ _ πM hfin hπ hker hkill
    obtain ⟨s, g₀, hg₀⟩ := Module.Finite.exists_fin (R := R) (M := M 0)
    let g : ∀ k, Fin s → M k := fun k =>
      Nat.rec (motive := fun k => Fin s → M k) g₀ (fun k gk i => Function.surjInv (hπ k) (gk i)) k
    have hg : ∀ k i, πM k (g (k + 1) i) = g k i := fun k i => Function.surjInv_eq (hπ k) (g k i)
    let ρ : ∀ k, (Fin s → R) →ₗ[R] M k := fun k => Fintype.linearCombination R (g k)
    have hcomp : ∀ k, (πM k).comp (ρ (k + 1)) = ρ k := by
      intro k
      apply LinearMap.ext
      intro v
      simp only [LinearMap.comp_apply, ρ, Fintype.linearCombination_apply, map_sum, map_smul, hg]
    refine ⟨s, ρ, ?_, hcomp⟩
    intro k
    rw [← LinearMap.range_eq_top]
    induction k with
    | zero =>
      show (Fintype.linearCombination R (g 0)).range = ⊤
      rw [Fintype.range_linearCombination]
      exact hg₀
    | succ k ih =>
      rw [LinearMap.range_eq_top] at ih
      have h1 : (⊤ : Submodule R (M (k + 1))) ≤ LinearMap.range (ρ (k + 1)) ⊔
          J ^ (k + 1) • (⊤ : Submodule R (M (k + 1))) := by
        intro y _
        obtain ⟨v, hv⟩ := ih (πM k y)
        have h0 : πM k (y - ρ (k + 1) v) = 0 := by
          rw [map_sub, ← LinearMap.comp_apply, hcomp, hv, sub_self]
        rw [Submodule.mem_sup]
        exact ⟨ρ (k + 1) v, LinearMap.mem_range_self _ _, _, hker k _ h0, by abel⟩
      have h2 : J ^ (k + 1) • (⊤ : Submodule R (M (k + 1))) ≤ LinearMap.range (ρ (k + 1)) := by
        calc J ^ (k + 1) • (⊤ : Submodule R (M (k + 1)))
            ≤ J ^ (k + 1) • (LinearMap.range (ρ (k + 1)) ⊔
                J ^ (k + 1) • (⊤ : Submodule R (M (k + 1)))) := Submodule.smul_mono le_rfl h1
          _ = J ^ (k + 1) • LinearMap.range (ρ (k + 1)) ⊔
                (J ^ (k + 1) * J ^ (k + 1)) • (⊤ : Submodule R (M (k + 1))) := by
              rw [Submodule.smul_sup, Submodule.mul_smul]
          _ ≤ LinearMap.range (ρ (k + 1)) ⊔ J ^ (k + 1 + 1) • (⊤ : Submodule R (M (k + 1))) :=
              sup_le_sup Submodule.smul_le_right (Submodule.smul_mono_left (by
                rw [← pow_add]; exact Ideal.pow_le_pow_right (by omega)))
          _ = LinearMap.range (ρ (k + 1)) := by rw [hkill (k + 1), sup_bot_eq]
      exact eq_top_iff.mpr (h1.trans (sup_le le_rfl h2))

  have s3 : ∀ (R : Type u) [CommRing R] (J : Ideal R) (s : ℕ) (M N : ℕ → Type u)
      [∀ k, AddCommGroup (M k)] [∀ k, Module R (M k)] [∀ k, AddCommGroup (N k)]
      [∀ k, Module R (N k)] (πM : ∀ k, M (k + 1) →ₗ[R] M k) (πN : ∀ k, N (k + 1) →ₗ[R] N k)
      (f : ∀ k, M k →ₗ[R] N k) (ρ : ∀ k, (Fin s → R) →ₗ[R] M k),
      (∀ k, Function.Surjective (ρ k)) → (∀ k, (πM k).comp (ρ (k + 1)) = ρ k) →
      (∀ k, Function.Surjective (f k)) → (∀ k, (f k).comp (πM k) = (πN k).comp (f (k + 1))) →
      (∀ k (z : N (k + 1)), πN k z = 0 → z ∈ J ^ (k + 1) • (⊤ : Submodule R (N (k + 1)))) →
      (∀ k, J ^ (k + 1) • (⊤ : Submodule R (M k)) = ⊥) →
      (∀ k, J ^ (k + 1) • (⊤ : Submodule R (Fin s → R)) ≤ LinearMap.ker ((f k).comp (ρ k))) ∧
      ∀ k, LinearMap.ker ((f k).comp (ρ k)) = LinearMap.ker ((f (k + 1)).comp (ρ (k + 1))) ⊔
        J ^ (k + 1) • (⊤ : Submodule R (Fin s → R)) := by
    intro R _ J s M N _ _ _ _ πM πN f ρ hρ hρc hf hfc hkerN hkill
    have e1 : ∀ k x, f k (πM k x) = πN k (f (k + 1) x) := fun k x => by
      have := LinearMap.congr_fun (hfc k) x
      simpa only [LinearMap.comp_apply] using this
    have e2 : ∀ k v, πM k (ρ (k + 1) v) = ρ k v := fun k v => by
      have := LinearMap.congr_fun (hρc k) v
      simpa only [LinearMap.comp_apply] using this
    have H1 : ∀ k, J ^ (k + 1) • (⊤ : Submodule R (Fin s → R)) ≤
        LinearMap.ker ((f k).comp (ρ k)) := by
      intro k
      rw [Submodule.smul_le]
      intro r hr v _
      have hmem : ρ k (r • v) ∈ J ^ (k + 1) • (⊤ : Submodule R (M k)) := by
        rw [map_smul]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
      rw [hkill k, Submodule.mem_bot] at hmem
      rw [LinearMap.mem_ker, LinearMap.comp_apply, hmem, map_zero]
    refine ⟨H1, fun k => le_antisymm ?_ (sup_le ?_ (H1 k))⟩
    · intro v hv
      rw [LinearMap.mem_ker, LinearMap.comp_apply] at hv
      have hgs : Function.Surjective ((f (k + 1)).comp (ρ (k + 1))) :=
        (hf (k + 1)).comp (hρ (k + 1))
      have hz : πN k (((f (k + 1)).comp (ρ (k + 1))) v) = 0 := by
        rw [LinearMap.comp_apply, ← e1, e2]
        exact hv
      have hz2 := hkerN k _ hz
      have hmap : J ^ (k + 1) • (⊤ : Submodule R (N (k + 1))) =
          Submodule.map ((f (k + 1)).comp (ρ (k + 1))) (J ^ (k + 1) • ⊤) := by
        rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr hgs]
      rw [hmap, Submodule.mem_map] at hz2
      obtain ⟨w, hw, hgw⟩ := hz2
      rw [Submodule.mem_sup]
      refine ⟨v - w, ?_, w, hw, by abel⟩
      rw [LinearMap.mem_ker, map_sub, hgw, sub_self]
    · intro v hv
      rw [LinearMap.mem_ker, LinearMap.comp_apply] at hv ⊢
      rw [← e2, e1, hv, map_zero]

  have s4 : ∀ (R : Type u) [CommRing R] (J : Ideal R) (s : ℕ) (M N : ℕ → Type u)
      [∀ k, AddCommGroup (M k)] [∀ k, Module R (M k)] [∀ k, AddCommGroup (N k)]
      [∀ k, Module R (N k)] (πM : ∀ k, M (k + 1) →ₗ[R] M k) (f : ∀ k, M k →ₗ[R] N k)
      (ρ : ∀ k, (Fin s → R) →ₗ[R] M k) (c : ℕ), (∀ k, Function.Surjective (ρ k)) →
      (∀ k (x : M (k + 1)), πM k x = 0 → x ∈ J ^ (k + 1) • (⊤ : Submodule R (M (k + 1)))) →
      (∀ k, J ^ (k + 1) • (⊤ : Submodule R (M k)) = ⊥) →
      (∀ k : ℕ, c ≤ k → LinearMap.ker ((f k).comp (ρ k)) ⊓ J ^ k • (⊤ : Submodule R (Fin s → R)) ≤
        J ^ (k - c) • LinearMap.ker ((f k).comp (ρ k)) ⊔
          J ^ (k + 1) • (⊤ : Submodule R (Fin s → R))) →
      ∀ n k : ℕ, c + n ≤ k → ∀ x : M (k + 1), f (k + 1) x = 0 → πM k x = 0 →
        x ∈ J ^ (n + 1) • LinearMap.ker (f (k + 1)) := by
    intro R _ J s M N _ _ _ _ πM f ρ c hρ hker hkill hAR n k hnk x hfx hπx
    have hx := hker k x hπx
    have hmap : J ^ (k + 1) • (⊤ : Submodule R (M (k + 1))) =
        Submodule.map (ρ (k + 1)) (J ^ (k + 1) • ⊤) := by
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr (hρ (k + 1))]
    rw [hmap, Submodule.mem_map] at hx
    obtain ⟨z, hz, rfl⟩ := hx
    have hzQ : z ∈ LinearMap.ker ((f (k + 1)).comp (ρ (k + 1))) ⊓
        J ^ (k + 1) • (⊤ : Submodule R (Fin s → R)) :=
      Submodule.mem_inf.mpr ⟨by rw [LinearMap.mem_ker, LinearMap.comp_apply]; exact hfx, hz⟩
    have h2 := hAR (k + 1) (by omega) hzQ
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp h2
    have hb0 : ρ (k + 1) b = 0 := by
      have h3 : ρ (k + 1) b ∈ Submodule.map (ρ (k + 1)) (J ^ (k + 1 + 1) • ⊤) :=
        Submodule.mem_map_of_mem hb
      rw [Submodule.map_smul''] at h3
      have h4 : ρ (k + 1) b ∈ J ^ (k + 1 + 1) • (⊤ : Submodule R (M (k + 1))) :=
        Submodule.smul_mono le_rfl le_top h3
      rwa [hkill (k + 1), Submodule.mem_bot] at h4
    rw [map_add, hb0, add_zero]
    have h5 : ρ (k + 1) a ∈ Submodule.map (ρ (k + 1))
        (J ^ (k + 1 - c) • LinearMap.ker ((f (k + 1)).comp (ρ (k + 1)))) :=
      Submodule.mem_map_of_mem ha
    rw [Submodule.map_smul''] at h5
    refine Submodule.smul_mono (Ideal.pow_le_pow_right (by omega)) ?_ h5
    rw [LinearMap.ker_comp]
    exact Submodule.map_comap_le _ _

  intro B _ I Z h Es Fs ψE ψF α hE hF hαc hαs Ls ℓ ι hℓι hιinj hιrange U hU hRU
  haveI := hRU
  have hJp : ∀ m : ℕ, Ideal.map (wcCnSigma h U) (I ^ m) = Ideal.map (wcCnSigma h U) I ^ m :=
    fun m => Ideal.map_pow _ _ _
  have hcomp : ∀ {P Q R' : Z.Modules} (f : P ⟶ Q) (f' : Q ⟶ R') (x : Γ(P, U)),
      Scheme.Modules.Hom.app (f ≫ f') U x =
        Scheme.Modules.Hom.app f' U (Scheme.Modules.Hom.app f U x) := by
    intro P Q R' f f' x
    rw [Scheme.Modules.Hom.comp_app]; rfl
  have hfin : Module.Finite Γ(Z, U) Γ(Es 0, U) := (hE.1 0).2 U hU
  have hπ : ∀ k, Function.Surjective (wcCnJaAppL (ψE k) U) := fun k => (hE.2.1 k U hU).1
  have hkerE : ∀ k (x : Γ(Es (k + 1), U)), wcCnJaAppL (ψE k) U x = 0 →
      x ∈ Ideal.map (wcCnSigma h U) I ^ (k + 1) • (⊤ : Submodule Γ(Z, U) Γ(Es (k + 1), U)) := by
    intro k x hx
    rw [← hJp]
    exact ((hE.2.1 k U hU).2 x).mp hx
  have hkillE : ∀ k, Ideal.map (wcCnSigma h U) I ^ (k + 1) •
      (⊤ : Submodule Γ(Z, U) Γ(Es k, U)) = ⊥ := by
    intro k
    rw [← hJp]
    exact hE.2.2 k U hU
  have hkerF : ∀ k (z : Γ(Fs (k + 1), U)), wcCnJaAppL (ψF k) U z = 0 →
      z ∈ Ideal.map (wcCnSigma h U) I ^ (k + 1) • (⊤ : Submodule Γ(Z, U) Γ(Fs (k + 1), U)) := by
    intro k z hz
    rw [← hJp]
    exact ((hF.2.1 k U hU).2 z).mp hz
  have hfs : ∀ k, Function.Surjective (wcCnJaAppL (α k) U) := fun k => hαs k U hU
  have hfc : ∀ k, (wcCnJaAppL (α k) U).comp (wcCnJaAppL (ψE k) U) =
      (wcCnJaAppL (ψF k) U).comp (wcCnJaAppL (α (k + 1)) U) := by
    intro k
    apply LinearMap.ext
    intro x
    show Scheme.Modules.Hom.app (α k) U (Scheme.Modules.Hom.app (ψE k) U x) =
      Scheme.Modules.Hom.app (ψF k) U (Scheme.Modules.Hom.app (α (k + 1)) U x)
    rw [← hcomp, ← hcomp, hαc k]
  obtain ⟨s, ρ, hρs, hρc⟩ := s2 Γ(Z, U) (Ideal.map (wcCnSigma h U) I)
    (fun k => Γ(Es k, U)) (fun k => wcCnJaAppL (ψE k) U) hfin hπ hkerE hkillE
  obtain ⟨H1, H2⟩ := s3 Γ(Z, U) (Ideal.map (wcCnSigma h U) I) s
    (fun k => Γ(Es k, U)) (fun k => Γ(Fs k, U)) (fun k => wcCnJaAppL (ψE k) U)
    (fun k => wcCnJaAppL (ψF k) U) (fun k => wcCnJaAppL (α k) U) ρ hρs hρc hfs hfc hkerF hkillE
  obtain ⟨c, hc⟩ := s1 Γ(Z, U) (Ideal.map (wcCnSigma h U) I) (Fin s → Γ(Z, U))
    (fun k => LinearMap.ker ((wcCnJaAppL (α k) U).comp (ρ k))) H1 H2
  refine ⟨c, fun n k hnk y hy => ?_⟩
  have hfx : wcCnJaAppL (α (k + 1)) U (Scheme.Modules.Hom.app (ι (k + 1)) U y) = 0 :=
    (hιrange (k + 1) U hU _).mpr ⟨y, rfl⟩
  have hπx : wcCnJaAppL (ψE k) U (Scheme.Modules.Hom.app (ι (k + 1)) U y) = 0 := by
    show Scheme.Modules.Hom.app (ψE k) U (Scheme.Modules.Hom.app (ι (k + 1)) U y) = 0
    rw [← hcomp, ← hℓι k, hcomp, hy, map_zero]
  have hx := s4 Γ(Z, U) (Ideal.map (wcCnSigma h U) I) s
    (fun k => Γ(Es k, U)) (fun k => Γ(Fs k, U)) (fun k => wcCnJaAppL (ψE k) U)
    (fun k => wcCnJaAppL (α k) U) ρ c hρs hkerE hkillE hc n k hnk _ hfx hπx
  have hker_eq : LinearMap.ker (wcCnJaAppL (α (k + 1)) U) =
      Submodule.map (wcCnJaAppL (ι (k + 1)) U) ⊤ := by
    ext x'
    rw [LinearMap.mem_ker, Submodule.map_top, LinearMap.mem_range]
    exact hιrange (k + 1) U hU x'
  rw [hker_eq, ← Submodule.map_smul'', Submodule.mem_map] at hx
  obtain ⟨y', hy', hxy⟩ := hx
  have hyy : y' = y := hιinj (k + 1) U hU hxy
  rw [hJp, ← hyy]
  exact hy'

theorem wc_cn_kas_spread_ar : ∀ (B : Type u) [CommRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B))
    (J : Ideal B), J.FG → ∀ (L L' : Z.Modules) (f : L ⟶ L'), wcQcoh L → wcQcoh L' →
    (∀ x : Z, ∃ W : Z.Opens, IsAffineOpen W ∧ x ∈ W ∧ ∀ y : Γ(L, W),
      Scheme.Modules.Hom.app f W y = 0 →
        y ∈ Ideal.map (wcCnSigma h W) J • (⊤ : Submodule Γ(Z, W) Γ(L, W))) →
    ∀ U : Z.Opens, IsAffineOpen U → ∀ y : Γ(L, U), Scheme.Modules.Hom.app f U y = 0 →
      y ∈ Ideal.map (wcCnSigma h U) J • (⊤ : Submodule Γ(Z, U) Γ(L, U)) :=
by
  intro B _ Z h J _ L L' f hL hL' hloc U hU y hy
  classical

  have hsig : ∀ (V V' : Z.Opens) (hle : V' ≤ V) (b : B),
      (Z.presheaf.map (homOfLE hle).op).hom (wcCnSigma h V b) = wcCnSigma h V' b := by
    intro V V' hle b
    unfold wcCnSigma
    simp only [RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have rsmul : ∀ {P : Z.Modules} {V V' : Z.Opens} (hle : V' ≤ V) (r : Γ(Z, V)) (x : Γ(P, V)),
      (P.presheaf.map (homOfLE hle).op).hom (r • x) =
        (Z.presheaf.map (homOfLE hle).op).hom r • (P.presheaf.map (homOfLE hle).op).hom x :=
    fun hle r x => Scheme.Modules.map_smul _ (homOfLE hle) r x

  have nat : ∀ {V V' : Z.Opens} (hle : V' ≤ V) (x : Γ(L, V)),
      Scheme.Modules.Hom.app f V' ((L.presheaf.map (homOfLE hle).op).hom x) =
        (L'.presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app f V x) :=
    fun hle x => NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf f) (homOfLE hle).op x

  have hres : ∀ (V V' : Z.Opens) (hle : V' ≤ V) (z : Γ(L, V)),
      z ∈ Ideal.map (wcCnSigma h V) J • (⊤ : Submodule Γ(Z, V) Γ(L, V)) →
      (L.presheaf.map (homOfLE hle).op).hom z ∈
        Ideal.map (wcCnSigma h V') J • (⊤ : Submodule Γ(Z, V') Γ(L, V')) := by
    intro V V' hle z hz
    have hJ : Ideal.map (wcCnSigma h V) J ≤
        Ideal.comap (Z.presheaf.map (homOfLE hle).op).hom (Ideal.map (wcCnSigma h V') J) := by
      rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, Ideal.mem_comap, hsig]
      exact Ideal.mem_map_of_mem _ hb
    refine Submodule.smul_induction_on hz (fun c hc s _ => ?_) (fun a b ha hb => ?_)
    · rw [rsmul]
      exact Submodule.smul_mem_smul (hJ hc) Submodule.mem_top
    · rw [map_add]
      exact Submodule.add_mem _ ha hb

  have hpass : ∀ W : Z.Opens, IsAffineOpen W →
      (∀ z : Γ(L, W), Scheme.Modules.Hom.app f W z = 0 →
        z ∈ Ideal.map (wcCnSigma h W) J • (⊤ : Submodule Γ(Z, W) Γ(L, W))) →
      ∀ (g : Γ(Z, W)) (z : Γ(L, Z.basicOpen g)), Scheme.Modules.Hom.app f (Z.basicOpen g) z = 0 →
        z ∈ Ideal.map (wcCnSigma h (Z.basicOpen g)) J •
          (⊤ : Submodule Γ(Z, Z.basicOpen g) Γ(L, Z.basicOpen g)) := by
    intro W hW hPW g z hz
    obtain ⟨n, t, ht⟩ := (hL W hW g).1 z
    have h1 : (L'.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom
        (Scheme.Modules.Hom.app f W t) = 0 := by
      rw [← nat, ← ht, Scheme.Modules.Hom.app_smul, hz, smul_zero]
    obtain ⟨m, hm⟩ := (hL' W hW g).2 _ h1
    rw [← Scheme.Modules.Hom.app_smul] at hm
    have h2 := hres W (Z.basicOpen g) (Z.basicOpen_le g) _ (hPW _ hm)
    rw [rsmul, map_pow, ← ht, smul_smul, ← pow_add] at h2
    have hu : IsUnit ((Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op).hom g) :=
      RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g
    obtain ⟨v, hv⟩ := hu.pow (m + n)
    rw [← hv] at h2
    have h3 := Submodule.smul_mem _ (↑v⁻¹ : Γ(Z, Z.basicOpen g)) h2
    rwa [smul_smul, Units.inv_mul, one_smul] at h3

  have hdesc : ∀ (r : Γ(Z, U)) (w : Γ(L, U)),
      (L.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom w ∈
        Ideal.map (wcCnSigma h (Z.basicOpen r)) J •
          (⊤ : Submodule Γ(Z, Z.basicOpen r) Γ(L, Z.basicOpen r)) →
      ∃ e : ℕ, r ^ e • w ∈ Ideal.map (wcCnSigma h U) J • (⊤ : Submodule Γ(Z, U) Γ(L, U)) := by
    intro r w hw
    set ρ := (Z.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom with hρ
    set ρM := (L.presheaf.map (homOfLE (Z.basicOpen_le r)).op).hom with hρM
    have hmapsmul : ∀ (a : Γ(Z, U)) (x : Γ(L, U)), ρM (a • x) = ρ a • ρM x := fun a x =>
      Scheme.Modules.map_smul L (homOfLE (Z.basicOpen_le r)) a x
    have hs' : ∀ b : B, ρ (wcCnSigma h U b) = wcCnSigma h (Z.basicOpen r) b := fun b =>
      hsig U (Z.basicOpen r) (Z.basicOpen_le r) b
    obtain ⟨qa, qb⟩ := hL U hU r
    let P : Γ(L, Z.basicOpen r) → Prop := fun x =>
      ∃ (n : ℕ) (y' : Γ(L, U)), y' ∈ Ideal.map (wcCnSigma h U) J • (⊤ : Submodule Γ(Z, U) Γ(L, U)) ∧
        ρ r ^ n • x = ρM y'
    have P0 : P 0 := ⟨0, 0, Submodule.zero_mem _, by rw [smul_zero, map_zero]⟩
    have Padd : ∀ x x', P x → P x' → P (x + x') := by
      rintro x x' ⟨n, z, hz, hx⟩ ⟨m, z', hz', hx'⟩
      refine ⟨n + m, r ^ m • z + r ^ n • z', Submodule.add_mem _ (Submodule.smul_mem _ _ hz)
        (Submodule.smul_mem _ _ hz'), ?_⟩
      rw [map_add, hmapsmul, hmapsmul, map_pow, map_pow, ← hx, ← hx', smul_add, smul_smul,
        smul_smul, ← pow_add, ← pow_add, add_comm m n]
    have Pgen : ∀ c ∈ Ideal.map (wcCnSigma h (Z.basicOpen r)) J, ∀ s, P (c • s) := by
      intro c hc
      induction hc using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨b, hb, rfl⟩ := hx
        intro s
        obtain ⟨N, t, ht⟩ := qa s
        refine ⟨N, wcCnSigma h U b • t,
          Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hb) Submodule.mem_top, ?_⟩
        rw [hmapsmul, ← ht, hs', smul_comm]
      | zero => intro s; rw [zero_smul]; exact P0
      | add x x' _ _ hx hx' => intro s; rw [add_smul]; exact Padd _ _ (hx s) (hx' s)
      | smul a x _ hx =>
        intro s
        rw [smul_eq_mul, mul_comm, mul_smul]
        exact hx (a • s)
    have hP : P (ρM w) :=
      Submodule.smul_induction_on (p := P) hw (fun c hc s _ => Pgen c hc s) Padd
    obtain ⟨n, y', hy', hyy⟩ := hP
    have hz : ρM (r ^ n • w - y') = 0 := by
      rw [map_sub, hmapsmul, map_pow, hyy, sub_self]
    obtain ⟨m, hm⟩ := qb _ hz
    refine ⟨m + n, ?_⟩
    rw [smul_sub, sub_eq_zero, smul_smul, ← pow_add] at hm
    rw [hm]
    exact Submodule.smul_mem _ _ hy'

  let S : Set Γ(Z, U) := {r | ∀ z : Γ(L, Z.basicOpen r),
      Scheme.Modules.Hom.app f (Z.basicOpen r) z = 0 →
      z ∈ Ideal.map (wcCnSigma h (Z.basicOpen r)) J •
        (⊤ : Submodule Γ(Z, Z.basicOpen r) Γ(L, Z.basicOpen r))}
  have hcov : U ≤ ⨆ s : S, Z.basicOpen (s : Γ(Z, U)) := by
    intro x hxU
    obtain ⟨W, hW, hxW, hPW⟩ := hloc x
    obtain ⟨r, g, hrg, hxr⟩ := exists_basicOpen_le_affine_inter hU hW x ⟨hxU, hxW⟩
    have hPg := hpass W hW hPW g
    have hr : r ∈ S := by
      show ∀ z : Γ(L, Z.basicOpen r), Scheme.Modules.Hom.app f (Z.basicOpen r) z = 0 →
        z ∈ Ideal.map (wcCnSigma h (Z.basicOpen r)) J •
          (⊤ : Submodule Γ(Z, Z.basicOpen r) Γ(L, Z.basicOpen r))
      rw [hrg]
      exact hPg
    exact (TopologicalSpace.Opens.mem_iSup).mpr ⟨⟨r, hr⟩, hxr⟩
  have hspan : Ideal.span S = ⊤ := hU.self_le_iSup_basicOpen_iff.mp hcov
  refine Submodule.mem_of_span_eq_top_of_smul_pow_mem _ S hspan y ?_
  rintro ⟨r, hr⟩
  apply hdesc r y
  apply hr
  rw [nat, hy, map_zero]

theorem wc_cn_kernel_adic_system : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (m : ℕ) (g : Z ⟶ wcPm.{u} m),
    IsClosedImmersion (Limits.prod.lift h g) →
    ∀ (Es Fs : ℕ → Z.Modules) (ψE : ∀ n, Es (n + 1) ⟶ Es n) (ψF : ∀ n, Fs (n + 1) ⟶ Fs n)
      (α : ∀ n, Es n ⟶ Fs n),
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Es ψE →
    wcCnAdicSys h (IsLocalRing.maximalIdeal B) Fs ψF →
    (∀ n, α (n + 1) ≫ ψF n = ψE n ≫ α n) →
    (∀ n (U : Z.Opens), IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app (α n) U)) →
    ∃ (Ks : ℕ → Z.Modules) (ψK : ∀ n, Ks (n + 1) ⟶ Ks n) (γ : ∀ n, Ks n ⟶ Es n),
      wcCnAdicSys h (IsLocalRing.maximalIdeal B) Ks ψK ∧
      (∀ n, γ (n + 1) ≫ ψE n = ψK n ≫ γ n) ∧
      ∀ n (U : Z.Opens), IsAffineOpen U → ∀ x : Γ(Es n, U),
        Scheme.Modules.Hom.app (α n) U x = 0 ↔ ∃ y : Γ(Ks n, U), Scheme.Modules.Hom.app (γ n) U y = x :=
by
  intro B _ _ _ Z h m g hg Es Fs ψE ψF α hE hF hαc hαs
  classical

  have hcomp : ∀ {M N P : Z.Modules} (f : M ⟶ N) (f' : N ⟶ P) (U : Z.Opens) (x : Γ(M, U)),
      Scheme.Modules.Hom.app (f ≫ f') U x =
        Scheme.Modules.Hom.app f' U (Scheme.Modules.Hom.app f U x) := by
    intro M N P f f' U x
    rw [Scheme.Modules.Hom.comp_app]; rfl
  have hmapS : ∀ {M N : Z.Modules} (φ : M ⟶ N) (U : Z.Opens) (J : Ideal Γ(Z, U)) (y : Γ(M, U)),
      y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(M, U)) →
        Scheme.Modules.Hom.app φ U y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(N, U)) := by
    intro M N φ U J y hy
    refine Submodule.smul_induction_on hy (fun r hr t _ => ?_) (fun a b ha hb => ?_)
    · rw [Scheme.Modules.Hom.app_smul]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · rw [map_add]
      exact Submodule.add_mem _ ha hb
  have hlift : ∀ {M N : Z.Modules} (φ : M ⟶ N) (U : Z.Opens),
      Function.Surjective (Scheme.Modules.Hom.app φ U) → ∀ (J : Ideal Γ(Z, U)) (z : Γ(N, U)),
      z ∈ J • (⊤ : Submodule Γ(Z, U) Γ(N, U)) →
        ∃ y ∈ J • (⊤ : Submodule Γ(Z, U) Γ(M, U)), Scheme.Modules.Hom.app φ U y = z := by
    intro M N φ U hs J z hz
    refine Submodule.smul_induction_on hz (fun r hr t _ => ?_) (fun a b ha hb => ?_)
    · obtain ⟨t', rfl⟩ := hs t
      exact ⟨r • t', Submodule.smul_mem_smul hr Submodule.mem_top,
        Scheme.Modules.Hom.app_smul _ _ _⟩
    · obtain ⟨y₁, hy₁, rfl⟩ := ha
      obtain ⟨y₂, hy₂, rfl⟩ := hb
      exact ⟨y₁ + y₂, Submodule.add_mem _ hy₁ hy₂, map_add _ _ _⟩

  obtain ⟨T, T_id, T_succ, T_comp⟩ : ∃ T : ∀ a b : ℕ, a ≤ b → (Es b ⟶ Es a),
      (∀ a (hh : a ≤ a), T a a hh = 𝟙 _) ∧ (∀ k, T k (k + 1) (Nat.le_succ k) = ψE k) ∧
      (∀ a b d (h1 : a ≤ b) (h2 : b ≤ d), T b d h2 ≫ T a b h1 = T a d (h1.trans h2)) := by
    refine ⟨fun a b hab => (Functor.ofOpSequence ψE).map (homOfLE hab).op, ?_, ?_, ?_⟩
    · intro a hh
      exact (congrArg (fun f => (Functor.ofOpSequence ψE).map f)
        (Subsingleton.elim (homOfLE hh).op (𝟙 (Opposite.op a)))).trans
        ((Functor.ofOpSequence ψE).map_id _)
    · intro k
      exact Functor.ofOpSequence_map_homOfLE_succ ψE k
    · intro a b d h1 h2
      have hmc := (Functor.ofOpSequence ψE).map_comp (homOfLE h2).op (homOfLE h1).op
      exact hmc.symm.trans (congrArg (fun f => (Functor.ofOpSequence ψE).map f)
        (Subsingleton.elim _ _))

  have hN := wc_cn_kas_noetherian_sections B Z h m g hg
  obtain ⟨Ls, ℓ, ι, hLcoh, hℓι, hιinj, hιrange, hℓsurj⟩ :=
    wc_cn_kas_kernel_tower B (IsLocalRing.maximalIdeal B) Z h hN Es Fs ψE ψF α hE hF hαc hαs
  obtain ⟨haff, hcov⟩ := wc_pm_chart_cover B Z h m g hg

  have hcex := fun j : Fin (m + 1) =>
    wc_cn_kas_affine_ar B (IsLocalRing.maximalIdeal B) Z h Es Fs ψE ψF α hE hF hαc hαs Ls ℓ ι
      hℓι hιinj hιrange _ (haff j) (hN _ (haff j))
  choose cj hcj using hcex
  set c : ℕ := Finset.univ.sup cj with hc
  have hcle : ∀ j, cj j ≤ c := fun j => Finset.le_sup (Finset.mem_univ j)

  have hAR : ∀ n (U : Z.Opens), IsAffineOpen U → ∀ y : Γ(Ls (c + n + 1), U),
      Scheme.Modules.Hom.app (ℓ (c + n)) U y = 0 →
      y ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
        (⊤ : Submodule Γ(Z, U) Γ(Ls (c + n + 1), U)) := by
    intro n
    refine wc_cn_kas_spread_ar B Z h _ (Ideal.fg_of_isNoetherianRing _) (Ls (c + n + 1))
      (Ls (c + n)) (ℓ (c + n)) (hLcoh _).1 (hLcoh _).1 ?_
    intro x
    obtain ⟨j, hj⟩ := hcov x
    exact ⟨_, haff j, hj, fun y hy => hcj j n (c + n) (by have := hcle j; omega) y hy⟩

  have hQS := fun k : ℕ => wc_cn_quotient_system B (IsLocalRing.maximalIdeal B) Z h (Ls k)
    (hLcoh k)
  choose QE ψQ φQ hQadic hQalg hQepi hQuniv using hQS
  let K : ℕ → Z.Modules := fun n => QE (c + n) n
  let π : ∀ n, Ls (c + n) ⟶ K n := fun n => φQ (c + n) n
  have hπepi : ∀ n, Epi (π n) := fun n => hQepi (c + n) n
  have hKcoh : ∀ n, wcCoherentMod (K n) := fun n => (hQadic (c + n)).1 n
  have hπU : ∀ n (U : Z.Opens), IsAffineOpen U →
      Function.Surjective (Scheme.Modules.Hom.app (π n) U) ∧
      (∀ s : Γ(Ls (c + n), U), Scheme.Modules.Hom.app (π n) U s = 0 ↔
        s ∈ Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
          (⊤ : Submodule Γ(Z, U) Γ(Ls (c + n), U))) ∧
      Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
          (⊤ : Submodule Γ(Z, U) Γ(K n, U)) = ⊥ := fun n U hU =>
    ⟨((hQalg (c + n)).2.2 n U hU).1, ((hQalg (c + n)).2.2 n U hU).2,
      (hQadic (c + n)).2.2 n U hU⟩
  have hπuniv : ∀ (n : ℕ) (G : Z.Modules) (a : Ls (c + n) ⟶ G),
      (∀ U : Z.Opens, IsAffineOpen U →
        Ideal.map (wcCnSigma h U) (IsLocalRing.maximalIdeal B ^ (n + 1)) •
          (⊤ : Submodule Γ(Z, U) Γ(G, U)) = ⊥) → ∃ a' : K n ⟶ G, π n ≫ a' = a :=
    fun n G a hG => hQuniv (c + n) n G a hG
  clear_value K π

  have hψKex : ∀ n, ∃ a' : K (n + 1) ⟶ K n, π (n + 1) ≫ a' = ℓ (c + n) ≫ π n := by
    intro n
    refine hπuniv (n + 1) (K n) (ℓ (c + n) ≫ π n) (fun U hU => ?_)
    refine eq_bot_iff.mpr ((Submodule.smul_mono_left (Ideal.map_mono
      (Ideal.pow_le_pow_right (by omega)))).trans (hπU n U hU).2.2.le)
  choose ψK hψK using hψKex

  have hγex : ∀ n, ∃ a' : K n ⟶ Es n, π n ≫ a' = ι (c + n) ≫ T n (c + n) (by omega) :=
    fun n => hπuniv n (Es n) _ (fun U hU => hE.2.2 n U hU)
  choose γ hγ using hγex

  have hcompat : ∀ n, γ (n + 1) ≫ ψE n = ψK n ≫ γ n := by
    intro n
    haveI := hπepi (n + 1)
    have key1 : T (n + 1) (c + (n + 1)) (by omega) ≫ ψE n = T n (c + (n + 1)) (by omega) := by
      rw [← T_succ n]
      exact T_comp _ _ _ _ _
    have key2 : ψE (c + n) ≫ T n (c + n) (by omega) = T n (c + (n + 1)) (by omega) := by
      rw [← T_succ (c + n)]
      exact T_comp _ _ _ _ _
    have e : π (n + 1) ≫ γ (n + 1) ≫ ψE n = π (n + 1) ≫ ψK n ≫ γ n := by
      calc π (n + 1) ≫ γ (n + 1) ≫ ψE n = (π (n + 1) ≫ γ (n + 1)) ≫ ψE n :=
            (Category.assoc _ _ _).symm
        _ = (ι (c + (n + 1)) ≫ T (n + 1) (c + (n + 1)) (by omega)) ≫ ψE n := by
            rw [hγ (n + 1)]
        _ = ι (c + (n + 1)) ≫ T n (c + (n + 1)) (by omega) := by
            rw [Category.assoc, key1]
        _ = ι (c + n + 1) ≫ (ψE (c + n) ≫ T n (c + n) (by omega)) := by
            rw [key2]
            rfl
        _ = (ℓ (c + n) ≫ ι (c + n)) ≫ T n (c + n) (by omega) := by
            rw [hℓι (c + n)]
            simp only [Category.assoc]
        _ = (π (n + 1) ≫ ψK n) ≫ γ n := by
            rw [hψK n]
            simp only [Category.assoc]
            rw [hγ n]
        _ = π (n + 1) ≫ ψK n ≫ γ n := Category.assoc _ _ _
    exact (cancel_epi (π (n + 1))).mp e
  refine ⟨K, ψK, γ, ⟨fun n => hKcoh n, fun n U hU => ⟨?_, ?_⟩, fun n U hU => (hπU n U hU).2.2⟩,
    hcompat, ?_⟩
  ·
    intro z
    obtain ⟨y, rfl⟩ := (hπU n U hU).1 z
    obtain ⟨y', rfl⟩ := hℓsurj (c + n) U hU y
    refine ⟨Scheme.Modules.Hom.app (π (n + 1)) U y', ?_⟩
    rw [← hcomp, hψK n, hcomp]
  ·
    intro s
    constructor
    · intro hs
      obtain ⟨y, rfl⟩ := (hπU (n + 1) U hU).1 s
      have h1 : Scheme.Modules.Hom.app (π n) U (Scheme.Modules.Hom.app (ℓ (c + n)) U y) = 0 := by
        rw [← hcomp, ← hψK n, hcomp]
        exact hs
      have h2 := ((hπU n U hU).2.1 _).mp h1
      obtain ⟨y₁, hy₁, hℓy₁⟩ := hlift (ℓ (c + n)) U (hℓsurj (c + n) U hU) _ _ h2
      have h3 : Scheme.Modules.Hom.app (ℓ (c + n)) U (y - y₁) = 0 := by
        rw [map_sub, hℓy₁, sub_self]
      have h4 := hAR n U hU (y - y₁) h3
      have h5 := Submodule.add_mem _ h4 hy₁
      rw [sub_add_cancel] at h5
      exact hmapS (π (n + 1)) U _ y h5
    · intro hs
      have h1 := hmapS (ψK n) U _ s hs
      rw [(hπU n U hU).2.2] at h1
      exact (Submodule.mem_bot _).mp h1
  ·
    intro n U hU x
    constructor
    · intro hx
      have hall : ∀ k (hk : n ≤ k), ∃ y : Γ(Ls k, U),
          Scheme.Modules.Hom.app (T n k hk) U (Scheme.Modules.Hom.app (ι k) U y) = x := by
        intro k hk
        induction k, hk using Nat.le_induction with
        | base =>
          obtain ⟨y, hy⟩ := (hιrange n U hU x).mp hx
          refine ⟨y, ?_⟩
          rw [T_id]
          exact hy
        | succ k hk ih =>
          obtain ⟨y, hy⟩ := ih
          obtain ⟨y', rfl⟩ := hℓsurj k U hU y
          refine ⟨y', ?_⟩
          rw [← T_comp n k (k + 1) hk (Nat.le_succ k), T_succ, hcomp, ← hcomp (ι (k + 1)) (ψE k),
            ← hℓι k, hcomp]
          exact hy
      obtain ⟨y, hy⟩ := hall (c + n) (by omega)
      refine ⟨Scheme.Modules.Hom.app (π n) U y, ?_⟩
      rw [← hcomp, hγ n, hcomp]
      exact hy
    · rintro ⟨y, rfl⟩
      obtain ⟨y₀, rfl⟩ := (hπU n U hU).1 y
      have hvan : ∀ k (hk : n ≤ k) (e : Γ(Es k, U)), Scheme.Modules.Hom.app (α k) U e = 0 →
          Scheme.Modules.Hom.app (α n) U (Scheme.Modules.Hom.app (T n k hk) U e) = 0 := by
        intro k hk
        induction k, hk using Nat.le_induction with
        | base =>
          intro e he
          rw [T_id]
          exact he
        | succ k hk ih =>
          intro e he
          rw [← T_comp n k (k + 1) hk (Nat.le_succ k), T_succ, hcomp]
          apply ih
          rw [← hcomp, ← hαc k, hcomp, he, map_zero]
      rw [← hcomp (π n) (γ n), hγ n, hcomp]
      exact hvan (c + n) (by omega) _ ((hιrange (c + n) U hU _).mpr ⟨y₀, rfl⟩)

theorem wc_cn_internal_hom_exists : ∀ (Z : Scheme.{u}) (L' : Z.Modules), ∃ (Hm : Z.Modules ⥤ Z.Modules) (Θ : ∀ (F : Z.Modules) (V : Z.Opens), Γ(Hm.obj F, V) →ₗ[Γ(Z, V)] (Γ(L', V) →ₗ[Γ(Z, V)] Γ(F, V))) (e : ∀ F : Z.Modules, (L' ⟶ F) ≃ Γ(Hm.obj F, ⊤)), (∀ (F : Z.Modules) (V V' : Z.Opens) (hV : V' ≤ V) (s : Γ(Hm.obj F, V)) (x : Γ(L', V)), Θ F V' (((Hm.obj F).presheaf.map (homOfLE hV).op).hom s) ((L'.presheaf.map (homOfLE hV).op).hom x) = (F.presheaf.map (homOfLE hV).op).hom (Θ F V s x)) ∧ (∀ (F : Z.Modules) (V : Z.Opens) (f : ∀ W : Z.Opens, W ≤ V → (Γ(L', W) →ₗ[Γ(Z, W)] Γ(F, W))), (∀ (W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ V) (h₂ : W₂ ≤ W₁) (x : Γ(L', W₁)), (F.presheaf.map (homOfLE h₂).op).hom (f W₁ h₁ x) = f W₂ (h₂.trans h₁) ((L'.presheaf.map (homOfLE h₂).op).hom x)) → ∃! s : Γ(Hm.obj F, V), ∀ (W : Z.Opens) (hW : W ≤ V), Θ F W (((Hm.obj F).presheaf.map (homOfLE hW).op).hom s) = f W hW) ∧ (∀ (F G : Z.Modules) (φ : F ⟶ G) (V : Z.Opens) (s : Γ(Hm.obj F, V)) (x : Γ(L', V)), Θ G V (Scheme.Modules.Hom.app (Hm.map φ) V s) x = Scheme.Modules.Hom.app φ V (Θ F V s x)) ∧ (∀ (F G : Z.Modules) (φ : F ⟶ G) (a : L' ⟶ F), Scheme.Modules.Hom.app (Hm.map φ) ⊤ (e F a) = e G (a ≫ φ)) :=
by
  have objT : ∀ (Z : Scheme.{u}) (L' F : Z.Modules), ∃ (H : Z.Modules)
      (Θ : ∀ V : Z.Opens, Γ(H, V) →ₗ[Γ(Z, V)] (Γ(L', V) →ₗ[Γ(Z, V)] Γ(F, V))),
      (∀ (V V' : Z.Opens) (hV : V' ≤ V) (s : Γ(H, V)) (x : Γ(L', V)),
        Θ V' ((H.presheaf.map (homOfLE hV).op).hom s) ((L'.presheaf.map (homOfLE hV).op).hom x) =
          (F.presheaf.map (homOfLE hV).op).hom (Θ V s x)) ∧
      (∀ (V : Z.Opens) (f : ∀ W : Z.Opens, W ≤ V → (Γ(L', W) →ₗ[Γ(Z, W)] Γ(F, W))),
        (∀ (W₁ W₂ : Z.Opens) (h₁ : W₁ ≤ V) (h₂ : W₂ ≤ W₁) (x : Γ(L', W₁)),
          (F.presheaf.map (homOfLE h₂).op).hom (f W₁ h₁ x) =
            f W₂ (h₂.trans h₁) ((L'.presheaf.map (homOfLE h₂).op).hom x)) →
        ∃! s : Γ(H, V), ∀ (W : Z.Opens) (hW : W ≤ V),
          Θ W ((H.presheaf.map (homOfLE hW).op).hom s) = f W hW) := by
    intro Z L' F
    classical
    have resZ : ∀ {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Z, A)),
        (Z.presheaf.map (homOfLE h2).op).hom ((Z.presheaf.map (homOfLE h1).op).hom x) =
        (Z.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
      intro A B C h1 h2 x
      change (Z.presheaf.map (homOfLE h1).op ≫ Z.presheaf.map (homOfLE h2).op).hom x = _
      rw [← Functor.map_comp]
      all_goals rfl
    have resZId : ∀ (A : Z.Opens) (h : A ≤ A) (r : Γ(Z, A)),
        (Z.presheaf.map (homOfLE h).op).hom r = r := by
      intro A h r
      have h' : (homOfLE h).op = 𝟙 (Opposite.op A) := rfl
      rw [h', CategoryTheory.Functor.map_id]
      all_goals rfl
    have smulG : ∀ (G : Z.Modules) {A B : Z.Opens} (h : B ≤ A) (r : Γ(Z, A)) (x : Γ(G, A)),
        (G.presheaf.map (homOfLE h).op).hom (r • x) =
        (Z.presheaf.map (homOfLE h).op).hom r • (G.presheaf.map (homOfLE h).op).hom x :=
      fun G _ _ h r x => Scheme.Modules.map_smul G (homOfLE h) r x
    let S : ∀ V : Z.Opens, AddSubgroup
        (∀ W : {W : Z.Opens // W ≤ V}, Γ(L', W.1) →ₗ[Γ(Z, W.1)] Γ(F, W.1)) := fun V =>
      { carrier := {f | ∀ (W₁ W₂ : {W : Z.Opens // W ≤ V}) (h : W₂.1 ≤ W₁.1) (x : Γ(L', W₁.1)),
            (F.presheaf.map (homOfLE h).op).hom (f W₁ x) =
              f W₂ ((L'.presheaf.map (homOfLE h).op).hom x)}
        add_mem' := fun {a b} ha hb W₁ W₂ h x => by
          show (F.presheaf.map (homOfLE h).op).hom (a W₁ x + b W₁ x) =
            a W₂ ((L'.presheaf.map (homOfLE h).op).hom x) +
              b W₂ ((L'.presheaf.map (homOfLE h).op).hom x)
          rw [map_add, ha W₁ W₂ h x, hb W₁ W₂ h x]
        zero_mem' := fun W₁ W₂ h x => by
          show (F.presheaf.map (homOfLE h).op).hom 0 = 0
          rw [map_zero]
        neg_mem' := fun {a} ha W₁ W₂ h x => by
          show (F.presheaf.map (homOfLE h).op).hom (-(a W₁ x)) =
            -(a W₂ ((L'.presheaf.map (homOfLE h).op).hom x))
          rw [map_neg, ha W₁ W₂ h x] }
    have memS : ∀ (V : Z.Opens) (f : S V) (W₁ W₂ : {W : Z.Opens // W ≤ V}) (h : W₂.1 ≤ W₁.1)
        (x : Γ(L', W₁.1)),
        (F.presheaf.map (homOfLE h).op).hom (f.1 W₁ x) =
          f.1 W₂ ((L'.presheaf.map (homOfLE h).op).hom x) := fun V f => f.2
    let sm : ∀ V : Z.Opens, Γ(Z, V) → S V → S V := fun V r f =>
      ⟨fun W => (Z.presheaf.map (homOfLE W.2).op).hom r • f.1 W, by
        intro W₁ W₂ h x
        show (F.presheaf.map (homOfLE h).op).hom
            ((Z.presheaf.map (homOfLE W₁.2).op).hom r • f.1 W₁ x) =
          (Z.presheaf.map (homOfLE W₂.2).op).hom r • f.1 W₂ ((L'.presheaf.map (homOfLE h).op).hom x)
        rw [smulG, resZ, memS V f W₁ W₂ h x]⟩
    letI smI : ∀ V : Z.Opens, SMul Γ(Z, V) (S V) := fun V => ⟨sm V⟩
    letI modI : ∀ V : Z.Opens, Module Γ(Z, V) (S V) := fun V => Module.ofMinimalAxioms
      (fun r f g => Subtype.ext (funext fun W => by
        show (Z.presheaf.map (homOfLE W.2).op).hom r • (f.1 W + g.1 W) =
          (Z.presheaf.map (homOfLE W.2).op).hom r • f.1 W +
            (Z.presheaf.map (homOfLE W.2).op).hom r • g.1 W
        rw [smul_add]))
      (fun r r' f => Subtype.ext (funext fun W => by
        show (Z.presheaf.map (homOfLE W.2).op).hom (r + r') • f.1 W =
          (Z.presheaf.map (homOfLE W.2).op).hom r • f.1 W +
            (Z.presheaf.map (homOfLE W.2).op).hom r' • f.1 W
        rw [map_add, add_smul]))
      (fun r r' f => Subtype.ext (funext fun W => by
        show (Z.presheaf.map (homOfLE W.2).op).hom (r * r') • f.1 W =
          (Z.presheaf.map (homOfLE W.2).op).hom r •
            ((Z.presheaf.map (homOfLE W.2).op).hom r' • f.1 W)
        rw [map_mul, mul_smul]))
      (fun f => Subtype.ext (funext fun W => by
        show (Z.presheaf.map (homOfLE W.2).op).hom 1 • f.1 W = f.1 W
        rw [map_one, one_smul]))
    let P : (Z.Opens)ᵒᵖ ⥤ Ab.{u} :=
      { obj := fun V => AddCommGrpCat.of (S V.unop)
        map := fun {V V'} i => AddCommGrpCat.ofHom
          { toFun := fun f => ⟨fun W => f.1 ⟨W.1, W.2.trans i.unop.le⟩,
              fun W₁ W₂ h x => memS V.unop f ⟨W₁.1, W₁.2.trans i.unop.le⟩
                ⟨W₂.1, W₂.2.trans i.unop.le⟩ h x⟩
            map_zero' := rfl
            map_add' := fun a b => rfl }
        map_id := fun V => by
          ext f
          rfl
        map_comp := fun {V V' V''} i j => by
          ext f
          rfl }
    letI inst : ∀ V : (Z.Opens)ᵒᵖ, Module ↑(Z.ringCatSheaf.obj.obj V) ↑(P.obj V) := fun V =>
      (inferInstance : Module Γ(Z, V.unop) (S V.unop))
    let Pm : PresheafOfModules Z.ringCatSheaf.obj := PresheafOfModules.ofPresheaf P (by
      intro V V' i r f
      apply Subtype.ext
      funext W
      show (Z.presheaf.map (homOfLE (W.2.trans i.unop.le)).op).hom r • f.1 ⟨W.1, _⟩ =
        (Z.presheaf.map (homOfLE W.2).op).hom ((Z.presheaf.map (homOfLE i.unop.le).op).hom r) •
          f.1 ⟨W.1, W.2.trans i.unop.le⟩
      have key := resZ i.unop.le W.2 (r : Γ(Z, V.unop))
      exact congrArg (fun t => t • f.1 ⟨W.1, W.2.trans i.unop.le⟩) key.symm)
    have hsh : TopCat.Presheaf.IsSheaf P := by
      have resG : ∀ (G : Z.Modules) {A B C : Z.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(G, A)),
          (G.presheaf.map (homOfLE h2).op).hom ((G.presheaf.map (homOfLE h1).op).hom x) =
          (G.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
        intro G A B C h1 h2 x
        change (G.presheaf.map (homOfLE h1).op ≫ G.presheaf.map (homOfLE h2).op).hom x = _
        rw [← Functor.map_comp]
        all_goals rfl
      rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
      intro ι U sf hcompat
      have hc' : ∀ (i j : ι) (W : Z.Opens) (hi : W ≤ U i) (hj : W ≤ U j),
          (sf i).1 ⟨W, hi⟩ = (sf j).1 ⟨W, hj⟩ := by
        intro i j W hi hj
        exact congrArg (fun q : S (U i ⊓ U j) => q.1 ⟨W, le_inf hi hj⟩) (hcompat i j)
      have hcovW : ∀ W : Z.Opens, W ≤ iSup U → W ≤ ⨆ i, W ⊓ U i := by
        intro W hW z hz
