  have hcompat : Presieve.Arrows.Compatible
      (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj ⋙ forget AddCommGrpCat.{u+1}) Γ
