      obtain ⟨πA, haA, hlA, sqA⟩ := hLow k₁ k g₁ _ _ M₁ h₁ π₁ ha₁ hl₁ sq₁
      obtain ⟨πB, haB, hlB, sqB⟩ := hLow k₂ k g₂ _ _ M₂ h₂ π₂ ha₂ hl₂ sq₂
      have hk1 : c.π.app k ≫ D.map g₁ ≫ D.map f₁ = c.π.app i₀ := by
        rw [← Category.assoc, c.w g₁, c.w f₁]
      have hk2 : c.π.app k ≫ D.map g₂ ≫ D.map f₂ = c.π.app i₀ := by
        rw [← Category.assoc, c.w g₂, c.w f₂]
      have eOA : p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ S) =
          p₀ ⁻¹ᵁ (c.π.app k ⁻¹ᵁ (D.map g₁ ⁻¹ᵁ (D.map f₁ ⁻¹ᵁ S))) := by
        rw [← hk1, Scheme.Hom.comp_preimage, Scheme.Hom.comp_preimage]
      have eOB : p₀ ⁻¹ᵁ (c.π.app i₀ ⁻¹ᵁ (U : (D.obj i₀).Opens)) =
          p₀ ⁻¹ᵁ (c.π.app k ⁻¹ᵁ (D.map g₂ ⁻¹ᵁ (D.map f₂ ⁻¹ᵁ (U : (D.obj i₀).Opens)))) := by
        rw [← hk2, Scheme.Hom.comp_preimage, Scheme.Hom.comp_preimage]
      have hcA : IsCompact ((D.map g₁ ⁻¹ᵁ (D.map f₁ ⁻¹ᵁ S) : (D.obj k).Opens) : Set (D.obj k)) := by
        haveI := haff g₁
        haveI := haff f₁
        exact QuasiCompact.isCompact_preimage (f := D.map g₁) _ (D.map f₁ ⁻¹ᵁ S).2
          (QuasiCompact.isCompact_preimage (f := D.map f₁) _ S.2 hS)
      have hcB : IsCompact ((D.map g₂ ⁻¹ᵁ (D.map f₂ ⁻¹ᵁ (U : (D.obj i₀).Opens)) : (D.obj k).Opens) :
          Set (D.obj k)) := by
        haveI := haff g₂
        haveI := haff f₂
        exact QuasiCompact.isCompact_preimage (f := D.map g₂) _ (D.map f₂ ⁻¹ᵁ (U : (D.obj i₀).Opens)).2
