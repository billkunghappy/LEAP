      refine ⟨j, f, (Sheaf.H.equiv₀ (G.obj j) hT).injective ?_⟩
      have h2 := Sheaf.H.equiv₀_naturality hT (G.map f) y
      rw [Sheaf.H.map_apply] at h2
      rw [map_zero, ← h2]
      exact hf

    have H0 : ∀ (G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit G) 0),
        ∃ (i : Λ) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G.obj i) 0),
          y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero 0) = x := by
      intro G x
      obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y Λ G
      obtain ⟨hsurj, -⟩ := wc_et_affine_sections_local_cocone Y Λ G (Limits.colimit G)
        (Limits.colimit.ι G) (fun i j f => Limits.colimit.w G f) hA hB (Scheme.Etale.mk (𝟙 Y)) hYaff
      obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G) hT) x)
      refine ⟨i, (Sheaf.H.equiv₀ (G.obj i) hT).symm t,
        (Sheaf.H.equiv₀ (Limits.colimit G) hT).injective ?_⟩
      have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G i)
        ((Sheaf.H.equiv₀ (G.obj i) hT).symm t)
      rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
      rw [← h, ht]

    have Hemb : ∀ G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
        ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : G ⟶ I), Mono α ∧
          ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)),
            e = 0 := by
      intro G
      obtain ⟨I, α, hα, hinj⟩ := wc_et_functorial_injective_embedding Y Λ G
      obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y Λ I
      exact ⟨I, α, hα, wc_et_affine_colim_injective_acyclic Y Λ I hinj (fun U hU =>
        wc_et_affine_sections_local_cocone Y Λ I (Limits.colimit I) (Limits.colimit.ι I)
          (fun i j f => Limits.colimit.w I f) hA hB U hU)⟩

    have Blift : ∀ (G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (n : ℕ)
        (z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit G) n),
        ∃ (i : Λ) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G.obj i) n),
          y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero n) = z :=
      wc_ext_filtered_colim_lift _ Λ H0 Hemb

    intro n
    induction n with
    | zero => exact Ainj
    | succ n ih =>
      intro F i x hx
      obtain ⟨I, α, hα, hinj⟩ := wc_et_functorial_injective_embedding Y Λ F
      let S : ShortComplex (Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
        ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel α) hα inferInstance
      have hSc : (S.map (Limits.colim : (Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}) ⥤ _)).ShortExact := hS.map_of_exact _
      have hSk : ∀ k : Λ, (S.map ((evaluation Λ
          (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).obj k)).ShortExact :=
        fun k => hS.map_of_exact _

      haveI := hinj i
      have h0 : x.comp (Abelian.Ext.mk₀ (α.app i)) (add_zero (n + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ (hSk i) x h0 rfl

      have hnat_i : (hSk i).extClass.comp (Abelian.Ext.mk₀ (Limits.colimit.ι F i)) (add_zero 1) =
          (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) i)).comp hSc.extClass (zero_add 1) :=
        (hSk i).extClass_naturality hSc
          { τ₁ := Limits.colimit.ι F i
            τ₂ := Limits.colimit.ι I i
            τ₃ := Limits.colimit.ι (Limits.cokernel α) i
            comm₁₂ := Limits.colimit.ι_map α i
            comm₂₃ := Limits.colimit.ι_map (Limits.cokernel.π α) i }
      have hd : (x₃.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) i))
          (add_zero n)).comp hSc.extClass rfl = 0 := by
        calc (x₃.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) i))
              (add_zero n)).comp hSc.extClass rfl
            = x₃.comp ((Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) i)).comp
                hSc.extClass (zero_add 1)) rfl :=
              Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega)
          _ = x₃.comp ((hSk i).extClass.comp (Abelian.Ext.mk₀ (Limits.colimit.ι F i))
                (add_zero 1)) rfl := by rw [hnat_i]
          _ = (x₃.comp (hSk i).extClass rfl).comp (Abelian.Ext.mk₀ (Limits.colimit.ι F i))
                (add_zero (n + 1)) :=
              (Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega)).symm
          _ = 0 := by rw [hx₃]; exact hx
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hSc
        (x₃.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) i)) (add_zero n)) rfl hd
      have hz' : z.comp (Abelian.Ext.mk₀ (Limits.colim.map (Limits.cokernel.π α))) (add_zero n) =
