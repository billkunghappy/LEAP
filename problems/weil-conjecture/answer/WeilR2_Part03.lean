    have OU := s4 SqOU
    have OV := s4 SqOV
    refine s5 κ (Y.homOfLE (le_sup_left : V ≤ V ⊔ U)) (Y.homOfLE (le_sup_right : U ≤ V ⊔ U))
      ?_ ?_ ?_
    · intro x
      rw [RV, RU]
      rcases s3a (Limits.pullback.fst (Limits.pushout.desc hV hU w) g x) with ⟨a, ha⟩ | ⟨b, hb⟩
      · exact Or.inl ⟨a, ha⟩
      · exact Or.inr ⟨b, hb⟩
