theorem wc_et_ftc_split_diff : ∀ (X V : Scheme.{u}) (p : V ⟶ X) (m : ℕ) (a : ZMod m → (V ⟶ V))
    (ht : wcFetTorsor p m a) (hp2 : Etale (Limits.pullback.fst p p ≫ p))
    (pr₁ pr₂ : wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2 ⟶ wcTorsorEt p ht.etale),
    pr₁.left = Limits.pullback.fst p p → pr₂.left = Limits.pullback.snd p p →
    ∀ (d : ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.obj
        (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))),
    (∀ (c : ZMod m) (γ : wcTorsorEt p ht.etale ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2),
        γ.left = Limits.pullback.lift (a c) (𝟙 V) ((ht.act_p c).trans (Category.id_comp p).symm) →
        (((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).obj.map γ.op).hom d =
          wcConstSec X (ULift.{u+1} (ZMod m)) (wcTorsorEt p ht.etale) (ULift.up c)) →
    ∀ (G E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (ρ : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ G) (f : G ⟶ E)
      (s : E.obj.obj (Opposite.op (wcTorsorEt p ht.etale))),
    (∀ c : ZMod m, (E.obj.map (wcTorsorAct p ht.etale (a c) (ht.act_p c)).op).hom s =
      s + (f.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
        ((ρ.hom.app (Opposite.op (wcTorsorEt p ht.etale))).hom
          (wcConstSec X (ULift.{u+1} (ZMod m)) (wcTorsorEt p ht.etale) (ULift.up c)))) →
    (E.obj.map pr₁.op).hom s - (E.obj.map pr₂.op).hom s =
      (f.hom.app (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))).hom
        ((ρ.hom.app (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))).hom d) :=
by
  intro X V p m a ht hp2 pr₁ pr₂ hpr₁ hpr₂ d hd G E ρ f s hs

  let S : Sieve (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2) :=
    { arrows := fun _ h =>
        (E.obj.map h.op).hom ((E.obj.map pr₁.op).hom s - (E.obj.map pr₂.op).hom s) =
          (E.obj.map h.op).hom
            ((f.hom.app (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))).hom
              ((ρ.hom.app (Opposite.op (wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2))).hom d))
      downward_closed := by
        intro W W' h hh g
        simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
        rw [hh] }

  have hgraph : ∀ (c : ZMod m)
      (γ : wcTorsorEt p ht.etale ⟶ wcTorsorEt (Limits.pullback.fst p p ≫ p) hp2),
      γ.left = Limits.pullback.lift (a c) (𝟙 V) ((ht.act_p c).trans (Category.id_comp p).symm) →
      S.arrows γ := by
    intro c γ hγ
    have h1 : γ ≫ pr₁ = wcTorsorAct p ht.etale (a c) (ht.act_p c) := by
      apply MorphismProperty.Over.Hom.ext
      change γ.left ≫ pr₁.left = a c
