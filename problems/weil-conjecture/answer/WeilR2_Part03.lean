          ext x
          simp only [map_add]
          rfl }
    refine ⟨{ app := fun T => AddCommGrpCat.ofHom (ψ T.unop), naturality := ?_ }, fun T R x => rfl⟩
    intro T₁ T₂ h
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro c
    apply LocallyConstant.ext
    have hBC1 : ((wcEtBaseChange (ι ≫ p)).map h.unop).left ≫
        Limits.pullback.fst T₁.unop.hom (ι ≫ p) =
        Limits.pullback.fst T₂.unop.hom (ι ≫ p) ≫ h.unop.left := Limits.pullback.lift_fst _ _ _
    have hBC2 : ((wcEtBaseChange (ι ≫ p)).map h.unop).left ≫
        Limits.pullback.snd T₁.unop.hom (ι ≫ p) =
        Limits.pullback.snd T₂.unop.hom (ι ≫ p) := Limits.pullback.lift_snd _ _ _
    have e0 : ∀ (b : Limits.pullback T₂.unop.hom (ι ≫ p) ⟶ Limits.pullback T₁.unop.hom (ι ≫ p)),
        b ≫ Limits.pullback.fst T₁.unop.hom (ι ≫ p) =
          Limits.pullback.fst T₂.unop.hom (ι ≫ p) ≫ h.unop.left →
        b ≫ Limits.pullback.snd T₁.unop.hom (ι ≫ p) = Limits.pullback.snd T₂.unop.hom (ι ≫ p) →
        ∀ pf1 pf2 pf3 pf4,
        j T₂.unop ≫ Limits.pullback.map T₂.unop.hom p U.hom p (h.unop ≫ c.down).left (𝟙 Z) (𝟙 Y)
          pf1 pf2 =
        b ≫ j T₁.unop ≫
          Limits.pullback.map T₁.unop.hom p U.hom p c.down.left (𝟙 Z) (𝟙 Y) pf3 pf4 := by
      intro b hb1 hb2 pf1 pf2 pf3 pf4
      apply Limits.pullback.hom_ext
      · simp only [j, Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc, Category.comp_id]
        rw [reassoc_of% hb1]
        rfl
      · simp only [j, Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd,
          Category.comp_id]
        rw [reassoc_of% hb2]
    have e1 : ∀ pf1 pf2 pf3 pf4 (x : ↥(Limits.pullback T₂.unop.hom (ι ≫ p))),
        Limits.pullback.map T₂.unop.hom p U.hom p (h.unop ≫ c.down).left (𝟙 Z) (𝟙 Y) pf1 pf2
          (j T₂.unop x) =
        Limits.pullback.map T₁.unop.hom p U.hom p c.down.left (𝟙 Z) (𝟙 Y) pf3 pf4
          (j T₁.unop (((wcEtBaseChange (ι ≫ p)).map h.unop).left x)) := by
      intro pf1 pf2 pf3 pf4 x
      exact congrArg (fun φ => φ x) (e0 _ hBC1 hBC2 pf1 pf2 pf3 pf4)
    intro x
    change ULift.up (f (wcSmePieceVec p U m k Θ T₂.unop (j T₂.unop x)
        (FreeAbelianGroup.of (ULift.up (h.unop ≫ c.down))))) =
      ULift.up (f (wcSmePieceVec p U m k Θ T₁.unop
        (j T₁.unop (((wcEtBaseChange (ι ≫ p)).map h.unop).left x)) (FreeAbelianGroup.of c)))
    simp only [wcSmePieceVec]
    erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
    congr 2
    funext a
    congr 1
    exact e1 _ _ _ _ x

  have c5 : ∀ (Y : Scheme.{u}) (U V : Y.Etale)
      (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Q : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (τ₀ : (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q),
