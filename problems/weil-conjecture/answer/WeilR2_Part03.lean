            (Θcomp _ _ _ _ _ _ _ _ _ (hs7.2.1 F F' (leOfHom f)).2).trans
              (Category.comp_id _).symm } }

  have hcol : Nonempty (Limits.IsColimit
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapCocone c)) := by
